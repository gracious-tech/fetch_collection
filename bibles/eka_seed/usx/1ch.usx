<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id" />
  <para style="h">1 Aka Abuumu</para>
  <para style="toc3">1 Aka</para>
  <para style="toc2">1 Aka Abuumu</para>
  <para style="toc1">Ngbokambanga Nwer nyi Aka Abuumu</para>
  <para style="mt1">1 Aka Abuumu</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s">Ntoora Nnyo Mi Bomo Goji Adam Rehng Eji Ebraham</para>
  <para style="s">Nti Et'tohngo Nyi Bomo Eji Adam Rehng Eji Noa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1" />Adam jele Sed, Sed jel Enos, <verse eid="1CH 1:1" /><verse number="2" style="v" sid="1CH 1:2" />Kenan jele Mahalalel, Mahalalel jel Jared, <verse eid="1CH 1:2" /><verse number="3" style="v" sid="1CH 1:3" />Enok jele Metusela, Metusela jel Lamek abola Noa <verse eid="1CH 1:3" /><verse number="4" style="v" sid="1CH 1:4" />Abon ba nlum ba Noa ba a: Sem, Ham, go Jafed.<verse eid="1CH 1:4" /></para>
  <para style="s">Et'tohngo Ji Jafed</para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 1:5" />Abon ba nlum ba Jafed ba a: Gomer, a Magog, Madai, Javan, Tubal, a Mesek go Tiras. <verse eid="1CH 1:5" /><verse number="6" style="v" sid="1CH 1:6" />Abon ba nlum ba Gomer ba a, Asikenas, Rifad go Togama. <verse eid="1CH 1:6" /><verse number="7" style="v" sid="1CH 1:7" />Abon ba nlum ba Javan ba a, Elisa, a Tasisi, a anebe Kitti go anebe Rodan.<verse eid="1CH 1:7" /></para>
  <para style="s">Et'tohngo Ji Ham</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 1:8" />Abon ba nlum ba Ham ba a: Kusi, Mijraim, Pud a Kenan. <verse eid="1CH 1:8" /><verse number="9" style="v" sid="1CH 1:9" />Abon ba nlum ba Kusi ba a: Seba, Havila, Sabta, Raama, go Sebteka. Abon ba nlum ba Raama ba a: Seba abola Dedan. <verse eid="1CH 1:9" /><verse number="10" style="v" sid="1CH 1:10" />Kusi wo jolo nde no Nimrod, Nimrod ji ba jol ntahkuru anea nsoja go njini. <verse eid="1CH 1:10" /><verse number="11" style="v" sid="1CH 1:11" />Mijraim wo jolo nde no anebe Lud, a anebe Aram, anebe Lehab, anebe Naftuhim, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />a anebe Patrusi, a anebe (Kasilu boji anebe Filista lohng goji bo,) go anebe Kaptor <verse eid="1CH 1:12" /><verse number="13" style="v" sid="1CH 1:13" />Kenan jolo nde no Sidon. Sidon wo jolo ngbokambang a mmon ewe no nlum, Kenan wo tob jol nde no a anebe Hiti, <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />a anebe Jebus, anebe Amon a anebe Girgas, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />a anebe Hiv a anebe Arki a anebe Sin, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />a anebe Avad, a anebe Jema go anebe Hamati.<verse eid="1CH 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 1:17" />Abon ba nlum ba Sem ba a: Elam, Asur, Afakjad, Lud go Aram. Abon ba nlum ba Aram ba a: Uj, Hul, Gateri go Mesek.<verse eid="1CH 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 1:18" />Afakjad wo jolo nde no Sela, Sela jol nde no Eber. <verse eid="1CH 1:18" /><verse number="19" style="v" sid="1CH 1:19" />Bo jele abon ba nlum abal ka Eber, awohng bo jo gung-e mbing re Peleg, tibre ngare nyi á jolo elkpin wo anebe njini yabe no; mmonannyehn bo gung-e mbing re Joktan. <verse eid="1CH 1:19" /><verse number="20" style="v" sid="1CH 1:20" />Joktan wo jolo nde no Almodad, Selef, Hajamavete, go Jera, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />á tob jolo nde no Hadoram, Ujal, Dikla, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />Obal, Abimael, Seba, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />Ofir, Havila go Jobab. Bo kpee jolo abon ba nlum ba Joktan. <verse eid="1CH 1:23" /><verse number="24" style="v" sid="1CH 1:24" />Lohngo re nti et'tohngo nyi bomo go ji Sem rehng eji Ebraham nyi a: Sem, Afakjad, Sela, <verse eid="1CH 1:24" /><verse number="25" style="v" sid="1CH 1:25" />Eber Peleg, Reu, <verse eid="1CH 1:25" /><verse number="26" style="v" sid="1CH 1:26" />Serug Nahor, Tera,<verse eid="1CH 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 1:27" />go Ebram ye ji li Ebraham.<verse eid="1CH 1:27" /></para>
  <para style="s">Ebangenahb ji Ebraham</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 1:28" />Abon ba nlum ba Ebraham ba a: Aisek abola Ismael.<verse eid="1CH 1:28" /></para>
  <para style="s">Et'tohngo ji Haga</para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 1:29" />Anebe at'tohngo ebo ba a: Nabayod ngbokambang a mmon no Ismael, Kedar, Adbeel, Mibsam, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />Misma, Duma, Massa, Hadad, Tema, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />Jetur, Nafis go Kedema. Bo ba jolo abon ba nlum ba Ismael.<verse eid="1CH 1:31" /></para>
  <para style="s">Et'tohngo ji Ketura</para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 1:32" />Abon ba nlum ba Ketura nne elkanga Ebraham jele no ba a: Jimran, Joksan, Medan, Midian, Isibak, go Sua. Abon ba Joksan ba a: Seba<note caller="+" style="f"><char style="fr" closed="false">1:32 </char><char style="ft" closed="false" /></note> a Dedan. <verse eid="1CH 1:32" /><verse number="33" style="v" sid="1CH 1:33" />Abon Ba nlum ba Midian ba a: Efa, Efer, Hanok, Abida, go Eldaa. Ane baa kpee ba jolo anebe et'tohngo ji Ketura.<verse eid="1CH 1:33" /></para>
  <para style="s">Et'tohngo ji Sera (Sira)</para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 1:34" />Ebraham jolo nde no Aisik. Abon ba nlum ba Aisik, Eso abola Isreel.<verse eid="1CH 1:34" /></para>
  <para style="s">Abon ba nlum ba Eso</para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 1:35" />Abon ba nlum ba Eso ba a: Elifasi, Rewel, Jewusi, Jalam go Kora. <verse eid="1CH 1:35" /><verse number="36" style="v" sid="1CH 1:36" />Abon ba nlum ba Elifasi ba a: Teman, Omar, Jefo, Gatam go Kenaj. Timna jele Amalek ka-e.<note caller="+" style="f"><char style="fr" closed="false">1:36 </char><char style="ft" closed="false">en 36.12</char></note> <verse eid="1CH 1:36" /><verse number="37" style="v" sid="1CH 1:37" />Abon ba nlum ba Rewel ba a: Nahati, Jera, Sama go Mija.<verse eid="1CH 1:37" /></para>
  <para style="s">Anebe Seri ba jolo go Edom</para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 1:38" />Abon ba nlum ba Seri ba a: Lotan, Sobal, Jibeon, Ana, Dison, Ejer go Disan. <verse eid="1CH 1:38" /><verse number="39" style="v" sid="1CH 1:39" />Abon ba nlum ba Lotan ba a: Hori a Homam. Timna jolo mmonannyehn Lotan no nkal. <verse eid="1CH 1:39" /><verse number="40" style="v" sid="1CH 1:40" />Abon ba nlum ba Sobal ba a: Alvan, Manahati, Ebal, Sefo, go Onam. Abon ba nlum ba Jibeon, ba a Ana. <verse eid="1CH 1:40" /><verse number="41" style="v" sid="1CH 1:41" />Mmon no nlum Ana, DIson wo. Abon ba nlum ba Dison ba a: Hemdan, Esiban, Itran, go Keran. <verse eid="1CH 1:41" /><verse number="42" style="v" sid="1CH 1:42" />Abon ba nlum ba Ejer ba a: Bilhan, Jaavan go Akan. Abon ba nlum Disan ba a: Uj, abola Aran.<verse eid="1CH 1:42" /></para>
  <para style="s">Abafiladi go Edom</para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 1:43" />Atul ba a, ba kuumu go Edom nne awohng awohng kehm kuumu etul go Isreel: Bela mmon no nlum no Beyo, ye ji bo jo lung nfam ejahbe enye re Dinhaba <verse eid="1CH 1:43" /><verse number="44" style="v" sid="1CH 1:44" />Eji Bela kpo no, Jobab mmona Jera no nlum ji lohngo go Bojra wo ba kuumu etul ege a nji. <verse eid="1CH 1:44" /><verse number="45" style="v" sid="1CH 1:45" />Eji Jobab kpo no, Husam ji lohngo go ndi nyi anebe Teman wo ba kuumu etul go ege a nji. <verse eid="1CH 1:45" /><verse number="46" style="v" sid="1CH 1:46" />Eji Husam kpo no, Hadad mmon no Bedad, ye ji ga anebe Midia go ejahbe Moab, wo ba kuumu etul ege a nji. Nfam ejahbe enye bo jo lungu re Avid. <verse eid="1CH 1:46" /><verse number="47" style="v" sid="1CH 1:47" />Eji Hadad kpo no, Samla ji lohngo go Masireka, wo ba kuumu etul ege a nji. <verse eid="1CH 1:47" /><verse number="48" style="v" sid="1CH 1:48" />Eji Samla kpo no, Sawul ji lohngo go Rehobod go aya, wo ba kuumu etul go ege a nji. <verse eid="1CH 1:48" /><verse number="49" style="v" sid="1CH 1:49" />Eji Sawul kpo no, Baal-Hanan ji mmon no nlum no Akbo wo ba kuumu etul go ege a nji. <verse eid="1CH 1:49" /><verse number="50" style="v" sid="1CH 1:50" />Eji Baal-Hanan kpo no, Hadad wo ba kuumu etul go ege a nji. nfam ejahbe enye bo gungu mbing re Pau, fvfo nkal ewe bo jo lung-e re Mehetabel, mmon no nkal Matred ji jolo mmon no nkal no Me-Jahab no nkal. <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />Eji Hadad tob kpo.</para>
  <para style="p" vid="1CH 1:51">Atul ba Edom ba a: Timna, Alva, go Jeted, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />Oholibama, Ela, Pinon, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />Kenaj, Teman, Mibja, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />Magidiel, go Iram. Bo ba jolo atul ba Edom.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s">Abing Abon ba nlum ba Isreel Nya a</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1" />A wo li abon ba nlum ba Isreel: Ruben, Simon, Levi, Juda, Isaka, Jebulum, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />Dan, Josef, Benjamin, Naftali, Gad a Aser.<verse eid="1CH 2:2" /></para>
  <para style="s">Et'tohngo Ji Juda Tete Rehng Go Et'tohngo Ji Hejron</para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 2:3" />Abon ba nlum ba Juda: Er, Onan a Sela, ane ara baa nnenkal a Kanan wo jele bo ka-e, ji jolo mmon no nkal no Sua. Er ji jolo ngbokambang a mmon no Juda, jolo eb'bi nsaba ala nne go ejang bi Jehova, owo wahnge Jehova wul-e no. <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" />Nkala mmon no nlum no Juda no bo jo lung-e re Tama jele Pereji a Jera ka Juda, Juda bele abon ba nlum alon kpee. <verse eid="1CH 2:4" /><verse number="5" style="v" sid="1CH 2:5" />Abon ba nlum ba Pereji ba a: Hesiron a Hamul. <verse eid="1CH 2:5" /><verse number="6" style="v" sid="1CH 2:6" />Abon ba nlum ba Jera ba a: Jimri, Etan, Heman, Kalkol a Darda, bo kpee jolo abon na alon. <verse eid="1CH 2:6" /><verse number="7" style="v" sid="1CH 2:7" />Abon ba nlum ba Karmi ba a: Akar ji ko ntong ba kunu Isreel, eji á rannge ntahm, nyi bungu re, nne kꞌrod nsol nyi bo ma yake ka Esowo. <verse eid="1CH 2:7" /><verse number="8" style="v" sid="1CH 2:8" />Mmon no nlum no Etan wo a: Ajaria. <verse eid="1CH 2:8" /><verse number="9" style="v" sid="1CH 2:9" />Abon ba nlum ba bo jele ka Hejiron ba a: Jerameel, Ram a Keleb.<verse eid="1CH 2:9" /></para>
  <para style="s">Nti Ebangenab Ji Ram</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 2:10" />Ram wo jolo nde no Amminadab, fvfo Amminadab wo jolo nde no Nason, ye ji jolo ntubesi no anebe Juda. <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" />Nason wo jolo nde no Salmon, Salmon wo jolo nde no Boas. <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />Boas wo jolo nde no Obed fvfo Obed jol nde no Jesse <verse eid="1CH 2:12" /><verse number="13" style="v" sid="1CH 2:13" />Jesse wo jolo nde no Eliab ji jolo ngbokambang a mmon no nlum, etoono mmon no nlum Abinadab, etoono abon ba nlum era Simea, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />go abon ba nlum na ani Netanel, go abon ba nlum na alon Raddi, <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />go abon arakera Ojem, go abon asehma Devid. <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" />Abonannyehn ba nkal ba a, Jerua a Abigel. Abon ba nlum ara ba Jerua ba a: Abisai, Joab a Asahel <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" />Abigel wo jolo nnyehn no Amasa ji nde bo jo lung-e re Jeteri ji jolo nne a Isimel.<verse eid="1CH 2:17" /></para>
  <para style="s">Keleb mmon no nlum no Hejiron</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 2:18" />Kaleb mmon no nlum no Hejiron, Ajuba nkal ewe jele abon ka-e, Jeriod tob jele abon ka-e. Abon Ajuba ba nlum ba a Jeser, Sobab a Ardon <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" />Eji Ajuba kpo no Kaleb ko Efrad, ye ji jele Hur ka-e. <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" />Hur wo jolo nde no Uri, fvfo Uri wo jolo nde no Bejalel. <verse eid="1CH 2:20" /><verse number="21" style="v" sid="1CH 2:21" />Eji jolo ano Hejron, ji ma kang nya atahl ara, song ko mmon no nkal no Makir ji nde no Giled . Á limi elkoro a ne á jel Segub ka-e. <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />Segub jolo nde no Jair, ye ji jo fili eltahl ejahbe ebra go Giled. <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />(Wo Gesur a Aram noko ebta ko Havod Jar fvfo bo tob ko Kenad a ejahbe atahl ara nya jolo sennge bo kak:) Nyaa kpee jolo etꞌtohngo Makir nde no Giled<verse eid="1CH 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 2:24" />Eji Hejiron kpo no go Kaleb Efrata, Abija nkal no Hejiron jele Asur ka-e, ye ji jolo nde no Tekoa.<verse eid="1CH 2:24" /></para>
  <para style="s">Jerameel mmon no nlum no Hejiron</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 2:25" />Abon ba nlum ba Jeremeel ba a; ye ji jolo ngbokambang a mmon no nlum no Hejiron, Ram ngbokambang a mmon no nlum no Buna, Oren, Ojem go Ahija. <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />Jerameel bele nkal noko no bo jo lung-e re Atara, á jolo nnyehn no Onam. <verse eid="1CH 2:26" /><verse number="27" style="v" sid="1CH 2:27" />Abon ba nlum ba Ram ji jolo ngbokambang a mmon no nlum no Jerameel ba a: Masi, Jamin a Eker. <verse eid="1CH 2:27" /><verse number="28" style="v" sid="1CH 2:28" />Abon ba nlum ba Onam ba a: Sammai a Jada. Abon ba nlum ba Sammai ba a: Nadab a Abisu. <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" />Nkal no Abisu bo jo lung-e re Abihel, ye ji jele Aban a Molid ka-e. <verse eid="1CH 2:29" /><verse number="30" style="v" sid="1CH 2:30" />Abon ba nlum ba Nadab ba a: Seled a Appaim, Seled kpoo mmon á jelem. <verse eid="1CH 2:30" /><verse number="31" style="v" sid="1CH 2:31" />Mmon no nlum no Appaim wo a: Isi ji jolo nde no Sesan. Sesan jolo nde no Alayi. <verse eid="1CH 2:31" /><verse number="32" style="v" sid="1CH 2:32" />Abon ba nlum ba Jada ji jolo mmonannyehn no Sammai ba a , Jeter a Jonatan, Jeter kpoo, mmon á jelem. <verse eid="1CH 2:32" /><verse number="33" style="v" sid="1CH 2:33" />Abon ba nlum ba Jonatan ba a: Pelet a Jaja, a wo li et'tohngo ji Jerameel. <verse eid="1CH 2:33" /><verse number="34" style="v" sid="1CH 2:34" />Sesan mmon no nlum á jelem, sehngem ba nkal ba ba. Á bele nlokeltum no lohng go Ijib no bo jo lung-e re Jara. <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />Sesan ka Jara nlokeltum ewe mmon ewe no nkal á ko-e go elbal, á jel Ata ka-e. <verse eid="1CH 2:35" /><verse number="36" style="v" sid="1CH 2:36" />Ata wo jolo nde no Natan, Natan jol nde no Jabad, <verse eid="1CH 2:36" /><verse number="37" style="v" sid="1CH 2:37" />Jabad jol nde no Eflal, Eflal jol nde no Obed, <verse eid="1CH 2:37" /><verse number="38" style="v" sid="1CH 2:38" />Obed jol nde no Jehu, Jehu jol nde no Ajaria, <verse eid="1CH 2:38" /><verse number="39" style="v" sid="1CH 2:39" />Ajaria jol nde no Helesi, Helesi jol nde no Eleasa, <verse eid="1CH 2:39" /><verse number="40" style="v" sid="1CH 2:40" />Eleasa jol nde no Sisma, Sisma jol nde no Sallum, <verse eid="1CH 2:40" /><verse number="41" style="v" sid="1CH 2:41" />Sallum jol nde no Jekamia, Jekamia jol nde no Elisama.<verse eid="1CH 2:41" /></para>
  <para style="s">Et'tohngo Ji Kaleb</para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 2:42" />Abon ba nlum ba Keleb ji jolo mmonannyehna Jerameel ba a: Mesa ji jolo ngbokambanga mmon no nlum, ye ji jolo nde no Jif, fvfo mmon ewe Maresa ji jolo nde no Hebron. <verse eid="1CH 2:42" /><verse number="43" style="v" sid="1CH 2:43" />Abon ba nlum ba Hebron ba a: Kora, Tappua, Rekem a Sema. <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />Sema jolo nde no Raham, fvfo Raham jol nde no Jokiyam. Rekem jol nde no Sammayi. <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />Maon jolo mmon no Sammayi, fvfo Maon wo jolo nde no Beti-Jur. <verse eid="1CH 2:45" /><verse number="46" style="v" sid="1CH 2:46" />Nne elkoro Kaleb, Efa, wo jolo nnyehn no Haran, Moja a Gajeji. Haran wo jolo nde no Gajeji. <verse eid="1CH 2:46" /><verse number="47" style="v" sid="1CH 2:47" />Abon ba nlum ba Jada ba a: Regem Jotam, Gesam, Peleti, Efa a Saaf. <verse eid="1CH 2:47" /><verse number="48" style="v" sid="1CH 2:48" />Nne elkoro Keleb Maaka, wo jolo nnyehn no Seber a Tirana. <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />Á tob jele Saaf, ji jolo nde no Madmana a Seva ji jolo nde no Makbena a Gibea. Mmon no nkal no Keleb bo jo lung-e re Aksa. <verse eid="1CH 2:49" /><verse number="50" style="v" sid="1CH 2:50" />Ane baa tob jolo et'tohngo ji Kaleb. Abon ba Hur ji jolo ngbokambang mmon no Efrata; Sobal nde no Kiriad Jearim. <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />Salma wo jolo nde no Betlehem a Haref ji jolo nde no Beti Gader. <verse eid="1CH 2:51" /><verse number="52" style="v" sid="1CH 2:52" />Et'tohngo ji Sobal ji jolo nde no Kiria Jearim ji a; Haroe, ejang anebe Manahata, <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />a esi ejahbe nya Kiriad Jearim, anebe Itriti , Putiti, Sumati, a Misrati. A wo anebe Jara a anebe Esitaol lohng no. <verse eid="1CH 2:53" /><verse number="54" style="v" sid="1CH 2:54" />Et'tohngo ji Salma: Betlehem, Netofati, Atroti Beti Joab, ejang Manahati, Jorit, <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />asi ajahbe nya abanyonawer ba lene go Jabesi: Anebe Tirati, Simeati a Sukati . A wo li anebe Kenit ba lohng go ebangenahb ji Hammad, nde no Rekab.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s">Abon ba nlum ba David</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />A wo li abon ba nlum ba David ba bo jele bo go Hebron: ngbokambang a mmon bo jo lung-e re Amnon, mmon no Ahinoam ji Jijireel, etoono Daniel mmon no Abigel ji lohng go Karmel. <verse eid="1CH 3:1" /><verse number="2" style="v" sid="1CH 3:2" />Etoono abon ara, Absalom mmon no Maaka ji jolo mmon no nkal no Talma ntul no Gesur, etoono abon ani, Adonija mmon no Haggid, <verse eid="1CH 3:2" /><verse number="3" style="v" sid="1CH 3:3" />go abon alon Sefatiya mmon no Abital, abon arekara, Itram ji Egla jele no. <verse eid="1CH 3:3" /><verse number="4" style="v" sid="1CH 3:4" />Abon baa na arekara ba bo jele no ka David go Hebron, eji á jo fili edi go nnya esehma kunu nnyahng erakera. David jolo go Jeruselem jo fili edi ana ntul, eltahl a nnya ewubu a nnya era 33, <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />abon ba a ba bo jele ka-e o: Sammua, Sobab, Natan a Solomon, abon ani baa Batseba mmon no nkal no Ammiel wo jele bo. <verse eid="1CH 3:5" /><verse number="6" style="v" sid="1CH 3:6" />David tob jele Ibhar, Elisua, Elifeled, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />Noga, Nefe, Jafia, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />Elisama, Eliada a Elifeled bo jolo ane asehmwubu <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />Bo kpee jolo abon ba David, abon ba nkoro enye a wobem: Fvfo Tama jolo mmonannyehn bo no nkal.<verse eid="1CH 3:9" /></para>
  <para style="s">Atul ba Juda</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 3:10" />Mmon no nlum no Solomon wo a Rehoboam, Rehoboam jele Abija, Abija jel Asa, Asa jel Jehosafat, <verse eid="1CH 3:10" /><verse number="11" style="v" sid="1CH 3:11" />Jehosafat jel Jehoram, Jehoram jel Ahajia, Ahajia jel Joasi, <verse eid="1CH 3:11" /><verse number="12" style="v" sid="1CH 3:12" />Joasi jel Amajia, Amajia jel Ajaria, Ajaria jel Jotam, <verse eid="1CH 3:12" /><verse number="13" style="v" sid="1CH 3:13" />Jotam jel Ahasi, Ahasi jel Hejekiya, Hejekiya jel Manasse, <verse eid="1CH 3:13" /><verse number="14" style="v" sid="1CH 3:14" />Manase jel Amon, Amon jel Josia. <verse eid="1CH 3:14" /><verse number="15" style="v" sid="1CH 3:15" />Abon ba nlum ba Josia ba a: Johanan ngbokambanga mmon, Jehoakim etoono mmon, Jedekia etoono abon ara Sallum etoono abon ani. <verse eid="1CH 3:15" /><verse number="16" style="v" sid="1CH 3:16" />Ane ba kuumu etul toono Jehoakim: Jehoiasin mmon ewe no nlum, a Jedekiya.<verse eid="1CH 3:16" /></para>
  <para style="s">Et'tohngo Etul eji bo kehnge Eju</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 3:17" />Et'tohngo ji Jehoiasin ji bo bob-e kak ngbekobo go Bebylon: Seltiel mmon ewe no nlum, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />Malkiram, Pedaya, Senajar, Jekamiya, Hosama a Nedabiya. <verse eid="1CH 3:18" /><verse number="19" style="v" sid="1CH 3:19" />Abon ba nlum ba Pedaya ba a: Jerubabel a Simei. Abon ba nlum ba Jerubbabel, Mesullam a Hanania. Selomid wo jolo mmonannyehn bo no nkal. <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />Ane alon fvfo tob jolo o: Hasuba, Ohel, Berekiya, Hasadia a Jusab-Hesed. <verse eid="1CH 3:20" /><verse number="21" style="v" sid="1CH 3:21" />Et'tohngo ji Hananiya: Pelatia a Jesaya, fvfo abon ba nlum ba Refaya ji Arnan, ji Obadiya a ji Sekaniya. <verse eid="1CH 3:21" /><verse number="22" style="v" sid="1CH 3:22" />Abon ba nlum ba Sekaniya: Semaya a abon ebe ba nlum: Hattusi, Igal, Bariya, Neariya a Safati. Bo jolo ane arakera kpe kpe. <verse eid="1CH 3:22" /><verse number="23" style="v" sid="1CH 3:23" />Abon ba nlum ba Neariya: Elioenai, Hijikia a Ajirikam. Bo jolo ane ara kpe kpe. <verse eid="1CH 3:23" /><verse number="24" style="v" sid="1CH 3:24" />Abon ba nlum ba Elioenai: Hodavia, Eliasib, Pelaya, Akub, Johana, Delaya a Anani - Bo jolo ane asehma kpe kpe.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s">Abon Ba Nlum Ba Juda</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />Abon ba nlum ba Juda: Peres, Hejron, Karmi, Hur a Sobal. <verse eid="1CH 4:1" /><verse number="2" style="v" sid="1CH 4:2" />Renia mmona Sobal no nlum wo jolo nde no Jahad fvfo Jahad jol nde no Ahumia a Lahad. A wo li abangenahb nya Joratid. <verse eid="1CH 4:2" /><verse number="3" style="v" sid="1CH 4:3" />A wo li abon ba nlum ba Etam: Jejreel, Isma a Idbas. Mmonannyehn no nkal bo jo lung-e re Hejjelelponi. <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />Penuel wo jolo nde no Gedor, a Ejer ji jolo nde no Husa. A wo li abon ba nlum ba Hur, ngbokambang a mmon no nlum no Efrata ji jolo nde no Betlehem. <verse eid="1CH 4:4" /><verse number="5" style="v" sid="1CH 4:5" />Asur nde no Tekoa bele akal abal, Hela a Naara. <verse eid="1CH 4:5" /><verse number="6" style="v" sid="1CH 4:6" />Naara jele abon baa ka-e: Ahujam, Hefer, Temeni a Ahaahastari, a wo jolo abon ba nlum ba Naara. <verse eid="1CH 4:6" /><verse number="7" style="v" sid="1CH 4:7" />Abon ba nlum be Hela ba a: Jered, Johar, Etnan, <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />a Koj, ji jolo nde no Anub a Hajobeba ji lohng go et'tohngo ji Ahahel mmon no nlum no Harum. <verse eid="1CH 4:8" /><verse number="9" style="v" sid="1CH 4:9" />Jabes bo jo kpun-e sehnge abonannyehn bako, nnyehn gung-e mbing re Jabes ji bungu re, n jel-e go eyam. <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />Jabes lingi tob Esowo bi Isreel. re Oh, li re a bahk-m fuulu fere nyannge edi eljolo ejame, Nong ebo eba jol aname wo fere yehk-m go nfem anyehng anyehng eji n l'jo for go atongtong anyehng anyehng, ano wo Esowo wuku ero ebe. <verse eid="1CH 4:10" /><verse number="11" style="v" sid="1CH 4:11" />Kelub mmonannyehn Suha no nlum wo jolo nde no Mehir ji jolo nde no Eston. <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />Eston wo jolo nde no Bet Rafa, Pasea a Tehinna jol nde no Ir Nahas. A wo jolo aneblum ba Reka. <verse eid="1CH 4:12" /><verse number="13" style="v" sid="1CH 4:13" />Abon ba nlum ba Kenas ba a: Otniel a Seraya. Abon ba nlum ba Otniel: Hata a Meonota. <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />Meonata wo jolo nde no Ofra. Sera wo jolo nde no Joab, nde no Ge Harasim. Bo jo lungu bo ano tibre ane ba lene o bele abo ntum. <verse eid="1CH 4:14" /><verse number="15" style="v" sid="1CH 4:15" />Abon ba nlum ba Kaleb ji jolo mmon no Jefunne ba a: Iru, Eta a Naam Mmon no nlum no Ela: Kenas. <verse eid="1CH 4:15" /><verse number="16" style="v" sid="1CH 4:16" />Abon ba nlum ba Jehallel ba a: Jif, Jifa, Tiria a Asarel. <verse eid="1CH 4:16" /><verse number="17" style="v" sid="1CH 4:17" />Abon ba nlum ba Ejra ba a: Jeter, Mered, Efer a Jalon. Nkal awohng no Mered jele Miriam, Sammayi a Isba ji jolo nde no Estemoa. <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />Nkal ewe lohng go et'tohng ji Juda jele Jered ji jolo nde no Gedor, Heber nde no Soko a Jekutiel ji jolo nde no Janoa A wo jolo abon ba mmon no nkal no Faro Bitia, no Mered baang-e no. <verse eid="1CH 4:18" /><verse number="19" style="v" sid="1CH 4:19" />Abon ba nkala Hodia mmonannyehn no nkal no Naham, nde no Keyila ji Garam, a Estemoa ji anebe Maakatie. <verse eid="1CH 4:19" /><verse number="20" style="v" sid="1CH 4:20" />Abon ba nlum ba Simon ba a: Amnon, Rinna, Ben-Hanan a Tilon. Et'tohngo ji Isi: Johed a Ben-Johed. <verse eid="1CH 4:20" /><verse number="21" style="v" sid="1CH 4:21" />Abon ba nlum ba Sela mmon no nlum no Juda: Er, ne no Leka, Laada nde no Maresa bo ji lohng go ejang bi kpo lim eltum ni akpawobo go Bet-Asbea, <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />Jokim, aneblum ba Koaseba, Joas go Saraf bo ji jo fili Moab a Jasubi Lehem Nsol nyi bo nyono no bum lohng go nk'kulu a ngare. <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />Aba tohko nsol toko ba lene go Netaim a Gedera. Bo jolo o jo lim eltum ka ntul.<verse eid="1CH 4:23" /></para>
  <para style="s">Et'tohngo Ji Simon</para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 4:24" />Abon ba nlum ba Simon: Nemuel, Jamin, Jarib, Jera a Saul. <verse eid="1CH 4:24" /><verse number="25" style="v" sid="1CH 4:25" />Sallum jolo mmon no nlum no Sol, Mibsam jolo mmon no nlum no Sallum, Misma mmon no nlum no Mibsam. <verse eid="1CH 4:25" /><verse number="26" style="v" sid="1CH 4:26" />Abon ba nlum ba Misma: Hammuel jolo mmon nlum no Misma, Jakkur mmon no nlum no Hammuel, fvfo Simei mmon no nlum no Jakkur. <verse eid="1CH 4:26" /><verse number="27" style="v" sid="1CH 4:27" />Simei bele abon ba nlum elkua mmon awohng '16' a abon arakera ba nkal '6', wo abonanyehn belem abon gbalee, fvfo abangenahb ebo kpee jolem go nrur ana anebe Juda. <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />Bo lene go Beerseba a Molada, Hajar Sual, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />Bilha, Ejem, Tolad, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />Betuel, Horma, Jiklag, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />Bet Markabot, Hajar Susim, Bet Biri, a Saaraim, a wo jolo nfam ajahbe ebo tete David ba jol ntul <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />Abon ajahbe ba jolo seennge bo ba a, Etam, Ain, Rimmon, Tokem a Asan, jolo ejahbe eblon. <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />fvfo kpee ajahbe nya jolo seennge abona ajahbe tete rehng go Baalad jolo adi nya bo lene no fvfo bo bumu nwer nyi tibi ana bo lohng no. <verse eid="1CH 4:33" /><verse number="34" style="v" sid="1CH 4:34" />Mesobab, Jamlek, Josa ji mmon no nlum no Amajia, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />Joel a Jehu ji mmon no nlum no Josibia, ji mmon no nlum no Sera ji mmon no nlum no Asiel, <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />fvfo Elioyenai, Jaakoba, Jesohaya, Asaya, Adiel, Jesimiel, Benia, <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" />a Jija ji mmon no nlum no Sifi, Sifi mmon no nlum no Allon, Allon ji mmon no nlum no Jeddia, Jeddia mmon no nlum no Simri, Simri mmon no nlum no Semia. <verse eid="1CH 4:37" /><verse number="38" style="v" sid="1CH 4:38" />Aneblum ba bo gamme bo o jolo atubesi go bo abangenahb, abangenahb ebo gbale gbalee. <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />Bo tahme go n kpe nyi Gedor go ejang edamme jo seb ajele nya bo bahke jo ka atohko ndi ebo. <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />Bo nyehne nnooba ndi nyi nlak, go ajele fvfo ndi nyio gb'gbal, jolo soom fere n'nob. Anebe Hamid ebtohko lene o. <verse eid="1CH 4:40" /><verse number="41" style="v" sid="1CH 4:41" />Ane ba abing ebo, bo gamme no ba ngare nyi Hejekia ntul no Juda. Bo noko a anebe Ham go ebo adi nya bo jolo no, fvfo a anebe Meunid ba jolo o, rannge bo kpe kpe ana e jum ji kp'tibi tete lela, wo bo fere jolo go bo a ndi, tibre ajele jolo ka atohko ndi ebo. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />Ane atahltahl atahl alon ba Simeon, bo ji Pelatia, Nearia, Rafia a Ujjiel, ji mmon no nlum no Isis koo bo ba rannge ejahbe ewong ji Seir. <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />Bo wulu anebe Amalek ba be no, fere jol o tete lela.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s">Et'tohngo Ji Reben</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />Ruben wo jolo ngbokambang a mmon no Isreel. (Etingitingi, wo eji á noongo nkala nde,) eji á limi ano á rannge edi elnong nde, ejum ji jolo ka-e ana ngbokambang mmon no nlum, bo fere feere ka abon ba nlum ba Josef mmon no nlum no Isreel. Eji jolo ano Ruben bo we-e fangem kak go nwer nyi tibi ana bo lohng no go eyake ji elkv alehke ana ngbokambang mmon no nlum, <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />tvtv re Juda jolo etahntahn nne go ellong abonannyehn, fvfo ntubesi jo lohngo go ege, ejum ji jo jol ka ngbokambang a mmon no nlum, bo jo ka tiki ka Josef.) <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />Abon ba nlum ba Ruben ji jolo ngbokambang a mmon no nlum no Isreel jolo: Hanok, Pallu, Hejiron a Karmi. <verse eid="1CH 5:3" /><verse number="4" style="v" sid="1CH 5:4" />Abon ba nlum ba Joel: Semaia mmon ewe no nlum, Gog jolo mmon no nlum no Semaia, Simei jolo mmon no nlum no Gog, <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />Mika jolo mmon no nlum no Simei, Reaia mmon no nlum no Mika, Baal mmon no nlum no Reaia, <verse eid="1CH 5:5" /><verse number="6" style="v" sid="1CH 5:6" />a Beera mmon no nlum no Baal, Beera wo jolo ntubesi no anebe Ruben. Tigla-Pileser ntula Assiria bobo Beera song kak eju go ejahbe ji ndiki. <verse eid="1CH 5:6" /><verse number="7" style="v" sid="1CH 5:7" />Abonanyehn ebo, ba bo kake abing ebo go awer go ebangenahb ebangenahb, ana bo nyono kak nwer jo tib ana ebangenahb ebo li no: Jeil ji ntubesi, Jekaria, <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />fvfo Bela mmon no nlum no Ajaji ji jolo mmon no nlum no Sema ji jolo mmon no nlum no Joel. Bo kpee jolo ejang bi bomo go Aroer rehng go Nebo a Baal Meon. <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />Go ero nfam bo jolo go ndi nyio tete rehng go nkpe ewum wum ndi nyi nyange rehng go aya Uferetis, tibre atohko ndi ebo r'ru go Gilead. <verse eid="1CH 5:9" /><verse number="10" style="v" sid="1CH 5:10" />Ngare nyi Sol jo fili edi, bo noko ebta a ane ba lohng go et'tohngo ji Reuben, ga bo fere ko adi ellene nya Hagriti kpee go erohko ejang ero nfam bi Gilead.<verse eid="1CH 5:10" /></para>
  <para style="s">E'tohngo ji Gad</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 5:11" />Anebe Gad lene kohlo bo go Basan, tete rehng go Saleka: <verse eid="1CH 5:11" /><verse number="12" style="v" sid="1CH 5:12" />Joel wo jolo ntubesi, Safam jol etoono, go Janayi a Safad bo lene go Basan. <verse eid="1CH 5:12" /><verse number="13" style="v" sid="1CH 5:13" />Abonanyehn ebo go ebangenahb ba a: Mikael, Mesullam, Seba, Jorai, Jakan, Jia a Eber, kpee jolo nnahb esehma. <verse eid="1CH 5:13" /><verse number="14" style="v" sid="1CH 5:14" />A wo li abon ba nlum ba Abihail, Abihail mmon no nlum no Huri. Huri ji jolo mmon no nlum no Jaroa, Jaroa mmon no nlum no Gilead, Gilead mmon no nlum no Mikael, Mikael mmon no nlum no Jesisai, Jesisa mmon no nlum no Jado, Jado mmon no nlum no Busi. <verse eid="1CH 5:14" /><verse number="15" style="v" sid="1CH 5:15" />Ahi jolo mmon no nlum no Abdiel, ye ji jele Guni wo jolo ntubesi no ebangenahb ebo. <verse eid="1CH 5:15" /><verse number="16" style="v" sid="1CH 5:16" />Anebe Gad lene go Gilead ji Basan a abon ajahbe go adi enyam aleke go Saron tete rehng ana bo nyange no. <verse eid="1CH 5:16" /><verse number="17" style="v" sid="1CH 5:17" />Bo kpee kake abing ebo go nwer nyi tibi at'tohngo ebo, ngare nyi Jotam ntul no Juda a Jeroboam ntul no Isreel. <verse eid="1CH 5:17" /><verse number="18" style="v" sid="1CH 5:18" />Anebe Ruben, Anebe Gad a ejang et'tohngo ji Manase bo bele aneblum ba jolo atahl alon alon nkpel atahltahl a nkpel atahl abal a nkpel esehma kunu ane atahl ara '44,760,' ba jolo ka eltum nsoja, aneblum ba bele agubjing nya bahke ma jo fili ekum a ekahngkahng, ba bahke ma fili elban, ba bo ma tib bo ana bo bahke jo nok nta. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />Bo noko ebta a anebe Hagrid, Jetur, Nafisi a anebe, Nodab. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />Esowo kake bo ebo nok ka bo, fere yake anebe Hagrid a ane kpee ba kpa njahm a bo, á kak bo go ebo abo, tibre bo lingi tob-e go ngare ebta. A faange aro ebo, tibre bo yehke ntim ebo kun-e.<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">bum-e go etingitingi</char></note> <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />Atohko ndi nya bo taare anabe Hagrid jolo akamel atahl alon alon nkpel atahltahl atahl awubu, '50,00,' ejoro jolo atahl alon alon nkpel atahltahl nkpel erakera kunu ejoro atahl alon, '250,000' ebvankang jolo atahl alon alon go nkpel eltahl, '2,000,' bo tob bobo ane atahl alon alon nkpel atahltahl nkpel ebal atahl awubu '100,000' song kak eju, <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />egom jehko gbalee bo wul bo, tibre ebta jolo bi Esowo. Bo ko ndia bo fere sa jol o, tete ana bo jolo go eju.<verse eid="1CH 5:22" /></para>
  <para style="s">Ejang Et'tohngo ji Manase</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />Ane ba ejang et'tohngo ji Manase ruru sehng, bo lene bomo go ndi nyi Basan rehng go Baal Hamon, a Senir Ewong Hamon. <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />A wo li atubesi ba abangenahb ebo: Efer, Isi, Eliel, Ajirel, Jeremaya, Hodavia a Jadiel, bo jolo atakuru, atahntahn aneblum atubesi go ebo abangenahb. <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />Wo bo belem ekakesehk go ejang bi Esowo bi babnde ebo, bo jo kake asowo nya ane ba lene go ndi nyio, bo ji Esowo ma rannge bo. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />Ana wo Esowo bi Isreel kehm melle etohko ji Pul ntula Assiria ye ji tob li Tigla-Pileser ntul no Assiria, ye wo ba bob anebe Ruben, anebe Gad <note caller="-" style="x"><char style="xo" closed="false">5:26 </char><char style="xt" closed="false" /></note>a ejang et'tohngo ji Manase tahm a bo song kak eju, Á rodo bo tahm go Hala, Habo, Hara go ejang aya ma Gojan, o wo bo li no tete tub lela.<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s">Et'tohngo ji Levi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1" />Abon ba nlum ba Levi ba a: Garson, Kohati a Merari. <verse eid="1CH 6:1" /><verse number="2" style="v" sid="1CH 6:2" />Abon ba nlum ba Kohati ba a: Amram, Ijar, Hebron a Ujiel. <verse eid="1CH 6:2" /><verse number="3" style="v" sid="1CH 6:3" />Abon ba Amram ba a: Eron, Mosis a Miriam. Abon ba nlum ba Aaron ba a: Nadab, Abihu, Eleaja a Itamar. <verse eid="1CH 6:3" /><verse number="4" style="v" sid="1CH 6:4" />Eleaja wo jolo nde no Finehasi, Finehasi jol nde no Abisua, <verse eid="1CH 6:4" /><verse number="5" style="v" sid="1CH 6:5" />Abisua jol nde no Bukki, Bukki jol nde no Uji, <verse eid="1CH 6:5" /><verse number="6" style="v" sid="1CH 6:6" />Uji jol nde no Jerahia, Jerahia jol nde no Merayoti, <verse eid="1CH 6:6" /><verse number="7" style="v" sid="1CH 6:7" />Merayoti jol nde no Amaria, Amaria jol nde no Ahitub, <verse eid="1CH 6:7" /><verse number="8" style="v" sid="1CH 6:8" />Ahitub jol nde no Jadok, Jadok jol nde no Ahimaaji, <verse eid="1CH 6:8" /><verse number="9" style="v" sid="1CH 6:9" />Ahimaaji jol nde no Ajaria, Ajaria jol nde no Johanan, <verse eid="1CH 6:9" /><verse number="10" style="v" sid="1CH 6:10" />Johanan jol nde no Ajaria, ye wo jo loko ana nlimanjom go etahk Esowo ji Solomon si no go Jeusalem, <verse eid="1CH 6:10" /><verse number="11" style="v" sid="1CH 6:11" />Ajaria jol nde no Amaria, Amaria jol nde no Ahitub, <verse eid="1CH 6:11" /><verse number="12" style="v" sid="1CH 6:12" />Ahitub jol nde no Jadok, Jadok jol nde no Sallum, <verse eid="1CH 6:12" /><verse number="13" style="v" sid="1CH 6:13" />Sallum jol nde no Hilkia, Hilkia jol nde no Ajaria, <verse eid="1CH 6:13" /><verse number="14" style="v" sid="1CH 6:14" />Ajaria jol nde no Seria, Seria jol nde no Jojadak. <verse eid="1CH 6:14" /><verse number="15" style="v" sid="1CH 6:15" />Jojadak yele eju, ngare nyi Jehova yake Juda a Jeruselem kak go abo nya Nebukadnajar bo jol aju. <verse eid="1CH 6:15" /><verse number="16" style="v" sid="1CH 6:16" />Abon ba nlum ba Levi ba a: Gason, Kohati a Merari. <verse eid="1CH 6:16" /><verse number="17" style="v" sid="1CH 6:17" />A wo li abing abon ba Geson: Libni a Simei. <verse eid="1CH 6:17" /><verse number="18" style="v" sid="1CH 6:18" />Abon ba nlum ba Kohati: Amram, Ijar, Hebron a Ujiel. <verse eid="1CH 6:18" /><verse number="19" style="v" sid="1CH 6:19" />Abon ba nlum ba Merari ba a: Mali a Musi. A wo li asi ajahbe nya anebe Levi nya bo nyono toono babnde bo: <verse eid="1CH 6:19" /><verse number="20" style="v" sid="1CH 6:20" />Gerson wo jolo nde no Libni: Jahati mmon no nlum no Libni, Jimma mmon no nlum no Jahati, <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />Joa wo jolo mmon no nlum no Jimma, Iddo mmon no nlum no Joa, Jera mmon no nlum no Iddo fvfo Jeaterai mmon no nlum no Jera. <verse eid="1CH 6:21" /><verse number="22" style="v" sid="1CH 6:22" />Et'tohngo ji Kohati ji a: Amminadab mmon no nlum no Kohati, Assir mmon no nlum no Kora, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />Elkana mmon no nlum no Assir, Ebiasaf mmon no nlum no Elkana, Assir mmon no nlum no Ebiasaf, <verse eid="1CH 6:23" /><verse number="24" style="v" sid="1CH 6:24" />Tahad mmon no nlum no Assir, Uriel mmon no nlum no Tahad, Ujjia mmon no nlum no Uriel, go Saul mmon no nlum no Ujjia. <verse eid="1CH 6:24" /><verse number="25" style="v" sid="1CH 6:25" />Abon ba nlum ba Elkana ba a: Amasai abola Ahimod, mmon ewe no nlum: Amasai wo jolo nde no Ahimod, <verse eid="1CH 6:25" /><verse number="26" style="v" sid="1CH 6:26" />go Elkana mmon no nlum no Ahimod, Jofai mmon no nlum no Elkana, Nahad mmon no nlum no Jofai, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />Eliab mmon no nlum no Nahad, Jeroham mmon no nlum no Eliab, Elkana mmon no nlum no Jeroham a Samwel mmon no nlum no Elkana. <verse eid="1CH 6:27" /><verse number="28" style="v" sid="1CH 6:28" />Abon ba nlum ba Samwel ba a: Joel ngbokambanga mmon go Abija etoono mmon no nlum. <verse eid="1CH 6:28" /><verse number="29" style="v" sid="1CH 6:29" />Go ebangenahb ji Merari, Mali mmon ewe no nlum: Libni mmon no nlum no Mali, Simei mmon no nlum no Libni, Ujja mmon no nlum no Simei, <verse eid="1CH 6:29" /><verse number="30" style="v" sid="1CH 6:30" />Simea mmon no nlum no Ujja, Haggia mmon no nlum no Simea, a Asaia jol mmon no nlum no Haggia.<verse eid="1CH 6:30" /></para>
  <para style="s">Anebe Levi Ba Jo Yimase Go Etahk Esowo</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />A wo li anebe Levi ba David ka bo eltum ase a yimi go etahk ji Jehova eji elkohl atahm Esowo ba no. <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />Bo jo yimi ase go mbuksong ebkpatahk elwahne ni li saang, tete Solomon si etahk Esowo ji Jehova go Jeusalem, bo jo limi ntum ebo jang jang ana bo tongo bo re bo lim. <verse eid="1CH 6:32" /><verse number="33" style="v" sid="1CH 6:33" />A wo li aneblem ba jo lim eltum a abon ebo ba nlum:</para>
  <para style="p" vid="1CH 6:33">Go ebangenahb Kohad, Heman wo jolo ntubesia nyimase, á jolo mmon no nlum no Joel, Joel mmon no nlum no Samwel, <verse eid="1CH 6:33" /><verse number="34" style="v" sid="1CH 6:34" />Samwel mmon no nlum no Elkana, Elkana mmon no nlum no Jeroham, Jeroham mmon no nlum no Eliel, Eliel mmon no nlum no Toa, <verse eid="1CH 6:34" /><verse number="35" style="v" sid="1CH 6:35" />Toa Mmon no nlum no Juf, Juf mmon no nlum no Elkana, Elkana mmon no nlum no Mahad, Mahad mmon no nlum no Amasai, <verse eid="1CH 6:35" /><verse number="36" style="v" sid="1CH 6:36" />Amasai mmon no nlum no Elkana, Elkana mmon no nlum no Joel, Joel mmon no nlum no Ajaria, Ajaria mmon no nlum no Jefania, <verse eid="1CH 6:36" /><verse number="37" style="v" sid="1CH 6:37" />Jefania mmon no nlum no Tahad, Tahad mmon no nlum no Assir, Assir mmon no nlum no Ebiasaf, Ebiasaf mmon no nlum no Korad, <verse eid="1CH 6:37" /><verse number="38" style="v" sid="1CH 6:38" />Korad mmon no nlum no Ijar, Ijar mmon no nlum no Kohad, Kohad mmon no nlum no Levi, fvfo Levi mmon no nlum no Isreel, <verse eid="1CH 6:38" /><verse number="39" style="v" sid="1CH 6:39" />Heman bele ekunu ji bo jo lung-e re Asaf ye ji jo yiimi go ejang eboblum bi Heman lok-e. Asaf mmon no nlum no Berekia, Berekia mmon no nlum no Simea, <verse eid="1CH 6:39" /><verse number="40" style="v" sid="1CH 6:40" />Simea mmon no nlum no Mikal, Mikal mmon no nlum no Baasea, Baasea mmon no nlum no Malkija, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />Malkija mmon no nlum no Etini, Etini mmon no nlum no Jera, Jera mmon no nlum no Adaia, <verse eid="1CH 6:41" /><verse number="42" style="v" sid="1CH 6:42" />Adaia mmon no nlum no Etan, Etan mmon no nlum no Jimma, Jimma mmon no nlum no Simei, <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />Simei wo jolo mmon no nlum no Jahad, Jahad mmon no nlum no Gerson, fvfo Gerson mmon no nlum no Levi, <verse eid="1CH 6:43" /><verse number="44" style="v" sid="1CH 6:44" />Ethan ji lohng go esi ejahbe ji Merari wo jolo ntubesi ayimi ase go etoono ane are. Anebe ebangenahb eje bo jo lungu bo re: Etan mmon no nlum no Kisi, Kisi mmon no nlum no Abdi, Abdi mmon no nlum no Malluk, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />Malluk wo jolo mmon no nlum no Hasabia, Hasabia mmon no nlum no Amajia, Amajia mmon no nlum no Hilkia, <verse eid="1CH 6:45" /><verse number="46" style="v" sid="1CH 6:46" />Hilkia wo jolo mmon no nlum no Amji, Amji mmon no nlum no Bani, Bani mmon no nlum no Semer, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />Semer jolo mmon no nlum no Mali, Mali mmon no nlum no Musi, Musi mmon no nlum no Merari, Merari mmon no nlum no Levi, <verse eid="1CH 6:47" /><verse number="48" style="v" sid="1CH 6:48" />Anebe Levi bako bo ka bo ntum nyehko go ebkpatahk etahk Esowo. <verse eid="1CH 6:48" /><verse number="49" style="v" sid="1CH 6:49" />Wo Eron a et'tohngo eje bo ba jolo ka ajom alimi go egudu ji bo kpo jahm njom fi, a egudu ji bo kpo jahm insen fi, go nsol nyehko kpee nyi li ka Edi ji Sahb L'li Saang, jo gongo ka Isreel, jang jang ana Mosis nlokeltum Esowo tibi bo. <verse eid="1CH 6:49" /><verse number="50" style="v" sid="1CH 6:50" />A wo li abon ba nlum ba Eron: Eleaja mmon no nlum no Eron, Pinehas mmon no nlum no Eleaja, Abisua mmon no nlum no Pinehas, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />Bukki wo jolo mmon no nlum no Abisua, Uji mmon no nlum no Bukki, Jerahia mmon no nlum no Uji, <verse eid="1CH 6:51" /><verse number="52" style="v" sid="1CH 6:52" />Merayod wo jolo mmon no nlum no Jerahia, Amaria mmon no nlum no Merayod, Ahitub mmon no nlum no Amaria, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />Jadok jolo mmon no nlum no Ahitub fvfo Ahimaaji jol mmon no nlum no Jadok. <verse eid="1CH 6:53" /><verse number="54" style="v" sid="1CH 6:54" />A wo li adi nlene bo, nya bo ka bo ana edi ebo, bo ka et'tohngo ji Eron bo ji lohng go ejahbe Kohad tibre ngbokambang a mbake jolo ka bo, <verse eid="1CH 6:54" /><verse number="55" style="v" sid="1CH 6:55" />bo ka bo Hebron go ajang ajahbe nya Juda a adi ajele nya jolo sennge bo kak. <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />wo adi ajele a aroko ajahbe nya jolo sennge nfam nyio bo ka Keleb mmon no nlum no Jefune. <verse eid="1CH 6:56" /><verse number="57" style="v" sid="1CH 6:57" />Ano wo bo ka et'tohngo ji Eron, Hebron ejahbe ji elbeke elbiiri a Libna, Jatir, Estemoa, <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />Hilen, Debir, <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />bo tob ko Asan, Jutta a Bet Semes, budu adi njele ebo. <verse eid="1CH 6:59" /><verse number="60" style="v" sid="1CH 6:60" />Go ebangennahb ji Benjamin bo ka bo Gibion, Geba, Alemed a Anatod a adi njele ebo. Kpee ajahbe nya bo bake no ka anebe Kohad jolo ewubu ejahbe ebra. <verse eid="1CH 6:60" /><verse number="61" style="v" sid="1CH 6:61" />Erik et'tohngo ji Kohad bo ka bo ejahbe ebwubu go ajahbe nya ejang ebangennahb ji Manase. <verse eid="1CH 6:61" /><verse number="62" style="v" sid="1CH 6:62" />Et'tohngo ji Gerson, ejahbe ejahbe, bo ka bo ewubu ejahbe era go et'tohngo ji Issaka, Aser a Naftali a ejang et'tohngo ji Manase ji li go Basan. <verse eid="1CH 6:62" /><verse number="63" style="v" sid="1CH 6:63" />Et'tohngo ji Merari, esi ejahbe esi ejahbe, bo ka bo ewubu ejahbe abal go et'tohngo ji Ruben, Gad a Jebulun. <verse eid="1CH 6:63" /><verse number="64" style="v" sid="1CH 6:64" />Ano wo abone Isreel ka anebe Levi ajahbe, a edi ajele ebo. <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />Go et'tohngo ji Juda, Simion a Benjamin bo ka bo go ajahbe nya bo ma tohko gamme abing. <verse eid="1CH 6:65" /><verse number="66" style="v" sid="1CH 6:66" />Anebe Kohad bandiki bo ka bo adi ellene a adi ajele, go ndi nyi et'tohngo ji Efreim. <verse eid="1CH 6:66" /><verse number="67" style="v" sid="1CH 6:67" />Go ejahbe ewong Efriim bo ka bo Sekem ejahbe elbiiri a Gejer, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />Jokmem, Beti Horon, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />Ajalon a Gati Rimmon, a edi ajele ebo. <verse eid="1CH 6:69" /><verse number="70" style="v" sid="1CH 6:70" />Go ejang ebangenahb ji Manase, anebe Isreel ka erik anebe Kohad, Aner a Bilem, go edi ajele ebo. <verse eid="1CH 6:70" /><verse number="71" style="v" sid="1CH 6:71" />Anebe Gerson bo ka bo: adi ellene ebo go ejang et'tohngo ji Manase, Golan ji Basan a Astorad a edi ajele ebo. <verse eid="1CH 6:71" /><verse number="72" style="v" sid="1CH 6:72" />Go et'tohngo ji Issakar bo ko Kedes, Daberati, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />Ramod, a Anem a edi ajele ebo. <verse eid="1CH 6:73" /><verse number="74" style="v" sid="1CH 6:74" />Go et'tohngo ji Aser bo ka bo Masal, Abdon a edi ajele, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />Hukok a Rehob a edi ajele ebo; <verse eid="1CH 6:75" /><verse number="76" style="v" sid="1CH 6:76" />Go et'tohngo ji Naftali, bo ka bo Kedesi ji Galilee, Hamon a Kiriatam, a edi ajele ebo. <verse eid="1CH 6:76" /><verse number="77" style="v" sid="1CH 6:77" />Anebe Merari erik anebe Levi, ka bo ndi nyia: Go et'tohngo ji Jebulun bo ka bo Jokneam, Karta, Rimmono a Tabo, a edi ajele ebo. <verse eid="1CH 6:77" /><verse number="78" style="v" sid="1CH 6:78" />Go et'tohngo ji Ruben sehng go aya Jodan ero bi Jeriko bo ka bo Bejer go ewumwum ndia Jaja, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />Kedemod a Mefaad, a edi ajele ebo; <verse eid="1CH 6:79" /><verse number="80" style="v" sid="1CH 6:80" />fvfo go et'tohngo ji Gad bo ka bo Ramod ji Gilead, Mahanam, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />Hesibon a Jajer, a edi ajele ebo.<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s">Et'tohngo ji Isaka</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />Abon ba nlum ba Issakar ba a: Tola, Pua, Jasub a Simron, bo ane ani kpe kpe kpee. <verse eid="1CH 7:1" /><verse number="2" style="v" sid="1CH 7:2" />Abon ba nlum ba Tola ba a: Uji, Refaya, Jeriel, Jamai, Ibsam a Samuel bo ba li atubesi ebangenahb ebo. Ngare nyi David jolo Ntul, et'tohngo ji Tola abanoko nta, ba bo kake bo abing go awer ebangenahb, bo jolo ane atahl alon alon nkpel atahl awubu a etahla nkpel erakera. '22,600.' <verse eid="1CH 7:2" /><verse number="3" style="v" sid="1CH 7:3" />Mmon no nlum no Uji wo a: Ijiraiya. Abon ba nlum ba Ijiraiya ba a: Mikel, Obadia, Joel a Isia. Bo ane alon, bo jolo atubesi ba ebangenahb. <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />Ana bo nyono go nwer ebangenahb ebo, bo jolo aneblum atahl alon alon nkpel atahlku, budu ane atahlara. '36,000' ba ma rehng go ebta anoko, tibre bo bele akal gbalee a abon abon. <verse eid="1CH 7:4" /><verse number="5" style="v" sid="1CH 7:5" />Abonannyehn ebo, ba jolo abanoko nta ba jolo ka ebangenahb ji Isaka, ana bo nyono go nwer ebangenahb ebo bo jolo aneblum atahl alon alon nkpel atahltahl nkpel ebal budu ane atahlara ane awubu. '87,000' kpe kpe kpee.<verse eid="1CH 7:5" /></para>
  <para style="s">Ebangenahb ji Benjamin</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 7:6" />Abon ba nlum ara ba Benjamin ba a: Bela, Beker a Jedayel. <verse eid="1CH 7:6" /><verse number="7" style="v" sid="1CH 7:7" />Abon ba nlum ba Bela ba a, Ejibon, Uji, Ujiel, Jerimoti a Iri, bo jolo ane alon kpe kpe kpee, bo ba jolo atubesi ebo ebangenahb. Ana bo nyono go nwer ebangenahb, bo jolo aneblum atahl alon alon nkpel atahl ewubu ane eltahla budu eltahl ane awubu ane ani '22,034' ba bahke ma nok ebta. <verse eid="1CH 7:7" /><verse number="8" style="v" sid="1CH 7:8" />Abon ba nlum ba Beker ba a: Jemira, Joasi, Eliejer, Elionayi, Omri, Jeremod, Abija, Anatod, a Alemed. Bo kpee jolo abon ba nlum ba Beker. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />Bo nyono abing ebo kak go nwer ana atubesi ebangenahb, aneblum jolo atahl alon alon nkpel atahla wubbal ane abale '20, 200' bo ji bahke ma nok nta. <verse eid="1CH 7:9" /><verse number="10" style="v" sid="1CH 7:10" />Mmon no nlum no Jedayel wo a: Bilhan. Abon ba nlum Bilhan ba a: Jeusi, Benjamin, Ehud, Kenana, Jetan, Tarsisi, a Ahisahar. <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />Abon ba nlum baa kpee ba Jedayel jolo atubesi ebangenahb. Bo jolo aneblum atahl alon alon nkpel atahl anehkeni budu ewubu ane abal '17,200' ba bahke ma je song nok ebta. <verse eid="1CH 7:11" /><verse number="12" style="v" sid="1CH 7:12" />Anebe Supim a Hupim bo tob lohng et'tohngo ji Ir. anebe Husim lohng et'tohngo ji Aher.<verse eid="1CH 7:12" /></para>
  <para style="s">Et'tohngo Ji Naftali</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 7:13" />Abon ba nlum ba Naftali ba a: Jajiel, Guni, Jejer a Silem bo lohng et'tohngo ji Bilha.<verse eid="1CH 7:13" /></para>
  <para style="s">Et'tohngo Ji Manase</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 7:14" />Abon ba nlum ba Manase ba a: Abon ebe ba nlum lohngo go Asriel mmon no nnea Aram no jolo nne elkoro ewe. Ye wo jele Makir ji jolo nde no Giled. <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />Makir koo nkal goji anebe Hupim a anebe Subim. Mbing nyi mmonannyehn no nkal bo jo lung-e re Maaka. Etoono mmon noko bo jo lungu re, Jelofahad, ye jele abon ba nkal ba ba. <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" />Maaka nkala Makir jele mmon no nlum ka-e no bo jo lung-e re Peresi. Mmonannyehn no nlum bo jo lung-e re Seresi, Peresi wo jolo nde no Ulam abola Rakem. <verse eid="1CH 7:16" /><verse number="17" style="v" sid="1CH 7:17" />Mmon no nlum no Ulam wo a, Bedan. Bo jia ba jolo abon ba nlum ba Giled, mmon no nlum no Makir, mmon no nlum no Manase. <verse eid="1CH 7:17" /><verse number="18" style="v" sid="1CH 7:18" />Hamoleked mmonannyehn no nkal no Giled ye wo jele Isihod, Abiejer a Mala. <verse eid="1CH 7:18" /><verse number="19" style="v" sid="1CH 7:19" />Abon ba nlum ba Semida ba a: Ahian, Sekem, Likhi a Aniam.<verse eid="1CH 7:19" /></para>
  <para style="s">Et'tohngo Ji Efriim</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 7:20" />Et'tohngo ji Efriim ji a: Sutela jolo mmon no nlum no Efriim, Bered mmon no nlum no Sutela, Tahad mmon no nlum no Bered, Eleada mmon no nlum no Tahad, Tahad mmon no nlum no Eleada <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />Jabad jolo mmon no nlum no Tahad, a Sutela ji jolo mmon no nlum no Jebad. Aneblum ba Gad wulu Ejer abola Elead bo wulu bo eji bo tahme re bo song v atohko ndi nya nfono ejahbe no Gad. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />Efriim ndea bo noongo elkv go afung tvv, abonanyehn ebe ba, ba kak-e eltim. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />A kehm kpe noongo a nkal ewe, á sa ela jel mmon no nlum. Efriim jo lung-e re Beria, tib go ebibi ji yele ege ebangenahb. <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />Mmon ewe no nkal bo jo lung-e re, Seera, ye wo kake nsi nyi ero nfam a erede nfam bi Beti Horon a Ujen Seera. <verse eid="1CH 7:24" /><verse number="25" style="v" sid="1CH 7:25" />Refa wo jolo mmon no nlum no Beria, Resef mmon no nlum no Refa, Tela mmon no nlum no Resef, Tahan mmon no nlum no Tela, <verse eid="1CH 7:25" /><verse number="26" style="v" sid="1CH 7:26" />Ladan mmon no nlum no Tahan, Amihud mmon no nlum no Ladan, Elisama mmon no nlum no Amihud, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />Nun mmon no nlum no Elisama, a Josua mmon no nlum no Nun. <verse eid="1CH 7:27" /><verse number="28" style="v" sid="1CH 7:28" />Ndia ebo a adi nya bo lene no jolo rehng go Betel a aroko ajahbe ebo sennge kak, tete rehng go Naaran go ero nfam, Gejer a aroko ajahbe ebo sennge kak go ejang erede nfam, fvfo Sekem a aroko ajahbe eye kpee tete rehng Ayya a arohko ajahbe eye. <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />Go nkona ndi nyi Manase, arohko ajahbe nya jolo, Bed San, Taanak, Megido, Dor a aroko ajahbe ebo sennge kak. Et'tohngo ji Josef mmon no nlum no Isreel bo ba lene arohko ajahbe nyao.<verse eid="1CH 7:29" /></para>
  <para style="s">Et'tohngo Ji Aser</para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30" />Abon ba nlum ba Aser ba a: Imna, Isiva, Isivi, a Beria. Mmonannyehn ebo no nkal bo jo lung-e re, Sera. <verse eid="1CH 7:30" /><verse number="31" style="v" sid="1CH 7:31" />Abon ba nlum ba Beria ba a: Heber abola Malkiel, ji jolo nde no Birjaid. <verse eid="1CH 7:31" /><verse number="32" style="v" sid="1CH 7:32" />Heber wo jolo nde no Jefled, Somer a Hotam go mmonannyehn ebo no nkal Sua. <verse eid="1CH 7:32" /><verse number="33" style="v" sid="1CH 7:33" />Abon ba nlum ba Jefled ba a: Pasak, Bimhal a Asivad. Bo ba jolo abon ba nlum ba Jefled. <verse eid="1CH 7:33" /><verse number="34" style="v" sid="1CH 7:34" />Abon ba nlum ba Soma ba a: Ahi, Roga, Hubba, a Aram. <verse eid="1CH 7:34" /><verse number="35" style="v" sid="1CH 7:35" />Abon ba nlum ba Helem mmonannyehn Soma ba a: Jofa, Imna, Selesi a Amal. <verse eid="1CH 7:35" /><verse number="36" style="v" sid="1CH 7:36" />Abon ba nlum ba Jofa ba a: Sua, Harnefa, Sual, Beri, Imra, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />Bejer, Hod, Samma, Silsa, Itran a Beera. <verse eid="1CH 7:37" /><verse number="38" style="v" sid="1CH 7:38" />Abon ba nlum ba Jeter ba a: Jefune, Pisiba a Ara. <verse eid="1CH 7:38" /><verse number="39" style="v" sid="1CH 7:39" />Abon ba nlum ba Ulla ba a: Ara, Hanniel a Rijia. <verse eid="1CH 7:39" /><verse number="40" style="v" sid="1CH 7:40" />Bo jia kpee lohng go et'tohngo ji Aser, bo jolo atubesi ebangenahb, aneblum baa bo yehke na bo, atahntahn atakuru abohng, bo jolo ane ba egahme ebo ma yeere, ba jolo atubesi. Ba bahke ma nok ebta, bo jolo ane atahl alon alon nkpel atahl awubu budu ane atahlara '26,000' ana bo fange kak go nwer.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s">Et'tohngo Ji Benjamin</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />Benjamin wo jolo nde no Bela, Bela wo jolo ngbokambanga mmon ewe no nlum, Asibel jol etoono mmon no nlum, Ahara etoono mmon no nlum go ane ara, <verse eid="1CH 8:1" /><verse number="2" style="v" sid="1CH 8:2" />Noha etoono mmon no nlum go ane ani, Rafa etoono mmon no nlum go ane alon. <verse eid="1CH 8:2" /><verse number="3" style="v" sid="1CH 8:3" />Abon ba nlum ba Bela ba a: Adda, Gera, Abihud, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />Abisua, Naaman, Ahoa, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />Gera, Sefufan, a Huram. <verse eid="1CH 8:5" /><verse number="6" style="v" sid="1CH 8:6" />At'tohngo nya Ehud bo ji jolo atubesi abangenahb ane ba lene go Geba ba bo kame bo yehke re bo song jol go Manahad: <verse eid="1CH 8:6" /><verse number="7" style="v" sid="1CH 8:7" />Abon ba nlum ba Ehud: Naaman, Ahija, a Gera, bo kame bo yehke, Gera wo jolo nde no Uja a Ahihud. <verse eid="1CH 8:7" /><verse number="8" style="v" sid="1CH 8:8" />Eji Saharaim tene akal ebe Husim a Baara, Saharaim jolo o Moab ko nnenkal no bo kpo lung-e re Hodesi a jel abon ba nlum baa ka-e. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />Jobab, Jibia, Mesa, Malkam, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />Jeuji, Sakia a Mirma. Abon ebe ba nlum ba jolo atubesi ebangenahb. <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />Nkal ewe Husim tob jele Abitub a Elpaal ka-e. <verse eid="1CH 8:11" /><verse number="12" style="v" sid="1CH 8:12" />A wo li abon ba nlum ba Elpaal ba a: Eber, Misam, Semed, Semed wo si nfam ejahbe Ono, Lod a abon ajahbe ebe sennge kak, <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />fvfo Beria a Sema bo ji jolo atubesi ebangenahb ane ba lene go Aijalon, bo ba kame ane ba lene Gad. <verse eid="1CH 8:13" /><verse number="14" style="v" sid="1CH 8:14" />Ahio, Sasak, Jeremod, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />Jebadia, Arad, Eder, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />Mikael, Isipa, a Joha bo ba jolo abon ba nlum ba Beria. <verse eid="1CH 8:16" /><verse number="17" style="v" sid="1CH 8:17" />Jebadia, Mesulam, Hijika, Heber, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />Isimerayi, Ijilia, a Jobab bo ba jolo abon ba nlum ba Elpaal. <verse eid="1CH 8:18" /><verse number="19" style="v" sid="1CH 8:19" />Jakim, Jikri, Jabdi, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />Elienayi, Jiletayi, Eliel, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />Adaya, Berayiya, a Simrad bo ba jolo abon ba nlum ba Simei. <verse eid="1CH 8:21" /><verse number="22" style="v" sid="1CH 8:22" />Isipan, Eber, Eliel, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />Abdon, Jikri, Hanan, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />Hanania, Elam, Antotija, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />Ifdeyiya a Penuel bo ba jolo abon ba nlum ba Sasak. <verse eid="1CH 8:25" /><verse number="26" style="v" sid="1CH 8:26" />Samserayi, Seharia, Atalia, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />Jaaresiya, Elija a Jikri bo ba jolo abon ba nlum ba Jeroham. <verse eid="1CH 8:27" /><verse number="28" style="v" sid="1CH 8:28" />Bo jia kpee jolo atubesi abangenahb, atubesi ba bo kake bo abing go nwer et'tohngo ebo, fvfo bo lene Jeusalem. <verse eid="1CH 8:28" /><verse number="29" style="v" sid="1CH 8:29" />Jeyel ji jolo nde no Gibeon lene go Gibeon. Mbinga nkal ewe bo jo lung-e re Maaka, <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />fvfo ngbokambang a mmon ewe no nlum bo jo lung-e re Adon. Abon ebe ba nlum bako bo jo lungu bo re, Jur, Kisi, Baal, Ner, Nadab, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />Gedo, Ahio, Jekaria, <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />a Miklod, ji jolo nde no Simea. Bo fvfo lene kohlo abonanyehn ebo go Jeusalem. <verse eid="1CH 8:32" /><verse number="33" style="v" sid="1CH 8:33" />Ner wo jolo nde no Kisi, Kisi jol nde no Sol, fvfo Sol jol nde no Jonatan, Milki-Sua, Abinadab a Esi-Baal. <verse eid="1CH 8:33" /><verse number="34" style="v" sid="1CH 8:34" />Mmon no Jonatan no nlum bo jo lung-e re Merib-Baal, Merib-Baal wo jolo nde no Mika. <verse eid="1CH 8:34" /><verse number="35" style="v" sid="1CH 8:35" />A wo li abon ba nlum ba Mika: Piton, Melek, Tarea a Ahaji. <verse eid="1CH 8:35" /><verse number="36" style="v" sid="1CH 8:36" />Ahaji wo jolo nde no Jehoada, Jehoada jol nde no Alemed, Ajimaved, a Jimri, fvfo Jimri wo jolo nde no Moja. <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />Moja wo jolo nde no Binea; Rafa wo jolo mmon no nlum no Binea, Eleasa mmon no nlum Rafa, Ajel mmon no nlum no Eleasa. <verse eid="1CH 8:37" /><verse number="38" style="v" sid="1CH 8:38" />Ajel bele abon ba nlum na arakara, a wo li abing ebo: Ajirikam, Bokeru, Isimael, Searia, Obadia, a Hanan. Bo jia ba jolo abon ba nlum ba Ajel. <verse eid="1CH 8:38" /><verse number="39" style="v" sid="1CH 8:39" />A wo li abon nlum ba Ajel mmonannyehn Esek ba a: Ulam wo jolo ngbokambanga mmon no nlum, Jeusi jol etoono, Elifeled jol etoono ane ara. <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />Abon ba nlum ba Ulam jolo atahntahn atakuru ba bahke ma fili elban. Bo bele abon ba nlum gbalee a abon, abon ebo, bo jolo ane atahl alon kunu ane abal ane awubu kpe kpe. Bo jia kpee lohngo et'tohngo ji Benjamin.<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />Anebe Isreel kpee bo kake bo abing toono go ebo at'tohngo go nwer nyi atul ba Isreel a ba Juda. Bo kpu bo song kak eju go Bebilon, tib go ebo ek'kpunu Esowo.<verse eid="1CH 9:1" /></para>
  <para style="s">Ane Ba Li Go Jeusalem</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 9:2" />Agbokombang ane ba gbo mbang kehnge eju song kpiri nsol ebo go eboa nsi jolo anebe Isreel, Abalimajom, anebe Levi, a alokeltum go etahk Esowo. <verse eid="1CH 9:2" /><verse number="3" style="v" sid="1CH 9:3" />Bo ji lohng et'tohngo ji Juda, ji Benjamin, ji Efriim, a ji Manase bo ji lene go Jeusalem bo ba. <verse eid="1CH 9:3" /><verse number="4" style="v" sid="1CH 9:4" />Utayi mmon no nlum no Amihud, Amihud ji mmon no nlum no Omri, Omri ji mmon no nlum no Imri, ji mmon no nlum no Bani, Bani lohng go et'tohngo ji Peresi mmon no nlum no Juda. <verse eid="1CH 9:4" /><verse number="5" style="v" sid="1CH 9:5" />Bo ji lohng go nnahb nyi Selan, Asayiya wo bo gbo mbang jel-e a abon ba nlum ba Asaia. <verse eid="1CH 9:5" /><verse number="6" style="v" sid="1CH 9:6" />Go nnahb nyi Jera: Jewel. Nrur ane ba Juda jolo atahl alon alon nkpel erakera kunu ane atahlani ane awubu. <verse eid="1CH 9:6" /><verse number="7" style="v" sid="1CH 9:7" />Go nnahb nyi Benjamin, Salu mmon no nlum no Mesulam, Mesulam ji mmon no nlum na Hodavia, Hodavia ji mmon no nlum no Hasenua; <verse eid="1CH 9:7" /><verse number="8" style="v" sid="1CH 9:8" />Ibneya mmon no nlum no Jeroham; Ela mmon no nlum no Uji, Uji ji mmon no nlum no Mikri; a Mesulam ji mmon no nlum no Sefatia, Sefatia ji mmon no nlum no Rewel, Rewel ji mmon no nlum no Ibnija. <verse eid="1CH 9:8" /><verse number="9" style="v" sid="1CH 9:9" />Ane ba lohng et'tohngo ji Bejamin ba bo kake bo abing toono ebo ebangenahb bo ruru rehng, ane atahl alon alon nkpel esehmwubu kunu ane atahl abal ane elku a nne awohng '956'. Ane baa kpee ba jolo atubesi ane go ebo ebangennahb. <verse eid="1CH 9:9" /><verse number="10" style="v" sid="1CH 9:10" />Go et'tohngo ji abalimajom, Jedaya, Jehoarib, a Jakin, <verse eid="1CH 9:10" /><verse number="11" style="v" sid="1CH 9:11" />Ajaria mmon no nlum no Hilkia, Hilkia ji mmon no nlum no Mesulam, Mesulam ji mmon no nlum no Jadohk, Jadohk ji mmon no nlum no Merayod, Merayod ji mmon no nlum no Ahitub. Ajaria wo jolo ntubesi no etahk Esowo. <verse eid="1CH 9:11" /><verse number="12" style="v" sid="1CH 9:12" />Adaia, ji mmon no nlum no Jeruham, Jeruham ji mmon no nlum no Pasihur, Pasihur ji mmon no nlum no Malikija, a Maasayi ji mmon no nlum no Adiel, Adiel ji mmon no nlum no Jajera, Jajera ji mmon no nlum no Mesulam, Mesulam ji mmon no nlum no Mesilemid, Mesilemid ji mmon no nlum no Immer. <verse eid="1CH 9:12" /><verse number="13" style="v" sid="1CH 9:13" />Abalimajom ba jolo atubesi go ebangenahb bo jolo ane atahl alon alon elku a nkpel ebbal kunu ane atahlara '1,760.' Bo jolo aneblum ba bahke ma lim ejum, bo ba eltum etahk Esowo woomo go ebo abo. <verse eid="1CH 9:13" /><verse number="14" style="v" sid="1CH 9:14" />Anebe Levi, Semaya ji mmon no nlum no Hasub, Hasub ji mmon no nlum no Ajirikam, Ajirikam ji mmon no nlum no Hasabiya, Semaya nnea Merari. <verse eid="1CH 9:14" /><verse number="15" style="v" sid="1CH 9:15" />Bakbakar, Heresi, Galal, a Matania ji mmon no Mika, Mika ji mmon no nlum no Jikri, Jikri ji mmon no nlum no Asafi; <verse eid="1CH 9:15" /><verse number="16" style="v" sid="1CH 9:16" />Obadia ji mmon no nlum no Semaya, Semaya ji mmon no nlum no Galal, Galal ji mmon no nlum no Jedutun, a Berekia ji mmon no nlum no Asa, Asa ji mmon no nlum no Elkana, bo ji lene go abon ajahbe Netofad. <verse eid="1CH 9:16" /><verse number="17" style="v" sid="1CH 9:17" />Abab'baabe etimbu ba a: Salum, Akub,Talmon, Ahiman, a anebe Levi bako. Salum wo jolo ntubesia bo, <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />no jo baabe etimbu ntul ji ero nfam tete rehng ngare nyia. Ane baa ba jo baabe etimbu go nji nyi anebe Levi. <verse eid="1CH 9:18" /><verse number="19" style="v" sid="1CH 9:19" />Sallum ji mmon no nlum no Kore, Kore ji mmon no nlum no Abiasaf, Abiasaf ji mmon no nlum no Kora, Sallum a anebe Kora bo jo baabe atimbu, bo anebe Kora bo ba jolo ka eltum elbaabe ni Agudu Abutahk, ana at'tohngo babnde ba nkul ebo jo baabe edi elsehnge yel ebkpatahk Jehova. <verse eid="1CH 9:19" /><verse number="20" style="v" sid="1CH 9:20" />Go ngare nyi ma sehng, Finehasi ji mmon no nlum no Eleaja wo jolo ntubesi eltum no jo baabe atimbu, Jehova jolo a ne. <verse eid="1CH 9:20" /><verse number="21" style="v" sid="1CH 9:21" />Jekaria ji mmon no nlum no Meselemia wo jolo mb'baabe no etimbu ji elsehnge yel go Ebkpatahk Elwane. <verse eid="1CH 9:21" /><verse number="22" style="v" sid="1CH 9:22" />Bo kpee ji bo yehke bo re bo jo baabe Atimbu bo jolo ane atahlawubu kunu ewubu ane abal '212.' Bo kake bo abing go nwer toono ajahbe ebo nya bo lene no. Ntula Devid a nnyehnamahra Samwel wo, ka babnde ba nkul eltum nio, tib bo ba bo jo bum bo go etingitingi. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />Bo a at'tohngo ebo, bo ba eltum elbaabe ni atimbu Etahk Jehova jolo ka bo, ji bo jo lung re, Ebkpatahk Elwane. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />Abab'baabe jolo go nkpe na eni: ero nfam, erede nfam, ebobkal a eboblum nfam. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />Anebe Levi ba lene abon ajahbe, jolo re bo jo lohng ba lim esennge eltum ebo go nfung esehma esehma. <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />Atubesi ane ani ba jo baabe atimbu nyao, bo ji jolo anebe Levi, bo ba bo yake akp'kpa nya bo jo kuuru nsol go etahk Esowo ka bo. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />Bo bahke tiki jol o atv sennge etahk Esowo kak, tibre bo bahke tiki baabe; bo ba egbokoro woomo bo go abo re bo jo lennge atimbu efungfu abehng abehng. <verse eid="1CH 9:27" /><verse number="28" style="v" sid="1CH 9:28" />Bo jindiki jolo ka bo re, bo jo kpur nsol nyi bo kpo ko lim eltum o Etahk Esowo; jolo ka bo re bo l'ko nsol nyio ba, bo jo fange, bo l'kehm feere a nsol nyio, bo tob jo fange. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />Bo jindiki bo ka bo eltum ni li re bo jo kpur nsol nyi bo jo ko lim eltum go etahk Esowo, a nsol kpee nyi li edi ji li saang, a akahmekahme abe, go amahm, akehng oliv, insen a nsol nyi kpo lim nsol yebe. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />Wo abalimajom bako jolo ka bo re bo jo semme nsol nyi kpo lim nsol yebe. <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />Nnea Levi no bo kpo lung-e re, Matitia ye ji jolo ngbokambanga mmon no nlum no Sallum nnea Kora, ye wo bo ka-e eltum ni abe asemme ko lim abred nya ayare. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />Egom anebe Kohad ba jolo anebe Levi, jolo ka eltim ni bo jo lim abred nya bo jo kunu ekp'kuru efung Esabad abehng abenhg. <verse eid="1CH 9:32" /><verse number="33" style="v" sid="1CH 9:33" />Bo ji jolo abakubu ase atubesi ba ebangenahb ji anebe Levi, bo jo jolo go akp'kpa nya etahk Esowo, fvfo bo y'yehke bo go ntum nyehko tibre bo ba jolo ka eltim nio atv a njul. <verse eid="1CH 9:33" /><verse number="34" style="v" sid="1CH 9:34" />Bo aneblum baa kpee jolo atubesi ba et'tohngo ebangenahb ji anebe Levi, bo kake abing ebo go nwer. Bo lene go Jeruselem.<verse eid="1CH 9:34" /></para>
  <para style="s">Ebangenahb Ji Ntula Sol</para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 9:35" />Jeyel ji jolo nde no Gibeon lene go Gibeon. Nkal ewe bo lung-e Maaka, <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />fvfo ngbokambanga mmon no nlum bo jo lung-e re, Abdon, Jur wo toon-e, Kisi, Baal, Ner, Nadab, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />Gedor, Ahio, Jekaria, a Miklod. <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />Miklod wo jolo nde no Simeam. Bo fvfo lene kohlo abonanyehn ebo go Jeuselem. <verse eid="1CH 9:38" /><verse number="39" style="v" sid="1CH 9:39" />Ner wo jolo nde no Kisi. Kusi jol nde no Sol, Sol jol nde no Jonatan, Malkisua, Abinadab a Esi-Baal. <verse eid="1CH 9:39" /><verse number="40" style="v" sid="1CH 9:40" />Mmon no nlum no Jonatan wo a: Merib-Baal ji jolo nde no Mika. <verse eid="1CH 9:40" /><verse number="41" style="v" sid="1CH 9:41" />Abon ba nlum ba Mika ba a; Piton, Melek, Taria, a Ahaji. <verse eid="1CH 9:41" /><verse number="42" style="v" sid="1CH 9:42" />Ahaji wo jolo nde no Jada, Jada jol nde no Alemed, Ajimaved, a Jimri, fvfo Jimri wo jolo nde no Moja. <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />Moja wo jolo nde no Binea, Rafaya ji mmon no nlum no Binea, Eleasa ji mmon no nlum no Rafaya, Ajel ji mmon no nlum no Eleasa. <verse eid="1CH 9:43" /><verse number="44" style="v" sid="1CH 9:44" />Ajel bele abon ba nlum na arakera, a wo li abing ebo: Ajirikam, Bokeru, Isimel, Seriya, Obadiya a Hanan. Bo ba jolo abon ba nlum ba Ajel.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s">Ana Sol Wulu Elne</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />Ngare nyia anebe Filista noko a Isreel, anablumu Isreel be ebo esamahr, bo wulu anebe Isreel gbalee go egburu ewong ji Gilboa. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />Anebe Filista jo kame Sol g'gingi a abon ebe ba nlum, bo wulu abon ebe ba nlum, Jonatan, Abinadab a Malki-Sua. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />Enok fubu gbale sennge Sol kak, fvfo eji atakelban kpir-e no, bo lim-e nsol. <verse eid="1CH 10:3" /><verse number="4" style="v" sid="1CH 10:4" />Sol tongo nfilansol ebta ewe re &lt;&lt;Wob ekahngkahng eba wo jahm-m wul, tohko jol ano ane baa ba kil jo yehke nrur bahke ba suu-m.&gt;&gt;Wo nfilansol ebta ewe eko tan-e tan á limem ano, owo Sol kehm koko ekahngkahng b'be gbo nyede wul elne. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />Eji nfilansol ebta ewe nyehne re Sol ebkpo, ye fvfo tob gbo nyede ekahngkahng ebe tob kpo. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />Ano wo Sol a abon ebe ba nlum na ara kpo no, a anebe etahk ebe kpee. <verse eid="1CH 10:6" /><verse number="7" style="v" sid="1CH 10:7" />Eji anebe Isreel kpee ba jolo go edamme nyehne re nsoja ebo ebbe, fvfo Sol a abon ebe ba nlum bobkpo, anebe Isreel be ajahbe ebo sa. Anebe Filista fere ba jol o. <verse eid="1CH 10:7" /><verse number="8" style="v" sid="1CH 10:8" />Njahm fungfu yehko, eji anebe Filista ba no ba kehme akvne feede re bo ko ji bo jo seb, bo nyehne ekv ji Sol a abon ebe ba nlum nong go egburu ewong ji Gilboa. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />Bo ba yehk-e nsol ebjing, fere kim-e esi rod nsol ebta enye, fere tum atiingetib tv go ndi anebe Filista kpee re, bo tiingi ntib nyao go ntahk eblom ebo a ane ebo. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />Bo ko nsol ebta Sol song kak go etahk asowo ebo, fere rod esi eje song tohko go etahk elom Dagon. <verse eid="1CH 10:10" /><verse number="11" style="v" sid="1CH 10:11" />Eji ane kpee ba lene go Jabesi Giled wuku ji anebe Filista ma lim Sol, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />atahntahn aneblum ebo kpee kehm tahme song rod ekv ji Sol a nya abon ebe ba nlum ko ba ga Jabes. Owo bo song kpa akv ebo kak go egburu nla eti go Jabes, fvfo bo bade njal nfung esehma. <verse eid="1CH 10:12" /><verse number="13" style="v" sid="1CH 10:13" />Sol kpoo tibre á belem ekakesehk a Jehova, á bumem ellum ni Jehova á jo bahbe abukumbu re bo tib-e mbang, <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />fvfo á joom bahb Jehova. Owo Jehova kehm-e wulu fere faake etul ka Devid mmon no nlum no Jese.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s">Ana Bo Bobo Devid Etul Go Isreel</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />Ajahbe Isreel kpee kehm bake ba kono asi goji Devid go Hebron, kehm bungu re, &lt;&lt;Wahr agubjing enya nya a alung a lung. <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />Go njahm, ngare nyi Sol jolo ntul, wo wo jo ko nsoja Isreel je ebta. Fvfo Jehova Esowo eba bungu tong-a re, wo wo bahke baabe Isreel ane ebame, fvfo á bahke jolo nne no bahke fili bo.&gt;&gt; <verse eid="1CH 11:2" /><verse number="3" style="v" sid="1CH 11:3" />Eji anebkul Isreel kpee ma ba goji ntul a Devid ga Hebron, á ko nwongo a bo go Hebron go esamahr bi Jehova. Fvfo bo kak-e akehng go esi re á jol ntul ka Isreel, ana Jehova ma nyam sehng goji Samwel.<verse eid="1CH 11:3" /></para>
  <para style="s">Devid Noko Ebta Ko Jeruselem</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />Devid a anebe Isreel kpee jene je Jeruselem, ji lohngo re Jebusi Anebe Jebusi ba lene o, <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />tongo Devid re, á nehm yel a. Jol tvtv o, Devid noko ko abuntahk nya Jayon, bo fere jo lung re, ejahbe ji Devid. <verse eid="1CH 11:5" /><verse number="6" style="v" sid="1CH 11:6" />Devid ebbung re, &lt;&lt;nne no l'gbo mbang ebta bia bi anebe Jebusi ye wo bahke jolo ntubesia nsoja no Isreel.&gt;&gt; Joab mmon no nlum no Jeruya wo mehle gbo mbang ebta, fvfo á ba jolo ntubesia nsoja. <verse eid="1CH 11:6" /><verse number="7" style="v" sid="1CH 11:7" />Devid song jolo edi ekobta, owo wahnge bo jo lung re ejahbe ji Devid. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />Á si ejahbe sennge kak, bomo go adamme nya bo kake ndi tete rehng ekahme ji bo lange sennge nfam kak, gana Joab kp'tuungu erik ejahbe. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />Fvfo Devid jo kpe gbal na go atahne, tibre Jehova ji kp'fili elbung a ndi jolo a ne.<verse eid="1CH 11:9" /></para>
  <para style="s">Atahntahn Atahkuru Nsoja Nyi Devid</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />A wo li atubesi atahntahn atukuru nsoja nyi Devid, bo budu a Isreel kpee, bo ba ka-e atahne etul re, á nyange rehng ndi nyio kpee, ana Jehova ma nyam. <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />A wo li nwer nyi bo kake abing nya atahntahn atukuru nsoja nyi Devid; Jasobeyam nnea Hakmon ye wo jolo egburu ntubesi no nnen, á ko elkong ene wul ane atahlku '300' go enok ajehng. <verse eid="1CH 11:11" /><verse number="12" style="v" sid="1CH 11:12" />Nne no toon-e no bo jo lung-e re, Eleaja ji mmon no nlum no Dodayi nnea Aho, ye wo jolo nne awohng go ellong atahntahn atakuru na ara, <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />Á jolo a Devid go Pasi Damim eji anebe Filista kono re bo nok ebta. Go edi ji jolo emahng ji nkohla abali ma kab m'meeke, nlong nsoja Isreel nyehko be esamahr anebe Filista. <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />Wo bo ba rehne akpade go elka emahng nio. Bo yiimi nok wul anebe Filista, fvfo Jehova ka bo egburu esehngebta. <verse eid="1CH 11:14" /><verse number="15" style="v" sid="1CH 11:15" />Go ellong agburu atubesi eltahl ane awubu '30', ane ara song kpiri Devid go ekpartal ji egong Adulam, gana ellong anebe Filista ebba kak elsi ga edamme ji Refayim. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />Ngare nyio Devid li go ekobta. fvfo nlong nsoja nyi anebe Filista li Betlehem. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />Devid alahb kehme koro, á kehm bungu re, &lt;&lt;Eeya, li re nne bahke ma song ko alahb elwoko go elbing alahb ni li kohlo eti mbu ji Betlehem ba ka-m eyee!&gt;&gt; <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />Owo ane ara bao kehm yange sehng go ellong nsoja nyi anebe Filista, song tohng alahb go elbingalahb ni li eti mbu ji Betlehem, sol ba ka Devid. Wo, á tene elwoko, ji á fere lim, á yaange wohng go ana ejum njom ka Jehova. <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />Á bungu re, &lt;&lt;Esowo k'taame me n lim jia, Anv, me n wo alung ane ba ma riki elkpin eboa?&gt;&gt; Tib bob riki nkpin ebo song tuk alahb, fere ko feere a ni, Devid lohkem wo. Awo li egburu ejum ji atahntahn atakuru ane ara bao limi no. <verse eid="1CH 11:19" /><verse number="20" style="v" sid="1CH 11:20" />Abisayi ji mmonannyehna Joab no nlum wo jolo ntubesi no nnen go ane ara bao. Á koo elkong ene wul ane atahlku '300,' fvfo wahnge elgahm ene yeere ana ane ara bako. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />Á bele ekpunu budu gbalee sehnge ane ara bako, fvfo ye wo jolo ntubesi abo, jol tvtv eji bo ki-e fange kak ebo ellong. <verse eid="1CH 11:21" /><verse number="22" style="v" sid="1CH 11:22" />Benaya mmon no nlum no Jehoyada etahntahn n'noko no lohng go Kabjeel, limi egburu ndakanding eltum. Á wulu atahntahn atubesi anebe Moab na abal. Á tob tahme song yel elbing, efung elahb atal song wul egabe. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />Á wulu nnea Ijib no labe rehng efid ebsehma kunu ejang go elkul ero. Jol tvtv o, eji nnea Ijib noo fili ellong ege ebo a ntahke elban ni sahb s'subu ana ebti bi bo kpo ko tub abomo. Benaya fili ebkpun song kpi-e, á taare nnea Ijib elkong nio ege ebo fere ko elkong nio wul-e. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />Ana wo jolo eltum ni Benaya mmon no nlum no Jehoyada limi no, ye fvfo tob lohngo elgahm ana atahntahn atakuru ara bako. <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />Ye bele egburu ekpunu sehnge eltahl ane awubu bao '30,' wo bo we-e fangem kak ellong ane ara bao. Fvfo Devid lim-e ntubesi no ellong ni jo baab-e. <verse eid="1CH 11:25" /><verse number="26" style="v" sid="1CH 11:26" />Atahntahn atakuru nyao abing ebo nya a. Asahel mmonnayehn Joab no nlum, Elhanan mmon no nlum no Dodo ye ji lohng go Betlehem, <verse eid="1CH 11:26" /><verse number="27" style="v" sid="1CH 11:27" />Sammoti nnea Haro, Heleji nnea Pelon, <verse eid="1CH 11:27" /><verse number="28" style="v" sid="1CH 11:28" />Ira mmon no nlum no Ikesi ye lohngo go Tekoa, Abiejer ji lohngo go Anatoti, <verse eid="1CH 11:28" /><verse number="29" style="v" sid="1CH 11:29" />Sibekayi nnea Husa, Ilayi nnea Aho, <verse eid="1CH 11:29" /><verse number="30" style="v" sid="1CH 11:30" />Maharayi nnea Netofa, Heled mmon no nlum no Baana nnea Netofa, <verse eid="1CH 11:30" /><verse number="31" style="v" sid="1CH 11:31" />Itayi mmon no nlum no Rebayi ye lohng go Gibea et'tohngo ji Bejamin, Benaya nnea Perato, <verse eid="1CH 11:31" /><verse number="32" style="v" sid="1CH 11:32" />Hurayi ji lohng edamme ji Gasi, Abiel nnea Arba, <verse eid="1CH 11:32" /><verse number="33" style="v" sid="1CH 11:33" />Ajimaved nnea Baharum, Eliyaba nnea Saalbon, <verse eid="1CH 11:33" /><verse number="34" style="v" sid="1CH 11:34" />abon ba nlum ba Hasem nnea Gijon, Jonatan mmon no nlum no Sagee nnea Harari, <verse eid="1CH 11:34" /><verse number="35" style="v" sid="1CH 11:35" />Ahiyam mmon no nlum no Sakar nnea Harari, Elifal mmon no nlum no Ur, <verse eid="1CH 11:35" /><verse number="36" style="v" sid="1CH 11:36" />Hefer nnea Mekerad, Ahija nnea Pelon, <verse eid="1CH 11:36" /><verse number="37" style="v" sid="1CH 11:37" />Hejiro nnea Kamel, Narayi mmon no nlum no Ejibayi, <verse eid="1CH 11:37" /><verse number="38" style="v" sid="1CH 11:38" />Joyel mmonannyehna Natan no nlum, Mibhar mmon no nlum no Hagri, <verse eid="1CH 11:38" /><verse number="39" style="v" sid="1CH 11:39" />Jelek nnea Ammon, Naharayi nnea Beroti, ye wo jo fili nsol ebta nyi Joab mmon no nlum no Jeruya, <verse eid="1CH 11:39" /><verse number="40" style="v" sid="1CH 11:40" />Ira nnea Itri, Gareb nnea Itri, <verse eid="1CH 11:40" /><verse number="41" style="v" sid="1CH 11:41" />Uriya nnea Hiti, Jabad mmon no nlum no Alayi, <verse eid="1CH 11:41" /><verse number="42" style="v" sid="1CH 11:42" />Adina mmon no nlum no Sija ye lohng go et'tohngo ji Ruben, ye jolo ntubesi go et'tohngo ji Ruben a eltahl ane awubu '30' ba toon-e no, <verse eid="1CH 11:42" /><verse number="43" style="v" sid="1CH 11:43" />Hanan mmon no nlum no Maaka, Josafad nnea Mitin, <verse eid="1CH 11:43" /><verse number="44" style="v" sid="1CH 11:44" />Ujiya nnea Asitera, Sama a Jeyel abon ba nlum ba Hotam nnea Aroye, <verse eid="1CH 11:44" /><verse number="45" style="v" sid="1CH 11:45" />Jediyayel mmon no nlum no Simri, mmonnayehn ewe no nlum bo jo lung-e re Joha nnea Tiji, <verse eid="1CH 11:45" /><verse number="46" style="v" sid="1CH 11:46" />Eliyel nnea Mahavi, Jeribaya abola Josaviya abon ba nlum ba Elnam, Itima nnea Moab, <verse eid="1CH 11:46" /><verse number="47" style="v" sid="1CH 11:47" />Eliyel Obed a Jasiyel anebe Mejoba.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s">Atakuru Nya Song Budu A Ellong Ni Devid</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />Aneblum ba a, ba ba goji Devid go ejahbe Jiklag, ngare nyi á daade no go esamahr bi Sol mmon no nlum no Kisi bo woomo go ellong atakuru nya jo tob-e nok ebta, <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />bo jolo ane ba jo fili mban, bo jo male mban atake afii jo saade egbasad atal, jolo eboblum afii ebobkal; bo jolo ane ba lohng ebangenahb ji Sol go et'tohngo ji Benjamin. A wo li abing ebo: <verse eid="1CH 12:2" /><verse number="3" style="v" sid="1CH 12:3" />Ahieje ji jolo ntubesi abo no nnen abola Joasi bo abon ba nlum ba Semaa nnea Gibea; Jejiyel a Peleti bo abon ba nlum ba Ajimaved; Beraka, Jehu nnea Anato, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />a Isimaya nnea Gibeon, etahntahn ntakuru go ellong eltahl ane awubu '30,' ye wo jolo ntubesi go eltahl ane awubu '30' bao; Jeremaya, Jahajiyel, Johanan, Jojabad nnea Gedera, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />Elujayi, Jerimod, Bealiya, Semariya a Sefatia nnea Haruf, <verse eid="1CH 12:5" /><verse number="6" style="v" sid="1CH 12:6" />Elkana, Isiya, Ajarel, Joejer a Jasobeyam nnea Kora, <verse eid="1CH 12:6" /><verse number="7" style="v" sid="1CH 12:7" />a Joela, Jebadiya abon ba nlum ba Jeroham ye ji lohng go Gedor. <verse eid="1CH 12:7" /><verse number="8" style="v" sid="1CH 12:8" />Egom anebe Gad yabe song kpiri Devid go ege eko ebta go elka emahng. Bo jolo atakuru nya bele esahb, bob toobo ebjing ebta anoko, fvfo bo jolo ane ba bahke ma fili ekum a elkong. Asamahr ebo jolo ana asamahr agabe, bo jo ware are ebul emahng go awong nya. <verse eid="1CH 12:8" /><verse number="9" style="v" sid="1CH 12:9" />Ejer wo jolo ntubesi, Obadiya jol etoono ntubesi, Eliab jol etoono ane ara, <verse eid="1CH 12:9" /><verse number="10" style="v" sid="1CH 12:10" />Misimana jol etoono ane ani, Jeremaya jol etoono ane alon, <verse eid="1CH 12:10" /><verse number="11" style="v" sid="1CH 12:11" />Atayi jol etoono ane arakera, Eliyel jol etoono ane asehma, <verse eid="1CH 12:11" /><verse number="12" style="v" sid="1CH 12:12" />Johanan jol etoono ane anehkeni, Eljabad jol etoono ane asehmwubu, <verse eid="1CH 12:12" /><verse number="13" style="v" sid="1CH 12:13" />Jeremaya jol etoono ane awubu, fvfo Makbanayi jol etoono ewubu a nne awohng. <verse eid="1CH 12:13" /><verse number="14" style="v" sid="1CH 12:14" />Anebe Gad baa jolo atubesi nsoja, no sahb s'se jo fili ane atahlalon alon '100,' bo ji kp'gbale jo fili ane atahltahl nkpel ebal atahlawubu '1,000.' <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />Bo ba jolo ane ba siiri aya Jodan ngare nyi ma yel kuumu agbunggbung go ngbokambang a nnyahng, bo kame ane kpee ba lene edamme, tv go ero nfam a erede nfam. <verse eid="1CH 12:15" /><verse number="16" style="v" sid="1CH 12:16" />Ane bako ba lohng et'tohngo ji Benjamin a egom ane ba lohng Juda, bo fvfo tob ba goji Devid go ege eko ebta. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />Devid kehm lohngo song kpiri bo, kehm tongo bo re, &lt;&lt;L'jol re wahn ebba go elkoono re wahn ba tob-m, bahk-m koro re wahn jol aname. Wo l'fere jol re ḿ ba re wahn ba gung-m ka anebekv ebame eji abo enyame ki wob go atongtong, nong Esowo bi babnsoo ewahre nyehn jia fere lam-n.&gt;&gt; <verse eid="1CH 12:17" /><verse number="18" style="v" sid="1CH 12:18" />Owo Etohko ji Esowo kehm bake a Amasayi ye ji jolo ntubesi ka eltahl ane awubu bao, á bungu re, &lt;&lt;Wahr ane eba ba, Devid, wahr li ka wo mmon no nlum no Jese, elkoono ee, nong elkoono jol a na, fvfo nong elkoono jol a ane ba kpa-a tobo, tib Esowo eba bahk-a tobo.&gt;&gt; Owo Devid kehm koko bo fere lim bo, bo jol atubesi ba nlong nsoja enye. <verse eid="1CH 12:18" /><verse number="19" style="v" sid="1CH 12:19" />Egom et'tohngo ji Manase yabe lohng ba tob Devid eji á tahme no a anebe Filista re á song nok a Sol. (Ye a aneblum ebe bo kpeem tob anebe Filista, tib eji, anebe Filista toobo no, bo k'kam Devid yehke ebo ellong. Bo bungu re, &lt;&lt;Bahke koko asi enyahre, Devid l'feere song tob Sol nde nju ewe.&gt;&gt;) <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />Eji Devid tahme go Jiklag aneblum baa a, ba et'tohngo ji Manase, ba yabe no song kpir-e, Adna, Jojabad, Jedayel, Mikayel, Jojabad, Elihu a Jiletayi, bo jolo ane ba jo fili nlong nsoja atahltahl nkpel ebal atahlawubu '1,000' go et'tohngo ji Manase. <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />Bo ba jo tob Devid jo nok a nlong nsoja nyi anebekv, tib bo ane kpee jolo atakuru nya bele esahb, bo ba jolo atubesi ege ellong nsoja. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />Efung abehng abehng aneblum jo lohngo ba tob Devid, tete á bel egburu ellong nsoja ana nsoja nyi Esowo.<verse eid="1CH 12:22" /></para>
  <para style="s">Ane Bako Kpe Ba Kpiri Devid Go Hebron</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />A wo li nfange aneblum ba toobo ebjing ebta, ba je goji Devid go Hebron re, bo song faake etul bi Sol ka-e, ana Jehova bungu no, <verse eid="1CH 12:23" /><verse number="24" style="v" sid="1CH 12:24" />go et'tohngo ji Juda, ane ba jo fili ekum, elkong yiimi ebta anoko jolo ane atahltahl nkpel ebal atahlawubu go nkpel erakera budu anea atahltahl nkpel ebal '6,800,' <verse eid="1CH 12:24" /><verse number="25" style="v" sid="1CH 12:25" />go et'tohngo ji Simeon, atakuru nya toobo ebjing ebta bo jolo ane atahltahl nkpel ebal atahlawubu go nkpel esema ane atahlalon '7,100,' <verse eid="1CH 12:25" /><verse number="26" style="v" sid="1CH 12:26" />goji et'tohngo ji Levi, jolo ane atahltahl nkpel ebal atahlawubu go nkpel eni budu atahltahal atahlawubu '4,600,' <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />budu Jehoyada, ntubesi no ebangenahb ji Eron, jolo aneblum atahltahl nkpel ebal atahlawubu go nkpel era budu atahaltahl atahlku '3,700,' <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />fvfo Jadok njangkun a ntakuru nyi bele esahb, budu eltahl atubesi eltum abal '22' bo lohng ege ebangenahb, <verse eid="1CH 12:28" /><verse number="29" style="v" sid="1CH 12:29" />et'tohngo ji Benjamin, ebangenahb ji Sol, jolo ane atahltahl nkpel ebal atahlawubu go nkpel era '3,000,' ane gbalee tiki sa woomo elwo etahk Sol tete ngare nyia, <verse eid="1CH 12:29" /><verse number="30" style="v" sid="1CH 12:30" />go ebangenahb ji Efraim atakuru nya bele esahb, ba elgahm ebo lohngo ebo ejang ajahbe, bo jolo ane atahltahl nkpel ebal atahlawubu go nkpel eltahl budu atahltahl nkpel ebal, '20,800,' <verse eid="1CH 12:30" /><verse number="31" style="v" sid="1CH 12:31" />go ejang et'tohngo ji Manase bo ji abing ebo lohngo no, bo ji ba re bo ba bob Devid etul bo jolo atahltahl nkpel ebal atahlawubu go nkpek atahl elkura '18,000,' <verse eid="1CH 12:31" /><verse number="32" style="v" sid="1CH 12:32" />go et'tohngo Isaka ane ba jo kahn ngare, fere kahn ji fuumu re Isreel lim, atubesi jolo ane atahl awubu '200,' a abonanyehn ebo kpee ba woomo go ebo elwo, <verse eid="1CH 12:32" /><verse number="33" style="v" sid="1CH 12:33" />go et'tohngo ji Jebulun, nsoja nyi jo kahn afem, toobo ebjing ebta a ejoobo ejum ebta ajehng ajehng re bo tob Devid, bo k'yab bo jol nti nti anyehng, bo jolo atahl alon alon nkpel atahltahhl atahl alon '50,000,' <verse eid="1CH 12:33" /><verse number="34" style="v" sid="1CH 12:34" />go et'tohngo ji Naftali, atubesi nta jolo ane atahl alon alon nkpel ewubu '1,000,' budu aneblum ba kpo fili akum a nkong bo jolo atahl alon alon nkpel atahlku, nkpel atahl ara a nkpel ewubu '37,000,' <verse eid="1CH 12:34" /><verse number="35" style="v" sid="1CH 12:35" />go et'tohngo ji Dan, bo ji toobo ebjing ebta, bo jolo atahl alon alon nkpel atahl awubu, a nkpel atahl ani a nkpel erakera '28,600,' <verse eid="1CH 12:35" /><verse number="36" style="v" sid="1CH 12:36" />go et'tohngo ji Aser, nsoja nyi jo kahn afem, toobo ebjing ebta, bo jolo atahltahl nkpel ebal atahlawubu go nkpel atahlabal '40,000,' <verse eid="1CH 12:36" /><verse number="37" style="v" sid="1CH 12:37" />go ero aya ma Jodan, go et'tohngo ji Ruben, Gad a ejang et'tohngo ji Manase, ane ba fili ejoobo ejum ebta ajehng ajehng, bo jolo ane atahltahl nkpel ebal atahlawubu go nkpel atahla arkera '120,000,' <verse eid="1CH 12:37" /><verse number="38" style="v" sid="1CH 12:38" />Bo jia kpee aba noko nta ba, bo ji koro bofono antahng re, bo loko ngbahka ngbahk. Bo ba je go Hebron bo bele ntir ntir anyehng re, bo ba bob Devid etul ka Isreel kpee. Erik anebe Isreel bako kpee tob bele ntir ntir anyehng re, bo bob Devid etul. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />Aneblum bao kange o a Devid nfung era, jo li fere jo w'wo, tib abangenahb ebo toobo nsol ka bo. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />Aneb ebjing ebo fvfo bo ji li fee go at'tohngo nya Isaka, Jebulun, a Naftali bo solo nsol alehke go ebvankang, akamel, ebvankang bi kahbe akpade a alum efong. Nsol jolo gbalee, ana abe, abane bane ngbu afik, abane bane ngbu agreb, amahm, akehng oliv, adamagbudu, a ejoro tib eyebatahng jolo gbalee go Isreel.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s">Bo Ko Elkohl Atahm Feere A Ni</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />Devid toobo a ntubesi ewe awohng awohng, atubesi nsoja ba jo fili ane atahl alon alon nkpel ewubu, a ba jo fili ane atahl alon alon. <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />Á tongo Isreel kpee ji ba kono o re, &lt;&lt;L'jol re n'nob ano kaan, fvfo l'fere jol re ntir nyi Jehova Esowo ebahre nyi, nong wahr tumen ellum tv ane ba li fee sahb f'fe, erik ane ebahre kpee go arohko ajahbe Isreel, fvfo tob tum tv abalimajom a anebe Levi bo ji li a bo, go ebo ajahbe a adi nya bo kpo le atohko ndi, re bo ba semme anahre. <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />Wahr song koon elkohl atahm Esowo ebahre feere ani ba ka-r, tib e kpeem tiki jo bahb bade a ni, ngare efilane ji Sol.&gt;&gt; <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />Bo kpee ba kono o tˈtaame re bo lim ano, tibre ane kpee ny'nyehn re n'nob ka bo kpee. <verse eid="1CH 13:4" /><verse number="5" style="v" sid="1CH 13:5" />Devid kehm kuku Isreel kpee, bomo go ero aya ma Sihor go Ijib rehng go Lebo Hamati re, bo rod elkohl atahm ni Esowo go Kiriati Jearim ba a ni. <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />Devid a Isreel kpee tahme go Baala ji Juda [Kiriati Jearim] re bo song ko elkohl atahm Esowo Jehova, ye ji jehk etul go elka elka ni serubim, elkohl ni bo kpo lung kpiida mbing enye. <verse eid="1CH 13:6" /><verse number="7" style="v" sid="1CH 13:7" />Bo yehke elkohl atahm Esowo go etahk Abinadab, mmvtv akpakenti nyi nfenfe nyi solo, Uja abola Ahio bo ba jo baabe mbang mbang. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />Devid a anebe Isreel kpee jo geere a eko eko ebo kpee ka Esowo, go ase a abuk, agehmegehme, atalehk, asoongo a atang. <verse eid="1CH 13:8" /><verse number="9" style="v" sid="1CH 13:9" />Eji bo rehnge go edi arasi aruumu ji Kidon, Uja tanne ebo re á tuungu elkohl atahm nio kunu, tib efong s'sel. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />Jehova atahng rak-e tob Uja á rum-e tub, tib yeb lak abo go elkohl atahm nio. Owo á kpo no go esamahr bi Esowo. <verse eid="1CH 13:10" /><verse number="11" style="v" sid="1CH 13:11" />Owo Devid atahng kehm-e rake tib eji erakatahng ji Jehova ma gbo tub Uja, tete tub lela edi jio bo kpo lung re, Pereji Uja. <verse eid="1CH 13:11" /><verse number="12" style="v" sid="1CH 13:12" />Devid fahle Esowo efung bio kehm bahbe re, &lt;&lt;N kehm limi renan ko elkohl atahm Esowo ba bum elname?&gt;&gt; <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />Á kpeem ko elkohl atahm nio re song jol a ne go elsi ni Devid. Á fere ko song bum etahk Obed-Edom nnea Gati. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />Elkohl atahm Esowo sa o ebangenahb ji Obed-Edom ege etahk go nnyahng era, fvfo Jehova fuulu nlatahk enye kpee a ejum ajehng ajehng ji á bele no.<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s">Nlaaga Nyi Devid A Ebangenahb Eje</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />Ngare nyia Hiram ntula Taya tumu atiingi etib tv Devid, budu akv nti aseda, abasoongo atal a abakonajangenti re bo song si ekpasiki ka-e. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />Devid k'kahn re Jehova me-e lim yeb gbal ana ntul ka Isreel, fvfo etul ebe yeb sahb m'mehl wahre tib esi ane ebe Isreel. <verse eid="1CH 14:2" /><verse number="3" style="v" sid="1CH 14:3" />Go Jeruselem Devid kpe ko akal budu, fvfo á jolo nde no abon ba nlum gbalee a ba nkal. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />A wo li abing abon ba bo jele ka-e o, Samua, Sobab, Natan, Solomon, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />Ibhar, Elisua, Elpeled, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />Noga, Nefeg, Jafiya <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />Elisama, Beliyada a Elifeled.<verse eid="1CH 14:7" /></para>
  <para style="s">David Ga Anebe Filista</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />Eji anebe Filiata wuku re Devid bo me-e kak akehng go esi re á jol ntul ka Isreel kpee, bo kehm mehle eko eko re bo song seb-e, wo Devid wˈwuk bade ano, á kehm lohngo re á song kpiri bo. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />Ngare nyio anebe Filista eblohng ba bohko ebta fere da nsol go edamme ji Refayim; <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />owo Devid kehm bahbe Esowo re; &lt;&lt;Me n song, song nok a anebe Filstaa? Á bahke yake bo kak-m egama aboa?&gt;&gt;</para>
  <para style="p" vid="1CH 14:10">Jehova faang-e re, &lt;&lt;Song, m bahke yake bo kak-a ega abo.&gt;&gt; <verse eid="1CH 14:10" /><verse number="11" style="v" sid="1CH 14:11" />Owo Devid a ane ebe bo kehm tahme go Baal Perajim, ona wo á noko ga bo. Á bungu re, &lt;&lt;Ana nyel kpo ya lohng, Esowo ebya wohngo anebekv ebame egame ebo.&gt;&gt; Owo wahnge bo jo lung edi jio re Baal Perajim. <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />Anebe Filista ebbe asowo ebo sa o, fvfo Devid ka eko re bo jamme fi go agun. <verse eid="1CH 14:12" /><verse number="13" style="v" sid="1CH 14:13" />Anebe Filista kpe tahm song bohko ebta go edamme; <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />owo Devid kehm kpe bahb Esowo, fvfo Esowo faang-e re, &lt;&lt;Ka nok a bo songo songo, sennge na bo kak wo bom elnoko a bo go mbuksonga nti nyi bo kpo lung re balsam. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />A l'si w'wuk ewahl eljen go elkong nti balsam, mehlen song ebta, tib jio bahke lohngo re Esowo eblohng gbo-n mbang re á song nok a nsoja nyi anebe Filista.&gt;&gt; <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />Ano wo Devid limi ana Esowo ka-e elkahn, fvfo bo wulu nsoja nyi anebe Filista, mbang mbang nyi bomo go Gibion tete rehng Gejer. <verse eid="1CH 14:16" /><verse number="17" style="v" sid="1CH 14:17" />Owo elgahm ni Devid kehm yeere rehng adi kpee, fvfo Jehova limi re ajahbe kpee jo fahl-e.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s">Bo Ko Elkohl Atahm Ba Go Jerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />Eji Devid ma si ntahk ka elne go ejahbe ji Devid, á toobo edi ji elkohl atahm Esowo, fere si ebkpatahk bum re jol ka elkohl atahm nio. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />Owo Devid kehm bungu re, &lt;&lt;Nnene sang bahke solo, sehngem anebe Levi ba bahke solo elkohl atahm Esowo, tibre bo ba Jehova ma yehke re bo jo sol elkohl atahm Jehova, fere jo lok-e ano ano.&gt;&gt; <verse eid="1CH 15:2" /><verse number="3" style="v" sid="1CH 15:3" />Devid kehm kuku Isreel kpee bo ba kono Jerusalem re bo song ko elkohl atahm Jehova ba a ni edi ji á ma toobo bum re jol. <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" />Á kehm lungu at'tohngo nya Eron a anebe Levi ba kono edi ajehng; <verse eid="1CH 15:4" /><verse number="5" style="v" sid="1CH 15:5" />Go at'tohngo nya Kohati, Uriyel wo jolo ntubesi a ebangenahb eje, bo ane atahl alon kunu ane eltahl; '120.' <verse eid="1CH 15:5" /><verse number="6" style="v" sid="1CH 15:6" />go at'tohngo nya Merari, Asayel wo jolo ntubesi, a ebangenahb eje, bo ane atahl alon alon nkpel ebal kunu ane eltahl '220,' <verse eid="1CH 15:6" /><verse number="7" style="v" sid="1CH 15:7" />go at'tohngo nya Gerson, Joel wo jolo ntubesi, a ebangenahb eje, bo ane atahl alon kunu eltahl ane awubu '130,' <verse eid="1CH 15:7" /><verse number="8" style="v" sid="1CH 15:8" />go at'tohngo nya Elijafan, Semayel wo jolo ntubesi, a ebangenahb eje, bo jolo ane atahla wubu '200,' <verse eid="1CH 15:8" /><verse number="9" style="v" sid="1CH 15:9" />go at'tohngo nya Hebron, Eliyel wo jolo ntubesi, a ebangenahb eje, bo jolo ane atahlani '80,' <verse eid="1CH 15:9" /><verse number="10" style="v" sid="1CH 15:10" />go at'tohngo nya Ujiyel, Aminadab wo jolo ntubesi, a ebangenahb eje, bo jolo ane atahl alon kunu ewubu ane abal '112.' <verse eid="1CH 15:10" /><verse number="11" style="v" sid="1CH 15:11" />Owo Devid kehm lungu Jadok a Abiata ji nlimanjom, a Uriyel, Asaya, Joel, Semaya, Eliyel, a Aminadab bo anebe Levi. <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />Á tongo bo re, &lt;&lt;Wahn ba li atubesi go ebangennahb ji anebe Levi, wahn a anebe Levi ebahne bako, bum-n elnahne saang, wahn song ko elkohl atahm Jehova, Esowo bi Isreel, ba a ni edi ji m ma toobo bum. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />Eji li re wahn anebe Levi sang song ko go ngbokambang, wahnge Jehova Esowo ebahre bele erakatahng bade anahre. E we-e bahbem ana e bahke limi go mbang nyi fuumu no.&gt;&gt; <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />Owo abalimajom a anebe Levi kehm bumu elbo saang eji bo lˈsong ko elkohl atahm Jehova, Esowo bi Isreel. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />Anebe Levi ko alaabe nti sol elkohl atahm Esowo nio ebo akpakebahk, ana Mosisi ka bo elkahn toono go ellum ni Jehova. <verse eid="1CH 15:15" /><verse number="16" style="v" sid="1CH 15:16" />Devid tongo atubesi ba anebe Levi re, bo yehke abayimase ebo ellong, bo jo yim wahl go eyebatahng, jo kub nsol nyia, abuk, atalehk a asoongo. <verse eid="1CH 15:16" /><verse number="17" style="v" sid="1CH 15:17" />Ano wo anebe Levi yehke Heman mmon no nlum no Joel; Asafi mmon no nlum no Berekaya; fvfo Etan mmon no nlum no Kusayiya go ebangenahb ji Mer, <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />fvfo abonanyehn ebo ba toono bo jolo, Jekaria, Jajiyel, Semiramoti, Jehiyel, Unni, Eliab Benaya, Maaseya, Matitiya, Elifelehu, Mikneya, Obed Edom a Jeyiyel bo ji jo baabe nti mbuga. <verse eid="1CH 15:18" /><verse number="19" style="v" sid="1CH 15:19" />Abakubase, Heman, Asafi a Etan, bo ba jolo re, bo jo kub bron ji bo ko ebilikpi lim. <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />Jekaria, Jajiyel, Semiramoti, Jehiyel, Unni, Eliab, Maseya a Benaya bo jo kubu abuk toono ana alamoti li no. <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />Mattitaya, Elifelehu, Miknaya, Obed-Edom, Jeyiyel a Ajajiya bo jo kub abuk toono ana atake nya nlum a nya nkal nya Seminiti li no. <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />Kenaniya ji jolo ntubesi anebe Levi, ye wo jolo ka elyimi, jio ji jolo ebo eltum ebe tibre á kahne ana á jo mal lim nobnob. <verse eid="1CH 15:22" /><verse number="23" style="v" sid="1CH 15:23" />Berekiya abola Elkana li ka bo re, bo jo baabe abutahk nya elkohl atahm. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />Sebaniya, Jasofati, Netanel, Amasayi, Jekaria, Benaya a Elieje, bo alimajom li ka bo re, bo wor atang gbo elkohl atahm Esowo mbang. Obed Edom abola Jehiya ji bo tob li re, bo jo baabe abutahk elkohl atahm. <verse eid="1CH 15:24" /><verse number="25" style="v" sid="1CH 15:25" />Owo Devid a anebkul Isreel a atubesi nsoja ba jo fili nlong nsoja atahl alon alon nkpel ewubu tahme no re bo song ko elkohl ni nwongo nyi Jehova go etahk Obed Edom go eyebatahng. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />Tibre Esowo ebtob anebe Levi bo ji jo sol elkohl ni nwongo nyi Jehova, alum efong na esehma a ekom na esehma bi bo ko lim njom. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />Devid liibi mbomo mi bo jahme ekpawobo ji nno, ano ano wo anebe Levi kpee ba solo elkohl atahm, a abakubase go Kenaniya ye ji jolo ntubesi abayimi ase tob liibi. Devid tob kake monkpehrekahbe ewobo no alimajom no bo ko aleenge leenge abomo jahm. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />Ano wo Isreel kpee ko elkohl ni nwongo nyi Jehova a elrabe elrabe go ewahl atang ekom a atang atang a ewahl asoongo, go elkubu ni bo jo kub atalehk a abuk. <verse eid="1CH 15:28" /><verse number="29" style="v" sid="1CH 15:29" />Ana elkohl ni nwongo nyi Jehova jo yel ejahbe ji Devid, Mikal mmon no nkal no Sol jo fahnge go monbua nkpe ekahme. Eji á nyehne Ntula Devid kp'bahne fere jo yebbe, á kehm-e daange ege eltim.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="s">Elloko Go Esamahr Elkohl</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />Bo kehm koko elkohl atahm Esowo ba yel a ni ebkpatahk bi Devid ma si ka, fvfo bo limi njom ayare eljahme fi a njom ayare nya elkoono ka Jehova. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />Ngare nyi Devid ma lim njom ayare nya eljahme fi mal, a nya elkoono, á fuulu ane go mbing nyi Jehova. <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />Owo á kehm kake nnenlum a nnenkala Isreel awohng awohng ebred ajehng ajehng, ngbu njua nsakoro, ngbu agreb, a ngbu nyi bo bane go nkpingi. <verse eid="1CH 16:3" /><verse number="4" style="v" sid="1CH 16:4" />Á tob yehke egom anebe Levi re bo jo lim eltum go elkohl atahm Jehova, bo jo lim eltum ni ellungu mbinga Jehova, saam akake a eltehke Jehova, Esowo bi Isreel. <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />Asaf wo jolo ntubesi, Jekaria wo toon-e, Jaajiel, Semiramoti, Jehiyel, Matitiya, Eliab, Benaniya, Obed Edom, a Jeyel. Bo ba li re, bo jo kub abuk a agehmegehme, Asaf jo kak esoongo, <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />fvfo Benaya a Jahajiel bo ji li alimajom bo jo wor atang asoro asoro go esamahr elkohl nwongo nyi Esowo. <verse eid="1CH 16:6" /><verse number="7" style="v" sid="1CH 16:7" />Efung bio Devid gbo mbang yehke Asaf a ellong ene re bo jo tehk Jehova go mbang ana nyia: <verse eid="1CH 16:7" /><verse number="8" style="v" sid="1CH 16:8" />Ka Jehova eltehke, tiingi mbing enye; lim ka ajahbe bo kahn ji á ma lim. <verse eid="1CH 16:8" /><verse number="9" style="v" sid="1CH 16:9" />Yim ka-e, yim tehk-e; tooro kpee bade akpokosi ntum enye. <verse eid="1CH 16:9" /><verse number="10" style="v" sid="1CH 16:10" />Ka ellub egea mbarebara mbing; nong ntim nyi ane ba kp-e sebe bel eyebatahng. <verse eid="1CH 16:10" /><verse number="11" style="v" sid="1CH 16:11" />Seb Jehova a atahne enye; jo seb esamahr ebe ngare kpekpe. <verse eid="1CH 16:11" /><verse number="12" style="v" sid="1CH 16:12" />Buumu agan nsol nya á ma lim, akpokosi enye, fvfo elam eje ji á ma tiingi, <verse eid="1CH 16:12" /><verse number="13" style="v" sid="1CH 16:13" />wahn alokeltum ebe, et'tohngo ji Isreel, wahn ji á yehken no, abon ba Jekob. <verse eid="1CH 16:13" /><verse number="14" style="v" sid="1CH 16:14" />Ye wo li Jehova Esowo ebahre; elam eje li go njini kpee. <verse eid="1CH 16:14" /><verse number="15" style="v" sid="1CH 16:15" />Á kp'buumu nwongo enye go njinanjini, enyam bi á yame no, li ka aying atahlankuaku, <verse eid="1CH 16:15" /><verse number="16" style="v" sid="1CH 16:16" />nwongo nyi á ko a Ebraham, enyam bi á ayame tong Isak. <verse eid="1CH 16:16" /><verse number="17" style="v" sid="1CH 16:17" />Á limi yiimi ka Jekob ana ntahm, ka anebe Isreel ana nwongo nyi li go njinanjini. <verse eid="1CH 16:17" /><verse number="18" style="v" sid="1CH 16:18" />&lt;&lt;Wo wo m bahk-a kake ndi nyi Kenan ana erohko edi ji a bahke lehke elkv.&gt;&gt; <verse eid="1CH 16:18" /><verse number="19" style="v" sid="1CH 16:19" />Eji bo jolo amohk ane abika bik, sahb sˈse, fvfo bo jolo ajenne o, <verse eid="1CH 16:19" /><verse number="20" style="v" sid="1CH 16:20" />bo jo beeme yannge ejahbe ejahbe, bomo ejahbe etul ajehng rehng ajehko. <verse eid="1CH 16:20" /><verse number="21" style="v" sid="1CH 16:21" />Á tikem taame re nne nohk bo; tib ebo esi á nyame atul. <verse eid="1CH 16:21" /><verse number="22" style="v" sid="1CH 16:22" />&lt;&lt;Kana kooro ane ebame ba m ma kak bo akehng go esi; kana lim anyehnamahr ebame ejum.&gt;&gt; <verse eid="1CH 16:22" /><verse number="23" style="v" sid="1CH 16:23" />Yimen ka Jehova, wahn njini kpee; tiingi bade eltahre ene efung efung. <verse eid="1CH 16:23" /><verse number="24" style="v" sid="1CH 16:24" />Lennge bade ellub ene go ellong ajahbe, agan ellimi ene go ellong ane kpee. <verse eid="1CH 16:24" /><verse number="25" style="v" sid="1CH 16:25" />Jehova kp'gbale sehng sahb fˈfuumu go eltehke; ye wo fuumu re bo fahl-e sehnge asowo nyako kpee. <verse eid="1CH 16:25" /><verse number="26" style="v" sid="1CH 16:26" />Tibre asowo nyako kpee nya ajahbe alokelom nya, wo Jehova wo limi elbung. <verse eid="1CH 16:26" /><verse number="27" style="v" sid="1CH 16:27" />Ekpunu a elub li go ega; atahne a eyebatahng li ege edi ellene. <verse eid="1CH 16:27" /><verse number="28" style="v" sid="1CH 16:28" />Tehken Jehova, wahn abangenahb kpee nya njini, kaan Jehova ellub a atahne. <verse eid="1CH 16:28" /><verse number="29" style="v" sid="1CH 16:29" />Kaan Jehova ellub ni fuumu a mbing enye; ko ayare ba anya ege esamahr. Fvfo baan go ege elbohngo. Kaken Jehova ege ekpunu ji li saang. <verse eid="1CH 16:29" /><verse number="30" style="v" sid="1CH 16:30" />Nong njini kpee jo kahm akahb ka-e! Njini nyia tiki yim t'tahne; nnene nehm ma yuudu. <verse eid="1CH 16:30" /><verse number="31" style="v" sid="1CH 16:31" />Nong elbung bel eyebatahng, nong ndi bel elgeere; nong bo bung go ellong ajahbe re, &lt;&lt;Jehova wo kpˈfili edi!&gt;&gt; <verse eid="1CH 16:31" /><verse number="32" style="v" sid="1CH 16:32" />Nong agburu alahb kpee sahb w'wahl, a nsol kpee nyi wob o; nong adi ebgbe bel elgeere a ejum ajehng ajehng ji li o! <verse eid="1CH 16:32" /><verse number="33" style="v" sid="1CH 16:33" />Nong nti ekulegbe jo yim, nong bo jo yim go eyebatahng ka Jehova, tib á kp'bake ba lam njini. <verse eid="1CH 16:33" /><verse number="34" style="v" sid="1CH 16:34" />Kaken Jehova saam, tib á kp'nobo; elkoro ene li ano ano go njinanjini. <verse eid="1CH 16:34" /><verse number="35" style="v" sid="1CH 16:35" />Bung tong-e re, &lt;&lt;Tahr-r, Esowo nt'tahre ewahre, kpuu-r bum edi ajehng, wo yehk-r yake go ajahbe nyako, eji e l'kak mbarebara mbing enya saam, fere ka ellub ega eltehke.&gt;&gt; <verse eid="1CH 16:35" /><verse number="36" style="v" sid="1CH 16:36" />Eltehke jol ka Jehova, Esowo bi Isreel, bomo go njinanjini song rehng go njinanjini. Owo ane kpee kehm bungu re, &lt;&lt;Jol ano&gt;&gt; fvfo tob bung re&lt;&lt;Tehken Jehova.&gt;&gt; <verse eid="1CH 16:36" /><verse number="37" style="v" sid="1CH 16:37" />Devid tahme Asafi a ane ebe ba jolo a ne sa o esamahr elkohl ni nwongo nyi Jehova re bo jo lim eltum o ngare kpe kpe, ana eltum bahke jo jol efung efung. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />Á tob tahme Obed Edom a ane atahlara ane anehkeni '68' ebe sa re bo jo lim eltum a bo. Obed Edom mmon no nlum no Jedutun, abola Hosa bo jolo ane ba jo baabe abuga <verse eid="1CH 16:38" /><verse number="39" style="v" sid="1CH 16:39" />Devid tahme Jadok ji nlimanjom sa a atoono abalimajom ebe go ebkpatahk bi Jehova go edi elkake go Gibea, <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />re bo jo lim njom nyio nyi eljahme fi ka Jehova go egudu njom jio ji eljahme fi ngare kpe kpe, efungfu a elgung, toono ana bo nyono ejum ajehng ajehng go atahm nya Jehova, nya á ma ka Isreel. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />Bo ji kpe jol budu, jolo, Heman a Jedutun go erik ji bo yehke bo fere gamme bo abing re bo jo kak Jehova saam, &lt;&lt;tibre elkoro ene li go njinanjini.&gt;&gt; <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />Heman abola Jedutun ebo eltum ebo li re bo jo wor atang fere jo kak asoongo, fvfo fere jo kub nsol elkubu go ese ji li saang. Abon ba nlum ba Jedutun tiki jo yiimi mbuga. <verse eid="1CH 16:42" /><verse number="43" style="v" sid="1CH 16:43" />Owo ane kpee kehm yaame kehnge eboa ntahk, fvfo Devid tob feere kehnge re a song fuulu ebangenahb eje.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s">Enyam Bi Esowo Nyame Tong Devid</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />Ngare nyi Devid ma ji ege ekpasiki, á tongo Natan nnyehnamahr re, &lt;&lt;Anv me n lene etahk ji bo ko aseda si, gana elkohl ni nwongo nyi Jehova wob ebkpatahk.&gt;&gt; <verse eid="1CH 17:1" /><verse number="2" style="v" sid="1CH 17:2" />Natan faange Devid re, &lt;&lt;Ajehng ajehng ji wob-a eltim lim ano tibre Esowo li a na.&gt;&gt; <verse eid="1CH 17:2" /><verse number="3" style="v" sid="1CH 17:3" />Wo atv mao ellum ni Esowo kehm bake goji Natan rea; <verse eid="1CH 17:3" /><verse number="4" style="v" sid="1CH 17:4" />&lt;&lt;Song, wo song tong Devid nlokeltum ewame re, &lt;Ejum ji a ji Jehova kpˈbungu re: Wo sang bahke sehke etahk ji me n bahke lene. <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />Me n ka l'lene go etahk, bomo efung bi n yehke Isreel go Ijib tete tub lela. Me kpo jen go ebkpatahk abehng rehng nkpe ebkpatahk behko, n kpo jol edi ellene jehko fere jol ajehka. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />Eji n kpo jen a anebe Isreel kpee, me n bˈbung tong atubesi eboa, bo ji n kaa bo elkahn re, bo jo baabe ane ebame, &lt;Jenji wahnge n kala si etahk aseda kaam?&gt; &gt;&gt; <verse eid="1CH 17:6" /><verse number="7" style="v" sid="1CH 17:7" />Anv fvfo tong Devid nlokeltum ewame re, &lt;&lt;Ejum ji a ji Jehova Ji Kp'fili Elbung a Ndi kp'bungu re, N yehk-a go emahng, edi ji a jo baabe atohkondi, fere yak-a ka re, wo jol ntubesi ka ane ebame Isreel. <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />Me n jol a na edi ajehng ajehng ji a je no, fvfo me n yehke anebekv eba kpee ega elbohngo. Anv m bahke limi mbing enya jol ana abing nya agburu ane ba njini. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />M bahke toobo edi bum Isreel ane ebame, m bahke jehke bo, eji bo l'bel ejahbe ji bofono, eji bo l'k'jo gbiingi bo. Aneb eblum nehm kpe jo kak bo erem ekake kake, ana bo jo lim bo go ngbokambang, <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />ana bo bomo ellimi wuku wuku ngare nyi n yehke atubesi bum re, bo jo kpur Isreel ane ebame. M bahke rede anebekv eba kpee. &lt;&lt;Me n lennge tong-a re, Jehova bahke sehke etahk ka-a: <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />ngare nyi afung enya ma mal, a ma tahm eljolo a babnso, m bahke yehke mmon awohng ewa no nlum go ellong abon eba ba nlum no bahke woongo asi enya, mmon ewa no nlum antahng antahng, m bahke limi etul ebe gbal. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />Ye wo bahke sehke etahk kaam, fvfo m bahke limi eti etul eje yiimi tahne go njinanjini. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />M bahke jolo nde no ewe, ye bahke jolo mmon ewame, N nehm tiki yehke elkoro ename go ege, ana n yehke no goji nne no gbo mbang fili edi ka-a. <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />M bahk-e kunu re á jo kpur etahk ejame fvfo nji etul enyame bahke jolo go njinanjini; eti etul eje bahke gbale go njinanjini.&gt;&gt; <verse eid="1CH 17:14" /><verse number="15" style="v" sid="1CH 17:15" />Natan tooro kpee tong Devid, alum nya ellennge nia.<verse eid="1CH 17:15" /></para>
  <para style="s">Ero Bi Devid Kake no</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />Owo ntul a Devid kehm song ji esamahr bi Jehova, kehm bungu re, &lt;&lt;Me n li jen. Jehova Esowo, ebangenahb ejame tob li jen, ji wahnge a mam ka efa bia? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />Jol jia wa-a gbalem ega elbohngo, Esowo ebame, wob kpe bung bade es'song ebangenahb ji nlokeltum ewa. Wo Jehova Esowo, a ma-m nyehn are, nne no kp'sahb w'wahre go ellong ane o. <verse eid="1CH 17:17" /><verse number="18" style="v" sid="1CH 17:18" />Jenjii, me Devid bahke kpe bung tong-a eji a ma kpunu nlokeltum ewa ano? Tibre a kp'kahne nlokeltum ewa. <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />Jehova, tib esi ji nlokeltum ewa, fvfo ana li ntir enya, wob lim egburu ejum jia, fere lim ka re bo kahn agburu anyam kpee. <verse eid="1CH 17:19" /><verse number="20" style="v" sid="1CH 17:20" />Nnene lim no li ana wo, Jehova, fvfo Esowo bindiki go limm sehnge wo, ana wahr ma wuk egahre atung. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />Fvfo nne awoo li ana Isreel ane eba, ejahbe na ajehng go njini ji Esowo ma fak ane ka elne, fvfo re á lim mbing ka elne, fere lim agburu amennge akpokosi, go mbang nyi a kame ajahbe yehke go esamahr ane eba, bo ji a fake bo yehke go Ijib? <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />A limi Isreel ane baba bo jol go njinanjini, fvfo wo, Jehova wob jol Esowo ebo. <verse eid="1CH 17:22" /><verse number="23" style="v" sid="1CH 17:23" />&lt;&lt;Anv Jehova, nong enyam bi a ma nyam bada nlokeltum ewa a ebangenahb eje jol ano go njinanjini. Lim ana a nyame no, <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />eji l'lohko gbal tahne, fvfo mbing enya bahke gbale wahre go njinanjini. Owo ane bahke bungu re, Jehova Ji Kp'fili Elbung a Ndi, Esowo bi li ka Isreel, ye Esowo bi Isreel bi. Fvfo ebangennahb ji Devid nlokeltum ewa bahke yiimi t'tahne ega elbohngo. <verse eid="1CH 17:24" /><verse number="25" style="v" sid="1CH 17:25" />&lt;&lt;Wo ji li Esowo ebame, wob lennge ka-m, me nlokeltum ewa re, wo bahke sehke etahk ka-m. Tib esi jia nlokeltum ewa ebbel ekakeltim re, á kak ero ka-a. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />Wo, Jehova, wo Esowo bi, wob nyam anoobo nsol nyaa tong nlokeltum ewa. <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />Anv ma-a yebe re wo fuulu ebangenahb ji nlokeltum ewa, eji l'jol jo soro asi go njinanjini ega esamahr, fvfo wo Jehova wob fuulu, eblohko bel elfuulu go njinanjini.&gt;&gt;<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s">Esehnge Ebta Bi Devid</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />Eji ma kang, ntula Devid bohko a anebe Filista ebta fere ga bo, fvfo á koo ejahbe Gati a abon ajahbe ba li sennge kak go abo nya anebe Filista ba jo fili bo. <verse eid="1CH 18:1" /><verse number="2" style="v" sid="1CH 18:2" />Fvfo Devid tob ga anebe Moab, bo fere woom-e go elwo jo ko ayare ba ka-e. <verse eid="1CH 18:2" /><verse number="3" style="v" sid="1CH 18:3" />Budu o fvfo, Devid tob ga Hadadeje ntul no Joba go Hamati, eji á tahme re á kpe song bel eko go aya ma Ufrati. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />Devid taare amvtv akuungu enye, atahltahl nkpel ebal atahlawubu '1,000,' abaf'fingi jolo atahltahl nkpel ebal atahlawubu go nkpel esema '7,000,' budu nsoja nyi jene akpade, bo jolo atahltahl nkpel ebal atahlawubu go nkpel eltahl '20,000.' Fvfo Devid banne any'nya akpade kpee nya jo fing amvtv akuungu fere bum eny'nya atahl alon '100' nya jo fing amvtv akuungu. <verse eid="1CH 18:4" /><verse number="5" style="v" sid="1CH 18:5" />Eji anebe Aram ba Damakusi ba re, bo ba tob Hadadeje ntul no Jabo, Devid wulu bo ane atahltahl nkpel ebal atahlawubu go nkpel eltahlebal '22,000.' <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />Á kake mbaabe go etul bi anebe Aram ba Damakusi, fvfo anebe Aram fere woom-e go elwo jo ko ntahbe ba ka-e. Jehova jo ka Devid esehnge ebta edi ajehng ajehng ji á jo je. <verse eid="1CH 18:6" /><verse number="7" style="v" sid="1CH 18:7" />Devid kpuu akum nya bo ko agul lim nya atubesi eltum ba Hadadeje, solo no ba, á ko feere ba bum Jeusalem. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />Bomo go ajahbe Teba a Kun ajahbe nya jolo ka Hadadeje, Devid tob kpuu abilekpi o gbalee, nya nya Solomon koo no lim egburu nkpaanga ngbojok nyi bo jo lung re, Aya abilekpi. Á tob ko lim ago a ajoobo akpeeke. <verse eid="1CH 18:8" /><verse number="9" style="v" sid="1CH 18:9" />Eji Tou ntul no Hamati wuku re Devid ebgaa nsoja kpee nyi Hadadejer ntul no Joba, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />á tumu mmon ewe no nlum Hadoram tv ntul a Devid re, á song kak-e nnyo fere tehk-e ege esehnge ebta go ebta bi á noko a Hadadeje ye ji jo nok a Tou. Hadoram koo ajoobo nsol agul a nya asilva go abilekpi ba ka Devid. <verse eid="1CH 18:10" /><verse number="11" style="v" sid="1CH 18:11" />Ntul a Devid yake ajoobo nsol nyaa kpee kak Jehova go ebo, ana á tohko lim agul a asilva kpee nya á daa ajahbe nyako, ana Edom a Moab Ammon, Filista go Amalek. <verse eid="1CH 18:11" /><verse number="12" style="v" sid="1CH 18:12" />Abisayi ji mmon no nlum no Jeruya wulu anebe Edom, atahltahl nkpel ebal atahlawubu go nkpel elkura '18,000' go edamme akang. <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />Á kake mbaabe go Edom, anebe Edom kpee fere woomo Devid elwo. Jehova jo ka Devid esehnge ebta edi ajehng ajehng ji á jo je.<verse eid="1CH 18:13" /></para>
  <para style="s">Atubesi Eltum Ba Devid</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />Devid fili Isreel kpee, jo lim ji jolo nseenga nseenge a ji jo tor kpee ka ane ebe. <verse eid="1CH 18:14" /><verse number="15" style="v" sid="1CH 18:15" />Joab mmon no nlum no Jeruyiya wo jolo ntubesi a nsoja, Jehosafati mmon no nlum no Ahilub wo jo nyon nsol kak go nwer, <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />Jadok mmon no nlum no Ahitub a Ahimelek mmon no nlum no Abiata bo ba jolo abalimajom, Savisa wo jolo nnyonawer. <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />Benaya mmon no nlum no Jehoyada wo jolo ntubesi ka anebe Kereti a Peleti fvfo abon Devid ba nlum ba jolo atubesi eltum go ejang bi ntul.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s">Devid Gaa Anebe Amon</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />Eji ma kang, Nahasi ntul no anebe Amon ba kpo, fvfo mmon ewe no nlum wo ko nji etul enye. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />Devid tiri re &lt;&lt;M bahke tibi Hanun mmon no nlum no Nahasi nnoobo eltim, tibre nde tib-m nnoobo eltim.&gt;&gt; Owo Devid kehm tumu akahmekahme ane tv-e re bo song bung kak-e eltim bada nde ewe. Eji akahmekahme ane ba Devid tumu no je goji Hanun go ndi nyi anebe Amon re bo song kak-e eltim, <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />atubesi nsoja anebe Amon tongo Hanun re, &lt;A kp'tiri re, Devid kp'kpunu na nso ewa oa, eji á tumu ane baa tv-a re bo ba kak-a eltima? Ka lohng re ane baa ba re bo ba feede fere weele nyehn ejahbe jia seb mbang nyi bo bahke ba rannga?&gt; <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />Owo Hanun kehm bobo ane bao ba Devid tumu no, kpud bo alahng, kiimi akpawobo ebo ekidi njahm fere tong bo re bo song. <verse eid="1CH 19:4" /><verse number="5" style="v" sid="1CH 19:5" />Eji nne ba tong Devid bade ane ebe, á tumu ntiingi etib re a song kpiri bo, tib bob sono bo sehng. Ntul bungu re, &lt;Jolen go Jeriko tete alahng enyahne tahb, wahn kehm bake.&gt; <verse eid="1CH 19:5" /><verse number="6" style="v" sid="1CH 19:6" />Eji anebe Amon sebe kahn re, bob jol abi ane ka Devid, Hanun a anebe Amon kehm tumu asilva nya bahke rehnge ekilo atahltahl nkpel ebal atahlawubu go eltahla nkpel ewubuni '34,000' tv re bo song yaame amvtv akuungu a abaf'fingi goji anebe Aram Naharayim, Maaka a Joba. <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />Bo yaame amvtv akuungu atahl alon alon nkpel atahlawubu a nkpel eltahl a abaf'fingi, tob budu ntul a Maaka a nsoja enye, bo ba bum abehre kohlo Medeba, gana anebe Amon ebkono elbo ebo ajahbe mehl tahm ebta. <verse eid="1CH 19:7" /><verse number="8" style="v" sid="1CH 19:8" />Devid wuku kan ano, a kehm tumu Joab a nsoja enye kpee, bo ane ba kpi ebnere ebta anoko. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />Anebe Amon kehm lohngo ba ser ebta go elsehnge ni ejahbe ebo, gana atul ba toono bo ba, bo jolo gbul gbul gbuul ga ejahbe. <verse eid="1CH 19:9" /><verse number="10" style="v" sid="1CH 19:10" />Joab nyehne re anebe ebta jol-e es'song fere jol-e ga njahm, owo á jake atahntahn nlong nsoja o Isreel re bo yiimi a anebe Aram. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />Erik aneblum bako á yake bo ka Abisayi ji mmonannyehn re á jol ntubesi a bo, bo ba yiimi a anebe Amon. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />Joab bungu re l'jol re anebe Aram l'kehm tahne sehng-m, ba wo ba tobem, wo l'fere jol re anebe Amon yahke tahne sehng-a, m bahke bake ba tob-a. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />Bel atahne, nong wahr nok go esahb ka ane ebahre a ajahbe nya Esowo ebahre. Jehova bahke limi ji bahke nobo ege ejang.&gt; <verse eid="1CH 19:13" /><verse number="14" style="v" sid="1CH 19:14" />Owo Joab a nlong nyi jolo a ne kehm sehke ata elnoko a anebe Aram, anebe Aram be tahm. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />Eji anebe Amon sebe kahn re, anebe Aram kp'beke, bo fvfo tob be Abisayi ji mmonannyehn song yel atahng ejahbe. Owo Joab kehm feere kehnge go Jerusalem. <verse eid="1CH 19:15" /><verse number="16" style="v" sid="1CH 19:16" />Eji anebe Aram nyehne re anebe Isreel ebga bo, bo tumu atiingi etib tv anebe Aram, bo ko bo ba nkpe aya ma Ufratis, Sofak ji jolo ntubesi a nsoja nyi Hadadejer wo ko bo ba. <verse eid="1CH 19:16" /><verse number="17" style="v" sid="1CH 19:17" />Eji bo tongo Devid bade ejum jia, á kuu anebe Isreel kpee bo siiri aya Jodan, á song sehke ata yiimi songo songo wane a bo. Devid yehke nsoja enye bum re bo nok a anebe Aram, bo l'lohko nok a ne. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />Wo, bo be esamahr Isreel, fvfo Devid wulu ane ba kpo fing amvtv akuungu, jolo ane atahltahl nkpel ebal atahlawubu go nkpel esema '7000,' nsoja nyi jene akpade nyi á wulu no jolo ane atahltahl nkpel ebal atahlawubu go nkpel atahlable '40,000.' Á wulu Sofak ji jolo ntubesi a nsoja abo. <verse eid="1CH 19:18" /><verse number="19" style="v" sid="1CH 19:19" />Eji atul kpee ba woomo go elwo ni Hadadeje nyehne re, Isreel ebga bo sehng, bo ba limi elkoono a Devid fere woom-e elwo. Tib esi jio anebe Aram joom kpe seb re bo tob anebe Amon nkpel anyehng anyehng.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s">Devid Ko Ejahbe Raba</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />Ngare nyi nnale yake bom, ngare nyi atul kpo lohng song nok nta, Joab wo lohngo a nsoja. Yeb lim ndi nyi anebe Amon ebsa nehmenehme, fvfo á tahme go Raba song kehme elrannge, wo ntula Devid jolo ga Jerusalem. Joab noko a ejahbe Raba, ejahbe jio fere sa nehmenehme. <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />Devid wobo ekpasi ji ntula bo ege esi, eji bo dumu no lubu rehng ebahk agul, eltahl ebahk ebwubu ebahk ebni '34' bo ko atal nya nno a nno lim, bo koongo Devid ege esi. Á daa nsol gbalee go ejahbe jio kehnge anyi, <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />á fere yehke ane ba jolo o, ba kak bo eltum nti ayange, akuungu go nfuk, Devid limi jia go ajahbe Amon kpee. Owo Devid a nsoja enye kpee kehm feere kehnge go Jerusalem.<verse eid="1CH 20:3" /></para>
  <para style="s">Ebta Bi Gbo Bade Anebe Filista</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />Eji ma kang, ebta kehm gboko go Geje a anebe Filista a anebe Ireel. Ngare nyio Sibekayi nne a Husati wulu Sipayi ye ji lohng go et'tohngo ji Refa, fvfo anebe Filista bo g'ga bo. <verse eid="1CH 20:4" /><verse number="5" style="v" sid="1CH 20:5" />Go ebta behko a anebe Filista, Elhanan mmona Jayir no nlum wulu Lami ji mmonnayehna Golaya nne a Giti ye ji bele elkong ntahke elban nyi sahb s'subu ana ebti bi bo kpo ko tub abomo. <verse eid="1CH 20:5" /><verse number="6" style="v" sid="1CH 20:6" />Go ebta behko bi kpe gbo, jolo go Gati nne awohng jolo o no jolo ekolo, á bele anyohkobo arakera ebo abehng abehng, anyehkgung arakera go ekpade ajehng ajehng, kpe kpe eltahl a nsol eni. Ye fvfo lohng et'tohngo ji Rafa. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />Eji á jo nyok anebe Isreel, Jonatan mmona Simeya no nlum ji mmonannyehna Devid wo wul-e. <verse eid="1CH 20:7" /><verse number="8" style="v" sid="1CH 20:8" />Ane baa lohng et'tohngo ji Rafa go Gati, bo kpee Devid a ane ebe wulu bo.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s">Devid Fange Abanoko Ebta</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />Nnehm kehm mehle nfem bade anebe Isreel, ba ka Devid ebi ntir re á fange nfange anebe Isreel kak bo abing go nwer. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />Owo Devid kehm tongo Joab a atubesi nlong nsoja re, &lt;&lt;Songen wahn song fange anebe Isreel bomo go Beerseba tete rehng go Dan. Wahn feere ba tong-m eji n kahn ana bo ruru no. <verse eid="1CH 21:2" /><verse number="3" style="v" sid="1CH 21:3" />Wo Joab faange re, &lt;&lt;Nong Jehova lim bo rur nkpel atahlalon budu. Nsoo ntul ewame anv, bo kpee ane ba wob nsoo ntul ewame go elwo sanga? Jenjii wahnge nsoo ntul yake lim jia? N'nan á yahke ko ebi ba kunu Isreel?&gt;&gt; <verse eid="1CH 21:3" /><verse number="4" style="v" sid="1CH 21:4" />Limi limi kan ellum ni ntul ni yiimi sehnge ni Joab; owo Joab kehm tahme jen yannge go Isreel kpee, fere feere kehnge Jeusalem. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />Joab ba tooro nfange nyi aneblum ba bahke ma nok ebta tong Devid: go Isreel kpee jolo ane emilon anyehng budu ane atahltahl nkpel ebal atahlawubu go nkpel atahla alon '1,100,000' bo ji bahke ma fili ekahngkahng, go ane atahltahl nkpel ebal atahlawubu go nkpel eni budu ane atahl are ane awubu '470,000' bo ji lohng go Juda. <verse eid="1CH 21:5" /><verse number="6" style="v" sid="1CH 21:6" />Wo Joab fangem anebe Levi a et'tohngo ji Benjamin budu go nfange nyia, tibre elkahn ni ntul ka-e no moong-e eltim sehng. <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />Elkahn nia tob jolo eb'bi go esamahr bi Esowo, tib jio ji wahnge á kake Isreel erem. <verse eid="1CH 21:7" /><verse number="8" style="v" sid="1CH 21:8" />Owo Devid kehm tongo Esowo re, &lt;&lt;Me n lim agburu abiafem eji m ma lim jia. anv n kp'gboongo re wo tahm ka nlokeltum ewa ebi jia. Me n lim egboolo ejum&gt;&gt;. <verse eid="1CH 21:8" /><verse number="9" style="v" sid="1CH 21:9" />Jehova kehm tongo Gad ji jolo nnyehnamahr no Devid re, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />&lt;&lt;Song wo song tong Devid re &lt;Ejum ji a ji Jehova kpˈbungu re, N kp-a kake nsol era. Yehke ejum ajehng ji m bahk-a limi.&gt;&gt; <verse eid="1CH 21:10" /><verse number="11" style="v" sid="1CH 21:11" />Owo Gad kehm tahme goji Devid, song tong-e re, &lt;&lt;Ejum ji a ji Jehova kp'bungu re; &lt;&lt;Yehke ejum ji kor-a no; <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />njal go nnya era, afii anebekv ko nnyahng era kam-n go ebo akahngkahng, afii Jehova ko ekahngkahng kak ndi erem go nfung era nyi á bahke koko enjel enye ba rannge anebe Isreel go nkpohko anyehng anyehng. Anv toobo ana m bahke faange nne no tum-m no.&gt;&gt; <verse eid="1CH 21:12" /><verse number="13" style="v" sid="1CH 21:13" />Devid faange Gad re,&lt;&lt;Me n yel egburu nfem. Nong me n gbo yel abo nya Jehova, tib ndon enye kp'gbale; wo, ka nongo me n gbo yel abo nya nne.&gt;&gt; <verse eid="1CH 21:13" /><verse number="14" style="v" sid="1CH 21:14" />Owo Jehova kehm tumu ebi eyam tv anebe Isreel, fvfo aneblum ba kpo no jolo ane atahltahl nkpel ebal atahlawubu go nkpel atahla ara ane awubu '70,000.' <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />Fvfo Esowo tumu enjel tv re, á song rannge Jeruselem. Wo ana enjel jo lim ano asongo, Jehova nyehn fere rahke erem bio, kehm tongo enjel nyi jo rannge ane re, &lt;&lt;Ebgbal! yehke ebo eba.&gt;&gt; Enjel nyi Jehova sa yiimi edi arasi aruumu ji Aruana nne a Jebusi. <verse eid="1CH 21:15" /><verse number="16" style="v" sid="1CH 21:16" />Devid kehm seenge nyehn enjel nyi Jehova yim no go elka elka ni elbung a ndi, a ekahngkahng bi á wobo no ege ebo kp'tono tv go Jeruselem. Owo Devid a anebkul kehm kake nsol elkv anoongo gbo kohk asamahr ndi. <verse eid="1CH 21:16" /><verse number="17" style="v" sid="1CH 21:17" />Devid tongo Esowo re, me sang ka elkahn re bo fange aneblum ba bahke ma noka? Me mbaabe ebul, me n lim abiafem fere lim elsoodo. Bo ejoro bi. Bob lim jen? Jehova Esowo ebame, nong ebo eba gbo kuumu me a ebangenahb ejame, wo ka nongo erem bia sa a ane eba.<verse eid="1CH 21:17" /></para>
  <para style="s">Devid Limi Egudu Njom</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />Owo enjel nyi Jehova kehm kake Gad elkahn re, á song tong Devid re, á song lim egudu njom ka Jehova go edi arasi aruumu ji Arauna nne a Jebusi. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />Devid kehm mehle tahm, á kpunu ellum ni Gad ma bung go mbing nyi Jehova. <verse eid="1CH 21:19" /><verse number="20" style="v" sid="1CH 21:20" />Eji Arauna jo ruumu nkohlsak á kehm keebe nyehn enjel, abon ebe ba nlum na ani be song biiri. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />Devid soro ba lohng, eji Arauna seenge no nyehn Devid, á tahme o edi arasi aruumu song gong esamahr ebe ndi ka Devid. <verse eid="1CH 21:21" /><verse number="22" style="v" sid="1CH 21:22" />Devid tong-e re, &lt;&lt;Nong me n ko edi arasi aruumu eja jia, eji n l'lim egudu njom ka Jehova, eji erem bia bade ane l'rahke. Gung-m go ekun bi fuumu no. <verse eid="1CH 21:22" /><verse number="23" style="v" sid="1CH 21:23" />Arauna tongo Devid re, &lt;&lt;Ko me, nong nsoo ntul ewame lim ana yeb-e no. Nyehno, m bahke kake efong a ko lim njom nyi eljahme fi, nti nkohlsak aruumu jol ana nkun, fvfo nkohlsak bahke jolo ka njom nyi akohl. M bahke kake nyaa kpee.&gt;&gt; <verse eid="1CH 21:23" /><verse number="24" style="v" sid="1CH 21:24" />Wo ntula Devid faange Arauna re, &lt;&lt;E,ee n nehm ko k'gunu na ka ekun, n nehm ko j'ja ka Jehova afii lim njom nyi eljahme fi nyi kii-m kim ekun abehng abehng.&gt;&gt; <verse eid="1CH 21:24" /><verse number="25" style="v" sid="1CH 21:25" />Owo Devid kehm kpiki Arauna ebahk agul, atahl alon alon edi ebrakera go edi jio. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />Devid limi egudu njom o, fere lim njom nyi eljahme fi a nyi elkoono. Á lungu Jehova, fvfo Jehova faang-e faange go agun kehm lohngo go ejahbetul ba yel egudu njom ji njom ayare eljahme fi fere fi njom nyio. <verse eid="1CH 21:26" /><verse number="27" style="v" sid="1CH 21:27" />Owo Jehova kehm tongo enjel, fvfo á feere ekahngkahnhg ebe kak mbak. <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />Ngare nyio, eji Devid nyehne re Jehova me-e faange go edi nkohlsak aruumu ji Arauna nne a Jebusi, á tob jo limi ajom o. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />Mobkpatahk no Jehova, no Mosis limi no go ewumwum ndi k'lehmahng ajele a egudu njom ji eljahme fi, ngare nyia kpaka li go edi Jehova akake go Gibeon. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />Wo Devid maam je song bahb elle goji Esowo, tibre á jo f'fahl ekahngkahng bi enjel nyi Jehova.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />Owo Devid kehm bungu re, &lt;&lt;A wo nobo re etahk ji Jehova Esowo jol, fvfo tob budu egudu njom ji eljahme fi ji Isreel.<verse eid="1CH 22:1" /></para>
  <para style="s">Ntoobo Nyi Etahk Esowo Go Elsehke</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />Owo Devid kehm kake elkahn re bo kuu ajahmjahm nya lene Isreel, go ebo ellong wo á yehke anebe atal ajiki, re bo soongo atal nya bo bahke koko si etahk Esowo. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />Á kaa akuungu gbalee nya bo bahke koko lim aba nya ati mbu, a nya bo bahke jo kum kono atem, go abilekpi gbalee nya bo l'k'ma dumu. <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />Á tob ka akv nti aseda nya bo l'k'ma fange, tib anebe Sidon a anebe Taya ko go nrur ba ka Devid. <verse eid="1CH 22:4" /><verse number="5" style="v" sid="1CH 22:5" />Devid bungu re,&lt;&lt;Mmon ewame no nlum Solomon kpaka li mmojangkun, á ka bel ngbere, fvfo etahk ji li re bo si ka Jehova bahke jolo ji bahke lohngo egburu elgahm, bahke yeere, bel ellub go ajang ajahbe kpee. Fvfo m bahke toobo nsol bum sik. Owo wahnge Devid toobo nsol go ntooranti, afung elkv ene kehm rehnge. <verse eid="1CH 22:5" /><verse number="6" style="v" sid="1CH 22:6" />Á kehm lungu Solomon mmon ewe no nlum, kehm-e kake elkahn re, á si etahk ka Jehova, Esowo bi anebe Isreel. <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />Devid tongo Solomon re, &lt;&lt;mmon ewame no nlum, jol-m ga eltim re me n si etahk ka Mbing nyi Jehova Esowo ebame. <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />Wo Jehova bungu aname re,&lt;&lt;Wob faade alung gbalee, fvfo wob nok agburu nta gbalee. Wo sang bahke sehke etahk ka Mbing enyame, tibre wob faade alung gbalee go ndi egame esamahr. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />Wo, á bahke bele mmon no nlum no bahke jolo nne elkoono a erekekv, m bahk-e kake erekekv go abo nya anebekv ebe kpee go ejang ajehng ajehng. Mbing enye bo bahke jo lung-e re, Solomon, m bahke kake anebe Isreel elkoono a enange ngare efilane eje. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />Ye wo bahke sehke etahk ka Mbing enyame. Á bahke jolo mmon ewame no nlum, fvfo m bahke jolo nde no ewe. M bahke limi eti etul eje gbal ka anebe Isreel go njianjini.&gt; <verse eid="1CH 22:10" /><verse number="11" style="v" sid="1CH 22:11" />&lt;&lt;Anv mmon ewame no nlum, Jehova jol ana, fvfo nong nob a na, wo si etahk ji Jehova Esowo eba ana á tongo re a bahke limi. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />Nong Jehova lub ka-a elkahne a ngbere ngare nyi á l'rod-a lim ntubesi ka Isreel, eji a l'bum atahm nya Jehova Esowo eba. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />Owo bahke nobo a na, a l'lub bel ekunukpu jo bum atahm a ntibi nyi Jehova ka Mosis re jol ka Isreel. Bel atahne a ekakeltim. Ka bel elfahle, jol eltim ki-a woono. <verse eid="1CH 22:13" /><verse number="14" style="v" sid="1CH 22:14" />Me n ko egburu elmaange toobo nsol bum sik etahk Jehova, agul gbale senge emilon akilo agul era a atahltahl nkpel ebal atahlawubu go nkpel atahltahl '3,400,000,' a asilva nya gbale senge emilon akilo asilva atahlawubu eni '34,000,000.' Abilekpi gbalee a akuungu nya kp'gbale ana nne l'k'ma dumu, nti a atal. Wofono bahke ma kpe kpele budu. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />A kpi anebeltum gbalee, abajiki atal, abalange akahme, abakono ajangenti a ane ba kpi ajoobo abo ntum go elkohn eltum anehng anehng, <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />go agul a silva, abilekpi a akuungu, anebe agb'gbe jolo go nlong ana nne l'k'ma fange. Anv bom eltum, nong Jehova jol a na. <verse eid="1CH 22:16" /><verse number="17" style="v" sid="1CH 22:17" />Owo Devid kehm kake anebkul Isreel kpee elkahn re, Bo kak Solomon mmon ewe no nlum ebo. <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />Á tongo bo re, lohkem li re Jehova Esowo ebahne li anahna? Á wahn ka ka erekekv ajang kpe kpea? Tib yeb yake ane ba lene a kak-m abo, fvfo ndi wob elwo ni Jehova, tob wob ane ebe ebo. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />Anv koon ntim enyahne a atohko enyahne wahn jo seb Jehova Esowo ebahne. Bomen elsehke edi ji li saang ji Jehova Esowo, eji ń l'song ko elkohl nwongo nyi Jehova a nsol nyi li saang nyi li ka Esowo, ba kak etahk ji bo bahke sehke ka mbing nyi Jehova.<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s">Ntum Nyi Anebe Nlaaga Ba Levi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />Eji Devid ma kang nnya tvv sahb k'kul, á kehm bobo Solomon mmon ewe no nlum etul ka Isreel. <verse eid="1CH 23:1" /><verse number="2" style="v" sid="1CH 23:2" />Á tob lungu atubesi Isreel kpee kono, a abalimajom go anebe nlaaga ba Levi. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />Anebe nlaaga ba Levi ba ma kang rehng eltahl a nnya ewubu k'kunu bo ba bo fange bo, nfange a bo kpee nyi aneblum jolo atahltahl nkpel ebal atahlawubu etahla nkpel elkuni '38,000.' <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />Devid bungu re, &lt;&lt;Bo jia a, jolo ane atahltahl nkpel ebal atahlawubu nkpel atahlani '24,000,' bo bahke jolo ka eltum ni etahk Esowo akake ji Jehova, fvfo atahl alon alon nkpel atahlara bahke jolo atubesi eltum a abalamalam. <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />Ane atahltahl nkpel ebal atahlawubu nkpel eni '4,000' bahke jolo ane ba bahke jo baabe ati mbuga, ane atahltahl nkpel ebal atahlawubu nkpel eni '4,000' bako bahke jo tehk Jehova go nsol elkubu nyi m ma toobo bum tib eyaame jio.&gt;&gt; <verse eid="1CH 23:5" /><verse number="6" style="v" sid="1CH 23:6" />Devid yabe anebe Levi bum go nlong era, toono abon ba nlum ba ebangenahb ji nlaaga nyi Levi: ebangenahb ji Gerson, ebangenahb ji Kohati, a ebangenahb ji Merari. <verse eid="1CH 23:6" /><verse number="7" style="v" sid="1CH 23:7" />Bo ji lohng ebangenahb ji Gerson, Ladan a Semeyi. <verse eid="1CH 23:7" /><verse number="8" style="v" sid="1CH 23:8" />Abon ban lum ba Ladan: Jehiyel wo li ngbokambang, Jetam a Joel, bo kpee jolo ane ara. <verse eid="1CH 23:8" /><verse number="9" style="v" sid="1CH 23:9" />Abon ba nlum ba Simeyi: Selomoti, Hajiel a Haran bo kpee jolo ane ara. Bo jia ba jolo atubesi ebangenahb ji Ladan. <verse eid="1CH 23:9" /><verse number="10" style="v" sid="1CH 23:10" />Abon ba nlum ba Simeyi: Jahati, Jija, Jeusi a Beria bo jia ba jolo abon ba nlum ba Simeyi bo kpee jolo ane ani. <verse eid="1CH 23:10" /><verse number="11" style="v" sid="1CH 23:11" />Jahayi wo jolo ngbokambang, Jija jol etoono, wo Jeusi abola Beria bo belem abon ba nlum gbalee, bo fange bo ana ebangenahb ajehng, eltum anehng ni bo ka bo.<verse eid="1CH 23:11" /></para>
  <para style="s">Anebe Nlaaga Ba Kohati</para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 23:12" />Abon ba nlum ba Kohati: Amram, Ilar, Hebron a Ujiyel bo kpee ane ani. <verse eid="1CH 23:12" /><verse number="13" style="v" sid="1CH 23:13" />Abon ba nlum ba Amram: Eron a Mosis, Eron a et'tohngo eje bo yabe bo bum eje eje go njinanjini, re bo jo lim sahb b'bar nsol nyi li saang, bo jo lim ajomjom ka Jehova bo jo lok-e eltum, fere jo fuulu ane go egea mbing go njinanjini. <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />Abon ba nlum ba Mosis ji nne Esowo, bo fange bo ana bo lohng nlaaga nyi Levi. <verse eid="1CH 23:14" /><verse number="15" style="v" sid="1CH 23:15" />Abon ba nlum ba Mosis ba a: Gersom a Eliejer. <verse eid="1CH 23:15" /><verse number="16" style="v" sid="1CH 23:16" />Abon ba Gersom: Subayel wo jolo ngbokambang. <verse eid="1CH 23:16" /><verse number="17" style="v" sid="1CH 23:17" />Nlaaga nyi Eliejer nyi a: Rehabaya wo jolo ngbokambang. Eliejer belem abon bako ba nlum, wo abon ba nlum ba Rehabaya ruru sehng. <verse eid="1CH 23:17" /><verse number="18" style="v" sid="1CH 23:18" />Abon ba nlum ba Ijar: Selomoti wo jolo ngbokambang. <verse eid="1CH 23:18" /><verse number="19" style="v" sid="1CH 23:19" />Abon ba nlum ba Hebron: Jeria wo jolo ngbokambang, Amaria jol etoono Jahajiyel etoono ane ara, Jekameam jol etoono ane ani. <verse eid="1CH 23:19" /><verse number="20" style="v" sid="1CH 23:20" />Abon ba nlum ba Ujiyel: Mika wo jolo ngbokambang, Isaya jol etoono.<verse eid="1CH 23:20" /></para>
  <para style="s">Anebe Nlaaga Ba Merari</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 23:21" />Abon ba nlum ba Merari: Mali a Musi. Abon ba nlum ba Mali, Eleaja a Kisi. <verse eid="1CH 23:21" /><verse number="22" style="v" sid="1CH 23:22" />Eleaja kpo, á belem abon ba nlum, sehngem abon ba nkal ba á bele no. Afun ebo ba jolo abon Kisi ba nlum ba ba baange bo. <verse eid="1CH 23:22" /><verse number="23" style="v" sid="1CH 23:23" />Abon ba nlum ba Musi ba a: Mali, Eder, a Jerimoti bo kpee jolo ane ara. <verse eid="1CH 23:23" /><verse number="24" style="v" sid="1CH 23:24" />Bo ji lohng nlaaga nyi Levi toono go ebo a ebangenahb, atubesi abangenahb ana bo nyohno abing ebo kak ebo go nwer, fere fange go nne awohng awohng. Ane ba bo nyohno abing ebo kak go nwer, bo ba jolo abalimeltum go etahk ji Jehova, bo jolo ane ba ma kang rehng nnya eltahl k'kunu. <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />Tib Devid ebbung re, &lt;&lt;Eji Jehova Esowo bi Isreel ma ka ane ebe erekekv, fvfo yeb ba re, á ba lene a Jeusalem go njinanjini, <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />anebe nlaaga ba Levi kpeem li re, bo jo sol mmobkpatahk afii nsol nyi bo kpo ko jo loko eltum o.&gt;&gt; <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />Ana wo Devid gohro tub es'kohro elle, anebe Levi bo fange bo, bomo nnya eltahl k'kunu. <verse eid="1CH 23:27" /><verse number="28" style="v" sid="1CH 23:28" />Eltum ni anebe Levi li re, bo kak et'tohngo ji Eron ebo, jo loko eltum go etahk ji Jehova, bo ba bahke jo kpur alaaga nya etahk ji Jehova, anyo akp'kpa nya li akpekpe, jo lim nsol kpee nyi li saang jol saang, fere jo lim ajoobo abo ntum go etahk Esowo. <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />Bo ba bahke jolo ka abred nya bo kpo lim kunu ekp'kuru, akahmekahme abe nya njom nyi akohl, afiiri fiiri abred nya ki kpi ayist, elbane a elsemme, fvfo ana bo bahke jo gaare kpee ana fuumu no a agbal enye. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />Bo bahke tob jo yiimi efungfu abehng abehng jo kak saam fere jo tehk Jehova. Elgung bo bahke tob lim ano, <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />fvfo ngare anyehng anyehng nyi bo kp'limi njom nyi eljahme fi ka Jehova efung Esabad, efung ebareka nfenfe ji elkak, a afung nya nkak alimi. Bo bahke jo loko Jehova ngare anyehng anyehng go nfange nyi bo kake no, fvfo go mbang nyi bo toobo ka bo. <verse eid="1CH 23:31" /><verse number="32" style="v" sid="1CH 23:32" />Ano wo anebe nlaaga ba Levi rodo eltum ebo jo lim go ebkpatahk bi elwane, go Edi Ji Li Saang, go elwo ni abonanyehn ebo et'tohngo ji Eron, go elloko ni bo jo loko etahk Jehova.<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s">Ntum Nyi Abalimajom</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />A wo li nlong nyi et'tohngo ji Eron: Abon ba nlum ba Eron jolo, Nadab, Abihu, Eleaja a Itama. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />Wo Nadab abola Abihu bo tohko kpo ndea bo kehm kpoko, bo jelem mmon awohng awohng, fvfo Eleaja abola Itama bo jo loko ana abalimajom. <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />Go ekakebo ji Jadok ji lohng nlaaga nyi Eleaja a Ahimelek ji lohng nlaaga nyi Itama, Devid yabe bo bum nlong a nlong toono ana á bake bo ntum. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />Bo nyehne egburu ellong atubesi ba lohng go nlaaga nyi Eleaja, sehnge nlaaga nyi Itama, fvfo bo yabe bo toono ana bo jolo no, elkua ntubesi ebangenahb awohng '16' go nlaaga nyi Eleaja, atubesi ebangenahb anehkeni '8' go nlaaga nyi Itama. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />Bo tubu elfaange yab bo jol nnene bo rangem, tib jolo re bo bel atubesi ba edi ji li saang a atubesi ba eltum etahk Esowo go ellong ni alaaga nya Eleaja abola Itama. <verse eid="1CH 24:5" /><verse number="6" style="v" sid="1CH 24:6" />Nyonawer, Semaya ji mmon no nlum no Netanel nnea nlaaga nyi Levi, nyono abing ebo kak nwer go esamahr bi ntul a bi atubesi eltum. Jadok ji nlimajom, Ahimelek ji mmon no nlum no Abiata a atubesi abangenahb nya abalimajom a anebe nlaaga nyi Levi, bo yehke nnahb anyehng goji Eleaja, fere tob yehke anyehng goji Itama. <verse eid="1CH 24:6" /><verse number="7" style="v" sid="1CH 24:7" />Ngbokambang elfaange gbo tub Jehoarib, etoono gbo tub Jedaya, <verse eid="1CH 24:7" /><verse number="8" style="v" sid="1CH 24:8" />etoono ebra gbo tub Harim, etoono ebni gbo tub Seorim, <verse eid="1CH 24:8" /><verse number="9" style="v" sid="1CH 24:9" />go eblon gbo tub Malkija, go ebrakera gbo tub Mijamin, <verse eid="1CH 24:9" /><verse number="10" style="v" sid="1CH 24:10" />go ebsehma gbo tub Hakoji, go ebnehkeni gbo tub Abija, <verse eid="1CH 24:10" /><verse number="11" style="v" sid="1CH 24:11" />go ebsehmwubu gbo tub Jesua, go ebwubu gbo tub Sekaniya, <verse eid="1CH 24:11" /><verse number="12" style="v" sid="1CH 24:12" />go ewubajehng gbo tub Eliasib, go ewubbal gbo tub Jakim <verse eid="1CH 24:12" /><verse number="13" style="v" sid="1CH 24:13" />go ewubera gbo tub Hupa, go ewubeni gbo tub Jesebeyab, <verse eid="1CH 24:13" /><verse number="14" style="v" sid="1CH 24:14" />go elku gbo tub Bilga, go elku ajehng gbo tub Immer, <verse eid="1CH 24:14" /><verse number="15" style="v" sid="1CH 24:15" />go elku ebbal gbo tub Hejir, go elku era gbo tub Hapijeji, <verse eid="1CH 24:15" /><verse number="16" style="v" sid="1CH 24:16" />go elku ebni gbo tub petahiya, go eltahl gbo tub Jehejikel, <verse eid="1CH 24:16" /><verse number="17" style="v" sid="1CH 24:17" />go eltahl ajehng gbo tub Jakin, go eltahl ebbal gbo tub Gamul, <verse eid="1CH 24:17" /><verse number="18" style="v" sid="1CH 24:18" />go eltahl ebra gbo tub Delaya, fvfo go eltahl ebni gbo tub Majia. <verse eid="1CH 24:18" /><verse number="19" style="v" sid="1CH 24:19" />Ana wo jolo esennge eltum ebo, bo l'yel etahk Jehova jo lim eltum, ana Eron ndea bo no nkul bake bo, ana Jehova, Esowo bi anebe Isreel ka-e elkahn.<verse eid="1CH 24:19" /></para>
  <para style="s">Erik Anebe Nlaaga Ba Levi</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 24:20" />Ana erik anebe nlaaga ba Levi; go abon ba nlum ba Amram; Subayel, go abon ba nlum ba Subayel, Jedeya. <verse eid="1CH 24:20" /><verse number="21" style="v" sid="1CH 24:21" />Ana abon ba nlum ba Rehabiya, go ege abon, Isia wo jolo ngbokambang. <verse eid="1CH 24:21" /><verse number="22" style="v" sid="1CH 24:22" />Go anabe Ijariti wo Selomoti long no; go abon ba nlum ba Selomoti wo Jahati long no. <verse eid="1CH 24:22" /><verse number="23" style="v" sid="1CH 24:23" />Abon ba nlum ba Hebron, Jeria wo jolo ngbokambang, Amaria etoono ane abal, Jahajiel jol etoono ane ara, fvfo Jekameyam wo jolo etoono ane ani. <verse eid="1CH 24:23" /><verse number="24" style="v" sid="1CH 24:24" />Mmon no nlum no Ujiyel, Mika, go abon ba nlum ba Mika; Samir. <verse eid="1CH 24:24" /><verse number="25" style="v" sid="1CH 24:25" />Mmonannyehn no Mika: Isiya; go abon ba nlum ba Isiya: Jekaria. <verse eid="1CH 24:25" /><verse number="26" style="v" sid="1CH 24:26" />Abon ba nlum ba Merari: Mali abola Musi. mmon no nlum no Jaajia, Beno. <verse eid="1CH 24:26" /><verse number="27" style="v" sid="1CH 24:27" />Abon ba nlum ba Merari bomo goji Jaajia, Beno, Soham, Jakur a Ibri. <verse eid="1CH 24:27" /><verse number="28" style="v" sid="1CH 24:28" />Goji Mali: Eleaja ye ji ki bel abon. <verse eid="1CH 24:28" /><verse number="29" style="v" sid="1CH 24:29" />Goji Kisi, mmon no nlum no Kisi, Jeramel. <verse eid="1CH 24:29" /><verse number="30" style="v" sid="1CH 24:30" />Fvfo abon ba nlum ba Musi, Mali, Eder, a Jerimoti. Bo jia ba jolo anebe nlaaga ba Levi toono go ebo ebangenahb. <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" />Bo tob tubu elfaange, ana abonannyehn ebo go nlaaga nyi Eron limi no, go esamahr bi ntula Devid a bi Jadok. Ahimelek a atubesi ebangenahb ba abalimajom a anebe nlaaga nyi Levi. Abangenahb nya mmonannyehn no nkulakul bo ka bo eltum ana bo tob ka abangenahb nya abonanyehn ba nseanse.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s">Eltum Ni Abayimase Go Etahk Esowo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />Devid budu a atubesi nsoja, bo yabe abon ba nlum ba Asafi, Heman abola Jedutun, bo jol ka eltum ni amahr anyehne, jo ko atalehk, abuk a agehmegehme. A wo li abing aneblum ba jo lim eltum nia. <verse eid="1CH 25:1" /><verse number="2" style="v" sid="1CH 25:2" />Go ellong abon ba nlum ba Asafi: Jakur, Josef, Netania, a Aserela. Abon ba nlum ba Asafi jo limi eltum go elwo ni Asafi, ye ji jo nyehn amahr go ngare anehng anehg nyi ntul l'ka elkahn. <verse eid="1CH 25:2" /><verse number="3" style="v" sid="1CH 25:3" />Ana Jedutun, bomo ege abon ba nlum, Gedalia, Jeri, Jesaya, Simeyi, Hasabia, a Matitaya, bo kpee jolo ane arakera, bo jo limi eltum go elwo ni Jedutun ndea bo, ye ji jo nyehn amahr, jo ko ebuk jo kak saam, fere jo tehk Jehova. <verse eid="1CH 25:3" /><verse number="4" style="v" sid="1CH 25:4" />Ana Heman ege abon ba nlum, Bukia, Matania, Ujiyel, Subayel a Jerimoti, Hanania, Hanani, Eliata, Gidalti a Ramanti-Eje, Josibekasa, Maloti, Hotir, a Mahajioti. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />Bo jia kpee jolo abon ba nlum ba Heman, bo ba jolo abay'yehne ba ntul. Bo rodo bo ka ntul tib go anyam nya Esowo re, bo jo mehl-e wahre. Esowo ka Heman ewubu abon ba nlum na ani '14,' abon ba nkal ara '3.' <verse eid="1CH 25:5" /><verse number="6" style="v" sid="1CH 25:6" />Aneblum baa kpee jo limi eltum go elwo ni ndea bo go ase akubu go etahk Jehova, bo jo ko abuk, atalehk a agehmegehme, go eltum nio etahk Esowo. Asafi, Jodutun, a Heman bo jolo go elwo ni ntul. <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />Budu a abonanyehn bako bo kpee kpili ebo eltum bio bi ase akubu ka Jehova, bo jolo ane atahl alon alon edi ebbal kunu atahlani '288.' <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />Ajangkun a ak'kulu, at'tibi a abone nwer fvfo, bo kpee tubu elfaange ka eltum ebo. <verse eid="1CH 25:8" /><verse number="9" style="v" sid="1CH 25:9" />Ngbokambang elfaange ni jolo ka Asaf, gbo tub Josefi, abon ebe ba nlum a abonanyehn bo ewubu ane abal '12,' etoono gbo tub Gedalia, ye a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:9" /><verse number="10" style="v" sid="1CH 25:10" />etoono ebra gbo tub Jakur, abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:10" /><verse number="11" style="v" sid="1CH 25:11" />etoono ebni, gbo tub Ijiri, abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:11" /><verse number="12" style="v" sid="1CH 25:12" />etoono eblon gbo tub Netania, abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:12" /><verse number="13" style="v" sid="1CH 25:13" />go etoono ebrakera gbo tub Bukia, abon ebe ba nlum, a abonanyehn bo ewubu abal '12,' <verse eid="1CH 25:13" /><verse number="14" style="v" sid="1CH 25:14" />go ebsehma gbo tub Jesarela, abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:14" /><verse number="15" style="v" sid="1CH 25:15" />go ebnehkeni gbo tub Jesaya, abon ebe ba nlum a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:15" /><verse number="16" style="v" sid="1CH 25:16" />go ebsehmwubu gbo tub Matania, abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:16" /><verse number="17" style="v" sid="1CH 25:17" />go ebwubu gbo tub Semei, abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:17" /><verse number="18" style="v" sid="1CH 25:18" />go ebwubu ajehng gbo tub Ajarel, abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:18" /><verse number="19" style="v" sid="1CH 25:19" />go ewubbal gbo tub Hasabia, abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:19" /><verse number="20" style="v" sid="1CH 25:20" />go ewubura gbo tub Subayel, abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:20" /><verse number="21" style="v" sid="1CH 25:21" />go ewubu eni gbo tub Matitaya, abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:21" /><verse number="22" style="v" sid="1CH 25:22" />go elku gbo tub Jerimoti, abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:22" /><verse number="23" style="v" sid="1CH 25:23" />go elku ajehng gbo tub Hananiya abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:23" /><verse number="24" style="v" sid="1CH 25:24" />go elku ebal gbo tub Josibekasa abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:24" /><verse number="25" style="v" sid="1CH 25:25" />go elku era gbo tub Hanani abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:25" /><verse number="26" style="v" sid="1CH 25:26" />go elku eni gbo tub Maloti, abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:26" /><verse number="27" style="v" sid="1CH 25:27" />go eltahl gbo tub Eliata, abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:27" /><verse number="28" style="v" sid="1CH 25:28" />go eltahl ajehng gbo tub Hotir abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:28" /><verse number="29" style="v" sid="1CH 25:29" />go eltahl ebbal gbo tub Gidalti abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:29" /><verse number="30" style="v" sid="1CH 25:30" />go eltahl ebra gbo tub Mahajioti, abon ebe ba nlum, a abonanyehn bo ewubu ane abal '12,' <verse eid="1CH 25:30" /><verse number="31" style="v" sid="1CH 25:31" />go eltahl ebni gbo tub Romamti-Ejer, abon ebe ba nlum, a abonanyehn bo ewubu ana abal '12.'<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s">Ababˈbaabe Ati Mbu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />Nyabe nyi abab'baabe nti abuga: bomo go ebangenahb ji Kora: Meselomiya, mmon no nlum no Kore, mmon awohng no abon ba Asafi. <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" />Meselomiya bele abon ba nlum: Jekaria wo bo gbo mbang jel-e, Jediyel jol etoono, Jebadiya jol etoono ane ara, Jatiniel jol etoono ane ani. <verse eid="1CH 26:2" /><verse number="3" style="v" sid="1CH 26:3" />Elam jol etoono ane alon, Jehohanan jol etoono ane arakara, fvfo Eliehoenayi jol etoono ane asehma. <verse eid="1CH 26:3" /><verse number="4" style="v" sid="1CH 26:4" />Obed-Edom tob bele abon ba nlum: Semaya wo bo gbo mbang jel-e, Jehojabad jol etoono, Joa jol etoono ane ara, Saka jol etoono ane ani, Netanel jol etoono ane alon, <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />Amiyel etoono ane arakera, Isaka etoono ane asehma, fvfo Peuletaya wo jol etoono ane anehkeni. Tib Esowo fuulu Obed-Edom. <verse eid="1CH 26:5" /><verse number="6" style="v" sid="1CH 26:6" />Obed-Edom mmon ewe no nlum Semaya tob bele abon ba nlum ba jolo atubesi go nnahba ndea bo, tib bo jol aneblum ba abon elfvvrv. <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />Abon ba nlum ba Semaya: Otni, Refael, Obed a Eljabad; Abonanyehn ebe, Elihu abola Semakiya bo tob jolo abon elfvvrv. <verse eid="1CH 26:7" /><verse number="8" style="v" sid="1CH 26:8" />Bo jia kpee bo lohng go nlaaga nyi Obed-Edom; bo a abon ebo ba nlum ba go abonanyehn ebo bo jolo anebe elfvvrv bo bele eko ji eltum alimi, et'tohngo ji Obed-Edom bo kpee bo jolo ane atahlara ane abal '62.' <verse eid="1CH 26:8" /><verse number="9" style="v" sid="1CH 26:9" />Meselomiya bele abon ba nlum, a abonanyehn bo jolo anebe elfvvrv, bo kpee bo jolo elku ane ara '18.' <verse eid="1CH 26:9" /><verse number="10" style="v" sid="1CH 26:10" />Hosa nnea Merari bele abon ba nlum: Simri wo jolo ngbokambang, jol ye sang bo gbo mbang jel-e, nde wo yehk-e re á jol ngbokambang, <verse eid="1CH 26:10" /><verse number="11" style="v" sid="1CH 26:11" />Hilkiya wo jolo etoono, Tabalia jol etoono ane ara, fvfo Jekariya jol etoono ane ani. Abon ba nlum ba Hosa a abonanyehn bo kpee bo jolo ewubu ane ara '13.' <verse eid="1CH 26:11" /><verse number="12" style="v" sid="1CH 26:12" />Nlohng nyia nyi abab'baabe ati abuga, sehng goji atubesi ebo, bele eltum ni ellimi go etahk Jehova, ana abonanyehn ebo bele eltum. <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />Bo tubu elfaange ka eti mbuga ajehng ajehng, ana ebangenahb ebo jolo no, ajangkun a ak'kulu ane. <verse eid="1CH 26:13" /><verse number="14" style="v" sid="1CH 26:14" />Elfaange ni eti mbuga ji ero nfam gbo tub Selemiya. Fvfo bo tubu elfaange ka Jekaria mmon ewe no nlum, ntubu elle no jo sahb k'kahn, fvfo ye wo elfaange ni eti mbuga ji ejang ebobkal nfam gbo tub-e. <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" />Elfaange ni eboblum nfam gbo tub Obed-Edom, fvfo elfaange ni etahk nsol akuuru gbo tub abon ebe ba nlum. <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" />Nfaange nyi eti mbuga ji erede nfam a eti mbuga ji Saleketi go nwahre nwahre a mbang gbo tub Sufim abola Hosa.</para>
  <para style="p" vid="1CH 26:16">Mbab'baabe jolo o jo baabe.<verse eid="1CH 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 26:17" />Nlaaga nyi Levi jolo ane arakera '6' jo baabe eti mbuga ji ero nfam efung efung, ane ani go eti mbuga ji ebobkal nfam go efung abehng, ane ani go eti mbuga ji eboblum go efung abehng, fvfo ane abal ngare ngare anyehng go etahk nsol akuuru. <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />Ana nlaaga nyi jolo feere erede nfam, jolo ane ani go mbang, ane abal go yefono nlaaga. <verse eid="1CH 26:18" /><verse number="19" style="v" sid="1CH 26:19" />Bo jia a ba jolo nlong anebe eltum bo ba jo baabe nti abuga, bo ba lohng et'tohngo ji Kora a ji Merari.<verse eid="1CH 26:19" /></para>
  <para style="s">Akuuru Akpohko A Atubesi Ntum Bako</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />Abonanyehn ebe anebe Levi, jolo ka bo re, bo jo kuuru akpohko nya etahk Esowo, fere jo kuuru nsol nyi bo yake ka Esowo. <verse eid="1CH 26:20" /><verse number="21" style="v" sid="1CH 26:21" />Et'Stohngo ji Ladan, bo ji jolo anebe Gerson sehng goji Ladan bo ji li atubesi abangenahb nya Ladan nne a Gerson, bo jolo Jehieli, <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />abon ba nlum ba Jehieli, Jetam a mmonannyehn ewe Joel. Bo ba jo kpur akpohko akuuru go etahk ji Jehova. <verse eid="1CH 26:22" /><verse number="23" style="v" sid="1CH 26:23" />Bomo go ebangenahb ji Amram, ebangenahb ji Ijar, ebangenahb ji Hebron, a ebangenahb ji Ujiel: <verse eid="1CH 26:23" /><verse number="24" style="v" sid="1CH 26:24" />Sebusel ji long go ebangenahb ji Gersom mmon no nlum no Mosis, ye wo jolo ntubesi no akpohko akuuru. <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />Abonanyehn, sehng goji Elieje: Rehabiya mmon ewe no nlum, Jesaya mmon ewe no nlum, Joram mmon ewe no nlum, Jikri mmon ewe no nlum, a Selemoti mmon ewe no nlum. <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />Selemoti a abonanyehn bo ba jo kuuru nsol kpee nyi bo yake kak Esowo go ebo sehng goji Ntul a Devid, sehng goji atubesi abangenahb bo ji jo fili ane atahltahl k'kunu a bo ji jolo atubesi jo fili ane atahl alon kˈkunu, fvfo a atubesi nsoja nyako. <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />Nsol nyimongo nyi bo daa go ebta, bo bumu bo saange ka re bo ko tuungu etahk Jehova. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />A ejum ajehng ajehng ji Samwel ny'yehne yake ka Esowo, ji Sol mmon a Kisi no nlum, Abner mmon a Ner no nlum, a Joab mmon a Jerua no nlum, a nsol kpee nyi bo yake no ka Esowo jolo go abo nya Selomiti a abonanyehn. <verse eid="1CH 26:28" /><verse number="29" style="v" sid="1CH 26:29" />Go nlaaga nyi Ijar: Kenaniya a abon ebe ba nlum, bo ka bo ntum go nyi ki jol o etahk Esowo, re bo jol atubesi a abalamalam ka anebe Isreel. <verse eid="1CH 26:29" /><verse number="30" style="v" sid="1CH 26:30" />Go nlaaga nyi Hebron: Hasabiya a abonanyehn ebe, abon elfvvrv jolo ane atahltahl nkpel ebal atahlawubu budu ane atahltahl atahlku '1,700,' bo ba jo kpur anebe Isreel ba erede aya Jodan go ntum kpee nyi Jehova a ntul aloko. <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />Ana nlaaga nyi Hebron, Jeria wo jolo nnenkul a ebangenahb toono go ebo et'tohngo ana bo kake go awer nya ebangenahb. Ejum nnya atahlabal nyi Devid ma fili ejahbe, bo f'feede awer seb kahn re abon elfvvrv jolo go ellong anebe nlaaga nyi Hebron, go Jaje ji Gilead. <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />Jeriya bele abonanyehn, atahltahl nkpel ebal atahlawubu nkpel altahlawubu budu anea atahltahl atahlku '2,700' bo ji jolo abon elfvvrv a atubesi ebangenahb, fvfo Ntul a Devid kake bo re bo jo kpur nlaaga nyi Ruben, nlaaga nyi Gad, a ejang nlaaga nyi Manase go ejum ajehng ajehng ji li bade Esowo, a nsol nyehka nyehka nyi li bade ntul.<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s">Ntum Nyi Atubesi Nsoja</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />A wo li nwer nyi anebe Isreel nyi tibi bade atubesi abangenahb, atubesi ba jo fili ane atahlanku a nku, a ba jo fili atahl alon alon, a atubesi ebo, bo ji jo loko ntul go nsol kpee nyi li bade nlong nsoja nyi jo lim eltum go nnyahnga nnyahng go elya kohro kohro. Ellong anehng anehng jo jolo ane atahl alon alon nkpel atahlawubu budu ane atahlabal '24,000.' <verse eid="1CH 27:1" /><verse number="2" style="v" sid="1CH 27:2" />Nne no jolo ka ngbokambang ellong, fvfo go ngbokambang a nnyahng bo jo lung-e re, Jasihobeyam mmon no nlum no Jabdiyel jolo ane atahl alon alon nkpel atahlawubu budu ane atahlabal '24,000.' <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />Á lohng go nlaaga nyi Pereji, ye wo jolo ntunesi a nsoja kpee go ngbokambang a nnyahng. <verse eid="1CH 27:3" /><verse number="4" style="v" sid="1CH 27:4" />Nne no jolo ka etoono ellong go etoono nnyahng, bo jo lung-e re Dodayi nnea nlaaga nyi Ahohi: Mikloti wo jolo ntubesi ege ellong, bo jolo ane atahl alon alon nkpel atahlawubu budu ane atahlabal ege ellong '24,000.' <verse eid="1CH 27:4" /><verse number="5" style="v" sid="1CH 27:5" />Ntubesi a nsoja no etoono nnyahng era bo jo lung-e re, Benaya ji mmon no nlum no Jehoada ji nlimajom. Ye wo jolo ntubesi, bo jolo ane atahl alon alon nkpel atahl ewubu budu eltahla ane ani ege ellong '24,000.' <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />Benaya wo a, ji jolo etahntahn ntakuru go ellong ni eltahla nsoja ewubu '30,' ye wo jolo etahntahn ntubesia nsoja. Amijobad mmon ewe no nlum wo jolo ntubesi ka ellong ene. <verse eid="1CH 27:6" /><verse number="7" style="v" sid="1CH 27:7" />Go nlong eni go nnyahng eni, Asahel ji mmonannyehn a Joab; mmon ewe no nlum Jebadiya wo woongo asi enye. Bo jolo ane atahl alon alon nkpel atahlawubu budu ane atahlabal ege ellong '24,000.' <verse eid="1CH 27:7" /><verse number="8" style="v" sid="1CH 27:8" />Go nlong elon go nnyahng elon, Ntubesi bo jo lung-e re Samhuti nne a Ijara, bo jolo ane atahl alon alon nkpel atahlawubu budu ane atahlabal ege ellong '24,000.' <verse eid="1CH 27:8" /><verse number="9" style="v" sid="1CH 27:9" />Go nlong erakera fvfo go nnyahng erakera, Ira mmon no nlum no Ikesi nnea Tekoa wo jolo ntubesi bo jolo ane atahl alon alon nkpel atahlawubu budu ane atahlabal ege ellong '24,000.' <verse eid="1CH 27:9" /><verse number="10" style="v" sid="1CH 27:10" />Go nlong esehma fvfo go nnyahng esehma, Heleji nnea Pelon, ye ji lohng go nlaaga nyi Efrayiim wo jolo ntubesi, bo jolo ane atahl alon alon nkpel atahlawubu budu ane atahlabal ege ellong '24,000.' <verse eid="1CH 27:10" /><verse number="11" style="v" sid="1CH 27:11" />Go nlong enehkeni fvfo go nnyahng enehkeni Sibekaya nnea Husa no lohng go nlaaga nyi Jera. Ye wo jolo ntubesi, bo jolo ane atahl alon alon nkpel atahlawubu budu ane atahlabal ege ellong '24,000.' <verse eid="1CH 27:11" /><verse number="12" style="v" sid="1CH 27:12" />Go nlong esehmwubu go nnyahng esehmwubu, Abiejer nne Anatoti ji lohng go nlaaga nyi Benjamin, ye wo jolo ntubesi, bo jolo ane atahl alon alon nkpel atahlawubu budu ane atahlabal ege ellong '24,000.' <verse eid="1CH 27:12" /><verse number="13" style="v" sid="1CH 27:13" />Go nlong ewubu go nnyahng ewubu, Maharayi nnea Netofa, á lohng go nlaaga nyi Jera, bo jolo ane atahl alon alon nkpel atahlawubu budu ane atahlabal ege ellong '24,000.' <verse eid="1CH 27:13" /><verse number="14" style="v" sid="1CH 27:14" />Go ewuba ellong anehng, ewubu a nnyahng amehng, Benaya nnea Piraton, ye ji lohng go nlaaga nyi Efriim, ye wo jolo ntubesi, bo jolo ane atahl alon alon nkpel atahlawubu budu ane atahlabal ege ellong '24,000.' <verse eid="1CH 27:14" /><verse number="15" style="v" sid="1CH 27:15" />Go ewuba nlong ebal go ewuba nnyahng ebal, Heldayi nnea Netofa ye ji lohng go ebangenahb ji Ot'niel, bo jolo ane atahl alon alon nkpel atahlawubu budu ane atahlabal ege ellong '24,000.'<verse eid="1CH 27:15" /></para>
  <para style="s">Atubesi Ba Alaaga</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 27:16" />Atubesi ba alaaga nya Isreel: go nlaaga nyi Ruben: Elieje mmon no nlum no Jikri; Go nlaaga nyi Simeon: Sefatiya mmon no nlum no Maka; <verse eid="1CH 27:16" /><verse number="17" style="v" sid="1CH 27:17" />Go nlaaga nyi Levi: Hasabiya mmon no Kemuel; Go nlaaga nyi Eron: Jadok wo; <verse eid="1CH 27:17" /><verse number="18" style="v" sid="1CH 27:18" />Go nlaaga nyi Juda: Elihu mmonannyehn no Devid wo; Go nlaaga nyi Isaka: Omri mmon no nlum no Maekel; <verse eid="1CH 27:18" /><verse number="19" style="v" sid="1CH 27:19" />Go nlaaga nyi Jebulun: Isimayiya mmon no nlum no Obadiya; Go nlaaga nyi Nafitali: Jerimoti mmon no nlum no Ajerel; <verse eid="1CH 27:19" /><verse number="20" style="v" sid="1CH 27:20" />Go alaaga nya anebe Efriim: Hoseya ji mmon no nlum no Ajajia; Go ejang nlaaga nyi Manase: Joel mmon no nlum no Pedaya; <verse eid="1CH 27:20" /><verse number="21" style="v" sid="1CH 27:21" />Go ejang nlaaga nyi Manase go Gileyad: Ido mmon no nlum no Jekariya; Goji Benjamin: Jaasiyel mmon no nlum no Abner; <verse eid="1CH 27:21" /><verse number="22" style="v" sid="1CH 27:22" />go nlaaga nyi Dan: Ajarel mmon no nlum no Jeroham. Ane baa ba jolo atubesi go at'tohngo nya anebe Isreel.<verse eid="1CH 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />Devid fangem aneblum ba ma kang rehng nnya eltahl '20,' afii rede sehnge ano, tibre Jehova ebnyam re á bahke limi Isreel bo rur are alonlo nya li go elbung. <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />Joab mmon no nlum no Jeruaya bomo aneblum go elfange, á fangem mal. Erakatahng ji Esowo gbo tub Isreel go eyaame ji ane afange, fvfo nfange nyio bo kakem go nwer aka nya Ntula Devid.<verse eid="1CH 27:24" /></para>
  <para style="s">Atubesi Abalimeltum Go Elwo Ni Devid</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 27:25" />Ajimaveti mmon no nlum no Adiyel wo jolo ka ntahk nsol akuuru nyi etul. Jonatan mmon no nlum no Ujiya wo jolo ka ntahk nsol akuuru nyi jolo arohko nya nfam ajahbe, a abon ajahbe ba nse go akahmbungubungu ntahk nyi ab'baabe kpo kuumu. <verse eid="1CH 27:25" /><verse number="26" style="v" sid="1CH 27:26" />Ejiri mmon no nlum no Kelub wo jo kpur anebe eltum ba jo bahm ndi. <verse eid="1CH 27:26" /><verse number="27" style="v" sid="1CH 27:27" />Simeyi nnea Rama jolo ka edi egbe agrab. Jabdi nnea Sefam jolo ka akab nti nya jo lohng egbe agrab, nya bo jo ko lim amahm. <verse eid="1CH 27:27" /><verse number="28" style="v" sid="1CH 27:28" />Bal-Hanan nnea Gederi wo jolo ka oliv a sikamo nti afik go erede abangenahb awong. Joasi wo jolo ka akehng oliv alimi fere jo bak. <verse eid="1CH 27:28" /><verse number="29" style="v" sid="1CH 27:29" />Sitrayi nnea Saron wo jolo ka atohkondi aleke go Siharon. Safati mmon no nlum no Adliya wo jolo ka atohkondi aleke go adamme. <verse eid="1CH 27:29" /><verse number="30" style="v" sid="1CH 27:30" />Obil nnea nlaaga nyi Isimayel wo jo kpur akamel. Jedeya nnea Merono wo jo kpur ebvankang. <verse eid="1CH 27:30" /><verse number="31" style="v" sid="1CH 27:31" />Jajiji nnea nlaaga nyi Haga wo jolo ka atohkondi akpuru. Ane baa kpee ba jolo atubesi eltum ka nsol Ntula Devid. <verse eid="1CH 27:31" /><verse number="32" style="v" sid="1CH 27:32" />Jonatan mmonannyehn ndea Devid wo jolo ntubelle, ebangbang nne g'ga, á tob jolo nyonawer. Jehiel mmon no nlum no Hakmoni ye jo kpuru abon ntul ba nlum. <verse eid="1CH 27:32" /><verse number="33" style="v" sid="1CH 27:33" />Ahitofel jolo ntubelle no ntul. Husayi nnea nlaaga nyi Arak jolo nne no ntul jo bum-e go etingitingi. <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" />Jehoada mmon no nlum no Benaya abola Abiata bo ba ko nji nyi Ahitofel. Joab wo jolo ntubesi a nsoja nyi ntul.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s">Ana Devid Toobo Bade Etahk Esowo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />Devid kehm kuku atubesi eltum kpee go Isreel re bo ba kono go Jeusalem: atubesi ba at'tohngo, atubesi ba nlong nyi kpo loko ntul, atubesi ba kpo fili nsoja atahlatahla nku a nku, a ba kpo fili nsoja atahlalon alon. go atubesi ba li ka nsol nlaaga kpee a atohko ndi nya li ka ntul a abon ebe ba nlum, budu atubesi ba ekpasiki, atakuru aneblum kpee ba kpo nok ebta a asahb asahb nsoja. <verse eid="1CH 28:1" /><verse number="2" style="v" sid="1CH 28:2" />Ntula Devid kehm mehle yiimi, kehm bungu re: &lt;&lt;Wuung-m wahn atung, anebe Isreel ebame, ane ebame. Jol-m go eltim re, me n si etahk ana edi rekekv ji elkohl ni nwongo nyi Jehova, go etikunakpade ji Esowo ebahre, fvfo me n toobo ebjing re me n si. <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />Wo, Esowo tong-m re, &lt;Wo sang bahke sehke etahk ka mbing enyame, tibre wo ntakuru nyi, fvfo wob faade alung gbalee.&gt; <verse eid="1CH 28:3" /><verse number="4" style="v" sid="1CH 28:4" />&lt;&lt;Fvfo Jehova Esowo bi Isreel, yehke me egame ebangenahb kpee re, me n jol ntul ka Isreel go njinanjini. Á yehke Juda ana ntubesi, go et'tohngo ji Juda á yehke ebangenahb enyame goji abon ba nlum ba nsoo, owo yeb-e no re, á lim-m me n jol ntul ka Isreel kpee. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />Go abon ebame ba nlum kpee, fvfo Jehova kaam bo gbalee, yeb yehke Solomon mmon ewame re á ji eti nji etul nyi Jehova ka Isreel. <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />Á tong-m rea: &lt;&lt;Solomon mmon ewa no nlum ye wo bahke sehke etahk ejame a nlaaga enyame, tib m me-e yehke re á jol mmon ewame fvfo m bahke jolo nde no ewe. <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />M bahke limi etul ebe yiimi go njinanajini, á l'fere kunu ekpu jo bum nkahn enyame a atahm enyame ana bo kp'limi a ngare nyia.&gt; <verse eid="1CH 28:7" /><verse number="8" style="v" sid="1CH 28:8" />&lt;&lt;Anv n kpa-a rehke go esamahr Isreel kpee a ane ba ma ba kono a, ka Jehova, fvfo go elwuku ni Esowo ebahre kp'wuku: Kunu ekpu wo toono atahm nya Jehova kpee, ye ji li Esowo eba, eji á l'ko nnoobo a ndi nyia, fere yake ka abon eba ana ejum elehkelkv go njinanjini. <verse eid="1CH 28:8" /><verse number="9" style="v" sid="1CH 28:9" />&lt;&lt;Fvfo wo Solomon mmon ewame no nlum kahn Esowo bio bi nso ewa, wo lok-e a eltim eltim kpee, yake elna ka a ntir nyi kpa-a koro re wo lim, tib Jehova wo kpo rab eltim anehng anehng fere kahn ekor ajehng ajehng a ntir anyehng anyehng. A l'seb-e a bahk-e nyehne; wo a l'fere ten-e á bahk-a tob ten go njinanjini. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />Tir anv, tib Jehova ma-a yehke re wo si etahk ana edi ji li saang. Bel atahne wo lim eltum nio.&gt;&gt; <verse eid="1CH 28:10" /><verse number="11" style="v" sid="1CH 28:11" />Owo Devid kehm kake Solomon mmon ewe no nlum ntoobo nyi li bade etahk Esowo go elsehke, akp'kpa nsol akuuru, ero etahk, akp'kpa nya atahng, a Edi ji Sab L'li Saang ji li edi elkoono alimi.<note caller="+" style="f"><char style="fr" closed="false">28:11 </char><char style="ft" closed="false">edi Esowo agohngo</char></note> <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />Á ka-e ntoobo kpee ana Etohko ji li Saang kak-e ege a ntir, ana nlaaga etahk Jehova, a anyo akp'kpa kpee nya bahke jolo sennge kak, edi nsol akuuru etahk Esowo, a edi ji bo bahke kuuru nsol nyi bo ma yake kak Jehova go ebo. <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />Á tubu Solomon elle ana abalimajom bahke yabe a anebe Levi, a eltum kpee ni bo bahke jo loko etahk Jehova, budu fvfo a ajoobo nsol nyi bo bahke jo ko loko eltum. <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />Á gabe ellubu ni agul go agul kpee nya bo bahke limi ajoobo nsol nya bo bahke jo ko loko eltum ajoobo adi, a ellubu ni asilva go asilva kpee nya bo bahke limi ajoobo nsol nyi bo bahke jo ko loko ajoobo nloko, <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />ellubu ni agul nya bo bahke koko agul lim nti anyaale a yefono anyaale, ellubu ni eti ajehng ajehng a anyaale ebo, fvfo ellubu ni asilva go eti enyaale ji asilva a anyaale enye, toono ana enyaale ajehng ajehng bo bahke jo lim a ji, <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />ellubu ni agul nya bo bahke koko lim ekpukuru ajehng ajehng ji ebred ji li saang, ellubu ni asilva nya bo bahke koko lim akpukuru asilva, <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />ellubu ni nyamyam agul nya bo bahke koko lim agbehm atake, akpeeke nya alung akake madde a ntuku, ellubu ni agul nya bo bahke koko lim ngbojok agul anyehng anyehng ellubu ni asilva nya bo bahke lim ngbojok asilva anyehng anyehng, <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />a ellubu ni agul nya bo ma tuungu lim re bo ko lim egudu njom ji bo bahke kake ainsen jo teebe. Á tob ka-e ntoobo bade mmvtv akuungu, ji re, serubim agul nya bahke nyange akpungkpung ebo konngo elkohl ni nwongo nyi Jehova. <verse eid="1CH 28:18" /><verse number="19" style="v" sid="1CH 28:19" />David bungu re,&lt;&lt;Nyaa kpee, M bele go elnyono ana ebo bi Jehova kuumem no, ye wo ma lim re me n ka ntoobo etahk jia go ntooranti.&gt;&gt; <verse eid="1CH 28:19" /><verse number="20" style="v" sid="1CH 28:20" />Devid tongo Solomon mmon ewe no nlum re, &lt;&lt;Bel atahne wo bel esahb lim eltum nia. Ka fahl jol abo ki-a woono tib Jehova Esowo, Esowo ebame li a na. Á wa-a nehm kane, jol á wa-a nehm ten, tete eltum Etahk ni Jehova ji li Saang mal. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />Elyabe ni abalimajom a anabe Levi ebjol kp'siki na eltum kpee ni Etahk Esowo ji li Saang, fvfo nne awohng awohng no kp-e koro, bo ji li anebe agb'gbe bo kak-e ebo go eltum kpee. Atubesi eltum kpee a ane baka jo bum nkahn enya anyehng anyehng.&gt;&gt;<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s">Nsol Nyi Bo Ka Re Bo Ko Si Etahk Esowo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />Owo Ntul a Devid kehm tongo ane kpee ba kono o re, mmon ewame no nlum Solomon, ye ji Esowo me-e yehke, á li mmonjangkun elkahne á ka bel. Eltum kp'gbale, tibre ekpasiki jia limm ka nne li ka Jehova Esowo. <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />Go egame enohk kpee, me n toobo ejum ajehng ajehng bum ka elsehke etahk Esowo ebame, re agul jol ka eltum agul, asilva jol ka eltum asilva, abilekpi jol ka eltum abilekpi, akuungu jol ka eltum akuungu, nti jol ka eltum nti, tob li ano ka atal anisi re bo ko soongo, atal tukwesi, atal nya kpi ajoobo agane, a ajoobo atal kpee go nkohn a nkohn, a elkohn anoobo atal, go atahntahn abare atal, nyaa kpee ebluuku egburu ebim gb'gbal. <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />Nyao l'jo go nkpe, tibre n kaa eltim ename kpe kpe go eltum ni etahk Esowo ebame, go egama nsol, me n ka agul a asilva go etahk Esowo ebame, sehnge ejum ajehng ajehng ji m ma toobo ka etahk jia ji li saang, <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />akilo agul jolo atahltahl nkpel ebal atahlawubu go nkpel atahla alon '100,000' agul nya ofir, a akilo asilva jolo atahltahl nkpel ebal atahlawubu go nkpel atahlawubu budu akilo asilva atahlku '230,000,' nyaa, nya bo bahke koko kpeele akahme etahk jio, <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />li ka eltum agul a eltum asilva, go eltum kpee ni anebe agb'gbe. Anv ane abaa kpi bo kor re, bo yake elbo ka Jehova lela?&gt;&gt; <verse eid="1CH 29:5" /><verse number="6" style="v" sid="1CH 29:6" />Owo atubesi ba abangenahb, atubesi ba at'tohngo nya Isreel, atubesi nsoja ba jo fili nsoja atahl alon alon nkpel ewubu k'kunu, a ba jo fili nsoja atahl alon alon k'kunu, go atubesi ba jolo ka eltum ntul, bo ka go eyebatahng. <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />Bo ka tib esi eltum etahk Esowo, ekilo agul atahltahl nkpel ebal atahlawubu nkpel atahlalon budu atahltahahl atahlawubu a egul atahlabal ewubu, '165,000,' ekilo asilva atahltahl nkpel ebal atahlawubu nkpel atahlku budu esilva atahlku, '330,000,' ekilo abilikpi jolo atahltahl nkpel ebal atahlawubu nkpel atahltahl atahlawubu, '600,000,' a akuungu jolo emilon ekilo ekuungu era budu ekuungu atahltahl nkpel ebal atahlawubu nkpel atahlku, '3,300,000.' <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />Nne awohng awohng no bele atal nya nno ano koo ba ka edi ekuuru nsol etahk Jehova, jolo go abo nya Jehiel nnea Gerson. <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />Koro ane sehng go ellimi ni atubesi ebo limi no, tib bo ka fannge ntim ebo kpee ka Jehova. Devid ji ntul tob bele eyebatahng gbalee.<verse eid="1CH 29:9" /></para>
  <para style="s">Ero Bi Devid Kake No</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />Devid tehke Jehova go esamahr ane kpee ba kono o rea, &lt;&lt;Eltehke jol ka wo, Jehova, Esowo bi nsoo ewahre Isreel, bomo go njinanjini song rehng go njinanjini. <verse eid="1CH 29:10" /><verse number="11" style="v" sid="1CH 29:11" />Jehova, a kp'gbale a nsahm, ellub, agbal, a ekpunu. Ejum ajehng ajehng ji li ejahbetul a ndi, wo wo kpi. Etul b'ba wo Jehova, wo wo bo ma-a mehl wahre ana esi, go nsol kpee. <verse eid="1CH 29:11" /><verse number="12" style="v" sid="1CH 29:12" />Afang a ekpunu lohng go ega; wo wo li n f'fili no ejum ajehng ajehng kpee. Ega abo wo atahne li no a nsahm nyi kpo mehle nne wahre, fvfo kpo ka ane atahne kpee. <verse eid="1CH 29:12" /><verse number="13" style="v" sid="1CH 29:13" />Anv Esowo ebahre, e kpa-a kake saam fere tehk mbing enya nyi kpi ellub. <verse eid="1CH 29:13" /><verse number="14" style="v" sid="1CH 29:14" />&lt;&lt;Wo me elkohn nne woo, fvfo ane abaa li ane ebame, ba bahke ma ka wehr abo ana? Ejum ajehng ajehng lohng go ega, fvfo wahr ebka ji lohng ega ebo. <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />Wahr ajahmjahm nya a ajenne ega ejang, ana babnsoo ewahre tob jol, Afung enyahre a njini li are atohko nti nya, ekunukpu e kpimm. <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />Jehova Esowo ebahre, nsol nyia gbalee nyi e ma toobo re bo ko si etahk ka mbing enya nyi li saang, lohng ega ebo, fvfo nyaa kpee li ka wo. <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />N kp'kahne, Esowo ebame re, wo wo kpo wuungu eltim, kpo yeb-a sehng bade eltim ni li tor tor. Nsol nyia kpee me n ka go eyebatahng a eltim ni li reed. Anv me n nyehn go eyebatahng ana ane eba baa ba li a, ma-a ka a ntim ebo kpee. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />Jehova Esowo bi bab nsoo ewahre, Ebraham, Isak, a Isreel, bum ekor jia go ntim ane eba go njinanjini, fvfo bum ntim ebo rede rede ka elna. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />Fvfo ka Solomon mmon ewame no nlum eltim kpee ni á bahke yake elne ka jo bum nkahn enya, atahm enya, a ntibi jo lim ejum ajehng ajehng jo si ekpasiki etahk jia ji m ma toobo nsol bum.&gt;&gt; <verse eid="1CH 29:19" /><verse number="20" style="v" sid="1CH 29:20" />Owo Devid kehm tongo ane kpee ba kono o re,&lt;&lt;Tehken Jehova Esowo ebahne.&gt;&gt; Owo bo kpee kehm tehke Jehova Esowo bi bab nde ebo, bo gongo ndi tanne elbo ka Jehova a ntul.<verse eid="1CH 29:20" /></para>
  <para style="s">Bo Liingi Solomon Ana Ntul</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />Njahmfungfu bo limi ajom ka Jehova, fere tob lim ajom nya eljahme fi ka-e, efong atahl alon alon edi ebwubu '1,000,' ekom atahl alon alon edi ebwubu '1,000,' a ejoro jolo atahl alon alon edi ebwubu '1'000,' budu ayare nya elwoko, a ajomjom nyako gb'gbal go esi ji anebe Isreel kpee. <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />Bo li fere, w'wo go eyebatahng go esamahr bi Jehova efung bio. Owo bo kehm liingi Solomon mmona Devid no nlum ana ntul etoono nkpele, kak-e akehng go elbohngo ni Jehova re á jol nf'fili, fvfo Jadok jol nlimajom. <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />Ano wo Solmon jii eti etul ji Jehova ana ntul go enyo ji nde Devid. Nobo a ne, Isreel kpee jo wuk-e wuk. <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />Atubesi ntum kpee a atakuru, fvfo budu abon ntula Devid ba nlum kpee rede elbo fere taame re bo bahke woomo Ntula Solomon go elwo. <verse eid="1CH 29:24" /><verse number="25" style="v" sid="1CH 29:25" />Jehova sahb m'mehl Solomon wahre go ejang bi Isreel kpee, fere ka-e ekpunu go ege eti etul ji ntul awohng awohng go Isreel kala b'bel.<verse eid="1CH 29:25" /></para>
  <para style="s">Elkv Ni Devid</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />Devid mmona Jese no nlum jolo ntul ka Isreel kpee. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />Á fili Isreel go nnya atahlabal '40,' nnya esehma '7' go Hebron fvfo eltahl a nnya ewubu a nnya era '33' go Jeusalem. <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />Á kpoo go nnoobo ekul bi nno, á bele nlaabe elkpin ni nsol nobo a ne, afang a ekpunu. Solomon mmon ewe no nlum wo woongo asi enye ana ntul. <verse eid="1CH 29:28" /><verse number="29" style="v" sid="1CH 29:29" />Nsol nyi limi no ngare efili ane ji ntul a Devid, bomo mbomannahb tete rehng elkohro, bo nyono kak awer nya Samwel ny'yehne, awer nya Natan nnyehnamahr a awer nya Gad ji ny'yehne, <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />budu efili ane eje go ntooranti a nsahm, go ajahkjahk nsol nya jolo senng-e kak a Isreel go etul kpee bi ajahbe nyako.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>