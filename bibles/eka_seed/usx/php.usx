<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Ekajuk New Testament</book>
  <para style="h">Filipai</para>
  <para style="toc1">Filipai</para>
  <para style="toc2">Fil</para>
  <para style="mt2">NWER NYI POL NYONO TV</para>
  <para style="mt2">ANEB ERO BA LI GO</para>
  <para style="mt1">FILIPAI</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="nb">
    <verse number="1" style="v" sid="PHP 1:1" />Me Pol, a Timoti, wahr ji li alokeltum ba Kraist Jisos, e kpꞌnyono nwer nyia tv aneb Esowo, a atubesi ero, a alokeltum ero ba li go Filipai, ba ma taame tv Kraist Jisos.<verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />Nong, Esowo Nso ejahre, a Ntul a Jisos Kraist ka-n nnoobo, a elkoono.<verse eid="PHP 1:2" /></para>
  <para style="s">Ana Pol jo kak ero ka aneb ero</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />N kpo kak Esowo ebame saam ngare anyehng anyehng nyi n lꞌbuum-n.<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Rom 1:8</char></note> <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />Ero abehng abehng bi n kpo kak ka wahn ane kpee, n kpo kak go eyebatahng, <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />a saam akake tib go ebo bi ń jo kak-m go nnoobo etib atiingi bomo ngbokambang efung tete ba rehng lela.<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">Fil 4:15-16</char></note> <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />N kpꞌsahb kꞌkahn re, Esowo bi bomo nnoobo eltum alimi go egahne atahng, á bahke gohro lim, gohro song mal efung bio bi Jisos Kraist.<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Fil 2:13; 1 Kor 1:4-9</char></note><verse eid="PHP 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 1:7" />Fꞌfuumu re me n jo tiir-n ana, wahn ane kpee, tibre ń wob-m go eltim. Tibre wahn ebtob bel nnoobo nyi Esowo ana nyi me m ma bel, ń kp-m kake ebo, eji n wob ngbekobo,<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">Fil 1:13</char></note> ń tob kak-m ebo ngare nyi n yiimi nnoobo etib njahm, fere jo nok, eji lꞌyiimi. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />Esowo bi li ntianse enyame. Ye wo kpꞌkahne elkoro ni ń kp-m koro re me n nyehn-n, elkoro nio ni lohng go eltim ni Kraist Jisos.<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />N kpꞌkake ero re, elkoro enahne jo gbal na asongo asongo, wahn fere bel elkahne budu, a ngbere, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />nyi ḿ bahke ma jo liingi nsol nyi ga nob,<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">Rom 12:2; Hib 5:13-14</char></note> eji ń lꞌjol saang, kꞌbel ebi ajehng ajehng efung bio bi Kraist, <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />fere bel akab gbalee, nya lohng go egahne etingitingi elkpin, nya Jisos Kraist kpo wahng kehm kabe, eji Esowo lꞌbel ellub, bo fere jo tehk-e.<verse eid="PHP 1:11" /></para>
  <para style="s">Kraist wo li elkpin ename</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />Abonanee, n kpꞌsebe re wahn kahn re, jia ji ma-m lim a, ebkak ebo, alum Esowo ebkpe nyange rehng esꞌsong. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />Abꞌbaabe ba etahk ntubesi, a egom ane bako kpee ebkahn re, n wob ngbekobo tib go esi ji Kraist.<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">2 Tim 2:9</char></note> <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />Abonanee bandiki gbalee ebbel esahb go eltoono ni bo kpꞌtoono Jisos, tib eji n wob go ngbekobo. Bobkpe bel esahb gbalee budu go alum Esowo abungu, kꞌfahl.<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">Elt 4:17,29</char></note><verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />Etingitingi, ane bandiki kpo bung alum nya Kraist tib eteelala, a ntaange ataange. Wo, ane bandiki kpo bung a ntir atahng nyi nno. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />Bo ba kpo bung go elkoro. Bo kpꞌkahne re, n wob ana, eji n lꞌyiimi nnoobo etib njahm. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />Ane bako kpehme bung alum nya Kraist a ntir atahng nyi nno. Bo kpo ra na etul,<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">Mak 9:35</char></note> eji bo lꞌbud-m erem go ngbekobo nyi n wob no.<verse eid="PHP 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18" />Jol m-e nehme lub. Atahng kp-m yebe, eji ane kpꞌwuku bada Kraist go mbang anyehng anyehng, afi ane bandiki bungu alum Esowo go mbang awak, afi bo fere bungu go etingitingi. <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />M bahke soro na asi, jo bel eyebatahng. Tibre n kpꞌkahne re, nsol nyia bahke kpiidi, fere jol eltahre ename,<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">2 Kor 4:17</char></note> tib go egahne ero bi ń kpꞌkake, a ekakebo ji etohko ji Jisos Kraist.<verse eid="PHP 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PHP 1:20" />Jo jol-m go eltim gbalee, n fere jo kunu ekpu re, ejum ajehng ajehng kꞌjol ji bahke wahnge bo rik-m ndon, eji n lꞌjol esahb esahb ngare anyehng anyehng, Kraist fere kpe bel na ellub go egama ngubjing, afi n li go elkpin, afi n kpo na.<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">1 Pit 4:16</char></note> <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />Anv, ejum aji li li elkpin? Egame, elkpin ni n li a ni a, Kraist wo. Afi n kpo na, nsehng nyia.<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">1 Kor 15:55</char></note> <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />N lꞌjol go elkpin ni ngubjing, n kpꞌkpi eyake ji m bahke ma lim eltum ka Esowo ni kpi nsehng. Owo wahnge n kil kahne ji m bahke yꞌyehke.<verse eid="PHP 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 1:23" />Me n sa ayaame mbang. Ji kp-m sahb kꞌkor li re, me n tahm song jol a Kraist. Tibre ano wo ga nob. <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />Tib go egahne esi, ga li re me n jol ana go elkpin.<note caller="+" style="f"><char style="fr" closed="false">1:24 </char><char style="ft" closed="false">Rom 1:11</char></note> <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />Eji m ma sahb kꞌkahn ano, n kpꞌtob kahn re, m bahke jolo ana go elkpin, fere soro asi a nahne, eji ń lꞌgbal, fere bel eyebatahng go mbang nyi ń kpꞌtoono Esowo. <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />Elgeere ni ḿ bahke geere kak-m go esamahr bi Kraist bahke gbale sehng ngare nyi n lꞌkpe feere ba go egahne.<verse eid="PHP 1:26" /></para>
  <para style="s">Ana e bahke noko ka Kraist</para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />Nong, eljini enahne fuumu a nnoobo etib bi Kraist,<note caller="+" style="f"><char style="fr" closed="false">1:27 </char><char style="ft" closed="false">1 Tes 2:12</char></note> eji afi m ba na, ba nyehn-n, afi m maam ba, n lꞌwuk re, wahn baa, yim tꞌtahne go etohko na ajehng, fere kpꞌnoko a eltim anehng ka eltibi ni nnoobo etib bi e kpꞌtaame tv. <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />Kana jo fahl anebekv ebahne go mbang anyehng anyehng.<note caller="+" style="f"><char style="fr" closed="false">1:28 </char><char style="ft" closed="false">Elt 18:9</char></note> Tibre jia ji bahke tibi ana bo bahke rannge, wahn fere bel eltahre ni lohng goji Esowo.<note caller="+" style="f"><char style="fr" closed="false">1:28 </char><char style="ft" closed="false">2 Tes 1:4-10</char></note> <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />Tibre Esowo ebyake eltum ni ḿ bahke jo loko Kraist ka-n, ni li re wahn taame tv-e, fere tob jo nyehn erem tib go ege esi, <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />fere jo nok ebta bꞌnehm bi ń nyehne go egame, a bi ḿ ma wuk anv bada name.<note caller="+" style="f"><char style="fr" closed="false">1:30 </char><char style="ft" closed="false">Elt 28:16-20</char></note><verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">Elrede ni Kraist rede elne, a agbal enye</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />Eji ń kpo rehke atemtem go mbang nyi Kraist, elkoro ene fere jo kak-n eltim, n fere jo jen a Etingi Etohko, fere bel elkoro, a ndon, <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />gohren lim, eji atahng lꞌsahb yeb-m yebe. Belen elkohn ntir atahng nyꞌnehm na anyehng, a elkoro nꞌnehm, a eltim na anehng, wahn fere jol ntir ntir nya anyehng.<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">Ef 4:3-6</char></note> <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />Kana jo ra etul, fere jo geere mbol mbol. Ga nob re, wahn jo rede elnahne, fere jo rod ane bako bum ana ane ba ga nob sehnge wahn.<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">Rom 12:10</char></note> <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />Nong, nne awohng awohng kꞌjo tiiri elne wo wo, á tob jo tiiri ane bako fvfo.<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">1 Kor 10:24,33</char></note><verse eid="PHP 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 2:5" />Belen ntir atahng ana nyio nyi Kraist Jisos,<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />ye ji jolo go ellub ni Esowo.<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">Jon 1:2; 17:5</char></note></para>
  <para style="q1" vid="PHP 2:6">Á rodem eljolo ni á ma jol jang jang a Esowo bum ana ejum ji bahke jolo ka yefono antahng.<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />Á yake ajehng ajehng kpee bum, fere taame, jol nlokeltum, fere ba jol go elfoongo ni nne.<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">2 Kor 8:9</char></note><verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />Eji á jolo nne, á kpe rede elne, fere jo wuk nde tete rehng go elkv, esabsab elkv ni á kpo go ekros.<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">Hib 5:8; 12:2</char></note><verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />Owo fvfo, Esowo kehm-e sahb mꞌmehl wahre, fere ka-e mbing nyi gbale sehnge mbing anyehng anyehng,<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">Luk 14:7-11</char></note><verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />eji nne awohng awohng no li ejahbetul Esowo, a njini, a atahng ndi lꞌjamme alahng enye, fere jo kak mbing nyi Jisos,<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />fere jo bung go ege a nnyo re, Jisos Kraist wo li Ntul, fere jo ka Esowo Nsoo ellub.<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">Ell 5:13</char></note><verse eid="PHP 2:11" /></para>
  <para style="s">Jo yaan ana atꞌrekahng go njini</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />Akpondahme enyame, ana ń jo wuk-m ngare anyehng anyehng eji n jolo a nahne, anv, eji n ki kpe li a nahne wo ga nob re, wahn jo ga-m wuk. Noken go elfahle, a akahb akahme, eji ń lꞌgohro bel eltahre enahne.<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">1 Pit 1:17</char></note> <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />Tibre Esowo kpi nlimi nlimi eltum go egahne atahng, eji mbang enye lꞌjo kor-n, ń fere jo wuk-e, fere jo lim ji á kpꞌsebe re wahn lim.<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">Jon 15:5; 2 Kor 3:5</char></note><verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />Ejum ajehng ajehng ji ń lꞌjo lim, kana jo lim go elmemme, a nfaabe alimi, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />eji ń lꞌjol saang, nnene ki-n ka ebi, wahn fere jol abon Esowo ba ki kpi elem ajehng ajehng eji ń lene go njini nyi ma bvvrv, fere gbal abꞌbi abꞌbi. Jo yaan ana atꞌrekahng go njini nyia,<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">Mat 5:14; Ef 5:8</char></note> <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />wahn fere jabbe alum nya elkpin tꞌtahne, eji n lꞌjo geere efung bio bi Kraist, ana nne no ki be abahl mbol mbol, fere bade, jo lim eltum mbol mbol.<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">1 Tes 3:5</char></note> <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />Lꞌfere jol re bo bahk-m rodo, yaange ana alahb njom wohng go ejum njom,<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">2 Tim 4:6</char></note> ji li elloko ni ń kpꞌloko Esowo bi ḿ ma taame tv-e, n kpꞌgeere, fere bel eyebatahng a nahne. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />Ano wo fvfo ḿ bahke tob bel eyebatahng, fere tob-m elgeere.<verse eid="PHP 2:18" /></para>
  <para style="s">Timoti abola Epafroditus</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />N kpꞌbumu Ntul a Jisos go etingitingi re m bahke gulu eltumu Timoti tv-n, eji n lꞌwuk bade ana ń li no, fere rede av.<verse eid="PHP 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PHP 2:20" />Nnene n kpeem kpi ana ye, no kpo sahb tiir-n tiiri. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />Ane bako kpee kpo ga kunu ekpu go bo a nsol. Bo kpehme ga kunu ekpu go nsol nyi Jisos Kraist.<note caller="+" style="f"><char style="fr" closed="false">2:21 </char><char style="ft" closed="false">2 Tim 4:16</char></note> <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />Wo Timoti, ń kp-e kahne re, á kpꞌtibi eljini ni nno. Ń kpꞌkahne ana á ma jol ana mmon ewame no bo jo kod abo ano abola nde, jo loko Esowo eji e jo tiingi nnoobo etib.<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">1 Tim 1:2</char></note> <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />N kpꞌbumu re me n tum-e, n lꞌsoro kꞌkahn ji bahke jolo a name.<verse eid="PHP 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PHP 2:24" />N kpꞌbumu Jehova go etingitingi re, mefono bahke tob gulu elbake.<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false">Fil 1:25</char></note> <verse eid="PHP 2:24" /><verse number="25" style="v" sid="PHP 2:25" />N tiri re, nꞌnob re me n tum mmonanne Epafroditus tv-n, ye ji e kpꞌlimi eltum a ne ano. Á tob li nne a nsoja no Kraist ana me. Ye wo li nne no ń tum-e re, á ba kak-m ebo.<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="ft" closed="false">Fil 4:18</char></note> <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />Á kpꞌsahb sꞌseb re á nyehn-n wahn ane kpee. Ndon gbal-e go eltim sehng tib eji ń wuku re, á jo yꞌyam. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />Etingitingi, á yame sehng, jol kehn á kpo. Á fili Esowo ndon, jol ye ye sang, me fvfo, eji n lꞌkꞌjo jol ndon ndon.<verse eid="PHP 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PHP 2:28" />Owo wahnge sahb li-m li re me n tum-e, eji ń lꞌkpe-e nyehn, fere bel eyebatahng, kꞌkpe ga jol ndon ndon. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />Koon ye go eyebatahng ana nne no Jehova tumu no. Jo kaken elkohn ane ana bao. <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />Tibre sa ntiil á kpo, tib go eltum ni Kraist. Á taame elkv, eji á lꞌgohr-m loko eltum ni ń kil-m elkpe ma loko, tib eji ń li fee.<note caller="+" style="f"><char style="fr" closed="false">2:30 </char><char style="ft" closed="false">Fai 13</char></note><verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">Ana Pol bungu bade elne</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />Abonanee, ji n yahke gohro bung li re, wahn bel eyebatahng go ejang bi Jehova. M-e nehme kpen re me n jo nyon nsol nyꞌnehm tv-n. Tibre nya nya bahk-n limi, ń lohko kahn.<verse eid="PHP 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 3:2" />Jo gberen ebv,<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">Mat 7:6</char></note> wahn fere jo gbere abꞌbi abalimeltum, a ane ba kpo fang agubjing ebo alok.<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">Gal 2:12</char></note> <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />Tibre wahr ba li ane ba ma yehke etingitingi nrur, wahr ji kpꞌkake Esowo go etohko,<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">Jon 4:24</char></note> fere jo geere kak Kraist Jisos. Wahr kpehme bum re, Esowo bahke koko nne tib go nsol nyi á limi go ege a ngubjing. <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />Fvfo, nsol nyia, nyi kehn jol tob wahng n tob tir ano. Nne awohng awohng no lꞌtir re, Esowo bahk-e koko tib go nsol nyi li ka ngubjing, me wo ga kpi sehng-e. <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />Bo yehk-m nrur, eji m ma kang nfung enehkeni. Me nne Israel wo. N lohng go etꞌtohngo ji Benjamin. Me nne a Hibru wo dahb dahb dahb. Babnsoo, anebe Hibru ba. Bade eyaame ji atahm abumu, me nne a Farisi wo.<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">Elt 26:5</char></note> <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />N jo kake ekpuku go eltum Esowo, eji n jo nohk aneb ero. Bade eyaame ji nne bahke lehke eno go esamahr bi Esowo tib eji á kpi atahm bum, n jolo nne no bo ki-m jo ma ka ebi ajehng ajehng.<verse eid="PHP 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 3:7" />Nsol nyi n jo tir re m bahke lehke nsehng, me n fere rod bum ana nsol nyi ki lohng ejumjum tib go esi ji Kraist. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />Etingitingi, n kpꞌrodo ejum ajehng ajehng ana ejum ji ki lohng ejumjum tib go elkahne ni n kpꞌkahne Kraist Jisos Ntul ewame, ni ga gbal sehnge ejum ajehng ajehng. Esi eje ji wahnge m ma ro ejum ajehng ajehng go, fere rod bum ana nkahr, eji n lꞌli nsehng nyio nyi li Kraist,<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">Mat 19:27-29</char></note> <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />fere jol ajehng a ne, kꞌjol nne no ma li eno jꞌje antahng. Anv, me n li eno go esamahr Esowo, ji nne bahke lehke á lꞌtaame tv Kraist, elkohn eno ji kpo lohng goji Esowo, ji ane ba kpꞌtaame tv-e bahke lehke,<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">Rom 3:20-22</char></note> <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />eji n lꞌkahn Kraist, fere kahn nsahm nyi nyahm-e go elkv,<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">Rom 6:5-6</char></note> fere tob nyehn erem ebe, fere tob jol ana ye go ege elkv ni á kpo no,<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">2 Kor 4:10</char></note> <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />eji limi limi kan, n lꞌtob nyahme go elkv.<verse eid="PHP 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />Lohngem re me n si bꞌbel.<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">1 Jon 3:2</char></note> Lohngem re me n si jꞌjol go nseenga nseenge. N kpꞌsoro asi, jo nyennge, eji lꞌjol jꞌjame. Tibre Kraist ma-m ko, lim jꞌje.<verse eid="PHP 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PHP 3:13" />Abonanee, n nehme rod elname bum ana nne no ma lohko bel. Fvfo, ejum ajehng jia, ji n kpꞌlimi. Me n yini ekpu go nsol nyi wuku wuku n jo lim. Me n tanne abahl fi re me n song bel nsol nyi li go esꞌsong. <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />Ano wo wahnge n kpꞌbeke asongo go edi ji bo tibi tv, eji n lꞌbel eltuuru ni li elkpin ni e bahke bele go ero, ni wahnge Esowo lung-r no, ni li goji Kraist Jisos.<verse eid="PHP 3:14" /></para>
  <para style="s">Leemen eljini ename</para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />Nong, ane kpee ba li go nseenga nseenge bel ntir nyia.<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">1 Kor 2:6</char></note> Ń lꞌfere tir ntir nyindikandiki, Esowo bahke tob lennge ejum jia ka-n. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />Afi jolo elkohn ejum aji, nong, wahr soren asi, jo toono mbang nyi wuku wuku e bomo eltoono tete ba rehng anv.<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">Gal 6:16</char></note><verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />Abonanee, leemen eljini ename, wahn jo kunu ane ba kpꞌtob jen ano ekpu, jang jang ana e ma-n tib mbang nyi ḿ bahke jo toono.<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">1 Kor 11:1</char></note><verse eid="PHP 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 3:18" />M ma-n tohko tong nkpel a nkpele, anv, n kp-n kpeke tong a abonngo go amahr re, ane gbalee kpꞌjene ana anebekv bao ba ekros ji Kraist. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />Esꞌkohlo ebo bahke jolo elrannge. Nsol alehke ebo nyi li Esowo ebo.<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">Rom 16:18</char></note> Nsol nyi kehn jol jo fili bo ndon, nyi nyi bo kpꞌfere geere kak. Bobyehke ekunukpu ebo, kunu go nsol nyi njini nyia.<verse eid="PHP 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PHP 3:20" />Wahr ba li afono ejahbetul Esowo, edi jio ji Ntul a Jisos Kraist ntꞌtahre ewahre bahke lohngo ba, ye jio ji e kp-e siki,<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">Hib 11:10</char></note> <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />ye ji bahke koko nsahm enye yaange agubjing enyahre nya li rede rede, fere jol ana ngubjing enye nyi kpi ellub.<note caller="+" style="f"><char style="fr" closed="false">3:21 </char><char style="ft" closed="false">1 Kor 15:51</char></note> Nsahm enye nyi bahke wahnge á mal lim nsol kpee woom-e go elwo.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">Esꞌkohro erehke</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />Fvfo, abonanee, wahn ji kpo kor-m, wahn ba n jo seb re me n nyehn-n, wahn ba li eyebatahng ejame, a ekpasi etul ejame. Akpondahme enyame, yiimen tꞌtahne go mbang nyi Ntul.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />N kpꞌrehke Eyodia, a Sintike re bo jol go ntir anyehng ana abonanyehn nne go ejang bi Esowo.<verse eid="PHP 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 4:3" />Sisigus, nkakesehk a nte ewame, n kp-a gboongo re, wo lub kak bo ebo. Tibre bo jo noko, jo tob-m eltum nio ni nnoobo etib, a Klement fvfo, a ane bako ba e jo tob lim eltum ano a bo, ba abing ebo wob go nwer nyi elkpin.<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">Luk 10:20; Ell 20:15</char></note> <verse eid="PHP 4:3" /><verse number="4" style="v" sid="PHP 4:4" />Jo belen eyebatahng ngare anyehng anyehng, tib eji ń li ajehng a Jehova. N kpꞌkpeke bung re wahn bel eyebatahng. <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />Nong, nne awohng awohng kahn nnaange eljini enahne. Tibre Ntul a Jisos ebkabbe kpidi kpidi. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />Kana jo tiiri ejum ajehng ajehng.<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Mat 6:25-34</char></note> Ejum ajehng ajehng ji ń lꞌkehm sebe, jo limen Esowo, á kahn, eji ń kpꞌkake ero, fere jo gboong-e a saam akake.<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">1 Pit 5:7</char></note><verse eid="PHP 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 4:7" />Ń lꞌlim ano, owo elkoono ni Esowo ni gbale sehnge elkahne anehng anehng bahke jo baabe ntim enyahne, a ntir atahng enyahne, eji ń li ajehng a Kraist Jisos.<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">Jon 14:27; Kol 3:15</char></note><verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />Abonanee, alum nya a, nya ma-m gohro sa, nya m bahke gohro bung. Jo tiren bade ejum ajehng ajehng ji li go etingitingi, ji kpi ekpunu, ji li nseenge, ji li saang, ji kpi ano, ji kpi elgahm ni nno, ji kpꞌnobo, a ji ane kpo tehk.<verse eid="PHP 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 4:9" />Jo limen ejum ajehng ajehng ji ń kpili go egame, a ji ḿ bele go egame. Jo limen ajehng ajehng ji ḿ ma wuk, fere nyehn go egame. Owo Esowo bi elkoono bahke jolo a nahne.<verse eid="PHP 4:9" /></para>
  <para style="s">Ana Pol kake anebe Filipai saam</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />Eltim kp-m yebe gbalee go ejang bi Jehova. Tib eji ma kang gbalee, anv, ma-n kpe melle re wahn jo tiir-m. Jia lohngem re, me ń kpeem jo tiiri, sehngem eyake ji ń ki bel.<verse eid="PHP 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PHP 4:11" />N nehme bung alum nyaa tib eji nsol ma-m lehng. N kpili re, afi n jolo elkohn ani, ebnob a name.<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">1 Tim 6:6</char></note> <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />N kpꞌkahne ana kpo jol, nsol lꞌlehng-m, fere kahn ana kpo jol, n lꞌbel gbalee. Me n kpili re, ejum ajehng ajehng ebnob a name, afi n wohngo na, afi n li a njal, afi m bele gbalee, afi lehng-m na. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />M bahke ma yiimi go elkohn ejum ajehng ajehng ji lꞌba a name, tibre Kraist wo kpo kak-m eko.<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">2 Kor 12:10</char></note><verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />Ń limi nob nob, eji ń kak-m ebo go egame afemfem. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />Wahn anebe Filipai, wahnfono antahng kpꞌkahne re, go mbomannahb, eji m bomo nnoobo etib go eltiingi, ngare nyi n tahme o Masedonia, ero abehng abehng jolem bi tob ka-m ejum ana bo bele go egame, sehngem wahn ba ba ka-m no.<note caller="+" style="f"><char style="fr" closed="false">4:15 </char><char style="ft" closed="false">2 Kor 11:9</char></note><verse eid="PHP 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PHP 4:16" />Eji n jolo go Tesalonaika, ń tumu akpohko tv-m, ń kpe bulu, kpe tum tv-m, jo kak-m ebo.<verse eid="PHP 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 4:17" />Lohngem re ayare nya n kpꞌsebe. N kpꞌsebe re me n nyehn akab, eji eltuuru enahne lꞌkpe gbal budu.<verse eid="PHP 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 4:18" />Me m bel nsol kpee, nsol ma-m tv. Ejumjum limm, ji ma-m kpe rin, eji Epafroditus ma ko ayare nya ń tumu no tv-m ba ka-m,<note caller="+" style="f"><char style="fr" closed="false">4:18 </char><char style="ft" closed="false">Fil 2:25</char></note> nya li ana ayare nya kpo v Esowo eleenge, nya li ana ejum njom ji kpo kor Esowo, á fere ko.<verse eid="PHP 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 4:19" />Esowo ebame bi kpi afang go ege ellub, nya li goji Kraist Jisos bahk-n kake ejum ajehng ajehng ji ma-n rin. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />Nong, ellub jol ka Esowo Nso ejahre go njinanjini. Emen.<verse eid="PHP 4:20" /></para>
  <para style="s">Nnyo akake</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />Kaken nne Esowo awohng awohng nnyo, no li ka Kraist Jisos.</para>
  <para style="p" vid="PHP 4:21">Abonanee ba li a name kp-n tob kak nnyo. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />Aneb Esowo kpee kp-n kake nnyo, asehngesehnge ane ba li go etahk ntul a Rom.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />Nong, nnoobo nyi Ntul a Jisos Kraist jol a atohko enyahne, wahn ane kpee.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>