<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Adele Old Testament</book>
  <para style="h">1 Ɩya-ɩya</para>
  <para style="toc1">1 Ɩya-ɩya yaade yɩɩ gɩkpa-gyangbasɛlɛ</para>
  <para style="toc2">1 Ɩya-ɩya Yaade</para>
  <para style="toc3">1Ɩya</para>
  <para style="mt1">Ɩya-ɩya yaade yɩɩ gɩkpa-gyangbasɛlɛ</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s1">1 Akukuba-de ye Adam wɔya ma sere Abraham wɔya</para>
  <para style="s2">Nowa bebi-teni</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1" />Adam wobi n di Seti,</para>
  <para style="li2" vid="1CH 1:1">Seti wobi n di Enosi, Enosi wobi n di Kenan,<verse eid="1CH 1:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2" />Kenan wobi n di Mahalaleli,</para>
  <para style="li2" vid="1CH 1:2">Mahalaleli wobi n di Yaredi.<verse eid="1CH 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3" />Yaredi wobi n di Enoki, Enoki wobi n di Metusela, Metusela wobi n di Lameki, gɛ Lameki wobi n di Nowa.<verse eid="1CH 1:3" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="4" style="v" sid="1CH 1:4" />Nowa bebi-teni n di</para>
  <para style="li2" vid="1CH 1:4">Sem, ma Ham, ma Yafeti.<verse eid="1CH 1:4" /></para>
  <para style="s2">Yafeti wodu waanɩ wuu bebi</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5" />Yafeti bebi-teni n di</para>
  <para style="li2" vid="1CH 1:5">Gomeri, ma Magogi, ma Madayi, ma Yafan, ma Tubali, ma Meseki, ma Tirasi.<verse eid="1CH 1:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="1CH 1:6" />Gomeri bebi-teni n di</para>
  <para style="li2" vid="1CH 1:6">Asikenasi, ma Rifati, ma Togarima.<verse eid="1CH 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7" />Yafan bebi-teni n di</para>
  <para style="li2" vid="1CH 1:7">Elisa, ma Tarisisi, ma Kitim, ma Rodanim.<verse eid="1CH 1:7" /></para>
  <para style="s2">Ham bɛnɩ</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8" />Ham bebi-teni n di</para>
  <para style="li2" vid="1CH 1:8">Kusi, ma Egyipiti, ma Libiya, ma Kanaan.<verse eid="1CH 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9" />Kusi bebi-teni n di</para>
  <para style="li2" vid="1CH 1:9">Seba, ma Hafila, ma Sabita, ma Raama, ma Sabiteka.</para>
  <para style="li1" vid="1CH 1:9">Raama bebi-teni n di</para>
  <para style="li2" vid="1CH 1:9">Siheba ma Dedan.<verse eid="1CH 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10" />Kusi wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 1:10">Nimirodi gɛtɛ ɛ bɛ dan ɛ mɛ bɩtà bʋʋtàlɛ gbaa gɛtʋnkwaa gii koro fɔ.<verse eid="1CH 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11" />Egyipiti wodu wʋʋ bɛnɩ n di Ludi bete, ma Anam bete, ma Lehabi bete, ma Nafituhi bete, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />ma Paturusi bete, ma Kasiluhi bete, gɛtɛ Filisiti bete be ye baanɩ fɔ, ma Kafitori bete.<verse eid="1CH 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13" />Kanaan wo bebi n di</para>
  <para style="li2" vid="1CH 1:13">Sidon gɛtɛ è di wobi-gyangbasɛ, ma Hiti bete, <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />ma Yebusi bete, ma Amori bete, ma Girigasi bete, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />ma Hiwi bete, ma Ariki bete, ma Sini bete, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />ma Arifadi, Semari bete, ma Hamati bete.<verse eid="1CH 1:16" /></para>
  <para style="s2">Semi wodu wuu bebi</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17" />Sem bebi-teni n di</para>
  <para style="li2" vid="1CH 1:17">Elam, ma Asuri, ma Arifakisadi, ma Ludi, ma Aram.</para>
  <para style="li1" vid="1CH 1:17">Aram bebi-teni n di</para>
  <para style="li2" vid="1CH 1:17">Wusi, ma Huli, ma Geteri, ma Meseki.<verse eid="1CH 1:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18" />Arifakisadi wobi n di Sela,</para>
  <para style="li2" vid="1CH 1:18">gɛ Sela wobi n di Eberi.<verse eid="1CH 1:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19" />Fɔ Eberi ɛ̀ ba bebi-teni bɛnyɔɔ. Ɛkɩ diyere n di Pelegi<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">Pelegi gɛtɛ wuu wùlà alɛ geyo</char></note>, yema waanɩ gɛ gɛtʋnkwaa gi yo fɔ. Wɔdɩrɛ diyere n di Yokitan.<verse eid="1CH 1:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20" />Yokitan bebi-teni n di</para>
  <para style="li2" vid="1CH 1:20">Alimodadi, ma Selefu, ma Hasarimafeti, ma Yera, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />ma Hadoram, ma Usali, ma Dikila, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />ma Obali, ma Abimayeli, ma Seeba, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />ma Ofiri, ma Hafila, ma Yobabi. Ɛbɛ powu bè di gɛ wodu wuu bebi.<verse eid="1CH 1:23" /></para>
  <para style="b" />
  <para style="li2">
    <verse number="24" style="v" sid="1CH 1:24" />Sem, ma Arifakadi, ma Sela,<verse eid="1CH 1:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 1:25" />ma Eberi, ma Pelegi, ma Rewu,<verse eid="1CH 1:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 1:26" />ma Serugi, ma Nahori, ma Tera,<verse eid="1CH 1:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="1CH 1:27" />ma Abram, gɛtɛ bɛ bɛ sa diyere alɛ Abraham fɔ.<verse eid="1CH 1:27" /></para>
  <para style="s1">Abraham wodu wʋʋ bɛnɩ</para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 1:28" />Abraham wodu wʋʋ bebi-teni n di</para>
  <para style="li2" vid="1CH 1:28">Isaki ma Isimayeli.<verse eid="1CH 1:28" /></para>
  <para style="s2">Haga wodu wʋʋ bɛnɩ</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29" />Isimayeli bebi n di</para>
  <para style="li2" vid="1CH 1:29">Nebayoti gɛtɛ ɛwɔ n di Isimayeli wobi-gyangbasɛlɛ, ma Kedari, ma Adibeyeli, ma Mibisam, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />ma Misima, ma Duma, ma Masa, ma Hadadi, ma Tema, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />ma Yeturi, ma Yefisi, ma Kedema. Ɛbɛ nyabɛ n di Isimayeli wodu wʋʋ bɛnɩ fɔ.<verse eid="1CH 1:31" /></para>
  <para style="s2">Ketura wodu wʋʋ bɛnɩ</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32" />Bebi-teni gɛtɛ Ketura e wo ɛ tɛ Abraham fɔ n di</para>
  <para style="li2" vid="1CH 1:32">Simiran, ma Yokisan, ma Medan, ma Midiyan, ma Isibaki, ma Suwan.</para>
  <para style="li1" vid="1CH 1:32">Yokisan bebi n di</para>
  <para style="li2" vid="1CH 1:32">Seeba ma Dedan.<verse eid="1CH 1:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33" />Midiyan bebi-teni n di</para>
  <para style="li2" vid="1CH 1:33">Eyifa, ma Eferi, ma Hanoki, ma Abida, ma Elidaa.</para>
  <para style="li1" vid="1CH 1:33">Nyabɛ powu bè di gɛ Ketura wodu wuu bebi.<verse eid="1CH 1:33" /></para>
  <para style="s2">Sara wodu wʋʋ bɛnɩ</para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 1:34" />Abraham wobi n di Isaki.</para>
  <para style="li1" vid="1CH 1:34">Isaki bebi n di</para>
  <para style="li2" vid="1CH 1:34">Esawu ma Isareli.<verse eid="1CH 1:34" /></para>
  <para style="s1">Esawu bebi-teni</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35" />Esawu bebi-teni n di</para>
  <para style="li2" vid="1CH 1:35">Elifasi, ma Rewuyeli, ma Yewusi, ma Yalam, ma Kora.<verse eid="1CH 1:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36" />Elifasi bebi-teni n di</para>
  <para style="li2" vid="1CH 1:36">Teman, ma Omari, ma Sefo, ma Gatam, ma Kenasi,</para>
  <para style="li2" vid="1CH 1:36">ma Amaleki, gɛtɛ wɔna n di Timina fɔ.<verse eid="1CH 1:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37" />Rewuyeli bebi-teni n di</para>
  <para style="li2" vid="1CH 1:37">Nahati, ma Sera, ma Sama, ma Misa.<verse eid="1CH 1:37" /></para>
  <para style="s2">Seyiri bɛnɩ gɛtɛ bɛ sara Edom fɔ</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38" />Seyiri bebi-teni n di</para>
  <para style="li2" vid="1CH 1:38">Lotan, ma Sobali, ma Sibeyon, ma Anahi, ma Dison, ma Eseri, ma Disan.<verse eid="1CH 1:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39" />Lotan bebi-teni n di</para>
  <para style="li2" vid="1CH 1:39">Hori ma Homam. Gɛ Timina è di Lotan wonosobi.<verse eid="1CH 1:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40" />Sobali bebi-teni n di</para>
  <para style="li2" vid="1CH 1:40">Alifan, ma Manahati, ma Ebali, ma Sefo, ma Onam.</para>
  <para style="li1" vid="1CH 1:40">Sibeyon bebi-teni n di</para>
  <para style="li2" vid="1CH 1:40">Ayiya ma Anahi.<verse eid="1CH 1:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41" />Anahi wobi-teni n di</para>
  <para style="li2" vid="1CH 1:41">Dison.</para>
  <para style="li1" vid="1CH 1:41">Dison bebi-teni n di</para>
  <para style="li2" vid="1CH 1:41">Hemidan, ma Esiban, ma Itiran, ma Keran.<verse eid="1CH 1:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42" />Eseri bebi-teni n di</para>
  <para style="li2" vid="1CH 1:42">Bilihan, ma Saafan, ma Akan.</para>
  <para style="li1" vid="1CH 1:42">Disan bebi-teni n di</para>
  <para style="li2" vid="1CH 1:42">Usi ma Aran.<verse eid="1CH 1:42" /></para>
  <para style="s2">Edom begyu</para>
  <para style="r">Digyegeye 36:31-43</para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 1:43" />Bɛnɩ gɛtɛ be di bugyu Edom, pɛ gɛ Isareli e sere bugyu buu gedi fɔ n tɛ ba lɛ.</para>
  <para style="li2" vid="1CH 1:43">Bewori wobi Bela, gɛtɛ bɛ sa wo ditele diyere alɛ Dinahaba fɔ.<verse eid="1CH 1:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44" />Gɛtɛ Bela e ku fɔ, Sera wobi Yobabi gɛtɛ e ye Bosira fɔ e di bugyu e sere wɔ gɩsɩrɩ.<verse eid="1CH 1:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45" />Gɛtɛ Yobabi e ku fɔ, Husam gɛtɛ e ye Teman gɛtʋnkwaa gaanɩ fɔ e di bugyu e sere wɔ gɩsɩrɩ.<verse eid="1CH 1:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46" />Gɛtɛ Husam e ku fɔ, Bedadi wobi Hadadi, gɛtɛ e di Midiyan bete boo koro Mowabi gɛtʋnkwaa gaanɩ fɔ, e di bugyu e sere wɔ gɩsɩrɩ. Wo bugyu buu ditele n di Afiti.<verse eid="1CH 1:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47" />Gɛtɛ Hadadi e ku fɔ, Samla gɛtɛ e ye Masereka fɔ na di bugyu e sere wɔ gɩsɩrɩ.<verse eid="1CH 1:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48" />Gɛtɛ Samla e ku fɔ, Sahulu gɛtɛ e ye Rehoboti, gbɛma Efrati getu fɔ, na di bugyu e sere wɔ gɩsɩrɩ.<verse eid="1CH 1:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49" />Gɛtɛ Sahulu e ku fɔ, Akibori wobi Baal-Hanan na di bugyu e sere wɔ gɩsɩrɩ.<verse eid="1CH 1:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50" />Gɛtɛ Baali-Hanan e ku fɔ, Hadadi e di bugyu e sere wɔ gɩsɩrɩ. Wo ditele dii diyere n di Pawu, gɛ wɔsɔ diyere n di Mehetabeli, gɛtɛ wɔna n di Matiredi, gɛ wonu n di Me-Sahabi fɔ. <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />Wʋʋ gama fɔ, Hadadi mɔ e be ku.</para>
  <para style="b" vid="1CH 1:51" />
  <para style="li1" vid="1CH 1:51">Edom begyu n di</para>
  <para style="li2" vid="1CH 1:51">Timina, ma Alifa, ma Yeteti, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />ma Oholibama, ma Ela, ma Pinon, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />ma Kenasi, ma Teman, ma Mibisari, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />ma Magidiyeli, ma Iram. Ɛbɛ nyabɛ n di Edon begyu fɔ.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s1">Isareli bebi-teni</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1" />Isareli gɛtɛ bee ni kpèlè Yakobu fɔ bebi-teni n di</para>
  <para style="li2" vid="1CH 2:1">Ruben, ma Simeyon, ma Lefi, ma Yuda, ma Isaka, ma Sebulun, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />ma Dan, ma Yosefu, ma Benyamin, ma Nafitali, ma Gadi, ma Aseri.<verse eid="1CH 2:2" /></para>
  <para style="s1">Yuda ma Esiron boo bebi-teni</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3" />Yuda bebi-teni n di</para>
  <para style="li2" vid="1CH 2:3">Eri, ma Onan, ma Seela. Suwa wobi-nanɩ, gɛtɛ è di Kanaan-na fɔ na wo bebi besiyee nyabɛ ɛ tɛ wɔ. Yuda wobi ɛndɩrɛ Eri ɛ mɛ ade-kpen Yahwe bʋnʋn baanɩ, okoro Yahwe e wolo wɔ. <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" />Yuda wobi-sɔ Tama na wo Peresi ma Sera na tɛ wɔ. Gɛ Yuda bebi-teni powu bɛ ma yela ton.<verse eid="1CH 2:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5" />Peresi bebi-teni n di</para>
  <para style="li2" vid="1CH 2:5">Hesiron ma Hamuli.<verse eid="1CH 2:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6" />Sera bebi-teni n di</para>
  <para style="li2" vid="1CH 2:6">Simiri, ma Etan, ma Heman, ma Kalikoli, ma Darida. Ɛbɛ powu bɛ̀ ba ton.<verse eid="1CH 2:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7" />Karimi wobi-teni n di</para>
  <para style="li2" vid="1CH 2:7">Akari gɛtɛ e yuri anyan gɛtɛ bɛ ka bɛ tɛ Yahwe, gɛ wʋ ka dɩyɩyɛ wʋ ba Isareli fɔ.<verse eid="1CH 2:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8" />Etan wobi-teni n di</para>
  <para style="li2" vid="1CH 2:8">Asariya.<verse eid="1CH 2:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9" />Bebi-teni gɛtɛ be wo bɛ tɛ Hesiron fɔ n di</para>
  <para style="li2" vid="1CH 2:9">Yerameyeli, ma Ram, ma Kalebi.<verse eid="1CH 2:9" /></para>
  <para style="s1">Hesiron wobi Ram</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10" />Ram na wo</para>
  <para style="li2" vid="1CH 2:10">Aminadabo gɛtɛ e wo Nason, gɛtɛ ɛ mɛ Yuda bete bɔɔ dɩkpaara dɩɩndɩrɛ ɛkɩ fɔ. <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" />Nason na wo Salimon, gɛtɛ e wo Bowasi fɔ. <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />Bowasi na wo Obedi gɛtɛ e wo Yese fɔ.<verse eid="1CH 2:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13" />Yese wobi-gyangbasɛlɛ n di</para>
  <para style="li2" vid="1CH 2:13">Eliyabi. Wobi-nyɔɔfɛ n di Aminadabo, gɛ esiyeefɛ n di Simeya, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />ɛnaafɛ n di Netaniyeli, etonfɛ n di Radayi, <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />ekooronfɛ n di Osem, gɛ ɛkwarankɩfɛ n di Dafidi. <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" />Boonosobi ɛbɛ n di Seruya ma Abigeli. Seruya e wo bebi-teni besiyee. Ɛbɛ n di Abisayi, ma Yowabi, ma Asaheli. <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" />Amasa gɛtɛ wote è di Isimayeli-te Yeteri fɔ wɔna n di Abigeli.<verse eid="1CH 2:17" /></para>
  <para style="s2">Hesiron wobi-teni Kalebi</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18" />Hesiron wobi Kalebi e to Asuba gɩna, gɛ e wo ebi-nanɩ gɛtɛ bee kpèlè Yeriyoti. E wo bebi-teni besiyee gɛtɛ baayere n di Yeseri, ma Sobabi, ma Aridon. <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" />Gɛtɛ Asuba e ku fɔ, Kalebi e to Efrati gɩna, gɛ e wo Huri ɛ tɛ wɔ. <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" />Huri na wo Uri, gɛ Uri e wo Besaleli.<verse eid="1CH 2:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21" />Gamama fɔ, Hesiron ɛ dʋrɔ ma Gilaadi wonosobi gɛtɛ boote n di Makiri fɔ. Hesiron e to wɔ gɩna ɔkʋna gɛtɛ e di bɩkyan akpilin asiyee (60) fɔ, gɛ e wo Segubi ɛ tɛ wɔ. <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />Segubi na wo Yayiri gɛtɛ ɛ nya atele dikpilin ma asiyee yii koro fɔ. <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />Mɔ Gesuri ma Aram bete be gye Hafoti-Yayiri, fɩya ma Kenati ma watele gɛtɛ i silin wɔ i tuma fɔ bɩtà. Atele fɔ powu ɩ̀ ba akpilin asiyee (60). Bɛnɩ nyabɛ powu bè di gɛ Gileyadi wobi Makiri wodu wʋʋ bɛnɩ.<verse eid="1CH 2:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24" />Gɛtɛ Hesiron e ku Kalebi-Efrati ditele wʋʋ gama fɔ, Hesiron wɔsɔ Abiya e wo Asuri, gɛtɛ e tiri Tekowa fɔ ɛ tɛ wɔ.<verse eid="1CH 2:24" /></para>
  <para style="s1">Hesiron wobi Yerameyeli</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25" />Hesiron wobi ɛndɩrɛ Yerameyeli bebi-teni n di</para>
  <para style="li2" vid="1CH 2:25">Ram, gɛtɛ è di ebi ɛndɩrɛ, ma Buna, ma Oren, ma Osem, ma Ahiya. <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />Yerameyeli e to ɛna-fon ɛkɩ gɛtɛ wo diyere n di Atara. Wɔna diyere n di Onam.<verse eid="1CH 2:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27" />Yerameyeli wobi-ɛndɩrɛ Ram bebi-teni n di</para>
  <para style="li2" vid="1CH 2:27">Maasi, ma Yamin, ma Ekeri.<verse eid="1CH 2:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28" />Onam bebi-teni n di</para>
  <para style="li2" vid="1CH 2:28">Samayi ma Yada.</para>
  <para style="li1" vid="1CH 2:28">Samayi bebi-teni n di</para>
  <para style="li2" vid="1CH 2:28">Nadabi ma Abisuri.<verse eid="1CH 2:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 2:29" />Abisuri wɔsɔ diyere n di Abihayeli gɛtɛ e wo Ahiban ma Molidi ɛ tɛ wɔ fɔ.<verse eid="1CH 2:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30" />Nadabi bebi-teni n di</para>
  <para style="li2" vid="1CH 2:30">Seledi ma Apayim. Seledi e ku gɛtɛ en wo.<verse eid="1CH 2:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31" />Apayim wobi-teni n di</para>
  <para style="li2" vid="1CH 2:31">Isi gɛtɛ e wo Sesan fɔ.</para>
  <para style="li2" vid="1CH 2:31">Gɛ Sesan e wo Ahalayi.<verse eid="1CH 2:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32" />Samayi wonobi Yada bebi-teni n di</para>
  <para style="li2" vid="1CH 2:32">Yeteri ma Yonatan. Yeteri e ku gɛtɛ en wo.<verse eid="1CH 2:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33" />Yonatan bebi-teni n di</para>
  <para style="li2" vid="1CH 2:33">Peleti ma Sasa.</para>
  <para style="li1" vid="1CH 2:33">Ɛbɛ nyabɛ n di Yerameyeli wodu wʋʋ bɛnɩ fɔ.<verse eid="1CH 2:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34" />Sesan en wo bebi-teni, mɔ bɛnanɩ booko-booko gɛ e wo. Egyipiti-te ɛkɩ gɛtɛ wo diyere n di Yariha fɔ na mɛ wɔsaranyan. <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />Gɛ Sesan ɛ ka wobi-nanɩ ɛ tɛ wɔsaranyan Yariha e to gɩna, gɛ e wo Atayi ɛ tɛ wɔ.<verse eid="1CH 2:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36" />Atayi e wo Natan,</para>
  <para style="li2" vid="1CH 2:36">gɛ Natan e wo Sabedi.<verse eid="1CH 2:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37" />Sabedi e wo Efilali,</para>
  <para style="li2" vid="1CH 2:37">gɛtɛ e wo Obedi fɔ. <verse eid="1CH 2:37" /><verse number="38" style="v" sid="1CH 2:38" />Obedi e wo Yehu,</para>
  <para style="li2" vid="1CH 2:38">gɛ Yehu mɔ e wo Asariya.<verse eid="1CH 2:38" /></para>
  <para style="li2">
    <verse number="39" style="v" sid="1CH 2:39" />Asariya e wo Helesi,</para>
  <para style="li2" vid="1CH 2:39">gɛ Helesi mɔ e wo Eleyasa.<verse eid="1CH 2:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 2:40" />Eleyasa e wo Sisimayi,</para>
  <para style="li2" vid="1CH 2:40">gɛ Sisimayi mɔ e wo Salum.<verse eid="1CH 2:40" /></para>
  <para style="li2">
    <verse number="41" style="v" sid="1CH 2:41" />Salum e wo Yekamiya,</para>
  <para style="li2" vid="1CH 2:41">gɛ Yekamiya mɔ e wo Elisama.<verse eid="1CH 2:41" /></para>
  <para style="s1">Kalebi wodu wʋʋ bɛnɩ</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42" />Yerameyeli wonobi Kalebi bebi-teni n di</para>
  <para style="li2" vid="1CH 2:42">Mesa, gɛtɛ è di wobi ɛndɩrɛ, gɛtɛ è di Sifu wote fɔ, ma wobi-teni Meresa, gɛtɛ è di Hebron wote fɔ.<verse eid="1CH 2:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43" />Hebron bebi-teni n di</para>
  <para style="li2" vid="1CH 2:43">Kora, ma Tapuwa, ma Rekem, ma Sema. <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />Sema e wo Raham, gɛ Raham mɔ e wo Yorikeyam. Gɛ Rekem na wo Samayi. <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />Sema e wo Mayon, gɛ Mayon mɔ e wo Beti-Suri.<verse eid="1CH 2:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46" />Kalebi wodima Efa na wo Haran, ma Mosa, ma Gasesi. Gɛ Haran mɔ e wo ebi, gɛ ɛ sa wɔ diyere alɛ Gasesi.<verse eid="1CH 2:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47" />Yahidayi bebi-teni n di</para>
  <para style="li2" vid="1CH 2:47">Regem, ma Yotam, ma Gesan, ma Peleti, ma Efa, ma Safi.<verse eid="1CH 2:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48" />Kalebi wodima Maaka na wo Seberi, ma Tirihana. <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />Wʋʋ gama fɔ, e biri e wo Saafi gɛtɛ e tiri Madimana ditele fɔ, ma Sefa gɛtɛ e tiri Makibena ma Gibeya atele fɔ. Gɛ Kalebi wobi-nanɩ n di Akisa. <verse eid="1CH 2:49" /><verse number="50" style="v" sid="1CH 2:50" />Ɛbɛ nyabɛ n di Kalebi wodu wʋʋ bɛnɩ.</para>
  <para style="b" vid="1CH 2:50" />
  <para style="li1" vid="1CH 2:50">Efrati wobi-gyangbasɛ Huri bebi-teni n di</para>
  <para style="li2" vid="1CH 2:50">Sobali gɛtɛ e tiri Kiriyati-Yarim ditele fɔ. <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />Wobi-nyɔɔfɛ n di Salima gɛtɛ e tiri Betelehem ditele fɔ, gɛ wobi-siyeefɛ n di Harefu gɛtɛ e tiri Gati-Gaderi ditele fɔ.<verse eid="1CH 2:51" /></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52" />Kiriyati-Yarim wote Sobali wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 2:52">Harowe, ma Manahati bete ɔfan. <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />Kiriyati-Yarim wodu wʋʋ bɛnɩ n di Itiri bete, ma Puti bete, ma Sumati bete, ma Misirayi bete. Bɛnɩ nyabɛ baanɩ gɛ Sorati bete, ma Esitawali bete be ye.<verse eid="1CH 2:53" /></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54" />Salima wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 2:54">Betelehem bete, Netofati bete, ma Atiroti-Beti-Yowabi bete, ma Manahati bete ɔfan, ma Sori bete. <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />Akpa yɩɩ bɛŋwaralɛ gɛtɛ bɛ sara Yabesi ditele daanɩ fɔ n di Tirati bete, ma Simeyati bete, ma Sukati bete. Ɛbɛ nyabɛ n di Keni bete gɛtɛ be ye Hamati gɛtɛ è di Rekabi dɩkpaara dɩɩndɩrɛ fɔ wanɩ fɔ.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s1">Dafidi bebi-teni</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />Dafidi bebi-teni gɛtɛ be wo bɛ tɛ wɔ Hebron fɔ baayere n tɛ ba lɛ.</para>
  <para style="li2" vid="1CH 3:1">Ɛgyangbasɛlɛ fɔ n di Aminon gɛtɛ wɔna n di Ahinowam gɛtɛ e ye Yesireli fɔ. Ɛnyɔɔfɛ n di Daniyeli, gɛtɛ wɔna n di Abigali gɛtɛ e ye Karimeli fɔ wobi-teni.<verse eid="1CH 3:1" /></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 3:2" />Esiyeefɛ n di Abisalom gɛtɛ wɔna n di Maaka, Talimayi gɛtɛ è di Gesuri wogyu-dɩrɛ fɔ wobi-nanɩ. Ɛnaafɛ n di Adoniya gɛtɛ wɔna n di Agiti fɔ.<verse eid="1CH 3:2" /></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 3:3" />Etonfɛ n di Sefatiya gɛtɛ wɔna n di Abitali fɔ.</para>
  <para style="li2" vid="1CH 3:3">Gɛ ekooronfɛ n di Itireyam gɛtɛ wɔna n di Egila fɔ.<verse eid="1CH 3:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 3:4" />Be wo bebi kooron nyabɛ bɛ tɛ Dafidi Hebron, ɔkʋn gɛtɛ e di bugyu bɩkyan kwarankɩ ma bebon kooron fɔ.</para>
  <para style="m" vid="1CH 3:4">Dafidi e di bugyu Yerusalem bɩkyan dikpilin ma fwo busiyee (33). <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />Bebi-teni gɛtɛ be wo bɛ tɛ wɔ Yerusalem fɔ n di</para>
  <para style="li2" vid="1CH 3:5">Samuwa, ma Sobabi, ma Natan, ma Solomon. Amiyeli wobi-nanɩ Batiseba na wo bebi bɛnaa nyabɛ ɛ tɛ wɔ. <verse eid="1CH 3:5" /><verse number="6" style="v" sid="1CH 3:6" />Be ni wo bebi kperen bɛkɩ bɛ tɛ wɔ gɛtɛ ɛbɛ n di Ibihari, ma Elisuwa, ma Elifeleti, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />ma Noga, ma Nefegi, ma Yafiya, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />ma Elisama, ma Eliyada, ma Elifeleti. Ɛbɛ powu bɛ̀ ba yɛkɩ. <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />Ɛbɛ nyabɛ powu bè di gɛ Dafidi bebi-teni, gɛtɛ wodima ɛbɛ boo bebi bɛn fɩya. Fɔ Tama è di gɛ boonosobi.<verse eid="1CH 3:9" /></para>
  <para style="s1">Yuda begyu</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10" />Solomon wodu waanɩ wʋʋ bɛnɩ gɛtɛ be di bugyu fɔ n di Solomon wobi Rehobwam,</para>
  <para style="li2" vid="1CH 3:10">ma Rehobwam wobi Abiya,</para>
  <para style="li2" vid="1CH 3:10">ma Abiya wobi Asa,</para>
  <para style="li2" vid="1CH 3:10">ma Asa wobi Yehosafati,<verse eid="1CH 3:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 3:11" />ma Yehosafati wobi Yehoram,</para>
  <para style="li2" vid="1CH 3:11">ma Yehoram wobi Ahasiya,</para>
  <para style="li2" vid="1CH 3:11">ma Ahasiya wobi Yowasi,<verse eid="1CH 3:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 3:12" />ma Yowasi wobi Amasiya,</para>
  <para style="li2" vid="1CH 3:12">ma Amasiya wobi Asariya,</para>
  <para style="li2" vid="1CH 3:12">ma Asariya wobi Yotam,<verse eid="1CH 3:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 3:13" />ma Yotam wobi Ahasi,</para>
  <para style="li2" vid="1CH 3:13">ma Ahasi wobi Hesekiya,</para>
  <para style="li2" vid="1CH 3:13">ma Hesekiya wobi Manase,<verse eid="1CH 3:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 3:14" />ma Manase wobi Amon,</para>
  <para style="li2" vid="1CH 3:14">ma Amon wobi Yosiya.<verse eid="1CH 3:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15" />Yosiya bebi-teni n di</para>
  <para style="li2" vid="1CH 3:15">Yohanan gɛtɛ ɛwɔ n di ebi ɛndɩrɛ,</para>
  <para style="li2" vid="1CH 3:15">ma wobi-nyɔɔfɛ Yohoyakim,</para>
  <para style="li2" vid="1CH 3:15">ma wobi-siyeefɛ Sedekiya,</para>
  <para style="li2" vid="1CH 3:15">ma wobi-naafɛ Salum.<verse eid="1CH 3:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16" />Ɛbɛ gɛtɛ be di bugyu Yehoyakim gɛma fɔ n di</para>
  <para style="li2" vid="1CH 3:16">Yehwakim wobi Yehoyakin,</para>
  <para style="li2" vid="1CH 3:16">ma Sedekiya.<verse eid="1CH 3:16" /></para>
  <para style="s1">Yehoyakin wodu wʋʋ bɛnɩ</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17" />Yehoyakin gɛtɛ be gye bɛ san gisela fɔ wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 3:17">Selitiyeli, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />ma Malikiram, ma Pedaya, ma Senasari, ma Yekamiya, ma Hosana, ma Nedabiya.<verse eid="1CH 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19" />Pedaya bebi-teni n di</para>
  <para style="li2" vid="1CH 3:19">Serubabeli ma Simeyi.</para>
  <para style="li1" vid="1CH 3:19">Serubabeli bebi-teni n di</para>
  <para style="li2" vid="1CH 3:19">Mesulam ma Hananiya.</para>
  <para style="li2" vid="1CH 3:19">Fɔ Selomiti è di boonosobi.<verse eid="1CH 3:19" /></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 3:20" />Wo bebi ton bɛkɩ gɛtɛ bɛ̀ fɩya fɔ n di</para>
  <para style="li2" vid="1CH 3:20">Hasuba, ma Oheli, ma Berekiya, ma Hasadiya, ma Yusiba-Hesedi.<verse eid="1CH 3:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21" />Hananiya wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 3:21">Pelatiya, ma Yesaya. Yesaya wobi n di Refaya, Refaya wobi n di Arinan. Ariman wobi n di Obadiya, Obadiya wobi n di Sekaniya.<verse eid="1CH 3:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22" />Sekaniya wobi n di</para>
  <para style="li2" vid="1CH 3:22">Semaya. Semaya mɔ bebi-teni n di Hatusi, ma Igali, ma Bariya, ma Neriya, ma Safati. Ɛbɛ powu bɛ̀ ba bɛnɩ kooron.<verse eid="1CH 3:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23" />Neriya bebi-teni n di</para>
  <para style="li2" vid="1CH 3:23">Eliyonayi, ma Hisikiya, ma Asirikam. Ɛbɛ powu bɛ̀ ba bɛnɩ besiyee.<verse eid="1CH 3:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24" />Eliyonayi bebi-teni n di</para>
  <para style="li2" vid="1CH 3:24">Hodafiya, ma Eliyasibi, ma Pelaya, ma Akubi, ma Yohanan, ma Delaya, ma Anani. Ɛbɛ powu bɛ̀ ba bɛnɩ kwarankɩ.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s1">Yuda wodu wʋʋ bɛnɩ-do</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />Yuda wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 4:1">Peresi, ma Hesiron, ma Karimi, ma Huri, ma Sobali.<verse eid="1CH 4:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2" />Sobali wobi-teni n di Reya, gɛ Reya wobi-teni n di Yahati gɛtɛ e wo Ahumayi, ma Lahadi fɔ. Bɛnɩ nyabɛ n di Sorati wodu wʋʋ bɛnɩ fɔ.<verse eid="1CH 4:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3" />Etam bebi-teni n di</para>
  <para style="li2" vid="1CH 4:3">Yesireli, ma Isima, ma Idibasi. Boonosobi diyere n di Haseleliponi. <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />Penuweli wobi n di Gedori, gɛ Eseri wobi n di Husa.</para>
  <para style="li1" vid="1CH 4:4">Huri gɛtɛ è di Efrati wobi-teni ɛndɩrɛ, gɛtɛ e tiri Betelehem ditele fɔ wodu wʋʋ bɛnɩ bɛ lɛ.<verse eid="1CH 4:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5" />Tekowa wote Asuri e to bɛna bɛnyɔɔ. Ɛbɛ n di Hela ma Naara.<verse eid="1CH 4:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6" />Naara e wo Ahusam, ma Heferi, ma Temeni, ma Hahasitari ɛ tɛ wɔ. Naara wodu waanɩ wʋʋ bɛnɩ bɛ lɛ.<verse eid="1CH 4:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7" />Hela wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 4:7">Sereti, ma Sohari, ma Etenan, <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />ma Kosi gɛtɛ e wo Anubi, ma Hasobeba, ma Ahaheli gɛtɛ wote n di Huram fɔ wodu waanɩ.<verse eid="1CH 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />Fɔ Yabesi ɛ̀ ba gebù da wɔdɩrɛ ɛbɛ. Wɔna ɛ sa wɔ diyere alɛ Yabesi, yema ɛɛ dɔ̀ alɛ &lt;&lt;Ofele waanɩ gɛ na wo wɔ.&gt;&gt; <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />Yabesi e tiri onyun ɛ tɛ Isareli wo Wurubwarɛ alan, &lt;&lt;Oo, Wurubwarɛ, hira mɩ, fɔ àà yaraba mɩɩn gɛtʋnkwaa. Fɩya ma nmɩ, fɔ àà tiri mɩ ye ade-kpen-kamasɛ gɛtɛ yaà sa mɩ dɩyɩyɛ fɔ yaanɩ. Gɛ Wurubwarɛ ɛ nʋn wonyun-tiri.<verse eid="1CH 4:10" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11" />Suha wonobi Kelubi wote n di Mehiri gɛtɛ wote n di Esiton fɔ. <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />Esiton na wo Beti-Rafa, ma Peseya, ma Tehina gɛtɛ e tiri Nahasi ditele fɔ. Ɛbɛ nyabɛ n di Reka beteni.<verse eid="1CH 4:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13" />Kenesi bebi teni n di</para>
  <para style="li2" vid="1CH 4:13">Otiniyeli ma Seraya.</para>
  <para style="li1" vid="1CH 4:13">Otiniyeli bebi-teni n di</para>
  <para style="li2" vid="1CH 4:13">Hatati ma Mewonotayi. <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />Mewonotayi na wo Ofira.</para>
  <para style="li1" vid="1CH 4:14">Seraya na wo Yowabi,</para>
  <para style="li2" vid="1CH 4:14">gɛtɛ e tiri Ge-Harasim. Bɛ sa dɩ diyere gɛlɛ, yema dʋkɔ wʋʋ bɛnɩ bè di gɛ adawʋ yɩɩ bɛsalɛ.<verse eid="1CH 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15" />Yefune wobi Kalebi bebi-teni n di</para>
  <para style="li2" vid="1CH 4:15">Iru, ma Ela, ma Naam.</para>
  <para style="li1" vid="1CH 4:15">Ela wobi-teni n di</para>
  <para style="li2" vid="1CH 4:15">Kenasi.<verse eid="1CH 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16" />Yehaleleli bebi-teni n di</para>
  <para style="li2" vid="1CH 4:16">Sifu, ma Sifa, ma Tiriya, ma Asareli.<verse eid="1CH 4:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17" />Esira bebi-teni n di</para>
  <para style="li2" vid="1CH 4:17">Yeteri, ma Meredi, ma Eferi, ma Yalon. Meredi wɔsɔ ɛbɛ fɔ baanɩ ɛkɩ na wo Miriyam, ma wotesebi ɛbɛ Samayi, ma Isiba gɛtɛ e tiri Esitemowa ditele fɔ. <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />Wɔsɔ gɛtɛ e ye Yudeya fɔ na wo Gedori wote Yeredi, ma Soko wote Heberi, ma Sanowa wote Yekutiyeli. Ɛbɛ nyabɛ n di Farawo wobi-nanɩ Bitiya gɛtɛ Meredi e to gɩna fɔ bebi.<verse eid="1CH 4:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19" />Hodiya wɔsɔ gɛtɛ wotesebi n di Naham fɔ bebi-teni n di</para>
  <para style="li2" vid="1CH 4:19">Garmi wafʋrɩ gɛtɛ bɛ sara Keyila ditele daanɩ fɔ, ma Maakati wafʋrɩ gɛtɛ bɛ sara Esitomwa ditele daanɩ fɔ.<verse eid="1CH 4:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20" />Sihimon bebi-teni n di</para>
  <para style="li2" vid="1CH 4:20">Aminon, ma Rina, ma Ben-Hanan, ma Tilon.</para>
  <para style="li1" vid="1CH 4:20">Isi bebi-teni n di</para>
  <para style="li2" vid="1CH 4:20">Soheti, ma Ben-Soheti.<verse eid="1CH 4:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21" />Yuda wobi-teni Sela bebi-teni n di</para>
  <para style="li2" vid="1CH 4:21">Eri gɛtɛ e tiri Leka ditele fɔ, ma Laada gɛtɛ e tiri Maresa ditele fɔ, fɩya ma afʋrɩ gɛtɛ bɛɛ lɔ ayan-fututu gɛtɛ bɛ sara Beti-Asibeya fɔ, <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />ma Yokim, ma Koseba bɛnɩ, ma Yowasi ma Sarafi gɛtɛ be to Mowabi bɛnanɩ gɩna, gɛ bɛ ma sara Betelehem fɔ. Ade-ŋwaralɛ-sɩ̀lɛ nyayɩ i ye ade-kuba gɛtɛ bɛ ŋwara fɔ yaanɩ. <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />Ɛbɛ n di isun yɩɩ bɛmaralɛ gɛtɛ bɛ sara Netayim ma Gedera fɔ. Bɛ sara dʋkɔ bɛ mɛ gʋtʋn bɛ tɛ egyu-dɩrɛ.<verse eid="1CH 4:23" /></para>
  <para style="s1">Simeyon wodu wʋʋ bɛnɩ</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24" />Simeyon wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 4:24">Nemuweli, ma Yamin, ma Yaribi, ma Sera, ma Salum.<verse eid="1CH 4:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25" />Salum na wo Salum, gɛ Salum e wo Mibisam, gɛ Mibisam e wo Misima.<verse eid="1CH 4:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26" />Misima wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 4:26">Hamuweli, gɛtɛ e wo Sakori, gɛ Sakori mɔ e wo Simeyi.<verse eid="1CH 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />Simeyi e wo bebi-teni fwo-kooron, ma bebi-nanɩ kooron. Mɔ wonobi ɛbɛ ben wo gʋsɔ anlɛ ɛwɔ. Okoro Samuweli wofoli wʋʋ bɛnɩ bɛn sɔ anlɛ Yuda bete fɔ. <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />Ma ye egyu Dafidi wawi yaanɩ fɔ Simeyon wofoli nyawʋ wʋ sara Beseba, ma Molada, ma Hasari-Suwali, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />ma Biliha, ma Esem, ma Toladi, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />ma Betuweli, ma Horima, ma Sikilagi, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />ma Beti-Marikaboti, ma Hasari-Susim, ma Beti-Biri, ma Saarayim atele yaanɩ. <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />Bɛ nɩ sara atelebi Etam, ma Ayin, ma Rimon, ma Token, ma Asan yaanɩ. Ɛyɩ powu ɩ̀ ba atelebi ton, <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />fɩya ma atele gɛtɛ i silin i tuma gɛlɛ gaatele-dɩrɛ ɩtɔkɔ ka ma sere Balati. Baasarakʋn, ma boo gewo-tama giidu yaade-ŋwaralɛ-sɩ̀lɛ ɩ lɛ.<verse eid="1CH 4:33" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="34" style="v" sid="1CH 4:34" />Mesobabi, ma Yameleki, ma Yosa gɛtɛ è di Amasiya wote fɔ, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />ma Yoweli, ma Yehu gɛtɛ wote n di Yosibiya fɔ, ma Seraya wobi-teni, ma Asiyeli wobi-teni, <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />ma Eliyonayi, ma Yaakoba, ma Yesohaya, ma Asaya, ma Adiyeli, ma Yesimiyeli, ma Benaya, <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" />ma Sisa gɛtɛ wote n di Sifi fɔ, ma Alon wobi-teni, ma Yedaya wobi-teni, ma Simiri wobi-teni, ma Semaya wobi-teni. <verse eid="1CH 4:37" /><verse number="38" style="v" sid="1CH 4:38" />Bɛnɩ nyabɛ gɛtɛ be kpèlè baayere lɛ bè di gɛ baakpaara yii begyegeyelɛ. Baakpaara ɩ sɔ gepepe. <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />Gɛ bɛ san bɛ ma ye Gedori wɔpɩ, ka ma ye dɩtagba fɔ diifila wʋʋ gɛtàkʋn wʋʋ gɩlan, gɛtɛ bee bugiti dɩfa bàà tɛ bɔɔ bɛnan. <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />Be wura dɩfa-kpara, ma bɛnan boo gedikʋn-kpara, gɛ gɛtʋnkwaa fɔ gɩ̀ sɔ. Olila wʋ̀ sa gaanɩ, gɛ dʋkɔ wù we yiridi. Ham bete bɛ sara dʋkɔ bɛ nya.<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />Yuda wogyu-dɩrɛ Hesekiya bugyu buu gedi bʋʋya waanɩ gɛ bɛnɩ gɛtɛ bɛ ŋwara baayere lɛ bɛ ma tà bɩtà ma Ham bete, bɔɔ gɛsarakʋn gaanɩ. Gɛlɛ ke gɛ bɛ tà bɩtà ma Mewun bete, gɛ be muru bɛ kɩrɩ-kɩrɩ, anlɛ gɛtɛ ii we ǹdò lɛ. Ɛwʋ gɛ be to baasarakʋn fɔ bɛ sara, yema bɛnan boo gedikʋn gɩ̀ sa dʋkɔ gɛtɛ bɔɔ bɛnan baà wura be di. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />Ade nyayɩ yɩɩ gama fɔ, Simeyon bete nkpɩn bʋnyɔɔ ma akpilin ton (500) gɛtɛ Pelatiya, ma Neyariya, ma Refaya, ma Usiyeli be gyegeye bɔɔ bʋnʋn, gɛ bɛ san bɛ ma to Seri wodon wʋʋ gɛtʋnkwaa fɔ. <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />Be wolo Amaleki bete gɛtɛ be ti serenti be ye bɩtà baanɩ, gɛ to dʋkɔ bè si bè ye ma ǹdò.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s1">Ruben wodu wʋʋ bɛnɩ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />Isareli wobi ɛndɩrɛ bebi baade. Ruben n di Isareli wobi ɛndɩrɛ, mɔ gɛtɛ ɛ dʋrɔ ma wote wodima okoro, be to wɔ gɩndɩrɛ fɔ bɛ tɛ Isareli wobi Yosefu bebi-teni. Okoro bɛn mɩnɩ kalan wɔ sa gewo-tama giidu gɩɩ gɩkpa fɔ gaanɩ anlɛ ebi ɛndɩrɛ. <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />Gɛ ma gɛtɛ Yuda n ba ɔkɛma wɔdɩrɛ ɛbɛ ma wonobi ɛbɛ baanɩ, gɛ egyu e ye wanɩ gba fɔ, gewo gɩɩ gɩndɩrɛ fɔ gɩ mɛ gɛ Yosefu woyo. <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />Isareli wobi-teni ɛndɩrɛ Ruben bebi-teni n di</para>
  <para style="li1" vid="1CH 5:3">Hanoki, ma Palu, Ma Hesiron, ma Karimi.<verse eid="1CH 5:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4" />Yoweli wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 5:4">Semaya, ma Semaya wobi-teni Gogi,</para>
  <para style="li2" vid="1CH 5:4">ma Gogi wobi-teni Simeyi,<verse eid="1CH 5:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 5:5" />ma Simeyi wobi-teni Mika,</para>
  <para style="li2" vid="1CH 5:5">ma Mika wobi-teni Rehaya, ma Rehaya wobi-teni Baali,<verse eid="1CH 5:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6" />ma Baali wobi-teni Beera, ma Beera wobi-teni gɛtɛ Asiriya wogyu-dɩrɛ Tigilati-Pileseri e gye ɛ da fɔ. Beera na mɛ Ruben wofoli fɔ wʋʋndɩrɛ.<verse eid="1CH 5:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7" />Bɔɔ bɛfʋrɩ baayere, anlɛ gɛtɛ boo gewo-tama giidu gii wùlà fɔ n tɛ ba lɛ.</para>
  <para style="li2" vid="1CH 5:7">Yeyeli gɛtɛ ɛwɔ n di bɔɔndɩrɛ fɔ, ma Sekariya, <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />ma Bela gɛtɛ wote n di Asasi, gɛ Asasi wote n di Sema gɛtɛ ɛwɔ mɔ wote n di Yoweli fɔ. Bɛ sara gɛ ɔlanlan gɛtɛ wʋ ka wu ye Arore fɔ san Nebo ma Baali-Meyon fɔ waanɩ. <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />Ofila wʋʋ gɛtàkʋn wʋʋ gɩlan fɔ, be to gɛtʋnkwaa fɔ bɛ ma ye otonkuma wuunyun, ɔkʋn gɛtɛ wʋ̀ dɔ san Efrati getu gɩɩpɩ fɔ, yema bɔɔ bɛnan bɛ sɔ Gileyadi gɛtʋnkwaa gaanɩ.<verse eid="1CH 5:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 5:10" />Sawulo wo bugyu buu gedi gaanɩ fɔ, Ruben bɛnɩ bɛ tà bɩtà ma Hagiri bete, gɛ be di boo koro. Be to Hagiri bete baasarakʋn fɔ powu gɛtɛ ɩ̀ sa Gileyadi wofila wʋʋ gɛtàkʋn gɩɩ gɩlan.<verse eid="1CH 5:10" /></para>
  <para style="s1">Gadi wodu wʋʋ bɛnɩ</para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 5:11" />Gadi wodu wʋʋ bɛnɩ bɛ sara bɛ gbɛma Ruben wodu wʋʋ bɛnɩ Basan gɛtʋnkwaa gaanɩ, ka ma ye Saleka.<verse eid="1CH 5:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 5:12" />Yoweli n di ɛndɩrɛ, gɛ Safam ɛ̀ nyɩma, gɛ Yanayi ma Safati bɛ mɛ akpaara yɩɩ bɛndɩrɛ fɔ bɛkɩ Basan.<verse eid="1CH 5:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13" />Bɔɔ bɛfʋrɩ ɛbɛ akpaara-akpaara gɛtɛ i ye ofoli fɔ waanɩ fɔ n di</para>
  <para style="li2" vid="1CH 5:13">Mikayeli, ma Mesulam, ma Seba, ma Yorayi, ma Yakan, ma Siya, ma Eberi. Ɛbɛ powu bɛ̀ ba kwarankɩ.<verse eid="1CH 5:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14" />Abihayili gɛtɛ wote n di Huri fɔ gewo-tama gii-idu n tɛ ba lɛ. Huri wobi n di Abihayeli, Yarowa wobi n di Huri, Gileyadi wobi Yarowa, Mikayeli wobi n di Gileyadi, Yesisayi wobi n di Mikayeli, Yahido wobi n di Yesisayi, Busi wobi n di Yahido.<verse eid="1CH 5:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15" />Abidiyeli wobi Ahi gɛtɛ è di Guni wɔnana fɔ na mɛ bɔɔ dɩkpaara dɩɩndɩrɛ.<verse eid="1CH 5:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 5:16" />Gadi bɛnɩ bɛ sara Gileyadi, Basan gɛtʋnkwaa gaanɩ ma atele gɛtɛ i silin yɩ i tuma fɔ yaanɩ, ma Saron ntʋnkwaa gɛtɛ bù di bɛnan baadikʋn fɔ baanɩ.<verse eid="1CH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17" />Bɛ ŋwara ɛbɛ powu baayere bɛ sa gewo-tama gii-idu yaakpa gɛtɛ bɛ ŋwara ɔkʋna gɛtɛ Yuda wogyu-dɩrɛ Yotam, ma Isareli wogyu-dɩrɛ Yerobwam-nyɔɔfɛ bee di bugyu fɔ yaanɩ.<verse eid="1CH 5:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />Ruben bete, ma Gadi bete, ma Manase wɔfan wʋʋ bɛnɩ be wura bɩtà bʋʋ bɛtàlɛ asepekyi anyɔɔ ma ɩgbaa ɩnyɔɔ ma nkpɩn bisiyee ma akpilin nɩyɛ (44,760). Ɛbɛ n di bɛnɩ gɛtɛ be wùlà bɛ akpa gɛtɛ baà talɩ be ton gɩwɔrɔnyan-dɩyɛlɛ koro, ma bedon, ma bɩsɩnta, ma bɛgyangarɩ fɔ. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />Bɛ ma tà bɩtà ma Hagiri wo-ifoli gɛtɛ bè di Yeturi fɔ, ma Nafisi, ma Nadabi bete fɔ. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />Wurubwarɛ ɛ kpà bɛ akpa fɔ yaanɩ, gɛ ɛ ka Hagiri bete ma ɛbɛ gɛtɛ bɛ fɩya ma ɛbɛ fɔ powu ɛ sa Isareli bete bɔɔ gʋlɔ, yema be wula be kpèlè wɔ akpa fɔ yaanɩ. Ɛ nʋn boonyun-tiri, yema bɛ ka bʋnʋn bɛ gyaga wo koro. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />Be gye Hagiri bete baabengyi asepekyi anyɔɔ ma ɩgbaa ton (50,000), ma bɛyɛran asepekyi fwo anyɔɔ ma ɩgbaa ton (250,000), ma akpɔŋɔ gbaa ɛkɩ (2000). Gɛ be ni gye bɛnɩ asepekyi ton (100,000) bɩtà, <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />gɛ be wolo baanɩ kpekpesi yema akpa fɔ ì di gɛ Wurubwarɛ wakpa. Isareli bete be to gɛtʋnkwaa fɔ gaanɩ bɛ sara ka ma sere ɔkʋna gɛtɛ Babilon bete mɔ be be gye bɛ bɛ da.<verse eid="1CH 5:22" /></para>
  <para style="s1">Manase wofoli-fan</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />Manase wofoli-fan fɔ wʋʋ bɛnɩ bɛ̀ sɔ gepepe. Bɛ sara ye Basan wɔlanlan waanɩ san Baali-Herimon gɛtɛ wù di Seniri (Herimon wodon) fɔ. <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />Akpaara fɔ yɩɩ bɛndɩrɛ n di Eferi, ma Isi, ma Eliyeli, ma Asiriyeli, ma Yeremiya, ma Hadafiya, ma Yahidiyeli. Bɛ mɛ bɩtà bʋʋ bɛtàlɛ gbaa, gɛ be di diyere, gɛ bɛ mɛ baakpaara yɩɩ bɛndɩrɛ. <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />Mɔ bɛn tɛrɛma bootu ɛbɛ boo Wurubwarɛ fɔ, mɔ fɔ bɛ sʋma gɛ bɩfɩɩ gɛtɛ Wurubwarɛ e berema bʋ e ye bɔɔ bʋnʋn fɔ buu bekpen. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />Okoro Isareli wo Wurubwarɛ ɛ yɛ Asiriya wogyu-dɩrɛ Puli, gɛtɛ bee ni kpèlè alɛ Tigilati-Pileseri fɔ ɛ ma tà bɛ bɩtà, gɛ be gye Ruben bete, ma Gadi bete, ma Manase wofoli-fan fɔ bɛ da. Ɛ ka bɛ ɛ san ɛ ma sɩ̀ Hala, ma Habori, ma Hara, ma Gosan getu gɩɩpɩ, gɛtɛ bɛ̀ sangba bɛ̀ sa dʋkɔ bè ye ma ǹdò.<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s1">Lefi</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1" />Lefi bebi-teni n di</para>
  <para style="li2" vid="1CH 6:1">Gerison, Kohati, ma Merari.<verse eid="1CH 6:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2" />Kohati bebi-teni n di</para>
  <para style="li2" vid="1CH 6:2">Amiram, ma Isahari, ma Hebron, ma Usiyeli.<verse eid="1CH 6:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3" />Amiram bebi-teni n di</para>
  <para style="li2" vid="1CH 6:3">Aaron, ma Mose, ma Miriyam.</para>
  <para style="li1" vid="1CH 6:3">Aaron bebi-teni n di</para>
  <para style="li2" vid="1CH 6:3">Nadabi, ma Abihu, ma Eleyasari, ma Itamari.<verse eid="1CH 6:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4" />Eliyasari na wo Pinehasi,</para>
  <para style="li2" vid="1CH 6:4">gɛ Pinehasi na wo Abisuwa,<verse eid="1CH 6:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5" />Abisuwa mɔ na wo Buki,</para>
  <para style="li2" vid="1CH 6:5">gɛ Buki e wo Usi.<verse eid="1CH 6:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6" />Usi na wo Seraya,</para>
  <para style="li2" vid="1CH 6:6">gɛ Seraya e wo Merayoti.<verse eid="1CH 6:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7" />Merayoti na wo Amariya,</para>
  <para style="li2" vid="1CH 6:7">gɛ Amariya e wo Ahitubi.<verse eid="1CH 6:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8" />Ahitubi na wo Sadoki,</para>
  <para style="li2" vid="1CH 6:8">gɛ Sadoki e wo Ahimaasi.<verse eid="1CH 6:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9" />Ahimaasi na wo Asariya,</para>
  <para style="li2" vid="1CH 6:9">gɛ Asariya mɔ e wo Yohanan.<verse eid="1CH 6:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10" />Yohanan na wo Asariya, gɛtɛ ɛ mɛ gedi gɩɩtɛlɛ ɛndɩrɛ, gɛ ɛ mɛ gʋtʋn Dikwo-dɩrɛ gɛtɛ Solomon e sere Yerusalem fɔ daanɩ fɔ.<verse eid="1CH 6:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11" />Asariya na wo Amariya,</para>
  <para style="li2" vid="1CH 6:11">gɛ Amariya mɔ e wo Ahitubi.<verse eid="1CH 6:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12" />Ahitubi na wo Sadoki,</para>
  <para style="li2" vid="1CH 6:12">gɛ Sadoki mɔ e wo Salum.<verse eid="1CH 6:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13" />Salum na wo Hilikiya,</para>
  <para style="li2" vid="1CH 6:13">gɛ Hilikiya mɔ e wo Asariya.<verse eid="1CH 6:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14" />Asariya na wo Seraya,</para>
  <para style="li2" vid="1CH 6:14">gɛ Seraya mɔ e wo Yehosadaki.<verse eid="1CH 6:14" /></para>
  <para style="li4">
    <verse number="15" style="v" sid="1CH 6:15" />Bɛ ka Yehosadaki bɛ san gisele, ɔkʋna gɛtɛ Yahwe ɛ yɛ Nebukadinesa ɛ ka Yuda ma Yerusalem ɛ san gisela fɔ.<verse eid="1CH 6:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16" />Lefi bebi-teni n di</para>
  <para style="li2" vid="1CH 6:16">Gerison, ma Kohati, ma Merari.<verse eid="1CH 6:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17" />Gerison bebi-teni baayere n di</para>
  <para style="li1" vid="1CH 6:17">Libini ma Simeyi.<verse eid="1CH 6:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18" />Kohati bebi-teni n di</para>
  <para style="li2" vid="1CH 6:18">Amiram, ma Isahari, ma Hebron, ma Usiyeli.<verse eid="1CH 6:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19" />Merari bebi-teni n di</para>
  <para style="li2" vid="1CH 6:19">Mahili, ma Musi.<verse eid="1CH 6:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20" />Gerison bebi-teni n di</para>
  <para style="li2" vid="1CH 6:20">Libini, ma Libini wobi Yehati</para>
  <para style="li2" vid="1CH 6:20">ma Yehati wobi Sima, <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />ma Sima wobi Yowa, ma Yowa wobi Ido, ma Ido wobi Sera, ma Sera wobi Yewaterayi.<verse eid="1CH 6:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22" />Kohati wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 6:22">Aminadabo, ma Kora,</para>
  <para style="li2" vid="1CH 6:22">ma Asiri, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />ma Elikana</para>
  <para style="li2" vid="1CH 6:23">ma Ebiyasafu, ma Asiri,<verse eid="1CH 6:23" /></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24" />ma Tadati, ma Uriyeli,</para>
  <para style="li2" vid="1CH 6:24">ma Usiya, ma Sawulo.<verse eid="1CH 6:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25" />Elikana wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 6:25">Amasayi, ma Ahimoti,<verse eid="1CH 6:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26" />ma Ahimoti wobi Elikana, ma Elikana wobi Sofayi,</para>
  <para style="li2" vid="1CH 6:26">ma Sofayi wobi Nahati, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />ma Nahati wobi Eliyabu,</para>
  <para style="li2" vid="1CH 6:27">ma Eliyabu wobi Yeroham, ma Yoram wobi Elikana, ma Elikana wobi Samuweli.<verse eid="1CH 6:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28" />Samuweli bebi-teni n di</para>
  <para style="li2" vid="1CH 6:28">Yoweli gɛtɛ ɛwɔ n di wobi ɛndɩrɛ fɔ,</para>
  <para style="li2" vid="1CH 6:28">ma wobi-nyɔɔfɛ Abiya.<verse eid="1CH 6:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29" />Merari wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 6:29">Mahili, ma wobi Libini, ma Libini wobi Simeyi, ma Simeyi wobi Usa,<verse eid="1CH 6:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30" />ma Usa wobi Simeya, ma Simeya wobi Hagiya,</para>
  <para style="li2" vid="1CH 6:30">ma Hagiya wobi Asaya.<verse eid="1CH 6:30" /></para>
  <para style="s2">Dikwo-dɩrɛ fɔ dɩɩ-ɩnʋn yɩɩ bɛnʋmalɛ ma abin yɩɩ bɛtàlɛ</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />Gɛtɛ Yahwe Dɩdaka di be gyu Yerusalem fɔ, Dafidi e tiri bɛnɩ ɛ sɩ̀ gɛtɛ bàà nya ɩnʋn yɩɩ gɛnʋma gaade yii koro. <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />Fɔ bɛ̀ fʋrʋma bè di gɛ ɩnʋn yɩɩ bɛnʋmalɛ gɛtɛ bɛɛ mɛ gʋtʋn Dɩyan dii Dikwo-dɩrɛ fɔ daanɩ, Yahwe bʋnʋn, pɛ gɛ egyu-dɩrɛ Solomon e be sere Dikwo-dɩrɛ fɔ.<verse eid="1CH 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 6:33" />Bɛnɩ gɛtɛ bɛ nya ɩnʋn yɩ gɛnʋma fɔ gii koro, ma boo bebi-teni baayere n tɛ ba lɛ.</para>
  <para style="li1" vid="1CH 6:33">Kohati dɩkpaara daanɩ fɔ,</para>
  <para style="li2" vid="1CH 6:33">Heman na mɛ ɩnʋn yɩɩ bɛnʋmalɛ fɔ boogyegeyelɛ. È di gɛ Yoweli wobi, gɛ Yoweli mɔ è di Samuweli wobi. Wodu wʋʋ bɛnɩ ka biri ma sere Isareli n di<verse eid="1CH 6:33" /></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34" />Elikana, ma Yeroham, ma Eliyeli, ma Towa,<verse eid="1CH 6:34" /></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35" />ma Sufu, ma Elikana, ma Mahati, ma Amasayi,<verse eid="1CH 6:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36" />ma Elikana, ma Yoweli,</para>
  <para style="li2" vid="1CH 6:36">ma Asariya, ma Sefaniya,<verse eid="1CH 6:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37" />ma Tahati, ma Asiri,</para>
  <para style="li2" vid="1CH 6:37">ma Ebiyasafu, ma Kora,<verse eid="1CH 6:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38" />ma Isahari, ma Kohati,</para>
  <para style="li2" vid="1CH 6:38">ma Lefi, ma Isareli,<verse eid="1CH 6:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39" />ma Heman wɔwɔlɔn Asafu gɛtɛ ɛ mɛ egyegeyelɛ ɛ tɛ ɩnʋn yɩɩ bɛnʋmalɛ boo dikpen-nyɔɔfɛ fɔ. Wodu wʋʋ bɛnɩ n di Asafu, ma Berekiya, ma Simeya,<verse eid="1CH 6:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40" />ma Mikayeli, ma Baseya, ma Malikiya, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />ma Etini,</para>
  <para style="li2" vid="1CH 6:41">ma Sera, ma Adaya,<verse eid="1CH 6:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42" />ma Etan, ma Sima,</para>
  <para style="li2" vid="1CH 6:42">ma Simeyi, <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />ma Yahati,</para>
  <para style="li2" vid="1CH 6:43">ma Gerison, ma Lefi.<verse eid="1CH 6:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44" />Bɔɔwɔlɔn ɛbɛ gɛtɛ bè di Merari bɛnɩ gɛtɛ be yela dɩbɩyan fɔ n di</para>
  <para style="li2" vid="1CH 6:44">Etan, ma Kisi, ma Abidi, ma Maluki, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />ma Hasabiya,</para>
  <para style="li2" vid="1CH 6:45">ma Amasiya, ma Milikiya,<verse eid="1CH 6:45" /></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46" />ma Amesi, ma Bani, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />ma Maheli,</para>
  <para style="li2" vid="1CH 6:47">ma Musi, ma Merari,</para>
  <para style="li2" vid="1CH 6:47">ma Lefi.<verse eid="1CH 6:47" /></para>
  <para style="b" />
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />Bɛ sɩ̀ bɔɔwɔlɔn ɛbɛ Lefi bɛnɩ-kurumakyɛɛ fɔ bʋtʋn-kurumakyɛɛ gɛtɛ bàà mɛ Dikwo-dɩrɛ fɔ daanɩ. <verse eid="1CH 6:48" /><verse number="49" style="v" sid="1CH 6:49" />Mɔ Aaron ma wodu waanɩ wʋʋ bɛnɩ n tɛ tɛ gedi gekuma gii gedi gɩɩ gɛtɛkʋn fɔ gii koro, ma olifwi wuu gekuma gii gedi gɩɩ gɛtɛkʋn fɔ gii koro gɛtɛ be sere ade-kamasɛ gɛtɛ bɛɛ mɛ Ɔkʋn-dɩrɛ wʋʋkʋn-dɩrɛ, ma gedi gɩɩ gɛtɛ̀ tɛ Isareli wade-kpen yɩɩ gɛka-kyɛ, anlɛ gɛtɛ Wurubwarɛ wɔsaranyan Mose ɛ dɔ̀ ɛ sɩ̀ fɔ.<verse eid="1CH 6:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50" />Aaron wodu waanɩ wʋʋ bɛnɩ baayere n di</para>
  <para style="li2" vid="1CH 6:50">Eleyasa, ma Pinehasi,</para>
  <para style="li2" vid="1CH 6:50">ma Abisuwa, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />ma Buki,</para>
  <para style="li2" vid="1CH 6:51">ma Usi, ma Serahiya,<verse eid="1CH 6:51" /></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52" />ma Meratoti, ma Amariya</para>
  <para style="li2" vid="1CH 6:52">ma Ahitubi, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />Ma Sadoki,</para>
  <para style="li2" vid="1CH 6:53">ma Ahimaasi.<verse eid="1CH 6:53" /></para>
  <para style="b" />
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />Asarakʋn gɛtɛ be to bɛ tɛ Aaron wodu wʋʋ bɛnɩ gɛtɛ be ye Kahati wotunu waanɩ, gɛtʋnkwaa fɔ gaanɩ fɔ n tɛ ba lɛ. <verse eid="1CH 6:54" /><verse number="55" style="v" sid="1CH 6:55" />Bɛ tɛ bɛ Hebron ma bɛnan baadikʋn gɛtɛ i silin bɛ i tuma fɔ, Yuda gɛtʋnkwaa gaanɩ. <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />Mɔ bɛ ka ili yɩɩ bʋfʋnkʋn ma atele gɛtɛ i silin ditele-dɩrɛ fɔ i tuma fɔ bɛ tɛ Yefune wobi Kalebi.<verse eid="1CH 6:56" /></para>
  <para style="pi1">
    <verse number="57" style="v" sid="1CH 6:57" />Okoro atele gɛtɛ bɛ ka bɛ tɛ Aaron wodu waanɩ wʋʋ bɛnɩ fɔ n di Hebron ditele, gɛtɛ dì di geserenti-gyukʋn gii ditele fɔ, ma Libina, ma Yatiri, ma Esitemowa, <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />ma Hilen, ma Debiri, <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />ma Asan, ma Yuta, ma Beti-Semesi, fɩya ma atele fɔ yɩɩ bɛnan baadikʋn. <verse eid="1CH 6:59" /><verse number="60" style="v" sid="1CH 6:60" />Atele gɛtɛ bɛ tɛ bɛ Benyamin wofoli waanɩ fɔ n di Gibeyon, ma Geba, ma Alemeti, ma Anatoti, fɩya ma bɔɔ bɛnan baadikʋn.</para>
  <para style="pi1" vid="1CH 6:60">Atele gɛtɛ bɛ ka bɛ tɛ bɛ Kahati bete baanɩ fɔ powu ɩ̀ ba fwo asiyee.<verse eid="1CH 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="1CH 6:61" />Be tiri atele fwo be ye Manase wofoli-fan fɔ waanɩ bɛ tɛ Kohati wodu wʋʋ bɛnɩ-kurumakyɛɛ fɔ.<verse eid="1CH 6:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="1CH 6:62" />Bɛ tɛ Gerison wodu wʋʋ bɛnɩ, akpaara-akpaara, atele fwo asiyee ye Isaka wofoli, ma Ase wofoli, ma Nafitali wofoli, ma Manase wofoli wuufèn gɛtɛ wù di Basan fɔ yaanɩ.<verse eid="1CH 6:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="1CH 6:63" />Be tiri atele fwo anyɔɔ be ye Ruben wofoli, ma Gadi wofoli, ma Sebulun wofoli yaanɩ bɛ tɛ Merari wodu wʋʋ bɛnɩ dɩkpaara-dɩkpaara.<verse eid="1CH 6:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="1CH 6:64" />Okoro Isareli bete bɛ tɛ Lifi bete gɛlɛ gaatele nyayɩ, ma yɩɩ bɛnan baadikʋn. <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />Gɛ be tiri Yuda wofoli waanɩ, ma Simeyon wofoli waanɩ, ma Benyamin wofoli waanɩ, atele gɛtɛ be kpèlè yaayere bɛ bɛ da fɔ, be yo bɛ tɛ bɛ.<verse eid="1CH 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66" />Be tiri atele fɔ akɩ be ye Efrayim wofoli waanɩ bɛ tɛ Kohati wakpaara fɔ ɩkɩ.<verse eid="1CH 6:66" /></para>
  <para style="pi1">
    <verse number="67" style="v" sid="1CH 6:67" />Efrayim wo-idon yɩɩ gɛtʋnkwaa fɔ gaanɩ fɔ, bɛ tɛ bɛ Sekem gɛtɛ wù di geserenti-gyukʋn gii ditele, ma Geseri, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />ma Yokimeyam, ma Beti-Horon, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />ma Ayalon, ma Gati-Rimon, fɩya ma bɛnan baadikʋn.<verse eid="1CH 6:69" /></para>
  <para style="pi1">
    <verse number="70" style="v" sid="1CH 6:70" />Ye Manase wofoli-fan waanɩ Isareli bete bɛ ka Aneri, ma Bileyam, fɩya m bɛnan baadikʋn bɛ tɛ Kohati bete baakpaara-kurumakyɛɛ fɔ.<verse eid="1CH 6:70" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="71" style="v" sid="1CH 6:71" />Gerison bete be wura atele gɛtɛ ɩɩ ba lɛ.</para>
  <para style="li1" vid="1CH 6:71">Manase wofoli-fan fɔ waanɩ fɔ,</para>
  <para style="li2" vid="1CH 6:71">be wura Golan gɛtɛ ɛ̀ sa Basan anɩ fɔ, ma Asitaroti, fɩya ma bɛnan baadikʋn.<verse eid="1CH 6:71" /></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72" />Isaka wofoli waanɩ fɔ,</para>
  <para style="li2" vid="1CH 6:72">be wura Kadesi, ma Daberati, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />ma Ramoti, ma Anem, fɩya ma bɛnan baadikʋn.<verse eid="1CH 6:73" /></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74" />Aseri wofoli waanɩ fɔ,</para>
  <para style="li2" vid="1CH 6:74">be wura Masali, ma Abidon, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />ma Hukoki, ma Rehobi, fɩya ma bɛnan baadikʋn.<verse eid="1CH 6:75" /></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76" />Gɛ Nafitali wofoli waanɩ fɔ,</para>
  <para style="li2" vid="1CH 6:76">be wura Kadesi gɛtɛ ɛ̀ sa Galilee fɔ, ma Hamon, ma Kiriyatayim, ka fɩya ma bɛnan baadikʋn.<verse eid="1CH 6:76" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="77" style="v" sid="1CH 6:77" />Merari bete gɛtɛ bè di Lefi bete-kurumakyɛɛ fɔ be wura atele gɛtɛ yɩɩ ba lɛ.</para>
  <para style="li2" vid="1CH 6:77">Ye Sebulun wofoli waanɩ fɔ,</para>
  <para style="li2" vid="1CH 6:77">be wura Yokineyam, ma Karita, ma Rimono, ma Tabo atele, fɩya ma bɛnan baadikʋn.<verse eid="1CH 6:77" /></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78" />Ye Ruben wofoli waanɩ, Yodan getu-fèn, Yeriko wofila wʋʋ gɛtàkʋn wʋʋ gɩlan fɔ,</para>
  <para style="li2" vid="1CH 6:78">be wura Beseri gɛtɛ wʋ̀ sa otonkuma waanɩ fɔ, ma Yahisa, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />ma Kedemoti, ma Mefaati, fɩya ma bɛnan baadikʋn.<verse eid="1CH 6:79" /></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80" />Ye Gadi wofoli waanɩ fɔ,</para>
  <para style="li2" vid="1CH 6:80">be wura Ramoti gɛtɛ ɛ̀ sa Gileyadi anɩ fɔ, ma Mahanayim, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />ma Hesibon, ma Yeseri, fɩya ma bɛnan baadikʋn.<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s1">Isaka wodu wʋʋ bɛnɩ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />Isaka bebi-teni n di</para>
  <para style="li2" vid="1CH 7:1">Tola, ma Puwa, ma Yasubai, ma Simiron. Bɛ̀ ba bɛnɩ bɛnaa.<verse eid="1CH 7:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2" />Tola bebi-teni n di</para>
  <para style="li2" vid="1CH 7:2">Usi, ma Refaya, ma Yeriyeli, ma Yahimayi, ma Ibasam, ma Samuweli. Ɛbɛ n di akpaara yɩɩ bɛndɩrɛ fɔ. Egyu-dɩrɛ Dafidi wɔya waanɩ fɔ, Tola wodu wʋʋ bɛnɩ gɛtɛ bɛ kalan boo gewo-tama giidu waanɩ gɛtɛ bè di bɩtà bʋʋ bɛtàlɛ fɔ bɛ̀ ba disepekyi ma gbaa ma nkpɩn busiyee (22,600).<verse eid="1CH 7:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3" />Usi wobi n di</para>
  <para style="li2" vid="1CH 7:3">Isirahiya.</para>
  <para style="li1" vid="1CH 7:3">Isirahiya bebi-teni n di</para>
  <para style="li2" vid="1CH 7:3">Mikayeli, ma Obadiya, ma Yoweli, ma Isiya. Bɔɔ bɛnɩ ton powu bè di gɛ akpaara yɩɩ bɛndɩrɛ. <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />À nya baakpaara yii gewo-tama gii-idu fɔ, be wura bɩtà bʋʋ bɛtàlɛ disepekyi dɩkɩ ma ɩgbaa nɩyɛ (36,000), yema be to bɛna-kpekpesi, gɛ be wo bebi-teni kpekpesi.<verse eid="1CH 7:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 7:5" />Bɔɔ bɛfʋrɩ gɛtɛ bè di bɩtà bʋʋ bɛtàlɛ gɛtɛ be ye Isaka wakpaara powu yaanɩ, anlɛ gɛtɛ bɛ ŋwara boo gewo-tama gii-idu yaanɩ fɔ bɛ̀ ba bɛnɩ asepekyi anaa ma ɩgbaa isiyee ma nkpɩn ton (87,000).<verse eid="1CH 7:5" /></para>
  <para style="s1">Benyamin wodu wʋʋ bɛnɩ</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6" />Benyamin bebi-teni n di</para>
  <para style="li2" vid="1CH 7:6">Bela, ma Bekeri, ma Yediyayeli.<verse eid="1CH 7:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7" />Bela bebi-teni n di</para>
  <para style="li2" vid="1CH 7:7">Esibon, ma Usi, ma Isiyeli, ma Yerimoti, ma Iri, gɛtɛ ɛbɛ n di akpaara yɩɩ bɛndɩrɛ. Bɛ̀ ba bɛnɩ ton. Boo gewo-tama gii-idu gaanɩ fɔ, bɔɔ bɛnɩ gɛtɛ bɛ mɛ bɩtà bʋʋ bɛtàlɛ fɔ bɛ ba disepekyi ma gbaa ma dikpilin ma fwo bɛnaa (22,034).<verse eid="1CH 7:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8" />Bekeri bebi-teni n di</para>
  <para style="li2" vid="1CH 7:8">Semira, ma Yowasi, ma Eliyeseri, ma Eliyonayi, ma Omiri, ma Yeremoti, ma Abiya, ma Anatoti, ma Alemeti. Bɛnɩ nyabɛ powu bè di gɛ Bekeri bebi-teni. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />Boo gewo-tama gii-idu yaanɩ fɔ, be wura akpaara yɩɩ bɛndɩrɛ ma bɩtà bʋʋ bɛtàlɛ disepekyi ma gɛkpɩn (20,200).<verse eid="1CH 7:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10" />Yediyayeli wobi-teni n di</para>
  <para style="li2" vid="1CH 7:10">Bilihan.</para>
  <para style="li1" vid="1CH 7:10">Bilihan bebi-teni n di</para>
  <para style="li2" vid="1CH 7:10">Yewusi, ma Benyamin, ma Ehudi, ma Kenaana, ma Setan, ma Tarisisi, ma Ahisahari. <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />Yediyayeli bebi-teni nyabɛ powu bè di gɛ akpaara yɩɩ bɛndɩrɛ. Bɛ̀ ba ɩgbaa nɩyɛ ma nkpɩn kooron (17,200) gɛtɛ bɛ nɩma bɩtà bʋʋ-ɩsan.<verse eid="1CH 7:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12" />Supi bete ma Hupi bete bè di gɛ Iri wodu wʋʋ bɛnɩ, gɛ Husi bete mɔ bè di Aheri wodu wʋʋ bɛnɩ.<verse eid="1CH 7:12" /></para>
  <para style="s1">Nafitali wodu wʋʋ bɛnɩ</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13" />Nafitali bebi-teni n di</para>
  <para style="li2" vid="1CH 7:13">Yahisiyeli, ma Guni, ma Yeseri, ma Silem. Ɛbɛ n di Biliha wodu wʋʋ bɛnɩ.<verse eid="1CH 7:13" /></para>
  <para style="s1">Manase wodu wʋʋ bɛnɩ</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14" />Manase wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 7:14">Asiriyeli, ma Makiri gɛtɛ wodima, Aram-na fɔ e wo ɛ tɛ wɔ fɔ. Gileyadi wote n di Makiri. <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />Gɛ Makiri e to ɛna e ye Hupi bete ma Supi bete baanɩ. Wonosobi diyere n di Maaka. Wobi-teni-nyɔɔfɛ diyere n di Selofehadi gɛtɛ ɛwɔ e wo gɛ bɛnanɩ booko-booko fɔ.<verse eid="1CH 7:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 7:16" />Makiri wɔsɔ Maaka e wo ebi-tenibi, gɛ ɛ sa wɔ diyere alɛ Peresi. Wɔdɩrɛ diyere n di Seresi, gɛ wo bebi-teni n di Ulam ma Rakem.<verse eid="1CH 7:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17" />Ulam wobi-teni n di</para>
  <para style="li2" vid="1CH 7:17">Bedan.</para>
  <para style="li1" vid="1CH 7:17">Bɛnɩ nyabɛ n di Gileyadi gɛtɛ è di Makiri wobi, gɛ è di Manase wɔnana wodu waanɩ wʋʋ bɛnɩ fɔ. <verse eid="1CH 7:17" /><verse number="18" style="v" sid="1CH 7:18" />Wonosobi Hamoleketi e wo Isihodi, ma Abiyese, ma Mahila.<verse eid="1CH 7:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19" />Semida bebi-teni n di</para>
  <para style="li2" vid="1CH 7:19">Ahiyan, ma Sekem, ma Liki, ma Aniyam.<verse eid="1CH 7:19" /></para>
  <para style="s1">Efrayim wodu wʋʋ bɛnɩ</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20" />Efrayim wodu wʋʋ bɛnɩ n tɛ ba lɛ.</para>
  <para style="li2" vid="1CH 7:20">Efrayim na wo Sutela, gɛ Sutela e wo Beredi, gɛtɛ e wo Tahati fɔ.</para>
  <para style="li2" vid="1CH 7:20">Tahati na wo Eleyada,</para>
  <para style="li2" vid="1CH 7:20">gɛ Eleyada mɔ e wo Tahati. <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />Tahati na wo Sabedi,</para>
  <para style="li2" vid="1CH 7:21">gɛ Sabedi na wo Sutela.</para>
  <para style="li2" vid="1CH 7:21">Gati bete gɛtɛ be wo bɛ dʋkɔ fɔ, be wolo Eseri ma Eleyadi ɔkʋna gɛtɛ bɛ san bàà ma yuri bɔɔ bɛnan dɩkpankpasan daanɩ fɔ. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />Boote Efrayim ɛ ka awi-kpekpesi e wula bɛ, gɛ wɔ bɛfʋrɩ bɛ bɛ dɔ̀ bɛ sa wɔ. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />Wʋʋ gama fɔ, e biri ɛ dʋrɔ ma wɔsɔ, gɛ wɔsɔ e ton diboro, gɛ e wo ebi-tenibi. Ɛ sa ebi fɔ diyere alɛ Beriya, yema dɩyɩyɛ diiko-diiko n bɔ n sa wɔ dɩkpaara daanɩ. <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />Efrayim wobi-nanɩ n di Seera, gɛtɛ e sere Gatala gii Beti-Horon, ma Gatɩn gii Beti-Horon, fɩya ma Usen-Seera atele fɔ.<verse eid="1CH 7:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 7:25" />Efrayim wobi-teni ɛkɩ n di Refa, gɛ Refa wobi n di Resefu,</para>
  <para style="li2" vid="1CH 7:25">Resefu wobi-teni n di Tela, gɛtɛ wobi-teni n di Tahan fɔ.<verse eid="1CH 7:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26" />Tahan wobi-teni n di Ladan, gɛ Ladan wobi-teni n di Amihudi.</para>
  <para style="li2" vid="1CH 7:26">Amihudi wobi-teni n di Elisama, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />Elisama wobi-teni n di Nun,</para>
  <para style="li2" vid="1CH 7:27">Nun wobi-teni n di Yosuwa.<verse eid="1CH 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 7:28" />Bɔɔ gɛtʋnkwaa ma baasarakʋn n di Beteli, ma atele gɛtɛ i silin di i tuma fɔ, ye Naaran ka san ofila wʋʋ gɛtàkʋn wʋʋ gɩlan, ma Geseri ma watelebi ka san ofila wʋʋ gɛnʋ̀nkʋn wʋʋ gɩlan, ma Sekem ma watelebi ka ma ye Aya ma watelebi yaanɩ. <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />Beti-San, ma Tanaki, ma Megido, ma Dori, fɩya ma yaatelebi fɔ ì di gɛ Manase wodu wʋʋ bɛnɩ booyo, gɛ Yosefu, gɛtɛ è di Isareli wobi fɔ wodu wʋʋ bɛnɩ bɛ sara dʋkɔ.<verse eid="1CH 7:29" /></para>
  <para style="s1">Aseri wodu wʋʋ bɛnɩ</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30" />Aseri bebi-teni n di</para>
  <para style="li2" vid="1CH 7:30">Imina, ma Isifa, ma Isifi, ma Beriya. Boonosobi n di Sera.<verse eid="1CH 7:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31" />Beriya bebi-teni n di</para>
  <para style="li2" vid="1CH 7:31">Heberi, ma Malikiyeli gɛtɛ è di Birisayiti wote fɔ.<verse eid="1CH 7:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32" />Heberi na wo Yafeti, ma Someri, ma Hotam, ma boonosobi Suwa.<verse eid="1CH 7:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33" />Yafeti bebi-teni n di.</para>
  <para style="li2" vid="1CH 7:33">Pasaki, ma Bimihali, ma Asifati.</para>
  <para style="li2" vid="1CH 7:33">Yafeti bebi-teni bɛ lɛ.<verse eid="1CH 7:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34" />Someri bebi-teni n di</para>
  <para style="li2" vid="1CH 7:34">Ahi, ma Rohaga, ma Huba, ma Aram.<verse eid="1CH 7:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35" />Wɔdɩrɛ Helem bebi-teni n di</para>
  <para style="li2" vid="1CH 7:35">Sofa, ma Imina, ma Selesi, ma Amali.<verse eid="1CH 7:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36" />Sofa bebi-teni n di</para>
  <para style="li2" vid="1CH 7:36">Suwa, ma Harinefa, ma Suwali, ma Beri, ma Imira, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />ma Beseri, ma Hodi, ma Sama, ma Silisa, ma Itiran, ma Beera.<verse eid="1CH 7:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38" />Yeteri bebi-teni n di</para>
  <para style="li2" vid="1CH 7:38">Yefune, ma Pisipa, ma Ara.<verse eid="1CH 7:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39" />Ula bebi-teni n di</para>
  <para style="li2" vid="1CH 7:39">Ara, ma Haniyeli, ma Risiya.<verse eid="1CH 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 7:40" />Bɛnɩ nyabɛ powu bè di gɛ Aseri wodu waanɩ wʋʋ bɛnɩ. Bè di gɛ akpaara yɩɩ bɛndɩrɛ, ma bɩtà bʋʋ bɛtàlɛ gbaa-gbaa, ma begyegeyelɛ gɛtɛ baayere i ye. Anlɛ gɛtɛ bɛ ŋwara Aseri gewo-tama gii-idu gaade fɔ, be wura bɛnɩ disepekyi ma ɩgbaa isiyee (26,000) gɛtɛ baà talɩ bɛ san akpa.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s1">Benyamin-te Sawulo gewo-tama giidu wʋʋ bɛnɩ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />Benyamin na wo Bela gɛtɛ è di wobi-gyangbasɛlɛ fɔ,</para>
  <para style="li2" vid="1CH 8:1">wobi-nyɔɔfɛ n di Asibeli, esiyeefɛ n di Ahara,<verse eid="1CH 8:1" /></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2" />ɛnaafɛ n di Noha, ma wobi-tonfɛ Rafa.<verse eid="1CH 8:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3" />Bela bebi-teni n di</para>
  <para style="li2" vid="1CH 8:3">Adari, ma Gera, ma Abihudi, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />ma Abisuwa, ma Naaman, ma Ahowa, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />ma Gera, ma Sefufan, ma Huram.<verse eid="1CH 8:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6" />Ehudi wodu wʋʋ bɛnɩ gɛtɛ bɛ sara Geba, gɛ bɛ tɔ̀là bɛ bɛ san gisela Manahati ditele, gɛ bè di akpaara yɩɩ bɛndɩrɛ fɔ n tɛ ba lɛ.<verse eid="1CH 8:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7" />Naaman, ma Ahiya, ma Gera gɛtɛ ɛ tɔ̀là bɛ ɛ san Manahati fɔ. Gera bebi-teni n di Usa ma Ahihudi.<verse eid="1CH 8:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 8:8" />Gɛtɛ Saharayim e terema wɔsɔ ɛbɛ Husim ma Baara fɔ, wʋʋ gama e biri e wo bebi-teni Mowabi gɛtʋnkwaa gaanɩ. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />Wɔsɔ Hodesi e wo Yobabi, ma Sibiya, ma Mesa, ma Malikam, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />ma Yewusi, ma Sakiya, ma Mirima ɛ tɛ wɔ. Ɛbɛ n di wo bebi-teni gɛtɛ bɛ mɛ akpaara yɩɩ bɛndɩrɛ fɔ. <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />Husim e wo Abitubi ma Elipaali ɛ tɛ wɔ.<verse eid="1CH 8:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12" />Elipaali bebi-teni baayere n tɛ ba lɛ.</para>
  <para style="li2" vid="1CH 8:12">Eberi, ma Misam, ma Semedi gɛtɛ ɛ pɩna e sere Ono ma Lodi baatele ma atelebi gɛtɛ i silin yɩ i tuma fɔ, <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />ma Beriya, ma Sema gɛtɛ ɛbɛ na mɛ akpaara yɩɩ bɛndɩrɛ tɛ ɛbɛ gɛtɛ bɛ sara Ayalon, gɛ be berema Gadi bete fɔ.<verse eid="1CH 8:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14" />Ahiyo, ma Sasaki, ma Yeremoti, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />ma Sebediya, ma Aradi, ma Ederi, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />ma Mikayeli, ma Isapa, ma Yoha bè di gɛ Beriya bebi-teni.<verse eid="1CH 8:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17" />Sebadiya, ma Mesulum, ma Hisiki, ma Heberi, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />ma Isimerayi, ma Isiliya, ma Yobabi bè di gɛ Elipaali bebi.<verse eid="1CH 8:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19" />Yakim, ma Sikiri, ma Sabedi, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />ma Eliyenayi, ma Siletayi, ma Eliyeli, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />ma Adaya, ma Beraya, ma Simerati bè di gɛ Simeyi bebi-teni.<verse eid="1CH 8:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22" />Isipan, ma Eberi, ma Eliyeli, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />ma Abedon, ma Sikeri, ma Hanan, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />ma Hananiya, ma Elam, ma Antotiya, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />ma Ifedeya, ma Penuweli bè di gɛ Sasaki bebi-teni.<verse eid="1CH 8:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26" />Samiserayi, ma Sehariya, ma Ataliya, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />ma Yaaresiya, ma Eliya, ma Sikri bè di gɛ Yeroham bebi-teni.<verse eid="1CH 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 8:28" />Ɛbɛ nyabɛ powu bɛ mɛ gɛ Akpaara yɩɩ bɛndɩrɛ, ma begyu, anlɛ gɛtɛ bɛ ŋwara bɛ sa boo gewo-tama giidu gaakpa yaanɩ fɔ, gɛ bɛ sara Yerusalem.<verse eid="1CH 8:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29" />Gibeyon wote Yeyeli ɛ sara Gibeyon.</para>
  <para style="li2" vid="1CH 8:29">Wɔsɔ diyere n di Maaka, <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />gɛ wobi-teni ɛndɩrɛ n di Abedon. Ɛbɛ gɛtɛ bɛ̀ tɛrɛma wɔ fɔ n di Suri, ma Kisi, ma Baali, ma Neri, ma Nadabi, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />ma Gedori, ma Ahiyo, ma Sekeri, <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />ma Mikeloti gɛtɛ è di Simeya wote fɔ. Ɛbɛ mɔ bɛ sara bɛ gbɛma bɔɔ bɛfʋrɩ, Yerusalem ditele daanɩ.<verse eid="1CH 8:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33" />Neri na wo Kisi, Kisi na wo Sawulo, gɛ Sawulo mɔ e wo Yonatan, ma Maliki-Suwa, ma Abinadabo, ma Esibaali.<verse eid="1CH 8:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34" />Yonatan bebi-teni n di</para>
  <para style="li2" vid="1CH 8:34">Meribi-Baali gɛtɛ è di Mika wote fɔ.<verse eid="1CH 8:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35" />Mika bebi-teni n di</para>
  <para style="li2" vid="1CH 8:35">Piton, ma Meleki, ma Tareya, ma Ahasi.<verse eid="1CH 8:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36" />Ahasi na wo Yehwada, gɛ Yehwada e wo Alemeti, ma Asimafeti, ma Simri fɔ. Gɛ Simri mɔ e wo Mosa. <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />Mosa na wo Bineya, gɛ Bineya mɔ e wo Eleyasa gɛtɛ e wo Aseli fɔ.<verse eid="1CH 8:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38" />Aseli e wo bebi-teni kooron. Baayere n di</para>
  <para style="li2" vid="1CH 8:38">Asirikam, ma Bokeru, ma Isimayeli, ma Seyariya, ma Obadiya, ma Hanan. Ɛbɛ nyabɛ powu bè di gɛ Aseli bebi-teni.<verse eid="1CH 8:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39" />Wɔdɩrɛ Eseki bebi-teni n di</para>
  <para style="li2" vid="1CH 8:39">wobi ɛndɩrɛ Ulam, ma wobi-nyɔɔfɛ Yewusi, ma wobi-siyeefɛ Elifeleti. <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />Ulam bebi-teni fɔ bɛ mɛ gɛ bɩtà bʋʋ bɛtàlɛ gbaa bɛkɩ gɛtɛ bɛ tà bɩtà gepepe. Be wo bebi ma bɛnana kpekpesi. Ɛbɛ powu bɛ̀ ba akpilin kwarankɩ ma fwo (150).</para>
  <para style="li1" vid="1CH 8:40">Bɛnɩ-nyabɛ powu bè di gɛ Benyamin wodu waanɩ wʋʋ bɛnɩ.<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />Okoro bɛ kalan Isareli bete powu ma boo gewo-tama gii-idu gɛtɛ be ye yaanɩ fɔ, gɛ bɛ ŋwara yɩ bɛ sa Isareli begyu-dɩrɛ boo koro gaade yɩɩ gɩkpa fɔ gaanɩ.</para>
  <para style="s1" vid="1CH 9:1">Yerusalem bete</para>
  <para style="p" vid="1CH 9:1">Gɛ be gye Yuda bete bɛ san gisela Babilon, yema ben di baade yii koro. <verse eid="1CH 9:1" /><verse number="2" style="v" sid="1CH 9:2" />Bɛnɩ-gyangbasɛ gɛtɛ bɛ daà gye gɛ be biri bɛ bɛ sara ɛbɛ gbagba baasarakʋn, baatele yaanɩ fɔ n di Isareli gedi gɩɩ bɛtɛlɛ, ma Lefi bete, ma bɛnɩ gɛtɛ bɛɛ mɛ gʋtʋn Dikwo-dɩrɛ daanɩ fɔ.<verse eid="1CH 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 9:3" />Yuda wofoli, ma Benyamin wofoli, ma Efrayim wofoli, ma Manase wofoli gɛtɛ bɛ ma sara Yerusalem fɔ n di<verse eid="1CH 9:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4" />Utayi gɛtɛ wote n di Amihudi fɔ. Amihudi wote n di Omiri, gɛ Omiri wote n di Imiri, gɛtɛ wote n di Bani, gɛtɛ è di Peresi wodu waanɩ wʋʋnɩ fɔ, gɛ Peresi mɔ è di Yuda wobi.<verse eid="1CH 9:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5" />Ɛbɛ gɛtɛ be ye Silon bete baanɩ fɔ n di</para>
  <para style="li2" vid="1CH 9:5">Asaya gɛtɛ ɛwɔ n di ebi-teni ɛndɩrɛ fɔ, ma wo bebi-teni.<verse eid="1CH 9:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6" />Ɛbɛ gɛtɛ be ye Sera wodu waanɩ fɔ n di</para>
  <para style="li2" vid="1CH 9:6">Yeweli ma wɔ bɛfʋrɩ.</para>
  <para style="li2" vid="1CH 9:6">Yuda bɛnɩ fɔ powu bɛ̀ ba nkpɩn busiyee ma akpilin anaa ma fwo (690).<verse eid="1CH 9:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 9:7" />Bɛnɩ gɛtɛ be ye Benyamin bɛnɩ baanɩ fɔ n di</para>
  <para style="li2" vid="1CH 9:7">Salu gɛtɛ è di Mesulam wobi fɔ. Mesulam è di Hodafiya wobi gɛtɛ è di Hasenuya wobi fɔ. <verse eid="1CH 9:7" /><verse number="8" style="v" sid="1CH 9:8" />Ɛkɩ mɔ n di Ibeneya gɛtɛ è di Yeroham wobi fɔ, ma Ela gɛtɛ è di Usi wobi, gɛ Usi mɔ è di Mikiri wobi. Ɛkɩ mɔ n di Mesulam gɛtɛ è di Sefatiya wobi fɔ, gɛtɛ ɛwɔ mɔ è di Ruweli wobi, gɛ Ruweli mɔ è di Ibeniya wobi fɔ.<verse eid="1CH 9:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 9:9" />Bɛnɩ nyabɛ powu bè di gɛ Benyamin wakpaara yɩɩ bɛndɩrɛ. Gɛtɛ bɛ kalan boo gewo-tama-gii-idu yaanɩ fɔ, ɛbɛ powu bɛ̀ ba nkpɩn bɩnaa ma akpilin kwarankɩ ma fwo-kooron (956).<verse eid="1CH 9:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 9:10" />Gedi gɩɩ bɛtɛlɛ fɔ n di</para>
  <para style="li2" vid="1CH 9:10">Yedaya, ma Yehoyaribi, ma Yakin, <verse eid="1CH 9:10" /><verse number="11" style="v" sid="1CH 9:11" />ma Asariya gɛtɛ è di Hilikiya wobi, gɛ ɛwɔ mɔ è di Mesulam wobi fɔ. Mesulam è di Sadoki wobi, gɛ Sadoki è di Merayoti wobi, gɛ Merayoti mɔ è di Ahitubi wobi gɛtɛ ɛɛ nya Wurubwarɛ Dikwo-dɩrɛ daade yii koro fɔ.<verse eid="1CH 9:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 9:12" />Bɛkɩ mɔ n di Adaya gɛtɛ è di Yeroham wobi, gɛtɛ è di Pasihuri wobi, gɛ ɛwɔ mɔ è di Malikiya wobi fɔ. Fɩya ma Maasayi gɛtɛ è di Adiyeli wobi, gɛ Adiyeli mɔ è di Yasera wobi, gɛ Yasera mɔ è di Mesulam wobi, gɛ Mesulam mɔ è di Imeri wobi.<verse eid="1CH 9:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 9:13" />Gedi gɩɩ bɛtɛlɛ gɛtɛ bè di akpaara-akpaara yɩɩ bɛndɩrɛ fɔ bɛ̀ ba nkpɩn nɩyɛ ma akpilin nɩyɛ (1,760). Bè di gɛ bɛnɩ gbaa gɛtɛ bɛɛ talɩ bɛ mɛ gʋtʋn Wurubwarɛ Dikwo-dɩrɛ fɔ daanɩ.<verse eid="1CH 9:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 9:14" />Lefi bete fɔ n di</para>
  <para style="li2" vid="1CH 9:14">Semaya gɛtɛ è di Hasubi wobi fɔ. Asubi mɔ è di Hasirikam wobi, gɛ Hasirikam è di Hasabiya wobi, gɛtɛ è di Merari-te fɔ. <verse eid="1CH 9:14" /><verse number="15" style="v" sid="1CH 9:15" />Bɛkɩ mɔ n di Bakebakari, ma Heresi, ma Galali, ma Mataniya gɛtɛ è di Mika wobi fɔ. Mika è di gɛ Sikiri wobi, gɛ Sikiri mɔ è di Asafu wobi. <verse eid="1CH 9:15" /><verse number="16" style="v" sid="1CH 9:16" />Bɛkɩ mɔ n di Obadiya gɛtɛ è di Semaya wobi, gɛ Semaya mɔ è di Galali wobi, gɛ Galali mɔ è di Yedutum wobi fɔ. Fɩya ma Berekiya gɛtɛ è di Asa wobi, gɛ Asa mɔ è di Elikana gɛtɛ ɛ sara Netofati bete baatele yaanɩ fɔ wobi.<verse eid="1CH 9:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 9:17" />Dikwo-dɩrɛ diitunu wʋʋ bɛdɩyɛlɛ fɔ n di</para>
  <para style="li2" vid="1CH 9:17">Salum, ma Akubi, ma Talimon, ma Ahiman, ma bɔɔdɩrɛ ɛbɛ. Fɔ Salum n di bɔɔndɩrɛ. <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />Bɛ tɩ̀ dɩyɛ egyu-dɩrɛ wotunu gɛtɛ wʋ̀ sa Dikwo-dɩrɛ fɔ diifila wʋʋ gɛ wʋʋ gɛtàkʋn wʋʋ gɩlan fɔ. Ɛbɛ na dɩyɛ Lefi bete bɔɔ gɛsarakʋn giitunu fɔ. <verse eid="1CH 9:18" /><verse number="19" style="v" sid="1CH 9:19" />Salum gɛtɛ è di Kore wobi, gɛ Kore mɔ è di Ebiyasafu wobi, gɛ ɛwɔ mɔ è di Kora wobi fɔ, fɩya ma wɔwɔlɔn ɛbɛ otunu wʋʋ bɛdɩyɛlɛ Kora bɛnɩ fɔ na dɩyɛ Dikwo-dɩrɛ fɔ diitunu, anlɛ gɛtɛ bootu ɛbɛ bɛ dɩyɛ Dikwo-dɩrɛ dɩɩkʋn-dɩrɛ wuutunu fɔ. <verse eid="1CH 9:19" /><verse number="20" style="v" sid="1CH 9:20" />Ɔkʋna wʋkɩ fɔ, Eleyasa wobi Pinehasi na mɛ otunu wʋʋ bɛdɩyɛlɛ fɔ bɔɔndɩrɛ, gɛ Wurubwarɛ ɛ sara ma ɛwɔ. <verse eid="1CH 9:20" /><verse number="21" style="v" sid="1CH 9:21" />Mesulemiya wobi Sekariya na mɛ ɛdɩyɛlɛ Getumakʋn fɔ giitunu.<verse eid="1CH 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 9:22" />Bɛnɩ powu gɛtɛ be tiri gɛtɛ bàà dɩyɛ itunu fɔ bɛ̀ ba gɛkpɩn ma fwo bɛnyɔɔ (212). Bɛ ŋwara baayere boo gewo-tama giidu yaanɩ baatele yaanɩ. Dafidi ma Wurubwarɛ wɔtabʋrʋlɛ Samuweli n di bɛnɩ gɛtɛ bɛ ka gʋtʋn fɔ bɛ sa bɔɔ gʋlɔ. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />Ɛbɛ ma boo-idu yɩɩ bɛnɩ gɛ bɛ ka bɛ sɩ̀ gɛtɛ bàà tɩ̀ dɩyɛ Yahwe dɩkpaara gɛtɛ dì biri dì di Dɩyan dii Dikwo fɔ diitunu. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />Itunu yɩɩ bɛdɩyɛlɛ fɔ bɛ sara ifen ɩnaa fɔ powu yaanɩ. Bɛ sara ofila wʋʋ gɛtàkʋn wʋʋ gɩlan, ma ofila wʋʋ gɛnʋ̀nkʋn wʋʋ gɩlan, ma gatala gɩɩ gɩlan, ma gatɩn gɩɩ gɩlan. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />Awi kwarankɩ-kamasɛ fɔ, bɔɔ bɛfʋrɩ fɔ bee ye baatele yaanɩ bɛ ba gɛtɛ bàà bɛ̀ kpà bɛ gʋtʋn fɔ gɩɩ gɛmɛ. <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />Mɔ bɛ ka akwo, ma Wurubwarɛ dɩkpaara fɔ daanyan-gbaa yɩɩ gɛsɩ̀kʋn bɛ sa itunu yɩɩ bɛdɩyɛlɛ bɔɔ bɛndɩrɛ bɛnaa gɛtɛ bè di Lefi bete fɔ bɔɔ gʋlɔ. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />Bee yela odente-kamasɛ be silin Wurubwarɛ dɩkpaara fɔ, yema wù di gɛ bɔɔ gʋtʋn gɛtɛ bàà dɩyɛ dɩ. Okoro ɛbɛ n de bɛsafwɩ gɛtɛ bàà tɩ̀ tana ɩpʋnʋ fɔ gagyɩgyan-kamasɛ.<verse eid="1CH 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />Baanɩ bɛkɩ bɔɔ gʋtʋn n di gɛtɛ bàà nya anyɩmɩnyan gɛtɛ bè de bɛɛ mɛ gʋtʋn Wurubwarɛ Dikwo fɔ daanɩ fɔ yii koro. Gengyi baà ka anyɩmɩnyan fɔ be ye oo, baà ka yɩ be gyu oo, ɛbɛ n tɛ kalan yɩ. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />Bedo mɔ bɛ̀ sa gɛtɛ ɛbɛ n tɛ nya Ɔkʋn-fɩrɩnfɩrɩnkʋn fɔ wʋʋ bɛtasa, ma ɔnʋmʋ, ma wayɩn bʋkan, ma bʋnɔ, ma olifwi, ma anyan ma ofen fɔ yii koro. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />Mɔ gedi gɩɩ bɛtɛlɛ fɔ bɛkɩ n tɛ nya anyan ma ofen fɔ yii gesugba. <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />Lefi-te ɛkɩ gɛtɛ bee kpèlè Matitiya gɛtɛ è di Kora-te Salum wobi ɛndɩrɛ fɔ n tɛ nya boroboro-kumalɛ gɛtɛ bɛɛ ka bɛ tɛ gedi fɔ wuu koro. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />Bɔɔ bɛfʋrɩ Kohati bete fɔ bɛkɩ n te kuma boroboro gɛtɛ bɛɛ ka bɛ gyaga ɔkpʋlɔ wuu koro Ditunawi-kamasɛ fɔ.<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />Lefi bete baakpaara yɩɩ bɛndɩrɛ gɛtɛ bè di ɩnʋn yɩɩ bɛnʋmalɛ fɔ bɛɛ sara Dikwo-dɩrɛ fɔ daakwo yaanɩ, gɛtɛ bɛn taa nɩ yɛ bɛ bàà mɛ gʋtʋn gɩkɩ bɛ fɩya, yema bɛɛ mɛ ɩnʋn yɩɩ gɛnʋma yɩɩ gʋtʋn odon ma ofilibo.<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34" />Ɛbɛ nyabɛ powu bè di gɛ Lefi bete baakpaara yɩɩ bɛndɩrɛ, ma begyegeyelɛ, anlɛ gɛtɛ boo gewo-tama giidu gii wùlà fɔ. Bɛ sara gɛ Yerusalem.<verse eid="1CH 9:34" /></para>
  <para style="s1">Sawulo gewo-tama giidu</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35" />Gibeyon wote Yeyeli gɛtɛ e tiri Gibeyon ditele fɔ ɛ sara dʋkɔ. Wɔsɔ diyere n di Maaka, <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />gɛ wobi-teni ɛndɩrɛ n di Abidon, pɛ gɛ be wo Suri, ma Kisi, ma Baali, ma Neri, ma Nadabi, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />ma Gedori, ma Ahiyo, ma Sekariya, ma Mikeloti. <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />Mikeloti na wo Simeyam. Ɛbɛ mɔ ke bɛ sara Yerusalem bɛ gbɛma bɔɔ bɛfʋrɩ.<verse eid="1CH 9:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39" />Neri na wo Kisi, gɛ Kisi e wo Sawulo, gɛ Sawulo mɔ e wo Yonatan, ma Malikisuwa, ma Abinadabo, ma Esibaali.<verse eid="1CH 9:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40" />Yonatan bebi-teni n di</para>
  <para style="li2" vid="1CH 9:40">Meribaali gɛtɛ è di Mika wote fɔ.<verse eid="1CH 9:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41" />Mika bebi-teni n di</para>
  <para style="li2" vid="1CH 9:41">Piton, ma Meleki, ma Tahireya, ma Ahasi.<verse eid="1CH 9:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42" />Ahasi na wo Yada, gɛ Yada e wo Alemeti, ma Asimafeti, ma Simri gɛtɛ e wo Mosa fɔ. <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />Mosa na wo Bineya, gɛ Bineya e wo Refaya gɛtɛ e wo Aseli fɔ.<verse eid="1CH 9:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44" />Aseli e wo bebi kooron, gɛ baayere n di</para>
  <para style="li2" vid="1CH 9:44">Asirikam, ma Bokeru, ma Isimayeli, ma Seyariya, ma Obadiya, ma Hanan. Aseli bebi-teni bɛ lɛ.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s1">Sawulo diku</para>
  <para style="r">
    <ref loc="1SA 31:1-13">1 Samweli 31:1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />Wʋ bɛ ba gɛtɛ Filisiti bete bɛ ma tà bɩtà ma Isareli bete. Gɛ Isareli bete fɔ be serenti, gɛ kpekpesi be ku Gilibowa wodon wuu koro. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />Gɛ Filisiti bete bɛ tɛrɛma Sawulo ɔnʋn-sɩna waanɩ, gɛ be wolo wo bebi-teni Yonatan, ma Abinadabo, ma Malikisuwa. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />Wʋ bɛ nɩma ɔkʋna wʋkɩ fɔ, akpa fɔ ɩɩ mɛ ɔkɛma ɩ tɛ Sawulo, okoro wo bekengbelilɛ bɔɔ bɩsɩnta bu sere wɔ, gɛ e pira.<verse eid="1CH 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4" />Ɛwʋ gɛ Sawulo ɛ dɔ̀ wakpa-nyan yiitolalɛ fɔ alan, &lt;&lt;Tiri aa tata, fɔ àà sere mɩ wolo. Nka gɛlɛ fɔ Filisiti bete nyabɛ gɛtɛ ben belen bɩsan lɛ baà be wolo mɩ, fɔ bàà mʋmwa mɩ.&gt;&gt;</para>
  <para style="p" vid="1CH 10:4">Mɔ wakpanyan yiitolalɛ fɔ e terema, yema wʋ mɛ wɔ gɩsaa wʋ kààrà. Gɛlɛ wuu koro Sawulo ɛ ka ɛwɔ gbagba wɔ tata e sere gɛtʋnkwaa, gɛ ɛ tà ɛ nʋ̀n wo koro. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />Gɛtɛ akpan-yan yiitolalɛ fɔ e we gɛtɛ Sawulo e ku fɔ, ɛwɔ mɔ e fun koro ɛ fɩna wodon wo koro, gɛ e ku. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />Okoro Sawulo, ma wo bebi-teni besiyee fɔ, ma wɔ dɩkpaara dɩɩ bɛnɩ be ku onyun-kɩlɩn.<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />Gɛtɛ Isareli bete gɛtɛ bɛ̀ sa Yesereli dɩtagba daanɩ fɔ, be we gɛtɛ bɩtà bʋʋ bɛtàlɛ fɔ be serenti, gɛ Sawulo ma wo bebi-teni fɔ be ku fɔ, be serenti be kere baatele bɛ ya. Ɛwʋ gɛ Filisiti bete fɔ be to atele fɔ yaanɩ bɛ sara.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />Gɛtɛ kere gɩ kpa, gɛ Filisiti bete bɛ san bɛ̀ ma kpila bekpena fɔ baanyan fɔ, be we gɛtɛ Sawulo ma wo bebi-teni mɔ bɛ nʋ̀n bɩtà fɔ baanɩ, Gilibowa wodon fɔ wuu koro. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />Ɛwʋ gɛ be lo Sawulo wanyan gɛtɛ ɛ̀ sa fɔ, gɛ be belen wɔ duyu, gɛ bɛ ka dɩ, fɩya ma wɔ gɩwɔrɔnyan-dɩyɛlɛ koro fɔ bɛ da. Gɛ bɛ sa bɛnɩ Filisiti bete bɔɔ gɛtʋnkwaa powu gaanɩ alɛ bɛ ma yasɩ gɛlɛ gaade fɔ boo bekpen ma bɔɔ bɛnɩ baanɩ. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />Gɛ bɛ ka wɔ gɩwɔrɔnyan-dɩyɛlɛ koro fɔ bɛ ma sɩ̀ boo bekpen boo dikwo daanɩ, gɛ bɛ ka wo duyu bɛ ma fà Dagon wokpen dikwo daanɩ.<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />Gɛtɛ Yabesi-Gileyadi bete powu bɛ nʋn ade gɛtɛ Filisiti bete bɛ mɛ Sawulo fɔ, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />bɔɔ bɩtà bʋʋ bɛtàlɛ gbaa-gbaa fɔ bɛ san bɛ ma ka Sawulo ma wo bebi-teni fɔ boo bikpena bɛ san Yabesi. Gɛ be lò baanankʋba oyon-dɩrɛ wʋkɩ wʋʋ gatɩn, Yabesi ditele daanɩ, gɛ bɛ ban onyun awi kwarankɩ. <verse eid="1CH 10:12" /><verse number="13" style="v" sid="1CH 10:13" />Sawulo e ku, yema en di Yahwe wade yii koro. En ton Yahwe wanyun-gyebi fɔ yaanɩ, gɛ ɛɛ san bekpèlèlɛ bekpena gba baakʋn ɛ ma kpèlè bekpena bàà wùlà wɔ isele, <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />gɛ ɛn taa lila Yahwe gelenbi. Okoro Yahwe e wolo wɔ, gɛ ɛ ka bugyu buu gedi fɔ ɛ sa Yese wobi Dafidi gʋlɔ.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s1">Dafidi e di bugyu Isareli</para>
  <para style="r">(2 Samweli 5:1-10)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />Ɛwʋ gɛ Isareli bete powu bɛ ma tuma Dafidi wakʋn, Hebron ditele daanɩ, gɛ bɛ dɔ̀ wɔ alan, &lt;&lt;Ɛtɩ ma awɔ tì di gɛ nkalan-kɩlɩn. <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />Ɔya wʋkɩ wʋ bɛ da gɛtɛ ma gɛtɛ Sawulo n di egyu fɔ, awɔ n tɛ tɩ̀ ka Isareli a san bɩtà a ba. Gɛ Yahwe, aa Wurubwarɛ ɛ dɔ̀ wɔ̀ alan, &lt;&lt;Awɔ nan nya mɩɩn bɛnɩ Isareli bete boo koro, gɛ awɔ nan mɛ boogyu.&gt; &gt;&gt;<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />Gɛtɛ Isareli bɛndɩrɛbi bɛ san Egyu-dɩrɛ Dafidi wakʋn Hebron ditele daanɩ fɔ, Dafidi ɛ tà dikola ma ɛbɛ Hebron dʋkɔ, Yahwe bʋnʋn baanɩ. Wʋʋ gama fɔ, bɛ sʋrʋ Dafidi bʋnɔ bɛ sɩ̀ wɔ bugyu, anlɛ gɛtɛ Yahwe ɛ fʋrʋma ɛ da ma Samuweli wo koro ɛ dɔ̀ ɛ sɩ̀ fɔ.<verse eid="1CH 11:3" /></para>
  <para style="s1">Dafidi e di Yerusalem bete boo koro</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />Wʋʋ gama fɔ, Dafidi ma Isareli bete powu bɛ tɔ bɛ ma tà Yerusalem gɛtɛ bè biri bee kpèlè alɛ Yebusi fɔ bɩtà. Waanɩ fɔ, Yebusi bete na sara dʋkɔ. <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />Yebusi bete bɛ dɔ̀ Dafidi alan, &lt;&lt;À nan talɩ a gyu nfan.&gt;&gt; Mɔ Dafidi e gye Siyon gɛtɛ be sere ɔpɔrɩ be silin, gɛ bè biri bee kpèlè alɛ Dafidi-Ditele fɔ bɩtà.<verse eid="1CH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6" />Gɛ Dafidi ɛ dɔ̀ alan, &lt;&lt;Ɛnɩ-kamasɛ gɛtɛ eè gyegeye ɛ ma tà Yebusi bete bɩtà èè di boo koro fɔ, ɛɛ̀ mɛ bɩtà bʋndɩrɛ.&gt;&gt; Ɛwʋ gɛ Seruya wobi Yowabi e gyegeye ɛ san. Okoro bɛ sɩ̀ wɔ bɩtà bʋʋndɩrɛ.<verse eid="1CH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7" />Ɛwʋ gɛ Dafidi ɛ ma sara ɔkʋn gɛtɛ bɛ mara ɔpɔrɩ bɛ sʋ fɔ. Okoro gɛ bɛ yɛ bee kpèlè dʋkɔ alɛ Dafidi-Ditele fɔ. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />Ɛ pɩna e sere ditele fɔ, ye kpata anɩ ka ma ye ɔpɔrɩ gɛtɛ wu silin di fɔ, gɛ Yowabi ɛ pɩna ditele fɔ dɩɩkʋn-kʋrʋmakyɛɛ. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />Gɛ Dafidi ɛ̀ bɔ ee wura ɔkɛma ɛ fɩya, yema Yahwe, Ɔkɛma powu Wuute fɔ ɛ̀ fɩya ma ɛwɔ.<verse eid="1CH 11:9" /></para>
  <para style="s1">Dafidi bɩtà bʋʋ bɛtàlɛ ma ɔkɛma fɔ</para>
  <para style="r">2 Samweli 23:8-39</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />Dafidi bɩtà bʋʋ bɛtàlɛ gbaa-gbaa bɔɔ bɛndɩrɛ gɛtɛ ɛbɛ ma Isareli bete powu na kpà, gɛ bugyu fɔ bu yela ɔkɛma waanɩ anlɛ gɛtɛ Yahwe ɛ dɔ̀ fɔ, baayere n tɛ ba lɛ. <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />Dafidi bɩtà bʋʋ bɛtàlɛ gɛtɛ bɛ̀ ba ɔkɛma fɔ baayere n di Yasobeyam gɛtɛ e ye Hakimon wodu waanɩ fɔ na mɛ ɛndɩrɛ ɛ tɛ bɩtà bʋʋ bɛtàlɛ bɔɔ bɛndɩrɛ besiyee fɔ. Ɛwɔ na ka wɔ gɩsɩnta e wolo bɛnɩ gɛkpɩn ma akpilin ton (300) akpa yii getuma-kɩlɩn gaanɩ fɔ.<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />Bɩtà bʋʋ bɛtàlɛ gbaa-gbaa besiyee fɔ baanɩ ɛnyɔɔfɛ n di Eleyasa, gɛtɛ è di Ahoti-te Dodayi wobi-teni fɔ. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />E yela Dafidi gama ɛ kpà ma Filisiti bete ɔkʋn gɛtɛ bee kpèlè alɛ Pasi-Damim fɔ. Fɔ ɛ̀ sa oli wʋkɩ gɛtɛ amɔrɔ ì yela waanɩ gepepe, ɔkʋna gɛtɛ Isareli bɩtà bʋʋ bɛtàlɛ akpi-akpi be serenti be ye Filisiti bete bɔɔ bʋnʋn fɔ. <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />Mɔ Eleyasa ma wɔ bɩtà bʋʋ bɛtàlɛ bɛ ma to oli fɔ wuu getite be yela. Bɛ kpà be to oli fɔ, gɛ be wolo Filisiti bete fɔ. Gɛ Yahwe ɛ yɛ bɛ be di akpa fɔ yii koro gepepe. <verse eid="1CH 11:14" /><verse number="15" style="v" sid="1CH 11:15" />Duwi dɩkɩ, bɩtà bʋʋ bɛtàlɛ bɔɔ bɔndɩrɛ dikpilin ma fwo fɔ baanɩ besiyee bɛ san Dafidi wakʋn Adulam dɩtaa-fwe fɔ daanɩ. Ɔkʋna wʋtɔkɔ ke fɔ, Filisiti bete bɔɔ bɩtà buu dikpi fɔ dɩ̀ sa Refayim dɩtagba daanɩ. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />Ɔya wʋtɔkɔ waanɩ fɔ, Dafidi ɛ̀ sa ɔkʋn gɛtɛ ekengbelilɛ ɛkɩ ɛn talɩ e gyu, gɛ Filisiti bɩtà bʋʋ bɛtàlɛ bɛ ma sere gɛsarakʋn Betelehem ditele daanɩ. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />Butu bʋ gbɛrɛ Dafidi ɔmɩrɩ, gɛ ɛ dɔ̀ alan, &lt;&lt;Oo, mɩn nan wura ɛkɩ ɛ̀ɛ̀ ma kpà ditiribun gɛtɛ dɩ̀ gbɛma Betelehem wotunu fɔ dii butu ɛ mɔma mɩ? <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />Ɛwʋ gɛ bɩtà bʋʋ bɛtàlɛ gbaa-gbaa besiyee fɔ bɛ tɩtɩrɩ be gyu ma Filisiti bete fɔ baanɩ, gɛ bɛ ma kpà butu fɔ be ye ditiribun gɛtɛ dɩ̀ gbɛma Betelehem wotunu dii butu bɛ mɔma Dafidi. Mɔ Dafidi e terema bʋʋ gɛnyʋn. Gɛ ɛ daa bʋ e lù gɛtʋnkwaa Yahwe bʋnʋn. <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />Gɛ Dafidi ɛ dɔ̀ alan, &lt;&lt;Wurubwarɛ ɛ ka ɛ san ɔfɔ gɛtɛ nan nyʋn butu nyabu! Wʋ̀ bɔ wù we gɛ anlɛ gɛtɛ ntɛ nyʋn beteni nyabɛ gɛtɛ be yera diku lɛ bɔɔ nkalan?&gt;&gt; Yema be yera diku bɛ ma kpà butu bɛ ba. Okoro gɛ e terema bʋʋ gɛnyʋn fɔ.</para>
  <para style="p" vid="1CH 11:19">Ade-dɩrɛ anlɛ gɛ bɩtà bʋʋ bɛtàlɛ gbaa-gbaa fɔ bɛ mɛ. <verse eid="1CH 11:19" /><verse number="20" style="v" sid="1CH 11:20" />Fɔ Yowabi wɔdɩrɛ Abisayi n di bɩtà bʋʋ bɛtàlɛ besiyee fɔ bɔɔndɩrɛ. Ɛ ka gɩsɩnta ɛ kpà ma bɛnɩ gɛkpɩn ma akpilin ton (300), gɛ e wolo bɛ. Okoro ɛwɔ mɔ e be di diyere anlɛ bɩtà bʋʋ bɛtàlɛ besiyee fɔ. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />Bɩtà bʋʋ bɛtàlɛ besiyee fɔ baanɩ fɔ ɛwɔ na di diyere na da bekurumakyɛɛ, okoro ma gɛtɛ ɛn fɩya baanɩ gba fɔ, ɛ bɛ mɛ bɔɔndɩrɛ.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />Yehoyada wobi-teni Benaya ɛ mɛ bɩtà bʋʋtàlɛ-dɩrɛ ɛ nya. E ye gɛ Kabiseeli, gɛ ɛ mɛ dɩkpatɩ daade. E wolo Mowabi bɩtà bʋʋ bɛtàlɛ-dɩrɛ bɛnyɔɔ. Gɛlɛ ke gɛ duwi dɩkɩ gɛtɛ akpenkperebi-dɩrɛ-dɩrɛ ɩ nʋ̀n gɛtɛ wʋn ma ɔkpɛɛran fɔ, ɛ waran ɛ san difwe daanɩ ɛ ma wolo ɛdɩrɛ. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />Gɛ e ni wolo Egyipiti-te ɛkɩ gɛtɛ wabo yaà mɛ anlɛ meta bɛnyɔɔ ma ɔfan. Ma gɛtɛ Egyipiti-te fɔ è de gɩsɩnta-dɩrɛ gba fɔ, Benaya ɛ ka digoli ɛ tàmà wɔ, gɛ ɛ labɩrɩ gɩsɩnta fɔ e ye Egyipiti-te fɔ gʋlɔ gaanɩ, gɛ e birima Egyipiti-te fɔ gbagba gɩsɩnta-dɩrɛ fɔ e wolo wɔ. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />Ade-dɩrɛ gɛtɛ Yehoyada wobi Benaya ɛ mɛ fɔ ɩ lɛ. Ɛwɔ mɔ ke e di diyere anlɛ bɩtà bʋʋ bɛtàlɛ gbaa-gbaa besiyee fɔ. <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />Bɛnɩ dikpilin ma fwo fɔ powu baanɩ fɔ, ɛwɔ gɛ bee bù gepepe, mɔ ɛn fɩya besiyee fɔ baanɩ. Gɛ Dafidi ɛ ka wɔ ɛ mɛ bɛdɩyɛlɛ fɔ bɔɔndɩrɛ.<verse eid="1CH 11:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 11:26" />Bɩtà bʋʋ bɛtàlɛ gbaa-gbaa-do n di</para>
  <para style="li2" vid="1CH 11:26">Asaheli gɛtɛ è di Yowabi wonobi fɔ,</para>
  <para style="li2" vid="1CH 11:26">ma Elihanan gɛtɛ è di Dodo gɛtɛ e ye Betelehem fɔ wobi,<verse eid="1CH 11:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="1CH 11:27" />ma Harori-te Samoti,</para>
  <para style="li2" vid="1CH 11:27">ma Pelon-te Helesi,<verse eid="1CH 11:27" /></para>
  <para style="li2">
    <verse number="28" style="v" sid="1CH 11:28" />ma Ikesi gɛtɛ e ye Tekowa fɔ wobi Ira,</para>
  <para style="li2" vid="1CH 11:28">ma Abiyese gɛtɛ e ye Anatoti fɔ,<verse eid="1CH 11:28" /></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 11:29" />ma Hasati-te Sibekayi,</para>
  <para style="li2" vid="1CH 11:29">ma Ahohi-te Ilayi,<verse eid="1CH 11:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 11:30" />ma Netofati-te Maharayi</para>
  <para style="li2" vid="1CH 11:30">ma Netofati-te Baana wobi Heledi,<verse eid="1CH 11:30" /></para>
  <para style="li2">
    <verse number="31" style="v" sid="1CH 11:31" />ma Ribayi gɛtɛ e ye Gebeya, Benyamin wofoli waanɩ fɔ wobi Itayi,</para>
  <para style="li2" vid="1CH 11:31">ma Piraton-te Benaya,<verse eid="1CH 11:31" /></para>
  <para style="li2">
    <verse number="32" style="v" sid="1CH 11:32" />ma Hurayi gɛtɛ e ye Gaasi fɔ,</para>
  <para style="li2" vid="1CH 11:32">ma Aribati-te Abiyeli,<verse eid="1CH 11:32" /></para>
  <para style="li2">
    <verse number="33" style="v" sid="1CH 11:33" />ma Baharum-te Asimafeti,</para>
  <para style="li2" vid="1CH 11:33">ma Salibon-te Eliyahiba,<verse eid="1CH 11:33" /></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 11:34" />ma Gosen-te Hasem bebi-teni,</para>
  <para style="li2" vid="1CH 11:34">ma Harari-te Sagee wobi Yonatan,<verse eid="1CH 11:34" /></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 11:35" />ma Sakari gɛtɛ e ye Harari fɔ wobi Ahiyam,</para>
  <para style="li2" vid="1CH 11:35">ma Elifali, gɛtɛ wote n di Uri fɔ,<verse eid="1CH 11:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 11:36" />ma Heferi gɛtɛ e ye Mekerati fɔ,</para>
  <para style="li2" vid="1CH 11:36">ma Ahiya gɛtɛ e ye Pelon fɔ,<verse eid="1CH 11:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 11:37" />ma Hesiron gɛtɛ e ye Karimeli fɔ,</para>
  <para style="li2" vid="1CH 11:37">ma Narayi, gɛtɛ è di Esibayi wobi fɔ,<verse eid="1CH 11:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 11:38" />ma Natan wonobi Yoweli,</para>
  <para style="li2" vid="1CH 11:38">ma Hagiri wobi Mibihari<verse eid="1CH 11:38" /></para>
  <para style="li2">
    <verse number="39" style="v" sid="1CH 11:39" />ma Amon-te Seleki,</para>
  <para style="li2" vid="1CH 11:39">ma Beroti-te Naharayi, gɛtɛ ɛ mɛ Suriya wobi Yowabi wɔ gɩwɔrɔnya-dɩyɛlɛ koro giitolalɛ fɔ,<verse eid="1CH 11:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 11:40" />ma Itiri-te Ira,</para>
  <para style="li2" vid="1CH 11:40">ma Itiri-te Gerebi,<verse eid="1CH 11:40" /></para>
  <para style="li2">
    <verse number="41" style="v" sid="1CH 11:41" />ma Hiti-te Uriya,</para>
  <para style="li2" vid="1CH 11:41">ma Ahilayi wobi Sabedi,<verse eid="1CH 11:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 11:42" />ma Adina gɛtɛ è di Ruben-te Sisa wobi fɔ. Gɛ ɛwɔ na mɛ Ruben bete bɔɔndɩrɛ, gɛ bɛnɩ dikpilin ma fwo fɔ bɛ̀ fɩya ma ɛwɔ fɔ,<verse eid="1CH 11:42" /></para>
  <para style="li2">
    <verse number="43" style="v" sid="1CH 11:43" />ma Maaka wobi Hanan,</para>
  <para style="li2" vid="1CH 11:43">ma Mitini-te Yosafati,<verse eid="1CH 11:43" /></para>
  <para style="li2">
    <verse number="44" style="v" sid="1CH 11:44" />ma Asiterati-te Usiya,</para>
  <para style="li2" vid="1CH 11:44">ma Arori-te Hotam bebi Sama ma Yeyeli,<verse eid="1CH 11:44" /></para>
  <para style="li2">
    <verse number="45" style="v" sid="1CH 11:45" />ma Tisi-te Simiri bebi Yediyayeli,</para>
  <para style="li2" vid="1CH 11:45">ma wonobi Yoha,<verse eid="1CH 11:45" /></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 11:46" />ma Mahafi-te Eliyeli,</para>
  <para style="li2" vid="1CH 11:46">ma Elinaam bebi Yeribayi ma Yosafiya,<verse eid="1CH 11:46" /></para>
  <para style="li2">
    <verse number="47" style="v" sid="1CH 11:47" />ma Eliyeli, ma Obedi, ma Mesobayi-te Yaasiyeli.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s1">Bɩtà bʋʋ bɛtàlɛ gɛtɛ bɛ bɛ fɩya ma Dafidi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />Beteni bɛkɩ bɛ san bɛ ma fɩya ma Dafidi, Sikilagi ditele daanɩ ɔkʋna gɛtɛ e serenti e ye Kisi wobi Sawulo bʋnʋn fɔ. Bè di gɛ bɛnɩ gɛtɛ bɛ̀ nyɩ̀ akpa yaade gepepe, gɛ bɛ kpà wɔ akpa fɔ yaanɩ. <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />Bè di bɛnɩ gɛtɛ bɛ̀ nyɩ̀ bɩsɩnta bʋʋ gɛtà, gɛ bɛ̀ nyɩ̀ taya gɛtà dɩbɩyan ma ologyi. Bè di gɛ Sawulo wɔ bɛfʋrɩ gɛtɛ ɛbɛ mɔ be ye gɛ Benyamin wofoli waanɩ.<verse eid="1CH 12:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 12:3" />Bɔɔ bɛndɩrɛ n di Gibeya-te Semaa bebi-teni Ahiyeseri ma Yowasi, ma Asimafeti bebi Yesiyeli, ma Peleti, ma Baraka, ma Anatoti-te Yehu, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />ma Isimaya gɛtɛ e ye Gibeyon fɔ, gɛ è di bɩtà bʋʋtàlɛ-dɩrɛ gɛtɛ ɛ̀ fɩya bɛnɩ dikpilin ma fwo fɔ baanɩ, gɛtɛ è di begyegeyelɛ fɔ baanɩ ɛkɩ fɔ. Yeremiya, ma Yahasiyeli, ma Yosabadi gɛtɛ e ye Gederati fɔ, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />ma Elusayi, ma Yerimoti, ma Beyaliya, ma Semariya, ma Sefatiya gɛtɛ e ye Harufi fɔ, <verse eid="1CH 12:5" /><verse number="6" style="v" sid="1CH 12:6" />ma Elikana, ma Isiya, ma Asareli, ma Yoweseri, ma Yasobeyam gɛtɛ be di Kora bete fɔ, <verse eid="1CH 12:6" /><verse number="7" style="v" sid="1CH 12:7" />ma Yoram gɛtɛ e ye Gedori fɔ bebi Yowela ma Sebediya.<verse eid="1CH 12:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />Bɩtà bʋʋ bɛtàlɛ fɔ bɛkɩ gɛtɛ bè di Gadi bɛnɩ fɔ bɛ ma fɩya ma Dafidi, ɔkʋn gɛtɛ ekengbelilɛ ɛkɩ ɛn talɩ e gyu fɔ, otonkuma waanɩ. Bè di gɛ bɩtà bʋʋ bɛtàlɛ gɛtɛ bɛ̀ nyɩ̀ akpa gepepe, gɛ bɛ̀ nyɩ̀ gɩwɔrɔnyan-dɩyɛlɛ koro gii geton gepepe, gɛ bɛ̀ nyɩ̀ gɩsɩnta gɩɩ gɛtà gepepe. Bɔɔ bʋnʋn bʋ̀ ba gɩsaa anlɛ bɛdɩrɛ bɔɔ bʋnʋn, gɛ bɛ̀ ba ɔsa anlɛ idon yaanɩ yɩɩ bɛkwalan.<verse eid="1CH 12:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9" />Eseri n di bɔɔndɩrɛ,</para>
  <para style="li1" vid="1CH 12:9">wɔmalɛ n di Obadiya, boosiyeefɛ n di Eliyabi.<verse eid="1CH 12:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10" />Ɛnaafɛ n di Misimana, gɛ etonfɛ n di Yeremiya.<verse eid="1CH 12:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11" />Ekooronfɛ n di Atayi, gɛ ɛkwarankɩfɛ n di Eliyeli.<verse eid="1CH 12:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12" />ɛnɩyɛfɛ n di Yohanan, gɛ ɛyɛkɩfɛ n di Elisabadi.<verse eid="1CH 12:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13" />Efwofɛ n di Yeremiya, gɛ fwo-ɛkɩfɛ n di Makibanayi.<verse eid="1CH 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />Gadi bɩtà bʋʋ bɛtàlɛ nyabɛ bè di gɛ bɩtà bʋʋ bɛtàlɛ bɔɔ bɛndɩrɛ. Baanɩ ɛpɩɩ-kɩlɩn ɛ̀ talɩ e ten ma bɛnɩ akpilin ton èè di boo koro, gɛ ɛndɩrɛ-kɩlɩn ɛ̀ talɩ e ten ma bɛnɩ nkpɩn ton èè di boo koro. <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />Gɩkyan gɩkɩ giibon-gyangbasɛ anɩ, gɛtɛ Yodan getu gɩ yɔn gɩ walɩ powu fɔ, ɛbɛ n di bɛnɩ gɛtɛ bɛ kààrà getu fɔ bɛ san bɛ ma berema bɛnɩ powu gɛtɛ bɛ̀ sa atagba fɔ yaanɩ, ofila wʋʋ gɛtàkʋn wʋʋ gɩlan, ma ofila wʋʋ gɛnʋ̀nkʋn wʋʋ gɩlan powu fɔ.<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />Benyamin bɛnɩ bɛkɩ ma Yuda beteni bɛkɩ mɔ bɛ ma fɩya ma Dafidi, ɔkʋn gɛtɛ ekengbelilɛ ɛkɩ ɛn talɩ egyu fɔ. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />Gɛtɛ Dafidi e ye gɛtɛ ɛ̀ɛ̀ ma tuma bɛ fɔ, ɛ dɔ̀ bɛ alan, &lt;&lt;Gengyi ɩ ba olila waanɩ, gɛtɛ yàà bɛ kpà mɩ fɔ, ɛwʋ bɩrɛ nan yɛ yɩ yàà bɛ mɛ ɛkɩlɩn ma nmɩ. Mɔ gengyi ɩ ba gɛtɛ yàà bɛ gban mɩ ɩ sa mɩɩn bɛkyʋnlɛ baalɔ yaanɩ, ma gɛtɛ mɩn mɛ ade-kpen ɩkɩ gba lɛ fɔ, ɛwʋ bɩrɛ tiitu ɛbɛ boo Wurubwarɛ e we yɩ, fɔ èè tin yɩ dɩpwɛ.&gt;&gt;<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />Ɛwʋ gɛ Wurubwarɛ gifiye gɩ bɛ gyaga Amasayi gɛtɛ è di bɛnɩ dikpilin ma fwo fɔ bɔɔndɩrɛ fɔ wo koro, gɛ ɛ dɔ̀ alan,</para>
  <para style="q1" vid="1CH 12:18">&lt;&lt;Oo Dafidi, tì di gɛ aayo!</para>
  <para style="q2" vid="1CH 12:18">Oo Yese wobi, tɩ̀ fɩya ma awɔ!</para>
  <para style="q1" vid="1CH 12:18">Olila, olila wʋ sara ma awɔ,</para>
  <para style="q2" vid="1CH 12:18">gɛ olila wʋ sara ma ɛbɛ gɛtɛ bɛɛ kpà wɔ̀ fɔ,</para>
  <para style="q2" vid="1CH 12:18">yema aa Wurubwarɛ ɛɛ̀ kpà wɔ̀.&gt;&gt;</para>
  <para style="p" vid="1CH 12:18">Okoro Dafidi e to bɛ gɛ ɛ mɛ bɛ bɩtà bʋʋ bɛtàlɛ akpi-akpi yii begyegeyelɛ.<verse eid="1CH 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />Manase wofoli wʋʋ bɛnɩ bɛkɩ bɛ ma fɩya ma Dafidi, ɔkʋna gɛtɛ ɛ fɩya ma Filisiti bete gɛ bɛ ma kpa ma Sawulo fɔ. (Mɔ Dafidi ma wɔ bɛnɩ fɔ bɛn ma kpà gɛ Filisiti bete, yema gɛtɛ Filisiti bete bɛ ka ayu be ten be were fɔ, be berema Dafidi. Bɛɛ dɔ̀ be wùlà alan, &lt;&lt;Gengyi Dafidi è biri ɛ ma fɩya ma wofonte Sawulo fɔ, ti ku ti lulu.&gt;&gt;) <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />Gɛtɛ Dafidi ɛ san Sikilagi fɔ, bɛnɩ gɛtɛ bɛ ma fɩya ma ɛwɔ fɔ n di Adina, ma Yosabadi, ma Yediyayeli, ma Mikayeli, ma Yosabadi, ma Elihu, ma Siletayi. Bè di Manase wofoli wʋʋ bɩtà bɔɔ bɛtàlɛ bɔɔ bɛndɩrɛ gɛtɛ bɛnɩ nkpɩn ton bɛ̀ sa baanɩ-kamasɛ wɔ gatɩn. <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />Bɛ kpà Dafidi e di bɛnɩ akpi-akpi fɔ boo koro, yema ɛbɛ powu bè di gɛ bɩtà bʋʋ bɛtàlɛ gɛtɛ bɛ̀ ba oturu, gɛ bè di gɛ bɩtà bʋʋ bɛtàlɛ bɔɔ bɛndɩrɛ. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />Duwi n di duwi, bɛnɩ-fon bɛɛ bɛ fɩya ma Dafidi, ka ma ye gɛtɛ e wura bɩtà bʋʋ bɛtàlɛ ma ɔkɛma kpekpesi anlɛ Wurubwarɛ bɩtà bʋʋ bɛtàlɛ dikpi.<verse eid="1CH 12:22" /></para>
  <para style="s1">Bɛnɩ-fon bɛ bɛ fɩya ma Dafidi Hebron ditele daanɩ</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />Bɛnɩ gɛtɛ bɛ ban gbagya, gɛtɛ bɛ ma fɩya ma Dafidi, Hebron ditele daanɩ, gɛtɛ bàà ma to bugyu fɔ ye Sawulo gʋlɔ gaanɩ bɛ tɛ Dafidi, anlɛ gɛtɛ Yahwe ɛ fʋrʋma ɛ dɔ̀ fɔ baasɔ n tɛ ba lɛ.<verse eid="1CH 12:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24" />Yuda bete gɛtɛ bè de awɔrɔnyan-dɩyɛlɛ koro, ma bɩsɩnta tɛ akpa fɔ bɛ̀ ba ɩgbaa isiyee ma nkpɩn bɩnaa (6,800).<verse eid="1CH 12:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25" />Simeyon bɛnɩ gɛtɛ bɛ pɩna koro bɛ tɛ akpa fɔ bɛ̀ ba ɩgbaa isiyee ma nkpɩn ton ma akpilin ton (7,100). <verse eid="1CH 12:25" /><verse number="26" style="v" sid="1CH 12:26" />Lefi bɛnɩ bɛ̀ ba ɩgbaa ɩnyɔɔ ma nkpɩn bisiyee (4,600), <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />fɩya ma Yehoyada, gɛtɛ è di Aaron dɩkpaara dɩɩndɩrɛ gɛtɛ è de bɛnɩ gbaa ma nkpɩn nɩyɛ ma akpilin ton (3,700), <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />ma Sadoki gɛtɛ è di ɛsaranyan, gɛ è di bɩtà bʋʋtàlɛ-dɩrɛ fɔ, ma bɩtà bʋʋ bɛtàlɛ bɔɔ bɛndɩrɛ dikpilin ma bɛnyɔɔ (22) gɛtɛ be ye Sadoki wafʋrɩ yaanɩ.<verse eid="1CH 12:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29" />Benyamin wofoli wʋʋ bɛnɩ, gɛtɛ bè di Sawulo wonobi ɛbɛ fɔ bɛ̀ ba bɛnɩ ɩgbaa ɩnyɔɔ ma nkpɩn ton. Yema ɔya wʋtɔkɔ waanɩ fɔ, baanɩ kpekpesi bɛ̀ sangba bɛ̀ tɛrɛma Sawulo.<verse eid="1CH 12:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30" />Efrayim wofoli wʋʋ bɛnɩ bɛ̀ ba disepekyi dɩkɩ ma nkpɩn bɩnaa (20,800). Bè di gɛ bɩtà bʋʋ bɛtàlɛ gɛtɛ bɛ̀ ba oturu gɛ baayere i ye baakpaara yaanɩ.<verse eid="1CH 12:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31" />Bɛnɩ gɛtɛ Manase wofoli-fan wʋʋ bɛnɩ be tiri gɛtɛ bàà ma yela bɔɔ gɩsɩrɩ, fɔ bàà sɩ̀ Dafidi bugyu fɔ bɛ̀ ba ɩgbaa yɛkɩ (18,000).<verse eid="1CH 12:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32" />Isaka wofoli wʋʋ bɛnɩ gɛtɛ bɛ kɛrɛ ade bɛ nya, gɛ be we ɛwʋ gɛtɛ wʋ̀ kɔlɔ, ma ɔya gɛtɛ wʋ kʋtʋma gɛtɛ Isareli ɛ̀ɛ̀ mɛ ade ɩkɩ fɔ, bɛ̀ ba bɛndɩrɛ gɛkpɩn (200), fɩya ma bɔɔ bɛfʋrɩ powu gɛtɛ bɛ̀ sa ɛbɛ bɛndɩrɛ fɔ bɔɔ gatɩn.<verse eid="1CH 12:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33" />Sebulun wofoli wʋʋ bɛnɩ bɛ̀ ba asepekyi anyɔɔ ma ɩgbaa ton (50,000). Bè di bɩtà bʋʋ bɛtàlɛ gɛtɛ bɛ̀ nyɩ̀ akpa yaanyan-kamasɛ yaade. Bɛ ka booturu powu bɛ ba bàà be yela Dafidi gama.<verse eid="1CH 12:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34" />Nafitali wofoli waanɩ fɔ, akpa yii begyegeyelɛ nkpɩn ton (1000), ma bɩtà bʋʋ bɛtàlɛ disepekyi ma ɩgbaa nɩyɛ ma nkpɩn ton (37,000). Bè di bɛnɩ gɛtɛ bɛ̀ nyɩ̀ gɩwɔrɔnyan-dɩyɛlɛ koro ma bɩsɩnta buu geton.<verse eid="1CH 12:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35" />Dan wofoli wʋʋ bɛnɩ gɛtɛ bɛ ban gbagya fɔ bɛ̀ ba disepekyi ma ɩgbaa ɩnaa ma nkpɩn bisiyee (28,600).<verse eid="1CH 12:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36" />Aseri wofoli wʋʋ bɛnɩ gɛtɛ bɛ̀ nyɩ̀ akpa yaade gepepe gɛtɛ bɛ pɩna koro tɛ bɩtà fɔ, bɛ̀ ba asepekyi anyɔɔ (40,000).<verse eid="1CH 12:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37" />Ifoli gɛtɛ ɩ̀ sa Yodan getu-fen, gɛtɛ ɛyɩ n di Ruben wofoli, ma Gadi wofoli, ma Manase wofoli-fan fɔ, yɩɩ bɛnɩ bɛ̀ ba bɛnɩ asepekyi kooron (120,000). Bɛ̀ ba akpanyan kperen-kperen.<verse eid="1CH 12:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 12:38" />Gɛlɛ gɩɩ bɛnɩ nyabɛ powu bè di gɛ bɛnɩ gɛtɛ bɛ ka koro bɛ tɛ gɛtɛ bàà kpà akpa fɔ. Ɛbɛ powu bɛ ka ɔnʋn-sɩna bɛ ba Hebron bàà bɛ̀ sɩ̀ Dafidi bugyu tɛ Isareli powu. Isareli bete-kurumakyɛɛ mɔ bè yela tɛ Dafidi bugyu buu gedi. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />Be di awi asiyee Dafidi wakʋn dʋkɔ. Be di gɛ bɛ nyʋn, yema bɔɔ bɛfʋrɩ bɛ pɩna koro bɛ tɛ gedi ma gɛnyʋn yaade. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />Gɛlɛ ke gɛ bɔɔ bɛfʋrɩ gɛtɛ be ye ɔfɔ anlɛ Isaka bɛnɩ, ma Sebulun bɛnɩ, ma Nafitali bɛnɩ fɔ bɛ ka anyan-dilɛ bɛ gyaga akpɔŋɔ, ma abengyi, ma akpɔŋɔ-tɩtɩɩ yii koro, fɩya ma bɛnan bɛ san. Ɔnʋmʋ, ma figi wo keki, ma resin wo keki, ma wayɩn, ma bʋnɔ, ma bɛkwɔ ma bɛyɛran ma begbebi ɩ gbintin, yema bee di ɔsɛ Isareli.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s1">Be birima Dikola dɩɩ dɩdaka fɔ bɛ san Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />Wʋʋ gama fɔ Dafidi e tuma ma bɩtà bʋʋ bɛndɩrɛ fɔ powu gɛtɛ bɩtà bʋʋ bɛtàlɛ nkpɩn ton-ton, ma ɛbɛ gɛtɛ akpilin ton-ton bɛ̀ sa bɔɔ gatɩn fɔ. <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />Ɛwʋ gɛ ɛ dɔ̀ Isareli dɩtɩnpan gɛtɛ di tuma dʋkɔ fɔ powu alan, &lt;&lt;Gengyi wʋ̀ kɔlɔ tɛ yɩ, gɛ gengyi wù di gɛ Yahwe, tii Wurubwarɛ gelenbi fɔ, ɩ yɛ taà sa bɛnɩ tɩɩ bɛfʋrɩ-kurumakyɛɛ Isareli bete fɔ baakʋn, Isareli gɛtʋnkwaa powu gaanɩ. Taà sa bɛnɩ gedi gɩɩ bɛtɛlɛ ma Lefi bete gɛtɛ bè si ma ɛbɛ, baatele yaanɩ, ma bɔɔ bɛnan baadikʋn yaanɩ fɔ bàà bɛ̀ fɩya ma ɛtɩ. <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />Fɔ taà birima Dikola dɩɩ dɩdaka fɔ tɩ ba taakʋn, yema ɔkʋna gɛtɛ Sawulo ee di bugyu fɔ, tin lila dii koro.&gt;&gt; <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />Ɛwʋ gɛ dɩtɩnpan fɔ powu di yera ade fɔ, yema ɩ sara ma ɛbɛ powu.<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />Okoro Dafidi ɛ yɛ Isareli bete powu, ye Sihori getu gɛtɛ gɩ̀ sa Egyipiti wɔbalan waanɩ fɔ, ma sere Lebo-Hamati be tuma gɛtɛ bàà ma ka Dikola dɩɩ dɩdaka fɔ ye Kiriyati-Yarim san Yerusalem. <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />Ɛwʋ gɛ Dafidi ma Isareli bete powu bɛ san Bala, gɛtɛ wù di Kiriyati-Yarim, gɛtɛ wù sa Yuda wofoli wʋʋ gɛtʋnkwaa fɔ, gɛtɛ bàà ma ka Wurubwarɛ Dɩdaka gɛtɛ dii wùlà alɛ Yahwe è si kerubi ɛbɛ bɛnyɔɔ boo getite, gɛ wo diyere dɩ̀ gyaga dii koro fɔ ba.<verse eid="1CH 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7" />Be tiri Dɩdaka fɔ be ye Abinadabi dɩkpaara daanɩ bɛ ma gyaga tiiramisan-fon wo koro, gɛ Usa ma Ahiyo bee wùlà tiiramisan fɔ osele. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />Dafidi ma Isareli bete powu bɛ ka bɔɔkɛma powu bɛ tà abin, ma adʋlɛ, ma akyaka, ma agongon, ma ɩnʋn yɩɩ gɛnʋma gɛ bɛ fʋ̀n akantan be di ɔsɛ Yahwe bʋnʋn.<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />Gɛtɛ be gyu Kidon wamɔrɔ yii getibakʋn fɔ, ɛkwɔ fɔ ɛ sarɩ, gɛ Usa ɛ sama gʋlɔ ɛ kɔlɩ dɩdaka fɔ. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />Disere-kɩlɩn fɔ, Yahwe wowurufa wʋ ba Usa wo koro, yema ɛ kya dɩdaka fɔ okoro. Usa e ku dʋkɔ Wurubwarɛ bʋnʋn.<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />Wʋ taga Dafidi yema Yahwe wowurufa-dɩrɛ wʋ ba Usa wo koro, gɛ bè ye ma ǹdò bee kpèlè dʋkɔbɛ alɛ Peresi-Usa.<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="ft" closed="false">Peresi-Wusa gɛtɛ wuu wùlà alɛ Wurubwarɛ wowurufa wʋ tɔ Wusa wo koro</char></note><verse eid="1CH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12" />Gɛ Dafidi e serenti Yahwe duwi dɩtɔkɔ, gɛ e lila alan, &lt;&lt;Lan gɛ nan mɛ gɛ nan ka Yahwe Dikola dɩɩ dɩdaka nyadɩ n san maakʋn?&gt;&gt; <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />Okoro ɛn mɩnɩ ka Dɩdaka fɔ sɩ̀ wakʋn, ɔkʋn gɛtɛ bee kpèlè Dafidi Ditele-dɩrɛ fɔ daanɩ. Mɔ fɔ ɛ yɛ bɛ ka dɩ bɛ ma sɩ̀ Gati-te gɛtɛ bee kpèlè Obedi-Edom fɔ dɩkpaara daanɩ. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />Wurubwarɛ Dɩdaka fɔ dɩ wɔ dɩ dʋrɔ Obedi-Edom dɩkpaara daanɩ bebon besiyee, gɛ Yahwe e hira wɔ dɩkpaara dɩɩ bɛnɩ, ma gɩnyan-kamasɛ gɛtɛ e wura fɔ.<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s1">Dafidi dɩkpaara ma wɔsɔ ɛbɛ ma wo bebi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />Wʋʋ gama fɔ, Tire wogyu-dɩrɛ Hiram ɛ sa bɛnɩ Dafidi wakʋn ma seda wo-iyon, ma akwo yii beserelɛ, ma iyon yɩɩ bɛsalɩlɛ bàà ma sere digyu-kpaara tɛ Dafidi. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />Okoro Dafidi e we ɛ nyɩnla gɛtɛ Yahwe na sɩ̀ wɔ bugyu fɔ ɛ tɛ Isareli, gɛ ɛɛ yɛ wo bugyu fɔ bʋʋ san bʋnʋn wɔ bɛnɩ Isareli bete fɔ boo koro.<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />Dafidi e to bɛna kpekpesi Yerusalem dʋkɔ, gɛ be wo bebi-teni ma bebi-nanɩ kpekpesi bɛ tɛ wɔ. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />Bebi gɛtɛ be wo bɛ tɛ wɔ dʋkɔ fɔ n di Samuwa, ma Sobabi, ma Natan, ma Solomon, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />ma Ibihari, ma Elisuwa, ma Elipeleti, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />ma Noga, ma Nefegi, ma Yafiya, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />ma Elisama, ma Beeliyada, ma Elifeleti.<verse eid="1CH 14:7" /></para>
  <para style="s1">Dafidi e di Filisiti bete boo koro</para>
  <para style="r">( 2 Samuweli 5.17-25)</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />Gɛtɛ Filisiti bete bɛ nʋn gɛtɛ bɛ sʋrʋ Dafidi bʋnɔ bɛ sɩ̀ bugyu bɛ tɛ Isareli powu fɔ, bɛ ka bɔɔkɛma powu bɛ san bàà ma gye wɔ. Mɔ gɛtɛ Dafidi ɛ nʋn ade fɔ, e ye ɛ san ɛ̀ɛ̀ ma ten ma ɛbɛ. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />Ɛwʋ gɛ Filisiti bete bɛ san Refayim dɩtagba daanɩ, gɛ bɛ kya Refayim bete baanyan yii gekpila. <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />Ɛwʋ gɛ Dafidi ɛ lila Yahwe alan, &lt;&lt;Wù di gɛtɛ nan san n ma kpà ma Filisiti bete fɔ? Aà ka bɛ a sa mɩɩn gʋlɔ gaanɩ?</para>
  <para style="p" vid="1CH 14:10">Gɛ Yahwe e tiri wuunyun alan, &lt;&lt;San, nan ka bɛ n sa aa gʋlɔ!&gt;&gt; <verse eid="1CH 14:10" /><verse number="11" style="v" sid="1CH 14:11" />Okoro Dafidi ma wɔ bɩtà bʋʋ bɛtàlɛ bɛ tɔ bɛ san Baali-Perasim, gɛ e di boo koro dʋkɔ. Ɛ dɔ̀ alan, &lt;&lt;Wurubwarɛ ɛ da ma miin koro ɛ yasɩ mɩɩn bɛkyʋnlɛ anlɛ gɛtɛ getu-yonlɛ gii butu bʋʋ nyʋn fɔ. Okoro gɛ bee kpèlè dʋkɔ alɛ Baali-Perasim fɔ. <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />Gɛtɛ Filisiti bete fɔ be serenti be kere boo bekpen bɛ ya fɔ, Dafidi ɛ yɛ be kuma bɛ.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />Wʋʋ gama fɔ, Filisiti bete be biri bɛ ba dɩtagba fɔ daanɩ bee kpila anyan. <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />Okoro Dafidi e biri e lila Wurubwarɛ ade gɛtɛ ɛɛ̀ mɛ, gɛ Wurubwarɛ e tiri wuunyun alan, &lt;&lt;Ɩ kara bʋn tɩɩn ɩ ma tàmà bɛ, mɔ fɔ, ɩ kya bɛ ɩ sa getite, fɔ yàà kya bɛ bɩtà bʋʋ gɛtà i ye balisam wo-iyon yɩɩ gɩlan. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />Gengyi à bɔ a nʋn bɩsɩrɩ baagingin balisam wo-iyon fɔ yaayu yaanɩ fɔ, sere bɩtà bʋʋ gɛtà, yema ɛwʋ nan wùlà alɛ nmɩ Wurubwarɛ ǹ san aa bʋnʋn gɛtɛ nte di Filisiti bete bɔɔ bɩtà bʋʋ bɛtàlɛ boo koro.&gt;&gt; <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />Ɛwʋ gɛ Dafidi ɛ mɛ anlɛ gɛtɛ Wurubwarɛ ɛ dɔ̀ wɔ fɔ, gɛ be wolo Filisiti bɩtà bʋʋ bɛtàlɛ, ye Gibeyon ma sere Geseri.<verse eid="1CH 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17" />Okoro Dafidi diyere dɩ yasɩ gɛtʋnkwaa-kamasɛ gaanɩ, gɛ Yahwe ɛ yɛ bɩfɩɩ powu bu serenti Dafidi.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s1">Bɛ ka Dɩdaka fɔ bɛ ba Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />Dafidi e sere akwo ɛ tɛ koro ɔkʋn gɛtɛ bee kpèlè alɛ Dafidi-Ditele, gɛ ɛ pɩna ɔkankɩ ɛ sɩ̀ gɛtɛ Wurubwarɛ Dɩdaka fɔ dàà bɛ dʋrɔ, gɛ e sere Dɩyan dii Dikwo ɛ tɛ dɩ. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />Ɛwʋ gɛ Dafidi ɛ dɔ̀ alan, &lt;&lt;Lefi bete booko n ba osele gɛtɛ bàà tola Dikola dɩɩ dɩdaka fɔ, yema ɛbɛ gɛ Yahwe e tiri gɛtɛ bàà tola wo Dikola dɩɩ dɩdaka fɔ, fɔ bàà mɛ dɩsʋma dɩɩ gʋtʋn gakpaakpa.&gt;&gt;<verse eid="1CH 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3" />Ɛwʋ gɛ Dafidi e kpèlè Isareli bete powu e tuma Yerusalem gɛtɛ bàà ka Yahwe Dikola dɩɩ dɩdaka fɔ ba ɔkʋn gɛtɛ ɛ pɩna ɛ sɩ̀ dɩ fɔ. <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" />Dafidi e kpèlè Aaron ma Lefi boo-idu yɩɩ bɛnɩ e tuma.<verse eid="1CH 15:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5" />Kohati dɩkpaara daanɩ fɔ, e kpèlè</para>
  <para style="li2" vid="1CH 15:5">Wuriyeli gɛtɛ è di dɩkpaara dɩɩndɩrɛ fɔ, ma bɛfʋrɩ-bɛfʋrɩ akpilin kooron (120).<verse eid="1CH 15:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6" />Merari dɩkpaara daanɩ fɔ, e kpèlè</para>
  <para style="li2" vid="1CH 15:6">dɩkpaara dɩɩndɩrɛ Asiya ma bɛfʋrɩ-bɛfʋrɩ gɛkpɩn ma dikpilin (220).<verse eid="1CH 15:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7" />Gerison dɩkpaara daanɩ fɔ, e kpèlè</para>
  <para style="li2" vid="1CH 15:7">dɩkpaara dɩɩndɩrɛ Yoweli, ma bɛfʋrɩ-bɛfʋrɩ akpilin kooron ma fwo (130).<verse eid="1CH 15:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8" />Elisafan dɩkpaara daanɩ fɔ, e kpèlè</para>
  <para style="li2" vid="1CH 15:8">dɩkpaara dɩɩndɩrɛ Semaya, ma bɛfʋrɩ-bɛfʋrɩ gɛkpɩn (200).<verse eid="1CH 15:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9" />Hebron dɩkpaara daanɩ fɔ, e kpèlè</para>
  <para style="li2" vid="1CH 15:9">dɩkpaara dɩɩndɩrɛ Eliyeli, ma bɛfʋrɩ-bɛfʋrɩ akpilin anaa (80).<verse eid="1CH 15:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10" />Wusiyeli dɩkpaara daanɩ fɔ, e kpèlè</para>
  <para style="li2" vid="1CH 15:10">dɩkpaara dɩɩndɩrɛ Aminadabo, ma bɛfʋrɩ-bɛfʋrɩ akpilin ton ma fwo bɛnyɔɔ (112).<verse eid="1CH 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />Gɛ Dafidi e kpèlè gedi gɩɩ bɛtɛlɛ bɔɔ bɛndɩrɛ Sadoki ma Abiyata, fɩya ma Lefi bete Wuriyeli, ma Asaya, ma Yoweli, ma Semaya, ma Eliyeli, ma Aminadabo e tuma. <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />Gɛ ɛ dɔ̀ bɛ alan, &lt;&lt;Ɛyɩ n di Lefi bete baakpara fɔ yɩɩ bɛndɩrɛ. Wù di gɛtɛ ɛyɩ ma yɩɩ bɛfʋrɩ Lefi bete yàà kpa koro dɩdɩɩ, fɔ yàà ma ka Yahwe, Isareli wo Wurubwarɛ Dikola dɩɩ dɩdaka fɔ ɩ ba ɔkʋn gɛtɛ na pɩna na sɩ̀ dɩ fɔ. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />Gɛtɛ nka ɛyɩ Lefi bete na tola Dɩdaka fɔ dɩgyangbasɛ fɔ wuu koro gɛ Yahwe e tiira tɩ giten. Tin lila wɔ anlɛ gɛtɛ wù di gɛtɛ taà ka ti tola dɩ.&gt;&gt; <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />Ɛwʋ gɛ gedi gɩɩ bɛtɛlɛ ma Lefi bete fɔ bɛ kpa koro dɩdɩɩ gɛtɛ bàà ma ka Yahwe, Isareli wo Wurubwarɛ Dɩdaka fɔ. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />Ɛwʋ gɛ Lefi bete fɔ bɛ ma ka Dɩdaka fɔ dii-iyon bɛ gyaga baagongyi yii koro anlɛ gɛtɛ Yahwe ɛ da ma Mose wo koro ɛ dɔ̀ alɛ bàà mɛ fɔ.<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />Gɛ Dafidi ɛ dɔ̀ Lefi bete bɔɔ bɛndɩrɛ fɔ alɛ be tiri bɔɔwɔlɔn ɛbɛ bɛkɩ bàà mɛ ɩnʋn yɩɩ bɛnʋmalɛ gɛtɛ bàà ka adʋlɛ ɛbɛ, ma akyaka bɛ nʋma ɔsɛ wʋʋ-ɩnʋn.<verse eid="1CH 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17" />Okoro Lefi bete fɔ be tiri Yoweli wobi Heman. Wɔ bɛnɩ baanɩ fɔ, be tiri Berekiya wobi Asafu. Gɛ bɔɔwɔlɔn ɛbɛ Merari bete baanɩ fɔ, be tiri Kusaya wobi Etan. <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />Boonobi ɛbɛ gɛtɛ bɛ̀ gyaga boo koro fɔ n di Sekariya, ma Yaasiyeli, ma Semiramoti, ma Yehiyeli, ma Uni, ma Eliyabi, ma Benaya, ma Maaseya, ma Matitiya, ma Elifelehu, ma Mikineya, fɩya ma Obedi-Edom, ma Yayeli gɛtɛ bè di otunu wʋʋ bɛnyalɛ fɔ.<verse eid="1CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19" />Ɩnʋn yɩɩ bɛnʋmalɛ Heman, ma Asafu, ma Etan n tɛ gbɛrɛ gɩwɔrɔnyan-sɩya gaakyaka fɔ. <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />Sekariya, ma Asiyeli, ma Semiramoti, ma Yehiyeli, ma Wuni, ma Eliyabi, ma Maaseya, ma Beneya n tɛ tà adʋlɛ ɛbɛ gɛtɛ bɛ̀ ba bɩta-pɩɩ fɔ. <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />Matitiya, ma Elifelehu, ma Mikineya, ma Obedi-Edom, ma Yeyeli, ma Asasiya na tà adʋlɛ ɛbɛ gɛtɛ bɛ̀ ba bɩta-dɩrɛ fɔ. <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />Lefi bete bɔɔndɩrɛ Kenaniya yema gɛtɛ ɛ̀ nyɩ̀ ɩnʋn yɩɩ gɛnʋma gaade yaanɩ okoro, bɛ sɩ̀ wɔ ɩnʋn yɩɩ bɛnʋmalɛ bɔɔndɩrɛ.<verse eid="1CH 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23" />Berekiya ma Elikana na mɛ Dɩdaka fɔ diitunu wʋʋ bɛnyalɛ. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />Gedi gɩɩ bɛtɛlɛ Sebaniya, ma Yosafati, ma Netaneli, ma Amasayi, ma Sekariya, ma Benaya, ma Eliyeseri na mɛ bɛnɩ gɛtɛ bɛ fʋ̀n akantan Wurubwarɛ Dɩdaka fɔ dɩɩ bʋnʋn. Obedi-Edom ma Yehiya mɔ ke na mɛ Dɩdaka fɔ diitunu wʋʋ bɛnyalɛ.<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />Ɛwʋ gɛ Dafidi ma Isareli bɛndɩrɛ ma bɩtà bʋʋ bɛndɩrɛ gɛtɛ bɛɛ nya bɩtà bʋʋ bɛtàlɛ nkpɩn ton-ton boo koro fɔ bɛ san bɛ ma ka Yahwe Dikola dɩɩ dɩdaka fɔ be ye Obedi-Edom dɩkpaara ɔsɛ waanɩ bɛ ba. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />Gɛtɛ Wurubwarɛ ɛ kpà Lefi bete fɔ gɛ be tola Yahwe Dikola dɩɩ dɩdaka fɔ okoro, bɛ ka bɛkwɔ-teni kwarankɩ, ma ayaran-gbʋgbʋ kwarankɩ bɛ tɛ Yahwe gedi. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />Gɛ Dafidi ɛ sa gɛgba-serelɛ-fututu anlɛ gɛtɛ Lefi bete gɛtɛ bè tola Dɩdaka fɔ, ma ɩnʋn yɩɩ bɛnʋmalɛ fɔ, ma Kenaniya gɛtɛ è di ɩnʋn yɩɩ bɛnʋmalɛ bɔɔndɩrɛ fɔ ɛ̀ sa fɔ. Dafidi ɛ sa gɛgba gɛtɛ gii tin diboro fɔ ɛ gyaga. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />Okoro Isareli bete powu bɛ ka Yahwe Dikola dɩɩ dɩdaka fɔ bɛ ba ma afala yɩɩ gɛgbɛrɛ, ma Bɛyɛran baayela yɩɩ gɛfʋ̀n, ma akantan yɩɩ gɛfʋ̀n, ma akyaka yɩɩ gɛgbɛrɛ, ma adʋlɛ ɛbɛ kperen-kperen bɔɔ gɛtà.<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />Gɛtɛ Yahwe Dɩdaka fɔ dii gyu ɔkʋn gɛtɛ bee kpèlè alɛ Dafidi-Ditele fɔ, Sawulo wobi-nanɩ ɛ nya ma nfansɩrɩ, gɛ e we anlɛ gɛtɛ egyu Dafidi ee lèn gɛ ee di ɔsɛ fɔ, ɛ gbɛ̀ɛ̀ Dafidi woturu waanɩ.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />Ɛwʋ gɛ bɛ ka Wurubwarɛ Dɩdaka bɛ ma sɩ̀ Dɩyan dii Dikwo gɛtɛ Dafidi e sere ɛ tɛ dɩ fɔ daanɩ, gɛ bɛ tɛ gekuma gii gedi ma olila wuu gedi Yahwe bʋnʋn. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />Gɛtɛ Dafidi ɛ tɛ gekuma gii gedi, ma olila wuu gedi fɔ e were fɔ, e hira bɛnɩ fɔ Yahwe diyere daanɩ. <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />Wʋʋ gama fɔ, e yo boroboro ɛkɩ-ɛkɩ, ma dati wo keki, ma resin wo keki ɛ tɛ Isareli-te ma Isareli-na kamasɛ.<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />Gɛ e tiri Lefi bete bɛkɩ gɛtɛ bàà tɩ̀ mɛ gʋtʋn Yahwe Dɩdaka fɔ dɩɩpɩ. Bàà gyegeye bɛnɩ fɔ bàà ka onyun wuu getiri, ma onyun wʋʋ gɛsa, ma gesila bɛ tɛ Yahwe, Isareli wɔ Wurubwarɛ fɔ. <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />Asafu n di boogyeyelɛ, gɛ Sekariya è di wɔmalɛ. Yeyeli, ma Semiramoti, ma Yehiyeli, ma Matitiya, ma Eliyabi, ma Benaya, ma Obedi-Edom, ma Yeyeli n tɛ tà adʋlɛ ɛbɛ kperen-kperen fɔ. Gɛ Asafu ɛ gbɛrɛ akyaka fɔ. <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />Gedi gɩɩ bɛtɛlɛ Benaya ma Yahasiyeli ntɛ fʋ̀n akantan Wurubwarɛ Dikola dɩɩ dɩdaka fɔ dɩɩpɩ ɔya-kamasɛ.<verse eid="1CH 16:6" /></para>
  <para style="s1">Dafidi wonyun wʋʋ gɛsa gɩɩnʋn</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />Duwi dɩtɔkɔ n di dɩgyangbasɛlɛ gɛtɛ Dafidi ɛ ka ɩnʋn yɩɩ gɛnʋma-sa Wurubwarɛ onyun ɛ sa Asafu ma wɔwɔlɔn ɛbɛ Lefi bete fɔ baalɔ yaanɩ. Ɔnʋn fɔ n di alɛ,<verse eid="1CH 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8" />Oo, ɩ ka onyun wʋʋ gɛsa ɩ tɛ Yahwe, i kpèlè wo diyere.</para>
  <para style="q2" vid="1CH 16:8">Ɩ yasɩ wade-dɩrɛ gɛtɛ ɛ mɛ fɔ ɩ tɛ bɩfɩɩ.<verse eid="1CH 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9" />Ɩ nʋma ɩnʋn ɩ tɛ wɔ, ɩ nʋma gesila gɩɩ-ɩnʋn ɩ tɛ wɔ.</para>
  <para style="q2" vid="1CH 16:9">Ɩ dɔ̀ wade-dɩrɛ ma gɩsaa yaade.<verse eid="1CH 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10" />Ɩ ka wo diyere-fɩrɩnfɩrɩn fɔ ɩ kɩntɩn,</para>
  <para style="q2" vid="1CH 16:10">ɩ yɛ ɛbɛ gɛtɛ bee bugiti Yahwe fɔ bàà di ɔsɛ boo-ituru yaanɩ.<verse eid="1CH 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11" />I bugiti Yahwe, fɔ yàà wura wɔkɛma,</para>
  <para style="q2" vid="1CH 16:11">I bugiti wɔ ɔya-kamasɛ fɔ ɛ̀ɛ̀ kpa yɩ.<verse eid="1CH 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12" />Ɩ kʋna ade ma gɩsaa gɛtɛ ɛ mɛ fɔ,</para>
  <para style="q2" vid="1CH 16:12">Ɩ kʋna wapenterebi ma wɔ dɩpwɛ dii getin.<verse eid="1CH 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13" />Oo, ɛyɩ Wurubwarɛ bɛsaranyan Isareli wodu wʋʋ bɛnɩ,</para>
  <para style="q2" vid="1CH 16:13">Oo, Yakobu bɛnɩ, bɛnɩ gɛtɛ e tiri ɛ mɛ woyo.<verse eid="1CH 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14" />Ɛwɔ n di Yahwe, tii Wurubwarɛ,</para>
  <para style="q2" vid="1CH 16:14">wɔ dɩpwɛ dii getin gɩyasɩ gɛtʋnkwaa powu gii koro.<verse eid="1CH 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15" />Ɛɛ kʋna wo Dikola fɔ dii koro gakpaakpa,</para>
  <para style="q2" vid="1CH 16:15">wade gɛtɛ ɛ dɔ̀ ɛ tɛ gewo-tama giidu nkpɩn ton-ton fɔ,<verse eid="1CH 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16" />ɛyɩ n di dikola gɛtɛ ɛ tà ma Abraham fɔ,</para>
  <para style="q2" vid="1CH 16:16">ntam gɛtɛ ɛ kan ɛ tɛ Isaki fɔ.<verse eid="1CH 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17" />Ɛ da ma dii koro ɛ ka ɛ mɛ ose ɛ tɛ Yakobu,</para>
  <para style="q2" vid="1CH 16:17">Ɛ dama dii koro ɛ ka ɛ mɛ dikola dɩɩ gɛtà gakpaakpa ɛ tɛ Isareli.<verse eid="1CH 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18" />Wanyungyebi fɔ n di alan, &lt;&lt;Awɔ gɛ nan ka Kanaan gɛtʋnkwaa n tɛ,</para>
  <para style="q2" vid="1CH 16:18">gàà mɛ aa gedikʋn.&gt;&gt;<verse eid="1CH 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19" />Ɔkʋna gɛtɛ bè we gɛ bɛrɛɛ lɛ fɔ,</para>
  <para style="q2" vid="1CH 16:19">Gɛtɛ bɛn sɔ, gɛ bè di gɛ besela gaanɩ fɔ,<verse eid="1CH 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20" />be silin bè ye gɩfɩɩ nyagɩ gaanɩ fɔ, bɛ da gido gaanɩ,</para>
  <para style="q2" vid="1CH 16:20">bè ye bugyu buu gedikʋn gɩkɩ gaanɩ fɔ, bɛ da gido gaanɩ.<verse eid="1CH 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21" />Ɛn yɛ ɛnɩ ɛkɩ ɛ̀ɛ̀ nyanla bɛ,</para>
  <para style="q2" vid="1CH 16:21">Boo koro, ɛ tabʋrʋ ɛ sʋ begyu ɛ sa.<verse eid="1CH 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22" />Ɩ kara kya mɩɩn bɛnɩ gɛtɛ na sʋrʋ bʋnɔ,</para>
  <para style="q2" vid="1CH 16:22">gɛ ɩ kara mɛ mɩɩn bɛtabʋrʋlɛ ade-kpen ɩkɩ.<verse eid="1CH 16:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23" />Oo, gɛtʋnkwaa powu gɩɩ bɛnɩ, ɩ nʋma ɩnʋn i sila Yahwe,</para>
  <para style="q2" vid="1CH 16:23">Ɩ yasɩ wo getoya gaade fɔ duwi n di duwi.<verse eid="1CH 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24" />I tiri wo gingyebi i wùlà bɩfɩɩ-bɩfɩɩ</para>
  <para style="q2" vid="1CH 16:24">i tiri wade-dɩrɛ ma gɩsaa i wùlà bɛnɩ powu.<verse eid="1CH 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25" />Yahwe ɛ̀ sɔ, okoro ɛ kʋtʋma gesila-dɩrɛ,</para>
  <para style="q2" vid="1CH 16:25">wù di gɛtɛ bàà serenti wɔ da bekpen powu.<verse eid="1CH 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26" />Yema bɩfɩɩ buu bekpen powu be di gɛ anyan-maralɛ-tuntun,</para>
  <para style="q2" vid="1CH 16:26">mɔ Yahwe na mɛ gatala.<verse eid="1CH 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27" />Gingyebi-dɩrɛ ma gebu-dɩrɛ i silin wɔ i tuma,</para>
  <para style="q2" vid="1CH 16:27">Ɔkɛma ma ɔsɛ ɩ yɔn wɔ gɛsarakʋn fɔ gaanɩ.<verse eid="1CH 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28" />Oo, gɛtʋnkwaa bʋʋ bɩfɩɩ powu, i sila Yahwe,</para>
  <para style="q2" vid="1CH 16:28">i sila wo gingyebi ma ɔkɛma,<verse eid="1CH 16:28" /></para>
  <para style="q2">
    <verse number="29" style="v" sid="1CH 16:29" />ɩ ka gingyebi gɛtɛ gɩ kʋtʋma ma wo diyere fɔ i sila wɔ.</para>
  <para style="q1" vid="1CH 16:29">Ɩ ka gedi gɩɩ gɛtɛ̀ gaanyan ɩ ba wo Dikwo-dɩrɛ fɔ daanɩ,</para>
  <para style="q2" vid="1CH 16:29">ɩ sʋma Yahwe gɛtɛ wɔ gɩfɩrɩnfɩrɩn gɩɩ ŋalagɩ gakpa fɔ.<verse eid="1CH 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 16:30" />Gɛtʋnkwaa gɩɩ bɛnɩ powu, ɩ yɛ koro gàà gbɛrɛ yɩ wɔ bʋnʋn!</para>
  <para style="q2" vid="1CH 16:30">Ɩɩn, gɛtʋnkwaa gì sere kriin, gɩɩn taa kpenti.<verse eid="1CH 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31" />Ɩ yɛ anyan powu gɛtɛ ɩ sa gatala fɔ yàà di ɔsɛ, fɔ gɛtʋnkwaa gàà di ɔsɛ!</para>
  <para style="q2" vid="1CH 16:31">Ɩ dɔ̀ bɩfɩɩ alɛ Yahwe n di egyu-dɩrɛ!<verse eid="1CH 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32" />Ɛpʋ ma anyan gɛtɛ ɩ̀ sa wanɩ powu, ɩ sa bɩta!</para>
  <para style="q2" vid="1CH 16:32">Ili ma yaanyan gɛtɛ ɩ̀ sa yaanɩ powu, i di ɔsɛ!<verse eid="1CH 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33" />Gɩkan gaanɩ gii-iyon yaà nʋma ɩnʋn,</para>
  <para style="q2" vid="1CH 16:33">yaà nʋma ɔsɛ wʋʋ-ɩnʋn Yahwe bʋnʋn,</para>
  <para style="q2" vid="1CH 16:33">yema Yahwe ɛɛ ba ɛ̀ɛ̀ bɛ dɔ̀ gɛtʋnkwaa gɩɩ bɛnɩ bɔɔ gɔdɔ.<verse eid="1CH 16:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34" />Ɩ sa Yahwe onyun, yema ɛ̀ kɔlɔ,</para>
  <para style="q2" vid="1CH 16:34">wo gelen gɩ̀ sa gakpaakpa.<verse eid="1CH 16:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35" />Ɩ dɔ̀ wɔ alan, &lt;&lt;Oo Wurubwarɛ, tiitolɛ-yalɛ, to tɩ ya!</para>
  <para style="q2" vid="1CH 16:35">Kʋla tɩ, fɔ àà tiri tɩ ye bɩfɩɩ bʋʋ gɛnyanla baalɔ yaanɩ,</para>
  <para style="q2" vid="1CH 16:35">fɔ tàà ka onyun wʋʋ gɛsa tɩ tɛ aa diyere-fɩrɩnfɩrɩn fɔ,</para>
  <para style="q2" vid="1CH 16:35">fɔ wàà yɛ taà sila wɔ̀ kɩntɩn.&gt;&gt;<verse eid="1CH 16:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36" />Gesila gì di Yahwe, Isareli wo Wurubwarɛ fɔ woyo!</para>
  <para style="q2" vid="1CH 16:36">Gì di gɛ woyo ye ǹdò san gakpaakpa!</para>
  <para style="m" vid="1CH 16:36">Ɛwʋ gɛ bɛnɩ fɔ powu be yera alan, &lt;&lt;Wʋ̀ ba gɛlɛ! I sila Yahwe!&gt;&gt;<verse eid="1CH 16:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />Ɛwʋ gɛ Dafidi ɛ ka Asafu ma ɛbɛ gɛtɛ bɛ̀ fɩya ma ɛwɔ fɔ ɛ sɩ̀ Yahwe Dikola dɩ Dɩdaka fɔ dɩɩpɩ gɛtɛ bàà tɩ mɛ gʋtʋn ɔya-kamasɛ anlɛ gɛtɛ duwi-kamasɛ dɩɩ dɩsʋma dii wùlà fɔ. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />Gɛ ɛ nɩ yɛ Obedi-Edom ma bɔɔ wɔlɔn ɛbɛ akpilin asiyee ma nɩyɛ (68) fɔ gɛtɛ bàà kpa bɛ gʋtʋn fɔ gaanɩ. Yedutun wobi Obedi-Edom ma Hosa na mɛ otunu wʋʋ bɛdɩyɛlɛ.<verse eid="1CH 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39" />Dafidi ɛ ka gedi gɩɩtɛlɛ Sadoki ma wɔwɔlɔn ɛbɛ gedi gɩɩ bɛtɛlɛ fɔ ɛ ma sɩ̀ Yahwe wɔkʋn-fɩrɩnfɩrɩnkʋn, dɩsʋmakʋn gɛtɛ dɩ̀ sa Gibeyon fɔ daanɩ, <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />gɛtɛ bàà tɩ tɛ Yahwe gekuma gii gedi, gekuma gii gedi gɩɩ gɛtɛ̀kʋn fɔ gii koro, ɔya-kamasɛ, gagyɩgyan ma ɔgyɔlɔ, anlɛ gɛtɛ bɛ ŋwara bɛ sa Yahwe wose waanɩ gɛtɛ ɛ ka ɛ tɛ Isareli fɔ. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />Bɛtɔkɔ bɔɔ gama fɔ e ni tiri Heman, ma Yedutun, fɩya ma ɛbɛ gɛtɛ e tiri, gɛ e kpèlè baayere gɛtɛ bàà tɩ nʋma ɩnʋn be sila Yahwe fɔ, &lt;&lt;yema Wurubwarɛ gelen gɩ̀ sa gakpaakpa.&gt;&gt; <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />Heman ma Yedutun ntɛ nya akantan yɩɩ gɛfʋ̀n, ma akyaka yɩɩ gɛgbɛrɛ, ma anyɩmɩnyan-kurumakyɛɛ yɩɩ gɛtà ma yɩɩ gɛgbɛrɛ bɛ fɩya ma ɩnʋn yɩɩ gɛnʋma. Gɛ Yedutun bebi-teni na mɛ otunu wuu bɛdɩyɛlɛ.<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />Ɛwʋ gɛ bɛnɩ fɔ be ye, gɛ ɛkamasɛ ɛ da wɔlɛ, gɛ Dafidi mɔ ɛ da wɔlɛ ɛ ma hira wɔ dɩkpaara dɩɩ bɛnɩ.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s1">Wurubwarɛ ɛ dɔ̀ ade ɛ sɩ̀ ɛ tɛ Dafidi</para>
  <para style="r">(2 Samweli 7.1-17)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />Gɛtɛ Dafidi e wura e si wo digyu-kpaara daanɩ fɔ, ɛ dɔ̀ Wurubwarɛ wɔtabʋrʋlɛ Natan alan, &lt;&lt;Nya gɛtɛ nmɩ ǹ sa seda iyon yii dikwo daanɩ, mɔ Yahwe Dikola dɩɩ dɩdaka fɔ bɩrɛ dɩ̀ dɔ Dɩyan dii Dikwo daanɩ.&gt;&gt;<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />Gɛ Natan e tiri wuunyun ɛ tɛ Dafidi alan, &lt;&lt;Ade-kamasɛ gɛtɛ ɩ̀ sa aamɩnlɛ waanɩ fɔ, mɛ yɩ, yema Yahwe ɛ̀ fɩya ma awɔ.&gt;&gt;<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />Ɛwʋ gɛ odente wʋtɔkɔ, Yahwe ɛ dɔ̀ Natan wo koro ɛ dɔ̀ alan,<verse eid="1CH 17:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4" />&lt;&lt; San ma dɔ̀ mɩɩnsaranyan Dafidi alɛ Yahwe alan, &lt;Nka awɔ nan sere dikwo a tɛ mɩ nan sara daanɩ. <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />Ye sɩyɛɛ gɛtɛ na tiri Isareli bete na ye Egyipiti bè ye ma ǹdò lɛ, mɩn ta sara dikwo daanɩ n nya. Ntɛ tɔ n ye gɛ Dɩyan dii Dikwo dɩkɩ daanɩ n san dido daanɩ, ye gɛsarakʋn gɩkɩ gaanɩ san gido gaanɩ. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />Ɔkʋn-kamasɛ gɛtɛ na fɩya ma Isareli bete na san fɔ, miin te lila boogyegeyelɛ ɛkɩ gɛtɛ na tiri ɛ̀ɛ̀ nya mɩɩn bɛnɩ boo koro fɔ alan, &lt;&lt;Anʋn yii koro gɛ an sere seda dikwo tɛ mɩ?&gt;&gt; &gt;<verse eid="1CH 17:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7" />&lt;&lt;Okoro, dɔ̀ mɩɩnsaranyan Dafidi alan, &lt;Nmɩ Yahwe, Ɔkɛma powu Wuute fɔ alan, na kpèlè wɔ̀ na ye bɛnan boo geton, ma bɛnan bɔɔ gɛnya gaanɩ gɛtɛ àà bɛ mɛ mɩɩn bɛnɩ Isareli bete boogyegeyelɛ. <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />Na fɩya ma awɔ ɔkʋn-kamasɛ gɛtɛ a san fɔ, gɛ na berema aa bɛkyʋnlɛ powu na ye aa bʋnʋn. Nkele nan yɛ aa diyere dàà ye anlɛ gɛtʋnkwaa gii begyu bɛndɩrɛ-bɛndɩrɛ fɔ. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />Gɛ nan tɛ mɩɩn bɛnɩ Isareli bete gɛsarakʋn, fɔ nan yɛ bɛ bàà sara dʋkɔ, fɔ bàà wura ɛbɛ-gbagba bɔɔ gɛsarakʋn, gɛtɛ ɛnɩ ɛkɩ ɛn nan nɩ ha bɛ. Duyu-kɛma dɩɩ bɛnɩ bɛn nan ni wura bɛ nyanla bɛ anlɛ gɛtɛ bɛ mɛ bɛ bɛ da fɔ, <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />ma ade gɛtɛ bɛ mɛ bɛ ye sɩyɛɛ ɔkʋna gɛtɛ na tiri mɩɩn bɛnɩ Isareli boo begyegeyelɛ fɔ. Nan di aa bɛkyʋnlɛ powu boo koro.</para>
  <para style="pm" vid="1CH 17:10">&lt;&lt; &lt;Ntɛ dɔ̀ wɔ̀ n tana alɛ, nmɩ Yahwe nan sere bugyu bʋʋ dɩkpaara ntɛ awɔ ma aadu waanɩ. <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />Gengyi aawi ɩ̀ nɩma, gɛ à ku fɔ, nan tiri aadu waanɩ wʋʋnɩ ɛkɩ, awɔ-gbagba aabi-teni ɛkɩ èè di bugyu sere aa gɩsɩrɩ. gɛ nan yɛ wo bugyu buu gedi bàà sere ɩkpaa. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />Ɛwɔ nan sere Dikwo ɛ tɛ mɩ, gɛ nan yɛ wo gigyu-bɩya gàà sere ɩkpaa gakpaakpa. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />Nan mɛ wote, gɛ ɛɛ̀ mɛ miinbi. Mɩn nan kere wo gelen n ya, anlɛ gɛtɛ na kere gelen ɛbɛ gɛtɛ be gyegeye wɔ̀ na ya fɔ. <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />Mɔ fɔ nan yɛ ɛ̀ɛ̀ mɛ mɩɩn bɛnɩ ma miin bugyu buu gedi buugyegeyelɛ gakpaakpa. Gɛ wo bugyu buu gedi baà sara gakpaakpa.&gt; &gt;&gt;<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />Ɛwʋ gɛ Natan ɛ ma kasɩ ade-tirilɛ-wùlàlɛ gɛtɛ e we fɔ ɛ tɛ Dafidi.<verse eid="1CH 17:15" /></para>
  <para style="s1">Dafidi wonyun-tiri</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />Ɛwʋ gɛ Dafidi ɛ san ɛ ma sara Yahwe bʋnʋn, gɛ e tiri onyun alan,</para>
  <para style="pm" vid="1CH 17:16">&lt;&lt;Oo, Yahwe Wurubwarɛ, ɛnyan gɛ ǹ di, gɛ ɛnyan ɛbɛ gɛ mɩɩn dɩkpaara dɩɩ bɛnɩ bè di, gɛ aa mɛ ade-dɩrɛ nyayɩ a tɛ mɩ lɛ? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />Oo Wurubwarɛ, ma gɛtɛ a mɛ kpekpesi gba fɔ, nkyɛ wʋʋn ta kʋtɩ wɔ̀ gba, a biri a dɔ̀ ade gɛtɛ aà nɩ mɛ gɩsa ma gɩsarama wʋkɩ a tɛ nmɩ aasaranyan mɩɩn dɩkpaara. Oo Yahwe Wurubwarɛ, a ka mɩ anlɛ ɛnɩ-gbaa ɛkɩ.<verse eid="1CH 17:17" /></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18" />Ade-mɔmɔ gɛ nmɩ Dafidi nan nɩ̀ talɩ n dɔ̀ wɔ̀ gɛtɛ a sa nmɩ aasaranyan gingyebi lɛ? Yema à nyɩ̀ nmɩ aasaranyan. <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />Oo, Yahwe, nmɩ aasaranyan miin koro ma aa gelenbi gii koro gɛ a mɛ ade-dɩrɛ nyayɩ, gɛ a tiri ade dɔ̀lɛ sɩ̀lɛ-dɩrɛ nyayɩ a wùlà lɛ.<verse eid="1CH 17:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20" />&lt;&lt;Oo, Yahwe, ade gɛtɛ tɩ nʋn ma taaten powu fɔ yii koro, ɛkɩ ɛn ma anlɛ awɔ. Aako-kwan n di Wurubwarɛ. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />Gɛ Gɩfɩɩ-mɔmɔ n nɩ sa gɛtʋnkwaa gaanɩ anlɛ aa bɛnɩ Isareli bete, gɛtɛ awɔ Wurubwarɛ a tiri bɛ a ye gɩdɩɩ gaanɩ a ba mɛ awɔ-gbagba aa bɛnɩ? A mɛ apenterenbide ma ade ma gɩsaa a ka a di diyere. A tiri aa bɛnɩ Isareli bete a ye Egyipiti, gɛ a berema bɩfɩɩ-fon a ye bɔɔ bʋnʋn. <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />Oo Yahwe, a ka Isareli a mɛ awɔ-gbagba aa bɛnɩ gakpaakpa, gɛ awɔ Yahwe a bɛ mɛ boo Wurubwarɛ. <verse eid="1CH 17:22" /><verse number="23" style="v" sid="1CH 17:23" />Oo Yahwe, Nkele yɛ ade gɛtɛ a dɔ̀ a sɩ̀ ka dama nmɩ aasaranyan ma miindu waanɩ wʋʋ bɛnɩ boo koro fɔ yàà ba waanɩ. Mɛ anlɛ gɛtɛ a dɔ̀ a sɩ̀ fɔ. <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />Gɛlɛ fɔ, aa diyere daà ye gepepe, gɛ bɛnɩ baà dɔ̀ alɛ &lt;Yahwe, Isareli bete boo Wurubwarɛ gɛtɛ è di Ɔkɛma powu Wuute fɔ n di Isareli wo Wurubwarɛ!&gt; Ɛwʋ fɔ nmɩ aasaranyan Dafidi mɩɩn dɩkpaara daà yela kin-kin aa bʋnʋn baanɩ.<verse eid="1CH 17:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25" />Gɛ awɔ, miin Wurubwarɛ na tiri a wùlà nmɩ aasaranyan alɛ aà sere digyu-kpaara a tɛ mɩ ma miindu waanɩ wʋʋ bɛnɩ wuu koro gɛ na wura oturu n te tiri onyun n tɛ wɔ̀ lɛ. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />Oo Yahwe, awɔ n di Wurubwarɛ! A dɔ̀ ade a sɩ̀ gɛtɛ aà mɛ ade-kpara nyayɩ yiidu a tɛ nmɩ aasaranyan. <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />Nkele wu di wɔ̀ gʋnʋn gɛtɛ àà hira nmɩ aasaranyan miindu wʋʋ bɛnɩ, fɔ bàà sara aa bʋnʋn baanɩ gakpaakpa. Oo Yahwe, gɩnyan gɛtɛ a hira fɔ, a hira gɩ gakpaakpa.&gt;&gt;<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s1">Dafidi e di akpa kpekpesi yii koro</para>
  <para style="r">(2 Sam 8.1-18)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />Ɔya wʋkɩ wʋʋ gama fɔ, Dafidi ɛ kpà ma Filisiti bete, gɛ e di boo koro. E to Gati ditele ma daatelebi gɛtɛ i silin di i tuma fɔ e ye Filisiti bete baalɔ yaanɩ.<verse eid="1CH 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2" />Dafidi ɛ nɩ di Mowabi bete boo koro, gɛ bɛ sara wɔ gatɩn, gɛ bee le gɩkyan-gɩkyan gɩɩ sɩka bɛ tɛ wɔ.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />Gɛlɛ ke gɛ egyu Dafidi e di Soba wogyu-dɩrɛ Hadadeseri wo koro, gbɛma Hamati gɛtʋnkwaa, ɔkʋna gɛtɛ Hadadeseri ɛɛ yaraba wo bugyu buu gedikʋn ɛɛ fɔrɔ Efurate getu gaanɩ fɔ. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />Dafidi e gye wo tiiramisan ɛbɛ nkpɩn ton (1,000), ma wabengyi yɩɩ bɛsaralɛ ɩgbaa isiyee ma nkpɩn ton (7,000), ma bɩtà bʋʋ bɛtàlɛ gɛtɛ bɛ̀ san ma bɩsɩrɩ disepekyi (20,000). E kebi abengyi fɔ yɩɩ-ɩsɩrɩ-kpaa, gɛ e kere akpilin ton (100) ɛ ya ɛ tɛ abengyi akpilin ton (100) gɛtɛ yii tiira tiiramisan ɛbɛ fɔ.<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />Gɛtɛ Aram bete gɛtɛ be ye Damasiko fɔ bɛ ba bàà bɛ kpà Soba wogyu-dɩrɛ Hadadeseri fɔ, Dafidi e wolo baanɩ disepekyi ma gbaa (22,000). <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />Ɛwʋ gɛ Dafidi ɛ sɩ̀ bɩtà bʋʋ bɛtàlɛ Aram bugyu buu gedikʋn buu ditele-dɩrɛ Damasiko daanɩ, gɛ Aram bete bɛ sara wɔ gatɩn, be le gɩkyan-gɩkyan gɩɩ sɩka bɛ tɛ wɔ. Yahwe ɛ yɛ Dafidi ee di akpa yii koro ɔkʋn-kamasɛ gɛtɛ ɛ san ɛ ma akpà fɔ.<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />Gɛ Dafidi ɛ labɩrɩ sɩka-sɩya wawɔrɔnyan panpasan-dɩyɛlɛ koro gɛtɛ Hadadeseri bɩtà bʋʋ bɛtàlɛ bè de fɔ ɛ san Yerusalem. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />Dafidi ɛ labɩrɩ awɔrɔnyan-sɩya kpekpesi e ye Tibati ma Kun atele gɛtɛ Hadadeseri e di bugyu yii koro fɔ. Bʋwɔrɔnyan-sɩya bʋtɔkɔ gɛ gamama Solomon ɛ bɛ ka ɛ mɛ gɩwɔrɔnyan-sɩya gɩɩ tasa-dɩrɛ fɔ, ma bepila fɔ, ma gɩwɔrɔnyan-sɩya gaanyan kperen-kperen fɔ.<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />Gɛtɛ Hamati wogyu-dɩrɛ Towu ɛ nʋn gɛtɛ Dafidi e di Soba wogyu-dɩrɛ Hadadeseri wo koro fɔ, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />ɛ sa wobi-teni Hadoram egyu Dafidi wakʋn alɛ ɛ ma sa wɔ onyun, fɔ èè sila wɔ gɛtɛ e di Hadadeseri wo koro akpa yaanɩ fɔ. Fɔ Towu ma Hadadeseri bɛɛ tɩ kpà. Hadoram ɛ ka sɩka-sɩya, ma sɩka-fututu, ma gɩwɔrɔnyan-sɩya yaanyɩmɩnyan ɛ ma tɛ Dafidi.<verse eid="1CH 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11" />Ɛwʋ gɛ egyu Dafidi ɛ mɛ yɩ fɩrɩnfɩrɩn ɛ tɛ Yahwe, fɩya ma sɩka-fututu, ma sɩka-sɩya gɛtɛ e to e ye Edom, ma Mowabi, ma Amoni bete, ma Filisiti bete, ma Amaleki bete baakʋn fɔ.<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />Seruya wobi Abisayi e wolo Edom bete ɩgbaa yɛkɩ (18,000) Bʋbɔlɛ bʋʋ Dɩtagba daanɩ. <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />Ɛ sɩ̀ bɩtà bʋʋ bɛtàlɛ Edom, gɛ Edom bete bɛ sara Dafidi gatɩn. Yahwe ɛ yɛ Dafidi e di akpa yii koro ɔkʋn-kamasɛ gɛtɛ ɛ san ɛ ma akpa fɔ.<verse eid="1CH 18:13" /></para>
  <para style="s1">Dafidi bɛndɩrɛbi</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />Dafidi e di bugyu Isareli powu wanɩ. Ɛ mɛ ade kyɛkyɛ, gɛ ɛ mɛ ade gɛtɛ ɩ̀ tʋna ɛ tɛ wɔ bɛnɩ powu. <verse eid="1CH 18:14" /><verse number="15" style="v" sid="1CH 18:15" />Seruya wobi Yowabi na mɛ bɩtà bʋʋndɩrɛ ɛ tɛ bɩtà bʋʋ bɛtàlɛ fɔ. Gɛ Ahiludi wobi Yehosafati na mɛ egyu wɔtabʋrʋlɛ. <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />Ahitubi wobi Sadoki, ma Abiyata wobi Ahimeleki na mɛ gedi gɩɩ bɛtɛlɛ, gɛ Safisa ɛ mɛ gɩkpa gɩɩŋwaralɛ. <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />Yehoyada wobi Benaya na mɛ egyegeyelɛ ɛ tɛ Kereti ma Peleti bete. Gɛ Dafidi bebi-teni bɛ mɛ egyu bɛndɩrɛbi bɔɔ bɛndɩrɛ.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s1">Dafidi ɛ kpà ma Amori bete</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />Wʋ bɛ nɩma ɔkʋna wʋkɩ fɔ, Amori bete boogyu Nahasi e ku, gɛ wobi Hanun e di bugyu e sere wɔ gɩsɩrɩ. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />Ɛwʋ gɛ Dafidi ɛ dɔ̀ alan, &lt;&lt;Nan wula Nahasi wobi Hanun gutunkoro, yema wote e wula miin gutunkoro.&gt;&gt; Ɛwʋ gɛ Dafidi ɛ sa bɛnɩ bɛ ma tɛ Hanun bɔbwɛ ma wote diku.</para>
  <para style="p" vid="1CH 19:2">Gɛtɛ Dafidi bɛnɩ fɔ bɛ ma gyu Hanun wakʋn Amori bete bɔɔ gɛtʋnkwaa gaanɩ bàà màà tɛ wɔ bɔbwɛ fɔ, <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />Amon ditele dɩɩ bɛndɩrɛ bɛ lila Hanun alan, &lt;&lt;À nyɩ̀ alɛ gebù gɛ Dafidi ee bù aate, okoro gɛ ɛ sa bɛnɩ bàà bɛ̀ dɔ̀ sa wɔ̀ lɛ? Wɔ bɛnɩ fɔ bɛn ba gɛtɛ bàà bè yuri nya gɛtʋnkwaa fɔ, fɔ bàà be gye ɛtɩ ma tɩɩ gɛtʋnkwaa fɔ bɩtà?&gt;&gt; <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />Ɛwʋ gɛ Hanun ɛ yɛ be gye Dafidi bɛsaranyan fɔ, gɛ bɛ wɔrɔ boo bikpri, gɛ bɛ fɛɛran bɔɔ ngba getite-getite, bɔɔ yɩɩ-ɩpɩ yɩɩ gɩlan, gɛ be berema bɛ. <verse eid="1CH 19:4" /><verse number="5" style="v" sid="1CH 19:5" />Ɛwʋ gɛ ɛnɩ ɛkɩ ɛ ma dɔ̀ Dafidi anlɛ gɛtɛ bɛ mɛ wɔ bɛsaranyan fɔ, gɛ Dafidi ɛ sa bɛnɩ bɛ ma tuma bɛ, yema bɛ sa bɛ ɩnɩnfa bɛ kààrà, gɛ egyu-dɩrɛ ɛ yɛ bɛ dɔ̀ bɛ alan, &lt;&lt;Ɩ sara Yeriko ɩ ma sere gɛtɛ yii bikpri bàà gyu, fɔ yàà ba.&gt;&gt;<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />Gɛtɛ Hanun ma Amon bete be we gɛtɛ ɛbɛ ma Dafidi be biligi bekengbelilɛ fɔ, bɛ ka sɩka-fututu gɛtɛ wʋʋdʋrʋ waà mɛ anlɛ siminti bɛbagɩ nkpɩn busiyee ma akpilin kwarankɩ (740) bɔɔdʋrʋ bɛ ma hayɩ tiiramisan ɛbɛ, ma abengyi yɩɩ bɛsaralɛ be ye Aram-Naharayim, ma Aram-Maaka, ma Soba. <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />Bɛ nɩ hayɩ tiiramisan ɛbɛ ma abengyi yɩɩ bɛsaralɛ disepekyi ma gbaa ɛkɩ, fɩya ma Maaka wogyu-dɩrɛ ma wɔ bɩtà bʋʋ bɛtàlɛ, gɛ bɛ san bɛ ma sara gbɛma Medeba. Gɛ Amon bete mɔ bɛ tɔ be ye baatele yaanɩ, bɛɛ pɩna koro bàà tà bɩtà.<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />Gɛtɛ Dafidi ɛ nʋn ade nyayɩ fɔ, ɛ sa Yowabi ma bɩtà bʋʋ bɛtàlɛ fɔ powu bàà ma kpà. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />Amon bete fɔ bɛ pɩna koro be yela boo ditele-dɩrɛ diitunu, gɛ Aram begyu gɛtɛ bɛ bɛ fɩya ma ɛbɛ fɔ be yela ɩkʋn-pentenperenkʋn.<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />Gɛtɛ Yowabi e we gɛtɛ bekengbelilɛ bɔɔ bɩtà bʋʋ bɛtàlɛ bɛ̀ sa wɔ bʋnʋn, gɛ bɛ̀ sa wɔ gama ke fɔ, e tiri Isareli bɩtà bʋʋ bɛtàlɛ gɛtɛ bɛ̀ nyɩ̀ akpa gepepe fɔ baanɩ bɛkɩ gɛtɛ bàà ma kpà ma Aram bete. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />Gɛ ɛ yɛ ɛ ka bɛkurumakyɛɛ fɔ ɛ sa wonobi Abisayi gʋlɔ gɛtɛ bàà ma kpà ma Amon bete. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />Ɛwʋ gɛ Yowabi alan, &lt;&lt;Gengyi Aram bete bɛ̀ ba ɔkɛma da mɩ fɔ, ba àà bɛ̀ kpà mɩ. Gɛ gengyi Amon bete bɛ̀ ba ɔkɛma da wɔ̀ fɔ, nan bɛ̀ kpà wɔ̀. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />Yela kin-kin, fɔ tàà sa oturu tɩ kpà tɩ tɛ tɩɩ bɛnɩ ma tɩɩ Wurubwarɛ watele fɔ. Yahwe ɛɛ̀ mɛ ɛwʋ gɛtɛ wʋ̀ kɔlɔ tɛ wɔ!&gt;&gt;<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />Ɛwʋ gɛ Yowabi ma bɩtà bʋʋ bɛtàlɛ gɛtɛ è de fɔ be ye bàà ma kpà ma Aram bete, mɔ Aram bete fɔ be serenti. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />Gɛtɛ Amon bete be we gɛtɛ Aram bete bee serenti fɔ, ɛbɛ mɔ be serenti be ye Yowabi wonobi Abisayi bʋnʋn baanɩ bɛ san ditele-dɩrɛ daanɩ. Okoro Yowabi e biri ɛ da Yerusalem.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />Gɛtɛ Aram bete be we gɛtɛ Isareli bete bee di boo koro fɔ, bɛ sa bɛnɩ bɛ ma ka bɩtà bʋʋ bɛtàlɛ-fon be ye Efurate bɛ bɛ fɩya ma ɛbɛ. Sofaki, na mɛ bɩtà bʋʋtàlɛ ɛndɩrɛ ɛ tɛ Hadadeseri bɩtà bʋʋ bɛtàlɛ fɔ.<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />Gɛtɛ Dafidi ɛ nʋn gɛlɛ gaade nyayɩ fɔ, ɛ kʋla Isareli bɩtà bʋʋ bɛtàlɛ powu, gɛ bɛ kààrà Yodan getu. Bɛ san bɛ ma gbɛma bɛ, gɛ be yela bɔɔ bʋnʋn. Dafidi ɛ tɩyɛ wɔ bɩtà bʋʋ bɛtàlɛ e yela, gɛ Aram bete be sere akpa ma ɛwɔ. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />Mɔ Aram bete be serenti, gɛ Dafidi e wolo baabengyi yɩɩ bɛsaralɛ ɩgbaa isiyee ma nkpɩn ton (7,000), ma bɔɔ bɩtà bʋʋ bɛtàlɛ gɛtɛ bɛ̀ san ma bɩsɩrɩ fɔ asepekyi anyɔɔ (40,000). E wolo bɔɔ bɩtà bʋʋndɩrɛ Sofaki mɔ ke.<verse eid="1CH 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19" />Gɛtɛ begyu gɛtɛ bɛ̀ sa Hadadeseri gatɩn fɔ be we gɛtɛ Isareli e di boo koro fɔ, bɛ fɔ gɛtɛ olila wàà ba ɛbɛ ma Dafidi boo getite, gɛ bɛ sara Dafidi gatɩn.</para>
  <para style="p" vid="1CH 19:19">Okoro Aram bete ben mini len gɛtɛ bàà kpà Amon bete nya.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s1">Dafidi e di Raba wo koro</para>
  <para style="r">(2 Sam 12.26-31)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />Ɛsʋn gɛnʋ̀n gɩɩya waanɩ gɛtɛ begyu bee ye bɛ san bɩtà fɔ, Yowabi e gyegeyelɛ ɛ tɛ bɩtà bʋʋ bɛtàlɛ fɔ gɛ bɛ ma muru Amon gɩfɩɩ. Gɛ bɛ ma sʋ Raba bɛ sa. Fɔ Dafidi ɛ wɔ ɛ sara Yerusalem. Yowabi ɛ tà Raba ditele bɩtà, gɛ e muru dɩ. <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />Gɛ Dafidi e tiri boogyu fɔ digyu-koto e ye wo duyu dii koro. Dikoto fɔ dɩɩdʋrʋ wʋ̀ ba bekilo dikpilin ma fwo-bɛnaa (34), gɛ bɛ ka ataa-kpara bɛ sa dɩ adawʋ. Gɛ bɛ ka dɩ be tin Dafidi duyu. Gɛ Dafidi e kpila anyan-kpara kpekpesi e ye ditele fɔ daanɩ. <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />Ɛwʋ gɛ ɛ ka bɛnɩ fɔ e ye ditele fɔ daanɩ, gɛ ɛ nyɩ bɛ ɛ sa gʋtʋn gɩɩ gɛmɛ gaanɩ. Bɛ ka sɔya, ma bɛkpakya, ma bɩlɛlɛ, ma akyɔɔ bɛ mɛ gʋtʋn. Gɛlɛ gɛ ɛ mɛ Amon bete baatele fɔ powu. Wʋʋ gama fɔ, Dafidi ma wɔ bɩtà bʋʋ bɛtàlɛ powu be biri bɛ da Yerusalem.<verse eid="1CH 20:3" /></para>
  <para style="s1">Dafidi e di Filisiti bete boo koro</para>
  <para style="r">(2 Sam 21.15–22)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />Nyawʋ wʋʋ gama fɔ, akpa i biri i sere Isareli bete ma Filisiti bete boo getite, ɔkʋn gɛtɛ bee kpèlè Geseri fɔ. Waanɩ gɛ Husati-te Sibekayi e wolo Sipayi, gɛtɛ è di Refayim bete boodu waanɩ wʋʋnɩ ɛkɩ fɔ, gɛ be di Filisiti bete boo koro.<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />Wʋʋ gama fɔ, akpa-fon i ni sere ma Filisita bete, gɛ Yayiri wobi Elihanan e wolo Gati-te Goliyati wonobi Lahimi, gɛtɛ è de gɩsɩnta gɛtɛ giiyon wʋ̀ lɩ anlɛ oyon-lɔlɛ ayan fɔ.<verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />Gɛlɛ ke gɛ akpa ɩkɩ i sere Gati ditele gɛtɛ ete garam ɛkɩ gɛtɛ wɔ gʋlɔ-kamasɛ gɩ̀ ba alobi kooron, gɛ wɔ gɩsɩrɩ-kamasɛ gɩ̀ ba bisiribi kooron. Okoro walobi ma wo bisiribi powu ɩ ma yela dikpilin ma anaa. Ɛwɔ mɔ e ye Rafa wodu waanɩ. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />Gɛtɛ ɛ sa Isareli bete dɩkpàtà fɔ, Sama wobi Yonatan gɛtɛ è di Dafidi wokperebi fɔ e wolo ete garam fɔ.<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />Bɛnɩ-garam-garam besiyee nyabɛ bè di gɛ Rafa wodu wʋʋ bɛnɩ gɛtɛ be ye Gati fɔ. Dafidi ma wɔ bɩtà bʋʋ bɛtàlɛ be wolo bɛ.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s1">Dafidi ɛ yɛ bɛ kalan bɩtà bʋʋ bɛtàlɛ fɔ</para>
  <para style="r">2 Samweli 24:1-25</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />Satan ɛ tɔ e yela Isareli gɩfɩɩ gii koro, gɛ ɛ tɛ Dafidi amɩnlɛ-kpe gɛtɛ ɛ̀ɛ̀ sa bɛnɩ bàà kalan Isareli bete powu. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />Okoro Dafidi ɛ dɔ̀ Yowabi ma bɩtà bʋʋ bɛtàlɛ bɔɔ bɛndɩrɛ fɔ alan, &lt;&lt;Ɩ San ɩ ma kalan Isareli bete, ye Beeseba san Dan fɔ àà bɛ̀ dɔ̀ mɩ, fɔ nan wura n nyɩnla baasɔ.&gt;&gt;<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />Mɔ Yowabi e tiri wuunyun alan, &lt;&lt;Oo Miinfonte, gengyi Yahwe ɛ̀ yɛ bɩtà bʋʋ bɛtàlɛ fɔ bɛ sɔ disere akpilin-ton gba bɛ fɩya fɔ, ɛbɛ powu be di gɛ aa bɛsaranyan. Anʋn yii koro gɛ awɔ miinfonte aa len àà mɛ gɛlɛ? Anʋn yii koro gɛ aa len àà yɛ dɩpwɛ dàà bè tin Isareli wo koro?&gt;&gt;<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />Mɔ egyu-dɩrɛ ɛ nyɩ wade fɔ yii koro, gɛtɛ wʋ yɛ Yowabi e di yii koro. Okoro Yowabi ɛ san e silin Isareli powu wanɩ, gɛ e biri ɛ ba Yerusalem. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />Ɛwʋ gɛ Yowabi ɛ ma yɛ egyu-dɩrɛ Dafidi ɛ nyɩnla bɩtà bʋʋ bɛtàlɛ fɔ baasɔ. Isareli anɩ powu fɔ, beteni gɛtɛ baà talɩ bɛ san akpa fɔ bɛ̀ ba miliyon ɛkɩ ma asepekyi ton (1,100,000), fɩya ma Yuda beteni asepekyi dikpilin ma asiyee ma ɩgbaa ton (470,000).<verse eid="1CH 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6" />Mɔ Yowabi ɛn kalan Lefi ma Benyamin boo-ifoli fɩya, yema en to egyu-dɩrɛ wade gɛtɛ ɛ sa wɔ alɛ ɛ mɛ fɔ ɛ sa. <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />Ade gɛtɛ egyu-dɩrɛ ɛ sa Yowabi alɛ ɛ mɛ fɔ ì di ade-kpen Yahwe bʋnʋn, okoro Yahwe e tiira Isareli gɩfɩɩ giten.<verse eid="1CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8" />Ɛwʋ gɛ Dafidi e tiri onyun ɛ fɔ Yahwe alan, &lt;&lt;Na mɛ ade-kpen-dɩrɛ gɛtɛ na mɛ ade nyayɩ lɛ. Ǹ fɔ wɔ gɛ, ka nmɩ aasaranyan mɩɩn dɩpwɛ dii gedi fɔ kyɛ mɩ. Na mɛ anyimapu-de.&gt;&gt;<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />Ɛwʋ gɛ Yahwe ɛ dɔ̀ Gadi gɛtɛ è di Wurubwarɛ wɔtabʋrʋlɛ tɛ Dafidi fɔ alan, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />&lt;&lt;San ma dɔ̀ Dafidi alɛ, nmɩ Yahwe alan, &lt;Ǹde giten-tiira akpen asiyee ǹ tɛ sɩ̀ aa bʋnʋn. Tiri yaanɩ wʋkɩ, fɔ nan yɛ wʋ wàà ba aa koro.&gt; &gt;&gt;<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />Gɛ Gadi ɛ san Dafidi wakʋn ɛ ma dɔ̀ wɔ alan, &lt;&lt;Yahwe ɛɛ dɔ̀ alan, &lt;Tiri giten-tiira gɛtɛ à len. <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />Dɩkpan dɩɩ gɛnʋ̀n bɩkyan bisiyee, abɛɛ bebon besiyee gɛtɛ aà serenti a ye aa bɛkyʋnlɛ bɔɔ bʋnʋn, abɛɛ Yahwe ɛɛ̀ ka edon aa koro awi asiyee, gɛtɛ ɛɛ̀ sa wɔsalɛ ɛ̀ɛ̀ bɛ̀ mɩna anyan Isareli gɛtʋnkwaa gɩɩkʋn-kamasɛyɛ ma diyebabi-kpen gɛtʋnkwaa fɔ gii koro. Sa amɩnlɛ wuu koro, fɔ àà yɛ mɩ nan nyɩnla ade gɛtɛ nan ma dɔ̀ ɛwɔ gɛtɛ ɛ sa mɩ fɔ.&gt;&gt;<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />Gɛ Dafidi ɛ dɔ̀ Gadi alan, &lt;&lt;Ǹ sa dɩyɩyɛ-dɩrɛ daanɩ. Mɔ ǹ len nan nʋ̀n Yahwe walɔ yaanɩ, yema wo gutunkoro gii gewe gɩ̀ sɔ gepepe. Kara yɛ mɩ nàn nʋ̀n bɛnɩ-nyalɛ baalɔ yaanɩ.&gt;&gt;<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />Okoro Yahwe ɛ yɛ diyebabi-kpen dɩ nʋ̀n Isareli gɛtʋnkwaa gii koro, gɛ Isareli bɛnɩ asepekyi asiyee ma ɩgbaa ton (70,000) be ku. <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />Gɛ Wurubwarɛ ɛ sa ɛsalɛ ɛkɩ ɛ̀ɛ̀ ma muru Yerusalem. Mɔ ɔkʋna gɛtɛ ɛsalɛ fɔ e sere ge muru bɛnɩ fɔ, gyerebi fɔ ɛ taga Yahwe, gɛ ɛ dɔ̀ ɛsalɛ gɛtɛ ee muru bɛnɩ fɔ alan, &lt;&lt;Wʋ kʋtɩ! Kere ya gɛlɛ!&gt;&gt; Fɔ Yahwe wɔsalɛ fɔ è yela Yebusi-te Arawuna wanaabi yii getibakʋn.<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />Gɛtɛ Dafidi ɛ tɔ̀là bʋnʋn fɔ, e we Wurubwarɛ wɔsalɛ afiye yaanɩ gatala gɛtɛ è de edon, ɛ tʋna gʋlɔ Yerusalem wo koro. Ɛwʋ gɛ Dafidi ma bɛndɩrɛ gɛtɛ bè tin bekotoku baayan fɔ bɛ waran be kura bɛ ka bɔɔ bʋnʋn be tin gɛtʋnkwaa.<verse eid="1CH 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17" />Gɛ Dafidi e tiri onyun alan, &lt;&lt;Nka nmɩ na dɔ̀ gɛtɛ bàà kalan bɛnɩ fɔ? Nmɩ na mɛ ade-kpen, gɛ na mɛ ade gɛtɛ ɩɩn kɔlɔ. Mɔ anʋn gɛ bɛnɩ nyabɛ gɛtɛ baade ɩ̀ ba gutunkoro lɛ bɛ mɛ? Oo Yahwe, miin Wurubwarɛ, tiira gɛ nmɩ ma mɩɩn dɩkpaara dɩɩ bɛnɩ giten, mɔ kara yɛ gyerebi nyawʋ wàà nʋ̀n aa bɛnɩ boo koro.&gt;&gt;<verse eid="1CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />Ɛwʋ gɛ Yahwe wɔsalɛ fɔ ɛ dɔ̀ Gadi alɛ ɛ dɔ̀ Dafidi alɛ ɛ ma sere gedi gɩɩ gɛtɛkʋn ɛ tɛ Yahwe, Yebusi-te Arawuna wanaabi yii getibakʋn. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />Okoro Dafidi ɛ tɔ ɛ san ɛ ma mɛ anlɛ gɛtɛ Gadi ɛ dɔ̀ wɔ Yahwe diyere daanɩ fɔ.<verse eid="1CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20" />Gɛtɛ Arawuna è yela ee tiba wanaabi fɔ, e fi ɛ nya gɛ e we ɛsalɛ fɔ. Gɛ wobebi bɛnaa gɛtɛ bɛ̀ fɩya ma ɛwɔ fɔ be serenti bɛ ma bu. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />Ɛwʋ gɛ Dafidi e kpe ɛ gbɛma Arawuna. Gɛtɛ Arawuna ɛ tɔ̀là bʋnʋn, gɛ e we wɔ fɔ, e kpe e ye anaabi yii getibakʋn fɔ gɩɩpɩ, gɛ ɛ waran e kura ɛ ka bʋnʋn e tin gɛtʋnkwaa.<verse eid="1CH 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22" />Gɛ Dafidi ɛ dɔ̀ wɔ alan, &lt;&lt;Ka anaabi yii getibakʋn nyagɩ tɛ mɩ nan sere gedi gɩɩ gɛtɛ̀kʋn n tɛ Yahwe, fɔ gyerebi gɛtɛ ee di bɛnɩ lɛ èè ten. Fu gɩ tɛ mɩ gɩɩ gɩyɛ-gbagba.&gt;&gt;<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />Ɛwʋ gɛ Arawuna ɛ dɔ̀ Dafidi alan, &lt;&lt;Miinfonte, ka gɩ, fɔ àà mɛ gɩnyan-kamasɛ gɛtɛ gɩ̀ kɔlɔ tɛ wɔ̀! Nya, nan tɛ ɛkwɔ-teni tɛ gekuma gii gedi fɔ, anaabi yii-iyon fɔ yaà mɛ bʋtan, anaabi yaabi fɔ mɔ yaà mɛ gedi gɩɩ gɛtɛ̀ gaanyan. Nan tɛ anyan nyayɩ powu.&gt;&gt;<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />Mɔ egyu Dafidi ɛ dɔ̀ wɔ alan, &lt;&lt;Kpakpaakpa! Wù di gɛtɛ nan se gɩ gɩɩ gɩyɛ gbagbaagba. Mɩn nan talɩ n to aanyan n tɛ Yahwe, abɛɛ nan tɛ gekuma gii gedi gɛtɛ min le gɩnyankɩ.&gt;&gt;<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />Okoro Dafidi e le gɛtʋnkwaa fɔ gii gutoro sɩka-fututu wabi nkpɩn busiyee. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />Gɛ Dafidi e sere gedi gɩɩ gɛtɛkʋn dʋkɔ ɛ tɛ Yahwe, gɛ ɛ tɛ gekuma gii gedi, ma olila wuu gedi. E tiri onyun e kpèlè Yahwe, gɛ Yahwe e yera wɔ ma ɔtan e ye gatala gekuma gii gedi gɩɩ gɛtɛkʋn fɔ gii koro.<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />Ɛwʋ gɛ Yahwe ɛ tabʋrʋ ɛ tɛ wɔsalɛ fɔ, gɛ e birima wɔ tata fɔ ɛ sa wɔ dɩfwa daanɩ. <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />Gɛtɛ Dafidi e we gɛtɛ Yahwe e to wonyun-tiri Yebusi-te Arawuna wanaabi yii getibakʋn gɛlɛ fɔ, ɛ tɛ gedi dʋkɔ. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />Ɔkʋna wʋtɔkɔ fɔ, Yahwe Dikwo-dɩrɛ gɛtɛ Mose e sere fɔ dɩ̀ sa otonkuma waanɩ, gɛ gekuma gii gedi gɩɩ gɛtɛ̀kʋn fɔ gɩ̀ sa dɩsʋmakʋn, Gibeyon ditele daanɩ. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />Mɔ Dafidi ɛn talɩ san dʋkɔ alɛ ɛ̀ ma lila ade e ye Yahwe wakʋn, yema è serenti Yahwe wɔsalɛ fɔ wɔ tata fɔ.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />Ɛwʋ gɛ Dafidi alan, &lt;&lt;Yahwe, Wurubwarɛ Dikwo daà sere nfan, gɛ Isareli bete boo gekuma gii gedi gɩɩ gɛtɛ̀kʋn mɔ gaà sere nfan.&gt;&gt;<verse eid="1CH 22:1" /></para>
  <para style="s1">Gɛpɩna koro tɛ Dikwo-dɩrɛ fɔ dii gesere</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />Ɛwʋ gɛ Dafidi ɛ yɛ be kpèlè besela gɛtɛ bè si Isareli fɔ be tuma, gɛ e tiri ataa yɩɩ bɛkpalɩlɛ e ye baanɩ gɛtɛ bàà pɩna ataa tɛ Dikwo-dɩrɛ fɔ dii gesere. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />Dafidi e len gɩwɔrɔnyan gepepe ɛ tɛ gɛtɛ bàà ka mɛ aŋanbi ma imini-kɔntɔn-kɔntɔn tɛ itunu-yon, gɛ e ni len gɩwɔrɔnyan-sɩya gepepe gɛtɛ ɛnɩ ɛɛn talɩ e keri. <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />Gɛlɛ ke gɛ e ni len seda wo-iyon gɛtɛ ɛnɩ ɛɛn talɩ ɛ kalan, yema Sidon bete ma Tire bete bɛ ka yɩ kpekpesi bɛ bɛ tɛ Dafidi.<verse eid="1CH 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5" />Ɛwʋ gɛ Dafidi ɛ dɔ̀ alan, &lt;&lt;Miinbi Solomon è di gɛ ebi, gɛ ɛɛn nyɩ̀ anlɛ gɛtɛ bɛɛ sɩ̀ ade yaanɩ gepe. Gɛ wù di gɛtɛ Yahwe Dikwo gɛtɛ eè sere fɔ mɔ dàà mɛ Dikwo gbaa, gɛtɛ dɩ̀ ba ɔmɩrɩ, gɛ dɩ̀ ba gebù, bɩfɩɩ powu bʋʋ bʋnʋn. Okoro nan tɩ̀ pɩna koro n tɛ dii gesere.&gt;&gt; Okoro Dafidi e len anyan gepepe ɛ sɩ̀ pɛgɛ e ku.<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />Ɛwʋ gɛ ɛ yɛ be kpèlè wobi Solomon bɛ tɛ wɔ, gɛ ɛ ka Yahwe, Isareli wo Wurubwarɛ fɔ Dikwo fɔ dii gesere ɛ sa wɔ gʋlɔ. <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />Gɛ Dafidi ɛ dɔ̀ Solomon alan, &lt;&lt;Miinbi, na len gɛtɛ nan sere Dikwo-dɩrɛ n tɛ Yahwe, miin Wurubwarɛ. <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />Mɔ Yahwe ɛ dɔ̀ mɩ alan, &lt;A wolo bɛnɩ kpekpesi, gɛ a kpà akpa kpekpesi. Okoro an nan sere Dikwo a tɛ mɩ, yema a daa nkalan gʋsɔ a lulu gɛtʋnkwaa gii koro mɩɩn bʋnʋn baanɩ. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />Mɔ aà wo ebi-teni ɛkɩ gɛtɛ ɛɛ̀ mɛ olila wʋʋnɩ, ma getuna gɩɩnɩ, gɛ nan tiri wɔ n ye wɔ bɛkyʋnlɛ gɛtɛ be silin wɔ be tuma fɔ powu baalɔ yaanɩ èè wura getuna. Wo diyere nan mɛ Solomon, yema nan yɛ Isareli ɛ̀ɛ̀ sara olila waanɩ, gɛ nan dɩyɛ wɔ wo bugyu buu gedi baanɩ. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />Ɛwɔ nan sere Dikwo-dɩrɛ bàà tɩ̀ sʋma mɩ daanɩ. Ɛɛ̀ mɛ miinbi, gɛ nan mɛ wote. Gɛ nan yɛ wo bugyu buu gedi bʋʋ gɛbɩya gàà sere ɩkpaa gakpaakpa Isareli anɩ.<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />Okoro nkele, miinbi, Yahwe ɛ fɩya ma awɔ, fɔ àà talɩ sere Yahwe, aa Wurubwarɛ fɔ Dikwo fɔ anlɛ gɛtɛ ɛ dɔ̀ alɛ aà mɛ fɔ. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />Wurubwarɛ ɛ tɛ wɔ̀ gɛkɛrɛ-ade-nya ma gɛsɛyɩ ɔkʋna gɛtɛ ɛɛ̀ bɛ ka wɔ̀ ɛ sɩ̀ bugyu ɛ tɛ Isareli fɔ, fɔ àà ton Yahwe, aa Wurubwarɛ fɔ Wose fɔ waanɩ. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />Gengyi à di ade-tɩyɛlɛ-sɩ̀lɛ ma wo-ise gɛtɛ Yahwe ɛ ka ɛ tɛ Mose alɛ ɛ tɛ Isareli fɔ yii koro fɔ, ade yaà san gepe ɩ tɛ wɔ̀. Sa koro ɔkɛma, fɔ àà yela kin-kin. Kara yɛ gɩsaa gàà ton wɔ̀, abɛɛ koro gàà yɔ wɔ̀.<verse eid="1CH 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14" />Na sa aniya na len sɩka-sɩya gɛtɛ wʋʋdʋrʋ wʋ̀ ba bekilo bemiliyon besiyee ma asepekyi dikpilin ma fwo-kwarankɩ ma ɩgbaa ton (3,750,000), ma sɩka-fututu gɛtɛ wʋʋdʋrʋ wʋ̀ ba bekilo bemiliyon dikpilin ma fwo-kwarankɩ ma asepekyi dikpilin ma ton (37,500,000), ma gɩwɔrɔnyan-sɩya ma gɩwɔrɔnyan gepepe gɛtɛ ɛkɩ ɛɛn talɩ e keri, fɩya ma iyon ma ataa. Gɛ wù di gɛtɛ àà bugiti fɩya yaanɩ. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />À ba gʋtʋn gɩɩ bɛmɛlɛ kpekpesi. À ba ataa yɩɩ bɛkpalɩlɛ, ma ɩpɔrɩ yɩɩ bɛmaralɛ ma bɛ kapɩnta. Gɛlɛ ke gɛ à ba bɛnɩ gɛtɛ bɛɛ talɩ bɛ mɛ gʋtʋn-kamasɛ. <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />Bè di sɩka-sɩya ma sɩka-fututu ma gɩwɔrɔnyan-sɩya ma gɩwɔrɔnyan yɩɩ bʋtʋn bʋʋ bɛmɛlɛ. À ba adawʋ yɩɩ bɛsalɛ gɛtɛ bɛn talɩ bɛ kalan bɛ. Okoro, nkele sere gʋtʋn fɔ gɩɩ gɛmɛ! Yahwe ɛ fɩya ma awɔ!&gt;&gt;<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />Gɛ Dafidi ɛ dɔ̀ Isareli begyegeyelɛ fɔ powu alɛ bɛ kpà wobi Solomon. <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />Ɛ dɔ̀ bɛ alan, &lt;&lt;Yahwe, yii Wurubwarɛ fɔ na fɩya ma ɛyɩ, gɛ ɛ yɛ yɩ i wura getuna ofèn-kamasɛ. Yema ɛ ka gɛtʋnkwaa fɔ gɩɩ bɛnɩ ɛ sa mɩɩn gʋlɔ, gɛ bɛ̀ sa Yahwe ma ɛtɩ wɔ bɛnɩ tɩɩ gatɩn. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />Okoro ɩ ka yii-ituru ma yɩɩ bɛkalan powu ɩ sʋma Yahwe. Ɩ kya Yahwe, Wurubwarɛ Dikwo fɔ dii gesere, fɔ yàà wura ɩ ka Yahwe Dikola dɩɩ dɩdaka fɔ, ma Wurubwarɛ wanyan-fɩrɩnfɩrɩn fɔ ɩ bɛ sa Dikwo gɛtɛ yaà sere bàà tɩ̀ sʋma Yahwe fɔ daanɩ.&gt;&gt;<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s1">Lefi bete bɔɔ gʋtʋn</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />Gɛtɛ Dafidi ɛ dan ditenikwaa fɔ, ɛ sɩ̀ wobi Solomon bugyu ɛ tɛ Isareli.<verse eid="1CH 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />Gɛlɛ ke gɛ e kpèlè Isareli bɛndɩrɛ, fɩya ma gedi gɩɩ bɛtɛlɛ ma Lefi bete e tuma. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />Bɛ kalan Lefi bete gɛtɛ be di bɩkyan dikpilin ma fwo ka bʋn fɔ, ɛbɛ powu bɛ̀ ba beteni disepekyi ma ɩgbaa yɛkɩ (38,000). <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />Ɛwʋ gɛ Dafidi ɛ dɔ̀ alan, &lt;&lt;Baanɩ disepekyi ma ɩgbaa ɩnyɔɔ (24,000) baà nya Yahwe Dikwo fɔ dɩɩ gʋtʋn gii koro, gɛ ɩgbaa isiyee (6,000) baà mɛ bɛndɩrɛbi ma gɔdɔ gɩɩ bɛdɔ̀lɛ. <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />Bɛnɩ ɩgbaa ɩnyɔɔ (4,000) baà mɛ otunu wʋʋ bɛnyalɛ, gɛ ɩgbaa ɩnyɔɔ (4,000) baà mɛ bɛnɩ gɛtɛ baà ka ɩnʋn yɩɩ gɛnʋma gaanyan gɛtɛ na len na sɩ̀ tɛ dɩsʋma fɔ be sila Wurubwarɛ.<verse eid="1CH 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 23:6" />Gɛ Dafidi e yo Lefi bete fɔ akpen asiyee gɛtɛ ì yela tɛ Lefi bebi-teni besiyee fɔ. Ɛbɛ n di Gerison, ma Kohati, ma Merari.<verse eid="1CH 23:6" /></para>
  <para style="s1">Gerison wodu wʋʋ bɛnɩ</para>
  <para style="m">
    <verse number="7" style="v" sid="1CH 23:7" />Gerison wodu wʋʋ bɛnɩ n di</para>
  <para style="li2" vid="1CH 23:7">Ladan ma Simeyi.<verse eid="1CH 23:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8" />Ladan bebi-teni n di,</para>
  <para style="li2" vid="1CH 23:8">Yehiyeli gɛtɛ è di ebi ɛndɩrɛ fɔ, ma Setam, ma Yoweli. Ɛbɛ powu bɛ̀ ba bɛnɩ besiyee.<verse eid="1CH 23:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9" />Simeyi bebi-teni n di</para>
  <para style="li2" vid="1CH 23:9">Selomoti, ma Hasiyeli, ma Haran. Ɛbɛ powu bɛ̀ ba besiyee. Ɛbɛ nyabɛ n di Ladan wakpaara-akpaara fɔ yɩɩ bɛndɩrɛ.<verse eid="1CH 23:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10" />Gɛ Simeyi bebi-teni n di</para>
  <para style="li2" vid="1CH 23:10">Yahati, ma Sisa, ma Yewusi, ma Beriya.</para>
  <para style="li2" vid="1CH 23:10">Ɛbɛ nyabɛ n di Simeyi bebi-teni fɔ. Ɛbɛ powu bɛ̀ ba bɛnaa.<verse eid="1CH 23:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 23:11" />Yahati n di ebi ɛndɩrɛ, gɛ Sisa n di ɛnyɔɔfɛ. Mɔ Yewusi ma Beriya ben wo bebi-teni gʋsɔ, okoro bɛ kalan bɛ gɛ dɩkpaara-kɩlɩn, gɛ be bom bɛ bɛ tɛ gɛ gʋtʋn-kɩlɩn.<verse eid="1CH 23:11" /></para>
  <para style="s1">Kohati wodu wʋʋ bɛnɩ</para>
  <para style="m">
    <verse number="12" style="v" sid="1CH 23:12" />Kohati bebi-teni n di</para>
  <para style="li2" vid="1CH 23:12">Amiram, ma Isahari, ma Hebron, ma Wusiyeli. Ɛbɛ powu bɛ̀ ba bɛnaa.<verse eid="1CH 23:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13" />Amiram bebi-teni n di,</para>
  <para style="li2" vid="1CH 23:13">Aaron ma Mose.</para>
  <para style="li2" vid="1CH 23:13">Be tiri Aaron ma wodu wʋʋ bɛnɩ bɛ sɩ̀ gɛtɛ bàà tɩ̀ mɛ anyan fɩrɩnfɩrɩn fɔ fɩrɩnfɩrɩn, bàà tɩ̀ tɛ gedi Yahwe bʋnʋn, bàà mɛ gʋtʋn wɔ bʋnʋn, fɔ bàà tɩ hira bɛnɩ Yahwe diyere daanɩ gakpaakpa. <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />Bɛ kalan Wurubwarɛ wɔnɩ Mose bebi-teni bɛ sa Lefi wofoli waanɩ.<verse eid="1CH 23:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15" />Mose bebi-teni n di</para>
  <para style="li2" vid="1CH 23:15">Gerisom, ma Eliyeseri.<verse eid="1CH 23:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16" />Gerisom wodu waanɩ fɔ,</para>
  <para style="li2" vid="1CH 23:16">Subayeli n di ɛndɩrɛ.<verse eid="1CH 23:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17" />Eliyeseri wodu wʋʋ bɛnɩ n di,</para>
  <para style="li2" vid="1CH 23:17">Rahabiya gɛtɛ è di ebi ɛndɩrɛ fɔ.</para>
  <para style="li2" vid="1CH 23:17">Eliyeseri en mini wo bebi-teni fɩya. Mɔ Rehabiya e wo bebi kpekpesi.<verse eid="1CH 23:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18" />Isahari bebi-teni n di</para>
  <para style="li2" vid="1CH 23:18">Selomiti gɛtɛ è di ɛndɩrɛ fɔ.<verse eid="1CH 23:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19" />Hebron bebi-teni n di,</para>
  <para style="li2" vid="1CH 23:19">Yeriya gɛtɛ è di ɛndɩrɛ, wobe-nyɔɔfɛ n di Amariya, esiyeefɛ n di Yahasiyeli, gɛ ɛnaafɛ n di Yekameyam.<verse eid="1CH 23:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20" />Wusiyeli wodu wʋʋ bɛnɩ n di,</para>
  <para style="li2" vid="1CH 23:20">Mika gɛtɛ è di ɛndɩrɛ fɔ, ma ɛnyɔɔfɛ Isihiya.<verse eid="1CH 23:20" /></para>
  <para style="s1">Merari wodu wʋʋ bɛnɩ</para>
  <para style="m">
    <verse number="21" style="v" sid="1CH 23:21" />Merari bebi-teni n di,</para>
  <para style="li2" vid="1CH 23:21">Mahili, ma Musi.</para>
  <para style="li1" vid="1CH 23:21">Mahili bebi-teni n di,</para>
  <para style="li2" vid="1CH 23:21">Eleyasa, ma Kisi.<verse eid="1CH 23:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22" />Eleyasa e ku gɛtɛ en wo bebi-teni. Bebi-nanɩ booko-booko gɛ e wo. Bɔɔdɩrɛ ɛbɛ gɛtɛ be di Kisi bebi-teni fɔ na to bɛ gɩna.<verse eid="1CH 23:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23" />Musi bebi-teni n di</para>
  <para style="li2" vid="1CH 23:23">Mahili, ma Ederi, ma Yerimoti. Ɛbɛ nyabɛ powu bɛ̀ ba besiyee.<verse eid="1CH 23:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />Lefi bete boo-idu yaakpaara-akpaara fɔ yɩɩ bɛnɩ ma akpaara fɔ yɩɩ bɛndɩrɛ bɛ lɛ. Bɛ ŋwara ɛkamasɛ diyere, ma boo-idu yɩɩ bɛnɩ gɛtɛ be di bɩkyan dikpilin abɛɛ dilpilin ka bʋn gɛtɛ bɛ mɛ gʋtʋn Yahwe Dikwo-dɩrɛ daanɩ fɔ baayere. <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />Yema Dafidi ɛ dɔ̀ alan, &lt;&lt;Gɛtɛ Yahwe, Isareli wo Wurubwarɛ ɛ yɛ wɔ bɛnɩ be wura olila, gɛ ɛ bɛ sara Yerusalem gakpaakpa lɛ fɔ, <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />wun mini hiya gɛtɛ Lefi bete fɔ bàà ni tola Getuma gii Dikwo fɔ ma daanyɩmɩnyan gɛtɛ bè de bɛɛ mɛ dɩsʋma daade fɔ be silin.&gt;&gt; <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />Dafidi wade-wùlàlɛ-kurumakyɛɛ gɛtɛ ɛ dɔ̀ yaanɩ fɔ, bɛ kalan Lefi bete gɛtɛ be di bɩkyan dikpilin ka bʋn.<verse eid="1CH 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28" />Lefi bete fɔ bɔɔ gʋtʋn n di gɛtɛ bàà tɩ kpà Aaron wodu wʋʋ bɛnɩ Yahwe Dikwo fɔ dɩɩ gʋtʋn gaade yaanɩ. Baà nya akpaara fɔ ma ikere-ikere yaakwo fɔ yii koro, bàà nya Wurubwarɛ wanyan fɔ yɩɩ gɩfɩrɩnfɩrɩn gii koro, fɔ bàà mɛ bʋtʋn kperen-kperen Wurubwarɛ dɩkpaara fɔ daanɩ. <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />Gɛlɛ ke gɛ bɛɛ nya boroboro gɛtɛ bɛɛ ka bɛ tɛ gedi fɔ, ma ɔnʋmʋ gɛtɛ bɛɛ ka bɛ tɛ anyan yaabi yii gedi fɔ, ma Bisiketi gɛtɛ bɛn sa gɩfa-ŋanlɛ, ma gekuma ma gesugba gaanyan, ma anyan kɛrɛlɛ powu yii koro. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />Gɛlɛ ke gɛ bɛɛ tɔ be yela gagyɩgyan ma ɔgyɔlɔ-kamasɛ bɛ sa Yahwe onyun, fɔ be sila wɔ. <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />Gɛlɛ ke gɛ bɛɛ mɛ ɔya-kamasɛ gɛtɛ bɛnɩ bɛ̀ ka gekuma gii gedi bɛ bɛ tɛ Yahwe ditunawi daanɩ, abɛɛ bebon-fon bɔɔ-ɩsɛ wù gedi yaanɩ, abɛɛ ɩsɛ ɩkɩ yii gedi yaanɩ fɔ. Wù di gɛtɛ bàà mɛ gʋtʋn Yahwe bʋnʋn ɔya-kamasɛ, anlɛ gɛtɛ bɛ dɔ̀ bɛ gɛtɛ baasɔ yàà nɩma fɔ, ma anlɛ gɛtɛ be wùlà bɛ gɛtɛ bàà mɛ fɔ.<verse eid="1CH 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32" />Okoro Lefi bete bɛ nya Getuma gii Dikwo, ma Ɔkʋn-dɩrɛkʋn fɔ yii koro, gɛ bɛ kpà bɔɔ bɛfʋrɩ Aaron wodu wʋʋ bɛnɩ bɛ mɛ gʋtʋn Yahwe Dikwo-dɩrɛ fɔ daanɩ.<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s1">Gʋtʋn gii geyo-tɛ gedi gɩɩ bɛtɛlɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />Anlɛ gɛtɛ be yo Aaron wodu wʋʋ bɛnɩ akpi-akpi fɔ ntɛ ba lɛ.</para>
  <para style="p" vid="1CH 24:1">Aaron bebi-teni fɔ n di Nadabi, ma Abihu, ma Eleyasa, ma Itama. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />Mɔ Nadabi ma Abihu be ku pɛgɛ boote e ku. Gɛ ɛbɛ ben wo bebi-teni. Okoro Eleyasa ma Itama na mɛ gedi gɩɩ bɛtɛlɛ. <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />Sadoki gɛtɛ è di Eleyasa wodu waanɩ wʋʋnɩ fɔ, ma Ahimeleki gɛtɛ è di Itama wodu waanɩ wʋʋnɩ fɔ bɛ kpà Dafidi, gɛ e yo Aaron wodu wʋʋ bɛnɩ fɔ akpen-akpen ɛ sa bɔɔ bʋtʋn baanɩ. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />Gɛ be we gɛtɛ Eleyasa wodu wʋʋ bɛnɩ bɛ̀ sɔ da Itama wodu wʋʋ bɛnɩ. Eleyasa wodu wʋʋ bɛnɩ baakpaara-akpaara yɩɩ bɛndɩrɛ bɛ̀ ba beteni fwo-kooron, gɛ Itama wodu wʋʋ bɛnɩ baakpaara-akpaara yɩɩ bɛndɩrɛ bɛ̀ ba nɩyɛ. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />Bɛ sɩ̀ gɛ ataa bɛ ka be yo ɛbɛ powu gɛtɛ bɛn nya ɛnɩ ɛkɩ bʋnʋn pɛ, yema Dikwo-dɩrɛ fɔ dɩɩ gʋtʋn gɩɩ bɛmɛlɛ ma gedi gɩɩ bɛtɛlɛ bɛ̀ sa Eleyasa ma Itama powu boo-idu yɩɩ bɛnɩ baanɩ.<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />Gɩkpa gɩɩŋwara Semaya gɛtɛ è di Netaneli wobi, gɛ e ye gɛ Lefi wofoli waanɩ fɔ na ŋwara baayere egyu-dɩrɛ bʋnʋn, ma ditele dɩɩ bɛndɩrɛ, ma gedi gɩɩtɛlɛ ɛndɩrɛ Sadoki, ma Ahimeleki wobi Abiyata, ma gedi gɩɩ bɛtɛlɛ fɔ ma baakpaara-akpaara yɩɩ bɛndɩrɛ, ma Lefi bete fɔ bɔɔ bʋnʋn. Bɛ̀ sɩ̀ ataa bɛ tɛ Eleyasa dɩkpaara dɩkɩ fɔ, bɛ sɩ̀ bɛ tɛ Itama mɔ dɩkpaara dɩkɩ.<verse eid="1CH 24:6" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7" />Ataa yɩɩ gɛsɩ̀-gyangbasɛ gɛtɛ bɛ sɩ̀ fɔ i tiri Yehoyaribi,</para>
  <para style="li1" vid="1CH 24:7">ɩnyɔɔfɛ fɔ i tiri Yedaya,<verse eid="1CH 24:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8" />isiyeefɛ fɔ i tiri Harim,</para>
  <para style="li1" vid="1CH 24:8">ɩnaafɛ fɔ i tiri Sewori,<verse eid="1CH 24:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9" />itonfɛ fɔ i tiri Malikiya,</para>
  <para style="li1" vid="1CH 24:9">ikooronfɛ fɔ i tiri Miyamin,<verse eid="1CH 24:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10" />ɩkwarankɩfɛ fɔ i tiri Hakosi,</para>
  <para style="li1" vid="1CH 24:10">ɩnɩyɛfɛ fɔ i tiri Abiya,<verse eid="1CH 24:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11" />ɩyɛkɩfɛ fɔ i tiri Yesuwa,</para>
  <para style="li1" vid="1CH 24:11">ifwofɛ fɔ i tiri Sekaniya,<verse eid="1CH 24:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12" />ifwo-ɛkɩfɛ fɔ i tiri Eliyasibi,</para>
  <para style="li1" vid="1CH 24:12">ifwo-ɩnyɔɔfɛ fɔ i tiri Yakim,<verse eid="1CH 24:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13" />ifwo-esiyeefɛ fɔ i tiri Hupa,</para>
  <para style="li1" vid="1CH 24:13">ifwo-ɩnaafɛ fɔ i tiri Yesebeyabi,<verse eid="1CH 24:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14" />ifwo-tonfɛ fɔ i tiri Biliga,</para>
  <para style="li1" vid="1CH 24:14">ifwo-kooronfɛ fɔ i tiri Imeri,<verse eid="1CH 24:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15" />ifwo-kwarankɩfɛ fɔ i tiri Hesiri,</para>
  <para style="li1" vid="1CH 24:15">ifwo-nɩyɛfɛ fɔ i tiri Hapisesi,<verse eid="1CH 24:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16" />ifwo-yɛkɩfɛ fɔ i tiri Patahiya,</para>
  <para style="li1" vid="1CH 24:16">dikpilinfɛ fɔ i tiri Yahesekeli,<verse eid="1CH 24:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17" />dikpilin ma dɩkɩfɛ fɔ i tiri Yakin,</para>
  <para style="li1" vid="1CH 24:17">dikpilin ma dɩnyɔɔfɛ fɔ i tiri Gamuli,<verse eid="1CH 24:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18" />dikpilin ma disiyeefɛ fɔ i tiri Delaya,</para>
  <para style="li1" vid="1CH 24:18">dikpilin ma dɩnaafɛ fɔ i tiri Maasiya.<verse eid="1CH 24:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />Anlɛ gɛ be tiri bɛnɩ fɔ bɛ sɩ̀ gengyi bee gyu Yahwe Dikwo-dɩrɛ fɔ daanɩ fɔ. Be tiri bɛ bɛ sɩ̀ anlɛ gɛtɛ Yahwe, Isareli wo Wurubwarɛ ɛ da ma bootu Aaron wo koro e wùlà bɛ fɔ.<verse eid="1CH 24:19" /></para>
  <para style="s1">Lefi wodu wʋʋ bɛnɩ-kurumakyɛɛ</para>
  <para style="m">
    <verse number="20" style="v" sid="1CH 24:20" />Lefi wodu wʋʋ bɛnɩ-kurumakyɛɛ baakpaara-akpaara yɩɩ bɛndɩrɛbi baayere n tɛ ba lɛ.</para>
  <para style="li1" vid="1CH 24:20">Subayeli gɛtɛ e ye Amiram wodu wʋʋ bɛnɩ baanɩ fɔ,</para>
  <para style="li2" vid="1CH 24:20">ma Yehideya gɛtɛ e ye Subayeli wodu wʋʋ bɛnɩ baanɩ fɔ.<verse eid="1CH 24:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21" />Rehabiya wodu wʋʋ bɛnɩ baanɩ fɔ,</para>
  <para style="li2" vid="1CH 24:21">Isiya n di dɩkpaara dɩɩndɩrɛ.<verse eid="1CH 24:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22" />Selomoti e ye Isahari wodu waanɩ,</para>
  <para style="li2" vid="1CH 24:22">Yahati e ye Selomoti wodu waanɩ.<verse eid="1CH 24:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23" />Hebron wodu wʋʋ bɛnɩ n di Yeriya, ma Amariya, ma Yahasiyeli, ma Yekameyam.<verse eid="1CH 24:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24" />Mika e ye Wusiyeli wodu waanɩ,</para>
  <para style="li2" vid="1CH 24:24">Samiri e ye Mika wodu waanɩ.<verse eid="1CH 24:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 24:25" />Mika wonobi n di Isiya.</para>
  <para style="li1" vid="1CH 24:25">Sekariya e ye Isiya wodu waanɩ.<verse eid="1CH 24:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26" />Merari wodu wʋʋ bɛnɩ n di Mahili ma Musi.</para>
  <para style="li2" vid="1CH 24:26">Yaasiya wobi-teni n di Beno.<verse eid="1CH 24:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27" />Merari wodu wʋʋ bɛnɩ n tɛ ba lɛ.</para>
  <para style="li2" vid="1CH 24:27">Yaasiya bebi-teni Beno, ma Soham, ma Sakuri, ma Ibiri.<verse eid="1CH 24:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28" />Mahili wobi-teni Eleyasa, gɛtɛ ɛwɔ en wo bebi-teni fɔ.<verse eid="1CH 24:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29" />Ma Kisi wobi-teni</para>
  <para style="li2" vid="1CH 24:29">Yerahimeeli.<verse eid="1CH 24:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30" />Ma Musi bebi-teni Mahili, ma Ederi, ma Yerimoti.</para>
  <para style="b" vid="1CH 24:30" />
  <para style="p" vid="1CH 24:30">Lefi bete fɔ ma baakpaara-akpaara bɛ lɛ. <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" />Gɛlɛ ke gɛ ɛbɛ mɔ bɛ sɩ̀ ataa anlɛ gɛtɛ bɔɔ bɛfʋrɩ Aaron wodu wʋʋ bɛnɩ bɛ mɛ egyu-dɩrɛ Dafidi, ma Sadoki, ma Ahimeleki, ma gedi gɩɩ bɛtɛlɛ baakpaara-akpaara fɔ yɩɩ bɛndɩrɛ, ma Lefi bete fɔ bɔɔ bʋnʋn fɔ. Anlɛ gɛtɛ bɛ mɛ bɛndɩrɛ baakpaara fɔ, gɛlɛ ke gɛ bɛ mɛ bebi baakpaara mɔ.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s1">Ɩnʋn yɩɩ bɛnʋmalɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />Wʋʋ gama fɔ, Dafidi ma bɩtà bʋʋ bɛtàlɛ bɔɔ bɛndɩrɛ fɔ be tiri Asafu, ma Heman, ma Yedutun boo-idu yɩɩ bɛnɩ bɛkɩ bɛ sɩ̀ gɛtɛ bàà mɛ Wurubwarɛ bɛtabʋrʋlɛ bɔɔ gʋtʋn, fɔ bàà tà adʋlɛ ɛbɛ dɩrɛ-dɩrɛ ma adʋlɛ ɛbɛ buruburu, ma akyaka. Bɛnɩ gɛtɛ be tiri gɛtɛ bàà mɛ gɛlɛ gɩɩ gʋtʋn fɔ baayere n tɛ ba lɛ.<verse eid="1CH 25:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2" />Asafu bebi gɛtɛ be tiri fɔ n di,</para>
  <para style="li2" vid="1CH 25:2">Sakuri, ma Yosefu, ma Nataniya, ma Asarela. Fɔ boote Asafu n di bɔɔndɩrɛ, ɛwɔ Asafʋ mɔ ɛɛ tabʋrʋ Wurubwarɛ Wade ɔya-kamasɛ gɛtɛ egyu-dɩrɛ ɛ̀ dɔ̀ wɔ alɛ ɛ tabʋrʋ fɔ.<verse eid="1CH 25:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3" />Yedutun bebi gɛtɛ be tiri fɔ n di,</para>
  <para style="li2" vid="1CH 25:3">Gadaliya, ma Seri, ma Yesaya, ma Simeyi, ma Hasabiya, ma Matitiya. Ɛbɛ powu bɛ̀ ba bɛnɩ kooron, gɛ boote Yedutun n di boogyegeyelɛ. Yedutun ɛɛ da ma adʋlɛ-dɩrɛ gɛtà gii koro ɛ tabʋrʋ ɛ sa Yahwe onyun, fɔ e sila wɔ.<verse eid="1CH 25:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4" />Heman bebi gɛtɛ be tiri fɔ n di,</para>
  <para style="li2" vid="1CH 25:4">Bukiya, ma Mataniya, ma Wusiyeli, ma Subayeli, ma Yerimoti, ma Hananiya, ma Hanani, ma Eliyata, ma Gidaliti, ma Romamiti-Eseri, ma Yosibekasa, ma Maloti, ma Hotiri, ma Mahasiyoti. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />Bɛnɩ nyabɛ powu bè di gɛ Hema gɛtɛ è di Wurubwarɛ wɔtabʋrʋlɛ tɛ egyu-dɩrɛ fɔ bebi. Wurubwarɛ ɛ ka bebi fɔ ɛ tɛ Heman, anlɛ gɛtɛ ɛ dɔ̀ ɛ sɩ̀ fɔ, gɛtɛ wàà ka sa Heman ɔkɛma. Wurubwarɛ ɛ tɛ Heman bebi-teni fwo-bɛnaa ma bɛnanɩ besiyee.<verse eid="1CH 25:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6" />Bɛnɩ nyabɛ powu bɛ sara boote ɛbɛ bɔɔ gatɩn bɛ mɛ ɩnʋn yɩɩ gɛnʋma gɩɩ gʋtʋn Yahwe Dikwo-dɩrɛ fɔ daanɩ. Bɛ ka akyaka, ma adʋlɛ ɛbɛ buruburu, ma adʋlɛ ɛbɛ dɩrɛ-dɩrɛ bɛ mɛ gʋtʋn Wurubwarɛ dɩkpaara daanɩ. Asafu ma Yedutun, ma Heman bɛɛ mɛ anlɛ gɛtɛ egyu-dɩrɛ ee lila e ye baakʋn fɔ. <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />Ɛbɛ ma bɔɔ bɛfʋrɩ gɛtɛ bɛ kasɩ ɩnʋn yɩɩ gɛnʋma gaade, gɛ bɛ̀ nyɩ̀ waanɩ gepepe fɔ powu bɛ̀ ba gɛkpɩn ma akpilin anaa ma nɩyɛ (288). <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />Bɛsaranyan ma bɛndɩrɛ oo, Bewùlàlɛ ma bɛkasɩlɛ oo, ataa gɛ bɛ sɩ̀ be tiri baanɩ-kamasɛ ma wɔ gʋtʋn.<verse eid="1CH 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 25:9" />Ataa yɩɩ gɛsɩ̀-gyangbasɛ tɛ Asafu fɔ i tiri Yosefu, ma wo bebi, ma wɔ bɛfʋrɩ. Ataa yɩɩ gɛsɩ̀-nyɔɔfɛ fɔ i tiri Gedaliya. Gɛ ɛwɔ ma wɔ bɛfʋrɩ, ma wo bebi powu bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:9" /><verse number="10" style="v" sid="1CH 25:10" />Gɛsɩ̀-siyeefɛ gi tiri Sakuri, ma wo bebi, ma wɔ bɛfʋrɩ, gɛ bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:10" /><verse number="11" style="v" sid="1CH 25:11" />Gɛsɩ̀-naafɛ gi tiri Isiri, ma wɔ bɛfʋrɩ, ma wo bebi. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:11" /><verse number="12" style="v" sid="1CH 25:12" />Gɛsɩ̀-tonfɛ gi tiri Netaniya, ma wo bebi ma wɔ bɛfʋrɩ, gɛ bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:12" /><verse number="13" style="v" sid="1CH 25:13" />Gɛsɩ̀-kooronfɛ gi tiri Bukiya, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:13" /><verse number="14" style="v" sid="1CH 25:14" />Gɛsɩ̀-kwarankɩfɛ gi tiri Yesarela, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:14" /><verse number="15" style="v" sid="1CH 25:15" />Gɛsɩ̀-nɩyɛfɛ gi tiri Yesaya, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:15" /><verse number="16" style="v" sid="1CH 25:16" />Gɛsɩ̀-yɛkɩfɛ gi tiri Mataniya, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:16" /><verse number="17" style="v" sid="1CH 25:17" />Gɛsɩ̀-fwofɛ gi tiri Simeyi, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:17" /><verse number="18" style="v" sid="1CH 25:18" />Gɛsɩ̀-fwo-gɩkɩfɛ gi tiri Asareli, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba bɛnɩ fwo-bɛnyɔɔ. <verse eid="1CH 25:18" /><verse number="19" style="v" sid="1CH 25:19" />Gɛsɩ̀-fwo-nyɔɔfɛ gi tiri Hasabiya, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:19" /><verse number="20" style="v" sid="1CH 25:20" />Gɛsɩ̀-fwo-siyeefɛ gi tiri Subayeli, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:20" /><verse number="21" style="v" sid="1CH 25:21" />Gɛsɩ̀-fwo-naafɛ gi tiri Matitiya, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:21" /><verse number="22" style="v" sid="1CH 25:22" />Gɛsɩ̀-fwo-tonfɛ gi tiri Yerimoti, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:22" /><verse number="23" style="v" sid="1CH 25:23" />Gɛsɩ̀-fwo-kooronfɛ gi tiri Hananiya, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:23" /><verse number="24" style="v" sid="1CH 25:24" />Gɛsɩ̀-fwo-kwarankɩfɛ gi tiri Yosibekasa, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:24" /><verse number="25" style="v" sid="1CH 25:25" />Gɛsɩ̀-fwo-nɩyɛfɛ gi tiri Hanani, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:25" /><verse number="26" style="v" sid="1CH 25:26" />Gɛsɩ̀-fwo-yɛkɩfɛ gi tiri Maloti, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:26" /><verse number="27" style="v" sid="1CH 25:27" />Gɛsɩ̀ dikpilinfɛ gi tiri Eliyata, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:27" /><verse number="28" style="v" sid="1CH 25:28" />Gɛsɩ̀ dikpilin ma gɩkɩfɛ gi tiri Hotiri, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:28" /><verse number="29" style="v" sid="1CH 25:29" />Gɛsɩ̀ dikpilin ma gɩnyɔɔfɛ gi tiri Gidaliti, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:29" /><verse number="30" style="v" sid="1CH 25:30" />Gɛsɩ̀ dikpilin ma gisiyeefɛ gi tiri Mahasiyoti, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ. <verse eid="1CH 25:30" /><verse number="31" style="v" sid="1CH 25:31" />Gɛsɩ̀ dikpilin ma gɩnaafɛ gi tiri Romamiti-Eseri, ma wo bebi, ma wɔ bɛfʋrɩ. Bɛ̀ ba fwo-bɛnyɔɔ.<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s1">Otunu wʋʋ bɛnyalɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />Anlɛ gɛtɛ be yo-yo itunu yɩɩ bɛnyalɛ fɔ n tɛ ba lɛ.</para>
  <para style="b" vid="1CH 26:1" />
  <para style="li1" vid="1CH 26:1">Kora wodu wʋʋ bɛnɩ baanɩ fɔ, be tiri Kore wobi Meselemiya, gɛtɛ è di Asafu bɛnana baanɩ ɛkɩ fɔ.<verse eid="1CH 26:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 26:2" />Meselemiya e wo bebi-teni gɛtɛ baayere n di,</para>
  <para style="li2" vid="1CH 26:2">Sekariya, gɛtɛ ɛwɔ n di ebi ɛndɩrɛ.</para>
  <para style="li2" vid="1CH 26:2">ɛnyɔɔfɛ n di Yediyayeli,</para>
  <para style="li2" vid="1CH 26:2">esiyeefɛ n di Sebadiya,</para>
  <para style="li2" vid="1CH 26:2">ɛnaafɛ n di Yatiniyeli,<verse eid="1CH 26:2" /></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3" />etonfɛ n di Elam,</para>
  <para style="li2" vid="1CH 26:3">ekooronfɛ n di Yehohanan,</para>
  <para style="li2" vid="1CH 26:3">ɛkwarankɩfɛ n di Elihonayi.<verse eid="1CH 26:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4" />Obedi-Edom mɔ e wo bebi-teni gɛtɛ baayere n di,</para>
  <para style="li2" vid="1CH 26:4">Semaya, gɛtɛ ɛwɔ n di ebi ɛndɩrɛ.</para>
  <para style="li2" vid="1CH 26:4">ɛnyɔɔfɛ n di Yehosabadi,</para>
  <para style="li2" vid="1CH 26:4">esiyeefɛ n di Yowa,</para>
  <para style="li2" vid="1CH 26:4">ɛnaafɛ n di Sakari,</para>
  <para style="li2" vid="1CH 26:4">etonfɛ n di Netaneli,<verse eid="1CH 26:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 26:5" />ekooronfɛ n di Amiyeli,</para>
  <para style="li2" vid="1CH 26:5">ɛkwarankɩfɛ n di Isaka,</para>
  <para style="li2" vid="1CH 26:5">ɛnɩyɛfɛ n di Peletayi.</para>
  <para style="li2" vid="1CH 26:5">Yema Wurubwarɛ e hira Obedi-Edom.<verse eid="1CH 26:5" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6" />Gɛ Obedi-Edom wobi Semaya mɔ e wo bebi-tenibi gɛtɛ bɛ mɛ baakpaara yɩɩ bɛndɩrɛ, yema bɛ mɛ bɛnɩ gɛtɛ bɛɛ ka koro. <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />Semaya bebi-teni n di Otini, ma Raphayeli, ma Obedi, ma Elisabadi. Bɔɔ bɛfʋrɩ Elihu, ma Semakiya mɔ bè di bɛnɩ gɛtɛ bɛɛ ka koro. <verse eid="1CH 26:7" /><verse number="8" style="v" sid="1CH 26:8" />Gɛlɛ gɩɩ bɛnɩ nyabɛ powu bè di gɛ Obedi-Edom wodu wʋʋ bɛnɩ. Ɛbɛ ma boo bebi-teni, ma bɔɔ bɛfʋrɩ bè di bɛnɩ gɛtɛ bɛɛ ka koro, gɛ bɛ̀ ba ɔkɛma tɛ gʋtʋn fɔ gɩɩ gɛmɛ. Obedi-Edom wodu wʋʋ bɛnɩ powu bɛ̀ ba akpilin asiyee ma bɛnyɔɔ (62).<verse eid="1CH 26:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 26:9" />Meselemiya bebi ma wɔ bɛfʋrɩ mɔ bè di gɛ begyegeyelɛ gɛtɛ bɛɛ ka koro. Ɛbɛ powu bɛ̀ ba fwo-nɩyɛ (18). <verse eid="1CH 26:9" /><verse number="10" style="v" sid="1CH 26:10" />Hosa gɛtɛ e ye Merari fɔ bebi-teni n di, Simiri (ma gɛtɛ nka ɛwɔ n di ebi ɛndɩrɛ gba fɔ, wote ɛ ka wɔ ɛ mɛ egyegeyelɛ). <verse eid="1CH 26:10" /><verse number="11" style="v" sid="1CH 26:11" />Ɛnyɔɔfɛ n di Hilikiya, esiyeefɛ n di Tabiliya, gɛ ɛnaafɛ n di Sekariya. Hosa bebi-teni ma wɔ bɛfʋrɩ powu bɛ̀ ba fwo besiyee (13).<verse eid="1CH 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12" />Itunu yɩɩ bɛnyalɛ baakpen-akpen nyabɛ ma bɔɔ bɛndɩrɛ bɛ mɛ gʋtʋn gɛtɛ be yo bɛ tɛ bɛ Yahwe bʋnʋn anlɛ gɛtɛ bɔɔ bɛfʋrɩ Lefi bete-kurumakyɛɛ bɛ mɛ fɔ. <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />Bɛ sɩ̀ gɛ ataa be tiri dɩkpaara-kamasɛ ma diitunu. Bɛn nya alɛ ɩkɩ ì we pɩɩ, abɛɛ ɩkɩ mɔ ɩ̀ sɔ.<verse eid="1CH 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 26:14" />Ataa yɩɩ gɛsɩ̀ tɛ ofila wʋʋ gɛtàkʋn wʋʋ gɩlan wuutunu wʋʋnyalɛ fɔ gi tiri Selemiya. Gɛ ataa fɔ yɩɩ gɛsɩ̀ gi tiri wobi Sekariya, gɛtɛ è di amɩnlɛ yɩɩtɛlɛ-kpara gɛtɛ ɛ̀ɛ̀ nya gatala gɩɩ gɩlan wuutunu fɔ wuu koro. <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" />Ataa yɩɩ gɛsɩ̀ tɛ gatɩn gɩɩ gɩlan giitunu fɔ gi tiri Obedi-Edom, gɛ gi tiri wo bebi-teni gɛtɛ bàà nya anyan yɩɩ gɛsɩ̀kʋn gii dikwo fɔ yii koro. <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" />Ataa fɔ yɩɩ gɛsɩ̀ tɛ ofila wʋʋ gɛnʋ̀nkʋn gɩɩ gɩlan wuutunu, ma Saleketi wotunu gɛtɛ wʋ̀ sa osele gɛtɛ wʋ̀ dɔ wʋʋ bʋn fɔ wʋʋpɩ fɔ gi tiri Supim ma Hosa.</para>
  <para style="p" vid="1CH 26:16">Anlɛ gɛtɛ bɛdɩyɛlɛ fɔ be yo gʋtʋn fɔ ma bɛwɔlɔn ɔya-ɔya fɔ n tɛ ba lɛ. <verse eid="1CH 26:16" /><verse number="17" style="v" sid="1CH 26:17" />Lefi bete kooron bɛɛ sara ofila wʋʋ gɛtàkʋn wʋʋ gɩlan duwi-kamasɛ. Bɛnaa bɛɛ sara gatala gɩɩ gɩlan. Bɛnaa bɛɛ sara gatɩn gɩɩ gɩlan, gɛ bɛnyɔɔ-bɛnyɔɔ bɛɛ ka ɔya-kɩlɩn bɛ sara bɛ nya anyan yɩɩ gɛsɩ̀ yaakwo fɔ yii koro. <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />Gɛ bɛnɩ bɛnaa bɛɛ nya kpata gɛtɛ wʋ̀ sa san ma ofila wʋʋ gɛnʋ̀nkʋn wʋʋ gɩlan fɔ wuusele fɔ, gɛ bɛnɩ bɛnyɔɔ bɛɛ nya dɩkpaara fɔ dii koro.<verse eid="1CH 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 26:19" />Anlɛ gɛ be yo Kora ma Merari boo-idu yɩɩ bɛnɩ akpi-akpi gɛtɛ bàà mɛ itunu yɩɩ bɛnyalɛ fɔ.<verse eid="1CH 26:19" /></para>
  <para style="s1">Dikwo-dɩrɛ fɔ dɩɩ bʋtʋn-kurumakyɛɛ</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />Bɔɔwɔlɔn ɛbɛ Lefi bete bɛkɩ mɔ bɛ nya anyan-gbaa-gbaa gɛtɛ ɩ̀ sa Wurubwarɛ dɩkpaara daanɩ fɔ, ma anyan-gbaa-gbaa gɛtɛ be tiri bɛ sɩ̀ bɛ tɛ Wurubwarɛ fɔ yii koro.<verse eid="1CH 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21" />Ladan wodu wʋʋ bɛnɩ gɛtɛ be ye Gerison anɩ, gɛ bɛ mɛ Ladan gɛtɛ è di Gerison-te fɔ wakpaara yɩɩ bɛndɩrɛ fɔ n di Yahiyeli, <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />ma Yehiyeli bebi-teni, ma Setam, ma wonobi Yoweli. Ɛbɛ na nya Yahwe Dikwo-dɩrɛ fɔ daanyan-gbaa-gbaa yii koro.<verse eid="1CH 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 26:23" />Amiram wodu wʋʋ bɛnɩ, ma Isahari wodu wʋʋ bɛnɩ, ma Hebron wodu wʋʋ bɛnɩ, ma Wusiyeli wodu wʋʋ bɛnɩ gɛtɛ bɛ mɛ gʋtʋn fɔ n di<verse eid="1CH 26:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 26:24" />Subayeli, gɛtɛ è di Mose wobi Gerisom wodu wʋʋnɩ fɔ na mɛ anyan-gbaa-gbaa yɩɩ gɛsɩ̀kʋn gɩɩnyalɛ ɛndɩrɛ. <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />Wɔ bɛfʋrɩ, gɛtɛ bè di wonobi Eliyese wodu wʋʋ bɛnɩ fɔ n tɛ ba lɛ. Eliyese e wo Rehabiya, gɛ ɛwɔ mɔ e wo Yesaya, gɛtɛ e wo Yoram fɔ. Yoram na wo Sikiri, gɛtɛ e wo Selomiti fɔ. <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />Selomiti ma wɔ bɛfʋrɩ na nya anyan-gbaa-gbaa gɛtɛ egyu-dɩrɛ Dafidi, ma akpaara-akpaara powu yɩɩ bɛndɩrɛ gɛtɛ bè di akpaara yɩɩ bɛndɩrɛ gɛtɛ bɛɛ nya bɩtà bʋʋ bɛtàlɛ nkpɩn ton-ton, ma akpilin ton-ton boo koro fɔ, ma bɩtà bʋʋ bɛtàlɛ bɛkɩ bɔɔ bɛndɩrɛ baanyan gɛtɛ be tiri bɛ sɩ̀ bɛ tɛ Yahwe fɔ yii koro. <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />Bɛ mɛ anyɩmɩnyan fɔ ɩkɩ gɛtɛ be kpila be ye bɩtà baanɩ fɔ fɩrɩnfɩrɩn, gɛ bɛ ka yɩ bɛ pɩna Yahwe Dikwo-dɩrɛ fɔ. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />Selomoti ma wɔ bɛfʋrɩ na nya anyan gɛtɛ Wurubwarɛ wɔtabʋrʋlɛ Samuweli, ma Kisi wobi Sawulo, ma Neri wobi Abineri ma Seruya wobi Yowabi be tiri bɛ tɛ gɛtɛ bàà ka mɛ Wurubwarɛ Dikwo-dɩrɛ fɔ dɩɩ gʋtʋn fɔ, ma anyan-tɛlɛ-kurumakyɛɛ-do fɔ yii koro.<verse eid="1CH 26:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 26:29" />Isahari wodu wʋʋ bɛnɩ baanɩ fɔ, bɛ tɛ Kenaniya ma wo bebi-teni gʋtʋn gɛtɛ gɩɩn ma Dikwo-dɩrɛ fɔ daanɩ. Bɛ mɛ gɛ gɩfɩɩ gɩɩ bɛndɩrɛ, ma gɔdɔ gɩɩ bɛdɔ̀lɛ bɛ tɛ Isareli.<verse eid="1CH 26:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 26:30" />Hebron wodu wʋʋ bɛnɩ baanɩ fɔ, be tiri Hasabiya ma wɔ bɛfʋrɩ, gɛtɛ ɛbɛ powu bɛ̀ ba nkpɩn nɩyɛ ma akpilin ton (1,700) fɔ, gɛtɛ bàà nya Isareli bɛnɩ gɛtɛ bɛ̀ sa Yodan getu giifila wʋʋ gɛnʋ̀nkʋn wʋʋ gɩlan fɔ boo koro, fɔ bàà nya Yahwe gʋtʋn-kamasɛ ma egyu-dɩrɛ gʋtʋn-kamasɛ gii koro. <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />Hebron bete boo gewo-tama giidu gɩɩ gɩkpa gɛtɛ bɛ ŋwara baakpaara-akpaara yaanɩ fɔ, Yeriya n di dɩkpaara dɩɩndɩrɛ. Dafidi bugyu buu gedi wʋʋ gɩkyan akpilin anyɔɔfɛ gaanɩ fɔ, be bugiti ade be ye akpa yaanɩ, gɛ be we gɛtɛ Hebron bɛnɩ gɛtɛ bɛɛ ka koro fɔ bɛ sara Yaseri gɛtɛ wʋ̀ sa Gileyadi fɔ. <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />Yeriya bɛfʋrɩ bɛ̀ ba gbaa ma nkpɩn bisiyee ma akpilin ton (2,700) gɛtɛ bè di ɔkɛma wʋʋ bɛnɩ, gɛ bè di akpaara yɩɩ bɛndɩrɛ. Egyu-dɩrɛ Dafidi e tiri bɛ gɛtɛ bàà nya Ruben bete, ma Gadi bete, ma Manase wofoli-fan fɔ boo koro Wurubwarɛ wade-kamasɛ, ma egyu-dɩrɛ wade yaanɩ.<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s1">Bɩtà bʋʋ bɛtàlɛ boo geyo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />Bɛnɩ gɛtɛ bɛ sara bɩtà bʋʋ bɛtàlɛ baanɩ bɛ sʋma Dafidi, gɛtɛ bè di akpaara yɩɩ bɛndɩrɛ, ma bɩtà bʋʋ bɛndɩrɛ gɛtɛ bɛɛ nya bɛnɩ nkpɩn ton-ton boo koro, ma ɛbɛ gɛtɛ bɛɛ nya bɛnɩ akpilin ton-ton boo koro, ma gʋtʋn gii beyolɛ fɔ baayere n tɛ ba lɛ. Gɩkyan-kamasɛ, bɛnɩ bɛɛ bɛ̀ sara ebon-ebon bɛ mɛ bɔɔ gʋtʋn. Dikpi-kamasɛ dɩ̀ ba bɛnɩ disepekyi ma ɩgbaa ɩnyɔɔ (24,000).<verse eid="1CH 27:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2" />Sabidiyeli wobi Yasobeyam na mɛ dikpi-gyangbasɛ diigyegeyelɛ ɛ tɛ ebon-gyangbasɛ. Beteni disepekyi ma ɩgbaa ɩnyɔɔ (24,000) na sara wɔ gatɩn. <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />E ye gɛ Peresi wodu waanɩ, gɛ ɛ mɛ ebon-gyangbasɛ bɩtà bʋʋ bɛtàlɛ powu bɔɔndɩrɛ.<verse eid="1CH 27:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4" />Ahohi-te Dodayi na mɛ ebon-nyɔɔfɛ dikpi dɩɩndɩrɛ, gɛ wɔmalɛ n di Makiloti. Beteni disepekyi ma ɩgbaa ɩnyɔɔ (24,000) na sara wɔ gatɩn.<verse eid="1CH 27:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5" />Bɩtà bʋʋndɩrɛ-siyeefɛ tɛ ebon-siyeefɛ fɔ n di gedi gɩɩtɛlɛ Yehoyada wobi Benaya. Ɛwɔ na mɛ egyegeyelɛ, gɛ beteni disepekyi ma ɩgbaa ɩnyɔɔ (24,000) na sara wɔ gatɩn. <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />Gɛlɛ gɩɩ Benaya nyawɔ na mɛ bɩtà bʋʋtàlɛ-dɩrɛ gɛtɛ ɛ fɩya ma bɛnɩ dikpilin ma fwo fɔ, gɛ ɛ mɛ bɔɔndɩrɛ fɔ. Wobi Amisabadi na nya wo dikpi fɔ dii koro.<verse eid="1CH 27:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7" />Bɩtà bʋʋndɩrɛ-naafɛ tɛ ebon-naafɛ fɔ n di Yowabi wonobi Asaheli. Wobi Sabadiya na sere wɔ gɩsɩrɩ. Beteni disepekyi ma ɩgbaa ɩnyɔɔ (24,000) na sara wɔ gatɩn.<verse eid="1CH 27:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8" />Bɩtà bʋʋndɩrɛ-tonfɛ tɛ ebon-tonfɛ fɔ n di bɩtà bʋʋndɩrɛ Samihuti gɛtɛ è di Isahari-te fɔ. Bɛnɩ disepekyi ma ɩgbaa ɩnyɔɔ (24,000) na sara wɔ gatɩn.<verse eid="1CH 27:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9" />Bɩtà bʋʋndɩrɛ-kooronfɛ tɛ ebon-kooronfɛ n di Tekowa-te Ikesi wobi Ira. Beteni disepekyi ma ɩgbaa ɩnyɔɔ (24,000) na sara wɔ gatɩn.<verse eid="1CH 27:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10" />Bɩtà bʋʋndɩrɛ-kwarankɩfɛ tɛ ebon-kwarankɩfɛ fɔ n di Pelon-te Helesi, gɛtɛ e ye Efrayim wodu waanɩ fɔ. Beteni disepekyi ma ɩgbaa ɩnyɔɔ (24,000) na sara wɔ gatɩn.<verse eid="1CH 27:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11" />Sibekayi gɛtɛ e ye Husati, gɛ è di Sera wodu wʋʋnɩ fɔ na mɛ dikpi-nɩyɛfɛ dɩɩndɩrɛ tɛ ebon-nɩyɛfɛ. Bɛnɩ disepekyi ma ɩgbaa ɩnyɔɔ (24,000) na sara wɔ gatɩn.<verse eid="1CH 27:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12" />Benyamin-te Abiyese gɛtɛ e ye Anatoti fɔ na mɛ dikpi-yɛkɩfɛ dɩɩndɩrɛ tɛ ebon-yɛkɩfɛ. Beteni disepekyi ma ɩgbaa ɩnyɔɔ (24,000) na sara wɔ gatɩn.<verse eid="1CH 27:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13" />Maharayi gɛtɛ e ye Netofati, gɛ è di Sera wodu wʋʋnɩ fɔ na mɛ dikpi-fwofɛ dɩɩndɩrɛ tɛ ebon-fwofɛ. Beteni disepekyi ma ɩgbaa ɩnyɔɔ (24,000) na sara wɔ gatɩn.<verse eid="1CH 27:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14" />Benaya gɛtɛ e ye Piraton, gɛtɛ wʋ̀ sa Efrayim wofoli wʋʋ gɛtʋnkwaa gaanɩ fɔ na mɛ dikpi-fwo-dɩkɩfɛ dɩɩndɩrɛ tɛ ebon-fwo-ɛkɩfɛ. Beteni disepekyi ma ɩgbaa ɩnyɔɔ (24,000) na sara wɔ gatɩn.<verse eid="1CH 27:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15" />Helidayi gɛtɛ e ye Netofati ditele, gɛ e ye gɛ Otiniyeli dɩkpaara daanɩ fɔ na mɛ dikpi-fwo-dɩnyɔɔfɛ dɩɩndɩrɛ tɛ ebon-fwo-ɛnyɔɔfɛ. Beteni disepekyi ma ɩgbaa ɩnyɔɔ (24,000) na sara wɔ gatɩn.<verse eid="1CH 27:15" /></para>
  <para style="s1">Ifoli fɔ yii begyegeyelɛ</para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 27:16" />Isareli wo-ifoli fɔ yii begyegeyelɛ baayere n tɛ ba lɛ.</para>
  <para style="b" vid="1CH 27:16" />
  <para style="li1" vid="1CH 27:16">Ruben bɛnɩ boogyegeyelɛ n di Sikiri wobi Eliyese.</para>
  <para style="li1" vid="1CH 27:16">Simeyon bɛnɩ boogyegeyelɛ n di Maaka wobi Sefatiya.<verse eid="1CH 27:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17" />Lefi bɛnɩ boogyegeyelɛ n di Kemuweli wobi Hasabiya.</para>
  <para style="li1" vid="1CH 27:17">Aaron bɛnɩ boogyegeyelɛ n di Sadoki.<verse eid="1CH 27:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18" />Yuda bɛnɩ boogyegeyelɛ n di Elihu gɛtɛ è di Dafidi wɔdɩrɛ ɛbɛ baanɩ ɛkɩ fɔ.</para>
  <para style="li1" vid="1CH 27:18">Isaka bɛnɩ boogyegeyelɛ n di Mikayeli wobi Omiri.<verse eid="1CH 27:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19" />Sebulun bɛnɩ boogyegeyelɛ n di Obediya wobi Isimaya. Nafitali bɛnɩ boogyegeyelɛ n di Asiriyeli wobi Yerimoti.<verse eid="1CH 27:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20" />Efrayim bɛnɩ boogyegeyelɛ n di Asasiya wobi Hoseya.</para>
  <para style="li1" vid="1CH 27:20">Manase wofoli-fan fɔ wʋʋ bɛnɩ boogyegeyelɛ n di Pedaya wobi Yoweli.<verse eid="1CH 27:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21" />Manase wofoli-fan gɛtɛ wʋ̀ sa Gileyadi fɔ wʋʋndɩrɛ n di Sekariya wobi Ido.</para>
  <para style="li1" vid="1CH 27:21">Benyamin bɛnɩ boogyegeyelɛ n di Abineri wobi Yaasiyeli.<verse eid="1CH 27:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22" />Dan bɛnɩ boogyegeyelɛ n di Yeroham wobi Asareli.</para>
  <para style="p" vid="1CH 27:22">Isareli wo-ifoli fɔ yɩɩ bɛndɩrɛ bɛ lɛ.<verse eid="1CH 27:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />Egyu Dafidi ɛn kalan beteni gɛtɛ bɛ̀ ba bɩkyan dikpilin (20) abɛɛ bɩkyan dikpilin bʋʋ gatɩn fɔ fɩya, yema Yahwe ɛ dɔ̀ ɛ sɩ̀ gɛtɛ ɛɛ̀ yɛ Isareli bete bàà sɔ anlɛ aŋorobi. <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />Seruya wobi Yowabi na kya bɛnɩ fɔ bɔɔ gɛkalan, mɔ ɛn talɩ werema. Wurubwarɛ wowurufa wʋ ba Isareli wo koro, bɛnɩ bɔɔ gɛkalan fɔ gii koro. Okoro bɛn ŋwara bɛnɩ fɔ baasɔ sa egyu Dafidi wo koro gaade yɩɩ gɩkpa fɔ gaanɩ.<verse eid="1CH 27:24" /></para>
  <para style="s1">Egyu-dɩrɛ gʋtʋn gɩɩ bɛmɛlɛ gɩɩ bɛndɩrɛ</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 27:25" />Adiyeli wobi Asimafeti na mɛ ɛndɩrɛ ɛ tɛ egyu-dɩrɛ wanyan yɩɩ gɛsɩ̀kʋn gaakwo fɔ.</para>
  <para style="p" vid="1CH 27:25">Gɛ Usiya wobi Yonatan na mɛ ɛndɩrɛ ɛ tɛ anyan yɩɩ gɛsɩ̀kʋn gɛtɛ ɩ̀ sa ɩlanlanbi, ma atele-dɩrɛ, ma atelebi, ma ayela-dɩyɛkʋn yaanɩ fɔ. <verse eid="1CH 27:25" /><verse number="26" style="v" sid="1CH 27:26" />Kelubi wobi Esiri na mɛ ɛndɩrɛ ɛ tɛ bɛfʋnlɛ gɛtɛ bɛ fʋn ili gɛtʋnkwaa fɔ gaanɩ fɔ.<verse eid="1CH 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 27:27" />Ramati-te Simeyi na mɛ ɛndɩrɛ ɛ tɛ wayɩn wo-ili.</para>
  <para style="p" vid="1CH 27:27">Sifim-te Sabidi na mɛ ɛndɩrɛ ɛ tɛ wayɩn wabi gɛtɛ bɛ yà fɔ, ma wayɩn fɔ bʋkan bʋʋ gɛsɩ̀kʋn.<verse eid="1CH 27:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 27:28" />Gederi-te Baal-Hanan na mɛ ɛndɩrɛ ɛ tɛ olifwi ma sikamo yii-iyon gɛtɛ ɩ̀ sa odon wʋʋ bɩsɩrɩ wuufila wʋʋ gɛnʋ̀nkʋn gɩɩ gɩlan fɔ.</para>
  <para style="p" vid="1CH 27:28">Yowasi na mɛ ɛndɩrɛ ɛ tɛ olifwi bʋnɔ bʋʋ gɛsɩ̀kʋn.<verse eid="1CH 27:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 27:29" />Sitirayi gɛtɛ e ye Saron fɔ na mɛ ɛndɩrɛ ɛ tɛ bɛkwɔ gɛtɛ bɛ sara Saron fɔ bɔɔ gɛnya.</para>
  <para style="p" vid="1CH 27:29">Adilayi wobi Safati na mɛ ɛndɩrɛ ɛ tɛ bɛkwɔ gɛtɛ bɛ sara atagba yaanɩ fɔ bɔɔ gɛnya.<verse eid="1CH 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 27:30" />Obili gɛtɛ e ye Isimayeli wodu waanɩ fɔ na mɛ ɛndɩrɛ ɛ tɛ akpɔŋɔ yɩɩ gɛnya.</para>
  <para style="p" vid="1CH 27:30">Yehideya gɛtɛ e ye Meronoti fɔ na mɛ ɛndɩrɛ tɛ akpɔŋɔ-tɩtɩɩ yɩɩ gɛnya.<verse eid="1CH 27:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 27:31" />Yasisi gɛtɛ e ye Hagri wodu waanɩ fɔ na mɛ ɛndɩrɛ ɛ tɛ bɛyɛran ma begbebi bɔɔ gɛnya.</para>
  <para style="p" vid="1CH 27:31">Bɛnɩ nyabɛ powu bè di gɛ egyu-dɩrɛ Dafidi gbagba wanyan yɩɩ bɛnyalɛ bɔɔ bɛndɩrɛ.<verse eid="1CH 27:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32" />Fɔ Dafidi woteti Yonatan è di amɩnlɛ yɩɩtɛlɛ, ma ɛsɛyɩlɛ, ma gɩkpa gɩɩnyɩnlalɛ. Yehiyeli na wùlà egyu-dɩrɛ bebi ade.<verse eid="1CH 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 27:33" />Ahitofeli è di egyu-dɩrɛ wamɩnlɛ yɩɩtɛlɛ.</para>
  <para style="p" vid="1CH 27:33">Husayi gɛtɛ e ye Ariki wodu waanɩ fɔ na mɛ egyu-dɩrɛ wɔwɔlɔn-kanlɛ.<verse eid="1CH 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 27:34" />Ahitofeli diku dɩɩ gama fɔ, Benaya wobi Yehoyada, ma Abiyata na bɛ mɛ egyu-dɩrɛ wamɩnlɛ yɩɩ bɛtɛlɛ.</para>
  <para style="p" vid="1CH 27:34">Gɛ Yowabi ɛ mɛ egyu bɩtà bʋʋ bɛtàlɛ bɔɔndɩrɛ.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s1">Dafidi e wùlà anlɛ gɛtɛ baà ka be sere Dikwo-dɩrɛ fɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />Egyu Dafidi e kpèlè Isareli bɛndɩrɛ powu e tuma Yerusalem ditele daanɩ. E kpèlè ifoli-ifoli fɔ yɩɩ bɛndɩrɛ, ma bɩtà bʋʋ bɛtàlɛ akpi-akpi gɛtɛ bɛɛ mɛ gʋtʋn bɛ tɛ egyu-dɩrɛ fɔ bɔɔ bɛndɩrɛ, ma bɩtà bʋʋ bɛndɩrɛ gɛtɛ bɛɛ nya bɩtà bʋʋ bɛtàlɛ nkpɩn ton-ton boo koro, ma ɛbɛ gɛtɛ bɛɛ nya bɩtà bʋʋ bɛtàlɛ akpilin ton-ton boo koro fɔ, ma bɛndɩrɛ gɛtɛ bɛɛ nya egyu-dɩrɛ ma wo bebi-teni boo koro gaanyan ma bɔɔ bɛnan boo koro fɔ, fɩya ma bɛnɩ gɛtɛ bɛɛ mɛ gʋtʋn digyu-kpaara daanɩ fɔ, ma ɔkɛma wʋʋ bɛnɩ, ma bɩtà bʋʋ bɛtàlɛ gbaa-gbaa e tuma.<verse eid="1CH 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2" />Ɛwʋ gɛ egyu Dafidi ɛ tɔ e yela, gɛ ɛ dɔ̀ alan, &lt;&lt;Mɩɩndɩrɛ ɛbɛ ma mɩɩn bɛnɩ, ɩ nʋn maakʋn. Na len nan sere dɩkpaara gɛtɛ dàà mɛ Yahwe Dikola dɩɩ dɩdaka fɔ dɩɩ gɛdʋrɔkʋn ma Wurubwarɛ bɩsɩrɩ buu gekyikyakʋn. Gɛ na wɛrɛ tɩyɛ dii gesere gaade na sɩ̀. <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />Mɔ Wurubwarɛ ɛ dɔ̀ mɩ alan, &lt;Nka awɔ nan sere Dikwo a tɛ mɩ bɛnɩ bàà sʋma mɩ daanɩ, yema à di gɛ bɩtà bʋʋtàlɛ, gɛ a wolo bɛnɩ kpekpesi.&gt; <verse eid="1CH 28:3" /><verse number="4" style="v" sid="1CH 28:4" />Mɔ fɔ, nmɩ gɛ Yahwe, Isareli wo Wurubwarɛ fɔ e tiri e ye mɩɩn dɩkpaara powu daanɩ gɛtɛ nan mɛ egyu-dɩrɛ gakpaakpa. E tiri Yuda wofoli gɛtɛ wàà mɛ ofoli-gyegeyelɛ, gɛ ye Yuda wofoli waanɩ fɔ, e tiri miinte dɩkpaara, gɛ ye miinte bebi-teni baanɩ fɔ, maade na di wɔ gʋnʋn gɛtɛ nan di bugyu n tɛ Isareli powu. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />Yahwe ɛ tɛ mɩ bebi-teni kpekpesi, gɛ e tiri Solomon gɛtɛ ɛ̀ɛ̀ sara Wurubwarɛ bugyu bʋʋ gɛbɩya fɔ gii koro. <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />Ɛ dɔ̀ mɩ alan, &lt;Aabi Solomon nan sere miin Dikwo-dɩrɛ fɔ ma daakpaara, yema na tiri wɔ gɛtɛ ɛ̀ɛ̀ mɛ miinbi, gɛ nmɩ mɔ nan mɛ wote. <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />Gengyi è ton maade-tɩyɛlɛ-sɩ̀lɛ fɔ, ma mii-ise fɔ yaanɩ anlɛ gɛtɛ è de yɩ nkenkele lɛ fɔ, nan yɛ wo bugyu buu gedi bàà sere ɩkpaa gakpaakpa.<verse eid="1CH 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8" />&lt;&lt;Okoro, ntɛ tabʋrʋ n tɛ ɛyɩ Isareli bɛndɩrɛbi, Isareli bete powu gɛtɛ ɛbɛ n di Yahwe bɛnɩ fɔ bɔɔ bʋnʋn, gɛ Wurubwarɛ mɔ ɛɛ nʋn fɔ alɛ ɩ nya gepepe gɛtɛ yàà tɛrɛma Yahwe, tii Wurubwarɛ fɔ wo-ise, fɔ gɛtʋnkwaa-kpara nyagɩ gàà bɔ gɩ mɛ yiiyo, fɔ ɛyɩ mɔ yàà kere gɩ ɩ ya tɛ yiidu wʋʋ bɛnɩ gɛtɛ bàà ba fɔ wàà bɛ mɛ boo gedikʋn gakpaakpa.<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />Gɛ awɔ miinbi Solomon, nyɩnla aatu ɛbɛ boo Wurubwarɛ fɔ, fɔ àà ka aaturu powu, ma dɩmɩnlɛ-kɩlɩn sʋma wɔ. Yema Yahwe ee we oturu-kamasɛ waanɩ, gɛ ɛ̀ nyɩ̀ ɛnɩ-kamasɛ wamɩnlɛ. Gengyi à bugiti wɔ fɔ, aà we wɔ, gɛ gengyi à fi gama a ten wɔ fɔ, eè kere wɔ ɛ ya gakpaakpa. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />Nkele nyɩnla alɛ Yahwe e tiri wɔ̀ gɛtɛ àà sere Dikwo-dɩrɛ gɛtɛ dì di wo dikwo fɩrɩnfɩrɩn fɔ. Okoro yela kin-kin, fɔ àà mɛ gʋtʋn fɔ.&gt;&gt;<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />Gɛ Dafidi ɛ ka Dikwo-dɩrɛ fɔ dɩɩ kpata, ma daakwo, ma daanyan yɩɩ gɛsɩ̀kʋn, ma dɩɩ gatala gaakwo, ma dɩɩ gamɩ gaakwo, ma Ɔkʋn-dɩrɛ wʋʋkʋn-dɩrɛkʋn fɔ yii geserebi gɛtɛ ɛ ta fɔ ɛ tɛ wobi Solomon. <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />Gɛlɛ ke gɛ ɛ ka Yahwe Dikwo-dɩrɛ fɔ dɩɩ dɩkpaara dɩɩ gɛmɛ daade gɛtɛ Yahwe gifiye gɩ ka gɩ sa wamɩnlɛ yaanɩ powu fɔ, ma akwo gɛtɛ i silin i tuma fɔ, ma Wurubwarɛ Dikwo-dɩrɛ daanyan-gbaa-gbaa yɩɩ gɛsɩ̀kʋn fɔ, ma anyan gɛtɛ be tiri bɛ sɩ̀ tɛ Yahwe yɩɩ gɛsɩ̀kʋn yii geserebi yɩɩ gɛta ɛ tɛ Solomon. <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />Gɛlɛ ke e wùlà wɔ anlɛ gɛtɛ ɛ tɩyɛ ade ɛ sɩ̀ kadama gedi gɩɩ bɛtɛlɛ baakpi fɔ, ma Lefi bete, ma dɩsʋma dɩɩ gʋtʋn-kamasɛ gɛtɛ baà mɛ Dikwo-dɩrɛ daanɩ fɔ, fɩya ma anyɩmɩnyan powu gɛtɛ baà ka bɛ mɛ gʋtʋn fɔ. <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />Dafidi e wùlà Solomon sɩka-sɩya gɛtɛ baà ka bɛ mɛ sɩka wanyan gɛtɛ baà ka bɛ mɛ bʋtʋn kperen-kperen fɔ wʋʋdʋrʋ, ma sɩka-fututu gɛtɛ baà ka bɛ mɛ sɩka-fututu wanyan gɛtɛ baà ka bɛ mɛ bʋtʋn kperen-kperen fɔ wʋʋdʋrʋ. <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />E wùlà wɔ sɩka-sɩya wʋʋdʋrʋ gɛtɛ baà ka bɛ mɛ bɛkandɩya bɔɔ gɛgyagakʋn, ma yɩɩ bɛkandɩya, ma sɩka-sɩya wʋʋdʋrʋ gɛtɛ baà ka bɛ mɛ bɛkandɩya bɔɔ gɛgyagakʋn-kɩlɩn ma gɩɩ bɛkandɩya. Gɛlɛ ke gɛ ɛ dɔ̀ wɔ sɩka-fututu wʋʋdʋrʋ gɛtɛ baà ka bɛ mɛ bɛkandɩya bɔɔ gɛgyagakʋn, ma yɩɩ bɛkandɩya, ma sɩka-fututu wʋʋdʋrʋ gɛtɛ baà ka bɛ mɛ bɛkandɩya bɔɔ gɛgyagakʋn-kɩlɩn ma gɩɩ bɛkandɩya, anlɛ gɛtɛ wàà sara ma anlɛ gɛtɛ baà ka kandɩya-kamasɛ bɛ mɛ gʋtʋn fɔ. <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />E wùlà wɔ sɩka-sɩya wʋʋdʋrʋ gɛtɛ baà ka bɛ mɛ sɩka-sɩya wɔkpʋlɔ-kamasɛ gɛtɛ bɛɛ ka Wurubwarɛ wo boroboro bɛ gyaga wuu koro, ma sɩka-fututu wʋʋdʋrʋ gɛtɛ baà ka bɛ mɛ sɩka-fututu wɔ-ɩkpʋlɔ fɔ. <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />E wùlà wɔ sɩka-sɩya-kpara wʋʋdʋrʋ gɛtɛ baà ka bɛ mɛ bɩnyanɩ maabo gɛtɛ bʋ̀ ba alobi, ma bɛtasa-ŋwanlɛ nkalan, ma isunbi. E ni wùlà wɔ sɩka-fututu wʋʋdʋrʋ gɛtɛ baà ka bɛ mɛ sɩka-fututu gikunbi-kamasɛ. <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />Gɛlɛ ke gɛ e ni wùlà wɔ sɩka-sɩya-kpara wʋʋdʋrʋ gɛtɛ baà ka be sere olifwi wuu gedi gɩɩ gɛtɛ̀kʋn. Gɛ ɛ nɩ ka tiiramisan fɔ, gɛtɛ wù di sɩka-sɩya wo tiiramisan ɛbɛ gɛtɛ bɛ yaraba baabanban be tin Yahwe Dikola dɩɩ dɩdaka fɔ, wʋʋ gɛtabi ɛ tɛ wɔ.<verse eid="1CH 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19" />Gɛ Dafidi alan, &lt;&lt;Yahwe na yɛ gɛ na talɩ na ŋwara ade nyayɩ, gɛ ɛ yɛ mɩ na nʋ̀n anlɛ gɛtɛ baà ka be sere dikwo fɔ powu waanɩ.&gt;&gt;<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />Gɛ Dafidi e biri ɛ dɔ̀ wobi Solomon alan, &lt;&lt;Yela kin-kin, fɔ àà wura oturu, fɔ àà mɛ gʋtʋn fɔ! Kara yɛ gɩsaa gàà ton wɔ̀ abɛɛ koro gàà yɔ wɔ̀, yema Yahwe Wurubwarɛ, miin Wurubwarɛ fɔ ɛ̀ fɩya ma awɔ. Ɛn nan yɛ wɔ̀ àà nʋ̀n, gɛ ɛn nan kere wɔ̀ ɛ ya, ka ma sere gɛtɛ Yahwe Dikwo-dɩrɛ fɔ dii gesere dɩɩ gʋtʋn powu gàà were. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />Gedi gɩɩ bɛtɛlɛ baakpi-akpi fɔ ma Lefi bete bɛ wɛrɛ tɔ bɛ̀ sa tɛ Wurubwarɛ Dikwo-dɩrɛ fɔ dɩɩ gʋtʋn-kamasɛ gɩɩ gɛmɛ. Gɛ ɛnɩ-kamasɛ gɛtɛ ɛ̀ nyɩ̀ adawʋ ɩkɩ yɩɩ gɛsa, gɛ ee len fɔ, ɛɛ̀ kpà wɔ̀ gʋtʋn fɔ powu gaanɩ. Gɛ ade-kamasɛ gɛtɛ aà dɔ̀ fɔ, gɩfɩɩ gɩɩ bɛndɩrɛ ma bɛnɩ fɔ powu baà nʋn aakʋn.<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s1">Anyan-tɛlɛ tɛ Wurubwarɛ Dikwo-dɩrɛ fɔ dɩɩ gɛmara</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />Ɛwʋ gɛ egyu-dɩrɛ Dafidi ɛ dɔ̀ dikpi fɔ powu alan, &lt;&lt;Miibi Solomon gɛtɛ Wurubwarɛ e tiri lɛ è di gɛ ebi, gɛ ɛn ta we ade-kpekpesi ɛ̀ɛ̀ nyɩnla anlɛ gɛtɛ bɛɛ sɩ̀ ade yaanɩ gepe. Gʋtʋn fɔ gì di gʋtʋn-dɩrɛ, yema nka bɛnɩ-nyalɛ boo digyu-kpaara dii gesere gaade gɛ wù di, mɔ Yahwe Wurubwarɛ gbagba Dikwo-dɩrɛ gɛ wù di. <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />Na sa aniya na len anyan na sɩ̀ tɛ Wurubwarɛ Dikwo-dɩrɛ fɔ dii gesere. Na len sɩka-sɩya, ma sɩka-fututu, ma gɩwɔrɔnyan-sɩya, ma gɩwɔrɔnyan, ma iyon, ma oniki, ma tukwasi, ma ataa butu-kperen-kperen, ma ataa-kpara-kpara-kamasɛ, ma ataa-ŋalagɩlɛ ma ɔyɛ-kɛma. Na len anyan nyayɩ powu kpekpesi na sɩ̀. <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />Nyayɩ powu yɩɩ gama fɔ, gɛtɛ na ka koro na tɛ miin Wurubwarɛ Dikwo-dɩrɛ dii gesere okoro, ǹ de sɩka-sɩya ma sɩka-fututu wanyan gɛtɛ ì di nmɩ gbagba maanyan-gbaa-gbaa fɔ n tɛ tɛ miin Wurubwarɛ Dikwo-dɩrɛ fɔ dii gesere. <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />Na tɛ sɩka-sɩya-kpara gɛtɛ e ye Ofiri fɔ bekilo asepekyi ton ma ɩgbaa ton (110,000), ma sɩka-fututu-kpara bekilo asepekyi fwo-asiyee (260,000) gɛtɛ bàà ka bɛ marama-marama Dikwo-dɩrɛ fɔ daakwo yɩɩ-ɩpɔrɩ, <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />gɛ sɩka-sɩya wanyan yɩɩ bɛmɛlɛ ma sɩka-fututu wanyan yɩɩ bɛmɛlɛ baà ka sɩka-sɩya ma sɩka-fututu wanyan bɛ mɛ gʋtʋn fɔ. Nkele, ɛnyan n te len ɛ̀ɛ̀ tɛ Yahwe anyan ye woturu waanɩ?<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />Ɛwʋ gɛ Akpaara-akpaara yɩɩ bɛndɩrɛ, ma Isareli wo-ifoli fɔ yɩɩ bɛndɩrɛ, ma bɩtà bʋʋ bɛdɩrɛ gɛtɛ bɛɛ nya bɩtà bʋʋ bɛtàlɛ nkpɩn ton-ton, ma akpilin ton-ton boo koro fɔ, ma bɛndɩrɛ gɛtɛ bɛɛ nya egyu-dɩrɛ gʋtʋn gii koro fɔ bɛ tɛ anyan be ye boo-ituru yaanɩ. <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />Bɛ tɛ anyan gɛtɛ bàà ka bɛ mɛ Wurubwarɛ Dikwo-dɩrɛ fɔ dɩɩ gʋtʋn. Bɛ tɛ sɩka-sɩya bekilo bemiliyon ton (5,000,000), ma sɩka gɛtɛ bee kpèlè dariki fɔ bekilo akpilin anaa ma bɛnaa (84), ma sɩka-fututu asepekyi fwo-nɩyɛ ma nkpɩn kwarankɩ ma akpilin ton (375,000), ma gɩwɔrɔnyan-sɩya asepekyi dikpilin ma fwo-asiyee ma ɩgbaa kwarankɩ ma nkpɩn ton (675,000), ma gɩwɔrɔnyan bemiliyon besiyee ma asepekyi dikpilin ma fwo-kwarankɩ ma ɩgbaa ton (3,750,000). <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />Gɛ ɛnɩ-kamasɛ gɛtɛ ɛ̀ ba ataa ma ɔyɛ-kɛma fɔ, ɛ tɛ gɛtɛ yàà mɛ Yahwe Dikwo-dɩrɛ fɔ daanyan. Bɛ ka yɩ bɛ sa Gerison-te Yahiyeli gʋlɔ gaanɩ. <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />Wʋ mɛ bɛnɩ fɔ ɔsɛ gɛtɛ bɔɔ bɛndɩrɛ bɛ ka oturu-kpara bɛ tɛ anyan, yema bɛ ka gelen ma booturu powu bɛ tɛ Yahwe anyan. Wʋ mɛ egyu-dɩrɛ Dafidi mɔ ɔsɛ gepepe.<verse eid="1CH 29:9" /></para>
  <para style="s1">Dafidi wonyun-tiri</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />Wʋʋ gama fɔ, Dafidi e tiri onyun ɛ tɛ Yahwe, bɛnɩ dɩtɩnpan fɔ powu bɔɔ bʋnʋn alan,</para>
  <para style="q1" vid="1CH 29:10">Oo Yahweh, gesila gì di gɛ aayo,</para>
  <para style="q2" vid="1CH 29:10">Tiitu Isareli wo Wurubwarɛ,</para>
  <para style="q2" vid="1CH 29:10">Gesila gì di gɛ aayo gakpaakpa.<verse eid="1CH 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11" />Oo, Yahwe, à sɔ, gɛ à ba ɔkɛma.</para>
  <para style="q2" vid="1CH 29:11">À ba gingyebi, ma gebù-dɩrɛ, ma gingyebi-dɩrɛ,</para>
  <para style="q2" vid="1CH 29:11">yema gɩnyan-kamasɛ gɛtɛ gɩ̀ sa gatala ma gɛtʋnkwaa fɔ, gì di gɛ aayo.</para>
  <para style="q1" vid="1CH 29:11">Oo, Yahwe awɔ n di Egyu-dɩrɛ.</para>
  <para style="q2" vid="1CH 29:11">Tɩɩ tɔ̀là aa diyere, yema awɔ n di duyu tɛ gɩnyan-kamasɛ.<verse eid="1CH 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12" />Gɩkyɩnyɩn ma gingyebi i ye gɛ aakʋn,</para>
  <para style="q2" vid="1CH 29:12">À ba ɔkɛma gɩnyan-kamasɛ gii koro.</para>
  <para style="q1" vid="1CH 29:12">À ba giteni ma ɔkɛma</para>
  <para style="q2" vid="1CH 29:12">gɛtɛ aa yɛ ɛnɩ ɛɛ bʋn e ye, fɔ e sere ɩkpaa.<verse eid="1CH 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13" />Oo, tii Wurubwarɛ, gɛlɛ wuu koro gɛ tɩɩ tɛ wɔ̀ karan,</para>
  <para style="q2" vid="1CH 29:13">gɛ tii sila aa diyere ma gingyebi fɔ.<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />Gɛ ɛnyan gɛ ǹ di, gɛ ɛnyan ɛbɛ gɛ mɩɩn bɛnɩ bè di, gɛtɛ tɩ talɩ tɩ ka tii-ituru tɩ tɛ anyan anlɛ? Gɩnyan-kamasɛ gi ye gɛ aakʋn, gɛ ti birima gɛ anyan gɛtɛ a tɛ tɩ fɔ tɩ tɛ wɔ̀. <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />Aa bʋnʋn baanɩ fɔ, tì di gɛ bɛnɩ-dalɛ ma besela anlɛ tiitu ɛbɛ. Tɩɩ nkpa wawi ì we gɛ anlɛ bilibili, gɛ tɩn nan talɩ ti ye diku daanɩ. <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />Oo Yahwe, tii Wurubwarɛ, anyan pirim gɛtɛ a tɛ-tɛ aa Dikwo-dɩrɛ fɔ dii gesere gɛtɛ bɛnɩ bàà tɩ̀ sʋma wɔ̀ daanɩ fɔ, i ye gɛ aalɔ yaanɩ, gɛ ɛyɩ powu ì di gɛ aayo. <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />Miin Wurubwarɛ, ǹ nyɩ̀ gɛtɛ aa kɛrɛ bɛnɩ boo-ituru a nya, gɛ ɛbɛ gɛtɛ bɛ̀ ba dɩmɩnlɛ-kpara fɔ baade ii di wɔ̀ gʋnʋn. Gɛ dɩmɩnlɛ-kpara gɛ na ka na tɛ wɔ̀ gɛlɛ gaanyan nyayɩ. Gɛ nkele na we anlɛ gɛtɛ aa bɛnɩ gɛtɛ bɛ̀ sa nfan lɛ bɛ ka gelen bɛ tɛ wɔ̀ anyan ye booturu yaanɩ. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />Oo Yahwe, tiitu ɛbɛ Abraham, ma Isaki, ma Isareli boo Wurubwarɛ, yɛ gɛlɛ wʋʋ dɩmɩnlɛ-kpara nyadɩ dàà sara aa bɛnɩ boo-ituru yaanɩ gakpaakpa, fɔ àà yɛ bɛ bàà di nʋnkwarɩ tɛ wɔ̀. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />Yɛ gɛtɛ miinbi Solomon ɛ̀ɛ̀ ka woturu powu ton aa-ise fɔ, ma aade-wùlàlɛ fɔ, ma aade-tɩyɛlɛ-sɩ̀lɛ fɔ yaanɩ, fɔ ɛ̀ɛ̀ talɩ yela kin-kin tɛ Dikwo-dɩrɛ gɛtɛ na pɩna anyan na sɩ̀ na tɛ dii gesere lɛ.<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />Ɛwʋ gɛ Dafidi ɛ dɔ̀ bɛnɩ dikpi fɔ powu alan, &lt;&lt;I sila Yahwe, yii Wurubwarɛ fɔ!&gt;&gt; Ɛwʋ gɛ ɛbɛ powu be sila Yahwe, bootu ɛbɛ boo Wurubwarɛ fɔ. Bɛ waran be kura bɛ ka bʋnʋn be tin gɛtʋnkwaa, Yahwe ma egyu-dɩrɛ bɔɔ bʋnʋn baanɩ.<verse eid="1CH 29:20" /></para>
  <para style="s1">Be to Solomon bugyu bɛ sa</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />Wuu duwi-nyɔɔfɛ fɔ, bɛ tɛ Yahwe gedi, gɛ bɛ tɛ wɔ gekuma gii gedi. Bɛ ka bɛkwɔ-teni nkpɩn ton (1,000), ma ayaran-gbʋgbʋ nkpɩn ton (1,000), ma bɛyɛran-teni atan, fɩya ma bɔɔ bʋkan ma gedi gɩɩ gɛtɛ̀ gaanyan-kpekpesi bɛ tɛ gedi Isareli powu diyere daanɩ. <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />Be di gɛ bɛ nyʋn ɔsɛ waanɩ Yahwe bʋnʋn duwi dɩtɔkɔ.</para>
  <para style="p" vid="1CH 29:22">Ɛwʋ gɛ be to Dafidi wobi Solomon bɛ sa gɛtɛ ɛwɔ n di egyu-dɩrɛ. Bɛ lù wɔ bʋnɔ duyu Yahwe diyere daanɩ bɛ ka be tiri wɔ okòro gɛtɛ ɛ̀ɛ̀ mɛ boogyu-dɩrɛ, gɛ be lù Sadoki mɔ bʋnɔ duyu be wùlà gɛtɛ è di gedi gɩɩtɛlɛ. <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />Okoro Solomon ɛ sara Yahwe gigyu-bɩya fɔ gii koro e di bugyu e sere wote gɩsɩrɩ. Ade ɩ san gepe ɩ tɛ wɔ, gɛ Isareli bete powu be bù wɔ. <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />Gɩfɩɩ gɩɩ bɛndɩrɛ ma bɩtà bʋʋ bɛtàlɛ powu, ma Dafidi bebi-kurumakyɛɛ powu bɛ kan ntam gɛtɛ baà tɛrɛma egyu Solomon.<verse eid="1CH 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25" />Yahwe ɛ yɛ Solomon e wura gebù-dɩrɛ Isareli bete powu bɔɔ bʋnʋn. Ɛ yɛ wɔ e wura gingyebi-dɩrɛ gɛtɛ Isareli begyu-dɩrɛ gɛtɛ bɛ sara bɛ da fɔ, ben wura gaakɩ nya.<verse eid="1CH 29:25" /></para>
  <para style="s1">Dafidi diku</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />Anlɛ gɛ Yese wobi Dafidi e di bugyu Isareli powu wanɩ. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />E di bugyu Isareli bɩkyan akpilin anyɔɔ (40). E di bugyu ɛ sara Hebron bɩkyan kwarankɩ, gɛ ɛ sara Yerusalem bɩkyan dikpilin ma fwo bisiyee (33). <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />Dafidi ɛ dan gepepe pɛgɛ e ku. Ɛ sara nkpa bɩkyan kpekpesi, e wura koro gaanyan, gɛ e wura gebù. Gɛ wobi Solomon e di bugyu e sere wɔ gɩsɩrɩ. <verse eid="1CH 29:28" /><verse number="29" style="v" sid="1CH 29:29" />Bɛ ŋwara egyu-dɩrɛ Dafidi bugyu buu gedi baade, ye digyegeye ma sere ɔkʋna bɛ sa Wurubwarɛ wɔtabʋrʋlɛ Samuweli, ma Wurubwarɛ wɔtabʋrʋlɛ Natan, ma Wurubwarɛ wɔtabʋrʋlɛ Gadi boo koro gaade yaakpa yaanɩ. <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />Gɛlɛ ke gɛ bɛ ŋwara wo bugyu buu gedi baade, ma wɔkɛma waade, ma anlɛ gɛtɛ ade ɩ ba Isareli gɩfɩɩ gaanɩ ka dama wo koro fɔ, ma bugyu-bugyu buu gedikʋn gɛtɛ bu silin bɛ bu tuma fɔ baade bɛ sa akpa fɔ yaanɩ.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>