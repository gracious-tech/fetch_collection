  <para style="h">ਯੋਏਲ</para>
  <para style="toc1">ਯੋਏਲ</para>
  <para style="toc2">ਯੋਏਲ</para>
  <para style="toc3">ਯੋਏ</para>
  <para style="mt1">ਯੋਏਲ</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />ਯਾਹਵੇਹ ਦਾ ਬਚਨ ਜਿਹੜਾ ਪਥੂਏਲ ਦੇ ਪੁੱਤਰ ਯੋਏਲ ਨੂੰ ਆਇਆ।<verse eid="JOL 1:1" /></para>
  <para style="b" />
  <para style="s1">ਟਿੱਡੀਆਂ ਦਾ ਹਮਲਾ</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2" />ਹੇ ਆਗੂਓ, ਇਹ ਸੁਣੋ,</para>
  <para style="q2" vid="JOL 1:2">ਹੇ ਦੇਸ਼ ਦੇ ਸਾਰੇ ਲੋਕੋ, ਮੇਰੀ ਸੁਣੋ।</para>
  <para style="q1" vid="JOL 1:2">ਕੀ ਤੁਹਾਡੇ ਦਿਨਾਂ ਵਿੱਚ ਜਾਂ ਤੁਹਾਡੇ ਪੁਰਖਿਆਂ ਦੇ ਦਿਨਾਂ ਵਿੱਚ ਕਦੇ ਅਜਿਹਾ ਹੋਇਆ ਹੈ?<verse eid="JOL 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3" />ਇਸਨੂੰ ਆਪਣੇ ਬੱਚਿਆਂ ਨੂੰ ਦੱਸੋ,</para>
  <para style="q2" vid="JOL 1:3">ਅਤੇ ਆਪਣੇ ਬੱਚਿਆਂ ਨੂੰ ਆਪਣੇ ਬੱਚਿਆਂ ਨੂੰ,</para>
  <para style="q2" vid="JOL 1:3">ਅਤੇ ਉਨ੍ਹਾਂ ਦੇ ਬੱਚੇ ਅਗਲੀ ਪੀੜ੍ਹੀ ਨੂੰ ਦੱਸਣ ਦਿਓ।<verse eid="JOL 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4" />ਜੋ ਛੋਟੀ ਟਿੱਡੀ ਤੋਂ ਬਚਿਆ,</para>
  <para style="q2" vid="JOL 1:4">ਉਹ ਵੱਡੀ ਟਿੱਡੀ ਖਾ ਗਈ,</para>
  <para style="q1" vid="JOL 1:4">ਜੋ ਵੱਡੀ ਟਿੱਡੀ ਤੋਂ ਬਚਿਆ,</para>
  <para style="q2" vid="JOL 1:4">ਉਹ ਟਪੂਸੀ ਮਾਰ ਟਿੱਡੀ ਖਾ ਗਈ,</para>
  <para style="q1" vid="JOL 1:4">ਜੋ ਟਪੂਸੀ ਮਾਰ ਟਿੱਡੀ ਤੋਂ ਬਚਿਆ,</para>
  <para style="q2" vid="JOL 1:4">ਉਹ ਹੂੰਝਾ ਫੇਰ ਟਿੱਡੀ ਖਾ ਗਈ।<verse eid="JOL 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5" />ਹੇ ਸ਼ਰਾਬੀਓ, ਜਾਗੋ ਅਤੇ ਰੋਵੋ!</para>
  <para style="q2" vid="JOL 1:5">ਹੇ ਸਾਰੇ ਸ਼ਰਾਬ ਦੇ ਪਿਆਕੜ ਹੋ,</para>
  <para style="q1" vid="JOL 1:5">ਨਵੀਂ ਦਾਖਰਸ ਦੇ ਕਾਰਨ ਰੋਵੋ,</para>
  <para style="q2" vid="JOL 1:5">ਕਿਉਂ ਜੋ ਉਹ ਤੁਹਾਡੇ ਬੁੱਲ੍ਹਾਂ ਤੋਂ ਖੋਹ ਲਈ ਗਈ ਹੈ।<verse eid="JOL 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6" />ਇੱਕ ਕੌਮ ਨੇ ਮੇਰੀ ਧਰਤੀ ਉੱਤੇ ਹਮਲਾ ਕੀਤਾ ਹੈ,</para>
  <para style="q2" vid="JOL 1:6">ਇੱਕ ਸ਼ਕਤੀਸ਼ਾਲੀ ਅਤੇ ਅਣਗਿਣਤ ਹੈ;</para>
  <para style="q1" vid="JOL 1:6">ਉਸ ਦੇ ਦੰਦ ਸ਼ੇਰ ਦੇ ਦੰਦ ਹਨ,</para>
  <para style="q2" vid="JOL 1:6">ਉਸ ਦੀਆਂ ਦਾੜ੍ਹਾਂ ਸ਼ੇਰਨੀ ਦੀਆਂ ਹਨ।<verse eid="JOL 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7" />ਉਸ ਨੇ ਮੇਰੀਆਂ ਅੰਗੂਰਾਂ ਦੀਆਂ ਵੇਲਾਂ ਨੂੰ ਉਜਾੜ ਦਿੱਤਾ</para>
  <para style="q2" vid="JOL 1:7">ਅਤੇ ਮੇਰੇ ਹੰਜੀਰ ਦੇ ਰੁੱਖਾਂ ਨੂੰ ਤੋੜ ਕੇ ਸੁੱਟ ਦਿੱਤਾ।</para>
  <para style="q1" vid="JOL 1:7">ਉਸ ਨੇ ਉਨ੍ਹਾਂ ਦੀ ਸੱਕ ਲਾਹ ਕੇ ਸੁੱਟ ਦਿੱਤੀ ਹੈ,</para>
  <para style="q2" vid="JOL 1:7">ਉਨ੍ਹਾਂ ਦੀਆਂ ਟਹਿਣੀਆਂ ਨੂੰ ਚਿੱਟਾ ਛੱਡ ਦਿੱਤਾ ਹੈ।<verse eid="JOL 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8" />ਉਸ ਕੁਆਰੀ ਵਾਂਗੂੰ ਜੋ ਲੱਕ ਉੱਤੇ ਟਾਟ ਬੰਨ੍ਹ ਕੇ</para>
  <para style="q2" vid="JOL 1:8">ਆਪਣੀ ਜੁਆਨੀ ਦੇ ਪਤੀ ਲਈ ਰੋਂਦੀ ਹੈ, ਤੂੰ ਵੀ ਉਸੇ ਤਰ੍ਹਾਂ ਰੋ।<verse eid="JOL 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9" />ਅਨਾਜ ਦੀਆਂ ਭੇਟਾਂ ਅਤੇ ਪੀਣ ਦੀਆਂ ਭੇਟਾਂ</para>
  <para style="q2" vid="JOL 1:9">ਯਾਹਵੇਹ ਦੇ ਘਰ ਵਿੱਚ ਆਉਣੀਆਂ ਬੰਦ ਹੋ ਗਈਆਂ ਹਨ।</para>
  <para style="q1" vid="JOL 1:9">ਜਾਜਕ ਸੋਗ ਵਿੱਚ ਹਨ,</para>
  <para style="q2" vid="JOL 1:9">ਉਹ ਜਿਹੜੇ ਯਾਹਵੇਹ ਦੇ ਅੱਗੇ ਸੇਵਾ ਕਰਦੇ ਹਨ।<verse eid="JOL 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10" />ਖੇਤ ਬਰਬਾਦ ਹੋ ਗਏ ਹਨ,</para>
  <para style="q2" vid="JOL 1:10">ਜ਼ਮੀਨ ਸੁੱਕ ਗਈ ਹੈ;</para>
  <para style="q1" vid="JOL 1:10">ਅਨਾਜ ਨਸ਼ਟ ਹੋ ਗਿਆ,</para>
  <para style="q2" vid="JOL 1:10">ਨਵੀਂ ਮੈ ਸੁੱਕ ਗਈ,</para>
  <para style="q2" vid="JOL 1:10">ਜ਼ੈਤੂਨ ਦਾ ਤੇਲ ਨਾਸ ਹੋ ਗਿਆ।<verse eid="JOL 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11" />ਹੇ ਕਿਸਾਨੋ, ਨਿਰਾਸ਼ ਹੋਵੋ,</para>
  <para style="q2" vid="JOL 1:11">ਹੇ ਵੇਲਾਂ ਦੇ ਪੈਦਾ ਕਰਨ ਵਾਲਿਓ, ਰੋਵੋ;</para>
  <para style="q1" vid="JOL 1:11">ਕਣਕ ਅਤੇ ਜੌਂ ਲਈ ਸੋਗ ਕਰੋ,</para>
  <para style="q2" vid="JOL 1:11">ਕਿਉਂਕਿ ਖੇਤ ਦੀ ਫ਼ਸਲ ਤਬਾਹ ਹੋ ਗਈ ਹੈ।<verse eid="JOL 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12" />ਅੰਗੂਰੀ ਵੇਲ ਸੁੱਕ ਗਈ ਹੈ,</para>
  <para style="q2" vid="JOL 1:12">ਅਤੇ ਹੰਜੀਰ ਦਾ ਰੁੱਖ ਸੁੱਕ ਗਿਆ ਹੈ।</para>
  <para style="q1" vid="JOL 1:12">ਅਨਾਰ, ਖਜ਼ੂਰ ਅਤੇ ਸੇਬ ਦੇ ਰੁੱਖ,</para>
  <para style="q2" vid="JOL 1:12">ਖੇਤ ਦੇ ਸਾਰੇ ਰੁੱਖ ਸੁੱਕ ਗਏ ਹਨ।</para>
  <para style="q1" vid="JOL 1:12">ਨਿਸ਼ਚੇ ਹੀ ਲੋਕਾਂ ਦਾ ਅਨੰਦ ਮੁਰਝਾ ਗਿਆ ਹੈ।<verse eid="JOL 1:12" /></para>
  <para style="s1">ਵਿਰਲਾਪ ਦਾ ਸੱਦਾ</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13" />ਹੇ ਜਾਜਕੋ, ਤੱਪੜ ਪਾਓ ਅਤੇ ਸੋਗ ਕਰੋ।</para>
  <para style="q2" vid="JOL 1:13">ਹੇ ਜਗਵੇਦੀ ਦੇ ਅੱਗੇ ਸੇਵਾ ਕਰਨ ਵਾਲੇ, ਰੋਵੋ।</para>
  <para style="q1" vid="JOL 1:13">ਆ ਤੱਪੜ ਪਾ ਕੇ ਰਾਤ ਕੱਟੋ,</para>
  <para style="q2" vid="JOL 1:13">ਹੇ ਮੇਰੇ ਪਰਮੇਸ਼ਵਰ ਦੀ ਸੇਵਾ ਕਰਨ ਵਾਲਿਓ।</para>
  <para style="q1" vid="JOL 1:13">ਅਨਾਜ਼ ਦੀਆਂ ਭੇਟਾਂ ਅਤੇ ਪੀਣ ਦੀਆਂ ਭੇਟਾਂ</para>
  <para style="q2" vid="JOL 1:13">ਤੁਹਾਡੇ ਪਰਮੇਸ਼ਵਰ ਦੇ ਘਰ ਤੋਂ ਰੋਕੀਆਂ ਗਈਆਂ ਹਨ।<verse eid="JOL 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14" />ਇੱਕ ਪਵਿੱਤਰ ਵਰਤ ਰੱਖੋ;</para>
  <para style="q2" vid="JOL 1:14">ਇੱਕ ਪਵਿੱਤਰ ਸਭਾ ਬੁਲਾਓ।</para>
  <para style="q1" vid="JOL 1:14">ਬਜ਼ੁਰਗਾਂ ਨੂੰ</para>
  <para style="q2" vid="JOL 1:14">ਅਤੇ ਧਰਤੀ ਵਿੱਚ ਰਹਿਣ ਵਾਲੇ ਸਾਰੇ ਲੋਕਾਂ ਨੂੰ</para>
  <para style="q1" vid="JOL 1:14">ਆਪਣੇ ਪਰਮੇਸ਼ਵਰ ਦੇ ਘਰ ਵਿੱਚ ਬੁਲਾਓ,</para>
  <para style="q2" vid="JOL 1:14">ਅਤੇ ਯਾਹਵੇਹ ਅੱਗੇ ਦੁਹਾਈ ਦਿਓ।<verse eid="JOL 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15" />ਹਾਏ, ਉਸ ਦਿਨ ਲਈ!</para>
  <para style="q2" vid="JOL 1:15">ਕਿਉਂਕਿ ਯਾਹਵੇਹ ਦਾ ਦਿਨ ਨੇੜੇ ਹੈ;</para>
  <para style="q2" vid="JOL 1:15">ਇਹ ਸਰਵਸ਼ਕਤੀਮਾਨ ਵੱਲੋਂ ਤਬਾਹੀ ਵਾਂਗ ਆਵੇਗਾ।<verse eid="JOL 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16" />ਕੀ ਸਾਡੀਆਂ ਅੱਖਾਂ ਦੇ ਸਾਮ੍ਹਣੇ</para>
  <para style="q1" vid="JOL 1:16">ਅਨੰਦ ਅਤੇ ਖੁਸ਼ੀ</para>
  <para style="q2" vid="JOL 1:16">ਸਾਡੇ ਪਰਮੇਸ਼ਵਰ ਦੇ ਘਰ ਵਿੱਚੋਂ ਭੋਜਨ ਮੁੱਕ ਨਹੀਂ ਗਿਆ?<verse eid="JOL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17" />ਬੀਜ ਮਿੱਟੀ ਦੇ ਢੇਲਿਆਂ ਦੇ ਹੇਠ ਸੜਦੇ ਜਾਂਦੇ ਹਨ,</para>
  <para style="q2" vid="JOL 1:17">ਖੱਤੇ ਵਿਰਾਨ ਪਏ ਹਨ,</para>
  <para style="q1" vid="JOL 1:17">ਭੰਡਾਰ ਘਰ ਟੁੱਟੇ ਪਏ ਹਨ,</para>
  <para style="q2" vid="JOL 1:17">ਕਿਉਂ ਜੋ ਫ਼ਸਲ ਸੁੱਕ ਗਈ ਹੈ।<verse eid="JOL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18" />ਡੰਗਰ ਕਿਵੇਂ ਅੜਿੰਗਦੇ ਹਨ!</para>
  <para style="q2" vid="JOL 1:18">ਪਸ਼ੂਆਂ ਦੇ ਝੁੰਡ ਭਟਕਦੇ ਫਿਰਦੇ ਹਨ</para>
  <para style="q1" vid="JOL 1:18">ਕਿਉਂਕਿ ਉਨ੍ਹਾਂ ਕੋਲ ਕੋਈ ਚਾਰਾ ਨਹੀਂ ਹੈ;</para>
  <para style="q2" vid="JOL 1:18">ਭੇਡਾਂ ਦੇ ਇੱਜੜ ਵੀ ਦੁਖੀ ਹਨ।<verse eid="JOL 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19" />ਹੇ ਯਾਹਵੇਹ, ਮੈਂ ਤੁਹਾਨੂੰ ਪੁਕਾਰਦਾ ਹਾਂ,</para>
  <para style="q2" vid="JOL 1:19">ਕਿਉਂਕਿ ਅੱਗ ਨੇ ਉਜਾੜ ਵਿੱਚ ਚਰਾਗਾਹਾਂ ਨੂੰ ਖਾ ਲਿਆ ਹੈ</para>
  <para style="q2" vid="JOL 1:19">ਅਤੇ ਅੱਗ ਨੇ ਖੇਤ ਦੇ ਸਾਰੇ ਰੁੱਖਾਂ ਨੂੰ ਸਾੜ ਦਿੱਤਾ ਹੈ।<verse eid="JOL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20" />ਖੇਤ ਦੇ ਪਸ਼ੂ ਤੇਰੇ ਵੱਲ ਹੌਂਕਦੇ ਹਨ।</para>
  <para style="q2" vid="JOL 1:20">ਪਾਣੀ ਦੀਆਂ ਨਦੀਆਂ ਸੁੱਕ ਗਈਆਂ ਹਨ</para>
  <para style="q2" vid="JOL 1:20">ਅਤੇ ਅੱਗ ਨੇ ਉਜਾੜ ਦੀਆਂ ਚਰਾਂਦਾਂ ਨੂੰ ਭਸਮ ਕਰ ਦਿੱਤਾ ਹੈ।<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s1">ਟਿੱਡੀਆਂ ਦੀ ਇੱਕ ਫੌਜ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1" />ਸੀਯੋਨ ਵਿੱਚ ਤੁਰ੍ਹੀ ਵਜਾਓ;</para>
  <para style="q2" vid="JOL 2:1">ਮੇਰੀ ਪਵਿੱਤਰ ਪਹਾੜੀ ਉੱਤੇ ਸਾਹ ਖਿੱਚ ਕੇ ਫੂਕੋ!</para>
  <para style="b" vid="JOL 2:1" />
  <para style="q1" vid="JOL 2:1">ਧਰਤੀ ਵਿੱਚ ਰਹਿਣ ਵਾਲੇ ਸਾਰੇ ਲੋਕ ਕੰਬਣ,</para>
  <para style="q2" vid="JOL 2:1">ਕਿਉਂਕਿ ਯਾਹਵੇਹ ਦੇ ਦਿਨ ਆ ਰਿਹਾ ਹੈ।</para>
  <para style="q1" vid="JOL 2:1">ਇਹ ਦਿਨ ਨੇੜੇ ਹੀ ਹੈ,<verse eid="JOL 2:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 2:2" />ਹਨੇਰੇ ਅਤੇ ਦੁੱਖ ਦਾ ਦਿਨ,</para>
  <para style="q2" vid="JOL 2:2">ਬੱਦਲਾਂ ਅਤੇ ਅੰਧਕਾਰ ਦਾ ਦਿਨ।</para>
  <para style="q1" vid="JOL 2:2">ਜਿਵੇਂ ਪਹਾੜਾਂ ਵਿੱਚ ਸਵੇਰਾ ਫੈਲਦਾ ਹੈ</para>
  <para style="q2" vid="JOL 2:2">ਇੱਕ ਵੱਡੀ ਅਤੇ ਸ਼ਕਤੀਸ਼ਾਲੀ ਸੈਨਾ ਆਉਂਦੀ ਹੈ,</para>
  <para style="q1" vid="JOL 2:2">ਜਿਵੇਂ ਕਿ ਪੁਰਾਣੇ ਸਮਿਆਂ ਵਿੱਚ ਕਦੇ ਨਹੀਂ ਸੀ</para>
  <para style="q2" vid="JOL 2:2">ਅਤੇ ਨਾ ਹੀ ਆਉਣ ਵਾਲੇ ਯੁੱਗਾਂ ਵਿੱਚ ਕਦੇ ਹੋਵੇਗਾ।<verse eid="JOL 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3" />ਉਹਨਾਂ ਦੇ ਅੱਗੇ ਅੱਗ ਭਸਮ ਕਰਦੀ ਹੈ,</para>
  <para style="q2" vid="JOL 2:3">ਉਹਨਾਂ ਦੇ ਪਿੱਛੇ ਇੱਕ ਲਾਟ ਬਲਦੀ ਹੈ।</para>
  <para style="q1" vid="JOL 2:3">ਉਨ੍ਹਾਂ ਦੇ ਅੱਗੇ ਧਰਤੀ ਅਦਨ ਦੇ ਬਾਗ਼ ਵਰਗੀ ਹੈ,</para>
  <para style="q2" vid="JOL 2:3">ਉਨ੍ਹਾਂ ਦੇ ਪਿੱਛੇ ਮਾਰੂਥਲ ਹੈ।</para>
  <para style="q2" vid="JOL 2:3">ਉਹਨਾਂ ਤੋਂ ਕੁਝ ਵੀ ਨਹੀਂ ਬਚਿਆ।<verse eid="JOL 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4" />ਉਹਨਾਂ ਦਾ ਰੂਪ ਘੋੜਿਆਂ ਵਰਗਾ ਹੈ;</para>
  <para style="q2" vid="JOL 2:4">ਉਹ ਘੋੜਸਵਾਰਾਂ ਵਾਂਗ ਦੌੜਦੇ ਹਨ।<verse eid="JOL 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5" />ਰਥਾਂ ਦੀ ਆਵਾਜ਼ ਨਾਲ</para>
  <para style="q2" vid="JOL 2:5">ਉਹ ਪਹਾੜਾਂ ਦੀਆਂ ਚੋਟੀਆਂ ਉੱਤੇ ਛਾਲ ਮਾਰਦੇ ਹਨ,</para>
  <para style="q1" vid="JOL 2:5">ਤੂੜੀ ਨੂੰ ਭਸਮ ਕਰਨ ਵਾਲੀ ਅੱਗ ਵਾਂਗ,</para>
  <para style="q2" vid="JOL 2:5">ਯੁੱਧ ਲਈ ਤਿਆਰ ਕੀਤੀ ਬਲਵੰਤ ਫ਼ੌਜ ਵਾਂਗ।<verse eid="JOL 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6" />ਉਨ੍ਹਾਂ ਨੂੰ ਵੇਖ ਕੇ ਕੌਮਾਂ ਦੁਖੀ ਹਨ;</para>
  <para style="q2" vid="JOL 2:6">ਸਾਰੇ ਚਿਹਰੇ ਫਿੱਕੇ ਪੈ ਜਾਂਦੇ ਹਨ।<verse eid="JOL 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7" />ਸੂਰਮਿਆਂ ਵਾਂਗੂੰ ਦੌੜਦੇ ਹਨ,</para>
  <para style="q2" vid="JOL 2:7">ਉਹ ਯੋਧਿਆਂ ਵਾਂਗੂੰ ਸ਼ਹਿਰਪਨਾਹ ਉੱਤੇ ਚੜ੍ਹਦੇ ਹਨ।</para>
  <para style="q1" vid="JOL 2:7">ਉਹ ਆਪੋ-ਆਪਣੇ ਰਾਹ ਉੱਤੇ ਤੁਰਦੇ ਹਨ,</para>
  <para style="q2" vid="JOL 2:7">ਉਹਨਾਂ ਵਿੱਚੋਂ ਕੋਈ ਆਪਣੀ ਕਤਾਰ ਤੋਂ ਬਾਹਰ ਨਹੀਂ ਤੁਰਦਾ।<verse eid="JOL 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8" />ਉਹ ਇੱਕ-ਦੂਜੇ ਨੂੰ ਧੱਕਾ ਨਹੀਂ ਮਾਰਦੇ;</para>
  <para style="q2" vid="JOL 2:8">ਹਰ ਇੱਕ ਸਿੱਧੇ ਰਾਹ ਉੱਤੇ ਤੁਰਦਾ ਹੈ।</para>
  <para style="q1" vid="JOL 2:8">ਉਹ ਸ਼ਸਤਰਾਂ ਨੂੰ ਚੀਰ ਕੇ ਲੰਘ ਜਾਂਦੇ ਹਨ,</para>
  <para style="q2" vid="JOL 2:8">ਅਤੇ ਉਹਨਾਂ ਦੀ ਕਤਾਰ ਨਹੀਂ ਟੁੱਟਦੀ।<verse eid="JOL 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9" />ਉਹ ਸ਼ਹਿਰ ਉੱਤੇ ਦੌੜਦੇ ਹਨ।</para>
  <para style="q2" vid="JOL 2:9">ਉਹ ਕੰਧ ਦੇ ਨਾਲ-ਨਾਲ ਦੌੜਦੇ ਹਨ।</para>
  <para style="q1" vid="JOL 2:9">ਉਹ ਘਰਾਂ ਵਿੱਚ ਚੜ੍ਹਦੇ ਹਨ;</para>
  <para style="q2" vid="JOL 2:9">ਚੋਰਾਂ ਵਾਂਗ ਉਹ ਖਿੜਕੀਆਂ ਰਾਹੀਂ ਅੰਦਰ ਵੜਦੇ ਹਨ।<verse eid="JOL 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10" />ਉਨ੍ਹਾਂ ਦੇ ਅੱਗੇ ਧਰਤੀ ਹੱਲਦੀ ਹੈ,</para>
  <para style="q2" vid="JOL 2:10">ਅਕਾਸ਼ ਕੰਬਦੇ ਹਨ,</para>
  <para style="q1" vid="JOL 2:10">ਸੂਰਜ ਤੇ ਚੰਦ ਕਾਲੇ ਹੋ ਜਾਂਦੇ ਹਨ</para>
  <para style="q2" vid="JOL 2:10">ਅਤੇ ਤਾਰੇ ਆਪਣੀ ਚਮਕ ਦੇਣੀ ਬੰਦ ਕਰ ਦਿੰਦੇ ਹਨ।<verse eid="JOL 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11" />ਯਾਹਵੇਹ ਆਪਣੀ ਸੈਨਾ ਦੇ ਸਿਰ ਉੱਤੇ ਗਰਜਦਾ ਹੈ;</para>
  <para style="q1" vid="JOL 2:11">ਉਸ ਦੀ ਫ਼ੌਜ ਗਿਣਤੀ ਤੋਂ ਪਰੇ ਹੈ,</para>
  <para style="q2" vid="JOL 2:11">ਅਤੇ ਬਲਵਾਨ ਫ਼ੌਜ ਹੈ ਜੋ ਉਸ ਦੇ ਹੁਕਮ ਨੂੰ ਮੰਨਦੀ ਹੈ।</para>
  <para style="q1" vid="JOL 2:11">ਯਾਹਵੇਹ ਦਾ ਦਿਨ ਮਹਾਨ ਹੈ;</para>
  <para style="q2" vid="JOL 2:11">ਇਹ ਭਿਆਨਕ ਹੈ।</para>
  <para style="q2" vid="JOL 2:11">ਕੌਣ ਇਸ ਨੂੰ ਸਹਿ ਸਕਦਾ ਹੈ?<verse eid="JOL 2:11" /></para>
  <para style="s1">ਆਪਣੇ ਦਿਲ ਨੂੰ ਤੋੜੋ</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12" />ਫਿਰ ਵੀ ਹੁਣ, ਯਾਹਵੇਹ ਇਹ ਆਖਦਾ ਹੈ,</para>
  <para style="q2" vid="JOL 2:12">“ਵਰਤ ਰੱਖ ਕੇ ਰੋਂਦੇ ਹੋਏ ਅਤੇ ਛਾਤੀ ਪਿੱਟਦੇ ਹੋਏ</para>
  <para style="q2" vid="JOL 2:12">ਆਪਣੇ ਸਾਰੇ ਦਿਲ ਨਾਲ ਮੇਰੇ ਵੱਲ ਮੁੜੋ।”<verse eid="JOL 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13" />ਆਪਣੇ ਕੱਪੜਿਆ ਨੂੰ ਨਹੀਂ</para>
  <para style="q2" vid="JOL 2:13">ਸਗੋਂ ਦਿਲ ਨੂੰ ਪਾੜੋ।</para>
  <para style="q1" vid="JOL 2:13">ਯਾਹਵੇਹ ਆਪਣੇ ਪਰਮੇਸ਼ਵਰ ਵੱਲ ਮੁੜੋ,</para>
  <para style="q2" vid="JOL 2:13">ਉਹ ਤਾਂ ਦਿਆਲੂ ਅਤੇ ਕਿਰਪਾਲੂ ਹੈ,</para>
  <para style="q1" vid="JOL 2:13">ਕ੍ਰੋਧ ਵਿੱਚ ਧੀਰਜੀ, ਭਲਿਆਈ ਨਾਲ ਭਰਪੂਰ</para>
  <para style="q2" vid="JOL 2:13">ਅਤੇ ਦੁੱਖ ਦੇਣ ਤੋਂ ਪਛਤਾਉਂਦਾ ਹੈ।<verse eid="JOL 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14" />ਕੌਣ ਜਾਣਦਾ ਹੈ ਭਈ ਉਹ ਮੁੜੇ</para>
  <para style="q2" vid="JOL 2:14">ਅਤੇ ਪਛਤਾਵੇ ਅਤੇ ਆਪਣੇ ਪਿੱਛੇ ਬਰਕਤ ਛੱਡ ਜਾਵੇ,</para>
  <para style="q1" vid="JOL 2:14">ਤਾਂ ਜੋ ਮੈਦੇ ਦੀ ਭੇਟ ਅਤੇ ਪੀਣ ਦੀ ਭੇਟ</para>
  <para style="q2" vid="JOL 2:14">ਤੁਹਾਡੇ ਪਰਮੇਸ਼ਵਰ ਯਾਹਵੇਹ ਲਈ ਹੋਣ।<verse eid="JOL 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15" />ਸੀਯੋਨ ਵਿੱਚ ਤੁਰ੍ਹੀ ਵਜਾਓ,</para>
  <para style="q2" vid="JOL 2:15">ਪਵਿੱਤਰ ਵਰਤ ਦਾ ਐਲਾਨ ਕਰੋ,</para>
  <para style="q2" vid="JOL 2:15">ਇੱਕ ਪਵਿੱਤਰ ਸਭਾ ਬੁਲਾਓ।<verse eid="JOL 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16" />ਲੋਕਾਂ ਨੂੰ ਇਕੱਠਾ ਕਰੋ,</para>
  <para style="q2" vid="JOL 2:16">ਸਭਾ ਨੂੰ ਪਵਿੱਤਰ ਕਰੋ;</para>
  <para style="q1" vid="JOL 2:16">ਬਜ਼ੁਰਗਾਂ ਨੂੰ ਇਕੱਠਾ ਕਰੋ,</para>
  <para style="q2" vid="JOL 2:16">ਨਿਆਣਿਆਂ ਨੂੰ, ਸਗੋਂ ਦੁੱਧ ਚੁੰਘਦਿਆਂ ਬੱਚਿਆਂ ਨੂੰ ਇਕੱਠੇ ਕਰੋ,</para>
  <para style="q1" vid="JOL 2:16">ਲਾੜਾ ਆਪਣੀ ਕੋਠੜੀ ਵਿੱਚੋਂ,</para>
  <para style="q2" vid="JOL 2:16">ਲਾੜੀ ਆਪਣੇ ਕਮਰੇ ਵਿੱਚੋਂ ਬਾਹਰ ਨਿੱਕਲ ਆਵੇ।<verse eid="JOL 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17" />ਜਾਜਕ ਜੋ ਯਾਹਵੇਹ ਦੇ ਅੱਗੇ ਸੇਵਾ ਕਰਦੇ ਹਨ,</para>
  <para style="q2" vid="JOL 2:17">ਦਰਬਾਨ ਅਤੇ ਜਗਵੇਦੀ ਦੇ ਵਿਚਕਾਰ ਰੋਣ।</para>
  <para style="q1" vid="JOL 2:17">ਉਹਨਾਂ ਨੂੰ ਆਖਣ ਦਿਓ, “ਹੇ ਯਾਹਵੇਹ, ਆਪਣੇ ਲੋਕਾਂ ਨੂੰ ਬਚਾਓ।</para>
  <para style="q2" vid="JOL 2:17">ਆਪਣੇ ਵਿਰਸੇ ਨੂੰ ਕੌਮਾਂ ਵਿੱਚ ਘਿਣਾਉਣੀ ਨਾ ਬਣਾਓ।</para>
  <para style="q1" vid="JOL 2:17">ਉਹ ਲੋਕਾਂ ਵਿੱਚ ਕਿਉਂ ਕਹਿਣ,</para>
  <para style="q2" vid="JOL 2:17">‘ਉਨ੍ਹਾਂ ਦਾ ਪਰਮੇਸ਼ਵਰ ਕਿੱਥੇ ਹੈ?’ ”<verse eid="JOL 2:17" /></para>
  <para style="s1">ਯਾਹਵੇਹ ਦਾ ਉੱਤਰ</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18" />ਤਦ ਯਾਹਵੇਹ ਨੂੰ ਆਪਣੀ ਧਰਤੀ ਲਈ ਅਣਖੀ ਹੋਇਆ।</para>
  <para style="q2" vid="JOL 2:18">ਅਤੇ ਆਪਣੇ ਲੋਕਾਂ ਉੱਤੇ ਤਰਸ ਖਾਧਾ।<verse eid="JOL 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19" />ਯਾਹਵੇਹ ਨੇ ਉਨ੍ਹਾਂ ਨੂੰ ਉੱਤਰ ਦਿੱਤਾ ਤੇ ਆਖਿਆ,</para>
  <para style="q1" vid="JOL 2:19">“ਮੈਂ ਤੁਹਾਡੇ ਲਈ ਅਨਾਜ, ਨਵੀਂ ਦਾਖਰਸ ਅਤੇ ਜ਼ੈਤੂਨ ਦਾ ਤੇਲ ਭੇਜ ਰਿਹਾ ਹਾਂ,</para>
  <para style="q2" vid="JOL 2:19">ਕਿ ਤੁਸੀਂ ਸਾਰੇ ਪੂਰੀ ਤਰ੍ਹਾਂ ਰੱਜ ਜਾਓਗੇ;</para>
  <para style="q1" vid="JOL 2:19">ਮੈਂ ਫ਼ੇਰ ਕਦੇ ਵੀ ਤੈਨੂੰ ਕੌਮਾਂ ਲਈ ਨਫ਼ਰਤ ਦਾ ਪਾਤਰ ਨਹੀਂ ਬਣਾਵਾਂਗਾ।<verse eid="JOL 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20" />“ਮੈਂ ਉੱਤਰੀ ਭੀੜ ਨੂੰ ਤੁਹਾਡੇ ਤੋਂ ਦੂਰ ਭਜਾ ਦਿਆਂਗਾ,</para>
  <para style="q2" vid="JOL 2:20">ਉਸਨੂੰ ਸੁੱਕੀ ਅਤੇ ਬੰਜਰ ਧਰਤੀ ਵਿੱਚ ਧੱਕ ਦਿਆਂਗਾ।</para>
  <para style="q1" vid="JOL 2:20">ਉਹ ਦਾ ਅਗਲਾ ਹਿੱਸਾ ਪੂਰਬ ਵਿੱਚ ਸਮੁੰਦਰ ਵੱਲ</para>
  <para style="q2" vid="JOL 2:20">ਅਤੇ ਉਹ ਦਾ ਪਿੱਛਲਾ ਹਿੱਸਾ ਪੱਛਮ ਵੱਲ ਸਮੁੰਦਰ ਵਿੱਚ ਹੋਵੇਗਾ।</para>
  <para style="q1" vid="JOL 2:20">ਉਹ ਦੇ ਵਿੱਚੋਂ ਬਦਬੂ ਉੱਠੇਗੀ</para>
  <para style="q2" vid="JOL 2:20">ਅਤੇ ਸੜਿਆਂਧ ਆਵੇਗੀ।”</para>
  <para style="b" vid="JOL 2:20" />
  <para style="q1" vid="JOL 2:20">ਯਕੀਨਨ ਯਾਹਵੇਹ ਨੇ ਮਹਾਨ ਕੰਮ ਕੀਤੇ ਹਨ!<verse eid="JOL 2:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21" />ਹੇ ਯਹੂਦਾਹ ਦੀ ਧਰਤੀ, ਨਾ ਡਰ!</para>
  <para style="q2" vid="JOL 2:21">ਖੁਸ਼ ਹੋਵੋ ਅਤੇ ਅਨੰਦ ਕਰੋ।</para>
  <para style="q1" vid="JOL 2:21">ਯਕੀਨਨ ਯਾਹਵੇਹ ਨੇ ਮਹਾਨ ਕੰਮ ਕੀਤੇ ਹਨ!<verse eid="JOL 2:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22" />ਹੇ ਜੰਗਲੀ ਜਾਨਵਰੋ, ਨਾ ਡਰੋ,</para>
  <para style="q2" vid="JOL 2:22">ਕਿਉਂ ਜੋ ਉਜਾੜ ਵਿੱਚ ਚਰਾਗਾਹਾਂ ਹਰੀਆਂ ਹੋ ਰਹੀਆਂ ਹਨ।</para>
  <para style="q1" vid="JOL 2:22">ਰੁੱਖ ਆਪਣੇ ਫਲ ਦੇ ਰਹੇ ਹਨ;</para>
  <para style="q2" vid="JOL 2:22">ਹੰਜੀਰ ਦੇ ਰੁੱਖ ਅਤੇ ਅੰਗੂਰੀ ਵੇਲ ਆਪਣਾ ਧਨ ਦਿੰਦੇ ਹਨ।<verse eid="JOL 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23" />ਹੇ ਸੀਯੋਨ ਦੇ ਲੋਕੋ, ਖੁਸ਼ ਹੋਵੋ,</para>
  <para style="q2" vid="JOL 2:23">ਆਪਣੇ ਯਾਹਵੇਹ ਵਿੱਚ ਅਨੰਦ ਕਰੋ,</para>
  <para style="q1" vid="JOL 2:23">ਉਹ ਨੇ ਤੁਹਾਡੇ ਲਈ ਪਹਿਲੀ ਅਤੇ ਪਿਛਲੀ ਵਰਖਾ ਵਰ੍ਹਾਈ ਹੈ,</para>
  <para style="q2" vid="JOL 2:23">ਜਿਵੇਂ ਪਹਿਲਾਂ ਹੁੰਦਾ ਸੀ।<verse eid="JOL 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24" />ਪਿੜ ਅਨਾਜ ਨਾਲ ਭਰ ਜਾਣਗੇ;</para>
  <para style="q2" vid="JOL 2:24">ਚੁਬੱਚੇ ਨਵੀਂ ਦਾਖਰਸ ਅਤੇ ਤੇਲ ਨਾਲ ਭਰ ਜਾਣਗੇ।<verse eid="JOL 2:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25" />“ਜੋ ਫਸਲ ਨੂੰ ਟਿੱਡੀਆਂ ਨੇ ਖਾਧਾ ਹੈ ਉਸ ਨੂੰ ਮੈਂ ਵਾਪਸ ਕਰਾਂਗਾ,</para>
  <para style="q2" vid="JOL 2:25">ਵੱਡੀ ਟਿੱਡੀ ਅਤੇ ਛੋਟੀ ਟਿੱਡੀ,</para>
  <para style="q2" vid="JOL 2:25">ਹੂੰਝਾ ਫੇਰ ਅਤੇ ਟਪੂਸੀ ਮਾਰ ਟਿੱਡੀਆਂ ਨੇ</para>
  <para style="q1" vid="JOL 2:25">ਅਰਥਾਤ ਮੇਰੀ ਵੱਡੀ ਫੌਜ ਨੇ ਜਿਹੜੀ ਮੈਂ ਤੁਹਾਡੇ ਉੱਤੇ ਘੱਲੀ ਸੀ, ਖਾ ਲਿਆ ਸੀ, ਉਹ ਮੈਂ ਤੁਹਾਨੂੰ ਮੋੜ ਦਿਆਂਗਾ।<verse eid="JOL 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26" />ਤੁਹਾਡੇ ਕੋਲ ਖਾਣ ਲਈ ਬਹੁਤ ਕੁਝ ਹੋਵੇਗਾ, ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਰੱਜ ਨਹੀਂ ਜਾਂਦੇ,</para>
  <para style="q2" vid="JOL 2:26">ਅਤੇ ਤੁਸੀਂ ਆਪਣੇ ਯਾਹਵੇਹ ਦੇ ਨਾਮ ਦੀ ਉਸਤਤ ਕਰੋਗੇ,</para>
  <para style="q2" vid="JOL 2:26">ਜਿਸ ਨੇ ਤੁਹਾਡੇ ਲਈ ਅਚਰਜ ਕੰਮ ਕੀਤੇ ਹਨ।</para>
  <para style="q1" vid="JOL 2:26">ਫੇਰ ਕਦੇ ਮੇਰੇ ਲੋਕ ਸ਼ਰਮਿੰਦਾ ਨਹੀਂ ਹੋਣਗੇ।<verse eid="JOL 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27" />ਤਦ ਤੁਸੀਂ ਜਾਣ ਜਾਵੋਂਗੇ ਕਿ ਮੈਂ ਇਸਰਾਏਲ ਵਿੱਚ ਹਾਂ,</para>
  <para style="q2" vid="JOL 2:27">ਕਿ ਮੈਂ ਹੀ ਤੁਹਾਡਾ ਯਾਹਵੇਹ ਪਰਮੇਸ਼ਵਰ ਹਾਂ,</para>
  <para style="q2" vid="JOL 2:27">ਅਤੇ ਕੋਈ ਹੋਰ ਨਹੀਂ ਹੈ।</para>
  <para style="q1" vid="JOL 2:27">ਫੇਰ ਕਦੇ ਮੇਰੇ ਲੋਕ ਸ਼ਰਮਿੰਦਾ ਨਹੀਂ ਹੋਣਗੇ।<verse eid="JOL 2:27" /></para>
  <para style="s1">ਯਾਹਵੇਹ ਦਾ ਦਿਨ</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28" />“ਅਤੇ ਇਸ ਤੋਂ ਬਾਅਦ ਅਜਿਹਾ ਹੋਵੇਗਾ,</para>
  <para style="q2" vid="JOL 2:28">ਮੈਂ ਆਪਣਾ ਆਤਮਾ ਸਾਰੇ ਸਰੀਰਾਂ ਉੱਤੇ ਵਹਾ ਦਿਆਂਗਾ।</para>
  <para style="q1" vid="JOL 2:28">ਅਤੇ ਤੁਹਾਡੇ ਪੁੱਤਰ ਅਤੇ ਤੁਹਾਡੀਆਂ ਧੀਆਂ ਭਵਿੱਖਬਾਣੀ ਕਰਨਗੇ,</para>
  <para style="q2" vid="JOL 2:28">ਤੁਹਾਡੇ ਜੁਆਨ ਦਰਸ਼ਣ ਵੇਖਣਗੇ,</para>
  <para style="q2" vid="JOL 2:28">ਤੁਹਾਡੇ ਬਜ਼ੁਰਗ ਸੁਫ਼ਨੇ ਵੇਖਣਗੇ।<verse eid="JOL 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29" />ਇੱਥੋਂ ਤੱਕ ਕਿ ਮੇਰੇ ਸੇਵਕਾਂ ਉੱਤੇ, ਆਦਮੀ ਅਤੇ ਔਰਤ ਦੋਹਾਂ ਤੇ</para>
  <para style="q2" vid="JOL 2:29">ਮੈਂ ਉਨ੍ਹਾਂ ਦਿਨਾਂ ਵਿੱਚ ਉਨ੍ਹਾਂ ਉੱਤੇ ਆਪਣਾ ਆਤਮਾ ਵਹਾ ਦਿਆਂਗਾ।<verse eid="JOL 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30" />ਮੈਂ ਅਕਾਸ਼ ਵਿੱਚ</para>
  <para style="q2" vid="JOL 2:30">ਅਤੇ ਧਰਤੀ ਉੱਤੇ,</para>
  <para style="q2" vid="JOL 2:30">ਲਹੂ, ਅੱਗ ਅਤੇ ਧੂੰਏਂ ਦੇ ਚਮਤਕਾਰ ਵਿਖਾਵਾਂਗਾ।<verse eid="JOL 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31" />ਸੂਰਜ ਹਨ੍ਹੇਰੇ ਵਿੱਚ ਬਦਲ ਜਾਵੇਗਾ</para>
  <para style="q2" vid="JOL 2:31">ਅਤੇ ਚੰਨ ਲਹੂ ਵਿੱਚ</para>
  <para style="q2" vid="JOL 2:31">ਯਾਹਵੇਹ ਦੇ ਮਹਾਨ ਅਤੇ ਭਿਆਨਕ ਦਿਨ ਦੇ ਆਉਣ ਤੋਂ ਪਹਿਲਾਂ।<verse eid="JOL 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32" />ਅਤੇ ਹਰੇਕ ਜਿਹੜਾ ਵੀ</para>
  <para style="q2" vid="JOL 2:32">ਯਾਹਵੇਹ ਦਾ ਨਾਮ ਲੈ ਕੇ ਪੁਕਾਰਦਾ ਹੈ ਉਹ ਬਚਾਇਆ ਜਾਵੇਗਾ।</para>
  <para style="q1" vid="JOL 2:32">ਕਿਉਂਕਿ ਸੀਯੋਨ ਪਰਬਤ ਉੱਤੇ ਅਤੇ ਯੇਰੂਸ਼ਲੇਮ ਵਿੱਚ,</para>
  <para style="q2" vid="JOL 2:32">ਛੁਟਕਾਰਾ ਹੋਵੇਗਾ,</para>
  <para style="q2" vid="JOL 2:32">ਜਿਵੇਂ ਕਿ ਯਾਹਵੇਹ ਨੇ ਕਿਹਾ ਹੈ,</para>
  <para style="q1" vid="JOL 2:32">ਬਚੇ ਹੋਏ ਲੋਕਾਂ ਵਿੱਚੋਂ ਵੀ,</para>
  <para style="q2" vid="JOL 2:32">ਜਿਨ੍ਹਾਂ ਨੂੰ ਯਾਹਵੇਹ ਬੁਲਾਵੇਗਾ।<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s1">ਕੌਮਾਂ ਨੇ ਨਿਆਂ ਕੀਤਾ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1" />“ਉਨ੍ਹਾਂ ਦਿਨਾਂ ਵਿੱਚ ਅਤੇ ਉਸ ਸਮੇਂ,</para>
  <para style="q2" vid="JOL 3:1">ਜਦੋਂ ਮੈਂ ਯਹੂਦਾਹ ਅਤੇ ਯੇਰੂਸ਼ਲੇਮ ਦੀ ਗੁਲਾਮੀ ਨੂੰ ਮੁਕਾ ਦਿਆਂਗਾ,<verse eid="JOL 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2" />ਮੈਂ ਸਾਰੀਆਂ ਕੌਮਾਂ ਨੂੰ ਇਕੱਠਾ ਕਰਾਂਗਾ,</para>
  <para style="q2" vid="JOL 3:2">ਅਤੇ ਉਨ੍ਹਾਂ ਨੂੰ ਯਹੋਸ਼ਾਫ਼ਾਟ<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">ਯਹੋਸ਼ਾਫ਼ਾਟ </char><char style="ft" closed="false">ਅਰਥ </char><char style="fqa" closed="false">ਯਾਹਵੇਹ ਨਿਆਂਕਾਰ</char></note> ਦੀ ਘਾਟੀ ਹੇਠਾਂ ਲਿਆਵਾਂਗਾ।</para>
  <para style="q1" vid="JOL 3:2">ਉੱਥੇ ਮੈਂ ਉਹਨਾਂ ਦੀ ਜਾਂਚ ਕਰਾਂਗਾ,</para>
  <para style="q2" vid="JOL 3:2">ਜੋ ਉਨ੍ਹਾਂ ਨੇ ਮੇਰੀ ਵਿਰਾਸਤ, ਮੇਰੀ ਪਰਜਾ ਇਸਰਾਏਲ ਨਾਲ ਕੀਤਾ,</para>
  <para style="q1" vid="JOL 3:2">ਕਿਉਂਕਿ ਉਨ੍ਹਾਂ ਨੇ ਮੇਰੇ ਲੋਕਾਂ ਨੂੰ ਕੌਮਾਂ ਵਿੱਚ ਖਿੰਡਾ ਦਿੱਤਾ</para>
  <para style="q2" vid="JOL 3:2">ਅਤੇ ਮੇਰੀ ਧਰਤੀ ਨੂੰ ਵੰਡ ਦਿੱਤਾ।<verse eid="JOL 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3" />ਉਨ੍ਹਾਂ ਨੇ ਮੇਰੇ ਲੋਕਾਂ ਉੱਤੇ ਗੁਣਾ ਪਾਇਆ,</para>
  <para style="q2" vid="JOL 3:3">ਅਤੇ ਵੇਸਵਾਵਾਂ ਲਈ ਮੁੰਡਿਆਂ ਦਾ ਵਪਾਰ ਕੀਤਾ।</para>
  <para style="q2" vid="JOL 3:3">ਉਨ੍ਹਾਂ ਨੇ ਸ਼ਰਾਬ ਪੀਣ ਲਈ ਕੁੜੀਆਂ ਨੂੰ ਵੇਚ ਦਿੱਤਾ।<verse eid="JOL 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />“ਹੇ ਸੂਰ ਅਤੇ ਸੀਦੋਨ ਅਤੇ ਫ਼ਲਿਸਤ ਦੇ ਸਾਰੇ ਇਲਾਕਿਆਂ ਵਿੱਚ ਹੁਣ ਤੁਹਾਡੇ ਕੋਲ ਮੇਰੇ ਵਿਰੁੱਧ ਕੀ ਹੈ? ਕੀ ਤੁਸੀਂ ਮੈਨੂੰ ਮੇਰੇ ਕੀਤੇ ਕਿਸੇ ਕੰਮ ਦਾ ਬਦਲਾ ਦੇ ਰਹੇ ਹੋ? ਜੇ ਤੁਸੀਂ ਮੈਨੂੰ ਕੰਮ ਦਾ ਬਦਲਾ ਦੇ ਰਹੇ ਹੋ, ਤਾਂ ਮੈਂ ਝੱਟ ਹੀ ਤੁਹਾਡੇ ਸਿਰ ਉੱਤੇ ਤੁਹਾਡਾ ਬਦਲਾ ਮੋੜ ਦਿਆਂਗਾ। <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />ਕਿਉਂ ਜੋ ਤੁਸੀਂ ਮੇਰੀ ਚਾਂਦੀ ਅਤੇ ਮੇਰਾ ਸੋਨਾ ਲੈ ਲਿਆ ਅਤੇ ਮੇਰੇ ਵਧੀਆ ਖਜ਼ਾਨੇ ਨੂੰ ਆਪਣੇ ਮੰਦਰਾਂ ਵਿੱਚ ਲੈ ਗਏ <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />ਤੁਸੀਂ ਯਹੂਦਾਹ ਅਤੇ ਯੇਰੂਸ਼ਲੇਮ ਦੇ ਲੋਕਾਂ ਨੂੰ ਯੂਨਾਨੀਆਂ ਦੇ ਹੱਥ ਵੇਚ ਦਿੱਤਾ, ਤਾਂ ਜੋ ਤੁਸੀਂ ਉਨ੍ਹਾਂ ਨੂੰ ਉਨ੍ਹਾਂ ਦੇ ਦੇਸ਼ ਤੋਂ ਦੂਰ ਭੇਜ ਸਕੋ।<verse eid="JOL 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7" />“ਵੇਖੋ, ਮੈਂ ਉਹਨਾਂ ਨੂੰ ਉਹਨਾਂ ਥਾਵਾਂ ਤੋਂ ਉਭਾਰਾਂਗਾ ਜਿੱਥੇ ਤੁਸੀਂ ਉਹਨਾਂ ਨੂੰ ਵੇਚਿਆ ਸੀ ਅਤੇ ਮੈਂ ਤੁਹਾਡੇ ਦੁਆਰਾ ਕੀਤੇ ਗਏ ਕੰਮ ਨੂੰ ਤੁਹਾਡੇ ਆਪਣੇ ਸਿਰ ਤੇ ਪਾਵਾਂਗਾ। <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />ਮੈਂ ਤੁਹਾਡੇ ਪੁੱਤਰਾਂ ਅਤੇ ਧੀਆਂ ਨੂੰ ਯਹੂਦਾਹ ਦੇ ਲੋਕਾਂ ਕੋਲ ਵੇਚ ਦਿਆਂਗਾ ਅਤੇ ਉਹ ਉਨ੍ਹਾਂ ਨੂੰ ਸਾਬੀਨ ਲੋਕਾਂ ਕੋਲ ਵੇਚ ਦੇਣਗੇ, ਦੂਰ ਇੱਕ ਕੌਮ ਹੈ।” ਯਾਹਵੇਹ ਬੋਲਿਆ ਹੈ।<verse eid="JOL 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9" />ਕੌਮਾਂ ਵਿੱਚ ਇਹ ਐਲਾਨ ਕਰੋ:</para>
  <para style="q2" vid="JOL 3:9">ਯੁੱਧ ਲਈ ਤਿਆਰ ਰਹੋ!</para>
  <para style="q1" vid="JOL 3:9">ਯੋਧਿਆਂ ਨੂੰ ਜਗਾਓ!</para>
  <para style="q2" vid="JOL 3:9">ਸਾਰੇ ਲੜਨ ਵਾਲੇ ਆਦਮੀਆਂ ਨੂੰ ਨੇੜੇ ਆਉਣ ਅਤੇ ਹਮਲਾ ਕਰਨ ਦਿਓ।<verse eid="JOL 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10" />ਆਪਣੇ ਹਲ ਨੂੰ ਕੁੱਟ ਕੇ ਤਲਵਾਰਾਂ ਬਣਾਉ</para>
  <para style="q2" vid="JOL 3:10">ਅਤੇ ਆਪਣੀਆਂ ਦਾਤਰਿਆਂ ਨੂੰ ਬਰਛੀਆਂ ਬਣਾਓ।</para>
  <para style="q1" vid="JOL 3:10">ਜੋ ਕਮਜ਼ੋਰ ਹਨ ਉਹ ਆਖਣ,</para>
  <para style="q2" vid="JOL 3:10">“ਮੈਂ ਸੂਰਬੀਰ ਹਾਂ!”<verse eid="JOL 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11" />ਹੇ ਸਾਰੀਆਂ ਕੌਮਾਂ, ਹਰ ਪਾਸਿਓਂ ਜਲਦੀ ਆਓ,</para>
  <para style="q2" vid="JOL 3:11">ਅਤੇ ਉੱਥੇ ਇਕੱਠੇ ਹੋਵੋ।</para>
  <para style="b" vid="JOL 3:11" />
  <para style="q1" vid="JOL 3:11">ਹੇ ਯਾਹਵੇਹ, ਉੱਥੇ ਆਪਣੇ ਸੂਰਬੀਰਾਂ ਨੂੰ ਉਤਾਰ ਦੇ!<verse eid="JOL 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12" />“ਕੌਮਾਂ ਆਪਣੇ ਆਪ ਨੂੰ ਜਗਾਉਣ;</para>
  <para style="q2" vid="JOL 3:12">ਉਨ੍ਹਾਂ ਨੂੰ ਯਹੋਸ਼ਾਫ਼ਾਟ ਦੀ ਵਾਦੀ ਵਿੱਚ ਅੱਗੇ ਵਧਣ ਦਿਓ,</para>
  <para style="q1" vid="JOL 3:12">ਕਿਉਂ ਜੋ ਮੈਂ ਉੱਥੇ ਬੈਠ ਕੇ ਸਾਰੀਆਂ ਕੌਮਾਂ ਦਾ</para>
  <para style="q2" vid="JOL 3:12">ਹਰ ਪਾਸਿਓਂ ਨਿਆਂ ਕਰਾਂਗਾ।<verse eid="JOL 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13" />ਦਾਤਰੀ ਚਲਾਓ,</para>
  <para style="q2" vid="JOL 3:13">ਕਿਉਂਕਿ ਵਾਢੀ ਪੱਕ ਚੁੱਕੀ ਹੈ।</para>
  <para style="q1" vid="JOL 3:13">ਆਓ, ਅੰਗੂਰਾਂ ਨੂੰ ਮਿੱਧੋ,</para>
  <para style="q2" vid="JOL 3:13">ਦਾਖਰਸ ਨਾਲ ਚੁਬੱਚਾ ਭਰਿਆ ਹੋਇਆ ਹੈ</para>
  <para style="q2" vid="JOL 3:13">ਅਤੇ ਮਟਕੇ ਭਰ-ਭਰ ਕੇ ਉੱਛਲਦੇ ਹਨ,</para>
  <para style="q1" vid="JOL 3:13">ਉਹਨਾਂ ਦੀ ਦੁਸ਼ਟਤਾ ਬਹੁਤ ਜ਼ਿਆਦਾ ਹੈ!”<verse eid="JOL 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14" />ਫੈਸਲੇ ਦੀ ਘਾਟੀ ਵਿੱਚ,</para>
  <para style="q2" vid="JOL 3:14">ਲੋਕਾਂ ਦੀ ਭੀੜ ਹੀ ਭੀੜ ਹੈ</para>
  <para style="q1" vid="JOL 3:14">ਕਿਉਂਕਿ ਯਾਹਵੇਹ ਦਾ ਦਿਨ ਫ਼ੈਸਲੇ ਦੀ ਵਾਦੀ ਵਿੱਚ ਨੇੜੇ ਹੈ।<verse eid="JOL 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15" />ਸੂਰਜ ਅਤੇ ਚੰਦ ਹਨੇਰਾ ਹੋ ਜਾਣਗੇ,</para>
  <para style="q2" vid="JOL 3:15">ਅਤੇ ਤਾਰੇ ਹੋਰ ਨਹੀਂ ਚਮਕਣਗੇ।<verse eid="JOL 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16" />ਯਾਹਵੇਹ ਸੀਯੋਨ ਤੋਂ ਗਰਜੇਗਾ ਅਤੇ ਯੇਰੂਸ਼ਲੇਮ ਤੋਂ ਵੱਡੀ ਆਵਾਜ਼ ਕਰੇਗਾ।</para>
  <para style="q2" vid="JOL 3:16">ਧਰਤੀ ਅਤੇ ਅਕਾਸ਼ ਕੰਬਣਗੇ।</para>
  <para style="q1" vid="JOL 3:16">ਪਰ ਯਾਹਵੇਹ ਆਪਣੇ ਲੋਕਾਂ ਲਈ ਪਨਾਹ ਹੋਵੇਗਾ,</para>
  <para style="q2" vid="JOL 3:16">ਇਸਰਾਏਲ ਦੇ ਲੋਕਾਂ ਲਈ ਇੱਕ ਗੜ੍ਹ ਹੋਵੇਗਾ।<verse eid="JOL 3:16" /></para>
  <para style="s1">ਪਰਮੇਸ਼ਵਰ ਦੇ ਲੋਕਾਂ ਲਈ ਅਸੀਸਾਂ</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17" />“ਤਦ ਤੁਸੀਂ ਜਾਣ ਜਾਵੋਂਗੇ ਕਿ ਮੈਂ ਤੁਹਾਡਾ ਯਾਹਵੇਹ ਤੁਹਾਡੀ ਪਵਿੱਤਰ ਪਹਾੜੀ ਸੀਯੋਨ ਵਿੱਚ ਰਹਿੰਦਾ ਹਾਂ।</para>
  <para style="q1" vid="JOL 3:17">ਯੇਰੂਸ਼ਲੇਮ ਪਵਿੱਤਰ ਹੋਵੇਗਾ;</para>
  <para style="q2" vid="JOL 3:17">ਫੇਰ ਕਦੇ ਵੀ ਵਿਦੇਸ਼ੀ ਉਸ ਉੱਤੇ ਹਮਲਾ ਨਹੀਂ ਕਰਨਗੇ।<verse eid="JOL 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18" />“ਉਸ ਦਿਨ ਪਹਾੜਾਂ ਵਿੱਚੋਂ ਨਵੀਂ ਦਾਖਰਸ ਚੋਵੇਗੀ,</para>
  <para style="q2" vid="JOL 3:18">ਅਤੇ ਪਹਾੜੀਆਂ ਦੁੱਧ ਨਾਲ ਵਗਣਗੀਆਂ।</para>
  <para style="q2" vid="JOL 3:18">ਯਹੂਦਾਹ ਦੀਆਂ ਸਾਰੀਆਂ ਖੱਡਾਂ ਪਾਣੀ ਨਾਲ ਵਗਣਗੀਆਂ।</para>
  <para style="q1" vid="JOL 3:18">ਯਾਹਵੇਹ ਦੇ ਭਵਨ ਤੋਂ ਇੱਕ ਚਸ਼ਮਾ ਨਿੱਕਲੇਗਾ</para>
  <para style="q2" vid="JOL 3:18">ਅਤੇ ਸ਼ਿੱਟੀਮ ਦੀ ਵਾਦੀ ਨੂੰ ਸਿੰਜੇਗਾ।<verse eid="JOL 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19" />ਪਰ ਮਿਸਰ ਵਿਰਾਨ ਹੋ ਜਾਵੇਗਾ,</para>
  <para style="q2" vid="JOL 3:19">ਅਦੋਮ ਇੱਕ ਬੇਕਾਰ ਵਿਰਾਨ ਧਰਤੀ ਹੈ,</para>
  <para style="q1" vid="JOL 3:19">ਕਿਉਂਕਿ ਉਹਨਾਂ ਯਹੂਦਾਹ ਦੇ ਲੋਕਾਂ ਉੱਤੇ ਜ਼ੁਲਮ ਕੀਤਾ,</para>
  <para style="q2" vid="JOL 3:19">ਜਿਨ੍ਹਾਂ ਦੀ ਧਰਤੀ ਵਿੱਚ ਉਨ੍ਹਾਂ ਨੇ ਨਿਰਦੋਸ਼ਾਂ ਦਾ ਖੂਨ ਵਹਾਇਆ।<verse eid="JOL 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20" />ਲੋਕ ਯਹੂਦਿਯਾ ਵਿੱਚ ਸਦਾ ਲਈ ਰਹਿਣਗੇ</para>
  <para style="q2" vid="JOL 3:20">ਅਤੇ ਲੋਕ ਯੇਰੂਸ਼ਲੇਮ ਵਿੱਚ ਪੀੜ੍ਹੀ ਦਰ ਪੀੜ੍ਹੀ ਰਹਿਣਗੇ।<verse eid="JOL 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21" />ਕੀ ਮੈਂ ਉਨ੍ਹਾਂ ਨਿਰਦੋਸ਼ ਲੋਕਾਂ ਦੇ ਖੂਨ ਦਾ ਬਦਲਾ ਲਏ ਬਿਨਾਂ ਛੱਡਾਂਗਾ?</para>
  <para style="q2" vid="JOL 3:21">ਨਹੀਂ, ਬਿਲਕੁਲ ਨਹੀਂ।”</para>
  <para style="b" vid="JOL 3:21" />
  <para style="qc" vid="JOL 3:21">ਯਾਹਵੇਹ ਸੀਯੋਨ ਵਿੱਚ ਵੱਸਦਾ ਹੈ!<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>