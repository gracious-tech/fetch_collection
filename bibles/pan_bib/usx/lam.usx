<usx version="3.0">
  <book code="LAM" style="id">- Biblica® Open Punjabi Contemporary Version</book>
  <para style="rem">Copyright © 2022, 2025 by Biblica, Inc.</para>
  <para style="h">ਵਿਰਲਾਪ</para>
  <para style="toc1">ਵਿਰਲਾਪ ਗੀਤ</para>
  <para style="toc2">ਵਿਰਲਾਪ</para>
  <para style="toc3">ਵਿਰ</para>
  <para style="mt1">ਵਿਰਲਾਪ ਗੀਤ</para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1" />ਕਿਵੇਂ ਉਹ ਇਕੱਲੀ ਨਗਰੀ ਉਜਾੜ ਵਾਂਗ ਹੋ ਗਈ,</para>
  <para style="q2" vid="LAM 1:1">ਜਿਹੜੀ ਪਹਿਲਾਂ ਲੋਕਾਂ ਨਾਲ ਭਰੀ ਹੋਈ ਸੀ!</para>
  <para style="q1" vid="LAM 1:1">ਉਹ ਵਿਧਵਾ ਵਾਂਗੂੰ ਹੋ ਗਈ,</para>
  <para style="q2" vid="LAM 1:1">ਕਦੇ ਉਹ ਕੌਮਾਂ ਵਿੱਚ ਮਹਾਨ ਸੀ!</para>
  <para style="q1" vid="LAM 1:1">ਉਹ ਸੂਬਿਆਂ ਦੀ ਰਾਜਕੁਮਾਰੀ ਸੀ,</para>
  <para style="q2" vid="LAM 1:1">ਹੁਣ ਉਹ ਗੁਲਾਮ ਬਣ ਗਈ।<verse eid="LAM 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2" />ਉਹ ਰਾਤ ਨੂੰ ਰੋਂਦੀ ਹੈ,</para>
  <para style="q2" vid="LAM 1:2">ਹੰਝੂ ਉਸ ਦੀਆਂ ਗੱਲ੍ਹਾਂ ਉੱਤੇ ਛਲਕਦੇ ਹਨ।</para>
  <para style="q1" vid="LAM 1:2">ਉਸ ਦੇ ਸਾਰੇ ਪ੍ਰੇਮੀਆਂ ਵਿੱਚ</para>
  <para style="q2" vid="LAM 1:2">ਉਸ ਨੂੰ ਦਿਲਾਸਾ ਦੇਣ ਵਾਲਾ ਕੋਈ ਨਹੀਂ ਹੈ।</para>
  <para style="q1" vid="LAM 1:2">ਉਸ ਦੇ ਸਾਰੇ ਦੋਸਤਾਂ ਨੇ ਉਸ ਨੂੰ ਧੋਖਾ ਦਿੱਤਾ ਹੈ;</para>
  <para style="q2" vid="LAM 1:2">ਉਹ ਉਸ ਦੇ ਦੁਸ਼ਮਣ ਬਣ ਗਏ ਹਨ।<verse eid="LAM 1:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3" />ਯਹੂਦਾਹ ਦੇ ਕਸ਼ਟ ਅਤੇ ਕਠੋਰ ਮਿਹਨਤ ਤੋਂ ਬਾਅਦ,</para>
  <para style="q2" vid="LAM 1:3">ਉਹ ਗ਼ੁਲਾਮੀ ਵਿੱਚ ਚਲੀ ਗਈ।</para>
  <para style="q1" vid="LAM 1:3">ਉਹ ਕੌਮਾਂ ਵਿੱਚ ਵੱਸਦੀ ਹੈ;</para>
  <para style="q2" vid="LAM 1:3">ਉਸ ਨੂੰ ਕੋਈ ਆਰਾਮ ਕਰਨ ਦੀ ਥਾਂ ਨਹੀਂ ਮਿਲਦੀ।</para>
  <para style="q1" vid="LAM 1:3">ਉਹ ਦੇ ਸਾਰੇ ਪਿੱਛਾ ਕਰਨ ਵਾਲਿਆਂ ਨੇ</para>
  <para style="q2" vid="LAM 1:3">ਉਸ ਨੂੰ ਦੁੱਖ ਵਿੱਚ ਜਾ ਫੜ੍ਹਿਆ।<verse eid="LAM 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4" />ਸੀਯੋਨ ਦੇ ਰਾਹ ਸੋਗ ਕਰਦੇ ਹਨ,</para>
  <para style="q2" vid="LAM 1:4">ਕਿਉਂਕਿ ਕੋਈ ਵੀ ਉਸ ਦੇ ਠਹਿਰਾਏ ਹੋਏ ਤਿਉਹਾਰਾਂ ਵਿੱਚ ਨਹੀਂ ਆਉਂਦਾ।</para>
  <para style="q1" vid="LAM 1:4">ਉਹ ਦੇ ਸਾਰੇ ਦਰਵਾਜ਼ੇ ਵਿਰਾਨ ਹਨ,</para>
  <para style="q2" vid="LAM 1:4">ਉਹ ਦੇ ਜਾਜਕ ਹਾਉਂਕੇ ਭਰਦੇ ਹਨ,</para>
  <para style="q1" vid="LAM 1:4">ਉਸ ਦੀਆਂ ਮੁਟਿਆਰਾਂ ਸੋਗ ਕਰਦੀਆਂ ਹਨ,</para>
  <para style="q2" vid="LAM 1:4">ਅਤੇ ਉਹ ਬਹੁਤ ਦੁਖੀ ਹੈ।<verse eid="LAM 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5" />ਉਸਦੇ ਦੁਸ਼ਮਣ ਉਸਦੇ ਮਾਲਕ ਬਣ ਗਏ ਹਨ;</para>
  <para style="q2" vid="LAM 1:5">ਉਸਦੇ ਦੁਸ਼ਮਣ ਸੌਖੇ ਹਨ।</para>
  <para style="q1" vid="LAM 1:5">ਯਾਹਵੇਹ ਨੇ ਉਸ ਦੇ ਬਹੁਤ ਸਾਰੇ ਗੁਨਾਹਾਂ ਦੇ ਕਾਰਨ</para>
  <para style="q2" vid="LAM 1:5">ਉਸ ਨੂੰ ਦੁੱਖ ਦਿੱਤਾ ਹੈ।</para>
  <para style="q1" vid="LAM 1:5">ਉਸਦੇ ਬੱਚੇ ਗ਼ੁਲਾਮੀ ਵਿੱਚ ਚਲੇ ਗਏ ਹਨ,</para>
  <para style="q2" vid="LAM 1:5">ਉਹ ਦੁਸ਼ਮਣ ਦੇ ਅੱਗੇ ਗ਼ੁਲਾਮ ਹਨ।<verse eid="LAM 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6" />ਸੀਯੋਨ ਦੀ ਧੀ ਤੋਂ ਸਾਰੀ ਸ਼ਾਨ ਚਲੀ ਗਈ ਹੈ,</para>
  <para style="q1" vid="LAM 1:6">ਉਸ ਦੇ ਸਾਰੇ ਹਾਕਮ ਹਿਰਨੀਆਂ ਵਰਗੇ ਹੋ ਗਏ ਹਨ</para>
  <para style="q2" vid="LAM 1:6">ਜਿਨ੍ਹਾਂ ਨੂੰ ਕੋਈ ਚਾਰਾ ਨਹੀਂ ਮਿਲਦਾ।</para>
  <para style="q1" vid="LAM 1:6">ਕਮਜ਼ੋਰੀ ਵਿੱਚ ਉਹ ਪਿੱਛਾ ਕਰਨ ਵਾਲੇ</para>
  <para style="q2" vid="LAM 1:6">ਦੇ ਅੱਗੇ ਭੱਜ ਗਏ ਹਨ।<verse eid="LAM 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7" />ਆਪਣੇ ਦੁੱਖ ਅਤੇ ਭਟਕਣ ਦੇ ਦਿਨਾਂ ਵਿੱਚ</para>
  <para style="q2" vid="LAM 1:7">ਯੇਰੂਸ਼ਲੇਮ ਨੇ ਆਪਣੇ ਸਾਰੇ ਮਨਭਾਉਂਦੇ ਪਦਾਰਥਾਂ ਨੂੰ ਯਾਦ ਕੀਤਾ,</para>
  <para style="q1" vid="LAM 1:7">ਜਦ ਉਹ ਦੇ ਲੋਕ ਵਿਰੋਧੀ ਦੇ ਹੱਥ ਵਿੱਚ ਪਏ,</para>
  <para style="q2" vid="LAM 1:7">ਅਤੇ ਉਹ ਦਾ ਸਹਾਇਕ ਕੋਈ ਨਾ ਬਣਿਆ।</para>
  <para style="q1" vid="LAM 1:7">ਉਹ ਦੇ ਵਿਰੋਧੀਆਂ ਨੇ ਉਹ ਨੂੰ ਵੇਖਿਆ,</para>
  <para style="q2" vid="LAM 1:7">ਅਤੇ ਉਹ ਦੀ ਬਰਬਾਦੀ ਦਾ ਮਖ਼ੌਲ ਉਡਾਇਆ।<verse eid="LAM 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8" />ਯੇਰੂਸ਼ਲੇਮ ਨੇ ਵੱਡਾ ਪਾਪ ਕੀਤਾ ਹੈ</para>
  <para style="q2" vid="LAM 1:8">ਅਤੇ ਇਸ ਤਰ੍ਹਾਂ ਉਹ ਅਸ਼ੁੱਧ ਹੋ ਗਈ।</para>
  <para style="q1" vid="LAM 1:8">ਜਿਨ੍ਹਾਂ ਨੇ ਉਸ ਦਾ ਆਦਰ ਕੀਤਾ ਉਹ ਉਸ ਨੂੰ ਤੁੱਛ ਸਮਝਦੇ ਹਨ,</para>
  <para style="q2" vid="LAM 1:8">ਕਿਉਂਕਿ ਉਹਨਾਂ ਸਾਰਿਆਂ ਨੇ ਉਸ ਨੂੰ ਨੰਗੀ ਵੇਖਿਆ ਹੈ।</para>
  <para style="q1" vid="LAM 1:8">ਉਹ ਆਪ ਹਾਉਂਕੇ ਭਰਦੀ ਹੈ,</para>
  <para style="q2" vid="LAM 1:8">ਅਤੇ ਮੂੰਹ ਮੋੜ ਲੈਂਦੀ ਹੈ।<verse eid="LAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9" />ਉਸ ਦੀ ਗੰਦਗੀ ਉਸ ਦੇ ਕੱਪੜਿਆਂ ਨਾਲ ਚਿਪਕ ਗਈ ਸੀ;</para>
  <para style="q2" vid="LAM 1:9">ਉਸ ਨੇ ਆਪਣੇ ਭਵਿੱਖ ਬਾਰੇ ਨਹੀਂ ਸੋਚਿਆ।</para>
  <para style="q1" vid="LAM 1:9">ਉਸਦਾ ਖਤਮ ਹੋਣਾ ਹੈਰਾਨ ਕਰਨ ਵਾਲਾ ਸੀ;</para>
  <para style="q2" vid="LAM 1:9">ਉਸ ਨੂੰ ਦਿਲਾਸਾ ਦੇਣ ਵਾਲਾ ਕੋਈ ਨਹੀਂ ਸੀ।</para>
  <para style="q1" vid="LAM 1:9">“ਹੇ ਯਾਹਵੇਹ! ਮੇਰੀ ਮੁਸੀਬਤ ਨੂੰ ਵੇਖ,</para>
  <para style="q2" vid="LAM 1:9">ਕਿਉਂਕਿ ਦੁਸ਼ਮਣ ਨੇ ਜਿੱਤ ਪ੍ਰਾਪਤ ਕੀਤੀ ਹੈ।”<verse eid="LAM 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10" />ਦੁਸ਼ਮਣ ਨੇ ਆਪਣਾ ਹੱਥ</para>
  <para style="q2" vid="LAM 1:10">ਉਸ ਦੇ ਸਾਰੇ ਖਜ਼ਾਨਿਆਂ ਉੱਤੇ ਵਧਾਇਆ;</para>
  <para style="q1" vid="LAM 1:10">ਉਸਨੇ ਮੂਰਤੀ-ਪੂਜਕ ਕੌਮਾਂ ਨੂੰ</para>
  <para style="q2" vid="LAM 1:10">ਉਸ ਦੇ ਪਵਿੱਤਰ ਸਥਾਨ ਵਿੱਚ ਦਾਖਲ ਹੁੰਦੇ ਵੇਖਿਆ</para>
  <para style="q1" vid="LAM 1:10">ਜਿਨ੍ਹਾਂ ਨੂੰ ਤੁਸੀਂ ਆਪਣੀ ਸਭਾ ਵਿੱਚ</para>
  <para style="q2" vid="LAM 1:10">ਦਾਖਲ ਹੋਣ ਤੋਂ ਮਨ੍ਹਾ ਕੀਤਾ ਸੀ।<verse eid="LAM 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11" />ਉਹ ਦੇ ਸਾਰੇ ਲੋਕ ਹਾਉਂਕੇ ਭਰਦੇ ਹਨ,</para>
  <para style="q2" vid="LAM 1:11">ਉਹ ਰੋਟੀ ਦੀ ਭਾਲ ਕਰਦੇ ਹਨ,</para>
  <para style="q1" vid="LAM 1:11">ਉਹਨਾਂ ਨੇ ਆਪਣੇ ਆਪ ਨੂੰ ਜਿੰਦਾ ਰੱਖਣ ਲਈ</para>
  <para style="q2" vid="LAM 1:11">ਭੋਜਨ ਲਈ ਆਪਣੇ ਖਜ਼ਾਨਿਆਂ ਨੂੰ ਵੇਚਿਆ।</para>
  <para style="q1" vid="LAM 1:11">“ਹੇ ਯਾਹਵੇਹ! ਵੇਖੋ ਅਤੇ ਵਿਚਾਰ ਕਰ,</para>
  <para style="q2" vid="LAM 1:11">ਕਿਉਂਕਿ ਮੈਂ ਤੁੱਛ ਹੋ ਗਈ ਹਾਂ।”<verse eid="LAM 1:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12" />“ਤੁਸੀਂ ਸਾਰੇ ਜਿਹੜੇ ਲੰਘਦੇ ਹੋ, ਕੀ ਇਹ ਤੁਹਾਡੇ ਲਈ ਕੁਝ ਨਹੀਂ ਹੈ?</para>
  <para style="q2" vid="LAM 1:12">ਆਲੇ-ਦੁਆਲੇ ਦੇਖੋ ਅਤੇ ਧਿਆਨ ਦਿਓ।</para>
  <para style="q1" vid="LAM 1:12">ਕੀ ਮੇਰੇ ਦੁੱਖ ਵਰਗਾ ਕੋਈ ਹੋਰ ਦੁੱਖ ਹੈ</para>
  <para style="q2" vid="LAM 1:12">ਜੋ ਮੇਰੇ ਉੱਤੇ ਆਇਆ,</para>
  <para style="q1" vid="LAM 1:12">ਜੋ ਯਾਹਵੇਹ ਨੇ ਆਪਣੇ ਭਿਆਨਕ ਕ੍ਰੋਧ ਦੇ ਦਿਨ</para>
  <para style="q2" vid="LAM 1:12">ਮੇਰੇ ਉੱਤੇ ਲਿਆਇਆ?<verse eid="LAM 1:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13" />“ਉਚਿਆਈ ਤੋਂ ਉਸਨੇ ਅੱਗ ਭੇਜੀ,</para>
  <para style="q2" vid="LAM 1:13">ਮੇਰੀਆਂ ਹੱਡੀਆਂ ਵਿੱਚ ਸੁੱਟ ਦਿੱਤੀ।</para>
  <para style="q1" vid="LAM 1:13">ਉਸ ਨੇ ਮੇਰੇ ਪੈਰਾਂ ਲਈ ਜਾਲ ਵਿਛਾਇਆ</para>
  <para style="q2" vid="LAM 1:13">ਅਤੇ ਮੈਨੂੰ ਮੋੜ ਦਿੱਤਾ।</para>
  <para style="q1" vid="LAM 1:13">ਉਸ ਨੇ ਮੈਨੂੰ ਉਜਾੜ ਦਿੱਤਾ,</para>
  <para style="q2" vid="LAM 1:13">ਮੈਂ ਸਾਰਾ ਦਿਨ ਰੋਗ ਨਾਲ ਨਿਰਬਲ ਰਹਿੰਦੀ ਹਾਂ।<verse eid="LAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14" />“ਮੇਰੇ ਪਾਪ ਨੇ ਮੇਰੇ ਲਈ ਜੂਲੇ ਬਣਾ ਦਿੱਤਾ ਹੈ;</para>
  <para style="q2" vid="LAM 1:14">ਉਸ ਦੇ ਹੱਥਾਂ ਨਾਲ ਇਕੱਠੇ ਬੰਨੇ ਹੋਏ ਹਨ।</para>
  <para style="q1" vid="LAM 1:14">ਉਹ ਮੇਰੀ ਗਰਦਨ ਉੱਤੇ ਟੰਗ ਦਿੱਤੇ ਗਏ ਹਨ,</para>
  <para style="q2" vid="LAM 1:14">ਅਤੇ ਯਾਹਵੇਹ ਨੇ ਮੇਰੀ ਤਾਕਤ ਨੂੰ ਛੁਪਾਇਆ ਹੈ।</para>
  <para style="q1" vid="LAM 1:14">ਉਸ ਨੇ ਮੈਨੂੰ ਉਹਨਾਂ ਦੇ ਹੱਥਾਂ ਵਿੱਚ ਸੌਂਪ ਦਿੱਤਾ ਹੈ</para>
  <para style="q2" vid="LAM 1:14">ਜਿਨ੍ਹਾਂ ਦਾ ਮੈਂ ਸਾਹਮਣਾ ਨਹੀਂ ਕਰ ਸਕਦਾ।<verse eid="LAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15" />“ਯਾਹਵੇਹ ਨੇ ਮੇਰੇ ਵਿੱਚ ਸਾਰੇ</para>
  <para style="q2" vid="LAM 1:15">ਯੋਧਿਆਂ ਨੂੰ ਰੱਦ ਕਰ ਦਿੱਤਾ ਹੈ;</para>
  <para style="q1" vid="LAM 1:15">ਉਸ ਨੇ ਮੇਰੇ ਜੁਆਨਾਂ ਨੂੰ ਕੁਚਲਣ ਲਈ</para>
  <para style="q2" vid="LAM 1:15">ਮੇਰੇ ਵਿਰੁੱਧ ਫ਼ੌਜ ਬੁਲਾਈ ਹੈ।</para>
  <para style="q1" vid="LAM 1:15">ਯਾਹਵੇਹ ਨੇ ਯਹੂਦਾਹ ਦੀ ਕੁਆਰੀ ਧੀ ਨੂੰ</para>
  <para style="q2" vid="LAM 1:15">ਜਾਣੋ ਹੌਦ ਵਿੱਚ ਮਿੱਧਿਆ ਹੈ।<verse eid="LAM 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16" />“ਇਸੇ ਕਰਕੇ ਮੈਂ ਰੋਂਦੀ ਹਾਂ</para>
  <para style="q2" vid="LAM 1:16">ਅਤੇ ਮੇਰੀਆਂ ਅੱਖਾਂ ਹੰਝੂਆਂ ਨਾਲ ਭਰ ਜਾਂਦੀਆਂ ਹਨ।</para>
  <para style="q1" vid="LAM 1:16">ਕਿਉਂ ਜੋ ਮੈਨੂੰ ਦਿਲਾਸਾ ਦੇਣ ਵਾਲਾ ਦੂਰ ਹੈ,</para>
  <para style="q2" vid="LAM 1:16">ਮੇਰੀ ਆਤਮਾ ਨੂੰ ਬਹਾਲ ਕਰਨ ਵਾਲਾ ਕੋਈ ਨਹੀਂ ਹੈ।</para>
  <para style="q1" vid="LAM 1:16">ਮੇਰੇ ਬੱਚੇ ਬੇਸਹਾਰਾ ਹਨ</para>
  <para style="q2" vid="LAM 1:16">ਕਿਉਂਕਿ ਦੁਸ਼ਮਣ ਨੇ ਜਿੱਤ ਪ੍ਰਾਪਤ ਕੀਤੀ ਹੈ।”<verse eid="LAM 1:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17" />ਸੀਯੋਨ ਨੇ ਆਪਣੇ ਹੱਥ ਫੈਲਾਏ ਹਨ,</para>
  <para style="q2" vid="LAM 1:17">ਪਰ ਉਸ ਨੂੰ ਦਿਲਾਸਾ ਦੇਣ ਵਾਲਾ ਕੋਈ ਨਹੀਂ ਹੈ।</para>
  <para style="q1" vid="LAM 1:17">ਯਾਹਵੇਹ ਨੇ ਯਾਕੋਬ ਲਈ ਹੁਕਮ ਦਿੱਤਾ ਹੈ</para>
  <para style="q2" vid="LAM 1:17">ਕਿ ਉਸਦੇ ਗੁਆਂਢੀ ਉਸਦੇ ਦੁਸ਼ਮਣ ਬਣ ਜਾਣ;</para>
  <para style="q1" vid="LAM 1:17">ਯੇਰੂਸ਼ਲੇਮ ਉਹਨਾਂ ਵਿੱਚ</para>
  <para style="q2" vid="LAM 1:17">ਇੱਕ ਅਸ਼ੁੱਧ ਵਸਤੂ ਵਾਂਗ ਬਣ ਗਿਆ ਹੈ।<verse eid="LAM 1:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18" />“ਯਾਹਵੇਹ ਧਰਮੀ ਹੈ,</para>
  <para style="q2" vid="LAM 1:18">ਫਿਰ ਵੀ ਮੈਂ ਉਸਦੇ ਹੁਕਮ ਦੇ ਵਿਰੁੱਧ ਬਗਾਵਤ ਕੀਤੀ।</para>
  <para style="q1" vid="LAM 1:18">ਹੁਣ ਹੇ ਸਾਰੇ ਲੋਕੋ ਇਹ ਸੁਣੋ;</para>
  <para style="q2" vid="LAM 1:18">ਮੇਰੇ ਦੁੱਖ ਨੂੰ ਵੇਖੋ,</para>
  <para style="q1" vid="LAM 1:18">ਮੇਰੇ ਜਵਾਨ ਅਤੇ ਮੁਟਿਆਰਾਂ</para>
  <para style="q2" vid="LAM 1:18">ਗ਼ੁਲਾਮੀ ਵਿੱਚ ਚਲੇ ਗਏ ਹਨ।<verse eid="LAM 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19" />“ਮੈਂ ਆਪਣੇ ਸਹਿਯੋਗੀਆਂ ਨੂੰ ਬੁਲਾਇਆ</para>
  <para style="q2" vid="LAM 1:19">ਪਰ ਉਹਨਾਂ ਨੇ ਮੈਨੂੰ ਧੋਖਾ ਦਿੱਤਾ।</para>
  <para style="q1" vid="LAM 1:19">ਮੇਰੇ ਜਾਜਕ ਅਤੇ ਮੇਰੇ ਬਜ਼ੁਰਗ</para>
  <para style="q2" vid="LAM 1:19">ਸ਼ਹਿਰ ਵਿੱਚ ਮਾਰੇ ਗਏ</para>
  <para style="q1" vid="LAM 1:19">ਜਦੋਂ ਉਹ ਆਪਣੇ ਆਪ ਨੂੰ ਜਿਉਂਦਾ ਰੱਖਣ ਲਈ</para>
  <para style="q2" vid="LAM 1:19">ਭੋਜਨ ਦੀ ਭਾਲ ਕਰਦੇ ਸਨ।<verse eid="LAM 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20" />“ਵੇਖੋ, ਯਾਹਵੇਹ, ਮੈਂ ਕਿੰਨਾ ਦੁਖੀ ਹਾਂ!</para>
  <para style="q2" vid="LAM 1:20">ਮੈਂ ਅੰਦਰੋਂ ਕਸ਼ਟ ਵਿੱਚ ਹਾਂ,</para>
  <para style="q1" vid="LAM 1:20">ਅਤੇ ਮੇਰੇ ਮਨ ਵਿੱਚ ਮੈਂ ਦੁਖੀ ਹਾਂ,</para>
  <para style="q2" vid="LAM 1:20">ਕਿਉਂ ਜੋ ਮੈਂ ਸਭ ਤੋਂ ਵੱਧ ਬਗਾਵਤ ਕੀਤੀ ਹਾਂ।</para>
  <para style="q1" vid="LAM 1:20">ਬਾਹਰ, ਤਲਵਾਰ ਸੋਗ ਕਰਦੀ ਹੈ;</para>
  <para style="q2" vid="LAM 1:20">ਅੰਦਰ, ਕੇਵਲ ਮੌਤ ਹੈ।<verse eid="LAM 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21" />“ਲੋਕਾਂ ਨੇ ਮੇਰੇ ਹਾਉਂਕੇ ਸੁਣੇ ਹਨ,</para>
  <para style="q2" vid="LAM 1:21">ਪਰ ਮੈਨੂੰ ਦਿਲਾਸਾ ਦੇਣ ਵਾਲਾ ਕੋਈ ਨਹੀਂ ਹੈ।</para>
  <para style="q1" vid="LAM 1:21">ਮੇਰੇ ਸਾਰੇ ਵੈਰੀਆਂ ਨੇ ਮੇਰੀ ਬਿਪਤਾ ਬਾਰੇ ਸੁਣਿਆ ਹੈ;</para>
  <para style="q2" vid="LAM 1:21">ਉਹ ਖੁਸ਼ ਹਨ ਕਿ ਤੂੰ ਇਹ ਕੀਤਾ ਹੈ।</para>
  <para style="q1" vid="LAM 1:21">ਤੁਸੀਂ ਉਹ ਦਿਨ ਲਿਆਓ ਜਿਸਦਾ ਤੁਸੀਂ ਐਲਾਨ ਕੀਤਾ ਹੈ</para>
  <para style="q2" vid="LAM 1:21">ਤਾਂ ਜੋ ਉਹ ਮੇਰੇ ਵਰਗੇ ਬਣ ਜਾਣ।<verse eid="LAM 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22" />“ਉਨ੍ਹਾਂ ਦੀ ਸਾਰੀ ਬੁਰਿਆਈ ਤੇਰੇ ਸਾਹਮਣੇ ਆਵੇ,</para>
  <para style="q2" vid="LAM 1:22">ਉਨ੍ਹਾਂ ਨਾਲ ਉਸੇ ਤਰ੍ਹਾਂ ਹੀ ਕਰ</para>
  <para style="q1" vid="LAM 1:22">ਜਿਵੇਂ ਤੂੰ ਮੇਰੇ ਨਾਲ ਮੇਰੇ ਸਾਰੇ ਅਪਰਾਧਾਂ ਦੇ ਕਾਰਨ ਕੀਤਾ ਹੈ,</para>
  <para style="q1" vid="LAM 1:22">ਕਿਉਂ ਜੋ ਮੈਂ ਬਹੁਤ ਹਾਉਂਕੇ ਭਰਦੀ ਹਾਂ,</para>
  <para style="q2" vid="LAM 1:22">ਅਤੇ ਮੇਰਾ ਦਿਲ ਨਿਰਬਲ ਹੋ ਗਿਆ ਹੈ।”<verse eid="LAM 1:22" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1" />ਕਿਵੇਂ ਯਾਹਵੇਹ ਨੇ ਸੀਯੋਨ ਧੀ ਨੂੰ</para>
  <para style="q2" vid="LAM 2:1">ਆਪਣੇ ਕ੍ਰੋਧ ਦੇ ਬੱਦਲ ਨਾਲ ਢੱਕਿਆ ਹੈ!</para>
  <para style="q1" vid="LAM 2:1">ਉਸ ਨੇ ਇਸਰਾਏਲ ਦੀ ਸ਼ਾਨ ਨੂੰ</para>
  <para style="q2" vid="LAM 2:1">ਅਕਾਸ਼ ਤੋਂ ਧਰਤੀ ਉੱਤੇ ਸੁੱਟ ਦਿੱਤਾ ਹੈ।</para>
  <para style="q1" vid="LAM 2:1">ਉਸ ਨੇ ਆਪਣੇ ਕ੍ਰੋਧ ਦੇ ਦਿਨ ਵਿੱਚ</para>
  <para style="q2" vid="LAM 2:1">ਆਪਣੇ ਪੈਰਾਂ ਦੀ ਚੌਂਕੀ ਨੂੰ ਚੇਤੇ ਨਹੀਂ ਕੀਤਾ।<verse eid="LAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2" />ਬਿਨਾਂ ਤਰਸ ਦੇ ਯਾਹਵੇਹ ਨੇ</para>
  <para style="q2" vid="LAM 2:2">ਯਾਕੋਬ ਦੇ ਸਾਰੇ ਨਿਵਾਸਾਂ ਨੂੰ ਨਿਗਲ ਲਿਆ ਹੈ;</para>
  <para style="q1" vid="LAM 2:2">ਆਪਣੇ ਕ੍ਰੋਧ ਵਿੱਚ ਉਸ ਨੇ</para>
  <para style="q2" vid="LAM 2:2">ਯਹੂਦਾਹ ਦੀ ਧੀ ਦੇ ਗੜ੍ਹਾਂ ਨੂੰ ਢਾਹ ਦਿੱਤਾ ਹੈ।</para>
  <para style="q1" vid="LAM 2:2">ਉਸ ਨੇ ਉਹ ਦੇ ਰਾਜ ਅਤੇ ਉਸ ਦੇ ਸਰਦਾਰਾਂ ਨੂੰ ਬੇਇੱਜ਼ਤ ਕਰਕੇ</para>
  <para style="q2" vid="LAM 2:2">ਮਿੱਟੀ ਵਿੱਚ ਮਿਲਾ ਦਿੱਤਾ।<verse eid="LAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3" />ਉਸ ਨੇ ਆਪਣੇ ਭੜਕਦੇ ਹੋਏ ਕ੍ਰੋਧ ਵਿੱਚ</para>
  <para style="q2" vid="LAM 2:3">ਇਸਰਾਏਲ ਦੇ ਹਰੇਕ ਸਿੰਗ<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="fq" closed="false">ਸਿੰਗ </char><char style="ft" closed="false">ਅਰਥਾਤ </char><char style="fqa" closed="false">ਤਾਕਤ</char></note> ਨੂੰ ਵੱਢ ਸੁੱਟਿਆ ਹੈ।</para>
  <para style="q1" vid="LAM 2:3">ਉਸ ਨੇ ਦੁਸ਼ਮਣ ਦੇ ਸਾਹਮਣੇ ਉਹਨਾਂ ਦੀ ਸਹਾਇਤਾ ਕਰਨ ਤੋਂ</para>
  <para style="q2" vid="LAM 2:3">ਆਪਣਾ ਸੱਜਾ ਹੱਥ ਪਿੱਛੇ ਖਿੱਚ ਲਿਆ।</para>
  <para style="q1" vid="LAM 2:3">ਉਹ ਯਾਕੋਬ ਵਿੱਚ ਬਲਦੀ ਅੱਗ ਵਾਂਗ ਭੜਕਿਆਂ</para>
  <para style="q2" vid="LAM 2:3">ਜੋ ਉਸਦੇ ਆਲੇ-ਦੁਆਲੇ ਦੀ ਹਰ ਚੀਜ਼ ਨੂੰ ਭਸਮ ਕਰ ਦਿੰਦੀ ਹੈ।<verse eid="LAM 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4" />ਦੁਸ਼ਮਣ ਦੀ ਤਰ੍ਹਾਂ ਉਸ ਨੇ ਆਪਣਾ ਧਣੁੱਖ ਖਿੱਚਿਆ;</para>
  <para style="q2" vid="LAM 2:4">ਅਤੇ ਵਿਰੋਧੀ ਦੀ ਤਰ੍ਹਾਂ ਆਪਣਾ ਸੱਜਾ ਹੱਥ ਚੁੱਕਿਆ ਹੈ,</para>
  <para style="q1" vid="LAM 2:4">ਉਸ ਨੇ ਵੈਰੀ ਵਾਂਗੂੰ ਉਹਨਾਂ ਸਾਰਿਆਂ ਨੂੰ ਮਾਰ ਸੁੱਟਿਆ</para>
  <para style="q2" vid="LAM 2:4">ਜੋ ਅੱਖਾਂ ਨੂੰ ਚੰਗੇ ਲੱਗਦਾ ਸੀ।</para>
  <para style="q1" vid="LAM 2:4">ਉਸ ਨੇ ਆਪਣਾ ਕ੍ਰੋਧ ਅੱਗ ਵਾਂਗੂੰ</para>
  <para style="q2" vid="LAM 2:4">ਸੀਯੋਨ ਧੀ ਦੇ ਤੰਬੂ ਉੱਤੇ ਡੋਲ੍ਹਿਆ ਹੈ।<verse eid="LAM 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5" />ਯਾਹਵੇਹ ਵੈਰੀ ਵਰਗਾ ਹੋ ਗਿਆ;</para>
  <para style="q2" vid="LAM 2:5">ਉਸ ਨੇ ਇਸਰਾਏਲ ਨੂੰ ਨਿਗਲ ਲਿਆ;</para>
  <para style="q1" vid="LAM 2:5">ਉਸ ਨੇ ਉਸ ਦੇ ਸਾਰੇ ਮਹਿਲ ਨਿਗਲ ਲਏ</para>
  <para style="q2" vid="LAM 2:5">ਅਤੇ ਉਸ ਦੇ ਗੜ੍ਹਾਂ ਨੂੰ ਤਬਾਹ ਕਰ ਦਿੱਤਾ ਹੈ।</para>
  <para style="q1" vid="LAM 2:5">ਉਸ ਨੇ ਯਹੂਦਾਹ ਦੀ ਧੀ ਲਈ ਸੋਗ</para>
  <para style="q2" vid="LAM 2:5">ਅਤੇ ਵਿਰਲਾਪ ਵਧਾਇਆ ਹੈ।<verse eid="LAM 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6" />ਉਸ ਨੇ ਆਪਣੇ ਨਿਵਾਸ ਨੂੰ ਬਾਗ ਵਾਂਗ ਉਜਾੜ ਦਿੱਤਾ ਹੈ;</para>
  <para style="q2" vid="LAM 2:6">ਉਸ ਨੇ ਆਪਣੇ ਮਿਲਣ ਦੀ ਥਾਂ ਨੂੰ ਤਬਾਹ ਕਰ ਦਿੱਤਾ ਹੈ।</para>
  <para style="q1" vid="LAM 2:6">ਯਾਹਵੇਹ ਨੇ ਸੀਯੋਨ ਨੂੰ ਆਪਣੇ ਠਹਿਰਾਏ ਹੋਏ</para>
  <para style="q2" vid="LAM 2:6">ਤਿਉਹਾਰਾਂ ਅਤੇ ਸਬਤਾਂ ਨੂੰ ਭੁੱਲਾ ਦਿੱਤਾ ਹੈ;</para>
  <para style="q1" vid="LAM 2:6">ਆਪਣੇ ਭਿਆਨਕ ਕ੍ਰੋਧ ਵਿੱਚ ਉਸਨੇ ਰਾਜੇ ਅਤੇ ਪੁਜਾਰੀ ਦੋਹਾਂ ਨੂੰ ਤਿਆਗ ਦਿੱਤਾ।</para>
  <para style="b" vid="LAM 2:6" />
  <para style="q1" vid="LAM 2:6">ਯਾਹਵੇਹ ਨੇ ਆਪਣੀ ਜਗਵੇਦੀ ਨੂੰ ਰੱਦ ਕਰ ਦਿੱਤਾ ਹੈ ਅਤੇ ਆਪਣੇ ਪਵਿੱਤਰ ਸਥਾਨ ਨੂੰ ਤਿਆਗ ਦਿੱਤਾ ਹੈ।</para>
  <para style="q1" vid="LAM 2:6">ਉਸ ਨੇ ਆਪਣੇ ਮਹਿਲਾਂ ਦੀਆਂ ਕੰਧਾਂ ਵੈਰੀਆਂ ਦੇ ਹੱਥ ਵਿੱਚ ਦੇ ਦਿੱਤੀਆਂ ਹਨ।</para>
  <para style="q1" vid="LAM 2:6">ਉਹਨਾਂ ਨੇ ਯਾਹਵੇਹ ਦੇ ਭਵਨ ਵਿੱਚ ਇੱਕ ਖਾਸ ਤਿਉਹਾਰ ਦੇ ਦਿਨ ਜੈਕਾਰਾ ਗਜਾਇਆ।<verse eid="LAM 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7" />ਯਾਹਵੇਹ ਨੇ ਆਪਣੀ ਜਗਵੇਦੀ ਨੂੰ ਰੱਦ ਕਰ ਦਿੱਤਾ ਹੈ</para>
  <para style="q2" vid="LAM 2:7">ਅਤੇ ਆਪਣੇ ਪਵਿੱਤਰ ਸਥਾਨ ਨੂੰ ਤਿਆਗ ਦਿੱਤਾ ਹੈ।</para>
  <para style="q1" vid="LAM 2:7">ਉਸ ਨੇ ਆਪਣੇ ਮਹਿਲਾਂ ਦੀਆਂ ਕੰਧਾਂ ਨੂੰ</para>
  <para style="q2" vid="LAM 2:7">ਦੁਸ਼ਮਣ ਦੇ ਹੱਥਾਂ ਵਿੱਚ ਦੇ ਦਿੱਤਾ ਹੈ।</para>
  <para style="q1" vid="LAM 2:7">ਉਹਨਾਂ ਨੇ ਯਾਹਵੇਹ ਦੇ ਭਵਨ ਵਿੱਚ ਅਜਿਹਾ ਰੌਲ਼ਾ ਪਾਇਆ,</para>
  <para style="q2" vid="LAM 2:7">ਜਿਵੇਂ ਪਰਬ ਦੇ ਦਿਨ ਵਿੱਚ ਹੁੰਦਾ ਹੈ।<verse eid="LAM 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8" />ਯਾਹਵੇਹ ਨੇ ਸੀਯੋਨ ਦੀ ਧੀ ਦੀ ਸ਼ਹਿਰਪਨਾਹ ਨੂੰ ਢਾਹੁਣ ਲਈ ਪੱਕਾ ਇਰਾਦਾ ਕਰ ਲਿਆ,</para>
  <para style="q2" vid="LAM 2:8">ਉਸ ਨੇ ਮਾਪ ਦੀ ਡੋਰੀ ਖਿੱਚੀ। ਉਸ ਨੇ ਆਪਣਾ ਹੱਥ ਨਾਸ ਕਰਨ ਤੋਂ ਨਾ ਹਟਾਇਆ,</para>
  <para style="q1" vid="LAM 2:8">ਉਸ ਨੇ ਕਿਲ੍ਹੇ ਅਤੇ ਸ਼ਹਿਰਪਨਾਹ ਦੋਵਾਂ ਤੋਂ ਵਿਰਲਾਪ ਕਰਾਇਆ,</para>
  <para style="q2" vid="LAM 2:8">ਉਹ ਦੋਵੇਂ ਇਕੱਠੇ ਬਰਬਾਦ ਹੋ ਗਏ।<verse eid="LAM 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9" />ਉਸਦੇ ਦਰਵਾਜ਼ੇ ਜ਼ਮੀਨ ਵਿੱਚ ਧੱਸ ਗਏ ਹਨ;</para>
  <para style="q2" vid="LAM 2:9">ਉਹਨਾਂ ਦੀਆਂ ਪੱਟੀਆਂ ਉਸ ਨੇ ਤੋੜ ਦਿੱਤੀਆਂ ਅਤੇ ਨਸ਼ਟ ਕਰ ਦਿੱਤੀਆਂ।</para>
  <para style="q1" vid="LAM 2:9">ਉਸ ਦੇ ਰਾਜੇ ਅਤੇ ਉਸ ਦੇ ਸਰਦਾਰ ਕੌਮਾਂ ਵਿੱਚ ਗ਼ੁਲਾਮ ਹਨ,</para>
  <para style="q2" vid="LAM 2:9">ਜਿੱਥੇ ਕੋਈ ਬਿਵਸਥਾ ਨਹੀਂ ਹੈ,</para>
  <para style="q1" vid="LAM 2:9">ਅਤੇ ਉਸ ਦੇ ਨਬੀਆਂ ਨੂੰ</para>
  <para style="q2" vid="LAM 2:9">ਯਾਹਵੇਹ ਦੇ ਦਰਸ਼ਣ ਨਹੀਂ ਮਿਲਦੇ।<verse eid="LAM 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10" />ਸੀਯੋਨ ਦੀ ਧੀ ਦੇ ਬਜ਼ੁਰਗ</para>
  <para style="q2" vid="LAM 2:10">ਚੁੱਪ ਹੀ ਜ਼ਮੀਨ ਉੱਤੇ ਬੈਠੇ ਹਨ;</para>
  <para style="q1" vid="LAM 2:10">ਉਹਨਾਂ ਨੇ ਆਪਣੇ ਸਿਰਾਂ ਉੱਤੇ ਮਿੱਟੀ ਛਿੜਕੀ ਹੈ</para>
  <para style="q2" vid="LAM 2:10">ਅਤੇ ਤੱਪੜ ਪਾ ਲਿਆ ਹੈ।</para>
  <para style="q1" vid="LAM 2:10">ਯੇਰੂਸ਼ਲੇਮ ਦੀਆਂ ਮੁਟਿਆਰਾਂ ਨੇ ਆਪਣੇ ਸਿਰ ਜ਼ਮੀਨ ਵੱਲ ਝੁਕਾ ਲਏ ਹਨ।<verse eid="LAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11" />ਮੇਰੀਆਂ ਅੱਖਾਂ ਰੋ-ਰੋ ਕੇ ਧੁੰਦਲੀਆਂ ਹੋ ਗਈਆਂ ਹਨ,</para>
  <para style="q2" vid="LAM 2:11">ਮੈਂ ਅੰਦਰੋਂ ਦੁਖੀ ਹਾਂ;</para>
  <para style="q1" vid="LAM 2:11">ਮੇਰਾ ਦਿਲ ਜ਼ਮੀਨ ਤੇ ਡੋਲ੍ਹਿਆ ਗਿਆ ਹੈ</para>
  <para style="q2" vid="LAM 2:11">ਕਿਉਂਕਿ ਮੇਰੇ ਲੋਕ ਤਬਾਹ ਹੋ ਗਏ ਹਨ,</para>
  <para style="q1" vid="LAM 2:11">ਕਿਉਂਕਿ ਨਿਆਣੇ ਅਤੇ ਦੁੱਧ ਚੁੰਘਦੇ ਬੱਚੇ</para>
  <para style="q2" vid="LAM 2:11">ਸ਼ਹਿਰ ਦੀਆਂ ਗਲੀਆਂ ਵਿੱਚ ਬੇਹੋਸ਼ ਪਏ ਹਨ।<verse eid="LAM 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12" />ਉਹ ਆਪਣੀਆਂ ਮਾਵਾਂ ਨੂੰ ਪੁੱਛਦੇ ਹਨ,</para>
  <para style="q2" vid="LAM 2:12">“ਰੋਟੀ ਅਤੇ ਦਾਖ਼ਰਸ ਕਿੱਥੇ ਹੈ?”</para>
  <para style="q1" vid="LAM 2:12">ਉਹ ਸ਼ਹਿਰ ਦੀਆਂ ਗਲੀਆਂ ਵਿੱਚ</para>
  <para style="q2" vid="LAM 2:12">ਜ਼ਖਮੀ ਮਨੁੱਖ ਵਾਗੂੰ ਬੇਸੁਰਤ ਹੋ ਕੇ,</para>
  <para style="q1" vid="LAM 2:12">ਆਪਣੀਆਂ ਮਾਵਾਂ ਦੀ ਗੋਦ ਵਿੱਚ</para>
  <para style="q2" vid="LAM 2:12">ਆਪਣੇ ਪ੍ਰਾਣ ਛੱਡ ਦਿੰਦੇ ਹਨ।<verse eid="LAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13" />ਹੇ ਯੇਰੂਸ਼ਲੇਮ ਦੀਏ ਧੀਏ?</para>
  <para style="q2" vid="LAM 2:13">ਮੈਂ ਤੇਰੇ ਲਈ ਕੀ ਕਹਿ ਸਕਦਾ ਹਾਂ?</para>
  <para style="q2" vid="LAM 2:13">ਮੈਂ ਤੇਰੀ ਤੁਲਨਾ ਕਿਸ ਨਾਲ ਕਰ ਸਕਦਾ ਹਾਂ,</para>
  <para style="q1" vid="LAM 2:13">ਮੈਂ ਤੈਨੂੰ ਕਿਸ ਦੇ ਵਰਗੀ ਆਖਾਂ,</para>
  <para style="q2" vid="LAM 2:13">ਤਾਂ ਜੋ ਮੈਂ ਤੈਨੂੰ ਦਿਲਾਸਾ ਦੇਵਾਂ,</para>
  <para style="q2" vid="LAM 2:13">ਹੇ ਸੀਯੋਨ ਦੀ ਕੁਆਰੀ ਧੀਏ?</para>
  <para style="q1" vid="LAM 2:13">ਤੇਰਾ ਜ਼ਖਮ ਸਮੁੰਦਰ ਜਿੰਨਾ ਡੂੰਘਾ ਹੈ।</para>
  <para style="q2" vid="LAM 2:13">ਤੈਨੂੰ ਕੌਣ ਚੰਗਾ ਕਰ ਸਕਦਾ ਹੈ?<verse eid="LAM 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14" />ਤੇਰੇ ਨਬੀਆਂ ਦੇ ਦਰਸ਼ਨ</para>
  <para style="q2" vid="LAM 2:14">ਝੂਠੇ ਅਤੇ ਵਿਅਰਥ ਸਨ;</para>
  <para style="q1" vid="LAM 2:14">ਉਹਨਾਂ ਨੇ ਤੇਰੀ ਗ਼ੁਲਾਮੀ ਤੋਂ ਛੁਟਕਾਰਾ ਪਾਉਣ ਲਈ</para>
  <para style="q2" vid="LAM 2:14">ਉਹਨਾਂ ਨੇ ਤੇਰੇ ਪਾਪਾਂ ਨੂੰ ਪਰਗਟ ਨਾ ਕੀਤਾ।</para>
  <para style="q1" vid="LAM 2:14">ਜਿਹੜੀਆਂ ਭਵਿੱਖਬਾਣੀਆਂ ਉਹਨਾਂ ਨੇ ਤੇਰੇ ਲਈ ਕੀਤੀਆਂ</para>
  <para style="q2" vid="LAM 2:14">ਝੂਠੀਆਂ ਅਤੇ ਭਰਮਾਉਣ ਵਾਲੀਆਂ ਸਨ।<verse eid="LAM 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15" />ਸਾਰੇ ਜੋ ਤੇਰੇ ਰਾਹ ਤੋਂ ਲੰਘਦੇ ਹਨ</para>
  <para style="q2" vid="LAM 2:15">ਤੇਰੇ ਤੇ ਤਾੜੀਆਂ ਵਜਾਉਂਦੇ ਹਨ;</para>
  <para style="q1" vid="LAM 2:15">ਉਹ ਯੇਰੂਸ਼ਲੇਮ ਦੀ ਧੀ ਦਾ ਮਜ਼ਾਕ ਉਡਾਉਂਦੇ</para>
  <para style="q2" vid="LAM 2:15">ਅਤੇ ਸਿਰ ਹਿਲਾਉਂਦੇ ਅਤੇ ਆਖਦੇ ਹਨ:</para>
  <para style="q1" vid="LAM 2:15">“ਕੀ ਇਹ ਉਹੋ ਸ਼ਹਿਰ ਹੈ,</para>
  <para style="q2" vid="LAM 2:15">ਜਿਸ ਨੂੰ ਉਹ ਇਹ ਸੁੰਦਰਤਾ ਦਾ ਨਾਮ ਦਿੰਦੇ ਸਨ,</para>
  <para style="q2" vid="LAM 2:15">ਅਤੇ ਆਖਦੇ ਸਨ ਕਿ ਇਹ ਸ਼ਹਿਰ ਸਾਰੀ ਧਰਤੀ ਦੀ ਖੁਸ਼ੀ ਸੀ?”<verse eid="LAM 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16" />ਤੇਰੇ ਸਾਰੇ ਦੁਸ਼ਮਣ ਤੇਰੇ ਵਿਰੁੱਧ</para>
  <para style="q2" vid="LAM 2:16">ਆਪਣੇ ਮੂੰਹ ਖੋਲ੍ਹਦੇ ਹਨ;</para>
  <para style="q1" vid="LAM 2:16">ਉਹ ਮਜ਼ਾਕ ਉਡਾਉਂਦੇ ਹਨ ਅਤੇ ਦੰਦ ਪੀਸਦੇ ਹਨ</para>
  <para style="q2" vid="LAM 2:16">ਅਤੇ ਆਖਦੇ ਹਨ, “ਅਸੀਂ ਉਸ ਨੂੰ ਨਿਗਲ ਲਿਆ ਹੈ।</para>
  <para style="q1" vid="LAM 2:16">ਇਹ ਉਹ ਦਿਨ ਹੈ ਜਿਸ ਦਾ ਅਸੀਂ ਇੰਤਜ਼ਾਰ ਕੀਤਾ ਹੈ;</para>
  <para style="q2" vid="LAM 2:16">ਅਸੀਂ ਇਸ ਨੂੰ ਦੇਖਣ ਲਈ ਜਿਉਂਦੇ ਰਹੇ ਹਾਂ।”<verse eid="LAM 2:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17" />ਯਾਹਵੇਹ ਨੇ ਉਹੀ ਕੀਤਾ ਹੈ ਜੋ ਉਸਨੇ ਯੋਜਨਾ ਬਣਾਈ ਸੀ;</para>
  <para style="q2" vid="LAM 2:17">ਉਸ ਨੇ ਆਪਣਾ ਬਚਨ ਪੂਰਾ ਕੀਤਾ ਹੈ,</para>
  <para style="q2" vid="LAM 2:17">ਜਿਸਦਾ ਉਸਨੇ ਬਹੁਤ ਸਮਾਂ ਪਹਿਲਾਂ ਹੁਕਮ ਦਿੱਤਾ ਸੀ।</para>
  <para style="q1" vid="LAM 2:17">ਉਸ ਨੇ ਤੈਨੂੰ ਬਿਨਾਂ ਤਰਸ ਕੀਤੇ ਉਖਾੜ ਦਿੱਤਾ ਹੈ,</para>
  <para style="q2" vid="LAM 2:17">ਉਸ ਨੇ ਤੇਰੇ ਉੱਤੇ ਵੈਰੀ ਨੂੰ ਖੁਸ਼ ਕਰਨ ਦਿੱਤਾ ਹੈ,</para>
  <para style="q2" vid="LAM 2:17">ਉਸ ਨੇ ਤੇਰੇ ਦੁਸ਼ਮਣਾਂ ਦੇ ਸਿੰਗ ਨੂੰ ਉੱਚਾ ਕੀਤਾ ਹੈ।<verse eid="LAM 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18" />ਲੋਕਾਂ ਦੇ ਦਿਲ</para>
  <para style="q2" vid="LAM 2:18">ਯਾਹਵੇਹ ਅੱਗੇ ਪੁਕਾਰਦੇ ਹਨ।</para>
  <para style="q1" vid="LAM 2:18">ਹੇ ਸੀਯੋਨ ਦੀ ਧੀ ਦੀਆ ਕੰਧਾਂ,</para>
  <para style="q2" vid="LAM 2:18">ਦਿਨ ਰਾਤ</para>
  <para style="q2" vid="LAM 2:18">ਤੇਰੇ ਹੰਝੂ ਨਦੀ ਵਾਂਗ ਵਗਦੇ ਰਹਿਣ,</para>
  <para style="q1" vid="LAM 2:18">ਆਪਣੇ ਆਪ ਨੂੰ ਕੋਈ ਅਰਾਮ ਕਰਨ ਨਾ ਦੇ</para>
  <para style="q2" vid="LAM 2:18">ਨਾ ਤੇਰੀਆਂ ਅੱਖਾਂ ਚੈਨ ਕਰਨ।<verse eid="LAM 2:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19" />ਉੱਠ, ਰਾਤ ਦੇ ਹਰੇਕ ਪਹਿਰ ਦੇ ਅਰੰਭ ਵਿੱਚ ਚਿੱਲਾ,</para>
  <para style="q2" vid="LAM 2:19">ਆਪਣੇ ਦਿਲ ਨੂੰ ਪਾਣੀ ਵਾਂਗ</para>
  <para style="q1" vid="LAM 2:19">ਪਰਮੇਸ਼ਵਰ ਦੀ ਹਜ਼ੂਰੀ ਵਿੱਚ ਡੋਲ ਦੇ।</para>
  <para style="q2" vid="LAM 2:19">ਆਪਣੇ ਬੱਚਿਆਂ ਦੀ ਜਾਨ ਦੀ ਖ਼ਾਤਰ</para>
  <para style="q1" vid="LAM 2:19">ਉਸ ਦੀ ਵੱਲ ਆਪਣੇ ਹੱਥਾਂ ਨੂੰ ਫੈਲਾ,</para>
  <para style="q2" vid="LAM 2:19">ਜਿਹੜੇ ਭੁੱਖ ਦੇ ਮਾਰੇ ਸਾਰੀਆਂ ਗਲੀਆਂ ਦੇ ਵਿੱਚ ਬੇਹੋਸ਼ ਪਏ ਹਨ।<verse eid="LAM 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20" />“ਹੇ ਯਾਹਵੇਹ, ਵੇਖ! ਅਤੇ ਧਿਆਨ ਦੇ:</para>
  <para style="q2" vid="LAM 2:20">ਕਿ ਤੂੰ ਅਜਿਹਾ ਦੁੱਖ ਕਿਸਨੂੰ ਦਿੱਤਾ ਹੈ?</para>
  <para style="q1" vid="LAM 2:20">ਕੀ ਇਸਤਰੀਆਂ ਆਪਣਾ ਫਲ,</para>
  <para style="q2" vid="LAM 2:20">ਅਰਥਾਤ ਆਪਣੇ ਲਾਡਲੇ ਬੱਚਿਆਂ ਨੂੰ ਖਾਣ?</para>
  <para style="q1" vid="LAM 2:20">ਹੇ ਯਾਹਵੇਹ, ਜਾਜਕ ਅਤੇ ਨਬੀ ਨੂੰ ਪਰਮੇਸ਼ਵਰ ਦੇ ਪਵਿੱਤਰ ਅਸਥਾਨ ਵਿੱਚ</para>
  <para style="q2" vid="LAM 2:20">ਮਾਰਿਆ ਜਾਣਾ ਚਾਹੀਦਾ ਹੈ?<verse eid="LAM 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21" />“ਜਵਾਨ ਅਤੇ ਬੁੱਢੇ</para>
  <para style="q2" vid="LAM 2:21">ਗਲੀਆਂ ਦੀ ਧੂੜ ਵਿੱਚ ਇਕੱਠੇ ਪਏ ਹਨ;</para>
  <para style="q1" vid="LAM 2:21">ਮੇਰੇ ਜੁਆਨ ਅਤੇ ਮੁਟਿਆਰਾਂ</para>
  <para style="q2" vid="LAM 2:21">ਤਲਵਾਰ ਨਾਲ ਡਿੱਗ ਪਏ ਹਨ।</para>
  <para style="q1" vid="LAM 2:21">ਤੂੰ ਆਪਣੇ ਕ੍ਰੋਧ ਦੇ ਦਿਨ ਉਹਨਾਂ ਨੂੰ ਮਾਰ ਸੁੱਟਿਆ।</para>
  <para style="q2" vid="LAM 2:21">ਤੁਸੀਂ ਉਹਨਾਂ ਨੂੰ ਬਿਨਾਂ ਤਰਸ ਕੀਤੇ ਵੱਢ ਸੁੱਟਿਆ ਹੈ।<verse eid="LAM 2:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22" />“ਤੂੰ ਤਿਉਹਾਰ ਦੇ ਦਿਨ ਨੂੰ ਬੁਲਾਉਂਦੇ ਹੋ,</para>
  <para style="q2" vid="LAM 2:22">ਇਸ ਤਰ੍ਹਾਂ ਤੂੰ ਮੇਰੇ ਵਿਰੁੱਧ ਹਰ ਪਾਸਿਓਂ ਦਹਿਸ਼ਤ ਨੂੰ ਬੁਲਾਇਆ ਸੀ।</para>
  <para style="q1" vid="LAM 2:22">ਯਾਹਵੇਹ ਦੇ ਕ੍ਰੋਧ ਦੇ ਦਿਨ</para>
  <para style="q2" vid="LAM 2:22">ਨਾ ਕੋਈ ਫਰਾਰ ਹੋ ਸਕਿਆ ਅਤੇ ਨਾ ਹੀ ਬਚ ਸਕਿਆ;</para>
  <para style="q1" vid="LAM 2:22">ਜਿਨ੍ਹਾਂ ਦੀ ਮੈਂ ਦੇਖਭਾਲ ਕੀਤੀ ਅਤੇ ਪਾਲਿਆ</para>
  <para style="q2" vid="LAM 2:22">ਮੇਰੇ ਦੁਸ਼ਮਣ ਨੇ ਤਬਾਹ ਕਰ ਦਿੱਤਾ ਹੈ।”<verse eid="LAM 2:22" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1" />ਮੈਂ ਉਹ ਆਦਮੀ ਹਾਂ</para>
  <para style="q2" vid="LAM 3:1">ਜਿਸਨੇ ਯਾਹਵੇਹ ਦੇ ਕ੍ਰੋਧ ਦੇ ਡੰਡੇ ਦੁਆਰਾ ਦੁੱਖਾਂ ਨੂੰ ਦੇਖਿਆ ਹੈ।<verse eid="LAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2" />ਉਸ ਨੇ ਮੈਨੂੰ ਤਿਆਗ ਦਿੱਤਾ</para>
  <para style="q2" vid="LAM 3:2">ਅਤੇ ਮੈ ਚਾਨਣ ਦੀ ਬਜਾਏ ਹਨੇਰੇ ਵਿੱਚ ਚਲਾਇਆ।<verse eid="LAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3" />ਸੱਚ-ਮੁੱਚ, ਦਿਨ ਭਰ</para>
  <para style="q2" vid="LAM 3:3">ਉਸ ਦਾ ਕਠੋਰ ਹੱਥ ਮੇਰੇ ਵਿਰੁੱਧ ਸਰਗਰਮ ਰਹਿੰਦਾ ਹੈ।<verse eid="LAM 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4" />ਉਸ ਨੇ ਮੇਰੇ ਮਾਸ ਅਤੇ ਚਮੜੀ ਨੂੰ ਸੁਕਾ ਦਿੱਤਾ,</para>
  <para style="q2" vid="LAM 3:4">ਅਤੇ ਮੇਰੀਆਂ ਹੱਡੀਆਂ ਨੂੰ ਤੋੜ ਦਿੱਤਾ ਹੈ।<verse eid="LAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5" />ਉਸ ਨੇ ਮੈਨੂੰ ਘੇਰ ਲਿਆ ਹੈ</para>
  <para style="q2" vid="LAM 3:5">ਅਤੇ ਕੁੜੱਤਣ ਅਤੇ ਤੰਗੀ ਨਾਲ ਮੈਨੂੰ ਘੇਰ ਲਿਆ ਹੈ।<verse eid="LAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6" />ਉਨ੍ਹਾਂ ਨੇ ਮੈਨੂੰ ਹਨੇਰੇ ਵਿੱਚ ਰਹਿਣ ਲਈ ਛੱਡ ਦਿੱਤਾ ਹੈ</para>
  <para style="q2" vid="LAM 3:6">ਜਿਵੇਂ ਕਿ ਮੈਂ ਲੰਬੇ ਸਮੇਂ ਤੋਂ ਮਰਿਆ ਹੋਇਆ ਸੀ।<verse eid="LAM 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7" />ਉਸ ਨੇ ਮੇਰੇ ਦੁਆਲੇ ਕੰਧ ਬਣਾ ਦਿੱਤੀ ਕਿ ਮੈਂ ਬਾਹਰ ਨਾ ਨਿੱਕਲ ਸਕਾ;</para>
  <para style="q2" vid="LAM 3:7">ਉਸ ਨੇ ਮੇਰੀਆਂ ਜੰਜ਼ੀਰਾਂ ਭਾਰੀਆਂ ਕਰ ਦਿੱਤੀਆਂ।<verse eid="LAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8" />ਜਦੋਂ ਮੈਂ ਪੁਕਾਰਦਾ ਹਾਂ ਜਾਂ ਮਦਦ ਲਈ ਦੁਹਾਈ ਦਿੰਦਾ ਹਾਂ,</para>
  <para style="q2" vid="LAM 3:8">ਉਹ ਮੇਰੀ ਪ੍ਰਾਰਥਨਾ ਨੂੰ ਰੱਦ ਕਰਦਾ ਹੈ।<verse eid="LAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9" />ਉਸ ਨੇ ਪੱਥਰਾਂ ਨਾਲ ਮੇਰਾ ਰਾਹ ਰੋਕ ਦਿੱਤਾ ਹੈ।</para>
  <para style="q2" vid="LAM 3:9">ਉਸ ਨੇ ਮੇਰੇ ਰਾਹਾਂ ਨੂੰ ਟੇਢਾ ਬਣਾ ਦਿੱਤਾ ਹੈ।<verse eid="LAM 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10" />ਉਹ ਮੇਰੇ ਲਈ ਘਾਤ ਵਿੱਚ ਬੈਠਾ ਹੋਇਆ ਰਿੱਛ,</para>
  <para style="q2" vid="LAM 3:10">ਅਤੇ ਲੁੱਕ ਕੇ ਬੈਠੇ ਬੱਬਰ ਸ਼ੇਰ ਦੀ ਤਰ੍ਹਾਂ ਹੈ,<verse eid="LAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11" />ਉਸ ਨੇ ਮੈਨੂੰ ਰਾਹ ਤੋਂ ਘਸੀਟਿਆ ਅਤੇ ਮੈਨੂੰ ਭਟਕਾ ਦਿੱਤਾ</para>
  <para style="q2" vid="LAM 3:11">ਅਤੇ ਮੈਨੂੰ ਬਿਨਾਂ ਸਹਾਇਤਾ ਦੇ ਛੱਡ ਦਿੱਤਾ।<verse eid="LAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12" />ਉਸ ਨੇ ਆਪਣਾ ਧਣੁੱਖ ਖਿੱਚਿਆ</para>
  <para style="q2" vid="LAM 3:12">ਅਤੇ ਮੈਨੂੰ ਆਪਣੇ ਤੀਰਾਂ ਦਾ ਨਿਸ਼ਾਨਾ ਬਣਾਇਆ।<verse eid="LAM 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13" />ਉਸ ਨੇ ਆਪਣੇ ਤਰਕਸ਼ ਦੇ ਤੀਰਾਂ ਨਾਲ</para>
  <para style="q2" vid="LAM 3:13">ਮੇਰੇ ਦਿਲ ਨੂੰ ਵਿੰਨ੍ਹਿਆ।<verse eid="LAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14" />ਮੈਂ ਆਪਣੇ ਸਾਰੇ ਲੋਕਾਂ ਦਾ ਹਾਸਾ ਬਣਿਆ,</para>
  <para style="q2" vid="LAM 3:14">ਉਹ ਸਾਰਾ ਦਿਨ ਗੀਤਾਂ ਵਿੱਚ ਮੇਰਾ ਮਜ਼ਾਕ ਉਡਾਉਂਦੇ ਹਨ।<verse eid="LAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15" />ਉਸ ਨੇ ਮੈਨੂੰ ਕੌੜੀਆਂ ਜੜ੍ਹੀਆਂ ਬੂਟੀਆਂ ਨਾਲ ਭਰ ਦਿੱਤਾ ਹੈ</para>
  <para style="q2" vid="LAM 3:15">ਅਤੇ ਮੈਨੂੰ ਪੀਣ ਲਈ ਕੌੜੇ ਜ਼ਹਿਰ ਦਿੱਤਾ ਹੈ।<verse eid="LAM 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16" />ਉਸ ਨੇ ਮੇਰੇ ਦੰਦ ਰੋੜਿਆਂ ਨਾਲ ਤੋੜ ਦਿੱਤੇ ਹਨ;</para>
  <para style="q2" vid="LAM 3:16">ਉਸ ਨੇ ਮੈਨੂੰ ਰਾਖ਼ ਵਿੱਚ ਲਿਟਾਇਆ।<verse eid="LAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17" />ਮੈਂ ਸ਼ਾਂਤੀ ਤੋਂ ਵਾਂਝਾ ਹੋ ਗਿਆ ਹਾਂ;</para>
  <para style="q2" vid="LAM 3:17">ਮੈਂ ਭੁੱਲ ਗਿਆ ਹਾਂ ਕਿ ਖੁਸ਼ਹਾਲੀ ਕੀ ਹੁੰਦੀ ਹੈ।<verse eid="LAM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18" />ਇਸ ਲਈ ਮੈਂ ਆਖਦਾ ਹਾਂ, “ਮੇਰੀ ਸ਼ਾਨ ਖਤਮ ਹੋ ਗਈ ਹੈ</para>
  <para style="q2" vid="LAM 3:18">ਅਤੇ ਯਾਹਵੇਹ ਵੱਲੋਂ ਮੇਰੀ ਆਸ ਵੀ ਟੁੱਟ ਗਈ।”<verse eid="LAM 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19" />ਮੇਰੇ ਕਸ਼ਟ ਅਤੇ ਮੇਰੇ ਦੁੱਖ ਨੂੰ,</para>
  <para style="q2" vid="LAM 3:19">ਮੇਰੀ ਤਲਖੀ ਅਤੇ ਕੁੜੱਤਣ ਨੂੰ ਯਾਦ ਕਰ।<verse eid="LAM 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20" />ਮੈਂ ਉਹਨਾਂ ਨੂੰ ਚੰਗੀ ਤਰ੍ਹਾਂ ਯਾਦ ਕਰਦਾ ਹਾਂ,</para>
  <para style="q2" vid="LAM 3:20">ਅਤੇ ਮੇਰੀ ਆਤਮਾ ਮੇਰੇ ਅੰਦਰ ਉਦਾਸ ਹੈ।<verse eid="LAM 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21" />ਫਿਰ ਵੀ ਮੈਂ ਇਹ ਯਾਦ ਕਰਦਾ ਹਾਂ</para>
  <para style="q2" vid="LAM 3:21">ਅਤੇ ਇਸ ਲਈ ਮੈਨੂੰ ਉਮੀਦ ਹੈ:<verse eid="LAM 3:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22" />ਯਾਹਵੇਹ ਦੇ ਮਹਾਨ ਪਿਆਰ ਦੇ ਕਾਰਨ ਅਸੀਂ ਭਸਮ ਨਹੀਂ ਹੋਏ,</para>
  <para style="q2" vid="LAM 3:22">ਕਿਉਂ ਜੋ ਉਸ ਦੀ ਦਯਾ ਅਟੁੱਟ ਹੈ।<verse eid="LAM 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23" />ਉਹ ਹਰ ਸਵੇਰ ਨੂੰ ਨਵੀਂ ਹੁੰਦੀ ਜਾਂਦੀ ਹੈ,</para>
  <para style="q2" vid="LAM 3:23">ਤੇਰੀ ਵਫ਼ਾਦਾਰੀ ਵੱਡੀ ਮਹਾਨ ਹੈ।<verse eid="LAM 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24" />ਮੈਂ ਆਪਣੇ ਆਪ ਨੂੰ ਕਹਿੰਦਾ ਹਾਂ, “ਯਾਹਵੇਹ ਮੇਰਾ ਹਿੱਸਾ ਹੈ;</para>
  <para style="q2" vid="LAM 3:24">ਇਸ ਲਈ ਮੈਂ ਉਸ ਦੀ ਉਡੀਕ ਕਰਾਂਗਾ।”<verse eid="LAM 3:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25" />ਯਾਹਵੇਹ ਉਹਨਾਂ ਲਈ ਭਲਾ ਹੈ ਜਿਨ੍ਹਾਂ ਦੀ ਆਸ ਉਸ ਵਿੱਚ ਹੈ,</para>
  <para style="q2" vid="LAM 3:25">ਉਹਨਾਂ ਲਈ ਜੋ ਉਸ ਦੀ ਖੋਜ ਕਰਦੇ ਹਨ;<verse eid="LAM 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26" />ਯਾਹਵੇਹ ਦੀ ਮੁਕਤੀ ਲਈ</para>
  <para style="q2" vid="LAM 3:26">ਚੁੱਪ-ਚਾਪ ਉਡੀਕ ਕਰਨਾ ਚੰਗਾ ਹੈ।<verse eid="LAM 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27" />ਜੁਆਨ ਦੇ ਲਈ ਚੰਗਾ ਹੈ</para>
  <para style="q2" vid="LAM 3:27">ਕਿ ਉਹ ਆਪਣੀ ਜੁਆਨੀ ਵਿੱਚ ਜੂਲਾ ਚੁੱਕੇ।<verse eid="LAM 3:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28" />ਉਹ ਇਕੱਲਾ ਅਤੇ ਚੁੱਪ ਰਹੇ,</para>
  <para style="q2" vid="LAM 3:28">ਕਿਉਂ ਜੋ ਪਰਮੇਸ਼ਵਰ ਨੇ ਹੀ ਇਹ ਜੂਲਾ ਉਸ ਦੇ ਉੱਤੇ ਪਾਇਆ ਹੈ<verse eid="LAM 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29" />ਉਸਨੂੰ ਆਪਣਾ ਚਿਹਰਾ ਮਿੱਟੀ ਵਿੱਚ ਰੱਖੇ,</para>
  <para style="q2" vid="LAM 3:29">ਸ਼ਾਇਦ ਕੁਝ ਉਮੀਦ ਹੋਵੇ।<verse eid="LAM 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30" />ਉਹ ਆਪਣੀ ਗੱਲ੍ਹ ਆਪਣੇ ਮਾਰਨ ਵਾਲੇ ਵੱਲ ਫੇਰ ਦੇਵੇ,</para>
  <para style="q2" vid="LAM 3:30">ਅਤੇ ਉਹ ਨਿੰਦਿਆ ਸਹਿ ਲਵੇ।<verse eid="LAM 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31" />ਕਿਉਂਕਿ ਕੋਈ ਵੀ ਪਰਮੇਸ਼ਵਰ ਦੁਆਰਾ</para>
  <para style="q2" vid="LAM 3:31">ਸਦਾ ਲਈ ਤਿਆਗਿਆ ਨਹੀਂ ਜਾਂਦਾ।<verse eid="LAM 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32" />ਭਾਵੇਂ ਉਹ ਸੋਗ ਲਿਆਉਂਦਾ ਹੈ, ਉਹ ਦਇਆ ਦਿਖਾਵੇਂਗਾ,</para>
  <para style="q2" vid="LAM 3:32">ਉਸਦਾ ਅਟੁੱਟ ਪਿਆਰ ਬਹੁਤ ਮਹਾਨ ਹੈ।<verse eid="LAM 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33" />ਕਿਉਂ ਜੋ ਉਹ ਆਪਣੀ ਮਰਜ਼ੀ ਨਾਲ ਕਿਸੇ ਉੱਤੇ ਦੁੱਖ</para>
  <para style="q2" vid="LAM 3:33">ਜਾਂ ਸੋਗ ਨਹੀਂ ਲਿਆਉਂਦਾ।<verse eid="LAM 3:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34" />ਧਰਤੀ ਦੇ ਸਾਰੇ ਕੈਦੀਆਂ ਨੂੰ</para>
  <para style="q2" vid="LAM 3:34">ਪੈਰਾਂ ਹੇਠ ਕੁਚਲਣ ਲਈ,<verse eid="LAM 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35" />ਲੋਕਾਂ ਨੂੰ ਅੱਤ ਮਹਾਨ ਦੇ ਸਾਹਮਣੇ</para>
  <para style="q2" vid="LAM 3:35">ਉਹਨਾਂ ਦੇ ਅਧਿਕਾਰਾਂ ਤੋਂ ਇਨਕਾਰ ਕਰਨ ਲਈ,<verse eid="LAM 3:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36" />ਉਹਨਾਂ ਨੂੰ ਨਿਆਂ ਤੋਂ ਵਾਂਝਾ ਕਰਨ ਲਈ</para>
  <para style="q2" vid="LAM 3:36">ਕੀ ਪਰਮੇਸ਼ਵਰ ਅਜਿਹੀਆਂ ਚੀਜ਼ਾਂ ਨੂੰ ਨਹੀਂ ਦੇਖੇਗਾ?<verse eid="LAM 3:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37" />ਕੌਣ ਬੋਲ ਸਕਦਾ ਹੈ ਅਤੇ ਇਹ ਹੋ ਸਕਦਾ ਹੈ</para>
  <para style="q2" vid="LAM 3:37">ਜੇਕਰ ਪਰਮੇਸ਼ਵਰ ਨੇ ਇਹ ਹੁਕਮ ਨਹੀਂ ਦਿੱਤਾ ਹੈ?<verse eid="LAM 3:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38" />ਕੀ ਇਹ ਅੱਤ ਮਹਾਨ ਦੇ ਮੂੰਹੋਂ ਵਿੱਚੋਂ ਨਹੀਂ,</para>
  <para style="q2" vid="LAM 3:38">ਜੋ ਬਿਪਤਾ ਅਤੇ ਚੰਗੀਆਂ ਗੱਲਾਂ ਆਉਂਦੀਆਂ ਹਨ?<verse eid="LAM 3:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39" />ਜੀਉਂਦਾ ਆਦਮੀ ਸ਼ਿਕਾਇਤ ਕਿਉਂ ਕਰੇ</para>
  <para style="q2" vid="LAM 3:39">ਕੋਈ ਮਨੁੱਖ ਆਪਣੇ ਪਾਪਾਂ ਦੀ ਸਜ਼ਾ ਲਈ ਬੁਰਾ ਕਿਉਂ ਮੰਨੇ?<verse eid="LAM 3:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40" />ਆਓ ਆਪਾਂ ਆਪਣੇ ਤਰੀਕਿਆਂ ਦੀ ਜਾਂਚ ਕਰੀਏ ਅਤੇ ਉਹਨਾਂ ਨੂੰ ਪਰਖੀਏ,</para>
  <para style="q2" vid="LAM 3:40">ਅਤੇ ਆਓ ਅਸੀਂ ਯਾਹਵੇਹ ਵੱਲ ਮੁੜੀਏ।<verse eid="LAM 3:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41" />ਆਉ ਅਸੀਂ ਆਪਣੇ ਦਿਲ ਅਤੇ ਆਪਣੇ ਹੱਥਾਂ ਨੂੰ ਸਵਰਗ ਵਿੱਚ</para>
  <para style="q2" vid="LAM 3:41">ਪਰਮੇਸ਼ਵਰ ਵੱਲ ਉੱਚਾ ਕਰੀਏ, ਅਤੇ ਆਖੀਏ:<verse eid="LAM 3:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42" />“ਅਸੀਂ ਅਪਰਾਧ ਅਤੇ ਵਿਦਰੋਹ ਕੀਤਾ,</para>
  <para style="q2" vid="LAM 3:42">ਅਤੇ ਤੂੰ ਮਾਫ਼ ਨਹੀਂ ਕੀਤਾ।<verse eid="LAM 3:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43" />“ਤੁਸੀਂ ਆਪਣੇ ਆਪ ਨੂੰ ਗੁੱਸੇ ਨਾਲ ਢੱਕ ਲਿਆ ਹੈ ਅਤੇ ਸਾਡਾ ਪਿੱਛਾ ਕੀਤਾ ਹੈ;</para>
  <para style="q2" vid="LAM 3:43">ਤੁਸੀਂ ਬਿਨਾਂ ਤਰਸ ਦੇ ਮਾਰਿਆ ਹੈ।<verse eid="LAM 3:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44" />ਤੁਸੀਂ ਆਪਣੇ ਆਪ ਨੂੰ ਬੱਦਲ ਨਾਲ ਢੱਕ ਲਿਆ ਹੈ</para>
  <para style="q2" vid="LAM 3:44">ਤਾਂ ਜੋ ਕੋਈ ਪ੍ਰਾਰਥਨਾ ਤੇਰੇ ਕੋਲ ਨਾ ਪਹੁੰਚੇ।<verse eid="LAM 3:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45" />ਤੂੰ ਸਾਨੂੰ ਕੌਮਾਂ ਦੇ ਵਿਚਕਾਰ ਕੂੜੇ</para>
  <para style="q2" vid="LAM 3:45">ਅਤੇ ਰੂੜ੍ਹੀ ਵਰਗਾ ਠਹਿਰਾਇਆ।<verse eid="LAM 3:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46" />“ਸਾਡੇ ਸਾਰੇ ਦੁਸ਼ਮਣਾਂ ਨੇ</para>
  <para style="q2" vid="LAM 3:46">ਆਪਣੇ ਮੂੰਹ ਸਾਡੇ ਵਿਰੁੱਧ ਖੋਲ੍ਹ ਦਿੱਤੇ ਹਨ।<verse eid="LAM 3:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47" />ਅਸੀਂ ਦਹਿਸ਼ਤ ਅਤੇ ਮੁਸੀਬਤਾਂ,</para>
  <para style="q2" vid="LAM 3:47">ਬਰਬਾਦੀ ਅਤੇ ਤਬਾਹੀ ਦਾ ਸਾਹਮਣਾ ਕੀਤਾ ਹੈ।”<verse eid="LAM 3:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48" />ਮੇਰੀਆਂ ਅੱਖਾਂ ਵਿੱਚੋਂ ਹੰਝੂਆਂ ਦੀਆਂ ਧਾਰਾਂ ਵਗਦੀਆਂ ਹਨ</para>
  <para style="q2" vid="LAM 3:48">ਕਿਉਂਕਿ ਮੇਰੇ ਲੋਕ ਤਬਾਹ ਹੋ ਗਏ ਹਨ।<verse eid="LAM 3:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49" />ਮੇਰੇ ਹੰਝੂ ਵਗਦੇ ਰਹਿਣਗੇ</para>
  <para style="q2" vid="LAM 3:49">ਅਤੇ ਰੁਕਣਗੇ ਨਹੀਂ,<verse eid="LAM 3:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50" />ਜਦ ਤੱਕ ਯਾਹਵੇਹ</para>
  <para style="q2" vid="LAM 3:50">ਸਵਰਗ ਤੋਂ ਹੇਠਾਂ ਨਹੀਂ ਵੇਖਦਾ।<verse eid="LAM 3:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51" />ਜੋ ਕੁਝ ਮੈਂ ਦੇਖਦਾ ਹਾਂ ਮੇਰੀ ਰੂਹ ਨੂੰ ਉਦਾਸ ਕਰਦਾ ਹੈ।</para>
  <para style="q2" vid="LAM 3:51">ਕਿਉਂਕਿ ਜੋ ਕੁਝ ਮੇਰੇ ਸ਼ਹਿਰ ਦੀਆਂ ਸਾਰੀਆਂ ਔਰਤਾਂ ਨਾਲ ਵਾਪਰਿਆ ਹੈ।<verse eid="LAM 3:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52" />ਜਿਹੜੇ ਬਿਨਾਂ ਕਾਰਨ ਮੇਰੇ ਦੁਸ਼ਮਣ ਸਨ,</para>
  <para style="q2" vid="LAM 3:52">ਉਹਨਾਂ ਨੇ ਪੰਛੀ ਵਾਂਗ ਮੇਰਾ ਸ਼ਿਕਾਰ ਕੀਤਾ।<verse eid="LAM 3:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53" />ਉਹਨਾਂ ਨੇ ਇੱਕ ਟੋਏ ਵਿੱਚ ਮੇਰੀ ਜ਼ਿੰਦਗੀ ਨੂੰ ਖਤਮ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕੀਤੀ</para>
  <para style="q2" vid="LAM 3:53">ਅਤੇ ਮੇਰੇ ਤੇ ਪੱਥਰ ਸੁੱਟੇ;<verse eid="LAM 3:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54" />ਪਾਣੀ ਮੇਰੇ ਸਿਰ ਉੱਤੇ ਵਗੇ,</para>
  <para style="q2" vid="LAM 3:54">ਅਤੇ ਮੈਂ ਸੋਚਿਆ ਕਿ ਮੈਂ ਨਾਸ਼ ਹੋਣ ਵਾਲਾ ਹਾਂ।<verse eid="LAM 3:54" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55" />ਹੇ ਯਾਹਵੇਹ, ਮੈਂ ਡੂੰਘੇ ਟੋਏ ਵਿੱਚੋਂ</para>
  <para style="q2" vid="LAM 3:55">ਤੇਰੇ ਨਾਮ ਦੀ ਦੁਹਾਈ ਦਿੱਤੀ<verse eid="LAM 3:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56" />ਤੁਸੀਂ ਮੇਰੀ ਬੇਨਤੀ ਸੁਣੀ ਸੀ: “ਮੇਰੀ ਰਹਿਤ ਲਈ ਦੁਹਾਈ ਵੱਲ</para>
  <para style="q2" vid="LAM 3:56">ਆਪਣੇ ਕੰਨ ਬੰਦ ਨਾ ਕਰੋ।”<verse eid="LAM 3:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57" />ਜਦੋਂ ਮੈਂ ਤੁਹਾਨੂੰ ਪੁਕਾਰਿਆ ਤਾਂ ਤੂੰ ਨੇੜੇ ਆਇਆ,</para>
  <para style="q2" vid="LAM 3:57">ਅਤੇ ਤੂੰ ਕਿਹਾ, “ਡਰ ਨਾ।”<verse eid="LAM 3:57" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58" />ਹੇ ਮੇਰੇ ਯਾਹਵੇਹ, ਤੂੰ ਮੇਰੀ ਜਾਨ ਦਾ ਮੁਕੱਦਮਾ ਲੜਿਆ ਹੈ,</para>
  <para style="q2" vid="LAM 3:58">ਤੂੰ ਮੇਰੇ ਜੀਵਨ ਦਾ ਛੁਟਕਾਰਾ ਕੀਤਾ ਹੈ।<verse eid="LAM 3:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59" />ਹੇ ਯਾਹਵੇਹ, ਤੂੰ ਮੇਰੇ ਨਾਲ ਹੋਈ ਬੇਇਨਸਾਫ਼ੀ ਨੂੰ ਵੇਖਿਆ ਹੈ,</para>
  <para style="q2" vid="LAM 3:59">ਤੂੰ ਮੇਰਾ ਨਿਆਂ ਕਰ!<verse eid="LAM 3:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60" />ਤੂੰ ਉਹਨਾਂ ਦੇ ਬਦਲੇ ਦੀ ਡੂੰਘਾਈ ਨੂੰ ਵੇਖਿਆ ਹੈ,</para>
  <para style="q2" vid="LAM 3:60">ਉਹਨਾਂ ਦੀਆਂ ਸਾਰੀਆਂ ਸਾਜ਼ਿਸ਼ਾਂ ਮੇਰੇ ਵਿਰੁੱਧ ਹਨ।<verse eid="LAM 3:60" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61" />ਹੇ ਯਾਹਵੇਹ, ਤੂੰ ਉਹਨਾਂ ਦੀ ਨਿੰਦਿਆ ਨੂੰ ਸੁਣਿਆ ਹੈ,</para>
  <para style="q2" vid="LAM 3:61">ਅਤੇ ਉਨ੍ਹਾਂ ਯੋਜਨਾਵਾਂ ਨੂੰ ਵੀ ਜੋ ਉਹਨਾਂ ਨੇ ਮੇਰੇ ਵਿਰੁੱਧ ਬਣਾਈਆਂ ਹਨ<verse eid="LAM 3:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62" />ਮੇਰੇ ਵਿਰੋਧੀਆਂ ਦੀਆਂ ਗੱਲਾਂ,</para>
  <para style="q2" vid="LAM 3:62">ਅਤੇ ਦਿਨ ਭਰ ਮੇਰੇ ਵਿਰੁੱਧ ਉਹਨਾਂ ਦੇ ਵਿਚਾਰ, ਤੂੰ ਜਾਣਦਾ ਹੈ।<verse eid="LAM 3:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63" />ਉਹਨਾਂ ਦੇ ਉੱਠਣ ਬੈਠਣ ਵੱਲ ਧਿਆਨ ਦੇ!</para>
  <para style="q2" vid="LAM 3:63">ਮੈਂ ਉਹਨਾਂ ਦੇ ਤਾਹਨਿਆਂ ਦਾ ਗੀਤ ਹੈ।<verse eid="LAM 3:63" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64" />ਹੇ ਯਾਹਵੇਹ ਤੂੰ ਉਹਨਾਂ ਨੂੰ ਉਹਨਾਂ ਦੇ ਹੱਥਾਂ ਦੁਆਰਾ ਕੀਤੇ ਗਏ,</para>
  <para style="q2" vid="LAM 3:64">ਕੰਮਾਂ ਦਾ ਬਦਲਾ ਦੇਵੇਗਾ।<verse eid="LAM 3:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65" />ਉਹਨਾਂ ਦੇ ਦਿਲਾਂ ਉੱਤੇ ਪਰਦਾ ਪਾ,</para>
  <para style="q2" vid="LAM 3:65">ਅਤੇ ਤੇਰਾ ਸਰਾਪ ਉਹਨਾਂ ਉੱਤੇ ਹੋਵੇਗਾ!<verse eid="LAM 3:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66" />ਕ੍ਰੋਧ ਵਿੱਚ ਉਹਨਾਂ ਦਾ ਪਿੱਛਾ ਕਰ</para>
  <para style="q2" vid="LAM 3:66">ਅਤੇ ਹੇ ਯਾਹਵੇਹ ਦੇ ਅਕਾਸ਼ ਹੇਠੋਂ ਉਹਨਾਂ ਦਾ ਨਾਸ਼ ਕਰੋ।<verse eid="LAM 3:66" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1" />ਸੋਨਾ ਕਿਵੇਂ ਆਪਣੀ ਚਮਕ ਗੁਆ ਬੈਠਾ ਹੈ,</para>
  <para style="q2" vid="LAM 4:1">ਵਧੀਆ ਸੋਨਾ ਕਿਵੇਂ ਬਦਲ ਗਿਆ ਹੈ!</para>
  <para style="q1" vid="LAM 4:1">ਪਵਿੱਤਰ ਸਥਾਨ ਦੇ ਪੱਥਰ</para>
  <para style="q2" vid="LAM 4:1">ਹਰ ਗਲੀ ਦੇ ਸਿਰ ਉੱਤੇ ਖਿੱਲਰੇ ਪਏ ਹਨ।<verse eid="LAM 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2" />ਸੀਯੋਨ ਦੇ ਕਿੰਨੇ ਕੀਮਤੀ ਬੱਚੇ,</para>
  <para style="q2" vid="LAM 4:2">ਇੱਕ ਵਾਰ ਸੋਨੇ ਵਿੱਚ ਭਾਰੇ ਸਨ,</para>
  <para style="q1" vid="LAM 4:2">ਹੁਣ ਮਿੱਟੀ ਦੇ ਭਾਂਡੇ ਸਮਝੇ ਜਾਂਦੇ ਹਨ,</para>
  <para style="q2" vid="LAM 4:2">ਘੁਮਿਆਰ ਦੇ ਹੱਥਾਂ ਦਾ ਕੰਮ!<verse eid="LAM 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3" />ਗਿੱਦੜ ਵੀ ਆਪਣੇ ਬੱਚਿਆਂ ਨੂੰ ਦੁੱਧ ਚੁੰਘਾਉਣ ਲਈ</para>
  <para style="q2" vid="LAM 4:3">ਛਾਤੀਆਂ ਚੜ੍ਹਾਉਂਦੇ ਹਨ,</para>
  <para style="q1" vid="LAM 4:3">ਪਰ ਮੇਰੇ ਲੋਕ ਮਾਰੂਥਲ ਵਿੱਚ</para>
  <para style="q2" vid="LAM 4:3">ਸ਼ੁਤਰਮੁਰਗਾਂ ਵਾਂਗ ਬੇਰਹਿਮ ਹੋ ਗਏ ਹਨ।<verse eid="LAM 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4" />ਪਿਆਸ ਦੇ ਕਾਰਨ ਬੱਚੇ ਦੀ ਜੀਭ</para>
  <para style="q2" vid="LAM 4:4">ਤਾਲੂ ਨਾਲ ਚਿਪਕ ਜਾਂਦੀ ਹੈ;</para>
  <para style="q1" vid="LAM 4:4">ਬੱਚੇ ਰੋਟੀ ਦੀ ਭੀਖ ਮੰਗਦੇ ਹਨ,</para>
  <para style="q2" vid="LAM 4:4">ਪਰ ਕੋਈ ਉਨ੍ਹਾਂ ਨੂੰ ਨਹੀਂ ਦਿੰਦਾ।<verse eid="LAM 4:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5" />ਜਿਹੜੇ ਲੋਕ ਇੱਕ ਵਾਰ ਸੁਆਦਲਾ ਭੋਜਨ ਖਾਂਦੇ ਸਨ</para>
  <para style="q2" vid="LAM 4:5">ਗਲੀਆਂ ਵਿੱਚ ਬੇਸਹਾਰਾ ਫਿਰਦੇ ਸਨ।</para>
  <para style="q1" vid="LAM 4:5">ਸ਼ਾਹੀ ਬੈਂਗਣੀ ਕੱਪੜਿਆਂ ਵਿੱਚ ਪਲਦੇ ਸਨ</para>
  <para style="q2" vid="LAM 4:5">ਹੁਣ ਰਾਖ ਦੇ ਢੇਰਾਂ ਤੇ ਪਏ ਹਨ।<verse eid="LAM 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6" />ਮੇਰੀ ਪਰਜਾ ਦੀ ਸਜ਼ਾ</para>
  <para style="q2" vid="LAM 4:6">ਸੋਦੋਮ ਨਾਲੋਂ ਵੱਡੀ ਹੈ,</para>
  <para style="q1" vid="LAM 4:6">ਜਿਸ ਨੂੰ ਇੱਕ ਪਲ ਵਿੱਚ ਉਖਾੜ ਦਿੱਤਾ ਗਿਆ ਸੀ</para>
  <para style="q2" vid="LAM 4:6">ਉਸ ਦੀ ਸਹਾਇਤਾ ਲਈ ਹੱਥ ਨਾ ਮੋੜੇ।<verse eid="LAM 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7" />ਉਨ੍ਹਾਂ ਦੇ ਰਾਜਕੁਮਾਰ ਬਰਫ਼ ਨਾਲੋਂ ਚਮਕਦਾਰ</para>
  <para style="q2" vid="LAM 4:7">ਅਤੇ ਦੁੱਧ ਨਾਲੋਂ ਚਿੱਟੇ ਸਨ,</para>
  <para style="q1" vid="LAM 4:7">ਉਨ੍ਹਾਂ ਦੇ ਸਰੀਰ ਰੂਬੀ ਨਾਲੋਂ ਜ਼ਿਆਦਾ ਲਾਲ ਸਨ,</para>
  <para style="q2" vid="LAM 4:7">ਉਨ੍ਹਾਂ ਦੀ ਚਮਕ ਨੀਲਮ ਵਰਗੀ ਸੀ।<verse eid="LAM 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8" />ਹੁਣ ਉਹਨਾਂ ਦਾ ਰੂਪ ਕਾਲਖ ਨਾਲੋਂ ਕਾਲਾ ਹੈ,</para>
  <para style="q2" vid="LAM 4:8">ਉਹ ਬਜ਼ਾਰਾਂ ਵਿੱਚ ਪਹਿਚਾਣੇ ਨਹੀਂ ਜਾਂਦੇ,</para>
  <para style="q1" vid="LAM 4:8">ਉਹਨਾਂ ਦਾ ਚਮੜਾ ਸੁੰਗੜ ਕੇ ਹੱਡੀਆਂ ਨਾਲ ਜੁੜ ਗਿਆ,</para>
  <para style="q2" vid="LAM 4:8">ਉਹ ਸੁੱਕ ਕੇ ਲੱਕੜ ਵਾਂਗੂੰ ਹੋ ਗਿਆ ਹੈ।<verse eid="LAM 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9" />ਤਲਵਾਰ ਨਾਲ ਮਾਰੇ ਗਏ ਲੋਕ</para>
  <para style="q2" vid="LAM 4:9">ਕਾਲ ਨਾਲ ਮਰਨ ਵਾਲਿਆਂ ਨਾਲੋਂ ਚੰਗੇ ਹਨ।</para>
  <para style="q1" vid="LAM 4:9">ਭੁੱਖ ਨਾਲ ਤੜਫਦੇ ਹੋਏ,</para>
  <para style="q2" vid="LAM 4:9">ਉਹ ਖੇਤ ਵਿੱਚੋਂ ਭੋਜਨ ਦੀ ਘਾਟ ਕਾਰਨ ਖਤਮ ਹੋ ਜਾਂਦੇ ਹਨ।<verse eid="LAM 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10" />ਦਿਆਲੂ ਔਰਤਾਂ ਨੇ ਆਪਣੇ ਹੱਥਾਂ ਨਾਲ</para>
  <para style="q2" vid="LAM 4:10">ਆਪਣੇ ਬੱਚਿਆਂ ਨੂੰ ਪਕਾਇਆ ਹੈ,</para>
  <para style="q1" vid="LAM 4:10">ਜੋ ਉਹ ਉਹਨਾਂ ਦਾ ਭੋਜਨ ਬਣੇ</para>
  <para style="q2" vid="LAM 4:10">ਜਦੋਂ ਮੇਰੇ ਲੋਕ ਬਰਬਾਦ ਹੋ ਗਏ ਸਨ।<verse eid="LAM 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11" />ਯਾਹਵੇਹ ਨੇ ਆਪਣੇ ਕ੍ਰੋਧ ਨੂੰ ਪੂਰਾ ਕਰ ਦਿੱਤਾ ਹੈ;</para>
  <para style="q2" vid="LAM 4:11">ਉਸਨੇ ਆਪਣਾ ਭਿਆਨਕ ਕ੍ਰੋਧ ਡੋਲ੍ਹ ਦਿੱਤਾ ਹੈ।</para>
  <para style="q1" vid="LAM 4:11">ਉਸ ਨੇ ਸੀਯੋਨ ਵਿੱਚ ਅੱਗ ਭੜਕਾਈ ਜਿਸ ਨੇ</para>
  <para style="q2" vid="LAM 4:11">ਉਸ ਦੀਆਂ ਨੀਹਾਂ ਨੂੰ ਭਸਮ ਕਰ ਦਿੱਤਾ।<verse eid="LAM 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12" />ਧਰਤੀ ਦੇ ਰਾਜਿਆਂ ਨੇ ਵਿਸ਼ਵਾਸ ਨਹੀਂ ਕੀਤਾ,</para>
  <para style="q2" vid="LAM 4:12">ਨਾ ਦੁਨੀਆਂ ਦੇ ਲੋਕਾਂ ਵਿੱਚੋਂ ਕਿਸੇ ਨੇ,</para>
  <para style="q1" vid="LAM 4:12">ਕਿ ਵੈਰੀ ਅਤੇ ਦੁਸ਼ਮਣ</para>
  <para style="q2" vid="LAM 4:12">ਯੇਰੂਸ਼ਲੇਮ ਦੇ ਦਰਵਾਜ਼ਿਆਂ ਵਿੱਚ ਦਾਖਲ ਹੋ ਸਕਦੇ ਹਨ।<verse eid="LAM 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13" />ਪਰ ਇਹ ਉਸ ਦੇ ਨਬੀਆਂ ਦੇ ਪਾਪਾਂ</para>
  <para style="q2" vid="LAM 4:13">ਅਤੇ ਉਸ ਦੇ ਜਾਜਕਾਂ ਦੀਆਂ ਬਦੀਆਂ ਦੇ ਕਾਰਨ ਹੋਇਆ,</para>
  <para style="q1" vid="LAM 4:13">ਜਿਨ੍ਹਾਂ ਨੇ ਉਸ ਦੇ ਵਿਚਕਾਰ</para>
  <para style="q2" vid="LAM 4:13">ਧਰਮੀਆਂ ਦਾ ਲਹੂ ਵਹਾਇਆ।<verse eid="LAM 4:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14" />ਉਹ ਅੰਨ੍ਹਿਆਂ ਵਰਗੇ ਹੋ ਕੇ</para>
  <para style="q2" vid="LAM 4:14">ਗਲੀਆਂ ਵਿੱਚ ਫਿਰਦੇ ਹਨ,</para>
  <para style="q1" vid="LAM 4:14">ਉਹ ਲਹੂ ਨਾਲ ਇੰਨੇ ਅਸ਼ੁੱਧ ਹੋ ਗਏ ਹਨ,</para>
  <para style="q2" vid="LAM 4:14">ਭਈ ਕੋਈ ਉਹਨਾਂ ਦੇ ਬਸਤਰ ਛੂਹ ਨਹੀਂ ਸਕਦਾ।<verse eid="LAM 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15" />“ਚਲੇ ਜਾਓ! ਤੁਸੀਂ ਅਸ਼ੁੱਧ ਹੋ!” ਲੋਕ ਉਹਨਾਂ ਨੂੰ ਰੋਂਦੇ ਹਨ।</para>
  <para style="q2" vid="LAM 4:15">“ਦੂਰ! ਦੂਰ! ਸਾਨੂੰ ਨਾ ਛੂਹੋ!”</para>
  <para style="q1" vid="LAM 4:15">ਜਦੋਂ ਉਹ ਭੱਜ ਜਾਂਦੇ ਹਨ ਅਤੇ ਇਧਰ-ਉਧਰ ਭਟਕਦੇ ਹਨ,</para>
  <para style="q2" vid="LAM 4:15">ਕੌਮਾਂ ਦੇ ਲੋਕ ਆਖਦੇ ਹਨ,</para>
  <para style="q2" vid="LAM 4:15">“ਉਹ ਹੁਣ ਇੱਥੇ ਨਹੀਂ ਰਹਿ ਸਕਦੇ।”<verse eid="LAM 4:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16" />ਯਾਹਵੇਹ ਨੇ ਆਪ ਹੀ ਉਹਨਾਂ ਨੂੰ ਖਿੰਡਾ ਦਿੱਤਾ ਹੈ;</para>
  <para style="q2" vid="LAM 4:16">ਉਹ ਹੁਣ ਉਨ੍ਹਾਂ ਉੱਤੇ ਨਜ਼ਰ ਨਹੀਂ ਰੱਖਦਾ।</para>
  <para style="q1" vid="LAM 4:16">ਜਾਜਕਾਂ ਦਾ ਕੋਈ ਆਦਰ ਨਹੀਂ,</para>
  <para style="q2" vid="LAM 4:16">ਅਤੇ ਬਜ਼ੁਰਗਾਂ ਉੱਤੇ ਕੋਈ ਕਿਰਪਾ ਨਹੀਂ ਕਰਦਾ।<verse eid="LAM 4:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17" />ਇਸ ਤੋਂ ਇਲਾਵਾ, ਸਾਡੀਆਂ ਅੱਖਾਂ ਵਿਅਰਥ,</para>
  <para style="q2" vid="LAM 4:17">ਮਦਦ ਲਈ ਉਡੀਕ ਕਰਦਿਆਂ ਥੱਕ ਗਈਆਂ ਹਨ;</para>
  <para style="q1" vid="LAM 4:17">ਆਪਣੇ ਬੁਰਜਾਂ ਤੋਂ ਅਸੀਂ</para>
  <para style="q2" vid="LAM 4:17">ਇੱਕ ਕੌਮ ਲਈ ਵੇਖੀ ਜੋ ਸਾਨੂੰ ਬਚਾ ਨਹੀਂ ਸਕੀ।<verse eid="LAM 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18" />ਲੋਕਾਂ ਨੇ ਹਰ ਕਦਮ ਤੇ ਸਾਡਾ ਪਿੱਛਾ ਕੀਤਾ,</para>
  <para style="q2" vid="LAM 4:18">ਤਾਂ ਜੋ ਅਸੀਂ ਆਪਣੀਆਂ ਗਲੀਆਂ ਵਿੱਚ ਨਾ ਤੁਰ ਸਕੀਏ।</para>
  <para style="q1" vid="LAM 4:18">ਸਾਡਾ ਅੰਤ ਨੇੜੇ ਸੀ, ਸਾਡੇ ਦਿਨ ਗਿਣੇ ਗਏ ਸਨ,</para>
  <para style="q2" vid="LAM 4:18">ਕਿਉਂਕਿ ਸਾਡਾ ਅੰਤ ਆ ਗਿਆ ਸੀ।<verse eid="LAM 4:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19" />ਸਾਡਾ ਪਿੱਛਾ ਕਰਨ ਵਾਲੇ ਅਕਾਸ਼ ਵਿੱਚ</para>
  <para style="q2" vid="LAM 4:19">ਉਕਾਬ ਨਾਲੋਂ ਤੇਜ਼ ਸਨ;</para>
  <para style="q1" vid="LAM 4:19">ਉਨ੍ਹਾਂ ਨੇ ਪਹਾੜਾਂ ਉੱਤੇ ਸਾਡਾ ਪਿੱਛਾ ਕੀਤਾ</para>
  <para style="q2" vid="LAM 4:19">ਅਤੇ ਮਾਰੂਥਲ ਵਿੱਚ ਸਾਡੀ ਉਡੀਕ ਵਿੱਚ ਪਏ ਰਹੇ।<verse eid="LAM 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20" />ਯਾਹਵੇਹ ਦਾ ਮਸਹ ਕੀਤਾ ਹੋਇਆ, ਸਾਡਾ ਜੀਵਨ ਦਾ ਸਾਹ</para>
  <para style="q2" vid="LAM 4:20">ਉਹਨਾਂ ਦੇ ਜਾਲ ਵਿੱਚ ਫਸਿਆ ਹੋਇਆ ਸੀ।</para>
  <para style="q1" vid="LAM 4:20">ਅਸੀਂ ਸੋਚਿਆ ਕਿ ਅਸੀਂ ਉਸ ਦੇ ਸਾਏ ਹੇਠ</para>
  <para style="q2" vid="LAM 4:20">ਕੌਮਾਂ ਵਿੱਚ ਰਹਾਂਗੇ।<verse eid="LAM 4:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21" />ਹੇ ਅਦੋਮ ਦੀ ਧੀਏ,</para>
  <para style="q2" vid="LAM 4:21">ਊਜ਼ ਦੀ ਧਰਤੀ ਉੱਤੇ ਵੱਸਦੀ ਹੈ, ਅਨੰਦ ਹੋ ਅਤੇ ਖੁਸ਼ ਮਨਾ।</para>
  <para style="q1" vid="LAM 4:21">ਪਰ ਤੈਨੂੰ ਵੀ ਪਿਆਲਾ ਦਿੱਤਾ ਜਾਵੇਗਾ।</para>
  <para style="q2" vid="LAM 4:21">ਤੂੰ ਸ਼ਰਾਬੀ ਹੋ ਕੇ ਆਪਣੇ ਕੱਪੜੇ ਉਤਾਰੇਗੀ।<verse eid="LAM 4:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22" />ਹੇ ਸੀਯੋਨ ਦੀਏ ਧੀਏ, ਤੇਰੀ ਬਦੀ ਦੀ ਸਜ਼ਾ ਪੂਰੀ ਹੋਈ,</para>
  <para style="q2" vid="LAM 4:22">ਉਹ ਤੈਨੂੰ ਫੇਰ ਗੁਲਾਮ ਬਣਾ ਕੇ ਨਹੀਂ ਲੈ ਜਾਵੇਗਾ!</para>
  <para style="q1" vid="LAM 4:22">ਹੇ ਅਦੋਮ ਦੀਏ ਧੀਏ, ਉਹ ਤੇਰੀ ਬਦੀ ਦੀ ਖ਼ਬਰ ਲਵੇਗਾ,</para>
  <para style="q2" vid="LAM 4:22">ਉਹ ਤੇਰੇ ਪਾਪ ਉਘਾੜ ਦੇਵੇਗਾ।<verse eid="LAM 4:22" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1" />ਹੇ ਯਾਹਵੇਹ, ਸਾਡੇ ਨਾਲ ਜੋ ਵਾਪਰਿਆ ਹੈ ਉਸਨੂੰ ਯਾਦ ਰੱਖ;</para>
  <para style="q2" vid="LAM 5:1">ਧਿਆਨ ਦੇ ਅਤੇ ਸਾਡੀ ਬਦਨਾਮੀ ਵੇਖ।<verse eid="LAM 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2" />ਸਾਡੀ ਵਿਰਾਸਤ ਪਰਦੇਸੀਆਂ ਨੂੰ ਸੌਂਪੀ ਗਈ,</para>
  <para style="q2" vid="LAM 5:2">ਸਾਡੇ ਘਰ ਪਰਾਇਆਂ ਦੇ ਹੋ ਗਏ।<verse eid="LAM 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3" />ਅਸੀਂ ਯਤੀਮ ਹੋ ਗਏ ਹਾਂ,</para>
  <para style="q2" vid="LAM 5:3">ਸਾਡੀਆਂ ਮਾਵਾਂ ਵਿਧਵਾਵਾਂ ਵਾਂਗ ਹੋ ਗਈਆ ਹਨ।<verse eid="LAM 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4" />ਸਾਨੂੰ ਉਹ ਪਾਣੀ ਖਰੀਦਣਾ ਚਾਹੀਦਾ ਹੈ ਜੋ ਅਸੀਂ ਪੀਂਦੇ ਹਾਂ;</para>
  <para style="q2" vid="LAM 5:4">ਸਾਡੀ ਲੱਕੜ ਸਿਰਫ ਕੀਮਤ ਤੇ ਹੀ ਮਿਲ ਸਕਦੀ ਹੈ।<verse eid="LAM 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5" />ਜਿਹੜੇ ਸਾਡਾ ਪਿੱਛਾ ਕਰਦੇ ਹਨ ਉਹ ਸਾਡੇ ਪੈਰਾਂ ਉੱਤੇ ਹਨ।</para>
  <para style="q2" vid="LAM 5:5">ਅਸੀਂ ਥੱਕ ਗਏ ਹਾਂ ਅਤੇ ਸਾਨੂੰ ਆਰਾਮ ਨਹੀਂ ਮਿਲਦਾ।<verse eid="LAM 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6" />ਅਸੀਂ ਰੋਟੀ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ</para>
  <para style="q2" vid="LAM 5:6">ਮਿਸਰ ਅਤੇ ਅੱਸ਼ੂਰ ਨੂੰ ਸੌਂਪ ਦਿੱਤਾ।<verse eid="LAM 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7" />ਸਾਡੇ ਪੁਰਖਿਆਂ ਨੇ ਪਾਪ ਕੀਤਾ ਅਤੇ ਉਹ ਨਹੀਂ ਰਹੇ,</para>
  <para style="q2" vid="LAM 5:7">ਪਰ ਅਸੀਂ ਉਹਨਾਂ ਦੀ ਬੁਰਿਆਈ ਦਾ ਭਾਰ ਚੁੱਕਦੇ ਹਾਂ।<verse eid="LAM 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8" />ਗੁਲਾਮ ਸਾਡੇ ਉੱਤੇ ਰਾਜ ਕਰਦੇ ਹਨ,</para>
  <para style="q2" vid="LAM 5:8">ਅਤੇ ਸਾਨੂੰ ਉਨ੍ਹਾਂ ਦੇ ਹੱਥੋਂ ਛੁਡਾਉਣ ਵਾਲਾ ਕੋਈ ਨਹੀਂ ਹੈ।<verse eid="LAM 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9" />ਮਾਰੂਥਲ ਵਿੱਚ ਤਲਵਾਰ ਦੇ ਕਾਰਨ</para>
  <para style="q2" vid="LAM 5:9">ਅਸੀਂ ਆਪਣੀਆਂ ਜਾਨਾਂ ਦੇ ਖ਼ਤਰੇ ਵਿੱਚ ਪਾ ਕੇ ਰੋਟੀ ਕਮਾਉਂਦੇ ਹਾਂ।<verse eid="LAM 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10" />ਭੁੱਖ ਦੀ ਝੁਲਸਾ ਦੇਣ ਵਾਲੀ ਅੱਗ ਦੇ ਕਾਰਨ,</para>
  <para style="q2" vid="LAM 5:10">ਸਾਡਾ ਚਮੜਾ ਤੰਦੂਰ ਵਾਂਗੂੰ ਕਾਲਾ ਹੋ ਗਿਆ ਹੈ।<verse eid="LAM 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11" />ਸੀਯੋਨ ਵਿੱਚ ਔਰਤਾਂ</para>
  <para style="q2" vid="LAM 5:11">ਅਤੇ ਯਹੂਦਾਹ ਦੇ ਕਸਬਿਆਂ ਵਿੱਚ ਕੁਆਰੀਆਂ ਭਰਿਸ਼ਟ ਕੀਤੀਆਂ ਗਈਆਂ।<verse eid="LAM 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12" />ਰਾਜਕੁਮਾਰਾਂ ਨੂੰ ਉਹਨਾਂ ਦੇ ਹੱਥਾਂ ਭਾਰ ਲਟਕਾਇਆ ਗਿਆ ਹੈ;</para>
  <para style="q2" vid="LAM 5:12">ਬਜ਼ੁਰਗਾਂ ਦਾ ਕੋਈ ਸਤਿਕਾਰ ਨਹੀਂ ਕੀਤਾ ਜਾਂਦਾ।<verse eid="LAM 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13" />ਨੌਜਵਾਨ ਚੱਕੀ ਦੇ ਪੱਥਰਾਂ ਤੇ ਮਿਹਨਤ ਕਰਦੇ ਹਨ;</para>
  <para style="q2" vid="LAM 5:13">ਮੁੰਡਿਆਂ ਨੇ ਲੱਕੜਾਂ ਦੇ ਭਾਰ ਹੇਠ ਠੋਕਰਾਂ ਖਾਧੀਆਂ।<verse eid="LAM 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14" />ਬਜ਼ੁਰਗ ਸ਼ਹਿਰ ਦੇ ਫਾਟਕ ਤੋਂ ਚਲੇ ਗਏ ਹਨ;</para>
  <para style="q2" vid="LAM 5:14">ਨੌਜਵਾਨਾਂ ਨੇ ਆਪਣਾ ਸੰਗੀਤ ਬੰਦ ਕਰ ਦਿੱਤਾ ਹੈ।<verse eid="LAM 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15" />ਖੁਸ਼ੀ ਸਾਡੇ ਦਿਲਾਂ ਵਿੱਚੋਂ ਚਲੀ ਗਈ ਹੈ;</para>
  <para style="q2" vid="LAM 5:15">ਸਾਡਾ ਨੱਚਣਾ ਸੋਗ ਵਿੱਚ ਬਦਲ ਗਿਆ ਹੈ।<verse eid="LAM 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16" />ਤਾਜ ਸਾਡੇ ਸਿਰ ਤੋਂ ਡਿੱਗ ਗਿਆ ਹੈ।</para>
  <para style="q2" vid="LAM 5:16">ਸਾਡੇ ਉੱਤੇ ਹਾਏ, ਕਿਉਂ ਜੋ ਅਸੀਂ ਪਾਪ ਕੀਤਾ ਹੈ!<verse eid="LAM 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17" />ਇਸ ਕਾਰਨ ਸਾਡੇ ਦਿਲ ਕਮਜ਼ੋਰ ਹੋ ਗਏ,</para>
  <para style="q2" vid="LAM 5:17">ਇਨ੍ਹਾਂ ਗੱਲਾਂ ਦੇ ਕਾਰਨ ਸਾਡੀਆਂ ਅੱਖਾਂ ਧੁੰਦਲੀਆਂ ਹੋ ਗਈਆਂ<verse eid="LAM 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18" />ਕਿਉਂ ਜੋ ਸੀਯੋਨ ਪਰਬਤ ਵਿਰਾਨ ਹੋ ਗਿਆ,</para>
  <para style="q2" vid="LAM 5:18">ਉਸ ਉੱਤੇ ਗਿੱਦੜ ਘੁੰਮਦੇ ਹਨ।<verse eid="LAM 5:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19" />ਹੇ ਯਾਹਵੇਹ, ਤੂੰ ਸਦਾ ਲਈ ਬਿਰਾਜਮਾਨ ਹੈ;</para>
  <para style="q2" vid="LAM 5:19">ਤੇਰਾ ਸਿੰਘਾਸਣ ਪੀੜ੍ਹੀ ਦਰ ਪੀੜ੍ਹੀ ਕਾਇਮ ਹੈ।<verse eid="LAM 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20" />ਤੂੰ ਸਾਨੂੰ ਹਮੇਸ਼ਾ ਲਈ ਕਿਉਂ ਭੁੱਲ ਗਿਆ?</para>
  <para style="q2" vid="LAM 5:20">ਅਤੇ ਕਿਉਂ ਸਾਨੂੰ ਇੰਨੇ ਲੰਬੇ ਸਮੇਂ ਲਈ ਤਿਆਗ ਦਿੱਤਾ ਹੈ?<verse eid="LAM 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21" />ਹੇ ਯਾਹਵੇਹ, ਸਾਨੂੰ ਆਪਣੀ ਵੱਲ ਮੋੜ ਲੈ,</para>
  <para style="q2" vid="LAM 5:21">ਤਾਂ ਅਸੀਂ ਮੁੜ ਆਵਾਂਗੇ, ਸਾਡੇ ਦਿਨ ਪਹਿਲਾਂ ਵਾਂਗੂੰ ਨਵੇਂ ਬਣਾ ਦੇ<verse eid="LAM 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22" />ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਸਾਨੂੰ ਪੂਰੀ ਤਰ੍ਹਾਂ ਛੱਡ ਨਹੀਂ ਦਿੰਦਾ</para>
  <para style="q2" vid="LAM 5:22">ਅਤੇ ਹੱਦ ਤੋਂ ਵੱਧ ਸਾਡੇ ਨਾਲ ਗੁੱਸੇ ਨਹੀਂ ਹੁੰਦਾ।<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>