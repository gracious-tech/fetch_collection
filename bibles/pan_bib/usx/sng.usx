  <para style="h">ਸਰੇਸ਼ਟ</para>
  <para style="toc1">ਸਰੇਸ਼ਟ ਗੀਤ</para>
  <para style="toc2">ਸਰੇਸ਼ਟ</para>
  <para style="toc3">ਸਰੇ</para>
  <para style="mt1">ਸਰੇਸ਼ਟ ਗੀਤ</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />ਰਾਜਾ ਸ਼ਲੋਮੋਨ ਦੇ ਸਰੇਸ਼ਟ ਗੀਤ।<verse eid="SNG 1:1" /></para>
  <para style="b" />
  <para style="sp">ਨਾਇਕਾ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />ਤੂੰ ਮੈਨੂੰ ਆਪਣੇ ਮੂੰਹ ਦੇ ਚੁੰਮਣ ਨਾਲ ਚੁੰਮੇ,</para>
  <para style="q2" vid="SNG 1:2">ਕਿਉਂ ਜੋ ਤੇਰਾ ਪਿਆਰ ਦਾਖ਼ਰਸ ਨਾਲੋਂ ਵੀ ਚੰਗਾ ਹੈ।<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />ਤੇਰੇ ਅਤਰ ਦੀ ਸੁਗੰਧ ਚੰਗੀ ਹੈ,</para>
  <para style="q2" vid="SNG 1:3">ਤੇਰਾ ਨਾਮ ਡੋਲ੍ਹੇ ਹੋਏ ਅਤਰ ਵਾਂਗ ਹੈ,</para>
  <para style="q2" vid="SNG 1:3">ਇਸ ਲਈ ਕੋਈ ਹੈਰਾਨੀ ਨਹੀਂ ਕਿ ਮੁਟਿਆਰਾਂ ਤੈਨੂੰ ਪਿਆਰ ਕਰਦੀਆਂ ਹਨ!<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />ਮੈਨੂੰ ਆਪਣੇ ਨਾਲ ਲੈ ਚੱਲ, ਆਓ ਜਲਦੀ ਕਰੀਏ!</para>
  <para style="q2" vid="SNG 1:4">ਰਾਜਾ ਮੈਨੂੰ ਆਪਣੇ ਮਹਿਲ ਵਿੱਚ ਲਿਆਇਆ।</para>
  <para style="sp" vid="SNG 1:4">ਦੋਸਤੋ</para>
  <para style="q1" vid="SNG 1:4">ਅਸੀਂ ਤੇਰੇ ਵਿੱਚ ਖੁਸ਼ ਅਤੇ ਅਨੰਦ ਹਾਂ,</para>
  <para style="q2" vid="SNG 1:4">ਅਸੀਂ ਤੇਰੇ ਪਿਆਰ ਦੀ ਦਾਖ਼ਰਸ ਨਾਲੋਂ ਵੱਧ ਉਸਤਤ ਕਰਾਂਗੇ।</para>
  <para style="sp" vid="SNG 1:4">ਨਾਇਕਾ</para>
  <para style="q1" vid="SNG 1:4">ਤੁਹਾਨੂੰ ਪਿਆਰ ਕਰਨਾ ਕਿੰਨਾ ਸਹੀ ਹੈ!<verse eid="SNG 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />ਹੇ ਯੇਰੂਸ਼ਲੇਮ ਦੀਓ ਧੀਓ,</para>
  <para style="q2" vid="SNG 1:5">ਮੈਂ ਕਾਲੀ ਹਾਂ ਪਰ ਸੋਹਣੀ ਹਾਂ,</para>
  <para style="q1" vid="SNG 1:5">ਕੇਦਾਰ ਦੇ ਤੰਬੂਆਂ ਵਰਗੀ,</para>
  <para style="q2" vid="SNG 1:5">ਸ਼ਲੋਮੋਨ ਦੇ ਤੰਬੂ ਦੇ ਪਰਦਿਆਂ ਵਰਗੀ।<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />ਮੇਰੇ ਵੱਲ ਨਾ ਤੱਕੋ ਕਿਉਂਕਿ ਮੈਂ ਕਾਲੀ ਹਾਂ,</para>
  <para style="q2" vid="SNG 1:6">ਕਿਉਂਕਿ ਸੂਰਜ ਨੇ ਮੈਨੂੰ ਝੁਲਸ ਦਿੱਤਾ।</para>
  <para style="q1" vid="SNG 1:6">ਮੇਰੇ ਭਰਾ ਮੇਰੇ ਨਾਲ ਨਾਰਾਜ਼ ਸਨ</para>
  <para style="q2" vid="SNG 1:6">ਅਤੇ ਮੈਨੂੰ ਅੰਗੂਰੀ ਬਾਗ ਦੀ ਦੇਖਭਾਲ ਕਰਨ ਲਈ ਕਿਹਾ,</para>
  <para style="q2" vid="SNG 1:6">ਮੈਂ ਤਾਂ ਖੁਦ ਹੀ ਆਪਣੇ ਅੰਗੂਰੀ ਬਾਗ ਦੀ ਰਾਖੀ ਨਾ ਕੀਤੀ।<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />ਤੂੰ ਮੈਨੂੰ ਦੱਸ, ਜਿਹਨੂੰ ਨੂੰ ਪਿਆਰ ਕਰਦੀ ਹਾਂ</para>
  <para style="q2" vid="SNG 1:7">ਤੂੰ ਆਪਣੇ ਇੱਜੜ ਨੂੰ ਕਿੱਥੇ ਚਰਾਉਂਦਾ ਹੈ,</para>
  <para style="q2" vid="SNG 1:7">ਅਤੇ ਦੁਪਹਿਰ ਵੇਲੇ ਤੂੰ ਆਪਣੀਆਂ ਭੇਡਾਂ ਨੂੰ ਕਿੱਥੇ ਆਰਾਮ ਦਿੰਦੇ ਹੈ?</para>
  <para style="q1" vid="SNG 1:7">ਮੈਂ ਤੇਰੇ ਦੋਸਤਾਂ ਦੇ ਇੱਜੜ ਦੇ ਕੋਲ ਇੱਕ ਘੁੰਡ ਵਾਲੀ ਤੀਵੀਂ ਵਾਂਗ ਕਿਉਂ ਰਹਾਂ?<verse eid="SNG 1:7" /></para>
  <para style="sp">ਮਿੱਤਰੋ</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />ਹੇ ਇਸਤਰੀਆਂ ਵਿੱਚੋਂ ਰੂਪਵੰਤੀਏ,</para>
  <para style="q2" vid="SNG 1:8">ਜੇ ਤੂੰ ਨਹੀਂ ਜਾਣਦੀ ਤਾਂ ਤੂੰ ਭੇਡਾਂ ਦੇ ਪਿੱਛੇ ਚਲ,</para>
  <para style="q1" vid="SNG 1:8">ਅਤੇ ਆਪਣੀਆਂ ਬੱਕਰੀਆਂ ਨੂੰ ਚਰਵਾਹਿਆਂ ਦੇ ਤੰਬੂਆਂ ਵਿੱਚ ਚਰਾ।<verse eid="SNG 1:8" /></para>
  <para style="sp">ਨਾਇਕ</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />ਹੇ ਮੇਰੇ ਪਿਆਰੇ, ਮੈਂ ਤੇਰੀ ਤੁਲਨਾ ਫ਼ਿਰਾਊਨ ਦੇ ਰਥ ਘੋੜਿਆਂ ਵਿੱਚੋਂ</para>
  <para style="q2" vid="SNG 1:9">ਇੱਕ ਘੋੜੀ ਨਾਲ ਕਰਦਾ ਹਾਂ।<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />ਤੇਰੀਆਂ ਗੱਲ੍ਹਾਂ ਗਹਿਣਿਆਂ ਨਾਲ ਸੋਹਣੀਆਂ ਹਨ,</para>
  <para style="q2" vid="SNG 1:10">ਤੇਰੀ ਗਰਦਨ ਹੀਰਿਆਂ ਦੇ ਹਾਰ ਨਾਲ।<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />ਅਸੀਂ ਤੇਰੇ ਲਈ ਸੋਨੇ ਦੇ,</para>
  <para style="q2" vid="SNG 1:11">ਹਾਰ ਚਾਂਦੀ ਦੇ ਫੁੱਲਾਂ ਨਾਲ ਬਣਾਵਾਂਗੇ।<verse eid="SNG 1:11" /></para>
  <para style="sp">ਨਾਇਕਾ</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />ਜਦੋਂ ਰਾਜਾ ਆਪਣੀ ਮੇਜ਼ ਉੱਤੇ ਸੀ,</para>
  <para style="q2" vid="SNG 1:12">ਮੇਰੇ ਅਤਰ ਨੇ ਆਪਣੀ ਖੁਸ਼ਬੂ ਫੈਲਾਈ।<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />ਮੇਰਾ ਪਿਆਰਾ ਮੇਰੇ ਲਈ ਗੰਧਰਸ ਦਾ ਇੱਕ ਥੈਲਾ ਹੈ,</para>
  <para style="q2" vid="SNG 1:13">ਜੋ ਮੇਰੀਆਂ ਛਾਤੀਆਂ ਵਿੱਚਕਾਰ ਅਰਾਮ ਕਰਦਾ ਹੈ।<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />ਮੇਰਾ ਪਿਆਰਾ ਮੇਰੇ ਲਈ ਮਹਿੰਦੀ ਦੇ ਫੁੱਲਾਂ ਦਾ ਗੁੱਛਾ ਹੈ,</para>
  <para style="q2" vid="SNG 1:14">ਜੋ ਏਨ ਗੇਦੀ ਦੇ ਬਗੀਚਿਆ ਵਿੱਚ ਹੈ।<verse eid="SNG 1:14" /></para>
  <para style="sp">ਨਾਇਕ</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />ਹੇ ਮੇਰੀ ਪ੍ਰੀਤਮਾ, ਤੂੰ ਕਿੰਨੀ ਸੋਹਣੀ ਹੈ!</para>
  <para style="q2" vid="SNG 1:15">ਓਹ, ਤੂੰ ਕਿੰਨਾ ਸੋਹਣਾ ਹੈ!</para>
  <para style="q2" vid="SNG 1:15">ਤੇਰੀਆਂ ਅੱਖਾਂ ਕਬੂਤਰੀ ਦੀਆਂ ਅੱਖਾਂ ਵਰਗੀਆਂ ਹਨ।<verse eid="SNG 1:15" /></para>
  <para style="sp">ਨਾਇਕਾ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />ਹੇ ਮੇਰੇ ਪਿਆਰੇ, ਤੂੰ ਕਿੰਨਾ ਸੋਹਣਾ ਹੈ!</para>
  <para style="q2" vid="SNG 1:16">ਓਹ, ਕਿੰਨਾ ਸੋਹਣਾ!</para>
  <para style="q2" vid="SNG 1:16">ਅਤੇ ਸਾਡਾ ਬਿਸਤਰਾ ਹਰਿਆ ਭਰਿਆ ਹੈ।<verse eid="SNG 1:16" /></para>
  <para style="sp">ਨਾਇਕ</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17" />ਸਾਡੇ ਘਰ ਦੇ ਸ਼ਤੀਰ ਦਿਆਰ ਦੇ ਹਨ,</para>
  <para style="q2" vid="SNG 1:17">ਅਤੇ ਸਨੋਵਰ ਦੀਆਂ ਛੱਤਾਂ ਹਨ।<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="sp">ਨਾਇਕਾ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />ਮੈਂ ਸ਼ਰੋਨ ਦਾ ਇੱਕ ਗੁਲਾਬ ਹਾਂ,</para>
  <para style="q2" vid="SNG 2:1">ਵਾਦੀਆਂ ਦੀ ਸੋਸਨ ਹਾਂ।<verse eid="SNG 2:1" /></para>
  <para style="sp">ਨਾਇਕ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />ਉਹ ਕੰਡਿਆਂ ਵਿੱਚ ਸੋਸਨ ਵਾਂਗ</para>
  <para style="q2" vid="SNG 2:2">ਉਸੇ ਤਰ੍ਹਾਂ ਮੁਟਿਆਰਾਂ ਵਿੱਚ ਮੇਰਾ ਪਿਆਰਾ ਹੈ।<verse eid="SNG 2:2" /></para>
  <para style="sp">ਨਾਇਕਾ</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />ਜਿਸ ਤਰ੍ਹਾਂ ਸੇਬ ਦਾ ਰੁੱਖ ਜੰਗਲ ਵਿੱਚ ਰੁੱਖਾਂ ਦੇ ਵਿੱਚਕਾਰ ਹੈ,</para>
  <para style="q2" vid="SNG 2:3">ਉਸੇ ਤਰ੍ਹਾਂ ਮੇਰਾ ਪ੍ਰੇਮੀ ਜਵਾਨਾਂ ਦੇ ਵਿੱਚ ਹੈ।</para>
  <para style="q1" vid="SNG 2:3">ਮੈਂ ਉਸ ਦੀ ਛਾਂ ਵਿੱਚ ਬੈਠ ਕੇ ਅਨੰਦ ਹੁੰਦੀ ਹਾਂ,</para>
  <para style="q2" vid="SNG 2:3">ਅਤੇ ਉਸ ਦਾ ਫਲ ਮੈਨੂੰ ਖਾਣ ਵਿੱਚ ਮਿੱਠਾ ਲੱਗਦਾ ਸੀ।<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />ਉਹ ਮੈਨੂੰ ਦਾਅਵਤ ਦੇ ਹਾਲ ਵਿੱਚ ਲੈ ਜਾਵੇ,</para>
  <para style="q2" vid="SNG 2:4">ਉਸਦੇ ਪਿਆਰ ਦਾ ਝੰਡਾ ਮੇਰੇ ਉੱਪਰ ਸੀ।<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />ਕਿਸ਼ਮਿਸ਼ ਨਾਲ ਮੈਨੂੰ ਤਕੜਾ ਕਰ,</para>
  <para style="q2" vid="SNG 2:5">ਸੇਬਾਂ ਨਾਲ ਮੈਨੂੰ ਤਰੋ ਤਾਜ਼ਾ ਕਰ,</para>
  <para style="q2" vid="SNG 2:5">ਕਿਉਂਕਿ ਮੈਨੂੰ ਤੇਰੇ ਪਿਆਰ ਦਾ ਰੋਗ ਲਗ ਗਿਆ ਹੈ।<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />ਉਸਦੀ ਖੱਬੀ ਬਾਂਹ ਮੇਰੇ ਸਿਰ ਦੇ ਹੇਠਾਂ ਹੈ,</para>
  <para style="q2" vid="SNG 2:6">ਅਤੇ ਉਸਦੀ ਸੱਜੀ ਬਾਂਹ ਗਲੇ ਲੱਗਦੀ ਹੈ।<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />ਹੇ ਯੇਰੂਸ਼ਲੇਮ ਦੀ ਧੀਓ,</para>
  <para style="q2" vid="SNG 2:7">ਮੈਂ ਤੁਹਾਨੂੰ ਖੇਤ ਦੇ ਹਿਰਨ ਅਤੇ ਹਿਰਨ ਦੀ ਸਹੁੰ, ਮੇਰੇ ਨਾਲ ਵਾਅਦਾ ਕਰੋ:</para>
  <para style="q1" vid="SNG 2:7">ਪਿਆਰ ਨੂੰ ਨਾ ਉਕਸਾਓ ਅਤੇ ਨਾ ਜਗਾਓ</para>
  <para style="q2" vid="SNG 2:7">ਜਦੋਂ ਤੱਕ ਇਹ ਇੱਛਾ ਨਾ ਕਰੇ।<verse eid="SNG 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />ਸੁਣੋ! ਮੇਰਾ ਪਿਆਰਾ!</para>
  <para style="q2" vid="SNG 2:8">ਦੇਖੋ! ਇੱਥੇ ਉਹ ਆਉਂਦਾ ਹੈ,</para>
  <para style="q1" vid="SNG 2:8">ਪਹਾੜਾਂ ਨੂੰ ਪਾਰ ਕਰਦਾ ਹੋਇਆ,</para>
  <para style="q2" vid="SNG 2:8">ਅਤੇ ਟਿੱਲਿਆਂ ਦੇ ਉੱਪਰੋ ਕੁੱਦਦਾ ਹੋਇਆ!<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />ਮੇਰਾ ਪਿਆਰਾ ਜਵਾਨ ਹਿਰਨ ਵਰਗਾ ਹੈ।</para>
  <para style="q2" vid="SNG 2:9">ਦੇਖੋ! ਉੱਥੇ ਉਹ ਸਾਡੀ ਕੰਧ ਦੇ ਪਿੱਛੇ ਖੜ੍ਹਾ ਹੈ,</para>
  <para style="q1" vid="SNG 2:9">ਖਿੜਕੀਆਂ ਵਿੱਚੋਂ ਦੇਖਦਾ ਹੈ,</para>
  <para style="q2" vid="SNG 2:9">ਜਾਲੀ ਵਿੱਚੋਂ ਦੇਖਦਾ ਹੈ।<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />ਮੇਰੇ ਪਿਆਰੇ ਨੇ ਮੈਨੂੰ ਆਖਿਆ,</para>
  <para style="q2" vid="SNG 2:10">“ਉੱਠ, ਮੇਰੀ ਪਿਆਰੀ,</para>
  <para style="q2" vid="SNG 2:10">ਮੇਰੀ ਸੋਹਣੀ, ਮੇਰੇ ਨਾਲ ਆ।<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />ਵੇਖੋ! ਸਰਦੀ ਬੀਤ ਗਈ ਹੈ;</para>
  <para style="q2" vid="SNG 2:11">ਬਾਰਸ਼ ਖਤਮ ਹੋ ਗਈ ਹੈ।<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />ਧਰਤੀ ਉੱਤੇ ਫੁੱਲ ਦਿਖਾਈ ਦਿੰਦੇ ਹਨ;</para>
  <para style="q2" vid="SNG 2:12">ਗਾਉਣ ਦੀ ਰੁੱਤ ਆ ਗਈ ਹੈ,</para>
  <para style="q1" vid="SNG 2:12">ਕਬੂਤਰਾਂ ਦੀ ਆਵਾਜ਼</para>
  <para style="q2" vid="SNG 2:12">ਸਾਡੀ ਧਰਤੀ ਵਿੱਚ ਸੁਣਾਈ ਦਿੰਦੀ ਹੈ।<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />ਹੰਜੀਰ ਦਾ ਰੁੱਖ ਆਪਣਾ ਅਗੇਤਾ ਫਲ ਦਿੰਦਾ ਹੈ।</para>
  <para style="q2" vid="SNG 2:13">ਖਿੜਦੀਆਂ ਵੇਲਾਂ ਨੇ ਆਪਣੀ ਮਹਿਕ ਫੈਲਾਈ।</para>
  <para style="q1" vid="SNG 2:13">ਉੱਠ, ਮੇਰੀ ਪਿਆਰੀ, ਆ;</para>
  <para style="q2" vid="SNG 2:13">ਮੇਰੀ ਸੋਹਣੀ, ਮੇਰੇ ਨਾਲ ਆ।”<verse eid="SNG 2:13" /></para>
  <para style="sp">ਨਾਇਕ</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />ਮੇਰੀ ਕਬੂਤਰੀਏ ਜਿਹੜੀ ਚੱਟਾਨਾ ਦੀਆਂ ਦਰਾਰਾ ਵਿੱਚ,</para>
  <para style="q2" vid="SNG 2:14">ਪਹਾੜਾਂ ਦੇ ਛੁਪਣ ਦੇ ਸਥਾਨਾਂ ਵਿੱਚ,</para>
  <para style="q1" vid="SNG 2:14">ਮੈਨੂੰ ਆਪਣਾ ਮੂੰਹ ਵਿਖਾ,</para>
  <para style="q2" vid="SNG 2:14">ਮੈਨੂੰ ਆਪਣੀ ਆਵਾਜ਼ ਸੁਣਨ ਦੇ;</para>
  <para style="q1" vid="SNG 2:14">ਤੁਹਾਡੀ ਆਵਾਜ਼ ਮਿੱਠੀ ਹੈ,</para>
  <para style="q2" vid="SNG 2:14">ਅਤੇ ਤੇਰਾ ਚਿਹਰਾ ਪਿਆਰਾ ਹੈ।<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />ਸਾਡੇ ਲਈ ਲੂੰਬੜੀਆਂ ਨੂੰ ਫੜੋ,</para>
  <para style="q2" vid="SNG 2:15">ਸਗੋਂ ਛੋਟੀਆਂ ਲੂੰਬੜੀਆਂ ਨੂੰ</para>
  <para style="q1" vid="SNG 2:15">ਜੋ ਅੰਗੂਰੀ ਬਾਗ਼ਾਂ ਨੂੰ ਉਜਾੜ ਦਿੰਦੀਆਂ ਹਨ,</para>
  <para style="q2" vid="SNG 2:15">ਸਾਡੇ ਅੰਗੂਰੀ ਬਾਗ ਜੋ ਖਿੜੇ ਹੋਏ ਹਨ।<verse eid="SNG 2:15" /></para>
  <para style="sp">ਨਾਇਕਾ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />ਮੇਰਾ ਪਿਆਰਾ ਮੇਰਾ ਹੈ ਅਤੇ ਮੈਂ ਉਸਦੀ ਹਾਂ।</para>
  <para style="q2" vid="SNG 2:16">ਉਹ ਸੋਸਨ ਦੇ ਫੁੱਲਾਂ ਵਿਚਕਾਰ ਆਪਣੀਆਂ ਭੇਡਾਂ ਅਤੇ ਬੱਕਰੀਆਂ ਚਰਾਉਂਦਾ ਹੈ।<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />ਜਦ ਤੱਕ ਦਿਨ ਢਲ ਨਾ ਜਾਵੇ,</para>
  <para style="q2" vid="SNG 2:17">ਅਤੇ ਪਰਛਾਵੇਂ ਭੱਜ ਨਾ ਜਾ,</para>
  <para style="q1" vid="SNG 2:17">ਮੇਰੇ ਪਿਆਰੇ ਮੁੜ,</para>
  <para style="q2" vid="SNG 2:17">ਅਤੇ ਇੱਕ ਚਿਕਾਰੇ ਵਾਂਗੂੰ ਅਤੇ</para>
  <para style="q1" vid="SNG 2:17">ਜਵਾਨ ਹਿਰਨ ਵਾਂਗ ਬਣ</para>
  <para style="q2" vid="SNG 2:17">ਜੋ ਬਥਰ ਦੇ ਪਹਾੜਾਂ ਉੱਤੇ ਫਿਰਦਾ ਹੈ।<verse eid="SNG 2:17" /></para>
  <para style="b" />
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />ਸਾਰੀ ਰਾਤ ਮੈਂ ਆਪਣੇ ਬਿਸਤਰੇ ਤੇ</para>
  <para style="q2" vid="SNG 3:1">ਉਸ ਨੂੰ ਲੱਭਦਾ ਰਿਹਾ ਜਿਸਨੂੰ ਮੇਰਾ ਦਿਲ ਪਿਆਰ ਕਰਦਾ ਹੈ,</para>
  <para style="q2" vid="SNG 3:1">ਮੈਂ ਉਸ ਨੂੰ ਲੱਭਿਆ ਪਰ ਉਹ ਨਾ ਲੱਭਿਆ।<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />ਮੈਂ ਹੁਣ ਉੱਠ ਕੇ ਸ਼ਹਿਰ</para>
  <para style="q2" vid="SNG 3:2">ਅਤੇ ਇਸ ਦੀਆਂ ਗਲੀਆਂ ਅਤੇ ਚੌਕਾਂ ਵਿੱਚ ਘੁੰਮਾਂਗੀ,</para>
  <para style="q1" vid="SNG 3:2">ਮੈਂ ਉਸ ਨੂੰ ਲੱਭਾਂਗੀ ਜਿਸਨੂੰ ਮੇਰਾ ਦਿਲ ਪਿਆਰ ਕਰਦਾ ਹੈ।</para>
  <para style="q2" vid="SNG 3:2">ਇਸ ਲਈ ਮੈਂ ਉਸਨੂੰ ਲੱਭਿਆ ਪਰ ਉਹ ਨਾ ਲੱਭਿਆ।<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />ਪਹਿਰੇਦਾਰਾਂ ਨੇ ਮੈਨੂੰ ਲੱਭ ਲਿਆ,</para>
  <para style="q2" vid="SNG 3:3">ਜਦੋਂ ਉਹ ਸ਼ਹਿਰ ਵਿੱਚ ਚੱਕਰ ਲਗਾ ਰਹੇ ਸੀ।</para>
  <para style="q2" vid="SNG 3:3">“ਕੀ ਤੁਸੀਂ ਉਸਨੂੰ ਦੇਖਿਆ ਹੈ ਜਿਸਨੂੰ ਮੇਰਾ ਦਿਲ ਪਿਆਰ ਕਰਦਾ ਹੈ?”<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />ਮੈਂ ਉਹਨਾਂ ਤੋਂ ਥੋੜ੍ਹਾ ਹੀ ਅੱਗੇ ਲੰਘੀ ਸੀ,</para>
  <para style="q2" vid="SNG 3:4">ਕਿ ਜਦੋਂ ਮੈਨੂੰ ਉਹ ਮਿਲਿਆ ਜਿਸਨੂੰ ਮੇਰਾ ਦਿਲ ਪਿਆਰ ਕਰਦਾ ਸੀ।</para>
  <para style="q1" vid="SNG 3:4">ਮੈਂ ਉਸਨੂੰ ਫੜ ਲਿਆ ਅਤੇ ਉਸਨੂੰ ਉਦੋਂ ਤੱਕ ਨਹੀਂ ਜਾਣ ਦਿੱਤਾ,</para>
  <para style="q2" vid="SNG 3:4">ਜਦੋਂ ਤੱਕ ਮੈਂ ਉਸਨੂੰ ਆਪਣੀ ਮਾਂ ਦੇ ਘਰ ਨਹੀਂ ਲੈ ਆਈ,</para>
  <para style="q2" vid="SNG 3:4">ਉਸ ਦੇ ਕਮਰੇ ਵਿੱਚ ਜਿਸ ਵਿੱਚ ਮੇਰੀ ਮਾਂ ਨੇ ਮੈਨੂੰ ਜਨਮ ਦਿੱਤਾ ਸੀ।<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />ਹੇ ਯੇਰੂਸ਼ਲੇਮ ਦੀ ਧੀਓ,</para>
  <para style="q2" vid="SNG 3:5">ਮੈਂ ਤੁਹਾਨੂੰ ਚਕਾਰਿਆਂ ਅਤੇ ਖੇਤ ਦੀਆਂ ਹਿਰਨੀਆਂ ਦੀ ਸਹੁੰ ਚੁਕਾਉਂਦੀ ਹਾਂ,</para>
  <para style="q1" vid="SNG 3:5">ਤੁਸੀਂ ਪਿਆਰ ਨੂੰ ਨਾ ਉਕਸਾਓ, ਨਾ ਜਗਾਓ,</para>
  <para style="q2" vid="SNG 3:5">ਜਦੋਂ ਤੱਕ ਸਹੀ ਸਮਾਂ ਨਹੀਂ ਆਉਂਦਾ।<verse eid="SNG 3:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />ਇਹ ਕੌਣ ਹੈ ਜੋ ਉਜਾੜ ਵਿੱਚੋਂ,</para>
  <para style="q2" vid="SNG 3:6">ਧੂੰਏਂ ਦੇ ਥੰਮ੍ਹਾਂ ਵਾਂਗੂੰ,</para>
  <para style="q1" vid="SNG 3:6">ਗੰਧਰਸ ਅਤੇ ਲੁਬਾਨ ਦੀ ਸੁਗੰਧੀ ਨਾਲ</para>
  <para style="q1" vid="SNG 3:6">ਅਤੇ ਵਪਾਰੀਆਂ ਦੇ ਸਾਰੇ ਮਸਾਲਿਆਂ ਨਾਲ ਆਉਂਦਾ?<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />ਵੇਖੋ! ਇਹ ਸ਼ਲੋਮੋਨ ਦੀ ਪਾਲਕੀ ਹੈ,</para>
  <para style="q2" vid="SNG 3:7">ਜਿਸਦੇ ਆਲੇ-ਦੁਆਲੇ ਸੱਠ ਸੂਰਮੇ ਹਨ,</para>
  <para style="q2" vid="SNG 3:7">ਜਿਹੜੇ ਇਸਰਾਏਲ ਵਿੱਚੋਂ ਸਭ ਤੋਂ ਉੱਤਮ ਹਨ।<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />ਉਹ ਸਾਰੇ ਤਲਵਾਰ ਧਾਰੀ ਹਨ,</para>
  <para style="q2" vid="SNG 3:8">ਸਾਰੇ ਯੁੱਧ ਵਿੱਚ ਨਿਪੁੰਨ ਹਨ,</para>
  <para style="q1" vid="SNG 3:8">ਰਾਤ ਦੇ ਡਰ ਕਰਕੇ ਹਰੇਕ ਨੇ ਆਪਣੀ ਤਲਵਾਰ,</para>
  <para style="q2" vid="SNG 3:8">ਆਪਣੇ ਕੋਲ ਰੱਖੀ ਹੋਈ ਹੈ।<verse eid="SNG 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />ਰਾਜਾ ਸ਼ਲੋਮੋਨ ਨੇ ਆਪਣੇ ਲਈ ਪਾਲਕੀ ਬਣਾਈ,</para>
  <para style="q2" vid="SNG 3:9">ਉਸਨੇ ਇਸਨੂੰ ਲਬਾਨੋਨ ਦੀ ਲੱਕੜ ਤੋਂ ਬਣਾਇਆ।<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />ਉਸਨੇ ਉਸਦੇ ਥੰਮ੍ਹ ਚਾਂਦੀ,</para>
  <para style="q2" vid="SNG 3:10">ਉਸ ਦਾ ਅਧਾਰ ਸੋਨੇ ਦਾ,</para>
  <para style="q1" vid="SNG 3:10">ਅਤੇ ਉਸ ਦੀ ਗੱਦੀ ਬੈਂਗਣੀ ਰੰਗ ਦੀ ਬਣਵਾਈ ਸੀ,</para>
  <para style="q2" vid="SNG 3:10">ਉਸ ਦਾ ਅੰਦਰਲਾ ਹਿੱਸਾ ਯੇਰੂਸ਼ਲੇਮ ਦੀਆ ਧੀਆਂ ਦੁਆਰਾ,</para>
  <para style="q1" vid="SNG 3:10">ਬੜੇ ਪਿਆਰ ਨਾਲ ਜੜਿਆ ਗਿਆ ਸੀ। <verse eid="SNG 3:10" /><verse number="11" style="v" sid="SNG 3:11" />ਹੇ ਸੀਯੋਨ ਦੀਓ ਧੀਓ!</para>
  <para style="q2" vid="SNG 3:11">ਬਾਹਰ ਆਓ ਅਤੇ ਰਾਜਾ ਸ਼ਲੋਮੋਨ ਨੂੰ</para>
  <para style="q1" vid="SNG 3:11">ਇੱਕ ਤਾਜ ਪਹਿਨੇ ਹੋਏ ਵੇਖੋ,</para>
  <para style="q2" vid="SNG 3:11">ਉਹ ਤਾਜ ਜਿਹੜਾ ਉਸਦੀ ਮਾਤਾ ਨੇ ਉਸਨੂੰ ਪਹਿਨਾਇਆ ਸੀ</para>
  <para style="q1" vid="SNG 3:11">ਉਸਦੇ ਵਿਆਹ ਦੇ ਦਿਨ ਤੇ,</para>
  <para style="q2" vid="SNG 3:11">ਜਿਸ ਦਿਨ ਉਸਦਾ ਮਨ ਖੁਸ਼ ਸੀ।<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">ਨਾਇਕ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />ਹੇ ਮੇਰੀ ਪਿਆਰੀ, ਤੂੰ ਕਿੰਨੀ ਸੋਹਣੀ ਹੈ!</para>
  <para style="q2" vid="SNG 4:1">ਹੇ, ਤੂੰ ਕਿੰਨੀ ਸੋਹਣੀ ਹੈ!</para>
  <para style="q2" vid="SNG 4:1">ਤੇਰੀਆਂ ਅੱਖਾਂ ਤੇਰੇ ਘੁੰਡ ਦੇ ਹੇਠ ਕਬੂਤਰ ਵਰਗੀਆਂ ਹਨ,</para>
  <para style="q1" vid="SNG 4:1">ਤੇਰੇ ਵਾਲ ਗਿਲਆਦ ਦੀਆਂ,</para>
  <para style="q2" vid="SNG 4:1">ਪਹਾੜੀਆਂ ਤੋਂ ਉੱਤਰਦੇ ਬੱਕਰੀਆਂ ਦੇ ਇੱਜੜ ਵਰਗੇ ਹਨ।<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />ਤੇਰੇ ਦੰਦ ਮੁੰਨੀਆ ਹੋਈਆਂ ਭੇਡਾਂ ਦੇ ਇੱਜੜ ਵਾਂਗੂੰ ਹਨ,</para>
  <para style="q2" vid="SNG 4:2">ਜਿਹੜੀਆਂ ਨਹਾ ਕੇ ਉੱਪਰ ਆਈਆਂ ਹਨ,</para>
  <para style="q1" vid="SNG 4:2">ਅਤੇ ਹਰੇਕ ਦੇ ਆਪਣੇ ਜੁੜਵਾਂ ਬੱਚੇ ਹਨ,</para>
  <para style="q2" vid="SNG 4:2">ਉਹਨਾਂ ਵਿੱਚੋਂ ਕੋਈ ਵੀ ਇਕੱਲੀ ਨਹੀਂ ਹੈ।<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />ਤੇਰੇ ਬੁੱਲ ਲਾਲ ਰੰਗ ਦੀ ਡੋਰੀ ਵਰਗੇ ਹਨ,</para>
  <para style="q2" vid="SNG 4:3">ਤੇਰੀ ਬੋਲੀ ਕਿੰਨੀ ਪਿਆਰੀ ਹੈ,</para>
  <para style="q1" vid="SNG 4:3">ਤੇਰੀਆਂ ਗੱਲਾਂ ਘੁੰਡ ਦੇ ਹੇਠ</para>
  <para style="q2" vid="SNG 4:3">ਅਨਾਰ ਦੇ ਟੁਕੜਿਆਂ ਵਾਗੂੰ ਹਨ।<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />ਤੇਰੀ ਗਰਦਨ ਦਾਵੀਦ ਦੇ ਬੁਰਜ ਵਰਗੀ ਹੈ,</para>
  <para style="q2" vid="SNG 4:4">ਜੋ ਪੱਥਰਾਂ ਨਾਲ ਬਣੀ ਹੋਈ ਹੈ,</para>
  <para style="q1" vid="SNG 4:4">ਉਸ ਉੱਤੇ ਹਜ਼ਾਰਾਂ ਢਾਲਾਂ ਲਟਕਦੀਆਂ ਹਨ,</para>
  <para style="q2" vid="SNG 4:4">ਉਹ ਸਾਰੀਆਂ ਯੋਧਿਆਂ ਦੀਆਂ ਢਾਲਾਂ ਹਨ।<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />ਤੇਰੀਆਂ ਦੋਵੇਂ ਛਾਤੀਆਂ ਹਿਰਨੀ ਦੇ ਜੁੜਵਾਂ ਬੱਚਿਆਂ ਵਰਗੀਆਂ ਹਨ,</para>
  <para style="q2" vid="SNG 4:5">ਜਿਹੜੀਆਂ ਸੋਸਨਾ ਵਿੱਚ ਚੁਗਦੀਆਂ ਹਨ।<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />ਜਦ ਤੱਕ ਦਿਨ ਨਹੀਂ ਢਲਦਾ ਹੈ</para>
  <para style="q2" vid="SNG 4:6">ਅਤੇ ਪਰਛਾਵੇਂ ਭੱਜ ਨਹੀਂ ਜਾਂਦੇ,</para>
  <para style="q1" vid="SNG 4:6">ਮੈਂ ਗੰਧਰਸ ਦੇ ਪਹਾੜ</para>
  <para style="q2" vid="SNG 4:6">ਅਤੇ ਧੂਪ ਦੇ ਪਹਾੜ ਉੱਤੇ ਚਲਾ ਜਾਵਾਂਗਾ।<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />ਹੇ ਮੇਰੀ ਪਿਆਰੀ, ਤੂੰ ਸਾਰੀ ਦੀ ਸਾਰੀ ਸੁੰਦਰ ਹੈ,</para>
  <para style="q2" vid="SNG 4:7">ਤੇਰੇ ਵਿੱਚ ਕੋਈ ਕਮੀ ਨਹੀਂ ਹੈ।<verse eid="SNG 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />ਹੇ ਮੇਰੀ ਲਾੜੀ, ਤੂੰ ਲਬਾਨੋਨ ਤੋਂ ਮੇਰੇ ਨਾਲ ਚੱਲ,</para>
  <para style="q2" vid="SNG 4:8">ਲਬਾਨੋਨ ਤੋਂ ਮੇਰੇ ਨਾਲ ਆ।</para>
  <para style="q1" vid="SNG 4:8">ਅਮਾਨਾ ਦੀ ਚੋਟੀ ਤੋਂ,</para>
  <para style="q2" vid="SNG 4:8">ਸਨੀਰ ਦੀ ਚੋਟੀ ਤੋਂ, ਹਰਮੋਨ ਦੀ ਸਿਖਰ ਤੋਂ,</para>
  <para style="q1" vid="SNG 4:8">ਸ਼ੇਰਾਂ ਦੇ ਘੋਰਨਿਆ ਤੋਂ</para>
  <para style="q2" vid="SNG 4:8">ਅਤੇ ਚੀਤਿਆਂ ਦੇ ਪਹਾੜੀ ਟਿਕਾਣਿਆਂ ਤੋਂ।<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />ਹੇ ਪਿਆਰੀ ਮੇਰੀ ਵਹੁਟੀ, ਤੂੰ ਮੇਰਾ ਦਿਲ ਚੁਰਾ ਲਿਆ ਹੈ,</para>
  <para style="q2" vid="SNG 4:9">ਤੇਰੀਆਂ ਅੱਖਾਂ ਦੀ ਇੱਕ ਝਲਕ ਨਾਲ</para>
  <para style="q1" vid="SNG 4:9">ਆਪਣੀ ਗਰਦਨ ਦੀ ਮਾਲਾ ਦੇ ਇੱਕ ਮੋਤੀ ਨਾਲ</para>
  <para style="q2" vid="SNG 4:9">ਤੂੰ ਮੇਰਾ ਦਿਲ ਚੁਰਾ ਲਿਆ ਹੈ।<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />ਹੇ ਮੇਰੀ ਪਿਆਰੀ, ਮੇਰੀ ਵਹੁਟੀ, ਤੇਰਾ ਪਿਆਰ ਕਿੰਨਾ ਪ੍ਰਸੰਨ ਹੈ!</para>
  <para style="q2" vid="SNG 4:10">ਤੇਰਾ ਪਿਆਰ ਦਾਖ਼ਰਸ ਨਾਲੋਂ,</para>
  <para style="q1" vid="SNG 4:10">ਅਤੇ ਤੇਰੀ ਅਤਰ ਦੀ ਸੁਗੰਧ</para>
  <para style="q2" vid="SNG 4:10">ਸਾਰਿਆ ਮਸਾਲੇ ਨਾਲੋਂ ਕਿੰਨੀ ਚੰਗੀ ਹੈ!<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />ਹੇ ਮੇਰੀ ਵਹੁਟੀ, ਤੇਰੇ ਬੁੱਲ੍ਹਾਂ ਤੋਂ ਮਿਠਾਸ ਨਿਕਲਦੀ ਹੈ,</para>
  <para style="q2" vid="SNG 4:11">ਦੁੱਧ ਅਤੇ ਸ਼ਹਿਦ ਤੇਰੀ ਜੀਭ ਦੇ ਹੇਠਾਂ ਹਨ,</para>
  <para style="q1" vid="SNG 4:11">ਤੇਰੇ ਕੱਪੜਿਆਂ ਦੀ ਖੁਸ਼ਬੂ</para>
  <para style="q2" vid="SNG 4:11">ਲਬਾਨੋਨ ਦੀ ਖੁਸ਼ਬੂ ਵਰਗੀ ਹੈ।<verse eid="SNG 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />ਹੇ ਮੇਰੀ ਪਿਆਰੀ, ਮੇਰੀ ਵਹੁਟੀ, ਤੂੰ ਇੱਕ ਬੰਦ ਕੀਤੇ ਹੋਏ ਬਗੀਚੇ ਵਰਗੀ ਹੈ,</para>
  <para style="q2" vid="SNG 4:12">ਤੂੰ ਇੱਕ ਬੰਦ ਕੀਤਾ ਹੋਇਆ ਝਰਨਾ ਹੈ, ਇੱਕ ਮੋਹਰ ਲਾਇਆ ਹੋਇਆ ਚਸ਼ਮਾ ਹੈ।<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />ਤੇਰੇ ਪੌਦੇ ਅਨਾਰ ਦੇ ਬਾਗ ਹਨ</para>
  <para style="q2" vid="SNG 4:13">ਚੰਗੇ ਫਲਾਂ ਨਾਲ,</para>
  <para style="q2" vid="SNG 4:13">ਮਹਿੰਦੀ ਅਤੇ ਨਾਰਦ,<verse eid="SNG 4:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="SNG 4:14" />ਨਾਰਦ ਅਤੇ ਕੇਸਰ,</para>
  <para style="q2" vid="SNG 4:14">ਕੈਲਾਮਸ ਅਤੇ ਦਾਲਚੀਨੀ,</para>
  <para style="q2" vid="SNG 4:14">ਹਰ ਕਿਸਮ ਦੇ ਧੂਪ ਦੇ ਰੁੱਖਾਂ ਨਾਲ, ਗੰਧਰਸ ਅਤੇ ਐਲੋਜ਼ ਨਾਲ,</para>
  <para style="q2" vid="SNG 4:14">ਅਤੇ ਸਾਰੇ ਵਧੀਆ ਮਸਾਲੇ ਹੁੰਦੇ ਹਨ।<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />ਤੁਸੀਂ ਇੱਕ ਬਾਗ ਦਾ ਚਸ਼ਮਾ ਹੋ,</para>
  <para style="q2" vid="SNG 4:15">ਵਗਦੇ ਪਾਣੀ ਦਾ ਇੱਕ ਖੂਹ</para>
  <para style="q2" vid="SNG 4:15">ਜੋ ਲਬਾਨੋਨ ਤੋਂ ਵਗਦਾ ਹੈ।<verse eid="SNG 4:15" /></para>
  <para style="sp">ਨਾਇਕਾ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />ਜਾਗ, ਉੱਤਰੀ ਹਵਾ,</para>
  <para style="q2" vid="SNG 4:16">ਅਤੇ ਆ, ਦੱਖਣ ਹਵਾ!</para>
  <para style="q1" vid="SNG 4:16">ਮੇਰੇ ਬਾਗ ਉੱਤੇ ਵਗ,</para>
  <para style="q2" vid="SNG 4:16">ਤਾਂ ਜੋ ਉਹ ਦੀ ਖੁਸ਼ਬੂ ਹਰ ਪਾਸੇ ਫੈਲ ਜਾਵੇ।</para>
  <para style="q1" vid="SNG 4:16">ਮੇਰੇ ਪਿਆਰੇ ਨੂੰ ਉਸ ਦੇ ਬਾਗ ਵਿੱਚ ਆਉਣ ਦਿਓ</para>
  <para style="q2" vid="SNG 4:16">ਅਤੇ ਆਪਣੇ ਮਨ ਪਸੰਦ ਦੇ ਫਲ ਖਾਵੇ।<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">ਨਾਇਕ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />ਹੇ ਮੇਰੀ ਪਿਆਰੀ, ਮੇਰੀ ਵਹੁਟੀਏ, ਮੈਂ ਆਪਣੇ ਬਾਗ ਵਿੱਚ ਆਇਆ ਹਾਂ,</para>
  <para style="q2" vid="SNG 5:1">ਮੈਂ ਆਪਣਾ ਗੰਧਰਸ ਆਪਣੇ ਮਸਾਲੇ ਸਮੇਤ ਇਕੱਠਾ ਕਰ ਲਿਆ ਹੈ,</para>
  <para style="q1" vid="SNG 5:1">ਮੈਂ ਸ਼ਹਿਦ ਦਾ ਛੱਤਾ ਸ਼ਹਿਦ ਦੇ ਸਮੇਤ ਖਾ ਲਿਆ ਹੈ,</para>
  <para style="q2" vid="SNG 5:1">ਮੈਂ ਆਪਣੀ ਦਾਖ਼ਰਸ ਅਤੇ ਦੁੱਧ ਪੀ ਲਿਆ ਹੈ।</para>
  <para style="sp" vid="SNG 5:1">ਦੋਸਤ</para>
  <para style="q1" vid="SNG 5:1">ਦੋਸਤੋ ਖਾਓ ਅਤੇ ਪੀਓ</para>
  <para style="q2" vid="SNG 5:1">ਪਿਆਰ ਦੇ ਨਸ਼ੇ ਨਾਲ ਭਰੋ।<verse eid="SNG 5:1" /></para>
  <para style="sp">ਨਾਇਕਾ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />ਮੈਂ ਸੁੱਤੀ ਪਈ ਸੀ ਪਰ ਮੇਰਾ ਮਨ ਜਾਗਦਾ ਸੀ,</para>
  <para style="q2" vid="SNG 5:2">ਸੁਣੋ! ਮੇਰਾ ਪਿਆਰਾ ਬਾਲਮ ਖੜਕਾਉਂਦਾ ਹੈ,</para>
  <para style="q1" vid="SNG 5:2">“ਮੇਰੇ ਲਈ ਖੋਲ੍ਹ, ਮੇਰੀ ਪਿਆਰੀ, ਮੇਰੀ ਸੋਹਣੀ,</para>
  <para style="q2" vid="SNG 5:2">ਮੇਰੀ ਕਬੂਤਰੀ, ਮੇਰੀ ਨਿਰਦੋਸ਼।</para>
  <para style="q1" vid="SNG 5:2">ਮੇਰਾ ਸਿਰ ਤ੍ਰੇਲ ਨਾਲ ਭਰਿਆ ਹੋਇਆ ਹੈ,</para>
  <para style="q2" vid="SNG 5:2">ਅਤੇ ਮੇਰੇ ਵਾਲ ਰਾਤ ਦੀਆਂ</para>
  <para style="q2" vid="SNG 5:2">ਬੂੰਦਾਂ ਨਾਲ ਭਿੱਜ ਗਏ ਹਨ।”<verse eid="SNG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />ਮੈਂ ਆਪਣਾ ਚੋਗਾ ਲਾਹ ਲਿਆ ਹੈ,</para>
  <para style="q2" vid="SNG 5:3">ਕੀ ਮੈਨੂੰ ਇਹ ਫਿਰ ਪਹਿਨਣਾ ਚਾਹੀਦਾ ਹੈ?</para>
  <para style="q1" vid="SNG 5:3">ਮੈਂ ਆਪਣੇ ਪੈਰ ਧੋ ਲਏ ਹਨ,</para>
  <para style="q2" vid="SNG 5:3">ਕੀ ਮੈਂ ਉਨ੍ਹਾਂ ਨੂੰ ਫਿਰ ਮੈਲੇ ਕਰਾਂ?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />ਮੇਰੇ ਪਿਆਰੇ ਨੇ ਦਰਵਾਜ਼ੇ ਦੀ ਕੁੰਡੀ ਖੋਲ੍ਹਣ ਲਈ ਹੱਥ ਮੇਰੀ ਵੱਲ ਕੀਤਾ,</para>
  <para style="q2" vid="SNG 5:4">ਮੇਰਾ ਦਿਲ ਉਸ ਲਈ ਧੜਕਣ ਲੱਗਾ।<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />ਮੈਂ ਆਪਣੇ ਪ੍ਰੀਤਮ ਲਈ ਦਰਵਾਜ਼ਾ ਖੋਲ੍ਹਣ ਲਈ ਉੱਠੀ,</para>
  <para style="q2" vid="SNG 5:5">ਅਤੇ ਮੇਰੇ ਹੱਥਾਂ ਵਿੱਚ ਗੰਧਰਸ ਟਪਕਿਆ,</para>
  <para style="q1" vid="SNG 5:5">ਉਹ ਗੰਧਰਸ ਮੇਰੀਆਂ ਉਂਗਲਾਂ ਤੋਂ</para>
  <para style="q2" vid="SNG 5:5">ਅਤੇ ਦਰਵਾਜ਼ੇ ਦੇ ਕੁੰਡੇ ਉੱਤੇ ਵਗਿਆ।<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />ਮੈਂ ਆਪਣੇ ਪ੍ਰੀਤਮ ਲਈ ਖੋਲ੍ਹਿਆ</para>
  <para style="q2" vid="SNG 5:6">ਪਰ ਮੇਰਾ ਪ੍ਰੀਤਮ ਮੁੜ ਕੇ ਚਲਾ ਗਿਆ ਸੀ,</para>
  <para style="q2" vid="SNG 5:6">ਉਸ ਦੇ ਜਾਣ ਨਾਲ ਮੇਰਾ ਦਿਲ ਡੁੱਬ ਗਿਆ,</para>
  <para style="q1" vid="SNG 5:6">ਮੈਂ ਉਸ ਨੂੰ ਲੱਭਿਆ ਪਰ ਉਹ ਲੱਭਾ ਨਾ,</para>
  <para style="q2" vid="SNG 5:6">ਮੈਂ ਉਸ ਨੂੰ ਬੁਲਾਇਆ ਪਰ ਉਸ ਨੇ ਉੱਤਰ ਨਾ ਦਿੱਤਾ।<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />ਪਹਿਰੇਦਾਰਾਂ ਨੇ ਮੈਨੂੰ ਲੱਭ ਲਿਆ</para>
  <para style="q2" vid="SNG 5:7">ਜਦੋਂ ਉਹ ਸ਼ਹਿਰ ਵਿੱਚ ਚੱਕਰ ਲਗਾ ਰਹੇ ਸਨ,</para>
  <para style="q1" vid="SNG 5:7">ਉਨ੍ਹਾਂ ਨੇ ਮੈਨੂੰ ਕੁੱਟਿਆ, ਉਨ੍ਹਾਂ ਨੇ ਮੈਨੂੰ ਜ਼ਖਮੀ ਕਰ ਦਿੱਤਾ,</para>
  <para style="q2" vid="SNG 5:7">ਉਨ੍ਹਾਂ ਨੇ ਮੇਰਾ ਚੋਗਾ ਖੋਹ ਲਿਆ,</para>
  <para style="q2" vid="SNG 5:7">ਉਹ ਜੋ ਸ਼ਹਿਰ ਦੀਆ ਕੰਧਾ ਦੇ ਰਾਖੇ ਸੀ!<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />ਹੇ ਯੇਰੂਸ਼ਲੇਮ ਦੀ ਧੀਓ, ਮੈਂ ਤੁਹਾਨੂੰ ਹੁਕਮ ਦਿੰਦੀ ਹਾਂ,</para>
  <para style="q2" vid="SNG 5:8">ਜੇ ਤੁਸੀਂ ਮੇਰੇ ਬਾਲਮ ਨੂੰ ਲੱਭ ਲਵੋ,</para>
  <para style="q1" vid="SNG 5:8">ਤੁਸੀਂ ਉਸ ਨੂੰ ਕੀ ਕਹੋਗੀਆਂ?</para>
  <para style="q2" vid="SNG 5:8">ਉਸ ਨੂੰ ਦੱਸੋ ਕਿ ਮੈਂ ਪਿਆਰ ਦੀ ਰੋਗਣ ਹਾਂ।<verse eid="SNG 5:8" /></para>
  <para style="sp">ਦੋਸਤੋ</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />ਤੇਰਾ ਬਾਲਮ ਦੂਸਰਿਆ ਨਾਲੋਂ ਕਿਵੇਂ ਵਧੀਆ ਹੈ,</para>
  <para style="q2" vid="SNG 5:9">ਹੇ ਔਰਤਾਂ ਦੇ ਵਿੱਚੋਂ ਸਭ ਤੋਂ ਸੁੰਦਰ?</para>
  <para style="q1" vid="SNG 5:9">ਤੇਰਾ ਪਿਆਰਾ ਦੂਸਰਿਆ ਨਾਲੋਂ ਕਿਵੇਂ ਵਧੀਆ ਹੈ,</para>
  <para style="q2" vid="SNG 5:9">ਕੀ ਤੂੰ ਸਾਨੂੰ ਸਹੁੰ ਚੁਕਾਉੰਦੀ ਹੈ?<verse eid="SNG 5:9" /></para>
  <para style="sp">ਨਾਇਕ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />ਮੇਰਾ ਬਾਲਮ ਚਮਕਦਾਰ ਅਤੇ ਲਾਲ ਹੈ,</para>
  <para style="q2" vid="SNG 5:10">ਦਸ ਹਜ਼ਾਰਾਂ ਆਦਮੀਆਂ ਵਿੱਚੋਂ ਉੱਤਮ ਹੈ।<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />ਉਹ ਦਾ ਸਿਰ ਸ਼ੁੱਧ ਸੋਨਾ ਹੈ,</para>
  <para style="q2" vid="SNG 5:11">ਉਸਦੇ ਵਾਲ ਘੁੰਗਰਾਲੇ</para>
  <para style="q2" vid="SNG 5:11">ਅਤੇ ਪਹਾੜੀ ਕਾਂ ਵਾਂਗ ਕਾਲੇ ਹਨ।<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />ਉਸ ਦੀਆਂ ਅੱਖਾਂ ਪਾਣੀ ਦੀਆਂ</para>
  <para style="q2" vid="SNG 5:12">ਨਦੀਆਂ ਉੱਤੇ ਕਬੂਤਰਾਂ ਵਰਗੀਆਂ ਹਨ,</para>
  <para style="q1" vid="SNG 5:12">ਜਿਹੜੀਆਂ ਦੁੱਧ ਵਿੱਚ ਨਹਾਤੀਆ ਹੋਣ</para>
  <para style="q2" vid="SNG 5:12">ਅਤੇ ਗਹਿਣਿਆਂ ਵਾਂਗ ਹਨ।<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />ਉਹ ਦੀਆਂ ਗੱਲਾਂ ਹਾਂ ਮਸਾਲੇ ਦੇ ਬਿਸਤਰੇ ਵਰਗੀਆਂ ਹਨ,</para>
  <para style="q2" vid="SNG 5:13">ਜੋ ਅਤਰ ਪੈਦਾ ਕਰਦੀਆਂ ਹਨ।</para>
  <para style="q1" vid="SNG 5:13">ਉਹ ਦੇ ਬੁੱਲ ਗੰਧਰਸ ਨਾਲ,</para>
  <para style="q2" vid="SNG 5:13">ਟਪਕਣ ਵਾਲੇ ਸੋਸਨ ਦੇ ਫੁੱਲ ਵਰਗੇ ਹਨ।<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />ਉਸ ਦੀਆ ਬਾਹਾਂ ਸੋਨੇ ਦੀਆਂ ਜੜ੍ਹਾ ਵਰਗੀਆਂ ਹਨ,</para>
  <para style="q2" vid="SNG 5:14">ਜਿਨ੍ਹਾਂ ਉੱਤੇ ਪੁਖਰਾਜ ਜੜੇ ਹੋਣ।</para>
  <para style="q1" vid="SNG 5:14">ਉਸਦਾ ਸਰੀਰ ਪਾਲਿਸ਼ ਕੀਤੇ ਹਾਥੀ ਦੰਦ ਵਰਗਾ ਹੈ,</para>
  <para style="q2" vid="SNG 5:14">ਜਿਸ ਉੱਤੇ ਨੀਲਮ ਦੀ ਸਜਾਵਟ ਹੈ।<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />ਉਹ ਦੀਆਂ ਲੱਤਾਂ ਸੰਗਮਰਮਰ ਦੇ ਥੰਮ੍ਹਾਂ ਵਰਗੀਆਂ ਹਨ,</para>
  <para style="q2" vid="SNG 5:15">ਸ਼ੁੱਧ ਸੋਨੇ ਦੀਆਂ ਨੀਹਾਂ ਉੱਤੇ</para>
  <para style="q1" vid="SNG 5:15">ਉਹ ਦਾ ਰੂਪ ਲਬਾਨੋਨ ਵਰਗਾ ਹੈ,</para>
  <para style="q2" vid="SNG 5:15">ਉਹ ਦਿਆਰ ਵਰਗਾ ਉੱਤਮ ਹੈ।<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />ਉਹ ਦਾ ਮੂੰਹ ਮਿੱਠਾ ਹੈ,</para>
  <para style="q2" vid="SNG 5:16">ਉਹ ਪੂਰੀ ਤਰ੍ਹਾਂ ਪਿਆਰਾ ਹੈ,</para>
  <para style="q1" vid="SNG 5:16">ਇਹ ਮੇਰਾ ਪਿਆਰਾ ਹੈ, ਇਹ ਮੇਰਾ ਮਿੱਤਰ ਹੈ,</para>
  <para style="q2" vid="SNG 5:16">ਯੇਰੂਸ਼ਲੇਮ ਦੀਓ ਧੀਓ!<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">ਮਿੱਤਰੋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />ਹੇ ਇਸਤਰੀਆਂ ਵਿੱਚੋਂ ਰੂਪਵੰਤ,</para>
  <para style="q2" vid="SNG 6:1">ਤੇਰਾ ਪ੍ਰੀਤਮ ਕਿੱਥੇ ਗਿਆ ਹੈ?</para>
  <para style="q1" vid="SNG 6:1">ਤੇਰਾ ਪ੍ਰੀਤਮ ਕਿੱਧਰ ਚਲਾ ਗਿਆ,</para>
  <para style="q2" vid="SNG 6:1">ਤਾਂ ਜੋ ਅਸੀਂ ਉਹ ਨੂੰ ਤੇਰੇ ਨਾਲ ਲੱਭੀਏ?<verse eid="SNG 6:1" /></para>
  <para style="sp">ਨਾਇਕਾ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />ਮੇਰਾ ਪ੍ਰੀਤਮ ਆਪਣੇ ਬਾਗ ਲਈ,</para>
  <para style="q2" vid="SNG 6:2">ਉਹ ਆਪਣੇ ਬਿਸਤਰੇ ਲਈ ਮਾਸਲੇ,</para>
  <para style="q1" vid="SNG 6:2">ਉਹ ਉੱਥੇ ਆਪਣੇ ਇੱਜੜਾਂ ਨੂੰ ਚਾਰਨ,</para>
  <para style="q2" vid="SNG 6:2">ਅਤੇ ਸੋਸਨ ਦੇ ਫੁੱਲ ਇਕੱਠੇ ਕਰਨ ਲਈ ਗਿਆ ਹੈ।<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />ਮੈਂ ਆਪਣੇ ਬਾਲਮ ਦੀ ਹਾਂ ਅਤੇ ਮੇਰਾ ਬਾਲਮ ਮੇਰਾ ਹੈ,</para>
  <para style="q2" vid="SNG 6:3">ਉਹ ਜੋ ਸੋਸਨ ਦੇ ਫੁੱਲਾਂ ਵਿਚਕਾਰ ਆਪਣੀਆਂ ਭੇਡਾਂ ਅਤੇ ਬੱਕਰੀਆਂ ਚਰਦਾ ਹੈ।<verse eid="SNG 6:3" /></para>
  <para style="sp">ਨਾਇਕ</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />ਹੇ ਮੇਰੀ ਪ੍ਰੀਤਮਾ, ਤੂੰ ਤਿਰਜ਼ਾਹ<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">ਤਿਰਜ਼ਾਹ ਇਸਰਾਏਲ ਦੀ ਇੱਕ ਪ੍ਰਾਚੀਨ ਰਾਜਧਾਨੀ ਸੀ</char></note> ਵਾਂਗੂੰ ਸੋਹਣੀ ਹੈ,</para>
  <para style="q2" vid="SNG 6:4">ਯੇਰੂਸ਼ਲੇਮ ਵਰਗੀ ਸੋਹਣੀ,</para>
  <para style="q2" vid="SNG 6:4">ਝੰਡੇ ਵਾਲੀਆਂ ਫ਼ੌਜਾਂ ਵਾਂਗੂੰ ਸ਼ਾਨਦਾਰ ਹੈ।<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />ਆਪਣੀਆਂ ਅੱਖਾਂ ਮੇਰੇ ਤੋਂ ਫੇਰ ਲੈ,</para>
  <para style="q2" vid="SNG 6:5">ਉਹ ਤਾਂ ਮੈਨੂੰ ਘਬਰਾ ਦਿੰਦੀਆ ਹਨ!</para>
  <para style="q1" vid="SNG 6:5">ਤੇਰੇ ਵਾਲ ਬੱਕਰੀਆਂ ਦੇ ਇੱਜੜ ਵਰਗੇ ਹਨ</para>
  <para style="q2" vid="SNG 6:5">ਜੋ ਗਿਲਆਦ ਤੋਂ ਉੱਤਰਦੀਆ ਹਨ।<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />ਤੇਰੇ ਦੰਦ ਭੇਡਾਂ ਦੇ ਇੱਜੜ ਵਰਗੇ ਹਨ</para>
  <para style="q2" vid="SNG 6:6">ਜਿਹੜੀਆਂ ਨਹਾ ਕੇ ਉਤਾਹ ਆਈਆਂ ਹਨ,</para>
  <para style="q1" vid="SNG 6:6">ਹਰੇਕ ਦੇ ਆਪਣੇ ਜੁੜਵੇਂ ਹਨ,</para>
  <para style="q2" vid="SNG 6:6">ਉਹਨਾਂ ਵਿੱਚੋਂ ਇੱਕ ਵੀ ਇਕੱਲੀ ਨਹੀਂ ਹੈ।<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />ਤੇਰੀਆਂ ਗੱਲਾਂ ਘੁੰਡ ਦੇ ਹੇਠ</para>
  <para style="q2" vid="SNG 6:7">ਅਨਾਰ ਦੇ ਟੁੱਕੜਿਆ ਵਾਂਗੂੰ ਹਨ।<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />ਸੱਠ ਰਾਣੀਆਂ,</para>
  <para style="q2" vid="SNG 6:8">ਅਤੇ ਅੱਸੀ ਰਖੇਲਾਂ,</para>
  <para style="q2" vid="SNG 6:8">ਅਤੇ ਕੁਆਰੀਆਂ ਗਿਣਤੀ ਤੋਂ ਵੱਧ ਹੋ ਸਕਦੀਆਂ ਹਨ।<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />ਪਰ ਮੇਰੀ ਕਬੂਤਰੀ, ਮੇਰੀ ਸੰਪੂਰਨ, ਅਨੋਖੀ ਹੈ,</para>
  <para style="q2" vid="SNG 6:9">ਆਪਣੀ ਮਾਂ ਦੀ ਇੱਕਲੌਤੀ ਧੀ,</para>
  <para style="q2" vid="SNG 6:9">ਉਸ ਦੇ ਜਨਮ ਦੇਣ ਵਾਲੀ ਦੀ ਮਨਪਸੰਦ।</para>
  <para style="q1" vid="SNG 6:9">ਮੁਟਿਆਰਾਂ ਨੇ ਉਸ ਨੂੰ ਵੇਖਿਆ ਅਤੇ ਉਸ ਨੂੰ ਮੁਬਾਰਕ ਕਿਹਾ,</para>
  <para style="q2" vid="SNG 6:9">ਰਾਣੀਆਂ ਅਤੇ ਰਖੇਲਾਂ ਨੇ ਉਸਦੀ ਉਸਤਤ ਕੀਤੀ।<verse eid="SNG 6:9" /></para>
  <para style="sp">ਦੋਸਤੋ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />ਇਹ ਕੌਣ ਹੈ ਜੋ ਸਵੇਰ ਵਰਗੀ ਦਿਸਦੀ ਹੈ,</para>
  <para style="q2" vid="SNG 6:10">ਚੰਦ ਵਾਂਗ ਰੂਪਵੰਤ,</para>
  <para style="q2" vid="SNG 6:10">ਸੂਰਜ ਵਾਂਗ ਚਮਕਦਾਰ,</para>
  <para style="q2" vid="SNG 6:10">ਤਾਰਿਆਂ ਵਾਂਗ ਸ਼ਾਨਦਾਰ ਹੈ?<verse eid="SNG 6:10" /></para>
  <para style="sp">ਨਾਇਕ</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />ਮੈਂ ਅਖਰੋਟ ਦੇ ਬਾਗ ਵਿੱਚ ਵਾਧੇ ਨੂੰ ਵੇਖਣ ਲਈ ਗਈ,</para>
  <para style="q2" vid="SNG 6:11">ਤਾਂ ਕਿ ਮੈਂ ਵਾਦੀ ਵਿੱਚ ਖਿਲੇ ਫੁੱਲ ਦੇਖ ਸਕਾਂ,</para>
  <para style="q1" vid="SNG 6:11">ਨਾਲੇ ਇਹ ਵੇਖਣ ਲਈ ਕਿ ਅੰਗੂਰਾਂ ਕਲੀਆਂ,</para>
  <para style="q2" vid="SNG 6:11">ਜਾਂ ਅਨਾਰ ਨੂੰ ਫਲ ਨਿਕਲੇ ਹਨ ਜਾਂ ਨਹੀਂ।<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />ਇਸ ਤੋਂ ਪਹਿਲਾਂ ਕਿ ਮੈਂ ਇਹ ਸਮਝਦੀ,</para>
  <para style="q2" vid="SNG 6:12">ਮੇਰੀ ਇੱਛਾ ਨੇ ਮੈਨੂੰ ਆਪਣੇ ਲੋਕਾਂ ਦੇ ਸ਼ਾਹੀ ਰਥਾਂ ਵਿੱਚ ਸ਼ਾਮਲ ਕੀਤਾ।<verse eid="SNG 6:12" /></para>
  <para style="sp">ਦੋਸਤੋ</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />ਹੇ ਸੂਲੰਮੀਥ, ਮੁੜ ਆ, ਮੁੜ ਆ;</para>
  <para style="q2" vid="SNG 6:13">ਵਾਪਸ ਆ, ਵਾਪਸ ਆ, ਤਾਂ ਜੋ ਅਸੀਂ ਤੁਹਾਨੂੰ ਵੇਖੀਏ!</para>
  <para style="sp" vid="SNG 6:13">ਨਾਇਕ</para>
  <para style="q1" vid="SNG 6:13">ਤੁਸੀਂ ਕਿਉਂ ਸੂਲੰਮੀਥ ਨੂੰ ਵੇਖੋਗੇ</para>
  <para style="q2" vid="SNG 6:13">ਜਿਵੇਂ ਮਹਾਨਾਇਮ<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 32:2">ਉਤ 32:2</ref></char></char></note> ਦੇ ਨਾਚ ਉੱਤੇ ਕਰਦੇ ਹੋ?<verse eid="SNG 6:13" /></para>
  <para style="b" />
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1" />ਹੇ ਰਾਜਕੁਮਾਰ ਦੀ ਧੀਏ,</para>
  <para style="q2" vid="SNG 7:1">ਤੇਰੇ ਪੈਰ ਜੁੱਤੀ ਦੇ ਵਿੱਚ ਕਿੰਨੇ ਸੋਹਣੇ ਹਨ!</para>
  <para style="q1" vid="SNG 7:1">ਤੇਰੀਆਂ ਲੱਤਾ ਸੁੰਦਰ ਗਹਿਣਿਆਂ ਵਾਂਗ ਹਨ,</para>
  <para style="q2" vid="SNG 7:1">ਜਿਵੇਂ ਕਿਸੇ ਕਾਰੀਗਰ ਦੇ ਹੱਥਾਂ ਨਾਲ ਬਣੀਆਂ ਹੋਣ।<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />ਤੇਰੀ ਧੁੰਨੀ ਗੋਲ ਕਟੋਰੇ ਵਰਗੀ ਹੈ</para>
  <para style="q2" vid="SNG 7:2">ਜਿਸ ਵਿੱਚ ਮਿਲੀ ਹੋਈ ਦਾਖ਼ਰਸ ਦੀ ਕਮੀ ਨਹੀਂ ਹੁੰਦੀ,</para>
  <para style="q1" vid="SNG 7:2">ਤੇਰਾ ਪੇਟ ਕਣਕ ਦਾ ਢੇਰ ਹੈ,</para>
  <para style="q2" vid="SNG 7:2">ਜਿਹੜਾ ਸੋਸਨਾਂ ਨਾਲ ਘਿਰਿਆ ਹੋਇਆ ਹੈ।<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />ਤੇਰੀਆਂ ਦੋਵੇਂ ਛਾਤੀਆਂ ਹਿਰਨੀ ਦੇ ਜੁੜਵਾਂ ਬੱਚਿਆਂ ਵਰਗੀਆਂ ਹਨ,</para>
  <para style="q2" vid="SNG 7:3">ਜਿਵੇਂ ਹਿਰਨੀ ਦੇ ਜੁੜਵਾਂ ਬੱਚੇ।<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />ਤੇਰੀ ਗਰਦਨ ਹਾਥੀ ਦੰਦ ਦੇ ਬੁਰਜ ਵਰਗੀ ਹੈ,</para>
  <para style="q1" vid="SNG 7:4">ਤੇਰੀਆਂ ਅੱਖਾਂ ਹੇਸ਼ਬੋਨ ਦੇ ਤਲਾਬ ਹਨ,</para>
  <para style="q2" vid="SNG 7:4">ਜੋ ਬਥ-ਰੱਬੀਮ ਦੇ ਦਰਵਾਜ਼ੇ ਕੋਲ ਹੈ।</para>
  <para style="q1" vid="SNG 7:4">ਤੇਰਾ ਨੱਕ ਲਬਾਨੋਨ ਦੇ ਬੁਰਜ ਵਰਗਾ ਹੈ,</para>
  <para style="q2" vid="SNG 7:4">ਜੋ ਦੰਮਿਸ਼ਕ ਵੱਲ ਦੇਖ ਰਿਹਾ ਹੈ।<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />ਤੇਰਾ ਸਿਰ ਕਰਮਲ ਪਹਾੜ ਵਰਗਾ ਹੈ,</para>
  <para style="q2" vid="SNG 7:5">ਤੇਰੇ ਸਿਰ ਦੇ ਵਾਲ ਬੈਂਗਣੀ ਜਿਹੇ ਹਨ,</para>
  <para style="q2" vid="SNG 7:5">ਪਾਤਸ਼ਾਹ ਤੇਰੇ ਵਾਲਾਂ ਦਾ ਕੈਦੀ ਬਣਿਆ ਹੋਇਆ ਹੈ।<verse eid="SNG 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />ਤੂੰ ਕਿੰਨੀ ਸੋਹਣੀ ਅਤੇ ਕਿੰਨੀ ਮਨਮੋਹਣੀ ਹੈ,</para>
  <para style="q2" vid="SNG 7:6">ਤੂੰ ਪਿਆਰ ਕਰਨ ਵਿੱਚ ਕਿੰਨੀ ਸੋਹਣੀ ਲੱਗਦੀ ਹੈ!<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />ਤੇਰਾ ਕੱਦ ਖਜ਼ੂਰ ਵਰਗਾ ਹੈ,</para>
  <para style="q2" vid="SNG 7:7">ਅਤੇ ਤੇਰੀਆਂ ਛਾਤੀਆਂ ਫਲਾਂ ਦੇ ਗੁੱਛਿਆਂ ਵਰਗੀਆਂ ਹਨ।<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />ਮੈਂ ਆਖਿਆ, “ਮੈਂ ਖਜ਼ੂਰ ਦੇ ਰੁੱਖ ਉੱਤੇ ਚੜ੍ਹਾਂਗਾ;</para>
  <para style="q2" vid="SNG 7:8">ਮੈਂ ਇਸਦਾ ਫਲ ਫੜ ਲਵਾਂਗਾ।”</para>
  <para style="q1" vid="SNG 7:8">ਤੇਰੀਆਂ ਛਾਤੀਆਂ ਅੰਗੂਰ ਦੇ ਗੁੱਛਿਆਂ ਵਾਂਗ ਹੋਣ,</para>
  <para style="q2" vid="SNG 7:8">ਅਤੇ ਤੇਰੇ ਸਾਹ ਦੀ ਖੁਸ਼ਬੂ ਸੇਬਾਂ ਦੇ ਵਰਗੀ ਹੋਵੇ।<verse eid="SNG 7:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9" />ਅਤੇ ਤੇਰਾ ਮੂੰਹ ਸਭ ਤੋਂ ਵਧੀਆ ਦਾਖ਼ਰਸ ਵਰਗਾ ਹੈ।</para>
  <para style="sp" vid="SNG 7:9">ਨਾਇਕਾ</para>
  <para style="q1" vid="SNG 7:9">ਦਾਖ਼ਰਸ ਸਿੱਧੀ ਮੇਰੇ ਪ੍ਰੀਤਮ ਕੋਲ ਜਾਵੇ,</para>
  <para style="q2" vid="SNG 7:9">ਬੁੱਲ੍ਹਾਂ ਅਤੇ ਦੰਦਾਂ ਉੱਤੇ ਹੌਲੀ-ਹੌਲੀ ਵਗਦੀ ਰਹੇ।<verse eid="SNG 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />ਮੈਂ ਆਪਣੇ ਪ੍ਰੀਤਮ ਦੀ ਹਾਂ,</para>
  <para style="q2" vid="SNG 7:10">ਅਤੇ ਉਸਦੀ ਇੱਛਾ ਮੇਰੇ ਲਈ ਹੈ।<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />ਆਓ ਮੇਰੇ ਪਿਆਰੇ, ਆਓ ਅਸੀਂ ਬਾਹਰ ਚੱਲੀਏ,</para>
  <para style="q2" vid="SNG 7:11">ਆਓ ਅਸੀਂ ਪਿੰਡਾਂ ਵਿੱਚ ਰਾਤ ਕੱਟੀਏ।<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />ਆਓ ਅਸੀਂ ਸਵੇਰੇ ਹੀ ਅੰਗੂਰਾਂ ਦੇ ਬਾਗਾਂ ਵਿੱਚ ਚੱਲੀਏ,</para>
  <para style="q2" vid="SNG 7:12">ਇਹ ਵੇਖਣ ਲਈ ਕਿ ਅੰਗੂਰੀ ਵੇਲਾਂ ਉੱਗ ਗਈਆਂ ਹਨ,</para>
  <para style="q1" vid="SNG 7:12">ਉਨ੍ਹਾਂ ਦੇ ਫੁੱਲ ਖਿੜ ਆਏ ਹਨ,</para>
  <para style="q2" vid="SNG 7:12">ਅਤੇ ਜਾਂ ਅਨਾਰ ਖਿੜ ਰਹੇ ਹਨ,</para>
  <para style="q2" vid="SNG 7:12">ਉੱਥੇ ਮੈਂ ਤੈਨੂੰ ਆਪਣਾ ਪਿਆਰ ਦਿਆਂਗੀ।<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />ਫੁੱਲ ਆਪਣੀ ਸੁਗੰਧ ਭੇਜਦੇ ਹਨ,</para>
  <para style="q2" vid="SNG 7:13">ਅਤੇ ਸਾਡੇ ਦਰਵਾਜ਼ੇ ਉੱਤੇ ਹਰੇਕ ਸੁਆਦਲੇ ਪਦਾਰਥ ਹਨ,</para>
  <para style="q1" vid="SNG 7:13">ਨਵੇਂ ਅਤੇ ਪੁਰਾਣੇ ਵੀ,</para>
  <para style="q2" vid="SNG 7:13">ਹੇ ਮੇਰੇ ਬਾਲਮ! ਜੋ ਮੈਂ ਤੇਰੇ ਲਈ ਇਕੱਠੇ ਕੀਤੇ ਹਨ।<verse eid="SNG 7:13" /></para>
  <para style="b" />
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />ਕਾਸ਼ ਤੂੰ ਮੇਰੇ ਲਈ ਇੱਕ ਭਰਾ ਵਰਗਾ ਹੁੰਦਾ,</para>
  <para style="q2" vid="SNG 8:1">ਜਿਸ ਨੇ ਮੇਰੀ ਮਾਂ ਦੀ ਛਾਤੀਆਂ ਤੋਂ ਦੁੱਧ ਪੀਤਾ,</para>
  <para style="q1" vid="SNG 8:1">ਫਿਰ ਜੇ ਮੈਂ ਤੈਨੂੰ ਬਾਹਰ ਲੱਭਦੀ,</para>
  <para style="q2" vid="SNG 8:1">ਤਾਂ ਮੈਂ ਤੈਨੂੰ ਚੁੰਮਦੀ,</para>
  <para style="q2" vid="SNG 8:1">ਅਤੇ ਕੋਈ ਮੈਨੂੰ ਤੁੱਛ ਨਾ ਜਾਣਦਾ।<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />ਮੈਂ ਤੇਰੀ ਅਗਵਾਈ ਕਰਦੀ</para>
  <para style="q2" vid="SNG 8:2">ਅਤੇ ਤੈਨੂੰ ਆਪਣੀ ਮਾਤਾ ਦੇ ਘਰ ਲੈ ਜਾਂਦੀ,</para>
  <para style="q2" vid="SNG 8:2">ਜਿਸ ਨੇ ਮੈਨੂੰ ਸਿਖਾਇਆ ਹੈ,</para>
  <para style="q1" vid="SNG 8:2">ਮੈਂ ਤੈਨੂੰ ਪੀਣ ਲਈ ਮਸਾਲੇਦਾਰ ਦਾਖ਼ਰਸ ਦਿੰਦੀ,</para>
  <para style="q2" vid="SNG 8:2">ਮੇਰੇ ਅਨਾਰ ਦਾ ਰਸ ਪਿਲਾਉਂਦੀ।<verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />ਉਸਦੀ ਖੱਬੀ ਬਾਂਹ ਮੇਰੇ ਸਿਰ ਦੇ ਹੇਠਾਂ ਹੁੰਦੀ,</para>
  <para style="q2" vid="SNG 8:3">ਅਤੇ ਉਸਦੀ ਸੱਜੀ ਬਾਂਹ ਮੈਨੂੰ ਗਲੇ ਲਗਾ ਲੈਂਦੀ।<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />ਯੇਰੂਸ਼ਲੇਮ ਦੀ ਧੀਓ, ਮੈਂ ਤੁਹਾਨੂੰ ਸਹੁੰ ਚੁਕਾਉਂਦੀ ਹਾਂ,</para>
  <para style="q2" vid="SNG 8:4">ਪਿਆਰ ਨੂੰ ਨਾ ਜਗਾਓ ਅਤੇ ਨਾ ਹੀ ਉਕਸਾਓ,</para>
  <para style="q2" vid="SNG 8:4">ਜਦੋਂ ਤੱਕ ਉਸਦੀ ਆਪਣੀ ਇੱਛਾ ਨਾ ਹੋਵੇ।<verse eid="SNG 8:4" /></para>
  <para style="sp">ਮਿੱਤਰੋ</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />ਇਹ ਕੌਣ ਹੈ ਜੋ ਉਜਾੜ ਵਿੱਚੋਂ ਉੱਪਰ ਆਉਂਦੀ ਹੈ,</para>
  <para style="q2" vid="SNG 8:5">ਜਿਸਨੇ ਆਪਣੇ ਪ੍ਰੀਤਮ ਦਾ ਸਹਾਰਾ ਲਿਆ ਹੋਇਆ ਹੈ?</para>
  <para style="sp" vid="SNG 8:5">ਨਾਇਕਾ</para>
  <para style="q1" vid="SNG 8:5">ਸੇਬ ਦੇ ਰੁੱਖ ਹੇਠ ਮੈਂ ਤੈਨੂੰ ਜਗਾਇਆ</para>
  <para style="q2" vid="SNG 8:5">ਉੱਥੇ ਤੇਰੀ ਮਾਂ ਨੇ ਤੈਨੂੰ ਜਨਮ ਦਿੱਤਾ</para>
  <para style="q2" vid="SNG 8:5">ਉੱਥੇ ਜਿਸ ਨੇ ਜਣੇਪੇ ਵਿੱਚ ਸੀ ਤੈਨੂੰ ਜਨਮ ਦਿੱਤਾ।<verse eid="SNG 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />ਮੈਨੂੰ ਆਪਣੇ ਦਿਲ ਉੱਤੇ ਮੋਹਰ ਵਾਂਗ ਰੱਖ,</para>
  <para style="q2" vid="SNG 8:6">ਆਪਣੀ ਬਾਂਹ ਉੱਤੇ ਮੋਹਰ ਵਾਂਗੂੰ ਬੰਨ੍ਹ,</para>
  <para style="q1" vid="SNG 8:6">ਕਿਉਂਕਿ ਪਿਆਰ ਮੌਤ ਵਾਂਗ ਮਜ਼ਬੂਤ ਹੈ,</para>
  <para style="q2" vid="SNG 8:6">ਇਸਦੀ ਈਰਖਾ ਕਬਰ ਵਾਂਗ ਅਟੱਲ ਹੈ,</para>
  <para style="q1" vid="SNG 8:6">ਇਹ ਬਲਦੀ ਅੱਗ ਵਾਂਗ,</para>
  <para style="q2" vid="SNG 8:6">ਅਤੇ ਇੱਕ ਬਲਦੀ ਲਾਟ ਵਾਂਗ ਹੈ।<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />ਬਹੁਤੇ ਪਾਣੀ ਪਿਆਰ ਨੂੰ ਬੁਝਾ ਨਹੀਂ ਸਕਦੇ,</para>
  <para style="q2" vid="SNG 8:7">ਨਾ ਹੀ ਹੜ੍ਹ ਇਸਨੂੰ ਦਬਾ ਸਕਦੇ ਹਨ,</para>
  <para style="q1" vid="SNG 8:7">ਜੇ ਕੋਈ ਆਪਣੇ ਘਰ ਦੀ ਸਾਰੀ ਦੌਲਤ ਪਿਆਰ ਲਈ ਦੇ ਦੇਵੇ,</para>
  <para style="q2" vid="SNG 8:7">ਤਾਂ ਉਹ ਦੌਲਤ ਤੁੱਛ ਸਮਝੀ ਜਾਵੇਗੀ ਹੈ।<verse eid="SNG 8:7" /></para>
  <para style="sp">ਦੋਸਤੋ</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />ਸਾਡੀ ਇੱਕ ਛੋਟੀ ਭੈਣ ਹੈ,</para>
  <para style="q2" vid="SNG 8:8">ਅਤੇ ਉਸ ਦੀਆਂ ਛਾਤੀਆਂ ਅਜੇ ਉਭਰੀਆਂ ਨਹੀਂ ਹਨ।</para>
  <para style="q1" vid="SNG 8:8">ਅਸੀਂ ਆਪਣੀ ਭੈਣ ਲਈ ਕੀ ਕਰੀਏ</para>
  <para style="q2" vid="SNG 8:8">ਜਿਸ ਦਿਨ ਉਸਦੇ ਵਿਆਹ ਦੀ ਗੱਲ ਚੱਲੇ?<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />ਜੇ ਉਹ ਕੰਧ ਹੋਵੇ,</para>
  <para style="q2" vid="SNG 8:9">ਤਾਂ ਅਸੀਂ ਉਸ ਉੱਤੇ ਚਾਂਦੀ ਦੇ ਬੁਰਜ ਬਣਾਵਾਂਗੇ,</para>
  <para style="q1" vid="SNG 8:9">ਜੇਕਰ ਉਹ ਇੱਕ ਦਰਵਾਜ਼ਾ ਹੈ,</para>
  <para style="q2" vid="SNG 8:9">ਅਸੀਂ ਉਸ ਨੂੰ ਦਿਆਰ ਦੇ ਤੱਖਤ ਨਾਲ ਘੇਰ ਲਵਾਂਗੇ।<verse eid="SNG 8:9" /></para>
  <para style="sp">ਨਾਇਕਾ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />ਮੈਂ ਇੱਕ ਕੰਧ ਹਾਂ,</para>
  <para style="q2" vid="SNG 8:10">ਅਤੇ ਮੇਰੀਆਂ ਛਾਤੀਆਂ ਬੁਰਜਾਂ ਵਰਗੀਆਂ ਹਨ,</para>
  <para style="q1" vid="SNG 8:10">ਇਸ ਤਰ੍ਹਾਂ ਮੈਂ ਉਸ ਦੀਆਂ ਅੱਖਾਂ ਵਿੱਚ</para>
  <para style="q2" vid="SNG 8:10">ਸ਼ਾਂਤੀ ਪਾਉਣ ਵਾਲੀ ਵਾਂਗੂੰ ਸੀ।<verse eid="SNG 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />ਬਆਲ-ਹਾਮੋਨ ਵਿੱਚ ਸ਼ਲੋਮੋਨ ਦਾ ਅੰਗੂਰੀ ਬਾਗ਼ ਸੀ,</para>
  <para style="q2" vid="SNG 8:11">ਉਸਨੇ ਆਪਣਾ ਬਾਗ ਕਿਰਾਏਦਾਰਾਂ ਨੂੰ ਦਿੱਤਾ।</para>
  <para style="q1" vid="SNG 8:11">ਹਰੇਕ ਨੇ ਆਪਣੇ ਫਲ ਲਈ,</para>
  <para style="q2" vid="SNG 8:11">ਇੱਕ ਹਜ਼ਾਰ ਸ਼ੈਕੇਲ<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="fq" closed="false">ਇੱਕ ਹਜ਼ਾਰ ਸ਼ੈਕੇਲ </char><char style="ft" closed="false">ਲਗਭਗ </char><char style="fqa" closed="false">12 ਕਿਲੋਗ੍ਰਾਮ</char></note> ਚਾਂਦੀ ਲਿਆਉਣੀ ਸੀ।<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />ਪਰ ਮੇਰਾ ਅੰਗੂਰੀ ਬਾਗ਼ ਜਿਹੜਾ ਮੇਰਾ ਆਪਣਾ ਹੈ,</para>
  <para style="q2" vid="SNG 8:12">ਹੇ ਸ਼ਲੋਮੋਨ, ਦੋ ਹਜ਼ਾਰ ਸ਼ੈਕੇਲ ਤੇਰੇ ਲਈ ਹਨ,</para>
  <para style="q2" vid="SNG 8:12">ਅਤੇ ਦੋ ਸੌ ਉਨ੍ਹਾਂ ਲਈ ਹਨ ਜੋ ਇਸ ਦੇ ਫਲ ਦੀ ਦੇਖਭਾਲ ਕਰਦੇ ਹਨ।<verse eid="SNG 8:12" /></para>
  <para style="sp">ਨਾਇਕ</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />ਤੂੰ ਜੋ ਬਾਗਾਂ ਵਿੱਚ ਅਤੇ</para>
  <para style="q2" vid="SNG 8:13">ਆਪਣੇ ਮਿੱਤਰਾਂ ਦੇ ਨਾਲ ਰਹਿੰਦੀ ਹੈ,</para>
  <para style="q2" vid="SNG 8:13">ਮੈਨੂੰ ਤੇਰੀ ਆਵਾਜ਼ ਸੁਣਨ ਦਿਓ!<verse eid="SNG 8:13" /></para>
  <para style="sp">ਨਾਇਕਾ</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />ਹੇ ਮੇਰੀ ਪ੍ਰੀਤਮ, ਵਾਪਸ ਆ ਜਾ,</para>
  <para style="q2" vid="SNG 8:14">ਅਤੇ ਮਸਾਲੇ ਨਾਲ ਭਰੇ ਪਹਾੜਾਂ ਉੱਤੇ,</para>
  <para style="q1" vid="SNG 8:14">ਹਿਰਨ ਵਰਗੀ,</para>
  <para style="q2" vid="SNG 8:14">ਜਾਂ ਇੱਕ ਜਵਾਨ ਹਿਰਨ ਵਰਗੀ ਹੋ ਜਾ।<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>