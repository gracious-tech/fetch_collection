<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Biblica® Open Kiyombe Contemporary New Testament and Psalms 2002</book>
  <para style="h">2 YOWANI</para>
  <para style="toc1">Nkanda wummuadi wusonika Yowani</para>
  <para style="toc2">2 Yowani</para>
  <para style="toc3">2 Yowani</para>
  <para style="mt2">Nkanda wummuadi wusonika</para>
  <para style="mt1">Yowani</para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="s1">Thonono</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>Nkulutu sonikini nkanda wawu kuidi mama diodi disobolo ayi kuidi bana bandi bobo ndieti zola mu kiedika. Bika sia ti minu kaka, vayi, ayi batu boso bobo banzolanga kiedika <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>mu diambu di kiedika kidi mu beto ayi kiela kalanga mu beto mu zithangu zioso.<verse eid="2JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3"/>Bika nlemvo, mamboti ayi ndembama bibedi kuidi Nzambi Tata ayi kuidi Yesu Klisto, Muana wu Tata, bibanga yeto mu kiedika ayi mu luzolo.<verse eid="2JN 1:3"/></para>
  <para style="s1">Lutumunu mu diambu di zola</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>Khini yiwombo ndilembo moni mu mona ti bana baku bankaka bandiatila mu kiedika banga bu tutambudila lutumunu kuidi Tata.<verse eid="2JN 1:4"/></para>
  <para style="p">
    <verse number="5-6" style="v" sid="2JN 1:5-6"/>Buabu, mama, tala diambu ndikulomba : bika sia ti lutumunu lumona ndikusonikina vayi lolo kuandi tutambula tona vana thonono. Ayi lutumunu beni banga kuandi bu luwila luawu tona vana thonono ti ludiatila mu luzolo.<verse eid="2JN 1:5-6"/></para>
  <para style="s1">Ba wukuikama mu mambu ma kiedika</para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>Bila batu bawombo baluvunu batotukidi va nza. Bawu bakikininangako ti Yesu Klisto wuyiza mu nsuni. Mutu wuntubilanga bobo niandi nkua luvunu ayi antiklisto.<verse eid="2JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2JN 1:8"/>Diawu lulubuka tala luedi zimbisa mambu momo luvanga vayi muingi lutambula mfutu wuduka. <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>Woso mutu wumvambananga ayi kambulu kangama mu malongi ma Klisto, kasi kithuadi ayi Nzambi ko. Vayi woso mutu widi wukangama mu malongi, niandi widi mu kithuadi ki Tata ayi ki Muana.<verse eid="2JN 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2JN 1:10"/>Enati mutu wizidi kuidi beno ayi kakadi nata malongi mama bunalubika kunyakula mu nzoꞌeno, lubika kumvana mboti. <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>Bila woso wukumvana mboti buna wumfubakananga yandi mu mavanga mandimambimbi.<verse eid="2JN 1:11"/></para>
  <para style="s1">Lukanu lu kulubumina</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>Mambu mawombo makidi yama makulusonikina vayi mbengi kubuvangila mu phapi ayi mu thita ; vayi diana ndisia mu kuiza kuidi beno ayi solula yeno zizi mu zizi muingi khini eto yiba yiduka.<verse eid="2JN 1:12"/></para>
  <para style="s1">Mboti yi tsuka</para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>Bana ba khombꞌaku yi nketo yisobolo bafidisidi mboti.<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
