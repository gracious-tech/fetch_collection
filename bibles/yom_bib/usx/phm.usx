<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Biblica® Open Kiyombe Contemporary New Testament and Psalms 2002</book>
  <para style="h">FILEMO</para>
  <para style="toc1">Nkanda Polo kuidi Filemo</para>
  <para style="toc2">Filemo</para>
  <para style="toc3">Filemo</para>
  <para style="mt2">Nkanda Polo kuidi</para>
  <para style="mt1">Filemo</para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="s1">Thonono</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>Polo, muisi nloko mu diambu di Yesu Klisto, ayi Timote khombꞌetobafidisidi nkanda wawu kuidi Filemo, nkundi eto wu luzolo ayi kisadi yeto <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>ayi kuidi khombꞌeto yi nketo Afi ayi kuidi Alasipe, kinuani yeto ayi kuidi dibundu dinkutakananga ku nzo aku.<verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>Bika nlemvo ayi ndembama bi Nzambi Dise dieto ayi bi Pfumu eto bibangayeno.<verse eid="PHM 1:3"/></para>
  <para style="s1">Luzolo ayi minu bi Filemo</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>Ndimvutulanga matondo kuidi Nzambi mu zithangu zioso bu ndikutebukilanga moyo mu zitsambulu ziama, <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>bu ndilembo wanga zitsangu zi luzolo ayi zi minu zidi yaku mu diambu di Pfumu Yesu ayi mu diambu di banlongo boso. <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>Ndinsambila Nzambi muingi wuba bufula mu ba mu kithuadi ayi bankaka mu minu kiaku muingi wuba diela difuana di sudikila dioso-diosodiambu di mboti didi yeto mu Klisto. <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>Luzolo luaku lumbonisa khini yingolo ayi lukhindisa bila ngeyo, khomba, bika wuzaba bumbote ti wukulula mintima mi banlongo.<verse eid="PHM 1:7"/></para>
  <para style="s1">Polo wuleba Filemo mu diambu di Onezime</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>Diawu, budidi ti mbeki kiphuanza kingolo mu Klisto mu kutumina mu mambu mafueni, <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>mu diambu di luzolo, vayi mu diambu di boso bu ndidi minu Polo, kinunu ayi buela ndidi buabu mu nloko mu diambu di Yesu Klisto ; <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>ndikulomba mu diambu di Onesime, muanꞌama wundibuta buna ndidi wukangama. <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>Va theti niandi kasia ba mfunu kuidi ngeyo ko vayi buabu mfunu wuwombo keka kuidi ngeyo ayi kuidi minu.<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>Ndimvutudi diaka kuidi ngeyo ; niandi bukadi kintima kiama. <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>Muaki ndiedi katia ti kavuanda kuandi yama muingi katsadisa va buangu kiaku bu ndidi wukangama mu diambu di Nsamu Wumboti.<verse eid="PHM 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PHM 1:14"/>Vayi mbengi kuama buvanga mu kambu teka zaba mayindu maku mu diambu wubika vangila mamboti maku mu kuiku<note caller="+" style="f"><char style="fr" closed="false">1.14 </char><char style="fq" closed="false">mu kuiku</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">voti mu kingolo.</char></note> vayi mavangimina mu luzolo.<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>Nani zebi, mananga Onesime wutuama vambana yaku mu ndambu thangu kaka muingi wuntambula buabu mu zithangu zioso ; <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>vayi bika banga mvika vayi banga mutu wowo viatukidi mvika, banga khomba yi luzolo. Niandi thalu yiwombo kadi kuidi minu vayi kuidingeyo wela luta thalu bu keka mutu ayi khomba mu Pfumu.<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>Diawu, mu diambu di kithuadi ayi minu, buna wunyakula banga timinu veka yakudi. <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>Enati diambu di mbimbi kavangila voti pholo aku kadi, buna tangila biawu va dizina diama. <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>Tala minu veka Polo tsonikini mambu mama mu koko kuama. Minu ndiela futa yawu ayi mbengi kuama kutebula moyo ti ngeyo mamvaku pholowidi kuidi minu. Pholo beni yidi luzingu luaku veka.<verse eid="PHM 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PHM 1:20"/>Nyinga khomba, mu diambu di Pfumu bika wutsadisa ; buisa ntimꞌamamu Klisto. <verse eid="PHM 1:20"/><verse number="21" style="v" sid="PHM 1:21"/>Bu tsididi tumama kuaku diana, diawu ndisonikini bila nzebi ti wela vanga viokila momo ndombidi.<verse eid="PHM 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22"/>Diambu dinkaka, wukhubikila nlekolo, bila diana ndisia ti mu diambu di zitsambulu zieno bela ku phutula kuidi beno.<verse eid="PHM 1:22"/></para>
  <para style="s1">Zimboti zi tsuka</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>Mboti aku yibedi kuidi Epafalasi, nkundi ama mu nloko mu diambu di Klisto Yesu. <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>Zimboti ziaku zibedi kuidi bisadi yama Malako, Alisitalike, Demasi ayi Luka.<verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>Bika nlemvo wu Pfumuꞌeto Yesu Klisto wubanga yaku.<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
