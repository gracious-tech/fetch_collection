<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Biblica® Open Kiyombe Contemporary New Testament and Psalms 2002</book>
  <para style="h">MATAYI</para>
  <para style="toc1">Nsamu Wumboti wusonika Matayi</para>
  <para style="toc2">Matayi</para>
  <para style="toc3">Matayi</para>
  <para style="mt2">Nsamu Wumboti wusonika</para>
  <para style="mt1">Matayi</para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="ms1">MBUTUKULU AYI BUMUANA BU YESU</para>
  <para style="s1">Kikhulu ki Yesu</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luka 3.23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>Tala buididi kikhulu ki Yesu Klisto, muana wu Davidi, muana wu Abalahami :<verse eid="MAT 1:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2"/>Abalahami wubuta Isaki, Isaki wubuta Yakobi,</para>
  <para style="li1" vid="MAT 1:2">Yakobi wubuta Yuda ayi bakhomba bandi.<verse eid="MAT 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 1:3"/>Yuda ayi nketo andi Tamali babuta Falesi ayi Zala ;</para>
  <para style="li1" vid="MAT 1:3">Falesi wubuta Heseloni,</para>
  <para style="li1" vid="MAT 1:3">Heseloni wubuta Alami.<verse eid="MAT 1:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 1:4"/>Alami wubuta Aminadabi ;</para>
  <para style="li1" vid="MAT 1:4">Aminadabi wubuta Nasoni ;</para>
  <para style="li1" vid="MAT 1:4">Nasoni wubuta Salimoni.<verse eid="MAT 1:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="MAT 1:5"/>Salimoni ayi nketo andi Lahabi babuta Bowazi ;</para>
  <para style="li1" vid="MAT 1:5">Bowazi ayi nketo andi Luti babuta Obedi ;<verse eid="MAT 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="MAT 1:6"/>Obedi wubuta Isayi ;</para>
  <para style="li1" vid="MAT 1:6">Izayi wubuta ntinu Davidi ;</para>
  <para style="li1" vid="MAT 1:6">ntinu Davidi wubuta Salomo mu nketo wuba wu Uli.<verse eid="MAT 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="MAT 1:7"/>Solomo wubuta Lobowami ;</para>
  <para style="li1" vid="MAT 1:7">Lobohami wubuta Abia ;</para>
  <para style="li1" vid="MAT 1:7">Abia wubuta Asa.<verse eid="MAT 1:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="MAT 1:8"/>Asa wubuta Zozafati ;</para>
  <para style="li1" vid="MAT 1:8">Zozafati wubuta Zolami</para>
  <para style="li1" vid="MAT 1:8">bosi Zolami wubuta Oziasi ;<verse eid="MAT 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="MAT 1:9"/>Oziasi wubuta Yotami ;</para>
  <para style="li1" vid="MAT 1:9">Yotami wubuta Akazi ;</para>
  <para style="li1" vid="MAT 1:9">bosi Akazi wubuta Ezekiasi.<verse eid="MAT 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="MAT 1:10"/>Ezekiasi wubuta Manase ;</para>
  <para style="li1" vid="MAT 1:10">Manase wubuta Amoni</para>
  <para style="li1" vid="MAT 1:10">bosi Amoni wubuta Zoziasi.<verse eid="MAT 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="MAT 1:11"/>Zoziasi wubuta Yekonia ayi bakhomba bandi ;</para>
  <para style="li1" vid="MAT 1:11">bawu babutuka bu banata bana ba Iseli mu buvika ku tsi Babiloni.<verse eid="MAT 1:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="MAT 1:12"/>Buvika bu bumana ku Babiloni,</para>
  <para style="li1" vid="MAT 1:12">Yekonia wubuta Salatieli ;</para>
  <para style="li1" vid="MAT 1:12">Salatieli wubuta Zolobabeli.<verse eid="MAT 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="MAT 1:13"/>Zolobabeli wubuta Abuidi ;</para>
  <para style="li1" vid="MAT 1:13">Abuidi wubuta Eliakimi ;</para>
  <para style="li1" vid="MAT 1:13">Eliakimi wubuta Azoli.<verse eid="MAT 1:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="MAT 1:14"/>Azoli wubuta Sadoki ;</para>
  <para style="li1" vid="MAT 1:14">Sadoki wubuta Akimi ;</para>
  <para style="li1" vid="MAT 1:14">Akimi wubuta Eliudi.<verse eid="MAT 1:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15"/>Eliudi wubuta Eleyazali ;</para>
  <para style="li1" vid="MAT 1:15">Eleyazali wubuta Matani ;</para>
  <para style="li1" vid="MAT 1:15">Matani wubuta Yakobi.<verse eid="MAT 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 1:16"/>Bosi Yakobi wubuta Zozefi wuba bakala di Maliya, ngudi yi Yesu wuba tedila Klisto.<verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>Diawu zitsungi zioso tona Abalahami nate Davidi zidi kumi zitsungi ziya. Tona Davidi nate thangu bana ba Iseli bayenda mu buvika ku Babiloni ; vaba kumi zitsungi ziya ; bosi tona thangu buvika nate Klisto vaba kumi zitsungi ziya.<verse eid="MAT 1:17"/></para>
  <para style="s1">Mbasi yisamuna mbutukulu yi Yesu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>Tala phila yibutukila Yesu Klisto : Maliya ngudi andi ; niandi wuba nketo wuzolo kuelo kuidi Zozefi. Buna katudidi ko va nzo dikuela Maliya wubaka buemba vayi mu Pheve Yinlongo kabakila buemba beni. <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>Zozefi, bakala diodi dizola kuela Maliya, wuba mutu wusonga, wumanga kuandi kumfuisa tsoni va meso ma batu ; wubaka lukanu lu kumbotula mu kitsueki.<verse eid="MAT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20"/>Bu kaba ku tsi mayindu mu diambu di mambu beni ; buna mbasi yi Pfumu yimmonikina mu ndozi, yinkamba :</para>
  <para style="p" vid="MAT 1:20">—A Zozefi, muana Davidi ! Bika mona boma mu kuela nketo aku Maliya bila buemba buidi yandi mu Pheve Yinlongo kabakidi buawu. <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>Wela buta muana wubakala, dizina wela kumbieka Yesu : bila niandi wela kula batu bandi mu masumu mawu.<verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>Mambu moso mama mavangama mu diambu di dedikisa mambu makamba Pfumu kuidi mbikudi ti :<verse eid="MAT 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23"/>
    <char style="qt">Luwa, ndumba yikambu zaba bakala yela ba mu buemba,</char></para>
  <para style="q1" vid="MAT 1:23">
    <char style="qt">yela buta muana wubakala, dizina bela kuntedilanga</char></para>
  <para style="q1" vid="MAT 1:23">
    <char style="qt">Emanueli, bu dinsundula : “Nzambi widi yeto !”</char><verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>Zozefi bu kakotuka, wuvanga mambu moso mbasi yi Pfumu kantuma ayi wubonga Maliya mu ba nketo andi. <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>Vayi Zozefi kasia zaba nitu yi nketo andi Maliya ko nate kabuta muana wubakala, ayi wumvana dizina Yesu.<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">Banduenga bayenda tala Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>Yesu ku Betelemi kabutukila, divula didi mu tsi yi Yuda, mu thangu ntinu Elode. Yesu bu kabutuka, banduenga, batu beti longuka zimbuetete batotukila ku ndambu Esite, bayiza totuka ku Yeluzalemi, bayuvula :<verse eid="MAT 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 2:2"/>—A kuevi kuidi Ntinu Bayuda, wowo butukidi e ? Bila tumueni mbueteteꞌandi thama ku ndambu Esite, diawu tuizidi muingi tumbuongimina.<verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>Ntinu Elode bu kawa mambu momo, mayindu mandi mayama mu diambu di kiuvu kioki bayuvula, niandi ayi basi Yeluzalemi baba ku tsi mayindu. <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>Elode wutumisa bapfumu boso ba banganga zi Nzambi ayi minlongi mi Mina, wuba yuvula kani kuevi Mesiya kela butukila.<verse eid="MAT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5"/>Bamvutudila :</para>
  <para style="p" vid="MAT 2:5">—Wela butukila ku Betelemi didi mu tsi yi Yuda bila mbikudi wusonika :<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>
    <char style="qt">A ngeyo Betelemi, divula didi mu tsi Yuda,</char></para>
  <para style="q1" vid="MAT 2:6">
    <char style="qt">Kadi sia ti ngeyo lutidi keva mu minyadi mioso mi Yuda,</char></para>
  <para style="q1" vid="MAT 2:6">
    <char style="qt">bila mu ngeyo muela totukila Pfumu ;</char></para>
  <para style="q1" vid="MAT 2:6">
    <char style="qt">niandi wela ba nsungi wu batu bama, Iseli.</char><verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>Buna Elode wutumisa mu kitsueki banduenga ayi wuba yuvula thangu mbi yitotuka mbuetete. <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>Bosi wuba tuma ku Betelemi, ayi wuba kamba :</para>
  <para style="p" vid="MAT 2:8">—Yendanu kuna ayi lutomba buzabila bumboti mambu madi mu muana beni. Beno kummona buna luiza khambi muingi mamvama ndienda mbuongimina.<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9"/>Buna bamana wa ntinu, bayenda kuawu. Buela zimbukila mbuetete yoyi batuama mona ku Esite yi buela bamonikina, yawu yiba tuaminina ku ntuala mu nzila nate yiyenda telama va yilu buangu kiba muana. <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>Khini yiwombo yiba yawu buna bamona mbuetete. <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>Bakota muna nzo, bamona muana ayi ngudi andi Maliya, batumbu fukama vaba muana, beka ku mbuongimina. Bosi banianguna zitsaku zi banata, muba makaba ma bavana muana : nolo, ansa<note caller="+" style="f"><char style="fr" closed="false">2.11 </char><char style="fq" closed="false">ansa</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">madi maka maba totulanga nti wuba ku Alabi. Maba totulanga tsudi yikitoko bu mavikulu ku mbazu. </char></note> Ayi mile<note caller="+" style="f"><char style="fr" closed="false">2.11 </char><char style="fq" closed="false">mile</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">mafuta ma tsudi yikitoko.</char></note>.<verse eid="MAT 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12"/>Nzambi bu kaba lubula mu ndozi ti babika vutukila kuidi Elode, mu nzila yinkaka bavutukila ku tsi awu.<verse eid="MAT 2:12"/></para>
  <para style="s1">Batinisa Yesu ku Ezipite</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>Buna bayenda, mbasi yimosi yi Pfumu yimonikina Zozefi mu ndozi, yinkamba :</para>
  <para style="p" vid="MAT 2:13">—Telama wubonga muana ayi ngudi andi, tinina ku Ezipiti. Vuanda kuna nate ndiela kukamba ti thangu yivutukila yifueni, bila Ntinu Elode wela tomba vonda muana !<verse eid="MAT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14"/>Muna builu beni Zozefi wutelama, wubonga muana ayi ngudi andi, wuyenda tinina ku Ezipiti. <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>Wukala kuna nate Ntinu Elode kafua mu diambu di dedikisa mambu mayoluka Pfumu mu munu wu mbikudi, bu kabikula ti : <char style="qt">Nditela muanꞌama katotuka ku Ezipiti !</char><verse eid="MAT 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>Elode bu kazaba banduenga bamvuna, wufuema ngolo. Diawu katumina bavonda, ku Betelemi ayi mu mala mafikamini, bana boso bababakala badi mimvu miodi nate kuna tsi, landila thangu yiba nkamba kuidi batu beti longuka zimbuetete.<verse eid="MAT 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17"/>Mu nzila yoyo mambu mabikula mbikudi Yelemi madedakana :<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>
    <char style="qt">Mbembo yiwakana ku Lama</char></para>
  <para style="q1" vid="MAT 2:18">
    <char style="qt">bidilu ayi maniongo mawombo ;</char></para>
  <para style="q1" vid="MAT 2:18">
    <char style="qt">Lakheli wulembo didi bana bandi ;</char></para>
  <para style="q1" vid="MAT 2:18">
    <char style="qt">kakadi zola bombo</char></para>
  <para style="q1" vid="MAT 2:18">
    <char style="qt">bila bana beni basiedi ko.</char><verse eid="MAT 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>Elode bu kafua, mbasi yi Pfumu yimonikina Zozefi<note caller="+" style="f"><char style="fr" closed="false">2.19 </char><char style="ft" closed="false">Minkanda minkaka misonika Yosefi va buangu ki Zozefi.</char></note> mu ndozi ku Ezipiti, <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>ayi yinkamba :</para>
  <para style="p" vid="MAT 2:20">—Telama wubonga muana ayi ngudi andi, vutuka yawu ku Iseli, bila batu bobo babedi tombanga mu vonda muana bafuidi.<verse eid="MAT 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21"/>Zozefi wutelama, wubonga muana ayi ngudi andi, wuvutuka ku Iseli. <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>Vayi Zozefi, bu kawa ti Alikelawusi muana Elode, wuyadila Yuda va buangu ki dise diandi Elode, wumona tsisi mu buela vutuka kuna. Bosi mu ndozi yinkaka Nzambi wunlubula ti kenda mu zunga ki Ngalili. <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>Buna wuvuanda mu divula diba tedolongo Nazaleti muingi mambu ma mimbikudi madedakana : <char style="qt">bela kuntedilanga muisi Nazaleti.</char><verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="ms1">KHUBUKULU YI KISALU KI YESU</para>
  <para style="s1">Yowani Mbotiki mvuala Nzambi</para>
  <para style="r">(<ref loc="MRK 1:2-6">Malako 1.2-6</ref> ; <ref loc="LUK 3:1-6">Luka 3.1-6</ref> ; <ref loc="JHN 1:19-23">Yowani 1.19-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>Mu bilumbu bina, Yowani Mbotiki wuyiza ayi wutona longa mu dikanga didi mu tsi Yuda. <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/>Wuba longanga :</para>
  <para style="p" vid="MAT 3:2">—Lubalula mavanga ! Bila kipfumu ki Diyilu kinefikimini.<verse eid="MAT 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 3:3"/>Yowani, niandi bayolukila kuidi mbikudi Ezayi :</para>
  <para style="q1" vid="MAT 3:3">
    <char style="qt">Mbembo yi mutu wulembo yamikina mu dikanga :</char></para>
  <para style="q1" vid="MAT 3:3">
    <char style="qt">Lukubika nzila mu diambu di Pfumu !</char></para>
  <para style="q1" vid="MAT 3:3">
    <char style="qt">Luludika minsolo miandi !</char><verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>Yowani wuba vuatanga minledi mivangulu mu mika mi kamela<note caller="+" style="f"><char style="fr" closed="false">3.4 </char><char style="fq" closed="false">Kamela</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">phila bulu kidi banga phunda, kidi ayi khuki vayi kikubuku mu natanga bizitu mu dikanga. Kizebi nua nlangu wuwombo-wombo.</char></note>, bosi nsinga kaba kanganga mu luketo wuvangulu mu nkanda wu bulu ; bidia kaba ndianga makhoko ayi niosi. <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>Batu batotukila ku Yelusalemi, mu Yuda dioso ayi mu yenda nlangu Yolidani baba nkuizanga kuidi Yowani. <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>Atu beni bu baba tambudilanga masumu mawu, Yowani wuba kuba botikanga mu nlangu Yolidani.<verse eid="MAT 3:6"/></para>
  <para style="r">(<ref loc="LUK 3:7-9">Luka 3.7-9</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>Vayi bu kamona Bafalisi ayi Basaduki bawombo baba nkuizanga ku botama, buna wuba kamba :</para>
  <para style="p" vid="MAT 3:7">—A bana ba bikusa ; a nani wululubudi mu tina nganzi yoyi yeka kuiza ? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>Monisanu mavanga mamboti mammonisa ti bukiedika lubaludi mavanga. <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>Lubika banza bu lulembo yindula mu mintima mieno : “Beto tuidi mu nkuna wu Abalahami !” Bila bukiedika ndikulukamba ti Nzambi lenda totula bana ba Abalahami mu matadi mama<note caller="+" style="f"><char style="fr" closed="false">3.9 </char><char style="ft" closed="false">Mu minkanda minkaka musonama : Nzambi lenda kitula matadi mama bana ba Abalahami.</char></note>.<verse eid="MAT 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 3:10"/>Lukeba : soka kikubimini mu kuanga mianzi mi minti. Woso nti wunkambu buta mimbutu mamboti, wela kuangu ayi wela viku ku mbazu.<verse eid="MAT 3:10"/></para>
  <para style="r">(<ref loc="MRK 1:7-8">Malako 1.7-8</ref> ; <ref loc="LUK 3:15-18">Luka 3.15-18</ref> ; <ref loc="JHN 1:24-28">Yowani 1.24-28</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>—Minu mu nlangu ndilembo lubotikila mu diambu di monisa ti lulembo balula mavanga ; vayi mutu wowo wulembo yizi wundutidi mu lulendo ; ndisi fuana ko mu nata zisapatu ziandi. Niandi wela lubotikila mu Pheve Yinlongo ayi mu mbazu. <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>Ayi simbidi vevolo mu mioko miandi, niandi wela kombula buangu kioki kela vevila ; wela lunda ble<note caller="+" style="f"><char style="fr" closed="false">3.12 </char><char style="fq" closed="false">ble</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">phila kunusu kinsadulungu falina ; kidi banga loso.</char></note> ku yilu banga vayi wela yoka biti ku mbazu yi kayilendi zima ko.<verse eid="MAT 3:12"/></para>
  <para style="s1">Yesu wubotama</para>
  <para style="r">(<ref loc="MRK 1:9-11">Malako 1.9-11</ref> ; <ref loc="LUK 3:21-22">Luka 3.21-22</ref> ; <ref loc="JHN 1:29-34">Yowani 1.29-34</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>Yesu wubotuka ku Ngalili, mu kuenda ku ndambu nzadi Yolidani muingi bambotika kuidi Yowani.<verse eid="MAT 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 3:14"/>Vayi Yowani wuzola kunkakidila ayi wunkamba :</para>
  <para style="p" vid="MAT 3:14">—Minu mfueni botoko kuidi ngeyo vayi ngeyo kuidi minu wizidi !<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>Yesu wumvutudila :</para>
  <para style="p" vid="MAT 3:15">—Buabu, bika bu bela bobo ! Bila bobo bufueti dedokosolo busonga boso. Mbadi Yowani wumbotika.<verse eid="MAT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16"/>Yesu bu katumbu botoko, wutotuka mu nlangu. Mbadi Diyilu dizibuka mu diambu diandi<note caller="+" style="f"><char style="fr" closed="false">3.16 </char><char style="fq" closed="false">mu diambu diandi</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">mambu mama masi ko mu minkanda minkaka.</char></note> ayi wumona Pheve yi Nzambi yikuluka va niandi banga dibembi. <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>Bosi mbembo yiba ku Diyilu yiwakana :</para>
  <para style="p" vid="MAT 3:17">—Niandi niawu muanꞌama wu luzolo, khini yiwombo kakumbonisanga !<verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">Thotolo yi Yesu</para>
  <para style="r">(<ref loc="MRK 1:12-13">Malako 1.12-13</ref> ; <ref loc="LUK 4:1-13">Luka 4.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>Ku nzimunina, Pheve Yinlongo yinata Yesu ku dikanga muingi Satana<note caller="+" style="f"><char style="fr" closed="false">4.1 </char><char style="fq" closed="false">Satana</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">Khadi-a-Phemba </char></note> kantota. <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>Bu kafua nzala, mu diambu di lusambulu<note caller="+" style="f"><char style="fr" closed="false">4.2 </char><char style="fq" closed="false">kafua nzala, mu diambu di lusambulu</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">voti mina nsoki.</char></note> mu tezo ki makumaya ma bilumbu, muini ayi builu ; buna wumona nzala. <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>Mbadi mvukumuni wuyiza va kaba ayi wunkamba :</para>
  <para style="p" vid="MAT 4:3">—Enati widi Muana Nzambi buna kamba matadi mama makituka mapha.<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>Vayi Yesu wumvutudila :</para>
  <para style="p" vid="MAT 4:4">—Disonama ti :</para>
  <para style="q1" vid="MAT 4:4">
    <char style="qt">mutu kalendi zingilanga kaka mu dipha ko</char></para>
  <para style="q1" vid="MAT 4:4">
    <char style="qt">vayi mu mambu moso mantotukanga mu munu wu Nzambi.</char><verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>Buna Satana wunnata ku divula dinlongo, wuntula ku mbata muanzu wu Nzo Nzambi ; <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>ayi wunkamba : “Enati bukiedika widi Muana Nzambi wukilozi ku ntoto, bila disonama :</para>
  <para style="q1" vid="MAT 4:6">
    <char style="qt">Nzambi wela fidisa zimbasi ziandi mu diambu diaku</char></para>
  <para style="q1" vid="MAT 4:6">
    <char style="qt">ayi ziela kunata mu mioko miawu</char></para>
  <para style="q1" vid="MAT 4:6">
    <char style="qt">mu diambu kulu kuaku kuedi bumina thutu mu ditadi !”</char><verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>Yesu wumvutudila :</para>
  <para style="p" vid="MAT 4:7">—Disonama diaka ti :</para>
  <para style="q1" vid="MAT 4:7">
    <char style="qt">“Wulendi vukumuna Pfumu Nzambi aku ko !”</char><verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>Satana wunnata diaka va mbata mongo wunda, kuna kammonisina bipfumu bioso bidi va nza ayi minkembo miawu. <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>Bosi wunkamba :</para>
  <para style="p" vid="MAT 4:9">—Tala, ngeyo kumfukimina kuandi ayi kumbuongimina ; ndieka kuvana bima bioso biabi !<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>Yesu wunkamba :</para>
  <para style="p" vid="MAT 4:10">—Botuka, Satana ! Bila disonama ti :</para>
  <para style="q1" vid="MAT 4:10">
    <char style="qt">“Pfumu Nzambi aku niandi fueti buongimina ayi niandi kaka fueti sadila !”</char><verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>Buna satana wumbika. Bosi zimbasi ziyiza va kaba ayi zinsadila.<verse eid="MAT 4:11"/></para>
  <para style="ms1">KISALU KI YESU KU NGALILI</para>
  <para style="s1">Yesu wutona longa</para>
  <para style="r">(<ref loc="MRK 1:14-15">Malako 1.14-15</ref> ; <ref loc="LUK 4:14-15">Luka 4.14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>Yesu bu kawa ti bakotisa Yowani mu nloko ; buna wuvutuka ku Ngalili. <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>Wubotuka ku Ngalili. Wuyenda vuanda ku Kafalinawumi, divula didi mu ndambu mbu ; mu tsi yi Zabuloni ayi Nefatali <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>muingi mambu ma mbikudi Ezayi madedakana :<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>
    <char style="qt">Tsi yi Zabuloni ayi yi Nefatali,</char></para>
  <para style="q1" vid="MAT 4:15">
    <char style="qt">tsi yidi mu ndambu mbu ku disimu di Yolidani ayi ku Ngalili</char></para>
  <para style="q1" vid="MAT 4:15">
    <char style="qt">tsi yi makanda ma Bapakanu</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4.15 </char>
      <char style="fq" closed="false">Bapakanu</char>
      <char style="fqa" closed="false"> : </char>
      <char style="ft" closed="false">badi batu bakambulu mu dikanda di Bayuda.</char>
    </note>
    <char style="qt">.</char><verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>
    <char style="qt">Batu baba nzingilanga mu tombi bamona kiezila kingolo ;</char></para>
  <para style="q1" vid="MAT 4:16">
    <char style="qt">kiezila kitotukila batu bobo baba nkalanga mu tsi yiba</char></para>
  <para style="q1" vid="MAT 4:16">
    <char style="qt">diengidilanga kitsuisula ki lufua.</char><verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>Tona thangu yina, Yesu wutona longa bu katuba :</para>
  <para style="p" vid="MAT 4:17">—Lubalula mavanga bila Kipfumu ki diyilu kifikimini !<verse eid="MAT 4:17"/></para>
  <para style="s1">Minlonguki mitheti mi Yesu</para>
  <para style="r">(<ref loc="MRK 1:16-20">Malako 1.16-20</ref> ; <ref loc="LUK 5:1-11">Luka 5.1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>Yesu bu kaba kuenda yendanga muna muyenda mbu wu Ngalili, wumona bakhomba buadi ; Simoni diodi baba ntedilanga Piela ayi khombꞌandi Andela balembo lozi dikondi mu mbu bila baba banlobi mbizi. <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>Buna wuba kamba :</para>
  <para style="p" vid="MAT 4:19">—Ndandakananu ayi ndiela kulukitula minlobi mi batu.<verse eid="MAT 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 4:20"/>Muna thangu beni kaka, basia bika makondi mawu ayi banlandakana.<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>Buela kuesa fioti, wumona diaka bakhomba buadi : Zaki muana Zebede ayi khombꞌandi Yowani, balembo londi makondi mawu mu khati nlungu va kimosi ayi dise diawu Zebede. Mamvawu wuba tela. <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>Muna yawu thangu mamvawu babika nlungu awu ayi dise diawu, banlandakana.<verse eid="MAT 4:22"/></para>
  <para style="s1">Yesu wubelusa bambevo</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luka 6.17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>Yesu wudiata mu Ngalili dioso ayi wuba longanga mu zinzo ziawu zi lukutukunu, wuba longanga Nsamu Wumboti wu Kipfumu. Wubelusa ziphila zioso zi bimbevo ayi ziphasi zioso zi phila mu phila mu batu. <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>Zitsangu ziandi zimana tembakana mu tsi yoso yi Sili ayi bannatina batu boso baba bimbevo ; bobo bamona ziphasi zi phila mu phila ; ayi yamusu ku phila mu phila, bobo baba ziphevi zimbimbi, bobo baba kimbevo kisisuka ayi bobo baba kimbevo kivonga mianzi. Yesu wumana babelusa. <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>Nkangu wu batu bawombo baba kuenda nlandakananga : baba mu Ngalili, baba mu Dekapoli<note caller="+" style="f"><char style="fr" closed="false">4.25 </char><char style="fq" closed="false">Dekapoli</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">zunga kikutikisa dikumi di mavula.</char></note>, baba mu Yelusalemi, baba mu Yuda dioso ayi baba ku disimu di Yolidani.<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">Yesu wulonga wa mbata mongo</para>
  <para style="r">(<ref loc="MRK 3:13">Malako 3.13</ref> ; <ref loc="LUK 6:12-13">Luka 6.12-13</ref>,<ref loc="LUK 6:20">20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>Yesu bu kamona nkangu wu batu wukuma va mbata mongo, wuvuanda. Minlonguki miandi mikutakana va kaba. <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>Bosi wutona kuba longa. Wutuba :<verse eid="MAT 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 5:3"/>Khini kuidi minsukami mu Pheve, bila bawu bavuidi Kipfumu ki Diyilu.<verse eid="MAT 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 5:4"/>Khini kuidi bawu bandila bila bela bombo.<verse eid="MAT 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 5:5"/>Khini kuidi bawu badi mintima milembama, bila bawu bela vinginina ntoto.<verse eid="MAT 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 5:6"/>Khini kuidi bawu beta monanga tsatu ayi phuila yi mambu masonga, bila bela yukutusu.<verse eid="MAT 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 5:7"/>Khini kuidi bawu badi mintima mi kiadi, bila bela kuba mona kiadi.<verse eid="MAT 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 5:8"/>Khini kuidi bawu badi mintima mivedila, bila bela mona Nzambi.<verse eid="MAT 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 5:9"/>Khini kuidi bawu beti tula ndembama, bila bela tedolo bana ba Nzambi.<verse eid="MAT 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 5:10"/>Khini kuidi bawu beta yamusu mu diambu di busonga, bila bawu bavuidi Kipfumu ki Diyilu.<verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>Khini kuidi beno enati bakulufinganga, enati bakulu yamisanga ayi enati bakuluvuninanga mambu mambimbi ma phila mu phila mu diambu diama.<verse eid="MAT 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 5:12"/>Lumona kueno khini, lusakadala bila mfutu wunneni wukuluvingila ku Diyilu. Luzaba mboti ti mimbikudi mi lutuamina mamvawu bobo bayamusulu.<verse eid="MAT 5:12"/></para>
  <para style="s1">Tsalu ayi kiezila</para>
  <para style="r">(<ref loc="MRK 9:50">Malako 9.50</ref> ; <ref loc="MRK 4:21">4.21</ref> ; <ref loc="LUK 14:34-35">Luka 14.34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>—Beno luidi tsalu yi ntoto. Enati tsalu yizimbisidi lueki luandi, mu mbi balenda diaka vutudila lueki beni ? Kadi mfunu yisiedi ko, bafueti kuyiloza ku nganda ayi batu bafueti yidiata.<verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>Beno luidi muinda wu nza, divula diodi didi va yilu mongo, dilendi suama ko. <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>Enati balemisini muinda, bawu tulanga ku tsi katini ko, vayi va yilu meza muingi wumonisa kiezila kuidi batu boso badi mu nzo. <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>Diawu bika kiezila kieno kilezimina bobo vadi batu muingi bamona mavanga meno mamboti ayi muingi bakembisa Dise dieno didi ku Diyilu.<verse eid="MAT 5:16"/></para>
  <para style="s1">Yesu ayi Mina</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>—Lubika yindula ti ndiyiza mu diambu di vonda Mina voti mu diambu di vonda malongi ma mimbikudi. Ndisia kuiza ku vonda ko vayi ndiyiza mu diambu di dukisa miawu. <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>Bila bukiedika ndikulukamba : sumbu Diyilu ayi ntoto bikidi zingi buna kadi kima kimosi kilendi botolo ko mu Mina ; ka diambu ko sono kimosi kifioti. Vayi nate mamoso mela vangama.<verse eid="MAT 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 5:19"/>Diawu woso mutu weta bundula muina wawu wumosi wufioti ayi wela longa batu bavanga buawu, wela monika mutu wukhioki mu Kipfumu ki Diyilu. Vayi woso mutu wunlonganga Mina mi Nzambi ayi weta misadila, wela monika mutu wunneni mu Kipfumu ki Diyilu.<verse eid="MAT 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 5:20"/>Bila ndikulukamba enati busonga bueno bukadi viatuka bobo bu Bafalisi ayi bu Minsoniki mi Mina, buna lulendi kota ko mu Kipfumu ki Diyilu.<verse eid="MAT 5:20"/></para>
  <para style="s1">Kadi finga ayi kadi fuemisa khombꞌaku</para>
  <para style="r">(<ref loc="MRK 11:25">Malako 11.25</ref> ; <ref loc="LUK 12:57-59">Luka 12.57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>—Luwa ti bakamba kuidi bakulu beto ti : <char style="qt">kadi vonda mutu bila woso wela vonda mutu wela samba va ntuala mazuzi.</char> <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>Vayi minu ndikulukamba : woso mutu wumfuemina ndiandi wela samba va ntuala mazuzi. Woso mutu wumfinga ndiandi ti : “vungisi”, wela samba na ntuala lukutukunu lu bapfumu banganga Nzambi, ayi woso mutu wunfinga ndiandi ti widi “dilawu” mboti mu kunloza ku mbazu yi bulungi.<verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>Enati telimini ku kuma mu vana makaba, ayi tebukidi moyo ti diambu khombꞌaku kabeki, <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>bika makaba maku vana ntuala, kuma, yenda teka dedikisa ayi khombꞌaku bosi yiza vani makaba maku kuidi Nzambi.<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>Enati mutu wubeki mambu vika wizana ayi niandi bu lukidi mu nzila bila niandi kufunda kuidi zuzi, zuzi maka tuma masodi muingi matula mu nloko. <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>Bukiedika ndikukamba ti mawu kala kaka muna nloko nate wumana futa zimbongo zioso.<verse eid="MAT 5:26"/></para>
  <para style="s1">Kadi vanga kitsuza</para>
  <para style="r">(<ref loc="MAT 18:8-9">Matayi 18.8-9</ref> ; <ref loc="MRK 9:43">Malako 9.43</ref>,<ref loc="MRK 9:47-48">47-48</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>—Luwa ti ditubu : <char style="qt">kadi vanga kitsuza.</char> <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>Vayi minu ndikulukamba ti woso wuntala nketo mu kunzinina, buna vengi yandi kitsuza mu ntimꞌandi. <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>Diawu enati dieso diaku, di lubakala<note caller="+" style="f"><char style="fr" closed="false">5.29 </char><char style="ft" closed="false">dieso di lubakala</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">dinsundula dieso dieti luta mona bumboti. </char></note> Dilembo kuvodisa masumu, mboti mu kudidovula ayi ku diloza thama. Bila bulutidi mboti kuidi ngeyo mu kambu nama kimosi ki nituꞌaku ayi mu tala nitu aku yimvimba yilozama ku bulungi. <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>Bosi enati koko kuaku, ku lubakala<note caller="+" style="f"><char style="fr" closed="false">5.30 </char><char style="fq" closed="false">koko kuaku, ku lubakala</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">dinsundula koko ku lutidi ngolo.</char></note>, kulembo kuvodisa masumu, mboti wukuzenga ayi wukuloza thama, bila bulutidi mboti kuidi ngeyo mu kambu nama kimosi ki nituꞌaku ayi mu tala nitu aku yimvimba yilozama ku bulungi.<verse eid="MAT 5:30"/></para>
  <para style="r">(<ref loc="MAT 19:7-9">Matayi 19.7-9</ref> ; <ref loc="MRK 10:11-12">Malako 10.11-12</ref> ; <ref loc="LUK 16:18">Luka 16.18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>—Bakamba diaka : <char style="qt">“Woso mutu botudi nketo andi buna bufueni kamvana nkanda wu kimbangi wumonisa ti vondidi dikuela.”</char> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>Vayi minu ndikulukamba : woso bakala wumvambana ayi nketo andi, bika sia ti mu diambu di kitsuza, buna niandi wunyekudi mu vanga kitsuza. Ayi woso wunkuela nketo wowo mamvandi vengi kitsuza.<verse eid="MAT 5:32"/></para>
  <para style="s1">Kadi leva ndefi</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>—Luwa diaka ti bakamba kuidi bakulu beto : <char style="qt">“kadi vonda ndefi wuleva, vayi dukisa ndefi wuvana Pfumu.”</char> <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>Minu ndikulukamba lubika kueno levanga ndefi. Kadi levilanga ndefi mu “dizina di Diyilu” bila Diyilu diawu kundu ki Nzambi. <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>Lubika levilanga ndefi mu dizina di ntoto bila va ntoto vawu Nzambi keti tetika malu mandi. Lubika levilanga ndefi mu dizina di Yelusalemi bila diawu divula di Ntinu wunneni. <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>Kadi levilanga ndefi va “ntuꞌaku” bila kulendi kitula lusuki lumosi phembi ko voti ndombi ko. <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>Bika lutubanga kaka “Nyinga” bu lufueti tuba nyinga ayi “nana” bu lufueti tuba nana. Bila mambu moso meti buelama va yilu kuidi Satana meti ba.<verse eid="MAT 5:37"/></para>
  <para style="s1">Kadi vutudila khombꞌaku mbimbi</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luka 6.29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>—Luwa bu bakamba : <char style="qt">“Enati mutu tobudi dieso di ndiandi, niandi mamvandi bafueti tobula dieso diandi ; enati mutu kodidi dieno di ndiandi, niandi mamvandi bafueti kola diano diandi</char><note caller="+" style="f"><char style="fr" closed="false">5.38 </char><char style="ft" closed="false">Minkanda minkaka misonika dieso mu dieso ; dieno mu dieno bu dinsundula ti mambimbi mavengi mawu bafueti kuvutudila.</char></note><char style="qt">.” </char> <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>Vayi minu ndikulukamba :</para>
  <para style="p" vid="MAT 5:39">—Lubika kakidila mutu tidi kuvangila mambimbi ! Enati bazubidi mbata mu luvenga lumosi, wuntambika diaka luvenga lunkaka. <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>Enati mutu tidi kufunda ayi ziona kikhutu kiaku, buna wunyekudila ayi yunga kiaku. <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>Enati mutu wukuikidi wudiata yandi mu tezo ki kilometele kimosi, ngeyo buela diati yandi mu tezo ki bikilometele biodi. <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>Vana kuidi mutu wowo wukulomba ayi kadi yimina mutu wowo wunzola deva kuidi ngeyo.<verse eid="MAT 5:42"/></para>
  <para style="s1">Luzola bambeni beno</para>
  <para style="r">(<ref loc="LUK 6:27-36">Luka 6.27-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>—Luwa ti bakamba : <char style="qt">“zolanga ndiaku ayi lendanga mbeni aku”</char> <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>Vayi minu ndikulukamba : Luzola bambeni beno ! Lusambidila bobo bakuluyamisanga ! <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>Buawu bobo luela bela bana bakiedika ba Dise dieno didi ku Diyilu. Bila niandi weta kienzudila thangu andi kuidi batu bambimbi ayi batu bamboti ; weta nokisa mvula kuidi batu basonga ayi kuidi bobo bakambulu basonga. <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>Enati lueta zola bobawu beta kuluzola, buna mbi mfutu lumbaka ? Bila mimfutisi mi ziphaku mamvawu beta bu vanga. <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>Enati lueta vana kaka mboti kuidi bakhomba zieno, buna diambu mbi diviatukidi lumvanga e ? Keti Bapakanu mamvawu beti bu vanga. <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>Vayi beno bufueni luba batu bafuana banga buididi Dise dieno widi ku Diyilu widi wufuana.<verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">Tina tsambudulu yi mayuya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>—Lukeba, lubika vangilanga mavanga meno masonga va meso ma batu muingi balumona. Tala luedi kambu nsendo wu Dise dieno widi ku Diyilu. <verse eid="MAT 6:1"/><verse number="2" style="v" sid="MAT 6:2"/>Thangu wumvana lusadusu kuidi mutu wusukama, kadi sika tulumbeta ku ntualꞌaku<note caller="+" style="f"><char style="fr" closed="false">6.2 </char><char style="ft" closed="false">Mu thangu Yesu, Bayuda bobo baba zimvuama baba sikisanga tulumbeta mu thangu bamvioka mu nzila. Minsukami miawu wa tulumbeta beni, buna miba kutakananga mu diambu di tambula lusadusu.</char></note> banga bueta vangila batu badi mayuya, mu zinzo zi zikhutukunu ayi mu zinzila muingi batu baba niemisa. Bukiedika ndikulukamba ti bakitambudidi nsendo awu. <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>Vayi ngeyo bu wumvana lusadusu kuidi mutu wusukama, bika koko kuaku ku lumoso kubika zaba mavengi koko kuaku ku lubakala, <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>muingi dikaba diaku divanunu mu kitsueki ayi muingi Dise diaku dieti mona mamo mamvangiminanga mu kitsueki wela kufuta.<verse eid="MAT 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>Mu thangu lunsambila lubika ba banga batu bobo badi mayuya, beti sambidila kimathelama, mu ziphambu zi zinzila ayi mu zinzo zi zikhutukunu muingi batu babamona. Bukiedika, ndikulukamba bakitambudidi mfutu awu. <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>Vayi ngeyo bu tidi sambila, kota mu vinga kiaku ; zibika muelo, sambila Dise diaku dimvuandanga mu kitsueki. Buna Dise diaku dieti mona mamo mamvangiminanga mu kitsueki wela kufuta.<verse eid="MAT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7"/>Mu thangu lunsambila, lubika vutukilanga mambu banga bueta vanga Bapakanu, bila bawu beti muena ti zitsambulu zieti tambudulu bu beti nonumunanga mambu. <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>Lubika basokudila. Bila Dise dieno zebi mbi luvuidi mfunu, beno mu kambu teka kunlomba.<verse eid="MAT 6:8"/></para>
  <para style="r">(<ref loc="LUK 11:2-4">Luka 11.2-4</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>Tala phila lufueti sambidilanga :</para>
  <para style="q1" vid="MAT 6:9">Tatꞌeto widi ku Diyilu,</para>
  <para style="q1" vid="MAT 6:9">bika dizina diaku diba dinlongo<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>Bika Kipfumu kiaku kiza.</para>
  <para style="q1" vid="MAT 6:10">Bika luzolo luaku luvangama va ntoto,</para>
  <para style="q1" vid="MAT 6:10">banga bu lueti vangimina ku Diyilu.<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>Wutuvana buabu bidia bieto bi kadika lumbu.<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>Wutulemvukila mambimbi meto ;</para>
  <para style="q1" vid="MAT 6:12">banga beto bu tunlemvukilanga batu</para>
  <para style="q1" vid="MAT 6:12">bobo batuvangila mambimbi.<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>Kadi kutu bika tubua mu phukumunu,</para>
  <para style="q1" vid="MAT 6:13">vayi wutukula mu mvukumuni,</para>
  <para style="q1" vid="MAT 6:13">[Bila ngeyo vuidi kipfumu, lulendo ayi nkembo</para>
  <para style="q1" vid="MAT 6:13">mu mimvu mi kamimani<note caller="+" style="f"><char style="fr" closed="false">6.13 </char><char style="ft" closed="false">Mambu mama madi [ ] masi ko mu minkanda minkaka.</char></note>.]<verse eid="MAT 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14"/>Enati lulemvukila batu mu mambimbi mawu buna Dise dieno didi ku Diyilu wela kululemvukila. <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>Vayi enati lumengi lemvukila batu buna Dise dieno kalendi kululemvukila ko.<verse eid="MAT 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>—Mu thangu lukukifuisa nzala mu diambu di lusambulu, lubika monika kiadi-kiadi banga bueti vangila batu badi mayuya. Beti kitula bizizi kiadi-kiadi muingi batu boso bazaba ti bawu balembo kifuisi nzala mu diambu di lusambulu. Bukiedika ndilulukamba bakitambudidi mfutu awu. <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/>Vayi bu wulembo kukifuisi nzala mu diambu di lusambulu bika wusukula bumboti zizi kiaku ayi dukula mafuta ku ntu aku, <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>muingi mutu kabika zaba ti wulembo wukifuisi nzala mu diambu di lusambulu vayi Dise diaku kaka dimvuandanga mu kitsueki niandi kaka fueti zaba. Buna Dise diaku dieti mona mambu mamvangimina mu kitsueki wela kufuta.<verse eid="MAT 6:18"/></para>
  <para style="s1">Kimvuama ki ntoto wawu</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luka 12.33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>—Lubika yidika kimvuama va ntoto bila zitselele ayi khazu-khazu bilenda kibivisa ayi mivi milenda tobula zinzo ayi yiba. <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>Vayi yidikanu kimvuama beni ku Diyilu, kuna kukambulu zitselele ayi khazu-khazu yilendi bivisa ko ayi mivi milendi tobula ayi yiba ko. <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>Bila koso kuidi kimvuama kiaku, kuna kuela ba ntimꞌaku.<verse eid="MAT 6:21"/></para>
  <para style="r">(<ref loc="LUK 11:34-36">Luka 11.34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>—Dieso didi muinda wu nitu, enati dieso diaku didi dimboti, buna nituꞌaku yoso yidi yikienzuka. <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>Vayi enati dieso diaku didi dimbimbi buna nituꞌaku yoso mayiba mu tombi. Enati kiezila kidi mu ngeyo kidi tombi, buna tombi beni kiela ba kinkobo !<verse eid="MAT 6:23"/></para>
  <para style="r">(<ref loc="LUK 1:13">Luka 1.13</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>—Kuisi ko mutu wulenda sadila bapfumu buadi mu khumbu yimosi bila wela lenda wumosi ayi zola wunkaka ; voti wela singimina mu wumosi ayi wela lenda wunkaka. Lulendi sadila ko Nzambi ayi zimbongo.<verse eid="MAT 6:24"/></para>
  <para style="r">(<ref loc="LUK 12:22-31">Luka 12.22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>—Diawu ndikulukambila ti lubika bela luzingu lueno mayindu mu diambu di zaba mbi luela dia ayi mbi luela nua. Mbi luela vuata. Luzingu luisi vioka bidia mu mfunu ko e ? Ayi nitu yisi vioka minledi mu pfumu ko e ? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>Talanu zinuni zi diyilu, zikunanga ko ; zivelanga mimbutu ko ayi zilundanga bidia mu bilundulu ko. Ayi Dise dieno widi ku Diyilu weti zidikila. Beno lusi zivioka ko mfunu e ? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>Nani buna luidi lenda yika luzingu luandi, ka diambu ko mu thangu yimosi, kuna ku mayindu e ? <verse eid="MAT 6:27"/><verse number="28" style="v" sid="MAT 6:28"/>A buna bila mbi lueti belanga mayindu mu diambu di minledi e ? Bika lutala buevi bueti kudila biteka mu zitsola. Bisalanga ko ayi bitunganga ko. <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>Vayi ndikulukamba, banza nkutu ntinu Salomo mu nkembo andi woso kasia vuatila ko banga buvuatila kiteka kimosi mu biteka bina. <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>Buna enati Nzambi weti vuatisa bobo biti biobi bidi buabu mu zitsola vayi biela lozo mbazi ku mbazu, buna kalendi kuluvuatisa vioka biti beni ko e ? Batu ba minu kikhioki ! <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>Diawu lubika banga mayindu, mu tubanga : “kani mbi matudia”, voti “mbi matuvuata”. <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>Bila bapakanu bawu bantombanga bima bioso biobi. Vayi Dise dieno di Diyilu zebi ti mfunu luvuidi biawu. <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>Vayi lutomba theti Kipfumu ki Nzambi ayi busonga buandi, buna bela kulubuedila bima bioso biobi. <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>Lubika ba mayindu mu diambu di mbazi, bila mbazi wela ba mayindu mu diambu diandi veka ayi kadika lumbu kidi ayi ziphasi ziandi.<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">Kadi sambisa</para>
  <para style="r">(<ref loc="LUK 6:37-42">Luka 6.37-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>—Lubika sambisa, tala mamveno luedi sambusu. <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>Bila bela kulusambisa banga phila lunsambisila ayi bela ku lutezila luelo luela dedakana banga lolo lutezila bankaka.<verse eid="MAT 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3"/>Vayi bila mbi wumonina kiti kidi mu dieso di khombꞌaku, vayi ngeyo veka wukadi mona tunga yidi mu dieso diaku e ? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>Voti buevi wulenda kambila khombꞌaku : “Bika ndibotula kiti kidi mu dieso diaku ! Vayi tunga yidi mu dieso diaku.” <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>Mutu wu mayuya ! Botula theti tunga yoyi yidi mu dieso diaku buna bosi mawumona mboti mu botula kiti kidi mu dieso di khombꞌaku.<verse eid="MAT 7:5"/></para>
  <para style="s1">Kadi sumuna bima binlongo</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>—Lubika vana bima binlongo kuidi zimbua. Lubika loza bilunga bieno bithalu vadi zingulu, bila mazi bidiatila ayi mazi lubalukila muingi ziluvanga phasi.<verse eid="MAT 7:6"/></para>
  <para style="s1">Kadi vonga mu lomba ayi mu tomba</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luka 11.9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>—Lulomba ayi bela kuluvana. Lutomba ayi luela mona ; lukokuta ayi luela zibudulu. <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>Bila woso wunlombanga niandi wuntambulanga. Woso wuntombanga niandi wumonanga woso wunkokutanga niandi wunzibudulungu. <verse eid="MAT 7:8"/><verse number="9" style="v" sid="MAT 7:9"/>Nani mu beno lenda vana ditadi kuidi muanꞌandi bu kanlombidi dipha ? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>Voti bu kanlombidi mbizi buna nioka maka mvana e ? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>Enati beno batu bambimbi, luzebi vana bima bimboti kuidi bana beno, buna Dise dieno di Diyilu diela luta vana bima bimboti kuidi bobo bakunlombanga.<verse eid="MAT 7:11"/></para>
  <para style="s1">Khadulu yimboti ayi bakundi</para>
  <para style="r">(<ref loc="LUK 6:31">Luka 6.31</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12"/>—Mambu moso momo lutidi ti batu baluvangila mawu mamveno lufueti kuba vangila. Bila mawu mama malongi ma Mina ayi ma mimbikudi.<verse eid="MAT 7:12"/></para>
  <para style="s1">Lukotila va muelo wufietama</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>—Lukotila va muelo wufuetama bila muelo widi wuyalumuka ayi nzila yinatanga ku nzimbala yidi yinneni, ayi, batu bawombo beti kotilanga muawu. <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>Vayi muelo widi wufietama, nzila yi luzingu yidi yifioti ayi batu bafioti kuandi beti kuyibakulanga.<verse eid="MAT 7:14"/></para>
  <para style="s1">Lulubukila mimbikudi mi luvunu</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luka 6.43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>—Lulubukila mimbikudi mi luvunu miomi minkuizanga kuidi beno banga mamemi vayi mu kiedika badi memvu ma nganzi. <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>Luela kuba zabila mu mimbutu miawu. A buevi balenda vela makundi ma vinu mu nti widi zitsendi voti makundi ma figi mu nti wu zitsolokoto e ?<verse eid="MAT 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 7:17"/>Diawu woso nti wumboti wumbutanga mimbutu mimboti vayi nti wumbimbi wumbutanga mimbutu mimbimbi. <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>Nti wumboti wulendi buta ko mimbutu mambimbi ayi nti wumbimbi, wulendi buka ko mimbutu mamboti. <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>Woso nti wunkambu buta mimbutu mimboti wufueti vuzu ayi lozo ku mbazu. <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>Mu mimbutu miawu kaka luela kuba zabila.<verse eid="MAT 7:20"/></para>
  <para style="r">(<ref loc="LUK 13:25-27">Luka 13.25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>—Bika sia ti batu bobo beta kukhamba : “Pfumu ! Pfumu !” ti bawu bela kota mu kipfumu ki Diyilu, vayi bobo bamvanganga luzolo lu Dise diama didi ku Diyilu. <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>Mu lumbu kina batu bawombo bela kukhamba : “A Pfumu ! A Pfumu ! A keti mu dizina diaku tubikudila ! A keti mu dizina diaku tukukila ziphevi zimbimbi. A keti mu dizina diaku tuvangila bikumu biwombo !” <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>Buna minu ndiela kuba vutudila : “ndisi ku luzaba ko. Botukanu vava beno lumvanganga mambu mambimbi !”<verse eid="MAT 7:23"/></para>
  <para style="s1">Ntungi wu diela ayi wu buvulu</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luka 6.47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>—Diawu woso wulembo wa mambu ma ndilembo tubi ayi wunsadila mawu widi banga mutu wu diela wutunga nzoꞌandi va yilu ditadi. <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>Mvula yingolo yinoka, minlangu miwala ayi bivuka biyiza lumbama mu nzo beni vayi nzo beni yisia bua ko bila yitungulu va yilu ditadi. <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>Vayi woso mutu wulembo wa mambu mama vayi kakadi ku masadila widi banga mutu wu buvungisi wutunga nzoꞌandi va mbata nzielo. <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>Mvula yingolo yinoka, minlangu miwala ayi bivuka biyiza lumbama mu nzo beni. Nzo beni yitumbu bua ayi yitumbu tiolumuka.<verse eid="MAT 7:27"/></para>
  <para style="r">(<ref loc="MRK 1:22">Malako 1.22</ref> ; <ref loc="LUK 4:32">Luka 4.32</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>Yesu bu kamana tuba, nkangu wu batu wusimina mu diambu di malongi mandi. <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>Bila kaba kuba longilanga ko banga minsoniki miawu, vayi niandi wuba longila mu lulendo loso.<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">Yesu wubelusa bambevo bawombo</para>
  <para style="r">(<ref loc="MRK 1:40-45">Malako 1.40-45</ref> ; <ref loc="LUK 5:12-16">Luka 5.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>Yesu bu kakulumuka mongo ; nkangu wunneni wunlandakana. <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>Buna mutu wumosi wuba kimbevo kibuazi wuyiza kuidi Yesu, wufukama va ntualꞌandi ayi wutuba :</para>
  <para style="p" vid="MAT 8:2">—A Pfumu, enati tidi, wulenda kuaku kumbelusa !<verse eid="MAT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3"/>Yesu wunonuna koko kuandi, wunsimba ayi wunkamba :</para>
  <para style="p" vid="MAT 8:3">—Nyinga thidi, beluka kuaku. Mu yina thangu wubeluka mu buazi buandi.<verse eid="MAT 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 8:4"/>Bosi Yesu wunkamba :</para>
  <para style="p" vid="MAT 8:4">—Vayi keba, kadi kamba kadi kuidi mutu wumosi mambu mama vayi yenda kimonisa kuidi nganga Nzambi ayi nata dikaba dilomba Moyize mu diambu diba kimbangi kuidi bawu.<verse eid="MAT 8:4"/></para>
  <para style="r">(<ref loc="LUK 7:1-10">Luka 7.1-10</ref> ; <ref loc="JHN 4:43-54">Yowani 4.43-54</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>Yesu bu katula ku Kafalinawumi, pfumu yimosi yi masodi wuyiza kuidi niandi. Wunleba ayi wutuba :<verse eid="MAT 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 8:6"/>—Pfumu, kisadi kiama kilekidi ku nzo, kimbevo ki binama kidi yandi ayi ziphasi ziwombo kalembo moni.<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>Yesu wumvutudila :</para>
  <para style="p" vid="MAT 8:7">—Nyinga, ndiela kuiza ayi ndiela kumbelusa.<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>Vayi Pfumu yi masodi wutuba :</para>
  <para style="p" vid="MAT 8:8">—A Pfumu ! Minu ndisi wufuana ko muingi ngeyo wukota mu nzo ama vayi tuba kaka diambu dimosi buna kisadi kiama kiela beluka. <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>Bila nzebi diawu, minu mamvama ndidi ku tsi luyalu lu bapfumu ayi ndieti tumina bankaka. Minu kamba kuidi wumosi : “Yenda” makenda ayi minu kamba wunkaka : “yiza” makiza ayi kuidi kisadi kiama : “vanga buabu”, maka vanga buawu.<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>Yesu wusimina buwombo bu kawa mambu mandi. Wukamba batu bobo baba kunlandakananga :</para>
  <para style="p" vid="MAT 8:10">—Bukiedika ndikulukamba ndimueni ko minu kinneni mu Iseli dioso. <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>Ndikulukamba ti batu bawombo bela ba ku Esite ayi ku Wesite bela vuanda mu kipfumu ki diyilu mu kipfumu ki diyilu va kimosi ayi Abalahami, Isaki ayi Yakobi. <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>Vayi bobo bakubukulu kipfumu bela lozo ku nganda kuidi tombi, kuna kuela ba bidilu ayi nkuetoso wu meno.<verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>Bosi Yesu wukamba kuidi pfumu yi masodi :</para>
  <para style="p" vid="MAT 8:13">—Vutuka kuaku bika buvangimina boso bu wilukidingi ! Buna kisadi kiandi kibeluka kuandi muna thangu yina.<verse eid="MAT 8:13"/></para>
  <para style="s1">Wunata bimbevo bieto</para>
  <para style="r">(<ref loc="MRK 1:29-34">Malako 1.29-34</ref> ; <ref loc="LUK 4:38-41">Luka 4.38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>Thangu Yesu katula ku nzo Piela, wuyenda bata nzitu Piela wuba wuleka va mbuka bila zinzangala zingolo ziba yandi. <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>Yesu bu kansimba mu koko, zinzangala zimana. Bosi wutelama mu kunkubikila bidia.<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>Mu masika mana, banatina Yesu batu bawombo bobo baba ayi ziphevi zimbimbi. Mu mambu mandi katuba muawu kakukila ziphevi beni zimbimbi. Ayi wubelusa batu boso bobo baba bimbevo. <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>Buawu bobo mambu mambikudi Ezayi madedikinina :</para>
  <para style="q1" vid="MAT 8:17">
    <char style="qt">Wubonga ziphasi zieto ayi</char></para>
  <para style="q1" vid="MAT 8:17">
    <char style="qt">wunata bimbevo bieto.</char><verse eid="MAT 8:17"/></para>
  <para style="s1">Nlonguki kafueti kukivana</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luka 9.57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>Yesu bu kamona nkangu wu batu wunzungidila, wutuma minlonguki miandi mu sabuka ku disimu dinkaka di mbu. <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>Nlongi wumosi wu Mina wufikama ayi wunkamba :</para>
  <para style="p" vid="MAT 8:19">—A nlongi, thidi kulandakana koso ku wunkuenda.<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>Vayi Yesu wumvutudila :</para>
  <para style="p" vid="MAT 8:20">—Mimbaku midi ayi minsuku miawu miomi mieti leka, zinuni zidi ayi zindiala ziawu, vayi Muana Mutu kasi ko buangu kikalenda vundisila ntu.<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>Wumosi mu minlonguki miandi wunkanba :</para>
  <para style="p" vid="MAT 8:21">—A Pfumu ! Wundemvukila, vingila theti ndienda ziki dise diama.<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>Vayi Yesu wumvutudila :</para>
  <para style="p" vid="MAT 8:22">—Wundandakana ; bika bafua bazika batu bawu bafua !<verse eid="MAT 8:22"/></para>
  <para style="s1">Yesu wuviatuka vuka mu ngolo</para>
  <para style="r">(<ref loc="MRK 4:35-41">Malako 4.35-41</ref> ; <ref loc="LUK 8:22-25">Luka 8.22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>Buna wukuma mu nlungu ayi minlonguki miandi minlandakana. <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>Zimbukila vuka kimosi kingolo kitona mu mbu, mayo mavioka nlungu mu ntela vayi Yesu wuba wuleka.<verse eid="MAT 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 8:25"/>Minlonguki mifikama va kaba, minkotula mu yamikina :</para>
  <para style="p" vid="MAT 8:25">—Pfumu ! Wutuvukisa, tueka mfua !<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 8:26">—Bila mbi lulembo monina boma e ? Batu ba minu kikhioki ! Yesu wutelama, wutemina vuka ayi mbu ; buna ndembama yivutuka.<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>Batu basimina ayi batuba :</para>
  <para style="p" vid="MAT 8:27">—A buna nani niawu muingi bivuka ayi mbu bintumukina e ?<verse eid="MAT 8:27"/></para>
  <para style="s1">Yesu wuviatuka ziphevi zimbimbi mu ngolo</para>
  <para style="r">(<ref loc="MRK 5:1-20">Malako 5.1-20</ref> ; <ref loc="LUK 8:26-39">Luka 8.26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>Mu thangu batula ku disimu di mbu, mu zunga ki basi Ngelasa<note caller="+" style="f"><char style="fr" closed="false">8.28 </char><char style="fq" closed="false">Ngelasa</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">Minsekudi minkaka misonika zunga ki basi Ngadala, minkaka misonika zunga ki basi Ngelengesi. Tala Malako 5.1 ; Luka 8.26.</char></note>, batu buadi baba ziphevi zimbimbi batotuka mu biziami bayiza kundengana. Zinganzi ziwombo ziba yawu ; diawu kadi mutu wumosi kasia nunga ko mu viokila vana. <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>Bayamikina :</para>
  <para style="p" vid="MAT 8:29">—Diambu mbi tidi kutuvanga ngeyo Muana Nzambi e ? Wizidi mu kutuyamisa tuamina thanguꞌeto yifuana e ?<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>Va ndambu beni vaba nkangu wu zingulu ziba ndia. <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>Buna ziphevi beni zimbimbi zileba Yesu :</para>
  <para style="p" vid="MAT 8:31">—Enati weka tukuka, buna wututuma tukota kueto mu zingulu ziozi !<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>Yesu wuba kamba :</para>
  <para style="p" vid="MAT 8:32">—Yendanu !</para>
  <para style="p" vid="MAT 8:32">Zitotuka mu batu buadi beni zikota mu zingulu. Buna zingulu beni zioso zibotuka nsualu ku mongo ayi zidiama mu mbu, zimana fua.<verse eid="MAT 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33"/>Batu bobo basunga zingulu batina ; bayenda nsualu ku divula ayi basamuna mamo maviokidi ayi mavangimini mu batu bobo baba ziphevi zimbimbi. <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>Batu boso ba divula dina bayiza dengana Yesu ayi bu bammona buna banleba kabotuka mu zunga kiawu.<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">Yesu wutelimisa dikoka ayi wulemvukila masumu mandi.</para>
  <para style="r">(<ref loc="MRK 2:1-12">Malako 2.1-12</ref> ; <ref loc="LUK 5:17-26">Luka 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>Yesu wukuma mu nlungu ayi wusabuka mbu ; ayi wuyenda ku divula diandi. <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>Bannatina mu kiphoyi<note caller="+" style="f"><char style="fr" closed="false">9.2 </char><char style="fq" closed="false">Kiphoyi</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">minkanda minkaka misonama mbuka va buangu ki kiphoyi.</char></note> dikoka dimosi. Yesu bu kamona minu kiawu, wukamba dikoka :</para>
  <para style="p" vid="MAT 9:2">—Ba ayi bukhafi muanꞌama, masumu maku malemvukulu.<verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>Buna minlongi minkaka mi Mina mieka niunguta : “Mutu wawu wulembo vuezi Nzambi !” <verse eid="MAT 9:3"/><verse number="4" style="v" sid="MAT 9:4"/>Yesu wuzaba mayindu mawu ayi wuba yuvula :</para>
  <para style="p" vid="MAT 9:4">—Bila mbi luididi mayindu mambimbi mu mintima mieno ? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>Mbi bilutidi kambu phasi mu kamba : “Masumu maku malemvukulu” voti : “Telama kuaku ayi diata” ? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>Vayi muingi luzaba mboti ti Muana Mutu beki lulendo vava ntoto mu lemvukila masumu.</para>
  <para style="p" vid="MAT 9:6">Buna wutala dikoka ayi wunkamba :</para>
  <para style="p" vid="MAT 9:6">—Telama, bonga kiphoyi kiaku, vutuka ku nzoꞌaku.<verse eid="MAT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7"/>Dikoka beni ditelama ayi diyenda ku nzoꞌandi.<verse eid="MAT 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 9:8"/>Nkangu wu batu bu wumona bobo, bamona boma ayi bakembisa Nzambi wuvana lulendo luphila yoyi kuidi batu.<verse eid="MAT 9:8"/></para>
  <para style="s1">Bafindisa Yesu ziphaka</para>
  <para style="r">(<ref loc="MRK 2:13-22">Malako 2.13-22</ref> ; <ref loc="LUK 5:27-39">Luka 5.27-39</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>Yesu wuyenda. Bu kaba vioka, wumona mutu wumosi, dizina diandi Matayi, wuvuanda mu bilu kimfutusulungu ziphaku. Wunkamba :</para>
  <para style="p" vid="MAT 9:9">—Wundandakana !</para>
  <para style="p" vid="MAT 9:9">Matayi wutelama ayi wunlandakana. <verse eid="MAT 9:9"/><verse number="10" style="v" sid="MAT 9:10"/>Bu kaba ndia va meza mu nzo Matayi, buna mimfutisi miwombo mi ziphaku ayi bankua masumu bayiza dia va meza va kimosi ayi Yesu ayi minlonguki miandi.<verse eid="MAT 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 9:11"/>Bafalisi bu bamona bobo bayuvula minlonguki miandi :</para>
  <para style="p" vid="MAT 9:11">—Bila mbi Nlongiꞌeno kalembo dila va kimosi ayi mimfutisi mi ziphaku ayi bankua masumu e ?<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>Yesu bu kawa bobo, buna wuvutula :</para>
  <para style="p" vid="MAT 9:12">—Batu badi nitu yi mvini batombanga munganga ko vayi batu badi bimbevo bawu bantombanga munganga. <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>Luenda lulonguka tsundu yi mambu mama : <char style="qt">thidi luba batu badi mintima mi kiadi vayi mbengi luthambikanga kaka makaba. Bila ndisia kuiza tela ko batu basonga vayi ndiyiza tela bankua masumu.</char><verse eid="MAT 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>Buna minlonguki mi Yowani miyiza kuidi Yesu mu kunyuvula ti :</para>
  <para style="p" vid="MAT 9:14">—Bila mbi beto ayi bafalisi tueti kifuisa nzala mu diambu di lusambulu vayi minlonguki miaku mikifuisanga nzala ko mu diambu di lusambulu e ?<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 9:15">—Lumbanza ti batu bobo batumusu kuidi ditoko diodo dikuedidi balenda ba mu kiadi ditoko bu kakidi yawu va kimosi e ? Vayi vadi thangu bu bela ku bakatula ditoko va khatitsikꞌawu, buna bosi bela kukifuisa nzala mu diambu di lusambulu.<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>Kuisi ko mutu wela bonga tendi kinledi kimona muingi kalondila nledi wukhulu bila tende kioki kimona maki kakuna nledi wukhulu, ayi divudu ma diba dinneni. <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>Bobuawu balendi tula ko vinu kimona mu zitsaku zikhulu bila buna zitsaku zikanzukidi ayi buna vinu kidukukidi ayi zitsaku zifuidi. Vayi beti lundila vinu kimona mu zitsaku zimona. Mu phila yoyi zitsaku ayi vinu mabilundama bumboti !<verse eid="MAT 9:17"/></para>
  <para style="s1">Yesu wuviatuka bimbevo ayi lufua mu ngolo</para>
  <para style="r">(<ref loc="MRK 5:21-43">Malako 5.21-43</ref> ; <ref loc="LUK 8:40-56">Luka 8.40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>Mu thangu Yesu kaba kamba mambu mama, pfumu yimosi wuyiza fukama va ntualꞌandi ayi wutuba :</para>
  <para style="p" vid="MAT 9:18">—Muanꞌama wunketo fuidi vayi bufueni wiza ntetika koko kuaku ayi ma kazinga diaka !<verse eid="MAT 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19"/>Yesu wutelama ayi wunlandakana va kimosi ayi minlonguki miandi.<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>Mu thangu yina nketo wumosi wuba kimbevo kiviokanga menga ; kimbevo beni kizingila kumi mvu miodi, wufikama ku manima ayi wusimba tsongi nlediꞌandi. <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>Bila wuyindula mu ntimꞌandi ti : “minu simba kuandi nledi andi, mfueti kaka beluka !”<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>Yesu wutala ku manima ayi bu kammona, wutuba :</para>
  <para style="p" vid="MAT 9:22">—Muanꞌama wunketo, ba bukhafi, bila minu kiaku kibelusidi ! Buna nketo beni wubeluka muna yina thangu.<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>Yesu bu katula ku nzo pfumu, wumona minsiki mi minsioni<note caller="+" style="f"><char style="fr" closed="false">9.23 </char><char style="fq" closed="false">minsioni</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">Mu minkanda minkaka muawu bantubila bisiku bantedilanga “flute” Vayi batu bansekinina.</char></note> ayi nkangu wu batu wuba ntela-ntela. <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>Buna wutuba :</para>
  <para style="p" vid="MAT 9:24">—Totukeno, bila muana wunketo kasi fua ko, vayi tulu tuandi kalekidi.<verse eid="MAT 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 9:25"/>Nkangu bu wumana totuka ku nganda, Yesu wukota ayi wusimba muana beni mu koko, bosi muana ndumba beni wutelama. <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>Tsangu beni yitembakana mu zunga kioso.<verse eid="MAT 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>Yesu bu katotuka vana, baphofo buadi zinlandakana vayi sumbu ziba kuenda nlandakana zilembo yamikina :</para>
  <para style="p" vid="MAT 9:27">—A Muana Davidi e, wutumoni kiadi e !<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>Bu kakota ku nzo, baphofo zifikama va kaba. Niandi wuba yuvula :</para>
  <para style="p" vid="MAT 9:28">—Luwilukidi ti ndenda vanga diawu e ?</para>
  <para style="p" vid="MAT 9:28">Bawu bavutula :</para>
  <para style="p" vid="MAT 9:28">—Nyinga Pfumu.<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>Bosi wusimba meso mawu ayi wukamba :</para>
  <para style="p" vid="MAT 9:29">—Bika buvangimina boso buididi minu kieno !<verse eid="MAT 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 9:30"/>Vana vawu meso mawu mazibukidi. Yesu wuba kandika ti :</para>
  <para style="p" vid="MAT 9:30">—kadi mutu kazaba mambu mama.<verse eid="MAT 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31"/>Vayi bawu bu bayenda, bamana tembikisa tsangu andi mu zunga kioso.<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>Mu thangu batotuka, bannatina dibaba, wuba yamusungu kuidi pheve yimbimbi. <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>Yesu wukuka pheve beni. Muna thangu beni kaka mutu weka nyoluka. Batu basimina ayi bakamba :</para>
  <para style="p" vid="MAT 9:33">—Tumueni ko mambu ma phila yayi mu Iseli !<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>Vayi Bafalisi bakamba :</para>
  <para style="p" vid="MAT 9:34">—A keti mu lulendo lu Pfumu yi ziphevi zimbimbi kalembo kukila ziphevi zimbimbi !<verse eid="MAT 9:34"/></para>
  <para style="s1">Yesu wumona batu kiadi</para>
  <para style="r">(<ref loc="MRK 6:34">Malako 6.34</ref> ; <ref loc="LUK 10:2">Luka 10.2</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>Yesu wuba diengilanga mu mavula moso ayi mu mala moso. Wuba longanga mu zinzo zi zikhutukunu zi Bayuda ayi wuba longanga Nsamu wumboti wu Kipfumu, wuba belusanga bimbevo biphila mu phila ayi ziphasi zi phila mu phila. <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>Bu kamona nkangu wu batu, kiadi kimbuila mu diambu diawu, bila batu beni ku tsi mayindu baba ayi baba bavonga banga mamemi makondolo nsungi.<verse eid="MAT 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 9:37"/>Buna wukamba minlonguki miandi :</para>
  <para style="p" vid="MAT 9:37">—Lutala, mimbutu miyela mieka miwombo mu tsola vayi bisadi bidi bifioti. <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>Diawu lulomba kuidi Pfumu yi tsola muingi kafidisa bisadi mu diambu di vela mimbutu.<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">Yesu wutuma kumi bamvuala bandi buadi</para>
  <para style="r">(<ref loc="MRK 3:13-19">Malako 3.13-19</ref> ; <ref loc="LUK 6:12-16">Luka 6.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>Yesu wutela minlonguki miandi kumi mi miodi ayi wuba vana lulendo lukukila ziphevi zimbimbi ayi lu belusila bimbevo bioso ayi ziphasi zioso. <verse eid="MAT 10:1"/><verse number="2" style="v" sid="MAT 10:2"/>Mazina ma kumi bamvuala buadi mawu mama : wutheti Simoni baba ntedilanga Piela bosi khombꞌandi Andele. Zaki muana Zebede ayi khombꞌandi Yowani. <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>Filipi ayi Balitelemi ; Toma ayi Matayi mfutisi wu phaku Zaki muana Alafayi ayi Tade. <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>Simoni wuba mu dingumba di bazeloti<note caller="+" style="f"><char style="fr" closed="false">10.4 </char><char style="fq" closed="false">Zeloti</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">diba dingumba dikubuku mu thangu yibutuka Yesu.</char></note> ayi Yuda Isikalioti mutu wusumbisa Yesu.<verse eid="MAT 10:4"/></para>
  <para style="r">(<ref loc="MRK 6:7-13">Malako 6.7-13</ref> ; <ref loc="LUK 9:1-6">Luka 9.1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>Baba kumi batu buadi bawu Yesu katuma bu kamana ku bavana zithumunu ziazi :</para>
  <para style="p" vid="MAT 10:5">—Lubika kuenda mu zitsi zi bapakanu ayi lubika kota kadi mu divula dimosi di basi Samali. <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>Vayi yendanu kuidi mamemi ma zimbala ma Iseli. <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>Koso buangu lunkuenda lulonga ti Kipfumu ki Diyilu kifikimini. <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>Lubelusa batu bambela, lufulukisa bafua, luvedisa bankua buazi, lukuka ziphevi zimbimbi. Luvana mu phamba bila mu phamba mamveno lubakidi. <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>Lubika nata nolo, palata ayi zimbongo, mu ziphosi zieno. <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>Lubika nata sakosi yi nzietolo, kadi nata kikhutu kiviakisa kadi sapatu, kadi nti, bila “kisadi kafueti baka bidia biandi.”<verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>Thangu lunkota mu divula voti mu buala bumosi, lutomba mutu widi wufuana mu kuluyakula ayi luvuanda kuidi niandi nate luela botuka muna. <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>Thangu lukotidi mu nzo, luvana basi nzo beni mboti. <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>Enati nzo beni yidi yifuana, buna bika ndembama yeno yiba mu bawu. Vayi enati yisi yifuana ko, buna bika ndembama yeno yivutuka kuidi beno. <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>Enati mutu mengi kulutambula ayi mengi wa mambu meno, bu luntotuka mu nzo beni voti mu divula beni buna lukukumuna mbungi-mbungi yi malu meno<note caller="+" style="f"><char style="fr" closed="false">10.14 </char><char style="fq" closed="false">lukukumuna mbungi-mbungi yi malu meno</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">dinsundula ti basiedi mu kithuadi kimosi ko.</char></note>. <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>Bukiedika ndikulukamba ti mu lumbu kitsambusu, mavula ma Sodoma ayi Ngomola mela baka thumbudulu yidekuka viokila yi divula dina.<verse eid="MAT 10:15"/></para>
  <para style="s1">Ziphasi zi kisalu ki Pfumu</para>
  <para style="r">(<ref loc="MRK 13:9-13">Malako 13.9-13</ref> ; <ref loc="LUK 21:12-19">Luka 21.12-19</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>Tala ndilufidisidi banga mamemi va khatitsika memvo. Diawu luba diela banga zinioka ayi luba batu balembama banga mabembi. <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/>Vayi lukikeba va khatitsika batu bila bela kulufunda mu ntilibinadu yi Bayuda ayi bela kulubeta bikoti mu zinzo ziawu zi zikhutukunu.<verse eid="MAT 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 10:18"/>Bela ku lunata ku ntuala minyadi mi leta<note caller="+" style="f"><char style="fr" closed="false">10.18 </char><char style="fq" closed="false">minyadi mi leta</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">voti baguvelinele.</char></note> ayi mintinu mu diambu diama. Bobo luela bakila diluaku mu kuthelimina kimbangi kuidi bawu ayi kuidi Bapakanu. <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>Mu thangu bela kulukanga, luba bika ba mayindu mu mambu luela tuba voti mu phila luela yolukila mawu bila mambu luela tuba luela ma tambula kaka mu thangu yina. <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>Bila kadi sia ti beno luela yoluka vayi Pheve yi Dise dieno yela yoluka mu beno.<verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>Khomba wela yekula khombꞌandi mu kumvondisa. Dise diela yekula muanꞌandi. Bana bela fuemina bambuta ziawu ayi bela kuba vondisa. <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>Batu boso bela kululenda mu diambu diama. Vayi mutu wowo wela kanga ntima nate kuna tsuka, wela vuka.<verse eid="MAT 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 10:23"/>Enati baluyamisini mu divula dimosi, lutinina ku diodi kinkaka. Bila bukiedika ndikulukamba ti muana mutu wela vutuka tuamina beno lumanisa tinina mu mavula moso ma Iseli.<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>Muana nzo nkanda kasi viatuka ko nyinyisiꞌandi ; muisi kisalu kasi viatuka ko pfumuꞌandi. <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>Bufueni muana nzo nkanda kaba banga nyinyisi andi ayi muisi kisalu kaba banga pfumuꞌandi. Enati babieka pfumu yi nzo Belezebuli ; buna buevi bela tubila kuidi bobo bamvuandanga mu nzo andi ?<verse eid="MAT 10:25"/></para>
  <para style="s1">Luba bukhafi mu kisalu</para>
  <para style="r">(<ref loc="LUK 12:2-9">Luka 12.2-9</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>—Diawu lubika kuba mona tsisi. Bila kuisi ko diambu disuama diela kambu monika ayi kuisi ko diambu di kitsueki diela kambu zabakana. <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>Mambu moso ndikulukamba mu tombi, luyolukila mawu va muini. Mambu moso baku luniungutila va dikutu lutubila mawu ku yilu muanzu wu nzo.<verse eid="MAT 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 10:28"/>—Lubika mona tsisi batu bobo balenda vonda nitu, ayi balendi vonda muela ko. Vayi bika lutina mutu wowo wulenda bunga nitu ayi muela ku bulungi. <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>A buevi, basumbisanga ko zitsiodila zizole mu thalu yimosi yi fioti e ? Vayi kuisi ko yimosi yela bua va ntoto mu kambu luzolo lu dise dieno. <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>Vayi mu diambu dieno, luzebi ti zitsuki zieno zioso zidi zitangu. <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>Diawu lubika mona boma ! Bila lulutidi nkangu wu zitsiodila mu luvalu.<verse eid="MAT 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>Diawu woso wela kukhikinina va meso ma batu mamvana ndiela kunkikinina va meso ma dise diama didi ku Diyilu. <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>Vayi woso wukuthunuka va meso ma batu, mamvama ndiela kuntunuka va meso ma dise diama didi ku Diyilu.<verse eid="MAT 10:33"/></para>
  <para style="r">(<ref loc="LUK 12:51-53">Luka 12.51-53</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>—Lubika banza ti ndembama ndinata va ntoto. Ndisia nata ndembama ko vayi sabala nzidilunatini. <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/><char style="qt">Ndiyiza mu vambisa muana bakala ayi dise diandi, muana nketo ayi ngudi andi, bosi nketo wu dikuela ayi nzituꞌandi wunketo.</char> <verse eid="MAT 10:35"/><verse number="36" style="v" sid="MAT 10:36"/><char style="qt">Basi nzo andi bawu bela ba bambeni bandi.</char><verse eid="MAT 10:36"/></para>
  <para style="r">(<ref loc="LUK 14:26-27">Luka 14.26-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>—Woso mutu wunluta zola dise diandi voti ngudi andi viokila minu kasi fuana kuidi minu ko. Ayi woso mutu wunluta zola muanꞌandi wu bakala voti muanꞌandi wunketo viokila minu kasi fuana kuidi minu ko. <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>Woso wunkambu nata dikulusi diandi ayi wunkambu kundandakana buna kasi fuana kuidi minu ko. <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>Woso wela tomba vukisa luzingu luandi wela luzimbisa vayi woso wela zimbisa luzingu luandi mu diambu diama, wela lutambula.<verse eid="MAT 10:39"/></para>
  <para style="r">(<ref loc="MRK 9:41">Malako 9.41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>—Woso wela kulutambula, buna minu katambudi ; ayi bu kathambudi, buna tambudi mutu wowo wuthuma. <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>Woso wela tambula mbikudi bila kadi mbikudi, buna wela baka mfutu wumosi banga wu mbikudi. Woso wela tambula mutu wusonga, bila kadi wusonga wela tambula mfutu wumosi banga mutu wusonga. <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>Woso wela vana, ka diambu ko, kopo yimosi kuandi, yinlangu wu kiozi kuidi wumosi mu bana bafioti bobo bila kadi nlonguki ama bukiedika ndikulukamba ti wela baka mfutu andi.<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>Yesu bu kamanisa vana zithumunu ziozi kuidi kumi minlonguki miandi miodi, wuyenda longi ayi samuna mu mavula mawu.<verse eid="MAT 11:1"/></para>
  <para style="s1">Yesu ayi Yowani Mbotiki</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luka 7.18-35</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>Yowani Mbotiki mu thangu kaba mu nloko, wuwa tsangu yi mavanga momo Klisto kaba vanganga, buna wufidisa minlonguki miandi muingi banyuvula :<verse eid="MAT 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 11:3"/>—Bukiedika kuandi ti ngeyo mutu wowo wufueti kuiza voti tuvingila wunkaka e ?<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 11:4">—Luvutuka kuidi Yowani ayi lunkamba mambu momo lulembo wa ayi lulembo moni : <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/><char style="qt">batu bafua meso balembo moni ; makoka malembo diati ; batu babuazi balembo vedusu ; batu bafua matu balembo wi ayi bafua balembo fuluka ayi Nsamu Wumboti wulembo longu kuidi batu basukama.</char> <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>Khini kuidi mutu wela kambu zimbisa minu kiandi mu diambu diama.<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>Mu thangu minlonguki mivutuka, Yesu wubaka diluaku di yolukila mambu ma Yowani Mbotiki kuidi nkangu wu batu :</para>
  <para style="p" vid="MAT 11:7">—Mbi biobi luyenda tala ku dikanga e ? Nti wufioti wulembo vevomono kuidi phemo e ? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>Vayi buna nani luyenda tala e ? Mutu wuvuata minledi mi kitoko e ? Nana. Bila batu bobo bamvuatanga minledi mi kitoko mu zinzo zi mintinu bankalanga. <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>Vayi buna mbi luyenda tala ? Mbikudi luyenda tala e ? Nyinga, buawu kuandi vayi ndikulukamba ti niandi viokidi mbikudi. <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>Bila niandi mutu wowo minkanda milembo tubila ti :</para>
  <para style="q1" vid="MAT 11:10">
    <char style="qt">tala, mfidisidi mvualꞌama ku ntualꞌaku, </char></para>
  <para style="q1" vid="MAT 11:10">
    <char style="qt">niandi wela kukubikila nzila !</char><verse eid="MAT 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11"/>Bukiedika ndikulukamba : mu batu boso bobo babutu kuidi baketo, kuisi ko mutu wowo viokidi Yowani Mbotiki. Vayi mutu wowo wulutidi kefa mu kipfumu ki Diyilu, wunlutidi. <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>Tona mu bilumbu bi Yowani Mbotiki nate buabu Kipfumu ki Diyilu kilembo bakulu mu kingolo ayi batu ba ngolo bawu kaka banzionanga kiawu. <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>Bila Mina ayi mimbikudi mioso mibikula nate mu thangu Yowani. <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>Enati lutidi ku diwilukila buna luzaba ti niandi Eli mutu wowo wufueti kuiza. <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>Woso widi matu ma wilu buna bika kawa.<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>—Banga mbi ndenda dedikisa tsungi yayi e ? Yidedikini banga bana bafioti bavuendi va zandu ayi balembo tedi bakundi bawu :<verse eid="MAT 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17"/>Beto tulusikidi nsioni<note caller="+" style="f"><char style="fr" closed="false">11.17 </char><char style="fq" closed="false">nsioni</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">Minsekudi minkaka misadila siku bantedilanga mu kifalansi “flute” tala Luka 7.32.</char></note> lusia kina ko ;</para>
  <para style="q1" vid="MAT 11:17">tuyimbila minkunga mi mafua vayi lusia nionga ko.<verse eid="MAT 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 11:18"/>Bila Yowani wuyiza, kasa nua ko ayi kasa dia ko vayi bakamba : “pheve yimbimbi yidi yandi !” <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>Vayi Muana Mutu, wuyiza, wundia ayi wunua ayi bakamba : “Niandi nzuna kadi ayi kolo mbungu, nkundi mimfutisi mi ziphaku ayi wu bankua masumu.” Vayi nduenga yimonikanga bumboti mu mavanga mandi.<verse eid="MAT 11:19"/></para>
  <para style="s1">Tsembolo kuidi mavula mamanga tumamana</para>
  <para style="r">(<ref loc="LUK 10:12-15">Luka 10.12-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>Bosi wutubidila ngolo mavula momo mu kavangila bikumu biandi biwombo, bila batu bobo basia balula mavanga mawu ko.<verse eid="MAT 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 11:21"/>—Mabienga kuidi ngeyo Kolazini ayi ngeyo Betezayida bila enati ndivanga mu mavula ma Tile ayi Sidoni bikumu biobi ndivanga va beno, nganu thama batu ba mavula beni bavuata zitsaku ayi bakivinda dibombi mu monisa ti babaludi mintima. <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>Bukiedika ndikulukamba mu lumbu kitsambusu, Tile ayi Sidoni bela baka thumbudulu yifioti vayi yeno yela luta ngolo !<verse eid="MAT 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 11:23"/>Bosi ngeyo Kafalinawumi, wumuena ti ngeyo wela tombulu ku yilu e ? Nana ! Wela kululu nate ku tsi bafua ! Bila enati ndivanga mu Sodomo bikumu banga biobi ndivanga kuidi ngeyo, nganu divula beni dilembo zingi nate buabu. <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>Bukiedika ndikulukamba mu lumbu kitsambusu, thumbudulu yi Sodomo yela ba yideduka, yaku yela viatuka ngolo !<verse eid="MAT 11:24"/></para>
  <para style="s1">Yesu wutela bankua bizitu</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luka 10.21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>Mu thangu yina, Yesu wukamba :</para>
  <para style="p" vid="MAT 11:25">—A Tata, Pfumu yi Diyilu ayi yi ntoto, ndikukembisa bu wusueka mambu mama kuidi batu badi nzayilu ayi kuidi batu badi diela vayi wumonisa mawu kuidi bana bafioti. <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>Nyinga Tata, buawu bobo bubela luzolo luaku.<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>Dise diama niandi wuphana bima bioso. Kuisi ko mutu zebi Muana vayi Tata kaka wunzebi. Kuisi ko mutu zebi Tata vayi Muana wunzebi ayi mutu wowo Muana kazodidi kummonikisa niandi.<verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>Yizanu kuidi minu beno boso bobo luvongidi ayi luneti mimfuna, minu mandi luvundisa. <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>Bika lubonga vangu kiama, lulonguka kuidi minu bila minu ndidi mutu wu ntima wulembami ayi wukuluka ayi ma lubaka luvundulu mu miela mieno. <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>Bukiedika vangu kiama kisi phasi mu nata ko ayi mfunꞌama wisi zitu ko.<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">Yesu niandi Pfumu lumbu ki saba</para>
  <para style="r">(<ref loc="MRK 2:23-28">Malako 2.23-28</ref> ; <ref loc="LUK 6:1-5">Luka 6.1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>Mu bilumbu bina, Yesu wuviokila mu tsola ble mu lumbu ki saba<note caller="+" style="f"><char style="fr" closed="false">12.1 </char><char style="fq" closed="false">Lumbu ki saba</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">kiawu lumbu ki lumingu lu Bayuda. </char></note>. Minlonguki miandi nzala miba mona diawu mikodila ble<note caller="+" style="f"><char style="fr" closed="false">12.1 </char><char style="fq" closed="false">ble</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">Tala Matayi 3.12 ; Luka 3.17.</char></note> muingi midia.<verse eid="MAT 12:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 12:2"/>Thangu Bafalisi bamona bobo, buna bakamba Yesu :</para>
  <para style="p" vid="MAT 12:2">—Tala minlonguki miaku milembo vangi mambu makandama mu lumbu ki saba !<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>Vayi Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 12:3">—Lutengi ko mambu Davidi kavanga mu thangu niandi ayi bakundi bandi baba nzala ? <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>Wukota mu Nzo Nzambi ; niandi ayi bakundi bandi badia mapha momo matambuku kuidi Nzambi, ka diambu ko niandi ayi bakundi bandi basia ba ko minsua mu dia mapha beni vayi botula kaka banganga Nzambi. <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>Voti lutengi ko mu Mina ti mu lumbu ki saba zinganga Nzambi zieti sumuna lumbu ki saba bu zieti sala mu nzo Nzambi. Buna basi vanga nzimbala ko e ?<verse eid="MAT 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 12:6"/>Muaki bukiedika ndikulukamba mutu wumosi widi vava viokidi Nzo Nzambi. <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>Vayi enati luzebi tsundu yi mambu mama : <char style="qt">thidi luba batu badi mintima mi kiadi vayi mbengi luthambikanga kaka makaba. Nganu lusia bedisa ko batu bobo basia vanga bila ko.</char> <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>Bila Muana Mutu, niandi pfumu yi lumbu ki saba.<verse eid="MAT 12:8"/></para>
  <para style="r">(<ref loc="MRK 3:1-6">Malako 3.1-6</ref> ; <ref loc="LUK 6:6-11">Luka 6.6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>Bu kabotuka kuna, wuyenda ku nzo awu yi lukutukunu. <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>Kuna kuba mutu wumosi wuba koko kusioka. Buna banyuvula :</para>
  <para style="p" vid="MAT 12:10">—Minsua midi mu belusa mutu mu lumbu ki saba e ? Banyuvula bobo mu diambu babaka diluaku di kumfundila.<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 12:11">—Zimbukila mutu wumosi mu beno widi dimemi dimosi kaka vayi ditibukidi mu dibulu dinda mu lumbu ki saba. Buna kalendi tibuka ko ayi ku ditotula ko e ? <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>Keti mutu lutidi dimemi mu mfunu ! Bukiedika ndikulu kamba minsua midi mu vanga mamboti mu lumbu ki saba.<verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>Bosi wukamba kuidi mutu beni :</para>
  <para style="p" vid="MAT 12:13">—Nonuna koko kuaku ! Mutu beni wunonuna kuawu, ayi, koko kuandi kuba kusioka kufuana banga koko kunkaka.<verse eid="MAT 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 12:14"/>Ku nzimunina Bafalisi batotuka, bakutakana muingi batomba diluaku di balenda vondisila Yesu.<verse eid="MAT 12:14"/></para>
  <para style="s1">Yesu niandi kisadi ki Yave</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>Vayi Yesu bu kazaba diawu buna wukatuka vana. Nkangu wunneni wunlandakana ayi, wubelusa batu boso. <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>Vayi wuba kandika babika tuba ti niandi nani. <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>Buawu bobo budedikinina mambu mama ma mbikudi Ezayi :<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>
    <char style="qt">Nzambi wutuba ti tala kisadi kiama kioki ndisobula</char></para>
  <para style="q1" vid="MAT 12:18">
    <char style="qt">ndikunzolanga buwombo,</char></para>
  <para style="q1" vid="MAT 12:18">
    <char style="qt">niandi wukumbonisanga khini.</char></para>
  <para style="q1" vid="MAT 12:18">
    <char style="qt">Ndiela tula pheve ama va niandi</char></para>
  <para style="q1" vid="MAT 12:18">
    <char style="qt">ayi wela yamikisa busonga kuidi makanda moso.</char><verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>
    <char style="qt">Kalendi zonza ko ayi kalendi yamikina ko.</char></para>
  <para style="q1" vid="MAT 12:19">
    <char style="qt">Mbembo andi yilendi wakakana ko mu zinzila</char><verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>
    <char style="qt">Kalendi kelula ko nti wu fioti wutufuka</char></para>
  <para style="q1" vid="MAT 12:20">
    <char style="qt">ayi kalendi zima ko nsifu wu muinda wukidi totula muisi</char></para>
  <para style="q1" vid="MAT 12:20">
    <char style="qt">nate kela nungisa busonga</char><verse eid="MAT 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21"/>
    <char style="qt">Makanda moso mela tula diana diawu mu dizina niandi.</char><verse eid="MAT 12:21"/></para>
  <para style="s1">Nzambi voti satana</para>
  <para style="r">(<ref loc="MRK 3:20-30">Malako 3.20-30</ref> ; <ref loc="LUK 11:14-23">Luka 11.14-23</ref> ; <ref loc="LUK 12:10">12.10</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>Bannatina mutu wumosi wuba ziphevi zimbimbi, wuba phofo ayi kaba yolukanga ko. Yesu wumbelusa. Buna mutu beni wutona yoluka ayi mona.<verse eid="MAT 12:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 12:23"/>Nkangu woso wusimina ayi wutuba :</para>
  <para style="p" vid="MAT 12:23">—Niandi ko Muana Davidi e ?<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>Vayi Bafalisi bu bawa bobo, bakamba :</para>
  <para style="p" vid="MAT 12:24">—A Keti mu lulendo lu Belezebuli, pfumu yi ziphevi zimbimbi kalembo totudila ziphevi zimbimbi.<verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>Yesu wuzaba mayindu mawu, wuba kamba :</para>
  <para style="p" vid="MAT 12:25">—Kipfumu kioso kivasukidi kiawu veka kifueti muangana ayi dioso divula voti yoso nzo yidi yikabana mu yawu veka yilendi zingila ko. <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>Enati satana kukidi satana, keti buna weka wuvasuka mu niandi veka. Buna buevi kipfumu kiandi kilenda zingila e ?<verse eid="MAT 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 12:27"/>Enati ndilembo kukila ziphevi zimbimbi mu lulendo lu Belezebuli buna mu lulendo lu nani batu beno bansadilanga mu kuzi kuka e ? Diawu, bawu veka bela ba mazuzi meno. <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>Vayi enati mu lulendo lu Pheve yi Nzambi ndilembo kukilanga ziphevi zimbimbi, buna Kipfumu ki Nzambi kitudidi nate kuidi beno.<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>Voti buevi mutu kalenda kotila mu nzo yi mutu widi ngolo muingi kayiba bima biandi enati kasi tuama kanga ko mutu beni widi ngolo e ? Buna bosi kalenda baka buyibila mu nzo andi.<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>Woso mutu kambulu yama kithuadi buna mbeni ama. Woso mutu wunkambu kupika yama va kimosi buna niandi wulembo sasikisa. <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>Diawu ndikulukambila : masumu moso ayi mvuezolo woso wulenda lemvokolo vayi botula kaka mvuezolo yintambula Pheve Yinlongo. <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>Woso wela yoluka mambu mambimbi mu diambu di Muana Mutu wela lemvokolo, vayi woso wela yoluka mambu mambimbi mu diambu di Pheve Yinlongo kalendi lemvokolo ko mu thangu yayi voti mu thangu yinkuiza.<verse eid="MAT 12:32"/></para>
  <para style="r">(<ref loc="LUK 6:43-45">Luka 6.43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>Tala enati nti widi wumboti buna wela buta mimbutu mimboti voti enati nti widi wumbimbi buna wela buta mimbutu mimbimbi bila banzabilanga nti mu mimbutu miandi. <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>Beno luidi mu dikabu di bikusa ! Buna buevi bu lenda bela ti beno batu bambimbi lulenda tuba mambu mamboti ? Bila mu mambu momo mafulukidi mu ntima muawu mueti ba mambu meti tuba mutu. <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>Mutu wumboti weta tuba mambu mamboti momo madi mu kiuka kiandi kimboti. Vayi mutu wumbimbi weti tuba mambu mambimbi momo madi mu kiuka kiandi kimbimbi. <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>Ndikulukamba ti mu lumbu kitsambusu, batu bela sambusu mu diambu di mambu moso maphamba momo batuba. <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>Bila mu mambu maku wela kitudulu wusonga ayi wela bedosolo.<verse eid="MAT 12:37"/></para>
  <para style="r">(<ref loc="MRK 8:11-12">Malako 8.11-12</ref> ; <ref loc="LUK 11:29-32">Luka 11.29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>Buna ndambu minsoniki mi Mina minkaka ayi Bafalisi bayiza tambula minsua mu yoluka. Bawu bankamba :</para>
  <para style="p" vid="MAT 12:38">—Nlongi, tutidi wuvanga kumu kimosi !<verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 12:39">—Nkuna wu batu bambimbi ayi bakambulu bakuikama bawu bantomba kumu ! Balendi kumvana kinkaka ko. Vayi botula kaka kioki kivangama mu mbikudi Zonasi ! <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>Bila bobuawu Zonasi kakadila mu vumu ki mbizi yinneni bilumbu bitatu ayi mabuilu matatu, buawu bobo Muana Mutu, kela kadila ku tsi ntoto bilumbu bitatu ayi mabuilu matatu.<verse eid="MAT 12:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 12:41"/>Mu lumbu kitsambusu, basi Ninive bela telama va kimosi ayi batu ba thangu yayi ayi bela kuba zengila nkanu bila bawu babalula mintima thangu Zonasi kaba longa. Vayi tala vava vadi ayi mutu wumosi wulutidi Zonasi. <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>Mu lumbu kitsambusu ntinu wunketo wu sude wela telama va kimosi ayi batu ba thangu yayi ayi wela kuba zengila nkanu bila niandi wuba ku buala buidi thama muingi kiza wa mambu ma diela ma Solomo. Vayi tala vava vadi ayi mutu wumosi wulutidi Solomo.<verse eid="MAT 12:42"/></para>
  <para style="r">(<ref loc="LUK 11:24-26">Luka 11.24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>—Mu thangu pheve yimbimbi yitotukidi mu mutu, buna yindiengilanga mu bibuangu bi yuma mu tomba buangu kivundila. Vayi enati kakadi baka buangu, <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>buna yintubanga : “Bika ndivutuka mu nzoꞌama yoyi ndibika.” Mu thangu yela vutuka ayi yela bata nzo beni yikambulu mutu, yikombolo ayi yimana kubuku. <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>Buna pheve beni yoyi yimbimbi yela tomba tsambuadi di ziphevi zinkaka ziozi zimviokidi nganzi ; bu ziela kota ayi ziela vuanda muna. Diawu, khadulu yi mutu wowo yela ba yimbimbi viokila yoyi yitheti. Bobo buela bela mu diambu di tsungi yayi yimbimbi.<verse eid="MAT 12:45"/></para>
  <para style="s1">Dikanda dikiedika di Yesu</para>
  <para style="r">(<ref loc="MRK 3:13-35">Malako 3.13-35</ref> ; <ref loc="LUK 8:19-21">Luka 8.19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>Mu thangu Yesu kaba tuba kuidi nkangu wu batu, tala, ngudi andi ayi bakhomba bandi batelama ku nganda, bazola solula yandi.<verse eid="MAT 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 12:47"/>Mutu wumosi wuyiza kunkamba :</para>
  <para style="p" vid="MAT 12:47">—Tala ngudi aku ayi bakhomba ziaku batelimini ku nganda, batidi solula yaku !<verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>Yesu wumvutudila :</para>
  <para style="p" vid="MAT 12:48">—Nani ngudi ama ? Banani bakhomba ziama ? <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>Mbadi wusonga minlonguki miandi nlembo ayi wukamba :</para>
  <para style="p" vid="MAT 12:49">Tala, ngudi ama ayi bakhomba ziama bawu baba. <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>Bila woso mutu wumvanganga luzolo lu Dise diama didi ku Diyilu, niandi khombꞌama yi bakala, khombꞌama yi nketo ayi ngudi ama.<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">Nongo yi nkuni</para>
  <para style="r">(<ref loc="MRK 4:1-9">Malako 4.1-9</ref> ; <ref loc="LUK 8:4-8">Luka 8.4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>Mu lumbu beni, Yesu wutotuka mu nzo ayi wuyenda vuanda mu muenda mbu. <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>Nkangu wuwombo wu batu bayiza va kaba. Diawu kakumina mu nlungu ayi wuvuanda muawu. Nkangu woso wu batu wuba va disimu.<verse eid="MAT 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 13:3"/>Wuba longa mambu mawombo mu zinongo. Buna wuba kamba :</para>
  <para style="p" vid="MAT 13:3">—Nkuni wumosi wuyenda ku muanga mbongo. <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>Bu kaba muanga mbongo<note caller="+" style="f"><char style="fr" closed="false">13.4 </char><char style="fq" closed="false">muanga mbongo</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">Bayuda baba kifu ki muanganga voti lozanga zitheti mu thangu kuna.</char></note>; ndambu yibua mu ndambu nzila, zinuni ziyiza mana kuyidoda. <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>Ndambu yinkaka yibua va matadi ; vuma beni vasia ba ntoto wuwombo ko ; zitheti zivika mena bila ntoto wusia ba phiba ko. <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>Vayi muini wungolo bu wutotuka, mintuidila beni miyokana ayi miyuma bila mianzi miawu misia kota ko mboti mu tsi ntoto. <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>Zitheti zinkaka zibua va zitsendi. Zitsendi beni zimena ayi zifietikisa mintuidila beni. <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>Vayi zinkaka zibua mu ntoto wumboti ayi zibuta mimbutu miwombo : lumosi khama yimosi ; lunkaka makumasambunu ayi lukaka makumatatu. <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>Woso widi matu ma wila buna bika kawa.<verse eid="MAT 13:9"/></para>
  <para style="r">(<ref loc="MRK 4:10-12">Malako 4.10-12</ref> ; <ref loc="LUK 8:9-10">Luka 8.9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>Minlonguki mifikama ayi minyuvula :</para>
  <para style="p" vid="MAT 13:10">—Bila mbi wulembo sadila zinongo mu kuba yolukila e ?<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>Buna niandi wuba vutudila :</para>
  <para style="p" vid="MAT 13:11">—Beno lutambula diluaku di zabila mansueki ma Kipfumu ki Diyilu, vayi bawu basia kuma tambula ko. <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>Bila mutu wowo widi bima, bela kumvana ayi wela baka biwombo biviatukidi tezo. Vayi mutu wowo kambulu bima, wela ziono fiofi fidi yandi.<verse eid="MAT 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 13:13"/>Diawu ndikubakambilanga mu zinongo bila balembo tadi vayi bakadi mona, ka diambu ko batembi makutu vayi bakadi wa ayi bakadi sudika. <verse eid="MAT 13:13"/><verse number="14" style="v" sid="MAT 13:14"/>Mavangimini bobo mu diambu di dedikisa mambu mbikudi Ezayi kabikula mu diambu diawu :</para>
  <para style="q1" vid="MAT 13:14">
    <char style="qt">Wa, luela wa kueno vayi lulendi sudika ko.</char></para>
  <para style="q1" vid="MAT 13:14">
    <char style="qt">Tala, luela tala kueno vayi lulendi mona ko.</char><verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>
    <char style="qt">Bila mintima mi batu baba miyikidi ngolo banga matadi.</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="qt">Bamengi kuawu wa.</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="qt">Bazibikidi meso mawu ;</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="qt">bila nganu meso mawu malenda mona,</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="qt">makutu mawu malenda wa,</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="qt">mintima miawu milenda sudika,</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="qt">bila nganu balenda balula mavanga</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="qt">ayi nganu ndenda kuba belusa !</char><verse eid="MAT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16"/>Vayi khini kuidi beno bila meso meno malembo moni ayi makutu meno malembo wi. <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>Bukiedika ndikulukamba ti mimbikudi miwombo ayi batu bawombo basonga baba tsatu mu mona mambu momo lulembo moni vayi basia mamona ko ; ayi baba tsatu mu wa mambu ma lulembo wi vayi basia mawa ko.<verse eid="MAT 13:17"/></para>
  <para style="r">(<ref loc="MRK 4:13-20">Malako 4.13-20</ref> ; <ref loc="LUK 8:11-15">Luka 8.11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>—Luwa tsundu yi nongo yoyi ndilukembi, nongo yi nkuni : <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>Yoso-yoso thangu mutu kawilu mambu ma kipfumu ayi kakadi kuma sukida, buna pheve yimbimbi yikuiza vuzanga mambu momo makunu mu ntimꞌandi. Yawu yoyi mbongo yibua va ndambu nzila.<verse eid="MAT 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 13:20"/>Mbongo yoyi yibua va matadi yawu mutu wuwa mambu ma Nzambi ayi wutumbu vika ku matambula mu khini.<verse eid="MAT 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 13:21"/>Sumbu yisia ba mianzi ko buna yisia zingila ko. Ziphasi voti yamusu bu bizidi mu diambu di mambu ma kipfumu, buna wuvika buanga nsualu. <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>Mbongo yoyi yibua va zitsendi yawu mutu wuwa mambu ma Nzambi vayi mayindu mu diambu di luzingu lualu ayi mu diambu di kimvuama ki luvunu mamfietikisanga mambu ma Nzambi ayi malendi vana diluaku ko muingi mbongo beni yibuta. <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>Vayi mbongo yoyi yibua va ntoto wumboti yawu mutu wuwa mambu ma Nzambi ayi wusudika mawu ; wumbutanga mimbutu khama yimosi, makumasambanu, makumatatu.<verse eid="MAT 13:23"/></para>
  <para style="s1">Nongo yi kiti ki mbimbi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>Yesu wuba kamba nongo yinkaka :</para>
  <para style="p" vid="MAT 13:24">—Kipfumu ki Diyilu kidedakani banga mutu wowo wukuna mabongo yimboti mu tsolꞌandi. <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>Vayi batu bu baba baleka mbeniꞌandi wuyiza kuna kiti ki mbimbi va khatitsika ble<note caller="+" style="f"><char style="fr" closed="false">13.25 </char><char style="fq" closed="false">ble</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">Tala Matayi 3.12 ; Luka 3.17</char></note> bosi wuyenda kuandi. <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>Ble bu kimena ayi kitotula zitsangu buna kiti ki mbimbi diaka kimena.<verse eid="MAT 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27"/>Buna bisadi bi pfumu yi tsola biyiza ku nyuvula :</para>
  <para style="p" vid="MAT 13:27">—Pfumu, keti mbongo yimboti wukunini mu tsolꞌaku e ? Buna kuevi kubedi kiti kiaki kimbimbi e ?<verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>Niandi wuba vutudila :</para>
  <para style="p" vid="MAT 13:28">—Mbeni niandi wuvengi buawu. Buna bisadi binyuvula :</para>
  <para style="p" vid="MAT 13:28">—Tidi tuenda vuzi kiti kioki kimbimbi e ?<verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>Pfumu wuvutula :</para>
  <para style="p" vid="MAT 13:29">—Nana ! Bila beno vuza kiti kioki buna lulenda vuza ayi ble. <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>Bikanu biabi biodi biyedila va kimosi nate mu thangu yela velo mimbutu. Buna mu thangu yina, ndiela kamba batu ba kisalu : “vuzanu theti kiti kioki kimbimbi bosi lukanga kiawu mu minko mu diambu luyoka kiawu. Bosi luela vela ble ayi luela ku yitula ku yilu banga kiama<note caller="+" style="f"><char style="fr" closed="false">13.30 </char><char style="fq" closed="false">ku yilu banga</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">kuawu beti lundinlanga bima : buba masangu zinguba voti bima binkaka.</char></note>.”<verse eid="MAT 13:30"/></para>
  <para style="s1">Nongo yi luteti lu mutalide ayi yi luvi</para>
  <para style="r">(<ref loc="MRK 4:30-32">Malako 4.30-32</ref> ; <ref loc="LUK 13:18-19">Luka 13.18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>Yesu wuba kamba nongo yinkaka :</para>
  <para style="p" vid="MAT 13:31">—Kipfumu ki Diyilu kidedakani banga luteti lu mutalide. Mutu wumosi wubonga luawu ayi wukuna luawu mu tsolꞌandi. <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>Luteti beni luviokidi zitheti zioso mu keva vayi enati lumenini buna lumviokanga bikunusu bioso mu kula ayi lunkitukanga nti. Muawu zinuni zieti kuiza ayi vanga zindiala ziawu mu matafi mandi.<verse eid="MAT 13:32"/></para>
  <para style="r">(<ref loc="LUK 13:20-21">Luka 13.20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>Wuba kamba nongo yinkaka :</para>
  <para style="p" vid="MAT 13:33">—Kipfumu ki Diyilu kidedakani banga luvi lolo nketo kabongidi ayi sobikisidi luawu mu bitezo bitatu bi falina<note caller="+" style="f"><char style="fr" closed="false">13.33 </char><char style="fq" closed="false">Bitezo bitatu bi falina</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">bifuanikini nduka-nduka mu makumuadi ma bikilu bi falina.</char></note> nate yimvimbisa falina yoso.<verse eid="MAT 13:33"/></para>
  <para style="r">(<ref loc="MRK 4:33-34">Malako 4.33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>Yesu mu zinongo katubila mambu moso momo kuidi nkangu wu batu ayi kadi khumbu yimosi kela tuba mambu mu kambu sadila nongo. <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>Buawu bobo bu dedikinina mambu matuba mbikudi :</para>
  <para style="q1" vid="MAT 13:35">
    <char style="qt">Ndiela kuba yolukila mu zinongo,</char></para>
  <para style="q1" vid="MAT 13:35">
    <char style="qt">Ndiela kuba zabakisa mansueki momo masuama</char></para>
  <para style="q1" vid="MAT 13:35">
    <char style="qt">tona nza yivangulu.</char><verse eid="MAT 13:35"/></para>
  <para style="s1">Tsundu yi nongo yi kiti ki mbimbi</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>Yesu bu kasindika nkangu, bosi wukota mu nzo. Minlonguki miandi mifikama va kaba ayi minyuvula :</para>
  <para style="p" vid="MAT 13:36">—Wutusudikisa nongo yi kiti ki mbimbi kiba mu tsola.<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>Yesu wuvutula :</para>
  <para style="p" vid="MAT 13:37">—Muana Mutu niandi mutu kunini mbongo yi mboti. <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>Tsola yidi nza, mbongo yi mboti yidi bana ba Kipfumu ; kiti ki mbimbi kidi bana ba satana. <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>Satana, niandi mbeni yoyi yikuna kiti ki mbimbi. Thangu yi vela mimbutu yawu tsukulu yi nza, zimbasi ziawu bisadi bi tsola. <verse eid="MAT 13:39"/><verse number="40" style="v" sid="MAT 13:40"/>Boso bumvuzulungu kiti ki mbimbi ayi kimvikulungu ku mbazu ; buawu bobo buela bela mu tsukulu yi nza. <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>Muana Mutu wela fidisa zimbasi ziandi ayi ziela botula, mu kipfumu kiandi, bima bioso biobi bintotulanga masumu ayi bobo beti vanganga mambimbi. <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>Zimbasi ziela loza batu beni ku mfulu yi mbazu. Kuna kuidi bidilu ayi nkuetosolo wu meno. <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>Buna batu basonga, bela lezama banga thangu mu Kipfumu ki Dise diawu. Woso widi matu ma wilu buna bika kawa !<verse eid="MAT 13:43"/></para>
  <para style="s1">Nongo yi kima kithalu ayi ki lunga ki kitoko</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>—Kipfumu ki Diyilu kidedakani banga kima kithalu, kisueko mu tsola. Mutu niandi kuenda kibakula, maka sueka diaka kiawu. Bosi mu khini yina, buna wela kuenda sumbisa bima biandi bioso ayi sumba tsola beni yina.<verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>Kipfumu ki Diyilu kidedakani diaka banga mukhita wowo wuntombanga bilunga bi kitoko. <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>Enati bakudi lunga kimosi kithalu yiwombo, buna wela kuenda sumbisa bima biandi bioso ayi sumba lunga beni.<verse eid="MAT 13:46"/></para>
  <para style="s1">Nongo yi dikondi di zimbizi</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>Kipfumu ki diyilu kidedakani diaka banga dikondi diodi balozidi mu mbu ayi dibuididi zimbisi ziphila mu phila. <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>Diawu wala, banlobi mbizi ba dituta ku disimu. Bosi bavuanda ayi batula mboti mu bipani ayi miloza ziozi zimbimbi. <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>Buawu bobo buela bela mu tsukulu yi ntoto : Zimbasi ziela kuiza mu vambisa batu bambimbi va khatitsika batu basonga. <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>Buna ziela loza batu bambimbi ku mfulu yi mbazu kuna kuidi bidilu ayi nkuetosolo yi meno.<verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>—Lusudikidi mambu moso mama e ? Bavutula :</para>
  <para style="p" vid="MAT 13:51">—Nyinga.<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>Buna mu manisa Yesu wuba kamba :</para>
  <para style="p" vid="MAT 13:52">—Diawu kadika nsoniki wu Mina wulonguka mambu ma Diyilu, dedikini banga pfumu yi nzo yimbonga bima bimona bithalu ayi bikhulu mu kiuka kiandi.<verse eid="MAT 13:52"/></para>
  <para style="s1">Bavueza Yesu ku Nazaleti</para>
  <para style="r">(<ref loc="MRK 6:1-6">Malako 6.1-6</ref> ; <ref loc="LUK 4:16-30">Luka 4.16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>Thangu Yesu kamanisa tuba zinongo ziozi wukatuka kuna, <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>wuvutuka ku divula diandi. Wutona longa mu nzo yi lukutukunu. Buna basimina ayi batuba :</para>
  <para style="p" vid="MAT 13:54">—Buna kuevi kabakidi nzayilu yoyi ayi lulendo lolo luvangila bikumu biobi e ? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>Keti niandi muana salaphati ? Maliya diawu ko dizina di ngudi andi ? Bosi Zaki, Zozefi, Simoni ayi Yuda basi ko bakhomba bandi zi babakala ? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>Bosi bakhomba bandi zi baketo, keti zinkalanga yeto vava ? Vayi niandi kuevi kabakidi mambu moso momo ?<verse eid="MAT 13:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 13:57"/>Niandi wuba kandika babika kunwilukila<note caller="+" style="f"><char style="fr" closed="false">13.57 </char><char style="fq" closed="false">kunwilukila</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">Minsekudi minkaka misonika “Bawu bantela sakuba” va buangu ki niandi wuba kandika babika kunwilukila. </char></note>.</para>
  <para style="p" vid="MAT 13:57">Vayi Yesu wuba kamba :</para>
  <para style="p" vid="MAT 13:57">—Mbikudi katambulanga minsua mu tsi andi ko ayi mu dikanda diandi ko. <verse eid="MAT 13:57"/><verse number="58" style="v" sid="MAT 13:58"/>Diawu kasi vanga kuna bikumu biwombo ko mu diambu di kambu kuawu ku minu.<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">Lufua lu Yowani Mbotiki</para>
  <para style="r">(<ref loc="MRK 6:14-29">Malako 6.14-29</ref> ; <ref loc="LUK 9:7-9">Luka 9.7-9</ref> ; <ref loc="LUK 3:19-20">3.19-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>Mu thangu yina nyadi<note caller="+" style="f"><char style="fr" closed="false">14.1 </char><char style="fq" closed="false">nyadi</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">voti Guvelinele</char></note> Elode, wuwa tsangu yi Yesu.<verse eid="MAT 14:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 14:2"/>Wukamba bisadi biandi :</para>
  <para style="p" vid="MAT 14:2">—Mutu wowo niandi Yowani Mbotiki, wufulukidi mu bafua, diawu kadidi lulendo lu vangila bikumu.<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>Bila Elode wukangisa Yowani ayi wunkangisa mu zisieni bosi wunkotisa mu nloko mu diambu di Elodiasi nketo wu khombꞌandi Filipi. <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>Bila Yowani wuba tubidilanga Elode ti :</para>
  <para style="p" vid="MAT 14:4">—Wisi ko minsua mu kunkuela.<verse eid="MAT 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 14:5"/>Elode wuba tombanga kumvondisa, vayi nkangu wu batu kaba ntinanga bila batu baba monanga ti Yowani widi mbikudi. <verse eid="MAT 14:5"/><verse number="6" style="v" sid="MAT 14:6"/>Vayi mu lumbu ki nyengo wu mbutukulu wu Elode, muana wu nketo wu Elodiasi wukina va meso ma batu bobo batumusu ayi wumonisa Elode khini. <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>Diawu kamvanina tsila mu leva ndefi ti mankamvana kima kioso kioki kanlomba.<verse eid="MAT 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8"/>Mu diambu di zindongi zi ngudi andi, diawu kankambila :</para>
  <para style="p" vid="MAT 14:8">—Phani vava mu dilonga ntu wu Yowani Mbotiki.<verse eid="MAT 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9"/>Ntinu wumona kiadi kiwombo. Vayi mu diambu di ndefi yi kaleva ayi mu diambu di batu bobo bavuanda yandi va meza, buna wuvana lutumu ti bamvana wawu. <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>Buna wutuma mutu ku nloko muingi kenda zengi ntu wu Yowani. <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>Banata ntu andi mu dilonga ayi bavana wawu kuidi muana ndumba. Niandi wuyenda kuwuvana kuidi ngudi andi. <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>Minlonguki mi Yowani miyiza bonga nituꞌandi ayi mizika yawu, bosi miyenda vumbudila Yesu kipholo.<verse eid="MAT 14:12"/></para>
  <para style="s1">Yesu wudikila mili tanu yi babakala</para>
  <para style="r">(<ref loc="MRK 6:30-44">Malako 6.30-44</ref> ; <ref loc="LUK 9:10-17">Luka 9.10-17</ref> ; <ref loc="JHN 6:1-15">Yowani 6.1-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>Yesu bu kawa nsamu beni, wukatuka kuna mu nlungu ayi wuyenda niandi veka ku buangu kikondolo batu. Vayi thangu nkangu wu batu bu wuwa wawu ; batotuka mu mavula mawu ayi banlandakana mu malu. <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>Yesu bu kakuluka mu nlungu, wumona nkangu wu batu bawombo. Wuba mona kiadi kiwombo ayi wubelusa bimbevo biawu.<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>Mu thangu masika, minlonguki miyiza va kaba ayi minkamba :</para>
  <para style="p" vid="MAT 14:15">—Va buangu kikambulu batu tuidi bosi buisi bueka yila, diawu vutula batu baba mu mala muingi benda sumbi bidia !<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>Vayi Yesu wuba kamba :</para>
  <para style="p" vid="MAT 14:16">—Basi mfunu mu kuenda ko, luba vananu beno veka bidia !<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>Buna bawu bamvutudila :</para>
  <para style="p" vid="MAT 14:17">—Tala, mapha matanu ayi zimbizi zizole zi nlangu kaka zidi yeto vava.<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>Yesu wuba kamba :</para>
  <para style="p" vid="MAT 14:18">—Lundatina biawu vava.<verse eid="MAT 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 14:19"/>Bosi wutuma nkangu wu batu wuvuanda va biti, wubonga mapha matanu beni ayi zimbizi zizole, wuvumbula meso ku yilu ayi wuvutula matondo. Wubukuna mapha beni ayi wuvana mawu kuidi minlonguki ayi miawu mikabudila nkangu wu batu. <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>Bawu boso badia ayi bayukuta. Batota bitini bisiadidila ayi biwesa kumi bipani biodi. <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>Baboso badia baba nduka-nduka mili tanu yi babakala. Kadi tanga baketo ayi bana<note caller="+" style="f"><char style="fr" closed="false">14.21 </char><char style="fq" closed="false">Kadi tanga baketo ayi bana</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">Bayuda baba kifu kitanganga kaka babakala, baba tanganga ko baketo ayi bana balezi. Tala Malako 6.44 ; Luka 9.14.</char></note>.<verse eid="MAT 14:21"/></para>
  <para style="s1">Yesu wudiatila va mbata nlangu</para>
  <para style="r">(<ref loc="MRK 6:45-52">Malako 6.45-52</ref> ; <ref loc="JHN 6:16-21">Yowani 6.16-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>Ku nzimunina Yesu wutuma minlonguki miandi mu kuma mu nlungu ayi mintuaminina ku disimu dinkaka. Niandi wusiala mu sindika nkangu wu batu. <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>Thangu kamana sindika nkangu wu batu, wukuma ku mongo muingi kenda sambila va buangu ki niandi veka. Nate buisi buyila buna wukidi kuna niandi veka kaka.<verse eid="MAT 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 14:24"/>Mu thangu yina nlungu wutula va khatitsika mbu, wunikunu kuidi mayo bila muphepi wudengana nlungu. <verse eid="MAT 14:24"/><verse number="25" style="v" sid="MAT 14:25"/>Mu thangu yi nya yi builu, Yesu wuyenda ku baba vayi wudiatila va mbata mbu. <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>Minlonguki bu mimmona wulembo diatila va mbata mbu, mimona boma ayi mituba :</para>
  <para style="p" vid="MAT 14:26">—Tala nkuyu e ! Ayi mitona yamikina mu diambu di boma.<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>Bosi Yesu wuba kamba :</para>
  <para style="p" vid="MAT 14:27">—Bika lukinda, bila minu kuandi ; bikanu mona boma.<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>Buna Piela wunkamba :</para>
  <para style="p" vid="MAT 14:28">—A Pfumu e ! Enati bukiedika ngeyo kuandi, buna wukhamba ndiza kuidi ngeyo va mbata nlangu.<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>Yesu wunkamba :</para>
  <para style="p" vid="MAT 14:29">—Yiza ! Piela wutotuka mu nlungu, ayi wutona diata va mbata nlangu muingi kenda kuidi Yesu. <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>Vayi bu kamona ti muphepi widi wu ngolo buna wumona boma. Bu katona diama, wuyamikina :</para>
  <para style="p" vid="MAT 14:30">—A ! Pfumu ! Wumvukisa e… !<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>Bosi Yesu wunonuna koko, wunsimba ayi wunkamba :</para>
  <para style="p" vid="MAT 14:31">—Mutu wu minu kifioti, bila mbi memitini e ?<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>Bakuma bawu buadi mu nlungu ayi vuka kimanisa. <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>Bobo baba mu nlungu bafukama va ntualꞌandi ayi batuba :</para>
  <para style="p" vid="MAT 14:33">—Bukiedika widi Muana Nzambi !<verse eid="MAT 14:33"/></para>
  <para style="s1">Yesu wubelusa bambevo ku Ngenezaleti</para>
  <para style="r">(<ref loc="MRK 6:53-56">Malako 6.53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>Buna bamana sabuka mbu ; batula mu tsi Ngenezaleti. <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>Batu ba tsi yina, batembikisa tsangu mu zunga kina. Bosi batu bannatina bambevo ziawu zioso. <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>Banleba ti kabika basimba kaka tsongi yi yunga kiandi. Babo bobo bansimba babeluka.<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">Yesu ayi kikhulu ki Bayuda</para>
  <para style="r">(<ref loc="MRK 7:1-23">Malako 7.1-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>Bafalisi ayi minlongi mi mina baba ku Yelusalemi bayiza kuidi Yesu, banyuvula :<verse eid="MAT 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 15:2"/>—Bila mbi minlonguki miaku mikinzikilanga ko mambu ma bakulu e ? Bila misukulanga ko mioko miawu tuamina midia.<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>Wuba wutudila :</para>
  <para style="p" vid="MAT 15:3">—A bosi beno, bila mbi kalu kinzikilanga ko Mina mi Nzambi mu diambu di kinzika mambu ma bakulu beno ? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>Bila Nzambi wukamba : <char style="qt">Kinzika dise diaku ayi ngudi aku ayi woso wunsinga dise diandi voti ngudi andi kafueti baka thumbudulu yi lufua.</char> <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>Vayi beno tala phila lueti tuba : Woso wukamba dise diandi voti ngudi andi ti : “Bima biabi biawu ndiedi kaveni vayi ndieka bitambika makaba kuidi Nzambi.” <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>Mutu vengi diambu diodi kasi kadi diambu dimosi ko kuidi dise diandi voti kuidi ngudi andi mu biobi kedi kamveni. Buna lueti vunzikisa mambu ma Nzambi ayi lueti balula mawu mu kikhulu kieno. <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>Batu ba mayuya ! Ezayi wubikula bumboti mu diambu dieno bu katuba :<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>
    <char style="qt">Batu baba mu tsongi zi bididi kaka beta kunzitisila,</char></para>
  <para style="q1" vid="MAT 15:8">
    <char style="qt">vayi mintima miawu thama midi ayi minu.</char><verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>
    <char style="qt">Mu phamba kuandi balembo kutsambidila</char></para>
  <para style="q1" vid="MAT 15:9">
    <char style="qt">bila malongi balembo longi madi zithumunu zikubuku kuidi batu.</char><verse eid="MAT 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>Yesu wutumisa nkangu wu batu ayi wuba kamba :</para>
  <para style="p" vid="MAT 15:10">—Luwa ayi lusudika : <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>Biobi binkotanga mu munu wu mutu bisumunanga mutu ko vayi biobi bintotukanga mu munu wu mutu biawu bieta sumuna mutu.<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>Bosi minlonguki mifikama va ndambu va kaba ayi minkamba :</para>
  <para style="p" vid="MAT 15:12">—Wukadi zaba ti mintima mi Bafalisi miluedi mu diambu di mambu maku ?<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 15:13">—Kioso kunusu, kikambu kuna Dise diama di Diyilu, kiela vuzu. <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>Lubabika ! Badi baphofo zilembo nati baphofo bankaka. Enati phofo wulembo monisa phofo yandi nzila, bawu buadi bafueti tibuka mu dibulu !<verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>Piela wubaka mbembo ayi wunkamba :</para>
  <para style="p" vid="MAT 15:15">—Wutu sudikisa nongo yoyo.<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>Bosi Yesu wuvutula :</para>
  <para style="p" vid="MAT 15:16">—Beno mamveno lukadi sudika e ? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>Lukadi zaba ti bibioso binkotanga mu munu binkuendanga mu vumu bosi bintotukanga ku nganda e ? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>Vayi mantotukanga mu munu wu mutu mu ntima meti ba ayi mawu meti sumuna mutu. <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>Bila mu ntima muntotukilanga mayindu mambimbi vonda, kitsuza, kindumba, yiba, telimina batu kimbangi ki luvunu, finga. <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>Mawu momo mambu mansumunanga mutu. Vayi enati mutu kakadi sukula mioko tuamina kadia, diodi dilendi kunsumuna ko.<verse eid="MAT 15:20"/></para>
  <para style="s1">Minu ki nketo wukambulu Nyuda</para>
  <para style="r">(<ref loc="MRK 7:24-30">Malako 7.24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>Yesu bu kabotuka vana ; wuyenda mu bizunga bi Tile ayi bi Sidoni.<verse eid="MAT 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 15:22"/>Zimbukila nketo wumosi, muisi Kana, wuba vuandanga muna bizunga beni wuyiza ku kaba ayi wuyamikina :</para>
  <para style="p" vid="MAT 15:22">—A Pfumu ! Muana Davidi, wumboni kiadi ! Pheve yimbimbi yilembo yamisa ngolo muanꞌama wu nketo.<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>Vayi Yesu kasi kumvutudila kadi diambu ko. Minlonguki mifikama va ndambu vaba Yesu ayi minleba :</para>
  <para style="p" vid="MAT 15:23">—Wunkuka, bila wulembo yamikina ngolo ku manima meto.<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>Vayi niandi wuvutula :</para>
  <para style="p" vid="MAT 15:24">—Minu nditumu kaka kuidi mamemi ma Iseli momo mazimbala !<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>Vayi nketo beni wuyiza fukama va ntualꞌandi ayi wunkamba :</para>
  <para style="p" vid="MAT 15:25">—Pfumu, wutsadisa !<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>Buna wumvutudila :</para>
  <para style="p" vid="MAT 15:26">—Disi fuana ko mu bonga dipha di bana ayi lozila diawu zimbua.<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>Nketo wunkamba :</para>
  <para style="p" vid="MAT 15:27">—Nyinga Pfumu ! Vayi zimbua zieti dia bitsiedi-tsiedi biobi bieta bua ku tsi meza yi bapfumu bawu.<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>Buna Yesu wumvutudila :</para>
  <para style="p" vid="MAT 15:28">—E e nketo, minu kiaku kidi kinneni ! Diawu bika buvangama boso butididi. Muna thangu yina kaka muanꞌandi wunketo wubeluka.<verse eid="MAT 15:28"/></para>
  <para style="s1">Yesu wubelusa bambevo bawombo</para>
  <para style="r">(<ref loc="MRK 7:31">Malako 7.31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>Yesu wubotuka vana ayi wuyenda ku muenda mbu wu Ngalili, wukuma ku mongo ayi wuvuanda kuna. <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>Nkangu wu batu bawombo bayiza ku kaba, banata batu bobo baba ntiudikanga, baphofo, mababa, batu babela malu ayi mioko ayi bambevo bankaka. Babatula va malu ma Yesu ayi wuba belusa. <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>Nkangu woso wu batu wusimina bu wumona ti mababa matona yoluka, batu babela malu ayi mioko babeluka, batu bobo baba ntiudika batona diata bu mboti, baphofo zitona mona. Buna baboso bakembisa Nzambi yi Iseli.<verse eid="MAT 15:31"/></para>
  <para style="s1">Yesu wudikila mili ya yi babakala</para>
  <para style="r">(<ref loc="MRK 8:1-10">Malako 8.1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>Yesu wutumisa minlonguki miandi ayi wuba kamba :</para>
  <para style="p" vid="MAT 15:32">—Kiadi ndilembo moni nkangu wu batu baba, bila bilumbu bitatu bame vuandila yama ayi basiedi ko bidia. Ndikadi zola kuba vutula ayi nzalꞌawu bila balenda bua dibutu mu nzila.<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>Minlonguki mimvutudila :</para>
  <para style="p" vid="MAT 15:33">—Va buangu kikambulu batu tuidi, buna kuevi tulenda bakila mapha mafueni mu dikila nkangu wu batu wawu e ?<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>Yesu wuba yuvula :</para>
  <para style="p" vid="MAT 15:34">—Mapha makua madi yeno ?</para>
  <para style="p" vid="MAT 15:34">Bawu bavutula :</para>
  <para style="p" vid="MAT 15:34">—Tsambuadi yi mapha madi yeto ayi bina bi zimbizi zi nlangu ! <verse eid="MAT 15:34"/><verse number="35" style="v" sid="MAT 15:35"/>Buna wutumina batu boso bavuanda va tsi. <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>Bosi wubonga tsambuadi yi mapha beni ayi zimbizi, wuvutula matondo, wubukuna mawu ayi wuvana mawu minlonguki miandi ayi miawu mikabudila nkangu wu batu. <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>Baboso badia ayi bayukuta. Batota bitini biobi bisiala, biwesa tsambudi di bipani. <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>Batu boso badia baba mili ya yi babakala, kadi tanga baketo ayi bana.<verse eid="MAT 15:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39"/>Yesu bu kavutula nkangu wu batu, wukuma mu nlungu ayi wuyenda mu zunga ki Mangadani.<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">Yesu ayi bapfumu banganga Nzambi ba Bayuda</para>
  <para style="r">(<ref loc="MRK 8:11-13">Malako 8.11-13</ref> ; <ref loc="LUK 12:54-56">Luka 12.54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>Bafalisi ayi Basaduki bayiza kuidi Yesu mu diambu bantambila ntambu. Banlomba kavanga dimbu kioki kintotukila ku diyilu.<verse eid="MAT 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2"/>Niandi wuba vutudila :</para>
  <para style="p" vid="MAT 16:2">—Mu masika, beno lueti tuba : “mbazi kuela ba kumboti bila diyilu didi di mbuaki.” <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>Ayi mu nsuka lueti tuba ti : “Buabu mvula yingolo mayinoka bila diyilu didi di mbuaki ayi dinomba.” Luzebi sudika bidimbu bi diyilu vayi lulendi ko zaba sudikisa bidimbu biobi bimmonisa zithangu e ? <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>Batu ba tsungi yimbimbi ayi bakambulu bakuikama bantomba dimbu e ? Balendi mona kadi dimbu kimosi ko vayi botula kaka kioki ki Zonasi. Vana vawu niandi wusia babika ayi wuyenda kuandi.<verse eid="MAT 16:4"/></para>
  <para style="r">(<ref loc="MRK 8:14-21">Malako 8.14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>Mu thangu minlonguki misabuka ku disimu dinkaka di mbu, mizimbakana nata mapha. <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>Yesu wuba kamba :</para>
  <para style="p" vid="MAT 16:6">—Lukeba ayi luzibula meso mu luvi<note caller="+" style="f"><char style="fr" closed="false">16.6 </char><char style="fq" closed="false">Luvi</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">Tala Matayi 13.33.</char></note> lu Bafalisi ayi lu Basaduki.<verse eid="MAT 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7"/>Minlonguki miyuvusana miawu na miawu ayi mituba :</para>
  <para style="p" vid="MAT 16:7">—Mu diambu tukambulu nata mapha.<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>Vayi bu kazaba mayindu mawu, Yesu wuba kamba :</para>
  <para style="p" vid="MAT 16:8">—Bila mbi lulembo kiyuvasana beno yi beno mu diambu luisi nata ko mapha ? Batu ba minu kifioti ! <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>Lusudikidi ko e ? Luzimbikini mapha matanu, momo madikila mili tanu yi babakala e ? Bipani bikua luwesa mu bitsiadisila biobi bisiala ? <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>Bosi diaka tsambuadi di mapha momo makabudulu mili ziya zi babakala e ? Bipani bikua luwesa mu bitsiadisila biobi bisiala ? <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>Buevi lunkambu sudikila ti ndisi tubilanga mu diambu di mapha ko ? Vayi lukeba mu diambu di luvi lu Bafalisi ayi lu Basaduki.<verse eid="MAT 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12"/>Buna bosi basudika ti kasia bakambila mu diambu balubukila luvi lu mapha ko vayi balubuka mu diambu di malongi ma Bafalisi ayi Basaduki.<verse eid="MAT 16:12"/></para>
  <para style="ms1">YESU AYI MINLONGUKI MIANDI</para>
  <para style="s1">Piela wutelimina Yesu kimbangi</para>
  <para style="r">(<ref loc="MRK 8:27-30">Malako 8.27-30</ref> ; <ref loc="LUK 9:18-21">Luka 9.18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>Yesu bu katula ku zunga ki Sezali mu Filipi, wuyuvula minlonguki miandi :</para>
  <para style="p" vid="MAT 16:13">—Buevi batu beti tubanga, Muana Mutu widi nani ?<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>Minlonguki mimvutudila :</para>
  <para style="p" vid="MAT 16:14">—Bankaka beta tuba niandi Yowani Mbotiki ; bankaka Eli ayi bankaka beta tuba widi Zelemi voti wumosi mu mimbikudi.<verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>Buna wuba yuvula :</para>
  <para style="p" vid="MAT 16:15">—Vayi beno veka, lueta tuba ti Minu ndidi nani ?<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>Simoni Piela wumvutudila :</para>
  <para style="p" vid="MAT 16:16">—Ngeyo widi Klisto, Muana wu Nzambi yi moyo !<verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>Buna Yesu wunkamba :</para>
  <para style="p" vid="MAT 16:17">—Khini yiwombo kuidi ngeyo Simoni muana Zonasi, bila kadi sia ti mutu wuzabikisidi mambu mama vayi niandi veka dise diama didi ku Diyilu. <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>Vayi minu ndikukamba : widi Piela<note caller="+" style="f"><char style="fr" closed="false">16.18 </char><char style="fq" closed="false">Piela</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">Tsundu Piela ditadi.</char></note> ayi va yilu ditadi diadi ndiela tungila dibundu diama ayi mielo mi bulungi milendi ku dinunga ko. <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>Ndiela kuvana zitsabi zi Kipfumu ki Diyilu : dioso diambu diodi wela kanga vava ntoto, diela kangama ku Diyilu ayi dioso diambu diodi wela nianguna vava ntoto, diela niangunu mu Diyilu.<verse eid="MAT 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20"/>Bosi Yesu wukandika minlonguki miandi mibika kamba kadi mutu wumosi ti niandi Klisto.<verse eid="MAT 16:20"/></para>
  <para style="s1">Yesu wuyolukila lufua luandi ayi mfulukulu andi</para>
  <para style="r">(<ref loc="MRK 8:31-33">Malako 8.31-33</ref> ; <ref loc="LUK 9:22">Luka 9.22</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>Tona thangu yina, Yesu wutona sudikisa minlonguki miandi ti kafueti kuenda ku Yelusalemi ayi kuna bakulutu ba Bayuda, bapfumu banganga Nzambi, minsoniki mi Mina bela kumbonisa ziphasi zingolo. Bela kumvonda vayi mu lumbu kintatu niandi wela fuluka.<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>Buna Piela wunnata va ndambu ayi wutona kuntubidila :</para>
  <para style="p" vid="MAT 16:22">—Pfumu, bika Nzambi kakeba mu diambu di mambu beni mabika kukuizila !<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>Yesu wubaluka kuidi Piela ayi wunkamba :</para>
  <para style="p" vid="MAT 16:23">—Satana ! Botuka va ndidi ! Wulembo tombi wumbuisa, bila mayindu maku masi ko ma Nzambi vayi ma kimutu !<verse eid="MAT 16:23"/></para>
  <para style="s1">Buevi bu landikinina Yesu</para>
  <para style="r">(<ref loc="MRK 8:34-9:1">Malako 8.34–9.1</ref> ; <ref loc="LUK 9:22-27">Luka 9.22-27</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>Bosi Yesu wukamba minlonguki miandi :</para>
  <para style="p" vid="MAT 16:24">—Enati mutu tidi kundandakana, buna kafueti kukizimbakana niandi veka ayi kabonga dikulusi diandi ayi kandandakana. <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>Bila woso tidi vukisa luzingu luandi wela luzimbisa, vayi woso wela luzimbisa mu diambu diama, buna wela lubakula. <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>Enati mutu beki nza yimvimba vayi zimbisidi muelꞌandi, buna ndandu mbi kela baka e ? Voti mu kima mbi mutu kalenda viakikisa muelꞌandi e ?<verse eid="MAT 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 16:27"/>Bila Muana Mutu, wela kuiza mu nkembo wu Dise diandi va kimosi ayi zimbasi ziandi, buna bosi kela vana kadika mutu mfutuꞌandi wowo wufueni mu kisalu kiandi. <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>Bukiedika ndikulukamba ti batu bankaka, badi vava, balendi fua ko nate bela mona Muana Mutu wunkuizila mu Kipfumu kiandi !<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">Yesu wukituka</para>
  <para style="r">(<ref loc="MRK 9:2-9">Malako 9.2-9</ref> ; <ref loc="LUK 9:28-36">Luka 9.28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>Bilumbu bisambanu bu bivioka, Yesu wubonga Piela, Zaki ayi Yowani khomba Zaki ayi wuba nata ku yilu mongo wumosi wunda. Kuna bakala bawu veka. <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>Buna wukituka va ntualꞌawu ; zizi kiandi kieka nlezima banga thangu ayi minledi miandi mieka miphembi banga kiezila. <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>Tumbu zimbukila Moyize ayi Eli bamonikina minlonguki ; bansolula ayi Yesu.<verse eid="MAT 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4"/>Buna Piela wukamba Yesu :</para>
  <para style="p" vid="MAT 17:4">—Pfumu, bulutidi mboti tukala kueto vava ! Enati tidi, ndieka tunga zinzo zitatu zi ngoto : yimosi mu diambu diaku, yimosi mu diambu di Moyize ayi yimosi mu diambu di Eli.<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>Buna wukidi tubi, dituti dimosi dinlezama diyiza kubafuka ayi mbembo yitotuka mu dituti beni yiwakana :</para>
  <para style="p" vid="MAT 17:5">—Niandi niawu Muanꞌama wu luzolo, khini yiwombo kakumbonisanga ; bika lunwila !<verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>Mu thangu minlonguki miwa mbembo beni, mibubika bizizi biawu va ntoto bila boma bubabuila.<verse eid="MAT 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 17:7"/>Buna Yesu wufikama ; wuba simba ayi wuba kamba :</para>
  <para style="p" vid="MAT 17:7">—Lutelama ! Lubika mona boma !<verse eid="MAT 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 17:8"/>Mu thangu mivumbula meso, niandi veka, Yesu kaka mimona.<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>Bu baba nengumuka mongo, Yesu wuba vana thumunu yayi :</para>
  <para style="p" vid="MAT 17:9">—Lubika kamba mambu mama lumueni kuidi mutu nate lumbu Muana Mutu kela fuluka mu bafua.<verse eid="MAT 17:9"/></para>
  <para style="r">(<ref loc="MRK 9:10-13">Malako 9.10-13</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>Ku nzimunina minlonguki minyuvula :</para>
  <para style="p" vid="MAT 17:10">—A bila mbi minlongi mi Mina mieta tubila ti Eli kafueti tuama kuiza theti e ?<verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>Yesu wuvutula :</para>
  <para style="p" vid="MAT 17:11">—Bukiedika. Eli wela kuiza ayi wela kubika mambu moso. <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>Vayi minu ndikulukamba ti Eli wuyiza vayi basi kunzaba ko ayi bamvangila mambu boso bubela luzolo luawu. Buawu bobo bela monisina Muana Mutu phasi.<verse eid="MAT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13"/>Buna minlonguki misudika ti wuyolukila mu diambu di Yowani Mbotiki.<verse eid="MAT 17:13"/></para>
  <para style="s1">Yesu wubelusa muana wuba pheve yimbimbi</para>
  <para style="r">(<ref loc="MRK 9:14-29">Malako 9.14-29</ref> ; <ref loc="LUK 9:37-43">Luka 9.37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>Buna batula vaba nkangu wu batu bawombo, mutu wumosi wufikama ; wufukama va ntuala Yesu ayi wunleba :<verse eid="MAT 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 17:15"/>—Pfumu, mona muanꞌama wu bakala kiadi ! Kimbevo kisisuka kidi yandi ayi wulembo moni ziphasi ziwombo. Zikhumbu ziwombo keta buila ku mbazu voti mu nlangu. <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>Ndinnetingi kuidi minlonguki miaku vayi mikadi nunga mu ku mbelusa !<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>Yesu wuvutula :</para>
  <para style="p" vid="MAT 17:17">—A beno batu ba tsungi yikambulu minu ayi yimbimbi ! Zithangu zikua ndiela kadilanga yeno diaka va kimosi e ? Zithangu zikua ndiela buela kangilanga ntima mu bila kieno e ? Lundatina niandi vava ! <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>Yesu wutemina pheve yimbimbi beni ayi yawu yitotuka mu muana. Muna yawu thangu muana wubeluka.<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>Bosi minlonguki miyiza kuidi Yesu, va bawu veka, minyuvula :</para>
  <para style="p" vid="MAT 17:19">—Bila mbi beto tusi nunga ko mu kuka pheve yoyi e ?<verse eid="MAT 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 17:20">—Bila minu kifioti kidi yeno. Bila bukiedika ndikulukamba ti enati minu kieno kidi banga luteti lolo bantedilanga mutalide, nganu lulenda kamba kuidi mongo wowo : “Botuka vava, yenda kuna !” Ayi wawu wela botuka. Kuisi ko diambu luela lembakana. <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/>[Vayi pheve yimbimbi yiphila yayi yeti totukila kaka mu lusambulu ayi mu kukifuisa nzala mu lusambulu<note caller="+" style="f"><char style="fr" closed="false">17.21 </char><char style="ft" closed="false">Buku kiaki kisi ko kisonama mu minkanda minkaka.</char></note>.]<verse eid="MAT 17:21"/></para>
  <para style="s1">Yesu wubuela yolukila lufua luandi ayi mfulukulu andi</para>
  <para style="r">(<ref loc="MRK 9:30-32">Malako 9.30-32</ref> ; <ref loc="LUK 9:43-45">Luka 9.43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>Bu bayiza va kimosi ku Ngalili, Yesu wuba kamba :</para>
  <para style="p" vid="MAT 17:22">—Muana Mutu wela yekolo mu mioko mi batu <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>ayi bela kumvonda ; vayi mu lumbu kintatu niandi wela fuluka mu bafua. Buna minlonguki mitona mona kiadi kiwombo.<verse eid="MAT 17:23"/></para>
  <para style="s1">Yesu wufuta phaku yi Nzo Nzambi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>Mu thangu batula ku Kafalinawumi, batu bobo baba futisanga phaku yi Nzo Nzambi bafikama vaba Piela ayi banyuvula :</para>
  <para style="p" vid="MAT 17:24">—A buevi, Nlongiꞌeno kafutanga ko phaku yi Nzo Nzambi e ?<verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>Piela wuvutula :</para>
  <para style="p" vid="MAT 17:25">—Nyinga, weta futa. Piela bu kakota mu nzo ; Yesu wuntuaminina :</para>
  <para style="p" vid="MAT 17:25">—Buevi wumbanza Simoni e ? Banani beti futa ziphaku kuidi mintinu mi ntoto e ? Bana bawu voti banzenza e ?<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>Piela wuvutula ti :</para>
  <para style="p" vid="MAT 17:26">—Zinzenza.</para>
  <para style="p" vid="MAT 17:26">Bosi Yesu wunkamba :</para>
  <para style="p" vid="MAT 17:26">—Diawu bana balendi futa phaku ko ; <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>vayi mu diambu tubika kotisa divuda mu batu baba. Yenda ku mbu, loza nziolo mu nlangu ; benda mbizi yitheti yimbakana, zibula munuꞌandi, buna ma wumona vanzi. Bonga kiawu ayi wuba vana mu diambu di futa ziphaku zi beto buadi.<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">Nani lutidi munneni mu Kipfumu ki Diyilu</para>
  <para style="r">(<ref loc="MRK 9:33-37">Malako 9.33-37</ref> ; <ref loc="LUK 9:46-48">Luka 9.46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>Muna thangu yina, minlonguki miyiza kuidi Yesu ayi minyuvula :</para>
  <para style="p" vid="MAT 18:1">—Buna nani lutidi munneni mu Kipfumu ki Diyilu e ?<verse eid="MAT 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2"/>Yesu wutumisa muana lezi, wuntelimisa va khatitsikꞌawu <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>ayi vutuba :</para>
  <para style="p" vid="MAT 18:3">—Bukiedika ndikulukamba enati lukadi balula mavanga ayi enati lukadi kituka banga bana balezi, lulendi kota ko mu Kipfumu ki Diyilu. <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>Diawu woso mutu wowo wukukikulula banga muana wawu, buna niandi lutidi munneni mu Kipfumu ki Diyilu. <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/>Ayi woso mutu wowo wunyakulu muana lezi wuphila yayi mu dizina diama, minu kuandi kayakudi.<verse eid="MAT 18:5"/></para>
  <para style="r">(<ref loc="MRK 9:42-48">Malako 9.42-48</ref> ; <ref loc="LUK 17:1-2">Luka 17.1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>Woso mutu wumbuisa mu masumu wumosi mu bana balezi bobo bakunguilukilanga, bulutidi mboti bankanga ditadi dinneni diodi beti nikina zitheti mu tsingu bosi bandiamisa ku tsi mbu.<verse eid="MAT 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7"/>A nga mabienga va nza mu diambu di ziphila-phila zi mambu momo meti buisa batu mu masumu ! Mambu beni mafueti kaka kuiza vayi mabienga kuidi mutu wowo wuntonisanga mawu.<verse eid="MAT 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8"/>Enati koko kuaku voti kulu kuaku kulembo buisi mu masumu buna mboti mu zenga kuawu ayi loza kuawu thama. Bila mboti wukota ku luzingu ayi koko kuzengo voti kulu kuzengo ayi mu lozo ku mbazu yika yizimanga ko ayi mioko miodi miduka voti malu muadi maduka.<verse eid="MAT 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 18:9"/>Enati dieso diaku dieta kubuisa mu masumu, dovula diawu ayi loza diawu ku thama ! Bila bulutidi mboti mu kota ku luzingu mu kambu dieso ayi lozo ku mbazu yi bulungi ayi meso muadi maduka.<verse eid="MAT 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>Lukeba Lubika lenza kani muana wumosi mu bana balezi baba bila ndikulukamba zimbasi ziawu ku Diyilu zintelamanga mu zi thangu zioso va ntuala zizi ki Dise diama diodi widi ku Diyilu.<verse eid="MAT 18:10"/></para>
  <para style="s1">Dimemi dizimbala ayi dimonika</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luka 15.3-7</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 18:11"/>[Bila Muana Mutu wuyiza mu vukisa batu bobo bazimbala<note caller="+" style="f"><char style="fr" closed="false">18.11 </char><char style="ft" closed="false">Buku kiaki kisi kisomana ko mu minkanda minkaka.</char></note>.]<verse eid="MAT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>Buevi lumbanza e ? Enati mutu beki khama yi mamemi vayi dimosi dizimbidi, buna kalendi bika ko luvua ayi divua di mamemi mankaka va mbata mongo mu kuenda tombi diodi dizimbidi e ? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>Enati mueni diawu, bukiedika ndikulukamba, makamona khini mu diambu di dimemi dina viokila khini yoyi kadi mu luvua ayi vua lu mamemi momo makambu zimbala. <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>Phila yimosi ayi Dise dieno didi ku Diyilu, kakadi zola ti muana wumosi mu bana balezi baba kazimbala.<verse eid="MAT 18:14"/></para>
  <para style="s1">Buevi bu lemvukila khomba yi vangidi mbimbi</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>Enati khombꞌaku vengi mbimbi, yenda wuntala ngeyo veka ayi nkambi mbimbi yi kavengi va beno veka buadi. Enati wuwilukidi, buna vutudi khombꞌaku mu nzila yimboti. <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>Vayi enati kakadi wilukila, buna bonga mutu wumosi voti batu buadi mu diambu mamo mantubu makindusu mu kimbangi ki batu buadi voti ki batu batatu. <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>Enati, kakadi wila batu beni, buna kamba mambu beni kuidi dibundu. Enati mengi kuandi wila dibundu, buna wuntalanga ; banga Pakanu ayi mfutisi wu phaku. <verse eid="MAT 18:17"/><verse number="18" style="v" sid="MAT 18:18"/>Bukiedika ndikulukamba ti mamo luela kanga vava ntoto, mela kangama ku Diyilu ayi mamo luela nianguna va ntoto mela niangunu ku Diyilu.<verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>Ndikulukamba diaka enati batu buadi mu beno vava ntoto bawizini mu lomba dioso kuandi diambu, buna Dise diama diodi widi ku Diyilu wela kuba vana diawu. <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>Bila vana vakutikini batu buadi voti batu batatu mu dizina diama, minu ndidi va khatitsikꞌawu.<verse eid="MAT 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>Piela wufikama vaba Yesu, wunyuvula :</para>
  <para style="p" vid="MAT 18:21">—A Pfumu ! Zikhumbu zikua mbeki bu lemvukila khombꞌama wukuphangilanga mambu mambimbi e ? Tsambuadi di zikhumbu kaka e ?<verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>Yesu wumvutudila :</para>
  <para style="p" vid="MAT 18:22">—Nana, ndikadi kukamba ti tsambuadi di zikhumbu kaka vayi nate lusambudi lu zikhumbu bunda tsambuadi. <verse eid="MAT 18:22"/><verse number="23" style="v" sid="MAT 18:23"/>Diawu Kipfumu ki Diyilu kidedikini banga ntinu wuzola tanga bima biandi ayi bisadi biandi. <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>Buna katona tanga bima biandi, bannatina kisadi kimosi kiba pholo andi yi kumi di mili di bitalanta<note caller="+" style="f"><char style="fr" closed="false">18.24 </char><char style="fq" closed="false">talanta</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">kiba mbongo yi sengo. Luvalu luandi luba lu mili sambanu zi denali. Talanta kidedakini mu tezo ki mafunda ma mafunda ma zimbongo.</char></note>. <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>Vayi bu kasia nunga ko futa ; diawu pfumuꞌandi katumina ti bansumbisa niandi veka ayi nketoꞌandi ayi bana bandi ayi bima biandi bioso muingi pholo andi yifutama. <verse eid="MAT 18:25"/><verse number="26" style="v" sid="MAT 18:26"/>Vayi kisadi beni kifukama va malu mandi ayi kinleba :</para>
  <para style="p" vid="MAT 18:26">“Bika wumvibidila ! Mandifuta pholoꞌaku yoso !”<verse eid="MAT 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 18:27"/>Pfumu wu kisadi kioki wummona kiadi, wunyekula ayi wunlemvukila pholoꞌandi yoso.<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>Kisadi beni bu katotuka, wudengana nkundi andi, muisi kisalu yandi ; wundeva khama yimosi yi zidenali<note caller="+" style="f"><char style="fr" closed="false">18.28 </char><char style="fq" closed="false">denali</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">yiba mfutu wu kisadi bu kasedi lumbu kimvimba mu ndima.</char></note>. Niandi wumbuila ayi wumfieta va dinga ayi wunkamba : “futa pholoꞌama”.<verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>Nkundi andi wu kisalu wufukama ayi wunleba :</para>
  <para style="p" vid="MAT 18:29">“Bika wumvibidila ! Mandifuta pholoꞌku.” <verse eid="MAT 18:29"/><verse number="30" style="v" sid="MAT 18:30"/>Vayi wumanga vibidila, wuyenda kunkangisa nate kamanisa futa pholo yoso.<verse eid="MAT 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 18:31"/>Bakundi ba kisalu bankaka bamona kiadi kiwombo bu bamona bu viokila mambu moso. Diawu bayenda kambila pfumu kisalu mambu moso bu mabela. <verse eid="MAT 18:31"/><verse number="32" style="v" sid="MAT 18:32"/>Buna Pfumu beni wutumisa kisadi beni, wunkamba :</para>
  <para style="p" vid="MAT 18:32">“Widi kisadi kimbimbi ! Minu ndilemvukila pholo yoso bila wundeba ngolo. <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>A bila mbi wusi monina ko khombꞌaku kiadi, banga bobo minu ndimueniningi kiadi e ?”<verse eid="MAT 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 18:34"/>Pfumu wufuema buwombo ayi wunyekula mu mioko mi batu bobo banyamisanga batu nate kela manisa futa pholoꞌandi yoso. <verse eid="MAT 18:34"/><verse number="35" style="v" sid="MAT 18:35"/>Buawu bobo buela kuluvangila Dise diama didi ku Diyilu enati kadika mutu mu beno mengi lemvukila khombꞌandi mu ntima wukiedika.<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="ms1">KISALU KI YESU MU YUDA AYI MU YELUSALEMI</para>
  <para style="s1">Ziphaka mu diambu di vonda dikuela</para>
  <para style="r">(<ref loc="MRK 10:1-12">Malako 10.1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>Yesu bu kamanisa tuba mambu momo, wubotuka ku Ngalili, wuyenda mu bizunga bi Yuda ku disimu dinkaka di Yolidani. <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>Nkangu wu batu bawombo banlandakana ayi kuna kabelusila bambevo.<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>Bafalisi bayiza kuidi Yesu mu kumvukumuna ayi banyuvula :</para>
  <para style="p" vid="MAT 19:3">—Minsua midi kuidi bakala mu katula nketo andi va dikuela mu kioso-kioso bila e ?<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>Wuba vutudila :</para>
  <para style="p" vid="MAT 19:4">—Lutengi ko ti vana thonono mvangi wuvanga bakala ayi nketo <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>ayi wutuba : <char style="qt">Diawu bakala kela bikila Dise diandi ayi ngudi andi mu bundana ayi nketoꞌandi ; buna bawu buadi bela kituka mutu wumosi e ?</char> <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>Buawu bobo basiedi diaka batu buadi ko vayi beka mutu wumosi. Diawu mutu kabika vambisa kibundisa Nzambi.<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>Bafalisi bankamba :</para>
  <para style="p" vid="MAT 19:7">—Vayi buna bila mbi Moyize kavanina minsua kuidi bakala mu vana nkanda luvambunu kuidi nketo ayi kunkuka va dikuela e ?<verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 19:8">—Moyize wuluvana minsua mu vonda dikuela mu diambu di mintima mieno midi banga matadi. Vayi buawu ko bubela vana thonono. <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>Vayi ndikulukamba : Woso mutu wumvambana ayi nketo andi, enati kasi vola kiphinga ko ayi kuedidi nketo wunkaka, buna luzaba ti bafueti kuntangila nkua kitsuza.<verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>Buna minlonguki minkamba :</para>
  <para style="p" vid="MAT 19:10">—Enati bobo bufueti kadila bakala va ntuala nketo, buna kadi kuandi mfunu mu kuela.<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 19:11">—Batu boso balendi kikinina mambu momo ko vayi kuidi bobo kaka bavanu diawu. <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>Bukiedika bankaka balendi kuela ko bila badi bavokolo tona mbutukulu awu ; bankaka bavokolo kuidi batu mu diambu babika kuela ayi bankaka bakivokolo bawu veka mu diambu di kipfumu ki Diyilu. Woso mutu wulenda kikinina mambu mama, bika kakikinina mawu.<verse eid="MAT 19:12"/></para>
  <para style="s1">Yesu wutambula bana balezi</para>
  <para style="r">(<ref loc="MRK 10:13-16">Malako 10.13-16</ref> ; <ref loc="LUK 18:15-17">Luka 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>Banatina Yesu bana balezi muingi kaba tetika mioko ayi kaba sambidila. Vayi minlonguki mitemina batu bobo banata bana beni.<verse eid="MAT 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14"/>Vayi Yesu wuba kamba :</para>
  <para style="p" vid="MAT 19:14">—Lubika bana balezi biza kuidi minu ; kadi kuba kandika bila kipfumu ki Diyilu kidi ki bobo baba dedikini.<verse eid="MAT 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15"/>Wuba tetika mioko ayi wuyenda kuandi.<verse eid="MAT 19:15"/></para>
  <para style="s1">Zimvuama ayi Kipfumu ki Nzambi</para>
  <para style="r">(<ref loc="MRK 10:17-31">Malako 10.17-31</ref> ; <ref loc="LUK 18:18-30">Luka 18.18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>Buna mutu wumosi wufikama vaba Yesu ayi wunyuvula :</para>
  <para style="p" vid="MAT 19:16">—A Nlongi, diambu mbi dimboti phanga muingi ndibaka luzingu lu mvu ka mvu e ?<verse eid="MAT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17"/>Yesu wumvutudila :</para>
  <para style="p" vid="MAT 19:17">—Bila mbi wukunguivudila mu diambu dimboti e ? Zaba ti wumosi kaka widi wumboti. Vayi enati tidi kota mu luzingu buna wufueti keba Mina.<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>Mutu beni wunyuvula :</para>
  <para style="p" vid="MAT 19:18">—A Mina mbi miomi e ?</para>
  <para style="p" vid="MAT 19:18">Yesu wuvutula :</para>
  <para style="p" vid="MAT 19:18">—<char style="qt">Kadi vonda, kadi vanga kitsuza, kadi yiba, kadi telama kimbangi ki luvunu. </char> <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/><char style="qt">Kinzika dise diaku ayi ngudi aku ayi zola ndiaku banga bobo weta kukizodila ngeyo veka.</char><verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>Ditoko beni dituba :</para>
  <para style="p" vid="MAT 19:20">—Ndieta keba Mina mioso miomi vayi mbi bikambulu diaka va minu e ?<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>Yesu wumvutudila :</para>
  <para style="p" vid="MAT 19:21">—Enati tidi ba mutu wufuana ; yenda mana sumbisa bima biobi bidi yaku bosi vana kuidi minsukami, buna ma wubaka kimvuama ku Diyilu, bosi yiza wundandakana !<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>Ditoko buna kawa mambu mama, wuyenda mu kiadi, bila kimvuama kiwombo kiba yandi.<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>Bosi Yesu wukamba minlonguki miandi :</para>
  <para style="p" vid="MAT 19:23">—Bukiedika ndikulukamba ti didi diambu diphasi kuidi mutu widi kimvuama mu kota mu kipfumu ki Diyilu. <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>Ndikulukamba diaka ti kadi kuandi phasi kuidi kamela<note caller="+" style="f"><char style="fr" closed="false">19.24 </char><char style="fq" closed="false">Kamela</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">mpila bulu kidi banga mpunda. Kikubuku mu natanga bizitu mu dikanga ayi kieti nuanga nlangu wuwombo.</char></note> mu viokila va divudu di tsoma vayi bika kuidi mutu widi kimvuama mu kota mu kipfumu ki Nzambi.<verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>Minlonguki misimina buwombo mu diambu di mambu momo, miyuvula :</para>
  <para style="p" vid="MAT 19:25">—A buna nani lenda vuka e ?<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>Yesu wuba sungimina bosi wutuba :</para>
  <para style="p" vid="MAT 19:26">—Kuidi batu malendi baka bu vangimina ko vayi kuidi Nzambi mamo malenda vangama.<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>Bosi Piela wunyuvula :</para>
  <para style="p" vid="MAT 19:27">—A beto tumana bika bima bioso mu diambu di kulandakananga, buevi buela bela mu diambu dieto e ?<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 19:28">—Bukiedika ndikulukamba ti thangu mambu moso mela kituka mamona ayi bu Muana Mutu kela vuanda va Kundu kiandi ki Kipfumu mu nkembo, beno lundandakana, luela vuanda va kumi bikundu biodi mu diambu di sambisa kumi makanda muadi ma Iseli. <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>Bosi woso mutu bikidi kani zinzo ziandi, kani bakhomba bandi zi babakala, bakhomba bandi zi baketo, kani Dise diandi, ngudi andi, bana bandi voti zitsola ziandi mu diambu diama wela baka bima biandi mu zikhama di zikhumbu ayi wela tambula luzingu lu kalumani. <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>Vayi batu bawombo mu bobo badi buabu batheti bela ba batsuka ayi bobo badi buabu batsuka, bela ba batheti.<verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">Nongo yi bisadi bi ndima yi vinu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>Kipfumu ki Diyilu kidedikini banga :</para>
  <para style="p" vid="MAT 20:1">—Pfumu yi ndima yitotuka mu nsuka-nsuka mu sonika bisadi bilenda sala mu ndimꞌandi yi vinu. <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>Wuwizana yawu mu denali<note caller="+" style="f"><char style="fr" closed="false">20.2 </char><char style="fq" closed="false">denali</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">tala Matayi 18.28.</char></note> kimosi mu lumbu kimosi ayi wuba fidisa ku ndimꞌandi yi vinu. <verse eid="MAT 20:2"/><verse number="3" style="v" sid="MAT 20:3"/>Wutotuka diaka mu thangu yi vua yi nsuka ; wumona batu bankaka, bakambulu mu kisalu, buna batelimini va zandu. <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>Wuba kamba :</para>
  <para style="p" vid="MAT 20:4">“Beno mamveno, yendanu lusala mu ndimꞌama yi vinu ayi mandi lufuta mfutu wufuana. Bawu mamvawu bayenda.”<verse eid="MAT 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 20:5"/>Wutotuka diaka va midi bosi mu thangu yintatu yi masika. Bo buawu kavanga. <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>Mu thangu yintanu, mu masika, wutotuka ayi wumona diaka bankaka buna batelimini vana ayi wuba yuvula :</para>
  <para style="p" vid="MAT 20:6">“Bila mbi lutelimini vava lumbu kimvimba mu kambu sala kadi kima ?”<verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>Bavutula :</para>
  <para style="p" vid="MAT 20:7">“Bila kadi mutu kasi tusonika ko mu kisalu !” Wubakamba :</para>
  <para style="p" vid="MAT 20:7">“Beno mamveno, yendanu sadi ku ndimꞌama.”<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>Va masika pfumu yi ndima wukamba kapita kiandi :</para>
  <para style="p" vid="MAT 20:8">“Tela bisadi ayi wuba futa vayi tonina kuidi bobo baba batsuka mu sonama bosi wumanisina kuidi bobo baba batheti.”<verse eid="MAT 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9"/>Batu bobo basonama thangu yi ntanu yi masika batambula denali kimosi-kimosi mu kadika mutu. <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>Bosi batu bobo baba batheti mu sonama bu bayiza, babanzila ti bawu banluta vayi denali kimosi-kimosi kadika mutu kafutu, <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>Buna batambula kiawu, bafuemina pfumu yi ndima <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>ayi bankamba :</para>
  <para style="p" vid="MAT 20:12">“Batu bobo sonikiningi kunzimunina, thangu yimosi kaka basadidi. Vayi wuba futidi phila yimosi ayi beto tusedi kisalu kingolo ayi ku tsi muini wungolo mu lumbu kimvimba.”<verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>Pfumu yi ndima wuvutula kuidi kisadi kimosi mu bawu :</para>
  <para style="p" vid="MAT 20:13">“A nkundi ama, ndisi kuvangila mbimbi ko ! Tuisi wizananga yaku mu denali kimosi ko e ? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>Bonga mfutu aku ayi yenda kuaku. Minu thidi vana kuidi mutu wowo wutsuka phila yimosi banga ngeyo. <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>A buevi ndisi ko minsua mu vanga dioso thidi mu zimbongo ziama e ? Voti kikhenene weka mona bu ndidi mutu wumboti.”<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>Buawu bobo buela bela batu batsuka batu batheti ayi batu batheti batu batsuka.<verse eid="MAT 20:16"/></para>
  <para style="s1">Yesu wuyolukila diaka lufua luandi ayi mfulukulu andi</para>
  <para style="r">(<ref loc="MRK 10:32-34">Malako 10.32-34</ref> ; <ref loc="LUK 18:31-34">Luka 18.31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>Yesu bu kaba nkuenda ku Yelusalemi ; wubonga mu nzila kumi minlonguki miandi miodi va lutengo, wuba kamba :<verse eid="MAT 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 20:18"/>—Lutala, tulembo yendi ku Yelusalemi, vayi kuna Muana Mutu kela yekodolo mu mioko mi bapfumu banganga Nzambi ayi kuidi Minlongi mi Mina. Bela kunzengila nkanu wu lufua <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>ayi bela kunyekula mu mioko mi bapakanu muingi bansekinina, bambeta bikoti ayi bambanda va dikulusi. Bosi mu lumbu kintatu niandi wela fuluka.<verse eid="MAT 20:19"/></para>
  <para style="s1">Ngudi yi bana ba Zebede yilombila bana bandi buangu ki nzitusu</para>
  <para style="r">(<ref loc="MRK 10:35-45">Malako 10.35-45</ref> ; <ref loc="LUK 22:25-27">Luka 22.25-27</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>Buna ngudi yi bana ba Zebede wuyiza kuidi Yesu va kimosi ayi bana bandi ; wumfukimina ayi wunlomba diambu dimosi.<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>Yesu wuyuvula :</para>
  <para style="p" vid="MAT 20:21">—A mbi tidi e ?</para>
  <para style="p" vid="MAT 20:21">Niandi wuvutula :</para>
  <para style="p" vid="MAT 20:21">—Bika bana bama baba babuadi bababakala bavuanda wumosi ku lubakala luaku ayi wumosi ku lumoso luaku mu Kipfumu kiaku.<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>Yesu wuba kamba :</para>
  <para style="p" vid="MAT 20:22">—Beno lusi zaba ko momo lunlomba. Buna beno lulenda nua mbungu yoyi ndiela nua ?</para>
  <para style="p" vid="MAT 20:22">Bamvutudila :</para>
  <para style="p" vid="MAT 20:22">—Nyinga, tulenda kueto bu vanga !<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>Yesu wuba kamba :</para>
  <para style="p" vid="MAT 20:23">—Bukiedika luela nua mbungu ama vayi mu diambu di vuanda va lubakala luama voti ku lumoso luama, diodi disi ko mu minsua miama bila bibuangu beni bidi mu diambu di batu bobo Dise diama kakubikila biawu.<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>Thangu kumi di minlonguki minkaka miwa bobo, mifuemina bakhomba zina buadi.<verse eid="MAT 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 20:25"/>Yesu wuba tumisa bawu boso, wuba kamba :</para>
  <para style="p" vid="MAT 20:25">—Luzebi ti bapfumu ba Bapakanu zieti kuba yadila mu kingolo ayi batu bawu banneni beti kuba monisanga lulendo luawu. <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>Vayi buawu ko bulenda bela kuidi beno. Vayi woso mutu tidi ba wunneni mu beno bika kaba kisadi kieno. <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>Woso tidi ba wutheti buna bika kaba mvika weno. <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>Bila Muana Mutu kasia kuiza ko muingi bansadila vayi wuyiza mu diambu di sadila batu ayi mu diambu di vana luzingu luandi mu diambu di kula batu bawombo.<verse eid="MAT 20:28"/></para>
  <para style="s1">Yesu wubelusa baphofo buadi</para>
  <para style="r">(<ref loc="MRK 10:46-52">Malako 10.46-52</ref> ; <ref loc="LUK 18:35-43">Luka 18.35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>Bu babika Yeliko, nkangu wu batu bawombo balandakana Yesu. <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>Baphofo buadi bavuanda mu yenda nzila, bu ziwa ti Yesu wulembo vioki buna zieka nyamikina :</para>
  <para style="p" vid="MAT 20:30">—Pfumu ! Muana Davidi, wutumoni kiadi e !<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>Nkangu wu batu wuba temina muingi zibika biyoko vayi ziluta buela yamikina ngolo :</para>
  <para style="p" vid="MAT 20:31">—Pfumu ! Muana Davidi, wutumona kiadi e !<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>Yesu wutelama ; wuba tela ayi wuba yuvula :</para>
  <para style="p" vid="MAT 20:32">—A mbi lutidi ndiluvangila e ?<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>Zimvutudila :</para>
  <para style="p" vid="MAT 20:33">—Pfumu ! Tutidi meso meto mazibuka !<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>Yesu wuba mona kiadi, wusimba meso mawu. Muna ntangu beni yina kaka zitona mona ayi zinlandakana.<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">Yesu wutambulu mu nkembo ku Yelusalemi</para>
  <para style="r">(<ref loc="MRK 11:1-11">Malako 11.1-11</ref> ; <ref loc="LUK 19:28-38">Luka 19.28-38</ref> ; <ref loc="JHN 12:12-19">Yowani 12.12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>Mu thangu bafikama ku Yelusalemi, batula ku Betefange, buala buidi ku mongo minti mi olive, Yesu wutuma minlonguki miodi ayi <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>wuba kamba :</para>
  <para style="p" vid="MAT 21:2">—Yendanu ku buala bobo buidi ku ntualꞌeno. Buna ma lumona phunda yi nketo yikangama ayi muanꞌandi wu mbakala va ndambu ; luzinianguna ayi lundatina ziawu. <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>Enati mutu wuluyuvudi, buna luvutula : “Pfumu wuzivuidi mfunu”. Buna wela kuzifidisa mu nsualu.<verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>Mambu momo mavangama mu diambu di dedikisa mambu matuba mbikudi :<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>
    <char style="qt">Lukamba kuidi ndumba yi Sioni</char></para>
  <para style="q1" vid="MAT 21:5">
    <char style="qt">Tala Ntinuꞌaku wizidi kuidi ngeyo</char></para>
  <para style="q1" vid="MAT 21:5">
    <char style="qt">widi wulembama ; widi va yilu phunda yi nketo</char></para>
  <para style="q1" vid="MAT 21:5">
    <char style="qt">vuendi va mbata muana phunda, muana wu phunda yi nketo.</char><verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>Minlonguki miyenda, mivanga boso Yesu kaba kambila. <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>Minata phunda yinketo ayi muana phunda, miyala minledi miawu va mbata ziphunda beni bosi Yesu wuvuanda vana. <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>Nkangu wu batu bawombo bayala minledi miawu mu nzila. Bankaka bazenga matafi ma minti ayi bayala mawu mu nzila. <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>Nkangu wu batu bobo baba ku ntuala ayi bobo baba ku mbusa, baba yamikinanga :</para>
  <para style="q1" vid="MAT 21:9">
    <char style="qt">Ozana kuidi Muana wu Davidi !</char></para>
  <para style="q1" vid="MAT 21:9">
    <char style="qt">Bika kasakumunu mutu wowo wunkuizila mu dizina di Pfumu</char></para>
  <para style="q1" vid="MAT 21:9">
    <char style="qt">Ozana mu bibuangu bizangama !</char><verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>Bu kakota mu Yelusalemi, divula dioso dinikuka. Bayuvula :</para>
  <para style="p" vid="MAT 21:10">—Nani mutu wowo e ?<verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>Nkangu wu batu wuvutula :</para>
  <para style="p" vid="MAT 21:11">—Yesu, mbikudi wu Nazaleti mu zunga ki Ngalili !<verse eid="MAT 21:11"/></para>
  <para style="s1">Yesu mu nzo Nzambi</para>
  <para style="r">(<ref loc="MRK 11:15-19">Malako 11.15-19</ref> ; <ref loc="LUK 19:45-48">Luka 19.45-48</ref> ; <ref loc="JHN 2:13-16">Yowani 2.13-16</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>Yesu wukota mu luphangu lu Nzo Nzambi, wukuka batu boso baba sumba bima. Wusengubula zimeza zi bobo baba sienzanga zimbongo ayi bikundu bi bobo baba nsumbisa mabembi. <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>Ayi wuba kamba :</para>
  <para style="p" vid="MAT 21:13">—Disonama ti <char style="qt">Nzo ama yela tedolo Nzo yi lusambulu vayi beno lukitudi yawu suamunu ki mivi.</char><verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>Baphofo ayi bantiudikanga bayiza kuidi niandi muna luphangu lu Nzo Nzambi ayi wubabelusa. <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>Bapfumu zi banganga Nzambi ayi minlongi mi Mina mifuema ngolo bu bamona bikumu biobi bivanga Yesu ayi bu bamona bana baba yamikina mu khati luphangu lu nzo Nzambi ti : “Ozana, kuidi muana Davidi !” <verse eid="MAT 21:15"/><verse number="16" style="v" sid="MAT 21:16"/>Diawu banyuvudila :</para>
  <para style="p" vid="MAT 21:16">—Wulembo wi kuaku mambu momo bana bobo balembo tubi e ? Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 21:16">—Nyinga ! Vayi lutengi ko :</para>
  <para style="q1" vid="MAT 21:16">
    <char style="qt">Ngeyo wutambula Nzitusu aku mu miunu mi bana balezi</char></para>
  <para style="q1" vid="MAT 21:16">
    <char style="qt">ayi nate mu miunu mi bana batsombi ?</char><verse eid="MAT 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17"/>Bosi wubabika, wutotuka mu divula, wuyenda ku Betani kuawu kaleka.<verse eid="MAT 21:17"/></para>
  <para style="s1">Yesu wusinga nti wu figi</para>
  <para style="r">(<ref loc="MRK 11:12-14">Malako 11.12-14</ref>,<ref loc="MRK 11:20-25">20-25</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>Mu nsuka-nsuka bu kaba mvutuka ku divula, wumona nzala. <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>Bu kamona nti wumosi wu figi va ndambu nzila, wufikama vaba nti beni vayi meza na meza kaka kamona. Buna wukamba nti beni :</para>
  <para style="p" vid="MAT 21:19">—Wulendi buela butanga kadi dikundi dimosi ko ! Muna thangu beni nti wu figi wutumbu yuma.<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>Minlonguki bu mimona bobo, misimina ayi miyuvula :</para>
  <para style="p" vid="MAT 21:20">—A buevi nti wowo wuvikidi yumina ?<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 21:21">—Bukiedika ndikulukamba enati minu kidi yeno ayi enati lulendi memata ko, bika sia ti lubeki kaka buvangila mambu maphengi mu nti wu figi wawu vayi lubeki bukambila kuidi mongo wowo : “Katuka vava, wukiloza mu mbu !” ayi mela vangama. <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>Mambu mamo malunlomba mu lusambulu, luela matambula enati luwilukidi.<verse eid="MAT 21:22"/></para>
  <para style="s1">Balenza kipfumu ki Yesu</para>
  <para style="r">(<ref loc="MRK 11:27-33">Malako 11.27-33</ref> ; <ref loc="LUK 20:1-8">Luka 20.1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>Yesu wukota mu Nzo Nzambi. Mu thangu kaba nlonga, bapfumu banganga Nzambi ayi bakulutu ba batu bayiza fikama va kaba ayi banyuvula :</para>
  <para style="p" vid="MAT 21:23">—Mu lulendo mbi wulembo vangila mambu momo ? Ayi nani wuvana lulendo beni ?<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 21:24">—Thidi kuluyuvula mamvana kiuvu kimosi. Enati lupheni mvutu, buna bosi minu mamvama ndieka kulukamba mu lulendo mbi ndilembo vangila mambu mama. <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>Nani wuvana Yowani minsua mu botika, Nzambi voti batu ?</para>
  <para style="p" vid="MAT 21:25">Batona findana bawu na bawu ziphaka ayi batuba :</para>
  <para style="p" vid="MAT 21:25">—Beto kuiza kambi ti “Nzambi” buna maka tukamba ti “bila mbi lumanga kunwilukila ?” <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>Bosi beto kamba ti “Batu” boma tummona mu diambu di nkangu wu batu bila baboso bazebi ti Yowani widi mbikudi.<verse eid="MAT 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27"/>Buna bavutudila Yesu :</para>
  <para style="p" vid="MAT 21:27">—Tusi zaba ko !</para>
  <para style="p" vid="MAT 21:27">Niandi mamvandi wuba kamba :</para>
  <para style="p" vid="MAT 21:27">—Minu mamvama ndilendi kulukamba ko kani mu lulendo mbi ndilembo vangilanga mambu momo.<verse eid="MAT 21:27"/></para>
  <para style="s1">Nongo yi bana buadi ba babakala</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>Buevi lumbanza mu diambu diadi ? Mutu wumosi wuba ayi bana bandi buadi bababakala. Wuyiza kuidi wutheti ayi wunkamba : “A muanꞌama yenda sadi buabu ku ndima yi vinu !”<verse eid="MAT 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29"/>Muana beni wumvutudila : “Mbengi kuama” Bosi kunzimunina, wubalula mayindu ayi wuyenda. <verse eid="MAT 21:29"/><verse number="30" style="v" sid="MAT 21:30"/>Dise diyenda kuidi muana wummuadi ayi mo mawu mambu kankamba. Niandi wuvutula “Nyinga Tata, ndinkuenda.” Vayi kasi kuenda ko.<verse eid="MAT 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31"/>Nani wuvanga luzolo lu Dise mu bana babuadi ? Bamvutudila :</para>
  <para style="p" vid="MAT 21:31">—Muana wutheti.</para>
  <para style="p" vid="MAT 21:31">Buna Yesu wuba kamba :</para>
  <para style="p" vid="MAT 21:31">—Bukiedika ndikulukamba mimfutisi mi ziphaku ayi bandumba leta bela kulutuaminina mu kota mu Kipfumu ki Nzambi. <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>Bila Yowani wuyiza mu kulumonisa nzila yi busonga vayi lumanga kunwilukila. Muaki mimfutisi mi ziphaku ayi bandumba leta banwilukila. Ka diambu ko lumona momo vayi lusia balula mavanga ko muingi ku nzimunina lunwilukila.<verse eid="MAT 21:32"/></para>
  <para style="s1">Nongo yi minkuni mimbimbi mi ndima yi vinu</para>
  <para style="r">(<ref loc="MRK 12:1-12">Malako 12.1-12</ref> ; <ref loc="LUK 20:9-19">Luka 20.9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>—Wanu nongo yinkaka : Mutu wumosi wuba ndimꞌandi yi vinu, wutungila yawu luphangu, wukaba dibulu dimosi mu kamuninanga mimbutu ma vinu. Wutunga nzo yi banga mu diambu di sunganga ndimꞌandi. Wuyekula ndima beni mu mioko mi bisadi bi ndima muingi bayifutilanga ; bosi wuyenda mu nzietolo.<verse eid="MAT 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 21:34"/>Thangu yi mvelongo mimbutu bu yifuana, wutuma bisadi biandi kuidi bisadi biobi kadefisa ndima beni muingi belandi ndambuꞌandi mimbutu. <verse eid="MAT 21:34"/><verse number="35" style="v" sid="MAT 21:35"/>Vayi minkuni mi ndima yi vinu beni mibuila bisadi biandi : mibeta wumosi, mivonda wunkaka bosi milozila wuntatu matadi.<verse eid="MAT 21:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 21:36"/>Pfumu yi ndima vinu beni wutuma bisadi binkaka ; lelo bawombo katuma viokila bobo katuama tuma va theti vayi mambu mo mawu bavangulu kuidi bobo kasia bikila ndima.<verse eid="MAT 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 21:37"/>Bosi wuba fidisila muanꞌandi bu katuba ti : bela kinzika muanꞌama.<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>Vayi minkuni buna mimona muana beni wulembo yizi, mikambasana ti : “Taleno mutu wowo wela vinginina kiuka, yizanu tumvonda muingi kiuka kikituka kieto.”<verse eid="MAT 21:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 21:39"/>Mimbuila, minkoka ku nganda yi ndima ayi mimvonda. <verse eid="MAT 21:39"/><verse number="40" style="v" sid="MAT 21:40"/>Buevi lumbanza, thangu pfumu yi ndima yi vinu bu kela vutuka, buevi kela vangila minkuni miomio ?<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>Bamvutudila :</para>
  <para style="p" vid="MAT 21:41">—Wela vonda, mu kambu kiadi batu bobo bambimbi. Bosi wela defisa ndima yi vinu beni kuidi minkuni minkaka miomi miela kumvananga mimbutu mu kadika thangu yeti velo mimbutu !<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>Bosi Yesu wuba kamba :</para>
  <para style="p" vid="MAT 21:42">—Kadi khumbu lutengi ko mu masonoko :</para>
  <para style="q1" vid="MAT 21:42">
    <char style="qt">Ditadi diodi diloza mintungi</char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="qt">dikituka ditadi di mfunu, di fuma ki nzo.</char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="qt">Pfumu niandi wuvanga buawu.</char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="qt">Ayi didi diambu di tsiminanga mu meso meto !</char><verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>Diawu ndikulukambila ti bela kuluziona Kipfumu ki Nzambi ayi bela vana kiawu kuidi batu bobo bela kibutila mimbutu.<verse eid="MAT 21:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 21:44"/>
    <char style="qt">Vayi woso mutu wela bua va ditadi beni</char></para>
  <para style="q1" vid="MAT 21:44">
    <char style="qt">wela keluka mu bitini,</char></para>
  <para style="q1" vid="MAT 21:44">
    <char style="qt">vayi woso wela builu ditadi beni</char></para>
  <para style="q1" vid="MAT 21:44">
    <char style="qt">wela mana kosumuka</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">21.44 </char>
      <char style="ft" closed="false">Buku kiaki kisi ko mu minkanda minkaka. </char>
    </note>
    <char style="qt">.</char><verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>Buna bamana wa zinongo ziozi, bapfumu banganga Nzambi ayi Bafalisi babakula ti Yesu bawu kalembo yolukila. <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>Batomba nzila yi kunkangila vayi nkangu wu batu baba mona boma bila batu bammona ti niandi widi mbikudi.<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">Nongo yi batu batumusu</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luka 14.15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>Yesu wuba yolukila diaka mu zinongo. Wuba kamba :<verse eid="MAT 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 22:2"/>—Kipfumu ki Diyilu kidedikini banga ntinu wumosi wusadisa nyengo mu diambu di dikuela di muanꞌandi wubakala. <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>Wutuma bisadi biandi mu kuenda tedi batu bobo batumusu ku nyengo ; vayi batu beni bamanga kuawa kuiza. <verse eid="MAT 22:3"/><verse number="4" style="v" sid="MAT 22:4"/>Wubuela tuma diaka bisadi binkaka ayi wuba kamba :</para>
  <para style="p" vid="MAT 22:4">“Lukamba kuidi batu bobo batumusu ku nyengo ti mbeni kubika bidia ; phondisidi zingombi ziama ayi bibulu biama bi mafuta ; bima bioso bikubimini. Yizanu ku nyengo dikuela !”<verse eid="MAT 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5"/>Vayi batu bobo batumusu bamona mambu beni maphamba, bosi kadika mutu wuyenda kuandi : Wumosi ku tsolꞌandi, wunkaka ku kita kayenda. <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>Bobo basiala ; bakanga bisadi biandi ; babayamisa ayi babavonda.<verse eid="MAT 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7"/>Buna ntinu wufuema ngolo ayi wufidisa masodi mandi mu vonda mimvondi beni ayi muvika divula diawu. <verse eid="MAT 22:7"/><verse number="8" style="v" sid="MAT 22:8"/>Bosi wukamba bisadi biandi :</para>
  <para style="p" vid="MAT 22:8">“bidia bi nyengo wu dikuela bikubimini. Vayi batu batumusu basi bafuana ko. <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>Diawu yendanu mu ziphambu zi zinzila, tumisanu batu boso lummona muingi biza ku nyengo wu dikuela.”<verse eid="MAT 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 22:10"/>Bisadi biyenda mu zinzila ayi bakutikisa batu boso bobo bamona ; batu bamboti ayi bambimbi ayi nzo yi nyengo wu dikuela yiwala. <verse eid="MAT 22:10"/><verse number="11" style="v" sid="MAT 22:11"/>Ntinu bu kakota mu tala batu bobo baba mu nzo yi nyengo, wumona mutu wumosi wukambu vuata minledi mi nyengo wu dikuela.<verse eid="MAT 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 22:12"/>Buna wunyuvula :</para>
  <para style="p" vid="MAT 22:12">“A nkundi ama ! A buevi kotidi vava ngeyo kambulu vuata minledi mi nyengo wu dikuela ?” Vayi mutu beni kasia baka divutula ko.<verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>Buna ntinu wukamba bisadi biandi :</para>
  <para style="p" vid="MAT 22:13">“Lunkanga malu ayi mioko ; lunloza ku nganda kuidi tombi, kuna kuidi bidilu ayi nkuetosolo wu menu.”<verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>Bila batumusu badi bawombo vayi bobo basobulu badi bafioti.<verse eid="MAT 22:14"/></para>
  <para style="s1">Ziphaka mu diambu di phaku yi Sezali.</para>
  <para style="r">(<ref loc="MRK 12:13-17">Malako 12.13-17</ref> ; <ref loc="LUK 20:20-26">Luka 20.20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>Buna Bafalisi bayenda ayi bafindana ziphaka bawu na bawu mu tomba diluaku di buidila Yesu mu mambu momo kalenda tuba niandi veka. <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>Bamfidisila minlonguki miawu ayi batu ba dikabu di Elode. Batuba :</para>
  <para style="p" vid="MAT 22:16">—A Nlongi, tuzebi mboti ti ngeyo widi mutu wuntubanga kiedika, weta longa nzila yi Nzambi mu kiedika ayi wumonanga mutu boma ko bila wutalanga bizizi bi batu ko. <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>Wutukambi buabu kani buevi wumbanza mu diambu diadi : minsua midi mu futa phaku kuidi Sezali voti nana ?<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>Vayi Yesu wuzaba mayindu mawu mambimbi ayi wutuba :</para>
  <para style="p" vid="MAT 22:18">—A bankua mayuya, bila mbi lukumfiedila e ? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>Mbonisanu zimbongo ziozi lumfutilanga phaku ! Buna bannatina denali<note caller="+" style="f"><char style="fr" closed="false">22.19 </char><char style="fq" closed="false">denali</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">yiba zimbongo zi bisengo. Tala mu Matayi 18.28.</char></note> kimosi.<verse eid="MAT 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 22:20"/>Bosi wuba yuvula :</para>
  <para style="p" vid="MAT 22:20">—Zizi kiaki kinani ayi bisono biabi bi nani e ?<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>Bavutula ti :</para>
  <para style="p" vid="MAT 22:21">—Bi Sezali.</para>
  <para style="p" vid="MAT 22:21">Buna Yesu wuba kamba :</para>
  <para style="p" vid="MAT 22:21">—Diawu luvana bi Sezali kuidi Sezali ayi bi Nzambi kuidi Nzambi !<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>Babo basimina buwombo bu bawa bobo ; bambika ayi bayenda kuawu.<verse eid="MAT 22:22"/></para>
  <para style="s1">Ziphaka mu diambu di mfulukulu</para>
  <para style="r">(<ref loc="MRK 12:18-27">Malako 12.18-27</ref> ; <ref loc="LUK 20:27-40">Luka 20.27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>Muna lumbu beni kuandi, Basaduki, bobo beti tuba ti batu bafua balendi fuluka ko, bayiza kuidi Yesu ayi banyuvula :<verse eid="MAT 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 22:24"/>—A Nlongi, <char style="qt">Moyize wukamba ti bakala dikuela bu kafuidi, enati kasi buta bana ko buna khombꞌandi kafueti vinginina nketo wowo kabikidi muingi kabutila khombꞌandi wufua bana.</char> <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>Vayi tuba ayi tsambuadi di bakhomba zi babakala. Muana wutheti wukuela nketo, wufua ayi kasia buta bana ko. Wubika nketoꞌandi kuidi khombꞌandi. <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>Buawu bobo buvangimina kuidi khomba yoyo yimmuadi ayi yintatu nate kuidi yoyi yi tsambuadi. <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>Ku nzimunina nketo beni mamvandi wufua. <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>A buna mu lumbu ki mfulukulu nketo beni wela ba wunani mu bawu tsambuadi bila bawu boso bankuela e ?<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 22:29">—Lulembo kukivuni bila lusi zaba Masonoko ko ayi lusi zaba ko lulendo lu Nzambi. <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>Ku nzimunina yi mfulukulu. Batu balendi buela kuelana ko ayi kuedusu ko vayi bela ba banga zimbasi mu Diyilu. <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>Vayi mu diambu di mfulukulu yi bafua, lutengi ko mambu ma lukamba Nzambi : <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/><char style="qt">Minu ndidi Nzambi yi Abalahami, yi Isaki ayi yi Yakobi e ? Nzambi kasi Nzambi yi batu bafua ko vayi Nzambi yi batu badi moyo.</char><verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>Nkangu wu batu bu wuwa bobo basimina ngolo mu malongi mandi.<verse eid="MAT 22:33"/></para>
  <para style="s1">Muina wu lutidi</para>
  <para style="r">(<ref loc="MRK 12:28-34">Malako 12.28-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>Bafalisi, bu bawa ti Yesu kangisidi miunu mi Basaduki, bakutakana va kimosi. <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>Buna wumosi mu bawu wuba nlongi wu mina, wuyiza kumfiela. Buna wunyuvula :<verse eid="MAT 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 22:36"/>—A Nlongi ! A Muina mbi wulutidi mu Mina mioso e ?<verse eid="MAT 22:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37"/>Yesu wumvutudila :</para>
  <para style="p" vid="MAT 22:37">—<char style="qt">Zola Pfumu Nzambi aku mu ntimꞌaku woso, mu muelꞌaku woso ayi mu mayindu maku mamo.</char> <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>Wowo muina wulutidi ayi wawu wutheti. <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>Wummuadi wudedikini banga wowo wutheti wawu wawu : <char style="qt">Zola ndiaku banga bu weta kukizodila ngeyo veka.</char> <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>Mina mioso ayi malongi ma mimbikudi madi mu Mina miami miodi.<verse eid="MAT 22:40"/></para>
  <para style="s1">Ziphaka mu diambu di Klisto</para>
  <para style="r">(<ref loc="MRK 12:35-37">Malako 12.35-37</ref> ; <ref loc="LUK 20:41-44">Luka 20.41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>Bafalisi bu bakutakana va kimosi, buna Yesu wuba yuvula :<verse eid="MAT 22:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 22:42"/>—Buevi lumbanzila mu diambu di Klisto ? Widi Muana nani e ? Bamvutudila :</para>
  <para style="p" vid="MAT 22:42">—Widi Muana wu Davidi !<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>Buna wuba kamba :</para>
  <para style="p" vid="MAT 22:43">—Buna buevi Davidi, mu lutumu lu Pheve, kantedila Pfumu e ? Bila niandi wutuba :<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>
    <char style="qt">Pfumu wukamba kuidi Pfumuꞌama :</char></para>
  <para style="q1" vid="MAT 22:44">
    <char style="qt">Vuanda va koko kuama ku lubakala</char></para>
  <para style="q1" vid="MAT 22:44">
    <char style="qt">nate mbeni tula bambeni ziaku</char></para>
  <para style="q1" vid="MAT 22:44">
    <char style="qt">ku tsi bitambi biaku.</char><verse eid="MAT 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45"/>Diawu, enati Davidi wuntedila “Pfumu” buna buevi kafueti bela muanꞌandi e ?<verse eid="MAT 22:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46"/>Kadi mutu wumosi kasia nunga ko kumvutudila mvutu. Ayi tona lumbu beni, kadi mutu wumosi kasia buela nunga ko mu kunyuvula diaka biuvu.<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">Yesu wuzengila bapfumu zi zinganga Nzambi nkanu.</para>
  <para style="r">(<ref loc="MRK 12:38-40">Malako 12.38-40</ref> ; <ref loc="LUK 11:39-52">Luka 11.39-52</ref> ; <ref loc="LUK 20:45-47">20.45-47</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>Buna Yesu wukamba nkangu wu batu ayi minlonguki miandi :<verse eid="MAT 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 23:2"/>—Minlongi mi Mina ayi Bafalisi kisalu kiawu sudikisa batu Mina mi Moyize. <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>Lutumukina ayi lukeba mambu moso bakulukamba. Vayi lubika landakana mavanga mawu bila mambu momo beti longa mawu ko beti sadila.<verse eid="MAT 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 23:4"/>Bazebi kanga mimfuna midi zitu ayi beti tula miawu va mavangiti ma batu vayi bawu veka bamengi nikunina miawu mu tsongi nlembo. <verse eid="MAT 23:4"/><verse number="5" style="v" sid="MAT 23:5"/>Mambu moso bamvanga batidi ti batu baba mona. Diawu zikesi zi fioti-fioti<note caller="+" style="f"><char style="fr" closed="false">23.5 </char><char style="fq" closed="false">zikesi zi fioti-fioti</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">bima Bafalisi baba vuatanga muawu musonama bibuku bi mambu ma Nzambi.</char></note> ziozi beti vuata mu thangu lusambulu zilutidi ziozi zibankaka mu kula ayi zitsongi zi mazuela mawu zidi zi mula. <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>Beti zola kaka vuandila mu bibuangu bi lukinzu mu minyengo ayi mu bikundu bitheti mu nzo zi zikhutukunu. <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>Beti zola baba vaninanga mboti vama vadi batu bawombo ayi babatedilanga “Nlongi”.<verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>Vayi beno babika kulutedilanga “Nlongi” bila beno babo lubeki Nlongi wumosi kaka ayi beno boso luidi bakhomba. <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>Kadi mutu wumosi vava ntoto lulendi tedila ko : “Tata” bila Tata dimosi kaka didi yeno, diodi didi ku Diyilu. <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>Lubika talanga batu balutedila : “Pfumu” bila Pfumu yimosi kaka yidi yeno : Klisto.<verse eid="MAT 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 23:11"/>Mutu wowo lutidi munneni va khatitsikꞌeno wela ba kisadi kieno. <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>Woso mutu wukukinangika wela kululu ayi woso mutu wukukikulula wela nanguku.<verse eid="MAT 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>—A mabienga kuidi beno minlongi mi Mina ayi Bafalisi ! Luidi batu ba mayuya ! Bila lueti kandika batu ba kota mu Kipfumu ki Diyilu ayi beno veka lukotanga ko ! Ayi luvananga ko diluaku kuidi batu batidi kota bakota kuawu !<verse eid="MAT 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14"/>[O mabienga kuidi beno minlongi mi Mina ayi Bafalisi ! Luidi batu ba mayuya ! Bila lueti zionanga bima bi mafuola ayi lueti sambilanga zitsambulu zimula muingi lumonika. Diawu luela bakila thumbudulu yilutidi tola<note caller="+" style="f"><char style="fr" closed="false">23.14 </char><char style="ft" closed="false">Buku kiaki kisi ko mu minkanda minkaka.</char></note>.]<verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>A mabienga kuidi beno minlongi mi Mina ayi Bafalisi ! Luidi batu ba mayuya. Lueti diengilanga mu mbu ayi mu ntoto mu diambu di tombanga kani lulenda baka, ka diambu ko nzenza wumosi wulenda kota mu dibundu dieno. Ayi enati lumbeki, lunkukitulanga muana wu bulungi mu zikhumbu zizole viokila beno veka.<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>A mabienga kuidi beno mintuadisi mifua meso. Beno lueti tuba ti enati mutu levidi ndefi mu “Nzo Nzambi”, diodi disi kuandi diambu ko. Vayi enati mutu levidi ndefi mu “nolo yidi mu Nzo Nzambi” buna kafueti dukisa ndefi andi. <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>Luidi bivungisi ayi Baphofo ! A mbi bilutidi mfunu ? Nolo voti nzo Nzambi yoyi yinkitulanga nolo yinlongo ? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>Lueti tuba diaka : enati mutu levidi ndefi va “diziku dimyokolongo bibulu bitambuku kuidi Nzambi”, diodi disi kuandi diambu ko ; vayi enati levidi ndefi mu “dikaba diodi didi va diziku” buna kafueti dukisa ndefi andi. <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>Baphofo ! Diambu mbi dilutidi mfunu, makaba voti diziku dinkitulanga dikaba dinlongo ? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>Mutu wowo levidi ndefi mu “diziku”, buna levidi yawu mu diziku ayi mu bima bioso bidi vana. <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>Mutu wowo levidi ndefi “mu nzo Nzambi”, buna levidi yawu mu dizina di nzo Nzambi ayi mu mutu wowo wunkalanga muna. <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>Ayi mutu wowo levidi ndefi mu Diyilu, buna levidi yawu mu kundu ki Nzambi ayi mu mutu wowo wuvuandanga va kundu beni.<verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>O mabienga kuidi beno minlongi mi Mina ayi Bafalisi ! Beno luidi batu ba mayuya. Bila ! Lueti vana Nzambi kuku kikumi mu bima biobi lueti kuna mu zitsola zieno banza mu bima biobi bifioti-fioti biobi lueti kuna. Vayi lusadilanga ko mambu malutidi pfumu mu Mina banga : vanganga masonga, monanga batu kiadi ayi vanganga makuikama<note caller="+" style="f"><char style="fr" closed="false">23.23 </char><char style="ft" closed="false">Mu minkanda minkaka musonama minu va buangu ki makuikama.</char></note>. Nganu mawu momo mambu luvanga mu kambu lenza mamo mankaka.<verse eid="MAT 23:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 23:24"/>Mintuadisi mifua meso ! Lueti sosanga biobi lueti nua muingi zinzinzi zifioti-fioti zibika vioka vayi lumminanga bulu kinneni kioki beti tedila kamela.<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>O mabienga kuidi beno minlongi mi Mina ayi beno Bafalisi ! Luidi batu ba mayuya ! Lunsukulanga va mbata kopo ayi va mbata dilonga vayi mu khati mu wala bima biobi lueti yiba ayi zitsatu zieno zimbimbi. <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>Bafalisi bafua meso ! Lutuama theti sukula mu khati kopo ayi mu khati dilonga, bosi buna mu mbata mamusukuka.<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>O mabienga kuidi beno minlongi mi Mina ayi Bafalisi ! Beno luidi batu ba mayuya ! Bila luidi banga biziami biobi bivindu nlangi yi phembi ayi ku nganda bimmonikanga kitoko vayi mu khati mu wala mimvesi mi batu bafua, mvindu ayi kheni yi phila mu phila. <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>Beno mamveno, ku nganda lummonikanga basonga va meso ma batu vayi mu khati muwala mayuya ayi mambu mambimbi ma phila mu phila.<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>O mabienga kuidi beno minlongi mi Mina ayi Bafalisi ! Beno luidi batu mayuya ! Luntunganga biziami bi mimbikudi ayi lumfuanisanga bumboti biziami bi batu basonga, <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>ayi lueti tubanga : “Enati beto tuzinga mu thangu bakulu beto nganu tusia bundana yawu ko mu vonda mimbikudi.” <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>Bu luntuba bobo lulembo telama beno veka kimbangi ti luidi bana ba batu bobo bavonda mimbikudi. <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>Diawu manisanu kisalu kioki kitona bakulu beno.<verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>A beno zinioka ! Bana ba bikusa ! A buevi lulenda tinina nkanu wu bulungi e ? <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>Ndiela lufidisila mimbikudi, batu badi nduenga ayi minlongi mi Mina. Luela vonda bankaka, luela bandisa bankaka va dikulusi vayi bankaka luela babeta bikoti mu zinzo zieno zi zikhutukunu, bosi luela kuba yamisa mu divula dimosi-dimosi <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>muingi menga, ma batu boso basonga, momo matenguka tona mu Abeli mutu wusonga nate mu Zakali muana Balaki ; mutu wowo luvonda va khatitsika Nzo Nzambi ayi diziku diodi banyokilanga Nzambi makaba, matangulu mu mintu mieno.<verse eid="MAT 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 23:36"/>Bukiedika ndikulukamba mambu moso mama mela buila batu ba tsungi yayi.<verse eid="MAT 23:36"/></para>
  <para style="s1">Yesu wudila mu diambu di Yelusalemi</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luka 13.34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>—A Yelusalemi ! A Yelusalemi e ! Ngeyo wumvondanga mimbikudi ayi wunlozilanga matadi batu bobo Nzambi kakufidisilanga. Zikhumbu zikua ndizola kutikisa bana baku banga tsusu bu kankutikisilanga bana bandi ku tsi mavavi mandi. Vayi wumanga kuaku. <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>Tala, nzoꞌaku yikuiza ba dio wuya, yikambu bima.<verse eid="MAT 23:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 23:39"/>Diawu, ndikulukambila : tona buabu lulendi buela kumbona ko nate thangu luela tuba : Bika kasakumunu mutu wowo wunkuizila mu dizina di Pfumu.<verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">Yesu wuyolukila ziphasi ziela buila Yelusalemi</para>
  <para style="r">(<ref loc="MRK 13:1-13">Malako 13.1-13</ref> ; <ref loc="LUK 21:5-10">Luka 21.5-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>Yesu bu katotuka mu Nzo Nzambi, minlonguki miandi mifikama va kaba muingi mimmonisa phila yitungulu Nzo Nzambi beni. <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>Buna wuba kamba :</para>
  <para style="p" vid="MAT 24:2">—Lummona mamoso mama e ? Bukiedika ndikulukamba ti kadi ditadi dimosi dilendi siala ko va mbata ditadi dinkaka, mamo mela tiolomono.<verse eid="MAT 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>Bu kavuanda va mongo minti mi Olive, minlonguki miandi miyiza miawu veka ayi minyuvula :</para>
  <para style="p" vid="MAT 24:3">—Wutukamba thangu mbi mambu beni mela vangimina ayi dimbu mbi kiela monisa phutukulu aku ayi tsukulu yi nza e ?<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 24:4">—Lukeba luedi vunu kuidi mutu ! <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>Bila bawombo bela kuizila mu dizina diama ayi bela tuba : “Minu ndidi Klisto !” ayi bela vuna bawombo. <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>Luela wa zitsangu zi zimvita ayi biyoko bi zimvita vayi lubika ba boma-boma. Mambu beni mafueti vangama vayi yawu ko yela ba tsukulu yi nza. <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>Bila tsi yimosi yela nuanisa tsi yinkaka ayi batu ba kipfumu kimosi bela nuanisa batu ba kipfumu kinkaka. Nzala yela ba yiwombo, ntoto wela nikuka mu bibuangu biwombo. <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>Vayi mambu moso mama mela ba thonono yi minsongo banga mi nketo weka buta.<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>Buna bela kuluyekula mu diambu luyamusu ayi bela kuluvonda. Batu ba makanda moso bela kululenda mu diambu di dizina diama. <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>Mu thangu yina batu bawombo bela loza minu kiawu, bela kuki vakusa ayi bela lendasana bawu yi bawu.<verse eid="MAT 24:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 24:11"/>Mimbikudi miwombo mi luvunu miela totuka ayi miela vuna batu bawombo. <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>Bila mambu mambimbi mela buelama, luzolo lu batu bawombo luela dekuka. <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>Vayi woso wela kanga ntima nate kuna tsukulu wela vuka. <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>Buna Nsamu wawu wumboti wu Kipfumu wela longo va nza yimvimba mu diambu di wuba kimbangi kuidi batu ba makanda ma zitsi zioso. Buna bosi tsukulu yi nza yela ba.<verse eid="MAT 24:14"/></para>
  <para style="r">(<ref loc="MRK 13:14-23">Malako 13.14-23</ref> ; <ref loc="LUK 21:20-24">Luka 21.20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>—Diawu thangu luela mona mbungi wowo wuyolukila mbikudi Danieli, telimini va buangu kinlongo, mutu wowo wulembo tangi bika kasudika <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>buna boso batu bela batakana mu tsi Yuda batinina ku miongo. <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>Woso mutu widi ku mbata muanzu, kabika kuluka mu diambu kabonga bima bidi mu nzoꞌandi. <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>Woso mutu wela batakana mu tsola kabika buela vutuka ku manima mu bonga yunga kiandi.<verse eid="MAT 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 24:19"/>Mabienga mela ba mu bilumbu bina kuidi baketo bela ba mu buemba ayi kuidi bobo bela yemika. <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>Lusambila muingi lumbu beni kioki luela tina kibika ba mu thangu kiozi kingolo voti mu lumbu ki saba. <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>Bila ziphasi beni ziela ba zingolo, nkutu ziphasi zina zibedi ko tona thonono nza nate buabu ayi ziphasi zi phila yina zilendi buela ba ko. <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>Enati Pfumu kasia baka ko lukanu lu kufisa bilumbu beni, nganu kadi mutu wumosi kalendi vuka ko. Vayi wela kufisa biawu mu diambu di batu bobo kasobula.<verse eid="MAT 24:22"/></para>
  <para style="r">(<ref loc="MRK 13:24-31">Malako 13.24-31</ref> ; <ref loc="LUK 17:23-24">Luka 17.23-24</ref> ; <ref loc="LUK 21:25-31">21.25-31</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23"/>Enati mutu wulukembi : “Lutala ! Klisto widi vava”, voti “widi kuna”, lubika kunwilukila. <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>Bila Baklisto ba luvunu<note caller="+" style="f"><char style="fr" closed="false">24.24 </char><char style="fq" closed="false">Baklisto ba luvunu</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">bawu bobo beti kukidedikasa banga Klisto.</char></note> ayi mimbikudi mi luvunu miwombo miela totuka ayi bela vanga bidimbu binneni ayi bikumu bi tsisi muingi babaka bu vunina enati baka bubela, batu bobo Nzambi kasobula. <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>Tala, ndilulubudi.<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>Enati mutu wulukembi ti : “Tala widi ku dikanga” lubika kuenda kuna. Voti : “Tala ! Widi mu bibuangu bisuama”, lubika wilukila ! <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>Bila ndizulu yi Muana Mutu yela ba banga bunkuizilanga lusiemo lueti tonina ku Esite nate ku Wesite. <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/>Bila koso kuidi mvumbi kuawu ku nkutakananga bibala.<verse eid="MAT 24:28"/></para>
  <para style="s1">Ndizulu yi Muana Mutu</para>
  <para style="r">(<ref loc="MRK 13:24-27">Malako 13.24-27</ref> ; <ref loc="LUK 21:25-28">Luka 21.25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>Ziphasi zi bilumbu beni bu ziela tumbu manisa,</para>
  <para style="q1" vid="MAT 24:29">
    <char style="qt">buna thangu yela tumbu nomba</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="qt">ngondi yela zimbisa miezi miandi,</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="qt">zimbuetete ziela doduka tona mu diyilu</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="qt">ayi lulendo lu diyilu luela nikuka.</char><verse eid="MAT 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30"/>Buna dimbu ki Muana Mutu kiela monika mu Diyilu ayi batu ba makanda moso ma ntoto bela nionga ayi bela mona Muana Mutu wunkuizila mu matuti ma diyilu, mu lulendo ayi mu nkembo wunneni. <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>Thangu tulumbeta yinneni yela siku, niandi wela tuma zimbasi ziandi. Ziawu ziela kutikisa batu bandi boso bobo kasobula mu zitsongi ziya zi nza, tona ku tonina nza nate ku sukisina nza. <verse eid="MAT 24:31"/><verse number="32" style="v" sid="MAT 24:32"/>Bika lulonguka dilongi di nti wu figi : Enati matafi mandi meka malebila ayi enati matonini totula meza, buna luzebi ti thangu mvula yifikimini. <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>Beno mamveno bobuawu, buna luela mona mambu moso momo buna luzaba ti Muana Mutu weka nduka kuiza, banga ti niandi weka va muelo. <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>Bukiedika ndikulukamba ti tsungi yayi yilendi kiviokila ko tuamina mambu mama mavangama. <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>Diyilu ayi ntoto biela vioka vayi mambu mama malendi vioka ko !<verse eid="MAT 24:35"/></para>
  <para style="s1">Lukubamanga</para>
  <para style="r">(<ref loc="MRK 13:32-37">Malako 13.32-37</ref> ; <ref loc="LUK 17:26-30">Luka 17.26-30</ref>,<ref loc="LUK 17:34-35">34-35</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>Vayi mu diambu di thangu voti lumbu kiela vangama mambu beni, kadi mutu wumosi kasi zaba ko ayi zimbasi zisi zaba ko, ka diambu ko Muana kasi zaba ko<note caller="+" style="f"><char style="fr" closed="false">24.36 </char><char style="ft" closed="false">Mu minkanda minkaka muisi ko muana.</char></note>. Vayi Tata kaka zebi.<verse eid="MAT 24:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 24:37"/>Mambu momo mavangama mu thangu Nowa mela buela vangama mu thangu Muana Mutu kela kuiza. <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>Bila tuamina khuka yi nlangu, batu badia ayi banua, bakuelana, bakuedisa nate mu lumbu kikota Nowa mu masuwa. <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>Vayi basia zaba diambu dikubabuila ko nate khuka yi nlangu yiyiza ayi yimana vitumuna bawu boso. Bobo buela bela thangu Muana Mutu kela kuiza. <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/>Diawu babakala buadi bela ba mu tsola, wumosi wela bongo wunkaka wela siala. <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>Baketo buadi bela nika zithete va ditadi, wumosi wela bongo wunkaka wela siala.<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>Diawu diodi luzibula meso, bila lusia zaba ko lumbu kiela kuiza Pfumu eno. <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>Luzebi mboti ti enati Pfumu yi nzo zebi thangu muivi kalenda kuizila va builu, nganu kalendi baka bu lekila ko muingi muivi kabika kota mu nzoꞌandi. <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>Diawu beno mamveno, lukubama bila Muana Mutu wela kuiza mu thangu yi lukambulu bela mayindu.<verse eid="MAT 24:44"/></para>
  <para style="r">(<ref loc="LUK 12:41-48">Luka 12.41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>Nani kisadi kikuikama ayi kidiela kioki Pfumu andi kabiekidi mu sunganga bisadi binkaka muingi kaba vananga bidia mu thangu yi fuana ? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>Khini yiwombo yela ba kuidi kisalu kioki enati Pfumu andi wiza kumbata wulembo sadi bumboti kisalu kioki bambiekila. <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>Bukiedika ndikulukamba Pfumu andi wela kunyekudila katalanga bima biandi bioso. <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>Vayi enati kidi kisadi kimbimbi, maka niunguta ti : “Pfumu ama kakadi vika kuiza !” <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>Ayi wukiyekudi mu yamisanga bisadi binkaka ayi mu dianga ayi nuanga va kimosi ayi bikolo-mbungu. <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>Bosi ti pfumu andi wizidi mu lumbu kioki kakambulu mayindu ; mu thangu yika kambulu zaba <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>buna Pfumu wela kunzenga mu bitini ayi wela kuntula mu ntanda wu batu ba mayuya. Kuna kuidi bidilu ayi nkuetoso wu meno.<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">Nongo yi kumi di bandumba</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>Mu lumbu kina, Kipfumu ki Diyilu kiela dedakana banga kumi di bandumba bobo zisi zaba nitu yi babakala ko babonga minda miawu mu kuenda dengana ditoko di makuela. <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>Mu bawu mu ba bandumba zitanu ziba bivulu, zitanu ziba nduenga. <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>Bivulu bibonga minda miawu vayi basi nata mafuta ko. <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>Vayi bobo baba nduenga babonga mintutu miawu mi mafuta ayi minda miawu.<verse eid="MAT 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 25:5"/>Sumbu bakala di makuela kazingila mu kuiza, buna bawu boso baniungina ayi baleka tulu. <verse eid="MAT 25:5"/><verse number="6" style="v" sid="MAT 25:6"/>Va midi mi phipa, mbembo yiyamikina :</para>
  <para style="p" vid="MAT 25:6">“Tala, ditoko di makuela wizidi ! Yenda lundengana.”<verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>Buna bandumba zioso zikotuka ayi zitona kubika minda miawu. <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>Buna bandumba ziosi zi bivulu zikamba kuidi ziozi ziba nduenga :</para>
  <para style="p" vid="MAT 25:8">“Lutuvananu ndambu yi mafuta meno, bila minda mieto mieka nzima !”<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>Vayi ziozi ziba nduenga ziba vutudila :</para>
  <para style="p" vid="MAT 25:9">“Yilendi fuana kuidi beto ayi beno ko. Mboti luenda sumbi mafuta meno veka kuidi bobo beti sumbisa mafuta.”<verse eid="MAT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10"/>Vayi bu bayenda ku sumba, ditoko di makuela diyiza. Bobo baba bakubama bakota yandi mu nzo yi nyengo ayi muelo wuzibama.<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>Ku nzimunina, bandumba bankaka bayiza, zituba :</para>
  <para style="p" vid="MAT 25:11">“Pfumu, Pfumu, wutuzibudila.”<verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>Mfunu wuba vutudila :</para>
  <para style="p" vid="MAT 25:12">“Bukiedika ndikulukamba, ndisi ku luzaba ko.”<verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>Diawu luzibula meso bila lusi zaba ko lumbu ayi thangu.<verse eid="MAT 25:13"/></para>
  <para style="s1">Nongo yi zimbongo zi kitila</para>
  <para style="r">(<ref loc="LUK 19:12-27">Luka 19.12-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>Kiela dedakana banga mutu wumosi wukubama mu vanga nzietolo. Wutela bisadi biandi ayi wuba vana bima biandi. <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>Wuvana kuidi mutu wutheti bitalanta<note caller="+" style="f"><char style="fr" closed="false">25.15 </char><char style="fq" closed="false">talanta</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">kimosi kidedikini mu kumi di zikhumbu di mfutu wu mvu wumvimba wu kisadi.</char></note> bitanu ; kuidi wunkaka bibiodi. Bosi kuidi wuntatu talanta kimosi. Wuvanina buawu kuidi kadika mutu boso bu kalenda sadila mu diela diandi. Buna mutu beni wuyenda kuandi. <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>Mutu wowo wutambula bitalanta bitanu wuyenda tumbu sadila biawu mukhita ayi wuyiza baka bitanu diaka va yilu. <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>Mutu wowo wutambula bitalanta biodi mamvandi wuvanga buawu ; bosi wuyiza baka bitalanta biodi diaka va yilu. <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>Vayi mutu wowo wutambula talanta kimosi, wuyenda kaba dibulu mu tsi ntoto ayi wusueka zimbongo zi pfumuꞌandi.<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>Bilumbu biwombo bu bivioka, pfumu yi bisadi beni wuvutuka mu nzietolo andi ayi wuyuvula kadika mutu kamvumbudila kipholo mu phila yi kasadidi.<verse eid="MAT 25:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 25:20"/>Mutu wowo wutambula bitalanta bitanu wuyiza ayi wumvana bitalanta bitanu binkaka. Wukamba pfumuꞌandi : “Pfumuꞌama ngeyo wuphana bitalanta bitanu, tala bitanu diaka ndibeki va yilu.”<verse eid="MAT 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21"/>Pfumuꞌandi wuvutula : “widi kisadi kimboti ayi kikuikama. Ngeyo wubedi wukuikama mu bima bifioti. Diawu ndieka kuvana minsua mu bima biwombo. Yiza moni khini va kimosi ayi Pfumu aku.”<verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>Mutu wowo wutambula bitalanta biodi wuyiza ayi wutuba :</para>
  <para style="p" vid="MAT 25:22">“Pfumu ngeyo wuphana bitalanta biodi, tala, bi biodi diaka ndibeki va mbata.”<verse eid="MAT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23"/>Pfumuꞌandi wunkamba :</para>
  <para style="p" vid="MAT 25:23">“widi kisadi kimboti ayi kikuikama. Ngeyo wubedi wukuikama mu bima bifioti. Diawu ndieka kuvana minsua mu bima biwombo. Yiza moni khini va kimosi ayi Pfumu aku.”<verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>Bosi mutu wowo wutambula talanta kimosi wuyiza ayi wutuba :</para>
  <para style="p" vid="MAT 25:24">“Pfumu, ndizaba ti ngeyo widi mutu wumosi wu phasi bila weti vela mimbutu mu biobi wusia kuna ko ayi wuntotanga bima biobi ka wusia kuna ko. <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>Ndimueni boma, diawu ndiyenda suekila talanta kiaku ku tsi ntoto. Tala, tambula talanta kiaku.”<verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>Pfumuꞌandi wumvutudila :</para>
  <para style="p" vid="MAT 25:26">“widi kisadi kimbimbi ayi kibolo ! Zebi ti ndimvelanga mimbutu mu biobi ndisia kuna ko ayi ndintotanga bima biobi ndisia kuna. <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>Vayi nganu wutula zimbongo ziama ku banki mu diambu mu lumbu ndiela vutuka ; nditambula zimbongo ziama ayi ndandu va yilu. <verse eid="MAT 25:27"/><verse number="28" style="v" sid="MAT 25:28"/>Lunziona talanta kioki ayi luvana kiawu kuidi mutu wowo widi kumi di bitalanta.”<verse eid="MAT 25:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 25:29"/>Bila bela buela vana kuidi woso mutu widi bima ayi wela baka biwombo. Vayi kuidi woso mutu kambulu bela kunziona ka diambu ko biobi bidi yandi. <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>Luloza kisadi kikondolo mfunu ku nganda kuidi tombi, kuna kuidi bidilu ayi nkuetoso wu meno.<verse eid="MAT 25:30"/></para>
  <para style="s1">Tsambusulu yi tsuka</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>—Mu thangu Muana Mutu kela kuiza mu nkembo andi va kimosi ayi zimbasi zioso, wela vuanda va Kundu kiandi ki nkembo. <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>Batu boso badi va ntoto bela kutakana va ntualꞌandi. Wela vasa batu banga bumvasilanga nsungi mamemi ayi zikhombo. <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>Wela tula mamemi ku koko kuandi ku lubakala bosi zikhombo ku koko kuandi ku lumoso. <verse eid="MAT 25:33"/><verse number="34" style="v" sid="MAT 25:34"/>Buna Ntinu wela kamba kuidi bobo bela ba ku koko kuandi ku lubakala :</para>
  <para style="p" vid="MAT 25:34">“Beno lusakumunu kuidi Dise diama, yizanu ; tambulanu kiuka, Kipfumu kioki balukubikila tona vana va vangulu nza. <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>Bila bu ndiba nzala, luphana bidia ; bu ndiba phuila beno lunduikina, bu ndiba nzenza, luthambula, <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>bu ndikambu minledi mivuata, luphuika ; bu ndiba kimbevo, luyiza kuthala ; bu ndiba mu nloko, luyiza kuthala !”<verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>Vayi batu basonga bela kumvutudila :</para>
  <para style="p" vid="MAT 25:37">“A Pfumu ! Thangu mbi tumona wumfua nzala vayi tuvana bidia e ? Thangu mbi tumuena wuba phuila vayi tunuikina e ? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>A thangu mbi wubela nzenza vayi beto tutambula e ? Voti thangu wukambulu minledi ayi beto tuvuika e ? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>A thangu mbi wubela kimbevo voti mu nloko buna beto tuyiza kutala e ?”<verse eid="MAT 25:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40"/>Vayi ntinu wela kuba vutudila :</para>
  <para style="p" vid="MAT 25:40">“Bukiedika ndikulukamba : yoso khumbu luvanga bobo, kuidi bakhomba ziama ziazi zikambulu mfunu, buna kuidi minu kuandi luvangidi buawu.”<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>Bosi wela tuba kuidi bobo bela ba ku koko kuandi ku lumoso, “Botukanu va meso mama, luidi batu basingu ; yendanu ku mbazu yoyo ka yizimanga ko, yoyo yikubuku mu diambu di Satana ayi zimbasi ziandi. <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>Bila bu ndiba nzala, lusia kuphana bidia ko ; bu ndiba phuila lusia kunduikina ko ; <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>bu ndiba nzenza, lusia kuthambula ko ; bu ndikambu minledi lusia kuphuika ko ; bu ndiba kimbevo ayi ndiba mu nloko lusia kuiza kuthala ko !”<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>Buna bawu bela kumvutudila :</para>
  <para style="p" vid="MAT 25:44">“A Pfumu ! A thangu mbi tumona ti wumfua nzala voti phuila, voti wuba nzenza, wukambu minledi, wuba kimbevo voti mu nloko vayi tumanga kusadisa ?”<verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>Vayi niandi wela kuba vutudila :</para>
  <para style="p" vid="MAT 25:45">“Yoso khumbu lusia buvanga ko kuidi batu baba bakambulu mfunu buna kuidi minu kuandi luvangila buawu.”<verse eid="MAT 25:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46"/>Buna bela kuenda ku thumbudulu yoyi kayilendi suka ko vayi batu basonga ku luzingu lukalumani.<verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="ms1">LUFUA AYI MFULUKULU YESU</para>
  <para style="s1">Bayendila Yesu manenga</para>
  <para style="r">(<ref loc="MRK 14:1-2">Malako 14.1-2</ref> ; <ref loc="LUK 22:1-2">Luka 22.1-2</ref> ; <ref loc="JHN 11:47-53">Yowani 11.47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>Yesu bu kamana tuba mambu mama, wukamba minlonguki miandi :<verse eid="MAT 26:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 26:2"/>—Luzebi ti bilumbu biodi bisiedi muingi nyengo Pasika wutona ; buna bosi Muana Mutu wela yekolo mu vondo va dikulusi !<verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>Buna bapfumu banganga Nzambi ayi bakulutu ba batu bakutakana ku nzo Kayife, pfumu yi banganga Nzambi ; <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>bawizana buevi bafueti kangila Yesu mu luvunu muingi bamvonda.<verse eid="MAT 26:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 26:5"/>Vayi batuba :</para>
  <para style="p" vid="MAT 26:5">—Tubika vanga buawu mu thangu yi nyengo muingi khindu yibika bua mu batu.<verse eid="MAT 26:5"/></para>
  <para style="s1">Badukudila Yesu malasi ku Betani</para>
  <para style="r">(<ref loc="MRK 14:3-9">Malako 14.3-9</ref> ; <ref loc="JHN 12:1-8">Yowani 12.1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>Yesu bu kaba ku Betani ku nzo Simoni, mutu wowo wuba kimbevo ki buazi, <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>nketo wumosi wuyiza ayi bungu ki malasi ma thalu, wudukula mawu ku ntu wu Yesu mu thangu kaba va meza.<verse eid="MAT 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8"/>Vayi minlonguki mifuema bu mimona bobo ayi mituba :</para>
  <para style="p" vid="MAT 26:8">—Bila mbi mbebosolo yi phila yoyo e ? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>Nganu mboti mu sumbisa malasi beni mu thalu yiwombo ayi vana zimbongo beni kuidi minsukami.<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>Yesu bu kazaba mayindu mawu, wuba kamba :</para>
  <para style="p" vid="MAT 26:10">—A mbi lulembo monisina nketo wawu phasi e ? Diambu kaphangidi didi diambu dimboti. <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>Minsukami mikala kuandi yeno mu zithangu zioso, vayi minu ndisi kuiza kalanga yeno ko. <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>Enati nketo wawu wundukudidi malasi mama mu nituꞌama, didi mu diambu di kubika nzikuluꞌama. <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>Bukiedika ndikulukamba ti muamo muela longo Nsamu Wumboti wawu va nza yimvimba, diambu divengi nketo wawu diela yolokolongo mu kuntebukilanga moyo.<verse eid="MAT 26:13"/></para>
  <para style="s1">Yuda wusumbisa Yesu</para>
  <para style="r">(<ref loc="MRK 14:10-11">Malako 14.10-11</ref> ; <ref loc="LUK 22:3-6">Luka 22.3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>Bosi wumosi mu kumi mimvuala miandi miodi, dizina diandi Yuda Isikalioti, wuyenda kuidi bapfumu zi zinganga Nzambi, <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>wuba yuvula :</para>
  <para style="p" vid="MAT 26:15">—Mbi lulenda kuphana enati ndilusumbisidi Yesu e ? Buna bantangila makumatatu ma bivanzi. <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>Tona muna thangu beni Yuda wutomba diluaku di kuba yekudila Yesu.<verse eid="MAT 26:16"/></para>
  <para style="s1">Yesu ayi minlonguki miandi badia pasika</para>
  <para style="r">(<ref loc="MRK 14:12-16">Malako 14.12-16</ref> ; <ref loc="LUK 22:7-13">Luka 22.7-13</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>Mu lumbu kitheti ki nyengo wu mapha makambu tulu luvi<note caller="+" style="f"><char style="fr" closed="false">26.17 </char><char style="fq" closed="false">luvi</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">Tala Matayi 13.33.</char></note> minlonguki miyiza kuidi Yesu ayi minyuvula :</para>
  <para style="p" vid="MAT 26:17">—A kuevi tidi tuenda kubikila ndiwulu yi Pasika e ?<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>Wuba vutudila :</para>
  <para style="p" vid="MAT 26:18">—Yendanu ku divula kuidi kingandi, buna lunkamba : “Nlongi kakembi : thanguꞌama yifikimini, ku nzoꞌaku ndindila Pasika ayi minlonguki miama.”<verse eid="MAT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19"/>Minlonguki mivanga phila yi kambila Yesu. Mikubika Pasika.<verse eid="MAT 26:19"/></para>
  <para style="r">(<ref loc="MRK 14:17-21">Malako 14.17-21</ref> ; <ref loc="LUK 22:14">Luka 22.14</ref> ; <ref loc="JHN 13:21-30">Yowani 13.21-30</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>Mu thangu masika, Yesu wuvuanda va meza ayi kumi mimvuala miandi miodi. <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>Mu thangu baba ndia, Yesu wuba kamba :</para>
  <para style="p" vid="MAT 26:21">—Bukiedika ndikulukamba : buna luididi vava mutu wumosi mu beno maka phakusa !<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>Baboso beka mona kiadi, wumosi-wumosi weka kunyuvula :</para>
  <para style="p" vid="MAT 26:22">—Pfumu, buna minu e ?<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>Yesu wuba vutudila :</para>
  <para style="p" vid="MAT 26:23">—Mutu wowo wumbuika koko kuandi va kimosi ayi minu mu dilonga buna niandi wukuphakusa. <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>Bila Muana Mutu wulembo yendi banga busonimina mu Masonoko mu diambu diandi. Vayi nga mabienga kuidi mutu wowo wumvakusa ! Nganu bufueni kuidi mutu beni mu kambu kuandi butuka !<verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>Yuda, mutu wowo wukumvakusa, wuyuvula :</para>
  <para style="p" vid="MAT 26:25">—A Nlongi ! Bati minu e !</para>
  <para style="p" vid="MAT 26:25">Bosi Yesu wumvutudila :</para>
  <para style="p" vid="MAT 26:25">—Nyinga, ngeyo tubidi buawu.<verse eid="MAT 26:25"/></para>
  <para style="r">(<ref loc="MRK 14:22-25">Malako 14.22-25</ref> ; <ref loc="LUK 22:15-20">Luka 22.15-20</ref> ; <ref loc="1CO 11:23-25">1 Kolinto 11.23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>Thangu baba ndia, Yesu wubonga dipha, wuvutula matondo, wudibukuna bosi wuvana minlonguki miandi, wuba kamba :</para>
  <para style="p" vid="MAT 26:26">—Bonganu ludia, bila yayi yawu nituꞌama !<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>Bosi wubonga mbungu, wuvutula matondo, wuba vana ayi wutuba :</para>
  <para style="p" vid="MAT 26:27">—Bika lunuanu beno boso <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>bila mama mawu menga mama ma Nguizani madukulu mu diambu di ndemvokolo yi masumu ma batu bawombo. <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>Vayi ndikulukamba, kadi khumbu ndiela buela nua vinu tona buabu nate lumbu kioki ndiela nua vinu kimona va kimosi ayi beno mu Kipfumu ki Dise diama.<verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>Buna bayimbila nkunga. Bosi bayenda ku mongo minti mi olive.<verse eid="MAT 26:30"/></para>
  <para style="s1">Yesu wusamuna ti Piela wela kuntunuka.</para>
  <para style="r">(<ref loc="MRK 14:27-31">Malako 14.27-31</ref> ; <ref loc="LUK 22:33-34">Luka 22.33-34</ref> ; <ref loc="JHN 13:37-38">Yowani 13.37-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>Buna Yesu wuba kamba ti :</para>
  <para style="p" vid="MAT 26:31">—Va builu buabu beno boso ma lumana zimbisa minu mu diambu diama. Bila disonama :</para>
  <para style="q1" vid="MAT 26:31">
    <char style="qt">Ndiela vonda nsungi mamemi, </char></para>
  <para style="q1" vid="MAT 26:31">
    <char style="qt">mamemi ma nkangu mela mana tiakana.</char><verse eid="MAT 26:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32"/>Vayi bu ndiela fuluka, ndiela kulutuamina ku Ngalili !<verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>Piela wunkamba :</para>
  <para style="p" vid="MAT 26:33">—A Pfumu ! Ka diambu ko baboso bela zimbisa minu mu diambu diaku, vayi minu ndilendi ko !<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>Yesu wuvutula :</para>
  <para style="p" vid="MAT 26:34">—Tala, bukiedika ndikukamba : buabu kuandi va builu, simbu tsusu yikokula, buna zikhumbu zitatu si wuthunukina.<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>Piela wunkamba :</para>
  <para style="p" vid="MAT 26:35">—Ka diambu ko fua ndifua yaku vayi ndilendi kutunuka ko !</para>
  <para style="p" vid="MAT 26:35">Minlonguki mioso phila yimosi mitubila.<verse eid="MAT 26:35"/></para>
  <para style="s1">Yesu wusambila ku Ngetesemani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Malako 14.32-42</ref> ; <ref loc="LUK 22:39-46">Luka 22.39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>Yesu wuyenda ayi minlonguki miandi ku buangu bantedilanga Ngetesemani. Wuba kamba :</para>
  <para style="p" vid="MAT 26:36">—Lukala vava, minu bu ndiedi ku sambila kuna !<verse eid="MAT 26:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 26:37"/>Wunata Piela ayi bana buadi ba Zebede. Wutona mona kiadi ayi ntima phasi. <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>Bosi wuba kamba :</para>
  <para style="p" vid="MAT 26:38">—Muelꞌama weka kiaki nate nduka mu fua. Lusiala vava vayi luleka nkielo va kimosi ayi minu.<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>Niandi wuyenda thama fioti, wufukama ayi wusambila.</para>
  <para style="p" vid="MAT 26:39">—A Dise diama ! Enati baka bubela, bika kopo yayi yithatukila. Vayi bika bobo nzodidi vayi bobo ngeyo zodidi.<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>Bu kavutuka vaba minlonguki, wuyiza babata balembo leki tulu. Buna wukamba Piela :</para>
  <para style="p" vid="MAT 26:40">—Buna lulendi nunga mu sambila yama va kimosi banza mu thangu yimosi ko e ? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>Luleka nkielo ayi lusambila muingi luedi bua mu phukumunu. Bila pheve yidi ayi luzolo lu mboti vayi nitu yidi yilebakana.<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>Wuyenda diaka mu khumbu yinzole ayi wusambila :</para>
  <para style="p" vid="MAT 26:42">—A Dise diama ! Enati kadi baka bubela ti kopo yayi yithatukila, vayi enati mfueti kuyinua buna bika luzolo luaku luvangama !<verse eid="MAT 26:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43"/>Bu kavutuka diaka ; wuyiza buela bata buna balekidi, bila meso matulu maba yawu. <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/>Buna wusia babika ayi wuyenda sambila mu khumbu yintatu, ayi mambu mo mawu katuba. <verse eid="MAT 26:44"/><verse number="45" style="v" sid="MAT 26:45"/>Bu kavutuka vaba minlonguki ; buna wuba kamba :</para>
  <para style="p" vid="MAT 26:45">—Lukidi leki ayi lulembo vundi e ? Thangu yifikimini ayi Muana Mutu yekolo mu mioko mi bankua masumu. <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>Telamanu, tuendanu Tala mutu wowo wukuphakula fikimini.<verse eid="MAT 26:46"/></para>
  <para style="s1">Bakanga Yesu</para>
  <para style="r">(<ref loc="MRK 14:43-50">Malako 14.43-50</ref> ; <ref loc="LUK 22:47-53">Luka 22.47-53</ref> ; <ref loc="JHN 18:2-11">Yowani 18.2-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>Buna kamanisini ko yoluka, tala Yuda, wumosi mu kumi mimvuala miodi, wuyiza va kimosi ayi nkangu wu batu banata bisabala ayi zimbondo zi minti, batumu kuidi bapfumu zinganga Nzambi ayi kuidi bakulutu ba Bayuda.<verse eid="MAT 26:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 26:48"/>Mutu wowo wuvakula Yesu, wuba vana dimbu kiaki :</para>
  <para style="p" vid="MAT 26:48">—Woso mutu ndikuiza fifi besi, buna niandi lufueti kanga.<verse eid="MAT 26:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49"/>Buna niandi wufikama vaba Yesu ayi wutuba :</para>
  <para style="p" vid="MAT 26:49">—Mboti nlongi. Bosi wumfifa besi.<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>Yesu wunkamba :</para>
  <para style="p" vid="MAT 26:50">—A nkundi ama ! Vanga diwizidi ! Bosi bankaka bafikama, babuila Yesu ayi bankanga.<verse eid="MAT 26:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51"/>Vayi mutu wumosi mu bobo baba ayi Yesu wunonuna koko kuandi, wutotula sabala kiandi, wuzuba kisadi ki Pfumu yi banganga Nzambi ayi wunzenga dikutu.<verse eid="MAT 26:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52"/>Vayi Yesu wunkamba :</para>
  <para style="p" vid="MAT 26:52">—Vutula sabala kiaku va buangu kiandi bila batu bantotulanga sabala, mu sabala bela vondolo. <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>Ngeyo wumbanza ti ndilendi lomba kuidi Dise diama ayi vana vawu niandi kalendi ko kumfidisila zimbasi viokila kumi ayi lengio<note caller="+" style="f"><char style="fr" closed="false">26.53 </char><char style="fq" closed="false">lengio</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">didi dikabu didi mili sambanu di masodi mu thangu yi basi Loma. Mu thangu beni minlonguki misia kumbika ayi mitina kuawu.</char></note> biodi ko e ? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>Vayi buna buevi bulenda dedikinina mambu masonama mu Minkanda meti tuba ti buawu bobo mambu beni mafueti vangimina e ?<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>Muna thangu yina Yesu wutuba kuidi nkangu wu batu :</para>
  <para style="p" vid="MAT 26:55">—Ndieka dovula muingi luiza khangi ayi zimbedi ayi zimbondo zi minti mu mioko ? Keti bilumbu bioso ndibedi longanga mu Nzo Nzambi vayi lusi kukhanga ko. <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>Vayi mambu moso mama mavangimini mu diambu di dedikisa masonoko ma mimbikudi.<verse eid="MAT 26:56"/></para>
  <para style="s1">Basambisa Yesu va ntuala lukutukunu lu minyadi</para>
  <para style="r">(<ref loc="MRK 14:53-65">Malako 14.53-65</ref> ; <ref loc="LUK 22:54-55">Luka 22.54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref> ; <ref loc="JHN 18:12-14">Yowani 18.12-14</ref>,<ref loc="JHN 18:19-23">19-23</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>Batu bobo bakanga Yesu, bannata kuidi Kayife, pfumu banganga Nzambi. Kuna ku kutakana minlongi mi Mina ayi bakulutu ba batu. <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>Vayi Piela wunlandakana kuna manina nate ku luphangu lu pfumu banganga Nzambi, wukota ku khati luphangu ayi wuvuanda va kimosi ayi minsungi mu diambu kamona kani buevi bukuiza manisina mambu beni.<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>Bapfumu banganga Nzambi ayi batu boso ba lukutukunu lu minyadi batomba kimbangi ki luvunu mu diambu di Yesu muingi babaka bila ki kumvondisila. <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>Ka diambu ko bambangi ba luvunu bawombo bayiza, vayi zisia kumbaka bila ko. Ku nzimunina kuyiza batu buadi, <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>bakamba :</para>
  <para style="p" vid="MAT 26:61">—Mutu wawu niandi wukamba ti : “Minu ndenda tiolumuna Nzo Nzambi ayi kuyitungila mu bilumbu bitatu !”<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>Buna Pfumu yi banganga Nzambi wutelama, wuyuvula Yesu :</para>
  <para style="p" vid="MAT 26:62">—Kadi diambu wukadi vutula e ? Kimbangi mbi kioki batu baba balembo kutelimina e ?<verse eid="MAT 26:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MAT 26:63"/>Yesu kasia vutula kadi diambu ko. Pfumu banganga Nzambi wunkamba :</para>
  <para style="p" vid="MAT 26:63">—Ndikulomba mu dizina di Nzambi yi moyo, wutukambi ti ngeyo klisto, Muana Nzambi.<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>Yesu wumvutudila :</para>
  <para style="p" vid="MAT 26:64">—Nyinga ! Banga kuandi butubidi. Buela diaka ndikulukamba : tona buabu luela mona Muana Mutu vuendi va koko ku lubakala lu mutu wowo lutidi lulendo ayi wunkuizila va matuti ma diyilu.<verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>Buna Pfumu banganga Nzambi wukanzuna minledi ayi wukamba :</para>
  <para style="p" vid="MAT 26:65">—vuezidi Nzambi ! Bila mbi tufueti buela tombila diaka bambangi ? Luwilu beno veka phila kavuezidi Nzambi. <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>Beno buevi lumbanzila e ? Bavutula :</para>
  <para style="p" vid="MAT 26:66">—Fueni kuandi mu vondo !<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>Mbadi banlobudila madita ku busu ayi banzuba zikhomi. Bankaka banzuba zimbata ayi bankamba :<verse eid="MAT 26:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MAT 26:68"/>—A Klisto, wutubikudila ayi wutukambi nani wubetidi e ?<verse eid="MAT 26:68"/></para>
  <para style="s1">Piela wutunuka Yesu</para>
  <para style="r">(<ref loc="MRK 14:66-72">Malako 14.66-72</ref> ; <ref loc="LUK 22:56-62">Luka 22.56-62</ref> ; <ref loc="JHN 18:15-18">Yowani 18.15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>Piela wuba wuvuanda ku nganda, mu khati luphangu, kisadi kimosi ki nketo kiyiza ayi kinkamba :</para>
  <para style="p" vid="MAT 26:69">—Mamvaku bedingi ayi Yesu, muisi Ngalili !<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>Vayi Piela wutunuka kuandi va meso ma batu boso :</para>
  <para style="p" vid="MAT 26:70">—Ndisi zaba ko mambu momo wuntuba !<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>Bu kaba kuenda ku ndambu muelo wu luphangu, kuna nketo wunkaka wummona ayi wukamba batu bobo baba vana :</para>
  <para style="p" vid="MAT 26:71">—E e beno, lutala mutu wowo bedingi ayi Yesu muisi Nazaleti !<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>Piela wubuela tunuka diaka ayi wuleva ndefi ti :</para>
  <para style="p" vid="MAT 26:72">—Bukiedika ndisi zaba ko mutu wowo !<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>Buela kala fioti batu bobo baba vana bayiza vaba Piela ayi bankamba :</para>
  <para style="p" vid="MAT 26:73">—Bukiedika ti ngeyo widi wumosi mu batu bobo bila thubulu aku yilembo fundi.<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>Piela wutona leva ndefi ayi wu kitombila tsingulu :</para>
  <para style="p" vid="MAT 26:74">—Ndisi zaba ko mutu wowo ! Muna thangu beni tsusu yikokudi.<verse eid="MAT 26:74"/></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75"/>Buna Piela wutebukila mambu momo Yesu kakamba ti : “Simbu tsusu yinkokula, buna ngeyo si wuthunukina mu zikhumbu zitatu.” Buna wutotuka ku nganda ayi wudila buwombo.<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="r">(<ref loc="MRK 15:1">Malako 15.1</ref> ; <ref loc="LUK 23:1">Luka 23.1</ref> ; <ref loc="JHN 18:28">Yowani 18.28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>Buna buisi bukia, bapfumu zioso zi banganga Nzambi ayi bakulutu ba Bayuda bakutakana ayi bawizana mu tomba diluaku di bamvondila Yesu. <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>Bankanga minsinga, bannata ayi banyekula mu mioko mi nyadi Pilatu.<verse eid="MAT 27:2"/></para>
  <para style="s1">Yuda wukidengidika</para>
  <para style="r">(<ref loc="ACT 1:18-19">Mavanga 1.18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>Yuda, mutu wuyekula Yesu bu kamona ti bazengila Yesu nkanu wu lufua, wumona phasi mu ntima ; diawu wuyenda vutula makumatatu ma zimbongo zi bisengo kuidi bapfumu banganga Nzambi ayi kuidi bakulutu ba Bayuda. <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>Mbadi wuba kamba :</para>
  <para style="p" vid="MAT 27:4">—Mbeni vola masumu bila ndiekudi mutu wukambu vanga kadi kiasa.</para>
  <para style="p" vid="MAT 27:4">Bawu bamvutudila :</para>
  <para style="p" vid="MAT 27:4">—Momo masi tutala ko ! Matedi kuaku !<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>Buna wusia loza zimbongo beni vana tsi, muna Nzo Nzambi, wubotuka ayi wuyenda kidengidika.<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>Bapfumu banganga Nzambi zitota zimbongo beni ayi zituba ti :</para>
  <para style="p" vid="MAT 27:6">—Tuisi ko minsua mu tula zimbongo ziphila yayi mu kesi yi makaba ma Nzo Nzambi bila ziawu zidi zimbongo zi menga.<verse eid="MAT 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 27:7"/>Buna bamana wizana, basumba tsola mu zimbongo beni muingi bazikilanga banzenza. Tsola beni yiba yi mutu wumosi wuba bumbanga zinzungu zituma. <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>Diawu nate buabu tsola beni yintedolongo : “Tsola yi menga”.<verse eid="MAT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9"/>Buawu bobo budedikinina mambu mabikula mbikudi Yelemi ti :</para>
  <para style="pm" vid="MAT 27:9">Babonga makumatatu ma zimbongo zi bisengo, yawu thalu yizenga bana ba Iseli mu diambu diandi <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>Ayi ziawu basumbila tsola yi mutu wumbumbanga zinzungu zituma banga bobo Pfumu kathumina.<verse eid="MAT 27:10"/></para>
  <para style="s1">Pilatu wusambisa Yesu</para>
  <para style="r">(<ref loc="MRK 15:1-15">Malako 15.1-15</ref> ; <ref loc="LUK 23:1-5">Luka 23.1-5</ref>,<ref loc="LUK 23:13-25">13-25</ref> ; <ref loc="JHN 18:28-40">Yowani 18.28-40</ref> ; <ref loc="JHN 19:4-16">19.4-16</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>Buna Yesu wutelama va ntuala nyadi, ayi niandi wunyuvula :</para>
  <para style="p" vid="MAT 27:11">—Ngeyo widi ntinu Bayuda e ?</para>
  <para style="p" vid="MAT 27:11">Yesu wumvutudila :</para>
  <para style="p" vid="MAT 27:11">—Nyinga ! Yidi banga bu tubidi.<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>Vayi thangu bapfumu banganga Nzambi ayi bakulutu ba Bayuda bu bayiza kumfunda, niandi kasia vutula kadi diambu ko.<verse eid="MAT 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13"/>Pilatu wunyuvula :</para>
  <para style="p" vid="MAT 27:13">—Wulembo wi kuaku mambu momo balembo kufundila e ? <verse eid="MAT 27:13"/><verse number="14" style="v" sid="MAT 27:14"/>Vayi Yesu kadi diambu dimosi kasia vutula ko. Diawu nyadi kasiminina buwombo.<verse eid="MAT 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>Kifu kiba yawu, mu thangu nyengo, nyadi, wuba totulanga mutu wumosi wunloko, wowo wuba nlombongo kuidi batu. <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>Vayi mu thangu yina, mutu wumosi wuyenda tsangu, wuba mu nloko dizina diandi Balabasi.<verse eid="MAT 27:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 27:17"/>Nkangu bu wukutakana, Pilatu wuba yuvula :</para>
  <para style="p" vid="MAT 27:17">—A nani lutidi ndiluyekudila, Balabasi voti Yesu wuba ntedilanga Klisto e ?<verse eid="MAT 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 27:18"/>Bila wuzaba kuandi ti mu diambu di kikhenene banyekudila Yesu.<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>Mu thangu Pilatu kavuanda va kundu ki kizuzi ku tilibinadu, nketoꞌandi wumfidisila thumu yayi :</para>
  <para style="p" vid="MAT 27:19">—Kadi kota mambu ma mutu wowo wu busonga bila mu builu buabu phasi mbueni, mu ndozi, mu diambu diandi !<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>Vayi bapfumu banganga Nzambi ayi bakulutu ba Bayuda beka sindisila nkangu wu batu muingi batuba ti bayekula Balabasi vayi bavonda Yesu.<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>Buna nyadi wuba yuvula diaka :</para>
  <para style="p" vid="MAT 27:21">—A nani lutidi ndiluyekudila muna badi bawu buadi e ?</para>
  <para style="p" vid="MAT 27:21">Batuba :</para>
  <para style="p" vid="MAT 27:21">—Balabasi !<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>Pilatu wuba yuvula :</para>
  <para style="p" vid="MAT 27:22">—A vayi mbi phangila Yesu, wubeti tedilanga Klisto e ?</para>
  <para style="p" vid="MAT 27:22">Bawu boso bavutula :</para>
  <para style="p" vid="MAT 27:22">—Wumbanda va dikulusi !<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>Pilatu wuyuvula :</para>
  <para style="p" vid="MAT 27:23">—Diambu mbi dimbimbi kavengi e ?</para>
  <para style="p" vid="MAT 27:23">Vayi baluta yamikina ngolu :</para>
  <para style="p" vid="MAT 27:23">—Wumbanda va dikulusi !<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>Pilatu bu kamona ti kalendi buela vanga kadi diambu dimosi ko ayi divunzi ditona, wubonga nlangu ; wusukula mioko va ntuala batu boso ayi wukamba :</para>
  <para style="p" vid="MAT 27:24">—Ndisi ko bila mu menga ma mutu wawu. Vayi beno veka matedi !<verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>Batu boso bavutula :</para>
  <para style="p" vid="MAT 27:25">—Bika menga mandi mabua va beto ayi va bana beto !<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>Pilatu wubayekudila Balabasi. Bu kamana betisa Yesu bikoti, wunyekula mu mioko miawu muingi bambanda va dikulusi.<verse eid="MAT 27:26"/></para>
  <para style="s1">Masodi masekinina Yesu</para>
  <para style="r">(<ref loc="MRK 15:16-20">Malako 15.16-20</ref> ; <ref loc="LUK 23:11">Luka 23.11</ref> ; <ref loc="JHN 19:2-3">Yowani 19.2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>Masodi ma nyadi makotisa Yesu ku khati nzo ayi makutikisa dikabu di masodi mu kunzungidila. <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>Bamvula minledi miandi ayi bamvuika yunga ki mbuaki. <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>Bavanga budu ki kipfumu ki zitsendi, bamvuika kiawu ku ntu ; bansimbisa nti va koko kuandi ku lubakala, bamfukimina, bansekinina ayi batuba :</para>
  <para style="p" vid="MAT 27:29">—Mboti e, Ntinu wu Bayuda !<verse eid="MAT 27:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 27:30"/>Banlobudila madita bosi babonga nti, wawu baba kunzubanga ku ntu. <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>Buna bamanisa kunsekinina, bamvula yunga beni ; bamvuika minledi miandi bosi bannata muingi bambanda va dikulusi.<verse eid="MAT 27:31"/></para>
  <para style="s1">Lufua lu Yesu</para>
  <para style="r">(<ref loc="MRK 15:21-32">Malako 15.21-32</ref> ; <ref loc="LUK 23:26-43">Luka 23.26-43</ref> ; <ref loc="JHN 19:17-22">Yowani 19.17-22</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>Bu baba totuka, badengana mutu wumosi mu nzila, dizina diandi Simoni wuba muisi Silene, bankuika kanata dikulusi.<verse eid="MAT 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 27:33"/>Batula ku buangu kimosi baba ntedilanga ngolongota. Tsundu Ngolongota : “Buangu ki mvesi wu ntu”, <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>kuna bamvanina vinu kisobakana ayi kiti ki ndudi muingi kanua. Buna kabimba, wumanga ku kinua.<verse eid="MAT 27:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35"/>Buna bamana ku mbanda va dikulusi, babula tsombo mu diambu di kabana minledi miandi. <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>Mbadi bavuanda kuna mu kunsunga.<verse eid="MAT 27:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 27:37"/>Batula muna dikulusi tini ki dibaya vana mbata ntuꞌandi, musonama bila kioki banzengila nkanu : “Niandi niawu Yesu, ntinu wu Bayuda”.<verse eid="MAT 27:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38"/>Bidovula biodi bibandu va dikulusi va kimosi ayi Yesu, wumosi ku koko ku lubakala, wunkaka ku koko ku lumoso.<verse eid="MAT 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39"/>Batu bobo baba mviokila vana, baba kumfinga, baba nikunanga mintu <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>ayi baba nyoluka :</para>
  <para style="p" vid="MAT 27:40">—E ! Ngeyo mutu wuntiolumunanga Nzo Nzambi ayi kuyitungila diaka mu bilumbu bitatu ; wukivukisa ngeyo veka. Enati widi Muana Nzambi, kuluka va Dikulusi !<verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>Bapfumu banganga Nzambi, minlongi mi Mina ayi bakulutu ba Bayuda mamvawu bansekinina ayi bakamba :<verse eid="MAT 27:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 27:42"/>—A ! Niandi wuvukisidi batu bankaka vayi niandi veka kalendi kukivukisa ko e ! Enati niandi widi ntinu Iseli, kakulumuka va dikulusi muingi tunkikinina. <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>Niandi diana diandi didi mu Nzambi, bika kamvukisa buabu enati weta kunzola ; bila niandi wuba ntubanga : “Ndidi Muana Nzambi.”<verse eid="MAT 27:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44"/>Bidovula biobi bibandu yandi va kimosi va dikulusi mamvawu bobo baba kumfingila.<verse eid="MAT 27:44"/></para>
  <para style="r">(<ref loc="MRK 15:33-41">Malako 15.33-41</ref> ; <ref loc="LUK 23:44-49">Luka 23.44-49</ref> ; <ref loc="JHN 19:25-30">Yowani 19.25-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>Tona thangu midi nate thangu yintatu mu masika, ntoto wumvimba wuba mu tombi kinkobo.<verse eid="MAT 27:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 27:46"/>Nduka-nduka mu thangu yintatu Yesu wuyamikina mu ndinga yingolo :</para>
  <para style="p" vid="MAT 27:46">—<char style="tl">Eli, Eli, Lama sabakatani e ?</char> Bu dinsundula : <char style="qt">Nzambi ama ! Nzambi ama ! Bila mbi wundiekudidi e ?</char><verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>Batu bankaka, bobo batelama vana bu bawa bobo, batuba :</para>
  <para style="p" vid="MAT 27:47">—Eli kantela.<verse eid="MAT 27:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48"/>Wumosi mu bawu, wuzawula, wuyenda bonga eponzi, wukifulusa mu vnu kidi ngami ; wukisomika va tsongi nti bosi wumvana muingi kanua. <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>Vayi bankaka bakamba :</para>
  <para style="p" vid="MAT 27:49">—Bika tutala kani Eli weka kuiza mvukisa.<verse eid="MAT 27:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50"/>Yesu wubuela yamikina diaka mu ndinga yingolo ; buna wuzenga vumunu. <verse eid="MAT 27:50"/><verse number="51" style="v" sid="MAT 27:51"/>Muna thangu beni kaka lido yi Nzo Nzambi yikanzuka mu ndambu zizole tona kuna yilu nate ku tsi. Ntoto wunikuka, matadi mabasuka, <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>biziami bizibuka, batu banlongo bawombo bafua bafuluka. <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>Batotuka mu biziami. Yesu bu kafuluka buna bakota mu divula dinlongo. Batu bawombo baba mona kuna.<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>Pfumu yi masodi ma Loma ayi momo maba yandi mu sunga Yesu bu bamona phila ntoto wunikukina ayi mambu moso momo phila mavangimina, bamona boma yiwombo ayi batuba :</para>
  <para style="p" vid="MAT 27:54">—Bukiedika kuandi ti mutu wowo bedi Muana Nzambi !<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>Baketo bawombo baba vana, thama baba ntadila. Bawu baba nlandakananga Yesu tona ku Ngalili mu diambu bansadila. <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>Mu bawu muba : Maliya muisi Mangadala, Maliya ngudi yi Zaki ayi Zozefi ayi ngudi yi bana ba Zebede.<verse eid="MAT 27:56"/></para>
  <para style="s1">Bazika Yesu</para>
  <para style="r">(<ref loc="MRK 15:42-47">Malako 15.42-47</ref> ; <ref loc="LUK 23:50-56">Luka 23.50-56</ref> ; <ref loc="JHN 19:38-42">Yowani 19.38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>Va thangu masika, mutu wumosi wu kimvuama, muisi Alimate, dizina diandi Zozefi, wuba nlonguki wu Yesu, <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>wuyenda lomba nitu yi Yesu kuidi Pilatu. Buna Pilatu wuvana minsua muingi bamvana yawu. <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>Zozefi wubonga nitu, wuyizinga mu dilasola di lino yi vedila. <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>Wuyitula mu dibumbi diandi dimona, disokolo mu ditadi. Wunengumuna ditadi dimosi dinneni va muelo wu dibumbi. Bosi wuyenda kuandi. <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>Maliya muisi Mangadala ayi Maliya mankaka baba bavuanda ku ndambu yinkaka yitalini ayi dibumbi.<verse eid="MAT 27:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>Lumbu ki khubumunu bu kivioka, mu lumbu kilanda, bapfumu banganga Nzambi ayi Bafalisi bayenda kuidi Pilatu. <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>Bankamba :</para>
  <para style="p" vid="MAT 27:63">—A pfumu ! Tulembo tebuka moyo ti mutu wowo wu luvunu bu kabedi moyo wubedi tubanga ti : “Ndiela fuluka bilumbu bitatu bu biela vioka :” <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>Diawu bulutidi mboti wuvana minsua basunga dibumbi nate bilumbu bitatu bivioka muingi minlonguki miandi mibika kuenda yibi nitu andi bila nganu miela kamba batu ti wufulukidi mu bafua. Buna luvunu beni luela viatuka tezo ayi viokila lolo lutheti mu mbimbi.<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>Pilatu wuba vutudila :</para>
  <para style="p" vid="MAT 27:65">—Bonganu masodi, yendanu, lusunga ziami boso bu luzodidi.<verse eid="MAT 27:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66"/>Bayenda, bazibika bumboti dibumbi mu tula dimbu mu ditadi, ayi babika masodi.<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">Yesu wufuluka</para>
  <para style="r">(<ref loc="MRK 16:1-8">Malako 16.1-8</ref> ; <ref loc="LUK 24:1-12">Luka 24.1-12</ref> ; <ref loc="JHN 20:1-2">Yowani 20.1-2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>Lumbu ki saba bu kivioka ; mu nsuka lumbu kitheti ki sabala ; Maliya muisi Mangadala ayi Maliya mankaka bayenda mu tala ziami. <verse eid="MAT 28:1"/><verse number="2" style="v" sid="MAT 28:2"/>Ayi tala ntoto wunikuka ngolo bila mbasi yi Pfumu yiba ku Diyilu yiyiza ayi yinengumuna ditadi ayi yivuanda va mbata ditadi beni. <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>Philꞌandi yiba banga kiezila ki lusiemo ayi minledi miandi mimonika phembi yi ngolo viokila mvula yi matadi mu phembi. <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>Masodi ma mona tsisi ; matona tita ayi makituka banga batu bafua.<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>Vayi mbasi yikamba kuidi baketo :</para>
  <para style="p" vid="MAT 28:5">—Vayi kuidi beno, bikanu mona boma ! Nzebi ti Yesu diodi babendi va dikulusi niandi luntomba, <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>vayi kasiedi vava ko ! Fulukidingi banga bobo kakambila. Yiza lutala vovo kabedi. <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>Yendanu nsualu ayi kambanu minlonguki miandi ti fulukidingi mu bafua, ayi wulutuamimini buabu ku Ngalili, kuna ma lummona. Tala, ndilukembi.<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>Babika nsualu ziami, ku tsi boma ayi khini yinneni. Mu thinu nsualu bayenda kamba tsangu beni kuidi minlonguki miandi. <verse eid="MAT 28:8"/><verse number="9" style="v" sid="MAT 28:9"/>Ayi tala, Yesu wuba dengana, wutuba :</para>
  <para style="p" vid="MAT 28:9">—Mboti eno. Bawu bafikama va kaba, basimba malu mandi ayi bansambila.<verse eid="MAT 28:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 28:10"/>Bosi Yesu wuba kamba :</para>
  <para style="p" vid="MAT 28:10">—Bikanu mona boma ! Yenda kambianu bakhomba ziama bayenda ku Ngalili, kuawu ziela ku mbonina !<verse eid="MAT 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>Mu thangu baba mu nzila, ndambu masodi masunga ziami mayenda ku divula ayi makamba mambu moso mabua kuidi bapfumu zinganga Nzambi. <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>Bu bakutakana va kimosi ayi bakulutu ba Bayuda, buna bawizana ayi bavana masodi zimbongo ziwombo, <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>ayi baba kamba :</para>
  <para style="p" vid="MAT 28:13">—Buna lutuba ti minlonguki miandi miza yibanga nitu andi va builu mu thangu tubedingi ku tulu. <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>Enati nyadi wilu nsamu wawu buna tuela kulula ntimꞌandi ayi beno lulendi ba ku tsi mayindu ko.<verse eid="MAT 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15"/>Masodi mabonga zimbongo ayi mavanga boso bu babakambila. Buna diambu diodi ditembakana mu Bayuda nate mu lumbu kiaki.<verse eid="MAT 28:15"/></para>
  <para style="s1">Yesu wumonikina minlonguki miandi</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>Kumi minlonguki wumosi miyenda ku Ngalili, ku mongo wowo Yesu kaba sudikila. <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>Mu thangu bammona, bansambila vayi bankaka, bamemata.<verse eid="MAT 28:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18"/>Yesu wufikama va baba ayi wuba kamba :</para>
  <para style="p" vid="MAT 28:18">—Minu baveni lulendo loso tona ku Diyilu nate vava ntoto. <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>Diawu yendanu, lukitula batu ba zitsi zioso minlonguki miama ; Lubabotika mu dizina di Tata, di Muana ayi di Pheve Yinlongo. <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>Ayi luba longa batumimina mambu moso momo ndilutumina. Luzaba mboti ti bilumbu bioso minu ndidi yeno nate vana tsukusulu yi nza.<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
