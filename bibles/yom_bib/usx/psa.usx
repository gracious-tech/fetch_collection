<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Biblica® Open Kiyombe Contemporary New Testament and Psalms 2002</book>
  <para style="h">MINKUNGA</para>
  <para style="toc1">Minkunga</para>
  <para style="toc2">Minkunga</para>
  <para style="toc3">Minkunga</para>
  <para style="mt1">Minkunga</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">BUKU YI THETI</para>
  <para style="cl">Minkunga 1</para>
  <para style="s1">Mina mi Yave midi tho yi mamboti</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>Lusakumunu kuidi mutu wowo wunkambu landakananga</para>
  <para style="q1" vid="PSA 1:1">zindongi zi batu bambimbi,</para>
  <para style="q1" vid="PSA 1:1">wunkambu telamanga mu nzila yi minsumuki,</para>
  <para style="q1" vid="PSA 1:1">ayi wunkambu vuandanga va kimosi ayi mimvuezi.<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>Vayi wummonanga khini mu mina mi Yave</para>
  <para style="q1" vid="PSA 1:2">ayi wunyindulanga miawu muini ayi builu.<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>Mutu beni widi banga nti wukunu va muenda nlangu ;</para>
  <para style="q1" vid="PSA 1:3">wowo wumbutanga makundi mu tsungi andi</para>
  <para style="q1" vid="PSA 1:3">ayi meza mandi mayumanga ko ;</para>
  <para style="q1" vid="PSA 1:3">weti mona mamboti mu mamo keti vanganga.<verse eid="PSA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>Vayi buawu ko buididi kuidi batu bambimbi,</para>
  <para style="q1" vid="PSA 1:4">badi banga biti bivevumunu kuidi phemo.<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>Diawu, batu bambimbi balendi telama ko mu lumbu ki tsambusu,</para>
  <para style="q1" vid="PSA 1:5">voti bankua masumu mu lukutukunu lu batu basonga.<verse eid="PSA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>Bila Yave zebi nzila yi batu basonga,</para>
  <para style="q1" vid="PSA 1:6">vayi nzila yi batu bambimbi yela biva.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="cl">Minkunga 2</para>
  <para style="s1">Mbiekolo ntinu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>Bila mbi makanda mafuemini e ?</para>
  <para style="q1" vid="PSA 2:1">Bila mbi batu balembo yindudila</para>
  <para style="q1" vid="PSA 2:1">mambu makambulu fuana e ?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>Bila mbi mintinu mi ntoto mitelimini e ?</para>
  <para style="q1" vid="PSA 2:2">Bila mbi minyadi mikutikinini va kimosi mu nuanisa Yave</para>
  <para style="q1" vid="PSA 2:2">ayi mutu andi kavinda mafuta e ?<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>Balembo tubi : “tuzenganu minsinga miawu ;</para>
  <para style="q1" vid="PSA 2:3">tulozanu thama zisieni ziawu.”<verse eid="PSA 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>Mutu wowo wunkalanga ku Diyilu wulembo sevi.</para>
  <para style="q1" vid="PSA 2:4">Pfumu wulembo basekinina.<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>Bosi wulembo bayolukila mu nganzi andi,</para>
  <para style="q1" vid="PSA 2:5">ayi wulembo kuba monisa tsisi mu miangu miandi mi ngolo.<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>Ayi wutuba : “Minu ndibieka ntinu ama ku Sioni,</para>
  <para style="q1" vid="PSA 2:6">mongo ama wunlongo.”<verse eid="PSA 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7"/>Ndiela yamikisa lukanu lu Pfumu :</para>
  <para style="q1" vid="PSA 2:7">Yave wukhamba : “Ngeyo widi muanꞌama.</para>
  <para style="q1" vid="PSA 2:7">Minu ndibutidi mu lumbu kiaki.”<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>Wundombi ayi mandivana makanda ;</para>
  <para style="q1" vid="PSA 2:8">ma maba kiuka kiaku</para>
  <para style="q1" vid="PSA 2:8">ayi mawu vua ntoto wumvimba nate mu sukisina ntoto beni.<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>Wela kuba yadilanga mu nkawa wu sengo ;</para>
  <para style="q1" vid="PSA 2:9">wela kuba bula banga bu mbudikilanga nzungu yi tuma.<verse eid="PSA 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>Diawu, beno mintinu, bika luba nduenga.</para>
  <para style="q1" vid="PSA 2:10">Bosi beno mazuzi ma ntoto, bika lutambula ndongokolo ;<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>lusadila Yave mu lukinzu</para>
  <para style="q1" vid="PSA 2:11">ayi lumona khini mu lukhuku.<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>Lubumbakana muana mu diambu di kedi fuema ;</para>
  <para style="q1" vid="PSA 2:12">ayi luedi bungana mu nzilꞌeno.</para>
  <para style="q1" vid="PSA 2:12">Bila mu mbuetolo yi meso nganzi andi yilenda vika wulama.</para>
  <para style="q1" vid="PSA 2:12">Lusakumunu kuidi batu boso bobo bantombanga suamunu mu niandi.<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="cl">Minkunga 3</para>
  <para style="s1">Kuidi Yave kumbanga phulusu</para>
  <para style="d">Nkunga Davidi mu thangu katina muanꞌandi Abisaloni.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1"/>A Yave, tala buevi badidi woka bobo bandendidi ;</para>
  <para style="q1" vid="PSA 3:1">batu bawombo balembo ndiendila manenga.<verse eid="PSA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>Bawombo balembo tubi mu diambu diama :</para>
  <para style="q1" vid="PSA 3:2">“Nzambi kalendi kunkula ko.”<verse eid="PSA 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>Vayi ngeyo, widi nkaku ama, a Yave.</para>
  <para style="q1" vid="PSA 3:3">Ngeyo nkemboꞌama, ngeyo wumvumbulanga ntu ama.<verse eid="PSA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>Ndinyamikinanga kuidi Yave.</para>
  <para style="q1" vid="PSA 3:4">Niandi wukuphutudilanga mvutu tona ku mongo andi wunlongo.<verse eid="PSA 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>Ndinlambadala, ndinleka tulu ayi ndinkotukanga ;</para>
  <para style="q1" vid="PSA 3:5">bila Yave niandi wukukhebanga.<verse eid="PSA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>Nditinanga ko tsisi yi makabu mawombo-wombo</para>
  <para style="q1" vid="PSA 3:6">ma batu bobo banzungididi ndambu ayi ndambu.<verse eid="PSA 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>Yave telama ; ngeyo Nzambi ama, wukhudi.</para>
  <para style="q1" vid="PSA 3:7">Bila ngeyo wubetidi bambeni baama baoso mu matama.</para>
  <para style="q1" vid="PSA 3:7">Wukoludi meno ma batu bambimbi.<verse eid="PSA 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>Kuidi Yave kumbanga phulusu.</para>
  <para style="q1" vid="PSA 3:8">Bika lusakumunu luaku luba kuidi batu baku !<verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="cl">Minkunga 4</para>
  <para style="s1">Yave wumvananga ndembama</para>
  <para style="d">Nkunga Davidi, kayimbidila mu bisiku bi zitsinga mu diambu di pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1"/>Wuphutudila mvutu bu ndilembo kutedi, a Nzambi ama yisonga</para>
  <para style="q1" vid="PSA 4:1">ayi wutsadisa bu ndidi mu phasi ;</para>
  <para style="q1" vid="PSA 4:1">wumboni kiadi, wa lusambulu luama.<verse eid="PSA 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>Nate thangu mbi luela,</para>
  <para style="q1" vid="PSA 4:2">tatamana fuisa nkembo ama tsoni e ?</para>
  <para style="q1" vid="PSA 4:2">Nate thangu mbi luela tatamana zodilanga vanga mambu ma phamba</para>
  <para style="q1" vid="PSA 4:2">ayi tombanga zinzambi zi luvunu e ?<verse eid="PSA 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>Luzaba mboti ti Yave wukisobudidi mutu wumosi</para>
  <para style="q1" vid="PSA 4:3">wunkinzikanga mambu mandi.</para>
  <para style="q1" vid="PSA 4:3">Yave wela wa mu thangu ndiela kuntela.<verse eid="PSA 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>Ku tsi nganzi eno, kadi vola masumu.</para>
  <para style="q1" vid="PSA 4:4">Mu thangu luidi mu zimbuka zieno, lufiongunina mintima mieno</para>
  <para style="q1" vid="PSA 4:4">bosi luba dio sui.<verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>Lutambika makaba ma busonga,</para>
  <para style="q1" vid="PSA 4:5">ayi lutula diana dieno mu Yave.<verse eid="PSA 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>Bawombo balembo tubi :</para>
  <para style="q1" vid="PSA 4:6">“Nani wulenda kutumonisa mamboti e ?”</para>
  <para style="q1" vid="PSA 4:6">Bika kiezila ki zizi kiaku kitukienzula, a Yave !<verse eid="PSA 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>Wuwesidi khini yiwombo mu ntimꞌama,</para>
  <para style="q1" vid="PSA 4:7">viokila yoyi yiba yawu mu thangu baba ble yiwombo</para>
  <para style="q1" vid="PSA 4:7">ayi vinu kiwombo<verse eid="PSA 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>Ndiela lambadala ayi ndiela leka tulu mu ndembama</para>
  <para style="q1" vid="PSA 4:8">bila ngeyo veka kaka, a Yave</para>
  <para style="q1" vid="PSA 4:8">bila ngeyo veka kaka wukuphuandisanga mu luvovomo.<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="cl">Minkunga 5</para>
  <para style="s1">Wuthuadisa mu nzilꞌaku</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi. Wuyimbidila wawu mu flute.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1"/>A Yave, tamba dikutu mu mambu mama ayi tala vumina kuama.<verse eid="PSA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>Dimba yamikina kuama bu ndilembo tombi lusadusu</para>
  <para style="q1" vid="PSA 5:2">A ntinu ama ayi Nzambi ama</para>
  <para style="q1" vid="PSA 5:2">bila ngeyo ndieti sambila.<verse eid="PSA 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>A Yave, mu nsuka ngeyo weti wa mbembo ama.</para>
  <para style="q1" vid="PSA 5:3">Mu nsuka ndieti tula zindombolo ziama va ntualꞌaku</para>
  <para style="q1" vid="PSA 5:3">ayi ndieti vingila mvutu mu diana.<verse eid="PSA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>Bila ngeyo wisiko Nzambi wummonanga khini mu mambu mambimbi ;</para>
  <para style="q1" vid="PSA 5:4">mutu wumbimbi kalendi vuanda ko va kimosi ayi ngeyo.<verse eid="PSA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>Batu badi luniemo balendi telama ko va meso maku.</para>
  <para style="q1" vid="PSA 5:5">Ngeyo weti lenda batu boso bobo bamvanganga mambimbi.<verse eid="PSA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6"/>Ngeyo wumbunganga batu bantubanga luvunu.</para>
  <para style="q1" vid="PSA 5:6">Batu bobo bantengulanga menga ayi bobo bamvunanga,</para>
  <para style="q1" vid="PSA 5:6">Yave weti kuba kakumukina.<verse eid="PSA 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>Vayi minu ndiela kota mu nzoꞌaku mu diambu di kiadi kiaku kinneni</para>
  <para style="q1" vid="PSA 5:7">ndiela buongama mu lukinzu mu Nzoꞌaku Nzambi Yinlongo.<verse eid="PSA 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>Wuthuadisa, a Yave mu busonga buaku</para>
  <para style="q1" vid="PSA 5:8">mu diambu di bambeni ziama.</para>
  <para style="q1" vid="PSA 5:8">Ludika nzilꞌaku ku ntualꞌama.<verse eid="PSA 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>Bila kuisi ko mambu malenda siwulu diana mu miunu miawu ;</para>
  <para style="q1" vid="PSA 5:9">mu mintima miawu muwedi mambu mambivisanga.</para>
  <para style="q1" vid="PSA 5:9">Phovilakꞌawu yidi ziami kizibuka</para>
  <para style="q1" vid="PSA 5:9">ayi mu ludimi luawu bantubilanga luvunu.<verse eid="PSA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>Wuba monisa ti mu nzimbala badi, a Nzambi.</para>
  <para style="q1" vid="PSA 5:10">Bika mayindu mambimbi mawu ma babuisa.</para>
  <para style="q1" vid="PSA 5:10">Wuba kuki mu diambu di wombo di masumu mawu</para>
  <para style="q1" vid="PSA 5:10">Bila ngeyo bafuemini.<verse eid="PSA 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>Vayi bika babo bantomba suamunu mu ngeyo bamona khini.</para>
  <para style="q1" vid="PSA 5:11">Wuba bika bayimbila mu khini mu zithangu zioso ayi bika wuba keba.</para>
  <para style="q1" vid="PSA 5:11">Muingi bobo beti zola dizina diaku,</para>
  <para style="q1" vid="PSA 5:11">bamona khini mu ngeyo.<verse eid="PSA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>Bila bukiedika ngeyo Yave wunsakumunanga mutu wusonga ;</para>
  <para style="q1" vid="PSA 5:12">Wubazungidila mu mamboti maku banga nkaku.<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="cl">Minkunga 6</para>
  <para style="s1">Yave wutsadisa</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi, wuyimbidila wawu mu ngitala yi nana di zitsinga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1"/>A Yave, kadi kuthemina ku tsi nganzi aku</para>
  <para style="q1" vid="PSA 6:1">ayi kadi kuphana thumbudulu bu widi ku tsi miangu miaku mi ngolo.<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>Wumbona kiadi a Yave bila ndidi wulebakana,</para>
  <para style="q1" vid="PSA 6:2">A Yave wumbelusa bila mimvesi miama mieka nduka fua.<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>Muelꞌama wulembo yami,</para>
  <para style="q1" vid="PSA 6:3">Nate thangu mbi, a Yave, nate thangu mbi e ?<verse eid="PSA 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>Vutikisa ntima, a Yave, wukhudi,</para>
  <para style="q1" vid="PSA 6:4">wuphukisa mu diambu di luzolo luaku lu ngolo.<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>Mutu kalendi kutebukila moyo ko niandi fua.</para>
  <para style="q1" vid="PSA 6:5">Ayi nani wela kuzitisa ku tsi bafua e ?<verse eid="PSA 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>Mbemana vonga kuna ku kunga ;</para>
  <para style="q1" vid="PSA 6:6">builu bu mvimba ndieti bodisa mbukꞌama mu bidilu,</para>
  <para style="q1" vid="PSA 6:6">ndieti bodisa buangu ki ndieti leka mu matsuela.<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>Meso mama mabividi mu diambu di kiadi,</para>
  <para style="q1" vid="PSA 6:7">ayi manunini mu diambu di bobo beti kundenda.<verse eid="PSA 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>Botukanu va ntualꞌama</para>
  <para style="q1" vid="PSA 6:8">beno boso lumvanganga mambu mambimbi.</para>
  <para style="q1" vid="PSA 6:8">Bila Yave wuwilu bidilu biama.<verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>Yave wuwilu yamikina kuama mu diambu di kiadi</para>
  <para style="q1" vid="PSA 6:9">Yave kikinini lusambulu luama.<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>Bambeni ziama zioso baela fua tsoni</para>
  <para style="q1" vid="PSA 6:10">ayi bela ba boma-boma.</para>
  <para style="q1" vid="PSA 6:10">Bela vutikisa ku manima ayi bela fua tsoni mu nsualu.<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="cl">Minkunga 7</para>
  <para style="s1">Yave wundungisa</para>
  <para style="d">Nkunga wu maniongo wu Davidi kayimbidila Yave mu diambu di KUSI, muisi dikanda di Benzami.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1"/>A Yave, Nzambi ama,</para>
  <para style="q1" vid="PSA 7:1">kuidi ngeyo ndintombilanga suamunu kiama.</para>
  <para style="q1" vid="PSA 7:1">Wuphukisa mu babo beti kundandakana ayi wukhula.<verse eid="PSA 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>Muingi babika ku khanzuna banga khosi</para>
  <para style="q1" vid="PSA 7:2">ayi kunzenga mu bitini mu kambu mutu wulenda vukisa.<verse eid="PSA 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3"/>A Yave, Nzambi ama, enati ndivengi mawu</para>
  <para style="q1" vid="PSA 7:3">ayi enati nzimbala yidi mu mioko miama ;<verse eid="PSA 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4"/>enati ndivutudi mambimbi kuidi mutu</para>
  <para style="q1" vid="PSA 7:4">wubedi zinganga yama mu ndembama,</para>
  <para style="q1" vid="PSA 7:4">voti ndiziona, mu kambu bila, bima bi mutu wundenda,<verse eid="PSA 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5"/>buna bika mbeni ama kandandakana</para>
  <para style="q1" vid="PSA 7:5">ayi kambakidila ;</para>
  <para style="q1" vid="PSA 7:5">bika kadiatidila luzingu luama va tsi,</para>
  <para style="q1" vid="PSA 7:5">ayi kandekisa mu mbungi-mbungi.<verse eid="PSA 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>A Yave, telama ku tsi nganzi aku,</para>
  <para style="q1" vid="PSA 7:6">Nuanisa miangu mi ngolo mi bambeni ziama.</para>
  <para style="q1" vid="PSA 7:6">A Nzambi ama, kotuka</para>
  <para style="q1" vid="PSA 7:6">bika wundungisa.<verse eid="PSA 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>Bika lukutukunu lu batu bazungidila,</para>
  <para style="q1" vid="PSA 7:7">bika wuba yadila bu widi ku diyilu<verse eid="PSA 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8"/>Bika Yave wusambisa batu</para>
  <para style="q1" vid="PSA 7:8">A Yave, wutsambisa boso buididi busonga buama</para>
  <para style="q1" vid="PSA 7:8">ayi boso buididi fuanana kuama, a Nzambi yizangama<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>A Nzambi yi busonga,</para>
  <para style="q1" vid="PSA 7:9">ngeyo wumfionguninanga mintima</para>
  <para style="q1" vid="PSA 7:9">ayi mayindu ma batu, manisa makhemi ma mutu wumbimbi</para>
  <para style="q1" vid="PSA 7:9">ayi tula mutu wusonga mu luvovomo.<verse eid="PSA 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>Nzambi yizangama niandi nkaku ama ;</para>
  <para style="q1" vid="PSA 7:10">niandi wumvukisanga batu babo badi mintima milulama.<verse eid="PSA 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>Nzambi niandi zuzi disonga,</para>
  <para style="q1" vid="PSA 7:11">Nzambi wummonisanga miangu miandi mu kadika lumbu.<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>Enati kakadi balula mavanga,</para>
  <para style="q1" vid="PSA 7:12">wela lengula sabala kiandi,</para>
  <para style="q1" vid="PSA 7:12">wela leki mbasꞌandi ayi kuwukubika.<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>Wukubika binduanina biandi bi lufua</para>
  <para style="q1" vid="PSA 7:13">wulembo kitula madionga mandi madionga ma mbazu.<verse eid="PSA 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>Niandi widi mu buemba bu mambimbi ;</para>
  <para style="q1" vid="PSA 7:14">widi mu kubika ziphasi</para>
  <para style="q1" vid="PSA 7:14">ayi butidi mambu ma luvunu.<verse eid="PSA 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>Niandi wukaba dibulu ; wudikulula dimula</para>
  <para style="q1" vid="PSA 7:15">ayi wubua mu dibulu di kakaba niandi veka.<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>Ziphasi ziozi kakubika zimbuididi niandi veka</para>
  <para style="q1" vid="PSA 7:16">ayi tsitꞌandi yibuidi va dikosi diandi.<verse eid="PSA 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>Ndiela vutudila Yave matondo mu diambu di busonga buandi.</para>
  <para style="q1" vid="PSA 7:17">Ayi ndiela yimbidila nzitusu wu dizina di Yave wuzangama.<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="cl">Minkunga 8</para>
  <para style="s1">Bunneni bu Nzambi ayi bunneni bu mutu</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi mu ngitala yi basi Ngati.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1"/>Yave, Pfumu eto !</para>
  <para style="q1" vid="PSA 8:1">Tala buevi dizina diaku didi di nzitusu va ntoto wumvimba.</para>
  <para style="q1" vid="PSA 8:1">Ngeyo wutula nkemboꞌaku viokila diyilu.<verse eid="PSA 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>Mu bididi bi bana balezi ayi bi bana batsombi,</para>
  <para style="q1" vid="PSA 8:2">ngeyo wutuma mu totukila nzitusu</para>
  <para style="q1" vid="PSA 8:2">mu diambu di bambeni ziaku ;</para>
  <para style="q1" vid="PSA 8:2">mu diambu di kanga miunu mi bobo beti ku lenda,</para>
  <para style="q1" vid="PSA 8:2">ayi mutu wowo wumvutulanga mambimbi mu mambimbi.<verse eid="PSA 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>Bu ndieti tala diyilu diaku, kisalu ki minlembo miaku,</para>
  <para style="q1" vid="PSA 8:3">ngonda ayi zimbuetete ziozi wutula va buangu ;<verse eid="PSA 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4"/>buna mbi biobi mutu mu diambu wuntebukilanga moyo,</para>
  <para style="q1" vid="PSA 8:4">ayi muana mutu mu diambu wumbelanga mayindu e ?<verse eid="PSA 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>Ngeyo wumvanga kaba fioti ku tsi bivangu bi diyilu<note caller="+" style="f"><char style="fr" closed="false">8.5 </char><char style="ft" closed="false">Tsekodolo yinkaka : Nzambi.</char></note></para>
  <para style="q1" vid="PSA 8:5">ayi ngeyo wumvuika nkembo ayi nzitusu,<verse eid="PSA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>Ngeyo wunkitula nyadi mu</para>
  <para style="q1" vid="PSA 8:6">bisalu bi mioko miaku,</para>
  <para style="q1" vid="PSA 8:6">ngeyo wutula bima bioso ku tsi malu mandi :<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>mamemi moso ayi zingombi zioso ;</para>
  <para style="q1" vid="PSA 8:7">bibulu bioso binsitu,<verse eid="PSA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8"/>zinuni zi yilu ayi zimbizi zi mbu,</para>
  <para style="q1" vid="PSA 8:8">bibioso bindiatilanga mu minsolo mi mbu.<verse eid="PSA 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>A Yave, Pfumu eto !</para>
  <para style="q1" vid="PSA 8:9">Tala buevi dizina diaku didi di nzitusu va ntoto wumvimba.<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="cl">Minkunga 9</para>
  <para style="s1">Nzambi wuzenga nkanu mu busonga</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi mu lufua lu muana.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1"/>Ndiela kuzitisa, a Yave, mu ntimꞌama wumvimba.</para>
  <para style="q1" vid="PSA 9:1">Ndiela yamikisa matsiminanga maku moso.<verse eid="PSA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>Ndiela mona khini ayi ndiela sakadala mu ngeyo,</para>
  <para style="q1" vid="PSA 9:2">Ndiela yimbidila nzitusu mu diambu di dizina diaku,</para>
  <para style="q1" vid="PSA 9:2">ngeyo Nzambi wuzangama.<verse eid="PSA 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>Bambeni ziama balembo vutukisa ku manima,</para>
  <para style="q1" vid="PSA 9:3">balembo bumina zithutu ayi balembo bungana</para>
  <para style="q1" vid="PSA 9:3">va ntualꞌaku.<verse eid="PSA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>Bila ngeyo wunzengidi nkanu mu busonga, wudedisidi mambu mama ;</para>
  <para style="q1" vid="PSA 9:4">ngeyo wuvuendi va kundu kiaku ki kipfumu mu sambisa mu busonga.<verse eid="PSA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>Ngeyo wutemina makanda,</para>
  <para style="q1" vid="PSA 9:5">wubunga mutu wumbimbi,</para>
  <para style="q1" vid="PSA 9:5">wukubula mvimba mazina mawu mu zithangu zioso.<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>Mbivusu yikambulu tsukulu yibuididi bambeni ;</para>
  <para style="q1" vid="PSA 9:6">wutiolumuna mavula mawu</para>
  <para style="q1" vid="PSA 9:6">ayi malendi buela tebukulu moyo ko.<verse eid="PSA 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>Yave wunyalanga mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 9:7">wukubika kundu kiandi ki kipfumu mu diambu di sambisa.<verse eid="PSA 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>Wela sambisa nza mu busonga,</para>
  <para style="q1" vid="PSA 9:8">wela yadila batu mu bufuana.<verse eid="PSA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>Yave niandi suamunu ki mutu weti yamusu ;</para>
  <para style="q1" vid="PSA 9:9">suamunu kingolo mu thangu yi ziphasi.<verse eid="PSA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10"/>Babo bazebi dizina diaku,</para>
  <para style="q1" vid="PSA 9:10">bela tula diana diawu mu ngeyo.</para>
  <para style="q1" vid="PSA 9:10">Bila ngeyo, Yave, wuyekulanga ko</para>
  <para style="q1" vid="PSA 9:10">bobo bakutombanga.<verse eid="PSA 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11"/>Luyimbidila Yave minzitusu mutu wowo wukala ku Sioni ;</para>
  <para style="q1" vid="PSA 9:11">yamikisanu mambu mandi kavanga muidi makanda.<verse eid="PSA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12"/>Bila mutu wowo wumvutulanga landi mu diambu di menga matengolo</para>
  <para style="q1" vid="PSA 9:12">wuntebukanga moyo ;</para>
  <para style="q1" vid="PSA 9:12">kazimbakananga ko yamikina ku batu badi mu phasi.<verse eid="PSA 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13"/>A Yave, tala buevi bambeni ziama</para>
  <para style="q1" vid="PSA 9:13">balembo ndiamisa</para>
  <para style="q1" vid="PSA 9:13">wumboni kiadi</para>
  <para style="q1" vid="PSA 9:13">ayi wundanguna mu mielo mi lufua.<verse eid="PSA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14"/>Muingi ndiyamikisa minzitusu miaku</para>
  <para style="q1" vid="PSA 9:14">mu mielo mi muana ndumba wu Sioni,</para>
  <para style="q1" vid="PSA 9:14">muingi ndimona khini mu phulusu aku.<verse eid="PSA 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>Makanda mabuidi mu dibulu dinneni diodi bakaba ;</para>
  <para style="q1" vid="PSA 9:15">malu mawu mabakini mu dikondi diodi batamba.<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>Yave wukimonikisidi, mu busonga buandi ;</para>
  <para style="q1" vid="PSA 9:16">mutu wumbimbi wukangimini</para>
  <para style="q1" vid="PSA 9:16">mu mavanga ma mioko miandi.<verse eid="PSA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>Batu bambimbi balembo vutuki ku tsi bafua,</para>
  <para style="q1" vid="PSA 9:17">makanda moso momo mazimbakana Nzambi.<verse eid="PSA 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>Vayi nsukami kalendi tumbu zimbukunu ko</para>
  <para style="q1" vid="PSA 9:18">ayi diana di batu badi mu phasi dilendi tumbu lalakana ko.<verse eid="PSA 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>A Yave, telama !</para>
  <para style="q1" vid="PSA 9:19">Bika mutu kabika nunga !</para>
  <para style="q1" vid="PSA 9:19">Bika makanda masambusu va meso maku.<verse eid="PSA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>A Yave, wubabuisila tsisi !</para>
  <para style="q1" vid="PSA 9:20">Bika makanda mazaba ti badi kaka batu.<verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="cl">Minkunga 10</para>
  <para style="s1">A Pfumu, bila mbi telimini thama</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>Bila mbi ngeyo Yave telimini thama e ?</para>
  <para style="q1" vid="PSA 10:1">Bila mbi wididi wusuama mu thangu ziphasi e ?<verse eid="PSA 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>Mu lunangu luandi, mutu wumbimbi</para>
  <para style="q1" vid="PSA 10:2">wulembo landakana mutu wulebakana ;</para>
  <para style="q1" vid="PSA 10:2">bobo babuilamanga mu makani momo kakubikidi.<verse eid="PSA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>Bila mutu wumbimbi wulembo kiniemisa mu nzinunu zi ntima andi ;</para>
  <para style="q1" vid="PSA 10:3">ayi wulembo sakumuna nkua lukokoto,</para>
  <para style="q1" vid="PSA 10:3">wulembo lenzi Yave.<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>Mu luniemo luandi, mutu wumbimbi kantombanga ko.</para>
  <para style="q1" vid="PSA 10:4">Mu mayindu mandi, Nzambi kasi kadi buangu ko.<verse eid="PSA 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>Mu zithangu zioso, zinzila ziandi zidi zimboti</para>
  <para style="q1" vid="PSA 10:5">widi nkua lunangu</para>
  <para style="q1" vid="PSA 10:5">ayi mina miaku midi mitatuka kuidi niandi ;</para>
  <para style="q1" vid="PSA 10:5">wunsekininanga bambeni bandi zioso.<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>Wuniungutanga mu ntimꞌandi :</para>
  <para style="q1" vid="PSA 10:6">“Kuisi ko diambu dilenda ku ndikuna ;</para>
  <para style="q1" vid="PSA 10:6">Ndidi mu khini mu zithangu zioso ayi ndilendi ba mu phasi ko.”<verse eid="PSA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>Munu andi wuwedi tsingulu,</para>
  <para style="q1" vid="PSA 10:7">luvunu ayi buivi.</para>
  <para style="q1" vid="PSA 10:7">Ku tsi ludimi luandi kuidi ziphasi ayi mambimbi.<verse eid="PSA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>Wumfielanga mu ndambu mala.</para>
  <para style="q1" vid="PSA 10:8">Wumvondanga mutu kambulu zaba diambu mu bibuangu bisuama,</para>
  <para style="q1" vid="PSA 10:8">meso mandi manfielanga mu kinsueki bobo katidi vanga mbimbi.<verse eid="PSA 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9"/>Wumfielanga banga bumfiedilanga khosi bu kadi mu nsuku</para>
  <para style="q1" vid="PSA 10:9">wumfielanga mu diambu di buila batu bakambulu lusadusu.<verse eid="PSA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>Weti kuba kosikisa, bawu beti tumbu vonga ;</para>
  <para style="q1" vid="PSA 10:10">beti bua ku tsi zingolo ziandi.<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>Wuniungutanga mu ntimꞌandi :</para>
  <para style="q1" vid="PSA 10:11">“Nzambi zimbikini, fukidi zizi kiandi</para>
  <para style="q1" vid="PSA 10:11">ayi kalendi mona ko.”<verse eid="PSA 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>A Yave Nzambi, telama, vumuna koko kuaku ;</para>
  <para style="q1" vid="PSA 10:12">kadi zimbakana batu bakambulu lusadusu !<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>Bila mbi mutu wumbimbi keti lenzila Nzambi e ?</para>
  <para style="q1" vid="PSA 10:13">Bila mbi kalembo niungutina mu ntimꞌandi :</para>
  <para style="q1" vid="PSA 10:13">“Kalendi tomba ko ti ndimvumbudila kipholo”<verse eid="PSA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>Muaki ngeyo Nzambi,</para>
  <para style="q1" vid="PSA 10:14">wulembo moni ziphasi ayi mabienga ;</para>
  <para style="q1" vid="PSA 10:14">Wulembo tadi mawu muingi wumatula va koko kuaku.</para>
  <para style="q1" vid="PSA 10:14">Nkua mabienga wukukiyekulanga kuidi ngeyo ;</para>
  <para style="q1" vid="PSA 10:14">ngeyo nsadisi wu muana sana.<verse eid="PSA 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>Kelula koko ku mutu wumbimbi</para>
  <para style="q1" vid="PSA 10:15">ayi ku mutu weti vanga mambimbi,</para>
  <para style="q1" vid="PSA 10:15">nkambi kavumbudila kipholo mu mambimbi mandi ;</para>
  <para style="q1" vid="PSA 10:15">nate wela kambu buela ku mamona.<verse eid="PSA 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>Yave niandi ntinu mu zithangu zioso</para>
  <para style="q1" vid="PSA 10:16">ayi mu thangu yi kayimani</para>
  <para style="q1" vid="PSA 10:16">Makanda mela bungana mu tsi andi.<verse eid="PSA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>A Yave, ngeyo weti wa zitsatu zi batu badi mu phasi.</para>
  <para style="q1" vid="PSA 10:17">Weti kuba kindisa ;</para>
  <para style="q1" vid="PSA 10:17">ayi dimba yamikina kuawu.<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>Mu diambu di nuanisa muana sana</para>
  <para style="q1" vid="PSA 10:18">ayi mutu weti yamusu muingi mutu widi va ntoto</para>
  <para style="q1" vid="PSA 10:18">kabika monisa tsisi.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="cl">Minkunga 11</para>
  <para style="s1">Suamunu ki kiedika</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1"/>Kuidi Yave ndintombilanga suamunu.</para>
  <para style="q1" vid="PSA 11:1">Buevi lulenda ku khambila :</para>
  <para style="q1" vid="PSA 11:1">“Tinina ku miongo miaku banga bu ntininanga nuni.”<verse eid="PSA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2"/>Bila tala, batu bambimbi balembo leki mimbasa ;</para>
  <para style="q1" vid="PSA 11:2">ayi balembo ludika zitsoto va nsinga</para>
  <para style="q1" vid="PSA 11:2">mi mimbasa muingi babasula, bu badi mu tombi,</para>
  <para style="q1" vid="PSA 11:2">batu bobo badi mintima mi lulama.<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>Enati zifundasio zitiolumunu,</para>
  <para style="q1" vid="PSA 11:3">buna mutu wusonga, mbi kalenda vanga e ?<verse eid="PSA 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>Yave widi mu nzoꞌandi yinlongo !</para>
  <para style="q1" vid="PSA 11:4">Yave, kundu kiandi ki luyalu kidi ku diyilu,</para>
  <para style="q1" vid="PSA 11:4">meso mandi malembo tadi ayi zindabu ziandi</para>
  <para style="q1" vid="PSA 11:4">zimfionguninanga bana ba batu.<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>Yave wumfionguninanga mutu wusonga</para>
  <para style="q1" vid="PSA 11:5">vayi muelꞌandi weti lenda mutu wumbimbi</para>
  <para style="q1" vid="PSA 11:5">ayi mutu wowo wunzolanga matsita.<verse eid="PSA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>Wunokisanga makala ayi sofolo yi mbazu.</para>
  <para style="q1" vid="PSA 11:6">Kuidi batu bambimbi,</para>
  <para style="q1" vid="PSA 11:6">Phemo yi mbazu yawu kopo yi ziphasi bela kabana.<verse eid="PSA 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>Bila Yave widi wusonga, wunzolanga masonga.</para>
  <para style="q1" vid="PSA 11:7">Batu badi mintima mi lulama</para>
  <para style="q1" vid="PSA 11:7">bela talanga zizi kiandi.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="cl">Minkunga 12</para>
  <para style="s1">Nzambi wundedikisanga zitsila ziandi</para>
  <para style="d">Nkunga Davidi kayimbidila mu ngitala yi nana di zitsinga kuidipfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1"/>A Yave, yiza sadisa bila batu beti kinzika</para>
  <para style="q1" vid="PSA 12:1">mambu ma Nzambi basiedi ko.</para>
  <para style="q1" vid="PSA 12:1">Mikhuikizi mizimbidi va khatitsika yi bana ba batu.<verse eid="PSA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>Kadika mutu wulembo vuni fikimini yandi.</para>
  <para style="q1" vid="PSA 12:2">Mambu ma lueki madi mu bididi biawu</para>
  <para style="q1" vid="PSA 12:2">vayi mintima miodi badi sumbu bantuba.<verse eid="PSA 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>Bika Yave kabunga bididi bioso</para>
  <para style="q1" vid="PSA 12:3">bintubanga mambu ma lueki</para>
  <para style="q1" vid="PSA 12:3">ayi ludimi luntubanga mambu mu luniemo.<verse eid="PSA 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>Batu bobo bantubanga :</para>
  <para style="q1" vid="PSA 12:4">“Tuela nunga mu diambu di ludimi lueto,</para>
  <para style="q1" vid="PSA 12:4">bididi bieto bidi bieto veka ;</para>
  <para style="q1" vid="PSA 12:4">nani wulenda ba Pfumu eto ?”<verse eid="PSA 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>Bila mu diambu di yamusu ku batu balebakana,</para>
  <para style="q1" vid="PSA 12:5">ayi kunga ku nsukami ;</para>
  <para style="q1" vid="PSA 12:5">diawu Yave kakembi buabu :</para>
  <para style="q1" vid="PSA 12:5">“Buabu ndieka ntelama,</para>
  <para style="q1" vid="PSA 12:5">ndieka kuba kaka mu diambu di mutu balembo kuba yamisa.”<verse eid="PSA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>Mambu ma Yave madi mavedila banga palata</para>
  <para style="q1" vid="PSA 12:6">kioki bavedisidi mu mbazu,</para>
  <para style="q1" vid="PSA 12:6">kivedosolo mu tsambuadi di zikhumbu.<verse eid="PSA 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>Yave ngeyo wela kutu keba mu luvovomo</para>
  <para style="q1" vid="PSA 12:7">wela kutu kaka mu diambu di ntindu wu batu baba,</para>
  <para style="q1" vid="PSA 12:7">mu thangu yi kayimani.<verse eid="PSA 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>Batu bambimbi beti vemanga muamo</para>
  <para style="q1" vid="PSA 12:8">mu thangu bifu bi mbimbi bieti yayusu</para>
  <para style="q1" vid="PSA 12:8">va khatitsika batu.<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="cl">Minkunga 13</para>
  <para style="s1">Tsisi ayi diana</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1"/>A Yave, nate thangu mbi wela tatamana kunzimbakana mu zithangu zioso e ?</para>
  <para style="q1" vid="PSA 13:1">Nate thangu mbi wela kutsuekilanga zizi kiaku e ?<verse eid="PSA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>Nate thangu mbi ndiela kukinuanisanga</para>
  <para style="q1" vid="PSA 13:2">mu mayingu mama e ?</para>
  <para style="q1" vid="PSA 13:2">Nate thangu mbi ndiela bela maniongo mu ntimꞌama mu kadika lumbu e ?</para>
  <para style="q1" vid="PSA 13:2">Nate thangu mbi mbeni ama kela ku ndunginanga e ?<verse eid="PSA 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>A Yave, Nzambi ama, wuthadi ayi wuphana mvutu,</para>
  <para style="q1" vid="PSA 13:3">kienzula meso mama mu diambu ndibika</para>
  <para style="q1" vid="PSA 13:3">leka tulu tu lufua,<verse eid="PSA 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>mu diambu mbeni ama kabika tuba :</para>
  <para style="q1" vid="PSA 13:4">“Ndinnungini” ayi muingi batu beti kundenda babika mona khini</para>
  <para style="q1" vid="PSA 13:4">minu bua.<verse eid="PSA 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>Vayi minu tsidi diana mu luzolo luaku lungolo.</para>
  <para style="q1" vid="PSA 13:5">Ntimꞌama wulembo moni khini</para>
  <para style="q1" vid="PSA 13:5">mu phulusu aku.</para>
  <para style="q1" vid="PSA 13:5">Ndiela yimbidila Yave bila niandi wuphangidi mamboti.<verse eid="PSA 13:5"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="cl">Minkunga 14</para>
  <para style="s1">Nza yidi yi biva</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1"/>Nkua buvulu wuntubanga mu ntimꞌandi ti :</para>
  <para style="q1" vid="PSA 14:1">Kuisiko Nzambi !</para>
  <para style="q1" vid="PSA 14:1">Baki bivisidi,</para>
  <para style="q1" vid="PSA 14:1">mavanga mawu madi mambimbi ;</para>
  <para style="q1" vid="PSA 14:1">kuisiko mutu wumvanganga mamboti.<verse eid="PSA 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>Yave, ku yilu ku kadi, wulembo tadi bana</para>
  <para style="q1" vid="PSA 14:2">ba batu mu tala kani wulenda mona wumosi wunsundika,</para>
  <para style="q1" vid="PSA 14:2">kani wumosi wuntombanga Nzambi.<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>Baboso bavengama ayi bamana kibivisa va kimosi ;</para>
  <para style="q1" vid="PSA 14:3">kuisiko mutu wumvanganga mamboti,</para>
  <para style="q1" vid="PSA 14:3">kadi mutu wumosi.<verse eid="PSA 14:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>Batu boso bamvanganga mambu mambimbi basi nzayilu ko e ?</para>
  <para style="q1" vid="PSA 14:4">Bobo balembo dia batu bama, banga batu bandia dipha</para>
  <para style="q1" vid="PSA 14:4">ayi bobo batelanga dizina di Yave ko.<verse eid="PSA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>Buna kuna bela tita mu diambu di tsisi</para>
  <para style="q1" vid="PSA 14:5">bila Nzambi widi va khatitsika</para>
  <para style="q1" vid="PSA 14:5">dikabu di batu basonga.<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>Beno mimvangi mi mambimbi,</para>
  <para style="q1" vid="PSA 14:6">lulenda vunza zikhanu zi nsukami.</para>
  <para style="q1" vid="PSA 14:6">Vayi Yave niandi suamunu kiandi.<verse eid="PSA 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>A enati phulusu yi Iseli</para>
  <para style="q1" vid="PSA 14:7">yitotukila ku Sioni !</para>
  <para style="q1" vid="PSA 14:7">Mu thangu Yave kela vutula kiuka ki batu bandi</para>
  <para style="q1" vid="PSA 14:7">Bika Yakobi kamona khini ayi Iseli kayangadala.<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="cl">Minkunga 15</para>
  <para style="s1">Nani wulenda zinga ayi Nzambi</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1"/>A Yave, nani wulenda vuanda mu nzo aku yi ngoto e ?</para>
  <para style="q1" vid="PSA 15:1">Nani wulenda zinga ku mongo aku wunlongo e ?<verse eid="PSA 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>Woso mutu wundiatanga mu kambu tsembolo,</para>
  <para style="q1" vid="PSA 15:2">wumvanganga mambu ma busonga</para>
  <para style="q1" vid="PSA 15:2">ayi wuntubanga mambu ma kiedika</para>
  <para style="q1" vid="PSA 15:2">mantotukanga mu ntimꞌandi.<verse eid="PSA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3"/>Katubidilanga ko batu mu ludimi luandi ;</para>
  <para style="q1" vid="PSA 15:3">Kavangilanga ndiandi mambimbi ko</para>
  <para style="q1" vid="PSA 15:3">ayi kabivisanga nzitusu wu ndiandi ko.<verse eid="PSA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4"/>Weti lenza mutu weti vanga mambimbi</para>
  <para style="q1" vid="PSA 15:4">Vayi wunzitisanga bobo bankinzikanga Yave.</para>
  <para style="q1" vid="PSA 15:4">Wunkebanga zindefi ziandi.</para>
  <para style="q1" vid="PSA 15:4">Ka diambu ko yela kummonisa phasi.<verse eid="PSA 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5"/>Katombanga ndandu ko va yilu zimbongo</para>
  <para style="q1" vid="PSA 15:5">ziozi kadevisa.</para>
  <para style="q1" vid="PSA 15:5">Ayi kakikininanga ko makaba mu diambu di</para>
  <para style="q1" vid="PSA 15:5">bedisa mutu kambulu zaba diambu.</para>
  <para style="q1" vid="PSA 15:5">Woso wumvanganga mambu momo</para>
  <para style="q1" vid="PSA 15:5">kalendi nikunu ko.<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="cl">Minkunga 16</para>
  <para style="s1">Nzila yi luzingu</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1"/>A Nzambi, wukheba mu luvovomo</para>
  <para style="q1" vid="PSA 16:1">bila kuidi ngeyo nditombila suamunu.<verse eid="PSA 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>Kuidi Yave ndituba :</para>
  <para style="q1" vid="PSA 16:2">“Ngeyo Pfumu ama,</para>
  <para style="q1" vid="PSA 16:2">kuidi ngeyo kaka kueti banga mamboti mama.”<verse eid="PSA 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>Mu diambu di banlongo bobo badi mu tsi ;</para>
  <para style="q1" vid="PSA 16:3">bawu batu banzitusu.</para>
  <para style="q1" vid="PSA 16:3">Khini yiwombo baku mbonisanga.<verse eid="PSA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>Bobo banlandakananga zinzambi zinkaka</para>
  <para style="q1" vid="PSA 16:4">kiadi kiawu kiela buelama,</para>
  <para style="q1" vid="PSA 16:4">voti ndilendi tambika makaba mawu ma menga ko,</para>
  <para style="q1" vid="PSA 16:4">Ndilendi tanga mazina mawu mu bididi biama ko.<verse eid="PSA 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>Yave ngeyo wuphana ndambu yi kiuka kiama,</para>
  <para style="q1" vid="PSA 16:5">ayi mbungu ama,</para>
  <para style="q1" vid="PSA 16:5">ngeyo wunkebanga kuku kiama mu luvovomo.<verse eid="PSA 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>Zindili zikubuku mu diambu diama mu buangu bidi kitoko ;</para>
  <para style="q1" vid="PSA 16:6">bukiedika, thambudi kiuka ki mboti.<verse eid="PSA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>Ndiela zitisa Yave ;</para>
  <para style="q1" vid="PSA 16:7">wukuphananga malongi</para>
  <para style="q1" vid="PSA 16:7">ntimꞌama wukundonganga mu builu,<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>Ndieti tula Yave ku ntualꞌama mu zithangu zioso</para>
  <para style="q1" vid="PSA 16:8">bila widi ku koko kuama ku lubakala,</para>
  <para style="q1" vid="PSA 16:8">ndilendi nikuka ko.<verse eid="PSA 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>Diawu ntimꞌama wididi mu khini ;</para>
  <para style="q1" vid="PSA 16:9">ludimi luama lueti yangalala</para>
  <para style="q1" vid="PSA 16:9">ayi nitu ama yela vunda mu luvovomo ;<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>Bila ngeyo wulendi kundiekula ko</para>
  <para style="q1" vid="PSA 16:10">ku tsi bafua,</para>
  <para style="q1" vid="PSA 16:10">ayi wulendi tala ko mutu aku wunlongo kabola.<verse eid="PSA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>Ngeyo wumbonisa nsolo wu luzingu ;</para>
  <para style="q1" vid="PSA 16:11">zikhini ziwombo zidi va ntuala zizi kiaku.</para>
  <para style="q1" vid="PSA 16:11">Wela kumbonisa khini va meso maku</para>
  <para style="q1" vid="PSA 16:11">va kimosi ayi zikhini zika zisukanga ko zidi va koko kuaku ku lubakala.<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="cl">Minkunga 17</para>
  <para style="s1">Wulandukunu mu kambu bila</para>
  <para style="d">Lusambulu lu Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1"/>Yave wa mambu ma busonga bu ndieti samba ;</para>
  <para style="q1" vid="PSA 17:1">dimba yamikina kuama ;</para>
  <para style="q1" vid="PSA 17:1">tamba kutu mu lusambulu luama</para>
  <para style="q1" vid="PSA 17:1">lueti totukila mu bididi bikambulu luvunu.<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>Bika ndungunu ama yitotukila kuidi ngeyo</para>
  <para style="q1" vid="PSA 17:2">ayi bika meso maku mamona momo madi ma lulama.<verse eid="PSA 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>Ka diambu ko tidi fiongunina ntimꞌama,</para>
  <para style="q1" vid="PSA 17:3">ayi kuthala va builu</para>
  <para style="q1" vid="PSA 17:3">ka diambu ko wumbekini, mu mbazu wulendi mona kadi kiasa ko.</para>
  <para style="q1" vid="PSA 17:3">Ndibaka lukanu ti munu ama</para>
  <para style="q1" vid="PSA 17:3">wulendi sumuka ko.<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>Mu diambu di mavanga ma batu ;</para>
  <para style="q1" vid="PSA 17:4">mu nzila yi mambu ma bididi biaku,</para>
  <para style="q1" vid="PSA 17:4">ndieti kukikeba mu nzila yi mutu widi matsita.<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>Bitambi biama bidi kaka bikinda</para>
  <para style="q1" vid="PSA 17:5">mu minsolo miaku,</para>
  <para style="q1" vid="PSA 17:5">malu mama malendi sialumuka ko.<verse eid="PSA 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>A Nzambi, ndikutela bila ngeyo wela kuphana mvutu.</para>
  <para style="q1" vid="PSA 17:6">Yinika dikutu diaku ku ndidi</para>
  <para style="q1" vid="PSA 17:6">ayi wa lusambulu luama.<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>Monisa matsiminanga ma luzolo luaku lunneni,</para>
  <para style="q1" vid="PSA 17:7">ngeyo wuphukisanga mu koko kuaku ku lubakala</para>
  <para style="q1" vid="PSA 17:7">bobo bansuaminanga mu ngeyo,</para>
  <para style="q1" vid="PSA 17:7">mu bobo bakubalendanga.<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>Wukheba banga ngengele yi dieso diaku ;</para>
  <para style="q1" vid="PSA 17:8">wutsueki ku tsi kitsusula ki mavavi maku,<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>mu diambu di batu bambimbi beti kundiamisa,</para>
  <para style="q1" vid="PSA 17:9">mu diambu di bambeni ziama zieti kunzungidila ;</para>
  <para style="q1" vid="PSA 17:9">ziosi zintomba lufua luama.<verse eid="PSA 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>Bakikangidi mintima miawu midi banga matadi ;</para>
  <para style="q1" vid="PSA 17:10">Miunu miawu mintubanga mambu ma lunanga.<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>Balembo ndandakana,</para>
  <para style="q1" vid="PSA 17:11">banzungididi buabu ; balembo tadi</para>
  <para style="q1" vid="PSA 17:11">mu diambu bambuisa va tsi.<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>Badedikini banga khosi yidi nzala kanzuna,</para>
  <para style="q1" vid="PSA 17:12">banga khosi yiyunduka yidi yilambididi va buangu kisuama.<verse eid="PSA 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>Telama, Yave, wuba nuanisa</para>
  <para style="q1" vid="PSA 17:13">ayi bika wuba buisa,</para>
  <para style="q1" vid="PSA 17:13">wukhula mu sabala kiaku ;</para>
  <para style="q1" vid="PSA 17:13">mu mutu wumbimbi.<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>A Yave, bika wuphukisa mu koko kuaku mu batu ba phila yayi ;</para>
  <para style="q1" vid="PSA 17:14">batu ba ntoto wawu ; bobo mfutu awu widi mu luzingu lualu.</para>
  <para style="q1" vid="PSA 17:14">Weti lembika nzala yi bobo weti zola</para>
  <para style="q1" vid="PSA 17:14">bana bawu babeki biwombo,</para>
  <para style="q1" vid="PSA 17:14">ayi balundila bana bawu batsombi kimvuama.<verse eid="PSA 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>Vayi minu, ndiela mona zizi kiaku mu busonga.</para>
  <para style="q1" vid="PSA 17:15">Bu ndiela kotuka ndiela yukuta mu talanga mfikulꞌaku.<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="cl">Minkunga 18</para>
  <para style="s1">Matondo bu wukhula</para>
  <para style="d">Nkunga Davidi, kisadi ki Yave, kuidi Pfumu minyimbidi. Wuyimbila nkunga wawu mu diambu di Yave mu thangu Yave kankula mu mioko mi bambeni bandi ayi mu mioko mi Sawuli.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1"/>Yave, ndikuzolanga, ngeyo zingolo ziama.<verse eid="PSA 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>A Yave, niandi ditadi diama,</para>
  <para style="q1" vid="PSA 18:2">tinunu kiama ki ngolo,</para>
  <para style="q1" vid="PSA 18:2">ayi ngeyo nkudi ama.</para>
  <para style="q1" vid="PSA 18:2">Nzambi ama, niandi ditadi diama ;</para>
  <para style="q1" vid="PSA 18:2">mu niandi ndintombila suamunu,</para>
  <para style="q1" vid="PSA 18:2">niandi nkaku ama, ayi phoka yi phulusu ama,</para>
  <para style="q1" vid="PSA 18:2">ayi tinunu kiama ki zangama.<verse eid="PSA 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>Ndiela tela Yave, niandi fueni mu zitusu</para>
  <para style="q1" vid="PSA 18:3">ayi ndiela vuka mu bambeni ziama.<verse eid="PSA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>Minsinga mi lufua mimfietikisa.</para>
  <para style="q1" vid="PSA 18:4">Bosi khuka nlangu yimbunganga yimbuila mu kinzimbukila.<verse eid="PSA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>Minsinga mi tsi bafua minzingalakana.</para>
  <para style="q1" vid="PSA 18:5">Mintambu mi lufua mi lekama ku ntualꞌama.<verse eid="PSA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>Mu ziphasi ziama, nditela Yave</para>
  <para style="q1" vid="PSA 18:6">Ndiyamikina kuidi Nzambi ama mu tomba lusadusu</para>
  <para style="q1" vid="PSA 18:6">wuwa mbemboꞌama tona kuna nzoꞌandi,</para>
  <para style="q1" vid="PSA 18:6">ayi yamikina kuama kutula va ntualꞌandi,</para>
  <para style="q1" vid="PSA 18:6">mu matu mandi.<verse eid="PSA 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>Buna ntoto wunikuka ayi wutita.</para>
  <para style="q1" vid="PSA 18:7">Zifondasio zi miongo zinikunu</para>
  <para style="q1" vid="PSA 18:7">ayi zinikuka, bila wuba wufuema ngolo.<verse eid="PSA 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>Muisi wutotuka mu mayilu mandi,</para>
  <para style="q1" vid="PSA 18:8">ayi mbazu yi nlalikisanga yitotuka mu munuꞌandi ;</para>
  <para style="q1" vid="PSA 18:8">muawu mu totukila makala ma mbazu.<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>Wukulula diyilu ayi wukuluka,</para>
  <para style="q1" vid="PSA 18:9">ayi matuti ma ndombe maba ku tsi malu mandi.<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>Wukuma va yilu kheluba ayi wudumuka.</para>
  <para style="q1" vid="PSA 18:10">Wuvevumuka va yilu mavavi ma phemo.<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>Wukitula tombi buangu kiandi kisuamina ;</para>
  <para style="q1" vid="PSA 18:11">kapu andi yiba kunzungidila,</para>
  <para style="q1" vid="PSA 18:11">tombi kinokisa mvula yi matuti ma diyilu.<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>Mu kiezila kiba va ntualꞌandi mutotukila matuti,</para>
  <para style="q1" vid="PSA 18:12">mvula yi matadi ayi zitsiemo.<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>Yave wuduma tona mu Diyilu ;</para>
  <para style="q1" vid="PSA 18:13">mbembo yi Nzambi yizangama yiwakakana<note caller="+" style="f"><char style="fr" closed="false">18.13 </char><char style="ft" closed="false">Minkanda minkaka mibuela mvula yi matadi yinoka, makala ma mbazu madoduka.</char></note>.<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>Niandi wuloza madionga mandi</para>
  <para style="q1" vid="PSA 18:14">ayi wusasikisa bambeni ;</para>
  <para style="q1" vid="PSA 18:14">zitsiemo zinneni</para>
  <para style="q1" vid="PSA 18:14">ayi wuba zimbikisa nzila.<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>Tsi nlangu yi mbu yimonika,</para>
  <para style="q1" vid="PSA 18:15">ayi zifondasio zi ntoto zimonika</para>
  <para style="q1" vid="PSA 18:15">ngeyo Yave bu wutema mu phemo yitotukila mu mayilu maku.<verse eid="PSA 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>Wunonuna koko kuandi tona ku yilu</para>
  <para style="q1" vid="PSA 18:16">ayi wutsimba,</para>
  <para style="q1" vid="PSA 18:16">wuthotula mu minlangu minneni midi thipula.<verse eid="PSA 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>Niandi wukhula mu mbeni ama yingolo,</para>
  <para style="q1" vid="PSA 18:17">ayi mu batu bobo bandenda</para>
  <para style="q1" vid="PSA 18:17">bila bawu bandutila ngolo.<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>Bawu banduanisa mu lumbu ki ndiba mu mabienga,</para>
  <para style="q1" vid="PSA 18:18">vayi Yave niandi wuba singumunu kiama.<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>Niandi wuthotula ayi wuthula va buangu kikambulu tsisi ;</para>
  <para style="q1" vid="PSA 18:19">wukhula bila khini kaba monanga mu minu.<verse eid="PSA 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>Yave wuphangidi bobo boso buididi busonga buama ;</para>
  <para style="q1" vid="PSA 18:20">wupheni mfutu boso buididi vedila ku mioko miama<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>Bila ndikebidi zinzila zi Yave</para>
  <para style="q1" vid="PSA 18:21">ayi ndisia tamba Nzambi ama mbusa ko</para>
  <para style="q1" vid="PSA 18:21">mu diambu di vanga mambimbi.<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>Mina miandi mioso midi va ntualꞌama</para>
  <para style="q1" vid="PSA 18:22">ayi ndisia vengama ko mu zithumunu ziandi.<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>Ndiba mutu wukambu tsembolo va ntualꞌandi</para>
  <para style="q1" vid="PSA 18:23">Ndikikeba mu diambu di masumu.<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>Yave wupheni mfutu boso buididi busonga buama,</para>
  <para style="q1" vid="PSA 18:24">boso buididi vedila ku mioko miama</para>
  <para style="q1" vid="PSA 18:24">va ntuala meso mandi.<verse eid="PSA 18:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>Kuidi mutu widi wukuikama,</para>
  <para style="q1" vid="PSA 18:25">ngeyo wukukimonisanga wukuikama.</para>
  <para style="q1" vid="PSA 18:25">Kuidi mutu wukambulu tsembolo</para>
  <para style="q1" vid="PSA 18:25">ngeyo wukukimonisanga mutu wukambulu tsembolo.<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>Kuidi mutu wuvedila,</para>
  <para style="q1" vid="PSA 18:26">wukukimonisanga wuvedila.</para>
  <para style="q1" vid="PSA 18:26">Kuidi mutu wumbimbi,</para>
  <para style="q1" vid="PSA 18:26">wukukimonisanga wumbimbi.<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>Ngeyo wumvukisanga batu beti kukikula</para>
  <para style="q1" vid="PSA 18:27">ayi wunkululanga meso madi luyanu<note caller="+" style="f"><char style="fr" closed="false">18.27 </char><char style="ft" closed="false">Minsekudi minkaka minsadila luniemo va buangu ki luyalu.</char></note>.<verse eid="PSA 18:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>Ngeyo a Yave, keba muindꞌama wuba wulema</para>
  <para style="q1" vid="PSA 18:28">A Nzambiꞌama, kitula tombi kiama ;</para>
  <para style="q1" vid="PSA 18:28">kikituka kiezila.<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>Mu lusadusu luaku</para>
  <para style="q1" vid="PSA 18:29">ndilenda nuanisa nkangu masodi,</para>
  <para style="q1" vid="PSA 18:29">va kimosi ayi Nzambi ama,</para>
  <para style="q1" vid="PSA 18:29">ndilenda dumuka baka kikunzama.<verse eid="PSA 18:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>Kuidi Nzambi, nzilꞌandi yidi yi fuana,</para>
  <para style="q1" vid="PSA 18:30">mambu ma Yave madi ma kiedika.</para>
  <para style="q1" vid="PSA 18:30">Niandi nkaku wu batu boso bobo</para>
  <para style="q1" vid="PSA 18:30">bansuaminanga mu niandi.<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>Bila nani Nzambi, enati ka Yave ko e ?</para>
  <para style="q1" vid="PSA 18:31">Ayi nani ditadi di ngolo,</para>
  <para style="q1" vid="PSA 18:31">enati ka Nzambi eto ko e ?<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>Nzambi, niandi wukuphananga ngolo</para>
  <para style="q1" vid="PSA 18:32">ayi wunkitulanga nzilꞌama yi fuana.<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>Wunkitulanga malu mama banga malu ma tsesi,</para>
  <para style="q1" vid="PSA 18:33">ayi wukuthelimisanga va bibuangu biama bizangama.<verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>Wunlongisanga mioko miama mu nuana mvita,</para>
  <para style="q1" vid="PSA 18:34">mioko miama milenda leka mbasa wusengo.<verse eid="PSA 18:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>Wuphana nkaku aku wu ndungunu,</para>
  <para style="q1" vid="PSA 18:35">ayi koko kuaku ku lubakala kukhindisa</para>
  <para style="q1" vid="PSA 18:35">ayi wukuluka mu diambu di kukhitula mutu wunneni.<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>Ngeyo wukubikidi nsolo wuyalumuka</para>
  <para style="q1" vid="PSA 18:36">ku tsi bitambi biama,</para>
  <para style="q1" vid="PSA 18:36">muingi bikodi biama bibika visuka.<verse eid="PSA 18:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>Ndikuka bambeni ziama</para>
  <para style="q1" vid="PSA 18:37">ayi ndizibakidila.</para>
  <para style="q1" vid="PSA 18:37">Ndisia vutuka manima ko enati ndisia mana kuzivonda.<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>Ndiba kosikisa ayi basia buela baka bu telimina ko ;</para>
  <para style="q1" vid="PSA 18:38">babua ku tsi malu mama.<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>Ngeyo wuphana zingolo zi nuanina mvita ;</para>
  <para style="q1" vid="PSA 18:39">Ngeyo weti komvika batu beti kundenda</para>
  <para style="q1" vid="PSA 18:39">ku tsi malu mama.<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>Ngeyo wuntinisanga bambeni ziama</para>
  <para style="q1" vid="PSA 18:40">va ntualꞌama</para>
  <para style="q1" vid="PSA 18:40">ayi ndibunga bobo bakundendanga.<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>Bayamikina mu tomba lusadusu,</para>
  <para style="q1" vid="PSA 18:41">vayi kadi mutu mu kuba vukisa.</para>
  <para style="q1" vid="PSA 18:41">Bayamikina kuidi Yave</para>
  <para style="q1" vid="PSA 18:41">vayi kasia ku bavutudila mvutu ko.<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>Ndiba kosikisa banga mbungi-mbungi</para>
  <para style="q1" vid="PSA 18:42">yeti vevumunu kuidi phemo.</para>
  <para style="q1" vid="PSA 18:42">Ndiba loza thama banga nyamba wu zinzila.<verse eid="PSA 18:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>Wukhula mu minzonza mi batu,</para>
  <para style="q1" vid="PSA 18:43">ayi wukhitula ntu wu makanda ;</para>
  <para style="q1" vid="PSA 18:43">batu bobo ndisia zaba ko, bawu ndiela yadila.<verse eid="PSA 18:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44"/>Bu batumbu kungua bathumukina ;</para>
  <para style="q1" vid="PSA 18:44">banzenza zikikulula va ntualꞌama.<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>Zinzenza zilembo vongi,</para>
  <para style="q1" vid="PSA 18:45">balembo titi sumbu bantotuka mu bibuangu biawu bisuama ngolo.<verse eid="PSA 18:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>Yave wulembo zingi</para>
  <para style="q1" vid="PSA 18:46">Nzitusu wuba kuidi ditadi diama</para>
  <para style="q1" vid="PSA 18:46">yayusu kuba kuidi Nzambi Mvulusi ama.<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>Niandi Nzambi wukuphutudilanga landi ;</para>
  <para style="q1" vid="PSA 18:47">ayi wutula makanda ku tsi luyalu luama.<verse eid="PSA 18:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48"/>Wuphukisa mi bambeni ziama,</para>
  <para style="q1" vid="PSA 18:48">Ngeyo wundiayisa va yilu batu bobo bandenda.</para>
  <para style="q1" vid="PSA 18:48">Ngeyo wukhula mu batu ba matsita.<verse eid="PSA 18:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49"/>Diawu ngeyo Yave, ndiela ku zitisa</para>
  <para style="q1" vid="PSA 18:49">va khatitsika makanda.</para>
  <para style="q1" vid="PSA 18:49">Ndiela yimbila minzitusu mu diambu</para>
  <para style="q1" vid="PSA 18:49">di dizina diaku.<verse eid="PSA 18:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>Niandi wuvana ndungunu yinneni</para>
  <para style="q1" vid="PSA 18:50">kuidi ntinu andi</para>
  <para style="q1" vid="PSA 18:50">ayi wummonisanga mamboti mandi ma ngolo kuidi mutu andi kavinda mafuta<note caller="+" style="f"><char style="fr" closed="false">18.50 </char><char style="ft" closed="false">Mutu kavinda mafuta voti kusua ki Yave mu minkanda minkaka.</char></note>,</para>
  <para style="q1" vid="PSA 18:50">kuidi Davidi ayi nkuna andi mu zithangu zioso.<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="cl">Minkunga 19</para>
  <para style="s1">Zitsongolo zizole zi Nzambi</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1"/>Diyilu dieti samuna nkembo wu Nzambi</para>
  <para style="q1" vid="PSA 19:1">ayi matuti meti yamikisa kisalu ki mioko miandi.<verse eid="PSA 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>Kadika Lumbu kinyamikisa mambu beni</para>
  <para style="q1" vid="PSA 19:2">kuidi lumbu kinkaka ;</para>
  <para style="q1" vid="PSA 19:2">ayi builu bumosi bueti ma zabikisa</para>
  <para style="q1" vid="PSA 19:2">kuidi builu bunkaka.<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>Kuisi ko mambu mayoluka voti mambu masadila ;</para>
  <para style="q1" vid="PSA 19:3">Kunkambu wakana zimbembo ziawu.<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>Zimbembo ziawu zieti wakana va ntoto wumvimba.</para>
  <para style="q1" vid="PSA 19:4">Mambu mawu beti yoluka</para>
  <para style="q1" vid="PSA 19:4">meti tula nate ku sukisina nza.</para>
  <para style="q1" vid="PSA 19:4">Ku diyilu katungila nzo yi ngoto</para>
  <para style="q1" vid="PSA 19:4">mu diambu di thangu :<verse eid="PSA 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5"/>Yawu yidi banga dibakala dikuela</para>
  <para style="q1" vid="PSA 19:5">dintotuka va ntuala vinga kiandi,</para>
  <para style="q1" vid="PSA 19:5">banga dikesa, dieti mona khini mu zawula thinu ;<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>Yintotukilanga ku tsongi yi Diyilu,</para>
  <para style="q1" vid="PSA 19:6">bosi ku tsongi yinkaka</para>
  <para style="q1" vid="PSA 19:6">kuawu kamanisinanga nzietolo andi.</para>
  <para style="q1" vid="PSA 19:6">Kuisiko kima kinsuamanga va ntuala diamu diandi.<verse eid="PSA 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>Mina mi Yave midi mifuana,</para>
  <para style="q1" vid="PSA 19:7">mieti vananga diaka muela luzingu</para>
  <para style="q1" vid="PSA 19:7">Zinzengolo zi Yave zidi zi kiedika</para>
  <para style="q1" vid="PSA 19:7">Zinkitulanga mutu wu phamba mutu wu nduenga.<verse eid="PSA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>Minsiku mi Yave midi mi songa,</para>
  <para style="q1" vid="PSA 19:8">minyangidikanga ntima.</para>
  <para style="q1" vid="PSA 19:8">Zithumunu zi Yave zidi zivedila,</para>
  <para style="q1" vid="PSA 19:8">zinkienzulanga meso.<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>Kinzika Yave didi diambu di vedila,</para>
  <para style="q1" vid="PSA 19:9">dieti zingila mu zithangu zioso.</para>
  <para style="q1" vid="PSA 19:9">Zitsikudukusu zi Yave zilenda siwulu diana,</para>
  <para style="q1" vid="PSA 19:9">zizioso zidi zisonga va kimosi ;<verse eid="PSA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>Zilutidi thalu ayi nolo ;</para>
  <para style="q1" vid="PSA 19:10">ayi viokila zinolo ziwombo zivedila</para>
  <para style="q1" vid="PSA 19:10">zilutidi niosi mu lueki ;</para>
  <para style="q1" vid="PSA 19:10">zilutidi yoyi yinkumba mu bisila.<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>Mu ziawu mueti lubukila kisadi kiaku ;</para>
  <para style="q1" vid="PSA 19:11">mfutu wunneni widi mu kuzikebanga.<verse eid="PSA 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>Nani wulenda sudika zinzimbala ziandi e ?</para>
  <para style="q1" vid="PSA 19:12">Lemvukila zinzimbala ziama zisuama.<verse eid="PSA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>Keba kisadi kiaku mu masumu mamvangimina mu luzolo ;</para>
  <para style="q1" vid="PSA 19:13">mabika ku ndiadila ;</para>
  <para style="q1" vid="PSA 19:13">buna ndiela ba wukambu tsembolo ;</para>
  <para style="q1" vid="PSA 19:13">wukambu zaba diambu mu masumu manneni.<verse eid="PSA 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>Bika mambu ma munuꞌama ayi mayindu ma ntimꞌama</para>
  <para style="q1" vid="PSA 19:14">maba ma khini va ntualꞌaku</para>
  <para style="q1" vid="PSA 19:14">A Yave, ditadi diama ayi nkudi ama.<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="cl">Minkunga 20</para>
  <para style="s1">Yave nungisa ntinu eto</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1"/>Bika Yave kavana mvutu bu widi mu ziphasi,</para>
  <para style="q1" vid="PSA 20:1">bika dizina di Nzambi yi Yakobi dikeba.<verse eid="PSA 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>Bika kafidisa lusadusu bu kadi ku buangu kinlongo</para>
  <para style="q1" vid="PSA 20:2">Bika kakindisa bu kadi ku Sioni.<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>Bika katebukila makaba maku moso moyo.</para>
  <para style="q1" vid="PSA 20:3">Ayi kakikinina makaba maku maviku.<verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>Bika kavana bitidi ntimꞌaku.</para>
  <para style="q1" vid="PSA 20:4">Ayi bika kanungisa zikhubukulu ziaku zioso.<verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>Tuela yamikina mu khini bu wela tambula ndungunu.</para>
  <para style="q1" vid="PSA 20:5">Tuela vumbula bidalapo bieto ku Yilu</para>
  <para style="q1" vid="PSA 20:5">mu dizina di Nzambi eto.</para>
  <para style="q1" vid="PSA 20:5">Bika Yave kadukisa zindombolo ziaku zioso.<verse eid="PSA 20:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>Buabu nzebi ti Yave wumvukisanga</para>
  <para style="q1" vid="PSA 20:6">mutu andi wuka vinda mafuta,</para>
  <para style="q1" vid="PSA 20:6">weti kumvana mvutu bu kadi ku Diyilu,</para>
  <para style="q1" vid="PSA 20:6">diandi dinlongo mu lusadusu luandi lungolo,</para>
  <para style="q1" vid="PSA 20:6">lu koko kuandi ku lubakala.<verse eid="PSA 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>Bankaka bantulanga diana mu matoma ma mvita,</para>
  <para style="q1" vid="PSA 20:7">bankaka mu ziphunda.</para>
  <para style="q1" vid="PSA 20:7">Vayi beto tuntulanga diana</para>
  <para style="q1" vid="PSA 20:7">mu dizina di Yave, Nzambi eto.<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>Bawu beti fukama mu makuma mawu ayi beti bua ;</para>
  <para style="q1" vid="PSA 20:8">Vayi beto tueti telama ayi tuidi kaka bakinda.<verse eid="PSA 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>Yave vukisa ntinu</para>
  <para style="q1" vid="PSA 20:9">Bika wutuvana mvutu mu thangu tueti tela.<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="cl">Minkunga 21</para>
  <para style="s1">Matondo mu diambu di ndungunu</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1"/>A Yave, ntinu weti yangalala mu zingolo ziaku</para>
  <para style="q1" vid="PSA 21:1">ayi tala phila khini andi yididi yinene mu ndungunu yoyi weti vana.<verse eid="PSA 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>Ngeyo wumvana bima bioso bitomba ntimꞌandi.</para>
  <para style="q1" vid="PSA 21:2">Ayi wusia kunyimina ko zindombolo ziozi kalomba mu bididi biandi.<verse eid="PSA 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>Ngeyo wuntambula va kimosi</para>
  <para style="q1" vid="PSA 21:3">ayi lusakumunu lu luvalu lu ngolo.</para>
  <para style="q1" vid="PSA 21:3">Ngeyo wutula budu ki nolo yi vedila</para>
  <para style="q1" vid="PSA 21:3">va mbata ntuꞌandi.<verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>Niandi wulomba luzingu kuidi ngeyo ayi wumvana luawu,</para>
  <para style="q1" vid="PSA 21:4">luzingu lu mula mu zithangu zioso</para>
  <para style="q1" vid="PSA 21:4">ayi lu kalumani.<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>Nkemboꞌandi widi wunneni mu diambu di ndungunu weti vana.</para>
  <para style="q1" vid="PSA 21:5">Ngeyo wumvuika kiezila</para>
  <para style="q1" vid="PSA 21:5">ayi nzitusu.<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>Bukiedika, ngeyo wumvana lusakumunu lu kalumani ;</para>
  <para style="q1" vid="PSA 21:6">wunkitula mutu wu yangadala mu diambu di khini yidi va meso maku<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>Bila Ntinu wuntulanga diana diandi mu Yave ;</para>
  <para style="q1" vid="PSA 21:7">Ayi mu diambu di luzolo lu ngolo Nzambi yizangama,</para>
  <para style="q1" vid="PSA 21:7">kalendi bulangana ko.<verse eid="PSA 21:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>Koko kuaku kuela buila bambeni ziaku zioso.</para>
  <para style="q1" vid="PSA 21:8">Koko kuaku ku lubakala kuela buila</para>
  <para style="q1" vid="PSA 21:8">bobo beti ku lenda.<verse eid="PSA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>Wela kuba kitula banga mfulu makala ma mbazu,</para>
  <para style="q1" vid="PSA 21:9">mu thangu yoyi wela kukimonikisa.</para>
  <para style="q1" vid="PSA 21:9">Yave wela kuba sikisa mu nganzi andi.</para>
  <para style="q1" vid="PSA 21:9">Ayi mbazu yela kuba zinisa.<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>Wela bunga nkunꞌawu va ntoto</para>
  <para style="q1" vid="PSA 21:10">ayi bana bawu va khatitsika yi bana ba batu.<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>Ka diambu ko balenda kubika mambimbi mu diambu diaku</para>
  <para style="q1" vid="PSA 21:11">ayi yindula zikhanu zimbimbi, balendi nunga ko.<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>Bila ngeyo wela kuba tinisa</para>
  <para style="q1" vid="PSA 21:12">bu wela kuba basula mu mbasꞌaku.<verse eid="PSA 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>A Yave, yayusu kuaku mu zingolo ziaku.</para>
  <para style="q1" vid="PSA 21:13">Tuela yimbidila ayi zitisa lulendo luaku.<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="cl">Minkunga 22</para>
  <para style="s1">A Nzambi ama, bila mbi wundiekudidi e ?</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi, wuyimbidila wawu mu nningu wu beti tedilanga “Nsuma wu nsuka”.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1"/>Nzambi ama, Nzambi ama,</para>
  <para style="q1" vid="PSA 22:1">bila mbi wundiekuididi e ?</para>
  <para style="q1" vid="PSA 22:1">Ayi bila mbi wididi thama mu kambu ku phukisa e ?</para>
  <para style="q1" vid="PSA 22:1">Ayi bila mbi wididi thama mu kambu wa maniongo mama e ?<verse eid="PSA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>Nzambi ama, ndinyamikina va muini,</para>
  <para style="q1" vid="PSA 22:2">vayi wukadi vutula mvutu.</para>
  <para style="q1" vid="PSA 22:2">Va builu, ndivuandanga ko dio sui.<verse eid="PSA 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>Vayi ngeyo wubieko banga wunlongo.</para>
  <para style="q1" vid="PSA 22:3">Ngeyo nzitusu wu Iseli.<verse eid="PSA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>Mu ngeyo bakulu beto batula diana diawu.</para>
  <para style="q1" vid="PSA 22:4">Batula diana diawu mu ngeyo ayi wuba kula.<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>Kuidi ngeyo bayamikina</para>
  <para style="q1" vid="PSA 22:5">ayi ngeyo wuba vukisa.</para>
  <para style="q1" vid="PSA 22:5">Mu ngeyo batula diana diawu</para>
  <para style="q1" vid="PSA 22:5">ayi basia fuisu tsoni ko.<verse eid="PSA 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>Vayi minu, ndidi kiela vayi bika mutu.</para>
  <para style="q1" vid="PSA 22:6">Babakala balembo mvuezi,</para>
  <para style="q1" vid="PSA 22:6">batu balembo ndenzi.<verse eid="PSA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>Babo bobo beti kumbona beti ku tsekinina.</para>
  <para style="q1" vid="PSA 22:7">Beti finga.</para>
  <para style="q1" vid="PSA 22:7">Beti nikuna mintu :<verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>“Kuidi Yave keti tula diana diandi</para>
  <para style="q1" vid="PSA 22:8">buna bika kamvukisa, bika kankula bila khini keti mona mu niandi.”<verse eid="PSA 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>Vayi, ngeyo wuthotula mu vumu ;</para>
  <para style="q1" vid="PSA 22:9">wuvanga ti nditula diana diama mu ngeyo</para>
  <para style="q1" vid="PSA 22:9">banga va thulu yi ngudi ama.<verse eid="PSA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>Tona ndibutuka ndiyekulu kuidi ngeyo tona mu vumu ki ngudi ama.</para>
  <para style="q1" vid="PSA 22:10">Tona mu vumu ki ngudi ama,</para>
  <para style="q1" vid="PSA 22:10">ngeyo wuba Nzambi ama.<verse eid="PSA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>Kadi kuthatukila bila ziphasi zifikimini,</para>
  <para style="q1" vid="PSA 22:11">bila kuisi ko mutu wulenda sadisa.<verse eid="PSA 22:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>Zingombi ziwombo zimbakala zinzungididi,</para>
  <para style="q1" vid="PSA 22:12">zingombi zi Basani zinzungididi.<verse eid="PSA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>Mu kunga ku khosi yeti kanzuna bulu</para>
  <para style="q1" vid="PSA 22:13">miunu miawu midi mizibuka ngolo mu diambu diama<verse eid="PSA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>Mbeni dukuka banga nlangu</para>
  <para style="q1" vid="PSA 22:14">ayi mimvesi miama mioso mivasukidi.</para>
  <para style="q1" vid="PSA 22:14">Ntimꞌama widi banga mafuta beti vindanga mu mabaya.</para>
  <para style="q1" vid="PSA 22:14">Wulembo siuti mu khati yi nitu ama.<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>Zingolo ziama zilembo yumi</para>
  <para style="q1" vid="PSA 22:15">banga tini ki nzungu tuma</para>
  <para style="q1" vid="PSA 22:15">ayi ludimi luama lunemi mu munu ama.</para>
  <para style="q1" vid="PSA 22:15">Ngeyo wuthula mu mbungi-mbungi yi lufua.<verse eid="PSA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>Zimbwa zinzungididi,</para>
  <para style="q1" vid="PSA 22:16">Nkangu wu batu bambimbi banzungididi.</para>
  <para style="q1" vid="PSA 22:16">Batobudi mioko miama ayi malu mama.<verse eid="PSA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>Ndilenda tanga mimvesi miama mioso.</para>
  <para style="q1" vid="PSA 22:17">Batu beti kutsungimina ayi balembo thadi.<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>Balembo kabana bawu na bawu minlele miama</para>
  <para style="q1" vid="PSA 22:18">ayi balembo budila yunga kiama tsombo.<verse eid="PSA 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>Vayi ngeyo Yave, kadi ba thama.</para>
  <para style="q1" vid="PSA 22:19">Ngeyo zingolo ziama ayi yiza nsualu mu kutsadisa.<verse eid="PSA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>Kula luzingu luama mu sabala ;</para>
  <para style="q1" vid="PSA 22:20">luzingu luama lu thalu mu luyalu lu zimbua.<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>Wukhudi mu munu wu khosi</para>
  <para style="q1" vid="PSA 22:21">wuphukisa mu ziphoka zi ziphaka.<verse eid="PSA 22:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>Ndiela yolukila dizina diaku</para>
  <para style="q1" vid="PSA 22:22">kuidi bakhomba baama ;</para>
  <para style="q1" vid="PSA 22:22">ndiela ku zitisa va khatitsika lukutukunu.<verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>Beno lunkinzikanga Yave,</para>
  <para style="q1" vid="PSA 22:23">bika lunzitisa !</para>
  <para style="q1" vid="PSA 22:23">Beno babo luidi mu nkuna Yakobi,</para>
  <para style="q1" vid="PSA 22:23">bika lunkinzika !</para>
  <para style="q1" vid="PSA 22:23">Beno babo luidi mu nkuna wu Iseli,</para>
  <para style="q1" vid="PSA 22:23">bika lunzitisa.<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>Bila kasia lenza ko ayi kasia kakumukina ko</para>
  <para style="q1" vid="PSA 22:24">ziphasi zi mutu widi mu phasi ;</para>
  <para style="q1" vid="PSA 22:24">kasia kunsuekila zizi kiandi ko</para>
  <para style="q1" vid="PSA 22:24">vayi weti wa yamikina kuandi</para>
  <para style="q1" vid="PSA 22:24">bu keti tomba lusadusu.<verse eid="PSA 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>Kuidi ngeyo kueti totukila minzitusu miama mu lukutukunu lunneni</para>
  <para style="q1" vid="PSA 22:25">va ntuala bobo beti ku kinzika,</para>
  <para style="q1" vid="PSA 22:25">ndiela dukisa zitsila ziama.<verse eid="PSA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>Minsukami miela dia ayi miela yukuta.</para>
  <para style="q1" vid="PSA 22:26">Bobo beti tomba Yave bela kumvana nzitusu.</para>
  <para style="q1" vid="PSA 22:26">Bika mintima mieno mizinga mu zithangu zioso !<verse eid="PSA 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>Zitsuka zioso zi ntoto ziela tebuka moyo ;</para>
  <para style="q1" vid="PSA 22:27">Ziela baluka kuidi Yave.</para>
  <para style="q1" vid="PSA 22:27">Batu ba makanda moso bela buongama va ntualꞌaku.<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>Bila Kipfumu kidi kuidi Yave ;</para>
  <para style="q1" vid="PSA 22:28">niandi wunyadilanga makanda.<verse eid="PSA 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>Batu boso badi kimvuama ba ntoto bela dia</para>
  <para style="q1" vid="PSA 22:29">ayi mamvawu bela buongama.</para>
  <para style="q1" vid="PSA 22:29">Babo bankulukanga mu mbungi-mbungi</para>
  <para style="q1" vid="PSA 22:29">bela komvama va ntualꞌandi ;</para>
  <para style="q1" vid="PSA 22:29">bobo bankambu baka</para>
  <para style="q1" vid="PSA 22:29">bu zingisila luzingu luandi bawu veka.<verse eid="PSA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>Nkuna wela ku nsadila.</para>
  <para style="q1" vid="PSA 22:30">Batu bela samuna mambu matedi Yave kuidi tsungi yinkuiza.<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>Bela yolukila busonga buandi</para>
  <para style="q1" vid="PSA 22:31">kuidi batu bobo babutukidi ko.</para>
  <para style="q1" vid="PSA 22:31">Bila niandi wuvanga mambu mama.<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="cl">Minkunga 23</para>
  <para style="s1">Pfumu niandi nsungi ama</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1"/>Yave niandi nsungi ama,</para>
  <para style="q1" vid="PSA 23:1">ndilendi kambu kadi kima ko.<verse eid="PSA 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2"/>Niandi wukuphundisanga muidi biti binlangu,</para>
  <para style="q1" vid="PSA 23:2">Wukundatanga kuidi minlangu milembama.<verse eid="PSA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3"/>Niandi wunkindisanga muelꞌama.</para>
  <para style="q1" vid="PSA 23:3">Niandi wukundiatisanga mu minsolo misonga</para>
  <para style="q1" vid="PSA 23:3">mu diambu di dizina diandi.<verse eid="PSA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>Ka diambu ko ndilenda diata</para>
  <para style="q1" vid="PSA 23:4">mu ndimba tombi ki lufua,</para>
  <para style="q1" vid="PSA 23:4">buna ndilendi mona mbimbi tsisi ko</para>
  <para style="q1" vid="PSA 23:4">bila ngeyo widi yama.</para>
  <para style="q1" vid="PSA 23:4">Nkawa aku ayi nti aku,</para>
  <para style="q1" vid="PSA 23:4">biawu bi kumbombanga.<verse eid="PSA 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>Ngeyo wukubika meza va ntualꞌama</para>
  <para style="q1" vid="PSA 23:5">va meso ma bambeni ziama.</para>
  <para style="q1" vid="PSA 23:5">Ngeyo wuvinda ntuꞌama mafuta</para>
  <para style="q1" vid="PSA 23:5">mbungu ama yilembo sapika.<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>Bukiedika, mamboti maku ayi luzolo</para>
  <para style="q1" vid="PSA 23:6">biela kundandakana mu bilumbu bioso bi luzingu luama.</para>
  <para style="q1" vid="PSA 23:6">Ayi ndiela vuanda mu nzo Yave</para>
  <para style="q1" vid="PSA 23:6">mu zithangu zioso.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="cl">Minkunga 24</para>
  <para style="s1">Yave kotidi mu buangu kiandi kinlongo</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1"/>Ntoto widi wu Yave ayi bibioso bidi mu wawu ;</para>
  <para style="q1" vid="PSA 24:1">nza ayi babo banzinganga muawu.<verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>Bila niandi wutunga ntoto va mbata mimbu</para>
  <para style="q1" vid="PSA 24:2">ayi wukindisa wawu va mbata minlangu.<verse eid="PSA 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>Nani wulenda kuma ku mongo wu Yave ?</para>
  <para style="q1" vid="PSA 24:3">Nani wulenda telama va buangu kiandi kinlongo e ?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>Woso mutu widi mioko misukulu</para>
  <para style="q1" vid="PSA 24:4">ayi ntima wuvedila ;</para>
  <para style="q1" vid="PSA 24:4">woso mutu wunkambu vumuna muelꞌandi kuidi bitumba,</para>
  <para style="q1" vid="PSA 24:4">Voti wunkambu levanga ndefi mu mambu ma luvunu.<verse eid="PSA 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5"/>Wela tambula lusakumunu luela ba kuidi Yave,</para>
  <para style="q1" vid="PSA 24:5">ayi ndungunu Nzambi yi Mvulusi andi.<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>Buawu bobo buididi tsungi yi batu bakuntombanga,</para>
  <para style="q1" vid="PSA 24:6">yi bawu bantombanga zizi kiaku,</para>
  <para style="q1" vid="PSA 24:6">a Nzambi yi Yakobi.<verse eid="PSA 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>Luvumbula mintu mieno, beno mielo !</para>
  <para style="q1" vid="PSA 24:7">Luvumbuka beno mielo mikhulu !</para>
  <para style="q1" vid="PSA 24:7">Muingi ntinu wu nkembo kakota.<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>Nani ntinu wu nkembo e ?</para>
  <para style="q1" vid="PSA 24:8">Keti Yave, nkua ngolo ayi nkua lulendo !</para>
  <para style="q1" vid="PSA 24:8">Keti Yave, nkua lulendo mu zimvita !<verse eid="PSA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>Luvumbula mintu mieno, beno mielo !</para>
  <para style="q1" vid="PSA 24:9">Luvumbuka beno mielo mikhulu !</para>
  <para style="q1" vid="PSA 24:9">Muingi ntinu wu nkembo kakota.<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>Nani wowo ntinu beni wu nkembo e ?</para>
  <para style="q1" vid="PSA 24:10">Keti Yave, pfumu yi minkangu mi masodi.</para>
  <para style="q1" vid="PSA 24:10">Niandi ntinu wu nkembo.<verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="cl">Minkunga 25</para>
  <para style="s1">Mbonisa nzila yoyi mfueti landakana</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1"/>Kuidi ngeyo Yave ndintambika muelꞌama.<verse eid="PSA 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2"/>Mu ngeyo ndintulanga diana diama, a Nzambi ama.</para>
  <para style="q1" vid="PSA 25:2">Kadi tala ti ndifuisu tsoni.</para>
  <para style="q1" vid="PSA 25:2">Bika bambeni ziama zibika ku ndunga.<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>Kadi mutu wumosi kalendi fua tsoni ko.</para>
  <para style="q1" vid="PSA 25:3">Vayi bela fuisu tsoni,</para>
  <para style="q1" vid="PSA 25:3">bobo bamvakulanga badiawu mu kambu phengomokono,<verse eid="PSA 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>Bika wumbonisa zinzila ziaku, a Yave</para>
  <para style="q1" vid="PSA 25:4">bika wundonga minsolo miaku,<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>wundiatisa mu kiedika kiaku ayi wundongi.</para>
  <para style="q1" vid="PSA 25:5">Bika ngeyo Nzambi Mvulusi ama.</para>
  <para style="q1" vid="PSA 25:5">Ayi diana diama didi mu ngeyo mu lumbu kimvimba.<verse eid="PSA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>A Yave, tebukila kiadi kiaku kingolo moyo</para>
  <para style="q1" vid="PSA 25:6">ayi luzolo luaku lu ngolo,</para>
  <para style="q1" vid="PSA 25:6">bila bidi mu zithangu zioso.<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>Kadi tebukila moyo masumu mama ma kimuana ;</para>
  <para style="q1" vid="PSA 25:7">ayi kadi tebukila moyo zinzila ziama zi matingu.</para>
  <para style="q1" vid="PSA 25:7">Mu diambu di luzolo luaku,</para>
  <para style="q1" vid="PSA 25:7">bika wuthebukila moyo ;</para>
  <para style="q1" vid="PSA 25:7">bila ngeyo widi wumboti, a Yave.<verse eid="PSA 25:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>Yave, widi wumboti ayi wusonga ;</para>
  <para style="q1" vid="PSA 25:8">diawu kanlongisilanga bankua masumu</para>
  <para style="q1" vid="PSA 25:8">mu zinzila ziandi.<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>Niandi wudiatisanga batu bakukikululanga mu mambu masonga ;</para>
  <para style="q1" vid="PSA 25:9">ayi wunlonganga nzilꞌandi kuidi bakukikululanga.<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>Zinzila zioso zi Yave zidi zi luzolo ayi zikuikama,</para>
  <para style="q1" vid="PSA 25:10">kuidi bawu beti keba zindombolo zi nguizani andi.<verse eid="PSA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>Mu diambu di dizina diaku, a Yave</para>
  <para style="q1" vid="PSA 25:11">bika wundemvukila mu mambimbi mama</para>
  <para style="q1" vid="PSA 25:11">bila madi mawombo.<verse eid="PSA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>Buna nani mutu wunkinzikanga Yave ?</para>
  <para style="q1" vid="PSA 25:12">Yave wela kunlonga nzila yoyi basobula mu diambu diandi.<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>Wela viokisa bilumbu biandi mu mamboti ;</para>
  <para style="q1" vid="PSA 25:13">ayi nkunꞌandi wela tambula tsi.<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>Yave weti monikisa mansueki mandi kuidi bobo bakunkinzikanga,</para>
  <para style="q1" vid="PSA 25:14">ayi weti kuba zabikisa nguizani andi.<verse eid="PSA 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>Thalu ama yidi kuidi Yave</para>
  <para style="q1" vid="PSA 25:15">mu zithangu zioso.</para>
  <para style="q1" vid="PSA 25:15">Bila niandi wela totula malu mama mu dikondi.<verse eid="PSA 25:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>Baluka kuidi minu</para>
  <para style="q1" vid="PSA 25:16">ayi bika nlemvo aku wuba va minu</para>
  <para style="q1" vid="PSA 25:16">bila ndidi minu veka ayi ndidi mu phasi.<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>Ziphasi zi ntimꞌama zilembo buelama ;</para>
  <para style="q1" vid="PSA 25:17">bika wuthotula mu ziphasi ziama.<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>Tala ziphasi ziama ayi kiadi kiama</para>
  <para style="q1" vid="PSA 25:18">ayi botula masumu mama moso.<verse eid="PSA 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>Tala phila bambeni ziama zilembo buelimina</para>
  <para style="q1" vid="PSA 25:19">ayi bandendidi mu kikhenene kimosi kingolo.<verse eid="PSA 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>Keba luzingu luama ayi khudi !</para>
  <para style="q1" vid="PSA 25:20">Kadi tala ti ndifua tsoni bila mu ngeyo ndisuamina.<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>Bika fuanana ayi lulama bikheba,</para>
  <para style="q1" vid="PSA 25:21">bila mu ngeyo ntudidi diana diama.<verse eid="PSA 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>O Nzambi, kula Iseli mu ziphasi ziandi zioso.<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="cl">Minkunga 26</para>
  <para style="s1">Bika wundungisa</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1"/>Wundungisa, a Yave, bila ndidiatila mu luzingu lukambulu tsembolo.</para>
  <para style="q1" vid="PSA 26:1">Nditula diana diama mu Yave mu kambu memata.<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>A Yave wumfiongunina, wumbeki,</para>
  <para style="q1" vid="PSA 26:2">fiongunina mayindu ma ntimꞌama ayi ntimꞌama.<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>Bila luzolo luaku luidi mu zithangu zioso ku ntualꞌama</para>
  <para style="q1" vid="PSA 26:3">ayi ndindiatanga mu zithangu zioso mu kiedika kiaku.<verse eid="PSA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>Ndivuandanga ko va kimosi ayi batu ba luvunu.</para>
  <para style="q1" vid="PSA 26:4">Ndifubakananga ko va kimosi ayi bankua mayuya.<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>Ndieti kakumukina lukutukunu lu batu bamvanganga mambimbi.</para>
  <para style="q1" vid="PSA 26:5">Ndivuandanga ko va kimosi ayi batu bambimbi.<verse eid="PSA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>Tsukudi mioko miama</para>
  <para style="q1" vid="PSA 26:6">mu monisa ti ndisi zaba diambu ko,</para>
  <para style="q1" vid="PSA 26:6">ayi ndiela zungidila ntalꞌaku, a Yave !<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>Mu yamikina minzitusu miaku mu mbembo yingolo</para>
  <para style="q1" vid="PSA 26:7">ayi mu diambu di yolukila mangitukulu maku moso.<verse eid="PSA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>Ndinzolanga nzo yoyi weti zingila ; a Yave</para>
  <para style="q1" vid="PSA 26:8">buangu kimvuandanga nkemboꞌaku.<verse eid="PSA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>Kadi botula muelꞌama va kimosi</para>
  <para style="q1" vid="PSA 26:9">ayi bankua masumu ayi luzingu luama va kimosi</para>
  <para style="q1" vid="PSA 26:9">ayi bantengulanga menga ma batu,<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>mu bobo badi mioko miyuku kubika zikhanu zimbimbi,</para>
  <para style="q1" vid="PSA 26:10">bobo mioko mi lubakala miwedi makaba ma kinsueki.<verse eid="PSA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>Vayi minu, ndieti diatila mu luzingu lukambu tsembolo ;</para>
  <para style="q1" vid="PSA 26:11">bika wukhula ayi wumbona kiadi.<verse eid="PSA 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>Malu mama madi va ntoto wuyalumuka</para>
  <para style="q1" vid="PSA 26:12">mu lukhutukunu lunneni, ndiela zitisa Yave.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="cl">Minkunga 27</para>
  <para style="s1">Ndidi mu ndembama vadi Nzambi</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1"/>Yave niandi kiezila kiama ayi phulusu ama.</para>
  <para style="q1" vid="PSA 27:1">Nani ndilenda mona tsisi e ?</para>
  <para style="q1" vid="PSA 27:1">Yave niandi suamunu kingolo mu luzingu luama.</para>
  <para style="q1" vid="PSA 27:1">Nani ndilenda mona boma e ?<verse eid="PSA 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>Mu thangu batu bambimbi, bela kuiza ku ntualꞌama</para>
  <para style="q1" vid="PSA 27:2">mu diambu di dia nsuni ama ;</para>
  <para style="q1" vid="PSA 27:2">mu thangu bambeni ziama ayi bobo bandendi bela kuiza kunduanisa,</para>
  <para style="q1" vid="PSA 27:2">bela bumina thutu ayi bela bua.<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>Ka diambu ko nkangu wu masodi wunzungididi,</para>
  <para style="q1" vid="PSA 27:3">ntimꞌama wulendi mona tsisi ko ;</para>
  <para style="q1" vid="PSA 27:3">Ka diambu ko mvita yibuidi mu diambu diama,</para>
  <para style="q1" vid="PSA 27:3">ndilendi zimbisa diana ko.<verse eid="PSA 27:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>Kima kimosi ndilomba kuidi Yave,</para>
  <para style="q1" vid="PSA 27:4">kiawu ndintomba :</para>
  <para style="q1" vid="PSA 27:4">Thidi vuanda mu bilumbu bioso bi luzingu luama mu nzo Yave,</para>
  <para style="q1" vid="PSA 27:4">mu diambu nditalanga kitoko ki Yave</para>
  <para style="q1" vid="PSA 27:4">ayi mu diambu ndintombannga mu nzo andi.<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>Bila mu lumbu ki ziphasi</para>
  <para style="q1" vid="PSA 27:5">wela ku kheba mu luvovomo mu buangu kiandi kamvuandanga ;</para>
  <para style="q1" vid="PSA 27:5">wela kutsueka ku tsi Nzoꞌandi yi ngoto ;</para>
  <para style="q1" vid="PSA 27:5">wela kuthedimisa va ditadi di ngolo.<verse eid="PSA 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>Buna ntu ama wulenda vumuka va yilu bambeni ziama zinzungididi.</para>
  <para style="q1" vid="PSA 27:6">Mu nzoꞌandi yi ngoto, ndiela tambika makaba mu khini.</para>
  <para style="q1" vid="PSA 27:6">Ndiela yimbila ayi bula miziki mu diambu di Yave.<verse eid="PSA 27:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>Wa mbemboꞌama bu ndilembo tedi, a Yave ;</para>
  <para style="q1" vid="PSA 27:7">wumboni kiadi ayi wuphana mvutu.<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>Ntimꞌama wutubidi mu diambu diaku :</para>
  <para style="q1" vid="PSA 27:8">“Tomba zizi kiandi.”</para>
  <para style="q1" vid="PSA 27:8">Zizi kiaku, a Yave, kiawu ndiela tomba.<verse eid="PSA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>Kadi kutsueka zizi kiaku.</para>
  <para style="q1" vid="PSA 27:9">Bika kuka kisadi kiaku mu nganzi.</para>
  <para style="q1" vid="PSA 27:9">Ngeyo wuba nsadisi ama</para>
  <para style="q1" vid="PSA 27:9">kadi kumbika, kadi kundiekula.</para>
  <para style="q1" vid="PSA 27:9">A Nzambi yi Mvulusi ama.<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>Ka diambu ko dise diama ayi ngudi ama bandiekudi ;</para>
  <para style="q1" vid="PSA 27:10">Yave wela kundiakula.<verse eid="PSA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>Wundonga nzilꞌaku, a Yave</para>
  <para style="q1" vid="PSA 27:11">ayi wundiatisa mu nsolo wu songa</para>
  <para style="q1" vid="PSA 27:11">mu diambu di batu bobo beti kundiamisa.<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>Kadi kundiekula mu luzolo lu batu bobo beti kundenda,</para>
  <para style="q1" vid="PSA 27:12">bila bambangi ba luvunu zitelimini</para>
  <para style="q1" vid="PSA 27:12">mu diambu diama,</para>
  <para style="q1" vid="PSA 27:12">ayi zieti yindula matsita.<verse eid="PSA 27:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>Ndisia diana mu diambu diadi :</para>
  <para style="q1" vid="PSA 27:13">Ndiela mona mamboti ma Yave va ntoto wu batu badi moyo.<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>Tadidila Yave !</para>
  <para style="q1" vid="PSA 27:14">Wukikindisa ayi bika ntimꞌaku wukinda ;</para>
  <para style="q1" vid="PSA 27:14">ayi tadidila Yave.<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="cl">Minkunga 28</para>
  <para style="s1">Yave, vana mvutu</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1"/>Ngeyo ndintela ;</para>
  <para style="q1" vid="PSA 28:1">A Yave, ditadi diama di ngolo,</para>
  <para style="q1" vid="PSA 28:1">kadi kunzibikila dikutu diaku</para>
  <para style="q1" vid="PSA 28:1">Bila ngeyo ba dio sui ;</para>
  <para style="q1" vid="PSA 28:1">buna ndiela dedakana bobo bankulukanga mu dibulu dimula.<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>Wa yamikina kuami mu diambu di kiadi</para>
  <para style="q1" vid="PSA 28:2">banga bu ndikutela mu tomba lusadusu</para>
  <para style="q1" vid="PSA 28:2">banga bu ndieti vumuna mioko miama</para>
  <para style="q1" vid="PSA 28:2">ku ndambu buangu kiaku kilutidi kinlongo.<verse eid="PSA 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>Kadi kuphitumuna va kimosi ayi batu bambimbi</para>
  <para style="q1" vid="PSA 28:3">ayi batu beti vanga mambimbi ;</para>
  <para style="q1" vid="PSA 28:3">bobo banyolukilanga mambu ma ndembama va kimosi ayi badiawu</para>
  <para style="q1" vid="PSA 28:3">vayi banyindulanga mambimbi mu mintima miawu.<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>Wuba vutudila boso buididi mavanga mawu,</para>
  <para style="q1" vid="PSA 28:4">ayi boso buididi mavanga mawu mambimbi.</para>
  <para style="q1" vid="PSA 28:4">Wuba vutudila boso buididi mavanga ma mioko miawu,</para>
  <para style="q1" vid="PSA 28:4">wuba vutudila boso buididi mambu momo bavanga.<verse eid="PSA 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>Sumbu batalanga ko mavanga ma Yave,</para>
  <para style="q1" vid="PSA 28:5">ayi mavanga ma mioko miandi,</para>
  <para style="q1" vid="PSA 28:5">wela ku babunga ayi kalendi ku batunga diaka ko.<verse eid="PSA 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>Nzitusu wuba kuidi Yave !</para>
  <para style="q1" vid="PSA 28:6">Bila wuwilu yamikina kuama mu diambu di kiadi.<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>Yave niandi zingolo ziama ayi nkakuꞌama.</para>
  <para style="q1" vid="PSA 28:7">Ntimꞌama wuntulanga diana mu niandi</para>
  <para style="q1" vid="PSA 28:7">ayi ndisadusu.</para>
  <para style="q1" vid="PSA 28:7">Ntimꞌama weti mona khini yi ngolo</para>
  <para style="q1" vid="PSA 28:7">ayi ndiela kumvutudila matondo mu nkungꞌama.<verse eid="PSA 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>Yave niandi ngolo mu diambu di batu bandi.</para>
  <para style="q1" vid="PSA 28:8">Niandi buangu kingolo ki khudulu</para>
  <para style="q1" vid="PSA 28:8">yi mutu andi wowo kadukudila mafuta.<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>Vukisa batu baku ayi sakumuna kiuka kiaku.</para>
  <para style="q1" vid="PSA 28:9">Bika wuba nsungi awu ayi wuba nata mu zithangu zioso.<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="cl">Minkunga 29</para>
  <para style="s1">Mbembo Yave</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1"/>Luvana kuidi Yave, beno batu badi ngolo ;</para>
  <para style="q1" vid="PSA 29:1">Luvana nkembo kuidi Yave ayi zingolo.<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>Luvana nkembo kuidi Yave</para>
  <para style="q1" vid="PSA 29:2">wufuanikini mu dizina diandi.</para>
  <para style="q1" vid="PSA 29:2">Lubuongimina Yave mu kiezila ki kinlongo kiandi.<verse eid="PSA 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>Mbembo Yave yidi va mbata minlangu.</para>
  <para style="q1" vid="PSA 29:3">Nzambi yi nkembo wulembo dumi.</para>
  <para style="q1" vid="PSA 29:3">Yave wulembo dumi va mbata minlangu minneni.<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>Mbembo Yave yidi yi lulendo,</para>
  <para style="q1" vid="PSA 29:4">mbembo Yave yidi yi nzitusu.<verse eid="PSA 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>Mbembo Yave yinkelulanga minti mi sedeli ;</para>
  <para style="q1" vid="PSA 29:5">Yave wunkelulanga minti mi sedeli midi mu Libani mu bitini.<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>Wunzamisanga Libani banga muana wungombi ;</para>
  <para style="q1" vid="PSA 29:6">Silioni banga muana wu phakasa.<verse eid="PSA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>Mbembo Yave yilembo totula minlaki mi mbazu.<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>Mbembo Yave yintitisanga dikanga.</para>
  <para style="q1" vid="PSA 29:8">Yave wuntitisanga dikanga di Kadesi.<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>Mbembo Yave yimbutisanga minsuma ;</para>
  <para style="q1" vid="PSA 29:9">yeti vambisa minsitu.</para>
  <para style="q1" vid="PSA 29:9">Mu Nzoꞌandi, bima bioso bilembo yamikina :</para>
  <para style="q1" vid="PSA 29:9">“nkembo”.<verse eid="PSA 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>Yave wumvuandanga va kundu ki kipfumu va mbata khuka minlangu ;</para>
  <para style="q1" vid="PSA 29:10">Yave weti vuanda banga ntinu mu zithangu zioso.<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>Yave weti vana batu bandi zingolo ;</para>
  <para style="q1" vid="PSA 29:11">Yave weti sakumuna batu bandi mu ndembama.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="cl">Minkunga 30</para>
  <para style="s1">Ngeyo wuphutudila luzingu</para>
  <para style="d">Nkunga Davidi kayimbidila mu mbiekolo nzo Nzambi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1"/>Ndiela kuyayisa, a Yave</para>
  <para style="q1" vid="PSA 30:1">bila ngeyo wuthotula mu dibulu didi thipula</para>
  <para style="q1" vid="PSA 30:1">Wusia tia ko ti bambeni ziama zimona khini</para>
  <para style="q1" vid="PSA 30:1">mu diambu diama.<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>A Yave, Nzambi ama, ngeyo nditela mu diambu di lusadusu</para>
  <para style="q1" vid="PSA 30:2">ayi ngeyo wumbelusa.<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>Yave, ngeyo wuthotula mu tsi bafua,</para>
  <para style="q1" vid="PSA 30:3">ngeyo wuthanina muingi ndibika tibuka mu dibulu.<verse eid="PSA 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>Luyimbidila Yave beno banlongo bandi ;</para>
  <para style="q1" vid="PSA 30:4">Zitisanu dizina diandi di nlongo.<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>Bila nganzi andi yizingilanga mu ndambu thangu kaka.</para>
  <para style="q1" vid="PSA 30:5">Vayi nlemvo andi wunzinganga mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 30:5">bidilu bilenda kuiza va builu ;</para>
  <para style="q1" vid="PSA 30:5">vayi khini yinkuizanga va nsuka.<verse eid="PSA 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>Bu ndiba mu luvovomo, ndituba :</para>
  <para style="q1" vid="PSA 30:6">“Ndilendi nikunu ko”<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>A Yave, mu nlemvo aku,</para>
  <para style="q1" vid="PSA 30:7">ngeyo wukindisa mongoꞌama…</para>
  <para style="q1" vid="PSA 30:7">vayi bu wusueka zizi kiaku buna minu ndimona boma.<verse eid="PSA 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>Kuidi ngeyo, a Yave, nditela mbila.</para>
  <para style="q1" vid="PSA 30:8">Kuidi Yave ndiyamikina mu diambu di lusadusu<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>“Ndandu mbi yidi mu mbivusu ama, minu kuluka mu dibulu e ?</para>
  <para style="q1" vid="PSA 30:9">Mbungi-mbungi yilenda kuzitisa e ?</para>
  <para style="q1" vid="PSA 30:9">Voti yilenda yamikina kikhuikizi kiaku e ?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>A Yave wa, wumboni kiadi,</para>
  <para style="q1" vid="PSA 30:10">A yave, bika wuba lusadusu luama.”<verse eid="PSA 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>Ngeyo wuviakisa bidilu biama makinu,</para>
  <para style="q1" vid="PSA 30:11">wunianguna tsaku ama ayi wuphuika khini.<verse eid="PSA 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>Muingi ntimꞌama wuyimbidila minkunga</para>
  <para style="q1" vid="PSA 30:12">ayi wubika ba dio sui.</para>
  <para style="q1" vid="PSA 30:12">A Yave, Nzambi ama, ndiela ku vutudilanga mu zithangu zioso.<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="cl">Minkunga 31</para>
  <para style="s1">Nditula diana diama mu Yave</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1"/>Kuidi ngeyo, Yave ndintombila suamunu ;</para>
  <para style="q1" vid="PSA 31:1">kadi khumbu yimosi ndifua tsoni ;</para>
  <para style="q1" vid="PSA 31:1">wukhula mu busonga buaku.<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>Yinika dikutu diaku kuidi minu,</para>
  <para style="q1" vid="PSA 31:2">Yiza nsualu, mu kukhula !</para>
  <para style="q1" vid="PSA 31:2">Kuidi minu, bika wuba ditadi diama dingolo disuamina,</para>
  <para style="q1" vid="PSA 31:2">suamunu kingolo, mu diambu di kuphukisa.<verse eid="PSA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>Sumbu didi ti ngeyo ditadi diama dingolo</para>
  <para style="q1" vid="PSA 31:3">ayi suamunu kiama kingolo.</para>
  <para style="q1" vid="PSA 31:3">Mu diambu di dizina diaku</para>
  <para style="q1" vid="PSA 31:3">bika wuthuadisa ayi wundiatisa.<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>Bika wuthotula mu ntambu wu bathambila,</para>
  <para style="q1" vid="PSA 31:4">bila ngeyo suamunu kiama.<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>Mu mioko miaku ndintambika pheve ama ;</para>
  <para style="q1" vid="PSA 31:5">Wukhula, a Yave, ngeyo Nzambi yi kiedika.<verse eid="PSA 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>Ndieti lenda bobo bansingiminanga mu bitumba biphamba.</para>
  <para style="q1" vid="PSA 31:6">Vayi minu diana diama didi mu Yave.<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>Ndiela mona khini ayi ndiela yangalala</para>
  <para style="q1" vid="PSA 31:7">mu diambu di luzolo luaku ;</para>
  <para style="q1" vid="PSA 31:7">bila wumona ziphasi ziama ;</para>
  <para style="q1" vid="PSA 31:7">wuzaba kiadi ki muelꞌama.<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>Ayi wusia ku ndiekula ko mu mioko mi mbeni.</para>
  <para style="q1" vid="PSA 31:8">Vayi ngeyo malu mama va buangu ki yalumuka.<verse eid="PSA 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>Bika wumbona kiadi, a Yave,</para>
  <para style="q1" vid="PSA 31:9">bila mu ziphasi ndidi.</para>
  <para style="q1" vid="PSA 31:9">Meso mama ; mabividi mu diambu di maniongo</para>
  <para style="q1" vid="PSA 31:9">muelꞌama ayi nitu ama bibividi mu diambu di phasi<verse eid="PSA 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>Luzingu luama lulembo suki mu kiadi</para>
  <para style="q1" vid="PSA 31:10">ayi mimvu miama milembo suki mu diambu di kunga.</para>
  <para style="q1" vid="PSA 31:10">Zingolo ziama zilembo suki mu diambu di ziphasi ziama,</para>
  <para style="q1" vid="PSA 31:10">ayi mimvesi miama milembo lebakana ngolo.<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>Mu diambu di bambeni ziama zioso,</para>
  <para style="q1" vid="PSA 31:11">ndiyikidi bila ki nlenzo kuidi bobo bafikimini yami</para>
  <para style="q1" vid="PSA 31:11">ayi bila ki tsisi yiwombo mu diambu di batu bobo bazabini yama.</para>
  <para style="q1" vid="PSA 31:11">Bobo bakumbona mu nzila balembo tini va ndidi.<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>Banzimbikini banga ti ndifua</para>
  <para style="q1" vid="PSA 31:12">Ndidi banga nzungu tuma yibudika.<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>Bila ndilembo wi balembo thubidila buwombo ku ndambu</para>
  <para style="q1" vid="PSA 31:13">ayi tsisi yingolo mu zindambu zioso</para>
  <para style="q1" vid="PSA 31:13">balembo kutakananga va kimosi mu diambu banduanisa ;</para>
  <para style="q1" vid="PSA 31:13">balembo yendila luzingu luama manenga.<verse eid="PSA 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>Vayi minu, mu ngeyo ndintula diana diama, a Yave,</para>
  <para style="q1" vid="PSA 31:14">Ndieti tuba : “Ngeyo Nzambi ama.”<verse eid="PSA 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>Bilumbu biama bioso bidi mu mioko miaku ;</para>
  <para style="q1" vid="PSA 31:15">wukhula mu mioko mi bambeni ziama</para>
  <para style="q1" vid="PSA 31:15">ayi mu mioko mi bobo balembo ndandakana.<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>Bika zizi kiaku kikienzukila kisadi kiaku ;</para>
  <para style="q1" vid="PSA 31:16">wuphukisa mu diambu di luzolo luaku lungolo.<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>Kadi tala ti ndifua tsoni, a Yave,</para>
  <para style="q1" vid="PSA 31:17">bila kuidi ngeyo ndiyamikina.</para>
  <para style="q1" vid="PSA 31:17">Vayi bika batu bambimbi bafua tsoni !</para>
  <para style="q1" vid="PSA 31:17">Bika baba dio sui ku tsi bafua !<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>Bika bididi bintotulanga luvunu biba dio sui ;</para>
  <para style="q1" vid="PSA 31:18">mu luniemo ayi mu mvuezolo beti yolukila</para>
  <para style="q1" vid="PSA 31:18">mu luyanu kuidi mutu wusonga.<verse eid="PSA 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>A phila, mamboti maku madidi manneni ;</para>
  <para style="q1" vid="PSA 31:19">momo wulundila bobo beti kukinzika ;</para>
  <para style="q1" vid="PSA 31:19">momo wuvangila bobo beti tomba suamunu</para>
  <para style="q1" vid="PSA 31:19">kuidi ngeyo va ntuala batu.<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>Va ntuala meso maku, ngeyo weti kuba suekanga</para>
  <para style="q1" vid="PSA 31:20">mu diambu di mambimbi mayindulanga batu</para>
  <para style="q1" vid="PSA 31:20">ku buangu kioki wumvuandanga, ngeyo weti kuba keba mu luvovomo</para>
  <para style="q1" vid="PSA 31:20">mu ludimi lueti funda.<verse eid="PSA 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>Nzitusu wuba kuidi Yave</para>
  <para style="q1" vid="PSA 31:21">Bila niandi wumbonisini luzolo luandi lungolo</para>
  <para style="q1" vid="PSA 31:21">mu thangu ndiba mu divula dizungulu kuidi masodi.<verse eid="PSA 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>Mu boma buama minu ndituba : “Minu ndivengumunu thama va ntualꞌaku.”</para>
  <para style="q1" vid="PSA 31:22">Muaki ngeyo wuwa yamikina kuama mu diambu di kiadi</para>
  <para style="q1" vid="PSA 31:22">mu thangu nditela mu diambu di lusadusu.<verse eid="PSA 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>Bika luzola Yave beno banlongo bandi boso.</para>
  <para style="q1" vid="PSA 31:23">Yave wunkebanga minkhuikizi</para>
  <para style="q1" vid="PSA 31:23">Vayi wumvutudilanga mu bufuana</para>
  <para style="q1" vid="PSA 31:23">bobo badi luniemo.<verse eid="PSA 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>Lukikindisa ayi bika luba bukhafi mu mintima mieno ;</para>
  <para style="q1" vid="PSA 31:24">beno boso bobo luntulanga diana dieno mu Yave.<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="cl">Minkunga 32</para>
  <para style="s1">Khini yidi mu lemvokolo</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1"/>Lusakumunu kuidi mutu wowo wulemvokolo nzimbalꞌandi ;</para>
  <para style="q1" vid="PSA 32:1">masumu mandi mafukulu.<verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>Lusakumunu kuidi mutu wowo Yave kankambu</para>
  <para style="q1" vid="PSA 32:2">ntangila disumu diandi,</para>
  <para style="q1" vid="PSA 32:2">ayi kambulu bukhita mu pheve andi.<verse eid="PSA 32:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>Bu ndiba dio sui,</para>
  <para style="q1" vid="PSA 32:3">mimvesi miama milebakana mu kunga ku ndiba</para>
  <para style="q1" vid="PSA 32:3">nkunga mu lumbu kimvimba.<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>Bila muini ayi builu koko kuaku ziku kuba va minu.</para>
  <para style="q1" vid="PSA 32:4">Zingolo ziama zisukidi</para>
  <para style="q1" vid="PSA 32:4">banga mu thangu yi muini wu ngolo.<verse eid="PSA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>Buna ndizabikisa disumu diama,</para>
  <para style="q1" vid="PSA 32:5">ndisia fuka mambimbi mama ko.</para>
  <para style="q1" vid="PSA 32:5">Ndituba : “Ndiela lomba nlemvo mu zinzimbala ziama kuidi Yave.”</para>
  <para style="q1" vid="PSA 32:5">Buna ngeyo wulemvukila mambimbi ma disumu diama.<verse eid="PSA 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>Buna diawu bika woso mutu wunkinzikanga mambu maku,</para>
  <para style="q1" vid="PSA 32:6">wela kusambila mu thangu yoyi kalenda kubakula.</para>
  <para style="q1" vid="PSA 32:6">Bukiedika mu thangu yi khuka nlangu yingolo</para>
  <para style="q1" vid="PSA 32:6">milendi kunlalumuna ko.<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>Ngeyo buangu kiama kieti kutsueka ;</para>
  <para style="q1" vid="PSA 32:7">ngeyo weti kukheba mu ziphasi.</para>
  <para style="q1" vid="PSA 32:7">Ngeyo wukunzungidilanga mu minkunga mi khudulu.<verse eid="PSA 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>“Ndiela kumonisa ayi kulonga nzila yoyi fueti diatila,</para>
  <para style="q1" vid="PSA 32:8">ndiela kuvana ndongi ayi thaluꞌama</para>
  <para style="q1" vid="PSA 32:8">yela ba vadi ngeyo.<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>Kadi ba banga phunda</para>
  <para style="q1" vid="PSA 32:9">voti banga bulu kioki bantedilanga ‘mule’ ;</para>
  <para style="q1" vid="PSA 32:9">bibulu bikondolo diela,</para>
  <para style="q1" vid="PSA 32:9">vayi biobi binkangungu nsinga ayi sengo mu munu</para>
  <para style="q1" vid="PSA 32:9">bila nganu bilenda fikama va widi.”<verse eid="PSA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>Mabienga mawombo madi mu diambu di mutu wumbimbi ;</para>
  <para style="q1" vid="PSA 32:10">vayi luzolo lu ngolo lu ma Yave lunzungidilanga mutu wowo</para>
  <para style="q1" vid="PSA 32:10">wuntulanga diana diandi mu niandi.<verse eid="PSA 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>Monanu khini</para>
  <para style="q1" vid="PSA 32:11">ayi luyangadala mu Yave beno basonga.</para>
  <para style="q1" vid="PSA 32:11">Luyimbila, beno boso luidi balulama mu mintima.<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="cl">Minkunga 33</para>
  <para style="s1">Nzambi niandi mvangi ayi Mvulusi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1"/>Luyimbila Yave mu khini beno basonga</para>
  <para style="q1" vid="PSA 33:1">Bufueni ti mutu widi ntima lulama kanzitisa.<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>Luzitisa Yave mu ngitala,</para>
  <para style="q1" vid="PSA 33:2">Lusika miziki mu diambu diandi</para>
  <para style="q1" vid="PSA 33:2">mu siku kidi dikumi di zitsinga.<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>Lunyimbidila nkunga wumona ;</para>
  <para style="q1" vid="PSA 33:3">Lusika bumboti ayi luyamikina mu diambu di khini.<verse eid="PSA 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>Bila mambu ma Yave madi masonga ayi makiedika.</para>
  <para style="q1" vid="PSA 33:4">Niandi widi kikhuikizi mu mamoso keti vanga.<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>Yave wunzolanga bululama ayi busonga</para>
  <para style="q1" vid="PSA 33:5">Ntoto widi wuwala luzolo luandi lungolo.<verse eid="PSA 33:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>Diyilu divangimina mu mambu ma Yave.</para>
  <para style="q1" vid="PSA 33:6">Nkangu andi woso wu bima,</para>
  <para style="q1" vid="PSA 33:6">bivangimina mu phemo yi munu andi.<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>Wunkupikisanga minlangu mi mbu mu khati mvungu,</para>
  <para style="q1" vid="PSA 33:7">ayi wuntulanga biza mu bilundulu.<verse eid="PSA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>Bika ntoto wumvimba wukinzika Yave.</para>
  <para style="q1" vid="PSA 33:8">Bika batu boso ba ntoto bantitila.<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>Bila bu katuba, buna diawu divangama,</para>
  <para style="q1" vid="PSA 33:9">bu katuma, buna diawu ditelama dio ngui.<verse eid="PSA 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>Yave wumvunzanga zikhanu zi makanda</para>
  <para style="q1" vid="PSA 33:10">wumvondanga mayindu ma batu.<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>Vayi zikhanu zi Yave zinzingilanga mu zithangu zioso</para>
  <para style="q1" vid="PSA 33:11">mayindu ma ntimꞌandi manzingilanga</para>
  <para style="q1" vid="PSA 33:11">mu tsungi ka tsungi.<verse eid="PSA 33:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>Lusakumunu luidi kuidi dikanda di batu</para>
  <para style="q1" vid="PSA 33:12">diodi Nzambi kadidi Yave,</para>
  <para style="q1" vid="PSA 33:12">batu bobo kasobula mu diambu di kiuka kiandi.<verse eid="PSA 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>Tona ku diyilu, Yave wulembo tadi ;</para>
  <para style="q1" vid="PSA 33:13">wulembo moni bana boso ba batu.<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>Tona ku buangu kioki keti vuanda,</para>
  <para style="q1" vid="PSA 33:14">Yave wulembo tadi batu banzingilanga va ntoto.<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>Niandi wunkubikanga mintima mi batu boso,</para>
  <para style="q1" vid="PSA 33:15">Niandi wuntalanga mavanga mawu moso beti vanga.<verse eid="PSA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>Kuisi kadi ntinu wumosi ko wulenda vuka</para>
  <para style="q1" vid="PSA 33:16">mu diambu di nkangu andi wunneni wu masodi ;</para>
  <para style="q1" vid="PSA 33:16">kuisi kadi mutu wu lulendo ko wulenda tina</para>
  <para style="q1" vid="PSA 33:16">mu diambu di zingolo ziandi ziwombo ;<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>Phunda yidi diana di phamba mu diambu di khudulu ;</para>
  <para style="q1" vid="PSA 33:17">Ka diambu ko zingolo ziandi zinneni, yilendi vukisa ko.<verse eid="PSA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>Vayi meso ma Yave madi kuidi bawu beti kunkinzika ;</para>
  <para style="q1" vid="PSA 33:18">kuidi bawu bantulanga diana mu luzolo luandi lungolo,<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>mu diambu di kuba kula mu lufua</para>
  <para style="q1" vid="PSA 33:19">ayi mu diambu di kuba keba bamoyo</para>
  <para style="q1" vid="PSA 33:19">mu thangu yi kanda.<verse eid="PSA 33:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>Tulembo vingila mu diana kuidi Yave.</para>
  <para style="q1" vid="PSA 33:20">Niandi nsadisi eto ayi nkaku eto.<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>Mu niandi mintima mieto mieti mona khini</para>
  <para style="q1" vid="PSA 33:21">bila tutula diana dieto mu dizina diandi di nlongo,<verse eid="PSA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>Bika luzolo luaku lu ngolo luba va beto boso, a Yave</para>
  <para style="q1" vid="PSA 33:22">bu tueti tula diana dieto mu ngeyo.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="cl">Minkunga 34</para>
  <para style="s1">Pfumu wukhula</para>
  <para style="d">Nkunga Davidi mu thangu kavuna lawuka va meso ma Abimeleki bu kankuka ayi Davidi wuyenda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1"/>Ndiela yayisa Yave mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 34:1">Nzitusu andi wela ba mu bididi biama mu kadika thangu.<verse eid="PSA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>Muelꞌama wela kiniemisa mu Yave.</para>
  <para style="q1" vid="PSA 34:2">Bika badi mu phasi bawa ayi bamona khini.<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>Kembisanu Yave va kimosi ayi minu,</para>
  <para style="q1" vid="PSA 34:3">bika tuyayisanu dizina diandi va kimosi,<verse eid="PSA 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>Nditomba Yave, niandi wuphana mvutu</para>
  <para style="q1" vid="PSA 34:4">ayi niandi wukhula mu zitsisi ziama zioso.<verse eid="PSA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>Batu bobo batala kuidi niandi bakienzulu</para>
  <para style="q1" vid="PSA 34:5">ayi bizizi biawu bilendi mona tsoni nkutu ko.<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>Nsukami wawu wutela ;</para>
  <para style="q1" vid="PSA 34:6">ayi Yave wunwa ayi wuphukisa mu ziphasi ziandi zioso.<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>Mbasi Yave yinzungidilanga bobo bankinzikanga Yave</para>
  <para style="q1" vid="PSA 34:7">ayi wukubakulanga.<verse eid="PSA 34:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>Lubimba ayi lutala ti Yave widi wumboti ;</para>
  <para style="q1" vid="PSA 34:8">Lusakumunu luidi kuidi mutu wowo wuntombanga suamunu mu niandi.<verse eid="PSA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>Lukinzika Yave beno banlongo bandi.</para>
  <para style="q1" vid="PSA 34:9">Bila bobo beti kunkinzika, balendi kambu kima ko.<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>Zikhosi zimvonganga</para>
  <para style="q1" vid="PSA 34:10">ayi zimfuanga nzala vayi bobo bantombanga Yave</para>
  <para style="q1" vid="PSA 34:10">balendi kambu kima ko.<verse eid="PSA 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>Yizanu bana bama, lungua.</para>
  <para style="q1" vid="PSA 34:11">Ndiela ku lulonga buevi bu kinzikilanga Yave.<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>Nani mutu mu beno wunzolanga luzingu,</para>
  <para style="q1" vid="PSA 34:12">ayi tidi mona bilumbu biwombo bi mboti<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>Vengumuna ludimi luaku mu mambu mambimbi,</para>
  <para style="q1" vid="PSA 34:13">ayi bididi biaku mu tuba mambu ma luvunu.<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>Botuka mu mambimbi vayi vanga mamboti.</para>
  <para style="q1" vid="PSA 34:14">Tomba ndembama ayi landakana yawu.<verse eid="PSA 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>Meso ma Yave mantalanga basonga</para>
  <para style="q1" vid="PSA 34:15">ayi makutu mandi madi mazibuka bu beti yamikina.<verse eid="PSA 34:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>Yave wunsuekanga zizi kiandi</para>
  <para style="q1" vid="PSA 34:16">kuidi batu bamvanganga mambimbi</para>
  <para style="q1" vid="PSA 34:16">mu diambu babika buela tebukulu moyo va ntoto.<verse eid="PSA 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>Batu basonga banyamikinanga ayi</para>
  <para style="q1" vid="PSA 34:17">Yave weti kuba wanga ayi wukubakulanga mu ziphasi ziawu zioso.<verse eid="PSA 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>Yave widi wufikama vadi batu bobo</para>
  <para style="q1" vid="PSA 34:18">badi mintima mi kofakana.</para>
  <para style="q1" vid="PSA 34:18">Ayi wumvukisanga bobo badi pheve yidi mu kiadi kingolo.<verse eid="PSA 34:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>Mutu wusonga wumbuilungu ziphasi ziwombo</para>
  <para style="q1" vid="PSA 34:19">vayi Yave wunkukulanga mu zizioso.<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>Niandi wunkebanga mimvesi miandi mioso</para>
  <para style="q1" vid="PSA 34:20">kadi wumosi wulendi keluka ko.<verse eid="PSA 34:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>Mambu mambimbi mela vonda mutu wumbimbi ;</para>
  <para style="q1" vid="PSA 34:21">bobo beti lenda nkua busonga</para>
  <para style="q1" vid="PSA 34:21">bela bedoso.<verse eid="PSA 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>Yave wunkulanga bisadi biandi,</para>
  <para style="q1" vid="PSA 34:22">ayi kadi wumosi mu babo bobo bansuaminanga mu niandi</para>
  <para style="q1" vid="PSA 34:22">kalendi bedoso ko.<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="cl">Minkunga 35</para>
  <para style="s1">Pfumu wunnuaninanga batu balebakana</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1"/>Zonzisa, a Yave, bobo balembo nzonzisa.</para>
  <para style="q1" vid="PSA 35:1">Nuanisa bobo balembo nduanisa,<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>simba nkaku wu fioti ayi wunneni</para>
  <para style="q1" vid="PSA 35:2">telama ayi yiza wutsadisa.<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>Bonga dionga difioti ayi dinneni ayi kaka nzila yi bobo balembo ndandakana</para>
  <para style="q1" vid="PSA 35:3">kamba muelꞌama :</para>
  <para style="q1" vid="PSA 35:3">“Minu ndidi phulusu aku.”<verse eid="PSA 35:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4"/>Bika batu babo bantombanga luzingu luama</para>
  <para style="q1" vid="PSA 35:4">baba dio kombolo ayi bafua tsoni.</para>
  <para style="q1" vid="PSA 35:4">Bika bobo bantombanga mabienga mama</para>
  <para style="q1" vid="PSA 35:4">bavutuka ku mbusa ayi baba mu divuda ;<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>bika baba banga mavevolo mamvevomono kuidi phemo</para>
  <para style="q1" vid="PSA 35:5">va kimosi ayi mbasi yi Yave yi bakuka.<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>Bika nsolo awu wuba tombi ayi ndelo.</para>
  <para style="q1" vid="PSA 35:6">Va kimosi ayi mbasi Yave yi balandakana.<verse eid="PSA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>Bila bathambididi dikondi diawu mu kambu bila ;</para>
  <para style="q1" vid="PSA 35:7">mu kambu kadi bila bakabidi dibulu dinneni</para>
  <para style="q1" vid="PSA 35:7">mu diambu diama.<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>Bika mbivusulu yi babuila mu kinzimbukila</para>
  <para style="q1" vid="PSA 35:8">ayi bika dikondi diodi batamba bawu veka dibabuila ;</para>
  <para style="q1" vid="PSA 35:8">bika babua mu dibulu, mu diambu di mbivusulu awu.<verse eid="PSA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>Buna muelꞌama wela mona khini mu Yave</para>
  <para style="q1" vid="PSA 35:9">ayi wela yangalala mu phulusu andi.<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>Buna nitu ama yimvimba yela yamikina :</para>
  <para style="q1" vid="PSA 35:10">“nani widi banga ngeyo Yave ?</para>
  <para style="q1" vid="PSA 35:10">Ngeyo weti kula nsukami mu mioko mi mutu wunlutidi zingolo ;</para>
  <para style="q1" vid="PSA 35:10">nsukami ayi nkua mabienga mu mioko mi mutu wowo wulembo bayibi.”<verse eid="PSA 35:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>Bambangi bakondolo kiadi zilembo telama ;</para>
  <para style="q1" vid="PSA 35:11">zilembo ndiuvula buivu mu mambu ma khambulu kuama zaba.<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>Bamvutudidi mambimbi mu mamboti.</para>
  <para style="q1" vid="PSA 35:12">Bayekudi muelꞌama wawu veka.<verse eid="PSA 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>Vayi bu baba mu kimbevo ; minu ndivuata tsaku<note caller="+" style="f"><char style="fr" closed="false">35.13 </char><char style="ft" closed="false">Vuata tsaku voti vuata kaniki.</char></note>.</para>
  <para style="q1" vid="PSA 35:13">Ndikikulula mu kukifuisa nzala mu diambu di lusambulu</para>
  <para style="q1" vid="PSA 35:13">Thangu zitsambulu ziama zivutuka kuidi minu mu kambu mvutu.<verse eid="PSA 35:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14"/>Ndibedi diatanga ku tsi kiadi</para>
  <para style="q1" vid="PSA 35:14">banga mu diambu di nkundi ama voti khomba ama.</para>
  <para style="q1" vid="PSA 35:14">Ndibedi komvikanga ntu ku tsi mu diambu di kiadi</para>
  <para style="q1" vid="PSA 35:14">banga minu ndindila ngudi ama.<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>Minu bu ndibumina thutu,</para>
  <para style="q1" vid="PSA 35:15">bakutakana va kimosi mu khini.</para>
  <para style="q1" vid="PSA 35:15">Batu bakutakana mu diambu di kunduanisa</para>
  <para style="q1" vid="PSA 35:15">minu mu kambu zaba diambu.</para>
  <para style="q1" vid="PSA 35:15">Bawu bamfinga mu kambu vonga.<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>Banga batu bobo bankinzikanga ko mambu ma Nzambi,</para>
  <para style="q1" vid="PSA 35:16">balembo tsekinina mu bu mbimbi</para>
  <para style="q1" vid="PSA 35:16">balembo khuetila meso.<verse eid="PSA 35:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>A Yave, nate thangu mbi wela kumatadidilanga e ?</para>
  <para style="q1" vid="PSA 35:17">Kula luzingu luama mu mbivusu awu ;</para>
  <para style="q1" vid="PSA 35:17">kula luzingu luama luthalu mu zikhosi zioso.<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>Ndiela kuvutudila matondo mu lukutukunu lunneni ;</para>
  <para style="q1" vid="PSA 35:18">va khatitsika batu bawombo ndiela kuzitisa.<verse eid="PSA 35:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>Kadi tala ti bamona khini mu diambu diama,</para>
  <para style="q1" vid="PSA 35:19">bobo badi bambeni ziama mu kambu bila ;</para>
  <para style="q1" vid="PSA 35:19">Kadi tala ti bobo bakundenganga mu kambu bila,</para>
  <para style="q1" vid="PSA 35:19">bandiengudila meso mu bumbimbi.<verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>Bayolukilanga ndembama ko ;</para>
  <para style="q1" vid="PSA 35:20">vayi banyindulanga mambu ma luvunu</para>
  <para style="q1" vid="PSA 35:20">mu diambu di vunina bobo banzingilanga mu ndembama mu tsi.<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>Balembo nzibudila miunu</para>
  <para style="q1" vid="PSA 35:21">ayi balembo tubi :</para>
  <para style="q1" vid="PSA 35:21">“A, a… mu meso meto veka tumueni mawu.”<verse eid="PSA 35:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>A Yave, ngeyo wumona mambu momo</para>
  <para style="q1" vid="PSA 35:22">bika ba dio sui,</para>
  <para style="q1" vid="PSA 35:22">kadi kuthatukila, a Yave,<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>kotuka ayi telama mu</para>
  <para style="q1" vid="PSA 35:23">zonzika, Nzambi ama ayi Yave ama.<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>Wundungisa boso buididi busonga buaku,</para>
  <para style="q1" vid="PSA 35:24">a Yave, Nzambi ama ;</para>
  <para style="q1" vid="PSA 35:24">ayi kadi tala ti bamona khini mu diambu diama.<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>Kadi kuba bika bayindula :</para>
  <para style="q1" vid="PSA 35:25">“A, a … buawu bobo tutididi.”</para>
  <para style="q1" vid="PSA 35:25">Voti babika tuba : “beto tumminini.”<verse eid="PSA 35:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>Bika babo bammonanga khini mu ziphasi ziama,</para>
  <para style="q1" vid="PSA 35:26">bafua tsoni ayi baba dio kombolo</para>
  <para style="q1" vid="PSA 35:26">Bika bobo balembo kukiniemisanga bawu veka mu diambu diama</para>
  <para style="q1" vid="PSA 35:26">bafua tsoni ayi baba dio kombolo.<verse eid="PSA 35:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>Bika bobo bamonanga khini mu ndungunu ama</para>
  <para style="q1" vid="PSA 35:27">bamonanga khini ayi bayangadala</para>
  <para style="q1" vid="PSA 35:27">bika batuba mu zithangu zioso :</para>
  <para style="q1" vid="PSA 35:27">“Bika Yave kayayusu, niandi wummonanga khini</para>
  <para style="q1" vid="PSA 35:27">mu mamboti ma kisadi kiandi.”<verse eid="PSA 35:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>Buna ludimi luama luela yolukila busonga buaku ;</para>
  <para style="q1" vid="PSA 35:28">ayi minzitusu miaku mu lumbu kimvimba.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="cl">Minkunga 36</para>
  <para style="s1">Mamboti ma Pfumu</para>
  <para style="d">Nkunga Davidi, kisadi ki Yave, kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1"/>Mambu ma Nzambi madi mu ntimꞌama</para>
  <para style="q1" vid="PSA 36:1">Mu mambu matedi disumu di mutu wumbimbi :</para>
  <para style="q1" vid="PSA 36:1">kuisi ko mambu ma kinzikila Nzambi va meso mandi.<verse eid="PSA 36:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>Bila va meso mandi veka,</para>
  <para style="q1" vid="PSA 36:2">weti kukiniemisa buwombo mu bakula voti lenda masumu mandi.<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>Mambu ma munuꞌandi madi mambimbi ayi ma luvunu.</para>
  <para style="q1" vid="PSA 36:3">Wulembo kuandi buela ba nkua nduenga</para>
  <para style="q1" vid="PSA 36:3">ayi bueba vanga mamboti.<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>Bu kadi va mbukꞌandi,</para>
  <para style="q1" vid="PSA 36:4">wunyindulanga mambu mambimbi.</para>
  <para style="q1" vid="PSA 36:4">Weti kukiyekula niandi veka mu nzila yi masumu</para>
  <para style="q1" vid="PSA 36:4">kalozanga ko mambu mambimbi.<verse eid="PSA 36:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>Luzolo luaku, a Yave, lueti tula nate ku diyilu</para>
  <para style="q1" vid="PSA 36:5">kikhuikizi kiaku nate mu matuti<verse eid="PSA 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>Busonga buaku buidi banga miongo minda ;</para>
  <para style="q1" vid="PSA 36:6">zinzengolo ziaku zidi banga dibulu dinneni.</para>
  <para style="q1" vid="PSA 36:6">O Yave, ngeyo wunkebanga mutu ayi bulu.<verse eid="PSA 36:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7"/>Tala phila luzolo luaku lu ngolo lukambu thalu !</para>
  <para style="q1" vid="PSA 36:7">Luidi luzangulu ayi lukululu va khatitsika batu</para>
  <para style="q1" vid="PSA 36:7">bobo bansuaminanga ku tsi phozi yi mavevi maku.<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>Beti tula minyengo mu wombo di bima bi nzo aku</para>
  <para style="q1" vid="PSA 36:8">ayi ngeyo wukubanuikinanga mu nlangu</para>
  <para style="q1" vid="PSA 36:8">wu makhini maku.<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>Bila kuidi ngeyo kuidi tho yi luzingu.</para>
  <para style="q1" vid="PSA 36:9">Mu kiezila kiaku, tulembo moni kiezila.<verse eid="PSA 36:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>Landakana vanga luzolo luaku kuidi bawu bazebi</para>
  <para style="q1" vid="PSA 36:10">ayi busonga buaku kuidi bawu badi mintima mi lulama.<verse eid="PSA 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>Bika kulu ku nkua luniemo kubika kumbakidila ;</para>
  <para style="q1" vid="PSA 36:11">voti bika koko ku mutu wumbimbi kubika kuthinisa thama.<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>Tala phila yilembo buila bisadi bi mambu mambimbi ;</para>
  <para style="q1" vid="PSA 36:12">balumbulu va tsi ayi balendi buela telama ko.<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="cl">Minkunga 37</para>
  <para style="s1">Khindusulu yi mutu wusonga</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1"/>Kadi fuemina batu bamvanganga mambimbi.</para>
  <para style="q1" vid="PSA 37:1">Kadi monanga kikhenene bobo bamvanganga mambimbi.<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>Bila banga biti, bela yuma mu nsualu ;</para>
  <para style="q1" vid="PSA 37:2">banga biti bi nlangu bela lebuka mu nsualu.<verse eid="PSA 37:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>Tula diana diaku mu Yave ayi vanga mamboti ;</para>
  <para style="q1" vid="PSA 37:3">buna wela vuanda mu tsi ayi wela zingila mu ndembama.<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>Mona khini mu Yave</para>
  <para style="q1" vid="PSA 37:4">buna wela kuvana mambu mantomba ntimꞌaku.<verse eid="PSA 37:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>Yekula nzilꞌaku kuidi Yave,</para>
  <para style="q1" vid="PSA 37:5">Tula diana diaku mu niandi,</para>
  <para style="q1" vid="PSA 37:5">buna wela vanga diambu diadi :<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>Wela kienzula busonga buaku banga kiezila ki khiesa buisi</para>
  <para style="q1" vid="PSA 37:6">nzengolo yi diambu diaku banga thangu va midi.<verse eid="PSA 37:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>Ba dio sui va ntuala Yave,</para>
  <para style="q1" vid="PSA 37:7">ayi wuntadidila mu mvibudulu</para>
  <para style="q1" vid="PSA 37:7">kadi fuemina batu bu balembo</para>
  <para style="q1" vid="PSA 37:7">moni mamboti mu nzilꞌandi ;</para>
  <para style="q1" vid="PSA 37:7">ayi kadi fuemina batu balembo sadila</para>
  <para style="q1" vid="PSA 37:7">makani mawu mambimbi.<verse eid="PSA 37:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>Bika buela fuema ayi zimbakana nganzi ;</para>
  <para style="q1" vid="PSA 37:8">kadi fuema bila dieti nata kaka ku mambu mambimbi.<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>Bila bobo bamvanganga mambimbi bela lalukusu ;</para>
  <para style="q1" vid="PSA 37:9">vayi bobo bantulanga diana diawu mu Yave bela tambula tsi banga kiuka.<verse eid="PSA 37:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>Fioti kuandi fisiedi, buna batu bambimbi balendi buela monika ko ;</para>
  <para style="q1" vid="PSA 37:10">buna wela tala buangu kibabedi vayi bela va ba ko.<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>Vayi minlembami miela tambula tsi banga kiuka</para>
  <para style="q1" vid="PSA 37:11">ayi miela monanga khini mu ndembama yiwombo.<verse eid="PSA 37:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>Batu bambimbi bamfielanga batu basonga</para>
  <para style="q1" vid="PSA 37:12">ayi beti kuba kuetila meno.<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>Yave wunsevanga mutu wumbimbi ;</para>
  <para style="q1" vid="PSA 37:13">bila zebi ti lumbu kiandi kalembo yizi.<verse eid="PSA 37:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>Batu bambimbi bavola bisabala</para>
  <para style="q1" vid="PSA 37:14">ayi baleka mimbasa mu diambu di vonda</para>
  <para style="q1" vid="PSA 37:14">nkua kiadi ayi mutu wusukama ;</para>
  <para style="q1" vid="PSA 37:14">mu diambu di zenga bobo</para>
  <para style="q1" vid="PSA 37:14">bandiatanga mu nzila yi lulama.<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>Bisabala biawu biela kota mu mintima miawu veka ;</para>
  <para style="q1" vid="PSA 37:15">ayi mimbasa miawu miela kelulu.<verse eid="PSA 37:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>Baka ku fioti ku mutu wusonga kulutidi</para>
  <para style="q1" vid="PSA 37:16">ayi baka kuphuedi ku wombo di batu bambimbi.<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>Bila lulendo lu batu bambimbi luela kelulu,</para>
  <para style="q1" vid="PSA 37:17">vayi Yave wunsimbanga batu basonga.<verse eid="PSA 37:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>Bilumbu bi batu bakambulu tsembolo bizabikini kuidi Yave</para>
  <para style="q1" vid="PSA 37:18">ayi kiuka kiawu kizingilanga</para>
  <para style="q1" vid="PSA 37:18">mu zithangu zioso.<verse eid="PSA 37:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>Mu thangu yi ziphasi, balendi yuma ko</para>
  <para style="q1" vid="PSA 37:19">mu lumbu ki nzala, bawu bela mona khini yiwombo.<verse eid="PSA 37:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>Vayi batu bambimbi bela bungana.</para>
  <para style="q1" vid="PSA 37:20">Bambeni zi Yave, badi banga kitoko ki zitsola,</para>
  <para style="q1" vid="PSA 37:20">ziela lalakana ; ziela lalakana banga muisi.<verse eid="PSA 37:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>Mutu wumbimbi wundevanga vayi kavutulanga ko ;</para>
  <para style="q1" vid="PSA 37:21">Vayi mutu wusonga weti kabula mu luzolo lu ntima.<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>Bobo Yave kasakumuna</para>
  <para style="q1" vid="PSA 37:22">bela tambula tsi banga kiuka,</para>
  <para style="q1" vid="PSA 37:22">vayi bobo kasinga bela lalukusu.<verse eid="PSA 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>Enati Yave mueni khini mu nzila yi mutu</para>
  <para style="q1" vid="PSA 37:23">buna wunkindisanga zithambi zi mutu beni.<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>Ka diambu ko bumini thutu ; kalendi bua ko ;</para>
  <para style="q1" vid="PSA 37:24">bila Yave wukunsimbidilanga mu koko kuandi.<verse eid="PSA 37:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>Ndiba ditoko, buabu ndieka nunu ;</para>
  <para style="q1" vid="PSA 37:25">vayi ndisia mona ko mutu wusonga wuyekolo</para>
  <para style="q1" vid="PSA 37:25">voti ndisia mona ko bana bandi balomba dipha.<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>Mu zithangu zioso, beti kabula ayi vananga mu luzolo</para>
  <para style="q1" vid="PSA 37:26">Bana bawu bela sakumunu.<verse eid="PSA 37:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>Tina mambimbi ; vanga mamboti</para>
  <para style="q1" vid="PSA 37:27">buna wela vuanda mu tsi mu zithangu zioso.<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>Bila Yave wunzolanga mambu masonga</para>
  <para style="q1" vid="PSA 37:28">ayi kalendi zimbakana ko mikhuikizi miandi.</para>
  <para style="q1" vid="PSA 37:28">Bela kebungu mu zithangu zioso</para>
  <para style="q1" vid="PSA 37:28">vayi nkuna wu batu bambimbi wela lalukusu.<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>Batu basonga bela tambula tsi banga kiuka</para>
  <para style="q1" vid="PSA 37:29">ayi bela mukalanga mu zithangu zioso.<verse eid="PSA 37:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>Munu wu mutu wusonga wuntotulanga mambu ma nduenga</para>
  <para style="q1" vid="PSA 37:30">ayi ludimi luandi luntubanga mambu ma lulama.<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>Mina mi Nzambi andi midi mu ntimꞌandi ;</para>
  <para style="q1" vid="PSA 37:31">Malu mandi malendi sialumuka ko.<verse eid="PSA 37:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>Mutu wumbimbi wumfielanga mutu wusonga</para>
  <para style="q1" vid="PSA 37:32">ayi wuntombanga kumvondisa.<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>Yave kalendi yekula ko basonga mu lulendo lu batu bambimbi</para>
  <para style="q1" vid="PSA 37:33">voti kuba bika babedoso bu balembo sambusu.<verse eid="PSA 37:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>Tadidila Yave,</para>
  <para style="q1" vid="PSA 37:34">ayi keba nzilꞌandi.</para>
  <para style="q1" vid="PSA 37:34">Buna wela kuyayisa mu diambu wutambula tsi banga kiuka ;</para>
  <para style="q1" vid="PSA 37:34">thangu batu bambimbi bela lalukusu,</para>
  <para style="q1" vid="PSA 37:34">ngeyo wela bumona.<verse eid="PSA 37:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>Ndimona mutu wumbimbi, ayi mutu kondolo kiadi,</para>
  <para style="q1" vid="PSA 37:35">wuyunduka bumboti banga nti wu nlangu</para>
  <para style="q1" vid="PSA 37:35">mu ntoto wowo kabutukila.<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>Niandi wuvioka, nsualu ayi kasiedi ko.</para>
  <para style="q1" vid="PSA 37:36">Ndintombidi ngolo vayi kasia monika ko.<verse eid="PSA 37:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>Fiongunina mutu kambulu tsembolo</para>
  <para style="q1" vid="PSA 37:37">ayi tala tala mutu wu lulama buna wela mona ti tsukulu</para>
  <para style="q1" vid="PSA 37:37">yi mutu wowo yidi tsukulu yi ndembama.<verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>Vayi bankua masumu boso bela vondo va kimosi</para>
  <para style="q1" vid="PSA 37:38">tsukulu yi batu bambimbi yela ba lalukusu.<verse eid="PSA 37:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>Phulusu yi batu basonga kuidi Yave yeti ba.</para>
  <para style="q1" vid="PSA 37:39">Niandi zingolo ziawu mu thangu yi ziphasi.<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>Yave wukubasadisanga ayi wukubakulanga ;</para>
  <para style="q1" vid="PSA 37:40">wukubakulanga mu batu bambimbi</para>
  <para style="q1" vid="PSA 37:40">ayi wukubavukisanga bila mu niandi</para>
  <para style="q1" vid="PSA 37:40">beti suamina.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="cl">Minkunga 38</para>
  <para style="s1">Wuyamusu kuidi kimbevo ayi masumu</para>
  <para style="d">Nkunga Davidi mu diambu di thebokolo moyo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1"/>A Yave, kadi kuthemima ku tsi nganzi aku</para>
  <para style="q1" vid="PSA 38:1">voti kadi kuphana thumbudulu ku tsi nganzi aku yi kikhesa.<verse eid="PSA 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>Bila madionga maku mathobudi</para>
  <para style="q1" vid="PSA 38:2">ayi koko kuaku kumbetidi.<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>Mu diambu di nganzi aku yi kikhesa, buvini buisi ko mu nitu ama.</para>
  <para style="q1" vid="PSA 38:3">Mimvesi miama misiedi ko buvini</para>
  <para style="q1" vid="PSA 38:3">mu diambu di masumu mama.<verse eid="PSA 38:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>Zinzimbala ziama zimfietikisidi ngolo</para>
  <para style="q1" vid="PSA 38:4">banga mfuna widi zitu kiwombo ;</para>
  <para style="q1" vid="PSA 38:4">madidi ngolo zitu mu diambu diama</para>
  <para style="q1" vid="PSA 38:4">banga mfuna wu ngolo.<verse eid="PSA 38:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>Ziphuta ziama zilembo bodi ngolo yiwombo</para>
  <para style="q1" vid="PSA 38:5">ayi zilembo yizi tsudi yiwombo</para>
  <para style="q1" vid="PSA 38:5">mu diambu di buvulu buama bu masumu.<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>Ndidi wukomvama ngolo ayi khulukidi nate va tsi ;</para>
  <para style="q1" vid="PSA 38:6">Lumbu ki mvimba mu kiadi ndieti diatila.<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>Bila ziphasi zingolo zidi mu luketo luama,</para>
  <para style="q1" vid="PSA 38:7">buvini buisi ko mu nitu ama.<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>Ndidi wuvonga ngolo ayi ndidi wukosakana mvimba.</para>
  <para style="q1" vid="PSA 38:8">Ndilembo kungi mu diambu di ziphasi zi ntima.<verse eid="PSA 38:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>Zitsatu ziama zioso zidi dio yambi va ntualꞌaku, a Yave,</para>
  <para style="q1" vid="PSA 38:9">ayi vumina kuama kuisi ko kusuama kuidi ngeyo.<verse eid="PSA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>Ntimꞌama wulembo sadi ngolo</para>
  <para style="q1" vid="PSA 38:10">ayi zingolo ziama zimeni ;</para>
  <para style="q1" vid="PSA 38:10">kiezila kibotukidi mu meso mama.<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>Bakundi bama ayi bobo bankibanga yama</para>
  <para style="q1" vid="PSA 38:11">bathinini mu diambu di ziphuta ziama ;</para>
  <para style="q1" vid="PSA 38:11">bobo bafikasana yama thama batelimini.<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>Bobo bantomba luzingu luama balembo mintambu miawu</para>
  <para style="q1" vid="PSA 38:12">bobo bantomba kuphanga mbimbi</para>
  <para style="q1" vid="PSA 38:12">balembo yolukila mbivusu ama ;</para>
  <para style="q1" vid="PSA 38:12">Mu lumbu kimvimba balembo kubika mambu ma luvunu.<verse eid="PSA 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>Minu, ndieka banga mutu wufua matu,</para>
  <para style="q1" vid="PSA 38:13">wunkambu wa ; banga dibaba dikambu zibula munu andi.<verse eid="PSA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>Ndieka banga mutu wowo wu nkambu wa</para>
  <para style="q1" vid="PSA 38:14">mutu wowo munu wunkambu baka bu vutudila mvutu.<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>Ngeyo ndieti tadidila, a Yave,</para>
  <para style="q1" vid="PSA 38:15">wela vutula mvutu, a Yave Nzambi ama.<verse eid="PSA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>Bila ndituba : “kadi tala ti bamona khini</para>
  <para style="q1" vid="PSA 38:16">voti bakiyayisa bawu veka mu diambu diama.</para>
  <para style="q1" vid="PSA 38:16">Kulu kuama bu kusialumukini.”<verse eid="PSA 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>Bila nduka bua ndieka</para>
  <para style="q1" vid="PSA 38:17">ayi ziphasi ziama zidi kaka mu minu.<verse eid="PSA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>Ndimfunda mbimbi ama.</para>
  <para style="q1" vid="PSA 38:18">Ndilembo niongi mu diambu di disumu diama.<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>Bawombo badi bambeni ziama ; ziozi zibeki zingolo.</para>
  <para style="q1" vid="PSA 38:19">Bobo bakundendanga mu kambu bila badi bawombo.<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>Bobo bakuphutudilanga mambimbi mu mamboti mama</para>
  <para style="q1" vid="PSA 38:20">balembo thubidila ku ndambu</para>
  <para style="q1" vid="PSA 38:20">mu thangu ndinlandakana vanga mamboti.<verse eid="PSA 38:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>A Yave, kadi kundiekula ; kadi kuthatukila Nzambi ama.<verse eid="PSA 38:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>Yiza nsualu mu kutsadisa,</para>
  <para style="q1" vid="PSA 38:22">A Yave, Mvulusi ama.<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="cl">Minkunga 39</para>
  <para style="s1">Va ntuala lufua</para>
  <para style="d">Nkunga Davidi kuidi Yedutuni, pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1"/>Minu ndituba : “ndiela sunga zinzila ziama</para>
  <para style="q1" vid="PSA 39:1">ayi ndiela keba ludimi luama mu masumu.</para>
  <para style="q1" vid="PSA 39:1">Ndiela tula luvambu mu munuꞌama mu zithangu zioso</para>
  <para style="q1" vid="PSA 39:1">batu bambimbi bela banga ku ntuala meso mama.”<verse eid="PSA 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>Bu ndiba dio sui ayi ndidingalala</para>
  <para style="q1" vid="PSA 39:2">ayi bu ndisia tuba kadi diambu ko.</para>
  <para style="q1" vid="PSA 39:2">Vayi ziphasi ziama buelama na buelama zilembo zibuelama.<verse eid="PSA 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3"/>Ntimꞌama wulema mu khati nitu ama ;</para>
  <para style="q1" vid="PSA 39:3">ayi bu ndiyindula, buna mbazu yilema.</para>
  <para style="q1" vid="PSA 39:3">Diawu nditumbu tubila mu ludimi luama :<verse eid="PSA 39:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>“Wumbonisa, a Yave tsukulu yi luzingu luama ;</para>
  <para style="q1" vid="PSA 39:4">ayi thalu yi bilumbu biama</para>
  <para style="q1" vid="PSA 39:4">bika wunzabikisa ti luzingu luama vioka lu mvioka !<verse eid="PSA 39:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>Ngeyo wuvanga bilumbu biama</para>
  <para style="q1" vid="PSA 39:5">siadila banga dikanda diama</para>
  <para style="q1" vid="PSA 39:5">Tezo ki mimvu miama kisi ko kadi mfunu va ntanlꞌaku.</para>
  <para style="q1" vid="PSA 39:5">Kadika luzingu lu mutu luidi kaka phemo.<verse eid="PSA 39:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>Mutu widi khatika kimbindi</para>
  <para style="q1" vid="PSA 39:6">bu keti kuenda ayi vutuka weti banga mayindu, vayi mu phamba kuandi ;</para>
  <para style="q1" vid="PSA 39:6">weti kupika bima vayi kakadi zaba nani wela bitota.<verse eid="PSA 39:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>Vayi buabu, Yave, mbi mfueti vingila e ?</para>
  <para style="q1" vid="PSA 39:7">Diana diama didi mu ngeyo.<verse eid="PSA 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>Wuphukisa mu zinzimbala ziama zioso ;</para>
  <para style="q1" vid="PSA 39:8">kadi kundiekula ndikituka sekonono ki bivulu.<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>Ndiba dio sui ; ndisia zibula munu ama ko</para>
  <para style="q1" vid="PSA 39:9">bila ngeyo wuvanga buawu.<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>Wuphengumunina nsongo aku.</para>
  <para style="q1" vid="PSA 39:10">Ndieka suka mu diambu di bikoti bi mioko miaku.<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>Ngeyo weti tubidila ayi weti vana batu thumbudulu</para>
  <para style="q1" vid="PSA 39:11">mu diambu di masumu mawu.</para>
  <para style="q1" vid="PSA 39:11">Ngeyo weti zinisa kimvuama kiawu banga kiphepele</para>
  <para style="q1" vid="PSA 39:11">kadika mutu widi phemo.<verse eid="PSA 39:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>Wa lusambulu luama ; a Yave !</para>
  <para style="q1" vid="PSA 39:12">Dimba yamikina kuama mu diambu di lusadusu.</para>
  <para style="q1" vid="PSA 39:12">Kadi lasakana mu bidilu biama ;</para>
  <para style="q1" vid="PSA 39:12">bila ndieti kalanga yaku va kimosi banga nzenza,</para>
  <para style="q1" vid="PSA 39:12">banga nkibi, banga bakulu bama boso.<verse eid="PSA 39:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>Wuphengumunina thaluꞌaku</para>
  <para style="q1" vid="PSA 39:13">muingi ndimona diaka khini</para>
  <para style="q1" vid="PSA 39:13">tuamina ndunda ayi ndibika buela monika.”<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="cl">Minkunga 40</para>
  <para style="s1">Phulusu yi Nzambi yi kisadi kiandi</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1"/>Ndieti tadidila Yave mu mvibudulu.</para>
  <para style="q1" vid="PSA 40:1">Niandi wubaluka kuidi minu</para>
  <para style="q1" vid="PSA 40:1">ayi wuwa yamikina kuama.<verse eid="PSA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>Niandi wuthampula mu dibulu di tsisi,</para>
  <para style="q1" vid="PSA 40:2">mu khati nyamba wu ngolo.</para>
  <para style="q1" vid="PSA 40:2">Wutula malu mama va ditadi,</para>
  <para style="q1" vid="PSA 40:2">wuphana buangu kikinda kioki ndilenda telama.<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>Niandi wutula nkunga wumona va munu ama ;</para>
  <para style="q1" vid="PSA 40:3">nkunga wu zitisila Nzambi eto,</para>
  <para style="q1" vid="PSA 40:3">Batu bawombo bela mona ayi bela mona tsisi ;</para>
  <para style="q1" vid="PSA 40:3">ayi bela tula diana diawu mu Yave.<verse eid="PSA 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>Lusakumunu kuidi mutu wunkitulanga Yave diana diandi ;</para>
  <para style="q1" vid="PSA 40:4">ayi wunkambu talanga bankua luniemo</para>
  <para style="q1" vid="PSA 40:4">kuidi bobo beti baluka kuidi zinzambi zi luvunu.<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>A Yave, Nzambi ama, ngeyo wuvanga matsiminanga mawombo ;</para>
  <para style="q1" vid="PSA 40:5">ayi bima biobi wukubika mu diambu dieto.</para>
  <para style="q1" vid="PSA 40:5">Kuisiko mutu wulenda kutangila biawu.</para>
  <para style="q1" vid="PSA 40:5">Enati thidi ku mayolukila ayi ku matubila ;</para>
  <para style="q1" vid="PSA 40:5">mawu mawokidi ngolo muingi ndimasamuna.<verse eid="PSA 40:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>Makaba ma vonda ayi makaba matambuku ;</para>
  <para style="q1" vid="PSA 40:6">ngeyo wumanga mawu ;</para>
  <para style="q1" vid="PSA 40:6">Ngeyo wutobula matu mama.</para>
  <para style="q1" vid="PSA 40:6">Makaba mayoko ayi makaba mu diambu di masumu,</para>
  <para style="q1" vid="PSA 40:6">ngeyo wusia malomba ko.<verse eid="PSA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>Buna ndituba :</para>
  <para style="q1" vid="PSA 40:7">“ndilembo yizi ; didi disonama mu diambu diama</para>
  <para style="q1" vid="PSA 40:7">mu buku ti :<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>Minu thidi vanga luzolo luaku ; a Nzambi ama,</para>
  <para style="q1" vid="PSA 40:8">Mina miaku midi mu ntimꞌama.”<verse eid="PSA 40:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>Ndinyamikisa busonga buaku mu lukutukunu lunneni.</para>
  <para style="q1" vid="PSA 40:9">Ndisia zibika bididi biama ko.</para>
  <para style="q1" vid="PSA 40:9">Banga kuandi buzebi, a Yave.<verse eid="PSA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>Ndisi sueka ko busonga buaku mu ntimꞌama.</para>
  <para style="q1" vid="PSA 40:10">Ndiyolukila kikhuikizi kiaku</para>
  <para style="q1" vid="PSA 40:10">ayi phulusu aku.</para>
  <para style="q1" vid="PSA 40:10">Ndisia sueka ko luzolo luaku</para>
  <para style="q1" vid="PSA 40:10">ayi kiedika kiaku mu lukutukunu lunneni.<verse eid="PSA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>Kadi zimbakana kumbonanga kiadi, a Yave.</para>
  <para style="q1" vid="PSA 40:11">Bika Luzolo luaku ayi kiedika kiaku</para>
  <para style="q1" vid="PSA 40:11">bikhebanga mu zithangu zioso.<verse eid="PSA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>Bila ziphasi ziwombo zikambu zabakana</para>
  <para style="q1" vid="PSA 40:12">thalu zinzungididi.</para>
  <para style="q1" vid="PSA 40:12">Masumu mama mambakidila,</para>
  <para style="q1" vid="PSA 40:12">ayi ndikadi mona.</para>
  <para style="q1" vid="PSA 40:12">Maviokidi zitsuki ziama zi ntu mu thalu.</para>
  <para style="q1" vid="PSA 40:12">Ayi ntimꞌama wulembo vongi mu minu.<verse eid="PSA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>Yangalala, a Yave, mu kuphukisa</para>
  <para style="q1" vid="PSA 40:13">A Yave, yiza nsualu mu kutsadisa.<verse eid="PSA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>Bika babo bobo bantomba baka luzingu luama ;</para>
  <para style="q1" vid="PSA 40:14">bafua tsoni ayi baba dio kombolo</para>
  <para style="q1" vid="PSA 40:14">bika babo bammonanga khini mu mbivusu ama baba dio kombolo.<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>Bika babo bobo bantubanga kuidi minu :</para>
  <para style="q1" vid="PSA 40:15">“A, a…” bamona tsisi mu diambu di zitsoni ziawu veka<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>Vayi bika babo bobo bakutombanga bayangalala,</para>
  <para style="q1" vid="PSA 40:16">ayi bamona khini mu ngeyo.</para>
  <para style="q1" vid="PSA 40:16">Bika babo banzolanga phulusu aku batuba mu zithangu zioso :</para>
  <para style="q1" vid="PSA 40:16">“Bika Yave kayayusu.”<verse eid="PSA 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>Vayi minu, ndidi mu kiadi ayi nsukami,</para>
  <para style="q1" vid="PSA 40:17">bika Yave kambanzila.</para>
  <para style="q1" vid="PSA 40:17">Ngeyo nsadisi ama ayi nkudi ama.</para>
  <para style="q1" vid="PSA 40:17">Nzambi ama, kadi zingila.<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="cl">Minkunga 41</para>
  <para style="s1">Lusambulu lu mbevo</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1"/>Lusakumunu kuidi mutu wowo thaluꞌandi yidi kuidi mutu wulebakana,</para>
  <para style="q1" vid="PSA 41:1">Yave weti ku nkula mu thangu yi ziphasi.<verse eid="PSA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>Yave wela kunkeba ayi wela tanina luzingu luandi ;</para>
  <para style="q1" vid="PSA 41:2">wela kunsakumuna va ntoto</para>
  <para style="q1" vid="PSA 41:2">ayi kalendi kunyekula ko mu luzolo</para>
  <para style="q1" vid="PSA 41:2">lu bobo beti kunlenda ;<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>Yave wela kunkindisa va mfulu andi yi kimbevo.</para>
  <para style="q1" vid="PSA 41:3">Ngeyo wela kumbelusa va mfulu andi yi kimbevo.<verse eid="PSA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>Ndituba : “A Yave, wumboni kiadi.</para>
  <para style="q1" vid="PSA 41:4">Wumbelusa bila kuidi ngeyo ndivodidi masumu.”<verse eid="PSA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>Bambeni ziama zilembo tubi mambu mu diela dimbimbi</para>
  <para style="q1" vid="PSA 41:5">mu diambu diama : “Thangu mbi kela fua</para>
  <para style="q1" vid="PSA 41:5">ayi dizina diandi diela lalakana e ?”<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>yoso thangu mutu kizidi mu kuthala ;</para>
  <para style="q1" vid="PSA 41:6">mutu wowo wuntubanga luvunu.</para>
  <para style="q1" vid="PSA 41:6">Ntimꞌandi wufulukidi mambu ma mvuezolo ;</para>
  <para style="q1" vid="PSA 41:6">buna wuntotukanga ku nganda ayi wunyolukilanga mawu.<verse eid="PSA 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>Bambeni ziama zioso zilembo niunguta va kimosi mu diambu diama.</para>
  <para style="q1" vid="PSA 41:7">Balembo yindula mambimbi mu diambu diama,</para>
  <para style="q1" vid="PSA 41:7">balembo tubi :<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>“Nsongo wumbimbi wumbuididi.</para>
  <para style="q1" vid="PSA 41:8">Kalendi buela vumbuka ko va buangu kioki kalambididi.”<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>Ka diambu ko nkundi ama wu luzolo,</para>
  <para style="q1" vid="PSA 41:9">wowo ndibedi silanga diana,</para>
  <para style="q1" vid="PSA 41:9">wubedi kabulanga dipha diama, wumbalumukini.<verse eid="PSA 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>Vayi ngeyo Yave, wumboni kiadi</para>
  <para style="q1" vid="PSA 41:10">wuthedimisa.</para>
  <para style="q1" vid="PSA 41:10">Muingi ndiba vutudila landi.<verse eid="PSA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>Nzebi ti ngeyo wunyangalalanga mu minu ;</para>
  <para style="q1" vid="PSA 41:11">mu diambu di mbeni ama kabika kundunga.<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>Mu bufuana kuama, ngeyo wutsimba ;</para>
  <para style="q1" vid="PSA 41:12">wuthedimisa mu zithangu zioso va tuala meso maku.<verse eid="PSA 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>Nzitusu wuba kuidi Yave, Nzambi yi Iseli,</para>
  <para style="q1" vid="PSA 41:13">mu thangu yi kayimani.</para>
  <para style="qr" vid="PSA 41:13">Ameni ayi Ameni !<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">BUKU YIMMUADI</para>
  <para style="cl">Minkunga 42</para>
  <para style="s1">Phuila yi Nzambi ndieti mona</para>
  <para style="d">Nkunga bana ba babakala ba Kole kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1"/>Boso bummoninanga disofi phuila yi nlangu,</para>
  <para style="q1" vid="PSA 42:1">buawu bobo muelꞌama wididi phuila yi ngeyo ;</para>
  <para style="q1" vid="PSA 42:1">Nzambi ama.<verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>Muelꞌama wulembo moni phuila yi Nzambi,</para>
  <para style="q1" vid="PSA 42:2">Phuila yi Nzambi yi moyo.</para>
  <para style="q1" vid="PSA 42:2">Thangu mbi ndiela nkuenda ayi ndiela dengana Nzambi e ?<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>Matsuela mama mawu maba bidia biama</para>
  <para style="q1" vid="PSA 42:3">mu builu ayi muini bu babedi ku khambanga mu lumbu kimvimba :</para>
  <para style="q1" vid="PSA 42:3">“Kuevi kuidi Nzambi aku e ?”<verse eid="PSA 42:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>Mambu momo ndieti tebukila moyo</para>
  <para style="q1" vid="PSA 42:4">banga minu ndintiamuna muelꞌama :</para>
  <para style="q1" vid="PSA 42:4">buevi ndibedi kuendilanga va kimosi</para>
  <para style="q1" vid="PSA 42:4">ayi nkangu wu batu, mu kuba diatisa mu ntanda</para>
  <para style="q1" vid="PSA 42:4">nate ku nzo Nzambi</para>
  <para style="q1" vid="PSA 42:4">mu biyoko bi khini ayi mu phutudulu yi matondo</para>
  <para style="q1" vid="PSA 42:4">va khatitsika batu bawombo badi mu nyengo.<verse eid="PSA 42:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>Bila mbi vongidi bobo, a muelꞌama e ?</para>
  <para style="q1" vid="PSA 42:5">Bila mbi muelꞌama wulembo niongina</para>
  <para style="q1" vid="PSA 42:5">mu khati ama e ?</para>
  <para style="q1" vid="PSA 42:5">Tula diana diaku mu Nzambi bila ndiela kunzitisa diaka ;</para>
  <para style="q1" vid="PSA 42:5">Mvulusi ama ayi Nzambi ama.<verse eid="PSA 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>Muelꞌama widi wuvonga mu khati nitu ama</para>
  <para style="q1" vid="PSA 42:6">Diawu ndiela kutebukilanga moyo</para>
  <para style="q1" vid="PSA 42:6">tona ku tsi yi Yolidani, ku zitsongi zi miongi</para>
  <para style="q1" vid="PSA 42:6">mi Elimoni ayi tona ku mongo wu Mizali.<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>Kiza kieta tela kiza kinkaka</para>
  <para style="q1" vid="PSA 42:7">mu khumbulu yi minlangu mu zithadi ziaku.</para>
  <para style="q1" vid="PSA 42:7">Mayo maku mamo mafioti ayi manneni ma mbukimini.<verse eid="PSA 42:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>Mu muini, Yave wumfidisanga luzolo luandi</para>
  <para style="q1" vid="PSA 42:8">Mu builu nkungꞌandi widi va minu</para>
  <para style="q1" vid="PSA 42:8">lusambulu kuidi Nzambi yi luzingu luama.<verse eid="PSA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>Ndintuba kuidi Nzambi,</para>
  <para style="q1" vid="PSA 42:9">ditadi diama di ngolo :</para>
  <para style="q1" vid="PSA 42:9">“Bila mbi wunzimbikini e ?</para>
  <para style="q1" vid="PSA 42:9">Bila mbi mfueti diatilanga mu phasi,</para>
  <para style="q1" vid="PSA 42:9">yamusungu kuidi mbeni e ?”<verse eid="PSA 42:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>Mimvesi miama milmbo moni phasi yi lufua ;</para>
  <para style="q1" vid="PSA 42:10">batu bobo bandendi bu balembo mfingi</para>
  <para style="q1" vid="PSA 42:10">bu beti ku khambanga mu lumbu kimvimba ti :</para>
  <para style="q1" vid="PSA 42:10">“Kuevi kuidi Nzambi aku e ?”<verse eid="PSA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>Bila mbi vongidi bobo, a muelꞌama e ?</para>
  <para style="q1" vid="PSA 42:11">Bila mbi wulembo niongina mu khati ama e ?</para>
  <para style="q1" vid="PSA 42:11">Tula diana diaku mu Nzambi</para>
  <para style="q1" vid="PSA 42:11">bila ndiela kunzitisa diaka ;</para>
  <para style="q1" vid="PSA 42:11">niandi Mvulusi ama ayi Nzambi ama.<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="cl">Minkunga 43</para>
  <para style="s1">Tula diana diaku mu Nzambi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1"/>Wundungisa, a Nzambi,</para>
  <para style="q1" vid="PSA 43:1">ayi wunzonzila mu mambu mama kuidi dikanda di batu dinkambu</para>
  <para style="q1" vid="PSA 43:1">kinzikanga mambu maku.</para>
  <para style="q1" vid="PSA 43:1">Wukhula mu batu ba luvunu ayi batu bambimbi.<verse eid="PSA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2"/>Ngeyo Nzambi, ngeyo zingolo ziama.</para>
  <para style="q1" vid="PSA 43:2">Bila mbi wundozidi e ?</para>
  <para style="q1" vid="PSA 43:2">Bila mbi mfueti diatilanga mu phasi,</para>
  <para style="q1" vid="PSA 43:2">yamusungu kuidi mbeni e ?<verse eid="PSA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>Fidisa kiezila ayi Kiedika kiaku ;</para>
  <para style="q1" vid="PSA 43:3">bila bindiatisa,</para>
  <para style="q1" vid="PSA 43:3">bika bindata ku mongo aku wunlongo</para>
  <para style="q1" vid="PSA 43:3">ayi nate ku buangu kioki weti vuanda.<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>Buna ndiela kuenda ku ntala wu Nzambi ;</para>
  <para style="q1" vid="PSA 43:4">kuidi Nzambi khini ama</para>
  <para style="q1" vid="PSA 43:4">ayi yangalala kuama.</para>
  <para style="q1" vid="PSA 43:4">Buna ndiela kunzitisa mu ngitala,</para>
  <para style="q1" vid="PSA 43:4">A Nzambi, Nzambi ama.<verse eid="PSA 43:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>Bila mbi vongidi bobo, a muelꞌala e ?</para>
  <para style="q1" vid="PSA 43:5">Bila mbi wulembo niongina mu khati ama e ?</para>
  <para style="q1" vid="PSA 43:5">Tula diana diaku mu Nzambi bila ndiela kunzitisa diaka,</para>
  <para style="q1" vid="PSA 43:5">Mvulusi ama ayi Nzambi ama.<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="cl">Minkunga 44</para>
  <para style="s1">Yave wutuloza</para>
  <para style="d">Nkunga bana ba babakala ba Kole kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1"/>Beto tuwilu mu matu meto, a Nzambi</para>
  <para style="q1" vid="PSA 44:1">madise meto batukamba mambu momo wuvanga mu bilumbu biawu ;</para>
  <para style="q1" vid="PSA 44:1">mu bilumbu bivioka<verse eid="PSA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>Mu koko kuaku, ngeyo wukuka makanda ;</para>
  <para style="q1" vid="PSA 44:2">ayi ngeyo wuvingisa madise meto ;</para>
  <para style="q1" vid="PSA 44:2">ngeyo wukosikisa batu ayi ngeyo wufunisa mase meto.<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>Kadi sia ti mu diambu di sabala kiawu</para>
  <para style="q1" vid="PSA 44:3">bazionina tsi ;</para>
  <para style="q1" vid="PSA 44:3">Voti kadi sia ti koko kuawu kuawu kuba natina ndungunu ;</para>
  <para style="q1" vid="PSA 44:3">koko kuaku ku lubakala,</para>
  <para style="q1" vid="PSA 44:3">koko kuaku ayi kiezila ki zizi kiaku</para>
  <para style="q1" vid="PSA 44:3">bila ngeyo wuba zola.<verse eid="PSA 44:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>Ngeyo ntinu ama ayi Nzambi ama ;</para>
  <para style="q1" vid="PSA 44:4">ngeyo wuzenga ndungunu mu diambu di Yakobi.<verse eid="PSA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>Mu diambu diaku, tuela vutula bambeni zieto ku mbusa.</para>
  <para style="q1" vid="PSA 44:5">Mu diambu di dizina diaku, tuela diatikisa</para>
  <para style="q1" vid="PSA 44:5">bobo beti kutulenda.<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>Nditulanga ko diana diama mu mbasꞌama</para>
  <para style="q1" vid="PSA 44:6">ayi sabala kiama kilendi ku ndatina ndungunu ko.<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>Vayi ngeyo weti kutuvana ndungunu mu bambeni zieto ;</para>
  <para style="q1" vid="PSA 44:7">ngeyo wumfuisanga tsoni bobo bakutulendanga.<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>Mu Nzambi beto tueti kukiniemisanga</para>
  <para style="q1" vid="PSA 44:8">mu lumbu kimvimba</para>
  <para style="q1" vid="PSA 44:8">ayi tuela zitisa dizina diaku</para>
  <para style="q1" vid="PSA 44:8">mu zithangu zioso.<verse eid="PSA 44:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>Vayi buabu ngeyo wutuloza ayi wutukuludi ;</para>
  <para style="q1" vid="PSA 44:9">ngeyo wutotukanga diaka ko</para>
  <para style="q1" vid="PSA 44:9">ayi nkangu eto wu masodi.<verse eid="PSA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>Ngeyo wutuvutula ku mbusa</para>
  <para style="q1" vid="PSA 44:10">va ntuala bambeni zieto ;</para>
  <para style="q1" vid="PSA 44:10">ayi bobo beti kutulenda bazionini bima bieto.<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>Ngeyo wutuyekula batudia banga mamemi.</para>
  <para style="q1" vid="PSA 44:11">Wutusasikisa va khatitsika makanda.<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>Ngeyo wusumbisa batu baku mu thalu yi phamba,</para>
  <para style="q1" vid="PSA 44:12">wukadi kuba bakila ndandu bu wuba sumbisa.<verse eid="PSA 44:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>Ngeyo wutukitula kima ki tsoni</para>
  <para style="q1" vid="PSA 44:13">kuidi bafikimini yeto,</para>
  <para style="q1" vid="PSA 44:13">kisekununu ayi kitsevolo</para>
  <para style="q1" vid="PSA 44:13">kuidi bawu batuzungididi.<verse eid="PSA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>Ngeyo wutukitula zinongo va khatitsika makanda ;</para>
  <para style="q1" vid="PSA 44:14">batu balembo kutunikunina mintu miawu.<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>Mvuezolo ama widi ku ntualꞌama mu lumbu kimvimba ;</para>
  <para style="q1" vid="PSA 44:15">ayi tsoni yilembo monika va zizi kiama ;<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>mu diambu di bifingu bi bobo balembo</para>
  <para style="q1" vid="PSA 44:16">ndenzi ayi balembo mvuezi,</para>
  <para style="q1" vid="PSA 44:16">mu diambu di mbeni, mutu wumvutulanga landi.<verse eid="PSA 44:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>Mamoso momo matubuila</para>
  <para style="q1" vid="PSA 44:17">vayi beto tusia kuzimbakana ;</para>
  <para style="q1" vid="PSA 44:17">Voti tusia ba luvunu mu Nguizani aku ko.<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>Mintima mieto misia baluka ko ;</para>
  <para style="q1" vid="PSA 44:18">Malu meto masia vengama ko mu nsolo aku,<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>vayi wutukosikisa ayi wutukitula suamunu ki memvo ;</para>
  <para style="q1" vid="PSA 44:19">ayi wutufuka ku tsi dibulu di tombi.<verse eid="PSA 44:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>Enati beto tuzimbakana dizina di Nzambi eto,</para>
  <para style="q1" vid="PSA 44:20">voti tunonuna mioko mieto kuidi nzambi yi nzenza,<verse eid="PSA 44:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21"/>buna Nzambi kalendi bakula ko e ?</para>
  <para style="q1" vid="PSA 44:21">Bila niandi zebi mansueki ma ntima.<verse eid="PSA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22"/>Vayi mu diambu diaku tueti dengana lufua</para>
  <para style="q1" vid="PSA 44:22">mu lumbu kimvimba,</para>
  <para style="q1" vid="PSA 44:22">ayi balembo tumoni banga mamemi</para>
  <para style="q1" vid="PSA 44:22">mafueti kuenda ku vondo.<verse eid="PSA 44:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>Kotuka, a Yave !</para>
  <para style="q1" vid="PSA 44:23">Bila mbi wulembo lekila e ?</para>
  <para style="q1" vid="PSA 44:23">Kotuka kuaku kadi tumbu ku tuyekula mvimba !<verse eid="PSA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>Bila mbi wulembo suekila zizi kiaku e ?</para>
  <para style="q1" vid="PSA 44:24">Ayi bila mbi wulembo zimbikinina</para>
  <para style="q1" vid="PSA 44:24">ziphasi zieto ayi yamusu kueto e ?<verse eid="PSA 44:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>Tunatu ku mbungi-mbungi</para>
  <para style="q1" vid="PSA 44:25">zinitu zieto zinama mu ntoto.<verse eid="PSA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>Telama, wutusadisa</para>
  <para style="q1" vid="PSA 44:26">wutukula mu diambu di luzolo luaku lu ngolo.<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="cl">Minkunga 45</para>
  <para style="s1">Nkunga wu dikuela di ntinu</para>
  <para style="d">Nkunga bana ba babakala ba Kole kuidi pfumu minyimbidi. Nkunga wu luzolo bayimbidila mu “LISI”.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1"/>Ntimꞌama wulembo fundumuka mu mambu ma kitoko.</para>
  <para style="q1" vid="PSA 45:1">Ndiela samuna mambu mama mu diambu di ntinu.</para>
  <para style="q1" vid="PSA 45:1">Ludimi luama luidi lapi yi nsoniki wukiedika.<verse eid="PSA 45:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>Ngeyo viokidi batu mu kitoko ;</para>
  <para style="q1" vid="PSA 45:2">bididi biaku bidukudulu mafuta ma nlemvo ;</para>
  <para style="q1" vid="PSA 45:2">diawu Nzambi kasakumunina mu zithangu zioso.<verse eid="PSA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>Kanga sabala kiaku mu luketo luaku,</para>
  <para style="q1" vid="PSA 45:3">ngeyo kinuani ki ngolo,</para>
  <para style="q1" vid="PSA 45:3">vuata ngeyo veka kiezila ayi nzitusu.<verse eid="PSA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>Mu nzitusu aku, telama va ntuala</para>
  <para style="q1" vid="PSA 45:4">mu ndungunu mu diambu di kakidila kiedika,</para>
  <para style="q1" vid="PSA 45:4">kukikulula ayi busonga.</para>
  <para style="q1" vid="PSA 45:4">Bika koko kuaku ku lubakala kumonisa mavanga ma tsisi.<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>Bika zitsoto ziaku zidi meno,</para>
  <para style="q1" vid="PSA 45:5">zitobula mintima mi bambeni zi ntinu ;</para>
  <para style="q1" vid="PSA 45:5">bika makanda mabua ku tsi tambi biaku.<verse eid="PSA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>Kundu kiaku ki kitinu, a Nzambi</para>
  <para style="q1" vid="PSA 45:6">kiela zingila mu zithangu zioso</para>
  <para style="q1" vid="PSA 45:6">Nkawꞌaku wu busonga wela ba nkawa wu Kitinu kiaku.<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>Ngeyo wunzolanga busonga ayi wunlendanga mambimbi.</para>
  <para style="q1" vid="PSA 45:7">Diawu Nzambi, Nzambi aku, wutula va mbata batu bandiatanga yaku</para>
  <para style="q1" vid="PSA 45:7">bu kavinda mafuta ma khini.<verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>Zilobi ziaku zioso zidi tsudi malasi ma mile,</para>
  <para style="q1" vid="PSA 45:8">ayi alowesi ayi kase ; mu nzo yoyi yitungulu mu meno ma nzawu</para>
  <para style="q1" vid="PSA 45:8">miziki mi zitsinga mikumonisa khini.<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>Bana ba baketo ba ntinu badi va khati baketo baku ba luvalu.</para>
  <para style="q1" vid="PSA 45:9">Va koko kuaku ku lubakala, vadi Ntinu wu nketo mu nolo yi Ofili.<verse eid="PSA 45:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>Wa, o muana ndumba, tala ayi tamba dikutu :</para>
  <para style="q1" vid="PSA 45:10">zimbakana batu baku ayi nzo dise diaku.<verse eid="PSA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>Ntinu wulembo moni khini mu kitoko kiaku</para>
  <para style="q1" vid="PSA 45:11">kinzika bila niandi Pfumu aku ;<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>Muana ndumba wu Tile, wela nata dikaba ;</para>
  <para style="q1" vid="PSA 45:12">batu balutidi kimvuama bela tomba mona mamboti maku.<verse eid="PSA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>Nkembo woso widi kuidi muana ntinu wu nketo</para>
  <para style="q1" vid="PSA 45:13">mu khati vinga kiandi</para>
  <para style="q1" vid="PSA 45:13">lobi andi yitungulu mu nolo.<verse eid="PSA 45:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>Mu minlele midi malenda ma kitoko ; bela kunnata kuidi ntinu.</para>
  <para style="q1" vid="PSA 45:14">Zindumba ziozi zizebi ko zinitu zi babakala</para>
  <para style="q1" vid="PSA 45:14">ziozi zindiatanga yandi zilembo kunlandakana.</para>
  <para style="q1" vid="PSA 45:14">Ayi bela natu kuidi ngeyo.<verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>Bela natu mu khini ayi mu mayangani.</para>
  <para style="q1" vid="PSA 45:15">Bela kota mu nzo ntinu.<verse eid="PSA 45:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>Bana baku ba babakala bela bonga buangu ki madise maku ;</para>
  <para style="q1" vid="PSA 45:16">ngeyo wela ku babieka bilandi bi ntinu</para>
  <para style="q1" vid="PSA 45:16">mu tsi yi mvimba.<verse eid="PSA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>Minu ndiela sia ti batebukilanga moyo</para>
  <para style="q1" vid="PSA 45:17">mu zitsungi zioso.</para>
  <para style="q1" vid="PSA 45:17">Diawu makanda mela kuzitisa mu zithangu zioso</para>
  <para style="q1" vid="PSA 45:17">ayi mu mvu ka mvu.<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="cl">Minkunga 46</para>
  <para style="s1">Nzambi widi suamunu kieto</para>
  <para style="d">Nkunga bana ba babakala ba Kole kuidi pfumu minyimbidi ; bayimbidila mu mbembo yi fioti yi bana babaketo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1"/>Nzambi niandi suamunu kieto</para>
  <para style="q1" vid="PSA 46:1">ayi zingolo zieto ;</para>
  <para style="q1" vid="PSA 46:1">niandi nsadisi wu zithangu zioso mu ziphasi.<verse eid="PSA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>Diawu tulendi mona tsisi ko</para>
  <para style="q1" vid="PSA 46:2">ka diambu ko ntoto wulenda buka</para>
  <para style="q1" vid="PSA 46:2">ayi miongo milenda bulumuka ku tsi mbu,<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>ka diambu ko, minlangu beni milembo dumi,</para>
  <para style="q1" vid="PSA 46:3">milembo fundumuka ayi miongo miela nikuka</para>
  <para style="q1" vid="PSA 46:3">mu diambu di makhesi mawu.<verse eid="PSA 46:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>Vayi vadi nlangu wumosi wunneni wubeki mimvuila</para>
  <para style="q1" vid="PSA 46:4">mieti monisa divula di Nzambi khini ;</para>
  <para style="q1" vid="PSA 46:4">buangu kiviatukidi nlongo vovo veti vuanda</para>
  <para style="q1" vid="PSA 46:4">Nzambi yizangama.<verse eid="PSA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>Nzambi widi va khatitsikꞌandi ;</para>
  <para style="q1" vid="PSA 46:5">kalendi bua ko.</para>
  <para style="q1" vid="PSA 46:5">Nzambi wela kusadisa tona mu khiesa yi nsuka.<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>Makanda malembo tudi divunzi,</para>
  <para style="q1" vid="PSA 46:6">bipfumu bilembo bua.</para>
  <para style="q1" vid="PSA 46:6">Wuwakikisa mbembo andi ; ntoto wusiuta.<verse eid="PSA 46:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>Yave nkua ngolo yoso widi yeto ;</para>
  <para style="q1" vid="PSA 46:7">Nzambi yi Yakobi niandi suamunu kieto ki ngolo.<verse eid="PSA 46:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>Yizanu ayi lutala mavanga ma Yave,</para>
  <para style="q1" vid="PSA 46:8">maniongo momo kanata va ntoto.<verse eid="PSA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>Niandi wumanisa zimvita nate ku sukisina ntoto</para>
  <para style="q1" vid="PSA 46:9">wukelula mimbasa ayi wubukuna madionga ;</para>
  <para style="q1" vid="PSA 46:9">wuyoka ku mbazu minkaku.<verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>Luba dio sui ayi luzaba ti minu Nzambi.</para>
  <para style="q1" vid="PSA 46:10">Ndiela yayusu muidi makanda, ndiela yayisa va ntoto.<verse eid="PSA 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>Yave nkua ngolo yoso widi yeto.</para>
  <para style="q1" vid="PSA 46:11">Nzambi yi Yakobi niandi suamunu kieto ki ngolo.<verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="cl">Minkunga 47</para>
  <para style="s1">Lusikila Nzambi zitsiaki</para>
  <para style="d">Nkunga bana ba babakala ba Kole kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1"/>Lusika zitsiaki, beno makanda moso.</para>
  <para style="q1" vid="PSA 47:1">Luyamikina kuidi Nzambi mu khini,<verse eid="PSA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>Tala phila Yave yizangama kadidi tsisi !</para>
  <para style="q1" vid="PSA 47:2">Niandi ntinu wunneni va mbata ntoto wumvimba.<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>Wutula makanda ku tsi buvika bueto,</para>
  <para style="q1" vid="PSA 47:3">batu ku tsi malu meto.<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>Wutusobudila kiuka ;</para>
  <para style="q1" vid="PSA 47:4">luniemo lu Yakobi ; mutu wu kazola.<verse eid="PSA 47:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>Nzambi wukuma va khatitsika yamikina ku khini</para>
  <para style="q1" vid="PSA 47:5">Yave wukuma va khatitsika biyoko bi tulumbeta.<verse eid="PSA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>Luyimbila minzitusu kuidi Nzambi</para>
  <para style="q1" vid="PSA 47:6">Luyimbila minzitusu ;</para>
  <para style="q1" vid="PSA 47:6">Luyimbila minzitusu kuidi Nzambi eto,</para>
  <para style="q1" vid="PSA 47:6">luyimbila minzitusu.<verse eid="PSA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>Bila Nzambi niandi ntinu wu ntoto wumvimba ;</para>
  <para style="q1" vid="PSA 47:7">Lunyimbidila nkunga wu nzitusu.<verse eid="PSA 47:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>Nzambi weti yadila makanda moso.</para>
  <para style="q1" vid="PSA 47:8">Nzambi vuendi va kundu kiandi kinlongo.<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>Batu banneni ba makanda bakutikini</para>
  <para style="q1" vid="PSA 47:9">banga batu ba Nzambi yi Abalahami</para>
  <para style="q1" vid="PSA 47:9">bila Nzambi niandi vuidi mintinu mi ntoto.</para>
  <para style="q1" vid="PSA 47:9">Niandi wuyayusu ngolo.<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="cl">Minkunga 48</para>
  <para style="s1">Divula di Nzambi</para>
  <para style="d">Nkunga bana ba babakala ba Kole.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1"/>Yave widi wunneni.</para>
  <para style="q1" vid="PSA 48:1">Ayi lutidi fuana mu tambula minzitusu</para>
  <para style="q1" vid="PSA 48:1">mu divula di Nzambi eto, mongo andi wunlongo.<verse eid="PSA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>Widi wu kitoko mu nangama kuandi,</para>
  <para style="q1" vid="PSA 48:2">khini yi ntoto wumvimba.</para>
  <para style="q1" vid="PSA 48:2">Mongo wu Sioni widi banga zitsongi zilutisi nangama zi Zafoni,</para>
  <para style="q1" vid="PSA 48:2">divula di ntinu wunneni.<verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>Nzambi widi mu zinzo zi divula beni</para>
  <para style="q1" vid="PSA 48:3">wukimonisa niandi veka mu ba suamunu kiandi ki ngolo.<verse eid="PSA 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>Mu thangu mintinu mifubikisa zingolo,</para>
  <para style="q1" vid="PSA 48:4">mu thangu midiatila va kimosi.<verse eid="PSA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>Mimona ayi misimina ;</para>
  <para style="q1" vid="PSA 48:5">mitina mu tsisi.<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>Lukhuku luba buila vana</para>
  <para style="q1" vid="PSA 48:6">ziphasi ziba mona zidedikini banga mianga</para>
  <para style="q1" vid="PSA 48:6">mieti mona nketo weka buta.<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>Ngeyo wuba bunga banga masuwa ma Talisi</para>
  <para style="q1" vid="PSA 48:7">mabungu mu phemo yeti totukila ku Esite.<verse eid="PSA 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>Banga bu tuwila,</para>
  <para style="q1" vid="PSA 48:8">buawu bobo tumuenini mu divula di Yave,</para>
  <para style="q1" vid="PSA 48:8">nkua ngolo yoso ;</para>
  <para style="q1" vid="PSA 48:8">mu divula di Nzambi eto :</para>
  <para style="q1" vid="PSA 48:8">Nzambi wela kuvana luvovomo mu zithangu zioso.<verse eid="PSA 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>Mu khati nzo aku, a Nzambi,</para>
  <para style="q1" vid="PSA 48:9">tueti yindula mu diambu di luzolo luaku lu ngolo.<verse eid="PSA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>Banga dizina diaku, a Nzambi !</para>
  <para style="q1" vid="PSA 48:10">Nzitusu aku widi nate mu sukisina ntoto.</para>
  <para style="q1" vid="PSA 48:10">Koko kuaku ku lubakala kuwedi busonga.<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>Mongo wu Sioni wulembo moni khini ;</para>
  <para style="q1" vid="PSA 48:11">mala ma Yuda malembo yangalala</para>
  <para style="q1" vid="PSA 48:11">mu diambu di zinzengolo ziaku.<verse eid="PSA 48:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>Ludiata muyenda Sioni ayi lunzungidila,</para>
  <para style="q1" vid="PSA 48:12">ayi lutanga zinzo ziandi zizangama.<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>Lutala bumboti ziphangu ziandi ;</para>
  <para style="q1" vid="PSA 48:13">Lufiongunina zinzo ziandi</para>
  <para style="q1" vid="PSA 48:13">muingi luba samunina kuidi tsungi yinkuiza.<verse eid="PSA 48:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>Bila Nzambi yayi niandi Nzambi eto</para>
  <para style="q1" vid="PSA 48:14">mu thangu yi kayimani ayi mu zithangu zioso.</para>
  <para style="q1" vid="PSA 48:14">Niandi wela ba ntuadisi eto nate ku tsuka.<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="cl">Minkunga 49</para>
  <para style="s1">Tudila kimvuama diana buidi buvungisi</para>
  <para style="d">Nkunga bana ba babakala ba Kole kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1"/>Luwa diambu diadi beno batu boso :</para>
  <para style="q1" vid="PSA 49:1">Ludimba beno batu boso lunzinganga va nza yayi,<verse eid="PSA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>batu baphamba ayi batu banneni,</para>
  <para style="q1" vid="PSA 49:2">zimvuama ayi minsukami.<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>Munuꞌama wela tuba mambu ma nduenga,</para>
  <para style="q1" vid="PSA 49:3">mamo mantotukila mu ntimꞌama mela vana tsudukulu.<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>Ndiela balula dikutu diama mu diambu di wa zingana,</para>
  <para style="q1" vid="PSA 49:4">mu ngitala, ndiela sudikisila nongoꞌama.<verse eid="PSA 49:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>Bila mbi mfueti monina tsisi</para>
  <para style="q1" vid="PSA 49:5">bilumbu bi mbimbi bu bizidi,</para>
  <para style="q1" vid="PSA 49:5">mu thangu mambimbi ma bobo beti vuna batu manzungididi e ?<verse eid="PSA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>Bantulanga diana diawu mu bima biawu</para>
  <para style="q1" vid="PSA 49:6">ayi beti kukiniemisa mu kimvuama kiawu kiwombo.<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>Mutu kalendi baka bu kuidila ko, luzingu lu mutu wunkaka,</para>
  <para style="q1" vid="PSA 49:7">voti futa thalu yi khudulu andi kuidi Nzambi.<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>Thalu yi khudulu yi luzingu yibeki luvalu lunneni,</para>
  <para style="q1" vid="PSA 49:8">kuisi ko kadi mfutu wulenda dedakana,<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>mu diambu kazinga mu zithangu zioso</para>
  <para style="q1" vid="PSA 49:9">ayi kabika bola.<verse eid="PSA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>Bila babo beti mona ti bankua nduenga balembo fua ;</para>
  <para style="q1" vid="PSA 49:10">bivungisi ayi bivulu balembo fua mamvawu,</para>
  <para style="q1" vid="PSA 49:10">ayi balembo biki bima biawu kuidi batu bankaka.<verse eid="PSA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>Biziami biawu biela banga zinzo ziawu mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 49:11">bibuangu biawu biobi beta vuanda mu tsungi ka tsungi.</para>
  <para style="q1" vid="PSA 49:11">Beti vana mazina mawu mu mintoto miawu bu bafuidi.<verse eid="PSA 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>Vayi mutu, ka diambu ko beki kimvuama kazinganga buwombo ko.</para>
  <para style="q1" vid="PSA 49:12">Dedikini banga bibulu bieti fua.<verse eid="PSA 49:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>Mawu mama mambu meti buila batu bobo beti tula diana mu bawu veka</para>
  <para style="q1" vid="PSA 49:13">ayi bobo beti kuba landakana,</para>
  <para style="q1" vid="PSA 49:13">bobo beti kikina mambu beti tuba.<verse eid="PSA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>Banga nkangu wu mamemi, bakubuku mu diambu di tsi bafua ;</para>
  <para style="q1" vid="PSA 49:14">lufua luela kuba dia.</para>
  <para style="q1" vid="PSA 49:14">Mutu widi ntima wululama wela kuba yadila va nsuka</para>
  <para style="q1" vid="PSA 49:14">buphila buawu buela bola ku tsi bafua,</para>
  <para style="q1" vid="PSA 49:14">thama ayi zinzo ziawu zi kipfumu.<verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>Vayi Nzambi wela kula luzingu luama mu lulendo lu tsi bafua,</para>
  <para style="q1" vid="PSA 49:15">bukiedika wela kuthambula mu diambu diandi veka.<verse eid="PSA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>Kadi mona tsisi mutu bu kalembo baki kimvuama</para>
  <para style="q1" vid="PSA 49:16">kiezila ki nzo andi bu kilembo buelama.<verse eid="PSA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>Bila kalendi nata kadi kima ko mu thangu kela fua.</para>
  <para style="q1" vid="PSA 49:17">Kiezila kiandi kilendi kuluka yandi ko.<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>Bu kabedi moyo wukimona mutu wu lusakumunu</para>
  <para style="q1" vid="PSA 49:18">ayi batu beti kuzitisa bu weti mona lusakumunu</para>
  <para style="q1" vid="PSA 49:18">bu kabedi monanga mamboti.<verse eid="PSA 49:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19"/>Wela kuenda bata tsungi yi madise mandi ;</para>
  <para style="q1" vid="PSA 49:19">bobo balendi buela mona kiezila ko ki luzingu.<verse eid="PSA 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>Mutu widi kimvuama ayi kambulu diela</para>
  <para style="q1" vid="PSA 49:20">widi banga bulu kieti fua.<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="cl">Minkunga 50</para>
  <para style="s1">Nzambi wela sambisa batu bandi.</para>
  <para style="d">Nkunga Asafi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1"/>Nkua lulendo ; Nzambi, Yave</para>
  <para style="q1" vid="PSA 50:1">tubidi ayi kutikisidi ntoto</para>
  <para style="q1" vid="PSA 50:1">tonina ku ntotukilanga thangu nate buangu keti diamina.<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>Tona ku Sioni, wufuana mu kitoko ;</para>
  <para style="q1" vid="PSA 50:2">Nzambi weti kienzuka.<verse eid="PSA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>Nzambi eto wulembo yizi,</para>
  <para style="q1" vid="PSA 50:3">ayi kalendi ba dio sui ko ;</para>
  <para style="q1" vid="PSA 50:3">mbazu yilembo zinisa ku ntualꞌandi</para>
  <para style="q1" vid="PSA 50:3">ayi vuka kingolo kinzungididi.<verse eid="PSA 50:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4"/>Niandi wunkutikisanga diyilu ku yilu</para>
  <para style="q1" vid="PSA 50:4">ayi ntoto mu diambu kasambisa batu bandi :<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>Lukhutikisila batu bama bobo ndibieka,</para>
  <para style="q1" vid="PSA 50:5">bobo bavanga yama Nguizani mu nzila yi makaba.<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>Ayi diyilu dilembo yamikisa busonga buandi,</para>
  <para style="q1" vid="PSA 50:6">bila Nzambi niandi veka zuzi.<verse eid="PSA 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>Luwa, beno batu bama ;</para>
  <para style="q1" vid="PSA 50:7">Ndiela tuba :</para>
  <para style="q1" vid="PSA 50:7">A Iseli, ayi ndieka ntelama kimbangi mu diambu diaku :</para>
  <para style="q1" vid="PSA 50:7">Minu ndidi Nzambi ; Nzambi aku.<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>Ndilendi kutemina ko mu diambu di makaba maku</para>
  <para style="q1" vid="PSA 50:8">voti makaba maku mayoko ;</para>
  <para style="q1" vid="PSA 50:8">momo madi thangu ka thangu va ntualꞌama,<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>Ndisi mfunu wu ngombi yi mbakala yi luphangu luaku ko,</para>
  <para style="q1" vid="PSA 50:9">voti zikhombo zi ziphaka ziaku ko.<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>Bila minu phuidi bibulu bioso bi nsitu</para>
  <para style="q1" vid="PSA 50:10">ayi bibulu bioso binkalanga mu miongo.<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>Nzebi zinuni zioso zi miongo,</para>
  <para style="q1" vid="PSA 50:11">ayi minu phuidi bivangu bidi mu zitsola,<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>Enati nzala ndimona, buna ndilendi kukamba buawu ko</para>
  <para style="q1" vid="PSA 50:12">bila minu phuidi nza ayi bibioso bidi muawu.<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>Minu minsuni mi zingombi zimbakala ndiela dia</para>
  <para style="q1" vid="PSA 50:13">voti ndieka nua menga ma zikhombo e ?<verse eid="PSA 50:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>Tambika makaba ma phutudulu matondo kuidi Nzambi</para>
  <para style="q1" vid="PSA 50:14">ayi dukisanga zitsila ziaku kuidi Nzambi yizangama.<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>Ayi wuthela mu lumbu ki ziphasi,</para>
  <para style="q1" vid="PSA 50:15">ndiela ku kula ayi ngeyo wela kunzitisa.<verse eid="PSA 50:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16"/>Vayi Nzambi wulembo kambi mutu wumbimbi :</para>
  <para style="q1" vid="PSA 50:16">“Mu minsua mbi wulembo tangilanga mina miama e ?</para>
  <para style="q1" vid="PSA 50:16">Voti bila mbi weti natina Nguizani yama mu bididi biaku e ?<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>Ngeyo wunlendanga zindongi ziama</para>
  <para style="q1" vid="PSA 50:17">ayi wuloza mambu mama ku manima maku.<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>Ngeyo bu mueni muivi,</para>
  <para style="q1" vid="PSA 50:18">buna weti bundana yandi.</para>
  <para style="q1" vid="PSA 50:18">Bosi ngeyo wumvuandanga va kimosi ayi mitsuza.<verse eid="PSA 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>Wunsadilanga munuꞌaku mu diambu di mambimbi,</para>
  <para style="q1" vid="PSA 50:19">ayi wunsadilanga ludimi luaku mu diambu di luvunu.<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>Ngeyo wuntubidilanga khombꞌaku</para>
  <para style="q1" vid="PSA 50:20">ku ndambu mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 50:20">Ngeyo wuvuezanga muana bakala wubuta ngudi aku.<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>Mambu mana mawu wuvanga</para>
  <para style="q1" vid="PSA 50:21">vayi ndiba dio sui.</para>
  <para style="q1" vid="PSA 50:21">Ngeyo wubanzila ti minu ndedikini banga ngeyo</para>
  <para style="q1" vid="PSA 50:21">Vayi minu ndiela kutubidila ayi kufunda va zizi kiaku</para>
  <para style="q1" vid="PSA 50:21">ku ntuala meso maku.<verse eid="PSA 50:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>Luyindula diambu diadi : beno lunzimbakananga Nzambi ;</para>
  <para style="q1" vid="PSA 50:22">nganu ndilenda kulukanzuna mu bitini,</para>
  <para style="q1" vid="PSA 50:22">ayi mutu wulenda kula kalendi monika ko.<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>Woso wuntambikanga makaba ma phutudulu matondo</para>
  <para style="q1" vid="PSA 50:23">buna wukunzitisa, ayi weti kubika nzila</para>
  <para style="q1" vid="PSA 50:23">muingi ndimmonisa phulusu yi Nzambi.”<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="cl">Minkunga 51</para>
  <para style="s1">Kuidi ngeyo ndivodidi masumu</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi ; mu thangu mbikuidi Natani kayiza kuidi Davidi mu kitsuza kiandi ayi Betaseba.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1"/>A Nzambi, wumboni kiadi</para>
  <para style="q1" vid="PSA 51:1">boso buididi luzolo luaku lu ngolo ;</para>
  <para style="q1" vid="PSA 51:1">boso buididi kiadi kiaku kinneni,</para>
  <para style="q1" vid="PSA 51:1">kubula zinzimbala ziama.<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>Sukula mambimbi mama moso.</para>
  <para style="q1" vid="PSA 51:2">Ayi wuphedisa mu disumu diama.<verse eid="PSA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>Bila nzebi zinzimbala ziama</para>
  <para style="q1" vid="PSA 51:3">ayi disumu diama didi ku ntualꞌama mu zithangu zioso.<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>Kuidi ngeyo, veka kaka ndivodidi masumu ;</para>
  <para style="q1" vid="PSA 51:4">ayi ndivengi mambimbi va meso maku ;</para>
  <para style="q1" vid="PSA 51:4">muingi wumonika wusonga mu thangu wutuba</para>
  <para style="q1" vid="PSA 51:4">ayi wukambulu zimbala mu thangu wunsambisa<verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>Bukiedika, minu ndidi nkua masumu tona mu mbutukulu ;</para>
  <para style="q1" vid="PSA 51:5">nkua masumu tona thangu ngudi ama kabaka buemba buama.<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>Bukiedika ngeyo tidi ti kiedika kiba mu khati ku nitu.</para>
  <para style="q1" vid="PSA 51:6">Wundonga nduenga mu khati yi ntimꞌama<verse eid="PSA 51:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>Wuphedisa mu isopi buna ma ndivedila ;</para>
  <para style="q1" vid="PSA 51:7">wutsukula buna ndiela ba wuphembi</para>
  <para style="q1" vid="PSA 51:7">viokila mvula yi matadi ma phembi ;<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>Bika ndimona khini ayi ndiyangalala</para>
  <para style="q1" vid="PSA 51:8">Bika mimvesi miomi wukosikisa mi yangalala.<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>Sueka zizi kiaku va ntuala masumu mama</para>
  <para style="q1" vid="PSA 51:9">ayi kubula mbimbi ama yoso.<verse eid="PSA 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>Vanga mu minu ntima wuvedila, a Nzambi</para>
  <para style="q1" vid="PSA 51:10">ayi buela kitula mu minu pheve yimona ayi yikinda.<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>Kadi kukhuka va ntuala zizi kiaku ;</para>
  <para style="q1" vid="PSA 51:11">kadi botula pheve aku yinlongo mu minu.<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>Wuphutudila khini yi phulusu aku</para>
  <para style="q1" vid="PSA 51:12">ayi bika wuphana Pheve yi luzolo lu mboti muingi yikhindisa.<verse eid="PSA 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>Buna ndiela longa zinzila ziaku</para>
  <para style="q1" vid="PSA 51:13">kuidi bobo beti vanga zinzimbala,</para>
  <para style="q1" vid="PSA 51:13">ayi bankua masumu bela vutuka kuidi ngeyo.<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>Wuphukisa mu nzimbala yi menga, a Nzambi</para>
  <para style="q1" vid="PSA 51:14">Nzambi yoyi yeti kuphukisa,</para>
  <para style="q1" vid="PSA 51:14">ayi ludimi luama luela yimbidila busonga buaku.<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>A Yave zibula bididi biama,</para>
  <para style="q1" vid="PSA 51:15">ayi munuꞌama wela yamikisa nzitusu aku.<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>Ngeyo wuzolanga ko makaba,</para>
  <para style="q1" vid="PSA 51:16">bila enati buawu ; nganu ndinatina mawu ;</para>
  <para style="q1" vid="PSA 51:16">ayi wumonanga khini ko mu makaba mayoko.<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>Makaba ma Nzambi madi pheve yi kosakana</para>
  <para style="q1" vid="PSA 51:17">ntima wukosakana ayi wu kiadi</para>
  <para style="q1" vid="PSA 51:17">a Nzambi, wulendi ku milenza ko.<verse eid="PSA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>Mu diambu di mamboti maku,</para>
  <para style="q1" vid="PSA 51:18">bika wuvangila Sioni mamboti,</para>
  <para style="q1" vid="PSA 51:18">tunga diaka bibaka bi Yelusalemi.<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>Kuna kuela ba makaba ma busonga,</para>
  <para style="q1" vid="PSA 51:19">makaba mayoko mamvimba meti kumonisa khini.</para>
  <para style="q1" vid="PSA 51:19">Buna zingombi zimbakala ziela tambuku va ntalꞌaku.<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="cl">Minkunga 52</para>
  <para style="s1">Tsukulu yi nkua kimvuama weti yamisa batu</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi mu thangu Dowengi muisi Edomi, kayiza vumbudila Sawuli kipholo ti Davidi wuyenda ku nzo Ahimeleki.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1"/>Bila mbi wulembo kukiniemisina mu diambu di mambimbi, ngeyo nkua ngolo e ?</para>
  <para style="q1" vid="PSA 52:1">Bila mbi wulembo kukiniemisina mu lumbu kimvimba</para>
  <para style="q1" vid="PSA 52:1">ngeyo kambulu nzitusu va meso ma Nzambi e ?<verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>Ludimi luaku lunyindulanga mambu ma mbivusu ;</para>
  <para style="q1" vid="PSA 52:2">ludedikini banga lezuale yidi meno ma ngolo.</para>
  <para style="q1" vid="PSA 52:2">Ngeyo wunsadilanga luvunu.<verse eid="PSA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>Ngeyo lutidi zola mambu mambimbi</para>
  <para style="q1" vid="PSA 52:3">viokila mamboti ;</para>
  <para style="q1" vid="PSA 52:3">luvunu viokila mambu ma kiedika.<verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>Ngeyo lutidi zola mambu moso momo mambivisanga,</para>
  <para style="q1" vid="PSA 52:4">ngeyo ludimi lu luvunu.<verse eid="PSA 52:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>Bukiedika Nzambi wela kubuisa mu mbivusu yika yilendi suka ko.</para>
  <para style="q1" vid="PSA 52:5">Wela kubuila ayi wela kukanzuna mu nzoꞌaku yi ngoto.</para>
  <para style="q1" vid="PSA 52:5">Wela kuvuza va ntoto wu batu badi moyo.<verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>Batu basonga bela mona</para>
  <para style="q1" vid="PSA 52:6">ayi bela mona tsisi bela kunseva bu bela tuba :<verse eid="PSA 52:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>“Vava vadi mutu wukambulu kitula Nzambi zingolo ziandi</para>
  <para style="q1" vid="PSA 52:7">Vayi wubedi tulanga diana diandi</para>
  <para style="q1" vid="PSA 52:7">mu kimvuama kiandi kiwombo</para>
  <para style="q1" vid="PSA 52:7">ayi wukitukidi mutu wu ngolo mu bunganga bankaka.”<verse eid="PSA 52:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>Vayi minu ndidi</para>
  <para style="q1" vid="PSA 52:8">banga nti wu olive, wuwedi meza ma nlangu mu nzo yi Nzambi.</para>
  <para style="q1" vid="PSA 52:8">Ndintulanga diana diama mu luzolo mu ngolo lu Nzambi</para>
  <para style="q1" vid="PSA 52:8">mu zithangu zioso ayi mu mimvu mioso.<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>Ndiela kuzitisa mu zithangu zioso</para>
  <para style="q1" vid="PSA 52:9">mu diambu di momo wuvanga ;</para>
  <para style="q1" vid="PSA 52:9">mu dizina diaku ndiela tula diana bila didi dimboti,</para>
  <para style="q1" vid="PSA 52:9">ndiela kuzitisa va meso ma banlongo.<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="cl">Minkunga 53</para>
  <para style="s1">Beto boso tuidi bazimbala</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi ; kayimbidila mu flute.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1"/>Nkua buvulu wuntubanga mu ntimꞌandi :</para>
  <para style="q1" vid="PSA 53:1">“kuisiko Nzambi.”</para>
  <para style="q1" vid="PSA 53:1">Bakibivisidi, zinzila ziawu zidi zimbimbi ;</para>
  <para style="q1" vid="PSA 53:1">kuisiko mutu wumvanganga mamboti.<verse eid="PSA 53:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>Nzambi, wulembo tadi tona ku Diyilu bana ba batu</para>
  <para style="q1" vid="PSA 53:2">mu diambu di tala kani valenda ba batu balenda sudika ;</para>
  <para style="q1" vid="PSA 53:2">bobo bantomba Nzambi.<verse eid="PSA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>Batu boso bamana zimbala, bamana kibivisa va kimosi.</para>
  <para style="q1" vid="PSA 53:3">Kuisiko kadi wumosi wumvanganga mamboti,</para>
  <para style="q1" vid="PSA 53:3">kadi kuandi wumosi.<verse eid="PSA 53:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>Bobo bamvanganga mambimbi, basudikanga ko e ?</para>
  <para style="q1" vid="PSA 53:4">Bawu balembo dia batu bama banga bu beti dila dipha ;</para>
  <para style="q1" vid="PSA 53:4">ayi batelanga Nzambi ko.<verse eid="PSA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>Kuna batitila mu diambu di tsisi</para>
  <para style="q1" vid="PSA 53:5">va buangu ki kondolo bila kimonina tsisi ;</para>
  <para style="q1" vid="PSA 53:5">Nzambi wukosikisa mimvesi mi batu bobo banuanisa ;</para>
  <para style="q1" vid="PSA 53:5">ngeyo wuba fuisa tsoni</para>
  <para style="q1" vid="PSA 53:5">bila Nzambi wuba lenza.<verse eid="PSA 53:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>A, enati phulusu yi Iseli yitotukila ku Sioni !</para>
  <para style="q1" vid="PSA 53:6">Mu thangu Nzambi kela vutula kiuka ki batu bandi ;</para>
  <para style="q1" vid="PSA 53:6">bika Yakobi kamona khini ayi Iseli kayangalala.<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="cl">Minkunga 54</para>
  <para style="s1">Nzambi wukhula</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi kayimbidila mu mu thangu basi Zifi bayiza kamba Sawuli ti : “Davidi kuidi beto” kasuamini.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1"/>Wuphukisa, Nzambi ama, mu dizina diaku ;</para>
  <para style="q1" vid="PSA 54:1">wundungisa mu lulendo luaku.<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>Wa lusambulu luama, a Nzambi.</para>
  <para style="q1" vid="PSA 54:2">Dimba mambu ma munuꞌama.<verse eid="PSA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>Zinzenza zilembo nduanisa</para>
  <para style="q1" vid="PSA 54:3">ayi batu ba tsita balembo tombi luzingu luama.</para>
  <para style="q1" vid="PSA 54:3">Batu bankambu kinzikanga Nzambi.<verse eid="PSA 54:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>Bukiedika, Nzambi niandi nsadisi ama.</para>
  <para style="q1" vid="PSA 54:4">Yave niandi wukukhindisanga.<verse eid="PSA 54:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>Bika mambimbi mabuila bobo beti kuphueza ;</para>
  <para style="q1" vid="PSA 54:5">Mu kikhuikizi kiaku, wuba bunga.<verse eid="PSA 54:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>Ndiela kutambikanga makaba</para>
  <para style="q1" vid="PSA 54:6">mu ntima wu luzolo ;</para>
  <para style="q1" vid="PSA 54:6">ndiela zitisa dizina diaku, a Yave.</para>
  <para style="q1" vid="PSA 54:6">Bila didi dimboti.<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>Bila niandi wukhula mu ziphasi ziama zioso</para>
  <para style="q1" vid="PSA 54:7">ayi meso mama mamona mbedoso</para>
  <para style="q1" vid="PSA 54:7">yi bobo beti kundenda.<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="cl">Minkunga 55</para>
  <para style="s1">Ndidi mutu wuvakulu</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi, kayimbidila.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1"/>Dimba lusambulu luama, a Nzambi ;</para>
  <para style="q1" vid="PSA 55:1">ayi kadi zimbakana mambu mama.<verse eid="PSA 55:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2"/>Wunguila ayi wuphani mvutu ;</para>
  <para style="q1" vid="PSA 55:2">mayindu mama malembo mbonisa phasi ayi ndilembo sambi ;<verse eid="PSA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3"/>mu diambu di mbembo yi mbeni ;</para>
  <para style="q1" vid="PSA 55:3">mu diambu di yamusu ku mutu wumbimbi</para>
  <para style="q1" vid="PSA 55:3">bila minu beti yekikilanga ziphasi</para>
  <para style="q1" vid="PSA 55:3">bila balembo mfingi mu nganzi awu.<verse eid="PSA 55:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>Ntimꞌama widi mu maniongo mu minu ;</para>
  <para style="q1" vid="PSA 55:4">ayi boma bu lufua lu mbuididi.<verse eid="PSA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>Tsisi ayi lukhuku bieka mu minu</para>
  <para style="q1" vid="PSA 55:5">ayi boma bu ngolo bumbuididi.<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>Buna ndituba : “Enati ndiba ayi mavavi ma dibembi</para>
  <para style="q1" vid="PSA 55:6">nganu ndieka tumbu dumuka</para>
  <para style="q1" vid="PSA 55:6">ayi ba mu luvundulu.<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>Nganu, ndiela tinina ku thama,</para>
  <para style="q1" vid="PSA 55:7">ayi vuanda ku dikanga.<verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>Ndiela tina nsualu mu tomba suamunu</para>
  <para style="q1" vid="PSA 55:8">ku buangu kikambulu phemo yingolo</para>
  <para style="q1" vid="PSA 55:8">ayi vuka kingolo.”<verse eid="PSA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>Kotisa batu bambimbi mu divuda, A Yawe</para>
  <para style="q1" vid="PSA 55:9">ayi vunzikisa mambu mawu bantuba.</para>
  <para style="q1" vid="PSA 55:9">Bila ndilembo moni makhemi</para>
  <para style="q1" vid="PSA 55:9">ayi ziphaka mu divula.<verse eid="PSA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>Muini ayi builu,</para>
  <para style="q1" vid="PSA 55:10">makhemi ayi ziphaka bizungidila bibaka bi divula ;</para>
  <para style="q1" vid="PSA 55:10">diela dimbimbi ayi kambu dukisa zitsila bieka mu khati divula.<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>Mbivusu kiawu kisalu kieka mu khati divula ;</para>
  <para style="q1" vid="PSA 55:11">khuamusu ayi luvunu bikadi botuka mu zinzila zi divula.<verse eid="PSA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>Enati mbeni wumfingidi</para>
  <para style="q1" vid="PSA 55:12">nganu ndikimba moyo ;</para>
  <para style="q1" vid="PSA 55:12">enati mutu wukundendanga niandi weti</para>
  <para style="q1" vid="PSA 55:12">kukiniemisa va ntualꞌama</para>
  <para style="q1" vid="PSA 55:12">nganu ndisuama kuama va ntualꞌama.<verse eid="PSA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>Vayi ngeyo, mutu banga minu</para>
  <para style="q1" vid="PSA 55:13">wundiatanga yama va kimosi ;</para>
  <para style="q1" vid="PSA 55:13">nkundi ama wu kuikama ;<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>mutu wowo wubedi kalanga yama mu khini ;</para>
  <para style="q1" vid="PSA 55:14">wubedi kibanga va kimosi</para>
  <para style="q1" vid="PSA 55:14">ayi nkangu wu batu ku Nzo Nzambi !<verse eid="PSA 55:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>Bika lufua lu bibuila bambeni ziama mu kinzimbukila</para>
  <para style="q1" vid="PSA 55:15">ayi bika bakuluka bamoyo ku tsi bafua !</para>
  <para style="q1" vid="PSA 55:15">Bila mambimbi mabakudi buangu va khatitsikꞌawa,<verse eid="PSA 55:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>Mbadi minu, ndintela Nzambi,</para>
  <para style="q1" vid="PSA 55:16">ayi Yave wuphukisidi.<verse eid="PSA 55:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>Yiba nsuka, midi ayi masika,</para>
  <para style="q1" vid="PSA 55:17">Ndieti yamikina mu ziphasi ;</para>
  <para style="q1" vid="PSA 55:17">ayi weti wa mbembo ama.<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>Wukukhulanga wumbimba, mu kambu sumbula</para>
  <para style="q1" vid="PSA 55:18">mu mvita yi banduanisa</para>
  <para style="q1" vid="PSA 55:18">ka diambu ko bawombo banduanisa.<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>Nzambi wunyadila va kundu kiandi ki luyalu mu zithangu zioso</para>
  <para style="q1" vid="PSA 55:19">wela kuba wa ayi wela kuba monisa phasi ;</para>
  <para style="q1" vid="PSA 55:19">batu bobo balendi balula zinzila ziawu ko</para>
  <para style="q1" vid="PSA 55:19">ayi bakinzikanga Nzambi ko.<verse eid="PSA 55:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>Mutu wundiatanga yama wulembo</para>
  <para style="q1" vid="PSA 55:20">nuanisa bakundi bandi</para>
  <para style="q1" vid="PSA 55:20">wubundula Nguizani andi.<verse eid="PSA 55:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>Mambu mandi ndelo madi</para>
  <para style="q1" vid="PSA 55:21">banga dibela<note caller="+" style="f"><char style="fr" closed="false">55.21 </char><char style="fq" closed="false">Dibela</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">didi mafuta beti vindanga mu mapha.</char></note></para>
  <para style="q1" vid="PSA 55:21">muaki mvita yidi mu ntimꞌandi ;</para>
  <para style="q1" vid="PSA 55:21">Mambu mandi madi malebila viokila mafuta</para>
  <para style="q1" vid="PSA 55:21">muaki madi banga bisabala bikubimini mu vonda.<verse eid="PSA 55:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>Yekula bizitu biaku kuidi Yave,</para>
  <para style="q1" vid="PSA 55:22">niandi wela kukindisa ; kalendi tala ko</para>
  <para style="q1" vid="PSA 55:22">ti mutu wusonga kabua.<verse eid="PSA 55:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>Vayi ngeyo Nzambi, wela buisa batu bambimbi ;</para>
  <para style="q1" vid="PSA 55:23">mintengudi mi menga ayi bankua livunu</para>
  <para style="q1" vid="PSA 55:23">bela dukisa ko ndambu yi bilumbu biawu ;</para>
  <para style="q1" vid="PSA 55:23">vayi minu diana diama didi mu ngeyo.<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="cl">Minkunga 56</para>
  <para style="s1">Kadi tsisi Nzambi bu kadi yeto</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi ; kayimbidila mu “Dibembi di minti midi ku zitsi zi thama” mu thangu basi Filisti bankanga mu tsi Ngati.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1"/>Wumboni kiadi, A Nzambi</para>
  <para style="q1" vid="PSA 56:1">bila batu balembo ndandakana mu kingolo ;</para>
  <para style="q1" vid="PSA 56:1">mu lumbu kimvimba ; balembo luti buela kunduanisa<verse eid="PSA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>Mimvuezi miama milembo ndandakani mu lumbu kimvimba</para>
  <para style="q1" vid="PSA 56:2">Bawombo balembo nduanisa mu luniemo luawu.<verse eid="PSA 56:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>Mu thangu ndimmona tsisi ;</para>
  <para style="q1" vid="PSA 56:3">ndiela tula diana diama mu ngeyo.<verse eid="PSA 56:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4"/>Mu Nzambi, mutu vuidi mambu ndieti zitisa</para>
  <para style="q1" vid="PSA 56:4">Mu Nzambi ndieti tula diana ;</para>
  <para style="q1" vid="PSA 56:4">ndilendi mona tsisi ko,</para>
  <para style="q1" vid="PSA 56:4">Mutu wowo wumfuanga, mbi kalenda kuphanga e ?<verse eid="PSA 56:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>Mu lumbu kimvimba, beti balula mambu mama ;</para>
  <para style="q1" vid="PSA 56:5">balembo yindula mu zithangu zioso mu kumbonisa phasi.<verse eid="PSA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>Balembo kutakana ;</para>
  <para style="q1" vid="PSA 56:6">balembo suami</para>
  <para style="q1" vid="PSA 56:6">balembo fiongunina zithambi ziama,</para>
  <para style="q1" vid="PSA 56:6">mu nsualu-nsualu batidi bonga luzingu luama.<verse eid="PSA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>Balendi vukila kani mu kipholo kiawu kimosi ko e ?</para>
  <para style="q1" vid="PSA 56:7">Mu nganzi aku, a Nzambi, bedisa makanda<verse eid="PSA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>Sonika maniongo mama</para>
  <para style="q1" vid="PSA 56:8">Lunda matsuela mama mu khutu aku.</para>
  <para style="q1" vid="PSA 56:8">Masi ko mu lutangu luaku e ?<verse eid="PSA 56:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>Buna bambeni ziela vutikisa ku mbusa</para>
  <para style="q1" vid="PSA 56:9">mu thangu ndiela tela mu tomba lusadusu.</para>
  <para style="q1" vid="PSA 56:9">Mu diadi diela zabila ti Nzambi widi ku ndambuꞌama.<verse eid="PSA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>Mu Nzambi mutu vuidi mambu ndieti zitisa</para>
  <para style="q1" vid="PSA 56:10">Mu Yave, mutu vuidi mambu ndieti zitisa.<verse eid="PSA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11"/>Mu Nzambi nditula diana diama,</para>
  <para style="q1" vid="PSA 56:11">ndilendi mona tsisi ko ;</para>
  <para style="q1" vid="PSA 56:11">mutu mbi kalenda ku phanga e ?<verse eid="PSA 56:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>Ndidi ku tsi zindefi ziaku, a Nzambi.</para>
  <para style="q1" vid="PSA 56:12">Ndiela tambika makaba ma phutudulu matondo kuidi ngeyo.<verse eid="PSA 56:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>Bila ngeyo wukhula mu lufua,</para>
  <para style="q1" vid="PSA 56:13">ayi malu mama mu diambu mabika bumina thutu</para>
  <para style="q1" vid="PSA 56:13">muingi ndidiatilanga va ntuala Nzambi,</para>
  <para style="q1" vid="PSA 56:13">mu kiezila ki luzingu.<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="cl">Minkunga 57</para>
  <para style="s1">Ndidi mu ndembama va khatitsika bambeni</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi “kadi vonda.” Mu thangu kasuamina mu nluka matadi Sawuli bu kaba kunkuka.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1"/>Wumboni kiadi, a Nzambi,</para>
  <para style="q1" vid="PSA 57:1">wumboni kiadi !</para>
  <para style="q1" vid="PSA 57:1">Bila muelꞌama wunsuaminanga mu ngeyo</para>
  <para style="q1" vid="PSA 57:1">ndiela suamina ku kitsusula ki mavavi maku,</para>
  <para style="q1" vid="PSA 57:1">nate mabienga mela mana vioka.<verse eid="PSA 57:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>Ndiela yamikina kuidi Nzambi yizangama ;</para>
  <para style="q1" vid="PSA 57:2">kuidi Nzambi weti dukisa zikhanu ziandi kuidi minu.<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>Weti fidisa tona ku diyilu ayi weti kuphukisa ;</para>
  <para style="q1" vid="PSA 57:3">mu temina bobo beti kundandakana mu kingolo ;</para>
  <para style="q1" vid="PSA 57:3">Nzambi weti fidisa luzolo luandi</para>
  <para style="q1" vid="PSA 57:3">ayi kikhuikizi kiandi.<verse eid="PSA 57:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>Ndidi va khatitsika zikhosi ;</para>
  <para style="q1" vid="PSA 57:4">ndidi wulambalala va khatitsika bibulu bindianga minsuni ;</para>
  <para style="q1" vid="PSA 57:4">batu bobo meno mawu madi banga madionga mafioti ayi maneni</para>
  <para style="q1" vid="PSA 57:4">ludimi luawu luidi sabala yisekoso ngolo.<verse eid="PSA 57:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>Yayusu kuaku, a Nzambi, ku yilu diyilu</para>
  <para style="q1" vid="PSA 57:5">Bika nkembo aku wuba va ntoto wumvimba !<verse eid="PSA 57:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>Batambila malu mama dikondi.</para>
  <para style="q1" vid="PSA 57:6">Ndiba wukomvama mu ziphasi ;</para>
  <para style="q1" vid="PSA 57:6">Bakaba dibulu dinnene mu nsolo ama :</para>
  <para style="q1" vid="PSA 57:6">vayi bawu veka ba buidi muawu.<verse eid="PSA 57:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>Ntimꞌama widi wukinda a Nzambi ;</para>
  <para style="q1" vid="PSA 57:7">ntimꞌama widi wukinda.</para>
  <para style="q1" vid="PSA 57:7">Ndiela yimbila, ndiela bula miziki.<verse eid="PSA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>Kotuka, muelꞌama !</para>
  <para style="q1" vid="PSA 57:8">Kotukanu, ngeyo Luti ayi ngitala</para>
  <para style="q1" vid="PSA 57:8">ndiela kotula khiesa ki lumbu.<verse eid="PSA 57:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>Ndiela kuzitisa, a Yave, va khatitsika makanda.</para>
  <para style="q1" vid="PSA 57:9">Ndiela kuyimbidila va khatitsika batu.<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>Bila luzolo luaku luidi lunneni, luntulanga nate kuna diyilu,</para>
  <para style="q1" vid="PSA 57:10">kikhuikizi kiaku kintulanga nate ku matuti.<verse eid="PSA 57:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>Yayusu kuaku, a Nzambi, ku yilu Diyilu.</para>
  <para style="q1" vid="PSA 57:11">Bika nkemboꞌaku wuba va ntoto wumvimba !<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="cl">Minkunga 58</para>
  <para style="s1">Nzambi widi zuzi disonga</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi “kadi vonda”.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1"/>A buevi, beno bapfumu, mu busonga lueti yolukilanga e ?</para>
  <para style="q1" vid="PSA 58:1">Mu bufuana lueti sambisilanga batu e ?<verse eid="PSA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>Nana ! Mu mintima mieno, lueti yindula makambulu masonga</para>
  <para style="q1" vid="PSA 58:2">ayi mioko mieno milembo muangisa makhemi va ntoto.<verse eid="PSA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>Tona mu mbutukulu, batu bambimbi beti zimbala ;</para>
  <para style="q1" vid="PSA 58:3">tona mu vumu, ntu ngolo badi ayi bantubanga luvunu.<verse eid="PSA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>Mitsa miawu midi banga mitsa mi nioka,</para>
  <para style="q1" vid="PSA 58:4">banga kusa kizibikidi matu mandi<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>kinkambu wa mbembo yi batu bansakisanga zinioka ;</para>
  <para style="q1" vid="PSA 58:5">mbembo yi ndoki yiyenda tsangu.<verse eid="PSA 58:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>Kola meno mu miunu miawu, a Nzambi ;</para>
  <para style="q1" vid="PSA 58:6">vuza, a Yave, meno ma zikhosi.<verse eid="PSA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>Bika balalakana banga maza ma nkumba !</para>
  <para style="q1" vid="PSA 58:7">Mu thangu bambansula mimbasa miawu,</para>
  <para style="q1" vid="PSA 58:7">bika madionga mawu maba makambu tsongi<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>banga khodi yinsiuta bu yilembo diati ;</para>
  <para style="q1" vid="PSA 58:8">banga muana wusuluka bika kabika mona thangu.<verse eid="PSA 58:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>Tuamina zinzungu zieno zimona diamu di zitsendi</para>
  <para style="q1" vid="PSA 58:9">ziba zinlangu voti ziyuma,</para>
  <para style="q1" vid="PSA 58:9">batu bambimbi bela kombulu.<verse eid="PSA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>Basonga bela mona khini</para>
  <para style="q1" vid="PSA 58:10">bu bela mona landi kioki bela kuba vutudila ;</para>
  <para style="q1" vid="PSA 58:10">bela sukula malu mawu mu menga ma batu bambimbi.<verse eid="PSA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>Batu bela tuba :</para>
  <para style="q1" vid="PSA 58:11">“Bukiedika ; basonga bantambulanga mfutu mu kadika thangu.</para>
  <para style="q1" vid="PSA 58:11">Bukiedika vadi Nzambi weti sambisa va ntoto.”<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="cl">Minkunga 59</para>
  <para style="s1">Nzambi ama, wukhudi.</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi “Kadi vonda” mu thangu Sawuli kafidisa batu bazungidila nzo Davidi mu diambu bamvonda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1"/>Wukhula mu bambeni ziama, a Nzambi ;</para>
  <para style="q1" vid="PSA 59:1">wukhebi mu diambu bobo bamfuemini !<verse eid="PSA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>Wukhudi mu mimvangi mi mambimbi</para>
  <para style="q1" vid="PSA 59:2">ayi wuphukisa mu mintengudi mi menga.<verse eid="PSA 59:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>Tala phila balambididi mu kuphingila.</para>
  <para style="q1" vid="PSA 59:3">Batu badi ngolo bandiendidi manenga</para>
  <para style="q1" vid="PSA 59:3">bika sia ti mu diambu di</para>
  <para style="q1" vid="PSA 59:3">nzimbala yama voti mu diambu di disumu diama, a Nzambi.<verse eid="PSA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>Kadi mbimbi ndisia vanga ko</para>
  <para style="q1" vid="PSA 59:4">vayi bakubimini mu kunduanisa</para>
  <para style="q1" vid="PSA 59:4">kotuka mu kutsadisa</para>
  <para style="q1" vid="PSA 59:4">tala phila ndikila.<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>A Yave, Nzambi nkua ngolo yoso,</para>
  <para style="q1" vid="PSA 59:5">Nzambi yi Iseli, kotuka mu tumbudila makanda moso ;</para>
  <para style="q1" vid="PSA 59:5">kadi mona kadi kiadi</para>
  <para style="q1" vid="PSA 59:5">kuidi bobo beti vanga mambimbi.<verse eid="PSA 59:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6"/>Bamvutukanga va masika,</para>
  <para style="q1" vid="PSA 59:6">beti lola banga zimbua ;</para>
  <para style="q1" vid="PSA 59:6">ayi beti zungidila divula.<verse eid="PSA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>Tala, momo balembo luki mu miunu miawu.</para>
  <para style="q1" vid="PSA 59:7">Bisabala bidi mu bididi biawu.</para>
  <para style="q1" vid="PSA 59:7">Ayi balembo tubi :</para>
  <para style="q1" vid="PSA 59:7">“Nani wulenda kutu wa e ?”<verse eid="PSA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>Vayi ngeyo, a Yave, wulenda basevi ;</para>
  <para style="q1" vid="PSA 59:8">wulembo sekinina makanda moso momo.<verse eid="PSA 59:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>E ngolo ziama, kuidi ngeyo ndintala,</para>
  <para style="q1" vid="PSA 59:9">ngeyo, e Nzambi, widi tinunu kiama ki ngolo.<verse eid="PSA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10"/>Nzambi ama, wukuphangilanga mamboti Nzambi ama yi luzolo</para>
  <para style="q1" vid="PSA 59:10">wela kundengana ; Nzambi wela diata va ntuala ama</para>
  <para style="q1" vid="PSA 59:10">ayi wela kumbonisa khini vadi bobo bakuthubidilanga.<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>Vayi kadi kuba vonda, a Yave, nkaku eto,</para>
  <para style="q1" vid="PSA 59:11">bila muna batu bama bela zimbakana.</para>
  <para style="q1" vid="PSA 59:11">Mu lulendo luaku, baba mindiengidi ayi wuba buisi.<verse eid="PSA 59:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>Mu diambu di masumu ma muinu miawu,</para>
  <para style="q1" vid="PSA 59:12">mu diambu di mambu ma bididi biawu,</para>
  <para style="q1" vid="PSA 59:12">bika babuilama mu luniemo luawu.</para>
  <para style="q1" vid="PSA 59:12">Mu diambu di zitsingulu ayi luvunu beti totula,<verse eid="PSA 59:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13"/>Wuba lalikisa mu nganzi aku yi kikhesa ;</para>
  <para style="q1" vid="PSA 59:13">wuba lalikisa muingi babika buela monika</para>
  <para style="q1" vid="PSA 59:13">buna diela zabakana mu zitsuka zi ntoto</para>
  <para style="q1" vid="PSA 59:13">ti Nzambi wunyadila Yakobi.<verse eid="PSA 59:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14"/>Bamvutukanga va masika,</para>
  <para style="q1" vid="PSA 59:14">beti lola banga zimbua,</para>
  <para style="q1" vid="PSA 59:14">ayi beti zungidila divula.<verse eid="PSA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>Bandiengilanga mu diambu di bidia,</para>
  <para style="q1" vid="PSA 59:15">ayi enati bakadi yukuta,</para>
  <para style="q1" vid="PSA 59:15">buna banyamikinanga.<verse eid="PSA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>Vayi minu, ndiela yimbidila zingolo ziaku ;</para>
  <para style="q1" vid="PSA 59:16">muna nsuka, ndiela yimbidila luzolo luaku</para>
  <para style="q1" vid="PSA 59:16">bila ngeyo tinunu kiama kingolo</para>
  <para style="q1" vid="PSA 59:16">ayi suamunu mu zithangu zi ziphasi.<verse eid="PSA 59:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>A ngeyo zingolo ziama,</para>
  <para style="q1" vid="PSA 59:17">ndinyimbila nzitusu mu diambu diaku ;</para>
  <para style="q1" vid="PSA 59:17">ngeyo Nzambi, ngeyo tinunu kiama kingolo ;</para>
  <para style="q1" vid="PSA 59:17">Nzambi ama yi luzolo.<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="cl">Minkunga 60</para>
  <para style="s1">Khama mambu, tuela nunga.</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi, kayimbidila mu “Lisi” mu diambu di longisa mu thangu kanuana mvita ayi basi Sili ba Mesopotami ayi basi Sili ba Tsoba, ayi mu thangu Yowabi kavutuka ayi kabedisa kumi mafunda muadi ma basi Edomi mu ndimba Mungu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1"/>Ngeyo wutulozidi, a Nzambi</para>
  <para style="q1" vid="PSA 60:1">ayi wutusasikisidi ; wufuema</para>
  <para style="q1" vid="PSA 60:1">vayi bika buabu wutufuanisa !<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>Ngeyo wunikuni ntoto ayi ngeyo wuvasudi wawu ;</para>
  <para style="q1" vid="PSA 60:2">londa miamvu miandi bila wulembo nikuka.<verse eid="PSA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>Ngeyo wumonisini batu baku zithangu ziozi zikambulu diana</para>
  <para style="q1" vid="PSA 60:3">wutuvana vinu kindiengisanga ntu.<verse eid="PSA 60:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>Vayi kuidi bobo beti kukinzika ngeyo wutelimisi dalapo</para>
  <para style="q1" vid="PSA 60:4">mu diambu di batina va ntuala mimbasa.<verse eid="PSA 60:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>Wutuvukisa ayi wutusadisa mu koko kuaku ku lubakala</para>
  <para style="q1" vid="PSA 60:5">muingi bobo weti zola bakulu.<verse eid="PSA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6"/>Nzambi wuyoluka tona ku buangu kiandi kinlongo :</para>
  <para style="q1" vid="PSA 60:6">“mu ndungunu, ndiela vasa Sikemi,</para>
  <para style="q1" vid="PSA 60:6">ndiela teza ndimba wu Sikoti ;<verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>Minu phuidi Ngaladi, ayi minu phuidi Manase ;</para>
  <para style="q1" vid="PSA 60:7">Efalayimi yawu nkaku wu ntu ama,</para>
  <para style="q1" vid="PSA 60:7">ayi Yuda nkawꞌama wu kipfumu ;<verse eid="PSA 60:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>Mowabi diawu dibola diodi ndieti yobidila ;</para>
  <para style="q1" vid="PSA 60:8">va yilu Edoni ndiloza zisandales ziama</para>
  <para style="q1" vid="PSA 60:8">ndiela yamikina mu diambu di ndungunu ama mu basi Filisti !”<verse eid="PSA 60:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>Nani wela kundata ku divula di ngolo e ?</para>
  <para style="q1" vid="PSA 60:9">Nani wela kuthuadisa ku Edoni e ?<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>Keti ngeyo, e Nzambi, ngeyo wutuloza e ?</para>
  <para style="q1" vid="PSA 60:10">Ngeyo wutuloza ayi wunkambu buela totukanga</para>
  <para style="q1" vid="PSA 60:10">ayi minkangu mi masodi meto.<verse eid="PSA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>Wutuvana lusadusu va ntuala mbeni</para>
  <para style="q1" vid="PSA 60:11">bila lusadusu lu mutu luidi luphamba.<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>A Nzambi, tuela nunga</para>
  <para style="q1" vid="PSA 60:12">ayi wela kosikisa bambeni zieto.<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="cl">Minkunga 61</para>
  <para style="s1">Wutsueka ku tsi mavevi maku</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi ; kayimbidila mu lusinga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1"/>Wa yamikina kuama, e Nzambi</para>
  <para style="q1" vid="PSA 61:1">tamba dikutu mulusambulu luama<verse eid="PSA 61:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>Tona kusukinina ntoto, ngeyo ndintela ;</para>
  <para style="q1" vid="PSA 61:2">nditela bu ntimꞌama wumevonga ngolo ;</para>
  <para style="q1" vid="PSA 61:2">wundati va mbata dibanga</para>
  <para style="q1" vid="PSA 61:2">diodi dindutidi mu nangama.<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>Bila ngeyo wuba suamunu kiama ;</para>
  <para style="q1" vid="PSA 61:3">ngeyo wuba nzo yizangama ayi yingolo</para>
  <para style="q1" vid="PSA 61:3">va ntuala mutu weti kundenda.<verse eid="PSA 61:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>Ndiela zingila mu nzo aku yi ngoto ;</para>
  <para style="q1" vid="PSA 61:4">mu zithangu zioso ayi ndiela suamina</para>
  <para style="q1" vid="PSA 61:4">ku tsi mavavi maku.<verse eid="PSA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>Bila ngeyo, wuwa zikhanu ziama, e Nzambi ;</para>
  <para style="q1" vid="PSA 61:5">ngeyo wuphana kiuka ki batu bobo beti kinzika dizina diaku.<verse eid="PSA 61:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>Buela bilumbu bi luzingu lu ntinu,</para>
  <para style="q1" vid="PSA 61:6">mimvu miandi mu diambu di zitsungu ziwombo.<verse eid="PSA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>Bika kavuanda va kundu ki kipfumu</para>
  <para style="q1" vid="PSA 61:7">va meso ma Nzambi mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 61:7">tula luzolo luaku ayi kikhuikizi kiaku mu kunkeba.<verse eid="PSA 61:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>Buna ndiela yimbidila nzitusu mu diambu di dizina diaku</para>
  <para style="q1" vid="PSA 61:8">mu zithangu zioso ayi ndiela dedikisa zikhanu ziama</para>
  <para style="q1" vid="PSA 61:8">lumbu ka lumbu.<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="cl">Minkunga 62</para>
  <para style="s1">Muelꞌama widi mu ndembama mu Nzambi</para>
  <para style="d">Nkunga Davidi kuidi Yedutuni, pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1"/>Muelꞌama umbakanga luvovomo mu Nzambi kaka.</para>
  <para style="q1" vid="PSA 62:1">Phulusu ama kuidi niandi yimbanga.<verse eid="PSA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>Niandi kaka ditadi diama</para>
  <para style="q1" vid="PSA 62:2">ayi phulusu ama ;</para>
  <para style="q1" vid="PSA 62:2">niandi suamunu kiama kingolo ;</para>
  <para style="q1" vid="PSA 62:2">Ndilendi bulangana ko.<verse eid="PSA 62:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>Nate zithangu zikua lufueti nuanisina mutu e ?</para>
  <para style="q1" vid="PSA 62:3">Lutombidi beno boso bu kumbuisila e ?</para>
  <para style="q1" vid="PSA 62:3">Banga baka kioki kitengama</para>
  <para style="q1" vid="PSA 62:3">banga luphangu lolo lueka bua e ?<verse eid="PSA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>Balembo nyendila manenga</para>
  <para style="q1" vid="PSA 62:4">muingi bankundumuna va buangu kiandi ki zangama ;</para>
  <para style="q1" vid="PSA 62:4">khini beti mona mu mambu ma luvunu.</para>
  <para style="q1" vid="PSA 62:4">Mu muinu miawu, balembo sakumuna,</para>
  <para style="q1" vid="PSA 62:4">vayi mu khati ntima miawu, balembo singi.<verse eid="PSA 62:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>Ba mu ndembama, a muelꞌama, mu Nzambi kaka !</para>
  <para style="q1" vid="PSA 62:5">Diana diama kuidi niandi dimbanga.<verse eid="PSA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>Niandi kaka ditadi diama ayi phulusu ama ;</para>
  <para style="q1" vid="PSA 62:6">niandi suamunu kiama ki ngolo ;</para>
  <para style="q1" vid="PSA 62:6">Ndilengi bua ko.<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>Phulusu ama ayi nzitusu ama kuidi Nzambi bidi ;</para>
  <para style="q1" vid="PSA 62:7">niandi ditadi diama dingolo, suamunu kiama.<verse eid="PSA 62:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>Tulanganu diana dieno mu niandi</para>
  <para style="q1" vid="PSA 62:8">mu thangu zioso, a batu.</para>
  <para style="q1" vid="PSA 62:8">Luyalumuna mintima mieno kuidi niandi</para>
  <para style="q1" vid="PSA 62:8">bila Nzambi niandi suamunu kieto.<verse eid="PSA 62:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>Batu baphamba badi kaka phemo,</para>
  <para style="q1" vid="PSA 62:9">batu banneni badi kaka luvunu ;</para>
  <para style="q1" vid="PSA 62:9">enati babasidi va basikilu, basi kadi kiasa.</para>
  <para style="q1" vid="PSA 62:9">Kubafuba va kimosi, badi kaka phemo.<verse eid="PSA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>Kadi tulanu diana mu vinza bima bingana ;</para>
  <para style="q1" vid="PSA 62:10">voti tula luniemo mu bima bibuivi.</para>
  <para style="q1" vid="PSA 62:10">Ka diambu ko kimvuama kiaku kilembo yilama,</para>
  <para style="q1" vid="PSA 62:10">kadi tula ntimꞌaku mu biawu.<verse eid="PSA 62:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>Khumbu mosi Nzambi utuba,</para>
  <para style="q1" vid="PSA 62:11">zikhumbu zizole ndiwila :</para>
  <para style="q1" vid="PSA 62:11">ti ngeyo, a Nzambi, ngolo widi,<verse eid="PSA 62:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 62:12"/>ayi ti ngeyo, a Yave, widi kiluzolo.</para>
  <para style="q1" vid="PSA 62:12">Bukiedika, wetafuta kadika mutu boso bukasadidi.<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="cl">Minkunga 63</para>
  <para style="s1">Mamboti maku maviatukidi luzingu</para>
  <para style="d">Nkunga Davidi mu thangu kaba mu dikanga di Yuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1"/>A Nzambi ! Ngeyo widi Nzambiꞌama,</para>
  <para style="q1" vid="PSA 63:1">mu kiedika ngeyo ndintomba ;</para>
  <para style="q1" vid="PSA 63:1">muelꞌama wulembo moni phuila yi ngeyo ;</para>
  <para style="q1" vid="PSA 63:1">nitu ama tsatu yidi mu kumona mu tsi yi yuma ;</para>
  <para style="q1" vid="PSA 63:1">yibiva ; yikondolo nlangu ;<verse eid="PSA 63:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>Ndimmona mu buangu kinlongo</para>
  <para style="q1" vid="PSA 63:2">ndimona lulendo luaku ayi nkembo aku.<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>Bila luzolo luaku luviatukidi luzingu ;</para>
  <para style="q1" vid="PSA 63:3">bididi biama biela kukembisa.<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>Ndiela kuzitisa thangu yoso ndidi moyo.</para>
  <para style="q1" vid="PSA 63:4">Mu diambu di dizina diaku, ndiela vumuna mioko miama ku yilu.<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>Muelꞌama wela yukuta banga kimvuama kiwombo ki bidia</para>
  <para style="q1" vid="PSA 63:5">mu minkunga bididi bi munu ama biela kuzitisa.<verse eid="PSA 63:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>Va mbukꞌama ndikutebukilanga moyo</para>
  <para style="q1" vid="PSA 63:6">ndieti kuyindula builu bu mvimba.<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>Bila ngeyo lusadusu luama,</para>
  <para style="q1" vid="PSA 63:7">ayi ndilembo yimbila ku tsi kitsusula ki mavavi maku.<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>Muelꞌama widi wukangama mu ngeyo ;</para>
  <para style="q1" vid="PSA 63:8">ayi koko kuaku kulubakala kueti kukhindisa.<verse eid="PSA 63:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>Bobo beti tomba luzingu luama bela bungana ;</para>
  <para style="q1" vid="PSA 63:9">bela kota kuna tsi ntoto.<verse eid="PSA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>Bela kuba yekula mu lulendo lu sabala ;</para>
  <para style="q1" vid="PSA 63:10">bela kituka bidia bi zimbua zi nsitu.<verse eid="PSA 63:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>Vayi Ntinu wela mona khini mu Nzambi ;</para>
  <para style="q1" vid="PSA 63:11">baboso bobo banleva ndefi mu dizina di Nzambi bela kunzitisa.</para>
  <para style="q1" vid="PSA 63:11">Bila miunu mi bankua luvunu miela kangama.<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="cl">Minkunga 64</para>
  <para style="s1">Wukheba</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1"/>Wungwa, a Nzambi, bu ndilembo wakikisa maniongo mama</para>
  <para style="q1" vid="PSA 64:1">keba luzingu luama va ntuala mbeni yoyi</para>
  <para style="q1" vid="PSA 64:1">ndieti mona tsisi !<verse eid="PSA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>Wutsueka mu zikhanu zintotukilanga</para>
  <para style="q1" vid="PSA 64:2">mu lukutukunu lu nsueki lu batu bambimbi</para>
  <para style="q1" vid="PSA 64:2">ayi mu lukutukunu lu nkangu wu batu bamvanganga mambimbi ;</para>
  <para style="q1" vid="PSA 64:2">bobo badi bulawu.<verse eid="PSA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>Balembo bengula ludimi luawu banga sabala ;</para>
  <para style="q1" vid="PSA 64:3">bantotulanga mambu mawu banga madionga meti vonda.<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>Beti lozila bu badi mu bibuangu bisuama</para>
  <para style="q1" vid="PSA 64:4">mutu kambulu zaba diambu</para>
  <para style="q1" vid="PSA 64:4">Beti kunlozila mu kinzimbukila, mu kambu mona tsisi.<verse eid="PSA 64:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>Beti kukikindisa mu zikhanu zimbimbi ;</para>
  <para style="q1" vid="PSA 64:5">beti tubana mu diambu di batamba mintambu miawu,</para>
  <para style="q1" vid="PSA 64:5">Beti kamba : “A nani wela mimona e ?”<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>Beti yindula mambu makambulu masonga ayi beti tuba :</para>
  <para style="q1" vid="PSA 64:6">“Tukubikidi lukanu lu fuana.”</para>
  <para style="q1" vid="PSA 64:6">Bukiedika, mayindu ma tsi ntima</para>
  <para style="q1" vid="PSA 64:6">ayi ntima wu mutu thipula bidi.<verse eid="PSA 64:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>Vayi Nzambi wela kuba lozila madionga mandi</para>
  <para style="q1" vid="PSA 64:7">mu kinzimbukila bela.<verse eid="PSA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>Wela balula ludimi luawu veka mu diambu diawu</para>
  <para style="q1" vid="PSA 64:8">ayi kuba nata ku mbivusu</para>
  <para style="q1" vid="PSA 64:8">babo bela kuba mona bela nikuna ntu.<verse eid="PSA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>Batu boso bela mona tsisi,</para>
  <para style="q1" vid="PSA 64:9">bela yamikisa mavanga ma Nzambi ;</para>
  <para style="q1" vid="PSA 64:9">ayi bela sudika momo kavanga.<verse eid="PSA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>Bika mutu wusonga kamona khini mu Yave</para>
  <para style="q1" vid="PSA 64:10">ayi katombila suamunu mu niandi</para>
  <para style="q1" vid="PSA 64:10">ayi babo badi mintima mi lulama banzitisa.<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="cl">Minkunga 65</para>
  <para style="s1">Ngeyo weti kutuwokisila bima</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1"/>A Nzambi, nzitusu wulembo ku vingidila mu Sioni</para>
  <para style="q1" vid="PSA 65:1">kuidi ngeyo tuela dukisa zindefi zieto.<verse eid="PSA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>Ngeyo weti wa lusambulu ;</para>
  <para style="q1" vid="PSA 65:2">batu boso bela kuiza kuidi ngeyo.<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>Mu thangu tufietukusu kuidi masumu ;</para>
  <para style="q1" vid="PSA 65:3">ngeyo wutulemvukila mu zinzimbala zieto.<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>Lusakumunu kuidi bobo wusobula</para>
  <para style="q1" vid="PSA 65:4">ayi bobo wunata mu ba va widi</para>
  <para style="q1" vid="PSA 65:4">muingi bazingila mu luphangu luaku.</para>
  <para style="q1" vid="PSA 65:4">Tuidi bayukuta mu bima bimboti bi nzo aku,</para>
  <para style="q1" vid="PSA 65:4">bi nzo aku yinlongo.<verse eid="PSA 65:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>Ngeyo wutuveni mvutu ayi ndambu tsisi mu mavanga ma busonga.</para>
  <para style="q1" vid="PSA 65:5">A Nzambi, Mvulusi eto,</para>
  <para style="q1" vid="PSA 65:5">ngeyo diana di zitsukusunu zioso zi ntoto</para>
  <para style="q1" vid="PSA 65:5">ayi di mimbu milutidi tatuka.<verse eid="PSA 65:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>Ngeyo wuvanga miongo mu lulendo luaku ;</para>
  <para style="q1" vid="PSA 65:6">ngeyo veka wukivuika zingolo.<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>Wunlembikanga biyoko bi mimbu,</para>
  <para style="q1" vid="PSA 65:7">biyoko bi mayo mandi ayi khindu yi makanda.<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>Batu bobo banzingilanga ku thama</para>
  <para style="q1" vid="PSA 65:8">bela mona tsisi matsiminanga maku,</para>
  <para style="q1" vid="PSA 65:8">kuna kueti totukila thangu ayi ku keti diamina,</para>
  <para style="q1" vid="PSA 65:8">ngeyo wutela kuawu minkunga mi khini.<verse eid="PSA 65:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>Ngeyo wuyiza tala ntoto ayi wuwuvana nlangu ;</para>
  <para style="q1" vid="PSA 65:9">wuvana wawu bima buwombo.</para>
  <para style="q1" vid="PSA 65:9">Mila mi Nzambi midi miwala nlangu.</para>
  <para style="q1" vid="PSA 65:9">Ngeyo weti kubikila batu makundi</para>
  <para style="q1" vid="PSA 65:9">bila ngeyo wutumina buawu.<verse eid="PSA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>Weti lembila minkala miandi</para>
  <para style="q1" vid="PSA 65:10">ayi wulembo ladikisa makumutu mandi ma ntoto</para>
  <para style="q1" vid="PSA 65:10">ayi wulembo lebisa wawu mu masala ;</para>
  <para style="q1" vid="PSA 65:10">wulembo sakumuna bikunusu biandi.<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>Ngeyo weti manisina mvu mu mamboti maku ;</para>
  <para style="q1" vid="PSA 65:11">bima biwombo bilembo sapika mu zisaleti ziaku<note caller="+" style="f"><char style="fr" closed="false">65.11 </char><char style="fq" closed="false">Zisaleti</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">bima bi matoma.</char></note><verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>Bibuangu bieti mena biti mi dikanga bilembo sapika</para>
  <para style="q1" vid="PSA 65:12">zikhundubula zilembo vuati khini.<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>Mamemi mafulukidi mu bibuangu bieti mena biti ;</para>
  <para style="q1" vid="PSA 65:13">mindimba mifulukidi mu makundi ;</para>
  <para style="q1" vid="PSA 65:13">milembo yamikina mu khini ayi yimbila.<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="cl">Minkunga 66</para>
  <para style="s1">Bika Nzambi wutukula kazitusu</para>
  <para style="d">Nkunga kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1"/>Ntoto wumvimba, yamikinanu mu khini kuidi Nzambi,<verse eid="PSA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2"/>Yimbilanu nkembo wu dizina diandi.</para>
  <para style="q1" vid="PSA 66:2">Kitulanu nzitusu andi nzitusu wu nkembo !<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>Kambanu Nzambi : mavanga maku tsisi madi !</para>
  <para style="q1" vid="PSA 66:3">Lulendo luaku luidi lunneni</para>
  <para style="q1" vid="PSA 66:3">diawu bambeni ziaku zilembo kukikulula.<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>Ntoto wumvimba weti komvama va ntualꞌaku</para>
  <para style="q1" vid="PSA 66:4">ayi bela yimbila minzitusu kuidi ngeyo ;</para>
  <para style="q1" vid="PSA 66:4">bela yimbila minzitusu kuidi dizina diaku.<verse eid="PSA 66:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>Yizanu, lutala momo Nzambi kavanga.</para>
  <para style="q1" vid="PSA 66:5">Mavanga madi tsisi madi kuidi batu.<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>Wukitula mbu ntoto wuyuma ;</para>
  <para style="q1" vid="PSA 66:6">basabukila nlangu wunneni mu malu :</para>
  <para style="q1" vid="PSA 66:6">Yizanu tumona khini mu niandi.<verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>Wunyadilanga mu lulendo luandi</para>
  <para style="q1" vid="PSA 66:7">mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 66:7">Meso mandi mantalanga makanda ;</para>
  <para style="q1" vid="PSA 66:7">bika bankua matingu babika kumfuemina.<verse eid="PSA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>Zitisanu Nzambi eto, a batu</para>
  <para style="q1" vid="PSA 66:8">bika biyoko bi nzitusu andi biwakana ngolo.<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>Niandi wutanini luzingu lueto</para>
  <para style="q1" vid="PSA 66:9">ayi wukeba malu meto mabika sialumuka.<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>Bila ngeyo, a Nzambi, wutumeka</para>
  <para style="q1" vid="PSA 66:10">ngeyo wutuvedisa banga palata.<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>Wutukotisa mu nloko,</para>
  <para style="q1" vid="PSA 66:11">ngeyo wutula mimfuna mu luketo lueto.<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>Ngeyo wutala ti batu batudiatidila mu mintu mieto ;</para>
  <para style="q1" vid="PSA 66:12">beto tukota ku mbazu ayi mu nlangu,</para>
  <para style="q1" vid="PSA 66:12">vayi wutunata ku buangu kidi bima biwombo.<verse eid="PSA 66:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>Ndiela kuiza mu nzo aku ayi makaba mayoko ;</para>
  <para style="q1" vid="PSA 66:13">ayi dukisa zindefi ziama kuidi ngeyo.<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>Zindefi ziozi bididi biama bivanina tsila</para>
  <para style="q1" vid="PSA 66:14">ayi ziosi ziyolukila munu ama</para>
  <para style="q1" vid="PSA 66:14">mu thangu ndiba mu phasi.<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>Ndiela tambika bibulu bi mafuta kuidi ngeyo</para>
  <para style="q1" vid="PSA 66:15">ayi makaba ma mamemi ma mbakala ;</para>
  <para style="q1" vid="PSA 66:15">ndiela tambika zingombi ayi zikhombo zimbakala.<verse eid="PSA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>Yizanu, ayi ludimba beno boso lueti kinzika Nzambi</para>
  <para style="q1" vid="PSA 66:16">bika ndilukamba momo kavengi mu diambu diama.<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>Ndiyamikina kuidi niandi mu munu ama,</para>
  <para style="q1" vid="PSA 66:17">nzitusu andi wuba mu ludimi luama.<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>Enati ndiyayisa masumu mu ntimꞌama,</para>
  <para style="q1" vid="PSA 66:18">nganu Yave kasia diamba ko.<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>Vayi bukiedika Nzambi wudimba</para>
  <para style="q1" vid="PSA 66:19">ayi wuwa mbembo ama mu lusambulu.<verse eid="PSA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>Nzitusu wuba kuidi Nzambi,</para>
  <para style="q1" vid="PSA 66:20">niandi kasia loza ko lusambulu luama ;</para>
  <para style="q1" vid="PSA 66:20">voti kasia botula ko luzolo luandi mu minu.<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="cl">Minkunga 67</para>
  <para style="s1">Bika batu boso bazitisa Nzambi</para>
  <para style="d">Nkunga kuidi pfumu minyimbidi, kayimbidila mu ngitala.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1"/>Bika Nzambi katusila nlemvo ayi katusakumuna ;</para>
  <para style="q1" vid="PSA 67:1">ayi zizi kiandi kitukienzula ;<verse eid="PSA 67:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>muingi zinzila ziaku zizabakana va ntoto,</para>
  <para style="q1" vid="PSA 67:2">phulusu aku yizabakana</para>
  <para style="q1" vid="PSA 67:2">muidi makanda moso !<verse eid="PSA 67:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>Bika batu bazitisa, a Nzambi ;</para>
  <para style="q1" vid="PSA 67:3">bika batu boso bazitisa.<verse eid="PSA 67:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>Bika makanda mayangalala</para>
  <para style="q1" vid="PSA 67:4">ayi mayimbila mu diambu di khini</para>
  <para style="q1" vid="PSA 67:4">bila ngeyo weti yadila batu mu busonga ;</para>
  <para style="q1" vid="PSA 67:4">ngeyo wela diatisa makanda ma ntoto.<verse eid="PSA 67:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>Bika batu bazitisa, a Nzambi ;</para>
  <para style="q1" vid="PSA 67:5">bika batu boso bazitisa.<verse eid="PSA 67:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>Buna ntoto wuela buta mimbutu miandi ;</para>
  <para style="q1" vid="PSA 67:6">Nzambi, Nzambi eto, wela kutusakumuna.<verse eid="PSA 67:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>Nzambi wela kutusakumuna</para>
  <para style="q1" vid="PSA 67:7">ayi zitsuka zioso zi ntoto ziela kunkinzika.<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="cl">Minkunga 68</para>
  <para style="s1">Ndungunu yi Nzambi</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1"/>Bika Nzambi katelama ;</para>
  <para style="q1" vid="PSA 68:1">bika bambeni bandi zisasukusu ayi bobo beti kunlenda</para>
  <para style="q1" vid="PSA 68:1">bantina va ntualꞌandi.<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>Banga bueti lalikinina muisi mu phemo, bika wuba lalikisa ;</para>
  <para style="q1" vid="PSA 68:2">banga bueta siutila sile<note caller="+" style="f"><char style="fr" closed="false">68.2 </char><char style="fq" closed="false">Sile</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">phila mafuta mansadulungu mu mafuta ma niosi ; meti vindungu mu mabaya.</char></note> ku mbazu</para>
  <para style="q1" vid="PSA 68:2">bika batu bambimbi babungana va meso ma Nzambi.<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>Vayi bika batu basonga bamona khini ;</para>
  <para style="q1" vid="PSA 68:3">ayi bayangalala va ntuala Nzambi,</para>
  <para style="q1" vid="PSA 68:3">bika bamona mayangi ayi khini yingolo.<verse eid="PSA 68:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>Yimbidilanu Nzambi ; yimbidilanu minzitusu mu diambu di dizina diandi ;</para>
  <para style="q1" vid="PSA 68:4">yayisanu mutu wowo wundiatila va phunda mu matuti</para>
  <para style="q1" vid="PSA 68:4">Dizina diandi Yave ;</para>
  <para style="q1" vid="PSA 68:4">ayi lumona khini va ntualꞌandi.<verse eid="PSA 68:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>Nzambi niandi widi dise di bisana ayi</para>
  <para style="q1" vid="PSA 68:5">niandi weti nuanina mafuola.</para>
  <para style="q1" vid="PSA 68:5">Mu buangu kiandi kinlongo kioki keti vuanda.<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>Nzambi wumvananga dikanda kuidi bobo</para>
  <para style="q1" vid="PSA 68:6">badi bawu veka ;</para>
  <para style="q1" vid="PSA 68:6">niandi weti tuadisa basi nloko mu ngimbudulu</para>
  <para style="q1" vid="PSA 68:6">vayi bankua matingu bawu banzingilanga mu ntoto wu yuma.<verse eid="PSA 68:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>Mu thangu wutuaminina</para>
  <para style="q1" vid="PSA 68:7">batu baku ku ntuala, a Nzambi,</para>
  <para style="q1" vid="PSA 68:7">mu thangu mu dikanga,<verse eid="PSA 68:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>ntoto wunikuka, diyilu dinokisa mvula va ntualꞌaku.</para>
  <para style="q1" vid="PSA 68:8">Va ntuala Nzambi, mutu wu Sinayi</para>
  <para style="q1" vid="PSA 68:8">va ntuala Nzambi, Nzambi yi Iseli.<verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>Ngeyo wunokisa masala mawombo, a Nzambi ;</para>
  <para style="q1" vid="PSA 68:9">ngeyo wukindisa kiuka kiaku mu thangu kivonga.<verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>Batu baku bavuanda muawu</para>
  <para style="q1" vid="PSA 68:10">A Nzambi, mu mamboti maku,</para>
  <para style="q1" vid="PSA 68:10">ngeyo wukubika bima mu diambu di nsukami.<verse eid="PSA 68:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>Yave wutuba diambu dimosi :</para>
  <para style="q1" vid="PSA 68:11">batu bawombo bamonika mu yamikisa mawu.<verse eid="PSA 68:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>Mintinu ayi minkangu mi masodi</para>
  <para style="q1" vid="PSA 68:12">milembo tini mu thinu nsualu,</para>
  <para style="q1" vid="PSA 68:12">mu bika bi batu, batu bakabula biobi baziona mu mvita.<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>Lukidi kueno leki va khatitsika bidikulu bi bibulu</para>
  <para style="q1" vid="PSA 68:13">mavavi ma dibembi diama mavindu palata,</para>
  <para style="q1" vid="PSA 68:13">zitsala ziandi zivindu nolo yilembo lezama.<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>Thangu Nzambi nkua ngolo yoso kasasikisa mintinu va ntoto,</para>
  <para style="q1" vid="PSA 68:14">yiba banga yi matadi ma phembi.<verse eid="PSA 68:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>Miongo mi Basani midi miongo mi nzitusu ;</para>
  <para style="q1" vid="PSA 68:15">miongo mi Basani midi miongo midi zitsongi ziwombo.<verse eid="PSA 68:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>A bila mbi luntadila mu kikhenene,</para>
  <para style="q1" vid="PSA 68:16">e beno miongo midi zitsongi ziwombo ;</para>
  <para style="q1" vid="PSA 68:16">mongo wowo kasobula mu yadila,</para>
  <para style="q1" vid="PSA 68:16">kuna niandi veka Yave kela vuandanga mu zithangu zioso.<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>Matoma ma mvita<note caller="+" style="f"><char style="fr" closed="false">68.17 </char><char style="fq" closed="false">Matoma ma mvita</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">voti saleti.</char></note> ma Yave</para>
  <para style="q1" vid="PSA 68:17">madi dikumi di zimili ayi zimili yi zimili ;</para>
  <para style="q1" vid="PSA 68:17">Yave wutotukila ku Sinayi mu buangu kiandi kinlongo.<verse eid="PSA 68:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>Thangu wukuma ku yilu,</para>
  <para style="q1" vid="PSA 68:18">wunata mu ntandꞌaku batu bakangama.</para>
  <para style="q1" vid="PSA 68:18">Wutambula makaba kuidi batu ayi kuidi bankua matingu</para>
  <para style="q1" vid="PSA 68:18">muingi ngeyo, a Yave Nzambi wuvuanda kuna.<verse eid="PSA 68:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>Nzitusu kuidi Yave, kuidi Nzambi mvulusi eto.</para>
  <para style="q1" vid="PSA 68:19">Niandi weti kutunatina bizitu bieto lumbu ka lumbu.</para>
  <para style="q1" vid="PSA 68:19">Niandi Nzambi wukutuvananga phulusu.<verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>Nzambi eto widi Nzambi weti vukisa.</para>
  <para style="q1" vid="PSA 68:20">Yave, mutu wumvanganga momo kazodidi, wumvukisanga mu lufua.<verse eid="PSA 68:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>Bukiedika, Nzambi wela kosikisa mintu mi bambeni bandi ;</para>
  <para style="q1" vid="PSA 68:21">wela kosikisa mintu mi batu bobo badi zitsuki ziwombo,</para>
  <para style="q1" vid="PSA 68:21">bobo bandiatilanga mu masumu mawu.<verse eid="PSA 68:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>Pfumu tubidi :</para>
  <para style="q1" vid="PSA 68:22">“Ndiela kuba totula mu Basani,</para>
  <para style="q1" vid="PSA 68:22">ndiela kuba totula ku tsina yi mbu,<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>Muingi wubuika malu maku mu menga</para>
  <para style="q1" vid="PSA 68:23">ma bobo beti kulenda ayi ludimi lu zimbua ziaku</para>
  <para style="q1" vid="PSA 68:23">lubaka kuku kiawu.”<verse eid="PSA 68:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>Ndiatulu aku yimonika, a Nzambi.</para>
  <para style="q1" vid="PSA 68:24">Ndiatulu yi Nzambi ama,</para>
  <para style="q1" vid="PSA 68:24">ayi yi ntinu ama mu buangu kinlongo.<verse eid="PSA 68:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>Minyimbidi miba ku ntuala ;</para>
  <para style="q1" vid="PSA 68:25">bosi minsiki mi miziki miba landakana,</para>
  <para style="q1" vid="PSA 68:25">miba va kimosi bana ba baketo bansika zindungu.<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>Bika luzitisa Nzambi mu lukutukunu lunneni,</para>
  <para style="q1" vid="PSA 68:26">Luzitisa Yave mu dikabu di Iseli !<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>Kuna kuidi dikanda di fioti di Benzami, wuba tuadisa,</para>
  <para style="q1" vid="PSA 68:27">kuna kuba batu bawombo banneni ba Yuda</para>
  <para style="q1" vid="PSA 68:27">ayi batu banneni ba Zabuloni ayi ba Nefitali.<verse eid="PSA 68:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>Tumina lulendo luaku, a Nzambi.</para>
  <para style="q1" vid="PSA 68:28">Wutumonisa zingolo ziaku, a Nzambi</para>
  <para style="q1" vid="PSA 68:28">banga bobo wutuama vangila.<verse eid="PSA 68:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>Mu diambu di nzo aku ku Yelusalemi ;</para>
  <para style="q1" vid="PSA 68:29">mintinu miela kunatina makaba.<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>Tubidila bulu va khatitsika masoso<note caller="+" style="f"><char style="fr" closed="false">68.30 </char><char style="fq" closed="false">Bulu va khatitsika masoso</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">dinsundula Ezipite</char></note></para>
  <para style="q1" vid="PSA 68:30">nkangu zingombi zi mbakala va khatitsika</para>
  <para style="q1" vid="PSA 68:30">bana zingombi<note caller="+" style="f"><char style="fr" closed="false">68.30 </char><char style="fq" closed="false">Zingombi zi mbakala va khatitsika bana zingombi</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">dinsundula bapfumu ba Ezipite.</char></note> zi makanda.</para>
  <para style="q1" vid="PSA 68:30">Bu kakululu, wulenda nata bitini bi palata.</para>
  <para style="q1" vid="PSA 68:30">Sasikisa makanda mona khini mu</para>
  <para style="q1" vid="PSA 68:30">nuana mvita !<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>Batu bafidusu bela totukila mu Ezipite ;</para>
  <para style="q1" vid="PSA 68:31">Kusi wela kukiyekula niandi veka ku tsi minsua mi Nzambi.<verse eid="PSA 68:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>Yimbidilanu Nzambi beno bipfumu bi ntoto ;</para>
  <para style="q1" vid="PSA 68:32">yimbilanu minzitusu kuidi Yave ;<verse eid="PSA 68:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>Kuidi mutu wowo wundiatila banga va mbata phunda</para>
  <para style="q1" vid="PSA 68:33">mu diyilu, mu diyilu di khulu.</para>
  <para style="q1" vid="PSA 68:33">Mutu wowo wulembo dumu mu mbembo yi lulendo.<verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>Luyamikisa lulendo lu Nzambi</para>
  <para style="q1" vid="PSA 68:34">nzitusu andi widi va mbata Iseli</para>
  <para style="q1" vid="PSA 68:34">lulendo luandi luidi mu matuti.<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>Tsisi widi, a Nzambi,</para>
  <para style="q1" vid="PSA 68:35">mu buangu kiaku kinlongo.</para>
  <para style="q1" vid="PSA 68:35">Nzambi yi Iseli niandi weti vana lulendo</para>
  <para style="q1" vid="PSA 68:35">ayi zingolo kuidi batu bandi.</para>
  <para style="q1" vid="PSA 68:35">Nzitusu wuba kuidi Nzambi.<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="cl">Minkunga 69</para>
  <para style="s1">A Nzambi wuphukisa</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi kayimbidila mu “LISI”.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1"/>Wuphukisa, a Nzambi,</para>
  <para style="q1" vid="PSA 69:1">bila minlangu mitudidi nate mu dinga diama.<verse eid="PSA 69:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>Ndilembo diami mu nyamba wungolo ;</para>
  <para style="q1" vid="PSA 69:2">kuna kukambulu buangu ki singikila kulu ;</para>
  <para style="q1" vid="PSA 69:2">khotidi nate ku tsi nlangu widi thipula</para>
  <para style="q1" vid="PSA 69:2">mayo mambinini.<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>Mbeni vonga mu diambu di telanga lusadusu</para>
  <para style="q1" vid="PSA 69:3">dinga diama dieka yuma,</para>
  <para style="q1" vid="PSA 69:3">meso mama malembo vongi mu talanga Nzambi ama.<verse eid="PSA 69:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>Bobo bakundendanga mu kambu bila</para>
  <para style="q1" vid="PSA 69:4">badi bawombo viokila zitsuki zi ntuꞌama ;</para>
  <para style="q1" vid="PSA 69:4">bawombo badi bambeni ziama mu kambu bila</para>
  <para style="q1" vid="PSA 69:4">bobo bantomba kumbunga.</para>
  <para style="q1" vid="PSA 69:4">Ndilembo kuiku mu vutula biobi ndisia yiba ko.<verse eid="PSA 69:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>Ngeyo zebi buvungisi buama, a Nzambi</para>
  <para style="q1" vid="PSA 69:5">zinzimbala ziama zisiko zisuama kuidi ngeyo.<verse eid="PSA 69:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>Bika batu bobo bantulanga diana mu ngeyo babika fua tsoni</para>
  <para style="q1" vid="PSA 69:6">mu diambu diama ! A Yave, Yave nkua ngolo yoso</para>
  <para style="q1" vid="PSA 69:6">bika bobo bakutombanga</para>
  <para style="q1" vid="PSA 69:6">babika ba dio kombolo mu diambu diama, a Nzambi yi Iseli.<verse eid="PSA 69:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>Bila mu diambu diaku ndinkininina lenzo</para>
  <para style="q1" vid="PSA 69:7">ayi tsoni yifukidi zizi kiama ;<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>Ndieka nzenza kuidi bakhomba ziama ;</para>
  <para style="q1" vid="PSA 69:8">ayi nkibi kuidi bana ba ngudi ama.<verse eid="PSA 69:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>Bila luzolo mu diambu di nzo aku lulembo nzinisa.</para>
  <para style="q1" vid="PSA 69:9">Ayi bifingu bi batu bobo bakufinganga</para>
  <para style="q1" vid="PSA 69:9">bibuidi va minu.<verse eid="PSA 69:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>Bu ndieti dila ayi ndieti kifuisa nzala</para>
  <para style="q1" vid="PSA 69:10">mu diambu di lusambulu.</para>
  <para style="q1" vid="PSA 69:10">Buna mfueti kikinina lenzo<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>Bu ndieti vuata tsaku,</para>
  <para style="q1" vid="PSA 69:11">batu beti kukhitula savu.<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>Bobo bavuendi va muelo, minu bansekinina</para>
  <para style="q1" vid="PSA 69:12">ayi ndieti nkunga wu bakolo-mbungu.<verse eid="PSA 69:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>Vayi, kuidi ngeyo, ndieti sambila, a Yave ;</para>
  <para style="q1" vid="PSA 69:13">mu thangu yi nlemvo aku,</para>
  <para style="q1" vid="PSA 69:13">mu luzolo luaku lunneni, a Nzambi</para>
  <para style="q1" vid="PSA 69:13">bika wuphana mvutu mu phulusu aku yi kiedika !<verse eid="PSA 69:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>Wuthotula mu nyamba, kadi tala ti ndidiama.</para>
  <para style="q1" vid="PSA 69:14">Bika wukhula mu batu bobo beti kundenda</para>
  <para style="q1" vid="PSA 69:14">mu minlangu midi thipula !<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>Kadi tala ti khuka yi nlangu yimbina</para>
  <para style="q1" vid="PSA 69:15">voti tsi yi minlangu yi ndalumuna</para>
  <para style="q1" vid="PSA 69:15">voti dibulu ndinzibila munu andi.<verse eid="PSA 69:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>Bika wuphana mvutu Yave</para>
  <para style="q1" vid="PSA 69:16">boso buididi mamboti ma luzolo luaku ;</para>
  <para style="q1" vid="PSA 69:16">mu kiadi kiaku kinneni ;</para>
  <para style="q1" vid="PSA 69:16">bika wubaluka kuidi minu.<verse eid="PSA 69:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>Kadi suekila kisadi kiaku zizi kiaku ;</para>
  <para style="q1" vid="PSA 69:17">wuphani mvutu mu nsualu nsualu bila mu phasi ndidi.<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>Fikama ayi wukhudi ;</para>
  <para style="q1" vid="PSA 69:18">Khudi mu diambu di bobo beti kundenda !<verse eid="PSA 69:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>Ngeyo zebi buevi ndidi wulenzo,</para>
  <para style="q1" vid="PSA 69:19">ndidi dio kombolo ayi ndidi mu tsoni</para>
  <para style="q1" vid="PSA 69:19">Bambeni ziama zioso zidi va ntualꞌaku.<verse eid="PSA 69:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>Nlenzo wukosikisidi ntimꞌama</para>
  <para style="q1" vid="PSA 69:20">ayi wumbika kadi lusadusu</para>
  <para style="q1" vid="PSA 69:20">nditomba bambona kiadi, vayi kusia monika kadi mutu ko ;</para>
  <para style="q1" vid="PSA 69:20">mu diambu di mimbombi, vayi ndisia bakula kadi mutu ko.<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>Batudidi biyimbu mu bidia biama,</para>
  <para style="q1" vid="PSA 69:21">ayi banduikisa vini ki ngami</para>
  <para style="q1" vid="PSA 69:21">mu phuila yiba yama.<verse eid="PSA 69:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>Bika meza batula va ntualꞌawu yikituka dikondi</para>
  <para style="q1" vid="PSA 69:22">yikituka mfutu ayi ntambu.<verse eid="PSA 69:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>Bika meso mawu maba mu tombi</para>
  <para style="q1" vid="PSA 69:23">ayi mabika buela mona ;</para>
  <para style="q1" vid="PSA 69:23">ayi manima mawu maba ma komvama mu zithangu zioso.<verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>Wuba dukuidila miangu miaku mi ngolo</para>
  <para style="q1" vid="PSA 69:24">ayi bika nganzi aku yi ngolo yiba buila.<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>Bika buangu kiawu kikitunga dikanga</para>
  <para style="q1" vid="PSA 69:25">kubika buela monika mutu wumvuanda mu zinzo ziawu zi ngoto.<verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>Bila balembo yamisa batu bobo wulueka ;</para>
  <para style="q1" vid="PSA 69:26">beti yolukila ziphasi zi batu bobo wumonisa phasi<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>Wuba yekudila mambimbi va yilu mambimbi</para>
  <para style="q1" vid="PSA 69:27">kadi tala ti babaka kuku mu phulusu aku.<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>Bika bakubulu mu buku yi luzingu,</para>
  <para style="q1" vid="PSA 69:28">ayi babika tangu va kimosi ayi batu basonga !<verse eid="PSA 69:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>Ndidi mu phasi ayi mu mabienga</para>
  <para style="q1" vid="PSA 69:29">bika phulusu aku, a Nzambi yikheba<verse eid="PSA 69:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>Ndiela zitisanga dizina di Nzambi mu nkunga,</para>
  <para style="q1" vid="PSA 69:30">ayi ndiela kunkembisa</para>
  <para style="q1" vid="PSA 69:30">mu phutudulu matondo.<verse eid="PSA 69:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>Buna diodi diela luta monisa Yave khini</para>
  <para style="q1" vid="PSA 69:31">viokila ngombi yimbakala,</para>
  <para style="q1" vid="PSA 69:31">viokila ngombi yidi ziphoka ayi bikodi bivasuka.<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>Nsukami wela mona ayi wela yangalala ;</para>
  <para style="q1" vid="PSA 69:32">beno lueti tomba Nzambi,</para>
  <para style="q1" vid="PSA 69:32">bika mintima mieno mizinga.<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>Yave weti wila nsukami</para>
  <para style="q1" vid="PSA 69:33">ayi kalenzanga ko batu bandi bakangama.<verse eid="PSA 69:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>Bika Diyilu ayi ntoto binzitisa,</para>
  <para style="q1" vid="PSA 69:34">mimbu ayi bibioso bieti</para>
  <para style="q1" vid="PSA 69:34">diatanga muawu.<verse eid="PSA 69:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>Bila Nzambi wela vukisa Sioni,</para>
  <para style="q1" vid="PSA 69:35">ayi wela buela tunga mavula ma Yuda,</para>
  <para style="q1" vid="PSA 69:35">buna batu bela kala muawu ayi kuma vua<verse eid="PSA 69:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36"/>Mela ba kiuka ki bana ba bisadi biandi,</para>
  <para style="q1" vid="PSA 69:36">ayi bobo beti zolanga dizina diandi</para>
  <para style="q1" vid="PSA 69:36">bela vuandanga mawu.<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="cl">Minkunga 70</para>
  <para style="s1">Nzambi yiza wutsadisa</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi mu diambu di thebokolo moyo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1"/>Yiza nsualu, a Nzambi, mu kukhula !</para>
  <para style="q1" vid="PSA 70:1">Yave, yiza nsualu mu kutsadisa !<verse eid="PSA 70:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>Bika bobo bantomba luzingu luama</para>
  <para style="q1" vid="PSA 70:2">bafua tsoni ayi baba dio kombolo !</para>
  <para style="q1" vid="PSA 70:2">Bika bobo bantomba mbivusu ama</para>
  <para style="q1" vid="PSA 70:2">bavutuka ku mbusa ayi bafua tsoni.<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>Bika bobo beti tuba kuidi minu : “A… A…”</para>
  <para style="q1" vid="PSA 70:3">bavutuka ku mbusa mu diambu di zitsoni ziawu.<verse eid="PSA 70:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>Babo bakutombanga bamona khini</para>
  <para style="q1" vid="PSA 70:4">ayi bayangalala mu ngeyo ;</para>
  <para style="q1" vid="PSA 70:4">bika bobo banzolanga phulusu aku</para>
  <para style="q1" vid="PSA 70:4">batubanga mu zithangu zioso :</para>
  <para style="q1" vid="PSA 70:4">“Bika Nzambi kayayusu.”<verse eid="PSA 70:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>Vayi minu ndidi nsukami ayi nkua kiadi</para>
  <para style="q1" vid="PSA 70:5">yiza nsualu kuidi minu, a Nzambi !</para>
  <para style="q1" vid="PSA 70:5">Ngeyo nsadisi ama ayi nkudi ama ;</para>
  <para style="q1" vid="PSA 70:5">A Yave kadi zingila !<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="cl">Minkunga 71</para>
  <para style="s1">Kadi kundiekula mu bununu buama</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1"/>Mu ngeyo, a Yave, ndisuamina</para>
  <para style="q1" vid="PSA 71:1">kadi tala ti ndifua tsoni kadi khumbu yimosi !<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>Wukhudi ayi wuphukisa mu busonga buaku</para>
  <para style="q1" vid="PSA 71:2">balula dikutu diaku kuidi minu ayi phukisa.<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>Ba ditadi diama diodi di kutsuekanga ;</para>
  <para style="q1" vid="PSA 71:3">momo ndilenda kuenda mu zithangu zioso</para>
  <para style="q1" vid="PSA 71:3">vana lutumunu mu kuphukisa</para>
  <para style="q1" vid="PSA 71:3">bila widi ditadi diama</para>
  <para style="q1" vid="PSA 71:3">ayi tinunu kiama ki ngolo.<verse eid="PSA 71:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>Wukhudi Nzambi ama mu mioko mi batu bambimbi ;</para>
  <para style="q1" vid="PSA 71:4">mu mioko mi batu bamvanganga mambimbi ayi mu batu badi tsita.<verse eid="PSA 71:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>Bila ngeyo wuba diana diama, a Yave,</para>
  <para style="q1" vid="PSA 71:5">ngeyo wumvanganga moso wuzodidi.</para>
  <para style="q1" vid="PSA 71:5">Diana diama tona mu bumuana buama.<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>Tona ndibutuka, mu ngeyo ndieti singimina ;</para>
  <para style="q1" vid="PSA 71:6">ngeyo wuthotula tona mu vumu ki ngudi ama ;</para>
  <para style="q1" vid="PSA 71:6">Ngeyo ndiela zitisanga mu zithangu zioso.<verse eid="PSA 71:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>Ndieka banga diambu di siminina kuidi bawombo,</para>
  <para style="q1" vid="PSA 71:7">vayi ngeyo suamunu kiama kingolo.<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>Munu ama widi wuwala mu nzitusu aku</para>
  <para style="q1" vid="PSA 71:8">wunyamikisa kiezila kiaku mu lumbu kimvimba.<verse eid="PSA 71:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>Kadi kundoza mu thangu ndieka nunu ;</para>
  <para style="q1" vid="PSA 71:9">kadi kundiekula mu thangu zingolo ziama zilembu suki !<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>Bila bambeni ziama zilembo thubidila</para>
  <para style="q1" vid="PSA 71:10">bobo balembo tombi kuphonda, balembo wizana va kimosi,<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>balembo tubi : “Nzambi wunyekudi,</para>
  <para style="q1" vid="PSA 71:11">nlandakananu,</para>
  <para style="q1" vid="PSA 71:11">bila kuisi ko mutu wufueti ku nkula.”<verse eid="PSA 71:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>Kadi ba thama ayi minu, a Nzambi,</para>
  <para style="q1" vid="PSA 71:12">yiza nsualu Nzambi ama mu kutsadisa !<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>Bika mimfundi miama mibungana mu tsoni ;</para>
  <para style="q1" vid="PSA 71:13">bika bobo bantomba kuphanga phasi baba ba lenzo ayi dio kombolo.<verse eid="PSA 71:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>Vayi kuidi minu, ndiela tulanga kaka diana mu zithangu zioso</para>
  <para style="q1" vid="PSA 71:14">buela kuzitisanga ngolo.<verse eid="PSA 71:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>Munu ama wela yolukila busonga buaku</para>
  <para style="q1" vid="PSA 71:15">ayi phulusu aku mu lumbu kimvimba,</para>
  <para style="q1" vid="PSA 71:15">bila ndikadi zaba tezo biawu.<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>Ndiela kuiza ayi yamikisa mavanga maku ma lulendo ;</para>
  <para style="q1" vid="PSA 71:16">a Yave, mutu wumvanganga makazodidi</para>
  <para style="q1" vid="PSA 71:16">ndiela yamikisa busonga buaku ; busonga buaku kaka.<verse eid="PSA 71:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>Tona mu bumuana buama, a Nzambi, ngeyo wundonga</para>
  <para style="q1" vid="PSA 71:17">ayi ye lumbu kiaki yayi ndinyamikisanga matsiminanga maku.<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>Bobuawu, bu ndiela nuna ayi zitsuki ziphembi</para>
  <para style="q1" vid="PSA 71:18">kadi ku ndiekula, a Nzambi.</para>
  <para style="q1" vid="PSA 71:18">Muingi nditubila lulendo luaku kuidi tsungi yinkuiza,</para>
  <para style="q1" vid="PSA 71:18">zingolo ziaku kuidi babo bela kuiza.<verse eid="PSA 71:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>Busonga buaku buntula nate ku diyilu, a Nzambi.</para>
  <para style="q1" vid="PSA 71:19">Ngeyo wuvanga mambu manneni ;</para>
  <para style="q1" vid="PSA 71:19">nani a Nzambi widi banga ngeyo e ?<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>Ngeyo wumbonisa ziphasi ziwombo ayi zindudi ;</para>
  <para style="q1" vid="PSA 71:20">wela buela kuphutudila luzingu ;</para>
  <para style="q1" vid="PSA 71:20">tona ku tsi ntoto, ngeyo wela buela kuthotula.<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>Wela buela wokisa nzitusu ama,</para>
  <para style="q1" vid="PSA 71:21">ayi buela ku khindisa diaka.<verse eid="PSA 71:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>Ndiela kuzitisa mu ngitala</para>
  <para style="q1" vid="PSA 71:22">mu diambu di kikhuikizi kiaku, a Nzambi ama ;</para>
  <para style="q1" vid="PSA 71:22">ndiela kuyimbidila minzitusu mu Lila.</para>
  <para style="q1" vid="PSA 71:22">Ngeyo nlongo wu Iseli.<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>Bididi biama biela yimbila mu diambu di khini</para>
  <para style="q1" vid="PSA 71:23">mu thangu ndiela kuyimbidila minzitusu,</para>
  <para style="q1" vid="PSA 71:23">minu mutu wowo wukula.<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>Ludimi luama luela yolukila mavanga maku masonga</para>
  <para style="q1" vid="PSA 71:24">mu lumbu kimvimba,</para>
  <para style="q1" vid="PSA 71:24">Bila bobo bantomba kumbonisa phasi</para>
  <para style="q1" vid="PSA 71:24">bela fua tsoni ayi bela ba dio kombolo.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="cl">Minkunga 72</para>
  <para style="s1">Lusambulu mu diambu di ntinu</para>
  <para style="d">Nkunga Salomo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1"/>Vuika ntinu fuanana kuaku, a Nzambi</para>
  <para style="q1" vid="PSA 72:1">kuidi muana ntinu busonga buaku !<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>Niandi wela sambisa batu baku mu busonga</para>
  <para style="q1" vid="PSA 72:2">ayi batu baku badi mu phasi mu bufuana.<verse eid="PSA 72:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>Miongo miela natina batu mamboti ;</para>
  <para style="q1" vid="PSA 72:3">ayi zikhundubula ziela nata mimbutu mi busonga.<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>Wela vavila batu mu phasi va khatitsika batu</para>
  <para style="q1" vid="PSA 72:4">ayi wela vukisa bana bansukami</para>
  <para style="q1" vid="PSA 72:4">wela kosikisa mutu wunyamisanga batu.<verse eid="PSA 72:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>Bela kanga ntima thangu bu yikidi</para>
  <para style="q1" vid="PSA 72:5">ngondi bu yikidi mu zitsungi zioso.<verse eid="PSA 72:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>Niangi wela ba banga mvula yinnokina mu tsola yisolo,</para>
  <para style="q1" vid="PSA 72:6">banga mabeti ma disala mambua mu ntoto.<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>Mu bilumbu biandi, mutu wusonga wela mona mamboti,</para>
  <para style="q1" vid="PSA 72:7">mamboti mela yilama</para>
  <para style="q1" vid="PSA 72:7">nate ngondi yela zimbala.<verse eid="PSA 72:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>Wela yadilanga tona ku mbu nate ku mbu wunkaka ;</para>
  <para style="q1" vid="PSA 72:8">ayi tona ku nlangu wunneni nate kuna zitsuka zi ntoto.<verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>Makanda ma dikanga mela</para>
  <para style="q1" vid="PSA 72:9">buongama va ntualꞌandi ayi bambeni bandi</para>
  <para style="q1" vid="PSA 72:9">ziela venda fundu-fundu.<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>Mintinu mi Talisi ayi mi bisanga bidi thama</para>
  <para style="q1" vid="PSA 72:10">miela kunnatina phaku</para>
  <para style="q1" vid="PSA 72:10">Mintinu mi Saba ayi mi Seba</para>
  <para style="q1" vid="PSA 72:10">miela kumvana makaba.<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>Mintinu mioso miela buongama va ntualꞌandi</para>
  <para style="q1" vid="PSA 72:11">ayi makanda moso mela kunsadilanga.<verse eid="PSA 72:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>Bila wela kula nsukami wulembo yamikina ;</para>
  <para style="q1" vid="PSA 72:12">mutu widi mu phasi kambulu mutu wulenda sadisa.<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>Wela mona mutu wulebakana ayi nsukami kiadi</para>
  <para style="q1" vid="PSA 72:13">ayi wela vukisa minsukami mu lufua.<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>Wela kula kuba kula mu khuamusu ayi mu makhemi</para>
  <para style="q1" vid="PSA 72:14">ayi menga mawu thalu madi va meso mandi.<verse eid="PSA 72:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>Bika kazinga !</para>
  <para style="q1" vid="PSA 72:15">Bika baba kumvana nolo yela ba ku Saba ;</para>
  <para style="q1" vid="PSA 72:15">Bika batu bansambila mu zithangu zioso,</para>
  <para style="q1" vid="PSA 72:15">ayi bela kunsakumuna mu lumbu kimvimba.<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>Bika makundi maba mawombo mu tsi</para>
  <para style="q1" vid="PSA 72:16">nate va mbata miongo</para>
  <para style="q1" vid="PSA 72:16">ayi bika mimbutu miandi mibuta banga Lebanoni</para>
  <para style="q1" vid="PSA 72:16">bika miba mimboti banga biti bi tsola.<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>Bika dizina diandi dizingila mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 72:17">bika dizina diandi dizinga thangu bu yikidi lezama.</para>
  <para style="q1" vid="PSA 72:17">Makanda moso mela sakumunu mu niandi</para>
  <para style="q1" vid="PSA 72:17">ayi bela kuntedila mutu wu lusakumunu.<verse eid="PSA 72:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>Nzitusu wuba kuidi Yave Nzambi</para>
  <para style="q1" vid="PSA 72:18">Nzambi yi Iseli,</para>
  <para style="q1" vid="PSA 72:18">Bila niandi veka kaka wumvanganga matsiminanga.<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>Nzitusu wuba kuidi dizina diandi</para>
  <para style="q1" vid="PSA 72:19">di nkembo mu zithangu zioso</para>
  <para style="q1" vid="PSA 72:19">Bika ntoto wumvimba wuwala nkembo andi !</para>
  <para style="qr" vid="PSA 72:19">Amen ! Amen !<verse eid="PSA 72:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>Vava vasukila zitsambulu zi Davidi, muana Yese.<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">BUKU YI NTATU</para>
  <para style="cl">Minkunga 73</para>
  <para style="s1">Bila mbi batu bambimbi beti nungina e ?</para>
  <para style="d">Nkunga Asafi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1"/>Bukiedika ; Nzambi widi wumboti kuidi Iseli ;</para>
  <para style="q1" vid="PSA 73:1">kuidi bobo badi mintima mi vedila.<verse eid="PSA 73:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>Vayi kuidi minu, fioti fisiala nganu malu</para>
  <para style="q1" vid="PSA 73:2">mama masialumuka</para>
  <para style="q1" vid="PSA 73:2">fioti fisiala nganu ndizimbisa singumnu ki kulu kuama.<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>Bila ndizinina batu ba luniemo</para>
  <para style="q1" vid="PSA 73:3">bu ndimona mamboti ma batu bambimbi.<verse eid="PSA 73:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>Kadi mabienga bamonanga ko</para>
  <para style="q1" vid="PSA 73:4">ayi zinitu ziawu zidi mu bivini ayi zibeki ngolo.<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>Bamonanga ko ziphasi ziozi batu boso beti mona ;</para>
  <para style="q1" vid="PSA 73:5">bayamusungu ko mu bimbevo bi mbuanga batu boso.<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>Diawu luniemo luidi sieni mu madinga mawu</para>
  <para style="q1" vid="PSA 73:6">baki vuikidi makhemi.<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>Mu mintima miawu mi matadi, muntotukila mambimbi</para>
  <para style="q1" vid="PSA 73:7">zikhanu zimbimbi zi mayindu mawu zisi zaba zindilu ko.<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>Bamvueza ; banyolukilanga mu bumbimbi ;</para>
  <para style="q1" vid="PSA 73:8">mu lunangu luawu, balembo kubika khuamusu.<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>Miunu miawu milembo nuanina diyilu</para>
  <para style="q1" vid="PSA 73:9">ludimi luawu lueti vua ntoto.<verse eid="PSA 73:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>Diawu batu bawu beti baluka kuidi bawu ;</para>
  <para style="q1" vid="PSA 73:10">beti nuanga nlangu mu buwombo.<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>Beti tubanga : “Buevi Nzambi kela zabila e ?</para>
  <para style="q1" vid="PSA 73:11">Nzambi yizangama beki nzayilu e ?”<verse eid="PSA 73:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>Tala buawu bobo buididi batu bambimbi :</para>
  <para style="q1" vid="PSA 73:12">mu kambu bela kadi diambu dimosi mayindu ko ;</para>
  <para style="q1" vid="PSA 73:12">beti yidikanga kimvuama.<verse eid="PSA 73:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>Bukiedika, mu phamba kuandi ndikebidi ntimꞌama wuvedila</para>
  <para style="q1" vid="PSA 73:13">mu phamba kuandi ndisukudidi mioko miama</para>
  <para style="q1" vid="PSA 73:13">mu monisa kambu kuama ku bila.<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>Mu lumbu kimvimba minu nditutu khuba ;</para>
  <para style="q1" vid="PSA 73:14">nditambula thumbudulu kadika nsuka.<verse eid="PSA 73:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>Enati ndituba : “Ndiela tuba banga bawu”,</para>
  <para style="q1" vid="PSA 73:15">Nganu ndivakula bana baku.<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>Bu nditomba bu sukudila mambu moso mama</para>
  <para style="q1" vid="PSA 73:16">buna diba khuamusu kuidi minu.<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>Nate ndikota mu khati buangu kinlongo</para>
  <para style="q1" vid="PSA 73:17">ki Nzambi,</para>
  <para style="q1" vid="PSA 73:17">buna bosi ndisudika tsukulu awu.<verse eid="PSA 73:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>Bukiedika, ngeyo wukuba tulanga</para>
  <para style="q1" vid="PSA 73:18">mu ntoto widi ndelo ;</para>
  <para style="q1" vid="PSA 73:18">ngeyo weti kuba loza ku mbivusu.<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>Babungini mu kinzimbukila</para>
  <para style="q1" vid="PSA 73:19">batumbulu lalakana mu diambu di tsisi yingolo.<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>Banga ndozi, mutu bu kakotukidi ;</para>
  <para style="q1" vid="PSA 73:20">buawu bobo bu wela kotuka, a Yave,</para>
  <para style="q1" vid="PSA 73:20">wela kuba lenza banga bima bi phamba.<verse eid="PSA 73:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>Mu thangu ntimꞌama wubedi kiaki</para>
  <para style="q1" vid="PSA 73:21">ayi pheve ama yibedi mu kingongo,<verse eid="PSA 73:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22"/>Minu ndiba vungisi ; ndisia ba nzayilu ko ;</para>
  <para style="q1" vid="PSA 73:22">Ndiba bulu kinsitu va ntualꞌaku.<verse eid="PSA 73:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>Muaki ndidi kaka va kimosi ayi ngeyo mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 73:23">wutsimbidila mu koko kuama ku lubakala ;<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>Ngeyo weti kundiatisa mu zindongi ziaku,</para>
  <para style="q1" vid="PSA 73:24">ayi bosi ngeyo wela kuthambula mu nkembo.<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>Nani wunkaka widi yama mu Diyilu</para>
  <para style="q1" vid="PSA 73:25">enati ngeyo ko e ?</para>
  <para style="q1" vid="PSA 73:25">Ntoto kasi kadi kima ko kioki ndieti mona phuila enati ngeyo ko e ?<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>Nsuni ama ayi ntimꞌama bibeki bu vongila</para>
  <para style="q1" vid="PSA 73:26">vayi Nzambi niandi zingolo zi ntimꞌama</para>
  <para style="q1" vid="PSA 73:26">ayi kuku kiama mu zithangu zioso.<verse eid="PSA 73:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>Bobo badi thama ayi ngeyo bela biva</para>
  <para style="q1" vid="PSA 73:27">ngeyo wela bunga batu boso bobo bakambulu</para>
  <para style="q1" vid="PSA 73:27">bakuikama kuidi ngeyo.<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>Vayi kuidi minu, didi diambu di mboti mu fikama Nzambi.</para>
  <para style="q1" vid="PSA 73:28">Ndikitula Yave, mutu wumvanganga makazodidi suamunu kiama.</para>
  <para style="q1" vid="PSA 73:28">Ndiela yolukila mavanga maku moso.<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="cl">Minkunga 74</para>
  <para style="s1">Maniongo mu diambu di buangu kinlongo kitiolomono.</para>
  <para style="d">Nkunga Asafi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1"/>Bila mbi wutulozidi mu zithangu zioso, a Nzambi e ?</para>
  <para style="q1" vid="PSA 74:1">Bila mbi wufuemini minkangu miaku mi mamemi miomi weti dikila e ?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>Tebukila batu baku moyo ;</para>
  <para style="q1" vid="PSA 74:2">bobo wukibakila thama ;</para>
  <para style="q1" vid="PSA 74:2">dikanda di kiuka kiaku, diodi wukula.</para>
  <para style="q1" vid="PSA 74:2">Mongo wu Sioni, koko wuvuanda.<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>Balula zithambi ziaku ku ndambu bibuangu</para>
  <para style="q1" vid="PSA 74:3">bitiolumunu mu mvu ka mvu.</para>
  <para style="q1" vid="PSA 74:3">Zimbivusu zioso ziozi mbeni kavanga mu buangu kinlongo.<verse eid="PSA 74:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>Batu balendidi balembo vomi</para>
  <para style="q1" vid="PSA 74:4">va buangu kioki wutudenginina ;</para>
  <para style="q1" vid="PSA 74:4">batula bidalapo biawu banga dimbu ki ndungunu.<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>Badi banga batu bannanguna</para>
  <para style="q1" vid="PSA 74:5">soka mu zenga minti ku nsitu widi khoba.<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>Bakosikisa mabaya moso momo bamana fikula</para>
  <para style="q1" vid="PSA 74:6">mu bisoka biawu ayi zi malito ziawu.<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>Bazinisa buangu kiaku kinlongo mu mbazu ;</para>
  <para style="q1" vid="PSA 74:7">basumuna buangu kieti vuandanga dizina diaku.<verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>Babedi tubanga mu mintima miawu : “Tuela kuba kosikisa mvimba”</para>
  <para style="q1" vid="PSA 74:8">Bazinisa mu mbazu bibuangu bioso biobi beti buongimina Nzambi mu tsi.<verse eid="PSA 74:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>Bakadi kutumonisa kadi kumu kimosi</para>
  <para style="q1" vid="PSA 74:9">kusiedi mimbikudi ko.</para>
  <para style="q1" vid="PSA 74:9">Kadi mutu wumosi mu beto zebi keni</para>
  <para style="q1" vid="PSA 74:9">nate thangu mbi mama mela tatamana bela e ?<verse eid="PSA 74:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>Nate thangu mbi mbeni kela kusekinina, a Nzambi e ?</para>
  <para style="q1" vid="PSA 74:10">Nate thangu mbi mutu wundendidi kela lenzilanga</para>
  <para style="q1" vid="PSA 74:10">dizina diaku mu zithangu zioso e ?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>Bila mbi kangidi koko kuaku,</para>
  <para style="q1" vid="PSA 74:11">koko kuaku ku lubakala e ?</para>
  <para style="q1" vid="PSA 74:11">Bonga kuawu mu mimfutu mi kukhutu kiaku ayi wuba bungi.<verse eid="PSA 74:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>Vayi ngeyo Nzambi, ngeyo ntinu ama tona muna tona ;</para>
  <para style="q1" vid="PSA 74:12">ngeyo weti nata phulusu va ntoto.<verse eid="PSA 74:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>Keti ngeyo wuvasa mbu mu lulendo luaku ;</para>
  <para style="q1" vid="PSA 74:13">wukosikisa mintu mi bisimbi bi minlangu ;<verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>keti ngeyo wukosikisa mintu mi Leviatani<note caller="+" style="f"><char style="fr" closed="false">74.14 </char><char style="fq" closed="false">Leviatani</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">Simbi ki nlangu kidi tsambuadi di mintu.</char></note>,</para>
  <para style="q1" vid="PSA 74:14">wumvana banga bidia kuidi bibulu bi dikanga<verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>Keti ngeyo wuzibula zitho zi minlangu ayi mimvuila mi minlangu</para>
  <para style="q1" vid="PSA 74:15">Ngeyo wusikisa minlangu minneni</para>
  <para style="q1" vid="PSA 74:15">miomi mieti kumba mu zithangu zioso.<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>Ngeyo vuidi muini, ayi ngeyo vuidi builu ;</para>
  <para style="q1" vid="PSA 74:16">ngeyo wuvanga ngondi ayi thangu.<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>Keti ngeyo wumana vanga zindilu zioso zi ntoto,</para>
  <para style="q1" vid="PSA 74:17">ngeyo wuvanga tsungi yi muini wu ngolo</para>
  <para style="q1" vid="PSA 74:17">ayi yi kiozi kingolo.<verse eid="PSA 74:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>Tebuka moyo buevi mbeni kalembo sekinina, a Yave,</para>
  <para style="q1" vid="PSA 74:18">buevi bivungisi balenzila dizina diaku !<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>Kadi yekula luzingu lu dibembi diaku kuidi bibulu bi nganzi</para>
  <para style="q1" vid="PSA 74:19">ayi kadi thumbu zimbakana luzingu lu batu</para>
  <para style="q1" vid="PSA 74:19">baku badi mu phasi.<verse eid="PSA 74:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>Bengudila Nguizani aku thalu ;</para>
  <para style="q1" vid="PSA 74:20">bila bisuamunu biyindulungu makhemi bifulukidi</para>
  <para style="q1" vid="PSA 74:20">mu bibuangu bitombi bi ntoto.<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>Kadi tala ti mutu wuyamusu</para>
  <para style="q1" vid="PSA 74:21">kavutuka mu tsoni</para>
  <para style="q1" vid="PSA 74:21">Bika nkua kiadi ayi nsukami</para>
  <para style="q1" vid="PSA 74:21">bazitisa dizina diaku.<verse eid="PSA 74:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>Telama a Nzambi ! Wukinungisa !</para>
  <para style="q1" vid="PSA 74:22">Tebukila moyo buevi bivungisi bilembo sekinina</para>
  <para style="q1" vid="PSA 74:22">mu bilumbu bioso.<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>Kadi zimbakana biyoko bi bambeni ziaku</para>
  <para style="q1" vid="PSA 74:23">divunzi di bambeni ziaku, diodi dilembo</para>
  <para style="q1" vid="PSA 74:23">buelamanga thangu ka thangu.<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="cl">Minkunga 75</para>
  <para style="s1">Nzambi wela sambisa ntoto</para>
  <para style="d">Nkunga Asafi kuidi pfumu minyimbidi “Kadi vonda”.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1"/>Tueti kuvutudila matondo, a Nzambi.</para>
  <para style="q1" vid="PSA 75:1">Tueli vutula matondo bila dizina diaku didi difikama</para>
  <para style="q1" vid="PSA 75:1">batu balembo yolukila matsiminanga maku.<verse eid="PSA 75:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>Ngeyo tubidi : “tsobudi thangu yifuana</para>
  <para style="q1" vid="PSA 75:2">Keti minu ndieti sambisa mu bufuana.<verse eid="PSA 75:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>Ntoto bu wulembo nikuka va kimosi ayi batu bandi boso</para>
  <para style="q1" vid="PSA 75:3">Keti minu ndisimbidila makunzi mandi.<verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>Kuidi nkua luniemo, ndintuba : ‘Kadi kukiniemisanga ngolo’</para>
  <para style="q1" vid="PSA 75:4">Kuidi batu bambimbi : ‘lubika vumbula ziphoka zieno.’<verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>Lubika vumuna ziphoka zieno mu diambu di diyilu ;</para>
  <para style="q1" vid="PSA 75:5">bikanu tubila mu nonumuna madinga !”<verse eid="PSA 75:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>Kadi mutu wumosi tona ku Esite voti ku Wesite</para>
  <para style="q1" vid="PSA 75:6">voti tona ku dikanga wulenda yayisa mutu.<verse eid="PSA 75:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>Vayi Nzambi niandi weti sambisa ;</para>
  <para style="q1" vid="PSA 75:7">niandi weti kulula wunkaka, niandi weti yayisa wunkaka.<verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>Mu koko ku Yave muidi mbungu yiwala vinu kingolo</para>
  <para style="q1" vid="PSA 75:8">ayi yisobokoso.</para>
  <para style="q1" vid="PSA 75:8">Wulembo dukula kiawu ayi batu boso bambimbi</para>
  <para style="q1" vid="PSA 75:8">badi va ntoto bela nua kiawu</para>
  <para style="q1" vid="PSA 75:8">nate kuna dibomvi.<verse eid="PSA 75:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>Vayi minu, ndiela samunanga mawu</para>
  <para style="q1" vid="PSA 75:9">mu thangu zioso.</para>
  <para style="q1" vid="PSA 75:9">Ndiela yimbidila nzitusu</para>
  <para style="q1" vid="PSA 75:9">kuidi Nzambi yi Yakobi.<verse eid="PSA 75:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>Ndiela zenga ziphoka zi batu boso bambimbi,</para>
  <para style="q1" vid="PSA 75:10">vayi ziphoka zi batu basonga</para>
  <para style="q1" vid="PSA 75:10">luela nanguku.<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="cl">Minkunga 76</para>
  <para style="s1">Nzambi niandi vuidi ndungunu</para>
  <para style="d">Nkunga Asafi kuidi pfumu minyimbidi kayimbidila mu ngitala.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1"/>Mu Yuda, Nzambi zabikini</para>
  <para style="q1" vid="PSA 76:1">Dizina diandi didi dinneni mu Iseli.<verse eid="PSA 76:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>Nzo andi yi ngoto yidi ku Salemi,</para>
  <para style="q1" vid="PSA 76:2">buangu kiandi kidi ku Sioni.<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>Kuna kakeludila madionga malembo lemi,</para>
  <para style="q1" vid="PSA 76:3">nkaku ayi sabala, mbedi ayi binuanunu bi mvita.<verse eid="PSA 76:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>Ngeyo lembo lezama mu kiezila,</para>
  <para style="q1" vid="PSA 76:4">lutidi kinzuku viokila miongo miwedi bibulu.<verse eid="PSA 76:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>Makhesa mamana ku baziona bima,</para>
  <para style="q1" vid="PSA 76:5">balembo leki tulu tuawu tutsuka,</para>
  <para style="q1" vid="PSA 76:5">kadi wumosi mu binuani lenda tombula mioko miandi.<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>Mu themunuꞌaku, a Nzambi yi Yakobi,</para>
  <para style="q1" vid="PSA 76:6">ziphunda ayi matoma ma mvita<note caller="+" style="f"><char style="fr" closed="false">76.6 </char><char style="fq" closed="false">matoma ma mvita</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">voti matoma ma mvita ma bisengo.</char></note> bibibiodi biledi tulu tuvindu.</para>
  <para style="q1" vid="PSA 76:6">Bileka tulu tuvindu.<verse eid="PSA 76:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>Ngeyo veka, lembo monisa tsisi !</para>
  <para style="q1" vid="PSA 76:7">Nani wulenda telama va meso maku ngeyo fuema e ?<verse eid="PSA 76:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>Tona kuna Diyilu wuwakikisa nzengolo ;</para>
  <para style="q1" vid="PSA 76:8">ntoto wumona tsisi ayi wutumbu dingalala ;<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>Thangu ngeyo, a Nzambi, wutelama mu diambu di sambisa</para>
  <para style="q1" vid="PSA 76:9">ayi mu diambu di vukisa bankwa ziphasi va ntoto.<verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>Bukiedika nganzi aku kuidi batu yinnatini nzitusu ;</para>
  <para style="q1" vid="PSA 76:10">ayi bobo bavukidi mu nganzi aku, badi basimbudulu.<verse eid="PSA 76:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>Tambikanu zikhanu kuidi Yave Nzambi eno</para>
  <para style="q1" vid="PSA 76:11">ayi dedikisanu ziawu !</para>
  <para style="q1" vid="PSA 76:11">Bika baboso badi mu nzunga ki mintoto,</para>
  <para style="q1" vid="PSA 76:11">banata bakaba kuidi mutu wowo widi tsisi.<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>Niandi weti bula phevi minyadi,</para>
  <para style="q1" vid="PSA 76:12">niandi tsisi beta kummona kuidi mintinu mi ntoto.<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="cl">Minkunga 77</para>
  <para style="s1">Nzambi wulenda kuandi baluka e ?</para>
  <para style="d">Nkunga Asafi kuidi Yedutuni, pfumu wu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1"/>Ndiyamikina kuidi Nzambi mu diambu di lusadusu</para>
  <para style="q1" vid="PSA 77:1">ndiyamikina kuidi Nzambi mu kunguila.<verse eid="PSA 77:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>Thangu ndiba mu ziphasi, nditomba Yave ;</para>
  <para style="q1" vid="PSA 77:2">va builu ndinonuna mioko miama</para>
  <para style="q1" vid="PSA 77:2">mu kambu vonga ;</para>
  <para style="q1" vid="PSA 77:2">ayi muelꞌama wumanga bombo.<verse eid="PSA 77:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>Ndietebukila moyo, a Nzambi, ayi ndikunga ;</para>
  <para style="q1" vid="PSA 77:3">ndiyindula mu tsi ntima ayi pheve ama yivonga ngolo.<verse eid="PSA 77:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>Wekeba meso mama ma bika zibama,</para>
  <para style="q1" vid="PSA 77:4">ndiba diaka mu phasi mu tuba.<verse eid="PSA 77:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>Ndiyindula bilumbu bivioka, mimvu mi thama.<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>Ndieti tebukila minkunga miama moyo va builu,</para>
  <para style="q1" vid="PSA 77:6">Ntima ama uyindula ku tsi ntima</para>
  <para style="q1" vid="PSA 77:6">ayi pheve ama yikiyuvula :<verse eid="PSA 77:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7"/>Pfumu wela tumbu loza kuandi mvimba e ?</para>
  <para style="q1" vid="PSA 77:7">Kalendi buela monisa nlemvo andi ko e ?<verse eid="PSA 77:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>Luzolo luandi lungolo lusukidi kuandi mvimba e ?</para>
  <para style="q1" vid="PSA 77:8">Zitsila ziandi mu zithangu zioso</para>
  <para style="q1" vid="PSA 77:8">zikitukidi zi phamba e ?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>Nzambi wuzimbikini kuandi buela monisa nlemvo e ?</para>
  <para style="q1" vid="PSA 77:9">Wuyimini kiadi kiandi mu diambu di nganzi e ?<verse eid="PSA 77:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>Buna ndiyindula “mu diambu diadi ndiela singimina :</para>
  <para style="q1" vid="PSA 77:10">mimvu mi koko ku lubakala ku Nzambi yizangama.”<verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>Ndiela tebukila moyo mavanga ma Yave,</para>
  <para style="q1" vid="PSA 77:11">bukiedika ndiela tebukila moyo</para>
  <para style="q1" vid="PSA 77:11">bikumu biaku bi thama.<verse eid="PSA 77:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>Ndiela yindulanga mu tsi ntima bisalu biaku bioso ;</para>
  <para style="q1" vid="PSA 77:12">ayi ndiela banzilanga mavanga maku moso ma lulendo.<verse eid="PSA 77:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>Zinzila ziaku, a Nzambi, zidi zinlongo ;</para>
  <para style="q1" vid="PSA 77:13">nzambi mbi widi wunneni banga Nzambi eto e ?<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>Ngeyo widi Nzambi yimvanganga bikumu ;</para>
  <para style="q1" vid="PSA 77:14">Ngeyo weti monisa lulendo luaku muidi batu.<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>Mu koko kuaku ku lulendo wukuidila batu baku,</para>
  <para style="q1" vid="PSA 77:15">nkuna wu Yakobi ayi wu Zozefi.<verse eid="PSA 77:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>Minlangu mimmona, ngeyo a Nzambi !</para>
  <para style="q1" vid="PSA 77:16">Minlangu mimona ngeyo, ayi mikotadala</para>
  <para style="q1" vid="PSA 77:16">zitsina zi minlangu zi nikuka.<verse eid="PSA 77:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>Matuti madukula minlangu ;</para>
  <para style="q1" vid="PSA 77:17">diyilu diduma mu nzazi</para>
  <para style="q1" vid="PSA 77:17">madionga maku matotuka ku ntuala ayi ku mbusa.<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>Zinzazi ziaku ziwakana mu kimbongila ;</para>
  <para style="q1" vid="PSA 77:18">zitsiemo zikienzula ntoto ;</para>
  <para style="q1" vid="PSA 77:18">ntoto wunikuka ayi wutita.<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>Nsolo aku wuviokila va khatitsika mbu,</para>
  <para style="q1" vid="PSA 77:19">nzilꞌaku mu minlangu midi nguma,</para>
  <para style="q1" vid="PSA 77:19">muna zithambi ziaku zisia monika ko.<verse eid="PSA 77:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>Wudiatisa batu baku banga nkangu wu mamemi,</para>
  <para style="q1" vid="PSA 77:20">mu koko ku Moyize ayi Aloni.<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="cl">Minkunga 78</para>
  <para style="s1">Mambu mavanga Nzambi</para>
  <para style="d">Nkunga Asafi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1"/>A batu bama, wanu malongi mama !</para>
  <para style="q1" vid="PSA 78:1">Dimbanu mambu ma munu ama.<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>Ndiela zibula munu ama mu tuba zingana</para>
  <para style="q1" vid="PSA 78:2">ayi ndiela samuna mambu ma suama, mambu makhulu ;<verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>momo tuwa ayi momo tuzaba</para>
  <para style="q1" vid="PSA 78:3">ayi momo bakulu beto batukamba ;<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>Tulendi masuekila ko bana bawu ;</para>
  <para style="q1" vid="PSA 78:4">tuela samuna kuidi tsungi yinkuiza</para>
  <para style="q1" vid="PSA 78:4">mavanga ma Yave mafueti zitusu,</para>
  <para style="q1" vid="PSA 78:4">lulendo luandi ayi matsiminanga momo kavanga.<verse eid="PSA 78:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>Wuvana zithumunu mu diambu di Yakobi.</para>
  <para style="q1" vid="PSA 78:5">Wukubika Mina mu Iseli,</para>
  <para style="q1" vid="PSA 78:5">ayi wutumina bakulu beto</para>
  <para style="q1" vid="PSA 78:5">muingi bamilonga kuidi bana bawu ;<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>buna tsungi yinkuiza, yela zaba mawu</para>
  <para style="q1" vid="PSA 78:6">buela bana bobo babutuki ko</para>
  <para style="q1" vid="PSA 78:6">ayi bawu mamvawu mu thangu awu</para>
  <para style="q1" vid="PSA 78:6">bela yolukila bana bawu ;<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>buna bela tula diana diawu mu Nzambi,</para>
  <para style="q1" vid="PSA 78:7">ayi balendi zimbakana mavanga mandi ko,</para>
  <para style="q1" vid="PSA 78:7">vayi bela keba zithumunu ziandi ;<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>Balendi ba banga bakulu bawu ko ;</para>
  <para style="q1" vid="PSA 78:8">tsungi yikambulu bulemvo, ayi tsungi yi matingu ;</para>
  <para style="q1" vid="PSA 78:8">bobo mintima misia ba mifuana ko kuidi Nzambi</para>
  <para style="q1" vid="PSA 78:8">bobo pheve yisia yikuikama kuidi Nzambi ko.<verse eid="PSA 78:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>Batu ba Efalayimi bobo baba ayi mimbasa,</para>
  <para style="q1" vid="PSA 78:9">bavutuka ku mbusa mu lumbu ki mvita.<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>Basi keba ko Nguizani yi Nzambi,</para>
  <para style="q1" vid="PSA 78:10">ayi bamanga zingila boso buididi Mina miandi.<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>Bazimbakana momo kavanga ;</para>
  <para style="q1" vid="PSA 78:11">matsiminanga momo kabamonisa.<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>Wuvanga bikumu va ntuala bakulu bawu</para>
  <para style="q1" vid="PSA 78:12">mu tsi yi Ezipite ; mu zunga ki Tsowani.<verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>Wuvasa mbu ayi wuba viokila muawu ;</para>
  <para style="q1" vid="PSA 78:13">wutelimisa nlangu dio ngui banga baka.<verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>Wuba diatisa mu dituti va muini,</para>
  <para style="q1" vid="PSA 78:14">ayi mu kiezila ki mbazu va builu bu mvimba.<verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>Wubasa matadi mu dikanga,</para>
  <para style="q1" vid="PSA 78:15">ayi wuba vana nlangu wuwombo banga mbu ;<verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>Wutotula mimvuila minlangu mu ditadi</para>
  <para style="q1" vid="PSA 78:16">ayi wukumbisa minlangu banga minlangu minneni.<verse eid="PSA 78:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>Vayi babuela tatamana sumuka diaka va ntualꞌandi ;</para>
  <para style="q1" vid="PSA 78:17">batinguna Nzambi Yizangama mu dikanga.<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>Batota Nzambi mu luzolo lungolo,</para>
  <para style="q1" vid="PSA 78:18">mu lombanga mu kingolo bidia biobi batomba.<verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>Batubidila Nzambi batuba :</para>
  <para style="q1" vid="PSA 78:19">“Nzambi beki kuandi bu kubikila meza mu dikanga e ?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>Bu kabula ditadi dingolo, mbadi nlangu wutotuka</para>
  <para style="q1" vid="PSA 78:20">ayi mimvuila mikumba mu buwombo</para>
  <para style="q1" vid="PSA 78:20">vayi buna wulendi kuandi kutuvana bidia e ?</para>
  <para style="q1" vid="PSA 78:20">Wulendi kuandi kubika zimbizi mu diambu di batu bandi e ?”<verse eid="PSA 78:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>Yave bu kaba wa, wufuema ngolo,</para>
  <para style="q1" vid="PSA 78:21">mbazu andi yilema mu diambu di Yakobi</para>
  <para style="q1" vid="PSA 78:21">ayi miangu miandi mibuila Iseli.<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>Bila basia wilukila Nzambi ko,</para>
  <para style="q1" vid="PSA 78:22">voti basia tula diana diawu mu khudulu andi ko.<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>Muaki wuvana lutumunu kuidi matuti ma yilu</para>
  <para style="q1" vid="PSA 78:23">ayi wuzibula mielo mi diyilu ;<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>Wunokisa mana mu diambu di batu muingi badia ;</para>
  <para style="q1" vid="PSA 78:24">wuba vana zitheti zi diyilu.<verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>Batu badia dipha di zimbasi ;</para>
  <para style="q1" vid="PSA 78:25">wuba fidisila bidia bioso biobi balenda dia.<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>Wuvevumuna phemo yi Esite mu diyilu.</para>
  <para style="q1" vid="PSA 78:26">Wudiata ku ntuala phemo yi Sude mu lulendo luandi.<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>Wuba nokisila zimbizi banga mbungi-mbungi ;</para>
  <para style="q1" vid="PSA 78:27">zinuni zieti dumuka banga nzielo yi mbu.<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>Wuba buisila biawu va khatitsika ka kiawu ;</para>
  <para style="q1" vid="PSA 78:28">muyenda zinzo ziawu zioso zingoto.<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>Badia nate bayukuta kuwombo ;</para>
  <para style="q1" vid="PSA 78:29">ayi wuba vana biobi baleba mu kingolo.<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>Tuamina batamba bidia biobi baleba mu kingolo mbusa,</para>
  <para style="q1" vid="PSA 78:30">buela bikidi mu miunu miawu.<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>Nganzi yi Nzambi yi babuila ;</para>
  <para style="q1" vid="PSA 78:31">wuvonda bobo baluta ba zinitu zingolo mu bawu ;</para>
  <para style="q1" vid="PSA 78:31">wuvonda bana ba matoko ma Iseli.<verse eid="PSA 78:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>Ka diambu ko mambu moso momo, batatamana vola masumu</para>
  <para style="q1" vid="PSA 78:32">ka diambu ko matsiminanga mandi, basia wilukila ko.<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>Buna wumanisa bilumbu biawu mu phamba</para>
  <para style="q1" vid="PSA 78:33">ayi mimvu miawu mu tsisi.<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>Kadika khumbu kaba kuba vondanga, tombanga baba kuntombanga,</para>
  <para style="q1" vid="PSA 78:34">balukanga nsualu-nsualu diaka kuidi niandi.<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>Batebuka moyo ti Nzambi niandi wuba dibanga diawu</para>
  <para style="q1" vid="PSA 78:35">ayi Nzambi Yizangama niandi nkudi awu.<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>Vayi buna bankamba mambu ma lueki mu miunu miawu</para>
  <para style="q1" vid="PSA 78:36">bamvuna mu ludimi luawu.<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>Mintima miawu misia ba mifuana kuidi niandi ko</para>
  <para style="q1" vid="PSA 78:37">basia ba bakuikama ko mu Nguizani andi.<verse eid="PSA 78:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>Vayi niandi wuba nkua kiadi</para>
  <para style="q1" vid="PSA 78:38">wuba lemvukila mambimbi mawu</para>
  <para style="q1" vid="PSA 78:38">kasia babunga ko</para>
  <para style="q1" vid="PSA 78:38">thangu ka thangu wudekula nganzi andi</para>
  <para style="q1" vid="PSA 78:38">ayi kasia totula ko miangu miandi mioso.<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>Wutebuka moyo ti baba minsuni kaka ;</para>
  <para style="q1" vid="PSA 78:39">phemo yeti vioka yoyi yilendi vutuka ko.</para>
  <para style="q1" vid="PSA 78:39">Ayi wulendi buela vutuka ko.<verse eid="PSA 78:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>Zikhumbu ziwombo bantingunina mu dikanga,</para>
  <para style="q1" vid="PSA 78:40">ayi bansoka mu bibuangu bikambulu batu.<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>Khumbu ka khumbu baba vutukilanga diaka tota Nzambi ;</para>
  <para style="q1" vid="PSA 78:41">bafuemisa mutu wunlongo wu Iseli kiadi.<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>Basia tebukila ko moyo lulendo luandi</para>
  <para style="q1" vid="PSA 78:42">mu lumbu kioki kaba kula mu mioko</para>
  <para style="q1" vid="PSA 78:42">mi mutu wuba yamisa ;<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>mu lumbu kamonisa bidimbu bi bikumu biandi mu Ezipite,</para>
  <para style="q1" vid="PSA 78:43">mambu mandi matsiminanga mu ndambu tsi yi Tsowani<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>wukitula minlangu miawu menga ;</para>
  <para style="q1" vid="PSA 78:44">basia buela baka bumina mu mimvuila mi minlangu miawu.<verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>Wufidisa nkangu zinzinzi ziozi zibadia</para>
  <para style="q1" vid="PSA 78:45">ayi zinguanga ziozi zi babunga.<verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>Wavana mimbutu miawu mu zitsola kuidi binzienzi</para>
  <para style="q1" vid="PSA 78:46">biobi basala kuidi makhoko.<verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>Wumana bunga zindima ziawu zi vinu</para>
  <para style="q1" vid="PSA 78:47">mu mvula yi matadi</para>
  <para style="q1" vid="PSA 78:47">ayi minti miawu mi sikomole mu kiozi ki ngolo,<verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>wuyekula bibulu biawu kuidi mvula yi matadi</para>
  <para style="q1" vid="PSA 78:48">ayi minkangu mi mamemi mawu kuidi lusiemo.<verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>Wuba fidisila nganzi andi yi mbazu, miangu miandi mi ngolo</para>
  <para style="q1" vid="PSA 78:49">khakumusu, kimbeni weti bunga<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>Wukubika nsolo mu diambu di nganzi andi</para>
  <para style="q1" vid="PSA 78:50">kasia kuba tanina ko mu lufua ;</para>
  <para style="q1" vid="PSA 78:50">vayi wuba yekula mu minsongo ;<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>Wuvonda bana boso batheti bababakala ba Ezipiti</para>
  <para style="q1" vid="PSA 78:51">mimbutu mitheti mi zingolo mu zinzo zi ngoto zi Hami.<verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>Vayi wutotula batu bandi banga mamemi ;</para>
  <para style="q1" vid="PSA 78:52">wuba tuadisa banga nkangu wu bibulu mu dikanga.<verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>Wuba diatisila mu luvovomo ;</para>
  <para style="q1" vid="PSA 78:53">diawu basia mona tsisi ko</para>
  <para style="q1" vid="PSA 78:53">ayi mbu wumina bambeni ziawu.<verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>Buna wuba kotisa mu yenda tsi andi yinlongo ;</para>
  <para style="q1" vid="PSA 78:54">ku tsi yi mongo wowo koko kuandi ku lubakala kukibakila.<verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>Wukuka makanda ku ntualꞌawu ;</para>
  <para style="q1" vid="PSA 78:55">ayi wuba kabudila mintoto miawu banga kiuka</para>
  <para style="q1" vid="PSA 78:55">wuvuandisa makanda ma Iseli mu zinzo ziawu.<verse eid="PSA 78:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>Vayi batota Nzambi ayi batinguna Nzambi Yizangama ;</para>
  <para style="q1" vid="PSA 78:56">basia keba zinzengolo ziandi ko.<verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>Banga madisa mawu</para>
  <para style="q1" vid="PSA 78:57">basia ba bafuana ko ayi basia ba minu ko</para>
  <para style="q1" vid="PSA 78:57">balendi tudulu diana ko banga wuvenga.<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>Bamfuemisa mu bibuangu biawu bizangama</para>
  <para style="q1" vid="PSA 78:58">balemisa kiphala kiandi mu bitumba biawu<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>Nzambi bu kawa, buna wufuema ngolo</para>
  <para style="q1" vid="PSA 78:59">wutumbu loza mvimba Iseli.<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>Wuyekula, nzo ngoto mbuabununu yi Silo ;</para>
  <para style="q1" vid="PSA 78:60">nzo yoyo mu kakivuandisa ;<verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>Wufidisa kesi yi lulendo luandi mu buvika,</para>
  <para style="q1" vid="PSA 78:61">ayi kiezila kiandi mu mioko mi mbeni.<verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>Wuyekula batu bandi mu sabala,</para>
  <para style="q1" vid="PSA 78:62">wufuemina ngolo kiuka kiandi.<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>Mbazu yi zinisa bamatoko mawu,</para>
  <para style="q1" vid="PSA 78:63">ayi bandumba ziawu ziozi</para>
  <para style="q1" vid="PSA 78:63">zisia zaba babakala ko zisia baka ko minkunga</para>
  <para style="q1" vid="PSA 78:63">mi makuela ko.<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>Zinganga ziawu zinzambi zimana fuila mu sabala</para>
  <para style="q1" vid="PSA 78:64">ayi mafuola mawu masia baka bu didila ko.<verse eid="PSA 78:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>Buna Yave wukotuka banga mutu wuba wuleka,</para>
  <para style="q1" vid="PSA 78:65">banga mutu kotukidi mu diambu di vinu kakololo.<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>Wuvutula bambeni bandi ku manima ;</para>
  <para style="q1" vid="PSA 78:66">wuzifuisa zitsoni ka zisukanga ko.<verse eid="PSA 78:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>Buna wuloza zinzo zi ngoto zi Zozefi,</para>
  <para style="q1" vid="PSA 78:67">kasia sobula ko dikanda di Efalayimi ;<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>Vayi wusobula dikanda di Yuda,</para>
  <para style="q1" vid="PSA 78:68">mongo wu Sioni, wowo kazola.<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>Wutunga buangu kiandi kinlongo banga bibuangu bizangama,</para>
  <para style="q1" vid="PSA 78:69">banga ntoto wowo kakubika mu zithangu zioso zi kazimani.<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>Wusobula Davidi kisadi kiandi</para>
  <para style="q1" vid="PSA 78:70">ayi wumbonga mu ziphangu zi mamemi,<verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>Wumbongila vana vaba mamemi momo kaba sunga</para>
  <para style="q1" vid="PSA 78:71">mu diambu di kaba nsungi wu batu bandi Yakobi,</para>
  <para style="q1" vid="PSA 78:71">wu Iseli kiuka kiandi.<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>Buna Davidi wuba nsungi awu</para>
  <para style="q1" vid="PSA 78:72">mu ntima wufuana ayi wuba diatisila</para>
  <para style="q1" vid="PSA 78:72">mu koko ku diela.<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="cl">Minkunga 79</para>
  <para style="s1">Yelusalemi ditiolumukini</para>
  <para style="d">Nkunga Asafi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1"/>A Nzambi ! Makanda mabulumukini kuika kiaku,</para>
  <para style="q1" vid="PSA 79:1">Masumuna nzoꞌaku yinlongo,</para>
  <para style="q1" vid="PSA 79:1">makitula Yelusalemi kunza ki matadi.<verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>Bavana zinitu zifua zi bisadi biaku</para>
  <para style="q1" vid="PSA 79:2">banga bidia kuidi zinuni zi diyilu</para>
  <para style="q1" vid="PSA 79:2">minsuni mi banlongo baku</para>
  <para style="q1" vid="PSA 79:2">kuidi bibulu bi ntoto ;<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>Batengudi menga banga nlangu</para>
  <para style="q1" vid="PSA 79:3">mu yendila Yelusalemi ayi kusia monika ko</para>
  <para style="q1" vid="PSA 79:3">mutu mu zika.<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>Tuyikidi bila ki lusembo kuidi bafikimini yeto ;</para>
  <para style="q1" vid="PSA 79:4">mvuezolo ayi kisekonono</para>
  <para style="q1" vid="PSA 79:4">kuidi bobo batuzungididi.<verse eid="PSA 79:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>Nate thangu mbi, a Yave ? Wela fueminanga mu zithangu zioso e ?</para>
  <para style="q1" vid="PSA 79:5">Nate thangu mbi kiphala kiaku kiela</para>
  <para style="q1" vid="PSA 79:5">leminanga banga mbazu e ?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>Dukula miangu miaku kuidi makanda momo masia kuzaba ko,</para>
  <para style="q1" vid="PSA 79:6">kuidi bipfumu biobi kabi telanga ko dizina diaku.<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>Bila bameni dia Yakobi,</para>
  <para style="q1" vid="PSA 79:7">ayi bamana tiolumuna tsi andi yikabutukila.<verse eid="PSA 79:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>Kadi kututangila masumu ma bakulu !</para>
  <para style="q1" vid="PSA 79:8">Bika kiadi kiaku kiza nsualu kuidi beto</para>
  <para style="q1" vid="PSA 79:8">bila tueka mu mabienga makambulu diana.<verse eid="PSA 79:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>Wutusadila, a Nzambi Mvulusi eto</para>
  <para style="q1" vid="PSA 79:9">mu diambu di nkembo wu dizina diaku !</para>
  <para style="q1" vid="PSA 79:9">Wutukuidi ayi wutulemvukila masumu meto</para>
  <para style="q1" vid="PSA 79:9">mu diambu di dizina diaku !<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>Bila mbi makanda meti tubila :</para>
  <para style="q1" vid="PSA 79:10">“Kuevi kuidi Nzambi e ?”</para>
  <para style="q1" vid="PSA 79:10">va ntuala meso meto, zabikisa va khatitsika makanda</para>
  <para style="q1" vid="PSA 79:10">ti ngeyo weti vutula landi mu menga matenguka ma bisadi biaku,<verse eid="PSA 79:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>Bika kunga ku batu badi mu nloko kutula va ntualꞌaku.</para>
  <para style="q1" vid="PSA 79:11">Mu zingolo zi koko kuaku,</para>
  <para style="q1" vid="PSA 79:11">tanina bobo bazengolo nkanu wu lufua.<verse eid="PSA 79:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>Vutudila mu zikhumbu tsambuadi bifingu bi bobo batufikimini ;</para>
  <para style="q1" vid="PSA 79:12">tsembolo yoyi bawobudila ngeyo Yave.<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>Buna beto batu baku, nkangu aku wu mamemi weti dikila ;</para>
  <para style="q1" vid="PSA 79:13">tuela kuzitisa mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 79:13">mu tsungi ka tsungi, tuela yolukila minzitusu miaku.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="cl">Minkunga 80</para>
  <para style="s1">A Pfumu, nate thangu mbi e ?</para>
  <para style="d">Nkunga Asafi kuidi pfumu minyimbidi ; kayimbidila mu “Lisi”.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1"/>Bika wutuwila, a Nsungi Iseli,</para>
  <para style="q1" vid="PSA 80:1">ngeyo wundiatisanga Zozefi banga nkangu wu mamemi ;</para>
  <para style="q1" vid="PSA 80:1">Ngeyo wumvuandanga va khatitsika ba Bakeluba, kienzula kuaku.<verse eid="PSA 80:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2"/>Va ntuala Efalayimi, Benzami ayi Manase !</para>
  <para style="q1" vid="PSA 80:2">Telimisa zingolo ziaku yiza ayi wutuvukisa.<verse eid="PSA 80:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3"/>Wutuvutula banga bututuama bela, a Nzambi</para>
  <para style="q1" vid="PSA 80:3">bika zizi kiaku kitukienzula muingi tuvuka.<verse eid="PSA 80:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>Yave, Nzambi nkua ngolo yoso,</para>
  <para style="q1" vid="PSA 80:4">nate thangu mbi nganzi aku yela leminanga ?</para>
  <para style="q1" vid="PSA 80:4">Mu diambu di zitsambulu zi batu baku e ?<verse eid="PSA 80:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>Ngeyo wuba dikila mu dipha di matsuela</para>
  <para style="q1" vid="PSA 80:5">ayi ngeyo wuba nuikina matsuela mu mbungu yiwala.<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>Wutukitula tho yi minzonza</para>
  <para style="q1" vid="PSA 80:6">kuidi bobo bafikimini yeto</para>
  <para style="q1" vid="PSA 80:6">ayi bambeni zieto zilembo kutusekinina.<verse eid="PSA 80:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>Wutuvutula banga bututuama bela, a Nzambi nkua ngolo yoso</para>
  <para style="q1" vid="PSA 80:7">Bika zizi kiaku kitukienzula muingi tuvuka.<verse eid="PSA 80:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>Ngeyo wutumuna nti wu vinu ku Ezipite,</para>
  <para style="q1" vid="PSA 80:8">wukuka makanda ma Bapakanu bosi wukuna wawu.<verse eid="PSA 80:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>Ngeyo wukubikila wawu ntoto</para>
  <para style="q1" vid="PSA 80:9">ayi wawu wumenisa mianzi ayi wudukila tsi.<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>Miongo mifuku kuidi phonzi andi,</para>
  <para style="q1" vid="PSA 80:10">sedeli mi lulendo kuidi matafi mandi.<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>Wufidisa mawu nate ku mbu</para>
  <para style="q1" vid="PSA 80:11">ayi mintuidila miandi nate ku minlangu minneni.<verse eid="PSA 80:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>Bila mbi wutiolumunini bibaka biandi e ?</para>
  <para style="q1" vid="PSA 80:12">Muingi batu boso bamviokila vana bavela makundi mandi.<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>Ngulu yi nsitu yeti kuyikesikisa ;</para>
  <para style="q1" vid="PSA 80:13">ayi bivangu bi zitsola bilembo dia biawu.<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>Wutuvutukila, a Nzambi nkua ngolo yoso</para>
  <para style="q1" vid="PSA 80:14">ayi ku tsi tona ku diyilu ayi mona</para>
  <para style="q1" vid="PSA 80:14">keba nti wawu wu vinu ;<verse eid="PSA 80:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15"/>Muanzi wowo koko kuaku ku lubakala ku kuna,</para>
  <para style="q1" vid="PSA 80:15">Muana wu bakala wowo wuyundula mu diambu diaku veka.<verse eid="PSA 80:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16"/>Nti aku wu vinu wuzengulu, wuyokolo ku mbazu</para>
  <para style="q1" vid="PSA 80:16">mu tsembolo aku, batu baku balembo bivi.<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>Bika koko kuaku kuba vadi mutu wowo widi koko kuaku ku lubakala</para>
  <para style="q1" vid="PSA 80:17">muana wubakala wu mutu wowo wuyundula mu diambu diaku veka.<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>Buna tulendi buela kutatukila ko.</para>
  <para style="q1" vid="PSA 80:18">Wutuzingisa diaka</para>
  <para style="q1" vid="PSA 80:18">buna tuela tela dizina diaku.<verse eid="PSA 80:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>Wutuvutula banga bu tutuama bela, a Yave Nzambi.</para>
  <para style="q1" vid="PSA 80:19">Bika zizi kiaku kitukienzula muingi tuvuka.<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="cl">Minkunga 81</para>
  <para style="s1">Enati batu bama banguila</para>
  <para style="d">Nkunga Asafi kuidi pfumu minyimbidi ; kayimbidila mu ngitala yi basi Ngati.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1"/>Yimbidilanu Nzambi mu khini ;</para>
  <para style="q1" vid="PSA 81:1">niandi zingolo zieto !</para>
  <para style="q1" vid="PSA 81:1">Yamikinanu kuidi Nzambi yi Yakobi !<verse eid="PSA 81:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>Tonanu miziki, sikanu zindungu ;</para>
  <para style="q1" vid="PSA 81:2">Bulanu minningu mu Ngitala ayi lu Lila.<verse eid="PSA 81:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>Sikanu phoka yi dimemi va ntotukila ngondi yi mona ;</para>
  <para style="q1" vid="PSA 81:3">ayi Ngondi bu yidi yiduka ayi mu lumbu ki nyengo eto !<verse eid="PSA 81:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>Yayi yidi nzengolo mu diambu di Iseli,</para>
  <para style="q1" vid="PSA 81:4">ayi tsikudukusu yi Nzambi yi Yakobi,<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>Wukindisa yawu banga nsiku mu diambu di Zozefi</para>
  <para style="q1" vid="PSA 81:5">mu thangu kanuanisa tsi yi Ezipite…</para>
  <para style="q1" vid="PSA 81:5">Kuna tuwa mbembo yoyi tusia sudika ko.<verse eid="PSA 81:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>Tubidi : “Ndibotudi mfuna wubedi va mavangiti mawu.</para>
  <para style="q1" vid="PSA 81:6">Ayi babotudi pani kibedi mu mioko miandi.<verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>Mu ziphasi ziaku, ngeyo wutela ayi ndikula</para>
  <para style="q1" vid="PSA 81:7">ndivana mvutu ku tsi dumu ki matuti</para>
  <para style="q1" vid="PSA 81:7">nditota ku minlangu mi Meliba.<verse eid="PSA 81:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>Wanu beno batu bama, ayi ndiela kululubula :</para>
  <para style="q1" vid="PSA 81:8">enati beno luzola ku ndimba, a Iseli.<verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>Kulendi ba kadi nzambi yi nzenza ko va khatitsikꞌaku.</para>
  <para style="q1" vid="PSA 81:9">Kulendi buongimina nzambi yi nzenza ko !<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>Minu ndidi Yave, Nzambi,</para>
  <para style="q1" vid="PSA 81:10">yoyi yilutotula mu tsi Ezipite ;</para>
  <para style="q1" vid="PSA 81:10">zibula bumboti munu aku ayi ndiela ku wuwesa.<verse eid="PSA 81:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>Vayi batu bama basia zola ku ndimba ko ;</para>
  <para style="q1" vid="PSA 81:11">Iseli kasia kuthumukina ko.<verse eid="PSA 81:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>Buna ndiba yekula mu mintima miawu mingolo ;</para>
  <para style="q1" vid="PSA 81:12">mu landakana zikhanu ziawu veka.<verse eid="PSA 81:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>Enati batu bama bandima kuama,</para>
  <para style="q1" vid="PSA 81:13">enati Iseli wuzola landakana zinzila ziama !<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>Nganu mu nsualu ndieka tumbu kuba yekudila bambeni ziawu</para>
  <para style="q1" vid="PSA 81:14">ayi balula koko kuama kuidi bobo beti kuba lenda.<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>Bobo beti lenda Yave balenda</para>
  <para style="q1" vid="PSA 81:15">kukikulula va ntualꞌandi ayi nganu thumbudulu awu yela</para>
  <para style="q1" vid="PSA 81:15">zingilanga mu zithangu zioso ;<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>Vayi nganu ngeyo wudikulu mu ble yilutidi kitoko,</para>
  <para style="q1" vid="PSA 81:16">mu niosi yintotukila mu ditadi, ndiela kuyukutisila.”<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="cl">Minkunga 82</para>
  <para style="s1">Nzambi wulembo sambisa bapfumu ba makanda.</para>
  <para style="d">Nkunga Asafi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1"/>Nzambi telimini va lukutukunu lunneni.</para>
  <para style="q1" vid="PSA 82:1">Wulembo vani nzengolo va khatitsika “zinzambi”.<verse eid="PSA 82:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>Nate thangu mbi luela nuaninanga mutu kambulu wusonga</para>
  <para style="q1" vid="PSA 82:2">ayi luela monisinanga thalu yi zizi</para>
  <para style="q1" vid="PSA 82:2">kuidi batu bambimbi e ?<verse eid="PSA 82:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>Nuanina mutu wulebakana ayi muana wusana.</para>
  <para style="q1" vid="PSA 82:3">Luvanga malulama kuidi nsukami ayi kuidi mutu weti yamusu.<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>Kulanu mutu wulebakana ayi nsukami ;</para>
  <para style="q1" vid="PSA 82:4">bika luba vukisa mu mioko mi batu bambimbi.<verse eid="PSA 82:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>Basi zaba kadi diambu ko ayi basudikanga kadi diambu ko ;</para>
  <para style="q1" vid="PSA 82:5">Mu tombi beti diatila ;</para>
  <para style="q1" vid="PSA 82:5">zifundasio zioso zi ntoto zilembo nikuka.<verse eid="PSA 82:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>Minu ndituba :</para>
  <para style="q1" vid="PSA 82:6">“luidi zinzambi ayi beno boso luidi</para>
  <para style="q1" vid="PSA 82:6">bana ba Nzambi yizangama.”<verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>Vayi luela fua banga batu boso,</para>
  <para style="q1" vid="PSA 82:7">luela bua banga woso kuandi nyadi.<verse eid="PSA 82:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>Telama, a Nzambi, sambisa ntoto !</para>
  <para style="q1" vid="PSA 82:8">Bila makanda moso madi kiuka kiaku.<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="cl">Minkunga 83</para>
  <para style="s1">Kadi tala ti bambeni ziaku zinunga</para>
  <para style="d">Nkunga Asafi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1"/>A Nzambi, kadi ba dio sui !</para>
  <para style="q1" vid="PSA 83:1">Kadi kanga munu, a Nzambi ayi kadi dingalala !<verse eid="PSA 83:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>Tala, phila bambeni ziaku zilembo tudila divunzi ;</para>
  <para style="q1" vid="PSA 83:2">bobo beti kulenda balembo vumuna mintu miawu.<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>Mu diela dimbimbi, balembo yendila batu baku manenga ;</para>
  <para style="q1" vid="PSA 83:3">balembo fiedi batu baku</para>
  <para style="q1" vid="PSA 83:3">bobo weti belanga mayindu.<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>Batuba : “yizanu, bika tuba bunga banga dikanda,</para>
  <para style="q1" vid="PSA 83:4">mu diambu di dizina di Iseli dibika buela</para>
  <para style="q1" vid="PSA 83:4">tebukulungu moyo”.<verse eid="PSA 83:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>Mu mabanza mamosi, bakutakana mu fiela,</para>
  <para style="q1" vid="PSA 83:5">bavangi nguizani mu diambu di kunuanisa ;<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>Zinzo zi ngoto zi Edoni ayi zi basi Isimayeli,</para>
  <para style="q1" vid="PSA 83:6">zi Mowabi ayi zi basi Hangali,<verse eid="PSA 83:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7"/>Nguebali ; Amoni, Amaleki</para>
  <para style="q1" vid="PSA 83:7">basi Filisitini va kimosi ayi basi Tila ;<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>ka diambu ko Asili mamvawu bafubakana yawu,</para>
  <para style="q1" vid="PSA 83:8">mu buela zingolo kuidi nkuna wu Loti.<verse eid="PSA 83:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>Wuba vangila banga bu wuvangila Madiani,</para>
  <para style="q1" vid="PSA 83:9">banga bu wuvangila Sisela, ayi Yabini ku nlangu wu Kisoni ;<verse eid="PSA 83:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>bobo babiva ku Andoli ;</para>
  <para style="q1" vid="PSA 83:10">bobo bakituka banga mbozi va ntoto.<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>Kituka batu bawu banneni</para>
  <para style="q1" vid="PSA 83:11">banga Olebi ayi Zeyebi,</para>
  <para style="q1" vid="PSA 83:11">bana bawu boso ba mintinu banga Zeba ayi Tsalumuna,<verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>Bobo batuba :</para>
  <para style="q1" vid="PSA 83:12">“bika tuziona mintoto mi Nzambi mindikulungu bibulu !”<verse eid="PSA 83:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>Wuba kitula banga kinzungidila ; A Nzambi ama,</para>
  <para style="q1" vid="PSA 83:13">banga biti va ntuala phemo ;<verse eid="PSA 83:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>banga mbazu yinzinisanga nsitu ;</para>
  <para style="q1" vid="PSA 83:14">banga nlaki wu mbazu wunyoka miongo !<verse eid="PSA 83:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15"/>Buna wuba kukila mu vuka kiaku ki phemo ;</para>
  <para style="q1" vid="PSA 83:15">wuba monisa tsisi mu vuka kiaku ki ngolo.<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>Fuka bizizi biawu mu tsoni.</para>
  <para style="q1" vid="PSA 83:16">Muingi batu batomba dizina diaku, a Yave !<verse eid="PSA 83:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>Bika bafua tsoni ayi bamona tsisi mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 83:17">bika babiva mu kambu nzitusu.<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>Bika wuba zabikisa ti ngeyo vuidi dizina di Yave ;</para>
  <para style="q1" vid="PSA 83:18">ti ngeyo kaka Nzambi yizangama</para>
  <para style="q1" vid="PSA 83:18">va ntoto wumvimba.<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="cl">Minkunga 84</para>
  <para style="s1">Phuila yi nzo aku ndidi</para>
  <para style="d">Nkunga wu bana ba Kole kuidi pfumu minyimbidi ; bayimbidila mu ngitale yi basi Ngati.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1"/>A phila lueki luidi mu buangu kiaku kioki weti vuanda !</para>
  <para style="q1" vid="PSA 84:1">A Nzambi, nkua ngolo yoso.<verse eid="PSA 84:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>Muelꞌama phuila widi ayi wulembo suki-suki</para>
  <para style="q1" vid="PSA 84:2">mu diambu di luphangu lu Yave.</para>
  <para style="q1" vid="PSA 84:2">Ntimꞌama ayi nsuni ama bilembo yamikina</para>
  <para style="q1" vid="PSA 84:2">mu diambu di Nzambi yi moyo.<verse eid="PSA 84:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>Ka diambu ko dikuanga beki nzoꞌandi,</para>
  <para style="q1" vid="PSA 84:3">ayi tsiodila mamvandi beki dianza diandi</para>
  <para style="q1" vid="PSA 84:3">koko keti lundila bana bandi…</para>
  <para style="q1" vid="PSA 84:3">buangu kifikimini ntalꞌaku</para>
  <para style="q1" vid="PSA 84:3">A Yave nkua ngolo yoso, Ntinu ama ayi Nzambi ama !<verse eid="PSA 84:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>Lusakumunu kuidi bobo beti vuanda mu Nzo aku !</para>
  <para style="q1" vid="PSA 84:4">Beti kuzitisa mu zithangu zioso.<verse eid="PSA 84:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>Lusakumunu kuidi batu bobo zingolo ziawu zidi mu ngeyo ;</para>
  <para style="q1" vid="PSA 84:5">bobo bakubika mintima</para>
  <para style="q1" vid="PSA 84:5">miawu mu kuenda sambila ku Yelusalemi.<verse eid="PSA 84:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>Bu bamviokanga mu ndimba wu Baka,</para>
  <para style="q1" vid="PSA 84:6">buna beti kuwukitula buangu ki zitho zi minlangu ;</para>
  <para style="q1" vid="PSA 84:6">mvula mamvandi wufukidila wawu mu bibuindi.<verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>Zingolo ziawu zieti buelama</para>
  <para style="q1" vid="PSA 84:7">nate kadika mutu kammonika</para>
  <para style="q1" vid="PSA 84:7">va ntuala Nzambi yi sioni.<verse eid="PSA 84:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>Wa lusambulu luama, a Yave, Nzambi nkua ngolo yoso,</para>
  <para style="q1" vid="PSA 84:8">wundimba Nzambi yi Yakobi.<verse eid="PSA 84:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>Tala nkaku eto, a Nzambi</para>
  <para style="q1" vid="PSA 84:9">Tadila mu nlemvo mutu aku wuvinda mafuta.<verse eid="PSA 84:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>Lumbu kimosi mu luphangu luaku</para>
  <para style="q1" vid="PSA 84:10">kiviokidi mili di bilumbu kunkaka.</para>
  <para style="q1" vid="PSA 84:10">Thidi kuama ba nsungi wu muelo mu nzo yi Nzambi ama</para>
  <para style="q1" vid="PSA 84:10">ayi mu vuandanga mu zinzo zi ngoto zi batu bambimbi.<verse eid="PSA 84:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>Bila Yave Nzambi niandi thangu ayi nkaku,</para>
  <para style="q1" vid="PSA 84:11">Yave wela vana nlemvo ayi nzitusu,</para>
  <para style="q1" vid="PSA 84:11">kadi kima kimosi kimboti kalendi yimina ko</para>
  <para style="q1" vid="PSA 84:11">bobo bandiatilanga mu kambu tsembolo.<verse eid="PSA 84:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>A Yave nkua ngolo yoso !</para>
  <para style="q1" vid="PSA 84:12">Lusakumunu kuidi mutu wowo weti tula</para>
  <para style="q1" vid="PSA 84:12">diana diandi mu ngeyo !<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="cl">Minkunga 85</para>
  <para style="s1">Yave weti kutuvangila mamboti</para>
  <para style="d">Nkunga bana ba Kole kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1"/>Wumonisa nlemvo kuidi ntoto aku ; a Yave,</para>
  <para style="q1" vid="PSA 85:1">wuvutula kiuka ki Yakobi.<verse eid="PSA 85:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>Wulemvukila mambimbi ma batu baku ;</para>
  <para style="q1" vid="PSA 85:2">ayi wufuka masumu mawu moso.<verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>Wutula miangu miaku mioso va ndambu</para>
  <para style="q1" vid="PSA 85:3">ayi wuvutikisa ntima mu nganzi aku.<verse eid="PSA 85:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>Wutuvutula banga bo tutuama bela, a Nzambi Mvulusi eto,</para>
  <para style="q1" vid="PSA 85:4">wutumoni diaka khini.<verse eid="PSA 85:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>Mawuba mu nganzi kuidi beto mu zithangu zioso e ?</para>
  <para style="q1" vid="PSA 85:5">Mawulambisa nganzi aku tsungi ka tsungi e ?<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>Wukadi buela tuvutudila luzingu</para>
  <para style="q1" vid="PSA 85:6">muingi batu baku bamona khini mu ngeyo e ?<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>Wutumonisa luzolo luaku lu ngolo, a Yave,</para>
  <para style="q1" vid="PSA 85:7">ayi wutuvani phulusu aku.<verse eid="PSA 85:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>Ndiela wa momo, Nzambi Yave kela tuba ;</para>
  <para style="q1" vid="PSA 85:8">veni zitsila zi ndembama kuidi batu bandi,</para>
  <para style="q1" vid="PSA 85:8">kuidi banlongo bandi</para>
  <para style="q1" vid="PSA 85:8">vayi buna babika vutukila kilawu.<verse eid="PSA 85:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>Kiedika, phulusu andi yifikimini</para>
  <para style="q1" vid="PSA 85:9">babo beti kunkinzikanga</para>
  <para style="q1" vid="PSA 85:9">mu diambu di nkembo andi wuzingila mu ntoto eto.<verse eid="PSA 85:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>Luzolo ayi kikhuikizi bidengini ;</para>
  <para style="q1" vid="PSA 85:10">busonga ayi ndembama bibumbisini.<verse eid="PSA 85:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>Kikhuikizi kitotukidi va ntoto</para>
  <para style="q1" vid="PSA 85:11">ayi busonga buntala ku tsi tona ku diyilu.<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>Buna Yave mamvandi wela vana biobio bidi bimboti</para>
  <para style="q1" vid="PSA 85:12">ayi ntoto eto wela buta mimbutu miandi.<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>Busonga buela kuntuaminina ku ntuala</para>
  <para style="q1" vid="PSA 85:13">ayi buela kubika nzila mu diambu di bitambi biandi.<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="cl">Minkunga 86</para>
  <para style="s1">Yiza wuphukisa</para>
  <para style="d">Lusambulu lu Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1"/>Wa, a Yave, ayi wuphani mvutu</para>
  <para style="q1" vid="PSA 86:1">bila ndidi nkua kiadi ayi ndidi nsukami.<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>Keba luzingu luama bila ndikiyekula kuidi ngeyo.</para>
  <para style="q1" vid="PSA 86:2">Ngeyo Nzambi ama, vukisa kisadi kiaku</para>
  <para style="q1" vid="PSA 86:2">kikusilanga diana.<verse eid="PSA 86:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3"/>Bika wumbona kiadi, a Yave,</para>
  <para style="q1" vid="PSA 86:3">Bila ngeyo ndieti tela mu lumbu kimvimba.<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>Nata khini kuidi kisadi kiaku.</para>
  <para style="q1" vid="PSA 86:4">Bila kuidi ngeyo, a Yave</para>
  <para style="q1" vid="PSA 86:4">ndieti vumuna muelꞌama.<verse eid="PSA 86:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>Ngeyo widi wumboti ayi weti lemvukilanga ;</para>
  <para style="q1" vid="PSA 86:5">ayi widi wufuluka mu mamboti</para>
  <para style="q1" vid="PSA 86:5">kuidi bobo beti kutela.<verse eid="PSA 86:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>Wa lusambulu luama, a Yave ;</para>
  <para style="q1" vid="PSA 86:6">wa bumboti yamikina kuama mu diambu di kiadi.<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>Mu lumbu ki ziphasi ziama ngeyo ndiela tela,</para>
  <para style="q1" vid="PSA 86:7">bila ngeyo wela kuphana mvutu.<verse eid="PSA 86:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>A Va khatitsika zinzambi,</para>
  <para style="q1" vid="PSA 86:8">kuisi ko yoyi yidedikini banga ngeyo, a Yave</para>
  <para style="q1" vid="PSA 86:8">ayi kuisi ko mavanga madedakani banga maku.<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>Makanda moso momo wuvanga</para>
  <para style="q1" vid="PSA 86:9">mela kuiza ayi mela buongama va ntualꞌaku, a Yave,</para>
  <para style="q1" vid="PSA 86:9">ayi mela nata nkembo kuidi dizina diaku.<verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>Bila ngeyo widi wunneni ayi ngeyo wumvanganga</para>
  <para style="q1" vid="PSA 86:10">mavanga matsiminanga ;</para>
  <para style="q1" vid="PSA 86:10">ngeyo kaka Nzambi.<verse eid="PSA 86:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>Wundongi nzilꞌaku, a Yave</para>
  <para style="q1" vid="PSA 86:11">ayi ndiela diatila mu bukiedika buaku ;</para>
  <para style="q1" vid="PSA 86:11">bika wuphana ntima wukambu vasuka</para>
  <para style="q1" vid="PSA 86:11">muingi ndikinzikanga dizina diaku.<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>Ndiela kuzitisa, a Yave Nzambi ama,</para>
  <para style="q1" vid="PSA 86:12">mu ntimꞌama wumvimba</para>
  <para style="q1" vid="PSA 86:12">ayi ndiela kembisanga dizina diaku</para>
  <para style="q1" vid="PSA 86:12">mu zithangu zioso.<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>Bila luzolo luaku luidi lunneni kuidi minu</para>
  <para style="q1" vid="PSA 86:13">ngeyo wukhula mu zithipula zi tsi bafua.<verse eid="PSA 86:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>Batu baluniemo balembo nduanisa, a Nzambi ;</para>
  <para style="q1" vid="PSA 86:14">ayi nkangu wu batu ba makhemi</para>
  <para style="q1" vid="PSA 86:14">balembo tombi luzingu luama ;</para>
  <para style="q1" vid="PSA 86:14">batu bakambulu thalu mu ngeyo.<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>Vayi ngeyo, a Yave, weti mona kiadi ;</para>
  <para style="q1" vid="PSA 86:15">yimonisanga nlemvo,</para>
  <para style="q1" vid="PSA 86:15">wuvika fuemanga ko ; fulukidi mu luzolo ayi mu kikhuikizi.<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>Baluka kuidi minu ayi wumboni kiadi ;</para>
  <para style="q1" vid="PSA 86:16">vana zingolo ziaku kuidi kisadi kiaku</para>
  <para style="q1" vid="PSA 86:16">ayi vukisa muana kisadi kiaku ki nketo.<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>Bika wuphana dimbu ki mamboti maku</para>
  <para style="q1" vid="PSA 86:17">muingi bambeni ziama zimona kiawu</para>
  <para style="q1" vid="PSA 86:17">ayi bafua tsoni</para>
  <para style="q1" vid="PSA 86:17">bila ngeyo Yave wutsadisidi ayi wumbombidi.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="cl">Minkunga 87</para>
  <para style="s1">Batu boso ku Sioni babutukila</para>
  <para style="d">Nkunga bana ba Kole.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1"/>Wutula fondasio andi ku mongo wunlongo.<verse eid="PSA 87:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2"/>Yave weti zola mielo mi Sioni</para>
  <para style="q1" vid="PSA 87:2">viokila bibuangu bioso bimvuandanga Yakobi.<verse eid="PSA 87:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>Mambu ma nkembo matubu mu diambu diaku ;</para>
  <para style="q1" vid="PSA 87:3">a divula di Nzambi.<verse eid="PSA 87:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>“Ndiela yolukila Lahabi ayi Babiloni</para>
  <para style="q1" vid="PSA 87:4">muidi bobo banzebi ;</para>
  <para style="q1" vid="PSA 87:4">tsi yi Filisiti ayi Tila va kimosi ayi Kutsi :</para>
  <para style="q1" vid="PSA 87:4">ayi tuba : mutu wawu ku Sioni kabutukila”.<verse eid="PSA 87:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>Buna mu diambu di Sioni ; bela tuba :</para>
  <para style="q1" vid="PSA 87:5">“Mutu wawu ayi mutu wuna, mu niandi babutukila”</para>
  <para style="q1" vid="PSA 87:5">ayi Nzambi yizangama, niandi wela kumbieka.<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>Yave wela sonika batu mu buku :</para>
  <para style="q1" vid="PSA 87:6">“mutu wawu ku Sioni kabutukila.”<verse eid="PSA 87:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>Bu balembo budi miziki, bela yimbila :</para>
  <para style="q1" vid="PSA 87:7">“zitho ziama zioso zidi mu ngeyo.”<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="cl">Minkunga 88</para>
  <para style="s1">Lusambulu lu mutu weka nduka fua</para>
  <para style="d">Nkunga bana ba Kole kuidi pfumu minyimbidi ; bayimbidila mu flute. Nkunga Hemani muisi Ezilakite.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1"/>A Yave, Nzambi yoyi yeti kuphukisa,</para>
  <para style="q1" vid="PSA 88:1">muini ayi builu ndieti yamikina va ntualꞌaku.<verse eid="PSA 88:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>Bika lusambulu luama lutula va ntualꞌaku ;</para>
  <para style="q1" vid="PSA 88:2">balula dikutu diaku bu ndilembo yamikina.<verse eid="PSA 88:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>Bila muelꞌama wufulukidi mu ziphasi</para>
  <para style="q1" vid="PSA 88:3">ayi luzingu luama lufikimini tsi yi bafua.<verse eid="PSA 88:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>Ndidi mu ntanda wu batu bobo bankuenda ku diyilu</para>
  <para style="q1" vid="PSA 88:4">ndieka banga mutu kambulu zingolo.<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>Ndidi wuvuanda va ndambu lufua,</para>
  <para style="q1" vid="PSA 88:5">banga batu bavondo ; bobo badi baleka mu ku tsi bafua ;</para>
  <para style="q1" vid="PSA 88:5">bobo wunkambu buela tebukilanga moyo,</para>
  <para style="q1" vid="PSA 88:5">bobo wusia buela bela mayindu ko.<verse eid="PSA 88:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>Ngeyo wuthula mu dibulu dinneni,</para>
  <para style="q1" vid="PSA 88:6">mu tombi kinkobo.<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>Miangu miaku mimbuila ayi zitu midi</para>
  <para style="q1" vid="PSA 88:7">Minu ndidiamusu kuidi ngeyo mu mayo maku moso.<verse eid="PSA 88:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>Ngeyo wuphambisa mu bakundi bama bakiluzolo</para>
  <para style="q1" vid="PSA 88:8">ngeyo wukhitula kima ki khemi kuidi bawu.</para>
  <para style="q1" vid="PSA 88:8">Ndidi wukangama ayi ndilendi baka bu tinina ko.<verse eid="PSA 88:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9"/>Meso mama meka mbumbuluka</para>
  <para style="q1" vid="PSA 88:9">mu diambu di ziphasi ;</para>
  <para style="q1" vid="PSA 88:9">ngeyo ndintela ; a Yave, kadika lumbu</para>
  <para style="q1" vid="PSA 88:9">kuidi ngeyo ndinonuna mioko miama.<verse eid="PSA 88:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10"/>Wulenda kuaku monisa matsiminanga maku kuidi mutu wufua e ?</para>
  <para style="q1" vid="PSA 88:10">Bafua balenda fuluka ayi kuzitisa e ?<verse eid="PSA 88:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>Balenda yolukila luzolo luaku mu tsi bafua</para>
  <para style="q1" vid="PSA 88:11">ayi kikhuikizi kiaku mu mbivusu e ?<verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>Matsiminanga maku malenda zabakanga mu bibuangu bidi tombi</para>
  <para style="q1" vid="PSA 88:12">voti mavanga maku masonga mu ntoto wowo batu bazimbakana</para>
  <para style="q1" vid="PSA 88:12">mambu moso e ?<verse eid="PSA 88:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>Vayi minu kuidi ngeyo ndinyamikina mu tomba lusadusu,</para>
  <para style="q1" vid="PSA 88:13">mu nsuka lusambulu luama lunkuiza va ntualꞌaku.<verse eid="PSA 88:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>Bila mbi ngeyo Yave wundozidi e ?</para>
  <para style="q1" vid="PSA 88:14">Ayi bila mbi wulembo tsuekila zizi kiaku e ?<verse eid="PSA 88:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>Tona mu bumuana buama minu ndidi mu phasi</para>
  <para style="q1" vid="PSA 88:15">ndidi wukangama mu lufua</para>
  <para style="q1" vid="PSA 88:15">Ndimona ziphasi mu tsisi aku</para>
  <para style="q1" vid="PSA 88:15">ayi ndieka wukambu diana.<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>Miangu miaku mingolo mimbuididi</para>
  <para style="q1" vid="PSA 88:16">tsisi aku yimbunga.<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>Mu lumbu kimvimba yawu yinzungidila banga khuka nlangu</para>
  <para style="q1" vid="PSA 88:17">yawu yitungu kumbina mvimba.<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>Ngeyo mu bandiatanga yama ayi mu bakiluzolo bama</para>
  <para style="q1" vid="PSA 88:18">tombi kiawu nkundi ama wukuikama.<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="cl">Minkunga 89</para>
  <para style="s1">Kuevi kuidi mamboti makhulu e ?</para>
  <para style="d">Nkunga Etani muisi Ezilakite.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1"/>Ndiela yimbidila mamboti manneni ma Yave</para>
  <para style="q1" vid="PSA 89:1">mu zithangu zioso.</para>
  <para style="q1" vid="PSA 89:1">Mu munu ama ndiela zabikisila kikuikizi kiaku</para>
  <para style="q1" vid="PSA 89:1">muidi zitsungi zioso.<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>Ndiela samuna ti luzolo luaku luidi lutelama dio ngui mu zithangu zioso.</para>
  <para style="q1" vid="PSA 89:2">Ti ngeyo wutula kikhuikizi kiaku mu diyilu.<verse eid="PSA 89:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>Ngeyo wutuba :</para>
  <para style="q1" vid="PSA 89:3">“nditula Nguizani ama ayi mutu ama wowo ndivinda mafuta ;</para>
  <para style="q1" vid="PSA 89:3">Ndidia ndefi kuidi Davidi, kisadi kiama :<verse eid="PSA 89:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>Ndiela bieka nkunꞌaku mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 89:4">ayi ndiela kitula kundu kiaku ki kipfumu kikinda mu zitsungi zioso.”<verse eid="PSA 89:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>Diyilu dinzitisa matsiminanga maku, a Yave</para>
  <para style="q1" vid="PSA 89:5">kikhuikizi kiaku mu lukutukunu lu banlongo.<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>Bila nani mu matuti wulenda dedokoso banga Yave ?</para>
  <para style="q1" vid="PSA 89:6">Widi banga Yave mu bivangu bi diyilu e ?<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>Mu lukutukunu lu banlongo, Nzambi wulembo kinzuku ngolo</para>
  <para style="q1" vid="PSA 89:7">tsisi kadi yiviokidi batu bobo banzungididi.<verse eid="PSA 89:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>A Yave, Nzambi nkua ngolo yoso, nani widi banga ngeyo e ?</para>
  <para style="q1" vid="PSA 89:8">Widi nkua ngolo, a Yave,</para>
  <para style="q1" vid="PSA 89:8">ayi kikhuikizi kiaku kizungididi.<verse eid="PSA 89:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>Ngeyo weti yadila mbu wufuemini,</para>
  <para style="q1" vid="PSA 89:9">Mayo mandi mawu telama ngeyo weti lembika mawu.<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>Ngeyo wukosikisa Lahabi banga mutu wuvondo</para>
  <para style="q1" vid="PSA 89:10">mu koko kuawu ku lulendo ngeyo wusasikisa bambeni ziaku.<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>Ngeyo vuidi diyilu ayi ntoto diaka ngeyo vuidi wawu.</para>
  <para style="q1" vid="PSA 89:11">Ngeyo wuvanga nza ayi bibio bidi muawu.<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>Ngeyo wuvanga Nodi ayi Sude ;</para>
  <para style="q1" vid="PSA 89:12">Taboli ayi Helimoni</para>
  <para style="q1" vid="PSA 89:12">bieti yimbila mu khini mu diambu di dizina diaku.<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>Koko kuaku kufulukidi mu lulendo ;</para>
  <para style="q1" vid="PSA 89:13">koko kuaku ngolo kuidi</para>
  <para style="q1" vid="PSA 89:13">koko kuaku ku lubakala kuyayusu ngolo.<verse eid="PSA 89:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>Busonga ayi bufuana biawu fundasio</para>
  <para style="q1" vid="PSA 89:14">yi kundu kiaku ki kipfumu.</para>
  <para style="q1" vid="PSA 89:14">Luzolo ayi kikhuikizi bindiata ku ntuala.<verse eid="PSA 89:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>Lusakumunu kuidi batu bobo banlonguka kubudila zitsiaki ;</para>
  <para style="q1" vid="PSA 89:15">bobo bandiatilanga mu kiezila ki meso maku, a Yave.<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>Beti mona khini mu dizina diaku mu lumbu kimvimba</para>
  <para style="q1" vid="PSA 89:16">beti yangalala mu busonga buaku.<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>Bila ngeyo nkembo awu ayi zingolo ziawu</para>
  <para style="q1" vid="PSA 89:17">ayi mu nlemvo aku, ngeyo wuyayisa phokꞌeto.<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>Bukiedika, nkaku eto wuviulu kuidi Yave</para>
  <para style="q1" vid="PSA 89:18">ntinu eto kuidi mutu wunlongo wu Iseli.<verse eid="PSA 89:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>Khumbu yimosi ngeyo wuyolukila mu tsongolo</para>
  <para style="q1" vid="PSA 89:19">kuidi batu baku bakuikama ngeyo wutuba :</para>
  <para style="q1" vid="PSA 89:19">“Ndivana zingolo kuidi mutu wu ngolo.</para>
  <para style="q1" vid="PSA 89:19">Ndiyayisa muana ditoko va khatitsika batu.<verse eid="PSA 89:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>Ndibakula Davidi kisadi kiama,</para>
  <para style="q1" vid="PSA 89:20">mu mafuta mama manlongo, minu ndimvindila.<verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>Koko kuama kuela kunsimba ;</para>
  <para style="q1" vid="PSA 89:21">bukiedika koko kuama kuela kumvana zingolo.<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>Kadi mbeni yimosi yilendi kutula ku tsi minsua miandi ko.</para>
  <para style="q1" vid="PSA 89:22">Mu diambu di futa phaku.</para>
  <para style="q1" vid="PSA 89:22">Kadi mutu wumosi wumbimbi kalendi kunyamisa ko.<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>Ndiela kosikisa va meso mandi batu bobo beti kunlenda</para>
  <para style="q1" vid="PSA 89:23">ayi ndiela buisa bobo beti kunlenda.<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>Luzolo luama lukuikama luela ba yandi</para>
  <para style="q1" vid="PSA 89:24">mpe mu dizina diama phoka ziandi ziela tombolo.<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>Ndiela tula koko kuandi va mbata mbu</para>
  <para style="q1" vid="PSA 89:25">ayi koko kuandi ku lubakala va mbata minlangu.<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>Niandi wela kuthela :</para>
  <para style="q1" vid="PSA 89:26">‘Ngeyo widi dise diama, Nzambi ama</para>
  <para style="q1" vid="PSA 89:26">ditadi dingolo Mvulusi ama.’<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>Ndiela kunsobula diaka muanꞌama wutheti</para>
  <para style="q1" vid="PSA 89:27">wowo lutidi zangama</para>
  <para style="q1" vid="PSA 89:27">mu mintinu mioso midi va ntoto.<verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>Ndiela simbidila luzolo luama va niandi</para>
  <para style="q1" vid="PSA 89:28">mu zithangu ziozo</para>
  <para style="q1" vid="PSA 89:28">ayi Nguizani ama va niandi yilendi ba babeba ko.<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>Ndiela telimisa dio ngui nkunꞌandi mu zithangu zioso</para>
  <para style="q1" vid="PSA 89:29">kundu kiandi ki kipfumu kiela zingila</para>
  <para style="q1" vid="PSA 89:29">banga bilumbu bi diyilu.<verse eid="PSA 89:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>Enati bana bandi balozidi Mina miama</para>
  <para style="q1" vid="PSA 89:30">ayi enati bakadi landakana zinzengolo ziama ;<verse eid="PSA 89:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31"/>enati babundudi zinzengolo ziama</para>
  <para style="q1" vid="PSA 89:31">enati bakadi keba zithumunu ziama,<verse eid="PSA 89:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32"/>ndiela tumbudila masumu mawu mu lusuadi,</para>
  <para style="q1" vid="PSA 89:32">mambimbi mawu mu bikoti ;<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>vayi ndilendi ba botula ko luzolo luama mu niandi</para>
  <para style="q1" vid="PSA 89:33">ayi ndilendi tunuka kikhuikizi kiama ko.<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>Ndilendi ba bundula Nguizani ama ko</para>
  <para style="q1" vid="PSA 89:34">voti ndilendi balula ko</para>
  <para style="q1" vid="PSA 89:34">mambu momo bididi biama matotula.<verse eid="PSA 89:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>Mu khumbu yimosi,</para>
  <para style="q1" vid="PSA 89:35">ndidia ndefi mu bunlongo buama</para>
  <para style="q1" vid="PSA 89:35">ayi ndilendi ba vuna Davidi ko.<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>Buna nkunꞌandi wela zingilanga mu zithangu zioso</para>
  <para style="q1" vid="PSA 89:36">ayi kundu kiandi ki kipfumu kiela zingila va ntualꞌama</para>
  <para style="q1" vid="PSA 89:36">banga thangu.<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>Kiela ba kitelama dio ngui mu zithangu zioso</para>
  <para style="q1" vid="PSA 89:37">banga ngondi,</para>
  <para style="q1" vid="PSA 89:37">mbangi yikuikama mu matuti.”<verse eid="PSA 89:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>Vayi ngeyo wunloza, wunlenza ;</para>
  <para style="q1" vid="PSA 89:38">wuba wufuema beni kuidi mutu aku wudukudila mafuta.<verse eid="PSA 89:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>Ngeyo wuvonda Nguizani ayi kisadi kiaku ;</para>
  <para style="q1" vid="PSA 89:39">ayi ngeyo wubundula budu ki kipfumu kiandi</para>
  <para style="q1" vid="PSA 89:39">nate wuloza kiawu va difundu-fundu.<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>Ngeyo wumana tiolumuna bibaka biandi bioso</para>
  <para style="q1" vid="PSA 89:40">ayi wutula bisuamunu biandi bingolo mu mbivusu.<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>Babo baviokila vana, banziona bima ;</para>
  <para style="q1" vid="PSA 89:41">wuyika diambu di mvuezolo kuidi bafikimini yandi.<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>Ngeyo wuzangula koko ku lubakala</para>
  <para style="q1" vid="PSA 89:42">ku bobo bakunlendanga,</para>
  <para style="q1" vid="PSA 89:42">wumonisa bambeni bandi zioso khini.<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>Ngeyo wuvengumuna meno ma sabala kiandi</para>
  <para style="q1" vid="PSA 89:43">ayi wusia kunsadisa ko mu mvita.<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>Ngeyo wumanisa kiezila kiandi</para>
  <para style="q1" vid="PSA 89:44">ayi wuloza kundu kiandi ki kipfumu va tsi.<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>Ngeyo wukufisa bilumbu bi bumuana buandi ;</para>
  <para style="q1" vid="PSA 89:45">wumfuka yunga ki tsoni.<verse eid="PSA 89:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>Nate thangu mbi a Yave wela suamina e ?</para>
  <para style="q1" vid="PSA 89:46">Nate thangu mbi miangu miaku miela</para>
  <para style="q1" vid="PSA 89:46">lemina banga mbazu e ?<verse eid="PSA 89:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>Tebuka moyo boso luzingu luama luididi lukhufi.</para>
  <para style="q1" vid="PSA 89:47">A buevi, buna mu phamba kuandi wuvangila batu boso e ?<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>Mutu mbi wowo lenda zinga ayi wela kambu mona lufua e ?</para>
  <para style="q1" vid="PSA 89:48">Voti kukivukisa</para>
  <para style="q1" vid="PSA 89:48">mu lulendo lu tsi yi bafua e ?<verse eid="PSA 89:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>A Yave, kuevi kuidi luzolo luaku lunene lukhulu,</para>
  <para style="q1" vid="PSA 89:49">mu lolo wuzengila ndefi mu kikhuikizi kiaku</para>
  <para style="q1" vid="PSA 89:49">mu diambu di Davidi e ?<verse eid="PSA 89:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>Tebukila moyo a Pfumu, buevi kisadi kiaku bakisekinina ;</para>
  <para style="q1" vid="PSA 89:50">buevi ndilembo natina mu ntimꞌama bifingu bi makanda moso.<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>Bifingu biobi bambeni ziaku basekinina,</para>
  <para style="q1" vid="PSA 89:51">biobi basekinina kadika thama yi mutu aku</para>
  <para style="q1" vid="PSA 89:51">wowo wudukudila mafuta.<verse eid="PSA 89:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>Nzitusu kuidi Yave mu zithangu zioso.</para>
  <para style="qr" vid="PSA 89:52">Amen, ayi Amen.<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">BUKU YI NYA</para>
  <para style="cl">Minkunga 90</para>
  <para style="s1">Wutulonga mu tanga bilumbu bieto</para>
  <para style="d">Lusambulu lu Moyize, mutu Nzambi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1"/>Yave, ngeyo wuba buangu kieto kivuanda</para>
  <para style="q1" vid="PSA 90:1">mu tsungi ka tsungi.<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>Tuamina miongo mibutuka</para>
  <para style="q1" vid="PSA 90:2">voti tuamina wuvanga ntoto ayi nza ;</para>
  <para style="q1" vid="PSA 90:2">tona mu thangu ka thangu, ngeyo widi Nzambi.<verse eid="PSA 90:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>Ngeyo wumvutulanga batu mu fundu-fundu</para>
  <para style="q1" vid="PSA 90:3">bu weti tuba :</para>
  <para style="q1" vid="PSA 90:3">“Vutuka mu fundu-fundu, e e bana ba batu.”<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>Bila va meso maku mili di mimvu midedikini</para>
  <para style="q1" vid="PSA 90:4">banga lumbu kimosi kiviokidi zono ;</para>
  <para style="q1" vid="PSA 90:4">voti banga thangu yimosi va builu,<verse eid="PSA 90:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>ngeyo weti botula batu mu tulu tu lufua,</para>
  <para style="q1" vid="PSA 90:5">badi banga biti bimona va nsuka.<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>Va nsuka bimenini bimona,</para>
  <para style="q1" vid="PSA 90:6">va masika bilebukidi ayi biyumini.<verse eid="PSA 90:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>Tulembo lalakana mu diambu di nganzi aku</para>
  <para style="q1" vid="PSA 90:7">ayi tsisi tulembo moni</para>
  <para style="q1" vid="PSA 90:7">mu diambu di miangu miaku.<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>Ngeyo wutudidi mambimbi meto va ntualꞌaku,</para>
  <para style="q1" vid="PSA 90:8">masumu meto masuama</para>
  <para style="q1" vid="PSA 90:8">va ntuala kiezila ki zizi kiaku.<verse eid="PSA 90:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>Bilumbu bieto bioso bilembo mani</para>
  <para style="q1" vid="PSA 90:9">ku tsi nganzi aku ;</para>
  <para style="q1" vid="PSA 90:9">tulembo manisa mimvu mieto ayi luniongo.<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>Tezo ki bilumbu bieto kidi ki lusambudi lumimvu</para>
  <para style="q1" vid="PSA 90:10">voti lunana enati ngolo zidi yeto.</para>
  <para style="q1" vid="PSA 90:10">Sina kiawu kidi kaki kiphasi ayi kimianga.</para>
  <para style="q1" vid="PSA 90:10">Bila luzingu lueti lulembo vioki nsualu</para>
  <para style="q1" vid="PSA 90:10">ayi tulembo yendi.<verse eid="PSA 90:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>Nani zebi lulendo lu nganzi aku e ?</para>
  <para style="q1" vid="PSA 90:11">Muingi miangu miaku miba tola banga lukinzu lolo fueni tambula.<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>Wutulongisa tanga bilumbu bieto mu bufuana</para>
  <para style="q1" vid="PSA 90:12">muingi tubaka ntima wu duenga.<verse eid="PSA 90:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>Bika buela fuema, a Yave.</para>
  <para style="q1" vid="PSA 90:13">Nate thangu mbi mela bela e ?</para>
  <para style="q1" vid="PSA 90:13">Bika wumona bisadi biaku kiadi.<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>Mu nsuka, bika wutuyukutisa mu luzolo luaku lu ngolo ;</para>
  <para style="q1" vid="PSA 90:14">buna tuela yimbilanga mu khini ayi buna tuela yangalala</para>
  <para style="q1" vid="PSA 90:14">mu bilumbu bioso.<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>Wutuyangidikanga boso buididi bilumbu biobi wutumonisina phasi</para>
  <para style="q1" vid="PSA 90:15">boso buididi mimvu miomi tuyamusunu.<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>Bika mavanga maku mamonoso kuidi bisadi biaku ;</para>
  <para style="q1" vid="PSA 90:16">kiezila kiaku kuidi bana bawu.<verse eid="PSA 90:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>Bika nlemvo wu Yave, Nzambi eto wubanga va beto,</para>
  <para style="q1" vid="PSA 90:17">bika mu diambu dieto, wukindisa kisalu ki mioko mieto.</para>
  <para style="q1" vid="PSA 90:17">Nyinga, kindisa kisalu ki mioko mieto.<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="cl">Minkunga 91</para>
  <para style="s1">Suamunu ki kiedika</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1"/>Mutu wowo wumvuandanga ku tsi suamunu ki Nzambi yizangama,</para>
  <para style="q1" vid="PSA 91:1">wela vundila ku tsi kitsusula ki Nzambi</para>
  <para style="q1" vid="PSA 91:1">ngolo yoso.<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>Ndiela tuba mu diambu di Yave :</para>
  <para style="q1" vid="PSA 91:2">Niandi suamunu kiama ayi suamunu kiami kingolo.</para>
  <para style="q1" vid="PSA 91:2">Nzambi ama, mu niandi ndintula diana.<verse eid="PSA 91:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>Bukiedika niandi wela ku vukisa mu ntambu</para>
  <para style="q1" vid="PSA 91:3">ntambi wu zinuni,</para>
  <para style="q1" vid="PSA 91:3">ayi mu nsongo weti vonda.<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>Wela ku fukidila mu zitsala ziandi</para>
  <para style="q1" vid="PSA 91:4">ayi ku tsi mavavi mandi, wela bakula suamunu.</para>
  <para style="q1" vid="PSA 91:4">Kikhuikizi kiandi kiela ba nkaku aku</para>
  <para style="q1" vid="PSA 91:4">ayi baka kiaku kizangama.<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>Wulendi ko mona tsisi mu builu</para>
  <para style="q1" vid="PSA 91:5">voti dionga dieti dumuka va muini ;<verse eid="PSA 91:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6"/>voti nsongo weti vonda,</para>
  <para style="q1" vid="PSA 91:6">wumviokila mu tombi,</para>
  <para style="q1" vid="PSA 91:6">voti vunga kieti bunga va muini ngembele.<verse eid="PSA 91:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>Mili yimosi yilenda bua va ndambu aku</para>
  <para style="q1" vid="PSA 91:7">voti dikumi di mili va koko kuaku ku lubakala,</para>
  <para style="q1" vid="PSA 91:7">vayi kadi diambu dimosi dilendi fikama ko va widi.<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>Wela tala kaka mu meso maku</para>
  <para style="q1" vid="PSA 91:8">ayi wela mona thumbudulu yi batu bambimbi.<verse eid="PSA 91:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>Enati kitudi Nzambi yizangama buangu kiaku weti vuanda</para>
  <para style="q1" vid="PSA 91:9">bosi Yave, suamunu kiama.<verse eid="PSA 91:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10"/>Buna kadi mbimbi yimosi yilendi kubuila ko</para>
  <para style="q1" vid="PSA 91:10">ayi kadi vuku kimosi kilendi fikama va nzoꞌaku yi ngoto ko.<verse eid="PSA 91:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>Bila, mu diambu diaku, wela tumina zimbasi ziandi</para>
  <para style="q1" vid="PSA 91:11">muingi zikeba mu zinzila ziaku zioso.<verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>Ziawu ziela kuvumuna mu mioko miawu</para>
  <para style="q1" vid="PSA 91:12">mu diambu di kulu kuaku kuedi bumina</para>
  <para style="q1" vid="PSA 91:12">thutu mu ditadi.<verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>Ngeyo wela diatidila khosi ayi kusa ;</para>
  <para style="q1" vid="PSA 91:13">wela kosikisa khosi yiyunduka ayi nioka,<verse eid="PSA 91:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>Yave kembi : “sumbu keta kunzola ndiela ku nkula,</para>
  <para style="q1" vid="PSA 91:14">ayi ndiela ku nkeba</para>
  <para style="q1" vid="PSA 91:14">bila zebi dizina diama.<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>Wela kuthela ayi ndiela kumvana mvutu.</para>
  <para style="q1" vid="PSA 91:15">Ndiela banga yandi mu ziphasi</para>
  <para style="q1" vid="PSA 91:15">ndiela ku nkula ayi ku nkinzika.<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>Ndiela kunyukutisa mu luzingu lu mula</para>
  <para style="q1" vid="PSA 91:16">ayi ndiela kummonisa phulusu ama.”<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="cl">Minkunga 92</para>
  <para style="s1">Didi diambu di mboti mu zitisa Yave</para>
  <para style="d">Nkunga wu lumbu ki saba.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1"/>Didi diambu dimboti mu zitisa Yave</para>
  <para style="q1" vid="PSA 92:1">ayi bula miziki mu diambu di dizina diaku, a Nzambi yizangama,<verse eid="PSA 92:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>mu yamikisa luzolo luaku mu nsuka</para>
  <para style="q1" vid="PSA 92:2">ayi kikhuikizi kiaku va builu,<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>mu miziki dikumi di minsinga, di siku beti tedila Lila</para>
  <para style="q1" vid="PSA 92:3">ayi mu nningu wu ngitala.<verse eid="PSA 92:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>Bila ngeyo wumbonisa khini mu mavanga maku, a Yave.</para>
  <para style="q1" vid="PSA 92:4">Ndiela yimbila mu khini</para>
  <para style="q1" vid="PSA 92:4">mu diambu di mavanga ma mioko miaku.<verse eid="PSA 92:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>A phila tola mavanga maku madi, a Yave,</para>
  <para style="q1" vid="PSA 92:5">a phila thipula mabanza maku madi !<verse eid="PSA 92:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>Wukambulu diela kasi zaba ko</para>
  <para style="q1" vid="PSA 92:6">vungisi kalendi sudika ko,<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>muingi ka diambu ko batu bambimbi banyunduka banga biti,</para>
  <para style="q1" vid="PSA 92:7">ayi batu boso bamvanganga mambimbi bammonanga mamboti ;</para>
  <para style="q1" vid="PSA 92:7">bela bungu mu zithangu zioso.<verse eid="PSA 92:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>Vayi ngeyo Yave widi wuyayusu mu zithangu zioso.<verse eid="PSA 92:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9"/>Bukiedika bambeni ziaku, a Yave,</para>
  <para style="q1" vid="PSA 92:9">bukiedika bambeni ziaku ziela biva</para>
  <para style="q1" vid="PSA 92:9">bisadi bioso bieti vanga mambimbi</para>
  <para style="q1" vid="PSA 92:9">biela sasukusu.<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>Vayi ngeyo wela yayisa phokꞌama</para>
  <para style="q1" vid="PSA 92:10">banga phoka phakasa.</para>
  <para style="q1" vid="PSA 92:10">Mafuta mamosi ma kitoko mandukudulu.<verse eid="PSA 92:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>Buna meso mama mamona mbedosolo yi</para>
  <para style="q1" vid="PSA 92:11">batu bobo beti kundenda ;</para>
  <para style="q1" vid="PSA 92:11">makutu mama mawa biyoko bi batu bambimbi bantina,</para>
  <para style="q1" vid="PSA 92:11">bobo beti kundenda.<verse eid="PSA 92:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>Batu basonga bela mona mamboti banga diba,</para>
  <para style="q1" vid="PSA 92:12">bela yunduka banga sedeli wu Libani ;<verse eid="PSA 92:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>bakunu mu nzo Yave,</para>
  <para style="q1" vid="PSA 92:13">bela mona mamboti mu ziphangu zi Nzambi eto ;<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>bela buta mimbutu banza mu bununu buawu bu ngolo ;</para>
  <para style="q1" vid="PSA 92:14">badi kaka banlangu ayi meza ma nlangu madi yawu.<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>Mu yamikisanga Yave widi wululama</para>
  <para style="q1" vid="PSA 92:15">Niandi ditadi diama ayi mambimbi masi ko mu niandi.<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="cl">Minkunga 93</para>
  <para style="s1">Yave weti yala tona thama ayi mu zithangu zioso.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1"/>Yave weti yala, vueti nzitusu,</para>
  <para style="q1" vid="PSA 93:1">Yave vueti nzitusu ayi wukivuatisidi zingolo.</para>
  <para style="q1" vid="PSA 93:1">Nza yidi yikindusu dio ngui ;</para>
  <para style="q1" vid="PSA 93:1">yilendi nikuka ko.<verse eid="PSA 93:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2"/>Kundu kiaku ki Kipfumu kikibiekolo tona thama ;</para>
  <para style="q1" vid="PSA 93:2">ngeyo widi tona mu zithangu zioso.<verse eid="PSA 93:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>Mimbu mifuemini, a Yave ;</para>
  <para style="q1" vid="PSA 93:3">mimbu miwakisidi zimbembo ziawu,</para>
  <para style="q1" vid="PSA 93:3">mimbu miwakikisidi mayo mawu mankumba.<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>Lulendo viokila dumu ki minlangu minneni</para>
  <para style="q1" vid="PSA 93:4">lulendo viokila bobo beti basa mimbi</para>
  <para style="q1" vid="PSA 93:4">Yave lulendo kadi mu diyilu.<verse eid="PSA 93:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>Zinzengolo ziaku zidi zitelama dio ngui.</para>
  <para style="q1" vid="PSA 93:5">Bunlongo bueti monisanga kitoko mu nzo aku, a Yave,</para>
  <para style="q1" vid="PSA 93:5">mu bilumbu bikambulu tsukulu, a Yave.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="cl">Minkunga 94</para>
  <para style="s1">Nate thangu mbi batu bambimbi bela nunginanga e ?</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1"/>A Yave, Nzambi wumvutulanga landi.</para>
  <para style="q1" vid="PSA 94:1">A Nzambi, wumvutulanga landi ;</para>
  <para style="q1" vid="PSA 94:1">bika wukimonisa !<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>Telama kuaku ngeyo zuzi di ntoto ;</para>
  <para style="q1" vid="PSA 94:2">bika wuvutudila batu badi luniemo</para>
  <para style="q1" vid="PSA 94:2">momo bafueni tambula.<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>Nate thangu mbi batu bambimbi, a Yave ?</para>
  <para style="q1" vid="PSA 94:3">Nate thangu mbi batu bambimbi bela monanga khini e ?<verse eid="PSA 94:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>Bawu balembo muangisa mambu ma luniemo.</para>
  <para style="q1" vid="PSA 94:4">Batu boso bobo beti vanga mambimbi</para>
  <para style="q1" vid="PSA 94:4">bafulukidi mu luyanu.<verse eid="PSA 94:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>Bawu balembo diatidila batu baku, a Yave,</para>
  <para style="q1" vid="PSA 94:5">balembo yamisa kiuka kiaku.<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>Balembo vondi difuola ayi nkebi ;</para>
  <para style="q1" vid="PSA 94:6">balembo vondi bana ba sana.<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>Balembo tubi : “Yave kakadi mona</para>
  <para style="q1" vid="PSA 94:7">ayi Nzambi yi Yakobi kakadi matala.”<verse eid="PSA 94:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>Lukeba beno bakambulu diela luidi va khatitsika batu !</para>
  <para style="q1" vid="PSA 94:8">Bosi beno bivungisi thangu mbi luela bela nzayilu e ?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>Niandi wutula dikutu kalendi wa ko e ?</para>
  <para style="q1" vid="PSA 94:9">Niandi wukubika dieso kalendo mona ko e ?<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>Niandi weti vana makanda thumbudulu makanda</para>
  <para style="q1" vid="PSA 94:10">kalendi vana thumbudulu ko e ?</para>
  <para style="q1" vid="PSA 94:10">Niandi ko weti longa mutu kambulu nzayilu e ?<verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>Yave zebi mayindu ma mutu ;</para>
  <para style="q1" vid="PSA 94:11">zebi ti mawu madi kaka maphamba.<verse eid="PSA 94:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>Lusakumunu kuidi mutu wowo weti vana thumbudulu, a Yave,</para>
  <para style="q1" vid="PSA 94:12">mutu wowo weti longila mu Mina miaku.<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>Weti kumvana lusadusu mu bilumbu bi phasi</para>
  <para style="q1" vid="PSA 94:13">nate dibulu dinneni diela mana kabu mu diambu di batu bambimbi.<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>Bila Yave kalendi yekula batu bandi ko</para>
  <para style="q1" vid="PSA 94:14">kalendi loza kiuka kiandi ko.<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>Tsambusu yela buela ba diaka yisonga</para>
  <para style="q1" vid="PSA 94:15">ayi baboso bobo badi mintima milulama</para>
  <para style="q1" vid="PSA 94:15">bela landakana yawu.<verse eid="PSA 94:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>Nani wela kuthelumina va ntuala batu bambimbi e ?</para>
  <para style="q1" vid="PSA 94:16">Nani wela telama mu diambu diama</para>
  <para style="q1" vid="PSA 94:16">mu nuanisa bobo bamvanganga mambimbi e ?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>Enati Yave kasia kuphana lusadusu ko</para>
  <para style="q1" vid="PSA 94:17">nganu mu thinu nsualu ndivuandila dio sui mu lufua.<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>Mu thangu ndituba ; “kulu kuama kueka sialumuka” ;</para>
  <para style="q1" vid="PSA 94:18">luzolo luaku, a Yave, lutsimba.<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>Mu thangu mayindu maba mawombo mu minu ;</para>
  <para style="q1" vid="PSA 94:19">mbombolo aku yinata khini mu muelꞌama.<verse eid="PSA 94:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>Kundu ki luyalu ki batu bamvanganga mambimbi</para>
  <para style="q1" vid="PSA 94:20">kilenda ba kithuadi ayi ngeyo ko e ?</para>
  <para style="q1" vid="PSA 94:20">Kioki kinatanga khuamusu mu zinzengolo ziandi e ?<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>Bankutakananga mu nuanisa batu basonga</para>
  <para style="q1" vid="PSA 94:21">ayi zengila mutu kambu bila</para>
  <para style="q1" vid="PSA 94:21">nkanu wu lufua.<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>Vayi Yave wuyika suamunu kiama kingolo ;</para>
  <para style="q1" vid="PSA 94:22">ayi Nzambi ama niandi ditadi dingolo diodi ndieti suamina.<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>Wela kuba vutudila mu diambu di masumu mawu,</para>
  <para style="q1" vid="PSA 94:23">ayi wela kuba bunga mu diambu di mambimbi mawu.</para>
  <para style="q1" vid="PSA 94:23">Yave, Nzambi eto, wela kuba bunga.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="cl">Minkunga 95</para>
  <para style="s1">Niandi simbidi nza mu mioko miandi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1"/>Yizanu, bika tuyimbidila Yave mu khini.</para>
  <para style="q1" vid="PSA 95:1">Bika tuyamikina kuidi ditadi di phulusu eto.<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>Bika tuizanu ku ntualꞌandi mu vana matondo</para>
  <para style="q1" vid="PSA 95:2">tunyayisa mu miziki ayi mu minkunga.<verse eid="PSA 95:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>Bila Yave widi Nzambi yinneni,</para>
  <para style="q1" vid="PSA 95:3">ntinu wunneni va yilu zinzambi zioso.<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>Va koko kuandi muidi vadi phinda zi ntoto</para>
  <para style="q1" vid="PSA 95:4">zitsongi zi miongo zivuiwulu kuidi niandi.<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>Mbu wandi bila niandi veka wuvanga wawu</para>
  <para style="q1" vid="PSA 95:5">ayi mioko miandi mivanga ntoto wu yuma.<verse eid="PSA 95:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>Yizanu bika tukikulula mu buongama,</para>
  <para style="q1" vid="PSA 95:6">bika tufukamanu va ntuala Yave mvangi eto.<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>Bila niandi Nzambi eto</para>
  <para style="q1" vid="PSA 95:7">ayi beto tuidi batu bandi keta dikila,</para>
  <para style="q1" vid="PSA 95:7">nkangu mamemi mu ku tsi lukebolo luandi.</para>
  <para style="q1" vid="PSA 95:7">Enati lumbu kiaku luwilu mbembo andi,<verse eid="PSA 95:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8"/>lubika kitula mintima mieno ngolo</para>
  <para style="q1" vid="PSA 95:8">banga bu luvangila Meliba,</para>
  <para style="q1" vid="PSA 95:8">banga bu luvangila mu lumbu ki Masa mu dikanga ;<verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>Kuna madise beno bathotila ayi batsokila ;</para>
  <para style="q1" vid="PSA 95:9">ka diambu ko bamona momo ndivanga.<verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>Mu makumaya ma mimvu, ndiba mu nganzi</para>
  <para style="q1" vid="PSA 95:10">kuidi tsungi yina ; ndituba :</para>
  <para style="q1" vid="PSA 95:10">“badi batu badi mintima mizimbila</para>
  <para style="q1" vid="PSA 95:10">ayi basia zaba zinzila ziama ko.”<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>Diawu ndizengila ndefi ku tsi nganzi ama :</para>
  <para style="q1" vid="PSA 95:11">“balendi kota ko mu luvundulu luama.”<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="cl">Minkunga 96</para>
  <para style="s1">Bika nza yimvimba yisanisina Yave, ntinu andi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1"/>Luyimbidila Yave nkunga wumona.</para>
  <para style="q1" vid="PSA 96:1">Luyimbidila Yave, ntoto wumbimba.<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>Luyimbidila Yave,</para>
  <para style="q1" vid="PSA 96:2">zitisanu dizina diandi ;</para>
  <para style="q1" vid="PSA 96:2">yamikisanu phulusu andi</para>
  <para style="q1" vid="PSA 96:2">lumbu ka lumbu.<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>Yolukilanu nkembo andi muidi makanda</para>
  <para style="q1" vid="PSA 96:3">mambu mandi matsiminanga</para>
  <para style="q1" vid="PSA 96:3">muidi batu boso.<verse eid="PSA 96:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>Bila Yave widi wunneni</para>
  <para style="q1" vid="PSA 96:4">ayi lutidi mu zitusu ;</para>
  <para style="q1" vid="PSA 96:4">tsisi kadi va yilu zinzambi zioso.<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>Bila zinzambi zi makanda zidi bitumba ;</para>
  <para style="q1" vid="PSA 96:5">vayi Yave niandi wuvanga diyilu.<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>Kiezila ayi nzitusu bidi va ntualꞌandi</para>
  <para style="q1" vid="PSA 96:6">zingolo ayi nkembo bidi mu buangu kiandi ki nlongo.<verse eid="PSA 96:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>Luvana kuidi Yave,</para>
  <para style="q1" vid="PSA 96:7">e mabuta ma makanda ;</para>
  <para style="q1" vid="PSA 96:7">luvana kuidi Yave nkembo ayi ngolo.<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>Luvana nkembo kuidi Yave wufueni mu dizina diandi.</para>
  <para style="q1" vid="PSA 96:8">Lunata dikaba ayi lukota mu ziphangu ziandi.<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>Lubuongimina Yave mu kiezila ki bunlongo buandi.</para>
  <para style="q1" vid="PSA 96:9">Tita va ntualꞌandi, ntoto wumvimba.<verse eid="PSA 96:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>Tuba muidi makanda :</para>
  <para style="q1" vid="PSA 96:10">“Yave weti yala.”</para>
  <para style="q1" vid="PSA 96:10">Nza yidi yikinda dio ngui ;</para>
  <para style="q1" vid="PSA 96:10">yilendi nikuka ko</para>
  <para style="q1" vid="PSA 96:10">bila Yave wela sambisa batu mu bufuana.<verse eid="PSA 96:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>Bika diyilu dimona khini,</para>
  <para style="q1" vid="PSA 96:11">bika ntoto wuyangalala.</para>
  <para style="q1" vid="PSA 96:11">Bika mbu wutula biyoko ayi bibio bidi muna.<verse eid="PSA 96:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12"/>Bika zitsola zimona khini</para>
  <para style="q1" vid="PSA 96:12">ayi bibio bidi muna ;</para>
  <para style="q1" vid="PSA 96:12">buna minti mioso mi nsitu miyimbila</para>
  <para style="q1" vid="PSA 96:12">mu diambu di khini.<verse eid="PSA 96:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13"/>Miela yimbila va ntuala Yave, bila wulembo yizi,</para>
  <para style="q1" vid="PSA 96:13">wulembo yizi mu sambisa ntoto.</para>
  <para style="q1" vid="PSA 96:13">Wela sambisa nza mu busonga</para>
  <para style="q1" vid="PSA 96:13">ayi batu mu Kedika kiandi.<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="cl">Minkunga 97</para>
  <para style="s1">Nzambi yinneni yi nza.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1"/>Yave weti yala, bika ntoto wuyangalala.</para>
  <para style="q1" vid="PSA 97:1">Bika bisanga biobi bidi thama bimona nkini.<verse eid="PSA 97:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>Matuti ayi tombi kinkobo binzungididi.</para>
  <para style="q1" vid="PSA 97:2">Busonga ayi bufuana biawu</para>
  <para style="q1" vid="PSA 97:2">fundasio yi kundu kiandi ki kipfumu.<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>Mbazu yeti kuenda ku ntualꞌandi</para>
  <para style="q1" vid="PSA 97:3">ayi yeti zinisa batu bobo beti kunlenda ku kadika ndambu<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>Zitsiemo ziandi zieti kienzula nza,</para>
  <para style="q1" vid="PSA 97:4">ntoto weti mona ayi weti tita.<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>Miongo misiuta banga mafuta momo beti vinda mu bikundu va ntuala Yave,</para>
  <para style="q1" vid="PSA 97:5">va ntuala Yave wu ntoto wumvimba.<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>Diyilu dieti yamikina busonga buandi</para>
  <para style="q1" vid="PSA 97:6">ayi batu boso beti mona nkembo andi.<verse eid="PSA 97:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>Babo bobo bambuongiminanga zimfikula beti fua tsoni ;</para>
  <para style="q1" vid="PSA 97:7">bobo beti kukiniemisa mu diambu di bitumba.</para>
  <para style="q1" vid="PSA 97:7">Lumbuongimina, beno zinzambi zioso.<verse eid="PSA 97:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>Sioni weti wa ayi weti mona khini</para>
  <para style="q1" vid="PSA 97:8">ayi bana ba baketo ba Yuda beti yangalala</para>
  <para style="q1" vid="PSA 97:8">mu diambu di zinzengolo ziaku, a Yave.<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>Bila ngeyo Yave, widi Nzambi yizangama va ntoto wumvimba.</para>
  <para style="q1" vid="PSA 97:9">Ngeyo widi wuyayusu ngolo</para>
  <para style="q1" vid="PSA 97:9">va yilu zinzambi zioso.<verse eid="PSA 97:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>Bika babo beti zola Yave, balenda mambimbi.</para>
  <para style="q1" vid="PSA 97:10">Bila weti keba luzingu lu banlongo bandi.</para>
  <para style="q1" vid="PSA 97:10">Niandi wukubakulanga mu mioko mi batu bambimbi.<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>Kiezila kieti totuka mu diambu di batu basonga</para>
  <para style="q1" vid="PSA 97:11">ayi khini mu diambu di bobo</para>
  <para style="q1" vid="PSA 97:11">badi lulama mu mintima.<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>Bika lumona khini mu Yave, beno luidi basonga</para>
  <para style="q1" vid="PSA 97:12">ayi luzitisa dizina diandi di nlongo.<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="cl">Minkunga 98</para>
  <para style="s1">Nzambi wizidi mu sambisa nza</para>
  <para style="d">Nkunga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1"/>Yimbidilanu Yave nkunga wumona</para>
  <para style="q1" vid="PSA 98:1">bila wuvengi mambu ma kitoko.</para>
  <para style="q1" vid="PSA 98:1">Koko kuandi ku lubakala ayi koko kuandi kunlongo</para>
  <para style="q1" vid="PSA 98:1">mivengi phulusu mu diambu diandi.<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>Yave wuzabikisa phulusu andi ;</para>
  <para style="q1" vid="PSA 98:2">ayi wumonisa busonga buandi kuidi makanda.<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>Wutebukila luzolo luandi moyo</para>
  <para style="q1" vid="PSA 98:3">ayi kikhuikizi kiandi kuidi nzo yi Iseli.</para>
  <para style="q1" vid="PSA 98:3">Zitsukusunu zioso zi ntoto</para>
  <para style="q1" vid="PSA 98:3">zimona phulusu yi Nzambi eto.<verse eid="PSA 98:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>Yamikina mu khini kuidi Yave, ntoto wumvimba ;</para>
  <para style="q1" vid="PSA 98:4">ludila mu nkunga mi mayangi va kimosi ayi miziki.<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>Lubula miziki kuidi Yave mu ngitala,</para>
  <para style="q1" vid="PSA 98:5">mu ngitala ayi mu biyoko bi nyimbidi ;<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>mu zitulumbeta ayi mu biyoko bi phoka yi dimemi,</para>
  <para style="q1" vid="PSA 98:6">yamikinanu mu khini va ntuala Yave, ntinu.<verse eid="PSA 98:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>Bika mbu wuwakikisa biyoko va kimosi</para>
  <para style="q1" vid="PSA 98:7">ayi kadika kima kidi muna ;</para>
  <para style="q1" vid="PSA 98:7">bika nza ayi babo bobo banzingilanga muawu bayamikina.<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>Bika minlangu minneni mibula mioko miawu.</para>
  <para style="q1" vid="PSA 98:8">Bika miongo miyimbila va kimosi mu khini ;<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>bika bayimbila va ntuala Yave</para>
  <para style="q1" vid="PSA 98:9">bila wulembo yizi mu diambu di sambisa ntoto.</para>
  <para style="q1" vid="PSA 98:9">Niandi wela sambisa nza mu busonga</para>
  <para style="q1" vid="PSA 98:9">ayi batu mu bufuana.<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="cl">Minkunga 99</para>
  <para style="s1">Lubuongimina Yave bila widi wunlongo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1"/>Yave weti yala,</para>
  <para style="q1" vid="PSA 99:1">bika makanda matita</para>
  <para style="q1" vid="PSA 99:1">vuandisidi kundu kiandi ki kipfumu va khatitsika Bakeluba.</para>
  <para style="q1" vid="PSA 99:1">Bika ntoto wunikuka.<verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>Yave widi wunneni mu Sioni</para>
  <para style="q1" vid="PSA 99:2">widi wuyayusu va yilu makanda moso.<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>Bika bazitisa dizina diaku dinneni ayi ditsisi.</para>
  <para style="q1" vid="PSA 99:3">Niandi widi wunlongo.<verse eid="PSA 99:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>Ntinu widi wu lulendo wunzolanga busonga.</para>
  <para style="q1" vid="PSA 99:4">Ngeyo wukindisa mambu mafuana</para>
  <para style="q1" vid="PSA 99:4">Mu Yakobi, wuvanga momo madi masonga ayi malulama.<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>Luyayisa Yave, Nzambi eto.</para>
  <para style="q1" vid="PSA 99:5">Lubuongama va ntuala buangu kioki</para>
  <para style="q1" vid="PSA 99:5">keti tetikanga malu mandi.</para>
  <para style="q1" vid="PSA 99:5">Niandi widi wunlongo.<verse eid="PSA 99:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>Moyize ayi Aloni baba va khatitsika</para>
  <para style="q1" vid="PSA 99:6">zinganga ziandi zi Nzambi ;</para>
  <para style="q1" vid="PSA 99:6">Samueli wuba va khatitsika bobo bantelanga</para>
  <para style="q1" vid="PSA 99:6">dizina diandi,</para>
  <para style="q1" vid="PSA 99:6">batela Yave</para>
  <para style="q1" vid="PSA 99:6">ayi niandi wuba vana mvutu.<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>Niandi wuba yolukila mu dikunzi di dituti.</para>
  <para style="q1" vid="PSA 99:7">Bawu bakeba zinzengolo ziandi</para>
  <para style="q1" vid="PSA 99:7">ayi zithumunu ziosi kaba vana.<verse eid="PSA 99:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>A Yave, Nzambi eto, ngeyo wuba vana mvutu.</para>
  <para style="q1" vid="PSA 99:8">Ngeyo wuba kuidi Iseli, ngeyo wuba Nzambi</para>
  <para style="q1" vid="PSA 99:8">yoyi yiba kuba lemvukilanga ;</para>
  <para style="q1" vid="PSA 99:8">ka diambu ko ngeyo wuba kuba vananga</para>
  <para style="q1" vid="PSA 99:8">thumbudulu mu mavanga mawu mambimbi.<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>Yayisanu Yave, Nzambi eto.</para>
  <para style="q1" vid="PSA 99:9">Lubuongama va ntuala mongo andi wunlongo</para>
  <para style="q1" vid="PSA 99:9">bila Yave, Nzambi eto, widi wunlongo.<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="cl">Minkunga 100</para>
  <para style="s1">Yave wulembo zitusu kuidi batu bandi</para>
  <para style="d">Nkunga wu phutudulu matondo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1"/>Yamikinanu mu khini kuidi Yave, ntoto wumvimba.<verse eid="PSA 100:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2"/>Lubuongimina Yave mu khini ;</para>
  <para style="q1" vid="PSA 100:2">yizanu va ntualꞌandi mu minkunga mi khini.<verse eid="PSA 100:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>Luzaba ti Yave niandi Nzambi.</para>
  <para style="q1" vid="PSA 100:3">Niandi wutuvanga ayi niandi wutuvuidi.</para>
  <para style="q1" vid="PSA 100:3">Tuidi batu bandi ; nkangu andi, wu mamemi</para>
  <para style="q1" vid="PSA 100:3">wowo kedi dikila.<verse eid="PSA 100:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>Kotanu mu mielo miandi mu phutudulu matondo</para>
  <para style="q1" vid="PSA 100:4">ayi mu ziphangu ziandi va kimosi ayi minzitusu.</para>
  <para style="q1" vid="PSA 100:4">Lumvutudila matondo ayi luzitisa dizina diandi.<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>Bila Yave widi wumboti</para>
  <para style="q1" vid="PSA 100:5">ayi luzolo luandi lunzingila mu zithangu zioso.</para>
  <para style="q1" vid="PSA 100:5">Ayi kikhuikizi kiandi kidi mu zitsungi zioso.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="cl">Minkunga 101</para>
  <para style="s1">Kukiyekula mu nuanisa mambimbi</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1"/>Ndiela yimbidila luzolo luaku ayi busonga ;</para>
  <para style="q1" vid="PSA 101:1">Kuidi ngeyo ndiela yimbidila minzitusu.<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>Ndiela lubaka mu diatila mu luzingu lukambulu tsembolo.</para>
  <para style="q1" vid="PSA 101:2">Thangu mbi wela kuiza kuidi minu e ?</para>
  <para style="q1" vid="PSA 101:2">Ndiela diatila mu nzo ama</para>
  <para style="q1" vid="PSA 101:2">mu ntima wukambulu tsembolo.<verse eid="PSA 101:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>Ndilendi tula ko va ntuala meso mama</para>
  <para style="q1" vid="PSA 101:3">kadi kima kimosi ko kimbimbi.</para>
  <para style="q1" vid="PSA 101:3">Ndieti lenda mavanga ma bobo</para>
  <para style="q1" vid="PSA 101:3">bakambulu bakuikama</para>
  <para style="q1" vid="PSA 101:3">malendi kundama ko.<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>Batu badi mintima mi mbimbi thama bela kuthatukila</para>
  <para style="q1" vid="PSA 101:4">ndilendi vanga kadi diambu dimosi va kimosi ayi mambimbi<verse eid="PSA 101:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>Woso wuntubidila mutu fikimini yandi mu kinsueki,</para>
  <para style="q1" vid="PSA 101:5">ndiela ku ntula dio sui.</para>
  <para style="q1" vid="PSA 101:5">Woso widi meso ma lunangu</para>
  <para style="q1" vid="PSA 101:5">ayi widi ntima wu luniemo ;</para>
  <para style="q1" vid="PSA 101:5">ndilendi ku nzingisa kuwombo ko.<verse eid="PSA 101:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>Meso mama mela ba va mikhuikizi</para>
  <para style="q1" vid="PSA 101:6">mi tsi muingi bakalanga yama ;</para>
  <para style="q1" vid="PSA 101:6">woso wundiatila mu kambu tsembolo, wela kutsadila.<verse eid="PSA 101:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>Kadi mutu wunsadilanga bukhita</para>
  <para style="q1" vid="PSA 101:7">lenda vuanda mu nzo ama.</para>
  <para style="q1" vid="PSA 101:7">Kadi mutu wuntubanga luvunu lenda telama</para>
  <para style="q1" vid="PSA 101:7">va meso mama.<verse eid="PSA 101:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>Kadika nsuka, ndiela tula dio sui</para>
  <para style="q1" vid="PSA 101:8">batu boso bambimbi badi va ntoto ;</para>
  <para style="q1" vid="PSA 101:8">ndiela lalikisa kisadi kioso ki mbimbi</para>
  <para style="q1" vid="PSA 101:8">mu divula di Yave.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="cl">Minkunga 102</para>
  <para style="s1">Lusambulu lu nkua mabienga</para>
  <para style="d">Lusambulu lu nkua mabienga weka vonga ayi wulembo kambi ziphasi ziandi kuidi Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1"/>Wa lusambulu luama, a Yave,</para>
  <para style="q1" vid="PSA 102:1">bika yamikina kuama mu diambu di lusadusu kutula kuidi ngeyo<verse eid="PSA 102:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>Kadi kutsuekila zizi kiaku thangu ndidi mu phasi,</para>
  <para style="q1" vid="PSA 102:2">tamba dikutu diaku kuidi minu ;</para>
  <para style="q1" vid="PSA 102:2">thangu ndikutela, sia nsualu ; wuphana mvutu !<verse eid="PSA 102:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>Bila bilumbu biama bilembo lalakana banga muisi,</para>
  <para style="q1" vid="PSA 102:3">mimvesi miama milembo yokana</para>
  <para style="q1" vid="PSA 102:3">banga makaba ma ku mbazu.<verse eid="PSA 102:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>Ntimꞌama wukosikini ayi wuyumini banga biti ;</para>
  <para style="q1" vid="PSA 102:4">ndizimbikini dia bidia biama.<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>Mu diambu di kunga kuama</para>
  <para style="q1" vid="PSA 102:5">nkanda nitu kaka ayi mimvesi misiala.<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>Ndidi banga kimfutu kidi mu dikanga ;</para>
  <para style="q1" vid="PSA 102:6">banga kimfutu va khatitsika</para>
  <para style="q1" vid="PSA 102:6">bibuangu bikambulu batu ;<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>Ndilembo leki nkielo,</para>
  <para style="q1" vid="PSA 102:7">ndieka banga nuni</para>
  <para style="q1" vid="PSA 102:7">yidi yawu veka ku yilu nzo.<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>Mu lumbu kimvimba,</para>
  <para style="q1" vid="PSA 102:8">bambeni ziama zilembo mfingi ;</para>
  <para style="q1" vid="PSA 102:8">bobo bamekumfuemina,</para>
  <para style="q1" vid="PSA 102:8">balembo sadila dizina diama banga tsingulu.<verse eid="PSA 102:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>Bila ndilembo dia dibombi banga bidia</para>
  <para style="q1" vid="PSA 102:9">ayi ndisobikisidi ndiunu ama ayi matsuela<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>mu diambu di miangu miaku minneni</para>
  <para style="q1" vid="PSA 102:10">bila ngeyo wunzangula ngolo</para>
  <para style="q1" vid="PSA 102:10">ayi wundozidi va lutengo.<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>Bilumbu biama bidi banga kitsusula ki masika</para>
  <para style="q1" vid="PSA 102:11">ndime yuma banga biti.<verse eid="PSA 102:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>Vayi ngeyo, a Yave, wuvuanda va kundu ki kitinu mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 102:12">tsangu aku yilembo zingila mu tsungi ka tsungi.<verse eid="PSA 102:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>Ngeyo wela telama, wela monina Sioni kiadi.</para>
  <para style="q1" vid="PSA 102:13">Bila yawu yoyi thangu yimonisa nlemvo kuidi niandi ;</para>
  <para style="q1" vid="PSA 102:13">thangu yoyi wukubika yfueni.<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>Bila bisadi biaku binzolanga matadi mandi,</para>
  <para style="q1" vid="PSA 102:14">ayi bieti mona kiadi</para>
  <para style="q1" vid="PSA 102:14">mbungi-mbungi andi yela kubanata mu tezo kimona kiadi.<verse eid="PSA 102:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>Makanda mela kinzika dizina di Yave ;</para>
  <para style="q1" vid="PSA 102:15">mintinu mioso mi ntoto</para>
  <para style="q1" vid="PSA 102:15">miela kinzika nkembo aku.<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>Bila Yave wela buela tunga diaka Sioni</para>
  <para style="q1" vid="PSA 102:16">ayi wela monika mu nkembo andi.<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>Wela vana mvutu mu lusambulu lu batu basukama,</para>
  <para style="q1" vid="PSA 102:17">kalendi lenza maniongo mawu ko.<verse eid="PSA 102:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>Bika mambu mama masonama mu diambu di tsungi yinkuiza</para>
  <para style="q1" vid="PSA 102:18">muingi batu bobo kabavangimini ko babaka buzitisila Yave.<verse eid="PSA 102:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>Yave wutala ku tsi tona ku buangu kiandi kinlongo kidi ku yilu</para>
  <para style="q1" vid="PSA 102:19">tona ku diyilu niandi wuntala ntoto,<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>mu diambu di wa kunga ku batu badi mu nloko ;</para>
  <para style="q1" vid="PSA 102:20">ayi mu diambu di kula bobo bazengolo nkanu wu lufua ;<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>buna dizina di Yave diela yolukulu mu Sioni</para>
  <para style="q1" vid="PSA 102:21">ayi minzitusu miandi mu Yelusalemi<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>mu thangu batu bela kutangana va kimosi ayi bipfumu</para>
  <para style="q1" vid="PSA 102:22">mu diambu di buongimina Yave.<verse eid="PSA 102:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>Mu luzingu luama, wumanisa zingolo ziama ;</para>
  <para style="q1" vid="PSA 102:23">wukufika bilumbu biama.<verse eid="PSA 102:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>Buna ndituba :</para>
  <para style="q1" vid="PSA 102:24">“kadi kumbotula, a Nzambi ama, va khatitsika yi bilumbu biama ;</para>
  <para style="q1" vid="PSA 102:24">mimvu miaku miela zingilanga mu tsungi ka tsungi.<verse eid="PSA 102:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>Va thonono, ngeyo wutula zifondasio zi ntoto</para>
  <para style="q1" vid="PSA 102:25">ayi diyilu didi kisalu ki mioko miaku.<verse eid="PSA 102:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>Biela biva vayi ngeyo wela zinganga,</para>
  <para style="q1" vid="PSA 102:26">bibioso biela mana vembudila banga nledi,</para>
  <para style="q1" vid="PSA 102:26">ngeyo wela bibalula banga kikhutu ayi biawu biela vengumunu.<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>Vayi ngeyo wubalukanga ko,</para>
  <para style="q1" vid="PSA 102:27">ayi mimvu miaku milendi suka ko.<verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>Bana ba bisadi biaku bela zingilanga va meso maku</para>
  <para style="q1" vid="PSA 102:28">minkuna miawu miela ba mitelama dio ngui va ntualꞌaku.”<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="cl">Minkunga 103</para>
  <para style="s1">Bika nituꞌama yimvimba yizitisa Yave</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1"/>Zitisa Yave, a muelꞌama ;</para>
  <para style="q1" vid="PSA 103:1">bibioso bidi mu minu bizitisa dizina diandi dinlongo.<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>Zitisa Yave, a muelꞌama, ayi kadi zimbakana mamboti mandi moso kavanga.<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>Niandi weti lemvukila masumu maku moso</para>
  <para style="q1" vid="PSA 103:3">ayi weti belusa minsongo miaku bioso.<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>Niandi weti kula luzingu luaku mu dibulu ;</para>
  <para style="q1" vid="PSA 103:4">ayi niandi weti kuvuika luzolo ayi kiadi.<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>Niandi weti yukutisa zitsatu ziaku mu bima bimboti</para>
  <para style="q1" vid="PSA 103:5">muingi bumuana buaku bukituka diaka bumona</para>
  <para style="q1" vid="PSA 103:5">banga buididi bu mbemba.<verse eid="PSA 103:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>Yave wumvanganga busonga</para>
  <para style="q1" vid="PSA 103:6">ayi bufuana mu diambu di batu boso beti yamusu.<verse eid="PSA 103:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>Wuzabikisa zinzila ziandi kuidi Moyize</para>
  <para style="q1" vid="PSA 103:7">mavanga mandi kuidi batu ba Iseli.<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>Yave widi nkua kiadi ayi nkua nlemvo ;</para>
  <para style="q1" vid="PSA 103:8">kavika fuemanga ko, fulukidi mu luzolo.<verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>Niandi kafundanga ko mu zithangu zioso</para>
  <para style="q1" vid="PSA 103:9">ayi kalundanga ko nganzi andi mu zithangu zioso.<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>Katu vangilanga ko boso buididi masumu meto,</para>
  <para style="q1" vid="PSA 103:10">katuvananga ko thumbudulu boso buididi mambimbi meto.<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>Bila boso diyilu didi dizangama va yilu ntoto ;</para>
  <para style="q1" vid="PSA 103:11">buawu bobo luzolo luandi luidi lunneni</para>
  <para style="q1" vid="PSA 103:11">kuidi bobo beti kunkinzikanga.<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>Boso esite katatukididi ayi wesite,</para>
  <para style="q1" vid="PSA 103:12">buawu bobo katutatudila zinzimbala zieto.<verse eid="PSA 103:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>Banga dise bu kamoninga bana bandi kiadi,</para>
  <para style="q1" vid="PSA 103:13">buawu bobo Yave kamoninga kiadi bobo beti kunkinzika.<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>Bila zebi buevi tuvangulu</para>
  <para style="q1" vid="PSA 103:14">weti tebuka moyo ti tuidi mbungi-mbungi.<verse eid="PSA 103:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>Bila kuidi mutu, bilumbu biandi bidi banga biti ;</para>
  <para style="q1" vid="PSA 103:15">weti mona mamboti banga biteka bi tsola.<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>Phemo yawu viokila va bidi, buna bisiedi ko</para>
  <para style="q1" vid="PSA 103:16">ayi buangu kibibedi kikadi buela kubitebukila moyo.<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>Vayi mu kadika thangu ayi mu zithangu zioso</para>
  <para style="q1" vid="PSA 103:17">luzolo lu Yave luidi kuidi bobo beti kunkinzika</para>
  <para style="q1" vid="PSA 103:17">ayi busonga buandi kuidi bana ba bana bawu ;<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>kuidi bobo beti keba Nguizani andi</para>
  <para style="q1" vid="PSA 103:18">ayi kuidi bobo bantebukilanga tumukina minsiku miandi.<verse eid="PSA 103:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>Yave wutula kundu kiandi ki kipfumu ku diyilu</para>
  <para style="q1" vid="PSA 103:19">ayi kipfumu kiandi kinyadila bima bioso.<verse eid="PSA 103:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>Luzitisa Yave beno zimbasi ziandi ;</para>
  <para style="q1" vid="PSA 103:20">beno makesa lueti vanga zithumunu ziandi,</para>
  <para style="q1" vid="PSA 103:20">lueti tumukina mambu mandi.<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>Luzitisa Yave beno minkangu mi masodi mandi ma diyilu ;</para>
  <para style="q1" vid="PSA 103:21">beno bisadi biandi lueti vanganga luzolo luandi.<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>Luzitisa Yave beno mavanga mandi moso,</para>
  <para style="q1" vid="PSA 103:22">mu bibuangu bioso biobi keti yadila.</para>
  <para style="q1" vid="PSA 103:22">Zitisa Yave, a muelꞌama.<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="cl">Minkunga 104</para>
  <para style="s1">Nzitusu kuidi mvangi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1"/>Zitisa Yave, a muelꞌama.</para>
  <para style="q1" vid="PSA 104:1">A Yave, Nzambi ama, ngeyo widi wunneni ngolo.</para>
  <para style="q1" vid="PSA 104:1">Ngeyo vueti kiezila ayi nzitusu.<verse eid="PSA 104:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2"/>Niandi wukifukidi muinda banga nledi ;</para>
  <para style="q1" vid="PSA 104:2">weti yalumuna diyilu banga nzo yi ngoto,<verse eid="PSA 104:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3"/>ayi wutunga makunzi ma bivinga biandi bizangama va minlangu miawu.</para>
  <para style="q1" vid="PSA 104:3">Niandi weti kitula matuti ditoma diandi di sengo</para>
  <para style="q1" vid="PSA 104:3">ayi weti diatila mu mavavi ma phemo.<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>Wunkitulanga phemo bamvuala bandi,</para>
  <para style="q1" vid="PSA 104:4">minlaki mi mbazu bisadi biandi.<verse eid="PSA 104:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>Wuvuandisa ntoto va zifondasio ziandi ;</para>
  <para style="q1" vid="PSA 104:5">wulendi nikuka ko kadi fifioti.<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>Ngeyo wufukidila wawu mu thipula banga ngeyo wumfukididi nledi,</para>
  <para style="q1" vid="PSA 104:6">Minlangu mitelama nate ku mbata miongo.<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>Vayi bu wutema, minlangu mitina,</para>
  <para style="q1" vid="PSA 104:7">mu biyoko bi dumu kiaku, miawu mitina.<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>Mikumbila va mbata miongo,</para>
  <para style="q1" vid="PSA 104:8">mibua nate mu mindimba ku buangu kioki wukubikila miawu.<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>Ngeyo wumitudila zindilu ziozi ka milendi sabuka ko ;</para>
  <para style="q1" vid="PSA 104:9">milendi buela diamisa ntoto ko.<verse eid="PSA 104:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>Niandi wukubika zitho zi minlangu</para>
  <para style="q1" vid="PSA 104:10">mu zikhola zinkumbanga va khatitsika miongo.<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>Zilembo vani nlangu kuidi bibulu bioso bi tsola,</para>
  <para style="q1" vid="PSA 104:11">ziphunda zi nsitu zimanisinanga phuilꞌawu.<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>Zinuni zi yilu zintunganga dianla mu yenda minlangu,</para>
  <para style="q1" vid="PSA 104:12">zieti yimbila va khatitsika matafi.<verse eid="PSA 104:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>Wulembo lembila miongo tona ku bivinga biandi bizangama ;</para>
  <para style="q1" vid="PSA 104:13">ntoto wuyukutidi mu mbutu wu kisalu kiandi.<verse eid="PSA 104:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>Niandi weti menisa biti mu diambu di bibulu,</para>
  <para style="q1" vid="PSA 104:14">ayi bikunusu mu diambu di batu bakuna,</para>
  <para style="q1" vid="PSA 104:14">ayi totulanga bidia mu ntoto :<verse eid="PSA 104:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15"/>vinu kieti yangidika ntima wu mutu,</para>
  <para style="q1" vid="PSA 104:15">mafuta meta kienzula zizi kiandi</para>
  <para style="q1" vid="PSA 104:15">ayi dipha dieti kindisa ntimꞌandi.<verse eid="PSA 104:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>Minti mi Yave midi milembolo bumboti ;</para>
  <para style="q1" vid="PSA 104:16">minti mi sedeli mi tsi Libani miomi kakuna.<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>Muawu zinuni zieti tungila zindiala ziawu ;</para>
  <para style="q1" vid="PSA 104:17">nuni beti tedila ngongo yitungila nzo andi mu minti mimbutanga zimbala zi phutu.<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>Miongo mi nangama mivuiwulu kuidi zikhombo zi nsitu ;</para>
  <para style="q1" vid="PSA 104:18">zithadi zidi suamunu mu diambu di bibulu bieti tedolo damani<note caller="+" style="f"><char style="fr" closed="false">104.18 </char><char style="fq" closed="false">Damani</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">bulu kidi banga kikueya.</char></note>.<verse eid="PSA 104:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>Ngondi yeti vasa zitsungi,</para>
  <para style="q1" vid="PSA 104:19">ayi thangu zebi thangu mbi kafueti diamina.<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>Ngeyo weti nata tombi, buisi bueti yila</para>
  <para style="q1" vid="PSA 104:20">ayi buna bibulu bioso bi nsitu bilembo diengila-diengila.<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>Zikhosi zillembo kungi mu diambu di biobi zifueti buila</para>
  <para style="q1" vid="PSA 104:21">ayi zieti tomba bidia biawu kuidi Nzambi.<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>Thangu yawu totuka, buna zivengumukini ;</para>
  <para style="q1" vid="PSA 104:22">zivutukidi ayi zilekidi mu minsuku miawu.<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>Buna mutu weti kuenda ku kisalu kiandi,</para>
  <para style="q1" vid="PSA 104:23">ku kisalu kiandi nate buisi bu nyila.<verse eid="PSA 104:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>Phila bisalu biaku bididi woka, a Yave ;</para>
  <para style="q1" vid="PSA 104:24">mu nduenga wuvangila bibioso</para>
  <para style="q1" vid="PSA 104:24">ntoto wufulukidi mu bivangu biaku.<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>Vadi mbu wumosi, wunneni ayi wuyalumuka ;</para>
  <para style="q1" vid="PSA 104:25">muwedi bivangu ka bilendi baka bu tangulu ko ;</para>
  <para style="q1" vid="PSA 104:25">bima bimoyo bifioti ayi binneni.<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>Muawu mu nkuendilanga ayi vutukilanga masuwa ;</para>
  <para style="q1" vid="PSA 104:26">ayi Leviatani, bulu kioki wuvanga, muawu kieti sakinina.<verse eid="PSA 104:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>Bibioso bikutalanga muingi wuba vananga bidia biawu mu thangu yifuana.<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>Thangu weti kubivana bidia, bieti bonga biawu ;</para>
  <para style="q1" vid="PSA 104:28">ngeyo zibula koko kuaku, bieti yukuta mu bima bimboti.<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>Ngeyo sueka zizi kiaku, buna bieka mona tsisi.</para>
  <para style="q1" vid="PSA 104:29">Ngeyo biziona vumunu kiawu, buna bieti fua ayi bieti vutuka mu mbungi-mbungi.<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>Ngeyo fidisa vumunu kiaku, buna bivangimini</para>
  <para style="q1" vid="PSA 104:30">ayi ngeyo weti kitula diaka zizi ki ntoto kimona.<verse eid="PSA 104:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>Bika Nkembo wu Nzambi wuzingila mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 104:31">bika Yave kayangalala mu bisalu biandi !<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>Niandi wuntalanga ku ntoto, ayi ntoto wulembo titi.</para>
  <para style="q1" vid="PSA 104:32">Niandi wulembo simba miongo ayi milembo totula muisi.<verse eid="PSA 104:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>Ndiela yimbidilanga Yave mu luzingu luama loso.</para>
  <para style="q1" vid="PSA 104:33">Ndiela yimbidilanga Nzambi ama minzitusu thangu yoso yi luzingu luama.<verse eid="PSA 104:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>Bika mambu mama ndinyindula mammonisa khini</para>
  <para style="q1" vid="PSA 104:34">banga phila ndilembo muena khini mu Yave.<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>Vayi bika bankua masumu balalukusu va ntoto,</para>
  <para style="q1" vid="PSA 104:35">ayi bika batu bambimbi babika buela monika !</para>
  <para style="q1" vid="PSA 104:35">Zitisa Yave, a muelꞌama !</para>
  <para style="q1" vid="PSA 104:35">Bika Yave kazitusu !<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="cl">Minkunga 105</para>
  <para style="s1">Nzambi widi wukuikama</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1"/>Luvutudila Yave matondo, lutela dizina diandi !</para>
  <para style="q1" vid="PSA 105:1">Luzabikisa momo kavanga muidi makanda.<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>Lunyimbidila ; lunyimbidila minzitusu.</para>
  <para style="q1" vid="PSA 105:2">Luyolukila mavanga mandi moso matsiminanga.<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>Nkembo kuidi dizina diandi dinlongo ;</para>
  <para style="q1" vid="PSA 105:3">Bika mintima mi bobo bantombanga Yave mimona khini.<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>Talanu kuidi Yave ayi kuidi zingolo ziandi ;</para>
  <para style="q1" vid="PSA 105:4">Tombanganu mu zithangu zioso zizi kiandi.<verse eid="PSA 105:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5"/>Lutebukilanga moyo matsiminanga momo kavanga ;</para>
  <para style="q1" vid="PSA 105:5">bikumu biandi ayi zinzengolo ziozi kayamikisa ;<verse eid="PSA 105:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6"/>beno nkuna Abalahami, kisadi kiandi,</para>
  <para style="q1" vid="PSA 105:6">beno bana ba Yakobi, batu bandi kasobula !<verse eid="PSA 105:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>Yave niandi Nzambi eto ;</para>
  <para style="q1" vid="PSA 105:7">zinzengolo ziandi zidi va ntoto wumvimba.<verse eid="PSA 105:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>Wuntebukilanga moyo nguizani andi mu zithangu zioso,</para>
  <para style="q1" vid="PSA 105:8">mambu momo katumina mu mili di zitsungi.<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>Nguizani yoyi yi kawizana ayi Abalahami ;</para>
  <para style="q1" vid="PSA 105:9">ndefi yoyi kadila Izaki.<verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>Wukindisa yawu kuidi Yakobi banga nzengolo ;</para>
  <para style="q1" vid="PSA 105:10">kuidi Iseli banga nguizani mu zithangu zioso ;<verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>“Kuidi ngeyo ndiela vana ntoto wu Kana</para>
  <para style="q1" vid="PSA 105:11">banga kuku ki kiuka kioki wela tambula.”<verse eid="PSA 105:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>Buna bakidi thalu yi fioti kaka,</para>
  <para style="q1" vid="PSA 105:12">bafioti kuandi, banzenza mu tsi beni ;<verse eid="PSA 105:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13"/>vayi baba kuenda diengilanga mu makanda-makanda</para>
  <para style="q1" vid="PSA 105:13">tona mu kipfumu kimosi nate ku kipfumu kinkaka.<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>Kasia vana ko minsua kuidi kadi mutu wumosi mu kuba yamisa</para>
  <para style="q1" vid="PSA 105:14">mu diambu diawu wutemina mintinu.<verse eid="PSA 105:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15"/>“Kadi simba batu bama bobo ndivinda mafuta ;</para>
  <para style="q1" vid="PSA 105:15">kadi vangila mimbikuidi miama mambu mambimbi.”<verse eid="PSA 105:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>Wutumisa kanda kingolo va ntoto</para>
  <para style="q1" vid="PSA 105:16">ayi wubunga bidia biawu bioso balunda.<verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>Buna wufidisa mutu wumosi ku ntualꞌawu :</para>
  <para style="q1" vid="PSA 105:17">Zozefi wutekoso banga mvika.<verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>Bakanga malu mandi mu zisieni ;</para>
  <para style="q1" vid="PSA 105:18">batula dinga diandi mu bisengo<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>nate mambu makatuba mavioka ;</para>
  <para style="q1" vid="PSA 105:19">nate mambu ma Yave mamonisa ti makiedika katuba.<verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>Ntinu wufidisa ayi bannianguna ;</para>
  <para style="q1" vid="PSA 105:20">nyadi wu batu wunyekula mu kiphuanza.<verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>Wumbieka pfumu mu nzo andi</para>
  <para style="q1" vid="PSA 105:21">nyadi wu bima bioso biobi kavua,<verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>mu longa bana ba mintinu boso bu kazodidi</para>
  <para style="q1" vid="PSA 105:22">ayi vana nduenga kuidi bakulutu bandi.<verse eid="PSA 105:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>Buna Iseli wukota ku Ezipite ;</para>
  <para style="q1" vid="PSA 105:23">Yakobi wuzingila banga nzenza mu tsi yi Hami.<verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>Yave wuvanga ti batu bandi babutuka kuwombo</para>
  <para style="q1" vid="PSA 105:24">ayi wuba kitula batu bawombo viokila bobo baba lenda ;<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>bobo kabalula mintima mu lenda batu bandi,</para>
  <para style="q1" vid="PSA 105:25">mu kuendila bisadi biandi manenga.<verse eid="PSA 105:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>Wufidisa Moyize, kisadi kiandi,</para>
  <para style="q1" vid="PSA 105:26">ayi Aloni mutu wowo kasobula.<verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>Bavanga bidimbu biandi va khatitsikꞌawu,</para>
  <para style="q1" vid="PSA 105:27">matsiminanga mandi mu tsi Hami.<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>Wufidisa tombi ayi wutula tombi mu ntoto</para>
  <para style="q1" vid="PSA 105:28">bila basia tinguna ko mambu mandi e ?<verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>Wukitula minlangu miawu menga ;</para>
  <para style="q1" vid="PSA 105:29">wumana sikisa vonda zimbizi ziawu.<verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>Mintoto miawu miwala bisioto ;</para>
  <para style="q1" vid="PSA 105:30">biobi bikota nate mu bivinga bi minyadi miawu.<verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>Wutuba ayi kuyiza zinzinzi ziba mitsa</para>
  <para style="q1" vid="PSA 105:31">ayi zingungu mu tsi awu yoso.<verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>Niandi wubalula mvula mu mvula yi matadi</para>
  <para style="q1" vid="PSA 105:32">nzazi mu ntoto wumvimba.<verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>Wumana buisa minti miawu mi vinu ayi minti miawu mi figi,</para>
  <para style="q1" vid="PSA 105:33">ayi kelula minti mi tsi awu.<verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>Wutuba ayi makhoko mayiza ;</para>
  <para style="q1" vid="PSA 105:34">binzienzi bikambulu thalu.<verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>Bidia kadika kunusu kinlangu mu tsi awu ;</para>
  <para style="q1" vid="PSA 105:35">bidia mimbutu mi ntoto awu.<verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>Buna wumana vonda bana boso batheti mu tsi awu,</para>
  <para style="q1" vid="PSA 105:36">mimbutu mioso mitheti mi zingolo ziawu.<verse eid="PSA 105:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>Wutotula Iseli va kimosi ayi mfuna wu palata ayi nolo ;</para>
  <para style="q1" vid="PSA 105:37">ayi kusia monika ko mutu wumemata mu zimvila ziawu.<verse eid="PSA 105:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38"/>Ezipite yimona khini bubayenda</para>
  <para style="q1" vid="PSA 105:38">bila tsisi yi Iseli yiba buila.<verse eid="PSA 105:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>Wuyalumuna matuti mu diambu di kuba fuka</para>
  <para style="q1" vid="PSA 105:39">ayi mbazu mu kuba kienzula va builu.<verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>Balomba ayi wuba fidisila zinuni</para>
  <para style="q1" vid="PSA 105:40">ayi wuba yukutisa mu mapha ma diyilu.<verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>Wuzibula ditadi ayi nlangu wutotuka ;</para>
  <para style="q1" vid="PSA 105:41">banga nlangu wunneni wukumba mu dikanga.<verse eid="PSA 105:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>Bila wutebukila moyo tsilꞌandi yinlongo</para>
  <para style="q1" vid="PSA 105:42">yoyi kavana kuidi Abalahami, kisadi kiandi.<verse eid="PSA 105:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>Wutotudila batu bandi mu khini</para>
  <para style="q1" vid="PSA 105:43">batu bandi bobo kasobula mu biyoko bi mayangi.<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>Wuba vana mintoto mi makanda,</para>
  <para style="q1" vid="PSA 105:44">ayi batambula kiuka kisala batu bankaka.<verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>Muingi balunda minsiku miandi</para>
  <para style="q1" vid="PSA 105:45">ayi bakinzika Mina miandi.</para>
  <para style="q1" vid="PSA 105:45">Luzitisa Yave.<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="cl">Minkunga 106</para>
  <para style="s1">Enati tuisi bakuikama ko, vayi Nzambi widi kaka wukuikama.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1"/>Luzitisa Yave,</para>
  <para style="q1" vid="PSA 106:1">luvutudila Yave matondo bila widi wumboti,</para>
  <para style="q1" vid="PSA 106:1">luzolo luandi lunzingila mu zithangu zioso.<verse eid="PSA 106:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>Nani wulenda yamikisa mavanga ma lulendo ma Yave ?</para>
  <para style="q1" vid="PSA 106:2">Voti samuna nzitusu andi woso e ?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>Lusakumunu kuidi bobo basimbididi busonga ;</para>
  <para style="q1" vid="PSA 106:3">bobo beti vanga mambu ma lulama mu zithangu zioso.<verse eid="PSA 106:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>Wuthebukila moyo, a Yave, mu thangu wumvangila batu baku mamboti</para>
  <para style="q1" vid="PSA 106:4">wiza wutsadisa mu thangu wela kubavukisa,<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>muingi ndibaka bu muena khini mu mamboti ma batu baku bobo wusobula ;</para>
  <para style="q1" vid="PSA 106:5">muingi ndibaka bukabudila khini ayi batu baku ;</para>
  <para style="q1" vid="PSA 106:5">ayi muingi ndifubakana va kimosi ayi kiuka kiaku mu kuvananga nzitusu.<verse eid="PSA 106:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>Tuvola masumu banga buvodila madise meto ;</para>
  <para style="q1" vid="PSA 106:6">beto tuvanga mambimbi ayi mavanga mambimbi.<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>Thangu madise meto baba ku Ezipite,</para>
  <para style="q1" vid="PSA 106:7">basia ba ko kadi mayindu mu bikumu biaku ;</para>
  <para style="q1" vid="PSA 106:7">basia tebukila ko moyo woka ku mamboti maku</para>
  <para style="q1" vid="PSA 106:7">vayi baba bankua matingu va ndambu mbu,</para>
  <para style="q1" vid="PSA 106:7">va ndambu mbu wu mbuaki.<verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>Vayi wuba vukisa mu diambu di nkembo wu dizina diandi</para>
  <para style="q1" vid="PSA 106:8">mu monisa lulendo luandi.<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>Wutemina mbu wu mbuaki, buna wawu wuyuma ;</para>
  <para style="q1" vid="PSA 106:9">wuba diatisa mu dibulu dinneni banga mu dikanga.<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>Wuba vukisa mu koko ku mutu wowo wu balenda ;</para>
  <para style="q1" vid="PSA 106:10">wuba kula mu koko ku bambeni.<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>Minlangu midiamisa bambeni ziawu ;</para>
  <para style="q1" vid="PSA 106:11">kadi wumosi kasia siala wumoyo ko.<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>Buna bawilukila zitsila ziandi</para>
  <para style="q1" vid="PSA 106:12">ayi bayimbila minzitusu miandi.<verse eid="PSA 106:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>Vayi mu nsualu bavika zimbakana momo kavanga,</para>
  <para style="q1" vid="PSA 106:13">ayi basia tadidila zindongi ziandi ko.<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>Mu dikanga, bakiyekula mu zinzinunu ziawu ;</para>
  <para style="q1" vid="PSA 106:14">va buangu kikambulu batu, batota Nzambi.<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>Buna wuba vana biobi balomba ;</para>
  <para style="q1" vid="PSA 106:15">ayi wubafidisila ziphasi.<verse eid="PSA 106:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>Bavangila Moyize kiphala ayi Aloni ku ka,</para>
  <para style="q1" vid="PSA 106:16">mutu wowo Yave kabieka nlongo.<verse eid="PSA 106:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17"/>Ntoto wuzibuka ayi wumina Datani ;</para>
  <para style="q1" vid="PSA 106:17">ayi wufuka dikabu di batu ba Abilami<verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>Mbazu yilema va khatitsika batu baba kubakuka,</para>
  <para style="q1" vid="PSA 106:18">nlaki wu mbazu wuzinisa batu bambimbi.<verse eid="PSA 106:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>Ku Holebi, bavanga muana ngombi ;</para>
  <para style="q1" vid="PSA 106:19">ayi babuongimina tumba kivangulu mu suitisa sengo.<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>Baviakisa nkembo awu mu mfikula yi ngombi yeti dia biti<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>Bazimbakana Nzambi, mutu wubavukisa,</para>
  <para style="q1" vid="PSA 106:21">mutu wuvanga mambu manneni mu Ezipite,<verse eid="PSA 106:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22"/>bikumu mu tsi Hami</para>
  <para style="q1" vid="PSA 106:22">ayi mambu ma tsisi va ndambu mbu wu mbuaki.<verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>Buna wutuba ti wukana ku babunga ;</para>
  <para style="q1" vid="PSA 106:23">enati kambu Moyize, mutu andi wukasobula,</para>
  <para style="q1" vid="PSA 106:23">wutelama mu diambu di kuba sambildila va ntualꞌandi</para>
  <para style="q1" vid="PSA 106:23">mu diambu di kakidila miangu miandi mi ngolo muingi kabika ku babunga.<verse eid="PSA 106:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>Buna balenza tsi yi makhini,</para>
  <para style="q1" vid="PSA 106:24">basia wilukila ko tsilꞌandi.<verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>Baniunguta mu zinzo ziawu zi ngoto ;</para>
  <para style="q1" vid="PSA 106:25">ayi basia tumukina ko Yave.<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>Buna wuvumuna koko kuandi mu leva ndefi mu diambu diawu</para>
  <para style="q1" vid="PSA 106:26">ti wela kuba buisa mu dikanga ;<verse eid="PSA 106:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27"/>ti wela buisa nkunꞌawu va khatitsika makanda ;</para>
  <para style="q1" vid="PSA 106:27">ayi wela kuba sasikisa mu yenda ntoto.<verse eid="PSA 106:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>Bakiyekula bawu veka kuidi Bali-Pewoli</para>
  <para style="q1" vid="PSA 106:28">ayi badia makaba matambuku kuidi zinzambi zikambulu moyo.<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>Basoka Yave muingi kafuema mu diambu di mavanga mawu mambimbi,</para>
  <para style="q1" vid="PSA 106:29">ayi nsongo wutotuka va khatitsikꞌawu.<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>Buna Pineyasi wutelama ayi wuvuata nsamu ;</para>
  <para style="q1" vid="PSA 106:30">buna nsongo wutumbu manisa.<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>Buna bantangila diawu banga busonga</para>
  <para style="q1" vid="PSA 106:31">mu zitsungi zinkuiza zikambulu tsukulu.<verse eid="PSA 106:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>Ku minlangu mi Meliba, bafuemisa Yave ;</para>
  <para style="q1" vid="PSA 106:32">buna ziphasi zibuila Moyize mu diambu diawu.<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>Bila batinguna Pheve yi Nzambi</para>
  <para style="q1" vid="PSA 106:33">ayi mambu makambulu fuana matotukila mu bididi bi Moyize.<verse eid="PSA 106:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>Basi bunga ko batu</para>
  <para style="q1" vid="PSA 106:34">boso bubela lutumunu lu Yave.<verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>Vayi bafubakana ayi makanda mankaka</para>
  <para style="q1" vid="PSA 106:35">ayi balonguka kikhulu ki makanda beni.<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>Babuongimina bitumba biawu,</para>
  <para style="q1" vid="PSA 106:36">biawu bikituka ntambu kuidi bawu.<verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>Batambika bana bawu bababakala</para>
  <para style="q1" vid="PSA 106:37">ayi babaketo kuidi ziphevi zimbimbi.<verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>Batengula menga ma batu bakambulu zaba diambu ;</para>
  <para style="q1" vid="PSA 106:38">menga ma bana bawu bababakala ayi babaketo</para>
  <para style="q1" vid="PSA 106:38">mawu batambika kuidi bitumba bi Kana.</para>
  <para style="q1" vid="PSA 106:38">Buna ntoto wusumuka mu diambu di menga mawu.<verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>Bakisumuna bawu veka mu momo bavanga,</para>
  <para style="q1" vid="PSA 106:39">mu mavanga mawu, ba ta kitsuza bawu veka.<verse eid="PSA 106:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>Muaki Yave wufuemina batu bandi</para>
  <para style="q1" vid="PSA 106:40">ayi wukakumukina kiuka kiandi.<verse eid="PSA 106:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>Wuba yekula kuidi makanda</para>
  <para style="q1" vid="PSA 106:41">ayi bobo baba lenda babayadila.<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>Bambeni bawu ziba yamisa</para>
  <para style="q1" vid="PSA 106:42">ayi batulu ku tsi lulendo luawu.<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>Zikhumbu ziwombo kaba kudila</para>
  <para style="q1" vid="PSA 106:43">vayi baba kaka bankua matingu</para>
  <para style="q1" vid="PSA 106:43">ayi bakibivisa mu masumu mawu.<verse eid="PSA 106:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>Vayi wubela ziphasi ziawu mayindu</para>
  <para style="q1" vid="PSA 106:44">thangu kawa yamikina kuawu.<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>Mu bila kiawu, wutebukila nguizani andi moyo ;</para>
  <para style="q1" vid="PSA 106:45">ayi mu luzolo luandi lunneni wubalula lukanu.<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>Niandi wuvanga ti bamueno kiadi</para>
  <para style="q1" vid="PSA 106:46">kuidi bobo baba nata mu kivika.<verse eid="PSA 106:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>Wutuvukisa, a Yave, Nzambi eto ;</para>
  <para style="q1" vid="PSA 106:47">ayi wutukutikisa tona ku makanda</para>
  <para style="q1" vid="PSA 106:47">muingi tubaka buvutudila dizina diaku dinlongo matondo</para>
  <para style="q1" vid="PSA 106:47">ayi nkembo mu nzitusu aku.<verse eid="PSA 106:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>Yave kazitusu, Nzambi yi Iseli !</para>
  <para style="q1" vid="PSA 106:48">Mu zithangu zioso ayi mu mvu ka mvu.</para>
  <para style="q1" vid="PSA 106:48">Bika batu boso batuba : “Amen.”</para>
  <para style="q1" vid="PSA 106:48">Luzitisa Yave.<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">BUKU YI NTANU</para>
  <para style="cl">Minkunga 107</para>
  <para style="s1">Nkunga wu batu bakulu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>Luvutudila Yave matondo bila niandi widi wumboti ;</para>
  <para style="q1" vid="PSA 107:1">Luzolo luandi lunzingila mu zithangu zioso.<verse eid="PSA 107:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>Bika bobo bakulu kuidi Yave batuba buawu ;</para>
  <para style="q1" vid="PSA 107:2">bobo kakula mu koko ku batu bobo babalenda,<verse eid="PSA 107:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3"/>bobo kakutikisa tona ku mintoto,</para>
  <para style="q1" vid="PSA 107:3">tona ku esite ayi ku wesite ; tona ku node ayi ku sude.<verse eid="PSA 107:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>Bankaka baba diengilanga mu dikanga, buangu bikambulu batu ;</para>
  <para style="q1" vid="PSA 107:4">basia baka ko nzila yikotila mu divula diodi balenda vuandila.<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>Bamona nzala ayi phuila ;</para>
  <para style="q1" vid="PSA 107:5">ayi luzingu luawu luba nduka mu suka.<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>Buna bayamikina kuidi Yave mu ziphasi ziawu</para>
  <para style="q1" vid="PSA 107:6">ayi niandi wuba kula mu kiadi kiawu.<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>Niandi wuba diatisa mu nzila yisonga</para>
  <para style="q1" vid="PSA 107:7">mu diambu di kuenda ku divula diodi balenda baka bu vuandila.<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>Bika bavutudila Yave matondo mu diambu di luzolo luandi lu ngolo</para>
  <para style="q1" vid="PSA 107:8">ayi mu diambu di mavanga mandi matsiminanga momo kavangila batu.<verse eid="PSA 107:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>Bila wumanisa phuila</para>
  <para style="q1" vid="PSA 107:9">ayi wuyukutisa mutu wuba nzala mu bima bi mboti.<verse eid="PSA 107:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>Bankaka baba vuandanga mu tombi ayi ku tsi tombi ki nkobo ;</para>
  <para style="q1" vid="PSA 107:10">baba bakangama mu ziphasi zisieni zi sengo.<verse eid="PSA 107:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11"/>Bila batinguna mambu ma Nzambi,</para>
  <para style="q1" vid="PSA 107:11">ayi balenza zindongi zi Nzambi Yizangama.<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>Diawu kaba yekudila ku tsi kisalu ki ngolo ;</para>
  <para style="q1" vid="PSA 107:12">babumina thutu ayi kuisi ba ko kadi mutu mu ku basadisa.<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>Buna bayamikina kuidi Yave mu ziphasi ziawu</para>
  <para style="q1" vid="PSA 107:13">ayi niandi wuba vukisa mu kiadi kiawu.<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>Wuba totula mu tombi ayi ku tsi tombi ki nkobo</para>
  <para style="q1" vid="PSA 107:14">ayi wukelula zisieni ziawu.<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>Bika bavutudila Yave matondo mu diambu di luzolo luandi lu ngolo</para>
  <para style="q1" vid="PSA 107:15">ayi mu diambu di mavanga mandi matsiminanga momo kavangila batu<verse eid="PSA 107:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>Bila wutiolumuna mielo mi palata</para>
  <para style="q1" vid="PSA 107:16">ayi wukesumuna bisengo binzibukulungu mielo.<verse eid="PSA 107:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>Bankaka bakituka bivungisi mu zinzila ziawu zi matingu</para>
  <para style="q1" vid="PSA 107:17">ayi ziphasi mu diambu di mambimbi mawu.<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>Bakakumukina bidia bioso</para>
  <para style="q1" vid="PSA 107:18">ayi bafikama mielo mi lufua.<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>Buna bayamikina kuidi Yave mu ziphasi ziawu</para>
  <para style="q1" vid="PSA 107:19">ayi niandi wuba vukisa mu kiadi kiawu.<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>Wufidisa mambu mandi ayi wuba belusa,</para>
  <para style="q1" vid="PSA 107:20">wuba kula mu tsi bafua.<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>Bika bavutudila Yave matondo mu diambu di luzolo luandi lu ngolo</para>
  <para style="q1" vid="PSA 107:21">ayi mu diambu di mavanga mandi matsiminanga momo kavangila batu.<verse eid="PSA 107:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>Bika batambika makaba ma phutudulu matondo</para>
  <para style="q1" vid="PSA 107:22">ayi bayolukila bisalu biandi mu minkunga mi khini.<verse eid="PSA 107:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>Bankaka bayendila va mbu mu masuwa,</para>
  <para style="q1" vid="PSA 107:23">baba minkiti mu minlangu minneni,<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>bamona bisalu bi Yave,</para>
  <para style="q1" vid="PSA 107:24">mavanga mandi matsiminanga va ngingi nlangu.<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>Bila wuyoluka ayi wutotula vuka kingolo,</para>
  <para style="q1" vid="PSA 107:25">kioki kivumuna mayo.<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>Bakuma ku yilu ayi bakuluka ti kuna tsi ;</para>
  <para style="q1" vid="PSA 107:26">mu mabienga mawu, bukhafi buawu buzimbala.<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>Balembo balumuka ayi bulangana mu diata banga batu bakololo malavu</para>
  <para style="q1" vid="PSA 107:27">diela diawu dimanisa.<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>Buna bayamikina kuidi Yave mu ziphasi ziawu</para>
  <para style="q1" vid="PSA 107:28">ayi niandi wuba vukisa mu kiadi kiawu.<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>Wudigimisa vuka kingolo mu manuinguta,</para>
  <para style="q1" vid="PSA 107:29">mayo ma mbu madingalala.<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>Bamona khini thangu ndembama yivutuka</para>
  <para style="q1" vid="PSA 107:30">ayi Yave wuba nata ku disimu dibazola kuenda.<verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>Bika bavutudila Yave matondo mu diambu di luzolo luandi lu ngolo</para>
  <para style="q1" vid="PSA 107:31">ayi mu diambu di mavanga mandi matsiminanga momo kavangila batu.<verse eid="PSA 107:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>Bika banyayisa mu lukutukunu lu batu</para>
  <para style="q1" vid="PSA 107:32">ayi bika banzitisa mu dikabu di bakulutu.<verse eid="PSA 107:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>Wukitula minlangu minneni makanga</para>
  <para style="q1" vid="PSA 107:33">ayi zitho zinkumba mintoto mi yuma ;<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>ayi ntoto widi mbozi mu ntoto widi tsalu</para>
  <para style="q1" vid="PSA 107:34">mu diambu di mambimbi ma bobo bazingila muna.<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>Wukitula dikanga mu bibuindi bi nlangu</para>
  <para style="q1" vid="PSA 107:35">ayi ntoto wuyuma mu zitho zinkumba ;<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>Kuna kanata nzala muingi yizingila</para>
  <para style="q1" vid="PSA 107:36">ayi batunga divula diodi balenda vuanda ;<verse eid="PSA 107:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37"/>Bakuna zitsola ayi zindima zi vinu</para>
  <para style="q1" vid="PSA 107:37">ziozi zieti buta mimbutu mimbozi.<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>Wuba sakumuna ayi thalu awu yiwombo yi buelama</para>
  <para style="q1" vid="PSA 107:38">ayi kasia tala ko ti bibulu biawu bidekuka.<verse eid="PSA 107:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>Buna thalu awu yidekuka ayi bafua tsoni</para>
  <para style="q1" vid="PSA 107:39">mu diambu di khuamusu, mabienga ayi maniongo.<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>Niandi wulembo lenzi batu banneni,</para>
  <para style="q1" vid="PSA 107:40">wulembo badiengisa mu dikanga mu kambulu nzila.<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>Vayi weti totula nsukami mu ziphasi ziandi</para>
  <para style="q1" vid="PSA 107:41">ayi weti wokisa makanda mawu banga minkangu mi mamemi.<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>Batu balulama mu mintima balembo moni ayi balembo yangalala</para>
  <para style="q1" vid="PSA 107:42">vayi batu boso bambimbi bazibikidi miunu miawu.<verse eid="PSA 107:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>Woso mutu widi nduenga bika kakeba mambu mama</para>
  <para style="q1" vid="PSA 107:43">ayi kasudika luzolo lunneni lu Yave.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="cl">Minkunga 108</para>
  <para style="s1">Ndiela nunga</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1"/>Ntimꞌama widi wukinda, a Nzambi.</para>
  <para style="q1" vid="PSA 108:1">Ndiela yimbila ayi ndiela bula miziki mu muelꞌama woso.<verse eid="PSA 108:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>Kotukanu beno ngitala ayi Lila ;</para>
  <para style="q1" vid="PSA 108:2">ndiela kotula khiesa buisa.<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>Ndiela kuzitisa, a Yave, va khatitsika makanda,</para>
  <para style="q1" vid="PSA 108:3">ndiela kuyimbidila va khatitsika batu<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>Bila luzolo luaku luidi lunneni, luidi luzangama viokila diyilu</para>
  <para style="q1" vid="PSA 108:4">kikhuikizi kiaku kieti tula nate ku matuti.<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>Yayusu kuaku, a Nzambi, ku yilu diyilu</para>
  <para style="q1" vid="PSA 108:5">ayi bika nkembo aku wuba va ntoto wumvimba ;<verse eid="PSA 108:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>Wutuvukisa ayi wutusadisa mu koko kuaku ku lubakala</para>
  <para style="q1" vid="PSA 108:6">muingi bobo weti zola bakulu.<verse eid="PSA 108:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>Nzambi wutuba tona ku buangu kiandi kinlongo :</para>
  <para style="q1" vid="PSA 108:7">“mu ndungunu, ndiela vasa Sikemi</para>
  <para style="q1" vid="PSA 108:7">ayi ndiela teza ndimba wu Sikoti.<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>Minu phuidi Galadi, minu phuidi Manase ;</para>
  <para style="q1" vid="PSA 108:8">Efalayimi wawu nkaku wu ntu ama</para>
  <para style="q1" vid="PSA 108:8">Yuda nkawꞌama wu kipfumu.<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>Mowabi diawu dibola diodi ndieti yobidila.</para>
  <para style="q1" vid="PSA 108:9">Va yilu Edomi ndiloza zisandale ziama,</para>
  <para style="q1" vid="PSA 108:9">ndiela yamikina mu diambu di ndungunu ama mu basi Filisiti.”<verse eid="PSA 108:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>Nani wela kundata ku divula dikindusu ngolo e ?</para>
  <para style="q1" vid="PSA 108:10">Nani wela kuthuadisa ku Edomi e ?<verse eid="PSA 108:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>Keti ngeyo, a Nzambi, ngeyo wutuloza,</para>
  <para style="q1" vid="PSA 108:11">ngeyo wunkambu buela totukanga ayi minkangu mi masodi meto e ?<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>Wutuvana lusadusu va ntuala mbeni</para>
  <para style="q1" vid="PSA 108:12">bila lusadusu lu mutu luidi lu phamba.<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>Va kimosi ayi Nzambi, tuela tunga</para>
  <para style="q1" vid="PSA 108:13">ayi wela kosikisa bambeni zieto.<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="cl">Minkunga 109</para>
  <para style="s1">A Nzambi, kadi buela dingalala.</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1"/>A Nzambi, mutu wowo ndieti zitisa</para>
  <para style="q1" vid="PSA 109:1">bika dingalala.<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>Bila batu bambimbi ayi batu bansadilanga bukhita</para>
  <para style="q1" vid="PSA 109:2">bazibudi miunu miawu mu diambu diama.</para>
  <para style="q1" vid="PSA 109:2">Balembo tubi mu diambu diama mu ludimi lu luvunu.<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>Mu mambu ma kikhenene, banzungididi</para>
  <para style="q1" vid="PSA 109:3">ayi balembo nduanisa mu kambu bila.<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>Mu kikundi kiama, balembo mfundi</para>
  <para style="q1" vid="PSA 109:4">vayi minu ndidi mutu wu lusambulu.<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>Baphutudidi mambimbi mu mamboti</para>
  <para style="q1" vid="PSA 109:5">ayi bandendidi mu diambu di kikundi kiama.<verse eid="PSA 109:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>Sobula mutu wumbimbi mu diambu kakba mbeni andi ;</para>
  <para style="q1" vid="PSA 109:6">bika mfundi katelama va koko kuandi ku lubakala.<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>Mu thangu kela samba, bika kaba monika mu nzimbala</para>
  <para style="q1" vid="PSA 109:7">ayi bika lusambulu luandi lumbedisa.<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>Bika bilumbu biandi bikituka bifioti.</para>
  <para style="q1" vid="PSA 109:8">Bika mutu wunkaka kabonga buangu kiandi ki kintuadisi.<verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>Bika bana bandi baba bana basana ;</para>
  <para style="q1" vid="PSA 109:9">ayi nketo andi difuola.<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>Bika bana bandi baba mindiengidi mikuenda lombingi ;</para>
  <para style="q1" vid="PSA 109:10">bika baba kuka mu zinzo ziawu zitiolumuka.<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>Bika mutu wowo weti devisa kabonga bima bioso biobi kavuidi ;</para>
  <para style="q1" vid="PSA 109:11">bika banzenza baziona mu kingolo mimbutu mi kisalu kiandi.<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>Bika kubika ba mutu wulenda kumvangila mamboti</para>
  <para style="q1" vid="PSA 109:12">voti monina bana bandi basana kiadi.<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>Bika nkunꞌandi wulalakana ;</para>
  <para style="q1" vid="PSA 109:13">mazina mawu makubulu mu tsungi yinkuiza.<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>Bika mambimbi ma bakulu bandi matebukulungu moyo va ntuala Yave,</para>
  <para style="q1" vid="PSA 109:14">bika disumu di ngudi andi dibika kubulu.<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>Bika masumu mawu mazingila mu zithangu zioso va ntuala Yave</para>
  <para style="q1" vid="PSA 109:15">muingi kalalikisa thebukulu awu moyo va ntoto.<verse eid="PSA 109:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>Bila kalendi yindula mu vanga mamboti ko,</para>
  <para style="q1" vid="PSA 109:16">vayi wuyamisa nsukami nate ku lufua ;</para>
  <para style="q1" vid="PSA 109:16">ayi nkua kiadi ayi mutu wuba ntima wukosakana.<verse eid="PSA 109:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>Niandi wuzola singa ; bika yimbuila,</para>
  <para style="q1" vid="PSA 109:17">kamonanga khini ko mu lusakumunu</para>
  <para style="q1" vid="PSA 109:17">bika luawu luba thama ayi niandi<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>Wuvuata tsingulu banga nledi andi ;</para>
  <para style="q1" vid="PSA 109:18">yawu yikota mu khati nitu andi banga nlangu,</para>
  <para style="q1" vid="PSA 109:18">mu mimvesi miandi banga mafuta.<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>Bika yawu yikituka banga yunga kioki kakukifukila ;</para>
  <para style="q1" vid="PSA 109:19">banga nsinga luketo wowo keti vuata mu zithangu zioso.<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>Bika buawu bobo bubela mfutu wu Yave kuidi mimfundi miama ;</para>
  <para style="q1" vid="PSA 109:20">kuidi bobo bantubanga mambu mambimbi mu diambu diama.<verse eid="PSA 109:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>Vayi ngeyo Yave, mutu wumvanganga mawu zodidi,</para>
  <para style="q1" vid="PSA 109:21">wuphangila mamboti mu diambu di dizina diaku ;</para>
  <para style="q1" vid="PSA 109:21">ka diambu ko mamboti ma luzolo luaku madi, bika wukhula.<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>Ndidi nkua kiadi ayi nsukami</para>
  <para style="q1" vid="PSA 109:22">ayi ntimꞌama widi wuluala mu minu.<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>Ndieka lalakana banga kitsusula va masika ;</para>
  <para style="q1" vid="PSA 109:23">bakhukidi banga makhoko.<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>Makuma mama malembo bulangama</para>
  <para style="q1" vid="PSA 109:24">mu kukifuisanga nzala mu diambu di lusambulu ;</para>
  <para style="q1" vid="PSA 109:24">nitu ama yidi yifioti ayi yikonda.<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>Minu ndieka diambu di mvuezolo kuidi mimfundi miama ;</para>
  <para style="q1" vid="PSA 109:25">bawu kumbona, balembo nikuna mintu miawu.<verse eid="PSA 109:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>Wutsadisa, a Yave, Nzambi ama ;</para>
  <para style="q1" vid="PSA 109:26">wuphukisa boso buididi luzolo luaku.<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>Bika bazaba ti koko kuaku ;</para>
  <para style="q1" vid="PSA 109:27">ti ngeyo Yave wuvanga buawu.<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>Bawu balembo singi vayi ngeyo wela sakumuna.</para>
  <para style="q1" vid="PSA 109:28">Bu batelimini mu diambu di nuanisa, bela fua tsoni</para>
  <para style="q1" vid="PSA 109:28">vayi kisadi kiaku kiela mona khini.<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>Mimfundi miama milendi vuata nzitusu ko</para>
  <para style="q1" vid="PSA 109:29">ayi miela fukudulu tsoni banga yunga.<verse eid="PSA 109:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>Mu munu ama, ndiela yayisa ngolo Yave ;</para>
  <para style="q1" vid="PSA 109:30">Mu nkangu wunneni wu batu, ndiela kunzitisa.<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>Bila niandi wuntelamanga va koko ku lubakala lu nsukami</para>
  <para style="q1" vid="PSA 109:31">mu diambu di vukisa luzingu luandi mu mioko mi bobo bakunzengilanga nkanu.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="cl">Minkunga 110</para>
  <para style="s1">Niandi widi va kimosi ntinu ayi nganga Nzambi</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1"/>Yave wutuba kuidi Pfumu ama :</para>
  <para style="q1" vid="PSA 110:1">“Vuanda va koko kuama ku lubakala</para>
  <para style="q1" vid="PSA 110:1">nate ndikitula bambeni ziaku kima kioki</para>
  <para style="q1" vid="PSA 110:1">beti tetika malu mu diambu di malu maku.”<verse eid="PSA 110:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>Yave wela nonuna nkawa aku wu lulendo wu kipfumu tona ku Sioni ;</para>
  <para style="q1" vid="PSA 110:2">wela yadila va khatitsika bambeni ziaku.<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>Minkangu miaku mi masodi miela ba luzolo lumboti ;</para>
  <para style="q1" vid="PSA 110:3">mu lumbu kiaku ki mvita</para>
  <para style="q1" vid="PSA 110:3">bavuata nzitusu wunlongo</para>
  <para style="q1" vid="PSA 110:3">tona mu khiesa buisi</para>
  <para style="q1" vid="PSA 110:3">wela tambula bimi bi bumuana buaku.<verse eid="PSA 110:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>Yave wuzenga ndefi, kalendi viakisa mayindu mandi ko :</para>
  <para style="q1" vid="PSA 110:4">“ngeyo widi nganga Nzambi mu zithangu zioso</para>
  <para style="q1" vid="PSA 110:4">mu ntanda wu Meleshisedeki.”<verse eid="PSA 110:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>Yave widi va koko kuaku ku lubakala ;</para>
  <para style="q1" vid="PSA 110:5">wela kosikisa mintinu mu lumbu ki miangu miandi mi ngolo.<verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>Wela sambisa makanda, kupikisa bafua</para>
  <para style="q1" vid="PSA 110:6">Niandi wela kosikisa minyadi va ntoto wumvimba.<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>Niandi wela nua nlangu wu mvuila mu ndambu nzila,</para>
  <para style="q1" vid="PSA 110:7">diawu kela vumbudila ngolo ntu andi.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="cl">Minkunga 111</para>
  <para style="s1">Wuvanga matsiminanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1"/>Luzitisa Yave !</para>
  <para style="q1" vid="PSA 111:1">Ndiela yayisa Yave mu ntimꞌama wumvimba,</para>
  <para style="q1" vid="PSA 111:1">mu dikabu di batu balulama ayi mu lukutukunu lu batu.<verse eid="PSA 111:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>Mavanga ma Yave madi manneni,</para>
  <para style="q1" vid="PSA 111:2">meti yindulu kuidi bobo beti kumazola.<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>Mavanga mandi madi ma nkembo ayi ma nzitusu</para>
  <para style="q1" vid="PSA 111:3">ayi busonga buandi bunzingilanga mu zithangu zioso.<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>Niandi wuvanga ti matsiminanga mandi matebukulukungu moyo.</para>
  <para style="q1" vid="PSA 111:4">Yave widi nkua nlemvo ayi nkua kiadi.<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>Niandi weti vana bidia kuidi bobo beti kunkinzika ;</para>
  <para style="q1" vid="PSA 111:5">wuntebukilanga moyo Nguizani andi mu zithangu zioso.<verse eid="PSA 111:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>Wumonisa batu bandi lulendo lu bisalu biandi ;</para>
  <para style="q1" vid="PSA 111:6">bu kaba vana mintoto mi makanda mankaka.<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>Bisalu bi mioko miandi bidi kikhuikizi ayi busonga ;</para>
  <para style="q1" vid="PSA 111:7">minsiku miandi mioso mifueni mu tudulu diana,<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>mikindusu mu zithangu zioso ayi mu kadika mvu ;</para>
  <para style="q1" vid="PSA 111:8">mivangulu mu kikhuikizi ayi mu bufuana.<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>Niandi wuvana khudulu kuidi batu bandi ;</para>
  <para style="q1" vid="PSA 111:9">niandi wutumina nguizani andi mu zithangu zioso.</para>
  <para style="q1" vid="PSA 111:9">Dizina diandi didi dinlongo ayi tsisi didi.<verse eid="PSA 111:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>Kinzika Yave yawu thonono yi nduenga,</para>
  <para style="q1" vid="PSA 111:10">Babo bobo beti landakana minsiku miandi babeki diela dimboti.</para>
  <para style="q1" vid="PSA 111:10">Niandi vuidi nzitusu mu zithangu zioso.<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="cl">Minkunga 112</para>
  <para style="s1">Mamboti ma mikhuikizi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1"/>Luzitisa Yave !</para>
  <para style="q1" vid="PSA 112:1">Lusakumunu kuidi mutu wowo weti kinzika Yave ;</para>
  <para style="q1" vid="PSA 112:1">wowo weti mona khini mu zithumunu ziandi.<verse eid="PSA 112:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>Bana bandi bela ba lulendo va ntoto ;</para>
  <para style="q1" vid="PSA 112:2">Tsungi yi batu balulama yela sakumunu.<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>Bima biwombo ayi kimvuama bidi mu nzo andi</para>
  <para style="q1" vid="PSA 112:3">ayi busonga buandi bunzingilanga mu zithangu zioso.<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>Ka diambu ko mu tombi, kiezila kieti kienzuka mu diambu di batu balulama mu mintima ;</para>
  <para style="q1" vid="PSA 112:4">mu diambu di nkua nlemvo ayi nkua kiadi ayi mutu wusonga.<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>Mamboti mela kuiza kuidi mutu wowo wunkabulanga mu luzolo</para>
  <para style="q1" vid="PSA 112:5">ayi wundevisanga mu kambu kuiku ;</para>
  <para style="q1" vid="PSA 112:5">ayi wundiatisanga bisalu biandi mu busonga.<verse eid="PSA 112:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>Bukiedika kalendi nikuka ko ;</para>
  <para style="q1" vid="PSA 112:6">mutu wusonga wela tebukulungu moyo mu zithangu zioso.<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>Kalendi mona zitsangu zimbimbi tsisi ko.</para>
  <para style="q1" vid="PSA 112:7">Ntimꞌandi widi wukinda, wuntulanga diana mu Yave.<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>Ntimꞌandi widi mu luvovomo, kalendi mona tsisi ko</para>
  <para style="q1" vid="PSA 112:8">ku tsuka wela nunga mu tala batu bobo beti kunlenda.<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>Wunkabulanga mu zindambu zioso makaba mu diambu di nsukami ;</para>
  <para style="q1" vid="PSA 112:9">busonga buandi bunzingilanga mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 112:9">phokꞌandi yela vumbulu ngolo mu nzitusu.<verse eid="PSA 112:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>Mutu wumbimbi wela bumona ayi wela fuema ;</para>
  <para style="q1" vid="PSA 112:10">wela kueta meno ayi wela lalakana.</para>
  <para style="q1" vid="PSA 112:10">Zikhanu zi mutu wumbimbi ziela kituka ziphamba.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="cl">Minkunga 113</para>
  <para style="s1">Nzambi yoyi yilendi dedokoso ko</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1"/>Nkembo kuidi Yave !</para>
  <para style="q1" vid="PSA 113:1">Luzitisa Yave</para>
  <para style="q1" vid="PSA 113:1">luzitisa beno bisadi bi Yave ;</para>
  <para style="q1" vid="PSA 113:1">luzitisa dizina di Yave.<verse eid="PSA 113:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>Bika dizina di Yave dizitusu</para>
  <para style="q1" vid="PSA 113:2">tona buabu nate mu zithangu zioso ;<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>Bika dizina di Yave dizitusu</para>
  <para style="q1" vid="PSA 113:3">tona kuntotukilanga thangu nate ku buangu yeti diamina.<verse eid="PSA 113:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>Yave widi wuyayusu ku yilu makanda moso,</para>
  <para style="q1" vid="PSA 113:4">nkembo andi ku mbata diyilu.<verse eid="PSA 113:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>Nani dedikini banga Yave, Nzambi, eto</para>
  <para style="q1" vid="PSA 113:5">niandi wutula kundu kiandi ki kipfumu ku yilu<verse eid="PSA 113:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6"/>mutu wowo weti yinama mu tala diyilu ayi ntoto e ?<verse eid="PSA 113:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>Weti totula nsukami mu mbungi-mbungi ;</para>
  <para style="q1" vid="PSA 113:7">ayi niandi weti vumbula nkua kiadi mu dikuka di dibombi.<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>Weti kuba vuandisa va kimosi ayi bana ba mintinu</para>
  <para style="q1" vid="PSA 113:8">va kimosi ayi bana ba mintinu mi batu bawu.<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>Niandi wuvuandisa sita ki nketo mu nzo ;</para>
  <para style="q1" vid="PSA 113:9">banga ngudi yi bana yilembo moni khini</para>
  <para style="q1" vid="PSA 113:9">Luzitisa Yave.<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="cl">Minkunga 114</para>
  <para style="s1">Mu thangu Iseli katotuka mu Ezipite</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>Mu thangu Iseli katotuka mu Ezipite,</para>
  <para style="q1" vid="PSA 114:1">nzo yi Yakobi mu batu beti tuba mbembo yi nzenza ;<verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>Yuda dikituka buangu kinlongo ki Nzambi,</para>
  <para style="q1" vid="PSA 114:2">Iseli tsi andi.<verse eid="PSA 114:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>Mbu wumona ayi wutina ;</para>
  <para style="q1" vid="PSA 114:3">Yolidani yivutuka ku manima.<verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>Miongo midumuka banga mamemi mambakala ;</para>
  <para style="q1" vid="PSA 114:4">miongo mifioti banga bana ba mamemi.<verse eid="PSA 114:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>A mbi bivangama, ngeyo mbu, muingi wutina</para>
  <para style="q1" vid="PSA 114:5">ngeyo Yolidani, muingi wuvutuka ku manina e ?<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>Ngeyo miongo, muingi wudumuka banga mamemi ma mbakala,</para>
  <para style="q1" vid="PSA 114:6">miongo mifioti banga bana ba mememi e ?<verse eid="PSA 114:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>Tita, a ntoto, va meso ma Yave</para>
  <para style="q1" vid="PSA 114:7">va meso ma Nzambi yi Yakobi.<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>Niandi wunkitulanga ditadi buindi ki nlangu,</para>
  <para style="q1" vid="PSA 114:8">ditadi dingolo zitho zi nlangu.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="cl">Minkunga 115</para>
  <para style="s1">Nzambi, niandi kaka vuidi nkembo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>Bika kuidi beto, a Yave, bika kuidi beto ;</para>
  <para style="q1" vid="PSA 115:1">vayi kuidi dizina diaku kuba nkembo,</para>
  <para style="q1" vid="PSA 115:1">mu diambu di luzolo luaku ayi kikhuikizi kiaku.<verse eid="PSA 115:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>Bila mbi makanda malembo tubila ti :</para>
  <para style="q1" vid="PSA 115:2">“Kuevi kuidi Nzambi awu e ?”<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>Nzambi eto widi ku Diyilu,</para>
  <para style="q1" vid="PSA 115:3">niandi weti vanga moso katidi.<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>Vayi bitumba biawu bidi palata ayi nolo ;</para>
  <para style="q1" vid="PSA 115:4">bivangulu mu mioko mi batu.<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>Bibeki miunu vayi bilendi yoluka ko ;</para>
  <para style="q1" vid="PSA 115:5">meso vayi bilendi mona ko.<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>Bibeki matu vayi bilendi wa ko ;</para>
  <para style="q1" vid="PSA 115:6">mayilu vayi bilendi wa tsudi ko.<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>Bibeki mioko vayi bilendi simba ko,</para>
  <para style="q1" vid="PSA 115:7">malu vayi bilendi diata ko.</para>
  <para style="q1" vid="PSA 115:7">Voti bilendi totula ko biyoko mu phovi-yi-dilaka diawu.<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>Batu bobo bavanga biawu bela ba banga biawu,</para>
  <para style="q1" vid="PSA 115:8">ayi buawu bobo buela bela batu boso bobo bantulanga diana mu biawu.<verse eid="PSA 115:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>A nzo yi Iseli, tula diana mu Yave.</para>
  <para style="q1" vid="PSA 115:9">Niandi nsadisi awu ayi nkaku awu.<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>A Nzo yi Aloni, tula diana mu Yave.</para>
  <para style="q1" vid="PSA 115:10">Niandi nsadisi awu ayi nkaku awu.<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>Beno lueti kunkinzika, lutula diana mu Yave.</para>
  <para style="q1" vid="PSA 115:11">Niandi nsadisi awu ayi nkaku awu.<verse eid="PSA 115:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>Yave weti kututebukila moyo ayi wela kutusakumuna.</para>
  <para style="q1" vid="PSA 115:12">Wela sakumuna nzo yi Iseli,</para>
  <para style="q1" vid="PSA 115:12">wela sakumuna nzo yi Aloni.<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>Wela sakumuna bobo beti kinzika Yave,</para>
  <para style="q1" vid="PSA 115:13">batu baphamba va kimosi ayi batu banneni.<verse eid="PSA 115:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>Bika Yave kaluwokisa,</para>
  <para style="q1" vid="PSA 115:14">beno ayi bana beno va kimosi.<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>Bika Yave kalusakuna,</para>
  <para style="q1" vid="PSA 115:15">mvangi wu diyilu ayi ntoto.<verse eid="PSA 115:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>Yave niandi vuidi Diyilu dizangama</para>
  <para style="q1" vid="PSA 115:16">vayi ntoto wuvanu kuidi mutu.<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>Kadi sia ti bafua bawu beti zitisa Yave ;</para>
  <para style="q1" vid="PSA 115:17">bobo bankuendanga ku tsi yidi dio sui.<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>Vayi beto tueti yayisa Yave</para>
  <para style="q1" vid="PSA 115:18">tona buabu nate mu zithangu zioso.</para>
  <para style="q1" vid="PSA 115:18">Luzitisa Yave.<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="cl">Minkunga 116</para>
  <para style="s1">Pfumu weti wa mbembo ama.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1"/>Ndieti zola Yave bila niandi weti wa mbemboꞌama</para>
  <para style="q1" vid="PSA 116:1">weti wa yamikina kuama mu diambu di kiadi.<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>Bila niandi wutamba dikutu diandi kuidi minu,</para>
  <para style="q1" vid="PSA 116:2">ndiela kuntela sumbu ndilembo zingi.<verse eid="PSA 116:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>Minsinga mi lufua mimfietikisa ;</para>
  <para style="q1" vid="PSA 116:3">tsisi yi tsi yi bafua yibua va minu ;</para>
  <para style="q1" vid="PSA 116:3">ndibedoso kuidi ziphasi ayi maniongo.<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>Buna nditedila dizina di Yave ;</para>
  <para style="q1" vid="PSA 116:4">“A Yave, wuphukisa !”<verse eid="PSA 116:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>Yave widi nkua nlemvo ayi widi wusonga ;</para>
  <para style="q1" vid="PSA 116:5">Nzambi eto widi nkua kiadi.<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>Yave wunkebanga batu badi bakuluka mu mintima ;</para>
  <para style="q1" vid="PSA 116:6">bu ndiba mu nkinza wu ngolo niandi wuphukisa.<verse eid="PSA 116:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>Ba mu luvundulu mu zithangu ziwombo, a muelꞌama</para>
  <para style="q1" vid="PSA 116:7">bila Yave wuba wumboti kuidi ngeyo.<verse eid="PSA 116:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>Bila ngeyo, a Yave, wukula muelꞌama mu lufua ;</para>
  <para style="q1" vid="PSA 116:8">meso mama mu matsuela,</para>
  <para style="q1" vid="PSA 116:8">malu mama mu bumina thutu<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>muingi ndibaka bu diatila va ntuala Yave,</para>
  <para style="q1" vid="PSA 116:9">va mbata ntoto wu batu badi moyo.<verse eid="PSA 116:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>Ndiwilukila, diawu nditubila :</para>
  <para style="q1" vid="PSA 116:10">“mu ziphasi zingolo ndidi.”<verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>Ku tsi maniongo mama ndituba :</para>
  <para style="q1" vid="PSA 116:11">“batu boso badi bankua luvunu.”<verse eid="PSA 116:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>Buevi ndilendi futila Yave</para>
  <para style="q1" vid="PSA 116:12">mu mamboti mandi moso kuidi minu e ?<verse eid="PSA 116:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>Ndiela vumuna mbungu yi phulusu</para>
  <para style="q1" vid="PSA 116:13">ayi ndiela tela dizina di Yave.<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>Ndiela dukisa zindefi ziama zioso kuidi Yave ;</para>
  <para style="q1" vid="PSA 116:14">va meso ma batu bandi boso.<verse eid="PSA 116:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>Lufua lu banlongo ba Yave</para>
  <para style="q1" vid="PSA 116:15">thalu luidi va meso mandi.<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>A Yave, bukiedika ndidi kisadi kiaku ;</para>
  <para style="q1" vid="PSA 116:16">ndidi kisadi kiaku, muana wu kisadi kiaku ki nketo.</para>
  <para style="q1" vid="PSA 116:16">Ngeyo wukhula mu zisieni ziama.<verse eid="PSA 116:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>Ndiela kutambika makaba ma phutudulu matondo</para>
  <para style="q1" vid="PSA 116:17">ayi ndiela tela dizina di Yave.<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>Ndiela dukisa zindefi ziama zioso kuidi Yave ;</para>
  <para style="q1" vid="PSA 116:18">va meso ma batu bandi boso,<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>mu zimpangu zi Nzo Yave,</para>
  <para style="q1" vid="PSA 116:19">va khatitsikꞌaku ngeyo Yelusalemi.</para>
  <para style="q1" vid="PSA 116:19">Luzitisa Yave.<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="cl">Minkunga 117</para>
  <para style="s1">Batu boso bazitisa Yave</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>Luzitisa Yave, beno makanda moso.</para>
  <para style="q1" vid="PSA 117:1">Lunyayisa beno batu boso.<verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>Bila luzolo luandi luidi lunneni kuidi beto,</para>
  <para style="q1" vid="PSA 117:2">ayi kikhuikizi kiandi kinzingilanga mu zithangu zioso.</para>
  <para style="q1" vid="PSA 117:2">Luzitisa Yave.<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="cl">Minkunga 118</para>
  <para style="s1">Mamboti mandi madi mu zithangu zioso</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1"/>Luvutudila Yave matondo bila niandi widi wumboti ;</para>
  <para style="q1" vid="PSA 118:1">luzolo luandi lunzingilanga mu zithangu zioso.<verse eid="PSA 118:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>Bika Iseli katuba :</para>
  <para style="q1" vid="PSA 118:2">luzolo luandi lunzingilanga mu zithangu zioso.<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>Bika nzo yi Aloni yituba :</para>
  <para style="q1" vid="PSA 118:3">luzolo luandi lunzingilanga mu zithangu zioso.<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>Bika bobo beti kinzika Yave batuba ;</para>
  <para style="q1" vid="PSA 118:4">luzolo luandi lunzingilanga mu zithangu zioso.<verse eid="PSA 118:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>Ku tsi ziphasi ziama, ndiyamikina kuidi Yave,</para>
  <para style="q1" vid="PSA 118:5">ayi wuphana mvutu bu kaphuandisa mu kiphuanza.<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>Yave widi ku ndambuꞌama, ndilendi mona tsisi ko.</para>
  <para style="q1" vid="PSA 118:6">Buna mutu mbi kalenda ku phanga e ?<verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>Yave widi ku ndambuꞌama, niandi nsadisi ama ;</para>
  <para style="q1" vid="PSA 118:7">buna ndiela nunga mu tala bambeni ziama.<verse eid="PSA 118:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>Bulutidi mboti mu suaminanga mu Yave</para>
  <para style="q1" vid="PSA 118:8">viokila mu tula diana mu mutu.<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>Bulutidi mboti mu suaminanga mu Yave</para>
  <para style="q1" vid="PSA 118:9">viokila mu tula diana mu bana ba mintinu.<verse eid="PSA 118:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>Makanda moso manzungidila</para>
  <para style="q1" vid="PSA 118:10">vayi mu dizina di Yave, ndilembo babungi.<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>Mawu manzungidila, ku ndambu ka ndambu</para>
  <para style="q1" vid="PSA 118:11">vayi mu dizina di Yave, ndilembo babungi.<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>Mawu manzungidila banga ziniosi,</para>
  <para style="q1" vid="PSA 118:12">vayi zifuidi mu nsualu banga zitsendi zinlema mbazu ;</para>
  <para style="q1" vid="PSA 118:12">mu dizina di Yave, ndilembo babungi<verse eid="PSA 118:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>Bandunguna ku mbusa muingi ndibua</para>
  <para style="q1" vid="PSA 118:13">vayi Yave wutsadisa.<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>Yave niandi zingolo ziama ayi nkungꞌama ;</para>
  <para style="q1" vid="PSA 118:14">niandi wuyika phulusu ama.<verse eid="PSA 118:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>Yamikina ku khini ayi ku ndungunu kulembo wakana</para>
  <para style="q1" vid="PSA 118:15">mu zinzo zi ngoto zi batu basonga :</para>
  <para style="q1" vid="PSA 118:15">koko ku lubakala ku Yave kuvanga mambu ma lulendo.<verse eid="PSA 118:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16"/>Koko ku lubakala ku Yave kuidi ku zangama ngolo ;</para>
  <para style="q1" vid="PSA 118:16">koko ku lubakala ku Yave kuvanga mambu ma lulendo.<verse eid="PSA 118:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>Ndilendi fua ko vayi ndiela zinga</para>
  <para style="q1" vid="PSA 118:17">ayi ndiela yamikisa momo Yave kavanga.<verse eid="PSA 118:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18"/>Yave wuphana thumbudulu mu kingolo ;</para>
  <para style="q1" vid="PSA 118:18">vayi kasia kundiekula ko mu lufua.<verse eid="PSA 118:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>Nzibudila mielo mi busonga,</para>
  <para style="q1" vid="PSA 118:19">ndiela kota ayi ndiela vutudila Yave matondo.<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>Wawu, wawu muelo wu Yave,</para>
  <para style="q1" vid="PSA 118:20">vawu basonga bafueti kotila.<verse eid="PSA 118:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>Ndiela kuvutudila matondo</para>
  <para style="q1" vid="PSA 118:21">bila ngeyo wuphana mvutu wuyika phulusu ama.<verse eid="PSA 118:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>Ditadi diloza mintungi diyika</para>
  <para style="q1" vid="PSA 118:22">ditadi dilutidi mfunu va fuma ki nzo.<verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>Yave wuvanga diambu diodi</para>
  <para style="q1" vid="PSA 118:23">ayi didi diambu ditsiminanga va meso meto.<verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>Kiaki kiawu lumbu kivanga Yave,</para>
  <para style="q1" vid="PSA 118:24">bika tumona khini ayi tuyangalala mu lumbu beni.<verse eid="PSA 118:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>A Yave, wutuvukisa !</para>
  <para style="q1" vid="PSA 118:25">A Yave, wutusadisa tuluta kuenda ku ntuala.<verse eid="PSA 118:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>Bika kasakumunu mutu wowo wunkuizila mu dizina di Yave ;</para>
  <para style="q1" vid="PSA 118:26">tona ku nzo Yave, tulembo kulusakumuna.<verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>Yave niandi Nzambi ayi niandi wutukienzula ;</para>
  <para style="q1" vid="PSA 118:27">ayi mangiemvo mu mioko, lukota mu ntanda ;</para>
  <para style="q1" vid="PSA 118:27">nate ku ziphoka zi diziku dimvikulungu makabu.<verse eid="PSA 118:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>Ngeyo Nzambi ama ayi ndiela kuvutudila matondo.</para>
  <para style="q1" vid="PSA 118:28">Ngeyo Nzambi ama ayi ndiela kuyayisa.<verse eid="PSA 118:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>Luvutudila Yave matondo bila niandi widi wumboti,</para>
  <para style="q1" vid="PSA 118:29">bila luzolo luandi lunzingilanga mu zithangu zioso.<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="cl">Minkunga 119</para>
  <para style="s1">Mina mi Yave midi mifuana</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1"/>Lusakumunu kuidi bobo bandiatilanga mu zinzila ziawu zikambulu tsembolo,</para>
  <para style="q1" vid="PSA 119:1">bobo bandiatilanga boso buididi mina mi Yave.<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>Lusakumunu kuidi bobo bankebanga zinzengolo ziandi ;</para>
  <para style="q1" vid="PSA 119:2">ayi bakutombanga mu mintima miawu mimvimb ;<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>bavanganga ko kadi diambu di mbimbi,</para>
  <para style="q1" vid="PSA 119:3">bandiatilanga mu zinzila ziandi.<verse eid="PSA 119:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>Ngeyo wuvana minsiku mu diambu</para>
  <para style="q1" vid="PSA 119:4">mikinzuku bumboti.<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>A bika zinzila ziama ziba zitelama dio ngui</para>
  <para style="q1" vid="PSA 119:5">mu diambu ndikizika zinzengolo ziaku ;<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>Buna ndilendi fua tsoni ko</para>
  <para style="q1" vid="PSA 119:6">bu ndiela keba zithumunu ziaku zioso.<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>Ndiela kuzitisa mu ntima wululama ;</para>
  <para style="q1" vid="PSA 119:7">banga minu ndilonguka mina miaku misonga.<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>Ndiela kinzika zinzengolo ziaku,</para>
  <para style="q1" vid="PSA 119:8">kadi tumbu ku ndiekula.<verse eid="PSA 119:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>Buevi ditoko kalenda kebila nzilꞌandi yi vedila e ?</para>
  <para style="q1" vid="PSA 119:9">Mu zinganga boso buidi mambu maku.<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>Ndikutomba mu ntimꞌama wumvimba,</para>
  <para style="q1" vid="PSA 119:10">kadi tala ti ndivengama mu zithumunu ziaku.<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>Ndisimbidila mambu maku mu ntimꞌama</para>
  <para style="q1" vid="PSA 119:11">mu diambu ndibika vola masumu kuidi ngeyo.<verse eid="PSA 119:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>Nzitusu kuidi ngeyo, a Yave</para>
  <para style="q1" vid="PSA 119:12">wundonga zinzengolo ziaku.<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>Mu bididi biama,</para>
  <para style="q1" vid="PSA 119:13">ndilembo tangi mina mioso mintotukanga mu munu aku.<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>Ndieti mona khini mu landakana zinzengolo ziaku</para>
  <para style="q1" vid="PSA 119:14">banga mutu wowo wumona khini mu kimvuama kiwombo.<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>Ndieti yindula minsiku miaku</para>
  <para style="q1" vid="PSA 119:15">ayi ndieti kinzika zinzila ziaku.<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>Ndieti mona khini mu zinzengolo ziaku,</para>
  <para style="q1" vid="PSA 119:16">ndilendi lenza ko mambu maku.<verse eid="PSA 119:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>Vangila kisadi kiaku mamboti ayi mu ndiela zinga ;</para>
  <para style="q1" vid="PSA 119:17">ndiela tumukina mambu maku.<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>Zibula meso mama mu diambu mona</para>
  <para style="q1" vid="PSA 119:18">mambu matsiminanga mu mina miaku.<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>Ndidi nzenza vava mbata ntoto ;</para>
  <para style="q1" vid="PSA 119:19">kadi kutsuekila zithumunu ziaku.<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>Muelꞌama widi dilemina di ngolo ;</para>
  <para style="q1" vid="PSA 119:20">mu diambu di mina miaku mu zithangu zioso.<verse eid="PSA 119:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>Ngeyo wunteminanga batu badi luniemo,</para>
  <para style="q1" vid="PSA 119:21">bobo basingu ayi bobo bavengama mu zithumunu ziaku.<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>Thatudila tsoni ayi dienzi</para>
  <para style="q1" vid="PSA 119:22">bila ndieti keba zinzengolo ziaku.<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>Ka diambu ko minyandi mivuendi va kimosi ayi mikuthubidila ;</para>
  <para style="q1" vid="PSA 119:23">kisadi kiaku kiela yindula zinzengolo ziaku.<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>Zinzengolo ziaku zinkumbonisanga khini,</para>
  <para style="q1" vid="PSA 119:24">zikuphananga zindongi.<verse eid="PSA 119:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>Ndivuanda mu mbungi-mbungi ;</para>
  <para style="q1" vid="PSA 119:25">keba luzingu luama boso buididi mambu maku.<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>Nditangila zinzila ziama ayi ngeyo wuphana mvutu ;</para>
  <para style="q1" vid="PSA 119:26">wundonga zinzengolo ziaku.<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>Bika ndisudika malongi ma minsiku miaku ;</para>
  <para style="q1" vid="PSA 119:27">buna ndiela yindula matsiminanga maku.<verse eid="PSA 119:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>Muelꞌama widi wuvonga mu kiadi,</para>
  <para style="q1" vid="PSA 119:28">wukhindisa boso buididi mambu maku.<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>Bika wuphengumuna mu zinzila zi luvunu ;</para>
  <para style="q1" vid="PSA 119:29">wumbonisa nlemvo mu mina miaku.<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>Ndisobula nzila yi Kiedika ;</para>
  <para style="q1" vid="PSA 119:30">nditula ntimꞌama mu mina miaku.<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>Ndidi wukangama mu zinzengolo ziaku, a Yave ;</para>
  <para style="q1" vid="PSA 119:31">kadi kumbika ndifua tsoni.<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>Ndilembo zawula mu nsolo wu zithumunu ziaku</para>
  <para style="q1" vid="PSA 119:32">bila ngeyo wuvuandisa ntimꞌama mu kiphuanza.<verse eid="PSA 119:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>Wundongisa, a Yave, mu landakana zinzengolo ziaku</para>
  <para style="q1" vid="PSA 119:33">buna ndiela kuzikeba nate ku tsukulu.<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>Wuphana diela ayi ndiela keba mina miaku</para>
  <para style="q1" vid="PSA 119:34">ayi ndiela ku mikinzika mu ntimꞌama wumvimba.<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>Wuthuadisa mu nsolo wu zithumunu ziaku</para>
  <para style="q1" vid="PSA 119:35">bila muawu ndieti moninanga khini.<verse eid="PSA 119:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>Balula ntimꞌama kuidi zinzengolo ziaku ;</para>
  <para style="q1" vid="PSA 119:36">vayi bika kuidi ndandu yi luvunu.<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>Botula meso mama mu bima biphamba ;</para>
  <para style="q1" vid="PSA 119:37">keba luzingu luama boso buididi mambu maku.<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>Dukisila kisadi kiaku tsilꞌaku,</para>
  <para style="q1" vid="PSA 119:38">muingi babaka bukukinzikila.<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>Vengumuna mvuezolo wowo ndilemou moni tsisi</para>
  <para style="q1" vid="PSA 119:39">bila mina miaku midi mimboti.<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>Phila phuila ndidi yi minsiku miaku ;</para>
  <para style="q1" vid="PSA 119:40">keba luzingu luama mu busonga buaku.<verse eid="PSA 119:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>Bika luzolo luaku lungolo lutula kuidi minu, a Yave,</para>
  <para style="q1" vid="PSA 119:41">phulusu aku boso buididi tsilꞌaku,<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>buna ndiela baka bu vanina mvutu</para>
  <para style="q1" vid="PSA 119:42">kuidi mutu wowo wulembo kumfingi</para>
  <para style="q1" vid="PSA 119:42">bila nditula diana diama mu mambu maku.<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>Kadi tumbu botula mvimba mambu ma kiedika mu munuꞌama</para>
  <para style="q1" vid="PSA 119:43">bila ndintulanga diana diama mu mina miaku.<verse eid="PSA 119:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>Ndiela tumukinanga Mina miaku kadika thangu</para>
  <para style="q1" vid="PSA 119:44">mu zithangu zioso ayi mu kadika mvu.<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>Ndiela diatilanga mu kiphuanza</para>
  <para style="q1" vid="PSA 119:45">bila nditomba minsiku miaku.<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>Ndiela yolukila zinzengolo ziaku va ntuala mintinu</para>
  <para style="q1" vid="PSA 119:46">ayi ndilendi fua tsoni ko.<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>Bila khini ndieti mona mu zithumunu ziaku,</para>
  <para style="q1" vid="PSA 119:47">bila ndieti ku zizola.<verse eid="PSA 119:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48"/>Ndimvumuna mioko miama kuidi zithumunu ziaku,</para>
  <para style="q1" vid="PSA 119:48">ziozi ndieti zola</para>
  <para style="q1" vid="PSA 119:48">ayi ndiela yindulanga zinzengolo ziaku.<verse eid="PSA 119:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>Tebukila moyo mambu maku kuidi kisadi kiaku ;</para>
  <para style="q1" vid="PSA 119:49">bila ngeyo wuphana diana.<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>Mbombolo ama mu ziphasi ziama yawu yayi :</para>
  <para style="q1" vid="PSA 119:50">tsilꞌaku yeti kitula luzingu luama lumona.<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>Batu ba luniemo batsekinina ngolo boso buididi luzolo luawu</para>
  <para style="q1" vid="PSA 119:51">vayi ndisia vengama ko mu Mina miaku.<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>Nditebukila moyo mina miaku mikhulu, a Yave</para>
  <para style="q1" vid="PSA 119:52">ayi ndintambula mbombolo mu miawu.<verse eid="PSA 119:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>Kiadi kimbuila mu diambu di batu bambimbi ;</para>
  <para style="q1" vid="PSA 119:53">bobo beti loza Mina miaku.<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>Zinzengolo ziaku ziawu zingudi zi mambu ma minkunga miama</para>
  <para style="q1" vid="PSA 119:54">ku kadika buangu kioki ndieti leka.<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>Nditebukilanga moyo dizina diaku va builu, a Yave,</para>
  <para style="q1" vid="PSA 119:55">ayi ndiela keba Mina miaku.<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>Diadi diba diambu ndisadila :</para>
  <para style="q1" vid="PSA 119:56">ndintumukina minsiku miaku.<verse eid="PSA 119:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>Ngeyo kuku kiama, a Yave.</para>
  <para style="q1" vid="PSA 119:57">Ndivana tsila ti ndiela tumukina mambu maku.<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>Nditomba zizi kiaku mu ntimꞌama wumvimba,</para>
  <para style="q1" vid="PSA 119:58">wutsila nlemvo boso buididi tsilꞌaku.<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>Ndiyindula zinzila ziama</para>
  <para style="q1" vid="PSA 119:59">ayi nditadisa malu mama kuidi zinzengolo ziaku.<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>Ndiela tula nsualu ayi ndilendi zingila ko ;</para>
  <para style="q1" vid="PSA 119:60">mu diambu di keba zithumunu ziaku.<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>Ka diambu ko batu bambimbi bakhengi mu minsinga</para>
  <para style="q1" vid="PSA 119:61">vayi ndisia zimbakana ko Mina miaku.<verse eid="PSA 119:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>Ndieti kotuka va midi miphipa mu kuvutudila matondo</para>
  <para style="q1" vid="PSA 119:62">mu diambu di Mina miaku misonga.<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>Ndidi nkundi wu batu boso bobo beti kukinzika</para>
  <para style="q1" vid="PSA 119:63">ayi wu bobo beti landakana minsiku miaku.<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>Ntoto wufulukidi mu luzolo luaku, a Yave ;</para>
  <para style="q1" vid="PSA 119:64">bika wundonga zinzengolo ziaku.<verse eid="PSA 119:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>Vangila kisadi kiaku mamboti</para>
  <para style="q1" vid="PSA 119:65">boso buididi mambu maku, a Yave.<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>Bika wundongisa nzayilu ayi tsudukulu yimboti</para>
  <para style="q1" vid="PSA 119:66">bila ndiwilukila zithumunu ziaku.<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>Tuamina ndiba mu phasi, minu ndiba ndiengidi</para>
  <para style="q1" vid="PSA 119:67">vayi buabu ndieti tumimina mambu maku.<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>Ngeyo widi wumboti ayi momo weti vanga madi mamboti ;</para>
  <para style="q1" vid="PSA 119:68">bika wundongisa zinzengolo ziaku.<verse eid="PSA 119:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>Ka diambu ko batu ba luniemo balembo bivisa nzitusu ama</para>
  <para style="q1" vid="PSA 119:69">mu mambu ma luvunu mu diambu diama</para>
  <para style="q1" vid="PSA 119:69">minu ndiela kebanga minsiku miaku mu ntimꞌama wumvimba.<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>Mintima miawu midi mi matadi ayi miwanga ko</para>
  <para style="q1" vid="PSA 119:70">vayi minu khini ndieti mona mu mina miaku.<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>Didi diambu di mboti kuidi minu mu monoso phasi</para>
  <para style="q1" vid="PSA 119:71">muingi ndilonguka zinzengolo ziaku.<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>Mina mitotukila mu munu aku milutidi mfunu kuidi minu</para>
  <para style="q1" vid="PSA 119:72">viokila zimili zimili zi bivanzi bi nolo ayi bi palata.<verse eid="PSA 119:72"/></para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>Mioko miaku miawu mikhubika ayi miphanga.</para>
  <para style="q1" vid="PSA 119:73">Bika wuphana tsudukulu yi longukila zithumunu ziaku.<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>Bika bobo beti ku kinzika bamona khini bu beti kumbona,</para>
  <para style="q1" vid="PSA 119:74">bila nditula diana diama mu mambu maku.<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>Nzebi, a Yave, ti mina miaku midi misonga</para>
  <para style="q1" vid="PSA 119:75">mu kikhuikizi ngeyo wumbonisa phasi.<verse eid="PSA 119:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>Bika luzolo luaku lu ngolo luba mbombolo ama</para>
  <para style="q1" vid="PSA 119:76">boso buididi tsila yoyi wusila kisadi kiaku.<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>Bika kiadi kiaku kiba va minu mu diambu ndizinga</para>
  <para style="q1" vid="PSA 119:77">bila khini ndieti mona Mina miaku.<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>Bika batu ba luniemo bafua tsoni,</para>
  <para style="q1" vid="PSA 119:78">mu mambimbi beti kuphangila mu kambu bila</para>
  <para style="q1" vid="PSA 119:78">vayi minu ndiela yindulanga minsiku miaku.<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>Bika bobo beti ku kinzikanga babaluka kuidi minu ;</para>
  <para style="q1" vid="PSA 119:79">bobo beti sudika zinzengolo ziaku.<verse eid="PSA 119:79"/></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>Bika ntimꞌama wuba wukambu tsembolo va ntuala zinzengolo ziaku</para>
  <para style="q1" vid="PSA 119:80">mu diambu ndibika fuisu tsoni.<verse eid="PSA 119:80"/></para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>Muelꞌama wuvongidi mu diambu di phuila yi phulusu aku ;</para>
  <para style="q1" vid="PSA 119:81">vayi ndintula diana diama mu mambu maku.<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>Meso mama mavongidi ; malembo tadidila tsilꞌaku ;</para>
  <para style="q1" vid="PSA 119:82">ndituba : “thangu mbi wela kuiza ku mbomba e ?”<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>Ka diambu ko ndidi banga kamununu ki vinu kitudulu va muisi ;</para>
  <para style="q1" vid="PSA 119:83">vayi ndisia zimbakana ko zinzengolo ziaku.<verse eid="PSA 119:83"/></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>Nate thangu mbi kisadi kiaku kafueti vingidila e ?</para>
  <para style="q1" vid="PSA 119:84">Thangu mbi wela vanina thumbudulu kuidi batu bobo beti ku ndiamisa e ?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>Batu ba luniemo bakebi mabulu ma mintambu mu diambu diama ;</para>
  <para style="q1" vid="PSA 119:85">buawu ko bobo buididi Mina miaku.<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>Zithumunu ziaku zioso zifueni mu tudulu diana ;</para>
  <para style="q1" vid="PSA 119:86">bika wutsadisa bila batu balembo ndiamisa mu kambu bila.<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>Keti fioti kuandi fisiala nganu bambotudi va ntoto ;</para>
  <para style="q1" vid="PSA 119:87">vayi minu ndisia loza ko minsiku miaku.<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>Keba luzingu luama boso buididi luzolo luaku</para>
  <para style="q1" vid="PSA 119:88">ayi ndiela tumukina zinzengolo zi munu aku.<verse eid="PSA 119:88"/></para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>Mambu maku, a Yave, manzingilanga mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 119:89">madi matelama dio ngui mu diyilu.<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>Kikhuikizi kiaku kinzingilanga mu zitsungi zioso.</para>
  <para style="q1" vid="PSA 119:90">Ngeyo wukindisa ntoto ayi wawu wulembo zingila.<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>Mina miaku minzingilanga nate lumbu kiaku :</para>
  <para style="q1" vid="PSA 119:91">bila bima bioso bieti kusadila.<verse eid="PSA 119:91"/></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>Enati Mina miaku misia kumbonisa khini ko</para>
  <para style="q1" vid="PSA 119:92">nganu ndibiva mu ziphasi ziama.<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>Ndilendi zimbakana ko minsiku miaku</para>
  <para style="q1" vid="PSA 119:93">bila mu miawu weti kebila luzingu luama.<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>Wuphukisa bila ndidi waku ;</para>
  <para style="q1" vid="PSA 119:94">nditomba minsiku miaku.<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>Batu bambimbi balembo mfiedi mu diambu bambunga ;</para>
  <para style="q1" vid="PSA 119:95">vayi ndiela yindula zinzengolo ziaku.<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>Mu kadika diambu di fuana, ndilembo moni ndilu ;</para>
  <para style="q1" vid="PSA 119:96">vayi zithumunu ziaku zisiko kadi ndilu.<verse eid="PSA 119:96"/></para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>A phila ndieti zodila mina miaku !</para>
  <para style="q1" vid="PSA 119:97">Miawu ndieti yindula mu lumbu kimvimba.<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>Zithumunu ziaku zikhitula mutu wu nduenga viokila bambeni ziama</para>
  <para style="q1" vid="PSA 119:98">bila ziawu zidi kaka yama mu zithangu zioso.<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>Minu ndieti luta sudika viokila minyiyisi miama mioso</para>
  <para style="q1" vid="PSA 119:99">bila ndinyindulanga zinzengolo ziaku.<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>Minu ndieti luta sudika viokila bakulutu</para>
  <para style="q1" vid="PSA 119:100">bila ndinkebanga minsiku miaku.<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>Ndikeba malu mama mu diatila mu woso-woso nsolo wu mbimbi</para>
  <para style="q1" vid="PSA 119:101">mu diambu dikeba mambu maku.<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>Ndisia vengama ko mu mina miaku</para>
  <para style="q1" vid="PSA 119:102">bila ngeyo veka wundonga.<verse eid="PSA 119:102"/></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>A phila lueki mambu maku madi mu munu ama</para>
  <para style="q1" vid="PSA 119:103">viokila niosi mu munu ama.<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>Mbeki diela mu diambu di minsiku miaku ;</para>
  <para style="q1" vid="PSA 119:104">diawu ndinlendilanga woso-woso nsolo wu mbimbi.<verse eid="PSA 119:104"/></para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>Mambu maku madi muinda mu malu mama</para>
  <para style="q1" vid="PSA 119:105">ayi kiezila mu nsoloꞌama.<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>Ndinzenga ndefi ayi ndiyikindisa :</para>
  <para style="q1" vid="PSA 119:106">ti ndiela landakana mina miaku mi busonga.<verse eid="PSA 119:106"/></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>Ndimona ziphasi ziwombo ;</para>
  <para style="q1" vid="PSA 119:107">keba luzingu luama, a Yave, boso buididi mambu maku.<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>Kikinina, a Yave, minsitusu mi luzolo mi munu ama</para>
  <para style="q1" vid="PSA 119:108">ayi wundongisa mina miaku.<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>Ka diambu ko kadika thangu ndieti nata luzingu luama mu mioko miama,</para>
  <para style="q1" vid="PSA 119:109">ndikadi zimbakana Mina miaku.<verse eid="PSA 119:109"/></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>Batu bambimbi balekidi ntambu mu diambu diama,</para>
  <para style="q1" vid="PSA 119:110">vayi ndisia vengama ko mu minsiku miaku.<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>Zinzengolo ziaku zidi kiuka kiama mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 119:111">ziawu zidi khini yi ntimꞌama.<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>Ntimꞌama wuvuendi mu kebanga zinzengolo ziaku</para>
  <para style="q1" vid="PSA 119:112">nate kuna tsuka.<verse eid="PSA 119:112"/></para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>Ndieti lenda batu badi mintima miodi,</para>
  <para style="q1" vid="PSA 119:113">vayi ndieti zola Mina miaku.<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>Ngeyo suamunu kiama ayi nkakuꞌama ;</para>
  <para style="q1" vid="PSA 119:114">nditula diana diama mu mambu maku.<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>Bika luthatukila beno batu lueti vanga mambu mambimbi ;</para>
  <para style="q1" vid="PSA 119:115">muingi ndikeba zithumunu zi Nzambi ama.<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>Bika wukhindisa boso buididi tsilꞌaku buna ndiela zinga ;</para>
  <para style="q1" vid="PSA 119:116">kadi tala ti diana diama dilalukusu.<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>Bika ngeyo wuba singumunu kiama ayi ndiela kulu ;</para>
  <para style="q1" vid="PSA 119:117">buna ndiela talanga zinzengolo ziaku mu zithangu zioso.<verse eid="PSA 119:117"/></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>Ngeyo wuloza batu boso bobo beti zimbala mu zinzengolo ziaku</para>
  <para style="q1" vid="PSA 119:118">bila luvunu luawu luidi lu phamba.<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>Batu boso bambimbi ba ntoto,</para>
  <para style="q1" vid="PSA 119:119">ngeyo weti kuba vengumuna banga tsobo</para>
  <para style="q1" vid="PSA 119:119">diawu minu ndieti zodila zinzengolo ziaku.<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>Nsuni ama wulembo titi mu diambu di tsisi aku ;</para>
  <para style="q1" vid="PSA 119:120">thelimini mu boma bu mina miaku.<verse eid="PSA 119:120"/></para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>Ndivanga mambu masonga ayi mafuana</para>
  <para style="q1" vid="PSA 119:121">kadi kundiekula kuidi minyamisi miama.<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>Kubikila kisadi kiaku mamboti ;</para>
  <para style="q1" vid="PSA 119:122">kadi tala ti batu ba luniemo bandiamisa.<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>Meso mama mavongidi, malembo tadidila phulusu aku,</para>
  <para style="q1" vid="PSA 119:123">malembo tadidila tsilꞌaku yisonga.<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>Vangila kisadi kiaku mamboti boso buididi luzolo luaku</para>
  <para style="q1" vid="PSA 119:124">ayi wundonga zinzengolo ziaku.<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>Ndidi kisadi kiaku ; wuphana diela,</para>
  <para style="q1" vid="PSA 119:125">muingi ndisudika zinzengolo ziaku.<verse eid="PSA 119:125"/></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>Thangu yifueni kuidi ngeyo mu sala, a Yave ;</para>
  <para style="q1" vid="PSA 119:126">mina miaku mibundukidi.<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>Bila ndieti zola zithumunu ziaku</para>
  <para style="q1" vid="PSA 119:127">viokila nolo, viokila kutu nolo yithalu ;<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>ayi bila ndilembo kinzika minsiku miaku mioso milulama</para>
  <para style="q1" vid="PSA 119:128">Ndinlendanga woso-woso nsolo wu mbimbi.<verse eid="PSA 119:128"/></para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>Zinzengolo ziaku zidi zi matsiminanga</para>
  <para style="q1" vid="PSA 119:129">diawu ndieti kuzitumukina.<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>Zaba ti mambu maku meti vana kiezila ;</para>
  <para style="q1" vid="PSA 119:130">meti vana diela kuidi batu baphamba.<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>Ndinzibula munu ama ayi ndivumuna</para>
  <para style="q1" vid="PSA 119:131">mu phuila yi ngolo yi zithumunu ziaku.<verse eid="PSA 119:131"/></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>Baluka kuidi minu ayi wumbona kiadi,</para>
  <para style="q1" vid="PSA 119:132">banga bobo weti vangila mu zithangu zioso</para>
  <para style="q1" vid="PSA 119:132">kuidi bobo banzolanga dizina diaku.<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>Tuadisa zithambi zi malu mama boso buididi mambu maku,</para>
  <para style="q1" vid="PSA 119:133">kadi tala kadi disumu di ndiadila.<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>Wukhula mu kuamusu wu batu</para>
  <para style="q1" vid="PSA 119:134">mu diambu ndibaka bu tumukina minsiku miaku.<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>Kienzudila kisadi kiaku zizi</para>
  <para style="q1" vid="PSA 119:135">ayi wundongisa zinzengolo ziaku.<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>Matsuela mawombo malembo kumbi mu meso mama banga mila mi nlangu</para>
  <para style="q1" vid="PSA 119:136">mu diambu Mina miaku mikadi kinzuku.<verse eid="PSA 119:136"/></para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>Ngeyo widi wusonga, a Yave</para>
  <para style="q1" vid="PSA 119:137">ayi mina miaku midi milulama.<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>Zinzengolo wutula zidi zisonga,</para>
  <para style="q1" vid="PSA 119:138">zidi zifuana mboti mu siwulu diana.<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>Bufula buama mu kusadila bulembo tsukisa ntima,</para>
  <para style="q1" vid="PSA 119:139">bila bambeni ziama zisi zaba ko mambu maku.<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>Zitsila ziaku zimonika ti zidi zikiedika,</para>
  <para style="q1" vid="PSA 119:140">ayi kisadi kiaku wukuzizolanga.<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>Ka diambu ko ndidi mutu wuvumbama ayi wulenzu,</para>
  <para style="q1" vid="PSA 119:141">ndikadi zimbakana minsiku miaku.<verse eid="PSA 119:141"/></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>Busonga buaku buidi mu zithangu zioso</para>
  <para style="q1" vid="PSA 119:142">ayi mina miaku midi mikiedika.<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>Ziphasi ayi maniongo bimbuididi,</para>
  <para style="q1" vid="PSA 119:143">vayi zithumunu ziaku zikumbonisanga khini.<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>Zinzengolo ziaku zidi zilulama mu zithangu zioso ;</para>
  <para style="q1" vid="PSA 119:144">wuphana diela muingi ndizinga.<verse eid="PSA 119:144"/></para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>Nditela mu ntimꞌama wumvimba ; wuphana mvutu, a Yave</para>
  <para style="q1" vid="PSA 119:145">ayi ndiela kinzika zinzengolo ziaku.<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>Ndikutela, wuphukisa</para>
  <para style="q1" vid="PSA 119:146">ayi ndiela keba zinzengolo ziaku.<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>Ndieti kotuka tuamina nkielo buisi wuba</para>
  <para style="q1" vid="PSA 119:147">ayi ndinyamikinanga muingi wutsadisa ;</para>
  <para style="q1" vid="PSA 119:147">minu nditula diana diama mu mambu maku.<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>Meso mama meti ba mazibuka tuamina khiesa yi builu,</para>
  <para style="q1" vid="PSA 119:148">mu diambu ndiyindula zitsila ziaku.<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>Wa mbemboꞌama boso buididi luzolo luaku</para>
  <para style="q1" vid="PSA 119:149">keba luzingu luama, a Yave, boso buididi mina miaku<verse eid="PSA 119:149"/></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>Bobo beti kubika zikhanu zimbimbi bafikimini,</para>
  <para style="q1" vid="PSA 119:150">vayi thama badi ayi Mina miaku.<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>Muaki, ngeyo widi wufikama, a Yave</para>
  <para style="q1" vid="PSA 119:151">ayi zithumunu ziaku zioso zidi zikiedika.<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>Tona thama ndizaba, ndilongukala zinzengolo ziaku</para>
  <para style="q1" vid="PSA 119:152">ti ngeyo wumana zibieka mu zithangu zioso.<verse eid="PSA 119:152"/></para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>Bika wutala ziphasi ziama ayi bika wukhula</para>
  <para style="q1" vid="PSA 119:153">bila ndisia zimbakana ko Mina miaku.<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>Bika wunduanina ayi bika wukhula,</para>
  <para style="q1" vid="PSA 119:154">keba luzingu luama boso buididi zitsila ziaku.<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>Phulusu thama yidi mu diambu di batu bambimbi</para>
  <para style="q1" vid="PSA 119:155">bila batombanga ko zinzengolo ziaku.<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>Kiadi kiaku kidi kinneni, a Yave ;</para>
  <para style="q1" vid="PSA 119:156">keba luzingu luama boso buididi mina miaku.<verse eid="PSA 119:156"/></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>Batu bobo beti kundenda badi bawombo ayi beti kundiamisa ;</para>
  <para style="q1" vid="PSA 119:157">vayi ndikadi vengama mu zinzengolo ziaku.<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>Ndieti kakumukina batu bobo bakambulu minu</para>
  <para style="q1" vid="PSA 119:158">bila batumukinanga ko mambu maku<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>Tala phila ndieti zodila minsiku miaku,</para>
  <para style="q1" vid="PSA 119:159">keba luzingu luama, a Yave, boso buididi luzolo luaku.<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>Mambu maku moso madi makiedika ;</para>
  <para style="q1" vid="PSA 119:160">Mina miaku mioso misonga midi mu zithangu zioso.<verse eid="PSA 119:160"/></para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>Minyadi mindiamisini mu kambu bila</para>
  <para style="q1" vid="PSA 119:161">vayi ntimꞌama wulembo titi va ntuala mambu maku.<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>Khini ndieti mona mu tsilꞌaku</para>
  <para style="q1" vid="PSA 119:162">banga mutu beki kiuka kinneni mu mvita.<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>Ndieti lenda ayi ndieti kakumukina luvunu</para>
  <para style="q1" vid="PSA 119:163">vayi ndieti zola Mina miaku.<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>Ndieti kuzitisa mu tsambuadi di zikhumbu mu lumbu</para>
  <para style="q1" vid="PSA 119:164">mu diambu di Mina miaku misonga.<verse eid="PSA 119:164"/></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>Ndembama yiwombo yidi kuidi bobo banzolanga Mina miaku ;</para>
  <para style="q1" vid="PSA 119:165">kuisi ko diambu dimosi diba lenda buminina thutu<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>Ndilembo vingila phulusu aku, a Yave</para>
  <para style="q1" vid="PSA 119:166">ayi ndieti landakana zithumunu ziaku.<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>Ndieti tumimina zinzengolo ziaku</para>
  <para style="q1" vid="PSA 119:167">bila ndieti kuzizola ngolo<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>Ndieti tumimina minsiku miaku ayi zinzengolo ziaku</para>
  <para style="q1" vid="PSA 119:168">bila ngeyo zebi zinzila ziama zioso.<verse eid="PSA 119:168"/></para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>Bika yamikina kuama kutula va ntualꞌaku, a Yave</para>
  <para style="q1" vid="PSA 119:169">wuphana diela boso buididi mambu maku.<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>Bika ndombolo ama yitula va ntualꞌaku ;</para>
  <para style="q1" vid="PSA 119:170">wukhula boso buididi tsilꞌaku.<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>Bika bididi biama bisapika mu nzitusu aku</para>
  <para style="q1" vid="PSA 119:171">bila weti kundonga zinzengolo ziaku<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>Bika ludimi luama luyimbila mambu maku</para>
  <para style="q1" vid="PSA 119:172">bila zithumunu ziaku zioso zidi zisonga.<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>Bika koko kuaku kuba kukubama mu kutsadisa</para>
  <para style="q1" vid="PSA 119:173">bila ndisobula minsiku miaku.<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>Phuila yingolo ndiba mu mona phulusu aku, a Yave</para>
  <para style="q1" vid="PSA 119:174">ayi Mina miaku mikumbonisanga khini.<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>Bika ndizinga muingi ndizitisa</para>
  <para style="q1" vid="PSA 119:175">ayi bika mina miaku mitsimba<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>Ndidiengila banga nkangu wu mamemi mazimbala,</para>
  <para style="q1" vid="PSA 119:176">tomba kisadi kiaku,</para>
  <para style="q1" vid="PSA 119:176">bila ndisia zimbakana ko zithumunu ziaku.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="cl">Minkunga 120</para>
  <para style="s1">Bika wukhula</para>
  <para style="d">Nkunga wuyimbudulu mu nzila yikuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1"/>Nditela Yave mu ziphasi ziama</para>
  <para style="q1" vid="PSA 120:1">ayi niandi wupheni mvutu.<verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>Wuphukisa, a Yave, mu bididi bi luvunu</para>
  <para style="q1" vid="PSA 120:2">ayi mu ludimi luidi mayuya.<verse eid="PSA 120:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>Mbi kalenda kuvangila</para>
  <para style="q1" vid="PSA 120:3">ayi mbi kalenda buela, ludimi luidi mayuya e ?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>Wela kuvana thumbudulu mu madionga ma kinuani malengulu bumboti ;</para>
  <para style="q1" vid="PSA 120:4">mu makala ma mbazu, ma nungu-tsendi,<verse eid="PSA 120:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>mabienga kuidi minu bu ndilembo vuandi ku Metsiseki ;</para>
  <para style="q1" vid="PSA 120:5">bu ndieti zingila mu zinzo zi ngoto zi Kedali.<verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>Mu bilumbu biwombo ndizingila</para>
  <para style="q1" vid="PSA 120:6">va khatitsika batu bobo banlendanga ndembama.<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>Minu ndidi mutu wu ndembama ;</para>
  <para style="q1" vid="PSA 120:7">vayi minu yoluka, buna bawu beka yindula mvita.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="cl">Minkunga 121</para>
  <para style="s1">Lusadusu luama kuidi Yave lueta ba</para>
  <para style="d">Nkunga wuyimbudulu mu nzila yikuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1"/>Ndimvumbulanga meso mama ku miongo,</para>
  <para style="q1" vid="PSA 121:1">kuevi kuela totukila lusadusu luama e ?<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>Lusadusu luama luntotukila kuidi Yave ;</para>
  <para style="q1" vid="PSA 121:2">mvangi wu diyilu ayi ntoto.<verse eid="PSA 121:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>Kalendi bika ko kulu kuaku kusialumuka ;</para>
  <para style="q1" vid="PSA 121:3">mutu wowo weti kukebanga kalendi niungina ko.<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>Bukiedika, mutu wowo weti sunga Iseli,</para>
  <para style="q1" vid="PSA 121:4">kalendi niungina ko voti leka tulu ko<verse eid="PSA 121:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>Yave niandi wukusunganga,</para>
  <para style="q1" vid="PSA 121:5">niandi kitsusula kiaku va koko kuaku ku lubakala.<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>Thangu yilendi ku vanga ko mbimbi va muini</para>
  <para style="q1" vid="PSA 121:6">voti ngondi va builu.<verse eid="PSA 121:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>Yave wela kukebanga mu mambimbi moso,</para>
  <para style="q1" vid="PSA 121:7">niandi wela sunganga luzingu luaku.<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>Yave wela kusunga mu kuiza kuaku ayi mu kuenda kuaku</para>
  <para style="q1" vid="PSA 121:8">tona buabu nate mu zithangu zioso.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="cl">Minkunga 122</para>
  <para style="s1">Lusambila mu diambu di ndembama yi Yelusalemi</para>
  <para style="d">Nkunga Davidi wuyimbudulu mu nzila yikuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1"/>Khini ndimona bu bakhamba ti :</para>
  <para style="q1" vid="PSA 122:1">“Bika tuendanu ku nzo Yave”.<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>Malu meto matelimini mu mielo miaku, a Yelusalemi.<verse eid="PSA 122:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>Yelusalemi ditungu banga divula.</para>
  <para style="q1" vid="PSA 122:3">Diodi dikangama ngolo va kimosi<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>Kuna kueti kuiza zimvila, zimvila Yave</para>
  <para style="q1" vid="PSA 122:4">mu diambu di zitisa dizina di Yave</para>
  <para style="q1" vid="PSA 122:4">boso buididi zinzengolo zivanu kuidi Iseli.<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>Bila kuna kutelimini bikundu bi kipfumu bi tsambusulu ;</para>
  <para style="q1" vid="PSA 122:5">bikundu bi kipfumu bi nzo yi Davidi.<verse eid="PSA 122:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>Lusambila mu diambu di ndembama yi Yelusalemi.</para>
  <para style="q1" vid="PSA 122:6">Bika bobo beti kuzola bamona luvovomo.<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>Bika ndembama yiba mu bibaka biaku</para>
  <para style="q1" vid="PSA 122:7">ayi luvovomo mu zinzo ziaku zinneni.<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>Mu diambu di bakhomba ziama ayi bakundi bama</para>
  <para style="q1" vid="PSA 122:8">ndiela tuba “bika ndembama yiba yaku”.<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>Mu diambu di nzo Yave, Nzambi eto, ndiela tomba mamboti maku.<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="cl">Minkunga 123</para>
  <para style="s1">Mu phingudulu yi nlemvo andi</para>
  <para style="d">Nkunga wunyimbudulu mu nzila yikuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1"/>Ndimvumbula meso mama kuidi ngeyo Yave</para>
  <para style="q1" vid="PSA 123:1">ngeyo beki kundu kiaku ki Kipfumu mu diyilu.<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>Banga meso ma bavika meti tala mioko mi bapfumu bawu ;</para>
  <para style="q1" vid="PSA 123:2">banga meso ma kisadi kinketo mantalanga mioko mi pfumu andi wu nketo ;</para>
  <para style="q1" vid="PSA 123:2">buawu bobo meso meto mantadilanga kuidi Yave, Nzambi eto,</para>
  <para style="q1" vid="PSA 123:2">nate kela kutumona kiadi.<verse eid="PSA 123:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>Wutumoni kiadi, a Yave, wutumoni kiadi</para>
  <para style="q1" vid="PSA 123:3">bila nlenzo wuwombo tutambudi.<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>Mvuezolo wuwombo tutambula kuidi bankua luniemo ;</para>
  <para style="q1" vid="PSA 123:4">nlenzo wuwombo kuidi bankua lunangu.<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="cl">Minkunga 124</para>
  <para style="s1">Lusadusu lueto kuidi Yave lueta ba</para>
  <para style="d">Nkunga Davidi wunyimbudulu mu nzila yikuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1"/>Bika Iseli katuba : Enati Yave kasia ba ku ndambuꞌeto ko ;<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>Enati Yave kasia ba ku ndambu eto ko</para>
  <para style="q1" vid="PSA 124:2">mu thangu batu batelama mu kutunuanisa ;<verse eid="PSA 124:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3"/>mu thangu nganzi awu yitubuila,</para>
  <para style="q1" vid="PSA 124:3">keti nganu mina batumina bamoyo ;<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>khuka nlangu yitumbu kutuvitumuna</para>
  <para style="q1" vid="PSA 124:4">ayi nguma yi nlangu yitudiamisa,<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>minlangu mi nguma mitulalumuna.<verse eid="PSA 124:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6"/>Nzitusu wuba kuidi Yave</para>
  <para style="q1" vid="PSA 124:6">mutu wowo wukambu kutuyekula batukanzuna mu meno ma miunu miawu.<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>Tutina banga nuni bu keti tinina mu dikondi di ntambi wu zinuni.</para>
  <para style="q1" vid="PSA 124:7">Dikondi dikanzuka ayi beto tutina.<verse eid="PSA 124:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>Lusadusu lueto luidi mu dizina di Yave,</para>
  <para style="q1" vid="PSA 124:8">mvangi wu diyilu ayi ntoto.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="cl">Minkunga 125</para>
  <para style="s1">Ndembama yi kiedika</para>
  <para style="d">Nkunga wunyimbudulu mu nzila yikuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1"/>Bobo bantulanga diana diawu mu Yave badi banga mongo wu Sioni,</para>
  <para style="q1" vid="PSA 125:1">wowo wulendi nikuka ko vayi wunzingilanga mu zithangu zioso.<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>Banga miongo bu mizungididi Yelusalemi,</para>
  <para style="q1" vid="PSA 125:2">buawu bobo Yave kazungididi batu bandi</para>
  <para style="q1" vid="PSA 125:2">tona buabu nate mu zithangu zioso.<verse eid="PSA 125:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>Nkawa wu kipfumu wu batu bambimbi wulendi vuandanga ko</para>
  <para style="q1" vid="PSA 125:3">va mbata ntoto wukubukulu batu basonga ;</para>
  <para style="q1" vid="PSA 125:3">bila nganu batu basonga bela sadila mioko miawu mu vanga mambimbi.<verse eid="PSA 125:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>Vanga mamboti, a Yave, kuidi batu bamboti,</para>
  <para style="q1" vid="PSA 125:4">kuidi bobo badi balulama mu mintima.<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>Vayi bobo beti vengama mu diatila mu zinzila zivenga,</para>
  <para style="q1" vid="PSA 125:5">Yave wela kuba lalikisa va kimosi ayi bobo bamvanganga mambimbi.</para>
  <para style="q1" vid="PSA 125:5">Ndembama yibanga vadi Iseli.<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="cl">Minkunga 126</para>
  <para style="s1">Thangu yi kuna ayi yi vela</para>
  <para style="d">Nkunga wunyimbudulu mu nzila yi kuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1"/>Mu thangu Yave kavutula batu bakangama ku Sioni,</para>
  <para style="q1" vid="PSA 126:1">tuba banga batu banlota zindozi.<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>Miunu mieto miba miwala masevo ; ludimi lueto minkunga mi khini.</para>
  <para style="q1" vid="PSA 126:2">Buna batuba muidi makanda ti :</para>
  <para style="q1" vid="PSA 126:2">“Yave wuba vangidi mambu manneni.”<verse eid="PSA 126:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>Yave wutuvangidi mambu manneni ;</para>
  <para style="q1" vid="PSA 126:3">ayi khini yitufulukidi.<verse eid="PSA 126:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>Vutula diaka kimvuama kieto, a Yave ;</para>
  <para style="q1" vid="PSA 126:4">banga bina bimila bi minlangu ku Nengevi.<verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>Bobo beti kuna ayi matsuela mu meso,</para>
  <para style="q1" vid="PSA 126:5">bela vedila mu minkunga mi khini.<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>Wuntotukanga ku nganda ayi matsuela mu meso ;</para>
  <para style="q1" vid="PSA 126:6">wunatanga mbongo mu kuna ;</para>
  <para style="q1" vid="PSA 126:6">weti vutuka ayi minkunga mi khini mu natanga mimvumba mi biti.<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="cl">Minkunga 127</para>
  <para style="s1">Niandi weti vanga mambu moso</para>
  <para style="d">Nkunga Salomo wunyimbudulu mu nzila yikuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1"/>Enati Yave kakadi tunga nzo,</para>
  <para style="q1" vid="PSA 127:1">buna batu bobo balembo tungi mu phamba kuandi balembu sadila.</para>
  <para style="q1" vid="PSA 127:1">Enati Yave kakadi sunga divula</para>
  <para style="q1" vid="PSA 127:1">buna batu bobo balembo disungi mu phamba kuandi balembo disungila.<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>Mu phamba kuandi lueti kotukila nsuka-nsuka</para>
  <para style="q1" vid="PSA 127:2">ayi lueti kambu vika lekilanga,</para>
  <para style="q1" vid="PSA 127:2">lueti sadilanga ngolo mu diambu di bidia bi dia ;</para>
  <para style="q1" vid="PSA 127:2">bila bobuawu keti vanina kuidi bobo keti zola bu badi ku tulu.<verse eid="PSA 127:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>Bana badi kiuka kimbanga kuidi Yave,</para>
  <para style="q1" vid="PSA 127:3">bosi mbutu wu bana widi mfutu wumbanga kuidi niandi.<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>Banga madionga mu mioko mi kinuani ki lulendo,</para>
  <para style="q1" vid="PSA 127:4">buawu bobo buididi bana mutu kabutidi mu kimuana kiandi.<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>Lusakumunu kuidi mutu wowo wuwesa bawu mu khutu andi.</para>
  <para style="q1" vid="PSA 127:5">Balendi fua tsoni ko mu thangu bela tubana ayi bambeni ziawu ku muelo.<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="cl">Minkunga 128</para>
  <para style="s1">Bika Yave kasakumuna</para>
  <para style="d">Nkunga wunyimbudulu mu nzila yikuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1"/>Lusakumunu kuidi batu boso bobo bobo beti kinzika Yave,</para>
  <para style="q1" vid="PSA 128:1">bandiatilanga mu zinzila ziandi.<verse eid="PSA 128:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>Ngeyo wela dia mbutu wu kisalu kiaku.</para>
  <para style="q1" vid="PSA 128:2">Lusakumunu ayi mamboti biela ba biaku.<verse eid="PSA 128:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>Nketo aku wela ba banga vinu yidi mbozi yiwombo mu khati nzo aku ;</para>
  <para style="q1" vid="PSA 128:3">bana baku banga mintiudila mi olive muyendila mezꞌaku.<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>Buawu bobo buididi mutu wusakumunu,</para>
  <para style="q1" vid="PSA 128:4">wowo weti kinzika Yave.<verse eid="PSA 128:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>Bika Yave kalusakumuna, tona ku Sioni mu bilumbu bioso bi luzingu lueno ;</para>
  <para style="q1" vid="PSA 128:5">bika lumona mamboti ma Yelusalemi<verse eid="PSA 128:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6"/>ayi bika lumona bana ba bana beno.</para>
  <para style="q1" vid="PSA 128:6">Bika ndembama yiba vadi Iseli.<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="cl">Minkunga 129</para>
  <para style="s1">Mu phasi ndiba vayi ndisia vonga ko</para>
  <para style="d">Nkunga wunyimbudulu mu nzila yikuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1"/>Bandiamisa ngolo tona mu bumuana buama,</para>
  <para style="q1" vid="PSA 129:1">bika Iseli katuba.<verse eid="PSA 129:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>Bandiamisa ngolo tona mu bumuana buama</para>
  <para style="q1" vid="PSA 129:2">vayi basia ku ndunga ko.<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>Minkuni midima manima mama ;</para>
  <para style="q1" vid="PSA 129:3">batula muawu minkala miawu mimula.<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>Vayi Yave widi wusonga ;</para>
  <para style="q1" vid="PSA 129:4">niandi wuzenga minsinga mi batu bambimbi muingi ndiba mu kiphuanza.<verse eid="PSA 129:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>Bika babo beti lenda Sioni bavutuka fua tsoni.<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>Bika baba banga biti bi mbata muanzu,</para>
  <para style="q1" vid="PSA 129:6">biobi bieti yuma tuamina biyunduka ;<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>biobi mvedi kalendi wesa mu mioko miandi ko ;</para>
  <para style="q1" vid="PSA 129:7">voti mutu wowo wunkanga mvumba kalendi wesi mu mioko miandi ko.<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>Bika bobo bamviokila vana babika tuba :</para>
  <para style="q1" vid="PSA 129:8">“lusakumunu lu Yave lubanga yeno !</para>
  <para style="q1" vid="PSA 129:8">Tueti kulusakumuna mu dizina di Yave !”<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="cl">Minkunga 130</para>
  <para style="s1">Ku tsi ziphasi nditela Yave.</para>
  <para style="d">Nkunga wunyimbudulu mu nzila yinkuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1"/>Bu nditotuka mu mabulu madi thipula,</para>
  <para style="q1" vid="PSA 130:1">ndiyamikina kuidi ngeyo, a Yave.<verse eid="PSA 130:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2"/>A Yave, wa mbemboꞌama ;</para>
  <para style="q1" vid="PSA 130:2">bika wutamba matu maku mu yamikina kuama mu diambu di lusadusu.<verse eid="PSA 130:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>Enati ngeyo, a Yave, weti tangisa masumu</para>
  <para style="q1" vid="PSA 130:3">A Yave buna nani wulenda telama e ?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>Vayi kuidi ngeyo kuidi ndemvukulu yi masumu ;</para>
  <para style="q1" vid="PSA 130:4">diawu fueni kinzuku.<verse eid="PSA 130:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>Ndimvingila Yave, muelꞌama wulembo vingila ;</para>
  <para style="q1" vid="PSA 130:5">ayi mu mambu mandi, ndintula diana diama.<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>Muelꞌama wumvingila Yave viokila minsungi mimvingila nsuka.</para>
  <para style="q1" vid="PSA 130:6">Nyinga viokila minsungi mimvingila nsuka.<verse eid="PSA 130:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>A Iseli, tula diana diaku mu Yave</para>
  <para style="q1" vid="PSA 130:7">Bila mu niandi muidi luzolo lu ngolo</para>
  <para style="q1" vid="PSA 130:7">ayi mu niandi muidi khudulu yiduka.<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>Niandi veka wela kula Iseli mu masumu mawu moso.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="cl">Minkunga 131</para>
  <para style="s1">Ndembama yi kiedika</para>
  <para style="d">Nkunga Davidi wunyimbudulu mu nzila yikuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1"/>Ntimꞌama wisi luniemo ko, a Yave, meso mama masi lunangu ko.</para>
  <para style="q1" vid="PSA 131:1">Ndiyindulanga ko mambu malutidi manneni</para>
  <para style="q1" vid="PSA 131:1">voti momo madi matsiminanga kuidi minu.<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>Vayi ndivumbika muelꞌama ayi ndidingimisa wawu ;</para>
  <para style="q1" vid="PSA 131:2">banga muana wutsombi wulemboso mabeni widi va kimosi ayi ngudi andi ;</para>
  <para style="q1" vid="PSA 131:2">banga muana wutsombi wulemboso mabeni</para>
  <para style="q1" vid="PSA 131:2">buawu buididi muelꞌama mu minu.<verse eid="PSA 131:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>A Iseli, tula diana diaku mu Yave</para>
  <para style="q1" vid="PSA 131:3">tona buabu nate mu zithangu zioso.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="cl">Minkunga 132</para>
  <para style="s1">Divula di Ntinu</para>
  <para style="d">Nkunga wunyimbudulu mu nzila yikuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1"/>A Yave, tebukila Davidi moyo</para>
  <para style="q1" vid="PSA 132:1">ayi ziphasi ziandi zioso kamona ;<verse eid="PSA 132:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>wuzenga ndefi kuidi Yave</para>
  <para style="q1" vid="PSA 132:2">ayi wuvanga lukanu kuidi nkua lulendo wu Yakobi :<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3"/>“Ndilendi kota ko mu nzo ama ;</para>
  <para style="q1" vid="PSA 132:3">voti kuenda va mbukꞌama.<verse eid="PSA 132:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4"/>Ndilendi vana ko meso mama minsua mu bua ku tulu ;</para>
  <para style="q1" vid="PSA 132:4">zindabu ziama mu laba,<verse eid="PSA 132:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5"/>nate ndimbakula buangu mu diambu di Yave,</para>
  <para style="q1" vid="PSA 132:5">buangu kivuanda mu diambu di nkua lulendo wu Yakobi.”<verse eid="PSA 132:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>Tuwa tsangu beni ku Efalata, tuwila yawu mu zitsola zi Yali.<verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>Bika tuenda ku buangu kiandi kioki keti vuanda ;</para>
  <para style="q1" vid="PSA 132:7">bika tubuongama va ntuala kima kioki keti tetika malu mandi.<verse eid="PSA 132:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>Telama, a Yave, ayi kota ku buangu kiaku kivundila</para>
  <para style="q1" vid="PSA 132:8">ngeyo va kimosi ayi kesi yi zingolo ziaku.<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>Bika zinganga ziaku zi Nzambi zivuata busonga ;</para>
  <para style="q1" vid="PSA 132:9">bika banlongo baku bayimbila mu khini.<verse eid="PSA 132:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>Mu diambu di Davidi kisadi kiaku,</para>
  <para style="q1" vid="PSA 132:10">kadi loza mutu aku wowo wuvinda mafuta.<verse eid="PSA 132:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>Yave wuzenga ndefi kuidi Davidi ;</para>
  <para style="q1" vid="PSA 132:11">ndefi yikiedika yoyi kalendi viakisa ko :</para>
  <para style="q1" vid="PSA 132:11">“wumosi mu nkunꞌaku ndiela tula va kundu kiaku ki Kipfumu.<verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>Enati bana baku bakebidi Nguizani ama</para>
  <para style="q1" vid="PSA 132:12">ayi zinzengolo ziozi ndiela ku balonga,</para>
  <para style="q1" vid="PSA 132:12">buna bana bawu bela vuanda va kundu kiaku ki kipfumu.”<verse eid="PSA 132:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>Bila Yave wusobula Sioni ;</para>
  <para style="q1" vid="PSA 132:13">wuzola Sioni ngolo mu ba buangu kiandi kika fueti vuandanga :<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>“Vava vadi buangu kiama kivundila mu zithangu zioso.</para>
  <para style="q1" vid="PSA 132:14">Vava ndiela tula kundu kiama ki kipfumu bila ndizola vawu.<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>Ndiela kunsakumuna mu bima biwombo ;</para>
  <para style="q1" vid="PSA 132:15">minsukami miandi, ndiela kuba yukutisa mu bidia.<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>Ndiela vuika zinganga ziandi phulusu</para>
  <para style="q1" vid="PSA 132:16">ayi kadika thangu banlongo bandi bela yimbilanga mu khini.<verse eid="PSA 132:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>Vava ndiela vanga phoka yi yunduka mu diambu Davidi</para>
  <para style="q1" vid="PSA 132:17">ayi kubika muinda mu diambu di mutu ama ndivinda mafuta.<verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>Ndiela vuika bambeni ziandi tsoni</para>
  <para style="q1" vid="PSA 132:18">vayi budu ki kipfumu kiela lezamanga. Va mbata ntu andi.”<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="cl">Minkunga 133</para>
  <para style="s1">Zikhomba bu badi mu kithuadi</para>
  <para style="d">Nkunga Davidi wunyimbudulu mu nzila yikuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1"/>Phila mboti ayi kitoko kuidi bakhomba mu thangu zinzingilanga va</para>
  <para style="q1" vid="PSA 133:1">kimosi mu kithuadi.<verse eid="PSA 133:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>Diambu beni didi banga mafuta ma thalu madukulu ku ntu,</para>
  <para style="q1" vid="PSA 133:2">mankumba nate mu mayedo,</para>
  <para style="q1" vid="PSA 133:2">mankumba nate mu mayedo ma Aloni,</para>
  <para style="q1" vid="PSA 133:2">mankumba nate mu zitsongi zi zilobi ziandi.<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>Didi banga bimi bi Helimoni bieti kumba mu miongo mi Sioni,</para>
  <para style="q1" vid="PSA 133:3">bila kuna Yave keti vanina lusakumunu luandi,</para>
  <para style="q1" vid="PSA 133:3">luzingu mu zithangu zioso.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="cl">Minkunga 134</para>
  <para style="s1">Luzitisa Pfumu</para>
  <para style="d">Nkunga wunyimbudulu mu nzila yikuendila ku nzo Yave.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1"/>Luzitisa Yave beno bisadi bioso bi Yave ;</para>
  <para style="q1" vid="PSA 134:1">beno lunsalanga mu builu mu nzo Yave.<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>Vumbulanu mioko mieno mu buangu kinlongo</para>
  <para style="q1" vid="PSA 134:2">ayi luzitisa Yave.<verse eid="PSA 134:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>Bika Yave mvangi wu diyilu ayi ntoto ;</para>
  <para style="q1" vid="PSA 134:3">kalusakumuna tona ku Sioni.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="cl">Minkunga 135</para>
  <para style="s1">Pfumu widi wumboti</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1"/>Luzitisa Yave,</para>
  <para style="q1" vid="PSA 135:1">luzitisa dizina di Yave,</para>
  <para style="q1" vid="PSA 135:1">lunzitisa beno bisadi bi Yave ;<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>beno lunsalanga mu Nzo Yave,</para>
  <para style="q1" vid="PSA 135:2">mu ziphangu zi Nzo yi Nzambi eto.<verse eid="PSA 135:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>Luzitisa Yave bila Yave widi wumboti ;</para>
  <para style="q1" vid="PSA 135:3">luyimbila minzitusu mu diambu di dizina diandi,</para>
  <para style="q1" vid="PSA 135:3">bila didi diambu di kitoko.<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>Bila Yave wukisobudila Yakobi mu ba wandi veka,</para>
  <para style="q1" vid="PSA 135:4">Iseli, mu diambu kaba kiuka kioki kavuidi niandi veka.<verse eid="PSA 135:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>Nzebi ti Yave widi wunneni,</para>
  <para style="q1" vid="PSA 135:5">ti Yave eto widi wunneni viokila zinzambi zioso.<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>Muaki Yave weti vanga moso kazodidi,</para>
  <para style="q1" vid="PSA 135:6">mu diyilu ayi vava ntoto,</para>
  <para style="q1" vid="PSA 135:6">mu mimbu ayi mu mabulu mawu moso madi thipula.<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>Niandi wuntotulanga matuti mu zitsongi zi ntoto ;</para>
  <para style="q1" vid="PSA 135:7">niandi wumfidisanga zitsiemo va kimosi ayi mvula</para>
  <para style="q1" vid="PSA 135:7">ayi wuntotulanga phemo mu bibuangu biandi biobi kalundila wawu.<verse eid="PSA 135:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>Niandi wuvonda bana batheti mu Ezipite,</para>
  <para style="q1" vid="PSA 135:8">bana batheti ba batu ayi ba bibulu.<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>Wufidisa bidimbu biandi ayi matsiminanga</para>
  <para style="q1" vid="PSA 135:9">va khatitsikꞌaku, a Ezipite</para>
  <para style="q1" vid="PSA 135:9">mu diambu di nuanisa Falawo ayi bisadi biandi bioso.<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>Niandi wuvonda makanda mawombo</para>
  <para style="q1" vid="PSA 135:10">ayi wuvonda mintinu mi lulendo.<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>Sihoni ntinu basi Amoli ;</para>
  <para style="q1" vid="PSA 135:11">Ongi ntinu basi Basani</para>
  <para style="q1" vid="PSA 135:11">ayi mintinu mioso mi Kana.<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>Ayi wuvana zitsi ziawu banga kiuka ;</para>
  <para style="q1" vid="PSA 135:12">kiuka kuidi Iseli, batu bandi.<verse eid="PSA 135:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>Dizina diaku, a Yave, dinzingilanga mu zithangu zioso,</para>
  <para style="q1" vid="PSA 135:13">zitsangu ziaku, a Yave, mu zitsungi zioso.<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>Bila Yave wela nungisa batu bandi</para>
  <para style="q1" vid="PSA 135:14">ayi wela mona bisadi biandi kiadi.<verse eid="PSA 135:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>Bitumba bi makanda bidi bi palata ayi bi nolo ;</para>
  <para style="q1" vid="PSA 135:15">bivangulu mu mioko mi batu ;<verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>bibeki miunu vayi bilendi tuba ko ;</para>
  <para style="q1" vid="PSA 135:16">meso vayi bilendi mona ko ;<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>Bibeki matu vayi bilendi wa ko</para>
  <para style="q1" vid="PSA 135:17">bisi kadi phemo ko mu miunu miawu.<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>Batu bobo beti vanga biawu bela ba banga biawu</para>
  <para style="q1" vid="PSA 135:18">ayi buawu bobo buela bela bobo bantulanga diana mu biawu.<verse eid="PSA 135:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>A nzo yi Iseli, luzitisa Yave.</para>
  <para style="q1" vid="PSA 135:19">A nzo yi Aloni, luzitisa Yave.<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>A nzo yi Levi, luzitisa Yave.</para>
  <para style="q1" vid="PSA 135:20">Beno lueti kunkinzika, luzitisa Yave.<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>Bika nzitusu wuba kuidi Yave tona mu Sioni</para>
  <para style="q1" vid="PSA 135:21">kuidi niandi weti vuanda ku Yelusalemi.</para>
  <para style="q1" vid="PSA 135:21">Luzitisa Yave.<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="cl">Minkunga 136</para>
  <para style="s1">Luzolo luandi luidi mu zithangu zioso</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>Luvutudila Yave matondo bila niandi widi wumboti,</para>
  <para style="qr" vid="PSA 136:1">luzolo luandi lunzingilanga mu zithangu zioso.<verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>Luvutudila Nzambi yi zinzambi matondo,</para>
  <para style="qr" vid="PSA 136:2">luzolo luandi lunzingilanga mu zithangu zioso.<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>Luvutudila Pfumu yi bapfumu matondo,</para>
  <para style="qr" vid="PSA 136:3">luzolo luandi lunzingilanga mu zithangu zioso,<verse eid="PSA 136:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>niandi kaka, wumvanganga matsiminanga,</para>
  <para style="qr" vid="PSA 136:4">luzolo luandi lunzingilanga mu zithangu zioso<verse eid="PSA 136:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>niandi wuvanga diyilu mu diela diandi</para>
  <para style="qr" vid="PSA 136:5">luzolo luandi lunzingilanga mu zithangu zioso<verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>Niandi wuyalumuna ntoto va mbata minlangu ;</para>
  <para style="qr" vid="PSA 136:6">luzolo luandi lunzingilanga mu zithangu zioso<verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>Niandi wuvanga kiezila kingolo</para>
  <para style="qr" vid="PSA 136:7">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>thangu mu diambu di yadila muini,</para>
  <para style="qr" vid="PSA 136:8">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>ngondi ayi zimbuetete mu diambu di yadila builu,</para>
  <para style="qr" vid="PSA 136:9">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>kuidi niandi bila niandi wuvvonda bana batheti mu Ezipite,</para>
  <para style="qr" vid="PSA 136:10">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>ayi wutotula bana ba Iseli va khatitsika basi Ezipite</para>
  <para style="qr" vid="PSA 136:11">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>mu koko ku ngolo ayi ku yalumuka,</para>
  <para style="qr" vid="PSA 136:12">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>Kuidi niandi bila niandi wuvasa mbu wu mbuaki mu zindambu zizole,</para>
  <para style="qr" vid="PSA 136:13">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>ayi wuviokisila Iseli va khatitsika mbu wu mbuaki,</para>
  <para style="qr" vid="PSA 136:14">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>vayi wulalumusa Falawo ayi masodi mandi mu mbu wu mbuaki,</para>
  <para style="qr" vid="PSA 136:15">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>kuidi niandi bila niandi wudiatisa batu bandi mu dikanga ;</para>
  <para style="qr" vid="PSA 136:16">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>Niandi wuvonda mintinu minneni,</para>
  <para style="qr" vid="PSA 136:17">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>ayi wuvonda mintinu mi lulendo,</para>
  <para style="qr" vid="PSA 136:18">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>Sihoni, ntinu basi Amoli,</para>
  <para style="qr" vid="PSA 136:19">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>ayi Ongi, ntinu basi Basani,</para>
  <para style="qr" vid="PSA 136:20">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>ayi wuvana zitsi ziawu banga kiuka,</para>
  <para style="qr" vid="PSA 136:21">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>kiuka kuidi kisadi kiandi, Iseli,</para>
  <para style="qr" vid="PSA 136:22">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>kuidi niandi, mutu wowo wututebukila moyo mu kambu kueto ku luvalu,</para>
  <para style="qr" vid="PSA 136:23">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>ayi wutuvana kiphuanza mu bambeni zieto,</para>
  <para style="qr" vid="PSA 136:24">luzolo luandi lunzingilanga mu zithangu zioso ;<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>ayi niandi wumvananga bidia kuidi kioso-kioso vangu,</para>
  <para style="qr" vid="PSA 136:25">luzolo luandi lunzingilanga mu zithangu zioso.<verse eid="PSA 136:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>Luvutudila Nzambi yi diyilu matondo</para>
  <para style="qr" vid="PSA 136:26">luzolo luandi lunzingilanga mu zithangu zioso.<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="cl">Minkunga 137</para>
  <para style="s1">Va muenda minlangu minneni mi Babiloni</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>Va muenda minlangu minneni mi Babiloni ;</para>
  <para style="q1" vid="PSA 137:1">tuvuanda ayi tudila bu tutebukila Sioni moyo.<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>Kuna tudengidika zingitala zieto mu minti.<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>Bila kuna, batu bobo batukanga mu kivika</para>
  <para style="q1" vid="PSA 137:3">batulomba tuyimbila minkunga ;</para>
  <para style="q1" vid="PSA 137:3">minyamisi mieto mituyuvula minkunga mi khini ;</para>
  <para style="q1" vid="PSA 137:3">batuba : “lutuyimbidila nkunga wumosi mu minkunga mi Sioni.”<verse eid="PSA 137:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>A buevi tulenda yimbidila minkunga mi Yave</para>
  <para style="q1" vid="PSA 137:4">mu ntoto wu kinzenza e ?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>Enati ndizimbikini, a Yelusalemi ;</para>
  <para style="q1" vid="PSA 137:5">bika koko kuama ku lubakala kuzimbakana zitsembo ziandi.<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>Bika ludimi luama lunama mu mianzi mi munu ama</para>
  <para style="q1" vid="PSA 137:6">enati ndikadi kutebukila moyo,</para>
  <para style="q1" vid="PSA 137:6">enati ndikadi ba mayindu mu Yelusalemi,</para>
  <para style="q1" vid="PSA 137:6">khini ama yoyo yilutidi zangama.<verse eid="PSA 137:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>Tebuka moyo, a Yave, momo basi Edomi</para>
  <para style="q1" vid="PSA 137:7">bavanga mu lumbu kibua Yelusalemi,</para>
  <para style="q1" vid="PSA 137:7">Bayamikina : “lutiolumuna, lutiolumuna nate muna zifundasio ziandi.”<verse eid="PSA 137:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>A muana ndumba wu Babiloni, ngeyo wukubuku mu bungu ;</para>
  <para style="q1" vid="PSA 137:8">khini kuidi mutu wowo wukuvutudila mambu momo wutuvangila.<verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>Khini kuidi mutu wumbuila bana baku batsombi</para>
  <para style="q1" vid="PSA 137:9">ayi wela kuba banda va matadi.<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="cl">Minkunga 138</para>
  <para style="s1">Thidi yimbidila kikhuikizi kiaku</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1"/>Ndiela kuzitisa, a Yave, mu ntimꞌama wumvimba ;</para>
  <para style="q1" vid="PSA 138:1">ndiela yimbila minzitusu miaku va ntuala zinzambi.<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>Ndiela buongama ku ndambu nzo aku yinlongo ;</para>
  <para style="q1" vid="PSA 138:2">ayi ndiela zitisa dizina diaku mu diambu di luzolu luaku</para>
  <para style="q1" vid="PSA 138:2">ayi mu diambu di kikhuikizi kiaku</para>
  <para style="q1" vid="PSA 138:2">bila ngeyo wuyayisidi dizina diaku ayi mambu maku va yilu bima bioso.<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>Thangu nditela, ngeyo wuphana mvutu.</para>
  <para style="q1" vid="PSA 138:3">Wukhitula nkua ngangu ayi nkua bukhafi bu ngolo.<verse eid="PSA 138:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>Bika mintinu mioso mintoto mizitisa, a Yave</para>
  <para style="q1" vid="PSA 138:4">bu miwilu mambu ma munu aku.<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>Bika miyimbila zinzila zi Yave</para>
  <para style="q1" vid="PSA 138:5">bila nkembo wu Yave widi wunneni.<verse eid="PSA 138:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>Ka diambu ko Yave widi wuzangama,</para>
  <para style="q1" vid="PSA 138:6">niandi weti tala bobo beti kukikulula</para>
  <para style="q1" vid="PSA 138:6">ayi zebi bumboti batu badi luniemo bu badi ku thama.<verse eid="PSA 138:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>Ka diambu ko ndilembo diatila va khatitsika ziphasi,</para>
  <para style="q1" vid="PSA 138:7">ngeyo weti tanina luzingu luama ;</para>
  <para style="q1" vid="PSA 138:7">ngeyo weti nonuna koko kuaku</para>
  <para style="q1" vid="PSA 138:7">mu kakidila zinganzi zi bobo beti kundenda ;</para>
  <para style="q1" vid="PSA 138:7">mu koko kuaku ku lubakala weti kuphukisila.<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>Yave wela dukisa mambu momo keti tomba mu minu.</para>
  <para style="q1" vid="PSA 138:8">Luzolo luaku, a Yave, lunzingilanga mu zithangu zioso.</para>
  <para style="q1" vid="PSA 138:8">Kadi yekula bisalu bi mioko miaku.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="cl">Minkunga 139</para>
  <para style="s1">Pfumu, ngeyo zebi mambu mama moso</para>
  <para style="d">Nkunga Davidi kuidi Pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1"/>A Yave ngeyo wuthomba ayi ngeyo wunzebi.<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>Ngeyo zebi thangu ndidi wuvuanda</para>
  <para style="q1" vid="PSA 139:2">ayi thangu ndidi wutelama ;</para>
  <para style="q1" vid="PSA 139:2">ngeyo weti bakula bumboti mayindu mama bu makidi thama.<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>Ngeyo zebi thangu ndieti totuka</para>
  <para style="q1" vid="PSA 139:3">ayi thangu ndieti lambalala ;</para>
  <para style="q1" vid="PSA 139:3">Ngeyo zebi bumboti zinzila ziama zioso.<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>Tuamina mambu maba va ludimi luama,</para>
  <para style="q1" vid="PSA 139:4">ngeyo zebi mawu moso, a Yave.<verse eid="PSA 139:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>Ngeyo wunzungididi ku manima ayi ku ntuala</para>
  <para style="q1" vid="PSA 139:5">Ngeyo wutetika koko kuaku va minu.<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>Nzayilu yi phila yoyi, yididi ngolo</para>
  <para style="q1" vid="PSA 139:6">yitsiminanga kuidi minu ;</para>
  <para style="q1" vid="PSA 139:6">yididi ngolo yinangama muingi ndiyibakidila.<verse eid="PSA 139:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>Kuevi ndilenda kuenda suamina phevi aku e ?</para>
  <para style="q1" vid="PSA 139:7">A kuevi ndilenda kuenda tinina meso maku e ?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>Enati khumini ku Diyilu, ngeyo widi kuna ;</para>
  <para style="q1" vid="PSA 139:8">enati minu thudidi mbukꞌama ku tsina ntoto,</para>
  <para style="q1" vid="PSA 139:8">ngeyo widi kuna.<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>Enati khumini mu mavavi ma nkielo buisi ;</para>
  <para style="q1" vid="PSA 139:9">enati phuendi ku lubakala lu mbu,<verse eid="PSA 139:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10"/>buna kuna diaka, koko kuaku kuela kundiatisa ;</para>
  <para style="q1" vid="PSA 139:10">koko kuaku ku lubakala kuela kutsimbidila ngolo.<verse eid="PSA 139:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>Enati khembi : “Bukiedika tombi kiela kutsueka”</para>
  <para style="q1" vid="PSA 139:11">vayi buna kiezila kikitukidi tombi va ndidi.<verse eid="PSA 139:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12"/>Muaki tombi kilendi ba tombi kuidi ngeyo ko ;</para>
  <para style="q1" vid="PSA 139:12">builu buela kienzuka banga muini</para>
  <para style="q1" vid="PSA 139:12">bila tombi kidi banga kiezila kuidi ngeyo.<verse eid="PSA 139:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>Ngeyo wuvanga binama biama bi khati nitu ;</para>
  <para style="q1" vid="PSA 139:13">ngeyo wuthunga va kimosi mu vumu ki ngudi ama.<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>Ndikuzitisa bila ndidi vangu ki tsisi ayi kitsiminanga ;</para>
  <para style="q1" vid="PSA 139:14">mavanga maku madi matsiminanga ayi nzebi buawu bumboti.<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>Khubukulu ama yi mimvesi yisia suama va ntualꞌaku ko</para>
  <para style="q1" vid="PSA 139:15">mu thangu ndikubuku mu buangu kisuama ;</para>
  <para style="q1" vid="PSA 139:15">mu thangu ndivangu va kimosi ku tsina ntoto.<verse eid="PSA 139:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16"/>Meso maku mamona nitu ama yikambu kubuku.</para>
  <para style="q1" vid="PSA 139:16">Bilumbu bioso biobi wukhubikila biba bisonama mu bukuꞌaku,</para>
  <para style="q1" vid="PSA 139:16">tuamina lumbu kimosi mu biawu kiba.<verse eid="PSA 139:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>A phila thalu mayindu maku kuidi minu, a Nzambi !</para>
  <para style="q1" vid="PSA 139:17">A phila woka madi !<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>Enati thidi ku matanga ;</para>
  <para style="q1" vid="PSA 139:18">buna maviokidi nzielo mu thalu ;</para>
  <para style="q1" vid="PSA 139:18">Bu khotukidi, minu ndidi kaka yaku.<verse eid="PSA 139:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>Enati ngeyo wuzola kaka vonda mutu wumbimbi, a Nzambi !</para>
  <para style="q1" vid="PSA 139:19">Bika luthatukila beno luntengulanga menga !<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>Beti kuyolukila mu zikhanu zimbimbi ;</para>
  <para style="q1" vid="PSA 139:20">bobo beti kulenda beti sadila dizina diaku mu kambu fuana.<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>Buevi, ndilendi lenda ko bobo beti kulenda, a Yave ?</para>
  <para style="q1" vid="PSA 139:21">A buevi, ndilendi kakumukina ko bobo beti kufuemi e ?<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>Ndisi kadi diambu ko vayi kikhenene kaka ndidi kuidi bawu ;</para>
  <para style="q1" vid="PSA 139:22">ndieti ba tanga bambeni ziama.<verse eid="PSA 139:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>Wumfiongunina, a Nzambi, ayi zaba ndimꞌama ;</para>
  <para style="q1" vid="PSA 139:23">wuthota ayi zaba mayindu mama.<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>Tala kani nzila yimbimbi yidi mu minu</para>
  <para style="q1" vid="PSA 139:24">ayi wundiatisa mu nzila yi mvu ka mvu.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="cl">Minkunga 140</para>
  <para style="s1">Bika wukhula mu mimvuezi</para>
  <para style="d">Nkunga Davidi kuidi pfumu minyimbidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1"/>Wukhudi, a Yave, mu mutu wumbimbi ;</para>
  <para style="q1" vid="PSA 140:1">wukheba mu mutu wu makhemi ;<verse eid="PSA 140:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>bobo banyindulanga zikhanu zimbimbi mu mintima miawu</para>
  <para style="q1" vid="PSA 140:2">ayi bantombanga lumbu ka lumbu nuana mvita.<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>Beti kitula ludimi luawu meno banga lu nioka ;</para>
  <para style="q1" vid="PSA 140:3">mitsa mi bikusa midi mu bididi biawu.<verse eid="PSA 140:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>Wukheba, a Yave, mu mutu wumbimbi.</para>
  <para style="q1" vid="PSA 140:4">Wuthanina mu batu badi makhemi ;</para>
  <para style="q1" vid="PSA 140:4">bobo beti kubika zikhanu mu buisa malu mama.<verse eid="PSA 140:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>Batu ba luniemo bathambila makondi ;</para>
  <para style="q1" vid="PSA 140:5">bayalumuna minsinga mi makondi mawu</para>
  <para style="q1" vid="PSA 140:5">ayi bathambila mintambu muyenda nsolo ama.<verse eid="PSA 140:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>A Yave, ndituba kuidi ngeyo :</para>
  <para style="q1" vid="PSA 140:6">“ngeyo Nzambi ama.”</para>
  <para style="q1" vid="PSA 140:6">Wa, a Yave, yamikina kuama bu ndintomba monono kiadi.<verse eid="PSA 140:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>A Yave, mutu wumvanganga makazodidi</para>
  <para style="q1" vid="PSA 140:7">ngeyo nkudi ama wu ngolo</para>
  <para style="q1" vid="PSA 140:7">ngeyo weti kaka ntuꞌama mu lumbu ki mvita.<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>Kadi tala zitsatu zi batu bambimbi zivangama, a Yave.</para>
  <para style="q1" vid="PSA 140:8">Kadi tala ti zikhanu ziawu zinunga</para>
  <para style="q1" vid="PSA 140:8">nganu bela ba luniemo.<verse eid="PSA 140:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>Bika mintu mi bobo banzungididi</para>
  <para style="q1" vid="PSA 140:9">mifuku kuidi ziphasi ziozi bididi biawu bitotula.<verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>Bika makala ma mbazu mabua va bawu.</para>
  <para style="q1" vid="PSA 140:10">Bika balozo ku mbazu, ku tsi mabulu madi nyamba ;</para>
  <para style="q1" vid="PSA 140:10">babika buela telama.<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>Bika mimvuezi mibika zingila mu tsi ;</para>
  <para style="q1" vid="PSA 140:11">bika mabienga malandakana mu kambu vonga batu badi makhemi.<verse eid="PSA 140:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>Nzebi ti Yave weti vana luvovomo lusonga kuidi nsukami</para>
  <para style="q1" vid="PSA 140:12">ayi wela nuanina minsukami.<verse eid="PSA 140:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>Bukiedika, basonga bela zitisa dizina diaku</para>
  <para style="q1" vid="PSA 140:13">ayi batu badi mintima milulama bela zingila va ntualꞌaku.<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="cl">Minkunga 141</para>
  <para style="s1">Bika wutsimba mu koko kuaku</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1"/>A Yave, ngeyo nditela ; yiza nsualu kuidi minu.</para>
  <para style="q1" vid="PSA 141:1">Wa mbemboꞌama mu thangu ndilembo kutedi.<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>Bika lusambulu luama luba va ntualꞌaku banga ansa<note caller="+" style="f"><char style="fr" closed="false">141.2 </char><char style="fq" closed="false">ansa</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">Tala Matayi 1.11.</char></note></para>
  <para style="q1" vid="PSA 141:2">bika mvumbudulu yi mioko miama yiba banga dikaba di masika.<verse eid="PSA 141:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>Tula nsungi va munu ama, a Yave ;</para>
  <para style="q1" vid="PSA 141:3">keba bumboti muelo wu bididi biama.<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>Kadi yinika ntimꞌama ku mambimbi,</para>
  <para style="q1" vid="PSA 141:4">mu baka kuku mu mavanga mambimbi</para>
  <para style="q1" vid="PSA 141:4">va kimosi ayi bamvanganga mambimbi ;</para>
  <para style="q1" vid="PSA 141:4">kadi tala ti ndidia bidia biawu bidi lueki.<verse eid="PSA 141:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>Bika mutu wusonga kambeta, diodi didi dimboti ;</para>
  <para style="q1" vid="PSA 141:5">bika kathemina, diodi didi mafuta va ntuꞌama ;</para>
  <para style="q1" vid="PSA 141:5">ayi ntuꞌama wulendi manga mawu ko.</para>
  <para style="q1" vid="PSA 141:5">Muaki lusambulu luama luela nuanisanga mu zithangu zioso</para>
  <para style="q1" vid="PSA 141:5">mavanga ma batu bamvanganga mambimbi.<verse eid="PSA 141:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6"/>Minyadi miawu miela lozo ku tsi tona ku yilu ngumbu</para>
  <para style="q1" vid="PSA 141:6">ayi batu bambimbi bela longuka ti mambu mama ndituba,</para>
  <para style="q1" vid="PSA 141:6">matubu bumboti.<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>Bela tuba : “mutu bu keti kabila ntoto ayi vasila ntoto</para>
  <para style="q1" vid="PSA 141:7">buawu bobo mimvesi mieto mididi misasakana</para>
  <para style="q1" vid="PSA 141:7">va muelo tsi bafua”.<verse eid="PSA 141:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>Vayi meso mama madi kaka kuidi ngeyo Yave,</para>
  <para style="q1" vid="PSA 141:8">mutu wumvanganga makazodidi</para>
  <para style="q1" vid="PSA 141:8">Kuidi ngeyo ndintombila suamunu,</para>
  <para style="q1" vid="PSA 141:8">kadi kundiekula mu lufua.<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>Wukheba mu makondi bathambila</para>
  <para style="q1" vid="PSA 141:9">ayi mu mintambu mitula batu bamvanganga mambimbi.<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>Bika batu bambimbi, babua mu makondi mawu veka</para>
  <para style="q1" vid="PSA 141:10">vayi minu ndiviokila vawu mu luvovomo.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="cl">Minkunga 142</para>
  <para style="s1">Ngeyo kaka suamunu kiama</para>
  <para style="d">Nkunga Davidi kayimbidila banga lusambulu mu thangu kaba mu nsuku.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1"/>Ndinyamikina ngolo kuidi Yave</para>
  <para style="q1" vid="PSA 142:1">Ndimvumbula mbembo ama kuidi Yave mu diambu di kiadi.<verse eid="PSA 142:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>Ndilembo dukula luniongo luama va ntualꞌandi ;</para>
  <para style="q1" vid="PSA 142:2">va ntualꞌandi, ndinyolukila ziphasi ziama.<verse eid="PSA 142:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>Mu thangu phevi ama yilembo suki-suki mu khati ama,</para>
  <para style="q1" vid="PSA 142:3">keti ngeyo wuzaba nzilꞌama.</para>
  <para style="q1" vid="PSA 142:3">Mu nsolo wowo ndidiatila, muawu batu bathambila ntambu.<verse eid="PSA 142:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>Tala ku lubakala luama ayi tala,</para>
  <para style="q1" vid="PSA 142:4">kadi mutu widi mayindu mu minu.</para>
  <para style="q1" vid="PSA 142:4">Ndisi kadi suamunu ko</para>
  <para style="q1" vid="PSA 142:4">kuisi ko mutu wumbanzila luzingu luama.<verse eid="PSA 142:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>Kuidi ngeyo ndinyamikina, a Yave.</para>
  <para style="q1" vid="PSA 142:5">Ndilembo tubi : “ngeyo suamunu kiama ;</para>
  <para style="q1" vid="PSA 142:5">Ngeyo kuku kiama va ntoto wu batu badi moyo.”<verse eid="PSA 142:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>Dimba yamikina kuama</para>
  <para style="q1" vid="PSA 142:6">bila ndidi nsukami wu ngolo, wukambulu diana ;</para>
  <para style="q1" vid="PSA 142:6">wukhula mu bobo balembo ndandakana bila bawu bandutidi ngolo.<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>Bika wuthotula nloko ama muingi ndizitisa dizina diaku ;</para>
  <para style="q1" vid="PSA 142:7">buna basonga bela kuiza kutakana va ndidi</para>
  <para style="q1" vid="PSA 142:7">mu diambu di mamboti maku kuidi minu.<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="cl">Minkunga 143</para>
  <para style="s1">Wundiatisa mu zinzila ziaku</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1"/>A Yave, wa lusambulu luama,</para>
  <para style="q1" vid="PSA 143:1">dimba yamikina kuama mu diambu di kiadi</para>
  <para style="q1" vid="PSA 143:1">mu kikhuikizi kiaku ayi mu busonga buaku,</para>
  <para style="q1" vid="PSA 143:1">yiza wutsadisa.<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>Kadi nata kisadi kiaku ku tsambusu ;</para>
  <para style="q1" vid="PSA 143:2">bila kadi mutu wumosi widi moyo widi wusonga va ntualꞌaku.<verse eid="PSA 143:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>Bila mbeni wulembo ndandakana,</para>
  <para style="q1" vid="PSA 143:3">wulembo ndiatidila va tsi ;</para>
  <para style="q1" vid="PSA 143:3">niandi wukuphuandisanga mu bibuangu bidi tombi</para>
  <para style="q1" vid="PSA 143:3">banga batu bobo bafua thama.<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>Buna pheve ama yeka suka-suka mu khati ama ;</para>
  <para style="q1" vid="PSA 143:4">ntimꞌama weka mona tsisi mu khati ama.<verse eid="PSA 143:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>Ndilembo tebukila moyo bilumbu bivioka.</para>
  <para style="q1" vid="PSA 143:5">Ndinyindulanga mavanga maku moso</para>
  <para style="q1" vid="PSA 143:5">ayi fiongunina mavanga ma mioko miaku.<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>Ndinonuna mioko miama kuidi ngeyo.</para>
  <para style="q1" vid="PSA 143:6">Muelꞌama widi phuila mu kumona</para>
  <para style="q1" vid="PSA 143:6">banga ntoto wu yuma, bu wididi phuila nlangu.<verse eid="PSA 143:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>Wuphani mvutu mu nsualu, a Yave</para>
  <para style="q1" vid="PSA 143:7">pheve ama yilembo yami.</para>
  <para style="q1" vid="PSA 143:7">Kadi kutsuekila zizi kiaku</para>
  <para style="q1" vid="PSA 143:7">bila ndieka dedakana banga bobo bankuendanga ku dibulu.<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>Bika nsuka wundatina mambu ma luzolo luaku lu ngolo ;</para>
  <para style="q1" vid="PSA 143:8">bila nditula diana diama mu ngeyo.</para>
  <para style="q1" vid="PSA 143:8">Wumbonisa nzila yoyi mfueti kuendila</para>
  <para style="q1" vid="PSA 143:8">bila kuidi ngeyo ndimvumbula muelꞌama.<verse eid="PSA 143:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>Wukhula mu bambeni ziama, a Yave ;</para>
  <para style="q1" vid="PSA 143:9">bila ndikukisuekanga mu ngeyo.<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>Wundonga mu vanga luzolo luaku</para>
  <para style="q1" vid="PSA 143:10">bila ngeyo Nzambi ama.</para>
  <para style="q1" vid="PSA 143:10">Bika pheve aku yimboti yindiatisa mu ntoto wulendumuka.<verse eid="PSA 143:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>Mu diambu di dizina diaku, a Yave, tamina luzingu luama ;</para>
  <para style="q1" vid="PSA 143:11">mu busonga buaku, bika wuthotula mu ziphasi.<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>Mu luzolo luaku lu ngolo, kanga bambeni ziama ;</para>
  <para style="q1" vid="PSA 143:12">bunga babo bobo beti kundenda, bila ndidi kisadi kiaku.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="cl">Minkunga 144</para>
  <para style="s1">Batu baku badi mu khini</para>
  <para style="d">Nkunga Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1"/>Bika, nzitusu wuba kuidi Yave, ditadi diama ;</para>
  <para style="q1" vid="PSA 144:1">weti longa mioko miama mu nuana mvita</para>
  <para style="q1" vid="PSA 144:1">ayi minlembo miama mu nuana khindu.<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>Niandi Nzambi ama yi luzolo ayi tinunu kiama</para>
  <para style="q1" vid="PSA 144:2">niandi suamunu kiama kingolo ayi niandi nkuidi ama,</para>
  <para style="q1" vid="PSA 144:2">niandi nkaku ama ;</para>
  <para style="q1" vid="PSA 144:2">mu niandi ndieti suamina</para>
  <para style="q1" vid="PSA 144:2">ayi niandi wuntulanga batu ku tsi luyalu luama.<verse eid="PSA 144:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>A Yave, buna mutu niandi nani muingi wumbelanga mayindu ;</para>
  <para style="q1" vid="PSA 144:3">muana mutu muingi wunyindulanga e ?<verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>Mutu dedakani banga phemo ;</para>
  <para style="q1" vid="PSA 144:4">bilumbu biandi bidi banga kitsusula kimvioka.<verse eid="PSA 144:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>Vasa diyilu diaku, a Yave, ayi kuluka ;</para>
  <para style="q1" vid="PSA 144:5">simba miongo muingi mitotula muisi.<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>Fidisa zitsiemo ku ntuala ayi sasikisa bambeni ziama.</para>
  <para style="q1" vid="PSA 144:6">Loza madionga maku ayi wuba zimbikisa.<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>Yalumuna koko kuaku bu widi ku yilu ;</para>
  <para style="q1" vid="PSA 144:7">wuphukisa ayi wukhula mu minlangu mi nguma</para>
  <para style="q1" vid="PSA 144:7">ayi mu mioko mi banzenza,<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>bobo miunu miwedi luvunu ;</para>
  <para style="q1" vid="PSA 144:8">bobo mioko mi lubakala mibeki mayuya.<verse eid="PSA 144:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>Ndiela kuyimbidila nkunga wumona, a Nzambi.</para>
  <para style="q1" vid="PSA 144:9">Mu siku ki kumi di minsinga, kioki beti tedila Lila, ndiela bula miziki,<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>Kuidi mutu wowo wumvananga kuidi mintinu ndungunu,</para>
  <para style="q1" vid="PSA 144:10">mutu wowo wunkulanga kisadi kiaku Davidi mu sabala kimvondanga.<verse eid="PSA 144:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>Wuphukisa ayi wukhula mu mioko mi banzenza ;</para>
  <para style="q1" vid="PSA 144:11">bobo miunu miwedi luvunu</para>
  <para style="q1" vid="PSA 144:11">bobo mioko mi lubakala mibeki mayuya.<verse eid="PSA 144:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>Buna bana beto babakala,</para>
  <para style="q1" vid="PSA 144:12">mu bumuana buawu bela ba banga bikunusu binyundukanga bumboti.</para>
  <para style="q1" vid="PSA 144:12">Bana beto babaketo</para>
  <para style="q1" vid="PSA 144:12">bela ba banga makunzi mafikulu ;</para>
  <para style="q1" vid="PSA 144:12">mammonisanga kitoko ki buangu.<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>Bilundulu bieto biela ba biwala mu kadika ntindu wu bidia ;</para>
  <para style="q1" vid="PSA 144:13">minkangu mieto mi mamemi miela buelama ayi buelama mu zimili zi</para>
  <para style="q1" vid="PSA 144:13">zimili mu makumi ma zimili mu zitsola zieto.<verse eid="PSA 144:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14"/>Zingombi zieto zikheto ziela nata mfuna wungolo,</para>
  <para style="q1" vid="PSA 144:14">mavudu malendi ba ko mu bibaka bieto</para>
  <para style="q1" vid="PSA 144:14">kadi buela kuenda mu kivika,</para>
  <para style="q1" vid="PSA 144:14">yamikina ku ziphasi kulendi ba diaka ko mu zinzila zieto.<verse eid="PSA 144:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>Lusakumunu kuidi batu bobo mambu mama meti vangama.</para>
  <para style="q1" vid="PSA 144:15">Lusakumunu kuidi batu bobo Yave kadidi Nzambi.<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="cl">Minkunga 145</para>
  <para style="s1">Kipfumu kiaku kidi mu zithangu zioso</para>
  <para style="d">Nkunga wu nzitusu wu Davidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1"/>Ndiela kuyayisa Ntinu, Nzambi ama.</para>
  <para style="q1" vid="PSA 145:1">Ndiela zitisa dizina diaku</para>
  <para style="q1" vid="PSA 145:1">mu zithangu zioso ayi mu mvu ka mvu.<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>Ndiela kuzitisa mu kadika lumbu</para>
  <para style="q1" vid="PSA 145:2">ayi ndiela yayisa dizina diaku</para>
  <para style="q1" vid="PSA 145:2">mu zithangu zioso ayi mu mvu ka mvu.<verse eid="PSA 145:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>Yave widi wunneni ayi niandi lutidi fuana mu zitusu</para>
  <para style="q1" vid="PSA 145:3">ayi bunneni buandi bulendi fiongonono ko kuidi mutu.<verse eid="PSA 145:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>Tsungi yimosi yela niemisa bisalu biaku</para>
  <para style="q1" vid="PSA 145:4">kuidi tsungi yinkaka</para>
  <para style="q1" vid="PSA 145:4">ayi bela yolukila mavanga maku ma lulendo.<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>Bela tubila kiezila ki nkembo wu nzitusu aku ;</para>
  <para style="q1" vid="PSA 145:5">ayi minu ndiela yindulanga bisalu biaku bitsiminanga.<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>Bela yolukila lulendo lu bisalu biaku bi tsisi ;</para>
  <para style="q1" vid="PSA 145:6">ayi ndiela yamikisa mavanga maku manneni.<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>Bela sanisina mamboti maku mawombo-wombo</para>
  <para style="q1" vid="PSA 145:7">ayi bela yimbidila busonga buaku mu khini.<verse eid="PSA 145:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>Yave widi nkua nlemvo ayi wumonanga kiadi ;</para>
  <para style="q1" vid="PSA 145:8">kavika fuemanga ko ayi fulukidi mu luzolo.<verse eid="PSA 145:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>Yave widi wumboti kuidi batu boso ;</para>
  <para style="q1" vid="PSA 145:9">kiadi kiandi kidi kuidi batu boso kavanga.<verse eid="PSA 145:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>Bibioso bi wuvanga biela kuzitisa, a Yave ;</para>
  <para style="q1" vid="PSA 145:10">banlongo baku bela kuyayisa.<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>Bela yolukila nkembo wu kipfumu kiaku</para>
  <para style="q1" vid="PSA 145:11">ayi bela tubila lulendo luaku,<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>mu diambu di batu boso bazaba mavanga maku ma lulendo ;</para>
  <para style="q1" vid="PSA 145:12">kiezila ki nkembo ki kipfumu kiaku.<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>Kipfumu kiaku kidi kipfumu mu thangu yi kayimani</para>
  <para style="q1" vid="PSA 145:13">ayi luyalu luaku lunzingilanga mu zitsungi zioso.</para>
  <para style="q1" vid="PSA 145:13">Yave widi wukuikama mu zitsila ziandi zioso</para>
  <para style="q1" vid="PSA 145:13">ayi nkua luzolo kuidi batu boso kavanga.<verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>Yave wunsimbanga babo bobo beti bua</para>
  <para style="q1" vid="PSA 145:14">ayi weti vumbula bobo badi bakomvama.<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>Meso ma babo makutalanga</para>
  <para style="q1" vid="PSA 145:15">ayi ngeyo weti bavana bidia mu thangu yifuana.<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>Ngeyo wunzibulanga koko kuaku</para>
  <para style="q1" vid="PSA 145:16">ayi wunyukutisanga zitsatu zi kadika kima kidi moyo.<verse eid="PSA 145:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>Yave widi wusonga mu zinzila ziandi zioso</para>
  <para style="q1" vid="PSA 145:17">ayi widi nkua luzolo kuidi batu boso kavanga.<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>Yave widi wufikama kuidi babo bobo bankutelanga,</para>
  <para style="q1" vid="PSA 145:18">kuidi babo bobo bankutelanga mu kiedika.<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>Niandi weti dedikisa zitsatu zi bobo beti ku kinzika ;</para>
  <para style="q1" vid="PSA 145:19">weti wa yamikina kuawu ayi weti ku bavukisa.<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>Yave weti sunga babo bobo beti kunzola</para>
  <para style="q1" vid="PSA 145:20">vayi wela bunga batu boso bambimbi.<verse eid="PSA 145:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>Munuꞌama wela yolukila nzitusu wu Yave,</para>
  <para style="q1" vid="PSA 145:21">bika kadika vangu kizitisa dizina diandi dinlongo</para>
  <para style="q1" vid="PSA 145:21">mu zithangu zioso ayi nate mu mvu ka mvu.<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="cl">Minkunga 146</para>
  <para style="s1">Yave weti nungisa batu bayamusu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>Luzitisa Yave ;</para>
  <para style="q1" vid="PSA 146:1">Zitisa Yave, a muelꞌama.<verse eid="PSA 146:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2"/>Ndiela zitisanga Yave mu luzingu luama loso ;</para>
  <para style="q1" vid="PSA 146:2">ndiela yimbidilanga Nzambi ama minzitusu</para>
  <para style="q1" vid="PSA 146:2">thangu yoso ndizingila.<verse eid="PSA 146:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>Kadi tula diana dieno mu bana ba mintinu,</para>
  <para style="q1" vid="PSA 146:3">mu batu bobo beti fua, bobo balendi vukisa ko.<verse eid="PSA 146:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4"/>Pheve awu yawu kuenda buna beti vutuka mu ntoto ;</para>
  <para style="q1" vid="PSA 146:4">zikhanu ziawu zilalikini.<verse eid="PSA 146:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>Lusakumunu kuidi mutu wowo widi ti Nzambi yi Yakobi</para>
  <para style="q1" vid="PSA 146:5">niandi nsadisi andi ;</para>
  <para style="q1" vid="PSA 146:5">wuntulanga diana diandi mu Yave, Nzambi andi,<verse eid="PSA 146:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>mvangi wu diyilu, ntoto, mbu ayi bibio bidi muna ;</para>
  <para style="q1" vid="PSA 146:6">widi wukuikama mu zithangu zioso.<verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>Niandi weti vavila mambu ma bobo beti yamusu,</para>
  <para style="q1" vid="PSA 146:7">ayi wumvananga bidia kuidi bobo badi nzala ;</para>
  <para style="q1" vid="PSA 146:7">Yave niandi weti totula batu bobo badi mu nloko.<verse eid="PSA 146:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8"/>Yave weti vana kiezila kuidi phofo,</para>
  <para style="q1" vid="PSA 146:8">Yave weti vumbula bobo badi bakomvama.</para>
  <para style="q1" vid="PSA 146:8">Yave weti zola batu basonga.<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>Yave weti sunga nzenza,</para>
  <para style="q1" vid="PSA 146:9">niandi wunkindisanga muana sana ayi difuola</para>
  <para style="q1" vid="PSA 146:9">vayi weti kakumukina zinzila zi batu bambimbi.<verse eid="PSA 146:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>Yave wunyalanga mu zithangu zioso.</para>
  <para style="q1" vid="PSA 146:10">Nzambi aku, a Sioni, mu zitsungi zioso.</para>
  <para style="q1" vid="PSA 146:10">Luzitisa Yave.<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="cl">Minkunga 147</para>
  <para style="s1">Nzambi mu nza ayi mu zithangu zioso</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1"/>Luzitisa Yave !</para>
  <para style="q1" vid="PSA 147:1">A phila mboti yidi mu yimbila minzitusu kuidi Nzambi eto.</para>
  <para style="q1" vid="PSA 147:1">A phila khini ayi fuana kuidi mu kunzitisa.<verse eid="PSA 147:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>Yave weti tunga Yelusalemi,</para>
  <para style="q1" vid="PSA 147:2">weti kutikisa bana ba Iseli bayenda mu kivika.<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>Niandi weti belusa mintima mi kosakana</para>
  <para style="q1" vid="PSA 147:3">ayi wunkanganga ziphasima mu ziphuta ziawu.<verse eid="PSA 147:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>Niandi weti zenga thalu yi zimbuetete</para>
  <para style="q1" vid="PSA 147:4">ayi weti kuzitedila kadika mbuetete mu dizina diandi.<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>Pfumu eto widi wunneni</para>
  <para style="q1" vid="PSA 147:5">ayi lulendo luandi luidi lunneni ;</para>
  <para style="q1" vid="PSA 147:5">diela diandi disi kadi ndilu ko.<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>Yave weti kindisa woso mutu weti kukikululanga</para>
  <para style="q1" vid="PSA 147:6">ayi weti lumba batu bambimbi va tsi.<verse eid="PSA 147:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>Luyimbidila Yave mu kumvutudilanga matondo ;</para>
  <para style="q1" vid="PSA 147:7">Lusikila Nzambi eto miziki mu ngitala.<verse eid="PSA 147:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>Niandi wufukidilanga diyilu mu matuti ;</para>
  <para style="q1" vid="PSA 147:8">wunkubikanga mvula mu diambu di ntoto</para>
  <para style="q1" vid="PSA 147:8">ayi niandi wummenisanga biti va mbata miongo mi fioti.<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>Niandi wumvananga bidia kuidi bibulu bi fioti</para>
  <para style="q1" vid="PSA 147:9">ayi kuidi bana ba ngonyi-ngonyi bu beti tela.<verse eid="PSA 147:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>Khini andi yisi ko mu zingolo zi phunda</para>
  <para style="q1" vid="PSA 147:10">ayi yangalala kuandi kuisi ko mu malu ma mutu.<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>Yave weti yangalala mu batu bobo beti kunkinzika,</para>
  <para style="q1" vid="PSA 147:11">bobo bantulanga diana diawu mu luzolo luandi lungolo.<verse eid="PSA 147:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>Yayisa Yave, a Yelusalemi ;</para>
  <para style="q1" vid="PSA 147:12">zitisa Nzambi aku, a Sioni ;<verse eid="PSA 147:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>bila niandi wunkindisanga zitunga zi mielo miaku ;</para>
  <para style="q1" vid="PSA 147:13">ayi weti sakumuna batu baku badi mu ngeyo.<verse eid="PSA 147:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>Niandi wuntulanga ndembama mu zindilu ziaku</para>
  <para style="q1" vid="PSA 147:14">ayi wukuyukutisanga mu ble yilutidi kitoko.<verse eid="PSA 147:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>Niandi wumfidisanga zithumunu ziandi ku ntoto ;</para>
  <para style="q1" vid="PSA 147:15">mambu mandi meti tembakana mu thinu nsualu.<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>Niandi wumvananga mvula yi matadi banga mika mi dimemi ;</para>
  <para style="q1" vid="PSA 147:16">ayi wuntembikisanga disala banga dibombi.<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>Niandi wunlonzanga mvulꞌandi yi matadi banga matadi ma fioti</para>
  <para style="q1" vid="PSA 147:17">Nani wulenda telama va ntuala phemo andi yi kiozi e ?<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>Weti fidisa mambu mandi ayi weti kumasiutisa ;</para>
  <para style="q1" vid="PSA 147:18">weti vemuna phemo yi ngolo andi</para>
  <para style="q1" vid="PSA 147:18">ayi minlangu mieti kumba.<verse eid="PSA 147:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>Niandi wuzabikisa mambu mandi kuidi Yakobi ;</para>
  <para style="q1" vid="PSA 147:19">mina miandi ayi zinzengolo ziandi kuidi Iseli.<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>Kasia bu vangila kadi kuidi dikanda dinkaka ko</para>
  <para style="q1" vid="PSA 147:20">basia zaba ko mina miandi.</para>
  <para style="q1" vid="PSA 147:20">Luzitisa Yave.<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="cl">Minkunga 148</para>
  <para style="s1">Mu diyilu ayi va ntoto</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1"/>Luzitisa Yave ;</para>
  <para style="q1" vid="PSA 148:1">luzitisa Yave tona mu diyilu.</para>
  <para style="q1" vid="PSA 148:1">Lunzitisa mu bibuangu bizangama ngolo.<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>Lunzitisa, beno zimbasi ziandi zioso ;</para>
  <para style="q1" vid="PSA 148:2">lunzitisa beno minkangu miandi mioso mi masodi ma diyilu.<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>Lunzitisa beno thangu ayi ngondi,</para>
  <para style="q1" vid="PSA 148:3">lunzitisa beno zimbuetete zioso zidi kiezila.<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>Lunzitisa ngeyo diyilu dizangama ngolo</para>
  <para style="q1" vid="PSA 148:4">ayi beno minlangu midi ku mbata diyilu,<verse eid="PSA 148:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>bika bizitisa dizina di Yave ;</para>
  <para style="q1" vid="PSA 148:5">bila niandi wuvana lutumunu ayi biawu bivangama.<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>Wubivuandisa va buangu</para>
  <para style="q1" vid="PSA 148:6">mu zithangu zioso ayi mu thangu yi kayimani.</para>
  <para style="q1" vid="PSA 148:6">Niandi wuvana nzengolo yayi, yikayilendi vioka ko.<verse eid="PSA 148:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>Luzitisa Yave tona va ntoto,</para>
  <para style="q1" vid="PSA 148:7">beno bivangu binneni bi mbu ayi beno zithipula zioso zi mbu ;<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>mbazu ayi mvula yi matadi, mvula yi phembi ayi matuti ;</para>
  <para style="q1" vid="PSA 148:8">vuka ki phemo kieti sadila zithumunu ziandi.<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>Beno miongo ayi miongo mioso mi fioti ;</para>
  <para style="q1" vid="PSA 148:9">minti mimbutanga makundi ayi minti mioso mi Sedeli ;<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>bibulu bi nsitu ayi bibulu bibioso bi fioti,</para>
  <para style="q1" vid="PSA 148:10">bivangu bi fioti ayi zinuni zieti dumuka ;<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>mintinu mi ntoto ayi makanda moso ;</para>
  <para style="q1" vid="PSA 148:11">beno bana ba mintinu ayi minyadi mioso mi ntoto ;<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>bamatoko ayi bandumba, binunu ayi bana balezi<verse eid="PSA 148:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>bika bazitisa dizina di Yave</para>
  <para style="q1" vid="PSA 148:13">bila dizina diandi diawu kaka difueni mu yayusu ;</para>
  <para style="q1" vid="PSA 148:13">kiezila kiandi kidi va yilu ntoto ayi ku yilu diyilu.<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>Niandi wutotudila batu bandi phoka,</para>
  <para style="q1" vid="PSA 148:14">nzitusu wu banlongo bandi boso ;</para>
  <para style="q1" vid="PSA 148:14">wu Iseli, batu bobo badi bakangama mu ntimꞌandi.</para>
  <para style="q1" vid="PSA 148:14">Luzitisa Yave.<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="cl">Minkunga 149</para>
  <para style="s1">Pfumu wunzolanga batu bandi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1"/>Luzitisa Yave ;</para>
  <para style="q1" vid="PSA 149:1">luyimbidila Yave nkunga wumona ;</para>
  <para style="q1" vid="PSA 149:1">nzitusu andi mu lukutukunu lu banlongo.<verse eid="PSA 149:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>Bika Iseli kamona khini mu diambu di mvangi awu</para>
  <para style="q1" vid="PSA 149:2">Bika batu ba Sioni bayangalala mu diambu di ntinu awu.<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>Bika bazitisa dizina diandi mu makinu ;</para>
  <para style="q1" vid="PSA 149:3">ayi bansikila miziki mu ndungu ayi mu ngitala,<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>bila Yave weti yangalala mu batu bandi,</para>
  <para style="q1" vid="PSA 149:4">weti vuatisa phulusu kuidi batu beti kukikula.<verse eid="PSA 149:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>Bika banlongo bamoma khan mu diambu di nzitusu wawu ;</para>
  <para style="q1" vid="PSA 149:5">ayi bayimbila mu khan mu zimbuka ziawu.<verse eid="PSA 149:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>Bika minzitusu mi Nzambi miba mu miunu miawu</para>
  <para style="q1" vid="PSA 149:6">ayi sabala kidi meno mu zindambu zioso mu mioko miawu ;<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>mu diambu di vutula landi kuidi makanda</para>
  <para style="q1" vid="PSA 149:7">ayi mu vana batu thumbudulu ;<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>mu diambu di kanga mintinu miawu mu zisieni</para>
  <para style="q1" vid="PSA 149:8">ayi batu bawu banneni mu bisengo ;<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>mu diambu di dukisa nzengolo yoyi yisonama mu diambu diawu ;</para>
  <para style="q1" vid="PSA 149:9">wawu wawu nkembo wu banlongo bandi boso.</para>
  <para style="q1" vid="PSA 149:9">Luzitisa Yave.<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="cl">Minkunga 150</para>
  <para style="s1">Luzitisa Nzambi mu miziki</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>Luzitisa Yave,</para>
  <para style="q1" vid="PSA 150:1">Luzitisa Nzambi mu buangu kiandi kinlongo.</para>
  <para style="q1" vid="PSA 150:1">Lunzitisa mu diyilu diandi di lulendo.<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>Lunzitisa mu diambu di mavanga mandi ma lulendo ;</para>
  <para style="q1" vid="PSA 150:2">lunzitisa mu diambu di bunneni buandi bu kambulu ndilu.<verse eid="PSA 150:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>Lunzitisa mu biyoko bi ntotukila mu tulumbeta,</para>
  <para style="q1" vid="PSA 150:3">Lunzitisa mu ngitala ayi mu Lila.<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>Lunzitisa mu ndungu ayi mu makinu ;</para>
  <para style="q1" vid="PSA 150:4">Lunzitisa mu bisiku bi minsinga ayi mu flute ;<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>Lunzitisa mu bisiku bidi banga zitapa ;</para>
  <para style="q1" vid="PSA 150:5">biobi bieti totula mbembo yingolo ;</para>
  <para style="q1" vid="PSA 150:5">Lunzitisa mu bisiku bidi banga zitapa,</para>
  <para style="q1" vid="PSA 150:5">biobi bilembo ningi.<verse eid="PSA 150:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>Bika bibioso bilembo vumuna bizitisa Yave.</para>
  <para style="q1" vid="PSA 150:6">Luzitisa Yave.<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
