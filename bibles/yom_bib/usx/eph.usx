<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Biblica® Open Kiyombe Contemporary New Testament and Psalms 2002</book>
  <para style="h">EFESO</para>
  <para style="toc1">Nkanda Polo kuidi basi Efeso</para>
  <para style="toc2">Efeso</para>
  <para style="toc3">Efeso</para>
  <para style="mt2">Nkanda Polo kuidi basi</para>
  <para style="mt1">Efeso</para>
  <chapter number="1" style="c" sid="EPH 1"/>
  <para style="s1">Zimboti</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1"/>Polo, mvuala wu Yesu Klisto mu luzolo lu Nzambi, fidisidi nkanda kuidi banlongo badi ku Efeso ayi kuidi bobo badi bakuikama mu Yesu Klisto.<verse eid="EPH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2"/>Bika Nzambi Dise dieto ayi Pfumu eto Yesu Klisto baluvana nlemvo ayi ndembama.<verse eid="EPH 1:2"/></para>
  <para style="ms1">LUVULUSU LUIDI MU KLISTO</para>
  <para style="s1">Nlemvo wu Nzambi mu Klisto.</para>
  <para style="q1">
    <verse number="3" style="v" sid="EPH 1:3"/>Bika Nzambi kakemboso,</para>
  <para style="q1" vid="EPH 1:3">niandi Dise di Pfumu eto Yesu Klisto !</para>
  <para style="q1" vid="EPH 1:3">Niandi wutusakumuna mu zitsakumunu zioso</para>
  <para style="q1" vid="EPH 1:3">zi phila mu phila zi kipheve mu Diyilu mu Klisto.<verse eid="EPH 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EPH 1:4"/>Tuamina tula zifundasio zi ntoto,</para>
  <para style="q1" vid="EPH 1:4">Nzambi wutusobula mu niandi</para>
  <para style="q1" vid="EPH 1:4">mu diambu tuba banlongo</para>
  <para style="q1" vid="EPH 1:4">ayi batu bakambulu tsembolo va ntualꞌandi<verse eid="EPH 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EPH 1:5"/>Bu didi ti niandi wutuzola,</para>
  <para style="q1" vid="EPH 1:5">wutukubika tona thama</para>
  <para style="q1" vid="EPH 1:5">muba bana bandi</para>
  <para style="q1" vid="EPH 1:5">mu Yesu Klisto ;</para>
  <para style="q1" vid="EPH 1:5">boso buididi luzolo luandi.<verse eid="EPH 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EPH 1:6"/>Mu diambu tusanisina</para>
  <para style="q1" vid="EPH 1:6">Nkembo wu nlemvo wu katuvanina</para>
  <para style="q1" vid="EPH 1:6">mu kiluzolo kiandi.<verse eid="EPH 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EPH 1:7"/>Mu niandi, beto tukudulu mu menga mandi ;</para>
  <para style="q1" vid="EPH 1:7">tutambudila nlemvo mu masumu meto</para>
  <para style="q1" vid="EPH 1:7">boso buididi kimvuama ki nlemvoꞌandi.<verse eid="EPH 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EPH 1:8"/>Wowo Nzambi kadukula mu</para>
  <para style="q1" vid="EPH 1:8">buwombo, mu beto, mu nzila</para>
  <para style="q1" vid="EPH 1:8">yi nzayulu ayi diela di phila mu phila.<verse eid="EPH 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EPH 1:9"/>Niandi wutuzabikisa matsueki ma luzolo luandi</para>
  <para style="q1" vid="EPH 1:9">boso bubela lukanu luandi lumboti</para>
  <para style="q1" vid="EPH 1:9">lukakitezila mu niandi.<verse eid="EPH 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EPH 1:10"/>Mu diambu di dedikisa luawu</para>
  <para style="q1" vid="EPH 1:10">zithangu bu ziela fuana :</para>
  <para style="q1" vid="EPH 1:10">kutikisa va kimosi bima bioso mu Klisto</para>
  <para style="q1" vid="EPH 1:10">biobi bidi ku diyilu ayi biobi bidi va ntoto<verse eid="EPH 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EPH 1:11"/>Mu diambu diandi beto tutambudi kuku kieto ki phulusu</para>
  <para style="q1" vid="EPH 1:11">boso buididi lukanu lu mutu wowo</para>
  <para style="q1" vid="EPH 1:11">wumvanganga bima bioso</para>
  <para style="q1" vid="EPH 1:11">mu luzolo luandi veka.<verse eid="EPH 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EPH 1:12"/>Mu diambu tusanisina nkembo andi,</para>
  <para style="q1" vid="EPH 1:12">beto tuba batheti mu</para>
  <para style="q1" vid="EPH 1:12">tula diana dieto mu Klisto.<verse eid="EPH 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EPH 1:13"/>Mu niandi beno mamveno,</para>
  <para style="q1" vid="EPH 1:13">bu lumana wa mambu ma kiedika,</para>
  <para style="q1" vid="EPH 1:13">Nsamu wumboti wu phulusu eno,</para>
  <para style="q1" vid="EPH 1:13">mu niandi luwilukila ayi lutudulu dimbu,</para>
  <para style="q1" vid="EPH 1:13">pheve yinlongo yoyo yivanunu tsila.<verse eid="EPH 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EPH 1:14"/>Pheve yinlongo yidi dimbu mu kutumonisa</para>
  <para style="q1" vid="EPH 1:14">ti tuela tambula kiuka kieto mu diambu</para>
  <para style="q1" vid="EPH 1:14">di khudulu yi batu bobo Nzambi,</para>
  <para style="q1" vid="EPH 1:14">kakibakila mu diambu di sanisina nkembo andi.<verse eid="EPH 1:14"/></para>
  <para style="s1">Lusambulu lu Polo mu diambu di basi Efeso</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15"/>Diawu tona mamvama bu ndiwilu buididi minu kieno mu Pfumu Yesu ayi luzolo luidi yeno mu banlongo boso ; <verse eid="EPH 1:15"/><verse number="16" style="v" sid="EPH 1:16"/>ndivonganga ko mu kuluvutudilanga matondo kuidi Nzambi. Ndieti kulutebukilanga moyo mu zitsambulu ziama ; <verse eid="EPH 1:16"/><verse number="17" style="v" sid="EPH 1:17"/>mu diambu Nzambi yi Pfumuꞌeto Yesu Klisto, dise di nkembo kaluvana pheve yi nzayulu ayi yi tsongolo muingi lunzaba bumboti, <verse eid="EPH 1:17"/><verse number="18" style="v" sid="EPH 1:18"/>muingi kakienzula diela dieno ayi lusudika boso buididi diana diodi Nzambi kalutedila ayi boso buididi kimvuama ki nkembo wu kiuka kiandi va khatitsika banlongo ; <verse eid="EPH 1:18"/><verse number="19" style="v" sid="EPH 1:19"/>ayi boso buididi bunneni bu lulendo lolo luidi mu beto tuwilukila ; boso buididi lulendo lu zingolo ziandi. <verse eid="EPH 1:19"/><verse number="20" style="v" sid="EPH 1:20"/>Wumonisa lulendo beni bu kafulukisa Klisto mu bafua ayi bu kamvuandisa va koko kuandi ku lubakala, mu Diyilu ; <verse eid="EPH 1:20"/><verse number="21" style="v" sid="EPH 1:21"/>va yilu luyalu loso, kikulutu kioso, lulendo loso, kipfumu kioso ayi va yilu dizina dioso dizabikini ; bika sia ti mu tsungi yayi kaka vayi nate mu tsungi yela kuiza. <verse eid="EPH 1:21"/><verse number="22" style="v" sid="EPH 1:22"/>Wutula bima bioso ku tsi bitambi biandi ayi wumbieka Pfumuyi bima bioso mu Dibundu. <verse eid="EPH 1:22"/><verse number="23" style="v" sid="EPH 1:23"/>Dibundu diawu nitu andi, fuluka ku mutu wowo wumfulusanga bima bioso mu bibuangu bioso.<verse eid="EPH 1:23"/></para>
  <chapter eid="EPH 1"/>
  <chapter number="2" style="c" sid="EPH 2"/>
  <para style="s1">Tuba bafua vayi tufuluka</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1"/>Mu thama beno bu luba bafua mu zinzimbala zieno ayi mu masumu meno ; <verse eid="EPH 2:1"/><verse number="2" style="v" sid="EPH 2:2"/>mu mawu beno ludiatila boso buididi ntoto wawu ayi boso buididi Pfumu yi lulendo lu mbimbi, pheve yinsalanga mu batu badi matingu.<verse eid="EPH 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 2:3"/>Beto mamveto, tuba banga bawu ; tuzingila boso bubela zinzinunu zieto zi kinsuni ayi tudukisa luzolo lu nsuni ayi lu mayindu meto. Mu kimutu beto tuba batu bobo zinganzi zi Nzambi zifueti buila banga batu bankaka.<verse eid="EPH 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4"/>Vayi Nzambi nkua kimvuama mu kiadi mu diambu di luzolo lunneni lolokatuzodila ; <verse eid="EPH 2:4"/><verse number="5" style="v" sid="EPH 2:5"/>wutuzingisa va kimosi ayi Klisto ; beto bobo tuba bafua mu diambu di zinzimbala zieto. Mu nlemvo luvukila. <verse eid="EPH 2:5"/><verse number="6" style="v" sid="EPH 2:6"/>Wutufulukisa va kimosi ayi niandi ayi wutuvuandisa va kimosi, mu Diyilu, mu Klisto Yesu <verse eid="EPH 2:6"/><verse number="7" style="v" sid="EPH 2:7"/>mu diambu katumonisa mu zitsungi ziela kuiza bunneni bu kimvuama ki nlemvo andi mu diambu di mamboti mandi kuidi beto mu Klisto Yesu.<verse eid="EPH 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 2:8"/>Bila mu nlemvo luvukila ; mu nzila yi minu. Luvulusu beni lusia ba kuidi beno ko vayi didi dikaba di Nzambi. <verse eid="EPH 2:8"/><verse number="9" style="v" sid="EPH 2:9"/>Bika sia ti mu mavanga luvukila muingi mutu kabika kuandi kukiniemisa. <verse eid="EPH 2:9"/><verse number="10" style="v" sid="EPH 2:10"/>Bila beto tuidi bivangu biandi ; tuvangu mu Klisto Yesu mu diambu di vanganga mavanga mamboti momo Nzambi kakubika tona thama muingi tusadila mawu.<verse eid="EPH 2:10"/></para>
  <para style="s1">Beto boso tuidi mutu wumosi mu Klisto</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11"/>Diawu, lutebuka moyo ti beno luba Bapakanu mu nsuni, baba kulutedilanga batu bakambu zengo kuidi bobo baba tedilanga bazengo. Nzengolo beni yivangimina, mu nitu, mu mioko mi batu. <verse eid="EPH 2:11"/><verse number="12" style="v" sid="EPH 2:12"/>Lutebuka moyo ti mu thangu beni, beno luba bavambana ayi Klisto, lusia ba minsua mu vuanda mu divula di Iseli ko bila luba banzenza mu zinguizani ziozi zivanunu tsila ; luba batu basobolo kuidi Nzambi ko bila luba banzenza mu zinguizani zi Nzambi zivanunu tsila ; luba batu bakambulu diana ayi bakambulu Nzambi va ntoto.<verse eid="EPH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 2:13"/>Vayi buabu, mu Klisto Yesu ; beno lutuama ba thama ayi Nzambi vayi luyikidi bafikama mu diambu di menga matengula Klisto.<verse eid="EPH 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14"/>Bila niandi ndembama yeto. Niandi wukitula Bayuda ayi Bapakanumutu wumosi ayi niandi wutiolumuna baka ki kithatu kioki kiba vambisa. <verse eid="EPH 2:14"/><verse number="15" style="v" sid="EPH 2:15"/>Bila mu nsuni andi niandi wuvonda mina va kimosi ayi zithumunu ziandiayi minsiku miandi. Diodi divangimina mu diambu di vanga mu niandi veka mutu wumosi wumona wuntotukila mu batu buadi. Buawu bobo kakotisila ndembama. <verse eid="EPH 2:15"/><verse number="16" style="v" sid="EPH 2:16"/>Mu diambu kabaka bu vutudila, mu nzila yi dikulusi, nguizani yi bawu buadi mu nitu yimosi kuidi Nzambi bu kavondila kimbeni kiawu va dikulusi.<verse eid="EPH 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 2:17"/>
    <char style="qt">Klisto wuyiza ayi wusamuna ndembama kuidi beno luba thama ayi wusamuna ndembama kuidi bobo baba bafikama.</char> <verse eid="EPH 2:17"/><verse number="18" style="v" sid="EPH 2:18"/>Bila, mu diambu diandi, beto yawu tubeki minsua mu kota kuidi Tata mu Pheve yimosi.<verse eid="EPH 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19"/>Diawu, beno lusiedi diaka banzenza ko voti minkibi ko, vayi lueka buabu basi tsi va kimosi ayi banlongo ayi basi nzo yi Nzambi. <verse eid="EPH 2:19"/><verse number="20" style="v" sid="EPH 2:20"/>Beno lutungu va yilu fundasio yi bamvuala ayi mimbikudi. Yesu Klisto, niandi ditadi di mfunu di fuma.<verse eid="EPH 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 2:21"/>Mu niandi nzo yoso yibundusulu va kimosi ayi yilembo yundukamu diambu yiba Nzo yi Nzambi yinlongo mu Pfumu. <verse eid="EPH 2:21"/><verse number="22" style="v" sid="EPH 2:22"/>Ayi mu niandi, beno lulembo tungulu va kimosi mu diambu lukituka nzo yimvuandanga Nzambi mu Pheve.<verse eid="EPH 2:22"/></para>
  <chapter eid="EPH 2"/>
  <chapter number="3" style="c" sid="EPH 3"/>
  <para style="s1">Kisalu ki Polo</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1"/>Mu diambu dieno beno Bapakanu, diawu minu Polo ndididi wukangama mu nloko wu Klisto. <verse eid="EPH 3:1"/><verse number="2" style="v" sid="EPH 3:2"/>Bila ndimbanza luwa phila yididi kisalu ki nlemvo kioki Nzambi kaphana mu diambu dieno. <verse eid="EPH 3:2"/><verse number="3" style="v" sid="EPH 3:3"/>Mu tsongolo, niandi wunzabikisa matsueki ma lukanu luandi. Mawumomo ndilusudikisidi mu zindambu zi mambu manneni. <verse eid="EPH 3:3"/><verse number="4" style="v" sid="EPH 3:4"/>Beno tanga wawu buna ma lusudika bumboti boso buididi diela diamamu diambu di matsueki momo ma Klisto. <verse eid="EPH 3:4"/><verse number="5" style="v" sid="EPH 3:5"/>Muaki mu zitsungi zikhulu Nzambi kasia tuama zabikisa matsueki beni kuidi batu ko banga phila kazabikisidi mawu buabu mu lusadusu lu pheve Yinlongo kuidi bamvuala bandi ayi kuidi mimbikudi miandi.<verse eid="EPH 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 3:6"/>Dinsueki beni diawu diadi : mu diambu di Nsamu Wumbote, Bapakanu mu kithuadi kiawu ayi Yesu Klisto, babeki minsua va kimosi ayi Bayuda mu tambula kiuka kimosi kioki Nzambi kalembo lundila batu bandi. Beka binama binitu yimosi ayi bafubikini mu tsila yoyo Nzambi kavana mu Klisto Yesu. <verse eid="EPH 3:6"/><verse number="7" style="v" sid="EPH 3:7"/>Minu ndiyika kisadi ki Nsamu beni Wumboti boso buididi dikaba di nlemvo wu Nzambi ; nlemvo wowo kaphana mu lulendo luandi. <verse eid="EPH 3:7"/><verse number="8" style="v" sid="EPH 3:8"/>Nyinga, minu ndidi mutu wulutidi kambu minsua mu banlongo bosovayi Nzambi wuphana nlemvo wowo, wu samunina kuidi Bapakanu kimvuama ki Klisto bu kabulendi tezakana ko. <verse eid="EPH 3:8"/><verse number="9" style="v" sid="EPH 3:9"/>Ayi mu diambu di sudikisa bumboti va meso ma batu boso, buevi Nzambi, mutu wuvanga bima bioso, kalembo dukisila matsueki momo masueko thama ; <verse eid="EPH 3:9"/><verse number="10" style="v" sid="EPH 3:10"/>muingi buabu, mu nzila yi Dibundu, minyadi ayi bakulutu boso badi mu diyilu bazaba buididi diela di Nzambi mu ziphila zioso ; <verse eid="EPH 3:10"/><verse number="11" style="v" sid="EPH 3:11"/>banga bu kakubikila mawu tona thama momo malembo dedakana mu Klisto Yesu, Pfumu eto. <verse eid="EPH 3:11"/><verse number="12" style="v" sid="EPH 3:12"/>Mu diambu diandi ayi mu diambu di minu mu niandi buabu tubeki minsua mu telama va zizi ki Nzambi mu diana dioso. <verse eid="EPH 3:12"/><verse number="13" style="v" sid="EPH 3:13"/>Diawu ndikululomba, lubika vonga mu diambu di ziphasi ziama ziozindilembo moni mu diambu dieno ; bila ziawu zidi nkemboꞌeno.<verse eid="EPH 3:13"/></para>
  <para style="s1">Zaba luzolo lu Nzambi</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14"/>Diawu ndieta fukimina, va ntuala Tata ; <verse eid="EPH 3:14"/><verse number="15" style="v" sid="EPH 3:15"/>bila mu niandi makanda moso ma batu bawilukila madi va ntoto ayi ku diyilu batambudila dizina. <verse eid="EPH 3:15"/><verse number="16" style="v" sid="EPH 3:16"/>Ndinkulombanga, boso buididi kimvuama ki nkemboꞌandi, mu diambu kalukindisa mu lulendo mu nzila yi Pheve andi mu matedi mutu wu khati. <verse eid="EPH 3:16"/><verse number="17" style="v" sid="EPH 3:17"/>Ayi mu diambu di Klisto kavuanda mu mintima mieno mu minu. Ndinlombanga diaka ti beno lumena mianzi ayi lutungu bumboti mu luzolo. <verse eid="EPH 3:17"/><verse number="18" style="v" sid="EPH 3:18"/>Buna buawu bobo lulenda baka bu sudikila va kimosi ayi banlongo boso phila luzolo lu Klisto luididi siadila, kula, phinda ayi zangama, <verse eid="EPH 3:18"/><verse number="19" style="v" sid="EPH 3:19"/>ayi zabila luzolo beni ti luawu luviatukidi nzayulu yoso ayi muingi luba bafuluka mu kinzambi kioso ki Nzambi.<verse eid="EPH 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20"/>Bika mutu wowo wulenda vanga mu buwombo-wombo viokila momo tueti lombanga voti tueti yindulanga boso buididi lulendo luandi lolo lueti sala mu beto, <verse eid="EPH 3:20"/><verse number="21" style="v" sid="EPH 3:21"/>katambula nkembo mu Dibundu ayi mu Klisto Yesu mu zitsungizioso ayi mu mimvu mioso ! Ameni.<verse eid="EPH 3:21"/></para>
  <chapter eid="EPH 3"/>
  <chapter number="4" style="c" sid="EPH 4"/>
  <para style="ms1">LUZINGU LU DIBUNDU DIMONA</para>
  <para style="s1">Tukeba kithuadi</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1"/>Minu Polo, ndidi mu nloko mu diambu di Pfumu ndikululeba, ludiatila mu khadulu yifuanikini ayi mbila yoyo kalutedila. <verse eid="EPH 4:1"/><verse number="2" style="v" sid="EPH 4:2"/>Bika luba batu bazebi kukikulula ; badi nlembami ayi mvibudulu. Bika, mu luzolo, kadika mutu kazaba kanga ntima mu diambu di ndiandi. <verse eid="EPH 4:2"/><verse number="3" style="v" sid="EPH 4:3"/>Lunuana ngolo mu keba kithuadi mu Pheve Yinlongo, mu nzila yi ndembama. <verse eid="EPH 4:3"/><verse number="4" style="v" sid="EPH 4:4"/>Nitu yidi yimosi kaka ayi Pheve yidi yimosi kaka. Bobuawu Nzambi wulutela ku diana dimosi.<verse eid="EPH 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 4:5"/>Pfumu yidi yimosi kaka, minu kidi kimosi kaka ayi mbotokolo yidi yimosi kaka. <verse eid="EPH 4:5"/><verse number="6" style="v" sid="EPH 4:6"/>Nzambi widi wumosi kaka, niandi dise di babo, wunyadilanga batu boso, wunsalanga mu babo ayi widi mu babo.<verse eid="EPH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7"/>Vayi kadika mutu mu beto wutambula nlemvo boso bubela dikaba di Klisto. <verse eid="EPH 4:7"/><verse number="8" style="v" sid="EPH 4:8"/>Diawu katubila :</para>
  <para style="q1" vid="EPH 4:8">
    <char style="qt">Bu kakuma ku Diyilu, wunata basi nloko</char></para>
  <para style="q1" vid="EPH 4:8">
    <char style="qt">ayi wuvana batu makaba.</char><verse eid="EPH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 4:9"/>Vayi diambu diadi : wukuma ku Diyilu buevi dinsundula e ? Dinsundula wutuama kuluka kuna tsi ntoto. <verse eid="EPH 4:9"/><verse number="10" style="v" sid="EPH 4:10"/>Mutu wowo wukuluka, niandi kuandi wukuma ku yilu vioka diyilu mu diambu kawesa bima bioso.<verse eid="EPH 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 4:11"/>Bila niandi wuvana dikaba kuidi bankaka mu ba bamvuala, bankakamimbikudi, bankaka minsamuni mi Nsamu Wumboti, bankaka mimvungi<note caller="+" style="f"><char style="fr" closed="false">4.11 </char><char style="ft" closed="false">Minsekudi minkaka misonika pasitele va buangu ki Mvungi.</char></note> ayi bankaka minlongi. <verse eid="EPH 4:11"/><verse number="12" style="v" sid="EPH 4:12"/>Wuvanga buawu mu diambu di fuanisa banlongo mu sala kisalu kiawu ayi mu diambu di thungulu yi nitu yi Klisto ; <verse eid="EPH 4:12"/><verse number="13" style="v" sid="EPH 4:13"/>nate beto boso tuela tula mu kithuadi kimosi mu minu ayi mu zaba bumboti Muana Nzambi ayi mu tula mu tezo ki mutu wuyunduka ; mutu wowo wudedikini mu khudulu yiduka yi Klisto.<verse eid="EPH 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 4:14"/>Buna tulendi buela ba bana balezi ko, bobo bannatungu ayi bandiengosongo kuidi yoso-yoso pheve yi malongi meti singimina mu luvunulu batu ayi mu diela diawu di mbimbi di sadila zinzila zimbimbi mu diambu di zimbisa batu.<verse eid="EPH 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 4:15"/>Vayi beto zingilanga boso buididi mu luzolo, buna tuela yunduka mu mamo nate kuidi Klisto ; niandi ntu wu Dibundu.<verse eid="EPH 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EPH 4:16"/>Mu niandi nitu yimvimba yidi yiyikakana ayi yibundana bumboti mu madikulu madi mu nitu. Buna kadika nama bu kieti sala kisalu kiandi mu bufuana, nitu yimvimba yilembo yunduka ayi yilembo tungu yawu veka mu luzolo.<verse eid="EPH 4:16"/></para>
  <para style="s1">Luzingu lumona mu Klisto</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17"/>Tala diambu ndikulukamba ayi ndibuela vutudila mu Pfumu ti : lubika buela diatila banga Bapakanu, banlandakananga mayindu mawu ma buvungisi <verse eid="EPH 4:17"/><verse number="18" style="v" sid="EPH 4:18"/>ayi diela diawu didi mu tombi. Diawu badidi banzenza mu luzingu lu Nzambi mu diambu di buvulu buidi mu bawu, buntotukilanga mu mintimamiawu midi banga matadi. <verse eid="EPH 4:18"/><verse number="19" style="v" sid="EPH 4:19"/>Bazimbisa mambu moso momo ma kimutu ; bakiyekula mu vanganga mambuma tsoni mu diambu bavanga mambu moso masumuka ma phila mu phila.<verse eid="EPH 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20"/>Vayi buawu ko beno lulongukila Klisto. <verse eid="EPH 4:20"/><verse number="21" style="v" sid="EPH 4:21"/>Bila beno lusudika mambu momo batuba mu diambu diandi ayi momo balulonga mu niandi mu phila yi mambu ma kiedika madi mu Yesu. <verse eid="EPH 4:21"/><verse number="22" style="v" sid="EPH 4:22"/>Buna lubika nzingulu eno yi khulu, luloza kimutu kieno kikhulu kiokizinzinunu zi luvunu zilembo bivisa. <verse eid="EPH 4:22"/><verse number="23" style="v" sid="EPH 4:23"/>Vayi lukituka bamona mu pheve yi diela dieno. <verse eid="EPH 4:23"/><verse number="24" style="v" sid="EPH 4:24"/>Bika luvuata mutu wumona, wuvangulu boso bubela mayindu ma Nzambi, mu busonga ayi mu bunlongo bu kiedika.<verse eid="EPH 4:24"/></para>
  <para style="s1">Luzingu mu luzolo</para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25"/>Diawu lubika vunasana beno na beno, vayi, bika kadika mutu katuba mambu ma kiedika kuidi ndiandi, bila beto boso tuidi binama bi nitu yimosi. <verse eid="EPH 4:25"/><verse number="26" style="v" sid="EPH 4:26"/>Enati fuema lufuemini, lukeba tala luedi vola masumu ; lubika lunda nganzi nate va masika. <verse eid="EPH 4:26"/><verse number="27" style="v" sid="EPH 4:27"/>Lubika vana satana diluaku.<verse eid="EPH 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EPH 4:28"/>Mutu wowo wubedi yibanga bika kabika buivi ; vayi bika kasala ayi kasala mu mioko miandi kisalu kioki kidi kifuana mu diambu kabakabiobi kafueti kabudila bobo badi basukama.<verse eid="EPH 4:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EPH 4:29"/>Bika mambu mambimbi mabika totukila mu miunu mieno. Vayi momo kaka madi mamboti, mafueni mu tunga minu boso buididi zitsatu ziawu mu diambu mamonisa mamboti kuidi batu bobo balembo wa mawu.<verse eid="EPH 4:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EPH 4:30"/>Lubika monisa pheve Yinlongo yi Nzambi kiadi bila mu Pheve beni Nzambi katudila dimbu kiandi mu beno mu diambu di lumbu ki khudulu.<verse eid="EPH 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EPH 4:31"/>Bika mambu ma ndudi, ma kikhesi, ma nganzi ayi ma yamikinina, ma mfingulu mabotuka mu beno va kimosi ayi mambu mamo mambimbi. <verse eid="EPH 4:31"/><verse number="32" style="v" sid="EPH 4:32"/>Bika kadika mutu kamonika mutu wumboti kuidi ndiandi ; lumonasanangakiadi, lulemvukilanga badieno banga bobo Nzambi kalulemvukila mu Klisto.<verse eid="EPH 4:32"/></para>
  <chapter eid="EPH 4"/>
  <chapter number="5" style="c" sid="EPH 5"/>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1"/>Sumbu luidi bana bobo Nzambi keta zola, bika lusokudila Tata.<verse eid="EPH 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 5:2"/>Ayi ludiatila mu luzolo banga bu tuzodila Klisto bu kakiyekula niandi veka kuidi Nzambi mu diambu dieto banga malasi ma tsudi yi kitoko ayi banga dikaba.<verse eid="EPH 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3"/>Kitsuza ayi zitsumukunu zinkaka zi phila mu phila ayi zitsatu mu baka bima bi phila mu phila, zibika monika mu beno boso buididi bufuana kuidi banlongo. <verse eid="EPH 5:3"/><verse number="4" style="v" sid="EPH 5:4"/>Ka diambu ko mambu matsoni, mambu ma buvungisi ayi malueya mabika monika mu beno bila masi fuana kuidi beno ko. Vayi bika, mu mambu meno, luzaba vutudilanga Nzambi matondo. <verse eid="EPH 5:4"/><verse number="5" style="v" sid="EPH 5:5"/>Bila luzebi kueno ti nkua kitsuza, nsumuki voti mutu wunzolanga baka bima bi phila mu phila (niandi dedikini ayi mutu wunsambilangabitumba) kalendi baka kiuka ko mu kipfumu ki Klisto ayi ki Nzambi.<verse eid="EPH 5:5"/></para>
  <para style="s1">Luzingu mu kiezila</para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6"/>Mutu kabika kuluvuna mu mambu ma phamba. Bila mu diambu di mambu ma phila yoyo, nganzi yi Nzambi yeta buila batu bobo bazolanga ko kuntumukina.<verse eid="EPH 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 5:7"/>Diawu kadi fubakana ayi batu ba phila yoyo. <verse eid="EPH 5:7"/><verse number="8" style="v" sid="EPH 5:8"/>Bila bubedi, beno lubedi tombi vayi buabu lueka kiezila mu Pfumu. Bika ludiatila banga bana bakiezila ! <verse eid="EPH 5:8"/><verse number="9" style="v" sid="EPH 5:9"/>Bila kiezila kimbutanga mamboti, busonga ayi kiedika. <verse eid="EPH 5:9"/><verse number="10" style="v" sid="EPH 5:10"/>Luzaba sobulanga mambu moso meti monisanga Pfumu khini.<verse eid="EPH 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 5:11"/>Lubika fubakana mu mavanga ma tombi ; momo mabutanga ko makundivayi bika lutumbudila mawu. <verse eid="EPH 5:11"/><verse number="12" style="v" sid="EPH 5:12"/>Bila mambu momo beta vanga mu kitsueki, tsoni madi mu yolukila mawu. <verse eid="EPH 5:12"/><verse number="13" style="v" sid="EPH 5:13"/>Vayi kiezila bu kiela totula mambu moso va nganda buna bosi mela monika. <verse eid="EPH 5:13"/><verse number="14" style="v" sid="EPH 5:14"/>Kiezila kiawu kintotulanga bima bioso va nganda. Diawu beta tubila ti :</para>
  <para style="q1" vid="EPH 5:14">Kotuka kuaku ngeyo wulembo leki tulu ;</para>
  <para style="q1" vid="EPH 5:14">fuluka mu tsi bafua,</para>
  <para style="q1" vid="EPH 5:14">ayi Klisto wela ku kienzula.<verse eid="EPH 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15"/>Diawu, lukeba mu diambu di phila yoyo lufueti diatila mu bufuana. Lubika ba banga bivungisi, vayi bika luba batu badiela. <verse eid="EPH 5:15"/><verse number="16" style="v" sid="EPH 5:16"/>Muaki lusadila thangu, bila bilumbu bi tueka bieka bimbimbi.<verse eid="EPH 5:16"/></para>
  <para style="s1">Luzingu mu Pheve</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 5:17"/>Diawu lubika ba banga bivungisi vayi lusudika bumboti boso buididiluzolo lu Pfumu.<verse eid="EPH 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18"/>Lubika kolongo malavu, bila mu mawu mueti totukila divunzi vayi bika luba bawala mu Pheve. <verse eid="EPH 5:18"/><verse number="19" style="v" sid="EPH 5:19"/>Bika lukikindisanga mu minkunga mikubuku, mu minkunga mi sanisinaayi mu minkunga mi kipheve. Luyimbila ayi lusanisina Pfumu mu mintimamieno mimvimba. <verse eid="EPH 5:19"/><verse number="20" style="v" sid="EPH 5:20"/>Mu zithangu zioso, luvutudilanga Nzambi Tata matondo mu mambu mamo mu dizina di Pfumuꞌeto Yesu Klisto.<verse eid="EPH 5:20"/></para>
  <para style="s1">Zindubu kuidi babakala ayi baketo</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21"/>Bika kadika mutu kakinzika ndiandi mu diambu di lukinzu luidi yeno mu Klisto. <verse eid="EPH 5:21"/><verse number="22" style="v" sid="EPH 5:22"/>Beno baketo, lukinzika babakala beno banga bu lueta kinzikila Pfumu. <verse eid="EPH 5:22"/><verse number="23" style="v" sid="EPH 5:23"/>Bila bakala niandi Pfumu yi nketo banga Klisto bu kadidi Pfumu yi Dibundu, nituꞌandi. Niandi Mvulusi wu dibundu beni. <verse eid="EPH 5:23"/><verse number="24" style="v" sid="EPH 5:24"/>Sumbu Dibundu didi ku tsi minsua mi Klisto, buawu bobo baketobafueti bedla ku tsi minsua mi babakala bawu mu mambu moso.<verse eid="EPH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25"/>Beno babakala, luzola baketo beno banga Klisto bu kazodila Dibundu, bila wukiyekula mu diambu di Dibundu beni, <verse eid="EPH 5:25"/><verse number="26" style="v" sid="EPH 5:26"/>muingi kadikitula di nlongo mu mambu mandi ayi di vedila bu kamanisa ku disukula mu nlangu, <verse eid="EPH 5:26"/><verse number="27" style="v" sid="EPH 5:27"/>muingi kadimonisa kuidi niandi veka, Dibundu di kitoko, dikambulu ditona di mvindu, dikambulu minkanza, voti dikambulu diambu di phila yoyi vayi didi dinlongo ayi dikambulu tsembolo.<verse eid="EPH 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EPH 5:28"/>Bobuawu babakala bafueti zola baketo bawu banga bu beta zodila zinitu ziawu. Bila bakala diodi dieta zola nketo andi buna weta kukizola niandi veka. <verse eid="EPH 5:28"/><verse number="29" style="v" sid="EPH 5:29"/>Bila kuisi ko mutu weta lenda nitu andi. Vayi wukuyidikilanga, wukuyikebanga banga Klisto bu keta kebila Dibundu, <verse eid="EPH 5:29"/><verse number="30" style="v" sid="EPH 5:30"/>bila beto tuidi binama bi nitu andi.<verse eid="EPH 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EPH 5:31"/>
    <char style="qt">Diawu bakala kela bikila dise diandi ayi ngudi andi mu diambu di bundana ayi nketo andi, ayi, bawu buadi bela kituka nitu yimosi.</char><verse eid="EPH 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EPH 5:32"/>Disuama diodi didi dinneni ; vayi ndinyolukila mu diambu di Klisto ayi dibundu. <verse eid="EPH 5:32"/><verse number="33" style="v" sid="EPH 5:33"/>Vayi mu diambu dieno, bika kadika bakala kazola nketo andi bangabu keta kukizodila niandi veka ayi kadika nketo kakinzika bakala diandi.<verse eid="EPH 5:33"/></para>
  <chapter eid="EPH 5"/>
  <chapter number="6" style="c" sid="EPH 6"/>
  <para style="s1">Zindubu kuidi bana ayi bambuta</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1"/>Beno bana, lutumukina bambuta beno mu Pfumu bila buawu bufueni. <verse eid="EPH 6:1"/><verse number="2" style="v" sid="EPH 6:2"/><char style="qt">Kinzika Dise diaku ayi ngudi aku bila wawu muina wutheti widi ayi tsila.</char> Tala tsila beni yawu yayi : <verse eid="EPH 6:2"/><verse number="3" style="v" sid="EPH 6:3"/><char style="qt">muingi wumona mamboti ayi wuzinga buwombo va ntoto.</char><verse eid="EPH 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4"/>Diawu, beno madisa lubika fuemisanga bana beno vayi luba yundudila mu kuba vananga zindongi ayi zindubu mu Pfumu.<verse eid="EPH 6:4"/></para>
  <para style="s1">Zindubu kuidi bapfumu ayi bavika</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5"/>Beno bavika, lutumukina bapfumu zieno zi ntoto mu lukinzu ayi mu lukhuku mu kiedika kioso ki ntima banga kuidi Klisto. <verse eid="EPH 6:5"/><verse number="6" style="v" sid="EPH 6:6"/>Lusala kisalu kieno bika sia ti mu thangu zilembo ku lusungi bangati beno luntomba monisa batu khini, vayi banga bavika ba Klisto miomi mieta vanga luzolo lu Nzambi mu mintima mimboti. <verse eid="EPH 6:6"/><verse number="7" style="v" sid="EPH 6:7"/>Bika lusala kisalu kieno mu luzolo lumboti banga beno lunsadila Pfumuvayi bika batu. <verse eid="EPH 6:7"/><verse number="8" style="v" sid="EPH 6:8"/>Bila luzebi ti Pfumu wela futa kadika mutu mu dioso-dioso diambudi bumboti diela vanga mutu, kaba mvika voti mutu wu kiphuanza.<verse eid="EPH 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9"/>Beno bapfumu bobuawu luvangila bavika baeno. Lubika kuba yamisa bila ayi beno ayi bawu Pfumu yimosi kaka yidi yeno, yoyo yidi ku diyilu. Bila niandi katalanga bizizi bi batu ko.<verse eid="EPH 6:9"/></para>
  <para style="s1">Luvuata binduanina bi Nzambi</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10"/>Mu manisa, bika lukikindisanga mu Pfumu ayi mu lulendo lu zingolo ziandi.<verse eid="EPH 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 6:11"/>Bila kioki luvuata binduanina bioso bi Nzambi muingi lubakabu telimina va ntuala luvunu lu satana. <verse eid="EPH 6:11"/><verse number="12" style="v" sid="EPH 6:12"/>Bila mvita yeto yisi yi nsuni ko ayi yi menga ko, vayi tueti nuanisanga bikulutu, bipfumu, batu ba lulendo badi mu tombi ayi tunuanisanga ziphevi zimbimbi zidi mu tsi yi kipheve.<verse eid="EPH 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 6:13"/>Diawu lubonga binduanina bioso bi Nzambi, mu diambu lubaka bu kukitabila mu lumbu kimbimbi ayi bu lumeni nunga lutelama nanguinate kuna tsuka. <verse eid="EPH 6:13"/><verse number="14" style="v" sid="EPH 6:14"/>Diawu, lutelama, lukanga kiedika mu luketo lueno banga sentila<note caller="+" style="f"><char style="fr" closed="false">6.14 </char><char style="fq" closed="false">Sentila</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">nsinga wowo babakala bamvuatilanga phatula.</char></note> ayi bika luvuata busonga bu Nzambi banga kikhutu kisengo<note caller="+" style="f"><char style="fr" closed="false">6.14 </char><char style="fq" closed="false">Kikhutu kisengo</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">kimvuatanga masodi mu thangu yi mvita.</char></note>. <verse eid="EPH 6:14"/><verse number="15" style="v" sid="EPH 6:15"/>Bika bufula bu longa Nsamu wumboti wu ndembama buba zisapatu mumalu meno.<verse eid="EPH 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EPH 6:16"/>Bika va yilu mambu moso, lubonga minu banga nkaku wowo lulendazimina madionga moso ma mbazu mamfidisanga mutu wu mbimbi. <verse eid="EPH 6:16"/><verse number="17" style="v" sid="EPH 6:17"/>Bika phulusu luba budu kisengo mu mintu mieno ayi mambu ma Nzambi maba mbedi yi Pheve.<verse eid="EPH 6:17"/></para>
  <para style="s1">Lutelo mu diambu di sambila</para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 6:18"/>Mu lusadusu lu Pheve, lusambila zitsambulu zioso zi phila mu philaayi zindombolo mu zithangu zioso. Luvanga buawu mu thatumunu yingoloayi lubika vonga. Lusambidila banlongo boso. <verse eid="EPH 6:18"/><verse number="19" style="v" sid="EPH 6:19"/>Bika lutsambidila mu diambu di mu thangu ndinzibula munu, ndibaka mambu mafueni, momo ndilenda tuba mu diambu di samuna mu kibakala matsueki ma Nsamu Wumbote. <verse eid="EPH 6:19"/><verse number="20" style="v" sid="EPH 6:20"/>Mu diambu di Nsamu wumboti beni ndididi mvuala, mvuala wowo widiwukangama mu zisieni. Lusambila mu diambu ndisamuna wawu mu kibakalabanga mu phila mfueti kuwuyolukila.<verse eid="EPH 6:20"/></para>
  <para style="s1">Zimboti</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21"/>Mu diambu di luzaba phila ndididi ayi mambu ndilembo vangi, buna khombꞌeto wu luzolo Titsike, widi kisadi kikuikama mu kisalu ki Pfumu, wela ku lukamba mambu moso madi mu diambu diama. <verse eid="EPH 6:21"/><verse number="22" style="v" sid="EPH 6:22"/>Mu bila kioki ndilufidisidi niandi muingi kalukamba zitsangu zieto ayi kabomba mintima mieno.<verse eid="EPH 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23"/>Bika Nzambi Tata ayi Pfumu Yesu Klisto bavana bakhomba zioso ndembama, luzolo ayi minu. <verse eid="EPH 6:23"/><verse number="24" style="v" sid="EPH 6:24"/>Bika nlemvo wuba kuidi babo bobo banzolanga Pfumu eto Yesu Klisto mu luzolo lu kiedika.<verse eid="EPH 6:24"/></para>
  <chapter eid="EPH 6"/>
</usx>
