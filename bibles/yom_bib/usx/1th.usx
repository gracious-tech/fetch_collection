<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Biblica® Open Kiyombe Contemporary New Testament and Psalms 2002</book>
  <para style="h">1 TESALONIKA</para>
  <para style="toc1">Nkanda wutheti wu Polo kuidi basi Tesalonika</para>
  <para style="toc2">1 Tesalonika</para>
  <para style="toc3">1 Tesalonika</para>
  <para style="mt2">Nkanda wutheti wu Polo kuidi basi</para>
  <para style="mt1">Tesalonika</para>
  <chapter number="1" style="c" sid="1TH 1"/>
  <para style="s1">Thonono</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1"/>Polo, Sila ayi Timote tufidisidi nkanda kuidi Dibundu di Tesalonika, divuiwulu kuidi Tata Nzambi ayi kuidi Pfumu Yesu Klisto.</para>
  <para style="p" vid="1TH 1:1">Bika nlemvo ayi ndembama bibanga yeno.<verse eid="1TH 1:1"/></para>
  <para style="s1">Minu ayi kifuani ki basi Tesalonika</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2"/>Beto tueti vutudila Nzambi matondo mu diambu dieno mu zithangu ziosobu tukulutebukilanga moyo mu zitsambulu zieto, <verse eid="1TH 1:2"/><verse number="3" style="v" sid="1TH 1:3"/>bu tukulutebukilanga moyo mu zithangu zioso va meso ma Nzambi, dise dieto, mu diambu di mavanga malembo monika mu minu kieno, kisalu ki luzolo lueno, mvibudulu yintotukila mu diana dieno di ngolo mu Pfumu eto Yesu Klisto.<verse eid="1TH 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4"/>Bila beno bakhomba zi luzolo, tuzebi ti Nzambi wulusobula. <verse eid="1TH 1:4"/><verse number="5" style="v" sid="1TH 1:5"/>Bila Nsamu eto wumboti wusia kuiza kuidi beno ko mu thubulu ko, vayi mu lulendo, mu pheve yinlongo ayi mu diana dingolo.</para>
  <para style="p" vid="1TH 1:5">Ayi luzebi bumbote phila tuzingila va khatitsikꞌeno mu diambu di luzolo mu beno. <verse eid="1TH 1:5"/><verse number="6" style="v" sid="1TH 1:6"/>Beno lukituka minsokudidi mieto ayi mi Pfumu bu lutambula mambu mu ziphasi ziwombo va kimosi ayi khini yi Pheve Yinlongo. <verse eid="1TH 1:6"/><verse number="7" style="v" sid="1TH 1:7"/>Buawu bobo luyikidi ntungulu kuidi batu boso bobobawilukidi badi ku Maseduani ayi ku Akayi.<verse eid="1TH 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TH 1:8"/>Bila, mambu ma Pfumu mamuanginina kuidi beno ; bika sia ti mu Maseduani ayi mu Akayi kaka vayi mu bibuangu bioso minu kieno mu Nzambikimuangana ayi tusiedi ko mfunu mu buela yolukila kiawu. <verse eid="1TH 1:8"/><verse number="9" style="v" sid="1TH 1:9"/>Bila bawu veka balembo tubi phila lutuyakudila ayi phila lubalukila kuidi Nzambi bu lumanga buela sadila bitumba mu diambu lusadila Nzambi yi moyo ayi yi kiedika, <verse eid="1TH 1:9"/><verse number="10" style="v" sid="1TH 1:10"/>ayi mu diambu di vingila Muanꞌandi wela ba ku Diyilu wowo kafulukisa mu bafua Yesu niandi muanꞌandi, wukututaninanga mu zinganzi ziela kuiza.<verse eid="1TH 1:10"/></para>
  <chapter eid="1TH 1"/>
  <chapter number="2" style="c" sid="1TH 2"/>
  <para style="ms1">POLO AYI BATU BAWILUKILA BA BASI TESALONIKA</para>
  <para style="s1">Polo wulubula basi Tesalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1"/>Bakhomba baama, beno veka luzebi ti kuiza tuyiza kuidi beno kusia bakuphamba ko ; <verse eid="1TH 2:1"/><verse number="2" style="v" sid="1TH 2:2"/>bu tumana mona ziphasi ayi fingu ku Filipi banga bu luzebi. Vayi Nzambi wutuvana diana dingolo di kulusamunina Nsamu Wumbote wu Nzambi va khatitsika ziphasi ziwombo.<verse eid="1TH 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 2:3"/>Bila lubula koko tueti lubula kuisi ko ti mu diambu di zimbisa, mu diambu di sumuna ko voti mu diambu di vuna. <verse eid="1TH 2:3"/><verse number="4" style="v" sid="1TH 2:4"/>Sumbu didi ti Nzambi wutumona ti tuidi bafuana mu yekudulu Nsamu wumbote buna diawu tueti tubila, bika sia ti, mu diambu di monisa batu khini vayi mu diambu di monisa Nzambi khini bila niandi weti fionguninanga mintima mieto.<verse eid="1TH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1TH 2:5"/>Bila kadi khumbu yimosi tusia sadila mambu ma luvunu ko ayi ma mayuyamu diambu di yiba zimbongo zieno banga bu luzebi ; Nzambi niandi mbangi eto. <verse eid="1TH 2:5"/><verse number="6" style="v" sid="1TH 2:6"/>Tusia tomba ko ti batu batuniemisa ; buba ti kuidi beno voti kuidi batu bankaka. <verse eid="1TH 2:6"/><verse number="7" style="v" sid="1TH 2:7"/>Nganu tulenda singimina mu beno banga bamvuala ba Klisto vayi tuba batu balembama bu tuba kuidi beno banga ngudi wundikilanga bana bandi. <verse eid="1TH 2:7"/><verse number="8" style="v" sid="1TH 2:8"/>Mu diambu di luzolo lunneni ayi lungolo luidi yeto mu diambu dieno ; buawu bobo tuzola, bika sia ti kulusamunina Nsamu wumbote kaka vayikuluyekudila luzingu lueto bila beno lukituka bakiluzolo bieto. <verse eid="1TH 2:8"/><verse number="9" style="v" sid="1TH 2:9"/>Bila bakhomba, lueti tebukila ziphasi zieto ayi kisalu kieto moyo ; bila tusala builu ayi muini muingi tubika singimina kadi mutu wumosi mu beno bu tululonga Nsamu Wumbote wu Nzambi. <verse eid="1TH 2:9"/><verse number="10" style="v" sid="1TH 2:10"/>Beno veka luidi bambangi ayi Nzambi mamvandi mbangi buevi tuzingila mu nzingulu yinlongo, yisonga, ayi, yikambu tsembolo kuidi beno bawilukila. <verse eid="1TH 2:10"/><verse number="11" style="v" sid="1TH 2:11"/>Luzebi buevi tulubudila kadika mutu mu beno : banga dise bu ketalubudila bana bandi. <verse eid="1TH 2:11"/><verse number="12" style="v" sid="1TH 2:12"/>Tululubula, tulubomba ayi tululeba muingi ludiata mu bufueni mu Nzambi, mutu wukulutelanga ku kipfumu kiandi ayi ku nkembo andi.<verse eid="1TH 2:12"/></para>
  <para style="s1">Minu ayi ziphasi zi basi Tesalonika</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13"/>Diawu beto mamveto, tuvonganga ko mu vutudila Nzambi matondo mu diambu dieno bila lutambula mambu ma Nzambi momo tululonga ; lusiamatambula banga mambu ma batu ko vayi bukiedika lukikinina ti mawu madi mambu ma Nzambi. Mawu meti sala mu beno luwilukila.<verse eid="1TH 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 2:14"/>Bila beno, bakhomba, lukituka minsokudidi mi mabundu ma Nzambi madi mu Yuda ; manwilukilanga Klisto Yesu bila beno mamveno lumonusu ziphasi kuidi basi tsi eno ; zioziawu ziphasi ziba monisa Bayuda. <verse eid="1TH 2:14"/><verse number="15" style="v" sid="1TH 2:15"/>Bawu bavonda Pfumu Yesu ayi mimbikudi ; bawu batuyamisa ngolo. Bamonisanga Nzambi khini ko ayi badi bambeni zi batu boso. <verse eid="1TH 2:15"/><verse number="16" style="v" sid="1TH 2:16"/>Balembo tukakidila tubika longa Bapakanu muingi babika vuka ; mu diambu diodi balembo buedila masumu va mbata masumu mawu mu zithangu zioso. Vayi ku tsuka, nganzi yi Nzambi yela bua va bawu.<verse eid="1TH 2:16"/></para>
  <para style="s1">Polo wufidisa Timote</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17"/>Zikhomba, kuidi beto, bu tumana vambana yeno mu ndambu thangu mu nitu vayi bika mu pheve, buna tutomba mu phuila yingolo mu buela kulumona. <verse eid="1TH 2:17"/><verse number="18" style="v" sid="1TH 2:18"/>Diawu tuzodila buela kuiza kuidi beno. Minu veka Polo, khumbu yimosi ayi mu zikhumbu zizole nditia kuiza kuidi beno vayi Satana wutukakidila.<verse eid="1TH 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 2:19"/>Bila banani diana dieto ; khini eto voti budu kieto ki ndungunukiokio tufueti kukiniemisina va meso ma Pfumu eto Yesu Klisto mu lumbu kioki kela vutuka e ? Keti beno e ? <verse eid="1TH 2:19"/><verse number="20" style="v" sid="1TH 2:20"/>Bukiedika beno luidi nkembo eto ayi khini eto.<verse eid="1TH 2:20"/></para>
  <chapter eid="1TH 2"/>
  <chapter number="3" style="c" sid="1TH 3"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1"/>Diawu, bu tumona ti tukadi buela vibidila, buna tumona ti bufueni kuidi beto mu siala ku Atene ; <verse eid="1TH 3:1"/><verse number="2" style="v" sid="1TH 3:2"/>ayi tufidisa Timote, khombꞌetoayi kisadi yeto mu Nzambi mu tsamununu yi Nsamu wumbote wu Klisto mu diambu kiza lukindisa mu minuayi kuluvana bufula <verse eid="1TH 3:2"/><verse number="3" style="v" sid="1TH 3:3"/>muingi mutu wumosi mu beno kabika zimbisa minu kiandi mu diambu di ziphasi ziazi ; beno veka bu luzebi ti tukubukulu ziawu. <verse eid="1TH 3:3"/><verse number="4" style="v" sid="1TH 3:4"/>Bila mu thangu tuba yeno, tululubula ti tufueti mona ziphasi ziwombo. Ayi luzebi ti buawu buvangama. <verse eid="1TH 3:4"/><verse number="5" style="v" sid="1TH 3:5"/>Diawu minu mamvama, bu ndimona ti ndikadi buela vibidila, diawu nditumina Timote mu diambu di zaba kani buevi buekila minu kieno. Bomandimona bila ndibanizla ti mvukumuni wuluvukumuni bila nganu kisalu kioso kitusala ikitukidi kiphamba.<verse eid="1TH 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6"/>Buabu Timote wuvutukidi kuidi beto bu kabedi kuidi beno ayi zitsangu zikatunatini zidi zimboti mu wa buididi minu kieno ayi luzololueno. Wutukembi ti lukutuyindulanga buwombo bu lumonanga tsatu mu kutumona banga beto bu tuididi tsatu mu kulumona.<verse eid="1TH 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 3:7"/>Diawu bakhomba, beto tukindusu mu diambu dieno mu nzila yi minu kieno mu ziphasi zieto zioso ayi mayama meto moso <verse eid="1TH 3:7"/><verse number="8" style="v" sid="1TH 3:8"/>bila buabu tulembo zingi enati luidi bakinda ngolo mu Pfumu. <verse eid="1TH 3:8"/><verse number="9" style="v" sid="1TH 3:9"/>A buna buevi tulenda vutudilanga Nzambi matondo mawombo mu diambu dieno, mu diambu dieno, mu diambu di khini yoso tueti mona mu diambu dieno va meso ma Nzambi eto e ?<verse eid="1TH 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 3:10"/>Bila builu ayi muini tueti sambila ngolo muingi tumonana zizi mu zizi ayi tudukisa mambu makambulu mu minu kieno.<verse eid="1TH 3:10"/></para>
  <para style="s1">Lusambulu lu Polo</para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11"/>Bika Nzambi eto ayi niandi veka Dise, ayi, Pfumuꞌeto Yesu batuzibudila diluaku di buela kuiza kuidi beno. <verse eid="1TH 3:11"/><verse number="12" style="v" sid="1TH 3:12"/>Mu diambu dieno bika Pfumu kafunisa ayi kawokisa luzolo lueno mu benona beno ayi kuidi batu boso, banga buididi luzolo lueto kuidi beno. <verse eid="1TH 3:12"/><verse number="13" style="v" sid="1TH 3:13"/>Bika kakindisa mintima mieno muingi mikambu tsembolo va mesoma Nzambi eto ayi Dise mu thangu Pfumu eto Yesu kela vutuka va kimosi ayi banlongo bandi boso.<verse eid="1TH 3:13"/></para>
  <chapter eid="1TH 3"/>
  <chapter number="4" style="c" sid="1TH 4"/>
  <para style="ms1">ZITHUMUNU</para>
  <para style="s1">Lutelo ku luzingu lu nlongo</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1"/>Zikhomba, mu manisa, beto tululonga buevi buzingila luzingu lummonisanga Nzambi khini ; ayi buawu bobo lulembo zingila. Buabu tukululomba ayi ku lulubula mu Pfumu Yesu mu luta buela vanga ngolo.<verse eid="1TH 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 4:2"/>Bila luzebi mboti zithumunu ziozi tuluvana mu Pfumu Yesu. <verse eid="1TH 4:2"/><verse number="3" style="v" sid="1TH 4:3"/>Bila vava vadi luzolo lu Nzambi : luzingila mu luzingu lunlongo ayi lutina kitsuza ; <verse eid="1TH 4:3"/><verse number="4" style="v" sid="1TH 4:4"/>ayi kadika mutu kazaba yadila nitu andi mu bunlongo ayi mu lukinzu, <verse eid="1TH 4:4"/><verse number="5" style="v" sid="1TH 4:5"/>bika sia ti mu zinzinunu banga bu mvangilanga Bapakanu, batu bakambulu zaba Nzambi. <verse eid="1TH 4:5"/><verse number="6" style="v" sid="1TH 4:6"/>Diawu mu diambu diodi, mutu kabika vangila ndiandi mbimbi voti kumvuna bila banga bu tutuama kulukamba ayi kululubula ti Pfumu niandi weti vutula landi mu mambu moso momo. <verse eid="1TH 4:6"/><verse number="7" style="v" sid="1TH 4:7"/>Bila Nzambi kasia tutela ku tsumukunu ko vayi wututela ku bunlongo.<verse eid="1TH 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TH 4:8"/>Diawu woso mutu wunlenza zithumunu ziazi, buna bika sia ti batu kalenzidi vayi Nzambi kalenzidi, mutu wukuluvananga pheve andi yinlongo.<verse eid="1TH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9"/>Vayi mu diambu di luzolo lu kikhomba, kadi kuandi mfunu ndilusonikina diaka bila niandi veka Nzambi wululongisa buevi lufueti zolisinina beno na beno. <verse eid="1TH 4:9"/><verse number="10" style="v" sid="1TH 4:10"/>Ayi buawu bobo lulembo vangila mu diambu di bakhomba ziozo badi mu Maseduani dioso. Vayi tukululubula diaka, bakhomba mu luta buela kuenda ku ntuala ; <verse eid="1TH 4:10"/><verse number="11" style="v" sid="1TH 4:11"/>muingi luzingila mu ndembama, mu sala bisalu bieno veka ayi lusala mu mioko mieno banga bu tulutumina. <verse eid="1TH 4:11"/><verse number="12" style="v" sid="1TH 4:12"/>Mu diambu ludiatila mu bufueni kuidi bobo badi ku nganda<note caller="+" style="f"><char style="fr" closed="false">4.12 </char><char style="fq" closed="false">Bobo badi ku nganda</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">dinsundula ti batu bobo bakambulu mu dikanda di bana ba Nzambi.</char></note> ayi lubika singimina mutu.<verse eid="1TH 4:12"/></para>
  <para style="s1">Bafua bafuluka ayi phutukulu yi Pfumu</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13"/>Zikhomba, tumengi ti lubika zaba mu diambu di batu bobo bafua muingi lubika ba mu kiadi banga buididi batu bobo bankaka bakambulu diana.<verse eid="1TH 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 4:14"/>Bila enati tueti wilukila ti Yesu wufua ayi wufuluka, buna bobuawu batu bobobafua mu Yesu, Nzambi wela kuba nata va kimosi ayi niandi.<verse eid="1TH 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15"/>Bila diawu diadi diambu tutidi kulukamba boso buididi mambu ma Pfumu : beto tukidi zingi nate Pfumu bu kela vutuka, tulendi ba tuamina batuko bobo bafua. <verse eid="1TH 4:15"/><verse number="16" style="v" sid="1TH 4:16"/>Bila lutumunu bu luela vanu, mbembo yi nkulutu wu zimbasi bu yela wakana ; tulumbeta yi Nzambi bu yela siku, buna niandi veka Pfumuwela kuluka bu kela totukila ku Diyilu. Buna batu bobo bafuila mu Klisto, bela tuama fuluka theti ; <verse eid="1TH 4:16"/><verse number="17" style="v" sid="1TH 4:17"/>bosi beto tunzinga nate mu lumbu kina, buna tuela natu mu matuti vakimosi ayi bawu mu diambu di kuenda dengana Pfumu mu matuti. Buna tuela kalanga va kimosi ayi Pfumu mu zithangu zioso.<verse eid="1TH 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1TH 4:18"/>Diawu lukikindisanga beno na beno mu mambu mama.<verse eid="1TH 4:18"/></para>
  <chapter eid="1TH 4"/>
  <chapter number="5" style="c" sid="1TH 5"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1"/>Zikhomba, kadi kuandi mfunu balusonikina mu diambu di mambu matedizithangu ayi zitsungi. <verse eid="1TH 5:1"/><verse number="2" style="v" sid="1TH 5:2"/>Bila beno veka luzebi mbote ti lumbu ki Pfumu kiela kuiza banga muivi va builu.<verse eid="1TH 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 5:3"/>Batu bu bela tuba : “Beto tuidi mu ndembama ayi mu luvovomo” Buna mbivusu yingolo yela babuila mu kinzimbukila banga mianga mi nketo weka buta ayi balendi baka bu tinina ko.<verse eid="1TH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4"/>Vayi beno bakhomba, luisi mu tombi ko muingi lumbu beni kibika kulubuila banga muivi. <verse eid="1TH 5:4"/><verse number="5" style="v" sid="1TH 5:5"/>Bila beno boso luidi bana ba kiezila, bana ba muini. Bila beto tuisibana ba tombi ayi ba builu ko. <verse eid="1TH 5:5"/><verse number="6" style="v" sid="1TH 5:6"/>Diawu tubika leka tulu banga bankaka vayi tuzibula meso ayi tubika ba phulu yi dia ayi yi nua.<verse eid="1TH 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 5:7"/>Bobo banlekanga, va builu beta leka ; ayi batu bobo bankolongo, va builu beti kolo. <verse eid="1TH 5:7"/><verse number="8" style="v" sid="1TH 5:8"/>Vayi beto bana ba muini, bika tubika ba phulu yi dia ayi yi nua. Bika tuvuata minu ayi luzolo banga nkaku vayi diana di phulusu diawubudu kieto. <verse eid="1TH 5:8"/><verse number="9" style="v" sid="1TH 5:9"/>Bila Nzambi kasia kutukubikila ko nganzi vayi wutukubikila mu tambula phulusu mu Pfumuꞌeto Yesu Klisto, <verse eid="1TH 5:9"/><verse number="10" style="v" sid="1TH 5:10"/>niandi wufua mu diambu dieto, mu diambu buba ti tulembo zingi voti tuidi bafua, tuzinga yandi va kimosi. <verse eid="1TH 5:10"/><verse number="11" style="v" sid="1TH 5:11"/>Diawu lulubasana ayi lutungasana beno na beno boso bu lueti vangila.<verse eid="1TH 5:11"/></para>
  <para style="s1">Zindubu</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12"/>Zikhomba ; tueti kululeba mu kinzikanga batu bobo bansalanga ngolo va khatitsikꞌeno, bobo bakulutuadisanga mu dizina di Pfumu ayi bakululubulanga. <verse eid="1TH 5:12"/><verse number="13" style="v" sid="1TH 5:13"/>Luba kinzika buwombo ayi luba zola ngolo mu diambu di kisalu kiawu. Bika luzingilanga mu ndembama mu beno na beno.<verse eid="1TH 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14"/>A bakhomba, tueti kululeba mu lubula batu bobo banzingilanga mubukambu fuana ; lubomba batu bobo badi bakambulu bufula, lusadisa batu balebakana, luba luvibidila batu boso. <verse eid="1TH 5:14"/><verse number="15" style="v" sid="1TH 5:15"/>Lukeba mboti muingi mutu kabika vutudila ndiandi mbimbi mu mbimbivayi lutombanga vanga mambote mu beno na beno ayi kuidi batu boso.<verse eid="1TH 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16"/>Lumonanga khini mu zithangu zioso. <verse eid="1TH 5:16"/><verse number="17" style="v" sid="1TH 5:17"/>Lusambilanga mu kambu vonga. <verse eid="1TH 5:17"/><verse number="18" style="v" sid="1TH 5:18"/>Luvutulanga matondo mu mambu moso bila buawu bobo buididi luzolo lu Nzambi, mu diambu dieno, mu Klisto Yesu.<verse eid="1TH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19"/>Lubika zima pheve. <verse eid="1TH 5:19"/><verse number="20" style="v" sid="1TH 5:20"/>Lubika lenzanga zimbikudulu. <verse eid="1TH 5:20"/><verse number="21" style="v" sid="1TH 5:21"/>Vayi lufionguninanga mambu moso ; bika lusimbidila mambote. <verse eid="1TH 5:21"/><verse number="22" style="v" sid="1TH 5:22"/>Lutina mambu mambimbi, mu ziphila zioso.<verse eid="1TH 5:22"/></para>
  <para style="s1">Lusambulu ayi zimbote</para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23"/>Bika niandi veka Nzambi yi ndembama kaluvedisa ayi kakeba bumboti pheve eno, muela ayi nitu eno yimvimba mu kambulu tsembolo nate mu lumbu kiela kuiza Pfumuꞌeto Yesu Klisto. <verse eid="1TH 5:23"/><verse number="24" style="v" sid="1TH 5:24"/>Mutu wulutela widi wukuikama ayi niandi wela vanga buawu.<verse eid="1TH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25"/>A bakhomba ; luzambilanga mu diambu dieto.<verse eid="1TH 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26"/>Luvana bakhomba zioso mbote mu besi kinlongo.<verse eid="1TH 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27"/>Ndikululeba mu Pfumu ti nkanda wawu wutangulu bakhomba zioso.<verse eid="1TH 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28"/>Bika nlemvo wu Pfumu eto Yesu Klisto wubanga yeno.<verse eid="1TH 5:28"/></para>
  <chapter eid="1TH 5"/>
</usx>
