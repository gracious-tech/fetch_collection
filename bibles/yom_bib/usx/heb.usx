<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Biblica® Open Kiyombe Contemporary New Testament and Psalms 2002</book>
  <para style="h">Ba Ebelewo</para>
  <para style="toc1">Nkanda kuidi ba Ebelewo</para>
  <para style="toc2">Ebelewo</para>
  <para style="toc3">Ebelewo</para>
  <para style="mt2">Nkanda kuidi ba</para>
  <para style="mt1">Ebelewo</para>
  <chapter number="1" style="c" sid="HEB 1"/>
  <para style="ms1">BUMUTU BU MUANA WU NZAMBI</para>
  <para style="s1">Nzambi wukimonikisa mu Muanꞌandi</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1"/>Mu zikhumbu ziwombo ayi mu zinzila ziwombo, Nzambi wuyolukila mutsi khulu, bakulu beto mu nzila yi mimbikudi. <verse eid="HEB 1:1"/><verse number="2" style="v" sid="HEB 1:2"/>Vayi mu bilumbu biabi bi tsuka Nzambi wutuyolukila mu Muanꞌandi, mutu wowo kabieka mvingidi wu bima bioso ayi mu niandi kavangila bima bioso. <verse eid="HEB 1:2"/><verse number="3" style="v" sid="HEB 1:3"/>Muana beni wulembo monikisa lezama ku nkembo wu Nzambi ayi niandi mfikula yimonisa bumboti bumutu buandi. Niandi weta kindisa bima bioso mu mambu mandi ma lulendo. Bu kamanisa kubika tsukudulu yi masumu ; buna wuvuanda ku Diyilu va koko ku lubakala lu Nzambi, nkua ngolo yoso.<verse eid="HEB 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4"/>Buna niandi wulutila zimbasi mu luvalu bila dizina di katambula dilutidi dizina di zimbasi.<verse eid="HEB 1:4"/></para>
  <para style="s1">Muana Nzambi lutidi zimbasi</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5"/>Muaki kuidi mbasi mbi yoyi Nzambi kakamba :</para>
  <para style="q1" vid="HEB 1:5">
    <char style="qt">ngeyo widi Muanꞌama,</char></para>
  <para style="q1" vid="HEB 1:5">
    <char style="qt">minu ndibutidi mu lumbu kiaki Voti diaka :</char></para>
  <para style="q1" vid="HEB 1:5">
    <char style="qt">Minu ndiela ba dise diandi</char></para>
  <para style="q1" vid="HEB 1:5">
    <char style="qt">ayi niandi wela ba muanꞌama e ?</char><verse eid="HEB 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6"/>Bosi bu kakotisa mutu wutheti wu butuka va nza, wubuela tuba ti :</para>
  <para style="q1" vid="HEB 1:6">
    <char style="qt">Bika zimbasi zioso zi Nzambi</char></para>
  <para style="q1" vid="HEB 1:6">
    <char style="qt">zifukama va ntualꞌandi.</char><verse eid="HEB 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 1:7"/>Mu diambu di zimbasi, niandi wutuba ti :</para>
  <para style="q1" vid="HEB 1:7">
    <char style="qt">Niandi wunkitulanga zimbasi ziandi phemo</char></para>
  <para style="q1" vid="HEB 1:7">
    <char style="qt">ayi bisadi biandi minlaki mi mbazu.</char><verse eid="HEB 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 1:8"/>Vayi mu diambu di Muana, niandi wutuba ti :</para>
  <para style="q1" vid="HEB 1:8">
    <char style="qt">A Nzambi, kundu kiaku ki kipfumu kinzinganga</char></para>
  <para style="q1" vid="HEB 1:8">
    <char style="qt">mu zithangu zioso.</char></para>
  <para style="q1" vid="HEB 1:8">
    <char style="qt">Nkawꞌaku wu busonga widi nkawa wu kipfumu</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">1.8 </char>
      <char style="fq" closed="false">Nkawa wu kipfumu</char>
      <char style="fqa" closed="false"> : </char>
      <char style="ft" closed="false">voti wela yadila kipfumu kiaku mu busonga.</char>
    </note>
    <char style="qt">.</char><verse eid="HEB 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9"/>
    <char style="qt">Wunzolanga masonga vayi wunlendanga mambimbi.</char></para>
  <para style="q1" vid="HEB 1:9">
    <char style="qt">Diawu Nzambi, Nzambi aku, kasobudila</char></para>
  <para style="q1" vid="HEB 1:9">
    <char style="qt">ayi kamonisa khini yi nzitusu</char></para>
  <para style="q1" vid="HEB 1:9">
    <char style="qt">viokila yoyi kamonisa bakundi baku.</char><verse eid="HEB 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 1:10"/>Wubuela diaka :</para>
  <para style="q1" vid="HEB 1:10">
    <char style="qt">A Pfumu, va thonono</char></para>
  <para style="q1" vid="HEB 1:10">
    <char style="qt">ngeyo wuvanga zifundasio zi ntoto ayi</char></para>
  <para style="q1" vid="HEB 1:10">
    <char style="qt">diyilu divangulu mu mioko miaku.</char><verse eid="HEB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11"/>
    <char style="qt">Biela bungana</char></para>
  <para style="q1" vid="HEB 1:11">
    <char style="qt">vayi ngeyo wela zinga mu mimvu mi kamimani ;</char></para>
  <para style="q1" vid="HEB 1:11">
    <char style="qt">Biela nuna banga minledi.</char><verse eid="HEB 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12"/>
    <char style="qt">Wela bizinga banga bu nzingulungu nledi</char></para>
  <para style="q1" vid="HEB 1:12">
    <char style="qt">ayi biela sienza</char></para>
  <para style="q1" vid="HEB 1:12">
    <char style="qt">vayi ngeyo wusienzanga ko ayi</char></para>
  <para style="q1" vid="HEB 1:12">
    <char style="qt">mimvu miaku milendi suka ko !</char><verse eid="HEB 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 1:13"/>Ayi kuidi mbasi mbi katuba ti :</para>
  <para style="q1" vid="HEB 1:13">
    <char style="qt">Vuanda va lubakala luama</char></para>
  <para style="q1" vid="HEB 1:13">
    <char style="qt">nate ndiela mana kitula bambeni ziaku</char></para>
  <para style="q1" vid="HEB 1:13">
    <char style="qt">diatulu ki malu maku.</char><verse eid="HEB 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14"/>A ziawu zisi ko ziphevi zinsadilanga Nzambi, zifidusu mu diambu di sadila batu bobo bela vinginina kiuka ki phulusu e ?<verse eid="HEB 1:14"/></para>
  <chapter eid="HEB 1"/>
  <chapter number="2" style="c" sid="HEB 2"/>
  <para style="s1">Kadi lenza phulusu yinata Muana</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1"/>Diawu, tufueti luta keba mu mambu momo tuwa, tala tuedi zimbala.<verse eid="HEB 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="HEB 2:2"/>Bila enati mambu momo zimbasi zisamuna maba makinda ayi enati mbundudulu yi Mina ayi kambu ku tumamana koso kutambula thumbudulu yifuana ; <verse eid="HEB 2:2"/><verse number="3" style="v" sid="HEB 2:3"/>buna buevi tulenda vukila enati tulembo lenzi phulusu yoyi yinneni ? Lolo niandi veka Pfumu katuama samuna bosi yikindusu kuidi batu bobo banwa. <verse eid="HEB 2:3"/><verse number="4" style="v" sid="HEB 2:4"/>Nzambi wukindisa kimbangi kiawu mu bidimbu, mu mavanga matsiminanga ayi mu bikumu bi phila mu phila ayi mu makaba ma Pheve Yinlongo makabulu boso buididi luzolo luandi.<verse eid="HEB 2:4"/></para>
  <para style="s1">Nzambi wuyekula mamo kuidi Muana</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5"/>Muaki bika sia ti kuidi zimbasi Nzambi kayekudila nza yinkuiza, wowo tulembo yolukila. <verse eid="HEB 2:5"/><verse number="6" style="v" sid="HEB 2:6"/>Muaki vadi vama vamosi mutu wumosi, wutelama kimbangi kiaki :</para>
  <para style="q1" vid="HEB 2:6">
    <char style="qt">Mutu, widi nani muingi wuntebukilanga moyo e ?</char></para>
  <para style="q1" vid="HEB 2:6">
    <char style="qt">voti Muana mutu widi nani muingi wumbelanga mayindu e ?</char><verse eid="HEB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7"/>
    <char style="qt">ngeyo wumvanga mutu wukambu luvalu,</char></para>
  <para style="q1" vid="HEB 2:7">
    <char style="qt">mu ndambu thangu zimbasi bu zimviokila mu luvalu,</char></para>
  <para style="q1" vid="HEB 2:7">
    <char style="qt">vayi wumvuika nkembo ayi nzitusu.</char><verse eid="HEB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8"/>
    <char style="qt">Ngeyo wutula bima bioso ku tsi bitambi biandi.</char></para>
  <para style="p" vid="HEB 2:8">Mu thangu kamana tula bima bioso ku tsi luyalu luandi, Nzambi kasia zimbakana ko kadi kima kimosi kibika ba ku tsi luyalu luandi. Muaki nate buabu tumueni ko ti bima bioso bidi ku tsi luyalu luandi. <verse eid="HEB 2:8"/><verse number="9" style="v" sid="HEB 2:9"/>Vayi Yesu, mutu wowo wutuama ba wukambu luvalu mu ndambu thangu zimbasi bu zimviokila mu luvalu, tulembo moni buabu wuvuiku nkembo ayi nzitusu mu diambu di ziphasi zi lufua ziozi kamona mu diambu di nlemvo wu Nzambi bu kafuila batu boso.<verse eid="HEB 2:9"/></para>
  <para style="s1">Muana Nzambi niandi khomba yi batu boso</para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10"/>Muaki dimonika ti didi difuana kuidi Nzambi, wuvanga bima bioso ayi wunzingisa bima bioso, mu kitula Yesu mutu wufuana mu nzila yi ziphasi mu diambu di nata bana bawombo ku nkembo andi. Bila Yesu niandi mutu wukubanatanga ku phulusu. <verse eid="HEB 2:10"/><verse number="11" style="v" sid="HEB 2:11"/>Bila ayi mutu wowo wumvedisa ayi batu bobo bavedoso, babo mu dise dimosi batotukila. Diawu kamonanga tsoni ko mu kuba tedila bakhomba bandi <verse eid="HEB 2:11"/><verse number="12" style="v" sid="HEB 2:12"/>mu thangu kakamba :</para>
  <para style="q1" vid="HEB 2:12">
    <char style="qt">Ndiela yolukila dizina diaku kuidi bakhomba ziama,</char></para>
  <para style="q1" vid="HEB 2:12">
    <char style="qt">ndiela kuyimbidila va ntuala dibundu dioso.</char><verse eid="HEB 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 2:13"/>Wubuela diaka :</para>
  <para style="q1" vid="HEB 2:13">
    <char style="qt">Minu ndiela tula diana diama mu niandi.</char></para>
  <para style="p" vid="HEB 2:13">Wubuela diaka :</para>
  <para style="q1" vid="HEB 2:13">
    <char style="qt">Minu wawu va kimosi ayi bana bobo baphana Nzambi.</char><verse eid="HEB 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14"/>Sumbu didi ti bana bafubakana mu menga ayi nsuni buna niandi mamvandi wutumbu fubakana. Wuvanga buawu mu diambu di kosikisa, mu nzila yi lufua, satana, mutu wowo beki lulendo lu lufua, <verse eid="HEB 2:14"/><verse number="15" style="v" sid="HEB 2:15"/>ayi mu diambu di kula batu boso bobo baba bavika ba boma bu lufua mu luzingu luawu loso.<verse eid="HEB 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 2:16"/>Bila bukiedika kasia kuiza mu diambu di sadisa zimbasi ko vayi wuyiza mu diambu di sadisa nkuna wu Abalahami. <verse eid="HEB 2:16"/><verse number="17" style="v" sid="HEB 2:17"/>Mu bila kioki, nganu wutumbu dedakana, mu mambu moso, banga bakhomba muingi kakituka pfumu yi zinganga Nzambi yilenda vanga dioso di kazodidi, pfumu yi zinganga Nzambi yimmonanga kiadi ayi yikuikama mu kisalu ki Nzambi mu diambu masumu ma batu malemvokolo. <verse eid="HEB 2:17"/><verse number="18" style="v" sid="HEB 2:18"/>Bila sumbu niandi veka katoto mu ziphasi zikamona buna wulenda kuandi sadisa babo balembo toto.<verse eid="HEB 2:18"/></para>
  <chapter eid="HEB 2"/>
  <chapter number="3" style="c" sid="HEB 3"/>
  <para style="s1">Yesu viokidi Moyize</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1"/>Diawu diodi bakhomba zinlongo, beno lutelo kuidi Nzambi mu baka kuku mu bima bi Diyilu, bika lutadidila Yesu mvuala ayi nganga Nzambi yi minu kioki tulembo samuni. <verse eid="HEB 3:1"/><verse number="2" style="v" sid="HEB 3:2"/>Niandi wuba wukuikama kuidi mutu wowo wumbieka banga bu bela Moyize mu nzo yimvimba yi Nzambi. <verse eid="HEB 3:2"/><verse number="3" style="v" sid="HEB 3:3"/>Bila Yesu wumono ti widi wufuana mu tambula nkembo viokila wowo wutambula Moyize. Banga kuandi ntungi wu nzo wuntambulanga nzitusu viokila nzo yika tungidi. <verse eid="HEB 3:3"/><verse number="4" style="v" sid="HEB 3:4"/>Bila kadika nzo yitungu kuidi mutu ; vayi Nzambi niandi wutunga bima bioso.<verse eid="HEB 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 3:5"/>Mu diambu di Moyize, niandi wuba wukuikama mu nzo yi mvimba yi Nzambi banga kisadi mu diambu di telamanga kimbangi mu mambu momo mafueti samunu. <verse eid="HEB 3:5"/><verse number="6" style="v" sid="HEB 3:6"/>Vayi Klisto, niandi widi wukuikama banga Muana mu nzo yi Nzambi. Beto tuidi nzoꞌandi enati tunsimbidila nate tsukulu bufula ayi diana di ngolo diodi tueti ku kiniemisina.<verse eid="HEB 3:6"/></para>
  <para style="s1">Luvundulu mu diambu di bobo bawilukila Nzambi</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7"/>Diawu, banga bueti tuba Pheve Yinlongo ti :</para>
  <para style="q1" vid="HEB 3:7">
    <char style="qt">Enati lumbu kiaki luwilu mbembo andi</char><verse eid="HEB 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 3:8"/>
    <char style="qt">Lubika kitula mintima mieno banga matadi</char></para>
  <para style="q1" vid="HEB 3:8">
    <char style="qt">banga bu lutinguna</char></para>
  <para style="q1" vid="HEB 3:8">
    <char style="qt">mu lumbu ki phukumunu mu dikanga.</char><verse eid="HEB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9"/>
    <char style="qt">Mu lumbu kina bakulu beno batsoka</char></para>
  <para style="q1" vid="HEB 3:9">
    <char style="qt">ayi bathota</char></para>
  <para style="q1" vid="HEB 3:9">
    <char style="qt">ayi bamona mavanga mama mu tezo</char></para>
  <para style="q1" vid="HEB 3:9">
    <char style="qt">ki makumaya ma mimvu.</char><verse eid="HEB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10"/>
    <char style="qt">Diawu ndifuemina buwombo tsungi yina ayi ndituba :</char></para>
  <para style="q1" vid="HEB 3:10">
    <char style="qt">“Mintima miawu midi kaka mizimbala</char></para>
  <para style="q1" vid="HEB 3:10">
    <char style="qt">ayi basia zaba zinzila ziama ko.”</char><verse eid="HEB 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11"/>
    <char style="qt">Diawu ku tsi nganzi ama</char></para>
  <para style="q1" vid="HEB 3:11">
    <char style="qt">ndilefa ndefi yayi :</char></para>
  <para style="q1" vid="HEB 3:11">
    <char style="qt">Balendi kota ko mu luvundulu luama.</char><verse eid="HEB 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12"/>Diawu bakhomba, lukeba mu diambu mutu mu beno kabika ba ntima wumbimbi ayi wunkambu wilukilanga ; tala kedi tamba Nzambi yi moyo manima. <verse eid="HEB 3:12"/><verse number="13" style="v" sid="HEB 3:13"/>Vayi lulubasananga kadika lumbu beno na beno, bu tuidi ayi “lumbu kiaki” muingi mutu mu beno kabika vunuka mu masumu ayi kabika ba matingu. <verse eid="HEB 3:13"/><verse number="14" style="v" sid="HEB 3:14"/>Bila enati tunsimbidila nate kuna tsukulu diana diodi diba yeto vana thonono, buna tuidi mu kithuadi ayi Klisto. <verse eid="HEB 3:14"/><verse number="15" style="v" sid="HEB 3:15"/>Banga bu tubulu :</para>
  <para style="q1" vid="HEB 3:15">
    <char style="qt">Enati lumbu kiaki luwilu mbembo andi,</char></para>
  <para style="q1" vid="HEB 3:15">
    <char style="qt">lubika kitula mintima mieno banga matadi</char></para>
  <para style="q1" vid="HEB 3:15">
    <char style="qt">banga bu lutinguna.</char><verse eid="HEB 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16"/>Buna banani bobo batinguna bu bawa mbemboꞌandi e ? Buna keti babo bobo Moyize katotula mu Ezipite e ? <verse eid="HEB 3:16"/><verse number="17" style="v" sid="HEB 3:17"/>Buna banani bobo Nzambi kafuemina mu makumaya ma mimvu e ? Buna keti batu bobo bavola masumu ayi bafua mu dikanga e ? <verse eid="HEB 3:17"/><verse number="18" style="v" sid="HEB 3:18"/>Buna kuidi banani Nzambi kalefila ndefi ti balendi kota ko mu luvundulu luandi e ? Buna keti bobo bamanga kuntumukina e ?<verse eid="HEB 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 3:19"/>Buna tumueni ti basia nunga ko mu kota mu diambu di kambu kuawu ku minu.<verse eid="HEB 3:19"/></para>
  <chapter eid="HEB 3"/>
  <chapter number="4" style="c" sid="HEB 4"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1"/>Sumbu tsila yi kotila mu luvundulu lu Nzambi bu yikidi, bunatukeba tala wumosi mu beno kedi kambu bu kotila. <verse eid="HEB 4:1"/><verse number="2" style="v" sid="HEB 4:2"/>Bila beto mamveto, batulonga Nsamu Wumboti, banga batu bana. Vayi mambu bawa masia ku basadisa ko bila masia bundana ko ayi minu ki bawu batambula mawu. <verse eid="HEB 4:2"/><verse number="3" style="v" sid="HEB 4:3"/>Bila kuidi beto tuwilukila, tueka kota mu luvundulu banga Nzambi bu katubila ti :</para>
  <para style="q1" vid="HEB 4:3">
    <char style="qt">Diawu ku tsi nganzi ama</char></para>
  <para style="q1" vid="HEB 4:3">
    <char style="qt">ndilefa ndefi ti :</char></para>
  <para style="q1" vid="HEB 4:3">
    <char style="qt">“Balendi kota ko mu luvundulu luama.”</char></para>
  <para style="p" vid="HEB 4:3">Ka diambu ko mavanga makivangimina tona vana va vangimina nza. <verse eid="HEB 4:3"/><verse number="4" style="v" sid="HEB 4:4"/>Bila vama va nkaka vayolokolo mu diambu di lumbu kitsambudi ti : <char style="qt">Nzambi wuvunda mu lumbu kitsambudi bu kamanisa kisalu kiandi kioso.</char><verse eid="HEB 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 4:5"/>Ayi mu yo yawu nzila, wutuba ti : <char style="qt">balendi kota ko mu luvundulu luama.</char><verse eid="HEB 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6"/>Sumbu didi ti batu bankaka bafueti kota mu luvundulu lolo, vayi batu bobo batuama longo Nsamu wumboti basia kota ko mu diambu di kambu kuawu ku tumama ; <verse eid="HEB 4:6"/><verse number="7" style="v" sid="HEB 4:7"/>diawu Nzambi kabuela kubikila Lumbu kinkaka, kintedolo “Lumbu kiaki” bu katuba, bilumbu biwombo bu bivioka, mu Davidi boso butuama yolokolo :</para>
  <para style="q1" vid="HEB 4:7">
    <char style="qt">Enati lumbu kiaki luwilu mbembo andi</char></para>
  <para style="q1" vid="HEB 4:7">
    <char style="qt">lubika kitula mintima mieno banga matadi.</char><verse eid="HEB 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8"/>Bila enati Zosue wuba vana luvundulu nganu Nzambi kalendi buela tubila lumbu kinkaka ko. <verse eid="HEB 4:8"/><verse number="9" style="v" sid="HEB 4:9"/>Vayi luvundulu lusiedi kuidi batu ba Nzambi luidi banga lu lumbu ki saba. <verse eid="HEB 4:9"/><verse number="10" style="v" sid="HEB 4:10"/>Bila mutu wowo wukota mu luvundulu lu Nzambi, niandi mamvandi wuvunda bu kamanisini kisalu kiandi banga bu vundila Nzambi bu kamanisa kisalu kiandi.<verse eid="HEB 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 4:11"/>Tunuana mu kota mu luvundulu beni mu diambu mutu kabika bua mu sokudila kambu ku tumama ku phila yoyi. <verse eid="HEB 4:11"/><verse number="12" style="v" sid="HEB 4:12"/>Bila mambu ma Nzambi madi moyo ayi malembo sadi ngolo ; maviokidi sabala mu meno, mankotanga ngolo nate mu vambisa moyo ayi pheve, nate mu vambisa madikulu ayi tonzo tu mimvesi ayi meti fiongunina mayindu ayi makani ma mintima. <verse eid="HEB 4:12"/><verse number="13" style="v" sid="HEB 4:13"/>Kuisi ko kadi vangu kimosi kidi kisuama va meso ma Nzambi. Bima bioso bidi va yambi ayi bisi ko bisuama va meso ma mutu wowo wela kutusambisa.<verse eid="HEB 4:13"/></para>
  <para style="s1">Yesu niandi pfumu yi zinganga Nzambi</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14"/>Diawu bu tubeki pfumu yi zinganga yisabuka Diyilu, Yesu Muana Nzambi, buna bika tusimbidila kimbangi kieto ki minu. <verse eid="HEB 4:14"/><verse number="15" style="v" sid="HEB 4:15"/>Bila tuisi pfumu yi zinganga Nzambi ko yoyi yinkambu fubakananga mu ziphasi zieto. Vayi tubeki wumosi wutoto banga beto mu mambu moso, vayi kasia vola kadi disumu dimosi ko.<verse eid="HEB 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 4:16"/>Diawu tufikamanu mu diana dioso ku kundu ki nlemvo wu Nzambi muingi katumona kiadi ayi tutambula nlemvo wunsadisanga mu thangu yifuana.<verse eid="HEB 4:16"/></para>
  <chapter eid="HEB 4"/>
  <chapter number="5" style="c" sid="HEB 5"/>
  <para style="ms1">KISALU KI KINGANGA KI KLISTO</para>
  <para style="s1">Klisto niandi pfumu yi zinganga Nzambi ayi tho yi phulusu kuidi batu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1"/>Bila kadika pfumu yi ziganga Nzambi wunsobolongo va khatitsika batu, wumbiekongo mu diambu di batu mu kuba sadisa mu mambu ma Nzambi, muingi katambikanga makaba ma batu ayi makaba mayoko mu diambu di masumu. <verse eid="HEB 5:1"/><verse number="2" style="v" sid="HEB 5:2"/>Niandi wulenda sudika bumboti batu bobo bakambulu diela ayi batu bobo banzimbala bila niandi veka widi wulebakana. <verse eid="HEB 5:2"/><verse number="3" style="v" sid="HEB 5:3"/>Bila mamvandi, mu diambu di lebakana kuandi, diawu kafueti tambikilanga makaba mu diambu di masumu mandi veka ayi mu diambu di masumu ma batu.<verse eid="HEB 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4"/>Mutu kalendi kukivana nzitusu wowo ko enati Nzambi kasia kuntela mbila ko banga bu bela Aloni. <verse eid="HEB 5:4"/><verse number="5" style="v" sid="HEB 5:5"/>Bobuawu Klisto mamvandi kasia kiniemisa ko mu bieko pfumu yi zinganga Nzambi. Vayi mutu wuna wunniemisa, niandi wutuba ti :</para>
  <para style="q1" vid="HEB 5:5">
    <char style="qt">Ngeyo widi Muanꞌama,</char></para>
  <para style="q1" vid="HEB 5:5">
    <char style="qt">lumbu kiaki ndibutidi.</char><verse eid="HEB 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 5:6"/>Bosi mu nzila yinkaka :</para>
  <para style="q1" vid="HEB 5:6">
    <char style="qt">ngeyo widi nganga Nzambi mu zithangu zioso</char></para>
  <para style="q1" vid="HEB 5:6">
    <char style="qt">banga buididi kinganga ki Meleshisedeki.</char><verse eid="HEB 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7"/>Mu bilumbu bi luzingu luandi lu kintoto, niandi wutambika zitsambulu ayi zindombolo mu yamikina ayi mu matsuela mu meso kuidi mutu wowo wulenda kumvukisa mu lufua. Mu diambu di kinzikanga Nzambi, niandi wubaka mvutu. <verse eid="HEB 5:7"/><verse number="8" style="v" sid="HEB 5:8"/>Ka diambu ko wuba Muana, vayi wulonguka tumama mu ziphasi ziozi kamona. <verse eid="HEB 5:8"/><verse number="9" style="v" sid="HEB 5:9"/>Bu kamana kitulu mutu wufuana, wuyika tho yi phulusu yi kayimani kuidi bobo beti kuntumukina. <verse eid="HEB 5:9"/><verse number="10" style="v" sid="HEB 5:10"/>Niandi wubieko kuidi Nzambi pfumu yi zinganga Nzambi banga buididi Meleshisedeki.<verse eid="HEB 5:10"/></para>
  <para style="s1">Lutambula bidia bi bakulutu</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11"/>Mambu mawombo madi yeto matuba mu diambu di nsamu wawu vayi phasi madi mu sudikisa bila luyikidi miolo mu sudika.<verse eid="HEB 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 5:12"/>Nganu thama luyika minlongi mu mambu ma Nzambi ; vayi nate buabu lukidi moni mfunu balulonga malongi ma thonono mu mambu ma Nzambi. Luyikidi banga batu bobo beti mona tsatu miliki vayi bika tsatu bidia bingolo. <verse eid="HEB 5:12"/><verse number="13" style="v" sid="HEB 5:13"/>Bila woso kuandi mutu wunsadilanga miliki kasi zaba ko Mambu ma busonga, bila wukidi muana lezi. <verse eid="HEB 5:13"/><verse number="14" style="v" sid="HEB 5:14"/>Vayi bidia bingolo bidi mu diambu di bakulutu ; bila bawu bayuku sadilanga diela diawu mu tulanga luviakunu mu mamboti ayi mu mambimbi.<verse eid="HEB 5:14"/></para>
  <chapter eid="HEB 5"/>
  <chapter number="6" style="c" sid="HEB 6"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1"/>Diawu tubikeno viokisa thangu mu malongi ma thonono ma Klisto, vayi bika tubaluka kuidi malongi ma bakulutu mu kambu buela tula zifundasio. Bu dinsundula ti : balula khadulu yintotukilanga mu mavanga mannatanga ku lufua ayi mu minu mu Nzambi, <verse eid="HEB 6:1"/><verse number="2" style="v" sid="HEB 6:2"/>mu malongi ma mbotokolo ayi ma thetokolo yi mioko, mu mfulukulu yi bafua ayi mu tsambusulu yi mvu ka mvu. <verse eid="HEB 6:2"/><verse number="3" style="v" sid="HEB 6:3"/>Buna buawu bobo tuela vanga enati Nzambi veni minsua.<verse eid="HEB 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4"/>Bila bulendi baka bubela ko ti batu bobo batuama kienzolo, bobo babimba lueki lu dikaba di Diyilu, bobo baba kithuadi mu Pheve Yinlongo, <verse eid="HEB 6:4"/><verse number="5" style="v" sid="HEB 6:5"/>bobo babimba lueki lu Mambu ma Nzambi ayi lulendo lu tsungi yidi ku ntuala, <verse eid="HEB 6:5"/><verse number="6" style="v" sid="HEB 6:6"/>vayi bawu bua, buna balendi buela vutuka balula mavanga ko bila balembo bandi muana Nzambi va dikulusi mu diambu diawu vekaayi balembo mfuisi tsoni va meso ma batu.<verse eid="HEB 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7"/>Bila ntoto wowo wunokonongo zimvula ziwombo ayi weti buta bikunusu binsadulungu kuidi batu bobo bakununu wawu, buna Nzambi wunsakumunanga ntoto beni. <verse eid="HEB 6:7"/><verse number="8" style="v" sid="HEB 6:8"/>Vayi enati ntoto beni weti buta zitsolokoto ayi zitsendi buna wusiedi kadi luvalu ko. Buna weka nduka singu bosi tsukuluꞌandi yoko ku mbazu.<verse eid="HEB 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9"/>A bakundi ba luzolo, ka diambu ko tuntuba bobo vayi diana tusidi ti lubeki mambu malutidi mu mboti, mannatanga ku phulusu. <verse eid="HEB 6:9"/><verse number="10" style="v" sid="HEB 6:10"/>Bila Nzambi widi wusonga ; kalendi zimbakana ko kisalu kioki lusala ayi luzolo lueno lolo lumonisa mu diambu di dizina diandi bu lusadila banlongo ayi lukidi ku basadila. <verse eid="HEB 6:10"/><verse number="11" style="v" sid="HEB 6:11"/>Tutidi ti kadika mutu mu beno kamonisa bufula bu phila yoyi mu diambu di keba diana di duka nate kuna tsukulu ; <verse eid="HEB 6:11"/><verse number="12" style="v" sid="HEB 6:12"/>mu diambu lubika kituka miolo vayi lusokudila batu bobo beti vingila kiuka kioki bavanina tsila, mu minu ayi mu mvibudulu.<verse eid="HEB 6:12"/></para>
  <para style="s1">Diana di kiedika</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13"/>Nzambi bu kavana tsila kuidi Abalahami, Nzambi wulevila ndefi mu dizina diandi veka, bu kasia baka ko mutu wunkaka wunlutila wowo kafueti levila ndefi ; <verse eid="HEB 6:13"/><verse number="14" style="v" sid="HEB 6:14"/>ayi wukamba ti : <char style="qt">bukiedika, ndiela kusakumuna buwombo ayi ndiela todisa nkunꞌaku.</char> <verse eid="HEB 6:14"/><verse number="15" style="v" sid="HEB 6:15"/>Mu mvibudulu yingolo Abalahami kavingidila ayi katambudila mambu momo mamvanina Nzambi tsila.<verse eid="HEB 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16"/>Bila batu beta levila ndefi mu dizina di mutu wunkaka wubalutidi. Bila, mu diambu diawu, ndefi yidi dimbu mu manisa ziphakazioso. <verse eid="HEB 6:16"/><verse number="17" style="v" sid="HEB 6:17"/>Diawu Nzambi bu kazola monisa kuidi batu bobo bela vinginina kiuka kiandi kioki kavanina tsila ti lukanu luandi lulendi baluka ko, buna wuleva ndefi. <verse eid="HEB 6:17"/><verse number="18" style="v" sid="HEB 6:18"/>Mu diambu di mambu muadi malendi viakana ko, mawu mammonisa ti Nzambi kalendi vuna ko. Mu mawu tubaka bu kindusulu mu simbidila diana diodi tukubukulu, beto tumana baka suamunu. <verse eid="HEB 6:18"/><verse number="19" style="v" sid="HEB 6:19"/>Diana diodi didi kuidi beto banga sengo kinsingiminanga muela, diana beni didi dikinda ayi dingolo. Diana beni dinkotanga, sabuka lido nate ku khati buangu kioki kilutidi nlongo, <verse eid="HEB 6:19"/><verse number="20" style="v" sid="HEB 6:20"/>kuna ku kota Yesu banga ntuami ntuala, mu diambu dieto. Wuyikidi pfumu yi zinganga Nzambi mu zithangu zioso banga buididi Meleshisedeki.<verse eid="HEB 6:20"/></para>
  <chapter eid="HEB 6"/>
  <chapter number="7" style="c" sid="HEB 7"/>
  <para style="s1">Meleshisedeki viatukidi Aloni</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1"/>Bila Meleshisedeki beni, ntinu wu Salemi, Nganga Nzambi yi Nzambi yizangama, wuyenda dengana Abalahami bu kaba ku mvita yika kanuana ayi kabedisila mintinu miwombo. Buna Meleshisedeki beni wunsakumuna. <verse eid="HEB 7:1"/><verse number="2" style="v" sid="HEB 7:2"/>Ayi Abalahami wuvana kuku ki kumi mu bima bioso biobikabaka kuidi Meleshisedeki.</para>
  <para style="p" vid="HEB 7:2">Tsundu Maleshisedeki : Ntinu wu busonga, bosi widi ntinu wu Salemi ; bu dinsundula ntinu wu ndembama. <verse eid="HEB 7:2"/><verse number="3" style="v" sid="HEB 7:3"/>Meleshisedeki kasia ba kadi dise ayi kadi ngudi ko ayi kikhulu kiandi kisi zabakana ko. Thonono yi bilumbu biandi ayi tsukusunu yi luzingu luandi bisi zabakana ko vayi luzingu luandi ludedakani ayi lu Muana Nzambi ; widi Nganga Nzambi mu zithangu zioso.<verse eid="HEB 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4"/>Tala boso bu kabela mutu wunneni, mutu wowo Abalahami kavana kuku ki kumi ki bima bi kabaka bu tuzebi ti Abalahami niandi dise di makanda. <verse eid="HEB 7:4"/><verse number="5" style="v" sid="HEB 7:5"/>Ayi mu batu bobo badi mu bana ba Levi bansalanga kinganga babeki minsua mi tambulanga kuku ki kumi boso buididi Mina, kuidi batu bu dinsundula bakhomba, ka diambu ko batotukila mu luketo lu Abalahami. <verse eid="HEB 7:5"/><verse number="6" style="v" sid="HEB 7:6"/>Vayi Meleshisedeki, kasi mu dikanda di bana ba Levi ko vayi wutambula kuku ki kumi kuidi Abalahami ayi wusakumuna mutu wowo wutambula zitsila zi Nzambi. <verse eid="HEB 7:6"/><verse number="7" style="v" sid="HEB 7:7"/>Mu kambu findana ziphaka beto boso tuzebi ti mutu wowo sakumuni niandi lutidi ayi mutu wowo basakumuni.<verse eid="HEB 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 7:8"/>Banganga Nzambi bantambulanga kuku ki kumi badi batu bamfuanga vayi Meleshisedeki wutambula kuku ki kumi kiaki, wulembo telomono kimbangi ti widi moyo.<verse eid="HEB 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 7:9"/>Tulenda tuba ti Levi wuntambulanga kuku ki kumi mamvandi wuvana kuku ki kumi mu nzila yi Abalahami. <verse eid="HEB 7:9"/><verse number="10" style="v" sid="HEB 7:10"/>Bila buna kabutukidi ko, vayi buna wukidi mu luketo lu nkulu andi mu thangu Meleshisedeki kadengana Abalahami.<verse eid="HEB 7:10"/></para>
  <para style="s1">Klisto widi nganga Nzambi mu ntanda wu Meleshisedeki</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11"/>Enati diluaku didi mu ba wufuana mu nzila yi kinganga ki ba Levi, bila mu kiawu batu bavanunu Mina, buna mfunu mbi widi mu buela bieka diaka nganga Nzambi yinkaka mu ntanda wu Meleshisedeki vayi kasia bieko ko boso buididi Aloni e ?<verse eid="HEB 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 7:12"/>Bila bawu viakisa kinganga buna Mina miviakini. <verse eid="HEB 7:12"/><verse number="13" style="v" sid="HEB 7:13"/>Bila mutu wowo wutubulu mambu beni widi muisi dikanda dinkaka, mu kambulu mutu wusala va diziku di <verse eid="HEB 7:13"/><verse number="14" style="v" sid="HEB 7:14"/>bila dizabikini ti Pfumu eto wutotukila mu dikanda di Yuda, dikanda dikambu tubila Moyize mu diambu di kinganga.<verse eid="HEB 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15"/>Tala diambu dilutidi zabakana bu tumueni ti : Nganga Nzambi yinkaka yitotukidi yidi mu ntanda wu Meleshisedeki ; <verse eid="HEB 7:15"/><verse number="16" style="v" sid="HEB 7:16"/>kasia bieko Nganga Nzambi ko mu lusadusu lu Mina boso buididi lutumunu lu batu vayi boso buididi lulendo lu luzingu lu kalulendi bungana ko. <verse eid="HEB 7:16"/><verse number="17" style="v" sid="HEB 7:17"/>Bila niandi wutelomono kimbangi kiaki :</para>
  <para style="q1" vid="HEB 7:17">
    <char style="qt">ngeye widi Nganga Nzambi mu zithangu zioso</char></para>
  <para style="q1" vid="HEB 7:17">
    <char style="qt">mu ntanda wu Meleshisedeki !</char><verse eid="HEB 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18"/>Buna Mina mituama mibotolo mu diambu di misiala lulendo ko ayi misiala ko mfunu. <verse eid="HEB 7:18"/><verse number="19" style="v" sid="HEB 7:19"/>Bila Mina misia fuanisa kadi diambu dimosi ko. Vayi diana dimboti dikotoso ; mu diawu tulenda fikiminina Nzambi.<verse eid="HEB 7:19"/></para>
  <para style="s1">Klisto widi pfumu yi zinganga Nzambi mu zithangu zioso</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20"/>Mamo momo mavangimina mu ndefi yi leva Nzambi. Bila bana bayika zinganga zinzambi mu kambu leva ndefi. <verse eid="HEB 7:20"/><verse number="21" style="v" sid="HEB 7:21"/>Vayi Yesu wuyika nganga Nzambi boso bu bela ndefi yi leva Nzambi bu kankamba ti :</para>
  <para style="q1" vid="HEB 7:21">
    <char style="qt">Pfumu wuleva ndefi</char></para>
  <para style="q1" vid="HEB 7:21">
    <char style="qt">ayi kalendi viakisa mayindu mandi ko ;</char></para>
  <para style="q1" vid="HEB 7:21">
    <char style="qt">ngeyo widi Nganga Nzambi mu zithangu zioso.</char><verse eid="HEB 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 7:22"/>Buna Yesu wuyika mvangi wu zitsila mu nguizani yoyi yilutidi kitoko.<verse eid="HEB 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23"/>Banganga Nzambi baba ziwombo mu kisalu ki kinganga mu diambu lufua luba kuba bikilanga ko thangu mu sala kisalu kiawu mu zithangu zioso bila baba fuanga wumosi-wumosi.<verse eid="HEB 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 7:24"/>Vayi Yesu widi moyo mu zithangu zioso ayi diawu kadidi ayi kinganga kioki kilendi yekodolo mutu ko. <verse eid="HEB 7:24"/><verse number="25" style="v" sid="HEB 7:25"/>Diawu kalenda vukisila batu boso bobo bamfikama Nzambi mu niandi sumbu kadi moyo mu zithangu zioso mu diambu di kuba lombila.<verse eid="HEB 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26"/>Bukiedika ti pfumu yi zinganga Nzambi yi phila yoyi yifueni kuidi beto ; niandi widi wunlongo, kasi zaba kadi diambu dimosi ko, kadi disumu kasi ko ayi widi wumvambana ayi bankua masumu ; niandi wutombolo ku yilu viokila diyilu. <verse eid="HEB 7:26"/><verse number="27" style="v" sid="HEB 7:27"/>Bapfumu zi zinganga Nzambi bankaka zifueti tambikanga kadika lumbu makaba mu diambu di masumu mawu veka bosi mu diambu di masumu ma batu boso. Vayi kuidi niandi kasi mfunu mu vanganga buawu ko bila niandi wutumbu manisa mamo mu khumbu yimosi bu kakivana niandi veka. <verse eid="HEB 7:27"/><verse number="28" style="v" sid="HEB 7:28"/>Mina mibieka batu balebakana mu ba bapfumu banganga Nzambi. Vayi mambu ma ndefi matotuka ku manima ma Mina, mabieka muana widi wufuana mu zithangu zioso.<verse eid="HEB 7:28"/></para>
  <chapter eid="HEB 7"/>
  <chapter number="8" style="c" sid="HEB 8"/>
  <para style="s1">Klisto niandi Pfumu yi zinganga Nzambi yilutidi kitoko</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1"/>Diambu di mfunu mu mambu tuyolukidi diawu diadi : beto tubeki Pfumu yi zinganga Nzambi yinneni banga yayi, yidi ku Diyilu, va koko ku lubakala lu Kundu ki nkembo ki niandi veka Pfumu Nzambi. <verse eid="HEB 8:1"/><verse number="2" style="v" sid="HEB 8:2"/>Pfumu yi zinganga Nzambi beni widi banga kisadi mu buangu kilutidi nlongo ayi nlongo, nzo ngoto yitungu kuidi niandi Pfumu vayi bika kuidi batu.<verse eid="HEB 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3"/>Yoso-yoso Pfumu yy zinganga Nzambi yeti bieko mu diambu ditambikanga makaba ayi makaba mayoko. Diawu bufueni ti Pfumu yi zinganga Nzambi yayi, mamvandi kafueti ba ayi kima kioki kafueti tambikanga. <verse eid="HEB 8:3"/><verse number="4" style="v" sid="HEB 8:4"/>Enati wuba va ntoto, nganu kasia ba Nganga Nzambi ko, bila vadi ayi banganga Nzambi ziozi zintambikanga makaba boso buididi Mina. <verse eid="HEB 8:4"/><verse number="5" style="v" sid="HEB 8:5"/>Ziawu zieti sadila mfikula ayi kitsuisula ki bima bi diyilu banga Nzambi bu kalubudila Moyize bu kabaka lukanu lu tunga nzo ngoto ti : keba, ngeyo wela vangila bibioso boso buididi kifuani kioki bammonisa ku mbata mongo.<verse eid="HEB 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 8:6"/>Vayi buabu Yesu wuyekodolo kisalu kilutidi mu kitoko bila niandi widi phovi yi nguizani yilutidi kitoko yitungu va zitsila zi kitoko.<verse eid="HEB 8:6"/></para>
  <para style="s1">Nguizani yikhulu ayi yimona</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7"/>Bukiedika, enati Nguizani yitheti yiba yikambu tsembolo nganu kadi mfunu mu viakisa yawu mu nguizani yimmuadi.<verse eid="HEB 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 8:8"/>Vayi bu kasemba, buna wutuba :</para>
  <para style="q1" vid="HEB 8:8">
    <char style="qt">Pfumu wutuba : ti bilumbu bilembo yizi</char></para>
  <para style="q1" vid="HEB 8:8">
    <char style="qt">biobi ndiela wizana nguizani yimona</char></para>
  <para style="q1" vid="HEB 8:8">
    <char style="qt">va kimosi ayi dikanda di Iseli ayi dikanda di Yuda.</char><verse eid="HEB 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9"/>
    <char style="qt">Bika sia ti boso buididi Nguizani yoyi</char></para>
  <para style="q1" vid="HEB 8:9">
    <char style="qt">ndiwizana ayi bakulu bawu</char></para>
  <para style="q1" vid="HEB 8:9">
    <char style="qt">mu lumbu kioki ndiba simba mu koko ;</char></para>
  <para style="q1" vid="HEB 8:9">
    <char style="qt">mu kuba totula mu tsi yi Ezipite</char></para>
  <para style="q1" vid="HEB 8:9">
    <char style="qt">bila basia ba bakuikama ko mu Nguizani yama.</char></para>
  <para style="q1" vid="HEB 8:9">
    <char style="qt">Buna ndiba yekula.</char></para>
  <para style="q1" vid="HEB 8:9">
    <char style="qt">Pfumu tubidi buawu.</char><verse eid="HEB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10"/>
    <char style="qt">Pfumu tubidi ti : mu bilumbu bina, yawu yayi</char></para>
  <para style="q1" vid="HEB 8:10">
    <char style="qt">Nguizani ndiela wizana ayi dikanda di Iseli :</char></para>
  <para style="q1" vid="HEB 8:10">
    <char style="qt">ndiela tula Mina miama mu mayindu mama</char></para>
  <para style="q1" vid="HEB 8:10">
    <char style="qt">ayi ndiela misonika mu mintima miawu.</char></para>
  <para style="q1" vid="HEB 8:10">
    <char style="qt">Minu veka ndiela ba Nzambi awu</char></para>
  <para style="q1" vid="HEB 8:10">
    <char style="qt">ayi bawu bela ba batu bama.</char><verse eid="HEB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11"/>
    <char style="qt">Kuisi ko mutu wela mona mfunu mu longa ndiandi</char></para>
  <para style="q1" vid="HEB 8:11">
    <char style="qt">voti khomba mu longa khombꞌandi ti :</char></para>
  <para style="q1" vid="HEB 8:11">
    <char style="qt">“Bufueni ngeyo wuzaba Pfumu”</char></para>
  <para style="q1" vid="HEB 8:11">
    <char style="qt">Bila batu boso bela kunzaba :</char></para>
  <para style="q1" vid="HEB 8:11">
    <char style="qt">tona ku muana wu lezi nate</char></para>
  <para style="q1" vid="HEB 8:11">
    <char style="qt">kuidi lutidi mimvu mu bawu.</char><verse eid="HEB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12"/>
    <char style="qt">Bila ndiela kuba mona kiadi mu zinzimbala ziawu.</char></para>
  <para style="q1" vid="HEB 8:12">
    <char style="qt">Ndilendi buela tebukila ko masumu mawu moyo.</char><verse eid="HEB 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13"/>Bu katuba ti : Nguizani yimona buna wukitula yoyi yitheti yikhulu. Muaki yoyi yinkitukanga yikhulu ayi yoyi yeti nuna buna yimbanga nduka mu zimbala.<verse eid="HEB 8:13"/></para>
  <chapter eid="HEB 8"/>
  <chapter number="9" style="c" sid="HEB 9"/>
  <para style="s1">Tsambudulu mu Nguizani yikhulu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1"/>Mu nguizani yitheti, muba ayi zithumunu mu diambu di lusambulu ayi buangu kinlongo ki kintoto. <verse eid="HEB 9:1"/><verse number="2" style="v" sid="HEB 9:2"/>Batunga nzo ngoto. Mu ndambu yitheti muawu muba kima kioki bankietikanga muinda ayi meza ayi mapha matambuku kuidi Nzambi. Ndambu beni yawu “Buangu kinlongo.” <verse eid="HEB 9:2"/><verse number="3" style="v" sid="HEB 9:3"/>Ku manima ma mbusa lido kuawu kuba nzo ngoto batedila “Buangu kilutidi nlongo ayi nlongo”. <verse eid="HEB 9:3"/><verse number="4" style="v" sid="HEB 9:4"/>Muna khati muawu muba kimfimbu ki nolo ayi kesi yi Nguizani yimana vindu nolo mu zindambu zioso. Muna kesi beni muawu muba mvungu wu nolo, mana ; nti wu Aloni wutotula biteka ayi zimeza zi matadi musonama mambu ma nguizani.<verse eid="HEB 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 9:5"/>Vana mbata kesi vawu vaba zimbasi ziozi beti tedila : “Baselibe ba nkembo” ; zifuka mu kitsuisula ki mavavi mawu buanguki nlemvo. Vayi buabu tulendi baka bu yolukila mambu mama mu dimosi-dimosi ko.<verse eid="HEB 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6"/>Mambu mama bu mamana kubuku ; banganga Nzambi babakotanga kadika thangu ku ndambu yitheti yi buangu kinlongo mu diambu di sala kisalu kiawu. <verse eid="HEB 9:6"/><verse number="7" style="v" sid="HEB 9:7"/>Vayi pfumu yi zinganga Nzambi niandi kaka wuba kotanga muna khati ndambu yinzole. Khumbu yimosi kaba mu kotilanga mu kadika mvu. Kadika khumbu kankota ayi menga momo kafueti tambika mu diambu di niandi veka ayi mu diambu di zinzimbala zi batu.<verse eid="HEB 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 9:8"/>Pheve Yinlongo weti kutumonisa bumboti ti nzila yoyi yinkotolongo ku buangu kilutidi nlongo ayi nlongo yikidi yikangama sumbu nzo ngoto yitheti yikidi. <verse eid="HEB 9:8"/><verse number="9" style="v" sid="HEB 9:9"/>Yawu yidi mfikula mu diambu di thangu yayi. Diodi dinsundula ti makaba ayi makaba mayoko momo baba tambikanga kuidi Nzambi malendi nunga ko mu fuanisa bumboti mayindu ma ntima ma mutu wowo wuntambikanga mawu.<verse eid="HEB 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 9:10"/>Bila mambu momo matedi kaka ndiwulu ; ndiunu ayi zitsukudulu zi phila mu phila. Mambu beni madi zithumunu zi kinsuni zivanu nate thangu Nzambi kela fuanisa mambu moso.<verse eid="HEB 9:10"/></para>
  <para style="ms1">MENGA MA KLISTO</para>
  <para style="s1">Klisto niandi Pfumu yi zinganga Nzambi yi bima bimboti biobi katubakila</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11"/>Klisto bu kayiza banga Pfumu yi banganga Nzambi mu diambu di kutuvana bima biobi bimboti katubakila tona thama, buna wusabuka buangu kinlongo kilutidi tola ayi kilutidi fuana. Kiawu kisia tungulu mu mioko mi batu ko ; kiawu kisi ki ntoto wawu ko. <verse eid="HEB 9:11"/><verse number="12" style="v" sid="HEB 9:12"/>Khumbu yimosi kaka kakotila muna buangu kilutidi nlongo ayi nlongo ; wutambika, bika sia ti menga ma zikhombo voti ma zingombi vayi wutambika menga mandi veka. Buawu bobo katubakila khudulu yi kayimani. <verse eid="HEB 9:12"/><verse number="13" style="v" sid="HEB 9:13"/>Bila enati menga ma zikhombo ayi ma zingombi zimbakala votidibombi di ngombi yi kheto, diodi divindulu batu bobo basumuka, dieti kuba vedisanga va mbata nitu. <verse eid="HEB 9:13"/><verse number="14" style="v" sid="HEB 9:14"/>Vayi tufueti zaba ti menga ma Klisto, mutu wowo mu lusadusu lu Pheve yi mvu ka mvu, wukiyekula niandi veka kuidi Nzambi banga dikaba dikambulu ditona, mela vedisa mayindu meto ma ntima mu mavanga meti natanga ku lufua muingi tusadila Nzambi yi moyo.<verse eid="HEB 9:14"/></para>
  <para style="s1">Nguizani yimona yivangimina mu dikaba di Klisto</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15"/>Diawu diodi Klisto kadidi phovi yi Nguizani yimona muingi babo batelo batambula kiuka kika kisukanga ko, kioki kivanunu tsila. Bila Klisto niandi wufua mu diambu di kuba kula mu masumu momo bavola mu Nguizani yitheti.<verse eid="HEB 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16"/>Bila vadi tesitama<note caller="+" style="f"><char style="fr" closed="false">9.16 </char><char style="fq" closed="false">Tesitama</char><char style="fqa" closed="false"> : </char><char style="ft" closed="false">widi nkanda wummonisa buevi bufueti sadulu bima bi mutu niandi bu kafuidi.</char></note> buna vana vafueti telomono kimbangi ki lufua lu mutu wusonika kiawu. <verse eid="HEB 9:16"/><verse number="17" style="v" sid="HEB 9:17"/>Bila mfunu tesitama wumonikanga mu thangu mutu wowo sonikini kiawu kafuidi. Kisi kadi mfunu wumosi ko mu thangu mutu wusonika kiawu kakidi zingi. <verse eid="HEB 9:17"/><verse number="18" style="v" sid="HEB 9:18"/>Diawu Nguizani yitheti bu yitona, buna menga matengolo. <verse eid="HEB 9:18"/><verse number="19" style="v" sid="HEB 9:19"/>Bila Moyize bu kamana sudikisa zithumunu zioso zi Mina kuidi batu, wubonga menga ma bana ba zingombi ayi ma zikhombo zimbakala va kimosi ayi nlangu, lino yi mbuaki ayi ditafi di nti bantedilanga “Izopi”, wumuangina buku va kimosi ayi batu boso ; <verse eid="HEB 9:19"/><verse number="20" style="v" sid="HEB 9:20"/>bu katuba : <char style="qt">mama mawu menga ma Nguizani yoyi Nzambi kawizani ayi beno.</char><verse eid="HEB 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 9:21"/>Bosi wumuangina diaka buangu kinlongo menga va kimosi ayi bima bioso beti sadila mu lusambulu. <verse eid="HEB 9:21"/><verse number="22" style="v" sid="HEB 9:22"/>Muaki nduka-nduka bima bioso bimvedosongo mu menga landila boso buididi Mina. Ayi enati menga makadi tenguka buna masumu malendi lemvokolo ko. <verse eid="HEB 9:22"/><verse number="23" style="v" sid="HEB 9:23"/>Buna diba diambu di mfunu ti zimfikula zi bima biobi bidi mu diyilu zifueti vedoso mu bima bi phila yina. Vayi biawu veka bima bi diyilu bifueti vedosolo mu makaba mayoko malutidi kitoko.<verse eid="HEB 9:23"/></para>
  <para style="s1">Yesu wukota ku buangu kilutidi nlongo mu khumbu yimosi</para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 9:24"/>Bila Klisto kasia kota ko mu buangu kinlongo kitungulu mu mioko mi batu, kidi kaka mfikula yi kioki kikiedika. Vayi niandi wukota ku khati diyilu mu diambu kamonika va meso ma Nzambi mu diambu dieto.<verse eid="HEB 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 9:25"/>Bika sia ti wukota muawu mu diambu kakitambika niandi veka mu zikhumbu ziwombo banga bueti vangilanga pfumu yi banganga Nzambi, mutu wunkotanga kadika mvu ku buangu kilutidi nlongo ayi nlongo va kimosi ayi menga mangana. <verse eid="HEB 9:25"/><verse number="26" style="v" sid="HEB 9:26"/>Bila enati bobo nganu zikhumbu ziwombo kamonina ziphasi tona ntoto wuvangulu. Vayi buabu wumonika mu khumbu yimosi mu tsukulu yi thangu mu diambu di katula masumu bu kakitambika niandi veka banga dikaba. <verse eid="HEB 9:26"/><verse number="27" style="v" sid="HEB 9:27"/>Sambusu buidi ti mutu khumbu yimosi kaka keti fua, bosi weka <verse eid="HEB 9:27"/><verse number="28" style="v" sid="HEB 9:28"/>bobuawu, Klisto wukitambika khumbu yimosi mu diambu di nata masumu ma batu bawombo. Bosi wela monika mu khumbu yimmuadi, bika sia ti muingi kanata masumu ma batu, vayi mu diambu di nata phulusu kuidi batu bobo balembo mvingila.<verse eid="HEB 9:28"/></para>
  <chapter eid="HEB 9"/>
  <chapter number="10" style="c" sid="HEB 10"/>
  <para style="s1">Dikaba di Klisto diviokidi Mina</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1"/>Mina midi kitsuisula ki mambu mamboti momo mankuiza vayi bika khatika lunitu lu mambu beni. Buna Mina milendi ko fuanisa, mu diambu di makaba momo bantambikanga thangu ka thangu kadika mvu, batu bobo bamfikamanga Nzambi. <verse eid="HEB 10:1"/><verse number="2" style="v" sid="HEB 10:2"/>Enati minunga, nganu batu bobo bantambikanga makaba momo balendi buela tambikanga mawu ko bila nganu bu bakivedosolo mu khumbu yimosi balendi buela bela ko masumu mawu mayindu.<verse eid="HEB 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 10:3"/>Vayi mu makaba momo baba tambikanga muawu baba tebukilanga, kadika mvu, masumu mawu moyo. <verse eid="HEB 10:3"/><verse number="4" style="v" sid="HEB 10:4"/>Bila menga ma zingombi ayi ma zikhombo malendi botula ko masumu.<verse eid="HEB 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5"/>Diawu Klisto katubila bu kayiza va nza ti :</para>
  <para style="q1" vid="HEB 10:5">
    <char style="qt">Ngeyo wumanga tambula makaba mayoko ayi makaba</char></para>
  <para style="q1" vid="HEB 10:5">
    <char style="qt">vayi ngeyo wukhubikila nitu.</char><verse eid="HEB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6"/>
    <char style="qt">Ngeyo wusia mona ko khini</char></para>
  <para style="q1" vid="HEB 10:6">
    <char style="qt">mu makaba ma bibulu biobi bayokila,</char></para>
  <para style="q1" vid="HEB 10:6">
    <char style="qt">mu makaba mayoko</char></para>
  <para style="q1" vid="HEB 10:6">
    <char style="qt">mu diambu di masumu</char><verse eid="HEB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7"/>
    <char style="qt">Buna ndituba : tala, ndilembo yizi.</char></para>
  <para style="q1" vid="HEB 10:7">
    <char style="qt">Mu buku muidi musonama mu diambu diama :</char></para>
  <para style="q1" vid="HEB 10:7">
    <char style="qt">A Nzambi, ndizidi mu diambu di vanga luzolo luaku.</char><verse eid="HEB 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8"/>Wutuama tuba ti : <char style="qt">Ngeyo wumanga kuaku makaba, makaba mayoko, makaba ma bibulu biobi bayokila, makaba mayoko mu diambu di masumu. Kadi khini wusia mamona ko. Muaki makaba beni maba tambukungu boso bubela Mina.</char> <verse eid="HEB 10:8"/><verse number="9" style="v" sid="HEB 10:9"/>Bosi wutuba diaka : <char style="qt">Minu ndizidi mu diambu di vanga luzolo luaku.</char> Buawu bobo kabotudila makaba moso ma khulu ayi kavingisila va buangu beni dikaba di Klisto.<verse eid="HEB 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 10:10"/>Mu luzolo lolo tukitudulu banlongo mu diambu di dikaba ditambika Yesu Klisto bu katambika nitu andi veka mu khumbu yimosi.<verse eid="HEB 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11"/>Kadika nganga Nzambi kafueti telamanga kadika lumbu mu sala kisalu kiandi ayi mu tambikanga kadika thangu makaba mo mawu, momo malendi botula masumu. <verse eid="HEB 10:11"/><verse number="12" style="v" sid="HEB 10:12"/>Vayi Klisto niandi bu katumbu tambika dikaba dimosi kaka mu diambu di masumu buna wuvuanda va koko ku lubakala lu Nzambi. <verse eid="HEB 10:12"/><verse number="13" style="v" sid="HEB 10:13"/>Kuna kamvingidila Nzambi kakitula bambeni bandi banga kima kinketo kongo bitambi biandi.<verse eid="HEB 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 10:14"/>Bila mu diambu di dikaba dimosi kaka niandi wukitula, mu zithangu zioso batu bafuana ; bobo kavedisa mu masumu.<verse eid="HEB 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15"/>Pheve Yinlongo, wututelimina kimbangi mu diambu beni bila wutuama tuba ti :<verse eid="HEB 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 10:16"/>Pfumu kakembi : bilumbu bina bu biela vioka,</para>
  <para style="q1" vid="HEB 10:16">
    <char style="qt">Tala phila nguizani ndiela wizana yawu :</char></para>
  <para style="q1" vid="HEB 10:16">
    <char style="qt">Ndiela tula Mina miama mu mintima miawu,</char></para>
  <para style="q1" vid="HEB 10:16">
    <char style="qt">ayi ndiela misonika mu mayindu mawu.</char><verse eid="HEB 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 10:17"/>Bosi wubuela diaka</para>
  <para style="q1" vid="HEB 10:17">
    <char style="qt">Ndilendi buela tebukilanga masumu mawu</char></para>
  <para style="q1" vid="HEB 10:17">
    <char style="qt">ayi mambimbi mawu moyo ko.</char><verse eid="HEB 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 10:18"/>Muaki masumu mawu lemvokolo, kadi mfunu kusiedi ko mu buela tambikanga makaba mu diambu di masumu.<verse eid="HEB 10:18"/></para>
  <para style="ms1">MINU AYI THATUMUNU</para>
  <para style="s1">Tubika loza diana dieto</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19"/>Diawu bakhomba, sumbu tuidi ayi diana di kotila ku buangu kilutidi nlongo ayi nlongo mu diambu di menga ma Yesu, <verse eid="HEB 10:19"/><verse number="20" style="v" sid="HEB 10:20"/>mu nzila yimona ayi yi moyo yoyi katuzibudila mu lido ; yi buangu kilutidi nlongo ayi nlongo lido beni nitu andi. <verse eid="HEB 10:20"/><verse number="21" style="v" sid="HEB 10:21"/>Ayi sumbu tubeki Pfumu yi zinganga Nzambi yinyadila Nzo Nzambi, <verse eid="HEB 10:21"/><verse number="22" style="v" sid="HEB 10:22"/>diawu bika tufikama vadi Nzambi mu mintima milulama, mudiana dioso diodi dintotukilanga minu va kimosi ayi mintima mivedoso mu mayindu mambimbi ma ntima ayi nitu yisukulu mu nlangu wuvedila.<verse eid="HEB 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 10:23"/>Diawu bika tusimbidila bumboti diana diodi tuzebi ti didi di kiedika bila mutu wowo wutuvana zitsila widi wukuikama.<verse eid="HEB 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 10:24"/>Tusungasananga beto na beto mu diambu di salasananga beto na beto muingi tumonikisa luzolo ayi vanga mavanga mamboti.<verse eid="HEB 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 10:25"/>Tubikeno tina mabundu meto banga bueti vangila batu bankaka ; vayi bika tukikindisanga beto na beto bu lumueni ti lumbu ki Pfumu kieka nduka.<verse eid="HEB 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26"/>Enati tulembo vodi masumu mu luzolo bu tumana tambula nzayilu yi kiedika, buna kusiedi diaka dikaba ko mu diambu di masumu. <verse eid="HEB 10:26"/><verse number="27" style="v" sid="HEB 10:27"/>Vayi tufueti kaka vingila, mu tsisi, tsambusu ayi mbazu yingolo yela zinisa zimbzni zioso zi Nzambi.<verse eid="HEB 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 10:28"/>Woso mutu wummanga tumukina Mina mi Moyize kafueti fua mu kambu kiadi mu kimbangi ki batu buadi voti batu batatu. <verse eid="HEB 10:28"/><verse number="29" style="v" sid="HEB 10:29"/>Yindulanu beno veka, buevi buela bela thumbudulu yingolo yoyi yela tambula mutu wowo wela lenza Muana Nzambi, wela mona menga ma nguizani, mu momo kavedosolo ti masi kadi mfunu ko ayi wumfinga Pheve Yinlongoyi nlemvo e ?<verse eid="HEB 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 10:30"/>Bila tuzebi bumboti mutu wowo wutuba :</para>
  <para style="q1" vid="HEB 10:30">
    <char style="qt">Minu veka ndiela vutula landi</char></para>
  <para style="q1" vid="HEB 10:30">
    <char style="qt">ayi minu veka ndiela futa.</char></para>
  <para style="p" vid="HEB 10:30">Ayi wubuela tuba ti :</para>
  <para style="q1" vid="HEB 10:30">
    <char style="qt">Pfumu wela sambisa batu bandi.</char><verse eid="HEB 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 10:31"/>Didi diambu di tsisi mu bua mu mioko mi Nzambi yi moyo.<verse eid="HEB 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32"/>Lutebukila moyo bilumbu bituama biobi lutambudila kiezila ki Nzambi, beno luvibidila ziphasi zi khindu yinneni. <verse eid="HEB 10:32"/><verse number="33" style="v" sid="HEB 10:33"/>Bila zithangu zinkaka balu finga va meso ma batu bawombo ayi balu monisa ziphasi ; zithangu zinkaka lufubakana ayi batu bankaka bammona ziphasi banga ziozi lulembo moni. <verse eid="HEB 10:33"/><verse number="34" style="v" sid="HEB 10:34"/>Bila lufubakana mu ziphasi zi batu baba mu nloko ayi beno veka lummona khini bu baluziona bima bieno bu luzebi ti kimvuama bu kitoko ayi kinzingilanga buidi yeno.<verse eid="HEB 10:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 10:35"/>Kadi loza diana dieno bila dibeki mfutu wunneni. <verse eid="HEB 10:35"/><verse number="36" style="v" sid="HEB 10:36"/>Bila mfunu wu thatumunu widi yeno muingi lutambula mambu momo Nzambi kaluvanina tsila bu lumeni vanga luzolo luandi.<verse eid="HEB 10:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="HEB 10:37"/>
    <char style="qt">Bila fioti fisiedi, fioti kuandi fisiedi</char></para>
  <para style="q1" vid="HEB 10:37">
    <char style="qt">buna mutu wowo wufueti kuiza, wela kuiza,</char></para>
  <para style="q1" vid="HEB 10:37">
    <char style="qt">ayi kalendi zingila ko.</char><verse eid="HEB 10:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38"/>
    <char style="qt">Muaki mutu widi wusonga va meso mama wela zingila mu minu</char></para>
  <para style="q1" vid="HEB 10:38">
    <char style="qt">vayi enati vutukidi ku mbusa,</char></para>
  <para style="q1" vid="HEB 10:38">
    <char style="qt">buna ndilendi buela kummona khini ko.</char><verse eid="HEB 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39"/>Beto tuisi ko mu ntanda wu batu bobo bamvutukanga ku mbusa muingi tuzimbala vayi tuidi mu ntanda wu batu bobo badi minu ayi baambula phulusu.<verse eid="HEB 10:39"/></para>
  <chapter eid="HEB 10"/>
  <chapter number="11" style="c" sid="HEB 11"/>
  <para style="s1">Minu ki bambangi ba Nguizani yi khulu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1"/>Minu kinsundula tula diana dingolo mu bima, biobi bi nsiwulungu diana ayi ayi kikinina ti wutambudi bima ka diambu ko bimonikini ko. <verse eid="HEB 11:1"/><verse number="2" style="v" sid="HEB 11:2"/>Mu diambu di minu bakulu batelomono kimbangi.<verse eid="HEB 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3"/>Mu diambu di minu tuzabidi ti nza yivangulu mu mbembo yi Nzambi, ayi, bima bioso biobi bieti monika bivangimina mu biobi kabi monikanga ko.<verse eid="HEB 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4"/>Mu diambu di minu, Abeli wutambika kuidi Nzambi dikaba diyoko dilutidi dimboti viokila ditambika Kayini. Mu diambu di minu Nzambi kammonina mutu wusonga bu katelama niandi veka kimbangi ti wukikinina makaba mandi. Ayi mu diambu di minu Abeli wukidi yoluka diaka, ka diambu ko wufua kuandi.<verse eid="HEB 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5"/>Mu diambu di minu, Enoki wukatulu mu diambu kabika mona lufua. Basia kummona ko bila Nzambi wunkatula. Muaki tuamina kakatulu, bantelimina kimbangi kiaki : <char style="qt">Niandi wumonisa Nzambi khini.</char> <verse eid="HEB 11:5"/><verse number="6" style="v" sid="HEB 11:6"/>Muaki mutu kambulu minu kalendi monisa Nzambi khini ko. Bila bulutidi mboti ti woso mutu tidi fikama Nzambi kawilukila ti Nzambi widi ayi kafueti wilukila ti niandi wumfutanga batu boso bankuntombanga.<verse eid="HEB 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7"/>Mu diambu di minu, mu thangu Nzambi kalubula Nowa mu mambu momo katueni mona, wukinzika Nzambi ayi wutunga masuwa mu diambu di vukisa nzoꞌandi. Mu minu kiandi, wuzengila nza nkanu ayi wukituka mvingidi wu kiuka ki busonga kintotukilanga mu minu.<verse eid="HEB 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8"/>Mu diambu di minu, Abalahami wutumamana, bu katelo, mu kuenda ku tsi yoyi kafueti tambula banga kiuka ; ka diambu ko kasia zaba ko kuevi kankuenda. <verse eid="HEB 11:8"/><verse number="9" style="v" sid="HEB 11:9"/>Mu diambu di minu niandi wuzingila mu kinzenza mu tsi yi tsila ; wuzingila mu zinzo zingoto va kimosi ayi Isaki ayi Yakobi ; bobo baba mu tsila yimosi banga niandi. <verse eid="HEB 11:9"/><verse number="10" style="v" sid="HEB 11:10"/>Bila niandi wuvingila divula didi zifundasio ziozi zilendi nikuka ko. Nzambi niandi nkubiki ayi ntungi wu divula beni.<verse eid="HEB 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11"/>Mu diambu di minu ; Sala mamvandi, wubaka zingolo zi butila ka diambu ko mimvu mi butila mivioka ; bila wumona ti mutu wowo wuvana tsila widi wukuikama.<verse eid="HEB 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 11:12"/>Diawu mu mutu wumosi, mutu wowo wuyika nunu, wuba nduka mu fua, mu butukila nkuna wu batu bobo baviokidi zimbuetete zi Diyilu ayi baviokidi tsengisini yidi va disimu di mbu, yilendi baka bu tangulu ko.<verse eid="HEB 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13"/>Batu bobo bafuila mu minu mu kambu baka bima biobi baba vanina tsila, vayi bamona biawu ayi bavana biawu mboti buna bakidi thama ayi bawu veka bazaba ti badi banzenza ayi minkibi vava ntoto. <verse eid="HEB 11:13"/><verse number="14" style="v" sid="HEB 11:14"/>Batu bantubila bobo bammonisa bumboti ti tsi awu veka bantomba. <verse eid="HEB 11:14"/><verse number="15" style="v" sid="HEB 11:15"/>Bila enati beti yindula tsi yoyi batotukila nganu babaka diluaku di buela mu vutuka. <verse eid="HEB 11:15"/><verse number="16" style="v" sid="HEB 11:16"/>Vayi buabu tsi yi kitoko bantomba, tsi yi diyilu. Diawu Nzambi kamonanga tsoni ko ti bantedila Nzambi awu, bila wuba kubikila divula.<verse eid="HEB 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17"/>Mu diambu di minu, Abalahami wutambika Isaki banga dikaba diyoko mu thangu Nzambi kantota. Niandi wutambula tsila vayi wuba wukubama mu tambika muanꞌandi wumosi kaka. <verse eid="HEB 11:17"/><verse number="18" style="v" sid="HEB 11:18"/>Ka diambu ko Nzambi wunkamba : <char style="qt">Mu Isaki wela bakila nkuna.</char><verse eid="HEB 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 11:19"/>Abalahami wumona ti Nzambi beki lulendo lu fulukisila Isaki mu bafua. Bukiedika Abalahami wutambula Isaki bu bamfulukisa.<verse eid="HEB 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20"/>Mu diambu di minu, Isaki wusakumuna Yakobi ayi Esawu mu diambu di mambu momo mankuiza ku ntuala. <verse eid="HEB 11:20"/><verse number="21" style="v" sid="HEB 11:21"/>Mu diambu di minu, Yakobi, tuamina lufua luandi, wusakumuna kadika muana wu Zozefi ayi wusambila Nzambi bu kasingimina mutsongi ntiꞌandi.<verse eid="HEB 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22"/>Mu diambu di minu, Zozefi, bu kamona ti weka nduka fua, wuyolukila thotokolo yi bana ba Iseli mu tsi Ezipite ayi wuvana lutumunu mu diambu di mambu momo bafueti vanga mu mimvesi miandi.<verse eid="HEB 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23"/>Mu diambu di minu, bambuta ba Moyize basueka muanꞌawu mu tezo ki zingondi zitatu bila zimona ti muana wuba wukitoko ayi kadi tsisi zisia mona ko mu tinguna lutumunu lu ntinu.<verse eid="HEB 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24"/>Mu diambu di minu, Moyize, bu kayunduka, wumanga kuandi tedolo muana wu muana wunketo wu Falawo. <verse eid="HEB 11:24"/><verse number="25" style="v" sid="HEB 11:25"/>Wumanga mona makhini mu ndambu thangu madi mu masumu vayi wuluta zola mona ziphasi va kimosi ayi batu ba Nzambi. <verse eid="HEB 11:25"/><verse number="26" style="v" sid="HEB 11:26"/>Bila niandi wumona tsoni yoyi Klisto kafueti fua yidi kimvuama kinneni kiviokidi kioki ki Ezipite bila meso mandi maba ntadidila mfutu wowo widi ku ntuala.<verse eid="HEB 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27"/>Mu diambu di minu, niandi wubika Ezipite mu kambu mona zinganzi zi ntinu tsisi. Wuba wukinda, bila niandi wumona Nzambi yika yimonikanga ko. <verse eid="HEB 11:27"/><verse number="28" style="v" sid="HEB 11:28"/>Mu diambu di minu, niandi wukembila pasika ayi wudukula menga mu mielo mu diambu di mbasi yitumu mu bunga yibika bunga bana batheti ba bana ba Iseli.<verse eid="HEB 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29"/>Mu diambu di minu, bana ba Iseli basabuka mbu wu mbuaki banga mu ntoto wuyuma. Vayi basi Ezipite bu bedi ka sabuka buna bamana diama.<verse eid="HEB 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30"/>Mu diambu di minu, bibaka bi Yeliko bi bua bana ba Iseli bu bazunga biawu tsambudi di bilumbu.<verse eid="HEB 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31"/>Mu diambu di minu, Lahabi, ka diambu ko wuba kuandi ndumba leta, wuvuka mu lufua va kimosi ayi batu bobo bamanga tumukina Nzambi, mu diambu kayakula bumboti batu batumu mu kinsueki mu tala Yeliko mu diela. <verse eid="HEB 11:31"/><verse number="32" style="v" sid="HEB 11:32"/>A mambu mbi ndieka buela tuba e ? Buna thangu mayiba yi fioti enati mfueti yolukila Ngedewoni, Balaki, Samisoni, Zefeti, Davidi, Samueli ayi mimbikudi. <verse eid="HEB 11:32"/><verse number="33" style="v" sid="HEB 11:33"/>Mu diambu di minu bawu babedisa mintinu, bavanga mambu ma busonga, batambula mambu momo baba vanina tsila ; bakangisa miunu mi zikhosi ; <verse eid="HEB 11:33"/><verse number="34" style="v" sid="HEB 11:34"/>bazima lulendo lu zimbazu zingolo ; bavuka bu bedi kavondo mu sabala ; batambula zingolo ka diambu ko baba bavonga ; bamonika binuani bingolo ku mvita ; batinisa nkangu wu masodi ma banzenza. <verse eid="HEB 11:34"/><verse number="35" style="v" sid="HEB 11:35"/>Mu diambu di minu kiawu baketo baba vutudila batu bawu bafua, mu mfulukulu.</para>
  <para style="p" vid="HEB 11:35">Muaki bankaka bayamusu ayi bamanga baba kula mu diambu di bazaba ti bela fuluka mu mfulukulu yi kitoko. <verse eid="HEB 11:35"/><verse number="36" style="v" sid="HEB 11:36"/>Bankaka basekonono, babeto bikoti, babakanga zisieni ayi bakotoso mu minloko. <verse eid="HEB 11:36"/><verse number="37" style="v" sid="HEB 11:37"/>Bankaka balozolo matadi, babasu mu bisi banga bu mbasulungu mabaya ; bavondolo mu bisabala, bakituka mindiengidi, bamvuata minkanda mi mamemi ayi mi zikhombo. Bakambu mamo ayi bibioso, babamonisa ziphasi ayi bayamusu. <verse eid="HEB 11:37"/><verse number="38" style="v" sid="HEB 11:38"/>Nza yisia ba yifuana mu diambu diawu ko. Badiengila mu makanga ayi mu miongo ; mu zithadi ayi mu mabulu madi mu ntoto.<verse eid="HEB 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39"/>Batu boso bobo, ka diambu ko batelomono kimbangi mu diambu di minu kiawu, vayi, kadi mutu kasia tambula ko bina biba vanunu tsila. <verse eid="HEB 11:39"/><verse number="40" style="v" sid="HEB 11:40"/>Bila Nzambi wutukubikila mambu ma kitoko, wuzola ti bakituka batu bafuana banga beto.<verse eid="HEB 11:40"/></para>
  <chapter eid="HEB 11"/>
  <chapter number="12" style="c" sid="HEB 12"/>
  <para style="s1">Tuzawula thinu mu kambu bonga</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1"/>Sumbu tuzungulu kuidi bambangi bawombo, bika tulozanu bizitu bioso ayi masumu makutuzungidilanga mu zindambu zioso. Vayi bika tuzawula thinu mu kambu vonga mu tsisani yidi yeto ku ntuala. <verse eid="HEB 12:1"/><verse number="2" style="v" sid="HEB 12:2"/>Bika thalu eto yiba kaka kuidi Yesu bila niandi wutona ayi wudukisa minu kieto. Niandi, mu diambu di khini yoyi yiba ku ntualꞌandi, wuvibidila va dikulusi ; kasia mona tsoni ko ayi buabu vuendi va koko ku lubakala lu kundu ki Kipfumu ki Nzambi.<verse eid="HEB 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3"/>Bika luyindulanu mutu wowo wuvibidila batu ba masumu, muingi lubika vonga ayi lebakana mu miela mieno.<verse eid="HEB 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4"/>Bu lueti nuanisa masumu, lutudidi ko mu tezo ki totula menga. <verse eid="HEB 12:4"/><verse number="5" style="v" sid="HEB 12:5"/>Buna luzimbakana kueno mambu mama makulukindisanga, momo Nzambi kalukamba banga ti niandi wunyoluka kuidi bana bandi e ?</para>
  <para style="q1" vid="HEB 12:5">
    <char style="qt">A Muanꞌama, kadi lenzanga thumbudulu yi Pfumu ;</char></para>
  <para style="q1" vid="HEB 12:5">
    <char style="qt">kadi vonga mu thangu kalembo ku temina,</char><verse eid="HEB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6"/>
    <char style="qt">bila Pfumu wuntumbudilanga mutu wowo keta zola,</char></para>
  <para style="q1" vid="HEB 12:6">
    <char style="qt">ayi wunzubanga lusuadi kuidi bobo kazebi</char></para>
  <para style="q1" vid="HEB 12:6">
    <char style="qt">ti badi bana bandi.</char><verse eid="HEB 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7"/>Luvibidila ziphasi zieno. Nzambi ziawu zidi mu diambu di kululudika. Nzambi wukulumonanga banga bana. Muana mbi wowo kakabakanga thumbudulu ko kuidi Dise ? <verse eid="HEB 12:7"/><verse number="8" style="v" sid="HEB 12:8"/>Enati lukadi baka thumbudulu yoyi yintambulanga bana boso, buna diodi dimmonisa ti luidi bana ba kindumba ; luisi khatika bana ko.<verse eid="HEB 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 12:9"/>Beto tuba ayi madise meto ma kinsuni makutuvananga thumbudulu vayi tukubakinzikanga. Mbi bi kutukandika mu luta tumukina dise di diyilu muingi tuzinga e ? <verse eid="HEB 12:9"/><verse number="10" style="v" sid="HEB 12:10"/>Madise meto ma kinsuni makutuvananga thumbudulu mu ndambu thangu, boso bubela mayindu mawu vayi Nzambi wukutuvananga thumbudulu mu diambu di mamboti meto, muingi mamveto tuba kithuadi mu bunlongo buandi.<verse eid="HEB 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 12:11"/>Bukiedika ti mu thangu yayi, thumbudulu yidi diambu di kiadi, bika di khini. Vayi kunzimunina yimbutanga luzingu lusonga lunzingulungu mu ndembama kuidi bawu batambula thumbudulu beni.<verse eid="HEB 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12"/>Diawu vumunanu mioko mieno mivonga ayi makuma meno ma lebakana, <verse eid="HEB 12:12"/><verse number="13" style="v" sid="HEB 12:13"/>bika luludika minsolo mu diambu di malu meno ; mu diambu di kulu ku bela kubika luta fumbuka vayi ku beluka.<verse eid="HEB 12:13"/></para>
  <para style="s1">Zinga luzingu lu nlongo</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14"/>Tunuananu mu ba mu ndembama ayi batu boso ayi zinga luzingu lunlongo bila kambu luzingu lunlongo, mutu kalendi mona Pfumu ko. <verse eid="HEB 12:14"/><verse number="15" style="v" sid="HEB 12:15"/>Lulubuka tala mutu kabika kambu nlemvo wu Nzambi, mu diambu di muanzi wu ndudi wedi mena va luidi ; muingi wubika totula divunzi ayi wubika bivisa bawombo mu beno. <verse eid="HEB 12:15"/><verse number="16" style="v" sid="HEB 12:16"/>Lulubuka muingi muna luidi, mutu kabika sala kindumba voti sekinina mambu ma nlongo banga bubela Esawu ; mutu wusumbisa kikulutu kiandi mu diambu di bidia. <verse eid="HEB 12:16"/><verse number="17" style="v" sid="HEB 12:17"/>Bila, luzebi kueno ti kunzimunina bu kedi ka buela tomba baka kiuka ki lusakumunu, kasia kikununu ko bila diluaku disia buela ba ko muingi kaviakisa mambu mavanga dise diandi ; ka diambu ko boso kaba ntomba lusakumunu buna wulembo didi.<verse eid="HEB 12:17"/></para>
  <para style="s1">Kipfumu kioki kakilendi nikuka ko</para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18"/>Lusia fikama ko banga bana ba Iseli, ku mongo wulenda simbu ; wowo wuba lema mbazu, ku tombi ki nkobo ayi ku vuka ; <verse eid="HEB 12:18"/><verse number="19" style="v" sid="HEB 12:19"/>voti ku tulumbeta ko voti ku mbembo yimosi yi tsisi yiba wakikisa mambu ma tsisi. Diawu batu bobo bawa yawu balomba mu diambu babika buela wa diaka mbembo beni. <verse eid="HEB 12:19"/><verse number="20" style="v" sid="HEB 12:20"/>Bila bamona ti balendi nunga ko mu kinzikanga lutumunu lolo lutotukila muawu ti : ka diambu ko bulu kinsimba mongo, kifueti vondolo mu matadi. <verse eid="HEB 12:20"/><verse number="21" style="v" sid="HEB 12:21"/>Mambu beni bu mabela ngolo tsisi, diawu niandi veka Moyize kayamikina ti : <char style="qt">Tsisi ndimmona ayi ndieka tita.</char><verse eid="HEB 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22"/>Vayi beno lutumbu fikama ku mongo wu Sioni, ku divula di Nzambi yi moyo, ku Yelusalemi di Diyilu ayi kuidi minkangu na minkangu mi zimbasi midi mu nkembo ; <verse eid="HEB 12:22"/><verse number="23" style="v" sid="HEB 12:23"/>ayi kuidi Dibundu di bana batheti ba Nzambi bobo mazina mawu madi masonama mu Diyilu. Beno lufikama kuidi Nzambi, zuzi di batu boso ; ayi kuidi ziphevi zi batu banlongo bamana fuana.<verse eid="HEB 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 12:24"/>Beno lutumbu fikama kuidi Yesu, phovi yi Nguizani yimona ayi kuidi menga mandi matenguka ; momo meti yoluka bumboti viokila buyolukila menga ma Abeli. <verse eid="HEB 12:24"/><verse number="25" style="v" sid="HEB 12:25"/>Lukeba tala luedi kambu wila mutu wowo wulembo yoluka. Bila enati bobo bamanga wila mutu wowo wuba lubula vava ntoto, basia vuka ko mu thumbudulu ; buna buevi buela bela kuidi beto enati tutembi manima kuidi mutu wowo wulembo yoluka tona ku Diyilu e ? <verse eid="HEB 12:25"/><verse number="26" style="v" sid="HEB 12:26"/>Mbemboꞌandi yinikuna ntoto vayi buabu wuveni tsila yayi : <char style="qt">Ndiela buela nikuna diaka, vayi bika sia ti wo ntoto kaka vayi ayi diyilu.</char> <verse eid="HEB 12:26"/><verse number="27" style="v" sid="HEB 12:27"/>Diambu diadi : diaka dinsundula ti bima bioso bilenda nikunu biobi bivangama, biela viakusu mu diambu biobi bi kabinikukanga ko bizingila.<verse eid="HEB 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28"/>Diawu, sumbu tuela tambula kipfumu kioki kakilendi nikuka ko, bika tuzaba vutudilanga Nzambi matondo ayi tunsadila mu phila yikumonisa khini mu tumamana ayi mu lukinzu. <verse eid="HEB 12:28"/><verse number="29" style="v" sid="HEB 12:29"/>Bila Nzambi eto widi mbazu yeti zinisanga.<verse eid="HEB 12:29"/></para>
  <chapter eid="HEB 12"/>
  <chapter number="13" style="c" sid="HEB 13"/>
  <para style="s1">Zindubu zi phila mu phila</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1"/>Bika luzolo lu kikhomba luzingila. <verse eid="HEB 13:1"/><verse number="2" style="v" sid="HEB 13:2"/>Lubika zimbakananga yakulanga banzenza bumboti bila batu bankaka bayakula zimbasi mu kambu zaba.<verse eid="HEB 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 13:3"/>Lutebukilanga moyo batu badi mu nloko banga ti mamveno luidi bakangama va kimosi ayi bawu. Lutebukilanga moyo batu bobo banyamusu bila beno mamveno lubeki zinitu ziozi zilenda yamusu.<verse eid="HEB 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4"/>Bika batu boso bakinzikanga dikuela. Mfulu yi batu bakuela yifueti banga yivedila bila Nzambi wela sambisa batu boso bansadilanga kindumba ayi kitsuza.<verse eid="HEB 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5"/>Bika khadulu eno yibika diatusu kuidi luzolo lu zimbongo. Monanganu khini mu bima bibi bidi yeno bila niandi veka Nzambi wutuba ti : <char style="qt">Ndilendi kuyekula ko, ndilendi ku loza ko !</char><verse eid="HEB 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 13:6"/>Diawu tubeki bu tubila mu diana dioso, ti :</para>
  <para style="q1" vid="HEB 13:6">
    <char style="qt">Pfumu niandi wukutsadisanga,</char></para>
  <para style="q1" vid="HEB 13:6">
    <char style="qt">ndilendi mona tsisi ko.</char></para>
  <para style="q1" vid="HEB 13:6">
    <char style="qt">Mutu mbi kalenda kuphanga e ?</char><verse eid="HEB 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7"/>Lutebukilanga moyo mintuadisi mieno mi lulonga mambu ma Nzambi. Luyindulanga tsukulu yi khadulu awu ayi lusokudila minu kiawu.<verse eid="HEB 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 13:8"/>Yesu Klisto widi phila yimosi kibedi yono ayi lumbu kiaki ayi mu mimvu mikamimani. <verse eid="HEB 13:8"/><verse number="9" style="v" sid="HEB 13:9"/>Lubika vunu mu malongi ma phila mu phila ayi ma nzenza. Bila bulutidi mfunu mintima mikindusu mu nlemvo wu Nzambi vayi bika mu khebolo yi mina mitedi ndiwulu, bila misadisanga ko bobobansadilanga miawu. <verse eid="HEB 13:9"/><verse number="10" style="v" sid="HEB 13:10"/>Tubeki diziku dintambukulungu makaba vayi batu bobo bansalanga mu nzo ngoto basi ko minsua mu dia. <verse eid="HEB 13:10"/><verse number="11" style="v" sid="HEB 13:11"/>Bila Pfumu yi zinganga Nzambi wunata menga ma bibulu mu diambu di ndemvokolo yi masumu, ku Buangu kilutidi nlongo. Vayi zinitu zi bibulu beni ziyokolo ku difula di Ka. <verse eid="HEB 13:11"/><verse number="12" style="v" sid="HEB 13:12"/>Diawu Yesu mamvandi kamonina ziphasi ku difula di Ka, mu diambu di vedisa batu mu menga mandi.<verse eid="HEB 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 13:13"/>Diawu bika tuenda kuidi niandi, kuna difula di Ka ayi tukikinina fua zitsoni ziozi kafua. <verse eid="HEB 13:13"/><verse number="14" style="v" sid="HEB 13:14"/>Bila vava tuisi ko divula dinzingilanga mu zithangu ziosovayi tulembo tombi divula diodi di nkuiza. <verse eid="HEB 13:14"/><verse number="15" style="v" sid="HEB 13:15"/>Mu diambu di Yesu, bika tutambikanga kuidi Nzambi dikaba di minkunga ; bu dinsundula ti tufueti sanisinanga dizina diandi. <verse eid="HEB 13:15"/><verse number="16" style="v" sid="HEB 13:16"/>Lubika zimbakana vanganga mamboti ayi kabulanga kuidi bakhomba bila makaba ma phila yoyi mawu mamonisanga Nzambi khini.<verse eid="HEB 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17"/>Lutumukinanga mintuadisi mieno ayi luba kinzikanga ; bila bawu beti sunga miela mieno ayi bela vumbudila Nzambi kipholo mu kisalu kiawu mu diambu basala kisalu kiawu mu khini vayi bika ku tsi manuinguta bila lulendi baka kadi lusadusu ko.<verse eid="HEB 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18"/>Lutusambidilanga bila tuzebi ti mayindu ma mintima mieto madi mamboti bu tutidi ba khadulu yimboti mu mambu moso. <verse eid="HEB 13:18"/><verse number="19" style="v" sid="HEB 13:19"/>Ndinluta kululomba luvanga diawu muingi ndivutulu nsualu kuidi beno.<verse eid="HEB 13:19"/></para>
  <para style="s1">Zimboti</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20"/>Bika Nzambi yi ndembama, yoyi yifulukisa Pfumu eto Yesu mu bafua ; mutu wowo widi nsungi wunneni wu mamemi mu nzila yi menga ma Nguizani yikayimani, <verse eid="HEB 13:20"/><verse number="21" style="v" sid="HEB 13:21"/>kalukitula bafuana mu vanga mavanga mamo mamboti mu diambu di vanga luzolo luandi bu keti vanga mu beto mambu moso momo makummonisanga khini mu lulendo lu Yesu Klisto. Bika katambula nkembo mu mimvu mioso. Amen.<verse eid="HEB 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22"/>A bakhomba, ndikululubula mu vibidila mambu momo ndilulubudidi bila mu mambu ma khufi kaka ndilusonikini. <verse eid="HEB 13:22"/><verse number="23" style="v" sid="HEB 13:23"/>Muaki luzaba ti khombꞌeto Timote wutotolo mu nloko. Enati wela vika kuiza, buna ndiela kuiza kulutala va kimosi ayi niandi.<verse eid="HEB 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24"/>Luvana mboti kuidi mintuadisi mieno mioso ayi kuidi banlongo boso. Basi Itali baluveni mboti.<verse eid="HEB 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25"/>Bika nlemvo wuba yeno beno boso. Amen !<verse eid="HEB 13:25"/></para>
  <chapter eid="HEB 13"/>
</usx>
