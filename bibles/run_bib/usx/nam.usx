  <para style="h">Nahumu</para>
  <para style="toc1">Igitabu c’uwavugishwa n’Imana Nahumu</para>
  <para style="toc2">Nahumu</para>
  <para style="toc3">Nah</para>
  <para style="mt2">Igitabu c’uwavugishwa n’Imana</para>
  <para style="mt1">Nahumu</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />Ibi ni ivyo Nahumu yavugishijwe vyerekeye Ninewe. Biri mu gitabu, akaba yabironse mu kwerekwa ari i Elikoshi.<verse eid="NAM 1:1" /></para>
  <para style="s1">
    <char style="nd">Uhoraho</char> ashavuriye Ninewe</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2" />
    <char style="nd">Uhoraho</char> ni Imana ipfuha kandi yihora;</para>
  <para style="q2" vid="NAM 1:2">
    <char style="nd">Uhoraho</char> ni Imana yihora kandi ifise uburake bwinshi.</para>
  <para style="q1" vid="NAM 1:2">
    <char style="nd">Uhoraho</char> yihora abamugwanya,</para>
  <para style="q2" vid="NAM 1:2">kandi uburake bwiwe abwamiza ku bansi biwe.<verse eid="NAM 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3" />
    <char style="nd">Uhoraho</char> ateba kuraka, ariko ni umunyenkomezi ahambaye;</para>
  <para style="q2" vid="NAM 1:3">
    <char style="nd">Uhoraho</char> nta ho azoreka guhana uwagiriwe n’icaha.</para>
  <para style="q1" vid="NAM 1:3">Yigaragariza mu gashururu no mu gihuhusi,</para>
  <para style="q2" vid="NAM 1:3">kandi ibicu ni nk’umukungugu musi y’ibirenge vyiwe.<verse eid="NAM 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4" />Akankamira ikiyaga kigakama,</para>
  <para style="q2" vid="NAM 1:4">agakamya inzuzi zose.</para>
  <para style="q1" vid="NAM 1:4">I Bashani n’i Karumeli harumye,</para>
  <para style="q2" vid="NAM 1:4">kandi amashurwe y’i Libani arakabiranye.<verse eid="NAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5" />Imisozi iratigita imbere yiwe,</para>
  <para style="q2" vid="NAM 1:5">udutumba tugashonga.</para>
  <para style="q1" vid="NAM 1:5">Isi ihinda agashitsi imbere yiwe,</para>
  <para style="q2" vid="NAM 1:5">co kimwe n’abayibako bose.<verse eid="NAM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6" />Ni nde yohagarara imbere y’uburake bwiwe,</para>
  <para style="q2" vid="NAM 1:6">ni nde yokwihanganira uburake bwiwe bw’inkazi?</para>
  <para style="q1" vid="NAM 1:6">Umujinya wiwe iyo usutswe umeze nk’umuriro;</para>
  <para style="q2" vid="NAM 1:6">amenagura ibitandara.<verse eid="NAM 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7" />
    <char style="nd">Uhoraho</char> ni mwiza,</para>
  <para style="q2" vid="NAM 1:7">ni ubuhungiro mu gihe c’amagorwa,</para>
  <para style="q1" vid="NAM 1:7">kandi yitaho abamuhungirako.<verse eid="NAM 1:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="NAM 1:8" />Ariko asendanishije nk’umwuzure w’amazi menshi,</para>
  <para style="q1" vid="NAM 1:8">azorandura Ninewe.</para>
  <para style="q2" vid="NAM 1:8">Kandi abansi biwe azobakurikirana, gushika no mu mwijima.<verse eid="NAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9" />Ivyo mutegura vyose vyo kugwanya <char style="nd">Uhoraho</char></para>
  <para style="q2" vid="NAM 1:9">Azokubita rimwe gusa, abarandure,</para>
  <para style="q2" vid="NAM 1:9">ntazorinda gukubita irya kabiri.<verse eid="NAM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10" />Abansi biwe bazomera nk’abari mu mahwa y’inzitane,</para>
  <para style="q2" vid="NAM 1:10">bamere nk’abantu baborewe umuvinyu mwinshi.</para>
  <para style="q2" vid="NAM 1:10">Bazotongorwa nk’ubwatsi bwumye.<verse eid="NAM 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11" />Muri wewe, yewe Ninewe, hariho uwosha abantu</para>
  <para style="q2" vid="NAM 1:11">afise imigabo mibi k’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="NAM 1:11">akagira inama mbi abantu.<verse eid="NAM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12" />Uku ni ko <char style="nd">Uhoraho</char> avuze:</para>
  <para style="q1" vid="NAM 1:12">“N’aho abansi bawe ari benshi kandi bakaba bakomeye,</para>
  <para style="q2" vid="NAM 1:12">bazorandurwa baherengetere.</para>
  <para style="q1" vid="NAM 1:12">Namwe Bayuda bantu banje, n’aho nigeze kubababaza,</para>
  <para style="q2" vid="NAM 1:12">sinzosubira.<verse eid="NAM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13" />Ngiye kuvuna ingogo iri ku bitugu vyanyu,</para>
  <para style="q2" vid="NAM 1:13">ncagagure n’iminyororo ibaboshe.”<verse eid="NAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14" />Uku ni ko <char style="nd">Uhoraho</char> ategetse ku bwawe, yewe Ninewe:</para>
  <para style="q2" vid="NAM 1:14">“Ntuzosubira kuronka uruvyaro rwitirirwa izina ryawe.</para>
  <para style="q1" vid="NAM 1:14">Nzorandura ibishushanyo bibajwe n’ibibumbano</para>
  <para style="q2" vid="NAM 1:14">biri mu ngoro z’imana zanyu.</para>
  <para style="q1" vid="NAM 1:14">Nzokwimbira imva,</para>
  <para style="q2" vid="NAM 1:14">kuko uri umunyakibi.”<verse eid="NAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15" />Ehe ku mpinga z’imisozi,</para>
  <para style="q2" vid="NAM 1:15">hari ibirenge vy’abazanye inkuru nziza,</para>
  <para style="q2" vid="NAM 1:15">bazanye inkuru z’amahoro!</para>
  <para style="q1" vid="NAM 1:15">Gira imisi mikuru yawe, yewe Yuda,</para>
  <para style="q2" vid="NAM 1:15">ushitse n’ivyo wasezeranye.</para>
  <para style="q1" vid="NAM 1:15">Nta banyakibi bazosubira kugutera;</para>
  <para style="q2" vid="NAM 1:15">kuko bazorandurwa baherengetere.<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s1">Ninewe hasenyuka</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1" />Ehe uwugutera arakwegereje, yewe Ninewe!</para>
  <para style="q2" vid="NAM 2:1">Rinda inzitiro,</para>
  <para style="q2" vid="NAM 2:1">rinda amabarabara,</para>
  <para style="q2" vid="NAM 2:1">kenyera zigume,</para>
  <para style="q2" vid="NAM 2:1">ambara inkomezi!<verse eid="NAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2" />
    <char style="nd">Uhoraho</char> agiye kugarukana icubahiro ca Yakobo,</para>
  <para style="q2" vid="NAM 2:2">nk’icubahiro ca Isirayeli,</para>
  <para style="q1" vid="NAM 2:2">naho abaranduzi bari bahasahuye,</para>
  <para style="q2" vid="NAM 2:2">bakahagira nk’umuzabibu wahonye.<verse eid="NAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3" />Inkinzo z’ingabo ziwe zisize ibara ritukura,</para>
  <para style="q2" vid="NAM 2:3">n’ingabo zambaye ibitukura.</para>
  <para style="q1" vid="NAM 2:3">Ivyuma vy’imikogote yiwe birakayangana,</para>
  <para style="q2" vid="NAM 2:3">ku musi wo kwitegura kwiwe,</para>
  <para style="q2" vid="NAM 2:3">amacumu akwikiye mu biti vy’amasederi arahungabana.<verse eid="NAM 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4" />Imikogote y’intambara irahinda mu mabarabara,</para>
  <para style="q2" vid="NAM 2:4">inyuragirana ahantu hose.</para>
  <para style="q1" vid="NAM 2:4">Imeze nk’ibishirira,</para>
  <para style="q2" vid="NAM 2:4">inyaruka nk’imiravyo.<verse eid="NAM 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5" />Umwami w’i Ninewe ahamagaye abakuru b’ingabo ziwe,</para>
  <para style="q2" vid="NAM 2:5">baza baratsitara mu nzira.</para>
  <para style="q1" vid="NAM 2:5">Bihuta baja ku nzitiro zaho,</para>
  <para style="q2" vid="NAM 2:5">bafashe inkinzo zo kwikingira.<verse eid="NAM 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6" />Inzugi zija ku ruzi zirabomowe,</para>
  <para style="q2" vid="NAM 2:6">n’ikirimba c’umwami kirahomvotse.<verse eid="NAM 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7" />Itegeko ryasohotse, rivuga ko ab’i Ninewe</para>
  <para style="q2" vid="NAM 2:7">bajanwa ari inyagano kure.</para>
  <para style="q1" vid="NAM 2:7">Incoreke zaho ziboroga nk’inuma</para>
  <para style="q2" vid="NAM 2:7">zikubita ku gikiriza.<verse eid="NAM 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8" />I Ninewe hameze nk’itangi y’amazi,</para>
  <para style="q2" vid="NAM 2:8">abantu baho biruka nk’amazi yayo iyo itobotse.</para>
  <para style="q1" vid="NAM 2:8">Umwe agasemerera, ati: “Hagarara, hagarara!”</para>
  <para style="q2" vid="NAM 2:8">Ariko mu bariko barahunga nta n’uwukebuka.<verse eid="NAM 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9" />Sahura ifeza!</para>
  <para style="q2" vid="NAM 2:9">Sahura inzahabu!</para>
  <para style="q1" vid="NAM 2:9">Ubutunzi bwaho ntibuhera,</para>
  <para style="q2" vid="NAM 2:9">huzuye ibintu vy’agaciro bidaharurika.<verse eid="NAM 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10" />Igisagara kirasahuwe, kirambuwe, kirasenyuwe!</para>
  <para style="q2" vid="NAM 2:10">Imitima irashonga, amavi acitse intege,</para>
  <para style="q2" vid="NAM 2:10">imibiri irajugumira, abantu bose barahinduriye mu maso.<verse eid="NAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11" />Icobo c’intare kiri hehe,</para>
  <para style="q2" vid="NAM 2:11">ico bagabuririramwo izikiri ntonto,</para>
  <para style="q1" vid="NAM 2:11">Cari ikibanza intambwe z’ingabo n’ingore zatemberanamwo</para>
  <para style="q2" vid="NAM 2:11">n’ivyana vyazo ata co zinona.<verse eid="NAM 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12" />Intambwe yahigira ivyana vyayo ibikwiye,</para>
  <para style="q2" vid="NAM 2:12">ikanigira ibikoko ingore yayo,</para>
  <para style="q1" vid="NAM 2:12">ikuzuza amasenga ivyo yishe,</para>
  <para style="q2" vid="NAM 2:12">ivyobo vyayo ikavyuzuza ivyo yasahuye.<verse eid="NAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13" />
    <char style="nd">Uhoraho</char> Mushoboravyose avuze ati:</para>
  <para style="q2" vid="NAM 2:13">“Nzokugwanya.</para>
  <para style="q1" vid="NAM 2:13">Nzoturira imikogote yawe icike umunyota,</para>
  <para style="q2" vid="NAM 2:13">intambwe zawe zikiri ntonto</para>
  <para style="q2" vid="NAM 2:13">zimarwe n’inkota.</para>
  <para style="q1" vid="NAM 2:13">Nta munyago nzogusigira kw’isi,</para>
  <para style="q2" vid="NAM 2:13">n’amajwi y’intumwa zawe ntazosubira kwumvikana.”<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s1">Ibara kuri Ninewe</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1" />Uzobona ibara, yewe wa mugwa wuzuye amaraso,</para>
  <para style="q2" vid="NAM 3:1">wuzuye ibinyoma,</para>
  <para style="q1" vid="NAM 3:1">wuzuye ubwambuzi,</para>
  <para style="q2" vid="NAM 3:1">utigera uburamwo umuvyimba!<verse eid="NAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2" />Umve urwamo rw’ibimoko,</para>
  <para style="q2" vid="NAM 3:2">uguhinda kw’amaguru y’imikogote,</para>
  <para style="q1" vid="NAM 3:2">umuvuduko w’amafarasi,</para>
  <para style="q2" vid="NAM 3:2">uguhinda kw’imikogote y’intambara!<verse eid="NAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3" />Ehe uwugwanira kw’ifarasi,</para>
  <para style="q2" vid="NAM 3:3">inkota zica ibibatsi,</para>
  <para style="q2" vid="NAM 3:3">n’amacumu ararabagirana!</para>
  <para style="q1" vid="NAM 3:3">Hari abishwe benshi,</para>
  <para style="q2" vid="NAM 3:3">ibirundo vy’imivyimba,</para>
  <para style="q1" vid="NAM 3:3">n’imivyimba myinshi</para>
  <para style="q2" vid="NAM 3:3">abantu bagenda bayitsitarako.<verse eid="NAM 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4" />Ivyo vyose bitewe n’ubusambanyi bwa maraya w’agahebuza,</para>
  <para style="q2" vid="NAM 3:4">w’ubwiza bukwega, umuhinga mu mareba,</para>
  <para style="q1" vid="NAM 3:4">yabohesheje amahanga ubusambanyi bwiwe,</para>
  <para style="q2" vid="NAM 3:4">amoko na yo akayabohesha uburozi bwiwe.<verse eid="NAM 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5" />“Nzokugwanya,”</para>
  <para style="q2" vid="NAM 3:5">ni ko <char style="nd">Uhoraho</char> Imana Mushoboravyose avuze.</para>
  <para style="q2" vid="NAM 3:5">“Nzoduza impuzu zawe ndazigupfuke mu maso.</para>
  <para style="q1" vid="NAM 3:5">Nzogaragariza amahanga ubwambure bwawe,</para>
  <para style="q2" vid="NAM 3:5">isi yose ndayereke ibiteye isoni vyawe.<verse eid="NAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6" />Nzokurundako ibiteye isoni,</para>
  <para style="q2" vid="NAM 3:6">nerekane ko ukengeretse,</para>
  <para style="q2" vid="NAM 3:6">ntume uba agatwengo.<verse eid="NAM 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7" />Abazokubona bose bazoguhunga,</para>
  <para style="q2" vid="NAM 3:7">bavuge bati: ‘Ninewe habaye umusaka;</para>
  <para style="q2" vid="NAM 3:7">ni nde yoharirira?’ ”<verse eid="NAM 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8" />Mbega uruta igisagara ca Tebesi,</para>
  <para style="q2" vid="NAM 3:8">cari ku nkengera y’uruzi Nili,</para>
  <para style="q2" vid="NAM 3:8">gikikujwe n’amazi?</para>
  <para style="q1" vid="NAM 3:8">Urwo ruzi ni rwo rwari rugikingiye,</para>
  <para style="q2" vid="NAM 3:8">kandi amazi yari akibereye nk’igihome kigikingira.<verse eid="NAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9" />Etiyopiya na Egiputa vyari inkomezi zaco zitagira aho ziherera;</para>
  <para style="q2" vid="NAM 3:9">Puti na Libiya vyari mu vyifatanije na co.<verse eid="NAM 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10" />Ariko caratewe kirafatwa,</para>
  <para style="q2" vid="NAM 3:10">abantu baco batwarwa mu kinyago.</para>
  <para style="q1" vid="NAM 3:10">Inzoya zaco ziciwe mu mayirabiri</para>
  <para style="q2" vid="NAM 3:10">zihondagujwe amabuye.</para>
  <para style="q1" vid="NAM 3:10">Abubahwa baco batwawe nk’abaja hakoreshejwe ubupfindo.</para>
  <para style="q2" vid="NAM 3:10">Abatware baho baboheshejwe iminyororo.<verse eid="NAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11" />Na wewe Ninewe uzoborerwa ku bw’umubabaro;</para>
  <para style="q2" vid="NAM 3:11">urondere ingene wokwinyegeza,</para>
  <para style="q2" vid="NAM 3:11">uhunge abansi bawe.<verse eid="NAM 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12" />Ibihome vyawe bimeze nk’ibiti vy’imisukoni,</para>
  <para style="q2" vid="NAM 3:12">iyo yeze ivyamwa vyayo vya mbere;</para>
  <para style="q1" vid="NAM 3:12">barayinyiganyiza,</para>
  <para style="q2" vid="NAM 3:12">insukoni zayo zigahungurukira mu kanwa k’uwuzirya.<verse eid="NAM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13" />Ehe raba ingabo zawe zose;</para>
  <para style="q2" vid="NAM 3:13">zisigaye zifise intege nke nk’abagore!</para>
  <para style="q1" vid="NAM 3:13">Amarembo yawe aratamanzuye,</para>
  <para style="q2" vid="NAM 3:13">yugururiwe abansi bawe;</para>
  <para style="q2" vid="NAM 3:13">umuriro na wo wacagaguye ibihindizo vyayo.<verse eid="NAM 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14" />Vomera mu bigega vy’amazi, amazi akwiye kuko ugiye guterwa,</para>
  <para style="q2" vid="NAM 3:14">ukomeze ibihome vyawe!</para>
  <para style="q1" vid="NAM 3:14">Katura ibumba,</para>
  <para style="q2" vid="NAM 3:14">ukanyage ubudongo,</para>
  <para style="q2" vid="NAM 3:14">ufate iforoma yo gufyatura amatafari yo kuzibira ibihengeri.<verse eid="NAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15" />Ariko na ho nyene, umuriro uzogutongora,</para>
  <para style="q2" vid="NAM 3:15">inkota izokurigata,</para>
  <para style="q2" vid="NAM 3:15">nk’uko inzige zirigita ivyatsi.</para>
  <para style="q1" vid="NAM 3:15">Nta wuzorokoka,</para>
  <para style="q2" vid="NAM 3:15">naho mwogwira mukangana n’inzige.<verse eid="NAM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16" />Wagwijije abadandaza</para>
  <para style="q2" vid="NAM 3:16">bangana n’inyenyeri zo kw’ijuru,</para>
  <para style="q1" vid="NAM 3:16">ariko bameze nk’inzige zitongora ibiterwa vyo mu gihugu,</para>
  <para style="q2" vid="NAM 3:16">zaheza zikagorora amababa zikigurukira.<verse eid="NAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17" />Abarinzi bawe bangana n’inzige,</para>
  <para style="q2" vid="NAM 3:17">n’abatware bawe bangana n’inzige</para>
  <para style="q2" vid="NAM 3:17">zirundana ku nzitiro iyo hakanye,</para>
  <para style="q1" vid="NAM 3:17">ariko akazuba katse zikigurukira,</para>
  <para style="q2" vid="NAM 3:17">kandi nta n’uwumenya irengero ryazo.<verse eid="NAM 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18" />Yewe mwami wa Ashuri, abungere barasinziriye kandi ntibazokwikangura;</para>
  <para style="q2" vid="NAM 3:18">abahambaye bararuhutse ubwa nyuma.</para>
  <para style="q1" vid="NAM 3:18">Ubwoko bwawe bushwiragiriye mu misozi,</para>
  <para style="q2" vid="NAM 3:18">kandi nta wo kubegeranya azoboneka.<verse eid="NAM 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19" />Nta kintu coshobora kugukiza,</para>
  <para style="q2" vid="NAM 3:19">kuko uruguma rwawe ntirushobora gukira.</para>
  <para style="q1" vid="NAM 3:19">Abumvise ivyakubayeko bose</para>
  <para style="q2" vid="NAM 3:19">bakoma amashi, bakwitamba ku muvyimba.</para>
  <para style="q1" vid="NAM 3:19">Kuko ukugira nabi kwawe</para>
  <para style="q2" vid="NAM 3:19">ata we kutasesereje.<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>