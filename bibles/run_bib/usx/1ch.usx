  <para style="h">1 Ngoma</para>
  <para style="toc1">Igitabu ca mbere c’ivyo ku Ngoma</para>
  <para style="toc2">1 Ngoma</para>
  <para style="toc3">1Ng</para>
  <para style="mt2">Igitabu ca mbere c’ivyo ku</para>
  <para style="mt1">Ngoma</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s1">Kuva kuri Adamu gushika kuri Nowa</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1" />Abakomoka kuri Adamu ni Seti, Enoshi,<verse eid="1CH 1:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2" />Kenani, Mahalaleli, Yaredi,<verse eid="1CH 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3" />Enoki, Metusela, Lameki,</para>
  <para style="li1" vid="1CH 1:3">Nowa.<verse eid="1CH 1:3" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="4" style="v" sid="1CH 1:4" />Abahungu ba Nowa ni: Shemu, Hamu na Yafeti.<verse eid="1CH 1:4" /></para>
  <para style="s2">Bene Yafeti</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5" />Bene Yafeti ni:</para>
  <para style="li2" vid="1CH 1:5">Gomeri, Magogi, Madayi, Yavani, Tubali, Mesheki na Tirasi.<verse eid="1CH 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6" />Bene Gomeri ni:</para>
  <para style="li2" vid="1CH 1:6">Ashikenazi, Difati na Togaruma.<verse eid="1CH 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7" />Bene Yavani ni:</para>
  <para style="li2" vid="1CH 1:7">Elisa, Tarushishi, Kitimu na Rodanimu.<verse eid="1CH 1:7" /></para>
  <para style="s2">Bene Hamu</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8" />Bene Hamu ni:</para>
  <para style="li2" vid="1CH 1:8">Kushi, Egiputa, Puti na Kanani.<verse eid="1CH 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9" />Bene Kushi ni:</para>
  <para style="li2" vid="1CH 1:9">Seba, Havila, Sabuta, Rama na Sabuteka.</para>
  <para style="li1" vid="1CH 1:9">Abahungu ba Rama ni:</para>
  <para style="li2" vid="1CH 1:9">Sheba na Dedani.<verse eid="1CH 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10" />Kushi yavyaye</para>
  <para style="li2" vid="1CH 1:10">Nimurodi, uwo ni we yatanguye kuba umuhizi mu ntambara kw’isi.<verse eid="1CH 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11" />Abakomotse kuri Egiputa ni</para>
  <para style="li2" vid="1CH 1:11">Abaludi, Abanami, Abalehabi, Abanafutuhi, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />Abapatirusi n’Abakasiluni (ari bo bakomotsweko n’Abafilisitiya) hamwe n’Abakafutori.<verse eid="1CH 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13" />Kanani yavyaye</para>
  <para style="li2" vid="1CH 1:13">Sidoni, ari we mfura yiwe, hamwe na Heti. <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />Kandi yakomotsweko n’Abayebusi, Abamori, Abagirugashi, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />Abahiwi, Abaruki, Abasini, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />Abaruvadi, Abazemari n’Abahamati.<verse eid="1CH 1:16" /></para>
  <para style="s2">Aba Shemu</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17" />Bene Shemu ni:</para>
  <para style="li2" vid="1CH 1:17">Elamu, Ashuri, Arupakisade, Ludi na Aramu.</para>
  <para style="li1" vid="1CH 1:17">Abahungu ba Aramu ni:</para>
  <para style="li2" vid="1CH 1:17">Uzi, Huli, Geteri na Mesheki.<verse eid="1CH 1:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18" />Arupakisade yavyaye Shela,</para>
  <para style="li2" vid="1CH 1:18">Shela na we avyara Eberi.<verse eid="1CH 1:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19" />Eberi yavyaye abahungu babiri:</para>
  <para style="li2" vid="1CH 1:19">umwe yitwa Pelegi, kuko igihe yavuka abantu bari kw’isi bari bigabuyemwo ibice; uwundi bavukana yitwa Yokitani.<verse eid="1CH 1:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20" />Yokitani yavyaye</para>
  <para style="li2" vid="1CH 1:20">Alumodadi, Shelefu, Hazarumaveti, Yera, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />Hadoramu, Uzali, Dikula, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />Ebali, Abimayeli, Sheba, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />Ofiru, Havila na Yobabu. Abo bose bari abahungu ba Yokitani.<verse eid="1CH 1:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24" />Shemu, Arupakisade, Shela,<verse eid="1CH 1:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 1:25" />Eberi, Pelegi, Rewu,<verse eid="1CH 1:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 1:26" />Serugi, Nahori, Tera,<verse eid="1CH 1:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 1:27" />na Aburamu (ari we Aburahamu).<verse eid="1CH 1:27" /></para>
  <para style="s1">Umuryango wa Aburahamu</para>
  <para style="lh">
    <verse number="28" style="v" sid="1CH 1:28" />Bene Aburahamu ni: Isaka na Ishimayeli.<verse eid="1CH 1:28" /></para>
  <para style="s2">Abakomoka kuri Hagari</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29" />Uru ni rwo ruvyaro rwabo:</para>
  <para style="li2" vid="1CH 1:29">Nebayoti imfura ya Ishimayeli, Kedari, Adibeyeli, Mibusamu, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />Mishima, Duma, Masa, Hadadi, Tema, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />Yeturi, Nafishi na Kedema.</para>
  <para style="lf" vid="1CH 1:31">Abo ni bo bari bene Ishimayeli.<verse eid="1CH 1:31" /></para>
  <para style="s2">Abakomoka kuri Ketura</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32" />Abo Aburahamu yavyaranye na Ketura incoreke yiwe, ni</para>
  <para style="li2" vid="1CH 1:32">Zimurani, Yokishani, Medani, Midiyani, Ishibaki na Shuwa.</para>
  <para style="li1" vid="1CH 1:32">Bene Yokishani ni</para>
  <para style="li2" vid="1CH 1:32">Sheba na Dedani.<verse eid="1CH 1:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33" />Bene Midiyani ni</para>
  <para style="li2" vid="1CH 1:33">Efa, Eferi, Hanoki, Abida na Eludaya.</para>
  <para style="lf" vid="1CH 1:33">Urwo ni rwo ruvyaro Aburahamu yavyaranye na Ketura.<verse eid="1CH 1:33" /></para>
  <para style="s2">Abakomoka kuri Sara</para>
  <para style="lh">
    <verse number="34" style="v" sid="1CH 1:34" />Aburahamu yavyaye Isaka.</para>
  <para style="li1" vid="1CH 1:34">Bene Isaka ni:</para>
  <para style="li2" vid="1CH 1:34">Esawu na Isirayeli.<verse eid="1CH 1:34" /></para>
  <para style="s1">Bene Esawu</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35" />Bene Esawu, ni</para>
  <para style="li2" vid="1CH 1:35">Elifazi, Reyuweli, Yewushi, Yalamu na Kora.<verse eid="1CH 1:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36" />Bene Elifazi, ni</para>
  <para style="li2" vid="1CH 1:36">Temani, Omari, Zefo, Gatamu na Kenazi;</para>
  <para style="li2" vid="1CH 1:36">Timuna na Amaleki.<verse eid="1CH 1:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37" />Bene Reyuweli, ni</para>
  <para style="li2" vid="1CH 1:37">Nahati, Zera, Shama na Miza.<verse eid="1CH 1:37" /></para>
  <para style="s2">Abantu b’i Seyiri muri Edomu</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38" />Bene Seyiri, ni</para>
  <para style="li2" vid="1CH 1:38">Lotani, Shobali, Zibeyoni, Ana, Dishoni, Ezeri na Dishani.<verse eid="1CH 1:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39" />Bene Lotani, ni</para>
  <para style="li2" vid="1CH 1:39">Hori na Homamu. Timuna yari mushiki wa Lotani.<verse eid="1CH 1:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40" />Bene Shobali, ni</para>
  <para style="li2" vid="1CH 1:40">Alivani, Manahati, Ebali, Shefo na Onamu.</para>
  <para style="li1" vid="1CH 1:40">Bene Zibeyoni, ni</para>
  <para style="li2" vid="1CH 1:40">Ayiya na Ana.<verse eid="1CH 1:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41" />Mwene Ana, ni</para>
  <para style="li2" vid="1CH 1:41">Dishoni.</para>
  <para style="li1" vid="1CH 1:41">Bene Dishoni, ni</para>
  <para style="li2" vid="1CH 1:41">Hemudani, Eshibani, Itirani na Kerani.<verse eid="1CH 1:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42" />Bene Ezeri ni</para>
  <para style="li2" vid="1CH 1:42">Bilihani, Zayavani na Akani.</para>
  <para style="li1" vid="1CH 1:42">Bene Dishani, ni</para>
  <para style="li2" vid="1CH 1:42">Uzi na Arani.<verse eid="1CH 1:42" /></para>
  <para style="s2">Abatware ba Edomu</para>
  <para style="lh">
    <verse number="43" style="v" sid="1CH 1:43" />Uru ni rwo rukurikirane rw’abami batwaye mu gihugu ca Edomu, imbere y’uko Isirayeli yimika umwami n’umwe:</para>
  <para style="li1" vid="1CH 1:43">Bela mwene Beyori, igisagara ciwe citwa Dinihaba.<verse eid="1CH 1:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44" />Bela apfuye, asubirirwa ku ngoma na Yobabu mwene Zera yava i Bozira.<verse eid="1CH 1:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45" />Yobabu apfuye, asubirirwa ku ngoma na Hushamu yava mu gihugu c’Abatemani.<verse eid="1CH 1:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46" />Hushamu apfuye, asubirirwa ku ngoma na Hadadi mwene Bedadi, ari we yanesheje Abamidiyani mu gihugu ca Mowabu. Igisagara ciwe citwa Aviti.<verse eid="1CH 1:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47" />Hadadi apfuye, asubirirwa ku ngoma na Samula yava i Masireka.<verse eid="1CH 1:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48" />Samula apfuye, asubirirwa ku ngoma na Shawuli yava i Rehoboti hafi y’uruzi.<verse eid="1CH 1:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49" />Shawuli apfuye, asubirirwa ku ngoma na Bayali-Hanani mwene Akibori.<verse eid="1CH 1:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50" />Bayali-Hanani apfuye, asubirirwa ku ngoma na Hadadi. Igisagara ciwe citwa Pawu, umugore wiwe yitwa Mehetabeli, umukobwa wa Materedi, akaba n’umwuzukuru wa Mezahabu. <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />Hadadi na we nyene arapfa.</para>
  <para style="b" vid="1CH 1:51" />
  <para style="lh" vid="1CH 1:51">Abakuru b’imiryango y’Abanyedomu bari aba:</para>
  <para style="li1" vid="1CH 1:51">Timuna, Aluva, Yeteti, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />Oholibama, Ela, Pinoni, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />Kenazi, Temani, Mibuzari, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />Magidiyeli na Iramu.</para>
  <para style="lf" vid="1CH 1:54">Abo ni bo bari abakuru b’imiryango ya Edomu.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s1">Bene Isirayeli</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 2:1" />Aba ni bo bahungu ba Isirayeli: Reyubeni, Simeyoni, Lewi, Yuda, Isakari, Zebuloni, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />Dani, Yosefu, Benyamini, Nafutali, Gadi na Asheri.<verse eid="1CH 2:2" /></para>
  <para style="s1">Yuda</para>
  <para style="s2">Kugeza kuri bene Hezironi</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3" />Bene Yuda ni aba:</para>
  <para style="li2" vid="1CH 2:3">Eri, Onani na Shela. Abo uko ari batatu yari yabavyaye ku Munyakananikazi, umukobwa wa Shuwa.</para>
  <para style="li2" vid="1CH 2:3">(Eri, imfura ya Yuda yari umunyakibi mu nyonga z’<char style="nd">Uhoraho</char>; nuko <char style="nd">Uhoraho</char> aramwica.)<verse eid="1CH 2:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4" />Yuda yavyaye Perezi na Zera ku mukazana wiwe Tamari.</para>
  <para style="lf" vid="1CH 2:4">Yuda yari afise abahungu batanu bose hamwe.<verse eid="1CH 2:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5" />Bene Perezi ni aba:</para>
  <para style="li2" vid="1CH 2:5">Hezironi na Hamuli.<verse eid="1CH 2:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6" />Bene Zera ni aba:</para>
  <para style="li2" vid="1CH 2:6">Zimuri, Etani, Hemani, Kalikoli na Daruda: bose hamwe bari batanu.<verse eid="1CH 2:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7" />Mwene Karumi yari:</para>
  <para style="li2" vid="1CH 2:7">Akani, yateje amagorwa menshi Abisirayeli mu kunyuruza ibintu vyari vyagizwe inyegu y’<char style="nd">Uhoraho</char>.<verse eid="1CH 2:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8" />Mwene Etani yari:</para>
  <para style="li2" vid="1CH 2:8">Azariya.<verse eid="1CH 2:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9" />Bene Hezironi bari:</para>
  <para style="li2" vid="1CH 2:9">Yerahimeyeli, Ramu na Kalebu.<verse eid="1CH 2:9" /></para>
  <para style="s2">Abakomotse kuri Ramu mwene Hezironi</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10" />Ramu ni we se wa</para>
  <para style="li2" vid="1CH 2:10">Aminadabu,</para>
  <para style="li1" vid="1CH 2:10">Aminadabu avyara Nahashoni, yari umukuru w’umuryango wa Yuda.<verse eid="1CH 2:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 2:11" />Nahashoni yari se wa Salumoni,</para>
  <para style="li1" vid="1CH 2:11">Salumoni yavyaye Bowazi,<verse eid="1CH 2:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 2:12" />Bowazi yavyaye Obedi</para>
  <para style="li1" vid="1CH 2:12">maze Obedi avyara Isayi.<verse eid="1CH 2:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13" />Isayi yari se wa</para>
  <para style="li2" vid="1CH 2:13">Eliyabu imfura yiwe; umuhungu wiwe wa kabiri yari Abinadabu,</para>
  <para style="li2" vid="1CH 2:13">uwa gatatu yari Shimeya, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />Uwa kane Netaneli,</para>
  <para style="li2" vid="1CH 2:14">uwa gatanu Radayi, <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />uwa gatandatu Ozemi</para>
  <para style="li2" vid="1CH 2:15">n’uw’indwi Dawidi.<verse eid="1CH 2:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 2:16" />Bashiki babo bari Zeruwiya na Abigayili.</para>
  <para style="li3" vid="1CH 2:16">Bene Zeruwiya batatu bari Abishayi, Yowabu na Asaheli.<verse eid="1CH 2:16" /></para>
  <para style="li3">
    <verse number="17" style="v" sid="1CH 2:17" />Abigayili yari nyina wa Amasa, se wa Amasa yari Yeteri Umwishimayeli.<verse eid="1CH 2:17" /></para>
  <para style="s2">Kalebu mwene Hezironi</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18" />Kalebu mwene Hezironi yari afise abana yavyaranye n’umugore wiwe Azuba Yeriyoti. Aba ni bo bari abahungu biwe:</para>
  <para style="li2" vid="1CH 2:18">Yesheri, Shobabu na Arudoni.<verse eid="1CH 2:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 2:19" />Azuba apfuye, Kalebu yarongoye Efurata, amuvyarako Huri.<verse eid="1CH 2:19" /></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 2:20" />Huri ni we yari se wa Uri, Uri na we yari se wa Bezaleli.<verse eid="1CH 2:20" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21" />Mu nyuma, Hezironi amaze imyaka mirongo itandatu arongora umukobwa wa Makiri se wa Gileyadi. Aryamana na we, aca avyara Segubi.<verse eid="1CH 2:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 2:22" />Segubi yavyaye Yayiro, yatwara ibisagara mirongo ibiri na bitatu i Gileyadi.<verse eid="1CH 2:22" /></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 2:23" />Ariko Geshuri na Siriya bigarurira Havivoti Yayiro, Kenati hamwe n’ibigwati bihakikuje, vyose hamwe vyari ibisagara mirongo itandatu.</para>
  <para style="lf" vid="1CH 2:23">Abo bose bari abakomoka kuri Makiri se wa Gileyadi.<verse eid="1CH 2:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24" />Hezironi amaze gupfira mu gisagara ca Kalebu Efurata, Abiya umugore wa Hezironi amuvyarira umuhungu amwita Ashihuri ari we se wa Tekowa.<verse eid="1CH 2:24" /></para>
  <para style="s2">Yerahimeyeli mwene Hezironi</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25" />Aba ni bene Yerahimeyeli imfura ya Hezironi:</para>
  <para style="li2" vid="1CH 2:25">Rami imfura yiwe, Buna, Oreni, Ozemi na Ahiya. <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />Yerahimeyeli yari afise uwundi mugore, yitwa Atara; Ni we nyina wa Onamu.<verse eid="1CH 2:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27" />Aba ni bo bene Rami imfura ya Yerahimeyeli:</para>
  <para style="li2" vid="1CH 2:27">Mayazi, Yamini na Ekeri.<verse eid="1CH 2:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28" />Bene Onamu ni:</para>
  <para style="li2" vid="1CH 2:28">Shamayi na Yada.</para>
  <para style="li1" vid="1CH 2:28">Bene Shamayi ni:</para>
  <para style="li2" vid="1CH 2:28">Nadabu na Abishuri. <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" />Umugore wa Abishuri yitwa Abihayili, ari we yamuvyariye Ahibani na Molidi.<verse eid="1CH 2:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30" />Bene Nadabu ni:</para>
  <para style="li2" vid="1CH 2:30">Seledi na Apipayimu. Seledi yapfuye atavyaye.<verse eid="1CH 2:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31" />Mwene Apipayimu ni:</para>
  <para style="li2" vid="1CH 2:31">Ishi, ari we se wa Sheshani. Sheshani yari se wa Ahilayi.<verse eid="1CH 2:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32" />Bene Yada, umuvukanyi wa Shamayi ni:</para>
  <para style="li2" vid="1CH 2:32">Yeteri na Yonatani. Yeteri yapfuye atavyaye.<verse eid="1CH 2:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33" />Bene Yonatani ni:</para>
  <para style="li2" vid="1CH 2:33">Peleti na Zaza.</para>
  <para style="lf" vid="1CH 2:33">Abo ni bo ruvyaro rwa Yerahimeyeli.<verse eid="1CH 2:33" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34" />Sheshani nta bahungu yari afise, yavyaye abakobwa gusa.</para>
  <para style="li2" vid="1CH 2:34">Yari afise umugurano w’Umunyegiputa yitwa Yarahu. <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />Sheshani ashingira umukobwa wiwe uwo mugurano wiwe Yarahu, aca avyara Atayi.<verse eid="1CH 2:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36" />Atayi ni we se wa Natani,</para>
  <para style="li1" vid="1CH 2:36">Natani akaba se wa Zabadi,<verse eid="1CH 2:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37" />Zabadi akaba se wa Efulali,</para>
  <para style="li1" vid="1CH 2:37">Efulali akaba se wa Obedi,<verse eid="1CH 2:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38" />Obedi se wa Yehu,</para>
  <para style="li1" vid="1CH 2:38">Yehu se wa Azariya,<verse eid="1CH 2:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39" />Azariya mwene Helezi,</para>
  <para style="li1" vid="1CH 2:39">Helezi se wa Eleyasa<verse eid="1CH 2:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40" />Eleyasa se wa Sisimayi,</para>
  <para style="li1" vid="1CH 2:40">Sisimayi se wa Shalumu,<verse eid="1CH 2:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41" />Shalumu se wa Yekamiya,</para>
  <para style="li1" vid="1CH 2:41">Yekamiya se wa Elishama.<verse eid="1CH 2:41" /></para>
  <para style="s2">Inzu zikomoka kuri Kalebu</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42" />Bene Kalebu umuvukanyi wa Yerahimeyeli ni:</para>
  <para style="li2" vid="1CH 2:42">Mesha imfura yiwe, ari we yari se wa Zifu,</para>
  <para style="li2" vid="1CH 2:42">n’umuhungu wiwe Maresha, yari se wa Heburoni.<verse eid="1CH 2:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43" />Bene Heburoni ni:</para>
  <para style="li2" vid="1CH 2:43">Kora, Tapuwa, Rekemu na Shema.<verse eid="1CH 2:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 2:44" />Shema ni we yari se wa Rahamu,</para>
  <para style="li2" vid="1CH 2:44">Rahamu akaba se wa Yorikeyamu.</para>
  <para style="li1" vid="1CH 2:44">Rekemu yari se wa Shamayi.<verse eid="1CH 2:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 2:45" />Mwene Shamayi yari Mayoni,</para>
  <para style="li2" vid="1CH 2:45">Mayoni akaba se wa Beti-Zuri.<verse eid="1CH 2:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46" />Efa, incoreke ya Kalebu ni we yari nyina wa</para>
  <para style="li2" vid="1CH 2:46">Harani, Moza na Gazezi.</para>
  <para style="li2" vid="1CH 2:46">Harani yari se w’uwundi Gazezi.<verse eid="1CH 2:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47" />Bene Yahidayi ni:</para>
  <para style="li2" vid="1CH 2:47">Regemu, Yotamu, Geshani, Peleti, Efa na Shayafi.<verse eid="1CH 2:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48" />Mayaka, incoreke ya Kalebu, ni we yari nyina wa</para>
  <para style="li2" vid="1CH 2:48">Sheberi na Tirihana.<verse eid="1CH 2:48" /></para>
  <para style="li2">
    <verse number="49" style="v" sid="1CH 2:49" />Ni we yavyaye kandi Shayafi se wa Madumana</para>
  <para style="li2" vid="1CH 2:49">na Sheva se wa Makibena na Gibeya.</para>
  <para style="li1" vid="1CH 2:49">Umukobwa wa Kalebu yari Akisa.<verse eid="1CH 2:49" /></para>
  <para style="lf">
    <verse number="50" style="v" sid="1CH 2:50" />Abo ni bo bakomoka kuri Kalebu.</para>
  <para style="b" vid="1CH 2:50" />
  <para style="li1" vid="1CH 2:50">Abakomoka kuri Huri imfura ya Efurata ni:</para>
  <para style="li2" vid="1CH 2:50">Shobali se wa Kiriyati-Yeyarimu, <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />Saluma se wa Betelehemu, na Harefu se wa Beti-Gaderi.<verse eid="1CH 2:51" /></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52" />Abakomoka kuri Shobali se wa Kiriyati-Yeyarimu ni:</para>
  <para style="li2" vid="1CH 2:52">Harowe, igice c’Abamenuhoti, <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />kandi imiryango ya Kiriyati-Yeyarimu yari: Abaturi, Abaputi, Abashumati n’Abamishirayi. Abo ni bo bandurukwako n’Abazorati n’Abeshitayoli.<verse eid="1CH 2:53" /></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54" />Abakomoka kuri Saluma ni:</para>
  <para style="li2" vid="1CH 2:54">Betelehemu, Abanetofati, Aturoti-Beti-Yowabu, igice c’Abamanahati, Abazori, <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />n’imiryango y’abanyabwenge b’ivyanditswe baba i Yabesi: Abatirati, Abashimeyati n’Abasukati. Abo ni Abakayini bakomoka kuri Hamati, se w’ab’inzu ya Rekabu.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s2">Bene Dawidi</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 3:1" />Aba ni bo bahungu Dawidi yavyariye i Heburoni:</para>
  <para style="b" vid="1CH 3:1" />
  <para style="li1" vid="1CH 3:1">imfura yiwe ni Amunoni, nyina yari Ahinowamu w’i Yezireyeli;</para>
  <para style="li1" vid="1CH 3:1">uwa kabiri ni Daniyeli, nyina yari Abigayili w’i Karumeli;<verse eid="1CH 3:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2" />uwa gatatu ni Abusalomu, nyina yari Mayaka umukobwa wa Talumayi umwami w’i Geshuri;</para>
  <para style="li1" vid="1CH 3:2">uwa kane ni Adoniya, nyina yari Hagiti;<verse eid="1CH 3:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3" />uwa gatanu, Shefatiya, nyina yari Abitali;</para>
  <para style="li1" vid="1CH 3:3">n’uwa gatandatu, Itureyamu, uwo yavyaranye n’umugore wiwe Egula.<verse eid="1CH 3:3" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="4" style="v" sid="1CH 3:4" />Abo uko ari batandatu ni bo Dawidi yavyariye i Heburoni, aho yamaze imyaka indwi n’amezi atandatu ari umwami.</para>
  <para style="b" vid="1CH 3:4" />
  <para style="b" vid="1CH 3:4" />
  <para style="lh" vid="1CH 3:4">Imyaka Dawidi yamaze ari umwami i Yerusalemu ni mirongo itatu n’itatu, <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />kandi aba ni bo bana yavyariye i Yerusalemu:</para>
  <para style="b" vid="1CH 3:5" />
  <para style="li1" vid="1CH 3:5">Shimeya, Shobabu, Natani na Salomo. Abo uko ari bane yabavyaranye na Batisheba umukobwa wa Amiyeli.<verse eid="1CH 3:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 3:6" />Hariho na Ibuhari, Elishama, Elifeleti, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />Nogahu, Nefegi, Yafiya, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />Elishama, Eliyada na Elifeleti, bose hamwe bari icenda.<verse eid="1CH 3:8" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="9" style="v" sid="1CH 3:9" />Abo bose ni bo bari bene Dawidi, udashizemwo abo yavyaranye n’incoreke ziwe. Kandi Tamari ni we wenyene yari mushiki wabo.<verse eid="1CH 3:9" /></para>
  <para style="s2">Abami b’i Buyuda</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10" />Abakomoka kuri Salomo ni Rehobowamu</para>
  <para style="li1" vid="1CH 3:10">umuhungu wiwe, Abiya</para>
  <para style="li1" vid="1CH 3:10">umuhungu wiwe, Asa</para>
  <para style="li1" vid="1CH 3:10">umuhungu wiwe, Yehoshafati<verse eid="1CH 3:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11" />umuhungu wiwe, Yoramu</para>
  <para style="li1" vid="1CH 3:11">umuhungu wiwe, Ahaziya</para>
  <para style="li1" vid="1CH 3:11">umuhungu wiwe, Yowashi<verse eid="1CH 3:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12" />umuhungu wiwe, Amaziya</para>
  <para style="li1" vid="1CH 3:12">umuhungu wiwe, Azariya</para>
  <para style="li1" vid="1CH 3:12">umuhungu wiwe, Yotamu<verse eid="1CH 3:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13" />umuhungu wiwe, Ahazi</para>
  <para style="li1" vid="1CH 3:13">umuhungu wiwe, Hezekiya</para>
  <para style="li1" vid="1CH 3:13">umuhungu wiwe, Manase<verse eid="1CH 3:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14" />umuhungu wiwe, Amoni</para>
  <para style="li1" vid="1CH 3:14">umuhungu wiwe na Yosiya umuhungu wiwe.<verse eid="1CH 3:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15" />Abagiye ku ngoma inyuma ya Yosiya ni aba:</para>
  <para style="li2" vid="1CH 3:15">imfura yiwe Yohanani,</para>
  <para style="li2" vid="1CH 3:15">umuhungu wiwe wa kabiri Yehoyakimu,</para>
  <para style="li2" vid="1CH 3:15">umuhungu wiwe wa gatatu Zedekiya,</para>
  <para style="li2" vid="1CH 3:15">umuhungu wiwe wa kane Shalumu ari we Yehowahazi,<verse eid="1CH 3:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16" />Abagiye ku ngoma inyuma ya Yehoyakimu ni aba:</para>
  <para style="li2" vid="1CH 3:16">umuhungu wiwe Yehoyakini ari we Yekoniya</para>
  <para style="li2" vid="1CH 3:16">hamwe n’umuhungu wiwe Zedekiya.<verse eid="1CH 3:16" /></para>
  <para style="s2">Abo mu nda y’ingoma inyuma yo kuba inyagano</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17" />Abo mu ruvyaro rwa Yehoyakini yajanywe ari inyagano ni:</para>
  <para style="li2" vid="1CH 3:17">umuhungu wiwe Sheyalutiyeli, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />Malukiramu, Pedaya, Shenazari, Yekamiya, Hoshama na Nedabiya.<verse eid="1CH 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19" />Bene Pedaya ni:</para>
  <para style="li2" vid="1CH 3:19">Zerubabeli na Shimeyi.</para>
  <para style="li1" vid="1CH 3:19">Bene Zerubabeli ni:</para>
  <para style="li2" vid="1CH 3:19">Meshulamu na Hananiya. Shelomiti yari mushiki wabo. <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />Hariho n’abandi batanu ari bo: Hashuba, Oheli, Berekiya, Hasadiya na Yushabu-Hesedi.<verse eid="1CH 3:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21" />Abakomoka kuri Hananiya ni:</para>
  <para style="li2" vid="1CH 3:21">Pelatiya na Yeshaya, n’abahungu ba Refaya, ba Arunani, ba Obadiya n’aba Shekaniya.<verse eid="1CH 3:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22" />Abakomoka kuri Shekaniya ni:</para>
  <para style="li2" vid="1CH 3:22">Shemaya n’abahungu biwe: Hatushi, Igali, Bariya, Neyariya na Shafati, bose bari batandatu.<verse eid="1CH 3:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23" />Bene Neyariya ni:</para>
  <para style="li2" vid="1CH 3:23">Eliyowenayi, Hezekiya na Azirikamu, bose bari batatu.<verse eid="1CH 3:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24" />Bene Eliyowenayi ni:</para>
  <para style="li2" vid="1CH 3:24">Hadoviya, Eliyashibu, Pelaya, Akubu, Yohanani, Delaya na Anani bose, bari indwi.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s2">Abandi bakuru b’inzu mu muryango wa Yuda</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1" />Abakomoka kuri Yuda ni:</para>
  <para style="li2" vid="1CH 4:1">Perezi, Hezironi, Karumi, Huri na Shobali.<verse eid="1CH 4:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2" />Reyaya mwene Shobali yari se wa Yahati, Yahati akaba se wa Ahumayi na Lahadi. Abo bari abakuru b’inzu zigize Abazorati.<verse eid="1CH 4:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3" />Aba ni bo bene Etamu:</para>
  <para style="li2" vid="1CH 4:3">Yezireyeli, Ishima na Idibashi. Mushiki wabo yitwa Hazeleliponi. <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />Penuweli yari se wa Gedori, na Ezeri yari se wa Hushahi.</para>
  <para style="li1" vid="1CH 4:4">Aba bari abakomoka kuri Huri, imfura ya Efurata akaba se wa Betelehemu.<verse eid="1CH 4:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5" />Ashihuri se wa Tekowa yari afise abagore babiri, Hela na Nayara.<verse eid="1CH 4:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6" />Nayara yamuvyariye Ahuzami, Heferi, Temeni na Hayahashitari. Abo ni bo bakomotse kuri Nayara.<verse eid="1CH 4:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7" />Bene Hela ni:</para>
  <para style="li2" vid="1CH 4:7">Zereti, Zohari, Etinani, <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />na Kozi, yari se wa Anubi na Hazobeba hamwe n’abakuru b’inzu zigize Ahariheli mwene Harumi.<verse eid="1CH 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />Yabesi yarusha abavukanyi biwe icubahiro. Nyina wiwe yamwise Yabesi, agomba kuvuga ati: “Namuvyaye mu mubabaro mwinshi.” <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />Yabesi atakambira Imana y’Abisirayeli ati: “Icompa ukampezagira ukanyagurira intara yanje! Ukuboko kwawe kukabana nanje, ukandinda ikibi cose kugira ngo ntikimbabaze.” Maze Imana imuha ivyo yasavye.<verse eid="1CH 4:10" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11" />Kelubi, umuvukanyi wa Shuha, yari se wa Mehiri, se wa Eshitoni. <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />Eshitoni yari se wa Beti-Rafa, Paseya na Tehina, se wa Iri-Nahashi. Abo bari abantu b’i Reka.<verse eid="1CH 4:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13" />Bene Kenazi ni:</para>
  <para style="li2" vid="1CH 4:13">Otiniyeli na Seraya.</para>
  <para style="li1" vid="1CH 4:13">Bene Otiniyeli ni:</para>
  <para style="li2" vid="1CH 4:13">Hatati na Mewonotayi. <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />Mewonotayi yari se wa Ofura.</para>
  <para style="li1" vid="1CH 4:14">Seraya yari se wa Yowabu,</para>
  <para style="li2" vid="1CH 4:14">se wa Ge-Harashimu. Bahise gutyo kubera yuko abantu baho bari abahinga mu bikorwa.<verse eid="1CH 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15" />Bene Kalebu mwene Yefune ni:</para>
  <para style="li2" vid="1CH 4:15">Iru, Ela na Nayamu.</para>
  <para style="li1" vid="1CH 4:15">Mwene Ela ni:</para>
  <para style="li2" vid="1CH 4:15">Kenazi.<verse eid="1CH 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16" />Bene Yehaleleli ni:</para>
  <para style="li2" vid="1CH 4:16">Zifu, Zifa, Tiriya na Asareli.<verse eid="1CH 4:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17" />Bene Ezira ni:</para>
  <para style="li2" vid="1CH 4:17">Yeteri, Meredi, Eferi na Yaloni.</para>
  <para style="li1" vid="1CH 4:17">Umwe mu bagore ba Meredi ni we yavyaye Miriyamu, Shamayi na Ishiba se wa Eshitemowa. <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />Abo bari abana b’umukobwa wa Farawo Bitiya, uwo Meredi yari yararongoye.</para>
  <para style="li1" vid="1CH 4:18">Umugore wiwe akomoka mu muryango wa Yuda ni we yavyaye Yeredi se wa Gedori, Heberi se wa Soko, na Yekutiyeli se wa Zanowa.<verse eid="1CH 4:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19" />Abahungu bavutse ku mugore wa Hodiya, mushiki wa Nahamu ni:</para>
  <para style="li2" vid="1CH 4:19">Se wa Keyila Umugarumi, na Eshitemowa Umumayaka.<verse eid="1CH 4:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20" />Bene Shimoni ni:</para>
  <para style="li2" vid="1CH 4:20">Amunoni, Rina, Beni-Hanani na Tiloni.</para>
  <para style="li1" vid="1CH 4:20">Abakomoka kuri Ishi:</para>
  <para style="li2" vid="1CH 4:20">Zoheti na Beni-Zoheti.<verse eid="1CH 4:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21" />Abakomoka kuri Shela mwene Yuda ni:</para>
  <para style="li2" vid="1CH 4:21">Eri se wa Leka, Layada se wa Maresha n’imiryango y’abakora impuzu zera derere b’i Beti-Ashibeya,<verse eid="1CH 4:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 4:22" />Yokimu, abantu b’i Kozeba, na Yowashi na Sarafu, baganza i Mowabu na Yabushi Lehemu. Ibi vyanditswe ni ivyo mu bihe vya kera. <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />Ni bo babumvyi b’inkono baba i Netayimu n’i Gedera; bagumyeho kandi bakorera umwami.<verse eid="1CH 4:23" /></para>
  <para style="s1">Simeyoni</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24" />Abakomoka kuri Simeyoni ni:</para>
  <para style="li2" vid="1CH 4:24">Nemuweli, Yamini, Yaribu, Zera, na Shawuli;<verse eid="1CH 4:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25" />Shawuli yavyaye Shalumu, Shalumu avyara Mibusamu, Mibusamu nawe avyara Mishima.<verse eid="1CH 4:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26" />Abakomoka kuri Mishima ni:</para>
  <para style="li2" vid="1CH 4:26">Shimeyi mwene Zakuri, Zakuri mwene Hamuweli.<verse eid="1CH 4:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />Shimeyi yari afise abahungu icumi na batandatu n’abakobwa batandatu, ariko abo bavukana ntibaronse abana benshi; ni co catumye umuryango wabo wose utabaye munini nk’umuryango wa Yuda. <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />Baba i Berisheba, i Molada, i Hazari-Shuwali, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />i Biluha, i Ezemu, i Toladi, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />i Betuweli, i Horuma, i Zikulagi, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />i Beti-Marukaboti, i Hazari-Susimu, i Beti-Biri n’i Shayarayimu. Ivyo ni vyo vyari ibisagara vyabo gushika ku ngoma ya Dawidi. <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />Ibigwati vyabo vyari bihakikije vyari Etamu, Ayini, Rimoni, Tokeni na Ashani, vyose hamwe vyari ibisagara bitanu, <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />n’ibindi bigwati vyose vyari bihakikije gushika i Bayali. Aho ni ho baba.</para>
  <para style="b" vid="1CH 4:33" />
  <para style="lh" vid="1CH 4:33">Uru ni rwo rutonde rwa ba sekuruza babo:<verse eid="1CH 4:33" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34" />Mu bandi bakomotse kuri Simeyoni harimwo Meshobabu, Yamileki,</para>
  <para style="li1" vid="1CH 4:34">Yosha mwene Amaziya, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />Yoweli;</para>
  <para style="li1" vid="1CH 4:35">Yehu mwene Yoshibiya, mwene Seraya, mwene Asiyeli,<verse eid="1CH 4:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 4:36" />na Eliyowenayi, Yakoba, Yeshohaya,</para>
  <para style="li1" vid="1CH 4:36">Asaya, Adiyeli, Yesimiyeli, Benaya,<verse eid="1CH 4:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 4:37" />na Ziza mwene Shifi, mwene Aloni, mwene Yedaya, mwene Shimuri, mwene Shemaya.<verse eid="1CH 4:37" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="38" style="v" sid="1CH 4:38" />Urwo ni rwo rutonde rw’amazina y’abakuru b’inzu zabo.</para>
  <para style="b" vid="1CH 4:38" />
  <para style="p" vid="1CH 4:38">Uruvyaro rwabo rwaragwira cane, <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />maze baragenda gushika kw’irembo ry’i Gedori mu buseruko bw’ikiyaya barondera uburagiro bw’amasho yabo. <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />Basanga hari ubwatsi bwiza, butotahaye, kandi hagutse, hari amahoro, hatekanye. Abahamu ni bo bahora bahaba ubwa mbere.<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />Igihe Hezekiya umwami w’i Buyuda yari ku ngoma, abo bakuru bavuzwe bo mu muryango wa Simeyoni, batera iyo ntara y’Abahamu baba ngaho barabamara bose co kimwe n’Abameyunimu, nk’uko biri kugeza n’ubu. Maze baca basubira mu bibanza vyabo, kuko hari uburagiro bw’amasho yabo. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />Kandi abashika amajana atanu b’Abasimeyoni, barongowe na Pelatiya, Neyariya, Refaya na Uziyeli, bene Ishi, batera mu misozi y’i Seyiri. <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />Bica Abamaleki bari basigaye bahahungiye, baca bibera ngaho gushika n’uwu musi.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s1">Abakomoka kuri Reyubeni</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 5:1" />Umuhungu w’imfura wa Isirayeli yari Reyubeni. Ariko kubera yahumanije uburiri bwa se mu kuryamana n’umwe mu bagore biwe, vyatumye ukuba samuragwa kwiwe guhabwa bene Yosefu mwene Isirayeli. Ico ni co catumye atandikwa mu rukurikirane rw’intonde z’imfura. <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />Kandi naho Yuda ari we yarusha inkomezi bene se, kandi uwuganza akaba yavuye mu muryango wiwe, uburenganzira bwo kuba samuragwa bwahawe Yosefu. <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />Bene Reyubeni, imfura ya Isirayeli, ni:</para>
  <para style="b" vid="1CH 5:3" />
  <para style="li2" vid="1CH 5:3">Hanoki, Palu, Hezironi na Karumi.<verse eid="1CH 5:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4" />Abakomoka kuri Yoweli ni:</para>
  <para style="li2" vid="1CH 5:4">Shemaya, Gogi,</para>
  <para style="li2" vid="1CH 5:4">Shimeyi, <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />Mika,</para>
  <para style="li2" vid="1CH 5:5">Reyaya, Bayali,<verse eid="1CH 5:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6" />Beyera, uwo Tigulati-Pilineseri umwami w’i Ashuri yajanye nk’inyagano. Beyera yari umukuru w’umuryango w’Abareyubeni.<verse eid="1CH 5:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7" />Abakuru b’inzu mu muryango wabo, banditswe hakurikijwe uru rukurikirane:</para>
  <para style="li2" vid="1CH 5:7">Yeyiyeli umukuru wabo, Zakariya, <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />hamwe na Bela mwene Azazi, mwene Shema, umuhungu wa Yoweli.</para>
  <para style="b" vid="1CH 5:8" />
  <para style="p" vid="1CH 5:8">Baba mu ntara iva ahitwa Aroweri igashika i Nebo n’i Bayali-Meyoni. <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />Mu buseruko, baba mu gice gishika hafi y’ubugaragwa bugarukira ku ruzi Efurate, kuko imikuku yabo yari yaragwiririye i Gileyadi.<verse eid="1CH 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10" />Ku ngoma y’umwami Sawuli bagwanije Abahaguri, barabanesha; baca bigarurira aho Abahaguri bahora baba ari yo ntara yose iri mu buseruko bw’i Gileyadi.<verse eid="1CH 5:10" /></para>
  <para style="s1">Abakomoka kuri Gadi</para>
  <para style="lh">
    <verse number="11" style="v" sid="1CH 5:11" />Abagadi bahana urubibe n’Abareyubeni ahitwa Bashani, gushika i Saleka:<verse eid="1CH 5:11" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12" />Yoweli ni we yari umukuru wabo, Shafamu akaba icegera ciwe, hagakurikira Yanayi na Shafati b’i Bashani.<verse eid="1CH 5:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13" />Abo mu miryango yabo, nk’uko amazu yabo yari ari, bari:</para>
  <para style="li2" vid="1CH 5:13">Mikayeli, Meshulamu, Sheba, Yorayi, Yakani, Ziya na Eberi, bose bari indwi.<verse eid="1CH 5:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14" />Aba ni bo bari bene Abihayili mwene Huri, mwene Yarowa, mwene Gileyadi, mwene Mikayeli, mwene Yeshishayi, mwene Yahido, mwene Buzi.<verse eid="1CH 5:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15" />Ahi mwene Abudiyeli, mwene Guni, ni we yari umukuru w’umuryango wabo.<verse eid="1CH 5:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="1CH 5:16" />Abagadi baba i Gileyadi, i Bashani n’ibigwati vyahegukira, hamwe n’uburagiro bwose bw’i Sharoni iyo bwashika hose.<verse eid="1CH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17" />Abo bose banditswe mu bitabu vy’intonde ku ngoma ya Yotamu umwami w’i Buyuda na Yerobowamu umwami w’Ubwisirayeli.<verse eid="1CH 5:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />Abareyubeni, Abagadi n’igice c’umuryango wa Manase bari bafise ingabo zingana ibihumbi mirongo ine na bine n’amajana indwi na mirongo itandatu biteguye kuja ku rugamba, bize ivyo kugwana bashobora gukoresha inkinzo n’inkota, bashobora no gukoresha umuheto, bigishijwe ivy’intambara. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />Baja gutera Abahaguri b’i Yeturi, Nafishi n’i Nodabu. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />Muri iyo ntambara bizigira Imana barayambaza ngo ibafashe, maze yumva ugusenga kwabo, itanga Abahaguri n’ababafasha mu maboko yabo. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />Banyaga imikuku y’Abahaguri: ingamiya ibihumbi mirongo itanu, intama ibihumbi amajana abiri na mirongo itanu n’indogoba ibihumbi bibiri; bongera bajana abantu ibihumbi ijana nk’inyagano. <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />Abansi benshi bagwa mu ntambara, kuko Imana ari yo yariko irabagwanya. Baca bibera muri ico gihugu gushika mu gihe bajanwa nk’inyagano.<verse eid="1CH 5:22" /></para>
  <para style="s1">Igice c’umuryango wa Manase</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />Abakomoka ku gice c’umuryango wa Manase bari benshi; baba mu ntara y’i Bashani gushika i Bayali-Herumoni, ari ho Seniri.<verse eid="1CH 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24" />Aba ni bo bari abakuru b’inzu zigize uwo muryango: Eferi, Ishi, Eliyeli, Aziriyeli, Yeremiya, Hodaviya na Yahudiyeli. Bari abahizi bazi kugwana, ba rurangiranwa, bakaba abakuru b’inzu zigize uwo muryango wabo. <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />Ariko ntibubaha Imana ya ba sekuruza baca bifatanya n’ibigirwamana vy’abantu b’ico gihugu, abo Imana yirukanye imbere yabo. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />Maze Imana ya Isirayeli ikangura umutima wa Puli umwami w’i Ashuri: uwo ni we Tigulati-Pilineseri umwami w’i Ashuri, aca atwara nk’inyagano Abareyubeni, Abagadi n’igice c’umuryango wa Manase. Abajana i Halahi, Habori, Hara no ku ruzi rw’i Gozani, aho bagumye kugeza n’ubu.<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s1">Abakomoka kuri Lewi,</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1" />Bene Lewi ni:</para>
  <para style="li2" vid="1CH 6:1">Gerishoni, Kohati na Merari.<verse eid="1CH 6:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2" />Bene Kohati ni:</para>
  <para style="li2" vid="1CH 6:2">Amuramu, Izihari, Heburoni na Uziyeli.<verse eid="1CH 6:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3" />Bene Amuramu ni:</para>
  <para style="li2" vid="1CH 6:3">Aroni, Mose na Miriyamu.</para>
  <para style="li1" vid="1CH 6:3">Bene Aroni ni:</para>
  <para style="li2" vid="1CH 6:3">Nadabu, Abihu, Eliyazeri na Itamari.<verse eid="1CH 6:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4" />Eliyazeri yavyaye Finehasi,</para>
  <para style="li2" vid="1CH 6:4">Finehasi avyara Abishuwa,<verse eid="1CH 6:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5" />Abishuwa avyara Buki,</para>
  <para style="li2" vid="1CH 6:5">Buki avyara Uzi,<verse eid="1CH 6:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6" />Uzi avyara Zerahiya,</para>
  <para style="li2" vid="1CH 6:6">Zerahiya avyara Merayoti,<verse eid="1CH 6:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7" />Merayoti avyara Amariya,</para>
  <para style="li2" vid="1CH 6:7">Amariya avyara Ahitubu,<verse eid="1CH 6:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8" />Ahitubu avyara Sadoki,</para>
  <para style="li2" vid="1CH 6:8">Sadoki avyara Ahimazi,<verse eid="1CH 6:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9" />Ahimazi avyara Azariya,</para>
  <para style="li2" vid="1CH 6:9">Azariya avyara Yohanani,<verse eid="1CH 6:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10" />Yohanani avyara Azariya;</para>
  <para style="li2" vid="1CH 6:10">ni we yabaye umuherezi mu Ngoro yubatswe na Salomo i Yerusalemu,<verse eid="1CH 6:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11" />Azariya avyara Amariya,</para>
  <para style="li2" vid="1CH 6:11">Amariya avyara Ahitubu,<verse eid="1CH 6:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12" />Ahitubu avyara Sadoki,</para>
  <para style="li2" vid="1CH 6:12">Sadoki avyara Shalumu,<verse eid="1CH 6:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13" />Shalumu avyara Hilukiya,</para>
  <para style="li2" vid="1CH 6:13">Hilikiya avyara Azariya,<verse eid="1CH 6:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14" />Azariya avyara Seraya,</para>
  <para style="li2" vid="1CH 6:14">Seraya avyara Yehozadaki.<verse eid="1CH 6:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 6:15" />Yehozadaki yajanywe nk’inyagano igihe <char style="nd">Uhoraho</char> yarekura Abayuda n’ab’i Yerusalemu ngo bajanwe nk’inyagano na Nebukadineza.<verse eid="1CH 6:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16" />Bene Lewi ni:</para>
  <para style="li2" vid="1CH 6:16">Gerishoni, Kohati na Merari.<verse eid="1CH 6:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17" />Aya ni yo mazina ya bene Gerishoni:</para>
  <para style="li2" vid="1CH 6:17">Libuni na Shimeyi.<verse eid="1CH 6:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18" />Bene Kohati ni:</para>
  <para style="li2" vid="1CH 6:18">Amuramu, Izihari, Heburoni na Uziyeli.<verse eid="1CH 6:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19" />Bene Merari ni:</para>
  <para style="li2" vid="1CH 6:19">Mahuli na Mushi.</para>
  <para style="b" vid="1CH 6:19" />
  <para style="lh" vid="1CH 6:19">Aba ni bo bakuru b’inzu zigize umuryango w’Abalewi, banditswe nk’uko amazu ya ba se ari.<verse eid="1CH 6:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20" />Uru ni rwo ruvyaro rwa Gerishomu:</para>
  <para style="li2" vid="1CH 6:20">Gerishomu yavyaye Libuni, Libuni avyara Yahati,</para>
  <para style="li2" vid="1CH 6:20">Yahati avyara Zima, <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />Zima avyara Yowa,</para>
  <para style="li2" vid="1CH 6:21">Yowa avyara Ido, Ido avyara Zera,</para>
  <para style="li2" vid="1CH 6:21">Zera avyara Yeyaterayi.<verse eid="1CH 6:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22" />Uru ni rwo ruvyaro rwa Kohati:</para>
  <para style="li2" vid="1CH 6:22">Kohati yavyaye Aminadabu, Aminadabu avyara Kora,</para>
  <para style="li2" vid="1CH 6:22">Kora avyara Asiri, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />Asiri avyara Elukana,</para>
  <para style="li2" vid="1CH 6:23">Elukana avyara Ebiyasafu, Ebiyasafu avyara Asiri,<verse eid="1CH 6:23" /></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24" />Asiri avyara Tahati, Tahati avyara Uriyeli,</para>
  <para style="li2" vid="1CH 6:24">Uriyeli avyara Uziya, Uziya avyara Shawuli.<verse eid="1CH 6:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25" />Abakomoka kuri Elukana ni:</para>
  <para style="li2" vid="1CH 6:25">Amasayi, Ahimoti.<verse eid="1CH 6:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26" />Ahimoti yavyaye Elukana, Elukana avyara Zofayi,</para>
  <para style="li2" vid="1CH 6:26">Zofayi avyara Nahati, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />Nahati avyara Eliyabu,</para>
  <para style="li2" vid="1CH 6:27">Eliyabu avyara Yerohamu, Yerohamu avyara Elukana,</para>
  <para style="li2" vid="1CH 6:27">Elukana avyara Samweli.<verse eid="1CH 6:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28" />Bene Samweli ni:</para>
  <para style="li2" vid="1CH 6:28">Yoweli imfura yiwe</para>
  <para style="li2" vid="1CH 6:28">na Abiya umuhungu wiwe wa kabiri.<verse eid="1CH 6:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29" />Uru ni rwo ruvyaro rwa Merari:</para>
  <para style="li2" vid="1CH 6:29">Merari yavyaye Mahuli, Mahuli avyara Libuni,</para>
  <para style="li2" vid="1CH 6:29">Libuni avyara Shimeyi, Shimeyi avyara Uza,<verse eid="1CH 6:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30" />Uza avyara Shimeya, Shimeya avyara Hagiya,</para>
  <para style="li2" vid="1CH 6:30">Hagiya avyara Asaya.<verse eid="1CH 6:30" /></para>
  <para style="s2">Abacuraranzi bo mu Ngoro</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />Aba ni bo Dawidi yashizeho ngo bazezwe gucuraranga mu ngoro y’<char style="nd">Uhoraho</char> isandugu imaze kuhashika. <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />Bakorera Imana mu gucurarangira imbere y’Ihema ry’Ibonaniro, gushika Salomo yubatse Ingoro y’<char style="nd">Uhoraho</char> i Yerusalemu. Bakora igikorwa cabo bakurikije amategeko bahawe.<verse eid="1CH 6:32" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="33" style="v" sid="1CH 6:33" />Aba ni bo bantu bokora ico gikorwa, hamwe n’abahungu babo:</para>
  <para style="b" vid="1CH 6:33" />
  <para style="li1" vid="1CH 6:33">Abakomoka kuri Kohati ni:</para>
  <para style="li2" vid="1CH 6:33">Hemani, umucuraranzi,</para>
  <para style="li2" vid="1CH 6:33">mwene Yoweli, Yoweli mwene Samweli,<verse eid="1CH 6:33" /></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34" />Samweli mwene Elukana, Elukana mwene Yerohamu,</para>
  <para style="li2" vid="1CH 6:34">Yerohamu mwene Eliyeli, Eliyeli mwene Towa,<verse eid="1CH 6:34" /></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35" />Towa mwene Zufi, Zufi mwene Elukana,</para>
  <para style="li2" vid="1CH 6:35">Elukana mwene Mahati, Mahati mwene Amasayi,<verse eid="1CH 6:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36" />Amasayi mwene Elukana, Elukana mwene Yoweli,</para>
  <para style="li2" vid="1CH 6:36">Yoweli mwene Azariya, Azariya mwene Zefaniya,<verse eid="1CH 6:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37" />Zefaniya mwene Tahati, Tahati mwene Asiri,</para>
  <para style="li2" vid="1CH 6:37">Asiri mwene Ebiyasafu, Ebiyasafu mwene Kora,<verse eid="1CH 6:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38" />Kora mwene Izihari, Izihari mwene Kohati,</para>
  <para style="li2" vid="1CH 6:38">Kohati mwene Lewi, Lewi mwene Isirayeli;<verse eid="1CH 6:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39" />kandi Asafu ni we yari umukuru w’umugwi wakorera i buryo bwa Hemani. Asafu yari mwene Berekiya, Berekiya mwene Shimeya,<verse eid="1CH 6:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40" />Shimeya mwene Mikayeli, Mikayeli mwene Bayaseyiya,</para>
  <para style="li2" vid="1CH 6:40">Bayaseya mwene Malikiya, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />Malikiya mwene Etini,</para>
  <para style="li2" vid="1CH 6:41">Etini mwene Zera, Zera mwene Adaya,<verse eid="1CH 6:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42" />Adaya mwene Etani, Etani mwene Zima,</para>
  <para style="li2" vid="1CH 6:42">Zima mwene Shimeyi, <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />Shimeyi mwene Yahati,</para>
  <para style="li2" vid="1CH 6:43">Yahati mwene Gerishoni, Gerishomu mwene Lewi.<verse eid="1CH 6:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44" />Abandi bari bafatanije na we bari i bubamfu bwiwe ni abakomoka kuri Merari:</para>
  <para style="li2" vid="1CH 6:44">Etani yari mwene Kishi, Kishi mwene Abudi,</para>
  <para style="li2" vid="1CH 6:44">Abudi mwene Maluki, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />Maluki mwene Hashabiya,</para>
  <para style="li2" vid="1CH 6:45">Hashabiya mwene Amaziya, Amaziya mwene Hilukiya,<verse eid="1CH 6:45" /></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46" />Hilukiya mwene Amuzi, Amuzi mwene Bani,</para>
  <para style="li2" vid="1CH 6:46">Bani mwene Shemeri, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />Shemeri mwene Mahuli,</para>
  <para style="li2" vid="1CH 6:47">Mahuli mwene Mushi, Mushi mwene Merari,</para>
  <para style="li2" vid="1CH 6:47">Merari mwene Lewi.<verse eid="1CH 6:47" /></para>
  <para style="b" />
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />Abandi Balewi bagenzi babo bari bashinzwe ibindi bikorwa vyo mw’ihema, inzu y’Imana. <verse eid="1CH 6:48" /><verse number="49" style="v" sid="1CH 6:49" />Ariko Aroni n’abo mu ruvyaro rwiwe ni bo bari bashinzwe gutanga ibimazi ku gicaniro co guturirirako ibimazi n’ico guturirirako ibimota neza hamwe n’ibikorwa vyose bijanye n’ivyakorerwa Ahera Cane, harimwo gutanga impongano z’Abisirayeli, nk’uko Mose umusavyi w’Imana yari yarabitegetse.<verse eid="1CH 6:49" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50" />Aba ni bo bakomoka kuri Aroni:</para>
  <para style="li2" vid="1CH 6:50">Aroni yavyaye Eliyazeri, Eliyazeri avyara Finehasi,</para>
  <para style="li2" vid="1CH 6:50">Finehasi avyara Abishuwa, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />Abishuwa avyara Buki,</para>
  <para style="li2" vid="1CH 6:51">Buki avyara Uzi, Uzi avyara Zerahiya,<verse eid="1CH 6:51" /></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52" />Zerahiya avyara Merayoti, Merayoti avyara Amariya,</para>
  <para style="li2" vid="1CH 6:52">Amariya avyara Ahitubu, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />Ahitubu avyara Sadoki,</para>
  <para style="li2" vid="1CH 6:53">Sadoki avyara Ahimazi.<verse eid="1CH 6:53" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="54" style="v" sid="1CH 6:54" />Ibi ni vyo bisagara bahawe ngo babemwo nk’uko vyari vyaragenywe, vyari vyahawe abo mu nzu ya Kohati bo mu ruvyaro rwa Aroni, kuko umugabane wa mbere wari uwabo:<verse eid="1CH 6:54" /></para>
  <para style="li1">
    <verse number="55" style="v" sid="1CH 6:55" />Bahawe Heburoni mu Buyuda n’uburagiro buhakikuje. <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />Ariko imirima n’ibigwati bikikuje ico gisagara vyahawe Kalebu mwene Yefune.<verse eid="1CH 6:56" /></para>
  <para style="pi1">
    <verse number="57" style="v" sid="1CH 6:57" />Nuko abakomoka kuri Aroni bahawe ibisagara vy’ubuhungiro ari vyo Heburoni, Libuna, Yatiri, Eshitemowa, <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />Hileni, Debiri, <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />Ashani, Yuta n’i Beti-Shemeshi, hamwe rero n’uburagiro bwaho.<verse eid="1CH 6:59" /></para>
  <para style="li1">
    <verse number="60" style="v" sid="1CH 6:60" />Mu muryango wa Benyamini bahawe i Gibeyoni, Geba, Alemeti n’i Anatoti, hamwe n’uburagiro bwaho.</para>
  <para style="lf" vid="1CH 6:60">Ibisagara, vyahawe Abakohati, vyari icumi na bitatu vyose hamwe.<verse eid="1CH 6:60" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61" />Abasigaye mu Bakohati bahawe umugabane w’ibisagara cumi mu gice kimwe c’umuryango wa Manase.<verse eid="1CH 6:61" /></para>
  <para style="li1">
    <verse number="62" style="v" sid="1CH 6:62" />Abakomoka kuri Gerishomu, umuryango ku muryango, bahawe ibisagara icumi na bitatu vyo mu miryango ya Isakari, Asheri na Nafutali, no mu gice kimwe c’umuryango wa Manase cari i Bashani.<verse eid="1CH 6:62" /></para>
  <para style="li1">
    <verse number="63" style="v" sid="1CH 6:63" />Abakomotse kuri Merari, umuryango ku muryango, bahawe umugabane w’ibisagara icumi na bibiri vyo mu miryango ya Reyubeni, Gadi na Zebuloni.<verse eid="1CH 6:63" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="64" style="v" sid="1CH 6:64" />Nuko Abisirayeli baha Abalewi ivyo bisagara n’uburagiro bwavyo.<verse eid="1CH 6:64" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="65" style="v" sid="1CH 6:65" />Mu miryango ya Yuda, Simeyoni na Benyamini, baronse umugabane w’ivyo bisagara vyavuzwe, hakoreshejwe ubufindo.<verse eid="1CH 6:65" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="66" style="v" sid="1CH 6:66" />Bamwe bo mu Bakohati bahawe ibisagara vyabo mu muryango wa Efurayimu.<verse eid="1CH 6:66" /></para>
  <para style="li1">
    <verse number="67" style="v" sid="1CH 6:67" />Mu misozi y’Abefurayimu bahawe Shekemu nk’igisagara c’ubuhungiro, na Gezeri, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />Yokimeyamu, Beti-Horoni, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />Ayaloni n’i Gati-Rimoni, hamwe n’uburagiro bwaho.<verse eid="1CH 6:69" /></para>
  <para style="li1">
    <verse number="70" style="v" sid="1CH 6:70" />Kandi mu gice kimwe c’Abamanase, Abisirayeli batanze Aneri na Bileyami, hamwe n’uburagiro bwaho, ku miryango yasigaye y’Abakohati.<verse eid="1CH 6:70" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="71" style="v" sid="1CH 6:71" />Abagerishomu baronse aha hakurikira:</para>
  <para style="li1" vid="1CH 6:71">Mu gice c’umuryango w’Abamanase</para>
  <para style="li2" vid="1CH 6:71">baronse ibisagara Golani h’i Bashani n’i Ashitaroti, hamwe n’uburagiro bwaho;<verse eid="1CH 6:71" /></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72" />Mu muryango wa Isakari baronse Kedeshi, Daberati, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />Ramoti na Anemi, hamwe n’uburagiro bwaho;<verse eid="1CH 6:73" /></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74" />Mu muryango wa Asheri baronse Mashali, Abudoni, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />Hukoki n’i Rehobu, hamwe n’uburagiro bwaho.<verse eid="1CH 6:75" /></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76" />No mu muryango wa Nafutali baronse Kedeshi i Galilaya, Hamoni na Kiriyatayimu, hamwe n’uburagiro bwaho.<verse eid="1CH 6:76" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="77" style="v" sid="1CH 6:77" />Abandi bakomoka kuri Merari basigaye mu Balewi, baronse aha hakurikira:</para>
  <para style="li1" vid="1CH 6:77">Mu muryango wa Zebuloni baronse Yokineyami, Karita, Rimoni na Tabori, hamwe n’uburagiro bwaho;<verse eid="1CH 6:77" /></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78" />mu muryango wa Reyubeni hakurya ya Yorodani mu buseruko bwa Yeriko baronse Bezeri mu bugaragwa, Yahiza, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />Kedemoti na Mefayati, hamwe n’uburagiro bwaho;<verse eid="1CH 6:79" /></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80" />no mu muryango wa Gadi baronse Ramoti h’i Gileyadi, Mahanayimu, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />Heshiboni na Yazeri, hamwe n’uburagiro bwaho.<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s1">Abakomoka kuri Isakari</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1" />Bene Isakari ni:</para>
  <para style="li2" vid="1CH 7:1">Tola, Puwa, Yashubi na Shimuroni, bose bari bane.<verse eid="1CH 7:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2" />Bene Tola ni:</para>
  <para style="li2" vid="1CH 7:2">Uzi, Refaya, Yeriyeli, Yahimayi, Ibusami, na Samweli, abakuru b’inzu zabo. Ku ngoma ya Dawidi, abakomoka kuri Tola bari mu runganwe rw’abagwanyi b’abahizi bari ibihumbi mirongo ibiri na bibiri n’amajana atandatu.<verse eid="1CH 7:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3" />Abakomoka kuri Uzi ni:</para>
  <para style="li2" vid="1CH 7:3">Izirahiya.</para>
  <para style="li1" vid="1CH 7:3">Abakomoka kuri Izirahiya ni:</para>
  <para style="li2" vid="1CH 7:3">Mikayeli, Obadiya, Yoweli na Ishiya. Uko ari batanu bari abakuru b’amazu. <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />Ukurikije urutonde rw’ingene bagiye bararondoka, bari bafise abantu ibihumbi mirongo itatu na bitandatu biteguriye kuja ku rugamba, kubera bari bafise abagore n’abahungu benshi.<verse eid="1CH 7:4" /></para>
  <para style="lf">
    <verse number="5" style="v" sid="1CH 7:5" />Abo mu nzu zigize umuryango wa Isakari bari mu runganwe rw’abagwanyi b’abahizi, bose hamwe bari ibihumbi mirongo umunani n’indwi.<verse eid="1CH 7:5" /></para>
  <para style="s1">Benyamini</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6" />Bene Benyamini batatu ni:</para>
  <para style="li2" vid="1CH 7:6">Bela, Bekeri na Yediyayeli.<verse eid="1CH 7:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7" />Bene Bela ni:</para>
  <para style="li2" vid="1CH 7:7">Eziboni, Uzi, Uziyeli, Yerimoti na Iri, abakuru b’imiryango: bose bari batanu. Urutonde rw’abari mu runganwe rwo gushobora kuja mu rugamba bari ibihumbi mirongo ibiri na bibiri na mirongo itatu na bane.<verse eid="1CH 7:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8" />Bene Bekeri ni:</para>
  <para style="li2" vid="1CH 7:8">Zemira, Yowashi, Eliyezeri, Eliyowenayi, Omuri, Yeremoti, Abiya, Anatoti na Alemeti. Abo bose bari bene Bekeri. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />Urutonde rwabo, hakurikijwe ingene urunganwe rwagenda rurakurikirana n’urundi, rwerekana abakuru b’amazu agize uwo muryango, abagwanyi b’inkomezi, ibihumbi mirongo ibiri n’amajana abiri.<verse eid="1CH 7:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10" />Mwene Yediyayeli ni:</para>
  <para style="li2" vid="1CH 7:10">Biluhani.</para>
  <para style="li1" vid="1CH 7:10">Bene Bilihani ni:</para>
  <para style="li2" vid="1CH 7:10">Yewushi, Benyamini, Ehudi, Kenayana, Zetani, Tarushishi na Ahishahari. <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />Abahungu bose bene Yediyayeli bari abakuru b’amazu agize uwo muryango wabo. Hari ibihumbi cumi n’indwi n’amajana abiri vy’ingabo biteguriye kuja ku rugamba.<verse eid="1CH 7:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12" />Shupimu na Hupimu bakomoka kuri Iri, Hushimu na we agakomoka kuri Aheri.<verse eid="1CH 7:12" /></para>
  <para style="s1">Nafutali</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13" />Bene Nafutali ni:</para>
  <para style="li2" vid="1CH 7:13">Yahuziyeli, Guni, Yezeri na Shalumu, bakomoka kuri Biluha.<verse eid="1CH 7:13" /></para>
  <para style="s1">Manase</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14" />Abakomotse kuri Manase ni:</para>
  <para style="li2" vid="1CH 7:14">Asiriyeli akomoka kuri we yamuvyaranye n’incoreke yiwe y’Umwaramukazi. Ni we yavyaye Makiri se wa Gileyadi. <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />Makiri aronderera umugore Hupimu na Shupimu. Mushikiwe yitwa Mayaka. Uwundi akomoka kuri we ni Zelofehadi, yavyaye abakobwa gusa. <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" />Mayaka Muka Makiri yavyaye umuhungu amwita Pereshi. Umuvukanyi wiwe yitwa Shereshi, kandi abahungu biwe bari Ulamu na Rakemu.<verse eid="1CH 7:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17" />Mwene Ulamu ni:</para>
  <para style="li2" vid="1CH 7:17">Bedani.</para>
  <para style="li1" vid="1CH 7:17">Abo ni bo bari bene Gileyadi mwene Makiri, mwene Manase.<verse eid="1CH 7:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 7:18" />Mushikiwe Hamoleketi yavyaye Ishihodi, Abiyezeri na Mahila.<verse eid="1CH 7:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19" />Bene Shemida bari:</para>
  <para style="li2" vid="1CH 7:19">Ahiyani, Shekemu, Likihi na Aniyamu.<verse eid="1CH 7:19" /></para>
  <para style="s1">Efurayimu</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20" />abakomoka kuri Efurayimu ni:</para>
  <para style="li2" vid="1CH 7:20">Shutela, umuhungu wiwe Beredi</para>
  <para style="li2" vid="1CH 7:20">umuhungu wiwe Tahati, umuhungu wiwe Eleyada,</para>
  <para style="li2" vid="1CH 7:20">umuhungu wiwe Tahati, <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />umuhungu wiwe Zabadi,</para>
  <para style="li2" vid="1CH 7:21">n’umuhungu wiwe Shutela.</para>
  <para style="li2" vid="1CH 7:21">Ezeri na Eladi bishwe n’imvukira z’i Gati, igihe bamanuka ngo bazinyage imikuku yazo. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />Sewabo Efurayimu yabagandariye imisi myinshi, maze incuti ziwe ziraza ziramuremesha. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />Maze yongera kuryamana n’umugore wiwe, aca asama inda, avyara umwana w’umuhungu. Se aca amwita Beriya, kuko mu nzu yiwe hari harateye ivyago. <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />Umukobwa wiwe yari Shera, ari we yubatse Beti-Horoni y’epfo n’iya ruguru hamwe na Uzeni-Shera.<verse eid="1CH 7:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25" />Ni we yavyara Refa, na we akavyara Reshefu,</para>
  <para style="li2" vid="1CH 7:25">na we akavyara Tela, na we akavyara Tahani,<verse eid="1CH 7:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26" />na we akavyara Ladani, na we akavyara Amihudi,</para>
  <para style="li2" vid="1CH 7:26">na we akavyara Elishama, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />na we akavyara Nuni,</para>
  <para style="li2" vid="1CH 7:27">ari we se wa Yosuwa.<verse eid="1CH 7:27" /></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 7:28" />Amatongo yabo n’ibisagara vyabo vyarimwo Beteli n’ibigwati bihakikije, Nayarani mu buseruko, Gezeri n’ibigwati vyaho mu burengero, na Shekemu n’ibigwati vyaho kubandanya gushika i Ayiya n’ibigwati vyaho. <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />Abakomoka kuri Manase bagarukira i Beti-Shani, Tanaki, Megido na Dori, hamwe n’ibisagara vyaho. Abakomoka kuri Yosefu mwene Isirayeli baba muri ivyo bisagara.<verse eid="1CH 7:29" /></para>
  <para style="s1">Asheri</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30" />Bene Asheri ni:</para>
  <para style="li2" vid="1CH 7:30">Imuna, Ishuva, Ishuvi na Beriya. Mushiki wabo yari Sera.<verse eid="1CH 7:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31" />Bene Beriya ni:</para>
  <para style="li2" vid="1CH 7:31">Heberi na Malukiyeli, yari se wa Biruzayiti.<verse eid="1CH 7:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32" />Heberi yari se wa Yafuleti, Shomeri na Hotamu na mushiki wabo Shuwa.<verse eid="1CH 7:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33" />Bene Yafuleti ni:</para>
  <para style="li2" vid="1CH 7:33">Pasaki, Bimuhali na Ashuvati.</para>
  <para style="lf" vid="1CH 7:33">Abo ni bo bari bene Yafuleti.<verse eid="1CH 7:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34" />Bene Shemeri ni:</para>
  <para style="li2" vid="1CH 7:34">Ahi, Rohiga, Huba na Aramu.<verse eid="1CH 7:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35" />Abahungu b’umuvukanyi wiwe Helemu ni:</para>
  <para style="li2" vid="1CH 7:35">Zofa, Imuna, Sheleshi na Amali.<verse eid="1CH 7:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36" />Bene Zofa ni:</para>
  <para style="li2" vid="1CH 7:36">Suwa, Haruneferi, Shuwali, Beri, Imura, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />Bezeri, Hodi, Shama, Shilusha, Itirani na Bera.<verse eid="1CH 7:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38" />Bene Yeteri ni:</para>
  <para style="li2" vid="1CH 7:38">Yefune, Pisipa na Ara.<verse eid="1CH 7:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39" />Bene Ula ni:</para>
  <para style="li2" vid="1CH 7:39">Ara, Haniyeli na Riziya.<verse eid="1CH 7:39" /></para>
  <para style="lf">
    <verse number="40" style="v" sid="1CH 7:40" />Abo bose bakomoka kuri Asheri, bari abakuru b’inzu, abantu b’indobanurwa, abagwanyi b’abahizi kandi bakaba n’abarongozi b’intwari. Igitigiri c’abari mu runganwe rwo gushobora kuja mu rugamba, nk’uko vyari ku rutonde rw’ingene abantu bagiye bararondoka, bari ibihumbi mirongo ibiri na bitandatu.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s1">Ba sekuruza ba Sawuli Umubenyamini</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1" />Benyamini yari afise imfura yitwa Bela,</para>
  <para style="li2" vid="1CH 8:1">umuhungu wiwe wa kabiri akitwa Ashibeli, uwa gatatu na we akitwa Ahara,<verse eid="1CH 8:1" /></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2" />uwa kane ni Noha, uwa gatanu ni Rafa.<verse eid="1CH 8:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3" />Bene Bela bari:</para>
  <para style="li2" vid="1CH 8:3">Adari, Gera, Abihudi, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />Abishuwa, Namani, Ahowa, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />Gera, Shefufani na Huramu.<verse eid="1CH 8:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6" />Aba ni bo bakomoka kuri Ehudi, bari abakuru b’amazu y’ababa i Geba bajanywe ari inyagano i Manahati:<verse eid="1CH 8:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7" />Abahungu ba Ehudi bari Namani, Ahiya, na Gera. Uwo Gera ni we yabajane ari inyagano, kandi ni we yari se wa Uza na Ahihudi.<verse eid="1CH 8:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8" />Hari abahungu Shaharayimu yavyariye i Mowabu amaze kwirukana abagore biwe Hushimi na Bayara. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />Ku mugore wiwe Hodeshi yavyaye Yobabu, Zibiya, Mesha, Malukamu, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />Yewuzi, Sakiya na Miruma. Abo bari abahungu biwe, bakaba abakuru b’amazu. <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />Kuri Hushimi yavyaye Abitubi na Elupayali.<verse eid="1CH 8:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12" />Bene Elupayali ni:</para>
  <para style="li2" vid="1CH 8:12">Eberi, Mishamu, Shemedi (ari we yubatse i Ono n’i Lodi n’ibigwati bihakikije), <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />na Beriya na Shema, bari abakuru b’amazu y’ababa i Ayaloni basohoye ababa i Gati.<verse eid="1CH 8:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14" />Ahiyo, Shashaki, Yeremoti, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />Zebadiya, Aradi, Ederi, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />Mikayeli, Ishipa na Yoha bari bene Beriya.<verse eid="1CH 8:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17" />Zebadiya, Meshulamu, Hizuki, Heberi, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />Ishimerayi, Iziliya na Yobabu bari bene Elupayali.<verse eid="1CH 8:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19" />Yakimu, Zikuri, Zabudi, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />Eliyenayi, Ziletayi, Eliyeli, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />Adaya, Beraya na Shimurati bari bene Shimeyi.<verse eid="1CH 8:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22" />Ishupani, Eberi, Eliyeli, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />Abudoni, Zikuri, Hanani, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />Hananiya, Elamu, Antotiya, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />Ifideya na Penuweli bari bene Shashaki.<verse eid="1CH 8:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26" />Shamusherayi, Shehariya, Ataliya, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />Yayareshiya, Eliya, na Zikuri bari bene Yerohamu.<verse eid="1CH 8:27" /></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 8:28" />Abo bose bari abakuru b’amazu, baganza nk’uko vyanditswe mu rutonde rwerekana ingene abantu bagenda bararondoka, kandi baba i Yerusalemu.<verse eid="1CH 8:28" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29" />Se wa Gibeyoni yaba i Gibeyoni.</para>
  <para style="li2" vid="1CH 8:29">Umugore wiwe yitwa Mayaka, <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />kandi imfura yiwe yari Abudoni, agakurikirwa na Zuri, Kishi, Bayali, Neri, Nadabu, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />Gedori, Ahiyo, Zekeri <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />na Mikuloti, yari se wa Shimeya. Na bo nyene babana n’abo mu miryango y’iwabo i Yerusalemu.<verse eid="1CH 8:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33" />Neri yari se wa Kishi, Kishi se wa Sawuli, Sawuli se wa Yonatani, Maluki-Shuwa, Abinadabu na Eshibayali.<verse eid="1CH 8:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34" />Mwene Yonatani, ni</para>
  <para style="li2" vid="1CH 8:34">Meribu-Bayali, na we akaba yavyaye Mika.<verse eid="1CH 8:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35" />Bene Mika, ni</para>
  <para style="li2" vid="1CH 8:35">Pitoni, Meleki, Tareya na Ahazi.<verse eid="1CH 8:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36" />Ahazi yari se wa Yehoyada, Yehoyada yari se wa Alemeti, Azimaveti na Zimuri, Zimuri na we akaba se wa Moza. <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />Moza yari se wa Bineya, Bineya ni se wa Rafa, Rafa se wa Eleyasa, Eleyasa se wa Azeli.<verse eid="1CH 8:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38" />Azeli yari afise abahungu batandatu, kandi aya ni yo mazina yabo:</para>
  <para style="li2" vid="1CH 8:38">Azurikamu, Bokeru, Ishimayeli, Sheyariya, Obadiya na Hanani. Abo bose bari bene Azeli.<verse eid="1CH 8:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39" />Abahungu b’umuvukanyi wiwe Esheki bari:</para>
  <para style="li2" vid="1CH 8:39">Ulamu imfura yiwe, Yewushi uwa kabiri, na Elifeleti uwa gatatu. <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />Bene Ulamu bari abahizi mu ntambara bashobora kurasisha umuheto. Bari bafise abahungu benshi, n’abuzukuru benshi bashika ijana na mirongo itanu bose.</para>
  <para style="li1" vid="1CH 8:40">Abo bose bakomoka kuri Benyamini.<verse eid="1CH 8:40" /></para>
  <para style="b" />
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />Abisirayeli bose bashizwe ku ntonde z’imiryango bakomokamwo mu gitabu c’abami b’Abisirayeli. Abayuda bajanywe nk’inyagano i Babiloni kubera batabaye abizigirwa ku Imana.<verse eid="1CH 9:1" /></para>
  <para style="s1">Abantu b’i Yerusalemu</para>
  <para style="lh">
    <verse number="2" style="v" sid="1CH 9:2" />Maze abantu ba mbere mu bavuye mu kinyago batanguye gusubira mu bisagara vyabo no mu matongo yabo bari Abisirayeli bamwebamwe, abaherezi, Abalewi n’abakozi bo mu Ngoro.<verse eid="1CH 9:2" /></para>
  <para style="lh">
    <verse number="3" style="v" sid="1CH 9:3" />Abakomoka kuri Yuda, kuri Benyamini, kuri Efurayimu no kuri Manase baba i Yerusalemu bari:<verse eid="1CH 9:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4" />Utayi mwene Amihudi, umuhungu wa Omuri, umuhungu wa Imuri, umuhungu wa Bani, akomoka kuri Perezi mwene Yuda.<verse eid="1CH 9:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5" />Mu Bashiloni abatashe ni:</para>
  <para style="li2" vid="1CH 9:5">Asaya imfura n’abahungu biwe.<verse eid="1CH 9:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6" />Mu bo mu nzu kwa Zera ni:</para>
  <para style="li2" vid="1CH 9:6">Yeyuweli.</para>
  <para style="lf" vid="1CH 9:6">Abakomoka kuri Yuda bari amajana atandatu na mirongo icenda.<verse eid="1CH 9:6" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="7" style="v" sid="1CH 9:7" />Mu bakomoka kuri Benyamini ni:</para>
  <para style="li1" vid="1CH 9:7">Salu mwene Meshulamu, mwene Hodaviya, mwene Hasenuwa;<verse eid="1CH 9:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8" />Ibuneya mwene Yerohamu;</para>
  <para style="li1" vid="1CH 9:8">Ela mwene Uzi, mwene Mikiri;</para>
  <para style="li1" vid="1CH 9:8">na Meshulamu mwene Shefatiya, mwene Reyuweli, mwene Ibuniya.<verse eid="1CH 9:8" /></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 9:9" />Abantu bo mu Babenyamini, nk’uko bashizwe ku rutonde rwerekana ingene bagiye bararondoka, bashika amajana icenda na mirongo itanu na batandatu. Abo bose bari abakuru b’amazu yabo.<verse eid="1CH 9:9" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="10" style="v" sid="1CH 9:10" />Mu baherezi abatashe ni:</para>
  <para style="li1" vid="1CH 9:10">Yedayiya; Yehoyaribu, Yakini;<verse eid="1CH 9:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 9:11" />Azariya mwene Hilukiya, mwene Meshulamu, mwene Sadoki, mwene Merayoti, mwene Ahitubu, abakuru bari bashinzwe inzu y’Imana;<verse eid="1CH 9:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12" />Adaya mwene Yerohamu, mwene Pashuri, mwene Malikiya,</para>
  <para style="li1" vid="1CH 9:12">na Mayasayi mwene Adiyeli, mwene Yahizera, mwene Meshulamu, mwene Meshilemiti, mwene Imeri.<verse eid="1CH 9:12" /></para>
  <para style="lf">
    <verse number="13" style="v" sid="1CH 9:13" />Abaherezi, bari abakuru b’amazu, bashika igihumbi n’amajana indwi na mirongo itandatu. Bari abagabo bashoboye, bashinzwe gukora igikorwa c’Imana mw’ihema.<verse eid="1CH 9:13" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="14" style="v" sid="1CH 9:14" />Mu Balewi:</para>
  <para style="li1" vid="1CH 9:14">Shemaya mwene Hashubi, mwene Azirikamu, mwene Hashabiya, Umumerari;<verse eid="1CH 9:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 9:15" />Bakibakari, Hereshi, Galali na Mataniya mwene Mika, mwene Zikuri, mwene Asafu;<verse eid="1CH 9:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 9:16" />Obadiya mwene Shemaya, mwene Galali, mwene Yedutuni;</para>
  <para style="li1" vid="1CH 9:16">na Berekiya mwene Asa, mwene Elukana, yaba mu bigwati vy’Abanetofati.<verse eid="1CH 9:16" /></para>
  <para style="lh">
    <verse number="17" style="v" sid="1CH 9:17" />Abarinzi b’amarembo bari:</para>
  <para style="li1" vid="1CH 9:17">Shalumu, Akubu, Talumoni, Ahimani n’abo bavukana, Shalumu uwabatwara <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />yaba kw’Irembo ry’Umwami mu buseruko, gushika n’ubu. Abo ni bo bari abarinzi b’irembo bo mu Balewi.<verse eid="1CH 9:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 9:19" />Shalumu mwene Kore, mwene Ebiyasafu, mwene Kora, na bagenzibe b’abarinzi b’irembo bo mu muryango wiwe ari bo Bakorahi bari bajejwe kurinda umuryango w’ihema nk’uko ba se babikora kw’ihema ry’<char style="nd">Uhoraho</char>.<verse eid="1CH 9:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 9:20" />Mu bihe vya kera Finehasi mwene Eliyazeri ni we yari umukuru w’abarinzi b’irembo, kandi <char style="nd">Uhoraho</char> yari kumwe na we.<verse eid="1CH 9:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 9:21" />Zakariya mwene Meshelemiya yari umurinzi w’umuryango w’Ihema ry’Ibonaniro.<verse eid="1CH 9:21" /></para>
  <para style="lf">
    <verse number="22" style="v" sid="1CH 9:22" />Bose hamwe, abari batowe ngo babe abarinzi b’amarembo bari amajana abiri na cumi na babiri. Bari banditswe mu bitabu vy’urukurikirane rw’ingene bagiye bararondoka mu mihana yabo.</para>
  <para style="b" vid="1CH 9:22" />
  <para style="p" vid="1CH 9:22">Abo barinzi b’amarembo bari bahawe ico gikorwa na Dawidi hamwe na Samweli uwerekwa kuko bari abantu bo kwizigirwa. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />Abo hamwe n’uruvyaro rwabo bari bashinzwe kurinda amarembo y’inzu y’<char style="nd">Uhoraho</char>, ari ryo hema. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />Abarinzi b’irembo bari mu bibanza bine: mu buseruko, mu burengero, mu buraruko, no mu bumanuko. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />Benewabo b’Abalewi bo mu bigwati vyabo baraza bakabasanga muri ivyo bikorwa mu kiringo c’imisi indwi. <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />Ariko abarinzi b’irembo bakurubakuru bane, bose bo mu Balewi, bari bizigiwe bazezwa igikorwa co kurinda ivyumba n’ubutunzi vyo mu Ngoro y’Imana. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />Barashobora kumara ijoro ryose bacungereye iyo nzu y’Imana, kuko bategerezwa kuyirinda; kandi akaba ari bo bari bajejwe urupfunguruzo rwayo kugira ngo bame bayugurura uko bukeye.<verse eid="1CH 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />Bamwe muri bo bari bajejwe ibikoresho vyo mw’ihema; bakama babiharura iyo vyinjiye canke iyo bisohotse. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />Abandi bari bashinzwe gutunganya ibikoresho n’ivyera vyose vy’ahera, n’ifu n’umuvinyu, hamwe n’amavuta, ibiturirwa bikamota n’ibirungo. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />Ariko abaherezi bamwe bari bajejwe kuvanga ibirungo. <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />Umulewi yitwa Matitiya, imfura ya Shalumu Umukorahi, yari ajejwe kwotsa imikate yo gutanga kw’amashikanwa. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />Bamwe mu bavukanyi b’Abakohati bari bajejwe gutegura imikate yo gushirwa ku meza uko Isabato ishitse.<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />Abari bajejwe gucuraranga, abakuru b’amazu yo mu muryango w’Abalewi, baba mu vyumba vy’Ingoro kandi ntibahabwa ibindi bikorwa kuko bari bajejwe ico gikorwa ku murango no mw’ijoro.<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34" />Abo bose bari abakuru b’amazu yo mu muryango w’Abalewi, abatwara abandi nk’uko vyanditswe mu bitabu vy’urutonde rw’ingene bagiye bararondoka, kandi baba i Yerusalemu.<verse eid="1CH 9:34" /></para>
  <para style="s1">Ba sekuruza ba Sawuli</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35" />Yeyiyeli se wa Gibeyoni yaba i Gibeyoni.</para>
  <para style="li2" vid="1CH 9:35">Umugore wiwe yitwa Mayaka, <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />kandi imfura yiwe yari Abudoni, agakurikirwa na Zuri, Kishi, Bayali, Neri, Nadabu, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />Gedori, Ahiyo, Zakariya na Mikuloti. <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />Mikuloti yari se wa Shimeyami. Na bo nyene babana n’abo mu miryango y’iwabo i Yerusalemu.<verse eid="1CH 9:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39" />Neri yari se wa Kishi, Kishi se wa Sawuli, Sawuli se wa Yonatani, Maluki-Shuwa, Abinadabu na Eshibayali.<verse eid="1CH 9:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40" />Mwene Yonatani, ni</para>
  <para style="li2" vid="1CH 9:40">Meribu-Bayali, na we akaba yavyaye Mika.<verse eid="1CH 9:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41" />Bene Mika, ni</para>
  <para style="li2" vid="1CH 9:41">Pitoni, Meleki, Tahireya na Ahazi.<verse eid="1CH 9:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42" />Ahazi yari se wa Yada, Yada yari se wa Alemeti, Azimaveti na Zimuri; Zimuri na we akaba se wa Moza. <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />Moza yari se wa Bineya, Bineya ni se wa Refaya, Refaya se wa Eleyasa, Eleyasa se wa Azeli.<verse eid="1CH 9:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44" />Azeli yari afise abahungu batandatu, kandi aya ni yo mazina yabo:</para>
  <para style="li2" vid="1CH 9:44">Azurikamu, Bokeru, Ishimayeli, Sheyariya, Obadiya na Hanani. Abo bose bari bene Azeli.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s1">Sawuli yiyahura</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />Maze Abafilisitiya bagwanya Abisirayeli; Abisirayeli barata barahunga, kandi benshi muri bo bicirwa ku musozi Gilibowa. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />Abafilisitiya babirukako basugereza Sawuli n’abahungu biwe, bica abahungu biwe Yonatani, Abinadabu na Maluki-Shuwa. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />Maze Sawuli urugamba rumumerera nabi cane, abanyamiheto baramurasa baramukomeretsa.<verse eid="1CH 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4" />Sawuli abwira uwari amutwaje ibigwanisho ati: “Sokora inkota yawe unsogote, kugira ngo izo ntakebwa ntizimfate ngo zinyice nabi.”</para>
  <para style="p" vid="1CH 10:4">Ariko uwamutwaza ibigwanisho aranka kuko yari afise ubwoba bwinshi. Nuko Sawuli afata inkota yiwe ayisukako. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />Umwe yamutwaza ibigwanisho abonye ko Sawuli apfuye, na we nyene yisuka ku nkota yiwe arapfa. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />Nuko Sawuli n’abahungu biwe batatu barapfa, n’abo mu nzu yiwe bose bagwa hamwe.<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />Abisirayeli bose bari mu kiyaya babonye ko ingabo zahunze kandi ko Sawuli n’abahungu biwe bapfuye, baca bata ibisagara vyabo barahunga. Maze Abafilisitiya baraza babibamwo.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />Bukeye, Abafilisitiya baja aho urugamba rwabereye kwambura abapfuye ibigwanisho n’ibintu vyabo vy’agaciro, basanga Sawuli n’abahungu biwe baguye ku musozi Gilibowa. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />Bamuca umutwe, bamwambura n’ibigwanisho vyiwe, baca barungika intumwa mu gihugu cose c’Abafilisitiya ngo bakwize iyo nkuru mu ngoro z’ibigirwamana vyabo no mu bantu. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />Baca bashira ibigwanisho vyiwe mu ngoro y’ibigirwamana vyabo, umutwe wiwe bawumanika mu ngoro y’ikigirwamana Dagoni.<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />Maze ab’i Yabeshi Gileyadi bose bumvise ivyo Abafilisitiya bakoreye Sawuli vyose, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />abagabo bose b’abahizi baragenda batora imivyimba ya Sawuli n’abahungu biwe bayijana i Yabeshi. Bahamba amagufa yabo musi y’igiti kinini i Yabeshi, baca bisonzesha kumara imisi indwi.<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />Nuko Sawuli apfa azize kutaba umwizigirwa k’<char style="nd">Uhoraho</char>, kutazigama ijambo yabwiwe n’<char style="nd">Uhoraho</char> no gusiguza uwuhamagara imizimu, <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />aho gusiguza <char style="nd">Uhoraho</char>. Nuko <char style="nd">Uhoraho</char> aramwica aca agabira ingoma yiwe Dawidi mwene Isayi.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s1">Dawidi aba umwami w’Abisirayeli</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />Abisirayeli bose bakoranira i Heburoni aho Dawidi yari ari bamubwira bati: “Twebwe turi umubiri wawe n’amaraso yawe. <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />Kandi kera, mbere n’igihe Sawuli yari umwami, ni wewe warongora Abisirayeli mu ntambara. Kandi <char style="nd">Uhoraho</char> Imana yawe yarakubwiye ati: ‘Uzoba umwungere w’abantu banje b’Abisirayeli, kandi uzoba umutware wabo.’ ”<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />Abakuru bose b’Abisirayeli baja kuraba umwami Dawidi i Heburoni, aca agirana na bo isezerano aho nyene i Heburoni imbere y’<char style="nd">Uhoraho</char>, baca bamurobanuza amavuta baramwimika ngo abe umwami w’Abisirayeli, nk’uko <char style="nd">Uhoraho</char> yari yarabisezeranye abicishije kuri Samweli.<verse eid="1CH 11:3" /></para>
  <para style="s1">Dawidi afata i Yerusalemu</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />Dawidi n’Abisirayeli bose baja i Yerusalemu ari ho hitwa Yebusi. Abayebusi baba ngaho <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />babwira Dawidi bati: “Ntuzoshobora kwinjira ngaha.” Ariko Dawidi yigarurira igice c’ahitwa Siyoni hazitijwe impome zikomeye, ari ho haciye hitwa Igisagara ca Dawidi.<verse eid="1CH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6" />Dawidi yari yavuze ati: “Umuntu wese azoba uwa mbere mu gutera Abayebusi akahafata azoca aba umukuru w’ingabo.” Yowabu mwene Zeruwiya aduga ubwa mbere, aca ahabwa kuba umukuru w’ingabo.<verse eid="1CH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7" />Dawidi aca ashira ikirimba ciwe aho hantu hazitiye kuri uwo musozi, haca hitwa Igisagara ca Dawidi. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />Yubaka igisagara hirya no hino y’ikirimba, uhereye ku musezero w’ahitwa Milo ugashika ku ruzitiro. Ico gihe Yowabu yariko arasanura ahandi hose hasigaye h’ico gisagara. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />Maze Dawidi arushaho kuba uwuhambaye, kuko <char style="nd">Uhoraho</char> Mushoboravyose yari kumwe na we.<verse eid="1CH 11:9" /></para>
  <para style="s1">Abahizi ba Dawidi</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />Aba ni bo bari abakuru mu bahizi ba Dawidi; abo hamwe n’Abisirayeli bose, baterereye mu gushigikira ingoma yiwe kugira ngo ikwire mu gihugu cose, nk’uko <char style="nd">Uhoraho</char> yari yarabisezeranye. <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />Uru ni rwo rutonde rw’abahizi ba Dawidi:</para>
  <para style="p" vid="1CH 11:11">Yashobeyamu, wo mu muryango wa Hakumoni, yari umukuru yaganza abacungera ubuzima bw’umwami. Ni we yicishije icumu ryiwe abantu amajana atatu mu mwanya umwe.<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />Yakurikirwa na Eliyazeri mwene Dodayi Umwahohi, yari umwe muri bamwe batatu b’abahizi mu ntambara. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />Yari kumwe na Dawidi i Pasi-Damimu mu ntambara y’Abafilisitiya. Urugamba rwabereye mu murima w’ingano, hanyuma ingabo z’Abisirayeli zihunga Abafilisitiya; <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />ariko Eleyazari na Dawidi bobo bahagarara hagati muri uwo murima barawugwanira, bica Abafilisitiya, <char style="nd">Uhoraho</char> abaha intsinzi ikomeye.<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />Batatu bo muri abo bahizi mirongo itatu baramanuka basanga Dawidi aho yari ari mw’isenga ry’ibuye i Adulamu. Ico gihe umugwi w’Abafilisitiya wari ucumbitse mu kiyaya c’i Refayimu. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />Dawidi yari mu kinyegero, kandi umuce w’ingabo z’Abafilisitiya wari i Betelehemu. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />Dawidi yumva agomba amazi, maze aca avuga ati: “Ese icompa hakagira uwunzanira amazi yo kunywa yo kw’iriba riri kw’irembo ry’i Betelehemu!” <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />Nuko bamwe batatu baragenda, baca hagati mu ngabo z’Abafilisitiya, bavoma ayo mazi kw’iriba ryari hafi y’irembo ry’i Betelehemu bayashira Dawidi. Ariko Dawidi yanka kuyanywa; ayasesa hasi imbere y’<char style="nd">Uhoraho</char>. <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />Avuga ati: “Imana indinde gukora ikintu nk’ico! Mbega noshobora kunywa amaraso y’aba bantu bahevye amagara yabo?” Kuko bari bahevye amagara yabo mu kuja kumuzanira ayo mazi, bituma yanka kuyanywa.</para>
  <para style="p" vid="1CH 11:19">Ivyo vyagaragaje ubutwari bw’abo batatu b’abahizi mu ntambara.<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />Abishayi mwene nyina wa Yowabu yari umukuru wa bamwe batatu. Yishe abantu amajana atatu akoresheje icumu ryiwe, bituma aba rurangiranwa nka bamwe batatu. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />Yahawe icubahiro kiruta ica bamwe mirongo itatu maze aca aba umukuru wabo, n’aho atari umwe muri bamwe batatu.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />Benaya mwene Yehoyada yari umugwanyi w’umuhizi yava i Kabuzeyeli, kandi yakoze ibihambaye. Yishe abahizi babiri baruta abandi mu ngabo z’Abanyamowabu. Umusi umwe shelegi iriko iragwa, amanuka mu rwobo, yica intambwe. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />Ni we yishe Umunyegiputa yari afise ingero z’igice c’ukuboko zitanu<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">Ni nk’imetero 2,3.</char></note> z’igihagararo. Naho uwo Munyegiputa yari afise mu minwe icumu rikwikiye mu ruti rungana n’umuhini, Benaya yagiye kumugwanya afise inkoni, amushikura rya cumu mu minwe, aba ari ryo amwicisha. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />Ivyo ni vyo bikorwa vy’ubuhizi Benaya mwene Yehoyada yakoze; na we nyene yari rurangiranwa nka bamwe batatu. <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />Yari afise icubahiro kuruta bamwe mirongo itatu, ariko ntiyari uwo muri bamwe batatu. Maze Dawidi aca amugira umukuru w’abacungera umutekano wiwe.<verse eid="1CH 11:25" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="26" style="v" sid="1CH 11:26" />Abo bahizi bari</para>
  <para style="li1" vid="1CH 11:26">Asaheli murumuna wa Yowabu,</para>
  <para style="li1" vid="1CH 11:26">Eluhanani mwene Dodo w’i Betelehemu,<verse eid="1CH 11:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27" />Shamoti Umuharori,</para>
  <para style="li1" vid="1CH 11:27">Helezi Umupeloni,<verse eid="1CH 11:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28" />Ira mwene Ikeshi w’i Tekowa,</para>
  <para style="li1" vid="1CH 11:28">Abiyezeri w’i Anatoti,<verse eid="1CH 11:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29" />Sibekayi Umuhushati,</para>
  <para style="li1" vid="1CH 11:29">Ilayi Umwahohi,<verse eid="1CH 11:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30" />Maharayi w’i Netofati,</para>
  <para style="li1" vid="1CH 11:30">Heledi mwene Bayana w’i Netofati,<verse eid="1CH 11:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31" />Itayi mwene Ribayi w’i Gibeya mu Bubenyamini,</para>
  <para style="li1" vid="1CH 11:31">Benaya w’i Piratoni,<verse eid="1CH 11:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32" />Hurayi wo mu bihomoka vy’i Gayashi,</para>
  <para style="li1" vid="1CH 11:32">Abiyeli Umwarubati,<verse eid="1CH 11:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33" />Azumaveti Umubaharumi,</para>
  <para style="li1" vid="1CH 11:33">Eliyaba Umushaluboni,<verse eid="1CH 11:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34" />Bene Hashemi Umugizoni,</para>
  <para style="li1" vid="1CH 11:34">Yonatani mwene Shageye Umuharari,<verse eid="1CH 11:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35" />Ahiyamu mwene Sakari Umuharari,</para>
  <para style="li1" vid="1CH 11:35">Elifali mwene Uri,<verse eid="1CH 11:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36" />Heferi Umumekerati,</para>
  <para style="li1" vid="1CH 11:36">Ahiya Umupeloni,<verse eid="1CH 11:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37" />Heziro w’i Karumeli,</para>
  <para style="li1" vid="1CH 11:37">Nayari mwene Ezubayi,<verse eid="1CH 11:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38" />Yoweli yavukana na Natani,</para>
  <para style="li1" vid="1CH 11:38">Mibari mwene Haguri,<verse eid="1CH 11:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39" />Zeleki Umwamoni,</para>
  <para style="li1" vid="1CH 11:39">Naharayi Umuberoti, uwatwaza Yowabu mwene Zeruwiya ibigwanisho,<verse eid="1CH 11:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40" />Ira w’i Ituri,</para>
  <para style="li1" vid="1CH 11:40">Garebu w’i Ituri,<verse eid="1CH 11:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41" />Uriya Umuheti,</para>
  <para style="li1" vid="1CH 11:41">Zabadi mwene Ahilayi,<verse eid="1CH 11:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42" />Adina mwene Shiza Umureyubeni, yari umukuru w’Abareyubeni, na ba bandi mirongo itatu bari kumwe na we,<verse eid="1CH 11:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43" />Hanani mwene Mayaka,</para>
  <para style="li1" vid="1CH 11:43">Yoshafati w’i Mituni,<verse eid="1CH 11:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44" />Uziya w’i Ashuterati,</para>
  <para style="li1" vid="1CH 11:44">Shama na Yeyiyeli bene Hotamu w’i Aroweri,<verse eid="1CH 11:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45" />Yediyayeli mwene Shimuri,</para>
  <para style="li1" vid="1CH 11:45">umuvukanyi wiwe Yoha Umutizi,<verse eid="1CH 11:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46" />Eliyeli Umumahawi,</para>
  <para style="li1" vid="1CH 11:46">Yeribayi na Yoshaviya bene Elunayami,</para>
  <para style="li1" vid="1CH 11:46">Ituma Umunyamowabu,<verse eid="1CH 11:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47" />Eliyeli, Obedi na Yayasiyeli w’i Mezobayi.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s1">Abagwanyi bashigikiye Dawidi mu ntambara</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 12:1" />Aba ni bo bagiye kwifatanya na Dawidi ari i Zikulagi, igihe yari yahunze Sawuli mwene Kishi: ni bo bamufashije urugamba; <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />bari bafise imiheto kandi bari bazi kurasa imyampi canke guteresha amabuye umugozi bakoresheje ukuryo canke ukubamfu; bari Ababenyamini bo mu muryango wa Sawuli:<verse eid="1CH 12:2" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="3" style="v" sid="1CH 12:3" />Ahiyezeri umukuru wabo na Yowashi bene Shemaya Umunyagibeya;</para>
  <para style="li1" vid="1CH 12:3">Yaziyeli na Peleti bene Azumaveti;</para>
  <para style="li1" vid="1CH 12:3">Beraka, Yehu Umwanatoti, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />na Ishimaya Umunyagibeyoni, umugabo w’inkomezi yari muri bamwe murongo itatu, akaba n’umukuru wabo;</para>
  <para style="li1" vid="1CH 12:4">Yeremiya, Yahaziyeli, Yohanani, Yozabadi w’i Gedera, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />Eluzayi, Yerimoti, Beyaliya, Shemariya na Shefatiya Umuharufi;<verse eid="1CH 12:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 12:6" />Elukana, Isishiya, Azareli, Yowezeri na Yashobeyamu Abakorahi;<verse eid="1CH 12:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 12:7" />na Yowela na Zebadiya bene Yerohamu w’i Gedori.<verse eid="1CH 12:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />Bamwe mu bakomoka kuri Gadi bava kuri Sawuli baja kwifatanya na Dawidi aho yari yinyegeje mu bugaragwa. Bari abahizi b’inkomezi, biteguriye kugwana kandi bazi gukoresha inkinzo n’icumu. Mu maso habo hari hateye ubwoba nk’ah’intambwe, kandi banyaruka nk’ingeregere iyo ziruka ku misozi.<verse eid="1CH 12:8" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9" />Ezeri ni we yari umukuru wabo,</para>
  <para style="li1" vid="1CH 12:9">Obadiya akaba icegera ciwe, Eliyabu akaba uwa gatatu,<verse eid="1CH 12:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10" />Mishumana uwa kane, Yeremiya uwa gatanu,<verse eid="1CH 12:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11" />Atayi uwa gatandatu, Eliyeli uw’indwi,<verse eid="1CH 12:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12" />Yohanani uw’umunani, Elizabadi uw’icenda,<verse eid="1CH 12:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13" />Yeremiya uw’icumi, Makubanayi na we uw’icumi na rimwe.<verse eid="1CH 12:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />Abo Bagadi bari abakuru b’ingabo; uwa nyuma mu nkomezi yashobora kugwana n’abantu ijana, umunyenkomezi kurusha abandi na we yashobora kugwana n’abantu igihumbi. <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />Abo ni bo bajabutse Yorodani mu kwezi kwa mbere igihe rwari rwuzuye rwarenze inkombe, baca bakinagiza abantu bose baba mu biyaya vyaho babashwiragiriza mu buseruko no mu burengero bw’urwo ruzi.<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />Abandi Babenyamini na bamwe mu Bayuda na bo baraza bifatanya na Dawidi aho yari yinyegeje. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />Dawidi arasohoka ahura na bo maze arababwira ati: “nimwaba muzanywe n’amahoro, no kumfasha, nditeguye kwifatanya namwe. Ariko nimwaba muzanywe no kungurisha ku bansi banje kandi ata kibi kinyagira, Imana ya ba sogokuruza nibibone hanyuma ibacire urubanza.”<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />Maze Mpwemu aza kuri Amasayi, yarongora bamwe mirongo itatu, aravuga ati:</para>
  <para style="q1" vid="1CH 12:18">“Turi abawe, yewe Dawidi!</para>
  <para style="q2" vid="1CH 12:18">Turi kumwe nawe, yewe mwene Isayi!</para>
  <para style="q1" vid="1CH 12:18">Gira amahoro no kuroranirwa,</para>
  <para style="q2" vid="1CH 12:18">n’abagushigikiye bose batere baja imbere,</para>
  <para style="q3" vid="1CH 12:18">kuko Imana yawe igushigikiye.”</para>
  <para style="p" vid="1CH 12:18">Nuko Dawidi arabakira abagira abakuru b’abagwanyi biwe.<verse eid="1CH 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />Bamwe mu bakomoka kuri Manase bava mu ngabo za Isirayeli baja kwifatanya na Dawidi igihe yajana n’Abafilisitiya kugwanya Sawuli. We n’abantu biwe ntibafashije Abafilisitiya kuko abatware b’Abafilisitiya bamaze kugira inama, baciye bamusubiza inyuma. Bavuze bati: “Hamwe yokwihindukiza agasubiza hamwe na shebuja Sawuli, twohasiga agatwe.” <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />Igihe Dawidi yari asubiye i Zikulagi, ni ho abakomoka kuri Manase baja kwifatanya na we, ari bo: Adina, Yozabadi, Yediyayeli, Mikayeli, Yozabadi, Elihu na Ziletayi. Umwe wese yari arongoye umugwi w’ingabo igihumbi mu Bamanase. <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />Bafasha Dawidi kugwanya abansi biwe, kuko bari abagwanyi b’abahizi, kandi bari abakuru b’ingabo mu ngabo ziwe. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />Ku musi ku musi abantu baguma baza kwifatanya na Dawidi, gushika aho yagize ingabo nyinshi, nk’ingabo z’Imana.<verse eid="1CH 12:22" /></para>
  <para style="s1">Abandi bifatanije na Dawidi i Heburoni</para>
  <para style="lh">
    <verse number="23" style="v" sid="1CH 12:23" />Ibi ni vyo bitigiri vy’ingabo zambaye ibigwanisho ziteguriye kuja ku rugamba zaje kuri Dawidi i Heburoni kugira ngo zimuhe ubwami bwari ubwa Sawuli, nk’uko <char style="nd">Uhoraho</char> yari yaravuze:<verse eid="1CH 12:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24" />Abo mu muryango wa Yuda, haje ibihumbi bitandatu n’amajana umunani biteguriye kuja ku rugamba bitwaje amacumu n’inkinzo.<verse eid="1CH 12:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25" />Abo mu muryango wa Simeyoni, haje abagwanyi biteguriye kuja ku rugamba, ibihumbi indwi n’ijana;<verse eid="1CH 12:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26" />Abo mu muryango wa Lewi, haje ibihumbi bine n’amajana atandatu, <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />harimwo na Yehoyada, umukuru w’umuryango wa Aroni, yari afise abantu ibihumbi bitatu n’amajana indwi arongoye, <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />hamwe na Sadoki, umugwanyi w’umuhizi akiri muto, yazananye n’abakuru b’ingabo mirongo ibiri na babiri, bo mu muryango wiwe.<verse eid="1CH 12:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29" />Abo mu muryango wa Benyamini, ari wo muryango wa Sawuli, haje ibihumbi bitatu benshi muri bo bari bagumye bayoboka inzu ya Sawuli gushika ico gihe.<verse eid="1CH 12:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30" />Abo mu muryango wa Efurayimu, abagwanyi b’abahizi, ba rurangiranwa mu nzu zabo, haje ibihumbi mirongo ibiri n’amajana umunani.<verse eid="1CH 12:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31" />Abo mu gice c’umuryango wa Manase, co mu burengero bwa Yorodani batowe baravye amazina yabo ngo baje kwimika Dawidi, bose hamwe bari ibihumbi cumi n’umunani.<verse eid="1CH 12:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32" />Abo mu muryango wa Isakari, bari abantu bazi kugenzura ibihe kandi bagatahura ico Abisirayeli bategerezwa gukora, baje ari amajana abiri, hamwe n’abagenzi babo batwara.<verse eid="1CH 12:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33" />Abo mu muryango wa Zebuloni, abasoda bamenyereye ivy’intambara kandi biteguriye kuja ku rugamba no gukoresha ibigwanisho vy’uburyo bwose, ngo bafashe Dawidi n’umutima wabo wose, haje ibihumbi mirongo itanu.<verse eid="1CH 12:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34" />Abo mu muryango wa Nafutali, baje ari igihumbi, bari abakuru b’ingabo ibihumbi mirongo itatu n’indwi batwara inkinzo n’amacumu.<verse eid="1CH 12:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35" />Abo mu muryango wa Dani, biteguye kuja mu rugamba, baje ari ibihumbi mirongo ibiri n’umunani n’amajana atandatu.<verse eid="1CH 12:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36" />Abo mu muryango wa Asheri, abasoda bamenyereye ivy’intambara kandi biteguriye kuja ku rugamba, baje ari ibihumbi mirongo ine.<verse eid="1CH 12:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37" />Abaje bava hakurya ya Yorodani, ahaba abakomoka kuri Reyubeni, Gadi n’igice c’umuryango wa Manase, bari ibihumbi ijana na mirongo ibiri bambaye ibigwanisho vy’uburyo bwose.<verse eid="1CH 12:37" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="38" style="v" sid="1CH 12:38" />Abo bagwanyi bose baje bafise umutima umwe kandi ukunze kugira ngo bimike Dawidi abe umwami wa Isirayeli.</para>
  <para style="b" vid="1CH 12:38" />
  <para style="p" vid="1CH 12:38">Mbere n’abandi Bisirayeli bose basigaye baremeza ko Dawidi ari we akwiye kubabera umwami. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />Abo bantu bamara imisi itatu bari kumwe na Dawidi, barya banywa, kuko imiryango yabo yari yabagemuriye. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />Vyongeye, n’abo hirya no hino gushika no mu Bisakari, Abazebuloni no mu Banafutali baraza bazanye ivyokurya ku ndogoba, ku ngamiya, ku nyumbu, no ku nka. Hariho n’ibintu vyinshi bigizwe n’ifu, n’insukoni zikaranze, inzabibu zikaranze, umuvinyu, amavuta, inka n’intama, kuko hari umunezero mwinshi mu Bisirayeli.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s1">Bimura Isandugu y’Isezerano yari i Kiriyati-Yeyarimu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />Dawidi avugana n’abakuru barongoye abandi, abarongoye imice y’ingabo igihumbi n’abarongoye imice y’ingabo ijana. <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />Maze abwira Abisirayeli bose ati: “Nivyaba bibahimbaye kandi ari ubugombe bw’<char style="nd">Uhoraho</char> Imana yanyu, reka dutume intumwa ku bari kure n’abari hafi benewanyu bari mu bice vyose vya Isirayeli, no ku baherezi n’Abalewi bari kumwe na bo mu bisagara vyabo n’uburagiro bwavyo, baze bafatanye natwe. <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />Tugende tugarukane iwacu Isandugu y’Imana yacu, kuko tutigeze tuvyitaho ku ngoma ya Sawuli.” <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />Ikoraniro ryose riremera ko bakora uko, kuko abantu bose babonye ko ari vyiza.<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />Nuko Dawidi akoranya Abisirayeli bose, kuva ku ruzi Shihori ari ko kagezi ka Egiputa gushika i Lebo-Hamati, ngo baje kuzana Isandugu y’Imana yari i Kiriyati-Yeyarimu. <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />Dawidi n’Abisirayeli bose bajana na we i Bayala h’i Buyuda, ari ho Kiriyati-Yeyarimu, kugira ngo bakureyo isandugu y’<char style="nd">Uhoraho</char> Imana, ivyagiye hagati y’abakerubi, isandugu yitirirwa rya Zina.<verse eid="1CH 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7" />Bakura isandugu y’Imana mu nzu kwa Abinadabu iri ku mukogote mushasha, Uza na Ahiyo bayoboye uwo mukogote. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />Dawidi n’Abisirayeli bose bariko bariginagura imbere y’Imana n’inkomezi zabo zose, baririmba bavuza inanga, amakembe, udushako tw’ingoma, inzumbete n’ibindi bicurarangisho.<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />Bashitse ku mbuga yo kugosorerako ya Kidoni, Uza agorora ukuboko kwiwe ngo asame iyo sandugu, kuko impfizi zikwega uwo mukogote zari zitsitaye. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" /><char style="nd">Uhoraho</char> ashavurira cane Uza, maze aramukubita arapfa kuko akoze kuri iyo sandugu. Nuko aca apfira ngaho nyene imbere y’Imana.<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />Maze Dawidi arashavura kuko <char style="nd">Uhoraho</char> yarakiye Uza. Aca yita aho hantu Perezi-Uza, bisigura “gushavurira Uza”; kandi ni ko hacitwa kugeza n’uno musi.<verse eid="1CH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12" />Dawidi aca atinya Imana kuri uwo musi, maze arabaza ati: “Mbega noshobora nte kuzana Isandugu y’Imana iwanje?” <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />Ntiyatwara iyo Sandugu ngo ije mu Gisagara ca Dawidi, ariko aca ayikebereza mu nzu kwa Obedi-Edomu w’i Gati. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />Iyo Sandugu y’Imana iguma mu nzu kwa Obedi-Edomu no mu muryango wiwe amezi atatu, maze <char style="nd">Uhoraho</char> ahezagira umuryango wa Obedi-Edomu n’ivyo ari atunze vyose.<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s1">Abo mu nzu ya Dawidi n’umuryango wiwe</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />Maze Hiramu umwami w’i Tiro arungika intumwa kwa Dawidi, azirungikana n’ibiti vy’amasederi, n’abubatsi bubakisha amabuye n’ababaji bo kumwubakira ikirimba. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />Maze Dawidi aca amenya ko <char style="nd">Uhoraho</char> yemeje ko ari we mwami w’Abisirayeli bose kandi ko yashize hejuru ubwami bwiwe kubera abantu biwe b’Abisirayeli.<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />Dawidi arongorera i Yerusalemu abandi bagore, avyara abandi bahungu n’abakobwa. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />Aya ni yo mazina y’abana yavyariye i Yerusalemu: Shamuwa, Shobabu, Natani, Salomo, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />Ibuhari, Elishuwa, Elupeleti, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />Nogahu, Nefegi, Yafiya, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />Elishama, Beyeliyada na Elifeleti.<verse eid="1CH 14:7" /></para>
  <para style="s1">Dawidi anesha Abafilisitiya</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />Abafilisitiya bumvise ko Dawidi yasizwe amavuta ngo abe umwami w’Abisirayeli bose, baraduga n’inkomezi zabo zose bagiye kumurondera ngo bamufate; ariko Dawidi avyumvise aca aja guhura na bo. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />Maze Abafilisitiya barashika bacumbika mu kiyaya c’i Refayimu; <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />Dawidi aca asiguza Imana ati: “Mbega nje gutera Abafilisitiya? Urabampa mu maboko yanje?”</para>
  <para style="p" vid="1CH 14:10">
    <char style="nd">Uhoraho</char> aramwishura ati: “Genda, nzobatanga mu maboko yawe.”<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />Nuko Dawidi n’ingabo ziwe baraduga baja i Bayali-Perazimu, kandi aho ni ho yabaneshereje. Aravuga ati: “Imana yansaturiye inzira mu bansi banje ikoresheje ukuboko kwanje nk’uko amazi asenyura urugomero.” Ni co catumye aho hantu hitwa Bayali-Perazimu. <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />Abafilisitiya bari batayeho ibigirwamana vyabo, maze Dawidi aca atanga itegeko ngo babiturire.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />Ikindi gihe Abafilisitiya bongera gucumbika mu kiyaya; <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />maze Dawidi yongera kubaza Imana ico yokora, na yo iramwishura iti: “Ntubatere ubaturutse imbere, ariko ubazunguruke ubatere ubaturutse inyuma aharabana na biriya biti vy’imibaka. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />Niwumva imirindi mu bushorishori bw’ivyo biti, uce utangura kubagwanya, kuko Imana izoba ikugiye imbere kugwanya ingabo z’Abafilisitiya.” <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />Nuko Dawidi akora nk’uko Imana yamutegetse, maze bica ingabo z’Abafilisitiya kuva i Gibeyoni gushika i Gezeri.<verse eid="1CH 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17" />Nuko Dawidi aba rurangiranwa mu gihugu cose, kandi <char style="nd">Uhoraho</char> atuma ibihugu vyose bimutinya.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s1">Isandugu y’Isezerano yimurirwa i Yerusalemu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />Dawidi amaze kwubaka inyubakwa ziwe mu Gisagara ca Dawidi, aca ategura ikibanza c’Isandugu y’Imana, ayishingira ihema. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />Maze Dawidi aravuga ati: “Nta muntu n’umwe atari Umulewi akwiye guterura Isandugu y’Imana, kuko <char style="nd">Uhoraho</char> yabatoranirije kurerura iyo Sandugu yiwe no kwama bamukorera bari imbere yiwe ibihe bidashira.”<verse eid="1CH 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3" />Dawidi akoranya Abisirayeli bose i Yerusalemu ngo badugane Isandugu y’<char style="nd">Uhoraho</char> bayizane mu kibanza yari yayiteguriye.<verse eid="1CH 15:3" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="4" style="v" sid="1CH 15:4" />Ahamagara abo mu ruvyaro rwa Aroni n’Abalewi:<verse eid="1CH 15:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5" />Abo mu nzu ya Kohati,</para>
  <para style="li2" vid="1CH 15:5">Uriyeli umukuru wabo hamwe na benewabo ijana na mirongo ibiri;<verse eid="1CH 15:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6" />abo mu nzu ya Merari,</para>
  <para style="li2" vid="1CH 15:6">Asaya umukuru wabo hamwe na benewabo amajana abiri na mirongo ibiri;<verse eid="1CH 15:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7" />abo mu nzu ya Gerishomu,</para>
  <para style="li2" vid="1CH 15:7">Yoweli umukuru wabo hamwe na benewabo ijana na mirongo itatu;<verse eid="1CH 15:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8" />abo mu nzu ya Elizafani,</para>
  <para style="li2" vid="1CH 15:8">Shemaya umukuru wabo hamwe na benewabo amajana abiri;<verse eid="1CH 15:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9" />abo mu nzu ya Heburoni,</para>
  <para style="li2" vid="1CH 15:9">Eliyeli umukuru wabo hamwe na benewabo mirongo umunani;<verse eid="1CH 15:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10" />abo mu ya Uziyeli,</para>
  <para style="li2" vid="1CH 15:10">Aminadabu umukuru wabo hamwe na benewabo ijana na cumi na babiri.<verse eid="1CH 15:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />Hanyuma Dawidi atumako Sadoki na Abiyatari abaherezi, na Uriyeli, Asaya, Yoweli, Shemaya, Eliyeli na Aminadabu Abalewi. <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />Arababwira ati: “Ni mwebwe bakuru b’inzu zigize umuryango w’Abalewi; mwebwe na bagenzi banyu b’Abalewi nimwiyeze kugira ngo muje kudugana Isandugu y’<char style="nd">Uhoraho</char>, Imana y’Abisirayeli, muyizane mu kibanza nayitunganirije. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />Kubera yuko, mwebwe Abalewi, mutayireruye ca gihe ni co catumye <char style="nd">Uhoraho</char> Imana yacu aturakira. Ntitwamusiguje ngo atubwire uko yavuze bizohora bikorwa.” <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />Nuko abaherezi n’Abalewi bariyeza kugira ngo baje kudugana Isandugu y’<char style="nd">Uhoraho</char>, Imana y’Abisirayeli. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />Kandi Abalewi barerura Isandugu y’Imana iri ku biti bibiri biteruwe n’abantu bane ku bitugu vyabo, nk’uko Mose yari yarabitegetse yisunze ijambo ry’<char style="nd">Uhoraho</char>.<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />Dawidi abwira abakuru bo mu Balewi ngo batoranye muri bagenzi babo b’abaririmvyi abo kuririmba indirimbo z’umunezero, bavuza n’ibicurarangisho: amakembe, inanga n’udushako tw’ingoma.<verse eid="1CH 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17" />Maze Abalewi batoranya Hemani mwene Yoweli; mu bavukanyi biwe, Asafu mwene Berekiya; no muri benewabo b’Abamerari, Etani mwene Kushaya; <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />bari kumwe na benewabo bo ku rwego rwa kabiri: Zakariya, Yayaziyeli, Shemiramoti, Yehiyeli, Uni, Eliyabu, Benaya, Mayaseya, Matitiya, Elifelehu, Mikuneya, Obedi-Edomu na Yeyiyeli, abarinzi b’irembo.<verse eid="1CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19" />Abacuraranzi Hemani, Asafu na Etani bavuza ivyuma vy’imiringa; <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />Zakariya, Aziyeli, Shemiramoti, Yehiyeli, Uni, Eliyabu, Mayaseya na Benaya bacuraranga amakembe mw’ijwi ryitwa <char style="tl">alamoti,</char> <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />nayo Matitiya, Elifelehu, Mikuneya, Obedi-Edomu, Yeyiyeli na Azaziya bavuza inanga, mw’ijwi ryitwa <char style="tl">Sheminite.</char> <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />Kenaniya umukuru w’Abalewi yari arongoye abaririmvyi, kuko yari umuhinga muri vyo.<verse eid="1CH 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23" />Berekiya na Elukana bari abarinzi b’urugi rw’ihema ry’isandugu. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />Shebaniya, Yoshafati, Netaneli, Amasayi, Zakariya, Benaya na Eliyezeri abaherezi bari bashinzwe kuvuza inzamba imbere y’Isandugu y’Imana. Obedi-Edomu na Yehiya na bo nyene bari bashinzwe kurinda umuryango w’isandugu.<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />Nuko Dawidi n’abakuru bose b’Abisirayeli n’intwazangabo zirongoye ingabo igihumbihumbi, bagenda kudugana Isandugu y’Isezerano y’<char style="nd">Uhoraho</char> bayikura mu nzu kwa Obedi-Edomu, bari n’umunezero mwinshi. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />Kandi kubera ko Imana yafashije Abalewi bari bareruye iyo Sandugu y’Isezerano y’<char style="nd">Uhoraho</char>, baciye batanga ibimazi vy’amashuri y’inka indwi n’amapfizi y’intama indwi. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />Muri ico gihe Dawidi yari yambaye ikanzu yera derere, co kimwe n’Abalewi bose bari bareruye iyo Sandugu, n’abaririmvyi, na Kenaniya umukuru w’imigwi y’abaririmvyi; kandi Dawidi yari yambaye na efodi yera. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />Nuko Abisirayeli bose badugana iyo Sandugu y’Isezerano y’<char style="nd">Uhoraho</char> batera akamo k’umunezero, bavuza inzamba zikozwe mu mahembe y’intama n’inzumbete, n’ivyuma bivuzwa bigasama, bavuza n’amakembe n’inanga.<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />Maze Isandugu y’Isezerano y’<char style="nd">Uhoraho</char> yinjiye mu Gisagara ca Dawidi, Mikali umukobwa wa Sawuli abirabira mw’idirisha. Abonye umwami Dawidi atamba yiginagura, amugayira mu mutima.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="s1">Isandugu y’Imana ishirwa mw’ihema</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />Maze bazana ya Sandugu y’Imana bayinjiza muri rya hema Dawidi yari yarayiteguriye, hanyuma batanga ibimazi biturirwa n’umuriro hamwe n’ivy’ishimwe imbere y’<char style="nd">Uhoraho</char>. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />Ahejeje gutanga ivyo bimazi biturirwa n’umuriro n’ivy’ishimwe, ahezagira abantu mw’izina ry’<char style="nd">Uhoraho</char>. <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />Aca aha Umwisirayeli wese, yaba umugabo canke umugore, umukate, inyama n’akandi gakate gakozwe mu nzabibu.<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />Aca atoranya bamwe mu Balewi ngo bakorere imbere y’Isandugu y’<char style="nd">Uhoraho</char>, bambaze, bashime, bahimbaze <char style="nd">Uhoraho</char>, Imana y’Abisirayeli: <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />Asafu ni we yari umukuru, Zakariya akaba uwa kabiri, hanyuma Yeyiyeli, Shemiramoti, Yehiyeli, Matitiya, Eliyabu, Benaya, Obedi-Edomu na Yeyiyeli. Bari bashinzwe kuvuza amakembe n’inanga, Asafu akavuza ivyuma bisama, <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />Benaya na Yahaziyeli abaherezi na bo bakavuza inzamba uko igihe cagenywe gishitse imbere y’Isandugu y’Isezerano y’Imana.<verse eid="1CH 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />Kuri uwo musi Dawidi ashinga ubwa mbere Asafu n’abo bari bafatanije ngo baririmbe iyi ndirimbo yo gutanga ishimwe k’<char style="nd">Uhoraho</char>:<verse eid="1CH 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8" />Nimuhimbaze <char style="nd">Uhoraho</char>, mwamamaze izina ryiwe;</para>
  <para style="q2" vid="1CH 16:8">mumenyekanishe mu mahanga ivyo yakoze.<verse eid="1CH 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9" />Nimumuririmbire, mumuhimbaze;</para>
  <para style="q2" vid="1CH 16:9">muvuge ibikorwa vyiwe bihambaye.<verse eid="1CH 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10" />Mwirate izina ryiwe ryera;</para>
  <para style="q2" vid="1CH 16:10">imitima y’abarondera <char style="nd">Uhoraho</char> inezerwe.<verse eid="1CH 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11" />Nimurondere <char style="nd">Uhoraho</char> n’inkomezi ziwe;</para>
  <para style="q2" vid="1CH 16:11">mwame murondera mu nyonga hiwe.<verse eid="1CH 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12" />Nimwibuke ibitangaza yakoze,</para>
  <para style="q2" vid="1CH 16:12">utwumiza, n’imanza yaciye;<verse eid="1CH 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13" />Yemwe ruvyaro rwa Isirayeli, umusavyi wayo;</para>
  <para style="q2" vid="1CH 16:13">yemwe bene Yakobo, abo yatoranije.<verse eid="1CH 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14" />
    <char style="nd">Uhoraho</char> ni we Mana yacu;</para>
  <para style="q2" vid="1CH 16:14">imanza ziwe ziri mw’isi yose.<verse eid="1CH 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15" />Nimwibuke isezerano ryiwe ibihe vyose,</para>
  <para style="q2" vid="1CH 16:15">n’ijambo yasezeranye, gushika ku runganwe rugira igihumbi,<verse eid="1CH 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16" />Isezerano yagiranye na Aburahamu,</para>
  <para style="q2" vid="1CH 16:16">indahiro yarahiye Isaka.<verse eid="1CH 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17" />Yararyemeje kuri Yakobo nk’itegeko,</para>
  <para style="q2" vid="1CH 16:17">no kuri Isirayeli nk’isezerano ry’intahava ngo:<verse eid="1CH 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18" />“Nzoguha igihugu c’i Kanani,</para>
  <para style="q2" vid="1CH 16:18">kibe umugabane wawe uzoragwa.”<verse eid="1CH 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19" />Igihe bari bakiri inkehwa gusa,</para>
  <para style="q2" vid="1CH 16:19">mbere ari inkehwa vy’ukuri, kandi ari inyambukira muri co,<verse eid="1CH 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20" />Bagenda bangara bava mu gihugu baja mu kindi,</para>
  <para style="q2" vid="1CH 16:20">bava mu bwami baja mu bundi.<verse eid="1CH 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21" />Ntiyakundira umuntu n’umwe kubacinyiza;</para>
  <para style="q2" vid="1CH 16:21">ku bwabo yakankamiye abami ati:<verse eid="1CH 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22" />“Ntimukore ku bo narobanuje amavuta;</para>
  <para style="q2" vid="1CH 16:22">ntimugirire nabi abavugishwa banje.”<verse eid="1CH 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23" />Yemwe abari mw’isi mwese, muririmbire <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="1CH 16:23">mwamamaze agakiza kiwe uko bukeye,<verse eid="1CH 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24" />Muvuge ivy’icubahiro ciwe mu mahanga yose,</para>
  <para style="q2" vid="1CH 16:24">n’ibitangaza yakoze mu moko yose.<verse eid="1CH 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25" />Kuko <char style="nd">Uhoraho</char> ahambaye kandi abereye gushimwa;</para>
  <para style="q2" vid="1CH 16:25">akwiye kwubahwa kuruta ibigirwamana vyose.<verse eid="1CH 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26" />Kuko imana zose z’amahanga ari ibigirwamana,</para>
  <para style="q2" vid="1CH 16:26">ariko <char style="nd">Uhoraho</char> yaremye amajuru.<verse eid="1CH 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27" />Ubwiza n’icubahiro biri imbere yiwe;</para>
  <para style="q2" vid="1CH 16:27">inkomezi n’umunezero biri mu ngoro yiwe.<verse eid="1CH 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28" />Nimwemere <char style="nd">Uhoraho</char>, yemwe miryango yose yo mu mahanga,</para>
  <para style="q2" vid="1CH 16:28">mwemere ko <char style="nd">Uhoraho</char> afise icubahiro n’inkomezi.<verse eid="1CH 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29" />Nimuhe <char style="nd">Uhoraho</char> icubahiro kibereye izina ryiwe; Muzane ishikanwa, mushike mu birimba vyiwe.</para>
  <para style="q1" vid="1CH 16:29">Musenge <char style="nd">Uhoraho</char> muri mu bwiza bw’ukwera kwiwe.<verse eid="1CH 16:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 16:30" />Yemwe abari mw’isi mwese, muhindire agashitsi imbere yiwe!</para>
  <para style="q2" vid="1CH 16:30">Isi irashimangiye; ntishobora kunyiganyizwa.<verse eid="1CH 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31" />Ijuru nirinezerwe, isi nihimbarwe;</para>
  <para style="q2" vid="1CH 16:31">nibivuge mu mahanga yose biti: “<char style="nd">Uhoraho</char> araganje!”<verse eid="1CH 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32" />Ikiyaga nikibomborane, n’ibiri muri co vyose;</para>
  <para style="q2" vid="1CH 16:32">imirima yose nivyine, n’ibiri muri yo vyose!<verse eid="1CH 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33" />Maze ibiti vyo mw’ishamba bizoririmba.</para>
  <para style="q2" vid="1CH 16:33">Bizoririmbishwa n’umunezero mu nyonga z’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="1CH 16:33">kuko aje gucira isi urubanza.<verse eid="1CH 16:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34" />Nimushime <char style="nd">Uhoraho</char> kuko ari mwiza;</para>
  <para style="q2" vid="1CH 16:34">kuko urukundo rwiwe rwamaho ibihe bidashira.<verse eid="1CH 16:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35" />Nimutakambe muti: “Dukize, yewe Mana y’agakiza kacu;</para>
  <para style="q2" vid="1CH 16:35">twegeranye udukure mu mahanga,</para>
  <para style="q1" vid="1CH 16:35">kugira ngo dushime izina ryawe ryera,</para>
  <para style="q2" vid="1CH 16:35">twongere tuguhimbaze.”<verse eid="1CH 16:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36" />
    <char style="nd">Uhoraho</char>, Imana ya Isirayeli, ahimbazwe</para>
  <para style="q2" vid="1CH 16:36">Uhereye ibihe bidashira ukageza ibihe bidashira.</para>
  <para style="m" vid="1CH 16:36">Maze abantu bose baritabira bati: “Amen”; bongerako bati: “Dutazire Uhoraho.”<verse eid="1CH 16:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />Dawidi aca ashinga ko Asafu n’abo bari kumwe imbere y’Isandugu y’Isezerano y’<char style="nd">Uhoraho</char> bazoguma aho bayikorera imisi yose, nk’uko vyari bitegekanijwe ku musi ku musi. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />Ashinga ko Obedi-Edomu mwene Yedutuni, na Hosa, n’abandi Balewi mirongo itandatu n’umunani, baba abarinzi b’irembo.<verse eid="1CH 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39" />Dawidi ashinga ko Sadoki umuherezi na bagenzibe b’abaherezi bama imbere y’ihema ry’<char style="nd">Uhoraho</char> ku mpinga y’umusozi i Gibeyoni <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />ngo bashikanire <char style="nd">Uhoraho</char> ibimazi vyo guturirirwa ku gicaniro bashikanirako ibimazi vyo ku musi ku musi, nk’uko vyanditswe mu Vyagezwe <char style="nd">Uhoraho</char> yahawe Abisirayeli. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />Abandi bari kumwe na bo ni Hemani na Yedutuni n’abandi bose bari baratoranijwe uko amazina yabo ari ngo bashime <char style="nd">Uhoraho</char> bavuga bati: “Kuko urukundo rwiwe rwamaho ibihe bidashira.” <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />Hemani na Yedutuni bari bashinzwe kuvuza inzamba n’ivyuma bisama no kuvuza ibindi bicurarangisho mu kuririmba indirimbo z’Imana. Bene Yedutuni bahabwa igikorwa co gucungera irembo.<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />Nuko abantu bose barataha, umwe wese aja iwe, Dawidi na we asubira iwe ahezagira umuryango wiwe.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s1">Isezerano Imana yasezeraniye Dawidi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />Dawidi amaze gushika neza mu ngoro iwe, abwira Natani uwavugishwa n’Imana ati: “Ehe raba, jewe mba mu nzu yubatswe n’ibiti vy’amasederi, nayo Isandugu y’Isezerano y’<char style="nd">Uhoraho</char> iba mw’ihema.”<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />Natani yishura Dawidi ati: “Ivyo wiyumvira gukora vyose, genda ubikore kuko Imana iri kumwe nawe.”<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />Ariko muri iryo joro, ijambo ry’Imana riza kuri Natani riti:<verse eid="1CH 17:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4" />“Genda ubwire umusavyi wanje Dawidi uti: ‘Uku ni ko <char style="nd">Uhoraho</char> avuze: Si wewe uzonyubakira inzu yo kubamwo. <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />Sinigeze mba mu nzu kuva igihe nakuriye Abisirayeli muri Egiputa gushika uwu musi. Namye nimuka mva mu kibanza kimwe nja mu kindi, nkibera mw’ihema. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />Ahantu hose nimukiye ndi kumwe n’Abisirayeli bose, hari aho nigeze mbwira umutware n’umwe mu barongozi nabahaye ngo baragire ubwoko bwanje nti: Ni kuki mutanyubakira inzu mu biti vy’amasederi?’<verse eid="1CH 17:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7" />None rero, genda ubwire umusavyi wanje Dawidi uti: Uku ni ko <char style="nd">Uhoraho</char> Mushoboravyose avuze: nagukuye mu bwungere aho waragira intama, ndagutoranya ngo ube uwuganza abantu banje b’Abisirayeli. <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />Nabanye nawe aho wagiye hose, kandi naherengeteje abansi bawe imbere yawe. None ngira nkuze izina ryawe ribe nk’amazina y’abahambaye bo kw’isi. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />Kandi nzoha abantu banje b’Abisirayeli aho kuba, ndabateragire ahantu hatekanye ngo bagire inzu yabo bwite, aho batazokwongera kuburagizwa. Abansi babo ntibazosubira kubacinyiza nk’uko bahora babigira kera, <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />canke nk’uko bamye babikora uhereye igihe nashiraho abacamanza bo kurongora abantu banje b’Abisirayeli. Kandi nzocisha bugufi abansi bawe bose.</para>
  <para style="pm" vid="1CH 17:10">Kandi ikirenze kuri ivyo, ndakumenyesheje ko ari <char style="nd">Uhoraho</char> azokwubakira inzu. <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />Imisi yawe niyashira ugahamvya ba sogokuruza, nzohagurutsa uwo mu ruvyaro rwawe wo kugusubirira ku ngoma, umwe wo mu bahungu bawe wivyariye, kandi nzokomeza ubwami bwiwe. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />Uwo ni we azonyubakira ingoro, nanje nzokomeza ingoma yiwe ibihe bidashira. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />Nzomubera se, na we azombera umwana. Kandi sinzokwigera ndamukurako urukundo rwanje, nka kurya narukuye ku wo wasubiriye ku ngoma. <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />Nzomuzeza inzu yanje n’ubwami bwanje ibihe vyose; intebe y’inganji yiwe izokwama ihangamye ibihe bidashira.”<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />Nuko Natani aragenda ashikiriza Dawidi ayo majambo yose y’uko guhishurirwa.<verse eid="1CH 17:15" /></para>
  <para style="s1">Isengesho rya Dawidi</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />Nuko umwami Dawidi arinjira yicara imbere y’<char style="nd">Uhoraho</char>, maze avuga ati:</para>
  <para style="pm" vid="1CH 17:16">“Jewe ndi iki, yewe <char style="nd">Uhoraho</char> Nyeninganji, kandi n’umuryango wanje wari iki, ko wanshikanye aha hose? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />Kandi nk’aho umenga ivyo vyose ntivyari bihagije mu nyonga zawe ga Mana, warongeyeko uvuga ivya kazoza k’inzu y’umusavyi wawe. Wewe <char style="nd">Uhoraho</char> Mana, wandavye nk’uko umenga ndi hejuru y’abandi bose.<verse eid="1CH 17:17" /></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18" />Mbega jewe Dawidi ikindi novuga ni iki ku vy’icubahiro wampaye jewe umusavyi wawe? Kuko urazi umusavyi wawe, <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />yewe <char style="nd">Uhoraho</char>. Wakoze iki kintu gihambaye, wongera umenyesha amasezerano yawe ahambaye nk’uko wabigomvye.<verse eid="1CH 17:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20" />Nta n’umwe asa nawe <char style="nd">Uhoraho</char>, kandi nta yindi Mana atari wewe, nk’uko twavyiyumviye n’amatwi yacu. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />Kandi ni irihe hanga kw’isi yose rimeze nk’abantu bawe b’Abisirayeli; ihanga wewe Imana wihagurukiye ukaja gucungura kugira ngo ribe iryo wiharije; kandi kugira ngo wiheshe icubahiro, ugakora ibihambaye biteye ubwoba, ukirukana amahanga imbere y’abantu bawe wacunguye ukabakura muri Egiputa? <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />Wahinduye abantu bawe b’Abisirayeli kuba abo wiharije ibihe vyose, kandi nawe <char style="nd">Uhoraho</char>, wahindutse Imana yabo.<verse eid="1CH 17:22" /></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23" />None rero, <char style="nd">Uhoraho</char>, ivyo wasezeraniye umusavyi wawe n’inzu yiwe uze ubikomeze kugeza ibihe vyose. Uze ukore nk’uko wasezeranye, <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />kugira ngo bishike kandi izina ryawe ribe irihambaye ibihe bidashira. Maze abantu bazovuge bati: ‘<char style="nd">Uhoraho</char> Mushoboravyose, Imana iganza Abisirayeli, ni yo Mana y’Abisirayeli!’ Kandi n’inzu y’umusavyi wawe Dawidi izokomerera imbere yawe.<verse eid="1CH 17:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25" />Ewe Mana yanje, wahishuriye umusavyi wawe ko uzomwubakira inzu. Ni co catumye umusavyi wawe nterwa intege zo kugusenga. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />None rero <char style="nd">Uhoraho</char>, uri Imana! Wasezeraniye umusavyi wawe ibi vyiza bingana bityo. <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />Vyaguhimbaye guha umugisha inzu y’umusavyi wawe, ngo izohore iri imbere yawe ibihe vyose; kuko ubwawe, yewe <char style="nd">Uhoraho</char> wayihezagiye, kandi izokwama ihezagiwe ibihe vyose.”<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s1">Dawidi anesha abansi biwe</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />Inyuma y’ivyo, Dawidi atera Abafilisitiya arabanesha, maze afata Gati n’imihana ihakikije abikura mu maboko y’Abafilisitiya.<verse eid="1CH 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2" />Dawidi arongera anesha Abanyamowabu, bacika abagurano biwe bakama bamuzanira amashikanwa yo kumwisaba.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />Vyongeye, Dawidi agwanya Hadadezeri umwami w’i Zoba aramunesha gushika i Hamati, mu gihe Hadadezeri yari agiye gukomeza inganji yiwe mu karere k’uruzi Efurate. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />Dawidi amunyaga imikogote igihumbi, abayigenderamwo ibihumbi indwi n’abasoda bagwanira ku maguru ibihumbi mirongo ibiri. Acagagura ibinono vy’amafarasi akwega iyo mikogote, asigaza ayo gukwega imikogote ijana gusa.<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />Maze Abaramu b’i Damasiko baja gutabara Hadadezeri umwami w’i Zoba, Dawidi abicamwo abantu ibihumbi mirongo ibiri na bibiri. <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />Aca ashinga ibirindiro i Damasiko ku mugwa mukuru w’i Siriya kandi Abaramu bacika abagurano biwe, bakama bamuzanira amashikanwa yo kumwisaba. <char style="nd">Uhoraho</char> yama aha Dawidi intsinzi aho yaja hose.<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />Dawidi afata inkinzo z’inzahabu zari iz’intwazangabo za Hadadezeri, azijana i Yerusalemu. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />Mu bisagara vy’i Tibuhati n’i Kuni vyari ivya Hadadezeri, Dawidi ahanyaga ubutare bwinshi bw’umwakaka, ubwo Salomo yakoresheje mu kwubaka ibesani nini y’umwakaka bita ikiyaga, inkingi n’ibindi bikoresho vyari bikozwe muri ubwo butare.<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />Maze Towu umwami w’i Hamati yumvise ko Dawidi yanesheje ingabo zose za Hadadezeri umwami w’i Zoba, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />aca arungika umuhungu wiwe Hadoramu ku mwami Dawidi kumuramutsa no kumukeza, kuko yanesheje Hadadezeri yahora yama amugwanya. Hadoramu ajana ibikoresho vy’ubwoko bwinshi, vy’inzahabu n’ivy’ifeza n’ivy’umwakaka.<verse eid="1CH 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11" />Umwami Dawidi aca yegurira <char style="nd">Uhoraho</char> ivyo bikoresho vyose, nk’uko yari yabigize ku nzahabu n’ifeza yari yakuye muri ivyo bihugu vyose ari vyo vy’Abanyedomu, Abanyamowabu, Abamoni, Abafilisitiya n’Abamaleki.<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />Abishayi mwene Zeruwiya yica Abanyedomu ibihumbi cumi n’umunani mu Kiyaya c’Umunyu. <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />Ashira ibirindiro mu gihugu ca Edomu, kandi Abanyedomu bose baca baba abagurano ba Dawidi. <char style="nd">Uhoraho</char> yama aha intsinzi Dawidi aho yaja hose.<verse eid="1CH 18:13" /></para>
  <para style="s1">Abatware bo mu bwami bwa Dawidi</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />Dawidi aganza Abisirayeli bose, akora ibibereye n’ibigororotse ku bantu biwe bose.<verse eid="1CH 18:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 18:15" />Yowabu mwene Zeruwiya ni we yari umukuru w’ingabo;</para>
  <para style="li1" vid="1CH 18:15">Yehoshafati mwene Ahiludi na we yari umwanditsi w’ivyaja biraba;<verse eid="1CH 18:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 18:16" />Sadoki mwene Ahitubu na Abimeleki mwene Abiyatari bari abaherezi;</para>
  <para style="li1" vid="1CH 18:16">Shavisha yari umunyamabanga;<verse eid="1CH 18:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 18:17" />Benaya mwene Yehoyada yari ajejwe Abakereti n’Abapeleti;</para>
  <para style="li1" vid="1CH 18:17">kandi abahungu ba Dawidi bari abahanuzi bakuru b’umwami.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s1">Dawidi agwanya Abamoni</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />Hanyuma y’ivyo, Nahashi umwami w’Abamoni arapfa, maze umuhungu wiwe amusubirira ku ngoma. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />Dawidi ariyumvira ati: “Nzogirira neza Hanuni mwene Nahashi, kuko se yangiriye neza.” Nuko Dawidi atuma intumwa ngo zije kugarukira kuri Hanuni kuko yari yabuze se.</para>
  <para style="p" vid="1CH 19:2">Ba bantu ba Dawidi bashitse kwa Hanuni mu gihugu c’Abamoni kumwirura, <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />abaganwa b’Abamoni babwira Hanuni bati: “Wibaza ko Dawidi yubashe so mu kukurungikira abantu ngo bakugarukireko? Abantu biwe ubwo ntibazanywe no kugenzura igihugu no kuraba ingene kimeze ngo baze bagitere?” <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />Nuko Hanuni afata ba bantu ba Dawidi, abamwa umushatsi, asatura impuzu zabo uhereye aho itako ritangurira, aca arabarungika.<verse eid="1CH 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5" />Haza abantu babwira Dawidi ivyashikiye abo bagabo, aca arungika intumwa ngo zihure na bo, kuko bari buzuye ibiteterwe. Umwami abatumako ati: “Nimugume i Yeriko gushika aho ubwanwa bwanyu buzokurira, hanyuma muze mubone kugaruka.”<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />Abamoni babonye ko bakoze ikintu giteye isoni imbere ya Dawidi, Hanuni n’Abamoni baca barungika italanto igihumbi<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">Ni nk’amatoni 38.</char></note> z’ifeza i Aramu-Naharayimu, Aramu-Mayaka n’i Zoba kugira ngo babahe imikogote n’abayikoresha mu ntambara. <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />Bakotesha ibihumbi mirongo itatu na bibiri vy’imikogote n’abayigwanisha, hamwe n’umwami w’i Mayaka n’ingabo ziwe, baraza bacumbika hafi y’i Medeba, Abamoni na bo bariko barasohoka mu bisagara vyabo baja gutonda urugamba.<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />Dawidi avyumvise, aca arungika Yowabu n’ingabo zose zizi kugwana. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />Abamoni baragenda batonda urugamba kw’irembo ry’igisagara, abami bari baje na bo bari ku musozi inyuma y’igisagara.<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />Yowabu abona ko urugamba rumuturutse imbere n’inyuma; aca atoranya bamwe mu ngabo z’indobanurwa mu Bisirayeli abarungika ngo bagwanye Abarameya. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />Abasigaye abazeza murumunawe Abishayi ngo abatware, aca abatuma kugwanya Abamoni. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />Yowabu amubwira ati: “Abarameya nibandusha inkomezi, uce uza kuntabara; ariko Abamoni nibakurusha inkomezi, ndagutabara. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />Nureme kandi tugwane rugabo, tugwanire ihanga ryacu n’ibisagara vy’Imana yacu. <char style="nd">Uhoraho</char> ari bukore ivyo abona ko ari vyiza mu nyonga ziwe.”<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />Maze Yowabu n’ingabo bari kumwe baragenda ngo bagwane n’Abarameya, na bo barabahunga. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />Abamoni babonye ko Abarameya bariko barahunga, na bo nyene baca bahunga murumunawe Abishayi binjira mu gisagara. Maze Yowabu aca yisubirira i Yerusalemu.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />Abarameya babonye ko baneshejwe n’Abisirayeli, batumako abandi Barameya bo hakurya y’uruzi Efurate, barongowe na Shofaki umukuru w’ingabo za Hadadezeri.<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />Dawidi avyumvise, akoranya Abisirayeli bose bajabuka Yorodani; batonda urugamba ngo babagwanye. Dawidi atondesha ingabo ngo zihangane n’Abarameya, na bo baraza bagwana na we. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />Ariko Abarameya bahunga Abisirayeli, kandi Dawidi yica ibihumbi indwi mu bagwanira ku mikogote n’ibihumbi mirongo ine vy’abagwanira ku maguru. Yica na Shofaki umukuru w’ingabo zabo.<verse eid="1CH 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19" />Abari barongowe na Hadadezeri babonye ko baneshejwe n’Abisirayeli, baca bisaba Dawidi bemera kuba abagurano biwe.</para>
  <para style="p" vid="1CH 19:19">Maze Abarameya ntibasubira kwiyumvira gutabara Abamoni.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s1">Dawidi yigarurira i Raba</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />Mu gihe imvura yaba itanguye kugabanuka hakaza ici, ni ho abami bahora baja mu ntambara. Yowabu arongora ingabo, aja gutera igihugu c’Abamoni arakinesha; ariko Dawidi yigumira i Yerusalemu. Yowabu yugariza igisagara c’i Raba arakinesha, agihindura umusaka. <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />Dawidi amaze gushika afata urugori rw’ubwami rwari ku mutwe w’umwami waho, asanga rupima italanto imwe<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">Ni nk’ibilo 34.</char></note> y’inzahabu, kandi rwari rusharijwe n’utubuye tw’agaciro, baca barwambika Dawidi. Atwara iminyago myinshi akuye muri ico gisagara, <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />atwara n’abantu bo muri ico gisagara, abashingira ibikebere, bamwe baba abasatura imbaho, abandi bagakoresha amasipiri n’incabiti. Dawidi abigenza atyo mu bisagara vyose vy’Abamoni. Hanyuma Dawidi n’ingabo zose basubira i Yerusalemu.<verse eid="1CH 20:3" /></para>
  <para style="s1">Intambara z’Abafilisitiya</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />Hanyuma y’ivyo, havyuka intambara hagati y’Abisirayeli n’Abafilisitiya, ibera ahitwa Gezeri. Muri ico gihe Sibekayi Umuhushati yica Sipayi, umwe mu bakomoka ku Barefayimu, kandi Abafilisitiya baraneshwa.<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />Mu yindi ntambara bagwana n’Abafilisitiya, Eluhanani mwene Yayiro yica Lahimi umuvukanyi wa Goliyati w’i Gati, uruti rw’icumu ryiwe rwangana n’umuhini.<verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />Kandi mu yindi ntambara yabereye i Gati, hari umugabo munini cane yari afise intoke zitandatu ku kiganza cose n’amano atandatu ku kirenge cose; vyose hamwe vyari mirongo ibiri na bine. Na we nyene yakomoka kuri Rafa. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />Atanguye gucokora Abisirayeli, Yonatani mwene Shimeya, yavukana na Dawidi, aramwica.<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />Abo bari abakomoka kuri Rafa w’i Gati, kandi bishwe na Dawidi n’abantu biwe.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s1">Dawidi aharura ingabo bimuzanira igihano</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />Maze Satani ahagurukira Abisirayeli aca yosha umutima wa Dawidi ngo aharure Abisirayeli bose. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />Nuko Dawidi abwira Yowabu n’intwazangabo ati: “Genda muharure Abisirayeli kuva i Berisheba gushika i Dani. Muce mumbwira kugira ngo menye igitigiri cabo.”<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />Ariko Yowabu amwishura ati: “<char style="nd">Uhoraho</char> arakagwiza ingabo ziwe incuro ijana. Mwami wanje, mbega bose si abasavyi bawe? None ni iki gitumye umwami wanje akora atyo? Ni igiki cotuma uteza Abisirayeli kubonekako icaha?”<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />Ariko ijambo ry’umwami riremera Yowabu; maze Yowabu ava imbere yiwe aca akwiragira mu Bisirayeli bose aca agaruka i Yerusalemu. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />Yowabu ashikiriza Dawidi igitigiri c’abantu baja ku rugamba. Muri Isirayeli hari umuliyoni umwe n’ijana b’ababahizi bazi kugwanisha inkota, mu Buyuda na ho ibihumbi amajana ane na mirongo indwi.<verse eid="1CH 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6" />Ariko Yowabu ntiyashiramwo Abalewi n’Ababenyamini mu guharura, kuko atashaka gukora iryo tegeko ry’umwami. <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />Kandi iryo tegeko ntiryanezereje Imana; ivyo bituma ihana Abisirayeli.<verse eid="1CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8" />Nuko Dawidi abwira Imana ati: “Nacumuye cane ku bw’ico kintu nakoze. None rero, ndakwinginze, unkureko icaha canje jewe umusavyi wawe. Nakoze ivy’ubupfu rwose.”<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />
    <char style="nd">Uhoraho</char> abwira Gadi, uwerekwa wa Dawidi ati: <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />“Genda ubwire Dawidi uti: ‘Uku ni ko <char style="nd">Uhoraho</char> avuze: Ndaguhaye ibintu bitatu. Hitamwo kimwe nzoguhanisha.’ ”<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />Nuko Gadi aja kwa Dawidi aramubwira ati: “Uku ni ko <char style="nd">Uhoraho</char> avuze: ‘Hitamwo kimwe: <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />imyaka itatu y’inzara, amezi atatu uneshwa n’abansi aho inkota y’abansi banyu izobashikako, canke imisi itatu y’inkota y’<char style="nd">Uhoraho</char>; imisi y’ikiza mu gihugu, aho umumarayika w’<char style="nd">Uhoraho</char> azokwica abantu mu bice vyose vya Isirayeli.’ None rero, hitamwo hanyuma umbwire ico nishura uwantumye.”<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />Dawidi abwira Gadi ati: “Ndi n’umubabaro mwinshi. Reka mpfume ngwa mu maboko y’<char style="nd">Uhoraho</char>, kuko imbabazi ziwe ari nyinshi; ariko singwe mu maboko y’abantu.”<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />Nuko <char style="nd">Uhoraho</char> arungika ikiza mu Bisirayeli, abantu ibihumbi mirongo indwi vy’Abisirayeli barapfa. <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />Maze Imana ituma umumarayika ngo arandure Yerusalemu. Ariko igihe uwo mumarayika yariko arabikora, <char style="nd">Uhoraho</char> arabiraba ababazwa n’ico cago aca abwira uwo mumarayika yariko aratikiza abantu ati: “Geza aho! Garukana ukuboko kwawe.” Umumarayika w’<char style="nd">Uhoraho</char> yari ahagaze ku mbuga yo kugosorerako ingano ya Orunani Umuyebusi.<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />Dawidi aravye hejuru abona wa mumarayika w’<char style="nd">Uhoraho</char> ahagaze hagati y’isi n’ijuru, afise inkota iri mu kuboko kwiwe ibanguye kuri Yerusalemu. Nuko Dawidi n’abakuru muri Isirayeli, baca bambara amagunira bubama hasi.<verse eid="1CH 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17" />Dawidi abwira Imana ati: “Mbega si jewe nategetse ko baharura ingabo? Ni jewe nacumuye nkora ibidakwiye. Aba bo ni intama gusa. None bakoze iki? Yewe <char style="nd">Uhoraho</char> Mana yanje, ukuboko kwawe niguhane jewe n’umuryango wanje, ariko iki kiza ntikigume mu bantu bawe.”<verse eid="1CH 21:17" /></para>
  <para style="s1">Dawidi yubaka igicaniro</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />Maze umumarayika w’<char style="nd">Uhoraho</char> ategeka Gadi kubwira Dawidi ngo aduge yubakire <char style="nd">Uhoraho</char> igicaniro ku mbuga yo kugosorerako ingano ya Orunani Umuyebusi. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />Nuko Dawidi araduga yubashe iryo jambo Gadi yamubwiye mw’izina ry’<char style="nd">Uhoraho</char>.<verse eid="1CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20" />Mu gihe Orunani yariko aragosora ingano, ahindukiye abona wa mumarayika; maze abahungu biwe bane bari kumwe na we biruka kwinyegeza. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />Maze Dawidi arashika, Orunani yunamuye amaso aramubona, aca ava kuri ya mbuga yo kugosorerako yunama imbere ya Dawidi, ashika hasi.<verse eid="1CH 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22" />Dawidi aramubwira ati: “Numpe iki kibanza c’imbuga yawe kugira ngo ndahubakire <char style="nd">Uhoraho</char> igicaniro, maze ikiza kiri mu bantu gihagarare. Ndahakugurira ku giciro bikwiranye.”<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />Orunani abwira Dawidi ati: “Hashikire! Umwami wanje nahakoreshe ico ashaka cose. Ehe, ndatanga n’impfizi z’ikimazi co guturirwa n’umuriro, imihini yo gusekura ingano ndayitanze ngo ibe inkwi, n’ingano na zo ngo zibe ishikanwa ry’ifu. Ivyo vyose ndabiguhaye.”<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />Ariko umwami Dawidi yishura Orunani ati: “Oya, ndakwinginze unyemerere ndakurihe igiciro bikwiranye. Sinshobora gushikanira <char style="nd">Uhoraho</char> ibintu vyawe, canke ngo nshikane ikimazi co guturirwa ata co ndakiguze.”<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />Nuko Dawidi ariha Orunani shekeli amajana atandatu<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="ft" closed="false">Ni nk’ibilo 6,9.</char></note> vy’inzahabu ku bw’ico kibanza. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />Dawidi yubakira <char style="nd">Uhoraho</char> igicaniro aho nyene aca ashikana ibimazi vyo guturirwa n’ivy’ishimwe. Yambaza <char style="nd">Uhoraho</char>, maze <char style="nd">Uhoraho</char> na we aramwishura, amanura umuriro uvuye mw’ijuru uza kuri ca gicaniro c’ibimazi vyo guturirwa.<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />Nuko <char style="nd">Uhoraho</char> avugana na wa mumarayika, asubiza inkota yiwe mu rwubati. <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />Muri ico gihe, Dawidi abonye ko <char style="nd">Uhoraho</char> yishuye isengesho ryiwe kuri ya mbuga yo kugosorerako ingano ya Orunani Umuyebusi, aca atangiraho ibimazi. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />Ihema ry’<char style="nd">Uhoraho</char>, iryo Mose yari yarubatse mu bugaragwa, n’igicaniro co guturirirako ibimazi vyari mw’itaba ry’umusozi i Gibeyoni. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />Ariko Dawidi ntiyashoboye kujayo ngo asiguze Imana, kuko yari yatekewe n’ubwoba igihe yabona ya nkota y’umumarayika w’<char style="nd">Uhoraho</char>.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />Maze Dawidi aca avuga ati: “Ingoro y’<char style="nd">Uhoraho</char> Imana izoba aha nyene, n’igicaniro co guturirirako ibimazi vy’Abisirayeli ni uko nyene.”<verse eid="1CH 22:1" /></para>
  <para style="s1">Dawidi ategura ivyo kwubaka Ingoro y’<char style="nd">Uhoraho</char></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />Maze Dawidi atanga amategeko ko bakoranya abantu b’abanyamahanga baba mu Bisirayeli, atoranya muri bo abo kubaza amabuye ngo bategure amabuye abajwe yo kuzokwubaka Ingoro y’Imana. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />Ategura ubutare bw’ivyuma vyo gukoramwo imisumari y’imyango y’amarembo n’iyo kumanikako ibintu, n’ubutare bw’ivyuma bwinshi budashobora gupimwa uburemere. <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />Ategura n’ibiti vy’amasederi vyinshi bitoharurika, kuko Abanyesidoni n’Abatiro bari babizaniye Dawidi ari vyinshi cane.<verse eid="1CH 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5" />Dawidi avuga ati: “Umuhungu wanje Salomo aracari muto kandi nta burambe afise mu bikorwa, kandi Ingoro yo kwubakira <char style="nd">Uhoraho</char> ikwiye kuba ari akaroruhore kandi ari rurangiranwa imbere y’amahanga yose. Nkwiye rero gutegura ivyo kuzokwubakisha.” Nuko Dawidi agira imyiteguro myinshi imbere y’uko apfa.<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />Maze ahamagara umuhungu wiwe Salomo amushinga kuzokwubaka Ingoro y’<char style="nd">Uhoraho</char>, Imana y’Abisirayeli. <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />Dawidi abwira Salomo ati: “Mwana wanje, nari narabigabiye mu mutima wanje ko nzokwubaka Ingoro yo guhesha icubahiro Izina ry’<char style="nd">Uhoraho</char> Imana yanje. <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />Ariko <char style="nd">Uhoraho</char> ambwira iri jambo ati: ‘Wavishije amaraso menshi kandi wagwanye intambara nyinshi. Ntiwoshobora kwubaka Ingoro yitirirwa izina ryanje, kuko wavishije amaraso menshi kw’isi mu nyonga zanje. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />Ariko uzoronka umuhungu azoba umuntu w’amahoro n’itekane, kandi nzomuha kuruhuka abansi biwe mu mpande zose. Izina ryiwe azokwitwa Salomo, kandi nzoha Isirayeli amahoro n’umutekano ku ngoma yiwe. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />Uwo ni we azokwubaka Ingoro yitirirwa izina ryanje. Azombera umuhungu, nanje ndamubere se. Kandi nzokomeza ingoma y’ubwami bwiwe mu Bisirayeli ibihe bidashira.’<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />None rero mwana wanje, <char style="nd">Uhoraho</char> abane nawe, kugira ngo ushobore kwubaka Ingoro y’<char style="nd">Uhoraho</char> Imana yawe, nk’uko yavuze ko uzobikora. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" /><char style="nd">Uhoraho</char> aze aguhe kuroranya n’ugutahura niyagushira ku ntebe y’inganji y’Abisirayeli, kugira ngo uze witondere Ivyagezwe vy’<char style="nd">Uhoraho</char> Imana yawe. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />Nuko uzotera imbere niwitondera ivyo yashinze n’ivyagezwe vyose <char style="nd">Uhoraho</char> yahaye Mose ngo abihe Abisirayeli. Ukomere kandi ushire ubwoba. Ntutinye canke ngo ucike intege.<verse eid="1CH 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14" />Narakoze ndaruha kugira ngo ntegure ibikoresho vyose bikenewe vy’iyo Ngoro y’<char style="nd">Uhoraho</char>. Negeranije italanto ibihumbi ijana<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">Ni nk’amatoni 3.750.</char></note> z’inzahabu, italanto umuliyoni umwe<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">Ni nk’amatoni 37.500.</char></note> z’ifeza, ubutare bwinshi bw’umwakaka n’ivyuma vyinshi bitoharurika, n’ibiti n’amabuye. Kandi ushobora kwongerako n’ibindi. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />Ufise abakozi benshi: ababaza amabuye, abubakisha amabuye n’abubakisha ibiti n’imbaho, n’abahinga mu gikorwa ico ari co cose <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />mu nzahabu no mw’ifeza, umwakaka n’ivyuma; abacuzi barenze igitigiri. Nuko shirako wubake, kandi <char style="nd">Uhoraho</char> ari kumwe nawe.”<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />Maze Dawidi ategeka abatwara abandi mu Bisirayeli gufasha umuhungu wiwe Salomo. <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />Arababwira ati: “Mbega <char style="nd">Uhoraho</char> Imana yanyu ntari kumwe namwe? Ntiyanabemereye kubaha impore impande zose? Kuko yampaye abantu bose baba muri iki gihugu, kandi iki gihugu cose kiri mu minwe y’<char style="nd">Uhoraho</char> n’abantu biwe. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />Nuko rero mushire imitima yanyu n’imishaha yanyu k’<char style="nd">Uhoraho</char> Imana yanyu. Mushireko mwubake Ingoro y’<char style="nd">Uhoraho</char> Imana, kugira ngo muzane Isandugu y’Isezerano y’<char style="nd">Uhoraho</char> n’ibikoresho vyera vy’Imana muri iyo Ngoro izokwubakirwa Izina ry’<char style="nd">Uhoraho</char>.”<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s1">Dawidi atunganya ivy’Abalewi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />Igihe Dawidi yari ashaje ageze mu zabukuru, yaciye yimika umuhungu wiwe Salomo ngo abe umwami w’Abisirayeli.<verse eid="1CH 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />Akoranya abakuru barongoye abandi mu Bisirayeli, hamwe n’abaherezi n’Abalewi. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />Abalewi bafise imyaka mirongo itatu n’iyirenga baraharurwa, maze igitigiri cabo bose gishika ku bantu ibihumbi mirongo itatu n’umunani. <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />Dawidi avuga ati: “Muri aba, ibihumbi mirongo ibiri na bine baze barongore abandi mu bikorwa vyo mu Ngoro y’<char style="nd">Uhoraho</char>, abandi ibihumbi bitandatu na bo baze babe abakuru n’abacamanza. <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />Ibihumbi bine baze bazezwe kurinda irembo maze ibindi bihumbi bine baze babe abo guhimbaza <char style="nd">Uhoraho</char> n’ibicurarangisho nateguye ku bw’ico gikorwa.”<verse eid="1CH 23:5" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="6" style="v" sid="1CH 23:6" />Dawidi aca agabura Abalewi mu migwi nk’uko bene Lewi bari bari: Gerishoni, Kohati na Merari.<verse eid="1CH 23:6" /></para>
  <para style="s1">Abagerishoni</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7" />Abo mu Bagerishoni bari:</para>
  <para style="li2" vid="1CH 23:7">Ladani na Shimeyi.<verse eid="1CH 23:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8" />Bene Ladani ni:</para>
  <para style="li2" vid="1CH 23:8">umukuru wabo Yehiyeli, Zetamu na Yoweli, bose hamwe bari batatu.<verse eid="1CH 23:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9" />Bene Shimeyi ni:</para>
  <para style="li2" vid="1CH 23:9">Shelomoti, Haziyeli na Harani, bose hamwe bari batatu.</para>
  <para style="li2" vid="1CH 23:9">Abo ni bo bari abakuru b’inzu mu muryango wa Ladani.<verse eid="1CH 23:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10" />Kandi bene Shimeyi bari:</para>
  <para style="li2" vid="1CH 23:10">Yahati, Ziza, Yewushi na Beriya.</para>
  <para style="li2" vid="1CH 23:10">Abo ni bo bari bene Shimeyi, bose bari bane.<verse eid="1CH 23:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11" />Yahati yari imfura Ziza akaba uwa kabiri, ariko Yewushi na Beriya ntibavyaye abahungu benshi; ni co gituma baharuwe nk’umuryango umwe bahabwa n’igikorwa kimwe.<verse eid="1CH 23:11" /></para>
  <para style="s1">Abakohati</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12" />Bene Kohati ni:</para>
  <para style="li2" vid="1CH 23:12">Amuramu, Izihari, Heburoni na Uziyeli, bose bari bane.<verse eid="1CH 23:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13" />Bene Amuramu ni:</para>
  <para style="li2" vid="1CH 23:13">Aroni na Mose.</para>
  <para style="li2" vid="1CH 23:13">Aroni aratoranywa, we n’uruvyaro rwiwe ibihe bidashira, ngo bazezwe ibintu vyose vyejejwe, bashikane ibimazi imbere y’<char style="nd">Uhoraho</char>, bakorere imbere yiwe bongere bahezagire abantu mw’izina ryiwe ibihe bidashira. <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />Bene Mose umuntu w’Imana baharuwe nk’abo mu muryango wa Lewi.<verse eid="1CH 23:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15" />Bene Mose ni:</para>
  <para style="li2" vid="1CH 23:15">Gerishomu na Eliyezeri.<verse eid="1CH 23:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16" />Abo mu ruvyaro rwa Gerishomu:</para>
  <para style="li2" vid="1CH 23:16">umukuru wabo yari Shubayeli.<verse eid="1CH 23:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17" />Abakomoka kuri Eliyezeri:</para>
  <para style="li2" vid="1CH 23:17">umukuru wabo yari Rehabiya.</para>
  <para style="li2" vid="1CH 23:17">Eliyezeri nta bahungu yari afise, ariko bene Rehabiya bari benshi.<verse eid="1CH 23:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18" />Bene Izihari:</para>
  <para style="li2" vid="1CH 23:18">umukuru wabo yari Shelomiti.<verse eid="1CH 23:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19" />Bene Heburoni:</para>
  <para style="li2" vid="1CH 23:19">umukuru yari Yeriya, uwa kabiri akaba Amariya, uwa gatatu akaba Yahaziyeli, uwa kane akaba Yekameyamu.<verse eid="1CH 23:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20" />Bene Uziyeli:</para>
  <para style="li2" vid="1CH 23:20">umukuru wabo yari Mika, Isihiya akaba uwa kabiri.<verse eid="1CH 23:20" /></para>
  <para style="s1">Abamerari</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21" />Bene Merari:</para>
  <para style="li2" vid="1CH 23:21">Mahuli na Mushi.</para>
  <para style="li1" vid="1CH 23:21">Bene Mahuli:</para>
  <para style="li2" vid="1CH 23:21">Eliyazeri na Kishi.<verse eid="1CH 23:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22" />Eliyazeri yapfuye ata bahungu avyaye: yari afise abakobwa gusa. Bene sewabo, bene Kishi, ni bo babarongoye.<verse eid="1CH 23:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23" />Bene Mushi:</para>
  <para style="li2" vid="1CH 23:23">Mahuli, Ederi na Yeremoti, bose bari batatu.<verse eid="1CH 23:23" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="24" style="v" sid="1CH 23:24" />Abo ni bo bakomoka kuri Lewi nk’uko amazu yabo yari ari: abakuru b’amazu bari banditswe hakurikijwe urutonde rw’amazina yabo. Umuntu wese yaharuwe yaba amaze imyaka mirongo ibiri canke irenga kugira ngo akore mu ngoro y’<char style="nd">Uhoraho</char>. <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />Kuko Dawidi yari yaravuze ati: “Ko <char style="nd">Uhoraho</char>, Imana y’Abisirayeli, yemeye guha impore abantu biwe kandi ko yaje akaba i Yerusalemu ibihe vyose, <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />Abalewi ntibagikeneye kurerura ihema canke ibikoresho na bimwe bikoreshwa muri ryo.” <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />Nk’uko vyari vyarashinzwe na Dawidi mu misi yiwe ya nyuma, Abalewi bari baharuwe kuva ku bamaze imyaka mirongo ibiri n’iyirenga.<verse eid="1CH 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28" />Ico Abalewi bari bashinzwe kwari ugufasha bene Aroni mu bikorwa vyo mu ngoro y’<char style="nd">Uhoraho</char>: ibikorwa vyo mu rugo, ivyo mu vyumba, guhumanura ivyera vyose no gutunganya ibindi bikorwa vyo mu Ngoro y’Imana. <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />Bari bashinzwe ya mikate yategerezwa kwama ishirwa ku meza, ifu y’indobanurwa itangwako amashikanwa y’ifu, imitsima itarimwo umwambiro, gukaranga no kuvanga, hamwe no gupima urugero rw’ikintu cose. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />Bategerezwa guhagarara uko bukeye bashimira <char style="nd">Uhoraho</char> bamuhimbaza no ku mugoroba bagakora uko nyene, <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />n’igihe cose abantu baje gushikanira <char style="nd">Uhoraho</char> ibimazi vyo guturirwa ku masabato no ku misi mikuru y’ukwezi gutashe hamwe no ku misi mikuru yashinzwe. Bategerezwa gukorera imbere y’<char style="nd">Uhoraho</char> ubudasiba hakurikijwe igitigiri c’abakenewe muri bo kandi nk’uko bari bategetswe kubikora.<verse eid="1CH 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32" />Uko ni ko Abalewi bakora ivyo bashinzwe gukora mw’Ihema ry’Ibonaniro, ivyerekeye Ahera, barongowe n’ab’iwabo bo mu ruvyaro rwa Aroni, bagakora ivyo mu Ngoro y’<char style="nd">Uhoraho</char>.<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s1">Imice y’Abaherezi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />Iyi ni yo mice y’uruvyaro rwa Aroni:</para>
  <para style="p" vid="1CH 24:1">Bene Aroni bari Nadabu, Abihu, Eliyazeri na Itamari. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />Ariko Nadabu na Abihu batanze se gupfa, kandi nta bahungu basize. Nuko Eliyazeri na Itamari baciye bakora nk’abaherezi. <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />Dawidi abashira mu migwi yisunze ivyo bazokora n’urutonde bari bakwiye gukorerako, afashijwe na Sadoki akomoka kuri Eliyazeri na Ahimeleki akomoka kuri Itamari. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />Abarongozi benshi bavuye mu ruvyaro rwa Eliyazeri kuruta abavuye mu rwa Itamari, maze bashirwa mu migwi bisunze ico nyene: abakuru b’amazu bava mu bakomoka kuri Eliyazeri bari cumi na batandatu, hanyuma abakuru b’amazu bava ku bakomoka kuri Itamari bari umunani. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />Babagabuye mu migwi y’ibikorwa batarenganije n’umwe kuko bakoresheje ubupfindo. Ivyo vyatumwe n’uko hariho benshi bari babereye gukora mu Ingoro y’Imana bava mu bakomoka kuri Eliyazeri na Itamari bompi.<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />Umwanditsi Shemaya mwene Netaneli Umulewi, yanditse amazina yabo ari imbere y’umwami n’abakuru bose: Sadoki umuherezi, Ahimeleki mwene Abiyatari n’abakuru b’amazu y’abaherezi n’Abalewi, bagafata umwe wo mu nzu kwa Eliyazeri hanyuma uwundi wo mu nzu kwa Itamari.<verse eid="1CH 24:6" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7" />Ubupfindo bwa mbere bwerekanye Yehoyaribu,</para>
  <para style="li1" vid="1CH 24:7">ubwa kabiri bwerekanye Yedayiya,<verse eid="1CH 24:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8" />ubwa gatatu bwerekanye Harimu,</para>
  <para style="li1" vid="1CH 24:8">ubwa kane bwerekanye Seyorimu,<verse eid="1CH 24:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9" />ubwa gatanu bwerekanye Malikiya,</para>
  <para style="li1" vid="1CH 24:9">ubwa gatandatu bwerekanye Miyamini,<verse eid="1CH 24:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10" />ubw’indwi bwerekanye Hakozi,</para>
  <para style="li1" vid="1CH 24:10">ubw’umunani bwerekanye Abiya,<verse eid="1CH 24:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11" />ubw’icenda bwerekanye Yesuwa,</para>
  <para style="li1" vid="1CH 24:11">ubw’icumi bwerekanye Shekaniya,<verse eid="1CH 24:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12" />ubw’icumi na rimwe bwerekanye Eliyashibu,</para>
  <para style="li1" vid="1CH 24:12">ubw’icumi na kabiri bwerekanye Yakimu,<verse eid="1CH 24:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13" />Ubw’icumi na gatatu bwerekanye Hupa,</para>
  <para style="li1" vid="1CH 24:13">ubw’icumi na kane bwerekanye Yeshebeyabu,<verse eid="1CH 24:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14" />ubw’icumi na gatanu bwerekanye Biluga,</para>
  <para style="li1" vid="1CH 24:14">ubw’icumi na gatandatu bwerekanye Imeri,<verse eid="1CH 24:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15" />ubw’icumi n’indwi bwerekanye Heziri,</para>
  <para style="li1" vid="1CH 24:15">ubw’icumi n’umunani bwerekanye Hapizezi,<verse eid="1CH 24:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16" />ubw’icumi n’icenda bwerekanye Petahiya,</para>
  <para style="li1" vid="1CH 24:16">ubwa mirongo ibiri bwerekanye Yehezikeli,<verse eid="1CH 24:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17" />ubwa mirongo ibiri na rimwe bwerekanye Yakini,</para>
  <para style="li1" vid="1CH 24:17">ubwa mirongo ibiri na kabiri bwerekanye Gamuli,<verse eid="1CH 24:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18" />ubwa mirongo ibiri na gatatu bwerekanye Delaya,</para>
  <para style="li1" vid="1CH 24:18">ubwa mirongo ibiri na kane bwerekanye Mayaziya.<verse eid="1CH 24:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />Urwo ni rwo rutonde bakurikiza mu gukora igikorwa c’Imana iyo baramukiwe kwinjira mu ngoro y’<char style="nd">Uhoraho</char>, bisunze amategeko yabagenga yashizweho na sekuru wabo Aroni kandi nk’uko <char style="nd">Uhoraho</char>, Imana y’Abisirayeli, yari yaramutegetse.<verse eid="1CH 24:19" /></para>
  <para style="s1">Abakuru b’imiryango y’Abalewi</para>
  <para style="lh">
    <verse number="20" style="v" sid="1CH 24:20" />Aba ni bo bandi bakuru b’imiryango yakomoka kuri Lewi:</para>
  <para style="b" vid="1CH 24:20" />
  <para style="li1" vid="1CH 24:20">Mu bakomoka kuri Amuramu: umukuru wabo yari Shubayeli;</para>
  <para style="li2" vid="1CH 24:20">mu bakomoka kuri Shubayeli: umukuru wabo yari Yehudeya.<verse eid="1CH 24:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21" />Mu bakomoka kuri Rehabiya, abavuye ku bahungu biwe: umukuru wabo yari Isihiya.<verse eid="1CH 24:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22" />Mu bakomoka kuri Izihari: umukuru wabo yari Shelomoti;</para>
  <para style="li2" vid="1CH 24:22">mu bakomoka kuri Shelomoti: umukuru wabo yari Yahati.<verse eid="1CH 24:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23" />Mu bakomoka kuri Heburoni:</para>
  <para style="li2" vid="1CH 24:23">Yeriya ni we yari mukuru, uwa kabiri ni Amariya, uwa gatatu ni Yahaziyeli, uwa kane na we ni Yekamiyami.<verse eid="1CH 24:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24" />Mu bakomoka kuri Uziyeli: umukuru wabo yari Mika;</para>
  <para style="li2" vid="1CH 24:24">mu bakomoka kuri Mika: umukuru wabo yari Shamiri.<verse eid="1CH 24:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 24:25" />Umuvukanyi wa Mika: yari Isihiya.</para>
  <para style="li2" vid="1CH 24:25">Mu bamukomokako, Zakariya ni we yari mukuru.<verse eid="1CH 24:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26" />Mu bakomoka kuri Merari: abakuru babo bari Mahuli na Mushi.</para>
  <para style="li2" vid="1CH 24:26">Mu bakomoka kuri Yayaziya: umukuru wabo yari Beno.<verse eid="1CH 24:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27" />Mu bakomoka kuri Merari:</para>
  <para style="li2" vid="1CH 24:27">Kuva kuri Yayaziya: abakuru babo bari Beno, Shohamu, Zakuri na Iburi.<verse eid="1CH 24:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28" />Mu bakomoka kuri Mahuli: umukuru wabo yari Eliyazeri, naho atigeze aronka abahungu.<verse eid="1CH 24:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29" />Mu bakomoka kuri Kishi: umukuru wabo yari Yerahimeyeli.<verse eid="1CH 24:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30" />Ku bakomoka kuri Mushi: abakuru babo bari Mahuli, Ederi na Yerimoti.</para>
  <para style="b" vid="1CH 24:30" />
  <para style="lf" vid="1CH 24:30">Abo bari Abalewi, nk’uko imiryango yabo yari iri.<verse eid="1CH 24:30" /></para>
  <para style="b" />
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31" />Na ho nyene barakoresheje ubupfindo, nk’uko benewabo bakomoka kuri Aroni babikoze, imbere y’umwami Dawidi na Sadoki, Ahimeleki, n’abakuru b’amazu y’abaherezi n’Abalewi. Inzu zikomoka ku muvukanyi mukuru zafatwa co kimwe n’inzu zikomoka kuri mutoya muri bo.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s1">Abaririmvyi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />Dawidi, ari kumwe n’abakuru b’ingabo, atoranya bamwe muri bene Asafu, Hemani na Yedutuni ngo bakore igikorwa co kuvuga amajambo avuye ku Mana, bavugira inanga, amakembe n’ivyuma bisama. Uru ni rwo rutonde rw’abakora ico gikorwa:<verse eid="1CH 25:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2" />Mu bahungu ba Asafu hari:</para>
  <para style="li2" vid="1CH 25:2">Zakuri, Yosefu, Netaniya na Asarela. Bene Asafu bari barongowe na se Asafu, yavuga amajambo avuye ku Mana akurikije amategeko y’umwami.<verse eid="1CH 25:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3" />Mu bahungu ba Yedutuni, hari:</para>
  <para style="li2" vid="1CH 25:3">Gedaliya, Zeri, Yeshaya, Shimeyi, Hashabiya na Matitiya, bose hamwe bari batandatu, barongowe na se Yedutuni, yavuga amajambo y’Imana, avuza inanga mu gushimira no mu guhimbaza <char style="nd">Uhoraho</char>.<verse eid="1CH 25:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4" />Mu bahungu ba Hemani hari:</para>
  <para style="li2" vid="1CH 25:4">Bukiya, Mataniya, Uziyeli, Shubayeli na Yerimoti; Hananiya, Hanani, Eliyata, Gidaliti na Romamuti-Ezeri; Yoshibekasha, Maloti, Hotiri na Mahaziyoti. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />Abo bose bari bene Hemani uwerekwa w’umwami. Imana yari yabamuhaye biciye mw’isezerano ngo imushire hejuru. Imana imuha abahungu icumi na bane n’abakobwa batatu.<verse eid="1CH 25:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6" />Abo bose bari barongowe na ba se babo mu kuririmba no mu gucuraranga mu ngoro y’<char style="nd">Uhoraho</char>, bakoresheje ivyuma bisama, amakembe n’inanga, ku bw’ico gikorwa co mu Ngoro y’Imana.</para>
  <para style="p" vid="1CH 25:6">Asafu, Yedutuni na Hemani bari musi y’uburongozi bw’umwami. <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />Abo bari kumwe n’abo mu nzu zabo, bose bari barigishijwe bongera bamenyerezwa ivyerekeye kuririmbira <char style="nd">Uhoraho</char>, bashika amajana abiri na mirongo umunani n’umunani. <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />Abacuraranga bose bashirwa ku bikorwa vyabo hakoreshejwe ubupfindo, ntibaraba ngo umuntu aracari muto canke arakuze, ni umwigisha canke ni umwigishwa.<verse eid="1CH 25:8" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9" />Ubupfindo bwa mbere bwerekanye Yosefu wo mu nzu kwa Asafu,</para>
  <para style="li2" vid="1CH 25:9">abahungu biwe hamwe na benewabo, baba cumi na babiri.</para>
  <para style="li1" vid="1CH 25:9">Ubupfindo bwa kabiri bwerekana Gedaliya,</para>
  <para style="li2" vid="1CH 25:9">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10" />Ubupfindo bwa gatatu bwerekana Zakuri,</para>
  <para style="li2" vid="1CH 25:10">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11" />Ubupfindo bwa kane bwerekana Iziri,</para>
  <para style="li2" vid="1CH 25:11">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12" />Ubupfindo bwa gatanu bwerekana Netaniya,</para>
  <para style="li2" vid="1CH 25:12">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13" />Ubupfindo bwa gatandatu bwerekana Bukiya,</para>
  <para style="li2" vid="1CH 25:13">abahungu biwe hamwe na benewabo baba cumi na babiri.<verse eid="1CH 25:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14" />Ubupfindo bw’indwi bwerekana Yesarela,</para>
  <para style="li2" vid="1CH 25:14">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15" />Ubupfindo bw’umunani bwerekana Yeshaya,</para>
  <para style="li2" vid="1CH 25:15">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16" />Ubupfindo bw’icenda bwerekana Mataniya,</para>
  <para style="li2" vid="1CH 25:16">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17" />Ubupfindo bw’icumi bwerekana Shimeyi,</para>
  <para style="li2" vid="1CH 25:17">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18" />Ubupfindo bwa cumi na rimwe bwerekana Azareli,</para>
  <para style="li2" vid="1CH 25:18">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19" />Ubupfindo bwa cumi na kabiri bwerekana Hashabiya,</para>
  <para style="li2" vid="1CH 25:19">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20" />Ubupfindo bwa cumi na gatatu bwerekana Shubayeli,</para>
  <para style="li2" vid="1CH 25:20">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21" />Ubupfindo bwa cumi na kane bwerekana Matitiya,</para>
  <para style="li2" vid="1CH 25:21">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22" />Ubupfindo bwa cumi na gatanu bwerekana Yeremoti,</para>
  <para style="li2" vid="1CH 25:22">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23" />Ubupfindo bwa cumi na gatandatu bwerekana Hananiya,</para>
  <para style="li2" vid="1CH 25:23">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24" />Ubupfindo bwa cumi n’indwi bwerekana Yoshibekasha,</para>
  <para style="li2" vid="1CH 25:24">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25" />Ubupfindo bwa cumi n’umunani bwerekana Hanani,</para>
  <para style="li2" vid="1CH 25:25">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26" />Ubupfindo bwa cumi n’icenda bwerekana Maloti,</para>
  <para style="li2" vid="1CH 25:26">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27" />Ubupfindo bwa mirongo ibiri bwerekana Eliyata,</para>
  <para style="li2" vid="1CH 25:27">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28" />Ubupfindo bwa mirongo ibiri na rimwe bwerekana Hotiri,</para>
  <para style="li2" vid="1CH 25:28">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29" />Ubupfindo bwa mirongo ibiri na kabiri bwerekana Gidaliti,</para>
  <para style="li2" vid="1CH 25:29">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30" />Ubupfindo bwa mirongo ibiri na gatatu bwerekana Mahaziyoti,</para>
  <para style="li2" vid="1CH 25:30">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31" />Ubupfindo bwa mirongo ibiri na kane bwerekana Romamuti-Ezeri,</para>
  <para style="li2" vid="1CH 25:31">abahungu biwe hamwe na benewabo, baba cumi na babiri.<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s1">Abarinzi b’irembo</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 26:1" />Imigwi y’abarinzi b’irembo:</para>
  <para style="b" vid="1CH 26:1" />
  <para style="lh" vid="1CH 26:1">Mu bakomoka kuri Kora hari</para>
  <para style="li1" vid="1CH 26:1">Meshelemiya umuhungu wa Kore, umwe muri bene Abiyasafu. <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" />Abahungu ba Meshelemiya bari:</para>
  <para style="li2" vid="1CH 26:2">Zakariya imfura, Yediyayeli uwa kabiri,</para>
  <para style="li2" vid="1CH 26:2">Zebadiya uwa gatatu, Yatuniyeli uwa kane,<verse eid="1CH 26:2" /></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3" />Elamu uwa gatanu, Yehohanani uwa gatandatu</para>
  <para style="li2" vid="1CH 26:3">na Eliyehowenayi uw’indwi.<verse eid="1CH 26:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4" />Abahungu ba Obedi-Edomu na bo nyene bari abarinzi b’irembo:</para>
  <para style="li2" vid="1CH 26:4">Shemaya imfura, Yehozabadi uwa kabiri,</para>
  <para style="li2" vid="1CH 26:4">Yowa uwa gatatu, Sakari uwa kane,</para>
  <para style="li2" vid="1CH 26:4">Netaneli uwa gatanu, <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />Amiyeli uwa gatandatu,</para>
  <para style="li2" vid="1CH 26:5">Isakari uw’indwi na Pewuletayi uw’umunani.</para>
  <para style="li2" vid="1CH 26:5">Imana yari yarahaye umugisha mwinshi Obedi-Edomu.<verse eid="1CH 26:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6" />Shemaya mwene Obedi-Edomu na we nyene yari afise abahungu, bari abakuru mu mazu y’abakomoka kuri se kuko bari abantu babishoboye. <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />Bene Shemaya bari:</para>
  <para style="li2" vid="1CH 26:7">Otini, Refayeli, Obedi na Elizabadi; hamwe na benewabo Elihu na Semakiya na bo nyene bari abantu babishoboye.<verse eid="1CH 26:7" /></para>
  <para style="lf">
    <verse number="8" style="v" sid="1CH 26:8" />Abo bose bari abakomoka kuri Obedi-Edomu; bo ubwabo, abahungu babo n’abuzukuru babo, bari abantu bashoboye b’inkomezi zo gukora ico gikorwa; bose hamwe abakomoka kuri Obedi-Edomu, bari mirongo itandatu na babiri.<verse eid="1CH 26:8" /></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 26:9" />Abahungu ba Meshelemiya n’abo mu nzu yiwe bose babakomokako, bari bashoboye, bose hamwe bari cumi n’umunani.<verse eid="1CH 26:9" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10" />Hosa akomoka mu nzu kwa Merari yari afise abahungu:</para>
  <para style="li2" vid="1CH 26:10">Umukuru wabo yari Shimuri naho atari we yari imfura, se wiwe yari yamutoye ngo abe uwa mbere,<verse eid="1CH 26:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 26:11" />Hilukiya uwa kabiri, Tabaliya uwa gatatu na</para>
  <para style="li2" vid="1CH 26:11">Zakariya uwa kane.</para>
  <para style="lf" vid="1CH 26:11">Abahungu ba Hosa n’abo mu nzu yiwe bose babakomokako bakora igikorwa co kurinda irembo bari icumi na batatu.<verse eid="1CH 26:11" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="12" style="v" sid="1CH 26:12" />Iyo migwi y’abarinzi b’irembo, biciye mu bakuru babo, bari bafise ibikorwa vyo gukorera mu ngoro y’<char style="nd">Uhoraho</char>, nk’uko benewabo bandi b’Abalewi babikora. <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />Abakora kw’irembo ryose batorwa hakoreshejwe ubupfindo, bataravye umuto canke umukuru, bakurikiza inzu zabo gusa.<verse eid="1CH 26:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 26:14" />Ubupfindo bw’abarinda Irembo ryo mu Buseruko bwerekanye Shelemiya n’abo bari kumwe.</para>
  <para style="li1" vid="1CH 26:14">Maze bakora ubundi bupfindo bwerekana umuhungu wiwe Zakariya azezwa irembo ryo mu buraruko, yari umujenama w’umunyabwenge.<verse eid="1CH 26:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 26:15" />Ubupfindo bw’abarinda Irembo ryo mu Bumanuko bwerekana Obedi-Edomu, kandi ubupfindo bwo kwerakana abarinda inzu y’ububiko bwerekana abahungu biwe.<verse eid="1CH 26:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 26:16" />Ubufindo bw’abarinda Irembo ryo mu Burengero no kw’Irembo rya Shaleketi ku nzira iduga bwerekana Shupimu na Hosa.</para>
  <para style="b" vid="1CH 26:16" />
  <para style="lh" vid="1CH 26:16">Abarinzi bagenwa hakurikijwe ingene aho bakorera hahambaye:<verse eid="1CH 26:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 26:17" />Hari Abalewi batandatu ku musi kw’Irembo ryo mu Buseruko,</para>
  <para style="li1" vid="1CH 26:17">bane ku musi kw’Irembo ryo mu Buraruko,</para>
  <para style="li1" vid="1CH 26:17">bane ku musi kw’Irembo ryo mu Bumanuko</para>
  <para style="li1" vid="1CH 26:17">na babiribabiri bakorera rimwe ku nzu y’ububiko.<verse eid="1CH 26:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 26:18" />Kw’Irembo ryo mu Burengero hari abarinzi babiri n’abandi bane barinda inzira yaca inyuma y’urugo.<verse eid="1CH 26:18" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="19" style="v" sid="1CH 26:19" />Iyo yari imigwi y’abarinzi b’irembo bakomoka ku mazu ya Kora na Merari.<verse eid="1CH 26:19" /></para>
  <para style="s1">Abanyabigega n’abandi bakuru</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />Uwundi mugwi w’Abalewi, urongowe na Ahiya, wari uw’abanyabigega b’ubutunzi bwo mu Ngoro y’Imana n’ubutunzi bw’ibintu vyeguriwe Imana.<verse eid="1CH 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21" />Abakomoka kuri Ladani, wo mu nzu kwa Gerishoni bari abakuru b’amazu kandi umukuru wabo yari Yehiyeli, <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />abahungu ba Yehiyeli ari bo Zetamu n’uwo bavukana Yoweli, bari bajejwe ubutunzi bwo mu ngoro y’<char style="nd">Uhoraho</char>.<verse eid="1CH 26:22" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="23" style="v" sid="1CH 26:23" />Aba ni bo bari abakuru mu mazu y’abakomoka kuri Amuramu, Izihari, Heburoni na Uziyeli:<verse eid="1CH 26:23" /></para>
  <para style="b" />
  <para style="li2">
    <verse number="24" style="v" sid="1CH 26:24" />Mu bakomoka mu nzu kwa Amuramu, Shubayeli akomoka kuri Gerishomu mwene Mose, yari umukuru ajejwe ubutunzi. <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />Abo mu muryango wiwe uciye kuri Eliyezeri bari: Rehabiya, Yeshaya, Yoramu, Zikuri na Shelomoti.<verse eid="1CH 26:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 26:26" />Shelomoti n’abo mu muryango wiwe bari bajejwe ubutunzi bwose bw’ibintu umwami Dawidi, abakuru b’imiryango batwara ingabo igihumbi n’abatwara ingabo ijana, n’abandi bakuru b’ingabo bari bareguriye Imana. <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />Bimwe mu vyanyazwe mu gihe c’intambara vyari vyeguriwe gusanura ingoro y’<char style="nd">Uhoraho</char>. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />N’ibintu vyose Samweli uwerekwa, Sawuli mwene Kishi, Abuneri mwene Neri, Yowabu mwene Zeruwiya, n’abandi bose bari bareguriye Imana vyari bijejwe Shelomoti n’abo mu nzu yiwe.<verse eid="1CH 26:28" /></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 26:29" />Mu bakomoka mu nzu kwa Izihari:</para>
  <para style="li2" vid="1CH 26:29">Kenaniya n’abahungu biwe bari bashinzwe ibikorwa bitajanye n’Ingoro, bari abakuru bajejwe ubucamanza mu Bisirayeli.<verse eid="1CH 26:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 26:30" />Mu bakomoka mu nzu kwa Heburoni:</para>
  <para style="li2" vid="1CH 26:30">Hashabiya we n’abo mu muryango wiwe; abagabo igihumbi n’amajana indwi bashoboye, bari bajejwe Abisirayeli baba mu burengero bwa Yorodani, mu gikorwa cose c’<char style="nd">Uhoraho</char> n’igikorwa cose kiraba uwami muri ako karere. <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />Kandi mu bakomoka mu nzu kwa Heburoni na bo, hari Yeriya akaba umukuru wabo nk’uko vyanditswe mu bitabu bidondagura ingene bagiye bararondoka.</para>
  <para style="li2" vid="1CH 26:31">Mu mwaka ugira mirongo ine Dawidi ari ku ngoma, harabaye kurondera mu vyanditswe, basanga harimwo abagabo bashoboye mu bakomoka kuri Heburoni b’i Yazeri i Gileyadi. <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />Yeriya yari afise abantu ibihumbi bibiri n’amajana indwi, bari abagabo bashoboye bakaba abakuru b’inzu zigize umuryango, kandi umwami Dawidi abazeza Abareyubeni, Abagadi n’igice c’Abamanase mu kintu cose cerekeye Imana n’icerekeye umwami mu buseruko bwa Yorodani.<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s1">Imice y’ingabo</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 27:1" />Uru ni rwo rutonde rw’Abisirayeli, bari abakuru b’amazu, abakuru b’ingabo igihumbi, abakuru b’ingabo ijana, n’abakuru batwara abandi, bakorera umwami mu bijanye n’imice y’ingabo baramukirwa gukora uko ukwezi gutashe mu mwaka wose. Umuce wose waba ugizwe n’ingabo ibihumbi mirongo ibiri na bine.<verse eid="1CH 27:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2" />Yashobeyamu mwene Zabudiyeli ni we yari ajejwe umuce wa mbere, wari ujejwe gukora mu kwezi kwa mbere. Mu muce wiwe harimwo ingabo ibihumbi mirongo ibiri na bine. <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />Yari uwo mu ruvyaro rwa Perezi kandi yari umukuru yatwara abakuru mu ngabo bajejwe gukora mu kwezi kwa mbere.<verse eid="1CH 27:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4" />Dodayi Umwahohi ni we yari ajejwe umuce wo mu kwezi kwa kabiri; Mikiloti ni we yari umukuru w’uwo muce. Uwo muce wari ugizwe n’ingabo ibihumbi mirongo ibiri na bine.<verse eid="1CH 27:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5" />Umukuru w’ingabo agira gatatu, yari ajejwe ukwezi kwa gatatu, yari Benaya mwene Yehoyada umuherezi. Yari umukuru kandi umuce wiwe warimwo ingabo ibihumbi mirongo ibiri na bine. <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />Uwo Benaya ni we yari umuhizi muri bamwe mirongo itatu kandi ni we yari umukuru wabo. Umuhungu wiwe Amizabadi yari ajejwe uwo muce wa se.<verse eid="1CH 27:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7" />Umukuru w’ingabo agira kane, yari ajejwe gukora mu kwezi kwa kane, yari Asaheli yavukana na Yowabu; umuhungu wiwe Zebadiya ni we yamusubiriye. Mu muce wiwe harimwo ingabo ibihumbi mirongo ibiri na bine.<verse eid="1CH 27:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8" />Umukuru w’ingabo agira gatanu, yari ajejwe ukwezi kwa gatanu, yari Shamuhuti Umwizirahi. Umuce wiwe warimwo ingabo ibihumbi mirongo ibiri na bine.<verse eid="1CH 27:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9" />Umukuru w’ingabo agira gatandatu, yari ajejwe ukwezi kwa gatandatu, yari Ira mwene Ikeshi w’i Tekowa. Mu muce wiwe harimwo ingabo ibihumbi mirongo ibiri na bine.<verse eid="1CH 27:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10" />Umukuru w’ingabo agira indwi, yari ajejwe ukwezi kw’indwi, yari Helezi Umupeloni, Umwefurayimu. Mu muce wiwe harimwo ingabo ibihumbi mirongo ibiri na bine.<verse eid="1CH 27:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11" />Umukuru w’ingabo agira umunani, yari ajejwe ukwezi kw’umunani, yari Sibekayi Umuhushati w’Umuzera. Mu muce wiwe harimwo ingabo ibihumbi mirongo ibiri na bine.<verse eid="1CH 27:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12" />Umukuru w’ingabo agira icenda, yari ajejwe ukwezi kw’icenda, yari Abiyezeri Umwanatoti, w’Umubenyamini. Mu muce wiwe harimwo ingabo ibihumbi mirongo ibiri na bine.<verse eid="1CH 27:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13" />Umukuru w’ingabo agira icumi, yari ajejwe ukwezi kw’icumi, yari Maharayi Umunetofati, w’Umuzera. Mu muce wiwe harimwo ingabo ibihumbi mirongo ibiri na bine.<verse eid="1CH 27:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14" />Umukuru w’ingabo agira icumi na rimwe, yari ajejwe ukwezi kw’icumi na rimwe, yari Benaya Umupiratoni, w’Umwefurayimu. Mu muce wiwe harimwo ingabo ibihumbi mirongo ibiri na bine.<verse eid="1CH 27:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15" />Umukuru w’ingabo agira icumi na kabiri, yari ajejwe ukwezi kw’icumi na kabiri, yari Heludayi Umunetofati, wo mu muryango wa Otiniyeli. Mu muce wiwe harimwo ingabo ibihumbi mirongo ibiri na bine.<verse eid="1CH 27:15" /></para>
  <para style="s1">Abakuru mu miryango y’Abisirayeli</para>
  <para style="lh">
    <verse number="16" style="v" sid="1CH 27:16" />Abari abakuru b’imiryango y’Abisirayeli ni aba:</para>
  <para style="b" vid="1CH 27:16" />
  <para style="li1" vid="1CH 27:16">Mu bakomoka kuri Reyubeni: Eliyezeri mwene Zikuri;</para>
  <para style="li1" vid="1CH 27:16">mu bakomoka kuri Simeyoni: Shefatiya mwene Mayaka;<verse eid="1CH 27:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17" />mu bakomoka kuri Lewi: Hashabiya mwene Kemuweli;</para>
  <para style="li1" vid="1CH 27:17">mu bakomoka kuri Aroni: Sadoki;<verse eid="1CH 27:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18" />mu bakomoka kuri Yuda: Elihu, yavukana na Dawidi;</para>
  <para style="li1" vid="1CH 27:18">mu bakomoka kuri Isakari: Omuri mwene Mikayeli;<verse eid="1CH 27:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19" />mu bakomoka kuri Zebuloni: Ishimaya mwene Obadiya;</para>
  <para style="li1" vid="1CH 27:19">mu bakomoka kuri Nafutali: Yerimoti mwene Aziriyeli;<verse eid="1CH 27:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20" />mu bakomoka kuri Efurayimu: Hoseya mwene Azaziya;</para>
  <para style="li1" vid="1CH 27:20">mu bakomoka ku gice c’umuryango wa Manase: Yoweli mwene Pedaya;<verse eid="1CH 27:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21" />mu bakomoka ku gice c’umuryango wa Manase kindi c’i Gileyadi: Ido mwene Zakariya;</para>
  <para style="li1" vid="1CH 27:21">mu bakomoka kuri Benyamini: Yayasiyeli mwene Abuneri;<verse eid="1CH 27:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22" />mu bakomoka kuri Dani: Azareli mwene Yerohamu.</para>
  <para style="b" vid="1CH 27:22" />
  <para style="lf" vid="1CH 27:22">Abo ni bo bari abakuru batwara imiryango y’Abisirayeli.<verse eid="1CH 27:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />Igihe Dawidi yaharura abantu ntiyaharuyemwo abafise imyaka mirongo ibiri canke batarayishikana, kuko <char style="nd">Uhoraho</char> yari yarasezeranye ko azogwiza Abisirayeli ngo bangane n’inyenyeri zo kw’ijuru. <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />Yowabu mwene Zeruwiya atangura guharura abantu ariko ntiyaheza. Uburake buziriringira Abisirayeli kubera ukwo guharurwa, maze ico gitigiri nticandikwa mu gitabu c’ibigenda biraba c’umwami Dawidi.<verse eid="1CH 27:24" /></para>
  <para style="s1">Abari bajejwe ivyibare vy’umwami</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25" />Azimaveti mwene Adiyeli yari ajejwe amazu y’ububiko bw’umwami.</para>
  <para style="li1" vid="1CH 27:25">Yonatani mwene Uziya yari ajejwe amazu y’ububiko yari mu ntara, mu bisagara, mu bigwati no ku minara yo gucungererako.<verse eid="1CH 27:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26" />Ezuri mwene Kelubi yari ajejwe abakozi bo mu mirima barima mu matongo.<verse eid="1CH 27:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27" />Shimeyi w’i Ramati yari ajejwe imirima y’imizabibu.</para>
  <para style="li1" vid="1CH 27:27">Zabudi w’i Shifumi yari ajejwe umwimbu w’imizabibu n’ububiko bw’umuvinyu.<verse eid="1CH 27:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28" />Bayali-Hanani w’i Gederi yari ajejwe imyelayo n’imisukomora mu gice c’uburengero.</para>
  <para style="li1" vid="1CH 27:28">Yowashi yari ajejwe ububiko bw’amavuta ya elayo.<verse eid="1CH 27:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29" />Shiturayi w’i Sharoni yari ajejwe inka zarisha i Sharoni.</para>
  <para style="li1" vid="1CH 27:29">Shafati mwene Adulayi yari ajejwe amasho yo mu biyaya.<verse eid="1CH 27:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30" />Obili Umwishimayeli yari ajejwe ingamiya.</para>
  <para style="li1" vid="1CH 27:30">Yehudeya w’i Meronoti yari ajejwe indogoba.<verse eid="1CH 27:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31" />Yazizi Umuhaguri yari ajejwe imikuku y’impene n’intama.</para>
  <para style="lf" vid="1CH 27:31">Abo bose bari abakuru bajejwe ubutunzi bw’umwami Dawidi.<verse eid="1CH 27:31" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="32" style="v" sid="1CH 27:32" />Yonatani, sewabo wa Dawidi, yari umuhanuzi, umugabo w’ubwenge akaba n’umwanditsi.</para>
  <para style="li1" vid="1CH 27:32">Yehiyeli mwene Hakumoni yari ajejwe abahungu b’umwami.<verse eid="1CH 27:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 27:33" />Ahitofeli yari umuhanuzi w’umwami.</para>
  <para style="li1" vid="1CH 27:33">Hushayi umwaruki yari umugenzi w’umwami.<verse eid="1CH 27:33" /></para>
  <para style="lf">
    <verse number="34" style="v" sid="1CH 27:34" />Ahitofeli yasubiriwe na Yehoyada mwene Benaya na Abiyatari.</para>
  <para style="li1" vid="1CH 27:34">Yowabu yari umukuru w’ingabo z’umwami.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s1">Dawidi abwira abantu uko bazokwubaka ingoro y’<char style="nd">Uhoraho</char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />Dawidi ahamagaza abakuru bose bo mu Bisirayeli ngo bakoranire i Yerusalemu: Abakuru b’imiryango, abakuru barongora ingabo igihumbi n’abakuru barongora ingabo ijana, n’abakuru bajejwe itunga n’ibitungwa vy’umwami n’abahungu biwe, n’abakuru bakorera ku kirimba, abahambaye bose n’abahizi bo mu ntambara.<verse eid="1CH 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2" />Umwami Dawidi arahaguruka avuga ati: “Nimunyumvirize, bavukanyi mukaba n’abantu banje. Nari nariyumviriye mu mutima kwubaka inzu Isandugu y’Isezerano y’<char style="nd">Uhoraho</char> izoruhukiramwo, indava y’ibirenge vy’Imana yacu, kandi naragize integuro yo kuyubaka. <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />Ariko Imana irambwira iti: ‘Ntushobora kwubaka inzu yitirirwa izina ryanje, kuko wagwanye intambara nyinshi kandi ukavisha amaraso menshi.’<verse eid="1CH 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4" />Ariko <char style="nd">Uhoraho</char>, Imana y’Abisirayeli, yantoranije mu muryango wanje wose ngo mbe umwami w’Abisirayeli ibihe bidashira. Yatoranije Yuda nk’umukuru, maze mu muryango wa Yuda itoranya inzu yanje, kandi no mu bahungu ba data yahimbawe no kunyimika ngo mbe umwami w’Abisirayeli bose. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />Mu bahungu banje bose <char style="nd">Uhoraho</char> yampaye, kandi ni benshi, yatoranije umuhungu wanje Salomo ngo yicare ku ntebe y’ubwami bw’<char style="nd">Uhoraho</char> aganze Abisirayeli. <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />Yambwiye ati: Salomo umuhungu wawe ni we azonyubakira Ingoro aho nzovyagira, kuko ndamutoranije ngo ambere umuhungu, nanje ndamubere se. <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />Nzokomeza ubwami bwiwe ibihe vyose niyashira umutima ku kwumvira amateka n’ivyo nashinze, nk’uko bikorwa ubu.<verse eid="1CH 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8" />None rero ndabibasabiye imbere y’Abisirayeli bose n’ikoraniro ryose ry’<char style="nd">Uhoraho</char>, n’imbere y’Imana yacu ivyumva: muze mwitwararike kwumvira amabwirizwa y’<char style="nd">Uhoraho</char> Imana yanyu, kugira ngo muze mugumane iki gihugu ciza kandi ngo muze mukirage uruvyaro rwanyu ibihe bidashira.<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />Nawe, Salomo mwana wanje, menya Imana ya so, uyikorere n’umutima wawe wose kandi ubikunze, kuko <char style="nd">Uhoraho</char> asesa umutima wose kandi azi ivyo umuntu yiyumvira akagabira. Niwamurondera, uzomubona; ariko niwamutera ibitugu, na we azoguta ibihe vyose. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />Menya rero ibi, <char style="nd">Uhoraho</char> yaragutoranije ngo wubake Ingoro yiwe yera. Shikama ukore ico gikorwa.”<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />Nuko Dawidi aha umuhungu wiwe Salomo ya nteguro y’intangaro y’Ingoro, inyubako yayo, amazu y’ububiko bwayo, ibice vyo hejuru vyayo, ivyumba vy’imbere n’ikibanza co gutangiramwo impongano. <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />Amuha izo nteguro nk’uko Mpwemu yari yazishize mu bwenge bwiwe, harimwo izerekeye urugo rw’Ingoro y’<char style="nd">Uhoraho</char>, ivyumba birukikije, ivyumba vy’ububiko bw’Ingoro y’Imana n’ivyumba vy’ububiko bw’ivyagizwe inyegu. <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />Amubwira ivyo akwiye kwitondera vyerekeye imice y’abaherezi n’Abalewi, n’igikorwa cose co gukora mu Ngoro y’<char style="nd">Uhoraho</char>, n’ivyerekeye ibikoresho vyose bikoreshwa muri iyo Ngoro. <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />Ashinga n’uburemere bw’inzahabu buzokora ku bikoresho vyose vy’inzahabu bizokora mu bikorwa bitandukanye, n’uburemere bw’ifeza buzokora ku bikoresho vyose vy’ifeza bizokora mu bikorwa bitandukanye: <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />Uburemere bw’inzahabu zo mu biterekwako amatara no mu matara yavyo, uburemere bw’igiterekwako amatara kimwekimwe cose n’amatara yaco, n’uburemere bw’ifeza z’igiterekwako amatara c’ifeza kimwekimwe cose n’amatara yaco, bijanye n’ico igiterekwako amatara cose kizokora; <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />uburemere bw’inzahabu bw’imeza yose y’imikate yejejwe; n’uburemere z’ifeza z’imeza zindi; <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />uburemere bw’inzahabu ihinguwe neza y’ivyaruzo vy’amenyo, amabakure yo gusukira n’ibindi bikoresho bikozwe mu nzahabu ihinguwe neza; uburemere bw’inzahabu yokoreshwa kw’isahani y’inzahabu imw’imwe yose; uburemere bw’ifeza kw’isahani y’ifeza imw’imwe yose; <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />n’uburemere bw’inzahabu ihinguwe neza y’igicaniro baturirirako ibimota neza. Yarongeye amuha ishusho y’umukogote, ni ukuvuga abakerubi bacuzwe mu nzahabu bashanje amababa yabo bakayapfukisha ya Sandugu y’Isezerano y’<char style="nd">Uhoraho</char>.<verse eid="1CH 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19" />Dawidi aravuga ati: “Ivyo vyose biri mu gitabu naronse kivuye k’<char style="nd">Uhoraho</char>, ampa no gutahura ivyo vyose bikwiye gukorwa nk’uko biri muri iyi nteguro.”<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />Dawidi arongera abwira Salomo umwana wiwe ati: “Shikama ushire amanga, ukore ico gikorwa. Ntutinye canke ngo wihebure, kuko <char style="nd">Uhoraho</char> Imana, ari yo Mana yanje, iri kumwe nawe. Ntizoguta kandi ntizoguhemukira gushika aho igikorwa co kwubaka Ingoro y’<char style="nd">Uhoraho</char> kizoherera. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />Imice y’abaherezi n’Abalewi bariteguye gukora igikorwa co mu Ngoro y’Imana, n’umuntu wese avyishakiye afise ubuhinga mu kintu ico ari co cose azogufasha muri iki gikorwa. Abakuru n’abantu bose bazokwumvira mu co uzobategeka cose.”<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s1">Amashikanwa yo kwubaka Ingoro</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />Hanyuma umwami Dawidi abwira ikoraniro ryose ati: “Umuhungu wanje Salomo, ari we Imana yatoranije, aracari muto kandi ntabimenyereye cane. Igikorwa ni kinini, kandi iyi Ngoro si iy’umuntu ahubwo ni iy’<char style="nd">Uhoraho</char> Imana. <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />Nakoresheje inkomezi zanje zose mu gutegura ivyo kwubaka Ingoro y’Imana yanje: inzahabu zizokora ibikorwa vy’inzahabu, ifeza zizokoreshwa mu gukora ibikorwa vy’ifeza, imyakaka izokoreshwa mu gukora ibikorwa vy’imyakaka, ivyuma bizokoreshwa mu gukora ibikorwa bisaba ivyuma, n’ibiti bizokoreshwa mu gukora ibikorwa bisaba ibiti, n’amabuye azokoreshwa mu gukora ibikorwa bisaba amabuye yitwa onigisi yo gukora mu materanirizo, amabuye akayangana y’amabara atandukanye, n’ubwoko butandukanye bw’amabuye y’igiciro kinini hamwe na marubule; vyose ni vyinshi cane. <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />I ruhande y’ivyo, kubera ukwitangira Ingoro y’Imana yanje, ntanze ubutunzi bwanje bw’inzahabu n’ifeza ngo bibe ivy’iyo Ngoro y’Imana yanje, ndavyongeye kuri vya bindi vyose nateguriye kwubaka Ingoro y’Imana yanje birenze ku vyo nategekanije kubera iyo Ngoro yera: <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />Italanto ibihumbi bitatu<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">Ni nk’amatoni 110.</char></note> z’inzahabu zavuye muri Ofiru, n’iz’ifeza ibihumbi indwi<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">Ni nk’amatoni 260.</char></note> zihinguwe neza, zo guhomesha ku mpome y’iyo nyubakwa, <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />ivyo gukoreshwa mu gikorwa c’ifeza n’inzahabu, hamwe n’ibikorwa vyose bikwiye gukorwa n’abahinga. None rero ni nde agomba kwitanga uwu musi kubera <char style="nd">Uhoraho</char>?”<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />Maze abakuru b’imiryango igize Isirayeli, abakuru barongoye ingabo igihumbi n’abarongoye ingabo ijana, n’abakuru bashinzwe gukora i bwami batanga bavyishakiye. <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />Batanga ivyo gukoresha ku Ngoro y’Imana bingana n’italanto ibihumbi bitanu<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">Ni nk’amatoni 190.</char></note> na dariki ibihumbi cumi<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">Ni nk’ibilo 84.</char></note> vy’inzahabu, italanto ibihumbi cumi<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">Ni nk’amatoni 380.</char></note> z’ifeza, italanto ibihumbi cumi n’umunani<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">Ni nk’amatoni 675.</char></note> z’umwakaka n’italanto ibihumbi ijana<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">Ni nk’amatoni 3.800.</char></note> z’ivyuma. <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />Umuntu wese yari afise amabuye y’igiciro arayazana ngo aje mu bubiko bw’iyo Ngoro y’<char style="nd">Uhoraho</char> bwari bujejwe Yehiyeli Umugerishoni. <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />Abantu baranezerwa kuko abakuru babo bemeye gukora bavyishakiye, kuko bari bashikaniye <char style="nd">Uhoraho</char> ata gahato kandi n’umutima ubikunze. N’umwami Dawidi aranezerwa cane.<verse eid="1CH 29:9" /></para>
  <para style="s1">Isengesho rya Dawidi</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />Dawidi ahimbaza <char style="nd">Uhoraho</char> imbere y’ikoraniro ryose, avuga ati:</para>
  <para style="q1" vid="1CH 29:10">“Uhimbazwe, yewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="1CH 29:10">Imana ya sogokuru Isirayeli,</para>
  <para style="q2" vid="1CH 29:10">uhereye ibihe vyose ugashitsa ibihe vyose.<verse eid="1CH 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11" />Ubukuru n’ububasha ni ivyawe</para>
  <para style="q2" vid="1CH 29:11">n’ubwiza n’icubahiro n’igitinyiro,</para>
  <para style="q2" vid="1CH 29:11">kuko ibiri mw’ijuru no mw’isi vyose ari ivyawe.</para>
  <para style="q1" vid="1CH 29:11">Ubwami ni ubwawe, yewe <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="1CH 29:11">ushizwe hejuru nk’uganza vyose.<verse eid="1CH 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12" />Ubutunzi n’iteka biva iwawe;</para>
  <para style="q2" vid="1CH 29:12">uri uwuganza vyose.</para>
  <para style="q1" vid="1CH 29:12">Mu ntoke zawe hari inkomezi n’ububasha</para>
  <para style="q2" vid="1CH 29:12">vyo gushira hejuru no gukomeza uwo ishatse wese.<verse eid="1CH 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13" />None rero, Mana yacu, turagukengurukiye,</para>
  <para style="q2" vid="1CH 29:13">kandi duhimbaje izina ryawe ry’ubwiza.<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />Ariko jewe ndi iki, abantu banje bo ni iki, ngo dushobore gutanga tuvyishakiye nk’uku? Vyose biva iwawe, natwe twaguhaye ibiva mu kuboko kwawe gusa. <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />Turi inyambukira n’ingenzi mu nyonga zawe, nk’uko na ba sogokuru bacu bari bari. Imisi yacu kw’isi ni nk’igitutu, nta vyizigiro. <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />Yewe <char style="nd">Uhoraho</char> Mana yacu, ibi vyose twatanze ngo bize vyubake Ingoro izokwitirirwa Izina ryawe Ryera, biva mu kiganza cawe, kandi vyose ni ivyawe. <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />Ndazi, Mana yanje, ko ugera umutima kandi ko uhimbarwa n’ubugororotsi. Ibi vyose nabitanze ata gahato kandi ndavyishakiye. Kandi nezerejwe no kubona uburyo abantu bawe bari aha bagushikaniye ata gahato. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />Yewe <char style="nd">Uhoraho</char>, Mana ya ba sogokuru Aburahamu, Isaka na Isirayeli, zigama iki cipfuzo mu mitima y’abantu bawe ibihe bidashira, kandi imitima yabo yame ikuyoboka. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />Kandi uze uhe umuhungu wanje Salomo kwitanga abikunze ngo aze afate nkama ivyo wamutegetse vyose, n’ivyo wihanikirije n’amabwirizwa yawe, kandi akore vyose ngo yubake iyi Ngoro nk’uko integuro yayo nateguye imeze.”<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />Maze Dawidi abwira ikoraniro ryose ati: “Muhimbaze <char style="nd">Uhoraho</char> Imana yanyu.” Nuko bose bahimbaza <char style="nd">Uhoraho</char>, Imana ya ba sekuruza; bunamira <char style="nd">Uhoraho</char> n’umwami.<verse eid="1CH 29:20" /></para>
  <para style="s1">Salomo yemezwa nk’umwami</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />Bukeye bashikanira <char style="nd">Uhoraho</char> ibimazi bamushikanira n’ibimazi vyo gutongozwa umuriro: inka igihumbi, impfizi z’intama igihumbi n’imyagazi y’intama igihumbi, hamwe n’amashikanwa y’ibinyobwa bijanye, n’ibindi bimazi vyinshi vy’Abisirayeli bose. <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />Kuri uwo musi bararya kandi baranywa banezerewe cane bari imbere y’<char style="nd">Uhoraho</char>.</para>
  <para style="p" vid="1CH 29:22">Maze baca bemeza Salomo mwene Dawidi nk’umwami ubwa kabiri, bamwimikisha amavuta imbere y’<char style="nd">Uhoraho</char> ngo abe umutware na Sadoki bamusiga amavuta ngo abe umuherezi. <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />Maze Salomo avyagira ku ntebe y’ubwami bw’<char style="nd">Uhoraho</char> nk’umwami mu gishingo ca se Dawidi. Agira ikiganza ciza kandi Abisirayeli bose baramwumvira. <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />Abakuru bose n’abanyenkomezi, n’abahungu b’umwami Dawidi bose, basezerana kuzokwumvira umwami Salomo.<verse eid="1CH 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25" />
    <char style="nd">Uhoraho</char> ashira hejuru Salomo imbere y’Abisirayeli bose kandi amuha icubahiro ubwami bwiwe buba bwiza kurusha abami bose b’Abisirayeli bamwitangiye imbere.<verse eid="1CH 29:25" /></para>
  <para style="s1">Urupfu rwa Dawidi</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />Dawidi mwene Isayi yari umwami w’Abisirayeli bose. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />Yaganje Isirayeli imyaka mirongo ine. Yamaze imyaka indwi aba i Heburoni, iyindi mirongo itatu n’itatu aba i Yerusalemu. <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />Yapfuye yisaziye, yaranezererewe kuramba, ubutunzi n’icubahiro. Umuhungu wiwe Salomo amusubirira ku ngoma.<verse eid="1CH 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29" />Ivyabaye ku ngoma y’umwami Dawidi, kuva mu ntango gushika kw’iherezo, vyanditswe mu gitabu ca Samweli uwerekwa, mu vyanditswe vya Natani uwavugishwa n’Imana no mu vyanditswe vya Gadi uwerekwa; <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />biri kumwe n’ido n’ido ry’ivyo ku ngoma yiwe n’ububasha bwiwe, n’ivyagiye biraba mu gihe ciwe hamwe n’Abisirayeli, n’ubwami bwose bwari buhakikije.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>