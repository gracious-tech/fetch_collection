  <para style="h">Yoweli</para>
  <para style="toc1">Igitabu c’uwavugishwa n’Imana Yoweli</para>
  <para style="toc2">Yoweli</para>
  <para style="toc3">Yow</para>
  <para style="mt2">Igitabu c’uwavugishwa n’Imana</para>
  <para style="mt1">Yoweli</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Iri ni ijambo <char style="nd">Uhoraho</char> yatumye kuri Yoweli mwene Petuweli.<verse eid="JOL 1:1" /></para>
  <para style="b" />
  <para style="s1">Igitero c’inzige</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2" />Nimwumve ibi, yemwe batware;</para>
  <para style="q2" vid="JOL 1:2">nimwumvirize, yemwe ababa mu gihugu mwese.</para>
  <para style="q1" vid="JOL 1:2">Mbega hari ikintu nk’iki cari bwigere kiba kuva aho mwabereyeho,</para>
  <para style="q2" vid="JOL 1:2">canke kuva aho ba sogokuruza banyu babereyeho?<verse eid="JOL 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3" />Nimubibwire abana banyu,</para>
  <para style="q2" vid="JOL 1:3">n’abana banyu bazobibwire abana babo,</para>
  <para style="q2" vid="JOL 1:3">n’abana babo bazobibwire urunganwe ruzokurikira.<verse eid="JOL 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4" />Ivyo inzige zisanzwe zasigaje,</para>
  <para style="q2" vid="JOL 1:4">inzige nininini zarabiriye;</para>
  <para style="q1" vid="JOL 1:4">ivyo inzige nininini zasigaje,</para>
  <para style="q2" vid="JOL 1:4">ivyana vy’inzige vyarabiriye</para>
  <para style="q1" vid="JOL 1:4">Ivyo ivyana vy’inzige vyasigaje,</para>
  <para style="q2" vid="JOL 1:4">izindi nzige zarabiriye.<verse eid="JOL 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5" />Nimwikangure, yemwe mborerwa mwe, maze murire!</para>
  <para style="q2" vid="JOL 1:5">Nimuboroge, yemwe mwa banywi b’umuvinyu mwe;</para>
  <para style="q1" vid="JOL 1:5">muboroge, kubera umuvinyu mushasha,</para>
  <para style="q2" vid="JOL 1:5">muwukuwe mu kanwa.<verse eid="JOL 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6" />Ihanga riteye igihugu canje,</para>
  <para style="q2" vid="JOL 1:6">ingabo z’inkomezi zitoharurika;</para>
  <para style="q1" vid="JOL 1:6">bafise amenyo nk’ay’intare,</para>
  <para style="q2" vid="JOL 1:6">n’imibangabanga nk’iy’intare y’ingore.<verse eid="JOL 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7" />Bahoneje inzabibu zanje</para>
  <para style="q2" vid="JOL 1:7">kandi barandaguye imisukoni yanje.</para>
  <para style="q1" vid="JOL 1:7">Barabishishaguye,</para>
  <para style="q2" vid="JOL 1:7">babishiburira hirya,</para>
  <para style="q2" vid="JOL 1:7">basiga amashami yera.<verse eid="JOL 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8" />Nimugandare nk’inkumi yambaye igunira</para>
  <para style="q2" vid="JOL 1:8">iririra umusore yari ayikoye.<verse eid="JOL 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9" />Amashikanwa y’ifu n’ay’ibinyobwa</para>
  <para style="q2" vid="JOL 1:9">araciwe mu Ngoro y’<char style="nd">Uhoraho</char>.</para>
  <para style="q1" vid="JOL 1:9">Abaherezi baragandaye,</para>
  <para style="q2" vid="JOL 1:9">ari bo bakorera imbere y’<char style="nd">Uhoraho</char>.<verse eid="JOL 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10" />Imirima irarandaguwe,</para>
  <para style="q2" vid="JOL 1:10">isi iragadutse;</para>
  <para style="q1" vid="JOL 1:10">ingano zirahonye,</para>
  <para style="q2" vid="JOL 1:10">umutobe w’umuvinyu urakamye,</para>
  <para style="q2" vid="JOL 1:10">n’amavuta ya elayo arabuze.<verse eid="JOL 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11" />Nimwihebure, yemwe barimyi,</para>
  <para style="q2" vid="JOL 1:11">muboroge yemwe barimyi b’imizabibu;</para>
  <para style="q1" vid="JOL 1:11">mubabare kubera ingano na sayiri,</para>
  <para style="q2" vid="JOL 1:11">kuko ivyimburwa vyo mu mirima bisanganguwe.<verse eid="JOL 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12" />Umuvinyu urakamye</para>
  <para style="q2" vid="JOL 1:12">umusukoni urakabiranye;</para>
  <para style="q1" vid="JOL 1:12">amakomamanga, ibigazi n’amapome,</para>
  <para style="q2" vid="JOL 1:12">n’ibiti vyose vy’ivyamwa birumye.</para>
  <para style="q1" vid="JOL 1:12">Ni ukuri umunezero w’abantu</para>
  <para style="q2" vid="JOL 1:12">uraheze.<verse eid="JOL 1:12" /></para>
  <para style="s1">Akamo gatewe abantu ngo bacure intimba</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13" />Nimwambare amagunira, yemwe baherezi, maze mugandare;</para>
  <para style="q2" vid="JOL 1:13">nimuboroge, yemwe abakorera imbere y’igicaniro.</para>
  <para style="q1" vid="JOL 1:13">Nimuze mumare ijoro mwambaye amagunira,</para>
  <para style="q2" vid="JOL 1:13">yemwe abakorera imbere y’Imana yanje;</para>
  <para style="q1" vid="JOL 1:13">kuko amashikanwa y’ifu n’ay’ibinyobwa</para>
  <para style="q2" vid="JOL 1:13">bibuze mu Ngoro y’Imana yanyu.<verse eid="JOL 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14" />Nimwamamaze ukwisonzesha kwera;</para>
  <para style="q2" vid="JOL 1:14">nimutumeko ikoraniro ryera.</para>
  <para style="q1" vid="JOL 1:14">Nimutumeko abatware</para>
  <para style="q2" vid="JOL 1:14">n’ababa mu gihugu bose</para>
  <para style="q1" vid="JOL 1:14">ngo baze ku Ngoro y’<char style="nd">Uhoraho</char> Imana yanyu,</para>
  <para style="q2" vid="JOL 1:14">maze batakambire <char style="nd">Uhoraho</char>.<verse eid="JOL 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15" />Ewe musi uri aho!</para>
  <para style="q2" vid="JOL 1:15">Uwo umusi w’<char style="nd">Uhoraho</char> uri hafi;</para>
  <para style="q2" vid="JOL 1:15">uzoza nk’icago gihonya uvuye ku Mana ihambaye.<verse eid="JOL 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16" />Mbega ivyokurya ntivyakuweho</para>
  <para style="q2" vid="JOL 1:16">imbere y’amaso yanyu,</para>
  <para style="q1" vid="JOL 1:16">n’umunezero no guhimbarwa</para>
  <para style="q2" vid="JOL 1:16">biva ku nzu y’Imana yacu?<verse eid="JOL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17" />Imbuto zumiye</para>
  <para style="q2" vid="JOL 1:17">mu kuzimu.</para>
  <para style="q1" vid="JOL 1:17">Ibigega bisigaye ari imisaka,</para>
  <para style="q2" vid="JOL 1:17">ububiko bw’ingano bwarasambuwe,</para>
  <para style="q2" vid="JOL 1:17">kuko ingano zaheze.<verse eid="JOL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18" />Ibitungwa biraniha.</para>
  <para style="q2" vid="JOL 1:18">Amasho arasanzaye hirya no hino;</para>
  <para style="q1" vid="JOL 1:18">kuko abuze uburagiro;</para>
  <para style="q2" vid="JOL 1:18">n’imikuku y’intama n’impene ishikiwe n’ivyago.<verse eid="JOL 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19" />
    <char style="nd">Uhoraho</char>, ni wewe ntakambiye,</para>
  <para style="q2" vid="JOL 1:19">kuko umuriro watongoye uburagiro bwo mu bugaragwa</para>
  <para style="q2" vid="JOL 1:19">n’ibirimi vy’umuriro vyatongoye ibiti vyo mu murima.<verse eid="JOL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20" />N’ibikoko vyo mw’ishamba bihuzagizwa bikurondera;</para>
  <para style="q2" vid="JOL 1:20">amasoko y’amazi yakamye,</para>
  <para style="q2" vid="JOL 1:20">umuriro na wo watongoye uburagiro bwo mu bugaragwa.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s1">Igitero c’inzige</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1" />Nimuvuze inzamba i Siyoni;</para>
  <para style="q2" vid="JOL 2:1">muvuze akamo k’intambara ku musozi wanje wera.</para>
  <para style="b" vid="JOL 2:1" />
  <para style="q1" vid="JOL 2:1">Ababa mu gihugu nibahinde agashitsi,</para>
  <para style="q2" vid="JOL 2:1">kuko umusi w’<char style="nd">Uhoraho</char> ushitse.</para>
  <para style="q1" vid="JOL 2:1">Uregereje uri hafi,<verse eid="JOL 2:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 2:2" />umusi w’umwijima w’umuzitanya,</para>
  <para style="q2" vid="JOL 2:2">umusi w’ibicu n’umuzimagiza.</para>
  <para style="q1" vid="JOL 2:2">Nk’uko umutwenzi uza ku misozi</para>
  <para style="q2" vid="JOL 2:2">ni ko ingabo z’inkomezi nyinshi zije,</para>
  <para style="q1" vid="JOL 2:2">ntivyari bwabe muri kahise</para>
  <para style="q2" vid="JOL 2:2">kandi ntibizosubira kubaho muri kazoza.<verse eid="JOL 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3" />Imbere yabo umuriro uratongora,</para>
  <para style="q2" vid="JOL 2:3">inyuma yabo imbeya zirarabagiza.</para>
  <para style="q1" vid="JOL 2:3">Imbere yabo igihugu kimeze nk’itongo rya Edeni,</para>
  <para style="q2" vid="JOL 2:3">inyuma yabo, ni ubugaragwa,</para>
  <para style="q2" vid="JOL 2:3">nta na kimwe basigaza.<verse eid="JOL 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4" />Bafise ishusho y’amafarasi;</para>
  <para style="q2" vid="JOL 2:4">biruka nk’abagwanira ku mafarasi.<verse eid="JOL 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5" />Urwamo rwabo ni nk’urw’imikogote</para>
  <para style="q2" vid="JOL 2:5">Basimbagurika ku dutwe tw’imisozi,</para>
  <para style="q1" vid="JOL 2:5">bameze nk’umuriro utongora isakamburira,</para>
  <para style="q2" vid="JOL 2:5">ni nk’ingabo z’inkomezi zigiye mu ntambara.<verse eid="JOL 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6" />Imbere yabo, amahanga ahinda agashitsi;</para>
  <para style="q2" vid="JOL 2:6">mu maso h’abantu bose harahindurira.<verse eid="JOL 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7" />Batera nk’abahizi;</para>
  <para style="q2" vid="JOL 2:7">burira inzitiro nk’abasoda.</para>
  <para style="q1" vid="JOL 2:7">Bose bagenda ku murongo,</para>
  <para style="q2" vid="JOL 2:7">nta n’umwe ahesha ngo aje ku ruhande.<verse eid="JOL 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8" />Nta n’umwe agunda mugenziwe;</para>
  <para style="q2" vid="JOL 2:8">umwe wese agenda aramirije imbere yiwe;</para>
  <para style="q1" vid="JOL 2:8">binjira baciye mu mpome</para>
  <para style="q2" vid="JOL 2:8">nta kibatangira.<verse eid="JOL 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9" />Bitera mu gisagara;</para>
  <para style="q2" vid="JOL 2:9">biruka inyuma y’uruzitiro.</para>
  <para style="q1" vid="JOL 2:9">Barurira bakitera mu mazu;</para>
  <para style="q2" vid="JOL 2:9">binjira baciye mu madirisha kurya kw’ibisuma.<verse eid="JOL 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10" />Imbere yabo isi iratigita,</para>
  <para style="q2" vid="JOL 2:10">n’amajuru agahinda agashitsi</para>
  <para style="q1" vid="JOL 2:10">izuba n’ukwezi bicuze umwijima,</para>
  <para style="q2" vid="JOL 2:10">n’inyenyeri ntizicaka.<verse eid="JOL 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11" />
    <char style="nd">Uhoraho</char> araturagaye</para>
  <para style="q2" vid="JOL 2:11">ari imbere y’ingabo ziwe;</para>
  <para style="q1" vid="JOL 2:11">ingabo ziwe ntiziharurika,</para>
  <para style="q2" vid="JOL 2:11">kandi ingabo zimuyoboka ni inyenkomezi.</para>
  <para style="q1" vid="JOL 2:11">Umusi w’<char style="nd">Uhoraho</char> urahambaye;</para>
  <para style="q2" vid="JOL 2:11">ni umusi wo guhonya.</para>
  <para style="q2" vid="JOL 2:11">Ni nde azoshobora kuwihanganira?<verse eid="JOL 2:11" /></para>
  <para style="s1">Nimujanjagure imitima yanyu</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12" />“Mbere n’ubu nyene,” ni ko <char style="nd">Uhoraho</char> avuze,</para>
  <para style="q2" vid="JOL 2:12">“nimungarukeko n’umutima wanyu wose,</para>
  <para style="q2" vid="JOL 2:12">mwisonzesha, murira kandi mugandaye.”<verse eid="JOL 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13" />Imitima yanyu nibe ari yo mutabura</para>
  <para style="q2" vid="JOL 2:13">mureke impuzu zanyu.</para>
  <para style="q1" vid="JOL 2:13">Nimugaruke k’<char style="nd">Uhoraho</char> Imana yanyu,</para>
  <para style="q2" vid="JOL 2:13">kuko ari umunyabuntu agira imbabazi,</para>
  <para style="q1" vid="JOL 2:13">ateba kuraka kandi agira urukundo rwinshi,</para>
  <para style="q2" vid="JOL 2:13">kandi arigarura ngo ntarungike ivyago.<verse eid="JOL 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14" />Hari uwubizi? Ashobora kwigarura</para>
  <para style="q2" vid="JOL 2:14">akabasigarana umugisha</para>
  <para style="q1" vid="JOL 2:14">w’amashikanwa y’amafu n’ay’ibinyobwa</para>
  <para style="q2" vid="JOL 2:14">mushikanira <char style="nd">Uhoraho</char> Imana yanyu.<verse eid="JOL 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15" />Nimuvuze inzamba i Siyoni,</para>
  <para style="q2" vid="JOL 2:15">nimuhamagarire abantu ukwisonzesha kwera,</para>
  <para style="q2" vid="JOL 2:15">mukoranye ikoraniro ryera.<verse eid="JOL 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16" />Nimukoranye abantu,</para>
  <para style="q2" vid="JOL 2:16">mugire ikoraniro ryera;</para>
  <para style="q1" vid="JOL 2:16">nimukoranye abakurambere,</para>
  <para style="q2" vid="JOL 2:16">egeranya abana,</para>
  <para style="q2" vid="JOL 2:16">mukoranye n’abakiri kw’ibere.</para>
  <para style="q1" vid="JOL 2:16">Uwarongoye nasohoke</para>
  <para style="q2" vid="JOL 2:16">n’umugeni ave mu nkinga.<verse eid="JOL 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17" />Abaherezi bakorera imbere y’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="JOL 2:17">nibaririre hagati y’urwinjiriro n’igicaniro.</para>
  <para style="q1" vid="JOL 2:17">Nibavuge bati: “Ziguriza abantu bawe, yewe <char style="nd">Uhoraho</char>.</para>
  <para style="q2" vid="JOL 2:17">Ntuhindure umugabane wawe agatwengo,</para>
  <para style="q2" vid="JOL 2:17">canke akamenyo hagati mu mahanga.</para>
  <para style="q1" vid="JOL 2:17">Ni kubera iki mu mahanga bobaza bati:</para>
  <para style="q2" vid="JOL 2:17">‘Mbega Imana yabo iri hehe?’ ”<verse eid="JOL 2:17" /></para>
  <para style="s1">Inyishu ivuye k’<char style="nd">Uhoraho</char></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18" />Maze <char style="nd">Uhoraho</char> agirira urukundo rwinshi igihugu ciwe</para>
  <para style="q2" vid="JOL 2:18">kandi agirira akagongwe abantu biwe.<verse eid="JOL 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19" />
    <char style="nd">Uhoraho</char> arabishura ati:</para>
  <para style="q1" vid="JOL 2:19">“Nzobarungikira ingano, umutobe musha w’umuvinyu n’amavuta ya elayo,</para>
  <para style="q2" vid="JOL 2:19">bikwiye vyo kubahaza;</para>
  <para style="q1" vid="JOL 2:19">sinzokwongera kubahindura</para>
  <para style="q2" vid="JOL 2:19">agatwengo mu mahanga.<verse eid="JOL 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20" />Nzokwirukana abansi banyu bo mu buraruko baje kure y’aho muri,</para>
  <para style="q2" vid="JOL 2:20">ndabahindagize gushika mu gihugu kigadutse c’ubugaragwa.</para>
  <para style="q1" vid="JOL 2:20">Umuce wabo wo mu buseruko nzowirukanira mu Kiyaga c’Umunyu,</para>
  <para style="q2" vid="JOL 2:20">maze umuce wo mu burengero ndawurungike mu Kiyaga Mediterane.</para>
  <para style="q1" vid="JOL 2:20">Kandi ukubora kwabo kuzomenyekana</para>
  <para style="q2" vid="JOL 2:20">n’ukunuka kw’imivyimba yabo kuzoduga mu kirere.”</para>
  <para style="b" vid="JOL 2:20" />
  <para style="q1" vid="JOL 2:20">Koko yakoze ibikomeye!<verse eid="JOL 2:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21" />Ntimutinye, yemwe ababa i Buyuda;</para>
  <para style="q2" vid="JOL 2:21">nimunezerwe kandi muhimbarwe.</para>
  <para style="q1" vid="JOL 2:21">Ni ukuri <char style="nd">Uhoraho</char> yakoze ibikomeye!<verse eid="JOL 2:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22" />Ntimutinye, yemwe bikoko vyo mw’ishamba,</para>
  <para style="q2" vid="JOL 2:22">kuko uburagiro bwo mu bugaragwa butanguye gutotahara.</para>
  <para style="q1" vid="JOL 2:22">Ibiti biriko birama ivyamwa vyavyo;</para>
  <para style="q2" vid="JOL 2:22">imisukoni n’imizabibu vyama ivyimburwa vyavyo.<verse eid="JOL 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23" />Nimunezerwe, bantu b’i Siyoni,</para>
  <para style="q2" vid="JOL 2:23">nimunezererwe <char style="nd">Uhoraho</char> Imana yanyu,</para>
  <para style="q1" vid="JOL 2:23">kuko yabahaye imvura y’impeshi</para>
  <para style="q2" vid="JOL 2:23">abitewe n’uko ari umwizigirwa.</para>
  <para style="q1" vid="JOL 2:23">Abaha imvura nyinshi,</para>
  <para style="q2" vid="JOL 2:23">yo ku mpeshi n’iyo mu rushana, nk’uko vyahora.<verse eid="JOL 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24" />Imbuga zizokwuzura ingano;</para>
  <para style="q2" vid="JOL 2:24">amato azosesekara imitobe y’umuvinyu n’amavuta.<verse eid="JOL 2:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25" />“Nzogushumbusha imyaka yariwe n’inzige;</para>
  <para style="q2" vid="JOL 2:25">inzige nininini n’abana b’inzige,</para>
  <para style="q2" vid="JOL 2:25">hamwe n’ubundi bwoko bw’inzige,</para>
  <para style="q1" vid="JOL 2:25">ari zo ngabo zanje zihambaye, izo narungitse muri mwebwe.<verse eid="JOL 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26" />Muzoronka umusesekara w’ivyokurya, muhage,</para>
  <para style="q2" vid="JOL 2:26">kandi muzohimbaza izina ry’<char style="nd">Uhoraho</char> Imana yanyu,</para>
  <para style="q2" vid="JOL 2:26">yakoreye ibitangaza muri mwebwe;</para>
  <para style="q1" vid="JOL 2:26">kandi abantu banje ntibazosubira kumaramara.<verse eid="JOL 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27" />Ni ho muzomenya ko ndi mu Bisirayeli,</para>
  <para style="q2" vid="JOL 2:27">ko ndi <char style="nd">Uhoraho</char> Imana yanyu,</para>
  <para style="q2" vid="JOL 2:27">kandi ko ata yindi iriho;</para>
  <para style="q1" vid="JOL 2:27">abantu banje ntibazokwigera basubira kumaramara.<verse eid="JOL 2:27" /></para>
  <para style="s1">Umusi w’<char style="nd">Uhoraho</char></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28" />Kandi hanyuma y’ivyo,</para>
  <para style="q2" vid="JOL 2:28">nzosuka Mpwemu wanje ku bantu bose.</para>
  <para style="q1" vid="JOL 2:28">Abahungu banyu n’abakobwa banyu bazovugishwa,</para>
  <para style="q2" vid="JOL 2:28">abatama banyu bazorota indoto,</para>
  <para style="q2" vid="JOL 2:28">n’abasore banyu bazobona ivyo beretswe.<verse eid="JOL 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29" />N’abasavyi banje, abagabo n’abagore,</para>
  <para style="q2" vid="JOL 2:29">nzobasukako Mpwemu wanje muri iyo misi.<verse eid="JOL 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30" />Nzokwerekana ibimenyetso mw’ijuru</para>
  <para style="q2" vid="JOL 2:30">no kw’isi,</para>
  <para style="q2" vid="JOL 2:30">amaraso n’umuriro n’ugupfunduka kw’umwotsi.<verse eid="JOL 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31" />Izuba rizohinduka umwijima,</para>
  <para style="q2" vid="JOL 2:31">ukwezi guhinduke guse n’amaraso</para>
  <para style="q2" vid="JOL 2:31">imbere y’uko uwo musi uhambaye w’agatikizo kandi w’<char style="nd">Uhoraho</char> ushika.<verse eid="JOL 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32" />Kandi umuntu wese azokwambaza</para>
  <para style="q2" vid="JOL 2:32">izina ry’<char style="nd">Uhoraho</char> azokizwa;</para>
  <para style="q1" vid="JOL 2:32">kuko ku musozi Siyoni n’i Yerusalemu</para>
  <para style="q2" vid="JOL 2:32">hazoba ugutabarwa,</para>
  <para style="q2" vid="JOL 2:32">nk’uko <char style="nd">Uhoraho</char> yavuze,</para>
  <para style="q1" vid="JOL 2:32">mbere no mu bazoba barokotse ivyago</para>
  <para style="q2" vid="JOL 2:32">abo <char style="nd">Uhoraho</char> azohamagara.”<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s1">Amahanga acirwa urubanza</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1" />“Muri iyo misi no muri ico gihe,</para>
  <para style="q2" vid="JOL 3:1">aho nzogarukanira Abayuda n’ab’i Yerusalemu,<verse eid="JOL 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2" />nzokwegeranya amahanga yose</para>
  <para style="q2" vid="JOL 3:2">ndayakoranirize mu kiyaya ca Yehoshafati.</para>
  <para style="q1" vid="JOL 3:2">Aho ni ho nzobageragereza</para>
  <para style="q2" vid="JOL 3:2">kubera ivyo bakoreye umugabane wanje,</para>
  <para style="q2" vid="JOL 3:2">ari bo bantu banje b’Abisirayeli,</para>
  <para style="q1" vid="JOL 3:2">kuko basanzaje abantu banje mu mahanga</para>
  <para style="q2" vid="JOL 3:2">bakagabura igihugu canje.<verse eid="JOL 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3" />Bagize ubupfindo ku bantu banje;</para>
  <para style="q2" vid="JOL 3:3">bagurisha abahungu ngo baronke ba maraya,</para>
  <para style="q2" vid="JOL 3:3">bakagurisha abakobwa kugira ngo baronke umuvinyu ukwiye wo kunywa.<verse eid="JOL 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />None ga Tiro na Sidoni munyagiriza iki, mwe n’intara ziri kumwe namwe z’i Bufilisitiya? Mbega munyihora ico nabakoreye? Nimwaba muriko muranyihora, nzobasubizako vuba kandi vyihuta ivyo mwakoze. <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />Kuko mwafashe ifeza zanje n’inzahabu zanje, mugatwara ivyarusha ibindi kuba vyiza mu butunzi bwanje mubijana mu ngoro zanyu. <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />Mwagurishije abantu banje b’i Buyuda n’i Yerusalemu ku Bagiriki, kugira ngo mubarungike kure y’igihugu cabo.<verse eid="JOL 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7" />Raba, ngiye kubavyura ndabakure aho mwabagurishije hose, kandi nzosubiza kuri mwebwe nyene ivyo mwakoze. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />Nzogurisha abahungu banyu n’abakobwa banyu ku bantu b’i Buyuda, maze na bo bazobagurisha ku Basabeya, ihanga rya kure.” Ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="JOL 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9" />Nimubimenyeshe mu mahanga:</para>
  <para style="q2" vid="JOL 3:9">Nimwitegurire intambara!</para>
  <para style="q1" vid="JOL 3:9">Kangura abahizi!</para>
  <para style="q2" vid="JOL 3:9">Abagwanyi bose nibegere hafi batere.<verse eid="JOL 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10" />Ivyuma birima vy’imikogote yanyu mubicuremwo inkota</para>
  <para style="q2" vid="JOL 3:10">imihoro yanyu muyicuremwo amacumu.</para>
  <para style="q1" vid="JOL 3:10">Umunyantegenke avuge ati:</para>
  <para style="q2" vid="JOL 3:10">“Ndakomeye!”<verse eid="JOL 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11" />Nimuze munyaruka, yemwe mahanga mwese muve mu mpande zose,</para>
  <para style="q2" vid="JOL 3:11">mukoranireyo.</para>
  <para style="b" vid="JOL 3:11" />
  <para style="q1" vid="JOL 3:11">Manukana abagwanyi bawe, ewe <char style="nd">Uhoraho</char>!<verse eid="JOL 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12" />“Amahanga navyuke;</para>
  <para style="q2" vid="JOL 3:12">yose aje mu kiyaya ca Yehoshafati,</para>
  <para style="q1" vid="JOL 3:12">kuko aho ari ho nzokwicara</para>
  <para style="q2" vid="JOL 3:12">maze ncire imanza amahanga yose yo mu mpande zose.<verse eid="JOL 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13" />Bangura umuhoro,</para>
  <para style="q2" vid="JOL 3:13">kuko iyimbura rigeze.</para>
  <para style="q1" vid="JOL 3:13">Nimuze, mugane inzabibu,</para>
  <para style="q2" vid="JOL 3:13">kuko ubwato bwuzuye</para>
  <para style="q2" vid="JOL 3:13">kandi ubwato bwo kuganiramwo bukaba busesekaye,</para>
  <para style="q1" vid="JOL 3:13">ibibi vyabo ni vyinshi!”<verse eid="JOL 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14" />Ibihumbi n’ibihumbi</para>
  <para style="q2" vid="JOL 3:14">bari mu kiyaya c’imanza!</para>
  <para style="q1" vid="JOL 3:14">Kuko umusi w’<char style="nd">Uhoraho</char> uri hafi</para>
  <para style="q2" vid="JOL 3:14">mu kiyaya c’imanza.<verse eid="JOL 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15" />Izuba n’ukwezi bizokwirabura nk’umwijima,</para>
  <para style="q2" vid="JOL 3:15">kandi n’inyenyeri ntizizoba zigikayangana.<verse eid="JOL 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16" />
    <char style="nd">Uhoraho</char> azokwivuga ari i Siyoni</para>
  <para style="q2" vid="JOL 3:16">kandi azoturagara ari i Yerusalemu;</para>
  <para style="q2" vid="JOL 3:16">isi n’amajuru bizohinda agashitsi.</para>
  <para style="q1" vid="JOL 3:16">Ariko <char style="nd">Uhoraho</char> azobera abantu biwe ubuhungiro,</para>
  <para style="q2" vid="JOL 3:16">umunara wo guhungiramwo w’Abisirayeli.<verse eid="JOL 3:16" /></para>
  <para style="s1">Imigisha izoba ku bantu b’Imana</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17" />“Ni ho muzomenyera ko jewe, <char style="nd">Uhoraho</char> Imana yanyu,</para>
  <para style="q2" vid="JOL 3:17">mba i Siyoni, umusozi wanje wera.</para>
  <para style="q1" vid="JOL 3:17">Yerusalemu hazoba ahera;</para>
  <para style="q2" vid="JOL 3:17">abanyamahanga ntibazosubira kuhatera.<verse eid="JOL 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18" />Kuri uwo musi imisozi izotembako umutobe w’umuvinyu,</para>
  <para style="q2" vid="JOL 3:18">n’uturambi tuzotembako ubuki;</para>
  <para style="q2" vid="JOL 3:18">imyonga yose y’i Buyuda itembemwo amazi.</para>
  <para style="q1" vid="JOL 3:18">Isoko izotemba iva mu Ngoro y’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="JOL 3:18">kandi izovomera ikiyaya c’iminyinya.<verse eid="JOL 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19" />Ariko Egiputa hazoba umusaka,</para>
  <para style="q2" vid="JOL 3:19">Edomu habe ubugaragwa,</para>
  <para style="q1" vid="JOL 3:19">kubera ibibi bakoreye abantu b’i Buyuda,</para>
  <para style="q2" vid="JOL 3:19">igihugu basheshemwo amaraso y’abatagira icaha.<verse eid="JOL 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20" />I Buyuda n’i Yerusalemu hazoba abantu ibihe vyose</para>
  <para style="q2" vid="JOL 3:20">uko urunganwe ruzokurikirana n’urundi.<verse eid="JOL 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21" />Sinzoshirwa ntahoye amaraso y’abatagira icaha.</para>
  <para style="q2" vid="JOL 3:21">Haba na mba.”</para>
  <para style="b" vid="JOL 3:21" />
  <para style="qc" vid="JOL 3:21">
    <char style="nd">Uhoraho</char> ahangamye i Siyoni!<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>