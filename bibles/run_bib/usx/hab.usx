  <para style="h">Habakuki</para>
  <para style="toc1">Igitabu c’uwavugishwa n’Imana Habakuki</para>
  <para style="toc2">Habakuki</para>
  <para style="toc3">Hab</para>
  <para style="mt2">Igitabu c’uwavugishwa n’Imana</para>
  <para style="mt1">Habakuki</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />Ubu ni ubutumwa bwahawe umuvugishwa Habakuki.<verse eid="HAB 1:1" /></para>
  <para style="s1">Ukuzazanirwa kwa Habakuki</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2" />Yewe <char style="nd">Uhoraho</char>, mbega nzogeza ryari kuguhamagara ngo umfashe,</para>
  <para style="q2" vid="HAB 1:2">ariko ntunyumve,</para>
  <para style="q1" vid="HAB 1:2">canke nkagutakira kubera umuryano</para>
  <para style="q2" vid="HAB 1:2">ariko ntutabare?<verse eid="HAB 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3" />Ni kuki utuma ndaba akarenganyo?</para>
  <para style="q2" vid="HAB 1:3">Ni kuki wihanganira ibikorwa bibi?</para>
  <para style="q1" vid="HAB 1:3">Guhonya n’umuryano biri imbere yanje;</para>
  <para style="q2" vid="HAB 1:3">kandi imitongano n’amatati biri ahantu hose.<verse eid="HAB 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4" />Ni co gituma ivyagezwe bitagikurikizwa,</para>
  <para style="q2" vid="HAB 1:4">n’ubutungane ntibwubahirizwe.</para>
  <para style="q1" vid="HAB 1:4">Umunyakibi aratsinda umugororotsi,</para>
  <para style="q2" vid="HAB 1:4">ubutungane bugasibanganywa.<verse eid="HAB 1:4" /></para>
  <para style="s1">Inyishu y’<char style="nd">Uhoraho</char></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5" />“Nimwitegereze amahanga, murabe</para>
  <para style="q2" vid="HAB 1:5">hanyuma mutangare mwumirwe.</para>
  <para style="q1" vid="HAB 1:5">Kuko mu gihe canyu,</para>
  <para style="q2" vid="HAB 1:5">ngiye gukora ikintu mutokwigera mwemera,</para>
  <para style="q2" vid="HAB 1:5">naho hogira uwukibabwira.<verse eid="HAB 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6" />Ngiye guhagurutsa Abanyababiloni,</para>
  <para style="q2" vid="HAB 1:6">ubwoko bw’inkazi kandi butagira imbabazi,</para>
  <para style="q1" vid="HAB 1:6">buzoca mw’isi yose</para>
  <para style="q2" vid="HAB 1:6">bwigarurire ibindi bihugu.<verse eid="HAB 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7" />Ni abo gutinywa kandi bateye ubwoba.</para>
  <para style="q2" vid="HAB 1:7">Bishingira amategeko nk’uko bishakiye</para>
  <para style="q2" vid="HAB 1:7">bakigwiriza icubahiro.<verse eid="HAB 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8" />Amafarasi yabo anyaruka kurusha ingwe,</para>
  <para style="q2" vid="HAB 1:8">akerebutse kurusha imfyisi zihiga iyo bwije.</para>
  <para style="q1" vid="HAB 1:8">Abagendera ku mafarasi babo basimbagurika bihuta,</para>
  <para style="q2" vid="HAB 1:8">kandi abagendera ku mafarasi babo baza bava kure.</para>
  <para style="q1" vid="HAB 1:8">Baguruka kurya kw’inkona iyo yihutira gucakira ico irotsa.<verse eid="HAB 1:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="HAB 1:9" />Bose bazanwa no gutera intambara.</para>
  <para style="q1" vid="HAB 1:9">Amasinzi yabo agenda nk’umuyaga wo mu bugaragwa,</para>
  <para style="q2" vid="HAB 1:9">bakegeranya imbohe zingana n’umusenyi.<verse eid="HAB 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10" />Batwenga abami,</para>
  <para style="q2" vid="HAB 1:10">bagashinyagurira abaganwa.</para>
  <para style="q1" vid="HAB 1:10">Basuzugura ibisagara vyabo bizitiriwe;</para>
  <para style="q2" vid="HAB 1:10">maze bakagira ibirundo vy’ivu, bakurira bakabifata.<verse eid="HAB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11" />Bagenda bihuta nk’umuyaga iyo uriko urahita.</para>
  <para style="q2" vid="HAB 1:11">Ariko ni abo gutsindwa n’urubanza kuko inkomezi zabo ari zo mana yabo.”<verse eid="HAB 1:11" /></para>
  <para style="s1">Habakuki yongera kuzazanirwa</para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12" />Yewe <char style="nd">Uhoraho</char>, mbega nturi Iyihoraho?</para>
  <para style="q2" vid="HAB 1:12">Mana yanje, Uwera, utazokwigera upfa.</para>
  <para style="q1" vid="HAB 1:12">Yewe <char style="nd">Uhoraho</char>, wabashiriyeho gushitsa amateka yawe;</para>
  <para style="q2" vid="HAB 1:12">yewe gitandara canje, wabategetse kuduhana.<verse eid="HAB 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13" />Ariko inyonga zawe ziratunganye ntizikunda kuraba ikibi,</para>
  <para style="q2" vid="HAB 1:13">ntiwihanganira inkozi y’ikibi.</para>
  <para style="q1" vid="HAB 1:13">None ni kuki wihanganira abanyazi?</para>
  <para style="q2" vid="HAB 1:13">Ni iki gituma wirengagiza iyo umunyakibi amira uwumusumvya ubugororotsi?<verse eid="HAB 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14" />Abantu wabagize nk’amafi yo ku kiyaga,</para>
  <para style="q2" vid="HAB 1:14">bamera nk’ibiremwa vyo mu mazi bitagira umurongozi.<verse eid="HAB 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15" />Umunyakibi akwegesha abantu igera,</para>
  <para style="q2" vid="HAB 1:15">akabategesha urusenga nk’urwo kuroba,</para>
  <para style="q1" vid="HAB 1:15">akabegeraniriza mu co aroberamwo amafi,</para>
  <para style="q2" vid="HAB 1:15">hanyuma akanezerwa, agahimbarwa.<verse eid="HAB 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16" />Maze agashikanira ibimazi izo nsenga,</para>
  <para style="q2" vid="HAB 1:16">ico aroberamwo akagituririra ibimota neza,</para>
  <para style="q1" vid="HAB 1:16">kuko kubera urwo rusenga abayeho ubuzima bw’ibihimbaro bikomeye,</para>
  <para style="q2" vid="HAB 1:16">agahindura imfungurwa uko ashatse.<verse eid="HAB 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17" />Mbega azokwama asuka ibiri mu rusenga,</para>
  <para style="q2" vid="HAB 1:17">atikiza amahanga ata kagongwe?<verse eid="HAB 1:17" /></para>
  <para style="b" />
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1" />Nzoduga ku munara wanje,</para>
  <para style="q2" vid="HAB 2:1">mpagarare ku kirindiro canje.</para>
  <para style="q1" vid="HAB 2:1">Nzorindira ico ambwira,</para>
  <para style="q2" vid="HAB 2:1">menye n’ico ndamwishura kuri aya maganya.<verse eid="HAB 2:1" /></para>
  <para style="s1">Inyishu y’<char style="nd">Uhoraho</char></para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2" />Maze <char style="nd">Uhoraho</char> aranyishura, ati:</para>
  <para style="q1" vid="HAB 2:2">“Andika ivyo uhishuriwe,</para>
  <para style="q2" vid="HAB 2:2">ubishire ahabona ku bisate vy’amabuye</para>
  <para style="q2" vid="HAB 2:2">ku buryo vyorohera gusoma, uwugenda asemerera.”<verse eid="HAB 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3" />Kuko ivyo wahishuriwe birafise igihe bizoshikirako.</para>
  <para style="q2" vid="HAB 2:3">Bivuga ivy’igihe c’iherezo,</para>
  <para style="q2" vid="HAB 2:3">kandi ntibibesha.</para>
  <para style="q1" vid="HAB 2:3">Naho vyoteba,</para>
  <para style="q2" vid="HAB 2:3">ubirindire;</para>
  <para style="q2" vid="HAB 2:3">nta nkeka bizoba, kandi ntibizoteba.<verse eid="HAB 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4" />“Raba umwansi yishize hejuru;</para>
  <para style="q2" vid="HAB 2:4">ivyipfuzo vyiwe ntibiroranye.</para>
  <para style="q2" vid="HAB 2:4">Ariko umugororotsi azobeshwaho n’ukwizera kwiwe.”<verse eid="HAB 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5" />Ni ukuri, umuvinyu uramuhenda;</para>
  <para style="q2" vid="HAB 2:5">yuzuye ubwibone kandi ntiyigera atekana.</para>
  <para style="q1" vid="HAB 2:5">Ameze kurya kw’imva itigera ihaga,</para>
  <para style="q2" vid="HAB 2:5">kandi ameze kurya kw’urupfu rutigera rushirwa,</para>
  <para style="q1" vid="HAB 2:5">yiyegeranirizako amahanga yose,</para>
  <para style="q2" vid="HAB 2:5">akagira imbohe abantu bose.<verse eid="HAB 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6" />“Ariko, mbega abo bose ntibazomuhindura ikimaramare, bitwengera bavuga bati:</para>
  <para style="q1" vid="HAB 2:6">‘Azobona ibara uwirundaniriza ivyo yasahuye,</para>
  <para style="q2" vid="HAB 2:6">akitungisha mu vyo yagunze abandi!</para>
  <para style="q2" vid="HAB 2:6">Mbega azobikora kugeza ryari?’ ”<verse eid="HAB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7" />Mbega abo mufitiye imyenda ntimuzobwirwa n’uko babahagurukiye?</para>
  <para style="q2" vid="HAB 2:7">Ntibazokwikangura bagatuma mujugumira?</para>
  <para style="q2" vid="HAB 2:7">Maze muzohinduka umunyago wabo.<verse eid="HAB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8" />Kuko wasahuye amahanga menshi,</para>
  <para style="q2" vid="HAB 2:8">abacitse kw’icumu na bo bazobasahura.</para>
  <para style="q1" vid="HAB 2:8">Kuko mwasheshe amaraso y’abantu;</para>
  <para style="q2" vid="HAB 2:8">mukarandura ibihugu n’ibisagara, ndetse n’ababibamwo bose.<verse eid="HAB 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9" />Azobona ibara uwiyubakira inzu mu nyungu mbi,</para>
  <para style="q2" vid="HAB 2:9">akishirira icari ciwe hejuru,</para>
  <para style="q2" vid="HAB 2:9">kugira ngo yikingire icago cose.<verse eid="HAB 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10" />Ariko waranduye amahanga menshi,</para>
  <para style="q2" vid="HAB 2:10">uteza isoni inzu yawe bwite kandi uzanira akaga ubugingo bwawe.<verse eid="HAB 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11" />Amabuye yubatse impome azobaha induru,</para>
  <para style="q2" vid="HAB 2:11">ibiti bizisakaye biyakire.<verse eid="HAB 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12" />“Azobona ibara uwubakisha igisagara gusesa amaraso,</para>
  <para style="q2" vid="HAB 2:12">agakomeresha igisagara akarenganyo.”<verse eid="HAB 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13" />Mbega <char style="nd">Uhoraho</char> Mushoboravyose si we yashinze ko</para>
  <para style="q2" vid="HAB 2:13">abantu baruhira ibizotongorwa n’umuriro,</para>
  <para style="q2" vid="HAB 2:13">n’amahanga akaruhira ubusa?<verse eid="HAB 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14" />Kuko isi izokwuzura ukumenya ubwiza bw’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="HAB 2:14">nk’uko amazi yuzura ikiyaga.<verse eid="HAB 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15" />“Azobona ibara uwuha inzoga mugenziwe,</para>
  <para style="q2" vid="HAB 2:15">akamusukira iyiri mu mubindi gushika aborewe,</para>
  <para style="q2" vid="HAB 2:15">kugira ngo abone ubwambure bwiwe.”<verse eid="HAB 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16" />Uzotwikirwa n’isoni mu gishingo c’icubahiro.</para>
  <para style="q2" vid="HAB 2:16">Ubu ni wewe uramukiwe!</para>
  <para style="q2" vid="HAB 2:16">Nunywe nawe, ubwambure bwawe bugaragare.</para>
  <para style="q1" vid="HAB 2:16">Igikombe co mu kuboko kw’i buryo kw’<char style="nd">Uhoraho</char> kirabashikiriye,</para>
  <para style="q2" vid="HAB 2:16">kandi ubumaramare ni bwo buzosubirira ubwiza bwanyu.<verse eid="HAB 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17" />Ibibi wakoreye Libani bizokurengera,</para>
  <para style="q2" vid="HAB 2:17">kandi agatikizo wagiriye inyamaswa zaho kazogutera ubwoba.</para>
  <para style="q1" vid="HAB 2:17">Kuko washeshe amaraso y’abantu,</para>
  <para style="q2" vid="HAB 2:17">utikiza ibihugu, ibisagara, hamwe n’ababibamwo bose.<verse eid="HAB 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18" />“Mbega igishushanyo kibazwa n’umuntu kimaze iki?</para>
  <para style="q2" vid="HAB 2:18">Canke ikibumbano kivuga ibinyoma?</para>
  <para style="q1" vid="HAB 2:18">Kuko ababibumba bizigira ivyo bakoze bo nyene;</para>
  <para style="q2" vid="HAB 2:18">bakora ibigirwamana bidashobora no kuvuga.<verse eid="HAB 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19" />Azobona ibara uwubwira igiti cumye ati: ‘Ba muzima!’</para>
  <para style="q2" vid="HAB 2:19">canke akabwira ibuye ati: ‘Kanguka!’</para>
  <para style="q1" vid="HAB 2:19">Mbega igishushanyo cokwereka inzira?</para>
  <para style="q2" vid="HAB 2:19">Cometseko ifeza n’inzahabu ahantu hose;</para>
  <para style="q2" vid="HAB 2:19">ntikigira ubuzima muri co.”<verse eid="HAB 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20" />Ariko <char style="nd">Uhoraho</char> avyagiye mu Ngoro yiwe yera;</para>
  <para style="q2" vid="HAB 2:20">amahanga yose nahwekere imbere yiwe.<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s1">Isengesho rya Habakuki</para>
  <para style="d">
    <verse number="1" style="v" sid="HAB 3:1" />Iri ni isengesho ry’umuvugishwa Habakuki, riririmbwa mw’ijwi rya Shigiyonoti.<verse eid="HAB 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2" />
    <char style="nd">Uhoraho</char>, numwise ukwamamara kwawe,</para>
  <para style="q2" vid="HAB 3:2">mpagarara ntewe ubwoba n’ibikorwa vyawe bitangaje, yewe <char style="nd">Uhoraho</char>.</para>
  <para style="q1" vid="HAB 3:2">Subira ubikore muri kino gihe cacu,</para>
  <para style="q2" vid="HAB 3:2">bimenyekanishe mu gihe co kubaho kwacu;</para>
  <para style="q2" vid="HAB 3:2">ariko mu burake bwawe, wibuke kugira imbabazi.<verse eid="HAB 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3" />Imana yazananye i Temani,</para>
  <para style="q2" vid="HAB 3:3">Uwera yaturutse ku musozi Parani. Sela.</para>
  <para style="q1" vid="HAB 3:3">Ubwiza bwayo bwari butwikiriye amajuru,</para>
  <para style="q2" vid="HAB 3:3">kandi amashimwe yayo yuzuye isi.<verse eid="HAB 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4" />Ubwiza bwayo bwari bumeze nk’izuba rirashe;</para>
  <para style="q2" vid="HAB 3:4">imishwarara yava mu kiganza cayo,</para>
  <para style="q2" vid="HAB 3:4">ahari hanyegejwe ububasha bwayo.<verse eid="HAB 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5" />Agatikizo kagendera imbere yayo;</para>
  <para style="q2" vid="HAB 3:5">akaranda kagakurikira ibirenge vyiwe.<verse eid="HAB 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6" />Maze irahagarara, inyiganyiza isi;</para>
  <para style="q2" vid="HAB 3:6">iritegereza, ijugumiza amahanga.</para>
  <para style="q1" vid="HAB 3:6">Imisozi yahozeho irasaduka,</para>
  <para style="q2" vid="HAB 3:6">n’imitumba ya kera cane irasenyuka.</para>
  <para style="q2" vid="HAB 3:6">Inzira zayo ni iz’ibihe bidashira.<verse eid="HAB 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7" />Nabonye amahema y’ab’i Kushani yuzuye umubabaro,</para>
  <para style="q2" vid="HAB 3:7">n’Abamidiyani aho baba hihebuye.<verse eid="HAB 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8" />Yewe <char style="nd">Uhoraho</char>, mbega wari urakiye inzuzi?</para>
  <para style="q2" vid="HAB 3:8">Uburake bwawe bwari ku masoko?</para>
  <para style="q1" vid="HAB 3:8">Mbega wari uhagurukiye ibiyaga</para>
  <para style="q2" vid="HAB 3:8">aho waza kw’ifarasi</para>
  <para style="q2" vid="HAB 3:8">no mu mikogote y’intsinzi?<verse eid="HAB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9" />Wasokoroye umuheto,</para>
  <para style="q2" vid="HAB 3:9">wegeranya imyampi myinshi. Sela.</para>
  <para style="q1" vid="HAB 3:9">Watandukanije isi ukoresheje inzuzi,<verse eid="HAB 3:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="HAB 3:10" />imisozi yarakubonye irashonga.</para>
  <para style="q1" vid="HAB 3:10">Amasumo y’amazi arahita,</para>
  <para style="q2" vid="HAB 3:10">i bwina mu kiyaga hakumvikana urwamo,</para>
  <para style="q2" vid="HAB 3:10">kigaterera imipfunda yaco hejuru.<verse eid="HAB 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11" />Izuba n’ukwezi birahagarara kw’ijuru</para>
  <para style="q2" vid="HAB 3:11">kubera imyampi irashwe,</para>
  <para style="q2" vid="HAB 3:11">n’ukurabagiza kw’icumu ryawe ritewe.<verse eid="HAB 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12" />Wagendagenze mu gihugu ufise umujinya,</para>
  <para style="q2" vid="HAB 3:12">uhonyangisha amahanga ugukara kwawe.<verse eid="HAB 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13" />Wazanywe no gucungura ubwoko bwawe,</para>
  <para style="q2" vid="HAB 3:13">no gukiza uwo wasize amavuta.</para>
  <para style="q1" vid="HAB 3:13">Wafyonyoye umutware w’igihugu cuzuye ikibi,</para>
  <para style="q2" vid="HAB 3:13">uramuvunagura kuva ku mutwe gushika ku birenge. Sela.<verse eid="HAB 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14" />Watobekeranishije umutwe wiwe icumu ryiwe,</para>
  <para style="q2" vid="HAB 3:14">igihe ingabo ziwe zari zije kudushwiragiza,</para>
  <para style="q1" vid="HAB 3:14">babikorana umunezero mwinshi ngo bahonye</para>
  <para style="q2" vid="HAB 3:14">umworo aho yari yinyegeje.<verse eid="HAB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15" />Wahonyangishije ikiyaga ifarasi zawe,</para>
  <para style="q2" vid="HAB 3:15">hamwe n’imikuba y’amazi menshi.<verse eid="HAB 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16" />Naravyumvise nsimbwa n’umutima,</para>
  <para style="q2" vid="HAB 3:16">iminwa yanje ijugumizwa n’iryo jwi;</para>
  <para style="q1" vid="HAB 3:16">ukubora kwinjira mu magufa yanje,</para>
  <para style="q2" vid="HAB 3:16">amaguru yanje arajugumira.</para>
  <para style="q1" vid="HAB 3:16">Ariko nzorindira nihanganye umusi w’amakuba,</para>
  <para style="q2" vid="HAB 3:16">aho uzozira kw’ihanga ryaduteye.<verse eid="HAB 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17" />Naho umusukoni wanje utoshurika,</para>
  <para style="q2" vid="HAB 3:17">inzabibu zanje ntizame,</para>
  <para style="q1" vid="HAB 3:17">naho umwimbu wa elayo worumba</para>
  <para style="q2" vid="HAB 3:17">imirima ntigire ico yera,</para>
  <para style="q1" vid="HAB 3:17">naho intama zohera mu rugo,</para>
  <para style="q2" vid="HAB 3:17">umukuku ugahera mu ruhongore,<verse eid="HAB 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18" />nzonezererwa <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="HAB 3:18">nzohimbarirwa Imana y’agakiza kanje.<verse eid="HAB 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19" />
    <char style="nd">Uhoraho</char> Nyeninganji ni we nkomezi zanje;</para>
  <para style="q2" vid="HAB 3:19">akomeza ibirenge vyanje nk’ivy’ingeregere,</para>
  <para style="q2" vid="HAB 3:19">anshoboza kugendera ku dutwe tw’imisozi.</para>
  <para style="d" vid="HAB 3:19">Ku mukuru w’abaririmvyi: Iri sengesho rizoririmbwe hakoreshejwe ibicurarangisho vy’imirya.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>