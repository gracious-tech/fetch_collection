  <para style="h">Intimba</para>
  <para style="toc1">Gucura intimba kwa Yeremiya</para>
  <para style="toc2">Intimba</para>
  <para style="toc3">Int</para>
  <para style="mt1">Gucura intimba</para>
  <para style="mt2">kwa Yeremiya</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1" />Ese ukuntu igisagara gisigaye ari umusaka,</para>
  <para style="q2" vid="LAM 1:1">kera cahora cuzuye abantu!</para>
  <para style="q1" vid="LAM 1:1">Ese ukuntu kimeze nk’umupfakazi,</para>
  <para style="q2" vid="LAM 1:1">kandi kera cahora gihambaye mu mahanga!</para>
  <para style="q1" vid="LAM 1:1">Cahora kimeze nk’umwamikazi mu zindi ntara</para>
  <para style="q2" vid="LAM 1:1">ariko ubu cabaye nk’umugurano.<verse eid="LAM 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2" />Mw’ijoro gicunduguta amosozi,</para>
  <para style="q2" vid="LAM 1:2">akagitemba ku matama.</para>
  <para style="q1" vid="LAM 1:2">Mu bahora bagikunda bose</para>
  <para style="q2" vid="LAM 1:2">nta n’umwe wo kugihoza.</para>
  <para style="q1" vid="LAM 1:2">Abagenzi baco bose baragihemukiye;</para>
  <para style="q2" vid="LAM 1:2">bahindutse abansi baco.<verse eid="LAM 1:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3" />Amaze kugira amarushwa menshi n’ugucumukura,</para>
  <para style="q2" vid="LAM 1:3">Yuda yajanywe ari inyagano.</para>
  <para style="q1" vid="LAM 1:3">Ubu aba hagati mu mahanga,</para>
  <para style="q2" vid="LAM 1:3">nta buragamo afise na mba.</para>
  <para style="q1" vid="LAM 1:3">Abamuhiga bose baramushikiriye</para>
  <para style="q2" vid="LAM 1:3">bamusanze mu mubabaro mwinshi.<verse eid="LAM 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4" />Amayira aja i Siyoni aragandaye,</para>
  <para style="q2" vid="LAM 1:4">kuko ata muntu n’umwe akija mu misi mikuru yashinzwe.</para>
  <para style="q1" vid="LAM 1:4">Amarembo yaho yose aripfumbereje,</para>
  <para style="q2" vid="LAM 1:4">abaherezi baho baraniha,</para>
  <para style="q1" vid="LAM 1:4">abagore baho bakiri bato barababaye</para>
  <para style="q2" vid="LAM 1:4">kandi hari ukwihebura kurenze urugero.<verse eid="LAM 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5" />Abamugwanya basigaye ari bo bamuganza;</para>
  <para style="q2" vid="LAM 1:5">abansi biwe baguwe neza.</para>
  <para style="q1" vid="LAM 1:5">
    <char style="nd">Uhoraho</char> yamuzanyeko imibabaro</para>
  <para style="q2" vid="LAM 1:5">kubera ivyaha vyiwe vyinshi.</para>
  <para style="q1" vid="LAM 1:5">Abana biwe bose batwawe nk’inyagano,</para>
  <para style="q2" vid="LAM 1:5">bacitse imbohe imbere y’abansi babo.<verse eid="LAM 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6" />Ubwiza bwose bwaraheze</para>
  <para style="q2" vid="LAM 1:6">ubwahora ku mukobwa w’i Siyoni.</para>
  <para style="q1" vid="LAM 1:6">Abaganwa baho bameze nk’impongokazi</para>
  <para style="q2" vid="LAM 1:6">yabuze aho irisha;</para>
  <para style="q1" vid="LAM 1:6">kubera intege nke zabo bakuye hasi barahunga</para>
  <para style="q2" vid="LAM 1:6">imbere y’uwabahiga.<verse eid="LAM 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7" />Mu misi y’umubabaro waho no kuburanirwa</para>
  <para style="q2" vid="LAM 1:7">Yerusalemu hibutse ubutunzi bwose</para>
  <para style="q2" vid="LAM 1:7">hari hafise mu misi ya kera.</para>
  <para style="q1" vid="LAM 1:7">Igihe abantu baho bagwa mu maboko y’umwansi,</para>
  <para style="q2" vid="LAM 1:7">ntihabonetse n’umwe wo kubatabara.</para>
  <para style="q1" vid="LAM 1:7">Abansi baho ubu baraharaba</para>
  <para style="q2" vid="LAM 1:7">bakitwengera babonye uburyo hasambuwe.<verse eid="LAM 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8" />Yerusalemu hakoze ivyaha vyinshi</para>
  <para style="q2" vid="LAM 1:8">ni co catumye hahumana.</para>
  <para style="q1" vid="LAM 1:8">Abahora bahubaha ubu barahakengera,</para>
  <para style="q2" vid="LAM 1:8">kuko babonye ubwambure bwaho;</para>
  <para style="q1" vid="LAM 1:8">ubwaho haraniha</para>
  <para style="q2" vid="LAM 1:8">hihindukiza.<verse eid="LAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9" />Ubuhumane bwaho buhomye ku vyambarwa hambaye;</para>
  <para style="q2" vid="LAM 1:9">ntihiyumviriye kuri kazoza kaho.</para>
  <para style="q1" vid="LAM 1:9">Ukugwa kwaho kwabaye ugukomeye;</para>
  <para style="q2" vid="LAM 1:9">kandi nta n’umwe wo kuhagarukirako.</para>
  <para style="q1" vid="LAM 1:9">“Yewe <char style="nd">Uhoraho</char>, raba umubabaro wanje,</para>
  <para style="q2" vid="LAM 1:9">kuko umwansi yanesheje.”<verse eid="LAM 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10" />Umwansi yasahuye</para>
  <para style="q2" vid="LAM 1:10">ubutunzi bwaho bwose;</para>
  <para style="q1" vid="LAM 1:10">habonye abanyamahanga batubaha Imana</para>
  <para style="q2" vid="LAM 1:10">binjira mu Ngoro,</para>
  <para style="q1" vid="LAM 1:10">abo wari warihanije ngo</para>
  <para style="q2" vid="LAM 1:10">ntibaze binjire mw’ikoraniro ryawe.<verse eid="LAM 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11" />Abantu baho bose baraniha</para>
  <para style="q2" vid="LAM 1:11">kuko barondera ico barya;</para>
  <para style="q1" vid="LAM 1:11">batanga ubutunzi bwabo ngo baronke ivyokurya</para>
  <para style="q2" vid="LAM 1:11">bashobore kuzigama ubuzima.</para>
  <para style="q1" vid="LAM 1:11">“Ewe <char style="nd">Uhoraho</char>, raba kandi wongere witegereze,</para>
  <para style="q2" vid="LAM 1:11">ukuntu nkengerewe.”<verse eid="LAM 1:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12" />“Mbega mwebwe murengana nta co bibabwiye?</para>
  <para style="q2" vid="LAM 1:12">Nimuhindukire hirya no hino murabe.</para>
  <para style="q1" vid="LAM 1:12">Mbega hari ukubabazwa guhwanye n’uku kwanje</para>
  <para style="q2" vid="LAM 1:12">ukwo nahawe n’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="LAM 1:12">ku musi w’uburake bwiwe bw’inkazi?<verse eid="LAM 1:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13" />Yarungitse umuriro ari iyo hejuru,</para>
  <para style="q2" vid="LAM 1:13">awurungika mu magufa yanje.</para>
  <para style="q1" vid="LAM 1:13">Yagaranzuye urusenga rufata amaguru yanje</para>
  <para style="q2" vid="LAM 1:13">maze ansubiza inyuma.</para>
  <para style="q1" vid="LAM 1:13">Yansize ndi umusaka,</para>
  <para style="q2" vid="LAM 1:13">kandi nguma mu mubabaro rikarinda rirenga.<verse eid="LAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14" />Ivyaha vyanje yabiboheye hamwe bicika ingogo,</para>
  <para style="q2" vid="LAM 1:14">yavyegeranishije ukuboko kwiwe.</para>
  <para style="q1" vid="LAM 1:14">Vyaraje bishika no kw’izosi ryanje</para>
  <para style="q2" vid="LAM 1:14">kandi Imana yatumye inkomezi zanje zisambuka.</para>
  <para style="q1" vid="LAM 1:14">Yandekuriye mu maboko</para>
  <para style="q2" vid="LAM 1:14">y’abo ntashobora no guhagarara imbere.<verse eid="LAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15" />Imana yaranse</para>
  <para style="q2" vid="LAM 1:15">abagwanyi banje bose bari kumwe nanje;</para>
  <para style="q1" vid="LAM 1:15">yahamagariye ingabo zose kungwanya</para>
  <para style="q2" vid="LAM 1:15">kugira ngo bamene umutwe abasore banje.</para>
  <para style="q1" vid="LAM 1:15">Imana yahonyanze Umukobwa w’i Buyuda,</para>
  <para style="q2" vid="LAM 1:15">nka kurya baganira umuvinyu mu bwato.<verse eid="LAM 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16" />Ni co gituma ndira</para>
  <para style="q2" vid="LAM 1:16">amaso yanje akaba yuzuye amosozi.</para>
  <para style="q1" vid="LAM 1:16">Kandi nta n’umwe ari hafi wo kumpoza</para>
  <para style="q2" vid="LAM 1:16">nta n’umwe wo kuremesha impwemu yanje.</para>
  <para style="q1" vid="LAM 1:16">Abana banje bakuweho</para>
  <para style="q2" vid="LAM 1:16">kuko umwansi yaturushije inkomezi.”<verse eid="LAM 1:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17" />I Siyoni hamanitse amaboko,</para>
  <para style="q2" vid="LAM 1:17">ariko nta n’umwe yabonetse wo kuhahoza.</para>
  <para style="q1" vid="LAM 1:17">Kw’itegeko ry’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="LAM 1:17">ababanyi ba Yakobo bamuhindukiye abansi;</para>
  <para style="q1" vid="LAM 1:17">i Yerusalemu habahindukiye</para>
  <para style="q2" vid="LAM 1:17">nk’ikintu gihumanye hagati muri bo.<verse eid="LAM 1:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18" />“<char style="nd">Uhoraho</char> aragororotse,</para>
  <para style="q2" vid="LAM 1:18">ariko nagararije ivyo yategetse.</para>
  <para style="q1" vid="LAM 1:18">Nimwumve, yemwe mahanga mwese;</para>
  <para style="q2" vid="LAM 1:18">nimurabe umubabaro wanje.</para>
  <para style="q1" vid="LAM 1:18">Abasore banje n’inkumi zanje</para>
  <para style="q2" vid="LAM 1:18">bajanywe nk’inyagano.<verse eid="LAM 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19" />Natumyeko abakunzi banje</para>
  <para style="q2" vid="LAM 1:19">ariko barampemukiye.</para>
  <para style="q1" vid="LAM 1:19">Abaherezi banje n’inararibonye zanje</para>
  <para style="q2" vid="LAM 1:19">bahoneye mu gisagara</para>
  <para style="q1" vid="LAM 1:19">mu gihe bariko bararondera indya</para>
  <para style="q2" vid="LAM 1:19">ngo barabe ko boba barabayeho.<verse eid="LAM 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20" />Raba, yewe <char style="nd">Uhoraho</char>, ingene ndi mu magorwa!</para>
  <para style="q2" vid="LAM 1:20">Muri jewe nuzuye uruhagarara,</para>
  <para style="q1" vid="LAM 1:20">kandi mu mutima ndahungabanye,</para>
  <para style="q2" vid="LAM 1:20">kuko nabaye umugarariji arushirije.</para>
  <para style="q1" vid="LAM 1:20">Hanze, inkota yampekuye abana banje;</para>
  <para style="q2" vid="LAM 1:20">mu nzu na ho ni urupfu gusa.<verse eid="LAM 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21" />Abantu bumvise ukuniha kwanje,</para>
  <para style="q2" vid="LAM 1:21">ariko nta n’umwe wo kumpoza.</para>
  <para style="q1" vid="LAM 1:21">Abansi banje bose bumvise amagorwa yanje;</para>
  <para style="q2" vid="LAM 1:21">banezererwa ivyo wakoze.</para>
  <para style="q1" vid="LAM 1:21">Ndakwinginze ngo ubashitseko wa musi wavuga</para>
  <para style="q2" vid="LAM 1:21">ngo na bo bamere nkanje.<verse eid="LAM 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22" />Ivyo bagabitanije vyose nibije imbere yawe;</para>
  <para style="q2" vid="LAM 1:22">ubakorere</para>
  <para style="q1" vid="LAM 1:22">nk’ivyo wankoreye</para>
  <para style="q2" vid="LAM 1:22">kubera ivyaha vyanje.</para>
  <para style="q1" vid="LAM 1:22">Ukuniha kwanje ni kwinshi</para>
  <para style="q2" vid="LAM 1:22">kandi umutima wanje ucitse intege.”<verse eid="LAM 1:22" /></para>
  <para style="b" />
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1" />Ese ukuntu Imana yatwikirije umukobwa w’i Siyoni</para>
  <para style="q2" vid="LAM 2:1">igicu c’uburake bwayo!</para>
  <para style="q1" vid="LAM 2:1">Yahomvoreye hasi ubwiza bwa Isirayeli,</para>
  <para style="q2" vid="LAM 2:1">ibukura mw’ijuru ibukororera mw’isi;</para>
  <para style="q1" vid="LAM 2:1">ntiyibutse indava y’ibirenge vyayo</para>
  <para style="q2" vid="LAM 2:1">ku musi w’uburake bwayo.<verse eid="LAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2" />Imana yamize miyonzwa</para>
  <para style="q2" vid="LAM 2:2">imihana ya Yakobo;</para>
  <para style="q1" vid="LAM 2:2">mu burake bwayo yasubije hasi</para>
  <para style="q2" vid="LAM 2:2">ahazitijwe inzitiro z’umukobwa w’i Buyuda.</para>
  <para style="q1" vid="LAM 2:2">Kandi ubwami bwaho n’abaganwa baho</para>
  <para style="q2" vid="LAM 2:2">yabisenyuriye hasi biri mu biteterwe.<verse eid="LAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3" />Mu burake bwayo bw’inkazi yavunye</para>
  <para style="q2" vid="LAM 2:3">ihembe ryose ry’Abisirayeli.</para>
  <para style="q1" vid="LAM 2:3">Yakuyemwo ukuboko kwayo kw’i buryo</para>
  <para style="q2" vid="LAM 2:3">igihe umwansi yari yegereje.</para>
  <para style="q1" vid="LAM 2:3">Mu ba Yakobo yatse kurya kw’umuriro utongora</para>
  <para style="q2" vid="LAM 2:3">uturira ibintu vyose biri i ruhande yawo.<verse eid="LAM 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4" />Yafoye umuheto wiwe nk’umwansi,</para>
  <para style="q2" vid="LAM 2:4">ukuboko kwiwe kw’i buryo kuriteguye.</para>
  <para style="q1" vid="LAM 2:4">Yabaye nk’umwansi mu kwica</para>
  <para style="q2" vid="LAM 2:4">abantu bose b’igikundiro;</para>
  <para style="q1" vid="LAM 2:4">yasutse uburake bwiwe nk’umuriro</para>
  <para style="q2" vid="LAM 2:4">kw’ihema ry’umukobwa w’i Siyoni.<verse eid="LAM 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5" />Imana yabaye nk’umwansi;</para>
  <para style="q2" vid="LAM 2:5">yamize Isirayeli atamuhekenye.</para>
  <para style="q1" vid="LAM 2:5">Yamize adahekenye ibirimba vyaho</para>
  <para style="q2" vid="LAM 2:5">asenyurira hasi inyubako zaho zikomeye.</para>
  <para style="q1" vid="LAM 2:5">Yagwije ikigandaro n’ugucura intimba</para>
  <para style="q2" vid="LAM 2:5">ku mukobwa w’i Buyuda.<verse eid="LAM 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6" />Yasambuye aho yaba hahinduka agahinga,</para>
  <para style="q2" vid="LAM 2:6">yasambuye ikibanza ciwe c’amakoraniro.</para>
  <para style="q1" vid="LAM 2:6">
    <char style="nd">Uhoraho</char> yatumye i Siyoni hibagira</para>
  <para style="q2" vid="LAM 2:6">imisi mikuru yategekanijwe yaho n’amasabato;</para>
  <para style="q1" vid="LAM 2:6">mu bushangashirwe bwiwe yakengereye</para>
  <para style="q2" vid="LAM 2:6">umwami n’umuherezi.<verse eid="LAM 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7" />
    <char style="nd">Uhoraho</char> yashiburiye kure igicaniro ciwe</para>
  <para style="q2" vid="LAM 2:7">yahevye ahera hiwe.</para>
  <para style="q1" vid="LAM 2:7">Inzitiro z’ibirimba vyiwe yabirekuriye</para>
  <para style="q2" vid="LAM 2:7">mu maboko y’umwansi;</para>
  <para style="q1" vid="LAM 2:7">bavugirije akamo mu Ngoro y’Imana</para>
  <para style="q2" vid="LAM 2:7">nk’uko vyahora mu gihe c’umusi mukuru washinzwe.<verse eid="LAM 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8" />
    <char style="nd">Uhoraho</char> yahisemwo gusambura</para>
  <para style="q2" vid="LAM 2:8">uruzitiro rukikije umukobwa w’i Siyoni.</para>
  <para style="q1" vid="LAM 2:8">Yagoroye umugozi wo gupima</para>
  <para style="q2" vid="LAM 2:8">kandi ntiyabujije ukuboko kwiwe ngo ntigusambure.</para>
  <para style="q1" vid="LAM 2:8">Yahinduye impome n’inzitiro agacurantimba;</para>
  <para style="q2" vid="LAM 2:8">vyose vyahindutse umusaka.<verse eid="LAM 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9" />Amarembo yaho yasenyukiye hasi;</para>
  <para style="q2" vid="LAM 2:9">ibihindizo vyayo vyaravunaguwe birasamburwa.</para>
  <para style="q1" vid="LAM 2:9">Umwami waho n’abaganwa bacitse inyagano mu mahanga,</para>
  <para style="q2" vid="LAM 2:9">nta vyagezwe bikiriho,</para>
  <para style="q1" vid="LAM 2:9">kandi abavugishwa baho ntibakibona</para>
  <para style="q2" vid="LAM 2:9">ivyo berekwa bivuye k’<char style="nd">Uhoraho</char>.<verse eid="LAM 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10" />Inararibonye z’umukobwa w’i Siyoni</para>
  <para style="q2" vid="LAM 2:10">zicaye hasi, ntibakurako umunwa;</para>
  <para style="q1" vid="LAM 2:10">bisuriye umukungugu ku mitwe</para>
  <para style="q2" vid="LAM 2:10">bambara amagunira.</para>
  <para style="q1" vid="LAM 2:10">Abakobwa b’i Yerusalemu</para>
  <para style="q2" vid="LAM 2:10">bunamitse imitwe yabo mw’ivu.<verse eid="LAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11" />Amaso yanje ananiwe no kurira,</para>
  <para style="q2" vid="LAM 2:11">muri jewe huzuye uruhagarara,</para>
  <para style="q1" vid="LAM 2:11">umutima wanje usutswe hasi kw’isi</para>
  <para style="q2" vid="LAM 2:11">kuko abantu banje basanganguwe,</para>
  <para style="q1" vid="LAM 2:11">kuko abana n’inzoya bapfira</para>
  <para style="q2" vid="LAM 2:11">mu mabarabara yo mu gisagara.<verse eid="LAM 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12" />Babwira ba nyina bati:</para>
  <para style="q2" vid="LAM 2:12">“Umukate n’umuvinyu biri hehe?”</para>
  <para style="q1" vid="LAM 2:12">mu gihe bariko bararaba nk’abakomeretse</para>
  <para style="q2" vid="LAM 2:12">mu mabarabara y’igisagara,</para>
  <para style="q1" vid="LAM 2:12">maze ubuzima bukabavamwo</para>
  <para style="q2" vid="LAM 2:12">bari mu maboko ya ba nyina.<verse eid="LAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13" />Mbega mvuge iki kuri wewe?</para>
  <para style="q2" vid="LAM 2:13">Mbega nokugereranya n’iki,</para>
  <para style="q2" vid="LAM 2:13">ga yewe mukobwa w’i Yerusalemu?</para>
  <para style="q1" vid="LAM 2:13">Nogushushanya n’iki,</para>
  <para style="q2" vid="LAM 2:13">kugira ngo nshobore kukuremesha,</para>
  <para style="q2" vid="LAM 2:13">ga yewe mukobwa w’i Siyoni?</para>
  <para style="q1" vid="LAM 2:13">Igikomere cawe gishika kure nk’ikiyaga.</para>
  <para style="q2" vid="LAM 2:13">None ni nde yogukiza?<verse eid="LAM 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14" />Ivyo abavugishwa bawe beretswe</para>
  <para style="q2" vid="LAM 2:14">vyari ibinyoma bitagira akamaro;</para>
  <para style="q1" vid="LAM 2:14">ntibakweretse icaha cawe</para>
  <para style="q2" vid="LAM 2:14">ngo bigukize kujanwa uri inyagano.</para>
  <para style="q1" vid="LAM 2:14">Ivyo bavugishijwe imbere yawe</para>
  <para style="q2" vid="LAM 2:14">vyari ibinyoma bizimiza.<verse eid="LAM 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15" />Abaca aho uri</para>
  <para style="q2" vid="LAM 2:15">bifata ku munwa;</para>
  <para style="q1" vid="LAM 2:15">bakavuza agahwa bazunguza imitwe</para>
  <para style="q2" vid="LAM 2:15">ku bw’umukobwa w’i Yerusalemu bati:</para>
  <para style="q1" vid="LAM 2:15">“Iki ni ca gisagara citwa</para>
  <para style="q2" vid="LAM 2:15">ubwiza busumba ubundi bwose,</para>
  <para style="q2" vid="LAM 2:15">umunezero w’isi yose?”<verse eid="LAM 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16" />Abansi bawe bose barasamye</para>
  <para style="q2" vid="LAM 2:16">kandi basamira wewe;</para>
  <para style="q1" vid="LAM 2:16">bavuza agahwa bagahekenya amenyo</para>
  <para style="q2" vid="LAM 2:16">bavuga bati: “Twamumize tutamuhekenye.</para>
  <para style="q1" vid="LAM 2:16">Uyu ni wa musi twari turindiriye;</para>
  <para style="q2" vid="LAM 2:16">twabayeho ngo tuwubone.”<verse eid="LAM 2:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17" />
    <char style="nd">Uhoraho</char> yakoze ivyo yari yarateguye;</para>
  <para style="q2" vid="LAM 2:17">yashikije ijambo ryiwe,</para>
  <para style="q2" vid="LAM 2:17">iryo yari yaravuze kera.</para>
  <para style="q1" vid="LAM 2:17">Yaragusambuye ata kagongwe,</para>
  <para style="q2" vid="LAM 2:17">yatumye umwansi anezererwa ivyago vyawe,</para>
  <para style="q2" vid="LAM 2:17">yashize hejuru ihembe ry’abansi bawe.<verse eid="LAM 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18" />Imitima y’abantu</para>
  <para style="q2" vid="LAM 2:18">itakambira Imana.</para>
  <para style="q1" vid="LAM 2:18">Yewe nzitiro z’umukobwa w’i Siyoni,</para>
  <para style="q2" vid="LAM 2:18">amosozi yawe nacuncubuke nk’uruzi</para>
  <para style="q2" vid="LAM 2:18">ku murango no mw’ijoro;</para>
  <para style="q1" vid="LAM 2:18">kandi nturuhuke,</para>
  <para style="q2" vid="LAM 2:18">n’amaso yawe ntaruhuke.<verse eid="LAM 2:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19" />Va hasi, boroga mw’ijoro,</para>
  <para style="q2" vid="LAM 2:19">abateramyi bagitangura;</para>
  <para style="q1" vid="LAM 2:19">suka umutima wawe nk’amazi</para>
  <para style="q2" vid="LAM 2:19">imbere y’Imana.</para>
  <para style="q1" vid="LAM 2:19">Mumutarikire ibiganza</para>
  <para style="q2" vid="LAM 2:19">kubera ubuzima bw’abana banyu,</para>
  <para style="q1" vid="LAM 2:19">baraba kubera inzara</para>
  <para style="q2" vid="LAM 2:19">ku mpande zose z’amabarabara.<verse eid="LAM 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20" />“Raba, yewe <char style="nd">Uhoraho</char>, kandi ubibabare:</para>
  <para style="q2" vid="LAM 2:20">Ni nde wigeze ugirira nk’ibi?</para>
  <para style="q1" vid="LAM 2:20">Mbega abagore borya abana bivyariye,</para>
  <para style="q2" vid="LAM 2:20">abana birereye?</para>
  <para style="q1" vid="LAM 2:20">Abaherezi n’abavugishwa bokwicirwa</para>
  <para style="q2" vid="LAM 2:20">mu Ngoro y’Imana?<verse eid="LAM 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21" />Abana n’abakuze barambaraye hamwe</para>
  <para style="q2" vid="LAM 2:21">mu mukungugu wo mu mabarabara;</para>
  <para style="q1" vid="LAM 2:21">abasore banje n’abigeme</para>
  <para style="q2" vid="LAM 2:21">bishwe n’inkota.</para>
  <para style="q1" vid="LAM 2:21">Wabasogose ku musi w’uburake bwawe;</para>
  <para style="q2" vid="LAM 2:21">ubacumita ata kagongwe.<verse eid="LAM 2:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22" />Nk’uko utumira abantu ku musi mukuru,</para>
  <para style="q2" vid="LAM 2:22">ni ko watumiye abaza kuntera ubwoba impande zose.</para>
  <para style="q1" vid="LAM 2:22">Ku musi w’uburake bwawe</para>
  <para style="q2" vid="LAM 2:22">nta n’umwe yashoboye guhunga canke ngo asigare;</para>
  <para style="q1" vid="LAM 2:22">abo nivyariye nkabirerera,</para>
  <para style="q2" vid="LAM 2:22">umwansi wanje yarabariritse.”<verse eid="LAM 2:22" /></para>
  <para style="b" />
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1" />Ndi umuntu yabonye imibabaro</para>
  <para style="q2" vid="LAM 3:1">bivuye ku nkoni y’uburake bw’<char style="nd">Uhoraho</char>.<verse eid="LAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2" />Yantwaye kure atuma ngendera</para>
  <para style="q2" vid="LAM 3:2">mu mwijima atari mu muco;<verse eid="LAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3" />ni ukuri, ukuboko kwiwe kwahindukiriye kungwanya,</para>
  <para style="q2" vid="LAM 3:3">kwongera kwisubiriza, rikarinda rirenga.<verse eid="LAM 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4" />Yatumye urukoba rwanje n’umubiri wanje bisaza</para>
  <para style="q2" vid="LAM 3:4">kandi yavunaguye amagufa yanje.<verse eid="LAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5" />Yaranyugarije ankikiza</para>
  <para style="q2" vid="LAM 3:5">umururazi n’ingorane.<verse eid="LAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6" />Yampaye kuba mu mwiza</para>
  <para style="q2" vid="LAM 3:6">nk’abapfuye kera.<verse eid="LAM 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7" />Yanyubakiye uruzitiro ngo sinshobore guhunga;</para>
  <para style="q2" vid="LAM 3:7">yambohesheje iminyororo.<verse eid="LAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8" />Mbere n’iyo ntakamvye canke ngatabaza nsaba uwomfasha,</para>
  <para style="q2" vid="LAM 3:8">yugaranira hanze ugusenga kwanje.<verse eid="LAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9" />Yugarishije inzira yanje ibihongo vy’amabuye;</para>
  <para style="q2" vid="LAM 3:9">yatumye inzira zanje zigoramanga.<verse eid="LAM 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10" />Nk’idubu riryamira kwica,</para>
  <para style="q2" vid="LAM 3:10">nk’intambwe ibunda irindiriye ico ifata,<verse eid="LAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11" />ni ko yankuye mu nzira arantabagura,</para>
  <para style="q2" vid="LAM 3:11">ansiga ntagira gitabara.<verse eid="LAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12" />Yafoye umuheto wiwe</para>
  <para style="q2" vid="LAM 3:12">antumberezako imyampi yiwe.<verse eid="LAM 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13" />Yatobekeranishije umutima wanje</para>
  <para style="q2" vid="LAM 3:13">imyampi akuye mu bubiko bwiwe.<verse eid="LAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14" />Nahindutse ikiyago c’abantu banje bose iyo bagomba kuba baratwenga;</para>
  <para style="q2" vid="LAM 3:14">bantwengera mu ndirimbo zabo rikarinda rirenga.<verse eid="LAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15" />Yangaburiye ivyatsi birura,</para>
  <para style="q2" vid="LAM 3:15">anywesha ibirura cane.<verse eid="LAM 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16" />Amenyo yanje yayahongoje kurya urucekeri rw’amabuye;</para>
  <para style="q2" vid="LAM 3:16">yantsindagiye mu mukungugu.<verse eid="LAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17" />Yarambujije kuronka amahoro;</para>
  <para style="q2" vid="LAM 3:17">nibagiye icitwa gutera imbere.<verse eid="LAM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18" />Maze ndavuga nti: “Ubwiza bwanje buraheze</para>
  <para style="q2" vid="LAM 3:18">hamwe n’ivyo nari niteze k’<char style="nd">Uhoraho</char> vyose.”<verse eid="LAM 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19" />Nibuka umubabaro wanje no kwama nangara,</para>
  <para style="q2" vid="LAM 3:19">kwama ku mururazi n’uburozi.<verse eid="LAM 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20" />Ndavyibuka vyose neza,</para>
  <para style="q2" vid="LAM 3:20">umutima wanje ukadendebukirwa.<verse eid="LAM 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21" />Ariko ibi ni vyo nibuka</para>
  <para style="q2" vid="LAM 3:21">bikantera ivyizigiro:<verse eid="LAM 3:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22" />Ni uko kubera urukundo ruhambaye rw’<char style="nd">Uhoraho</char> tutazoherengetezwa,</para>
  <para style="q2" vid="LAM 3:22">kuko imbabazi ziwe zamaho ibihe vyose.<verse eid="LAM 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23" />Zama ari nsha uko bukeye;</para>
  <para style="q2" vid="LAM 3:23">ubwizigirwa bwawe buratangaje.<verse eid="LAM 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24" />Ndibwira muri jewe nti: “<char style="nd">Uhoraho</char> ni we mugabane wanje;</para>
  <para style="q2" vid="LAM 3:24">ni co gituma nzomwitega.”<verse eid="LAM 3:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25" />
    <char style="nd">Uhoraho</char> agirira neza abamwiteze,</para>
  <para style="q2" vid="LAM 3:25">abamurondera bose;<verse eid="LAM 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26" />ni vyiza kwitega ducereje</para>
  <para style="q2" vid="LAM 3:26">agakiza k’<char style="nd">Uhoraho</char>.<verse eid="LAM 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27" />Ni vyiza ko umuntu yikorera ingogo</para>
  <para style="q2" vid="LAM 3:27">igihe akiri muto.<verse eid="LAM 3:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28" />Niyicare wenyene acereje,</para>
  <para style="q2" vid="LAM 3:28">kuko <char style="nd">Uhoraho</char> yayimuremetse.<verse eid="LAM 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29" />Niyubike mu maso hiwe,</para>
  <para style="q2" vid="LAM 3:29">kuko kumbure haracariho ivyizigiro.<verse eid="LAM 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30" />Natege umusaya wiwe uwuwukubita,</para>
  <para style="q2" vid="LAM 3:30">yuzure ibiteterwe.<verse eid="LAM 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31" />Kuko Imana atawe</para>
  <para style="q2" vid="LAM 3:31">iheba burundu.<verse eid="LAM 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32" />Naho ateza umubabaro, azogira ikigongwe,</para>
  <para style="q2" vid="LAM 3:32">urukundo rwiwe rwinshi rwamaho.<verse eid="LAM 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33" />Kuko atazana imibabaro abishaka</para>
  <para style="q2" vid="LAM 3:33">canke ngo ababaze umuntu n’umwe.<verse eid="LAM 3:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34" />Gufyonyorera musi y’ibirenge</para>
  <para style="q2" vid="LAM 3:34">imbohe zose zo mu gihugu,<verse eid="LAM 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35" />kwima abantu uburenganzira bwabo</para>
  <para style="q2" vid="LAM 3:35">imbere y’Iyisumbavyose,<verse eid="LAM 3:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36" />kurenganya umuntu mu rubanza,</para>
  <para style="q2" vid="LAM 3:36">mbega Imana ntizobibona?<verse eid="LAM 3:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37" />Ni nde yovuga ibintu bikaba</para>
  <para style="q2" vid="LAM 3:37">Imana itari yo yabitegetse?<verse eid="LAM 3:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38" />Mbega si mu kanwa k’Iyisumbavyose</para>
  <para style="q2" vid="LAM 3:38">hava ivyago n’ivyiza?<verse eid="LAM 3:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39" />None ni igiki gituma umuntu yidodomba</para>
  <para style="q2" vid="LAM 3:39">nimba ahaniwe ivyaha vyiwe?<verse eid="LAM 3:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40" />Nimuze twisuzume turabe inzira zacu,</para>
  <para style="q2" vid="LAM 3:40">maze tugaruke k’<char style="nd">Uhoraho</char>.<verse eid="LAM 3:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41" />Dutarikire imitima yacu n’amaboko yacu</para>
  <para style="q2" vid="LAM 3:41">Imana yo mw’ijuru, tuvuge tuti:<verse eid="LAM 3:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42" />“Twaragucumuyeko turakugarariza</para>
  <para style="q2" vid="LAM 3:42">nawe ntiwatubabariye.<verse eid="LAM 3:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43" />Witwikiriye uburake, maze uradukinagiza;</para>
  <para style="q2" vid="LAM 3:43">utwica ata kagongwe.<verse eid="LAM 3:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44" />Wipfutse igicu</para>
  <para style="q2" vid="LAM 3:44">kugira ngo ugusenga ntikugushikire.<verse eid="LAM 3:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45" />Waduhinduye nk’umwavu n’agakengerwe</para>
  <para style="q2" vid="LAM 3:45">mu mahanga.<verse eid="LAM 3:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46" />Abansi bacu bose buguruye akanwa kabo</para>
  <para style="q2" vid="LAM 3:46">cane mu kutugwanya.<verse eid="LAM 3:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47" />Twabaye mu mibabaro itewe n’ubwoba no gutsindwa,</para>
  <para style="q2" vid="LAM 3:47">imisaka no gusangangurwa.”<verse eid="LAM 3:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48" />Imigende y’amosozi itemba iva mu maso yanje</para>
  <para style="q2" vid="LAM 3:48">kuko ubwoko bwanje buranduwe.<verse eid="LAM 3:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49" />Amaso yanje azorira ubudahengeshanya,</para>
  <para style="q2" vid="LAM 3:49">ata guhozwa,<verse eid="LAM 3:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50" />kugeza <char style="nd">Uhoraho</char> aravye kw’isi</para>
  <para style="q2" vid="LAM 3:50">ari mw’ijuru akabibona.<verse eid="LAM 3:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51" />Ivyo mbona binzanira umubabaro mu mutima</para>
  <para style="q2" vid="LAM 3:51">kubera abagore bo mu gisagara cacu.<verse eid="LAM 3:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52" />Ababaye abansi banje ata nyanduruko,</para>
  <para style="q2" vid="LAM 3:52">bampiga nk’inyoni.<verse eid="LAM 3:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53" />Bagerageje kunsuka mu cobo</para>
  <para style="q2" vid="LAM 3:53">maze bandundako amabuye;<verse eid="LAM 3:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54" />amazi yarandengeye ku mutwe,</para>
  <para style="q2" vid="LAM 3:54">maze ndihebura ko nzimanganye.<verse eid="LAM 3:54" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55" />Nambaje izina ryawe, yewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="LAM 3:55">ndi i bwina bw’icobo.<verse eid="LAM 3:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56" />Wumvise ugutaka kwanje: “Ntiwugare amatwi ngo ureke kwumva</para>
  <para style="q2" vid="LAM 3:56">ugutakamba kwanje ndondera ugutabarwa.”<verse eid="LAM 3:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57" />Waregereye igihe nagutakambira,</para>
  <para style="q2" vid="LAM 3:57">maze uvuga uti: “Ntutinye.”<verse eid="LAM 3:57" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58" />Ewe Mana, wafashe mu minwe urubanza rwanje;</para>
  <para style="q2" vid="LAM 3:58">wacunguye ubugingo bwanje.<verse eid="LAM 3:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59" />Ewe <char style="nd">Uhoraho</char>, wabonye ibibi nagiriwe.</para>
  <para style="q2" vid="LAM 3:59">Ncira urunkiza!<verse eid="LAM 3:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60" />Wabonye uburyo bagomba kunyihora,</para>
  <para style="q2" vid="LAM 3:60">wabonye imigabo yose bangiriye.<verse eid="LAM 3:60" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61" />Yewe <char style="nd">Uhoraho</char> wumvise ibitutsi vyabo,</para>
  <para style="q2" vid="LAM 3:61">n’inama bangira zose,<verse eid="LAM 3:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62" />ivyo abansi banje bongorerana bakagabira</para>
  <para style="q2" vid="LAM 3:62">kuri jewe rikarenda rirenga.<verse eid="LAM 3:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63" />Barabe! Bicaye canke bahagaze,</para>
  <para style="q2" vid="LAM 3:63">bavuga amajambo y’agahemo mu mvyino zabo zose.<verse eid="LAM 3:63" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64" />Basubirize mu nkoko ivyo bakwiranye, yewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="LAM 3:64">ku vyo amaboko yabo yakoze.<verse eid="LAM 3:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65" />Shira uruhumyi ku mitima yabo,</para>
  <para style="q2" vid="LAM 3:65">kandi umuvumo wawe ube kuri bo!<verse eid="LAM 3:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66" />Ubakurikire mu burake bwawe maze ubaherengeteze</para>
  <para style="q2" vid="LAM 3:66">musi y’amajuru y’<char style="nd">Uhoraho</char>.<verse eid="LAM 3:66" /></para>
  <para style="b" />
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1" />Ese ukuntu inzahabu yacuye,</para>
  <para style="q2" vid="LAM 4:1">inzahabu nziza yataye ubwiza bwayo!</para>
  <para style="q1" vid="LAM 4:1">Amabuye y’urusengero yandagaye hasi</para>
  <para style="q2" vid="LAM 4:1">mu mayira no mu mpande zose.<verse eid="LAM 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2" />Ese ukuntu abahungu beza b’i Siyoni,</para>
  <para style="q2" vid="LAM 4:2">bahora baremereye nk’inzahabu,</para>
  <para style="q1" vid="LAM 4:2">ubu bameze nk’inkono z’ibumba,</para>
  <para style="q2" vid="LAM 4:2">igikorwa c’amaboko y’umubumvyi!<verse eid="LAM 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3" />N’imbwebwe zironsa</para>
  <para style="q2" vid="LAM 4:3">mu kugaburira ivyana vyazo,</para>
  <para style="q1" vid="LAM 4:3">ariko abantu banje babaye abatagira umutima</para>
  <para style="q2" vid="LAM 4:3">bameze nk’ikinyoni citwa otirishe mu bugaragwa.<verse eid="LAM 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4" />Kubera inyota ururimi rw’uruhinja</para>
  <para style="q2" vid="LAM 4:4">rwafatanye n’amagage;</para>
  <para style="q1" vid="LAM 4:4">abana barasega umukate,</para>
  <para style="q2" vid="LAM 4:4">ariko nta n’umwe abaha na mba.<verse eid="LAM 4:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5" />Abahora barya ibishwashwagira</para>
  <para style="q2" vid="LAM 4:5">bishwe n’inzara mu mayira.</para>
  <para style="q1" vid="LAM 4:5">Abakuze bambara impuzu z’inyambarabami</para>
  <para style="q2" vid="LAM 4:5">ubu barara ku magunira y’imyavu.<verse eid="LAM 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6" />Igihano c’abantu banje</para>
  <para style="q2" vid="LAM 4:6">kirengeye ic’ab’i Sodomu,</para>
  <para style="q1" vid="LAM 4:6">bamwe barandurwa mu kanya isase</para>
  <para style="q2" vid="LAM 4:6">ata wo kubatabara.<verse eid="LAM 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7" />Abaganwa baho barera derere kurusha shelegi</para>
  <para style="q2" vid="LAM 4:7">mbere barera kurusha n’amata,</para>
  <para style="q1" vid="LAM 4:7">imibiri yabo yari ikomeye nk’amabuye,</para>
  <para style="q2" vid="LAM 4:7">mu maso habo basa n’ibuye ry’agaciro ryitwa lapisi lazuli.<verse eid="LAM 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8" />Ariko ubu barirabura kurusha umwijima w’umuzitanya;</para>
  <para style="q2" vid="LAM 4:8">mu nzira nta wushobora kubamenya.</para>
  <para style="q1" vid="LAM 4:8">Urukoba rwabo rwafatanye n’amagufa yabo;</para>
  <para style="q2" vid="LAM 4:8">rwarumye nk’inkoni.<verse eid="LAM 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9" />Abicwa n’inkota bapfa neza kuruta</para>
  <para style="q2" vid="LAM 4:9">abicwa n’ikigoyi.</para>
  <para style="q1" vid="LAM 4:9">Kubera gusonza, barapfa</para>
  <para style="q2" vid="LAM 4:9">bishwe no kubura ivyokurya vyo mu mirima.<verse eid="LAM 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10" />Abagore, naho bagirira impuhwe abana babo,</para>
  <para style="q2" vid="LAM 4:10">barabatetse n’amaboko yabo,</para>
  <para style="q1" vid="LAM 4:10">maze barabarya</para>
  <para style="q2" vid="LAM 4:10">igihe abantu banje bariko barahona.<verse eid="LAM 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11" />
    <char style="nd">Uhoraho</char> yadusutseko uburake bwiwe bwose;</para>
  <para style="q2" vid="LAM 4:11">yarekuye uburake bwiwe bwaka nk’umuriro.</para>
  <para style="q1" vid="LAM 4:11">Yadometse umuriro i Siyoni</para>
  <para style="q2" vid="LAM 4:11">uturira amatanguriro yaho.<verse eid="LAM 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12" />Abami bo mw’isi ntibavyizera,</para>
  <para style="q2" vid="LAM 4:12">canke umuntu n’umwe wo mu baba kw’isi,</para>
  <para style="q1" vid="LAM 4:12">ko abansi n’abakeba boshobora kwinjira</para>
  <para style="q2" vid="LAM 4:12">amarembo y’i Yerusalemu.<verse eid="LAM 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13" />Ariko vyashitse kubera ivyaha vy’abavugishwa b’aho</para>
  <para style="q2" vid="LAM 4:13">n’ukugabitanya kw’abaherezi b’aho,</para>
  <para style="q1" vid="LAM 4:13">bahasheshe</para>
  <para style="q2" vid="LAM 4:13">amaraso y’abagororotsi.<verse eid="LAM 4:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14" />Bagendagenda mu mayira y’aho</para>
  <para style="q2" vid="LAM 4:14">nk’abantu b’impumyi.</para>
  <para style="q1" vid="LAM 4:14">Bahumanijwe n’amaraso</para>
  <para style="q2" vid="LAM 4:14">ku buryo ata n’umwe yubahuka gukora no ku mpuzu zabo.<verse eid="LAM 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15" />Abantu barasemerera bati: “Igirayo! Murahumanye!”</para>
  <para style="q2" vid="LAM 4:15">“Nimuje kure! Nimuje kure! Ntimudukoreko!”</para>
  <para style="q1" vid="LAM 4:15">Bariko barahunga bangara,</para>
  <para style="q2" vid="LAM 4:15">abantu bo mu mahanga bavuga bati:</para>
  <para style="q2" vid="LAM 4:15">“Ntibagikwiye kuguma hano na gatoya.”<verse eid="LAM 4:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16" />
    <char style="nd">Uhoraho</char> ubwiwe ni we yabasabagije;</para>
  <para style="q2" vid="LAM 4:16">ntakiri umwungere wabo.</para>
  <para style="q1" vid="LAM 4:16">Abaherezi ntibacubahwa,</para>
  <para style="q2" vid="LAM 4:16">n’inararibonye ngo zigirirwe akagongwe.<verse eid="LAM 4:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17" />Vyongeye, amaso yacu yaruhijwe</para>
  <para style="q2" vid="LAM 4:17">no kwitega ugutabarwa kandi kutari buboneke;</para>
  <para style="q1" vid="LAM 4:17">twarerekeye ku minara yacu</para>
  <para style="q2" vid="LAM 4:17">turaba ihanga ritashobora kudutabara.<verse eid="LAM 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18" />Abantu baguma bareretse intambuko zacu zose,</para>
  <para style="q2" vid="LAM 4:18">kubera ivyo ntitwacaruka ngo tugendagende mu mabarabara iwacu.</para>
  <para style="q1" vid="LAM 4:18">Iherezo ryacu ryari hafi, imisi yacu yari iharuwe,</para>
  <para style="q2" vid="LAM 4:18">kuko iherezo ryacu ryari rishitse.<verse eid="LAM 4:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19" />Abaduhiga banyaruka</para>
  <para style="q2" vid="LAM 4:19">nk’inkona mu kirere;</para>
  <para style="q1" vid="LAM 4:19">badukinagiza ku misozi</para>
  <para style="q2" vid="LAM 4:19">kandi batubundiye mu bugaragwa.<verse eid="LAM 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20" />Uwasizwe amavuta n’<char style="nd">Uhoraho</char>, ari we ubugingo bwacu bwenenako,</para>
  <para style="q2" vid="LAM 4:20">yafashwe n’imitego yabo.</para>
  <para style="q1" vid="LAM 4:20">Twiyumvira ko musi y’igitutu ciwe</para>
  <para style="q2" vid="LAM 4:20">ari ho tuzoba turi mu mahanga.<verse eid="LAM 4:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21" />Nezerwa kandi uhimbarwe, yewe mukobwa w’i Edomu,</para>
  <para style="q2" vid="LAM 4:21">wewe uba mu gihugu c’i Uzi.</para>
  <para style="q1" vid="LAM 4:21">Ariko na wewe igikombe cawe kizoza;</para>
  <para style="q2" vid="LAM 4:21">uzoborerwa, ute impuzu ugende gusa.<verse eid="LAM 4:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22" />Igihano cawe kizohera, yewe mukobwa w’i Siyoni;</para>
  <para style="q2" vid="LAM 4:22">ntazokwongereza igihe cawe co kuba mu kinyago.</para>
  <para style="q1" vid="LAM 4:22">Ariko azohana ivyaha vyawe, wewe mukobwa w’i Edomu,</para>
  <para style="q2" vid="LAM 4:22">agaragaze ububi bwawe.<verse eid="LAM 4:22" /></para>
  <para style="b" />
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1" />Wibuke, yewe <char style="nd">Uhoraho</char>, ivyatubayeko;</para>
  <para style="q2" vid="LAM 5:1">raba, ubone ibiteterwe turimwo.<verse eid="LAM 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2" />Ishamvu yacu yahawe abo tutazi,</para>
  <para style="q2" vid="LAM 5:2">amazu yacu yahawe abanyamahanga.<verse eid="LAM 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3" />Twahindutse impfuvyi zitagira ba se,</para>
  <para style="q2" vid="LAM 5:3">kandi ba mama babaye abapfakazi.<verse eid="LAM 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4" />N’amazi yo kunywa turayagura;</para>
  <para style="q2" vid="LAM 5:4">n’inkwi ducana tuzironka dutanze amahera.<verse eid="LAM 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5" />Abadukinagiza badufashe ku gakanu;</para>
  <para style="q2" vid="LAM 5:5">turaremerewe, nta gahengwe dufise.<verse eid="LAM 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6" />Twunamiye Egiputa na Ashuri</para>
  <para style="q2" vid="LAM 5:6">kugira ngo turonke ivyokurya tubeho.<verse eid="LAM 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7" />Ba sogokuruza bacu baracumuye kandi ntibakiriho,</para>
  <para style="q2" vid="LAM 5:7">ariko twikoreye igihano cabo.<verse eid="LAM 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8" />Abagurano ni bo batuganza,</para>
  <para style="q2" vid="LAM 5:8">kandi nta n’umwe wo kudukura mu maboko yabo.<verse eid="LAM 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9" />Turonka ivyokurya mu guheba amagara yacu</para>
  <para style="q2" vid="LAM 5:9">kubera inkota iri mu bugaragwa.<verse eid="LAM 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10" />Urukoba rwacu rurashushe nk’itanure,</para>
  <para style="q2" vid="LAM 5:10">kubera ubushe bw’inzara.<verse eid="LAM 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11" />Abagore bafashwe ku nguvu i Siyoni,</para>
  <para style="q2" vid="LAM 5:11">n’abakobwa mu bisagara vy’i Buyuda.<verse eid="LAM 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12" />Abaganwa bamanitswe n’amaboko yabo;</para>
  <para style="q2" vid="LAM 5:12">inararibonye ntizicubahwa.<verse eid="LAM 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13" />Abasore baruhishijwe n’ibikorwa vyo gusya;</para>
  <para style="q2" vid="LAM 5:13">abahungu badandabiranishwa n’imiganda y’inkwi.<verse eid="LAM 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14" />Inararibonye zavuye kw’irembo ry’igisagara;</para>
  <para style="q2" vid="LAM 5:14">abasore bahagaritse kuririmba.<verse eid="LAM 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15" />Umunezero wose waragiye uva mu mitima yacu;</para>
  <para style="q2" vid="LAM 5:15">intambo zacu zahindutse ikigandaro.<verse eid="LAM 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16" />Urugori rwarakorotse ruva ku mutwe wacu.</para>
  <para style="q2" vid="LAM 5:16">Turagowe, kuko twacumuye!<verse eid="LAM 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17" />Ni ku bw’ivyo imitima yacu icitse intege,</para>
  <para style="q2" vid="LAM 5:17">ni ku bw’ivyo amaso yacu atakibona neza,<verse eid="LAM 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18" />kuko umusozi Siyoni wabaye imisaka,</para>
  <para style="q2" vid="LAM 5:18">wabaye ikirimbiro ry’imbwebwe.<verse eid="LAM 5:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19" />Wewe <char style="nd">Uhoraho</char>, uraganje ibihe bidashira;</para>
  <para style="q2" vid="LAM 5:19">ingoma yawe izokwamaho uko urunganwe ruzokurikirana n’urundi.<verse eid="LAM 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20" />Mbega ni kuki wama utwibagira?</para>
  <para style="q2" vid="LAM 5:20">Ni kuki waduhevye igihe kingana uku?<verse eid="LAM 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21" />Utugarukane kuri wewe, yewe <char style="nd">Uhoraho</char>, natwe turagaruka;</para>
  <para style="q2" vid="LAM 5:21">udusubize imyaka yacu ya kera,<verse eid="LAM 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22" />kiretse nimba waraduhevye ibihe vyose,</para>
  <para style="q2" vid="LAM 5:22">ukaba waraturakiye birenze urugero.<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>