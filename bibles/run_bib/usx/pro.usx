  <para style="h">Imigani</para>
  <para style="toc1">Imigani</para>
  <para style="toc2">Imigani</para>
  <para style="toc3">Img</para>
  <para style="mt1">Imigani</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="ms1">Intumbero n’icigwa nyamukuru</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />Iyi ni imigani ya Salomo, mwene Dawidi, umwami wa Isirayeli.<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />Intumbero y’iyi migani ni ukwigisha abantu ubwenge no kubatoza indero,</para>
  <para style="q2" vid="PRO 1:2">no kubafasha gutahura amajambo y’ubwenge.<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />Yigisha abantu kugira ubwenge bwo kuroranya ibintu mu buzima,</para>
  <para style="q2" vid="PRO 1:3">bagakora ibigororotse, ibitunganye n’ibibereye.<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />Iyo migani yigisha ubwenge abazi bike,</para>
  <para style="q2" vid="PRO 1:4">abakiri bato ikabaha ubumenyi bwo guserangura.<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />Umunyabwenge niyumve iyi migani, yongereze ubumenyi,</para>
  <para style="q2" vid="PRO 1:5">uwufise ubuseranguzi aronke ukurongorwa,<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />kugira ngo atahure iyi myibutsa n’iyi migani,</para>
  <para style="q2" vid="PRO 1:6">amajambo y’abanyabwenge n’amabanga yayo.<verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />Ukwubaha <char style="nd">Uhoraho</char> ni kwo tanguriro ry’ubwenge,</para>
  <para style="q2" vid="PRO 1:7">ariko ibipfu bikengera ubwenge n’ugutozwa indero.<verse eid="PRO 1:7" /></para>
  <para style="ms1">Ubutumire bwo kwakira ubwenge</para>
  <para style="s1">Wirinde uguhamagara kw’umunyavyaha</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Mwana wanje, wumvire ico so akubwira,</para>
  <para style="q2" vid="PRO 1:8">kandi ntukanke ico nyoko akwigisha.<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />Bizokubera urugori rw’ubuntu ku mutwe,</para>
  <para style="q2" vid="PRO 1:9">n’umugufu ushariza izosi.<verse eid="PRO 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />Mwana wanje, abanyavyaha nibakwosha,</para>
  <para style="q2" vid="PRO 1:10">ntukabumvire.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Nibakubwira bati: “Ingo tujane;</para>
  <para style="q2" vid="PRO 1:11">tuje gusesa amaraso,</para>
  <para style="q2" vid="PRO 1:11">dutege umutego abatagira icaha;<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />ingo tubamire ari bazima, nk’uko imva imira abantu,</para>
  <para style="q2" vid="PRO 1:12">tubamire bose nk’abaja muri rwa rwobo rw’urupfu;<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />ni ho tuzoronka ivyiza vyinshi,</para>
  <para style="q2" vid="PRO 1:13">amazu yacu tuyuzuze ivyo tunyaze;<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />ingo nawe uzoronka umugabane wawe,</para>
  <para style="q2" vid="PRO 1:14">tuzogabura ivyo tuzoronka vyose.”<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />Mwana wanje, ntuze wifatanye na bo,</para>
  <para style="q2" vid="PRO 1:15">ntuze utumbereze ibirenge vyawe mu nzira zabo;<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />kuko birukira gukora ivyaha,</para>
  <para style="q2" vid="PRO 1:16">bakihutira gusesa amaraso.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />Gutega umutego inyoni zikubona</para>
  <para style="q2" vid="PRO 1:17">ni ukwiruhiriza ubusa.<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />Abo bantu bazohitanwa n’umutego bateze;</para>
  <para style="q2" vid="PRO 1:18">bicwe n’ivyo bateze abandi.<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Iryo ni ryo herezo ry’abirukira inyungu mbi,</para>
  <para style="q2" vid="PRO 1:19">izo nyungu mbi ni zo zihitana ubuzima bwabo.<verse eid="PRO 1:19" /></para>
  <para style="s1">Uguhanura kwa Bwenge</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />Bwenge asemerera ari mu nzira,</para>
  <para style="q2" vid="PRO 1:20">akaduza ijwi mu bibanza abantu bakoraniramwo.<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />Asemerera ari mu mayirabiri yuzuye urwamo,</para>
  <para style="q2" vid="PRO 1:21">akavugira amajambo yiwe ku marembo y’igisagara ati:<verse eid="PRO 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />“Yemwe banyabwengebuke mwe; muzogeza ryari kudakunda ubwenge?</para>
  <para style="q2" vid="PRO 1:22">Namwe bacokoranyi, muzogeza ryari kunezerererwa ubucokoranyi?</para>
  <para style="q2" vid="PRO 1:22">Namwe bipfu, muzogeza ryari kwanka ubumenyi?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />Nimuze mwumvirize ukwihaniza kwanje,</para>
  <para style="q2" vid="PRO 1:23">ndababwire ikiri ku mutima wanje,</para>
  <para style="q2" vid="PRO 1:23">maze ntume muba abanyabwenge.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />Ariko narabahamagaye muranka,</para>
  <para style="q2" vid="PRO 1:24">ndabatega ibiganza ariko ntihagira n’umwe avyitaho.<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />Mwirengagije impanuro zanje,</para>
  <para style="q2" vid="PRO 1:25">ntimwemera ukugabisha kwanje.<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />Nanje nzobatwenga nimwagwa mu vyago;</para>
  <para style="q2" vid="PRO 1:26">nzokwitwengera nimwashikirwa n’amakuba,<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />ubwoba nibwabazako nk’igihuhusi,</para>
  <para style="q2" vid="PRO 1:27">amakuba akabagwako kurya kw’agashururu,</para>
  <para style="q2" vid="PRO 1:27">imibabaro n’agahinda bikabahwikira.<verse eid="PRO 1:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />Maze abo bazompamagara ariko sinzobitaba;</para>
  <para style="q2" vid="PRO 1:28">bazondonderana umwete ariko ntibazombona,<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />kuko banse ubumenyi,</para>
  <para style="q2" vid="PRO 1:29">ntibahitamwo kwubaha <char style="nd">Uhoraho</char>.<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />Ko banse impanuro zanje,</para>
  <para style="q2" vid="PRO 1:30">bakagaya ukugabisha kwanje,<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />bazorya ivyamwa vy’ingeso zabo,</para>
  <para style="q2" vid="PRO 1:31">bahazwe n’ivyamwa vy’inama zabo.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />Kuko ubunebwe bw’abanebwe ni bwo bubica,</para>
  <para style="q2" vid="PRO 1:32">kandi ukuba sindabibazwa kw’ibipfu ni kwo kubirandura.<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />Ariko abanyumvira bose bazobaho amahoro,</para>
  <para style="q2" vid="PRO 1:33">bagubwe neza, ata cago batinya.”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">Akamaro k’ubwenge</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />Mwana wanje, niwakira amajambo yanje,</para>
  <para style="q2" vid="PRO 2:1">ukazigama ivyo ndakwihanikiriza,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />ugatega ugutwi amajambo y’ubwenge,</para>
  <para style="q2" vid="PRO 2:2">ugashira umutima wawe ku gutahura,<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />ugahamagara ubwenge,</para>
  <para style="q2" vid="PRO 2:3">ukaririra ugutahura,<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />ukabirondera nk’uwurondera ifeza</para>
  <para style="q2" vid="PRO 2:4">canke ubutunzi buhishijwe,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />ico gihe uzomenya kwubaha <char style="nd">Uhoraho</char> ico ari co,</para>
  <para style="q2" vid="PRO 2:5">kandi uzogira ugutahura kuvuye ku Mana.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />Kuko <char style="nd">Uhoraho</char> ni we atanga ubwenge,</para>
  <para style="q2" vid="PRO 2:6">kandi mu kanwa kiwe ni ho hava ubumenyi n’ugutahura.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />Ni we afise intsinzi y’abagororotsi mu bubiko bwiwe,</para>
  <para style="q2" vid="PRO 2:7">kandi ni we nkinzo y’abagenda batunganye.<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />Ni we azigama inzira z’abagororotsi,</para>
  <para style="q2" vid="PRO 2:8">agakingira abamwizigiye.<verse eid="PRO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />Aho ni ho uzomenya ibigororotse, ibitunganye hamwe n’ibibereye,</para>
  <para style="q2" vid="PRO 2:9">umenye n’inzira zibereye,<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />kuko ubwenge buzokwinjira mu mutima wawe,</para>
  <para style="q2" vid="PRO 2:10">maze ubumenyi bube umunezero w’umushaha wawe.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />Guhitamwo neza kuzoba umurinzi wawe,</para>
  <para style="q2" vid="PRO 2:11">kandi ugutahura kuzokuzigama.<verse eid="PRO 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />Ubwenge buzokurinda kugendera mu nzira z’ababi,</para>
  <para style="q2" vid="PRO 2:12">bukurinde n’abavuga amajambo y’ubupfu.<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />Abo bata inzira zigororotse,</para>
  <para style="q2" vid="PRO 2:13">bakagendera mu nzira z’umwijima.<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />Bahimbarwa no gukora ikibi,</para>
  <para style="q2" vid="PRO 2:14">bagahimbarirwa ubuhumane bwabo.<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />Iminyuro yabo iragoramanze,</para>
  <para style="q2" vid="PRO 2:15">kandi inzira bajana zirabazimiza.<verse eid="PRO 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />Ubwenge buzokurinda umugore w’umusambanyikazi,</para>
  <para style="q2" vid="PRO 2:16">bukurinde n’amajambo asosa y’umugore w’umunyangesombi,<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />yataye umugabo wo mu buto bwiwe</para>
  <para style="q2" vid="PRO 2:17">akava mw’isezerano yagize imbere y’Imana.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />Kwinjira inzu yiwe bijana mu rupfu,</para>
  <para style="q2" vid="PRO 2:18">ni inzira ijana i kuzimu mu mva.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Nta wuja iwe ngo agaruke,</para>
  <para style="q2" vid="PRO 2:19">canke ngo yongere asubire mu nzira y’ubuzima.<verse eid="PRO 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Ahubwo ugendere mu nzira y’abantu b’intungane,</para>
  <para style="q2" vid="PRO 2:20">ugume mu nzira y’abagororotsi.<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />Kuko abagororotsi ni bo bazoba mu gihugu</para>
  <para style="q2" vid="PRO 2:21">kandi inyankamugayo ni zo zizokigumamwo.<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />Ariko abanyakibi bazogikurwamwo,</para>
  <para style="q2" vid="PRO 2:22">abahemu na bo bakirandurwemwo.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">Ubwenge ni bwo butanga ukubaho neza</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />Mwana wanje, ntuze wibagire ivyo nakwigishije,</para>
  <para style="q2" vid="PRO 3:1">ahubwo uzigame amabwirizwa yanje mu mutima wawe.<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />Ivyo niwabikora, bizokwongera imyaka yo kubaho,</para>
  <para style="q2" vid="PRO 3:2">kandi ubuzima bwawe buzororanirwa.<verse eid="PRO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Urukundo n’ubwizigirwa bize vyamane nawe,</para>
  <para style="q2" vid="PRO 3:3">uze uvyambare mw’izosi,</para>
  <para style="q2" vid="PRO 3:3">uvyandike mu mutima wawe.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />Ni ho uzogira ikiganza ciza n’izina ryiza</para>
  <para style="q2" vid="PRO 3:4">imbere y’Imana n’abantu.<verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Wizigire <char style="nd">Uhoraho</char> n’umutima wawe wose,</para>
  <para style="q2" vid="PRO 3:5">ntiwishimire ugutahura kwawe.<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />Wame urondera ugushaka kwiwe mu vyo ukora vyose,</para>
  <para style="q2" vid="PRO 3:6">na we azogorora inzira zawe.<verse eid="PRO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />Ntiwishimire ubwenge bwawe,</para>
  <para style="q2" vid="PRO 3:7">ahubwo wubahe <char style="nd">Uhoraho</char> kandi uve mu kibi.<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />Ivyo bizotuma umubiri wawe ugira amagara meza,</para>
  <para style="q2" vid="PRO 3:8">bitume n’amagufa yawe yoroherwa.<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />Wubahishe <char style="nd">Uhoraho</char> ubutunzi bwawe,</para>
  <para style="q2" vid="PRO 3:9">hamwe n’ivya mbere vyo mu vyeze mu mirima yawe.<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />Na we azosesekaza umwimbu mu bigega vyawe,</para>
  <para style="q2" vid="PRO 3:10">amato yawe yame asesekaye umuvinyu.<verse eid="PRO 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />Mwana wanje, ntukagaye uguhana kw’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PRO 3:11">kandi ntukanke ukugabisha kwiwe;<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />kuko <char style="nd">Uhoraho</char> agabisha abo akunda,</para>
  <para style="q2" vid="PRO 3:12">kurya umuvyeyi abikorera umwana akunda.<verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Hahiriwe umuntu yironkeye ubwenge,</para>
  <para style="q2" vid="PRO 3:13">akironkera ugutahura.<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />Kuko ubwenge busumvya agaciro ifeza,</para>
  <para style="q2" vid="PRO 3:14">kandi ivyamwa vyabwo birusha agaciro inzahabu.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />Ubwenge burusha agaciro akabuye kitwa imaragarita,</para>
  <para style="q2" vid="PRO 3:15">kandi nta co kwipfuzwa na kimwe cogereranywa na bwo.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Kuramba kuri mu kuboko kwabwo kw’i buryo,</para>
  <para style="q2" vid="PRO 3:16">mu kubamfu kwabwo na ho hari ubutunzi n’icubahiro.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Inzira zabwo ni inzira zinezereye,</para>
  <para style="q2" vid="PRO 3:17">kandi ni iz’amahoro.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />Ubwenge ni igiti c’ubugingo ku babugumbira,</para>
  <para style="q2" vid="PRO 3:18">kandi ni umugisha ku babwumirako bose.<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Ubwenge ni bwo <char style="nd">Uhoraho</char> yashingishije imfatiro z’isi,</para>
  <para style="q2" vid="PRO 3:19">kandi ugutahura ni kwo yashirishijeho amajuru.<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />Kubera ubumenyi bwiwe, amasoko y’i kuzimu yaratobotse,</para>
  <para style="q2" vid="PRO 3:20">ibicu na vyo bitonyanga imvura.<verse eid="PRO 3:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />Mwana wanje, ntukareke ubwenge nyabwo n’ukurobanura,</para>
  <para style="q2" vid="PRO 3:21">ngo bive imbere y’amaso yawe;<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />kuko ni vyo bizokubera ubuzima,</para>
  <para style="q2" vid="PRO 3:22">bikubere ikirezi co gushariza mw’izosi.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />Bizokuzigama mu nzira zawe,</para>
  <para style="q2" vid="PRO 3:23">kandi ibirenge vyawe ntibizotsitara.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Niwaryama ntuzogira ico utinya;</para>
  <para style="q2" vid="PRO 3:24">kandi niwasinzira, uzogira itiro riryoshe.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />Ntugatinye ivyago bishitse giturumbuka,</para>
  <para style="q2" vid="PRO 3:25">canke ukurandurwa gushikiye abanyakibi;<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />kuko <char style="nd">Uhoraho</char> ari we azokurinda,</para>
  <para style="q2" vid="PRO 3:26">kandi azorinda ibirenge vyawe ngo ntibigwe mu mutego.<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />Mwana wanje, ntukareke kugirira neza ababikwiye</para>
  <para style="q2" vid="PRO 3:27">mu gihe ufise ububasha bwo kubikora.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Ntukabwire umubanyi wawe uti:</para>
  <para style="q2" vid="PRO 3:28">“Genda uzogaruka; nzoguha ejo,”</para>
  <para style="q2" vid="PRO 3:28">kandi ufise ico womuha ubwo nyene.<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />Ntugategure kugirira nabi umubanyi wawe,</para>
  <para style="q2" vid="PRO 3:29">uwo musanzwe mubanye mwumvikana.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Ntugatongane n’umuntu ata mpamvu,</para>
  <para style="q2" vid="PRO 3:30">ata kibi yagukoreye.<verse eid="PRO 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Ntukipfuze kumera nk’abantu b’ibirandamuke,</para>
  <para style="q2" vid="PRO 3:31">canke ngo wigane ingeso zabo na zimwe;<verse eid="PRO 3:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />kuko abanyakibi ari ikizira k’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PRO 3:32">ariko abamwubaha abagira abakunzi biwe.<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />Umuvumo w’<char style="nd">Uhoraho</char> uri ku nzu y’umunyakibi,</para>
  <para style="q2" vid="PRO 3:33">ariko ahezagira urugo rw’umugororotsi.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />
    <char style="nd">Uhoraho</char> agaya abacokoranyi,</para>
  <para style="q2" vid="PRO 3:34">ariko agirira ubuntu abaciye bugufi.<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />Umunyabwenge azoragwa icubahiro,</para>
  <para style="q2" vid="PRO 3:35">ariko ibipfu bizokorwa n’isoni.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Impanuro z’umuvyeyi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Bana banje, nimutege amatwi inyigisho z’umuvyeyi;</para>
  <para style="q2" vid="PRO 4:1">muzishireko umutima kugira ngo mugire ubwenge.<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />Ndiko ndabaha inyigisho nyazo;</para>
  <para style="q2" vid="PRO 4:2">none rero ntimukanke inyigisho zanje.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />Kuko nanje narabaye umwana kuri data,</para>
  <para style="q2" vid="PRO 4:3">kandi narakundwa cane na mama nk’umwana w’ikinege.<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />Data yanyigishije ati: “Ushire amajambo yanje ku mutima,</para>
  <para style="q2" vid="PRO 4:4">ugendere mu mabwirizwa yanje,</para>
  <para style="q2" vid="PRO 4:4">ni ho uzobona kubaho.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />Rondera ubwenge, rondera ugutahura;</para>
  <para style="q2" vid="PRO 4:5">ntiwibagire amajambo yanje canke ngo uyavemwo.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Ntugahebe ubwenge kuko ni bwo buzokuzigama;</para>
  <para style="q2" vid="PRO 4:6">ahubwo ubukunde kuko ni bwo buzokurinda.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Kugira ngo ube umunyabwenge, rondera ubwenge.</para>
  <para style="q2" vid="PRO 4:7">Naho vyogusaba gutanga ivyawe vyose,</para>
  <para style="q2" vid="PRO 4:7">bitange uronke ugutahura.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Niwabuha agaciro, na bwo buzokugira uwuhambaye.</para>
  <para style="q2" vid="PRO 4:8">Bugumbire, na bwo buzoguhesha icubahiro.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />Buzokwambika urugori rusharije ku mutwe,</para>
  <para style="q2" vid="PRO 4:9">bukwerekane wambaye urugori rw’ubwiza.”<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Ntega amatwi mwana wanje, wemere ivyo nkubwira,</para>
  <para style="q2" vid="PRO 4:10">ni ho imyaka yo kubaho kwawe izokwongerekana.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />Ndakwigisha inzira z’ubwenge,</para>
  <para style="q2" vid="PRO 4:11">kandi ndakurongorera mu nzira zigororotse.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />Mu gutambuka ntakizogutangira,</para>
  <para style="q2" vid="PRO 4:12">kandi niwiruka ntuzotsitara.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Ucakire inyigisho zanje, ntuziveko.</para>
  <para style="q2" vid="PRO 4:13">Uzizigame neza kuko ni zo buzima bwawe.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Ntuze utumbereze ibirenge vyawe mu nzira z’abanyakibi,</para>
  <para style="q2" vid="PRO 4:14">canke ngo ugendere mu ngeso z’inkozi z’ikibi.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Irinde inzira yabo, ntuyicemwo,</para>
  <para style="q2" vid="PRO 4:15">ahubwo hindukira ufate inzira yawe.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />Kuko ntibashobora gusinzira badakoze ikibi;</para>
  <para style="q2" vid="PRO 4:16">ntibaruhuka batagize uwo batsitaza.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Barya ivyokurya bivuye mu kibi,</para>
  <para style="q2" vid="PRO 4:17">bakanywa umuvinyu w’umuryano.<verse eid="PRO 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Inzira y’abagororotsi ni nk’umuco wo mu mutwenzi,</para>
  <para style="q2" vid="PRO 4:18">ugenda urushiriza gukayangana gushitsa ku murango.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />Ariko inzira y’abanyakibi imeze nk’umwijima w’umuzitanya,</para>
  <para style="q2" vid="PRO 4:19">ntibamenya n’ico batsitarako.<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />Mwana wanje, niwumve ivyo nkubwira,</para>
  <para style="q2" vid="PRO 4:20">utege amatwi amajambo yanje.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Ntuze wigere uyibagira,</para>
  <para style="q2" vid="PRO 4:21">uyazigame mu mutima,<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />kuko azanira ubuzima abayakira,</para>
  <para style="q2" vid="PRO 4:22">akabaha amagara meza mu mubiri wabo wose.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />Urinde umutima wawe kuruta ibindi vyose,</para>
  <para style="q2" vid="PRO 4:23">kuko muri wo ari ho hari isoko y’ubugingo.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Ushire kure yawe amajambo y’ubupfu,</para>
  <para style="q2" vid="PRO 4:24">urinde akanwa kawe kuvuga amajambo mabi.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Wame uraba imbere yawe,</para>
  <para style="q2" vid="PRO 4:25">amaso yawe uyahange ibiri imbere yawe.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />Wiyumvire cane ku nzira ugiye gucamwo,</para>
  <para style="q2" vid="PRO 4:26">utumbereze ibirenge vyawe mu nzira y’ukuri.<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Ntukebereze i buryo canke i bubamfu,</para>
  <para style="q2" vid="PRO 4:27">urinde ibirenge vyawe vyoye gukurikira ikibi.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Kwirinda ubusambanyi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />Mwana wanje, shira umutima ku majambo y’ubwenge nkwigisha,</para>
  <para style="q2" vid="PRO 5:1">wumvirize neza amajambo yanje akwigisha ugutahura,<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />kugira ngo ushobore kumenya ikibereye,</para>
  <para style="q2" vid="PRO 5:2">akanwa kawe kavuge ivy’ubwenge.<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Kuko akanwa k’umugore w’umusambanyikazi gasosa nk’ubuki,</para>
  <para style="q2" vid="PRO 5:3">amajambo yiwe anyerera gusumvya amavuta.<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />Ariko mu nyuma arura gusumvya ikintu cose kirura,</para>
  <para style="q2" vid="PRO 5:4">agacumita kurusha inkota y’ubugi bubiri.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Ibirenge vyiwe bimanuka bija mu rupfu,</para>
  <para style="q2" vid="PRO 5:5">kandi intambuko ziwe nta handi zijana atari mu mva.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Ntiyiyumvira ku nzira ijana mu buzima,</para>
  <para style="q2" vid="PRO 5:6">inzira ziwe ziramuzimiza, ariko ntabibona.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />None rero, mwana wanje, ntega amatwi;</para>
  <para style="q2" vid="PRO 5:7">ntiwirengagize ivyo ndakubwira.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Uze wigire kure uwo mugore,</para>
  <para style="q2" vid="PRO 5:8">ntuze wegere n’umuryango w’inzu yiwe,<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />kugira ngo ntiwiyake icubahiro cawe ngo ugihe abandi,</para>
  <para style="q2" vid="PRO 5:9">imyaka y’ubuzima bwawe ukayiha ruburakigongwe.<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />Abantu utazi ntibabe ari bo barya ubutunzi bwawe,</para>
  <para style="q2" vid="PRO 5:10">ngo ivyo wabiriye akuya bitungishe inzu y’uwundi muntu.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />Mu misi yawe ya nyuma uzoboroga,</para>
  <para style="q2" vid="PRO 5:11">umubiri wawe umaze kuba akaheze.<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />Uzovuga uti: “Ese ingene nanse gutozwa indero!</para>
  <para style="q2" vid="PRO 5:12">Ese ukuntu nirengagije ukugabishwa!<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Vyangendeye gute ngo sinumvire abigisha banje,</para>
  <para style="q2" vid="PRO 5:13">canke ngo ntege amatwi abarezi banje?<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Ehe ngeze aho umwansi ashaka bidatevye,</para>
  <para style="q2" vid="PRO 5:14">maramariye imbere y’ikoraniro ry’abantu.”<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />Unywe amazi yo mw’iriba ryawe wiharije,</para>
  <para style="q2" vid="PRO 5:15">amazi atemba ava mw’iriba ryawe.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Mbega amasoko yawe akwiye gutemba akuzura amabarabara,</para>
  <para style="q2" vid="PRO 5:16">canke imigende yawe igatembera mu bibanza vy’amahuriro?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Nibibe ivyawe bwite,</para>
  <para style="q2" vid="PRO 5:17">ntukabisangire n’abahita.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Isoko ryawe riragahezagirwa,</para>
  <para style="q2" vid="PRO 5:18">nawe unezerererwe umugore wo mu buto bwawe.<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />Ameze nk’impongokazi iteye igomwe, nk’ingeregere ihimbaye.</para>
  <para style="q2" vid="PRO 5:19">Amabere yiwe akubumbe ibihe vyose,</para>
  <para style="q2" vid="PRO 5:19">kandi wame ukwegwa n’urukundo rwiwe ibihe vyose.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />Mwana wanje, ni igiki cotuma ukwegwa n’umusambanyikazi,</para>
  <para style="q2" vid="PRO 5:20">ukagumbira igikiriza c’umugore w’icigenze?<verse eid="PRO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Kuko ingeso z’umuntu zigaragarira <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PRO 5:21">ni we asuzuma inzira ziwe zose.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Ibikorwa bibi vy’umunyakibi ni vyo bimubera umutego,</para>
  <para style="q2" vid="PRO 5:22">kandi imigozi y’ivyaha vyiwe ni yo imuboha.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />Azokwicwa no kutamenya ingene yitwara,</para>
  <para style="q2" vid="PRO 5:23">azimizwe n’ubujuju bwiwe bwinshi.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Kwirinda ubupfu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />Mwana wanje, nimba waremeye kurihira ideni mugenzawe,</para>
  <para style="q2" vid="PRO 6:1">canke ugafata ingingo yo kwishingira umunyagahinga,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />umaze gafatwa n’indahiro warahiye,</para>
  <para style="q2" vid="PRO 6:2">waguye mu mutego w’amajambo yavuye mu kanwa kawe;<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />uzobigenze uku kugira ngo wibohore,</para>
  <para style="q2" vid="PRO 6:3">kuko uzoba wamaze gukorokera mu maboko ya mugenzawe.</para>
  <para style="q1" vid="PRO 6:3">Uze ugende wicishe bugufi imbere yiwe,</para>
  <para style="q2" vid="PRO 6:3">umwinginge ushimitse.<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />Ntuze ukundire amaso yawe gusinzira,</para>
  <para style="q2" vid="PRO 6:4">canke ibigohe vyawe ngo bitwarwe n’itiro.<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />Uze wikize nk’ingeregere ivuye mu maboko y’umuhigi,</para>
  <para style="q2" vid="PRO 6:5">canke nk’inyoni ivuye mu mutego.<verse eid="PRO 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Niwigire ku kimonyo, yewe wa munebwe we!</para>
  <para style="q2" vid="PRO 6:6">Raba ingene gikora hanyuma uce ubwenge.<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />Ntikigira uwugitegeka,</para>
  <para style="q2" vid="PRO 6:7">uwukiganza, canke uwugikoresha.<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />Ariko cegeranya ivyokurya mu ci,</para>
  <para style="q2" vid="PRO 6:8">kigatororokanya imfungurwa mw’iyimbura.<verse eid="PRO 6:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Mbega uzogeza ryari kuryama, yewe wa munebwe we?</para>
  <para style="q2" vid="PRO 6:9">Uzova mw’itiro ryawe ryari?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />Uravuga uti: “Hinge nisinzirire gatoya, mpungure gakeya,</para>
  <para style="q2" vid="PRO 6:10">nigorore gatoya, mpfunye amaboko.”<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />Uko ni ko ubukene buzoguhwikira nk’igisuma,</para>
  <para style="q2" vid="PRO 6:11">ubworo bugutere nk’umwambuzi.<verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Umuntu w’imburakimazi kandi w’umunyakibi,</para>
  <para style="q2" vid="PRO 6:12">ni we yama abesha.<verse eid="PRO 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 6:13" />Abesha ku rwenge mu kuvuna ingohe,</para>
  <para style="q2" vid="PRO 6:13">agakeburanisha ibirenge vyiwe,</para>
  <para style="q2" vid="PRO 6:13">agakoresha ibimenyetso n’intoke ziwe.<verse eid="PRO 6:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 6:14" />Umutima wiwe wama utegura gukora ibibi,</para>
  <para style="q2" vid="PRO 6:14">kandi ibihe vyose avyura imitongano.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Ni co gituma ivyago bizomugwako mu kanya gato,</para>
  <para style="q2" vid="PRO 6:15">akarandurwa giturumbuka ubutakivyuka.<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="PRO 6:16" />Hari ibintu bitandatu <char style="nd">Uhoraho</char> yanka,</para>
  <para style="li2" vid="PRO 6:16">ahubwo ni indwi bimusesema:<verse eid="PRO 6:16" /></para>
  <para style="li3">
    <verse number="17" style="v" sid="PRO 6:17" />amaso arabana abandi ubwibone,</para>
  <para style="li3" vid="PRO 6:17">ururimi ruvuga ibinyoma,</para>
  <para style="li3" vid="PRO 6:17">amaboko asesa amaraso y’uwutaco azira,<verse eid="PRO 6:17" /></para>
  <para style="li3">
    <verse number="18" style="v" sid="PRO 6:18" />umutima utegura imigambi mibi,</para>
  <para style="li3" vid="PRO 6:18">ibirenge vyirukira gukora ikibi,<verse eid="PRO 6:18" /></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 6:19" />icabona kivuga ibinyoma,</para>
  <para style="li3" vid="PRO 6:19">hamwe n’umuntu ateranya abavukana.<verse eid="PRO 6:19" /></para>
  <para style="s1">Kwirinda ubusambanyi</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />Mwana wanje, wumve ivyo so agutegeka,</para>
  <para style="q2" vid="PRO 6:20">kandi ntiwanke ivyo nyoko akwigisha.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Ubizigame mu mutima wawe ibihe vyose,</para>
  <para style="q2" vid="PRO 6:21">uvyambare mw’izosi.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />Uri ku rugendo, bizokurongora,</para>
  <para style="q2" vid="PRO 6:22">uryamye bizokurarira;</para>
  <para style="q2" vid="PRO 6:22">kandi niwavyuka bizokuganiriza.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />Kuko ibwirizwa ni itara,</para>
  <para style="q2" vid="PRO 6:23">inyigisho ni urumuri,</para>
  <para style="q1" vid="PRO 6:23">ukugabisha no gutoza indero na vyo</para>
  <para style="q2" vid="PRO 6:23">ni inzira ijana mu buzima.<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />Bizokurinda umugore w’ingeso mbi,</para>
  <para style="q2" vid="PRO 6:24">n’akarimi gasosa k’umugore w’icigenze.<verse eid="PRO 6:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />Ntukamwipfuze mu mutima wawe kubera ubwiza bwiwe,</para>
  <para style="q2" vid="PRO 6:25">kandi ntiwemere ko agukwegakwegesha amaso yiwe.<verse eid="PRO 6:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />Kuko maraya azogukwegera mu bukene,</para>
  <para style="q2" vid="PRO 6:26">ariko umugore w’uwundi we kugukwegera urupfu.<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />Mbega umuntu yonyegeza umuriro mu mpuzu,</para>
  <para style="q2" vid="PRO 6:27">impuzu ziwe ntizishe?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />Umuntu yohonyora ku makara yaka,</para>
  <para style="q2" vid="PRO 6:28">hanyuma ntashe?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Ni ko bimeze no ku wuryamana n’umugore w’uwundi muntu;</para>
  <para style="q2" vid="PRO 6:29">nta wumukorako ngo abure guhanwa.<verse eid="PRO 6:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Abantu ntibagaya uwivye</para>
  <para style="q2" vid="PRO 6:30">iyo ashaka kwivuna inzara.<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />Ariko iyo afashwe, ariha ivyo yivye bigwijwe incuro indwi,</para>
  <para style="q2" vid="PRO 6:31">naho vyosaba kugurisha ubutunzi bw’umuryango wiwe bwose.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Ariko uwusambana n’umugore w’uwundi we ni igipfu;</para>
  <para style="q2" vid="PRO 6:32">uwubikoze wese aba ashaka kuranduka.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />Inguma n’ibimaramare ni vyo mugabane wiwe,</para>
  <para style="q2" vid="PRO 6:33">kandi umugayo ntuzokwigera umuvako.<verse eid="PRO 6:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />Ugupfuha gutuma umugabo w’uwo mugore agira ishavu ry’inkazi,</para>
  <para style="q2" vid="PRO 6:34">kandi ntazogira ikigongwe nihagera ko yihora.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />Ntazokwakira indishi y’akababaro n’imwe,</para>
  <para style="q2" vid="PRO 6:35">ntazokwemera ingabire zawe naho womuha ibingana iki.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s1">Kwirinda umugore w’umusambanyikazi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />Mwana wanje, uzigame amajambo yanje,</para>
  <para style="q2" vid="PRO 7:1">ubike amabwirizwa yanje muri wewe.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />Uzigame amabwirizwa yanje kugira ngo ubone kubaho;</para>
  <para style="q2" vid="PRO 7:2">urinde inyigisho zanje nk’uko urinda imbone y’ijisho ryawe.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />Uzambare nk’impeta</para>
  <para style="q2" vid="PRO 7:3">uzandike ku mutima wawe.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Bwira ubwenge uti: “Uri mushikanje,”</para>
  <para style="q2" vid="PRO 7:4">ugutahura ukwite incuti yawe.<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />Bizokurinda umugore w’umunyangesombi,</para>
  <para style="q2" vid="PRO 7:5">bikurinde umugore w’icigenze n’amajambo yiwe asosa.<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />Umusi umwe nari kw’idirisha ry’inzu yanje,</para>
  <para style="q2" vid="PRO 7:6">maze ncishije mu gitambara gikinze,<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />ndaba muvbantu ata co binona.</para>
  <para style="q2" vid="PRO 7:7">Muri bo mbonamwo umusore umwe,</para>
  <para style="q2" vid="PRO 7:7">umusore w’umuyabaga atagira ubwenge,<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />ajabuka ibarabara hafi y’aho umwe muri abo bagore yaba,</para>
  <para style="q2" vid="PRO 7:8">agenda atumbereye inzu yiwe.<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />Bwari buhwibiriye, buriko burira;</para>
  <para style="q2" vid="PRO 7:9">ijoro n’umwijima bitanguye kuza.<verse eid="PRO 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Maze wa mugore, aza kumusanganira,</para>
  <para style="q2" vid="PRO 7:10">yambaye nka maraya, yuzuye uburyarya mu mutima.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />Yari umugore avugira hejuru kandi w’intumva</para>
  <para style="q2" vid="PRO 7:11">ibirenge vyiwe ntivyaragama mu nzu yiwe.<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />Hamwe yaba ari mw’ibarabara; ahandi mu masoko,</para>
  <para style="q2" vid="PRO 7:12">aronderera impande zose.<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Nuko afata wa musore, aramusomagura,</para>
  <para style="q2" vid="PRO 7:13">amubwira ata dusoni ati:<verse eid="PRO 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />“Uno musi nashikanye ikimazi c’ishimwe;</para>
  <para style="q2" vid="PRO 7:14">nashikije ico nasezeranye.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />Ni co gituma naje kugusanganira;</para>
  <para style="q2" vid="PRO 7:15">nashaka kukubona, none ehe turahuye.<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />Uburiri bwanje bushasheko uburengeti bwiza,</para>
  <para style="q2" vid="PRO 7:16">n’amashuka meza yera derere ava muri Egiputa.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />Uburiri bwanje nabusize ibimota neza bitamirana,</para>
  <para style="q2" vid="PRO 7:17">ari vyo imibavu, alowe na kinamoni.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Kaze twinywere ku rukundo gushika buce;</para>
  <para style="q2" vid="PRO 7:18">ingo twinezereze mu rukundo,<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />kuko umugabo wanje si ho ari,</para>
  <para style="q2" vid="PRO 7:19">yafashe urugendo rwa kure.<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />Yatwaye amahera menshi,</para>
  <para style="q2" vid="PRO 7:20">ntazogaruka ukwezi kudaheze.”<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />Nuko amuhendahendesha amajambo asosa,</para>
  <para style="q2" vid="PRO 7:21">amukwegesha akarimi kiwe karesha.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Ubwo nyene aca aramukurikira</para>
  <para style="q2" vid="PRO 7:22">nk’impfizi igiye mw’ibagiro,</para>
  <para style="q1" vid="PRO 7:22">nk’igipfu baboshe bagira bagihane,<verse eid="PRO 7:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23" />gushika umwampi umutobekeranije igitigu,</para>
  <para style="q1" vid="PRO 7:23">nk’inyoni yiroha mu mutego</para>
  <para style="q2" vid="PRO 7:23">itazi ko iza kuhasiga ubuzima.<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />None rero, bana banje, nimunyumvirize;</para>
  <para style="q2" vid="PRO 7:24">mutege amatwi amajambo yanje.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />Ntimukareke imitima yanyu ngo ihindukirire inzira ziwe,</para>
  <para style="q2" vid="PRO 7:25">canke ngo izimirire mu nzira acamwo.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />Kuko yagwishije benshi,</para>
  <para style="q2" vid="PRO 7:26">kandi abo yishe ntibaharurika.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />Inzu yiwe ni inzira ijana mu mva,</para>
  <para style="q2" vid="PRO 7:27">imanuka ija mu kibanza c’abapfuye.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Gutumira kwa Bwenge</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />Ntiwumva ko Bwenge ariko ahamagara n’ijwi rirenga?</para>
  <para style="q2" vid="PRO 8:1">Ntiwumva ko ugutahura kudugije ijwi ryakwo?<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Ahagaze ku gatwe k’umusozi,</para>
  <para style="q2" vid="PRO 8:2">no ku mahwane y’inzira.<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />Arasemerera ari ku marembo aja mu gisagara</para>
  <para style="q2" vid="PRO 8:3">no ku mabarabara ajayo.<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />Avuga ati: “Yemwe bagabo, ni mwebwe mbwira;</para>
  <para style="q2" vid="PRO 8:4">ndugije ijwi mpamagara abantu bose.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Yemwe mwa mburabwenge, nimuronke ubwenge.</para>
  <para style="q2" vid="PRO 8:5">Namwe mwa bijuju, nimuronke ugutahura.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Nimunyumvirize, kuko mfise ivyiza vyo kubabwira,</para>
  <para style="q2" vid="PRO 8:6">nteranuye akanwa kanje ngo mbabwire ibibereye.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />Akanwa kanje kavuga ukuri,</para>
  <para style="q2" vid="PRO 8:7">kuko iminwa yanje yanka ububeshi bw’uburyo bwose.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Amajambo yo mu kanwa kanje yose aragororotse,</para>
  <para style="q2" vid="PRO 8:8">nta na rimwe muri yo rigoramye canke ry’uruhendo,<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />yose arumvikana ku bafise ubwenge,</para>
  <para style="q2" vid="PRO 8:9">kandi aragororotse ku baronse ubumenyi.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Nimuhitemwo inyigisho zanje muzirutishe ifeza,</para>
  <para style="q2" vid="PRO 8:10">n’ubumenyi muburutishe inzahabu.<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Kuko ubwenge buhambaye kurusha amabuye y’agaciro,</para>
  <para style="q2" vid="PRO 8:11">kandi nta co kwipfuzwa cogereranywa na bwo.<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />Jewe Bwenge mbana no kwiyubara.</para>
  <para style="q2" vid="PRO 8:12">Kandi mfise ubwenge no kurobanura.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Kwubaha <char style="nd">Uhoraho</char> bitera kwanka ikibi.</para>
  <para style="q2" vid="PRO 8:13">Ni co gituma nanka ubwibone, ukwishira hejuru,</para>
  <para style="q2" vid="PRO 8:13">ingeso mbi hamwe n’amajambo y’uruhendo.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Kuja inama no kugira ivyiyumviro birashe ni ivyanje;</para>
  <para style="q2" vid="PRO 8:14">mfise ugutahura hamwe n’ububasha.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Abami ni jewe ndabaha kuganza,</para>
  <para style="q2" vid="PRO 8:15">abatware nkabaha gushinga amategeko abereye.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Abaganwa baganza kubera jewe,</para>
  <para style="q2" vid="PRO 8:16">co kimwe n’abashizwe hejuru hamwe n’abacamanza bo kw’isi bose.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />Nkunda abankunda,</para>
  <para style="q2" vid="PRO 8:17">kandi abandondera bose bazondonka.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Ubutunzi n’icubahiro biri kumwe nanje,</para>
  <para style="q2" vid="PRO 8:18">hamwe n’amatungo n’ubugororotsi.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Icamwa canje ni ic’agaciro gusumba inzahabu itunganijwe,</para>
  <para style="q2" vid="PRO 8:19">ivyamwa vyanje bisumvya agaciro ifeza yarobanuwe.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Ngendera mu nzira z’ukugororoka,</para>
  <para style="q2" vid="PRO 8:20">no mu nzira z’ubutungane.<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />Abankunda baragwa ubutunzi,</para>
  <para style="q2" vid="PRO 8:21">kandi nzokwuzuza ibigega vyabo.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />
    <char style="nd">Uhoraho</char> yambumvye mu ntango y’igikorwa ciwe,</para>
  <para style="q2" vid="PRO 8:22">imbere y’uko arema ibindi vyose.<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Nashizweho imbere y’ibihe,</para>
  <para style="q2" vid="PRO 8:23">uhereye mbere na mbere, isi itararemwa.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Navutse ibiyaga bitararemwa,</para>
  <para style="q2" vid="PRO 8:24">amasoko adudubiza amazi atarabaho.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Imbere y’uko imisozi ishirwaho, n’imbere y’uko imitumba ibaho,</para>
  <para style="q2" vid="PRO 8:25">nari naravutse.<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />Navutse kera cane imbere y’uko Imana irema isi n’imirima,</para>
  <para style="q2" vid="PRO 8:26">canke urushi rwa mbere rw’ivu.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />Igihe yashiraho amajuru ni ho nari ndi,</para>
  <para style="q2" vid="PRO 8:27">n’igihe yashiraho urubibe rw’i kuzimu ni ho nari ndi.<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />Igihe <char style="nd">Uhoraho</char> yashira ibicu hejuru ni ho nari ndi,</para>
  <para style="q2" vid="PRO 8:28">kandi n’igihe yaha inkomezi amasoko y’i kuzimu ni ho nari ndi.<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />Igihe yashiraho imbibe z’ibiyaga,</para>
  <para style="q2" vid="PRO 8:29">kugira ngo ntibirenge inkombe zavyo,</para>
  <para style="q1" vid="PRO 8:29">kandi n’igihe yashiraho imfatiro z’isi ni ho nari ndi.<verse eid="PRO 8:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30" />Ico gihe nari kumwe na yo ndi nk’umuhinga.</para>
  <para style="q1" vid="PRO 8:30">Namana akamwemwe imisi yose,</para>
  <para style="q2" vid="PRO 8:30">nezererewe imbere yiwe.<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />Nari nezererewe isi yose yaremye,</para>
  <para style="q2" vid="PRO 8:31">nezererewe abana b’abantu.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />None rero, bana banje, nimuntege amatwi;</para>
  <para style="q2" vid="PRO 8:32">hahiriwe abagendera mu nzira zanje.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Nimwumve inyigisho zanje, maze mugire ubwenge,</para>
  <para style="q2" vid="PRO 8:33">ntimuzirengagize.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Hahiriwe umuntu antega amatwi,</para>
  <para style="q2" vid="PRO 8:34">akaguma anderetse ari ku muryango wanje ku musi ku musi,</para>
  <para style="q2" vid="PRO 8:34">akandindirira mu rwinjiriro.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Kuko uwundonse aba aronse ubuzima,</para>
  <para style="q2" vid="PRO 8:35">kandi agira ikiganza ciza k’<char style="nd">Uhoraho</char>.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />Ariko uwutandondeye aba yishe ubuzima wiwe,</para>
  <para style="q2" vid="PRO 8:36">kuko abanyanka bose bakunda urupfu.”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">Gutumira kwa Bwenge</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />Bwenge yubatse inzu yiwe,</para>
  <para style="q2" vid="PRO 9:1">ayishigikiza inkingi indwi.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />Hanyuma ategura inyama z’amazimano, ategura n’umuvinyu arawutunganya,</para>
  <para style="q2" vid="PRO 9:2">mbere ategura n’imeza yiwe.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />Maze atuma abamukorera ngo baje gutumira,</para>
  <para style="q2" vid="PRO 9:3">ahamagara n’ijwi rirenga ari ahataramutse ho mu gisagara, avuga ati:<verse eid="PRO 9:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 9:4" />“Abanyabwenge buke bose nibaze mu nzu yanje!”</para>
  <para style="q1" vid="PRO 9:4">Ni ko abwira ibijuju, ati:<verse eid="PRO 9:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 9:5" />“Nimuze murye ivyokurya vyanje,</para>
  <para style="q2" vid="PRO 9:5">munywe n’umuvinyu natunganije.<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Nimuve mu nzira zanyu z’ukutamenya mubone kubaho;</para>
  <para style="q2" vid="PRO 9:6">nimugendere mu nzira z’ugutahura.”<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />Uwuhanura umucokoranyi aba yikwegeye ibitutsi,</para>
  <para style="q2" vid="PRO 9:7">kandi uwuhana umunyakibi yikwegera kugirirwa nabi.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Ntuze uhanure umucokoranyi, kuko azoca akwanka;</para>
  <para style="q2" vid="PRO 9:8">uzohanure umunyabwenge, kuko azoca agukunda.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />Niwigisha abanyabwenge, bazokwongererezwa ubwenge;</para>
  <para style="q2" vid="PRO 9:9">kandi niwigisha abagororotsi, bazoca bongereza ubumenyi.<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />Ukwubaha <char style="nd">Uhoraho</char> ni kwo tanguriro ry’ubwenge,</para>
  <para style="q2" vid="PRO 9:10">kandi kumenya Uwera ni kwo gutahura.<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />Muri jewe Bwenge ni ho imisi yawe izokwongererezwa,</para>
  <para style="q2" vid="PRO 9:11">n’ubuzima bwawe bukongerwa imyaka.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />Niwaba umunyabwenge, ubwenge bwawe buzoguha impera.</para>
  <para style="q2" vid="PRO 9:12">Ariko niwaba inshirasoni, ni wewe nyene bizobabaza.<verse eid="PRO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />Umugore w’igipfu avugira hejuru;</para>
  <para style="q2" vid="PRO 9:13">ntagira indero, nta n’ubwenge afise.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Yicara ku muryango w’inzu yiwe,</para>
  <para style="q2" vid="PRO 9:14">ku ntebe iri ahataramutse ho mu gisagara,<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />agahamagara abahita,</para>
  <para style="q2" vid="PRO 9:15">bigiriye mu vyabo,<verse eid="PRO 9:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PRO 9:16" />Akabwira ibijuju ati:</para>
  <para style="q1" vid="PRO 9:16">“Umunyabwenge buke wese niyinjire hano!”<verse eid="PRO 9:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 9:17" />“Amazi y’amibano araryoshe,</para>
  <para style="q2" vid="PRO 9:17">n’indya ziririwe mu kinyegero ziri n’akanovera.”<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Ariko abo ntibamenya ko aho ari ho abapfuye bari,</para>
  <para style="q2" vid="PRO 9:18">ko abashitsi b’uwo mugore bari mu rwobo i kuzimu.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="ms1">Imigani ya Salomo</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Imigani ya Salomo</para>
  <para style="q1" vid="PRO 10:1">Umwana w’ubwenge anezereza se,</para>
  <para style="q2" vid="PRO 10:1">ariko umwana w’igipfu ababaza nyina.<verse eid="PRO 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Ubutunzi buvuye mu kwiba ntiburamba,</para>
  <para style="q2" vid="PRO 10:2">ariko ubugororotsi bukiza umuntu urupfu.<verse eid="PRO 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />
    <char style="nd">Uhoraho</char> ntareka umugororotsi ngo yicwe n’inzara,</para>
  <para style="q2" vid="PRO 10:3">ariko abuza umunyakibi kuronka ivyo umutima wiwe uhahamiye.<verse eid="PRO 10:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Amaboko anebwa akwega ubukene,</para>
  <para style="q2" vid="PRO 10:4">ariko amaboko y’umwete aratungisha.<verse eid="PRO 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />Uwusarura mu ci ni umwana w’ubwenge,</para>
  <para style="q2" vid="PRO 10:5">ariko uwusinzira mw’iyimbura ni umwana ateye isoni.<verse eid="PRO 10:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Imigisha ni urugori rw’umugororotsi,</para>
  <para style="q2" vid="PRO 10:6">ariko umuryano wuzuye akanwa k’umunyakibi.<verse eid="PRO 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Kwibuka umugororotsi ni umugisha,</para>
  <para style="q2" vid="PRO 10:7">ariko izina ry’umunyakikibi rizozimangana.<verse eid="PRO 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />Umutima w’umunyabwenge wemera ukurongorwa,</para>
  <para style="q2" vid="PRO 10:8">ariko igipfu kidaharura ivyo kivuga cikwegera uguhona.<verse eid="PRO 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Intungane igenda ata co yinona,</para>
  <para style="q2" vid="PRO 10:9">ariko uwuca mu nzira zigoramanze azomenyekana.<verse eid="PRO 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Uwuvuna urugohe rw’uburyarya atera umubabaro,</para>
  <para style="q2" vid="PRO 10:10">kandi iminwa y’igipfu izana uguhona.<verse eid="PRO 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />Akanwa k’umugororotsi ni isoko y’ubuzima,</para>
  <para style="q2" vid="PRO 10:11">ariko akanwa k’umunyakibi kuzura umuryano.<verse eid="PRO 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />Urwanko ruvyura amatati,</para>
  <para style="q2" vid="PRO 10:12">ariko urukundo rupfuka ibibi vyose.<verse eid="PRO 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />Ubwenge ubusanga ku minwa y’uwuzi kurobanura,</para>
  <para style="q2" vid="PRO 10:13">ariko inkoni iri ku mugongo w’abatagira ubwenge.<verse eid="PRO 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Abanyabwenge bimbura ubumenyi,</para>
  <para style="q2" vid="PRO 10:14">ariko akanwa k’igipfu kagikwegera uguhona.<verse eid="PRO 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Ubutunzi bw’umutunzi bumubera igisagara gikomeye,</para>
  <para style="q2" vid="PRO 10:15">ariko ubukene ni bwo buhitana aboro.<verse eid="PRO 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Ingero y’abagororotsi ibazanira ubuzima,</para>
  <para style="q2" vid="PRO 10:16">ariko umwimbu w’abanyakibi ni icaha n’urupfu.<verse eid="PRO 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />Uwemera gutozwa indero ari mu nzira ijana mu buzima,</para>
  <para style="q2" vid="PRO 10:17">ariko uwanka guhanurwa ahubisha abandi.<verse eid="PRO 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Uwuhisha urwanko iminwa yiwe yuzuye ububeshi,</para>
  <para style="q2" vid="PRO 10:18">kandi uwuvuga abandi nabi ni igipfu.<verse eid="PRO 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Iyo amajambo abaye menshi, n’icaha kiba kiri hafi,</para>
  <para style="q2" vid="PRO 10:19">ariko uwugumya ururimi ni umunyabwenge.<verse eid="PRO 10:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Ururimi rw’umugororotsi ni ifeza yarobanuwe,</para>
  <para style="q2" vid="PRO 10:20">ariko umutima w’umunyakibi nta co umaze.<verse eid="PRO 10:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Amajambo y’umugororotsi afasha benshi,</para>
  <para style="q2" vid="PRO 10:21">ariko ibipfu vyicwa no kubura ubwenge.<verse eid="PRO 10:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />Umugisha w’<char style="nd">Uhoraho</char> uratungisha,</para>
  <para style="q2" vid="PRO 10:22">kandi ntuvanzwe n’umuruho.<verse eid="PRO 10:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Igipfu kinezerererwa ingeso zaco mbi,</para>
  <para style="q2" vid="PRO 10:23">ariko uwufise ugutahura anezerererwa ubwenge bwiwe.<verse eid="PRO 10:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Ivyo umunyakibi atinya ni vyo bizomushikira,</para>
  <para style="q2" vid="PRO 10:24">kandi ivyo umugororotsi yipfuza ni vyo azohabwa.<verse eid="PRO 10:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Iyo igihuhusi kije, umunyakibi atwarwa na co,</para>
  <para style="q2" vid="PRO 10:25">ariko umugororotsi yama ashikamye ibihe vyose.<verse eid="PRO 10:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Nk’uko inkarisha imerera amenyo canke umwotsi umerera amaso,</para>
  <para style="q2" vid="PRO 10:26">ni ko umunebwe amerera shebuja.<verse eid="PRO 10:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />Ukwubaha <char style="nd">Uhoraho</char> vyongereza imyaka yo kubaho,</para>
  <para style="q2" vid="PRO 10:27">ariko imyaka y’umunyakibi izogabanywa.<verse eid="PRO 10:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Ico umugororotsi yitega ni umunezero,</para>
  <para style="q2" vid="PRO 10:28">ariko ivyizigiro vy’umunyakibi nta ho bimushikana.<verse eid="PRO 10:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />Inzira y’<char style="nd">Uhoraho</char> ni ubuhungiro bw’abagororotsi,</para>
  <para style="q2" vid="PRO 10:29">ariko ni uguhona kw’umunyakibi.<verse eid="PRO 10:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Umugororotsi ntazorandurwa,</para>
  <para style="q2" vid="PRO 10:30">ariko umunyakibi ntazokwama mu gihugu.<verse eid="PRO 10:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Akanwa k’umugororotsi kavuga ivy’ubwenge,</para>
  <para style="q2" vid="PRO 10:31">ariko ururimi ruvuga ivy’ubujuju ruzocibwa.<verse eid="PRO 10:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Iminwa y’umugororotsi ivuga ibibereye,</para>
  <para style="q2" vid="PRO 10:32">ariko akanwa k’umunyakibi kavuga amajambo y’ubujuju gusa.<verse eid="PRO 10:32" /></para>
  <para style="b" />
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />Umunzane uziritse ni igisesema k’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PRO 11:1">ariko ingero ibereye iramunezereza.<verse eid="PRO 11:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />Iyo ubwibone buje, kumaramara kurakurikira,</para>
  <para style="q2" vid="PRO 11:2">ariko mu kwicisha bugufi havamwo ubwenge.<verse eid="PRO 11:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Gutungana kw’abagororotsi kuzobarongora,</para>
  <para style="q2" vid="PRO 11:3">ariko ubujuju bw’abahinduka abandi buzobarandura.<verse eid="PRO 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Ubutunzi nta co buzomara ku musi w’urubanza,</para>
  <para style="q2" vid="PRO 11:4">ariko ubugororotsi bukiza urupfu.<verse eid="PRO 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Ubugororotsi bw’inyankamugayo bugorora inzira zabo,</para>
  <para style="q2" vid="PRO 11:5">ariko abanyakibi bazokubitwa hasi n’ububi bwabo.<verse eid="PRO 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Ubugororotsi bw’abatunganye ni bwo buzobakiza,</para>
  <para style="q2" vid="PRO 11:6">ariko abaryarukanyi bazogwa mu vyipfuzo vyabo bibi.<verse eid="PRO 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />Iyo umunyakibi apfuye, ivyizigiro vyiwe biba biheranye na we.</para>
  <para style="q2" vid="PRO 11:7">Ivyo yari yiteze mu nkomezi ziwe bigahinduka ubusa.<verse eid="PRO 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />Umugororotsi aratabarwa iyo ageze mu vyago,</para>
  <para style="q2" vid="PRO 11:8">maze ayo mabi akagwa ku munyakibi.<verse eid="PRO 11:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Uwutubaha Imana aranduza akanwa mugenziwe,</para>
  <para style="q2" vid="PRO 11:9">ariko ubumenyi buzokiza umugororotsi.<verse eid="PRO 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Umugororotsi ateye imbere, igisagara ciwe kiranezerwa;</para>
  <para style="q2" vid="PRO 11:10">kandi umunyakibi apfuye, havuzwa impundu.<verse eid="PRO 11:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Umugisha w’abagororotsi ushira hejuru igisagara,</para>
  <para style="q2" vid="PRO 11:11">ariko akanwa k’abanyakibi karagisambura.<verse eid="PRO 11:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />Uwukengera umubanyi ni imburabwenge,</para>
  <para style="q2" vid="PRO 11:12">ariko uwufise ugutahura agumya ururimi rwiwe.<verse eid="PRO 11:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />Umunyarusaku amena amabanga,</para>
  <para style="q2" vid="PRO 11:13">ariko umwizigirwa arayagumya.<verse eid="PRO 11:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />Ihanga ribuze abarongozi b’ubwenge riratemba,</para>
  <para style="q2" vid="PRO 11:14">ariko abajenama benshi barizanira kuba amahoro.<verse eid="PRO 11:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Uwiyemeza kurihira umwenda uwo atazi nta kabuza bizomubabaza,</para>
  <para style="q2" vid="PRO 11:15">ariko uwanka kwifatanya n’uwundi mu mwenda azoba amahoro.<verse eid="PRO 11:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Umugore w’umugwaneza arubahwa,</para>
  <para style="q2" vid="PRO 11:16">ariko abagabo b’ibirara ico bunguka ni ubutunzi gusa.<verse eid="PRO 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />Umugabo w’umugwaneza abikuramwo impera,</para>
  <para style="q2" vid="PRO 11:17">ariko inkozi y’ikibi yikwegera uguhona.<verse eid="PRO 11:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Umunyakibi aronka impera zitari zo,</para>
  <para style="q2" vid="PRO 11:18">ariko uwurima ukugororoka yimbura impera nyazo.<verse eid="PRO 11:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Umugororotsi aronka ubuzima,</para>
  <para style="q2" vid="PRO 11:19">ariko abanyakibi baja mu rupfu.<verse eid="PRO 11:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />
    <char style="nd">Uhoraho</char> asesemwa n’abafise imitima yuzuye uruhendo,</para>
  <para style="q2" vid="PRO 11:20">ariko agahimbarwa n’abagendera mu nzira zitagira agasembwa.<verse eid="PRO 11:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />Ubimenye: Umunyakibi ntazobura guhanwa,</para>
  <para style="q2" vid="PRO 11:21">ariko uruvyaro rw’umugororotsi ruzokwidegemvya.<verse eid="PRO 11:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Ubwiza bw’umugore atagira ubwenge,</para>
  <para style="q2" vid="PRO 11:22">ni nk’impeta y’inzahabu ku zuru ry’ingurube.<verse eid="PRO 11:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Ivyipfuzo vy’umugororotsi bimushikana ku vyiza,</para>
  <para style="q2" vid="PRO 11:23">ariko ivyizigiro vy’umunyakibi bimushikana ku burake.<verse eid="PRO 11:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Umwe atanga abikunze, akaronka umurengera;</para>
  <para style="q2" vid="PRO 11:24">uwundi akimana birenze urugero, bikamutera ubukene.<verse eid="PRO 11:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />Uwutanga aratunga,</para>
  <para style="q2" vid="PRO 11:25">kandi uwuhembura abandi na we azohemburwa.<verse eid="PRO 11:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Uwimana ingano avumwa n’abantu,</para>
  <para style="q2" vid="PRO 11:26">ariko uwuzishora iyo zikenye asabirwa umugisha n’abantu.<verse eid="PRO 11:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />Uwurondera ineza aronka ugukundwa,</para>
  <para style="q2" vid="PRO 11:27">ariko uwurondera ikibi ni co kimushikira.<verse eid="PRO 11:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />Uwishimira ubutunzi bwiwe azotemba,</para>
  <para style="q2" vid="PRO 11:28">ariko umugororotsi azototahara nk’ibabi ryo mu rushana.<verse eid="PRO 11:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />Uwutera umuryano mu muryago azoragwa umuyaga gusa,</para>
  <para style="q2" vid="PRO 11:29">kandi igipfu kizokorera abanyabwenge.<verse eid="PRO 11:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Imbuto y’ukugororoka ivamwo igiti c’ubuzima,</para>
  <para style="q2" vid="PRO 11:30">kandi umunyabwenge akiza ubuzima.<verse eid="PRO 11:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />Nimba umugororotsi aronka impera yiwe hano kw’isi,</para>
  <para style="q2" vid="PRO 11:31">mbega umunyakibi n’umunyavyaha bo bizobagendera gute?<verse eid="PRO 11:31" /></para>
  <para style="b" />
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />Uwukunda gutozwa indero wese akunda ubumenyi,</para>
  <para style="q2" vid="PRO 12:1">ariko uwanka guhanurwa wese ni ikijuju.<verse eid="PRO 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />Umunyendanziza wese agirirwa ubuntu n’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PRO 12:2">ariko <char style="nd">Uhoraho</char> atsindisha abafise inama z’ibibi.<verse eid="PRO 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />Nta muntu ashikamishwa no kuba inkozi y’ikibi,</para>
  <para style="q2" vid="PRO 12:3">ariko umugororotsi ashinga imizi ikagera kure.<verse eid="PRO 12:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />Umugore w’ingeso nziza ni urugori rw’umugabo wiwe,</para>
  <para style="q2" vid="PRO 12:4">ariko umugore w’isoni nke ni nk’ingwara idakira mu magufa y’umugabo wiwe.<verse eid="PRO 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Imigabo y’umugororotsi iratunganye,</para>
  <para style="q2" vid="PRO 12:5">ariko impanuro z’umunyakibi zuzuye ububeshi.<verse eid="PRO 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Amajambo y’umunyakibi ameze nk’umutego wo gusesa amaraso,</para>
  <para style="q2" vid="PRO 12:6">ariko amajambo y’abagororotsi ararokora.<verse eid="PRO 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />Abanyakibi barapfa bakazimangana,</para>
  <para style="q2" vid="PRO 12:7">ariko umuryango w’umugororotsi wama uhangamye.<verse eid="PRO 12:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />Umuntu ashimwa kubera ukwiyubara kwiwe,</para>
  <para style="q2" vid="PRO 12:8">ariko igipfu kirakengerwa.<verse eid="PRO 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />Wopfuma uba umukene afise umukozi umwe,</para>
  <para style="q2" vid="PRO 12:9">hako wigira umukire utagira n’ico urya.<verse eid="PRO 12:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Umugororotsi yitaho n’ivyo ibitungwa vyiwe bishaka,</para>
  <para style="q2" vid="PRO 12:10">ariko n’ubugwaneza bw’umunyakibi buba buteye ubwoba.<verse eid="PRO 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Uwurima itongo ryiwe azoronka umwimbu mwinshi,</para>
  <para style="q2" vid="PRO 12:11">ariko uwirukira ibitagira ikimazi ni imburabwenge.<verse eid="PRO 12:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Umunyavyaha yipfuza ibirimba vy’abanyakibi,</para>
  <para style="q2" vid="PRO 12:12">ariko uwubaha Imana arashinga imizi,</para>
  <para style="q2" vid="PRO 12:12">akama ivyamwa vyiwe bwite.<verse eid="PRO 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Umunyavyaha afatwa n’amajambo yiwe ubwiwe,</para>
  <para style="q2" vid="PRO 12:13">ariko umugororotsi ntafatwa mu makuba.<verse eid="PRO 12:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Ivyamwa biva mu kanwa k’umuntu ni vyo bimuhesha ivyiza,</para>
  <para style="q2" vid="PRO 12:14">nk’uko umuntu ahabwa impera n’ibikorwa vy’amaboko yiwe.<verse eid="PRO 12:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />Igipfu cibwira ko ingeso zaco zitunganye,</para>
  <para style="q2" vid="PRO 12:15">ariko umunyabwenge yumviriza impanuro.<verse eid="PRO 12:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Igipfu cihutira kugaragaza ishavu ryaco,</para>
  <para style="q2" vid="PRO 12:16">ariko umunyamakenga yirengagiza igitutsi.<verse eid="PRO 12:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Icabona c’ukuri gisura ibitunganye,</para>
  <para style="q2" vid="PRO 12:17">ariko icabona kibi kivuga ibinyoma.<verse eid="PRO 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />Amajambo y’imvuzi acumitana nk’inkota</para>
  <para style="q2" vid="PRO 12:18">ariko ururimi rw’umunyabwenge rurakiza.<verse eid="PRO 12:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Amajambo y’ukuri yamaho ibihe vyose,</para>
  <para style="q2" vid="PRO 12:19">ariko ikiyoma kimara umwanya muto.<verse eid="PRO 12:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Ububeshi bwuzura mu kanwa k’abagira inama yo gukora ibibi,</para>
  <para style="q2" vid="PRO 12:20">ariko abaja inama z’amahoro buzura umunezero mu mitima yabo.<verse eid="PRO 12:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />Umugororotsi nta kibi kimushikira,</para>
  <para style="q2" vid="PRO 12:21">ariko umunyakibi we yuzuye amagorwa.<verse eid="PRO 12:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />
    <char style="nd">Uhoraho</char> azira iminwa ibesha,</para>
  <para style="q2" vid="PRO 12:22">agahimbarirwa abizigirwa.<verse eid="PRO 12:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Umunyamakenga yizigamira ubumenyi bwiwe,</para>
  <para style="q2" vid="PRO 12:23">ariko igipfu camamaza ubujuju bwaco.<verse eid="PRO 12:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Amaboko aroranya azorongora,</para>
  <para style="q2" vid="PRO 12:24">ariko ubunebwe bushikana ku kuba umuja.<verse eid="PRO 12:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />Umutima urimwo amaganya uraremerwa,</para>
  <para style="q2" vid="PRO 12:25">ariko ijambo ryo gutera intege rihagurutsa uwuribwiwe.<verse eid="PRO 12:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Umugororotsi ahanura neza bagenziwe,</para>
  <para style="q2" vid="PRO 12:26">ariko inzira z’umunyakibi zirabazimiza.<verse eid="PRO 12:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Umunebwe ntashobora no kwotsa ico yahize agafata,</para>
  <para style="q2" vid="PRO 12:27">ariko uwuzi kuroranya akoresha neza ico aronse cose.<verse eid="PRO 12:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />Mu nzira y’ubugororotsi hari ubuzima,</para>
  <para style="q2" vid="PRO 12:28">kandi muri iyo nzira hari ukudapfa.<verse eid="PRO 12:28" /></para>
  <para style="b" />
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />Umwana w’ubwenge yumviriza inyigisho za se,</para>
  <para style="q2" vid="PRO 13:1">ariko umwana atagira indero ntiyemera gukosorwa.<verse eid="PRO 13:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />Umuntu anezerererwa ivyiza bivuye ku vyamwa vy’akanwa kiwe,</para>
  <para style="q2" vid="PRO 13:2">ariko abahemu bipfuza cane umuryano.<verse eid="PRO 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />Abazigama iminwa yabo baba barinze ubuzima bwabo,</para>
  <para style="q2" vid="PRO 13:3">ariko abavuga batiyumviriye bikwegera uguhona.<verse eid="PRO 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />Umunebwe aripfuza mugabo nta co aronka,</para>
  <para style="q2" vid="PRO 13:4">ariko umunyamwete azoshitsa ivyipfuzo vyiwe vyose.<verse eid="PRO 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Umugororotsi yanka ububeshi,</para>
  <para style="q2" vid="PRO 13:5">ariko umunyakibi akengereza abandi</para>
  <para style="q2" vid="PRO 13:5">akikwegera isoni n’agasuzuguro.<verse eid="PRO 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Ubugororotsi buzigama umwizigirwa,</para>
  <para style="q2" vid="PRO 13:6">ariko umunyakibi azimizwa n’icaha.<verse eid="PRO 13:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />Hari uwigira umutunzi kandi ata co afise,</para>
  <para style="q2" vid="PRO 13:7">uwundi akigira umukene kandi atunze cane.<verse eid="PRO 13:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Umutunzi ashobora gutanga ivyo gucungura amagara yiwe,</para>
  <para style="q2" vid="PRO 13:8">ariko umukene ntiyitaho n’ibimutera ubwoba.<verse eid="PRO 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />Ubuzima bw’umugororotsi bwuzuye umuco n’umunezero,</para>
  <para style="q2" vid="PRO 13:9">ariko itara ry’umunyakibi ririko rirazima.<verse eid="PRO 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />Ubwibone bukwega amatati,</para>
  <para style="q2" vid="PRO 13:10">ariko ubwenge ubusanga mu bemera impanuro.<verse eid="PRO 13:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Ubutunzi buvuye mu vyibwe buhera ningoga,</para>
  <para style="q2" vid="PRO 13:11">ariko ubuvuye mu gukora cane buguma bugwira.<verse eid="PRO 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />Iyo ivyitezwe bitevye, umutima uragwara,</para>
  <para style="q2" vid="PRO 13:12">ariko icipfujwe iyo gishitse, kiba igiti c’ubuzima.<verse eid="PRO 13:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />Uwugaya inyigisho azovyishura,</para>
  <para style="q2" vid="PRO 13:13">ariko uwubaha amabwirizwa abihererwa impera.<verse eid="PRO 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />Inyigisho y’umunyabwenge ni isoko y’ubuzima,</para>
  <para style="q2" vid="PRO 13:14">igarura umuntu ngo ntagwe mu mitego y’urupfu.<verse eid="PRO 13:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Ukumenya kwiza gutera igikundiro,</para>
  <para style="q2" vid="PRO 13:15">ariko inzira z’abahemu zibashikana mu mahonero.<verse eid="PRO 13:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />Umunyamakenga akorana ubwenge,</para>
  <para style="q2" vid="PRO 13:16">ariko igipfu kigaragaza ubujuju bwaco.<verse eid="PRO 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Intumwa mbi igwa mu vyago,</para>
  <para style="q2" vid="PRO 13:17">ariko intumwa nziza izana ugukira.<verse eid="PRO 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />Uwanka guhanurwa bimutera ubukene no kumaramara,</para>
  <para style="q2" vid="PRO 13:18">ariko uwuzigama impanuro aterwa iteka.<verse eid="PRO 13:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Iyo icipfujwe gishitse kinezereza umutima,</para>
  <para style="q2" vid="PRO 13:19">ariko ibipfu bizirana no kureka icaha.<verse eid="PRO 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />Uwugendana n’abanyabwenge aba umunyabwege,</para>
  <para style="q2" vid="PRO 13:20">ariko uwifatanya n’igipfu arabizira.<verse eid="PRO 13:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />Ivyago bikurikirana umunyavyaha,</para>
  <para style="q2" vid="PRO 13:21">ariko kugubwa neza ni yo mpera y’abagororotsi.<verse eid="PRO 13:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />Umugwaneza asigira itunga abuzukuru,</para>
  <para style="q2" vid="PRO 13:22">ariko itunga ry’umunyavyaha ribikiwe abubaha Imana.<verse eid="PRO 13:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Umurima w’umworo ushobora kwama cane,</para>
  <para style="q2" vid="PRO 13:23">ariko akarenganyo kagatuma asahurwa vyose.<verse eid="PRO 13:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />Uwurinda umwana wiwe inkoni aba amwanka,</para>
  <para style="q2" vid="PRO 13:24">ariko uwumukunda amuhana uko bikwiye.<verse eid="PRO 13:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Umugororotsi araronka ivyo arya agahaga,</para>
  <para style="q2" vid="PRO 13:25">ariko inda y’umunyakibi yamana inzara.<verse eid="PRO 13:25" /></para>
  <para style="b" />
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />Umugore w’umunyabwenge yubaka urugo rwiwe,</para>
  <para style="q2" vid="PRO 14:1">ariko uw’igipfu arusambuza amaboko yiwe.<verse eid="PRO 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />Uwubaha <char style="nd">Uhoraho</char> wese agendera mu bugororotsi,</para>
  <para style="q2" vid="PRO 14:2">ariko abamukengera bose baba bataye inzira.<verse eid="PRO 14:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Amajambo y’igipfu akwegera inkoni umugongo waco,</para>
  <para style="q2" vid="PRO 14:3">ariko amajambo y’umunyabwenge ni yo amuzigama.<verse eid="PRO 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Ahatagira inka zirima ubwato bugumana isuku,</para>
  <para style="q2" vid="PRO 14:4">ariko inkomezi z’inka irima ni zo zizana umwimbu mwinshi.<verse eid="PRO 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />Icabona c’ukuri ntikibesha,</para>
  <para style="q2" vid="PRO 14:5">ariko icabona kibi gihumeka ububeshi.<verse eid="PRO 14:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />Umucokoranyi ararondera ubwenge ntaburonke,</para>
  <para style="q2" vid="PRO 14:6">ariko ubwenge buranyaruka kuza ku wufise ugutahura.<verse eid="PRO 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Wigirwe kure y’igipfu,</para>
  <para style="q2" vid="PRO 14:7">kuko ata bumenyi uzosanga mu majambo yaco.<verse eid="PRO 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Abanyamakenga baratahura iyo bariko baja,</para>
  <para style="q2" vid="PRO 14:8">ariko ibipfu ni vyo vyikwegera kuzimira.<verse eid="PRO 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Ibipfu bicokora uwigarura kubera icaha yakoze,</para>
  <para style="q2" vid="PRO 14:9">ariko mu bagororotsi hari ukurondera gusubiza hamwe.<verse eid="PRO 14:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Umutima wose urazi umururazi uri muri wo,</para>
  <para style="q2" vid="PRO 14:10">kandi nta wushobora gutahura umunezero wawo nka wo.<verse eid="PRO 14:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />Inzu y’umunyakibi izosenyurwa,</para>
  <para style="q2" vid="PRO 14:11">ariko ihema ry’umugororotsi rizotera imbere.<verse eid="PRO 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />Hari inzira umuntu yibwira ko ari nziza,</para>
  <para style="q2" vid="PRO 14:12">ariko impera yayo ikamushikana mu rupfu.<verse eid="PRO 14:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Umuntu ashobora gutwenga kandi umutima wiwe urimwo agahinda,</para>
  <para style="q2" vid="PRO 14:13">ariko inyuma y’agatwengo, agahinda kagumaho.<verse eid="PRO 14:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Abasubiye inyuma mu mitima bazokwimbura ibihwanye n’inzira zabo,</para>
  <para style="q2" vid="PRO 14:14">abagwaneza na bo bazobihererwa impera.<verse eid="PRO 14:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Ikijuju cemera ibivuzwe vyose,</para>
  <para style="q2" vid="PRO 14:15">ariko umunyamakenga yiyumvira ku ntambuko ziwe.<verse eid="PRO 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />Umunyabwenge yubaha <char style="nd">Uhoraho</char> akanka ikibi,</para>
  <para style="q2" vid="PRO 14:16">ariko igipfu cigira icikwije, kikiyemera ubwaco.<verse eid="PRO 14:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Uwihuta kuraka akora ivy’ubupfu,</para>
  <para style="q2" vid="PRO 14:17">kandi uwugira imigabo mibi arankwa.<verse eid="PRO 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Ibijuju vyambikwa ubupfu,</para>
  <para style="q2" vid="PRO 14:18">ariko abanyabwenge bambikwa urugori rw’ubumenyi.<verse eid="PRO 14:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />Ababi bazokwikubita imbere y’abeza,</para>
  <para style="q2" vid="PRO 14:19">kandi abanyavyaha bazokwunama imbere y’irembo ry’umugororotsi.<verse eid="PRO 14:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />Aboro barankwa mbere n’imbere y’ababanyi babo,</para>
  <para style="q2" vid="PRO 14:20">ariko abatunzi bagira abagenzi benshi.<verse eid="PRO 14:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />Uwugaya mugenziwe aba akoze icaha,</para>
  <para style="q2" vid="PRO 14:21">ariko uwufasha aboro agira umugisha.<verse eid="PRO 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />Abagira imigabo yo gukora ibibi baba barazimiye,</para>
  <para style="q2" vid="PRO 14:22">ariko abategura gukora ineza baronka urukundo n’ubwizigirwa.<verse eid="PRO 14:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />Ico umuntu akora kimuzanira inyungu,</para>
  <para style="q2" vid="PRO 14:23">ariko amajambo yonyene azana amapfa.<verse eid="PRO 14:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Ubutunzi bw’umunyabwenge ni bwo rugori rwiwe,</para>
  <para style="q2" vid="PRO 14:24">ariko ubupfu bw’ibipfu buzana ubupfu nyene.<verse eid="PRO 14:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />Icabona kivuga ukuri kirokora ubuzima,</para>
  <para style="q2" vid="PRO 14:25">ariko icabona kibi ni igihemu.<verse eid="PRO 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />Uwubaha wese afise ubwihisho bukomeye k’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PRO 14:26">kandi uruvyaro rwiwe <char style="nd">Uhoraho</char> azorubera ubuhungiro.<verse eid="PRO 14:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />Ukwubaha <char style="nd">Uhoraho</char> ni isoko y’ubuzima,</para>
  <para style="q2" vid="PRO 14:27">kugarura umuntu ngo ntagwe mu mitego y’urupfu.<verse eid="PRO 14:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Ihanga rifise abantu benshi ni iteka ku mwami,</para>
  <para style="q2" vid="PRO 14:28">ariko iyo ribuze abantu aba atakaje ububasha.<verse eid="PRO 14:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />Uwitonda aba ahambaye kubera ugutahura kwiwe,</para>
  <para style="q2" vid="PRO 14:29">ariko uwihuta kuraka akwiragiza ubupfu.<verse eid="PRO 14:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />Umutima urimwo amahoro uzana ubuzima bwiza mu mubiri,</para>
  <para style="q2" vid="PRO 14:30">ariko ukwipfuza kuboza amagufa.<verse eid="PRO 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />Uwurenganya aboro aba akengereye Umuremyi wabo,</para>
  <para style="q2" vid="PRO 14:31">ariko uwufasha aboro aba ahesheje Imana icubahiro.<verse eid="PRO 14:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />Iyo ivyago biteye, abanyakibi baratikira,</para>
  <para style="q2" vid="PRO 14:32">ariko no mu rupfu abagororotsi bafise ubuhungiro mu Mana.<verse eid="PRO 14:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Ubwenge bwicaye mu mutima utahura,</para>
  <para style="q2" vid="PRO 14:33">kandi no ku bipfu ntibureka kwimenyekanisha.<verse eid="PRO 14:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Ubugororotsi ni bwo bushira hejuru ihanga,</para>
  <para style="q2" vid="PRO 14:34">ariko icaha kigayisha ihanga iryo ari ryo ryose.<verse eid="PRO 14:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Umwami atonesha umunyabwenge,</para>
  <para style="q2" vid="PRO 14:35">ariko uburake bwiwe buri ku muntu akora ibiterasoni.<verse eid="PRO 14:35" /></para>
  <para style="b" />
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />Inyishu yiyoroheje ihwamika uburake,</para>
  <para style="q2" vid="PRO 15:1">ariko ijambo ribi rivyura ishavu.<verse eid="PRO 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Ururimi rw’umunyabwenge rutuma ubwenge bwipfuzwa,</para>
  <para style="q2" vid="PRO 15:2">ariko akanwa k’igipfu ko gasuka ubupfu.<verse eid="PRO 15:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />Amaso y’<char style="nd">Uhoraho</char> abera hose icarimwe,</para>
  <para style="q2" vid="PRO 15:3">yihweza ababi n’abeza.<verse eid="PRO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Amajambo yiyoroheje ni igiti c’ubuzima,</para>
  <para style="q2" vid="PRO 15:4">ariko amajambo y’ubujuju avuna umutima.<verse eid="PRO 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />Igipfu gikengera impanuro z’umuvyeyi,</para>
  <para style="q2" vid="PRO 15:5">ariko uwemera guhanurwa ni umunyabwenge.<verse eid="PRO 15:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Inzu y’umugororotsi yuzura ubutunzi,</para>
  <para style="q2" vid="PRO 15:6">ariko umwimbu w’abanyakibi ubazanira uguhona.<verse eid="PRO 15:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />Iminwa y’umunyabwenge ikwiragiza ubumenyi,</para>
  <para style="q2" vid="PRO 15:7">ariko umutima w’igipfu ntugira ico utanga.<verse eid="PRO 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />Amashikanwa y’umunyakibi ni igisesema k’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PRO 15:8">ariko isengesho ry’umugororotsi riramuhimbara.<verse eid="PRO 15:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />Ingeso z’umunyakibi ni igisesema k’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PRO 15:9">ariko akunda abarondera ukugororoka.<verse eid="PRO 15:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Ibihano bikomeye biraririye abata inzira,</para>
  <para style="q2" vid="PRO 15:10">kandi uwanka guhanurwa azopfa.<verse eid="PRO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />Nimba Rupfu na Mahonero ata co bishobora guhisha <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PRO 15:11">mbega umutima w’umuntu wowo nturushiriza kumugaragarira?<verse eid="PRO 15:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Umucokoranyi yanka guhanurwa,</para>
  <para style="q2" vid="PRO 15:12">ntiyigera ahanuza umunyabwenge.<verse eid="PRO 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Umutima uhimbawe utuma umuntu agira mu maso hakeye,</para>
  <para style="q2" vid="PRO 15:13">ariko umubabaro uvuna umutima.<verse eid="PRO 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Umutima w’ubwenge urondera ugutahura,</para>
  <para style="q2" vid="PRO 15:14">ariko akanwa k’igipfu karya ubupfu.<verse eid="PRO 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Ibihe vy’umubabaro ni bibi,</para>
  <para style="q2" vid="PRO 15:15">ariko uwufise umutima unezerewe yibera mu misi mikuru.<verse eid="PRO 15:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />Wopfuma ugira bike birimwo ukwubaha <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PRO 15:16">hako utunga vyinshi vyuzuyemwo uruhagarara.<verse eid="PRO 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />Utuboga dusangiwe mu rukundo</para>
  <para style="q2" vid="PRO 15:17">turuta ibinure usangiye n’uwo mwankana.<verse eid="PRO 15:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Uwushavura vuba avyura imitongano,</para>
  <para style="q2" vid="PRO 15:18">ariko uwutekanye asubiza hasi induru.<verse eid="PRO 15:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Inzira z’umunebwe zizibije amahwa,</para>
  <para style="q2" vid="PRO 15:19">ariko inzira z’umugororotsi ni umuharuro.<verse eid="PRO 15:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />Umwana w’ubwenge atera umunezero se wiwe,</para>
  <para style="q2" vid="PRO 15:20">ariko igipfu co gikengera nyina.<verse eid="PRO 15:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Ubupfu bunezereza abatagira ugutahura,</para>
  <para style="q2" vid="PRO 15:21">umunyabwenge aguma mu nzira zigororotse.<verse eid="PRO 15:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Imigambi irapfa kubera ukudahanuza,</para>
  <para style="q2" vid="PRO 15:22">ariko ahari abajenama benshi, imigambi irakomera.<verse eid="PRO 15:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Umuntu wese anezerererwa inyishu ibereye,</para>
  <para style="q2" vid="PRO 15:23">kandi ni vyiza kuvuga ijambo ribereye mu gihe gikwiye.<verse eid="PRO 15:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Ku munyabwenge, inzira y’ubugingo igenda iduga,</para>
  <para style="q2" vid="PRO 15:24">kugira ngo imubuze kumanuka aja iwabo w’abapfuye.<verse eid="PRO 15:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />
    <char style="nd">Uhoraho</char> asenyura inzu y’umunyabwibone,</para>
  <para style="q2" vid="PRO 15:25">ariko akomeza inzitiro z’umupfakazi.<verse eid="PRO 15:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />Ivyiyumviro vy’umunyakibi ni igisesema k’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PRO 15:26">ariko ivy’ab’imitima itanduye biramuhimbara.<verse eid="PRO 15:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Inkunzi y’amahera ituma ibintu bihona mu muryango,</para>
  <para style="q2" vid="PRO 15:27">ariko uwanka ibiturire azobaho.<verse eid="PRO 15:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Umutima w’umugororotsi ugera amajambo avuga,</para>
  <para style="q2" vid="PRO 15:28">ariko akanwa k’igipfu gaseseka ibibi.<verse eid="PRO 15:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />
    <char style="nd">Uhoraho</char> ari kure y’abanyakibi,</para>
  <para style="q2" vid="PRO 15:29">ariko isengesho ry’umugororotsi araryumva.<verse eid="PRO 15:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Kugira mu maso hakeye bizana amahoro mu mutima,</para>
  <para style="q2" vid="PRO 15:30">kandi inkuru nziza ikomeza amagufa.<verse eid="PRO 15:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />Uwemera gukosorwa bimujana mu bugingo</para>
  <para style="q2" vid="PRO 15:31">azoba uwuhambaye mu banyabwenge.<verse eid="PRO 15:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Uwanka guhanwa yanka ubugingo bwiwe,</para>
  <para style="q2" vid="PRO 15:32">ariko uwemera guhanurwa yironkera ugutahura.<verse eid="PRO 15:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />Ukwubaha <char style="nd">Uhoraho</char> kwigisha ubwenge,</para>
  <para style="q2" vid="PRO 15:33">kandi ukwicisha ubugufi ni kwo gutangurira icubahiro.<verse eid="PRO 15:33" /></para>
  <para style="b" />
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Umuntu agira imigabo mu mutima,</para>
  <para style="q2" vid="PRO 16:1">ariko <char style="nd">Uhoraho</char> ni we atanga inyishu ibereye.<verse eid="PRO 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Ingeso z’umuntu wese zimubera nk’izitunganye,</para>
  <para style="q2" vid="PRO 16:2">ariko <char style="nd">Uhoraho</char> ni we asuzuma umutima wiwe.<verse eid="PRO 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Uze wegurire <char style="nd">Uhoraho</char> ivyo ukora vyose,</para>
  <para style="q2" vid="PRO 16:3">ni ho ivyawe bizogenda neza.<verse eid="PRO 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />
    <char style="nd">Uhoraho</char> yashizeho ikintu cose afise intumbero.</para>
  <para style="q2" vid="PRO 16:4">N’umunyakibi yamushiriyeho umusi wo kurandurwa.<verse eid="PRO 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />
    <char style="nd">Uhoraho</char> yanka abishira hejuru;</para>
  <para style="q2" vid="PRO 16:5">ni ukuri ntibazobura guhanwa.<verse eid="PRO 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Ahari urukundo n’ubwizigirwa, icaha kiraharirwa.</para>
  <para style="q2" vid="PRO 16:6">Ariko iyo hari ukwubaha <char style="nd">Uhoraho</char>, abantu birinda ikibi.<verse eid="PRO 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Iyo <char style="nd">Uhoraho</char> anezererewe inzira z’umuntu,</para>
  <para style="q2" vid="PRO 16:7">amuha no kubana neza n’abansi biwe.<verse eid="PRO 16:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Kugira bike biciye mu bugororotsi</para>
  <para style="q2" vid="PRO 16:8">biruta kugira ubutunzi buciye mu karenganyo.<verse eid="PRO 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Umuntu aragira imigabo mu mutima wiwe,</para>
  <para style="q2" vid="PRO 16:9">ariko <char style="nd">Uhoraho</char> ni we ashiraho intambuko ziwe.<verse eid="PRO 16:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Akanwa k’umwami kavugana ububasha;</para>
  <para style="q2" vid="PRO 16:10">ni co gituma adakwiye kugira uwo arenganya.<verse eid="PRO 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Iminzane itaziritse iva k’<char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PRO 16:11">amabuye y’umunzane yose ni we ayakora.<verse eid="PRO 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />Umwami yanka uwukora ibibi,</para>
  <para style="q2" vid="PRO 16:12">kuko inganji yiwe yubakirwa ku kugororoka.<verse eid="PRO 16:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Abami banezerererwa iminwa ivuga ukuri;</para>
  <para style="q2" vid="PRO 16:13">baha agaciro umuntu atabesha.<verse eid="PRO 16:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Uburake bw’umwami ni intumwa y’urupfu,</para>
  <para style="q2" vid="PRO 16:14">ariko umunyabwenge arabuhwamika.<verse eid="PRO 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Mu maso h’umwami hakeye, hazana ubuzima;</para>
  <para style="q2" vid="PRO 16:15">ubuntu bwiwe bumera nk’igicu co ku mutasuro.<verse eid="PRO 16:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />Guhitamwo ubwenge biruta guhitamwo inzahabu,</para>
  <para style="q2" vid="PRO 16:16">kandi guhitamwo ugutahura kuruta ifeza.<verse eid="PRO 16:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Inzira z’umugororotsi zizira ikibi,</para>
  <para style="q2" vid="PRO 16:17">kandi uwurinda inzira ziwe arinda ubuzima bwiwe.<verse eid="PRO 16:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Ubwibone buherekezwa n’ukurandurwa,</para>
  <para style="q2" vid="PRO 16:18">ukwishira hejuru na kwo kuza imbere yo kugwa.<verse eid="PRO 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Guca bugufi ukabana n’abakene</para>
  <para style="q2" vid="PRO 16:19">biruta gusangira iminyago n’abishira hejuru.<verse eid="PRO 16:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />Uwumvira impanuro aratunganirwa,</para>
  <para style="q2" vid="PRO 16:20">kandi hahiriwe uwushira ivyizigiro vyiwe k’<char style="nd">Uhoraho</char>.<verse eid="PRO 16:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Uwufise umutima w’ugutahura yitwa umunyabwenge,</para>
  <para style="q2" vid="PRO 16:21">kandi amajambo yongereza ukwigishwa.<verse eid="PRO 16:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Ugutahura ni isoko y’ubuzima ku bagufise,</para>
  <para style="q2" vid="PRO 16:22">ariko ubujuju buzanira igihano ibipfu.<verse eid="PRO 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Umutima w’umunyabwenge ni wo umuzigamira akanwa,</para>
  <para style="q2" vid="PRO 16:23">kandi iminwa yiwe yongereza ukwigisha.<verse eid="PRO 16:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Amajambo meza ameze nk’ikimamara c’ubuki,</para>
  <para style="q2" vid="PRO 16:24">aryohera umutima, akavura amagufa.<verse eid="PRO 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />Hari inzira umuntu yibwira ko ari nziza,</para>
  <para style="q2" vid="PRO 16:25">ariko impera yayo ikamushikana mu rupfu.<verse eid="PRO 16:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Ni vyiza ko uwukora agira akayabagu;</para>
  <para style="q2" vid="PRO 16:26">kuko inzara ni yo imutuma gukora.<verse eid="PRO 16:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Imburakimazi yigira inama yo gukora ikibi,</para>
  <para style="q2" vid="PRO 16:27">kandi amajambo yiwe ameze nk’umuriro utongora.<verse eid="PRO 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Umuntu yapfapfanye atera imivurungano,</para>
  <para style="q2" vid="PRO 16:28">kandi umunyarusaku atandukanya abagenzi pfampfe.<verse eid="PRO 16:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Abanyamiryano bazimiza ababanyi babo,</para>
  <para style="q2" vid="PRO 16:29">bakabacisha mu nzira mbi.<verse eid="PRO 16:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Uwuvuna akagohe aba ategura icago;</para>
  <para style="q2" vid="PRO 16:30">kandi uwukurikira akanwa kiwe agwa mu kibi.<verse eid="PRO 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />Imvi ni urugori rw’ubwiza;</para>
  <para style="q2" vid="PRO 16:31">kironkwa n’abagendera mu bugororotsi.<verse eid="PRO 16:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />Uwitonda aruta intwari ku rugamba,</para>
  <para style="q2" vid="PRO 16:32">kandi uwuganza ishavu ryiwe aruta uwigarurira igisagara.<verse eid="PRO 16:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />Abantu bakora ubupfindo ngo bamenye ivya kazoza</para>
  <para style="q2" vid="PRO 16:33">ariko <char style="nd">Uhoraho</char>, ni we agena ikivamwo.<verse eid="PRO 16:33" /></para>
  <para style="b" />
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />Umukate wumye uririwe mu mahoro</para>
  <para style="q2" vid="PRO 17:1">uruta imisi mikuru ibera mu nzu z’umuryano.<verse eid="PRO 17:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Umukozi w’ubwenge azoganza umuhungu ari igito wa shebuja,</para>
  <para style="q2" vid="PRO 17:2">kandi azotorana hagati mu bana ba shebuja.<verse eid="PRO 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />Ifeza n’inzahabu bitunganywa n’umuriro,</para>
  <para style="q2" vid="PRO 17:3">ariko imitima isuzumwa n’<char style="nd">Uhoraho</char>.<verse eid="PRO 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Ababi bararyoherwa no kwumviriza iminwa yararaza abandi;</para>
  <para style="q2" vid="PRO 17:4">kandi umubeshi atega amatwi ururimi ruteranya.<verse eid="PRO 17:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Uwugaya umworo aba akengereye Uwamuremye;</para>
  <para style="q2" vid="PRO 17:5">kandi unezerezwa n’ivyago vya mugenziwe ntazobura kubihanirwa.<verse eid="PRO 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Abuzukuru ni urugori rw’umusaza,</para>
  <para style="q2" vid="PRO 17:6">kandi abavyeyi ni vyo vyirato vy’abana.<verse eid="PRO 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Ukuba imvuzi ntibibereye igipfu;</para>
  <para style="q2" vid="PRO 17:7">ariko ikirushirije, akanwa kavuga</para>
  <para style="q2" vid="PRO 17:7">ibinyoma ntikabereye umurongozi.<verse eid="PRO 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Igiturire kimeze nk’igiheko kizana imigisha ku wugitanga;</para>
  <para style="q2" vid="PRO 17:8">yumva ko azogira amahirwe mu vyo azojamwo vyose.<verse eid="PRO 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Uwugomba gukomeza urukundo yirengagiza icaha yakorewe,</para>
  <para style="q2" vid="PRO 17:9">ariko uwuguma yibukiriza icaha atandukanya abagenzi.<verse eid="PRO 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Ugukankamira umunyabwenge bimushika ku mutima</para>
  <para style="q2" vid="PRO 17:10">kurusha inkoni ijana zikubiswe ku mugongo w’igipfu.<verse eid="PRO 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Abanyakibi bavyura umugararizo ku Mana,</para>
  <para style="q2" vid="PRO 17:11">ariko bazotumwako intumwa y’urupfu.<verse eid="PRO 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Hako uhura n’igipfu kiri mu bupfu bwaco</para>
  <para style="q2" vid="PRO 17:12">wopfuma uhura n’idubu bivye ivyana vyaryo.<verse eid="PRO 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Uwishura inabi ineza,</para>
  <para style="q2" vid="PRO 17:13">ikibi nticigera kiva mu nzu yiwe.<verse eid="PRO 17:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Uwutangura gutongana ameze nk’uwugomorora urugomero runini;</para>
  <para style="q2" vid="PRO 17:14">none rero va mu bihari gutongana bitaratangura.<verse eid="PRO 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Kweza umunyakibi no gutuma umugororotsi atsindwa,</para>
  <para style="q2" vid="PRO 17:15">
    <char style="nd">Uhoraho</char> avyanka vyompi.<verse eid="PRO 17:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Mbega amahera mu minwe y’igipfu yokimarira iki,</para>
  <para style="q2" vid="PRO 17:16">kandi kitipfuza kugira ubwenge?<verse eid="PRO 17:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Umugenzi agukunda ibihe vyose,</para>
  <para style="q2" vid="PRO 17:17">kandi umuvukanyi yavukiye guseruka mu marushwa.<verse eid="PRO 17:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Umunyabwengebuke arahirira kwishinga ideni ry’uwundi,</para>
  <para style="q2" vid="PRO 17:18">akiyemeza kuzomurihira.<verse eid="PRO 17:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Uwukunda gutongana akunda icaha,</para>
  <para style="q2" vid="PRO 17:19">kandi uwiyubakira inzitiro ndende yikwegera ivyago.<verse eid="PRO 17:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Igipfu co mu mutima ntikigubwa neza,</para>
  <para style="q2" vid="PRO 17:20">kandi umubeshi agwa mu makuba.<verse eid="PRO 17:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Kugira umwana w’igipfu bitera umubabaro,</para>
  <para style="q2" vid="PRO 17:21">kandi se w’igipfu nta munezero yigera agira.<verse eid="PRO 17:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Umutima unezerewe ni umuti mwiza,</para>
  <para style="q2" vid="PRO 17:22">ariko umutima ubabaye umara inkomezi mu mubiri.<verse eid="PRO 17:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Umunyakibi yakira igiturire</para>
  <para style="q2" vid="PRO 17:23">kugira ngo ace urwa ngondagonde.<verse eid="PRO 17:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Ubwenge bwama buri hafi y’umunyabwenge,</para>
  <para style="q2" vid="PRO 17:24">ariko igipfu kija kuburonderera ku mpera z’isi.<verse eid="PRO 17:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Igipfu gitera umubabaro se waco,</para>
  <para style="q2" vid="PRO 17:25">uwakivyaye kikamutera umururazi.<verse eid="PRO 17:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Si vyiza gucira igihano umugororotsi,</para>
  <para style="q2" vid="PRO 17:26">canke guhora umutware ubugorotsi bwiwe.<verse eid="PRO 17:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Uwuvuga make ni umunyabwenge,</para>
  <para style="q2" vid="PRO 17:27">kandi uwutekanye mu mutima afise ugutahura.<verse eid="PRO 17:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />N’igipfu iyo cinumiye ciyumvirwa ko ari umunyabwenge,</para>
  <para style="q2" vid="PRO 17:28">kandi iyo kigumije ururimi bavuga ko gifise ugutahura.<verse eid="PRO 17:28" /></para>
  <para style="b" />
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />Ingunge irondera ivyayo yonyene yitandukanya n’abandi,</para>
  <para style="q2" vid="PRO 18:1">kandi igwanya ivyiyumviro vyiza vyose.<verse eid="PRO 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Igipfu ntikinezerererwa ugutahura,</para>
  <para style="q2" vid="PRO 18:2">kinezerezwa n’ukugaragaza ivyiyumviro vyaco.<verse eid="PRO 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Iyo haje ubukozi bw’ikibi haba haje umugayo;</para>
  <para style="q2" vid="PRO 18:3">kandi ubushizi bw’isoni buzana igitutsi.<verse eid="PRO 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Amajambo y’ubwenge ameze nk’ibenga rirerire,</para>
  <para style="q2" vid="PRO 18:4">kandi ubwenge buva ku banyabwenge bumeze nk’uruzi rusuma.<verse eid="PRO 18:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Ntibibereye kweza umunyakibi,</para>
  <para style="q2" vid="PRO 18:5">canke kurenganya umugororotsi.<verse eid="PRO 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Iminwa y’igipfu yisuka mu mitongano,</para>
  <para style="q2" vid="PRO 18:6">kandi akanwa kiwe kamukwegera inkoni.<verse eid="PRO 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Akanwa k’igipfu ni ko kakirandura,</para>
  <para style="q2" vid="PRO 18:7">kandi iminwa yiwe ni yo mutego w’umushaha wiwe.<verse eid="PRO 18:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />Amajambo y’urusaku ameze nk’ivyokurya biryoshe,</para>
  <para style="q2" vid="PRO 18:8">aramanuka agashika i bwina mu mutima w’umuntu.<verse eid="PRO 18:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Umunebwe mu gikorwa</para>
  <para style="q2" vid="PRO 18:9">ni mwenewabo n’umuranduzi.<verse eid="PRO 18:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />Izina ry’<char style="nd">Uhoraho</char> ni umunara ukomeye;</para>
  <para style="q2" vid="PRO 18:10">abagororotsi barihungiramwo bakaba amahoro.<verse eid="PRO 18:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />Ubutunzi bw’umutunzi bumubera igisagara gikomeye;</para>
  <para style="q2" vid="PRO 18:11">yibaza ko ari igihome kiturirwa.<verse eid="PRO 18:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Ukwishira hejuru kw’umutima ni intango yo kugwa,</para>
  <para style="q2" vid="PRO 18:12">ariko ukwicisha bugufi ni intango y’icubahiro.<verse eid="PRO 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Gushoka wishura utabanje kwumviriza</para>
  <para style="q2" vid="PRO 18:13">ni ubupfu, biramaramaza.<verse eid="PRO 18:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Umutima w’umuntu ni wo umufasha kwihanganira ingwara;</para>
  <para style="q2" vid="PRO 18:14">ariko umutima ubabaye ni nde yowihanganira?<verse eid="PRO 18:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Umutima urondera ugutahura wironkera ubumenyi,</para>
  <para style="q2" vid="PRO 18:15">kandi ugutwi kw’umunyabwenge ni co kurondera.<verse eid="PRO 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Ugutanga bicira inzira uwutanga,</para>
  <para style="q2" vid="PRO 18:16">bikamushikana imbere y’abahambaye.<verse eid="PRO 18:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Uwitwaye ubwa mbere asa nk’aho ari we ari mu kuri,</para>
  <para style="q2" vid="PRO 18:17">gushika uwumuhinyuza ashitse.<verse eid="PRO 18:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Ubupfindo bumara impari,</para>
  <para style="q2" vid="PRO 18:18">bugatatura ibihangange bihanganye.<verse eid="PRO 18:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Umuvukanyi yacumuweko aragoye gushikira kurusha gufata igisagara kizitiye,</para>
  <para style="q2" vid="PRO 18:19">impari zitandukanya abagenzi ni nk’ibihindizo vyo ku kirimba.<verse eid="PRO 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Amajambo y’ubwenge ahaza kurya kw’imfungurwa ziryoshe,</para>
  <para style="q2" vid="PRO 18:20">kandi amajambo avuzwe mu gihe ciza ashika ku nyota.<verse eid="PRO 18:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Ururimi rufise ububasha bwo kwica no gukiza,</para>
  <para style="q2" vid="PRO 18:21">kandi abakunda kuvuga bazorya ivyamwa vyarwo.<verse eid="PRO 18:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Uwuronse umugore aba aronse itunga ryiza,</para>
  <para style="q2" vid="PRO 18:22">kandi agirirwa ubuntu n’<char style="nd">Uhoraho</char>.<verse eid="PRO 18:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Umukene avuga yinginga,</para>
  <para style="q2" vid="PRO 18:23">ariko umukire yishurana amanyama.<verse eid="PRO 18:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Uwufise abagenzi benshi bashobora kumusenyura,</para>
  <para style="q2" vid="PRO 18:24">ariko umugenzi w’ukuri akuba hafi gusumvya uwo muvukana.<verse eid="PRO 18:24" /></para>
  <para style="b" />
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />Wopfuma uba umukene uri inyankamugayo</para>
  <para style="q2" vid="PRO 19:1">hako uba igipfu akanwa kaco kuzuye amajambo y’ibinyoma.<verse eid="PRO 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Si vyiza kugira ishaka ritarimwo ubwenge,</para>
  <para style="q2" vid="PRO 19:2">canke kwihuta hanyuma umuntu agahusha inzira.<verse eid="PRO 19:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />Ubupfu bw’umuntu ni bwo bwonona ubuzima bwiwe,</para>
  <para style="q2" vid="PRO 19:3">ariko umutima wiwe ukarakarira <char style="nd">Uhoraho</char>.<verse eid="PRO 19:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Ubutunzi bukwega abagenzi benshi,</para>
  <para style="q2" vid="PRO 19:4">ubukene bugatuma abagenzi benshi bahunga.<verse eid="PRO 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Icabona c’ibinyoma ntikizobura guhanwa,</para>
  <para style="q2" vid="PRO 19:5">kandi uwuvuga ibinyoma ntazogenda atabihaniwe.<verse eid="PRO 19:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Abantu benshi barondera kugirirwa ubuntu n’umutware,</para>
  <para style="q2" vid="PRO 19:6">kandi umuntu wese yipfuza kuba umugenzi w’uwutanga ingabire.<verse eid="PRO 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Ko umukene akengerwa n’abiwe,</para>
  <para style="q2" vid="PRO 19:7">mbega abagenzi biwe bobo ntibazorushiriza kumwigira kure?</para>
  <para style="q1" vid="PRO 19:7">Naho umukene abarondera abinginga,</para>
  <para style="q2" vid="PRO 19:7">nta na hamwe ababona.<verse eid="PRO 19:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Uwiga ubwenge aba akunda ubugingo bwiwe,</para>
  <para style="q2" vid="PRO 19:8">kandi uwukunda ugutahura azororanirwa.<verse eid="PRO 19:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Icabona c’ibinyoma ntikizobura guhanwa,</para>
  <para style="q2" vid="PRO 19:9">kandi uwuvuga ibinyoma azorandurwa.<verse eid="PRO 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />Igipfu ntigikwiye kuba mu bikayangana,</para>
  <para style="q2" vid="PRO 19:10">nk’uko umugurano adakwiye kuganza abaganwa.<verse eid="PRO 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Ubwenge bw’umuntu ni bwo bumutera kutihutira kuraka,</para>
  <para style="q2" vid="PRO 19:11">kandi kwirengagiza inabi yagiriwe bimuhesha icubahiro.<verse eid="PRO 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Uburake bw’umwami bumeze nk’ugutontoma kw’intare,</para>
  <para style="q2" vid="PRO 19:12">ariko ubuntu bwiwe bumeze nk’ikime ku vyatsi.<verse eid="PRO 19:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Umwana w’igipfu ni icago kuri se,</para>
  <para style="q2" vid="PRO 19:13">kandi umugore atongana ameze nk’amama atonyanga y’inzu iva.<verse eid="PRO 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />Amazu n’amatungo umuntu abiragwa n’abavyeyi,</para>
  <para style="q2" vid="PRO 19:14">ariko umugore w’ubwenge atangwa n’<char style="nd">Uhoraho</char>.<verse eid="PRO 19:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Ubute bukwega itiro ryinshi,</para>
  <para style="q2" vid="PRO 19:15">kandi umunebwe yicwa n’inzara.<verse eid="PRO 19:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Uwumvira impanuro azigama ubuzima bwiwe,</para>
  <para style="q2" vid="PRO 19:16">ariko uwuzigaya aja mu rupfu.<verse eid="PRO 19:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Uwufashije umukene aba aguranye <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PRO 19:17">kandi azomusubiza ivyo yatanze.<verse eid="PRO 19:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Uzotoze indero umwana wawe akiri muto, kuko harimwo ivyizigiro</para>
  <para style="q2" vid="PRO 19:18">ariko ntuzomuhanire kumwica.<verse eid="PRO 19:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Uwihutira kugira ishavu azobihanirwa,</para>
  <para style="q2" vid="PRO 19:19">kandi iyo utamuhanye, uba umuteye kubikora kenshi.<verse eid="PRO 19:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Wumvirize impanuro kandi wemere kwigishwa,</para>
  <para style="q2" vid="PRO 19:20">ni ho uzoba umunyabwenge.<verse eid="PRO 19:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />Umutima w’umuntu ugira imigambi myinshi,</para>
  <para style="q2" vid="PRO 19:21">ariko integuro z’<char style="nd">Uhoraho</char> ni zo zirama.<verse eid="PRO 19:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Ubwizigirwa bw’umuntu ni bwo bumutera gukundwa;</para>
  <para style="q2" vid="PRO 19:22">none rero wopfuma uba umukene hako uba umubeshi.<verse eid="PRO 19:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />Ukwubaha <char style="nd">Uhoraho</char> bishikana mu bugingo:</para>
  <para style="q2" vid="PRO 19:23">uwumwubashe agubwa neza, nta kibi kimuzako.<verse eid="PRO 19:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Umunebwe atwara ukuboko mw’isahani,</para>
  <para style="q2" vid="PRO 19:24">ariko akananirwa no kukugarukana ku munwa.<verse eid="PRO 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Niwakubita umucokoranyi, ibijuju bizomenya kwitonda,</para>
  <para style="q2" vid="PRO 19:25">kandi niwakankamira umunyabwenge azokwongereza ubumenyi.<verse eid="PRO 19:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Umwana asesagura ivya se, akirukana nyina,</para>
  <para style="q2" vid="PRO 19:26">yikwegera isoni n’ibimaramare.<verse eid="PRO 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Mwana wanje, niwaheba kwigishwa,</para>
  <para style="q2" vid="PRO 19:27">uzoba uteye umugongo ubumenyi.<verse eid="PRO 19:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />Icabona iyo kiriye igiturire gituma ubutungane butituka,</para>
  <para style="q2" vid="PRO 19:28">kandi akanwa k’umunyakibi kayongobeza ikibi.<verse eid="PRO 19:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Ibihano biraririye abacokoranyi,</para>
  <para style="q2" vid="PRO 19:29">n’inkoni ziraririye umugongo w’ibipfu.<verse eid="PRO 19:29" /></para>
  <para style="b" />
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />Umuvinyu uzana ugucokorana, inzoga zigatera uruyogoyogo;</para>
  <para style="q2" vid="PRO 20:1">uwo bihubisha inzira ntagira ubwenge.<verse eid="PRO 20:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Uburake bw’umwami ni nk’ugutontoma kw’intare;</para>
  <para style="q2" vid="PRO 20:2">uwumushavuza aba akwegeye ubuzima bwiwe.<verse eid="PRO 20:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />Uwirinda ibihari aba yihesheje icubahiro,</para>
  <para style="q2" vid="PRO 20:3">ariko igipfu cihutira gutongana.<verse eid="PRO 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Umunebwe wa cane abuzwa n’imbeho kurima,</para>
  <para style="q2" vid="PRO 20:4">ariko iyimbura rigeze, azosega abure.<verse eid="PRO 20:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />Imigambi yo mu mutima w’umuntu ni nk’amazi yo mw’iriba;</para>
  <para style="q2" vid="PRO 20:5">umutima ufise ugutahura ni wo uyiroba.<verse eid="PRO 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Abenshi bavuga ko ari abakunzi b’ukuri,</para>
  <para style="q2" vid="PRO 20:6">ariko umwizigirwa w’ukuri umuntu yomukura he?<verse eid="PRO 20:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Uwubaha Imana agendera mu bwizigirwa;</para>
  <para style="q2" vid="PRO 20:7">hahiriwe abana bazomukomokako.<verse eid="PRO 20:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Iyo umwami yicaye ku ntebe y’imanza,</para>
  <para style="q2" vid="PRO 20:8">agosoza ijisho ryiwe ikibi n’iciza.<verse eid="PRO 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />Ni nde yovuga ati: “Narejeje umutima wanje,</para>
  <para style="q2" vid="PRO 20:9">narawutyoroye, nta caha mfise?”<verse eid="PRO 20:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Iminzane idakwiye n’ingero zidakwiye,</para>
  <para style="q2" vid="PRO 20:10">
    <char style="nd">Uhoraho</char> abizinukwa vyompi.<verse eid="PRO 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />Mbere n’umwana amenyekanira ku vyo akora,</para>
  <para style="q2" vid="PRO 20:11">bikerekana ko azoba uwutunganye, agororotse.<verse eid="PRO 20:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Amatwi yumva n’amaso abona,</para>
  <para style="q2" vid="PRO 20:12">vyompi ni <char style="nd">Uhoraho</char> yabiremye.<verse eid="PRO 20:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Ntugakunde agatiro, ahandi ho uzoba umukene;</para>
  <para style="q2" vid="PRO 20:13">wame maso, ni ho uzogira indya mu kigega.<verse eid="PRO 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />Umuguzi yama avuga ati: “Birazimvye, birazimvye”;</para>
  <para style="q2" vid="PRO 20:14">ariko yarengana akishima ko asumye neza.<verse eid="PRO 20:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />Hariho inzahabu n’amabuye y’agaciro menshi,</para>
  <para style="q2" vid="PRO 20:15">ariko iminwa ivuga ivy’ubwenge ifise agaciro kurusha ivyo vyose.<verse eid="PRO 20:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Twara impuzu y’uwishinze uwo atazi,</para>
  <para style="q2" vid="PRO 20:16">ufate ingwati y’uwishinze abahita.<verse eid="PRO 20:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Umukate wibwe urasosa,</para>
  <para style="q2" vid="PRO 20:17">ariko mu nyuma uhinduka nk’umusenyi mu kanwa.<verse eid="PRO 20:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />Uzosabe impanuro niwagira umugambi,</para>
  <para style="q2" vid="PRO 20:18">kandi niwaja mu ntambara ube ufise impanuro z’ubwenge.<verse eid="PRO 20:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Imvuzi igenda iramena ibanga;</para>
  <para style="q2" vid="PRO 20:19">uze wirinde kwifatanya n’uwitoraguza.<verse eid="PRO 20:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Uwuvuma se na nyina</para>
  <para style="q2" vid="PRO 20:20">itara ryiwe rizozimirizwa mu mwijima w’umuzitanya.<verse eid="PRO 20:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />Iragi umuntu aronse vuba na vuba</para>
  <para style="q2" vid="PRO 20:21">iherezo ryaryo ntiribamwo umugisha.<verse eid="PRO 20:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />Ntuzovuge uti: “Nzokwihora ikibi nagiriwe!”</para>
  <para style="q2" vid="PRO 20:22">Rorera <char style="nd">Uhoraho</char>, na we azoguhora.<verse eid="PRO 20:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />
    <char style="nd">Uhoraho</char> azinukwa iminzane iziritse,</para>
  <para style="q2" vid="PRO 20:23">kandi iminzane iziritse ni igisesema kuri we.<verse eid="PRO 20:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />Intambuko z’umuntu zirongorwa n’<char style="nd">Uhoraho</char>.</para>
  <para style="q2" vid="PRO 20:24">Mbega none umuntu yotahura inzira yiwe gute?<verse eid="PRO 20:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Kwihutira gusezeranira Imana bita mu mutego,</para>
  <para style="q2" vid="PRO 20:25">kuko amara kurahira hanyuma akicuza.<verse eid="PRO 20:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Umwami w’ubwenge asekura abanyakibi nk’uwusekura ingano,</para>
  <para style="q2" vid="PRO 20:26">akabagosoza urutaro.<verse eid="PRO 20:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />Itara ry’<char style="nd">Uhoraho</char> rimurika mu mutima w’umuntu,</para>
  <para style="q2" vid="PRO 20:27">rigasesa ivyinyegeje muri wo.<verse eid="PRO 20:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Urukundo n’ubwizigirwa ni vyo biha umwami kuba amahoro,</para>
  <para style="q2" vid="PRO 20:28">kandi mu rukundo ni ho inganji yiwe ikomerera.<verse eid="PRO 20:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Icubahiro c’umusore ni inkomezi ziwe,</para>
  <para style="q2" vid="PRO 20:29">imvi na zo ni ryo teka ry’umutama.<verse eid="PRO 20:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Ibikomere n’inguma bikuraho ikibi,</para>
  <para style="q2" vid="PRO 20:30">kandi gukubitwa bigorora ingeso.<verse eid="PRO 20:30" /></para>
  <para style="b" />
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />Umutima w’umwami ni nk’umugende mu minwe y’<char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PRO 21:1">awurongorera iyo ashatse.<verse eid="PRO 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Umuntu yama yibwira ko ingeso ziwe ari nziza,</para>
  <para style="q2" vid="PRO 21:2">ariko <char style="nd">Uhoraho</char> ni we asesa imitima.<verse eid="PRO 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />Gukora ibigororotse n’ibibereye</para>
  <para style="q2" vid="PRO 21:3">ni vyo vyemerwa n’<char style="nd">Uhoraho</char> gusumba ibimazi.<verse eid="PRO 21:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Amaso y’ubwishime n’umutima w’ubwibone ni vyo tara ry’abanyakibi,</para>
  <para style="q2" vid="PRO 21:4">kandi vyose ni ivyaha.<verse eid="PRO 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Imigambi y’umunyamwete imushikana ku nyungu,</para>
  <para style="q2" vid="PRO 21:5">nk’uko uwihutira guca mu nzira za hafi arangiriza mu bukene.<verse eid="PRO 21:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Ubutunzi umuntu aronkesheje akarimi kabesha</para>
  <para style="q2" vid="PRO 21:6">ni umwotsi utumuka, ni umutego wica.<verse eid="PRO 21:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Indyane z’abanyakibi zizobahitana,</para>
  <para style="q2" vid="PRO 21:7">kuko banka gukora ibitunganye.<verse eid="PRO 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Inzira z’abagirizwa ivyaha ziragoramanze,</para>
  <para style="q2" vid="PRO 21:8">ariko ingeso z’abagororotsi ziratunganye.<verse eid="PRO 21:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />Wopfuma wibana mu mfuruka y’igisenge c’inzu,</para>
  <para style="q2" vid="PRO 21:9">hako ubana mu nzu nziza n’umugore w’intonganya.<verse eid="PRO 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Umunyakibi yama yipfuza ikibi,</para>
  <para style="q2" vid="PRO 21:10">kandi ababanyi biwe nta mpuhwe abagirira.<verse eid="PRO 21:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Iyo umucokoranyi ahanywe, ibijuju bica bica ubwenge;</para>
  <para style="q2" vid="PRO 21:11">iyo umunyabwenge yigishijwe na ho, aronka ubumenyi.<verse eid="PRO 21:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Uwera yamiza ijisho ku nzu y’umunyakibi,</para>
  <para style="q2" vid="PRO 21:12">kandi ni na we amutera ivyago.<verse eid="PRO 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Umuntu niyica amatwi hari umukene amuririra,</para>
  <para style="q2" vid="PRO 21:13">hazogera igihe na we arire abure uwumwumva.<verse eid="PRO 21:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Ingabire yo mw’ibanga ihwamika uburake,</para>
  <para style="q2" vid="PRO 21:14">kandi ingabire ihishijwe mu mutamana ihwamika ishavu ryinshi.<verse eid="PRO 21:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Urubanza ruciwe neza ruzanira umunezero umugororotsi,</para>
  <para style="q2" vid="PRO 21:15">ariko inkozi y’ikibi ruyitera ubwoba.<verse eid="PRO 21:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Umuntu ajuragirika akava mu nzira ziroranye,</para>
  <para style="q2" vid="PRO 21:16">azoruhukira mw’ikoraniro ry’abapfuye.<verse eid="PRO 21:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Uwukunda kwinezereza azokena;</para>
  <para style="q2" vid="PRO 21:17">kandi uwukunda umuvinyu n’ibindi vy’agaciro ntazigera atunga.<verse eid="PRO 21:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Umunyavyaha ahanwa mu gishingo c’umugororotsi,</para>
  <para style="q2" vid="PRO 21:18">abahemu na bo bagahanwa mu gishingo c’intungane.<verse eid="PRO 21:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />Kwibera mu bugaragwa biruta kubana n’umugore atongana,</para>
  <para style="q2" vid="PRO 21:19">yuzuye imyidodombo.<verse eid="PRO 21:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />Mu nzu y’umunyabwenge habayo ubutunzi bw’agaciro n’amavuta ya elayo,</para>
  <para style="q2" vid="PRO 21:20">ariko igipfu cimarirako ivyo gifise.<verse eid="PRO 21:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Uwukurikirana kugororoka no kugira urukundo</para>
  <para style="q2" vid="PRO 21:21">aronka ubuzima, kugubwa neza n’icubahiro.<verse eid="PRO 21:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Umunyabwenge atera igisagara c’abanyenkomezi,</para>
  <para style="q2" vid="PRO 21:22">agasenyagura inzitiro bari bishimiye.<verse eid="PRO 21:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Uwurinda umunwa wiwe n’ururimi rwiwe</para>
  <para style="q2" vid="PRO 21:23">aba yirinze amakuba.<verse eid="PRO 21:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Uwibona akishira hejuru bamwita “Mucokoranyi”.</para>
  <para style="q2" vid="PRO 21:24">Agendana ubwirasi burimwo n’ubwibone.<verse eid="PRO 21:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Umunyabute yicwa no kwipfuza,</para>
  <para style="q2" vid="PRO 21:25">kuko ata co ahereza amaboko.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Hariho abamana ukwipfuza kuronka vyinshi,</para>
  <para style="q2" vid="PRO 21:26">ariko umugororotsi we atanga atisigariza.<verse eid="PRO 21:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Ikimazi c’umunyakibi ni igisesema,</para>
  <para style="q2" vid="PRO 21:27">na canecane iyo gishikanywe mu ntumbero mbi.<verse eid="PRO 21:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Icabona c’ibinyoma kizopfa,</para>
  <para style="q2" vid="PRO 21:28">kandi uwumutega amatwi wese azorandurwa ibihe vyose.<verse eid="PRO 21:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Umunyakibi yiraburanirwa mu maso,</para>
  <para style="q2" vid="PRO 21:29">umugororotsi ariyumvira imbere yo kugira ico akora.<verse eid="PRO 21:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />Nta bwenge, nta gutahura,</para>
  <para style="q2" vid="PRO 21:30">nta n’umugambi wo kugwanya <char style="nd">Uhoraho</char> worama.<verse eid="PRO 21:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Ifarasi itegurirwa umusi w’intambara,</para>
  <para style="q2" vid="PRO 21:31">ariko intsinzi ni iy’<char style="nd">Uhoraho</char>.<verse eid="PRO 21:31" /></para>
  <para style="b" />
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />Kuvugwa neza biruta kugira ubutunzi bwinshi,</para>
  <para style="q2" vid="PRO 22:1">kandi kwemerwa kurusha agaciro ifeza n’inzahabu.<verse eid="PRO 22:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Umukire n’umworo bafise ico basangiye:</para>
  <para style="q2" vid="PRO 22:2">
    <char style="nd">Uhoraho</char> ni we muremyi wabo bompi.<verse eid="PRO 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Umunyamakenga yama abona icago kitaramushikira akacikinga,</para>
  <para style="q2" vid="PRO 22:3">ariko igipfu gipfa kugenda,</para>
  <para style="q2" vid="PRO 22:3">hanyuma kikisanga mu kaga.<verse eid="PRO 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Ukwicisha bugufi n’ukwubaha <char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PRO 22:4">bizana ubutunzi n’ukuramba.<verse eid="PRO 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Inzira y’umunyakibi irimwo amahwa n’imitego,</para>
  <para style="q2" vid="PRO 22:5">ariko uwurinda umutima wiwe abica kure.<verse eid="PRO 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Umenyereze umwana guca mu nzira ibereye,</para>
  <para style="q2" vid="PRO 22:6">niyakura ntazoyivamwo.<verse eid="PRO 22:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Umutunzi ategeka umukene,</para>
  <para style="q2" vid="PRO 22:7">kandi uwusavye ingurane aba umuja w’uwumuguranye.<verse eid="PRO 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Uwubiba kugira nabi azimbura imibabaro,</para>
  <para style="q2" vid="PRO 22:8">kandi inkoni y’uburake bwiwe izovunagurwa.<verse eid="PRO 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Uwutanga arahezagirwa,</para>
  <para style="q2" vid="PRO 22:9">kuko asangira ivyiwe n’umukene.<verse eid="PRO 22:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Irukana umucokoranyi, maze abanyabihari bajane na we,</para>
  <para style="q2" vid="PRO 22:10">ni ho imivurungano no gutukana bizovaho.<verse eid="PRO 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Uwukunda kugira umutima utanduye akavugana imbabazi</para>
  <para style="q2" vid="PRO 22:11">abami bazoba abagenzi biwe.<verse eid="PRO 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />Inyonga z’<char style="nd">Uhoraho</char> zirinda abafise ubwenge,</para>
  <para style="q2" vid="PRO 22:12">ariko imigambi y’abanyakibi arayisibanganya.<verse eid="PRO 22:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Umunyabute avuga ati: “Hari intare hanze,</para>
  <para style="q2" vid="PRO 22:13">ninasohoka iranyica!”<verse eid="PRO 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Akanwa k’umugore asambana ni icobo kirekire,</para>
  <para style="q2" vid="PRO 22:14">abashavuza <char style="nd">Uhoraho</char> bazokigwamwo.<verse eid="PRO 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Ubupfu bwuzuye mu mutima w’umwana,</para>
  <para style="q2" vid="PRO 22:15">ariko inkoni yo guhana izobumukuramwo.<verse eid="PRO 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Uwucinyiza umukene kugira ngo agwize ubutunzi bwiwe,</para>
  <para style="q2" vid="PRO 22:16">hamwe n’uwuha ingabire umutunzi bompi bazogwa mu bukene.<verse eid="PRO 22:16" /></para>
  <para style="ms1">Imigani mirongo itatu y’ubwenge</para>
  <para style="s2">Umugani wa 1</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />Tega amatwi wumve amajambo y’umunyabwenge;</para>
  <para style="q2" vid="PRO 22:17">ushire umutima ku vyo ndakwigisha.<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />Kuko ari vyiza kuzigama iyi migani mu mutima wawe,</para>
  <para style="q2" vid="PRO 22:18">kandi wame uyifise mu kanwa kawe.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Ndakwigishije uwu musi, koko ndakwigishije,</para>
  <para style="q2" vid="PRO 22:19">kugira ngo ushire ivyizigiro vyawe k’<char style="nd">Uhoraho</char>.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Nakwandikiye imigani mirongo itatu,</para>
  <para style="q2" vid="PRO 22:20">imigani yuzuye impanuro n’ubwenge;<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />ni ho uzomenya amajambo y’ukuri,</para>
  <para style="q2" vid="PRO 22:21">maze usubirane inyuma ayo majambo</para>
  <para style="q2" vid="PRO 22:21">ku bakurungitse.<verse eid="PRO 22:21" /></para>
  <para style="s2">Umugani wa 2</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Ntukanyage umukene kuko ari umukene,</para>
  <para style="q2" vid="PRO 22:22">kandi ntukarenganye umworo mu rubanza.<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />Kuko <char style="nd">Uhoraho</char> azobaburanira,</para>
  <para style="q2" vid="PRO 22:23">anyage ababanyaze.<verse eid="PRO 22:23" /></para>
  <para style="s2">Umugani wa 3</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Ntukagiriranire ubugenzi n’umuntu yihuta kuraka,</para>
  <para style="q2" vid="PRO 22:24">kandi ntukifatanye n’uwurakishwa n’ubusa,<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />ahandi ho wohava umera nka bo,</para>
  <para style="q2" vid="PRO 22:25">ubuzima bwawe ukabuta mu mutego.<verse eid="PRO 22:25" /></para>
  <para style="s2">Umugani wa 4</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Ntukishinge uwundi mu myenda yiwe</para>
  <para style="q2" vid="PRO 22:26">canke ngo wiyemeze ko uzomwishurira,<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />kuko nutashobora kuriha</para>
  <para style="q2" vid="PRO 22:27">n’uburiri uryamako bazobugukurako.<verse eid="PRO 22:27" /></para>
  <para style="s2">Umugani wa 5</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Ntuzokwunguruze akarimbi</para>
  <para style="q2" vid="PRO 22:28">kashinzwe na ba sogokuruza.<verse eid="PRO 22:28" /></para>
  <para style="s2">Umugani wa 6</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />Hari abantu b’abanyamwete mu vyo bakora urabona?</para>
  <para style="q2" vid="PRO 22:29">Abo bazokorera imbere y’abami</para>
  <para style="q2" vid="PRO 22:29">ntibazokorera abasanzwe.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s2">Umugani wa 7</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Niwasangira n’umutware,</para>
  <para style="q2" vid="PRO 23:1">uzoshire umutima ku bishizwe imbere yawe.<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />Niwaba wari usanzwe urya cane,</para>
  <para style="q2" vid="PRO 23:2">ugerageze ugabanye.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Ntukipfuze ivyokurya vyiwe biryoshe,</para>
  <para style="q2" vid="PRO 23:3">kuko ivyo vyokurya birahenda.<verse eid="PRO 23:3" /></para>
  <para style="s2">Umugani wa 8</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Ntukarushwe no kwiruka inyuma y’ubutunzi,</para>
  <para style="q2" vid="PRO 23:4">ariko ugire ubwenge bwo kwihangana.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />Ubutunzi uba ukibukubise ijisho</para>
  <para style="q2" vid="PRO 23:5">bukaba bwagurutse,</para>
  <para style="q2" vid="PRO 23:5">kuko bumera amababa bukaguruka nk’inkukuma.<verse eid="PRO 23:5" /></para>
  <para style="s2">Umugani wa 9</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Ntukarye ivyokurya vy’uwufise ijisho ribi,</para>
  <para style="q2" vid="PRO 23:6">canke ngo wipfuze ivyokurya biryoshe vyiwe;<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />aguma aharura igiciro cavyo,</para>
  <para style="q2" vid="PRO 23:7">aranakubwira ati: “Fungura, nunywe!”</para>
  <para style="q2" vid="PRO 23:7">Ariko ntibiba bivuye ku mutima.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Utwo watamiye uzotudahwa,</para>
  <para style="q2" vid="PRO 23:8">kandi amajambo yawe yo kumushimira azoba yapfuye ubusa.<verse eid="PRO 23:8" /></para>
  <para style="s2">Umugani wa 10</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Ntukaganirize igipfu,</para>
  <para style="q2" vid="PRO 23:9">kuko kizogaya ubwenge buri mu majambo yawe.<verse eid="PRO 23:9" /></para>
  <para style="s2">Umugani wa 11</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Ntukunguruze akarimbi</para>
  <para style="q2" vid="PRO 23:10">kandi ntukarenganye impfuvyi,<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />kuko Umucunguzi wabo ari uwuhambaye;</para>
  <para style="q2" vid="PRO 23:11">ni we ubwiwe azobaburanira.<verse eid="PRO 23:11" /></para>
  <para style="s2">Umugani wa 12</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Ushire umutima wawe ku kwigishwa,</para>
  <para style="q2" vid="PRO 23:12">wongere utege amatwi amajambo y’ubumenyi.<verse eid="PRO 23:12" /></para>
  <para style="s2">Umugani wa 13</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Ntubure guhana umwana wawe;</para>
  <para style="q2" vid="PRO 23:13">niwamukubita inkoni ntazopfa.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Umuhanishe inkoni,</para>
  <para style="q2" vid="PRO 23:14">uzoba umurinze ubupfu bw’umushaha.<verse eid="PRO 23:14" /></para>
  <para style="s2">Umugani wa 14</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />Mwana wanje, niwagira ubwenge bwo mu mutima,</para>
  <para style="q2" vid="PRO 23:15">umutima wanje uzohimbarwa.<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />Ibingize vyose bizonezerwa</para>
  <para style="q2" vid="PRO 23:16">akanwa kawe nikavuga ibituganye.<verse eid="PRO 23:16" /></para>
  <para style="s2">Umugani wa 15</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Ntuze wemerere umutima wawe kwipfuza ivy’abanyavyaha,</para>
  <para style="q2" vid="PRO 23:17">ariko wame uhahamiye kwubaha <char style="nd">Uhoraho</char>.<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />Ni ho uzogira ivyizigiro vya kazoza,</para>
  <para style="q2" vid="PRO 23:18">kandi ivyo vyizigiro ntibitetereza.<verse eid="PRO 23:18" /></para>
  <para style="s2">Umugani wa 16</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Ntega amatwi Mwana wanje, kandi ugire ubwenge,</para>
  <para style="q2" vid="PRO 23:19">uzigamire umutima wawe mu nzira igororotse.<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Ntukifatanye n’imborerwa,</para>
  <para style="q2" vid="PRO 23:20">canke ngo usangire n’abakunzi b’inda,<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />kuko bariko baja mu bukene,</para>
  <para style="q2" vid="PRO 23:21">kandi itiro ryinshi rizobambika imishambara.<verse eid="PRO 23:21" /></para>
  <para style="s2">Umugani wa 17</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Umvira so wawe, we yakuvyaye,</para>
  <para style="q2" vid="PRO 23:22">kandi ntugaye nyoko mu myaka yiwe y’ubusaza.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Wigurire ukuri, kandi ntuzokugurishe.</para>
  <para style="q2" vid="PRO 23:23">Uronke ubwenge, indero nziza hamwe n’ugutahura.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Se w’intungane agira umunezero mwinshi,</para>
  <para style="q2" vid="PRO 23:24">kandi uwufise umwana w’umunyabwenge aramuhimbarirwa.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />None rero uzohimbare so na nyoko!</para>
  <para style="q2" vid="PRO 23:25">Nyoko yakuvyaye umutere umunezero.<verse eid="PRO 23:25" /></para>
  <para style="s2">Umugani wa 18</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Mwana wanje, numpe umutima wawe,</para>
  <para style="q2" vid="PRO 23:26">kandi amaso yawe uyagumize ku nzira zanje.<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />Kuko umusambanyikazi ni icobo kirekire,</para>
  <para style="q2" vid="PRO 23:27">kandi umugore w’icigenze ni ikinogo caga.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />Yibundira abantu nk’umwambuzi,</para>
  <para style="q2" vid="PRO 23:28">agatuma abagabo b’ibihemu bagwira.<verse eid="PRO 23:28" /></para>
  <para style="s2">Umugani wa 19</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />Ni nde abonye ibara?</para>
  <para style="q2" vid="PRO 23:29">Ni nde afise umubabaro?</para>
  <para style="q1" vid="PRO 23:29">Ni nde afise amahane?</para>
  <para style="q2" vid="PRO 23:29">Ni nde afise imyidogo?</para>
  <para style="q1" vid="PRO 23:29">Ni nde afise inguma zatari zikenewe?</para>
  <para style="q2" vid="PRO 23:29">Ni nde afise ijisho ritukurije?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />Ni abama mu bunywero,</para>
  <para style="q2" vid="PRO 23:30">bama bahonja ku nzoga nshasha.<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Ntukihweze inzoga itukurije,</para>
  <para style="q2" vid="PRO 23:31">ibiragira mu kirahuri,</para>
  <para style="q2" vid="PRO 23:31">ikimiminura!<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Amaherezo yayo ikomorana nk’inzoka,</para>
  <para style="q2" vid="PRO 23:32">ubumara bwayo ni nk’ubw’inkoma.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Amaso yawe azoraba ntabibone neza,</para>
  <para style="q2" vid="PRO 23:33">n’ubwenge bwawe buziyumvira ibitaroranye.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Uzomera nk’uwuryamye hagati mu kiyaga,</para>
  <para style="q2" vid="PRO 23:34">canke uwuryamye ku mutwe w’inyuma w’ubwato.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />Uzovuga uti: “Bankubise ariko sinababaye.</para>
  <para style="q2" vid="PRO 23:35">Bampotaguye ariko nta na kimwe numva.</para>
  <para style="q1" vid="PRO 23:35">Mbega nza kuvyuka ryari</para>
  <para style="q2" vid="PRO 23:35">ngo nsubire nsome rimwe?”<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s2">Umugani wa 20</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Ntukipfuze kuba nk’ababi,</para>
  <para style="q2" vid="PRO 24:1">ntukipfuze kuba mu mugwi wabo,<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />kuko imitima yabo yiyumvira kugira nabi,</para>
  <para style="q2" vid="PRO 24:2">kandi iminwa yabo ivuga ivyo gutera imivurungano.<verse eid="PRO 24:2" /></para>
  <para style="s2">Umugani wa 21</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />Ubwenge ni bwo butuma inzu yubakwa,</para>
  <para style="q2" vid="PRO 24:3">kandi ugutahura ni kwo kuyikomeza.<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />Ugutahura ni kwo gutuma ivyumba vyayo</para>
  <para style="q2" vid="PRO 24:4">vyuzura ubutunzi bwiza bw’igiciro.<verse eid="PRO 24:4" /></para>
  <para style="s2">Umugani wa 22</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />Umunyabwenge agira ubushobozi bwinshi,</para>
  <para style="q2" vid="PRO 24:5">kandi uwutahura agwiza inkomezi.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />None rero ntuzoje mu ntambara utabanje kugirwa inama z’ubwenge;</para>
  <para style="q2" vid="PRO 24:6">kuko intsinzi iva ku bajenama benshi.<verse eid="PRO 24:6" /></para>
  <para style="s2">Umugani wa 23</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Ubwenge buri aho igipfu kidahamvya;</para>
  <para style="q2" vid="PRO 24:7">iyo kiri mw’ikoraniro ku nama ntikironka ico kivuga.<verse eid="PRO 24:7" /></para>
  <para style="s2">Umugani wa 24</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Uwigira inama yo gukora ikibi</para>
  <para style="q2" vid="PRO 24:8">yitwa umugizi wa nabi.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Imigambi y’ubupfu ni icaha,</para>
  <para style="q2" vid="PRO 24:9">kandi umucokoranyi yankwa n’abantu.<verse eid="PRO 24:9" /></para>
  <para style="s2">Umugani wa 25</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Niwiyonjorora rukamvye,</para>
  <para style="q2" vid="PRO 24:10">uzoba wari ufise inkomezi nke.<verse eid="PRO 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Urokore abatwawe kwicwa kubera akarenganyo,</para>
  <para style="q2" vid="PRO 24:11">abajugumizwa n’uko bagira bicwe ntuzobirengagize.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Niwavuga uti: “Ariko ntitwabimenye,”</para>
  <para style="q2" vid="PRO 24:12">mbega uwusesa imitima ntazoba abibona?</para>
  <para style="q1" vid="PRO 24:12">Uwuzigama ubugingo bwawe arazi ko wari ubizi.</para>
  <para style="q2" vid="PRO 24:12">Ni we azoha impera umuntu wese,</para>
  <para style="q2" vid="PRO 24:12">ikwiranye n’ibikorwa yakoze.<verse eid="PRO 24:12" /></para>
  <para style="s2">Umugani wa 26</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Mwana wanje, uzoje urarya ubuki, kuko ni bwiza.</para>
  <para style="q2" vid="PRO 24:13">Ubuki buvuye mu kimamara burasosa ku rurimi.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Ariko kandi umenye ko ubwenge na bwo busosera umushaha.</para>
  <para style="q2" vid="PRO 24:14">Niwaburonka, uzogira ivyizigiro vya kazoza keza,</para>
  <para style="q2" vid="PRO 24:14">kandi ivyo vyizigiro ntibizogutetereza.<verse eid="PRO 24:14" /></para>
  <para style="s2">Umugani wa 27</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />Ntuzokwibunde inyuma y’inzu y’umugororotsi ugomba kumugirira nabi,</para>
  <para style="q2" vid="PRO 24:15">kandi ntugasahure ivy’aho aba.<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />Kuko umugororotsi naho yogwa incuro indwi azosubira ahaguruke.</para>
  <para style="q2" vid="PRO 24:16">Ariko abanyavyaha bazogwishwa n’amakuba.<verse eid="PRO 24:16" /></para>
  <para style="s2">Umugani wa 28</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Ntuze unezerwe umwansi wawe niyagwa,</para>
  <para style="q2" vid="PRO 24:17">kandi niyatsitara umutima wawe ntuze unezerwe.<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />Kuko vyohava bibabaza <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PRO 24:18">bigatuma amukurako uburake bwiwe.<verse eid="PRO 24:18" /></para>
  <para style="s2">Umugani wa 29</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Ntugashavurire inkozi y’ikibi,</para>
  <para style="q2" vid="PRO 24:19">kandi ntugashake kuba nk’umubi.<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />Kuko inkozi z’ibibi ntizigira ivyizigiro vya kazoza,</para>
  <para style="q2" vid="PRO 24:20">kandi itara ry’umubi rizozimwa.<verse eid="PRO 24:20" /></para>
  <para style="s2">Umugani wa 30</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />Mwana wanje, wubahe <char style="nd">Uhoraho</char>, wongere wubahe umwami,</para>
  <para style="q2" vid="PRO 24:21">kandi ntukifatanye n’abagarariji,<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />kuko abo bompi bazomuteza ivyago ningoga.</para>
  <para style="q2" vid="PRO 24:22">Kandi mbega ni nde yoshobora kumenya ivyago bazomuteza ingene bingana?<verse eid="PRO 24:22" /></para>
  <para style="ms1">Iyindi migani ya Bwenge</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />Iyi ni iyindi migani y’abanyabwenge:</para>
  <para style="q1" vid="PRO 24:23">Guhengama mu rubanza ni bibi:<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Umucamanza abwira umubi ati: “Urera,” azovumwa n’abantu,</para>
  <para style="q2" vid="PRO 24:24">kandi amahanga azomurakira.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Ariko uwuhana uwakoze icaha azoba agize neza,</para>
  <para style="q2" vid="PRO 24:25">kandi imigisha myinshi izomuzako.<verse eid="PRO 24:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Inyishu igororotse</para>
  <para style="q2" vid="PRO 24:26">imeze nk’ugusomana kw’abakundana.<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Banza uringanize neza ivyo hanze,</para>
  <para style="q2" vid="PRO 24:27">utegure imirima yawe,</para>
  <para style="q2" vid="PRO 24:27">hanyuma ubone kwubaka inzu yawe.<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Ntukaburanye umubanyi wawe ata mvo,</para>
  <para style="q2" vid="PRO 24:28">kandi ntukamubeshere.<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />Kandi Ntukavuge uti: “Reka ndamwishure ivyo yankoreye,</para>
  <para style="q2" vid="PRO 24:29">ndamusubirize mu nkoko ibihwanye n’ivyo yakoze.”<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Umusi umwe naciye mu murima w’umunebwe,</para>
  <para style="q2" vid="PRO 24:30">nca no mu ruzabibu rw’umuntu w’imburabwenge;<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />nsanga ahantu hose hameze amahwa,</para>
  <para style="q2" vid="PRO 24:31">urwiri rwameze hose,</para>
  <para style="q2" vid="PRO 24:31">inzitiro z’amabuye zarahenaguritse.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Maze niyumvira ku vyo mbonye,</para>
  <para style="q2" vid="PRO 24:32">na vyo bimpa icigwa:<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />Niwavuga uti: “Hinge nisinzirire gatoya, mpungure gakeya,</para>
  <para style="q2" vid="PRO 24:33">nigorore gatoya, mpfunye amaboko,”<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />ubukene buzoguhwikira nk’igisuma,</para>
  <para style="q2" vid="PRO 24:34">ubworo bugutere nk’umwambuzi.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="ms1">Iyindi migani ya Salomo</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Iyi ni iyindi migani ya Salomo, yegeranijwe n’umujenama w’umwami Hezekiya, umwami w’i Buyuda:<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Icubahiro c’Imana ni uguhisha ibintu,</para>
  <para style="q2" vid="PRO 25:2">ariko icubahiro c’abami ni ukubihishura.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Nk’uko ijuru riri hejuru cane, n’i kuzimu hakaba harehare,</para>
  <para style="q2" vid="PRO 25:3">ni ko umutima w’umwami ata wumenya ibiwurimwo.<verse eid="PRO 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Tyorora ifeza,</para>
  <para style="q2" vid="PRO 25:4">izohinduka igikoresho c’umucuzi.<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />Kura umubi imbere y’umwami,</para>
  <para style="q2" vid="PRO 25:5">inganji yiwe izokomezwa n’ubugororotsi.<verse eid="PRO 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />Ntukishire hejuru imbere y’umwami,</para>
  <para style="q2" vid="PRO 25:6">kandi ntugasabe icicaro mu bahambaye.<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />Ni vyiza kurindira bakakubwira bati:</para>
  <para style="q2" vid="PRO 25:7">“Shika hano imbere” aho kwirukanwa kure umaramara imbere y’abubahwa.</para>
  <para style="b" vid="PRO 25:7" />
  <para style="q1" vid="PRO 25:7">Ivyo ni vyo umaze kwibonera.<verse eid="PRO 25:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8" />Ntukihute kwitwarira umubanyi mu bucamanza,</para>
  <para style="q1" vid="PRO 25:8">kuko agutsinze womaramara,</para>
  <para style="q2" vid="PRO 25:8">ukabura uko ubigenza.<verse eid="PRO 25:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Nihagira ico mupfa n’umubanyi wawe,</para>
  <para style="q2" vid="PRO 25:9">ntuzobifatireko ngo umene ibanga uwundi muntu yakubwiye,<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />abandi bohava bavyumva bakakwagiriza urusaku,</para>
  <para style="q2" vid="PRO 25:10">ukaba wambaye iceyi utazikurako.<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Ijambo rivuzwe mu gihe caryo ni ryiza;</para>
  <para style="q2" vid="PRO 25:11">rimeze nk’icamwa c’inzahabu mu nkoko y’ifeza.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />Ku wufise ugutwi kwumva, impanuro y’umunyabwenge</para>
  <para style="q2" vid="PRO 25:12">imeze nk’ihereni ry’inzahabu,</para>
  <para style="q2" vid="PRO 25:12">canke urugori rw’inzahabu nziza.<verse eid="PRO 25:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />Nk’uko amazi akanye amerera isi mu bushuhe bwo mu ci,</para>
  <para style="q2" vid="PRO 25:13">ni ko intumwa y’umwizigirwa imerera uwayitumye.</para>
  <para style="q2" vid="PRO 25:13">Isubiza itoto umutima wa shebuja.<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Uwusezerana gutanga ingabire ariko ntashitse,</para>
  <para style="q2" vid="PRO 25:14">ameze nk’ibicu n’umuyaga bitazana imvura.<verse eid="PRO 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />Ukwihangana bigondoza umutware,</para>
  <para style="q2" vid="PRO 25:15">kandi ururimi rwiyoroheje rushobora kuvuna igufa.<verse eid="PRO 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />Niwaronka ubuki, uzorye ubugereranye,</para>
  <para style="q2" vid="PRO 25:16">kuko niwarya bwinshi cane uzobudahwa.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Ntukamize ikirenge mu rugo rw’umubanyi,</para>
  <para style="q2" vid="PRO 25:17">kugira ngo ntibazoguharuruke, bakakwanka.<verse eid="PRO 25:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Umuntu arementaniriza ibinyoma umubanyi wiwe</para>
  <para style="q2" vid="PRO 25:18">ameze nk’ishoka, inkota canke umwampi usongoye.<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Gushira ivyizigiro ku muhemu mu gihe c’ivyago,</para>
  <para style="q2" vid="PRO 25:19">ni nko guhekenyesha iryinyo ricitse,</para>
  <para style="q2" vid="PRO 25:19">canke kugendesha ukuguru kuvunitse.<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Uwuririmbira uwufise umutima ubabaye</para>
  <para style="q2" vid="PRO 25:20">ameze nk’uwiyambura impuzu mu gihe c’imbeho,</para>
  <para style="q2" vid="PRO 25:20">canke uwusuka inkarisha mu gikomere.<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Umwansi wawe niyasonza, uramugaburira;</para>
  <para style="q2" vid="PRO 25:21">niyanyoterwa umuhe ico kunywa.<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />Uzoba umusutse amakara yaka ku mutwe,</para>
  <para style="q2" vid="PRO 25:22">kandi <char style="nd">Uhoraho</char> azobiguhera impera.<verse eid="PRO 25:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Nk’uko umuyaga uturuka mu buraruko uzana imvura,</para>
  <para style="q2" vid="PRO 25:23">ni ko ururimi ruvuga urusaku rutera kwiraburanirwa.<verse eid="PRO 25:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />Wopfuma wibana mu mfuruka y’igisenge c’inzu,</para>
  <para style="q2" vid="PRO 25:24">hako ubana mu nzu nziza n’umugore w’intonganya.<verse eid="PRO 25:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Nk’uko amazi apfutse amerera umuntu anyotewe,</para>
  <para style="q2" vid="PRO 25:25">ni ko inkuru nziza ivuye kure imera.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Umugororotsi ahendwa n’umunyakibi akifatanya na we</para>
  <para style="q2" vid="PRO 25:26">aba ameze nk’iriba ritobwe canke ryuzuyemwo isuri.<verse eid="PRO 25:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Si vyiza kurya ubuki bwinshi</para>
  <para style="q2" vid="PRO 25:27">kandi si vyiza ko umunyacubahiro arondera ko bakimuha.<verse eid="PRO 25:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Umuntu adashobora kwirinda ishavu</para>
  <para style="q2" vid="PRO 25:28">ameze nk’igisagara gifise inzitiro zasenyutse.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />Nk’uko shelegi itabereye kugwa mu ci canke imvura mw’iyimbura,</para>
  <para style="q2" vid="PRO 26:1">ni ko icubahiro kidakwiye igipfu.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Nk’uko intamba iguruka kandi nk’uko inyamanza iguruka,</para>
  <para style="q2" vid="PRO 26:2">ni ko umuvumo uvumiwe ubusa umera.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />Nk’uko ikimoko kibereye ifarasi, n’umujiginya ukabera indogoba,</para>
  <para style="q2" vid="PRO 26:3">ni ko umugongo w’igipfu ubereye inkoni.<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Ntugasubize igipfu ibihwanye n’ubupfu bwaco,</para>
  <para style="q2" vid="PRO 26:4">ahandi ho uzoba ubaye nka co.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Ariko uze wishure igipfu ibigaragaza ubupfu bwaco,</para>
  <para style="q2" vid="PRO 26:5">kugira ngo nticigire umunyabwenge.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Kurungikana ubutumwa igipfu</para>
  <para style="q2" vid="PRO 26:6">ni nko kwica ukuguru canke kunywa uburozi.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Amajambo y’ubwenge mu kanwa k’igipfu,</para>
  <para style="q2" vid="PRO 26:7">ni nk’ukuguru kuvunitse gusigaye kurereta ata co kumaze.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Guha icubahiro igipfu</para>
  <para style="q2" vid="PRO 26:8">ni nko kubohera ibuye ku mugozi<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Umugani uciwe n’igipfu</para>
  <para style="q2" vid="PRO 26:9">umeze nk’ihwa rihanda mu kigaza c’imborerwa.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Uwuha akazi igipfu canke uwuhita wese</para>
  <para style="q2" vid="PRO 26:10">ameze nk’uwupfa kurasa mu bantu.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Nk’uko imbwa isubira ku vyo yadashwe,</para>
  <para style="q2" vid="PRO 26:11">ni ko igipfu gisubiramwo ubupfu bwaco.<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />Igipfu gifise amahirwe</para>
  <para style="q2" vid="PRO 26:12">kurusha uwibaza ko ari umunyabwenge kandi atari we.<verse eid="PRO 26:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />Umunyabute avuga ati: “Hari intare mu nzira,</para>
  <para style="q2" vid="PRO 26:13">intare y’inkazi iriko iratontoma mu nzira!”<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Nk’uko urugi rwizungurutsa ku mapata yarwo</para>
  <para style="q2" vid="PRO 26:14">ni ko umunebwe yihindukiza ku buriri bwiwe.<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />Umunebwe atwara ukuboko mw’isahani,</para>
  <para style="q2" vid="PRO 26:15">ariko akananirwa no kukugarukana ku munwa.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />Umunyabute yibwira ko ari umunyabwenge</para>
  <para style="q2" vid="PRO 26:16">kurusha abantu indwi bashobora kwishurana ubwenge.<verse eid="PRO 26:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />Umuntu ari ku nzira arengana akisuka mu bihari bitamwerekeye</para>
  <para style="q2" vid="PRO 26:17">ameze nk’umuntu afashe imbwa amatwi.<verse eid="PRO 26:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />Umuntu abesha mugenziwe,</para>
  <para style="q2" vid="PRO 26:18">agaca yivugira ati: “Nariko ndatebura,”<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />ameze nk’uwurasa ibishirira</para>
  <para style="q2" vid="PRO 26:19">canke imyampi yica mu bantu.<verse eid="PRO 26:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Nk’uko iyo inkwi ziheze, umuriro uzima,</para>
  <para style="q2" vid="PRO 26:20">ni ko n’iyo ata rusaku ruhari ibihari bihera.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />Nk’uko urubeya rufatisha amakara canke inkwi,</para>
  <para style="q2" vid="PRO 26:21">ni ko uwukunda gutongana atangura ibihari.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />Amajambo y’urusaku ameze nk’ivyokurya biryoshe;</para>
  <para style="q2" vid="PRO 26:22">aramanuka agashika i bwina mu mutima w’umuntu.<verse eid="PRO 26:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />Amajambo meza ava mu mutima mubi</para>
  <para style="q2" vid="PRO 26:23">ameze nk’umuringa w’ifeza ushizwe ku nkono y’ibumba.<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Umwankanyi yihisha inyuma y’amajambo yiwe aryoshe,</para>
  <para style="q2" vid="PRO 26:24">ariko umutima wiwe urimwo inama z’ubuhemu.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />Naho amajambo yiwe aryohera amatwi, ntukamwizere;</para>
  <para style="q2" vid="PRO 26:25">umutima wiwe wuzuye ubuyobe.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Naho yogenda arabesha ahisha uburyarya bwiwe,</para>
  <para style="q2" vid="PRO 26:26">ibikorwa bibi vyiwe bizoja ku mugaragaro.<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />Uwimbira ikinogo uwundi ni we azokigwamwo;</para>
  <para style="q2" vid="PRO 26:27">kandi uwuzotembagariza ikibuye ku wundi,</para>
  <para style="q2" vid="PRO 26:27">ni we kizofyonyora.<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />Ururimi rubesha rwanka abo rubabaza,</para>
  <para style="q2" vid="PRO 26:28">kandi akanwa kavuga ibinyomya karasenyura.<verse eid="PRO 26:28" /></para>
  <para style="b" />
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />Ntukishimire ivy’ejo,</para>
  <para style="q2" vid="PRO 27:1">kuko nta wumenya ivyo haramukana.<verse eid="PRO 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Uzoshimwe n’uwundi, atari akanwa kawe;</para>
  <para style="q2" vid="PRO 27:2">azobe uwo hanze, atari iminwa yawe.<verse eid="PRO 27:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />Ibuye riraremereye, kandi umusenyi ugira ibilo vyinshi,</para>
  <para style="q2" vid="PRO 27:3">ariko ugusotora kw’igipfu kuremera gusumba ivyo vyompi.<verse eid="PRO 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />Ishavu ni umwicanyi, kandi uburake butwara nk’umukuba w’uruzi;</para>
  <para style="q2" vid="PRO 27:4">ariko ni nde yohagarara imbere y’ishari?<verse eid="PRO 27:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />Gukeburirwa ahabona</para>
  <para style="q2" vid="PRO 27:5">kuruta urukundo rwinyegeje.<verse eid="PRO 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Umukunzi agukomeretsa aba ari uwo kwizigira,</para>
  <para style="q2" vid="PRO 27:6">ariko ukugumbirana kw’umwansi ni agahemo gasa.<verse eid="PRO 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Ku wuhimvye ubuki burabiha,</para>
  <para style="q2" vid="PRO 27:7">ariko ku wushonje n’ibirura birasosa.<verse eid="PRO 27:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Uwangarira kure y’i muhira</para>
  <para style="q2" vid="PRO 27:8">ameze nk’inyoni iyererera kure y’icari.<verse eid="PRO 27:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Ibimota neza binezera umutima,</para>
  <para style="q2" vid="PRO 27:9">nayo ibinezero vy’umugenzi</para>
  <para style="q2" vid="PRO 27:9">bikava ku mutima umuhanura neza.<verse eid="PRO 27:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Ntugahebe umugenzi wawe canke umugenzi w’umuryago wawe,</para>
  <para style="q2" vid="PRO 27:10">kandi ntukaje ku ncuti yawe ku musi ivyago biguteye,</para>
  <para style="q2" vid="PRO 27:10">kuko umubanyi wa hafi asumba incuti ya kure.<verse eid="PRO 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />Gira ubwenge, mwana wanje, maze uhimbare umutima wanje;</para>
  <para style="q2" vid="PRO 27:11">ni ho nzoronka ico nishura abantuka.<verse eid="PRO 27:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Umunyamakenga yama abona icago kitaramushikira akacikinga,</para>
  <para style="q2" vid="PRO 27:12">ariko igipfu gipfa kugenda, hanyuma kikisanga mu kaga.<verse eid="PRO 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Twara impuzu y’uwishinze uwo atazi,</para>
  <para style="q2" vid="PRO 27:13">ufate ingwati y’uwishinze abahita.<verse eid="PRO 27:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Nihagira uwuzinduka guhezagira mugenziwe n’ijwi rirenga,</para>
  <para style="q2" vid="PRO 27:14">ico kizomubera nk’umuvumo.<verse eid="PRO 27:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Ivano riguma ritonyanga ku musi imvura yirijeko</para>
  <para style="q2" vid="PRO 27:15">ni nk’umugore atongana.<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />Kumutesha ni nko kugumya umuyaga,</para>
  <para style="q2" vid="PRO 27:16">canke kugumya amavuta mu kiganza.<verse eid="PRO 27:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Nk’uko icuma gikarisha ikindi cuma;</para>
  <para style="q2" vid="PRO 27:17">ni ko umuntu akarishanya na mugenziwe.<verse eid="PRO 27:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />Uwututurira umusukoni azorya ivyamwa vyawo;</para>
  <para style="q2" vid="PRO 27:18">kandi uwukingira shebuja azohabwa icubahiro.<verse eid="PRO 27:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Nk’uko umuntu abona ishusho yiwe mu mazi;</para>
  <para style="q2" vid="PRO 27:19">ni ko ubuzima bw’umuntu bwerekana umutima wiwe.<verse eid="PRO 27:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Uko Rupfu na Muranduzi batigera bahaga;</para>
  <para style="q2" vid="PRO 27:20">ni ko n’amaso y’abantu ameze.<verse eid="PRO 27:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Ifeza n’inzahabu bitunganywa n’umuriro,</para>
  <para style="q2" vid="PRO 27:21">ariko umuntu asuzumwa n’ugushimagizwa.<verse eid="PRO 27:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Naho wosekura igipfu mw’isekuro,</para>
  <para style="q2" vid="PRO 27:22">ukakinoza nk’uwusekuza ingano umuhini,</para>
  <para style="q2" vid="PRO 27:22">ntiwogikuramwo ubupfu bwaco.<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />Gira umwete wo kumenya ibitungwa vyawe ingene vyifashe;</para>
  <para style="q2" vid="PRO 27:23">umenye neza amasho yawe ingene ameze<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />kuko ubutunzi ntibwamaho,</para>
  <para style="q2" vid="PRO 27:24">nk’uko urugori rutamaho uko urunganwe rugenda rukurikirana.<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />Ubwatsi bumaze gutemwa haza ubundi,</para>
  <para style="q2" vid="PRO 27:25">ubwo ku misozi bukegeranywa,<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />imyagazi yawe izokwambika,</para>
  <para style="q2" vid="PRO 27:26">kandi impene zawe zizokugurira itongo.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />Uzokamira umuryango wawe amata y’impene akwiye,</para>
  <para style="q2" vid="PRO 27:27">agutungire incoreke zawe.<verse eid="PRO 27:27" /></para>
  <para style="b" />
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />Abanyakibi bahunga ata wubirukanye,</para>
  <para style="q2" vid="PRO 28:1">ariko umugororotsi arinda nk’intare.<verse eid="PRO 28:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Iyo igihugu kigumutse kiganzwa na benshi,</para>
  <para style="q2" vid="PRO 28:2">ariko umutware afise ubwenge abungabunga umutekano.<verse eid="PRO 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Umutware acinyiza aboro</para>
  <para style="q2" vid="PRO 28:3">ameze nk’imvura y’isegenya idasiga igiterwa inyuma.<verse eid="PRO 28:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />Abataye ivyagezwe bashira hejuru abanyakibi,</para>
  <para style="q2" vid="PRO 28:4">ariko abavyubaha barabagwanya.<verse eid="PRO 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Inkozi z’ibibi ntizitahura ibibereye,</para>
  <para style="q2" vid="PRO 28:5">ariko abarondera <char style="nd">Uhoraho</char> batahura vyose.<verse eid="PRO 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />Umukene agendera mu bugororotsi</para>
  <para style="q2" vid="PRO 28:6">aruta umutunzi w’indyarya.<verse eid="PRO 28:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />Umunyabwenge wese yumvira ivyagezwe,</para>
  <para style="q2" vid="PRO 28:7">ariko uwugendana n’abakunzi b’inda atetereza se.<verse eid="PRO 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Uwigwiriza ubutunzi mu kwaka inyungu y’umurengera ku vyo aguranye umukene,</para>
  <para style="q2" vid="PRO 28:8">abwegeraniriza uwundi azofasha aboro.<verse eid="PRO 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Uwanka kwumva ivyagezwe,</para>
  <para style="q2" vid="PRO 28:9">amasengesho yiwe aba igisesema.<verse eid="PRO 28:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Uwuzimiza umugororotsi agaca mu nzira mbi</para>
  <para style="q2" vid="PRO 28:10">ni we agwa mu mutego,</para>
  <para style="q2" vid="PRO 28:10">ariko inyankamugayo izoragwa ivyiza.<verse eid="PRO 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Umutunzi yigira umunyabwenge mu vyiyumviro vyiwe;</para>
  <para style="q2" vid="PRO 28:11">ariko umukene w’umunyabwenge aramuhinyura.<verse eid="PRO 28:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Iyo abagororotsi banesheje haba umunezero mwinshi,</para>
  <para style="q2" vid="PRO 28:12">ariko iyo umunyakibi ashizwe hejuru,</para>
  <para style="q2" vid="PRO 28:12">abantu bose barinyegeza.<verse eid="PRO 28:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Uwuhisha ivyaha vyiwe nta mahirwe agira,</para>
  <para style="q2" vid="PRO 28:13">ariko uwuvyatura akabiheba agirirwa ubuntu.<verse eid="PRO 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />Hahiriwe umuntu yama ahindira agashitsi imbere y’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PRO 28:14">ariko abakomantaza imitima bazogwa mu vyago.<verse eid="PRO 28:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Uko intare itontoma ihiga idubu</para>
  <para style="q2" vid="PRO 28:15">ni ko umutware mubi amerera abakene.<verse eid="PRO 28:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Umutware atagira ugutahura aracinyiza,</para>
  <para style="q2" vid="PRO 28:16">uwanka amaronko mabi azorambira ku ngoma.<verse eid="PRO 28:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Uwubujijwe amahororo n’amaraso yasheshe</para>
  <para style="q2" vid="PRO 28:17">ahungira mu mva;</para>
  <para style="q2" vid="PRO 28:17">ntimuze mumutangire.<verse eid="PRO 28:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Inyankamugayo izorokorwa mu vyago,</para>
  <para style="q2" vid="PRO 28:18">ariko uwugoramika inzira ziwe azogwa mu rwobo.<verse eid="PRO 28:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Uwurima itongo ryiwe azoronka umwimbu mwinshi,</para>
  <para style="q2" vid="PRO 28:19">ariko uwirukira ibitagira ikimazi azohaga ubukene.<verse eid="PRO 28:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Umwizigirwa azokwuzuzwa imigisha,</para>
  <para style="q2" vid="PRO 28:20">ariko uwihutira kuronka ubutunzi ntazobura guhanwa.<verse eid="PRO 28:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Kurenganya si vyiza;</para>
  <para style="q2" vid="PRO 28:21">ariko hariho abarya igiturire c’umukate.<verse eid="PRO 28:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Uwipfuza ivy’abandi yihutira gutunga,</para>
  <para style="q2" vid="PRO 28:22">kandi ntamenya ko ubukene bumurindiriye.<verse eid="PRO 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />Uwuhanura mugenziwe azobimushimira,</para>
  <para style="q2" vid="PRO 28:23">gusumvya uwumushigikira mu gahemo.<verse eid="PRO 28:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Uwusahura se na nyina</para>
  <para style="q2" vid="PRO 28:24">akibwira ati: “Nta co bitwaye,”</para>
  <para style="q2" vid="PRO 28:24">ni umugenzi w’umuranduzi.<verse eid="PRO 28:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Uwipfuza ivy’abandi atera umuvurungano,</para>
  <para style="q2" vid="PRO 28:25">ariko uwizigira <char style="nd">Uhoraho</char> aratera imbere.<verse eid="PRO 28:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />Uwiyizigira ubwiwe ni igipfu,</para>
  <para style="q2" vid="PRO 28:26">ariko uwugendana ubwenge asimba ivyago.<verse eid="PRO 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Uwugaburira aboro nta co azobura,</para>
  <para style="q2" vid="PRO 28:27">ariko uwubiyobagiza azokwuzurako imivumo.<verse eid="PRO 28:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Iyo umunyakibi agiye ku butegetsi abantu barinyegeza,</para>
  <para style="q2" vid="PRO 28:28">ariko iyo umunyakibi apfuye, abagororotsi baragwira.<verse eid="PRO 28:28" /></para>
  <para style="b" />
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />Uwugamika izosi akanka guhanurwa,</para>
  <para style="q2" vid="PRO 29:1">azovunagurwa vuba, ata gitabara.<verse eid="PRO 29:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Iyo abagororotsi bagiye ku butegetsi, abantu baranezerwa;</para>
  <para style="q2" vid="PRO 29:2">ariko iyo umunyakibi atwaye, abantu baraboroga.<verse eid="PRO 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />Uwukunda ubwenge azanira umunezero se,</para>
  <para style="q2" vid="PRO 29:3">ariko uwugendana n’abasambanyi yisesagurirako itunga ryiwe.<verse eid="PRO 29:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Iyo umwami aca izibereye, aha impore igihugu,</para>
  <para style="q2" vid="PRO 29:4">ariko uwukunda ibiturire aragitabagura.<verse eid="PRO 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Uwuhenda umubanyi wiwe</para>
  <para style="q2" vid="PRO 29:5">aba ateze umutego ibirenge vyiwe.<verse eid="PRO 29:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Umunyakibi agwa mu mitego yiwe,</para>
  <para style="q2" vid="PRO 29:6">ariko umugororotsi araririmba akanezerwa.<verse eid="PRO 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Umugororotsi yitwararika gucira abakene iziroranye,</para>
  <para style="q2" vid="PRO 29:7">ariko umunyakibi nta bwenge bwo kubimenya agira.<verse eid="PRO 29:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Abacokoranyi bagumura igisagara,</para>
  <para style="q2" vid="PRO 29:8">ariko abanyabwenge bakuraho uburake.<verse eid="PRO 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Iyo umunyabwenge ajanye ikijuju imbere y’intahe,</para>
  <para style="q2" vid="PRO 29:9">gishobora kuraka canke kigatwenga, nta co abikuramwo.<verse eid="PRO 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Abasesa amaraso banka inyankamugayo,</para>
  <para style="q2" vid="PRO 29:10">kandi bica abagororotsi.<verse eid="PRO 29:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Igipfu cirata uburake bwaco,</para>
  <para style="q2" vid="PRO 29:11">ariko umunyabwenge arabuhwamika.<verse eid="PRO 29:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Iyo umutegetsi yumvirije ibinyoma,</para>
  <para style="q2" vid="PRO 29:12">abatware biwe bose baba babi.<verse eid="PRO 29:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Umukene n’uwumucinyiza bafise ico bahurirako:</para>
  <para style="q2" vid="PRO 29:13">
    <char style="nd">Uhoraho</char> ni we aha amaso yabo bompi kubona.<verse eid="PRO 29:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Umwami niyacira izibereye abakene,</para>
  <para style="q2" vid="PRO 29:14">inganji yiwe izohoraho.<verse eid="PRO 29:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Inkoni yo guhana itanga ubwenge,</para>
  <para style="q2" vid="PRO 29:15">ariko umwana atarezwe amaramaza nyina.<verse eid="PRO 29:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Iyo umunyakibi ateye imbere, n’icaha ni uko,</para>
  <para style="q2" vid="PRO 29:16">ariko umugororotsi azokwihweza ukugwa kwiwe.<verse eid="PRO 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Toza indero umwana wawe, na we azoguha amahoro;</para>
  <para style="q2" vid="PRO 29:17">azonezereza umutima wawe.<verse eid="PRO 29:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Iyo ata yerekwa rihari, abantu barazimira;</para>
  <para style="q2" vid="PRO 29:18">ariko hahiriwe umuntu agendera mu vyagezwe.<verse eid="PRO 29:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Umukozi ntakosorwa n’amajambo gusa,</para>
  <para style="q2" vid="PRO 29:19">n’iyo yumvise ico abwiwe ntagishirako umutima.<verse eid="PRO 29:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />Hari ivyizigiro ku muntu w’igipfu,</para>
  <para style="q2" vid="PRO 29:20">kurusha uwuvuga atiyumviriye.<verse eid="PRO 29:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Uwufyinisha umukozi wiwe akiri muto,</para>
  <para style="q2" vid="PRO 29:21">amutera kugira iherezo ribi.<verse eid="PRO 29:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />Uwihuta kuraka atera imivurungano,</para>
  <para style="q2" vid="PRO 29:22">kandi uwukaza ishavu akora ivyaha vyinshi.<verse eid="PRO 29:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />Ubwirasi bw’umuntu bumusubiza hasi,</para>
  <para style="q2" vid="PRO 29:23">ariko uwicishije bugufi arubahwa.<verse eid="PRO 29:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Uwifatanya n’umusuma aba yiyanka,</para>
  <para style="q2" vid="PRO 29:24">urahira ko uvuga ukuri, kandi utari bukuvuge.<verse eid="PRO 29:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />Gutinya abantu bita mu mutego,</para>
  <para style="q2" vid="PRO 29:25">ariko abizera <char style="nd">Uhoraho</char> barawusimba.<verse eid="PRO 29:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Abantu benshi barondera kwakirwa n’umutware,</para>
  <para style="q2" vid="PRO 29:26">ariko gucirwa iziroranye bitangwa n’<char style="nd">Uhoraho</char>.<verse eid="PRO 29:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Abagororotsi banka uburyarya,</para>
  <para style="q2" vid="PRO 29:27">ariko abanyakibi banka abubaha Imana.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="ms1">Imigani ya Aguri</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Aya ni amajambo ya Aguri mwene Yake, uwavugishijwe.</para>
  <para style="q1" vid="PRO 30:1">Uwo yabariye Utiyeli, Itiyeli na Ukali, ati:</para>
  <para style="b" vid="PRO 30:1" />
  <para style="q1" vid="PRO 30:1">“Ndatuntuye, ewe Mana,</para>
  <para style="q2" vid="PRO 30:1">ndatuntuye kandi ndarushe, ewe Mana.<verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />Ndi ikijuju kurusha abandi bose,</para>
  <para style="q2" vid="PRO 30:2">singira ugutahura kw’abantu.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Sinigishijwe ubwenge,</para>
  <para style="q2" vid="PRO 30:3">kandi sinzi Uwera.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Ni nde yagiye mw’ijuru hanyuma akagaruka?</para>
  <para style="q2" vid="PRO 30:4">Ni nde yegeranirije umuyaga mu kiganza ciwe?</para>
  <para style="q1" vid="PRO 30:4">Ni nde yegeranirije amazi mu mutamana wiwe?</para>
  <para style="q2" vid="PRO 30:4">Ni nde yashizeho impera z’isi?</para>
  <para style="q1" vid="PRO 30:4">Izina ryiwe ni nde, kandi imfura yiwe ni nde?</para>
  <para style="q2" vid="PRO 30:4">Mbarira nimba ubizi!<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />Ijambo ry’Imana ryose ni iryo kwizerwa;</para>
  <para style="q2" vid="PRO 30:5">ni inkinzo ku bayihungirako.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Ntihagire ico uzokwongera ku majambo yayo,</para>
  <para style="q2" vid="PRO 30:6">ahandi ho izoguhana ikwereke ko uri umubeshi.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />Hari ibintu bibiri ngusaba, ewe Mana;</para>
  <para style="q2" vid="PRO 30:7">kandi ntubinyime nkiriho:<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />undinde ibinyoma n’ububeshi, bimbe kure;</para>
  <para style="q2" vid="PRO 30:8">ntumpe ubukene canke ubutunzi bwinshi,</para>
  <para style="q2" vid="PRO 30:8">ariko umpe ibinkwiye buri musi.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Nohava ntunga nkakugaya,</para>
  <para style="q2" vid="PRO 30:9">nti <char style="nd">Uhoraho</char> ni iki?</para>
  <para style="q1" vid="PRO 30:9">Canke nkaba umukene nkiba,</para>
  <para style="q2" vid="PRO 30:9">nkatukisha izina ry’Imana yanje.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />Ntukavuge nabi umukozi imbere ya shebuja,</para>
  <para style="q2" vid="PRO 30:10">kuko azokuvuma, kandi uzohanirwa icaha cawe.<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />Hari abavuma ba se,</para>
  <para style="q2" vid="PRO 30:11">kandi ntibahezagire ba nyina,<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />bakibwira ko ari beza,</para>
  <para style="q2" vid="PRO 30:12">kandi batikuyeko imyanda ibariko;<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />bafise amaso y’ubwibone,</para>
  <para style="q2" vid="PRO 30:13">barabira abandi hasi.<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />Hari abafise amenyo ameze nk’inkota,</para>
  <para style="q2" vid="PRO 30:14">imibangabanga yabo irimwo imbugita.</para>
  <para style="q1" vid="PRO 30:14">Batabagura aboro kw’isi,</para>
  <para style="q2" vid="PRO 30:14">abakene bakabatabagurira mu bantu.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />Umuyoka ufise abakobwa babiri.</para>
  <para style="q2" vid="PRO 30:15">Barasemerera bati: ‘Zana! Zana!’</para>
  <para style="b" vid="PRO 30:15" />
  <para style="li1" vid="PRO 30:15">Hari ibintu bitatu bidahaga,</para>
  <para style="li2" vid="PRO 30:15">n’ica kane kitigera kivuga kiti: ‘Geza aho’:<verse eid="PRO 30:15" /></para>
  <para style="li3">
    <verse number="16" style="v" sid="PRO 30:16" />imva,</para>
  <para style="li3" vid="PRO 30:16">inda y’ingumba,</para>
  <para style="li3" vid="PRO 30:16">isi idahaga amazi,</para>
  <para style="li3" vid="PRO 30:16">hamwe n’umuriro utigera uvuga uti: ‘Geza aho!’<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />Ijisho ry’uwugaya se,</para>
  <para style="q2" vid="PRO 30:17">rigakengera nyina ashaje,</para>
  <para style="q1" vid="PRO 30:17">rizonokorwa n’ibikona vyo mu biyaya,</para>
  <para style="q2" vid="PRO 30:17">riribwe n’ibinyakabaka.<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="18" style="v" sid="PRO 30:18" />Hari ibintu bine bintangaza cane,</para>
  <para style="li2" vid="PRO 30:18">mbere ni bine ntatahura:<verse eid="PRO 30:18" /></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 30:19" />inzira y’inkona mu kirere,</para>
  <para style="li3" vid="PRO 30:19">inzira y’inzoka ku gitandara,</para>
  <para style="li3" vid="PRO 30:19">inzira y’ubwato mu kiyaga,</para>
  <para style="li3" vid="PRO 30:19">n’inzira y’umusore ku nkumi.<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />Uku ni ko umusambanyikazi abigenza:</para>
  <para style="q2" vid="PRO 30:20">ararya hanyuma akihanagura,</para>
  <para style="q2" vid="PRO 30:20">maze akavuga ati: ‘Nta kibi nigeze nkora.’<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="21" style="v" sid="PRO 30:21" />Hari ibintu bitatu bijugumiza isi,</para>
  <para style="li2" vid="PRO 30:21">mbere ni bine idashobora kwihanganira:<verse eid="PRO 30:21" /></para>
  <para style="li3">
    <verse number="22" style="v" sid="PRO 30:22" />umugurano abaye umwami,</para>
  <para style="li3" vid="PRO 30:22">igipfu cujuje ivyokurya,<verse eid="PRO 30:22" /></para>
  <para style="li3">
    <verse number="23" style="v" sid="PRO 30:23" />umugore atisonera mugabo akarongorwa,</para>
  <para style="li3" vid="PRO 30:23">hamwe n’incoreke isubirira inabuja.<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="PRO 30:24" />Hari ibintu bine bitobito kw’isi,</para>
  <para style="li2" vid="PRO 30:24">ariko biciye ubwenge cane:<verse eid="PRO 30:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="PRO 30:25" />Ibimonyo ni udukoko dutoduto,</para>
  <para style="li3" vid="PRO 30:25">ariko biriziganiriza ivyokurya vyo mu ci;<verse eid="PRO 30:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="PRO 30:26" />inkezi ni uturemwa tw’utunyantegenke,</para>
  <para style="li3" vid="PRO 30:26">ariko twubaka inzu yatwo mu gitandara,<verse eid="PRO 30:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="PRO 30:27" />inzige ntizigira umwami,</para>
  <para style="li3" vid="PRO 30:27">ariko zigira hamwe mu migwi;<verse eid="PRO 30:27" /></para>
  <para style="li2">
    <verse number="28" style="v" sid="PRO 30:28" />umuserebanyi ushobora gufatishwa amaboko,</para>
  <para style="li3" vid="PRO 30:28">ariko uwusanga mu birimba vy’abami.<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="29" style="v" sid="PRO 30:29" />Hari ibinyabuzima bitatu bitambuka neza,</para>
  <para style="li2" vid="PRO 30:29">mbere ni bine bigenda birashonyanga:<verse eid="PRO 30:29" /></para>
  <para style="li3">
    <verse number="30" style="v" sid="PRO 30:30" />intare, ikomeye gusumvya ibindi bikoko, itigera ihunga na kimwe,<verse eid="PRO 30:30" /></para>
  <para style="li3">
    <verse number="31" style="v" sid="PRO 30:31" />isake ihagaze ku maguru yayo,</para>
  <para style="li3" vid="PRO 30:31">isuguru y’impene,</para>
  <para style="li3" vid="PRO 30:31">hamwe n’umwami agendera imbere y’ingabo ziwe.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />Iyo wigize igipfu ukishira hejuru,</para>
  <para style="q2" vid="PRO 30:32">canke ugategura gukora ikibi,</para>
  <para style="q2" vid="PRO 30:32">pfuka n’urushi akanwa kawe.<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />Kuko nk’uko amata aterewe avamwo amavuta,</para>
  <para style="q2" vid="PRO 30:33">izuru rikubiswe rikava umwuna,</para>
  <para style="q2" vid="PRO 30:33">ni ko kuratsa umuntu bitera ibihari.”<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="ms1">Imigani y’umwami Lemuweli</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Iyi ni imigani y’umwami Lemuweli, yavugishwa amajambo y’ubwenge yigishijwe na nyina.<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />Nyumviriza, mwana wanje! Ntega amatwi bura bwanje!</para>
  <para style="q2" vid="PRO 31:2">Nyumviriza, mwana wanje, wewe nyishu y’amasengesho yanje.<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />Ntugahereze inkomezi zawe mu bagore,</para>
  <para style="q2" vid="PRO 31:3">canke inguvu zawe ku bagwisha abami.<verse eid="PRO 31:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />Si ivy’abami, ewe Lemuweli,</para>
  <para style="q2" vid="PRO 31:4">si ivy’abami kunywa umuvinyu,</para>
  <para style="q2" vid="PRO 31:4">n’abatware kunohokera inzoga,<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />kuko bonywa bakibagira ivyashinzwe,</para>
  <para style="q2" vid="PRO 31:5">bakananirwa kugirira neza abacinyijwe.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Reka inzoga zibe iz’abahona,</para>
  <para style="q2" vid="PRO 31:6">umuvinyu ube uw’abababaye!<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />Nibabe ari bo banywa, bibagire ubukene bwabo,</para>
  <para style="q2" vid="PRO 31:7">ntibasubire kwibuka amagorwa yabo.<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />Uvugire abadashobora kwivugira,</para>
  <para style="q2" vid="PRO 31:8">ugirire neza ba ntahonikora.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Uvuge kandi uce izibereye;</para>
  <para style="q2" vid="PRO 31:9">uburanire aboro n’abakene.<verse eid="PRO 31:9" /></para>
  <para style="ms1">Umugore w’imico myiza</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Umugore w’imico myiza yova hehe?</para>
  <para style="q2" vid="PRO 31:10">Asumba utubuye tw’agaciro.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Umugabo wiwe aramwizigira cane,</para>
  <para style="q2" vid="PRO 31:11">kandi nta c’agaciro amuburana.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Azanira ivyiza umugabo, atari ibibi,</para>
  <para style="q2" vid="PRO 31:12">imisi yose yo kubaho kwiwe.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />Atoranya ubwoya bw’intama n’ipampa,</para>
  <para style="q2" vid="PRO 31:13">akajisha impuzu n’amaboko yiwe anezerewe.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Ameze nk’ubwato bw’umudandaza,</para>
  <para style="q2" vid="PRO 31:14">azana ivyokurya abikuye kure.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />Avyuka bugihwibiriye;</para>
  <para style="q2" vid="PRO 31:15">akaronderera indya umuryango,</para>
  <para style="q2" vid="PRO 31:15">akaronderera n’incoreke ziwe.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Abona itongo akarishima, maze akarigura;</para>
  <para style="q2" vid="PRO 31:16">maze mu biva mu vyo akora, ahatera uruzabibu.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />Agira umwete mwinshi mu vyo akora,</para>
  <para style="q2" vid="PRO 31:17">amaboko yiwe ayaha kurema.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Aramenya ko urudandazwa rwiwe rutera ruja imbere,</para>
  <para style="q2" vid="PRO 31:18">kandi itara ryiwe ntirizima mw’ijoro.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Amaboko yiwe atunganya ubwoya bw’intama,</para>
  <para style="q2" vid="PRO 31:19">intoke ziwe zikajisha impuzu<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Apfumbaturura ibiganza agafasha aboro,</para>
  <para style="q2" vid="PRO 31:20">akaramvurira amaboko gufasha abakene.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />Mu gihe c’imbeho nyinshi, ntatinyira umuryango wiwe,</para>
  <para style="q2" vid="PRO 31:21">kuko abambika izisusurutse.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Yijishira ivyo kwipfuka mw’ijoro,</para>
  <para style="q2" vid="PRO 31:22">akambara izera derere n’izitukura.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Umugabo wiwe arubahwa kw’irembo ry’igisagara,</para>
  <para style="q2" vid="PRO 31:23">iyo yicaranye n’abatware baho.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />Ajisha imitamana yera derere akayigurisha,</para>
  <para style="q2" vid="PRO 31:24">akaronkera imikenyezo abadandaza.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Yambaye inkomezi n’icubahiro</para>
  <para style="q2" vid="PRO 31:25">ategekanya kazoza mu munezero.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />Avugana ubwenge,</para>
  <para style="q2" vid="PRO 31:26">kandi impanuro z’ubwizigirwa ziri mu kanwa kiwe.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Yitaho ibikorwa vy’umugabo wiwe,</para>
  <para style="q2" vid="PRO 31:27">kandi ntarya ivyo atabiriye akuya.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Abana biwe bose baramushimagiza,</para>
  <para style="q2" vid="PRO 31:28">umugabo wiwe akamushima avuga ati:<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />“Hari abagore benshi bakora ivyiza,</para>
  <para style="q2" vid="PRO 31:29">ariko bose urabaruta.”<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />Kugira uburanga gusa birahenda, kandi ubwiza bwo ku rukoba nta co bumaze.</para>
  <para style="q2" vid="PRO 31:30">Ariko umugore yubaha <char style="nd">Uhoraho</char> azoshimwa.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Arabereye guhabwa ibiva mu maboko yiwe,</para>
  <para style="q2" vid="PRO 31:31">kandi ibikorwa yakoze bimushire hejuru kw’irembo ry’igisagara.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>