  <para style="h">Zaburi</para>
  <para style="toc1">Zaburi</para>
  <para style="toc2">Zaburi</para>
  <para style="toc3">Zab</para>
  <para style="mt1">Zaburi</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">Igitabu ca mbere</para>
  <para style="mr">
    <ref loc="PSA 1-41">Zaburi 1–41</ref></para>
  <para style="cl">Zaburi ya 1</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />Hahiriwe umuntu</para>
  <para style="q2" vid="PSA 1:1">adakurikiza impanuro z’abanyakibi,</para>
  <para style="q1" vid="PSA 1:1">ntahagarare mu nzira y’abanyavyaha,</para>
  <para style="q2" vid="PSA 1:1">canke ngo yicarane n’abacokoranyi,<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />ahubwo agahimbarwa n’Ivyagezwe vy’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 1:2">akaba ari vyo ashirako umutima ku murango no mw’ijoro.<verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />Ameze nk’igiti catewe i ruhande y’imigezi y’amazi,</para>
  <para style="q2" vid="PSA 1:3">kikama mu gihe caco,</para>
  <para style="q1" vid="PSA 1:3">kandi amababi yaco ntiyuma.</para>
  <para style="q2" vid="PSA 1:3">Ico akoze cose kiratera imbere.<verse eid="PSA 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />Ariko abanyakibi si ko bameze!</para>
  <para style="q2" vid="PSA 1:4">Bo bameze nk’umuguruka</para>
  <para style="q2" vid="PSA 1:4">utumurwa n’umuyaga.<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />Ni co gituma abanyakibi batazohagarara ku musi w’urubanza,</para>
  <para style="q2" vid="PSA 1:5">canke abanyavyaha mw’ikoraniro ry’abagororotsi.<verse eid="PSA 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />Kuko <char style="nd">Uhoraho</char> arinda inzira y’abagororotsi,</para>
  <para style="q2" vid="PSA 1:6">ariko inzira y’abanyakibi ijana mu mahonero.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="cl">Zaburi ya 2</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />Ni kuki amahanga ateye umuvurungano</para>
  <para style="q2" vid="PSA 2:1">n’amoko akagira inama z’ubusa?<verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />Abami bo mw’isi bahagurutse</para>
  <para style="q2" vid="PSA 2:2">n’abatware bagiye hamwe</para>
  <para style="q2" vid="PSA 2:2">ngo bagwanye <char style="nd">Uhoraho</char> n’uwo yarobanuje amavuta, bavuga bati:<verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />“Nimuze ducagagure ivyo batubohesheje,</para>
  <para style="q2" vid="PSA 2:3">twiyambure iminyororo yabo.”<verse eid="PSA 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />Umwe ari ku ntebe y’ubwami mw’ijuru aritwengera;</para>
  <para style="q2" vid="PSA 2:4">Uhoraho abatwengera mw’ijigo.<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />Abakankamirana uburake bwiwe,</para>
  <para style="q2" vid="PSA 2:5">akabatera ubwoba mu bushangashirwe bwiwe, ati:<verse eid="PSA 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6" />“Niyimikiye umwami wanje</para>
  <para style="q2" vid="PSA 2:6">i Siyoni, umusozi wanje wera.”<verse eid="PSA 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7" />Ndavuga ivyo <char style="nd">Uhoraho</char> yashinze.</para>
  <para style="q1" vid="PSA 2:7">Yambwiye ati: “Uri umwana wanje;</para>
  <para style="q2" vid="PSA 2:7">uwu musi ndakuvyaye.<verse eid="PSA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8" />Nsaba,</para>
  <para style="q2" vid="PSA 2:8">nanje nzohindura amahanga umugabane wawe,</para>
  <para style="q2" vid="PSA 2:8">n’impera z’isi zibe inyegu yawe.<verse eid="PSA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9" />Uzoyamenaguza inkoni y’icuma;</para>
  <para style="q2" vid="PSA 2:9">uyagire ubunywenywe nk’inkono y’ibumba.”<verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />Nuko rero, yemwe bami nimuce ubwenge;</para>
  <para style="q2" vid="PSA 2:10">mwemere kuburirwa, yemwe batware bo kw’isi.<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11" />Mukorere <char style="nd">Uhoraho</char> muhinda agashitsi,</para>
  <para style="q2" vid="PSA 2:11">munezerererwe ibikorwa vyiwe muhinda agashitsi.<verse eid="PSA 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12" />Nimuce bugufi imbere y’uwo mwana kugira ngo ntarake</para>
  <para style="q2" vid="PSA 2:12">maze mugahonera mu nzira,</para>
  <para style="q1" vid="PSA 2:12">kuko uburake bwiwe buduga mu kanya isase.</para>
  <para style="q2" vid="PSA 2:12">Hahiriwe abamuhungirako bose.<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="cl">Zaburi ya 3</para>
  <para style="d">Zaburi Dawidi yanditse igihe yahunga umuhungu wiwe Abusalomu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1" />
    <char style="nd">Uhoraho</char>, abanyanka ni benshi!</para>
  <para style="q2" vid="PSA 3:1">Abampagurukiye baragwiriye!<verse eid="PSA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2" />Benshi bamvugako bati:</para>
  <para style="q2" vid="PSA 3:2">“Imana ntizomukiza.”<verse eid="PSA 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3" />Ariko wewe <char style="nd">Uhoraho</char>, uri inkinzo inkingira impande zose,</para>
  <para style="q2" vid="PSA 3:3">uri icubahiro canje, uwutuma mpagarara nemye.<verse eid="PSA 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4" />Nambaza <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 3:4">na we akanyishura ari ku musozi wiwe wera.<verse eid="PSA 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5" />Ndaryama ngasinzira;</para>
  <para style="q2" vid="PSA 3:5">nkongera nkikangura, kuko <char style="nd">Uhoraho</char> ari we anshigikiye.<verse eid="PSA 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6" />Sinzotinya naho ingabo ibihumbi vyinshi</para>
  <para style="q2" vid="PSA 3:6">zonyugariza impande zose.<verse eid="PSA 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7" />Haguruka, ewe <char style="nd">Uhoraho</char>!</para>
  <para style="q2" vid="PSA 3:7">Ntabara, ewe Mana yanje!</para>
  <para style="q1" vid="PSA 3:7">Kubita abansi banje bose mu musaya;</para>
  <para style="q2" vid="PSA 3:7">uhongore amenyo y’abanyakibi.<verse eid="PSA 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8" />Ugutabarwa kuva k’<char style="nd">Uhoraho</char>.</para>
  <para style="q2" vid="PSA 3:8">Umugisha wawe nube ku bantu bawe.<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="cl">Zaburi ya 4</para>
  <para style="d">Yahawe umukuru w’abacuraranzi b’ibicurarangisho vy’imirya. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1" />Uze unyishure ninakwambaza,</para>
  <para style="q2" vid="PSA 4:1">Mana yanje igororotse.</para>
  <para style="q1" vid="PSA 4:1">Unkure mu magorwa;</para>
  <para style="q2" vid="PSA 4:1">ngutere ikigongwe, wumve ugusenga kwanje.<verse eid="PSA 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2" />Muzogeza ryari ga mwa bantu guhindura icubahiro canje ibiteterwe?</para>
  <para style="q2" vid="PSA 4:2">Muzogeza ryari gukunda ibitagira ikimazi no kurondera imana z’ibinyoma?<verse eid="PSA 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3" />Mumenye ko <char style="nd">Uhoraho</char> yirobanuriye umusavyi wiwe w’umwizigirwa;</para>
  <para style="q2" vid="PSA 4:3">
    <char style="nd">Uhoraho</char> aranyumva iyo ndamutakambiye.<verse eid="PSA 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4" />Nimuhinde agashitsi ntimukore icaha;</para>
  <para style="q2" vid="PSA 4:4">muri ku buriri bwanyu,</para>
  <para style="q2" vid="PSA 4:4">nimusuzume imitima yanyu mucereje.<verse eid="PSA 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5" />Nimutange ibimazi vy’abagororotsi</para>
  <para style="q2" vid="PSA 4:5">kandi mwizigire <char style="nd">Uhoraho</char>.<verse eid="PSA 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6" />Ewe <char style="nd">Uhoraho</char>, benshi barabaza bati: “Ni nde azotuma tugira amahirwe?”</para>
  <para style="q2" vid="PSA 4:6">Umuco wo mu nyonga zawe nuturasire.<verse eid="PSA 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7" />Wuzuza umutima wanje umunezero</para>
  <para style="q2" vid="PSA 4:7">uruta uwo bagira mu gihe c’umusesekara w’ingano n’umuvinyu.<verse eid="PSA 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8" />Nzoryama mu mahoro nsinzire,</para>
  <para style="q2" vid="PSA 4:8">kuko wewe wenyene, <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 4:8">ari wewe umpa kuba mu mutekano.<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="cl">Zaburi ya 5</para>
  <para style="d">Yahawe umukuru w’abacuraranzi bakoresha imyironge. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1" />Niwumvirize amajambo yanje, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 5:1">witeho ugucura intimba kwanje.<verse eid="PSA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2" />Wumve ugutaka kwanje untabare,</para>
  <para style="q2" vid="PSA 5:2">Mwami wanje kandi Mana yanje,</para>
  <para style="q2" vid="PSA 5:2">kuko ari wewe nsenga.<verse eid="PSA 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3" />Mu gitondo wumve ijwi ryanje;</para>
  <para style="q2" vid="PSA 5:3">mu gitondo nzana imbere yawe ivyo ngusaba</para>
  <para style="q2" vid="PSA 5:3">nkarindira niteze inyishu yawe.<verse eid="PSA 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4" />Nturi Imana ihimbarwa n’ikibi;</para>
  <para style="q2" vid="PSA 5:4">kandi abanyakibi nta kibanza bafise imbere yawe.<verse eid="PSA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5" />Abibone ntibazohagarara</para>
  <para style="q2" vid="PSA 5:5">imbere y’inyonga zawe.</para>
  <para style="q1" vid="PSA 5:5">Wanka abakora ibibi bose;<verse eid="PSA 5:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 5:6" />uherengeteza abavuga ibinyoma bose.</para>
  <para style="q1" vid="PSA 5:6">Abasesa amaraso n’ingunge</para>
  <para style="q2" vid="PSA 5:6">Wewe, <char style="nd">Uhoraho</char>, ubanka urunuka.<verse eid="PSA 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7" />Ariko jewe, ku bw’urukundo rwawe rwinshi,</para>
  <para style="q2" vid="PSA 5:7">ndashobora kuza mu Ngoro yawe;</para>
  <para style="q1" vid="PSA 5:7">nkunama nubashe,</para>
  <para style="q2" vid="PSA 5:7">ntumbereye urusengero rwawe rwera.<verse eid="PSA 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8" />Ndongorera mu kugororoka kwawe, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 5:8">kuko mfise abansi.</para>
  <para style="q2" vid="PSA 5:8">Utumbereze inzira yawe imbere yanje.<verse eid="PSA 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9" />Nta kuri kuva mu kanwa kabo;</para>
  <para style="q2" vid="PSA 5:9">umutima wabo wuzuyemwo ubugunge,</para>
  <para style="q1" vid="PSA 5:9">umuhogo wabo ni nk’imva irangaye;</para>
  <para style="q2" vid="PSA 5:9">indimi zabo bazivugisha ibinyoma.<verse eid="PSA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10" />Bamenyeshe ko batsinzwe, ewe Mana!</para>
  <para style="q2" vid="PSA 5:10">Ubugunge bwabo nibubabere umutego.</para>
  <para style="q1" vid="PSA 5:10">Ubirukane kubera ivyaha vyabo vyinshi,</para>
  <para style="q2" vid="PSA 5:10">kuko bakugararije.<verse eid="PSA 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11" />Ariko abaguhungiyeko bose banezerwe;</para>
  <para style="q2" vid="PSA 5:11">baririmbishwe n’umunezero ibihe bidashira.</para>
  <para style="q1" vid="PSA 5:11">Bapfuke ubakingire,</para>
  <para style="q2" vid="PSA 5:11">kugira ngo abakunda izina ryawe bakunezerererwe.<verse eid="PSA 5:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12" />Ni ukuri, ewe <char style="nd">Uhoraho</char>, ni wewe uhezagira abagororotsi;</para>
  <para style="q2" vid="PSA 5:12">ubakikiza ukugira neza kwawe nk’inkinzo.<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="cl">Zaburi ya 6</para>
  <para style="d">Yahawe umukuru w’abaririmvyi bacurarangisha ibicurarangisho vy’imirya. Iririmbwa mu mudiho witwa <char style="tl">Sheminite</char> <note caller="+" style="f"><char style="fr" closed="false">6:0 </char><char style="ft" closed="false">Ijambo <char style="tl">Sheminite</char> rishobora kuba risigura ubwoko bw’umudiho.</char></note>. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1" />
    <char style="nd">Uhoraho</char> ntunkankamirane uburake</para>
  <para style="q2" vid="PSA 6:1">canke ngo umpanane ubushangashirwe.<verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />Ngirira imbabazi, <char style="nd">Uhoraho</char>, kuko ncitse intege;</para>
  <para style="q2" vid="PSA 6:2">unkize, <char style="nd">Uhoraho</char>, kuko amagufa yanje ajugumiye.<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />Umutima wanje unshongeyemwo.</para>
  <para style="q2" vid="PSA 6:3">Uzogeza ryari, ewe <char style="nd">Uhoraho</char>, uzogeza ryari?<verse eid="PSA 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />Hindukira, <char style="nd">Uhoraho</char>, maze untabare;</para>
  <para style="q2" vid="PSA 6:4">unkize ku bw’urukundo rwawe rudashira.<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />Mu bapfuye nta n’umwe yamamaza izina ryawe.</para>
  <para style="q2" vid="PSA 6:5">Ni nde azogutazirira i kuzimu?<verse eid="PSA 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />Nciwe intege n’ukuniha kwanje.</para>
  <para style="b" vid="PSA 6:6" />
  <para style="q1" vid="PSA 6:6">Mara ijoro ryose nuzuza uburiri bwanje amarira,</para>
  <para style="q2" vid="PSA 6:6">aho ndyama nkahatotesha amosozi.<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />Amaso yanje ararushe ku bw’umubabaro;</para>
  <para style="q2" vid="PSA 6:7">ntakibona neza kubera abansi banje.<verse eid="PSA 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />Nimuje kure yanje, mwa nkozi z’ibibi mwe,</para>
  <para style="q2" vid="PSA 6:8">kuko <char style="nd">Uhoraho</char> yumvise ukurira kwanje.<verse eid="PSA 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />
    <char style="nd">Uhoraho</char> yumvise ugutakamba kwanje;</para>
  <para style="q2" vid="PSA 6:9">
    <char style="nd">Uhoraho</char> yakiriye ugusenga kwanje.<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />Abansi banje bose bazorengerwa n’ubumaramare n’uguhinda agashitsi;</para>
  <para style="q2" vid="PSA 6:10">bazosubira inyuma maze bamaramare giturumbuka.<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="cl">Zaburi ya 7</para>
  <para style="d">Ni <char style="tl">Shigayoni</char> <note caller="+" style="f"><char style="fr" closed="false">7:0 </char><char style="ft" closed="false">Ijambo <char style="tl">Shigayoni</char> rishobora kuba risigura ubwoko bw’icese canke bw’umudiho.</char></note> ya Dawidi, iyo yaririmbiye <char style="nd">Uhoraho</char> yerekeye Kushi, Umubenyamini.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1" />
    <char style="nd">Uhoraho</char> Mana yanje, muri wewe ni ho mpungiye;</para>
  <para style="q2" vid="PSA 7:1">untabare kandi unkize abampiga bose,<verse eid="PSA 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2" />kugira ngo ntibantabagure nk’intambwe</para>
  <para style="q2" vid="PSA 7:2">ngo bampimbaguremwo ibihimba ata wo kuntabara.<verse eid="PSA 7:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3" />
    <char style="nd">Uhoraho</char> Mana yanje, ninaba narakoze ivyo bavuga,</para>
  <para style="q2" vid="PSA 7:3">hakaba hari icagira amaboko yanje;<verse eid="PSA 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4" />ninaba nishuye ikibi umugenzi yankoreye iciza,</para>
  <para style="q2" vid="PSA 7:4">canke naranyaze umwansi wanje ata nyanduruko,<verse eid="PSA 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5" />umwansi wanje nampige maze anshikire;</para>
  <para style="q2" vid="PSA 7:5">umureke ahonyangire ubugingo bwanje hasi,</para>
  <para style="q2" vid="PSA 7:5">maze aryamike icubahiro canje mu mukungungu.<verse eid="PSA 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6" />Haguruka mu burake bwawe, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 7:6">ugwanye ubushangashirwe bw’abansi banje.</para>
  <para style="q2" vid="PSA 7:6">Ikangure Mana yanje, uce urubanza.<verse eid="PSA 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7" />Amahanga yose nagukikuze,</para>
  <para style="q2" vid="PSA 7:7">maze uyaganze uvyagiye mw’ijuru.<verse eid="PSA 7:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 7:8" />
    <char style="nd">Uhoraho</char>, cira urubanza amahanga.</para>
  <para style="q1" vid="PSA 7:8">Mburanira ewe <char style="nd">Uhoraho</char>, nk’uko ukugororoka kwanje kuri,</para>
  <para style="q2" vid="PSA 7:8">nk’uko ubwizigirwa bwanje buri, ewe Iyisumbavyose.<verse eid="PSA 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9" />Herengeteza ububi bw’umunyakibi,</para>
  <para style="q2" vid="PSA 7:9">utabare umugororotsi;</para>
  <para style="q1" vid="PSA 7:9">wewe Mana igororotse,</para>
  <para style="q2" vid="PSA 7:9">wewe usuzuma ivyiyumviro n’imitima.<verse eid="PSA 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10" />Imana Musumbavyose ni yo nkinzo yanje,</para>
  <para style="q2" vid="PSA 7:10">ni yo ikiza imitima igororotse.<verse eid="PSA 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11" />Imana ni umucamanza agororotse,</para>
  <para style="q2" vid="PSA 7:11">Imana yama yerekana uburake bwayo.<verse eid="PSA 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12" />Umuntu natihana,</para>
  <para style="q2" vid="PSA 7:12">Imana izokarisha inkota yayo;</para>
  <para style="q2" vid="PSA 7:12">izofora umuheto wayo.<verse eid="PSA 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13" />Yateguye ibigwanisho vyayo vyica</para>
  <para style="q2" vid="PSA 7:13">yegeranije imyampi yayo yaka umuriro.<verse eid="PSA 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14" />Uwutwaye inda y’ikibi</para>
  <para style="q2" vid="PSA 7:14">yibungenga ivyago, akavyara ikinyoma.<verse eid="PSA 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15" />Uwimba ikinogo akakigira kirekire,</para>
  <para style="q2" vid="PSA 7:15">ni we nyene akigwamwo.<verse eid="PSA 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16" />Ivyago atera bimugarukako,</para>
  <para style="q2" vid="PSA 7:16">kandi ububisha ategura bugwa ku mutwe wiwe.<verse eid="PSA 7:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17" />Nzoha ishimwe <char style="nd">Uhoraho</char> ku bw’ukugororoka kwiwe,</para>
  <para style="q2" vid="PSA 7:17">nzotazira izina ry’<char style="nd">Uhoraho</char> Musumbavyose.<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="cl">Zaburi ya 8</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Iririmbwa mu mudiho witwa gitite. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1" />
    <char style="nd">Uhoraho</char> Mana yacu,</para>
  <para style="q2" vid="PSA 8:1">ese ingene izina ryawe ari iry’icubahiro mw’isi yose!</para>
  <para style="b" vid="PSA 8:1" />
  <para style="q1" vid="PSA 8:1">Washize icubahiro cawe</para>
  <para style="q2" vid="PSA 8:1">hejuru y’amajuru.<verse eid="PSA 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2" />Mu kanwa k’abana bato n’inzoya</para>
  <para style="q2" vid="PSA 8:2">ni ho washinze igihome gikinga abansi bawe,</para>
  <para style="q2" vid="PSA 8:2">ngo uzibe akanwa k’abansi bakugwanya.<verse eid="PSA 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3" />Iyo niyumviriye ku majuru yawe,</para>
  <para style="q2" vid="PSA 8:3">igikorwa c’intoke zawe,</para>
  <para style="q1" vid="PSA 8:3">ukwezi n’inyenyeri,</para>
  <para style="q2" vid="PSA 8:3">ivyo wewe washizeho,<verse eid="PSA 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4" />mbega umuntu ni iki kugira ngo umwibuke,</para>
  <para style="q2" vid="PSA 8:4">canke umwana w’umuntu ni iki kugira ngo umwiteho?<verse eid="PSA 8:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5" />Habuze gato ngo umunganye n’abamarayika;</para>
  <para style="q2" vid="PSA 8:5">kandi wamwambitse ubwiza n’icubahiro.<verse eid="PSA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6" />Wamugize uwo kuganza ibikorwa vy’amaboko yawe;</para>
  <para style="q2" vid="PSA 8:6">washize vyose musi y’ububasha bwiwe:<verse eid="PSA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7" />imikuku yose n’amasho,</para>
  <para style="q2" vid="PSA 8:7">n’ibikoko vyo mw’ishamba,<verse eid="PSA 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8" />inyoni zo mu kirere,</para>
  <para style="q2" vid="PSA 8:8">n’amafi yo mu kiyaga,</para>
  <para style="q2" vid="PSA 8:8">ibigendera mu mazi yo mu biyaga vyose.<verse eid="PSA 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9" />
    <char style="nd">Uhoraho</char>, Mana yacu,</para>
  <para style="q2" vid="PSA 8:9">ese ingene izina ryawe rihambaye mw’isi yose!<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="cl">Zaburi ya 9</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Iririmbwa mw’ijwi ryitwa “Urupfu rw’umwana w’umuhungu.” Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1" />Nzogushima, <char style="nd">Uhoraho</char>, n’umutima wanje wose;</para>
  <para style="q2" vid="PSA 9:1">nzokwamamaza ibihambaye wakoze.<verse eid="PSA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2" />Nzonezerwa mpimbarirwe muri wewe;</para>
  <para style="q2" vid="PSA 9:2">nzoririmba amatazirano y’izina ryawe, ewe Iyisumbavyose.<verse eid="PSA 9:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3" />Abansi banje basubiye inyuma;</para>
  <para style="q2" vid="PSA 9:3">baranyereye baratemvye imbere yawe.<verse eid="PSA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4" />Kuko wampagarariye, ukamburanira,</para>
  <para style="q2" vid="PSA 9:4">uvyagiye ku ntebe yawe nk’umucamanza agororotse.<verse eid="PSA 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5" />Wakankamiye amahanga, uhonya abanyakibi;</para>
  <para style="q2" vid="PSA 9:5">wasibanganije izina ryabo ibihe bidashira.<verse eid="PSA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6" />Abansi banje bararandutse ibihe bidashira,</para>
  <para style="q2" vid="PSA 9:6">waranduranye n’imizi ibisagara vyabo;</para>
  <para style="q2" vid="PSA 9:6">nta n’ico kubibukirako kigisigaye.<verse eid="PSA 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7" />
    <char style="nd">Uhoraho</char> aganje ibihe bidashira;</para>
  <para style="q2" vid="PSA 9:7">yashinze intebe yiwe y’ubwami ngo ace imanza.<verse eid="PSA 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8" />Aganza isi mu bugororotsi</para>
  <para style="q2" vid="PSA 9:8">kandi acira imanza amoko mu kuri.<verse eid="PSA 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9" />
    <char style="nd">Uhoraho</char> abera ubuhungiro impahazwa,</para>
  <para style="q2" vid="PSA 9:9">ni igihome co guhungiramwo mu gihe c’ivyago.<verse eid="PSA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10" />Abazi izina ryawe bazokwizigira,</para>
  <para style="q2" vid="PSA 9:10">kuko wewe, <char style="nd">Uhoraho</char>, ntiwigeze uheba abakurondera.<verse eid="PSA 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11" />Muririmbe amashimwe y’<char style="nd">Uhoraho</char>, avyagiye i Siyoni;</para>
  <para style="q2" vid="PSA 9:11">mumenyekanishe mu mahanga ivyo yakoze.<verse eid="PSA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12" />Kuko uwuhora amaraso yasheshwe aribuka;</para>
  <para style="q2" vid="PSA 9:12">ntiyirengagiza ugutakamba kw’abari mu marushwa.<verse eid="PSA 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13" />
    <char style="nd">Uhoraho</char>, raba ingene abansi banje bampama!</para>
  <para style="q2" vid="PSA 9:13">Ngirira ikigongwe maze unkure mu vyara vy’urupfu,<verse eid="PSA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14" />kugira ngo nze mvuge amashimwe yawe</para>
  <para style="q2" vid="PSA 9:14">mu marembo y’Umukobwa Siyoni,</para>
  <para style="q2" vid="PSA 9:14">kugira ngo nezerererwe agakiza kawe.<verse eid="PSA 9:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15" />Amahanga yakorokeye mu cobo yimvye;</para>
  <para style="q2" vid="PSA 9:15">ibirenge vyabo vyaguye mu mutego bateze ubwabo.<verse eid="PSA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16" />
    <char style="nd">Uhoraho</char> yimenyekanishije mu bikorwa vyo kugororoka yakoze;</para>
  <para style="q2" vid="PSA 9:16">abanyakibi bafashwe n’umutego w’ibikorwa vy’intoke zabo.<verse eid="PSA 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17" />Abanyakibi bamanuka baja ahantu h’abapfuye,</para>
  <para style="q2" vid="PSA 9:17">co kimwe n’amahanga yose yibagira Imana.<verse eid="PSA 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18" />Ariko Imana ntizokwibagira na rimwe abakene;</para>
  <para style="q2" vid="PSA 9:18">ivyizigiro vy’impahazwa ntibizokwigera bikurwaho.<verse eid="PSA 9:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19" />Haguruka, ewe <char style="nd">Uhoraho</char>, ntureke ngo abantu buntu baneshe;</para>
  <para style="q2" vid="PSA 9:19">amahanga nacirirwe urubanza imbere yawe.<verse eid="PSA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20" />Batere ubwoba, ewe <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 9:20">abanyamahanga nibamenye ko ari abantu buntu.<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="cl">Zaburi ya 10</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1" />Ni kuki wihagarariye kure, ewe <char style="nd">Uhoraho</char>?</para>
  <para style="q2" vid="PSA 10:1">Ni kuki winyegeza mu gihe c’ivyago?<verse eid="PSA 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2" />Umunyakibi mu bwibone bwiwe ahiga abanyantegenke,</para>
  <para style="q2" vid="PSA 10:2">abafashwe mu mitego yateze.<verse eid="PSA 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3" />Yirata ivyo yipfuza mu mutima wiwe;</para>
  <para style="q2" vid="PSA 10:3">ashima uwipfuza inyungu mbi agakengera <char style="nd">Uhoraho</char>.<verse eid="PSA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4" />Umunyakibi mu bwishime bwiwe ntarondera Imana;</para>
  <para style="q2" vid="PSA 10:4">mu vyiyumviro vyiwe nta kibanza afitiye <char style="nd">Uhoraho</char>.<verse eid="PSA 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5" />Ivyo akora vyose vyama bitera imbere;</para>
  <para style="q2" vid="PSA 10:5">atera akagere ivyagezwe vyawe;</para>
  <para style="q2" vid="PSA 10:5">abansi biwe abahuhisha impwemu ziwe.<verse eid="PSA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6" />Yibwira mu mutima wiwe ati: “Nta kintu na kimwe kizonyiganyiza.”</para>
  <para style="q2" vid="PSA 10:6">Arahira avuga ati: “Nta kibi kizonshikira.”<verse eid="PSA 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7" />Akanwa kiwe kuzuye imivumo, ibinyoma n’imihigo;</para>
  <para style="q2" vid="PSA 10:7">ivyago n’ibibi biri musi y’ururimi rwiwe.<verse eid="PSA 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8" />Abunda i ruhande y’imihana;</para>
  <para style="q2" vid="PSA 10:8">akavunduruka aho abunze yica umugororotsi.</para>
  <para style="q1" vid="PSA 10:8">Amaso yiwe arabira mu mpisho abo agomba kwica;<verse eid="PSA 10:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 10:9" />abunda afise ico ateze nk’intambwe.</para>
  <para style="q1" vid="PSA 10:9">Abundira gufata abatagira gitabara;</para>
  <para style="q2" vid="PSA 10:9">afata abatagira gitabara maze akabakwegera mu mutego wiwe.<verse eid="PSA 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10" />Abatagira gitabara baratemba, akabafyonyora;</para>
  <para style="q2" vid="PSA 10:10">bakagwa musi y’ububasha bwiwe.<verse eid="PSA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11" />Yibwira mu mutima wiwe ati: “Imana ntizobibona;</para>
  <para style="q2" vid="PSA 10:11">yipfutse mu nyonga zayo nta co yigera ibona.”<verse eid="PSA 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12" />Haguruka, <char style="nd">Uhoraho</char>! Ramvura ukuboko kwawe, ewe Mana.</para>
  <para style="q2" vid="PSA 10:12">Ntiwibagire abatagira gitabara.<verse eid="PSA 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13" />Ni kuki umunyakibi akengera Imana?</para>
  <para style="q2" vid="PSA 10:13">Ni kuki yibwira mu mutima ngo:</para>
  <para style="q2" vid="PSA 10:13">“Nta co izombaza?”<verse eid="PSA 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14" />Ariko wewe, Mana, raba ivyago vy’abari mu mubabaro;</para>
  <para style="q2" vid="PSA 10:14">witegereze uburibwe bwabo maze ivyabo uvyishinge.</para>
  <para style="q1" vid="PSA 10:14">Abagirirwa nabi barakwituye;</para>
  <para style="q2" vid="PSA 10:14">ni wewe utabara impfuvyi.<verse eid="PSA 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15" />Vuna ukuboko kw’umunyakibi;</para>
  <para style="q2" vid="PSA 10:15">hamagaza uwakoze nabi umuhanire ibibi yakoze</para>
  <para style="q2" vid="PSA 10:15">kugira ngo ntibisubire kuboneka.<verse eid="PSA 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16" />
    <char style="nd">Uhoraho</char> ni Umwami ibihe bitazoshira;</para>
  <para style="q2" vid="PSA 10:16">amahanga atamwubaha azohona mu gihugu ciwe.<verse eid="PSA 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17" />Wewe, <char style="nd">Uhoraho</char>, wumva ivyo impahazwa zifuza;</para>
  <para style="q2" vid="PSA 10:17">urabaremesha, ukumva ugutakamba kwabo,<verse eid="PSA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18" />ugutabara impfuvyi n’impahazwa,</para>
  <para style="q2" vid="PSA 10:18">kugira ngo abantu buntu</para>
  <para style="q2" vid="PSA 10:18">ntibasubire kubatera ubwoba.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="cl">Zaburi ya 11</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1" />
    <char style="nd">Uhoraho</char> ni we mpungirako.</para>
  <para style="q2" vid="PSA 11:1">None ni kuki mwombwira muti:</para>
  <para style="q2" vid="PSA 11:1">“Guruka uhungire ku musozi nk’inyoni kugira ngo ukire!<verse eid="PSA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2" />Kuko raba abanyakibi bafoye imiheto yabo;</para>
  <para style="q2" vid="PSA 11:2">batumbereje imyampi yabo</para>
  <para style="q1" vid="PSA 11:2">ngo barasire mu mwijima</para>
  <para style="q2" vid="PSA 11:2">uwutunganye mu mutima.<verse eid="PSA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3" />Nimba amatanguriro asambuwe,</para>
  <para style="q2" vid="PSA 11:3">mbega umugororotsi yokora iki?”<verse eid="PSA 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4" />
    <char style="nd">Uhoraho</char> ari mu Ngoro yiwe yera;</para>
  <para style="q2" vid="PSA 11:4">
    <char style="nd">Uhoraho</char> avyagiye ku ntebe yiwe y’ubwami yo mw’ijuru.</para>
  <para style="q1" vid="PSA 11:4">Araba abantu bose bari mw’isi;</para>
  <para style="q2" vid="PSA 11:4">inyonga ziwe zirabagenzura.<verse eid="PSA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5" />
    <char style="nd">Uhoraho</char> agenzura abagororotsi,</para>
  <para style="q2" vid="PSA 11:5">ariko abanyakibi, bamwe bakunda umuryano,</para>
  <para style="q2" vid="PSA 11:5">abanka urunuka.<verse eid="PSA 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6" />Abanyakibi azobacukumburirako</para>
  <para style="q2" vid="PSA 11:6">amakara arurumba n’amazuku yaka umuriro;</para>
  <para style="q2" vid="PSA 11:6">umuyaga uturira ni wo uzoba umugabane wabo.<verse eid="PSA 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7" />Kuko <char style="nd">Uhoraho</char> agororotse,</para>
  <para style="q2" vid="PSA 11:7">akunda ubutungane;</para>
  <para style="q2" vid="PSA 11:7">abatunganye bazobona mu nyonga hiwe.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="cl">Zaburi ya 12</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni Sheminite.<note caller="+" style="f"><char style="fr" closed="false">12:0 </char><char style="ft" closed="false">Ijambo </char><char style="fq" closed="false">Sheminite </char><char style="ft" closed="false">rishobora kuba risigura ubwoko bw’umudiho.</char></note> Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1" />Tabara, ewe <char style="nd">Uhoraho</char>, kuko ata mwizigirwa agisigaye;</para>
  <para style="q2" vid="PSA 12:1">abizigirwa baheze mu bantu.<verse eid="PSA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2" />Umuntu wese ahenda mugenziwe;</para>
  <para style="q2" vid="PSA 12:2">bahendanisha iminwa yabo</para>
  <para style="q2" vid="PSA 12:2">ariko imitima yabo yuzuye ubugunge.<verse eid="PSA 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3" />Icompa <char style="nd">Uhoraho</char> akazibiza iminwa ihendana</para>
  <para style="q2" vid="PSA 12:3">n’ururimi rwose rwishira hejuru.<verse eid="PSA 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4" />Bavuga bati:</para>
  <para style="q2" vid="PSA 12:4">“Tuzotsinda ku bw’indimi zacu;</para>
  <para style="q2" vid="PSA 12:4">iminwa yacu ubwacu ni yo izotuburanira; ni nde atuganza?”<verse eid="PSA 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5" />Ariko <char style="nd">Uhoraho</char> avuze ati:</para>
  <para style="q2" vid="PSA 12:5">“Kubera abakene banyazwe ivyabo n’abagorwa baniha,</para>
  <para style="q2" vid="PSA 12:5">ngira mve hasi ndabakize ababasuzugura.”<verse eid="PSA 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6" />Kandi amajambo y’<char style="nd">Uhoraho</char> ni ay’ukuri,</para>
  <para style="q2" vid="PSA 12:6">nk’ifeza zavugutiwe mu ruganda,</para>
  <para style="q2" vid="PSA 12:6">nk’inzahabu zavugutiwe incuro indwi.<verse eid="PSA 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7" />Ewe, <char style="nd">Uhoraho</char>, uzozigama umugorwa amahoro,</para>
  <para style="q2" vid="PSA 12:7">kandi uzoturinda umunyakibi ibihe vyose.<verse eid="PSA 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8" />Abantu nk’abo bigenza ahantu hose</para>
  <para style="q2" vid="PSA 12:8">iyo ikibi cahawe intebe mu bantu.<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="cl">Zaburi ya 13</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1" />Uzogeza ryari, ewe <char style="nd">Uhoraho</char>? Mbega uzonyibagira ibihe bidashira?</para>
  <para style="q2" vid="PSA 13:1">Uzogeza ryari kumpisha mu nyonga hawe?<verse eid="PSA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2" />Nzogeza ryari kwama ngwana n’ivyiyumviro vyanje</para>
  <para style="q2" vid="PSA 13:2">no kwama mfise umubabaro wo mu mutima ku musi ku musi?</para>
  <para style="q2" vid="PSA 13:2">Umwansi wanje azogeza ryari kunyitamba ku muvyimba?<verse eid="PSA 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3" />Ndaba maze unyishure, ewe <char style="nd">Uhoraho</char> Mana yanje.</para>
  <para style="q2" vid="PSA 13:3">Umurikire amaso yanje, kugira ngo sinsinzirire mu rupfu,<verse eid="PSA 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4" />maze umwansi wanje akavuga ati: “Ndamunesheje,”</para>
  <para style="q2" vid="PSA 13:4">abangwanya bakanezerezwa n’uko ntevye.<verse eid="PSA 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5" />Ariko nizigiye urukundo rwawe rudashira;</para>
  <para style="q2" vid="PSA 13:5">umutima wanje unezerererwa agakiza kawe.<verse eid="PSA 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6" />Nzoririmba ishimwe ry’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 13:6">kuko yangiriye neza.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="cl">Zaburi ya 14</para>
  <para style="d">Yahawe umukuru w’abaririmvyi: ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1" />Igipfu cibwira mu mutima kiti:</para>
  <para style="q2" vid="PSA 14:1">“Nta Mana iriho.”</para>
  <para style="q1" vid="PSA 14:1">Abantu nk’abo barononekaye, ibikorwa vyabo biteye isoni,</para>
  <para style="q2" vid="PSA 14:1">nta n’umwe muri bo akora ivyiza.<verse eid="PSA 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2" />
    <char style="nd">Uhoraho</char> arunguruka ari mw’ijuru</para>
  <para style="q2" vid="PSA 14:2">akitegereza abana b’abantu</para>
  <para style="q1" vid="PSA 14:2">ngo arabe ko hari n’umwe atahura,</para>
  <para style="q2" vid="PSA 14:2">canke ko hari n’umwe arondera Imana.<verse eid="PSA 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3" />Bose barazimiye, bose barononekaye;</para>
  <para style="q2" vid="PSA 14:3">nta wukora ivyiza,</para>
  <para style="q2" vid="PSA 14:3">eka nta n’umwe.<verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4" />Mbega abo bantu b’inkozi z’ikibi bose nta co bazi?</para>
  <para style="b" vid="PSA 14:4" />
  <para style="q1" vid="PSA 14:4">Barya abantu banje nk’abarya umutsima;</para>
  <para style="q2" vid="PSA 14:4">ntibigera bambaza <char style="nd">Uhoraho</char>.<verse eid="PSA 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5" />Ariko aho nyene ni ho ubwoba bubafatiye,</para>
  <para style="q2" vid="PSA 14:5">kuko Imana iri mw’ikoraniro ry’abagororotsi.<verse eid="PSA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6" />Mwebwe abakora ibibi mwica imigambi y’abakene,</para>
  <para style="q2" vid="PSA 14:6">ariko <char style="nd">Uhoraho</char> ni ubuhungiro bwabo.<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7" />Ese icompa agakiza ka Isirayeli kakaza kavuye i Siyoni!</para>
  <para style="q2" vid="PSA 14:7">Aho <char style="nd">Uhoraho</char> azosubirira guhezagira abantu biwe;</para>
  <para style="q2" vid="PSA 14:7">aba Yakobo baze banezerwe, Abisirayeli bahimbarwe!<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="cl">Zaburi ya 15</para>
  <para style="d">Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1" />
    <char style="nd">Uhoraho</char>, ni nde azoba mw’ihema ryawe ryera?</para>
  <para style="q2" vid="PSA 15:1">Ni nde ashobora kuba ku musozi wawe wera?<verse eid="PSA 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2" />Ni uwutagira umugayo mu buzima bwiwe,</para>
  <para style="q2" vid="PSA 15:2">akora ibigororotse,</para>
  <para style="q2" vid="PSA 15:2">akavuga ukuri kuvuye mu mutima;<verse eid="PSA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3" />ururimi rwiwe ntiruvuge nabi abandi,</para>
  <para style="q2" vid="PSA 15:3">ntagirire nabi mugenziwe,</para>
  <para style="q2" vid="PSA 15:3">ntavuge ibibi ku bandi.<verse eid="PSA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4" />Akengera abakora ibibi</para>
  <para style="q2" vid="PSA 15:4">ariko akubaha abubaha <char style="nd">Uhoraho</char>.</para>
  <para style="q1" vid="PSA 15:4">Yubahiriza ico yarahiye naho comugirira nabi,</para>
  <para style="q2" vid="PSA 15:4">ntiyihindukize mw’ijambo;<verse eid="PSA 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5" />agurana abakene atiteze inyungu;</para>
  <para style="q2" vid="PSA 15:5">ntiyemera igiturire ngo arenganye uwuri mu kuri.</para>
  <para style="b" vid="PSA 15:5" />
  <para style="q1" vid="PSA 15:5">Uwukora ivyo</para>
  <para style="q2" vid="PSA 15:5">ntazokwigera anyiganyizwa.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="cl">Zaburi ya 16</para>
  <para style="d">Mikitamu<note caller="+" style="f"><char style="fr" closed="false">16:0 </char><char style="ft" closed="false">Ijambo </char><char style="fq" closed="false">Mikitamu </char><char style="ft" closed="false">rishobora kuba risigura ubwoko bw’icese canke bw’umudiho.</char></note> ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1" />Unzigame, Mana yanje,</para>
  <para style="q2" vid="PSA 16:1">kuko nguhungiyeko.<verse eid="PSA 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2" />Ndabwira <char style="nd">Uhoraho</char> nti: “Uri Umwami wanje;</para>
  <para style="q2" vid="PSA 16:2">nta ciza mfise atari wewe.”<verse eid="PSA 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3" />Ndavuga ku bera bari mu gihugu nti:</para>
  <para style="q2" vid="PSA 16:3">“Ni bo ntore nezerererwa.”<verse eid="PSA 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4" />Abahurumbira izindi mana bazokwama bababazwa.</para>
  <para style="q2" vid="PSA 16:4">Sinzoshikanira ishikanwa ry’amaraso imana nk’izo</para>
  <para style="q2" vid="PSA 16:4">canke ngo ncishe no mu kanwa kanje amazina yazo.<verse eid="PSA 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5" />
    <char style="nd">Uhoraho</char>, ni wewe wenyene mugabane wanje n’igikombe canje;</para>
  <para style="q2" vid="PSA 16:5">ubuzima bwanje buzigamiwe mu kuboko kwawe.<verse eid="PSA 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6" />Urubibe rwanje ruca mu bibanza biteye igomwe;</para>
  <para style="q2" vid="PSA 16:6">ni ukuri naronse umugabane mwiza.<verse eid="PSA 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7" />Nzohimbaza <char style="nd">Uhoraho</char>, we mujenama wanje;</para>
  <para style="q2" vid="PSA 16:7">no mw’ijoro umutima wanje uranyigisha.<verse eid="PSA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8" />Amaso yanje ndayahanga <char style="nd">Uhoraho</char> imisi yose.</para>
  <para style="q2" vid="PSA 16:8">Ko ari i buryo bwanje, sinzonyiganyizwa.<verse eid="PSA 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9" />Ni co gituma umutima wanje unezerewe, ururimi rwanje rugahimbarwa;</para>
  <para style="q2" vid="PSA 16:9">n’umubiri wanje ukaruhukana ivyizigiro,<verse eid="PSA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10" />kuko utazondekera i kuzimu mu kibanza c’abapfuye,</para>
  <para style="q2" vid="PSA 16:10">kandi ntuzokwemera ko uwera wawe abora.<verse eid="PSA 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11" />Umenyesha inzira y’ubugingo;</para>
  <para style="q2" vid="PSA 16:11">uzonyuzuza umunezero ndi imbere yawe,</para>
  <para style="q2" vid="PSA 16:11">n’agahimbare kadashira ndi i buryo bwawe.<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="cl">Zaburi ya 17</para>
  <para style="d">Ni isengesho rya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1" />Nyumviriza, ewe <char style="nd">Uhoraho</char>, kuko ukwinginga kwanje ari ukw’ukuri;</para>
  <para style="q2" vid="PSA 17:1">niwumve ukurira kwanje.</para>
  <para style="q1" vid="PSA 17:1">Niwumve ugusenga kwanje;</para>
  <para style="q2" vid="PSA 17:1">ntikuva mu minwa y’ibinyoma.<verse eid="PSA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2" />Intsinzi yanje nive iwawe;</para>
  <para style="q2" vid="PSA 17:2">inyonga zawe nizirabe ibibereye.<verse eid="PSA 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3" />Naho worondera mu mutima wanje,</para>
  <para style="q2" vid="PSA 17:3">naho wonsesa mw’ijoro ukangeza,</para>
  <para style="q1" vid="PSA 17:3">uzosanga ata kibi nateguye gukora;</para>
  <para style="q2" vid="PSA 17:3">n’akanwa kanje katagabitanije.<verse eid="PSA 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4" />Ku bijanye n’ibikorwa vy’abantu,</para>
  <para style="q2" vid="PSA 17:4">ku bw’ijambo ryo mu kanwa kawe,</para>
  <para style="q2" vid="PSA 17:4">naririnze inzira z’abahohotera abandi.<verse eid="PSA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5" />Intambuko zanje zagumye mu nzira zawe;</para>
  <para style="q2" vid="PSA 17:5">ibirenge vyanje ntivyatirimutse.<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6" />Ndakwambaje, Mana yanje, kuko uzonyishura;</para>
  <para style="q2" vid="PSA 17:6">ntega ugutwi wumve ugusenga kwanje.<verse eid="PSA 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7" />Unyereke ibitangaza vy’urukundo rwawe rwinshi,</para>
  <para style="q2" vid="PSA 17:7">wewe ukirisha ukuboko kwawe kw’i buryo</para>
  <para style="q2" vid="PSA 17:7">abahungira abansi babo muri wewe.<verse eid="PSA 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8" />Undinde nk’imbone y’ijisho ryawe;</para>
  <para style="q2" vid="PSA 17:8">umpishe mu gitutu c’amababa yawe.<verse eid="PSA 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9" />Undinde abanyakibi barondera kunyica,</para>
  <para style="q2" vid="PSA 17:9">abansi banje b’abicanyi bankikuje.<verse eid="PSA 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10" />Bugaye imitima yabo itagira ikigongwe,</para>
  <para style="q2" vid="PSA 17:10">n’iminwa yabo ivugana ubwibone.<verse eid="PSA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11" />Barampize, none ehe raba barankikuje,</para>
  <para style="q2" vid="PSA 17:11">barangenza ngo bantsinde hasi.<verse eid="PSA 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12" />Bameze nk’intambwe ishonje irondera ico yica,</para>
  <para style="q2" vid="PSA 17:12">nk’intambwe ikiri nto iteze ahantu hihishije.<verse eid="PSA 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13" />Va hasi, <char style="nd">Uhoraho</char>, ubagwanye, ubatsinde hasi;</para>
  <para style="q2" vid="PSA 17:13">unkirishe inkota yawe ababisha.<verse eid="PSA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14" />Nkirisha ukuboko kwawe abameze batyo, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 17:14">nkiza abantu bo mw’isi baziga impera muri ubu bugingo.</para>
  <para style="q1" vid="PSA 17:14">Ivyo wabikiye abanyakibi nivyuzure inda zabo;</para>
  <para style="q2" vid="PSA 17:14">n’abana babo babiryeko bahage,</para>
  <para style="q2" vid="PSA 17:14">kandi hasigare vyinshi bazoraga abuzukuru babo.<verse eid="PSA 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15" />Ariko jeho, uzontsindira kandi nzobona mu nyonga hawe;</para>
  <para style="q2" vid="PSA 17:15">ninikangura, nzohazwa no kukubona imbonankubone.<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="cl">Zaburi ya 18</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni Zaburi ya Dawidi umusavyi w’<char style="nd">Uhoraho</char>, iyo yaririmbiye <char style="nd">Uhoraho</char> muri aya majambo amaze kumukiza abansi biwe bose, no kumukura mu maboko ya Sawuli. Yavuze ati:</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1" />Ndagukunda, <char style="nd">Uhoraho</char>, uri inkomezi zanje.<verse eid="PSA 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2" />
    <char style="nd">Uhoraho</char> ni we gitandara canje, igihome canje kinkingira n’umutabazi wanje;</para>
  <para style="q2" vid="PSA 18:2">Imana yanje ni igitandara canje nihishamwo,</para>
  <para style="q2" vid="PSA 18:2">inkinzo yanje, n’ihembe ry’agakiza kanje, n’umunara mpungiramwo.<verse eid="PSA 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3" />Nambaje <char style="nd">Uhoraho</char>, we abereye gushimwa,</para>
  <para style="q2" vid="PSA 18:3">na we ankiza abansi banje.<verse eid="PSA 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4" />Iminyororo y’urupfu yaranyiboheyeko;</para>
  <para style="q2" vid="PSA 18:4">imikuba y’ukurandura yarandengeye.<verse eid="PSA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5" />Iminyororo y’i kuzimu yaranyizingiriyeko;</para>
  <para style="q2" vid="PSA 18:5">imitego y’urupfu yarantangiriye.<verse eid="PSA 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6" />Mu mubabaro wanje nambaje <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 18:6">natakambiye Imana yanje ngo intabare.</para>
  <para style="q1" vid="PSA 18:6">Iri mu Ngoro yayo yumvise ijwi ryanje;</para>
  <para style="q2" vid="PSA 18:6">ugutakamba kwanje kwashitse imbere yayo, mu matwi yayo.<verse eid="PSA 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7" />Isi yaratigise ihinda agashitsi,</para>
  <para style="q2" vid="PSA 18:7">amatanguriro y’imisozi aranyiganyiga;</para>
  <para style="q2" vid="PSA 18:7">yahinze agashitsi kuko <char style="nd">Uhoraho</char> yari yaratse.<verse eid="PSA 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8" />Umwotsi wapfunduka mu mazuru yiwe;</para>
  <para style="q2" vid="PSA 18:8">umuriro utongora wava mu kanwa kiwe,</para>
  <para style="q2" vid="PSA 18:8">hamwe n’amakara yaka.<verse eid="PSA 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9" />Yamenye ijuru aramanuka;</para>
  <para style="q2" vid="PSA 18:9">ibicu vyirabura vyari musi y’ibirenge vyiwe.<verse eid="PSA 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10" />Yaje aguruka ku mukerubi;</para>
  <para style="q2" vid="PSA 18:10">yagendera ku mababa y’umuyaga.<verse eid="PSA 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11" />Yisakaye umwijima awugira nk’ihema rimukikuje;</para>
  <para style="q2" vid="PSA 18:11">ibicu vyirabura vyo kw’ijuru vyuzuye imvura.<verse eid="PSA 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12" />Mu gukayangana kwo mu nyonga hiwe,</para>
  <para style="q2" vid="PSA 18:12">havamwo ibicu vy’imvura y’urubura n’ibikeke vy’imiravyo.<verse eid="PSA 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13" />
    <char style="nd">Uhoraho</char> yaraturagaye ari mw’ijuru;</para>
  <para style="q2" vid="PSA 18:13">ijwi ry’Iyisumbavyose ryarasamiranye.<verse eid="PSA 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14" />Yarashe imyampi yiwe asanzaza abansi,</para>
  <para style="q2" vid="PSA 18:14">yasohoye ibikeke vy’imiravyo birabakinagiza.<verse eid="PSA 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15" />Ibiyaya vyo mu kiyaga vyagiye ahabona</para>
  <para style="q2" vid="PSA 18:15">n’amatanguriro y’isi aragaragara</para>
  <para style="q1" vid="PSA 18:15">ku bw’ugukankama kwawe, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 18:15">no ku bw’impwemu ziva mu mazuru yawe.<verse eid="PSA 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16" />Yagoroye ukuboko kwiwe ari iyo hejuru aramfata;</para>
  <para style="q2" vid="PSA 18:16">ankura mu mazi menshi.<verse eid="PSA 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17" />Yantabaye umwansi wanje akomeye,</para>
  <para style="q2" vid="PSA 18:17">ankiza abanyanka bandusha inkomezi.<verse eid="PSA 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18" />Banteye ku musi w’ivyago vyanje,</para>
  <para style="q2" vid="PSA 18:18">ariko <char style="nd">Uhoraho</char> ni we yanshigikiye.<verse eid="PSA 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19" />Yaransohoye anjana ahagutse;</para>
  <para style="q2" vid="PSA 18:19">arankiza kuko yanezererewe.<verse eid="PSA 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20" />
    <char style="nd">Uhoraho</char> yankoreye ibihwanye n’ukugororoka kwanje;</para>
  <para style="q2" vid="PSA 18:20">yampaye ingero ikwiranye n’ugutungana kw’amaboko yanje.<verse eid="PSA 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21" />Kuko nagumye mu nzira z’<char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 18:21">sinigeze ncumura ngo mve ku Mana yanje.<verse eid="PSA 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22" />Ivyagezwe vyiwe vyose biri imbere yanje;</para>
  <para style="q2" vid="PSA 18:22">sinigeze mpindukira ngo mve mu vyo yihanikirije.<verse eid="PSA 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23" />Namye ntagira umugayo imbere yiwe</para>
  <para style="q2" vid="PSA 18:23">kandi nirinze icaha.<verse eid="PSA 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24" />
    <char style="nd">Uhoraho</char> yanyishuye ibikwiranye n’ukugororoka kwanje,</para>
  <para style="q2" vid="PSA 18:24">ibihwanye n’ugutungana kwanje mu nyonga hiwe.<verse eid="PSA 18:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25" />Ku mwizigirwa wiyerekana uri umwizigirwa,</para>
  <para style="q2" vid="PSA 18:25">ku wutagira umugayo wiyerekana uri uwutagira umugayo,<verse eid="PSA 18:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26" />ku wutunganye wiyerekana uri uwutunganye,</para>
  <para style="q2" vid="PSA 18:26">ariko ku muntu w’intabarirwa wiyerekana nk’uwutagira akagongwe.<verse eid="PSA 18:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27" />Ukiza abaciye bugufi</para>
  <para style="q2" vid="PSA 18:27">ariko ucisha bugufi abafise amaso y’ubwibone.<verse eid="PSA 18:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28" />Ni wewe, <char style="nd">Uhoraho</char>, ugumiza itara ryanje ryaka;</para>
  <para style="q2" vid="PSA 18:28">Imana yanje ihindura umwijima wanje ukaba umuco.<verse eid="PSA 18:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29" />Ku bwawe, nshobora gutera ingabo nyinshi;</para>
  <para style="q2" vid="PSA 18:29">turi kumwe n’Imana yanje, nshobora kwurira uruzitiro.<verse eid="PSA 18:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30" />Imana yo, inzira yayo iratunganye:</para>
  <para style="q2" vid="PSA 18:30">ijambo ry’<char style="nd">Uhoraho</char> ni iry’ukuri;</para>
  <para style="q2" vid="PSA 18:30">abera inkinzo abamuhungirako bose.<verse eid="PSA 18:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31" />None ni nde Mana atari <char style="nd">Uhoraho</char>?</para>
  <para style="q2" vid="PSA 18:31">Kandi ni nde Gitandara atari Imana yacu?<verse eid="PSA 18:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32" />Imana ni yo inyambika inkomezi</para>
  <para style="q2" vid="PSA 18:32">ikagorora inzira yanje.<verse eid="PSA 18:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33" />Ihindura ibirenge vyanje nk’ivy’impongo;</para>
  <para style="q2" vid="PSA 18:33">ikanshoboza guhagarara ku dutwe tw’imisozi.<verse eid="PSA 18:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34" />Yigisha iminwe yanje kugwana;</para>
  <para style="q2" vid="PSA 18:34">agashoboza amaboko yanje gufora umuheto w’umwakaka.<verse eid="PSA 18:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35" />Agakiza kawe kabaye inkinzo yanje,</para>
  <para style="q2" vid="PSA 18:35">kandi ukuboko kwawe kw’i buryo ni kwo kunshigikiye;</para>
  <para style="q2" vid="PSA 18:35">ubushobozi bwawe ni bwo bwangize uwuhambaye.<verse eid="PSA 18:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36" />Wanteguriye inzira ncamwo yagutse,</para>
  <para style="q2" vid="PSA 18:36">kugira ngo ibirenge vyanje ntibinyerere.<verse eid="PSA 18:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37" />Nakurikiye abansi banje kandi ndabashikira;</para>
  <para style="q2" vid="PSA 18:37">sinasubiye inyuma badaherengeteye.<verse eid="PSA 18:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38" />Nabagize ubunywenywe nta n’uwushobora kuvyura umutwe;</para>
  <para style="q2" vid="PSA 18:38">baguye musi y’ibirenge vyanje.<verse eid="PSA 18:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39" />Wanyambitse inkomezi zo kugwana;</para>
  <para style="q2" vid="PSA 18:39">wacishije bugufi abansi banje imbere yanje.<verse eid="PSA 18:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40" />Watumye abansi banje bata barahunga,</para>
  <para style="q2" vid="PSA 18:40">kandi wampaye kubaherengeteza.<verse eid="PSA 18:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41" />Baratakamvye, habura uwubakiza;</para>
  <para style="q2" vid="PSA 18:41">batakambiye <char style="nd">Uhoraho</char>, ariko ntiyabishura.<verse eid="PSA 18:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42" />Maze ndabasya nk’umukungugu utumurwa n’umuyaga;</para>
  <para style="q2" vid="PSA 18:42">ndabasiribanga nk’ivyondo mu nzira y’abahita.<verse eid="PSA 18:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43" />Wankijije ibitero vy’abantu;</para>
  <para style="q2" vid="PSA 18:43">umpindura uwutwara amahanga.</para>
  <para style="q1" vid="PSA 18:43">Abantu ntigeze kumenya ubu ni bo bankorera,<verse eid="PSA 18:43" /></para>
  <para style="q2">
    <verse number="44" style="v" sid="PSA 18:44" />uko bumvise ijwi ryanje, baranyumvira;</para>
  <para style="q2" vid="PSA 18:44">abanyamahanga baranyunamira.<verse eid="PSA 18:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45" />Bose bacika intege;</para>
  <para style="q2" vid="PSA 18:45">bava aho bari binyegeje bahinda agashitsi.<verse eid="PSA 18:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46" />
    <char style="nd">Uhoraho</char> ni muzima! Hahimbazwe igitandara canje!</para>
  <para style="q2" vid="PSA 18:46">Hashirwe hejuru Imana y’agakiza kanje!<verse eid="PSA 18:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47" />Ni we Mana imporera,</para>
  <para style="q2" vid="PSA 18:47">igashira amahanga musi yanje,<verse eid="PSA 18:47" /></para>
  <para style="q2">
    <verse number="48" style="v" sid="PSA 18:48" />inkiza abansi banje.</para>
  <para style="q1" vid="PSA 18:48">Wanshize hejuru y’abangwanya;</para>
  <para style="q2" vid="PSA 18:48">untabara abantu b’inkozi z’ikibi.<verse eid="PSA 18:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49" />Ni co gituma nzoguhimbaza mu mahanga, ewe <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 18:49">nzotazira izina ryawe.<verse eid="PSA 18:49" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50" />Ni we aha umwami wiwe intsinzi zihambaye;</para>
  <para style="q2" vid="PSA 18:50">yerekanye urukundo rudashira ku wo yarobanuje amavuta,</para>
  <para style="q2" vid="PSA 18:50">ari we Dawidi n’uruvyaro rwiwe.<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="cl">Zaburi ya 19</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1" />Amajuru yamamaza ubwiza bw’Imana;</para>
  <para style="q2" vid="PSA 19:1">ibirere bimenyesha igikorwa c’intoke ziwe.<verse eid="PSA 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2" />Umurango ubibwira uwundi murango;</para>
  <para style="q2" vid="PSA 19:2">ijoro rikabimenyesha irindi joro.<verse eid="PSA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3" />Ntibisohora ijwi canke amajambo;</para>
  <para style="q2" vid="PSA 19:3">nta jwi ryavyo ryumvikana.<verse eid="PSA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4" />Ariko inkuru yavyo yumvikanye mw’isi yose;</para>
  <para style="q2" vid="PSA 19:4">kandi ivyo vyavuze vyashitse ku mpera z’isi.</para>
  <para style="q1" vid="PSA 19:4">Imana yashingiye ihema izuba iyo mw’ijuru.<verse eid="PSA 19:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 19:5" />Rimeze nk’umukwe asohotse ava mu cumba ciwe,</para>
  <para style="q2" vid="PSA 19:5">rimeze nka rurangiranwa mu kwiruka anezerererwa uguhiganwa kwiwe.<verse eid="PSA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6" />Riserukira ku mpera imwe y’ijuru</para>
  <para style="q2" vid="PSA 19:6">rikagenda urugendo rwaryo rija ku yindi mpera;</para>
  <para style="q2" vid="PSA 19:6">nta kintu na kimwe kidashikirwa n’ubushuhe bwaryo.<verse eid="PSA 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7" />Ivyagezwe vy’<char style="nd">Uhoraho</char> biratunganye,</para>
  <para style="q2" vid="PSA 19:7">bisubiza intege mu mutima.</para>
  <para style="q1" vid="PSA 19:7">Ivyo <char style="nd">Uhoraho</char> yageze ni ivyo kwizigirwa,</para>
  <para style="q2" vid="PSA 19:7">biha umunyabwengebuke ubwenge.<verse eid="PSA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8" />Ivyo <char style="nd">Uhoraho</char> yihanikirije ni ivyo kuri,</para>
  <para style="q2" vid="PSA 19:8">binezereza umutima.</para>
  <para style="q1" vid="PSA 19:8">Ivyo <char style="nd">Uhoraho</char> yashinze birakayangana,</para>
  <para style="q2" vid="PSA 19:8">bimurikira amaso.<verse eid="PSA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9" />Kwubaha <char style="nd">Uhoraho</char> biratunganye,</para>
  <para style="q2" vid="PSA 19:9">guhoraho ibihe vyose.</para>
  <para style="q1" vid="PSA 19:9">Ivyo <char style="nd">Uhoraho</char> yategetse birashikamye,</para>
  <para style="q2" vid="PSA 19:9">kandi vyose biragororotse.<verse eid="PSA 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10" />Bifise agaciro kurusha inzahabu,</para>
  <para style="q2" vid="PSA 19:10">kurusha inzahabu iramuye;</para>
  <para style="q1" vid="PSA 19:10">bisosa kurusha ubuki,</para>
  <para style="q2" vid="PSA 19:10">kurusha ubuki buvuye mu kimamara.<verse eid="PSA 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11" />Muri vyo ni ho umusavyi wawe aburirwa;</para>
  <para style="q2" vid="PSA 19:11">kuvyitondera bifise impera nyinshi.<verse eid="PSA 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12" />Ariko ni nde yoshobora kwimenyako amakosa?</para>
  <para style="q2" vid="PSA 19:12">Umparire ivyaha vyanyinyegeje.<verse eid="PSA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13" />Urinde kandi umusavyi wawe ivyaha vy’akagagazo;</para>
  <para style="q2" vid="PSA 19:13">ntibinganze.</para>
  <para style="q1" vid="PSA 19:13">Ni ho nzoba uwutagira umugayo,</para>
  <para style="q2" vid="PSA 19:13">ntagirizwa ukugabitanya guhambaye.<verse eid="PSA 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14" />Aya majambo yo mu kanwa kanje</para>
  <para style="q2" vid="PSA 19:14">n’uku kurimbura kw’umutima wanje</para>
  <para style="q2" vid="PSA 19:14">bibe ibihimbara mu nyonga zawe, <char style="nd">Uhoraho</char>, Gitandara canje, Mucunguzi wanje.<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="cl">Zaburi ya 20</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1" />
    <char style="nd">Uhoraho</char> akwishure ku musi w’amagorwa;</para>
  <para style="q2" vid="PSA 20:1">izina ry’Imana ya Yakobo rikurinde.<verse eid="PSA 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2" />Akurungikire ugutabarwa kuva ahera hiwe,</para>
  <para style="q2" vid="PSA 20:2">agushigikire ari i Siyoni.<verse eid="PSA 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3" />Niyibuke ibimazi vyawe,</para>
  <para style="q2" vid="PSA 20:3">yemere amashikanwa yawe yose.<verse eid="PSA 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4" />Aguhe ico umutima wawe ushaka</para>
  <para style="q2" vid="PSA 20:4">imigambi yawe yose ije mu ngiro.<verse eid="PSA 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5" />Tuze turirimbishwe n’umunezero niwanesha</para>
  <para style="q2" vid="PSA 20:5">tuduze amabendera yacu mw’izina ry’Imana yacu.</para>
  <para style="b" vid="PSA 20:5" />
  <para style="q1" vid="PSA 20:5">
    <char style="nd">Uhoraho</char> akwishure ivyo wamusavye vyose.<verse eid="PSA 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6" />Ubu ni ho nkimenya:</para>
  <para style="q2" vid="PSA 20:6">
    <char style="nd">Uhoraho</char> aha intsinzi uwo yarobanuje amavuta.</para>
  <para style="q1" vid="PSA 20:6">Amwishura ari ahera hiwe mw’ijuru</para>
  <para style="q2" vid="PSA 20:6">akamwishurisha inkomezi zo kunesha zo mu kuboko kwiwe kw’i buryo.<verse eid="PSA 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7" />Bamwe bishimira imikogote abandi bakishimira amafarasi yabo,</para>
  <para style="q2" vid="PSA 20:7">ariko tweho twizigira izina ry’<char style="nd">Uhoraho</char> Imana yacu.<verse eid="PSA 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8" />Bacishijwe bugufi baratemba,</para>
  <para style="q2" vid="PSA 20:8">ariko twebwe tuvuye hasi turashikama.<verse eid="PSA 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9" />
    <char style="nd">Uhoraho</char>, uhe umwami intsinzi!</para>
  <para style="q2" vid="PSA 20:9">Kandi utwishure nitwakwambaza!<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="cl">Zaburi ya 21</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1" />Umwami anezerererwa inkomezi zawe, ewe <char style="nd">Uhoraho</char>.</para>
  <para style="q2" vid="PSA 21:1">Ese ingene umunezero wiwe ari mwinshi ku bw’intsinzi nyinshi umuha!<verse eid="PSA 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2" />Wamuhaye ico umutima wiwe wipfuza</para>
  <para style="q2" vid="PSA 21:2">kandi ntiwamwimye ico iminwa yiwe yasavye.<verse eid="PSA 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3" />Waje kumuramutsa umuzaniye imigisha myinshi</para>
  <para style="q2" vid="PSA 21:3">kandi wamwambitse ku mutwe urugori rw’inzahabu iramuye.<verse eid="PSA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4" />Yagusavye ubuzima, na we urabumuha;</para>
  <para style="q2" vid="PSA 21:4">ni kwo kuramba kw’ibihe bidashira.<verse eid="PSA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5" />Ku bw’intsinzi nyishi wamuhaye, icubahiro ciwe cabaye cinshi;</para>
  <para style="q2" vid="PSA 21:5">wamushizeko ubwiza n’igitinyiro.<verse eid="PSA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6" />Ni ukuri wamuhaye imigisha idashira</para>
  <para style="q2" vid="PSA 21:6">kandi wamuhaye guhimbarirwa no kuba mu nyonga zawe.<verse eid="PSA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7" />Kuko umwami yizigira <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 21:7">ari mu rukundo rudashira rw’Iyisumbavyose,</para>
  <para style="q2" vid="PSA 21:7">ntazonyiganyizwa.<verse eid="PSA 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8" />Ukuboko kwawe kuzofata mpiri abansi bawe bose;</para>
  <para style="q2" vid="PSA 21:8">ukuboko kwawe kw’i buryo kuzocakira abansi bawe.<verse eid="PSA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9" />Niwaseruka mu rugamba,</para>
  <para style="q2" vid="PSA 21:9">uzobatongora bose nk’uwubaturira mw’itanure.</para>
  <para style="q1" vid="PSA 21:9">
    <char style="nd">Uhoraho</char> azobamira miyonzwa mu burake bwiwe,</para>
  <para style="q2" vid="PSA 21:9">kandi umuriro wiwe uzobatongora.<verse eid="PSA 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10" />Uzoherengeteza uruvyaro rwabo kw’isi,</para>
  <para style="q2" vid="PSA 21:10">ababakomokako bazokurwa mu bana b’abantu.<verse eid="PSA 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11" />Naho bakugirira inama mbi</para>
  <para style="q2" vid="PSA 21:11">bakagira imigambi mibi kuri wewe, nta co bazoshikako.<verse eid="PSA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12" />Uzotuma basubiza umugongo inyuma</para>
  <para style="q2" vid="PSA 21:12">niwabatumberezako umuheto wawe ufoye.<verse eid="PSA 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13" />Ushirwe hejuru mu nkomezi zawe, ewe <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 21:13">tuzoririmba dushima inkomezi zawe.<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="cl">Zaburi ya 22</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Iri mw’ijwi ryitwa “Ikime co mu Gatondo.” Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1" />Mana yanje, Mana yanje, ni kuki wampevye?</para>
  <para style="q2" vid="PSA 22:1">Ni kuki wangiye kure ngo ntuntabare,</para>
  <para style="q2" vid="PSA 22:1">ko wangiye kure ngo ntiwumve amajojwa yanje?<verse eid="PSA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2" />Mana yanje, ndagutakambira ku murango, ariko ntunyishure,</para>
  <para style="q2" vid="PSA 22:2">no mw’ijoro sintora agatiro.<verse eid="PSA 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3" />Ariko uri Uwera, uvyagiye ku ntebe y’ubwami;</para>
  <para style="q2" vid="PSA 22:3">uri mu mashimwe ya Isirayeli.<verse eid="PSA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4" />Ba sogokuruza barakwizigiye;</para>
  <para style="q2" vid="PSA 22:4">barakwizigiye urabatabara.<verse eid="PSA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5" />Baragutakambiye barakira;</para>
  <para style="q2" vid="PSA 22:5">barakwizigiye ntibamaramara.<verse eid="PSA 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6" />Ariko jeho ndi umusiba, sindi umuntu,</para>
  <para style="q2" vid="PSA 22:6">ncokorwa na bose, nankwa n’abantu.<verse eid="PSA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7" />Abambona bose baritwengera;</para>
  <para style="q2" vid="PSA 22:7">barantuka bakazunguza imitwe.<verse eid="PSA 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8" />“Baravuga bati: ‘Yizigiye <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 22:8">
    <char style="nd">Uhoraho</char> namukize.</para>
  <para style="q1" vid="PSA 22:8">Namutabare,</para>
  <para style="q2" vid="PSA 22:8">ko amunezerererwa.’ ”<verse eid="PSA 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9" />Ariko ni wewe wankuye mu nda ya mama,</para>
  <para style="q2" vid="PSA 22:9">wampaye kukwizigira no mu gihe nari kw’ibere rya mama.<verse eid="PSA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10" />Nashizwe mu maboko yawe kuva nkivuka;</para>
  <para style="q2" vid="PSA 22:10">kuva nkiri mu nda ya mama wamye uri Imana yanje.<verse eid="PSA 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11" />Ntumbe kure,</para>
  <para style="q2" vid="PSA 22:11">kuko amarushwa anyegereye</para>
  <para style="q2" vid="PSA 22:11">kandi ata wo kuntabara.<verse eid="PSA 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12" />Impfizi nyinshi zirankikije;</para>
  <para style="q2" vid="PSA 22:12">impfizi z’inkomezi z’i Bashani zintaye hagati.<verse eid="PSA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13" />Intambwe zitontoma zitabura ico zishe</para>
  <para style="q2" vid="PSA 22:13">ziranyasamiye ngo zimire.<verse eid="PSA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14" />Nsutswe hasi nk’amazi,</para>
  <para style="q2" vid="PSA 22:14">amagufa yanje aratanye.</para>
  <para style="q1" vid="PSA 22:14">Umutima wanje urashonze nk’ishashara;</para>
  <para style="q2" vid="PSA 22:14">ushongeye muri jewe.<verse eid="PSA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15" />Akanwa kanje karumye nk’inkono y’ibumba iturirwe,</para>
  <para style="q2" vid="PSA 22:15">n’ururimi rwanje rufatanye n’amagage;</para>
  <para style="q2" vid="PSA 22:15">undyamitse mu mukungugu w’urupfu.<verse eid="PSA 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16" />Imbwa zirankikije,</para>
  <para style="q2" vid="PSA 22:16">akarwi k’inkozi z’ibibi kantaye hagati.</para>
  <para style="q2" vid="PSA 22:16">Batoboye ibiganza vyanje n’ibirenge vyanje.<verse eid="PSA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17" />Amagufa yanje yose yanamye hejuru,</para>
  <para style="q2" vid="PSA 22:17">abansi banje na bo bihera ijisho.<verse eid="PSA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18" />Bagabuye impuzu zanje</para>
  <para style="q2" vid="PSA 22:18">bapfindira umutamana wanje.<verse eid="PSA 22:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19" />Ariko weho, <char style="nd">Uhoraho</char>, ntube kure yanje.</para>
  <para style="q2" vid="PSA 22:19">Uri inkomezi zanje; nyaruka untabare.<verse eid="PSA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20" />Nunkize inkota,</para>
  <para style="q2" vid="PSA 22:20">ubuzima bwanje bw’igiciro ubukize imbwa.<verse eid="PSA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21" />Nunkize unkure mu kanwa k’intambwe;</para>
  <para style="q2" vid="PSA 22:21">nunkize unkure mu mahembe y’imbogo.<verse eid="PSA 22:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22" />Nzokwamamaza izina ryawe mu bavukanyi banje;</para>
  <para style="q2" vid="PSA 22:22">nzoguhimbaza ikoraniro rikoranye.<verse eid="PSA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23" />Yemwe abubaha <char style="nd">Uhoraho</char>, nimumushime!</para>
  <para style="q2" vid="PSA 22:23">Yemwe aba Yakobo mwese, nimumuhe icubahiro!</para>
  <para style="q2" vid="PSA 22:23">Nimumwubahe mwese, yemwe bene Isirayeli!<verse eid="PSA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24" />Kuko atakengereye canke ngo acokore</para>
  <para style="q2" vid="PSA 22:24">umugorwa ari mu mubabaro;</para>
  <para style="q1" vid="PSA 22:24">ntiyamuhishije mu nyonga hiwe</para>
  <para style="q2" vid="PSA 22:24">ariko yumvise ugutakamba kwiwe.<verse eid="PSA 22:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25" />Ishimwe ryanje ndi mw’ikoraniro riva kuri wewe;</para>
  <para style="q2" vid="PSA 22:25">nzoshitsa ivyo narahiye ndi imbere y’abakwubaha.<verse eid="PSA 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26" />Umukene azorya ahage;</para>
  <para style="q2" vid="PSA 22:26">abarondera <char style="nd">Uhoraho</char> bazomushima;</para>
  <para style="q2" vid="PSA 22:26">imitima yanyu irakaramba ibihe vyose!<verse eid="PSA 22:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27" />Abo ku mpera z’isi bose</para>
  <para style="q2" vid="PSA 22:27">bazokwibuka bahindukirire <char style="nd">Uhoraho</char>,</para>
  <para style="q1" vid="PSA 22:27">n’imiryango yose yo mu mahanga</para>
  <para style="q2" vid="PSA 22:27">izokwunama imbere yiwe,<verse eid="PSA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28" />kuko kuganza ari ukw’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 22:28">kandi ni we ategeka amahanga.<verse eid="PSA 22:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29" />Abatunzi bose bo mw’isi bazogira umusi mukuru basenge;</para>
  <para style="q2" vid="PSA 22:29">abamanuka baja i kuzimu bazopfukama imbere yiwe;</para>
  <para style="q2" vid="PSA 22:29">abadashobora kwibeshaho ubwabo.<verse eid="PSA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30" />Abazobakomokako bazomukorera;</para>
  <para style="q2" vid="PSA 22:30">abo mu runganwe ruzoza bazobwirwa ivy’Imana.<verse eid="PSA 22:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31" />Bazokwamamaza ukugororoka kwiwe,</para>
  <para style="q2" vid="PSA 22:31">babwira abataravuka bati:</para>
  <para style="q2" vid="PSA 22:31">“Yarabikoze!”<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="cl">Zaburi ya 23</para>
  <para style="d">Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />
    <char style="nd">Uhoraho</char> ni we Mwungere wanje, nta co nkenye.<verse eid="PSA 23:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 23:2" />Ampa kuruhukira mu canya c’ubwatsi butotahaye,</para>
  <para style="q1" vid="PSA 23:2">andongorera i ruhande y’amazi adasuma,<verse eid="PSA 23:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 23:3" />asubiza intege mu mutima wanje.</para>
  <para style="q1" vid="PSA 23:3">Andongorera mu nzira z’ukuri,</para>
  <para style="q2" vid="PSA 23:3">kugira ngo aheshe icubahiro izina ryiwe.<verse eid="PSA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />Mbere naho noca mu mwonga w’umwijima w’urupfu,</para>
  <para style="q2" vid="PSA 23:4">sinzogira ikibi ntinya,</para>
  <para style="q1" vid="PSA 23:4">kuko uri kumwe nanje;</para>
  <para style="q2" vid="PSA 23:4">inkoni yawe n’ubuhiri bwawe</para>
  <para style="q1" vid="PSA 23:4">ni vyo binkingira bikampumuriza.<verse eid="PSA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />Untegurira umusi mukuru</para>
  <para style="q2" vid="PSA 23:5">mu maso y’abansi banje.</para>
  <para style="q1" vid="PSA 23:5">Unsuka amavuta ku mutwe;</para>
  <para style="q2" vid="PSA 23:5">igikombe canje kirasesekaye.<verse eid="PSA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />Ni ukuri ukugira neza kwawe n’urukundo rwawe bizonkurikirana</para>
  <para style="q2" vid="PSA 23:6">imisi yose y’ukubaho kwanje,</para>
  <para style="q1" vid="PSA 23:6">nanje nzoba mu Ngoro y’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 23:6">ibihe vyose.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="cl">Zaburi ya 24</para>
  <para style="d">Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1" />Isi ni iy’<char style="nd">Uhoraho</char>, n’ibiri muri yo vyose,</para>
  <para style="q2" vid="PSA 24:1">isi n’ababa muri yo bose;<verse eid="PSA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2" />kuko yashize amatanguriro yayo ku biyaga</para>
  <para style="q2" vid="PSA 24:2">akayishinga ku mazi menshi.<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3" />Ni nde azoduga umusozi w’<char style="nd">Uhoraho</char>?</para>
  <para style="q2" vid="PSA 24:3">Ni nde azohagarara ahera hiwe?<verse eid="PSA 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4" />Ni uwufise amaboko atanduye n’umutima utunganye,</para>
  <para style="q2" vid="PSA 24:4">atizigira ikigirwamana</para>
  <para style="q2" vid="PSA 24:4">canke ngo arahire imana z’ibinyoma.<verse eid="PSA 24:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5" />Uwo ni we azohabwa umugisha uva k’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 24:5">no kuburanirwa n’Imana Umukiza wiwe.<verse eid="PSA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6" />Urwo ni rwo runganwe rw’abamurondera,</para>
  <para style="q2" vid="PSA 24:6">bakarondera mu nyonga hawe, ewe Mana ya Yakobo.<verse eid="PSA 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7" />Nimwiyugurure, yemwe marembo;</para>
  <para style="q2" vid="PSA 24:7">nimwiyugurure, mwa nzugi z’ibihe vya kera,</para>
  <para style="q2" vid="PSA 24:7">kugira ngo Umwami w’ubwiza yinjire.<verse eid="PSA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8" />Uwo mwami w’ubwiza ni nde?</para>
  <para style="q2" vid="PSA 24:8">Ni <char style="nd">Uhoraho</char> umunyenkomezi kandi umunyabushobozi,</para>
  <para style="q2" vid="PSA 24:8">ni <char style="nd">Uhoraho</char> umuhizi mu ntambara.<verse eid="PSA 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9" />Nimwiyugurure, yemwe marembo;</para>
  <para style="q2" vid="PSA 24:9">nimwiyugurure, yemwe nzugi z’ibihe vya kera,</para>
  <para style="q2" vid="PSA 24:9">kugira ngo Umwami w’ubwiza yinjire.<verse eid="PSA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10" />Uwo Mwami w’ubwiza ni nde?</para>
  <para style="q2" vid="PSA 24:10">Ni <char style="nd">Uhoraho</char> Mushoboravyose;</para>
  <para style="q2" vid="PSA 24:10">ni we Mwami w’ubwiza.<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="cl">Zaburi ya 25</para>
  <para style="d">Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1" />Muri wewe, <char style="nd">Uhoraho</char> Mana yanje,</para>
  <para style="q2" vid="PSA 25:1">ni ho nshira ivyizigiro vyanje.<verse eid="PSA 25:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2" />Ndakwizigiye;</para>
  <para style="q2" vid="PSA 25:2">ntundeke ngo maramare,</para>
  <para style="q2" vid="PSA 25:2">ntureke ngo abansi banje baneshe.<verse eid="PSA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3" />Nta wukwizigiye</para>
  <para style="q2" vid="PSA 25:3">azokwigera amaramara,</para>
  <para style="q1" vid="PSA 25:3">ariko abahemuka ata nyanduruko</para>
  <para style="q2" vid="PSA 25:3">ni bo bazomaramara.<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4" />Nyereka inzira zawe, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 25:4">unyigishe kubaho uko ugomba.<verse eid="PSA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5" />Ndongorera mu kuri kwawe unyigishe,</para>
  <para style="q2" vid="PSA 25:5">kuko uri Imana Umukiza wanje,</para>
  <para style="q2" vid="PSA 25:5">kandi ni wewe nizigira bukarinda bwira.<verse eid="PSA 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6" />Niwibuke, <char style="nd">Uhoraho</char>, imbabazi zawe nyinshi n’urukundo rwawe,</para>
  <para style="q2" vid="PSA 25:6">kuko biriho uhereye kera hose.<verse eid="PSA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7" />Ntiwibuke ivyaha vyo mu buto bwanje</para>
  <para style="q2" vid="PSA 25:7">n’inzira zanje z’ubugarariji;</para>
  <para style="q1" vid="PSA 25:7">nyibuka ku bw’urukundo rwawe,</para>
  <para style="q2" vid="PSA 25:7">kuko wewe, <char style="nd">Uhoraho</char>, uri mwiza.<verse eid="PSA 25:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8" />
    <char style="nd">Uhoraho</char> ni mwiza aragororotse;</para>
  <para style="q2" vid="PSA 25:8">ni co gituma azokwigisha abanyavyaha inzira ziwe.<verse eid="PSA 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9" />Arongorera abaciye bugufi mu nzira itunganye</para>
  <para style="q2" vid="PSA 25:9">akabigisha ivy’inzira yiwe.<verse eid="PSA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10" />Inzira zose z’<char style="nd">Uhoraho</char> zerekana urukundo n’ubwizigirwa</para>
  <para style="q2" vid="PSA 25:10">ku bitondera ivyo yihanikirije mw’isezerano ryiwe.<verse eid="PSA 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11" />
    <char style="nd">Uhoraho</char>, ku bw’izina ryawe,</para>
  <para style="q2" vid="PSA 25:11">mparira ukugabitanya kwanje, naho ari ugukomeye.<verse eid="PSA 25:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12" />None, ni ba nde bubaha <char style="nd">Uhoraho</char>?</para>
  <para style="q2" vid="PSA 25:12">Azobereka inzira bakwiye kujana.<verse eid="PSA 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13" />Bazomara imisi yabo bari mu buhirwe,</para>
  <para style="q2" vid="PSA 25:13">kandi uruvyaro rwabo ruzoragwa igihugu.<verse eid="PSA 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14" />
    <char style="nd">Uhoraho</char> abwira ibanga ryiwe abamwubaha;</para>
  <para style="q2" vid="PSA 25:14">akabamenyesha isezerano ryiwe.<verse eid="PSA 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15" />Amaso yanje ndayahanga <char style="nd">Uhoraho</char> ibihe vyose,</para>
  <para style="q2" vid="PSA 25:15">kuko ari we wenyene azokura ibirenge vyanje mu mutego.<verse eid="PSA 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16" />Hindukira ungirire ubuntu,</para>
  <para style="q2" vid="PSA 25:16">kuko ndi inyakamwe nkaba ndi mu mubabaro.<verse eid="PSA 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17" />Kuraho amarushwa yo mu mutima wanje,</para>
  <para style="q2" vid="PSA 25:17">unkure mu mubabaro.<verse eid="PSA 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18" />Raba umubabaro wanje n’amarushwa yanje</para>
  <para style="q2" vid="PSA 25:18">kandi unkureko ivyaha vyanje vyose.<verse eid="PSA 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19" />Raba ingene abansi banje ari benshi</para>
  <para style="q2" vid="PSA 25:19">n’ukuntu banyanka urunuka!<verse eid="PSA 25:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20" />Zigama ubugingo bwanje unkize;</para>
  <para style="q2" vid="PSA 25:20">ntundeke ngo maramare,</para>
  <para style="q2" vid="PSA 25:20">kuko nguhungiyeko.<verse eid="PSA 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21" />Ugutungana n’ubugororotsi nibinzigame,</para>
  <para style="q2" vid="PSA 25:21">kuko ivyizigiro vyanje biri muri wewe, <char style="nd">Uhoraho</char>.<verse eid="PSA 25:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22" />Rokora Isirayeli, ewe Mana,</para>
  <para style="q2" vid="PSA 25:22">ubakure mu marushwa yabo yose!<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="cl">Zaburi ya 26</para>
  <para style="d">Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1" />Ncira urubanza runkiza, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 26:1">kuko nabayeho ntagira umugayo;</para>
  <para style="q1" vid="PSA 26:1">nizigiye <char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 26:1">kandi sinanyiganyize.<verse eid="PSA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2" />Nunsese, ewe <char style="nd">Uhoraho</char>, nungeze,</para>
  <para style="q2" vid="PSA 26:2">suzuma umutima wanje n’ivyiyumviro vyanje;<verse eid="PSA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3" />Kuko namye nitwararika urukundo rwawe rudashira</para>
  <para style="q2" vid="PSA 26:3">kandi nagenda nisunga ubwizigirwa bwawe.<verse eid="PSA 26:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4" />Sinicarana n’ababeshi,</para>
  <para style="q2" vid="PSA 26:4">canke ngo nifatanye n’indyadya.<verse eid="PSA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5" />Nanka ikoraniro ry’inkozi z’ibibi</para>
  <para style="q2" vid="PSA 26:5">no kwicarana n’inkorabara.<verse eid="PSA 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6" />Nkaraba ibiganza vyanje nerekana ko ata co niyagiriza,</para>
  <para style="q2" vid="PSA 26:6">kandi nzunguruka igicaniro cawe, ewe <char style="nd">Uhoraho</char>,<verse eid="PSA 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7" />ndirimba ishimwe ryawe</para>
  <para style="q2" vid="PSA 26:7">mvuga ibitangaza vyose wakoze.<verse eid="PSA 26:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8" />
    <char style="nd">Uhoraho</char> we, ndakunda Ingoro ubamwo,</para>
  <para style="q2" vid="PSA 26:8">aho ubwiza bwawe buba.<verse eid="PSA 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9" />Ntujaniranye umushaha wanje n’abanyavyaha,</para>
  <para style="q2" vid="PSA 26:9">ubugingo bwanje ntibuje mu gitigiri c’abicanyi,<verse eid="PSA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10" />mu gitigiri c’abafise imigabo mibi,</para>
  <para style="q2" vid="PSA 26:10">bemera kurya ibiturire.<verse eid="PSA 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11" />Mbayeho ntagira agasembwa;</para>
  <para style="q2" vid="PSA 26:11">umbohore ungirire imbabazi.<verse eid="PSA 26:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12" />Ibirenge vyanje birashikamye;</para>
  <para style="q2" vid="PSA 26:12">nzohimbaza <char style="nd">Uhoraho</char> mw’ikoraniro rinini.<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="cl">Zaburi ya 27</para>
  <para style="d">Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1" />
    <char style="nd">Uhoraho</char> ni we muco wanje n’agakiza kanje;</para>
  <para style="q2" vid="PSA 27:1">none notinya nde?</para>
  <para style="q1" vid="PSA 27:1">
    <char style="nd">Uhoraho</char> ni igihome kinkingira;</para>
  <para style="q2" vid="PSA 27:1">none ni nde yontera ubwoba?<verse eid="PSA 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2" />Abanyakibi nibantera</para>
  <para style="q2" vid="PSA 27:2">ngo bamire miyonzwa,</para>
  <para style="q1" vid="PSA 27:2">abansi banje n’abangwanya</para>
  <para style="q2" vid="PSA 27:2">ni bo bazotsitara batembe.<verse eid="PSA 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3" />Naho ingabo zontera,</para>
  <para style="q2" vid="PSA 27:3">umutima wanje worema;</para>
  <para style="q1" vid="PSA 27:3">naho intambara yokwaduka intumbereye,</para>
  <para style="q2" vid="PSA 27:3">naho nyene norema.<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4" />Ico nsaba <char style="nd">Uhoraho</char> ni kimwe,</para>
  <para style="q2" vid="PSA 27:4">kandi ni co conyene ndondera:</para>
  <para style="q1" vid="PSA 27:4">ni ukuba mu Ngoro y’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 27:4">imisi yose yo kubaho kwanje,</para>
  <para style="q1" vid="PSA 27:4">ngo nihweze ubwiza bw’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 27:4">ndamurondera mu rusengero rwiwe.<verse eid="PSA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5" />Kuko ku musi w’amagorwa</para>
  <para style="q2" vid="PSA 27:5">azonzigama amahoro mu Ngoro yiwe;</para>
  <para style="q1" vid="PSA 27:5">azompisha mu bwihisho bwo mw’ihema ryiwe</para>
  <para style="q2" vid="PSA 27:5">anshire hejuru ku rutare.<verse eid="PSA 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6" />Maze umutwe wanje uzoshirwa hejuru</para>
  <para style="q2" vid="PSA 27:6">nsumbe abansi banje bankikije;</para>
  <para style="q1" vid="PSA 27:6">nzomushikanira ikimazi mw’ihema ryiwe ryera n’akamo k’umunezero;</para>
  <para style="q2" vid="PSA 27:6">nzoririmba ncurarangire <char style="nd">Uhoraho</char>.<verse eid="PSA 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7" />
    <char style="nd">Uhoraho</char>, unyumve ninakwambaza;</para>
  <para style="q2" vid="PSA 27:7">ungirire imbabazi unyishure.<verse eid="PSA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8" />Umutima wanje ukuvugako uti: “Rondera mu nyonga hiwe!”</para>
  <para style="q2" vid="PSA 27:8">Mu nyonga hawe ndaharondera, ewe <char style="nd">Uhoraho</char>.<verse eid="PSA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9" />Ntumpishe mu nyonga hawe,</para>
  <para style="q2" vid="PSA 27:9">ntuhebe umusavyi wawe kubera uburake;</para>
  <para style="q2" vid="PSA 27:9">wamye uri umutabazi wanje,</para>
  <para style="q1" vid="PSA 27:9">ntunte canke ngo umpebe,</para>
  <para style="q2" vid="PSA 27:9">ewe Mana Mukiza wanje.<verse eid="PSA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10" />Naho data na mama bonta,</para>
  <para style="q2" vid="PSA 27:10">
    <char style="nd">Uhoraho</char> azonyitorera.<verse eid="PSA 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11" />Nyigisha inzira yawe, ewe <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 27:11">undongorere mu nzira igororotse</para>
  <para style="q2" vid="PSA 27:11">kubera abansi bankikije.<verse eid="PSA 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12" />Ntundeke ngo ngwe mu vyo bipfuza,</para>
  <para style="q2" vid="PSA 27:12">kuko ivyabona vy’ibinyoma vyampagurukiye,</para>
  <para style="q2" vid="PSA 27:12">bavuga ivy’iterabwoba no kungirira nabi.<verse eid="PSA 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13" />Ico nizigiye ntakekeranya ni iki:</para>
  <para style="q2" vid="PSA 27:13">Nzobona ukugira neza kw’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 27:13">nkiri mw’isi y’abazima.<verse eid="PSA 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14" />Urorere <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 27:14">ukomere ureme mu mutima</para>
  <para style="q2" vid="PSA 27:14">kandi urorere <char style="nd">Uhoraho</char>.<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="cl">Zaburi ya 28</para>
  <para style="d">Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1" />Ni wewe, <char style="nd">Uhoraho</char> ntakambiye;</para>
  <para style="q2" vid="PSA 28:1">ni wewe Gitandara canje,</para>
  <para style="q2" vid="PSA 28:1">ntiwime amatwi ugusenga kwanje.</para>
  <para style="q1" vid="PSA 28:1">Kuko niwihoza,</para>
  <para style="q2" vid="PSA 28:1">nzomera nk’abamanuka baja mu cobo.<verse eid="PSA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2" />Niwumve ugutakamba kwanje</para>
  <para style="q2" vid="PSA 28:2">igihe cose ngutabaje,</para>
  <para style="q1" vid="PSA 28:2">uko ntarika ibiganza vyanje</para>
  <para style="q2" vid="PSA 28:2">ndabirabisha Ahera Cane.<verse eid="PSA 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3" />Ntunjaniranye n’abanyakibi,</para>
  <para style="q2" vid="PSA 28:3">hamwe n’abakora ibibi,</para>
  <para style="q1" vid="PSA 28:3">bavugana ivyiza na bagenzi babo</para>
  <para style="q2" vid="PSA 28:3">ariko bafise imigambi mibi mu mitima yabo.<verse eid="PSA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4" />Ubahe ingero ikwiranye n’ibikorwa vyabo,</para>
  <para style="q2" vid="PSA 28:4">n’ibikorwa bibi vyabo;</para>
  <para style="q1" vid="PSA 28:4">ubishure ku vyo amaboko yabo yakoze,</para>
  <para style="q2" vid="PSA 28:4">ubasubirize mu nkoko ibikwiranye na bo.<verse eid="PSA 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5" />Kubera batababaye ibikorwa vy’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 28:5">n’ivyakozwe n’ukuboko kwiwe,</para>
  <para style="q1" vid="PSA 28:5">azobatsinda hasi</para>
  <para style="q2" vid="PSA 28:5">ntiyongere kububaka.<verse eid="PSA 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6" />
    <char style="nd">Uhoraho</char> ashimwe,</para>
  <para style="q2" vid="PSA 28:6">kuko yumvise ugutakamba kwanje.<verse eid="PSA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7" />
    <char style="nd">Uhoraho</char> ni we nkomezi zanje n’inkinzo yanje;</para>
  <para style="q2" vid="PSA 28:7">umutima wanje uramwizigira, na we akantabara.</para>
  <para style="q1" vid="PSA 28:7">Umutima wanje witerera hejuru kubera umunezero,</para>
  <para style="q2" vid="PSA 28:7">nanje nzomushimisha indirimbo yanje.<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8" />
    <char style="nd">Uhoraho</char> ni inkomezi z’abantu biwe,</para>
  <para style="q2" vid="PSA 28:8">igihome c’agakiza ku wo yarobanuje amavuta.<verse eid="PSA 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9" />Tabara ubwoko bwawe uhe umugisha umugabane wawe;</para>
  <para style="q2" vid="PSA 28:9">ubabere umwungere, ubaheke ibihe bidashira.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="cl">Zaburi ya 29</para>
  <para style="d">Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1" />Nimwubahe <char style="nd">Uhoraho</char>, yemwe ngabo zo mw’ijuru,</para>
  <para style="q2" vid="PSA 29:1">mwubahe Imana kubera ubwiza bwayo n’inkomezi zayo.<verse eid="PSA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2" />Nimuhe <char style="nd">Uhoraho</char> icubahiro kibereye izina ryayo;</para>
  <para style="q2" vid="PSA 29:2">musenge Imana mu cubahiro c’ukwera kwayo.<verse eid="PSA 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3" />Ijwi ry’<char style="nd">Uhoraho</char> ryumvikanira ku mazi menshi;</para>
  <para style="q2" vid="PSA 29:3">Imana y’ubwiza iraturagaye,</para>
  <para style="q2" vid="PSA 29:3">Imana ituragariye ku mazi menshi y’inkomezi.<verse eid="PSA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4" />Ijwi ry’<char style="nd">Uhoraho</char> riri n’inkomezi;</para>
  <para style="q2" vid="PSA 29:4">ijwi ry’<char style="nd">Uhoraho</char> riri n’icubahiro.<verse eid="PSA 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5" />Ijwi ry’<char style="nd">Uhoraho</char> rivunagura amasederi;</para>
  <para style="q2" vid="PSA 29:5">
    <char style="nd">Uhoraho</char> ahindura ubunywenywe amasederi y’i Libani.<verse eid="PSA 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6" />Atuma Libani hikina amatavu nk’inyana,</para>
  <para style="q2" vid="PSA 29:6">Siriyoni hakikina amatavu nk’inyana y’imbogo.<verse eid="PSA 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7" />Ijwi ry’<char style="nd">Uhoraho</char> rirekura</para>
  <para style="q2" vid="PSA 29:7">ibikeke vy’imiravyo.<verse eid="PSA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8" />Ijwi ry’<char style="nd">Uhoraho</char> rinyiganyiza ubugaragwa;</para>
  <para style="q2" vid="PSA 29:8">
    <char style="nd">Uhoraho</char> anyiganyiza ubugaragwa bw’i Kadeshi.<verse eid="PSA 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9" />Ijwi ry’<char style="nd">Uhoraho</char> rinyiganyiza ibiti bininibinini</para>
  <para style="q2" vid="PSA 29:9">rikambika ubusa amashamba.</para>
  <para style="q1" vid="PSA 29:9">Kandi mu Ngoro yiwe vyose bisemerera biti: “Ishimwe!”<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10" />
    <char style="nd">Uhoraho</char> avyagiye ku mwuzure;</para>
  <para style="q2" vid="PSA 29:10">
    <char style="nd">Uhoraho</char> avyagiye nk’Umwami ibihe bidashira.<verse eid="PSA 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11" />
    <char style="nd">Uhoraho</char> aha abantu biwe inkomezi;</para>
  <para style="q2" vid="PSA 29:11">
    <char style="nd">Uhoraho</char> aha abantu biwe umugisha w’amahoro.<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="cl">Zaburi ya 30</para>
  <para style="d">Ni Zaburi. Ni indirimbo ya Dawidi yo gushikiriza <char style="nd">Uhoraho</char> Ingoro.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1" />Nzogushira hejuru, <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 30:1">kuko wanshize hejuru unkuye mu kinogo kirekire,</para>
  <para style="q2" vid="PSA 30:1">ntiwandeka ngo abansi banje banshinyagurire.<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />
    <char style="nd">Uhoraho</char> Mana yanje, naragutakambiye,</para>
  <para style="q2" vid="PSA 30:2">na we urankiza.<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />Ni wewe, <char style="nd">Uhoraho</char>, wankuye ahantu h’abapfuye;</para>
  <para style="q2" vid="PSA 30:3">warandinze ngo simanuke nja muri rwa rwobo.<verse eid="PSA 30:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />Nimuririmbire <char style="nd">Uhoraho</char> amashimwe, yemwe abizigirwa biwe;</para>
  <para style="q2" vid="PSA 30:4">muhimbaze izina ryiwe ryera.<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />Kuko uburake bwiwe bumara akanya gato,</para>
  <para style="q2" vid="PSA 30:5">ariko ukugira neza kwiwe kugumaho ubuzima bwose;</para>
  <para style="q1" vid="PSA 30:5">ukurira kwomara ijoro ryose,</para>
  <para style="q2" vid="PSA 30:5">ariko mu gitondo hakaba impundu.<verse eid="PSA 30:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6" />Igihe nari ntekaniwe naravuze nti:</para>
  <para style="q2" vid="PSA 30:6">“Sinzonyiganyizwa.”<verse eid="PSA 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7" />
    <char style="nd">Uhoraho</char>, igihe wangirira neza,</para>
  <para style="q2" vid="PSA 30:7">watumye umusozi w’ubwami bwanje ushikama;</para>
  <para style="q1" vid="PSA 30:7">ariko aho wahisha mu nyonga hawe,</para>
  <para style="q2" vid="PSA 30:7">nishwe n’ubwoba.<verse eid="PSA 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />Narakwambaje, ewe <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 30:8">natabaje Uhoraho Umwami wanje nti:<verse eid="PSA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />“Uzokwunguka iki ninapfa,</para>
  <para style="q2" vid="PSA 30:9">ninamanuka nkaja muri rwa rwobo?</para>
  <para style="q1" vid="PSA 30:9">Mbega umukungugu uzoguhimbaza?</para>
  <para style="q2" vid="PSA 30:9">Canke uzokwamamaza ukwizigirwa kwawe?<verse eid="PSA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10" />Nunyumve, ewe <char style="nd">Uhoraho</char>, ungirire imbabazi;</para>
  <para style="q2" vid="PSA 30:10">
    <char style="nd">Uhoraho</char> we, umbere umutabazi.”<verse eid="PSA 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />Wahinduye ugucura intimba kwanje ukuvyina;</para>
  <para style="q2" vid="PSA 30:11">wanyambuye igunira unyambika impuzu y’umunezero,<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />kugira ngo umutima wanje uririmbe amashimwe urudaca.</para>
  <para style="q2" vid="PSA 30:12">
    <char style="nd">Uhoraho</char> Mana yanje, nzogushima ibihe bidashira.<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="cl">Zaburi ya 31</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1" />Muri wewe, <char style="nd">Uhoraho</char>, ni ho mpungiye;</para>
  <para style="q2" vid="PSA 31:1">sinze nigere maramara;</para>
  <para style="q2" vid="PSA 31:1">unkize ku bw’ukugororoka kwawe.<verse eid="PSA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2" />Ntega ugutwi,</para>
  <para style="q2" vid="PSA 31:2">nyaruka untabare;</para>
  <para style="q1" vid="PSA 31:2">umbere igitandara mpungiramwo,</para>
  <para style="q2" vid="PSA 31:2">igihome gikomeye kinkingira.<verse eid="PSA 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3" />Ni wewe gitandara canje n’igihome canje,</para>
  <para style="q2" vid="PSA 31:3">undongore kandi ungire inama ku bw’izina ryawe.<verse eid="PSA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4" />Undinde kugwa mu mutego watezwe imbere yanje,</para>
  <para style="q2" vid="PSA 31:4">kuko ari wewe buhungiro bwanje.<verse eid="PSA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5" />Mu biganza vyawe ni ho nshize impwemu yanje;</para>
  <para style="q2" vid="PSA 31:5">nkiza, <char style="nd">Uhoraho</char>, Mana yanje yo kwizigirwa.<verse eid="PSA 31:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6" />Nanka abumira ku bigirwamana bitagira ikimazi;</para>
  <para style="q2" vid="PSA 31:6">ariko jeho, nizigira <char style="nd">Uhoraho</char>.<verse eid="PSA 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7" />Nzonezerwa mpimbarirwe urukundo rwawe,</para>
  <para style="q2" vid="PSA 31:7">kuko wabonye umubabaro wanje</para>
  <para style="q2" vid="PSA 31:7">ukamenya amagorwa y’umutima wanje.<verse eid="PSA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8" />Ntiwandekuriye mu maboko y’umwansi</para>
  <para style="q2" vid="PSA 31:8">ariko washize ibirenge vyanje ahagutse.<verse eid="PSA 31:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9" />Ngirira ikigongwe, <char style="nd">Uhoraho</char>, kuko ndi mu mubabaro;</para>
  <para style="q2" vid="PSA 31:9">amaso yanje aruhijwe n’umubabaro,</para>
  <para style="q2" vid="PSA 31:9">umushaha wanje n’umubiri wanje bimazwe n’agahinda.<verse eid="PSA 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10" />Ubugingo bwanje bumazwe n’umubabaro</para>
  <para style="q2" vid="PSA 31:10">imyaka yanje imazwe n’ukuniha;</para>
  <para style="q1" vid="PSA 31:10">inkomezi zanje ziraheze kubera amarushwa,</para>
  <para style="q2" vid="PSA 31:10">n’amagufa yanje aradendebukiwe.<verse eid="PSA 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11" />Kubera abansi banje,</para>
  <para style="q2" vid="PSA 31:11">mbaye ruvumwa muri bagenzi banje</para>
  <para style="q1" vid="PSA 31:11">n’abakunzi banje pfampfe bangiye kure;</para>
  <para style="q2" vid="PSA 31:11">abambona mu mayira barampunga.<verse eid="PSA 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12" />Ndibagiranywe nk’uwapfuye;</para>
  <para style="q2" vid="PSA 31:12">mbaye nk’inkono imenetse.<verse eid="PSA 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13" />Kuko numva ubwongoshwe bwinshi:</para>
  <para style="q2" vid="PSA 31:13">“Ibiterabwoba impande zose!”</para>
  <para style="q1" vid="PSA 31:13">Bangira inama mbi</para>
  <para style="q2" vid="PSA 31:13">bagira imigabo yo kunyica.<verse eid="PSA 31:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14" />Ariko nizigiye wewe, <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 31:14">ndavuga nti: “Uri Imana yanje.”<verse eid="PSA 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15" />Ibihe vyanje biri mu biganza vyawe;</para>
  <para style="q2" vid="PSA 31:15">nkura mu maboko y’abansi banje,</para>
  <para style="q2" vid="PSA 31:15">mu maboko y’abampiga.<verse eid="PSA 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16" />Murikishiriza mu nyonga hawe umusavyi wawe;</para>
  <para style="q2" vid="PSA 31:16">nkiriza mu rukundo rwawe rudahera.<verse eid="PSA 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17" />Ntundeke ngo maramare, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 31:17">kuko ngutakambiye;</para>
  <para style="q1" vid="PSA 31:17">ariko abanyakibi babe ari bo bamaramara</para>
  <para style="q2" vid="PSA 31:17">bamanuke mu gacerere baja ahantu h’abapfuye.<verse eid="PSA 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18" />Iminwa yabo ibesha nizibwe,</para>
  <para style="q2" vid="PSA 31:18">kuko bavugana ubwibone bavuga nabi umugororotsi</para>
  <para style="q2" vid="PSA 31:18">buzuye ubwishime n’akagaye.<verse eid="PSA 31:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19" />Ese ingene ivyiza ari vyinshi</para>
  <para style="q2" vid="PSA 31:19">ivyo wabikiye abakwubaha,</para>
  <para style="q1" vid="PSA 31:19">ngo ubicuncuburire mu maso ya bose,</para>
  <para style="q2" vid="PSA 31:19">ku bahungira muri wewe.<verse eid="PSA 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20" />Mu bwihisho bwo mu nyonga hawe ni ho ubahisha</para>
  <para style="q2" vid="PSA 31:20">inama mbi abandi babagira;</para>
  <para style="q1" vid="PSA 31:20">ubarindira mu nzu yawe mu mahoro</para>
  <para style="q2" vid="PSA 31:20">ababavuga nabi.<verse eid="PSA 31:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21" />Ishimwe ni iry’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 31:21">kuko yanyeretse ibitangaza vyo mu rukundo rwiwe</para>
  <para style="q2" vid="PSA 31:21">igihe nari mu gisagara gikikujwe n’abagiteye.<verse eid="PSA 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22" />Kubera ubwoba nari mfise naravuze nti:</para>
  <para style="q2" vid="PSA 31:22">“Nkuwe mu nyonga zawe!”</para>
  <para style="q1" vid="PSA 31:22">Ariko wumvise ugutakamba kwanje</para>
  <para style="q2" vid="PSA 31:22">igihe naguhamagara ngo untabare.<verse eid="PSA 31:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23" />Nimukunde <char style="nd">Uhoraho</char>, yemwe bizigirwa biwe!</para>
  <para style="q2" vid="PSA 31:23">
    <char style="nd">Uhoraho</char> azigama abamutunganiye,</para>
  <para style="q2" vid="PSA 31:23">ariko abishira hejuru abasubiriza mu nkoko ibihwanye n’ivyo bakoze.<verse eid="PSA 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24" />Nimukomere mureme mu mitima,</para>
  <para style="q2" vid="PSA 31:24">yemwe mwese abizigira <char style="nd">Uhoraho</char>.<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="cl">Zaburi ya 32</para>
  <para style="d">Ni iya Dawidi. Ni masikili.<note caller="+" style="f"><char style="fr" closed="false">32:0 </char><char style="ft" closed="false">Ijambo </char><char style="fq" closed="false">Masikili </char><char style="ft" closed="false">rishobora kuba risigura ubwoko bw’icese canke bw’umudiho.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1" />Hahiriwe umuntu</para>
  <para style="q2" vid="PSA 32:1">Imana yababariye ibikorwa vyiwe bibi;</para>
  <para style="q2" vid="PSA 32:1">ivyaha vyiwe bigaharirwa.<verse eid="PSA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2" />Hahiriwe umuntu</para>
  <para style="q2" vid="PSA 32:2">
    <char style="nd">Uhoraho</char> adaharurako ivyaha vyiwe</para>
  <para style="q2" vid="PSA 32:2">kandi mu impwemu yiwe ntihabemwo ubugunge.<verse eid="PSA 32:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3" />Ncereje,</para>
  <para style="q2" vid="PSA 32:3">amagufa yanje aruma</para>
  <para style="q2" vid="PSA 32:3">kubera kuboroga bukarinda bwira.<verse eid="PSA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4" />Kuko ku murango no mw’ijoro</para>
  <para style="q2" vid="PSA 32:4">ukuboko kwawe kwandemera;</para>
  <para style="q1" vid="PSA 32:4">inkomezi zanje zaragurutse</para>
  <para style="q2" vid="PSA 32:4">nk’ukwuma kwo mu ci.<verse eid="PSA 32:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5" />Ni kuko nakwemereye icaha canje</para>
  <para style="q2" vid="PSA 32:5">sinanyegeza ukugabitanya kwanje.</para>
  <para style="q1" vid="PSA 32:5">Naravuze nti: “Ndaturira <char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 32:5">ukugabitanya kwanje.”</para>
  <para style="q1" vid="PSA 32:5">Nawe wampariye</para>
  <para style="q2" vid="PSA 32:5">ugucumura kwanje.<verse eid="PSA 32:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6" />Ni co gituma abakwizigira bose bakwiye kugusenga</para>
  <para style="q2" vid="PSA 32:6">mu mwanya ushobora kubonerwamwo;</para>
  <para style="q1" vid="PSA 32:6">ni ukuri amazi menshi asuriranya</para>
  <para style="q2" vid="PSA 32:6">ntazobashikira.<verse eid="PSA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7" />Ni wewe buhungiro bwanje;</para>
  <para style="q2" vid="PSA 32:7">uzonkingira amagorwa</para>
  <para style="q2" vid="PSA 32:7">unkikize indirimbo zo kunesha.<verse eid="PSA 32:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8" />Nzokwigisha ndakwereke inzira ukwiye kujana;</para>
  <para style="q2" vid="PSA 32:8">nzokugira inama ndaguhozeko ijisho ryanje.<verse eid="PSA 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9" />Ntimube nk’ifarasi canke inyumbu</para>
  <para style="q2" vid="PSA 32:9">bitagira ugutahura,</para>
  <para style="q1" vid="PSA 32:9">ariko birinda gukubitwa no gukwegwa n’imigozi,</para>
  <para style="q2" vid="PSA 32:9">kuko bitari uko ntivyokwegera umuntu.<verse eid="PSA 32:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10" />Umunyakibi azobona amagorwa menshi,</para>
  <para style="q2" vid="PSA 32:10">ariko urukundo rw’<char style="nd">Uhoraho</char> rudashira</para>
  <para style="q2" vid="PSA 32:10">rukikuje umuntu amwizigira.<verse eid="PSA 32:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11" />Nimunezererwe <char style="nd">Uhoraho</char> muhimbarwe, yemwe bagororotsi;</para>
  <para style="q2" vid="PSA 32:11">nimuririmbe, abatunganye mu mutima mwese!<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="cl">Zaburi ya 33</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1" />Nimuririmbire <char style="nd">Uhoraho</char> munezerewe, yemwe bagororotsi;</para>
  <para style="q2" vid="PSA 33:1">birabereye abatunganye kumuhimbaza.<verse eid="PSA 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2" />Muhimbaze <char style="nd">Uhoraho</char> n’ikembe;</para>
  <para style="q2" vid="PSA 33:2">mumucurarangire n’inanga y’imirya cumi.<verse eid="PSA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3" />Mumuririmbire indirimbo nshasha;</para>
  <para style="q2" vid="PSA 33:3">mucurarangishe ubuhinga, muvuze impundu z’umunezero.<verse eid="PSA 33:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4" />Kuko ijambo ry’<char style="nd">Uhoraho</char> rigororotse kandi ari iry’ukuri;</para>
  <para style="q2" vid="PSA 33:4">ni umwizigirwa mu vyo akora vyose.<verse eid="PSA 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5" />
    <char style="nd">Uhoraho</char> akunda ubugororotsi n’imanza zibereye;</para>
  <para style="q2" vid="PSA 33:5">isi yuzuye urukundo rwiwe rudashira.<verse eid="PSA 33:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6" />Amajuru yaremwe n’ijambo ry’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 33:6">inyenyeri zo kw’ijuru zose zaremwe n’impwemu z’akanwa kiwe.<verse eid="PSA 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7" />Yegeraniriza mu mibindi amazi yo mu kiyaga;</para>
  <para style="q2" vid="PSA 33:7">ashira amazi yose yo mw’idamba mu bubiko.<verse eid="PSA 33:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8" />Isi yose niyubahe <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 33:8">abo mw’isi bose nibamwunamire.<verse eid="PSA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9" />Kuko yavuze bikaba;</para>
  <para style="q2" vid="PSA 33:9">agategeka, bigakomera.<verse eid="PSA 33:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10" />
    <char style="nd">Uhoraho</char> ahindura ubusa imigambi y’amahanga;</para>
  <para style="q2" vid="PSA 33:10">asambura imigabo y’amoko.<verse eid="PSA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11" />Imigambi y’<char style="nd">Uhoraho</char> ihora ihangamye ibihe bidashira,</para>
  <para style="q2" vid="PSA 33:11">imigabo y’umutima wiwe yamaho uko urunganwe rukuranwa n’urundi.<verse eid="PSA 33:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12" />Hahiriwe ihanga rifise <char style="nd">Uhoraho</char> nk’Imana yaryo,</para>
  <para style="q2" vid="PSA 33:12">abantu yitoranirije ngo bamubere inyegu.<verse eid="PSA 33:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13" />
    <char style="nd">Uhoraho</char> ari mw’ijuru arunguruka kw’isi</para>
  <para style="q2" vid="PSA 33:13">ngo arabe abana b’abantu;<verse eid="PSA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14" />ari aho aba yitegereza</para>
  <para style="q2" vid="PSA 33:14">abari kw’isi bose;<verse eid="PSA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15" />Uwaremye imitima yabo bose,</para>
  <para style="q2" vid="PSA 33:15">yitegereza ivyo bakora vyose.<verse eid="PSA 33:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16" />Nta mwami akizwa n’uko afise ingabo nyinshi;</para>
  <para style="q2" vid="PSA 33:16">nta muhizi akizwa n’uko afise inkomezi nyinshi.<verse eid="PSA 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17" />Ntukizigire ifarasi ngo igukize;</para>
  <para style="q2" vid="PSA 33:17">naho ifise inkomezi nyinshi ntishobora gukiza.<verse eid="PSA 33:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18" />Ariko inyonga z’<char style="nd">Uhoraho</char> ziri ku bamwubaha,</para>
  <para style="q2" vid="PSA 33:18">ku bizigira urukundo rwiwe rudashira,<verse eid="PSA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19" />ngo rubakize urupfu</para>
  <para style="q2" vid="PSA 33:19">rubazigame bagume ari bazima mu gihe c’ikigoyi.<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20" />Turindiriye <char style="nd">Uhoraho</char> twihanganye;</para>
  <para style="q2" vid="PSA 33:20">kuko ari umutabazi wacu n’inkinzo yacu.<verse eid="PSA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21" />Imitima yacu inezererwa muri we,</para>
  <para style="q2" vid="PSA 33:21">kuko twizigiye izina ryiwe ryera.<verse eid="PSA 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22" />Urukundo rwawe rudashira rubane natwe, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 33:22">kuko ari wewe twizigiye.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="cl">Zaburi ya 34</para>
  <para style="d">Ni iya Dawidi. Igihe yihindura umusazi imbere ya Abimeleki, agaca amwirukana, na we agaca agenda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1" />Nzokwama nshima <char style="nd">Uhoraho</char> ibihe vyose;</para>
  <para style="q2" vid="PSA 34:1">ishimwe ryiwe rizokwama ku minwa yanje ubudasiba.<verse eid="PSA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2" />Nzokwirata <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 34:2">abaciye bugufi nibavyumve banezerwe.<verse eid="PSA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3" />Nimumfashe dushime <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 34:3">nimuze dufatanye gushira hejuru izina ryiwe.<verse eid="PSA 34:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4" />Narondeye <char style="nd">Uhoraho</char>, na we aranyishura;</para>
  <para style="q2" vid="PSA 34:4">ankiza ubwoba bwose nari mfise.<verse eid="PSA 34:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5" />Abamuravye bose barakayangana;</para>
  <para style="q2" vid="PSA 34:5">mu maso habo ntihazokwigera hamaramara.<verse eid="PSA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6" />Uwu mugorwa yarambaje, <char style="nd">Uhoraho</char> aramwumva;</para>
  <para style="q2" vid="PSA 34:6">amukiza amarushwa yiwe yose.<verse eid="PSA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7" />Umumarayika w’<char style="nd">Uhoraho</char> acumbitse</para>
  <para style="q2" vid="PSA 34:7">hirya no hino y’abamwubaha, akabakiza.<verse eid="PSA 34:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8" />Nimwumvirize mumenye ko <char style="nd">Uhoraho</char> ari mwiza;</para>
  <para style="q2" vid="PSA 34:8">hahiriwe uwumuhungirako.<verse eid="PSA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9" />Nimwubahe <char style="nd">Uhoraho</char>, yemwe abera biwe,</para>
  <para style="q2" vid="PSA 34:9">kuko abamwubaha batazogira ico bakena.<verse eid="PSA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10" />Intambwe zocika intege zigasonza,</para>
  <para style="q2" vid="PSA 34:10">ariko abarondera <char style="nd">Uhoraho</char> ntibazokena iciza na kimwe.<verse eid="PSA 34:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11" />Nimuze bana banje, munyumvirize;</para>
  <para style="q2" vid="PSA 34:11">nanje ndabigishe ukwubaha <char style="nd">Uhoraho</char>.<verse eid="PSA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12" />Umuntu wese akunda ubugingo</para>
  <para style="q2" vid="PSA 34:12">akipfuza kubona imisi myiza myinshi,<verse eid="PSA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13" />aze arinde ururimi rwiwe ikibi</para>
  <para style="q2" vid="PSA 34:13">n’iminwa yiwe ayirinde ivyo kubesha.<verse eid="PSA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14" />Itandukanye n’ikibi, ukore ivyiza;</para>
  <para style="q2" vid="PSA 34:14">rondera amahoro uyakurikire.<verse eid="PSA 34:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15" />Inyonga z’<char style="nd">Uhoraho</char> ziri ku bagororotsi,</para>
  <para style="q2" vid="PSA 34:15">kandi amatwi yiwe ayabangira ugutakamba kwabo;<verse eid="PSA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16" />ariko igitsure ciwe kiri ku bakora ibibi,</para>
  <para style="q2" vid="PSA 34:16">ngo aherengeteze ukwibukwa kwabo kw’isi.<verse eid="PSA 34:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17" />Abagororotsi baratakamvye, <char style="nd">Uhoraho</char> arabumva;</para>
  <para style="q2" vid="PSA 34:17">abakiza amarushwa yabo yose.<verse eid="PSA 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18" />
    <char style="nd">Uhoraho</char> ari hafi y’abafise imitima imenetse</para>
  <para style="q2" vid="PSA 34:18">kandi akiza abajanjaguritse imitima.<verse eid="PSA 34:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19" />Amarushwa y’umugororotsi ashobora kuba menshi,</para>
  <para style="q2" vid="PSA 34:19">ariko <char style="nd">Uhoraho</char> ayamukiza yose;<verse eid="PSA 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20" />azigama amagufa yiwe,</para>
  <para style="q2" vid="PSA 34:20">nta na rimwe rizovunika.<verse eid="PSA 34:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21" />Ikibi kizokwica umunyakibi;</para>
  <para style="q2" vid="PSA 34:21">abagwanya umugororotsi bazotsindwa n’urubanza.<verse eid="PSA 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22" />
    <char style="nd">Uhoraho</char> azokiza abasavyi biwe;</para>
  <para style="q2" vid="PSA 34:22">nta n’umwe mu bamuhungirako azotsindwa n’urubanza.<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="cl">Zaburi ya 35</para>
  <para style="d">Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1" />
    <char style="nd">Uhoraho</char>, burana n’abamburanya;</para>
  <para style="q2" vid="PSA 35:1">gwana n’abangwanya.<verse eid="PSA 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2" />Fata inkinzo yawe, nini na ntoya;</para>
  <para style="q2" vid="PSA 35:2">uve hasi untabare.<verse eid="PSA 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3" />Bangura icumu n’ikimito</para>
  <para style="q2" vid="PSA 35:3">utere abampiga.</para>
  <para style="q1" vid="PSA 35:3">Umbwire uti:</para>
  <para style="q2" vid="PSA 35:3">“Ni jewe gakiza kawe.”<verse eid="PSA 35:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4" />Abarondera ubugingo bwanje</para>
  <para style="q2" vid="PSA 35:4">nibateterwe bamaramare;</para>
  <para style="q1" vid="PSA 35:4">abagira inama yo kunyica</para>
  <para style="q2" vid="PSA 35:4">basubire inyuma batinye.<verse eid="PSA 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5" />Nibamere nk’umuguruka utumurwa n’umuyaga,</para>
  <para style="q2" vid="PSA 35:5">umumarayika w’<char style="nd">Uhoraho</char> abirukane;<verse eid="PSA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6" />iminyuro yabo nicure umwijima kandi inyerere,</para>
  <para style="q2" vid="PSA 35:6">umumarayika w’<char style="nd">Uhoraho</char> abahige abakinagize.<verse eid="PSA 35:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7" />Kuko banteze umutego ata nyanduruko</para>
  <para style="q2" vid="PSA 35:7">bakanyimbira icobo ata gituma,<verse eid="PSA 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8" />uguhona nikubashikeko giturumbuka;</para>
  <para style="q2" vid="PSA 35:8">umutego bateze abe ari bo ufata,</para>
  <para style="q2" vid="PSA 35:8">bagwe muri ca cobo, bahonereyo.<verse eid="PSA 35:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9" />Ni ho umutima wanje uzonezererwa <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 35:9">ugahimbarirwa agakiza kiwe.<verse eid="PSA 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10" />Ibimbamwo vyose bizokwatura biti:</para>
  <para style="q2" vid="PSA 35:10">“Ni nde ameze nkawe, ewe <char style="nd">Uhoraho</char>?</para>
  <para style="q1" vid="PSA 35:10">Ukiza abakene ababarusha inkomezi,</para>
  <para style="q2" vid="PSA 35:10">aboro n’abakene ukabakiza ababahahaza.”<verse eid="PSA 35:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11" />Ivyabona vy’ibinyoma bihagurukiye kunyagiriza;</para>
  <para style="q2" vid="PSA 35:11">bambaza ibintu ata na kimwe ndabiziko.<verse eid="PSA 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12" />Banyishuye ikibi ku ciza nabagiriye</para>
  <para style="q2" vid="PSA 35:12">maze banta jenyene.<verse eid="PSA 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13" />Ariko igihe bari bagwaye, nambaye igunira</para>
  <para style="q2" vid="PSA 35:13">nicisha bugufi ndisonzesha.</para>
  <para style="q1" vid="PSA 35:13">Amasengesho yanje atishuwe,<verse eid="PSA 35:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 35:14" />nagendagenda ngandaye</para>
  <para style="q2" vid="PSA 35:14">nk’uwabuze umukunzi canke umuvukanyi.</para>
  <para style="q1" vid="PSA 35:14">Nacuritse umutwe ngandaye</para>
  <para style="q2" vid="PSA 35:14">nk’uwabuze nyina.<verse eid="PSA 35:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15" />Ariko aho natsitara, bagiye hamwe baranezerwa;</para>
  <para style="q2" vid="PSA 35:15">bakoraniye kungwanya ntabizi.</para>
  <para style="q2" vid="PSA 35:15">Bamvuze nabi ubudahumeka.<verse eid="PSA 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16" />Bancokoye nk’abatubaha Imana,</para>
  <para style="q2" vid="PSA 35:16">bampekenyera amenyo.<verse eid="PSA 35:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17" />Uzogeza ryari, ewe Mana, kubiraba ntugire ico ukora?</para>
  <para style="q2" vid="PSA 35:17">Ntabara unkize ibibi bakora,</para>
  <para style="q2" vid="PSA 35:17">ukure ubugingo bwanje bw’igiciro mu menyo y’izo ntambwe!<verse eid="PSA 35:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18" />Nzogushimira mw’ikoraniro rinini;</para>
  <para style="q2" vid="PSA 35:18">imbere y’amasinzi nzoguhimbaza.<verse eid="PSA 35:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19" />Ntureke abo ngo banyishimeko,</para>
  <para style="q2" vid="PSA 35:19">banyankira ubusa;</para>
  <para style="q1" vid="PSA 35:19">ntureke abanyanka ata gituma</para>
  <para style="q2" vid="PSA 35:19">ngo bavuniranire ingohe.<verse eid="PSA 35:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20" />Ntibavuga ivy’amahoro,</para>
  <para style="q2" vid="PSA 35:20">ariko biyumvira ivyo kubeshera</para>
  <para style="q2" vid="PSA 35:20">abibera mu gihugu ata nkomanzi.<verse eid="PSA 35:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21" />Bashira urwamo hejuru bambwira bati: “Aha! Aha!</para>
  <para style="q2" vid="PSA 35:21">Twavyiboneye n’amaso yacu.”<verse eid="PSA 35:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22" />
    <char style="nd">Uhoraho</char> we, warabibonye; ntucereze.</para>
  <para style="q2" vid="PSA 35:22">Ntube kure yanje, ewe Mana.<verse eid="PSA 35:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23" />Ikangure uve hasi ungwanire!</para>
  <para style="q2" vid="PSA 35:23">Mburanira, ewe Mana yanje kandi Mwami wanje.<verse eid="PSA 35:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24" />Ungwanire mu bugororotsi bwawe, <char style="nd">Uhoraho</char> Mana yanje;</para>
  <para style="q2" vid="PSA 35:24">ntubareke ngo banyishime hejuru.<verse eid="PSA 35:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25" />Ntubareke ngo bavuge bati: “Ivyo ni vyo twarondera!”</para>
  <para style="q2" vid="PSA 35:25">Canke bati: “Twamumize miyonzwa.”<verse eid="PSA 35:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26" />Abahimbarwa n’uko nguye mu vyago</para>
  <para style="q2" vid="PSA 35:26">nibamaramare bakorwe n’isoni;</para>
  <para style="q1" vid="PSA 35:26">abanyishimako</para>
  <para style="q2" vid="PSA 35:26">bakorwe n’isoni, bamaramare.<verse eid="PSA 35:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27" />Abahimbarwa n’uko ntabawe</para>
  <para style="q2" vid="PSA 35:27">nibavuze impundu z’umunezero;</para>
  <para style="q1" vid="PSA 35:27">bame bavuga bati: “<char style="nd">Uhoraho</char> ashirwe hejuru,</para>
  <para style="q2" vid="PSA 35:27">we ahimbarwa n’ukugubwa neza kw’umusavyi wiwe.”<verse eid="PSA 35:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28" />Ururimi rwanje ruzokwamamaza ukugororoka kwawe,</para>
  <para style="q2" vid="PSA 35:28">n’amashimwe yawe burinde bwira.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="cl">Zaburi ya 36</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni iya Dawidi umusavyi w’<char style="nd">Uhoraho</char>.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1" />Mfise ubutumwa mu mutima wanje buvuye ku Mana yanje</para>
  <para style="q2" vid="PSA 36:1">bwerekeye ububi bw’abanyakibi ngo:</para>
  <para style="q1" vid="PSA 36:1">Nta gutinya Imana</para>
  <para style="q2" vid="PSA 36:1">kuri muri bo.<verse eid="PSA 36:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2" />Mu maso yabo barihenda ubwabo</para>
  <para style="q2" vid="PSA 36:2">kugeza aho batamenya canke ngo banke icaha cabo.<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />Amajambo yo mu kanwa kabo ni mabi, ni ay’uruhendo;</para>
  <para style="q2" vid="PSA 36:3">bananiwe no gukora ivy’ubwenge canke ngo bakore ivyiza.<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />Bari no ku mariri yabo baja imigabo yo gukora ibibi;</para>
  <para style="q2" vid="PSA 36:4">bakiyegurira gusiganwa mu bibi</para>
  <para style="q2" vid="PSA 36:4">ntibatere ibitugu ibitari ivy’ukuri.<verse eid="PSA 36:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />
    <char style="nd">Uhoraho</char>, urukundo rwawe rushika no mw’ijuru,</para>
  <para style="q2" vid="PSA 36:5">ukwizigirwa kwawe gushika no mu birere.<verse eid="PSA 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6" />Ukugororoka kwawe kumeze nk’imisozi miremire,</para>
  <para style="q2" vid="PSA 36:6">imanza zawe zimeze nk’idamba rinini.</para>
  <para style="q2" vid="PSA 36:6">Ewe Uhoraho Mana, ni wewe ubwawe uzigama abantu n’ibikoko.<verse eid="PSA 36:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />Ese ukuntu urukundo rwawe rudashira ari akaburarugero, ewe Mana!</para>
  <para style="q2" vid="PSA 36:7">Abantu bahungira musi y’igitutu c’amababa yawe.<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />Bagira umusi mukuru mu bihinda vyo mu nzu yawe;</para>
  <para style="q2" vid="PSA 36:8">ubaha ivyo kunywa biva ku ruzi rwawe rw’ibiryoshe.<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />Kuko kuri wewe ari ho hari isoko y’ubugingo;</para>
  <para style="q2" vid="PSA 36:9">mu nyonga hawe ni ho tubonera umuco.<verse eid="PSA 36:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />Shishikara ukunda abakumenye,</para>
  <para style="q2" vid="PSA 36:10">ugume uri umugororotsi ku batunganye mu mitima.<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />Ikirenge c’umwibone ntikigahonyore iwanje,</para>
  <para style="q2" vid="PSA 36:11">n’ukuboko kw’umunyakibi kwirukanwe.<verse eid="PSA 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />Ehe ingene inkozi z’ibibi ziguye hasi;</para>
  <para style="q2" vid="PSA 36:12">baratemvye, ubutagihaguruka!<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="cl">Zaburi ya 37</para>
  <para style="d">Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1" />Ntuhagarikwe umutima n’abanyakibi</para>
  <para style="q2" vid="PSA 37:1">canke ngo wipfuze ivy’abakora ibibi;<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />kuko bagiye gutemwa nk’ubwatsi vuba,</para>
  <para style="q2" vid="PSA 37:2">bazokwuma nk’uko ivyatsi vyuma.<verse eid="PSA 37:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />Wizigire <char style="nd">Uhoraho</char> ukore ivyiza;</para>
  <para style="q2" vid="PSA 37:3">guma mu gihugu unezerererwe uburagiro bwiza.<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />Uhimbarwe n’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 37:4">na we azoguha ivyo umutima wawe wipfuza.<verse eid="PSA 37:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />Wegurire <char style="nd">Uhoraho</char> inzira yawe;</para>
  <para style="q2" vid="PSA 37:5">umwizigire na we azobishitsa:<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />Azotuma ingero yawe yo kugororoka ikayangana nk’umutwenzi,</para>
  <para style="q2" vid="PSA 37:6">n’urubanza rwawe nk’izuba ryo mu mashoka.<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />Utekerereze imbere y’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 37:7">umurindire wihanganye;</para>
  <para style="q1" vid="PSA 37:7">ntuze ubabare abantu nibatunganirwa mu nzira zabo,</para>
  <para style="q2" vid="PSA 37:7">nibashira mu ngiro imigambi yabo mibi.<verse eid="PSA 37:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />Reka ishavu, va mu burake;</para>
  <para style="q2" vid="PSA 37:8">ntushangashirwe; vyotuma ukora nabi.<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />Kuko abanyakibi bazohona,</para>
  <para style="q2" vid="PSA 37:9">ariko abizigira <char style="nd">Uhoraho</char> bazoragwa igihugu.<verse eid="PSA 37:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />Hasigaye igihe gito, umunyakibi ntabe akibaho;</para>
  <para style="q2" vid="PSA 37:10">uzomurondera ariko ntuzomubona.<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />Ariko abaciye bugufi bazoragwa isi</para>
  <para style="q2" vid="PSA 37:11">banezerererwe amahoro n’ukugubwa neza.<verse eid="PSA 37:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />Umunyakibi agirira imigabo mibi umugororotsi</para>
  <para style="q2" vid="PSA 37:12">akamuhekenyera amenyo;<verse eid="PSA 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13" />ariko wewe Mana atwengera mw’ijigo umunyakibi,</para>
  <para style="q2" vid="PSA 37:13">kuko azi ko umusi wiwe ushitse.<verse eid="PSA 37:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />Umunyakibi asokoye inkota</para>
  <para style="q2" vid="PSA 37:14">kandi afoye umuheto</para>
  <para style="q1" vid="PSA 37:14">ngo atsinde hasi umworo n’umukene,</para>
  <para style="q2" vid="PSA 37:14">ngo yice uwugenda atunganye mu nzira ziwe.<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />Ariko inkota yiwe izosogota umutima wiwe bwite,</para>
  <para style="q2" vid="PSA 37:15">n’umuheto wiwe uzovunika.<verse eid="PSA 37:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />Kuba umugororotsi no gutunga bike</para>
  <para style="q2" vid="PSA 37:16">biruta kuba umunyakibi afise ubutunzi bwinshi;<verse eid="PSA 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17" />kuko inkomezi z’umunyakibi zizovunagurwa,</para>
  <para style="q2" vid="PSA 37:17">ariko <char style="nd">Uhoraho</char> ashigikiye umugororotsi.<verse eid="PSA 37:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />Inyankamugayo zimara imisi yazo zishigikiwe n’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 37:18">kandi ivyo zarazwe bizokwamaho ibihe vyose.<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />Mu bihe vy’ivyago ntibazokabirana;</para>
  <para style="q2" vid="PSA 37:19">no mu gihe ca kigoyi bazonezererwa umusesekara.<verse eid="PSA 37:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />Ariko umunyakibi azohona:</para>
  <para style="q2" vid="PSA 37:20">naho abansi b’<char style="nd">Uhoraho</char> bameze nk’amashurwe yo ku misozi,</para>
  <para style="q2" vid="PSA 37:20">bazotongorwa batumuke nk’umwotsi.<verse eid="PSA 37:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />Umunyakibi aragurana ntasubize,</para>
  <para style="q2" vid="PSA 37:21">ariko umugororotsi atanga ivyo ubuntu;<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />abahawe umugisha n’<char style="nd">Uhoraho</char> bazoragwa igihugu,</para>
  <para style="q2" vid="PSA 37:22">ariko abavumwe na we bazohona.<verse eid="PSA 37:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />
    <char style="nd">Uhoraho</char> akomeza intambuko</para>
  <para style="q2" vid="PSA 37:23">z’uwumwishimira;<verse eid="PSA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24" />naho yotsitara, ntazogwa hasi,</para>
  <para style="q2" vid="PSA 37:24">kuko <char style="nd">Uhoraho</char> amushigikije ukuboko kwiwe.<verse eid="PSA 37:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25" />Kuva ndi muto kugeza ubu nshaje,</para>
  <para style="q2" vid="PSA 37:25">sinigeze mbona umugororotsi yatawe</para>
  <para style="q2" vid="PSA 37:25">canke abana biwe basegerereza ivyokurya.<verse eid="PSA 37:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26" />Yama atanga ivyo ubuntu akaguranira kutaziga inyungu;</para>
  <para style="q2" vid="PSA 37:26">abana biwe bazoba umugisha.<verse eid="PSA 37:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27" />Va mu bibi ukore ivyiza;</para>
  <para style="q2" vid="PSA 37:27">ni ho uzoba mu gihugu ibihe bidashira.<verse eid="PSA 37:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28" />Kuko <char style="nd">Uhoraho</char> akunda uwutunganye</para>
  <para style="q2" vid="PSA 37:28">kandi ntazohemukira abizigirwa biwe.</para>
  <para style="b" vid="PSA 37:28" />
  <para style="q1" vid="PSA 37:28">Abakora ibibi bazohona rwose;</para>
  <para style="q2" vid="PSA 37:28">uruvyaro rw’umunyakibi ruzohona.<verse eid="PSA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29" />Umugororotsi azoragwa igihugu</para>
  <para style="q2" vid="PSA 37:29">akibemwo ibihe vyose.<verse eid="PSA 37:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30" />Akanwa k’umugororotsi katura ivy’ubwenge,</para>
  <para style="q2" vid="PSA 37:30">n’ururimi rwiwe ruvuga ibitunganye.<verse eid="PSA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31" />Ivyagezwe vy’Imana yiwe biri mu mutima wiwe,</para>
  <para style="q2" vid="PSA 37:31">ibirenge vyiwe ntibizonyerera.<verse eid="PSA 37:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32" />Umunyakibi abundira umugororotsi,</para>
  <para style="q2" vid="PSA 37:32">agomba kumwica.<verse eid="PSA 37:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33" />Yamara <char style="nd">Uhoraho</char> ntazomurekurira mu maboko yiwe</para>
  <para style="q2" vid="PSA 37:33">canke ngo amureke atsindwe niyaja imbere y’intahe.<verse eid="PSA 37:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34" />Wizigire <char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 37:34">ugume mu nzira yiwe.</para>
  <para style="q1" vid="PSA 37:34">Azogushira hejuru uragwe igihugu,</para>
  <para style="q2" vid="PSA 37:34">abanyakibi bazohona ubiraba.<verse eid="PSA 37:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35" />Nabonye umunyakibi w’umwicanyi</para>
  <para style="q2" vid="PSA 37:35">asagarara nk’igiti gitotahaye,<verse eid="PSA 37:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36" />ariko yarazimanganye ntiyaba akiboneka;</para>
  <para style="q2" vid="PSA 37:36">naho namurondeye, ntiyari akiboneka.<verse eid="PSA 37:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37" />Witegereze uwutagira umugayo, urabe uwutunganye;</para>
  <para style="q2" vid="PSA 37:37">kazoza keza karindiriye abarondera amahoro.<verse eid="PSA 37:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38" />Ariko abanyavyaha bazopfa;</para>
  <para style="q2" vid="PSA 37:38">nta kazoza ku munyakibi.<verse eid="PSA 37:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39" />Agakiza k’abagororotsi kava k’<char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 37:39">ni we gihome kibakingira mu bihe vy’amagorwa.<verse eid="PSA 37:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40" />
    <char style="nd">Uhoraho</char> ni we abatabara akabarokora;</para>
  <para style="q2" vid="PSA 37:40">akabarokora mu maboko y’abanyakibi akabakiza,</para>
  <para style="q2" vid="PSA 37:40">kuko bamuhungiyeko.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="cl">Zaburi ya 38</para>
  <para style="d">Ni Zaburi ya Dawidi. Ni isengesho.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1" />
    <char style="nd">Uhoraho</char>, ntumpanane ishavu</para>
  <para style="q2" vid="PSA 38:1">canke ngo unkubitane uburake.<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />Imyampi yawe irantobekeranije,</para>
  <para style="q2" vid="PSA 38:2">kandi ukuboko kwawe kwaramanukiye.<verse eid="PSA 38:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />Muri jewe nta hazima kubera uburake bwawe;</para>
  <para style="q2" vid="PSA 38:3">no mu magufa yanje sinikoma kubera icaha canje.<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />Ukugabitanya kwanje kurandengeye</para>
  <para style="q2" vid="PSA 38:4">kwabaye nk’umuzigo ntashobora kwikorera.<verse eid="PSA 38:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />Ibikomere vyanje birasebuye kandi biranuka</para>
  <para style="q2" vid="PSA 38:5">kubera ivyaha vyanje vy’ubupfu.<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />Ncishijwe bugufi cane ndahetamye;</para>
  <para style="q2" vid="PSA 38:6">ngenda ngandaye bukarinda bwira.<verse eid="PSA 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />Umugongo wanje wuzuye ububabare bwinshi;</para>
  <para style="q2" vid="PSA 38:7">nta na hamwe nikoma.<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />Mfise intege nke, ndavunaguritse;</para>
  <para style="q2" vid="PSA 38:8">ngenda ngandaye mu mutima.<verse eid="PSA 38:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />Ivyo nipfuza vyose biri imbere yawe, ewe Mana;</para>
  <para style="q2" vid="PSA 38:9">ukuniha kwanje ntuguhishijwe.<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />Umutima wanje urahagaze, ncitse intege;</para>
  <para style="q2" vid="PSA 38:10">mbere n’amaso yanje ntagira umuco.<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />Abagenzi banje n’abo twagendana bampevye kubera ibikomere vyanje;</para>
  <para style="q2" vid="PSA 38:11">ababanyi banje bahagarara kure yanje.<verse eid="PSA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />Abagomba kunyica banteze imitego,</para>
  <para style="q2" vid="PSA 38:12">abagomba kungirira nabi bangira inama yo kunyica;</para>
  <para style="q2" vid="PSA 38:12">bavugana ibinyoma umusi wose bukarinda bwira.<verse eid="PSA 38:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />Meze nk’igipfamatwi, kidashobora kwumva,</para>
  <para style="q2" vid="PSA 38:13">nk’ikiragi, kidashobora kuvuga;<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />nabaye nk’uwutumva,</para>
  <para style="q2" vid="PSA 38:14">uwo akanwa kiwe kadashobora kwishura.<verse eid="PSA 38:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15" />
    <char style="nd">Uhoraho</char> we, ni wewe ndindiriye;</para>
  <para style="q2" vid="PSA 38:15">uzokwishura, Mwami Imana yanje.<verse eid="PSA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16" />Kuko navuze nti: “Ntubareke ngo banyitambe ku muvyimba</para>
  <para style="q2" vid="PSA 38:16">canke ngo banezerwe ninagwa hasi.”<verse eid="PSA 38:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17" />Kuko ngira ngwe hasi,</para>
  <para style="q2" vid="PSA 38:17">kandi umubabaro wanje ugumana nanje na ntaryo.<verse eid="PSA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18" />Ndatuye ukugabitanya kwanje;</para>
  <para style="q2" vid="PSA 38:18">mbujijwe amahoro n’icaha canje.<verse eid="PSA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19" />Benshi bahindutse abansi banje ata nyanduruko;</para>
  <para style="q2" vid="PSA 38:19">abanyanka ata nyanduruko babaye benshi.<verse eid="PSA 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20" />Abanyishura ibibi ku vyiza nabagiriye</para>
  <para style="q2" vid="PSA 38:20">bazanye ibirego bandega,</para>
  <para style="q2" vid="PSA 38:20">naho jewe ndazwa ishinga no gukora ivyiza gusa.<verse eid="PSA 38:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21" />
    <char style="nd">Uhoraho</char> ntumpebe;</para>
  <para style="q2" vid="PSA 38:21">ntube kure yanje, Mana yanje.<verse eid="PSA 38:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22" />Tebuka untabare,</para>
  <para style="q2" vid="PSA 38:22">Mwami wanje kandi Mukiza wanje.<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="cl">Zaburi ya 39</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Yahawe kandi Yedutuni. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1" />Naravuze nti: “Nzocungera inzira zanje</para>
  <para style="q2" vid="PSA 39:1">ndinde ururimi rwanje icaha;</para>
  <para style="q1" vid="PSA 39:1">nzoshira umurinzi ku munwa wanje</para>
  <para style="q2" vid="PSA 39:1">ndi imbere y’umunyakibi.”<verse eid="PSA 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2" />Ni co gituma nagumye mu gacerere,</para>
  <para style="q2" vid="PSA 39:2">ata n’iciza mvuga.</para>
  <para style="q1" vid="PSA 39:2">Ariko umubabaro wanje warongerekana;<verse eid="PSA 39:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 39:3" />umutima wanje waranshongeramwo.</para>
  <para style="q1" vid="PSA 39:3">Nkiriko ndavyiyumvira, umuriro waraka;</para>
  <para style="q2" vid="PSA 39:3">maze mvugisha ururimi rwanje nti:<verse eid="PSA 39:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4" />“<char style="nd">Uhoraho</char>, nyereka iherezo ry’ubuzima bwanje</para>
  <para style="q2" vid="PSA 39:4">n’igitigiri c’imisi yanje;</para>
  <para style="q2" vid="PSA 39:4">umpe kumenya ko ubuzima bwanje bumara akanya gato.<verse eid="PSA 39:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5" />Wahinduye imisi y’ukubaho kwanje uyinganya n’ikiganza gusa;</para>
  <para style="q2" vid="PSA 39:5">ikiringo c’imyaka yanje ni nk’aho ari ubusa kuri wewe.</para>
  <para style="q1" vid="PSA 39:5">Umuntu wese ni nk’impwemu zihumetswe gusa,</para>
  <para style="q2" vid="PSA 39:5">no ku baboneka ko bakingiwe.<verse eid="PSA 39:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6" />Ni ivy’ukuri umuntu wese agenda nk’igitutu gusa;</para>
  <para style="q2" vid="PSA 39:6">birukira ubusa, barondera ubutunzi</para>
  <para style="q2" vid="PSA 39:6">batazi uwuzobutahira kw’iherezo.<verse eid="PSA 39:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />Ariko noneho ubu ndondera iki, ewe Mana?</para>
  <para style="q2" vid="PSA 39:7">Ivyizigiro vyanje biri muri wewe.<verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />Nkiza ibigabitanyo vyanje vyose;</para>
  <para style="q2" vid="PSA 39:8">ntumpindure agatwengo k’ibipfu.<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />Nari ncereje; sinakurako umunwa,</para>
  <para style="q2" vid="PSA 39:9">kuko ari wewe wakoze ivyo.<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />Nkurako ikimoko cawe;</para>
  <para style="q2" vid="PSA 39:10">kuko nseserejwe cane n’inkoni zawe.<verse eid="PSA 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />Iyo uhanye ugakubita abantu kubera icaha cabo,</para>
  <para style="q2" vid="PSA 39:11">urya ubutunzi bwiwe nk’umuswa;</para>
  <para style="q2" vid="PSA 39:11">ni ukuri bose ni impwemu zihumetswe gusa.<verse eid="PSA 39:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />Niwumve ugusenga kwanje, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 39:12">wumvirize ugutakamba kwanje;</para>
  <para style="q2" vid="PSA 39:12">ntiwizibe amatwi ngo woye kwumva amarira yanje.</para>
  <para style="q1" vid="PSA 39:12">Mbana nawe nk’umunyamahanga,</para>
  <para style="q2" vid="PSA 39:12">nk’injabuka, nk’uko ba sogokuru banje bari bari.<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />Raba hirya, kugira ngo nsubire kunezererwa ubuzima</para>
  <para style="q2" vid="PSA 39:13">ntaragenda ngo sinze nongere kubaho.”<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="cl">Zaburi ya 40</para>
  <para style="d">Ni izaburi ya Dawidi, yahawe umukuru w’abaririmvyi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1" />Narorereye <char style="nd">Uhoraho</char> nihanganye;</para>
  <para style="q2" vid="PSA 40:1">na we arahindukira yumva ugutakamba kwanje.<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />Yankuye mu cobo c’ukwihebura,</para>
  <para style="q2" vid="PSA 40:2">ankura mu vyondo binyika;</para>
  <para style="q1" vid="PSA 40:2">ashinga ibirenge vyanje ku rutare</para>
  <para style="q2" vid="PSA 40:2">ampa aho guhagarara hakomeye.<verse eid="PSA 40:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />Yashize indirimbo nsha mu kanwa kanje,</para>
  <para style="q2" vid="PSA 40:3">indirimbo y’ishimwe ry’Imana yacu.</para>
  <para style="q1" vid="PSA 40:3">Benshi bazobibona bubahe <char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 40:3">maze bamwizigire.<verse eid="PSA 40:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />Hahiriwe umuntu</para>
  <para style="q2" vid="PSA 40:4">yizigira <char style="nd">Uhoraho</char>,</para>
  <para style="q1" vid="PSA 40:4">ntashire amaso ku bibone,</para>
  <para style="q2" vid="PSA 40:4">canke ku bahindukirira ibigirwamana.<verse eid="PSA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />
    <char style="nd">Uhoraho</char> Mana yanje,</para>
  <para style="q2" vid="PSA 40:5">ibitangaza wakoze ni vyinshi,</para>
  <para style="q2" vid="PSA 40:5">ivyo waduteguriye.</para>
  <para style="q1" vid="PSA 40:5">Nta cogereranywa nawe;</para>
  <para style="q2" vid="PSA 40:5">novuga ibikorwa vyawe,</para>
  <para style="q2" vid="PSA 40:5">vyoba vyinshi cane sinobimara.<verse eid="PSA 40:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />Ibimazi n’amashikanwa si vyo washatse;</para>
  <para style="q2" vid="PSA 40:6">ariko wuguruye amatwi yanje;</para>
  <para style="q2" vid="PSA 40:6">ibimazi bituriwe n’ibimazi vy’ivyaha ntivyaguhimbaye.<verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7" />Nuko ndavuga nti: “Ndi hano, ndaje; ni ko vyanditswe kuri jewe,</para>
  <para style="q2" vid="PSA 40:7">mu muzingo w’igitabu,<verse eid="PSA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8" />ndipfuza gukora ivyo ugomba, Mana yanje;</para>
  <para style="q2" vid="PSA 40:8">ivyagezwe vyawe biri mu mutima wanje.”<verse eid="PSA 40:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />Ndamamaza ibikorwa vyawe vyo kugororoka mw’ikoraniro rinini;</para>
  <para style="q2" vid="PSA 40:9">sincereza, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 40:9">nk’uko ubizi.<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />Sinyegeza ukugororoka kwawe mu mutima wanje;</para>
  <para style="q2" vid="PSA 40:10">ndavuga ukwizigirwa kwawe n’ugutabara kwawe.</para>
  <para style="q1" vid="PSA 40:10">Sinshira mu gisimbo urukundo rwawe n’ukwizigirwa kwawe</para>
  <para style="q2" vid="PSA 40:10">ngo ndabihishe mw’ikoraniro rinini.<verse eid="PSA 40:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />Ntunkureko imbabazi zawe, ewe <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 40:11">urukundo rwawe n’ubwizigirwa kwawe vyame binzigama.<verse eid="PSA 40:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />Kuko ivyago bitagira igitigiri binkikije;</para>
  <para style="q2" vid="PSA 40:12">ivyaha vyanje biramfashe, nanje nta vyo mbona.</para>
  <para style="q1" vid="PSA 40:12">Ni vyinshi nk’umushatsi wo ku mutwe wanje,</para>
  <para style="q2" vid="PSA 40:12">n’umutima wanje ucitse intege.<verse eid="PSA 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13" />
    <char style="nd">Uhoraho</char> we, emera kunkiza;</para>
  <para style="q2" vid="PSA 40:13">
    <char style="nd">Uhoraho</char>, tebuka untabare.<verse eid="PSA 40:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />Abagomba kunyica</para>
  <para style="q2" vid="PSA 40:14">nibamaramare bakorwe n’isoni;</para>
  <para style="q1" vid="PSA 40:14">abipfuza ko nohona bose</para>
  <para style="q2" vid="PSA 40:14">nibasubizwe inyuma bateterewe.<verse eid="PSA 40:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15" />Abambwira bati: “Aha! Aha!”</para>
  <para style="q2" vid="PSA 40:15">isoni zitume bazibwa akanwa.<verse eid="PSA 40:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16" />Ariko abakurondera bose</para>
  <para style="q2" vid="PSA 40:16">nibanezerwe bahimbarirwe muri wewe;</para>
  <para style="q1" vid="PSA 40:16">abipfuza ugutabarwa kwawe bame bavuga bati:</para>
  <para style="q2" vid="PSA 40:16">“<char style="nd">Uhoraho</char> arahambaye!”<verse eid="PSA 40:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17" />Ariko jeho ndi umworo, ndi umukene;</para>
  <para style="q2" vid="PSA 40:17">ariko Uhoraho arambabara.</para>
  <para style="q1" vid="PSA 40:17">Ni wewe mutabazi wanje n’umurokozi wanje;</para>
  <para style="q2" vid="PSA 40:17">ni wewe Mana yanje, ntutebe.<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="cl">Zaburi ya 41</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1" />Hahiriwe abababara umugorwa;</para>
  <para style="q2" vid="PSA 41:1">
    <char style="nd">Uhoraho</char> azobakiza mu gihe c’ivyago.<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />
    <char style="nd">Uhoraho</char> azobarinda abakingire;</para>
  <para style="q2" vid="PSA 41:2">bazoharurwa mu bahawe umugisha bo mu gihugu;</para>
  <para style="q2" vid="PSA 41:2">ntazobarekurira mu maboko y’abansi babo.<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />
    <char style="nd">Uhoraho</char> azobashigikira bari ku buriri bagwaye,</para>
  <para style="q2" vid="PSA 41:3">kandi azobasubizamwo inkomezi abahagurutse kuri ubwo buriri.<verse eid="PSA 41:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />Naravuze nti: “Ngirira imbabazi, ewe <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 41:4">unkize, kuko nagucumuyeko.”<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />Abansi banje bamvuga nabi bati:</para>
  <para style="q2" vid="PSA 41:5">“Azopfa ryari ngo izina ryiwe ryibagiranwe?”<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />Iyo umwe muri bo aje kundaba,</para>
  <para style="q2" vid="PSA 41:6">avuga ibinyoma, umutima wiwe uba wuzuye uruvugo;</para>
  <para style="q2" vid="PSA 41:6">maze yasohoka akarukwiza hose.<verse eid="PSA 41:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />Abansi banje bose bamvugira mu vyongoshwe;</para>
  <para style="q2" vid="PSA 41:7">banyipfuriza ibibi bavuga bati:<verse eid="PSA 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />“Yafashwe n’ingwara idakira;</para>
  <para style="q2" vid="PSA 41:8">ntazovyuka aho aryamye.”<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />N’umugenzi wanje pfampfe,</para>
  <para style="q2" vid="PSA 41:9">uwo nahora nizigira,</para>
  <para style="q1" vid="PSA 41:9">uwo twasangiye akabisi n’agahiye,</para>
  <para style="q2" vid="PSA 41:9">ni we yahindukiriye kungwanya.<verse eid="PSA 41:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />Ariko wewe <char style="nd">Uhoraho</char> ngirira imbabazi,</para>
  <para style="q2" vid="PSA 41:10">unkure hasi, kugira ngo ndabihore.<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />Ndazi ko unezerererwa,</para>
  <para style="q2" vid="PSA 41:11">kuko umwansi wanje atazonyitamba ku muvyimba.<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />Kubera gutungana kwanje uranzigama,</para>
  <para style="q2" vid="PSA 41:12">ukampagarika imbere yawe ibihe vyose.<verse eid="PSA 41:12" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13" />
    <char style="nd">Uhoraho</char> we, Imana ya Isirayeli nahimbazwe,</para>
  <para style="q2" vid="PSA 41:13">uhereye ibihe bidashira ukageza ibihe bidashira.</para>
  <para style="qc" vid="PSA 41:13">Amen kandi Amen.<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">Igitabu ca kabiri</para>
  <para style="mr">
    <ref loc="PSA 42-72">Zaburi 42–72</ref></para>
  <para style="cl">Zaburi ya 42</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni masikili<note caller="+" style="f"><char style="fr" closed="false">42:0 </char><char style="ft" closed="false">Ijambo </char><char style="fq" closed="false">Masikili </char><char style="ft" closed="false">rishobora kuba risigura ubwoko bw’icese canke bw’umudiho.</char></note> ya bene Kora.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />Nk’uko impongo ihuzagizwa irondera imigezi y’amazi,</para>
  <para style="q2" vid="PSA 42:1">ni ko n’umutima wanje uhuzagizwa ukwipfuza, ewe Mana yanje.<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />Umutima wanje unyoterewe Imana, Imana Nzima.</para>
  <para style="q2" vid="PSA 42:2">Nzogenda ryari kubonana n’Imana?<verse eid="PSA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />Amosozi yanje ni yo yabaye ivyokurya vyanje</para>
  <para style="q2" vid="PSA 42:3">ku murango no mw’ijoro,</para>
  <para style="q1" vid="PSA 42:3">mu gihe abantu bivugira bukarinda bwira bati:</para>
  <para style="q2" vid="PSA 42:3">“Imana yawe iri hehe?”<verse eid="PSA 42:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />Ibi ni vyo nibuka</para>
  <para style="q2" vid="PSA 42:4">umutima wanje ukameneka:</para>
  <para style="q1" vid="PSA 42:4">ingene nahora nja mu nzu y’Imana,</para>
  <para style="q2" vid="PSA 42:4">nkingiwe n’Inyenkomezi,</para>
  <para style="q1" vid="PSA 42:4">ndi mu mashimwe n’impundu,</para>
  <para style="q2" vid="PSA 42:4">ndi kumwe n’abantu benshi banezerewe.<verse eid="PSA 42:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />Mutima wanje, ni igiki gitumye wicurikira?</para>
  <para style="q2" vid="PSA 42:5">Ni igiki gitumye umpagararamwo?</para>
  <para style="q1" vid="PSA 42:5">Niwizigire Imana,</para>
  <para style="q2" vid="PSA 42:5">kuko nzosubira kumuhimbaza,</para>
  <para style="q2" vid="PSA 42:5">Umukiza wanje n’Imana yanje.<verse eid="PSA 42:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6" />Umutima wanje wicurikiriye muri jewe;</para>
  <para style="q2" vid="PSA 42:6">ni co gituma nzokwibuka</para>
  <para style="q1" vid="PSA 42:6">ndi mu ntara ya Yorodani,</para>
  <para style="q2" vid="PSA 42:6">mu bushorishori bwa Herumoni; ndi ku musozi Mizari.<verse eid="PSA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7" />Idamba rihamagara irindi damba</para>
  <para style="q2" vid="PSA 42:7">mu gusuma kw’amazi asuma;</para>
  <para style="q1" vid="PSA 42:7">imikuba yawe yose n’imipfunda yawe</para>
  <para style="q2" vid="PSA 42:7">birandengeye.<verse eid="PSA 42:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8" />Ku murango <char style="nd">Uhoraho</char> arongora urukundo rwiwe,</para>
  <para style="q2" vid="PSA 42:8">mw’ijoro indirimbo yiwe ibana nanje;</para>
  <para style="q2" vid="PSA 42:8">nk’isengesho ku Mana y’ubugingo bwanje.<verse eid="PSA 42:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9" />Ndabwira Imana Gitandara canje nti:</para>
  <para style="q2" vid="PSA 42:9">“Ni kuki wanyibagiye?</para>
  <para style="q1" vid="PSA 42:9">Ni igiki cotuma ngenda ngandaye,</para>
  <para style="q2" vid="PSA 42:9">kubera guhahazwa n’umwansi wanje?”<verse eid="PSA 42:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10" />Amagufa yanje avunagurikiye muri jewe,</para>
  <para style="q2" vid="PSA 42:10">kubera abansi banje bankindaga,</para>
  <para style="q1" vid="PSA 42:10">bukarinda bwira bambwira bati:</para>
  <para style="q2" vid="PSA 42:10">“Imana yawe iri hehe?”<verse eid="PSA 42:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11" />Mutima wanje, ni igiki gitumye wicurikira?</para>
  <para style="q2" vid="PSA 42:11">Ni igiki gitumye umpagararamwo?</para>
  <para style="q1" vid="PSA 42:11">Niwizigire Imana,</para>
  <para style="q2" vid="PSA 42:11">kuko nzosubira kuyihimbaza,</para>
  <para style="q2" vid="PSA 42:11">yo mukiza wanje n’Imana yanje.<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="cl">Zaburi ya 43</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1" />Ncira urubanza runkiza, ewe Mana yanje,</para>
  <para style="q2" vid="PSA 43:1">uburane urubanza rwanje</para>
  <para style="q2" vid="PSA 43:1">mfitaniye n’ihanga ritizigirwa.</para>
  <para style="q1" vid="PSA 43:1">Ntabara unkize abo bantu,</para>
  <para style="q2" vid="PSA 43:1">buzuye ubugunge n’ikibi.<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />Uri Imana, igihome kinkingira.</para>
  <para style="q2" vid="PSA 43:2">Ni igiki kikumpebesheje?</para>
  <para style="q1" vid="PSA 43:2">Ni igiki gituma mbayeho ngandaye,</para>
  <para style="q2" vid="PSA 43:2">mpahazwa n’umwansi?<verse eid="PSA 43:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />Ndungikira umuco wawe n’ukugira neza kwawe,</para>
  <para style="q2" vid="PSA 43:3">bibe ari vyo bindongora;</para>
  <para style="q1" vid="PSA 43:3">binshikane ku musozi wawe wera,</para>
  <para style="q2" vid="PSA 43:3">aho uba.<verse eid="PSA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />Maze nzoja ku gicaniro c’Imana,</para>
  <para style="q2" vid="PSA 43:4">ku Mana, yo munezero wanje n’ibihimbaro vyanje.</para>
  <para style="q1" vid="PSA 43:4">Nzoguhimbarisha ikembe,</para>
  <para style="q2" vid="PSA 43:4">ewe Mana, Mana yanje.<verse eid="PSA 43:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />Mutima wanje, ni igiki gitumye wicurikira?</para>
  <para style="q2" vid="PSA 43:5">Ni igiki gitumye umpagararamwo?</para>
  <para style="q1" vid="PSA 43:5">Niwizigire Imana,</para>
  <para style="q2" vid="PSA 43:5">kuko nzosubira kuyihimbaza,</para>
  <para style="q2" vid="PSA 43:5">yo mukiza wanje n’Imana yanje.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="cl">Zaburi ya 44</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni iya bene Kora. Ni <char style="tl">masikili.</char><note caller="+" style="f"><char style="fr" closed="false">44:0 </char><char style="ft" closed="false">Ijambo </char><char style="fq" closed="false">Masikili </char><char style="ft" closed="false">rishobora kuba risigura ubwoko bw’icese canke bw’umudiho.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1" />Mana, twavyumvishije amatwi yacu;</para>
  <para style="q2" vid="PSA 44:1">ba sogokuruza baratubwiye</para>
  <para style="q1" vid="PSA 44:1">ivyo wakoze mu bihe vyabo,</para>
  <para style="q2" vid="PSA 44:1">mu misi ya kera.<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />Wirukanye amahanga n’ukuboko kwawe</para>
  <para style="q2" vid="PSA 44:2">maze uzana ba sogokuruza bacu;</para>
  <para style="q1" vid="PSA 44:2">wirukanye amoko</para>
  <para style="q2" vid="PSA 44:2">maze utuma ba sogokuruza bacu basagarara.<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />Ntibaronse igihugu kubera inkota yabo,</para>
  <para style="q2" vid="PSA 44:3">kandi ntibanesheje kubera amaboko yabo;</para>
  <para style="q1" vid="PSA 44:3">kwari ukuboko kwawe kw’i buryo, ukuboko kwawe,</para>
  <para style="q2" vid="PSA 44:3">n’umuco wo mu nyonga hawe, kuko wabakunze.<verse eid="PSA 44:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />Uri Umwami wanje n’Imana yanje,</para>
  <para style="q2" vid="PSA 44:4">urategeka maze Yakobo akaronka intsinzi.<verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />Muri wewe ni ho dukinagiriza abansi bacu;</para>
  <para style="q2" vid="PSA 44:5">mw’izina ryawe dusiribangira hasi abatugwanya.<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />Sinizigira umuheto wanje,</para>
  <para style="q2" vid="PSA 44:6">inkota yanje si yo impa kunesha;<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />ariko ni wewe uduha kunesha abansi bacu,</para>
  <para style="q2" vid="PSA 44:7">utuma abatugwanya bamaramara.<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />Twirata Imana bukarinda bwira,</para>
  <para style="q2" vid="PSA 44:8">kandi tuzoguhimbaza ibihe vyose.<verse eid="PSA 44:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />Ariko ubu raba wadutaye uratumaramaza;</para>
  <para style="q2" vid="PSA 44:9">ntukijana n’ingabo zacu.<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />Watumye dusubiza imigongo inyuma imbere y’umwansi,</para>
  <para style="q2" vid="PSA 44:10">kandi abansi bacu batunyaze urukomba amazi.<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />Waradutanze turatabagurwa nk’intama</para>
  <para style="q2" vid="PSA 44:11">kandi wadusanzarije mu mahanga.<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />Wagurishije abantu bawe igiciro gitoya,</para>
  <para style="q2" vid="PSA 44:12">nta co wungutse umaze kubagurisha.<verse eid="PSA 44:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />Waduhinduye akamenyo ku babanyi bacu,</para>
  <para style="q2" vid="PSA 44:13">turacokorwa, dutwengwa n’abadukikuje.<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />Waduhinduye iciro ry’umugani mu mahanga;</para>
  <para style="q2" vid="PSA 44:14">abantu batuzunguriza imitwe.<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />Mba mu biteterwe bukarinda bwira,</para>
  <para style="q2" vid="PSA 44:15">kandi mu maso hanje nuzuye ibimaramare<verse eid="PSA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16" />kubera abitwengera bankora kw’itama,</para>
  <para style="q2" vid="PSA 44:16">kubera umwansi, ashaka kwihora.<verse eid="PSA 44:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />Ivyo vyose vyatubayeko,</para>
  <para style="q2" vid="PSA 44:17">naho tutari twakwibagiye;</para>
  <para style="q2" vid="PSA 44:17">ntitwari twahonyanze isezerano ryawe.<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />Imitima yacu ntiyari yasubiye inyuma;</para>
  <para style="q2" vid="PSA 44:18">ibirenge vyacu ntivyari vyanyereye ngo bive mu nzira yawe.<verse eid="PSA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19" />Ariko waratujanjaguye duhinduka umusaka w’imbwebwe;</para>
  <para style="q2" vid="PSA 44:19">wadupfukishije umwijima w’umuzitanya.<verse eid="PSA 44:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20" />Iyo tuba twaribagiye izina ry’Imana yacu</para>
  <para style="q2" vid="PSA 44:20">canke tukagaranzurira ibiganza vyacu imana y’inyamahanga,<verse eid="PSA 44:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21" />Imana ntiba yarabibonye,</para>
  <para style="q2" vid="PSA 44:21">ko izi amabanga yo mu mutima?<verse eid="PSA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22" />Ariko twirirwa turicwa kubera wewe, bukarinda bwira;</para>
  <para style="q2" vid="PSA 44:22">dufatwa nk’intama zijanywe kubagwa.<verse eid="PSA 44:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23" />Ikangure, ewe Mana! Ni kuki usinziriye?</para>
  <para style="q2" vid="PSA 44:23">Va hasi! Ntuduhebe ibihe bidashira.<verse eid="PSA 44:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24" />Ni kuki uduhisha mu nyonga hawe</para>
  <para style="q2" vid="PSA 44:24">ukibagira amagorwa tugowe n’agahahazo turimwo?<verse eid="PSA 44:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25" />Ducishijwe bugufi gushika mu mukungugu;</para>
  <para style="q2" vid="PSA 44:25">imibiri yacu irambaraye hasi.<verse eid="PSA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26" />Va hasi udutabare;</para>
  <para style="q2" vid="PSA 44:26">udutabare kubera urukundo rwawe rudashira.<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="cl">Zaburi ya 45</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Mw’ijwi ryitwa “Ikirungu.” Ni iya bene Kora. Ni masikili. Ni indirimbo y’ubukwe.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1" />Umutima wanje usimbagijwe n’amajambo meza</para>
  <para style="q2" vid="PSA 45:1">ndiko ndaririmbira umwami amajambo meza;</para>
  <para style="q2" vid="PSA 45:1">ururimi rwanje ni ikaramu y’umwanditsi w’umuhinga.<verse eid="PSA 45:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />Uri rurangiranwa mu bantu</para>
  <para style="q2" vid="PSA 45:2">kandi iminwa yawe yasizwe amavuta y’ubuntu,</para>
  <para style="q2" vid="PSA 45:2">kuko Imana yaguhaye umugisha ibihe bidashira.<verse eid="PSA 45:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />Hagatira inkota yawe kw’itako, ewe muhizi w’inkomezi;</para>
  <para style="q2" vid="PSA 45:3">ushazishe ubwiza n’igitinyiro.<verse eid="PSA 45:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4" />Mu cubahiro cawe gendera ku mukogote uje kunesha</para>
  <para style="q2" vid="PSA 45:4">ugwanire ukuri, uguca bugufi n’uguca imanza zibereye;</para>
  <para style="q2" vid="PSA 45:4">ukuboko kwawe kw’i buryo nigukore ibikomeye.<verse eid="PSA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5" />Imyampi yawe ikarishe nitobekeranye imitima y’abansi b’umwami;</para>
  <para style="q2" vid="PSA 45:5">amahanga nahindikirane imbere y’ibirenge vyawe.<verse eid="PSA 45:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6" />Ukuganza kwawe, ewe Mana, kuzokwamaho;</para>
  <para style="q2" vid="PSA 45:6">ubugororotsi ni ryo cumu ry’inganji y’ubwami bwawe.<verse eid="PSA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7" />Wakunze ubugororotsi, wanka ikibi;</para>
  <para style="q2" vid="PSA 45:7">ni co gituma Imana, ari yo Mana yawe, yagutoranije,</para>
  <para style="q2" vid="PSA 45:7">ikakurobanuza amavuta y’umunezero, ikakurutisha bagenzawe.<verse eid="PSA 45:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8" />Impuzu zawe zose zamoteshejwe neza n’imibavu, alowe n’akasiya;</para>
  <para style="q2" vid="PSA 45:8">ibicurarangisho vy’imirya birakunezereza,</para>
  <para style="q2" vid="PSA 45:8">vyumvikana bivuye mu mazu asharijwe n’amahembe y’inzovu.<verse eid="PSA 45:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9" />Abakobwa b’abami bari mu bagore b’icubahiro;</para>
  <para style="q2" vid="PSA 45:9">umugeni w’umwami ari i buryo bwawe yambaye inzahabu iva muri Ofiru.<verse eid="PSA 45:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10" />Umviriza, mukobwa wanje, kandi ubishireko umutima:</para>
  <para style="q2" vid="PSA 45:10">Wibagire ubwoko bwawe n’umuryango wawe.<verse eid="PSA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11" />Umwami yipfuze ubwiza bwawe;</para>
  <para style="q2" vid="PSA 45:11">umwubahe, kuko ari umwami wawe.<verse eid="PSA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12" />Igisagara c’i Tiro kizozana ingabire,</para>
  <para style="q2" vid="PSA 45:12">abantu bafise ubutunzi bazorondera ko ubaraba ryiza.<verse eid="PSA 45:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13" />Umukobwa w’umwami yambaye ubwiza ari mu cumba ciwe;</para>
  <para style="q2" vid="PSA 45:13">ikanzu yiwe idombagijeko inyuzi z’inzahabu.<verse eid="PSA 45:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14" />Ajanywe ku mwami yambaye impuzu zitewe amabara menshi;</para>
  <para style="q2" vid="PSA 45:14">inkumi zimuherekeje ziramukurikiye;</para>
  <para style="q2" vid="PSA 45:14">ni abazanywe ngo babane na we.<verse eid="PSA 45:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15" />Binjijwe mu munezero n’akaneza,</para>
  <para style="q2" vid="PSA 45:15">binjiye mu ngoro y’umwami.<verse eid="PSA 45:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16" />Abahungu bawe bazosubira mu kibanza ca ba sogokuruza banyu;</para>
  <para style="q2" vid="PSA 45:16">uzobagira abaganwa mu gihugu cose.<verse eid="PSA 45:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17" />Nanje nzokwibutsa abantu izina ryawe</para>
  <para style="q2" vid="PSA 45:17">uko urunganwe ruzogenda rukuranwa n’urundi;</para>
  <para style="q2" vid="PSA 45:17">ni co gituma amahanga azoguhimbaza ibihe bidashira.<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="cl">Zaburi ya 46</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni iya bene Kora. Mw’ijwi ryitwa alamoti. Ni indirimbo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1" />Imana ni yo buhungiro bwacu n’inkomezi</para>
  <para style="q2" vid="PSA 46:1">ni umufasha atabura guseruka mu magorwa.<verse eid="PSA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2" />Ni co gituma tutazotinya, naho isi yonyiganyiga</para>
  <para style="q2" vid="PSA 46:2">n’imisozi ikagwa mw’ibenga ry’ikiyaga,<verse eid="PSA 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3" />naho amazi yaco yosuriranya akuzura ifuro</para>
  <para style="q2" vid="PSA 46:3">agatera n’imisozi kunyiganyiga.<verse eid="PSA 46:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4" />Hari uruzi rufise amazi ahimbara igisagara c’Imana,</para>
  <para style="q2" vid="PSA 46:4">ahera aho Iyisumbavyose iba.<verse eid="PSA 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5" />Imana iri muri wo, ntuzonyiganyiga;</para>
  <para style="q2" vid="PSA 46:5">Imana izowutabara umutwenzi utambitse.<verse eid="PSA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6" />Amahanga avugije urwamo, ubwami buranyiganyize;</para>
  <para style="q2" vid="PSA 46:6">yumvikanishije ijwi ryayo, maze isi irashonga.<verse eid="PSA 46:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7" />
    <char style="nd">Uhoraho</char> Mushoboravyose ari kumwe natwe;</para>
  <para style="q2" vid="PSA 46:7">Imana ya Yakobo ni yo gihome kidukingira.<verse eid="PSA 46:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8" />Nimuze murabe ivyo <char style="nd">Uhoraho</char> yakoze,</para>
  <para style="q2" vid="PSA 46:8">ingene yasambaguye isi.<verse eid="PSA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9" />Yahagaritse intambara</para>
  <para style="q2" vid="PSA 46:9">gushika ku mpera z’isi.</para>
  <para style="q1" vid="PSA 46:9">Yavunaguye umuheto acagagura icumu;</para>
  <para style="q2" vid="PSA 46:9">yaturiye umukogote mu muriro.<verse eid="PSA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10" />
    <char style="nd">Uhoraho</char> aravuga ati: “Nimutekereze, mumenye ko ndi Imana;</para>
  <para style="q2" vid="PSA 46:10">nzoshirwa hejuru mu mahanga yose,</para>
  <para style="q2" vid="PSA 46:10">nzoshirwa hejuru mw’isi.”<verse eid="PSA 46:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11" />
    <char style="nd">Uhoraho</char> Mushoboravyose ari kumwe natwe;</para>
  <para style="q2" vid="PSA 46:11">Imana ya Yakobo ni yo gihome kidukingira.<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="cl">Zaburi ya 47</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni iya bene Kora. Ni Zaburi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1" />Yemwe mahanga mwese, nimukome amashi;</para>
  <para style="q2" vid="PSA 47:1">nimushire ijwi hejuru muvugirize Imana impundu.<verse eid="PSA 47:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2" />Kuko <char style="nd">Uhoraho</char> Musumbavyose ateye ubwoba,</para>
  <para style="q2" vid="PSA 47:2">ni Umwami ahambaye aganza isi yose.<verse eid="PSA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3" />Yacishije bugufi amahanga musi yacu,</para>
  <para style="q2" vid="PSA 47:3">amoko yayashize musi y’ibirenge vyacu.<verse eid="PSA 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4" />Yadutoranirije umugabane wacu,</para>
  <para style="q2" vid="PSA 47:4">ivyirato vya Yakobo, uwo yakunze.<verse eid="PSA 47:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5" />Imana iduze mu mashimwe,</para>
  <para style="q2" vid="PSA 47:5">
    <char style="nd">Uhoraho</char> aduze mu majwi y’inzamba.<verse eid="PSA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6" />Nimuhimbaze Imana, nimuyihimbaze;</para>
  <para style="q2" vid="PSA 47:6">nimuhimbaze Umwami wacu, nimumuhimbaze.<verse eid="PSA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7" />Kuko Imana ari Umwami aganza isi yose;</para>
  <para style="q2" vid="PSA 47:7">nimumuririmbire Zaburi y’ishimwe.<verse eid="PSA 47:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8" />Imana iganje amahanga yose;</para>
  <para style="q2" vid="PSA 47:8">Imana ivyagiye ku ntebe yayo yera y’ubwami.<verse eid="PSA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9" />Abaganwa b’amahanga bakoraniye hamwe</para>
  <para style="q2" vid="PSA 47:9">nk’abantu b’Imana ya Aburahamu,</para>
  <para style="q1" vid="PSA 47:9">kuko abami bo mw’isi ari ab’Imana;</para>
  <para style="q2" vid="PSA 47:9">ni yo ishizwe hejuru cane.<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="cl">Zaburi ya 48</para>
  <para style="d">Ni indirimbo. Ni Zaburi ya bene Kora.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1" />
    <char style="nd">Uhoraho</char> arahambaye, abereye gushimwa,</para>
  <para style="q2" vid="PSA 48:1">mu gisagara c’Imana yacu, ku musozi wayo wera.<verse eid="PSA 48:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2" />Ni mwiza uteye igomwe,</para>
  <para style="q2" vid="PSA 48:2">utera umunezero isi yose,</para>
  <para style="q1" vid="PSA 48:2">Umusozi Siyoni ni nk’ubushorishori bwa Zafori,</para>
  <para style="q2" vid="PSA 48:2">ni wo gisagara c’Umwami ahambaye.<verse eid="PSA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3" />Imana iri mu minara yawo;</para>
  <para style="q2" vid="PSA 48:3">yiyerekanye ari yo gihome kiwukingira.<verse eid="PSA 48:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4" />Igihe abami baja hamwe,</para>
  <para style="q2" vid="PSA 48:4">igihe baza kuhatera bose,<verse eid="PSA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5" />barawubonye baratangara;</para>
  <para style="q2" vid="PSA 48:5">bafashwe n’ubwoba barahunga.<verse eid="PSA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6" />Guhinda agashitsi kwabafatiye aho,</para>
  <para style="q2" vid="PSA 48:6">bafashwe n’ibise nk’ivy’umugore agira avyare.<verse eid="PSA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7" />Wabasambuye nk’ubwato bw’i Tarushishi</para>
  <para style="q2" vid="PSA 48:7">busambuwe n’umuyaga uturutse mu buseruko.<verse eid="PSA 48:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8" />Nk’uko twavyumvise,</para>
  <para style="q2" vid="PSA 48:8">ni ko twabisanze</para>
  <para style="q1" vid="PSA 48:8">mu gisagara c’<char style="nd">Uhoraho</char> Mushoboravyose,</para>
  <para style="q2" vid="PSA 48:8">mu gisagara c’Imana yacu:</para>
  <para style="q1" vid="PSA 48:8">Imana irawukingira</para>
  <para style="q2" vid="PSA 48:8">ibihe bidashira.<verse eid="PSA 48:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9" />Yewe Mana, turi mu Ngoro yawe,</para>
  <para style="q2" vid="PSA 48:9">tuzirikana urukundo rwawe rudashira.<verse eid="PSA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10" />Yewe Mana, nk’uko izina ryawe riri,</para>
  <para style="q2" vid="PSA 48:10">ishimwe ryawe rishika ku mpera z’isi;</para>
  <para style="q2" vid="PSA 48:10">ukuboko kwawe kw’i buryo kwuzuye ukugororoka.<verse eid="PSA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11" />Umusozi Siyoni uranezerewe,</para>
  <para style="q2" vid="PSA 48:11">imihana y’i Buyuda irahimbawe</para>
  <para style="q2" vid="PSA 48:11">kubera amateka yawe.<verse eid="PSA 48:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12" />Nimutembere i Siyoni, muhazunguruke,</para>
  <para style="q2" vid="PSA 48:12">muharure iminara yaho,<verse eid="PSA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13" />mwihweze neza inzitiro zaho,</para>
  <para style="q2" vid="PSA 48:13">murabe iminara yaho,</para>
  <para style="q1" vid="PSA 48:13">kugira ngo muze mubibwire</para>
  <para style="q2" vid="PSA 48:13">abo mu runganwe ruzoza.<verse eid="PSA 48:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14" />Kuko iyo Mana ari yo Mana yacu ibihe n’ibihe;</para>
  <para style="q2" vid="PSA 48:14">ni yo izoturongora no gushika kw’iherezo.<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="cl">Zaburi ya 49</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni iya bene Kora. Ni Zaburi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1" />Yemwe mahanga mwese, nimwumve ibi;</para>
  <para style="q2" vid="PSA 49:1">yemwe ababa kuri iyi si mwese, nimwumvirize,<verse eid="PSA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2" />abaciye bugufi n’abashizwe hejuru,</para>
  <para style="q2" vid="PSA 49:2">baba abatunzi canke abakene:<verse eid="PSA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3" />Akanwa kanje kagira kavuge amajambo y’ubwenge;</para>
  <para style="q2" vid="PSA 49:3">ukurimbura kw’umutima wanje kuzobaha gutahura.<verse eid="PSA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4" />Ndahindukiriza ugutwi kwanje ku mugani;</para>
  <para style="q2" vid="PSA 49:4">mu murya w’inanga ndasigura igisokozo.<verse eid="PSA 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5" />Ni kuki notinya igihe imisi mibi ije,</para>
  <para style="q2" vid="PSA 49:5">mu gihe abantu b’ingunge bankikuje;<verse eid="PSA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6" />abizigira ubutunzi bwabo</para>
  <para style="q2" vid="PSA 49:6">bakirata ibihinda vyabo vyinshi?<verse eid="PSA 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7" />Nta n’umwe ashobora gucungura ubugingo bw’uwundi</para>
  <para style="q2" vid="PSA 49:7">canke ngo abutangire incungu ku Mana;<verse eid="PSA 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8" />incungu y’ubuzima bw’umuntu ni iy’igiciro kinini,</para>
  <para style="q2" vid="PSA 49:8">nta co umuntu yoriha ngo akwize ikiguzi;<verse eid="PSA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9" />kugira ngo barambe ibihe vyose</para>
  <para style="q2" vid="PSA 49:9">ntibabone ukubora.<verse eid="PSA 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10" />Kuko mbona ko umunyabwenge apfa,</para>
  <para style="q2" vid="PSA 49:10">igipfu n’ikijuju na bo bagahona,</para>
  <para style="q2" vid="PSA 49:10">bagasigira abandi ubutunzi bwabo.<verse eid="PSA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11" />Imva zabo ni zo zizoba amazu yabo y’ibihe bidashira,</para>
  <para style="q2" vid="PSA 49:11">aho bazoba ibihe bizokuranwa n’ibindi,</para>
  <para style="q2" vid="PSA 49:11">naho amatongo yabo bari bayise amazina yabo.<verse eid="PSA 49:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12" />Abantu naho bogira ibihinda, ntibahoraho;</para>
  <para style="q2" vid="PSA 49:12">bameze nk’ibikoko bipfa gusa.<verse eid="PSA 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13" />Iyi ni yo nzira y’abiyizigira,</para>
  <para style="q2" vid="PSA 49:13">n’ababakurikira, bakunda ivyo bavuga.<verse eid="PSA 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14" />Bameze nk’intama kandi bagerewe gupfa;</para>
  <para style="q2" vid="PSA 49:14">urupfu ni rwo ruzoba umwungere wabo</para>
  <para style="q2" vid="PSA 49:14">(ariko abatunganye bazobasiribanga mu gitondo).</para>
  <para style="q1" vid="PSA 49:14">Ubwiza bwabo buzoborera mu mva,</para>
  <para style="q2" vid="PSA 49:14">kure y’amazu yabo ajererenze.<verse eid="PSA 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15" />Ariko Imana izoncungura inkure ahantu h’abapfuye;</para>
  <para style="q2" vid="PSA 49:15">ni ukuri izonjana iwe.<verse eid="PSA 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16" />Ntuze ugire ubwoba abandi nibarushaho gutunga,</para>
  <para style="q2" vid="PSA 49:16">ubwiza bw’amazu yabo bukaba bwinshi;<verse eid="PSA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17" />kuko ata co bazojana nibapfa,</para>
  <para style="q2" vid="PSA 49:17">ubwiza bwabo ntibuzojana na bo.<verse eid="PSA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18" />Naho igihe bakiriho biyita abahirwe;</para>
  <para style="q2" vid="PSA 49:18">kandi bagakomerwa amashi kubera ivyo bashitseko;<verse eid="PSA 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19" />bazohamvya ababitangiye imbere,</para>
  <para style="q2" vid="PSA 49:19">batazosubira kubona umuco w’ubugingo.<verse eid="PSA 49:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20" />Abantu bafise ubutunzi ariko badafise ugutahura</para>
  <para style="q2" vid="PSA 49:20">bameze nk’ibikoko bipfa.<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="cl">Zaburi ya 50</para>
  <para style="d">Ni Zaburi ya Asafu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1" />Inyenkomezi, Imana, <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 50:1">aravuze ahamagara abo mw’isi</para>
  <para style="q2" vid="PSA 50:1">uhereye iyo izuba riserukira ukageza iyo rirengera.<verse eid="PSA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2" />Kuva i Siyoni, h’ubwiza buhebuje,</para>
  <para style="q2" vid="PSA 50:2">Imana irakayanganye.<verse eid="PSA 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3" />Imana yacu iraje</para>
  <para style="q2" vid="PSA 50:3">kandi ntizocereza;</para>
  <para style="q1" vid="PSA 50:3">umuriro uratongora imbere yayo,</para>
  <para style="q2" vid="PSA 50:3">kandi akikijwe n’igihuhusi gihambaye.<verse eid="PSA 50:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4" />Ahamagara amajuru yo hejuru,</para>
  <para style="q2" vid="PSA 50:4">agahamagara n’isi, kugira ngo acire imanza abantu biwe ati:<verse eid="PSA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5" />“Nimunyegeranirize aba bantu batoranijwe,</para>
  <para style="q2" vid="PSA 50:5">abo twagiranye isezerano na bo hatanzwe ikimazi.”<verse eid="PSA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6" />Kandi amajuru yamamaza ukugororoka kwiwe,</para>
  <para style="q2" vid="PSA 50:6">kuko ari Imana ica imanza zibereye.<verse eid="PSA 50:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7" />“Nimwumve, bantu banje, kuko ngira mvuge;</para>
  <para style="q2" vid="PSA 50:7">nzokwagiriza, ewe Isirayeli:</para>
  <para style="q2" vid="PSA 50:7">ndi Imana, Imana yawe.<verse eid="PSA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8" />Sinzozana ivyo kukwagiriza bijanye n’ibimazi vyawe</para>
  <para style="q2" vid="PSA 50:8">canke bijanye n’amashikanwa yawe aturiwe,</para>
  <para style="q2" vid="PSA 50:8">vyama imbere yanje na ntaryo.<verse eid="PSA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9" />Sinkeneye impfizi zivuye mu mpongore zanyu</para>
  <para style="q2" vid="PSA 50:9">canke impene zo mu mpongore zanyu,<verse eid="PSA 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10" />kuko ibikoko vyose vyo mw’ishamba ari ivyanje,</para>
  <para style="q2" vid="PSA 50:10">n’amasho yo ku mirambi igihumbi.<verse eid="PSA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11" />Ndazi inyoni zose zo ku misozi,</para>
  <para style="q2" vid="PSA 50:11">n’udukoko tuguruka two ku misozi ni utwanje.<verse eid="PSA 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12" />Nosonza sinobikubwira,</para>
  <para style="q2" vid="PSA 50:12">kuko isi ari iyanje, n’ibiri muri yo vyose.<verse eid="PSA 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13" />Mbega ndarya inyama z’impfizi</para>
  <para style="q2" vid="PSA 50:13">canke ndanywa amaraso y’impene?<verse eid="PSA 50:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14" />Nimushikanire Imana ikimazi c’ishimwe,</para>
  <para style="q2" vid="PSA 50:14">mushitse ivyo mwasezeraniye Iyisumbavyose,<verse eid="PSA 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15" />maze muze munyambaze mu gihe c’amagorwa;</para>
  <para style="q2" vid="PSA 50:15">nzobakiza, namwe muzompesha icubahiro.”<verse eid="PSA 50:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 50:16" />Ariko umunyakibi, Imana iramubwira iti:</para>
  <para style="q1" vid="PSA 50:16">“Wiruhiriza iki uvuga ivyagezwe vyanje</para>
  <para style="q2" vid="PSA 50:16">canke ucisha isezerano ryanje mu kanwa kawe?<verse eid="PSA 50:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17" />Ko wanka inyigisho zanje</para>
  <para style="q2" vid="PSA 50:17">ugatera ibitugu amajambo yanje.<verse eid="PSA 50:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18" />Ubonye umusuma wifatanya na we;</para>
  <para style="q2" vid="PSA 50:18">ugasangira umugabane wawe n’abasambanyi.<verse eid="PSA 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19" />Akanwa kawe ugakoresha mu kuvuga ibibi</para>
  <para style="q2" vid="PSA 50:19">kandi ururimi rwawe ruvuga ivy’ubugunge.<verse eid="PSA 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20" />Wicara uvuga nabi umuvukanyi wawe</para>
  <para style="q2" vid="PSA 50:20">ukararaza mwene nyoko bwite.<verse eid="PSA 50:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21" />Igihe wabikora nanje narihoreye,</para>
  <para style="q2" vid="PSA 50:21">nawe wibaza ngo turangana.</para>
  <para style="q1" vid="PSA 50:21">Ariko nzoguhana,</para>
  <para style="q2" vid="PSA 50:21">ibirego vyanje vyose ndabishire imbere yawe.<verse eid="PSA 50:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22" />Mumenye ibi, yemwe abibagira Imana,</para>
  <para style="q2" vid="PSA 50:22">kugira ngo sindabatabagure, mutagira gitabara.<verse eid="PSA 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23" />Abanshikanira ibimazi vy’ishimwe baba bampesheje icubahiro,</para>
  <para style="q2" vid="PSA 50:23">kandi abagendera mu bugororotsi nzobereka agakiza kanje.”<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="cl">Zaburi ya 51</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni Zaburi ya Dawidi. Igihe uwavugishwa n’Imana Natani yaza kuri we inyuma yaho Dawidi asambanye na Batisheba.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1" />Ngirira imbabazi, ewe Mana</para>
  <para style="q2" vid="PSA 51:1">kubera urukundo rwawe rudashira;</para>
  <para style="q1" vid="PSA 51:1">kubera impuhwe zawe nyinshi</para>
  <para style="q2" vid="PSA 51:1">nufute ibigabitanyo vyanje.<verse eid="PSA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2" />Nyoza ukugabitanya kwanje kwose</para>
  <para style="q2" vid="PSA 51:2">unyoze icaha canje.<verse eid="PSA 51:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />Kuko ndazi ibigabitanyo vyanje,</para>
  <para style="q2" vid="PSA 51:3">kandi icaha canje cama imbere yanje<verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />Nacumuye kuri wewe, wewe wenyene,</para>
  <para style="q2" vid="PSA 51:4">nakoze ibibi mu nyonga hawe;</para>
  <para style="q1" vid="PSA 51:4">ari na co gituma uvuga ukuri mu manza uca</para>
  <para style="q2" vid="PSA 51:4">kandi ata co ugawa iyo uciye urubanza.<verse eid="PSA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />Ni ukuri navukiye mu vyaha,</para>
  <para style="q2" vid="PSA 51:5">ndi umunyavyaha kuva mama akinsama inda.<verse eid="PSA 51:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />Ariko washatse ko mba umwizigirwa n’igihe nari mu nda;</para>
  <para style="q2" vid="PSA 51:6">wanyigishije ubwenge nkiri aho hantu hihishije.<verse eid="PSA 51:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />Unyogeshe ezobu, nanje ndahumanuka;</para>
  <para style="q2" vid="PSA 51:7">unyoze, nanje ndera derere kurusha shelegi.<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />Umpe kwumva umunezero n’agahimbare;</para>
  <para style="q2" vid="PSA 51:8">amagufa wavunaguye anezerwe.<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />Hisha inyonga zawe ivyaha vyanje</para>
  <para style="q2" vid="PSA 51:9">uhanagure ukugabitanya kwanje.<verse eid="PSA 51:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />Ureme muri jewe umutima utunganye, ewe Mana,</para>
  <para style="q2" vid="PSA 51:10">umpe umutima ushikamye.<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />Ntunyirukane mu nyonga hawe</para>
  <para style="q2" vid="PSA 51:11">canke ngo unkureko Mpwemu Yera wawe.<verse eid="PSA 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12" />Nsubiza umunezero w’agakiza kawe</para>
  <para style="q2" vid="PSA 51:12">umpe umutima ufise ishaka ryo kukwumvira.<verse eid="PSA 51:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13" />Ni ho nzokwigisha inzira zawe abagucumurako,</para>
  <para style="q2" vid="PSA 51:13">kugira ngo abanyavyaha baguhindukirire.<verse eid="PSA 51:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14" />Mbohora unkureko urubanza rw’amaraso, ewe Mana,</para>
  <para style="q2" vid="PSA 51:14">wewe Mana Mukiza wanje,</para>
  <para style="q2" vid="PSA 51:14">maze ururimi rwanje ruzoririmba ivyo kugororoka kwawe.<verse eid="PSA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15" />Ugurura iminwa yanje, ewe Mana,</para>
  <para style="q2" vid="PSA 51:15">maze akanwa kanje kazokwamamaza ishimwe ryawe.<verse eid="PSA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16" />Ntuhimbarwa n’ibimazi, iyo biba gutyo mba ndabikuzaniye,</para>
  <para style="q2" vid="PSA 51:16">amashikanwa aturiwe si yo unezerererwa.<verse eid="PSA 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17" />Ikimazi ngushikaniye, Mana, ni umutima umenetse;</para>
  <para style="q2" vid="PSA 51:17">umutima umenetse kandi ujanjaguritse</para>
  <para style="q2" vid="PSA 51:17">wewe, Mana, ntuzowukengera.<verse eid="PSA 51:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18" />Nibiguhimbare ugirire neza Siyoni,</para>
  <para style="q2" vid="PSA 51:18">wubake inzitiro z’i Yerusalemu.<verse eid="PSA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19" />Ni ho uzonezerererwa ibimazi vyo kugororoka,</para>
  <para style="q2" vid="PSA 51:19">amashikanwa aturiwe atagabanije;</para>
  <para style="q2" vid="PSA 51:19">n’amapfizi azotangwa ku gicaniro cawe.<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="cl">Zaburi ya 52</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni masikili ya Dawidi. Aho Dowegi Umunyedomu yari yagiye kwa Sawuli akamubwira ati: “Dawidi yagiye mu nzu kwa Ahimeleki.”</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1" />Ni kuki wirata ikibi, wa muhizi w’inkomezi?</para>
  <para style="q2" vid="PSA 52:1">Ni kuki wirata bukarinda bwira,</para>
  <para style="q2" vid="PSA 52:1">wa gatetereza mu nyonga z’Imana?<verse eid="PSA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2" />Wewe ukora ivy’ubugunge,</para>
  <para style="q2" vid="PSA 52:2">ururimi rwawe ruja inama yo kwica;</para>
  <para style="q2" vid="PSA 52:2">rumeze nk’urwembe rwakarihijwe.<verse eid="PSA 52:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3" />Ukunda ikibi kukirutisha iciza,</para>
  <para style="q2" vid="PSA 52:3">ibinyoma ukabirutisha ukuvuga ukuri.<verse eid="PSA 52:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4" />Ukunda ijambo ryose ryo kwonona,</para>
  <para style="q2" vid="PSA 52:4">ewe wa rurimi rw’ingunge!<verse eid="PSA 52:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5" />Ni ukuri Imana izogushitsako uguhona kw’ibihe bidashira:</para>
  <para style="q2" vid="PSA 52:5">izoguhonyanga igukwege igukure mw’ihema ryawe;</para>
  <para style="q2" vid="PSA 52:5">izokurandura igukure mw’isi y’abazima.<verse eid="PSA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6" />Abagororotsi bazobiraba batinye;</para>
  <para style="q2" vid="PSA 52:6">bazogutwenga, bavuge bati:<verse eid="PSA 52:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7" />“Ehe wa muntu</para>
  <para style="q2" vid="PSA 52:7">atigeze agira Imana ubuhungiro</para>
  <para style="q1" vid="PSA 52:7">ariko yishimiye ubutunzi bwiwe bwinshi</para>
  <para style="q2" vid="PSA 52:7">agashirwa hejuru n’uko yishe abandi!”<verse eid="PSA 52:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8" />Ariko jeho ndi nk’igiti c’umwelayo</para>
  <para style="q2" vid="PSA 52:8">gishurikira mu nzu y’Imana;</para>
  <para style="q1" vid="PSA 52:8">nzokwizigira urukundo rw’Imana rudashira</para>
  <para style="q2" vid="PSA 52:8">ibihe vyose.<verse eid="PSA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9" />Nzokwama ndagushimira ivyo wakoze</para>
  <para style="q2" vid="PSA 52:9">ndi mu bizigirwa bawe.</para>
  <para style="q1" vid="PSA 52:9">Kandi nzokwizigira izina ryawe,</para>
  <para style="q2" vid="PSA 52:9">kuko izina ryawe ari ryiza.<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="cl">Zaburi ya 53</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Iri mw’ijwi ryitwa mahalati. Ni masikili ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1" />Igipfu cibwira mu mutima kiti:</para>
  <para style="q2" vid="PSA 53:1">“Nta Mana iriho.”</para>
  <para style="q1" vid="PSA 53:1">Abantu nk’abo barononekaye, n’inzira zabo ni mbi;</para>
  <para style="q2" vid="PSA 53:1">nta wukora ivyiza, nta n’umwe.<verse eid="PSA 53:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2" />Imana irunguruka iri mw’ijuru</para>
  <para style="q2" vid="PSA 53:2">ikitegereza abana b’abantu</para>
  <para style="q1" vid="PSA 53:2">ngo irabe ko hari n’umwe atahura,</para>
  <para style="q2" vid="PSA 53:2">ko hari n’umwe arondera Imana.<verse eid="PSA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3" />Bose barazimiye, bose barononekaye;</para>
  <para style="q2" vid="PSA 53:3">nta wukora ivyiza,</para>
  <para style="q2" vid="PSA 53:3">eka nta n’umwe.<verse eid="PSA 53:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4" />Mbega abo bantu b’inkozi z’ikibi nta co bazi?</para>
  <para style="b" vid="PSA 53:4" />
  <para style="q1" vid="PSA 53:4">Barya abantu banje nk’abarya umutsima;</para>
  <para style="q2" vid="PSA 53:4">ntibigera bambaza Imana.<verse eid="PSA 53:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5" />Ariko aho nyene ni ho ubwoba bubafatiye,</para>
  <para style="q2" vid="PSA 53:5">kandi ata kintu na kimwe co kubatera ubwoba.</para>
  <para style="q1" vid="PSA 53:5">Imana izosanzaza amagufa y’abaguteye;</para>
  <para style="q2" vid="PSA 53:5">uzobamaramaza, kuko Imana yabakengereye.<verse eid="PSA 53:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6" />Ese icompa agakiza ka Isirayeli kakaza kavuye i Siyoni!</para>
  <para style="q2" vid="PSA 53:6">Aho Imana izogarukanira abantu bayo;</para>
  <para style="q2" vid="PSA 53:6">aba Yakobo baze banezerwe kandi Isirayeli ihimbarwe!<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="cl">Zaburi ya 54</para>
  <para style="d">Yahawe umukuru w’abaririmvyi bavugira inanga. Ni masikili ya Dawidi. Ni igihe Abanyazifu bari bagiye kwa Sawuli bakavuga bati: “Mbega Dawidi ntiyinyegeje iwacu?”</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1" />Mana, nunkize ku bw’izina ryawe;</para>
  <para style="q2" vid="PSA 54:1">ngwanira ku bw’inkomezi zawe.<verse eid="PSA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2" />Mana, niwumve ugusenga kwanje;</para>
  <para style="q2" vid="PSA 54:2">niwumvirize amajambo y’akanwa kanje.<verse eid="PSA 54:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3" />Abansi bibona baje kuntera;</para>
  <para style="q2" vid="PSA 54:3">abicanyi bagomba kunyica;</para>
  <para style="q2" vid="PSA 54:3">abantu batababaye Imana.<verse eid="PSA 54:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4" />Ni ukuri Imana ni yo mutabazi wanje;</para>
  <para style="q2" vid="PSA 54:4">Uhoraho ni we anshigikira.<verse eid="PSA 54:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5" />Ikibi nigisubire ku bamvuga nabi;</para>
  <para style="q2" vid="PSA 54:5">mu bwizigirwa bwawe nubasangangure.<verse eid="PSA 54:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6" />Nzogushikanira ikimazi n’umutima ubikunze;</para>
  <para style="q2" vid="PSA 54:6">nzoshima izina ryawe, <char style="nd">Uhoraho</char>, kuko ari ryiza.<verse eid="PSA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7" />Wantabaye mu magorwa yanje yose,</para>
  <para style="q2" vid="PSA 54:7">kandi amaso yanje yiboneye ukuneshwa kw’abansi banje.<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="cl">Zaburi ya 55</para>
  <para style="d">Yahawe umukuru w’abaririmvyi baririmbisha inanga. Ni masikili ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1" />Niwumve ugusenga kwanje, Mana,</para>
  <para style="q2" vid="PSA 55:1">ntiwirengagize ugutakamba kwanje;<verse eid="PSA 55:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 55:2" />Nunyumve kandi unyishure.</para>
  <para style="q1" vid="PSA 55:2">Ivyiyumviro vyo muri jewe bimbujije amahoro kandi ncitse intege<verse eid="PSA 55:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 55:3" />kubera ivyo umwansi wanje avuga,</para>
  <para style="q2" vid="PSA 55:3">kubera ibiteye ubwoba vy’umunyakibi;</para>
  <para style="q1" vid="PSA 55:3">kuko banteje amarushwa</para>
  <para style="q2" vid="PSA 55:3">bakaza kuntera buzuye uburake.<verse eid="PSA 55:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4" />Umutima wanje ubuze uburagamo;</para>
  <para style="q2" vid="PSA 55:4">ibiteye ubwoba vy’urupfu vyanyubikijeko.<verse eid="PSA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5" />Ubwoba no guhinda agashitsi bintaye hagati;</para>
  <para style="q2" vid="PSA 55:5">nishwe n’ubwoba.<verse eid="PSA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6" />Naravuze nti: “Iyo mba nari mfise amababa y’akanuma Kolombe!</para>
  <para style="q2" vid="PSA 55:6">Nogurutse nkaja aho kuruhukira.<verse eid="PSA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7" />Nohungiye kure</para>
  <para style="q2" vid="PSA 55:7">nkigumira mu bugaragwa;<verse eid="PSA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8" />Nokwirukiye mu buhungiro bwanje,</para>
  <para style="q2" vid="PSA 55:8">kure y’isegenya n’igihuhusi.”<verse eid="PSA 55:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9" />Ewe Mana, maramaza abanyakibi, amajambo yabo anyurane,</para>
  <para style="q2" vid="PSA 55:9">kuko mbona umuryano n’intambara mu gisagara.<verse eid="PSA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10" />Ku murango no mw’ijoro bazunguruka ku nzitiro zaco;</para>
  <para style="q2" vid="PSA 55:10">ivyago n’amarushwa biri hagati muri co.<verse eid="PSA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11" />Mu gisagara baricana;</para>
  <para style="q2" vid="PSA 55:11">ivyago n’amarushwa vyahatse indaro.<verse eid="PSA 55:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12" />Iyo aba ari umwansi ariko arantuka,</para>
  <para style="q2" vid="PSA 55:12">nari kuvyihanganira;</para>
  <para style="q1" vid="PSA 55:12">iyo yari kuba ari umwansi wanje ampagurukiye kungwanya,</para>
  <para style="q2" vid="PSA 55:12">nari kwinyegeza.<verse eid="PSA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13" />Ariko ni wewe, umuntu nkanje,</para>
  <para style="q2" vid="PSA 55:13">uwo twagendana, umugenzi wanje wo hafi,<verse eid="PSA 55:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14" />uwo twahora dusangira akabisi n’agahiye</para>
  <para style="q2" vid="PSA 55:14">turi mu nzu y’Imana,</para>
  <para style="q1" vid="PSA 55:14">uwo twagendana</para>
  <para style="q2" vid="PSA 55:14">turi hagati y’abasenzi.<verse eid="PSA 55:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15" />Urupfu nirushike giturumbuka ku bansi banje;</para>
  <para style="q2" vid="PSA 55:15">bagende bakiri bazima iwabo w’abapfuye,</para>
  <para style="q2" vid="PSA 55:15">kuko bahaye indaro ikibi muri bo.<verse eid="PSA 55:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16" />Ariko jeho, nambaza Imana,</para>
  <para style="q2" vid="PSA 55:16">maze <char style="nd">Uhoraho</char> akankiza.<verse eid="PSA 55:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17" />Ku mugoroba, mu gitondo no ku murango</para>
  <para style="q2" vid="PSA 55:17">ntakambana agahinda,</para>
  <para style="q2" vid="PSA 55:17">na we akumva ijwi ryanje.<verse eid="PSA 55:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18" />Arantabara akantahana amahoro</para>
  <para style="q2" vid="PSA 55:18">ankuye mu ntambara y’abanteye,</para>
  <para style="q2" vid="PSA 55:18">naho abangwanya bakiri benshi.<verse eid="PSA 55:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19" />Imana, iri ku ntebe y’inganji uhereye kera hose,</para>
  <para style="q2" vid="PSA 55:19">ni Imana idahindagurika;</para>
  <para style="q1" vid="PSA 55:19">izobumva maze ibacishe bugufi,</para>
  <para style="q2" vid="PSA 55:19">kuko badatinya Imana.<verse eid="PSA 55:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20" />Uwahora ari umugenzi wanje ahiga abagenzi biwe;</para>
  <para style="q2" vid="PSA 55:20">yishe isezerano.<verse eid="PSA 55:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21" />Amajambo yiwe yoroshe nk’amavuta,</para>
  <para style="q2" vid="PSA 55:21">ariko mu mutima wiwe hari intambara;</para>
  <para style="q1" vid="PSA 55:21">amajambo yiwe mbere yoroshe kurusha amavuta,</para>
  <para style="q2" vid="PSA 55:21">ariko ni nk’inkota zakuwe mu rwubati.<verse eid="PSA 55:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22" />Uremeke imitwaro yawe <char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 55:22">na we azogushigikira;</para>
  <para style="q1" vid="PSA 55:22">ntazokwigera areka</para>
  <para style="q2" vid="PSA 55:22">umugororotsi ngo anyiganyizwe.<verse eid="PSA 55:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23" />Ariko wewe Mana, uzotsinda hasi abanyakibi</para>
  <para style="q2" vid="PSA 55:23">mu cobo co kubora;</para>
  <para style="q1" vid="PSA 55:23">abasesa amaraso n’ingunge</para>
  <para style="q2" vid="PSA 55:23">ntibazomara igice c’ubuzima bwabo.</para>
  <para style="q1" vid="PSA 55:23">Ariko jeho, nzokwizigira.<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="cl">Zaburi ya 56</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Iri mw’ijwi ryitwa “Inuma iri ku Kivumu nca kure.” Ni mikitamu ya Dawidi. Ni igihe Abafilisitiya bari bamufatiye i Gati.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1" />Ngirira imbabazi, Mana yanje,</para>
  <para style="q2" vid="PSA 56:1">kuko abansi banje bampiga cane;</para>
  <para style="q2" vid="PSA 56:1">barampiga bukarinda bwira.<verse eid="PSA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2" />Abangwanya barampiga bukarinda bwira;</para>
  <para style="q2" vid="PSA 56:2">ni benshi bampigana ubwibone bwabo.<verse eid="PSA 56:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3" />Igihe cose ngize ubwoba, ni wewe nizigira.<verse eid="PSA 56:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 56:4" />Nshimira Imana ivyo yasezeranye.</para>
  <para style="q1" vid="PSA 56:4">Imana ni yo nizigira singire ubwoba.</para>
  <para style="q2" vid="PSA 56:4">Mbe abantu buntu bongira iki?<verse eid="PSA 56:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5" />Bagoreka amajambo yanje bukarinda bwira;</para>
  <para style="q2" vid="PSA 56:5">nta kindi barota atari ukunyica.<verse eid="PSA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6" />Bagira inama, bakangenza,</para>
  <para style="q2" vid="PSA 56:6">bagenzura intambuko zanje,</para>
  <para style="q2" vid="PSA 56:6">bashaka kunyica.<verse eid="PSA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7" />Kubera ibibi vyabo ntubareke ngo bagende uko;</para>
  <para style="q2" vid="PSA 56:7">Mana, utsinde hasi amahanga mu burake bwawe.<verse eid="PSA 56:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8" />Ibuka amagorwa yanje;</para>
  <para style="q2" vid="PSA 56:8">andika amosozi yanje mu gitabu cawe;</para>
  <para style="q2" vid="PSA 56:8">mbega ntiwayanditse?<verse eid="PSA 56:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9" />Aho ni ho abansi banje bazosubira inyuma</para>
  <para style="q2" vid="PSA 56:9">ninatabaza.</para>
  <para style="q2" vid="PSA 56:9">Aho ni ho nzomenyera ko Imana iri mu ruhande rwanje.<verse eid="PSA 56:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10" />Imana, iyo nshimira amajambo yayo,</para>
  <para style="q2" vid="PSA 56:10">
    <char style="nd">Uhoraho</char>, uwo mpimbaza ijambo ryiwe;<verse eid="PSA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11" />Imana ni yo nizigira maze singire ubwoba.</para>
  <para style="q2" vid="PSA 56:11">Mbega umuntu yoshobora kungira iki?<verse eid="PSA 56:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12" />Naragusezeraniye Mana yanje;</para>
  <para style="q2" vid="PSA 56:12">nzogushikanira ikimazi c’ishimwe.<verse eid="PSA 56:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13" />Kuko wantabaye ukankura mu rupfu</para>
  <para style="q2" vid="PSA 56:13">n’ibirenge vyanje ukabirinda gutsitara,</para>
  <para style="q1" vid="PSA 56:13">kugira ngo nze ngendere imbere y’Imana</para>
  <para style="q2" vid="PSA 56:13">mu muco w’ubugingo.<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="cl">Zaburi ya 57</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Mw’ijwi ryitwa “Ntuhonye.” Ni mikitani ya Dawidi. Aho yari aheje guhunga Sawuli akaja mw’isenga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1" />Ngirira akagongwe, Mana yanje, ngirira akagongwe,</para>
  <para style="q2" vid="PSA 57:1">kuko muri wewe ari ho mpungiye.</para>
  <para style="q1" vid="PSA 57:1">Nzohungira mu gitutu c’amababa yawe</para>
  <para style="q2" vid="PSA 57:1">kugeza icago kirenganye.<verse eid="PSA 57:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2" />Ndatakambira Imana Musumbavyose,</para>
  <para style="q2" vid="PSA 57:2">Imana izoshitsa imigambi yayo myiza kuri jewe.<verse eid="PSA 57:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3" />Izondungikira ugutabarwa kuva mw’ijuru maze inkize,</para>
  <para style="q2" vid="PSA 57:3">ineshe abampigana ishavu;</para>
  <para style="q2" vid="PSA 57:3">Imana izorungika urukundo rwayo n’ukwizigirwa kwayo.<verse eid="PSA 57:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4" />Ndi hagati y’intambwe;</para>
  <para style="q2" vid="PSA 57:4">hagati y’ibikoko vy’inkazi;</para>
  <para style="q1" vid="PSA 57:4">abantu bafise amenyo ameze nk’amacumu n’imyampi,</para>
  <para style="q2" vid="PSA 57:4">indimi zabo zikamera nk’inkota zikarishe.<verse eid="PSA 57:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5" />Nushirwe hejuru, ewe Mana, hejuru y’amajuru;</para>
  <para style="q2" vid="PSA 57:5">icubahiro cawe gikwire kw’isi yose.<verse eid="PSA 57:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6" />Bateze umutego mu nzira ncamwo;</para>
  <para style="q2" vid="PSA 57:6">nciwe intege n’akabonge.</para>
  <para style="q1" vid="PSA 57:6">Banyimbiye icobo mu nzira yanje;</para>
  <para style="q2" vid="PSA 57:6">ariko ni bo bakiguyemwo ubwabo.<verse eid="PSA 57:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7" />Umutima wanje urashikamye, ewe Mana,</para>
  <para style="q2" vid="PSA 57:7">umutima wanje urashikamye;</para>
  <para style="q2" vid="PSA 57:7">nzoririmba ncurarange.<verse eid="PSA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8" />Mutima wanje, niwikangure!</para>
  <para style="q2" vid="PSA 57:8">Ewe nanga nawe kembe, nimwikangure!</para>
  <para style="q2" vid="PSA 57:8">Nzovyura umutwenzi.<verse eid="PSA 57:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9" />Ewe Mana, nzoguhimbaza mu moko menshi;</para>
  <para style="q2" vid="PSA 57:9">nzokuririmba ndi mu mahanga.<verse eid="PSA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10" />Kuko urukundo rwawe ari rwinshi, rushika no mu majuru;</para>
  <para style="q2" vid="PSA 57:10">ubwizigirwa bwawe bushika no mu birere.<verse eid="PSA 57:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11" />Nushirwe hejuru, Ewe Mana, hejuru y’amajuru;</para>
  <para style="q2" vid="PSA 57:11">icubahiro cawe gikwire kw’isi yose.<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="cl">Zaburi ya 58</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Mw’ijwi ryitwa “Ntuhonye.” Ni mikitamu ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1" />Mbega batware muvuga ivy’ukuri koko?</para>
  <para style="q2" vid="PSA 58:1">Mbega mucira abantu imanza mudahengamye?<verse eid="PSA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2" />Oya, mu mitima yanyu mutumbereye ikibi,</para>
  <para style="q2" vid="PSA 58:2">kandi amaboko yanyu yakoze ivy’umuryano kw’isi.<verse eid="PSA 58:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3" />No kuva bakivuka abanyakibi barazimiye;</para>
  <para style="q2" vid="PSA 58:3">kuva mu nda za ba nyina babandanije inzira zabo zo kubesha.<verse eid="PSA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4" />Ubumara bwabo ni nk’ubumara bw’inzoka,</para>
  <para style="q2" vid="PSA 58:4">ni nk’ubwo incira itumva yizivye amatwi,<verse eid="PSA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5" />itumva amajwi y’uwuyigunda,</para>
  <para style="q2" vid="PSA 58:5">naho yoba ari umuhinga yabimogoreye gute.<verse eid="PSA 58:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6" />Vunagura amenyo yo mu kanwa kabo, ewe Mana;</para>
  <para style="q2" vid="PSA 58:6">
    <char style="nd">Uhoraho</char>, menagura imibangabanga y’izo ntambwe!<verse eid="PSA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7" />Nibakamangane nk’amazi asheshwe kw’isi igadutse;</para>
  <para style="q2" vid="PSA 58:7">nibafora umuheto, imyampi yabo ntishike kure.<verse eid="PSA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8" />Nibabe nk’igifyera kigenda kirayonga,</para>
  <para style="q2" vid="PSA 58:8">nk’inda ikorotse itigeze ibona izuba.<verse eid="PSA 58:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9" />Imbere y’uko inkono zanyu zumva ubushuhe bw’amahwa yaka;</para>
  <para style="q2" vid="PSA 58:9">yaba ay’umye canke mabisi;</para>
  <para style="q2" vid="PSA 58:9">abanyakibi bazogurukanwa n’igihuhusi.<verse eid="PSA 58:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10" />Abagororotsi bazonezerwa niwabahora,</para>
  <para style="q2" vid="PSA 58:10">nibadibika ibirenge vyabo mu maraso y’abanyakibi.<verse eid="PSA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11" />Abantu bazovuga bati:</para>
  <para style="q2" vid="PSA 58:11">“Ni ukuri abagororotsi bahawe ingero;</para>
  <para style="q2" vid="PSA 58:11">ni ukuri hari Imana icira amateka isi.”<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="cl">Zaburi ya 59</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Iri mw’ijwi ryitwa “Ntuhonye.” Ni mikitamu. Ni igihe Sawuli yari yarungitse ingabo ngo babunde ku nzu ya Dawidi kugira ngo bamwice.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1" />Nkiza abansi banje, Mana;</para>
  <para style="q2" vid="PSA 59:1">mbera igihome kinkingira abaje kuntera.<verse eid="PSA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2" />Nkiza inkozi z’ikibi</para>
  <para style="q2" vid="PSA 59:2">ukize ubugingo bwanje abarondera gusesa amaraso yanje.<verse eid="PSA 59:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3" />Raba uburyo bambundiye!</para>
  <para style="q2" vid="PSA 59:3">Abantu b’ibirara bangira inama mbi</para>
  <para style="q2" vid="PSA 59:3">kandi ata gicumuro canke icaha nakoze, <char style="nd">Uhoraho</char>.<verse eid="PSA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4" />Nta kibi nakoze, ariko raba baje kuntera.</para>
  <para style="q2" vid="PSA 59:4">Va hasi untabare; raba ibiriko biraba!<verse eid="PSA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5" />Yewe <char style="nd">Uhoraho</char> Mana Mushoboravyose,</para>
  <para style="q2" vid="PSA 59:5">wewe Mana ya Isirayeli,</para>
  <para style="q1" vid="PSA 59:5">banguka uhane amahanga yose;</para>
  <para style="q2" vid="PSA 59:5">ntugirire impuhwe izo nkozi z’ikibi.<verse eid="PSA 59:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6" />Bagaruka bugorovye,</para>
  <para style="q2" vid="PSA 59:6">bakuga nk’imbwa,</para>
  <para style="q2" vid="PSA 59:6">bakazunguruka igisagara.<verse eid="PSA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7" />Raba ibiva mu kanwa kabo;</para>
  <para style="q2" vid="PSA 59:7">amajambo ava mu minwa yabo ikarishe nk’inkota,</para>
  <para style="q2" vid="PSA 59:7">maze bakiyumvira bati: “Ni nde atwumva?”<verse eid="PSA 59:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8" />Ariko uzobatwengera mw’ijigo, <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 59:8">uzokankamira ayo mahanga yose.<verse eid="PSA 59:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9" />Ni wewe nkomezi zanje, ni wewe niteze;</para>
  <para style="q2" vid="PSA 59:9">wewe, Mana, ni wewe gihome kinkingira,<verse eid="PSA 59:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 59:10" />Imana yanje nizigira.</para>
  <para style="b" vid="PSA 59:10" />
  <para style="q1" vid="PSA 59:10">Imana izonja imbere</para>
  <para style="q2" vid="PSA 59:10">izompa kwibonera uburyo abansi banje baneshwa.<verse eid="PSA 59:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11" />Ariko ntubice, ewe Mana, wewe nkinzo yacu,</para>
  <para style="q2" vid="PSA 59:11">kugira ngo ihanga ryanje ntiryibagire.</para>
  <para style="q1" vid="PSA 59:11">Mu nkomezi zawe, barandurane n’imizi</para>
  <para style="q2" vid="PSA 59:11">maze ubatsinde hasi.<verse eid="PSA 59:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12" />Kubera ivyaha vy’akanwa kabo,</para>
  <para style="q2" vid="PSA 59:12">kubera amajambo y’iminwa yabo,</para>
  <para style="q2" vid="PSA 59:12">nibafatwe mu bwibone bwabo.</para>
  <para style="q1" vid="PSA 59:12">Kubera ibitutsi n’ibinyoma bateguye,<verse eid="PSA 59:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 59:13" />batongoze uburake bwawe,</para>
  <para style="q2" vid="PSA 59:13">ubatongore ntibabe bakiboneka.</para>
  <para style="q1" vid="PSA 59:13">Ni ho bizomenyekana gushika ku mpera z’isi</para>
  <para style="q2" vid="PSA 59:13">ko Imana iganje mu ba Yakobo.<verse eid="PSA 59:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14" />Bagaruka bugorovye,</para>
  <para style="q2" vid="PSA 59:14">bakuga nk’imbwa,</para>
  <para style="q2" vid="PSA 59:14">bakazunguruka igisagara.<verse eid="PSA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15" />Bahunahuna barondera ico borya</para>
  <para style="q2" vid="PSA 59:15">bakaboroga iyo badahaze.<verse eid="PSA 59:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16" />Ariko jewe nzoririmba ivy’inkomezi zawe,</para>
  <para style="q2" vid="PSA 59:16">mu gitondo nzoririmba ivy’urukundo rwawe;</para>
  <para style="q1" vid="PSA 59:16">kuko uri igihome kinkingira,</para>
  <para style="q2" vid="PSA 59:16">ubuhungiro bwanje mu gihe c’amagorwa.<verse eid="PSA 59:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17" />Ni wewe nkomezi zanje, ndakuririmbira ishimwe;</para>
  <para style="q2" vid="PSA 59:17">Mana, wewe uri igihome kinkingira,</para>
  <para style="q2" vid="PSA 59:17">Imana yanje nizigira.<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="cl">Zaburi ya 60</para>
  <para style="d">Yahawe umukuru w’abaririmyi. Mw’ijwi ryitwa “Ishurwe ry’Isezerano.” Ni Mikitamu ya Dawidi. Ni iyo kwigisha. Yayanditse igihe yagwana na Aramu-Naharayimu hamwe na Aramu-Zoba, Yowabu na we avuye gutikiriza ibihumbi cumi na bibiri vy’Abanyedomu Kiyaya c’Umunyu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1" />Mana, waradutaye, kandi waduciyemwo imigwi;</para>
  <para style="q2" vid="PSA 60:1">waraturakiye; none ubu nutugarukane!<verse eid="PSA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2" />Wanyiganyije igihugu ugisiga ari umusaka;</para>
  <para style="q2" vid="PSA 60:2">none rero zibira ibihengeri vyaco,</para>
  <para style="q2" vid="PSA 60:2">kuko kiriko kirazungazunga.<verse eid="PSA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3" />Weretse abantu bawe ibihe bigoye;</para>
  <para style="q2" vid="PSA 60:3">watunywesheje umuvinyu utuma tudandabagirana.<verse eid="PSA 60:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4" />Ariko ku bakwubaha, wabadugirije ibendera</para>
  <para style="q2" vid="PSA 60:4">nk’ikimenyetso ngo bahunge imyampi y’ababateye.<verse eid="PSA 60:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5" />Dutabarishe ukuboko kwawe kw’i buryo, kandi utwishure;</para>
  <para style="q2" vid="PSA 60:5">kugira ngo abo ukunda bakire.<verse eid="PSA 60:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6" />Imana yavugiye ahera hayo iti:</para>
  <para style="q2" vid="PSA 60:6">“Mu kunesha kwanje nzogaburamwo ibice Shekemu,</para>
  <para style="q2" vid="PSA 60:6">kandi nzogeresha umugozi ikiyaya c’i Sukoti;<verse eid="PSA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7" />Gileyadi ni uwanje, kandi Manase ni uwanje;</para>
  <para style="q2" vid="PSA 60:7">Efurayimu ni we nkofero yanje,</para>
  <para style="q2" vid="PSA 60:7">Yuda ni icumu ryanje ry’ubugabe.<verse eid="PSA 60:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8" />Mowabu ni ibesani niyogeramwo,</para>
  <para style="q2" vid="PSA 60:8">kuri Edomu ni ho nkunkumurira ibirato vyanje;</para>
  <para style="q2" vid="PSA 60:8">Kuri Filisitiya ni ho nivugira amazina yo kunesha.”<verse eid="PSA 60:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9" />Ni nde azonshikana mu gisagara gikikujwe inzitiro?</para>
  <para style="q2" vid="PSA 60:9">Ni nde azondongora gushika kuri Edomu?<verse eid="PSA 60:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10" />Mbega si wewe ga Mana wadutaye,</para>
  <para style="q2" vid="PSA 60:10">ntube ukijana n’ingabo zacu ku rugamba?<verse eid="PSA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11" />Dufashe kugwanya umwansi,</para>
  <para style="q2" vid="PSA 60:11">kuko ugutabara kw’abantu ata co kumaze.<verse eid="PSA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12" />Turi kumwe n’Imana tuzonesha intambara,</para>
  <para style="q2" vid="PSA 60:12">kandi izosiribanga abansi bacu.<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="cl">Zaburi ya 61</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Bavugira inanga. Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1" />Niwumve ukurira kwanje;</para>
  <para style="q2" vid="PSA 61:1">umva ugusenga kwanje.<verse eid="PSA 61:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2" />Ndagutakambira ndi ku mpera z’isi,</para>
  <para style="q2" vid="PSA 61:2">ndagutabaza kuko umutima wanje unkabiraniyemwo;</para>
  <para style="q2" vid="PSA 61:2">undongorere ku gitandara kirekire kinsumba.<verse eid="PSA 61:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3" />Wamye uri ubuhungiro bwanje,</para>
  <para style="q2" vid="PSA 61:3">umunara ukomeye unkingira abansi.<verse eid="PSA 61:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4" />Ndipfuza kuba mw’ihema ryawe ibihe vyose</para>
  <para style="q2" vid="PSA 61:4">ngahungira mu bwihisho bw’amababa yawe.<verse eid="PSA 61:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5" />Kuko wewe, Mana, wumvise ivyo narahiye;</para>
  <para style="q2" vid="PSA 61:5">wampaye umugabane w’abubaha izina ryawe.<verse eid="PSA 61:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6" />Gwiza imisi yo kubaho kw’umwami,</para>
  <para style="q2" vid="PSA 61:6">imyaka yiwe uko urunganwe rukurikirana n’urundi.<verse eid="PSA 61:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7" />Niyimikirwe mu nyonga z’Imana ibihe vyose;</para>
  <para style="q2" vid="PSA 61:7">utume urukundo rwawe n’ubwizigirwa bwawe ngo bimuzigame.<verse eid="PSA 61:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8" />Maze nanje nzoririmba ishimwe ry’izina ryawe</para>
  <para style="q2" vid="PSA 61:8">nshitse n’ivyo narahiye umusi ku wundi.<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="cl">Zaburi ya 62</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Yahawe kandi Yedutuni. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1" />Ni ukuri umutima wanje uruhukira mu Mana;</para>
  <para style="q2" vid="PSA 62:1">agakiza kanje kava kuri yo.<verse eid="PSA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2" />Ni ukuri ni yo gitandara canje n’agakiza kanje:</para>
  <para style="q2" vid="PSA 62:2">ni yo gihome kinkingira, sinzokwigera nyiganyizwa.<verse eid="PSA 62:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3" />Muzogeza hehe kuntera?</para>
  <para style="q2" vid="PSA 62:3">Mbega mwese mugomba kuntsinda hasi;</para>
  <para style="q2" vid="PSA 62:3">nk’urusika ruhengamye, canke uruhome ruhomvokeye hasi?<verse eid="PSA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4" />Ni ukuri bagira inama yo kuntembagaza ngo bankure</para>
  <para style="q2" vid="PSA 62:4">ku ntebe yanje iri hejuru,</para>
  <para style="q2" vid="PSA 62:4">bahimbarwa n’ibinyoma.</para>
  <para style="q1" vid="PSA 62:4">Bahezagirisha akanwa kabo,</para>
  <para style="q2" vid="PSA 62:4">ariko mu mitima yabo bakavuma.<verse eid="PSA 62:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5" />Ego cane, mutima wanje, ruhukira mu Mana;</para>
  <para style="q2" vid="PSA 62:5">ivyizigiro vyanje biva kuri yo.<verse eid="PSA 62:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6" />Ni ukuri ni we gitandara canje n’agakiza kanje;</para>
  <para style="q2" vid="PSA 62:6">ni we gihome kinkingira, sinzonyiganyizwa.<verse eid="PSA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7" />Agakiza kanje n’icubahiro canje kiva ku Mana;</para>
  <para style="q2" vid="PSA 62:7">ni we gitandara canje gikomeye, ni ubuhungiro bwanje.<verse eid="PSA 62:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8" />Muze muhore mu mwizigira ibihe vyose, yemwe bantu;</para>
  <para style="q2" vid="PSA 62:8">mumugaragarize imitima yanyu,</para>
  <para style="q2" vid="PSA 62:8">kuko Imana ari yo buhungiro bwacu.<verse eid="PSA 62:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9" />Ni ukuri abantu bose ni nk’impwemu zihumetswe gusa,</para>
  <para style="q2" vid="PSA 62:9">abakuru n’abato ni ubusa gusa.</para>
  <para style="q1" vid="PSA 62:9">Iyo bagezwe ku munzane, basangwa ari ubusa;</para>
  <para style="q2" vid="PSA 62:9">bose hamwe ni impwemu zihumetswe gusa.<verse eid="PSA 62:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10" />Ntimwishimire uguhahaza</para>
  <para style="q2" vid="PSA 62:10">canke ngo ivyizigiro vyanyu mubishire ku vyasahuwe;</para>
  <para style="q1" vid="PSA 62:10">naho ubutunzi bwanyu bwokongerekana,</para>
  <para style="q2" vid="PSA 62:10">ntimubushireko umutima.<verse eid="PSA 62:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11" />Imana yavuze kimwe,</para>
  <para style="q2" vid="PSA 62:11">nanje numva bibiri:</para>
  <para style="q1" vid="PSA 62:11">Ubushobozi ni ubwawe, Mana,<verse eid="PSA 62:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 62:12" />kandi urukundo rudashira, ewe Mana, ruri kumwe nawe;</para>
  <para style="q1" vid="PSA 62:12">kandi, ugerera umuntu wese</para>
  <para style="q2" vid="PSA 62:12">ibikwiranye n’ivyo yakoze.<verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="cl">Zaburi ya 63</para>
  <para style="d">Ni Zaburi ya Dawidi. Yayirorimvye igihe yari mu bugaragwa bw’i Buyuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1" />Mana, ni wewe Mana yanje,</para>
  <para style="q2" vid="PSA 63:1">ndakuronderana umwete;</para>
  <para style="q1" vid="PSA 63:1">ndakunyotewe,</para>
  <para style="q2" vid="PSA 63:1">ibiri muri jewe vyose birakwipfuza,</para>
  <para style="q1" vid="PSA 63:1">ndi mu gihugu cumye kigadutse</para>
  <para style="q2" vid="PSA 63:1">kitagira amazi.<verse eid="PSA 63:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2" />Narakubonye uri ahera</para>
  <para style="q2" vid="PSA 63:2">nitegereza ubwiza bwawe n’ubushobozi bwawe.<verse eid="PSA 63:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3" />Kuko urukundo rwawe ari rwiza kurusha ubugingo,</para>
  <para style="q2" vid="PSA 63:3">iminwa yanje izogushima.<verse eid="PSA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4" />Nzogutazira nkiriho,</para>
  <para style="q2" vid="PSA 63:4">nzotarika amaboko yawe mw’izina ryawe.<verse eid="PSA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5" />Umutima wanje uzohazwa nk’uwariye ivyokurya biryoshe kurusha ibindi vyose;</para>
  <para style="q2" vid="PSA 63:5">akanwa kanje kazoguhimbaza iminwa yanje ikuririmbire.<verse eid="PSA 63:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6" />Ndyamye ku buriri bwanje ndakwibuka;</para>
  <para style="q2" vid="PSA 63:6">ndakwiyumvira iyo nteramye mw’ijoro.<verse eid="PSA 63:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7" />Kuko uri umutabazi wanje,</para>
  <para style="q2" vid="PSA 63:7">ndaririmbira musi y’igitutu c’amababa yawe.<verse eid="PSA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8" />Nzokwumirako;</para>
  <para style="q2" vid="PSA 63:8">ukuboko kwawe kw’i buryo kuranseguye.<verse eid="PSA 63:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9" />Abagomba kunyica bazohona;</para>
  <para style="q2" vid="PSA 63:9">bazomanuka baja i kuzimu.<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />Bazokwicishwa inkota</para>
  <para style="q2" vid="PSA 63:10">bahinduke inyama z’imbwebwe.<verse eid="PSA 63:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11" />Ariko umwami azonezererwa mu Mana;</para>
  <para style="q2" vid="PSA 63:11">uwirahira mw’izina ry’Imana azohimbarirwa muri we,</para>
  <para style="q2" vid="PSA 63:11">ariko akanwa k’ababeshi kazozibwa.<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="cl">Zaburi ya 64</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1" />Mana yanje, urumva ijwi ryanje ninagutakambira;</para>
  <para style="q2" vid="PSA 64:1">ukingire ubuzima bwanje kuko umwansi anteye ubwoba.<verse eid="PSA 64:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2" />Mpisha unkize inama z’abanyakibi,</para>
  <para style="q2" vid="PSA 64:2">unkize imigabo mibi y’inkozi z’ikibi.<verse eid="PSA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3" />Bakarisha indimi zabo nk’inkota</para>
  <para style="q2" vid="PSA 64:3">batumbereza amajambo yabo mabi nk’imyampi yica.<verse eid="PSA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4" />Barasa uwutagira icaha bamwibundiye;</para>
  <para style="q2" vid="PSA 64:4">bamutera atiteguye, badatinya.<verse eid="PSA 64:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5" />Baterana intege mu migambi yabo mibi,</para>
  <para style="q2" vid="PSA 64:5">bakavugana ivy’imitego yo mu mpisho;</para>
  <para style="q2" vid="PSA 64:5">bakavuga bati: “Ni nde abibona?”<verse eid="PSA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6" />Baja inama zo kurenganya abandi bakavuga bati:</para>
  <para style="q2" vid="PSA 64:6">“Twagize umugambi mwiza!”</para>
  <para style="q2" vid="PSA 64:6">Ni ukuri umutima w’umuntu uri n’ubugunge.<verse eid="PSA 64:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7" />Ariko Imana izobarasisha imyampi yayo;</para>
  <para style="q2" vid="PSA 64:7">bazokubitwa hasi giturumbuka.<verse eid="PSA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8" />Azobasubiza ku mitwe amajambo yabo mabi</para>
  <para style="q2" vid="PSA 64:8">abashitseko uguhona;</para>
  <para style="q2" vid="PSA 64:8">abazobabona bose bazobazunguriza imitwe babacokora.<verse eid="PSA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9" />Abantu bose bazotinya;</para>
  <para style="q2" vid="PSA 64:9">bazokwamamaza ibikorwa vy’Imana</para>
  <para style="q2" vid="PSA 64:9">batahure ivyo yakoze.<verse eid="PSA 64:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10" />Umugororotsi azonezererwa <char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 64:10">amuhungireko;</para>
  <para style="q2" vid="PSA 64:10">abatunganye mu mitima bose bazomunezerererwa!<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="cl">Zaburi ya 65</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni Zaburi ya Dawidi. Ni indirimbo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1" />Mana yacu, ubereye amashimwe uri i Siyoni;</para>
  <para style="q2" vid="PSA 65:1">tuzoshitsa ivyo twagusezeraniye.<verse eid="PSA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2" />Wewe wishura amasengesho,</para>
  <para style="q2" vid="PSA 65:2">abantu bose bazoza kuri wewe.<verse eid="PSA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3" />Aho twari turengewe n’ivyaha vyacu,</para>
  <para style="q2" vid="PSA 65:3">waduhariye ibigabitanyo vyacu.<verse eid="PSA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4" />Hahiriwe abantu utoranya</para>
  <para style="q2" vid="PSA 65:4">ukabiyegereza ngo babe mu rugo rw’Ingoro yawe.</para>
  <para style="q1" vid="PSA 65:4">Duhagijwe n’ivyiza vyo mu nzu yawe,</para>
  <para style="q2" vid="PSA 65:4">vyo mu Ngoro yawe yera.<verse eid="PSA 65:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5" />Utwirura mu bikorwa biteye ubwoba vyo kugororoka,</para>
  <para style="q2" vid="PSA 65:5">Mana Mukiza wacu,</para>
  <para style="q1" vid="PSA 65:5">wewe vyizigiro vyo ku mpera z’isi zose</para>
  <para style="q2" vid="PSA 65:5">n’ivy’ibiyaga vya kure,<verse eid="PSA 65:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6" />waremesheje imisozi ubushobozi bwawe,</para>
  <para style="q2" vid="PSA 65:6">wambaye inkomezi,<verse eid="PSA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7" />wewe wahojeje ukubomborana kw’ibiyaga,</para>
  <para style="q2" vid="PSA 65:7">ugusuriranya kw’imipfunda yavyo,</para>
  <para style="q2" vid="PSA 65:7">n’urwamo rw’amahanga.<verse eid="PSA 65:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8" />Isi yose irahinda agashitsi kubera ibitangaza vyawe;</para>
  <para style="q2" vid="PSA 65:8">bituma umutwenzi utambika, ahandi bukira,</para>
  <para style="q2" vid="PSA 65:8">ugahamagara indirimbo z’umunezero.<verse eid="PSA 65:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9" />Witwararika isi ukayivomerera;</para>
  <para style="q2" vid="PSA 65:9">ukayuzuzamwo ubutunzi bwinshi.</para>
  <para style="q1" vid="PSA 65:9">Imigezi y’Imana yuzuye amazi</para>
  <para style="q2" vid="PSA 65:9">ngo uhe abantu ivyimburwa vy’ibinyantete,</para>
  <para style="q2" vid="PSA 65:9">kuko ariko wabitegetse.<verse eid="PSA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10" />Wuzuza imivo yayo ukamenagura ibinonko;</para>
  <para style="q2" vid="PSA 65:10">uyibombekesha imvura ugaha umugisha ivyimburwa vyayo.<verse eid="PSA 65:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11" />Umwaka uwambika urugori ukoresheje ivyimburwa,</para>
  <para style="q2" vid="PSA 65:11">aho uciye haba ubutunzi bwinshi.<verse eid="PSA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12" />Imisozi yumye yo mu bugaragwa yambaye ivyimburwa;</para>
  <para style="q2" vid="PSA 65:12">uturambi watwambitse umunezero.<verse eid="PSA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13" />Imirambi yuzuyeko imikuku</para>
  <para style="q2" vid="PSA 65:13">n’ibiyaya vyuzuyemwo ingano;</para>
  <para style="q2" vid="PSA 65:13">bivuza impundu y’umunezero bikaririmba.<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="cl">Zaburi ya 66</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni indirimbo kandi ni Zaburi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1" />Yemwe abari kw’isi yose, nimuvugirize Imana impundu!<verse eid="PSA 66:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 66:2" />Muririmbe muhayagiza ubwiza bw’izina ryiwe;</para>
  <para style="q2" vid="PSA 66:2">mumuririmbire ishimwe.<verse eid="PSA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3" />Mubwire Imana muti: “Ese ukuntu ibikorwa vyawe biteye ubwoba!</para>
  <para style="q2" vid="PSA 66:3">Ubushobozi bwawe ni bwinshi</para>
  <para style="q2" vid="PSA 66:3">butuma abansi bawe bakwunamira.<verse eid="PSA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4" />Isi yose irakwunamira;</para>
  <para style="q2" vid="PSA 66:4">bakuririmbira ishimwe,</para>
  <para style="q2" vid="PSA 66:4">bahimbaza izina ryawe.”<verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5" />Nimuze murabe ivyo Imana yakoze,</para>
  <para style="q2" vid="PSA 66:5">ibihambaye yakoreye abana b’abantu!<verse eid="PSA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6" />Ikiyaga yagihinduye isi humye,</para>
  <para style="q2" vid="PSA 66:6">baciye mu kiyaga n’amaguru;</para>
  <para style="q2" vid="PSA 66:6">nimuze tunezererwe muri we.<verse eid="PSA 66:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7" />Aganza ibihe bidashira mu nkomezi ziwe,</para>
  <para style="q2" vid="PSA 66:7">inyonga ziwe zihora ku mahanga;</para>
  <para style="q2" vid="PSA 66:7">ntihagire abagarariji bahagurukira kumugwanya.<verse eid="PSA 66:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8" />Yemwe moko mwese, nimuhimbaze Imana yacu,</para>
  <para style="q2" vid="PSA 66:8">ijwi ryo kumuhimbaza nirisamirane;<verse eid="PSA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9" />yazigamye ubugingo bwacu</para>
  <para style="q2" vid="PSA 66:9">yarinze ibirenge vyacu kunyerera.<verse eid="PSA 66:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10" />Kuko wewe, Mana, wadusuzumye;</para>
  <para style="q2" vid="PSA 66:10">waducishije mu ruganda nk’ifeza.<verse eid="PSA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11" />Wadushize mw’ibohero</para>
  <para style="q2" vid="PSA 66:11">uduhekereza imitwaro ku migongo yacu.<verse eid="PSA 66:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12" />Waretse abantu ngo batugendereko;</para>
  <para style="q2" vid="PSA 66:12">twaciye mu muriro no mu mazi,</para>
  <para style="q2" vid="PSA 66:12">ariko wadushikanye ahantu h’umusesekara.<verse eid="PSA 66:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13" />Nzoza mu Ngoro yawe nzanye ibimazi vyo guturirwa n’umuriro,</para>
  <para style="q2" vid="PSA 66:13">kugira ngo nshitse ivyo nagusezeraniye;<verse eid="PSA 66:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14" />amasezerano nasezeranishije akanwa kanje iminwa yanje ikabivuga</para>
  <para style="q2" vid="PSA 66:14">ca gihe nari mu vyago.<verse eid="PSA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15" />Nzogushikanira ibinuze</para>
  <para style="q2" vid="PSA 66:15">n’ikimazi c’impfizi z’intama;</para>
  <para style="q2" vid="PSA 66:15">nzoshikana impfizi n’impene.<verse eid="PSA 66:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16" />Nimuze mwumvirize, yemwe abubaha Imana mwese;</para>
  <para style="q2" vid="PSA 66:16">reka ndababwire ivyo yankoreye.<verse eid="PSA 66:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17" />Narayitakambiye n’akanwa kanje;</para>
  <para style="q2" vid="PSA 66:17">ishimwe ryayo ryari ku rurimi rwanje.<verse eid="PSA 66:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18" />Iyo mba narahaye indaro icaha mu mutima wanje,</para>
  <para style="q2" vid="PSA 66:18">Imana ntiba yaranyumvirije.<verse eid="PSA 66:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19" />Ariko ni ukuri Imana yarumvirije</para>
  <para style="q2" vid="PSA 66:19">maze yumva ugusenga kwanje.<verse eid="PSA 66:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20" />Imana ishimwe,</para>
  <para style="q2" vid="PSA 66:20">itirengagije ugusenga kwanje</para>
  <para style="q2" vid="PSA 66:20">canke ngo inkureko urukundo rwayo!<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="cl">Zaburi ya 67</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Icurarangishwa ibicurarangisho vy’imirya. Ni Zaburi, kandi ni indirimbo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1" />Ese Imana, yotugirira ubuntu ikaduhezagira,</para>
  <para style="q2" vid="PSA 67:1">mu nyonga hayo tukaboneka dufise igikundiro;<verse eid="PSA 67:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2" />kugira ngo inzira zawe zimenyekane kw’isi,</para>
  <para style="q2" vid="PSA 67:2">n’agakiza kawe kamenyekane mu mahanga yose.<verse eid="PSA 67:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3" />Amoko naguhimbaze, ewe Mana;</para>
  <para style="q2" vid="PSA 67:3">amoko yose naguhimbaze.<verse eid="PSA 67:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4" />Ese amahanga yose yonezerwa akavuza impundu z’umunezero,</para>
  <para style="q2" vid="PSA 67:4">kuko urongora abantu bose mu bugororotsi</para>
  <para style="q2" vid="PSA 67:4">ukarongora amahanga yose yo kw’isi.<verse eid="PSA 67:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5" />Amoko naguhimbaze, ewe Mana;</para>
  <para style="q2" vid="PSA 67:5">amoko yose naguhimbaze.<verse eid="PSA 67:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6" />Isi yimbuka ivyimburwa vyayo;</para>
  <para style="q2" vid="PSA 67:6">ewe Mana, Mana yacu, duhe umugisha.<verse eid="PSA 67:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7" />Ese Imana yoduha umugisha,</para>
  <para style="q2" vid="PSA 67:7">kugira ngo abo ku mpera z’isi bose baze bayubahe.<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="cl">Zaburi ya 68</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni iya Dawidi. Ni Zaburi, kandi ni indirimbo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1" />Imana nihaguruke, abansi bayo bose basanzare;</para>
  <para style="q2" vid="PSA 68:1">abayanka bose nibahunge mu nyonga hayo.<verse eid="PSA 68:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2" />Ese wobatumurira kure nk’umwotsi;</para>
  <para style="q2" vid="PSA 68:2">nk’uko ishashara rishonga imbere y’umuriro,</para>
  <para style="q2" vid="PSA 68:2">ese abanyakibi bohonera imbere y’Imana.<verse eid="PSA 68:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3" />Ariko ese abagororotsi bohimbarwa</para>
  <para style="q2" vid="PSA 68:3">bakanezerererwa imbere y’Imana;</para>
  <para style="q2" vid="PSA 68:3">ese bonezerwa bakuzura akamwemwe.<verse eid="PSA 68:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4" />Nimuririmbire Imana, nimuririmbe mushima izina ryiwe,</para>
  <para style="q2" vid="PSA 68:4">mutegure inzira y’uwugendera ku bicu;</para>
  <para style="q2" vid="PSA 68:4">nimunezererwe imbere yiwe; izina ryiwe yitwa <char style="nd">Uhoraho</char>.<verse eid="PSA 68:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5" />Ni we se w’impfuvyi, uwutabara abapfakazi,</para>
  <para style="q2" vid="PSA 68:5">ni Imana iba ahera hayo.<verse eid="PSA 68:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6" />Imana ishira inyakamwe mu miryango,</para>
  <para style="q2" vid="PSA 68:6">isohora imbohe zikaririmba;</para>
  <para style="q2" vid="PSA 68:6">ariko abagarariji bazoba ahagadutse.<verse eid="PSA 68:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7" />Ewe Mana, igihe waja imbere y’ubwoko bwawe,</para>
  <para style="q2" vid="PSA 68:7">igihe wagendagenda mu bugaragwa,<verse eid="PSA 68:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8" />isi yaranyiganyize, amajuru arekura imvura,</para>
  <para style="q2" vid="PSA 68:8">imbere y’Imana, Imana y’i Sinayi,</para>
  <para style="q2" vid="PSA 68:8">imbere y’Imana, Imana ya Isirayeli.<verse eid="PSA 68:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9" />Watanze imvura nyinshi, ewe Mana;</para>
  <para style="q2" vid="PSA 68:9">wasubijemwo inkomezi umugabane wawe.<verse eid="PSA 68:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10" />Ubwoko bwawe bwahagize aho kuba,</para>
  <para style="q2" vid="PSA 68:10">mu kugira neza kwawe, ewe Mana, wagaburiye abakene.<verse eid="PSA 68:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11" />Imana yatanze ijambo,</para>
  <para style="q2" vid="PSA 68:11">abagore baryamamaza na bo bacika ingabo zikomeye:<verse eid="PSA 68:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12" />Abami n’ingabo barahunze;</para>
  <para style="q2" vid="PSA 68:12">abagore bibereye i muhira bagabura iminyago.<verse eid="PSA 68:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13" />Mbere n’abiryamiye mu mpongore z’intama baronka ubwatsi,</para>
  <para style="q2" vid="PSA 68:13">amababa y’inuma yanje asizwe ifeza,</para>
  <para style="q2" vid="PSA 68:13">amoya yayo na yo asize inzahabu ikayangana.<verse eid="PSA 68:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14" />Igihe Iyishoboravyose yirukana abami mu gihugu,</para>
  <para style="q2" vid="PSA 68:14">vyari bimeze nka shelegi yaguye ku musozi Zalumoni.<verse eid="PSA 68:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15" />Musozi Bashani, musozi w’ubwiza,</para>
  <para style="q2" vid="PSA 68:15">Musozi Bashani, musozi w’udutwe twinshi,<verse eid="PSA 68:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16" />ni kuki, ewe musozi w’udutwe twinshi, ugirira ishari</para>
  <para style="q2" vid="PSA 68:16">umusozi Imana yatoranije ngo ivyagireko,</para>
  <para style="q2" vid="PSA 68:16">aho <char style="nd">Uhoraho</char> ubwiwe azokwibera ibihe vyose?<verse eid="PSA 68:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17" />Imikogote y’Imana ni ibihumbi bidaharurika,</para>
  <para style="q2" vid="PSA 68:17">n’ibihumbi n’ibihumbi;</para>
  <para style="q2" vid="PSA 68:17">Uhoraho aturutse i Sinayi aje ahera hiwe.<verse eid="PSA 68:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18" />Aho waduga iyo hejuru,</para>
  <para style="q2" vid="PSA 68:18">wajanye iminyago myinshi;</para>
  <para style="q2" vid="PSA 68:18">wakiriye impano nyinshi mu bantu,</para>
  <para style="q1" vid="PSA 68:18">no mu bagarariji;</para>
  <para style="q2" vid="PSA 68:18">kugira ngo uhibere, wewe <char style="nd">Uhoraho</char> Mana.<verse eid="PSA 68:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19" />
    <char style="nd">Uhoraho</char> ahimbazwe, Imana yo Mukiza wacu,</para>
  <para style="q2" vid="PSA 68:19">atwikorerera imitwaro uko bukeye.<verse eid="PSA 68:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20" />Imana yacu ni Imana ikiza;</para>
  <para style="q2" vid="PSA 68:20">
    <char style="nd">Uhoraho</char> Nyeninganji ni we adukiza urupfu.<verse eid="PSA 68:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21" />Ni ukuri Imana izomenagura imitwe y’abansi bayo,</para>
  <para style="q2" vid="PSA 68:21">hamwe n’ibitsibo vy’umushatsi vy’abashishikara gukora ivyaha.<verse eid="PSA 68:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22" />Imana iravuze iti: “Nzobazana ndabakuye i Bashani;</para>
  <para style="q2" vid="PSA 68:22">nzobazana ndabakuye mw’idamba ry’ikiyaga,<verse eid="PSA 68:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23" />kugira ngo ibirenge vyanyu bihonyore mu maraso y’abansi banyu,</para>
  <para style="q2" vid="PSA 68:23">mu gihe indimi z’imbwa zanyu zizoronka umugabane wazo.”<verse eid="PSA 68:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24" />Turabona abakugendaniye, ewe Mana,</para>
  <para style="q2" vid="PSA 68:24">abagendaniye Imana yanje, Umwami wanje binjiye ahera hiwe.<verse eid="PSA 68:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25" />Imbere hari abaririmvyi, bakurikiwe n’abacuraranzi;</para>
  <para style="q2" vid="PSA 68:25">bari kumwe n’abigeme bavuza utugoma dutoduto.<verse eid="PSA 68:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26" />Himbaza Imana muri mw’ikoraniro rinini;</para>
  <para style="q2" vid="PSA 68:26">mutazire <char style="nd">Uhoraho</char> muri mw’ikoraniro rya Isirayeli.<verse eid="PSA 68:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27" />Ehe umuryango mutoya wa Benyamini, ni wo ubarongoye,</para>
  <para style="q2" vid="PSA 68:27">abaganwa ba Yuda n’ingabo zabo,</para>
  <para style="q2" vid="PSA 68:27">n’abaganwa ba Zebuloni na Nafutali.<verse eid="PSA 68:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28" />Hamagara ubushobozi bwawe, Mana;</para>
  <para style="q2" vid="PSA 68:28">utwereke inkomezi zawe, Mana yacu, nk’uko wabikoze kera.<verse eid="PSA 68:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29" />Abami bazokuzanira ingabire</para>
  <para style="q2" vid="PSA 68:29">mu Ngoro yawe i Yerusalemu.<verse eid="PSA 68:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30" />Kankamira ibikoko vyo mu marenga,</para>
  <para style="q2" vid="PSA 68:30">amapfizi yo mu masho y’amahanga.</para>
  <para style="q1" vid="PSA 68:30">Nibicishwe bugufi maze bizane imirava y’ifeza yo guhonga.</para>
  <para style="q2" vid="PSA 68:30">Sanzaza amahanga anezerererwa intambara.<verse eid="PSA 68:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31" />Intumwa zizoza zivuye muri Egiputa;</para>
  <para style="q2" vid="PSA 68:31">I Kushi hazoca bugufi imbere y’Imana.<verse eid="PSA 68:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32" />Nimuririmbire Imana, yemwe bwami bwo mw’isi,</para>
  <para style="q2" vid="PSA 68:32">nimutazire Uhoraho,<verse eid="PSA 68:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33" />uwugendera ahasuma ijuru, uwuganza amajuru,</para>
  <para style="q2" vid="PSA 68:33">uwuturagara n’ijwi ry’inkomezi.<verse eid="PSA 68:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34" />Nimumenyekanishe ubushobozi bw’Imana,</para>
  <para style="q2" vid="PSA 68:34">igitinyiro ciwe kiri kuri Isirayeli,</para>
  <para style="q2" vid="PSA 68:34">ubushobozi bwiwe buri mw’ijuru.<verse eid="PSA 68:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35" />Ewe Mana, uteye ubwoba uri ahera hawe;</para>
  <para style="q2" vid="PSA 68:35">Imana ya Isirayeli ni yo iha inkomezi abantu bayo.</para>
  <para style="b" vid="PSA 68:35" />
  <para style="q1" vid="PSA 68:35">Imana ishimwe!<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="cl">Zaburi ya 69</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Mw’ijwi ryitwa “Ikirungu.” Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1" />Mana, nkiza,</para>
  <para style="q2" vid="PSA 69:1">kuko amazi yaduze angeze mw’izosi.<verse eid="PSA 69:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2" />Ndiko ndanyika mu kinogo cuzuye ivyondo,</para>
  <para style="q2" vid="PSA 69:2">ata kinsama.</para>
  <para style="q1" vid="PSA 69:2">Nshitse mw’idamba ry’amazi;</para>
  <para style="q2" vid="PSA 69:2">imipfunda irantembanye.<verse eid="PSA 69:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3" />Intege ziramperanye kubera gutabaza;</para>
  <para style="q2" vid="PSA 69:3">umuhogo wanje urumye.</para>
  <para style="q1" vid="PSA 69:3">Amaso yanje arenze i mutwe,</para>
  <para style="q2" vid="PSA 69:3">mu kurindira Imana yanje.<verse eid="PSA 69:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4" />Abanyanka ata nyanduruko</para>
  <para style="q2" vid="PSA 69:4">baruta umushatsi wo ku mutwe wanje;</para>
  <para style="q1" vid="PSA 69:4">benshi banyanka ata nyanduruko,</para>
  <para style="q2" vid="PSA 69:4">kandi bashaka kunyica.</para>
  <para style="q1" vid="PSA 69:4">Nategetswe kuriha</para>
  <para style="q2" vid="PSA 69:4">ivyo ntivye.<verse eid="PSA 69:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5" />Mana, wewe urazi ubupfu bwanje;</para>
  <para style="q2" vid="PSA 69:5">ukugabitanya kwanje ntiguhishijwe mu nyonga zawe.<verse eid="PSA 69:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6" />Uhoraho, <char style="nd">Uhoraho</char> Mushoboravyose,</para>
  <para style="q2" vid="PSA 69:6">abakwizigira</para>
  <para style="q2" vid="PSA 69:6">ntibamaramare kubera jewe.</para>
  <para style="q1" vid="PSA 69:6">Mana ya Isirayeli,</para>
  <para style="q2" vid="PSA 69:6">icompa abakurondera</para>
  <para style="q2" vid="PSA 69:6">ntibamaramare kubera jewe.<verse eid="PSA 69:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7" />Kuko ncokorwa ku bwawe,</para>
  <para style="q2" vid="PSA 69:7">kandi ibimaramare vyuzuye mu maso yanje.<verse eid="PSA 69:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8" />Nabaye umunyamahanga mu muryango wanje,</para>
  <para style="q2" vid="PSA 69:8">injabuka mu bana ba mama;<verse eid="PSA 69:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9" />kuko ishaka mfitiye inzu yawe ryaka muri jewe nk’umuriro,</para>
  <para style="q2" vid="PSA 69:9">kandi ibitutsi vy’abagutuka vyaguye kuri jewe.<verse eid="PSA 69:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10" />Iyo nisonzesheje nkarira,</para>
  <para style="q2" vid="PSA 69:10">bituma ncokorwa;<verse eid="PSA 69:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11" />iyo nambaye amagunira,</para>
  <para style="q2" vid="PSA 69:11">mba ndabihaye ngo bitwengere.<verse eid="PSA 69:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12" />Abicara kw’irembo barantwenga,</para>
  <para style="q2" vid="PSA 69:12">kandi ndi indirimbo y’imborerwa.<verse eid="PSA 69:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13" />Ariko ni wewe nsenga, <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 69:13">mu gihe co kwemererwamwo nawe;</para>
  <para style="q1" vid="PSA 69:13">mu rukundo rwawe rudashira, ewe Mana,</para>
  <para style="q2" vid="PSA 69:13">unyishurishe agakiza kawe k’ukuri.<verse eid="PSA 69:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14" />Ntabara unkure mu vyondo,</para>
  <para style="q2" vid="PSA 69:14">ntundeke ngo nyike;</para>
  <para style="q1" vid="PSA 69:14">nkiza abanyanka,</para>
  <para style="q2" vid="PSA 69:14">unkure mw’ibenga<verse eid="PSA 69:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15" />ntureke ngo imipfunda indengere</para>
  <para style="q2" vid="PSA 69:15">canke ngo idamba rimire miyonzwa</para>
  <para style="q2" vid="PSA 69:15">canke ngo icobo kimire nkibona.<verse eid="PSA 69:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16" />Nyishura, <char style="nd">Uhoraho</char>, ku bwo kugira neza kw’urukundo rwawe;</para>
  <para style="q2" vid="PSA 69:16">mu rukundo rwawe rwinshi unyibuke.<verse eid="PSA 69:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17" />Ntuhishe inyonga zawe umusavyi wawe;</para>
  <para style="q2" vid="PSA 69:17">unyishure vuba, kuko ndi mu magorwa.<verse eid="PSA 69:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18" />Nuze hano untabare;</para>
  <para style="q2" vid="PSA 69:18">untabare ku bwo abampiga.<verse eid="PSA 69:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19" />Urazi uburyo ncokorwa, ngateterezwa kandi nkamaramazwa;</para>
  <para style="q2" vid="PSA 69:19">abansi banje bose bari imbere yawe.<verse eid="PSA 69:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20" />Ugucokorwa kwavunye umutima wanje</para>
  <para style="q2" vid="PSA 69:20">kandi kwansize ntagira gitabara;</para>
  <para style="q1" vid="PSA 69:20">narondeye uwombabara, ariko nta n’umwe nabonye,</para>
  <para style="q2" vid="PSA 69:20">narondeye abandemesha, ariko sinaronse n’umwe.<verse eid="PSA 69:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21" />Basize ishano mu ndya zanje</para>
  <para style="q2" vid="PSA 69:21">kandi bampaye inkarisha igihe nari nyotewe.<verse eid="PSA 69:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22" />Ese imeza bashizwe imbere zobabera umutego;</para>
  <para style="q2" vid="PSA 69:22">n’ubutunzi bwabo bukababera ikinogo co kugwamwo.<verse eid="PSA 69:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23" />Reka amaso yabo ahume ntibashobore kubona,</para>
  <para style="q2" vid="PSA 69:23">n’imigongo yabo yame ihetamye ibihe vyose.<verse eid="PSA 69:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24" />Uburake bwawe nibubaziriringire;</para>
  <para style="q2" vid="PSA 69:24">uburake bwawe bw’inkazi nibubashikeko.<verse eid="PSA 69:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25" />Aho bahora nihasigare ari umusaka;</para>
  <para style="q2" vid="PSA 69:25">ntihagire n’umwe aba mu mahema yabo.<verse eid="PSA 69:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26" />Kuko bababaje abo wewe wakomerekeje</para>
  <para style="q2" vid="PSA 69:26">bongereza umubabaro ku bo wababaje.<verse eid="PSA 69:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27" />Bacire urubanza ku bibi vyose bakoze;</para>
  <para style="q2" vid="PSA 69:27">ntibagire ico baronka kivuye ku kugororoka kawe.<verse eid="PSA 69:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28" />Bahanagurwe mu gitabu c’ubugingo</para>
  <para style="q2" vid="PSA 69:28">ntibashirwe mu gitigiri c’abagororotsi.<verse eid="PSA 69:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29" />Ariko jeho, umugorwa ndi mu marushwa;</para>
  <para style="q2" vid="PSA 69:29">agakiza kawe, ewe Mana kankingire.<verse eid="PSA 69:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30" />Nzohimbaza izina ry’Imana mu ndirimbo</para>
  <para style="q2" vid="PSA 69:30">ndamuhe icubahiro mu mashimwe.<verse eid="PSA 69:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31" />Ivyo bizohimbara <char style="nd">Uhoraho</char> kurusha ishuri,</para>
  <para style="q2" vid="PSA 69:31">kurusha impfizi n’amahembe yayo n’ibinono vyayo.<verse eid="PSA 69:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32" />Abakene bazobibona banezerwe;</para>
  <para style="q2" vid="PSA 69:32">yemwe abarondera Imana, imitima yanyu nireme!<verse eid="PSA 69:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33" />
    <char style="nd">Uhoraho</char> yumva abakene</para>
  <para style="q2" vid="PSA 69:33">kandi ntakengera abantu biwe babaye inyagano.<verse eid="PSA 69:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34" />Ijuru n’isi nibimuhimbaze,</para>
  <para style="q2" vid="PSA 69:34">n’ibiyaga n’ibiri muri vyo vyose,<verse eid="PSA 69:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35" />kuko Imana izokiza Siyoni</para>
  <para style="q2" vid="PSA 69:35">kandi izosubira kwubaka ibisagara vy’i Buyuda.</para>
  <para style="q1" vid="PSA 69:35">Maze abantu bazosubira kuhaba habegukire;<verse eid="PSA 69:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="PSA 69:36" />abana b’abasavyi bayo bazohegukira,</para>
  <para style="q2" vid="PSA 69:36">kandi abakunda izina ryayo bazohaba.<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="cl">Zaburi ya 70</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni iya Dawidi. Ni ukwinginga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1" />Mana, tebuka unkize;</para>
  <para style="q2" vid="PSA 70:1">
    <char style="nd">Uhoraho</char>, tebuka untabare.<verse eid="PSA 70:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2" />Abagomba kunyica</para>
  <para style="q2" vid="PSA 70:2">nibamaramare bakorwe n’isoni;</para>
  <para style="q1" vid="PSA 70:2">abipfuza ko nohona bose</para>
  <para style="q2" vid="PSA 70:2">nibasubizwe inyuma bateterewe.<verse eid="PSA 70:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3" />Abambwira bati: “Aha! Aha!”</para>
  <para style="q2" vid="PSA 70:3">basubire inyuma kubwo kumaramara.<verse eid="PSA 70:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4" />Ariko abakurondera bose</para>
  <para style="q2" vid="PSA 70:4">nibanezerwe bahimbarirwe muri wewe;</para>
  <para style="q1" vid="PSA 70:4">abipfuza ugutabarwa kwawe bame bavuga bati:</para>
  <para style="q2" vid="PSA 70:4">“Imana irahambaye!”<verse eid="PSA 70:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5" />Ariko jeho ndi umworo, kandi ndi umukene;</para>
  <para style="q2" vid="PSA 70:5">nuze aho ndi vuba, ewe Mana.</para>
  <para style="q1" vid="PSA 70:5">Ni wewe mutabazi wanje n’umurokozi wanje;</para>
  <para style="q2" vid="PSA 70:5">
    <char style="nd">Uhoraho</char> we, ntutebe.<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="cl">Zaburi ya 71</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1" />Muri wewe, <char style="nd">Uhoraho</char>, ni ho mpungiye;</para>
  <para style="q2" vid="PSA 71:1">sinze nigere maramara.<verse eid="PSA 71:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2" />Untabare undokore, ku bw’ukugororoka kwawe;</para>
  <para style="q2" vid="PSA 71:2">ntega ugutwi maze unkize.<verse eid="PSA 71:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3" />Umbere igitandara mpungiramwo,</para>
  <para style="q2" vid="PSA 71:3">aho nama nirukira imisi yose.</para>
  <para style="q1" vid="PSA 71:3">Tegeka ntabarwe,</para>
  <para style="q2" vid="PSA 71:3">kuko ari wewe gitandara canje n’igihome kinkingira.<verse eid="PSA 71:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4" />Mana yanje, undokore mu maboko y’abanyakibi,</para>
  <para style="q2" vid="PSA 71:4">unkize ububasha bw’abantu babi b’ibirara.<verse eid="PSA 71:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5" />Kuko uri ivyizigiro vyanje, <char style="nd">Uhoraho</char> Nyeninganji,</para>
  <para style="q2" vid="PSA 71:5">ni wewe nizigira kuva nkiri muto.<verse eid="PSA 71:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6" />Kuva nkivuka namye nisunga wewe;</para>
  <para style="q2" vid="PSA 71:6">wankuye mu nda ya mama.</para>
  <para style="q2" vid="PSA 71:6">Nzokwama ndaguhimbaza.<verse eid="PSA 71:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7" />Nabaye akabarore kuri benshi;</para>
  <para style="q2" vid="PSA 71:7">ni wewe buhungiro bwanje buhambaye.<verse eid="PSA 71:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8" />Akanwa kanje kuzuye ishimwe ryawe,</para>
  <para style="q2" vid="PSA 71:8">kavuga ubwiza bwawe bukarinda bwira.<verse eid="PSA 71:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9" />Ntunshiburire kure mu gihe c’ubusaza bwanje;</para>
  <para style="q2" vid="PSA 71:9">ntumpebe mu gihe ncitse intege.<verse eid="PSA 71:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10" />Kuko abansi banje bangira inama mbi;</para>
  <para style="q2" vid="PSA 71:10">abambundiye baja imigabo yo kunyica.<verse eid="PSA 71:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11" />Baravuga bati: “Imana yamuhevye;</para>
  <para style="q2" vid="PSA 71:11">mukurikire kugeza mumufashe,</para>
  <para style="q2" vid="PSA 71:11">kuko ata wo kumutabara.”<verse eid="PSA 71:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12" />Ntumbe kure, Mana yanje;</para>
  <para style="q2" vid="PSA 71:12">tebuka, Mana, untabare.<verse eid="PSA 71:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13" />Abanyagiriza nibahone bicwe n’ibimaramare;</para>
  <para style="q2" vid="PSA 71:13">abagomba kunyica</para>
  <para style="q2" vid="PSA 71:13">bambare ugucokorwa n’ibiteterwe.<verse eid="PSA 71:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14" />Ariko jeho, nzokwamana ivyizigiro;</para>
  <para style="q2" vid="PSA 71:14">nzogushima ubudahengeshanya.<verse eid="PSA 71:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15" />Akanwa kanje kazovuga ibikorwa vyawe vyo kugororoka,</para>
  <para style="q2" vid="PSA 71:15">mvuge ivyo gukiza wakoze burinde bwira;</para>
  <para style="q2" vid="PSA 71:15">naho ntashobora kubivuga vyose.<verse eid="PSA 71:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16" />Nzoza menyekanishe ivyo wakoze bihambaye; <char style="nd">Uhoraho</char> Nyeninganji,</para>
  <para style="q2" vid="PSA 71:16">nzokwamamaza ivy’ukugororoka wakoze, wewe wenyene.<verse eid="PSA 71:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17" />Kuva mu buto bwanje, Mana, waranyigishije,</para>
  <para style="q2" vid="PSA 71:17">kugeza uwu musi ndacamenyekanisha ibihambaye wakoze.<verse eid="PSA 71:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18" />No mu gihe c’ubusaza bwanje maze kumera imvi,</para>
  <para style="q2" vid="PSA 71:18">ntuze umpebe, Mana yanje,</para>
  <para style="q1" vid="PSA 71:18">kugeza menyesheje ubushobozi bwawe abo mu runganwe ruzoza,</para>
  <para style="q2" vid="PSA 71:18">ibikorwa vy’inkomezi wakoze kubazovuka hanyuma.<verse eid="PSA 71:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19" />Ukugororoka kwawe, ewe Mana, gushika mw’ijuru,</para>
  <para style="q2" vid="PSA 71:19">wewe wakoze ibihambaye.</para>
  <para style="q2" vid="PSA 71:19">Ni nde ameze nka we, Mana?<verse eid="PSA 71:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20" />Naho wandetse ngo mbone amarushwa,</para>
  <para style="q2" vid="PSA 71:20">menshi kandi arura,</para>
  <para style="q2" vid="PSA 71:20">uzosubira kunsubizamwo intege;</para>
  <para style="q1" vid="PSA 71:20">uzonkura i bwina mw’isi</para>
  <para style="q2" vid="PSA 71:20">wongere ungarukane hejuru.<verse eid="PSA 71:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21" />Uzokwongereza icubahiro canje</para>
  <para style="q2" vid="PSA 71:21">wongere kundemesha.<verse eid="PSA 71:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22" />Nzogushimisha inanga</para>
  <para style="q2" vid="PSA 71:22">kubera ukwizigirwa kwawe, Mana yanje;</para>
  <para style="q1" vid="PSA 71:22">nzogushimisha ikembe,</para>
  <para style="q2" vid="PSA 71:22">Ewe Uwera wa Isirayeli.<verse eid="PSA 71:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23" />Iminwa yanje izosemerera ku bw’umunezero</para>
  <para style="q2" vid="PSA 71:23">aho nzoguhimbariza;</para>
  <para style="q2" vid="PSA 71:23">jewe uwo warokoye.<verse eid="PSA 71:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24" />Ururimi rwanje ruzovuga ibikorwa vyawe vyo kugororoka</para>
  <para style="q2" vid="PSA 71:24">burinde bwira,</para>
  <para style="q1" vid="PSA 71:24">kuko abagomba kungirira nabi</para>
  <para style="q2" vid="PSA 71:24">bamaramaye bakicwa n’isoni.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="cl">Zaburi ya 72</para>
  <para style="d">Ni iya Salomo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1" />Igisha umwami guca imanza zibereye, ewe Mana,</para>
  <para style="q2" vid="PSA 72:1">igisha umwana w’umwami ivyo kugororoka kwawe.<verse eid="PSA 72:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2" />Ese yocira imanza abantu bawe mu bugororotsi,</para>
  <para style="q2" vid="PSA 72:2">abanyamibabaro bo mu bantu bawe akabatunganiriza.<verse eid="PSA 72:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3" />Ese imisozi yozanira abantu bawe iterambere,</para>
  <para style="q2" vid="PSA 72:3">n’udutumba tukazana ivyamwa vyo kugororoka.<verse eid="PSA 72:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4" />Ese yogwanirira abanyamibabaro bo mu bantu</para>
  <para style="q2" vid="PSA 72:4">agakiza abana b’umukene;</para>
  <para style="q2" vid="PSA 72:4">akamara inkomezi umunyagahahazo.<verse eid="PSA 72:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5" />Ese yohoraho igihe cose izuba rizoba rikiriho,</para>
  <para style="q2" vid="PSA 72:5">igihe cose ukwezi kuzoba kukiriho uko urunganwe ruzogenda rukurakuranwa.<verse eid="PSA 72:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6" />Ese yomera nk’imvura igwa kw’isi yumye,</para>
  <para style="q2" vid="PSA 72:6">nk’imvura itosa isi.<verse eid="PSA 72:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7" />Mu misi yiwe, ese abagororotsi boshurika</para>
  <para style="q2" vid="PSA 72:7">n’iterambere rikagwira gushika ukwezi kutakiriho.<verse eid="PSA 72:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8" />Ese yoganza kuva ku kiyaga gushika ku kindi</para>
  <para style="q2" vid="PSA 72:8">no kuva ku ruzi Efurate gushika ku mpera z’isi.<verse eid="PSA 72:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9" />Ese amoko aba mu bugaragwa yomwunamira</para>
  <para style="q2" vid="PSA 72:9">abansi biwe bakarigata umukungugu.<verse eid="PSA 72:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10" />Ese abami b’i Tarushishi n’abo ku bizinga vya kure</para>
  <para style="q2" vid="PSA 72:10">bomuzanira ivyo gusaba impore.</para>
  <para style="q1" vid="PSA 72:10">Ese abami b’i Sheba n’i Seba</para>
  <para style="q2" vid="PSA 72:10">bomuzanira ingabire.<verse eid="PSA 72:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11" />Ese abami bose bomwunamira</para>
  <para style="q2" vid="PSA 72:11">kandi amahanga yose amukorera.<verse eid="PSA 72:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12" />Kuko azokiza umukene amutakambiye,</para>
  <para style="q2" vid="PSA 72:12">n’umunyamibabaro atagira gitabara.<verse eid="PSA 72:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13" />Azogirira akagongwe umukene n’umunyantegenke</para>
  <para style="q2" vid="PSA 72:13">akize umukene amukure mu rupfu.<verse eid="PSA 72:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14" />Azobatabara abakure mu gahahazo no mu muryano,</para>
  <para style="q2" vid="PSA 72:14">kuko amaraso yabo ari ay’igiciro mu nyonga ziwe.<verse eid="PSA 72:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15" />Arakaramba!</para>
  <para style="q2" vid="PSA 72:15">Ahabwe inzahabu z’i Sheba.</para>
  <para style="q1" vid="PSA 72:15">Abantu bame bamusengera</para>
  <para style="q2" vid="PSA 72:15">bamuhezagira burinde bwira.<verse eid="PSA 72:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16" />Ese ingano zogwira mu gihugu cose;</para>
  <para style="q2" vid="PSA 72:16">umuyange wazo ugahungabana ku dutwe tw’imisozi.</para>
  <para style="q1" vid="PSA 72:16">Ese ibiti vy’ivyamwa vyoshurika nk’i Libani</para>
  <para style="q2" vid="PSA 72:16">n’abantu mu bisagara bagatotahara nk’ivyatsi ku misozi.<verse eid="PSA 72:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17" />Ese izina ryiwe ryokwamaho ibihe bidashira;</para>
  <para style="q2" vid="PSA 72:17">rikamaho izuba rikiriho.</para>
  <para style="b" vid="PSA 72:17" />
  <para style="q1" vid="PSA 72:17">Maze amahanga yose agahererwa umugisha muri we,</para>
  <para style="q2" vid="PSA 72:17">kandi bazomwita uwahawe umugisha.<verse eid="PSA 72:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18" />Nihashimwe <char style="nd">Uhoraho</char> Imana, Imana ya Isirayeli,</para>
  <para style="q2" vid="PSA 72:18">ni we wenyene akora ibitangaza.<verse eid="PSA 72:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19" />Nihashimwe izina ryiwe ry’icubahiro ibihe bidashira;</para>
  <para style="q2" vid="PSA 72:19">ese isi yose yokwuzura icubahiro ciwe.</para>
  <para style="qc" vid="PSA 72:19">Amen kandi Amen.<verse eid="PSA 72:19" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20" />Aya ni yo majambo arangiza amasengesho ya Dawidi mwene Isayi.<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">Igitabu ca gatatu</para>
  <para style="mr">
    <ref loc="PSA 73-89">Zaburi 73–89</ref></para>
  <para style="cl">Zaburi ya 73</para>
  <para style="d">Ni Zaburi ya Asafu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1" />Ni ukuri Imana ni nziza kuri Isirayeli,</para>
  <para style="q2" vid="PSA 73:1">ku bafise imitima itanduye.<verse eid="PSA 73:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2" />Ariko jeho, ibirenge vyanje hari hasigaye gatoya bikanyerera;</para>
  <para style="q2" vid="PSA 73:2">hari habuze gatoya ngatemba.<verse eid="PSA 73:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3" />Kuko nagirira ishari abibone</para>
  <para style="q2" vid="PSA 73:3">aho nabona abanyakibi baguwe neza.<verse eid="PSA 73:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4" />Bibereyeho nk’abatagira ingorane;</para>
  <para style="q2" vid="PSA 73:4">bafise amagara meza kandi barakomeye.<verse eid="PSA 73:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5" />Imibabaro abandi bacamwo bobo ntibashikako;</para>
  <para style="q2" vid="PSA 73:5">ntibashikirwa n’ivyago nk’abandi.<verse eid="PSA 73:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6" />Ni co gituma ubwishime babwambaye mw’izosi nk’umugufu;</para>
  <para style="q2" vid="PSA 73:6">umuryano bakawambara nk’impuzu.<verse eid="PSA 73:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7" />Mu mitima yabo mibi havamwo ibigabitanyo,</para>
  <para style="q2" vid="PSA 73:7">imigabo yabo mibi ntigira iherezo.<verse eid="PSA 73:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8" />Baracokorana, bakavuga ivy’agahahazo;</para>
  <para style="q2" vid="PSA 73:8">bavugana ubwibone amajambo y’agacinyizo.<verse eid="PSA 73:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9" />Akanwa kabo kavuga nabi ivy’ijuru,</para>
  <para style="q2" vid="PSA 73:9">indimi zabo zikihayagiza mw’isi.<verse eid="PSA 73:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10" />Ni co gituma abantu babahindukirira</para>
  <para style="q2" vid="PSA 73:10">bakiranguza amajambo yabo nk’uwunywa amazi.<verse eid="PSA 73:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11" />Baravuga bati: “Imana yobimenya gute?</para>
  <para style="q2" vid="PSA 73:11">Mbega Iyisumbavyose hari ico izi?”<verse eid="PSA 73:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12" />Uko ni ko abanyakibi bameze;</para>
  <para style="q2" vid="PSA 73:12">bama baguwe neza, biyegeraniriza ubutunzi.<verse eid="PSA 73:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13" />Ni ukuri nta co nungutse mu kwirinda kwanduza umutima wanje</para>
  <para style="q2" vid="PSA 73:13">amaboko yanje agakaraba mu kudacumura.<verse eid="PSA 73:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14" />Narababaye burinda bwira,</para>
  <para style="q2" vid="PSA 73:14">kandi igitondo cose kikanzanira imibabaro.<verse eid="PSA 73:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15" />Iyo mba naravuze ntyo,</para>
  <para style="q2" vid="PSA 73:15">mba narabaye umuguranyi w’abana bawe.<verse eid="PSA 73:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16" />Igihe nagerageza gutahura ivyo vyose,</para>
  <para style="q2" vid="PSA 73:16">vyarambabaje cane<verse eid="PSA 73:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17" />gushika aho ninjiye ahera h’Imana;</para>
  <para style="q2" vid="PSA 73:17">maze ntahura iherezo ryabo rya nyuma.<verse eid="PSA 73:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18" />Ni ukuri, ubashira ahantu hanyerera;</para>
  <para style="q2" vid="PSA 73:18">ubakororera mu mahonero.<verse eid="PSA 73:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19" />Bahona mu kanya isase,</para>
  <para style="q2" vid="PSA 73:19">bakurwaho rwose bishwe n’ubwoba.<verse eid="PSA 73:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20" />Bameze kurya kw’inzozi iyo umuntu yikanguye;</para>
  <para style="q2" vid="PSA 73:20">aho uzovira hasi, ewe Mana,</para>
  <para style="q2" vid="PSA 73:20">uzobatwenga nk’uko umuntu atwenga ivyo yaraye arose.<verse eid="PSA 73:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21" />Aho umutima wanje wababara</para>
  <para style="q2" vid="PSA 73:21">umutima wanje ukantunturiramwo,<verse eid="PSA 73:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22" />nari igipfu n’inyoberwa;</para>
  <para style="q2" vid="PSA 73:22">nari nk’igikoko imbere yawe.<verse eid="PSA 73:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23" />Ariko namana nawe imisi yose;</para>
  <para style="q2" vid="PSA 73:23">umfashe ukuboko kw’i buryo.<verse eid="PSA 73:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24" />Undongoza inama ungiriye,</para>
  <para style="q2" vid="PSA 73:24">kandi hanyuma uzonjana mu bwiza bwawe.<verse eid="PSA 73:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25" />Ni nde mfise mw’ijuru atari wewe?</para>
  <para style="q2" vid="PSA 73:25">No mw’isi nta co mfise nipfuza atari wewe.<verse eid="PSA 73:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26" />Umubiri wanje n’umutima wanje bishobora kugira intege nke,</para>
  <para style="q2" vid="PSA 73:26">ariko Imana ni yo nkomezi z’umutima wanje,</para>
  <para style="q2" vid="PSA 73:26">ni yo mugabane wanje ibihe bidashira.<verse eid="PSA 73:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27" />Abagiye kure yawe bazopfa rubi;</para>
  <para style="q2" vid="PSA 73:27">uzohonya abaguteye ibitugu.<verse eid="PSA 73:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28" />Ariko jeho, bimbereye vyiza kuba hafi y’Imana.</para>
  <para style="q2" vid="PSA 73:28">Nagize <char style="nd">Uhoraho</char> Nyeninganji ubuhungiro bwanje;</para>
  <para style="q2" vid="PSA 73:28">nzokwamamaza ivyo wakoze vyose.<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="cl">Zaburi ya 74</para>
  <para style="d">Ni masikili ya Asafu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1" />Mana, ni kuki wadutaye igihe kirekire?</para>
  <para style="q2" vid="PSA 74:1">Ni kuki uburake bwawe bwaziriringiye intama zo mu buragiro bwawe?<verse eid="PSA 74:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2" />Niwibuke ihanga witoranirije kuva kera,</para>
  <para style="q2" vid="PSA 74:2">ubwoko bw’iragi ryawe, wicunguriye;</para>
  <para style="q2" vid="PSA 74:2">Umusozi Siyoni, aho wibera kera.<verse eid="PSA 74:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3" />Hindukira ugendere iyo misaka y’igisagara iteye agahinda,</para>
  <para style="q2" vid="PSA 74:3">urabe ingene umwansi yasanganguye ahera hawe.<verse eid="PSA 74:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4" />Abansi bawe bihereye akamo mu kibanza wahora uhuriramwo natwe;</para>
  <para style="q2" vid="PSA 74:4">aho ni ho bashinze amabendera yabo.<verse eid="PSA 74:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5" />Bakoze nk’abicira ibiti</para>
  <para style="q2" vid="PSA 74:5">bakoresheje incabiti, mw’ishamba.<verse eid="PSA 74:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6" />Bamenaguye ivyabajwe vyose</para>
  <para style="q2" vid="PSA 74:6">bakoresheje incabiti n’inyundo vyabo.<verse eid="PSA 74:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7" />Baturiye ahera hawe barahasenyura;</para>
  <para style="q2" vid="PSA 74:7">bahumanije ahera hagaragaza izina ryawe.<verse eid="PSA 74:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8" />Bavuze mu mitima bati: “Turabaherengeteza bose!”</para>
  <para style="q2" vid="PSA 74:8">Baturiye aho gusengera Imana hose mu gihugu.<verse eid="PSA 74:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9" />Nta bitangaza tukironka bivuye ku Mana;</para>
  <para style="q2" vid="PSA 74:9">nta bavugishwa n’Imana bakiriho</para>
  <para style="q2" vid="PSA 74:9">kandi nta wuzi igihe ivyo bizomara.<verse eid="PSA 74:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10" />Ewe Mana, Umwansi azogucokora gushika ryari?</para>
  <para style="q2" vid="PSA 74:10">Abakugwanya bazokengera izina ryawe ibihe vyose?<verse eid="PSA 74:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11" />Ni kuki ata co ukora, ukarera amaboko?</para>
  <para style="q2" vid="PSA 74:11">Kura ukuboko kwawe mu mpuzu maze ubamare!<verse eid="PSA 74:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12" />Ariko Imana ni Umwami wanje kuva kera;</para>
  <para style="q2" vid="PSA 74:12">azana agakiza kw’isi.<verse eid="PSA 74:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13" />Ni wewe waciyemwo kubiri ikiyaga kubera inkomezi zawe;</para>
  <para style="q2" vid="PSA 74:13">wamenye imitwe y’igisizimwe co mu mazi menshi.<verse eid="PSA 74:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14" />Ni wewe wamenaguye imitwe ya Leviyatani</para>
  <para style="q2" vid="PSA 74:14">ukayitanga ngo ibe ivyokurya vy’ibikoko vyo mu bugaragwa.<verse eid="PSA 74:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15" />Ni wewe wuguruye amasoko n’imigezi;</para>
  <para style="q2" vid="PSA 74:15">wakamije inzuzi z’ibihe vyose.<verse eid="PSA 74:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16" />Umurango ni uwawe, n’ijoro na ryo ni iryawe;</para>
  <para style="q2" vid="PSA 74:16">ni wewe washizeho izuba n’ukwezi.<verse eid="PSA 74:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17" />Ni wewe washizeho imbibe z’isi;</para>
  <para style="q2" vid="PSA 74:17">washizeho ici n’urushana.<verse eid="PSA 74:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18" />Niwibuke ingene umwansi yagucokoye, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 74:18">ingene abantu b’ibipfu bacokoye izina ryawe.<verse eid="PSA 74:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19" />Ntutange intunguru imwe mu menyo y’ibikoko vyo mw’ishamba;</para>
  <para style="q2" vid="PSA 74:19">ntiwibagire abagorwa bo mu bantu bawe ibihe vyose.<verse eid="PSA 74:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20" />Niwibuke isezerano ryawe,</para>
  <para style="q2" vid="PSA 74:20">kuko umuryano uri ahantu hose hari umwijima mu gihugu.<verse eid="PSA 74:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21" />Ntureke abahahazwa ngo bagende bamaramaye;</para>
  <para style="q2" vid="PSA 74:21">abakene n’abagorwa bahimbaze izina ryawe.<verse eid="PSA 74:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22" />Va hasi, ewe Mana, wiburanire;</para>
  <para style="q2" vid="PSA 74:22">niwibuke ingene ibipfu bigucokora bukarinda bwira.<verse eid="PSA 74:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23" />Ntiwirengagize urwamo rw’abansi bawe,</para>
  <para style="q2" vid="PSA 74:23">urwamo rwinshi rw’abakugwanya rurushirizaho kwiyongera.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="cl">Zaburi ya 75</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni mw’ijwi ryitwa “Ntuhonye.” Ni Zaburi ya Asafu. Ni indirimbo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1" />Turaguhimbaza, Mana,</para>
  <para style="q2" vid="PSA 75:1">turaguhimbaza, kuko Izina ryawe riri hafi yacu;</para>
  <para style="q2" vid="PSA 75:1">ahantu hose abantu baganira ibitangaza wakoze.<verse eid="PSA 75:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2" />Uravuga ngo: “Mu gihe nzoba nashinze,</para>
  <para style="q2" vid="PSA 75:2">nzoca imanza mu bugororotsi.<verse eid="PSA 75:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3" />Igihe isi izohinda agashitsi n’abari kuri yo,</para>
  <para style="q2" vid="PSA 75:3">ni jewe nzofata inkingi zayo ndazikomeze.<verse eid="PSA 75:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4" />Ku bibone ndavuga nti: ‘Ntimukirate,’</para>
  <para style="q2" vid="PSA 75:4">n’abanyakibi nti: ‘Ntimukaduze amahembe yanyu.<verse eid="PSA 75:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5" />Ntimukaduze amahembe yanyu mw’ijuru;</para>
  <para style="q2" vid="PSA 75:5">ntimuvuge amajambo y’ubwibone.’ ”<verse eid="PSA 75:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6" />Nta n’umwe wo mu buseruko canke mu burengero,</para>
  <para style="q2" vid="PSA 75:6">canke ava mu bugaragwa yoshobora kwishira hejuru.<verse eid="PSA 75:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7" />Imana ni yo ica imanza:</para>
  <para style="q2" vid="PSA 75:7">icisha bugufi umwe, igashira hejuru uwundi.<verse eid="PSA 75:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8" />Mu kuboko kw’<char style="nd">Uhoraho</char> hari igikombe</para>
  <para style="q2" vid="PSA 75:8">cuzuye umuvinyu ubiragira uturiranije;</para>
  <para style="q1" vid="PSA 75:8">arawusuka, maze abanyakibi bose bo kw’isi</para>
  <para style="q2" vid="PSA 75:8">bakawiranguza gushika no ku mvuzo.<verse eid="PSA 75:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9" />Ariko jeho, nzokwamamaza ibi bintu ibihe bidashira;</para>
  <para style="q2" vid="PSA 75:9">nzoririmbira ishimwe ry’Imana ya Yakobo,<verse eid="PSA 75:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10" />ni yo ivuga iti: “Nzovunagura amahembe y’abanyakibi bose,</para>
  <para style="q2" vid="PSA 75:10">ariko amahembe y’abagororotsi azoshirwa hejuru.”<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="cl">Zaburi ya 76</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Bavugira inanga. Ni Zaburi ya Asafu. Ni indirimbo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1" />Imana yamamaye i Buyuda;</para>
  <para style="q2" vid="PSA 76:1">muri Isirayeli izina ryiwe rirahambaye.<verse eid="PSA 76:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2" />Ihema ryiwe riri i Salemu,</para>
  <para style="q2" vid="PSA 76:2">Siyoni ni ho aba.<verse eid="PSA 76:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3" />Aho ni ho yavunaguriye imyampi yaka umuriro,</para>
  <para style="q2" vid="PSA 76:3">inkinzo n’inkota, hamwe n’ibigwanisho vy’intambara.<verse eid="PSA 76:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4" />Urakayangana,</para>
  <para style="q2" vid="PSA 76:4">uri n’ubwiza kurusha imisozi y’abaguteye.<verse eid="PSA 76:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5" />Abahizi baryamye hasi bafashwe mpiri,</para>
  <para style="q2" vid="PSA 76:5">basinziriye ubutikoma;</para>
  <para style="q1" vid="PSA 76:5">nta n’umwe mu bagwanyi</para>
  <para style="q2" vid="PSA 76:5">akivyura n’umutwe.<verse eid="PSA 76:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6" />Kubera ijwi ryo gukankama kwawe, ewe Mana ya Yakobo,</para>
  <para style="q2" vid="PSA 76:6">ifarasi n’umukogote birambaraye hasi.<verse eid="PSA 76:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7" />Ni wewe wenyene ukwiye kwubahwa.</para>
  <para style="q2" vid="PSA 76:7">Ni nde yoguhagarara imbere waratse?<verse eid="PSA 76:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8" />Waciye amateka yawe uri mw’ijuru,</para>
  <para style="q2" vid="PSA 76:8">isi iratinya iratekereza;<verse eid="PSA 76:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9" />igihe wahaguruka ngo uce imanza, ewe Mana,</para>
  <para style="q2" vid="PSA 76:9">ngo ukize aboro bo mu gihugu.<verse eid="PSA 76:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10" />Ni ukuri ubushangashirwe bwawe ku bantu butuma uhimbazwa,</para>
  <para style="q2" vid="PSA 76:10">kandi amasigarira y’uburake bwawe azogukikiza.<verse eid="PSA 76:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11" />Girana amasezerano n’<char style="nd">Uhoraho</char> Imana yawe kandi uyashitse;</para>
  <para style="q2" vid="PSA 76:11">kandi ibihugu bihakikije</para>
  <para style="q2" vid="PSA 76:11">nibizane ingabire kuri Imwe ikwiye kwubahwa<verse eid="PSA 76:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12" />Acisha bugufi abatware;</para>
  <para style="q2" vid="PSA 76:12">yubahwa n’abami bose bo kw’isi.<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="cl">Zaburi ya 77</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Yahawe kandi Yedutuni. Ni iya Asafu. Ni Zaburi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1" />Natakambiye <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 77:1">nambaje Imana ngo inyumve.<verse eid="PSA 77:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2" />Aho nari mu mubabaro, narondeye Imana;</para>
  <para style="q2" vid="PSA 77:2">mw’ijoro ntarika ibiganza ubudahumeka,</para>
  <para style="q2" vid="PSA 77:2">umushaha wanje wanka guhozwa.<verse eid="PSA 77:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3" />Narakwibutse, Mana, maze ndaboroga;</para>
  <para style="q2" vid="PSA 77:3">nariyumviriye, maze umushaha wanje uradendebukirwa.<verse eid="PSA 77:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4" />Wabujije amaso guhunyiza;</para>
  <para style="q2" vid="PSA 77:4">kuba mu magorwa vyambujije kuvuga.<verse eid="PSA 77:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5" />Niyumviriye ku misi ya kera,</para>
  <para style="q2" vid="PSA 77:5">imyaka ya kera cane;<verse eid="PSA 77:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6" />nibutse indirimbo zanje mw’ijoro.</para>
  <para style="q2" vid="PSA 77:6">Umutima wanje urarimbura n’impwemu yanje ikibaza iti:<verse eid="PSA 77:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7" />“Mbega Imana izoheba umuntu ibihe vyose?</para>
  <para style="q2" vid="PSA 77:7">Mbega ntizosubira kwerekana imbabazi ziwe?<verse eid="PSA 77:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8" />Mbega urukundo rwayo rudashira rwaragiye akagirire?</para>
  <para style="q2" vid="PSA 77:8">Amasezerano yiyo mbega ntakiriho?<verse eid="PSA 77:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9" />Mbega Imana yaribagiye kugira imbabazi?</para>
  <para style="q2" vid="PSA 77:9">Mbega uburake bwayo bwasubiriye imbabazi zayo?”<verse eid="PSA 77:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10" />Maze ndibwira nti: “Iki ni co kimbabaza:</para>
  <para style="q2" vid="PSA 77:10">ni nk’aho Iyisumbavyose itakigorora</para>
  <para style="q2" vid="PSA 77:10">ukuboko kwayo kw’i buryo.”<verse eid="PSA 77:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11" />Ariko ngaca nibuka ibikorwa vy’<char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 77:11">egome cane, ndibuka ibitangaza vyawe vya kera.<verse eid="PSA 77:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12" />Nzokwiyumvira ku bikorwa vyawe</para>
  <para style="q2" vid="PSA 77:12">nzirikane ivy’inkomezi wakoze.<verse eid="PSA 77:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13" />Inzira zawe, Mana zirera.</para>
  <para style="q2" vid="PSA 77:13">Ni iyihe mana imeze nk’Imana yacu?<verse eid="PSA 77:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14" />Uri Imana ikora ibitangaza;</para>
  <para style="q2" vid="PSA 77:14">werekana ubushobozi bwawe mu mahanga.<verse eid="PSA 77:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15" />Wacunguje ubwoko bwawe ukuboko kw’inkomezi,</para>
  <para style="q2" vid="PSA 77:15">ari bo bene Yakobo na Yosefu.<verse eid="PSA 77:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16" />Amazi yarakubonye, ewe Mana,</para>
  <para style="q2" vid="PSA 77:16">amazi yarakubonye ahinda agashitsi;</para>
  <para style="q2" vid="PSA 77:16">mbere n’ibenga ry’ikiyaga rirajugumira.<verse eid="PSA 77:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17" />Ibicu vyarekuye imvura,</para>
  <para style="q2" vid="PSA 77:17">amajuru yasiranamwo imituragaro,</para>
  <para style="q2" vid="PSA 77:17">imyampi yawe iraririra hirya no hino.<verse eid="PSA 77:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18" />Umuturagaro wawe wumvikaniye mu gashururu,</para>
  <para style="q2" vid="PSA 77:18">umuravyo wawe umurika mw’isi,</para>
  <para style="q2" vid="PSA 77:18">isi iranyiganyiga ihinda agashitsi.<verse eid="PSA 77:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19" />Inzira yawe yaca mu kiyaga,</para>
  <para style="q2" vid="PSA 77:19">waciye mu mipfunda y’amazi,</para>
  <para style="q2" vid="PSA 77:19">naho amakanda yawe atabonetse.<verse eid="PSA 77:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20" />Warongoye abantu bawe nk’umukuku</para>
  <para style="q2" vid="PSA 77:20">ubarongoje ukuboko kwa Mose na Aroni.<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="cl">Zaburi ya 78</para>
  <para style="d">Ni masikili ya Asafu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1" />Bantu banje, nimwumve ukwigisha kwanje;</para>
  <para style="q2" vid="PSA 78:1">nimwumvirize amajambo yo mu kanwa kanje.<verse eid="PSA 78:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2" />Reka nugurure akanwa kanje nce umugani;</para>
  <para style="q2" vid="PSA 78:2">ndavuga natura ibihishijwe, ivya kera muri kahise;<verse eid="PSA 78:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3" />ivyo twumvise tukamenya,</para>
  <para style="q2" vid="PSA 78:3">ivyo ba sogokuruza batubwiye.<verse eid="PSA 78:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4" />Ntituzobinyegeza abana bacu;</para>
  <para style="q2" vid="PSA 78:4">tuzobibwira abo mu runganwe ruzoza.</para>
  <para style="q1" vid="PSA 78:4">Ivyo <char style="nd">Uhoraho</char> yakoze bibereye gushimwa,</para>
  <para style="q2" vid="PSA 78:4">inkomezi ziwe, n’ibitangaza yakoze.<verse eid="PSA 78:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5" />Yashingiye aba Yakobo ivyagezwe</para>
  <para style="q2" vid="PSA 78:5">yashinze amabwirizwa kuri Isirayeli,</para>
  <para style="q1" vid="PSA 78:5">ivyo yategetse ba sogokuruza</para>
  <para style="q2" vid="PSA 78:5">ngo bavyigishe abana babo,<verse eid="PSA 78:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6" />kugira ngo abo mu runganwe ruzoza baze babimenye,</para>
  <para style="q2" vid="PSA 78:6">mbere n’abana bataravuka</para>
  <para style="q2" vid="PSA 78:6">maze na bo baze babibwire abana babo.<verse eid="PSA 78:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7" />Maze bazokwizigira Imana</para>
  <para style="q2" vid="PSA 78:7">kandi ntibazokwibagira ivyo yakoze</para>
  <para style="q2" vid="PSA 78:7">ariko bazokwitondera amabwirizwa yiwe.<verse eid="PSA 78:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8" />Ntibaze babe nka ba sekuruza babo;</para>
  <para style="q2" vid="PSA 78:8">bari urunganwe rw’intumva kandi rugarariza,</para>
  <para style="q1" vid="PSA 78:8">bari bafise imitima itumvira Imana,</para>
  <para style="q2" vid="PSA 78:8">imitima yabo ntiyamugororokera.<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9" />Abefurayimu naho bari bafise imiheto,</para>
  <para style="q2" vid="PSA 78:9">barahunze ku musi w’intambara.<verse eid="PSA 78:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10" />Ntibagumye mw’isezerano ry’Imana</para>
  <para style="q2" vid="PSA 78:10">kandi banse no kugendera mu Vyagezwe vyayo.<verse eid="PSA 78:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11" />Bibagiye ivyo yari yakoze,</para>
  <para style="q2" vid="PSA 78:11">hamwe n’ibitangaza yari yaraberetse.<verse eid="PSA 78:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12" />Yakoreye utwumiza imbere ya ba sekuruza babo</para>
  <para style="q2" vid="PSA 78:12">mu gihugu ca Egiputa, mu ntara y’i Zowani.<verse eid="PSA 78:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13" />Yagabuyemwo kubiri ikiyaga akibacishamwo;</para>
  <para style="q2" vid="PSA 78:13">yatumye amazi ahagarara nk’uruhome.<verse eid="PSA 78:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14" />Yabarongoje inkingi y’igicu ku murango,</para>
  <para style="q2" vid="PSA 78:14">n’inkingi y’umuriro mw’ijoro.<verse eid="PSA 78:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15" />Yasatuye igitandara mu bugaragwa</para>
  <para style="q2" vid="PSA 78:15">abaha amazi menshi nk’ayo mu biyaga;<verse eid="PSA 78:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16" />yabatoboreye umugende mu gitandara c’isare</para>
  <para style="q2" vid="PSA 78:16">atuma amazi atemba nk’inzuzi.<verse eid="PSA 78:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17" />Ariko bashishikaye kumucumurako,</para>
  <para style="q2" vid="PSA 78:17">bagarariza Iyisumbavyose bari mu bugaragwa.<verse eid="PSA 78:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18" />Bagerageje Imana n’ibigirankana</para>
  <para style="q2" vid="PSA 78:18">mu gusaba indya bipfuza.<verse eid="PSA 78:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19" />Bidodombeye Imana;</para>
  <para style="q2" vid="PSA 78:19">baravuga bati: “Mbega Imana vy’ukuri</para>
  <para style="q2" vid="PSA 78:19">yodutegurira imeza mu bugaragwa?<verse eid="PSA 78:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20" />Egome, yarakubise igitandara,</para>
  <para style="q2" vid="PSA 78:20">maze amazi aradudubiza,</para>
  <para style="q2" vid="PSA 78:20">imigezi irasendanisha,</para>
  <para style="q1" vid="PSA 78:20">ariko none yoshobora kuduha indya?</para>
  <para style="q2" vid="PSA 78:20">Yoshobora guha inyama abantu bayo?”<verse eid="PSA 78:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21" />
    <char style="nd">Uhoraho</char> abumvise, arashangashirwa;</para>
  <para style="q2" vid="PSA 78:21">umuriro wiwe waduka mu ba Yakobo,</para>
  <para style="q2" vid="PSA 78:21">n’uburake bwiwe buziriringira Isirayeli,<verse eid="PSA 78:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22" />kuko batizeye Imana</para>
  <para style="q2" vid="PSA 78:22">canke ngo bizigire ugutabara kwayo.<verse eid="PSA 78:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23" />Ariko na ho nyene yategetse ikirere</para>
  <para style="q2" vid="PSA 78:23">yugurura imiryango yo mw’ijuru;<verse eid="PSA 78:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24" />agwisha manu nk’imvura abantu bararya,</para>
  <para style="q2" vid="PSA 78:24">yabahaye imikate ivuye mw’ijuru.<verse eid="PSA 78:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25" />Abana b’abantu bariye imfungurwa z’abamarayika;</para>
  <para style="q2" vid="PSA 78:25">yabarungikiye ivyokurya vyose bashobora kurya.<verse eid="PSA 78:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26" />Yategetse ijuru kurekura umuyaga wo mu buseruko</para>
  <para style="q2" vid="PSA 78:26">kandi umuyaga wo mu bumanuko urahuhuta ku bwo inkomezi ziwe.<verse eid="PSA 78:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27" />Atuma inyama zimanuka aho bari nk’umukungugu,</para>
  <para style="q2" vid="PSA 78:27">inyoni zingana n’umusenyi wo kw’isesero ry’ikiyaga.<verse eid="PSA 78:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28" />Yatumye zarara aho bari bacumbitse,</para>
  <para style="q2" vid="PSA 78:28">hirya no hino y’amahema yabo.<verse eid="PSA 78:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29" />Barazirya gushika baziduhiwe;</para>
  <para style="q2" vid="PSA 78:29">yabahaye ivyo bipfuza.<verse eid="PSA 78:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30" />Ariko bakiriko bararya ivyo bipfuje,</para>
  <para style="q2" vid="PSA 78:30">igihe inyama zari zikiri mu kanwa kabo,<verse eid="PSA 78:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31" />Uburake bw’Imana burabaziriringira;</para>
  <para style="q2" vid="PSA 78:31">yica abanyenkomezi bari muri bo,</para>
  <para style="q2" vid="PSA 78:31">atsinda hasi imisore ya Isirayeli.<verse eid="PSA 78:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32" />Naho vyagenze uko, babandanije gucumura;</para>
  <para style="q2" vid="PSA 78:32">naho yakoze ibitangaza bikomeye, ntibamwizeye.<verse eid="PSA 78:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33" />Uko ni ko yashize kw’iherezo imisi yabo nk’impwemu zihumetswe</para>
  <para style="q2" vid="PSA 78:33">n’imyaka yo kubaho kwabo nk’ikiza.<verse eid="PSA 78:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34" />Mu gihe cose Imana yica bamwe muri bo, baca bayirondera;</para>
  <para style="q2" vid="PSA 78:34">bakayigarukako n’umwete mwinshi.<verse eid="PSA 78:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35" />Bibutse ko Imana ari yo Gitandara cabo,</para>
  <para style="q2" vid="PSA 78:35">ko Imana Musumbavyose ari yo Mucunguzi wabo.<verse eid="PSA 78:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36" />Ariko batangura kuyihemesha iminwa yabo;</para>
  <para style="q2" vid="PSA 78:36">bayihendesha indimi zabo;<verse eid="PSA 78:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37" />imitima yabo ntiyayumvira,</para>
  <para style="q2" vid="PSA 78:37">ntibitondera isezerano ryayo.<verse eid="PSA 78:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38" />Ariko naho nyene yagumye ari inyembabazi;</para>
  <para style="q2" vid="PSA 78:38">yahariye ibigabitanyo vyabo</para>
  <para style="q2" vid="PSA 78:38">ntiyabarandura.</para>
  <para style="q1" vid="PSA 78:38">Yama yigarura ikareka kuraka</para>
  <para style="q2" vid="PSA 78:38">kandi ntiyabarekurirako ubushangashirwe bwayo bwose.<verse eid="PSA 78:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39" />Imana yibutse ko ari abantu buntu</para>
  <para style="q2" vid="PSA 78:39">bameze nk’umuyaga urengana ntube ukigaruka.<verse eid="PSA 78:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40" />Ese ingene bamugararije mu bugaragwa,</para>
  <para style="q2" vid="PSA 78:40">bakamutunturiza mu gahinga!<verse eid="PSA 78:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41" />Bama bagerageza Imana kenshi;</para>
  <para style="q2" vid="PSA 78:41">barakije Uwera wa Isirayeli.<verse eid="PSA 78:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42" />Ntibibutse ubushobozi bwiwe;</para>
  <para style="q2" vid="PSA 78:42">mu gihe yabacungura akabakura mu maboko y’ababahahaza,<verse eid="PSA 78:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43" />ku musi yerekaniyeko ibitangaza vyiwe muri Egiputa,</para>
  <para style="q2" vid="PSA 78:43">hamwe n’utwumiza twiwe mu ntara ya Zowani.<verse eid="PSA 78:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44" />Yahinduye uruzi rwabo amaraso;</para>
  <para style="q2" vid="PSA 78:44">ntibashobora kunywa amazi yo mu masoko yabo.<verse eid="PSA 78:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45" />Yabarungikiye ibibugu birabarya,</para>
  <para style="q2" vid="PSA 78:45">n’ibikere vyonona igihugu cabo.<verse eid="PSA 78:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46" />Imirima yabo yayigaburiye inzige,</para>
  <para style="q2" vid="PSA 78:46">ivyimburwa vyabo biribwa n’intoteza.<verse eid="PSA 78:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47" />Imizabibu yabo yayitikirishije urubura</para>
  <para style="q2" vid="PSA 78:47">imisukomora yabo yicwa n’igikonyozi.<verse eid="PSA 78:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48" />Amasho yabo yayamarishije urubura,</para>
  <para style="q2" vid="PSA 78:48">ibitungwa vyabo yabikubitishije inkuba.<verse eid="PSA 78:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49" />Yabarekuriyeko uburake bwiwe bwaka umuriro;</para>
  <para style="q2" vid="PSA 78:49">ubushangashirwe bwiwe bwose,</para>
  <para style="q2" vid="PSA 78:49">uburake bwiwe bw’inkazi, n’igitsure ciwe;</para>
  <para style="q2" vid="PSA 78:49">vyazananye n’abamarayika barandura.<verse eid="PSA 78:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50" />Yateguye inzira y’uburake bwiwe;</para>
  <para style="q2" vid="PSA 78:50">ntiyabakingira ngo ntibapfe;</para>
  <para style="q2" vid="PSA 78:50">ariko abateza ikiza gihonya.<verse eid="PSA 78:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51" />Yishe imfura zose zo muri Egiputa,</para>
  <para style="q2" vid="PSA 78:51">uburiza bwo mu bantu bo mu mahema ya Hamu.<verse eid="PSA 78:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52" />Ariko isohora abantu bayo nk’umukuku;</para>
  <para style="q2" vid="PSA 78:52">abarongora nk’intama mu bugaragwa.<verse eid="PSA 78:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53" />Yabarongoye amahoro bituma batagira ubwoba;</para>
  <para style="q2" vid="PSA 78:53">ariko ikiyaga kimira abansi babo.<verse eid="PSA 78:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54" />Uko ni ko yabashikanye ku rubibe rw’igihugu ciwe cera,</para>
  <para style="q2" vid="PSA 78:54">mu gihugu c’imisozi yari yigarurije umuheto.<verse eid="PSA 78:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55" />Yakinagije amahanga imbere yabo</para>
  <para style="q2" vid="PSA 78:55">aca abagaburira igihugu ngo bacegukire;</para>
  <para style="q2" vid="PSA 78:55">ashira imiryango ya Isirayeli mu mazu yabo.<verse eid="PSA 78:55" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56" />Ariko bagerageza Imana</para>
  <para style="q2" vid="PSA 78:56">bagarariza Iyisumbavyose;</para>
  <para style="q2" vid="PSA 78:56">ntibitondera ivyo yashinze.<verse eid="PSA 78:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57" />Bagararije nka ba sekuruza babo ntibizera,</para>
  <para style="q2" vid="PSA 78:57">bamera nk’umuheto ugoramye ata wowizigira.<verse eid="PSA 78:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58" />Bayirakishije n’ibibanza vyo gusengeramwo ku misozi;</para>
  <para style="q2" vid="PSA 78:58">bayiteje ishari ibigirwamana vyabo.<verse eid="PSA 78:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59" />Imana imaze kubumva irashangashirwa;</para>
  <para style="q2" vid="PSA 78:59">ica iheba Isirayeli rwose.<verse eid="PSA 78:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60" />Iheba inzu yayo yari i Shilo,</para>
  <para style="q2" vid="PSA 78:60">ihema yari yashinze mu bana b’abantu.<verse eid="PSA 78:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61" />Yemera ko isandugu y’inkomezi ziwe ijanwa mu kinyago,</para>
  <para style="q2" vid="PSA 78:61">n’ubwiza bwiwe ko bukorokera mu maboko y’umwansi.<verse eid="PSA 78:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62" />Abantu biwe yabarekuriye ku nkota;</para>
  <para style="q2" vid="PSA 78:62">arakira umugabane wiwe.<verse eid="PSA 78:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63" />Umuriro watongoye abasore babo,</para>
  <para style="q2" vid="PSA 78:63">n’inkumi zabo ntizavyinye imvyino z’ubukwe;<verse eid="PSA 78:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64" />abaherezi babo bamazwe n’inkota,</para>
  <para style="q2" vid="PSA 78:64">n’abapfakazi babo ntibashobora kurira.<verse eid="PSA 78:64" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65" />Maze Imana ivyuka nk’iyari isinziriye,</para>
  <para style="q2" vid="PSA 78:65">nk’umuhizi atewe intege n’umuvinyu.<verse eid="PSA 78:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66" />Yasanzaje abansi bayo;</para>
  <para style="q2" vid="PSA 78:66">ibateza ibimaramare bidashira.<verse eid="PSA 78:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67" />Maze itera ibitugu amahema ya Yosefu,</para>
  <para style="q2" vid="PSA 78:67">ntiyatoranya umuryango wa Efurayimu;<verse eid="PSA 78:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68" />Ariko itoranya umuryango wa Yuda,</para>
  <para style="q2" vid="PSA 78:68">Umusozi Siyoni, uwo yakunze.<verse eid="PSA 78:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69" />Yubatse Ingoro yayo nk’agatwe k’umusozi,</para>
  <para style="q2" vid="PSA 78:69">iyigira nk’isi yama ishimangiye ibihe vyose.<verse eid="PSA 78:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70" />Yatoranije Dawidi umusavyi wayo</para>
  <para style="q2" vid="PSA 78:70">maze imukura mu mpongore z’intama;<verse eid="PSA 78:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71" />yamukuye inyuma y’intama</para>
  <para style="q2" vid="PSA 78:71">imuhindura umwungere w’abantu bayo ari bo bene Yakobo,</para>
  <para style="q2" vid="PSA 78:71">Isirayeli inyegu yiwe.<verse eid="PSA 78:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72" />Maze Dawidi abaragirana umutima utunganye;</para>
  <para style="q2" vid="PSA 78:72">abarongoza ubuhinga bwo mu biganza vyiwe.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="cl">Zaburi ya 79</para>
  <para style="d">Ni Zaburi ya Asafu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1" />Mana, amahanga yateye mu mugabane wawe;</para>
  <para style="q2" vid="PSA 79:1">bahumanije Ingoro yawe yera,</para>
  <para style="q2" vid="PSA 79:1">Yerusalemu bahahinduye umusaka.<verse eid="PSA 79:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2" />Imivyimba y’abasavyi bawe</para>
  <para style="q2" vid="PSA 79:2">bayigaburiye ibisiga vyo mu kirere,</para>
  <para style="q2" vid="PSA 79:2">inyama z’abantu bawe bazigaburiye ibikoko vyo mw’ishamba.<verse eid="PSA 79:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3" />Basheshe amaraso nk’amazi</para>
  <para style="q2" vid="PSA 79:3">hirya no hino i Yerusalemu,</para>
  <para style="q2" vid="PSA 79:3">kandi nta muntu asigaye wo guhamba abapfuye.<verse eid="PSA 79:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4" />Ku babanyi bacu twahindutse akamenyo,</para>
  <para style="q2" vid="PSA 79:4">turacokorwa tugatukwa n’abadukikije.<verse eid="PSA 79:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5" />Uzogeza ryari, ewe <char style="nd">Uhoraho</char>? Uzokwama uturakiye ibihe vyose?</para>
  <para style="q2" vid="PSA 79:5">Uburake bwawe buzotuziriringira kugeza ryari?<verse eid="PSA 79:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6" />Suka uburake bwawe kuri ayo mahanga</para>
  <para style="q2" vid="PSA 79:6">atakwemera,</para>
  <para style="q1" vid="PSA 79:6">kuri ubwo bwami</para>
  <para style="q2" vid="PSA 79:6">butambaza izina ryawe;<verse eid="PSA 79:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7" />Kuko batsontsomeye Yakobo</para>
  <para style="q2" vid="PSA 79:7">bagasambura igihugu ciwe.<verse eid="PSA 79:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8" />Ntuduharureko ivyaha vya ba sogokuruza;</para>
  <para style="q2" vid="PSA 79:8">imbabazi zawe nizize zinyaruka aho turi,</para>
  <para style="q2" vid="PSA 79:8">kuko dukeneye gutabarwa.<verse eid="PSA 79:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9" />Dufashe, Mana mukiza wacu,</para>
  <para style="q2" vid="PSA 79:9">ku bw’icubahiro c’izina ryawe;</para>
  <para style="q1" vid="PSA 79:9">dukize uduharire n’ivyaha vyacu</para>
  <para style="q2" vid="PSA 79:9">ku bwo’izina ryawe.<verse eid="PSA 79:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10" />Ni kuki amahanga yobaza ati:</para>
  <para style="q2" vid="PSA 79:10">“Imana yabo iri hehe?”</para>
  <para style="b" vid="PSA 79:10" />
  <para style="q1" vid="PSA 79:10">Imbere y’amaso yacu, menyekanisha mu mahanga</para>
  <para style="q2" vid="PSA 79:10">ko uhora amaraso y’abasavyi bawe yasesetse.<verse eid="PSA 79:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11" />Amaborogo y’imbohe nashike imbere yawe;</para>
  <para style="q2" vid="PSA 79:11">ukirishe ukuboko kwawe kw’inkomezi abagerewe gupfa.<verse eid="PSA 79:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12" />Usubirize mu nkoko abadukikije incuro indwi</para>
  <para style="q2" vid="PSA 79:12">agacokoro bagucokoye, ewe Mana.<verse eid="PSA 79:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13" />Maze twebwe abantu bawe, intama zo mu buragiro bwawe,</para>
  <para style="q2" vid="PSA 79:13">tuzoguhimbaza ibihe bidashira;</para>
  <para style="q1" vid="PSA 79:13">uko urunganwe ruzokurikirana n’urundi</para>
  <para style="q2" vid="PSA 79:13">tuzokwamamaza ishimwe ryawe.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="cl">Zaburi ya 80</para>
  <para style="d">Iyi Zaburi yahawe umukuru w’abaririmvyi. Mw’ijwi ryitwa “Ibirungu vy’Isezerano”. Ni iya Asafu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1" />Nutwumve, Mwungere wa Isirayeli,</para>
  <para style="q2" vid="PSA 80:1">wewe urongora aba Yosefu nk’umukuku.</para>
  <para style="q1" vid="PSA 80:1">Wewe uvyagiye hagati y’abakerubi,</para>
  <para style="q2" vid="PSA 80:1">kayangana <verse eid="PSA 80:1" /><verse number="2" style="v" sid="PSA 80:2" />imbere ya Efurayimu, Benyamini na Manase.</para>
  <para style="q1" vid="PSA 80:2">Vyuka mu nkomezi zawe;</para>
  <para style="q2" vid="PSA 80:2">nuze udukize.<verse eid="PSA 80:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3" />Tugarukane, ewe Mana;</para>
  <para style="q2" vid="PSA 80:3">tumurikishirize mu nyonga hawe,</para>
  <para style="q2" vid="PSA 80:3">kugira ngo dukire.<verse eid="PSA 80:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4" />Uzogeza ryari, <char style="nd">Uhoraho</char> Imana Mushoboravyose,</para>
  <para style="q2" vid="PSA 80:4">kuturakira</para>
  <para style="q2" vid="PSA 80:4">no gushiburira kure ugusenga kw’abantu bawe?<verse eid="PSA 80:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5" />Wabagaburiye indya z’amosozi;</para>
  <para style="q2" vid="PSA 80:5">wabanywesheje ikiyaga c’amosozi.<verse eid="PSA 80:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6" />Waduhinduye akamenyo mu bihugu bidukikije,</para>
  <para style="q2" vid="PSA 80:6">kandi abansi bacu baraducokora.<verse eid="PSA 80:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7" />Tugarukane, ewe Mana Mushoboravyose;</para>
  <para style="q2" vid="PSA 80:7">tumurikishirize mu nyonga hawe,</para>
  <para style="q2" vid="PSA 80:7">kugira ngo dukire.<verse eid="PSA 80:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8" />Wabatuye umuzabibu uwukuye muri Egiputa;</para>
  <para style="q2" vid="PSA 80:8">wirukana amahanga uraheza urawubadika.<verse eid="PSA 80:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9" />Wawuteguriye aho kuwutera,</para>
  <para style="q2" vid="PSA 80:9">maze ushora imizi ukwira igihugu cose.<verse eid="PSA 80:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10" />Imisozi yose yapfutswe n’igitutu cawo,</para>
  <para style="q2" vid="PSA 80:10">amashami yawo yapfutse amasederi maremare y’Imana<verse eid="PSA 80:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11" />Amashami yawo yashitse no ku Kiyaga Mediterane,</para>
  <para style="q2" vid="PSA 80:11">imivyaro yawo ishika kuri rwa Ruzi.<verse eid="PSA 80:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12" />Ni kuki wahomvoye inzitiro zawo</para>
  <para style="q2" vid="PSA 80:12">bigatuma abirenganira bamura inzabibu zawo?<verse eid="PSA 80:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13" />Ingurube zo mw’ishamba zarawononye,</para>
  <para style="q2" vid="PSA 80:13">n’udukoko two ku misozi turawurisha.<verse eid="PSA 80:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14" />Garuka aho turi, Mana Mushoboravyose!</para>
  <para style="q2" vid="PSA 80:14">Urunguruke uri mw’ijuru urabe!</para>
  <para style="q1" vid="PSA 80:14">Garuka witwararike uwo muzabibu wawe,<verse eid="PSA 80:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 80:15" />umuzi ukuboko kwawe kw’i buryo kwabaditse,</para>
  <para style="q2" vid="PSA 80:15">umwana wirereye ngo abe uwawe.<verse eid="PSA 80:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16" />Umuzabibu wawe uciriwe hasi, utongowe n’umuriro;</para>
  <para style="q2" vid="PSA 80:16">ku bwo gukankama kwawe, abantu bawe barahonye.<verse eid="PSA 80:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17" />Ukuboko kwawe ni kugume ku muntu ari i buryo bwawe,</para>
  <para style="q2" vid="PSA 80:17">ku mwana w’umuntu wirereye ngo abe uwawe.<verse eid="PSA 80:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18" />Maze natwe ntituzokuvako;</para>
  <para style="q2" vid="PSA 80:18">duhembure, natwe tuzokwambaza izina ryawe.<verse eid="PSA 80:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19" />Tugarukane, ewe <char style="nd">Uhoraho</char> Mana Mushoboravyose;</para>
  <para style="q2" vid="PSA 80:19">tumurikishirize mu nyonga hawe,</para>
  <para style="q2" vid="PSA 80:19">kugira ngo dukire.<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="cl">Zaburi ya 81</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Muri Gititi. Ni iya asafu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1" />Nimuvugirize Imana impundu y’umunezero, yo nkomezi zacu;</para>
  <para style="q2" vid="PSA 81:1">muririmbire Imana ya Yakobo n’ijwi rirenga!<verse eid="PSA 81:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2" />Shirako mucurarange, muvuze ingoma,</para>
  <para style="q2" vid="PSA 81:2">muvuze inanga y’ijwi rirengera n’ikembe.<verse eid="PSA 81:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3" />Muvuze ihembe ry’intama ku mboneko y’ukwezi,</para>
  <para style="q2" vid="PSA 81:3">no mu mfato zakwo, ku musi mukuru wacu;<verse eid="PSA 81:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4" />iki ni icagezwe kuri Isirayeli,</para>
  <para style="q2" vid="PSA 81:4">ni ibwirizwa ry’Imana ya Yakobo.<verse eid="PSA 81:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5" />Aho Imana yaja kugwanya Egiputa,</para>
  <para style="q2" vid="PSA 81:5">yarishinze nk’ibwirizwa ku ba Yosefu.</para>
  <para style="b" vid="PSA 81:5" />
  <para style="q1" vid="PSA 81:5">Numvise ijwi ntazi rivuga riti:<verse eid="PSA 81:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6" />“Nabatuye umutwaro wari ku bitugu vyabo;</para>
  <para style="q2" vid="PSA 81:6">nakijije amaboko yabo ibitebo vy’amatafari.<verse eid="PSA 81:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7" />Mu marushwa yanyu mwaranyambaje nanje ndabakiza,</para>
  <para style="q2" vid="PSA 81:7">nabishuye ndi mu gihuhusi;</para>
  <para style="q2" vid="PSA 81:7">nabagereje ku mazi y’i Meriba.<verse eid="PSA 81:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8" />Nimuntege amatwi, yemwe bantu banje, kuko ngira ndabihanikirize;</para>
  <para style="q2" vid="PSA 81:8">ese icompa mukanyumvira, yewe Isirayeli!<verse eid="PSA 81:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9" />Ntihakagire imana y’inyamahanga iba muri mwebwe;</para>
  <para style="q2" vid="PSA 81:9">ntihakagire iyindi mana musenga atari jewe.<verse eid="PSA 81:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10" />Ndi <char style="nd">Uhoraho</char> Imana yanyu,</para>
  <para style="q2" vid="PSA 81:10">nabaduganye ndabakuye muri Egiputa.</para>
  <para style="q1" vid="PSA 81:10">Asama cane nanje nduzuza akanwa kawe.<verse eid="PSA 81:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11" />Ariko abantu banje ntibanyumviye;</para>
  <para style="q2" vid="PSA 81:11">Isirayeli ntibanyubashe.<verse eid="PSA 81:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12" />Ni co catumye ndeka imitima yabo ikomantaye</para>
  <para style="q2" vid="PSA 81:12">ngo ikurikire ivyo biyumvira.<verse eid="PSA 81:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13" />Icompa abantu banje bakanyumvira,</para>
  <para style="q2" vid="PSA 81:13">icompa Isirayeli bagakurikira inzira zanje,<verse eid="PSA 81:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14" />nokwirukanye abansi babo vuba</para>
  <para style="q2" vid="PSA 81:14">nohindukirije ukuboko kwanje ku babagwanya!<verse eid="PSA 81:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15" />Abanka <char style="nd">Uhoraho</char> bomwunamira,</para>
  <para style="q2" vid="PSA 81:15">kandi igihano cabo cobaye ic’ibihe vyose.<verse eid="PSA 81:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16" />Ariko mweho mwogaburiwe ingano z’indobanurwa;</para>
  <para style="q2" vid="PSA 81:16">kandi nobahagije ubuki bwo mu gitandara.”<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="cl">Zaburi ya 82</para>
  <para style="d">Ni Zaburi ya Asafu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1" />Imana ivyagiye mu nama nkuru y’ubucamanza;</para>
  <para style="q2" vid="PSA 82:1">icira imanza ibigirwamana:<verse eid="PSA 82:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2" />iti: “Muzogeza ryari kuburanira abo gutsindwa</para>
  <para style="q2" vid="PSA 82:2">no kwerekeza urubanza ku banyakibi?<verse eid="PSA 82:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3" />Nimuburanire abanyantegenke n’impfuvyi;</para>
  <para style="q2" vid="PSA 82:3">muburane urw’umukene n’uwuhahazwa.<verse eid="PSA 82:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4" />Mutabare umunyantegenke n’umukene;</para>
  <para style="q2" vid="PSA 82:4">mubakure mu maboko y’umunyakibi.<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5" />Ibigirwamana nta co bizi, nta co bitahura.</para>
  <para style="q2" vid="PSA 82:5">Bigendagenda mu mwiza;</para>
  <para style="q2" vid="PSA 82:5">amatanguriro y’isi yose aranyiganyize.<verse eid="PSA 82:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6" />Naravuze nti: ‘Muri imana’</para>
  <para style="q2" vid="PSA 82:6">mwese muri abana b’Iyisumbavyose.<verse eid="PSA 82:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7" />Ariko muzopfa nk’abantu buntu;</para>
  <para style="q2" vid="PSA 82:7">muzogwa nk’uko abandi batware bose bagwa.”<verse eid="PSA 82:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8" />Va hasi, ewe Mana, ucire urubanza isi,</para>
  <para style="q2" vid="PSA 82:8">kuko amahanga yose ari umugabane wawe.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="cl">Zaburi ya 83</para>
  <para style="d">Ni indirimbo. Ni Zaburi ya Asafu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1" />Mana, ntugume wihoreye;</para>
  <para style="q2" vid="PSA 83:1">ntiwice ugutwi,</para>
  <para style="q2" vid="PSA 83:1">ntugume wihoreye, ewe Mana!<verse eid="PSA 83:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2" />Raba uko abansi bawe bakuye hasi,</para>
  <para style="q2" vid="PSA 83:2">uko abakugwanya bagararije.<verse eid="PSA 83:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3" />Bagira inama abantu bawe mu bugunge,</para>
  <para style="q2" vid="PSA 83:3">bagira imigabo mibi abo ukunda cane.<verse eid="PSA 83:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4" />Baravuga bati: “Nimuze tubamare baherengetere nk’igihugu,</para>
  <para style="q2" vid="PSA 83:4">kugira ngo izina rya Isirayeli ntiribe ricibukwa.”<verse eid="PSA 83:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5" />Bahuje umutima bagira imigabo;</para>
  <para style="q2" vid="PSA 83:5">bigize akagwi ngo bakugwanye;<verse eid="PSA 83:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6" />amahema ya Edomu n’ay’Abishimayeli,</para>
  <para style="q2" vid="PSA 83:6">aya Mowabu n’ay’Abahaguri,<verse eid="PSA 83:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7" />Abagebali, Abamoni n’Abamaleki,</para>
  <para style="q2" vid="PSA 83:7">Abafilisitiya, n’abantu b’i Tiro.<verse eid="PSA 83:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8" />N’ab’i Ashuri na bo bifatanije na bo</para>
  <para style="q2" vid="PSA 83:8">ngo bahe inkomezi bene Loti.<verse eid="PSA 83:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9" />Bagirire ivyo wagiriye Abamidiyani,</para>
  <para style="q2" vid="PSA 83:9">nk’uko wagiriye Sisera na Yabini ku mugezi Kishoni,<verse eid="PSA 83:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10" />bamwe bahonera muri Eni-Dori</para>
  <para style="q2" vid="PSA 83:10">bagacika nk’amase ku mbuga.<verse eid="PSA 83:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11" />Abaganwa babo nubagirire nka Orebu na Zeyebu,</para>
  <para style="q2" vid="PSA 83:11">abana b’umwami waho ubagire nka Zeba na Zalimuna,<verse eid="PSA 83:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12" />bamwe bavuga ngo: “Reka tugende twigarurire</para>
  <para style="q2" vid="PSA 83:12">uburagiro bw’Imana.”<verse eid="PSA 83:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13" />Bahindure nk’agashururu, Mana yanje,</para>
  <para style="q2" vid="PSA 83:13">ubagire nk’umuguruka utwarwa n’umuyaga.<verse eid="PSA 83:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14" />Nk’uko umuriro utongora ishamba</para>
  <para style="q2" vid="PSA 83:14">canke imbeya z’umuriro zitongora imisozi,<verse eid="PSA 83:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15" />abe ari ko ubakurikiza igihuhusi cawe</para>
  <para style="q2" vid="PSA 83:15">ubateze ubwoba igihuhusi cawe.<verse eid="PSA 83:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16" />Mu maso habo nihuzure ibiteterwe, <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 83:16">kugira ngo baze bakurondere.<verse eid="PSA 83:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17" />Nibamaramare bicwe n’ubwoba ibihe vyose;</para>
  <para style="q2" vid="PSA 83:17">barinde bapfa bari mu bimaramare.<verse eid="PSA 83:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18" />Nibamenye ko wewe, wewe izina ryawe ari <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 83:18">ari wewe wenyene uri Iyisumbavyose kw’isi yose.<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="cl">Zaburi ya 84</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Mw’ijwi ryitwa Gititi. Ni iya bene Kora. Ni Zaburi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1" />Ese ingene Ingoro yawe ari nziza,</para>
  <para style="q2" vid="PSA 84:1">Ewe <char style="nd">Uhoraho</char> Mushoboravyose!<verse eid="PSA 84:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2" />Umutima wanje uraniha, unkabiraniyemwo</para>
  <para style="q2" vid="PSA 84:2">ku bwo gukumbura ibirimba vy’<char style="nd">Uhoraho</char>;</para>
  <para style="q1" vid="PSA 84:2">umutima wanje n’umubiri wanje</para>
  <para style="q2" vid="PSA 84:2">biratakambira Imana nzima.<verse eid="PSA 84:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3" />Utunyoni na two twironkeye aho kuba,</para>
  <para style="q2" vid="PSA 84:3">n’intamba zironkeye icari,</para>
  <para style="q2" vid="PSA 84:3">aho gushira uduswi twazo;</para>
  <para style="q1" vid="PSA 84:3">i ruhande y’igicaniro cawe,</para>
  <para style="q2" vid="PSA 84:3">
    <char style="nd">Uhoraho</char> Mushoboravyose, Mwami wanje, Mana yanje.<verse eid="PSA 84:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4" />Hahiriwe abibera mu nzu yawe;</para>
  <para style="q2" vid="PSA 84:4">bama baguhimbaza.<verse eid="PSA 84:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5" />Hahiriwe abafise inkomezi muri wewe,</para>
  <para style="q2" vid="PSA 84:5">imitima yabo yama yiteguye kuja mu rugendo ruja i Siyoni.<verse eid="PSA 84:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6" />Iyo baciye mu Mwonga wa Baka, bisigura “umwonga w’amarira”,</para>
  <para style="q2" vid="PSA 84:6">bahahindura ahantu h’amariba;</para>
  <para style="q2" vid="PSA 84:6">kandi n’imvura yo ku mutasuro iwambika imigisha.<verse eid="PSA 84:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7" />Bagenda biyubura mu nkomezi nsha,</para>
  <para style="q2" vid="PSA 84:7">kugeza umwe wese ashitse imbere y’Imana i Siyoni.<verse eid="PSA 84:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8" />Umva ugusenga kwanje, <char style="nd">Uhoraho</char> Mana Mushoboravyose;</para>
  <para style="q2" vid="PSA 84:8">ntega ugutwi, Mana ya Yakobo.<verse eid="PSA 84:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9" />Raba wewe nkinzo yacu, ewe Mana;</para>
  <para style="q2" vid="PSA 84:9">raba ryiza uwo warobanuje amavuta.<verse eid="PSA 84:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10" />Kumara umusi umwe mu birimba vyawe</para>
  <para style="q2" vid="PSA 84:10">biruta kumara imisi igihumbi ahandi;</para>
  <para style="q1" vid="PSA 84:10">nopfuma mba umurinzi w’irembo ry’inzu y’Imana yanje</para>
  <para style="q2" vid="PSA 84:10">hako mba mu mahema y’abanyakibi.<verse eid="PSA 84:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11" />Kuko <char style="nd">Uhoraho</char> Imana ari izuba akaba n’inkinzo;</para>
  <para style="q2" vid="PSA 84:11">
    <char style="nd">Uhoraho</char> agira ubuntu agatanga icubahiro;</para>
  <para style="q1" vid="PSA 84:11">ntazogira iciza yima</para>
  <para style="q2" vid="PSA 84:11">abagenda batunganye.<verse eid="PSA 84:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12" />
    <char style="nd">Uhoraho</char> Mushoboravyose,</para>
  <para style="q2" vid="PSA 84:12">hahiriwe uwukwizigira.<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="cl">Zaburi ya 85</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni iya bene Kora. Ni Zaburi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1" />
    <char style="nd">Uhoraho</char>, wewe werekanye imbabazi ku gihugu cawe;</para>
  <para style="q2" vid="PSA 85:1">wagarukanye inyagano zo mu ba Yakobo.<verse eid="PSA 85:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2" />Wahariye ukugabitanya kw’abantu bawe</para>
  <para style="q2" vid="PSA 85:2">utwikira ivyaha vyabo vyose.<verse eid="PSA 85:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3" />Warigaruye uva mu burake bwawe</para>
  <para style="q2" vid="PSA 85:3">ureka ubushangashirwe bwawe bw’inkazi.<verse eid="PSA 85:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4" />Subira utugarukane, ewe Mana Mukiza wacu,</para>
  <para style="q2" vid="PSA 85:4">udukureko ukuturakira waturakiye.<verse eid="PSA 85:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5" />Mbega uzokwama uturakiye ibihe vyose?</para>
  <para style="q2" vid="PSA 85:5">Mbega uburake bwawe buzogumaho uko urunganwe ruzogenda rukurikirana?<verse eid="PSA 85:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6" />Mbega ntuzoduhembura,</para>
  <para style="q2" vid="PSA 85:6">kugira ngo abantu bawe bakunezerererwe?<verse eid="PSA 85:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7" />Twereke urukundo rwawe rudashira, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 85:7">uduhe agakiza kawe.<verse eid="PSA 85:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8" />Nzokwumviriza ivyo <char style="nd">Uhoraho</char> Imana avuga;</para>
  <para style="q2" vid="PSA 85:8">yasezeraniye amahoro abantu biwe, abantu biwe bamwumvira;</para>
  <para style="q2" vid="PSA 85:8">ariko ntibasubire mu bupfu bwabo.<verse eid="PSA 85:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9" />Ni ukuri agakiza kiwe kari hafi y’abamwubaha,</para>
  <para style="q2" vid="PSA 85:9">kugira ngo ubwiza bwiwe bugume mu gihugu cacu.<verse eid="PSA 85:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10" />Urukundo n’ubwizigirwa birahuye;</para>
  <para style="q2" vid="PSA 85:10">ubugororotsi n’amahoro biragumbiranye.<verse eid="PSA 85:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11" />Ubwizigirwa buratutuje buva mw’ivu,</para>
  <para style="q2" vid="PSA 85:11">ubugororotsi bumanutse buva mw’ijuru.<verse eid="PSA 85:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12" />
    <char style="nd">Uhoraho</char> azotanga ivyiza vy’ukuri,</para>
  <para style="q2" vid="PSA 85:12">maze igihugu cacu kizokwera ivyimburwa vyaco.<verse eid="PSA 85:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13" />Ukugororoka kumugiye imbere</para>
  <para style="q2" vid="PSA 85:13">kugira ngo kumutegurire inzira acamwo.<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="cl">Zaburi ya 86</para>
  <para style="d">Isengesho rya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1" />Ntega ugutwi, <char style="nd">Uhoraho</char>, maze unyishure,</para>
  <para style="q2" vid="PSA 86:1">kuko ndi umukene n’umugorwa.<verse eid="PSA 86:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2" />Zigama ubugingo bwanje, kuko ndi umwizigirwa kuri wewe;</para>
  <para style="q2" vid="PSA 86:2">kiza umusavyi wawe akwizigira;</para>
  <para style="q1" vid="PSA 86:2">uri Imana yanje;<verse eid="PSA 86:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3" />ngirira imbabazi, ewe Mana,</para>
  <para style="q2" vid="PSA 86:3">kuko ndakwambaza bukarinda bwira.<verse eid="PSA 86:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4" />Zanira umunezero k’umusavyi wawe, ewe Mana,</para>
  <para style="q2" vid="PSA 86:4">kuko nkwizigira.<verse eid="PSA 86:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5" />Ewe Mana, uraharira kandi uri mwiza,</para>
  <para style="q2" vid="PSA 86:5">kandi ufise urukundo rwinshi ku bakwambaza bose.<verse eid="PSA 86:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6" />Niwumve ugusenga kwanje, <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 86:6">niwumve ugutakamba kwanje.<verse eid="PSA 86:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7" />Iyo ndi mu mubabaro, ndakwambaza,</para>
  <para style="q2" vid="PSA 86:7">kuko unyishura.<verse eid="PSA 86:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8" />Nta n’imwe mu zindi mana imeze nkawe, ewe Uhoraho;</para>
  <para style="q2" vid="PSA 86:8">nta wushobora gukora nk’ivyo ukora.<verse eid="PSA 86:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9" />Amahanga yose waremye</para>
  <para style="q2" vid="PSA 86:9">azoza akwikubite imbere, ewe Mana;</para>
  <para style="q2" vid="PSA 86:9">bazoshima izina ryawe.<verse eid="PSA 86:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10" />Kuko uhambaye kandi ukora ibihambaye;</para>
  <para style="q2" vid="PSA 86:10">ni wewe wenyene uri Imana.<verse eid="PSA 86:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11" />Nyigisha inzira zawe, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 86:11">kugira ngo nizigire ukwizigirwa kwawe;</para>
  <para style="q1" vid="PSA 86:11">umpe umutima ugororotse,</para>
  <para style="q2" vid="PSA 86:11">kugira ngo nubahe izina ryawe.<verse eid="PSA 86:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12" />Nzogushima, ewe Uhoraho Mana yanje, n’umutima wanje wose;</para>
  <para style="q2" vid="PSA 86:12">nzoshima izina ryawe ibihe bidashira.<verse eid="PSA 86:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13" />Kuko urukundo unkunda ari rwinshi;</para>
  <para style="q2" vid="PSA 86:13">wantabaye ukankura i bwina,</para>
  <para style="q2" vid="PSA 86:13">iwabo w’abapfuye.<verse eid="PSA 86:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14" />Abangwanya bibona baranteye, Mana;</para>
  <para style="q2" vid="PSA 86:14">abantu b’ibirara bagomba kunyica;</para>
  <para style="q2" vid="PSA 86:14">ntibakubabaye na mba.<verse eid="PSA 86:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15" />Ariko wewe, Uhoraho, uri Imana y’inyabuntu igira imbabazi,</para>
  <para style="q2" vid="PSA 86:15">iteba kuraka, yuzuye urukundo n’ubwizigirwa.<verse eid="PSA 86:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16" />Hindukira ungirire imbabazi;</para>
  <para style="q2" vid="PSA 86:16">erekana inkomezi zawe zo gutabara umusavyi wawe;</para>
  <para style="q1" vid="PSA 86:16">unkize, kuko ndagukorera</para>
  <para style="q2" vid="PSA 86:16">nk’uko na mama yabikora.<verse eid="PSA 86:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17" />Nyereka ikimenyetso c’ukugira neza kwawe,</para>
  <para style="q2" vid="PSA 86:17">kugira ngo abansi banje babibone bamaramare,</para>
  <para style="q2" vid="PSA 86:17">kuko wewe, <char style="nd">Uhoraho</char>, wantabaye ukandemesha.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="cl">Zaburi ya 87</para>
  <para style="d">Ni iya bene Kora. Ni Zaburi, kandi ni indirimbo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1" />Yashinze igisagara ciwe ku musozi wera.<verse eid="PSA 87:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2" />
    <char style="nd">Uhoraho</char> akunda amarembo y’i Siyoni</para>
  <para style="q2" vid="PSA 87:2">kurusha ibindi bisagara vyose vy’aba Yakobo.<verse eid="PSA 87:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3" />Hari ivyiza vyavuzwe kuri wewe,</para>
  <para style="q2" vid="PSA 87:3">ewe gisagara c’Imana:<verse eid="PSA 87:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4" />“Nzokwandika Egiputa na Babiloni</para>
  <para style="q2" vid="PSA 87:4">mu gitigiri c’abanyemera;</para>
  <para style="q1" vid="PSA 87:4">no mu Bafilisitiya naho nyene, n’i Tiro, hamwe na Kushi;</para>
  <para style="q2" vid="PSA 87:4">maze nzovuga nti: ‘Uwu yavukiye muri Siyoni.’ ”<verse eid="PSA 87:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5" />Ni ivy’ukuri, bizovugwa kuri Siyoni ngo:</para>
  <para style="q2" vid="PSA 87:5">“Uwu n’urya bose bavukiye ngaha,</para>
  <para style="q2" vid="PSA 87:5">kandi Iyisumbavyose ubwayo ni yo izohubaka ihakomeze.”<verse eid="PSA 87:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6" />
    <char style="nd">Uhoraho</char> azokwandika ku gitabu c’amoko ati:</para>
  <para style="q2" vid="PSA 87:6">“Uwu yavukiye i Siyoni.”<verse eid="PSA 87:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7" />Uko bazocuraranga bazoririmba bati:</para>
  <para style="q2" vid="PSA 87:7">“Amasoko yanje yose ari muri wewe.”<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="cl">Zaburi ya 88</para>
  <para style="d">Ni indirimbo. Ni Zaburi ya bene Kora. Yahawe umukuru w’abaririmvyi mw’ijwi ryitwa Mahalati Leyanoti. Ni masikili ya Hemani Umunyazirahi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1" />
    <char style="nd">Uhoraho</char>, uri Imana inkiza;</para>
  <para style="q2" vid="PSA 88:1">ndagutakambira ku murango no mw’ijoro.<verse eid="PSA 88:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2" />Icompa isengesho ryanje rigashika imbere yawe;</para>
  <para style="q2" vid="PSA 88:2">tega ugutwi ugutakamba kwanje.<verse eid="PSA 88:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3" />Amagorwa arandengeye</para>
  <para style="q2" vid="PSA 88:3">kandi ubugingo bwanje bwegereye urupfu.<verse eid="PSA 88:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4" />Mparurwa mu bamanuka baja muri rwa rwobo;</para>
  <para style="q2" vid="PSA 88:4">nabaye nk’umwe mu banyantegenke.<verse eid="PSA 88:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5" />Nashizwe hamwe n’abapfuye,</para>
  <para style="q2" vid="PSA 88:5">nk’abishwe barambaraye mu mva,</para>
  <para style="q1" vid="PSA 88:5">abo utacibuka,</para>
  <para style="q2" vid="PSA 88:5">abo utakibabara.<verse eid="PSA 88:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6" />Wanshize mu rwobo rw’i bwina,</para>
  <para style="q2" vid="PSA 88:6">ahantu hacuze umwijima.<verse eid="PSA 88:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7" />Uburake bwawe burandemereye;</para>
  <para style="q2" vid="PSA 88:7">watumye imipfunda yawe indengera.<verse eid="PSA 88:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8" />Wankuye mu bagenzi banje pfampfe</para>
  <para style="q2" vid="PSA 88:8">utuma ndabasesema. Ndugaranywe</para>
  <para style="q1" vid="PSA 88:8">kandi sinshobora gusohoka;<verse eid="PSA 88:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 88:9" />amaso yanje ahumishijwe n’umubabaro.</para>
  <para style="b" vid="PSA 88:9" />
  <para style="q1" vid="PSA 88:9">Imisi yose, ndakwambaza;</para>
  <para style="q2" vid="PSA 88:9">ndagutarikira amaboko.<verse eid="PSA 88:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10" />Mbega uzokwereka ibitangaza vyawe abapfuye?</para>
  <para style="q2" vid="PSA 88:10">Mbega impwemu zabo zizozuka, ziguhimbaze?<verse eid="PSA 88:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11" />Mbega urukundo rwawe ruzomenyekanishwa mu mva,</para>
  <para style="q2" vid="PSA 88:11">n’ukwizigirwa kwawe ahantu h’abapfuye?<verse eid="PSA 88:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12" />Ibitangaza vyawe, mbega bizomenyekanira ahantu h’umwijima,</para>
  <para style="q2" vid="PSA 88:12">canke ibikorwa vyawe vyo kugororoka mu gihugu co kwibagiranwa?<verse eid="PSA 88:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13" />Ariko ndagutakambira, ewe <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 88:13">mu gitondo ugusenga kwanje kuza imbere yawe.<verse eid="PSA 88:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14" />Ni igiki gitumye unta kure, ewe <char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 88:14">ukampisha mu nyonga hawe?<verse eid="PSA 88:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15" />Kuva mu buto bwanje namye ndi mu mubabaro negereye urupfu;</para>
  <para style="q2" vid="PSA 88:15">navukiye mu biteye ubwoba kandi ndihebuye.<verse eid="PSA 88:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16" />Uburake bwawe bwanciyeko;</para>
  <para style="q2" vid="PSA 88:16">ibiteye ubwoba vyawe biranyishe.<verse eid="PSA 88:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17" />Birankikuza bukarinda bwira nk’imipfunda;</para>
  <para style="q2" vid="PSA 88:17">vyandengeye impande zose.<verse eid="PSA 88:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18" />Wankuyeko abagenzi n’ababanyi;</para>
  <para style="q2" vid="PSA 88:18">umwijima ni wo wabaye umukunzi wanje wa hafi.<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="cl">Zaburi ya 89</para>
  <para style="d">Ni masikili ya Etani Umunyezirahi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1" />Nzoririmba urukundo ruhambaye rw’<char style="nd">Uhoraho</char> ibihe vyose;</para>
  <para style="q2" vid="PSA 89:1">nzomenyekanisha akanwa kanje ukwizigirwa kwawe</para>
  <para style="q2" vid="PSA 89:1">uko urunganwe ruzogenda rukurikirana n’urundi.<verse eid="PSA 89:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2" />Nzovuga ko urukundo rwawe rwamaho ibihe bidashira,</para>
  <para style="q2" vid="PSA 89:2">ko washinze ubwizigirwa bwawe mw’ijuru ubwaryo.<verse eid="PSA 89:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3" />Waravuze uti: “Nasezeranye isezerano n’uwo natoranije,</para>
  <para style="q2" vid="PSA 89:3">narahiye Dawidi umusavyi wanje nti:<verse eid="PSA 89:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4" />‘Nzokomeza uruvyaro rwawe ibihe vyose</para>
  <para style="q2" vid="PSA 89:4">kandi nzokomeza inganji yawe uko urunganwe ruzokuranwa n’urundi.’ ”<verse eid="PSA 89:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5" />
    <char style="nd">Uhoraho</char>, amajuru ahimbaza ibitangaza vyawe,</para>
  <para style="q2" vid="PSA 89:5">n’ukwizigirwa kwawe nakwo, mw’ikoraniro ry’abera.<verse eid="PSA 89:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6" />Kuko none ni nde ari mw’ijuru yogereranywa n’Imana?</para>
  <para style="q2" vid="PSA 89:6">Mu vyo mw’ijuru ni nde ameze nk’<char style="nd">Uhoraho</char>?<verse eid="PSA 89:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7" />Mw’ikoraniro ry’abera Imana irubashwe cane;</para>
  <para style="q2" vid="PSA 89:7">iteye ubwoba kurusha abayikikije bose.<verse eid="PSA 89:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8" />Ni nde ameze nkawe, ewe Mana Mushoboravyose?</para>
  <para style="q2" vid="PSA 89:8">Wewe, <char style="nd">Uhoraho</char>, urakomeye, kandi ubwizigirwa bwawe buragukikuje.<verse eid="PSA 89:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9" />Ni wewe uganza ikiyaga gisuriranya;</para>
  <para style="q2" vid="PSA 89:9">igihe imipfunda yaco yahagurutse, ni wewe uyitururuza.<verse eid="PSA 89:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10" />Ni wewe wasiribanze Rahabu nk’umuvyimba;</para>
  <para style="q2" vid="PSA 89:10">wasanzaje abansi bawe n’ukuboko kwawe gukomeye.<verse eid="PSA 89:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11" />Amajuru ni ayawe, n’isi na yo ni iyawe;</para>
  <para style="q2" vid="PSA 89:11">washizeho isi n’ibiri muri yo vyose.<verse eid="PSA 89:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12" />Waremye uburaruko n’ubumanuko;</para>
  <para style="q2" vid="PSA 89:12">Tabori na Herumoni haririmbishwa n’umunezero kubera izina ryawe.<verse eid="PSA 89:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13" />Ukuboko kwawe kwuzuye inkomezi;</para>
  <para style="q2" vid="PSA 89:13">ikiganza cawe kirakomeye,</para>
  <para style="q2" vid="PSA 89:13">ikiganza cawe c’i buryo gishizwe hejuru.<verse eid="PSA 89:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14" />Ukugororoka n’uguca izibereye ni vyo rufatiro rw’inganji yawe;</para>
  <para style="q2" vid="PSA 89:14">urukundo n’ubwizigirwa bigendera imbere yawe.<verse eid="PSA 89:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15" />Hahiriwe abize kukuvugiriza impundu,</para>
  <para style="q2" vid="PSA 89:15">bagendera mu muco wo mu nyonga hawe, <char style="nd">Uhoraho</char>.<verse eid="PSA 89:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16" />Banezererwa izina ryawe bukarinda bwira;</para>
  <para style="q2" vid="PSA 89:16">bahimbaza ukugororoka kwawe.<verse eid="PSA 89:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17" />Kuko ari wewe cubahiro cabo n’inkomezi zabo,</para>
  <para style="q2" vid="PSA 89:17">kandi ushira hejuru ihembe ryacu ku bwo kugira neza kwawe.<verse eid="PSA 89:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18" />Ni ivy’ukuri, inkinzo yacu iganzwa n’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 89:18">umwami wacu ni uw’Uwera wa Isirayeli.<verse eid="PSA 89:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19" />Umusi umwe waravuze mw’iyerekwa,</para>
  <para style="q2" vid="PSA 89:19">ubwira abantu bawe bo kwizigirwa uti:</para>
  <para style="q1" vid="PSA 89:19">“Natabaye umuhizi mu nkomezi zanje;</para>
  <para style="q2" vid="PSA 89:19">namutoranije mu bantu basanzwe.<verse eid="PSA 89:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20" />Nironkeye umusavyi wanje Dawidi;</para>
  <para style="q2" vid="PSA 89:20">narobanuje amavuta yanje yera.<verse eid="PSA 89:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21" />Ikiganza canje kizomushigikira;</para>
  <para style="q2" vid="PSA 89:21">ni ukuri ukuboko kwanje kuzomukomeza.<verse eid="PSA 89:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22" />Umwansi ntazomutera giturumbuka;</para>
  <para style="q2" vid="PSA 89:22">umunyakibi ntazomuhonyora ku gakanu.<verse eid="PSA 89:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23" />Nzoherengetereza abamugwanya imbere yiwe</para>
  <para style="q2" vid="PSA 89:23">ntsinde hasi abansi biwe.<verse eid="PSA 89:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24" />Urukundo rwanje ruzoguma kuri we,</para>
  <para style="q2" vid="PSA 89:24">kandi ihembe ryiwe rizoshirwa hejuru ku bw’izina ryanje.<verse eid="PSA 89:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25" />Nzoshinga ikiganza ciwe ku kiyaga,</para>
  <para style="q2" vid="PSA 89:25">ukuboko kwiwe kw’i buryo ndagushire hejuru y’inzuzi.<verse eid="PSA 89:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26" />Azonyambaza ati: ‘Uri Data,</para>
  <para style="q2" vid="PSA 89:26">Imana yanje, igitandara Umukiza wanje.’<verse eid="PSA 89:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27" />Kandi nzomutoranya ambere imfura,</para>
  <para style="q2" vid="PSA 89:27">uwushizwe hejuru y’abami bose bo mw’isi.<verse eid="PSA 89:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28" />Urukundo rwanje ruzoguma kuri we ibihe vyose,</para>
  <para style="q2" vid="PSA 89:28">kandi isezerano namusezeraniye ntirizohinduka.<verse eid="PSA 89:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29" />Nzohagarika abo mu ruvyaro rwiwe ibihe vyose,</para>
  <para style="q2" vid="PSA 89:29">intebe yiwe y’ubwami izohangama igihe cose amajuru azoba akiriho.<verse eid="PSA 89:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30" />Abana biwe nibahemukira Ivyagezwe vyanje</para>
  <para style="q2" vid="PSA 89:30">ntibitondere ivyo nabihanikirije,<verse eid="PSA 89:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31" />nibarenga ku vyo nategetse</para>
  <para style="q2" vid="PSA 89:31">bikabananira kwitondera amabwirizwa yanje,<verse eid="PSA 89:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32" />nzohanisha ivyaha vyabo inkoni,</para>
  <para style="q2" vid="PSA 89:32">ukugabitanya kwabo ndaguhanishe kubakubitisha ikimoko;<verse eid="PSA 89:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33" />ariko urukundo rwanje ntiruzomuvako,</para>
  <para style="q2" vid="PSA 89:33">canke ngo mpindure isezerano ryanje.<verse eid="PSA 89:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34" />Sinzoca mw’isezerano ryanje</para>
  <para style="q2" vid="PSA 89:34">canke ngo mpindure ivyo akanwa kanje kavuze.<verse eid="PSA 89:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35" />Narahiye ukwera kwanje rimwe risa;</para>
  <para style="q2" vid="PSA 89:35">kandi sinzobesha Dawidi;<verse eid="PSA 89:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36" />ko hatazobura uwo mu ruvyaro rwiwe aba umwami ibihe vyose</para>
  <para style="q2" vid="PSA 89:36">kandi ingoma yiwe izokwama ihangamye imbere yanje nk’izuba;<verse eid="PSA 89:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37" />izoshingwa ibihe vyose nk’ukwezi,</para>
  <para style="q2" vid="PSA 89:37">icabona co kwizigirwa co kw’ijuru.”<verse eid="PSA 89:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38" />Ariko waramwirukanye umushiburira kure!</para>
  <para style="q2" vid="PSA 89:38">Washavuriye uwo warobanuje amavuta.<verse eid="PSA 89:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39" />Wakuyeho isezerano wagiranye n’umusavyi wawe</para>
  <para style="q2" vid="PSA 89:39">maze utuma igitsibo ciwe kivundagazwa mu mukungugu.<verse eid="PSA 89:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40" />Impome ziwe waziciyemwo ibirengero</para>
  <para style="q2" vid="PSA 89:40">uhindura ibihome bimukingira imisaka.<verse eid="PSA 89:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41" />Abirenganira baramusahuye;</para>
  <para style="q2" vid="PSA 89:41">yabaye ak’amenyo mu babanyi biwe.<verse eid="PSA 89:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42" />Washize hejuru ukuboko kw’i buryo kw’abamugwanya;</para>
  <para style="q2" vid="PSA 89:42">watumye abansi biwe banezerwa.<verse eid="PSA 89:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43" />Ni ivy’ukuri, wasubije inyuma inkota yiwe</para>
  <para style="q2" vid="PSA 89:43">ntiwamushigikira mu ntambara.<verse eid="PSA 89:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44" />Washize kw’iherezo ubwiza bwiwe</para>
  <para style="q2" vid="PSA 89:44">uvunagurira hasi intebe yiwe y’ubwami.<verse eid="PSA 89:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45" />Wagabanije imyaka y’ubuto bwiwe;</para>
  <para style="q2" vid="PSA 89:45">umuteterereza mu maso ya bose.<verse eid="PSA 89:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46" />Uzogeza ryari, <char style="nd">Uhoraho</char>? Uzokwama winyegeje ibihe vyose?</para>
  <para style="q2" vid="PSA 89:46">Uburake bwawe buzogeza ryari kwaka nk’umuriro?<verse eid="PSA 89:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47" />Ibuka ingene ubugingo bwanje bukenyuka.</para>
  <para style="q2" vid="PSA 89:47">Kuko waremeye abana b’abantu gupfa gusa.<verse eid="PSA 89:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48" />Ni nde azobaho ntabone urupfu,</para>
  <para style="q2" vid="PSA 89:48">canke ni nde azokira ntaje mu mva?<verse eid="PSA 89:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49" />Urukundo rwawe rwa kera ruhebuje ruri he, ewe Mana,</para>
  <para style="q2" vid="PSA 89:49">urwo warahiye Dawidi mu bwizigirwa bwawe?<verse eid="PSA 89:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50" />Niwibuke, ewe Mana, uko umusavyi wawe yacokowe,</para>
  <para style="q2" vid="PSA 89:50">uko umutima wanje wuzuye ibitutsi vy’amahanga yose,<verse eid="PSA 89:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51" />ibitutsi abansi bawe, <char style="nd">Uhoraho</char> bantutse,</para>
  <para style="q2" vid="PSA 89:51">ivyo bacokoye uwo warobanuje amavuta mu ntambuko ziwe zose.<verse eid="PSA 89:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52" />
    <char style="nd">Uhoraho</char> ahimbazwe ibihe bidashira!</para>
  <para style="qc" vid="PSA 89:52">Amen kandi Amen!<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">Igitabu ca kane</para>
  <para style="mr">
    <ref loc="PSA 90-106">Zaburi 90–106</ref></para>
  <para style="cl">Zaburi ya 90</para>
  <para style="d">Ni isengesho rya Mose umuntu w’Imana.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1" />Uhoraho, watubereye aho kuba</para>
  <para style="q2" vid="PSA 90:1">uko urunganwe rwakurikiranye n’urundi.<verse eid="PSA 90:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2" />Imisozi itaravuka</para>
  <para style="q2" vid="PSA 90:2">canke ngo wibaruke isi yose,</para>
  <para style="q2" vid="PSA 90:2">uhereye kera hose ukageza ibihe bidashira uri Imana.<verse eid="PSA 90:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3" />Usubiza abantu mu mukungugu,</para>
  <para style="q2" vid="PSA 90:3">ukavuga uti: “Subire mu mukungugu, mwa bantu buntu.”<verse eid="PSA 90:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4" />Imyaka igihumbi imbere yawe</para>
  <para style="q2" vid="PSA 90:4">ni nk’umusi warenganye gusa,</para>
  <para style="q2" vid="PSA 90:4">canke igice kimwe c’ijoro.<verse eid="PSA 90:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5" />Ariko utwara abantu bakamera nk’inzozi;</para>
  <para style="q2" vid="PSA 90:5">bakamera nk’ivyatsi bimera mu gitondo:<verse eid="PSA 90:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6" />Mu gitondo biramera bigatotahara;</para>
  <para style="q2" vid="PSA 90:6">ariko ku mugoroba biruma bigakabirana.<verse eid="PSA 90:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7" />Turanduwe n’uburake bwawe</para>
  <para style="q2" vid="PSA 90:7">dutewe ubwoba n’ubushangashirwe bwawe.<verse eid="PSA 90:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8" />Washize ibigabitanyo vyacu imbere yawe,</para>
  <para style="q2" vid="PSA 90:8">ivyaha vyacu vyo mu mpisho ubishira imbere y’inyonga zawe.<verse eid="PSA 90:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9" />Imisi yacu yose tuyimara turi mu burake bwawe;</para>
  <para style="q2" vid="PSA 90:9">turangiza imyaka yacu turi mu kuniha.<verse eid="PSA 90:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10" />Imisi yacu ishobora kungana n’imyaka mirongo indwi,</para>
  <para style="q2" vid="PSA 90:10">canke mirongo umunani, ku banyenkomezi</para>
  <para style="q1" vid="PSA 90:10">ariko ivyiza vyo muri yo</para>
  <para style="q2" vid="PSA 90:10">n’ivyago n’umubabaro gusa.<verse eid="PSA 90:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11" />Ese iyo tumenya ubushobozi bw’uburake bwawe!</para>
  <para style="q2" vid="PSA 90:11">Uburake bwawe bungana n’ukwubahwa kugukwiye.<verse eid="PSA 90:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12" />Utwigishe guharura imisi yacu,</para>
  <para style="q2" vid="PSA 90:12">kugira ngo turonke imitima y’ubwenge.<verse eid="PSA 90:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13" />Niwigarure, <char style="nd">Uhoraho</char>! Bizogeza ryari?</para>
  <para style="q2" vid="PSA 90:13">Girira ikigongwe abasavyi bawe.<verse eid="PSA 90:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14" />Mu gitondo uze uduhaze urukundo rwawe rudashira,</para>
  <para style="q2" vid="PSA 90:14">kugira ngo tuvuze impundu kandi tunezererwe imisi yacu yose.<verse eid="PSA 90:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15" />Utunezereze imisi ingana n’iyo watubabaje,</para>
  <para style="q2" vid="PSA 90:15">imyaka ingana iyo twaboneyemwo ivyago.<verse eid="PSA 90:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16" />Niwereke ibikorwa vyawe abasavyi bawe,</para>
  <para style="q2" vid="PSA 90:16">hamwe n’ubwiza bwawe abana babo.<verse eid="PSA 90:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17" />Ukugira neza kw’Uhoraho Imana yacu kube kuri twebwe</para>
  <para style="q2" vid="PSA 90:17">ukomeze igikorwa c’intoke zacu;</para>
  <para style="q2" vid="PSA 90:17">egome, komeza igikorwa c’intoke zacu.<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="cl">Zaburi ya 91</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1" />Uwuba mu bwugamo bw’Iyisumbavyose</para>
  <para style="q2" vid="PSA 91:1">azokwama ari mu gitutu c’Iyishoboravyose.<verse eid="PSA 91:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2" />Nzobwira <char style="nd">Uhoraho</char> nti: “Uri ubuhungiro bwanje n’igihome kinkingira,</para>
  <para style="q2" vid="PSA 91:2">uri Imana yanje nizigira.”<verse eid="PSA 91:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3" />Ni ukuri azogukiza</para>
  <para style="q2" vid="PSA 91:3">umutego w’umutezi</para>
  <para style="q2" vid="PSA 91:3">n’ikiza gihonya.<verse eid="PSA 91:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4" />Azokubundikiriza amoya yiwe,</para>
  <para style="q2" vid="PSA 91:4">kandi uzohungira musi y’amababa yiwe;</para>
  <para style="q2" vid="PSA 91:4">ubwizigirwa bwiwe ni bwo buzokubera inkinzo n’icuma gikingira igikiriza.<verse eid="PSA 91:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5" />Ntuzotinya ibiteye ubwoba mw’ijoro,</para>
  <para style="q2" vid="PSA 91:5">canke umwampi urashwe ku murango,<verse eid="PSA 91:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6" />canke ikiza gitera mu mwijima,</para>
  <para style="q2" vid="PSA 91:6">canke icago gihonya mu mashoka.<verse eid="PSA 91:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7" />Abantu igihumbi bazogwa i ruhande yawe,</para>
  <para style="q2" vid="PSA 91:7">ibihumbi cumi i buryo bwawe,</para>
  <para style="q2" vid="PSA 91:7">ariko ntibizokwegera.<verse eid="PSA 91:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8" />Ariko uzobibonesha amaso yawe</para>
  <para style="q2" vid="PSA 91:8">kandi uzokwibonera uguhanwa kw’abanyakibi.<verse eid="PSA 91:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9" />Niwavuga uti: “<char style="nd">Uhoraho</char> ni we buhungiro bwanje,”</para>
  <para style="q2" vid="PSA 91:9">Iyisumbavyose ukayigira ahantu hawe ho kuba,<verse eid="PSA 91:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10" />nta kibi kizogukorako,</para>
  <para style="q2" vid="PSA 91:10">nta cago kizokwegera ihema ryawe.<verse eid="PSA 91:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11" />Kuko azotegeka abamarayika biwe</para>
  <para style="q2" vid="PSA 91:11">ngo bakuzigame mu nzira zawe zose;<verse eid="PSA 91:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12" />bazokurerura mu maboko yabo,</para>
  <para style="q2" vid="PSA 91:12">kugira ngo ntutsitare kw’ibuye.<verse eid="PSA 91:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13" />Uzokandagira intambwe n’imvuvyi;</para>
  <para style="q2" vid="PSA 91:13">uzosiribanga intare ikomeye n’ikiyoka.<verse eid="PSA 91:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14" />“Kuko yankunze,” ni ko <char style="nd">Uhoraho</char> avuze, “nzomukiza,</para>
  <para style="q2" vid="PSA 91:14">nzomukingira, kuko yamenye zina ryanje.<verse eid="PSA 91:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15" />Niyanyambaza, nanje nzomwishura;</para>
  <para style="q2" vid="PSA 91:15">nzobana na we mu magorwa,</para>
  <para style="q2" vid="PSA 91:15">nzomukiza ndamuhe icubahiro.<verse eid="PSA 91:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16" />Nzomuhaza kuramba,</para>
  <para style="q2" vid="PSA 91:16">ndamwereke agakiza kanje.”<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="cl">Zaburi ya 92</para>
  <para style="d">Ni Zaburi, kandi ni indirimbo iririmbwa kw’Isabato.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1" />Ni vyiza guhimbaza <char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 92:1">no gucurarangira izina ryawe, ewe Iyisumbavyose,<verse eid="PSA 92:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2" />kwamamaza urukundo rwawe mu gitondo</para>
  <para style="q2" vid="PSA 92:2">n’ubwizigirwa bwawe mw’ijoro,<verse eid="PSA 92:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3" />hakoreshejwe inanga y’imirya cumi</para>
  <para style="q2" vid="PSA 92:3">n’ijwi ry’ikembe.<verse eid="PSA 92:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4" />Kuko ibikorwa vyawe biranezereza, ewe <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 92:4">ndirimbishwa n’umunezero kubera ibikorwa vy’inkoke zawe.<verse eid="PSA 92:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5" />Mbega ukuntu ibikorwa vyawe ari ibihambaye, <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 92:5">n’ivyo wiyumvira bishika i bwina!<verse eid="PSA 92:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6" />Abatagira ubwenge nta co bamenya,</para>
  <para style="q2" vid="PSA 92:6">ibipfu ata co bitahura.<verse eid="PSA 92:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7" />Naho abanyakibi bakura nk’ivyatsi,</para>
  <para style="q2" vid="PSA 92:7">inkozi z’ibibi zigatotahara,</para>
  <para style="q2" vid="PSA 92:7">bazorandurwa ibihe vyose.<verse eid="PSA 92:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8" />Ariko weho, <char style="nd">Uhoraho</char>, ushizwe hejuru ibihe bidashira.<verse eid="PSA 92:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9" />Nta nkeka, abansi bawe, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 92:9">ni ukuri abansi bawe bazohona;</para>
  <para style="q2" vid="PSA 92:9">inkozi z’ibibi zose zizosanzazwa.<verse eid="PSA 92:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10" />Wampaye inkomezi nk’iz’imbogo;</para>
  <para style="q2" vid="PSA 92:10">unsukako amavuta meza y’umunezero.<verse eid="PSA 92:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11" />Amaso yanje yiboneye ukuneshwa kw’abangwanya;</para>
  <para style="q2" vid="PSA 92:11">amatwi yanje yiyumvira uguhunga kw’abanyanka.<verse eid="PSA 92:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12" />Umugororotsi azototahara nk’ikigazi,</para>
  <para style="q2" vid="PSA 92:12">akure asagarare nk’isederi ry’i Libani.<verse eid="PSA 92:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13" />Atewe mu nzu y’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 92:13">azototaharira mu birimba vy’Imana yacu.<verse eid="PSA 92:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14" />No mu busaza bwiwe azoba acama ivyamwa,</para>
  <para style="q2" vid="PSA 92:14">azokwamana ubuto n’itoto,<verse eid="PSA 92:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15" />yamamaze avuga ati: “<char style="nd">Uhoraho</char> aratunganye;</para>
  <para style="q2" vid="PSA 92:15">ni we Gitandara canje, kandi nta bubi buri muri we!”<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="cl">Zaburi ya 93</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1" />
    <char style="nd">Uhoraho</char> araganje, yisakaye ubwiza;</para>
  <para style="q2" vid="PSA 93:1">
    <char style="nd">Uhoraho</char> yisakaje ubwiza kandi yambaye inkomezi;</para>
  <para style="q2" vid="PSA 93:1">ni ukuri, isi irakomeye, irahamye kandi irahangamye.<verse eid="PSA 93:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2" />Intebe yawe y’Ubwami yabayeho kuva kera;</para>
  <para style="q2" vid="PSA 93:2">wamyeho ibihe vyose.<verse eid="PSA 93:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3" />Ibiyaga birasuriranye, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 93:3">ibiyaga birabomboranye;</para>
  <para style="q2" vid="PSA 93:3">ibiyaga bivyuye imipfunda yavyo.<verse eid="PSA 93:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4" />Ariko wewe urakomeye kurusha ukubomborana kw’amazi yo mw’ibenga,</para>
  <para style="q2" vid="PSA 93:4">urakomeye kurusha imipfunda y’ikiyaga;</para>
  <para style="q2" vid="PSA 93:4">
    <char style="nd">Uhoraho</char> ashizwe hejuru arahambaye.<verse eid="PSA 93:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5" />Ivyo washinze, ewe <char style="nd">Uhoraho</char>, birahamye;</para>
  <para style="q2" vid="PSA 93:5">ukwera ni kwo gusharije inzu yawe</para>
  <para style="q2" vid="PSA 93:5">ibihe bitazoshira.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="cl">Zaburi ya 94</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1" />
    <char style="nd">Uhoraho</char> ni Imana ihana.</para>
  <para style="q2" vid="PSA 94:1">Yewe Mana ihana, seruka ukayangane.<verse eid="PSA 94:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2" />Haguruka, ucire isi amateka;</para>
  <para style="q2" vid="PSA 94:2">subiriza mu nkoko abibone ibikwiranye na bo.<verse eid="PSA 94:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3" />
    <char style="nd">Uhoraho</char> we, abanyakibi bazogeza ryari,</para>
  <para style="q2" vid="PSA 94:3">bazogeza ryari kwirata?<verse eid="PSA 94:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4" />Bavuga amajambo y’ubwibone;</para>
  <para style="q2" vid="PSA 94:4">inkozi z’ibibi zose zuzuye ukwirata.<verse eid="PSA 94:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5" />Bacinyiza abantu bawe, <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 94:5">bagatoteza ishamvu yawe.<verse eid="PSA 94:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6" />Bica umupfakazi n’inyambukira;</para>
  <para style="q2" vid="PSA 94:6">bagandagura impfuvyi.<verse eid="PSA 94:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7" />Bakavuga bati: “<char style="nd">Uhoraho</char> ntabibona;</para>
  <para style="q2" vid="PSA 94:7">Imana ya Yakobo nta co yitaho.”<verse eid="PSA 94:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8" />Nimumenye ibi, yemwe bantu b’ibipfu;</para>
  <para style="q2" vid="PSA 94:8">yemwe bijuju, muzoca ubwenge ryari?<verse eid="PSA 94:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9" />Uwaremye ugutwi ntashobora kwumva?</para>
  <para style="q2" vid="PSA 94:9">Uwaremye ijisho mbega ntabona?<verse eid="PSA 94:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10" />Mbega uwutoza indero amahanga ntashobora guhana?</para>
  <para style="q2" vid="PSA 94:10">Uwigisha abana b’abantu mbega nta bwenge azi?<verse eid="PSA 94:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11" />
    <char style="nd">Uhoraho</char> arazi ivyiyumviro vy’abana b’abantu;</para>
  <para style="q2" vid="PSA 94:11">arazi ko ari ubusa gusa.<verse eid="PSA 94:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12" />Hahiriwe umuntu utoza indero, <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 94:12">uwo wigisha Ivyagezwe vyawe.<verse eid="PSA 94:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13" />Ubaha ugutekanirwa mu misi y’ivyago,</para>
  <para style="q2" vid="PSA 94:13">kugeza aho icobo kizokwimbirwa abanyakibi.<verse eid="PSA 94:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14" />Kuko <char style="nd">Uhoraho</char> atazota abantu biwe;</para>
  <para style="q2" vid="PSA 94:14">ntazokwigera ahemukira inyegu yiwe.<verse eid="PSA 94:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15" />Uguca imanza kuzosubira kwisunga ubugororotsi,</para>
  <para style="q2" vid="PSA 94:15">kandi abatuganye mu mitima bazogukurikira.<verse eid="PSA 94:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16" />Ni nde azova hasi ngo angwanire kubera umunyakibi anteye?</para>
  <para style="q2" vid="PSA 94:16">Ni nde azomburanira agahangana n’inkozi z’ibibi?<verse eid="PSA 94:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17" />
    <char style="nd">Uhoraho</char> iyo atantabara,</para>
  <para style="q2" vid="PSA 94:17">mba naragiye ahantu h’agacerere k’urupfu.<verse eid="PSA 94:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18" />Aho navuga nti: “Ikirenge canje kiriko kiranyerera,”</para>
  <para style="q2" vid="PSA 94:18">urukundo rwawe rudashira, <char style="nd">Uhoraho</char>, rwaranshigikiye.<verse eid="PSA 94:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19" />Aho nari nuzuye umubabaro,</para>
  <para style="q2" vid="PSA 94:19">uguhumurizwa kwawe kwanzaniye umunezero.<verse eid="PSA 94:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20" />Mbega ingoma yononekaye yokwifatanya nawe;</para>
  <para style="q2" vid="PSA 94:20">ingoma izana amagorwa kubera ivyo itegeka?<verse eid="PSA 94:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21" />Abanyakibi baja inama yo kugirira nabi umugororotsi</para>
  <para style="q2" vid="PSA 94:21">bagacira uwutagira icaha urwo gupfa.<verse eid="PSA 94:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22" />Ariko <char style="nd">Uhoraho</char> yambereye igihome kinkingira,</para>
  <para style="q2" vid="PSA 94:22">Imana yanje yambereye igitandara nihishamwo.<verse eid="PSA 94:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23" />Izobasubiriza mu nkoko ivyaha bakoze</para>
  <para style="q2" vid="PSA 94:23">izobahonya kubera ibibi bakoze;</para>
  <para style="q2" vid="PSA 94:23">
    <char style="nd">Uhoraho</char> Imana yanje izobahonya.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="cl">Zaburi ya 95</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1" />Nimuze turirimbire <char style="nd">Uhoraho</char> tunezerewe;</para>
  <para style="q2" vid="PSA 95:1">tuvugirize impundu Igitandara c’agakiza kacu.<verse eid="PSA 95:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2" />Tuze mu nyonga hiwe tumushima</para>
  <para style="q2" vid="PSA 95:2">tumuririmbire tuvugira ibicurarangisho.<verse eid="PSA 95:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3" />Kuko <char style="nd">Uhoraho</char> ari Imana ihambaye,</para>
  <para style="q2" vid="PSA 95:3">ni Umwami ahambaye asumba ibigirwamana vyose.<verse eid="PSA 95:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4" />I bwina h’isi hari mu kuboko kwiwe,</para>
  <para style="q2" vid="PSA 95:4">n’udutwe tw’imisozi ni utwiwe.<verse eid="PSA 95:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5" />Ikiyaga ni iciwe, kuko ni we yakiremye,</para>
  <para style="q2" vid="PSA 95:5">ibiganza vyiwe ni vyo vyabumye i musozi.<verse eid="PSA 95:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6" />Nimuze, tumwunamire tumusenge,</para>
  <para style="q2" vid="PSA 95:6">dupfukame imbere y’<char style="nd">Uhoraho</char> Umuremyi wacu;<verse eid="PSA 95:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7" />kuko ari we Mana yacu</para>
  <para style="q2" vid="PSA 95:7">natwe turi abantu yiragiriye,</para>
  <para style="q2" vid="PSA 95:7">umukuku yitayeho.</para>
  <para style="b" vid="PSA 95:7" />
  <para style="q1" vid="PSA 95:7">Uwu musi icompa mukumva ijwi ryiwe rivuga riti:<verse eid="PSA 95:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8" />“Ntimukomantaze imitima yanyu nk’uko mwayikomantarije i Meriba,</para>
  <para style="q2" vid="PSA 95:8">nk’uko mwabigize kuri urya musi i Masa mu bugaragwa,<verse eid="PSA 95:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9" />aho ba sogokuruza banyu bangerageza</para>
  <para style="q2" vid="PSA 95:9">bakancaca, naho bari barabonye ivyo nakoze.<verse eid="PSA 95:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10" />Nashavuriye urwo runganwe imyaka mirongo ine;</para>
  <para style="q2" vid="PSA 95:10">ndavuga nti: ‘Ni abantu bama bazimira mu mitima,</para>
  <para style="q2" vid="PSA 95:10">kandi ntibamenye inzira zanje.’<verse eid="PSA 95:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11" />Ni co catumye ndahirana uburake nti:</para>
  <para style="q2" vid="PSA 95:11">‘Ntibazokwigera binjira aho kuruhukira nari narabateguriye.’ ”<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="cl">Zaburi ya 96</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1" />Nimuririmbire <char style="nd">Uhoraho</char> indirimbo nshasha;</para>
  <para style="q2" vid="PSA 96:1">yemwe abari mw’isi mwese, muririmbire <char style="nd">Uhoraho</char>.<verse eid="PSA 96:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2" />Muririmbire <char style="nd">Uhoraho</char> muhimbaze izina ryiwe,</para>
  <para style="q2" vid="PSA 96:2">mwamamaze agakiza kiwe uko bukeye.<verse eid="PSA 96:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3" />Muvuge ivy’icubahiro ciwe mu mahanga yose,</para>
  <para style="q2" vid="PSA 96:3">n’ibitangaza yakoze mu moko yose.<verse eid="PSA 96:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4" />Kuko <char style="nd">Uhoraho</char> ahambaye kandi abereye gushimwa;</para>
  <para style="q2" vid="PSA 96:4">akwiye kwubahwa kuruta ibigirwamana vyose.<verse eid="PSA 96:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5" />Kuko imana zose z’amahanga ari ibigirwamana,</para>
  <para style="q2" vid="PSA 96:5">ariko <char style="nd">Uhoraho</char> yaremye amajuru.<verse eid="PSA 96:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6" />Ubwiza n’icubahiro biri imbere yiwe;</para>
  <para style="q2" vid="PSA 96:6">inkomezi n’igikundiro biri mu ngoro yiwe.<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7" />Nimwemere <char style="nd">Uhoraho</char>, yemwe miryango yose yo mu mahanga,</para>
  <para style="q2" vid="PSA 96:7">mwemere ko <char style="nd">Uhoraho</char> afise icubahiro n’inkomezi.<verse eid="PSA 96:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8" />Nimuhe <char style="nd">Uhoraho</char> icubahiro kibereye izina ryiwe;</para>
  <para style="q2" vid="PSA 96:8">muzane ishikanwa mushike mu birimba vyiwe.<verse eid="PSA 96:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9" />Musenge <char style="nd">Uhoraho</char> muri mu bwiza bw’ukwera kwiwe;</para>
  <para style="q2" vid="PSA 96:9">yemwe abari mw’isi mwese, muhindire agashitsi imbere yiwe.<verse eid="PSA 96:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10" />Mwamamaze mu mahanga muti: “<char style="nd">Uhoraho</char> araganje.”</para>
  <para style="q2" vid="PSA 96:10">Isi irashimangiye, ntishobora kunyiganyizwa;</para>
  <para style="q2" vid="PSA 96:10">azocira amahanga imanza zibereye.<verse eid="PSA 96:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11" />Ijuru nirinezerwe, isi nihimbarwe;</para>
  <para style="q2" vid="PSA 96:11">ikiyaga nikibomborane, n’ibiri muri co vyose.<verse eid="PSA 96:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12" />Imisozi yose ninezerwe, n’ibiri muri yo vyose;</para>
  <para style="q2" vid="PSA 96:12">ibiti vyose vyo mw’ishamba nibiririmbishwe n’umunezero.<verse eid="PSA 96:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13" />Ivyaremwe vyose nibinezererwe imbere y’<char style="nd">Uhoraho</char>, kuko aje,</para>
  <para style="q2" vid="PSA 96:13">aje gucira isi urubanza.</para>
  <para style="q1" vid="PSA 96:13">Azocira abari mw’isi imanza mu bugororotsi</para>
  <para style="q2" vid="PSA 96:13">N’amahanga azoyacira imanza mu kuri kwiwe.<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="cl">Zaburi ya 97</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1" />
    <char style="nd">Uhoraho</char> araganje, isi nihimbarwe;</para>
  <para style="q2" vid="PSA 97:1">ibizinga vya kure nibihimbarwe.<verse eid="PSA 97:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2" />Ibicu n’umwijima w’umuzitanya biramukikije;</para>
  <para style="q2" vid="PSA 97:2">ubugororotsi n’uguca imanza zibereye ni vyo tanguriro ry’ingoma yiwe.<verse eid="PSA 97:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3" />Umuriro ugendera imbere yiwe</para>
  <para style="q2" vid="PSA 97:3">maze ugatongora abansi biwe impande zose.<verse eid="PSA 97:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4" />Umuravyo wiwe umurikira isi;</para>
  <para style="q2" vid="PSA 97:4">isi irabibona maze igahinda agashitsi.<verse eid="PSA 97:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5" />Imisozi ishonga nk’ishashara imbere y’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 97:5">imbere y’umwami w’isi yose.<verse eid="PSA 97:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6" />Amajuru yamamaza ukugororoka kwiwe,</para>
  <para style="q2" vid="PSA 97:6">kandi amoko yose arabona ubwiza bwiwe.<verse eid="PSA 97:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7" />Abasenga ibishushayo bazomaramara,</para>
  <para style="q2" vid="PSA 97:7">abishimira ibigirwamana;</para>
  <para style="q2" vid="PSA 97:7">nimumwunamire, yemwe bigirwamana mwese!<verse eid="PSA 97:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8" />Siyoni haravyumva maze hakanezerwa</para>
  <para style="q2" vid="PSA 97:8">n’imihana y’i Buyuda igahimbarwa</para>
  <para style="q2" vid="PSA 97:8">kubera guca amateka kwawe.<verse eid="PSA 97:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9" />Kuko wewe, <char style="nd">Uhoraho</char>, uri Iyisumbavyose kw’isi yose;</para>
  <para style="q2" vid="PSA 97:9">ushizwe hejuru cane kuruta ibigirwamana vyose.<verse eid="PSA 97:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10" />Abakunda <char style="nd">Uhoraho</char> nibanke ibibi,</para>
  <para style="q2" vid="PSA 97:10">kuko azigama ubugingo bw’abantu biwe</para>
  <para style="q2" vid="PSA 97:10">akabakiza akabakura mu maboko y’abanyakibi.<verse eid="PSA 97:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11" />Umuco ukayanganira umugororotsi</para>
  <para style="q2" vid="PSA 97:11">n’umunezero ugakayanganira uwutunganye mu mutima.<verse eid="PSA 97:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12" />Nimunezererwe <char style="nd">Uhoraho</char>, yemwe bagororotsi,</para>
  <para style="q2" vid="PSA 97:12">muhimbaze izina ryiwe ryera.<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="cl">Zaburi ya 98</para>
  <para style="d">Ni Zaburi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1" />Nimuririmbire <char style="nd">Uhoraho</char> indirimbo nsha,</para>
  <para style="q2" vid="PSA 98:1">kuko yakoze ibintu bitangaje;</para>
  <para style="q1" vid="PSA 98:1">kuko yazanishije agakiza</para>
  <para style="q2" vid="PSA 98:1">ikiganza ciwe c’i buryo n’ukuboko kwiwe kwera.<verse eid="PSA 98:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2" />
    <char style="nd">Uhoraho</char> yamenyekanishije agakiza kiwe</para>
  <para style="q2" vid="PSA 98:2">kandi yahishuye ukugororoka kwiwe mu mahanga.<verse eid="PSA 98:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3" />Yibutse urukundo rwiwe</para>
  <para style="q2" vid="PSA 98:3">n’ukwizigirwa kwiwe kuri Isirayeli;</para>
  <para style="q1" vid="PSA 98:3">abo ku mpera z’isi bose babonye</para>
  <para style="q2" vid="PSA 98:3">agakiza k’Imana yacu.<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4" />Nimuvugirize impundu <char style="nd">Uhoraho</char>, yemwe abari mw’isi mwese,</para>
  <para style="q2" vid="PSA 98:4">muturikishe muririmbe mucuraranga;<verse eid="PSA 98:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5" />Mucurarangire <char style="nd">Uhoraho</char> ikembe,</para>
  <para style="q2" vid="PSA 98:5">mwumvikanishe indirimbo mucuraranga ikembe,<verse eid="PSA 98:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6" />Muvuze inzamba n’ihembe ry’intama;</para>
  <para style="q2" vid="PSA 98:6">muvugirize impundu mu nyonga z’<char style="nd">Uhoraho</char>, Umwami.<verse eid="PSA 98:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7" />Ikiyaga nicumvikanishe ijwi, n’ibiri muri co vyose,</para>
  <para style="q2" vid="PSA 98:7">isi, n’abayibako bose.<verse eid="PSA 98:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8" />Inzuzi nizikome amashi,</para>
  <para style="q2" vid="PSA 98:8">imisozi yose iririmbane umunezero;<verse eid="PSA 98:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9" />Vyose nibiririmbire mu nyonga z’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 98:9">kuko aje gucira imanza isi.</para>
  <para style="q1" vid="PSA 98:9">Azocira imanza isi mu bugororotsi</para>
  <para style="q2" vid="PSA 98:9">n’amoko yose azoyacira izibereye.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="cl">Zaburi ya 99</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1" />
    <char style="nd">Uhoraho</char> araganje,</para>
  <para style="q2" vid="PSA 99:1">amahanga yose nahinde agashitsi;</para>
  <para style="q1" vid="PSA 99:1">avyagiye hagati y’abakerubi,</para>
  <para style="q2" vid="PSA 99:1">isi nihinde agashitsi.<verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />
    <char style="nd">Uhoraho</char> arahambaye ari i Siyoni;</para>
  <para style="q2" vid="PSA 99:2">ashizwe hejuru y’amahanga yose.<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />Nibahimbaze izina ryawe rihambaye kandi riteye ubwoba;</para>
  <para style="q2" vid="PSA 99:3">uri uwera.<verse eid="PSA 99:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4" />Umwami ni umunyenkomezi, akunda imanza zibereye;</para>
  <para style="q2" vid="PSA 99:4">washinze ubutungane;</para>
  <para style="q1" vid="PSA 99:4">mu ba Yakobo wakoze</para>
  <para style="q2" vid="PSA 99:4">ibigororotse kandi bitunganye.<verse eid="PSA 99:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5" />Nimushire hejuru <char style="nd">Uhoraho</char> Imana yacu</para>
  <para style="q2" vid="PSA 99:5">mumwunamire ku ndava y’ibirenge vyiwe;</para>
  <para style="q2" vid="PSA 99:5">ni uwera.<verse eid="PSA 99:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6" />Mose na Aroni bari mu baherezi biwe,</para>
  <para style="q2" vid="PSA 99:6">Samweli yari mu bambaza izina ryiwe;</para>
  <para style="q1" vid="PSA 99:6">bambaje izina ry’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 99:6">na we arabishura.<verse eid="PSA 99:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7" />Yavuganye na bo ari mu nkingi y’igicu;</para>
  <para style="q2" vid="PSA 99:7">bitondeye ivyo yihanikirije n’amategeko yiwe yabashingiye.<verse eid="PSA 99:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8" />
    <char style="nd">Uhoraho</char> Mana yacu,</para>
  <para style="q2" vid="PSA 99:8">warabishuye;</para>
  <para style="q1" vid="PSA 99:8">ku Bisirayeli wabaye Imana iharira ivyaha,</para>
  <para style="q2" vid="PSA 99:8">naho wabahaniye ibibi bakoze.<verse eid="PSA 99:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9" />Nimushire hejuru Imana yacu</para>
  <para style="q2" vid="PSA 99:9">musengere ku musozi wiwe wera,</para>
  <para style="q2" vid="PSA 99:9">kuko <char style="nd">Uhoraho</char> Imana yacu ari uwera.<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="cl">Zaburi ya 100</para>
  <para style="d">Ni Zaburi. Ni iyo guhimbaza no gushima.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />Nimuvugirize impundu <char style="nd">Uhoraho</char>, yemwe abari mw’isi mwese.<verse eid="PSA 100:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 100:2" />Musenge <char style="nd">Uhoraho</char> munezerewe;</para>
  <para style="q2" vid="PSA 100:2">muze imbere yiwe muririmbana umunezero.<verse eid="PSA 100:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />Mumenye ko <char style="nd">Uhoraho</char> ari we Mana.</para>
  <para style="q2" vid="PSA 100:3">Ni we yaturemye, natwe turi abiwe,</para>
  <para style="q2" vid="PSA 100:3">turi abantu biwe, intama zo mu buragiro bwiwe.<verse eid="PSA 100:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />Mwinjire mu marembo y’Ingoro yiwe mushima,</para>
  <para style="q2" vid="PSA 100:4">mu birimba vyiwe muhimbaza;</para>
  <para style="q2" vid="PSA 100:4">mumushime kandi muhimbaze izina ryiwe.<verse eid="PSA 100:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />Kuko <char style="nd">Uhoraho</char> ari mwiza kandi urukundo rwiwe rwamaho ibihe bidashira;</para>
  <para style="q2" vid="PSA 100:5">ukwizigirwa kwiwe kuzokwamaho uko urunganwe ruzokuranwa n’urundi.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="cl">Zaburi ya 101</para>
  <para style="d">Ni iya Dawidi. Ni Zaburi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1" />Nzoririmba ivy’urukundo rwawe n’uguca imanza zibereye;</para>
  <para style="q2" vid="PSA 101:1">
    <char style="nd">Uhoraho</char>, nzokuririmbira ishimwe.<verse eid="PSA 101:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2" />Nzokwitondera kugenda ntunganye;</para>
  <para style="q2" vid="PSA 101:2">mbega uzoza iwanje ryari?</para>
  <para style="b" vid="PSA 101:2" />
  <para style="q1" vid="PSA 101:2">Nzotunganya ivyo mu rugo rwanje</para>
  <para style="q2" vid="PSA 101:2">mfise umutima utunganye.<verse eid="PSA 101:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3" />Sinzokwigera nshima</para>
  <para style="q2" vid="PSA 101:3">ikintu na kimwe kibi.</para>
  <para style="b" vid="PSA 101:3" />
  <para style="q1" vid="PSA 101:3">Nanka ivyo abatizera bakora;</para>
  <para style="q2" vid="PSA 101:3">sinzokwigera nifatanya na vyo.<verse eid="PSA 101:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4" />Abanduye mu mitima bazoba kure yanje;</para>
  <para style="q2" vid="PSA 101:4">sinzokwifatanya n’ikintu na kimwe kibi.<verse eid="PSA 101:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5" />Uwuvuga nabi mugenziwe wese mu mpisho,</para>
  <para style="q2" vid="PSA 101:5">nzomuzibiza;</para>
  <para style="q1" vid="PSA 101:5">uwufise amaso y’ubwibone n’umutima wishira hejuru,</para>
  <para style="q2" vid="PSA 101:5">sinzomwihanganira.<verse eid="PSA 101:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6" />Amaso yanje azoba ku bizigirwa bo mu gihugu,</para>
  <para style="q2" vid="PSA 101:6">kugira ngo babane nanje;</para>
  <para style="q1" vid="PSA 101:6">uwugenda atunganye</para>
  <para style="q2" vid="PSA 101:6">ni we azonkorera.<verse eid="PSA 101:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7" />Nta n’umwe mu bakora ivy’ubugunge</para>
  <para style="q2" vid="PSA 101:7">azoba mu nzu yanje;</para>
  <para style="q1" vid="PSA 101:7">nta n’umwe avuga ibinyoma</para>
  <para style="q2" vid="PSA 101:7">azohagarara imbere yanje.<verse eid="PSA 101:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8" />Uko bukeye nzokwama nziba akanwa</para>
  <para style="q2" vid="PSA 101:8">k’abanyakibi bose bo mu gihugu;</para>
  <para style="q1" vid="PSA 101:8">nzoherengeteza abakora ibibi bose</para>
  <para style="q2" vid="PSA 101:8">bave mu gisagara c’<char style="nd">Uhoraho</char>.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="cl">Zaburi ya 102</para>
  <para style="d">Ni isengesho ry’umunyamibabaro acitse intege maze agasuka intimba ziwe imbere y’<char style="nd">Uhoraho</char>.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1" />
    <char style="nd">Uhoraho</char>, niwumve ugusenga kwanje;</para>
  <para style="q2" vid="PSA 102:1">ugutakamba kwanje nikugushikeko.<verse eid="PSA 102:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2" />Ntumpishe mu nyonga hawe</para>
  <para style="q2" vid="PSA 102:2">mu gihe ndi mu magorwa.</para>
  <para style="q1" vid="PSA 102:2">Ntega ugutwi;</para>
  <para style="q2" vid="PSA 102:2">ninagutakambira, unyishure vuba.<verse eid="PSA 102:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3" />Kuko imisi yanje itumutse nk’umwotsi;</para>
  <para style="q2" vid="PSA 102:3">amagufa yanje yaka nk’ikiyigira.<verse eid="PSA 102:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4" />Umutima wanje ucitse intege ukabirana nk’ubwatsi,</para>
  <para style="q2" vid="PSA 102:4">nibagira kurya indya zanje.<verse eid="PSA 102:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5" />Mu magorwa yanje ndaniha cane</para>
  <para style="q2" vid="PSA 102:5">urukoba rwanje rwafatanye n’amagufa.<verse eid="PSA 102:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6" />Nabaye nk’igihuna co mu bugaragwa,</para>
  <para style="q2" vid="PSA 102:6">nk’inyanana yo mu misaka.<verse eid="PSA 102:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7" />Sintora agatiro; nabaye</para>
  <para style="q2" vid="PSA 102:7">nk’inyoni iri ukwa yonyene ku gisenge c’inzu.<verse eid="PSA 102:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8" />Abansi banje barantuka bukarinda bwira;</para>
  <para style="q2" vid="PSA 102:8">abancokora bakoresha izina ryanje mu kuvumana.<verse eid="PSA 102:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9" />Kuko ndya umunyota nk’indya</para>
  <para style="q2" vid="PSA 102:9">nkavanga ivyo nywa n’amosozi<verse eid="PSA 102:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10" />kubera uburake bwawe bwinshi,</para>
  <para style="q2" vid="PSA 102:10">kuko wamfashe ukanterera i ruhande.<verse eid="PSA 102:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11" />Imisi yanje yabaye nk’igitutu co ku mugoroba;</para>
  <para style="q2" vid="PSA 102:11">nkabiranye nk’ubwatsi.<verse eid="PSA 102:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12" />Ariko wewe, <char style="nd">Uhoraho</char>, uhangamye ibihe bidashira;</para>
  <para style="q2" vid="PSA 102:12">uzokwama uri rurangiranwa uko urunganwe ruzokurikirana n’urundi.<verse eid="PSA 102:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13" />Uzova hasi ugirire imbabazi Siyoni,</para>
  <para style="q2" vid="PSA 102:13">kuko hageze ko uhagirira neza;</para>
  <para style="q2" vid="PSA 102:13">igihe cashinzwe kirashitse.<verse eid="PSA 102:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14" />Kuko amabuye yaho ari ay’igiciro ku basavyi bawe;</para>
  <para style="q2" vid="PSA 102:14">n’umukungugu waho utuma bahumvira akagongwe.<verse eid="PSA 102:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15" />Amahanga azokwubaha izina ry’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 102:15">abami bose bo mw’isi bazokwunamira kubera icubahiro cawe.<verse eid="PSA 102:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16" />Kuko <char style="nd">Uhoraho</char> azosubira kwubaka Siyoni</para>
  <para style="q2" vid="PSA 102:16">aseruke mu bwiza bwiwe.<verse eid="PSA 102:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17" />Azokwishura ugusenga kw’umugorwa;</para>
  <para style="q2" vid="PSA 102:17">ntazokwirengagiza ukwinginga kwiwe.<verse eid="PSA 102:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18" />Ibi nivyandikirwe abo mu runganwe ruzoza,</para>
  <para style="q2" vid="PSA 102:18">kugira ngo abataravuka baze bahimbaze <char style="nd">Uhoraho</char> bati:<verse eid="PSA 102:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19" />“<char style="nd">Uhoraho</char> yarungurutse ari ahera hiwe mw’ijuru,</para>
  <para style="q2" vid="PSA 102:19">ari mw’ijuru yarungurutse isi,<verse eid="PSA 102:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20" />ngo yumve ukuniha kw’imbohe</para>
  <para style="q2" vid="PSA 102:20">kandi ngo abohore abaciriwe urwo gupfa.”<verse eid="PSA 102:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21" />Nuko izina ry’<char style="nd">Uhoraho</char> rizovugwa i Siyoni</para>
  <para style="q2" vid="PSA 102:21">n’i Yerusalemu bazomuhimbaza<verse eid="PSA 102:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22" />aho amoko yose n’ubwami bwose</para>
  <para style="q2" vid="PSA 102:22">bazokoranira hamwe gusenga <char style="nd">Uhoraho</char>.<verse eid="PSA 102:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23" />Ngeze hagati y’urugendo rwanje yamaze inkomezi;</para>
  <para style="q2" vid="PSA 102:23">yagabanije imyaka yanje.<verse eid="PSA 102:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24" />Nuko ndavuga nti:</para>
  <para style="q1" vid="PSA 102:24">“Ntunkureho, Mana yanje, nkiri hagati y’imyaka yanje yo kubaho;</para>
  <para style="q2" vid="PSA 102:24">wewe wamaho ibihe vyose.<verse eid="PSA 102:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25" />Ubwa mbere na mbere washizeho amatanguriro y’isi,</para>
  <para style="q2" vid="PSA 102:25">kandi amaboko yawe ni yo yaremye amajuru.<verse eid="PSA 102:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26" />Bizoshira, ariko wewe wamaho;</para>
  <para style="q2" vid="PSA 102:26">vyose bizosaza nk’impuzu.</para>
  <para style="q1" vid="PSA 102:26">Uzobihindura nk’uwuhindura impuzu</para>
  <para style="q2" vid="PSA 102:26">maze bishire.<verse eid="PSA 102:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27" />Ariko wewe uhora uko wamye,</para>
  <para style="q2" vid="PSA 102:27">kandi imyaka yawe ntigira iherezo.<verse eid="PSA 102:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28" />Abana b’abasavyi bawe bazoba mu nyonga hawe;</para>
  <para style="q2" vid="PSA 102:28">uruvyaro rwabo ruzokwama imbere yawe.”<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="cl">Zaburi ya 103</para>
  <para style="d">Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1" />Mutima wanje, himbaza <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 103:1">namwe bimbamwo mwese, nimuhimbaze izina ryiwe ryera.<verse eid="PSA 103:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2" />Mutima wanje, himbaza <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 103:2">ntiwibagire ivyiza yagukoreye vyose;<verse eid="PSA 103:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3" />ni we aharira ivyaha vyawe vyose</para>
  <para style="q2" vid="PSA 103:3">agakiza ingwara zawe zose,<verse eid="PSA 103:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4" />ni we acungura ubugingo bwawe ngo ntibuje muri rwa rwobo</para>
  <para style="q2" vid="PSA 103:4">akakwambika urukundo n’imbabazi nk’igitsibo,<verse eid="PSA 103:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5" />ni we aguhaza ivyiza</para>
  <para style="q2" vid="PSA 103:5">kugira ngo ubusore bwawe bwiyubure nk’ubw’inkona.<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6" />
    <char style="nd">Uhoraho</char> agirira ivyo kugororoka</para>
  <para style="q2" vid="PSA 103:6">n’ivy’imanza zibereye abahahazwa bose.<verse eid="PSA 103:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7" />Yamenyesheje Mose inzira ziwe,</para>
  <para style="q2" vid="PSA 103:7">n’ibikorwa vyiwe kuri Isirayeli:<verse eid="PSA 103:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8" />
    <char style="nd">Uhoraho</char> agira impuhwe n’ubuntu,</para>
  <para style="q2" vid="PSA 103:8">ateba kuraka, akagira urukundo rwinshi.<verse eid="PSA 103:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9" />Ntazokwama yagiriza,</para>
  <para style="q2" vid="PSA 103:9">kandi ntazokwama aratse ibihe vyose;<verse eid="PSA 103:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10" />ntadukorera ibikwiranye n’ivyaha vyacu</para>
  <para style="q2" vid="PSA 103:10">canke ngo atugerere ibihwanye n’ibigabitanyo vyacu.<verse eid="PSA 103:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11" />Kuko nk’uko amajuru yitanguriye isi,</para>
  <para style="q2" vid="PSA 103:11">ni ko urukundo agirira abamwubaha rungana;<verse eid="PSA 103:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12" />nk’uko ubuseruko bwitanguriye uburengero,</para>
  <para style="q2" vid="PSA 103:12">ni ko yashiburiye kure yacu ibigabitanyo vyacu.<verse eid="PSA 103:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13" />Nk’uko se agirira abana ikigongwe,</para>
  <para style="q2" vid="PSA 103:13">ni ko <char style="nd">Uhoraho</char> agirira ikigongwe abamwubaha;<verse eid="PSA 103:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14" />kuko azi iremwa ryacu,</para>
  <para style="q2" vid="PSA 103:14">yibuka ko turi umukungugu.<verse eid="PSA 103:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15" />Ubugingo bw’abana b’abantu ni nk’ivyatsi gusa,</para>
  <para style="q2" vid="PSA 103:15">bamera nk’amashurwe yo ku misozi;<verse eid="PSA 103:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16" />umuyaga uyahuhako akaba agiye,</para>
  <para style="q2" vid="PSA 103:16">aho yahora ntihabe hacibukwa.<verse eid="PSA 103:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17" />Ariko uhereye ibihe vyose ukageza ibihe vyose</para>
  <para style="q2" vid="PSA 103:17">urukundo rw’<char style="nd">Uhoraho</char> ruri ku bamwubaha,</para>
  <para style="q2" vid="PSA 103:17">kandi ukugororoka kwiwe kuri ku ruvyaro rw’abana babo;<verse eid="PSA 103:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18" />ku bitondera isezerano ryiwe</para>
  <para style="q2" vid="PSA 103:18">bakibuka kwitondera ivyo yashinze.<verse eid="PSA 103:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19" />
    <char style="nd">Uhoraho</char> yashinze intebe y’ubwami yiwe mw’ijuru,</para>
  <para style="q2" vid="PSA 103:19">kandi ni umwami aganza vyose.<verse eid="PSA 103:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20" />Nimuhimbaze <char style="nd">Uhoraho</char>, yemwe bamarayika biwe,</para>
  <para style="q2" vid="PSA 103:20">yemwe banyenkomezi mukora ivyo ategetse,</para>
  <para style="q2" vid="PSA 103:20">mwumvira ijambo ryiwe.<verse eid="PSA 103:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21" />Nimuhimbaze <char style="nd">Uhoraho</char>, yemwe mwa nyenyeri zo kw’ijuru,</para>
  <para style="q2" vid="PSA 103:21">yemwe basavyi biwe bakora ivyo agomba.<verse eid="PSA 103:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22" />Nimuhimbaze <char style="nd">Uhoraho</char>, yemwe bikorwa vyiwe</para>
  <para style="q2" vid="PSA 103:22">aho muri hose mu bwami bwiwe.</para>
  <para style="b" vid="PSA 103:22" />
  <para style="q1" vid="PSA 103:22">Mutima wanje, himbaza <char style="nd">Uhoraho</char>.<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="cl">Zaburi ya 104</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1" />Mutima wanje, himbaza <char style="nd">Uhoraho</char>.</para>
  <para style="b" vid="PSA 104:1" />
  <para style="q1" vid="PSA 104:1">
    <char style="nd">Uhoraho</char> Mana yanje, urahambaye cane;</para>
  <para style="q2" vid="PSA 104:1">wambaye icubahiro n’igitinyiro.<verse eid="PSA 104:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2" />
    <char style="nd">Uhoraho</char> yitwikiriza umuco nk’umutamana;</para>
  <para style="q2" vid="PSA 104:2">yubaka amajuru nk’ihema<verse eid="PSA 104:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 104:3" />agashinga inkingi z’inzu ziwe zo hejuru ku mazi menshi.</para>
  <para style="q1" vid="PSA 104:3">Ahindura ibicu umukogote wiwe</para>
  <para style="q2" vid="PSA 104:3">akagendera ku mababa y’umuyaga.<verse eid="PSA 104:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4" />Ahindura imiyaga intumwa ziwe,</para>
  <para style="q2" vid="PSA 104:4">abakozi biwe akabagira imbeya z’umuriro.<verse eid="PSA 104:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5" />Ashinga isi ku matanguriro yayo;</para>
  <para style="q2" vid="PSA 104:5">kandi ntiyigera inyiganyizwa.<verse eid="PSA 104:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6" />Wayitwikirije amadamba y’amazi nk’impuzu;</para>
  <para style="q2" vid="PSA 104:6">amazi yarenze udutwe tw’imisozi.<verse eid="PSA 104:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7" />Ariko uvuze gusa amazi arahunga,</para>
  <para style="q2" vid="PSA 104:7">yumvise uguturagara kwawe yaciye ahunga;<verse eid="PSA 104:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8" />yaduze imisozi,</para>
  <para style="q2" vid="PSA 104:8">amanuka mu biyaya,</para>
  <para style="q2" vid="PSA 104:8">aho wayashingiye kuba.<verse eid="PSA 104:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9" />Wayashingiye akarimbi atarenga;</para>
  <para style="q2" vid="PSA 104:9">ntazosubira kurengera isi.<verse eid="PSA 104:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10" />Atuma amasoko adudubiza amazi aja mu myonga;</para>
  <para style="q2" vid="PSA 104:10">agatembera hagati y’imisozi.<verse eid="PSA 104:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11" />Agaha amazi ibikoko vyose vyo mw’ishamba;</para>
  <para style="q2" vid="PSA 104:11">indogoba z’inyeshamba zikimara inyota.<verse eid="PSA 104:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12" />Inyoni zo mu kirere zubaka ivyari vyazo i ruhande y’amazi;</para>
  <para style="q2" vid="PSA 104:12">ziririmbira mu mashami y’ibiti.<verse eid="PSA 104:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13" />Avomerera imisozi ari mu nzu yiwe mw’ijuru;</para>
  <para style="q2" vid="PSA 104:13">igihugu kigahazwa n’ibivuye mu bikorwa vyiwe.<verse eid="PSA 104:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14" />Atuma ivyatsi bikura kubera amasho,</para>
  <para style="q2" vid="PSA 104:14">n’ibiterwa birimwe n’abantu,</para>
  <para style="q2" vid="PSA 104:14">kugira ngo isi bayikuremwo ivyokurya:<verse eid="PSA 104:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15" />umuvinyu unezereza imitima y’abantu,</para>
  <para style="q2" vid="PSA 104:15">amavuta atuma abantu bakayangana mu maso,</para>
  <para style="q2" vid="PSA 104:15">n’umutsima ubaha inkomezi.<verse eid="PSA 104:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16" />Ibiti vy’<char style="nd">Uhoraho</char> bivomererwa neza,</para>
  <para style="q2" vid="PSA 104:16">amasederi y’i Libani, ayo yateye.<verse eid="PSA 104:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17" />Raba inyoni uko zijisha ivyari vyazo;</para>
  <para style="q2" vid="PSA 104:17">agasoza kironkera inzu yako mu tujwari.<verse eid="PSA 104:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18" />Mu misozi miremire ni ho impene z’inyeshamba zibera;</para>
  <para style="q2" vid="PSA 104:18">ibitandara ni ubuhungiro bw’inkezi.<verse eid="PSA 104:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19" />Yaremye ukwezi ngo kugene ibihe,</para>
  <para style="q2" vid="PSA 104:19">n’izuba rirazi igihe rirengerako.<verse eid="PSA 104:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20" />Uzana umwijima bukira,</para>
  <para style="q2" vid="PSA 104:20">maze ibikoko vyo mw’ishamba bigaturuka.<verse eid="PSA 104:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21" />Intambwe zikivuga zirondera ico zihiga</para>
  <para style="q2" vid="PSA 104:21">zikarondera indya zazo ziva ku Mana.<verse eid="PSA 104:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22" />Izuba ryaseruka, zikigira,</para>
  <para style="q2" vid="PSA 104:22">zikisubirira kubunda mu bibundo vyazo.<verse eid="PSA 104:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23" />Maze abantu bagasohoka bakaja ku bikorwa vyabo,</para>
  <para style="q2" vid="PSA 104:23">bagakora bakaruha gushika ku mugoroba.<verse eid="PSA 104:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24" />
    <char style="nd">Uhoraho</char> we, ese ingene ibikorwa vyawe ari vyinshi!</para>
  <para style="q2" vid="PSA 104:24">Wabiremesheje ubwenge vyose;</para>
  <para style="q2" vid="PSA 104:24">isi yuzuyemwo ivyaremwe vyawe.<verse eid="PSA 104:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25" />Raba ikiyaga, ingene cagutse kikaba kinini,</para>
  <para style="q2" vid="PSA 104:25">cuzuye ivyaremwe birenze urugero;</para>
  <para style="q2" vid="PSA 104:25">ibiri n’ubuzima binini na bitoya.<verse eid="PSA 104:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26" />Raba ubwato ingene buja hirya no hino,</para>
  <para style="q2" vid="PSA 104:26">na Leviyatani, iyo waremye ngo ikiniremwo.<verse eid="PSA 104:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27" />Ivyaremwe vyose biguhanga amaso</para>
  <para style="q2" vid="PSA 104:27">ngo ubigaburire ivyokurya vyavyo mu gihe cavyo.<verse eid="PSA 104:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28" />Iyo ubigaburiye,</para>
  <para style="q2" vid="PSA 104:28">biregeranya indya;</para>
  <para style="q1" vid="PSA 104:28">iyo upfunduruye ikiganza cawe,</para>
  <para style="q2" vid="PSA 104:28">bihazwa ivyiza.<verse eid="PSA 104:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29" />Uhishije mu nyonga zawe,</para>
  <para style="q2" vid="PSA 104:29">vyicwa n’ubwoba;</para>
  <para style="q1" vid="PSA 104:29">ubikuyemwo umwuka wavyo,</para>
  <para style="q2" vid="PSA 104:29">birapfa bigasubira mu mukungugu.<verse eid="PSA 104:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30" />Iyo urungitse Mpwemu wawe</para>
  <para style="q2" vid="PSA 104:30">biraremwa,</para>
  <para style="q2" vid="PSA 104:30">ugasubiza isi kuba nshasha.<verse eid="PSA 104:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31" />Icubahiro c’<char style="nd">Uhoraho</char> kiragahoraho ibihe vyose;</para>
  <para style="q2" vid="PSA 104:31">
    <char style="nd">Uhoraho</char> ahimbariwe ibikorwa vyiwe;<verse eid="PSA 104:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32" />we araba isi, na yo igahinda agashitsi,</para>
  <para style="q2" vid="PSA 104:32">akora ku misozi, igapfunduka umwotsi.<verse eid="PSA 104:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33" />Nzoririmbira <char style="nd">Uhoraho</char> ubuzima bwanje bwose;</para>
  <para style="q2" vid="PSA 104:33">nzoririmba ishimwe ry’Imana yanje imisi yose nzoba nkiriho.<verse eid="PSA 104:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34" />Icompa ukurimbura kwanje kugahimbara <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 104:34">kuko nezererwa muri we.<verse eid="PSA 104:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35" />Ariko abanyavyaha nibaherengetere kw’isi,</para>
  <para style="q2" vid="PSA 104:35">abanyakibi ntibasubire kubaho.</para>
  <para style="b" vid="PSA 104:35" />
  <para style="q1" vid="PSA 104:35">Himbaza <char style="nd">Uhoraho</char>, ewe mutima wanje.</para>
  <para style="b" vid="PSA 104:35" />
  <para style="q1" vid="PSA 104:35">Himbaza <char style="nd">Uhoraho</char>.<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="cl">Zaburi ya 105</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1" />Nimuhimbaze <char style="nd">Uhoraho</char>, mwamamaze izina ryiwe;</para>
  <para style="q2" vid="PSA 105:1">mumenyekanishe mu mahanga ivyo yakoze.<verse eid="PSA 105:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2" />Nimumuririmbire, mumuhimbaze;</para>
  <para style="q2" vid="PSA 105:2">muvuge ibikorwa vyiwe bihambaye.<verse eid="PSA 105:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3" />Mwirate izina ryiwe ryera;</para>
  <para style="q2" vid="PSA 105:3">imitima y’abarondera <char style="nd">Uhoraho</char> inezerwe.<verse eid="PSA 105:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4" />Nimurondere <char style="nd">Uhoraho</char> n’inkomezi ziwe;</para>
  <para style="q2" vid="PSA 105:4">mwame murondera mu nyonga hiwe.<verse eid="PSA 105:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5" />Nimwibuke ibitangaza yakoze,</para>
  <para style="q2" vid="PSA 105:5">utwumiza, n’imanza yaciye;<verse eid="PSA 105:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6" />yemwe ruvyaro rwa Aburahamu, umusavyi wayo;</para>
  <para style="q2" vid="PSA 105:6">yemwe bene Yakobo, abo yatoranije.<verse eid="PSA 105:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7" />
    <char style="nd">Uhoraho</char> ni we Mana yacu;</para>
  <para style="q2" vid="PSA 105:7">imanza ziwe ziri mw’isi yose.<verse eid="PSA 105:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8" />Yama yibuka isezerano ryiwe ibihe vyose,</para>
  <para style="q2" vid="PSA 105:8">n’ijambo yasezeranye, gushika ku runganwe rugira igihumbi,<verse eid="PSA 105:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9" />Isezerano yagiranye na Aburahamu,</para>
  <para style="q2" vid="PSA 105:9">indahiro yarahiye Isaka.<verse eid="PSA 105:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10" />Yararyemeje kuri Yakobo nk’itegeko,</para>
  <para style="q2" vid="PSA 105:10">no kuri Isirayeli nk’isezerano ry’intahava ngo:<verse eid="PSA 105:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11" />“Nzoguha igihugu c’i Kanani,</para>
  <para style="q2" vid="PSA 105:11">kibe umugabane wawe uzoragwa.”<verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12" />Igihe bari bakiri inkehwa gusa,</para>
  <para style="q2" vid="PSA 105:12">mbere ari inkehwa vy’ukuri, kandi ari inyambukira muri co,<verse eid="PSA 105:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13" />Bagenda bangara bava mu gihugu baja mu kindi,</para>
  <para style="q2" vid="PSA 105:13">bava mu bwami baja mu bundi.<verse eid="PSA 105:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14" />Ntiyakundira umuntu n’umwe kubacinyiza;</para>
  <para style="q2" vid="PSA 105:14">ku bwabo yakankamiye abami ati:<verse eid="PSA 105:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15" />“Ntimukore ku bo narobanuje amavuta;</para>
  <para style="q2" vid="PSA 105:15">ntimugirire nabi abavugishwa banje.”<verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16" />Yahamagaye ikigoyi mu gihugu</para>
  <para style="q2" vid="PSA 105:16">asambura ibigega vyabo vy’indya vyose;<verse eid="PSA 105:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17" />maze urungika umuntu imbere yabo;</para>
  <para style="q2" vid="PSA 105:17">ni Yosefu yagurishijwe nk’umugurano.<verse eid="PSA 105:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18" />Baboshe amaguru yiwe mu minyororo,</para>
  <para style="q2" vid="PSA 105:18">izosi ryiwe rishirwa mu vyuma,<verse eid="PSA 105:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19" />kugeza ivyo yari yaravuze bishitse,</para>
  <para style="q2" vid="PSA 105:19">kugeza ijambo ry’<char style="nd">Uhoraho</char> ryemeje ko yavuze ukuri.<verse eid="PSA 105:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20" />Umwami atumako baramurekura,</para>
  <para style="q2" vid="PSA 105:20">abakuru bo mu bantu bamuha kwidegemvya.<verse eid="PSA 105:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21" />Amuhindura uwuganza abo mu rugo rwiwe,</para>
  <para style="q2" vid="PSA 105:21">uwuganza ivyo yari atunze vyose,<verse eid="PSA 105:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22" />ngo yigishe abaganwa biwe nk’uko bimuhimbaye</para>
  <para style="q2" vid="PSA 105:22">kandi ngo yigishe abatware baho ubwenge.<verse eid="PSA 105:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23" />Maze Isirayeli yinjira muri Egiputa;</para>
  <para style="q2" vid="PSA 105:23">Yakobo aba inyambukira mu gihugu ca Hamu.<verse eid="PSA 105:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24" />
    <char style="nd">Uhoraho</char> atuma abantu biwe bagwira;</para>
  <para style="q2" vid="PSA 105:24">atuma baba benshi ku bansi babo,<verse eid="PSA 105:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25" />abo yatumye imitima yanka abantu biwe,</para>
  <para style="q2" vid="PSA 105:25">ngo bagire inama yo kubagirira nabi.<verse eid="PSA 105:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26" />Yatumye Mose umusavyi wiwe,</para>
  <para style="q2" vid="PSA 105:26">na Aroni, uwo yari yaratoranije.<verse eid="PSA 105:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27" />Bakora ibitangaza muri bo,</para>
  <para style="q2" vid="PSA 105:27">n’utwumiza mu gihugu ca Hamu.<verse eid="PSA 105:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28" />Yarungitse umwijima apfuka igihugu cabo cose;</para>
  <para style="q2" vid="PSA 105:28">kuko bari bamugararije.<verse eid="PSA 105:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29" />Yahinduye amazi yabo amaraso,</para>
  <para style="q2" vid="PSA 105:29">bituma amafi yabo apfa.<verse eid="PSA 105:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30" />Igihugu cabo cuzuye ibikere,</para>
  <para style="q2" vid="PSA 105:30">biraduga no mu buriri bw’abatware babo.<verse eid="PSA 105:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31" />Yaravuze, haca hatera ibibugu,</para>
  <para style="q2" vid="PSA 105:31">imibu ikwira igihugu cose ca Egiputa.<verse eid="PSA 105:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32" />Yahinduye imvura yabo urubura,</para>
  <para style="q2" vid="PSA 105:32">imiravyo iboneka mu gihugu cabo cose;<verse eid="PSA 105:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33" />yahungururiye hasi imizabibu n’imisukoni vyabo</para>
  <para style="q2" vid="PSA 105:33">avunagura ibiti vyo muri Egiputa.<verse eid="PSA 105:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34" />Yaravuze, maze inzige ziraza,</para>
  <para style="q2" vid="PSA 105:34">intoteza zitagira igitigiri;<verse eid="PSA 105:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35" />zirya ibitotahaye vyose vyo mu gihugu cabo,</para>
  <para style="q2" vid="PSA 105:35">zirya ivyimburwa bimera kw’isi yabo.<verse eid="PSA 105:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36" />Maze yica abana b’imfura bo mu gihugu cabo,</para>
  <para style="q2" vid="PSA 105:36">ivyamwa vya mbere vyo mu buto bwabo.<verse eid="PSA 105:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37" />Yasohoye Isirayeli, bagenda bikoreye ifeza n’inzahabu</para>
  <para style="q2" vid="PSA 105:37">mu bo mu miryango yabo nta n’umwe yatsitaye.<verse eid="PSA 105:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38" />Egiputa bari banezerewe igihe bagenda</para>
  <para style="q2" vid="PSA 105:38">kuko bari batekewe n’ubwoba kubera Abisirayeli.<verse eid="PSA 105:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39" />Yagaranzuye igicu co kubapfuka,</para>
  <para style="q2" vid="PSA 105:39">n’umuriro wo kubamurikira mw’ijoro.<verse eid="PSA 105:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40" />Barasavye, na we abaha inkware;</para>
  <para style="q2" vid="PSA 105:40">yarabagaburiye barahaga umukate uvuye mw’ijuru.<verse eid="PSA 105:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41" />Yasatuye igitandara, amazi aradudubiza;</para>
  <para style="q2" vid="PSA 105:41">atemba nk’uruzi mu bugaragwa.<verse eid="PSA 105:41" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42" />Kuko yibutse isezerano ryiwe ryera</para>
  <para style="q2" vid="PSA 105:42">iryo yahaye umusavyi wiwe Aburahamu.<verse eid="PSA 105:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43" />Yasohoye abantu biwe banezerewe,</para>
  <para style="q2" vid="PSA 105:43">abo yitoranirije bavuza impundu z’umunezero;<verse eid="PSA 105:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44" />yabahaye igihugu c’amahanga,</para>
  <para style="q2" vid="PSA 105:44">barazwe ico abandi bahabiye;<verse eid="PSA 105:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45" />kugira ngo bitondere ivyo yihanikirije</para>
  <para style="q2" vid="PSA 105:45">bagendere mu vyagezwe vyiwe.</para>
  <para style="b" vid="PSA 105:45" />
  <para style="q1" vid="PSA 105:45">
    <char style="nd">Uhoraho</char> ahimbazwe.<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="cl">Zaburi ya 106</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />Haleluya.</para>
  <para style="b" vid="PSA 106:1" />
  <para style="q1" vid="PSA 106:1">Nimushime <char style="nd">Uhoraho</char> kuko ari mwiza;</para>
  <para style="q2" vid="PSA 106:1">kuko urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 106:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2" />Ni nde ashobora kumenyekanisha ivyo <char style="nd">Uhoraho</char> yakoze</para>
  <para style="q2" vid="PSA 106:2">canke ngo amuhimbaze nk’uko bikwiye?<verse eid="PSA 106:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3" />Hahiriwe abakora ibitunganye,</para>
  <para style="q2" vid="PSA 106:3">bakama bakora ibigororotse.<verse eid="PSA 106:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4" />Ewe <char style="nd">Uhoraho</char>, uranyibuka niwagirira imbabazi abantu bawe,</para>
  <para style="q2" vid="PSA 106:4">uze untabare niwabakiza,<verse eid="PSA 106:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5" />kugira ngo nezererwe amahirwe y’abo watoranije.</para>
  <para style="q2" vid="PSA 106:5">Kugira ngo nsangire umunezero n’ihanga ryawe</para>
  <para style="q2" vid="PSA 106:5">nifatanye n’ishamvu yawe mu kugutazira.<verse eid="PSA 106:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6" />Twaracumuye, nk’uko ba sogokuruza bakoze;</para>
  <para style="q2" vid="PSA 106:6">twakoze ibitabereye dukora ibibi.<verse eid="PSA 106:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7" />Igihe ba sogokuruza bari muri Egiputa,</para>
  <para style="q2" vid="PSA 106:7">ntibamenye ibitangaza wakoze;</para>
  <para style="q1" vid="PSA 106:7">ntibibutse ivy’ukugira neza kwawe kwinshi,</para>
  <para style="q2" vid="PSA 106:7">maze baragarariza bari ku kiyaga, Ikiyaga Gitukura.<verse eid="PSA 106:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8" />Ariko arabakiza kubera izina ryiwe,</para>
  <para style="q2" vid="PSA 106:8">ngo amenyekanishe ubushobozi bwiwe.<verse eid="PSA 106:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9" />Yakankamiye Ikiyaga Gitukura, maze kiruma;</para>
  <para style="q2" vid="PSA 106:9">yabacishije i bwina nko mu bugaragwa.<verse eid="PSA 106:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10" />Yarabakijije abakura mu kuboko kw’umwansi;</para>
  <para style="q2" vid="PSA 106:10">arabacungura abakura mu kuboko k’uwabagwanya.<verse eid="PSA 106:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11" />Amazi arengera ababahiga;</para>
  <para style="q2" vid="PSA 106:11">nta n’umwe wo muri bo yarokotse.<verse eid="PSA 106:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12" />Nuko bizera amasezerano yiwe</para>
  <para style="q2" vid="PSA 106:12">baririmba ishimwe ryiwe.<verse eid="PSA 106:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13" />Ariko baca bibagira vuba ivyo yari yabakoreye</para>
  <para style="q2" vid="PSA 106:13">ntibarindira ko ashira mu ngiro umugambi wiwe.<verse eid="PSA 106:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14" />Mu bugaragwa bagiye mu vyo kwipfuza kwabo;</para>
  <para style="q2" vid="PSA 106:14">mu bweranyange bagerageje Imana.<verse eid="PSA 106:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15" />Nuko ibaha ivyo basavye,</para>
  <para style="q2" vid="PSA 106:15">ariko ibarungikira ikiza gihonya.<verse eid="PSA 106:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16" />Bari aho bacumbitse bagiriye ishari Mose</para>
  <para style="q2" vid="PSA 106:16">hamwe na Aroni, uwari yatoranirijwe <char style="nd">Uhoraho</char>.<verse eid="PSA 106:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17" />Isi irasama imira Datani;</para>
  <para style="q2" vid="PSA 106:17">ihamba umugwi wa Abiramu.<verse eid="PSA 106:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18" />Umuriro wadutse mu babakurikira;</para>
  <para style="q2" vid="PSA 106:18">urubeya rwarigase abanyakibi.<verse eid="PSA 106:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19" />I Horebu bacuze imasa</para>
  <para style="q2" vid="PSA 106:19">basenga ikigirwamana cacuzwe mu butare.<verse eid="PSA 106:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20" />Baguza Imana yabo y’ubwiza</para>
  <para style="q2" vid="PSA 106:20">igishushanyo c’impfizi, irisha ubwatsi.<verse eid="PSA 106:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21" />Bibagira Imana yabakijije,</para>
  <para style="q2" vid="PSA 106:21">yakoze ibihambaye muri Egiputa,<verse eid="PSA 106:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22" />ibitangaza mu gihugu ca Hamu</para>
  <para style="q2" vid="PSA 106:22">n’ibikorwa bihambaye ku Kiyaga Gitukura.<verse eid="PSA 106:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23" />Nuko avuga ko azobahonya;</para>
  <para style="q2" vid="PSA 106:23">iyo Mose, uwo yatoranije,</para>
  <para style="q1" vid="PSA 106:23">adahagarara mu gihengeri imbere yiwe</para>
  <para style="q2" vid="PSA 106:23">kugira ngo uburake bwiwe ntibubarigate.<verse eid="PSA 106:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24" />Mu nyuma banka igihugu ciza;</para>
  <para style="q2" vid="PSA 106:24">ntibizera isezerano ryiwe.<verse eid="PSA 106:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25" />Baridodomvye bari mu mahema yabo</para>
  <para style="q2" vid="PSA 106:25">ntibubaha <char style="nd">Uhoraho</char>.<verse eid="PSA 106:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26" />Aca arahira amanitse ukuboko kwiwe</para>
  <para style="q2" vid="PSA 106:26">ko azobahonereza mu bugaragwa,<verse eid="PSA 106:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27" />agatuma uruvyaro rwabo rugwa mu banyamahanga</para>
  <para style="q2" vid="PSA 106:27">akabasanzariza mu bihugu.<verse eid="PSA 106:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28" />Bifatanije na Bayali y’i Peyori</para>
  <para style="q2" vid="PSA 106:28">maze barya ivyaterekerejwe imana zitagiramwo ubuzima;<verse eid="PSA 106:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29" />bavyura uburake bw’<char style="nd">Uhoraho</char> kubera ibikorwa vyabo bibi,</para>
  <para style="q2" vid="PSA 106:29">haca haduka ikiza muri bo.<verse eid="PSA 106:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30" />Ariko Finehasi arahaguruka ngo ahane uwacumuye,</para>
  <para style="q2" vid="PSA 106:30">ico kiza gica kirahagarara.<verse eid="PSA 106:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31" />Ivyo yabiharuweko nk’ukugororoka</para>
  <para style="q2" vid="PSA 106:31">uko urunganwe ruzokurikirana n’urundi ibihe vyose.<verse eid="PSA 106:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32" />Bashavuje <char style="nd">Uhoraho</char> bari ku mazi y’i Meriba,</para>
  <para style="q2" vid="PSA 106:32">ivyago biza kuri Mose kubera bo;<verse eid="PSA 106:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33" />kuko batumviye Mpwemu w’Imana,</para>
  <para style="q2" vid="PSA 106:33">bituma Mose yadukana amajambo atiyumviriye.<verse eid="PSA 106:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34" />Ntibaranduye amahanga</para>
  <para style="q2" vid="PSA 106:34">nk’uko <char style="nd">Uhoraho</char> yari yababariye,<verse eid="PSA 106:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35" />ariko bivanga n’ayo mahanga</para>
  <para style="q2" vid="PSA 106:35">bigana ingeso zabo.<verse eid="PSA 106:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36" />Basenga imana zabo,</para>
  <para style="q2" vid="PSA 106:36">na zo zibabera umutego.<verse eid="PSA 106:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37" />Bashikanira izo mana</para>
  <para style="q2" vid="PSA 106:37">abahungu n’abakobwa babo.<verse eid="PSA 106:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38" />Basesa amaraso y’abatagira icaha,</para>
  <para style="q2" vid="PSA 106:38">amaraso y’abahungu n’abakobwa babo,</para>
  <para style="q1" vid="PSA 106:38">abo bashikaniye ibigirwamana vy’i Kanani nk’ibimazi,</para>
  <para style="q2" vid="PSA 106:38">maze ayo maraso ahumanya igihugu.<verse eid="PSA 106:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39" />Bihumanishije ivyo bakoze;</para>
  <para style="q2" vid="PSA 106:39">bacika abasambanyi kubera ibikorwa vyabo.<verse eid="PSA 106:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40" />Ni co catumye <char style="nd">Uhoraho</char> ashavurira abantu biwe,</para>
  <para style="q2" vid="PSA 106:40">azinukwa umugabane wiwe.<verse eid="PSA 106:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41" />Yabarekuriye mu maboko y’amahanga,</para>
  <para style="q2" vid="PSA 106:41">maze abansi babo barabaganza.<verse eid="PSA 106:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42" />Abansi babo barabacinyiza</para>
  <para style="q2" vid="PSA 106:42">baba musi y’ububasha bwabo.<verse eid="PSA 106:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43" />Yabatabaye kenshi,</para>
  <para style="q2" vid="PSA 106:43">ariko bashishikara kumugarariza</para>
  <para style="q2" vid="PSA 106:43">kandi baguma bamucumurako.<verse eid="PSA 106:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44" />Ariko yumvise umubabaro wabo</para>
  <para style="q2" vid="PSA 106:44">igihe yumva ugutakamba kwabo;<verse eid="PSA 106:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45" />Ku bwabo yibutse isezerano ryiwe</para>
  <para style="q2" vid="PSA 106:45">maze kubera urukundo rwiwe rwinshi arigarura.<verse eid="PSA 106:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46" />Yatumye ababagize abagurano</para>
  <para style="q2" vid="PSA 106:46">babagirira akagongwe.<verse eid="PSA 106:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47" />Dukize, <char style="nd">Uhoraho</char> Mana yacu,</para>
  <para style="q2" vid="PSA 106:47">twegeranye udukure mu mahanga,</para>
  <para style="q1" vid="PSA 106:47">kugira ngo dushime izina ryawe ryera</para>
  <para style="q2" vid="PSA 106:47">Twongere tuguhimbaze.<verse eid="PSA 106:47" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48" />
    <char style="nd">Uhoraho</char>, Imana ya Isirayeli, ahimbazwe,</para>
  <para style="q2" vid="PSA 106:48">uhereye ibihe bidashira ukageza ibihe bidashira.</para>
  <para style="b" vid="PSA 106:48" />
  <para style="q1" vid="PSA 106:48">Abantu bose nibavuge bati: “Amen.”</para>
  <para style="b" vid="PSA 106:48" />
  <para style="q1" vid="PSA 106:48">Haleluya.<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">Igitabu ca gatanu</para>
  <para style="mr">
    <ref loc="PSA 107-150">Zaburi 107–150</ref></para>
  <para style="cl">Zaburi ya 107</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1" />Nimushimire <char style="nd">Uhoraho</char>, kuko ari mwiza;</para>
  <para style="q2" vid="PSA 107:1">urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 107:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2" />Abacunguwe n’<char style="nd">Uhoraho</char> nibashinge iyo intahe;</para>
  <para style="q2" vid="PSA 107:2">abo yacunguye akabakura mu kuboko kw’umwansi,<verse eid="PSA 107:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3" />abo yegeranije abakura mu bihugu,</para>
  <para style="q2" vid="PSA 107:3">mu buseruko no mu burengero, mu buraruko no mu bumanuko.<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4" />Bamwe bayerera mu bugaragwa, kw’isi igadutse,</para>
  <para style="q2" vid="PSA 107:4">ntibabona inzira yobashikana mu gisagara boshobora kubamwo.<verse eid="PSA 107:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5" />Bari bashonje kandi banyotewe,</para>
  <para style="q2" vid="PSA 107:5">bari bihebuye.<verse eid="PSA 107:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6" />Maze mu magorwa yabo, batakambiye <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 107:6">na we arabakiza, abakura mu marushwa yabo.<verse eid="PSA 107:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7" />Yabarongoreye mu nzira igororotse</para>
  <para style="q2" vid="PSA 107:7">abajana mu gisagara bari bagiye kubamwo.<verse eid="PSA 107:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8" />Abo nibashime <char style="nd">Uhoraho</char> ku bw’urukundo rwiwe rudashira,</para>
  <para style="q2" vid="PSA 107:8">n’ibikorwa bihambaye yakoreye abana b’abantu,<verse eid="PSA 107:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9" />kuko amara inyota abanyotewe</para>
  <para style="q2" vid="PSA 107:9">agahaza ivyiza abashonje.<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10" />Bamwe bicara mu mwiza, umwijima w’urupfu,</para>
  <para style="q2" vid="PSA 107:10">ari imbohe ziri mu mubabaro mu minyororo y’ivyuma,<verse eid="PSA 107:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11" />kuko batumviye ivyo Imana yategetse</para>
  <para style="q2" vid="PSA 107:11">bagakengera imigambi y’Iyisumbavyose.<verse eid="PSA 107:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12" />Nuko ibashira ku bikebere;</para>
  <para style="q2" vid="PSA 107:12">baratsitara, ntibaronka uwo kubatabara.<verse eid="PSA 107:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13" />Maze mu magorwa yabo batakambira <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 107:13">na we arabakiza, abakura mu marushwa yabo.<verse eid="PSA 107:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14" />Yabakuye mu mwijima, umwijima w’urupfu,</para>
  <para style="q2" vid="PSA 107:14">acagagura iminyororo yabo.<verse eid="PSA 107:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15" />Abo nibashime <char style="nd">Uhoraho</char> Ku bw’urukundo rwiwe rudashira,</para>
  <para style="q2" vid="PSA 107:15">n’ibikorwa bihambaye yakoreye abana b’abantu,<verse eid="PSA 107:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16" />kuko yamenye inzugi z’imiringa</para>
  <para style="q2" vid="PSA 107:16">agacagagura ibihindizo vy’ivyuma.<verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17" />Bamwe babaye ibipfu kubera inzira zabo mbi</para>
  <para style="q2" vid="PSA 107:17">bagira amagorwa ku bwo kugabitanya kwabo.<verse eid="PSA 107:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18" />Banka kurya indya zose</para>
  <para style="q2" vid="PSA 107:18">bituma begereza ku marembo y’urupfu.<verse eid="PSA 107:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19" />Maze mu magorwa yabo batakambira <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 107:19">na we arabakiza, abakura mu marushwa yabo.<verse eid="PSA 107:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20" />Yarungitse ijambo ryiwe, arabakiza;</para>
  <para style="q2" vid="PSA 107:20">arabatabara abakuye mu rupfu.<verse eid="PSA 107:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21" />Abo nibashime <char style="nd">Uhoraho</char> Ku bw’urukundo rwiwe rudashira,</para>
  <para style="q2" vid="PSA 107:21">n’ibikorwa bihambaye yakoreye abana b’abantu.<verse eid="PSA 107:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22" />Nibamushikanire ibimazi vy’ishimwe</para>
  <para style="q2" vid="PSA 107:22">bavuge ivyo yakoze mu ndirimbo z’umunezero.<verse eid="PSA 107:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23" />Bamwe bagiye n’ubwato mu kiyaga;</para>
  <para style="q2" vid="PSA 107:23">bari abadandaza hejuru y’amazi y’inkomezi.<verse eid="PSA 107:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24" />Babonye ibikorwa vy’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 107:24">ibitangaza yakoreye i bwina.<verse eid="PSA 107:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25" />Kuko yavuze akavyura umuyaga</para>
  <para style="q2" vid="PSA 107:25">wavyuye imipfunda.<verse eid="PSA 107:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26" />Baraduze baja hejuru bongera baramanuka i bwina;</para>
  <para style="q2" vid="PSA 107:26">muri ayo marushwa barihebura.<verse eid="PSA 107:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27" />Barazunguriwe, baradandabagirana nk’imborerwa;</para>
  <para style="q2" vid="PSA 107:27">bari babaye nk’abatagira ubwenge.<verse eid="PSA 107:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28" />Maze mu magorwa yabo, batakambiye <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 107:28">na we abakura mu marushwa yabo.<verse eid="PSA 107:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29" />Yahagaritse ingunza y’amazi;</para>
  <para style="q2" vid="PSA 107:29">imikuba iratekereza.<verse eid="PSA 107:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30" />Baranezerewe aho catekereza,</para>
  <para style="q2" vid="PSA 107:30">na we arabarongora abashitsa aho bipfuza gushika.<verse eid="PSA 107:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31" />Abo nibashime <char style="nd">Uhoraho</char> Ku bw’urukundo rwiwe rudashira,</para>
  <para style="q2" vid="PSA 107:31">n’ibikorwa bihambaye yakoreye abana b’abantu.<verse eid="PSA 107:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32" />Nibamushire hejuru bari mw’ikoraniro ry’abantu</para>
  <para style="q2" vid="PSA 107:32">bamuhimbarize mw’ikoraniro ry’abakuru.<verse eid="PSA 107:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33" />Yahinduye inzuzi ubugaragwa,</para>
  <para style="q2" vid="PSA 107:33">imigezi itemba ayihindura isi igadutse,<verse eid="PSA 107:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34" />isi yimbuka nayo ayihindura igihugu c’umunyu,</para>
  <para style="q2" vid="PSA 107:34">kubera ibibi vy’abahaba.<verse eid="PSA 107:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35" />Yahinduye ubugaragwa amariba y’amazi</para>
  <para style="q2" vid="PSA 107:35">n’isi igadutse ahantu h’amariba;<verse eid="PSA 107:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36" />aho ni ho yahaye abashonje kubaho,</para>
  <para style="q2" vid="PSA 107:36">maze bubaka igisagara aho kuba.<verse eid="PSA 107:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37" />Babiba mu mirima batera n’imizabibu</para>
  <para style="q2" vid="PSA 107:37">bimbura vyinshi;<verse eid="PSA 107:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38" />abaha umugisha, n’ibitigiri vyabo birongerekana,</para>
  <para style="q2" vid="PSA 107:38">kandi ntiyemera ko amasho yabo agabanuka.<verse eid="PSA 107:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39" />Hanyuma igitigiri cabo kiragabanuka, bacishwa bugufi</para>
  <para style="q2" vid="PSA 107:39">n’agahahazo, ivyago n’umubabaro;<verse eid="PSA 107:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40" />Imana ituma abaganwa bamaramara</para>
  <para style="q2" vid="PSA 107:40">ituma bangara mu bugaragwa butagira inzira.<verse eid="PSA 107:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41" />Ariko yakuye abakene mu mubabaro wabo</para>
  <para style="q2" vid="PSA 107:41">aca agwiza imiryango yabo nk’imikuku.<verse eid="PSA 107:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42" />Abatunganye barabibona baranezerwa,</para>
  <para style="q2" vid="PSA 107:42">ariko abanyakibi bazibwa akanwa.<verse eid="PSA 107:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43" />Nihaba hariho umunyabwenge niyiyumvire kuri ivyo</para>
  <para style="q2" vid="PSA 107:43">kugira ngo atahure ibikorwa vy’urukundo vy’<char style="nd">Uhoraho</char>.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="cl">Zaburi ya 108</para>
  <para style="d">Ni indirimbo. Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1" />Umutima wanje urashikamye ewe Mana;</para>
  <para style="q2" vid="PSA 108:1">nzoririmba ncurarange n’umushaha wanje wose.<verse eid="PSA 108:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2" />Ewe nanga nawe kembe, nimwikangure!</para>
  <para style="q2" vid="PSA 108:2">Nzovyura umutwenzi.<verse eid="PSA 108:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3" />Ewe <char style="nd">Uhoraho</char>, nzoguhimbaza mu moko menshi;</para>
  <para style="q2" vid="PSA 108:3">nzokuririmba ndi mu mahanga.<verse eid="PSA 108:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4" />Kuko urukundo rwawe ari rwinshi, rushika no mu majuru;</para>
  <para style="q2" vid="PSA 108:4">ubwizigirwa bwawe bushika no mu birere.<verse eid="PSA 108:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5" />Nushirwe hejuru, ewe Mana, hejuru y’amajuru;</para>
  <para style="q2" vid="PSA 108:5">icubahiro cawe gikwire kw’isi yose.<verse eid="PSA 108:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6" />Dutabarishe ukuboko kwawe kw’i buryo, kandi utwishure;</para>
  <para style="q2" vid="PSA 108:6">kugira ngo abo ukunda bakire.<verse eid="PSA 108:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7" />Imana yavugiye ahera hayo iti:</para>
  <para style="q2" vid="PSA 108:7">“Mu kunesha kwanje nzogaburamwo ibice Shekemu,</para>
  <para style="q2" vid="PSA 108:7">kandi nzogeresha umugozi ikiyaya c’i Sukoti.<verse eid="PSA 108:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8" />Gileyadi ni uwanje, kandi Manase ni uwanje;</para>
  <para style="q2" vid="PSA 108:8">Efurayimu ni we nkofero yanje,</para>
  <para style="q2" vid="PSA 108:8">Yuda ni icumu ryanje ry’ubugabe.<verse eid="PSA 108:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9" />Mowabu ni ibesani niyogeramwo,</para>
  <para style="q2" vid="PSA 108:9">kuri Edomu ni ho nkunkumurira ibirato vyanje;</para>
  <para style="q2" vid="PSA 108:9">Kuri Filisitiya ni ho nivugira amazina yo kunesha.”<verse eid="PSA 108:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10" />Ni nde azonshikana mu gisagara gikikujwe inzitiro?</para>
  <para style="q2" vid="PSA 108:10">Ni nde azondongora gushika kuri Edomu?<verse eid="PSA 108:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11" />Mbega si wewe ga Mana</para>
  <para style="q2" vid="PSA 108:11">wadutaye, Ntube ukijana n’ingabo zacu ku rugamba?<verse eid="PSA 108:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12" />Dufashe kugwanya umwansi,</para>
  <para style="q2" vid="PSA 108:12">kuko ugutabara kw’abantu ata co kumaze.<verse eid="PSA 108:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13" />Turi kumwe n’Imana tuzonesha intambara,</para>
  <para style="q2" vid="PSA 108:13">Kandi izosiribanga abansi bacu.<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="cl">Zaburi ya 109</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni iya Dawidi. Ni Zaburi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1" />Mana, wewe mpimbaza,</para>
  <para style="q2" vid="PSA 109:1">ntucereze,<verse eid="PSA 109:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2" />kuko abantu babi kandi b’ingunge</para>
  <para style="q2" vid="PSA 109:2">buguruye akanwa kabo ngo bangwanye;</para>
  <para style="q2" vid="PSA 109:2">bavugishije indimi zabo bambeshera.<verse eid="PSA 109:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3" />Barankikuje bavuga amajambo y’urwanko;</para>
  <para style="q2" vid="PSA 109:3">banteye ata nyanduruko.<verse eid="PSA 109:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4" />Aho kunkunda nk’uko ndabakunda, baranyagiriza,</para>
  <para style="q2" vid="PSA 109:4">ariko ndi umuntu asenga.<verse eid="PSA 109:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5" />Banyishuye ibibi ku vyiza nabakoreye,</para>
  <para style="q2" vid="PSA 109:5">n’urwanko mu gishingo c’urukundo.<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6" />Tuma uwo kugwanya umwansi wanje;</para>
  <para style="q2" vid="PSA 109:6">uwumwagiriza nahagarare i buryo bwiwe.<verse eid="PSA 109:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7" />Niyacirwa urubanza, natsindwe,</para>
  <para style="q2" vid="PSA 109:7">kandi amasengesho yiwe amutsindishe.<verse eid="PSA 109:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8" />Ese imisi yiwe yoba mike;</para>
  <para style="q2" vid="PSA 109:8">agasubirizwa mu mabanga yiwe y’uburongozi.<verse eid="PSA 109:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9" />Ese abana biwe boba impfuvyi</para>
  <para style="q2" vid="PSA 109:9">umugore wiwe na we akaba umupfakazi.<verse eid="PSA 109:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10" />Ese abana biwe bokwama bangara basega;</para>
  <para style="q2" vid="PSA 109:10">bakirukanwa bakava mu mazu yabo yahindutse imisaka.<verse eid="PSA 109:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11" />Ese uwo aheraniye yofata ivyo afise vyose;</para>
  <para style="q2" vid="PSA 109:11">abanyamahanga bagasahura ivyo yaruhiye vyose.<verse eid="PSA 109:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12" />Ese yobura n’umwe amugirira neza</para>
  <para style="q2" vid="PSA 109:12">canke ngo agirire akagongwe impfuvyi ziwe.<verse eid="PSA 109:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13" />Ese uruvyaro rwiwe rwohona,</para>
  <para style="q2" vid="PSA 109:13">amazina yabo agasibanganywa mu bo mu runganwe ruzoza.<verse eid="PSA 109:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14" />Ese ukugabitanya kwa ba sekuruza kwokwibukwa imbere y’<char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 109:14">icaha ca nyina nticigere gisibanganywa.<verse eid="PSA 109:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15" />Ese ivyaha vyabo vyokwama imbere y’<char style="nd">Uhoraho</char> imisi yose,</para>
  <para style="q2" vid="PSA 109:15">kugira ngo asibanganye amazina yabo mw’isi.<verse eid="PSA 109:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16" />Kuko atigeze yiyumvira ivyo kugira neza,</para>
  <para style="q2" vid="PSA 109:16">ariko yababaje umukene gushika ku rupfu</para>
  <para style="q2" vid="PSA 109:16">n’umugorwa n’uwufise umutima umenetse.<verse eid="PSA 109:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17" />Yakunze kuvuma;</para>
  <para style="q2" vid="PSA 109:17">nibimugarukeko.</para>
  <para style="q1" vid="PSA 109:17">Ntiyanezererwa no guhezagira;</para>
  <para style="q2" vid="PSA 109:17">nibibe kure yiwe.<verse eid="PSA 109:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18" />Yambara kuvuma nk’impuzu;</para>
  <para style="q2" vid="PSA 109:18">kwinjiye mu mubiri wiwe nk’amazi,</para>
  <para style="q2" vid="PSA 109:18">no mu magufa yiwe nk’amavuta.<verse eid="PSA 109:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19" />Nikube nk’ikoti izingiriwe kuri we,</para>
  <para style="q2" vid="PSA 109:19">nk’umukanda akenyeje ibihe vyose.<verse eid="PSA 109:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20" />Ivyo nibibe ingero <char style="nd">Uhoraho</char> aha abanyagiriza,</para>
  <para style="q2" vid="PSA 109:20">abamvuga nabi.<verse eid="PSA 109:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21" />Ariko wewe <char style="nd">Uhoraho</char> Nyeninganji,</para>
  <para style="q2" vid="PSA 109:21">ntabara kubera izina ryawe;</para>
  <para style="q2" vid="PSA 109:21">ku bwo kugira neza kw’urukundo rwawe, nkiza.<verse eid="PSA 109:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22" />Kuko ndi umukene n’umugorwa,</para>
  <para style="q2" vid="PSA 109:22">kandi umutima wanje unkomerekeyemwo.<verse eid="PSA 109:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23" />Ndiko ndahera numva kurya kw’igitutu co ku mugoroba;</para>
  <para style="q2" vid="PSA 109:23">bampiga nk’uko bahiga inzige.<verse eid="PSA 109:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24" />Amavi yanje adendebuwe no kwisonzesha;</para>
  <para style="q2" vid="PSA 109:24">umubiri wanje uranyankabiranye kubera kwonda.<verse eid="PSA 109:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25" />Abanyagiriza barancokora;</para>
  <para style="q2" vid="PSA 109:25">iyo bambonye bazunguza imitwe.<verse eid="PSA 109:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26" />Mfasha, <char style="nd">Uhoraho</char> Mana yanje;</para>
  <para style="q2" vid="PSA 109:26">unkize kubera urukundo rwawe rudashira.<verse eid="PSA 109:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27" />Nibamenye ko ari wewe n’ukuboko kwawe</para>
  <para style="q2" vid="PSA 109:27">
    <char style="nd">Uhoraho</char>, ko ari wewe wabikoze.<verse eid="PSA 109:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28" />Nibavuma, wewe urahezagira;</para>
  <para style="q2" vid="PSA 109:28">abantera nibakorwe n’isoni,</para>
  <para style="q2" vid="PSA 109:28">ariko abasavyi bawe nibanezerwe.<verse eid="PSA 109:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29" />Icompa abanyagiriza bakicwa n’isoni</para>
  <para style="q2" vid="PSA 109:29">bakambara ibiteterwe nk’ikoti.<verse eid="PSA 109:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30" />Nzoshira ijwi hejuru nshima <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 109:30">nzomuhimbariza mw’ikoraniro rinini.<verse eid="PSA 109:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31" />Kuko ahagaze i buryo bw’abakene,</para>
  <para style="q2" vid="PSA 109:31">ngo abakize amaboko y’abagomba kubatsindisha.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="cl">Zaburi ya 110</para>
  <para style="d">Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1" />
    <char style="nd">Uhoraho</char> yabariye umwami wanje ati:</para>
  <para style="b" vid="PSA 110:1" />
  <para style="q1" vid="PSA 110:1">“Icara i buryo bwanje</para>
  <para style="q2" vid="PSA 110:1">kugeza abansi bawe bose</para>
  <para style="q2" vid="PSA 110:1">ndabashize musi y’ibirenge vyawe.”<verse eid="PSA 110:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2" />
    <char style="nd">Uhoraho</char> azokuza icumu ry’ubugabe ryawe rihambaye kuva i Siyoni, avuga ati:</para>
  <para style="q2" vid="PSA 110:2">“Ganza hagati y’abansi bawe!”<verse eid="PSA 110:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3" />Ingabo zawe zizoba zifise ugushaka</para>
  <para style="q2" vid="PSA 110:3">ku musi wawe w’intambara.</para>
  <para style="q1" vid="PSA 110:3">Bashazishije ukwera,</para>
  <para style="q2" vid="PSA 110:3">imisore yawe izoza aho uri</para>
  <para style="q2" vid="PSA 110:3">imeze nk’ikime co mu gitondo ka kare.<verse eid="PSA 110:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4" />
    <char style="nd">Uhoraho</char> ararahiye,</para>
  <para style="q2" vid="PSA 110:4">kandi ntazohindura ico yavuze:</para>
  <para style="q1" vid="PSA 110:4">“Uri umuherezi w’ibihe bidashira,</para>
  <para style="q2" vid="PSA 110:4">mu buryo bwa Melekisedeki.”<verse eid="PSA 110:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5" />Uhoraho ari i buryo bwawe;</para>
  <para style="q2" vid="PSA 110:5">azomenagura abami ku musi w’uburake bwiwe.<verse eid="PSA 110:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6" />Azocira urubanza amahanga, arundanye imivyimba</para>
  <para style="q2" vid="PSA 110:6">amenagure abatware bo kw’isi yose.<verse eid="PSA 110:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7" />Azonywa ku mugezi w’iruhande y’inzira,</para>
  <para style="q2" vid="PSA 110:7">uko ni ko azoraramura umutwe wiwe.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="cl">Zaburi ya 111</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1" />Himbaza <char style="nd">Uhoraho</char>.</para>
  <para style="b" vid="PSA 111:1" />
  <para style="q1" vid="PSA 111:1">Nzohimbaza <char style="nd">Uhoraho</char> n’umutima wanje wose</para>
  <para style="q2" vid="PSA 111:1">ndi mw’ikoraniro ry’abatunganye no mu bantu benshi.<verse eid="PSA 111:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2" />Ibikorwa vy’<char style="nd">Uhoraho</char> birahambaye;</para>
  <para style="q2" vid="PSA 111:2">biserangurwa n’ababinezerererwa.<verse eid="PSA 111:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3" />Ivyo akora birakayangana kandi bifise icubahiro,</para>
  <para style="q2" vid="PSA 111:3">kandi ukugororoka kwiwe kwamaho ibihe bidashira.<verse eid="PSA 111:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4" />Yatumye ibitangaza vyiwe vyibukwa;</para>
  <para style="q2" vid="PSA 111:4">
    <char style="nd">Uhoraho</char> ni umunyabuntu kandi agira imbabazi.<verse eid="PSA 111:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5" />Ategekanya ivyokurya ku bamwubaha;</para>
  <para style="q2" vid="PSA 111:5">yibuka isezerano ryiwe ibihe vyose.<verse eid="PSA 111:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6" />Yeretse abantu biwe inkomezi z’ibikorwa vyiwe,</para>
  <para style="q2" vid="PSA 111:6">mu kubegurira igihugu cari ic’ayandi mahanga.<verse eid="PSA 111:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7" />Ibikorwa vy’intoke ziwe ni ivyo kwizigirwa kandi biratunganye;</para>
  <para style="q2" vid="PSA 111:7">ivyo yihanikirije vyose ni ivyo kwizigirwa.<verse eid="PSA 111:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8" />Bihora bihamye ibihe vyose,</para>
  <para style="q2" vid="PSA 111:8">kandi bishinzwe mu kwizigirwa no mu gutungana.<verse eid="PSA 111:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9" />Yateguye gucungurwa ku bantu biwe;</para>
  <para style="q2" vid="PSA 111:9">yashizeho isezerano ryiwe ry’ibihe vyose;</para>
  <para style="q2" vid="PSA 111:9">izina ryiwe ni iryera kandi riteye ubwoba.<verse eid="PSA 111:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10" />Ukwubaha <char style="nd">Uhoraho</char> ni kwo tanguriro ry’ubwenge;</para>
  <para style="q2" vid="PSA 111:10">kandi abitondera ivyo yihanikirije bafise ugutahura gushitse.</para>
  <para style="q2" vid="PSA 111:10">Uguhimbazwa kube ukwiwe ibihe vyose.<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="cl">Zaburi ya 112</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1" />Himbaza <char style="nd">Uhoraho</char>.</para>
  <para style="b" vid="PSA 112:1" />
  <para style="q1" vid="PSA 112:1">Hahiriwe abubaha <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 112:1">bakanezerererwa amabwirizwa yiwe.<verse eid="PSA 112:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2" />Abana babo bazoba abanyenkomezi mu gihugu;</para>
  <para style="q2" vid="PSA 112:2">urunganwe rw’abatunganye ruzogira umugisha.<verse eid="PSA 112:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3" />Ubutunzi n’ibitayega biri mu mazu yabo,</para>
  <para style="q2" vid="PSA 112:3">kandi ukugororoka kwabo kwamaho ibihe bidashira.<verse eid="PSA 112:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4" />No mu mwijima umuco uzotambika ku batunganye,</para>
  <para style="q2" vid="PSA 112:4">ku banyabuntu buzuye imbabazi bagororoka.<verse eid="PSA 112:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5" />Ni vyiza ko umuntu agira ubuntu akagurana abandi,</para>
  <para style="q2" vid="PSA 112:5">akadandaza mu kuri.<verse eid="PSA 112:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6" />Ni ukuri abagororotsi ntibazokwigera banyiganyizwa;</para>
  <para style="q2" vid="PSA 112:6">bazokwibukwa ibihe vyose.<verse eid="PSA 112:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7" />Ntibazotinya inkuru mbi;</para>
  <para style="q2" vid="PSA 112:7">imitima yabo irashikamye, kuko bizigiye <char style="nd">Uhoraho</char>.<verse eid="PSA 112:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8" />Imitima yabo iri amahoro, ntibazotinya;</para>
  <para style="q2" vid="PSA 112:8">kw’iherezo bazokwibonera ukuneshwa kw’abansi babo.<verse eid="PSA 112:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9" />Batanze isabagire ku bakene,</para>
  <para style="q2" vid="PSA 112:9">ukugororoka kwabo kwamaho ibihe bidashira;</para>
  <para style="q2" vid="PSA 112:9">ihembe ryabo rizoshirwa hejuru mu cubahiro.<verse eid="PSA 112:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10" />Abanyakibi bazobibona bababare,</para>
  <para style="q2" vid="PSA 112:10">bazohekenya amenyo baherengetere;</para>
  <para style="q2" vid="PSA 112:10">ivyo abanyakibi bipfuza nta co bizoshikako.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="cl">Zaburi ya 113</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1" />Himbaza <char style="nd">Uhoraho</char>.</para>
  <para style="b" vid="PSA 113:1" />
  <para style="q1" vid="PSA 113:1">Nimuhimbaze <char style="nd">Uhoraho</char>, yemwe basavyi biwe;</para>
  <para style="q2" vid="PSA 113:1">nimuhimbaze izina ry’<char style="nd">Uhoraho</char>.<verse eid="PSA 113:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2" />Izina ry’<char style="nd">Uhoraho</char> nirihimbazwe,</para>
  <para style="q2" vid="PSA 113:2">uhereye ubu ukageza ibihe vyose.<verse eid="PSA 113:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3" />Uhereye iyo izuba riserukira ukageza iyo rirengera,</para>
  <para style="q2" vid="PSA 113:3">izina ry’<char style="nd">Uhoraho</char> rikwiye guhimbazwa.<verse eid="PSA 113:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4" />
    <char style="nd">Uhoraho</char> ashizwe hejuru y’amahanga yose,</para>
  <para style="q2" vid="PSA 113:4">icubahiro ciwe kiri hejuru y’amajuru.<verse eid="PSA 113:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5" />Ni nde ameze nk’<char style="nd">Uhoraho</char> Imana yacu,</para>
  <para style="q2" vid="PSA 113:5">avyagiye ku ntebe y’ubwami iyo mw’ijuru,<verse eid="PSA 113:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6" />yunamishwa no kuraba</para>
  <para style="q2" vid="PSA 113:6">amajuru n’isi?<verse eid="PSA 113:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7" />Akura umugorwa mu mukungugu,</para>
  <para style="q2" vid="PSA 113:7">ashira hejuru umukene, amukuye mu mwavu;<verse eid="PSA 113:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8" />akabicarikana n’abakomeye,</para>
  <para style="q2" vid="PSA 113:8">abakomeye bo mu bantu biwe.<verse eid="PSA 113:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9" />Ashira umugore w’ingumba mu nzu yiwe</para>
  <para style="q2" vid="PSA 113:9">akamugira nyina w’abana ahiriwe.</para>
  <para style="b" vid="PSA 113:9" />
  <para style="q1" vid="PSA 113:9">Himbaza <char style="nd">Uhoraho</char><verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="cl">Zaburi ya 114</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1" />Aho Abisirayeli bava muri Egiputa,</para>
  <para style="q2" vid="PSA 114:1">aho aba Yakobo bava mu bantu b’ururimi rudebagura,<verse eid="PSA 114:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2" />I Buyuda hahindutse ahera h’Imana,</para>
  <para style="q2" vid="PSA 114:2">muri Isirayeli hahindutse ubwami bwiwe.<verse eid="PSA 114:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3" />Ikiyaga carabibonye kirahunga,</para>
  <para style="q2" vid="PSA 114:3">Yorodani rusubira inyuma;<verse eid="PSA 114:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4" />imisozi yarasimvye nk’amapfizi y’intama,</para>
  <para style="q2" vid="PSA 114:4">uturambi na two nk’imyagazi y’intama.<verse eid="PSA 114:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5" />Ni igiki catumye uhunga ga wa kiyaga we?</para>
  <para style="q2" vid="PSA 114:5">Ni kuki wasubiye inyuma, ewe Yorodani?<verse eid="PSA 114:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6" />Ni kuki, yemwe misozi, mwikinye amatavu nk’amapfizi y’intama,</para>
  <para style="q2" vid="PSA 114:6">namwe turambi, nk’imyagazi y’intama?<verse eid="PSA 114:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7" />Wa si we, hindira agashitsi imbere y’Uhoraho,</para>
  <para style="q2" vid="PSA 114:7">imbere y’Imana ya Yakobo,<verse eid="PSA 114:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8" />yahinduye igitandara kiba ikidengeri,</para>
  <para style="q2" vid="PSA 114:8">urutare akaruhinduramwo isoko y’amazi.<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="cl">Zaburi ya 115</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1" />Ntabe ari twebwe, ewe <char style="nd">Uhoraho</char>, ntabe ari twebwe</para>
  <para style="q2" vid="PSA 115:1">ariko icubahiro kibe ic’izina ryawe,</para>
  <para style="q2" vid="PSA 115:1">ku bw’urukundo rwawe n’ubwizigirwa bwawe.<verse eid="PSA 115:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2" />Ni kuki abanyamahanga bavuga bati:</para>
  <para style="q2" vid="PSA 115:2">“Imana yabo iri hehe?”<verse eid="PSA 115:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3" />Imana yacu iri mw’ijuru;</para>
  <para style="q2" vid="PSA 115:3">ikora ibiyihimbara vyose.<verse eid="PSA 115:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4" />Ariko ibigirwamana vyabo ni ifeza n’inzahabu,</para>
  <para style="q2" vid="PSA 115:4">vyakozwe n’intoke z’abantu.<verse eid="PSA 115:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5" />Bifise akanwa, ariko ntibivuga,</para>
  <para style="q2" vid="PSA 115:5">bifise amaso, ariko ntibibona.<verse eid="PSA 115:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6" />Bifise amatwi, ariko ntivyumva,</para>
  <para style="q2" vid="PSA 115:6">bifise amazuru, ariko ntibimoterwa.<verse eid="PSA 115:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7" />Bifise intoke, ariko ntibikorakora,</para>
  <para style="q2" vid="PSA 115:7">bifise ibirenge, ariko ntibigenda,</para>
  <para style="q2" vid="PSA 115:7">kandi ntibishobora gusohora ijwi rivuye mu mihogo yavyo.<verse eid="PSA 115:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8" />Ababicura bazomera nka vyo,</para>
  <para style="q2" vid="PSA 115:8">co kimwe n’abavyizigira bose.<verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9" />Ewe Isirayeli, nimwizigire <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 115:9">ni we mutabazi wawe n’inkinzo yawe.<verse eid="PSA 115:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10" />Ab’inzu ya Aroni nimwizigire <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 115:10">ni we mutabazi wanyu n’inkinzo yanyu.<verse eid="PSA 115:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11" />Yemwe abamwubaha mwese, nimwizigire <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 115:11">ni we mutabazi wanyu n’inkinzo yanyu.<verse eid="PSA 115:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12" />
    <char style="nd">Uhoraho</char> aratwibuka kandi azoduha umugisha:</para>
  <para style="q2" vid="PSA 115:12">azoha umugisha abantu biwe ba Isirayeli,</para>
  <para style="q2" vid="PSA 115:12">azoha umugisha inzu ya Aroni,<verse eid="PSA 115:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13" />azoha umugisha abubaha <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 115:13">aboroshe n’abahambaye.<verse eid="PSA 115:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14" />
    <char style="nd">Uhoraho</char> naguhe gusagarara,</para>
  <para style="q2" vid="PSA 115:14">wewe n’abana bawe.<verse eid="PSA 115:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15" />Uragahabwa umugisha n’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 115:15">Umuremyi w’ijuru n’isi.<verse eid="PSA 115:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16" />Ijuru risumba ayandi ni iry’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 115:16">ariko isi yayihaye abana b’abantu.<verse eid="PSA 115:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17" />Si abapfuye bazohimbaza <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 115:17">abamanuka baja ahantu h’agacerere;<verse eid="PSA 115:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18" />ni twebwe tuzoshira hejuru <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 115:18">uhereye none ukageza ibihe vyose.</para>
  <para style="b" vid="PSA 115:18" />
  <para style="q1" vid="PSA 115:18">Himbaza <char style="nd">Uhoraho</char>.<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="cl">Zaburi ya 116</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1" />Nkunda <char style="nd">Uhoraho</char>, kuko yumvise ijwi ryanje;</para>
  <para style="q2" vid="PSA 116:1">yumvise ugutakamba kwanje.<verse eid="PSA 116:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2" />Kuko yanteze ugutwi,</para>
  <para style="q2" vid="PSA 116:2">nzomwambaza igihe cose nzoba nkiriho.<verse eid="PSA 116:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3" />Imigozi y’urupfu yaranyizingiriyeko,</para>
  <para style="q2" vid="PSA 116:3">umubabaro wo mu mva warandenze;</para>
  <para style="q2" vid="PSA 116:3">narengewe n’umubabaro n’agahinda.<verse eid="PSA 116:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4" />Maze nambaza izina ry’<char style="nd">Uhoraho</char> nti:</para>
  <para style="q2" vid="PSA 116:4">“<char style="nd">Uhoraho</char>, nkiza!”<verse eid="PSA 116:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5" />
    <char style="nd">Uhoraho</char> ni umunyabuntu kandi aragororotse;</para>
  <para style="q2" vid="PSA 116:5">Imana yacu yuzuye imbabazi.<verse eid="PSA 116:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6" />
    <char style="nd">Uhoraho</char> azigama ba nyarucari;</para>
  <para style="q2" vid="PSA 116:6">aho nacishwa bugufi, yarantabaye.<verse eid="PSA 116:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7" />Mutima wanje, subira utekane,</para>
  <para style="q2" vid="PSA 116:7">kuko <char style="nd">Uhoraho</char> yakugiriye neza.<verse eid="PSA 116:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8" />Kuko wewe <char style="nd">Uhoraho</char>, wankuye mu rupfu,</para>
  <para style="q2" vid="PSA 116:8">amaso yanje ukayakiza kurira,</para>
  <para style="q2" vid="PSA 116:8">ibirenge vyanje ukabikiza gutsitara,<verse eid="PSA 116:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9" />kugira ngo ngendere imbere y’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 116:9">mw’isi y’abazima.<verse eid="PSA 116:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10" />Nari nizigiye <char style="nd">Uhoraho</char> aho navuga nti:</para>
  <para style="q2" vid="PSA 116:10">“Ndababajwe cane”;<verse eid="PSA 116:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11" />mu mubabaro wanje naravuze nti:</para>
  <para style="q2" vid="PSA 116:11">“Abantu bose ni ababeshi.”<verse eid="PSA 116:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12" />
    <char style="nd">Uhoraho</char> nzomwitura iki</para>
  <para style="q2" vid="PSA 116:12">ku vyiza vyose yankoreye?<verse eid="PSA 116:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13" />Nzoshira hejuru igikombe c’agakiza</para>
  <para style="q2" vid="PSA 116:13">nambaze izina ry’<char style="nd">Uhoraho</char>.<verse eid="PSA 116:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14" />Nzoshitsa ivyo nasezeraniye <char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 116:14">imbere y’abantu biwe.<verse eid="PSA 116:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15" />Mu nyonga z’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 116:15">Urupfu rw’abizigirwa biwe ni urw’igiciro.<verse eid="PSA 116:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16" />Vy’ukuri ndi umusavyi wawe, <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 116:16">ndagukorera nk’uko mama yabikora;</para>
  <para style="q2" vid="PSA 116:16">wankuye mu minyororo narimwo.<verse eid="PSA 116:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17" />Nzogushikanira ikimazi co gushima</para>
  <para style="q2" vid="PSA 116:17">nambaze izina ry’<char style="nd">Uhoraho</char>.<verse eid="PSA 116:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18" />Nzoshitsa ivyo nasezeraniye <char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 116:18">mu maso y’abantu biwe,<verse eid="PSA 116:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19" />mu birimba vy’Ingoro yawe, <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 116:19">hagati muri wewe, Yerusalemu.</para>
  <para style="b" vid="PSA 116:19" />
  <para style="q1" vid="PSA 116:19">Himbaza <char style="nd">Uhoraho</char>.<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="cl">Zaburi ya 117</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1" />Nimuhimbaze <char style="nd">Uhoraho</char>, yemwe mahanga mwese;</para>
  <para style="q2" vid="PSA 117:1">mumushire hejuru, namwe moko yose.<verse eid="PSA 117:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2" />Kuko urukundo adukunda ari rwinshi,</para>
  <para style="q2" vid="PSA 117:2">kandi ukwizigirwa kw’<char style="nd">Uhoraho</char> kwamaho ibihe vyose.</para>
  <para style="b" vid="PSA 117:2" />
  <para style="q1" vid="PSA 117:2">Himbaza <char style="nd">Uhoraho</char>.<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="cl">Zaburi ya 118</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1" />Nimushime <char style="nd">Uhoraho</char> kuko ari mwiza;</para>
  <para style="q2" vid="PSA 118:1">Kuko urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 118:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2" />Abisirayeli nibavuge bati:</para>
  <para style="q2" vid="PSA 118:2">“Urukundo rwiwe rwamaho ibihe bidashira.”<verse eid="PSA 118:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3" />Ab’inzu ya Aroni nibavuge bati:</para>
  <para style="q2" vid="PSA 118:3">“Urukundo rwiwe rwamaho ibihe bidashira.”<verse eid="PSA 118:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4" />Abubaha <char style="nd">Uhoraho</char> nibavuge bati:</para>
  <para style="q2" vid="PSA 118:4">“Urukundo rwiwe rwamaho ibihe bidashira.”<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5" />Igihe nari nzigirijwe, natakambiye <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 118:5">aca anshira ahagutse.<verse eid="PSA 118:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6" />
    <char style="nd">Uhoraho</char> ari kumwe nanje; sinzotinya.</para>
  <para style="q2" vid="PSA 118:6">None abantu buntu bongira iki?<verse eid="PSA 118:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7" />
    <char style="nd">Uhoraho</char> ari kumwe nanje; ni we mutabazi wanje.</para>
  <para style="q2" vid="PSA 118:7">Ni co gituma nzokwibonera ukuneshwa kw’abansi banje.<verse eid="PSA 118:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8" />Ni vyiza guhungira k’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 118:8">kuruta kwizigira abana b’abantu.<verse eid="PSA 118:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9" />Ni vyiza guhungira k’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 118:9">kuruta kwizigira abashizwe hejuru.<verse eid="PSA 118:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10" />Amahanga yose yarankikuje,</para>
  <para style="q2" vid="PSA 118:10">ariko mw’izina ry’<char style="nd">Uhoraho</char> ndayarandura.<verse eid="PSA 118:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11" />Yankikuje impande zose,</para>
  <para style="q2" vid="PSA 118:11">ariko mw’izina ry’<char style="nd">Uhoraho</char> ndayarandura.<verse eid="PSA 118:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />Yarankikuje nk’inzuki,</para>
  <para style="q2" vid="PSA 118:12">ariko batongotse vuba nk’umuriro w’amahwa;</para>
  <para style="q2" vid="PSA 118:12">mw’izina ry’<char style="nd">Uhoraho</char> ndabarandura.<verse eid="PSA 118:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />Narasunitswe nsubizwa inyuma ngera hafi yo gutemba,</para>
  <para style="q2" vid="PSA 118:13">ariko <char style="nd">Uhoraho</char> arantabara.<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />
    <char style="nd">Uhoraho</char> ni we nkomezi zanje n’indirimbo yanje;</para>
  <para style="q2" vid="PSA 118:14">yampindukiye agakiza.<verse eid="PSA 118:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />Impundu z’umunezero n’intsinzi</para>
  <para style="q2" vid="PSA 118:15">zirumvikana mu mahema y’abagororotsi ngo:</para>
  <para style="q1" vid="PSA 118:15">“Ukuboko kw’i buryo kw’<char style="nd">Uhoraho</char> kwakoze ivy’inkomezi!<verse eid="PSA 118:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 118:16" />Ukuboko kw’i buryo kw’<char style="nd">Uhoraho</char> gushizwe hejuru;</para>
  <para style="q2" vid="PSA 118:16">ukuboko kw’i buryo kw’<char style="nd">Uhoraho</char> kwakoze ibikomeye!”<verse eid="PSA 118:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />Sinzopfa ariko nzobaho,</para>
  <para style="q2" vid="PSA 118:17">maze nzokwamamaza ivyo <char style="nd">Uhoraho</char> yakoze.<verse eid="PSA 118:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />
    <char style="nd">Uhoraho</char> yarampanye bikomeye,</para>
  <para style="q2" vid="PSA 118:18">ariko ntiyandekuriye mu maboko y’urupfu.<verse eid="PSA 118:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />Nyugururira amarembo y’abagororotsi;</para>
  <para style="q2" vid="PSA 118:19">nzokwinjira maze nshimire <char style="nd">Uhoraho</char>.<verse eid="PSA 118:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />Iri ni irembo ry’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 118:20">iryo abagororotsi bakwiye kwinjiramwo.<verse eid="PSA 118:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />Nzogushima, kuko wanyishuye;</para>
  <para style="q2" vid="PSA 118:21">wampindukiye agakiza.<verse eid="PSA 118:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />Ibuye abubatsi bagaye</para>
  <para style="q2" vid="PSA 118:22">ni ryo ryahindutse irigumya imfuruka;<verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />
    <char style="nd">Uhoraho</char> ni we yabikoze,</para>
  <para style="q2" vid="PSA 118:23">kandi ni igitangaza mu maso yacu.<verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />
    <char style="nd">Uhoraho</char> yabikoze kuri uwu musi nyene;</para>
  <para style="q2" vid="PSA 118:24">tunezerwe uwu musi kandi duhimbarwe.<verse eid="PSA 118:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />
    <char style="nd">Uhoraho</char> we, dukize!</para>
  <para style="q2" vid="PSA 118:25">
    <char style="nd">Uhoraho</char> we, duhe intsinzi!<verse eid="PSA 118:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />Harahezagiwe uwuje mw’izina ry’<char style="nd">Uhoraho</char>.</para>
  <para style="q2" vid="PSA 118:26">Turabahezagiye turi mu Ngoro y’<char style="nd">Uhoraho</char>.<verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />
    <char style="nd">Uhoraho</char> ni Imana,</para>
  <para style="q2" vid="PSA 118:27">kandi yatumye umuco wiwe udukayanganira.</para>
  <para style="q1" vid="PSA 118:27">Dufate amashami mu ntoke, tuje mu rugendo</para>
  <para style="q2" vid="PSA 118:27">rudushikana ku mahembe y’igicaniro.<verse eid="PSA 118:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />Uri Imana yanje, nanje nzoguhimbaza;</para>
  <para style="q2" vid="PSA 118:28">uri Imana yanje, nanje nzogushira hejuru.<verse eid="PSA 118:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />Nimushime <char style="nd">Uhoraho</char> kuko ari mwiza;</para>
  <para style="q2" vid="PSA 118:29">kuko urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="cl">Zaburi ya 119</para>
  <para style="qa">Alefu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />Hahiriwe abatunganye mu nzira zabo,</para>
  <para style="q2" vid="PSA 119:1">bagenda bisunga Ivyagezwe vy’<char style="nd">Uhoraho</char>.<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />Hahiriwe abitondera ivyo yihanikirije,</para>
  <para style="q2" vid="PSA 119:2">bakamuronderana umutima wabo wose;<verse eid="PSA 119:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3" />ntibakora ibibi,</para>
  <para style="q2" vid="PSA 119:3">ariko bagakurikira inzira ziwe.<verse eid="PSA 119:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4" />Washizeho ivyo wihanikirije</para>
  <para style="q2" vid="PSA 119:4">kugira ngo abantu bavyitondere.<verse eid="PSA 119:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5" />Icompa inzira zanje zigatumbera</para>
  <para style="q2" vid="PSA 119:5">mu kwitondera ivyo washinze!<verse eid="PSA 119:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6" />Aho ni ho ntazomaramara</para>
  <para style="q2" vid="PSA 119:6">ninashira umutima ku mabwirizwa yawe.<verse eid="PSA 119:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7" />Nzogutazira n’umutima utunganye</para>
  <para style="q2" vid="PSA 119:7">uko nzokwiga ivyagezwe vyawe bigororotse.<verse eid="PSA 119:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8" />Nzokwumvira amategeko yawe;</para>
  <para style="q2" vid="PSA 119:8">ntumpebe rwose!<verse eid="PSA 119:8" /></para>
  <para style="qa">Beti</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9" />Ni gute umusore yoshobora kuguma mu nzira y’ugutungana?</para>
  <para style="q2" vid="PSA 119:9">Ni mu kubaho nk’uko ijambo ryawe rivuga.<verse eid="PSA 119:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10" />Nzokuronderana umutima wanje wose;</para>
  <para style="q2" vid="PSA 119:10">ntuze undeke ngo mve mu mabwirizwa yawe.<verse eid="PSA 119:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11" />Nabitse ijambo ryawe mu mutima wanje</para>
  <para style="q2" vid="PSA 119:11">kugira ngo sindagucumureko.<verse eid="PSA 119:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12" />Uhimbazwe, <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 119:12">unyigishe ivyo wihanikirije.<verse eid="PSA 119:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13" />Iminwa yanje isubiramwo</para>
  <para style="q2" vid="PSA 119:13">ivyagezwe vyose biva mu kanwa kawe.<verse eid="PSA 119:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14" />Jewe nezererwa kwitondera ivyo washinze</para>
  <para style="q2" vid="PSA 119:14">nk’uko umuntu anezererwa ubutunzi bwinshi.<verse eid="PSA 119:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15" />Jewe ndimbura ivyo wihanikirije</para>
  <para style="q2" vid="PSA 119:15">kandi nshira umutima ku nzira zawe.<verse eid="PSA 119:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16" />Jewe mpimbarwa n’ivyo washinze;</para>
  <para style="q2" vid="PSA 119:16">sinzokengera ijambo ryawe.<verse eid="PSA 119:16" /></para>
  <para style="qa">Gimeli</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17" />Girira neza umusavyi wawe umwanya nkiriho,</para>
  <para style="q2" vid="PSA 119:17">kugira ngo numvire ijambo ryawe.<verse eid="PSA 119:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18" />Humura amaso yanje kugira ngo mbone</para>
  <para style="q2" vid="PSA 119:18">ibitangaza vyo mu Vyagezwe vyawe.<verse eid="PSA 119:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19" />Ndi inyambukira kw’isi;</para>
  <para style="q2" vid="PSA 119:19">ntumpishe amabwirizwa yawe.<verse eid="PSA 119:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20" />Umutima wanje umazwe no kwipfuza</para>
  <para style="q2" vid="PSA 119:20">ivyagezwe vyawe ibihe vyose.<verse eid="PSA 119:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21" />Ukankamira abibone, bariko umuvumo,</para>
  <para style="q2" vid="PSA 119:21">abazimira bakava mu mabwirizwa yawe.<verse eid="PSA 119:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22" />Unkureko agacokoro n’agakengerwe,</para>
  <para style="q2" vid="PSA 119:22">kuko nitondera ivyo wihanikirije.<verse eid="PSA 119:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23" />Naho abatware bicara hamwe ngo bamvuge nabi,</para>
  <para style="q2" vid="PSA 119:23">umusavyi wawe nzorimbura amategeko yawe.<verse eid="PSA 119:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24" />Ivyo wihanikirije ni vyo bimpimbara;</para>
  <para style="q2" vid="PSA 119:24">ni vyo bingira inama.<verse eid="PSA 119:24" /></para>
  <para style="qa">Daleti</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25" />Ndyamye hasi mu mukungugu;</para>
  <para style="q2" vid="PSA 119:25">zigama ubugingo bwanje nk’uko ijambo ryawe ryavuze.<verse eid="PSA 119:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26" />Nakwiganiye ivy’inzira zanje, nawe uranyishura;</para>
  <para style="q2" vid="PSA 119:26">nyigisha amategeko yawe.<verse eid="PSA 119:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27" />Mpa gutahura inzira y’ivyo wihanikirije,</para>
  <para style="q2" vid="PSA 119:27">kugira ngo ndimbure ku vyo wakoze bihambaye.<verse eid="PSA 119:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28" />Umutima wanje uremerewe n’umubabaro;</para>
  <para style="q2" vid="PSA 119:28">nkomeza nk’uko ijambo ryawe ryavuze.<verse eid="PSA 119:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29" />Nshira kure y’inzira z’ubugunge,</para>
  <para style="q2" vid="PSA 119:29">ngirira ubuntu unyigishe Ivyagezwe vyawe.<verse eid="PSA 119:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30" />Nahisemwo inzira z’ukwizigirwa;</para>
  <para style="q2" vid="PSA 119:30">umutima wanje nawushize ku vyagezwe vyawe.<verse eid="PSA 119:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31" />Jewe numira ku vyo wihanikirije, ewe <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 119:31">ntuze undeke ngo maramare.<verse eid="PSA 119:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32" />Niruka mu nzira y’amabwirizwa yawe,</para>
  <para style="q2" vid="PSA 119:32">kuko waguye ugutahura kwanje.<verse eid="PSA 119:32" /></para>
  <para style="qa">He</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33" />
    <char style="nd">Uhoraho</char>, nyigisha inzira z’ivyo wihanikirije,</para>
  <para style="q2" vid="PSA 119:33">kugira ngo ndazikurikire gushika kw’iherezo.<verse eid="PSA 119:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34" />Numpe ugutahura, kugira ngo nitondere Ivyagezwe vyawe</para>
  <para style="q2" vid="PSA 119:34">kandi ngo ndavyitondere n’umutima wanje wose.<verse eid="PSA 119:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35" />Ntumbereza mu nzira y’amabwirizwa yawe,</para>
  <para style="q2" vid="PSA 119:35">kuko aho ari ho mpimbarirwa.<verse eid="PSA 119:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36" />Hindukiriza umutima wanje ku vyo wihanikirije</para>
  <para style="q2" vid="PSA 119:36">ndawukure ku vy’inyungu mbi.<verse eid="PSA 119:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37" />Hindukiriza amaso yanje kure y’ibitagira ikimazi;</para>
  <para style="q2" vid="PSA 119:37">uzigame ubugingo bwanje nk’uko ijambo ryawe rivuga.<verse eid="PSA 119:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38" />Shitsa isezerano ryawe ku musavyi wawe,</para>
  <para style="q2" vid="PSA 119:38">kugira ngo wubahwe.<verse eid="PSA 119:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39" />Shira kure ibiteterwe ntinya,</para>
  <para style="q2" vid="PSA 119:39">kuko ivyagezwe vyawe ari vyiza.<verse eid="PSA 119:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40" />Mbega ukuntu nipfuza ivyo washinze!</para>
  <para style="q2" vid="PSA 119:40">Uzigamire ubugingo bwanje mu kugororoka kwawe.<verse eid="PSA 119:40" /></para>
  <para style="qa">Wawu</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41" />Icompa urukundo rwawe rudashira rukanzako, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 119:41">n’agakiza kawe, nk’uko isezerano ryawe rivuga;<verse eid="PSA 119:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42" />ni ho nzoshobora kwishura uwunkengereye wese,</para>
  <para style="q2" vid="PSA 119:42">kuko nizigira ijambo ryawe.<verse eid="PSA 119:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43" />Ntuze wigere ukura ijambo ryawe ry’ukuri mu kanwa kanje,</para>
  <para style="q2" vid="PSA 119:43">kuko ivyizigiro vyanje nabishize mu vyagezwe vyawe.<verse eid="PSA 119:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44" />Nzokwama nitondera Ivyagezwe vyawe,</para>
  <para style="q2" vid="PSA 119:44">ibihe n’ibihe.<verse eid="PSA 119:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45" />Nzogendera mu mwidegemvyo,</para>
  <para style="q2" vid="PSA 119:45">kuko nize ivyo wihanikirije.<verse eid="PSA 119:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46" />Nzovuga ivyo wigishije imbere y’abami</para>
  <para style="q2" vid="PSA 119:46">kandi ntibizomaramaza,<verse eid="PSA 119:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47" />kuko nezererwa amabwirizwa yawe,</para>
  <para style="q2" vid="PSA 119:47">kandi ndayakunda.<verse eid="PSA 119:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48" />Ntuma amaboko yanje amabwirizwa yawe nkunda,</para>
  <para style="q2" vid="PSA 119:48">kugira ngo ndimbure ku vyo washinze.<verse eid="PSA 119:48" /></para>
  <para style="qa">Zayini</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49" />Wibuke ijambo wabwiye umusavyi wawe,</para>
  <para style="q2" vid="PSA 119:49">kuko wampaye ivyizigiro.<verse eid="PSA 119:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50" />Ikindemesha mu mubabaro wanje ni iki:</para>
  <para style="q2" vid="PSA 119:50">Isezerano ryawe rizigama ubugingo bwanje.<verse eid="PSA 119:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51" />Abibone barancokora ata kigongwe,</para>
  <para style="q2" vid="PSA 119:51">ariko simva mu Vyagezwe vyawe.<verse eid="PSA 119:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52" />
    <char style="nd">Uhoraho</char>, nibuka ivyagezwe vyawe vya kera,</para>
  <para style="q2" vid="PSA 119:52">maze bikandemesha.<verse eid="PSA 119:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53" />Ndababara cane kubera abanyakibi,</para>
  <para style="q2" vid="PSA 119:53">kuko bahevye Ivyagezwe vyawe.<verse eid="PSA 119:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54" />Ivyo washinze ni vyo shimikiro ry’indirimbo yanje</para>
  <para style="q2" vid="PSA 119:54">aho ndi hose nk’ingenzi.<verse eid="PSA 119:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55" />
    <char style="nd">Uhoraho</char> we, mw’ijoro nibuka izina ryawe,</para>
  <para style="q2" vid="PSA 119:55">kugira ngo ngumye Ivyagezwe vyawe.<verse eid="PSA 119:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56" />Ng’iki ico nagize umwuga:</para>
  <para style="q2" vid="PSA 119:56">ni ukwitondera ivyo wihanikirije.<verse eid="PSA 119:56" /></para>
  <para style="qa">Heti</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57" />
    <char style="nd">Uhoraho</char>, ni wewe mugabane wanje;</para>
  <para style="q2" vid="PSA 119:57">nasezeranye kwumvira amajambo yawe.<verse eid="PSA 119:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58" />Narondeye mu nyonga hawe n’umutima wanje wose;</para>
  <para style="q2" vid="PSA 119:58">ngirira ubuntu nk’uko wasezeranye.<verse eid="PSA 119:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59" />Niyumviriye ku nzira zanje</para>
  <para style="q2" vid="PSA 119:59">kandi nahindukirije intambuko zanje ku vyo wihanikirije.<verse eid="PSA 119:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60" />Nzokwihuta kandi sinzotebagana</para>
  <para style="q2" vid="PSA 119:60">kwitondera amabwirizwa yawe.<verse eid="PSA 119:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61" />Naho abanyakibi bombohesha ibiziriko,</para>
  <para style="q2" vid="PSA 119:61">sinzokwibagira Ivyagezwe vyawe.<verse eid="PSA 119:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62" />Igicugu kigeze hagati nzovyuka ndagushimire</para>
  <para style="q2" vid="PSA 119:62">ku bw’ivyagezwe vyawe bigororotse.<verse eid="PSA 119:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63" />Ndi incuti y’abakwubaha bose,</para>
  <para style="q2" vid="PSA 119:63">abakurikira ivyo wihanikirije bose.<verse eid="PSA 119:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64" />Isi yuzuye urukundo rwawe, <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 119:64">nyigisha amategeko yawe.<verse eid="PSA 119:64" /></para>
  <para style="qa">Teti</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65" />Wagiriye neza umusavyi wawe</para>
  <para style="q2" vid="PSA 119:65">nk’uko ijambo ryawe rivuga, <char style="nd">Uhoraho</char>.<verse eid="PSA 119:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66" />Nyigisha ukumenya n’uguca iziroranye,</para>
  <para style="q2" vid="PSA 119:66">kuko nizigiye amabwirizwa yawe.<verse eid="PSA 119:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67" />Imbere yuko mbabazwa narazimiye,</para>
  <para style="q2" vid="PSA 119:67">ariko ubu nitondera ijambo ryawe.<verse eid="PSA 119:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68" />Uri mwiza, kandi n’ivyo ukora ni vyiza;</para>
  <para style="q2" vid="PSA 119:68">nyigisha amategeko yawe.<verse eid="PSA 119:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69" />Naho abibone banyambitse ibara bambeshera,</para>
  <para style="q2" vid="PSA 119:69">nitondera ivyo wihanikirije n’umutima wanje wose.<verse eid="PSA 119:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70" />Imitima yabo yarakomantaye nta co yumva,</para>
  <para style="q2" vid="PSA 119:70">ariko jeho mpimbarwa n’Ivyagezwe vyawe.<verse eid="PSA 119:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71" />Vyabaye vyiza kuri jewe kubabazwa</para>
  <para style="q2" vid="PSA 119:71">kugira ngo nige amategeko yawe.<verse eid="PSA 119:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72" />Ivyagezwe vyo mu kanwa kawe bindutira</para>
  <para style="q2" vid="PSA 119:72">ibihumbi vy’ifeza n’inzahabu.<verse eid="PSA 119:72" /></para>
  <para style="qa">Yodi</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73" />Intoke zawe ni zo zandemye zirambumba;</para>
  <para style="q2" vid="PSA 119:73">numpe ugutahura ngo nige amabwirizwa yawe.<verse eid="PSA 119:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74" />Abakwubaha baze banezerwe nibambona,</para>
  <para style="q2" vid="PSA 119:74">kuko nizigiye ijambo ryawe.<verse eid="PSA 119:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75" />
    <char style="nd">Uhoraho</char>, ndazi ko ivyagezwe vyawe bigororotse,</para>
  <para style="q2" vid="PSA 119:75">kandi ko mu bwizigirwa bwawe wandetse ngo mbabazwe.<verse eid="PSA 119:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76" />Icompa urukundo rwawe rukandemesha,</para>
  <para style="q2" vid="PSA 119:76">nk’uko wasezeraniye umusavyi wawe.<verse eid="PSA 119:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77" />Imbabazi zawe nizinzeko kugira ngo mbeho,</para>
  <para style="q2" vid="PSA 119:77">kuko Ivyagezwe vyawe ari vyo bimpimbara.<verse eid="PSA 119:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78" />Abibone nibamaramare kuko bangiriye nabi ata nyanduruko;</para>
  <para style="q2" vid="PSA 119:78">ariko nzorimbura ivyo washinze.<verse eid="PSA 119:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79" />Abakwubaha nibampindukirire,</para>
  <para style="q2" vid="PSA 119:79">abatahura ivyo wihanikirije.<verse eid="PSA 119:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80" />Ese icompa ngakurikira amategeko yawe n’umutima wose,</para>
  <para style="q2" vid="PSA 119:80">kugira ngo sinze maramare.<verse eid="PSA 119:80" /></para>
  <para style="qa">Kafu</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81" />Umutima wanje uciwe intege no kwipfuza agakiza kawe,</para>
  <para style="q2" vid="PSA 119:81">ariko nizigiye ijambo ryawe.<verse eid="PSA 119:81" /></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82" />Amaso yanje ararushe, ariko ararondera isezerano ryawe;</para>
  <para style="q2" vid="PSA 119:82">ndavuga nti: “mbega uzompoza ryari?”<verse eid="PSA 119:82" /></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83" />Naho meze nk’umukuza w’urusato mu mwotsi,</para>
  <para style="q2" vid="PSA 119:83">sinibagira amategeko yawe.<verse eid="PSA 119:83" /></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84" />Umusavyi wawe azogeza hehe kurindira?</para>
  <para style="q2" vid="PSA 119:84">Uzohana abampama ryari?<verse eid="PSA 119:84" /></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85" />Abibone bimvye ibinogo ngo bantege,</para>
  <para style="q2" vid="PSA 119:85">binyuranye n’Ivyagezwe vyawe.<verse eid="PSA 119:85" /></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86" />Amabwirizwa yawe yose ni ayo kwizerwa;</para>
  <para style="q2" vid="PSA 119:86">ntabara, kuko ndiko ndahamwa ata nyanduruko.<verse eid="PSA 119:86" /></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87" />Hari hasigaye gato bakankura kw’isi,</para>
  <para style="q2" vid="PSA 119:87">ariko sinahevye ivyo washinze.<verse eid="PSA 119:87" /></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88" />Mu rukundo rwawe rudashira zigama ubugingo bwanje</para>
  <para style="q2" vid="PSA 119:88">kugira ngo nitondere ivyo wihanikirije n’akanwa kawe.<verse eid="PSA 119:88" /></para>
  <para style="qa">Lamedi</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89" />Ijambo ryawe, <char style="nd">Uhoraho</char>, ni iry’ibihe vyose;</para>
  <para style="q2" vid="PSA 119:89">rihora rihamye mw’ijuru.<verse eid="PSA 119:89" /></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90" />Ukwizigirwa kwawe guhoraho uko urunganwe rukurikirana n’urundi;</para>
  <para style="q2" vid="PSA 119:90">washizeho isi, kandi izokwamaho.<verse eid="PSA 119:90" /></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91" />Ivyagezwe vyawe bihoraho kugeza uwu musi,</para>
  <para style="q2" vid="PSA 119:91">kuko vyose bigukorera.<verse eid="PSA 119:91" /></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92" />Iyo ntanezerererwa Ivyagezwe vyawe,</para>
  <para style="q2" vid="PSA 119:92">mba narahitanywe n’umubabaro wanje.<verse eid="PSA 119:92" /></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93" />Sinzokwigera nibagira ivyo wihanikirije,</para>
  <para style="q2" vid="PSA 119:93">kuko ari vyo wazigamishije ubugingo bwanje.<verse eid="PSA 119:93" /></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94" />Unkize kuko ndi uwawe;</para>
  <para style="q2" vid="PSA 119:94">narondeye ivyo washinze.<verse eid="PSA 119:94" /></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95" />Abanyakibi babundiye kunyica,</para>
  <para style="q2" vid="PSA 119:95">ariko nzozigama ivyagezwe vyawe.<verse eid="PSA 119:95" /></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96" />Ibitunganye vyose bifise aho bigarukira,</para>
  <para style="q2" vid="PSA 119:96">ariko amabwirizwa yawe ntagira akarimbi.<verse eid="PSA 119:96" /></para>
  <para style="qa">Memu</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97" />Ese ukuntu nkunda Ivyagezwe vyawe!</para>
  <para style="q2" vid="PSA 119:97">Ndabirimbura bukarinda bwira.<verse eid="PSA 119:97" /></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98" />Amabwirizwa yawe yamana nanje</para>
  <para style="q2" vid="PSA 119:98">antera kuba umunyabwenge kuruta abansi banje.<verse eid="PSA 119:98" /></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99" />Mfise ugutahura kurusha abanyigishije,</para>
  <para style="q2" vid="PSA 119:99">kuko ndimbura ivyo washinze.<verse eid="PSA 119:99" /></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100" />Mfise ugutahura kurengeye abahumure,</para>
  <para style="q2" vid="PSA 119:100">kuko nubaha ivyo wihanikirije.<verse eid="PSA 119:100" /></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101" />Narinze ibirenge vyanje ngo ntibije mu nzira mbi zose</para>
  <para style="q2" vid="PSA 119:101">kugira ngo nitondere ijambo ryawe.<verse eid="PSA 119:101" /></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102" />Sinavuye mu vyagezwe vyawe,</para>
  <para style="q2" vid="PSA 119:102">kuko ubwawe ari wewe wanyigishije.<verse eid="PSA 119:102" /></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103" />Ese ukuntu amajambo yawe ansosera mu kanwa,</para>
  <para style="q2" vid="PSA 119:103">mu kanwa kanje asosa kurusha ubuki!<verse eid="PSA 119:103" /></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104" />Nunguka ugutahura kuvuye mu vyo washinze;</para>
  <para style="q2" vid="PSA 119:104">ni co gituma nanka inzira zose mbi.<verse eid="PSA 119:104" /></para>
  <para style="qa">Nuni</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105" />Ijambo ryawe ni itara rimurikira ibirenge vyanje,</para>
  <para style="q2" vid="PSA 119:105">ni umuco umurikira mu nzira yanje.<verse eid="PSA 119:105" /></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106" />Nararahiye ndisiba,</para>
  <para style="q2" vid="PSA 119:106">ko nzokurikiza ivyagezwe vyawe bigororotse.<verse eid="PSA 119:106" /></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107" />Narababajwe bikomeye;</para>
  <para style="q2" vid="PSA 119:107">zigama ubugingo bwanje, <char style="nd">Uhoraho</char>, nk’uko ijambo ryawe ryavuze.<verse eid="PSA 119:107" /></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108" />
    <char style="nd">Uhoraho</char>, akira uguhimbaza kw’akanwa kanje kuvuye ku mutima,</para>
  <para style="q2" vid="PSA 119:108">maze unyigishe ivyagezwe vyawe.<verse eid="PSA 119:108" /></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109" />Naho ngendera hafi y’urupfu,</para>
  <para style="q2" vid="PSA 119:109">sinzokwibagira Ivyagezwe vyawe.<verse eid="PSA 119:109" /></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110" />Abanyakibi banteze umutego,</para>
  <para style="q2" vid="PSA 119:110">ariko sinazimiye ngo mve mu vyo washinze.<verse eid="PSA 119:110" /></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111" />Ivyo wihanikirije ni vyo mugabane wanje ibihe vyose;</para>
  <para style="q2" vid="PSA 119:111">ni vyo binezereza umutima wanje.<verse eid="PSA 119:111" /></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112" />Umutima wanje unezerwa no kwitondera amategeko yawe</para>
  <para style="q2" vid="PSA 119:112">gushika no kw’iherezo.<verse eid="PSA 119:112" /></para>
  <para style="qa">Sameki</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113" />Ndanka abantu b’imitima ibiri,</para>
  <para style="q2" vid="PSA 119:113">ariko nkunda Ivyagezwe vyawe.<verse eid="PSA 119:113" /></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114" />Ni wewe buhungiro bwanje n’inkinzo yanje;</para>
  <para style="q2" vid="PSA 119:114">nashize ivyizigiro vyanje mw’ijambo ryawe.<verse eid="PSA 119:114" /></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115" />Nimumve i ruhande, mwa nkozi z’ibibi mwe,</para>
  <para style="q2" vid="PSA 119:115">kugira ngo nitondere amabwirizwa y’Imana yanje!<verse eid="PSA 119:115" /></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116" />Nshigikira, ewe Mana yanje, nk’uko isezerano ryawe rivuga, ni ho nzobaho;</para>
  <para style="q2" vid="PSA 119:116">ntureke ivyizigiro vyanje ngo bibe ivy’impfagusa.<verse eid="PSA 119:116" /></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117" />Unshigikire, ni ho nzotabarwa;</para>
  <para style="q2" vid="PSA 119:117">nzokwama nitwararika amategeko yawe.<verse eid="PSA 119:117" /></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118" />Abazimira bakava mu mategeko yawe uzobaheba,</para>
  <para style="q2" vid="PSA 119:118">kuko ubuhumvyi bwabo ata co buzoshikako.<verse eid="PSA 119:118" /></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119" />Abanyakibi bose bo kw’isi uzobashibura nk’umwavu;</para>
  <para style="q2" vid="PSA 119:119">ni co gituma nzokunda ivyo washinze.<verse eid="PSA 119:119" /></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120" />Umubiri wanje uhinda agashitsi ku bwo kukwubaha;</para>
  <para style="q2" vid="PSA 119:120">ivyagezwe vyawe birantangaza.<verse eid="PSA 119:120" /></para>
  <para style="qa">Ayini</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121" />Nakoze ibigororotse n’ibitunganye;</para>
  <para style="q2" vid="PSA 119:121">ntuntererane abancinyiza.<verse eid="PSA 119:121" /></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122" />Nuhe umusavyi wawe kuroranirwa;</para>
  <para style="q2" vid="PSA 119:122">ntureke ngo abibone bancinyize.<verse eid="PSA 119:122" /></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123" />Amaso yanje ararushe, yiteze agakiza kawe,</para>
  <para style="q2" vid="PSA 119:123">yiteze isezerano ryawe rigororotse.<verse eid="PSA 119:123" /></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124" />Girira umusavyi wawe nk’uko urukundo rwawe ruri</para>
  <para style="q2" vid="PSA 119:124">kandi unyigishe amategeko yawe.<verse eid="PSA 119:124" /></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125" />Ndi umusavyi wawe; numpe ugusesangura</para>
  <para style="q2" vid="PSA 119:125">kugira ngo ntahure ivyo washinze.<verse eid="PSA 119:125" /></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126" />
    <char style="nd">Uhoraho</char> we, harageze ko ukora</para>
  <para style="q2" vid="PSA 119:126">kuko ivyagezwe vyawe vyahonyanzwe.<verse eid="PSA 119:126" /></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127" />Kuko nkunda amabwirizwa yawe</para>
  <para style="q2" vid="PSA 119:127">kurusha inzahabu, inzahabu ikuwemwo imyanda yose,<verse eid="PSA 119:127" /></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128" />kandi kuko nshira umutima ku vyo washinze,</para>
  <para style="q2" vid="PSA 119:128">kandi nanka inzira yose mbi.<verse eid="PSA 119:128" /></para>
  <para style="qa">Pe</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129" />Ivyo wihanikirije ni vyiza cane;</para>
  <para style="q2" vid="PSA 119:129">ni co gituma ndavyitondera.<verse eid="PSA 119:129" /></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130" />Iyo umuntu amenye ijambo ryawe, abona umuco;</para>
  <para style="q2" vid="PSA 119:130">abadaciye ubwenge ribaha ugutahura.<verse eid="PSA 119:130" /></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131" />Ndasamye kandi ndahuzagizwa,</para>
  <para style="q2" vid="PSA 119:131">nipfuza amabwirizwa yawe.<verse eid="PSA 119:131" /></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132" />Hindukira maze ungirire imbabazi,</para>
  <para style="q2" vid="PSA 119:132">nk’uko wama ugirira abakunda izina ryawe.<verse eid="PSA 119:132" /></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133" />Rongora intambuko zanje nk’uko ijambo ryawe ryavuze;</para>
  <para style="q2" vid="PSA 119:133">ntureke ngo hagire ikibi kinganza.<verse eid="PSA 119:133" /></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134" />Uncungure unkure mu gacinyizo k’abantu,</para>
  <para style="q2" vid="PSA 119:134">kugira ngo nitondere ivyo wihanikirije.<verse eid="PSA 119:134" /></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135" />Umurikishirize umusavyi wawe inyonga zawe</para>
  <para style="q2" vid="PSA 119:135">unyigishe amategeko yawe.<verse eid="PSA 119:135" /></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136" />Imigende y’amosozi itemba iva mu maso yanje,</para>
  <para style="q2" vid="PSA 119:136">kuko abantu batumvira Ivyagezwe vyawe.<verse eid="PSA 119:136" /></para>
  <para style="qa">Tsade</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137" />Uragororotse, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 119:137">kandi ivyagezwe vyawe biratunganye.<verse eid="PSA 119:137" /></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138" />Ivyo washinze biragororotse;</para>
  <para style="q2" vid="PSA 119:138">ni ivyo kwizigira rwose.<verse eid="PSA 119:138" /></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139" />Ishaka ryanje ryaka muri jewe nk’umuriro,</para>
  <para style="q2" vid="PSA 119:139">kuko abansi banje birengagije amajambo yawe.<verse eid="PSA 119:139" /></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140" />Amasezerano yawe yaragejejwe rwose,</para>
  <para style="q2" vid="PSA 119:140">ni co gituma nanje umusavyi wawe ndayakunda.<verse eid="PSA 119:140" /></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141" />Naho ndi umunyantegenke n’inkengerwa,</para>
  <para style="q2" vid="PSA 119:141">sinibagira ivyo wihanikirije.<verse eid="PSA 119:141" /></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142" />Ukugororoka kwawe ni uko ibihe bidashira</para>
  <para style="q2" vid="PSA 119:142">kandi Ivyagezwe vyawe ni ivy’ukuri.<verse eid="PSA 119:142" /></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143" />Ivyago n’akabonge vyanjeko,</para>
  <para style="q2" vid="PSA 119:143">ariko amabwirizwa yawe ni yo anezera.<verse eid="PSA 119:143" /></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144" />Ivyo washinze vyama bigororotse;</para>
  <para style="q2" vid="PSA 119:144">umpe ugutahura kugira ngo mbeho.<verse eid="PSA 119:144" /></para>
  <para style="qa">Kofu</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145" />Ndakwambaje n’umutima wanje wose, nunyishure, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 119:145">nanje nzokwitondera amategeko yawe.<verse eid="PSA 119:145" /></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146" />Ndagutakambiye; nkiza</para>
  <para style="q2" vid="PSA 119:146">nanje nzokwitondera ivyo washinze.<verse eid="PSA 119:146" /></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147" />Mvyuka umutwenzi utaratambika ngatakamba;</para>
  <para style="q2" vid="PSA 119:147">nizigiye ijambo ryawe.<verse eid="PSA 119:147" /></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148" />Nguma ndi maso ijoro ryose,</para>
  <para style="q2" vid="PSA 119:148">kugira ngo ndimbure amasezerano yawe.<verse eid="PSA 119:148" /></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149" />Niwumve ijwi ryanje nk’uko urukundo rwawe rungana;</para>
  <para style="q2" vid="PSA 119:149">ukingire ubugingo bwanje, <char style="nd">Uhoraho</char>, nk’uko ivyagezwe vyawe biri.<verse eid="PSA 119:149" /></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150" />Abagira imigabo mibi baranyegereye,</para>
  <para style="q2" vid="PSA 119:150">ariko bari kure y’Ivyagezwe vyawe.<verse eid="PSA 119:150" /></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151" />Ariko weho, <char style="nd">Uhoraho</char>, uri hafi yanje,</para>
  <para style="q2" vid="PSA 119:151">kandi amabwirizwa yawe yose ni ay’ukuri.<verse eid="PSA 119:151" /></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152" />Kuva kera nize mu vyo washinze</para>
  <para style="q2" vid="PSA 119:152">ko wabishinze ngo bigume bihamye gushika ibihe vyose.<verse eid="PSA 119:152" /></para>
  <para style="qa">Reshi</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153" />Raba umubabaro wanje maze untabare,</para>
  <para style="q2" vid="PSA 119:153">kuko ntibagiye Ivyagezwe vyawe.<verse eid="PSA 119:153" /></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154" />Mburanira kandi uncungure;</para>
  <para style="q2" vid="PSA 119:154">uzigame ubugingo bwanje nk’uko wasezeranye.<verse eid="PSA 119:154" /></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155" />Agakiza kari kure y’abanyakibi,</para>
  <para style="q2" vid="PSA 119:155">kuko batarondera kumenya amategeko yawe.<verse eid="PSA 119:155" /></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156" />Ikigongwe cawe, ewe <char style="nd">Uhoraho</char>, kirahambaye;</para>
  <para style="q2" vid="PSA 119:156">zigama ubugingo bwanje nk’uko ivyagezwe vyawe bivuga.<verse eid="PSA 119:156" /></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157" />Abampiga babaye benshi,</para>
  <para style="q2" vid="PSA 119:157">ariko sinavuye mu vyo washinze.<verse eid="PSA 119:157" /></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158" />Abatizera ndabarabana agakengerwe,</para>
  <para style="q2" vid="PSA 119:158">kuko batumvira ijambo ryawe.<verse eid="PSA 119:158" /></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159" />Raba uko nkunda ivyo wihanikirije;</para>
  <para style="q2" vid="PSA 119:159">uzigame ubugingo bwanje, <char style="nd">Uhoraho</char>, ku bw’urukundo rwawe.<verse eid="PSA 119:159" /></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160" />Amajambo yawe yose ni ay’ukuri;</para>
  <para style="q2" vid="PSA 119:160">ivyagezwe vyawe vyose bigororotse vyamaho ibihe vyose.<verse eid="PSA 119:160" /></para>
  <para style="qa">Sini na Shini</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161" />Abakomeye barampiga ata nyanduruko,</para>
  <para style="q2" vid="PSA 119:161">ariko umutima wanje uhindira agashitsi ijambo ryawe.<verse eid="PSA 119:161" /></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162" />Jewe nezererwa isezerano ryawe</para>
  <para style="q2" vid="PSA 119:162">nk’uwironkeye iminyago myinshi.<verse eid="PSA 119:162" /></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163" />Ndanka kandi ngakengera ibinyoma</para>
  <para style="q2" vid="PSA 119:163">ariko nkunda Ivyagezwe vyawe.<verse eid="PSA 119:163" /></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164" />Ndaguhimbaza incuro indwi ku musi</para>
  <para style="q2" vid="PSA 119:164">ku bw’ivyagezwe vyawe bigororotse.<verse eid="PSA 119:164" /></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165" />Abakunda Ivyagezwe vyawe bafise amahoro menshi,</para>
  <para style="q2" vid="PSA 119:165">kandi ntagishobora kubatsitaza.<verse eid="PSA 119:165" /></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166" />
    <char style="nd">Uhoraho</char>, niteze agakiza kawe,</para>
  <para style="q2" vid="PSA 119:166">kandi nitondera amabwirizwa yawe.<verse eid="PSA 119:166" /></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167" />Jewe nitondera ivyo washinze,</para>
  <para style="q2" vid="PSA 119:167">kuko ndabikunda cane.<verse eid="PSA 119:167" /></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168" />Jewe nitondera ivyo wihanikirije n’ivyo washinze,</para>
  <para style="q2" vid="PSA 119:168">kuko inzira zanje zose uzizi.<verse eid="PSA 119:168" /></para>
  <para style="qa">Tawu</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169" />Icompa ugutakamba kwanje kugashika imbere yawe, <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 119:169">umpe ugutahura nk’uko ijambo ryawe rivuga.<verse eid="PSA 119:169" /></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170" />Ukwinginga kwanje nigushike imbere yawe;</para>
  <para style="q2" vid="PSA 119:170">undokore nk’uko wasezeranye.<verse eid="PSA 119:170" /></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171" />Icompa iminwa yanje ikuzura ishimwe,</para>
  <para style="q2" vid="PSA 119:171">kuko unyigisha ivyo washinze.<verse eid="PSA 119:171" /></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172" />Icompa ururimi rwanje rukaririmba ijambo ryawe,</para>
  <para style="q2" vid="PSA 119:172">kuko amabwirizwa yawe yose agororotse.<verse eid="PSA 119:172" /></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173" />Icompa ikiganza cawe kikitegurira kuntabara,</para>
  <para style="q2" vid="PSA 119:173">kuko nahisemwo ivyo washinze.<verse eid="PSA 119:173" /></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174" />Ndipfuza rwose agakiza kawe, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 119:174">kandi Ivyagezwe vyawe bimpa kunezerwa.<verse eid="PSA 119:174" /></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175" />Umpe kubaho ngo ndaguhimbaze,</para>
  <para style="q2" vid="PSA 119:175">kandi ivyagezwe vyawe binshigikire.<verse eid="PSA 119:175" /></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176" />Nazimiye nk’intama yatakaye.</para>
  <para style="q2" vid="PSA 119:176">Rondera umusavyi wawe,</para>
  <para style="q2" vid="PSA 119:176">kuko ntibagiye amabwirizwa yawe.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="cl">Zaburi ya 120</para>
  <para style="d">Indirimbo yo mw’iduga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1" />Mu magorwa yanje nambaza <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 120:1">na we akanyishura.<verse eid="PSA 120:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2" />Nkiza, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 120:2">iminwa ibesha</para>
  <para style="q2" vid="PSA 120:2">n’indimi z’ibinyoma.<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3" />Ewe wa rurimi rw’ibinyoma,</para>
  <para style="q2" vid="PSA 120:3">mbega azogukorera iki,</para>
  <para style="q2" vid="PSA 120:3">canke azoguhanisha ikindi nyabaki?<verse eid="PSA 120:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4" />Azoguhanisha imyampi isongoye y’umuhizi,</para>
  <para style="q2" vid="PSA 120:4">n’amakara y’umurotemu yaka.<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5" />Jewe ndagowe kuko mba i Mesheki,</para>
  <para style="q2" vid="PSA 120:5">nkaba hagati mu mahema y’i Kedari!<verse eid="PSA 120:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6" />Kuva kera cane nabaye</para>
  <para style="q2" vid="PSA 120:6">hagati y’abanka amahoro.<verse eid="PSA 120:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7" />Jewe nshaka amahoro;</para>
  <para style="q2" vid="PSA 120:7">ariko iyo mvuze, bo bashaka intambara.<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="cl">Zaburi ya 121</para>
  <para style="d">Ni indirimbo yo mw’iduga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1" />Ndunamurira amaso yanje ku misozi;</para>
  <para style="q2" vid="PSA 121:1">ugutabarwa kwanje kuva hehe?<verse eid="PSA 121:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2" />Ugutabarwa kwanje kuva k’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 121:2">Umuremyi w’ijuru n’isi.<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3" />Ntazoreka ibirenge vyawe ngo binyerere;</para>
  <para style="q2" vid="PSA 121:3">uwukuzigama ntazohunyiza;<verse eid="PSA 121:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4" />ni ivy’ukuri, uwuzigama Isirayeli</para>
  <para style="q2" vid="PSA 121:4">ntazokwigera ahunyiza canke ngo asinzire.<verse eid="PSA 121:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5" />
    <char style="nd">Uhoraho</char> ni we akuzigama;</para>
  <para style="q2" vid="PSA 121:5">
    <char style="nd">Uhoraho</char> ni we gitutu cawe i buryo bwawe;<verse eid="PSA 121:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6" />izuba ntirizokubabaza ku murango,</para>
  <para style="q2" vid="PSA 121:6">canke ukwezi mw’ijoro.<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7" />
    <char style="nd">Uhoraho</char> azokurinda ikibi cose;</para>
  <para style="q2" vid="PSA 121:7">azozigama ubugingo bwawe;<verse eid="PSA 121:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8" />
    <char style="nd">Uhoraho</char> azokuzigama amaja n’amaza</para>
  <para style="q2" vid="PSA 121:8">uhereye ubu ukageza ibihe vyose.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="cl">Zaburi ya 122</para>
  <para style="d">Ni indirimbo yo mw’iduga. Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1" />Naranezerewe igihe bambwira bati:</para>
  <para style="q2" vid="PSA 122:1">“Tuje mu nzu y’<char style="nd">Uhoraho</char>.”<verse eid="PSA 122:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2" />Ibirenge vyacu bihagaze</para>
  <para style="q2" vid="PSA 122:2">mu marembo yawe, Yerusalemu.<verse eid="PSA 122:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3" />Yerusalemu hubatswe nk’igisagara</para>
  <para style="q2" vid="PSA 122:3">cegeranye kandi gifatanye.<verse eid="PSA 122:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4" />Aho ni ho imiryango iduga;</para>
  <para style="q2" vid="PSA 122:4">imiryango y’<char style="nd">Uhoraho</char>;</para>
  <para style="q1" vid="PSA 122:4">ngo bahimbaze izina ry’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 122:4">nk’uko yabishingiye Isirayeli.<verse eid="PSA 122:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5" />Aho ni ho hari intebe z’imanza,</para>
  <para style="q2" vid="PSA 122:5">intebe z’inzu ya Dawidi.<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6" />Musabire Yerusalemu ironke amahoro muti:</para>
  <para style="q2" vid="PSA 122:6">“Icompa abagukunda bakaba amahoro.<verse eid="PSA 122:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7" />Icompa mu nzitiro zawe hakaba amahoro</para>
  <para style="q2" vid="PSA 122:7">n’umutekano ukaba mu minara yawe.”<verse eid="PSA 122:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8" />Kubera umuryango wanje n’abagenzi banje,</para>
  <para style="q2" vid="PSA 122:8">nzovuga nti: “Amahoro abe muri wewe.”<verse eid="PSA 122:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9" />Kubera inzu y’<char style="nd">Uhoraho</char> Imana yacu,</para>
  <para style="q2" vid="PSA 122:9">nzokwama ngusabira ivyiza.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="cl">Zaburi ya 123</para>
  <para style="d">Ni indirimbo yo mw’iduga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1" />Ndunamurira amaso kuri wewe,</para>
  <para style="q2" vid="PSA 123:1">wewe uvyagiye mw’ijuru.<verse eid="PSA 123:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2" />Nk’uko abasavyi bahanga amaso ukuboko kwa shebuja,</para>
  <para style="q2" vid="PSA 123:2">nk’uko abasavyikazi bahanga ukuboko ba inabuja,</para>
  <para style="q1" vid="PSA 123:2">uko ni ko amaso yacu tuyahanze <char style="nd">Uhoraho</char> Imana yacu,</para>
  <para style="q2" vid="PSA 123:2">kugeza aho azotugirira imbabazi.<verse eid="PSA 123:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3" />Tugirire akagongwe, <char style="nd">Uhoraho</char>, tugirire akagongwe,</para>
  <para style="q2" vid="PSA 123:3">kuko twakengererwe igihe kirekire.<verse eid="PSA 123:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4" />Twacokowe igihe kirekire</para>
  <para style="q2" vid="PSA 123:4">n’agacokoro k’abibone,</para>
  <para style="q2" vid="PSA 123:4">twakengerewe n’abanyamanyama.<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="cl">Zaburi ya 124</para>
  <para style="d">Ni indirimbo yo mw’iduga. Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1" />Iyo <char style="nd">Uhoraho</char> ataba mu ruhande rwacu;</para>
  <para style="q2" vid="PSA 124:1">Abisirayeli nibavuge batyo;<verse eid="PSA 124:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2" />iyo <char style="nd">Uhoraho</char> ataba mu ruhande rwacu</para>
  <para style="q2" vid="PSA 124:2">igihe abantu badutera,<verse eid="PSA 124:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3" />baba baratumize miyonzwa tukibona</para>
  <para style="q2" vid="PSA 124:3">aho uburake bwabo bwatuziriringira,<verse eid="PSA 124:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4" />isuri iba yaraturengeye,</para>
  <para style="q2" vid="PSA 124:4">imipfunda iba yaraturenzeko,<verse eid="PSA 124:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5" />amazi asuriranya</para>
  <para style="q2" vid="PSA 124:5">aba yaradutembanye.<verse eid="PSA 124:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6" />
    <char style="nd">Uhoraho</char> ahimbazwe,</para>
  <para style="q2" vid="PSA 124:6">ataturetse ngo dutabagurwe n’amenyo yabo.<verse eid="PSA 124:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7" />Ducitse mu mutego nk’inyoni</para>
  <para style="q2" vid="PSA 124:7">tuvuye mu mutego w’umutezi;</para>
  <para style="q1" vid="PSA 124:7">umutego uracitse,</para>
  <para style="q2" vid="PSA 124:7">natwe tuwuvuyemwo turakira.<verse eid="PSA 124:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8" />Ugutabarwa kwacu kuri mw’izina ry’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 124:8">Umuremyi w’ijuru n’isi.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="cl">Zaburi ya 125</para>
  <para style="d">Ni indirimbo yo mw’iduga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1" />Abizigiye <char style="nd">Uhoraho</char> bameze nk’umusozi Siyoni,</para>
  <para style="q2" vid="PSA 125:1">udashobora kunyiganyizwa, ariko uhora ushikamye ibihe vyose.<verse eid="PSA 125:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2" />Nk’uko imisozi ikikije Yerusalemu,</para>
  <para style="q2" vid="PSA 125:2">ni ko <char style="nd">Uhoraho</char> akikije abantu biwe</para>
  <para style="q2" vid="PSA 125:2">uhereye ubu ukageza ibihe bidashira.<verse eid="PSA 125:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3" />Icumu ry’ubugabe ry’umunyakibi ntirizokwama rishinze</para>
  <para style="q2" vid="PSA 125:3">mu gihugu cahawe abagororotsi,</para>
  <para style="q1" vid="PSA 125:3">kuko abagororotsi bohava</para>
  <para style="q2" vid="PSA 125:3">bakoresha amaboko yabo ibibi.<verse eid="PSA 125:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4" />
    <char style="nd">Uhoraho</char>, girira neza abeza,</para>
  <para style="q2" vid="PSA 125:4">abatunganye mu mutima.<verse eid="PSA 125:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5" />Ariko abahindukira bakaja mu nzira zigoramye</para>
  <para style="q2" vid="PSA 125:5">
    <char style="nd">Uhoraho</char> azobirukanana n’inkozi z’ikibi.</para>
  <para style="b" vid="PSA 125:5" />
  <para style="q1" vid="PSA 125:5">Amahoro abe kuri Isirayeli.<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="cl">Zaburi ya 126</para>
  <para style="d">Ni indirimbo yo mw’iduga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1" />Hamwe <char style="nd">Uhoraho</char> yagarukana i Siyoni abajanwe ari inyagano,</para>
  <para style="q2" vid="PSA 126:1">twari tumeze nk’abarota.<verse eid="PSA 126:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2" />Akanwa kacu kari kuzuye ibitwengatwenge</para>
  <para style="q2" vid="PSA 126:2">indimi zacu zari zuzuye indirimbo z’umunezero.</para>
  <para style="q1" vid="PSA 126:2">Maze biravugwa mu mahanga ngo:</para>
  <para style="q2" vid="PSA 126:2">“<char style="nd">Uhoraho</char> yabakoreye ibikomeye.”<verse eid="PSA 126:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3" />
    <char style="nd">Uhoraho</char> yadukoreye ibikomeye,</para>
  <para style="q2" vid="PSA 126:3">natwe turanezerewe.<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4" />
    <char style="nd">Uhoraho</char> garukana abacu bajanywe ari inyagano,</para>
  <para style="q2" vid="PSA 126:4">bamere nk’imigezi y’i Negebu.<verse eid="PSA 126:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5" />Ababiba barira</para>
  <para style="q2" vid="PSA 126:5">bazokwimbura baririmba.<verse eid="PSA 126:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6" />Abasohoka barira,</para>
  <para style="q2" vid="PSA 126:6">bajanye imbuto kubiba,</para>
  <para style="q1" vid="PSA 126:6">bazogarukana indirimbo z’umunezero,</para>
  <para style="q2" vid="PSA 126:6">bikoreye ivyimburwa.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="cl">Zaburi ya 127</para>
  <para style="d">Ni indirimbo yo mw’iduga. Ni iya Salomo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1" />Iyo <char style="nd">Uhoraho</char> atari we yubaka inzu,</para>
  <para style="q2" vid="PSA 127:1">abubatsi baba baruhira ubusa.</para>
  <para style="q1" vid="PSA 127:1">Iyo <char style="nd">Uhoraho</char> atari we arinze igisagara,</para>
  <para style="q2" vid="PSA 127:1">abararirizi babera maso ubusa.<verse eid="PSA 127:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2" />Muvyukira kare ubusa</para>
  <para style="q2" vid="PSA 127:2">mukaryama mutevye,</para>
  <para style="q1" vid="PSA 127:2">mucumukura ngo muronke ivyokurya;</para>
  <para style="q2" vid="PSA 127:2">kuko abo ikunda ibibahera mw’itiro.<verse eid="PSA 127:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3" />Abana ni umugabane uva k’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 127:3">uruvyaro ni impera atanga.<verse eid="PSA 127:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4" />Nk’uko imyampi imera mu kuboko kw’umuhizi</para>
  <para style="q2" vid="PSA 127:4">ni ko n’abana bo mu buto bamera.<verse eid="PSA 127:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5" />Hahiriwe umuntu</para>
  <para style="q2" vid="PSA 127:5">yujuje umutana wiwe imyampi nk’iyo.</para>
  <para style="q1" vid="PSA 127:5">Ntibazomaramara</para>
  <para style="q2" vid="PSA 127:5">nibahangana n’abababuranya mu bucamanza.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="cl">Zaburi ya 128</para>
  <para style="d">Ni indirimbo yo mw’iduga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1" />Hahiriwe uwubaha <char style="nd">Uhoraho</char> wese,</para>
  <para style="q2" vid="PSA 128:1">akagenda mu nzira ziwe.<verse eid="PSA 128:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2" />Uzorya ivyo ubutame bwawe bwamye;</para>
  <para style="q2" vid="PSA 128:2">imigisha n’amahirwe bizoba ivyawe.<verse eid="PSA 128:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3" />Umugore wawe azoba nk’umuzabibu wama cane</para>
  <para style="q2" vid="PSA 128:3">mu nzu yawe;</para>
  <para style="q1" vid="PSA 128:3">abana bawe bazoba nk’utugemwe twa elayo</para>
  <para style="q2" vid="PSA 128:3">bakikuje imeza yawe.<verse eid="PSA 128:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4" />Egome, uwo ni wo uzoba umugisha</para>
  <para style="q2" vid="PSA 128:4">w’umuntu yubaha <char style="nd">Uhoraho</char>.<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5" />
    <char style="nd">Uhoraho</char> aguhe umugisha uva i Siyoni;</para>
  <para style="q2" vid="PSA 128:5">uze ubone amahirwe ya Yerusalemu</para>
  <para style="q2" vid="PSA 128:5">mu misi yose y’ukubaho kwawe.<verse eid="PSA 128:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6" />Uze urambe kugira ngo wibonere abuzukuru bawe;</para>
  <para style="q2" vid="PSA 128:6">amahoro abe kuri Isirayeli.<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="cl">Zaburi ya 129</para>
  <para style="d">Ni indirimbo yo mw’iduga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1" />“Barangwanije cane kuva nkiri muto.”</para>
  <para style="q2" vid="PSA 129:1">Abisirayeli nibavuge batyo:<verse eid="PSA 129:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2" />“Barangwanije cane kuva mu buto bwanje,</para>
  <para style="q2" vid="PSA 129:2">ariko ntibanesheje.<verse eid="PSA 129:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3" />Abarimyi barimye ku mugongo wanje</para>
  <para style="q2" vid="PSA 129:3">bahaciye imirongo miremire.<verse eid="PSA 129:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4" />Ariko <char style="nd">Uhoraho</char> aragororotse;</para>
  <para style="q2" vid="PSA 129:4">yacagaguye imigozi y’abanyakibi.”<verse eid="PSA 129:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5" />Icompa abanka Siyoni bose</para>
  <para style="q2" vid="PSA 129:5">bagasubira inyuma bamaramaye.<verse eid="PSA 129:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6" />Icompa bakamera nk’ivyatsi vyameze ku nzu,</para>
  <para style="q2" vid="PSA 129:6">vyuma bitarakura;<verse eid="PSA 129:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7" />umwimbuzi ntashobora kuvyuzuza ibiganza vyiwe,</para>
  <para style="q2" vid="PSA 129:7">canke uwegeranya ngo aronke ivyo guteruza amaboko;<verse eid="PSA 129:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8" />Icompa ababarengana ntibababwire bati:</para>
  <para style="q2" vid="PSA 129:8">“Umugisha w’<char style="nd">Uhoraho</char> ubane na we;</para>
  <para style="q2" vid="PSA 129:8">tubahezagiye mw’izina ry’<char style="nd">Uhoraho</char>.”<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="cl">Zaburi ya 130</para>
  <para style="d">Ni indirimbo yo mw’iduga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1" />
    <char style="nd">Uhoraho</char> ndagutakambira, bivuye i bwina;<verse eid="PSA 130:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 130:2" />Niwumve ijwi ryanje, ewe Mana.</para>
  <para style="q1" vid="PSA 130:2">Utege amatwi</para>
  <para style="q2" vid="PSA 130:2">ukwinginga kwanje.<verse eid="PSA 130:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3" />Iyaba wama wibuka ivyaha, ewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 130:3">ni nde yohagarara?<verse eid="PSA 130:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4" />Ariko ufise uguharira hafi yawe,</para>
  <para style="q2" vid="PSA 130:4">kugira ngo dushobore kugukorera, tukwubashe.<verse eid="PSA 130:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5" />Niteze <char style="nd">Uhoraho</char>, ubugingo bwanje bwose buramwiteze</para>
  <para style="q2" vid="PSA 130:5">kandi ivyizigiro vyanje biri kw’ijambo ryiwe.<verse eid="PSA 130:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6" />Niteze Imana</para>
  <para style="q2" vid="PSA 130:6">kurusha uko abararirizi barindira ko buca,</para>
  <para style="q2" vid="PSA 130:6">kurusha uko abararirizi barorera ko buca.<verse eid="PSA 130:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7" />Ewe Isirayeli, niwizigire <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 130:7">kuko hafi yiwe ari ho urukundo rudashira ruri</para>
  <para style="q2" vid="PSA 130:7">n’ugucungurwa gushitse.<verse eid="PSA 130:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8" />Ni we ubwiwe azokwicungurira Abisirayeli</para>
  <para style="q2" vid="PSA 130:8">abakure mu vyaha vyabo.<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="cl">Zaburi ya 131</para>
  <para style="d">Ni indirimbo yo mw’iduga. Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1" />Umutima wanje ntiwishira hejuru, <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 131:1">amaso yanje ntiyibona;</para>
  <para style="q1" vid="PSA 131:1">sinivanga n’ibintu vyo hejuru</para>
  <para style="q2" vid="PSA 131:1">canke ibintu bindengeye.<verse eid="PSA 131:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2" />Ariko naratekereje ndacereza,</para>
  <para style="q2" vid="PSA 131:2">meze nk’umwana acutse ari i ruhande ya nyina;</para>
  <para style="q2" vid="PSA 131:2">nk’umwana acutse uko ni ko ntekereje.<verse eid="PSA 131:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3" />Ewe Isirayeli, niwizigire <char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 131:3">uhereye none kugeza ibihe vyose.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="cl">Zaburi ya 132</para>
  <para style="d">Ni indirimbo yo mw’iduga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1" />
    <char style="nd">Uhoraho</char>, niwibuke Dawidi</para>
  <para style="q2" vid="PSA 132:1">n’amarushwa yiwe yose.<verse eid="PSA 132:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2" />Yarahiye <char style="nd">Uhoraho</char> indahiro,</para>
  <para style="q2" vid="PSA 132:2">yasezeraniye Inyenkomezi ya Yakobo ati:<verse eid="PSA 132:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3" />“Sinzokwinjira mu nzu yanje</para>
  <para style="q2" vid="PSA 132:3">canke ngo nurire uburiri bwanje,<verse eid="PSA 132:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4" />sinzokwemerera amaso yanje gusinzira</para>
  <para style="q2" vid="PSA 132:4">canke ingohe zanje guhunyiza,<verse eid="PSA 132:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5" />kugeza aho nzoronkera <char style="nd">Uhoraho</char> ikibanza,</para>
  <para style="q2" vid="PSA 132:5">inzu y’Inyenkomezi ya Yakobo.”<verse eid="PSA 132:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6" />Twavyumviye muri Efurata,</para>
  <para style="q2" vid="PSA 132:6">twabisanze mu gahinga k’i Yayari ngo:<verse eid="PSA 132:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7" />“Nimuze tuje mu ngoro yiwe,</para>
  <para style="q2" vid="PSA 132:7">nimuze dusengere ku ndava yiwe, tuti:<verse eid="PSA 132:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8" />‘Haguruka, ewe <char style="nd">Uhoraho</char>, uze mu buruhukiro bwawe,</para>
  <para style="q2" vid="PSA 132:8">wewe n’Isandugu ari co ki kimenyetso c’inkomezi zawe.<verse eid="PSA 132:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9" />Abaherezi bawe nibambare ukugororoka kwawe,</para>
  <para style="q2" vid="PSA 132:9">abizigirwa bawe bavuze impundu.’ ”<verse eid="PSA 132:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10" />Ku bwa Dawidi umusavyi wawe,</para>
  <para style="q2" vid="PSA 132:10">ntushiburire kure uwo warobanuje amavuta.<verse eid="PSA 132:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11" />
    <char style="nd">Uhoraho</char> yarahiye Dawidi indahiro,</para>
  <para style="q2" vid="PSA 132:11">ni iy’ukuri ntazokwisubirako ngo:</para>
  <para style="q1" vid="PSA 132:11">“Umwe wo mu ruvyaro rwawe</para>
  <para style="q2" vid="PSA 132:11">nzomwimika ku ntebe yawe y’ubwami.<verse eid="PSA 132:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12" />Abana bawe nibagumya isezerano ryanje</para>
  <para style="q2" vid="PSA 132:12">n’ivyo nashinze nkabibigisha,</para>
  <para style="q1" vid="PSA 132:12">nuko abana babo bazokwicara</para>
  <para style="q2" vid="PSA 132:12">ku ntebe yawe y’ubwami ibihe vyose.”<verse eid="PSA 132:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13" />Kuko <char style="nd">Uhoraho</char> yatoranije Siyoni,</para>
  <para style="q2" vid="PSA 132:13">yavyipfuje ari iwe avuga ati:<verse eid="PSA 132:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14" />“Aha ni ahantu hanje ho kuruhukira ibihe n’ibihe;</para>
  <para style="q2" vid="PSA 132:14">aha ni ho nzovyagira nganze, kuko navyipfuje;<verse eid="PSA 132:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15" />Nzohaha umugisha w’ibintu,</para>
  <para style="q2" vid="PSA 132:15">abakene baho bazohazwa ivyokurya.<verse eid="PSA 132:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16" />Nzokwambika abaherezi baho agakiza,</para>
  <para style="q2" vid="PSA 132:16">n’abizigirwa baho bazokwama bavuza impundu!<verse eid="PSA 132:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17" />Aha ni ho nzotuma ihembe rya Dawidi rikura</para>
  <para style="q2" vid="PSA 132:17">kandi nzodomeka itara ry’uwo narobanuje amavuta.<verse eid="PSA 132:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18" />Nzotuma abansi biwe bamaramara,</para>
  <para style="q2" vid="PSA 132:18">ariko umutwe wiwe uzosharizwa n’urugori rukayangana.”<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="cl">Zaburi ya 133</para>
  <para style="d">Ni indirimbo yo mw’iduga; Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1" />Ese ingene ari vyiza kandi bihimbaye</para>
  <para style="q2" vid="PSA 133:1">iyo abantu b’Imana babana mu bumwe!<verse eid="PSA 133:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2" />Bimeze nk’amavuta y’igiciro kinini asutswe ku mutwe,</para>
  <para style="q2" vid="PSA 133:2">agatembera ku bwanwa,</para>
  <para style="q1" vid="PSA 133:2">agatembera ku bwanwa bwa Aroni,</para>
  <para style="q2" vid="PSA 133:2">no ku buyonga bw’ikanzu yiwe.<verse eid="PSA 133:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3" />Ni nk’ikime co ku musozi Herumoni</para>
  <para style="q2" vid="PSA 133:3">gitembera ku musozi Siyoni.</para>
  <para style="q1" vid="PSA 133:3">Kuko aho ni ho <char style="nd">Uhoraho</char> asuka umugisha wiwe,</para>
  <para style="q2" vid="PSA 133:3">mbere n’ubugingo kugeza ibihe vyose.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="cl">Zaburi ya 134</para>
  <para style="d">Ni indirimbo yo mw’iduga.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1" />Nimuhimbaze <char style="nd">Uhoraho</char>, yemwe basavyi b’<char style="nd">Uhoraho</char> mwese,</para>
  <para style="q2" vid="PSA 134:1">mwebwe mukorera mu nzu y’<char style="nd">Uhoraho</char> mugakesha ijoro.<verse eid="PSA 134:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2" />Nimutarike ibiganza vyanyu hejuru muri mu Ngoro,</para>
  <para style="q2" vid="PSA 134:2">muhimbaze <char style="nd">Uhoraho</char>.<verse eid="PSA 134:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3" />
    <char style="nd">Uhoraho</char> aguhezagire ari i Siyoni,</para>
  <para style="q2" vid="PSA 134:3">ni we Muremyi w’ijuru n’isi.<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="cl">Zaburi ya 135</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1" />Himbaza <char style="nd">Uhoraho</char>.</para>
  <para style="b" vid="PSA 135:1" />
  <para style="q1" vid="PSA 135:1">Nimuhimbaze izina ry’<char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 135:1">mumuhimbaze, yemwe basavyi biwe,<verse eid="PSA 135:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2" />mwebwe mukorera mu nzu y’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 135:2">mu birimba vy’Ingoro y’Imana yanyu.<verse eid="PSA 135:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3" />Nimuhimbaze <char style="nd">Uhoraho</char>, kuko <char style="nd">Uhoraho</char> ari mwiza;</para>
  <para style="q2" vid="PSA 135:3">muririmbe mushima izina ryiwe, kuko ari vyo bihimbaye.<verse eid="PSA 135:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4" />Kuko <char style="nd">Uhoraho</char> yatoranije Yakobo ngo abe uwiwe,</para>
  <para style="q2" vid="PSA 135:4">Isirayeli ngo amubere inyegu yiwe.<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5" />Ndazi ko <char style="nd">Uhoraho</char> ahambaye,</para>
  <para style="q2" vid="PSA 135:5">ko umwami wacu ahambaye asumba ibigirwamana vyose.<verse eid="PSA 135:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6" />
    <char style="nd">Uhoraho</char> akora ibimuhimbaye vyose,</para>
  <para style="q2" vid="PSA 135:6">mw’ijuru no mw’isi,</para>
  <para style="q2" vid="PSA 135:6">mu biyaga no mw’idamba ryavyo.<verse eid="PSA 135:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7" />Atuma ibicu biva ku mpera z’isi;</para>
  <para style="q2" vid="PSA 135:7">atuma umuravyo n’imvura</para>
  <para style="q2" vid="PSA 135:7">agasohora umuyaga awukuye mu bubiko bwawo.<verse eid="PSA 135:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8" />Yishe imfura zo muri Egiputa,</para>
  <para style="q2" vid="PSA 135:8">imfura zo mu bantu n’ibikoko.<verse eid="PSA 135:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9" />Yarungitse ibimenyetso n’ibitangaza hagati muri mwebwe, muri Egiputa,</para>
  <para style="q2" vid="PSA 135:9">kugwanya Farawo n’abasavyi biwe.<verse eid="PSA 135:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10" />Yatsinze hasi amahanga</para>
  <para style="q2" vid="PSA 135:10">yica abami bahambaye;<verse eid="PSA 135:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11" />Sihoni umwami w’Abamori,</para>
  <para style="q2" vid="PSA 135:11">Ogi umwami w’i Bashani,</para>
  <para style="q2" vid="PSA 135:11">n’abami bose b’i Kanani;<verse eid="PSA 135:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12" />maze atanga igihugu cabo ngo kibe umugabane,</para>
  <para style="q2" vid="PSA 135:12">umugabane w’abantu biwe ba Isirayeli.<verse eid="PSA 135:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13" />Izina ryawe, <char style="nd">Uhoraho</char> ryamaho ibihe vyose,</para>
  <para style="q2" vid="PSA 135:13">no kuba rurangiranwa kwawe, ewe <char style="nd">Uhoraho</char>, uko urunganwe ruzokurikirana n’urundi.<verse eid="PSA 135:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14" />Kuko <char style="nd">Uhoraho</char> azocira iziroranye abantu biwe</para>
  <para style="q2" vid="PSA 135:14">agirire akagongwe abasavyi biwe.<verse eid="PSA 135:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15" />Ibigirwamana vy’amahanga ni ifeza n’inzahabu,</para>
  <para style="q2" vid="PSA 135:15">vyakozwe n’intoke z’abantu.<verse eid="PSA 135:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16" />Bifise akanwa, ariko ntibivuga,</para>
  <para style="q2" vid="PSA 135:16">bifise amaso, ariko ntibibona.<verse eid="PSA 135:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17" />Bifise amatwi, ariko ntivyumva,</para>
  <para style="q2" vid="PSA 135:17">kandi nta mpwemu ziri mu kanwa kavyo.<verse eid="PSA 135:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18" />Ababicura bazomera nka vyo,</para>
  <para style="q2" vid="PSA 135:18">co kimwe n’abavyizigira bose.<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19" />Yemwe Bisirayeli mwese nimuhimbaze <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 135:19">ab’inzu ya Aroni, nimuhimbaze <char style="nd">Uhoraho</char>;<verse eid="PSA 135:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20" />Ab’inzu ya Lewi, nimuhimbaze <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 135:20">abamwubaha mwese, nimuhimbaze <char style="nd">Uhoraho</char>.<verse eid="PSA 135:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21" />
    <char style="nd">Uhoraho</char> ahimbarizwe i Siyoni,</para>
  <para style="q2" vid="PSA 135:21">
    <char style="nd">Uhoraho</char> aba i Yerusalemu.</para>
  <para style="b" vid="PSA 135:21" />
  <para style="q1" vid="PSA 135:21">Himbaza <char style="nd">Uhoraho</char>.<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="cl">Zaburi ya 136</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1" />Nimushimire <char style="nd">Uhoraho</char>, kuko ari mwiza.</para>
  <para style="qr" vid="PSA 136:1">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2" />Nimushimire <char style="nd">Uhoraho</char> aganza imana zose.</para>
  <para style="qr" vid="PSA 136:2">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3" />Nimushimire Umwami aganza abami:</para>
  <para style="qr" vid="PSA 136:3">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4" />Ni we wenyene akora ibitangaza,</para>
  <para style="qr" vid="PSA 136:4">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5" />Ni we yaremesheje amajuru ubwenge,</para>
  <para style="qr" vid="PSA 136:5">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6" />Uwashanje isi hejuru y’amazi,</para>
  <para style="qr" vid="PSA 136:6">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7" />Uwaremye ivyaka binini,</para>
  <para style="qr" vid="PSA 136:7">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8" />Izuba ryo kuganza umurango,</para>
  <para style="qr" vid="PSA 136:8">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9" />Ukwezi n’inyenyeri vyo kuganza ijoro,</para>
  <para style="qr" vid="PSA 136:9">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10" />Uwahoneje imfura zo muri Egiputa,</para>
  <para style="qr" vid="PSA 136:10">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11" />Agakura Isirayeli muri bo,</para>
  <para style="qr" vid="PSA 136:11">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12" />Abakujeyo ukuboko kw’inkomezi kuramvuye,</para>
  <para style="qr" vid="PSA 136:12">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13" />Yagabuyemwo kabiri Ikiyaga Gitukura,</para>
  <para style="qr" vid="PSA 136:13">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14" />Agacisha Isirayeli hagati muri co,</para>
  <para style="qr" vid="PSA 136:14">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15" />Ariko agatsinda Farawo n’ingabo ziwe mu Kiyaga Gitukura,</para>
  <para style="qr" vid="PSA 136:15">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16" />Ni we yarongoye abantu biwe mu bugaragwa,</para>
  <para style="qr" vid="PSA 136:16">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17" />Ni we yatsinze hasi abami bahambaye,</para>
  <para style="qr" vid="PSA 136:17">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18" />Akica abami bakomeye,</para>
  <para style="qr" vid="PSA 136:18">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19" />Sihoni umwami w’Abamori,</para>
  <para style="qr" vid="PSA 136:19">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20" />Na Ogi umwami w’i Bashani,</para>
  <para style="qr" vid="PSA 136:20">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21" />Agatanga igihugu cabo ngo kibe iragi,</para>
  <para style="qr" vid="PSA 136:21">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22" />Iragi ry’umusavyi wiwe Isirayeli,</para>
  <para style="qr" vid="PSA 136:22">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23" />Yaratwibutse igihe twari dusuzuguritse,</para>
  <para style="qr" vid="PSA 136:23">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24" />Adukiza abansi bacu,</para>
  <para style="qr" vid="PSA 136:24">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25" />Agaburira ivyaremwe vyose,</para>
  <para style="qr" vid="PSA 136:25">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26" />Nimushime Imana yo mw’ijuru.</para>
  <para style="qr" vid="PSA 136:26">Urukundo rwiwe rwamaho ibihe bidashira.<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="cl">Zaburi ya 137</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1" />Ku nzuzi z’i Babiloni ni ho twicara tukarira</para>
  <para style="q2" vid="PSA 137:1">twibutse Siyoni.<verse eid="PSA 137:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2" />Ku biti vy’imilebeni vyaho</para>
  <para style="q2" vid="PSA 137:2">ni ho twamanika inanga zacu,<verse eid="PSA 137:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3" />kuko aho ni ho abatujanye nk’inyagano badusabira kubaririmbira,</para>
  <para style="q2" vid="PSA 137:3">abatugaraguza agati badusaba indirimbo z’umunezero;</para>
  <para style="q2" vid="PSA 137:3">bavuga bati: “Nimuturirimbire imwe mu ndirimbo z’i Siyoni!”<verse eid="PSA 137:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4" />Twoshobora gute kuririmba indirimbo z’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="PSA 137:4">turi mu gihugu c’ikinyamahanga?<verse eid="PSA 137:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5" />Yerusalemu, ninakwibagira,</para>
  <para style="q2" vid="PSA 137:5">ukuryo kwanje kwibagire gucuraranga.<verse eid="PSA 137:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6" />Ururimi rwanje rufatane n’amagage</para>
  <para style="q2" vid="PSA 137:6">nintakwibuka,</para>
  <para style="q1" vid="PSA 137:6">nintiyumvira kuri Yerusalemu</para>
  <para style="q2" vid="PSA 137:6">ibihimbaro vyanje.<verse eid="PSA 137:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7" />
    <char style="nd">Uhoraho</char>, niwibuke ivyo Abanyedomu bakoze</para>
  <para style="q2" vid="PSA 137:7">ku musi Yerusalemu hasambuka.</para>
  <para style="q1" vid="PSA 137:7">Basemerera ngo: “Hasambure,</para>
  <para style="q2" vid="PSA 137:7">samburira hasi amatanguriro yaho!”<verse eid="PSA 137:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8" />Mukobwa w’i Babiloni, uzosamburwa,</para>
  <para style="q2" vid="PSA 137:8">hahiriwe uwukwishura</para>
  <para style="q2" vid="PSA 137:8">ibihwanye n’ivyo wadukoreye.<verse eid="PSA 137:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9" />Hahiriwe uwufata inzoya zawe</para>
  <para style="q2" vid="PSA 137:9">akazihonda ku bitandara.<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="cl">Zaburi ya 138</para>
  <para style="d">Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1" />
    <char style="nd">Uhoraho</char>, nzoguhimbaza n’umutima wanje wose;</para>
  <para style="q2" vid="PSA 138:1">imbere “y’ibigirwamana” nzokuririmbira ishimwe.<verse eid="PSA 138:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2" />Nzokwunama ntumbereye Ingoro yawe yera,</para>
  <para style="q2" vid="PSA 138:2">maze mpimbaze izina ryawe</para>
  <para style="q2" vid="PSA 138:2">kubera urukundo rwawe rudashira n’ukwizigirwa kwawe,</para>
  <para style="q1" vid="PSA 138:2">kuko washize hejuru izina ryawe n’ijambo ryawe</para>
  <para style="q2" vid="PSA 138:2">ubirutisha ibindi bintu vyose.<verse eid="PSA 138:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3" />Igihe nahamagara, waranyishuye;</para>
  <para style="q2" vid="PSA 138:3">maze urandemesha mu kunyongera inkomezi.<verse eid="PSA 138:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4" />Abami bose bo kw’isi nibaguhimbaze, <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 138:4">nibumva ivyo washinze.<verse eid="PSA 138:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5" />Baze baririmbe ivy’inzira z’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 138:5">kuko icubahiro c’<char style="nd">Uhoraho</char> gihambaye.<verse eid="PSA 138:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6" />Naho <char style="nd">Uhoraho</char> ashizwe hejuru, ararabana ubugwaneza abaciye bugufi;</para>
  <para style="q2" vid="PSA 138:6">naho ari uwuhambaye, ababonera kure.<verse eid="PSA 138:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7" />Naho ngendera hagati y’amarushwa,</para>
  <para style="q2" vid="PSA 138:7">uzigama ubugingo bwanje;</para>
  <para style="q1" vid="PSA 138:7">uramvurira ukuboko kwawe kugwanya abangwanya;</para>
  <para style="q2" vid="PSA 138:7">unkirisha ukuboko kwawe kw’i buryo.<verse eid="PSA 138:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8" />
    <char style="nd">Uhoraho</char> azoshitsa ivyo yasezeranye ku bugingo bwanje;</para>
  <para style="q2" vid="PSA 138:8">urukundo rwawe, <char style="nd">Uhoraho</char>, rwamaho ibihe vyose;</para>
  <para style="q2" vid="PSA 138:8">ntuhebe ibikorwa vy’intoke zawe.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="cl">Zaburi ya 139</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni iya Dawidi. Ni Zaburi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1" />
    <char style="nd">Uhoraho</char> we, waransuzumye,</para>
  <para style="q2" vid="PSA 139:1">ugirako uramenya.<verse eid="PSA 139:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2" />Urazi iyicara ryanje n’iva hasi ryanje;</para>
  <para style="q2" vid="PSA 139:2">umenyera kure ivyo niyumvira.<verse eid="PSA 139:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3" />Umenya iyo ngendagenda n’iyo ndyamye;</para>
  <para style="q2" vid="PSA 139:3">umenyereye inzira zanje zose.<verse eid="PSA 139:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4" />Ijambo ritarashika ku rurimi rwanje</para>
  <para style="q2" vid="PSA 139:4">wewe, <char style="nd">Uhoraho</char>, uba warimenye ido n’ido.<verse eid="PSA 139:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5" />Unkikuje imbere n’inyuma,</para>
  <para style="q2" vid="PSA 139:5">kandi unshizeko ikiganza cawe.<verse eid="PSA 139:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6" />Ukumenya bene uko ni igitangaza kuri jewe,</para>
  <para style="q2" vid="PSA 139:6">gushika kure aho ntoshika.<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7" />Mbega Mpwemu wawe nomuhungira hehe?</para>
  <para style="q2" vid="PSA 139:7">Noja he ngo mpunge mu nyonga hawe?<verse eid="PSA 139:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8" />Noja mw’ijuru, ni ho uri;</para>
  <para style="q2" vid="PSA 139:8">nokwubaka uburiri bwanje i bwina, ni yo uri.<verse eid="PSA 139:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9" />Nova hasi nkaja ku mababa y’umutwenzi,</para>
  <para style="q2" vid="PSA 139:9">noja kuba hirya kure hakurya y’ikiyaga,<verse eid="PSA 139:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10" />naho nyene ikiganza cawe cohandongorera,</para>
  <para style="q2" vid="PSA 139:10">ukuboko kwawe kw’i buryo kwoncakira.<verse eid="PSA 139:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11" />Novuga nti: “Ni ukuri umwijima ugiye kumpisha</para>
  <para style="q2" vid="PSA 139:11">n’umuco uhinduke ijoro ahankikuje,”<verse eid="PSA 139:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12" />n’umwijima na wo nyene ntiwoba umwijima kuri wewe;</para>
  <para style="q2" vid="PSA 139:12">ijoro rizokayangana nk’umurango,</para>
  <para style="q2" vid="PSA 139:12">umwijima na wo ni nk’umuco kuri wewe.<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13" />Kuko ari wewe waremye ibimbamwo vyose;</para>
  <para style="q2" vid="PSA 139:13">wanteranirije mu nda ya mama;<verse eid="PSA 139:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14" />Ndaguhimbaza kuko naremwe mu buryo buteye ubwoba kandi butangaje;</para>
  <para style="q2" vid="PSA 139:14">ivyo ukora biratangaje,</para>
  <para style="q2" vid="PSA 139:14">ivyo ndabizi neza.<verse eid="PSA 139:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15" />Igikankara canje nticari gihishijwe inyonga zawe</para>
  <para style="q2" vid="PSA 139:15">igihe naremerwa mw’ibanga,</para>
  <para style="q2" vid="PSA 139:15">igihe nateranirizwa i bwina mw’isi.<verse eid="PSA 139:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16" />Amaso yawe yarabona umubiri wanje ukiri amazi;</para>
  <para style="q2" vid="PSA 139:16">imisi wanshingiye yari yanditswe mu gitabu cawe</para>
  <para style="q2" vid="PSA 139:16">imbere yuko habaho n’umwe.<verse eid="PSA 139:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17" />Ese ukungene ivyiyumviro vyawe ari ivy’igiciro, ewe Mana!</para>
  <para style="q2" vid="PSA 139:17">Ese ukungene ari vyinshi!<verse eid="PSA 139:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18" />Nobiharura,</para>
  <para style="q2" vid="PSA 139:18">vyoruta umusenyi;</para>
  <para style="q2" vid="PSA 139:18">iyo nikanguye, nsanga nkiri kumwe na we.<verse eid="PSA 139:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19" />Ese icompa akaba ari wewe wenyene, ewe Mana, wica abanyakibi!</para>
  <para style="q2" vid="PSA 139:19">Mva i ruhande mwa binywamaraso mwe!<verse eid="PSA 139:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20" />Bakuvugako ibibi;</para>
  <para style="q2" vid="PSA 139:20">abansi bawe bakoresha nabi izina ryawe.<verse eid="PSA 139:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21" />Mbega sinanka abakwanka, ga yewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 139:21">kandi sinkengera abakugarariza?<verse eid="PSA 139:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22" />Nta kindi mfise atari urwanko ndabanka;</para>
  <para style="q2" vid="PSA 139:22">ndababona nk’abansi banje.<verse eid="PSA 139:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23" />Nsesa, ewe Mana, umenye umutima wanje;</para>
  <para style="q2" vid="PSA 139:23">ungeze umenye ivyiyumviro vyanje.<verse eid="PSA 139:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24" />Raba ko hoba hari inzira y’icaha iri muri jewe,</para>
  <para style="q2" vid="PSA 139:24">kugira ngo undongorere mu nzira y’ibihe bidashira.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="cl">Zaburi ya 140</para>
  <para style="d">Yahawe umukuru w’abaririmvyi. Ni aburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1" />Ntabara, <char style="nd">Uhoraho</char>, unkize inkozi z’ibibi;</para>
  <para style="q2" vid="PSA 140:1">undinde abanyamuryano,<verse eid="PSA 140:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2" />bagira imigambi mibi mu mitima yabo</para>
  <para style="q2" vid="PSA 140:2">bakavyura intambara imisi yose.<verse eid="PSA 140:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3" />Indimi zabo bazisongora nk’iz’inzoka;</para>
  <para style="q2" vid="PSA 140:3">ubumara bw’inzoka buri mu kanwa kabo.<verse eid="PSA 140:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4" />
    <char style="nd">Uhoraho</char>, undinde amaboko y’abanyakibi;</para>
  <para style="q2" vid="PSA 140:4">undinde abanyamuryano,</para>
  <para style="q2" vid="PSA 140:4">bagira imigabo yo kuntsinda hasi.<verse eid="PSA 140:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5" />Abibone banteze umutego wo mu mpisho;</para>
  <para style="q2" vid="PSA 140:5">bamaze gutega insenga zabo</para>
  <para style="q2" vid="PSA 140:5">no gushinga imitego yabo mu nzira ncamwo.<verse eid="PSA 140:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6" />Ndabwira <char style="nd">Uhoraho</char> nti: “Uri Imana yanje.”</para>
  <para style="q2" vid="PSA 140:6">
    <char style="nd">Uhoraho</char>, niwumve ugutakamba kwanje.<verse eid="PSA 140:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7" />
    <char style="nd">Uhoraho</char> Nyeninganji, mutabazi wanje w’inkomezi,</para>
  <para style="q2" vid="PSA 140:7">wambika inkinzo umutwe wanje ku musi w’intambara.<verse eid="PSA 140:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8" />
    <char style="nd">Uhoraho</char>, ntuhe abanyakibi ivyo bipfuza;</para>
  <para style="q2" vid="PSA 140:8">ntureke ngo imigambi yabo ishirwe mu ngiro.<verse eid="PSA 140:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9" />Abankikuje bazunguza imitwe yabo mu bwibone;</para>
  <para style="q2" vid="PSA 140:9">amajambo mabi y’akanwa kabo abasubire ku mitwe.<verse eid="PSA 140:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10" />Amakara yaka asukwe ku mitwe yabo;</para>
  <para style="q2" vid="PSA 140:10">nibatererwe mu muriro,</para>
  <para style="q2" vid="PSA 140:10">batererwe mu vyobo vy’amazi, ntibigere bavayo.<verse eid="PSA 140:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11" />Abavuga abandi nabi ntibagume mu gihugu;</para>
  <para style="q2" vid="PSA 140:11">ivyago nibihige abantu b’umuryano.<verse eid="PSA 140:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12" />Ndazi ko <char style="nd">Uhoraho</char> aburanira abakene</para>
  <para style="q2" vid="PSA 140:12">agakiranira aboro.<verse eid="PSA 140:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13" />Ni ukuri abagororotsi bazohimbaza izina ryawe,</para>
  <para style="q2" vid="PSA 140:13">kandi abatunganye bazoba mu nyonga zawe.<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="cl">Zaburi ya 141</para>
  <para style="d">Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1" />
    <char style="nd">Uhoraho</char>, ndagutakambiye, tebuka uze aho ndi;</para>
  <para style="q2" vid="PSA 141:1">unyumve ninagutakambira.<verse eid="PSA 141:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2" />Ugusenga kwanje nigushike imbere yawe nk’umubavu;</para>
  <para style="q2" vid="PSA 141:2">ugutarika amaboko kwanje kube nk’ikimazi co ku mugoroba.<verse eid="PSA 141:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3" />Ushire umurinzi ku munwa wanje, <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 141:3">ugume uteramye ku rugi rw’iminwa yanje.<verse eid="PSA 141:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4" />Ntureke umutima wanje ngo uje mu bibi</para>
  <para style="q2" vid="PSA 141:4">ngo nifatanye n’inkozi z’ibibi</para>
  <para style="q1" vid="PSA 141:4">mu bikorwa bibi;</para>
  <para style="q2" vid="PSA 141:4">ntundeke ngo nsangire na bo ivyo bakunda kurya.<verse eid="PSA 141:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5" />Reka umugororotsi aze ankubite; kuko azoba ariko arangirira neza;</para>
  <para style="q2" vid="PSA 141:5">aze ampane; kuzoba ari ukunsiga amavuta ku mutwe.</para>
  <para style="q1" vid="PSA 141:5">Umutwe wanje ntuzovyanka,</para>
  <para style="q2" vid="PSA 141:5">kuko isengesho ryanje rizokwama rigwanya ibikorwa vy’inkozi z’ibibi.<verse eid="PSA 141:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6" />Abaganza babo nibatembagarizwe ku bitandara,</para>
  <para style="q2" vid="PSA 141:6">maze abanyakibi ni ho bazomenya ko amajambo yanje yari ay’ukuri.<verse eid="PSA 141:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7" />Bazovuga bati: “nk’uko umuntu arima agashitsa isuka,</para>
  <para style="q2" vid="PSA 141:7">ni ko amagufa yacu yasanzariye ku munwa w’imva.”<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8" />Ariko amaso yanje ndayahanze wewe, <char style="nd">Uhoraho</char> Nyeninganji;</para>
  <para style="q2" vid="PSA 141:8">muri wewe ni ho mpungiye; ntundeke ngo mpfe.<verse eid="PSA 141:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9" />Undinde kugwa mu mitego yatezwe n’inkozi z’ibibi,</para>
  <para style="q2" vid="PSA 141:9">mu mitego bateze imbere yanje.<verse eid="PSA 141:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10" />Abanyakibi nibagwe mu mitego bateze ubwabo,</para>
  <para style="q2" vid="PSA 141:10">nanje ndengane mu mahoro.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="cl">Zaburi ya 142</para>
  <para style="d">Ni masikili ya Dawidi. Aho yari mu kinogo. Ni isengesho.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1" />Ndatakambira <char style="nd">Uhoraho</char> n’ijwi rirenga;</para>
  <para style="q2" vid="PSA 142:1">nzoshira ijwi hejuru ntakambira <char style="nd">Uhoraho</char>.<verse eid="PSA 142:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2" />Ndasuka amajojwa yanje imbere yiwe;</para>
  <para style="q2" vid="PSA 142:2">ndavuga ivyago vyanje imbere yiwe.<verse eid="PSA 142:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3" />Iyo impwemu yanje icikiye intege muri jewe,</para>
  <para style="q2" vid="PSA 142:3">ni wewe urinda inzira yanje.</para>
  <para style="q1" vid="PSA 142:3">Mu nzira ngenderamwo</para>
  <para style="q2" vid="PSA 142:3">abantu banteze umutego.<verse eid="PSA 142:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4" />Birabe ubibone, nta n’umwe ari i buryo bwanje;</para>
  <para style="q2" vid="PSA 142:4">nta n’umwe anyitayeho.</para>
  <para style="q1" vid="PSA 142:4">Singira ubuhungiro;</para>
  <para style="q2" vid="PSA 142:4">nta n’umwe yitayeho ubugingo bwanje.<verse eid="PSA 142:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5" />Ndagutakambiye, <char style="nd">Uhoraho</char>;</para>
  <para style="q2" vid="PSA 142:5">ndavuga nti: “Uri ubuhungiro bwanje,</para>
  <para style="q2" vid="PSA 142:5">umugabane wanje mw’isi y’abazima.”<verse eid="PSA 142:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6" />Niwumve ugutakamba kwanje,</para>
  <para style="q2" vid="PSA 142:6">kuko ngowe cane;</para>
  <para style="q1" vid="PSA 142:6">ntabara unkize abampiga,</para>
  <para style="q2" vid="PSA 142:6">kuko bandusha inkomezi.<verse eid="PSA 142:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7" />Umbohore unkure mw’ibohero ndimwo,</para>
  <para style="q2" vid="PSA 142:7">kugira ngo mpimbaze izina ryawe.</para>
  <para style="q1" vid="PSA 142:7">Maze abagororotsi bazokoranira aho ndi,</para>
  <para style="q2" vid="PSA 142:7">kuko unyeretse ukugira neza kwawe.<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="cl">Zaburi ya 143</para>
  <para style="d">Ni Zaburi ya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1" />
    <char style="nd">Uhoraho</char>, niwumve ugusenga kwanje,</para>
  <para style="q2" vid="PSA 143:1">wumvirize ugutakamba kwanje;</para>
  <para style="q1" vid="PSA 143:1">mu bwizigirwa bwawe no mu kugororoka kwawe</para>
  <para style="q2" vid="PSA 143:1">nuze untabare.<verse eid="PSA 143:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2" />Ntujane umushumba wawe imbere y’intahe,</para>
  <para style="q2" vid="PSA 143:2">kuko ata n’umwe mu bakiri bazima agororotse imbere yawe.<verse eid="PSA 143:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3" />Umwansi arampiga,</para>
  <para style="q2" vid="PSA 143:3">antsinze hasi;</para>
  <para style="q1" vid="PSA 143:3">atumye mba ahantu h’umwijima</para>
  <para style="q2" vid="PSA 143:3">nk’abapfuye kera.<verse eid="PSA 143:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4" />Ni co gitumye impwemu yanje impondobereramwo;</para>
  <para style="q2" vid="PSA 143:4">umutima wanje ukaba wiheburiye muri jewe.<verse eid="PSA 143:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5" />Ndibuka imisi ya kera;</para>
  <para style="q2" vid="PSA 143:5">ndimbura ibikorwa vyawe vyose</para>
  <para style="q2" vid="PSA 143:5">nkiyumvira ku vyakozwe n’intoke zawe.<verse eid="PSA 143:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6" />Ndakugaranzurira amaboko;</para>
  <para style="q2" vid="PSA 143:6">ndakunyotewe nk’uko isi igadutse inyotererwa amazi.<verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7" />
    <char style="nd">Uhoraho</char> unyishure vuba;</para>
  <para style="q2" vid="PSA 143:7">umushaha wanje ucitse intege.</para>
  <para style="q1" vid="PSA 143:7">Ntumpishe mu nyonga hawe</para>
  <para style="q2" vid="PSA 143:7">kuko noca mba nk’abamanuka baja muri rwa rwobo.<verse eid="PSA 143:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8" />Igitondo nikinzanire ijambo ry’urukundo rwawe rudashira,</para>
  <para style="q2" vid="PSA 143:8">kuko nakwizigiye.</para>
  <para style="q1" vid="PSA 143:8">Nyereka inzira nkwiye kujana,</para>
  <para style="q2" vid="PSA 143:8">kuko ubugingo bwanje ari wewe nabujeje.<verse eid="PSA 143:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9" />Ntabara unkize abansi banje, <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 143:9">kuko muri wewe ari ho ninyegeje.<verse eid="PSA 143:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10" />Nyigisha gukora ivyo ugomba,</para>
  <para style="q2" vid="PSA 143:10">kuko uri Imana yanje;</para>
  <para style="q1" vid="PSA 143:10">icompa Mpwemu wawe mwiza</para>
  <para style="q2" vid="PSA 143:10">akandongorera ahantu hagororotse.<verse eid="PSA 143:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11" />Ku bw’izina ryawe, <char style="nd">Uhoraho</char>, kingira ubugingo bwanje;</para>
  <para style="q2" vid="PSA 143:11">mu kugororoka kwawe, nkura mu vyago.<verse eid="PSA 143:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12" />Mu rukundo rwawe rudashira, ziba akanwa k’abansi banje;</para>
  <para style="q2" vid="PSA 143:12">honya abangwanya,</para>
  <para style="q2" vid="PSA 143:12">kuko ndi umusavyi wawe.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="cl">Zaburi ya 144</para>
  <para style="d">Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1" />
    <char style="nd">Uhoraho</char> igitandara canje ahimbazwe,</para>
  <para style="q2" vid="PSA 144:1">yigisha amaboko yanje kugwana,</para>
  <para style="q2" vid="PSA 144:1">n’intoke zanje kuja mu ntambara.<verse eid="PSA 144:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2" />Ni Imana yanje y’urukundo n’igihome kinkingira,</para>
  <para style="q2" vid="PSA 144:2">umunara nihishamwo n’umurokozi wanje,</para>
  <para style="q1" vid="PSA 144:2">inkinzo yanje, uwo mpungirako,</para>
  <para style="q2" vid="PSA 144:2">acisha bugufi amoko musi y’ibirenge vyanje.<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3" />
    <char style="nd">Uhoraho</char>, abantu ni iki aho ubitwararika,</para>
  <para style="q2" vid="PSA 144:3">canke abana b’abantu aho ubiyumvirako?<verse eid="PSA 144:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4" />Bameze nk’impwemu zihumetswe;</para>
  <para style="q2" vid="PSA 144:4">imisi yabo ni nk’igitutu kirengana gusa.<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5" />
    <char style="nd">Uhoraho</char>, ugurura ijuru ryawe, umanuke kw’isi;</para>
  <para style="q2" vid="PSA 144:5">kora ku misozi, kugira ngo ipfunduke umwotsi.<verse eid="PSA 144:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6" />Rungika umuravyo usanzaze umwansi;</para>
  <para style="q2" vid="PSA 144:6">rasa imyampi yawe ubasanzaze.<verse eid="PSA 144:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7" />Ramvura ukuboko kwawe uri iyo mw’ijuru;</para>
  <para style="q2" vid="PSA 144:7">untabare undokore</para>
  <para style="q1" vid="PSA 144:7">unkize amazi asuriranya,</para>
  <para style="q2" vid="PSA 144:7">unkure mu kuboko kw’abanyamahanga;<verse eid="PSA 144:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8" />akanwa kabo kuzuye ibinyoma,</para>
  <para style="q2" vid="PSA 144:8">amaboko yabo y’i buryo arimwo ivy’ubugunge.<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9" />Mana yanje, nzokuririmbira indirimbo nsha,</para>
  <para style="q2" vid="PSA 144:9">nzogucurarangira inanga y’imirya cumi,<verse eid="PSA 144:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10" />wewe uha abami intsinzi,</para>
  <para style="q2" vid="PSA 144:10">ugakiza umusavyi wawe Dawidi inkota yica.<verse eid="PSA 144:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11" />Ndokora untabare;</para>
  <para style="q2" vid="PSA 144:11">unkure mu maboko y’abanyamahanga</para>
  <para style="q1" vid="PSA 144:11">akanwa kabo kuzuye ibinyoma,</para>
  <para style="q2" vid="PSA 144:11">amaboko yabo y’i buryo ni ingunge.<verse eid="PSA 144:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12" />Maze abahungu bacu, mu buto bwabo,</para>
  <para style="q2" vid="PSA 144:12">bazomera nk’imivyaro yatabiwe neza,</para>
  <para style="q1" vid="PSA 144:12">abakobwa bacu na bo bazoba nk’inkingi</para>
  <para style="q2" vid="PSA 144:12">zabarijwe gushariza ikirimba.<verse eid="PSA 144:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13" />Ibigega vyacu bizokwuzura</para>
  <para style="q2" vid="PSA 144:13">ivyimburwa vy’ubwoko bwose.</para>
  <para style="q1" vid="PSA 144:13">Intama zacu zizogwira incuro ibihumbi,</para>
  <para style="q2" vid="PSA 144:13">incuro ibihumbi cumi ziri ku misozi yacu;<verse eid="PSA 144:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 144:14" />inka zacu zizokwega imitwaro iremereye.</para>
  <para style="q1" vid="PSA 144:14">Nta birengero bizoba mu mpome zacu,</para>
  <para style="q2" vid="PSA 144:14">nta bazojanwa nk’inyagano,</para>
  <para style="q2" vid="PSA 144:14">nta bazoniha bari mu mayira yacu.<verse eid="PSA 144:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15" />Hahiriwe ihanga ibi bizoshikako;</para>
  <para style="q2" vid="PSA 144:15">hahiriwe ihanga rifise <char style="nd">Uhoraho</char> nk’Imana yaryo.<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="cl">Zaburi ya 145</para>
  <para style="d">Ni Zaburi yo gushima. Ni iya Dawidi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1" />Nzogushira hejuru, Mana yanje, wewe Mwami;</para>
  <para style="q2" vid="PSA 145:1">nzohimbaza izina ryawe ibihe bidashira.<verse eid="PSA 145:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2" />Imisi yose nzoguhimbaza</para>
  <para style="q2" vid="PSA 145:2">nshire hejuru izina ryawe ibihe n’ibihe.<verse eid="PSA 145:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3" />
    <char style="nd">Uhoraho</char> arahambaye kandi abereye gushimwa;</para>
  <para style="q2" vid="PSA 145:3">nta n’umwe yomenya ubukuru bwiwe.<verse eid="PSA 145:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4" />Urunganwe rubwira urundi ivyiza wakoze;</para>
  <para style="q2" vid="PSA 145:4">bavuga ivy’inkomezi wakoze.<verse eid="PSA 145:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5" />Bavuga ugukayangana kw’ubwiza bw’icubahiro cawe;</para>
  <para style="q2" vid="PSA 145:5">nanje nzorimbura ibikorwa vyawe bitangaje wakoze.<verse eid="PSA 145:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6" />Bavuga ivy’ubushobozi bw’ibihambaye wakoze;</para>
  <para style="q2" vid="PSA 145:6">nanje nzokwamamaza ibikorwa vyawe bihambaye.<verse eid="PSA 145:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7" />Bazohimbaza ukugira neza kwawe kwinshi,</para>
  <para style="q2" vid="PSA 145:7">baririmbane umunezero ivy’ukugororoka kwawe.<verse eid="PSA 145:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8" />
    <char style="nd">Uhoraho</char> agira impuhwe n’ubuntu,</para>
  <para style="q2" vid="PSA 145:8">ateba kuraka akagira urukundo rwinshi.<verse eid="PSA 145:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9" />
    <char style="nd">Uhoraho</char> agirira bose neza;</para>
  <para style="q2" vid="PSA 145:9">agirira imbabazi ivyo yaremye vyose.<verse eid="PSA 145:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10" />
    <char style="nd">Uhoraho</char>, ibikorwa vyawe vyose biraguhimbaza;</para>
  <para style="q2" vid="PSA 145:10">abizigirwa bawe bagushira hejuru.<verse eid="PSA 145:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11" />Bavuga icubahiro c’ubwami bwawe</para>
  <para style="q2" vid="PSA 145:11">kandi bavuga ivy’inkomezi wakoze,<verse eid="PSA 145:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12" />kugira ngo abantu bose bamenye ibikorwa vyawe bihambaye</para>
  <para style="q2" vid="PSA 145:12">n’ugukayangana kw’ubwiza bw’ubwami bwawe.<verse eid="PSA 145:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13" />Ubwami bwawe ntibuzogira iherezo,</para>
  <para style="q2" vid="PSA 145:13">n’ukuganza kwawe guhoraho uko urunganwe ruzokuranwa n’urundi.</para>
  <para style="b" vid="PSA 145:13" />
  <para style="q1" vid="PSA 145:13">
    <char style="nd">Uhoraho</char> ni uwo kwizigirwa mu vyo asezerana vyose</para>
  <para style="q2" vid="PSA 145:13">kandi ni umwizigirwa mu vyo akora vyose.<verse eid="PSA 145:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14" />
    <char style="nd">Uhoraho</char> ashigikira abaguye,</para>
  <para style="q2" vid="PSA 145:14">akavyura abacishijwe bugufi.<verse eid="PSA 145:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15" />Bose baguhanga amaso,</para>
  <para style="q2" vid="PSA 145:15">nawe ukabahaza ivyokurya mu gihe gikwiye.<verse eid="PSA 145:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16" />Upfundurura ikiganza cawe</para>
  <para style="q2" vid="PSA 145:16">ugahaza ukwipfuza kw’ibiri n’ubuzima vyose.<verse eid="PSA 145:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17" />
    <char style="nd">Uhoraho</char> aragororotse mu nzira ziwe zose</para>
  <para style="q2" vid="PSA 145:17">kandi ni umwizigirwa mu vyo akora vyose.<verse eid="PSA 145:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18" />
    <char style="nd">Uhoraho</char> aba hafi y’abamwambaza bose,</para>
  <para style="q2" vid="PSA 145:18">abamwambaza mu kuri bose.<verse eid="PSA 145:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19" />Ashitsa ivyo abamwubaha bipfuza;</para>
  <para style="q2" vid="PSA 145:19">yumva ugutakamba kwabo maze akabakiza.<verse eid="PSA 145:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20" />
    <char style="nd">Uhoraho</char> azigama abamukunda bose,</para>
  <para style="q2" vid="PSA 145:20">ariko abanyakibi azobahonya.<verse eid="PSA 145:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21" />Akanwa kanje kazovuga ivyo guhimbaza <char style="nd">Uhoraho</char>.</para>
  <para style="q2" vid="PSA 145:21">Ivyaremwe vyose nibihimbaze izina ryiwe ryera</para>
  <para style="q2" vid="PSA 145:21">ibihe bitazoshira.<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="cl">Zaburi ya 146</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1" />Haleluya.</para>
  <para style="b" vid="PSA 146:1" />
  <para style="q1" vid="PSA 146:1">Mutima wanje, himbaza <char style="nd">Uhoraho</char>.<verse eid="PSA 146:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2" />Nzohimbaza <char style="nd">Uhoraho</char> ubuzima bwanje bwose;</para>
  <para style="q2" vid="PSA 146:2">nzoririmba izo guhimbaza Imana yanje nkiriho.<verse eid="PSA 146:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3" />Ntimukishimire abahambaye,</para>
  <para style="q2" vid="PSA 146:3">canke abana b’abantu, badashobora gukiza.<verse eid="PSA 146:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4" />Iyo impwemu yabo ibavuyemwo, basubira mw’ivu,</para>
  <para style="q2" vid="PSA 146:4">kuri uwo musi nyene imigambi yabo igahinduka ubusa.<verse eid="PSA 146:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5" />Hahiriwe abahungira ku Mana ya Yakobo,</para>
  <para style="q2" vid="PSA 146:5">ivyizigiro vyabo bikaba k’<char style="nd">Uhoraho</char> Imana yabo.<verse eid="PSA 146:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6" />Ni we yaremye ijuru n’isi,</para>
  <para style="q2" vid="PSA 146:6">ikiyaga n’ibiri muri vyo vyose;</para>
  <para style="q2" vid="PSA 146:6">aguma ari umwizigirwa ibihe bidashira.<verse eid="PSA 146:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7" />Ni we aburanira abacinyizwa</para>
  <para style="q2" vid="PSA 146:7">akagaburira abashonje.</para>
  <para style="q1" vid="PSA 146:7">
    <char style="nd">Uhoraho</char> ni we abohora imbohe,<verse eid="PSA 146:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 146:8" />
    <char style="nd">Uhoraho</char> ni we ahumura impumyi,</para>
  <para style="q1" vid="PSA 146:8">
    <char style="nd">Uhoraho</char> ni we ashira hejuru abaciye bugufi,</para>
  <para style="q2" vid="PSA 146:8">
    <char style="nd">Uhoraho</char> ni we akunda abagororotsi.<verse eid="PSA 146:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9" />
    <char style="nd">Uhoraho</char> azigama inyambukira</para>
  <para style="q2" vid="PSA 146:9">agashigikira impfuvyi n’umupfakazi,</para>
  <para style="q2" vid="PSA 146:9">ariko inzira z’abanyakibi arazigoramika.<verse eid="PSA 146:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10" />
    <char style="nd">Uhoraho</char> aganje ibihe bidashira,</para>
  <para style="q2" vid="PSA 146:10">Imana yawe, ewe Siyoni,</para>
  <para style="q2" vid="PSA 146:10">iraganje uko urunganwe ruzokurikirana n’urundi.</para>
  <para style="b" vid="PSA 146:10" />
  <para style="q1" vid="PSA 146:10">Haleluya.<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="cl">Zaburi ya 147</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1" />Haleluya.</para>
  <para style="b" vid="PSA 147:1" />
  <para style="q1" vid="PSA 147:1">Ese ukuntu ari vyiza guhimbaza Imana yacu,</para>
  <para style="q2" vid="PSA 147:1">ese ukuntu bihimbaye kandi bibereye kuyihimbaza!<verse eid="PSA 147:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2" />
    <char style="nd">Uhoraho</char> yubaka Yerusalemu;</para>
  <para style="q2" vid="PSA 147:2">yegeranya aba Isirayeli bari barashwiragiye.<verse eid="PSA 147:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3" />Akiza abafise imitima imenetse</para>
  <para style="q2" vid="PSA 147:3">agapfuka inguma zabo.<verse eid="PSA 147:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4" />Aharura igitigiri c’inyenyeri</para>
  <para style="q2" vid="PSA 147:4">agahamagara imwimwe yose mw’izina.<verse eid="PSA 147:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5" />Umwami wacu arahambaye kandi ni umuhizi mu nkomezi:</para>
  <para style="q2" vid="PSA 147:5">ugutahura kwiwe ntikugira akarimbi.<verse eid="PSA 147:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6" />
    <char style="nd">Uhoraho</char> ashigikira abaciye bugufi</para>
  <para style="q2" vid="PSA 147:6">agacisha bugufi abanyakibi akabashitsa hasi.<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7" />Nimuririmbire <char style="nd">Uhoraho</char> indirimbo yo gushima;</para>
  <para style="q2" vid="PSA 147:7">nimucurarangire inanga Imana yacu.<verse eid="PSA 147:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8" />Apfukisha ijuru ibicu;</para>
  <para style="q2" vid="PSA 147:8">agaha isi imvura</para>
  <para style="q2" vid="PSA 147:8">akameza ivyatsi ku turambi.<verse eid="PSA 147:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9" />Ategurira amasho ivyokurya</para>
  <para style="q2" vid="PSA 147:9">n’ivyana vy’ibikona iyo bijwiragiye.<verse eid="PSA 147:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10" />Ntahimbarwa n’inkomezi z’ifarasi,</para>
  <para style="q2" vid="PSA 147:10">canke ngo yishimire amaguru y’umuhizi;<verse eid="PSA 147:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11" />
    <char style="nd">Uhoraho</char> ahimbarwa n’abamwubaha,</para>
  <para style="q2" vid="PSA 147:11">abishimira urukundo rwiwe rudashira.<verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12" />Nushime <char style="nd">Uhoraho</char>, ewe Yerusalemu;</para>
  <para style="q2" vid="PSA 147:12">uhimbaze Imana yawe, ewe Siyoni.<verse eid="PSA 147:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13" />Ni we akomeza imyugariro yawe</para>
  <para style="q2" vid="PSA 147:13">agaha umugisha abantu baba muri wewe.<verse eid="PSA 147:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14" />Atanga impore ku mbibe zawe,</para>
  <para style="q2" vid="PSA 147:14">akaguhaza ingano nziza cane.<verse eid="PSA 147:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15" />Atuma amabwirizwa yiwe kw’isi,</para>
  <para style="q2" vid="PSA 147:15">ijambo ryiwe rikagenda rinyaruka.<verse eid="PSA 147:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16" />Akwiragiza shelegi nk’ubwoya bw’intama,</para>
  <para style="q2" vid="PSA 147:16">ugukanya akagusanzaza nk’umunyota.<verse eid="PSA 147:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17" />Arekura urubura rwiwe nk’amabuye.</para>
  <para style="q2" vid="PSA 147:17">Ni nde yoshobora kurinda imbeho yiwe?<verse eid="PSA 147:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18" />Atuma ijambo ryiwe ngo riyashongeshe;</para>
  <para style="q2" vid="PSA 147:18">atuma umuyaga wiwe, amazi agashonga.<verse eid="PSA 147:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19" />Yahishuriye Yakobo ijambo ryiwe,</para>
  <para style="q2" vid="PSA 147:19">ivyagezwe vyiwe n’amategeko yiwe yabihishuriye Isirayeli.<verse eid="PSA 147:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20" />Nta rindi hanga na rimwe yakoreye nk’ivyo;</para>
  <para style="q2" vid="PSA 147:20">ntibazi ivyagezwe vyiwe.</para>
  <para style="b" vid="PSA 147:20" />
  <para style="q1" vid="PSA 147:20">Haleluya.<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="cl">Zaburi ya 148</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1" />Haleluya.</para>
  <para style="b" vid="PSA 148:1" />
  <para style="q1" vid="PSA 148:1">Nimuhimbarize <char style="nd">Uhoraho</char> iyo mw’ijuru;</para>
  <para style="q2" vid="PSA 148:1">mumuhimbarize ahasumba amajuru.<verse eid="PSA 148:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2" />Mumuhimbaze, yemwe bamarayika biwe;</para>
  <para style="q2" vid="PSA 148:2">mumuhimbaze, namwe nyenyeri zo kw’ijuru.<verse eid="PSA 148:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3" />Nimumuhimbaze, zuba n’ukwezi;</para>
  <para style="q2" vid="PSA 148:3">mumuhimbaze yemwe nyenyeri zaka mwese.<verse eid="PSA 148:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4" />Nimumuhimbaze, yemwe majuru asumba ayandi</para>
  <para style="q2" vid="PSA 148:4">namwe mazi yo hejuru.<verse eid="PSA 148:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5" />Abo nibahimbaze izina ry’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 148:5">kuko yategetse bikabaho,<verse eid="PSA 148:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6" />kandi yabishingiye aho kuba ibihe bidashira;</para>
  <para style="q2" vid="PSA 148:6">yashinze itegeko ritazokwigera rivaho.<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7" />Nimuhimbaze <char style="nd">Uhoraho</char> mw’isi,</para>
  <para style="q2" vid="PSA 148:7">yemwe vyaremwe bininibinini vyo mu kiyaga namwe madamba y’ibiyaga,<verse eid="PSA 148:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8" />miravyo, rubura, shelegi namwe bicu,</para>
  <para style="q2" vid="PSA 148:8">mwa bihuhusi mwumvira itegeko ryiwe,<verse eid="PSA 148:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9" />yemwe misozi n’uturambi twose,</para>
  <para style="q2" vid="PSA 148:9">biti vyama n’amasederi yose,<verse eid="PSA 148:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10" />bikoko vyo mw’ishamba n’amasho yose,</para>
  <para style="q2" vid="PSA 148:10">ivyaremwe bitobito n’inyoni zo mu kirere,<verse eid="PSA 148:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11" />bami bo kw’isi n’amahanga yose,</para>
  <para style="q2" vid="PSA 148:11">yemwe baganwa n’abatware bose bo kw’isi,<verse eid="PSA 148:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12" />yemwe basore n’inkumi,</para>
  <para style="q2" vid="PSA 148:12">batama namwe bana.<verse eid="PSA 148:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13" />Abo nibahimbaze izina ry’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="PSA 148:13">kuko izina ryiwe ryo nyene ari ryo rishizwe hejuru;</para>
  <para style="q2" vid="PSA 148:13">icubahiro ciwe kiri hejuru y’isi n’ijuru.<verse eid="PSA 148:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14" />Kandi yahagurukirije ihembe abantu biwe,</para>
  <para style="q2" vid="PSA 148:14">ishimwe ry’abasavyi biwe bose bizigirwa,</para>
  <para style="q2" vid="PSA 148:14">rya Isirayeli, ihanga riri ku mutima wiwe.</para>
  <para style="b" vid="PSA 148:14" />
  <para style="q1" vid="PSA 148:14">Haleluya.<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="cl">Zaburi ya 149</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1" />Haleluya.</para>
  <para style="b" vid="PSA 149:1" />
  <para style="q1" vid="PSA 149:1">Nimuririmbire <char style="nd">Uhoraho</char> indirimbo nsha,</para>
  <para style="q2" vid="PSA 149:1">mumuririmbire ishimwe mw’ikoraniro ry’abera biwe.<verse eid="PSA 149:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2" />Isirayeli nibanezerererwe Umuremyi wabo;</para>
  <para style="q2" vid="PSA 149:2">ab’i Siyoni nibanezerererwe Umwami wabo.<verse eid="PSA 149:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3" />Nibahimbaze izina ryiwe batamba</para>
  <para style="q2" vid="PSA 149:3">bamuvugirize umurya w’inanga n’umurisho w’ingoma.<verse eid="PSA 149:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4" />Kuko <char style="nd">Uhoraho</char> ahimbarirwa abantu biwe;</para>
  <para style="q2" vid="PSA 149:4">yambika abaciye bugufi ukunesha nk’igitsibo.<verse eid="PSA 149:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5" />Abera biwe nibanezererwe icubahiro ciwe</para>
  <para style="q2" vid="PSA 149:5">bamuvugirize impundu bari ku mariri yabo.<verse eid="PSA 149:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6" />Uguhimbaza Imana kube mu kanwa kabo</para>
  <para style="q2" vid="PSA 149:6">bafise inkota y’ubugi bubiri mu ntoke,<verse eid="PSA 149:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7" />kugira ngo bihore amahanga</para>
  <para style="q2" vid="PSA 149:7">bahane amoko,<verse eid="PSA 149:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8" />bongere baboheshe iminyororo abami bayo,</para>
  <para style="q2" vid="PSA 149:8">abaganwa bayo bababoheshe imigozi y’ivyuma,<verse eid="PSA 149:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9" />maze bashitse urubanza bandikiwe ko bazohanwa;</para>
  <para style="q2" vid="PSA 149:9">ico ni co cubahiro c’abera biwe.</para>
  <para style="b" vid="PSA 149:9" />
  <para style="q1" vid="PSA 149:9">Haleluya.<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="cl">Zaburi ya 150</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1" />Haleluya.</para>
  <para style="b" vid="PSA 150:1" />
  <para style="q1" vid="PSA 150:1">Nimuhimbarize Imana ahera hayo;</para>
  <para style="q2" vid="PSA 150:1">muyihimbarize no mu majuru yayo yuzuye inkomezi.<verse eid="PSA 150:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2" />Nimuyihimbarize ivy’inkomezi yakoze;</para>
  <para style="q2" vid="PSA 150:2">muyimbarize ubukuru bwayo buhambaye.<verse eid="PSA 150:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3" />Nimuyihimbarishe ijwi rirengera ry’inzamba,</para>
  <para style="q2" vid="PSA 150:3">muyishimishe inanga n’ikembe,<verse eid="PSA 150:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4" />muyihimbarishe umurisho w’ingoma n’imvyino,</para>
  <para style="q2" vid="PSA 150:4">muyihimbarishe imirya y’inanga n’umwironge,<verse eid="PSA 150:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5" />muyihimbaze muvuza ivyuma bisamirana.</para>
  <para style="q2" vid="PSA 150:5">Muyihimbarishe ijwi rirengera ry’ivyuma bisamirana.<verse eid="PSA 150:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6" />Ibihumeka vyose nibihimbaze <char style="nd">Uhoraho</char>.</para>
  <para style="b" vid="PSA 150:6" />
  <para style="q1" vid="PSA 150:6">Haleluya.<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>