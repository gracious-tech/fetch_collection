  <para style="h">Mika</para>
  <para style="toc1">Igitabu c’uwavugishwa n’Imana Mika</para>
  <para style="toc2">Mika</para>
  <para style="toc3">Mik</para>
  <para style="mt2">Igitabu c’uwavugishwa n’Imana</para>
  <para style="mt1">Mika</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />Iri ni ijambo <char style="nd">Uhoraho</char> yatumye kuri Mika w’i Moresheti ku ngoma ya Yotamu n’iya Ahazi hamwe n’iya Hezekiya, abami b’i Buyuda, ngo avuge ivyo yeretswe kuri Samariya na Yerusalemu.<verse eid="MIC 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2" />Nimwumve, yemwe mahanga, nimwumve mwese;</para>
  <para style="q2" vid="MIC 1:2">umviriza, ewe wa si we hamwe na mwebwe mwese abayibako,</para>
  <para style="q1" vid="MIC 1:2">
    <char style="nd">Uhoraho</char> Nyeninganji ariko arabagiriza,</para>
  <para style="q2" vid="MIC 1:2">
    <char style="nd">Uhoraho</char> avuga ari mu rusengero rwiwe rwera.<verse eid="MIC 1:2" /></para>
  <para style="s1">Urubanza ruciriwe Samariya na Yerusalemu</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3" />Raba, <char style="nd">Uhoraho</char> ariko araza ava iwe;</para>
  <para style="q2" vid="MIC 1:3">aramanutse aza kandi agendagenda ku dutwe tw’isi.<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />Imisozi ishongera musi y’ibirenge vyiwe</para>
  <para style="q2" vid="MIC 1:4">n’ibiyaya birasadaguritse,</para>
  <para style="q1" vid="MIC 1:4">nk’ishashara ihuye n’umuriro,</para>
  <para style="q2" vid="MIC 1:4">nk’amazi atemba ahamanuka.<verse eid="MIC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5" />Ivyo vyose ni kubera ukugabitanya kwa Yakobo,</para>
  <para style="q2" vid="MIC 1:5">kubera ivyaha vy’ab’inzu y’Abisirayeli.</para>
  <para style="q1" vid="MIC 1:5">Icaha ca Yakobo ni ikihe?</para>
  <para style="q2" vid="MIC 1:5">Mbega si Samariya?</para>
  <para style="q1" vid="MIC 1:5">Ikibanza co gusengeramwo ibigirwamana co ku mpinga z’umusozi ca Yuda ni ikihe?</para>
  <para style="q2" vid="MIC 1:5">Mbega si Yerusalemu?<verse eid="MIC 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6" />“Nuko rero nzohindura Samariya habe ikigunguzi c’umusaka,</para>
  <para style="q2" vid="MIC 1:6">ahantu ho kurima imizabibu.</para>
  <para style="q1" vid="MIC 1:6">Nzotembagariza amabuye yaho mu mwonga</para>
  <para style="q2" vid="MIC 1:6">amatanguriro yaho ndayasige agaragara.<verse eid="MIC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7" />Ibigirwamana vyaho vyose bizomenagurwa;</para>
  <para style="q2" vid="MIC 1:7">amashikanwa y’ingoro zaho azotongorwa n’umuriro;</para>
  <para style="q2" vid="MIC 1:7">nzosambura ibishushanyo vyaho vyose.</para>
  <para style="q1" vid="MIC 1:7">Kuko vyavuye mu mashikanwa y’ingero z’abamaraya,</para>
  <para style="q2" vid="MIC 1:7">bizokwongera gukoreshwa kandi nk’ingero z’abamaraya.”<verse eid="MIC 1:7" /></para>
  <para style="s1">Kurira no Kugandara</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8" />Kubera ivyo nzorira mboroge;</para>
  <para style="q2" vid="MIC 1:8">ngende gusa kandi ata birato nambaye.</para>
  <para style="q1" vid="MIC 1:8">Nzobweja nk’imbwebwe</para>
  <para style="q2" vid="MIC 1:8">kandi nzokwabira nk’inyanana.<verse eid="MIC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9" />Kuko igikomere ca Samariya kidakira;</para>
  <para style="q2" vid="MIC 1:9">carandagase gishika n’i Buyuda.</para>
  <para style="q1" vid="MIC 1:9">Cashitse no kw’irembo ry’abantu banje,</para>
  <para style="q2" vid="MIC 1:9">mbere n’i Yerusalemu ubwaho.<verse eid="MIC 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10" />Ntimubibwire abansi b’i Gati;</para>
  <para style="q2" vid="MIC 1:10">ntimurire na gatoya.</para>
  <para style="q1" vid="MIC 1:10">Yemwe bantu b’i Beti-Leyafura,</para>
  <para style="q2" vid="MIC 1:10">nimwikumbagaze mu mukungugu.<verse eid="MIC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11" />Nimurengane muri ubusa mumaramaye,</para>
  <para style="q2" vid="MIC 1:11">yemwe ababa i Shafiri.</para>
  <para style="q1" vid="MIC 1:11">Ababa i Zanani</para>
  <para style="q2" vid="MIC 1:11">ntibazosohoka.</para>
  <para style="q1" vid="MIC 1:11">Beti-Ezeli bari mu kigandaro;</para>
  <para style="q2" vid="MIC 1:11">ntihakigukingira.<verse eid="MIC 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12" />Ababa i Maroti bari mu gatengo,</para>
  <para style="q2" vid="MIC 1:12">barindiriye ugutezurirwa,</para>
  <para style="q1" vid="MIC 1:12">kuko ikiza cavuye k’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="MIC 1:12">kigashika no kw’irembo ry’i Yerusalemu.<verse eid="MIC 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13" />Yemwe ababa i Lakishi,</para>
  <para style="q2" vid="MIC 1:13">nimubohere amafarasi anyaruka ku mikogote.</para>
  <para style="q1" vid="MIC 1:13">Ni mwebwe mwatumye,</para>
  <para style="q2" vid="MIC 1:13">umukobwa w’i Siyoni acumura</para>
  <para style="q2" vid="MIC 1:13">kuko ibigabitanyo vya Isirayeli vyabonetse muri wewe.<verse eid="MIC 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14" />Nuko rero muzosezera</para>
  <para style="q2" vid="MIC 1:14">Moresheti-Gati.</para>
  <para style="q1" vid="MIC 1:14">Igisagara c’i Akizibu kizoba ivyizigiro vy’uruhendo</para>
  <para style="q2" vid="MIC 1:14">ku bami ba Isirayeli.<verse eid="MIC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15" />Nzozana uwuzobigarurira</para>
  <para style="q2" vid="MIC 1:15">yemwe ababa i Maresha.</para>
  <para style="q1" vid="MIC 1:15">Abanyacubahiro bo muri Isirayeli</para>
  <para style="q2" vid="MIC 1:15">bazohungira muri Adulamu.<verse eid="MIC 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16" />Nimwimoshe inkomvorera mugandare</para>
  <para style="q2" vid="MIC 1:16">kuko abana munezerererwa bafashwe;</para>
  <para style="q1" vid="MIC 1:16">imitwe yanyu imere nk’iy’ikinyamwanira,</para>
  <para style="q2" vid="MIC 1:16">kuko bazovanwa muri mwebwe bajanwe ari inyagano.<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s1">Imigambi y’abantu inyuranye n’iy’Imana</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1" />Baragowe abategura imigambi y’inabi,</para>
  <para style="q2" vid="MIC 2:1">bakiyumvirira ku buriri bwabo imigambi yo gukora ikibi!</para>
  <para style="q1" vid="MIC 2:1">Bukeye, bakayishira mu ngiro,</para>
  <para style="q2" vid="MIC 2:1">kuko babifitiye ubushobozi.<verse eid="MIC 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2" />Bipfuza amatongo maze bakayiha ku nguvu,</para>
  <para style="q2" vid="MIC 2:2">n’amazu, bagaca bayanyaga.</para>
  <para style="q1" vid="MIC 2:2">Banyaga abantu amazu yabo,</para>
  <para style="q2" vid="MIC 2:2">bakabiba ivyo barazwe.<verse eid="MIC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3" />Nuko rero, <char style="nd">Uhoraho</char> avuze ati:</para>
  <para style="q1" vid="MIC 2:3">“Ndiko ndategura ivyago ku bw’aba bantu,</para>
  <para style="q2" vid="MIC 2:3">ivyo mudashobora kwikiza.</para>
  <para style="q1" vid="MIC 2:3">Ntimuzosubira kugendana ubwibone,</para>
  <para style="q2" vid="MIC 2:3">kuko kizoba ari igihe c’amakuba.<verse eid="MIC 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4" />Kuri uwo musi abansi banyu bazobatwenga;</para>
  <para style="q2" vid="MIC 2:4">bazobaririmbira iyi ndirimbo y’agacurantimba bati:</para>
  <para style="q1" vid="MIC 2:4">‘Turaherengeteye;</para>
  <para style="q2" vid="MIC 2:4">ishamvu y’ubwoko bwanje igabuwemwo ibice.</para>
  <para style="q1" vid="MIC 2:4">Ehe arayinyatse!</para>
  <para style="q2" vid="MIC 2:4">Ayihaye abatujanye nk’inyagano.’ ”<verse eid="MIC 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5" />Nuko rero ntuzoronka n’umwe mw’ikoraniro ry’Uhoraho,</para>
  <para style="q2" vid="MIC 2:5">wo kugorora umugozi mu gihe co kugabanganya igihugu mu mashamvu.<verse eid="MIC 2:5" /></para>
  <para style="s1">Abavugishwa b’ibinyoma</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6" />Ba kamenyi babo bavuga ngo: “Ntuvugishwe!</para>
  <para style="q2" vid="MIC 2:6">Ntuvugishwe kuri ivyo;</para>
  <para style="q2" vid="MIC 2:6">kuko ivyago ntibizodushikako.”<verse eid="MIC 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7" />Yemwe abakomoka kuri Yakobo, mbega mwovuga ngo:</para>
  <para style="q2" vid="MIC 2:7">“<char style="nd">Uhoraho</char> vyamunaniye kwihangana?</para>
  <para style="q2" vid="MIC 2:7">Mbega yokora ikintu nk’ico?”</para>
  <para style="b" vid="MIC 2:7" />
  <para style="q1" vid="MIC 2:7">Mbega amajambo yanje ntagirira neza</para>
  <para style="q2" vid="MIC 2:7">abagenda batunganye?<verse eid="MIC 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8" />Ariko ubu nyene abantu banje barahagurutse</para>
  <para style="q2" vid="MIC 2:8">bahagurutse kurya kw’umwansi.</para>
  <para style="q1" vid="MIC 2:8">Mwambura amakoti</para>
  <para style="q2" vid="MIC 2:8">abantu birenganira ata co binona,</para>
  <para style="q2" vid="MIC 2:8">mukabateza umubabaro nk’uw’umuntu agarutse avuye ku rugamba.<verse eid="MIC 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9" />Musohora abagore bo mu bantu banje</para>
  <para style="q2" vid="MIC 2:9">mukabakura mu mazu yabo bakunda.</para>
  <para style="q1" vid="MIC 2:9">Mukaka umugisha wanje</para>
  <para style="q2" vid="MIC 2:9">abana babo ibihe vyose.<verse eid="MIC 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10" />Haguruka, genda!</para>
  <para style="q2" vid="MIC 2:10">Kuko ngaha ata buruhukiro bwanyu buriho,</para>
  <para style="q1" vid="MIC 2:10">kubera yuko hahumanye,</para>
  <para style="q2" vid="MIC 2:10">harasambutse, ku buryo hatakivurwa.<verse eid="MIC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11" />Haje umubeshi kandi w’umusukanyi akababwira ati:</para>
  <para style="q2" vid="MIC 2:11">“Ngomba mvugishwe ko muzoronka umuvinyu n’inzoga nyinshi,”</para>
  <para style="q2" vid="MIC 2:11">uwo ni we muvugishwa aba bantu boshima!<verse eid="MIC 2:11" /></para>
  <para style="s1">Imana isezerana gutabarwa</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12" />“Umusi umwe yewe Yakobo, nzosubira kubegeraniriza hamwe mwese;</para>
  <para style="q2" vid="MIC 2:12">ni ukuri nzokwegeranya amasigarira yose y’Abisirayeli.</para>
  <para style="q1" vid="MIC 2:12">Nzobazana ndabashire hamwe nk’intama mu ruhongore,</para>
  <para style="q2" vid="MIC 2:12">nk’umukuku uri aho urisha;</para>
  <para style="q2" vid="MIC 2:12">aha hantu hazosubira kwuzura uruja n’uruza rw’abantu.<verse eid="MIC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13" />Uwubacira icanzo azoduga ari imbere yabo;</para>
  <para style="q2" vid="MIC 2:13">bazomena irembo ry’abansi basohoke.</para>
  <para style="q1" vid="MIC 2:13">Umwami wabo azobaja imbere mu gusohoka.</para>
  <para style="q2" vid="MIC 2:13">
    <char style="nd">Uhoraho</char> ubwiwe ni we azobarongora.”<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s1">Imana ihambarira abatware n’abavugishwa</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />Maze ndavuga nti:</para>
  <para style="q1" vid="MIC 3:1">“Nimwumve yemwe batware bo mu ba Yakobo,</para>
  <para style="q2" vid="MIC 3:1">yemwe barongozi b’Abisirayeli.</para>
  <para style="q1" vid="MIC 3:1">Mbega ntimwokwitaho guca imanza zibereye,<verse eid="MIC 3:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 3:2" />mwebwe mwanka ivyiza mugakunda ibibi;</para>
  <para style="q1" vid="MIC 3:2">yemwe ababaga abantu banje mukabakurako urusato</para>
  <para style="q2" vid="MIC 3:2">n’inyama mukazikura ku magufa yabo;<verse eid="MIC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3" />yemwe abarya inyama z’abantu banje,</para>
  <para style="q2" vid="MIC 3:3">mubakurako urusato</para>
  <para style="q2" vid="MIC 3:3">mukavunagura amagufa yabo;</para>
  <para style="q1" vid="MIC 3:3">mukabahimbagura mubakurako inyama muteka mu tubehe,</para>
  <para style="q2" vid="MIC 3:3">hamwe n’izo muteka mu nkono.”<verse eid="MIC 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4" />Maze mu nyuma mugatakambira <char style="nd">Uhoraho</char>, mutewe n’ivyago</para>
  <para style="q2" vid="MIC 3:4">ariko ntabishure.</para>
  <para style="q1" vid="MIC 3:4">Muri ico gihe azobahisha mu nyonga hiwe</para>
  <para style="q2" vid="MIC 3:4">kubera ibibi mwakoze.<verse eid="MIC 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5" />Uku ni ko <char style="nd">Uhoraho</char> avuze:</para>
  <para style="q1" vid="MIC 3:5">“Nk’uko biri kuri ba kamenyi</para>
  <para style="q2" vid="MIC 3:5">bazimiza abantu banje,</para>
  <para style="q1" vid="MIC 3:5">bavuga ‘amahoro’</para>
  <para style="q2" vid="MIC 3:5">iyo bafise ico barya,</para>
  <para style="q1" vid="MIC 3:5">ariko bagategura intambara yo kugwanya umuntu wese</para>
  <para style="q2" vid="MIC 3:5">yanse kubaha ivyo barya.<verse eid="MIC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6" />Ni co gituma ijoro rizobazako, ntihagire ico mwerekwa,</para>
  <para style="q2" vid="MIC 3:6">n’umwijima, ntimugire ico muragura.</para>
  <para style="q1" vid="MIC 3:6">Izuba rizocokerera kuri abo bavugishwa,</para>
  <para style="q2" vid="MIC 3:6">kandi buzobirirako.<verse eid="MIC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7" />Ba kamenyi bazomaramara</para>
  <para style="q2" vid="MIC 3:7">n’abaragura bazoteterwa.</para>
  <para style="q1" vid="MIC 3:7">Bose bazokwitwikira mu maso,</para>
  <para style="q2" vid="MIC 3:7">kuko ata kwishurwa kuvuye ku Mana.”<verse eid="MIC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8" />Ariko jeho, nuzuye inkomezi,</para>
  <para style="q2" vid="MIC 3:8">nuzuye Mpwemu w’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="MIC 3:8">nuzuye uguca imanza zibereye n’ubuhizi,</para>
  <para style="q1" vid="MIC 3:8">ngo menyeshe aba Yakobo ibigabitanyo vyabo,</para>
  <para style="q2" vid="MIC 3:8">n’Abisirayeli icaha cabo.<verse eid="MIC 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9" />Nimwumve, yemwe batware bo mu ba Yakobo,</para>
  <para style="q2" vid="MIC 3:9">yemwe abaganza abandi bo mu Bisirayeli,</para>
  <para style="q1" vid="MIC 3:9">mwanka imanza zibereye,</para>
  <para style="q2" vid="MIC 3:9">ivy’ukuri mukabinyikiza.<verse eid="MIC 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10" />Siyoni muhubakisha gusesa amaraso,</para>
  <para style="q2" vid="MIC 3:10">Yerusalemu mukahubakisha gukora ibibi.<verse eid="MIC 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11" />Abatware baho baca imanza bariye ibiturire,</para>
  <para style="q2" vid="MIC 3:11">abaherezi baho bigishiriza kuronka inyungu,</para>
  <para style="q2" vid="MIC 3:11">kandi abavugishwa baho baragurira kuronka amahera.</para>
  <para style="q1" vid="MIC 3:11">Ariko bakarondera <char style="nd">Uhoraho</char> ngo abashigikire bavuga bati:</para>
  <para style="q2" vid="MIC 3:11">“Mbega <char style="nd">Uhoraho</char> ntari muri twebwe?</para>
  <para style="q2" vid="MIC 3:11">Nta cago kizodushikako.”<verse eid="MIC 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12" />Ni co gituma kubera mwebwe,</para>
  <para style="q2" vid="MIC 3:12">Siyoni hazorimwa hamere nk’umurima,</para>
  <para style="q1" vid="MIC 3:12">Yerusalemu hazoba ikigunguzi c’isakamburira,</para>
  <para style="q2" vid="MIC 3:12">umusozi wubatsweko Ingoro na wo uzomerako ibisaka.<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s1">Umusozi w’<char style="nd">Uhoraho</char></para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1" />Mu misi y’iherezo</para>
  <para style="q1" vid="MIC 4:1">umusozi uriko ingoro y’<char style="nd">Uhoraho</char> uzoba ushimangiwe</para>
  <para style="q2" vid="MIC 4:1">nk’umusozi usumba iyindi yose;</para>
  <para style="q1" vid="MIC 4:1">uzoshirwa hejuru usumbe udusozi twose;</para>
  <para style="q2" vid="MIC 4:1">kandi amoko azohondogana aja kuri wo.<verse eid="MIC 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2" />Amahanga menshi azoza avuge ati:</para>
  <para style="q1" vid="MIC 4:2">“Nimuze tuduge tuje ku musozi w’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="MIC 4:2">mu ngoro y’Imana ya Yakobo.</para>
  <para style="q1" vid="MIC 4:2">Izotwigisha inzira zayo</para>
  <para style="q2" vid="MIC 4:2">kugira ngo tuzigenderemwo.”</para>
  <para style="q1" vid="MIC 4:2">Kuko i Siyoni ari ho hazova ivyagezwe,</para>
  <para style="q2" vid="MIC 4:2">ijambo ry’<char style="nd">Uhoraho</char> rive i Yerusalemu.<verse eid="MIC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />Azocira imanza amoko menshi</para>
  <para style="q2" vid="MIC 4:3">atature amatati hagati y’amahanga akomeye ya kure.</para>
  <para style="q1" vid="MIC 4:3">Inkota zabo bazozicuramwo amasuka,</para>
  <para style="q2" vid="MIC 4:3">amacumu yabo bayacuremwo imihoro.</para>
  <para style="q1" vid="MIC 4:3">Nta hanga rizosubira gutera irindi,</para>
  <para style="q2" vid="MIC 4:3">kandi ntibazosubira kwiga ivy’intambara.<verse eid="MIC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />Umuntu wese azokwicara musi y’umuzabibu wiwe</para>
  <para style="q2" vid="MIC 4:4">no musi y’umusukoni wiwe,</para>
  <para style="q1" vid="MIC 4:4">kandi nta n’umwe azobatera ubwoba,</para>
  <para style="q2" vid="MIC 4:4">kuko <char style="nd">Uhoraho</char> Mushoboravyose abivuze.<verse eid="MIC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5" />Naho amoko yose yogendera</para>
  <para style="q2" vid="MIC 4:5">mw’izina ry’imana zabo,</para>
  <para style="q1" vid="MIC 4:5">tweho tuzogendera mw’izina ry’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="MIC 4:5">Imana yacu ibihe bidashira.<verse eid="MIC 4:5" /></para>
  <para style="s1">Umugambi w’<char style="nd">Uhoraho</char></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6" />“Kuri uwo musi,” ni ko <char style="nd">Uhoraho</char> avuze,</para>
  <para style="q2" vid="MIC 4:6">“nzokoranya ibimuga;</para>
  <para style="q1" vid="MIC 4:6">nzokoraniriza hamwe abajanywe ari inyagano</para>
  <para style="q2" vid="MIC 4:6">n’abo nateye umubabaro.<verse eid="MIC 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7" />Nzohindura ibimuga bibe amasigarira yanje,</para>
  <para style="q2" vid="MIC 4:7">n’abirukanywe nzobahindura ihanga rikomeye.</para>
  <para style="q1" vid="MIC 4:7">
    <char style="nd">Uhoraho</char> azobarongora ari ku musozi Siyoni</para>
  <para style="q2" vid="MIC 4:7">uhereye uwo musi gushika ibihe bidashira.<verse eid="MIC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8" />Ariko weho, munara w’inderetsi w’umukuku,</para>
  <para style="q2" vid="MIC 4:8">munara w’ubuhungiro bw’umukobwa w’i Siyoni,</para>
  <para style="q1" vid="MIC 4:8">uzosubizwa ububasha bwo kuganza kwawe wahoranye;</para>
  <para style="q2" vid="MIC 4:8">ubwami buzohabwa umukobwa w’i Yerusalemu.”<verse eid="MIC 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9" />Ni kuki none uboroga,</para>
  <para style="q2" vid="MIC 4:9">mbega nta mwami ufise?</para>
  <para style="q1" vid="MIC 4:9">Umutware wawe yapfuye,</para>
  <para style="q2" vid="MIC 4:9">ko uburibwe bugufashe nk’umugore ageze kwibaruka?<verse eid="MIC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10" />Babara uboroge, yewe mukobwa w’i Siyoni,</para>
  <para style="q2" vid="MIC 4:10">nk’umugore ari ku bise,</para>
  <para style="q1" vid="MIC 4:10">kuko ugiye kuva muri iki gisagara</para>
  <para style="q2" vid="MIC 4:10">uje kuba mu makambi yo mu gahinga.</para>
  <para style="q1" vid="MIC 4:10">Muzoja i Babiloni;</para>
  <para style="q2" vid="MIC 4:10">aho ni ho muzotabarirwa.</para>
  <para style="q1" vid="MIC 4:10">Aho ni ho <char style="nd">Uhoraho</char> azobacungurira</para>
  <para style="q2" vid="MIC 4:10">abakuye mu maboko y’abansi banyu.<verse eid="MIC 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11" />Ariko ubu amoko menshi</para>
  <para style="q2" vid="MIC 4:11">akoraniye hamwe ngo abagwanye.</para>
  <para style="q1" vid="MIC 4:11">Bavuga bati: “Reka tuhahumanye,</para>
  <para style="q2" vid="MIC 4:11">amaso yacu yirabire uburyo Siyoni hasamburwa!”<verse eid="MIC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12" />Ariko bo ntibazi</para>
  <para style="q2" vid="MIC 4:12">ivyiyumviro vy’<char style="nd">Uhoraho</char>;</para>
  <para style="q1" vid="MIC 4:12">ntibatahura imigambi yiwe,</para>
  <para style="q2" vid="MIC 4:12">ko yabegeranirije hamwe nk’imikama y’ingano ku mbuga.<verse eid="MIC 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13" />“Haguruka usekure ingano, mukobwa w’i Siyoni,</para>
  <para style="q2" vid="MIC 4:13">kuko nzoguha amahembe y’ivyuma;</para>
  <para style="q1" vid="MIC 4:13">ndaguhe ibinono vy’imiringa,</para>
  <para style="q2" vid="MIC 4:13">kandi uzojanjagura amoko menshi uyagire ubunywenywe.”</para>
  <para style="q1" vid="MIC 4:13">Kandi muzogira inyegu y’<char style="nd">Uhoraho</char> ivyo banyaze,</para>
  <para style="q2" vid="MIC 4:13">ubutunzi bwabo buzoba ubw’Umwami w’isi yose.<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="s1">Umutware yasezeranywe azova i Betelehemu</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1" />Egeranya ingabo zawe, yewe wa gisagara c’ingabo,</para>
  <para style="q2" vid="MIC 5:1">kuko umwansi akwugarije.</para>
  <para style="q1" vid="MIC 5:1">Bazokubita umutware wa Isirayeli,</para>
  <para style="q2" vid="MIC 5:1">bazomukubita inkoni kw’itama.<verse eid="MIC 5:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2" />“Ariko wewe Betelehemu Efurata,</para>
  <para style="q2" vid="MIC 5:2">naho uri muto mu bisagara vy’umuryango wa Yuda,</para>
  <para style="q1" vid="MIC 5:2">muri wewe hazomviramwo</para>
  <para style="q2" vid="MIC 5:2">uwuzoganza Abisirayeli,</para>
  <para style="q1" vid="MIC 5:2">kandi amamuko yiwe ni aya kera,</para>
  <para style="q2" vid="MIC 5:2">yamyeho uhereye mu bihe vya kera.”<verse eid="MIC 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3" />Nuko rero Abisirayeli bazoba akahebwe</para>
  <para style="q2" vid="MIC 5:3">kugeza igihe umugore ari ku bise azovyarira umuhungu,</para>
  <para style="q1" vid="MIC 5:3">n’abasigaye mu bavukanyi biwe bakagaruka</para>
  <para style="q2" vid="MIC 5:3">bakifatanya n’Abisirayeli.<verse eid="MIC 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4" />Azohaguruka aragire umukuku wiwe</para>
  <para style="q2" vid="MIC 5:4">ari mu nkomezi z’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="MIC 5:4">mu cubahiro c’izina ry’<char style="nd">Uhoraho</char> Imana yiwe.</para>
  <para style="q1" vid="MIC 5:4">Maze bazokwibera amahoro, kuko muri ico gihe ubukuru bwiwe</para>
  <para style="q2" vid="MIC 5:4">buzoshika no ku mpera z’isi.<verse eid="MIC 5:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5" />Kandi ni we azoba amahoro yacu</para>
  <para style="q2" vid="MIC 5:5">aho Abashuri bazoterera igihugu cacu</para>
  <para style="q2" vid="MIC 5:5">bakagendagenda mu nzitiro zacu.</para>
  <para style="q1" vid="MIC 5:5">Tuzohagurutsa abungere indwi bo kubagwanya,</para>
  <para style="q2" vid="MIC 5:5">mbere ni abagabisha umunani,<verse eid="MIC 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6" />bazoganzisha inkota igihugu c’i Ashuri,</para>
  <para style="q2" vid="MIC 5:6">igihugu ca Nimurodi bakiganzishe inkota isokoye.</para>
  <para style="q1" vid="MIC 5:6">Azodukiza Abashuri</para>
  <para style="q2" vid="MIC 5:6">aho bazoterera igihugu cacu</para>
  <para style="q2" vid="MIC 5:6">bakajabuka imbibe zaco.<verse eid="MIC 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7" />Amasigarira y’aba Yakobo azoba</para>
  <para style="q2" vid="MIC 5:7">hagati mu mahanga menshi</para>
  <para style="q1" vid="MIC 5:7">nk’urume ruvuye k’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="MIC 5:7">nk’imvura iguye ku vyatsi,</para>
  <para style="q1" vid="MIC 5:7">itarinda kurindira umuntu n’umwe</para>
  <para style="q2" vid="MIC 5:7">canke ngo igire umuntu ayitegeka.<verse eid="MIC 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8" />Amasigarira y’aba Yakobo azoba mu moko menshi,</para>
  <para style="q2" vid="MIC 5:8">hagati mu mahanga menshi,</para>
  <para style="q1" vid="MIC 5:8">nk’intambwe mu bikoko vyo mw’ishamba,</para>
  <para style="q2" vid="MIC 5:8">nk’umugunza w’intambwe mu mikuku y’intama,</para>
  <para style="q1" vid="MIC 5:8">iyo irenganye itabagura yongera isiribanga,</para>
  <para style="q2" vid="MIC 5:8">ata muntu wo gutabara.<verse eid="MIC 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9" />Ukuboko kwawe kuzoshirwa hejuru ngo kuneshe abansi bawe,</para>
  <para style="q2" vid="MIC 5:9">kandi abakugwanya bazoherengetera.<verse eid="MIC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10" />“Kuri uwo musi,” ni ko <char style="nd">Uhoraho</char> avuze,</para>
  <para style="q1" vid="MIC 5:10">“Nzoherengeteza amafarasi hagati muri mwebwe</para>
  <para style="q2" vid="MIC 5:10">nsambure imikogote yawe.<verse eid="MIC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11" />Nzosambura ibisagara vyo mu gihugu cawe</para>
  <para style="q2" vid="MIC 5:11">nsenyurire hasi inzitiro zawe.<verse eid="MIC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12" />Nzoherengeteza ubupfumu bwawe</para>
  <para style="q2" vid="MIC 5:12">kandi ntuzosubira kuragura.<verse eid="MIC 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13" />Nzoherengeteza ibigirwamana vyawe</para>
  <para style="q2" vid="MIC 5:13">n’inkingi z’amabuye zawe nzozikura muri wewe.</para>
  <para style="q1" vid="MIC 5:13">Ntuzoba ucikubita imbere</para>
  <para style="q2" vid="MIC 5:13">y’ibikorwa vy’intoke zawe.<verse eid="MIC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14" />Nzorandura muri wewe inkingi za Ashera</para>
  <para style="q2" vid="MIC 5:14">aho nzosamburira ibisagara vyawe.<verse eid="MIC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15" />Nzokwihorana uburake n’ubushangashirwe</para>
  <para style="q2" vid="MIC 5:15">amahanga atanyumviye.”<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s1">
    <char style="nd">Uhoraho</char> yagiriza Abisirayeli</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />Nimwumve ivyo <char style="nd">Uhoraho</char> avuga:</para>
  <para style="q1" vid="MIC 6:1">“Haguruke, muburane urubanza rwanje imbere y’imisozi;</para>
  <para style="q2" vid="MIC 6:1">uturambi nitwumve ivyo mugira muvuge.<verse eid="MIC 6:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2" />Nimwumve yemwe misozi, ivyo <char style="nd">Uhoraho</char> abagiriza;</para>
  <para style="q2" vid="MIC 6:2">nimwumvirize, yemwe matanguriro y’isi y’ibihe vyose.</para>
  <para style="q1" vid="MIC 6:2">Kuko <char style="nd">Uhoraho</char> afitaniye urubanza n’abantu biwe;</para>
  <para style="q2" vid="MIC 6:2">afise ivyo yagiriza Abisirayeli.<verse eid="MIC 6:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3" />Bwoko bwanje, ni igiki nabakoreye?</para>
  <para style="q2" vid="MIC 6:3">Nabaruhije gute? Nimunyishure.<verse eid="MIC 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4" />Nabakuye muri Egiputa</para>
  <para style="q2" vid="MIC 6:4">kandi narabacunguye ndabakura mu nzu y’ubuja.</para>
  <para style="q1" vid="MIC 6:4">Narungitse Mose ngo abarongore,</para>
  <para style="q2" vid="MIC 6:4">hamwe na Aroni na Miriyamu.<verse eid="MIC 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5" />Bantu banje, nimwibuke</para>
  <para style="q2" vid="MIC 6:5">ivyo Balaki umwami w’i Mowabu yari yagabiye</para>
  <para style="q2" vid="MIC 6:5">n’ivyo Balamu mwene Beyori yishuye.</para>
  <para style="q1" vid="MIC 6:5">Nimwibuke urugendo rwanyu kuva i Shitimu gushika i Gilugali,</para>
  <para style="q2" vid="MIC 6:5">kugira ngo mumenye ibikorwa vyo kugororoka vy’<char style="nd">Uhoraho</char>.”<verse eid="MIC 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6" />Mbega norengukana iki imbere y’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="MIC 6:6">ngo nuname imbere y’Imana ishizwe hejuru?</para>
  <para style="q1" vid="MIC 6:6">Mbega norengukana imbere yiwe ibimazi bituriwe,</para>
  <para style="q2" vid="MIC 6:6">hamwe n’ishuri imaze umwaka umwe?<verse eid="MIC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7" />Mbega <char style="nd">Uhoraho</char> anezerwa n’impfizi z’intama ibihumbi,</para>
  <para style="q2" vid="MIC 6:7">canke n’inzuzi z’amavuta ya elayo ibihumbi cumi?</para>
  <para style="q1" vid="MIC 6:7">Mbega notanga imfura yanje kw’ikimazi ku bw’icaha canje,</para>
  <para style="q2" vid="MIC 6:7">icamwa c’umubiri wanje ku bw’icaha c’umutima wanje?<verse eid="MIC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8" />Yewe muntu, yarakweretse iciza ico ari co.</para>
  <para style="q2" vid="MIC 6:8">Mbega hari ikindi <char style="nd">Uhoraho</char> akugombako?</para>
  <para style="q1" vid="MIC 6:8">Ni ugukora ibigororotse, gukunda imbabazi,</para>
  <para style="q2" vid="MIC 6:8">no kugendana n’Imana yawe wicishije bugufi.<verse eid="MIC 6:8" /></para>
  <para style="s1">Icaha c’Abisirayeli n’igihano cabo</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9" />Nimwumve! <char style="nd">Uhoraho</char> ariko arahamagara iki gisagara,</para>
  <para style="q2" vid="MIC 6:9">kandi kwubaha izina ryiwe ni bwo bwenge.</para>
  <para style="q2" vid="MIC 6:9">“Nimutinye inkoni n’uwayitumye.<verse eid="MIC 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10" />Mbega nzokwirengagiza za nyungu mbi, yemwe ab’inzu y’abanyakibi,</para>
  <para style="q2" vid="MIC 6:10">na ya minzane yanyu ipima ibidakwiye, navumye?<verse eid="MIC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11" />Mbega nzogenda ntahanye uwukoresha iminzane y’ibinyoma,</para>
  <para style="q2" vid="MIC 6:11">n’imifuko y’amabuye y’umunzane adakwiye?<verse eid="MIC 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12" />Abatunzi banyu bafise umuryano;</para>
  <para style="q2" vid="MIC 6:12">ababa ngaha ni ababeshi</para>
  <para style="q2" vid="MIC 6:12">n’indimi zabo zivuga ivyo guhendana.<verse eid="MIC 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13" />Kubera ivyo, natanguye kubahonya,</para>
  <para style="q2" vid="MIC 6:13">ngo muherengetere kubera ivyaha vyanyu.<verse eid="MIC 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14" />Muzorya ntimuhage;</para>
  <para style="q2" vid="MIC 6:14">muzokwama mwumva inda zigaragara.</para>
  <para style="q1" vid="MIC 6:14">Muzokwegeranya ariko nta co muzoziganya,</para>
  <para style="q2" vid="MIC 6:14">kuko ivyo muzoziganya nzobimarisha inkota.<verse eid="MIC 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15" />Muzobiba ariko ntimuzokwimbura;</para>
  <para style="q2" vid="MIC 6:15">muzogana imyelayo ariko ntimuzokoresha amavuta yayo,</para>
  <para style="q2" vid="MIC 6:15">muzogana inzabibu ariko ntimuzonywa umuvinyu wazo.<verse eid="MIC 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16" />Mwitondeye ivyagezwe vya Omuri</para>
  <para style="q2" vid="MIC 6:16">n’ibikorwa vyose vy’inzu ya Ahabu;</para>
  <para style="q2" vid="MIC 6:16">mwakurikije imigenzo yabo.</para>
  <para style="q1" vid="MIC 6:16">Ni co gituma nzobarekurirako uguhona</para>
  <para style="q2" vid="MIC 6:16">abantu banyu na bo ndabarekurireko ibimaramare;</para>
  <para style="q2" vid="MIC 6:16">muzokwumva agacokoro k’amahanga.”<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s1">Amagorwa y’Abisirayeli</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1" />Ewe jewe ndagowe!</para>
  <para style="q1" vid="MIC 7:1">Meze nk’uwegeranya ivyamwa mu gihe vyeruye,</para>
  <para style="q2" vid="MIC 7:1">mu gihe co gutorora mu mizabibu;</para>
  <para style="q1" vid="MIC 7:1">ata mahando y’inzabibu zo kurya aboneka,</para>
  <para style="q2" vid="MIC 7:1">ata n’insukoni z’amasega ngo zimpembure.<verse eid="MIC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2" />Abizigirwa baheze mu gihugu;</para>
  <para style="q2" vid="MIC 7:2">nta mugororotsi n’umwe agisigaye.</para>
  <para style="q1" vid="MIC 7:2">Umuntu wese abundira kuvisha amaraso;</para>
  <para style="q2" vid="MIC 7:2">umuntu wese ahiga mugenziwe ngo amute mu mutego.<verse eid="MIC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3" />Ibiganza vyabo vyompi vyamogoreye gukora ibibi;</para>
  <para style="q2" vid="MIC 7:3">umutware asaba ingero,</para>
  <para style="q1" vid="MIC 7:3">abacamanza bakira ibiturire.</para>
  <para style="q2" vid="MIC 7:3">Abahambaye bategekesha agahahazo ngo baronke ivyo bipfuza,</para>
  <para style="q2" vid="MIC 7:3">kandi bose bahuje umutima.<verse eid="MIC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4" />Umuntu mwiza muri bo ameze nk’umubambangwe,</para>
  <para style="q2" vid="MIC 7:4">uwurusha abandi ukugororoka arusha ububi uruzitiro rw’amahwa.</para>
  <para style="q1" vid="MIC 7:4">Umusi wawe wo kugenderwa n’Imana urashitse,</para>
  <para style="q2" vid="MIC 7:4">umusi abarinzi bawe bazovuza inzamba.</para>
  <para style="q2" vid="MIC 7:4">Ni igihe cawe co kuzazanirwa.<verse eid="MIC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5" />Ntiwizigire umubanyi;</para>
  <para style="q2" vid="MIC 7:5">ivyizigiro vyawe ntibibe ku mugenzi.</para>
  <para style="q1" vid="MIC 7:5">Naho yoba umugore mubumbatirana,</para>
  <para style="q2" vid="MIC 7:5">wirinde ivyo iminwa yawe ivuga.<verse eid="MIC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6" />Kuko umuhungu ntiyubaha se,</para>
  <para style="q2" vid="MIC 7:6">n’umukobwa ahagurukiye kugwanya nyina,</para>
  <para style="q1" vid="MIC 7:6">umukazana akagwanya inabukwe,</para>
  <para style="q2" vid="MIC 7:6">abansi b’umuntu bakaba abo mu rugo iwe.<verse eid="MIC 7:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7" />Ariko jeho nzokwitega <char style="nd">Uhoraho</char> nizigiye,</para>
  <para style="q2" vid="MIC 7:7">nzororera Imana Umukiza wanje;</para>
  <para style="q2" vid="MIC 7:7">Imana yanje izonyumva.<verse eid="MIC 7:7" /></para>
  <para style="s1">Abisirayeli bazovyuka</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8" />Ntunyitambe ku muvyimba, wa mwansi wanje we!</para>
  <para style="q2" vid="MIC 7:8">Naho naguye, nzovyuka.</para>
  <para style="q1" vid="MIC 7:8">Naho nicaye mu mwijima,</para>
  <para style="q2" vid="MIC 7:8">
    <char style="nd">Uhoraho</char> azombera umuco.<verse eid="MIC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9" />Kubera namucumuyeko,</para>
  <para style="q2" vid="MIC 7:9">nzokwihanganira uburake bw’<char style="nd">Uhoraho</char>,</para>
  <para style="q1" vid="MIC 7:9">kugeza aho azoburana urubanza rwanje</para>
  <para style="q2" vid="MIC 7:9">akarutsinda.</para>
  <para style="q1" vid="MIC 7:9">Azonsohora anshire mu muco;</para>
  <para style="q2" vid="MIC 7:9">nzobona ukugororoka kwiwe.<verse eid="MIC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10" />Maze umwansi wanje azobibona</para>
  <para style="q2" vid="MIC 7:10">hanyuma amaramare,</para>
  <para style="q1" vid="MIC 7:10">umwe yambwira ngo:</para>
  <para style="q2" vid="MIC 7:10">“Mbega <char style="nd">Uhoraho</char> Imana yawe ari hehe?”</para>
  <para style="q1" vid="MIC 7:10">Amaso yanje azokwibonera ugutemba kwiwe;</para>
  <para style="q2" vid="MIC 7:10">kandi azosiribangirwa hasi n’ibirenge</para>
  <para style="q2" vid="MIC 7:10">nk’ivyondo mu nzira.<verse eid="MIC 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11" />Umusi wo kwubaka inzitiro zawe urashitse,</para>
  <para style="q2" vid="MIC 7:11">umusi wo kwagura imbibe zawe.<verse eid="MIC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12" />Kuri uwo musi abantu bazoza bakugana</para>
  <para style="q2" vid="MIC 7:12">bavuye muri Ashuri no mu bisagara vyo muri Egiputa,</para>
  <para style="q1" vid="MIC 7:12">mbere kuva muri Egiputa gushika ku ruzi Efurate,</para>
  <para style="q2" vid="MIC 7:12">no kuva ku kiyaga gushika ku kindi</para>
  <para style="q2" vid="MIC 7:12">no kuva ku musozi gushika ku wundi.<verse eid="MIC 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13" />Isi izohinduka ubweranyange kubera abayibako,</para>
  <para style="q2" vid="MIC 7:13">bitewe n’ivyo bakoze.<verse eid="MIC 7:13" /></para>
  <para style="s1">Gusenga no guhimbaza</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14" />Ragiza abantu bawe inyobozo yawe,</para>
  <para style="q2" vid="MIC 7:14">umukuku w’ishamvu yawe,</para>
  <para style="q1" vid="MIC 7:14">wibera ukwawo mw’ishamba,</para>
  <para style="q2" vid="MIC 7:14">ahantu h’uburagiro hamera.</para>
  <para style="q1" vid="MIC 7:14">Baragire i Bashani n’i Gileyadi</para>
  <para style="q2" vid="MIC 7:14">nko mu gihe ca kera.<verse eid="MIC 7:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15" />“Nko mu misi mwava muri Egiputa,</para>
  <para style="q2" vid="MIC 7:15">nzobereka ibitangaza vyanje.”<verse eid="MIC 7:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16" />Amahanga azobibona amaramare,</para>
  <para style="q2" vid="MIC 7:16">inkomezi zabo zose zihere.</para>
  <para style="q1" vid="MIC 7:16">Bazoshira amaboko yabo ku munwa bumirwe.<verse eid="MIC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17" />Bazorigata umukungugu nk’inzoka,</para>
  <para style="q2" vid="MIC 7:17">nk’ibikoko bikwega inda hasi.</para>
  <para style="q1" vid="MIC 7:17">Bazosohoka bahinda agashitsi bava mu bibundo vyabo;</para>
  <para style="q2" vid="MIC 7:17">bazohindukirira <char style="nd">Uhoraho</char> Imana yacu bari n’ubwoba</para>
  <para style="q2" vid="MIC 7:17">kandi bazogutinya.<verse eid="MIC 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18" />Ni iyihe Mana imeze nkawe,</para>
  <para style="q2" vid="MIC 7:18">iharira icaha, ikababarira ibigabitanyo</para>
  <para style="q2" vid="MIC 7:18">vy’amasigarira y’ishamvu yiwe?</para>
  <para style="q1" vid="MIC 7:18">Ntiwama uratse ibihe vyose</para>
  <para style="q2" vid="MIC 7:18">ahubwo uhimbarwa no kugira imbabazi.<verse eid="MIC 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19" />Uzosubira kutugirira ikigongwe;</para>
  <para style="q2" vid="MIC 7:19">uzosiribangira ivyaha vyacu musi y’ibirenge vyawe</para>
  <para style="q2" vid="MIC 7:19">n’ibigabitanyo vyacu uzobita i bwina mu kiyaga.<verse eid="MIC 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20" />Uzoba umwizigirwa ku ba Yakobo,</para>
  <para style="q2" vid="MIC 7:20">uzokwerekana urukundo kuri Aburahamu,</para>
  <para style="q1" vid="MIC 7:20">nk’uko wabirahiye ba sogokuruza bacu</para>
  <para style="q2" vid="MIC 7:20">mu bihe vya kera.<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>