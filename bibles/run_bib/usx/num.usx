  <para style="h">Guharura</para>
  <para style="toc1">Igitabu ca kane ca Mose citwa Guharura</para>
  <para style="toc2">Guharura</para>
  <para style="toc3">Guh</para>
  <para style="mt2">Igitabu ca kane ca Mose citwa</para>
  <para style="mt1">Guharura</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="NUM 1" />
  <para style="s1">Abisirayeli baharurwa ubwa mbere</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1" />
    <char style="nd">Uhoraho</char> avugana na Mose ari mw’Ihema ry’Ibonaniro mu bugaragwa bw’i Sinayi ku musi wa mbere w’ukwezi kwa kabiri, mu mwaka ugira kabiri Abisirayeli bavuye muri Egiputa, amubwira ati: <verse eid="NUM 1:1" /><verse number="2" style="v" sid="NUM 1:2" />“Harura Abisirayeli bose ukurikije imiryango yabo n’inzu zabo, ushire ku rutonde amazina y’ingabo kandi uharure umwumwe. <verse eid="NUM 1:2" /><verse number="3" style="v" sid="NUM 1:3" />Mwe na Aroni muze muharure abagabo bose b’Abisirayeli bamaze imyaka mirongo ibiri canke irenga, bashobora kuja ku rugamba, mubashire mu migwi yabo. <verse eid="NUM 1:3" /><verse number="4" style="v" sid="NUM 1:4" />Umugabo aserukira umuryango akaba n’umukuru wawo azobafashe muri ico gikorwa.<verse eid="NUM 1:4" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="5" style="v" sid="NUM 1:5" />Aya ni yo mazina y’abazogufasha:</para>
  <para style="b" vid="NUM 1:5" />
  <para style="li1" vid="NUM 1:5">mu muryango wa Reyubeni, ni Elisuri mwene Shedewuri;<verse eid="NUM 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 1:6" />mu muryango wa Simeyoni, ni Shelumiyeli mwene Zurishadayi;<verse eid="NUM 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 1:7" />mu muryango wa Yuda, ni Nahashoni mwene Aminadabu;<verse eid="NUM 1:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 1:8" />mu muryango wa Isakari, ni Netaneli mwene Zuwari;<verse eid="NUM 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 1:9" />mu muryango wa Zebuloni, ni Eliyabu mwene Heloni;<verse eid="NUM 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 1:10" />muri bene Yosefu:</para>
  <para style="li2" vid="NUM 1:10">mu muryango wa Efurayimu, ni Elishama mwene Amihudi;</para>
  <para style="li2" vid="NUM 1:10">mu muryango wa Manase, ni Gamaliyeli mwene Pedasuri;<verse eid="NUM 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 1:11" />mu muryango wa Benyamini, ni Abidani mwene Gidiyoni;<verse eid="NUM 1:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 1:12" />mu muryango wa Dani, ni Ahiyezeri mwene Amishadayi;<verse eid="NUM 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 1:13" />mu muryango wa Asheri, ni Pagiyeli mwene Okurani;<verse eid="NUM 1:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 1:14" />mu muryango wa Gadi, ni Eliyasafu mwene Dewuyeli;<verse eid="NUM 1:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 1:15" />mu muryango wa Nafutali, ni Ahira mwene Enani.”<verse eid="NUM 1:15" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="16" style="v" sid="NUM 1:16" />Abo ni bo batowe mw’ihanga ryose, bakaba bari abakuru b’imiryango ya ba sekuruza babo. Ni bo kandi bari abakuru b’amazu y’imiryango ya Isirayeli.<verse eid="NUM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17" />Nuko Mose na Aroni begeranya abo bantu batowe, <verse eid="NUM 1:17" /><verse number="18" style="v" sid="NUM 1:18" />baca batumako ikoraniro ry’ihanga ryose ku musi wa mbere w’ukwezi kwa kabiri. Abantu bariyandikisha bakurikije amazu yabo n’imiryango yabo, hanyuma abagabo bakwije imyaka mirongo ibiri n’iyirenga barandikwa, umwumwe wese ku rutonde rw’amazina, <verse eid="NUM 1:18" /><verse number="19" style="v" sid="NUM 1:19" />nk’uko <char style="nd">Uhoraho</char> yari yategetse Mose. Yabaharuriye mu bugaragwa bw’i Sinayi.<verse eid="NUM 1:19" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="20" style="v" sid="NUM 1:20" />Mu bakomoka kuri Reyubeni imfura ya Isirayeli:</para>
  <para style="li2" vid="NUM 1:20">Abagabo bose bari bamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba barandikwa, amazina y’umwumwe wese ashirwa ku rutonde, hakurikijwe amazu ya ba sekuruza n’imiryango yabo. <verse eid="NUM 1:20" /><verse number="21" style="v" sid="NUM 1:21" />Igitigiri c’abakomoka kuri Reyubeni cari ibihumbi mirongo ine na bitandatu n’amajana atanu.<verse eid="NUM 1:21" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="22" style="v" sid="NUM 1:22" />Mu bakomoka kuri Simeyoni:</para>
  <para style="li2" vid="NUM 1:22">Abagabo bose bari bamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba barandikwa, amazina y’umwumwe wese ashirwa ku rutonde, hakurikijwe amazu ya ba sekuruza n’imiryango yabo. <verse eid="NUM 1:22" /><verse number="23" style="v" sid="NUM 1:23" />Igitigiri c’abakomoka kuri Simeyoni cari ibihumbi mirongo itanu n’icenda n’amajana atatu.<verse eid="NUM 1:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="NUM 1:24" />Mu bakomoka kuri Gadi:</para>
  <para style="li2" vid="NUM 1:24">Abagabo bose bari bamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba barandikwa, amazina y’umwumwe wese ashirwa ku rutonde, hakurikijwe amazu ya ba sekuruza n’imiryango yabo. <verse eid="NUM 1:24" /><verse number="25" style="v" sid="NUM 1:25" />Igitigiri c’abakomoka kuri Gadi cari ibihumbi mirongo ine na bitanu n’amajana atandatu na mirongo itanu.<verse eid="NUM 1:25" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="26" style="v" sid="NUM 1:26" />Mu bakomoka kuri Yuda:</para>
  <para style="li2" vid="NUM 1:26">Abagabo bose bari bamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba barandikwa, amazina y’umwumwe wese ashirwa ku rutonde, hakurikijwe amazu ya ba sekuruza n’imiryango yabo. <verse eid="NUM 1:26" /><verse number="27" style="v" sid="NUM 1:27" />Igitigiri c’abakomoka kuri Yuda cari ibihumbi mirongo indwi na bine n’amajana atandatu.<verse eid="NUM 1:27" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="28" style="v" sid="NUM 1:28" />Mu bakomoka kuri Isakari:</para>
  <para style="li2" vid="NUM 1:28">Abagabo bose bari bamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba barandikwa, amazina y’umwumwe wese ashirwa ku rutonde, hakurikijwe amazu ya ba sekuruza n’imiryango yabo. <verse eid="NUM 1:28" /><verse number="29" style="v" sid="NUM 1:29" />Igitigiri c’abakomoka kuri Isakari cari ibihumbi mirongo itanu na bine n’amajana ane.<verse eid="NUM 1:29" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="30" style="v" sid="NUM 1:30" />Mu bakomoka kuri Zebuloni:</para>
  <para style="li2" vid="NUM 1:30">Abagabo bose bari bamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba barandikwa, amazina y’umwumwe wese ashirwa ku rutonde, hakurikijwe amazu ya ba sekuruza n’imiryango yabo. <verse eid="NUM 1:30" /><verse number="31" style="v" sid="NUM 1:31" />Igitigiri c’abakomoka kuri Zebuloni cari ibihumbi mirongo itanu n’indwi n’amajana ane.<verse eid="NUM 1:31" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="32" style="v" sid="NUM 1:32" />Abo mu bahungu ba Yosefu:</para>
  <para style="li1" vid="NUM 1:32">Mu bakomoka kuri Efurayimu,</para>
  <para style="li2" vid="NUM 1:32">Abagabo bose bari bamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba barandikwa, amazina y’umwumwe wese ashirwa ku rutonde, hakurikijwe amazu ya ba sekuruza n’imiryango yabo. <verse eid="NUM 1:32" /><verse number="33" style="v" sid="NUM 1:33" />Igitigiri c’abakomoka kuri Efurayimu cari ibihumbi mirongo ine n’amajana atanu.<verse eid="NUM 1:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 1:34" />Mu bakomoka kuri Manase,</para>
  <para style="li2" vid="NUM 1:34">Abagabo bose bari bamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba barandikwa, amazina y’umwe umwe wese ashirwa ku rutonde, hakurikijwe amazu ya ba sekuruza n’imiryango yabo. <verse eid="NUM 1:34" /><verse number="35" style="v" sid="NUM 1:35" />Igitigiri c’abakomoka kuri Manase cari ibihumbi mirongo itatu na bibiri n’amajana abiri.<verse eid="NUM 1:35" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="36" style="v" sid="NUM 1:36" />Mu bakomoka kuri Benyamini:</para>
  <para style="li2" vid="NUM 1:36">Abagabo bose bari bamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba barandikwa, amazina y’umwe umwe wese ashirwa ku rutonde, hakurikijwe amazu ya ba sekuruza n’imiryango yabo. <verse eid="NUM 1:36" /><verse number="37" style="v" sid="NUM 1:37" />Igitigiri c’abakomoka kuri Benyamini cari ibihumbi mirongo itatu na bitanu n’amajana ane.<verse eid="NUM 1:37" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="38" style="v" sid="NUM 1:38" />Mu bakomoka kuri Dani:</para>
  <para style="li2" vid="NUM 1:38">Abagabo bose bari bamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba barandikwa, amazina y’umwumwe wese ashirwa ku rutonde, hakurikijwe amazu ya ba sekuruza n’imiryango yabo. <verse eid="NUM 1:38" /><verse number="39" style="v" sid="NUM 1:39" />Igitigiri c’abakomoka kuri Dani cari ibihumbi mirongo itandatu na bibiri n’amajana indwi.<verse eid="NUM 1:39" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="40" style="v" sid="NUM 1:40" />Mu bakomoka kuri Asheri:</para>
  <para style="li2" vid="NUM 1:40">Abagabo bose bari bamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba barandikwa, amazina y’umwumwe wese ashirwa ku rutonde, hakurikijwe amazu ya ba sekuruza n’imiryango yabo. <verse eid="NUM 1:40" /><verse number="41" style="v" sid="NUM 1:41" />Igitigiri c’abakomoka kuri Asheri cari ibihumbi mirongo ine na kimwe n’amajana atanu.<verse eid="NUM 1:41" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="42" style="v" sid="NUM 1:42" />Mu bakomoka kuri Nafutali:</para>
  <para style="li2" vid="NUM 1:42">Abagabo bose bari bamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba barandikwa, amazina y’umwumwe wese ashirwa ku rutonde, hakurikijwe amazu ya ba sekuruza n’imiryango yabo. <verse eid="NUM 1:42" /><verse number="43" style="v" sid="NUM 1:43" />Igitigiri c’abakomoka kuri Nafutali cari ibihumbi mirongo itanu na bitatu n’amajana ane.<verse eid="NUM 1:43" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="44" style="v" sid="NUM 1:44" />Abo ni bo bagabo baharuwe na Mose na Aroni na ba bakuru icumi na babiri batowe mu Bisirayeli, umwe wese aserukira umuryango na ba sekuruza akomokako. <verse eid="NUM 1:44" /><verse number="45" style="v" sid="NUM 1:45" />Abisirayeli bose bari bamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba baraharuwe hakurikijwe amazu ya ba sekuruza n’imiryango yabo. <verse eid="NUM 1:45" /><verse number="46" style="v" sid="NUM 1:46" />Igitigiri cabo bose hamwe cari ibihumbi amajana atandatu na bitatu n’amajana atanu na mirongo itanu.<verse eid="NUM 1:46" /></para>
  <para style="b" />
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47" />Ariko abakomoka kuri Lewi ntibaharuwe hamwe n’abandi. <verse eid="NUM 1:47" /><verse number="48" style="v" sid="NUM 1:48" /><char style="nd">Uhoraho</char> yari yarabariye Mose ati: <verse eid="NUM 1:48" /><verse number="49" style="v" sid="NUM 1:49" />“Ntimuze muharure abakomoka kuri Lewi canke ngo mubashire hamwe n’abandi mu guharura Abisirayeli. <verse eid="NUM 1:49" /><verse number="50" style="v" sid="NUM 1:50" />Ariko, Abalewi uzobazeze igikorwa co kwitaho ivyo mw’ihema ry’ibonaniro, bazezwe ibikoresho vyaho hamwe n’ibintu vyose biri muri ryo. Ni bo bazoterura ihema n’ibikoresho vyaryo vyose; baze baryitwararike kandi bacumbike barikikuje. <verse eid="NUM 1:50" /><verse number="51" style="v" sid="NUM 1:51" />Igihe cose bizoba bikenewe ko ihema ryimurwa, Abalewi baze bazobe ari bo barizinga, na ho bikenewe ko rishingwa, Abalewi bazobe ari bo barishinga. Uwundi muntu wese azoryegera aze yicwe. <verse eid="NUM 1:51" /><verse number="52" style="v" sid="NUM 1:52" />Abisirayeli baze bashinge amahema yabo mu migwi, umuntu wese azobe mu muce agenewe, abe musi y’ibendera ryabo. <verse eid="NUM 1:52" /><verse number="53" style="v" sid="NUM 1:53" />Ariko Abalewi bo baze bashinge amahema yabo bakikuje iryo hema ry’isezerano kugira ngo simpave ndakira Abisirayeli. Abalewi ni bo bajejwe kwitaho ihema ry’isezerano.”<verse eid="NUM 1:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54" />Nuko Abisirayeli bakora vyose nk’uko <char style="nd">Uhoraho</char> yari yabitegetse Mose.<verse eid="NUM 1:54" /></para>
  <chapter eid="NUM 1" />
  <chapter number="2" style="c" sid="NUM 2" />
  <para style="s1">Uko imiryango yashinga amahema aho bacumbitse</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1" />
    <char style="nd">Uhoraho</char> abarira Mose na Aroni ati: <verse eid="NUM 2:1" /><verse number="2" style="v" sid="NUM 2:2" />“Abisirayeli baze bacumbike bakikuje Ihema ry’Ibonaniro ariko bataryegereye cane, umuntu wese azobe musi y’ibendera ry’umuryango wiwe no musi y’ibendera ry’inzu yiwe.”<verse eid="NUM 2:2" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="3" style="v" sid="NUM 2:3" />Mu buseruko hazobe hari:</para>
  <para style="li1" vid="NUM 2:3">Abakomoka kuri Yuda bari musi y’ibendera ryabo. Umukuru wabo ni Nahashoni mwene Aminadabu. <verse eid="NUM 2:3" /><verse number="4" style="v" sid="NUM 2:4" />Igitigiri c’umugwi wabo ni ibihumbi mirongo indwi na bine n’amajana atandatu.<verse eid="NUM 2:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 2:5" />Abakomoka kuri Isakari baze bakurikire. Umukuru wabo ni Netaneli mwene Zuwari. <verse eid="NUM 2:5" /><verse number="6" style="v" sid="NUM 2:6" />Igitigiri c’umugwi wabo ni ibihumbi mirongo itanu na bine n’amajana ane.<verse eid="NUM 2:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 2:7" />Abakomoka kuri Zebuloni baze bakurikire. Umukuru wabo ni Eliyabu mwene Heloni. <verse eid="NUM 2:7" /><verse number="8" style="v" sid="NUM 2:8" />Igitigiri c’umugwi wabo ni ibihumbi mirongo itanu n’indwi n’amajana ane.<verse eid="NUM 2:8" /></para>
  <para style="lf">
    <verse number="9" style="v" sid="NUM 2:9" />Abagabo bose bazoba bari ku ruhande rwa Yuda, nk’uko imigwi yabo iri, ni ibihumbi ijana na mirongo umunani na bitandatu n’amajana ane. Abo ni bo bazoja imbere y’Abisirayeli. Ni bo bazofata inzira ubwa mbere.<verse eid="NUM 2:9" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="10" style="v" sid="NUM 2:10" />Mu bumanuko hazoba hari:</para>
  <para style="li1" vid="NUM 2:10">Abakomoka kuri Reyubeni, bari musi y’ibendera ryabo. Umukuru wabo ni Elisuri mwene Shedewuri. <verse eid="NUM 2:10" /><verse number="11" style="v" sid="NUM 2:11" />Igitigiri c’umugwi wabo ni ibihumbi mirongo ine na bitandatu n’amajana atanu.<verse eid="NUM 2:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 2:12" />Abakomoka kuri Simeyoni baze bakurikire. Umukuru wabo ni Shelumiyeli mwene Zurishadayi. <verse eid="NUM 2:12" /><verse number="13" style="v" sid="NUM 2:13" />Igitigiri c’umugwi wabo ni ibihumbi mirongo itanu n’icenda n’amajana atatu.<verse eid="NUM 2:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 2:14" />Abakomoka kuri Gadi baze bakurikire. Umukuru wabo ni Eliyasafu mwene Reyuweli <verse eid="NUM 2:14" /><verse number="15" style="v" sid="NUM 2:15" />Igitigiri c’umugwi wabo ni ibihumbi mirongo ine na bitanu n’amajana atandatu na mirongo itanu.<verse eid="NUM 2:15" /></para>
  <para style="lf">
    <verse number="16" style="v" sid="NUM 2:16" />Abagabo bose bazoba bari ku ruhande rwa Reyubeni, nk’uko imigwi yabo iri, ni ibihumbi ijana na mirongo itanu na kimwe n’amajana ane na mirongo itanu. Ni bo bazofata inzira ubwa kabiri.<verse eid="NUM 2:16" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="17" style="v" sid="NUM 2:17" />Hanyuma haze hakurikire ihema ry’ibonaniro n’abakomoka kuri Lewi, bagendere hagati y’iyindi migwi. Baze bakurikirane mu guhaguruka nk’uko bakurikirana mu gucumbika, umwe wese mu kibanza ciwe, kandi ari musi y’ibendera ryabo.<verse eid="NUM 2:17" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="18" style="v" sid="NUM 2:18" />Mu burengero hazoba hari:</para>
  <para style="li1" vid="NUM 2:18">Abakomoka kuri Efurayimu, bari musi y’ibendera ryabo. Umukuru wabo ni Elishama mwene Amihudi. <verse eid="NUM 2:18" /><verse number="19" style="v" sid="NUM 2:19" />Igitigiri c’umugwi wabo ni ibihumbi mirongo ine n’amajana atanu.<verse eid="NUM 2:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 2:20" />Abakomoka kuri Manase baze bakurikire. Umukuru wabo ni Gamaliyeli mwene Pedasuri. <verse eid="NUM 2:20" /><verse number="21" style="v" sid="NUM 2:21" />Igitigiri c’umugwi wabo ni ibihumbi mirongo itatu na bibiri n’amajana abiri.<verse eid="NUM 2:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 2:22" />Abakomoka kuri Benyamini baze bakurikire. Umukuru wabo ni Abidani mwene Gidiyoni. <verse eid="NUM 2:22" /><verse number="23" style="v" sid="NUM 2:23" />Igitigiri c’umugwi wabo ni ibihumbi mirongo itatu na bitanu n’amajana ane.<verse eid="NUM 2:23" /></para>
  <para style="lf">
    <verse number="24" style="v" sid="NUM 2:24" />Abagabo bose bazoba bari ku ruhande rwa Efurayimu, nk’uko imigwi yabo iri, ni ibihumbi ijana n’umunani n’ijana. Baze bafate inzira ubwa gatatu.<verse eid="NUM 2:24" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="25" style="v" sid="NUM 2:25" />Mu buraruko hazoba hari:</para>
  <para style="li1" vid="NUM 2:25">Abakomoka kuri Dani bari musi y’ibendera ryabo. Umukuru wabo ni Ahiyezeri mwene Amishadayi. <verse eid="NUM 2:25" /><verse number="26" style="v" sid="NUM 2:26" />Igitigiri c’umugwi wabo ni ibihumbi mirongo itandatu na bibiri n’amajana indwi.<verse eid="NUM 2:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 2:27" />Abakomoka kuri Asheri baze bakurikire. Umukuru wabo ni Pagiyeli mwene Okurani. <verse eid="NUM 2:27" /><verse number="28" style="v" sid="NUM 2:28" />Igitigiri c’umugwi wabo ni ibihumbi mirongo ine na kimwe n’amajana atanu.<verse eid="NUM 2:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 2:29" />Abakomoka kuri Nafutali baze bakurikire. Umukuru wabo ni Ahira mwene Enani. <verse eid="NUM 2:29" /><verse number="30" style="v" sid="NUM 2:30" />Igitigiri c’umugwi w’abo ni ibihumbi mirongo itanu na bitatu n’amajana ane.<verse eid="NUM 2:30" /></para>
  <para style="lf">
    <verse number="31" style="v" sid="NUM 2:31" />Abagabo bose bazoba bari ku ruhande rwa Dani ni ibihumbi ijana na mirongo itanu n’indwi n’amajana atandatu. Abo ni bo bazohaguruka ubwa nyuma.<verse eid="NUM 2:31" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="32" style="v" sid="NUM 2:32" />Abo ni bo Bisirayeli, baharuwe hakurikijwe imiryango bakomokamwo. Abaharuwe bose mu mice y’igisoda cabo, nk’uko imigwi yabo iri, ni ibihumbi amajana atandatu na bitatu n’amajana atanu na mirongo itanu. <verse eid="NUM 2:32" /><verse number="33" style="v" sid="NUM 2:33" />Ariko Abalewi bo, ntibaharuwe hamwe n’abandi Bisirayeli, nk’uko <char style="nd">Uhoraho</char> yari yabitegetse Mose.<verse eid="NUM 2:33" /></para>
  <para style="b" />
  <para style="p">
    <verse number="34" style="v" sid="NUM 2:34" />Nuko Abisirayeli bakora vyose nk’uko <char style="nd">Uhoraho</char> yari yabitegetse Mose. Bashinga amahema musi y’amabendera yabo, umwe wese mu nzu ya ba sekuruza no mu muryango wiwe, kandi ni muri urwo rutonde nyene bahaguruka bagafata inzira.<verse eid="NUM 2:34" /></para>
  <chapter eid="NUM 2" />
  <chapter number="3" style="c" sid="NUM 3" />
  <para style="s1">Ibikorwa vy’Abalewi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1" />Uru ni rwo ruvyaro rwa Aroni n’urwa Mose igihe <char style="nd">Uhoraho</char> yavugana na Mose ku musozi Sinayi.<verse eid="NUM 3:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="NUM 3:2" />Amazina y’abahungu ba Aroni yari Nadabu, imfura yiwe, Abihu, Eliyazeri na Itamari. <verse eid="NUM 3:2" /><verse number="3" style="v" sid="NUM 3:3" />Ayo ni yo mazina y’abahungu ba Aroni, abaherezi basizwe amavuta, barobanuriwe igikorwa c’ubuherezi. <verse eid="NUM 3:3" /><verse number="4" style="v" sid="NUM 3:4" />Ariko Nadabu na Abihu bapfiriye imbere y’<char style="nd">Uhoraho</char> igihe batanga ikimazi bakoresheje umuriro utemewe imbere yiwe mu bugaragwa bw’i Sinayi. Nta bahungu bari bafise; ni co catumye Eliyazeri na Itamari bonyene ari bo bakoze nk’abaherezi igihe se Aroni yari akiriho.<verse eid="NUM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 3:5" /><verse number="6" style="v" sid="NUM 3:6" />“Zana abakomoka kuri Lewi imbere ya Aroni umuherezi kugira ngo bamufashe. <verse eid="NUM 3:6" /><verse number="7" style="v" sid="NUM 3:7" />Baze bakore ibikorwa vyerekeye Ihema ry’Ibonaniro bakorera Aroni n’Abisirayeli bose. <verse eid="NUM 3:7" /><verse number="8" style="v" sid="NUM 3:8" />Bazoba bajejwe gutunganya ibikoresho vyose vyo mw’Ihema ry’Ibonaniro, bakorera Abisirayeli bose ivyashinzwe mu gukora ibikorwa vyabo vyo mw’Ihema. <verse eid="NUM 3:8" /><verse number="9" style="v" sid="NUM 3:9" />Abo Balewi ubashikirize Aroni n’abahungu biwe; kuko ni bo bitanze mu Bisirayeli bose ngo babafashe ibikorwa. <verse eid="NUM 3:9" /><verse number="10" style="v" sid="NUM 3:10" />Uze utoranye Aroni n’abahungu biwe ni bo bazokora nk’abaherezi; uwundi muntu wese azokwegera ihema aze yicwe.”<verse eid="NUM 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11" />
    <char style="nd">Uhoraho</char> yongera abarira Mose ati: <verse eid="NUM 3:11" /><verse number="12" style="v" sid="NUM 3:12" />“Natoranije Abalewi mu bandi Bisirayeli ngo babe mu gishingo c’abahungu bose b’imfura bavyawe n’umugore wese w’Umwisirayelikazi. Abalewi ni abanje, <verse eid="NUM 3:12" /><verse number="13" style="v" sid="NUM 3:13" />kuko abana bose b’imfura ari abanje. Igihe nica abana b’imfura bose bo muri Egiputa, naciye nitoraniriza imfura zose zo muri Isirayeli, imfura z’abantu n’iz’ibitungwa. Ni izanje; ndi <char style="nd">Uhoraho</char>.”<verse eid="NUM 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14" />
    <char style="nd">Uhoraho</char> abarira Mose ari mu bugaragwa bw’i Sinayi ati: <verse eid="NUM 3:14" /><verse number="15" style="v" sid="NUM 3:15" />“Harura Abalewi ukurikije imiryango yabo n’amazu ya ba sekuruza babo. Muze muharure umuhungu wese kuva ku wumaze ukwezi kumwe avutse no kuduga.” <verse eid="NUM 3:15" /><verse number="16" style="v" sid="NUM 3:16" />Nuko Mose arabaharura, nk’uko yategetswe n’ijambo ry’<char style="nd">Uhoraho</char>.<verse eid="NUM 3:16" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="17" style="v" sid="NUM 3:17" />Aya ni yo mazina y’abahungu ba Lewi:</para>
  <para style="li2" vid="NUM 3:17">Gerishoni, Kohati na Merari.<verse eid="NUM 3:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="NUM 3:18" />Amazu akomoka kuri Gerishoni yitiriwe abahungu biwe babiri:</para>
  <para style="li2" vid="NUM 3:18">Libuni na Shimeyi<verse eid="NUM 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 3:19" />Amazu akomoka kuri Kohati yitiriwe abahungu biwe bane:</para>
  <para style="li2" vid="NUM 3:19">Amuramu, Izihari, Heburoni na Uziyeli.<verse eid="NUM 3:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 3:20" />Amazu akomoka kuri Merari yitiriwe abahungu biwe babiri:</para>
  <para style="li2" vid="NUM 3:20">Mahuli na Mushi.</para>
  <para style="lf" vid="NUM 3:20">Ayo ni yo yari amazu y’abakomoka kuri Lewi, hakurikijwe imiryango yabo.<verse eid="NUM 3:20" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="21" style="v" sid="NUM 3:21" />Abakomoka kuri Gerishoni bari Abalibuni n’Abashimeyi; ayo ni yo yari amazu akomoka kuri Gerishoni.<verse eid="NUM 3:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 3:22" />Abahungu bamaze ukwezi bavutse n’abakurenza baharuwe bari ibihumbi indwi n’amajana atanu.<verse eid="NUM 3:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 3:23" />Abakomoka kuri Gerishoni bacumbika mu burengero, inyuma y’ihema.<verse eid="NUM 3:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 3:24" />Umukuru w’amazu akomoka kuri Gerishoni yari Eliyasafu mwene Layeli.<verse eid="NUM 3:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 3:25" />Mw’ihema ry’ibonaniro, Abagerishoni bari bashinzwe gutunganya ihema imbere n’inyuma, n’igipfutse ihema, n’igihuzu gikingiriye ku muryango w’Ihema ry’Ibonaniro, <verse eid="NUM 3:25" /><verse number="26" style="v" sid="NUM 3:26" />ibihuzu bigize urugo, n’igihuzu co ku muryango w’irembo ry’urugo rukikuje ihema n’igicaniro, n’imigozi y’ihema, n’ibikoresho vyose bijanye n’ikoreshwa ryayo.<verse eid="NUM 3:26" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="27" style="v" sid="NUM 3:27" />Imiryango iva kuri Kohati ni Abamurani, Abayizari, Abaheburoni n’Abawuziyeli; abo ni bo bari bagize imiryango y’Abakohati.<verse eid="NUM 3:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 3:28" />Igitigiri c’abahungu bamaze ukwezi n’ukurenga cari ibihumbi umunani n’amajana atandatu.</para>
  <para style="li1" vid="NUM 3:28">Abakohati bari bajejwe gutunganya ahera.<verse eid="NUM 3:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 3:29" />Imiryango y’Abakohati bacumbika mu ruhande rwo mu bumanuko rw’ihema.<verse eid="NUM 3:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="NUM 3:30" />Umukuru w’amazu ya ba sekuruza y’imiryango y’Abakohati yari Elizafani mwene Uziyeli.<verse eid="NUM 3:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="NUM 3:31" />Bari bajejwe gutunganya Isandugu y’Isezerano, imeza, igiterekwako amatara, ibicaniro, ibikoresho vy’ahera bikoreshwa mu gikorwa caho, igihuzu gikingiriye ahera, n’ibindi vyose bijanye n’ivyo.<verse eid="NUM 3:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="NUM 3:32" />Umukuru yatwara bose mu Balewi yari Eliyazeri mwene Aroni, umuherezi. Yari ashinzwe kurongora abari bashinzwe gutunganya ahera.<verse eid="NUM 3:32" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="33" style="v" sid="NUM 3:33" />Imiryango y’Abamahuli n’Abamushi bari Aba Merari; abo ni bo bari bagize imiryango y’Abamerari.<verse eid="NUM 3:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 3:34" />Igitigiri c’abahungu bamaze ukwezi n’ukurenga baharuwe cari ibihumbi bitandatu n’amajana abiri.<verse eid="NUM 3:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="NUM 3:35" />Umukuru w’amazu y’abo mu miryango y’Abamerari yari Zuriyeli mwene Abihayili;</para>
  <para style="li1" vid="NUM 3:35">bategerezwa gucumbika mu ruhande rwo mu buraruko bw’ihema. <verse eid="NUM 3:35" /><verse number="36" style="v" sid="NUM 3:36" />Abamerari bari bashinzwe gutunganya ibishimaryango vy’ihema, ibizingiti, inkingi, ivyo gushingamwo inkingi n’ibikoresho vyaryo vyose, n’ibijanye na vyo vyose n’ikoreshwa ryavyo, <verse eid="NUM 3:36" /><verse number="37" style="v" sid="NUM 3:37" />n’inkingi z’urugo rukikuje ihema n’ivyo kuzishingamwo vyose, imambo n’imigozi vy’ihema.<verse eid="NUM 3:37" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="38" style="v" sid="NUM 3:38" />Mose na Aroni n’abahungu babo bategerezwa gushinga amahema mu buseruko bw’Ihema ry’Ibonaniro, batumbereye iyo izuba riserukira, imbere y’Ihema ry’Ibonaniro.</para>
  <para style="li1" vid="NUM 3:38">Bari bajejwe gutunganya ivy’Ihema mu gishingo c’abandi Bisirayeli.</para>
  <para style="li1" vid="NUM 3:38">Uwundi wese yegera Ihema yategerezwa kwicwa.<verse eid="NUM 3:38" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="39" style="v" sid="NUM 3:39" />Igitigiri cose c’Abalewi baharuwe na Mose na Aroni nk’uko <char style="nd">Uhoraho</char> yabitegetse hakurikijwe imiryango yabo, bagizwe n’abahungu bakwije ukwezi bavutse n’abakurenza, cari ibihumbi mirongo ibiri na bibiri.<verse eid="NUM 3:39" /></para>
  <para style="b" />
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40" />
    <char style="nd">Uhoraho</char> abarira Mose ati: “Harura imfura z’Abisirayeli zose z’abahungu bamaze ukwezi n’abakurenza ushire ku rutonde amazina yabo. <verse eid="NUM 3:40" /><verse number="41" style="v" sid="NUM 3:41" />Uce wakira Abalewi ubanzanire mu gishingo c’imfura zose z’Abisirayeli, n’imfura z’ibitungwa vy’Abalewi mu gishingo c’imfura zose z’ibitungwa vy’Abisirayeli. Ndi <char style="nd">Uhoraho</char>.”<verse eid="NUM 3:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 3:42" />Nuko Mose aharura imfura zose z’Abisirayeli, nk’uko <char style="nd">Uhoraho</char> yabimutegetse. <verse eid="NUM 3:42" /><verse number="43" style="v" sid="NUM 3:43" />Igitigiri cose c’imfura z’abahungu bamaze ukwezi kumwe n’abakurenza, bashizwe ku rutonde, cari ibihumbi mirongo ibiri na bibiri n’amajana abiri na mirongo indwi na batatu.<verse eid="NUM 3:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 3:44" /><verse number="45" style="v" sid="NUM 3:45" />“Fata Abalewi mu gishingo c’imfura z’Abisirayeli, n’ibitungwa vy’Abalewi mu gishingo c’ibitungwa vy’Abisirayeli. Abalewi ni abanje. Ndi <char style="nd">Uhoraho</char>. <verse eid="NUM 3:45" /><verse number="46" style="v" sid="NUM 3:46" />Mu gucungura abo bana b’imfura amajana abiri na mirongo indwi na batatu barenga ku gitigiri c’Abalewi, <verse eid="NUM 3:46" /><verse number="47" style="v" sid="NUM 3:47" />uze wegeranye shekeli zitanu<note caller="+" style="f"><char style="fr" closed="false">3:47 </char><char style="ft" closed="false">Ni nk’amagarama 58.</char></note> ku muntu umwe umwe, ukoresheje ingero shekeli y’Ahera, ipima ingero gera mirongo ibiri. <verse eid="NUM 3:47" /><verse number="48" style="v" sid="NUM 3:48" />Uyatange kwa Aroni n’abahungu biwe kugira ngo ucungure abo Bisirayeli barengako.”<verse eid="NUM 3:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 3:49" />Nuko Mose yegeranya ayo mahera y’incungu y’Abisirayeli barenga kuri ca gitigiri cacunguwe n’Abalewi. <verse eid="NUM 3:49" /><verse number="50" style="v" sid="NUM 3:50" />Mu mfura z’Abisirayeli yegeranije ifeza zipima shekeli igihumbi n’amajana atatu na mirongo itandatu na zitanu<note caller="+" style="f"><char style="fr" closed="false">3:50 </char><char style="ft" closed="false">Ni nk’ibilo 16.</char></note>, hakoreshejwe ingero shekeli y’Ahera. <verse eid="NUM 3:50" /><verse number="51" style="v" sid="NUM 3:51" />Mose atanga ayo mahera y’incungu kwa Aroni n’abahungu biwe, nk’uko yari yabitegetswe n’ijambo ry’<char style="nd">Uhoraho</char>.<verse eid="NUM 3:51" /></para>
  <chapter eid="NUM 3" />
  <chapter number="4" style="c" sid="NUM 4" />
  <para style="s1">Ibikorwa vy’Abakohati</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1" />
    <char style="nd">Uhoraho</char> abarira Mose na Aroni ati: <verse eid="NUM 4:1" /><verse number="2" style="v" sid="NUM 4:2" />“Andika amazina y’abakomoka mu nzu kwa Kohati hamwe n’imiryango y’Abakohati bose bakomoka kuri Lewi. <verse eid="NUM 4:2" /><verse number="3" style="v" sid="NUM 4:3" />Uharure abagabo bose bafise imyaka mirongo itatu gushika kuri mirongo itanu bashobora gukora ibikorwa mw’Ihema ry’Ibonaniro.<verse eid="NUM 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 4:4" />Iki ni co gikorwa c’Abakohati mw’Ihema ry’Ibonaniro: ni ugutunganya ibintu vyeguriwe Uhoraho kuruta ibindi. <verse eid="NUM 4:4" /><verse number="5" style="v" sid="NUM 4:5" />Igihe Abisirayeli bazoba bagomba kuva aho bazoba bacumbitse, Aroni n’abahungu biwe baze binjire bamanure ca gihuzu gikingiriye ahera bagipfukishe ya Isandugu y’Isezerano. <verse eid="NUM 4:5" /><verse number="6" style="v" sid="NUM 4:6" />Hanyuma baze barenzeko igipfukisho gikozwe mu rusato, bongereko igitambara gikozwe mu bwoya bw’intama c’ubururu bace bashirako vya biti vyo guterura iyo sandugu.<verse eid="NUM 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7" />Hanyuma, baze basanze igitambara c’ubururu ku meza aho bahora bashira imikate yejejwe, bace bashiraho imibehe, amasahani n’ibikombe, n’ibikoresho vyo gutanga ishikanwa ry’ibinyobwa; ya mikate yama kuri iyo meza ize igumeko. <verse eid="NUM 4:7" /><verse number="8" style="v" sid="NUM 4:8" />Hejuru y’ivyo, baze basanzeko igitambara gitukura, barenzeko impuzu ikozwe mu rusato bace bashirako vya biti vyo guterura iyo meza.<verse eid="NUM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9" />Hanyuma, baze bafate igitambara c’ubururu bagipfukishe igiterekwako amatara n’amatara yaco, ivyo kuduza intambi n’ibijako umunyota, n’ibijamwo amavuta yo gusukwa mu matara. <verse eid="NUM 4:9" /><verse number="10" style="v" sid="NUM 4:10" />Bazoce bakizingira mu mpuzu ikozwe mu rusato hamwe n’ibikoresho bijanye na co babitereke ku nderuzo yaco.<verse eid="NUM 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11" />Hanyuma, baze bapfukishe ca gicaniro c’inzahabu igitambara c’ubururu barenzeko impuzu ikozwe mu rusato bace bashirako vya biti vyo kugiterura.<verse eid="NUM 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 4:12" />Bazoheze bafate ibindi bikoresho vyose bikoreshwa imbere mw’ihema, babizingire mu mpuzu y’ubururu, barenzeko impuzu y’urusato bace babishira ku nderuzo yavyo.<verse eid="NUM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 4:13" />Baze bakure iminyota kuri ca gicaniro c’umwakaka, hanyuma bagipfuke impuzu itukura. <verse eid="NUM 4:13" /><verse number="14" style="v" sid="NUM 4:14" />Bazoce bagishirako ibikoresho bikoreshwa mu bikorwa vyo ku gicaniro, harimwo ivyotezo, amakanya yo guterura inyama, amapanu n’ibikoresho vyo kumijagira amaraso. Baze bagipfukishe impuzu ikozwe mu rusato bace bashiramwo vya biti vyo kugiterura.<verse eid="NUM 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 4:15" />Aroni n’abahungu biwe nibaheza gupfuka ibikoresho vyose vyejejwe, abantu na bo bakaba biteguye kugenda bava aho bahora bacumbitse, Abakohati bazoce baza guterura ivyo bikoresho vyose. Ariko ntibaze bakore kuri vya bikoresho vyejejwe kuko bohava bapfa. Abakohati baze baterure vya bikoresho biri mw’ihema ry’ibonaniro.<verse eid="NUM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16" />Eliyazeri mwene Aroni, umuherezi, azoba ajejwe kuraba amavuta yo mu matara, ivyo guturirwa bimota neza, amashikanwa y’ifu atangwa imisi yose n’amavuta yo kurobanura. Azoba ajejwe ahera hose n’ibintu vyose biri ngaho, harimwo n’ibikoresho vyose vy’ahera.”<verse eid="NUM 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17" />
    <char style="nd">Uhoraho</char> abarira Mose na Aroni ati: <verse eid="NUM 4:17" /><verse number="18" style="v" sid="NUM 4:18" />“Muze mwiyubare kugira ngo inzu y’Abakohati ntize izimangane mu Balewi. <verse eid="NUM 4:18" /><verse number="19" style="v" sid="NUM 4:19" />Kugira ngo ntibaze bapfe igihe bazoba begereye ibintu vyera, ng’ibi ivyo mukwiye kubakorera: Aroni n’abahungu biwe baze baje mw’ihema kugira ngo umuntu wese bamwereke igikorwa akwiye gukora canke akwiye guterura. <verse eid="NUM 4:19" /><verse number="20" style="v" sid="NUM 4:20" />Ariko Abakohati ntibaze binjire mw’ihema ngo barabe ivyera, naho hoba akanya gatoya, kuko boca bapfa.”<verse eid="NUM 4:20" /></para>
  <para style="s1">Ibikorwa vy’Abagerushoni</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 4:21" /><verse number="22" style="v" sid="NUM 4:22" />“Andika amazina y’abakomoka mu nzu kwa Gerishoni hamwe n’imiryango y’Abagerishoni bose bakomoka kuri Lewi. <verse eid="NUM 4:22" /><verse number="23" style="v" sid="NUM 4:23" />Uharure abagabo bose bamaze imyaka mirongo itatu gushika kuri mirongo itanu baza gukora mw’ihema ry’ibonaniro.<verse eid="NUM 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 4:24" />Ibi ni vyo bikorwa vy’imiryango y’Abagerishoni: <verse eid="NUM 4:24" /><verse number="25" style="v" sid="NUM 4:25" />Bazoba bajejwe guterura ibihuzu bikingira ahera n’ivyo mw’ihema ry’ibonaniro, n’ico gupfuka ahera hamwe n’ibipfuka hanze bikozwe mu nsato, n’ibihuzu bikingira ku muryango w’ihema ry’ibonaniro, <verse eid="NUM 4:25" /><verse number="26" style="v" sid="NUM 4:26" />ibihuzu bikingira bigize urugo rw’ihema n’igicaniro, igihuzu gikingiriye irembo, imigozi n’ibindi bikoresho bijanye bigize urwo rugo. Abagerishoni baze bakore ibikeneye gukorwa vyo kuri ivyo bintu. <verse eid="NUM 4:26" /><verse number="27" style="v" sid="NUM 4:27" />Aroni n’abahungu biwe baze bereke Abagerishoni ibikorwa vyose bajejwe vyaba ivyo bakora canke ivyo baterura. <verse eid="NUM 4:27" /><verse number="28" style="v" sid="NUM 4:28" />Ivyo ni vyo abakomoka ku nzu ya Gerishoni bazokora mw’ihema ry’ibonaniro. Ivyo bazokora baze babikore barongowe na Itamari mwene Aroni, umuherezi.<verse eid="NUM 4:28" /></para>
  <para style="s1">Ibikorwa vy’Abamerari</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29" />Andika amazina y’abakomoka mu nzu kwa Merari hamwe n’imiryango y’Abamerari bose bakomoka kuri Lewi. <verse eid="NUM 4:29" /><verse number="30" style="v" sid="NUM 4:30" />Uze uharure abagabo bose bakwije imyaka mirongo itatu gushika ku mirongo itanu bakwiye gukora mw’ihema ry’ibonaniro. <verse eid="NUM 4:30" /><verse number="31" style="v" sid="NUM 4:31" />Iki ni co gikorwa cabo bazokora mw’ihema ry’ibonaniro: kurerura imbaho zubatse ihema, imitambikwa, inkingi n’ivyo kuziterekamwo, <verse eid="NUM 4:31" /><verse number="32" style="v" sid="NUM 4:32" />inkingi z’urugo n’ivyo kuziterekamwo, imambo zo gushinga ihema, imigozi, n’ibindi vyose bijanye n’igikorwa cavyo. Uze ugenere umuntu wese ivyo akwiye guterura. <verse eid="NUM 4:32" /><verse number="33" style="v" sid="NUM 4:33" />Ivyo ni vyo bikorwa vy’abakomoka kuri Merari nk’uko bakora mw’ihema ry’ibonaniro barongowe na Itamari mwene Aroni, umuherezi.”<verse eid="NUM 4:33" /></para>
  <para style="s1">Guharurwa kw’imiryango y’Abalewi</para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 4:34" />Mose, Aroni n’abakuru barongoye abandi baharura Abakohati nk’uko inzu zabo n’imiryango yabo biri.<verse eid="NUM 4:34" /></para>
  <para style="li2">
    <verse number="35" style="v" sid="NUM 4:35" />Abagabo bose bamaze imyaka mirongo itatu gushika ku myaka mirongo itanu baza gukora mu gikorwa co mw’ihema ry’ibonaniro, <verse eid="NUM 4:35" /><verse number="36" style="v" sid="NUM 4:36" />basanze bose hamwe ari ibihumbi bibiri n’amajana indwi na mirongo itanu. <verse eid="NUM 4:36" /><verse number="37" style="v" sid="NUM 4:37" />Ico ni co cari igitigiri c’abakomoka kuri ku mazu ya Kohati bakora mw’ihema ry’ibonaniro. Mose na Aroni barabaharura nk’uko <char style="nd">Uhoraho</char> yari yabitegetse Mose.<verse eid="NUM 4:37" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="38" style="v" sid="NUM 4:38" />Abagerishoni baraharurwa nk’uko amazu yabo n’imiryango yabo iri.<verse eid="NUM 4:38" /></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 4:39" />Abagabo bose bamaze imyaka iri hagati ya mirongo itatu na mirongo itanu bakwiye gukora mw’ihema ry’ibonaniro, <verse eid="NUM 4:39" /><verse number="40" style="v" sid="NUM 4:40" />baharuwe nk’uko amazu n’imiryango yabo biri basanze ari ibihumbi bibiri n’amajana atandatu na mirongo itatu. <verse eid="NUM 4:40" /><verse number="41" style="v" sid="NUM 4:41" />Ico cari igitigiri c’abakomoka kuri Gerishoni bakora mw’ihema ry’ibonaniro. Mose na Aroni barabaharura nk’uko <char style="nd">Uhoraho</char> yari yabitegetse.<verse eid="NUM 4:41" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="42" style="v" sid="NUM 4:42" />Abamerari baraharurwa nk’uko amazu n’imiryango yabo biri.<verse eid="NUM 4:42" /></para>
  <para style="li2">
    <verse number="43" style="v" sid="NUM 4:43" />Abagabo bose bari hagati y’imyaka mirongo itatu na mirongo itanu baza gukora mw’ihema ry’ibonaniro, <verse eid="NUM 4:43" /><verse number="44" style="v" sid="NUM 4:44" />baharuwe nk’uko amazu n’imiryango yabo biri bari ibihumbi bitatu n’amajana abiri. <verse eid="NUM 4:44" /><verse number="45" style="v" sid="NUM 4:45" />Ico ni co gitigiri c’abakomoka ku mazu n’imiryango y’Abamerari. Mose na Aroni barabaharura nk’uko <char style="nd">Uhoraho</char> yari yabitegetse abicishije kuri Mose.<verse eid="NUM 4:45" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="46" style="v" sid="NUM 4:46" />Nuko Mose, Aroni n’abakuru b’Abisirayeli baharura Abalewi bose bakurikije amazu yabo n’imiryango yabo. <verse eid="NUM 4:46" /><verse number="47" style="v" sid="NUM 4:47" />Abagabo bose bamaze imyaka mirongo itatu gushika kuri mirongo itanu bakwiye gukora mw’ihema ry’ibonaniro <verse eid="NUM 4:47" /><verse number="48" style="v" sid="NUM 4:48" />bari ibihumbi umunani n’amajana atanu na mirongo umunani. <verse eid="NUM 4:48" /><verse number="49" style="v" sid="NUM 4:49" />Nk’uko <char style="nd">Uhoraho</char> yari yabitegetse abicishije kuri Mose, umwe wese ahabwa igikorwa ciwe kandi abarirwa ico akwiye guterura.</para>
  <para style="b" vid="NUM 4:49" />
  <para style="p" vid="NUM 4:49">Maze bose baharurwa, nk’uko <char style="nd">Uhoraho</char> yari yabitegetse Mose.<verse eid="NUM 4:49" /></para>
  <chapter eid="NUM 4" />
  <chapter number="5" style="c" sid="NUM 5" />
  <para style="s1">Ukwirinda ibihumanya aho bacumbitse</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 5:1" /><verse number="2" style="v" sid="NUM 5:2" />“Tegeka Abisirayeli ngo baze bakure hagati muri bo umuntu wese afise imibembe canke afise ibintu bimuvamwo vy’uburyo ubwo ari bwo bwose, canke yahumanijwe no gukora ku muvyimba. <verse eid="NUM 5:2" /><verse number="3" style="v" sid="NUM 5:3" />Muze musohore yaba umugabo canke umugore; muze mubasohore bave aho mucumbitse kugira ngo ntibahumanye ikoraniro ryose, kuko jewe mba hagati muri bo.” <verse eid="NUM 5:3" /><verse number="4" style="v" sid="NUM 5:4" />Abisirayeli babikora nk’uko <char style="nd">Uhoraho</char> yabitegetse Mose, barabasohora babajana inyuma y’aho bacumbitse.<verse eid="NUM 5:4" /></para>
  <para style="s1">Ivyerekeye indishi</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 5:5" /><verse number="6" style="v" sid="NUM 5:6" />“Barira Abisirayeli uti: ‘Nihagira umugabo canke umugore agirira nabi uwundi mu buryo ubwo ari bwo bwose, bigatuma ataba umwizigirwa imbere y’<char style="nd">Uhoraho</char>, uwo muntu azoba ari uwo gutsindwa n’urubanza <verse eid="NUM 5:6" /><verse number="7" style="v" sid="NUM 5:7" />kandi azoba akwiye kwatura icaha yakoze. Aze arihe ivyo yononye vyose, yongereko ica gatanu c’ico kintu; vyose ace abiha uwo yagiriye nabi. <verse eid="NUM 5:7" /><verse number="8" style="v" sid="NUM 5:8" />Ariko niyaba nyenevyo yarapfuye akaba atagira incuti ya hafi yoshobora kwakira iyo ndishi, izoba ari iy’<char style="nd">Uhoraho</char> izoce ihabwa umuherezi, ayiherekereshe impfizi y’intama yo gutanga impongano yiwe. <verse eid="NUM 5:8" /><verse number="9" style="v" sid="NUM 5:9" />Ibimazi vyose bikuwe ku vyo Abisirayeli bazoba bahaye Uhoraho bizoba ari ivy’umuherezi. <verse eid="NUM 5:9" /><verse number="10" style="v" sid="NUM 5:10" />Ibintu vyejejwe biba ari ivya nyenevyo; ico umuntu ahaye umuherezi kizoba ari ic’umuherezi.’ ”<verse eid="NUM 5:10" /></para>
  <para style="s1">Uburyo bwo gusuzuma umugore yarenze ibigo</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11" />Nuko <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 5:11" /><verse number="12" style="v" sid="NUM 5:12" />“Vugana n’Abisirayeli ubabwire uti: ‘Umugore afise umugabo niyigenza nabi agahemukira umugabo wiwe <verse eid="NUM 5:12" /><verse number="13" style="v" sid="NUM 5:13" />mu kuryamana n’uwundi mugabo, kandi ivyo umugabo wiwe akaba ata vyo azi kuko ubwo buhumane bwiwe butamenyekanye (kuko ata cabona co kumwagiriza kandi ata wigeze amufata), <verse eid="NUM 5:13" /><verse number="14" style="v" sid="NUM 5:14" />ariko umugabo akamwikeka ko yiyanduje mu kumuhemukira, canke na ho akamwikeka kandi atiyanduje, <verse eid="NUM 5:14" /><verse number="15" style="v" sid="NUM 5:15" />azoce atwara uwo mugore ku muherezi. Aze ajane n’ishikanwa ringana n’ic’icumi c’ingero efa<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="ft" closed="false">Ni nk’ikilo 1,6.</char></note> y’ifu ya sayiri amutangira. Ntaze ayisukeko amavuta canke ngo ayishireko ivyo baturira bikamota neza, kuko ari ishikanwa ry’ifu ritanzwe kubera umwikeko, kandi ari ukugira ngo ikibi kimenyekane.<verse eid="NUM 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16" />Uwo muherezi aze amuzane amuhagarike imbere y’<char style="nd">Uhoraho</char>. <verse eid="NUM 5:16" /><verse number="17" style="v" sid="NUM 5:17" />Hanyuma ashire amazi ahezagiye mu nkono y’ibumba ashiremwo ivu akuye ahera. <verse eid="NUM 5:17" /><verse number="18" style="v" sid="NUM 5:18" />Amaze kumuhagarika imbere y’<char style="nd">Uhoraho</char>, aze apfundurure umushatsi w’uwo mugore ashire mu maboko yiwe rya shikanwa, rimwe ry’ifu ryatanzwe kubera kumwikeka, na we aze agumye ya mazi arura azana umuvumo. <verse eid="NUM 5:18" /><verse number="19" style="v" sid="NUM 5:19" />Hanyuma aze arahize uwo mugore avuga ati: “Niwaba ata mugabo mwaryamanye kandi utahemukiye umugabo wawe ngo wiyanduze kandi wari ufise umugabo wawe, aya mazi arura kandi atera umuvumo ntagire ico akugira. <verse eid="NUM 5:19" /><verse number="20" style="v" sid="NUM 5:20" />Ariko niwaba warahemutse kandi ufise umugabo wawe ukaba wariyanduje mu kuryamana n’uwundi mugabo atari rwawe”; <verse eid="NUM 5:20" /><verse number="21" style="v" sid="NUM 5:21" />aha rero umuherezi aze ashire kuri uwo mugore umuvumo uri muri iyi ndahiro ati: “<char style="nd">Uhoraho</char> atume abantu bawe bakuvuma bongere bakugire akabarore kuko azoba aguhinduye ingumba kandi atumye inda yawe ivyimba. <verse eid="NUM 5:21" /><verse number="22" style="v" sid="NUM 5:22" />Aya mazi atera umuvumo yinjire muri wewe atume inda yawe ivyimba kandi aguhindure ingumba.”</para>
  <para style="p" vid="NUM 5:22">Uwo mugore aze yishure ati: “Amen. Nibibe gutyo.”<verse eid="NUM 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23" />Uwo muherezi aze yandike iyo mivumo ku muzingo w’igitabu kandi azoce ayogesha ya mazi y’umururazi. <verse eid="NUM 5:23" /><verse number="24" style="v" sid="NUM 5:24" />Azoce aha wa mugore ayo mazi atera umuvumo ayanywe, na yo azomutera ububabare bwinshi. <verse eid="NUM 5:24" /><verse number="25" style="v" sid="NUM 5:25" />Uwo muherezi azoce afata rya shikanwa ry’ifu ritanzwe kubera ukwikeka ryari mu minwe yiwe, arizungagize imbere y’<char style="nd">Uhoraho</char> azoce arizana ku gicaniro. <verse eid="NUM 5:25" /><verse number="26" style="v" sid="NUM 5:26" />Uwo muherezi aze afate ifu yuzuye igipfunsi kuri iryo shikanwa kugira ribe ishikanwa ry’icibutso arituririre ku gicaniro; inyuma y’ivyo, azoce anywesha ya mazi wa mugore. <verse eid="NUM 5:26" /><verse number="27" style="v" sid="NUM 5:27" />Niyaba yariyandurishije kurenga ibigo kandi afise umugabo, hanyuma akanyweshwa ayo mazi atera umuvumo, azoca yinjira muri we amutere ububabare bwinshi; inda yiwe izovyimba hanyuma abe ingumba, yongere abe ikivume mu bantu b’iwabo. <verse eid="NUM 5:27" /><verse number="28" style="v" sid="NUM 5:28" />Ariko niyaba atiyanduje akaba adahumanye, nta co azoba azokurwako urubanza ashobore no kuvyara abana.<verse eid="NUM 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29" />Iri ni ryo tegeko rijanye n’ukwikeka ko umugore yahemukiye umugabo akiyanduza kandi afise umugabo wiwe, <verse eid="NUM 5:29" /><verse number="30" style="v" sid="NUM 5:30" />canke umugabo niyafatwa n’ivyiyumviro vyo kwikeka umugore wiwe. Umuherezi aze amuhagarike imbere y’<char style="nd">Uhoraho</char> ace akoresha iryo tegeko ryose kuri we. <verse eid="NUM 5:30" /><verse number="31" style="v" sid="NUM 5:31" />Umugabo we nta co azokwagirizwa na kimwe, ariko umugore we azogibwako n’inkurikizi zose z’icaha ciwe.’ ”<verse eid="NUM 5:31" /></para>
  <chapter eid="NUM 5" />
  <chapter number="6" style="c" sid="NUM 6" />
  <para style="s1">Ivyerekeye kuba umunaziri</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 6:1" /><verse number="2" style="v" sid="NUM 6:2" />“Barira Abisirayeli uti: ‘Umugabo canke umugore niyashaka gusezerana isezerano ridasanzwe, isezerano ryo kwiyegurira <char style="nd">Uhoraho</char>; ari kwo kuba umunaziri, <verse eid="NUM 6:2" /><verse number="3" style="v" sid="NUM 6:3" />aze yirinde ntanywe umuvinyu canke ikindi kinyobwa kiboreza na kimwe canke inkarisha yakozwe mu muvinyu canke mu kindi kinyobwa cambiwe. Ntaze anywe umutobe ukozwe mu vyamwa vy’umuzabibu canke ngo arye ivyamwa vy’umuzabibu. <verse eid="NUM 6:3" /><verse number="4" style="v" sid="NUM 6:4" />Igihe cose azoba akiri umunaziri, ntaze yigere arya ikintu na kimwe kiva mu muzabibu, n’aho zoba imbuto canke ibishishwa.<verse eid="NUM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5" />Mu kiringo cose iryo sezerano rizomara, ntaze yigere yikozako urwembe. Azogume ari uwera gushika ico kiringo co kwiyegurira <char style="nd">Uhoraho</char> giheze; aze areke umushatsi wo ku mutwe wiwe ukure ube muremure.<verse eid="NUM 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 6:6" />Muri ico kiringo co kwiyegurira <char style="nd">Uhoraho</char> ntaze yegere umuvyimba w’uwapfuye. <verse eid="NUM 6:6" /><verse number="7" style="v" sid="NUM 6:7" />Naho yoba ari se canke nyina canke uwo bavukana yapfuye, ntaze yiyandurishe imivyimba yabo, kuko ikimenyetso co kwiyegurira Imana ciwe kiri ku mutwe wiwe. <verse eid="NUM 6:7" /><verse number="8" style="v" sid="NUM 6:8" />Muri ico kiringo cose azoba yiyeguye azoba yatoranirijwe <char style="nd">Uhoraho</char>.<verse eid="NUM 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9" />Umuntu niyapfa giturumbuka agapfira imbere yiwe, bigatuma yanduza umushatsi wiwe, aze yimoshe umushatsi ku musi wo guhumanurwa kwiwe, ari ho ku musi ugira indwi. <verse eid="NUM 6:9" /><verse number="10" style="v" sid="NUM 6:10" />Hanyuma ku musi ugira umunani aze azane ivyana bibiri vy’inuma canke vy’intunguru, abihe umuherezi ku muryango w’Ihema ry’Ibonaniro. <verse eid="NUM 6:10" /><verse number="11" style="v" sid="NUM 6:11" />Uwo muherezi aze atange kimwe kw’ikimazi c’ivyaha ikindi kw’ikimazi co guturirwa kugira ngo amutangire impongano kuko yacumuye mu kwegera umuvyimba. Kuri uwo musi nyene aze asubire yegurire umutwe wiwe kuba uwera. <verse eid="NUM 6:11" /><verse number="12" style="v" sid="NUM 6:12" />Aze yiyegurire <char style="nd">Uhoraho</char> mu kiringo cose yasezeranye kandi aze atange umwagazi w’intama utarengeje umwaka umwe w’ikimazi c’indishi. Ariko imisi yari amaze nta n’umwe uzoharurwa, kuko yabaye uwuhumanye mu gihe ciwe c’ubunaziri.<verse eid="NUM 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13" />Iri ni ryo tegeko ku munaziri ahejeje ikiringo ciwe co kuba umunaziri: aze azanwe ku muryango w’ihema ry’ibonaniro. <verse eid="NUM 6:13" /><verse number="14" style="v" sid="NUM 6:14" />Aho ni ho azotangira ibimazi vyiwe vy’<char style="nd">Uhoraho</char>: impfizi y’intama imaze umwaka umwe itagira agasembwa y’ikimazi co guturirwa, umwagazi uvyara w’intama umaze umwaka umwe utagira agasembwa w’ikimazi c’ivyaha, impfizi y’intama y’ikimazi c’ishimwe, <verse eid="NUM 6:14" /><verse number="15" style="v" sid="NUM 6:15" />biri kumwe n’amashikanwa y’ifu yavyo hamwe n’amashikanwa y’ibinyobwa yavyo, igiseke c’imikate itarimwo umwambiro, imikate ikozwe mw’ifu inoze neza ikaranzwe mu amavuta, n’imikate itarimwo umwambiro isize mavuta.<verse eid="NUM 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16" />Umuherezi aze abizane imbere y’<char style="nd">Uhoraho</char> ace atanga ca kimazi c’ivyaha na ca kimazi co guturirwa. <verse eid="NUM 6:16" /><verse number="17" style="v" sid="NUM 6:17" />Aze ashikane na ca giseke c’imikate itarimwo umwambiro ace ashikanira <char style="nd">Uhoraho</char> ya mpfizi y’intama y’ikimazi c’impongano, hamwe n’amashikanwa yaco y’ifu n’ibinyobwa.<verse eid="NUM 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 6:18" />Hanyuma wa munaziri akiri ngaho ku muryango w’ihema ry’ibonaniro, aze yimoshe wa mushatsi yari yarateretse. Aze afate wa mushatsi awuterere mu muriro uri musi y’ikimazi c’impongano.<verse eid="NUM 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 6:19" />Uwo munaziri ahejeje kwimosha umushatsi yari yarateretse, umuherezi aze ashire mu minwe yiwe igitugu ca ya mpfizi y’intama yatetswe mu mazi, n’umukate umwe utetswe mu mavuta n’umukate umwe usizwe amavuta iri muri ca giseke, yompi izoba itarimwo umwambiro. <verse eid="NUM 6:19" /><verse number="20" style="v" sid="NUM 6:20" />Umuherezi aze abizungagize imbere y’<char style="nd">Uhoraho</char> nk’ishikanwa ryo kuzungagiza; bizoba ari ivyera kandi bibe ivy’umuherezi, harimwo na ca gikiriza cazungagizwa na rya tako ryatangwa. Inyuma y’ivyo, uwo munaziri ashobora kunywa umuvinyu.<verse eid="NUM 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21" />Iryo ni ryo tegeko rigenga umunaziri yasezeranye kwiyegurira <char style="nd">Uhoraho</char> kubera isezerano. Bashobora kwongerako ikindi cose bashobora kuronka. Aze ashitse ico yasezeranye, nk’uko itegeko ryo kuba umunaziri rivuga.’ ”<verse eid="NUM 6:21" /></para>
  <para style="s1">Imihezagiro abaherezi batanga</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 6:22" /><verse number="23" style="v" sid="NUM 6:23" />“Bwira Aroni n’abahungu biwe uti: ‘Uku ni ko muzohezagira Abisirayeli. Muze mubabwire muti:<verse eid="NUM 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24" />“<char style="nd">Uhoraho</char> aguhezagire</para>
  <para style="q2" vid="NUM 6:24">kandi akuzigame;<verse eid="NUM 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 6:25" />
    <char style="nd">Uhoraho</char> akumurikishirize mu nyonga hiwe</para>
  <para style="q2" vid="NUM 6:25">kandi akugirire ubuntu;<verse eid="NUM 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26" />
    <char style="nd">Uhoraho</char> aguhindukirize inyonga ziwe</para>
  <para style="q2" vid="NUM 6:26">kandi aguhe amahoro.” ’<verse eid="NUM 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27" />Uko ni ko bazoshira izina ryanje ku Bisirayeli, nanje nzobahezagira.”<verse eid="NUM 6:27" /></para>
  <chapter eid="NUM 6" />
  <chapter number="7" style="c" sid="NUM 7" />
  <para style="s1">Ibimazi vyatanzwe mu gushikiriza <char style="nd">Uhoraho</char> ihema</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1" />Ku musi Mose yaherejeko gutunganya rya hema, yaciye arirobanuza amavuta arishikiriza Imana hamwe n’ibikoresho vyose biri muri ryo. Yarobanuye kandi igicaniro n’ibikoresho vyaco. <verse eid="NUM 7:1" /><verse number="2" style="v" sid="NUM 7:2" />Hanyuma abakuru b’Abisirayeli, abakuru b’amazu aserukira imiryango bari bashinzwe guharura abasoda, baraza batanga ibimazi vyabo. <verse eid="NUM 7:2" /><verse number="3" style="v" sid="NUM 7:3" />Bazana ingabire k’<char style="nd">Uhoraho</char> igizwe n’imikogote itandatu ikwegwa n’impfizi zibiri, bazana n’impfizi z’inka icumi na zibiri, abakuru babiri basangira umukogote kandi umukuru wese atanga impfizi imwimwe. Ivyo vyose babizana imbere y’ihema.<verse eid="NUM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 7:4" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 7:4" /><verse number="5" style="v" sid="NUM 7:5" />“Ubakirire ivyo batanze, kugira ngo bikoreshwe mu gikorwa co mw’Ihema ry’Ibonaniro. Ubihereze Abalewi nk’uko igikorwa c’umuntu wese kiri.”<verse eid="NUM 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 7:6" />Nuko Mose yakira ya mikogote na za mpfizi z’inka abiha Abalewi. <verse eid="NUM 7:6" /><verse number="7" style="v" sid="NUM 7:7" />Abagerishoni abaha imikogote ibiri n’impfizi z’inka zine, nk’uko igikorwa cabo cabisaba, <verse eid="NUM 7:7" /><verse number="8" style="v" sid="NUM 7:8" />Abamerari abaha imikogote ine n’impfizi umunani nk’uko igikorwa cabo cabisaba. Bose bari barongowe na Itamari mwene Aroni, umuherezi. <verse eid="NUM 7:8" /><verse number="9" style="v" sid="NUM 7:9" />Ariko Mose ntiyaha na kimwe Abakohati, kuko bari bajejwe ivyerejwe Uhoraho, bakaba bategerezwa kubirerura ku bitugu vyabo.<verse eid="NUM 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10" />Igihe igicaniro carobanuzwa amavuta, ba bakuru bazanye ibimazi vyabo vyo kukirobanura barabizana babishira imbere y’igicaniro. <verse eid="NUM 7:10" /><verse number="11" style="v" sid="NUM 7:11" /><char style="nd">Uhoraho</char> yari yabwiye Mose ati: “Ku musi ku musi umukuru umwe wese aze atange ikimazi ciwe co guhereza Imana ico gicaniro.”<verse eid="NUM 7:11" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="12" style="v" sid="NUM 7:12" />Uwazanye ishikanwa ryiwe ku musi wa mbere yari Nahashoni mwene Aminadabu wo mu muryango wa Yuda.<verse eid="NUM 7:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 7:13" />Ishikanwa ryiwe ryari:</para>
  <para style="li2" vid="NUM 7:13">isiniya ikozwe mw’ifeza ipima shekeli ijana na mirongo itatu<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">Ni nk’ikilo 1,5.</char></note>, n’igikombe c’ifeza gipima shekeli mirongo indwi<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">Ni nk’amagarama 800.</char></note>, vyompi vyapimwe hakoreshejwe ingero shekeli y’Ahera, kimwe cose cuzuye ifu inoze neza ivanze n’amavuta y’ishikanwa ry’ifu;<verse eid="NUM 7:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="NUM 7:14" />isahani imwe y’inzahabu ipima shekeli icumi<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">Ni nk’amagarama 115.</char></note>, yuzuye ibimota neza;<verse eid="NUM 7:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="NUM 7:15" />ishuri imwe, impfizi y’intama imwe n’umwagazi w’intama umaze umwaka, ngo bibe ikimazi co guturirwa;<verse eid="NUM 7:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="NUM 7:16" />isuguru y’impene imwe y’ikimazi c’ivyaha;<verse eid="NUM 7:16" /></para>
  <para style="li2">
    <verse number="17" style="v" sid="NUM 7:17" />n’impfizi zibiri z’inka, impfizi z’intama zitanu, amasuguru atanu y’impene n’imyagazi itanu y’intama imaze umwaka umwe, vyo gutangwa kw’ikimazi c’ishimwe.</para>
  <para style="lf" vid="NUM 7:17">Iryo ni ryo ryari ishikanwa rya Nahashoni mwene Aminadabu.<verse eid="NUM 7:17" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="18" style="v" sid="NUM 7:18" />Ku musi ugira kabiri Netaneli mwene Zuwari, Umukuru w’umuryango w’Abisakari, azana ishikanwa ryiwe.<verse eid="NUM 7:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 7:19" />Ishikanwa ryiwe ryari:</para>
  <para style="li2" vid="NUM 7:19">isiniya ikozwe mw’ifeza ipima shekeli ijana na mirongo itatu, n’igikombe c’ifeza gipima shekeli mirongo indwi, vyose vyapimwe hakoreshejwe ingero shekeli y’Ahera, kimwe cose cuzuye ifu inoze neza ivanze n’amavuta y’ishikanwa ry’ifu;<verse eid="NUM 7:19" /></para>
  <para style="li2">
    <verse number="20" style="v" sid="NUM 7:20" />isahani imwe y’inzahabu ipima shekeli icumi, yuzuye ibimota neza;<verse eid="NUM 7:20" /></para>
  <para style="li2">
    <verse number="21" style="v" sid="NUM 7:21" />ishuri imwe, impfizi y’intama imwe n’umwagazi w’intama umaze umwaka, ngo bibe ikimazi co guturirwa;<verse eid="NUM 7:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="NUM 7:22" />isuguru y’impene imwe y’ikimazi c’ivyaha;<verse eid="NUM 7:22" /></para>
  <para style="li2">
    <verse number="23" style="v" sid="NUM 7:23" />n’impfizi zibiri z’inka, impfizi zitanu z’intama, amasuguru atanu y’impene n’imyagazi itanu y’intama imaze umwaka, vyo gutangwa kw’ikimazi c’ishimwe.</para>
  <para style="lf" vid="NUM 7:23">Iryo ni ryo ryari ishikanwa rya Netaneli mwene Zuwari.<verse eid="NUM 7:23" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="24" style="v" sid="NUM 7:24" />Ku musi ugira gatatu, Eliyabu mwene Heloni, umukuru w’umuryango w’Abazebuloni, azana ishikanwa ryiwe.<verse eid="NUM 7:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 7:25" />Ishikanwa ryiwe ryari iri: isiniya y’ifeza ipima shekeli ijana na mirongo itatu, n’igikombe c’ifeza gipima shekeli mirongo indwi, vyompi vyapimwe hakoreshejwe ingero shekeli y’Ahera, kimwe cose cuzuye ifu inoze neza ivanze n’amavuta y’ishikanwa ry’ifu;<verse eid="NUM 7:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="NUM 7:26" />isahani imwe y’inzahabu ipima shekeli icumi, yuzuye ibimota neza;<verse eid="NUM 7:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="NUM 7:27" />ishuri imwe, impfizi y’intama imwe n’umwagazi w’intama umaze umwaka, ngo bibe ikimazi co guturirwa;<verse eid="NUM 7:27" /></para>
  <para style="li2">
    <verse number="28" style="v" sid="NUM 7:28" />isuguru y’impene imwe y’ikimazi c’ivyaha;<verse eid="NUM 7:28" /></para>
  <para style="li2">
    <verse number="29" style="v" sid="NUM 7:29" />n’impfizi zibiri z’inka, impfizi zitanu z’intama, impfizi zitanu z’impene n’amasuguru atanu y’intama amaze umwaka umwe, vyo gutangwa kw’ikimazi c’ishimwe.</para>
  <para style="lf" vid="NUM 7:29">Iryo ni ryo ryari ishikanwa rya Eliyabu mwene Heloni.<verse eid="NUM 7:29" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="30" style="v" sid="NUM 7:30" />Ku musi ugira kane Elisuri mwene Shedewuri, umukuru w’umuryango w’Abareyubeni, azana ishikanwa ryiwe.<verse eid="NUM 7:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="NUM 7:31" />Ishikanwa ryiwe ryari iri: isiniya y’ifeza ipima shekeli ijana na mirongo itatu, n’igikombe c’ifeza gipima shekeli mirongo indwi, vyompi vyapimwe hakoreshejwe ingero shekeli y’Ahera, kimwe cose cuzuye ifu inoze neza ivanze n’amavuta y’ishikanwa ry’ifu;<verse eid="NUM 7:31" /></para>
  <para style="li2">
    <verse number="32" style="v" sid="NUM 7:32" />isahani imwe y’inzahabu ipima shekeli icumi, yuzuye ibimota neza;<verse eid="NUM 7:32" /></para>
  <para style="li2">
    <verse number="33" style="v" sid="NUM 7:33" />ishuri imwe, impfizi y’intama ikuze imwe n’impfizi y’intama imaze umwaka, ngo bibe ikimazi co guturirwa;<verse eid="NUM 7:33" /></para>
  <para style="li2">
    <verse number="34" style="v" sid="NUM 7:34" />isuguru y’impene imwe y’ikimazi c’ivyaha;<verse eid="NUM 7:34" /></para>
  <para style="li2">
    <verse number="35" style="v" sid="NUM 7:35" />n’impfizi zibiri z’inka, impfizi zitanu z’intama, impfizi zitanu z’impene n’amasuguru atanu y’intama amaze umwaka umwe, vyo gutangwa kw’ikimazi c’ishimwe.</para>
  <para style="lf" vid="NUM 7:35">Iryo ni ryo ryari ishikanwa rya Elisuri mwene Shedewuri.<verse eid="NUM 7:35" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="36" style="v" sid="NUM 7:36" />Ku musi ugira gatanu Shelumiyeli mwene Zurishadayi, umukuru w’umuryango w’Abasimeyoni, azana ishikanwa ryiwe.<verse eid="NUM 7:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="NUM 7:37" />Ishikanwa ryiwe ryari iri: isiniya y’ifeza ipima shekeli ijana na mirongo itatu, n’igikombe c’ifeza gipima shekeli mirongo indwi, vyompi vyapimwe hakoreshejwe ingero shekeli y’Ahera, kimwe cose cuzuye ifu inoze neza ivanze n’amavuta y’ishikanwa ry’ifu;<verse eid="NUM 7:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="NUM 7:38" />isahani imwe y’inzahabu ipima shekeli icumi, yuzuye ibimota neza;<verse eid="NUM 7:38" /></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 7:39" />ishuri imwe, impfizi y’intama ikuze imwe n’impfizi y’intama imaze umwaka, ngo bibe ikimazi co guturirwa;<verse eid="NUM 7:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="NUM 7:40" />isuguru y’impene imwe y’ikimazi c’ivyaha;<verse eid="NUM 7:40" /></para>
  <para style="li2">
    <verse number="41" style="v" sid="NUM 7:41" />n’impfizi zibiri z’inka, impfizi zitanu z’intama, impfizi zitanu z’impene n’amasuguru atanu y’intama amaze umwaka umwe, vyo gutangwa kw’ikimazi c’ishimwe.</para>
  <para style="lf" vid="NUM 7:41">Iryo ni ryo ryari ishikanwa rya Shelumiyeli mwene Zurishadayi.<verse eid="NUM 7:41" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="42" style="v" sid="NUM 7:42" />Ku musi ugira gatandatu Eliyasafu mwene Dewuyeli, umukuru w’umuryango w’Abagadi, azana ishikanwa ryiwe.<verse eid="NUM 7:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="NUM 7:43" />Ishikanwa ryiwe ryari iri: isiniya y’ifeza ipima shekeli ijana na mirongo itatu, n’igikombe c’ifeza gipima shekeli mirongo indwi, vyompi vyapimwe hakoreshejwe ingero shekeli y’Ahera, kimwe cose cuzuye ifu inoze neza ivanze n’amavuta y’ishikanwa ry’ifu;<verse eid="NUM 7:43" /></para>
  <para style="li2">
    <verse number="44" style="v" sid="NUM 7:44" />isahani imwe y’inzahabu ipima shekeli icumi, yuzuye ibimota neza;<verse eid="NUM 7:44" /></para>
  <para style="li2">
    <verse number="45" style="v" sid="NUM 7:45" />ishuri imwe, impfizi y’intama ikuze imwe n’impfizi y’intama imaze umwaka, ngo bibe ikimazi co guturirwa;<verse eid="NUM 7:45" /></para>
  <para style="li2">
    <verse number="46" style="v" sid="NUM 7:46" />isuguru y’impene imwe y’ikimazi c’ivyaha;<verse eid="NUM 7:46" /></para>
  <para style="li2">
    <verse number="47" style="v" sid="NUM 7:47" />n’impfizi zibiri z’inka, impfizi zitanu z’intama, impfizi zitanu z’impene n’amasuguru atanu y’intama amaze umwaka umwe, vyo gutangwa kw’ikimazi c’ishimwe.</para>
  <para style="lf" vid="NUM 7:47">Iryo ni ryo ryari ishikanwa rya Eliyasafu mwene Dewuyeli.<verse eid="NUM 7:47" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="48" style="v" sid="NUM 7:48" />Ku musi ugira indwi Elishama mwene Amihudi, umukuru w’umuryango w’Abefurayimu, azana ishikanwa ryiwe.<verse eid="NUM 7:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="NUM 7:49" />Ishikanwa ryiwe ryari iri: isiniya y’ifeza ipima shekeli ijana na mirongo itatu, n’igikombe c’ifeza gipima shekeli mirongo indwi, vyompi vyapimwe hakoreshejwe ingero shekeli y’Ahera, kimwe cose cuzuye ifu inoze neza ivanze n’amavuta y’ishikanwa ry’ifu;<verse eid="NUM 7:49" /></para>
  <para style="li2">
    <verse number="50" style="v" sid="NUM 7:50" />isahani imwe y’inzahabu ipima shekeli icumi, yuzuye ibimota neza;<verse eid="NUM 7:50" /></para>
  <para style="li2">
    <verse number="51" style="v" sid="NUM 7:51" />ishuri imwe, impfizi y’intama ikuze imwe n’impfizi y’intama imaze umwaka, ngo bibe ikimazi co guturirwa;<verse eid="NUM 7:51" /></para>
  <para style="li2">
    <verse number="52" style="v" sid="NUM 7:52" />isuguru y’impene imwe y’ikimazi c’ivyaha;<verse eid="NUM 7:52" /></para>
  <para style="li2">
    <verse number="53" style="v" sid="NUM 7:53" />n’impfizi zibiri z’inka, impfizi zitanu z’intama, impfizi zitanu z’impene n’amasuguru atanu y’intama amaze umwaka umwe, vyo gutangwa kw’ikimazi c’ishimwe.</para>
  <para style="lf" vid="NUM 7:53">Iryo ni ryo ryari ishikanwa rya Elishama mwene Amihudi.<verse eid="NUM 7:53" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="54" style="v" sid="NUM 7:54" />Ku musi ugira umunani Gamaliyeli mwene Pedasuri, umukuru w’umuryango w’Abamanase, azana ishikanwa ryiwe.<verse eid="NUM 7:54" /></para>
  <para style="li1">
    <verse number="55" style="v" sid="NUM 7:55" />Ishikanwa ryiwe ryari iri: isiniya y’ifeza ipima shekeli ijana na mirongo itatu, n’igikombe c’ifeza gipima shekeli mirongo indwi, vyompi vyapimwe hakoreshejwe ingero shekeli y’Ahera, kimwe cose cuzuye ifu inoze neza ivanze n’amavuta y’ishikanwa ry’ifu;<verse eid="NUM 7:55" /></para>
  <para style="li2">
    <verse number="56" style="v" sid="NUM 7:56" />isahani imwe y’inzahabu ipima shekeli icumi, yuzuye ibimota neza;<verse eid="NUM 7:56" /></para>
  <para style="li2">
    <verse number="57" style="v" sid="NUM 7:57" />ishuri imwe, impfizi y’intama ikuze imwe n’impfizi y’intama imaze umwaka, ngo bibe ikimazi co guturirwa;<verse eid="NUM 7:57" /></para>
  <para style="li2">
    <verse number="58" style="v" sid="NUM 7:58" />isuguru y’impene imwe y’ikimazi c’ivyaha;<verse eid="NUM 7:58" /></para>
  <para style="li2">
    <verse number="59" style="v" sid="NUM 7:59" />n’impfizi zibiri z’inka, impfizi zitanu z’intama, amasuguru atanu y’impene n’impfizi z’intama zitanu zimaze umwaka, vyo gutangwa kw’ikimazi c’ishimwe.</para>
  <para style="lf" vid="NUM 7:59">Iryo ni ryo ryari ishikanwa rya Gamaliyeli mwene Pedasuri.<verse eid="NUM 7:59" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="60" style="v" sid="NUM 7:60" />Ku musi ugira icenda Abidani mwene Gidiyoni, umukuru w’umuryango w’Ababenyamini, azana ishikanwa ryiwe.<verse eid="NUM 7:60" /></para>
  <para style="li1">
    <verse number="61" style="v" sid="NUM 7:61" />Ishikanwa ryiwe ryari iri: isiniya y’ifeza ipima shekeli ijana na mirongo itatu, n’igikombe c’ifeza gipima shekeli mirongo indwi, vyompi vyapimwe hakoreshejwe ingero shekeli y’Ahera, kimwe cose cuzuye ifu inoze neza ivanze n’amavuta y’ishikanwa ry’ifu;<verse eid="NUM 7:61" /></para>
  <para style="li2">
    <verse number="62" style="v" sid="NUM 7:62" />isahani imwe y’inzahabu ipima shekeli icumi, yuzuye ibimota neza;<verse eid="NUM 7:62" /></para>
  <para style="li2">
    <verse number="63" style="v" sid="NUM 7:63" />ishuri imwe, impfizi y’intama imwe n’umwagazi w’intama umaze umwaka, ngo bibe ikimazi co guturirwa;<verse eid="NUM 7:63" /></para>
  <para style="li2">
    <verse number="64" style="v" sid="NUM 7:64" />isuguru y’impene imwe y’ikimazi c’ivyaha;<verse eid="NUM 7:64" /></para>
  <para style="li2">
    <verse number="65" style="v" sid="NUM 7:65" />n’impfizi zibiri z’inka, impfizi zitanu z’intama, amasuguru atanu y’impene n’imyagazi itanu y’intama amaze umwaka, vyo gutangwa kw’ikimazi c’ishimwe.</para>
  <para style="lf" vid="NUM 7:65">Iryo ni ryo ryari ishikanwa rya Abidani mwene Gidiyoni.<verse eid="NUM 7:65" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="66" style="v" sid="NUM 7:66" />Ku musi ugira icumi Ahiyezeri mwene Amishadayi, umukuru w’umuryango w’Abadani, azana ishikanwa ryiwe.<verse eid="NUM 7:66" /></para>
  <para style="li1">
    <verse number="67" style="v" sid="NUM 7:67" />Ishikanwa ryiwe ryari iri: isiniya y’ifeza ipima shekeli ijana na mirongo itatu, n’igikombe c’ifeza gipima shekeli mirongo indwi, vyompi vyapimwe hakoreshejwe ingero shekeli y’Ahera, kimwe cose cuzuye ifu inoze neza ivanze n’amavuta y’ishikanwa ry’ifu;<verse eid="NUM 7:67" /></para>
  <para style="li2">
    <verse number="68" style="v" sid="NUM 7:68" />isahani imwe y’inzahabu ipima shekeli icumi, yuzuye ibimota neza;<verse eid="NUM 7:68" /></para>
  <para style="li2">
    <verse number="69" style="v" sid="NUM 7:69" />ishuri imwe, impfizi y’intama imwe n’umwagazi w’intama umaze umwaka, ngo bibe ikimazi co guturirwa;<verse eid="NUM 7:69" /></para>
  <para style="li2">
    <verse number="70" style="v" sid="NUM 7:70" />isuguru y’impene imwe y’ikimazi c’ivyaha;<verse eid="NUM 7:70" /></para>
  <para style="li2">
    <verse number="71" style="v" sid="NUM 7:71" />n’impfizi zibiri z’inka, impfizi zitanu z’intama, amasuguru atanu y’impene n’imyagazi itanu y’intama imaze umwaka, vyo gutangwa kw’ikimazi c’ishimwe.</para>
  <para style="lf" vid="NUM 7:71">Iryo ni ryo ryari ishikanwa rya Ahiyezeri mwene Amishadayi.<verse eid="NUM 7:71" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="72" style="v" sid="NUM 7:72" />Ku musi ugira icumi na rimwe Pagiyeli mwene Okurani, umukuru w’umuryango w’Abasheri, azana ishikanwa ryiwe.<verse eid="NUM 7:72" /></para>
  <para style="li1">
    <verse number="73" style="v" sid="NUM 7:73" />Ishikanwa ryiwe ryari iri: isiniya y’ifeza ipima shekeli ijana na mirongo itatu, n’igikombe c’ifeza gipima shekeli mirongo indwi, vyompi vyapimwe hakoreshejwe ingero shekeli y’Ahera, kimwe cose cuzuye ifu inoze neza ivanze n’amavuta y’ishikanwa ry’ifu;<verse eid="NUM 7:73" /></para>
  <para style="li2">
    <verse number="74" style="v" sid="NUM 7:74" />isahani imwe y’inzahabu ipima shekeli icumi, yuzuye ibimota neza;<verse eid="NUM 7:74" /></para>
  <para style="li2">
    <verse number="75" style="v" sid="NUM 7:75" />ishuri imwe, impfizi y’intama imwe n’umwagazi w’intama umaze umwaka, ngo bibe ikimazi co guturirwa;<verse eid="NUM 7:75" /></para>
  <para style="li2">
    <verse number="76" style="v" sid="NUM 7:76" />isuguru y’impene imwe y’ikimazi c’ivyaha;<verse eid="NUM 7:76" /></para>
  <para style="li2">
    <verse number="77" style="v" sid="NUM 7:77" />n’impfizi zibiri z’inka, impfizi zitanu z’intama, amasuguru atanu y’impene n’imyagazi itanu y’intama imaze umwaka, vyo gutangwa kw’ikimazi c’ishimwe.</para>
  <para style="lf" vid="NUM 7:77">Iryo ni ryo ryari ishikanwa rya Pagiyeli mwene Okurani.<verse eid="NUM 7:77" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="78" style="v" sid="NUM 7:78" />Ku musi ugira icumi na kabiri Ahira mwene Enani, umukuru w’umuryango w’Abanafutali, azana ishikanwa ryiwe.<verse eid="NUM 7:78" /></para>
  <para style="li1">
    <verse number="79" style="v" sid="NUM 7:79" />Ishikanwa ryiwe ryari iri: isiniya y’ifeza ipima shekeli ijana na mirongo itatu, n’igikombe c’ifeza gipima shekeli mirongo indwi, vyompi vyapimwe hakoreshejwe ingero shekeli y’Ahera, kimwe cose cuzuye ifu inoze neza ivanze n’amavuta y’ishikanwa ry’ifu;<verse eid="NUM 7:79" /></para>
  <para style="li2">
    <verse number="80" style="v" sid="NUM 7:80" />isahani imwe y’inzahabu ipima shekeli icumi, yuzuye ibimota neza;<verse eid="NUM 7:80" /></para>
  <para style="li2">
    <verse number="81" style="v" sid="NUM 7:81" />ishuri imwe, impfizi y’intama imwe n’umwagazi w’intama umaze umwaka, ngo bibe ikimazi co guturirwa;<verse eid="NUM 7:81" /></para>
  <para style="li2">
    <verse number="82" style="v" sid="NUM 7:82" />isuguru y’impene imwe y’ikimazi c’ivyaha;<verse eid="NUM 7:82" /></para>
  <para style="li2">
    <verse number="83" style="v" sid="NUM 7:83" />n’impfizi zibiri z’inka, impfizi zitanu z’intama, amasuguru atanu y’impene n’imyagazi itanu y’intama imaze umwaka, vyo gutangwa kw’ikimazi c’ishimwe.</para>
  <para style="lf" vid="NUM 7:83">Iryo ni ryo ryari ishikanwa rya Ahira mwene Enani.<verse eid="NUM 7:83" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="84" style="v" sid="NUM 7:84" />Ayo ni yo mashikanwa yatanzwe n’abakuru b’amazu y’Abisirayeli yo gushikanira Imana igicaniro igihe bakirobanuza amavuta:</para>
  <para style="li2" vid="NUM 7:84">Amasiniya icumi n’abiri akozwe mw’ifeza, ibikombe icumi na bibiri n’amasahani icumi n’abiri akozwe mu nzahabu. <verse eid="NUM 7:84" /><verse number="85" style="v" sid="NUM 7:85" />Isiniya imwimwe yapima shekeli ijana na mirongo itatu, n’igikombe kimwekimwe capima shekeli mirongo indwi. Vyose hamwe, ya masiniya n’ibikombe vy’ifeza vyapima shekeli ibihumbi bibiri n’amajana ane,<note caller="+" style="f"><char style="fr" closed="false">7:85 </char><char style="ft" closed="false">Ni nk’ibilo 28.</char></note> hakoreshejwe ingero shekeli y’Ahera. <verse eid="NUM 7:85" /><verse number="86" style="v" sid="NUM 7:86" />Za sahani z’inzahabu zuzuye ibimota neza imwimwe yapima shekeli icumi, ipimwe hakoreshejwe ingero shekeli y’Ahera. Ayo masahani y’inzahabu yose hamwe yapima shekeli ijana na mirongo ibiri.<note caller="+" style="f"><char style="fr" closed="false">7:86 </char><char style="ft" closed="false">Ni nk’ikilo 1,4.</char></note><verse eid="NUM 7:86" /></para>
  <para style="li2">
    <verse number="87" style="v" sid="NUM 7:87" />Ibitungwa vyose vyari vyagenewe ibimazi vyo guturirwa vyabaye amashuri y’inka icumi n’abiri, impfizi z’intama icumi na zibiri n’imyagazi y’intama imaze umwaka icumi n’ibiri, hamwe n’ishikanwa ry’ifu ryavyo. Amasuguru y’impene icumi n’abiri ni yo yakoreshejwe nk’ikimazi c’ivyaha.<verse eid="NUM 7:87" /></para>
  <para style="li2">
    <verse number="88" style="v" sid="NUM 7:88" />Igitigiri cose c’ibitungwa vyatangiwe gutangwa kw’ikimazi c’ishimwe vyari amashuri y’inka mirongo ibiri n’ane, impfizi z’intama mirongo itandatu, amasuguru y’impene mirongo itandatu n’imyagazi y’intama imaze umwaka mirongo itandatu.</para>
  <para style="b" vid="NUM 7:88" />
  <para style="lf" vid="NUM 7:88">Ayo ni yo mashikanwa yose yatanzwe yo gushikiriza Imana igicaniro kimaze kurobanuzwa amavuta.<verse eid="NUM 7:88" /></para>
  <para style="b" />
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89" />Mose amaze kwinjira mw’Ihema ry’Ibonaniro kugira ngo avugane n’<char style="nd">Uhoraho</char>, yumva ijwi rivugana na we rivuye hagati ya ba bakerubi babiri bari ku mupfundikizo w’impongano w’Isandugu y’Isezerano. Na we araheza avugana na we.<verse eid="NUM 7:89" /></para>
  <chapter eid="NUM 7" />
  <chapter number="8" style="c" sid="NUM 8" />
  <para style="s1">Gutunganya amatara</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 8:1" /><verse number="2" style="v" sid="NUM 8:2" />“Bwira Aroni, uti: ‘Igihe muzoshiraho ya matara indwi, muze muyashire ahantu ashobora kumurika ku ruhande rw’imbere rw’igiterekwako amatara.’ ”<verse eid="NUM 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 8:3" />Aroni aca akora uko; ashira amatara aho ashobora kubonesha imbere y’igiterekwako amatara, nk’uko <char style="nd">Uhoraho</char> yabitegetse Mose. <verse eid="NUM 8:3" /><verse number="4" style="v" sid="NUM 8:4" />Uku ni ko ico giterekwako amatara cakozwe: cari gikozwe mu nzahabu yahondeshejwe inyundo; kuva musi gushika hejuru. Ico giterekwako amatara cari gikozwe nka ca kigereranyo <char style="nd">Uhoraho</char> yari yeretse Mose.<verse eid="NUM 8:4" /></para>
  <para style="s1">Ukurobanurwa kw’Abalewi</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 8:5" /><verse number="6" style="v" sid="NUM 8:6" />“Toranya Abalewi ubakure mu bandi Bisirayeli ubahumanure. <verse eid="NUM 8:6" /><verse number="7" style="v" sid="NUM 8:7" />Mu kubahumanura, uze ukore gutya: uze ubamijagire ya mazi yo guhumanura; hanyuma bamobwe umushatsi aho uri hose ku mibiri yabo kandi bamesure impuzu zabo; uko ni ko bazoba bahumanuwe. <verse eid="NUM 8:7" /><verse number="8" style="v" sid="NUM 8:8" />Baze bazane ishuri ikiri nto n’ishikanwa ryayo ry’ifu rigizwe n’ifu inoze neza ivanzwe n’amavuta; uzane n’iyindi shuri ya kabiri y’ikimazi c’ivyaha. <verse eid="NUM 8:8" /><verse number="9" style="v" sid="NUM 8:9" />Uze uzane Abalewi imbere y’Ihema ry’Ibonaniro ukoranye n’Abisirayeli bose. <verse eid="NUM 8:9" /><verse number="10" style="v" sid="NUM 8:10" />Uze uzane Abalewi imbere y’<char style="nd">Uhoraho</char>, hanyuma Abisirayeli baze babarambikeko ibiganza. <verse eid="NUM 8:10" /><verse number="11" style="v" sid="NUM 8:11" />Aroni aze azane ba Balewi imbere y’<char style="nd">Uhoraho</char> nk’ishikanwa ryo kuzungagiza rivuye mu Bisirayeli, kugira ngo bitegurire igikorwa c’<char style="nd">Uhoraho</char>.<verse eid="NUM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 8:12" />Hanyuma Abalewi barambike ibiganza ku mitwe ya ya mashuri, imwe uheze uyitange nk’ikimazi c’ivyaha gishikaniwe <char style="nd">Uhoraho</char>, iyindi na yo uyitange nk’ikimazi co guturirwa, kugira ngo Abalewi batangirwe ikimazi co kwikurako icaha. <verse eid="NUM 8:12" /><verse number="13" style="v" sid="NUM 8:13" />Uze uzane Abalewi bahagarare imbere ya Aroni n’abahungu biwe hanyuma uce ubatanga nk’ishikanwa ryo kuzungagiza rishikaniwe <char style="nd">Uhoraho</char>. <verse eid="NUM 8:13" /><verse number="14" style="v" sid="NUM 8:14" />Uko ni ko uzorobanura Abalewi ubakuye mu bandi Bisirayeli, hanyuma Abalewi bazoba abanje.<verse eid="NUM 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 8:15" />Niwaheza guhumanura Abalewi no kubashikana nk’ishikanwa ryo kuzungagiza, bazoce baza gukora igikorwa cabo kw’ihema ry’ibonaniro. <verse eid="NUM 8:15" /><verse number="16" style="v" sid="NUM 8:16" />Ni Abisirayeli banyeguriwe. Nabagize abanje mu gishingo c’imfura, abana b’imfura b’abahungu b’Umwisirayelikazi wese. <verse eid="NUM 8:16" /><verse number="17" style="v" sid="NUM 8:17" />Imfura zose mu Bisirayeli, baba abantu canke ibitungwa, ni ivyanje. Igihe nahonya imfura zose muri Egiputa, naciye nirobanurira abo kuba abanje. <verse eid="NUM 8:17" /><verse number="18" style="v" sid="NUM 8:18" />Natoranije Abalewi mu gishingo c’abahungu bose b’imfura muri Isirayeli. <verse eid="NUM 8:18" /><verse number="19" style="v" sid="NUM 8:19" />Kandi mpaye Aroni n’abahungu biwe Abalewi mbakuye mu Bisirayeli bose ngo bakore igikorwa co mw’ihema ry’ibonaniro bagikorera Abisirayeli ngo babatangire impongano kugira ngo ntihagire ikiza gitera Abisirayeli igihe bazokwegera ahera.”<verse eid="NUM 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20" />Mose, Aroni n’Abisirayeli bose baca bakora ivyo <char style="nd">Uhoraho</char> yategetse Mose vyose ku Balewi. <verse eid="NUM 8:20" /><verse number="21" style="v" sid="NUM 8:21" />Nuko Abalewi bariyeza bamesura n’impuzu zabo. Maze Aroni aca abazana nk’ishikanwa rizungagizwa imbere y’<char style="nd">Uhoraho</char> aca abatangira impongano kugira ngo abeze. <verse eid="NUM 8:21" /><verse number="22" style="v" sid="NUM 8:22" />Inyuma y’ivyo, Abalewi baza gukora igikorwa cabo kw’ihema ry’ibonaniro barongowe na Aroni n’abahungu biwe. Uko <char style="nd">Uhoraho</char> yari yategetse Mose, ni ko bakoze ku Balewi.<verse eid="NUM 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 8:23" /><verse number="24" style="v" sid="NUM 8:24" />“Ibi ni vyo bizokorwa ku Balewi: abagabo bamaze imyaka mirongo ibiri n’itanu n’iyirenga baze baze gukora kw’ihema ry’ibonaniro, <verse eid="NUM 8:24" /><verse number="25" style="v" sid="NUM 8:25" />ariko bamaze imyaka mirongo itanu, baze bakukuruke bave mu gikorwa cabo bahora bakora ntibasubire kugikora. <verse eid="NUM 8:25" /><verse number="26" style="v" sid="NUM 8:26" />Bashobora gufasha abavukanyi babo mu gukora ibikorwa vyabo mw’ihema ry’ibonaniro, ariko bo ntibaze bakore ico gikorwa. Ng’uko rero uko uzotunganya ibikorwa vy’Abalewi.”<verse eid="NUM 8:26" /></para>
  <chapter eid="NUM 8" />
  <chapter number="9" style="c" sid="NUM 9" />
  <para style="s1">Pasika</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1" />
    <char style="nd">Uhoraho</char> avugana na Mose mu bugaragwa bw’i Sinayi mu kwezi kwa mbere kw’umwaka ugira kabiri bavuye muri Egiputa. Aramubwira ati: <verse eid="NUM 9:1" /><verse number="2" style="v" sid="NUM 9:2" />“Abisirayeli baze bahimbaze Pasika mu gihe cashinzwe. <verse eid="NUM 9:2" /><verse number="3" style="v" sid="NUM 9:3" />Muze muyihimbaze mu gihe cashinzwe, ku mugoroba w’umusi ugira icumi na kane w’uku kwezi, nk’uko amategeko n’ingingo biyigenga bimeze.”<verse eid="NUM 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 9:4" />Nuko Mose abarira Abisirayeli guhimbaza Pasika, <verse eid="NUM 9:4" /><verse number="5" style="v" sid="NUM 9:5" />na bo barabikora mu bugaragwa bw’i Sinayi ku mugoroba w’umusi ugira icumi na kane w’ukwezi kwa mbere. Abisirayeli bakora vyose nk’uko <char style="nd">Uhoraho</char> yari yabitegetse Mose.<verse eid="NUM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6" />Ariko hariho bamwe batashoboye guhimbaza Pasika kuri uwo musi kuko bari bahumanijwe n’uko bakoze ku mivyimba. Nuko baza aho Mose na Aroni bari kuri uwo musi nyene <verse eid="NUM 9:6" /><verse number="7" style="v" sid="NUM 9:7" />babarira Mose bati: “Twahumanijwe n’uko twakoze ku mivyimba. None ntitwemererwa gushikanira <char style="nd">Uhoraho</char> ikimazi hamwe n’abandi Bisirayeli kandi ari igihe cashinzwe?”<verse eid="NUM 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8" />Mose arabishura ati: “Rindira nsiguze <char style="nd">Uhoraho</char> kugira ngo menye ico avuga ku biberekeye.”<verse eid="NUM 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9" />Nuko <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 9:9" /><verse number="10" style="v" sid="NUM 9:10" />“Bwira Abisirayeli uti: ‘Igihe umuntu wese wo muri mwebwe canke wo mu ruvyaro rwanyu azoba ahumanijwe n’umuvyimba canke afashe urugendo, azoshobora guhimbaza Pasika y’<char style="nd">Uhoraho</char>. <verse eid="NUM 9:10" /><verse number="11" style="v" sid="NUM 9:11" />Baze bayihimbaze ku musi ugira icumi na kane w’ukwezi kwa kabiri ku mugoroba. Baze barye umwagazi, bawukoze imikate itarimwo umwambiro n’imboga zirura. <verse eid="NUM 9:11" /><verse number="12" style="v" sid="NUM 9:12" />Ntibaze bareke ivyasigaye ngo bishike mu gitondo bukeye canke ngo bavune igufa na rimwe. Igihe bazohimbaza Pasika, baze babikore nk’uko amategeko avuga. <verse eid="NUM 9:12" /><verse number="13" style="v" sid="NUM 9:13" />Ariko umuntu azoba adahumanye kandi atafashe urugendo atazohimbaza Pasika, uwo muntu aze akurwe mu bwoko bwabo kuko atatanze ikimazi k’<char style="nd">Uhoraho</char> mu gihe cashinzwe. Uwo muntu azozira icaha ciwe.<verse eid="NUM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14" />Umunyamahanga aba muri mwebwe ashaka guhimbaza Pasika y’<char style="nd">Uhoraho</char> aze abikore yisunze amateka n’amategeko ayigenga. Mwese muze mugengwe n’amategeko amwe yaba umunyamahanga canke imvukira.’ ”<verse eid="NUM 9:14" /></para>
  <para style="s1">Igicu gitwikira rya hema</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15" />Ku musi ihema ryashingwa, ari ryo Hema ry’Ibonaniro, igicu caciye kiritwikira. Kuva ku mugoroba gushika mu gitondo ico gicu cari kw’Ihema kandi casa n’umuriro. <verse eid="NUM 9:15" /><verse number="16" style="v" sid="NUM 9:16" />Uko ni ko vyagumye; ico gicu gipfutse iryo Hema mw’ijoro casa n’umuriro. <verse eid="NUM 9:16" /><verse number="17" style="v" sid="NUM 9:17" />Igihe cose ico gicu cava kw’Ihema, Abisirayeli baca bahaguruka bagafata urugendo; aho ico gicu cahagarara, ni ho baca bashinga amahema bagacumbika. <verse eid="NUM 9:17" /><verse number="18" style="v" sid="NUM 9:18" /><char style="nd">Uhoraho</char> ategetse ngo bimuke baca bimuka, yategeka ngo bacumbike, bagacumbika. Igihe cose ico gicu caguma hejuru ya rya hema, baguma aho bacumbitse. <verse eid="NUM 9:18" /><verse number="19" style="v" sid="NUM 9:19" />Iyo ico gicu kigumye kuri iryo Hema igihe kirekire, Abisirayeli barubaha ico <char style="nd">Uhoraho</char> ategetse ntibimuka aho bacumbitse. <verse eid="NUM 9:19" /><verse number="20" style="v" sid="NUM 9:20" />Rimwe na rimwe ico gicu camara imisi mikeya hejuru yaryo; <char style="nd">Uhoraho</char> ategetse ko bacumbika bagashinga amahema, yategeka ko bimuka bakayashingura. <verse eid="NUM 9:20" /><verse number="21" style="v" sid="NUM 9:21" />Hari aho ico gicu caguma hejuru yaryo kuva ku mugoroba gushika mu gitondo gusa, cahaguruka mu gitondo bagaca bahaguruka bakagenda. Haba ku murango canke mw’ijoro, iyo ico gicu kivuye hasi baca bahaguruka bakagenda. <verse eid="NUM 9:21" /><verse number="22" style="v" sid="NUM 9:22" />Nimba ico gicu kigumye hejuru y’ihema imisi ibiri canke ukwezi canke umwaka, Abisirayeli baguma aho bacumbitse, ntibimuka; ariko igihe kivuye hasi, baca bazinga amahema bakagenda. <verse eid="NUM 9:22" /><verse number="23" style="v" sid="NUM 9:23" /><char style="nd">Uhoraho</char> ategetse baca bacumbika, yategeka bakazinga amahema bakagenda. Bumvira itegeko ry’<char style="nd">Uhoraho</char>, nk’uko yari yabibategetse abicishije kuri Mose.<verse eid="NUM 9:23" /></para>
  <chapter eid="NUM 9" />
  <chapter number="10" style="c" sid="NUM 10" />
  <para style="s1">Inzamba zicuzwe mw’ifeza</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 10:1" /><verse number="2" style="v" sid="NUM 10:2" />“Cura inzamba zibiri mw’ifeza ihondaguye, uze uzikoreshe mu guhamagara ikoraniro no mu kumenyesha umwanya wo kuzinga amahema ngo babandanye urugendo. <verse eid="NUM 10:2" /><verse number="3" style="v" sid="NUM 10:3" />Igihe izo nzamba zivugirijwe rimwe, ikoraniro ryose rize rikoranire imbere yawe, imbere y’Ihema ry’Ibonaniro. <verse eid="NUM 10:3" /><verse number="4" style="v" sid="NUM 10:4" />Iyo havugijwe imwe gusa, abarongoye abandi, abakuru b’amazu y’Abisirayeli, baze bakoranire imbere yawe. <verse eid="NUM 10:4" /><verse number="5" style="v" sid="NUM 10:5" />Inzamba niyavuga n’ijwi rirengera rimwe, imiryango iherereye mu buseruko baze bahaguruke bagende. <verse eid="NUM 10:5" /><verse number="6" style="v" sid="NUM 10:6" />Inzamba niyavuga ubwa kabiri mw’ijwi rirengera, imiryango iri mu bumanuko baze bahaguruke bagende. <verse eid="NUM 10:6" /><verse number="7" style="v" sid="NUM 10:7" />Mu gukoranya ikoraniro, muze muvuze izo nzamba, ariko ntimukoreshe ijwi rimwe.<verse eid="NUM 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 10:8" />Abahungu ba Aroni, ari bo baherezi, baze bavuze izo nzamba; iri ni ryo tegeko ry’intahava uko urunganwe ruzogenda rukurikirana n’urundi. <verse eid="NUM 10:8" /><verse number="9" style="v" sid="NUM 10:9" />Nimwaja mu ntambara mu gihugu canyu bwite muriko muragwanya umwansi abasugereje, muze muvuze izo nzamba mw’ijwi rirengera. <char style="nd">Uhoraho</char> Imana yanyu azoca abibuka kandi muzotabarwa mukire abansi banyu. <verse eid="NUM 10:9" /><verse number="10" style="v" sid="NUM 10:10" />No mu bihe vyanyu vy’umunezero, haba mu misi mikuru yashinzwe canke imboneko z’ukwezi, muze muvuze izo nzamba mwongere mutange n’ibimazi vyo guturirwa n’ivy’impongano, na vyo bizoba icibutso canyu imbere y’<char style="nd">Uhoraho</char>. Ndi <char style="nd">Uhoraho</char> Imana yanyu.”<verse eid="NUM 10:10" /></para>
  <para style="s1">Abisirayeli bava kuri Sinayi</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11" />Ku musi wa mirongo ibiri w’ukwezi kwa kabiri kw’umwaka wa kabiri, ca gicu kiraduga kiva kw’Ihema ry’ibishingantahe. <verse eid="NUM 10:11" /><verse number="12" style="v" sid="NUM 10:12" />Nuko Abisirayeli bava hasi bava mu bugaragwa bw’i Sinayi bagenda barunguruza gushika aho ca gicu cahagarariye mu bugaragwa bw’i Parani. <verse eid="NUM 10:12" /><verse number="13" style="v" sid="NUM 10:13" />Ubwo ni bwo bwa mbere Abisirayeli bavuye aho bari bacumbitse nk’uko <char style="nd">Uhoraho</char> yari yabibategetse abicishije kuri Mose.<verse eid="NUM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 10:14" />Imigwi yo mu ba Yuda ni bo babanje guhaguruka, bari musi y’ibendera ryabo. Nahashoni mwene Aminadabu ni we yari abarongoye. <verse eid="NUM 10:14" /><verse number="15" style="v" sid="NUM 10:15" />Netaneli mwene Zuwari ni we yari arongoye umugwi wo mu muryango wa Isakari, <verse eid="NUM 10:15" /><verse number="16" style="v" sid="NUM 10:16" />Eliyabu mwene Heloni na we ni we yari arongoye umugwi wo mu muryango wa Zebuloni. <verse eid="NUM 10:16" /><verse number="17" style="v" sid="NUM 10:17" />Hanyuma rya hema rica rirazingwa, Abagerishoni n’Abamerari, ari bo bari bariteruye, baca baragenda.<verse eid="NUM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 10:18" />Imigwi yari musi y’ibendera rya Reyubeni barakurikira, bari musi y’ibendera ryabo. Elisuri mwene Shedewuri ni we yari abarongoye. <verse eid="NUM 10:18" /><verse number="19" style="v" sid="NUM 10:19" />Shelumiyeli mwene Zurishadayi yari arongoye umugwi w’umuryango wa Simeyoni, <verse eid="NUM 10:19" /><verse number="20" style="v" sid="NUM 10:20" />Eliyasafu na we, mwene Dewuyeli yari arongoye umugwi w’umuryango wa Gadi. <verse eid="NUM 10:20" /><verse number="21" style="v" sid="NUM 10:21" />Hanyuma Abakohati bava hasi, bateruye vya bikoresho vyera. Ihema ryategerezwa gushingwa aho ryategerezwa kuba imbere y’uko bashika.<verse eid="NUM 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 10:22" />Imigwi yari musi y’ibendera rya Efurayimu barakurikira, bari musi y’ibendera ryabo. Elishama mwene Amihudi ni we yari abarongoye. <verse eid="NUM 10:22" /><verse number="23" style="v" sid="NUM 10:23" />Gamaliyeli mwene Pedasuri ni we yari arongoye umugwi w’umuryango wa Manase, <verse eid="NUM 10:23" /><verse number="24" style="v" sid="NUM 10:24" />Abidani mwene Gidiyoni na we yari arongoye umugwi w’umuryango wa Benyamini.<verse eid="NUM 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 10:25" />Ubwa nyuma, imigwi irongowe n’ibendera rya Dani, nk’umugwi ujejwe umutekano w’inyuma, bava hasi barongowe n’ibendera ryabo. Ahiyezeri mwene Amishadayi ni we yari abarongoye. <verse eid="NUM 10:25" /><verse number="26" style="v" sid="NUM 10:26" />Pagiyeli mwene Okurani ni we yari arongoye umugwi w’umuryango wa Asheri, <verse eid="NUM 10:26" /><verse number="27" style="v" sid="NUM 10:27" />Ahira mwene Enani na we yari arongoye umugwi w’umuryango wa Nafutali. <verse eid="NUM 10:27" /><verse number="28" style="v" sid="NUM 10:28" />Uru ni rwo rwari urutonde rwo kugenda rw’imigwi y’Abisirayeli uko bakurikirana mu kuva hasi.<verse eid="NUM 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29" />Nuko Mose abarira muramuwe Hobabu, mwene Reyuweli Umumidiyani, ati: “Tugiye aho <char style="nd">Uhoraho</char> yavuze ati: ‘Nzohabaha.’ Nuze tujane natwe tuzogufata neza, kuko <char style="nd">Uhoraho</char> yasezeraniye Abisirayeli ivyiza.”<verse eid="NUM 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 10:30" />Na we arishura ati: “Oya ntitujana. Nsubiye mu gihugu navukiyemwo no mu bwoko bwacu.”<verse eid="NUM 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 10:31" />Ariko Mose aravuga ati: “Ndakwinginze ntuduhebe. Kuko wewe uzi ubu bugaragwa, aho dushobora gushinga amahema, ushobora kutubera amaso. <verse eid="NUM 10:31" /><verse number="32" style="v" sid="NUM 10:32" />Niwajana natwe, tuzosangira ivyiza vyose <char style="nd">Uhoraho</char> azoduha.”<verse eid="NUM 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33" />Nuko bava ku musozi w’<char style="nd">Uhoraho</char> bagenda imisi itatu. Isandugu y’Isezerano y’<char style="nd">Uhoraho</char> yagendera imbere yabo muri iyo misi itatu kugira ngo abaronkere aho kuruhukira. <verse eid="NUM 10:33" /><verse number="34" style="v" sid="NUM 10:34" />Ca gicu c’<char style="nd">Uhoraho</char> cari hejuru yabo ku murango igihe bava aho bari bacumbitse.<verse eid="NUM 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 10:35" />Igihe cose iyo isandugu igiye, Mose yavuga ati:</para>
  <para style="q1" vid="NUM 10:35">“Haguruka, yewe <char style="nd">Uhoraho</char>!</para>
  <para style="q2" vid="NUM 10:35">Abansi bawe nibasanzare;</para>
  <para style="q2" vid="NUM 10:35">abakwanka nibahunge mu nyonga hawe.”<verse eid="NUM 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 10:36" />Igihe cose ihagaze, yavuga ati:</para>
  <para style="q1" vid="NUM 10:36">“Garuka, Yewe <char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="NUM 10:36">mu bihumbi n’ibihumbi vy’Abisirayeli.”<verse eid="NUM 10:36" /></para>
  <chapter eid="NUM 10" />
  <chapter number="11" style="c" sid="NUM 11" />
  <para style="s1">Umuriro uvuye k’<char style="nd">Uhoraho</char></para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1" />Muri iyo misi, Abisirayeli bidodombera <char style="nd">Uhoraho</char> kubera ingorane barimwo. <char style="nd">Uhoraho</char> avyumvise araraka. Maze umuriro uvuye k’<char style="nd">Uhoraho</char> urarurumba uturira abari ku mpera y’aho bari bacumbitse. <verse eid="NUM 11:1" /><verse number="2" style="v" sid="NUM 11:2" />Abantu batakambiye Mose, aca arasenga <char style="nd">Uhoraho</char> uwo muriro urazima. <verse eid="NUM 11:2" /><verse number="3" style="v" sid="NUM 11:3" />Aho hantu haca hitwa Tabera bisigura “Guturira”, kuko umuriro uvuye k’<char style="nd">Uhoraho</char> watse hagati muri bo.<verse eid="NUM 11:3" /></para>
  <para style="s1">Inkware zivuye k’<char style="nd">Uhoraho</char></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4" />Hanyuma, ikivange c’abanyamahanga bakurikiye Abisirayeli batangura kwipfuza inyama. N’Abisirayeli na bo nyene batangura kwidodomba bavuga bati: “Icoduha inyama zo kurya! <verse eid="NUM 11:4" /><verse number="5" style="v" sid="NUM 11:5" />Twibutse amafi ya gusa twarya muri Egiputa n’amakonkomburi, imyungu, amapwaro, ibitunguru na tungurusumu. <verse eid="NUM 11:5" /><verse number="6" style="v" sid="NUM 11:6" />Ariko ubu n’akayabagu kaheze; nta kindi turonka atari iyi manu gusa!”<verse eid="NUM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7" />Manu yari imeze nk’utubuto tw’igiti citwa koriyanderi, igasa n’ubukame bw’igiti. <verse eid="NUM 11:7" /><verse number="8" style="v" sid="NUM 11:8" />Abantu barasohoka bakayegeranya, hanyuma bakayisya ku rusyo canke bakayisekura mw’isekuro. Bayiteka mu nkono canke bakayicumbamwo udukate. Mu kanwa yari imeze nk’ivyakaranzwe n’amavuta ya elayo. <verse eid="NUM 11:8" /><verse number="9" style="v" sid="NUM 11:9" />Urume rutonze aho bacumbitse mw’ijoro, manu na yo nyene yazanana na rwo.<verse eid="NUM 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10" />Mose yumva abantu bo mu miryango yose bariko baridodomba, umwe wese imbere y’ihema ryiwe. <char style="nd">Uhoraho</char> arashavura cane, na Mose arababara. <verse eid="NUM 11:10" /><verse number="11" style="v" sid="NUM 11:11" />Abaza <char style="nd">Uhoraho</char> ati: “Mbega ni kuki wanteje uwu mubabaro jewe umusavyi wawe? Mbega nakoze iki cakubabaje catumye undemeka umuzigo ungana utya w’aba bantu? <verse eid="NUM 11:11" /><verse number="12" style="v" sid="NUM 11:12" />Mbega ni jewe nabatwaye inda? Canke ni jewe nabavyaye? None ni igiki gituma ubantererana ngo ndabaterure mu maboko yanje, nk’uko umurezi aterura uruyoya, ngo ndabajane mu gihugu warahiye ba sekuruza ko uzokibaha? <verse eid="NUM 11:12" /><verse number="13" style="v" sid="NUM 11:13" />Mbega nokura hehe inyama zikwiye aba bantu? Ko baguma banyidodombera bati: ‘Duhe inyama turye!’ <verse eid="NUM 11:13" /><verse number="14" style="v" sid="NUM 11:14" />Jewe sinshobora kwiremeka aba bantu bose jenyene; uyu mutwaro uraremereye cane. <verse eid="NUM 11:14" /><verse number="15" style="v" sid="NUM 11:15" />Nimba uku ari ko bizohora, nunyicire ngaha ubu nyene, ungirire ubuntu mu nyonga zawe, kugira ngo undinde aya magorwa.”<verse eid="NUM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16" />
    <char style="nd">Uhoraho</char> abarira Mose ati: “Ntorera abakuru mirongo indwi mu Bisirayeli basanzwe bubahwa. Ubazane kw’Ihema ry’Ibonaniro, kugira ngo bahagararane nawe. <verse eid="NUM 11:16" /><verse number="17" style="v" sid="NUM 11:17" />Nanje ndaza mvuganire nawe aho hantu, mpeze mfate ku Mpwemu iri kuri wewe nce ndayishira kuri bo. Bazogufasha kwikorera uwo mutwaro w’ubu bwoko kugira ngo ntubatware wenyene.<verse eid="NUM 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 11:18" />Ubwire abantu uti: ‘Mwitegure mwiyeze kubera umusi w’ejo, aho muzorya inyama. <char style="nd">Uhoraho</char> yabumvise igihe mwidodomba ngo: “Icoduha inyama zo kurya! Twari tumerewe neza muri Egiputa!” Nuko <char style="nd">Uhoraho</char> azobaha inyama, namwe muzozirya. <verse eid="NUM 11:18" /><verse number="19" style="v" sid="NUM 11:19" />Ntimuzozirya gusa umusi umwe, canke imisi ibiri, canke itanu, canke icumi canke mirongo ibiri, <verse eid="NUM 11:19" /><verse number="20" style="v" sid="NUM 11:20" />ariko ni ukwezi kwose, gushika aho zibaduhira zikabaca mu mazuru, kuko mwateye ibitugu <char style="nd">Uhoraho</char>, ari muri mwebwe, mukidodombera imbere yiwe, muvuga muti: “Mbega ni kuki twavuye muri Egiputa?” ’ ”<verse eid="NUM 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21" />Ariko Mose aravuga ati: “Aba bantu bankikuje ntibari musi y’ibihumbi amajana atandatu bigize ikoraniro, none uvuze ngo: ‘Nzobaha inyama zo kurya ukwezi kwose!’ <verse eid="NUM 11:21" /><verse number="22" style="v" sid="NUM 11:22" />Mbega uwobabagira amasho n’imikuku vyo vyokwira? Mbega ifi zose zo mu kiyaga zorobwa zobakwira?”<verse eid="NUM 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 11:23" />
    <char style="nd">Uhoraho</char> yishura Mose ati: “Mbega ukuboko kw’<char style="nd">Uhoraho</char> ni kugufi? Uzokwibonera ubwawe ko ivyo ndakubwiye bidashika kuri mwebwe.”<verse eid="NUM 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24" />Nuko Mose arasohoka abarira abantu ivyo <char style="nd">Uhoraho</char> yavuze. Atoranya ba bakuru mirongo indwi bahagarara bazungurutse Ihema ry’Ibonaniro. <verse eid="NUM 11:24" /><verse number="25" style="v" sid="NUM 11:25" />Nuko <char style="nd">Uhoraho</char> aramanuka ari muri ca gicu avugana na we, aca yakira ku Mpwemu yari kuri we ayishira kuri ba bakuru mirongo indwi. Igihe Mpwemu yabazako, baravugishijwe, ariko ntibasubira kuvugishwa hanyuma.<verse eid="NUM 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 11:26" />Ariko hari abagabo babiri, amazina yabo yari Eludadi na Medadi, bari basigaye aho bacumbitse. Bari kuri rwa rutonde rw’abakuru mirongo indwi, ariko ntibasohoka ngo baje kw’ihema. Ariko na bo nyene Mpwemu abazako, kandi bavugishirizwa aho bacumbitse. <verse eid="NUM 11:26" /><verse number="27" style="v" sid="NUM 11:27" />Umusore umwe araza yiruka abarira Mose ati: “Eludadi na Medadi bariko baravugishirizwa aho ducumbitse.”<verse eid="NUM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 11:28" />Yosuwa mwene Nuni, yari umwunganizi wa Mose kuva mu buto bwiwe, ashira ijwi hejuru aravuga ati: “Nyakwubahwa Mose, babuze!”<verse eid="NUM 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 11:29" />Ariko Mose arishura ati: “Ugize ishari ku bwanje? Icompa abantu b’<char style="nd">Uhoraho</char> bose bakaba abavugishwa, <char style="nd">Uhoraho</char> akabashirako Mpwemu wiwe!” <verse eid="NUM 11:29" /><verse number="30" style="v" sid="NUM 11:30" />Nuko Mose na ba bakuru b’Abisirayeli basubira aho bacumbitse.<verse eid="NUM 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31" />Maze umuyaga uvuye k’<char style="nd">Uhoraho</char> uraza uzana inkware uzikuye ku kiyaga, urazizana uzigwisha hagati y’aho bacumbitse, zagurukira nko ku ngero z’igice c’ukuboko zibiri<note caller="+" style="f"><char style="fr" closed="false">11:31 </char><char style="ft" closed="false">Ni nk’isantimetero 90.</char></note> uvuye hasi zikwira ahantu hangana n’urugendo rw’umusi umwe. <verse eid="NUM 11:31" /><verse number="32" style="v" sid="NUM 11:32" />Kuri uwo musi, ku murango no mw’ijoro, no ku musi wakurikiye, abantu barasohoka begeranya inkware. Nta n’umwe yegeranije iziri musi y’ingero homeru icumi,<note caller="+" style="f"><char style="fr" closed="false">11:32 </char><char style="ft" closed="false">Ni nk’itoni 1,8.</char></note> baraheza bazisanza ku mpande zose z’aho bacumbitse kugira ngo zume. <verse eid="NUM 11:32" /><verse number="33" style="v" sid="NUM 11:33" />Ariko igihe inyama zari zikiri mu menyo yabo batarazimira, ishavu ry’<char style="nd">Uhoraho</char> riraziriringa, ashavurira abantu, abateza icago gikomeye. <verse eid="NUM 11:33" /><verse number="34" style="v" sid="NUM 11:34" />Nuko aho hantu baca bahita Kiburoti Hatava bisigura “imva z’abipfuje inyama” kuko ari ho bahamvye abari bipfuje inyama.<verse eid="NUM 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 11:35" />Nuko abantu bava i Kiburoti Hatava bagenda gucumbika i Hazeroti bagumaho.<verse eid="NUM 11:35" /></para>
  <chapter eid="NUM 11" />
  <chapter number="12" style="c" sid="NUM 12" />
  <para style="s1">Miriyamu na Aroni bagirira ishari Mose</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1" />Miriyamu na Aroni batangura kuvuga nabi Mose kubera umugore wiwe w’Umunyakushi, kuko yari yarongoye Umunyakushikazi. Barabaza bati: <verse eid="NUM 12:1" /><verse number="2" style="v" sid="NUM 12:2" />“Mbega <char style="nd">Uhoraho</char> yavugiye muri Mose gusa? Mbega ntiyavugiye no muri twebwe?” Maze <char style="nd">Uhoraho</char> aravyumva.<verse eid="NUM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 12:3" />Uwo mugabo Mose yari umuntu aciye bugufi kurusha abandi bantu bose bo kw’isi.<verse eid="NUM 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 12:4" />Ubwo nyene <char style="nd">Uhoraho</char> abarira Mose, Aroni na Miriyamu ati: “Nimuze kw’Ihema ry’Ibonaniro, uko muri batatu.” Nuko uko ari batatu barasohoka. <verse eid="NUM 12:4" /><verse number="5" style="v" sid="NUM 12:5" />Maze <char style="nd">Uhoraho</char> aramanuka ari mu nkingi y’igicu, ahagarara ku muryango w’Ihema, ahamagara Aroni na Miriyamu ngo abo babiri bigire imbere, <verse eid="NUM 12:5" /><verse number="6" style="v" sid="NUM 12:6" />arababarira ati: “Nimwumve amajambo yanje:</para>
  <para style="q1" vid="NUM 12:6">Iyo hari uwuvugishwa n’<char style="nd">Uhoraho</char> muri mwebwe,</para>
  <para style="q2" vid="NUM 12:6">ndamwihishurira mu vyo yerekwa,</para>
  <para style="q2" vid="NUM 12:6">nkavugana na we mu ndoto.<verse eid="NUM 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 12:7" />Ariko si ko bimeze ku musavyi wanje Mose;</para>
  <para style="q2" vid="NUM 12:7">ni umwizigirwa mu nzu yanje yose.<verse eid="NUM 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 12:8" />Mvugana na we imbonankubone,</para>
  <para style="q2" vid="NUM 12:8">mu buryo bufoboye ntapfinze;</para>
  <para style="q2" vid="NUM 12:8">arabona ishusho yanje jewe <char style="nd">Uhoraho</char>.</para>
  <para style="q1" vid="NUM 12:8">None ni iki catumye mudatinya</para>
  <para style="q2" vid="NUM 12:8">kuvuga nabi umusavyi wanje Mose?”<verse eid="NUM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9" />
    <char style="nd">Uhoraho</char> arabashavurira, aca aragenda abasigaho.<verse eid="NUM 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 12:10" />Ca gicu kimaze kuduga hejuru y’ihema, Miriyamu agihagaze ngaho yuzura imibembe, yera derere. Aroni ahindukiye ngo amurabe abona yuzuye imibembe; <verse eid="NUM 12:10" /><verse number="11" style="v" sid="NUM 12:11" />na we aca abarira Mose ati: “Ndakwinginze nyakwubahwa, ntushishikare kuduharurako icaha cacu twakoze mu bujuju bwacu. <verse eid="NUM 12:11" /><verse number="12" style="v" sid="NUM 12:12" />Ntumureke ngo amere nk’icavutse gipfuye kikiva mu nda ya nyina catanguye kubora.”<verse eid="NUM 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 12:13" />Nuko Mose atakambira <char style="nd">Uhoraho</char> ati: “Yewe Mana ndakwinginze umukize!”<verse eid="NUM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 12:14" />Nuko <char style="nd">Uhoraho</char> yishura Mose ati: “Mbega iyo aba ari se yamuvumye amate mu maso, ntiyari kumara iyinga ryose amaramara? Nimumukure hagati y’aho mucumbitse hahere imisi indwi, hanyuma azobone kugaruka.” <verse eid="NUM 12:14" /><verse number="15" style="v" sid="NUM 12:15" />Nuko rero Miriyamu ashirwa inyuma y’aho bacumbitse amarayo imisi indwi, abantu ntibava ngaho kugeza igihe yagarukanwa muri bo.<verse eid="NUM 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 12:16" />Inyuma y’ivyo Abisirayeli bava i Hazeroti bacumbika mu bugaragwa bw’i Parani.<verse eid="NUM 12:16" /></para>
  <chapter eid="NUM 12" />
  <chapter number="13" style="c" sid="NUM 13" />
  <para style="s1">Batuma abatasi gutata i Kanani</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 13:1" /><verse number="2" style="v" sid="NUM 13:2" />“Rungika abagabo bamwe gutata igihugu c’i Kanani, ico ngiye guha Abisirayeli. Mu muryango wose batore umwe mu bakuru bawo.”<verse eid="NUM 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 13:3" />Maze nk’uko <char style="nd">Uhoraho</char> yari yategetse Mose arabarungika bavuye mu bugaragwa bw’i Parani. Bose bari abakuru mu Bisirayeli.<verse eid="NUM 13:3" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="4" style="v" sid="NUM 13:4" />Ayo ni yo mazina yabo:</para>
  <para style="b" vid="NUM 13:4" />
  <para style="li1" vid="NUM 13:4">Uwavuye mu muryango wa Reyubeni, ni Shamuwa mwene Zakuri;<verse eid="NUM 13:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 13:5" />uwavuye mu muryango wa Simeyoni, ni Shafati mwene Hori;<verse eid="NUM 13:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 13:6" />Uwavuye mu muryango wa Yuda, ni Kalebu mwene Yefune,<verse eid="NUM 13:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 13:7" />uwavuye mu muryango wa Isakari, ni Igali mwene Yosefu;<verse eid="NUM 13:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 13:8" />uwavuye mu muryango wa Efurayimu, ni Hoseya mwene Nuni<verse eid="NUM 13:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 13:9" />uwavuye mu muryango wa Benyamini, ni Paluti mwene Rafu;<verse eid="NUM 13:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 13:10" />uwavuye mu muryango wa Zebuloni, ni Gadiyeli mwene Sodi;<verse eid="NUM 13:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 13:11" />uwavuye mu muryango wa Manase (umuryango wa Yosefu), ni Gadi mwene Susi;<verse eid="NUM 13:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 13:12" />uwavuye mu muryango wa Dani, ni Amiyeli mwene Gemali;<verse eid="NUM 13:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 13:13" />uwavuye mu muryango wa Asheri, ni Seturi mwene Mikayeli;<verse eid="NUM 13:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 13:14" />uwavuye mu muryango wa Nafutali, ni Nahubi mwene Vofusi;<verse eid="NUM 13:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 13:15" />uwavuye mu muryango wa Gadi, ni Geyuweli mwene Maki.<verse eid="NUM 13:15" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="16" style="v" sid="NUM 13:16" />Abo ni bo bagabo Mose yarungitse gutata igihugu. (Uwari asanzwe yitwa Hoseya mwene Nuni, Mose amwita Yosuwa.)<verse eid="NUM 13:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17" />Igihe Mose yabatuma gutata igihugu c’i Kanani, yavuze ati: “Muce i Negebu, hanyuma muce muduga mu misozi. <verse eid="NUM 13:17" /><verse number="18" style="v" sid="NUM 13:18" />Murabe uko ico gihugu kimeze kandi ko abantu baho ari abanyenkomezi canke abanyantegenke, ko ari bake canke ari benshi. <verse eid="NUM 13:18" /><verse number="19" style="v" sid="NUM 13:19" />Murabe ko ico gihugu ari ciza canke kibi; uko ibisagara vyaco bimeze, nimba bifise inzitiro canke bitazifise. <verse eid="NUM 13:19" /><verse number="20" style="v" sid="NUM 13:20" />Uko isi yaho imeze, ko imera canke ko itamera, ko hari ibiti canke ata biriho. Muze mukore ibishoboka vyose muzane ivyamwa vyo muri ico gihugu.” (Ico gihe hari mw’iyera ry’imizabibu ya mbere).<verse eid="NUM 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21" />Nuko baraduga batata ico gihugu kuva mu Bugaragwa bw’i Zini gushika i Rehobu, aharabana n’i Lebo-Hamati. <verse eid="NUM 13:21" /><verse number="22" style="v" sid="NUM 13:22" />Nuko baraduga baca i Negebu bashika i Heburoni aho Ahimani, Sheshayi na Talumayi abakomoka kuri Anaki baba. (Heburoni hari hubatswe imyaka indwi imbere ya Zowani muri Egiputa.) <verse eid="NUM 13:22" /><verse number="23" style="v" sid="NUM 13:23" />Bashitse mu kiyaya c’i Eshikoli, basoroma amahando y’imizabibu. Abantu babiri ni bo bari baziteruye ku giti, umwe inyuma uwundi imbere, bongera bazana n’amakomamanga n’insukoni. <verse eid="NUM 13:23" /><verse number="24" style="v" sid="NUM 13:24" />Aho hantu hitwa ikiyaya c’i Eshikoli (risobanurwa ngo ihando ry’inzabibu) kubera izo Abisirayeli basoromye aho hantu. <verse eid="NUM 13:24" /><verse number="25" style="v" sid="NUM 13:25" />Haheze imisi mirongo ine baragaruka bavuye gutata ico gihugu.<verse eid="NUM 13:25" /></para>
  <para style="s1">Amakuru yazanywe y’abatasi</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 13:26" />Bagaruka kwa Mose na Aroni no ku Bisirayeli bose bari i Kadeshi mu bugaragwa bw’i Parani. Aho ni ho bahereye amakuru Mose na Aroni no n’ikoraniro ryose, bongera babereka ivyamwa bimera muri ico gihugu. <verse eid="NUM 13:26" /><verse number="27" style="v" sid="NUM 13:27" />Ibi ni vyo bashikirije Mose: “Twagiye mu gihugu wari waturungitsemwo, kandi gitemba amata n’ubuki! Ng’ibi n’ivyama muri co. <verse eid="NUM 13:27" /><verse number="28" style="v" sid="NUM 13:28" />Ariko abantu baba muri co ni abanyenkomezi, n’ibisagara vyaho bizitije inzitiro zikomeye kandi ndende cane. Twanabonyeyo n’abo mu ruvyaro rwa Anaki. <verse eid="NUM 13:28" /><verse number="29" style="v" sid="NUM 13:29" />Abamaleki ni bo baba i Negebu, Abaheti, Abayebusi n’Abamori baba mu gihugu c’imisozi, Abanyakanani na bo baba ku nkengera z’ikiyaga n’uruzi rwa Yorodani.”<verse eid="NUM 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30" />Nuko Kalebu asaba abantu guhora imbere ya Mose hanyuma aravuga ati: “Muze tuduge tuje gufata ico gihugu, kuko vy’ukuri tubishoboye.”<verse eid="NUM 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 13:31" />Ariko abagabo bari baduganye na we baravuga bati: “Ntidushobora gutera barya bantu; kuko baturusha inkomezi.” <verse eid="NUM 13:31" /><verse number="32" style="v" sid="NUM 13:32" />Nuko bakwiragiza hose mu Bisirayeli iyo nkuru mbi yerekeye ico gihugu bagiye gutata. Baravuga bati: “Igihugu twagiye gutata ni igihugu kirya ababa muri co. Abantu bose twabonye muri co ni ibigatanya. <verse eid="NUM 13:32" /><verse number="33" style="v" sid="NUM 13:33" />Twabonyeyo n’Abanefilimu (abakomoka kuri Anaki). Twari tumeze nk’inzige mu maso yacu ubwacu, kandi no kuri bo twasa nk’inzige.”<verse eid="NUM 13:33" /></para>
  <chapter eid="NUM 13" />
  <chapter number="14" style="c" sid="NUM 14" />
  <para style="s1">Abantu bagarariza Imana</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1" />Muri iryo joro abantu bose bashira amajwi yabo hejuru bararira, baraboroga. <verse eid="NUM 14:1" /><verse number="2" style="v" sid="NUM 14:2" />Abisirayeli bose bidodombera Mose na Aroni, kandi ikoraniro ryose rirababarira riti: “Iyo dupfuma dupfira muri Egiputa, canke muri buno bugaragwa! <verse eid="NUM 14:2" /><verse number="3" style="v" sid="NUM 14:3" />Ni kuki <char style="nd">Uhoraho</char> atujanye muri kirya gihugu ngo tuje kwicishwa inkota? Abagore bacu n’abana bacu bazojanwe nk’inyagano. Mbega ivyotubera vyiza si uko twokwisubirira muri Egiputa?” <verse eid="NUM 14:3" /><verse number="4" style="v" sid="NUM 14:4" />Nuko baravugana bati: “Reka twitorere uwuturongora duheze twisubirire muri Egiputa.”<verse eid="NUM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5" />Nuko Mose na Aroni bikubita hasi imbere y’ikoraniro ryose ry’Abisirayeli. <verse eid="NUM 14:5" /><verse number="6" style="v" sid="NUM 14:6" />Yosuwa mwene Nuni na Kalebu mwene Yefune, mu bari baduze gutata ico gihugu, bitabagurirako impuzu zabo <verse eid="NUM 14:6" /><verse number="7" style="v" sid="NUM 14:7" />babarira Abisirayeli bose bati: “Igihugu twaciyemwo ni igihugu ciza cane. <verse eid="NUM 14:7" /><verse number="8" style="v" sid="NUM 14:8" /><char style="nd">Uhoraho</char> nimba atunezererewe, azoturongora akiduhe. <verse eid="NUM 14:8" /><verse number="9" style="v" sid="NUM 14:9" />Ariko, ntimugararize <char style="nd">Uhoraho</char> kandi ntimutinye abantu bo muri ico gihugu, kuko tuzobamira miyonzwa. Icabakingira cakuweho, ariko tweho <char style="nd">Uhoraho</char> ari kumwe natwe. Ntimubatinye.”<verse eid="NUM 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 14:10" />Ariko ikoraniro ryose ritangura kuvugana ngo babatere amabuye. Maze ubwiza bw’<char style="nd">Uhoraho</char> bubonekera Abisirayeli bose buri kuri rya hema ry’ibonaniro. <verse eid="NUM 14:10" /><verse number="11" style="v" sid="NUM 14:11" /><char style="nd">Uhoraho</char> abarira Mose ati: “Aba bantu bazogeza ryari kunkengera? Bazogeza hehe kutanyizera, n’ibimenyetso bitangaje nakoreye hagati muri bo? <verse eid="NUM 14:11" /><verse number="12" style="v" sid="NUM 14:12" />Reka ndabateze icago ndabamare, ariko wewe nzokugira ihanga rinini kandi rikomeye rizobarusha inkomezi.”<verse eid="NUM 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13" />Mose abaza <char style="nd">Uhoraho</char> ati: “None Abanyegiputa bazokwiyumvira iki nibavyumva? Kuko wakuje iri hanga muri Egiputa ukuboko kwawe kw’inkomezi. <verse eid="NUM 14:13" /><verse number="14" style="v" sid="NUM 14:14" />Niwabarandura bazovyumva kandi babibwire ababa muri iki gihugu, bamaze kwumva ko wewe <char style="nd">Uhoraho</char>, uri kumwe n’iri hanga kandi ko wewe <char style="nd">Uhoraho</char> bakwiboneye amaso ku yandi, ko igicu cawe kiba hejuru yabo, kandi ko ubaja imbere mu nkingi y’igicu ku murango n’inkingi y’umuriro mw’ijoro. <verse eid="NUM 14:14" /><verse number="15" style="v" sid="NUM 14:15" />Niwicira aba bantu bose icarimwe, ya mahanga yumvise ivyo wakoze bazovuga bati: <verse eid="NUM 14:15" /><verse number="16" style="v" sid="NUM 14:16" />‘<char style="nd">Uhoraho</char> ntiyari ashoboye gushikana aba bantu mu gihugu yari yarabarahiye ko azokibaha; ni co catumye abicira mu bugaragwa.’<verse eid="NUM 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 14:17" />Ubu rero icompa inkomezi z’Imana zikiyerekana, nk’uko wabivuze uti: <verse eid="NUM 14:17" /><verse number="18" style="v" sid="NUM 14:18" />‘<char style="nd">Uhoraho</char> ateba kuraka, yuzuye urukundo rwinshi kandi ababarira icaha n’ubugarariji. Ariko ntazokwirengagiza guhana uwacumuye; ahora abana icaha ca ba se gushika ku runganwe rugira gatatu n’urugira kane.’ <verse eid="NUM 14:18" /><verse number="19" style="v" sid="NUM 14:19" />Nk’uko urukundo rwawe rwinshi ruri, harira icaha c’ubu bwoko, nk’uko wamye ubaharira kuva igihe baviriye muri Egiputa kugeza n’ubu.”<verse eid="NUM 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20" />
    <char style="nd">Uhoraho</char> arishura ati: “Ndabahariye, nk’uko ubinsavye. <verse eid="NUM 14:20" /><verse number="21" style="v" sid="NUM 14:21" />Ariko, ndahiye uguhoraho kwanje n’ubwiza bwanje bwuzuye isi yose, <verse eid="NUM 14:21" /><verse number="22" style="v" sid="NUM 14:22" />nta n’umwe mu babonye ubwiza bwanje n’ibitangaza nakoreye muri Egiputa no mu bugaragwa ariko bakangarariza kandi bakangerageza incuro icumi zose; <verse eid="NUM 14:22" /><verse number="23" style="v" sid="NUM 14:23" />azobona ico gihugu nasezeraniye ba sekuruza nkabarahira ko nzokibaha. Nta n’umwe mu bankengereye azokwigera akibona. <verse eid="NUM 14:23" /><verse number="24" style="v" sid="NUM 14:24" />Ariko kubera umusavyi wanje Kalebu afise impwemu itandukanye n’iyabo kandi akankurikira n’umutima wiwe wose, nzomujana mu gihugu yagiye gutata, kandi uruvyaro rwiwe ruzoragwa ico gihugu. <verse eid="NUM 14:24" /><verse number="25" style="v" sid="NUM 14:25" />Ko Abamaleki n’Abanyakanani baba mu biyaya, ejo muze muhindukire mugende mwerekeye mu bugaragwa mu nzira ija ku Kiyaga Gitukura.”<verse eid="NUM 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26" />
    <char style="nd">Uhoraho</char> abarira Mose na Aroni ati: <verse eid="NUM 14:26" /><verse number="27" style="v" sid="NUM 14:27" />“Aba bantu bononekaye bazogeza ryari kunyidodombera? Numvise imyidodombo y’aba Bisirayeli banyidodombera. <verse eid="NUM 14:27" /><verse number="28" style="v" sid="NUM 14:28" />Nuko rero mubabwire muti uku ni ko <char style="nd">Uhoraho</char> avuze: ‘Ndahiye uguhoraho kwanje, nzobakorera ivyo nyene numvise mwivugiye: <verse eid="NUM 14:28" /><verse number="29" style="v" sid="NUM 14:29" />Imivyimba yanyu izogwa muri ubu bugaragwa, umuntu wese muri mwebwe afise imyaka mirongo ibiri n’iyirenga yaharuwe muri rya harura kandi yanyidodombeye. <verse eid="NUM 14:29" /><verse number="30" style="v" sid="NUM 14:30" />Nta n’umwe wo muri mwebwe azokwinjira mu gihugu narahiye manitse ukuboko kwanjeko nzokibaha kikaba ahantu hanyu muba, atari Kalebu mwene Yefune na Yosuwa mwene Nuni. <verse eid="NUM 14:30" /><verse number="31" style="v" sid="NUM 14:31" />Abana banyu mwavuze ngo bazojanwa kw’inyagano, ni bo nzojanayo banezerererwe ivyiza vy’ico gihugu mwateye ibitugu. <verse eid="NUM 14:31" /><verse number="32" style="v" sid="NUM 14:32" />Ariko mweho, imivyimba yanyu izogwa muri ubu bugaragwa. <verse eid="NUM 14:32" /><verse number="33" style="v" sid="NUM 14:33" />Abana banyu bazoba abungere hano kumara imyaka mirongo ine, bababazwe n’uguhemuka kwanyu, kugeza aho umuvyimba wa nyuma wo muri mwebwe uzokumbagarira muri ubu bugaragwa. <verse eid="NUM 14:33" /><verse number="34" style="v" sid="NUM 14:34" />Kumara imyaka mirongo ine; umwaka wose uzohura n’umusi umwe muri ya misi mirongo ine mwamara muri gutata ico gihugu, muzoyimara mubabazwa kubera ivyaha vyanyu. Ni ho muzomenyera ico ari co kungira nk’umwansi wanyu.’ <verse eid="NUM 14:34" /><verse number="35" style="v" sid="NUM 14:35" />Ni jewe <char style="nd">Uhoraho</char> ndabivuze, kandi nzobishitsa kuri iri hanga ribi, ryahagurukiye rimwe kungwanya. Bazohonera muri ubu bugaragwa; ni ho bazopfira.”<verse eid="NUM 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36" />Nuko ba bagabo Mose yari yatumye gutata igihugu, ari bo bagarutse bakagumura iryo hanga ryose kumugwanya mu gukwiza inkuru mbi y’ico gihugu, <verse eid="NUM 14:36" /><verse number="37" style="v" sid="NUM 14:37" />abo bagabo nyene bakwije iyo nkuru mbi y’ico gihugu baciye bafatwa n’ikiza aho nyene imbere y’<char style="nd">Uhoraho</char> baca bagwaho. <verse eid="NUM 14:37" /><verse number="38" style="v" sid="NUM 14:38" />Muri abo bagabo bari barungitswe gutata ico gihugu hasigaye Yosuwa mwene Nuni na Kalebu mwene Yefune gusa.<verse eid="NUM 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39" />Nuko Mose amaze kubibwira Abisirayeli, bose baca baborogera rimwe bikomeye. <verse eid="NUM 14:39" /><verse number="40" style="v" sid="NUM 14:40" />Mu gitondo ca kare baca barahaguruka ngo baduge mu karere k’imisozi miremire. Bavuga bati: “Twaracumuye. Ubu turiteguye kuja muri ca gihugu <char style="nd">Uhoraho</char> yadusezeranira.”<verse eid="NUM 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41" />Ariko Mose arababarira ati: “Ni kuki muriko murarenga kw’itegeko ry’<char style="nd">Uhoraho</char>? Nta co muzoshikako! <verse eid="NUM 14:41" /><verse number="42" style="v" sid="NUM 14:42" />Ntimuduge, kuko <char style="nd">Uhoraho</char> atari kumwe namwe. Muzoneshwa n’abansi banyu, <verse eid="NUM 14:42" /><verse number="43" style="v" sid="NUM 14:43" />kuko Abamaleki n’Abanyakanani bazobatangirira aho hantu. Kubera ko mwateye ibitugu <char style="nd">Uhoraho</char>, ntazobana namwe muzokwicwa n’inkota.”<verse eid="NUM 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44" />Ariko banka kwumva, mu bwibone bwabo baraduga baja muri iyo misozi, naho Mose na ya sandugu y’isezerano batigeze bava aho bari bacumbitse. <verse eid="NUM 14:44" /><verse number="45" style="v" sid="NUM 14:45" />Nuko Abamaleki n’Abanyakanani baba muri iyo misozi baramanuka barabatera bagenda barabica gushika i Horuma.<verse eid="NUM 14:45" /></para>
  <chapter eid="NUM 14" />
  <chapter number="15" style="c" sid="NUM 15" />
  <para style="s1">Amashikanwa y’ifu, ay’amavuta n’ay’umuvinyu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 15:1" /><verse number="2" style="v" sid="NUM 15:2" />“Vugana n’Abisirayeli ubabwire uti: ‘Nimwinjira mu gihugu ngiye kubaha ngo mucegukire <verse eid="NUM 15:2" /><verse number="3" style="v" sid="NUM 15:3" />nimwashikanira <char style="nd">Uhoraho</char> ikimazi co guturirwa, kivuye mu masho canke mu mikuku, nk’ubumote bwiza buhawe <char style="nd">Uhoraho</char>, yaba ari amashikanwa yo guturirwa canke ibimazi, vyaba ari ivyo gushitsa isezerano canke ivyo gushikana bitanzwe n’uwuvyishakiye canke amashikanwa y’imisi mikuru; <verse eid="NUM 15:3" /><verse number="4" style="v" sid="NUM 15:4" />uwuzozana ishikanwa ryiwe aze ashikanire <char style="nd">Uhoraho</char> ishikanwa ry’ifu ringana n’ic’icumi c’ingero efa<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">Ni nk’ikilo 1,6.</char></note> y’ifu inoze neza ivanze n’ica kane c’ingero hini<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">Ni nk’ilitiro 1</char></note> y’amavuta. <verse eid="NUM 15:4" /><verse number="5" style="v" sid="NUM 15:5" />Ku mwagazi w’intama wose utanzwe nk’ikimazi co guturirwa canke ikindi kimazi, muze mutegure ica kane c’ingero hini y’umuvinyu bibe ikimazi c’ibinyobwa.<verse eid="NUM 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 15:6" />Ku mpfizi y’intama yose muze mutegure ishikanwa ry’ifu ringana na bibiri vya cumi vy’ingero efa<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">Ni nk’ibilo 3,2.</char></note> y’ifu inoze neza ivanze n’ica gatatu c’ingero hini<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">Ni nk’ilitiro n’ibice bitatu</char></note> y’amavuta, <verse eid="NUM 15:6" /><verse number="7" style="v" sid="NUM 15:7" />hamwe n’ica gatatu c’ingero hini y’umuvinyu ngo bibe ishikanwa ry’ibinyobwa. Mubitange bibe ubumote bwiza bunezereza <char style="nd">Uhoraho</char>.<verse eid="NUM 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 15:8" />Nimwategura gutanga ishuri y’ikimazi co guturirwa canke ikindi kimazi, ryaba ishikanwa ryo gushitsa isezerano canke ikimazi c’ishimwe gishikaniwe <char style="nd">Uhoraho</char>, <verse eid="NUM 15:8" /><verse number="9" style="v" sid="NUM 15:9" />muze muzane iyo shuri hamwe n’ishikanwa ringana na bitatu vya cumi vy’ingero efa<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">Ni nk’ibilo 5</char></note> y’ifu inoze neza ivanzwe n’igice c’ingero hini<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">Ni nk’ilitiro 1,9.</char></note> y’amavuta. <verse eid="NUM 15:9" /><verse number="10" style="v" sid="NUM 15:10" />Kandi muze muzane n’igice c’ingero hini y’umuvinyu bibe ishikanwa ry’ibinyobwa. Rizoba ari ishikanwa riturirwa, rizana ubumote bwiza bunezereza <char style="nd">Uhoraho</char>. <verse eid="NUM 15:10" /><verse number="11" style="v" sid="NUM 15:11" />Ikimazi cose kigizwe n’ishuri canke impfizi y’intama, umwagazi w’intama canke umwagazi w’impene iyo ari yo yose, bize bitegurwe muri ubwo buryo. <verse eid="NUM 15:11" /><verse number="12" style="v" sid="NUM 15:12" />Bize bikorwe gutyo ku kimazi cose gitanzwe, nk’uko igitigiri cavyo kingana.<verse eid="NUM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 15:13" />Umuntu wese w’imvukira yo muri mwebwe aze akore ivyo bintu muri ubwo buryo igihe cose azotanga ikimazi co guturirwa ngo kizane ubumote bwiza bunezereza <char style="nd">Uhoraho</char>. <verse eid="NUM 15:13" /><verse number="14" style="v" sid="NUM 15:14" />Uko urunganwe ruzogenda rukuranwa n’urundi, umunyamahanga aba muri mwebwe canke umuntu wese wo muri mwebwe azotanga ikimazi co guturirwa ngo kibe ubumote bwiza bunezereza <char style="nd">Uhoraho</char>, aze abikore nk’uko namwe mubikora. <verse eid="NUM 15:14" /><verse number="15" style="v" sid="NUM 15:15" />Mwese muze mwisunge amategeko amwe, yaba mwebwe imvukira canke umunyamahanga aba muri mwebwe. Iryo rize ribe itegeko rizokwamaho uko urunganwe ruzogenda rukurakuranwa n’urundi. Mwebwe n’umunyamahanga aba muri mwebwe muri co kimwe imbere y’<char style="nd">Uhoraho</char>: <verse eid="NUM 15:15" /><verse number="16" style="v" sid="NUM 15:16" />Itegeko rimwe n’icagezwe kimwe ni vyo bizogenga mwebwe n’abanyamahanga baba muri mwebwe.’ ”<verse eid="NUM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 15:17" /><verse number="18" style="v" sid="NUM 15:18" />“Vugana n’Abisirayeli ubabwire uti: ‘Nimwashika mu gihugu ngiye kubaha <verse eid="NUM 15:18" /><verse number="19" style="v" sid="NUM 15:19" />hanyuma mugafungura ivyo kurya vy’ico gihugu, muze mukureko ico mushikanira <char style="nd">Uhoraho</char>. <verse eid="NUM 15:19" /><verse number="20" style="v" sid="NUM 15:20" />Muze mukore umukate mw’ifu y’ingano zeze imbere y’izindi, muwushikane nk’ishikanwa ry’ifu mukuye mu ngano za mbere musekuriye ku mbuga. <verse eid="NUM 15:20" /><verse number="21" style="v" sid="NUM 15:21" />Uko urunganwe ruzogenda rukurikirana n’urundi muze mwame mushikanira <char style="nd">Uhoraho</char> iryo shikanwa rivuye mu vyeze imbere y’ibindi.<verse eid="NUM 15:21" /></para>
  <para style="s1">Ikimazi c’ivyaha bitakozwe ibigirankana</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22" />Umuntu niyarenga kw’itegeko na rimwe muri ayo <char style="nd">Uhoraho</char> yahaye Mose; <verse eid="NUM 15:22" /><verse number="23" style="v" sid="NUM 15:23" />ya yandi yose <char style="nd">Uhoraho</char> yabategeka ayacishije kuri we, kuva ku musi yatanguriyeko kuyabaha kandi n’ubu akaba akiyabaha gushika uko urunganwe ruzogenda rukurikirana n’urundi; <verse eid="NUM 15:23" /><verse number="24" style="v" sid="NUM 15:24" />niyaba yabikoze atabishaka abantu bose batabimenye, abantu bose baze batange ishuri ikiri ntoya nk’ikimazi co guturirwa ibe ubumote bwiza bunezera <char style="nd">Uhoraho</char>, hamwe na rya shikanwa ry’ifu ryashinzwe na rya shikanwa ry’ibinyobwa, atange n’isuguru y’impene y’ikimazi c’ivyaha. <verse eid="NUM 15:24" /><verse number="25" style="v" sid="NUM 15:25" />Umuherezi aze atangire ikimazi co gukurako icaha ubwoko bwose bw’Abisirayeli, na bo bazoharirwa, kuko vyakozwe atabigabiye kandi bakaba bashikaniye <char style="nd">Uhoraho</char> ikimazi co guturirwa n’ikimazi c’ivyaha ku bw’amakosa yabo. <verse eid="NUM 15:25" /><verse number="26" style="v" sid="NUM 15:26" />Abisirayeli bose n’abanyamahanga baba muri bo bazoharirwa, kuko abantu bose bazoba bafatanije muri ico gicumuro cakozwe batabigabiye.<verse eid="NUM 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27" />Ariko umuntu umwe wenyene niyakora icaha atabigabiye, aze azane umwagazi w’impene umaze umwaka umwe w’ikimazi c’ivyaha. <verse eid="NUM 15:27" /><verse number="28" style="v" sid="NUM 15:28" />Umuherezi aze atangire imbere y’<char style="nd">Uhoraho</char> ikimazi gikurako ivyaha uwo muntu yacumuye atabigabiye, ico kimazi niyamara kugitanga, na we azoharirwa. <verse eid="NUM 15:28" /><verse number="29" style="v" sid="NUM 15:29" />Iryo bwirizwa rimwe rizogenga abantu bose bacumuye batabigabiye, yaba ari imvukira y’Umwisirayeli canke umunyamahanga aba muri mwebwe.<verse eid="NUM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30" />Ariko umuntu niyakora icaha ibigirankana, ari imvukira canke umunyamahanga, azoba atutse k’<char style="nd">Uhoraho</char>, kandi uwo muntu aze akurwe mu bantu biwe. <verse eid="NUM 15:30" /><verse number="31" style="v" sid="NUM 15:31" />Kuko azoba yakengereye ijambo ry’<char style="nd">Uhoraho</char> agacumura ku vyo yategetswe, uwo muntu ntaze abure gukurwaho; icaha ciwe kizomwomako.’ ”<verse eid="NUM 15:31" /></para>
  <para style="s1">Uguhanwa kw’uwacumuye kw’Isabato</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32" />Igihe Abisirayeli bari mu bugaragwa, basanze umugabo ariko arasenya inkwi ku musi w’Isabato. <verse eid="NUM 15:32" /><verse number="33" style="v" sid="NUM 15:33" />Abamufashe ariko arasenya bamuzanira Mose na Aroni n’ikoraniro ryose, <verse eid="NUM 15:33" /><verse number="34" style="v" sid="NUM 15:34" />baca bamushira mw’ibohero, kuko batari bwamenye ico bomukorera. <verse eid="NUM 15:34" /><verse number="35" style="v" sid="NUM 15:35" />Nuko <char style="nd">Uhoraho</char> abarira Mose ati: “Uwo muntu akwiye gupfa. Ikoraniro ryose nirimutere amabuye inyuma y’aho bacumbitse.” <verse eid="NUM 15:35" /><verse number="36" style="v" sid="NUM 15:36" />Nuko Ikoraniro ryose rimutwara inyuma y’aho bacumbitse bamutera amabuye maze arapfa, nk’uko <char style="nd">Uhoraho</char> yari yategetse Mose.<verse eid="NUM 15:36" /></para>
  <para style="s1">Ivyerekeye ubuyonga ku mpuzu</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 15:37" /><verse number="38" style="v" sid="NUM 15:38" />“Vugana n’Abisirayeli ubabwire uti: ‘Uko urunganwe ruzogenda rukurikirana n’urundi muze mwame mutera ubuyonga ku misozo y’impuzu zanyu, mushireko n’urunyuzi rw’ubururu ku buyonga bwose. <verse eid="NUM 15:38" /><verse number="39" style="v" sid="NUM 15:39" />Namwe nimwaraba kuri ubwo buyonga muzokwibuka amategeko yose <char style="nd">Uhoraho</char> yabahaye, kugira ngo muyitondere ntimukwegwe n’ivyipfuzo vy’imitima yanyu n’amaso yanyu. <verse eid="NUM 15:39" /><verse number="40" style="v" sid="NUM 15:40" />Nuko muzokwibuka kwumvira amategeko yanje yose muzobe mwegukiye Imana yanyu. <verse eid="NUM 15:40" /><verse number="41" style="v" sid="NUM 15:41" />Ndi <char style="nd">Uhoraho</char> Imana yanyu, nabakuye muri Egiputa ngo mbe Imana yanyu. Ndi <char style="nd">Uhoraho</char> Imana yanyu.’ ”<verse eid="NUM 15:41" /></para>
  <chapter eid="NUM 15" />
  <chapter number="16" style="c" sid="NUM 16" />
  <para style="s1">Ivya Kora, Datani na Abiramu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1" />Kora mwene Izihari, akomoka kuri Kohati mwene Lewi, baja hamwe n’abakomoka kuri Reyubeni; Datani na Abiramu, abahungu ba Eliyabu, akomoka kuri Oni mwene Peleti, baragumuka, <verse eid="NUM 16:1" /><verse number="2" style="v" sid="NUM 16:2" />bava hasi kugwanya Mose. Bari kumwe n’abandi bakuru amajana abiri na mirongo itanu, bari bazwi neza ko ari abakuru mu bwoko bwose kandi bari baratowe ngo babe abo mu rwego rw’abarongozi. <verse eid="NUM 16:2" /><verse number="3" style="v" sid="NUM 16:3" />Bahuza inama nk’umugwi ngo bagwanye Mose na Aroni bababarira bati: “Murarengeje urugero! Iri hanga ryose ni iryera, umuntu wese ku giti ciwe, kandi <char style="nd">Uhoraho</char> ari kumwe na bo. None ni iki gituma mwishira hejuru y’ubu bwoko bw’<char style="nd">Uhoraho</char>?”<verse eid="NUM 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4" />Mose yumvise ivyo, yubama hasi. <verse eid="NUM 16:4" /><verse number="5" style="v" sid="NUM 16:5" />Maze abarira Kora n’abari bamukurikiye ati: “Ejo mu gitondo <char style="nd">Uhoraho</char> azokwerekana uwiwe n’uwejejwe, kandi azomwiyegereza. <verse eid="NUM 16:5" /><verse number="6" style="v" sid="NUM 16:6" />Mwebwe, Kora, namwe mwese mwamukurikiye muze mugire mutya: Muze mufate ivyotezo <verse eid="NUM 16:6" /><verse number="7" style="v" sid="NUM 16:7" />ejo muze mubishiremwo umuriro n’ibimota neza iyo bituriwe mubizane imbere y’<char style="nd">Uhoraho</char>. Umuntu <char style="nd">Uhoraho</char> azorobanura ni we azoba ari uwera. Yemwe bene Lewi, mwarenze akarimbi!”<verse eid="NUM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 16:8" />Mose yongera abarira Kora ati: “Nimwumve ibi, yemwe Balewi! <verse eid="NUM 16:8" /><verse number="9" style="v" sid="NUM 16:9" />Mbega ntibihagije ko Imana y’Abisirayeli yabatoranije mu bandi Bisirayeli ikabazana hafi yayo kugira ngo muyikorere ahera h’<char style="nd">Uhoraho</char> kandi ngo muhagarare imbere y’ubu bwoko mubukorere? <verse eid="NUM 16:9" /><verse number="10" style="v" sid="NUM 16:10" />Yarabegereje hafi yayo mwebwe n’abagenzi banyu b’Abalewi, ariko ubu na ho muriko murashaka kwigarurira ubuherezi na bwo! <verse eid="NUM 16:10" /><verse number="11" style="v" sid="NUM 16:11" />Mwishize hamwe kugwanya <char style="nd">Uhoraho</char>. Aroni ni iki aho mumukurira hasi ngo mumugwanye?”<verse eid="NUM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12" />Nuko Mose ahamagara Datani na Abiramu, bene Eliyabu. Ariko bavuga bati: “Ntituza! <verse eid="NUM 16:12" /><verse number="13" style="v" sid="NUM 16:13" />Mbega ntibihagije ivyo wadukoreye mu kudukura mu gihugu gitemba amata n’ubuki ukatuzana gupfira mu bugaragwa? None n’ubu na ho ugomba kwigira umwami wacu? <verse eid="NUM 16:13" /><verse number="14" style="v" sid="NUM 16:14" />Ikigeretseko, ntiwatuzanye mu gihugu gitemba amata n’ubuki canke ngo uduhe ishamvu yacu canke amatongo y’imizabibu. Mbega wibwira ko twebwe turi impumyi? Oya, ntitugenda tuje!”<verse eid="NUM 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15" />Nuko Mose arashavura cane maze abarira <char style="nd">Uhoraho</char> ati: “Ntiwemere ishikanwa ryabo. Sinigeze ndabatwara ikintu na kimwe, naho yoba indogoba, nta n’umwe muri bo nagiriye nabi.”<verse eid="NUM 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16" />Mose abarira Kora ati: “Wewe n’abagukurikiye muze imbere y’<char style="nd">Uhoraho</char> ejo; wewe na bo na Aroni. <verse eid="NUM 16:16" /><verse number="17" style="v" sid="NUM 16:17" />Umwe wese azoze azanye icotezo ciwe ashireko ibimota neza iyo bituriwe; ivyotezo amajana abiri na mirongo itanu vyose hamwe, hanyuma muze imbere y’<char style="nd">Uhoraho</char>. Wewe na Aroni namwe muze muzane ivyotezo vyanyu.” <verse eid="NUM 16:17" /><verse number="18" style="v" sid="NUM 16:18" />Nuko umuntu wese azana icotezo ciwe, ashirako umuriro n’ibimota neza iyo bituriwe, bahagararana na Mose na Aroni ku muryango w’Ihema ry’Ibonaniro. <verse eid="NUM 16:18" /><verse number="19" style="v" sid="NUM 16:19" />Maze Kora amaze kwegeranya abantu bose ngo bagwanye Mose imbere y’Ihema ry’Ibonaniro ubwiza bw’<char style="nd">Uhoraho</char> bubonekera Abisirayeli bose. <verse eid="NUM 16:19" /><verse number="20" style="v" sid="NUM 16:20" /><char style="nd">Uhoraho</char> abarira Mose na Aroni ati: <verse eid="NUM 16:20" /><verse number="21" style="v" sid="NUM 16:21" />“Nimwitandukanye n’iri koraniro kugira ngo ndabarandure rimwe na rimwe.”<verse eid="NUM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 16:22" />Ariko Mose na Aroni bagwa bubamye baratakamba bati: “Yewe Mana, Mana y’impwemu z’abariho bose, mbega woshavurira ikoraniro ryose kandi hacumuye umuntu umwe?”<verse eid="NUM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 16:23" />Nuko <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 16:23" /><verse number="24" style="v" sid="NUM 16:24" />“Bwira ikoraniro uti: ‘Nimwigire kure y’amahema ya Kora, Datani na Abiramu.’ ”<verse eid="NUM 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25" />Mose ava hasi aja kwa Datani na Abiramu, kandi n’abakuru b’Abisirayeli baramukurikira. <verse eid="NUM 16:25" /><verse number="26" style="v" sid="NUM 16:26" />Aburira ikoraniro ati: “Mwigire kure y’amahema y’abanyakibi! Ntimukore ku kintu na kimwe cabo, kugira ngo ntimurandurwe muzira ivyaha vyabo.” <verse eid="NUM 16:26" /><verse number="27" style="v" sid="NUM 16:27" />Nuko bigira kure y’amahema ya Kora, Datani na Abiramu. Datani na Abiramu bari basohotse bahagaze imbere y’amahema yabo n’abagore babo, n’abana n’abakiri bato.<verse eid="NUM 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 16:28" />Nuko Mose aravuga ati: “Iki ni co kizobamenyesha ko <char style="nd">Uhoraho</char> ari we yantumye gukora ibi bintu ko bitari ivyo niyumviriye: <verse eid="NUM 16:28" /><verse number="29" style="v" sid="NUM 16:29" />Aba bantu nibapfa urupfu rusanzwe bagahura n’ibisanzwe biba ku bandi bose, <char style="nd">Uhoraho</char> azoba atantumye. <verse eid="NUM 16:29" /><verse number="30" style="v" sid="NUM 16:30" />Ariko <char style="nd">Uhoraho</char> niyazana ikintu gishasha, isi ikasama ikabamira n’ivyabo vyose, bakaja mu mva ari bazima, aho ni ho muzomenyera ko aba bantu bakengereye <char style="nd">Uhoraho</char>.”<verse eid="NUM 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31" />Ahejeje kuvuga ivyo vyose, aho bari bahagaze harasama <verse eid="NUM 16:31" /><verse number="32" style="v" sid="NUM 16:32" />isi yugurura akanwa kayo irabamira, n’ivyo batunze vyose n’abantu bose bari inyuma ya Kora n’ivyo bari batunze vyose. <verse eid="NUM 16:32" /><verse number="33" style="v" sid="NUM 16:33" />Bamanuka i kuzimu ari bazima, n’ivyo bari batunze vyose; isi ica iriyugara, barahona bakurwa mu bandi Bisirayeli. <verse eid="NUM 16:33" /><verse number="34" style="v" sid="NUM 16:34" />Abisirayeli bari hafi y’aho abo bari, bumvise ugutaka kwabo barahunga, kuko batinya ko isi ibamira na bo.<verse eid="NUM 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 16:35" />Umuriro uvuye k’<char style="nd">Uhoraho</char> uraza utongora ba bagabo amajana abiri na mirongo itanu bariko baraturira ibimota neza.<verse eid="NUM 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 16:36" /><verse number="37" style="v" sid="NUM 16:37" />“Bwira Eliyazeri mwene Aroni, umuherezi, agende atore birya vyotezo biri mu muriro, asuke kure amakara, kuko ivyo vyotezo ari ivyera vyanje; <verse eid="NUM 16:37" /><verse number="38" style="v" sid="NUM 16:38" />ivyotezo vy’abo bantu bacumuye bigatuma bapfa. Muze mubicuremwo amabati yo gupfuka igicaniro, kuko vyashikirijwe <char style="nd">Uhoraho</char> bigaca biba ivyera. Bize bibere ikimenyetso Abisirayeli.”<verse eid="NUM 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 16:39" />Nuko Eliyazeri umuherezi yegeranya vya vyotezo vy’umwakaka vy’abatongowe n’umuriro, babicuramwo ivyo gupfuka igicaniro, <verse eid="NUM 16:39" /><verse number="40" style="v" sid="NUM 16:40" />nk’uko <char style="nd">Uhoraho</char> yari yamutegetse abicishije muri Mose. Uko kwari ukwibutsa Abisirayeli ko ata muntu n’umwe atari uwo mu ruvyaro rwa Aroni yokwubahuka guturirira ibimota neza imbere y’<char style="nd">Uhoraho</char>, atagomba kuba nka Kora n’abamukurikiye.<verse eid="NUM 16:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41" />Bukeye ikoraniro ry’Abisirayeli bose bidodombera Mose na Aroni bavuga bati: “Mwishe abantu b’<char style="nd">Uhoraho</char>.”<verse eid="NUM 16:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 16:42" />Ariko igihe abagize ikoraniro bariko baratonganya Mose na Aroni bahindukiye ngo barabe ihema ry’ibonaniro, ubwo nyene igicu caciye kiripfuka ubwiza bw’<char style="nd">Uhoraho</char> buraboneka. <verse eid="NUM 16:42" /><verse number="43" style="v" sid="NUM 16:43" />Nuko Mose na Aroni baca baja imbere y’ihema ry’ibonaniro, <verse eid="NUM 16:43" /><verse number="44" style="v" sid="NUM 16:44" />maze <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 16:44" /><verse number="45" style="v" sid="NUM 16:45" />“Igira kure ya rino koraniro kugira ngo ndabaherengeteze ubu nyene.” Baca bubama hasi.<verse eid="NUM 16:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 16:46" />Nuko Mose abarira Aroni ati: “Fata icotezo ushiremwo ibimota neza n’umuriro uvuye ku gicaniro, uce wihuta uje mu bantu ubatangire ikimazi gikura icaha. Uburake buvuye k’<char style="nd">Uhoraho</char> buraje, ikiza kiratanguye.” <verse eid="NUM 16:46" /><verse number="47" style="v" sid="NUM 16:47" />Nuko Aroni akora nk’uko Mose yamubwiye, aca yiruka mu bantu. Ikiza cari camaze gutangura kwica abantu. Ariko Aroni aturira ibimota neza ngo abatangire ikimazi gikura ivyaha. <verse eid="NUM 16:47" /><verse number="48" style="v" sid="NUM 16:48" />Ahagarara hagati y’abazima n’abapfuye, ikiza kirahagarara. <verse eid="NUM 16:48" /><verse number="49" style="v" sid="NUM 16:49" />Ariko abantu ibihumbi cumi na bine n’amajana indwi barapfa bishwe n’ico kiza, biyongera kuri bamwe bicwa kubera kugarariza kwa Kora. <verse eid="NUM 16:49" /><verse number="50" style="v" sid="NUM 16:50" />Nuko Aroni agaruka aho Mose yari ari imbere y’ihema ry’ibonaniro, kuko ico kiza cari cahagaze.<verse eid="NUM 16:50" /></para>
  <chapter eid="NUM 16" />
  <chapter number="17" style="c" sid="NUM 17" />
  <para style="s1">Inkoni ya Aroni ishurika</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 17:1" /><verse number="2" style="v" sid="NUM 17:2" />“Bwira Abisirayeli bazane inkoni icumi na zibiri, imwimwe ku muryango wose ivuye ku mukuru aserukira uwo muryango. Uze wandike izina rya nyene inkoni ku nkoni yiwe. <verse eid="NUM 17:2" /><verse number="3" style="v" sid="NUM 17:3" />Ku nkoni ya Lewi uze wandike izina rya Aroni, kuko hategerezwa kuba inkoni imwe ku mukuru w’umuryango wose. <verse eid="NUM 17:3" /><verse number="4" style="v" sid="NUM 17:4" />Muze muzishire mw’Ihema ry’Ibonaniro imbere y’Isandugu y’Isezerano, aho mbonanira namwe. <verse eid="NUM 17:4" /><verse number="5" style="v" sid="NUM 17:5" />Inkoni y’uwo nzoba ntoranije izoshurika, gutyo nzoba nikuriyeho imyidogo Abisirayeli bama bakwidogera.”<verse eid="NUM 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6" />Nuko Mose avugana n’Abisirayeli, maze abakuru babo bazana inkoni zabo icumi na zibiri, imwimwe ku mukuru w’umuryango wose, n’inkoni ya Aroni yarimwo. <verse eid="NUM 17:6" /><verse number="7" style="v" sid="NUM 17:7" />Mose ashira za nkoni imbere y’<char style="nd">Uhoraho</char> mw’Ihema ry’ibishingantahe.<verse eid="NUM 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8" />Bukeye Mose yinjira mw’Ihema ry’ibishingantahe aca asanga inkoni ya Aroni yaserukira umuryango wa Lewi, ntiyatutuje amababi gusa ahubwo yashuritse yongera yama na alumonde zihiye. <verse eid="NUM 17:8" /><verse number="9" style="v" sid="NUM 17:9" />Nuko Mose asohora za nkoni azikura imbere y’<char style="nd">Uhoraho</char> azizanira Abisirayeli bose. Baziravye, umwe wese atora iyiwe.<verse eid="NUM 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 17:10" />
    <char style="nd">Uhoraho</char> abarira Mose ati: “Subiza ya nkoni ya Aroni imbere y’Isandugu y’ibishingantahe, kugira ngo ibe ikimenyetso c’abagumutse. Ivyo bizokuraho imyidodombo banyidodombera, kugira ngo ntibapfe.” <verse eid="NUM 17:10" /><verse number="11" style="v" sid="NUM 17:11" />Mose aca akora nk’uko <char style="nd">Uhoraho</char> yamutegetse nyene.<verse eid="NUM 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12" />Abisirayeli babarira Mose bati: “Ehe tugiye gupfa! Turaheze, twese turaheze! <verse eid="NUM 17:12" /><verse number="13" style="v" sid="NUM 17:13" />Umuntu wese agize ngo aregera gusa ihema ry’<char style="nd">Uhoraho</char> aca apfa. Mbega none dupfe twese dushire?”<verse eid="NUM 17:13" /></para>
  <chapter eid="NUM 17" />
  <chapter number="18" style="c" sid="NUM 18" />
  <para style="s1">Ibikorwa vy’abaherezi n’Abalewi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1" />
    <char style="nd">Uhoraho</char> abarira Aroni ati: “Wewe n’abahungu bawe n’abo mu nzu ya so ni mwebwe muzobazwa ibicumuro vyose bizokorerwa mw’ihema ry’ibonaniro, kandi wewe n’abahungu bawe ni mwebwe mwenyene muzobazwa ibicumuro vyose bizokorwa ku bijanye n’ubuherezi. <verse eid="NUM 18:1" /><verse number="2" style="v" sid="NUM 18:2" />Uze uzane Abalewi bagenzawe bagufashe mu gihe wewe n’abahungu bawe muriko murakora igikorwa canyu imbere y’ihema ry’ibishinga intahe. <verse eid="NUM 18:2" /><verse number="3" style="v" sid="NUM 18:3" />Baze bagukorere bakore ibikorwa vy’ihema, ariko ntibaze begere ibikoresho vyera canke igicaniro, kugira ngo ntihagire uwupfa, yaba wewe canke bo. <verse eid="NUM 18:3" /><verse number="4" style="v" sid="NUM 18:4" />Bazoba abo kugufasha mu gutunganya ivy’Ihema ry’Ibonaniro, ibikorwa vyose bijanye na ryo; kandi nta wundi yemerewe kwegera aho uri.<verse eid="NUM 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 18:5" />Mwebwe muzobazwa ivyo gutunganya ivy’ahera n’igicaniro, kugira ngo ishavu ryanje ntiryongere kuziriringa ku Bisirayeli. <verse eid="NUM 18:5" /><verse number="6" style="v" sid="NUM 18:6" />Ni jewe ubwanje narobanuye bagenzi banyu b’Abalewi ndabakuye mu bandi Bisirayeli nk’ingabire ndabahaye, yeguriwe <char style="nd">Uhoraho</char> kugira ngo bakore ibikorwa vyo mw’ihema ry’ibonaniro. <verse eid="NUM 18:6" /><verse number="7" style="v" sid="NUM 18:7" />Ariko wewe wenyene n’abahungu bawe ni mwebwe muzokora igikorwa c’ubuherezi hamwe n’ibintu vyose bijanye n’igicaniro no hirya ya ca gihuzu gikingiriye ahera. Nabahaye igikorwa c’ubuherezi nk’ingabire. Uwundi muntu wese azokwegera ahera aze yicwe.”<verse eid="NUM 18:7" /></para>
  <para style="s1">Amashikanwa y’abaherezi n’Abalewi</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8" />Nuko <char style="nd">Uhoraho</char> abarira Aroni ati: “Ni jewe ubwanje nakujeje ibimazi vyose banshikanira; ibimazi vyose vyera Abisirayeli banshikanira ndabiguhaye wewe n’abahungu bawe nk’umugabane wawe w’ibihe vyose. <verse eid="NUM 18:8" /><verse number="9" style="v" sid="NUM 18:9" />Muze mwakire umugabane ku bimazi birusha ibindi kwera vyasigaye ku vyo baturiye. Ku mashikanwa banzanira nk’ibimazi bisumba ibindi kwera, ari ivyo ifu canke ibimazi vy’ivyaha canke vyo kwisaba, uwo mugabane uzoba ari uwawe n’abahungu bawe. <verse eid="NUM 18:9" /><verse number="10" style="v" sid="NUM 18:10" />Muze mubirye muzi ko ari ivyera birusha ibindi; abagabo n’abahungu bonyene ni bo bemerewe kubiryako. Muze mubifate nk’ivyera nyene.<verse eid="NUM 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 18:11" />N’ibi na vyo ni ivyanyu: ibizova ku mashikanwa yo kuzungagiza atangwa n’Abisirayeli, ndabiguhaye wewe n’abahungu bawe n’abakobwa bawe nk’umugabane wanyu ibihe vyose. Umuntu wese aba mu nzu yanyu adahumanye yemerewe kubiryako.<verse eid="NUM 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 18:12" />Ndabahaye n’amavuta ya Elayo yose n’umuvinyu mushasha wose n’ingano banshikanira nk’ivyeze imbere y’ibindi mu vyimburwa vyabo. <verse eid="NUM 18:12" /><verse number="13" style="v" sid="NUM 18:13" />Ivyeze imbere y’ibindi mu gihugu banshikanira jewe <char style="nd">Uhoraho</char> bizoba ari ivyanyu. Umuntu wese adahumanye aba mu nzu iwawe yemerewe kubiryako.<verse eid="NUM 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 18:14" />Ivyo Abisirayeli bagereye <char style="nd">Uhoraho</char> vyose ni ivyanyu. <verse eid="NUM 18:14" /><verse number="15" style="v" sid="NUM 18:15" />Icavutse ubwambere cose, ari umuntu canke igitungano, bihawe <char style="nd">Uhoraho</char> vyose ni ivyanyu. Ariko muze mucungure imfura zanyu z’abahungu n’ivy’uburiza vy’ibikoko bizira. <verse eid="NUM 18:15" /><verse number="16" style="v" sid="NUM 18:16" />Mu gihe bimaze ukwezi, muze mubicungure murihe ikiguzi co kubicungura kingana na shekeli zitanu<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">Ni nk’amagarama 58</char></note> z’ifeza, zipimwe hakoreshejwe ingero shekeli y’Ahera, ipima gera mirongo ibiri.<verse eid="NUM 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 18:17" />Ariko ntimuze mucungure iriza ry’ishuri, intama canke impene; bizoba ari ivyera. Muze mumijagire amaraso yavyo ku gicaniro muturire n’ibinure vyavyo nk’ikimazi co guturirwa, ubumote bwiza bunezera <char style="nd">Uhoraho</char>. <verse eid="NUM 18:17" /><verse number="18" style="v" sid="NUM 18:18" />Inyama zavyo zizoba ari izanyu, hamwe n’igikiriza c’ishikanwa ryo kuzugunzwa n’itako ry’i buryo. <verse eid="NUM 18:18" /><verse number="19" style="v" sid="NUM 18:19" />Ndabahaye ivyo Abisirayeli bazanye nk’amashikanwa yera; bizoba ari umugabane wanyu ibihe vyose wewe n’abahungu bawe n’abakobwa bawe, nk’uko isezerano ry’intahava nasezeranye nawe n’uruvyaro rwawe riri.”<verse eid="NUM 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20" />
    <char style="nd">Uhoraho</char> abarira Aroni ati: “Nta shamvu canke umugabane uzoronka mu gihugu nzoha Abisirayeli ngo kibe icabo; ni jewe mugabane n’ubutunzi bwanyu hagati mu bandi Bisirayeli.<verse eid="NUM 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21" />Mpaye Abalewi bose ibigiracumi vyose bivuye mu Bisirayeli nk’umugabane wabo kubera igikorwa bakora kw’ihema ry’ibonaniro. <verse eid="NUM 18:21" /><verse number="22" style="v" sid="NUM 18:22" />Kuva ubu Abisirayeli ntibaze begere ihema ry’ibonaniro, kuko hoba inkurikizi mbi ku caha cabo bagapfa. <verse eid="NUM 18:22" /><verse number="23" style="v" sid="NUM 18:23" />Abalewi ni bo bazokora igikorwa co kw’ihema ry’ibonaniro kandi babazwe amakosa yose yokorwa kuri ryo. Iri rize ribe itegeko ryamaho uko urunganwe ruzogenda rukurikirana n’urundi. Nta mugabane bazoronka mu bandi Bisirayeli. <verse eid="NUM 18:23" /><verse number="24" style="v" sid="NUM 18:24" />Ariko, mpaye Abalewi nk’umugabane wabo ibigiracumi Abisirayeli bashikanira <char style="nd">Uhoraho</char>. Ni co gituma nabavuzeko nti: ‘Ntibazoronka umugabane mu Bisirayeli.’ ”<verse eid="NUM 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 18:25" /><verse number="26" style="v" sid="NUM 18:26" />“Vugana n’Abalewi ubabwire uti: ‘Nimwakira ivyo bigiracumi ndabahaye nk’umugabane wanyu, muze mutange ikigiracumi c’ivyo mwakiriye nk’ishikanwa mushikaniye <char style="nd">Uhoraho</char>. <verse eid="NUM 18:26" /><verse number="27" style="v" sid="NUM 18:27" />Iryo shikanwa ryanyu rizoba ari nk’ishikanwa ry’ingano canke ry’ibinyobwa abandi batanga babikuye mu vyimburwa vyabo no mu mato yabo baganiramwo inzabibu. <verse eid="NUM 18:27" /><verse number="28" style="v" sid="NUM 18:28" />Uko ni ko namwe muzotanga ishikanwa k’<char style="nd">Uhoraho</char> rivuye mu bigiracumi muronka bivuye mu Bisirayeli. Kuri ivyo bigiracumi muze mutange umugabane w’<char style="nd">Uhoraho</char> uhabwa Aroni umuherezi. <verse eid="NUM 18:28" /><verse number="29" style="v" sid="NUM 18:29" />Muze mutange nk’umugabane w’<char style="nd">Uhoraho</char> umugabane urusha iyindi kwera ku bintu vyose muhawe.’<verse eid="NUM 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 18:30" />Bwira Abalewi uti: ‘Nimwashikana uwo mugabane uruta iyindi, uzoba ari nk’icavuye mu vyo mwimbuye ku mbuga no mu bwato muganiramwo. <verse eid="NUM 18:30" /><verse number="31" style="v" sid="NUM 18:31" />Mwebwe n’abo mu mazu iwanyu muze murire ibisigaye aho ari ho hose kuko ari impembo yanyu kubera igikorwa canyu mukora mw’ihema ry’ibonaniro. <verse eid="NUM 18:31" /><verse number="32" style="v" sid="NUM 18:32" />Nimwashikana wa mugabane uruta iyindi ntimuzoba mucumuye kuri ico; aho rero ntimuzohumanya amashikanwa yera y’Abisirayeli, ngo bibazanire gupfa.’ ”<verse eid="NUM 18:32" /></para>
  <chapter eid="NUM 18" />
  <chapter number="19" style="c" sid="NUM 19" />
  <para style="s1">Amazi yo guhumanurwa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1" />
    <char style="nd">Uhoraho</char> abarira Mose na Aroni ati: <verse eid="NUM 19:1" /><verse number="2" style="v" sid="NUM 19:2" />“Ibi ni vyo bisabwa n’Ivyagezwe <char style="nd">Uhoraho</char> yatanze: Ubwire Abisirayeli baze bakuzanire inka ifise ibara ryitwa akagajo itagira agasembwa kandi itigeze ikoreshwa ibikorwa vyo gukwega ingogo. <verse eid="NUM 19:2" /><verse number="3" style="v" sid="NUM 19:3" />Uyihe Eliyazeri umuherezi. Iyo ni iyo kujanwa inyuma y’aho mucumbitse igakerererwa imbere yiwe. <verse eid="NUM 19:3" /><verse number="4" style="v" sid="NUM 19:4" />Nuko Eliyazeri umuherezi aze yakire ku maraso yayo ayamijagire n’urutoke rwiwe incuro indwi atumbereye ku muryango w’Ihema ry’Ibonaniro. <verse eid="NUM 19:4" /><verse number="5" style="v" sid="NUM 19:5" />Akiri ngaho nyene, iyo nka baze bayiturire urusato, inyama, amaraso n’amayezi. <verse eid="NUM 19:5" /><verse number="6" style="v" sid="NUM 19:6" />Umuherezi aze afate igiti c’isederi, ishami rya ezobu n’ubwoya bw’intama busize irangi ritukura, abiterere muri uwo muriro uriko uraturira iyo nka. <verse eid="NUM 19:6" /><verse number="7" style="v" sid="NUM 19:7" />Inyuma y’ivyo, umuherezi aze amesure impuzu ziwe yiyuhagire n’amazi, aho ni ho azoshobora kugaruka aho mucumbitse, ariko azoba agihumanye gushika ku mugoroba. <verse eid="NUM 19:7" /><verse number="8" style="v" sid="NUM 19:8" />N’uwo muntu ayiturira na we nyene aze amesure impuzu ziwe yiyuhagire n’amazi kandi na we nyene azoguma ahumanye gushika ku mugoroba.<verse eid="NUM 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 19:9" />Umuntu azoba adahumanye aze yegeranye umunyota w’iyo nka awushire mu kibanza kidahumanye inyuma y’aho mucumbitse. Uze uzigamwe n’Abisirayeli kugira ngo baze bame bawukoresha mu mazi yo guhumanurwa; ni uwo gukurako ubuhumane bw’ivyaha. <verse eid="NUM 19:9" /><verse number="10" style="v" sid="NUM 19:10" />Uwo muntu azokwegeranya uwo munyota w’iyo nka na we nyene aze amesure impuzu ziwe kandi azogume ahumanye gushika ku mugoroba. Iri rize ribe itegeko ry’intahava ku Bisirayeli no ku banyamahanga baba muri bo.<verse eid="NUM 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11" />Uwuzokora ku muvyimba w’umuntu uwo ari we wese azoba ahumanye imisi indwi yose. <verse eid="NUM 19:11" /><verse number="12" style="v" sid="NUM 19:12" />Aze yihumanure akoresheje ayo mazi yo guhumanurwa ku musi ugira gatatu no ku wugira indwi; ni ho azobona guhumanuka. Ariko natihumanura ku musi ugira gatatu no ku wugira indwi, ntazohumanuka. <verse eid="NUM 19:12" /><verse number="13" style="v" sid="NUM 19:13" />Uwuzokora ku muvyimba w’umuntu uwo ari we wese hanyuma akananirwa no kwihumanura azoba yanduje ahera h’<char style="nd">Uhoraho</char>. Uwo muntu aze akurwe mu Bisirayeli. Kuko atimijagiye ayo mazi ahumanura, azoba ahumanye; kandi ubwo buhumane buzomugumako.<verse eid="NUM 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14" />Iri ni ryo tegeko rigenga uwapfiriye mw’ihema: umuntu wese azokwinjira muri iryo hema n’umuntu wese yari muri ryo bazoba bahumanye imisi indwi yose, <verse eid="NUM 19:14" /><verse number="15" style="v" sid="NUM 19:15" />n’igikoresho cose kiri muri iryo hema kidapfundikijwe umupfundikizo kandi ukomeye kizoba gihumanye.<verse eid="NUM 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 19:16" />Umuntu azoba ari hanze agakora ku muntu yishwe n’inkota canke yishwe n’urupfu rusanzwe, canke agakora kw’igufa ry’umuntu canke ku mva, azoba ahumanye kumara imisi indwi.<verse eid="NUM 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 19:17" />Ku bw’uwo yahumanye, uze ushire umunyota wa ya nka yaturirwa mu rwavya usukemwo amazi meza. <verse eid="NUM 19:17" /><verse number="18" style="v" sid="NUM 19:18" />Hanyuma umuntu azoba adahumanye aze afate ezobu, ayikoze muri ya mazi ayamijagire kw’ihema n’ibikoresho biri muri ryo n’abantu bose bari bahari. Aze ayamijagire na wa muntu wese yakoze kw’igufa ry’umuntu canke ku mva canke ku muntu yishwe canke yapfuye urupfu rusanzwe. <verse eid="NUM 19:18" /><verse number="19" style="v" sid="NUM 19:19" />Ku musi ugira gatatu no ku wugira indwi, aze ayamijagire kuri uwo muntu ahumanye, hanyuma ku musi ugira indwi aze amuhumanure. Uwo muntu ariko arahumanurwa aze amesure impuzu ziwe yiyuhagire n’amazi, maze ku mugoroba w’uwo musi azoba ahumanutse. <verse eid="NUM 19:19" /><verse number="20" style="v" sid="NUM 19:20" />Ariko uwo muntu ahumanye natihumanura, aze akurwe mu bwoko bwanyu, kuko azoba ahumanije ahera h’<char style="nd">Uhoraho</char>. Kubera ya mazi ahumanura atazoba yacucagiwe kuri we, azoba agihumanye. <verse eid="NUM 19:20" /><verse number="21" style="v" sid="NUM 19:21" />Iri ni itegeko ridata igihe kuri bo.</para>
  <para style="p" vid="NUM 19:21">Uwo muntu amijagira ayo mazi ahumanura na we nyene aze amesure impuzu ziwe, n’uwuzokora kuri ayo mazi yo guhumanurwa azoba ahumanye gushika ku mugoroba. <verse eid="NUM 19:21" /><verse number="22" style="v" sid="NUM 19:22" />Ikintu cose uwo ahumanye azokorako kizoba gihumanye, kandi uwuzogikorako wese azoba ahumanye gushika ku mugoroba.”<verse eid="NUM 19:22" /></para>
  <chapter eid="NUM 19" />
  <chapter number="20" style="c" sid="NUM 20" />
  <para style="s1">Amazi ava mu gitandara</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1" />Mu kwezi kwa mbere Abisirayeli bose bashika mu bugaragwa bw’i Zini, baca baguma i Kadeshi. Aho ni ho Miriyamu yapfiriye aca ahambwaho.<verse eid="NUM 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2" />Nuko habura amazi, abantu bahagurukira kugwanya Mose na Aroni. <verse eid="NUM 20:2" /><verse number="3" style="v" sid="NUM 20:3" />Batatira Mose bavuga bati: “Iyo dupfuma dupfira rimwe na benewacu hamwe bagwa imbere y’<char style="nd">Uhoraho</char>! <verse eid="NUM 20:3" /><verse number="4" style="v" sid="NUM 20:4" />Ni kuki mwazanye abantu b’<char style="nd">Uhoraho</char> muri ubu bugaragwa, kugira ngo twebwe n’ibitungwa vyacu dupfire hano? <verse eid="NUM 20:4" /><verse number="5" style="v" sid="NUM 20:5" />Ni kuki mwatuduganye mudukuye muri Egiputa mukatuzana aha hantu habi? Nta ngano, nta misukoni, nta mizabibu canke amakomamanga; kandi nta n’amazi yo kunywa ariho!”<verse eid="NUM 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 20:6" />Mose na Aroni bava imbere y’ikoraniro baja ku muryango w’Ihema ry’Ibonaniro bubama hasi, maze ubwiza bw’<char style="nd">Uhoraho</char> burababonekera. <verse eid="NUM 20:6" /><verse number="7" style="v" sid="NUM 20:7" /><char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 20:7" /><verse number="8" style="v" sid="NUM 20:8" />“Akira ya nkoni yawe, ugende mwe na Aroni mukurwawe ukoranye Abisirayeli bose. Uze ubwire ico gitandara imbere yabo na co kizosuka amazi yaco. Uzokura amazi muri ico gitandara kugira ngo iryo koraniro ryose n’ibitungwa vyabo baze banywe.”<verse eid="NUM 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 20:9" />Nuko Mose afata ya nkoni ayikura imbere y’<char style="nd">Uhoraho</char>, nk’uko yari yamutegetse. <verse eid="NUM 20:9" /><verse number="10" style="v" sid="NUM 20:10" />We na Aroni bakoranya Abisirayeli bose imbere ya ca gitandara hanyuma Mose ababarira ati: “Umvirize yemwe mwa bagarariji mwe! Mbega twoshobora gukura amazi muri iki gitandara ngo munywe?” <verse eid="NUM 20:10" /><verse number="11" style="v" sid="NUM 20:11" />Nuko Mose akiriza ukuboko kwiwe akubita ca gitandara kabiri na ya nkoni yiwe. Amazi aca aradudubiza, abantu baranywa n’ibitungwa vyabo.<verse eid="NUM 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 20:12" />Ariko <char style="nd">Uhoraho</char> abarira Mose na Aroni ati: “Kubera yuko mutanyizigiye bikwiye ngo mumpeshe icubahiro nk’Uwera imbere y’Abisirayeli, ntimuzoshikana ubu bwoko mu gihugu ngiye kubaha.”<verse eid="NUM 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 20:13" />Ayo ni yo mazi y’i Meriba, amazi y’imitongano, aho Abisirayeli batonganije <char style="nd">Uhoraho</char> na we akerekana ukwera kwiwe muri bo.<verse eid="NUM 20:13" /></para>
  <para style="s1">Abanyedomu bima Abisirayeli inzira</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14" />Mose arungika intumwa zivuye i Kadeshi ku mwami wa Edomu abatuma ati:</para>
  <para style="pm" vid="NUM 20:14">“Ibi ni vyo abavukanyi banyu b’Abisirayeli babasavye: Murazi ibihe bigoye twaciyemwo. <verse eid="NUM 20:14" /><verse number="15" style="v" sid="NUM 20:15" />Ba sogokuruza bacu bagiye muri Egiputa, hanyuma tubayo imyaka myinshi cane. Abanyegiputa badukorera ikibi cane twebwe na ba sogokuru bacu, <verse eid="NUM 20:15" /><verse number="16" style="v" sid="NUM 20:16" />ariko tumaze gutakambira <char style="nd">Uhoraho</char>, aratwumva aca atuma umumarayika adukura muri Egiputa.</para>
  <para style="pm" vid="NUM 20:16">Ubu rero turi ngaha i Kadeshi, igisagara kiri ku rubibe rw’igihugu canyu. <verse eid="NUM 20:16" /><verse number="17" style="v" sid="NUM 20:17" />Nimutureke duce mu gihugu canyu. Ntituzoca mu murima n’umwe canke mu mizabibu, canke ngo tunywe amazi yo mw’iriba na rimwe. Tuzoca mw’Ibarabara ry’Umwami tudahindukira i buryo canke i bubamfu kugeza turenganye igihugu canyu.”<verse eid="NUM 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 20:18" />Ariko Abanyedomu babishura bati:</para>
  <para style="pm" vid="NUM 20:18">“Ntimuze muce hano; nimwanabigerageza, tuzosohoka tubatere tubagwanishe inkota.”<verse eid="NUM 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 20:19" />Abisirayeli babishura bati:</para>
  <para style="pm" vid="NUM 20:19">“Tuzokwijanira ibarabara rikuru, kandi yaba twebwe canke ibitungwa vyacu bizonywa ku mazi yanyu, tuzoyariha. Ico tugomba ni ukurengana nta kindi.”<verse eid="NUM 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 20:20" />Barasubira babishura bati:</para>
  <para style="pm" vid="NUM 20:20">“Ntimuze muce hano.”</para>
  <para style="p" vid="NUM 20:20">Nuko Abanyedomu baraza kubatangira ngo babagwanye bafise ingabo nyinshi kandi zikomeye. <verse eid="NUM 20:20" /><verse number="21" style="v" sid="NUM 20:21" />Abanyedomu bamaze kubima inzira ngo bace mu gihugu cabo, Abisirayeli barahindukira bicira ahandi.<verse eid="NUM 20:21" /></para>
  <para style="s1">Urupfu rwa Aroni</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22" />Nuko Abisirayeli bose bava i Kadeshi baja ku musozi Hori. <verse eid="NUM 20:22" /><verse number="23" style="v" sid="NUM 20:23" />Kuri uwo musozi Hori, hafi y’urugabano rwa Edomu, <char style="nd">Uhoraho</char> abarira Mose na Aroni ati: <verse eid="NUM 20:23" /><verse number="24" style="v" sid="NUM 20:24" />“Aroni agiye gupfa ahamvye ab’iwabo. Ntazokwinjira mu gihugu ngiye guha Abisirayeli, kuko mwempi mwagararije itegeko ryanje ku mazi y’i Meriba. <verse eid="NUM 20:24" /><verse number="25" style="v" sid="NUM 20:25" />Twara Aroni n’umuhungu wiwe Eliyazeri ku musozi Hori. <verse eid="NUM 20:25" /><verse number="26" style="v" sid="NUM 20:26" />Wambure Aroni impuzu ziwe uzambike umuhungu wiwe Eliyazeri, kuko Aroni agiye guhamvya ab’iwabo, azopfira aho nyene.”<verse eid="NUM 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 20:27" />Mose akora nk’uko <char style="nd">Uhoraho</char> yamutegetse: Baduga wa musozi Hori ishengero ryose ribaraba. <verse eid="NUM 20:27" /><verse number="28" style="v" sid="NUM 20:28" />Mose yambura Aroni za mpuzu ziwe azambika umuhungu wiwe Eliyazeri. Maze Aroni apfira aho nyene ku gatwe k’uwo musozi. Mose na Eliyazeri bamanuka wa musozi, <verse eid="NUM 20:28" /><verse number="29" style="v" sid="NUM 20:29" />abantu bose bamaze kumenya ko Aroni yapfuye, Abisirayeli bose baramugandarira imisi mirongo itatu.<verse eid="NUM 20:29" /></para>
  <chapter eid="NUM 20" />
  <chapter number="21" style="c" sid="NUM 21" />
  <para style="s1">Abanyakanani batsindwa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1" />Umwami w’Umunyakanani yaganza ahitwa Aradi, yaba i Negebu, yumva ko Abisirayeli bariko baraza baciye mu nzira ija i Atarimu, aca atera Abisirayeli kandi afata bamwe muri bo abagira imbohe. <verse eid="NUM 21:1" /><verse number="2" style="v" sid="NUM 21:2" />Nuko Abisirayeli basezerana iri sezerano imbere y’<char style="nd">Uhoraho</char> bati: “Niwagabura aba bantu mu maboko yacu, natwe tuzosambura rwose ibisagara vyabo.” <verse eid="NUM 21:2" /><verse number="3" style="v" sid="NUM 21:3" /><char style="nd">Uhoraho</char> yumva ugutakamba kwabo aca agabura abo Banyakanani mu maboko yabo. Baca barabarandura bose mbere basambura n’ibisagara vyabo vyose. Aho hantu haca hitwa Horuma risigura “imisaka”.<verse eid="NUM 21:3" /></para>
  <para style="s1">Inzoka y’umwakaka</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4" />Baragenda bava ku musozi Hori bajana inzira ija ku Kiyaga Gitukura, kugira ngo bazunguruke ntibace mu gihugu ca Edomu. Ariko abantu barambirwa n’urugendo; <verse eid="NUM 21:4" /><verse number="5" style="v" sid="NUM 21:5" />batangura kuvuga nabi Imana na Mose bati: “Ni kuki mwadukuye muri Egiputa ngo tuze gupfira mu bugaragwa? Nta vyokurya bihari! Nta mazi ahari! Kandi n’ibi vyokurya manu bitagira ikimazi vyatuduhiye!”<verse eid="NUM 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 21:6" />Nuko <char style="nd">Uhoraho</char> arungika inzoka z’ubumara muri bo; zirabakomora Abisirayeli benshi barapfa. <verse eid="NUM 21:6" /><verse number="7" style="v" sid="NUM 21:7" />Abantu baza aho Mose yari ari bamubarira bati: “Twacumuye kuko twavuze nabi <char style="nd">Uhoraho</char> na wewe. Dusengere <char style="nd">Uhoraho</char> adukuremwo izi nzoka.” Nuko Mose aca arabasengera.<verse eid="NUM 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 21:8" />
    <char style="nd">Uhoraho</char> abarira Mose ati: “Kora inzoka uyimanike ku giti; umuntu wese yakomowe n’inzoka niyayiraba arakira.” <verse eid="NUM 21:8" /><verse number="9" style="v" sid="NUM 21:9" />Nuko Mose acura inzoka mu mwakaka ayimanika ku giti. Maze umuntu wese yari yakomowe n’inzoka, aravye ya nzoka y’umuringa, yaca akira.<verse eid="NUM 21:9" /></para>
  <para style="s1">Bagenda i Mowabu</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10" />Maze Abisirayeli barunguruza bacumbika i Oboti. <verse eid="NUM 21:10" /><verse number="11" style="v" sid="NUM 21:11" />Mu nyuma barunguruza bava i Oboti bacumbika muri Iye Abarimu, mu bugaragwa buri mu buseruko bwa Mowabu. <verse eid="NUM 21:11" /><verse number="12" style="v" sid="NUM 21:12" />Bava ngaho barunguruza bacumbika mu kiyaya ca Zeredi. <verse eid="NUM 21:12" /><verse number="13" style="v" sid="NUM 21:13" />Bava aho barabandanya bacumbika ku nkengera za Arunoni. Urwo ruzi Arunoni ni rwo rwagabura igihugu ca Mowabu n’ic’Abamori. <verse eid="NUM 21:13" /><verse number="14" style="v" sid="NUM 21:14" />Ni co gituma mu gitabu c’ivy’Intambara z’<char style="nd">Uhoraho</char> hariho ahavuga ngo:</para>
  <para style="q1" vid="NUM 21:14">“Wahebu muri Sufa n’imigezi yisuka muri rwo,</para>
  <para style="q2" vid="NUM 21:14">Arunoni <verse eid="NUM 21:14" /><verse number="15" style="v" sid="NUM 21:15" />n’imigezi yisuka muri rwo</para>
  <para style="q1" vid="NUM 21:15">inkombe zarwo zo kuri Ari</para>
  <para style="q2" vid="NUM 21:15">ni zo rubibe rwa Mowabu.”<verse eid="NUM 21:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 21:16" />Bava ngaho barabandanya no kuri Beyeri, iriba riri aho <char style="nd">Uhoraho</char> yabwiriye Mose ati: “Koranya abantu nanje ngiye kubaha amazi.”<verse eid="NUM 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 21:17" />Nuko Abisirayeli baririmba indirimbo ivuga ngo:</para>
  <para style="q1" vid="NUM 21:17">“Dudubiza, wa riba!</para>
  <para style="q2" vid="NUM 21:17">Nimuriririmbe<verse eid="NUM 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 21:18" />rya riba ryimbwa n’abaganwa,</para>
  <para style="q2" vid="NUM 21:18">ryatobowe n’abanyacubahiro</para>
  <para style="q2" vid="NUM 21:18">bakoresheje amacumu yabo n’inkoni zabo.”</para>
  <para style="m" vid="NUM 21:18">Nuko bava mu bugaragwa baja i Matana, <verse eid="NUM 21:18" /><verse number="19" style="v" sid="NUM 21:19" />Bava i Matana baja i Nahaliyeli, bava i Nahaliyeli baja i Bamoti, <verse eid="NUM 21:19" /><verse number="20" style="v" sid="NUM 21:20" />bavuye i Bamoti baja mu kiyaya c’i Mowabu aho umuntu ashobora kubona ubugaragwa ari ku gatwe k’umusozi wa Pisiga.<verse eid="NUM 21:20" /></para>
  <para style="s1">Ukuneshwa kwa Sihoni na Ogi</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21" />Abisirayeli barungika intumwa kubwira Sihoni umwami w’Abamori bati:<verse eid="NUM 21:21" /></para>
  <para style="pm">
    <verse number="22" style="v" sid="NUM 21:22" />“Nimutureke duce mu gihugu canyu. Ntituzohindukira ngo turabe ku ruhande mu mirima yanyu canke mu nzabibu zanyu, canke ngo tunywe amazi yo mu mariba yanyu. Tuzokwicira mw’Ibarabara ry’Umwami, gushika twirenganiye tukava mu gihugu canyu.”<verse eid="NUM 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 21:23" />Ariko Sihoni ntiyemerera Abisirayeli guca mu gihugu ciwe. Aca akoranya ingabo ziwe zose aja mu bugaragwa gutera Abisirayeli; ashitse i Yahazi, agwana na bo. <verse eid="NUM 21:23" /><verse number="24" style="v" sid="NUM 21:24" />Abisirayeli baramugwanya baramunesha babamarisha inkota bafata n’igihugu ciwe kuva ku ruzi Arunoni gushika kuri Yaboki, gushika ku rubibe rwo mu buseruko bw’Abamoni, kuko urwo rubibe rwari ruzitijwe inzitiro. <verse eid="NUM 21:24" /><verse number="25" style="v" sid="NUM 21:25" />Bafata ibisagara vyose vy’Abamori, harimwo Heshiboni n’imihana yose ihakikuje. <verse eid="NUM 21:25" /><verse number="26" style="v" sid="NUM 21:26" />Heshiboni cari igisagara ca Sihoni umwami w’Abamori, uwo yari yaragwanye n’umwami yahora aganza i Mowabu aca afata ico gihugu ciwe gushika ku ruzi rwa Arunoni.<verse eid="NUM 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 21:27" />Ni co gituma abavuga ivyese bavuze ngo:</para>
  <para style="q1" vid="NUM 21:27">“Nimuze i Heshiboni muhubake;</para>
  <para style="q2" vid="NUM 21:27">igisagara ca Sihoni nigisubire cubakwe.<verse eid="NUM 21:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="NUM 21:28" />Umuriro wadutse uva muri Heshiboni</para>
  <para style="q2" vid="NUM 21:28">urubeya rwavuye mu gisagara ca Sihoni.</para>
  <para style="q1" vid="NUM 21:28">Rwaturiye muri Ari ahantu ho muri Mowabu,</para>
  <para style="q2" vid="NUM 21:28">N’abanyagihugu baba ku nkengera za Arunoni.<verse eid="NUM 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 21:29" />Uragowe, yewe Mowabu!</para>
  <para style="q2" vid="NUM 21:29">Murasambuwe, yemwe bantu basenga Kemoshi!</para>
  <para style="q1" vid="NUM 21:29">Abahungu babo babaye impunzi</para>
  <para style="q2" vid="NUM 21:29">n’abakobwa babaye inyagano,</para>
  <para style="q2" vid="NUM 21:29">za Sihoni umwami w’Abamori.<verse eid="NUM 21:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="NUM 21:30" />Ariko twarashe imyampi ku Bamori;</para>
  <para style="q2" vid="NUM 21:30">I Heshiboni hasambuwe, gushika i Diboni.</para>
  <para style="q1" vid="NUM 21:30">Twahasambuye gushika i Nofa,</para>
  <para style="q2" vid="NUM 21:30">mbere n’Umuriro wararurumvye gushika i Medeba.”<verse eid="NUM 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31" />Nuko Abisirayeli baca bashinga amahema mu gihugu c’Abamori.<verse eid="NUM 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 21:32" />Mose amaze kurungika abatasi mu gisagara c’i Yazeri, Abisirayeli baca bafata ibigwati bihakikuje basohora Abamori bari muri vyo. <verse eid="NUM 21:32" /><verse number="33" style="v" sid="NUM 21:33" />Nuko barahindukira bafata inzira iduga ija i Bashani; maze Ogi, umwami w’i Bashani, n’ingabo ziwe zose baza guhura na bo kugira ngo bagwanire ahitwa Edireyi.<verse eid="NUM 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 21:34" />
    <char style="nd">Uhoraho</char> abarira Mose ati: “Ntimumutinye kuko namutanze mu maboko yanyu, we n’ingabo ziwe zose n’igihugu ciwe. Muze mumukorere nk’ivyo mwakoreye Sihoni umwami w’Abamori, yaganza i Heshiboni.”<verse eid="NUM 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 21:35" />Nuko baramugwanya baramunesha, n’abahungu biwe bose n’ingabo ziwe zose, ntibasigaza umuntu n’umwe. Baca begukira igihugu ciwe.<verse eid="NUM 21:35" /></para>
  <chapter eid="NUM 21" />
  <chapter number="22" style="c" sid="NUM 22" />
  <para style="s1">Balaki atumako Balamu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1" />Nuko Abisirayeli bagenda berekeye ku kiyaya c’i Mowabu, baca bacumbika ku nkengera y’uruzi Yorodani hakurya y’i Yeriko.<verse eid="NUM 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 22:2" />Maze Balaki mwene Zipori abona ivyo Abisirayeli bakoreye Abamori, <verse eid="NUM 22:2" /><verse number="3" style="v" sid="NUM 22:3" />Abanyamowabu baca bagira ubwoba bwinshi kuko Abisirayeli bari benshi. Kandi vy’ukuri Abanyamowabu baciye bihebura kubera Abisirayeli.<verse eid="NUM 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 22:4" />Nuko Abanyamowabu babarira abatware b’i Midiyani bati: “Iri sinzi ry’aba bantu bagiye kurigata ibintu vyose bidukikuje, baturigate nk’uko inka irisha ubwatsi.”</para>
  <para style="p" vid="NUM 22:4">Nuko Balaki mwene Zipori ari we yari umwami w’i Mowabu muri ico gihe, <verse eid="NUM 22:4" /><verse number="5" style="v" sid="NUM 22:5" />Arungika intumwa guhamagara Balamu mwene Beyori, yari i Petori, hafi y’uruzi Efurate, iyo yavuka. Balaki aravuga ati:</para>
  <para style="pm" vid="NUM 22:5">“Hari abantu bavuye muri Egiputa; buzuye igihugu cose kandi begereye aho ndi. <verse eid="NUM 22:5" /><verse number="6" style="v" sid="NUM 22:6" />Nuko rero nuze ubamvumire, kuko bandusha inkomezi. Kumbure noshobora kubanesha nkabasohora mu gihugu canje. Kuko nzi ko abo uhezagiye bahezagirwa, abo uvumye bakabako umuvumo.”<verse eid="NUM 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7" />Maze za ntumwa zari zigizwe n’abakuru b’i Mowabu n’i Midiyani baragenda, batwaye n’ingemu. Bashitse kwa Balamu, bamubarira ivyo Balaki yabatumye.<verse eid="NUM 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 22:8" />Balamu ababarira ati: “Nimurare ngaha, nanje nzobabwira inyishu <char style="nd">Uhoraho</char> azompa.” Nuko abo bakuru b’i Mowabu bagumana na we.<verse eid="NUM 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 22:9" />Maze Imana iraza ibaza Balamu iti: “Abo bantu muri kumwe ni ba nde?”<verse eid="NUM 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 22:10" />Balamu yishura Imana ati: “Balaki mwene Zipori, umwami w’i Mowabu, yantumyeko ubutumwa buvuga ngo: <verse eid="NUM 22:10" /><verse number="11" style="v" sid="NUM 22:11" />‘Abantu bavuye muri Egiputa buzuye igihugu cose. None nuze ubamvumire. Kumbure noshobora kubagwanya no kubirukana mu gihugu.’ ”<verse eid="NUM 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 22:12" />Ariko Imana ica ibwira Balamu iti: “Ntujane na bo. Ntuze uvume abo bantu kuko bahezagiwe.”<verse eid="NUM 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 22:13" />Bukeye mu gitondo Balamu aravyuka abarira ba bakuru ba Balaki ati: “Nimusubire mu gihugu canyu, kuko <char style="nd">Uhoraho</char> yanse ko njana namwe.”<verse eid="NUM 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 22:14" />Maze ba bakuru b’i Mowabu basubira kuri Balaki baramubwira bati: “Balamu yanse kuzanana natwe.”<verse eid="NUM 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15" />Hanyuma Balaki atuma abandi bakuru benshi kuruta ba bandi babarusha n’icubahiro. <verse eid="NUM 22:15" /><verse number="16" style="v" sid="NUM 22:16" />Bashika kwa Balamu baramubwira bati:</para>
  <para style="pm" vid="NUM 22:16">“Balaki mwene Zipori avuze ngo: Ntihagire ikikubuza kuza iwanje, <verse eid="NUM 22:16" /><verse number="17" style="v" sid="NUM 22:17" />kuko nzoguha impembo ishimishije kandi nzokora ico uzombwira cose. Nuze umvumire aba bantu.”<verse eid="NUM 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 22:18" />Ariko Balamu arabishura ati: “Naho Balaki yompa inzahabu n’ifeza vyuzuye inzu yiwe, sinokora ikintu na kimwe, caba kinini canke gito, ngo ndenge kw’itegeko ry’<char style="nd">Uhoraho</char> Imana yanje. <verse eid="NUM 22:18" /><verse number="19" style="v" sid="NUM 22:19" />Nuko nimurare hano nk’uko abandi bagize, nanje menye ico <char style="nd">Uhoraho</char> ari bumbarire.”<verse eid="NUM 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 22:20" />Iryo joro Imana iraza ibaza Balamu iti: “Aba bantu ko baje kuguhamagara, jana na bo, ariko uze ukore ico nzokubwira gusa.”<verse eid="NUM 22:20" /></para>
  <para style="s1">Indogoba ya Balamu</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21" />Balamu avyuka mu gitondo, ategura indogoba yiwe ajana n’abo bakuru b’i Mowabu. <verse eid="NUM 22:21" /><verse number="22" style="v" sid="NUM 22:22" />Ariko Imana ishavuzwa cane n’uko Balamu agiye, maze umumarayika w’<char style="nd">Uhoraho</char> ahagarara mu nzira ngo amutangire. Balamu yari ku ndogoba yiwe, kandi yari kumwe n’abakozi biwe babiri. <verse eid="NUM 22:22" /><verse number="23" style="v" sid="NUM 22:23" />Ya ndogoba ibona wa mumarayika w’<char style="nd">Uhoraho</char> ahagaze mu nzira afise inkota isokoye mu rwubati, ica irakevya ija mw’ishamba; ariko Balamu arayikubita ayisubiza mu nzira.<verse eid="NUM 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 22:24" />Nuko wa mumarayika w’<char style="nd">Uhoraho</char> ahagarara ahantu inzira yaga hagati y’imizabibu ibiri, hari impome zibiri ku mpande zose. <verse eid="NUM 22:24" /><verse number="25" style="v" sid="NUM 22:25" />Ya ndogoba ibonye wa mumarayika w’<char style="nd">Uhoraho</char>, igerageza kumuca i ruhande yegera uruzitiro ruri ku nzira, ica ifyondera ikirenge ciwe kuri rwa ruzitiro. Nuko aca arasubira arayikubita.<verse eid="NUM 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 22:26" />Maze wa mumarayika w’<char style="nd">Uhoraho</char> arasubira yigira imbere ahagarara aho inzira yaga ata ho ishobora gukebereza, haba i buryo canke i bubamfu. <verse eid="NUM 22:26" /><verse number="27" style="v" sid="NUM 22:27" />Ya ndogoba ibonye wa mumarayika w’<char style="nd">Uhoraho</char>, ica iryama hasi Balamu akiri kuri yo, na we aca arashavura cane aca arayikubita. <verse eid="NUM 22:27" /><verse number="28" style="v" sid="NUM 22:28" />Nuko <char style="nd">Uhoraho</char> yugurura akanwa ka ya ndogoba, ibwira Balamu iti: “Mbega nagukoreye iki ko umaze kunkubita gatatu kose?”<verse eid="NUM 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 22:29" />Balamu yishura iyo ndogoba ati: “Wankinishije! Iyo mba mfise inkota, mba ndakwishe ubu nyene!”<verse eid="NUM 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 22:30" />Ya ndogoba yishura Balamu iti: “Mbega sindi indogoba yawe, iyo wahora ugenderako, gushika uwu musi? Mbega nari bwagukorere nk’ibi?”</para>
  <para style="p" vid="NUM 22:30">Arishura ati: “Oya.”<verse eid="NUM 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31" />Nuko <char style="nd">Uhoraho</char> yugurura amaso ya Balamu, abona wa mumarayika w’<char style="nd">Uhoraho</char> ahagaze mu nzira yasokoye inkota mu rwubati. Aca arunama aryama hasi.<verse eid="NUM 22:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 22:32" />Wa mumarayika w’<char style="nd">Uhoraho</char> aramubaza ati: “Wakubitiye iki iyo ndogoba yawe gatatu kose? Nzanywe no kugutangira kuko inzira uriko urajana itari yo mu maso yanje. <verse eid="NUM 22:32" /><verse number="33" style="v" sid="NUM 22:33" />Indogoba yambonye ica irakevya gatatu kose. Iyo idakevya, ubu mba nakwishe, ariko yo nkayireka.”<verse eid="NUM 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 22:34" />Balamu yishura Umumarayika w’<char style="nd">Uhoraho</char> ati: “Nacumuye. Sinamenye ko uhagaze mu nzira ngo untangire. Ubu niwaba udashaka ko ngenda, nca nsubira inyuma.”<verse eid="NUM 22:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35" />Uwo mumarayika w’<char style="nd">Uhoraho</char> abarira Balamu ati: “Jana n’abo bantu, ariko uzovuga ivyo nkubwira gusa.” Nuko Balamu ajana n’abo bakuru ba Balaki.<verse eid="NUM 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36" />Balaki amenye ko Balamu ariko araza, arasohoka aja kumusanganira mu gisagara c’Abanyamowabu kiri ku nkengera ya Arunoni, ku rubibe rw’igihugu ciwe. <verse eid="NUM 22:36" /><verse number="37" style="v" sid="NUM 22:37" />Balaki abarira Balamu ati: “Mbega ko nagutumyeko ubutumwa bwihutirwa ntuze? Ni kubera iki utaje kare? Mbega wibaza ko ntashoboye kuguha ingero ikwiye?”<verse eid="NUM 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 22:38" />Balamu arishura ati: “Ehe ndaje ubu, ariko sinshobora kuvuga ico nishakiye. Nja kuvuga ivyo Imana ija gushira mu kanwa kanje gusa.”<verse eid="NUM 22:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 22:39" />Nuko Balamu ajana na Balaki i Kiriyati-Huzoti. <verse eid="NUM 22:39" /><verse number="40" style="v" sid="NUM 22:40" />Balaki atanga ibimazi vy’inka n’intama, bimwe abiha Balamu na ba bakuru bari kumwe na we. <verse eid="NUM 22:40" /><verse number="41" style="v" sid="NUM 22:41" />Bukeye mu gitondo Balaki atwara Balamu ku musozi Bamoti-Bayali, aho ashobora kubona igice c’Abisirayeli.<verse eid="NUM 22:41" /></para>
  <chapter eid="NUM 22" />
  <chapter number="23" style="c" sid="NUM 23" />
  <para style="s1">Balamu avugishwa ubwa mbere</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1" />Balamu aravuga ati: “Nyubakira ibicaniro indwi ngaha, munzanire n’impfizi indwi z’inka n’izindi indwi z’intama” <verse eid="NUM 23:1" /><verse number="2" style="v" sid="NUM 23:2" />Balaki akora nk’uko Balamu avuze, hanyuma bompi batangira impfizi y’inka n’impfizi y’intama ku gicaniro cose.<verse eid="NUM 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 23:3" />Nuko Balamu abarira Balaki ati: “Guma ngaha hafi y’ikimazi cawe nanje ngiye harya hirya ndabe ko <char style="nd">Uhoraho</char> hari ico yombwira. Ico ampishurira cose ndakikubwira.” Nuko Balamu aca araduga aja ku gatwe k’umusozi ata co kamerako.<verse eid="NUM 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 23:4" />Imana ibonana na we, maze Balamu aravuga ati: “Nateguye ibicaniro indwi, kandi natangiye ku gicaniro cose impfizi y’inka n’iy’intama.”<verse eid="NUM 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 23:5" />
    <char style="nd">Uhoraho</char> aramubwira ati: “Subira kwa Balaki umubwire ubu butumwa.”<verse eid="NUM 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 23:6" />Nuko asubira kwa Balaki amusanga i ruhande ya ca kimazi ciwe, ari kumwe na ba baganwa b’i Mowabu. <verse eid="NUM 23:6" /><verse number="7" style="v" sid="NUM 23:7" />Nuko Balamu atangura kuvugishwa ati:</para>
  <para style="q1" vid="NUM 23:7">“Balaki yanzanye ankuye muri Aramu,</para>
  <para style="q2" vid="NUM 23:7">umwami w’i Mowabu yankuye mu misozi yo mu buseruko.</para>
  <para style="q1" vid="NUM 23:7">Ati: ‘Nuze, umvumire aba Yakobo;</para>
  <para style="q2" vid="NUM 23:7">vuga ivy’ibibi ku Bisirayeli.’<verse eid="NUM 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8" />Novuma nte</para>
  <para style="q2" vid="NUM 23:8">Abo Imana itavumye?</para>
  <para style="q1" vid="NUM 23:8">Novuga gute ibibi</para>
  <para style="q2" vid="NUM 23:8">ku bantu <char style="nd">Uhoraho</char> atavugako ibibi?<verse eid="NUM 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9" />Ndi ku dutwe tw’agasozi k’amabuye nababona,</para>
  <para style="q2" vid="NUM 23:9">ndi hejuru ku misozi, nabitegereza.</para>
  <para style="q1" vid="NUM 23:9">Mbona ari ihanga ryibera ukwaryo</para>
  <para style="q2" vid="NUM 23:9">ritandukanye n’ayandi mahanga.<verse eid="NUM 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10" />Ni nde yoharura umukungugu wa bene Yakobo?</para>
  <para style="q2" vid="NUM 23:10">Ngo adondagure isinzi ry’Abisirayeli?</para>
  <para style="q1" vid="NUM 23:10">Uzompe gupfa urupfu rw’abagororotsi,</para>
  <para style="q2" vid="NUM 23:10">kandi n’iherezo ryanje rize ribe nk’iryabo!”<verse eid="NUM 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11" />Balaki abarira Balamu ati: “Unkoreye ibiki? Nakuzanye kumvumira abansi banje, none nta kindi uriko urakora atari ukubahezagira!”<verse eid="NUM 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 23:12" />Aramwishura ati: “Mbega sinkwiye kuvuga ivyo <char style="nd">Uhoraho</char> ashize mu kanwa kanje?”<verse eid="NUM 23:12" /></para>
  <para style="s1">Balamu avugishwa ubwa kabiri</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13" />Nuko Balaki aramubwira ati: “Ingo tujane ahandi aho ushobora kubabona bose. Aha ubona igice cabo gusa ariko ntushobora kubabona bose. Aho ni ho uca ubamvumira.” <verse eid="NUM 23:13" /><verse number="14" style="v" sid="NUM 23:14" />Nuko amujana ku kibuga co gushibamako c’i Zofimu ku gatwe k’umusozi Pisiga, ahubaka ibicaniro indwi abituririrako impfizi y’inka n’impfizi y’intama kuri kimwekimwe cose.<verse eid="NUM 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 23:15" />Balamu abarira Balaki ati: “Guma ngaha hafi y’ikimazi cawe nanje ngiye guhura n’<char style="nd">Uhoraho</char> hariya.”<verse eid="NUM 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 23:16" />
    <char style="nd">Uhoraho</char> ahura na Balamu ashira mu kanwa kiwe ivyo aja kuvuga, aca aramubwira ati: “Subira aho Balaki ari umushire ubu butumwa.”<verse eid="NUM 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 23:17" />Nuko aja iyo Balaki ari amusanga agihagaze i ruhande ya vya bimazi vyiwe, ari kumwe na ba bakuru b’i Mowabu. Balaki aramubaza ati: “<char style="nd">Uhoraho</char> yavuze iki?”<verse eid="NUM 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 23:18" />Maze Balamu atangura kuvugishwa ati:</para>
  <para style="q1" vid="NUM 23:18">“Haguruka, Balaki wumvirize;</para>
  <para style="q2" vid="NUM 23:18">nunyumve, yewe mwene Zipori.<verse eid="NUM 23:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19" />Imana si umuntu,</para>
  <para style="q1" vid="NUM 23:19">ngo ibeshe,</para>
  <para style="q1" vid="NUM 23:19">canke umwana w’umuntu,</para>
  <para style="q1" vid="NUM 23:19">ngo yivuguruze.</para>
  <para style="q1" vid="NUM 23:19">Iyo ivuze ikintu, iragikora;</para>
  <para style="q2" vid="NUM 23:19">iyo isezeranye, irashitsa isezerano.<verse eid="NUM 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20" />Nategetswe guhezagira;</para>
  <para style="q2" vid="NUM 23:20">Imana yarahezagiye, nanje sinoshobora kubihindura.<verse eid="NUM 23:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21" />Nta kibi yabonye mu ba Yakobo,</para>
  <para style="q2" vid="NUM 23:21">nta karenganyo yabonye mu Bisirayeli.</para>
  <para style="q1" vid="NUM 23:21">
    <char style="nd">Uhoraho</char> Imana yabo iri kumwe na bo;</para>
  <para style="q2" vid="NUM 23:21">impundu y’Umwami yumvikana muri bo.<verse eid="NUM 23:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22" />Imana yabakuye muri Egiputa;</para>
  <para style="q2" vid="NUM 23:22">bafise inkomezi nk’iz’imbogo.<verse eid="NUM 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23" />Nta muvumo ushobora gushika ku ba Yakobo,</para>
  <para style="q2" vid="NUM 23:23">nta bupfumu bwogira ico bumara ku Bisirayeli.</para>
  <para style="q1" vid="NUM 23:23">Guhera ubu bizohora bivugwa kuri Yakobo</para>
  <para style="q2" vid="NUM 23:23">no kuri Isirayeli ngo: ‘Raba ivyo Imana yakoze!’<verse eid="NUM 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24" />Iryo hanga rihaguruka nk’intambwe y’ingore;</para>
  <para style="q2" vid="NUM 23:24">bahaguruka nk’intare</para>
  <para style="q1" vid="NUM 23:24">itaruhuka itaratabagura ico yishe</para>
  <para style="q2" vid="NUM 23:24">kandi itaranywa amaraso y’ivyo yahize.”<verse eid="NUM 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25" />Nuko Balaki abarira Balamu ati: “Nimba udashaka kubavuma reka no kubahezagira!”<verse eid="NUM 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 23:26" />Balamu arishura ati: “Sinakubwiye ko ntegerezwa gukora ivyo <char style="nd">Uhoraho</char> avuze?”<verse eid="NUM 23:26" /></para>
  <para style="s1">Balamu avugishwa ubugira gatatu</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27" />Balaki abarira Balamu ati: “Nuze ndakujane ahandi. Kumbure bizohimbara Imana ikureke ubamvumire uri ngaho.” <verse eid="NUM 23:27" /><verse number="28" style="v" sid="NUM 23:28" />Balaki ajana Balamu ku gatwe k’umusozi wa Peyori, hahanamiye ubugaragwa.<verse eid="NUM 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 23:29" />Balamu aravuga ati: “Nyubakira ibicaniro indwi ngaha, untegurire impfizi indwi z’inka n’impfizi z’intama indwi.” <verse eid="NUM 23:29" /><verse number="30" style="v" sid="NUM 23:30" />Balaki akora nk’uko Balamu yavuze, aca ashikana impfizi y’inka n’iy’intama ku gicaniro cose.<verse eid="NUM 23:30" /></para>
  <chapter eid="NUM 23" />
  <chapter number="24" style="c" sid="NUM 24" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1" />Maze Balamu abonye ko <char style="nd">Uhoraho</char> yashimye guhezagira Abisirayeli, ntiyagenda hirya kurondera uguhishurirwa n’<char style="nd">Uhoraho</char> nk’uko yari yamye abikora ubwa mbere, ariko arahindukira yerekeza amaso mu bugaragwa. <verse eid="NUM 24:1" /><verse number="2" style="v" sid="NUM 24:2" />Maze Balamu araramuye amaso abona Abisirayeli bacumbitse bakurikije uko imiryango yabo imeze, Mpwemu w’Imana amuzako <verse eid="NUM 24:2" /><verse number="3" style="v" sid="NUM 24:3" />aca aravugishwa ati:</para>
  <para style="q1" vid="NUM 24:3">“Uku ni ko Balamu mwene Beyori avuga,</para>
  <para style="q2" vid="NUM 24:3">uku ni ko uwubona neza avuga,<verse eid="NUM 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NUM 24:4" />Uku ni ko uwumva amajambo y’Imana avuga,</para>
  <para style="q2" vid="NUM 24:4">uwubona ivyo yeretswe n’Iyishoboravyose,</para>
  <para style="q2" vid="NUM 24:4">uwubama hasi, amaso yiwe akuguruka:<verse eid="NUM 24:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="NUM 24:5" />Ese ingene amahema yawe ari meza, yewe Yakobo,</para>
  <para style="q2" vid="NUM 24:5">amazu wiberamwo, yewe Isirayeli!<verse eid="NUM 24:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="NUM 24:6" />Bimeze nk’inzuzi zitemba,</para>
  <para style="q2" vid="NUM 24:6">ni nk’imirima itewe hafi y’umugezi;</para>
  <para style="q1" vid="NUM 24:6">ni nk’ibiterwa vyitwa Alowe vyatewe n’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="NUM 24:6">ni nk’ibiti vy’amasederi ari i ruhande y’amazi.<verse eid="NUM 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 24:7" />Amazi azosesa arenge inkombe zayo</para>
  <para style="q2" vid="NUM 24:7">Imbuto zavyo zizoronka amazi menshi.</para>
  <para style="b" vid="NUM 24:7" />
  <para style="q1" vid="NUM 24:7">Umwami wabo azoba uwuhambaye kuruta Agagi;</para>
  <para style="q2" vid="NUM 24:7">ubwami bwabo buzoshirwa hejuru.<verse eid="NUM 24:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="NUM 24:8" />Imana yabakuye muri Egiputa;</para>
  <para style="q2" vid="NUM 24:8">bafise inkomezi nk’iz’imbogo.</para>
  <para style="q1" vid="NUM 24:8">Bazorigata amahanga abanka</para>
  <para style="q2" vid="NUM 24:8">amagufa yabo bayagire ubunywenywe;</para>
  <para style="q2" vid="NUM 24:8">bazobatobaguza imyampi yabo.<verse eid="NUM 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 24:9" />Baricaye barabunze nk’intambwe,</para>
  <para style="q2" vid="NUM 24:9">mbere nk’intambwe y’ingore; ni nde yobavyura?</para>
  <para style="b" vid="NUM 24:9" />
  <para style="q1" vid="NUM 24:9">Abaguhezagira baragahezagirwa,</para>
  <para style="q2" vid="NUM 24:9">abakuvuma na bo barakavumwa!”<verse eid="NUM 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10" />Nuko Balaki ashavurira Balamu cane. Akubita amashi ku yandi aramubwira ati: “Nagutumyeko kuvuma abansi banje, ariko wabahezagiye incuro zitatu zose. <verse eid="NUM 24:10" /><verse number="11" style="v" sid="NUM 24:11" />Va ngaha, taha ubu nyene! Nari navuze ko ndakugerera ingero ishimishije, ariko <char style="nd">Uhoraho</char> akubujije kugererwa.”<verse eid="NUM 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 24:12" />Balamu yishura Balaki ati: “Nari nabwiye abo watumye kumpamagara nti: <verse eid="NUM 24:12" /><verse number="13" style="v" sid="NUM 24:13" />‘Naho Balaki yompa ikirimba ciwe cuzuye inzahabu n’ifeza, sinzogira ico nkora na kimwe nigeneye, caba ciza canke kibi, ngo nyuranye n’ico <char style="nd">Uhoraho</char> yategetse; ntegerezwa kuvuga ivyo <char style="nd">Uhoraho</char> avuga’? <verse eid="NUM 24:13" /><verse number="14" style="v" sid="NUM 24:14" />Ubu rero ndisubiriye iwacu, ariko reka ndakuburire ivyo aba bantu bazokorera abantu bawe mu misi izoza.”<verse eid="NUM 24:14" /></para>
  <para style="s1">Ubutumwa bwa kane bwa Balamu</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 24:15" />Nuko atangura kuvugishwa ati:</para>
  <para style="q1" vid="NUM 24:15">“Uku ni ko Balamu mwene Beyori avuga,</para>
  <para style="q2" vid="NUM 24:15">uwufise amaso abona neza avuga ibi,<verse eid="NUM 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 24:16" />uwufise amatwi yumva amajambo y’Imana avuga ibi,</para>
  <para style="q2" vid="NUM 24:16">uwufise ukumenya kuva ku Yisumbavyose,</para>
  <para style="q1" vid="NUM 24:16">akabona ivyo yeretswe n’Iyishoboravyose,</para>
  <para style="q2" vid="NUM 24:16">uwuca bugufi akubama, amaso yiwe akuguruka:<verse eid="NUM 24:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="NUM 24:17" />Ndamubona, ariko si ubu nyene;</para>
  <para style="q2" vid="NUM 24:17">ndamwitegereza, ariko ntari hafi.</para>
  <para style="q1" vid="NUM 24:17">Inyenyeri izova muri Yakobo;</para>
  <para style="q2" vid="NUM 24:17">icumu ry’ukuganza rizoshingwa muri Isirayeli.</para>
  <para style="q1" vid="NUM 24:17">Azomenagura mu ruhanga h’Abanyamowabu,</para>
  <para style="q2" vid="NUM 24:17">amenagure imitwe ya bene Sheti.<verse eid="NUM 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 24:18" />Edomu hazoneshwa;</para>
  <para style="q2" vid="NUM 24:18">Seyiri, mu bansi biwe hazoneshwa,</para>
  <para style="q2" vid="NUM 24:18">ariko Isirayeli azokuzwa.<verse eid="NUM 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 24:19" />Uwuganza azova muri Yakobo</para>
  <para style="q2" vid="NUM 24:19">arandure amasigarira y’igisagara.”<verse eid="NUM 24:19" /></para>
  <para style="s1">Ubutumwa bwa gatanu bwa Balamu</para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20" />Nuko Balamu abonye Abamaleki atangura kuvugishwa ati:</para>
  <para style="q1" vid="NUM 24:20">“Abamaleki bahora ari ihanga rya mbere mu yandi,</para>
  <para style="q2" vid="NUM 24:20">ariko iherezo ryabo bazoranduka rwose.”<verse eid="NUM 24:20" /></para>
  <para style="s1">Ubutumwa bwa gatandatu bwa Balamu</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 24:21" />Abonye Abakayini abavugishwako ati:</para>
  <para style="q1" vid="NUM 24:21">“Wibera ahatekanye,</para>
  <para style="q2" vid="NUM 24:21">icari cawe kiri ku gitandara;<verse eid="NUM 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 24:22" />ariko mwebwe Abakayini muzosamburwa</para>
  <para style="q2" vid="NUM 24:22">igihe Abashuri bazokujana uri inyagano.”<verse eid="NUM 24:22" /></para>
  <para style="s1">Ubutumwa bw’indwi bwa Balamu</para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 24:23" />Yongera kuvugishwa ati:</para>
  <para style="q1" vid="NUM 24:23">“Yo! Mbega ni nde azosigara Imana atari yo imushigaje?<verse eid="NUM 24:23" /></para>
  <para style="q2">
    <verse number="24" style="v" sid="NUM 24:24" />Amato azova ku nkengera za Kupuro;</para>
  <para style="q1" vid="NUM 24:24">acinyize Ashuri kandi ababaze Eberi,</para>
  <para style="q2" vid="NUM 24:24">ariko na bo nyene amaherezo bazoranduka.”<verse eid="NUM 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25" />Nuko Balamu ava hasi yitahira iwe Balaki na we ajana inzira yiwe.<verse eid="NUM 24:25" /></para>
  <chapter eid="NUM 24" />
  <chapter number="25" style="c" sid="NUM 25" />
  <para style="s1">Abanyamowabu batega umutego Abisirayeli</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1" />Abisirayeli bakiri i Shitimu, abagabo batangura gusambana n’abakobwa b’Abanyamowabukazi, <verse eid="NUM 25:1" /><verse number="2" style="v" sid="NUM 25:2" />babatumirira guha ibimazi ibigirwamana vyabo. <verse eid="NUM 25:2" /><verse number="3" style="v" sid="NUM 25:3" />Nuko Abisirayeli bifatanya na bo mu gusenga Bayali-Peyori. <char style="nd">Uhoraho</char> arabashavurira cane.<verse eid="NUM 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 25:4" />
    <char style="nd">Uhoraho</char> abarira Mose ati: “Fata ba bakuru bose b’ubu bwoko, ubice ubanikire ku zuba imbere y’<char style="nd">Uhoraho</char>, kugira ngo ishavu ryanje rive ku Bisirayeli.”<verse eid="NUM 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 25:5" />Nuko Mose abarira abacamanza b’Abisirayeli ati: “Umuntu wese wo muri mwebwe niyice abagabo bose bifatanije n’abandi mu gusenga Bayali-Peyori.”<verse eid="NUM 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6" />Nuko umugabo w’Umwisirayeli azana i muhira iwe umugore w’Umumidiyanikazi amucisha imbere ya Mose n’Abisirayeli bose aho bariko bararirira ku muryango w’Ihema ry’Ibonaniro. <verse eid="NUM 25:6" /><verse number="7" style="v" sid="NUM 25:7" />Nuko Finehasi mwene Eliyazeri, umuhungu wa Aroni, umuherezi, abibonye, ava mw’ikoraniro, afata icumu <verse eid="NUM 25:7" /><verse number="8" style="v" sid="NUM 25:8" />akurikira wa Mwisirayeli mw’ihema ryiwe. Abatobekeranya bompi na rya cumu, wa Mwisirayeli na wa mugore. Maze ikiza cari ku Bisirayeli kirahagarara; <verse eid="NUM 25:8" /><verse number="9" style="v" sid="NUM 25:9" />ariko abari bamaze gupfa kubera ico kiza bashika ku bihumbi mirongo ibiri na bine.<verse eid="NUM 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 25:10" /><verse number="11" style="v" sid="NUM 25:11" />“Finehasi mwene Eliyazeri, umuhungu wa Aroni, umuherezi, ahwamitse ishavu ryanje riva ku Bisirayeli. Kubera ko yagize ishaka nkanje ryo kugarukana icubahiro canje, bitumye nigarura ngo sindabamare. <verse eid="NUM 25:11" /><verse number="12" style="v" sid="NUM 25:12" />Nuko umubwire ko ngiranye na we isezerano ry’amahoro. <verse eid="NUM 25:12" /><verse number="13" style="v" sid="NUM 25:13" />We n’uruvyaro rwiwe rwose baronse isezerano ridahera ry’ubuherezi, kuko yagize ishaka ryo guhesha icubahiro Imana yiwe agatangira Abisirayeli bose ikimazi gikuraho ivyaha.”<verse eid="NUM 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14" />Uwo Mwisirayeli yicanywe n’uwo Mumidiyanikazi yitwa Zimuri mwene Salu, umukuru w’umuryango w’Abasimeyoni. <verse eid="NUM 25:14" /><verse number="15" style="v" sid="NUM 25:15" />Kandi uwo mugore w’Umumidiyanikazi yishwe yitwa Kozibi umukobwa wa Zuri, umukuru w’umuryango umwe w’Abamidiyani.<verse eid="NUM 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 25:16" /><verse number="17" style="v" sid="NUM 25:17" />“Mufate Abamidiyani nk’abansi banyu kandi muze mubice, <verse eid="NUM 25:17" /><verse number="18" style="v" sid="NUM 25:18" />kuko babafashe nk’abansi babo igihe babahenda mu vy’i Peyori no mu vya Kozibi, umukobwa w’umukuru w’umuryango umwe mu miryango yabo, wa mugore yicwa igihe icago catera kubera inkurikizi y’i Peyori.”<verse eid="NUM 25:18" /></para>
  <chapter eid="NUM 25" />
  <chapter number="26" style="c" sid="NUM 26" />
  <para style="s1">Bongera guharura abantu ubugira kabiri</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1" />Inyuma y’ico kiza <char style="nd">Uhoraho</char> abarira Mose na Eliyazeri mwene Aroni, umuherezi ati: <verse eid="NUM 26:1" /><verse number="2" style="v" sid="NUM 26:2" />“Harura Abisirayeli bose uko imiryango yabo iri; abamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba.” <verse eid="NUM 26:2" /><verse number="3" style="v" sid="NUM 26:3" />Nuko bari mu biyaya vy’i Mowabu ku nkengera za Yorodani aharabana n’i Yeriko, Mose na Eliyazeri umuherezi bavugana na bo bababarira bati: <verse eid="NUM 26:3" /><verse number="4" style="v" sid="NUM 26:4" />“Harura abagabo bamaze imyaka mirongo ibiri n’iyirenga, nk’uko <char style="nd">Uhoraho</char> yategetse Mose.”</para>
  <para style="b" vid="NUM 26:4" />
  <para style="lh" vid="NUM 26:4">Aba ni bo Bisirayeli bavuye muri Egiputa:<verse eid="NUM 26:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="NUM 26:5" />Abo mu ruvyaro rwa Reyubeni, imfura ya Isirayeli, bari:</para>
  <para style="li2" vid="NUM 26:5">abakomoka kuri Hanoki, umuryango w’Abahanoki;</para>
  <para style="li2" vid="NUM 26:5">abakomoka kuri Palu, umuryango w’Abapalu;<verse eid="NUM 26:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="NUM 26:6" />abakomoka kuri Hezironi, umuryango w’Abahezironi;</para>
  <para style="li2" vid="NUM 26:6">abakomoka Kuri Karumi, umuryango w’Abakarumi.<verse eid="NUM 26:6" /></para>
  <para style="lf">
    <verse number="7" style="v" sid="NUM 26:7" />Iyo ni yo yari imiryango y’Abareyubeni; Abaharuwe bari ibihumbi mirongo ine na bitatu n’amajana indwi na mirongo itatu.<verse eid="NUM 26:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="NUM 26:8" />Mwene Palu yari Eliyabu, <verse eid="NUM 26:8" /><verse number="9" style="v" sid="NUM 26:9" />bene Eliyabu bari Nemuweli, Datani na Abiramu. Abo nyene Datani na Abiramu bari abakuru b’abantu bagumukanye Mose na Aroni bakaba bari mu bakurikiye Kora igihe bagumuka k’<char style="nd">Uhoraho</char>. <verse eid="NUM 26:9" /><verse number="10" style="v" sid="NUM 26:10" />Isi irasama irabamira hamwe na Kora, abamukurikira na bo bapfuye igihe umuriro warandura abantu amajana abiri na mirongo itanu. Ibatangako akarorero. <verse eid="NUM 26:10" /><verse number="11" style="v" sid="NUM 26:11" />Ariko inzu ya Kora ntiyaherengeteye.<verse eid="NUM 26:11" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="12" style="v" sid="NUM 26:12" />Abo mu ruvyaro rwa Simeyoni nk’uko inzu zabo zari zimeze ni:</para>
  <para style="li2" vid="NUM 26:12">abakomoka kuri Nemuweli, inzu y’Abanemuweli;</para>
  <para style="li2" vid="NUM 26:12">abakomoka kuri Yamini, inzu y’Abayamini;</para>
  <para style="li2" vid="NUM 26:12">abakomoka kuri Yakini, inzu y’Abayakini;<verse eid="NUM 26:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="NUM 26:13" />abakomoka kuri Zera, inzu y’Abazera;</para>
  <para style="li2" vid="NUM 26:13">abakomoka kuri Sawuli, inzu y’Abasawuli.<verse eid="NUM 26:13" /></para>
  <para style="lf">
    <verse number="14" style="v" sid="NUM 26:14" />Izo ni zo zari inzu z’Abasimeyoni; bari abagabo ibihumbi mirongo ibiri na bibiri n’amajana abiri.<verse eid="NUM 26:14" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="15" style="v" sid="NUM 26:15" />Abo mu ruvyaro rwa Gadi nk’uko inzu zabo zari ziri ni:</para>
  <para style="li2" vid="NUM 26:15">abakomoka kuri Zefoni, inzu y’Abazefoni;</para>
  <para style="li2" vid="NUM 26:15">abakomoka kuri Hagi, inzu y’Abahagi;</para>
  <para style="li2" vid="NUM 26:15">abakomoka kuri Shuni, inzu y’Abashuni;<verse eid="NUM 26:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="NUM 26:16" />abakomoka kuri Ozuni, inzu y’Abozuni;</para>
  <para style="li2" vid="NUM 26:16">abakomoka kuri Eri, inzu y’Aberi;<verse eid="NUM 26:16" /></para>
  <para style="li2">
    <verse number="17" style="v" sid="NUM 26:17" />abakomoka kuri Arodi, inzu y’Abarodi;</para>
  <para style="li2" vid="NUM 26:17">abakomoka kuri Areli, inzu y’Abareli.<verse eid="NUM 26:17" /></para>
  <para style="lf">
    <verse number="18" style="v" sid="NUM 26:18" />Iyo ni yo yari imiryango ya Gadi; abaharuwe bari ibihumbi mirongo ine n’amajana atanu.<verse eid="NUM 26:18" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="19" style="v" sid="NUM 26:19" />Eri na Onani ni bo bari bene Yuda, ariko bapfiriye i Kanani.<verse eid="NUM 26:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 26:20" />Abakomoka kuri Yuda nk’uko inzu zabo zari ziri ni:</para>
  <para style="li2" vid="NUM 26:20">abakomoka kuri Shela, inzu y’Abashela;</para>
  <para style="li2" vid="NUM 26:20">abakomoka kuri Perezi, inzu y’Abaperezi;</para>
  <para style="li2" vid="NUM 26:20">abakomoka kuri Zera, inzu y’Abazera.<verse eid="NUM 26:20" /></para>
  <para style="li2">
    <verse number="21" style="v" sid="NUM 26:21" />Abo mu ruvyaro rwa Perezi bari:</para>
  <para style="li3" vid="NUM 26:21">abakomoka kuri Hezironi, inzu y’Abahezironi;</para>
  <para style="li3" vid="NUM 26:21">abakomoka kuri Hamuli, inzu y’Abahamuli.<verse eid="NUM 26:21" /></para>
  <para style="lf">
    <verse number="22" style="v" sid="NUM 26:22" />Abo ni abo mu nzu za Yuda; abaharuwe bari ibihumbi mirongo indwi na bitandatu n’amajana atanu.<verse eid="NUM 26:22" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="23" style="v" sid="NUM 26:23" />Abo mu ruvyaro rwa Isakari nk’uko inzu zabo zari ziri ni:</para>
  <para style="li2" vid="NUM 26:23">abakomoka kuri Tola, inzu y’Abatola;</para>
  <para style="li2" vid="NUM 26:23">abakomoka kuri Puwa, inzu y’Abapuwa;<verse eid="NUM 26:23" /></para>
  <para style="li2">
    <verse number="24" style="v" sid="NUM 26:24" />abakomoka kuri Yashubi, inzu y’Abayashubi;</para>
  <para style="li2" vid="NUM 26:24">abakomoka kuri Shimuroni, inzu y’Abashimuroni.<verse eid="NUM 26:24" /></para>
  <para style="lf">
    <verse number="25" style="v" sid="NUM 26:25" />Izo ni zo zari inzu z’Abisakari; abaharuwe bari ibihumbi mirongo itandatu na bine n’amajana atatu.<verse eid="NUM 26:25" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="26" style="v" sid="NUM 26:26" />Abo mu ruvyaro rwa Zebuloni nk’uko inzu zabo zari ziri ni:</para>
  <para style="li2" vid="NUM 26:26">abakomoka kuri Seredi, inzu y’Abaseredi;</para>
  <para style="li2" vid="NUM 26:26">abakomoka kuri eloni, inzu y’Abeloni;</para>
  <para style="li2" vid="NUM 26:26">abakomoka kuri Yahileyeli, inzu y’Abayahileyeli.<verse eid="NUM 26:26" /></para>
  <para style="lf">
    <verse number="27" style="v" sid="NUM 26:27" />Izo ni zo zari inzu z’Abazebuloni; abaharuwe bari ibihumbi mirongo itandatu n’amajana atanu.<verse eid="NUM 26:27" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="28" style="v" sid="NUM 26:28" />Abo mu ruvyaro rwa Yosefu nk’uko inzu zabo zari ziri bakomotse kuri Manase na Efurayimu ni:<verse eid="NUM 26:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 26:29" />Abo mu ruvyaro rwa Manase:</para>
  <para style="li2" vid="NUM 26:29">abakomoka kuri Makiri, inzu y’Abamakiri (Makiri ni we yari se wa Gileyadi);</para>
  <para style="li2" vid="NUM 26:29">abakomoka kuri Gileyadi, inzu y’Abagileyadi.<verse eid="NUM 26:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="NUM 26:30" />Aba ni abo mu ruvyaro rwa Gileyadi:</para>
  <para style="li3" vid="NUM 26:30">abakomoka kuri Iyezeri, inzu y’Abiyezeri;</para>
  <para style="li3" vid="NUM 26:30">abakomoka kuri Heleki, inzu y’Abaheleki;<verse eid="NUM 26:30" /></para>
  <para style="li3">
    <verse number="31" style="v" sid="NUM 26:31" />abakomoka kuri Asiriyeli, inzu y’Abisirayeli;</para>
  <para style="li3" vid="NUM 26:31">abakomoka kuri Shekemu, inzu y’Abashekemu;<verse eid="NUM 26:31" /></para>
  <para style="li3">
    <verse number="32" style="v" sid="NUM 26:32" />abakomoka kuri Shemida, inzu y’Abashemida;</para>
  <para style="li3" vid="NUM 26:32">abakomoka kuri Heferi, inzu y’Abaheferi.<verse eid="NUM 26:32" /></para>
  <para style="li3">
    <verse number="33" style="v" sid="NUM 26:33" />(Zelofehadi mwene Heferi nta bahungu yari afise; yari afise abakobwa gusa, amazina yabo ni Mahala, Nowa, Hogula, Milika na Tiriza.)<verse eid="NUM 26:33" /></para>
  <para style="lf">
    <verse number="34" style="v" sid="NUM 26:34" />Izo ni zo nzu z’Abamanase; abaharuwe bari ibihumbi mirongo itanu na bibiri n’amajana indwi.<verse eid="NUM 26:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="NUM 26:35" />Aba ni bo bari abo mu ruvyaro rwa Efurayimu nk’uko inzu zabo zari ziri:</para>
  <para style="li2" vid="NUM 26:35">abakomoka kuri Shutela, inzu y’Abashutela;</para>
  <para style="li2" vid="NUM 26:35">abakomoka kuri Bekeri, inzu y’Ababekeri;</para>
  <para style="li2" vid="NUM 26:35">abakomoka kuri Tahani, inzu y’Abatahani.<verse eid="NUM 26:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="NUM 26:36" />Abakomoka kuri Shutela ni:</para>
  <para style="li3" vid="NUM 26:36">abakomoka kuri Erani, inzu y’Aberani.<verse eid="NUM 26:36" /></para>
  <para style="lf">
    <verse number="37" style="v" sid="NUM 26:37" />Izo ni zo nzu z’Abefurayimu; abaharuwe bari ibihumbi mirongo itatu na bibiri n’amajana atanu.</para>
  <para style="lf" vid="NUM 26:37">Aba ni bo bakomoka kuri Yosefu nk’uko inzu zabo zari ziri.<verse eid="NUM 26:37" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="38" style="v" sid="NUM 26:38" />Abo mu ruvyaro rwa Benyamini nk’uko inzu zabo zari ziri ni:</para>
  <para style="li2" vid="NUM 26:38">abakomoka kuri Bela, inzu y’Ababela;</para>
  <para style="li2" vid="NUM 26:38">abakomoka kuri Ashibeli, inzu y’Abashibeli;</para>
  <para style="li2" vid="NUM 26:38">abakomoka kuri Ahiramu, inzu y’Abahiramu;<verse eid="NUM 26:38" /></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 26:39" />abakomoka kuri Shufamu, inzu y’Abashufamu;</para>
  <para style="li2" vid="NUM 26:39">abakomoka kuri Hufamu, inzu y’Abahufamu.<verse eid="NUM 26:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="NUM 26:40" />Abakomoka kuri Bela biciye kuri Aridi na Namani ni:</para>
  <para style="li3" vid="NUM 26:40">abakomoka kuri Aridi, inzu y’Abaridi;</para>
  <para style="li3" vid="NUM 26:40">abakomoka kuri Namani, inzu y’Abanamani.<verse eid="NUM 26:40" /></para>
  <para style="lf">
    <verse number="41" style="v" sid="NUM 26:41" />Izo ni zo nzu z’Ababenyamini; abaharuwe bari ibihumbi mirongo ine na bitanu n’amajana atandatu.<verse eid="NUM 26:41" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="42" style="v" sid="NUM 26:42" />Aba ni abo mu ruvyaro rwa Dani nk’uko inzu zabo zari ziri:</para>
  <para style="li2" vid="NUM 26:42">abakomoka kuri Shuhamu, inzu y’Abashuhamu.</para>
  <para style="lf" vid="NUM 26:42">Izo ni zo nzu z’Abadani: <verse eid="NUM 26:42" /><verse number="43" style="v" sid="NUM 26:43" />Bose bari abo mu nzu y’Abashuhamu; kandi abaharuwe bari ibihumbi mirongo itandatu na bine n’amajana ane.<verse eid="NUM 26:43" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="44" style="v" sid="NUM 26:44" />Aba ni abo mu ruvyaro rwa Asheri nk’uko inzu zabo zari ziri:</para>
  <para style="li2" vid="NUM 26:44">abakomoka kuri Imuna, inzu y’Abimuna;</para>
  <para style="li2" vid="NUM 26:44">abakomoka kuri Ishuvi, inzu y’Abishuvi;</para>
  <para style="li2" vid="NUM 26:44">abakomoka kuri Beriya, inzu y’Ababeriya;<verse eid="NUM 26:44" /></para>
  <para style="li2">
    <verse number="45" style="v" sid="NUM 26:45" />Abakomotse ku ruvyaro rwa Beriya ni:</para>
  <para style="li3" vid="NUM 26:45">abakomoka kuri Heberi, inzu y’Abaheberi;</para>
  <para style="li3" vid="NUM 26:45">abakomoka kuri Malukiyeli, inzu y’Abamalukiyeli.<verse eid="NUM 26:45" /></para>
  <para style="lf">
    <verse number="46" style="v" sid="NUM 26:46" />Asheri yari afise umukobwa yitwa Sera.<verse eid="NUM 26:46" /></para>
  <para style="lf">
    <verse number="47" style="v" sid="NUM 26:47" />Izo ni zo zari inzu z’Abasheri; abaharuwe bari ibihumbi mirongo itanu na bitatu n’amajana ane.<verse eid="NUM 26:47" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="48" style="v" sid="NUM 26:48" />Abo mu ruvyaro rwa Nafutali nk’uko inzu zabo zari ziri ni:</para>
  <para style="li2" vid="NUM 26:48">abakomoka kuri Yahaziyeli, inzu y’Abayahaziyeli;</para>
  <para style="li2" vid="NUM 26:48">abakomoka kuri Guni, inzu y’Abaguni;<verse eid="NUM 26:48" /></para>
  <para style="li2">
    <verse number="49" style="v" sid="NUM 26:49" />abakomoka kuri Yezeri, inzu y’Abayezeri;</para>
  <para style="li2" vid="NUM 26:49">abakomoka kuri Shilemu, inzu y’Abashilemu.<verse eid="NUM 26:49" /></para>
  <para style="lf">
    <verse number="50" style="v" sid="NUM 26:50" />Izo ni zo nzu z’Abanafutali; abaharuwe bari ibihumbi mirongo ine na bitanu n’amajana ane.<verse eid="NUM 26:50" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="51" style="v" sid="NUM 26:51" />Igitigiri cose c’abagabo b’Abisirayeli cari ibihumbi amajana atandatu na kimwe n’amajana indwi na mirongo itatu.<verse eid="NUM 26:51" /></para>
  <para style="b" />
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 26:52" /><verse number="53" style="v" sid="NUM 26:53" />“Igihugu kize kigaburwe hisunzwe ibitigiri vy’imiryango. <verse eid="NUM 26:53" /><verse number="54" style="v" sid="NUM 26:54" />Umuryango munini muze muwuhe hanini, umuryango muto muwuhe hatoya; umwe wese aze aronke umugabane wiwe hisunzwe ibitigiri vyaharuwe. <verse eid="NUM 26:54" /><verse number="55" style="v" sid="NUM 26:55" />Kandi muze mukoreshe ubupfindo mu kugabura igihugu, umugwi uwo ari wo wose uzoronka umugabane wawo hisunzwe amazina y’umuryango wa ba sekuru. <verse eid="NUM 26:55" /><verse number="56" style="v" sid="NUM 26:56" />Umugabane uzotangwa hakoreshejwe ubupfindo kandi harabwe ko umuryango ari munini canke mutoya.”<verse eid="NUM 26:56" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="57" style="v" sid="NUM 26:57" />Aba ni bo Balewi baharuhwe nk’uko inzu zabo zari ziri:</para>
  <para style="li2" vid="NUM 26:57">abakomoka kuri Gerishoni, inzu y’Abagerishoni;</para>
  <para style="li2" vid="NUM 26:57">abakomoka kuri Kohati, inzu y’Abakohati;</para>
  <para style="li2" vid="NUM 26:57">abakomoka kuri Merari, inzu y’Abamerari.<verse eid="NUM 26:57" /></para>
  <para style="li1">
    <verse number="58" style="v" sid="NUM 26:58" />N’izi na zo zari inzu z’Abalewi:</para>
  <para style="li2" vid="NUM 26:58">inzu y’Abalibuni,</para>
  <para style="li2" vid="NUM 26:58">inzu y’Abaheburoni,</para>
  <para style="li2" vid="NUM 26:58">inzu y’Abamahili,</para>
  <para style="li2" vid="NUM 26:58">inzu y’Abamushi</para>
  <para style="li2" vid="NUM 26:58">inzu y’Abakora.</para>
  <para style="li2" vid="NUM 26:58">(Kohati yari se wa Amuramu; <verse eid="NUM 26:58" /><verse number="59" style="v" sid="NUM 26:59" />Muka Amuramu yitwa Yokebedi, yanduruka mu ruvyaro rwa Lewi, yavukiye muri Egiputa. Yavyaranye na Amuramu Aroni, Mose na mushiki wabo Miriyamu. <verse eid="NUM 26:59" /><verse number="60" style="v" sid="NUM 26:60" />Aroni ni se wa Nadabu na Abihu, Eliyazeri na Itamari. <verse eid="NUM 26:60" /><verse number="61" style="v" sid="NUM 26:61" />Ariko Nadabu na Abihu bapfuye igihe baturirira amashikanwa imbere y’<char style="nd">Uhoraho</char> bakoresheje umuriro utemewe.)<verse eid="NUM 26:61" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="62" style="v" sid="NUM 26:62" />Abahungu bose b’Abalewi bari bamaze ukwezi no kurenga baharuwe bari ibihumbi mirongo ibiri na bitatu. Ntibaharuwe hamwe n’abandi Bisirayeli kuko ata mugabane bari bafise muri bo.<verse eid="NUM 26:62" /></para>
  <para style="b" />
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63" />Abo ni bo baharuwe na Mose na Eliyazeri umuherezi igihe baharura Abisirayeli mu kiyaya c’i Mowabu ku nkombe ya Yorodani aharabana n’i Yeriko. <verse eid="NUM 26:63" /><verse number="64" style="v" sid="NUM 26:64" />Nta n’umwe yari muri bamwe baharurwa na Mose na Aroni umuherezi igihe babaharurira mu bugaragwa bw’i Sinayi. <verse eid="NUM 26:64" /><verse number="65" style="v" sid="NUM 26:65" />Kuko <char style="nd">Uhoraho</char> yari yarabwiye abo Bisirayeli ko bazopfira mu bugaragwa, kandi nta n’umwe yari agisigaye kiretse Kalebu mwene Yefune na Yosuwa mwene Nuni.<verse eid="NUM 26:65" /></para>
  <chapter eid="NUM 26" />
  <chapter number="27" style="c" sid="NUM 27" />
  <para style="s1">Abakobwa ba Zelofehadi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1" />Abakobwa ba Zelofehadi mwene Heferi, umuhungu wa Gileyadi, Gileyadi mwene Makiri, Makiri mwene Manase, bose bakomoka kuri Manase mwene Yosefu. Amazina y’abo bakobwa yari Mahala, Noha, Hogula, Milika na Tiriza. Baragenda begera <verse eid="NUM 27:1" /><verse number="2" style="v" sid="NUM 27:2" />umuryango w’Ihema ry’Ibonaniro bahagarara imbere ya Mose, ya Eliyazeri umuherezi, ya ba bakuru n’ikoraniro ryose, bavuga bati: <verse eid="NUM 27:2" /><verse number="3" style="v" sid="NUM 27:3" />“Data yapfiriye mu bugaragwa. Ntiyari mu bakurikiye Kora, bagize akagwi ko kugwanya <char style="nd">Uhoraho</char>, ariko yishwe n’icaha ciwe kandi nta bahungu yasize. <verse eid="NUM 27:3" /><verse number="4" style="v" sid="NUM 27:4" />None ni co cotuma izina rya data rizimangana mu muryango wiwe ngo ni uko ata muhungu yavyaye? Turasavye umugabane mu bo mu muryango wa data.”<verse eid="NUM 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5" />Nuko Mose ajana ikibazo cabo imbere y’<char style="nd">Uhoraho</char> <verse eid="NUM 27:5" /><verse number="6" style="v" sid="NUM 27:6" />hanyuma <char style="nd">Uhoraho</char> amubwira ati: <verse eid="NUM 27:6" /><verse number="7" style="v" sid="NUM 27:7" />“Ivyo abakobwa ba Zelofehadi bavuga ni vyo. Uze ubahe itongo nk’iragi muri ba sewabo, umugabane wa se uwubahe.<verse eid="NUM 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 27:8" />Bwira Abisirayeli uti: ‘umuntu niyapfa adasize umuhungu, umugabane wiwe uze uhabwe umukobwa wiwe. <verse eid="NUM 27:8" /><verse number="9" style="v" sid="NUM 27:9" />Niyaba adafise umukobwa, umugabane wiwe uze uhabwe abahungu bavukana na we. <verse eid="NUM 27:9" /><verse number="10" style="v" sid="NUM 27:10" />Niyaba adafise abahungu bavukana, uwo mugabane wiwe uze uhabwe abahungu bavukana na se wiwe. <verse eid="NUM 27:10" /><verse number="11" style="v" sid="NUM 27:11" />Se wiwe niyaba adafise abahungu bavukana, muze muhe uwo mugabane wiwe uwo mu muryango wiwe wa hafi, kugira ngo awegukire. Iki kize kibe ikintu cemewe n’amategeko mu Bisirayeli, nk’uko <char style="nd">Uhoraho</char> yabitegetse Mose.’ ”<verse eid="NUM 27:11" /></para>
  <para style="s1">Yosuwa Asubirira Mose</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12" />Nuko <char style="nd">Uhoraho</char> abarira Mose ati: “Duga uwu musozi wo mu misozi igize Abarimu urabe igihugu ngiye guha Abisirayeli. <verse eid="NUM 27:12" /><verse number="13" style="v" sid="NUM 27:13" />Niwamara kukibona, nawe nyene uzohamvya abanyu, nk’uko vyagenze kuri Aroni mukurwawe, <verse eid="NUM 27:13" /><verse number="14" style="v" sid="NUM 27:14" />kuko igihe ikoraniro ryagumuka kuri ya mazi yo mu bugaragwa bw’i Zini, mwempi ntimwumviye itegeko ryanje ngo mumpeshe icubahiro nk’Uwera imbere y’amaso yabo.” (Ayo ni ya mazi y’i Meriba i Kadeshi, mu bugaragwa bw’i Zini.)<verse eid="NUM 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15" />Mose abarira <char style="nd">Uhoraho</char> ati: <verse eid="NUM 27:15" /><verse number="16" style="v" sid="NUM 27:16" />“Icompa <char style="nd">Uhoraho</char>, Imana y’impwemu z’abantu bose, agashiraho umuntu wo kurongora ubu bwoko <verse eid="NUM 27:16" /><verse number="17" style="v" sid="NUM 27:17" />kugira ngo abaje imbere amaja n’amaza, uwuzobarongora basohotse canke binjira, kugira ngo abantu b’<char style="nd">Uhoraho</char> ntibabe nk’intama zitagira umwungere.”<verse eid="NUM 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18" />Nuko <char style="nd">Uhoraho</char> abarira Mose ati: “Jana Yosuwa mwene Nuni, umuntu arimwo Mpwemu, umurambikeko ikiganza. <verse eid="NUM 27:18" /><verse number="19" style="v" sid="NUM 27:19" />Umuhagarike imbere ya Eliyazeri umuherezi n’ishengero ryose umushikirize ibikorwa imbere yabo. <verse eid="NUM 27:19" /><verse number="20" style="v" sid="NUM 27:20" />Umuhe ku bubasha bwawe kugira ngo ishengero ry’Abisirayeli bose baze bamwumvire. <verse eid="NUM 27:20" /><verse number="21" style="v" sid="NUM 27:21" />Aze ahagarare imbere ya Eliyazeri umuherezi, kuko ari we azomushikiriza ingingo zivuye k’<char style="nd">Uhoraho</char>, azoronka akoresheje ubupfindo bwa Urimu. Ategetse we n’Abisirayeli bose bazosohoka, ategetse bazokwinjira.”<verse eid="NUM 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 27:22" />Mose akora nk’uko <char style="nd">Uhoraho</char> yari yamutegetse. Ajana Yosuwa amuhagarika imbere ya Eliyazeri umuherezi n’ikoraniro ryose. <verse eid="NUM 27:22" /><verse number="23" style="v" sid="NUM 27:23" />Maze amurambikako ibiganza aca aramutuma, nk’uko <char style="nd">Uhoraho</char> yari yabitegetse biciye muri Mose.<verse eid="NUM 27:23" /></para>
  <chapter eid="NUM 27" />
  <chapter number="28" style="c" sid="NUM 28" />
  <para style="s1">Ibimazi vyo ku musi ku musi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 28:1" /><verse number="2" style="v" sid="NUM 28:2" />“Tegeka Abisirayeli ubabwire uti: ‘Mwiyubare kugira ngo mu gihe cashinzwe muze mushikanire imfungurwa zanje ari vyo vya bimazi vyo kwoswa nk’umubabwe umota neza unezera.’ <verse eid="NUM 28:2" /><verse number="3" style="v" sid="NUM 28:3" />Ubabwire uti: ‘Iri ni ryo shikanwa ryo guturirwa mukwiye gushikanira <char style="nd">Uhoraho</char>: imyagazi y’intama ibiri imaze umwaka itagira agasembwa, nk’ikimazi co guturirwa cama gitangwa ku musi ku musi. <verse eid="NUM 28:3" /><verse number="4" style="v" sid="NUM 28:4" />Muze mushikane umwe mu gitondo, uwundi ku mugoroba, <verse eid="NUM 28:4" /><verse number="5" style="v" sid="NUM 28:5" />hamwe n’ishikanwa ry’ifu ringana n’ic’icumi c’ingero efa<note caller="+" style="f"><char style="fr" closed="false">28:5 </char><char style="ft" closed="false">Ni nk’ikilo 1,9.</char></note> y’ifu inoze neza n’ica kane c’ingero hini<note caller="+" style="f"><char style="fr" closed="false">28:5 </char><char style="ft" closed="false">Ni nk’ilitiro 1.</char></note> y’amavuta ya elayo. <verse eid="NUM 28:5" /><verse number="6" style="v" sid="NUM 28:6" />Ico ni ikimazi co guturirwa cama gitangwa nk’uko vyashinzwe ku Musozi Sinayi ngo kibe ubumote bwiza bushikaniwe <char style="nd">Uhoraho</char>. <verse eid="NUM 28:6" /><verse number="7" style="v" sid="NUM 28:7" />Ishikanwa ry’ibinyobwa riherekeza iryo rize ribe ica gatatu c’ingero hini, hamwe n’uwo mwagazi. Muze musuke iryo shikanwa ry’ibinyobwa ahera imbere y’<char style="nd">Uhoraho</char>. <verse eid="NUM 28:7" /><verse number="8" style="v" sid="NUM 28:8" />Muze mushikane umwagazi wa kabiri ku mugoroba, hamwe n’ishikanwa ry’ifu n’iry’ibinyobwa risa n’irya mbere ryo mu gitondo. Ico ni ikimazi giturirwa, ishikanwa rimota neza rihimbara <char style="nd">Uhoraho</char>.<verse eid="NUM 28:8" /></para>
  <para style="s1">Ibimazi bitangwa kw’Isabato</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9" />Ku musi w’Isabato, muze mutange imyagazi y’intama ibiri imaze umwaka umwe kandi itagira agasembwa, hamwe n’ishikanwa ry’ibinyobwa n’ishikanwa bijanye rigizwe na bibiri vya cumi vy’ingero efa<note caller="+" style="f"><char style="fr" closed="false">28:9 </char><char style="ft" closed="false">Ni nk’ibilo 3,2.</char></note> y’ifu ikaranzwe mu mavuta ya elayo. <verse eid="NUM 28:9" /><verse number="10" style="v" sid="NUM 28:10" />Ni co kimazi co guturirwa kizotangwa uko Isabato ishitse, ciyongera kuri ca kimazi co ku musi ku musi n’ishikanwa bijana ry’ibinyobwa.<verse eid="NUM 28:10" /></para>
  <para style="s1">Ibimazi bitangwa uko ukwezi gutashe</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11" />Kw’igenekerezo rya mbere ry’ukwezi kwose, muze mushikanire <char style="nd">Uhoraho</char> ikimazi giturirwa kigizwe n’impfizi zibiri z’inka, impfizi y’intama ikuze imwe, n’impfizi z’intama indwi zimaze umwaka umwe, zitagira agasembwa. <verse eid="NUM 28:11" /><verse number="12" style="v" sid="NUM 28:12" />Impfizi yose y’inka muze muyishikane hamwe n’ishikanwa ry’ifu rigizwe na bitatu vya cumi vy’ingero efa<note caller="+" style="f"><char style="fr" closed="false">28:12 </char><char style="ft" closed="false">Ni nk’ibilo 5.</char></note> y’ifu inoze neza ikaranze mu mavuta, hanyuma impfizi yose y’intama ize ijane n’ishikanwa ry’ifu rigizwe na bibiri vya cumi vy’ingero efa y’ifu inoze neza ikaranzwe mu mavuta; <verse eid="NUM 28:12" /><verse number="13" style="v" sid="NUM 28:13" />kandi umwagazi w’intama wose, uze ujane n’ica cumi c’ingero efa y’ifu inoze neza ikaranzwe mu mavuta. Ico ni co kimazi co guturirwa, ubumote bwiza bushikaniwe <char style="nd">Uhoraho</char>. <verse eid="NUM 28:13" /><verse number="14" style="v" sid="NUM 28:14" />Impfizi yose ize iherekezwe n’ishikanwa ry’ibinyobwa ringana n’igice c’ingero hini<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="ft" closed="false">Ni nk’ilitiro n’ibice icenda</char></note> y’umuvinyu; hanyuma impfizi yose y’intama na yo iherekezwe n’ica gatatu c’ingero hini<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="ft" closed="false">Ni nk’ilitiro n’ibice bitatu</char></note>; umwagazi w’intama na wo, uherekezwe n’ica kane c’ingero hini<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="ft" closed="false">Ni nk’ilitiro imwe</char></note>. Ico ni ikimazi gitangwa uko ukwezi kwose mu mezi agize umwaka gutanguye. <verse eid="NUM 28:14" /><verse number="15" style="v" sid="NUM 28:15" />I ruhande y’ibimazi vyo guturirwa vyama bitangwa n’ishikanwa ribiherekeza, haze hatangwe n’isuguru y’impene y’ikimazi c’ivyaha gishikaniwe <char style="nd">Uhoraho</char>.<verse eid="NUM 28:15" /></para>
  <para style="s1">Umusi Mukuru wa Pasika</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16" />Ku musi ugira icumi na kane w’ukwezi kwa mbere muze muhimbaze Pasika y’<char style="nd">Uhoraho</char>. <verse eid="NUM 28:16" /><verse number="17" style="v" sid="NUM 28:17" />Ku musi ugira icumi na gatanu w’ukwo kwezi nyene muze mugire umusi mukuru; muze mumare imisi indwi murya imikate itarimwo umwambiro. <verse eid="NUM 28:17" /><verse number="18" style="v" sid="NUM 28:18" />Ku musi wa mbere muzogire ikoraniro ryera kandi ntimuze mugire igikorwa muwukorako. <verse eid="NUM 28:18" /><verse number="19" style="v" sid="NUM 28:19" />Muze mushikanire <char style="nd">Uhoraho</char> ibimazi vyo guturirwa n’umuriro, bigizwe n’impfizi zibiri z’inka, impfizi y’intama imwe n’imyagazi y’intama indwi imaze umwaka, kandi itagira agasembwa. <verse eid="NUM 28:19" /><verse number="20" style="v" sid="NUM 28:20" />Ishuri yose izojana n’ishikanwa ry’ifu rigizwe na bitatu vya cumi vy’ingero efa y’ifu inoze neza ikaranze mu mavuta; impfizi y’intama na yo ijane n’ibilo bitandatu; <verse eid="NUM 28:20" /><verse number="21" style="v" sid="NUM 28:21" />kandi umwagazi w’intama wose muri iyo ndwi, uzojana n’ibilo bitatu. <verse eid="NUM 28:21" /><verse number="22" style="v" sid="NUM 28:22" />Muze mwongereko isuguru y’impene imwe y’ikimazi c’ivyaha co kubabera igikuraho icaha. <verse eid="NUM 28:22" /><verse number="23" style="v" sid="NUM 28:23" />Ivyo bizokwiyongera ku bimazi biturirwa muzokwama mutanga imisi yose mu gatondo. <verse eid="NUM 28:23" /><verse number="24" style="v" sid="NUM 28:24" />Uko ni ko muzokwama mushikana ivyo bimazi ku musi ku musi muri iyo misi yose uko ari indwi, imfungurwa z’amashikanwa y’ubumote bwiza bunezera <char style="nd">Uhoraho</char>; bize vyame bitegurwa vyiyongera ku bimazi vyo guturirwa muhora mutanga ku musi hamwe n’ishikanwa rijana na vyo ry’umuvinyu. <verse eid="NUM 28:24" /><verse number="25" style="v" sid="NUM 28:25" />Ku musi ugira indwi muze mugire ikoraniro ryera kandi ntimuze mugire igikorwa muwukorako.<verse eid="NUM 28:25" /></para>
  <para style="s1">Imisi mikuru y’amayinga</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26" />Ku musi wo gushikanira <char style="nd">Uhoraho</char> ivyatanguye kwera imbere y’ibindi mu misi mikuru y’amayinga, muze mugire ikoraniro ryera kandi ntimuze mugire igikorwa na kimwe mukora. <verse eid="NUM 28:26" /><verse number="27" style="v" sid="NUM 28:27" />Muze mutange ikimazi co guturirwa c’amashuri abiri akiri mato, impfizi y’intama ikuze imwe n’impfizi z’intama indwi zimaze umwaka, bibe ubumote bwiza buhimbara <char style="nd">Uhoraho</char>. <verse eid="NUM 28:27" /><verse number="28" style="v" sid="NUM 28:28" />Impfizi yose ize iherekezwe n’ishikanwa ringana na bitatu vya cumi vy’ingero efa y’ifu inoze neza ikaranze mu mavuta; impfizi y’intama imwe na yo iherekezwe na bibiri vya cumi vy’ingero efa; <verse eid="NUM 28:28" /><verse number="29" style="v" sid="NUM 28:29" />umwagazi wose muri iyo myagazi indwi, uzoherekezwa n’ica cumi c’ingero efa. <verse eid="NUM 28:29" /><verse number="30" style="v" sid="NUM 28:30" />Uze ushiremwo n’isuguru y’impene imwe yo gutanga nk’ikimazi gikurako ivyaha vyanyu. <verse eid="NUM 28:30" /><verse number="31" style="v" sid="NUM 28:31" />Muze mutegure ibi vyose hamwe n’ishikanwa ry’ibinyobwa bijanye, bizokwiyongera kuri ca kimazi co guturirwa co ku musi ku musi n’ishikanwa ry’ifu bijanye. Muze mwiyubare ivyo bitungwa ntibize bibe bifise agasembwa.<verse eid="NUM 28:31" /></para>
  <chapter eid="NUM 28" />
  <chapter number="29" style="c" sid="NUM 29" />
  <para style="s1">Imisi mikuru y’inzamba</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1" />Ku musi wa mbere w’ukwezi kw’indwi muze mugire ikoraniro ryera kandi ntimuze mugire ico mukora. Uzoba ari umusi mukuru kuri mwebwe wo kuvuza inzamba. <verse eid="NUM 29:1" /><verse number="2" style="v" sid="NUM 29:2" />Ikimazi c’ubumote bwiza bunezera <char style="nd">Uhoraho</char>, kizobe ikimazi co guturirwa kigizwe n’ishuri imwe ikiri nto, impfizi y’intama imwe n’imyagazi y’intama indwi imaze umwaka, vyose bibe ibitagira agasembwa. <verse eid="NUM 29:2" /><verse number="3" style="v" sid="NUM 29:3" />Iyo shuri ize iherekezwe n’ishikanwa ringana na bitatu vya cumi vy’ingero efa<note caller="+" style="f"><char style="fr" closed="false">29:3 </char><char style="ft" closed="false">Ni nk’ibilo 3.</char></note> y’ifu inoze neza ivanze n’amavuta ya elayo; hanyuma iyo mpfizi y’intama na yo izoherekezwe na bibiri vya cumi<note caller="+" style="f"><char style="fr" closed="false">29:3 </char><char style="ft" closed="false">Ni nk’ibilo 3,2.</char></note>; <verse eid="NUM 29:3" /><verse number="4" style="v" sid="NUM 29:4" />kandi umwagazi wose uzoherekezwa na kimwe ca cumi<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">Ni nk’ikilo 1,6.</char></note>. <verse eid="NUM 29:4" /><verse number="5" style="v" sid="NUM 29:5" />Muze mushiremwo n’isuguru y’impene imwe y’ikimazi c’ivyaha kugira ngo kibe ikimazi co kubakurako ivyaha vyanyu. <verse eid="NUM 29:5" /><verse number="6" style="v" sid="NUM 29:6" />Ivyo bize vyiyongere kuri vya bimazi bitangwa uko ukwezi gutashe n’ivyo ku musi ku musi n’amashikanwa y’ifu n’ay’ibinyobwa nk’uko vyashinzwe. Bizoba ari ibimazi vyo guturirwa n’umuriro bishikaniwe <char style="nd">Uhoraho</char>; ubumote bwiza bumuhimbara.<verse eid="NUM 29:6" /></para>
  <para style="s1">Umusi w’impongano</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7" />Ku musi ugira icumi w’uko kwezi kw’indwi muze mugire ikoraniro ryera. Muze mwisonzeshe kandi ntihagire ico mukora. <verse eid="NUM 29:7" /><verse number="8" style="v" sid="NUM 29:8" />Muze mutange ishikanwa ribe ubumote bwiza bunezera <char style="nd">Uhoraho</char>, rizoba ari ikimazi co giturirwa kigizwe n’impfizi y’inka ikiri nto, impfizi y’intama imwe n’imyagazi y’intama indwi imaze umwaka, vyose bitagira agasembwa. <verse eid="NUM 29:8" /><verse number="9" style="v" sid="NUM 29:9" />Impfizi yose izoherekezwa n’ishikanwa ringana na bitatu vya cumi vy’ingero efa y’ifu inoze neza ikaranze mu mavuta; hanyuma ya mpfizi y’intama na yo izoherekezwa n’ibilo bitandatu; <verse eid="NUM 29:9" /><verse number="10" style="v" sid="NUM 29:10" />kandi umwagazi wose muri iyo ndwi uzoherekezwa n’ibilo bitatu. <verse eid="NUM 29:10" /><verse number="11" style="v" sid="NUM 29:11" />Muze mushiremwo n’isuguru y’impene imwe y’ikimazi c’ivyaha, hejuru y’iryo shikanwa ry’ivyaha hamwe n’ibimazi biturirwa biri kumwe n’ishikanwa ry’ifu bijanye, n’amashikanwa y’ibinyobwa.<verse eid="NUM 29:11" /></para>
  <para style="s1">Imisi mikuru y’insago</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12" />Ku musi ugira icumi na gatanu w’uko kwezi kw’indwi, muze mugire ikoraniro ryera kandi ntihagire ico mukora. Muhimbaze umusi mukuru w’<char style="nd">Uhoraho</char> imisi indwi. <verse eid="NUM 29:12" /><verse number="13" style="v" sid="NUM 29:13" />Muze mushikanire <char style="nd">Uhoraho</char> ikimazi co guturirwa nk’ubumote bwiza bunezera <char style="nd">Uhoraho</char>, ikimazi co guturirwa kigizwe n’amashuri icumi n’atatu, impfizi z’intama zibiri n’imyagazi y’intama icumi n’ine imaze umwaka, vyose bibe bitagira agasembwa. <verse eid="NUM 29:13" /><verse number="14" style="v" sid="NUM 29:14" />Ishuri yose muri izo icumi na zitatu ize iherekezwe na bitatu vya cumi vy’ingero efa y’ifu inoze neza ikaranze mu mavuta; hanyuma impfizi y’intama yose ize iherekezwe n’ibilo bitandatu; <verse eid="NUM 29:14" /><verse number="15" style="v" sid="NUM 29:15" />kandi umwagazi wose muri ya myagazi icumi n’ine, uzoherekezwe n’ibilo bitatu. <verse eid="NUM 29:15" /><verse number="16" style="v" sid="NUM 29:16" />Muze mwongereko isuguru y’impene y’ikimazi c’ivyaha, yiyongera ku kimazi co guturirwa cama gitangwa ku musi ku musi n’ishikanwa ry’ifu n’iry’ibinyobwa bijanye.<verse eid="NUM 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17" />Ku musi wa kabiri muze mutegure amashuri icumi n’abiri, impfizi z’intama zibiri n’imyagazi y’intama icumi n’ine imaze umwaka umwe, vyose bibe bitagira agasembwa. <verse eid="NUM 29:17" /><verse number="18" style="v" sid="NUM 29:18" />Kuri ayo mashuri, izo mpfizi z’intama n’iyo myagazi, muze mwongereko amashikanwa y’ifu n’ay’ibinyobwa bijanye mukurikije igitigiri cavuzwe. <verse eid="NUM 29:18" /><verse number="19" style="v" sid="NUM 29:19" />Muze mushiremwo n’isuguru y’impene y’ikimazi c’ivyaha, ciyongera kuri ca kimazi cama gitangwa ku musi ku musi n’ishikanwa ry’ifu bijanye, n’amashikanwa y’ibinyobwa yavyo.<verse eid="NUM 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20" />Ku musi ugira gatatu muze mutegure amashuri icumi n’imwe, impfizi z’intama zibiri n’imyagazi y’intama cumi n’ine imaze umwaka, vyose bibe bitagira agasembwa. <verse eid="NUM 29:20" /><verse number="21" style="v" sid="NUM 29:21" />Kuri ayo mashuri, izo mpfizi z’intama n’iyo myagazi, muze mwongereko amashikanwa y’ifu n’ay’ibinyobwa bijanye mukurikije igitigiri cavuzwe. <verse eid="NUM 29:21" /><verse number="22" style="v" sid="NUM 29:22" />Muze mwongereko isuguru y’impene y’ikimazi c’ivyaha, ciyongera ku kimazi co guturirwa cama gitangwa ku musi ku musi n’amashikanwa y’ifu n’ibinyobwa bijanye.<verse eid="NUM 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23" />Ku musi ugira kane muze mutegure amashuri icumi, impfizi z’intama zibiri n’imyagazi y’intama icumi n’ine imaze umwaka, vyose bibe bitagira agasembwa. <verse eid="NUM 29:23" /><verse number="24" style="v" sid="NUM 29:24" />Kuri ayo mashuri, izo mpfizi z’intama n’iyo myagazi, muze mwongereko amashikanwa y’ifu n’ay’ibinyobwa bijanye mukurikije igitigiri cavuzwe. <verse eid="NUM 29:24" /><verse number="25" style="v" sid="NUM 29:25" />Muze mwongereko isuguru y’impene y’ikimazi c’ivyaha, yiyongera ku kimazi co guturirwa cama gitangwa ku musi ku musi n’ishikanwa ry’ifu n’iry’ibinyobwa bijanye.<verse eid="NUM 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26" />Ku musi ugira gatanu muze mutegure amashuri icenda, impfizi z’intama zibiri n’imyagazi y’intama icumi n’ine imaze umwaka, vyose bibe bitagira agasembwa. <verse eid="NUM 29:26" /><verse number="27" style="v" sid="NUM 29:27" />Kuri ayo mashuri, izo mpfizi z’intama n’iyo myagazi, muze mwongereko amashikanwa y’ifu n’ay’ibinyobwa bijanye mukurikije igitigiri cavuzwe. <verse eid="NUM 29:27" /><verse number="28" style="v" sid="NUM 29:28" />Muze mwongereko isuguru y’impene y’ikimazi c’ivyaha, ciyongera ku kimazi co guturirwa cama gitangwa ku musi ku musi n’ishikanwa ry’ifu n’iry’ibinyobwa bijanye.<verse eid="NUM 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29" />Ku musi ugira gatandatu muze mutegure amashuri umunani, impfizi z’intama zibiri n’imyagazi y’intama icumi n’ine imaze umwaka, vyose bibe bitagira agasembwa. <verse eid="NUM 29:29" /><verse number="30" style="v" sid="NUM 29:30" />Kuri ayo mashuri, izo mpfizi z’intama n’iyo myagazi, muze mwongereko amashikanwa y’ifu n’ay’ibinyobwa bijanye mukurikije igitigiri cavuzwe. <verse eid="NUM 29:30" /><verse number="31" style="v" sid="NUM 29:31" />Muze mwongereko isuguru y’impene y’ikimazi c’ivyaha, ciyongera ku kimazi co guturirwa cama gitangwa ku musi ku musi n’amashikanwa y’ifu n’ibinyobwa bijanye.<verse eid="NUM 29:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32" />Ku musi ugira indwi muze mutegure amashuri indwi, impfizi z’intama zibiri n’imyagazi y’intama icumi n’ine imaze umwaka, vyose bibe bitagira agasembwa. <verse eid="NUM 29:32" /><verse number="33" style="v" sid="NUM 29:33" />Kuri ayo mashuri, izo mpfizi z’intama n’iyo myagazi, muze mwongereko amashikanwa y’ifu n’ay’ibinyobwa bijanye mukurikije igitigiri cavuzwe. <verse eid="NUM 29:33" /><verse number="34" style="v" sid="NUM 29:34" />Muze mwongereko isuguru y’impene y’ikimazi c’ivyaha, ciyongera ku kimazi co guturirwa cama gitangwa ku musi ku musi n’amashikanwa y’ifu n’ibinyobwa bijanye.<verse eid="NUM 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35" />Ku musi ugira umunani muze mugire ikoraniro ryera kandi ntihagire ico mukora. <verse eid="NUM 29:35" /><verse number="36" style="v" sid="NUM 29:36" />Muze mutange ikimazi co guturirwa ubumote bwiza buhimbara <char style="nd">Uhoraho</char>, ikimazi co guturirwa kigizwe n’ishuri imwe, impfizi y’intama imwe n’imyagazi y’intama imaze umwaka, vyose bibe bitagira agasembwa. <verse eid="NUM 29:36" /><verse number="37" style="v" sid="NUM 29:37" />Kuri iyo shuri, iyo mpfizi y’intama, n’iyo myagazi, muze mwongereko amashikanwa y’ifu n’amashikanwa y’ibinyobwa bijanye mukurikije ibitigiri vyatanzwe. <verse eid="NUM 29:37" /><verse number="38" style="v" sid="NUM 29:38" />Muze mwongereko isuguru y’impene y’ikimazi c’ivyaha, ciyongera ku kimazi co guturirwa cama gitangwa ku musi ku musi n’ishikanwa ry’ifu n’iry’ibinyobwa bijanye.<verse eid="NUM 29:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39" />Ivyo bimazi vyose muze mubishikanire <char style="nd">Uhoraho</char> ku misi mikuru uko yashinzwe. Mushobora kwongerako ivyo musezerana muvyishakiye bivuye ku mitima yanyu. Muze mutegurire <char style="nd">Uhoraho</char> mu misi mikuru: ibimazi vyanyu vyo kwoswa, amashikanwa y’ifu, amashikanwa y’ibinyobwa n’ibimazi vy’ishimwe.’ ”<verse eid="NUM 29:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 29:40" />Mose abarira Abisirayeli ivyo <char style="nd">Uhoraho</char> yamutegetse vyose.<verse eid="NUM 29:40" /></para>
  <chapter eid="NUM 29" />
  <chapter number="30" style="c" sid="NUM 30" />
  <para style="s1">Amasezerano</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1" />Nuko Mose amenyesha abakuru b’imiryango y’Abisirayeli ati: “Ibi ni vyo <char style="nd">Uhoraho</char> yategetse: <verse eid="NUM 30:1" /><verse number="2" style="v" sid="NUM 30:2" />Umuntu niyasezeranira <char style="nd">Uhoraho</char> gukora ikintu kanaka akagisezerana ashizeko n’indahiro, ntaze yirahuruze ariko aze ashire mu ngiro ivyo yavuze.<verse eid="NUM 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3" />Umukobwa akiri mu nzu kwa se niyasezeranira <char style="nd">Uhoraho</char> kumushikanira ishikanwa canke kudakora ikintu ashizeko indahiro <verse eid="NUM 30:3" /><verse number="4" style="v" sid="NUM 30:4" />hanyuma se wiwe akavyumva ariko ntagire ico abarira umukobwa wiwe, ivyo yasezeranye n’ivyo yarahiye bizogumaho. <verse eid="NUM 30:4" /><verse number="5" style="v" sid="NUM 30:5" />Ariko se wiwe niyamubuza amaze kuvyumva, nta na kimwe mu vyo yasezeranye canke yarahiye gushitsa kizofata; <char style="nd">Uhoraho</char> azomubohora kuko se wiwe yamubujije.<verse eid="NUM 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 30:6" />Niyagira ubukwe amaze kurahira canke iminwa yiwe imaze guhurudukana isezerano rimuboha <verse eid="NUM 30:6" /><verse number="7" style="v" sid="NUM 30:7" />hanyuma umugabo wiwe akavyumva ariko ntagire ico amubwira, ivyo yasezeranye n’iyo ndahiro bizogumaho. <verse eid="NUM 30:7" /><verse number="8" style="v" sid="NUM 30:8" />Ariko umugabo wiwe niyavyumva hanyuma akamubuza, azoba ahagaritse iryo sezerano ryamuboha canke iyo ndahiro yapfuye kuvuga atiyumviriye neza ikamuboha, kandi <char style="nd">Uhoraho</char> azomubohora.<verse eid="NUM 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 30:9" />Isezerano canke indahiro bigizwe n’umupfakazi canke uwahukanye bizomuboha.<verse eid="NUM 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10" />Umugore abana n’umugabo wiwe niyasezerana isezerano canke akarahira indahiro imuboha <verse eid="NUM 30:10" /><verse number="11" style="v" sid="NUM 30:11" />hanyuma umugabo wiwe akavyumva ariko ntagire ico amubwira kandi ntamubuze, ivyo yasezeranye vyose n’ivyo yarahiye vyose bizogumaho. <verse eid="NUM 30:11" /><verse number="12" style="v" sid="NUM 30:12" />Ariko uwo mugabo wiwe amaze kwumva ivyo yasezeranye agaca abihagarika ubwo nyene akivyumva iryo sezerano canke iyo ndahiro bizoba bihagaze. Umugabo wiwe azoba yabihinduye kandi <char style="nd">Uhoraho</char> azomubohora. <verse eid="NUM 30:12" /><verse number="13" style="v" sid="NUM 30:13" />Umugabo wiwe ashobora kwemeza canke guhakana ivyo yibohesheje. <verse eid="NUM 30:13" /><verse number="14" style="v" sid="NUM 30:14" />Ariko umugabo wiwe natagira ico abimubwirako hagaca umusi wose, azoba yemeje ivyo uwo mugore yasezeranye n’indahiro yarahiye zizomuboha. Azoba avyemeje kuko ata co yavuze amaze kuvyumva. <verse eid="NUM 30:14" /><verse number="15" style="v" sid="NUM 30:15" />Ariko uwo mugabo niyabihindura amaze igihe avyumvise, ivyo uwo mugore yasezeranye bizoja ku mutwe w’uwo mugabo.”<verse eid="NUM 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16" />Ayo ni yo mategeko <char style="nd">Uhoraho</char> yahaye Mose yerekeye imigenderanire hagati y’umugabo n’umugore wiwe, no hagati ya se n’umukobwa wiwe akiba mu nzu iwe.<verse eid="NUM 30:16" /></para>
  <chapter eid="NUM 30" />
  <chapter number="31" style="c" sid="NUM 31" />
  <para style="s1">Abisirayeli bihora Abamidiyani</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 31:1" /><verse number="2" style="v" sid="NUM 31:2" />“Genda utere Abamidiyani ubahoye ivyo bakoreye Abisirayeli. Inyuma y’aho uzoca uhamvya abanyu.”<verse eid="NUM 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3" />Nuko Mose abarira abantu ati: “Nihagire abantu bo muri mwebwe bambara ibigwanisho baje kugwanya Abamidiyani kugira ngo bashitse uguhora kw’<char style="nd">Uhoraho</char> kuri bo. <verse eid="NUM 31:3" /><verse number="4" style="v" sid="NUM 31:4" />Umuryango wose mu Bisirayeli urungike abagabo igihumbi.” <verse eid="NUM 31:4" /><verse number="5" style="v" sid="NUM 31:5" />Nuko abagabo ibihumbi cumi na bibiri mu Bisirayeli bambara ibigwanisho bitegurira kuja mu ntambara, umuryango wose urungika abagabo igihumbi. <verse eid="NUM 31:5" /><verse number="6" style="v" sid="NUM 31:6" />Mose abarungika mu ntambara, ari igihumbi ku muryango wose, abarungikana Finehasi mwene Eliyazeri, umuherezi, ari we yatwaye ibikoresho vyera vyo mw’ihema hamwe n’inzamba zo gutanga ikimenyetso c’akamo k’intambara.<verse eid="NUM 31:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 31:7" />Bagwanya Abamidiyani, nk’uko <char style="nd">Uhoraho</char> yategetse Mose, bica abagabo bose. <verse eid="NUM 31:7" /><verse number="8" style="v" sid="NUM 31:8" />Mu bo bishe harimwo Evi, Rekemu, Zuri, Huri na Reba, abami batanu b’i Midiyani. Bicisha inkota na Balamu mwene Beyori. <verse eid="NUM 31:8" /><verse number="9" style="v" sid="NUM 31:9" />Abisirayeli bafata mpiri abagore n’abana b’Abamidiyani batwara n’amasho y’Abamidiyani, n’imikuku n’ibindi vyiza vyose. <verse eid="NUM 31:9" /><verse number="10" style="v" sid="NUM 31:10" />Baturira ibisagara vyose Abamidiyani babamwo, n’amakambi yabo. <verse eid="NUM 31:10" /><verse number="11" style="v" sid="NUM 31:11" />Batwara ibintu vyose n’abantu ivyo bari bigaruriye vyose, <verse eid="NUM 31:11" /><verse number="12" style="v" sid="NUM 31:12" />babizanira Mose na Eliyazeri umuherezi n’ikoraniro ry’Abisirayeli bose aho bari bacumbitse mu biyaya vy’i Mowabu, ku nkombe ya Yorodani aharabana n’i Yeriko.<verse eid="NUM 31:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13" />Mose, Eliyazeri umuherezi n’abakuru b’abantu bose baja kubasanganirira hanze y’aho bakoraniye. <verse eid="NUM 31:13" /><verse number="14" style="v" sid="NUM 31:14" />Mose ashavurira abakuru b’ingabo; abarongoye ingabo igihumbi n’abatwara ingabo ijana; bari bavuye mu ntambara.<verse eid="NUM 31:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 31:15" />Arababarira ati: “Mbega mwakoze iki ko mwaretse abagore ntimubice? <verse eid="NUM 31:15" /><verse number="16" style="v" sid="NUM 31:16" />Ni bo bakurikije inama bagiriwe na Balamu kandi ni bo batumye Abisirayeli bakevya bakava k’<char style="nd">Uhoraho</char> mu vyabaye i Peyori, gushika n’aho ikiza gitera abantu. <verse eid="NUM 31:16" /><verse number="17" style="v" sid="NUM 31:17" />Ubu rero nimwice abahungu bose. Kandi mwice umugore wese yaryamanye n’umugabo, <verse eid="NUM 31:17" /><verse number="18" style="v" sid="NUM 31:18" />ariko mwisigarize abakobwa bose batigeze baryamana n’umugabo.<verse eid="NUM 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 31:19" />Umuntu wese wo muri mwebwe yishe umuntu canke yakoze ku wapfuye agume inyuma y’aho mucumbitse kumara imisi indwi. Ku musi wa gatatu no ku musi w’indwi muze mwihumanure mwebwe n’abanyagano banyu. <verse eid="NUM 31:19" /><verse number="20" style="v" sid="NUM 31:20" />Muhumanure n’impuzu zose n’ikintu cose gikozwe mu rusato, mu bwoya bw’impene canke mu biti.”<verse eid="NUM 31:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21" />Nuko Eliyazeri umuherezi abarira ingabo zagiye ku rugamba ati: “Ibi ni vyo Ivyagezwe <char style="nd">Uhoraho</char> yahaye Mose bivuga: <verse eid="NUM 31:21" /><verse number="22" style="v" sid="NUM 31:22" />Inzahabu, ifeza, imiringa, ivyuma, n’ubundi butare <verse eid="NUM 31:22" /><verse number="23" style="v" sid="NUM 31:23" />mbere n’ibindi vyose bidashobora gusha bize bishirwe mu muriro, ni ho bizoba bihumanuwe. Ariko kandi bize bihumanurwe n’amazi yo guhumanura. Kandi ikintu cose kidashobora kurinda umuriro, kize gicishwe muri ayo mazi. <verse eid="NUM 31:23" /><verse number="24" style="v" sid="NUM 31:24" />Ku musi w’indwi muze mumesure impuzu zanyu namwe muzoba muhumanuwe. Ni ho muzoshobora kwinjira aho ducumbitse.”<verse eid="NUM 31:24" /></para>
  <para style="s1">Ivyo kugabura isahu</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 31:25" /><verse number="26" style="v" sid="NUM 31:26" />“Wewe na Eliyazeri umuherezi n’abakuru b’imiryango y’ubu bwoko muze muharure abantu n’ibitungwa vyanyazwe. <verse eid="NUM 31:26" /><verse number="27" style="v" sid="NUM 31:27" />Mugaburire ivyanyazwe abagabo bagiye kugwana n’abasigaye bo mw’ikoraniro. <verse eid="NUM 31:27" /><verse number="28" style="v" sid="NUM 31:28" />Ku mugabane w’abasoda bagwanye mu ntambara, uze ukureko umugabane wanje jewe <char style="nd">Uhoraho</char> ungana n’ikintu kimwe ku bintu amajana atanu, baba ari abantu, amasho, indogoba intama canke impene. <verse eid="NUM 31:28" /><verse number="29" style="v" sid="NUM 31:29" />Uze wakire uwo mugabane ku mugabane wabo uwushikirize Eliyazeri umuherezi nk’umugabane w’<char style="nd">Uhoraho</char>. <verse eid="NUM 31:29" /><verse number="30" style="v" sid="NUM 31:30" />Ku mugabane w’Abisirayeli, muze mutoranye kimwe ku bintu mirongo itanu, baba abantu, amasho, indogoba, intama, impene canke ibindi bitungwa vyose. Muze mubihe Abalewi, bashinzwe gutunganya ihema ry’<char style="nd">Uhoraho</char>.” <verse eid="NUM 31:30" /><verse number="31" style="v" sid="NUM 31:31" />Nuko Mose na Eliyazeri umuherezi bakora nk’uko <char style="nd">Uhoraho</char> yari yategetse Mose.<verse eid="NUM 31:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 31:32" />Ivyasigaye mu vyo abagiye ku rugamba banyaze vyari intama amajana atandatu na mirongo indwi na bitanu, <verse eid="NUM 31:32" /><verse number="33" style="v" sid="NUM 31:33" />inka ibihumbi mirongo indwi na bibiri, <verse eid="NUM 31:33" /><verse number="34" style="v" sid="NUM 31:34" />indogoba ibihumbi mirongo itandatu na kimwe <verse eid="NUM 31:34" /><verse number="35" style="v" sid="NUM 31:35" />n’abakobwa batigeze baryamana n’umugabo ibihumbi mirongo itatu na bibiri.<verse eid="NUM 31:35" /></para>
  <para style="lh">
    <verse number="36" style="v" sid="NUM 31:36" />Igice cegukira abagiye ku rugamba cari:</para>
  <para style="b" vid="NUM 31:36" />
  <para style="li1" vid="NUM 31:36">Intama ibihumbi amajana atatu na mirongo itatu n’indwi n’amajana atanu, <verse eid="NUM 31:36" /><verse number="37" style="v" sid="NUM 31:37" />muri izo umugabane w’<char style="nd">Uhoraho</char> ukaba wari intama amajana atandatu na mirongo indwi na zitanu;<verse eid="NUM 31:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 31:38" />inka ibihumbi mirongo itatu na bitandatu, muri izo umugabane w’<char style="nd">Uhoraho</char> ukaba wari inka mirongo indwi na zibiri;<verse eid="NUM 31:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="NUM 31:39" />indogoba ibihumbi mirongo itatu n’amajana atanu, muri izo umugabane w’<char style="nd">Uhoraho</char> ukaba wari indogoba mirongo itandatu n’imwe;<verse eid="NUM 31:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="NUM 31:40" />abantu ibihumbi cumi na bitandatu, muri bo umugabane w’<char style="nd">Uhoraho</char> ukaba wari abantu mirongo itatu na babiri.<verse eid="NUM 31:40" /></para>
  <para style="b" />
  <para style="p">
    <verse number="41" style="v" sid="NUM 31:41" />Mose aha wa mugabane w’<char style="nd">Uhoraho</char> Eliyazeri umuherezi, nk’uko <char style="nd">Uhoraho</char> yategetse Mose.<verse eid="NUM 31:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 31:42" />Igice cegukira Abisirayeli, ico Mose yari yashize ukwaco agitandukanya n’ic’abagiye ku rugamba; <verse eid="NUM 31:42" /><verse number="43" style="v" sid="NUM 31:43" />ari co gice cagerewe abasigaye; cari intama ibihumbi amajana atatu na mirongo itatu n’indwi n’amajana atanu, <verse eid="NUM 31:43" /><verse number="44" style="v" sid="NUM 31:44" />inka ibihumbi mirongo itatu na bitandatu, <verse eid="NUM 31:44" /><verse number="45" style="v" sid="NUM 31:45" />indogoba ibihumbi mirongo itatu n’amajana atanu <verse eid="NUM 31:45" /><verse number="46" style="v" sid="NUM 31:46" />n’abantu ibihumbi cumi na bitandatu. <verse eid="NUM 31:46" /><verse number="47" style="v" sid="NUM 31:47" />Mu vyagenewe Abisirayeli, Mose akuramwo kimwe ku mirongo itanu baba abantu canke ibitungwa, nk’uko <char style="nd">Uhoraho</char> yari yamutegetse, aca abiha Abalewi, ari bo bari bajejwe igikorwa co gutunganya ihema ry’<char style="nd">Uhoraho</char>.<verse eid="NUM 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48" />Maze abakuru b’ingabo bari barongoye imice y’ingabo, baba abatwara imice y’abantu igihumbi canke abatwara imice y’abantu ijana, baja aho Mose ari, <verse eid="NUM 31:48" /><verse number="49" style="v" sid="NUM 31:49" />baramubwira bati: “twebwe abasavyi bawe twaharuye ingabo turongoye, kandi nta n’umwe abuze. <verse eid="NUM 31:49" /><verse number="50" style="v" sid="NUM 31:50" />None twari tuzanye ishikanwa k’<char style="nd">Uhoraho</char> ry’ibikoresho vyose bikozwe mu nzahabu twaronse: imigufu, ivyo kwambara ku maboko, impeta, ivyo ku matwi; ngo tubitangeko ikimazi cacu co kwikurako icaha imbere y’<char style="nd">Uhoraho</char>.”<verse eid="NUM 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 31:51" />Mose na Eliyazeri umuherezi babakirira izo nzahabu zari mu vyacuzwe vyose. <verse eid="NUM 31:51" /><verse number="52" style="v" sid="NUM 31:52" />Inzahabu zatanzwe n’abarongoye imice y’ingabo igihumbi n’ijana izo Mose na Eliyazeri bashikaniye <char style="nd">Uhoraho</char> zapimye shekeli ibihumbi cumi na bitandatu n’amajana indwi na mirongo itanu.<note caller="+" style="f"><char style="fr" closed="false">31:52 </char><char style="ft" closed="false">Ni nk’ibilo 190.</char></note> <verse eid="NUM 31:52" /><verse number="53" style="v" sid="NUM 31:53" />Uwagiye ku rugamba wese yatwaye isahu yari yazanye. <verse eid="NUM 31:53" /><verse number="54" style="v" sid="NUM 31:54" />Mose na Eliyazeri umuherezi bakira ivyo abo bakuru b’ingabo igihumbi n’ijana batanze bavyinjiza mw’Ihema ry’Ibonaniro nk’icibutso ku Bisirayeli imbere y’<char style="nd">Uhoraho</char>.<verse eid="NUM 31:54" /></para>
  <chapter eid="NUM 31" />
  <chapter number="32" style="c" sid="NUM 32" />
  <para style="s1">Imiryango yagabanye mu buseruko bwa Yorodani</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1" />Abareyubeni n’Abagadi, ari bo bari bafise amasho menshi n’imikuku myinshi, babona ko intara za Yazeri na Gileyadi zari nziza ku bitungwa. <verse eid="NUM 32:1" /><verse number="2" style="v" sid="NUM 32:2" />Nuko baza aho Mose, Eliyazeri umuherezi n’abakuru b’abantu bari bari, baravuga bati: <verse eid="NUM 32:2" /><verse number="3" style="v" sid="NUM 32:3" />“Ibisagara vy’i Ataroti, Diboni, Yazeri, Nimura, Heshiboni, Eliyalehi, Sebamu, Nebo na Beyoni; <verse eid="NUM 32:3" /><verse number="4" style="v" sid="NUM 32:4" />intara <char style="nd">Uhoraho</char> yagabuye mu maboko y’Abisirayeli, ni ahantu heza ku bitungwa, kandi twebwe abasavyi banyu turafise ibitungwa. <verse eid="NUM 32:4" /><verse number="5" style="v" sid="NUM 32:5" />Nitwaba tugiriwe ubuntu imbere yanyu, twemerere aha hantu hatwegukire nk’umugabane wacu. Twebwe ntitujabuke hakurya ya Yorodani.”<verse eid="NUM 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6" />Mose abarira Abagadi n’Abareyubeni ati: “Abanyu boja mu ntambara namwe mwiyicariye ngaho? <verse eid="NUM 32:6" /><verse number="7" style="v" sid="NUM 32:7" />Ni kuki mugomba guca intege Abisirayeli ngo ntibajabuke mu gihugu <char style="nd">Uhoraho</char> aduhaye? <verse eid="NUM 32:7" /><verse number="8" style="v" sid="NUM 32:8" />Ivyo ni vyo ba so bakoze igihe nabarungika turi i Kadeshi Baruneya ngo bagende gutata ico gihugu. <verse eid="NUM 32:8" /><verse number="9" style="v" sid="NUM 32:9" />Bamaze kuduga bajanye akabande k’i Eshikoli bararaba ico gihugu, bagarutse baciye intege Abisirayeli ngo ntibinjire ico gihugu <char style="nd">Uhoraho</char> yabahaye. <verse eid="NUM 32:9" /><verse number="10" style="v" sid="NUM 32:10" />Ishavu ry’<char style="nd">Uhoraho</char> ryaraduze aca ararahira kuri uwo musi ati: <verse eid="NUM 32:10" /><verse number="11" style="v" sid="NUM 32:11" />‘Kuko batankurikiye n’umutima wose, nta n’umwe mu bantu bafise imyaka mirongo ibiri n’iyirenga yavuye muri Egiputa azobona igihugu nasezeraniye Aburahamu na Isaka na Yakobo; <verse eid="NUM 32:11" /><verse number="12" style="v" sid="NUM 32:12" />nta n’umwe atari Kalebu mwene Yefune Umunyakenizi na Yosuwa mwene Nuni, kuko bakurikiye <char style="nd">Uhoraho</char> n’umutima wose.’ <verse eid="NUM 32:12" /><verse number="13" style="v" sid="NUM 32:13" />Ishavu ry’<char style="nd">Uhoraho</char> ryaraziririnze ku Bisirayeli atuma bayerera mu bugaragwa imyaka mirongo ine, gushika aho urunganwe rwose rw’abari bakoze ibibi mu nyonga ziwe ruherengetera.<verse eid="NUM 32:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 32:14" />None ehe raba namwe, mwa kagwi k’abanyavyaha, muhagaze mu kibanza ca ba so mugomba gutuma <char style="nd">Uhoraho</char> ashavurira Abisirayeli mbere birengeje. <verse eid="NUM 32:14" /><verse number="15" style="v" sid="NUM 32:15" />Nimwamutera umugongo, azosubira ate iri hanga ryose muri ubu bugaragwa, kandi ni mwebwe muzoba mubaye impamvu y’uguhona kwabo.”<verse eid="NUM 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16" />Nuko basubira kuza aho ari baravuga bati: “Twagomba kwubaka impongore z’ibitungwa vyacu hano n’ibisagara vy’abagore bacu n’abana bacu. <verse eid="NUM 32:16" /><verse number="17" style="v" sid="NUM 32:17" />Ariko turiteguye kwambara ibigwanisho no kuja imbere y’Abisirayeli gushika tubashikanye iwabo. Muri ico gihe abagore bacu n’abana bacu bazoba baba mu bisagara vyubakiwe inzitiro, kugira ngo bakingirwe abantu b’iki gihugu. <verse eid="NUM 32:17" /><verse number="18" style="v" sid="NUM 32:18" />Ntituzotaha ngo tuje mu mazu yacu gushika aho Umwisirayeli wese azoba amaze kuronka umugabane wiwe. <verse eid="NUM 32:18" /><verse number="19" style="v" sid="NUM 32:19" />Ntituzoronka umugabane hamwe na bo hakurya ya Yorodani, kuko umugabane wacu uzoba uri ngaha mu buseruko bwa Yorodani.”<verse eid="NUM 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20" />Nuko Mose arababarira ati: “Nimwakora uko, nimwambara ibigwanisho imbere y’<char style="nd">Uhoraho</char> mukagwana, <verse eid="NUM 32:20" /><verse number="21" style="v" sid="NUM 32:21" />nimwajabuka Yorodani mwese mwambaye ibigwanisho imbere y’<char style="nd">Uhoraho</char> gushika yirukanye abansi biwe, <verse eid="NUM 32:21" /><verse number="22" style="v" sid="NUM 32:22" />igihugu nicafatwa imbere y’<char style="nd">Uhoraho</char>, mushobora kugaruka mukaba abidegemvya imbere y’<char style="nd">Uhoraho</char> n’imbere y’Abisirayeli. Kandi aha hantu hazobegukira imbere y’<char style="nd">Uhoraho</char>.<verse eid="NUM 32:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 32:23" />Ariko nimutakora mutyo, muzoba mucumuye k’<char style="nd">Uhoraho</char>; kandi mumenye ko icaha canyu kizobakurikirana. <verse eid="NUM 32:23" /><verse number="24" style="v" sid="NUM 32:24" />Nimwubake ibisagara vy’abagore banyu n’abana banyu n’impongore z’ibitungwa vyanyu, ariko muze mushitse ivyo mwasezeranye.”<verse eid="NUM 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25" />Abagadi n’Abareyubeni babarira Mose bati: “Twebwe abasavyi bawe tuzokora nk’uko <char style="nd">Uhoraho</char> abidutegeka. <verse eid="NUM 32:25" /><verse number="26" style="v" sid="NUM 32:26" />Abana bacu n’abagore bacu n’amasho yacu n’imikuku yacu bizoguma hano mu bisagara vy’i Gileyadi. <verse eid="NUM 32:26" /><verse number="27" style="v" sid="NUM 32:27" />Ariko abasavyi bawe, umugabo wese yambaye ibigwanisho, tuzojabuka tugwane imbere y’<char style="nd">Uhoraho</char>, nk’uko wabivuze nyakwubahwa.”<verse eid="NUM 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28" />Maze Mose atanga amategeko aberekeye ayaha Eliyazeri umuherezi na Yosuwa mwene Nuni n’abakuru b’imiryango y’Abisirayeli. <verse eid="NUM 32:28" /><verse number="29" style="v" sid="NUM 32:29" />Arababarira ati: “Abagadi n’Abareyubeni, umugabo wese niyambara ibigwanisho, bakajabukana namwe Yorodani imbere y’<char style="nd">Uhoraho</char>, igihe igihugu kizoba kimaze gufatwa, muze mubahe igihugu c’i Gileyadi nk’umugabane wabo. <verse eid="NUM 32:29" /><verse number="30" style="v" sid="NUM 32:30" />Ariko nibatajabukana namwe bambaye ibigwanisho, baze bemere basangire namwe umugabane i Kanani.”<verse eid="NUM 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31" />Abagadi n’Abareyubeni barishura bati: “Abasavyi bawe tuzokora nk’uko <char style="nd">Uhoraho</char> yavuze. <verse eid="NUM 32:31" /><verse number="32" style="v" sid="NUM 32:32" />Tuzojabuka muri Kanani imbere y’<char style="nd">Uhoraho</char> kandi twambaye ibigwanisho, ariko umugabane wacu uzoba hakuno ya Yorodani.”<verse eid="NUM 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33" />Nuko Mose aha Abagadi, Abareyubeni n’igice c’Abamanase bakomoka kuri Yosefu ubwami bwari ubwa Sihoni umwami w’Abamori n’ubwami bwa Ogi umwami w’i Bashani; igihugu cose n’ibisagara vyaho n’intara zihakikije.<verse eid="NUM 32:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 32:34" />Abagadi basubira kwubaka Diboni, Ataroti, Aroweri, <verse eid="NUM 32:34" /><verse number="35" style="v" sid="NUM 32:35" />Aturoti-Shofani, Yazeri, Yogibeha, <verse eid="NUM 32:35" /><verse number="36" style="v" sid="NUM 32:36" />Beti-Nimura n’i Beti-Harani nk’ibisagara bizitijwe inzitiro, kandi bubaka impongore z’ibitungwa vyabo. <verse eid="NUM 32:36" /><verse number="37" style="v" sid="NUM 32:37" />Abareyubeni na bo basubira kwubaka i Heshiboni, i Eliyalehi, i Kiriyatayimu, <verse eid="NUM 32:37" /><verse number="38" style="v" sid="NUM 32:38" />i Nebo, i Bayali-Meyoni (aya mazina yarahinduwe) n’i Sibuma. Ibisagara basubiyemwo baciye babiha ayandi mazina.<verse eid="NUM 32:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39" />Abakomoka mu ruvyaro rwa Makiri mwene Manase baja i Gileyadi, barahafata basohora Abamori bari ngaho. <verse eid="NUM 32:39" /><verse number="40" style="v" sid="NUM 32:40" />Nuko Mose aha Gileyadi Abamakiri, bakomoka kuri Manase, baca barahaba. <verse eid="NUM 32:40" /><verse number="41" style="v" sid="NUM 32:41" />Yayiro, wo mu ruvyaro rwa Manase, afata ibigwati vyaho aca avyita Havoti Yayiro risobanurwa ngo ibigwati vy’i Yayiro. <verse eid="NUM 32:41" /><verse number="42" style="v" sid="NUM 32:42" />Noba afata i Kenati n’ibigwati bihakikije aca ahita Nobati nk’uko izina ryiwe ryari.<verse eid="NUM 32:42" /></para>
  <chapter eid="NUM 32" />
  <chapter number="33" style="c" sid="NUM 33" />
  <para style="s1">Urugendo rw’Abisirayeli kuva muri Egiputa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1" />Uku ni ko urugendo rw’Abisirayeli rwagenze uhereye igihe bava muri Egiputa bari mu migwi barongowe na Mose na Aroni. <verse eid="NUM 33:1" /><verse number="2" style="v" sid="NUM 33:2" />Mose yandika aho baciye hose mu rugendo rwabo abitegetswe n’<char style="nd">Uhoraho</char>. Aha ni ho bagiye barahagarara:<verse eid="NUM 33:2" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="3" style="v" sid="NUM 33:3" />Abisirayeli bavuye i Ramusesi ku musi ugira icumi na gatanu w’ukwezi kwa mbere, umusi wakurikira Pasika. Basohokana icubahiro imbere y’Abanyegiputa babaraba, <verse eid="NUM 33:3" /><verse number="4" style="v" sid="NUM 33:4" />bariko barahamba imfura zabo, <char style="nd">Uhoraho</char> yari yahoneje; kuko <char style="nd">Uhoraho</char> yari yaciriye urubanza imana zabo.<verse eid="NUM 33:4" /></para>
  <para style="pi1">
    <verse number="5" style="v" sid="NUM 33:5" />Abisirayeli bava i Ramusesi bacumbika i Sukoti.<verse eid="NUM 33:5" /></para>
  <para style="pi1">
    <verse number="6" style="v" sid="NUM 33:6" />Bava i Sukoti bacumbika i Etamu, ku nkengera y’ubugaragwa.<verse eid="NUM 33:6" /></para>
  <para style="pi1">
    <verse number="7" style="v" sid="NUM 33:7" />Bava i Etamu, basubira inyuma baja i Pi Hahiroti, berekeye mu buseruko bw’i Bayali-Zefoni, baca bacumbika hafi y’i Migidoli.<verse eid="NUM 33:7" /></para>
  <para style="pi1">
    <verse number="8" style="v" sid="NUM 33:8" />Bava i Pi Hahiroti baca mu kiyaga bashika mu bugaragwa, bamaze kugenda imisi itatu mu bugaragwa bw’i Etamu, bacumbika i Mara.<verse eid="NUM 33:8" /></para>
  <para style="pi1">
    <verse number="9" style="v" sid="NUM 33:9" />Bava i Mara baja i Elimu, hari amariba icumi n’abiri n’ibigazi mirongo indwi, baca bacumbikaho.<verse eid="NUM 33:9" /></para>
  <para style="pi1">
    <verse number="10" style="v" sid="NUM 33:10" />Bava i Elimu bacumbika ku Kiyaga Gitukura.<verse eid="NUM 33:10" /></para>
  <para style="pi1">
    <verse number="11" style="v" sid="NUM 33:11" />Bava ku Kiyaga Gitukura bacumbika mu bugaragwa bw’i Sini.<verse eid="NUM 33:11" /></para>
  <para style="pi1">
    <verse number="12" style="v" sid="NUM 33:12" />Bava mu bugaragwa bw’i Sini bacumbika i Dofuka.<verse eid="NUM 33:12" /></para>
  <para style="pi1">
    <verse number="13" style="v" sid="NUM 33:13" />Bava i Dofuka bacumbika i Alushi.<verse eid="NUM 33:13" /></para>
  <para style="pi1">
    <verse number="14" style="v" sid="NUM 33:14" />Bava i Alushi bacumbika i Refidimu, aho abantu babuze amazi yo kunywa.<verse eid="NUM 33:14" /></para>
  <para style="pi1">
    <verse number="15" style="v" sid="NUM 33:15" />Bava i Refidimu bacumbika mu bugaragwa bw’i Sinayi.<verse eid="NUM 33:15" /></para>
  <para style="pi1">
    <verse number="16" style="v" sid="NUM 33:16" />Bava mu bugaragwa bw’i Sinayi bacumbika i Kiburoti Hatayava.<verse eid="NUM 33:16" /></para>
  <para style="pi1">
    <verse number="17" style="v" sid="NUM 33:17" />Bava i Kiburoti Hatayava bacumbika i Hazeroti.<verse eid="NUM 33:17" /></para>
  <para style="pi1">
    <verse number="18" style="v" sid="NUM 33:18" />Bava i Hazeroti bacumbika i Rituma.<verse eid="NUM 33:18" /></para>
  <para style="pi1">
    <verse number="19" style="v" sid="NUM 33:19" />Bava i Rituma bacumbika i Rimoni Peresi.<verse eid="NUM 33:19" /></para>
  <para style="pi1">
    <verse number="20" style="v" sid="NUM 33:20" />Bava i Rimoni Peresi bacumbika i Libuna.<verse eid="NUM 33:20" /></para>
  <para style="pi1">
    <verse number="21" style="v" sid="NUM 33:21" />Bava i Libuna bacumbika i Risa.<verse eid="NUM 33:21" /></para>
  <para style="pi1">
    <verse number="22" style="v" sid="NUM 33:22" />Bava i Risa bacumbika i Kehelata.<verse eid="NUM 33:22" /></para>
  <para style="pi1">
    <verse number="23" style="v" sid="NUM 33:23" />Bava i Kehelata bacumbika ku Musozi Sheferi.<verse eid="NUM 33:23" /></para>
  <para style="pi1">
    <verse number="24" style="v" sid="NUM 33:24" />Bava ku musozi Sheferi bacumbika i Harada.<verse eid="NUM 33:24" /></para>
  <para style="pi1">
    <verse number="25" style="v" sid="NUM 33:25" />Bava i Harada bacumbika i Makeloti.<verse eid="NUM 33:25" /></para>
  <para style="pi1">
    <verse number="26" style="v" sid="NUM 33:26" />Bava i Makeloti bacumbika i Tahati.<verse eid="NUM 33:26" /></para>
  <para style="pi1">
    <verse number="27" style="v" sid="NUM 33:27" />Bava i Tahati bacumbika i Tera<verse eid="NUM 33:27" /></para>
  <para style="pi1">
    <verse number="28" style="v" sid="NUM 33:28" />Bava i Tera bacumbika i Mituka<verse eid="NUM 33:28" /></para>
  <para style="pi1">
    <verse number="29" style="v" sid="NUM 33:29" />Bava i Mituka bacumbika i Hashimona.<verse eid="NUM 33:29" /></para>
  <para style="pi1">
    <verse number="30" style="v" sid="NUM 33:30" />Bava i Hashimona bacumbika i Mosera<verse eid="NUM 33:30" /></para>
  <para style="pi1">
    <verse number="31" style="v" sid="NUM 33:31" />Bava i Mosera bacumbika i Bene Yayakani.<verse eid="NUM 33:31" /></para>
  <para style="pi1">
    <verse number="32" style="v" sid="NUM 33:32" />Bava i Bene Yayakani bacumbika Hori Hagidugadi.<verse eid="NUM 33:32" /></para>
  <para style="pi1">
    <verse number="33" style="v" sid="NUM 33:33" />Bava i Hori Hagidugadi bacumbika i Yotubata<verse eid="NUM 33:33" /></para>
  <para style="pi1">
    <verse number="34" style="v" sid="NUM 33:34" />Bava i Yotubata bacumbika i Aburoma.<verse eid="NUM 33:34" /></para>
  <para style="pi1">
    <verse number="35" style="v" sid="NUM 33:35" />Bava i Aburoma bacumbika i Eziyoni Geberi.<verse eid="NUM 33:35" /></para>
  <para style="pi1">
    <verse number="36" style="v" sid="NUM 33:36" />Bava i Eziyoni Geberi bacumbika i Kadeshi, mu bugaragwa bw’i Zini.<verse eid="NUM 33:36" /></para>
  <para style="pi1">
    <verse number="37" style="v" sid="NUM 33:37" />Bava i Kadeshi bacumbika ku musozi Hori, ku rubibe rwa Edomu. <verse eid="NUM 33:37" /><verse number="38" style="v" sid="NUM 33:38" />Aroni umuherezi aduga ku musozi Hori abitegetswe n’<char style="nd">Uhoraho</char>, ari ho yapfiriye ku musi wa mbere w’ukwezi kwa gatanu w’umwaka ugira mirongo ine Abisirayeli bavuye muri Egiputa. <verse eid="NUM 33:38" /><verse number="39" style="v" sid="NUM 33:39" />Aroni yari amaze imyaka ijana na mirongo ibiri n’itatu igihe yapfira ku musozi Hori.<verse eid="NUM 33:39" /></para>
  <para style="pi1">
    <verse number="40" style="v" sid="NUM 33:40" />Umwami w’Umunyakanani yatwara i Aradi, yaba muri Negebu ho muri Kanani, yumva ko Abisirayeli bariko baraza.<verse eid="NUM 33:40" /></para>
  <para style="pi1">
    <verse number="41" style="v" sid="NUM 33:41" />Bava ku musozi Hori bacumbika i Zalumona.<verse eid="NUM 33:41" /></para>
  <para style="pi1">
    <verse number="42" style="v" sid="NUM 33:42" />Bava i Zalumona bacumbika i Punoni.<verse eid="NUM 33:42" /></para>
  <para style="pi1">
    <verse number="43" style="v" sid="NUM 33:43" />Bava i Punoni bacumbika i Oboti.<verse eid="NUM 33:43" /></para>
  <para style="pi1">
    <verse number="44" style="v" sid="NUM 33:44" />Bava i Oboti bacumbika i Iye Abarimu, ku rubibe rwa Mowabu.<verse eid="NUM 33:44" /></para>
  <para style="pi1">
    <verse number="45" style="v" sid="NUM 33:45" />Bava i Iye Abarimu bacumbika i Diboni Gadi.<verse eid="NUM 33:45" /></para>
  <para style="pi1">
    <verse number="46" style="v" sid="NUM 33:46" />Bava i Diboni Gadi bacumbika i Alumoni-Dibulatayimu.<verse eid="NUM 33:46" /></para>
  <para style="pi1">
    <verse number="47" style="v" sid="NUM 33:47" />Bava i Alumoni-Dibulatayimu bacumbika mu misozi y’i Abarimu, hafi y’i Nebo.<verse eid="NUM 33:47" /></para>
  <para style="pi1">
    <verse number="48" style="v" sid="NUM 33:48" />Bava mu misozi y’i Abarimu bacumbika mu biyaya vy’i Mowabu ku nkombe ya Yorodani, aharabana n’i Yeriko. <verse eid="NUM 33:48" /><verse number="49" style="v" sid="NUM 33:49" />Bacumbitse hafi ya Yorodani mu biyaya vy’i Mowabu, kuva i Beti-Yeshimoti gushika i Abeli-Shitimu.<verse eid="NUM 33:49" /></para>
  <para style="b" />
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50" />Mu biyaya vy’i Mowabu i ruhande ya Yorodani n’i Yeriko hakurya ya Yorodani <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 33:50" /><verse number="51" style="v" sid="NUM 33:51" />“Vugana n’Abisirayeli ubabwire uti: ‘Nimwajabuka Yorodani muja i Kanani, <verse eid="NUM 33:51" /><verse number="52" style="v" sid="NUM 33:52" />muze musohore ababa muri ico gihugu bose. Muze mumenagure ibishushanyo bibajwe mu mabuye canke bicuzwe mu butare vy’ibigirwamana vyabo, musambure n’ibibanza vyabo vyo gusengeramwo ku misozi. <verse eid="NUM 33:52" /><verse number="53" style="v" sid="NUM 33:53" />Muze mufate ico gihugu mukibemwo, kuko ndabahaye ico gihugu ngo kibe icanyu. <verse eid="NUM 33:53" /><verse number="54" style="v" sid="NUM 33:54" />Muze mugabuze ico gihugu ubufindo, nk’uko imiryango yanyu iri, ku mugwi munini muze mutange umugabane munini, n’umugwi muto muwuhe umugabane muto. Aho ubufindo buzokwerekana hazoba ari ahabo mukigabure mukurikije amazu ya ba sogokuruza banyu.<verse eid="NUM 33:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="NUM 33:55" />Ariko nimutirukana ababa muri ico gihugu, abo muzosigaza bazoba nk’amahwa mu maso yanyu no mu mbavu zanyu. Bazobateza amagorwa mu gihugu mugiye kubamwo. <verse eid="NUM 33:55" /><verse number="56" style="v" sid="NUM 33:56" />Nanje nzokorera mwebwe ivyo niteguye gukorera abo.’ ”<verse eid="NUM 33:56" /></para>
  <chapter eid="NUM 33" />
  <chapter number="34" style="c" sid="NUM 34" />
  <para style="s1">Imbibe z’i Kanani</para>
  <para style="lh">
    <verse number="1" style="v" sid="NUM 34:1" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 34:1" /><verse number="2" style="v" sid="NUM 34:2" />“Tegeka Abisirayeli ubabwire uti: ‘Nimwashika i Kanani, igihugu mugiye kwinjiramwo ngo kibe icanyu kizoba gifise imbibe zikurikira:<verse eid="NUM 34:2" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="3" style="v" sid="NUM 34:3" />Urubibe rwanyu rwo mu bumanuko ruzoba rugarukira ku bugaragwa bw’i Zini, ku rubibe rw’igihugu ca Edomu. Mu buseruko, urubibe ruzotangurira aho Ikiyaga c’Umunyu giherera, <verse eid="NUM 34:3" /><verse number="4" style="v" sid="NUM 34:4" />ruce mu bumanuko bw’akadugo ka Akurabimu, n’i Zini, ruce no mu bumanuko bwa Kadeshi Baruneya. Ruzobandanya ruce i Hazari-Adari n’i Azimoni, <verse eid="NUM 34:4" /><verse number="5" style="v" sid="NUM 34:5" />ruce rukebanuka, rufatane n’umugezi Wadi wa Egiputa ruruhukire ku Kiyaga Mediterane.<verse eid="NUM 34:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 34:6" />Urubibe rwanyu rwo mu burengero ruzoba ari Ikiyaga Mediterane. Urwo ni rwo ruzoba urubibe rwanyu rwo mu burengero.<verse eid="NUM 34:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 34:7" />Ku vyerekeye urubibe rwanyu rwo mu buraruko, muze muve ku Kiyaga Mediterane mushike ku musozi Hori <verse eid="NUM 34:7" /><verse number="8" style="v" sid="NUM 34:8" />no kuva ku musozi Hori mushike i Lebo-Hamati. Maze urwo rubibe ruze rubandanye gushika i Sedadi, <verse eid="NUM 34:8" /><verse number="9" style="v" sid="NUM 34:9" />rushishikare gushika i Zifuroni ruherere i Hazari-Enani. Urwo ni rwo ruzoba urubibe rwanyu rwo mu buraruko.<verse eid="NUM 34:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 34:10" />Ku vyerekeye urubibe rwanyu rwo mu buseruko, ruze ruve i Hazari-Enani rushike i Shefamu. <verse eid="NUM 34:10" /><verse number="11" style="v" sid="NUM 34:11" />Urwo rubibe ruze rumanuke kuva i Shefamu ruja i Ribula ku ruhande rwo mu buseruko bwa Ayini rushishikare gushika ku nkombe z’Ikiyaga c’i Kinereti. <verse eid="NUM 34:11" /><verse number="12" style="v" sid="NUM 34:12" />Maze urwo rubibe ruze rumanuke rujane Yorodani rushike ku Kiyaga c’Umunyu.</para>
  <para style="b" vid="NUM 34:12" />
  <para style="lf" vid="NUM 34:12">Ico ni co kizoba igihugu canyu, kizoba gifise imbibe zaco impande zose.’ ”<verse eid="NUM 34:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13" />Mose ategeka Abisirayeli ati: “Muze mugabure ico gihugu mukoresheje ubupfindo nk’umugabane wanyu. <char style="nd">Uhoraho</char> yategetse ko kizogaburirwa imiryango icenda n’igice, <verse eid="NUM 34:13" /><verse number="14" style="v" sid="NUM 34:14" />kuko imiryango ya Reyubeni, na Gadi n’igice c’umuryango wa Manase baronse imigabane yabo. <verse eid="NUM 34:14" /><verse number="15" style="v" sid="NUM 34:15" />Iyo miryango ibiri n’igice yaronse umugabane wayo mu buseruko bwa Yorodani hakurya ya Yeriko.”<verse eid="NUM 34:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16" />
    <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 34:16" /><verse number="17" style="v" sid="NUM 34:17" />“Aya ni yo mazina y’abantu bazobagaburira ico gihugu nk’umugabane wanyu: Eliyazeri umuherezi na Yosuwa mwene Nuni. <verse eid="NUM 34:17" /><verse number="18" style="v" sid="NUM 34:18" />Kandi uze utore umukuru umwe mu muryango wose wo gufasha kugabura ico gihugu.<verse eid="NUM 34:18" /></para>
  <para style="lh">
    <verse number="19" style="v" sid="NUM 34:19" />Aya ni yo mazina yabo:</para>
  <para style="b" vid="NUM 34:19" />
  <para style="li1" vid="NUM 34:19">Kalebu mwene Yefune,</para>
  <para style="li2" vid="NUM 34:19">wo mu muryango wa Yuda;<verse eid="NUM 34:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 34:20" />Samweli mwene Amihudi,</para>
  <para style="li2" vid="NUM 34:20">wo mu muryango wa Simeyoni;<verse eid="NUM 34:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="NUM 34:21" />Elidadi mwene Kisiloni,</para>
  <para style="li2" vid="NUM 34:21">wo mu muryango wa Benyamini;<verse eid="NUM 34:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 34:22" />Buki mwene Yoguli,</para>
  <para style="li2" vid="NUM 34:22">umukuru wo mu muryango wa Dani;<verse eid="NUM 34:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 34:23" />Haniyeli mwene Efodi,</para>
  <para style="li2" vid="NUM 34:23">umukuru wo mu muryango wa Manase mwene Yosefu;<verse eid="NUM 34:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 34:24" />Kemuweli mwene Shifutani,</para>
  <para style="li2" vid="NUM 34:24">umukuru wo mu muryango wa Efurayimu mwene Yosefu;<verse eid="NUM 34:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 34:25" />Elizafani mwene Parunaki,</para>
  <para style="li2" vid="NUM 34:25">umukuru wo mu muryango wa Zebuloni;<verse eid="NUM 34:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 34:26" />Palutiyeli mwene Azani,</para>
  <para style="li2" vid="NUM 34:26">umukuru wo mu muryango wa Isakari;<verse eid="NUM 34:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 34:27" />Ahihudi mwene Shelomi,</para>
  <para style="li2" vid="NUM 34:27">umukuru wo mu muryango wa Asheri;<verse eid="NUM 34:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 34:28" />Pedaheli mwene Amihudi,</para>
  <para style="li2" vid="NUM 34:28">umukuru wo mu muryango wa Nafutali.”<verse eid="NUM 34:28" /></para>
  <para style="lf">
    <verse number="29" style="v" sid="NUM 34:29" />Abo ni bo bagabo <char style="nd">Uhoraho</char> yategetse ko batorwa ngo bagaburire Abisirayeli imigabane yabo mu gihugu c’i Kanani.<verse eid="NUM 34:29" /></para>
  <chapter eid="NUM 34" />
  <chapter number="35" style="c" sid="NUM 35" />
  <para style="s1">Ibisagara vy’Abalewi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1" />Mu biyaya vy’i Mowabu ku nkengera z’uruzi Yorodani hakurya ya Yeriko, <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 35:1" /><verse number="2" style="v" sid="NUM 35:2" />“Bwira Abisirayeli baze bahe Abalewi ibisagara vyo kubamwo bivuye mu mugabane Abisirayeli bazoronka. Kandi babahe n’uburagiro i ruhande y’ivyo bisagara. <verse eid="NUM 35:2" /><verse number="3" style="v" sid="NUM 35:3" />Ni ho bazoronka ibisagara vyo kubamwo n’uburagiro bw’amasho yabo, imikuku yabo n’ibindi vyose batunze.<verse eid="NUM 35:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 35:4" />Uburagiro buzoba buri inyuma y’ibisagara muzoha Abalewi buzoba bushika ku ngero z’igice c’ukuboko igihumbi<note caller="+" style="f"><char style="fr" closed="false">35:4 </char><char style="ft" closed="false">Ni nko ku metero 450.</char></note> uvuye ku ruzitiro rw’igisagara. <verse eid="NUM 35:4" /><verse number="5" style="v" sid="NUM 35:5" />Inyuma y’igisagara, muze mupime ingero z’igice c’ukuboko ibihumbi bibiri<note caller="+" style="f"><char style="fr" closed="false">35:5 </char><char style="ft" closed="false">Ni nk’imetero 900.</char></note> mu buseruko, ingero z’igice c’ukuboko ibihumbi bibiri mu bumanuko, ingero z’igice c’ukuboko ibihumbi bibiri mu burengero n’ingero z’igice c’ukuboko ibihumbi bibiri mu buraruko, igisagara na co kibe hagati. Ubwo buzoba ari uburagiro bwabo bwegukira ivyo bisagara.<verse eid="NUM 35:5" /></para>
  <para style="s1">Ibisagara vy’ubuhungiro</para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6" />Ibisagara bitandatu mu vyo muzoha Abalewi bize bibe ibisagara vy’ubuhungiro, ivyo umuntu yishe uwundi azoshobora guhungiramwo. Kuri ivyo, muze mwongereko ibisagara mirongo ine na bibiri. <verse eid="NUM 35:6" /><verse number="7" style="v" sid="NUM 35:7" />Vyose hamwe muze muhe Abalewi ibisagara mirongo ine n’umunani, biri kumwe n’uburagiro bwavyo. <verse eid="NUM 35:7" /><verse number="8" style="v" sid="NUM 35:8" />Ibisagara muzoha Abalewi mu gihugu Abisirayeli bagiye kuzokwegukira bize bitangwe muravye uko umugabane w’umuryango wose ungana: muze mutange ibisagara vyinshi ku muryango ufise abantu benshi, ariko ku wufise bake muze mutange bike.”<verse eid="NUM 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9" />Nuko <char style="nd">Uhoraho</char> abarira Mose ati: <verse eid="NUM 35:9" /><verse number="10" style="v" sid="NUM 35:10" />“Vugana n’Abisirayeli ubabwire uti: ‘Nimwajabuka Yorodani muja i Kanani, <verse eid="NUM 35:10" /><verse number="11" style="v" sid="NUM 35:11" />muze mutoranye ibisagara bimwe kuba ibisagara vy’ubuhungiro, ivyo umuntu azoba yishe uwundi atabiteguye azohungiramwo. <verse eid="NUM 35:11" /><verse number="12" style="v" sid="NUM 35:12" />Bizoba ibibanza vyo guhungiramwo umuhozi, kugira ngo uwo muntu yagirizwa ubwicanyi ntapfe ataracirirwa urubanza imbere y’ikoraniro. <verse eid="NUM 35:12" /><verse number="13" style="v" sid="NUM 35:13" />Ivyo bisagara bitandatu bizoba ibisagara vy’ubuhungiro. <verse eid="NUM 35:13" /><verse number="14" style="v" sid="NUM 35:14" />Muze mutange ibisagara bitatu hakuno ya Yorodani na bitatu i Kanani. <verse eid="NUM 35:14" /><verse number="15" style="v" sid="NUM 35:15" />Ivyo bisagara uko ari bitandatu bize bibe ivyo guhungiramwo ku Bisirayeli, inyambukira canke uwundi muntu wese aba hagati muri mwebwe, kugira ngo uwishe uwundi atabishaka ashobore guhungirayo.<verse eid="NUM 35:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16" />Umuntu niyakubita uwundi icuma agaca apfa, azoba ari umwicanyi; uwo mwicanyi aze yicwe. <verse eid="NUM 35:16" /><verse number="17" style="v" sid="NUM 35:17" />Canke umuntu azoba afise ibuye mu ntoke rishobora kwica, akaritera uwundi ngo apfe, azoba ari umwicanyi; uwo mwicanyi aze yicwe. <verse eid="NUM 35:17" /><verse number="18" style="v" sid="NUM 35:18" />Kandi umuntu niyaba afise ikintu gikozwe mu giti mu ntoke gishobora kwica, hanyuma akagikubita umuntu kugira ngo apfe, ni umwicanyi; uwo mwicanyi aze yicwe. <verse eid="NUM 35:18" /><verse number="19" style="v" sid="NUM 35:19" />Uwuhora amaraso yasheshwe aze yice uwo mwicanyi; niyahura na we, aze amwice. <verse eid="NUM 35:19" /><verse number="20" style="v" sid="NUM 35:20" />Umuntu niyasunika mugenziwe n’inzigo canke akamutera ikintu afise intumbero yo kumwica <verse eid="NUM 35:20" /><verse number="21" style="v" sid="NUM 35:21" />canke akamukubita ingumu n’inzigo kugira ngo apfe, azoba ari umwicanyi. Uwujejwe guhora amaraso yasheshwe aze yice uwo mwicanyi niyahura na we.<verse eid="NUM 35:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22" />Ariko umuntu niyica mugenziwe ata nzigo yari amufitiye mu kumusunika atabigabiye canke akamutera ikintu <verse eid="NUM 35:22" /><verse number="23" style="v" sid="NUM 35:23" />canke akamurekurirako ibuye atamubonye bigatuma apfa, ko atari umwansi wiwe kandi atari yagabiye kumugirira nabi, <verse eid="NUM 35:23" /><verse number="24" style="v" sid="NUM 35:24" />ikoraniro rize ribacire urubanza we n’umuhozi bisunze aya mategeko. <verse eid="NUM 35:24" /><verse number="25" style="v" sid="NUM 35:25" />Ikoraniro rize rikingire uwagirijwe ko yishe umuntu ngo umuhozi ntamwice kandi baze bamurungike asubire mu gisagara c’ubuhungiro aho yari yahungiye. Aze agumeyo gushika aho umuherezi mukuru azopfira, uwarobanujwe amavuta yo kurobanura.<verse eid="NUM 35:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 35:26" />Ariko uwo yagirizwa niyaja hanze akarenga imbibe z’igisagara c’ubuhungiro yahungiyemwo <verse eid="NUM 35:26" /><verse number="27" style="v" sid="NUM 35:27" />maze umuhozi akamusanga hanze y’ico gisagara, uwo muhozi ashobora kumwica kandi ntazotsindwa n’urubanza ko ari umwicanyi. <verse eid="NUM 35:27" /><verse number="28" style="v" sid="NUM 35:28" />Uwo yagirizwa ategerezwa kuguma mu gisagara c’ubuhungiro gushika aho umuherezi mukuru azopfira; inyuma y’urupfu rw’umuherezi mukuru ni ho honyene yemerewe gusubira iwe.<verse eid="NUM 35:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 35:29" />Aya azobe amategeko mugenderako uko urunganwe ruzokurikirana n’urundi, aho muzoba muba hose.<verse eid="NUM 35:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30" />Umuntu wese azokwica uwundi aze yicwe nk’umwicanyi ariko nihaboneka abamwagiriza. Ariko ntihaze hagire uwicwa hisunzwe ivyavuzwe n’icabona kimwe.<verse eid="NUM 35:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 35:31" />Ntimuze mwemere incungu y’umwicanyi, kandi ategerezwa gupfa. Ntaze abure kwicwa.<verse eid="NUM 35:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 35:32" />Ntimuze mwemere incungu y’uwahungiye mu gisagara c’ubuhungiro ngo mumwemerere kugaruka ngo abe iwe imbere y’uko umuherezi mukuru apfa.<verse eid="NUM 35:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 35:33" />Ntimuze muhumanye igihugu mubamwo. Amaraso asheshwe ahumanya igihugu, kandi nta mpongano ishobora gutangwa aho amaraso yasesetse, atari amaraso y’uwayasheshe. <verse eid="NUM 35:33" /><verse number="34" style="v" sid="NUM 35:34" />Ntimuze muhumanye igihugu mubamwo kuko nanje ari ho mba. Ndi <char style="nd">Uhoraho</char> kandi mba hagati mu Bisirayeli.’ ”<verse eid="NUM 35:34" /></para>
  <chapter eid="NUM 35" />
  <chapter number="36" style="c" sid="NUM 36" />
  <para style="s1">Umugabane w’abakobwa ba Zelofehadi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1" />Abakuru b’umuryango wa Gileyadi mwene Makiri, Makiri mwene Manase, bari abo mu ruvyaro rwa Yosefu, baza kuvugana na Mose n’abakuru b’imiryango y’Abisirayeli. <verse eid="NUM 36:1" /><verse number="2" style="v" sid="NUM 36:2" />Baravuga bati: “Nyakwubahwa, igihe <char style="nd">Uhoraho</char> yakubwira, ko uzogaburira Abisirayeli igihugu ukoresheje ubupfindo, yavuze ko uzoha umugabane w’umuvukanyi wacu Zelofehadi abakobwa biwe. <verse eid="NUM 36:2" /><verse number="3" style="v" sid="NUM 36:3" />Hamwe borongorwa n’abo mu yindi miryango y’Abisirayeli; umugabane wabo woca uja mu muryango bagiyemwo, ukava ku mugabane w’umuryango wacu. Aho rero igice c’umugabane wari uwacu woba ugiye ahandi. <verse eid="NUM 36:3" /><verse number="4" style="v" sid="NUM 36:4" />Umwaka wa Yubile y’Abisirayeli ushitse, umugabane wabo uzoca wegukira wa muryango barongowemwo, maze ukurwe ku mugabane wa ba sogokuru.”<verse eid="NUM 36:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5" />Nuko Mose atanga iri tegeko ku Bisirayeli abibwiwe n’<char style="nd">Uhoraho</char> ati: “Ivyo ab’umuryango wa Yosefu bariko baravuga ni vyo. <verse eid="NUM 36:5" /><verse number="6" style="v" sid="NUM 36:6" />Ibi ni vyo <char style="nd">Uhoraho</char> ategetse abakobwa ba Zelofehadi: bashobora kurongorwa n’uwo bipfuza, ariko aze abe ari uwo mu muryango wa ba sekuru. <verse eid="NUM 36:6" /><verse number="7" style="v" sid="NUM 36:7" />Ntihaze hagire umugabane w’umuryango uzoja mu wundi muryango, kuko Umwisirayeli wese azogumya umugabane yahawe mu muryango wiwe. <verse eid="NUM 36:7" /><verse number="8" style="v" sid="NUM 36:8" />Umukobwa wese azoragwa itongo mu muryango wose w’Abisirayeli, azotegerezwa kurongorwa mu muryango wa ba sekuru, kugira ngo Umwisirayeli wese aze agumane umugabane wa ba sekuru biwe. <verse eid="NUM 36:8" /><verse number="9" style="v" sid="NUM 36:9" />Ntihaze hagire umugabane uva mu muryango ngo uje mu wundi, nuko rero umuryango wose w’Abisirayeli uze ugumye itongo warazwe.”<verse eid="NUM 36:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10" />Nuko abakobwa ba Zelofehadi bakora nk’uko <char style="nd">Uhoraho</char> yategetse Mose. <verse eid="NUM 36:10" /><verse number="11" style="v" sid="NUM 36:11" />Abakobwa ba Zelofehadi: Mahala, Tiriza, Hogula, Milika na Noha, barongorwa na bavyara babo bo mu muryango wa se. <verse eid="NUM 36:11" /><verse number="12" style="v" sid="NUM 36:12" />Barongowe mu muryango wa Manase mwene Yosefu, maze umugabane wabo uca uguma mu muryango wa sewabo.<verse eid="NUM 36:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13" />Ayo ni yo mategeko n’amabwirizwa <char style="nd">Uhoraho</char> yahaye Abisirayeli abicishije kuri Mose bari mu biyaya vy’i Mowabu ku nkombe ya Yorodani hakurya ya Yeriko.<verse eid="NUM 36:13" /></para>
  <chapter eid="NUM 36" />
</usx>