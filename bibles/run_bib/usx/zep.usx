  <para style="h">Zefaniya</para>
  <para style="toc1">Igitabu c’uwavugishwa n’Imana Zefaniya</para>
  <para style="toc2">Zefaniya</para>
  <para style="toc3">Zef</para>
  <para style="mt2">Igitabu c’uwavugishwa n’Imana</para>
  <para style="mt1">Zefaniya</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />Iri ni ijambo ry’<char style="nd">Uhoraho</char> ryatumwe kuri Zefaniya, mwene Kushi, Kushi mwene Gedaliya, Gedaliya mwene Amariya, Amariya mwene Hezekiya, ku ngoma ya Yosiya mwene Amoni, umwami w’i Buyuda.<verse eid="ZEP 1:1" /></para>
  <para style="s1">Urubanza rw’Imana</para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2" />“Nzorandura ibintu</para>
  <para style="q2" vid="ZEP 1:2">vyose biri kw’isi,”</para>
  <para style="q2" vid="ZEP 1:2">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="ZEP 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3" />“Nzorandura abantu n’ibikoko;</para>
  <para style="q2" vid="ZEP 1:3">nkureho inyoni mu kirere</para>
  <para style="q2" vid="ZEP 1:3">n’amafi mu biyaga,</para>
  <para style="q2" vid="ZEP 1:3">hamwe n’ibigirwamana bituma umunyakibi atsitara.</para>
  <para style="b" vid="ZEP 1:3" />
  <para style="q1" vid="ZEP 1:3">Igihe nzorandura abantu bose</para>
  <para style="q2" vid="ZEP 1:3">nkabakura kw’isi,”</para>
  <para style="q2" vid="ZEP 1:3">ni ko <char style="nd">Uhoraho</char> avuze,<verse eid="ZEP 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4" />“nzoramvurira ukuboko kwanje kugwanya Abayuda,</para>
  <para style="q2" vid="ZEP 1:4">no kugwanya abantu bose baba i Yerusalemu.</para>
  <para style="q1" vid="ZEP 1:4">Nzorandura abasenga Bayali bose bazoba bagisigaye muri kino kibanza,</para>
  <para style="q2" vid="ZEP 1:4">n’amazina y’abaherezi basenga ibigirwamana,<verse eid="ZEP 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5" />bapfukama hejuru ku mazu,</para>
  <para style="q2" vid="ZEP 1:5">bagasenga inyenyeri zo kw’ijuru,</para>
  <para style="q1" vid="ZEP 1:5">bakongera bakunama bakarahira mw’izina ry’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="ZEP 1:5">kandi bagasubira bakarahira mw’izina rya Moleki.<verse eid="ZEP 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6" />Nzorandura n’abo bose basubiye inyuma batakinsenga,</para>
  <para style="q2" vid="ZEP 1:6">hamwe n’abo batakirondera <char style="nd">Uhoraho</char> canke ngo bagire ico bamusiguza.”<verse eid="ZEP 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7" />Nimuhwekere imbere y’<char style="nd">Uhoraho</char> Nyeninganji,</para>
  <para style="q2" vid="ZEP 1:7">kuko umusi w’urubanza rwiwe uri hafi.</para>
  <para style="q1" vid="ZEP 1:7">
    <char style="nd">Uhoraho</char> yarateguye ikimazi;</para>
  <para style="q2" vid="ZEP 1:7">yaramaze gutegura abo kugitanga.<verse eid="ZEP 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8" />Kandi kuri uwo musi w’ikimazi c’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="ZEP 1:8">nzohana abatware</para>
  <para style="q2" vid="ZEP 1:8">n’abaganwa ari bo bahungu b’umwami,</para>
  <para style="q1" vid="ZEP 1:8">hamwe n’abo bose</para>
  <para style="q2" vid="ZEP 1:8">basenga imana z’abanyamahanga.<verse eid="ZEP 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9" />Kuri uwo musi nzohana</para>
  <para style="q2" vid="ZEP 1:9">abaja mu misi mikuru yo gusenga ibigirwamana,</para>
  <para style="q1" vid="ZEP 1:9">bakuzuza inzu z’ibigirwamana vyabo</para>
  <para style="q2" vid="ZEP 1:9">umuryano n’uruhendo.<verse eid="ZEP 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10" />“Kuri uwo musi,”</para>
  <para style="q2" vid="ZEP 1:10">ni ko <char style="nd">Uhoraho</char> avuze,</para>
  <para style="q1" vid="ZEP 1:10">“induru izokwumvikanira kw’Irembo ry’Amafi,</para>
  <para style="q2" vid="ZEP 1:10">abantu baboroge bava mu gisagara gishasha,</para>
  <para style="q2" vid="ZEP 1:10">kandi ijwi rirenga rizumvikanira ku misozi.<verse eid="ZEP 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11" />Nimuboroge, yemwe ababa hafi y’utuguriro,</para>
  <para style="q2" vid="ZEP 1:11">kuko abadandaza banyu bose bakuweho,</para>
  <para style="q2" vid="ZEP 1:11">abashora ifeza bose na bo bakaba bahonye.<verse eid="ZEP 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12" />Ico gihe nzorondeza Yerusalemu urumuri,</para>
  <para style="q2" vid="ZEP 1:12">mpane abantu bose bidibamiye mu vyaha vyabo,</para>
  <para style="q2" vid="ZEP 1:12">bameze nk’umuvinyu ureremba hejuru ku mvuzo,</para>
  <para style="q1" vid="ZEP 1:12">bibwira ko <char style="nd">Uhoraho</char> ata na kimwe azokora,</para>
  <para style="q2" vid="ZEP 1:12">kiba kibi canke ciza.<verse eid="ZEP 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13" />Ubutunzi bwabo buzosahurwa,</para>
  <para style="q2" vid="ZEP 1:13">amazu yabo azosenyurwa.</para>
  <para style="q1" vid="ZEP 1:13">Naho bubaka amazu,</para>
  <para style="q2" vid="ZEP 1:13">ntibazoyabamwo.</para>
  <para style="q1" vid="ZEP 1:13">Naho barima imizabibu,</para>
  <para style="q2" vid="ZEP 1:13">ntibazonywa imitobe yazo.<verse eid="ZEP 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14" />Umusi uhambaye w’<char style="nd">Uhoraho</char> uri hafi,</para>
  <para style="q2" vid="ZEP 1:14">uri hafi kandi uje wihuta.</para>
  <para style="q1" vid="ZEP 1:14">Amarira yo ku musi w’<char style="nd">Uhoraho</char> azoba ateye agahinda,</para>
  <para style="q2" vid="ZEP 1:14">aho n’umuhizi mu ntambara azoboroga.<verse eid="ZEP 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15" />Uwo musi uzoba ari umusi w’uburake,</para>
  <para style="q2" vid="ZEP 1:15">umusi w’amarira n’imibabaro,</para>
  <para style="q3" vid="ZEP 1:15">umusi w’ivyago no guhona,</para>
  <para style="q2" vid="ZEP 1:15">umusi w’umwijima w’umuzitanya,</para>
  <para style="q3" vid="ZEP 1:15">umusi w’igipfungu n’ukwiraburanirwa,<verse eid="ZEP 1:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ZEP 1:16" />umusi w’inzamba n’akaruru k’intambara,</para>
  <para style="q1" vid="ZEP 1:16">yo kugwanya ibisagara bizitiriwe</para>
  <para style="q2" vid="ZEP 1:16">n’iminara yo mu mfuruka zavyo.<verse eid="ZEP 1:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17" />Nzoteza ivyago amahanga,</para>
  <para style="q2" vid="ZEP 1:17">agende arajuragirika kurya kw’impumyi,</para>
  <para style="q2" vid="ZEP 1:17">kuko bacumuye k’<char style="nd">Uhoraho</char>.</para>
  <para style="q1" vid="ZEP 1:17">Amaraso yabo azoseswa hasi nk’amazi,</para>
  <para style="q2" vid="ZEP 1:17">n’imibiri yabo ibore nk’umwavu.<verse eid="ZEP 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18" />Ifeza zabo canke inzahabu zabo</para>
  <para style="q2" vid="ZEP 1:18">nta na kimwe kizoshobora kubakiza,</para>
  <para style="q2" vid="ZEP 1:18">ku musi w’uburake bw’<char style="nd">Uhoraho</char>.”</para>
  <para style="b" vid="ZEP 1:18" />
  <para style="q1" vid="ZEP 1:18">Mu kururumba kw’ishari ryiwe</para>
  <para style="q2" vid="ZEP 1:18">isi yose iyo iva ikagera, izotongorwa n’umuriro,</para>
  <para style="q1" vid="ZEP 1:18">kuko azoshiraho iherezo mu buryo bwihuta</para>
  <para style="q2" vid="ZEP 1:18">ry’abantu bose bari kw’isi.<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="s1">Abayuda n’ab’i Yerusalemu bacirwa urubanza hamwe n’ayandi mahanga</para>
  <para style="s2">Abayuda basabwa kwihana</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1" />Nimukoranire hamwe, mwebwe nyene nimwiyegeranirize hamwe,</para>
  <para style="q2" vid="ZEP 2:1">yemwe mwa bantu b’ihanga ritagira isoni.<verse eid="ZEP 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2" />Mwegerane imbere y’uko itegeko ritangura kuja mu ngiro,</para>
  <para style="q2" vid="ZEP 2:2">imbere y’uko uwo musi ushika ukabatumura</para>
  <para style="q2" vid="ZEP 2:2">nk’uko umuyaga mwinshi utumura umuguruka,</para>
  <para style="q1" vid="ZEP 2:2">imbere y’uko ishavu rihambaye ry’Imana</para>
  <para style="q2" vid="ZEP 2:2">ribashikako,</para>
  <para style="q1" vid="ZEP 2:2">imbere y’uko umusi w’uburake bw’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="ZEP 2:2">ubashikira.<verse eid="ZEP 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3" />Nimurondere <char style="nd">Uhoraho</char>, yemwe abaciye bugufi bo muri iki gihugu,</para>
  <para style="q2" vid="ZEP 2:3">mwebwe mukora ivyo ategetse.</para>
  <para style="q1" vid="ZEP 2:3">Rondera ubugororotsi, rondera ukwicisha bugufi;</para>
  <para style="q2" vid="ZEP 2:3">kumbure muzozigamwa</para>
  <para style="q2" vid="ZEP 2:3">ku musi w’ishavu ry’<char style="nd">Uhoraho</char>.<verse eid="ZEP 2:3" /></para>
  <para style="s2">Urubanza ku Bafilisitiya</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4" />Gaza hazotabwa,</para>
  <para style="q2" vid="ZEP 2:4">na Ashikeloni hacike umusaka.</para>
  <para style="q1" vid="ZEP 2:4">Ashidodi hazokwamburwa abaho ku murango,</para>
  <para style="q2" vid="ZEP 2:4">Ekuroni na ho harandurwe.<verse eid="ZEP 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5" />Muzobona ibara mwebwe muba ku nkengera z’ikiyaga,</para>
  <para style="q2" vid="ZEP 2:5">mwebwe Bakereti;</para>
  <para style="q1" vid="ZEP 2:5">Ijambo ry’<char style="nd">Uhoraho</char> rirabagiriza,</para>
  <para style="q2" vid="ZEP 2:5">yewe Kanani, intara y’Abafilisitiya.</para>
  <para style="q1" vid="ZEP 2:5">Rivuga ngo: “Nzobatikiza,</para>
  <para style="q2" vid="ZEP 2:5">nta n’umwe azosigara.”<verse eid="ZEP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6" />Intara yegereye ku kiyaga, izohinduka uburagiro,</para>
  <para style="q2" vid="ZEP 2:6">habe ibinogo vy’amazi y’abungere</para>
  <para style="q2" vid="ZEP 2:6">n’impongore z’imikuku.<verse eid="ZEP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7" />Ico gihugu, kizokwegukira</para>
  <para style="q2" vid="ZEP 2:7">amasigarira y’abo mu muryango wa Yuda,</para>
  <para style="q2" vid="ZEP 2:7">aho ni ho bazoronka uburagiro.</para>
  <para style="q1" vid="ZEP 2:7">Mw’ijoro bazoruhuka</para>
  <para style="q2" vid="ZEP 2:7">baruhukire mu mazu yahebwe n’ab’i Ashikeloni.</para>
  <para style="q1" vid="ZEP 2:7">
    <char style="nd">Uhoraho</char> Imana yabo azobitaho,</para>
  <para style="q2" vid="ZEP 2:7">abasubize amatungo yabo.<verse eid="ZEP 2:7" /></para>
  <para style="s2">Urubanza ku Banyamowabu n’Abamoni</para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8" />“Narumvise ibitutsi vy’Abanyamowabu,</para>
  <para style="q2" vid="ZEP 2:8">hamwe n’agacokoro c’Abamoni,</para>
  <para style="q1" vid="ZEP 2:8">abatutse abantu banje,</para>
  <para style="q2" vid="ZEP 2:8">batera uruhagarara igihugu cabo.<verse eid="ZEP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9" />None rero ndahiye ukubaho kwanje,”</para>
  <para style="q2" vid="ZEP 2:9">ni ko <char style="nd">Uhoraho</char> Mushoboravyose avuze,</para>
  <para style="q2" vid="ZEP 2:9">Imana ya Isirayeli,</para>
  <para style="q1" vid="ZEP 2:9">“Ni ukuri, i Mowabu hazoba nk’i Sodomu,</para>
  <para style="q2" vid="ZEP 2:9">Abamoni na bo babe nk’ab’i Gomora;</para>
  <para style="q1" vid="ZEP 2:9">ahantu huzuye ivyatsi n’ibinogo vyimbwamwo umunyu,</para>
  <para style="q2" vid="ZEP 2:9">ahantu hatazigera hasubira kugira abahaba.</para>
  <para style="q1" vid="ZEP 2:9">Amasigarira y’abantu banje azobasahura;</para>
  <para style="q2" vid="ZEP 2:9">abazorokoka mu gihugu canje bazokwegukira igihugu cabo.”<verse eid="ZEP 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10" />Iyo ni yo mpera bazohabwa kubera ukwishira hejuru kwabo,</para>
  <para style="q2" vid="ZEP 2:10">kuko bacokoye bagashinyagurira</para>
  <para style="q2" vid="ZEP 2:10">abantu b’<char style="nd">Uhoraho</char> Mushoboravyose.<verse eid="ZEP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11" />
    <char style="nd">Uhoraho</char> azobahindisha agashitsi</para>
  <para style="q2" vid="ZEP 2:11">niyasangangura ibigirwamana vyo muri ico gihugu.</para>
  <para style="q1" vid="ZEP 2:11">Amahanga yose yo ku nkengera z’ikiyaga azomusenga,</para>
  <para style="q2" vid="ZEP 2:11">bamwe bose mu gihugu cabo.<verse eid="ZEP 2:11" /></para>
  <para style="s2">Urubanza kuri Etiyopiya</para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12" />“Kandi namwe abo muri Etiyopiya,</para>
  <para style="q2" vid="ZEP 2:12">inkota y’<char style="nd">Uhoraho</char> izobasogota.”<verse eid="ZEP 2:12" /></para>
  <para style="s2">Urubanza kuri Ashuri</para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13" />Azoramvura ukuboko kwiwe agwanye abo mu buraruko,</para>
  <para style="q2" vid="ZEP 2:13">arandure Ashuri,</para>
  <para style="q1" vid="ZEP 2:13">Ninewe ahasige ari umusaka,</para>
  <para style="q2" vid="ZEP 2:13">hagadutse nko mu bugaragwa.<verse eid="ZEP 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14" />Imikuku n’amasho ni ho bizoryama</para>
  <para style="q2" vid="ZEP 2:14">n’ibikoko vy’ubwoko bwose.</para>
  <para style="q1" vid="ZEP 2:14">Ibihuna vyo mu bugaragwa n’ibindi bihurira,</para>
  <para style="q2" vid="ZEP 2:14">vyose bizokwibera ku nkingi zaho.</para>
  <para style="q1" vid="ZEP 2:14">Uguhurira kwavyo kuzokwumvikanira mu madirisha yaho,</para>
  <para style="q2" vid="ZEP 2:14">mu miryango yaho hazoba ibibomoke,</para>
  <para style="q2" vid="ZEP 2:14">n’ibisenge vyubatswe mu masederi bizosigara bigaragara ata kibipfutse.<verse eid="ZEP 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15" />Ico ni ca gisagara cishira hejuru,</para>
  <para style="q2" vid="ZEP 2:15">cahoze gitekaniwe.</para>
  <para style="q1" vid="ZEP 2:15">Wahoze wishima uvuga uti: “Ndi uwuhambaye kurusha abandi!</para>
  <para style="q2" vid="ZEP 2:15">Nta gisagara na kimwe cogereranywa nanje.”</para>
  <para style="q1" vid="ZEP 2:15">Mbega ukuntu habaye umusaka,</para>
  <para style="q2" vid="ZEP 2:15">hasigaye hibera inyamaswa zo mw’ishamba.</para>
  <para style="q1" vid="ZEP 2:15">Abahaca bose bavuza uruhwa,</para>
  <para style="q2" vid="ZEP 2:15">bakahamama amashi.<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="s2">Ubugarariji bwa Yerusalemu no gucungurwa kwaho</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1" />Uzobona ibara wa gisagara c’abacinyiza,</para>
  <para style="q2" vid="ZEP 3:1">bagarariza kandi banduye!<verse eid="ZEP 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2" />Nta n’umwe cumvira,</para>
  <para style="q2" vid="ZEP 3:2">kandi nticemera guhanwa.</para>
  <para style="q1" vid="ZEP 3:2">Nticizera Imana,</para>
  <para style="q2" vid="ZEP 3:2">kandi ntikinemera kumwegera.<verse eid="ZEP 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3" />Abaganwa bari imbere muri co</para>
  <para style="q2" vid="ZEP 3:3">bameze nk’intambwe ziroha;</para>
  <para style="q1" vid="ZEP 3:3">abatware baho na bo ni nk’amabingira y’umugoroba,</para>
  <para style="q2" vid="ZEP 3:3">ata kintu na kimwe asigariza ejo.<verse eid="ZEP 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4" />Abavugishwa baco nta co bubaha;</para>
  <para style="q2" vid="ZEP 3:4">ni abanyabinyoma.</para>
  <para style="q1" vid="ZEP 3:4">Abaherezi baco bahumanya ahera h’urusengero</para>
  <para style="q2" vid="ZEP 3:4">bakarenga ivyagezwe vy’<char style="nd">Uhoraho</char> ibigirankana.<verse eid="ZEP 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5" />
    <char style="nd">Uhoraho</char> aba muri co ni umugororotsi,</para>
  <para style="q2" vid="ZEP 3:5">nta kibi kiri muri we.</para>
  <para style="q1" vid="ZEP 3:5">Uko bukeye aca imanza zibereye,</para>
  <para style="q2" vid="ZEP 3:5">kandi uko uwundi musi uje ntarambirwa,</para>
  <para style="q2" vid="ZEP 3:5">ariko ababi ntibaterwa n’isoni.<verse eid="ZEP 3:5" /></para>
  <para style="s2">Yerusalemu yanka kwihana</para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6" />“Nahoneje amahanga menshi,</para>
  <para style="q2" vid="ZEP 3:6">nsenyagura ibihome biyakingira n’iminara yabo.</para>
  <para style="q1" vid="ZEP 3:6">Amabarabara yabo nsiga ari nk’ubugaragwa,</para>
  <para style="q2" vid="ZEP 3:6">ata muntu n’umwe akiyacamwo.</para>
  <para style="q1" vid="ZEP 3:6">Ibisagara vyabo vyarasenyutse,</para>
  <para style="q2" vid="ZEP 3:6">ni nk’ubugaragwa nta muntu aharangwa.<verse eid="ZEP 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7" />Yewe Yerusalemu, nariyumviriye nti:</para>
  <para style="q2" vid="ZEP 3:7">‘Mu vy’ukuri uzonyubaha,</para>
  <para style="q2" vid="ZEP 3:7">wemere gutozwa indero!’</para>
  <para style="q1" vid="ZEP 3:7">Maze ikibanza c’ubuhungiro bwabo kibone ingene kizigamwa,</para>
  <para style="q2" vid="ZEP 3:7">kandi n’ibihano vyanje vyose ntibibashikeko.</para>
  <para style="q1" vid="ZEP 3:7">Ariko na ho nyene bagumanye ishaka ryinshi</para>
  <para style="q2" vid="ZEP 3:7">ryo kwama bakora ibibi.<verse eid="ZEP 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8" />None rero nimurindire gatoya,” ni ko <char style="nd">Uhoraho</char> avuze,</para>
  <para style="q2" vid="ZEP 3:8">“mu gihe gito nzohaguruka ndabagirize.</para>
  <para style="q1" vid="ZEP 3:8">Namaze gufata ingingo yo kwegeranya amahanga,</para>
  <para style="q2" vid="ZEP 3:8">kwegeranya ubwami bwose,</para>
  <para style="q1" vid="ZEP 3:8">ngo ndabimarireko ishavu,</para>
  <para style="q2" vid="ZEP 3:8">ndabasukeko uburake bwanje bwose.</para>
  <para style="q1" vid="ZEP 3:8">Isi yose izotongorwa,</para>
  <para style="q2" vid="ZEP 3:8">irigitwe n’umuriro w’ishari ryanje.<verse eid="ZEP 3:8" /></para>
  <para style="s1">Inagurwa ry’amasigarira ya Isirayeli</para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9" />Maze nzokweza iminwa y’ubwoko bwose,</para>
  <para style="q2" vid="ZEP 3:9">kugira ngo bose bashobore kwambaza izina ry’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="ZEP 3:9">bamukorere bafatanye mu nda.<verse eid="ZEP 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10" />Abashwiragiriye hakurya y’inzuzi zo muri Etiyopiya,</para>
  <para style="q2" vid="ZEP 3:10">abanyambaza, abasabagiye banje,</para>
  <para style="q2" vid="ZEP 3:10">bazonzanira amashikanwa.<verse eid="ZEP 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11" />Kuri uwo musi, wewe Yerusalemu, ntuzokwongera kumaramazwa</para>
  <para style="q2" vid="ZEP 3:11">n’ibibi mwankoreye,</para>
  <para style="q1" vid="ZEP 3:11">kuko nzokura muri wewe</para>
  <para style="q2" vid="ZEP 3:11">ab’amanyama bishira hejuru,</para>
  <para style="q1" vid="ZEP 3:11">kandi ntimuzosubira kwishira hejuru</para>
  <para style="q2" vid="ZEP 3:11">ku musozi wanje wera.<verse eid="ZEP 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12" />Ariko nzosigaza muri mwebwe</para>
  <para style="q2" vid="ZEP 3:12">abitonda n’abaciye bugufi.</para>
  <para style="q1" vid="ZEP 3:12">Amasigarira ya Isirayeli</para>
  <para style="q2" vid="ZEP 3:12">azokwizigira izina ry’<char style="nd">Uhoraho</char>.<verse eid="ZEP 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13" />Nta kibi bazokora;</para>
  <para style="q2" vid="ZEP 3:13">nta binyoma bazovuga;</para>
  <para style="q1" vid="ZEP 3:13">ururimi rubesha,</para>
  <para style="q2" vid="ZEP 3:13">ntiruzoba mu kanwa kabo.</para>
  <para style="q1" vid="ZEP 3:13">Bazorya baryame,</para>
  <para style="q2" vid="ZEP 3:13">kandi nta n’umwe azobatera ubwoba.”<verse eid="ZEP 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14" />Ririmba, mukobwa w’i Siyoni we;</para>
  <para style="q2" vid="ZEP 3:14">shira ijwi hejuru, Isirayeli we!</para>
  <para style="q1" vid="ZEP 3:14">Nezerwa, uhimbarwe n’umutima wawe wose,</para>
  <para style="q2" vid="ZEP 3:14">mukobwa Yerusalemu!<verse eid="ZEP 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15" />Kuko <char style="nd">Uhoraho</char> yagukuyeko igihano,</para>
  <para style="q2" vid="ZEP 3:15">yasubije inyuma abansi bawe.</para>
  <para style="q1" vid="ZEP 3:15">
    <char style="nd">Uhoraho</char>, Imana ya Isirayeli, ari kumwe nawe;</para>
  <para style="q2" vid="ZEP 3:15">nta kibi uzosubira gutinya.<verse eid="ZEP 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16" />Kuri uwo musi</para>
  <para style="q2" vid="ZEP 3:16">bazobwira Yerusalemu</para>
  <para style="q1" vid="ZEP 3:16">bati: “Ntugire ubwoba, Siyoni;</para>
  <para style="q2" vid="ZEP 3:16">ntureke amaboko yawe ngo adendebukirwe.<verse eid="ZEP 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17" />
    <char style="nd">Uhoraho</char> Imana yawe ari kumwe nawe,</para>
  <para style="q2" vid="ZEP 3:17">ni umuhizi mu ntambara, ashoboye gukiza.</para>
  <para style="q1" vid="ZEP 3:17">Azogira umunezero mwinshi ku bwawe,</para>
  <para style="q2" vid="ZEP 3:17">mu rukundo rwiwe, ntazokwongera kugukankamira,</para>
  <para style="q2" vid="ZEP 3:17">ariko, azokunezererwa akoresheje indirimbo.<verse eid="ZEP 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18" />Nzokwegeraniriza muri wewe</para>
  <para style="q2" vid="ZEP 3:18">abo bose bagandariye kubura ya misi mikuru yari yarashinzwe,</para>
  <para style="q2" vid="ZEP 3:18">ntuzongera guteterwa.<verse eid="ZEP 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19" />Ico gihe nzohana</para>
  <para style="q2" vid="ZEP 3:19">abo bose babacinyiza,</para>
  <para style="q1" vid="ZEP 3:19">kandi nzokiza abacumbagira;</para>
  <para style="q2" vid="ZEP 3:19">nzokoraniriza hamwe abajanywe mu kinyago.</para>
  <para style="q1" vid="ZEP 3:19">Nzobahesha ishimwe n’icubahiro</para>
  <para style="q2" vid="ZEP 3:19">mu mahanga yose aho babaye bababazwa n’ibiteterwe.<verse eid="ZEP 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20" />Ico gihe ni ho nzobegeraniriza hamwe;</para>
  <para style="q2" vid="ZEP 3:20">kandi ico gihe ni ho nzobatahana i muhira.</para>
  <para style="q1" vid="ZEP 3:20">Nzobahesha icubahiro n’ishimwe</para>
  <para style="q2" vid="ZEP 3:20">mu mahanga yose yo kw’isi,</para>
  <para style="q1" vid="ZEP 3:20">igihe nzobasubiza ubutunzi bwanyu</para>
  <para style="q2" vid="ZEP 3:20">mukavyibonera n’amaso yanyu,”</para>
  <para style="q2" vid="ZEP 3:20">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>