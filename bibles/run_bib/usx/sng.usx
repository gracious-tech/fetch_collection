  <para style="h">Indirimbo</para>
  <para style="toc1">Indirimbo ya Salomo</para>
  <para style="toc2">Indirimbo</para>
  <para style="toc3">Ind</para>
  <para style="mt1">Indirimbo</para>
  <para style="mt2">ya Salomo</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />Indirimbo iruta izindi ya Salomo.<verse eid="SNG 1:1" /></para>
  <para style="sp">Umugeni</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />Nunsomeshe iminwa yawe,</para>
  <para style="q2" vid="SNG 1:2">kuko urukundo rwawe ruryoshe kuruta umuvinyu.<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />Ugutamirana kw’ibimota vyawe ni kwiza;</para>
  <para style="q2" vid="SNG 1:3">izina ryawe ni nk’ibimota neza bisutswe.</para>
  <para style="q2" vid="SNG 1:3">Ni co gituma abigeme bagukunda.<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />Nkwega ukuboko, twiruke!</para>
  <para style="q2" vid="SNG 1:4">Umwami nantware mu cumba ciwe.</para>
  <para style="sp" vid="SNG 1:4">Abakobwa b’i Yerusalemu</para>
  <para style="q1" vid="SNG 1:4">Turakunezererwa kandi uraduhimbara; mwami.</para>
  <para style="q2" vid="SNG 1:4">Tuzohimbaza urukundo rwawe kuruta umuvinyu.</para>
  <para style="sp" vid="SNG 1:4">Umugeni</para>
  <para style="q1" vid="SNG 1:4">Ni vyo birababereye ko bagukunda!<verse eid="SNG 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />Ndirabura, ariko ndi mwiza,</para>
  <para style="q2" vid="SNG 1:5">yemwe bakobwa b’i Yerusalemu,</para>
  <para style="q1" vid="SNG 1:5">nirabura nk’amahema y’i Kedari,</para>
  <para style="q2" vid="SNG 1:5">nsa n’impuzu nziza zigize amahema ya Salomo.<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />Ntimunkengere kuko nirabura,</para>
  <para style="q2" vid="SNG 1:6">kuko nirabujwe n’izuba.</para>
  <para style="q1" vid="SNG 1:6">Basazanje barandakiye</para>
  <para style="q2" vid="SNG 1:6">bandungika kurinda imizabibu yabo;</para>
  <para style="q1" vid="SNG 1:6">maze siniraba jewe ubwanje,</para>
  <para style="q2" vid="SNG 1:6">kandi sinitaho uruzabibu rwanje.<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />Mbwira, yewe mukunzi wanje,</para>
  <para style="q2" vid="SNG 1:7">mbega uragira hehe umukuku wawe uno musi?</para>
  <para style="q2" vid="SNG 1:7">Mu mashoka uzivyagiza hehe?</para>
  <para style="q1" vid="SNG 1:7">Ni kubera iki norinda kuba nk’umugore yazimiye,</para>
  <para style="q2" vid="SNG 1:7">i ruhande y’imikuku ya bagenzawe?<verse eid="SNG 1:7" /></para>
  <para style="sp">Abagenzi</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />Niwaba utahazi, yewe mugore mwiza kuruta abandi bagore,</para>
  <para style="q2" vid="SNG 1:8">kurikirana amakanda y’intama zanje</para>
  <para style="q1" vid="SNG 1:8">kandi uturukirize imyagazi y’impene zawe</para>
  <para style="q2" vid="SNG 1:8">i ruhande y’amahema y’abungere.<verse eid="SNG 1:8" /></para>
  <para style="sp">Umukwe</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />Mukunzi wanje, ndakugereranya n’ifarasi</para>
  <para style="q2" vid="SNG 1:9">ikwega umwe mu mikogote ya Farawo.<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />Mbega ukuntu nkunda amatama yawe, ni meza hagati y’impeta zo ku matwi yawe,</para>
  <para style="q2" vid="SNG 1:10">n’izosi ryawe ni ryiza hagati mu migufu.<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />Tuzogucurira amahereni yo ku matwi y’inzahabu,</para>
  <para style="q2" vid="SNG 1:11">zisharijwe n’ifeza.<verse eid="SNG 1:11" /></para>
  <para style="sp">Umugeni</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />Umwami akiri ku kigwa ciwe,</para>
  <para style="q2" vid="SNG 1:12">amavuta yanje yaratamiranye.<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />Umukunzi wanje, kuri jewe ameze nk’umukama w’ibimota neza</para>
  <para style="q2" vid="SNG 1:13">uryamye hagati y’amabere yanje.<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />Umukunzi wanje, kuri jewe ameze nk’ishurwe ryitwa ikirungu</para>
  <para style="q2" vid="SNG 1:14">iyo gishuritse mu mizabibu y’i Eni-Gedi.<verse eid="SNG 1:14" /></para>
  <para style="sp">Umukwe</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />Ese ingene uri mwiza, mukunzi wanje!</para>
  <para style="q2" vid="SNG 1:15">Ese ingene uri mwiza!</para>
  <para style="q2" vid="SNG 1:15">Amaso yawe asa n’ay’akanuma kitwa kolombe.<verse eid="SNG 1:15" /></para>
  <para style="sp">Umugeni</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />Ese ukuntu uri mwiza, mukunzi wanje!</para>
  <para style="q2" vid="SNG 1:16">Ese ukuntu unezera!</para>
  <para style="q2" vid="SNG 1:16">Kandi uburiri bwacu busa n’umurima utotahaye.<verse eid="SNG 1:16" /></para>
  <para style="sp">Umukwe</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17" />Inkingi z’inzu yacu ni amasederi;</para>
  <para style="q2" vid="SNG 1:17">kandi igisenge c’inzu yacu ni utujwari.<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="sp">Umugeni</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />Ndi ishurwe, ikirungu c’i Sharoni,</para>
  <para style="q2" vid="SNG 2:1">ishurwe ryo mu biyaya.<verse eid="SNG 2:1" /></para>
  <para style="sp">Umukwe</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />Nk’uko ishurwe rimera iyo riri hagati mu mahwa</para>
  <para style="q2" vid="SNG 2:2">ni ko umukunzi wanje ameze hagati mu bandi bakobwa.<verse eid="SNG 2:2" /></para>
  <para style="sp">Umugeni</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />Nk’uko igiti c’ivyamwa vyitwa pome kimera mu biti vyo mw’ishamba</para>
  <para style="q2" vid="SNG 2:3">ni ko umukunzi wanje ameze hagati mu bandi basore.</para>
  <para style="q1" vid="SNG 2:3">Nezerwa no kwicara mu gitutu ciwe,</para>
  <para style="q2" vid="SNG 2:3">kandi ivyamwa vyiwe biransosera.<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />Yanjanye mu nzu y’ibirori,</para>
  <para style="q2" vid="SNG 2:4">aca aduza hejuru yanje ibendera ry’urukundo.<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />Nsubizamwo intege ukoresheje inzabibu,</para>
  <para style="q2" vid="SNG 2:5">zimya inyota yanje n’ivyamwa vyitwa pome,</para>
  <para style="q2" vid="SNG 2:5">kuko urukundo runtwaye inkomezi.<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />Ukuboko kwiwe kw’i bubamfu kuranseguye,</para>
  <para style="q2" vid="SNG 2:6">ukuboko kwiwe kw’i buryo kurambumbatiye.<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />Bakobwa b’i Yerusalemu ndabihanikirije,</para>
  <para style="q2" vid="SNG 2:7">ingeregere n’impongokazi vyo mw’ishamba vyumva:</para>
  <para style="q1" vid="SNG 2:7">Ntimukome urukundo canke ngo murukangure,</para>
  <para style="q2" vid="SNG 2:7">gushika rwishakiye kuvyuka.<verse eid="SNG 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />Umviriza! Ndumva umukunzi wanje!</para>
  <para style="q2" vid="SNG 2:8">Raba! Araje,</para>
  <para style="q1" vid="SNG 2:8">yiginagura ku misozi,</para>
  <para style="q2" vid="SNG 2:8">asimbagurika ku dusozi.<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />Umukunzi wanje ameze nk’ingeregere canke nk’inyana y’impongo.</para>
  <para style="q2" vid="SNG 2:9">Raba! Ahagaze hariya inyuma y’uruzitiro,</para>
  <para style="q1" vid="SNG 2:9">arungurukira mu madirisha,</para>
  <para style="q2" vid="SNG 2:9">arungurukira mu rusika.<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />Umukunzi wanje ambwira ati:</para>
  <para style="q2" vid="SNG 2:10">“Haguruka, mukunzi wanje,</para>
  <para style="q2" vid="SNG 2:10">mwiza wanje, uze aho ndi.<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />Raba! Urushana ruraheze;</para>
  <para style="q2" vid="SNG 2:11">imvura irahise iracitse.<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />Amashurwe arashuritse kw’isi;</para>
  <para style="q2" vid="SNG 2:12">igihe co kuririmba kirashitse,</para>
  <para style="q1" vid="SNG 2:12">inuma ziraguguza</para>
  <para style="q2" vid="SNG 2:12">kandi zirumvikana mu gihugu cacu.<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />Umusukoni uratanguye kwama;</para>
  <para style="q2" vid="SNG 2:13">imizabibu ishuritse iratamirana ugutamirana kwayo.</para>
  <para style="q1" vid="SNG 2:13">Haguruka uze, mukunzi wanje;</para>
  <para style="q2" vid="SNG 2:13">mwiza wanje, uze aho ndi.”<verse eid="SNG 2:13" /></para>
  <para style="sp">Umukwe</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />Kanuma kanje kinyegeje mu bitandara,</para>
  <para style="q2" vid="SNG 2:14">mu bibundo vyo ku musozi,</para>
  <para style="q1" vid="SNG 2:14">nyereka mu maso hawe,</para>
  <para style="q2" vid="SNG 2:14">nyumvisha ijwi ryawe;</para>
  <para style="q1" vid="SNG 2:14">kuko ijwi ryawe riryoshe,</para>
  <para style="q2" vid="SNG 2:14">mu maso hawe hakaba ah’igikundiro.<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />Nimudufatire imbwebwe,</para>
  <para style="q2" vid="SNG 2:15">utubwebwe dutoduto</para>
  <para style="q1" vid="SNG 2:15">twonona imizabibu,</para>
  <para style="q2" vid="SNG 2:15">kandi imizabibu yacu ishuritse.<verse eid="SNG 2:15" /></para>
  <para style="sp">Umugeni</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />Umukunzi wanje ni uwanje, nanje ndi uwiwe;</para>
  <para style="q2" vid="SNG 2:16">aragira mu mashurwe.<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />Gushika umutwenzi utambitse</para>
  <para style="q2" vid="SNG 2:17">ijoro riheze,</para>
  <para style="q1" vid="SNG 2:17">hindukira mukunzi wanje,</para>
  <para style="q2" vid="SNG 2:17">ube nk’ingeregere</para>
  <para style="q1" vid="SNG 2:17">canke nk’inyana y’impongo</para>
  <para style="q2" vid="SNG 2:17">mu bitandara vyo ku misozi.<verse eid="SNG 2:17" /></para>
  <para style="b" />
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />Mw’ijoro ndi ku buriri bwanje</para>
  <para style="q2" vid="SNG 3:1">narondeye uwo umutima wanje ukunda;</para>
  <para style="q2" vid="SNG 3:1">naramurondeye sinamuronka.<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />Ngira mvyuke ubu nyene nzunguruke mu gisagara,</para>
  <para style="q2" vid="SNG 3:2">mu mabarabara yaco no mu bibuga vyaco;</para>
  <para style="q1" vid="SNG 3:2">ndondere uwo umutima wanje ukunda.</para>
  <para style="q2" vid="SNG 3:2">Maze ndamurondera ariko ndamubura.<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />Abarinzi barinda igisagara barambona</para>
  <para style="q2" vid="SNG 3:3">aho bariko barazunguruka igisagara.</para>
  <para style="q2" vid="SNG 3:3">“Mwamboneye uwo umutima wanje ukunda?”<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />Nkibarengana</para>
  <para style="q2" vid="SNG 3:4">ni ho nabona uwo umutima wanje ukunda.</para>
  <para style="q1" vid="SNG 3:4">Ndamufata kandi nanka kumurekura</para>
  <para style="q2" vid="SNG 3:4">gushika aho namushikanye mu nzu ya mama,</para>
  <para style="q2" vid="SNG 3:4">mu cumba c’uwanyibungenze.<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />Bakobwa b’i Yerusalemu ndabihanikirije,</para>
  <para style="q2" vid="SNG 3:5">ingeregere n’impongokazi vyo mw’ishamba vyumva:</para>
  <para style="q1" vid="SNG 3:5">Ntimukome urukundo canke ngo murukangure,</para>
  <para style="q2" vid="SNG 3:5">gushika rwishakiye kuvyuka.<verse eid="SNG 3:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />Ni nde aje avuye mu bugaragwa</para>
  <para style="q2" vid="SNG 3:6">ameze nk’inkingi y’umwotsi,</para>
  <para style="q1" vid="SNG 3:6">yisize ibimota neza</para>
  <para style="q2" vid="SNG 3:6">vyakozwe mu bimota vyose vy’abadandaza?<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />Raba! Ni umukogote wa Salomo,</para>
  <para style="q2" vid="SNG 3:7">ukikijwe n’abagwanyi mirongo itandatu,</para>
  <para style="q2" vid="SNG 3:7">b’intore zo mu Bisirayeli,<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />bose bambaye inkota,</para>
  <para style="q2" vid="SNG 3:8">kandi bamenyereye kugwana,</para>
  <para style="q1" vid="SNG 3:8">umwe wese yambaye inkota yiwe kw’itako,</para>
  <para style="q2" vid="SNG 3:8">biteguye kugwanya ibiteye ubwoba vyo mw’ijoro.<verse eid="SNG 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />Umwami Salomo yikoreye umukogote;</para>
  <para style="q2" vid="SNG 3:9">yawukoze mu biti vy’i Libani.<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />Ufise inkingi z’ifeza,</para>
  <para style="q2" vid="SNG 3:10">umushinge wawo ni uw’inzahabu.</para>
  <para style="q1" vid="SNG 3:10">Intebe yawo yasa n’agahama,</para>
  <para style="q2" vid="SNG 3:10">imbere muri wo hashazishijwe urukundo n’abakobwa b’i Yerusalemu.<verse eid="SNG 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11" />Nimusohoke, yemwe bakobwa b’i Siyoni,</para>
  <para style="q2" vid="SNG 3:11">murabe umwami Salomo yambaye urugori,</para>
  <para style="q1" vid="SNG 3:11">urwo nyina yamwambitse</para>
  <para style="q2" vid="SNG 3:11">ku musi w’ubukwe bwiwe,</para>
  <para style="q1" vid="SNG 3:11">ku musi umutima wiwe wanezerwa.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">Umukwe</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />Ese ingene uri mwiza, mukunzi wanje!</para>
  <para style="q2" vid="SNG 4:1">Mbega ukuntu uri mwiza!</para>
  <para style="q2" vid="SNG 4:1">Amaso yawe ari mu mwitwikiro ameze nk’ay’inuma yitwa kolombe.</para>
  <para style="q1" vid="SNG 4:1">Umushatsi wawe umeze nk’umukuku w’impene</para>
  <para style="q2" vid="SNG 4:1">umanuka ku musozi Gileyadi.<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />Amenyo yawe yera nk’umukuku w’intama zamowe ubwoya,</para>
  <para style="q2" vid="SNG 4:2">ziduga zivuye kwoga.</para>
  <para style="q1" vid="SNG 4:2">Imwe yose yonsa amahasa;</para>
  <para style="q2" vid="SNG 4:2">nta n’imwe iri yonyene.<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />Iminwa yawe isa n’umugozi w’agahama;</para>
  <para style="q2" vid="SNG 4:3">akanwa kawe ni keza.</para>
  <para style="q1" vid="SNG 4:3">Amatama yawe mu mwitwikiro</para>
  <para style="q2" vid="SNG 4:3">ni nk’ibimanyu vy’ikomamanga.<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />Izosi ryawe rimeze nk’umunara wa Dawidi,</para>
  <para style="q2" vid="SNG 4:4">wubatswe nk’umuzingi;</para>
  <para style="q1" vid="SNG 4:4">kuri wo hamanitse inkinzo igihumbi,</para>
  <para style="q2" vid="SNG 4:4">zose zari iz’abahizi.<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />Amabere yawe yompi ameze nk’inyana zibiri,</para>
  <para style="q2" vid="SNG 4:5">nk’amahasa y’inyana z’ingeregere,</para>
  <para style="q2" vid="SNG 4:5">zirisha hagati mu mashurwe.<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />Gushika umutwenzi utambike</para>
  <para style="q2" vid="SNG 4:6">ijoro rishize,</para>
  <para style="q1" vid="SNG 4:6">nzoguma ku musozi w’ibimota neza vyawe</para>
  <para style="q2" vid="SNG 4:6">no ku gasozi k’ibitamirana neza.<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />Uri mwiza hose, mwiza wanje;</para>
  <para style="q2" vid="SNG 4:7">nta gatosi kari kuri wewe.<verse eid="SNG 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />Nuze tuve i Libani, mugeni wanje,</para>
  <para style="q2" vid="SNG 4:8">nuze tuve i Libani.</para>
  <para style="q1" vid="SNG 4:8">Manuka uve ku gatwe ka Amana,</para>
  <para style="q2" vid="SNG 4:8">ku gatwe ka Seniri, ku gatwe ka Herumoni,</para>
  <para style="q1" vid="SNG 4:8">aho intambwe zifise ibinogo zibamwo</para>
  <para style="q2" vid="SNG 4:8">ahari uburyamo bw’ingwe.<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />Wantwaye umutima, mushikanje, mugeni wanje;</para>
  <para style="q2" vid="SNG 4:9">wantwaye umutima</para>
  <para style="q1" vid="SNG 4:9">ku bwo kuraba kw’amaso yawe,</para>
  <para style="q2" vid="SNG 4:9">kubera agatete kamwe ko ku rudede rwawe.<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />Ese ukuntu urukundo rwawe ari rwiza, mushikanje, mugeni wanje!</para>
  <para style="q2" vid="SNG 4:10">Urukundo rwawe ruraryoshe kurusha umuvinyu,</para>
  <para style="q1" vid="SNG 4:10">n’ukumota kw’amavuta yawe</para>
  <para style="q2" vid="SNG 4:10">kuryoshe kurusha ibindi bimota vyose!<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />Iminwa yawe isosa nk’ikigigu c’ubuki, mugeni wanje;</para>
  <para style="q2" vid="SNG 4:11">amata n’ubuki biri musi y’ururimi rwawe.</para>
  <para style="q1" vid="SNG 4:11">Ukumota kw’impuzu zawe</para>
  <para style="q2" vid="SNG 4:11">ni nk’ukw’i Libani.<verse eid="SNG 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />Uri umurima uzitiye, mushikanje, mugeni wanje;</para>
  <para style="q2" vid="SNG 4:12">uri iriba rizitiye, isoko rishizeko ikidodo.<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />Imivyaro yawe ni umurima w’amakomamanga</para>
  <para style="q2" vid="SNG 4:13">w’ivyamwa vy’indobanurwa,</para>
  <para style="q2" vid="SNG 4:13">aho hena na narada biri,<verse eid="SNG 4:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="SNG 4:14" />narada na safaroni,</para>
  <para style="q2" vid="SNG 4:14">kalamusi na kinamoni,</para>
  <para style="q2" vid="SNG 4:14">n’ibiti vyose bimota neza,</para>
  <para style="q2" vid="SNG 4:14">n’isenga na alowe</para>
  <para style="q2" vid="SNG 4:14">n’ibimota birusha ibindi.<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />Uri iriba rivomera umurima,</para>
  <para style="q2" vid="SNG 4:15">iriba ry’amazi atemba</para>
  <para style="q2" vid="SNG 4:15">atemba ava i Libani.<verse eid="SNG 4:15" /></para>
  <para style="sp">Umugeni</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />Ikangure wa muyaga wo mu buraruko,</para>
  <para style="q2" vid="SNG 4:16">nawe muyaga wo mu bumanuko, nuze!</para>
  <para style="q1" vid="SNG 4:16">Muhuhe ku murima wanje,</para>
  <para style="q2" vid="SNG 4:16">kugira ngo ubumote bwawo bukwire hose.</para>
  <para style="q1" vid="SNG 4:16">Umukunzi wanje naze mu murima wiwe</para>
  <para style="q2" vid="SNG 4:16">anezerererwe ivyamwa vyawo vy’indobanurwa.<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">Umukwe</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />Ninjiye mu murima wanje, mushikanje, mugeni wanje;</para>
  <para style="q2" vid="SNG 5:1">negeranije isenga ryanje n’ibimota neza vyanje.</para>
  <para style="q1" vid="SNG 5:1">Nariye n’ikigigu c’ubuki canje n’ubuki bwanje;</para>
  <para style="q2" vid="SNG 5:1">nanyoye umuvinyu wanje n’amata yanje.</para>
  <para style="sp" vid="SNG 5:1">Abagenzi</para>
  <para style="q1" vid="SNG 5:1">Nimurye, yemwe bagenzi, kandi munywe;</para>
  <para style="q2" vid="SNG 5:1">nimunywe muhage, ivy’urukundo.<verse eid="SNG 5:1" /></para>
  <para style="sp">Umugeni</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />Nari nsinziriye ariko umutima wanje uri maso.</para>
  <para style="q2" vid="SNG 5:2">Nca numva umukunzi wanje ariko aradodora:</para>
  <para style="q1" vid="SNG 5:2">“Nyugururira, mushikanje, mukunzi wanje</para>
  <para style="q2" vid="SNG 5:2">kanuma kanje, utagira agatosi.</para>
  <para style="q1" vid="SNG 5:2">Kuko umutwe wanje watonzeko urume,</para>
  <para style="q2" vid="SNG 5:2">umushatsi wanje ukaba watonzweko n’amatonyanga yo mw’ijoro.”<verse eid="SNG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />Ko namaze kwambura umwambaro wanje,</para>
  <para style="q2" vid="SNG 5:3">noshobora gusubira kuwambara?</para>
  <para style="q1" vid="SNG 5:3">Ko namaze kwoga ibirenge,</para>
  <para style="q2" vid="SNG 5:3">nosubira kuvyanduza?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />Umukunzi wanje acisha ukuboko mu rugi;</para>
  <para style="q2" vid="SNG 5:4">umutima wanje utangura gusimba ku bwiwe.<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />Ndavyuka ngo nugururire umukunzi wanje,</para>
  <para style="q2" vid="SNG 5:5">kandi ibiganza vyanje vyajobetswe mu bimota neza,</para>
  <para style="q1" vid="SNG 5:5">intoke zanje zajejeta isenga,</para>
  <para style="q2" vid="SNG 5:5">aho nugurura urugi.<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />Maze nugururira umukunzi wanje,</para>
  <para style="q2" vid="SNG 5:6">ariko umukunzi wanje si ho yari; yari yagiye.</para>
  <para style="q2" vid="SNG 5:6">Umutima wanje unshongeramwo kuko yagiye.</para>
  <para style="q1" vid="SNG 5:6">Ndamurondera ariko sinamuronka.</para>
  <para style="q2" vid="SNG 5:6">Ndamuhamagara ariko ntiyishura.<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />Abarinzi baramfata</para>
  <para style="q2" vid="SNG 5:7">aho bariko baragenzura igisagara.</para>
  <para style="q1" vid="SNG 5:7">Barankubita, barankomeretsa;</para>
  <para style="q2" vid="SNG 5:7">bantwara ikoti yanje,</para>
  <para style="q2" vid="SNG 5:7">abo barinzi b’inzitiro!<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />Yemwe bakobwa b’i Yerusalemu, ndabihanikirije,</para>
  <para style="q2" vid="SNG 5:8">mbega nimwambonera umukunzi wanje,</para>
  <para style="q1" vid="SNG 5:8">muza kumubwira iki?</para>
  <para style="q2" vid="SNG 5:8">Mumubwire ko urukundo rundembeje.<verse eid="SNG 5:8" /></para>
  <para style="sp">Abagenzi</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />Umukunzi wawe arusha iki abandi,</para>
  <para style="q2" vid="SNG 5:9">yewe wewe urusha abandi ubwiza?</para>
  <para style="q1" vid="SNG 5:9">Umukunzi wawe aruta abandi gute,</para>
  <para style="q2" vid="SNG 5:9">kugeza aho utwihanikiriza bigeze iyo?<verse eid="SNG 5:9" /></para>
  <para style="sp">Umukwe</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />Umukunzi wanje ni mwiza kandi arakomeye,</para>
  <para style="q2" vid="SNG 5:10">arisa wenyene mu bantu ibihumbi cumi.<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />Umutwe wiwe ni inzahabu yamazwe inkamba;</para>
  <para style="q2" vid="SNG 5:11">umushatsi wiwe uratsivye</para>
  <para style="q2" vid="SNG 5:11">kandi urirabura nk’igikona.<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />Amaso yiwe ni nk’ay’intunguru</para>
  <para style="q2" vid="SNG 5:12">iyo turi ku migezi y’amazi,</para>
  <para style="q1" vid="SNG 5:12">tumeze nk’utwogejwe mu mata,</para>
  <para style="q2" vid="SNG 5:12">duhagaze nk’intete z’ibidede.<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />Amatama yiwe ni nk’uburiri buriko ibimota neza</para>
  <para style="q2" vid="SNG 5:13">bugatamirana ibimotesha.</para>
  <para style="q1" vid="SNG 5:13">Iminwa yiwe ni amashurwe</para>
  <para style="q2" vid="SNG 5:13">atemba isenga.<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />Amaboko yiwe ni inkoni z’inzahabu</para>
  <para style="q2" vid="SNG 5:14">zisharijwe n’utubuye twitwa kirisolito.</para>
  <para style="q1" vid="SNG 5:14">Umubiri wiwe umeze nk’ihembe ry’inzovu</para>
  <para style="q2" vid="SNG 5:14">risharijwe n’ibuye ry’agaciro ryitwa lapisi lazuli.<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />Amaguru yiwe ni nk’inkingi za marubule</para>
  <para style="q2" vid="SNG 5:15">zashinzwe ku matanguriro y’inzahabu nziza.</para>
  <para style="q1" vid="SNG 5:15">Mu maso hiwe hasa n’i Libani,</para>
  <para style="q2" vid="SNG 5:15">hatoranijwe kubera amasederi yaho.<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />Akanwa kiwe karasosa gusa;</para>
  <para style="q2" vid="SNG 5:16">eka ni umukundwa hose.</para>
  <para style="q1" vid="SNG 5:16">Uyu ni umukunzi wanje, umugenzi wanje,</para>
  <para style="q2" vid="SNG 5:16">yemwe bakobwa b’i Yerusalemu.<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">Abagenzi</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />Umukunzi wawe yagiye hehe,</para>
  <para style="q2" vid="SNG 6:1">yewe mugore urusha abandi bagore ubwiza?</para>
  <para style="q1" vid="SNG 6:1">Umukunzi wawe yajanye iyihe nzira,</para>
  <para style="q2" vid="SNG 6:1">kugira ngo tugufashe kumurondera?<verse eid="SNG 6:1" /></para>
  <para style="sp">Umugeni</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />Umukunzi wanje yamanutse mu murima wiwe,</para>
  <para style="q2" vid="SNG 6:2">ahari ibimota neza vyiwe,</para>
  <para style="q1" vid="SNG 6:2">kuragira mu mirima,</para>
  <para style="q2" vid="SNG 6:2">no kwamura amashurwe.<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />Ndi uw’umukunzi wanje n’umukunzi wanje ni uwanje;</para>
  <para style="q2" vid="SNG 6:3">aragira mu mashurwe.<verse eid="SNG 6:3" /></para>
  <para style="sp">Umukwe</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />Uri mwiza, mukunzi wanje, nk’igisagara c’i Tiriza,</para>
  <para style="q2" vid="SNG 6:4">uri uw’igikundiro nk’i Yerusalemu,</para>
  <para style="q2" vid="SNG 6:4">uteye ubwoba nk’ingabo zifise amabendera.<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />Hindukira ureke kundaba;</para>
  <para style="q2" vid="SNG 6:5">kuko amaso yawe andengeye.</para>
  <para style="q1" vid="SNG 6:5">Umushatsi wawe ni nk’umukuku w’impene</para>
  <para style="q2" vid="SNG 6:5">umanuka uva i Gileyadi.<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />Amenyo yawe yera nk’umukuku w’intama</para>
  <para style="q2" vid="SNG 6:6">zamowe ubwoya, ziduga zivuye kwoga.</para>
  <para style="q1" vid="SNG 6:6">Imwe yose yonsa amahasa,</para>
  <para style="q2" vid="SNG 6:6">nta n’imwe iri yonyene.<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />Amatama yawe ari mu mwitwikiro wawe</para>
  <para style="q2" vid="SNG 6:7">ameze nk’ibice vy’ikomamanga.<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />Abamikazi naho boba mirongo itandatu,</para>
  <para style="q2" vid="SNG 6:8">n’incoreke zikaba mirongo umunani,</para>
  <para style="q2" vid="SNG 6:8">n’inkumi zirenze igitigiri;<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />ariko inanuma wanje, uwutagira agatosi, arisa,</para>
  <para style="q2" vid="SNG 6:9">ni umukobwa umwe kuri nyina,</para>
  <para style="q2" vid="SNG 6:9">ni umukundwa cane ku wamuvyaye.</para>
  <para style="q1" vid="SNG 6:9">Abaguranokazi baramubonye bamwita umuhirwe;</para>
  <para style="q2" vid="SNG 6:9">abamikazi n’incoreke baramuhimbaza.<verse eid="SNG 6:9" /></para>
  <para style="sp">Abagenzi</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />Urya ni nde aserutse nk’umutwenzi,</para>
  <para style="q2" vid="SNG 6:10">mwiza nk’ukwezi, akayagana nk’izuba,</para>
  <para style="q2" vid="SNG 6:10">akayangana nk’inyenyeri?<verse eid="SNG 6:10" /></para>
  <para style="sp">Umukwe</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />Namanutse nja mu biti vy’imirinzi</para>
  <para style="q2" vid="SNG 6:11">ngo ndabe imivyaro yo mu kiyaya,</para>
  <para style="q1" vid="SNG 6:11">ngo ndabe ko uruzabibu rwatotahaye,</para>
  <para style="q2" vid="SNG 6:11">n’amakomamanga ko yashuritse.<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />Ariko ntarabimenya,</para>
  <para style="q2" vid="SNG 6:12">ivyipfuzo vyanje vyantwaye ku mikogote y’umwami w’abantu banje.<verse eid="SNG 6:12" /></para>
  <para style="sp">Abagenzi</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />Garuka, garuka, wa Munyashulamukazi we;</para>
  <para style="q2" vid="SNG 6:13">garuka, garuka, kugira ngo tukwihweze!</para>
  <para style="sp" vid="SNG 6:13">Umukwe</para>
  <para style="q1" vid="SNG 6:13">Ni igiki cotuma mwihweza Umunyashulamukazi</para>
  <para style="q2" vid="SNG 6:13">nko mu gihe co gutamba c’i Mahanayimu?<verse eid="SNG 6:13" /></para>
  <para style="b" />
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1" />Ese ingene ibirenge vyawe ari vyiza mu birato vyavyo,</para>
  <para style="q2" vid="SNG 7:1">yewe mukobwa w’umwami!</para>
  <para style="q1" vid="SNG 7:1">Amaguru yawe meza ameze nk’ubudede,</para>
  <para style="q2" vid="SNG 7:1">igikorwa cahinguwe n’amaboko y’umuhinga.<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />Urukenyerero rwawe rumeze nk’igikombe</para>
  <para style="q2" vid="SNG 7:2">kitigera kiburamwo umuvinyu umota neza.</para>
  <para style="q1" vid="SNG 7:2">Inda yawe ni ikirundo c’ingano</para>
  <para style="q2" vid="SNG 7:2">gikikujwe n’amashurwe.<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />Amabere yawe yompi ameze nk’inyana zibiri,</para>
  <para style="q2" vid="SNG 7:3">nk’amahasa y’ingeregere.<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />Izosi ryawe ni nk’umunara wubakishijwe amahembe y’inzovu.</para>
  <para style="q1" vid="SNG 7:4">Amaso yawe ni amariba y’i Heshiboni</para>
  <para style="q2" vid="SNG 7:4">ari i ruhande rw’i Bati Rabimu.</para>
  <para style="q1" vid="SNG 7:4">Izuru ryawe ni nk’umunara w’i Libani</para>
  <para style="q2" vid="SNG 7:4">werekeye i Damasiko.<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />Umutwe wawe ukubereye urugori nk’umusozi Karumeli.</para>
  <para style="q2" vid="SNG 7:5">Umushatsi wawe ni nk’umusezero w’i bwami;</para>
  <para style="q2" vid="SNG 7:5">umwami yafashwe mu bitsibo vyawo.<verse eid="SNG 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />Ese ingene uri mwiza kandi uhimbaye,</para>
  <para style="q2" vid="SNG 7:6">yewe rukundo rwanje, munezero wanje!<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />Igihagararo cawe ni nk’ikigazi,</para>
  <para style="q2" vid="SNG 7:7">kandi amabere yawe ni nk’amahando y’ivyamwa vyaco.<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />Ndavuga nti: “Ndurira ico kigazi;</para>
  <para style="q2" vid="SNG 7:8">nakire ku vyamwa vyaco.”</para>
  <para style="q1" vid="SNG 7:8">Amabere yawe arakaba nk’ibisoko vy’inzabibu,</para>
  <para style="q2" vid="SNG 7:8">ukumota kw’akanwa kawe ni nk’icamwa citwa pome,<verse eid="SNG 7:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9" />kandi mu kanwa kawe ni nk’umuvinyu uruta iyindi.</para>
  <para style="sp" vid="SNG 7:9">Umugeni</para>
  <para style="q1" vid="SNG 7:9">Uwo muvinyu icompa ukagenda utumbereye umukunzi wanje,</para>
  <para style="q2" vid="SNG 7:9">ukagenda utemba neza ku minwa no ku menyo.<verse eid="SNG 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />Jewe ndi uw’umukunzi wanje,</para>
  <para style="q2" vid="SNG 7:10">kandi ni jewe yipfuza.<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />Nuze, mukunzi wanje, tugende mu mirima,</para>
  <para style="q2" vid="SNG 7:11">tumare ijoro mu bigwati.<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />Tuzozinduka tuja mu mirima y’inzabibu</para>
  <para style="q2" vid="SNG 7:12">turabe ko imizabibu yameze,</para>
  <para style="q1" vid="SNG 7:12">turabe ko imimera yayo yasambuye,</para>
  <para style="q2" vid="SNG 7:12">kandi ko amakomamanga ashuritse,</para>
  <para style="q2" vid="SNG 7:12">aho ni ho nzoguhera urukundo rwanje.<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />Amapome aratamirana,</para>
  <para style="q2" vid="SNG 7:13">kandi i ruhande y’urugi rwacu hari ivyamwa vyose,</para>
  <para style="q1" vid="SNG 7:13">bishasha n’ivya kera,</para>
  <para style="q2" vid="SNG 7:13">ivyo nakubikiye, mukunzi wanje.<verse eid="SNG 7:13" /></para>
  <para style="b" />
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />Icompa ukaba nka musazanje,</para>
  <para style="q2" vid="SNG 8:1">uwonse ibere rya mama!</para>
  <para style="q1" vid="SNG 8:1">Gutyo, ndagusanze hanze,</para>
  <para style="q2" vid="SNG 8:1">nogusomaguye,</para>
  <para style="q2" vid="SNG 8:1">kandi nta n’umwe yoneguye.<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />Nokugiye imbere</para>
  <para style="q2" vid="SNG 8:2">nkakujana mu nzu ya mama,</para>
  <para style="q2" vid="SNG 8:2">we yanyigishije.</para>
  <para style="q1" vid="SNG 8:2">Noguhaye umuvinyu urimwo ibimota neza ukawunywa,</para>
  <para style="q2" vid="SNG 8:2">umutobe w’amapome yanje.<verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />Ukuboko kwiwe kw’i bubamfu kuranseguye,</para>
  <para style="q2" vid="SNG 8:3">ukuboko kwiwe kw’i buryo kurambumbatiye.<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />Bakobwa b’i Yerusalemu, ndabihanikirije:</para>
  <para style="q2" vid="SNG 8:4">Ntimukome urukundo canke ngo murukangure,</para>
  <para style="q2" vid="SNG 8:4">gushika rwishakiye kuvyuka.<verse eid="SNG 8:4" /></para>
  <para style="sp">Abagenzi</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />Urya ni nde aje ava mu bugaragwa</para>
  <para style="q2" vid="SNG 8:5">yegamiye umukunzi wiwe?</para>
  <para style="sp" vid="SNG 8:5">Umugeni</para>
  <para style="q1" vid="SNG 8:5">Nagukanguye uri musi y’igiti c’amapome;</para>
  <para style="q2" vid="SNG 8:5">aho ni ho nyoko wawe yagusamiye inda,</para>
  <para style="q2" vid="SNG 8:5">aho ni ho uwari ku gise yakwibarukiye.<verse eid="SNG 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />Nshira ku mutima wawe nk’ikidodo,</para>
  <para style="q2" vid="SNG 8:6">nk’ikidodo ku kuboko kwawe;</para>
  <para style="q1" vid="SNG 8:6">kuko urukundo rukomeye nk’urupfu,</para>
  <para style="q2" vid="SNG 8:6">ishari ryarwo rigakomera nk’i kuzimu.</para>
  <para style="q1" vid="SNG 8:6">Ruturira nk’umuriro waka,</para>
  <para style="q2" vid="SNG 8:6">nk’urubeya rukomeye.<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />Amazi menshi ntashobora kuzimya urukundo;</para>
  <para style="q2" vid="SNG 8:7">inzuzi ntizishobora kuruzimanganya.</para>
  <para style="q1" vid="SNG 8:7">Niyo umuntu yotanga</para>
  <para style="q2" vid="SNG 8:7">ivyo atunze vyose mu nzu yiwe ngo agure urukundo,</para>
  <para style="q2" vid="SNG 8:7">yogawa rwose.<verse eid="SNG 8:7" /></para>
  <para style="sp">Abagenzi</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />Dufise murumuna wacu,</para>
  <para style="q2" vid="SNG 8:8">kandi amabere yiwe ntarasonga.</para>
  <para style="q1" vid="SNG 8:8">Mbega tuzokorera iki murumuna wacu</para>
  <para style="q2" vid="SNG 8:8">ku musi azogira ubukwe?<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />Niyaba ari uruzitiro,</para>
  <para style="q2" vid="SNG 8:9">tuzokwubaka iminara y’ifeza kuri we.</para>
  <para style="q1" vid="SNG 8:9">Niyaba ari urugi,</para>
  <para style="q2" vid="SNG 8:9">tuzomwugaza ibihindizo vy’amasederi.<verse eid="SNG 8:9" /></para>
  <para style="sp">Umugeni</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />Ndi uruzitiro,</para>
  <para style="q2" vid="SNG 8:10">kandi amabere yanje ni nk’iminara.</para>
  <para style="q1" vid="SNG 8:10">Ni co gituma mu maso yiwe nabaye</para>
  <para style="q2" vid="SNG 8:10">nk’uwuzana akaneza.<verse eid="SNG 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />Salomo yari afise uruzabibu i Bayali-Hamoni,</para>
  <para style="q2" vid="SNG 8:11">maze asigarana urwo ruzabibu abakozi biwe.</para>
  <para style="q1" vid="SNG 8:11">Umwe wese yasabwa kuriha shekeli igihumbi<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">Ni nk’ibilo 12.</char></note> z’ifeza</para>
  <para style="q2" vid="SNG 8:11">zihuye n’ivyamwa yamuye.<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />Yamara uruzabibu rwanje ni urwanje ubwanje;</para>
  <para style="q2" vid="SNG 8:12">izo shekeli igihumbi nuzigumirize, yewe Salomo.</para>
  <para style="q2" vid="SNG 8:12">Ariko amajana abiri<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">Ni nk’ibilo 2,3.</char></note> ni az’abitayeho inzabibu zarwo.<verse eid="SNG 8:12" /></para>
  <para style="sp">Umukwe</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />Wewe uba mu mirima</para>
  <para style="q2" vid="SNG 8:13">uri kumwe n’abagenzi bagukorera,</para>
  <para style="q2" vid="SNG 8:13">nyumvisha ijwi ryawe!<verse eid="SNG 8:13" /></para>
  <para style="sp">Umugeni</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />Hunga, mukunzi wanje,</para>
  <para style="q2" vid="SNG 8:14">umere nk’ingeregere</para>
  <para style="q1" vid="SNG 8:14">canke nk’inyana y’impongokazi</para>
  <para style="q2" vid="SNG 8:14">ku misozi yuzuye ibimota neza.<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>