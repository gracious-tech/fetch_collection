  <para style="h">Amosi</para>
  <para style="toc1">Igitabu c’uwavugishwa n’Imana Amosi</para>
  <para style="toc2">Amosi</para>
  <para style="toc3">Am</para>
  <para style="mt2">Igitabu c’uwavugishwa n’Imana</para>
  <para style="mt1">Amosi</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />Aya ni amajambo yahawe Amosi, umwungere w’i Tekowa i Buyuda. Ayo majambo yayaronse mu vyo yeretswe imyaka ibiri imbere y’uko haba nyamugigima, hakaba hari ku ngoma ya Uziya umwami w’i Buyuda, n’iya Yerobowamu mwene Yowashi umwami wa Isirayeli.<verse eid="AMO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />Yavuze ati:</para>
  <para style="q1" vid="AMO 1:2">“<char style="nd">Uhoraho</char> yivuze ari i Siyoni</para>
  <para style="q2" vid="AMO 1:2">aturagara ari i Yerusalemu;</para>
  <para style="q1" vid="AMO 1:2">uburagiro bw’abungere buruma,</para>
  <para style="q2" vid="AMO 1:2">kandi ku gatwe ka Karumeli harakabirana.”<verse eid="AMO 1:2" /></para>
  <para style="s1">Imanza zizocirwa ibihugu bibanyi vya Isirayeli</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />Uku ni ko <char style="nd">Uhoraho</char> avuze:</para>
  <para style="q1" vid="AMO 1:3">“Kubera ivyaha bitatu vya Damasiko,</para>
  <para style="q2" vid="AMO 1:3">mbere ni bine, sinzogenda ntabahanye!</para>
  <para style="q1" vid="AMO 1:3">Kuko basekuje abantu banje b’i Gileyadi</para>
  <para style="q2" vid="AMO 1:3">imihini y’ivyuma.<verse eid="AMO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4" />Nzorungika umuriro ku nzu ya Hazayeli</para>
  <para style="q2" vid="AMO 1:4">kandi uzotongora impome zikomeye za Beni-Hadadi.<verse eid="AMO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5" />Nzohomvorera hasi amarembo y’i Damasiko;</para>
  <para style="q2" vid="AMO 1:5">nzokwica umwami ari mu kiyaya ca Aveni</para>
  <para style="q1" vid="AMO 1:5">n’uwufise inkoni yo kuganza ari i Beti-Edeni.</para>
  <para style="q2" vid="AMO 1:5">Abantu b’i Siriya bazojanwa ari inyagano i Kiru,”</para>
  <para style="q2" vid="AMO 1:5">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="AMO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />Uku ni ko <char style="nd">Uhoraho</char> avuze:</para>
  <para style="q1" vid="AMO 1:6">“Kubera ivyaha bitatu vy’i Gaza,</para>
  <para style="q2" vid="AMO 1:6">mbere ni bine, sinzogenda ntabahanye!</para>
  <para style="q1" vid="AMO 1:6">Ko bafashe abantu bo mu mihana yose bakabagira imbohe</para>
  <para style="q2" vid="AMO 1:6">maze bakabagurisha kuri Edomu;<verse eid="AMO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7" />nzorungika umuriro ku mpome z’i Gaza</para>
  <para style="q2" vid="AMO 1:7">utongore impome zikomeye zaho.<verse eid="AMO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8" />Nzorandura umwami w’i Ashidodi</para>
  <para style="q2" vid="AMO 1:8">n’uwufise inkoni yo kuganza w’i Ashikeloni.</para>
  <para style="q1" vid="AMO 1:8">Nzohindukiza ukuboko kwanje ngwanye Ekuroni,</para>
  <para style="q2" vid="AMO 1:8">gushika uwa nyuma wo mu Bafilisitiya apfuye,”</para>
  <para style="q2" vid="AMO 1:8">uko ni ko <char style="nd">Uhoraho</char> Nyeninganji avuze.<verse eid="AMO 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />Uku ni ko <char style="nd">Uhoraho</char> avuze:</para>
  <para style="q1" vid="AMO 1:9">“Kubera ivyaha bitatu vya Tiro,</para>
  <para style="q2" vid="AMO 1:9">mbere ni bine, sinzogenda ntabahanye!</para>
  <para style="q1" vid="AMO 1:9">Kuko bafashe abantu bo mu mihana yose</para>
  <para style="q2" vid="AMO 1:9">bakabagira imbohe bakabagurisha ku Banyedomu,</para>
  <para style="q2" vid="AMO 1:9">ntibubahiriza isezerano ry’uko ari abavukanyi.<verse eid="AMO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10" />Ku bw’ivyo nzorungika umuriro ku mpome z’i Tiro,</para>
  <para style="q2" vid="AMO 1:10">utongore impome zaho zikomeye.”<verse eid="AMO 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />Uku ni ko <char style="nd">Uhoraho</char> avuze:</para>
  <para style="q1" vid="AMO 1:11">“Kubera ivyaha bitatu vya Edomu,</para>
  <para style="q2" vid="AMO 1:11">mbere ni bine, sinzogenda ntabahanye.</para>
  <para style="q1" vid="AMO 1:11">Ko yakinagije umuvukanyi wiwe Isirayeli n’inkota</para>
  <para style="q2" vid="AMO 1:11">agasogota abagore bo mu gihugu,</para>
  <para style="q1" vid="AMO 1:11">kandi uburake bwiwe bukaziriringa urudaca,</para>
  <para style="q2" vid="AMO 1:11">ubushangashirwe bwiwe bukarurumba ntibuhwame;<verse eid="AMO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12" />nzorungika umuriro i Temani</para>
  <para style="q2" vid="AMO 1:12">utongore impome zikomeye z’i Bozira.”<verse eid="AMO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />Uku ni ko <char style="nd">Uhoraho</char> avuze:</para>
  <para style="q1" vid="AMO 1:13">“Kubera ivyaha bitatu vya Amoni,</para>
  <para style="q2" vid="AMO 1:13">mbere ni bine, sinzogenda ntabahanye!</para>
  <para style="q1" vid="AMO 1:13">Kuko bafomoye inda z’abagore bibungenze b’i Gileyadi</para>
  <para style="q2" vid="AMO 1:13">kugira ngo bagure imbibe zabo.<verse eid="AMO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14" />Nzorungika umuriro ku mpome z’i Raba</para>
  <para style="q2" vid="AMO 1:14">utongore impome zikomeye zaho</para>
  <para style="q1" vid="AMO 1:14">mu gihe hazoba hari akamo k’intambara,</para>
  <para style="q2" vid="AMO 1:14">intambara imeze nk’umuyaga w’igihuhusi.<verse eid="AMO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15" />Umwami waho azojanwa ari inyagano,</para>
  <para style="q2" vid="AMO 1:15">we hamwe n’abaganwa biwe bose,”</para>
  <para style="q2" vid="AMO 1:15">uko ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />Uku ni ko <char style="nd">Uhoraho</char> avuze:</para>
  <para style="q1" vid="AMO 2:1">“Kubera ivyaha bitatu vya Mowabu,</para>
  <para style="q2" vid="AMO 2:1">mbere ni bine, sinzogenda ntabahanye!</para>
  <para style="q1" vid="AMO 2:1">Ko batongoje umuriro bagahindura umunyota</para>
  <para style="q2" vid="AMO 2:1">amagufa y’umwami w’i Edomu,<verse eid="AMO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2" />nzorungika umuriro kuri Mowabu</para>
  <para style="q2" vid="AMO 2:2">uzotongora impome zikomeye z’i Keriyoti.</para>
  <para style="q1" vid="AMO 2:2">Abanyamowabu bazohindikirana bicwe n’igihumura,</para>
  <para style="q2" vid="AMO 2:2">kubera urwamo rw’intambara no kuvuza inzamba.<verse eid="AMO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3" />Nzorandura umwami waho,</para>
  <para style="q2" vid="AMO 2:3">kandi nzomwicana n’abaganwa baho,”</para>
  <para style="q2" vid="AMO 2:3">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="AMO 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />Uku ni ko <char style="nd">Uhoraho</char> avuze:</para>
  <para style="q1" vid="AMO 2:4">“Kubera ivyaha bitatu vya Yuda,</para>
  <para style="q2" vid="AMO 2:4">mbere ni bine, sinzogenda ntabahanye!</para>
  <para style="q1" vid="AMO 2:4">Kuko bateye ibitugu ivyagezwe vy’<char style="nd">Uhoraho</char></para>
  <para style="q2" vid="AMO 2:4">ntibitondera ivyo yihanikirije,</para>
  <para style="q1" vid="AMO 2:4">bazimizwa n’imana z’ibinyoma,</para>
  <para style="q2" vid="AMO 2:4">izo ba sekuruza bakurikiye.<verse eid="AMO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5" />Ni co gituma nzorungika umuriro kuri Yuda</para>
  <para style="q2" vid="AMO 2:5">uzotongora impome zikomeye z’i Yerusalemu.”<verse eid="AMO 2:5" /></para>
  <para style="s1">Urubanza ruzocirwa Isirayeli</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />Uku ni ko <char style="nd">Uhoraho</char> avuze:</para>
  <para style="q1" vid="AMO 2:6">“Kubera ivyaha bitatu vya Isirayeli,</para>
  <para style="q2" vid="AMO 2:6">mbere ni bine, sinzogenda ntabahanye!</para>
  <para style="q1" vid="AMO 2:6">Bagurisha uwutagira icaha ku giciro c’ifeza,</para>
  <para style="q2" vid="AMO 2:6">n’umukene bakamugurisha umwambaro umwe w’ibirato.<verse eid="AMO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7" />Basiribanga umutwe w’umukene</para>
  <para style="q2" vid="AMO 2:7">nk’uko basiribanga umukungugu</para>
  <para style="q2" vid="AMO 2:7">bakarenganya urubanza rw’impahazwa.</para>
  <para style="q1" vid="AMO 2:7">Umuhungu na se basangira umugore mu busambanyi bwabo</para>
  <para style="q2" vid="AMO 2:7">bagatukisha izina ryanje ryera.<verse eid="AMO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8" />Baryama i ruhande y’igicaniro cose,</para>
  <para style="q2" vid="AMO 2:8">bakisasira impuzu batse abakene kw’ingwati.</para>
  <para style="q1" vid="AMO 2:8">Kandi mu nzu y’imana zabo,</para>
  <para style="q2" vid="AMO 2:8">banywa umuvinyu batse abo baciriye imanza.<verse eid="AMO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9" />Ariko naranduye Abamori mu maso yabo,</para>
  <para style="q2" vid="AMO 2:9">naho mu burebure bwabo bari bameze nk’ibiti vy’amasederi</para>
  <para style="q2" vid="AMO 2:9">mu gukomera na ho bari bameze nk’ibiti vy’inganzamarumpu.</para>
  <para style="q1" vid="AMO 2:9">Nahoneje ivyamwa vyari hejuru ku mashami</para>
  <para style="q2" vid="AMO 2:9">ndandura n’imizi yabo mu kuzimu!<verse eid="AMO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10" />Nabaduganye ndabakura muri Egiputa</para>
  <para style="q2" vid="AMO 2:10">ndabarongora imyaka mirongo ine mu bugaragwa</para>
  <para style="q2" vid="AMO 2:10">ngo ndabahe igihugu c’Abamori.<verse eid="AMO 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11" />Kandi nahagurukije abavugishwa nanje bo mu bana banyu</para>
  <para style="q2" vid="AMO 2:11">n’Abanaziri mu misore yanyu.</para>
  <para style="q1" vid="AMO 2:11">Mbega ivyo si ivy’ukuri, ga yemwe bantu ba Isirayeli?”</para>
  <para style="q2" vid="AMO 2:11">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="AMO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12" />“Ariko mwahatiye Abanaziri kunywa umuvinyu,</para>
  <para style="q2" vid="AMO 2:12">mutegeka abavugishwa nanje kudakura ururimi mu kanwa.<verse eid="AMO 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13" />None rero ngiye kubasiribanga</para>
  <para style="q2" vid="AMO 2:13">nk’uko umukogote usiribanga isi iyo wiremetse ingano.<verse eid="AMO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14" />Uwuzi kwiruka cane ntibizomukiza,</para>
  <para style="q2" vid="AMO 2:14">n’umunyenkomezi ntazokwikiza kubera inkomezi ziwe,</para>
  <para style="q2" vid="AMO 2:14">kandi n’umuhizi mu ntambara ntazokwikiza.<verse eid="AMO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15" />Uwurasisha umuheto ntazoshobora guhagarara,</para>
  <para style="q2" vid="AMO 2:15">uwunyaruka mu kwiruka ntazoshobora kwiruka ngo anyage amagara yiwe,</para>
  <para style="q2" vid="AMO 2:15">kandi n’uwugendera kw’ifarasi ntazokwikiza.<verse eid="AMO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16" />Mbere, n’umuhizi mu ntambara,</para>
  <para style="q2" vid="AMO 2:16">kuri uwo musi azohunga ata co yambaye,”</para>
  <para style="q2" vid="AMO 2:16">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s1">Ivyabona vyo kwagiriza Isirayeli</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />Nimwumve iri jambo, yemwe Bisirayeli, ijambo <char style="nd">Uhoraho</char> yavuze abagiriza, yagiriza umuryango wose yaduganye akuye muri Egiputa. Yavuze ati:<verse eid="AMO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2" />“Ni mwebwe mwenyene natoranije</para>
  <para style="q2" vid="AMO 3:2">mu miryango yose yo mw’isi;</para>
  <para style="q1" vid="AMO 3:2">ni co gituma nzobahanira</para>
  <para style="q2" vid="AMO 3:2">ivyaha vyanyu vyose.<verse eid="AMO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3" />Mbega babiri bojana</para>
  <para style="q2" vid="AMO 3:3">batabanje kubisezerana?<verse eid="AMO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4" />Mbega intambwe yokwivugira mw’ishamba</para>
  <para style="q2" vid="AMO 3:4">ata co yishe?</para>
  <para style="q1" vid="AMO 3:4">Mbega yokwivugira mu kibundo cayo</para>
  <para style="q2" vid="AMO 3:4">ata co yafashe?<verse eid="AMO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5" />Mbega inyoni yofatwa mu mutego ugaragara</para>
  <para style="q2" vid="AMO 3:5">ata co kurya kirimwo ngo kiyikwege?</para>
  <para style="q1" vid="AMO 3:5">Mbega umutego woshibuka</para>
  <para style="q2" vid="AMO 3:5">ata co wafashe?<verse eid="AMO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6" />Iyo inzamba ivuze mu gisagara,</para>
  <para style="q2" vid="AMO 3:6">mbega abantu ntibahinda agashitsi?</para>
  <para style="q1" vid="AMO 3:6">Mbega icago coza ku gisagara,</para>
  <para style="q2" vid="AMO 3:6">atari <char style="nd">Uhoraho</char> akirungitse?<verse eid="AMO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7" />Ni ukuri, <char style="nd">Uhoraho</char> Nyeninganji nta co akora</para>
  <para style="q2" vid="AMO 3:7">atabanje kugihishurira</para>
  <para style="q2" vid="AMO 3:7">abasavyi biwe b’abavugishwa.<verse eid="AMO 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8" />Intambwe yivuze</para>
  <para style="q2" vid="AMO 3:8">ni nde atotinya?</para>
  <para style="q1" vid="AMO 3:8">
    <char style="nd">Uhoraho</char> Nyeninganji avuze,</para>
  <para style="q2" vid="AMO 3:8">ni nde yokwanka kumenyesha ivyo avuze?<verse eid="AMO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9" />Nimumenyeshe abari mu bihome bikomeye vy’i Ashidodi</para>
  <para style="q2" vid="AMO 3:9">n’abo mu ngoro zikomeye zo muri Egiputa muti:</para>
  <para style="q1" vid="AMO 3:9">‘Nimukoranire ku misozi y’i Samariya;</para>
  <para style="q2" vid="AMO 3:9">mwirabire umuryano waho,</para>
  <para style="q2" vid="AMO 3:9">n’agacinyizo kari mu bantu baho.’<verse eid="AMO 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10" />Ntibazi gukora ivyiza,” ni ko <char style="nd">Uhoraho</char> avuze,</para>
  <para style="q2" vid="AMO 3:10">“bujuje mu mazu yabo akomeye</para>
  <para style="q2" vid="AMO 3:10">ivyo banyaze, n’ivyo bakuye mu bwicanyi.”<verse eid="AMO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11" />Nuko rero uku ni ko <char style="nd">Uhoraho</char> Nyeninganji avuze:</para>
  <para style="q1" vid="AMO 3:11">“Umwansi azokwifatira igihugu canyu,</para>
  <para style="q2" vid="AMO 3:11">asenyurire hasi iminara yawe</para>
  <para style="q2" vid="AMO 3:11">anyage ibiri mu ngoro zawe vyose.”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />Uku ni ko <char style="nd">Uhoraho</char> avuze:</para>
  <para style="q1" vid="AMO 3:12">“Nk’uko umwungere agerageza kurokora intama mu kanwa k’intambwe</para>
  <para style="q2" vid="AMO 3:12">akayaka amagufa y’amaguru gusa canke agace k’ugutwi,</para>
  <para style="q1" vid="AMO 3:12">ni ko Abisirayeli baba i Samariya bazorokoka,</para>
  <para style="q2" vid="AMO 3:12">bazokiza umutwe w’uburiri gusa</para>
  <para style="q2" vid="AMO 3:12">n’igice c’impuzu bisasiye.<verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />Nimwumve ibi kandi mubimenyeshe aba Yakobo,” ni ko <char style="nd">Uhoraho</char> Imana Mushoboravyose, avuze.<verse eid="AMO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14" />“Ku musi nzohanirako Abisirayeli kubera ivyaha vyabo,</para>
  <para style="q2" vid="AMO 3:14">nzosambura ibicaniro vy’i Beteli;</para>
  <para style="q1" vid="AMO 3:14">amahembe y’igicaniro azocibwa</para>
  <para style="q2" vid="AMO 3:14">akorokere hasi.<verse eid="AMO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15" />Nzosenyurira hasi inzu yo mu gihe c’imbeho nyinshi</para>
  <para style="q2" vid="AMO 3:15">hamwe n’inzu yo mu gihe c’ubushuhe;</para>
  <para style="q1" vid="AMO 3:15">amazu asharijwe n’amahembe y’inzovu azosamburwa</para>
  <para style="q2" vid="AMO 3:15">n’inyubakwa zagutse zizosamburirwa hasi,”</para>
  <para style="q2" vid="AMO 3:15">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s1">Abisirayeli ntibagarutse ku Mana</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1" />Nimwumve iri jambo, yemwe mwa nka z’i Bashani ku Musozi Samariya,</para>
  <para style="q2" vid="AMO 4:1">yemwe bagore muhahaza aboro mu gahonyora ku gakanu umukene,</para>
  <para style="q1" vid="AMO 4:1">maze mukabwira abagabo banyu muti:</para>
  <para style="q2" vid="AMO 4:1">“Nimutuzanire ivyo kunywa bindi!”<verse eid="AMO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2" />
    <char style="nd">Uhoraho</char> Nyeninganji arahiye ukwera kwiwe ati:</para>
  <para style="q2" vid="AMO 4:2">“Ni ukuri umusi uzoshika</para>
  <para style="q1" vid="AMO 4:2">aho muzojanwa mukwegeshwa igera,</para>
  <para style="q2" vid="AMO 4:2">gushika ku wa nyuma muzokwegeshwa amagera nk’ifi.<verse eid="AMO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3" />Umwe wese azosohokanwa</para>
  <para style="q2" vid="AMO 4:3">bamucishije mu gitoboro baciye mu gihome,</para>
  <para style="q1" vid="AMO 4:3">maze muzojugunywa mu gihugu c’i Harumoni,”</para>
  <para style="q2" vid="AMO 4:3">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="AMO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4" />“Nimuje i Beteli mukore ivyaha;</para>
  <para style="q2" vid="AMO 4:4">hanyuma muje i Gilugali murushirize.</para>
  <para style="q1" vid="AMO 4:4">Muzane ibimazi vyanyu uko bukeye,</para>
  <para style="q2" vid="AMO 4:4">n’ibigiracumi vyanyu uko imyaka itatu iheze.<verse eid="AMO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5" />Nimwotse imikate irimwo umwambiro ibe ishikanwa ryo gushima</para>
  <para style="q2" vid="AMO 4:5">muvuze inzamba mumenyesha ibimazi mutanze mwishakiye,</para>
  <para style="q1" vid="AMO 4:5">muvyirate, yemwe Bisirayeli,</para>
  <para style="q2" vid="AMO 4:5">kuko ari vyo mukunda gukora,”</para>
  <para style="q2" vid="AMO 4:5">ni ko <char style="nd">Uhoraho</char> Nyeninganji avuze.<verse eid="AMO 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6" />“Abo mu bisagara bimwe nabateje inzara</para>
  <para style="q2" vid="AMO 4:6">abo mu bindi bose ndabima indya,</para>
  <para style="q1" vid="AMO 4:6">ariko na ho nyene ntimwahindukiye ngo mungarukeko,”</para>
  <para style="q2" vid="AMO 4:6">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="AMO 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7" />“Nabimye n’imvura</para>
  <para style="q2" vid="AMO 4:7">hagisigaye amezi atatu ngo iyimbura rigere.</para>
  <para style="q1" vid="AMO 4:7">Narungitse imvura ku gisagara kimwe,</para>
  <para style="q2" vid="AMO 4:7">ariko ikindi ndakiyima.</para>
  <para style="q1" vid="AMO 4:7">Umurima umwe waronse imvura;</para>
  <para style="q2" vid="AMO 4:7">uwundi ntiwaronka na mba uragaduka.<verse eid="AMO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8" />Abantu bayerera bava mu gisagara baja mu kindi barondera amazi</para>
  <para style="q2" vid="AMO 4:8">ariko ntibaronka ayabamara inyota,</para>
  <para style="q1" vid="AMO 4:8">ariko naho nyene ntimwahindukiye ngo mungarukeko,”</para>
  <para style="q2" vid="AMO 4:8">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9" />“Ni kenshi nakubise imirima y’ingano zanyu n’imizabibu yanyu,</para>
  <para style="q2" vid="AMO 4:9">ndabiteza kubora no kwuma.</para>
  <para style="q1" vid="AMO 4:9">Inzige zarishije imisukoni yanyu n’imyelayo yanyu,</para>
  <para style="q2" vid="AMO 4:9">ariko na ho nyene ntimwahindukiye ngo mungarukeko,”</para>
  <para style="q2" vid="AMO 4:9">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10" />“Narungitse ibiza muri mwebwe</para>
  <para style="q2" vid="AMO 4:10">nk’uko nabigiriye Egiputa.</para>
  <para style="q1" vid="AMO 4:10">Nicishije inkota abahungu banyu,</para>
  <para style="q2" vid="AMO 4:10">n’amafarasi yanyu aranyagwa.</para>
  <para style="q1" vid="AMO 4:10">Nujuje mu mazuru yanyu umunuko uva mu bapfiriye mu nsago zanyu,</para>
  <para style="q2" vid="AMO 4:10">ariko naho nyene ntimwahindukiye ngo mungarukeko,”</para>
  <para style="q2" vid="AMO 4:10">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="AMO 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11" />“Natembagaje bamwe bo muri mwebwe</para>
  <para style="q2" vid="AMO 4:11">nk’uko natembagaje Sodomu na Gomora.</para>
  <para style="q1" vid="AMO 4:11">Abo muri mwebwe barokotse,</para>
  <para style="q2" vid="AMO 4:11">kwari kurya kw’urukwi rwokowe mu muriro,</para>
  <para style="q1" vid="AMO 4:11">ariko na ho nyene ntimwahindukiye ngo mungarukeko,”</para>
  <para style="q2" vid="AMO 4:11">ni ko Uhoraho avuze.<verse eid="AMO 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12" />“None rero uku ni ko ngiye kukugirira, yewe Isirayeli,</para>
  <para style="q2" vid="AMO 4:12">kandi kubera nzokugirira gutyo, ga Isirayeli,</para>
  <para style="q2" vid="AMO 4:12">niwitegure guhura n’Imana yawe.”<verse eid="AMO 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />Uwabumvye imisozi,</para>
  <para style="q2" vid="AMO 4:13">uwaremye umuyaga,</para>
  <para style="q2" vid="AMO 4:13">agahishurira ivyo yiyumvira abana b’abantu,</para>
  <para style="q1" vid="AMO 4:13">uwuhindura umutwenzi ukaba umwijima,</para>
  <para style="q2" vid="AMO 4:13">akagendera ku dutwe tw’isi,</para>
  <para style="q2" vid="AMO 4:13">
    <char style="nd">Uhoraho</char> Imana Mushoboravyose ni ryo zina ryiwe.<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s1">Gucura intimba no guhamagara abantu ngo bihane</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />Umviriza iri jambo, yewe Isirayeli, iyi ndirimbo yo gucura intimba yerekeye wewe:<verse eid="AMO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />“Umukobwa ari we Isirayeli aratemvye,</para>
  <para style="q2" vid="AMO 5:2">ntazosubira kuvyuka,</para>
  <para style="q1" vid="AMO 5:2">bamuhebeye mu gihugu ciwe,</para>
  <para style="q2" vid="AMO 5:2">kandi nta muntu n’umwe wo kumuvyura.”<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />Uku ni ko <char style="nd">Uhoraho</char> Nyeninganji abwiye Isirayeli:</para>
  <para style="q1" vid="AMO 5:3">“Igisagara cawe cahora kirungika ingabo z’abahizi igihumbi</para>
  <para style="q2" vid="AMO 5:3">kizosigarana ijana gusa;</para>
  <para style="q1" vid="AMO 5:3">igisagara cawe cahora kirungika ingabo z’abahizi ijana</para>
  <para style="q2" vid="AMO 5:3">kizosigarana icumi gusa.”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />Uku ni ko <char style="nd">Uhoraho</char> abwira Abisirayeli:</para>
  <para style="q1" vid="AMO 5:4">“Nimundondere kugira ngo mubone kubaho;<verse eid="AMO 5:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5" />ntimuronderere i Beteli,</para>
  <para style="q1" vid="AMO 5:5">ntimuje n’i Gilugali,</para>
  <para style="q2" vid="AMO 5:5">ntimufate urugendo muja i Berisheba.</para>
  <para style="q1" vid="AMO 5:5">Kuko i Gilugali bazojanwa ari inyagano mu mahanga,</para>
  <para style="q2" vid="AMO 5:5">kandi n’i Beteli hazohindurwa hasigare ari ubusa.”<verse eid="AMO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6" />Nimurondere <char style="nd">Uhoraho</char> kugira ngo mubeho,</para>
  <para style="q2" vid="AMO 5:6">atari uko, azotongora imiryango ya Yosefu nk’umuriro;</para>
  <para style="q1" vid="AMO 5:6">umuriro uzobarigata,</para>
  <para style="q2" vid="AMO 5:6">kandi i Beteli ntihazoboneka n’umwe wo kuwuzimya.<verse eid="AMO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7" />Hari abahindura ubutungane umururazi</para>
  <para style="q2" vid="AMO 5:7">bagaterera hasi ubugororotsi.<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />Uwaremye inyenyeri, Peleyiyade na Oriyoni,</para>
  <para style="q2" vid="AMO 5:8">agahindura umwijima ukaba umutwenzi</para>
  <para style="q2" vid="AMO 5:8">kandi agatuma umurango uhinduka ijoro,</para>
  <para style="q1" vid="AMO 5:8">uwuhamagara amazi yo mu kiyaga</para>
  <para style="q2" vid="AMO 5:8">akayasuka kw’isi,</para>
  <para style="q2" vid="AMO 5:8">
    <char style="nd">Uhoraho</char> ni ryo zina ryiwe.<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />Mu kubanguka nk’umuravyo arandura umunyenkomezi</para>
  <para style="q2" vid="AMO 5:9">igisagara gikomeye akagihindura umusaka.<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10" />Hari abanka uwushigikira ubutungane mu manza,</para>
  <para style="q2" vid="AMO 5:10">bakanka n’uwuvugisha ukuri.<verse eid="AMO 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11" />Mucinyiza abakene</para>
  <para style="q2" vid="AMO 5:11">mukabaka itagisi ku ngano.</para>
  <para style="q1" vid="AMO 5:11">Ni co gituma, naho mwubatse inzu z’amabuye,</para>
  <para style="q2" vid="AMO 5:11">mutazozibamwo;</para>
  <para style="q1" vid="AMO 5:11">naho mwarimye imizabibu myiza,</para>
  <para style="q2" vid="AMO 5:11">mutazonywa umuvinyu wazo.<verse eid="AMO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12" />Kuko nzi ko ivyaha vyanyu ari vyinshi</para>
  <para style="q2" vid="AMO 5:12">n’ibicumuro vyanyu bikaba ibihambaye.</para>
  <para style="b" vid="AMO 5:12" />
  <para style="q1" vid="AMO 5:12">Hari abacinyiza abatagira icaha hanyuma bakarya ibiturire,</para>
  <para style="q2" vid="AMO 5:12">bakarenganya abakene mu manza.<verse eid="AMO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13" />Ni co gituma umunyabwenge yinumira mu bihe nk’ibi,</para>
  <para style="q2" vid="AMO 5:13">kuko ari ibihe bibi.<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14" />Nimurondere ivyiza, aho kurondera ibibi,</para>
  <para style="q2" vid="AMO 5:14">kugira ngo mubeho.</para>
  <para style="q1" vid="AMO 5:14">Maze <char style="nd">Uhoraho</char> Imana Mushoboravyose azobana namwe,</para>
  <para style="q2" vid="AMO 5:14">nk’uko mubivuga ko abana namwe.<verse eid="AMO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15" />Nimwanke ibibi, mukunde ivyiza;</para>
  <para style="q2" vid="AMO 5:15">muce imanza zibereye mu bucamanza.</para>
  <para style="q1" vid="AMO 5:15">Kumbure <char style="nd">Uhoraho</char> Imana Mushoboravyose yogirira imbabazi</para>
  <para style="q2" vid="AMO 5:15">amasigarira y’aba Yosefu.<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />Nuko rero, uku ni ko Uhoraho, <char style="nd">Uhoraho</char> Imana Mushoboravyose avuze:</para>
  <para style="q1" vid="AMO 5:16">“Bazoborogera mu mabarabara yose,</para>
  <para style="q2" vid="AMO 5:16">bavuze induru kubera umubabaro mw’ihuriro ryose ry’abantu.</para>
  <para style="q1" vid="AMO 5:16">Abarimyi bazohamagarirwa kurira,</para>
  <para style="q2" vid="AMO 5:16">n’abagandaye ngo baboroge.<verse eid="AMO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17" />Hazoba amaborogo mu mizabibu yose,</para>
  <para style="q2" vid="AMO 5:17">kuko nzoca hagati muri mwebwe,”</para>
  <para style="q2" vid="AMO 5:17">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="AMO 5:17" /></para>
  <para style="s1">Umusi w’<char style="nd">Uhoraho</char></para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18" />Muragowe mwebwe mwipfuza</para>
  <para style="q2" vid="AMO 5:18">umusi w’<char style="nd">Uhoraho</char> ko woshika!</para>
  <para style="q1" vid="AMO 5:18">Mbega ni kuki mwipfuza umusi w’<char style="nd">Uhoraho</char>?</para>
  <para style="q2" vid="AMO 5:18">Uwo musi uzoba uw’umwijima, ntuzoba uw’umuco.<verse eid="AMO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19" />Bizoba nk’uko umuntu yoba ahunze intambwe,</para>
  <para style="q2" vid="AMO 5:19">maze agaca ahura n’idubu,</para>
  <para style="q1" vid="AMO 5:19">nk’aho yoba yinjiye mu nzu iwe,</para>
  <para style="q2" vid="AMO 5:19">akishimikiza igihome,</para>
  <para style="q2" vid="AMO 5:19">maze inzoka igaca imukomora.<verse eid="AMO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20" />Mbega umusi w’<char style="nd">Uhoraho</char> ntuzoba uw’umwijima, aho kuba uw’umuco;</para>
  <para style="q2" vid="AMO 5:20">umusi w’umwijima w’umuzitanya, utagiramwo umuco na mukeya?<verse eid="AMO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21" />“Ndanka urunuka, nkongera ngasesemwa n’imisi mikuru yanyu;</para>
  <para style="q2" vid="AMO 5:21">amakoraniro yanyu y’uburyarya sinzovyihanganira.<verse eid="AMO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22" />Naho mwotanga ibimazi vyo guturirwa n’umuriro n’amashikanwa y’ifu,</para>
  <para style="q2" vid="AMO 5:22">sinzovyakira.</para>
  <para style="q1" vid="AMO 5:22">Naho mwozana ibimazi vy’ishimwe vy’indobanurwa,</para>
  <para style="q2" vid="AMO 5:22">sinzobinezererwa.<verse eid="AMO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23" />Nimujane kure urwo rwamo rw’indirimbo zanyu!</para>
  <para style="q2" vid="AMO 5:23">Sinzokwumviriza inanga zanyu.<verse eid="AMO 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24" />Ariko nimureke imanza zibereye zitembe nk’uruzi,</para>
  <para style="q2" vid="AMO 5:24">ukugororoka kumere nk’umugezi udakama!<verse eid="AMO 5:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25" />Hari ibimazi n’amashikanwa mwanshikaniye</para>
  <para style="q2" vid="AMO 5:25">mu myaka mirongo ine mwamaze mu bugaragwa,</para>
  <para style="q2" vid="AMO 5:25">yemwe Bisirayeli?<verse eid="AMO 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26" />Mwareruye ibigirwamana mwibumbiye,</para>
  <para style="q2" vid="AMO 5:26">kimwe ca Sakuti, mwita umwami wanyu n’imana yanyu,</para>
  <para style="q2" vid="AMO 5:26">n’ica Kewani,</para>
  <para style="q2" vid="AMO 5:26">inyenyeri yanyu n’imana yanyu.<verse eid="AMO 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27" />Ni co gituma nzobirukana muhungire hirya ya Damasiko,”</para>
  <para style="q2" vid="AMO 5:27">ni ko <char style="nd">Uhoraho</char> avuze, izina ryiwe ni Imana Mushoboravyose.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s1">Baragowe abidibamiye</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1" />Muragowe mwebwe abidibamiye i Siyoni,</para>
  <para style="q2" vid="AMO 6:1">na mwebwe mwumva mutekaniwe ku musozi w’i Samariya,</para>
  <para style="q1" vid="AMO 6:1">mwebwe abaganwa b’ihanga riruta ayandi,</para>
  <para style="q2" vid="AMO 6:1">mwebwe abo Abisirayeli baja kwitura!<verse eid="AMO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2" />Nimugende mwirabire i Kalune;</para>
  <para style="q2" vid="AMO 6:2">muvuyeyo muje i Hamati-Raba igisagara gihambaye,</para>
  <para style="q2" vid="AMO 6:2">hanyuma mumanuke i Gati mu Bafilisitiya.</para>
  <para style="q1" vid="AMO 6:2">Mbega ivyo bisagara hari ico birusha ubwami bwanyu uko ari bubiri?</para>
  <para style="q2" vid="AMO 6:2">Mbega igihugu cabo kiraruta icanyu?<verse eid="AMO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3" />Mwanka kwemera ko umusi w’ivyago ushitse</para>
  <para style="q2" vid="AMO 6:3">ariko ibikorwa vyanyu bituma umusi w’urubanza ubegera kurusha.<verse eid="AMO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4" />Muryama ku buriri busharijwe n’amahembe y’inzovu</para>
  <para style="q2" vid="AMO 6:4">mukiseguza imisego myiza.</para>
  <para style="q1" vid="AMO 6:4">Mukirira inyama zoroshe z’imyagazi y’intama</para>
  <para style="q2" vid="AMO 6:4">n’inka zinuze.<verse eid="AMO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5" />Mwigenera indirimbo nka Dawidi</para>
  <para style="q2" vid="AMO 6:5">mukazicuraranga ku nanga zanyu.<verse eid="AMO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6" />Munywera umuvinyu mu bikombe bisesekaye</para>
  <para style="q2" vid="AMO 6:6">mukisiga ibimota neza, bihinguwe rwose,</para>
  <para style="q2" vid="AMO 6:6">ariko ntimubabazwa n’umusaka wa Yosefu.<verse eid="AMO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7" />Ni co gituma muzoba mu ba mbere mu bazojanwa ari inyagano;</para>
  <para style="q2" vid="AMO 6:7">imisi mikuru yanyu n’ukwinezereza kwanyu bizoshira.<verse eid="AMO 6:7" /></para>
  <para style="s1">Uko <char style="nd">Uhoraho</char> yanka ubwibone bwa Isirayeli</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />
    <char style="nd">Uhoraho</char> Nyeninganji ararahiye, <char style="nd">Uhoraho</char> Imana Mushoboravyose avuze ati:</para>
  <para style="q1" vid="AMO 6:8">“Ndanka ubwibone bwa Yakobo</para>
  <para style="q2" vid="AMO 6:8">kandi nanka n’ingoro ziwe zikomeye;</para>
  <para style="q1" vid="AMO 6:8">nzotanga iki gisagara</para>
  <para style="q2" vid="AMO 6:8">n’ibiri muri co vyose.”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />Abantu cumi nibasigara mu nzu imwe, na bo nyene bazopfa. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />Kandi incuti yabo izoza gusohora imivyimba ngo ituririrwe hanze izobaza uwuzoba yinyegeje ngaho iti: “Mbega hari uwundi muri kumwe?” Maze na we azomwishura agomba kurahira izina ry’Imana ati: “Oya na mba!” Azoca amwamira amubwire ati: “Reka, si umwanya wo gucisha mu kanwa izina ry’<char style="nd">Uhoraho</char>.”<verse eid="AMO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11" />Kuko <char style="nd">Uhoraho</char> yabitegetse,</para>
  <para style="q2" vid="AMO 6:11">kandi azosangangura inzu nini ayigire ubunywenywe,</para>
  <para style="q2" vid="AMO 6:11">n’inzu ntoya ayigire nk’utuvunguka.<verse eid="AMO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12" />Mbega ifarasi iriruka ku rutare?</para>
  <para style="q2" vid="AMO 6:12">Hari uwurimisha inka ku kiyaga?</para>
  <para style="q1" vid="AMO 6:12">Ariko mwahinduye ubutungane ubumara</para>
  <para style="q2" vid="AMO 6:12">n’icamwa co kugororoka mwagihinduye umururazi,<verse eid="AMO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13" />yemwe abanezerezwa n’uko i Lo Debari hafashwe</para>
  <para style="q2" vid="AMO 6:13">mukavuga muti: “Mbega ntitwafatishije i Karunayimu inkomezi zacu?”<verse eid="AMO 6:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14" />Kuko <char style="nd">Uhoraho</char> Imana Mushoboravyose avuze ati:</para>
  <para style="q2" vid="AMO 6:14">“Nzohagurutsa ihanga rizoza kugutera, yewe Isirayeli,</para>
  <para style="q1" vid="AMO 6:14">kandi rizokubabaza urugendo rwose</para>
  <para style="q2" vid="AMO 6:14">kuva i Lebo-Hamati gushika mu kiyaya c’i Araba.”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s1">Inzige, umuriro n’umugozi karisho</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />Ibi ni vyo <char style="nd">Uhoraho</char> Nyeninganji yanyeretse: yariko arategura kurungika igitero c’inzige mu gihugu. Ivyo vyabaye, inyuma y’uko umwami amaze kuronka umugabane wiwe w’umwimbu, imirima yo hanyuma iriko iratangura kwera. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />Izo nzige zimaze kurya igiterwa cose gitotahaye, ndasemerera nti: “<char style="nd">Uhoraho</char> Nyeninganji, girira imbabazi abantu bawe! Mbega Yakobo yokira gute? Erega ni inkehwa!”<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />Maze <char style="nd">Uhoraho</char> arigarura.</para>
  <para style="p" vid="AMO 7:3">
    <char style="nd">Uhoraho</char> aravuga ati: “Ivyo, ntibizoshika.”<verse eid="AMO 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />Ibi ni vyo <char style="nd">Uhoraho</char> Nyeninganji yanyeretse: <char style="nd">Uhoraho</char> Nyeninganji yagomba gukoresha umuriro kugira ngo ahane abantu biwe. Umuriro wakamije amazi y’i kuzimu, uturira n’igihugu cose. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />Maze ndasemerera nti: “Yewe <char style="nd">Uhoraho</char> Nyeninganji, ndakwinginze, geza aho! Mbega Yakobo yokira gute? Erega ni inkehwa!”<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />Maze <char style="nd">Uhoraho</char> arigarura.</para>
  <para style="p" vid="AMO 7:6">
    <char style="nd">Uhoraho</char> Nyeninganji aravuga ati: “N’ibi na vyo ntibizoshika.”<verse eid="AMO 7:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />Ibi ni vyo yanyeretse: Imana yari ihagaze i ruhande y’uruhome rwubatswe hakoreshejwe igipimo karisho, cerekena ukugororoka kw’uruhome, kandi na yo yari ifise uwo mugozi n’ico gipimo mu kuboko kwayo. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />Maze Imana irambaza iti: “Ubona iki ga Amosi?”</para>
  <para style="p" vid="AMO 7:8">Ndishura nti: “Mbona umugozi uriko karisho.”</para>
  <para style="p" vid="AMO 7:8">Maze Uhoraho aravuga ati: Raba, ndiko ndapimisha karisho abantu banje b’Abisirayeli; sinzosubira kubaziguriza na mba.<verse eid="AMO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9" />“Ibibanza vyo gusengeramwo vyo ku misozi vya Isaka bizosamburwa</para>
  <para style="q2" vid="AMO 7:9">kandi n’ibigabiro vya Isirayeli bizohinduka umusaka;</para>
  <para style="q2" vid="AMO 7:9">nzoramvura inkota yanje ngwanye abo mu nda y’ingoma ya Yerobowamu.”<verse eid="AMO 7:9" /></para>
  <para style="s1">Amosi na Amaziya</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />Maze Amaziya umuherezi w’i Beteli arungikira ubutumwa Yerobowamu umwami w’Abisirayeli ati: “Amosi ariko ategura abantu bo kukugwanya, kandi bari aha hagati mu Bisirayeli. Igihugu ntigishobora kubandanya cihanganira amajambo yiwe. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />Kuko uku ari ko Amosi avuga, ngo:</para>
  <para style="q1" vid="AMO 7:11">‘Yerobowamu azokwicwa n’inkota,</para>
  <para style="q2" vid="AMO 7:11">kandi Abisirayeli nta kabuza bazojanwa ari inyagano,</para>
  <para style="q2" vid="AMO 7:11">kure y’igihugu cabo c’amavukiro.’ ”<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />Nuko Amaziya abwira Amosi ati: “Sohoka, yewe kamenyi! Subira mu gihugu c’i Buyuda. Wironkereyo ibigutunga kandi uvugishirizweyo. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />Ntusubire kuvugishirizwa i Beteli, kuko aha ni urusengero rw’umwami n’ingoro y’ubwami.”<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />Amosi yishura Amaziya ati: “Sinigeze mba umuvugishwa canke ngo mbe n’umwana w’umuvugishwa, ahubwo nari umwungere kandi narima imisukomora. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />Ariko <char style="nd">Uhoraho</char> yankuye inyuma y’imikuku arambwira ati: ‘Genda, uvugishwe ku bantu banje b’Abisirayeli.’ <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />Nuko rero, niwumve ijambo ry’<char style="nd">Uhoraho</char>. Uvuze uti:</para>
  <para style="q1" vid="AMO 7:16">‘Ntuvugishwe ku Bisirayeli,</para>
  <para style="q2" vid="AMO 7:16">kandi uhagarike kuburira bene Isaka.’<verse eid="AMO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17" />Ku bw’ivyo, uku ni ko <char style="nd">Uhoraho</char> avuze:</para>
  <para style="q1" vid="AMO 7:17">‘Umugore wawe azoba maraya mu gisagara,</para>
  <para style="q2" vid="AMO 7:17">kandi abahungu bawe n’abakobwa bawe bazokwicwa n’inkota.</para>
  <para style="q1" vid="AMO 7:17">Igihugu cawe kizogabuzwa umugozi kigaburwemwo ibice,</para>
  <para style="q2" vid="AMO 7:17">kandi wewe ubwawe uzopfira mu gihugu c’abanyamahanga.</para>
  <para style="q1" vid="AMO 7:17">Kandi Abisirayeli nta kabuza bazojanwa ari inyagano,</para>
  <para style="q2" vid="AMO 7:17">kure y’igihugu cabo c’amavukiro.’ ”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s1">Amosi yerekwa igiseke c’ivyamwa vyeze</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />Ibi ni vyo <char style="nd">Uhoraho</char> Nyeninganji yanyeretse: nabonye igiseke c’ivyamwa vyeze. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />Arambaza ati: “Ubona iki, ga Amosi?”</para>
  <para style="p" vid="AMO 8:2">Ndishura nti: “Igiseke c’ivyamwa vyeze.”</para>
  <para style="p" vid="AMO 8:2">Maze <char style="nd">Uhoraho</char> ambwira ati: “Igihe kirageze, c’uko abantu banje b’Abisirayeli basoromwa, sinzosubira kubaziguriza.<verse eid="AMO 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3" />Kuri uwo musi,” ni ko <char style="nd">Uhoraho</char> Nyeninganji avuze, “indirimbo zo mu rusengero zizohinduka amaborogo. Imivyimba myinshi, myinshi cane, izotabwa ahantu hose! Nimucereze!”<verse eid="AMO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4" />Nimwumve ibi, mwebwe munyaga aboro</para>
  <para style="q2" vid="AMO 8:4">mugasiribanga abakene,<verse eid="AMO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5" />mukavuga muti:</para>
  <para style="q1" vid="AMO 8:5">“Mbega imboneko z’ukwezi zizogera ryari</para>
  <para style="q2" vid="AMO 8:5">kugira ngo dusubire kwidandariza ingano;</para>
  <para style="q1" vid="AMO 8:5">Isabato izohera ryari</para>
  <para style="q2" vid="AMO 8:5">ngo dusubire kwigurishiriza ingano?”</para>
  <para style="q1" vid="AMO 8:5">Aho rero mukoresha ingero z’ibinyoma,</para>
  <para style="q2" vid="AMO 8:5">mukaduza ibiciro uko mwishakiye</para>
  <para style="q2" vid="AMO 8:5">kandi mukiba mukoresheje iminzane y’ibinyoma.<verse eid="AMO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6" />Mugura umukene ifeza,</para>
  <para style="q2" vid="AMO 8:6">n’umworo mukamugura umwambaro umwe w’ibirato,</para>
  <para style="q2" vid="AMO 8:6">mukagurisha n’ingano mwavanze n’ibikumbi.<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />
    <char style="nd">Uhoraho</char> ararahiye, uwo Yakobo yishimira ati: “Sinzokwigera nibagira na kimwe mu vyo bakoze.<verse eid="AMO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8" />Mbega igihugu ntikizohinda agashitsi kubera ivyo,</para>
  <para style="q2" vid="AMO 8:8">ababa muri co na bo ntibazogandara?</para>
  <para style="q1" vid="AMO 8:8">Igihugu cose kizohaguruka nk’uruzi Nili;</para>
  <para style="q2" vid="AMO 8:8">kizoduga hejuru maze gihwame</para>
  <para style="q2" vid="AMO 8:8">nka rwa ruzi rwa Egiputa.<verse eid="AMO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9" />Kuri uwo musi,” ni ko <char style="nd">Uhoraho</char> Nyeninganji avuze,</para>
  <para style="q1" vid="AMO 8:9">“Nzotuma izuba rirenga ku murango,</para>
  <para style="q2" vid="AMO 8:9">bwire kw’isi mu gihe c’amashoka.<verse eid="AMO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10" />Nzohindura imisi mikuru yanyu ibe ibihe vyo kugandara</para>
  <para style="q2" vid="AMO 8:10">n’imvyino zanyu zose ndazihindure amarira.</para>
  <para style="q1" vid="AMO 8:10">Nzotuma mwese mwambara amagunira</para>
  <para style="q2" vid="AMO 8:10">mwimoshe inkomvorera.</para>
  <para style="q1" vid="AMO 8:10">Ico gihe nzokigira ico kuboroga nk’uwuborogera umwana wiwe w’ikinege</para>
  <para style="q2" vid="AMO 8:10">kandi umusi wo kuganduka uzoba uw’umururazi.<verse eid="AMO 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11" />Imisi iraje,” ni ko <char style="nd">Uhoraho</char> Nyeninganji avuze,</para>
  <para style="q2" vid="AMO 8:11">“aho nzorungika inzara mu gihugu;</para>
  <para style="q1" vid="AMO 8:11">ntizoba ari inzara y’ivyokurya canke inyota y’amazi,</para>
  <para style="q2" vid="AMO 8:11">ariko izoba ari inzara yo kwumva amajambo y’<char style="nd">Uhoraho</char>.<verse eid="AMO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12" />Abantu bazokubita ku kiyaga baje ku kindi,</para>
  <para style="q2" vid="AMO 8:12">bave mu buraruko baje mu buseruko,</para>
  <para style="q1" vid="AMO 8:12">barondera ijambo ry’<char style="nd">Uhoraho</char>,</para>
  <para style="q2" vid="AMO 8:12">ariko ntibazoribona.<verse eid="AMO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13" />Kuri uwo musi,</para>
  <para style="q1" vid="AMO 8:13">inkumi nzizanziza n’abasore bezabeza</para>
  <para style="q2" vid="AMO 8:13">bazorabikwa n’inyota.<verse eid="AMO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14" />Abirahira ibigirwamana biteye isoni vy’i Samariya,</para>
  <para style="q2" vid="AMO 8:14">abavuga bati: ‘Ni ukuri nk’ukubaho kw’imana yawe, Dani,’</para>
  <para style="q2" vid="AMO 8:14">canke ngo: ‘Ni ukuri nk’ukubaho kw’imana y’i Berisheba,’</para>
  <para style="q2" vid="AMO 8:14">abo bose bazotemba, kandi ntibazokwongera kuvyuka.”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s1">Isirayeli hazosamburwa</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />Nabonye Imana ihagaze i ruhande y’igicaniro, hanyuma ivuga ati:</para>
  <para style="q1" vid="AMO 9:1">“Kubita ubushorishori bw’inkingi z’urusengero,</para>
  <para style="q2" vid="AMO 9:1">kugeza amatanguriro yazo anyiganyize.</para>
  <para style="q1" vid="AMO 9:1">Zisenyurire hasi maze zigwe ku mitwe y’ubu bwoko;</para>
  <para style="q2" vid="AMO 9:1">abazoba basigaye nzobicisha inkota.</para>
  <para style="q1" vid="AMO 9:1">Nta n’umwe azohunga,</para>
  <para style="q2" vid="AMO 9:1">nta n’umwe azosigara.<verse eid="AMO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2" />Naho bokwimba gushika i kuzimu,</para>
  <para style="q2" vid="AMO 9:2">ukuboko kwanje kuzobakurayo.</para>
  <para style="q1" vid="AMO 9:2">Naho boduga bakaja mw’ijuru hejuru,</para>
  <para style="q2" vid="AMO 9:2">nzobamanurayo.<verse eid="AMO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3" />Naho bokwihisha ku gatwe ka Karumeli,</para>
  <para style="q2" vid="AMO 9:3">nzobahiga ndabafate ndabamanureyo.</para>
  <para style="q1" vid="AMO 9:3">Naho bokwinyegeza inyonga zanje i bwina mu kiyaga,</para>
  <para style="q2" vid="AMO 9:3">nzotuma inzoka ibakomorereyo.<verse eid="AMO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4" />Naho bojanwa nk’inyagano n’abansi babo,</para>
  <para style="q2" vid="AMO 9:4">nzotegeka inkota ibasogotereyo.</para>
  <para style="b" vid="AMO 9:4" />
  <para style="q1" vid="AMO 9:4">Igitsure canje kizoguma kuri bo</para>
  <para style="q2" vid="AMO 9:4">kugira ngo ndabagirire nabi, si ukubagirira neza.”<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />Umwami, <char style="nd">Uhoraho</char> Mushoboravyose,</para>
  <para style="q1" vid="AMO 9:5">akoze kw’isi ica irashonga,</para>
  <para style="q2" vid="AMO 9:5">kandi ababa muri yo bose baragandaye;</para>
  <para style="q1" vid="AMO 9:5">igihugu cose gihagurutse nk’uruzi Nili,</para>
  <para style="q2" vid="AMO 9:5">hanyuma kirahwama nk’urwo ruzi rwa Egiputa.<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />
    <char style="nd">Uhoraho</char> yubatse ikirimba ciwe iyo mw’ijuru hejuru</para>
  <para style="q2" vid="AMO 9:6">ashira amatanguriro yaco kw’isi;</para>
  <para style="q1" vid="AMO 9:6">ahamagara amazi yo mu kiyaga</para>
  <para style="q2" vid="AMO 9:6">akayasuka kw’isi,</para>
  <para style="q2" vid="AMO 9:6">
    <char style="nd">Uhoraho</char> ni ryo zina ryiwe.<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7" />“Mbega mwebwe Abisirayeli</para>
  <para style="q2" vid="AMO 9:7">ntimumeze nk’Abanyakushi kuri jewe?”</para>
  <para style="q2" vid="AMO 9:7">ni ko <char style="nd">Uhoraho</char> abaza.</para>
  <para style="q1" vid="AMO 9:7">Mbega sinaduganye Abisirayeli ndabakuye muri Egiputa,</para>
  <para style="q2" vid="AMO 9:7">Abafilisitiya nkabakura i Kafutori</para>
  <para style="q2" vid="AMO 9:7">Abasiriya na bo nkabakura muri Kiru?<verse eid="AMO 9:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8" />“Ni ukuri inyonga z’<char style="nd">Uhoraho</char> Nyeninganji</para>
  <para style="q2" vid="AMO 9:8">ziri ku bwami bucumura.</para>
  <para style="q1" vid="AMO 9:8">Nzobusambura</para>
  <para style="q2" vid="AMO 9:8">ndabuherengeteze kw’isi.</para>
  <para style="q1" vid="AMO 9:8">Ariko sinzoherengeteza rwose</para>
  <para style="q2" vid="AMO 9:8">abakomoka kuri Yakobo,”</para>
  <para style="q2" vid="AMO 9:8">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="AMO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9" />“Kuko nzotanga itegeko,</para>
  <para style="q2" vid="AMO 9:9">maze ntume Abisirayeli bahinda agashitsi</para>
  <para style="q2" vid="AMO 9:9">hagati y’ayandi mahanga</para>
  <para style="q1" vid="AMO 9:9">nk’uko ingano zigosorerwa ku rutaro,</para>
  <para style="q2" vid="AMO 9:9">kandi ntihagire n’agatete kamwe gakorokera hasi.<verse eid="AMO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10" />Abanyavyaha bo mu bantu banje bazokwicwa n’inkota,</para>
  <para style="q2" vid="AMO 9:10">abo bose bavuga bati:</para>
  <para style="q1" vid="AMO 9:10">‘Ivyago ntibizodushikira canke</para>
  <para style="q2" vid="AMO 9:10">ngo duhure na vyo.’<verse eid="AMO 9:10" /></para>
  <para style="s1">Isirayeli hasanurwa</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />Kuri uwo musi,</para>
  <para style="q1" vid="AMO 9:11">nzovyura ihema rya Dawidi ryaguye hasi,</para>
  <para style="q2" vid="AMO 9:11">nzosanura impome zaryo zabomotse,</para>
  <para style="q2" vid="AMO 9:11">nsanure n’imisaka yaho;</para>
  <para style="q2" vid="AMO 9:11">kandi nzosubira kuryubaka rimere nk’uko ryahora,<verse eid="AMO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12" />kugira ngo begukire amasigarira ya Edomu</para>
  <para style="q2" vid="AMO 9:12">n’amahanga yose yitirirwa izina ryanje,”</para>
  <para style="q2" vid="AMO 9:12">ni ko <char style="nd">Uhoraho</char> avuze, ari we nyene azobishitsa.<verse eid="AMO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13" />“Imisi iraje,” ni ko <char style="nd">Uhoraho</char> avuze,</para>
  <para style="q1" vid="AMO 9:13">“aho umwimbuzi azokurikirana n’umubivyi,</para>
  <para style="q2" vid="AMO 9:13">n’uwutera imbuto agakurikirana n’uwudandaza imizabibu.</para>
  <para style="q1" vid="AMO 9:13">Umutobe musha w’umuvinyu uzotemba ku misozi,</para>
  <para style="q2" vid="AMO 9:13">kandi n’uturambi twose tuzorengerwa n’umuvinyu,<verse eid="AMO 9:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="AMO 9:14" />kandi nzogarukana abantu banje b’Abisirayeli ndabavanye mu kinyago.</para>
  <para style="b" vid="AMO 9:14" />
  <para style="q1" vid="AMO 9:14">Bazosubira bubake ibisagara vyahindutse imisaka babibemwo.</para>
  <para style="q2" vid="AMO 9:14">Bazotera imizabibu banywe umuvinyu wayo;</para>
  <para style="q2" vid="AMO 9:14">bazotera ibiti barye ivyamwa vyavyo.<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />Nzotera Abisirayeli mu gihugu cabo,</para>
  <para style="q2" vid="AMO 9:15">kandi sinzosubira kubarandura,</para>
  <para style="q2" vid="AMO 9:15">ngo ndabakure mu gihugu nabahaye,”</para>
  <para style="m" vid="AMO 9:15">ni ko <char style="nd">Uhoraho</char> Imana yanyu avuze.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>