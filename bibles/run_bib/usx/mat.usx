  <para style="h">Matayo</para>
  <para style="toc1">Ubutumwa Bwiza uko bwanditswe na Matayo</para>
  <para style="toc2">Matayo</para>
  <para style="toc3">Mat</para>
  <para style="mt2">Ubutumwa Bwiza uko bwanditswe na</para>
  <para style="mt1">Matayo</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">Ba sekuruza ba Yesu</para>
  <para style="lh">
    <verse number="1" style="v" sid="MAT 1:1" />Uru ni urukurikirane rwa ba sekuruza ba Yesu ari we Kristo, yakomotse kuri Dawidi wo mu ruvyaro rwa Aburahamu:<verse eid="MAT 1:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2" />Aburahamu yavyaye Isaka,</para>
  <para style="li1" vid="MAT 1:2">Isaka yavyaye Yakobo,</para>
  <para style="li1" vid="MAT 1:2">Yakobo yavyaye Yuda n’abandi bavukana,<verse eid="MAT 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 1:3" />Yuda yavyaye Peresi na Zera kuri Tamari,</para>
  <para style="li1" vid="MAT 1:3">Peresi yavyaye Hezironi,</para>
  <para style="li1" vid="MAT 1:3">Hezironi yavyaye Ramu,<verse eid="MAT 1:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 1:4" />Ramu yavyaye Aminadabu,</para>
  <para style="li1" vid="MAT 1:4">Aminadabu yavyaye Nahashoni,</para>
  <para style="li1" vid="MAT 1:4">Nahashoni yavyaye Salimoni,<verse eid="MAT 1:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="MAT 1:5" />Salimoni yavyaye Bowazi kuri Rahabu,</para>
  <para style="li1" vid="MAT 1:5">Bowazi yavyaye Obedi kuri Rusi,</para>
  <para style="li1" vid="MAT 1:5">Obedi yavyaye Isayi,<verse eid="MAT 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="MAT 1:6" />hanyuma Isayi avyara umwami Dawidi.</para>
  <para style="b" vid="MAT 1:6" />
  <para style="li1" vid="MAT 1:6">Dawidi na we yavyaye Salomo, amuvyara kuri Batisheba yahora ari muka Uriya,<verse eid="MAT 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="MAT 1:7" />Salomo yavyaye Rehobowamu,</para>
  <para style="li1" vid="MAT 1:7">Rehobowamu yavyaye Abiya,</para>
  <para style="li1" vid="MAT 1:7">Abiya yavyaye Asa,<verse eid="MAT 1:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="MAT 1:8" />Asa yavyaye Yehoshafati,</para>
  <para style="li1" vid="MAT 1:8">Yehoshafati yavyaye Yehoramu,</para>
  <para style="li1" vid="MAT 1:8">Yehoramu yavyaye Uziya,<verse eid="MAT 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="MAT 1:9" />Uziya yavyaye Yotamu,</para>
  <para style="li1" vid="MAT 1:9">Yotamu yavyaye Ahazi,</para>
  <para style="li1" vid="MAT 1:9">Ahazi yavyaye Hezekiya,<verse eid="MAT 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="MAT 1:10" />Hezekiya yavyaye Manase</para>
  <para style="li1" vid="MAT 1:10">Manase yavyaye Amoni,</para>
  <para style="li1" vid="MAT 1:10">Amoni yavyaye Yosiya,<verse eid="MAT 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="MAT 1:11" />hanyuma Yosiya avyara Yekoniya n’abo bavukana igihe bajanwa kuba abanyagano i Babiloni.<verse eid="MAT 1:11" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="12" style="v" sid="MAT 1:12" />Bamaze kuva mu buja i Babiloni,</para>
  <para style="li1" vid="MAT 1:12">Yekoniya yavyaye Shalutiyeli,</para>
  <para style="li1" vid="MAT 1:12">Shalutiyeli yavyaye Zerubabeli,<verse eid="MAT 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="MAT 1:13" />Zerubabeli yavyaye Abiyudi,</para>
  <para style="li1" vid="MAT 1:13">Abiyudi yavyaye Eliyakimu,</para>
  <para style="li1" vid="MAT 1:13">Eliyakimu yavyaye Azori,<verse eid="MAT 1:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="MAT 1:14" />Azori yavyaye Sadoki,</para>
  <para style="li1" vid="MAT 1:14">Sadoki yavyaye Akimu,</para>
  <para style="li1" vid="MAT 1:14">Akimu yavyaye Elihudi,<verse eid="MAT 1:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15" />Elihudi yavyaye Eliyazeri,</para>
  <para style="li1" vid="MAT 1:15">Eliyazeri yavyaye Matani,</para>
  <para style="li1" vid="MAT 1:15">Matani yavyaye Yakobo,<verse eid="MAT 1:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="MAT 1:16" />hanyuma Yakobo avyara Yosefu, umugabo wa Mariya, nyina wa Yesu ari we Kristo.<verse eid="MAT 1:16" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="17" style="v" sid="MAT 1:17" />Ni ukuvuga ko habayeho urukurikirane rw’imiryango cumi n’ine kuva kuri Aburahamu gushika kuri Dawidi; n’iyindi cumi n’ine kuva kuri Dawidi gushika igihe bajanwa kuba abanyagano i Babiloni; hongera haba urundi rukurikirane rw’imiryango cumi n’ine kuva bagarutse bavuye mu buja gushika kuri Kristo.<verse eid="MAT 1:17" /></para>
  <para style="s1">Umumarayika avugana na Yosefu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Uku ni ko ukuvuka kwa Yesu ari we Kristo kwagenze: nyina wiwe Mariya yari akowe na Yosefu, ariko imbere y’uko babana, asama inda ivuye ku bushobozi bwa Mpwemu Yera. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Kubera ko Yosefu yari umuntu atunganye, yiyumvira ingene yomuheba mu mpisho, kuko atagomba kumutetereza mu bantu.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Ariko, akivyiyumvira, umumarayika w’Umwami Imana araza avugana na we mu ndoto amubwira ati: “Yosefu mwana wa Dawidi, ntutinye kurongora Mariya, kuko inda afise yavuye kuri Mpwemu Yera. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Azovyara umwana w’umuhungu, nawe uze umwite Yesu, kuko ari we azokiza abantu biwe ivyaha vyabo.”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Ivyo vyose vyabaye kugira ngo ivyo Umwami Imana yari yaravugishije abavugishwa na we bishike, ngo: <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“Ehe, inkumi itarigera iryamana n’umugabo izosama inda ivyare umwana w’umuhungu kandi bazomwita Emanuweli”<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 7:14">Yesaya 7:14</ref></char></char></note> (bisobanurwa ngo “Imana iri kumwe natwe”).<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Yosefu amaze kwikangura, aca akora ivyo umumarayika w’Umwami Imana yamubwiye, atwara Mariya iwe nk’umugore wiwe. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Ariko ntibigeze baryamana nk’umugore n’umugabo kugeza amaze kuvyara uwo mwana w’umuhungu; hanyuma amwita Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">Abanyabwenge mu vy’inyenyeri</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Yesu amaze kuvukira i Betelehemu mu ntara yitwa Yudaya, ku ngoma y’umwami Herode, abanyabwenge mu vy’inyenyeri bavuye mu buseruko baja i Yerusalemu. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />Barabaza bati: “Umwami w’Abayuda yavutse ari hehe? Twabonye inyenyeri yiwe mu buseruko none tuzanywe no kumusenga.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Umwami Herode yumvise iyo nkuru abura amahoro, eka n’ab’i Yerusalemu bose. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Aca akoranya abaherezi bakurubakuru n’abigisha b’ivyagezwe, ababaza ati: “Vyanditswe ko Kristo azovukira hehe?” <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Baramwishura bati: “Ni i Betelehemu mu ntara ya Yudaya, kuko ari ko vyanditswe n’uwavugishwa n’Imana ngo:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘Kandi wewe, Betelehemu mu ntara ya Yudaya,</para>
  <para style="q2" vid="MAT 2:6">nturi mutoya mu bisagara vya Yudaya,</para>
  <para style="q1" vid="MAT 2:6">kuko muri wewe hazokomoka umurongozi</para>
  <para style="q2" vid="MAT 2:6">azoragira ubwoko bwanje bwa Isirayeli.’<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="MIC 5:2">Mika 5:2</ref></char></char></note>”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Hanyuma Herode ahamagaza mu mpisho ba banyabwenge agerageza kubabaza neza igihe iyo nyenyeri yabonekeye. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Nuko abarungika i Betelehemu, ababwira ati: “Genda mubaze neza ivyerekeye uwo mwana. Mumaze kumubona, muce mugaruka mumbwire kugira ngo nanje nje kumushengerera.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Bamaze kwumva ivyo umwami ababariye, baca babandanya urugendo. Ya nyenyeri babona mu buseruko ica ibaja imbere kugeza ihagaze hejuru y’aho uwo mwana yari ari. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Babonye ya nyenyeri ihagaze bagira umunezero mwinshi. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Binjiye mu nzu, babona uwo mwana ari kumwe na nyina Mariya, barapfukama baramusenga. Hanyuma batekurura udusaho turimwo ivy’agaciro bagendanye babimuhako ishikanwa rigizwe n’inzahabu, n’utundi tuntu tumota neza. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Hanyuma, Imana imaze kubamenyesha mu nzozi ngo ntibasubire kwa Herode, baca bisubirira iwabo bajanye iyindi nzira.<verse eid="MAT 2:12" /></para>
  <para style="s1">Yesu ahungira muri Egiputa</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Bamaze kugenda, umumarayika w’Umwami Imana araza avugana na Yosefu mu nzozi, amubwira ati: “Fata umwana na nyina ubahungishirize muri Egiputa; uzogumeyo kugeza aho nzokubwirira kugaruka, kuko Herode ariko arondera umwana ngo amwice.”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Yosefu avyuka hakiri mw’ijoro, afata umwana na nyina, abahungishiriza muri Egiputa, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />agumayo kugeza Herode apfuye. Uko ni ko Umwami Imana yashikije ivyo yari yaravuze aciye ku wavugishwa na we ngo: “Nahamagaye umwana wanje ngo ave muri Egiputa.”<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 11:1">Hoseya 11:1</ref></char></char></note><verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Herode abonye ko ba banyabwenge mu vy’inyenyeri bamuhenze, arashavura cane, aca arungika abasoda kwica abana bose b’i Betelehemu no mu micungararo yaho bafise imyaka ibiri n’abatarayikwiza, akurikije igihe yabonaniye na ba banyabwenge. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Uko ni ko ivyo uwavugishwa n’Imana Yeremiya yavuze vyashitse ati:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“I Rama humvikanye induru,</para>
  <para style="q2" vid="MAT 2:18">amarira n’amaborogo menshi:</para>
  <para style="q1" vid="MAT 2:18">Rasheli aririra abana biwe</para>
  <para style="q2" vid="MAT 2:18">kandi yanse guhozwa</para>
  <para style="q2" vid="MAT 2:18">kuko batakiriho.”<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:15">Yeremiya 31:15</ref></char></char></note><verse eid="MAT 2:18" /></para>
  <para style="s1">Yesu asubira i Nazareti</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Herode amaze gupfa, umumarayika w’Umwami Imana abonekera Yosefu mu ndoto ari muri Egiputa, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />amubwira ati: “Haguruka ujane umwana na nyina usubire mu gihugu ca Isirayeli, kuko abahora barondera kwica uwo mwana bamaze gupfa.”<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Nuko Yosefu arahaguruka, afata umwana na nyina basubira mu gihugu ca Isirayeli. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Ariko amaze kwumva ko Arukelayo ari we atwara intara y’i Yudaya mu gishingo ca se Herode, aca aratinya kujayo, mu nyuma amaze kumenyeshwa n’Imana mu ndoto, aja mu ntara y’i Galilaya, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />baca baja kuba mu gisagara citwa Nazareti. Uko ni ko ivyo abavugishwa n’Imana bavuze vyashitse ngo: “Azokwitwa Umunyanazareti.”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">Yohana Umubatizi ategurira Yesu inzira</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Muri iyo misi haza Yohana Umubatizi, yigishiriza mu bugaragwa bw’i Yudaya, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />avuga ati: “Nimwihane kuko Ubwami bw’ijuru buri hafi.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Uwo Yohana ni we yari yaravuzwe n’uwavugishwa n’Imana Yesaya, igihe yavuga ati:</para>
  <para style="q1" vid="MAT 3:3">“Hari ijwi ry’uwusemerera mu bugaragwa ati:</para>
  <para style="q1" vid="MAT 3:3">‘Nimutegurire Uhoraho aho aca,</para>
  <para style="q2" vid="MAT 3:3">mugorore inzira agenderamwo.’<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3">Yesaya 40:3</ref></char></char></note>”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yohana yambara impuzu ikozwe mu bwoya bw’ingamiya, akayikenyeza umukanda w’urusato mu rukenyerero. Ivyokurya vyiwe vyari inzige n’ubuki bwo mw’ishamba. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Abantu bava i Yerusalemu, i Yudaya no mu karere k’uruzi Yorodani, bakaja iyo ari. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Bamaze kwatura ivyaha vyabo yaca ababatiza muri Yorodani.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Ariko abonye ko Abafarisayo n’Abasadukayo benshi baje aho ari ngo ababatize, arababaza ati: “Mwa bana b’inzoka mwe, ni nde yababuriye ngo muhunge uburake bw’Imana bugiye kuza? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Nimukore ibikorwa vyerekana ko mwihanye, <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />mureke kwibwira mu mitima yanyu muti: ‘Turi uruvyaro rwa Aburahamu,’ kuko ndababwira ko no muri aya mabuye mubona, Imana ishobora gukuramwo abana ba Aburahamu. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Mbere incabiti ibanguriwe kw’imerero ry’ibiti: igiti cose kitama ivyamwa vyiza kigiye gucibwa gitererwe mu muriro.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />Jewe ndababatiza mu mazi kuko mwihanye ivyaha, ariko uwuje inyuma yanje arandusha ubushobozi, mbere ntibimbereye no kumutwaza ibirato. We azobabatiza muri Mpwemu Yera no mu muriro. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Afise urutaro rwo kugosora mu minwe, azokubura ikibanza co gusekuriramwo. Ahejeje kugosora azokwegeraniriza ingano mu kigega umuguruka na wo awuturirire mu muriro utazokwigera uzima.”<verse eid="MAT 3:12" /></para>
  <para style="s1">Yohana abatiza Yesu</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Maze Yesu ava i Galilaya aja kuri Yorodani ngo abatizwe na Yohana. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Ariko Yohana agerageza kumwankira, avuga ati: “Ni jewe nkwiye kubatizwa nawe, none uje ngo abe ari jewe nkubatiza?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Yesu aramwishura ati: <char style="wj">“Reka tubikore gutyo, kuko bikwiye ko dushitsa ibigororotse vyose.”</char> Yohana aca yemera kumubatiza.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Yesu amaze kubatizwa, aca ava mu mazi. Uwo mwanya nyene, ijuru riruguruka, abona Mpwemu w’Imana amanuka mw’ishusho y’inuma ashika kuri we. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Hanyuma ijwi ryumvikana rivuye mw’ijuru rivuga riti: “Uwu ni Umwana wanje nkunda, akampimbara.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">Yesu ageragezwa na Satani</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Hanyuma Yesu aca ajanwa na Mpwemu mu bugaragwa kugira ngo ageragezwe na Satani. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Amaze imisi mirongo ine n’amajoro mirongo ine ata co arya kandi ata co anywa, yumva arashonje. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Umugeragezi aca aramwegera, amubwira ati: “Niwaba uri Umwana w’Imana, bwira aya mabuye ahinduke imikate.”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Yesu aramwishura ati: <char style="wj">“Handitswe ngo: ‘Umuntu ntabeshwaho n’ivyokurya gusa, ariko atungwa n’ijambo ryose rivuye mu kanwa k’Imana.’</char><note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 8:3">Gusubiramwo 8:3</ref></char></char></note><char style="wj">”</char><verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Hanyuma wa mubi amujana i Yerusalemu, igisagara cera, amuhagarika ku rusengero ahantu hataramutse, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />amubwira ati: “Niwaba uri Umwana w’Imana, niwikororere hasi, kuko handitswe ngo:</para>
  <para style="q1" vid="MAT 4:6">‘Azotegeka abamarayika biwe bakuzigame.</para>
  <para style="q2" vid="MAT 4:6">Bazokurerura mu maboko yabo</para>
  <para style="q2" vid="MAT 4:6">kugira ngo ntutsitare kw’ibuye.’<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 91:11">Zaburi 91:11</ref>,<ref loc="PSA 91:12">12</ref></char></char></note>”<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yesu na we aramwishura ati: <char style="wj">“Handitswe ngo: ‘Ntukagerageze Uhoraho Imana yawe.’</char><note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:16">Gusubiramwo 6:16</ref></char></char></note><char style="wj">”</char><verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Hanyuma Satani yongera kumujana ku musozi muremure cane amwereka ubwami bwose bwo mw’isi n’ubwiza bwabwo. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Aramubwira ati: “Ivyo vyose ndabiguha niwapfukama ukansenga.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yesu aramwishura ati: <char style="wj">“Mva i ruhande Satani! Kuko handitswe ngo: ‘Usenge Uhoraho Imana yawe, kandi abe ari yo yonyene ukorera.’</char><note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:13">Gusubiramwo 6:13</ref></char></char></note><char style="wj">”</char><verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Kuva ako kanya Satani aca aramureka, maze abamarayika baraza baramukorera.<verse eid="MAT 4:11" /></para>
  <para style="s1">Yesu avuga Ubutumwa Bwiza i Galilaya</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Yesu yumvise ko Yohana yashizwe mw’ibohero, aca aja i Galilaya. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Hanyuma ava i Nazareti, aja kuba i Kaperinawumu, igisagara cari hafi y’ikiyaga mu ntara ya Zabuloni na Nafutali, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />kugira ngo ivyavuzwe n’uwavugishwa n’Imana Yesaya bishike. Yavuze ati:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Mu ntara ya Zabuloni n’intara ya Nafutali,</para>
  <para style="q2" vid="MAT 4:15">mu bice vyegereye ikiyaga, hakurya ya Yorodani,</para>
  <para style="q2" vid="MAT 4:15">i Galilaya haba Abanyamahanga benshi;<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />abantu bahora bicaye mu mwijima,</para>
  <para style="q2" vid="MAT 4:16">babonye umuco mwinshi,</para>
  <para style="q1" vid="MAT 4:16">kandi ababa mu gihugu c’igitutu c’urupfu,</para>
  <para style="q2" vid="MAT 4:16">umuco warabarasiye.”<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 9:1">Yesaya 9:1</ref>,<ref loc="ISA 9:2">2</ref></char></char></note><verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Kuva ico gihe Yesu aca atangura kuvuga Ubutumwa Bwiza no kwigisha, ati: <char style="wj">“Nimwihane kuko Ubwami bw’ijuru buri hafi.”</char><verse eid="MAT 4:17" /></para>
  <para style="s1">Abarovyi bane bakurikira Yesu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Yesu ariko aragendagenda ku nkengera y’ikiyaga c’i Galilaya, abona abavukana babiri, Simoni batazira Petero na Andereya mwene nyina, bariko baterera urusenga mu kiyaga kuko bari abarovyi. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yesu arababwira ati: <char style="wj">“Nimunkurikire, nzobagira abarovyi b’abantu.”</char> <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Ubwo nyene, baca basiga ngaho insenga zabo, baramukurikira.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Abandanije, abona abavukana babiri, Yakobo na Yohana bene Zebedayo bari kumwe na se mu bwato, bariko barasana insenga zabo. Maze Yesu arabahamagara, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />baca basiga ubwato na se baramukurikira.<verse eid="MAT 4:22" /></para>
  <para style="s1">Yesu akiza abarwayi benshi</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Ico gihe Yesu agendagenda mu ntara yose ya Galilaya yigishiriza mu masinagogi yaho, avuga Ubutumwa Bwiza bw’Ubwami, akiza abantu ingwara zose n’ubumuga bwose. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Nuko inkuru ziwe zikwiragira hose, gushika no muri Siriya. Bamuzanira abarwayi bose: abafise ububabare butandukanye, ababoshwe n’abadayimoni, abagwaye intandara, hamwe n’abatikakaza kubera bababara mu mubiri; bose arabakiza. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Maze amasinzi y’abantu baramukurikira, bavuye i Galilaya, i Dekapolisi<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">Akarere kagizwe n’ibisagara cumi.</char></note>, i Yerusalemu, i Yudaya, no hakurya ya Yorodani.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">Yesu yigishiriza hejuru ku musozi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Yesu abonye abantu baje ari benshi, aca aduga umusozi. Amaze kwicara, abigishwa biwe baramwegera, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />aca atangura kubigisha.</para>
  <para style="s1" vid="MAT 5:2">Abahirwe abo ari bo</para>
  <para style="p" vid="MAT 5:2">Arababwira ati:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />
    <char style="wj">“Hahiriwe abumva ko bakenye mu buryo bw’impwemu,</char></para>
  <para style="q2" vid="MAT 5:3">
    <char style="wj">kuko Ubwami bw’ijuru ari ubwabo.</char><verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />
    <char style="wj">Hahiriwe abarira,</char></para>
  <para style="q2" vid="MAT 5:4">
    <char style="wj">kuko ari bo bazohozwa.</char><verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />
    <char style="wj">Hahiriwe abaciye bugufi,</char></para>
  <para style="q2" vid="MAT 5:5">
    <char style="wj">kuko bazoragwa isi.</char><verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />
    <char style="wj">Hahiriwe abafise inzara n’inyota vyo kugororoka,</char></para>
  <para style="q2" vid="MAT 5:6">
    <char style="wj">kuko bazohazwa.</char><verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />
    <char style="wj">Hahiriwe abagira imbabazi,</char></para>
  <para style="q2" vid="MAT 5:7">
    <char style="wj">kuko na bo bazozigirirwa.</char><verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />
    <char style="wj">Hahiriwe abafise imitima itanduye,</char></para>
  <para style="q2" vid="MAT 5:8">
    <char style="wj">kuko bazobona Imana.</char><verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />
    <char style="wj">Hahiriwe abaharanira amahoro,</char></para>
  <para style="q2" vid="MAT 5:9">
    <char style="wj">kuko bazokwitwa abana b’Imana.</char><verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />
    <char style="wj">Hahiriwe abahamwa bahorwa ukugororoka,</char></para>
  <para style="q2" vid="MAT 5:10">
    <char style="wj">kuko Ubwami bw’ijuru ari ubwabo.</char><verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />
    <char style="wj">Namwe muzoba muhiriwe abantu nibabatuka, bakabahama, bakabavugako bababeshera ibibi vyinshi babampora.</char> <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" /><char style="wj">Muze munezerwe kandi muhimbarwe kuko impera yanyu izoba ari nini mw’ijuru. Uko ni ko bahamye abavugishwa n’Imana babitangiye imbere.</char><verse eid="MAT 5:12" /></para>
  <para style="s1">Abizera ni umunyu n’umuco</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />
    <char style="wj">Muri umunyu mu bantu bo mw’isi. Ariko iyo umunyu utakaje uburyohe bwawo, mbega bwosubiramwo gute? Nta co uba ukimaze atari ugutabwa hanze abantu bakawuhonyanga.</char><verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />
    <char style="wj">Muri umuco mu bantu bo mw’isi. Igisagara kiri hejuru ku gasozi, ntigishobora kunyegezwa.</char> <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" /><char style="wj">Ni ko bimeze no kw’itara, nta woridomeka ngo ace aryubikako igiseke. Ahubwo arishira ku giterekwako itara kugira ngo riboneshereze abari mu nzu bose.</char> <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" /><char style="wj">Uko ni ko mukwiye kureka umuco wanyu ukakira imbere y’abantu kugira ngo babone ibikorwa vyanyu vyiza, hanyuma bahimbaze So wo mw’ijuru.</char><verse eid="MAT 5:16" /></para>
  <para style="s1">Yesu avuga ibijanye n’Ivyagezwe</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />
    <char style="wj">Ntimwibaze ko nazanywe no gukuraho Ivyagezwe canke ivyanditswe n’abavugishwa n’Imana. Oya sinazanywe no kubikuraho, ahubwo nazanywe no kubishitsa.</char> <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" /><char style="wj">Ndababwire ukuri, igihe cose ijuru n’isi bizoba bikiriho, nta n’akadome na gatoya canke agakwabu ko mu Vyagezwe kazovako, kugeza ivyo vyagezwe bishikije intumbero yavyo.</char> <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" /><char style="wj">Ni co gituma umuntu wese atazokurikiza ayo mabwirizwa naho ryoba ritoya ryo muri yo kandi akigisha abandi kutayakurikiza azoba uwa nyuma mu Bwami bw’ijuru. Ariko uwo wese azoyakurikiza akigisha n’abandi kuyakurikiza azoba mukuru mu Bwami bw’ijuru.</char> <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" /><char style="wj">Ndababwire ukuri, ukugororoka kwanyu niyo kutaruta ukw’abigisha b’ivyagezwe n’ukw’Abafarisayo, ntimuzoruha mwinjira mu Bwami bw’ijuru.</char><verse eid="MAT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />
    <char style="wj">Mwarumvise ko ba sogokuruza bari barigishijwe ngo: ‘Ntukice, uwica wese azotsindwa n’urubanza’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:21 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="EXO 20:13">Kuvayo 20:13</ref>
        </char>
      </char>
    </note>
    <char style="wj">;</char> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" /><char style="wj">ariko jeho ndababwira ko umuntu wese ashavurira mwenewabo aba akwiye gucirwa urubanza kandi uwubwiye umuvukanyi ngo: Wa mburabwenge we, aba akwiye guhanwa n’abacamanza. Kandi uwubwiye umuntu ngo: Wa musazi we aba akwiye gutererwa mu muriro wa Gehinomu.</char><verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />
    <char style="wj">Mu gihe rero uriko urashikanira Imana ikimazi ku gicaniro, ukibuka ko hariho ikintu upfa na mugenzawe,</char> <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" /><char style="wj">siga ikimazi cawe ngaho imbere y’igicaniro, ubanze ugende wiyuzuze na mugenzawe hanyuma ugaruke utange ico kimazi.</char><verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />
    <char style="wj">Nihagira umuntu aja kukwitwarira mu rubanza, wihutire kwiyuzuza na we mukiri mu nzira, kugira ngo ntagushikirize umucamanza hanyuma na we akagutanga ku mukuru w’ibohero, uwo na we akaguta mw’ibohero.</char> <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" /><char style="wj">Ndakubwire ukuri, ntuzovayo utarishe n’igiceri ca nyuma umuheraniye.</char><verse eid="MAT 5:26" /></para>
  <para style="s1">Wopfuma utakaza igihimba kimwe c’umubiri hako ubura ijuru</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />
    <char style="wj">Mwarumvise ko vyavuzwe ngo: ‘Ntugasambane.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:27 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="EXO 20:14">Kuvayo 20:14</ref>
        </char>
      </char>
    </note> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" /><char style="wj">Ariko jeho ndababwira nti umuntu wese araba umugore akipfuza gusambana na we aba yamaze gukora ico caha mu mutima.</char> <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" /><char style="wj">Ijisho ryawe ry’i buryo niryatuma wipfuza, ukagwa mu caha, urikureyo urite kure yawe, kuko vyokubera vyiza kubura igihimba kimwe c’umubiri wawe hako umubiri wawe wose utabwa muri Gehinomu.</char> <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" /><char style="wj">Ukuboko kwawe kw’i buryo nikwatuma ucumura, uguce ugute kure yawe, kuko vyokubera vyiza, kubura igihimba kimwe c’umubiri hako umubiri wawe wose utabwa muri Gehinomu.</char><verse eid="MAT 5:30" /></para>
  <para style="s1">Kwahukana ntikwemewe</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />
    <char style="wj">Vyaravuzwe mu vyagezwe ngo: ‘Umuntu niyirukana umugore wiwe, ategerezwa kumuha urwandiko rwemeza ko bahukanye.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:31 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="DEU 24:1">Gusubiramwo 24:1</ref>
        </char>
      </char>
    </note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" /><char style="wj">Ariko jeho ndababwira yuko umuntu wese yirukana umugore wiwe atamuhoye ubusambanyi, aba amutumye gusambana kandi uwurongoye umugore yahukanye, na we aba asambanye.</char><verse eid="MAT 5:32" /></para>
  <para style="s1">Ntukarahire</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />
    <char style="wj">Kandi, mwarumvise ko ba sogokuruza babwiwe ngo: ‘Ntukivuguruze ku vyo warahiye, ariko ushitse ivyo wemereye Uhoraho.’</char> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" /><char style="wj">Ariko jeho ndababwiye nti, ntimukarahire na rimwe: ntimukarahire ijuru kuko ari yo ntebe y’Imana; kandi</char> <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" /><char style="wj">ntimukarahire isi kuko ari yo ntebe y’ibirenge vyayo; ntimukarahire Yerusalemu kuko ari co gisagara c’Imana, Umwami asumba bose.</char> <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" /><char style="wj">Kandi ntukarahire umutwe wawe kuko udashobora gutuma n’agashatsi na kamwe kawo kera canke kirabura.</char> <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" /><char style="wj">Muvuge ngo ‘ego’ iyo ari ego canke ‘oya’ iyo ari oya, ibindi vyose wongerako biba bivuye kuri wa mubi.</char><verse eid="MAT 5:37" /></para>
  <para style="s1">Ntukihore abakugirira nabi</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />
    <char style="wj">Mwarumvise ko vyavuzwe mu vyagezwe ngo: ‘Ijisho rihorwe irindi, n’iryinyo rihorwe irindi.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:38 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="EXO 21:24">Kuvayo 21:24</ref>; <ref loc="LEV 24:20">Abalewi 24:20</ref>; <ref loc="DEU 19:21">Gusubiramwo 19:21</ref></char>
      </char>
    </note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" /><char style="wj">Ariko jeho ndababwiye nti: ntimukihore ababagirira nabi. Umuntu niyagukubita ikofe mu musaya w’i buryo, umuhindukirize n’uw’i bubamfu.</char> <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" /><char style="wj">Kandi umuntu niyagomba kukuburanya kugira ngo akunyage ishati yawe, umuhebere n’ikoti na yo.</char> <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" /><char style="wj">Umuntu niyagutegeka kugenda ikilometero n’amaguru umutwaje ibintu, ugende ibilometero bibiri.</char> <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" /><char style="wj">Umuntu niyagusaba ikintu ukimuhe, kandi uwugomba ko umugurana ntumwirengagize.</char><verse eid="MAT 5:42" /></para>
  <para style="s1">Gukunda abansi</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />
    <char style="wj">Mwarumvise ko vyavuzwe mu vyagezwe ngo: ‘Ukunde mugenzawe ariko wanke umwansi wawe.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:43 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="LEV 19:18">Abalewi 19:18</ref>
        </char>
      </char>
    </note> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" /><char style="wj">Jeho ndababwiye nti: mukunde abansi banyu kandi musengere ababagirira nabi,</char> <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" /><char style="wj">kugira ngo mumere nk’abana ba Data wo mw’ijuru, kuko atuma izuba ryiwe ryakira ababi n’abeza akagwishiriza imvura abagororotse n’abatagororotse.</char> <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" /><char style="wj">Nimwakunda ababakunda gusa, n’igiki cotuma muhabwa impera n’Imana? Mbega abatozakori bo si uko babigenza?</char> <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" /><char style="wj">Nimwaramutsa incuti zanyu gusa, ni igiki muzoba murushije abandi? Mbega abatizera Imana bo ntibabigenza batyo?</char> <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" /><char style="wj">Nuko rero nimube intungane, nk’uko So wo mw’ijuru na we ari intungane!</char><verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">Uburyo bwiza bwo gutanga</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />
    <char style="wj">Mwirinde ntimukore ibikorwa vyo kugororoka murondera gushimwa n’abantu. Kuko nimwabikora gutyo, So wo mw’ijuru ntazobaha impera.</char><verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />
    <char style="wj">Nihagira ico uha umukene, ntuze uvuze inzamba nk’uko indyarya zibikora mu masinagogi no ku mabarabara barondera gushimwa n’abantu. Ndababwire ukuri; abo baramaze guhabwa impera zabo zose.</char> <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" /><char style="wj">Ariko niwagira ico uha umukene, ukuboko kwawe kw’i bubamfu, ntigukwiye kumenya ico ukuboko kw’i buryo gukoze.</char> <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" /><char style="wj">Gutyo, gutanga kwawe kugume ari ibanga, kandi So wo mw’ijuru abona ibikorerwa mw’ibanga, azobiguhembera.</char><verse eid="MAT 6:4" /></para>
  <para style="s1">Inyigisho zerekeye gusenga</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />
    <char style="wj">Kandi, iyo musenga, ntimumere nka za ndyarya kuko zikunda gusenga zihagaze mu masinagogi no mu mayirabiri, kugira ngo abantu bose bababone. Ndababwire ukuri, abo baramaze guhabwa impera zabo zose.</char> <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" /><char style="wj">Ariko, wewe ugomvye gusenga, winjire mu cumba cawe, wugare umuryango, hanyuma usenge. So wo mw’ijuru, we abona ivyo mw’ibanga, azobiguhembera.</char> <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" /><char style="wj">Iyo musenga, ntimuvuge amajambo menshi nk’abatizera Imana, biyumvira ko Imana ibumva kubera amajambo menshi bavuze.</char> <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" /><char style="wj">Ntimugire nka bo, kuko Data wo mw’ijuru azi neza ivyo mukeneye imbere y’uko munabimusaba.</char><verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />
    <char style="wj">Mukwiye gusenga muvuga muti:</char></para>
  <para style="q1" vid="MAT 6:9">
    <char style="wj">Data wa twese uri mw’ijuru,</char></para>
  <para style="q1" vid="MAT 6:9">
    <char style="wj">izina ryawe niryubahwe,</char><verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />
    <char style="wj">Ubwami bwawe buze,</char></para>
  <para style="q1" vid="MAT 6:10">
    <char style="wj">ivyo ugomba bibe</char></para>
  <para style="q2" vid="MAT 6:10">
    <char style="wj">mw’isi nk’uko biba mw’ijuru.</char><verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />
    <char style="wj">Uduhe ivyokurya bidukwiye uwu musi,</char><verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />
    <char style="wj">uduharire ivyaha vyacu,</char></para>
  <para style="q2" vid="MAT 6:12">
    <char style="wj">nk’uko natwe duharira abaducumuyeko.</char><verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />
    <char style="wj">Ntudutererane ibitugerageza,</char></para>
  <para style="q2" vid="MAT 6:13">
    <char style="wj">uhubwo udukize wa mubi.</char></para>
  <para style="q1" vid="MAT 6:13">[<char style="wj">Kuko Ubwami, ubushobozi n’ubwiza</char></para>
  <para style="q2" vid="MAT 6:13">
    <char style="wj">ari ivyawe ibihe vyose.</char></para>
  <para style="qr" vid="MAT 6:13">
    <char style="wj">Amen.</char>]<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Mu nzandiko zimwezimwe za Bibiliya aya majambo ntarimwo.</char></note><verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />
    <char style="wj">Kuko nimwaharira abantu ibibi babakoreye, na So wo mw’ijuru azobaharira namwe.</char> <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" /><char style="wj">Ariko nimutaharira abandi ibibi vyabo, na So wo mw’ijuru ntazobaharira namwe ibibi vyanyu.</char><verse eid="MAT 6:15" /></para>
  <para style="s1">Gusenga no kwisonzesha</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />
    <char style="wj">Iyo mwisonzesheje, ntimwerekane ko mubabaye nk’uko za ndyarya zibigira: kuko baca bijirirwa mu maso kugira ngo abababona bose babashimire ukwisonzesha kwabo. Ndababwire ukuri: iyo ni yo mpera yonyene bazoronka.</char> <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" /><char style="wj">Ariko wewe, iyo wisonzesheje, woge mu maso hanyuma wisige amavuta mu mutwe,</char> <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" /><char style="wj">kugira ngo ntiwereke abantu ko wisonzesheje; ahubwo uvyereke So ari ahihishije; maze So, we abona ibikorerwa mw’ibanga, azobiguhembera.</char><verse eid="MAT 6:18" /></para>
  <para style="s1">Tubike ubutunzi bwacu mw’ijuru</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />
    <char style="wj">Ntimukirundanirize ubutunzi mw’isi, aho imiswa, inyenzi n’ingese bishobora kubwonona, kandi n’ibisuma bigashobora kumena bikabwiba.</char> <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" /><char style="wj">Ariko, mwirundanirize ubutunzi mw’ijuru, aho imiswa, inyenzi n’ingese bidashika ngo bibwonone canke abasuma badashika ngo bamene babwibe;</char> <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" /><char style="wj">kuko aho ubutunzi bwawe buri, ari ho n’umutima wawe uzoba.</char><verse eid="MAT 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />
    <char style="wj">Amaso ni yo matara y’umubiri. Iyo amaso yawe abona neza, umubiri wawe wose uba mu muco.</char> <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" /><char style="wj">Ariko iyo atabona neza, umubiri wawe wose uca uba mu mwijima. Nimba wibaza ko ufise umuco kandi ari umwijima, umwijima uri muri wewe n’umuzitanya!</char><verse eid="MAT 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />
    <char style="wj">Nta muntu n’umwe yoshobora gushimisha abakoresha babiri: agerageje kunezereza umwe yosanga yababaje uwundi; kandi agerageje kuba umwizigirwa kuri umwe yosanga yahemukiye uwundi. Ntimushobora gukoreshwa n’Imana ngo mwongere mukoreshwe n’amahera.</char><verse eid="MAT 6:24" /></para>
  <para style="s1">Ntimukiganyire</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />
    <char style="wj">Ni co gituma ndababwira nti: ntimukiganyire kubera ivyo mukeneye kugira ngo mubeho; vyaba ivyokurya, ivyo kunywa, canke ivyo kwambara. Mbega ubuzima ntiburuta cane ivyokurya kandi umubiri nturuta cane ivyambarwa?</char> <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" /><char style="wj">Nimwitegereze inyoni zo mu kirere: ntizibiba, ntizimbura kandi nta co zegeraniriza mu bigega; ariko So wo mw’ijuru arazigaburira! None mwebwe ntimuziruta cane?</char> <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" /><char style="wj">Ni nde muri mwebwe yoshobora kwiyongera akanya na gatoya ko kubaho kubera kwiganyira?</char><verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />
    <char style="wj">Ni kuki mwiganyira kubera ivyo mwambara? Nimwitegereze ingene amashurwe yo ku misozi akura. Ntakora kandi ntajisha impuzu.</char> <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" /><char style="wj">Ariko ndababwira ko na Salomo ubwiwe, mu cubahiro ciwe cose, atigeze ashaza nka rimwe muri yo.</char> <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" /><char style="wj">Nimba Imana yambika gutyo ivyatsi vyo ku misozi, biriho uno musi ariko ejo bikazotererwa mu ziko, mbega ntizorushirizaho kubambika, yemwe ab’ukwizera guke?</char> <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" /><char style="wj">Ni co gituma mudakwiye kwiganyira; muvuga muti: ‘Mbega tuzorya iki? Tuzonywa iki? Tuzokwambara iki?’</char> <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" /><char style="wj">Ivyo ni vyo abatizera Imana birukira ubudasiba; ariko mweho So wo mw’ijuru arazi ko ivyo vyose mubikeneye.</char> <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" /><char style="wj">Ahubwo, nimubanze mwitwararike Ubwami bw’Imana no kugororoka kwayo, hanyuma ivyo na vyo izobibaha nk’inyongera.</char> <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" /><char style="wj">Nuko rero ntimugahagarike imitima ku vy’ejo, kuko ejo hazoza hafise ingorane bijanye. Umusi wose ufise umwitwarariko wawo.</char><verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">Ntugacire imanza abandi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />
    <char style="wj">Ntimugacire abandi imanza kugira ngo namwe ntimuzozicirwe.</char> <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" /><char style="wj">Kuko uko mucira abandi imanza ni ko namwe muzozicirwa, kandi uko mugerera abandi ari ko namwe muzogererwa.</char><verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />
    <char style="wj">Ni kuki ushinga ijisho akatsi kari mu jisho rya mugenzawe ariko ntiwiteho inkingi y’igiti iri mu jisho ryawe?</char> <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" /><char style="wj">Ni kuki ubwira mugenzawe uti: ‘Reka ndagutosore akatsi kari mu jisho,’ kandi nawe ugendana inkingi y’igiti mu jisho ryawe?</char> <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" /><char style="wj">Wa ndyarya we, tangura ukure inkingi y’igiti iri mu jisho ryawe, ni ho uzobona neza akatsi kari mu jisho rya mugenzawe, uheze ugakureyo.</char><verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />
    <char style="wj">Ntimugahe ivyera vy’Imana imbwa, kandi ivy’agaciro kanini vyanyu, ntimukabiterere ingurube, kuko zohava zibihonyanga, hanyuma zikabahindukirira zikabatabagura.</char><verse eid="MAT 7:6" /></para>
  <para style="s1">Gusaba n’umwete</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />
    <char style="wj">Musabe muzohabwa, murondere muzoronka, mudodore muzokwugururirwa.</char> <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" /><char style="wj">Kuko uwusaba wese arahabwa, uwurondera araronka, n’uwudodora arugururirwa.</char><verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />
    <char style="wj">Ni nde muri mwebwe yoha umwana wiwe ibuye yamusavye umukate,</char> <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" /><char style="wj">canke akamuha inzoka yamusavye ifi?</char> <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" /><char style="wj">Nimba mwebwe mushobora guha ingabire nziza abana banyu kandi muri babi mu mitima, none So wo mw’ijuru ntazorushiriza guha ivyiza ababimusavye!</char> <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" /><char style="wj">Nuko rero, ivyo mugomba ko abantu babagirira, abe ari vyo mubagirira namwe, kuko ivyo ari vyo Ivyagezwe n’ivyanditswe n’abavugishwa n’Imana vyigisha.</char><verse eid="MAT 7:12" /></para>
  <para style="s1">Irembo ryaga n’irembo ryagutse</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />
    <char style="wj">Muce mw’irembo ryaga. Kuko irembo ryagutse n’inzira yagutse bijana mu mahonero, kandi abantu benshi ni ho baca.</char> <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" /><char style="wj">Ariko irembo ryaga n’inzira ntoya ni vyo bijana mu bugingo, kandi ababihitamwo ni bake.</char><verse eid="MAT 7:14" /></para>
  <para style="s1">Abavugishwa b’ukuri n’ab’ibinyoma</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />
    <char style="wj">Mwirinde abavugishwa b’ibinyoma, baza muri mwebwe bambaye nk’intama inyuma, ariko imbere muri bo bameze nk’ibikoko vy’inkazi.</char> <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" /><char style="wj">Muzobamenyera ku vyo bama, ari vyo bikorwa vyabo. Nta wokwamura inzabibu ku bisaka vy’amahwa, canke insukoni ku mitobotobo.</char> <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" /><char style="wj">Igiti ciza cama ivyamwa vyiza, kandi igiti kibi cama ivyamwa bibi.</char> <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" /><char style="wj">Nta giti ciza cokwama ivyamwa bibi, kandi nta giti kibi cokwama ivyamwa vyiza.</char> <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" /><char style="wj">Igiti cose cama ivyamwa bibi kiracibwa kigatererwa mu muriro.</char> <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" /><char style="wj">Nuko rero, muzobamenyera ku bikorwa vyabo.</char><verse eid="MAT 7:20" /></para>
  <para style="s1">Abigishwa b’ukuri n’ab’ibinyoma</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />
    <char style="wj">Abampamagara ngo: Mwami, Mwami, si bose bazokwinjira mu Bwami bw’ijuru, ariko ni abakora ivyo Data wo mw’ijuru agomba.</char> <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" /><char style="wj">Ku musi w’urubanza, benshi bazombwira ngo: Mwami, Mwami, mbega ntitwavugishwa mw’izina ryawe, kandi ntitwirukana abadayimoni mw’izina ryawe bakava mu bantu, tugakora n’ibitangaza vyinshi?</char> <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" /><char style="wj">Ariko, nzobishura nti: ‘Nta ho nigeze ndabamenya. Nimumve i ruhande mwa nkozi z’ibibi mwe!’</char><verse eid="MAT 7:23" /></para>
  <para style="s1">Umwubatsi w’ubwenge n’uw’ikijuju</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />
    <char style="wj">Nuko rero umuntu wese yumva amajambo yanje akayashira mu ngiro ameze nk’umwubatsi w’ubwenge yubatse inzu yiwe ku rutare.</char> <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" /><char style="wj">Imvura yaraguye, inzuzi ziruzura, igihuhusi kirahuhuta, vyose vyisuka kuri nya nzu, yamara ntiyasenyuka kuko umushinge wayo wari umase ku rutare.</char> <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" /><char style="wj">Ariko umuntu wese yumva aya majambo yanje hanyuma ntayashire mu ngiro ameze nk’umwubatsi w’ubwenge buke yubatse inzu yiwe ku musenyi.</char> <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" /><char style="wj">Imvura yaraguye, inzuzi ziruzura, igihuhusi kirahuhuta, vyose vyisuka kuri nya nzu, hanyuma irasenyuka kandi isenyuka ryayo ryabaye irikomeye.”</char><verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Yesu amaze kuvuga ivyo, abantu batangazwa n’inyigisho ziwe; <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />kuko yigishanya ububasha, mu buryo butandukanye n’ubw’abigisha b’ivyagezwe babo.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">Yesu akiza umuntu agwaye imibembe</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Nuko Yesu ava kuri uwo musozi, amanukana n’abantu isinzi bamukurikiye. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Maze haza umuntu agwaye imibembe, apfukama imbere yiwe, amubwira ati: “Mwami, ubishatse, woshobora kunkiza ngahumanuka.”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yesu aca aramvura ukuboko amukorako. Aramubwira ati: <char style="wj">“Ndabishatse, kira uhumanuke!”</char> Ubwo nyene aca arakira ya mibembe. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Maze Yesu yongera amubwira ati: <char style="wj">“Ntihagire umuntu n’umwe ubibwira. Ariko genda ku muherezi agusuzume, hanyuma utange ikimazi Mose yashinze ko uwuhumanutse atanga kugira ngo bose bamenye ko wahumanutse.”</char><verse eid="MAT 8:4" /></para>
  <para style="s1">Ukwizera kw’umusoda mukuru w’Umuroma</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Yesu ashitse i Kaperinawumu, intwazangabo mu basoda b’Abaroma aza aho ari, aramwinginga ngo amufashe. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />Amubwira ati: “Mwami, umukozi wanje aryamye i muhira, ntiyikoma kandi arababaye cane.”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yesu aramwishura ati: <char style="wj">“Ndaje kumukiza.”</char><verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Ariko, uwo musoda nawe aca amwishura ati: “Mwami, ntibimbereye ko wokwinjira mu nzu yanje. Pfa kuvuga ijambo rimwe gusa umukozi wanje arakira. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Kuko nanje, ndafise abantegeka, kandi mfise n’abasoda ntegeka. Iyo mbwiye umwe nti: ‘Genda,’ aca agenda; nabwira uwundi nti: ‘Ngwino,’ agaca aza; kandi iyo mbwiye umukozi wanje nti: ‘Kora iki,’ aca agikora.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Yesu avyumvise aratangara cane, abwira abariko baramukurikira ati: <char style="wj">“Ndababwire ukuri, nta muntu n’umwe muri Isirayeli nari bwabonane ukwizera gukomeye nk’uku.</char> <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" /><char style="wj">Ndababwira ko abantu benshi bazoza, bamwe bavuye mu buseruko abandi mu burengero, bahabwe ivyicaro mu mazimano hamwe na Aburahamu, na Isaka na Yakobo mu Bwami bw’ijuru;</char> <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" /><char style="wj">mu gihe abari bateguriwe ubwo bwami bazoba baterewe hanze mu mwijima, aho bazokwama baboroga kandi bahekenya amenyo.”</char><verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Hanyuma Yesu aca abwira wa musoda mukuru ati: <char style="wj">“Genda bikubere uko nyene uvyizeye.”</char> Ako kanya nyene wa mukozi wiwe aca arakira.<verse eid="MAT 8:13" /></para>
  <para style="s1">Yesu akiza abandi bantu benshi</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Yesu aca aja i muhira kwa Petero, asanga inabukwe wa Petero ari ku buriri, agwaye kandi ashushe cane. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Amukora ku kuboko, ako kanya nyene bwa bushuhe buca burahera, aca ava hasi aramuzimana.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Ku mugoroba, bazanira Yesu abantu benshi baboshwe n’abadayimoni. Yirukana izo mpwemu mbi mu kuzitegeka, azikura mu bantu kandi akiza abagwaye bose. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Ivyo yabikoze kugira ngo ijambo uwavugishwa n’Imana Yesaya yavuze rishike, aho yavuze ati:</para>
  <para style="q1" vid="MAT 8:17">“Yikoreye ubumuga bwacu,</para>
  <para style="q2" vid="MAT 8:17">yishirako ingwara zacu zose.”<note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:4">Yesaya 53:4</ref></char></char></note><verse eid="MAT 8:17" /></para>
  <para style="s1">Ikiguzi co gukurikira Yesu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Yesu abonye isinzi ry’abantu baje kumushengerera, aca abwira abigishwa biwe ngo bajabuke, baje hakurya y’ikiyaga. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Umwe mu bigisha b’ivyagezwe aca aramwegera, amubwira ati: “Mwigisha, nditeguye kugukurikira aho uja hose.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Yesu aramwishura ati: <char style="wj">“Imbwebwe zirafise imyobo zibamwo n’inyoni zo mu kirere zirafise ivyari, ariko Umwana w’Umuntu ntagira n’aho akika umusaya.”</char><verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Uwundi mu bigishwa amubwira ati: “Mwami, ndeka mbanze ngende mpambe data.”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Yesu aramwishura ati: <char style="wj">“Nkurikira, reka abapfuye mu mpwemu bahambe abapfuye babo.”</char><verse eid="MAT 8:22" /></para>
  <para style="s1">Yesu ategeka igihuhusi kikamwumvira</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Ivyo biheze, Yesu aca aja mu bwato, kandi abigishwa biwe bajana na we. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Ubwo nyene haza umuyaga w’igihuhusi mu kiyaga, ku buryo imipfunda yaza irisuka mu bwato; ariko Yesu yari asinziriye. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Abigishwa biwe baramukangura bataka bati: “Mwami dukize, turapfuye!”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Yesu arabishura ati: <char style="wj">“Yemwe mwa bantu b’ukwizera guke, ni kuki mufise ubwoba?”</char> Aca aravyuka, akankamira uwo muyaga n’imipfunda, haba agahwekere.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Maze bose baratangara, barabazanya bati: “Mbega uwu ni umuntu ki, ko umuyaga n’imipfunda na vyo bimwumvira?”<verse eid="MAT 8:27" /></para>
  <para style="s1">Yesu akiza abantu babiri barimwo abadayimoni</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Yesu ashitse hakurya y’ikiyaga, mu ntara ya Gadarene, abantu babiri baboshwe n’abadayimoni baza guhura na we, bavuye mw’itongo ry’abapfuye. Bari bateye ubwoba ku buryo ata muntu n’umwe yashobora guca muri iyo nzira. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Abo badayimoni bamubonye, baca barasemerera bati: “Uturonderako iki ga Mwana w’Imana? Uje kudukubagura kandi igihe cacu kitaragera?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Hafi y’aho hari umukuku munini w’ingurube zari ziragiwe ku musozi. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Abo badayimoni binginga Yesu bati: “Ugomvye kutwirukana, twemerere tuje muri ziriya ngurube.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Yesu arababwira ati: <char style="wj">“Nimugende!”</char> Baca bava muri abo bantu, bitera muri za ngurube. Ubwo nyene wa mukuku wose w’ingurube uca wiruka umanuka, zisuka mu kiyaga ziradwibira, zicwa n’amazi. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Abari baragiye izo ngurube na bo baca bariruka barahunga; baja mu gisagara kuvuga ibibaye, n’ivyashikiye ba bantu babiri bahora baboshwe n’abadayimoni. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Hanyuma abantu bose bo muri ico gisagara, baja gutegera Yesu, bamubonye baramwinginga ngo abavire mu ntara.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">Yesu akiza umuntu amugaye</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Maze Yesu atambukira mu bwato, arajabuka aja hakurya y’ikiyaga mu gisagara c’iwabo. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Nuko haza abantu bamuzaniye umuntu akongataye bamureruye ku nderuzo. Yesu abonye ukwizera kwabo, abwira uwo amugaye ati: <char style="wj">“Humura, mwana wanje, ivyaha vyawe urabihariwe.”</char><verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Bamwe mu bigisha b’ivyagezwe baravugana bati: “Uwo mugabo atutse Imana!”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Yesu amenye ivyo vyiyumviro vyabo, aca ababwira ati: <char style="wj">“Ni igiki kibateye kwiyumvira nabi mu mitima yanyu?</char> <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" /><char style="wj">Mbega icoroshe ni uko novuga nti: ‘Ivyaha vyawe urabihariwe,’ canke ni uko novuga nti: ‘Haguruka ugende’?</char> <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" /><char style="wj">Ariko nshaka ko mutahura ko Umwana w’Umuntu afise ububasha kw’isi bwo guharira ivyaha.”</char> Nuko abwira uwo muntu amugaye ati: <char style="wj">“Haguruka, ikorere inderuzo yawe, witahire.”</char> <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Uwo muntu aca arahaguruka arataha. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Abantu babibonye, bagira ubwoba, hanyuma bahimbaza Imana yahaye umuntu ububasha bungana gutyo.<verse eid="MAT 9:8" /></para>
  <para style="s1">Yesu ahamagara Matayo</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Yesu avuye aho, abona umutozakori yitwa Matayo yicaye aho atoreza ikori, amubwira ati: <char style="wj">“Nkurikira.”</char> Matayo aca ava hasi, aramukurikira.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Maze Yesu acicaye mu nzu kwa Matayo ngo bamuzimane, haza abatozakori n’abanyavyaha benshi basangira na Yesu n’abigishwa biwe. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Ariko Abafarisayo babibonye, babaza abigishwa biwe bati: “Ni kuki umwigisha wanyu asangira n’abatozakori n’abandi banyavyaha?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Yesu avyumvise aca avuga ati: <char style="wj">“Abakomeye si bo bakeneye umuganga, ahubwo abagwaye ni bo bamukeneye.</char> <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" /><char style="wj">Nimugende mwige iri jambo ico rivuga: ‘Nshaka ko mugira imbabazi kuruta kumpa ibimazi.’</char><note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 6:6">Hoseya 6:6</ref></char></char></note> <char style="wj">Kuko sinaje kurondera abagororotsi, ahubwo naje kurondera abanyavyaha.”</char><verse eid="MAT 9:13" /></para>
  <para style="s1">Babaza Yesu ivyerekeye kwisonzesha</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Abigishwa ba Yohana Umubatizi baraza baramubaza bati: “Ni kuki twe n’Abafarisayo twisonzesha kenshi, ariko abigishwa bawe ntibisonzeshe?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yesu arabishura ati: <char style="wj">“Mbega abatumire b’umukwe bogandara bakiri kumwe na we? Ariko hazogera aho umukwe abakurwamwo; ico gihe rero bazoheza bisonzeshe.</char><verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />
    <char style="wj">Nta wofata igitambara gishasha ngo akibaririre ku mpuzu y’umushire, kuko ico gitambara cotuma ya mpuzu y’umushire itabuka rwose.</char> <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" /><char style="wj">Ni nk’uko ata wosuka umuvinyu mushasha mu mukuza w’urusato ushaje, kuko uwo muvinyu wotuma uwo mukuza umeneka; hanyuma akabura umuvinyu n’umukuza. Ahubwo umuvinyu mushasha bawushira mu mukuza mushasha, ni ho vyompi biramba.”</char><verse eid="MAT 9:17" /></para>
  <para style="s1">Yesu azura umwana, akiza n’umugore agwaye</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Akiriko aravuga ivyo, haza umukuru w’isinagogi<note caller="+" style="f"><char style="fr" closed="false">9:18 </char><char style="fq" closed="false">isinagogi </char><char style="ft" closed="false">yari inyubakwa canke ikibanza co gusengeramwo, kwigishirizamwo, n’ibindi.</char></note> apfukama imbere yiwe amubwira ati: “Umwana wanje w’umukobwa ahejeje gupfa, ariko woza ukamurambikako ibiganza, yosubira kuba muzima.” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yesu aca arahaguruka ajana na we n’abigishwa biwe.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Umugore yari amaranye imyaka cumi n’ibiri ingwara yo mu gitereko yo kuguma ava amaraso, yegera Yesu amuturutse inyuma, akora ku musozo w’impuzu yiwe. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Kuko yari yiyumviriye ati: “Naho nokora ku mpuzu yiwe gusa, nokira.”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yesu arahindukira, amubonye amubwira ati: <char style="wj">“Humura, mwana wanje, ukwizera kwawe kuragukijije.”</char> Ubwo nyene uwo mugore aca arakira.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Yesu ashitse mu nzu kwa wa mukuru w’isinagogi, abona abantu bavuza imyironge yo gucura intimba n’abandi benshi bakoma induru. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Arababwira, ati: <char style="wj">“Nimusohoke. Umwana ntiyapfuye, arasinziriye.”</char> Ariko, abo bantu baramutwenga. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Bamaze gusohoka, arinjira amufata ukuboko, wa mwana aca aravyuka. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Inkuru y’ico gitangaza ica ikwira hose muri iyo ntara.<verse eid="MAT 9:26" /></para>
  <para style="s1">Yesu akiza impumyi zibiri n’ikiragi</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yesu avuye aho, abantu babiri bahumye baramukurikira basemerera, bati: “Tugirire imbabazi Mwana wa Dawidi!”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Ashitse mu nzu, izo mpumyi ziramwegera; hanyuma arababaza ati: <char style="wj">“Murizeye ko nobahumura?”</char></para>
  <para style="p" vid="MAT 9:28">Bati: “Egome Mwami, turavyizeye.”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Nuko abakora ku maso avuga ati: <char style="wj">“Bibabere nk’uko mwizeye.”</char> <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Maze amaso yabo aca arahumuka. Yesu arabihanikiriza ati: <char style="wj">“Mwirinde, ntihagire umuntu n’umwe abimenya.”</char> <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Ariko bo, basohotse baca bakwiragiza inkuru z’ivyo yabakoreye muri iyo ntara yose.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Abo bamaze gusohoka, baca bamuzanira umuntu aboshwe n’umudayimoni amutera kuba ikiragi. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Yesu aca yirukana iyo dayimoni; imuvuyemwo aca aravuga. Abantu babibonye baratangara, bavuga bati: “Ntihari bwaboneke ibisa n’ibi muri Isirayeli.”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Ariko Abafarisayo bo bavuga bati: “Umukuru w’abadayimoni ni we amushoboza kwirukana abadayimoni.”<verse eid="MAT 9:34" /></para>
  <para style="s1">Yesu aterwa ikigongwe n’abantu</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Hanyuma Yesu agendagenda mu bisagara vyose no mu mihana yose yigisha mu masinagogi yaho, avuga Ubutumwa Bwiza bw’Ubwami, akiza ingwara zose n’ubumuga bwose. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Abonye abantu, bamutera ikigongwe; kuko bari bagowe, batagira uwubatabara, mbere bari bameze nk’intama zitagira umwungere. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Aca abwira abigishwa biwe ati: <char style="wj">“Ivyimburwa ni vyinshi, ariko abimbuzi ni bake.</char> <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" /><char style="wj">Nimwinginge nyene ivyimburwa arungike abimbuzi mu vyimburwa vyiwe.”</char><verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">Yesu atuma abigishwa cumi na babiri</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yesu ahamagara abigishwa biwe cumi na babiri abaha ububasha bwo kwirukana impwemu zihumanye no gukiza ubumuga bwose n’ingwara zose.<verse eid="MAT 10:1" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="2" style="v" sid="MAT 10:2" />Aya ni yo mazina y’intumwa ziwe cumi na zibiri:</para>
  <para style="b" vid="MAT 10:2" />
  <para style="li1" vid="MAT 10:2">uwa mbere ni Simoni, ari we yitwa Petero, na mwene nyina Andereya,</para>
  <para style="li1" vid="MAT 10:2">hagakurikira Yakobo mwene Zebedayo, na mwene nyina Yohana;<verse eid="MAT 10:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 10:3" />hanyuma Filipo na Baruteremi;</para>
  <para style="li1" vid="MAT 10:3">hagasubira Toma na Matayo umutozakori;</para>
  <para style="li1" vid="MAT 10:3">Yakobo mwene Alufayo, na Tadeyo;<verse eid="MAT 10:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 10:4" />Simoni Umuzelote, na Yuda Isikariyote umwe yamugurisha.<verse eid="MAT 10:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Abo cumi na babiri Yesu arabarungika, ababwiye ati: <char style="wj">“Ntimuje mu banyamahanga canke ngo mwinjire mu bisagara vy’i Samariya.</char> <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" /><char style="wj">Ariko, mugende mu ntama zazimiye za Isirayeli.</char> <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" /><char style="wj">Mugende muravuga ubu butumwa muti: ‘Ubwami bw’ijuru buri hafi.’</char> <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" /><char style="wj">Mukize abagwaye, muzure abapfuye, muhumanure abagwaye imibembe, mwirukane abadayimoni. Ivyo mubiherewe ubuntu, namwe mubitangire ubundi.</char><verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />
    <char style="wj">Ntimwitwaze inzahabu canke amahera mu mifuko yanyu.</char> <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" /><char style="wj">Ntimutware amasakoshi y’impuzu canke ibirato vyo gukuranya, mbere ntimwitwaze n’inkoni yo kwishimikiza; kandi ntimwanke ko babaha indaro, kuko umukozi wese aberwa n’impembo.</char> <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" /><char style="wj">Igisagara cose canke umuhana muzokwinjiramwo, muze murondere uwubereye kwakira abantu, hanyuma mugume mu nzu iwe kugeza mugiye.</char> <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" /><char style="wj">Nimwinjira muri iyo nzu, muze muyiramutse muyihezagira.</char> <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" /><char style="wj">Niyaba ibikwiye, umuhezagiro wanyu uzoguma kuri yo; niyaba itabikwiye, umuhezagiro wanyu uzobagarukako.</char> <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" /><char style="wj">Aho bazokwanka kubakira no kwumviriza amajambo yanyu, muze mukunkumure umukungugu wo mu birenge vyanyu, maze muve muri iyo nzu canke muri ico gisagara.</char> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" /><char style="wj">Ndababwire ukuri, ku musi w’imanza, ibisagara vya Sodomu na Gomora bizogira agahengekerezo kurusha ico gisagara.</char><verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />
    <char style="wj">Ndabarungitse nk’intama mu bikoko vy’inkazi. None rero, mukerebuke nk’inzoka kandi mwitonde nk’inuma.</char> <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" /><char style="wj">Mumenye neza ko bazobashengeza imbere y’abacamanza kandi ko bazobakubitira mu masinagogi yabo.</char> <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" /><char style="wj">Muzohagarara imbere y’abatware n’abami muzira kuba abigishwa banje, kugira ngo munshingire intahe imbere yabo n’imbere y’abanyamahanga.</char> <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" /><char style="wj">Ariko nibabafata, ntimuze muhagarikwe imitima n’ivyo muzovuga n’uburyo muzobivuga. Ako kanya nyene, muzohabwa ivyo mukwiye kuvuga,</char> <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" /><char style="wj">kuko mutazovuga ivyo mwigeneye, ariko muzovuga ivyo muhawe na Mpwemu wa So azoba abavugiramwo.</char><verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />
    <char style="wj">Umuntu azotanga uwo bavukana ngo bamwice, n’umuvyeyi agirire umwana wiwe uko. Abana bazogarariza abavyeyi babo banabicishe.</char> <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" /><char style="wj">Muzokwankwa n’abantu bose babampora. Ariko uwuzokwihangana gushitsa kw’iherezo azokizwa.</char> <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" /><char style="wj">Nibabahama mu gisagara kimwe, muze muhungire mu kindi. Ndababwira ukuri ko mutazoheza kugendagenda mu bisagara vyose vya Isirayeli Umwana w’Umuntu ataraza.</char><verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />
    <char style="wj">Umwigishwa ntaruta umwigisha, n’umukozi ntaruta shebuja.</char> <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" /><char style="wj">Umwigishwa akwiye kugera aho amera nk’umwigisha wiwe, kandi umukozi akwiye kugera aho amera nka shebuja. Nimba umukuru w’inzu bamwise Beyelizebuli, mbega abo mu nzu yiwe ntibazorushiriza kubita gutyo!</char><verse eid="MAT 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />
    <char style="wj">Nuko rero, ntimubatinye, kuko ata cagizwe ibanga kitazomenyekana kandi ata canyegejwe kitazoshirwa ahabona.</char> <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" /><char style="wj">Ivyo ndababwirira ahatabona, mubivugire ahabona; ivyo ndabongorera mu matwi, mubivugire hejuru ku mazu.</char> <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" /><char style="wj">Ntimugatinye abashobora kwica umubiri ariko badashobora kwica ubugingo. Ahubwo, mutinye Imana, kuko yo ishobora guhonya ubugingo n’umubiri, ikabita muri Gehinomu.</char> <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" /><char style="wj">Mbega utunyoni tubiri ntitugurwa ubusa bw’amahera? Ariko nta na kamwe muri two gakorokera hasi So wo mw’ijuru atavyemeye.</char> <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" /><char style="wj">Mbere n’imishatsi yo ku mitwe yanyu yaraharuwe yose.</char> <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" /><char style="wj">None rero, mweho ntimugire ubwoba; kuko musumvya agaciro utunyoni twinshi.</char><verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />
    <char style="wj">Umuntu wese azonyemanga imbere y’abantu, nanje nzomwemanga imbere ya Data wo mw’ijuru.</char> <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" /><char style="wj">Ariko umuntu wese azonyihakana imbere y’abantu, nanje nzomwihakana imbere ya Data wo mw’ijuru.</char><verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />
    <char style="wj">Ntimwiyumvire ko naje ngo nzane amahoro kw’isi! Haba na mba! Sinazanye amahoro, ahubwo nazanye intambara;</char> <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" /><char style="wj">kuko naje gutuma</char></para>
  <para style="q1" vid="MAT 10:35">
    <char style="wj">‘umuhungu agwanya se,</char></para>
  <para style="q2" vid="MAT 10:35">
    <char style="wj">umukobwa agwanya nyina,</char></para>
  <para style="q1" vid="MAT 10:35">
    <char style="wj">umukazana agwanya inabukwe.</char><verse eid="MAT 10:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36" />
    <char style="wj">Abansi b’umuntu bazoba abo mu rugo iwe.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">10:36 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="MIC 7:6">Mika 7:6</ref>
        </char>
      </char>
    </note><verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />
    <char style="wj">Umuntu wese akunda se canke nyina akabandutisha ntankwiye; uwukunda umuhungu wiwe canke umukobwa wiwe akamundutisha, uwo na we nyene ntankwiye.</char> <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" /><char style="wj">Umuntu wese atikorera umusaraba wiwe ngo ankurikire ntankwiye.</char> <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" /><char style="wj">Umuntu wese agerageza kwigumiriza ubuzima azobubura, ariko uwubutanga ku bwanje azoburokora.</char><verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />
    <char style="wj">Umuntu wese abakiriye aba anyakiriye, kandi unyakiriye azoba yakiriye uwantumye.</char> <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" /><char style="wj">Umuntu wese yakiriye umuvugishwa kuko ari umuvugishwa n’Imana, azohabwa ingero ihwanye n’iy’umuvugishwa. Kandi umuntu azokwakira umugororotsi w’Imana kuko agororotse, azohabwa ingero nk’iy’umugororotsi.</char> <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" /><char style="wj">Nihaba uwugira ico aha umuntu mutoya mu bigishwa banje, naho coba igikombe c’amazi apfutse kuko ari umwigishwa wanje, ndababwije ukuri ko atazobura kubihererwa impera.”</char><verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s1">Gukekeranya kwa Yohana</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Yesu ahejeje gusigurira neza abigishwa biwe cumi na babiri igikorwa abatumye, ava ngaho aja kwigisha no kuvuga Ubutumwa Bwiza mu bisagara vy’i Galilaya.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Yohana ari mw’ibohero, yumva ibikorwa Kristo akora, hanyuma amutumako abigishwa biwe kumubaza bati: <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />“Mbega woba uri umwe yategerezwa kuza, canke twitege uwundi?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yesu abishura ati: <char style="wj">“Subira inyuma, mugende mubwire Yohana ivyo mwumvise n’ivyo mubonye:</char> <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" /><char style="wj">abahumye barahumuka, abamugaye baragenda, abanyamibembe barahumanuka, abatumva barumva, abapfuye barazuka, kandi aboro barabwirwa Ubutumwa Bwiza.</char> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" /><char style="wj">Hahiriwe umuntu adatsitazwa n’ivyanje!”</char><verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Abigishwa ba Yohana bamaze kugenda, Yesu atangura kubwira abantu ivyerekeye Yohana, ati: <char style="wj">“Mbega mwagiye kuraba iki mu bugaragwa? Ni irenga rizungagizwa n’umuyaga?</char> <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" /><char style="wj">Nimba atari uko, mwari mwagiye kuraba iki? Umuntu yambaye impuzu z’igiciro kinini? Haba na mba! Abambara impuzu z’igiciro kinini baba mu ngoro z’abami.</char> <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" /><char style="wj">None mwagiye kuraba iki? Uwuvugishwa n’Imana? Ego cane, mbere ndababwiye ko mwagiye kuraba uwuruta uwuvugishwa n’Imana.</char> <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" /><char style="wj">Kuko uwo ni we Ivyanditswe bivugako ngo:</char></para>
  <para style="q1" vid="MAT 11:10">
    <char style="wj">‘Ngira ndungike intumwa yanje imbere yawe</char></para>
  <para style="q2" vid="MAT 11:10">
    <char style="wj">igutegurire inzira.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">11:10 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="MAL 3:1">Malaki 3:1</ref>
        </char>
      </char>
    </note><verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />
    <char style="wj">Ndababwire ukuri, mu bantu bose bavyawe n’abagore, nta wigeze kubaho ahambaye kuruta Yohana Umubatizi. Ariko, umuntu muto musi y’abandi mu Bwami bw’ijuru arahambaye kumuruta.</char> <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" /><char style="wj">Uhereye igihe Yohana Umubatizi yatangura kwigisha kugeza n’ubu, Ubwami bw’ijuru bagenda babugwanira kandi abahizi ni bo babwinjiramwo.</char> <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" /><char style="wj">Kuko ivyanditswe n’abavugishwa bose n’Ivyagezwe vyavuga ivyabwo gushika mu gihe ca Yohana.</char> <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" /><char style="wj">Kandi nimba mushaka kwemera ivyo ndiko ndavuga, ni we Eliya abavugishwa bari baravuze ko azoza.</char> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" /><char style="wj">Uwufise amatwi niyumve.</char><verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />
    <char style="wj">Mbega abantu ba kino gihe nobagereranya n’iki? Bameze nk’abana bicaye mu mayirabiri hanyuma bagahamagara abandi bana, bati:</char><verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />
    <char style="wj">‘Twabavugirije umwironge,</char></para>
  <para style="q2" vid="MAT 11:17">
    <char style="wj">ariko ntimwatamba;</char></para>
  <para style="q1" vid="MAT 11:17">
    <char style="wj">hanyuma tubaririmbira iz’ikigandaro</char></para>
  <para style="q2" vid="MAT 11:17">
    <char style="wj">ntimwarira.’</char><verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />
    <char style="wj">Kuko Yohana yaje atarya kandi atanywa, baca bavuga ngo: ‘Arimwo dayimoni.’</char> <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" /><char style="wj">Umwana w’Umuntu na we aza arya kandi anywa, baca bavuga ngo: ‘Ni umukunzi w’inda kandi ni imborerwa, agendana n’abatozakori n’abandi banyavyaha.’ Ariko icerekana aho ubwenge buri ni ibikorwa biva kuri bwo.”</char><verse eid="MAT 11:19" /></para>
  <para style="s1">Ibara rizoba ku bisagara vyanse kwihana</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Maze Yesu aca atangura kuburira ibisagara yakoreyemwo ibitangaza vyinshi kuko abantu baho banse kwihana, avuga ati: <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" /><char style="wj">“Uzobona ibara yewe Korazini! Uzobona ibara yewe Betesayida! Kuko iyo ibitangaza vyakorewe iwanyu bikorerwa i Tiro n’i Sidoni, abantu baho baba barihanye kuva kera, bakambara amagunira, bakisiga n’iminyota.</char><note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">Kwisiga iminyota cari ikimenyetso co kugandara canke kwihana.</char></note> <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" /><char style="wj">Ni co gituma ndababwiye ko ku musi w’imanza i Tiro n’i Sidoni hazogira agahengekerezo kurusha mwebwe.</char> <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" /><char style="wj">Nawe Kaperinawumu, mbega wibaza ko uzoduzwa ugashika mw’ijuru? Haba na mba! Ahubwo uzokororerwa i kuzimu mu kibanza c’abapfuye, kuko ibitangaza vyakorewe muri wewe iyo biba vyabereye i Sodomu, haba hakiriho kugeza n’uwu musi.</char> <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" /><char style="wj">Ni co gituma ndakubwiye ko ku musi w’imanza i Sodomu hazogira agahengekerezo kurusha wewe.”</char><verse eid="MAT 11:24" /></para>
  <para style="s1">Data yihishuye muri Mwana</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Uwo mwanya Yesu aravuga ati: <char style="wj">“Ndagushima Data, Mwami w’ijuru n’isi, kuko ivyo wabihishije abanyabwenge n’abize, ukabihishurira abameze nk’abana bato.</char> <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" /><char style="wj">Egome Data, kuko uko ari ko washimye kubikora.</char><verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />
    <char style="wj">Data yaranyizigiye anzeza vyose. Nta n’umwe azi Umwana atari Data, kandi nta n’umwe azi Data atari Umwana, n’uwo Umwana ahisemwo kumuhishurira.</char><verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />
    <char style="wj">Nimuze kuri jewe mwese abarushe n’abaremerewe n’imitwaro, ndabaruhura.</char> <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" /><char style="wj">Mwakire umutwaro wanje hanyuma munyigireko kuko ndi umugwaneza kandi nicishije bugufi mu mutima, namwe muzoronka uburuhukiro bw’imitima yanyu.</char> <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" /><char style="wj">Kuko umutwaro wanje urahwahutse kandi ivyo ndabikoreza ntibiremereye.”</char><verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">Yesu ni Umwami w’Isabato</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Hanyuma y’ivyo, Yesu aragenda aca mu mirima y’ingano kandi hari ku musi w’Isabato. Abigishwa biwe bari bashonje, baca batangura guca imitwe y’ingano zeze, barazivungura, bakuramwo intete barazirya. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Abafarisayo babibonye, baramubwira bati: “Ehe raba abigishwa bawe bariko bakora ikizira ku musi w’Isabato!”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Yesu arabishura ati: <char style="wj">“Mbega ntimurasoma ivyo Dawidi yakoze igihe we n’abo bari kumwe bari bashonje?</char> <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" /><char style="wj">Yinjiye mu nzu y’Imana, arya imikate yashikaniwe Imana, yongera ahako n’abari kumwe na we; kandi abaherezi ari bo bonyene bari bemerewe kuyirya.</char> <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" /><char style="wj">Canke mbega ntimurasoma mu Vyagezwe ingene abaherezi batubahiriza umusi w’Isabato, iyo bariko barakora ibikorwa vyabo vyo mu rusengero kandi ntibabe bakoze icaha?</char> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" /><char style="wj">Ariko ndababwire, hano hari uwurengeye urusengero!</char> <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" /><char style="wj">Iyo muba mutahura ijambo rivuga ngo: ‘Nshaka ko mugira imbabazi kuruta kumpa ibimazi,’</char><note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 6:6">Hoseya 6:6</ref></char></char></note> <char style="wj">ntimwari gutsindisha abatagira icaha.</char> <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" /><char style="wj">Kuko Umwana w’Umuntu ari Umwami w’Isabato.”</char><verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Avuye ngaho, yinjira mw’isinagogi yabo, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />ahasanga umuntu akongataye ukuboko. Mu kurondera ico bafatirako kugira ngo bamwagirize, baramubaza bati: “Mbega biremewe gukiza umuntu ku musi w’Isabato?”<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Na we arabishura ati: <char style="wj">“Muri mwebwe uwoba afise intama imwe hanyuma ikagwa mu kinogo ku musi w’Isabato, ntiyoyikurayo?</char> <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" /><char style="wj">Namwe murazi neza ko umuntu afise agaciro karengeye ak’intama! Ni co gituma vyemewe gukora iciza ku musi w’Isabato.”</char><verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Hanyuma aca abwira uwo muntu ati: <char style="wj">“Gorora ukuboko kwawe.”</char> Akugoroye guca kurakira neza kumera nk’ukundi. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Abafarisayo baca baragenda baja kugira inama y’ingene bokwica Yesu.<verse eid="MAT 12:14" /></para>
  <para style="s1">Umukozi yatoranijwe n’Imana</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Yesu abimenye aca ava ngaho, maze abantu benshi baramukurikira, akiza abagwaye bose bari muri bo, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />ariko arabihanikiriza ngo ntihagire abandi babwira uwo ari we. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Ivyo vyabaye kugira ngo ivyo uwavugishwa n’Imana Yesaya yavuze bishike, aho yavuze ati:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Ng’uwu umukozi wanje natoranije,</para>
  <para style="q2" vid="MAT 12:18">uwo nkunda kandi umutima wanje unezerererwa.</para>
  <para style="q1" vid="MAT 12:18">Nzomushirako Mpwemu wanje,</para>
  <para style="q2" vid="MAT 12:18">na we azomenyesha amahanga ivy’ubutungane.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Ntazotongana canke ngo avuze urwamo;</para>
  <para style="q2" vid="MAT 12:19">nta n’umwe azokwumva ijwi ryiwe mu mabarabara.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Irenga rivunitse ntazorihohosha,</para>
  <para style="q2" vid="MAT 12:20">kandi n’urumuri rwaka buhoro ntazoruzimya,</para>
  <para style="q1" vid="MAT 12:20">kandi ivyo azobikora kugeza ubutungane busasagaye.<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />Amahanga azokwizigira izina ryiwe.”<note caller="+" style="f"><char style="fr" closed="false">12:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 42:1-4">Yesaya 42:1-4</ref></char></char></note><verse eid="MAT 12:21" /></para>
  <para style="s1">Yesu akiza impumyi y’ikiragi</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Hanyuma bamuzanira umuntu aboshwe n’umudayimoni amutera kutabona n’uburagi. Nuko Yesu akiza uwo muntu, aca aravuga kandi arabona. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Maze abantu benshi bari aho baratangara cane, baca batangura kubazanya bati: “Mbega uwu yoba ari wa Mwana wa Dawidi?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Ariko Abafarisayo bavyumvise baca bavuga bati: “Uwo nta kindi kimushoboza kwirukana abadayimoni atari Beyelizebuli, umukuru w’abadayimoni.”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Yesu amenye ivyiyumviro vyabo, aca ababwira ati: <char style="wj">“Ubwami bwose iyo bwiciyemwo ibice buba bugiye gusenyuka. Kandi iyo igisagara canke umuryango vyiciyemwo ibice ntibishobora kurama.</char> <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" /><char style="wj">Nimba Satani yirukana Satani akicamwo ibice, none ubwami bwiwe bworama bute?</char> <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" /><char style="wj">Canke nimba Beyelizebuli ari we anshoboza kwirukana abadayimoni, abigishwa banyu bo babishobozwa na nde? Ni co gituma ari bo bazobatsindisha.</char> <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" /><char style="wj">Ariko nimba ari Mpwemu w’Imana anshoboza kwirukana abadayimoni, noneho Ubwami bw’Imana bwashitse muri mwebwe.</char><verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />
    <char style="wj">Ikindi, umuntu yoshobora ate kwinjira mu nzu y’umunyenkomezi ngo amunyage ivyo atunze atabanje kumuboha? Aho ni ho honyene ashobora kwinjira mu nzu akamunyaga ivyiwe.</char><verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />
    <char style="wj">Uwutari kumwe nanje wese arangwanya, kandi uwutariko aramfasha kwegeranya wese, aba ariko arasanzaza.</char> <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" /><char style="wj">Ni co gituma ndababwira ko icaha ico ari co cose, n’ugutuka Imana ukwo ari kwo kwose abantu bashobora kubiharirwa, ariko gutuka Mpwemu Yera ntibazoshobora kubiharirwa.</char> <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" /><char style="wj">Umuntu wese atuka Umwana w’Umuntu, azobiharirwa; ariko uwutuka Mpwemu Yera ntazobiharirwa, haba muri kino gihe canke mu gihe kizoza.</char><verse eid="MAT 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />
    <char style="wj">Igiti iyo ari ciza n’ivyamwa vyaco biba vyiza, kandi igiti iyo ari kibi n’ivyamwa vyaco biba bibi; kuko igiti cose kimenyekanira ku vyamwa vyaco.</char> <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" /><char style="wj">Mwa bana b’inzoka mwe, mbega mwovuga ivyiza mute kandi muri babi? Erega ivyuzuye mu mutima ni vyo akanwa kavuga.</char> <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" /><char style="wj">Umuntu mwiza akura ivyiza mu bubiko bwiza bw’umutima wiwe, umuntu mubi na we agakura ibibi mu bubiko bubi bw’umutima wiwe.</char> <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" /><char style="wj">Ariko ndababwira ko ku musi w’imanza, umuntu wese azobazwa ijambo ryose ritagira ikimazi yavuze.</char> <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" /><char style="wj">Amajambo yawe ni yo azotuma utsinda canke utsindwa n’urubanza.”</char><verse eid="MAT 12:37" /></para>
  <para style="s1">Basaba Yesu ikimenyetso</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Hanyuma bamwe mu Bafarisayo n’abigisha b’ivyagezwe baramubwira bati: “Mwigisha, dushaka ko uduha ikimenyetso cerekana ububasha bwawe.”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Arabishura ati: <char style="wj">“Abantu ba kino gihe bameze nabi kandi b’abasambanyi ni bo basaba ikimenyetso! Ariko nta kindi kimenyetso bazohabwa atari ikimenyetso c’uwavugishwa n’Imana Yona.</char> <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" /><char style="wj">Kuko nk’uko Yona yamaze imisi itatu n’amajoro atatu mu nda y’urufi, ni ko n’Umwana w’Umuntu azomara imisi itatu n’amajoro atatu mu nda y’isi.</char> <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" /><char style="wj">Ku musi wo guca imanza, abantu b’i Ninewe bazohaguruka bagirize abantu ba kino gihe kandi babatsindishe, kuko bo bihanye bamaze kwumva ubutumwa bwa Yona; ariko raba uwuruta Yona ari hano.</char> <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" /><char style="wj">Ku musi wo guca imanza, umwamikazi w’i Sheba azohaguruka yagirize abantu ba kino gihe kandi abatsindishe, kuko yahagurutse akava ku mpera z’isi aje kwumviriza amajambo y’ubwenge ya Salomo; ariko raba uwuruta Salomo ari hano.</char><verse eid="MAT 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />
    <char style="wj">Iyo impwemu ihumanye ivuye mu muntu, ica igenda iyerera mu bugaragwa irondera aho yoruhukira ariko ikahabura.</char> <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" /><char style="wj">Maze, ica ivuga iti: ‘Reka nisubirire muri ya nzu nahoramwo.’ Ishitse, isanga iyo nzu yahoramwo ata kiyibamwo, isukuye kandi itunganije neza.</char> <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" /><char style="wj">Maze ica igenda, ikazana izindi mpwemu mbi indwi ziyirusha ububi, zikinjira muri wa muntu, zikibera ngaho. Ivya nyuma vy’uwo muntu biba bibi kurusha ivya mbere. Uko ni ko bizogenda ku bantu ba kino gihe kibi.”</char><verse eid="MAT 12:45" /></para>
  <para style="s1">Nyina na bene nyina ba Yesu</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Yesu akiriko aravugana n’abantu benshi bari ngaho, nyina na bene nyina baraza bahagarara hanze, bashaka kuvugana na we. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Umuntu umwe araza aramubwira ati: “Nyoko na bene nyoko bahagaze hanze, bashaka kuvugana nawe.”<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Yesu na we amwishura ati: <char style="wj">“Mbega mama ni nde kandi bene mama ni ba nde?”</char> <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Nuko atunga urutoke abigishwa biwe, avuga ati: <char style="wj">“Aba ni bo mama kandi ni bo bene mama.</char> <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" /><char style="wj">Kuko uwukora ivyo Data wo mw’ijuru agomba wese ni we mwene mama, kandi ni we mama.”</char><verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">Umugani w’umubivyi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Uwo musi nyene, Yesu arasohoka ava mu nzu, aja ku nkengera y’ikiyaga, yicaraho. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Maze abantu isinzi baza aho ari, na we aca atambukira mu bwato abwicaramwo; abantu na bo bahagarara ku musenyi. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Maze abigisha vyinshi mu migani, avuga ati: <char style="wj">“Umubivyi yagiye kubiba imbuto ziwe.</char> <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" /><char style="wj">Ariko arabiba, zimwe zigwa i ruhande y’inzira, hanyuma inyoni ziraza zirazinobagura.</char> <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" /><char style="wj">Izindi na zo zigwa ku rutare, ahantu hatagira ivu ryinshi; zica zimera ningoga, kuko ivu ryari rike.</char> <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" /><char style="wj">Ariko izuba ryatse, za mbuto zica ziruma kuko imizi yazo itashika kure.</char> <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" /><char style="wj">Izindi mbuto zigwa mu mahwa; zimaze kumera, ayo mahwa arakura arazinyoha.</char> <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" /><char style="wj">Hakaba rero n’imbuto zaguye mw’ivu ryiza, ziramera, zirakura kandi zirama, zimwe zimbuka incuro ijana, izindi mirongo itandatu, izindi mirongo itatu.</char> <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" /><char style="wj">Uwufise amatwi niyumve!”</char><verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Abigishwa biwe baramwegera baramubaza bati: “Ni kuki wigisha abantu ukoresheje imigani?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Yesu arabishura ati: <char style="wj">“Ni mwebwe mwahawe kumenya amabanga y’ivy’Ubwami bw’ijuru, ariko bo ntibabihawe.</char> <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" /><char style="wj">Uwufise azokwongererezwa asesekarizwe, ariko uwudafise azokwakwa n’ivyo yari afise.</char> <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" /><char style="wj">Ni co gituma ndabigishiriza mu migani,</char></para>
  <para style="q1" vid="MAT 13:13">
    <char style="wj">kugira ngo naho boraba ntibabone;</char></para>
  <para style="q2" vid="MAT 13:13">
    <char style="wj">n’aho bokwumviriza ntibumve canke ngo batahure.</char><verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />
    <char style="wj">Ivyo bishitsa kuri bo ivyo Yesaya yavugishijwe, aho yavuga ati:</char></para>
  <para style="q1" vid="MAT 13:14">
    <char style="wj">‘Kwumva muzokwama mwumva, ariko ntimuzokwigera mutahura;</char></para>
  <para style="q2" vid="MAT 13:14">
    <char style="wj">kuraba muzokwama muraba ariko ntimuzokwigera mubona.</char><verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />
    <char style="wj">Kuko imitima y’ubu bwoko ikomantaye;</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">amatwi yabo ntashobora kwumva,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">kandi amaso yabo barayahumiriza.</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">Ahandi ho bobonesheje amaso yabo,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">bakumvisha amatwi yabo,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">bagatahurisha imitima yabo,</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">maze bagahindukira nanje nkabakiza.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13:15 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 6:9">Yesaya 6:9</ref>,<ref loc="ISA 6:10">10</ref></char>
      </char>
    </note><verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />
    <char style="wj">Ariko hahiriwe amaso yanyu kuko abona, n’amatwi yanyu kuko yumva.</char> <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" /><char style="wj">Kuko ndababwire ukuri, abavugishwa n’Imana n’abagororotsi benshi baripfuje kubona ivyo muriko murabona ariko ntibabibona, no kwumva ivyo muriko murumva, ariko ntibavyumva.</char><verse eid="MAT 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />
    <char style="wj">Nimwumvirize ico umugani w’umubivyi usigura:</char> <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" /><char style="wj">Iyo umuntu yumvise ubutumwa bw’Ubwami, hanyuma ntabutahure, wa mubi aca aza akanyakura icari cabibwe mu mutima wiwe. Izo ni zo mbuto zabibwe i ruhande y’inzira.</char> <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" /><char style="wj">Imbuto zabibwe ku rutare zerekana ukuntu abantu bumva ijambo ry’Imana hanyuma bagaca baryakirana umunezero mu mitima yabo.</char> <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" /><char style="wj">Ariko kubera ko iryo jambo ritagira imizi miremire muri bo, bamara umwanya muto bizeye. Iyo baciye mu vyago canke mu guhamwa kubw’iryo jambo ry’Imana, baca bata ukwizera.</char> <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" /><char style="wj">Imbuto zaguye mu mahwa, zerekana umuntu yumva ijambo ry’Imana, ariko imyitwarariko y’ivy’iyi si hamwe n’uruhendo rw’ubutunzi bikaza bikanyoha iryo jambo yumvise bigatuma ata co ryama.</char> <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" /><char style="wj">Ariko imbuto zaguye mw’ivu ryiza ni ikigereranyo c’umuntu yumva ijambo ry’Imana akaritahura. Uwo ni we aheza akama; bamwe bakama incuro ijana, abandi incuro mirongo itandatu, abandi incuro mirongo itatu z’ivyabibwe.”</char><verse eid="MAT 13:23" /></para>
  <para style="s1">Umugani w’urwamfu mu buro</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesu abacira uwundi mugani ati: <char style="wj">“Ubwami bw’ijuru bugereranywa n’umuntu yabivye imbuto nziza y’uburo mu murima wiwe.</char> <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" /><char style="wj">Mw’ijoro, abantu bose bamaze gusinzira, umwansi wiwe araza abiba urwamfu muri bwa buro hanyuma arigira.</char> <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" /><char style="wj">Uburo bumaze gukura, no kuyangika, urwamfu na rwo rutangura kwibonekeza.</char><verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />
    <char style="wj">Abakozi ba nyene umurima baca baramubaza bati: ‘Nyakwubahwa, mbega ntiwari wabivye imbuto nziza; none uru rwamfu rwavuye hehe?’</char><verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />
    <char style="wj">Arabishura ati: ‘Umwansi ni we yakoze ivyo.’</char></para>
  <para style="p" vid="MAT 13:28">
    <char style="wj">Baramubaza bati: ‘None urashaka ko tuja kururandura?’</char><verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />
    <char style="wj">Arabishura ati: ‘Oya, kuko mu kurandura urwamfu mwohava murandurana n’uburo.</char> <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" /><char style="wj">Reka vyose bikurane kugeza umusi wo kwimbura. Ico gihe nzobwira abimbuzi babanze begeranye urwamfu barutekere mu mikama hanyuma baruturire, maze uburo babwimburire mu kigega canje.’ ”</char><verse eid="MAT 13:30" /></para>
  <para style="s1">Umugani w’akabuto gato n’umwambiro</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Abacira uwundi mugani ati: <char style="wj">“Ubwami bw’ijuru bugereranywa n’akabuto k’igiterwa citwa mutaride umuntu yateye mu murima wiwe.</char> <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" /><char style="wj">Naho ari gatoya kurusha izindi mbuto zose, iyo kameze karakura, kakaruta ibindi biterwa vyose vyo mw’itongo, maze kagahinduka igiti kinini, ku buryo n’inyoni zo mu kirere ziza zikarika mu mashami yaco.”</char><verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Yongera abacira uwundi mugani ati: <char style="wj">“Ubwami bw’ijuru bugereranywa n’umwambiro umugore akoresha mu gukora imikate. Naho yokoresha umwambiro muke mw’ifu ingana n’ingero zitatu</char><note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">Ni nk’ibilo 27.</char></note> <char style="wj">, uwo mwambiro muke utuma igikandu cose c’umukate gikakama.”</char><verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Ivyo vyose Yesu yabibwira abantu mu migani; nta kintu na kimwe yababwira adakoresheje imigani. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Uko ni ko ivyo uwavugishwa n’Imana yavuze vyashitse, ngo:</para>
  <para style="q1" vid="MAT 13:35">“Nzokwugurura akanwa kanje mu migani,</para>
  <para style="q2" vid="MAT 13:35">mvuge ivyagizwe amabanga kuva isi ikiremwa.”<note caller="+" style="f"><char style="fr" closed="false">13:35 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 78:2">Zaburi 78:2</ref></char></char></note><verse eid="MAT 13:35" /></para>
  <para style="s1">Yesu asigura umugani w’urwamfu</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Hanyuma Yesu asiga abantu ngaho, yinjira mu nzu. Abigishwa biwe baza aho ari, bamubwira bati: “Dusigurire umugani w’urwamfu mu murima.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Arabishura ati: <char style="wj">“Uwabivye imbuto nziza ni Umwana w’Umuntu.</char> <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" /><char style="wj">Umurima ni iyi isi, imbuto nziza ni abana b’Ubwami. Urwamfu ni abana ba wa mubi.</char> <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" /><char style="wj">Umwansi yabivye urwamfu ni Satani. Iyimbura ni umuhero w’isi; abimbuzi ni abamarayika.</char><verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />
    <char style="wj">Nk’uko begeranya urwamfu kugira ngo baruturire, ni ko bizomera ku muhero w’isi.</char> <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" /><char style="wj">Umwana w’Umuntu azotuma abamarayika biwe, bakure abazana ibitsitaza hamwe n’abakora ibibi bose mu Bwami bwiwe;</char> <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" /><char style="wj">babaterere mw’itanure ryaka umuriro; ni ho hazoba amarira no guhekenya amenyo kubera umubabaro.</char> <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" /><char style="wj">Ariko abagororotsi bazokwakaka nk’izuba mu Bwami bwa Se wo mw’ijuru. Uwufise amatwi niyumve.</char><verse eid="MAT 13:43" /></para>
  <para style="s1">Imigani y’ubutunzi buhishijwe n’ibuye ry’agaciro</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />
    <char style="wj">Ubwami bw’ijuru bugereranywa kandi n’ubutunzi buhishijwe mw’itongo. Umuntu umwe yabuserutseko, aca yongera arabuhisha. Hanyuma kubera umunezero mwinshi, aragenda ashora ivyo yari afise vyose, agura iryo tongo.</char><verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />
    <char style="wj">Kandi Ubwami bw’ijuru bugereranywa n’umudandaza yagiye kurondera amabuye y’agaciro.</char> <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" /><char style="wj">Abonye irirusha agaciro ayandi, aca aragenda ashora ivyo yari afise vyose, ararigura.</char><verse eid="MAT 13:46" /></para>
  <para style="s1">Umugani w’urusenga</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />
    <char style="wj">Ubwami bw’ijuru bugereranywa n’urusenga rwaterewe mu kiyaga, rufata ifi z’ubwoko bwose.</char> <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" /><char style="wj">Rumaze kwuzura, abarovyi barukwegera i musozi, baricara batoranya ifi nziza bazishira mu masandugu, ifi mbi na zo barazita.</char> <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" /><char style="wj">Uko ni ko bizogenda ku muhero w’isi. Abamarayika bazosobanura abanyakibi mu bagororotsi,</char> <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" /><char style="wj">babaterere mw’itanure ryaka umuriro, ni ho hazoba amarira no guhekenya amenyo kubera umubabaro.”</char><verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yesu abaza abigishwa biwe ati: <char style="wj">“Mbega ivyo murabitahura?”</char></para>
  <para style="p" vid="MAT 13:51">Na bo bati: “Egome.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Na we arababwira ati: <char style="wj">“Ni co gituma umwigisha wese w’ivyagezwe, iyo ahindutse umwigishwa w’Ubwami bw’ijuru, agereranywa n’umuntu yinjira mu nzu yiwe, agakura mu bubiko bwiwe ivyiza bishasha bibitsweyo hamwe n’ivya kera.”</char><verse eid="MAT 13:52" /></para>
  <para style="s1">Ab’i Nazareti banka kwizera Yesu</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Yesu ahejeje kwigishiriza muri iyo migani, aca ava ngaho. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Ashitse mu gisagara yakuriyemwo, atangura kwigishiriza abantu mw’isinagogi yabo. Abamwumvirije bose baratangara, barabazanya bati: “Mbega ubwo bwenge n’ubwo bushobozi bwo gukora ibitangaza yabikuye he? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Mbega uwu si wa muhungu w’umubaji? Nyina ntiyitwa Mariya; abo bavukana si Yakobo, Yosefu, Simoni na Yuda? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Bashikiwe bose ntitubana? None ivyo vyose yabikuye hehe?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Maze ivyiwe birabatsitaza, bituma batamwizera.</para>
  <para style="p" vid="MAT 13:57">Yesu arababwira ati: <char style="wj">“Uwuvugishwa n’Imana arubahwa hose kiretse iwabo no mu muryango wiwe.”</char><verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Aho hantu Yesu ahakorera ibitangaza bike kuko abantu baho ata kwizera bari bafise.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">Herode Antipa yica Yohana Umubatizi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Muri ico gihe, Herode Antipa yumva amakuru ya Yesu; <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />aca abwira abagendanyi biwe ati: “Uwo ategerezwa kuba ari Yohana Umubatizi yazutse mu bapfuye! Ni co gituma afise ubushobozi bwo gukora ibitangaza.”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Kuko Herode Antipa yari yarafashe Yohana, aramuboha, amuta mw’ibohero. Kandi ivyo yabikoze abitumwe na Herodiya uwo yari yararongoye, yahora ari umugore w’uwo bavukana yitwa Filipo. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Yohana yama abwira Herode ati: “Ntivyemewe ko urongora uwo mugore.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Herode na we yama agomba kwica Yohana ariko agatinya abantu, kuko babona Yohana nk’uwuvugishwa n’Imana.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Ku musi mukuru wo kwibuka ivuka rya Herode, umukobwa wa Herodiya araza atambira abatumire, maze ivyo binezereza Herode cane, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />bituma amusezeranira ashizeko n’indahiro ko amuha ico amusaba cose. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Uwo mukobwa amaze kwoshwa na nyina wiwe, abwira Herode ati: “Ndasavye umpere kuri iyi siniya umutwe wa Yohana Umubatizi.” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Maze umwami Herode arababara cane kubera ivyo yavuze, ariko kubera indahiro yari yarahiriye imbere y’abatumire biwe, avuga ko uwo mukobwa bamuha ico asavye. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Nuko arungika umuntu asanga Yohana Umubatizi mw’ibohero, amuca umutwe, <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />awuzana kw’isiniya, awuha wa mukobwa, na we awushira nyina. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Abigishwa ba Yohana baraza batora ikiziga ciwe baja kugihamba, hanyuma baragenda babwira Yesu ivyabaye.<verse eid="MAT 14:12" /></para>
  <para style="s1">Yesu ahaza abantu ibihumbi bitanu</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Yesu amaze kuvyumva, aca ava ngaho agenda n’ubwato, aja ahantu hiherereye. Ariko abantu bamaze kumenya iyo yagiye, bava mu bisagara bagenda n’amaguru baramukurikira. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Yesu amaze kuva mu bwato abona abantu isinzi, bamutera akagongwe, aca abakiriza abagwaye.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Bugorovye, abigishwa biwe baza aho ari bamubwira bati: “Aha hantu turi ni mu gahinga kandi buriko burira. Rungika aba bantu bagende mu mihana bigurire ivyo barya.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yesu arabishura ati: <char style="wj">“Ntibikenewe ko bagenda. Ba ari mwebwe mubagaburira.”</char><verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Baramwishura bati: “Aha dufise imikate itanu n’ifi zibiri gusa.”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Arababwira ati: <char style="wj">“Nimubinzanire.”</char> <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Hanyuma abwira abantu ngo bicare mu vyatsi. Maze afata ya mikate itanu na za fi zibiri, araba mw’ijuru, abishimira Imana. Hanyuma amanyagura ya mikate, vyose abihereza abigishwa biwe na bo babiha abo bantu. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Bose bararya kandi barahaga. Hanyuma abigishwa begeranya ibiseke cumi na bibiri vyuzuye utumanyu twasigaye. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Abariye bari abagabo nk’ibihumbi bitanu, udashizemwo abagore n’abana.<verse eid="MAT 14:21" /></para>
  <para style="s1">Yesu agendagenda ku mazi</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Ubwo nyene Yesu abwira abigishwa biwe ngo baje mu bwato babe baragenda bamwitangire imbere mu kujabuka, na we asigare arasezera abantu. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Amaze gusezera abantu, aca aduga umusozi wenyene aja gusenga, maze burira akiri ngaho wenyene. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Ubwato bumaze kugenda urugendo rutari ruto buva ku nkengera, haza umuyaga ubaturutse imbere, ubwato buzungazungishwa n’imipfunda iteye ubwoba.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Buri hafi guca, Yesu aza aho bari agendera ku mazi. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Abigishwa biwe bamubonye agendagenda ku mazi, bagira ubwoba bwinshi, barataka bavuga bati: “Ni umuzimu.”<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Ariko Yesu arababwira ati: <char style="wj">“Humura! Ni jewe; ntimugire ubwoba.”</char><verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Petero aca avuga ati: “Mwami, nimba ari wewe, mbwira nze aho uri, ngendagenda ku mazi.”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Yesu aca amubwira ati: <char style="wj">“Ingo.”</char></para>
  <para style="p" vid="MAT 14:29">Petero ava mu bwato, atangura kugendagenda ku mazi aja iyo Yesu ari. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ariko abonye ko umuyaga ari mwinshi, agira ubwoba bwinshi. Atanguye kudobera mu mazi, arasemerera ati: “Mwami, ntabara!”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Ubwo nyene, Yesu atuma ukuboko aramufata, amubwira ati: <char style="wj">“Wa muntu w’ukwizera guke, ni kuki wakekeranije?”</char><verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Maze baca batambukira mu bwato, umuyaga uca urahagarara. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Abari mu bwato bose bamuha icubahiro, bavuga bati: “Ni ukuri uri Umwana w’Imana.”<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Bamaze kujabuka, bashika hakurya ahitwa Genezareti. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Abantu baho bamenye ko ari Yesu, baca babimenyesha abo muri ako karere bose, na bo bamuzanira ababo bagwaye. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Baramwinginga ngo yemerere abagwaye bapfume bakora no ku musozo w’impuzu yiwe, kandi abamukorako bose baca bakira.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">Ibihumanya n’ibidahumanya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Hanyuma Abafarisayo n’abigisha b’ivyagezwe bava i Yerusalemu baja iyo Yesu ari, baramubaza bati: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Ni kuki abigishwa bawe batubahiriza imigenzo ya ba sogokuruza? Ntibakaraba imbere yo gufungura!”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yesu arabishura ati: <char style="wj">“None mwebwe ni kuki mutubahiriza ibwirizwa ry’Imana mwitwaje imigenzo yanyu?</char> <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" /><char style="wj">Kuko Imana yavuze iti: ‘Wubahe so na nyoko,’</char><note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12">Kuvayo 20:12</ref>; <ref loc="DEU 5:16">Gusubiramwo 5:16</ref></char></char></note> <char style="wj">yongerako iti: ‘Umuntu wese azovuma se canke nyina aze yicwe.’</char><note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 21:17">Kuvayo 21:17</ref>; <ref loc="LEV 20:9">Abalewi 20:9</ref></char></char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" /><char style="wj">Ariko mweho muvuga ko iyo umuntu avuze kw’ivyo yari gufashisha se canke nyina ari inyegu y’Imana</char> <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" /><char style="wj">ataba agikwiye kubibafashisha. Uko ni ko muhindura ijambo ry’Imana ubusa kubera imigenzo yanyu.</char> <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" /><char style="wj">Mwa ndyarya mwe, Yesaya yavuze ukuri igihe yabavugishwako ati:</char><verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />
    <char style="wj">‘Aba bantu banyubahisha iminwa yabo,</char></para>
  <para style="q2" vid="MAT 15:8">
    <char style="wj">ariko imitima yabo iri kure yanje.</char><verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />
    <char style="wj">Ukunsenga kwabo ntikugira ikimazi;</char></para>
  <para style="q2" vid="MAT 15:9">
    <char style="wj">inyigisho zabo ni amabwirizwa abantu bishingiye.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">15:9 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 29:13">Yesaya 29:13</ref>
        </char>
      </char>
    </note>
    <char style="wj">”</char><verse eid="MAT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Yesu aca ahamagara isinzi ry’abantu bari ngaho, arababwira ati: <char style="wj">“Nimwumvirize kandi mutahure:</char> <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" /><char style="wj">Icinjira mu kanwa k’umuntu, si co kimuhumanya. Ariko ikiva mu kanwa kiwe, ni co kimuhumanya.”</char><verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Hanyuma abigishwa biwe baza aho ari, baramubaza bati: “Mbega urazi ko Abafarisayo bababaye bumvise ivyo uhejeje kuvuga?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Yesu arabishura ati: <char style="wj">“Igiterwa cose Data wo mw’ijuru atateye kizorandurwa.</char> <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" /><char style="wj">Nimubareke; ni impumyi zirongora izindi! Kandi iyo impumyi irongoye iyindi, bompi bagwa mu kinogo.”</char><verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Petero aramubwira ati: “Dusigurire uwo mugani.”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Yesu arababaza ati: <char style="wj">“Namwe ntimurashobora gutahura?</char> <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" /><char style="wj">Ntimuzi ko ikintu cose cinjira mu kanwa kija mu nda hanyuma kigasohoka?</char> <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" /><char style="wj">Ariko igisohoka giciye mu kanwa k’umuntu kiba kivuye mu mutima, kandi ni co kimuhumanya.</char> <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" /><char style="wj">Kuko mu mutima ari ho hava ivyiyumviro bibi: ubwicanyi, ubusambanyi, ivy’isoni nke, ubusuma, kubeshera abandi no kuvuga abandi nabi.</char> <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" /><char style="wj">Ivyo ni vyo vyanduza umuntu. Ariko kurya udakaravye, ntibishobora kwanduza umuntu.”</char><verse eid="MAT 15:20" /></para>
  <para style="s1">Ukwizera kw’Umunyakananikazi</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yesu avuye ngaho, aja mu ntara ya Tiro na Sidoni. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Umunyakananikazi wo muri iyo ntara, aza aho ari atakamba ati: “Mwami, Mwana wa Dawidi, ngirira imbabazi! Umukobwa wanje aboshwe n’umudayimoni kandi aramubabaje cane!”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Ariko Yesu ntiyamwishura n’ijambo na rimwe. Abigishwa biwe baraza barambwira bati: “Mwirukane kuko aguma avugiriza induru inyuma yacu.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Nuko Yesu abwira wa mugore ati: <char style="wj">“Natumwe ku ntama zazimiye za Isirayeli gusa.”</char><verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Wa mugore aca araza apfukama imbere yiwe, aramubwira ati: “Mwami, ntabara!”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Yesu aramwishura ati: <char style="wj">“Si vyiza gufata umukate w’abana ukawuterera utubwa.”</char><verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Na we aramwishura ati: “Ni vyo, Mwami, ariko n’utubwa na two turemerewe kurya utuvunguka dukoroka tuva ku meza ya ba shebuja.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Yesu aca amubwira ati: <char style="wj">“Mupfasoni, ufise ukwizera gukomeye! Ivyo usavye urabihawe.”</char> Maze ako kanya nyene, umukobwa wiwe aca arakira.<verse eid="MAT 15:28" /></para>
  <para style="s1">Yesu ahaza abantu ibihumbi bine</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Nuko Yesu ava ngaho, agendagenda ku nkengera y’ikiyaga Galilaya. Hanyuma aduga umusozi, yicaraho. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Maze abantu isinzi baza aho ari, bazanye abacumbagira, impumyi, ibimuga, ibiragi n’abandi barwayi benshi. Babashira imbere yiwe, na we arabakiza. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Abantu baratangara cane babonye abaragi bavuga, abacumbagira bagenda neza, abamugaye bamuguruka, n’abahumye bahumuka. Maze bahimbaza Imana ya Isirayeli.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yesu ahamagara abigishwa biwe arababwira ati: <char style="wj">“Aba bantu banteye ikigongwe. Tumaranye imisi itatu none raba nta vyokurya basigaranye. Ninabarungika bashonje, bahava bagwira isari mu nzira.”</char><verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Abigishwa biwe baramubaza bati: “None twokura hehe ivyokurya bikwiye abantu bangana gutya muri kano gahinga?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Yesu arababaza ati: <char style="wj">“Mufise imikate ingahe?”</char></para>
  <para style="p" vid="MAT 15:34">Na bo baramwishura bati: “Dufise imikate indwi hamwe n’udufi dukeya.”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Aca abwira abantu ngo bicare hasi. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Hanyuma afata ya mikate indwi na twa dufi, abishimira Imana, arabimanyagura, maze abiha abigishwa biwe na bo babigaburira abo bantu. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Bose bararya barahaga, hanyuma abigishwa begeranya ibiseke indwi vyuzuye utumanyu twasigaye. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Abariye uwo musi bari ibihumbi bine, udashizemwo abagore n’abana. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Yesu amaze gusezera abantu, atambukira mu bwato, aja mu ntara ya Magadani.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">Basaba ikimenyetso Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Abafarisayo n’Abasadukayo baza aho Yesu ari bazanywe no kumugeza, bamusaba ngo abereke ikimenyetso kivuye mw’ijuru cerekana ububasha bwiwe.<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />Arabishura ati: <char style="wj">“Iyo bugorovye, muravuga muti: ‘Ejo ikirere kizoba ari ciza kuko ijuru ritukuye,’</char> <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" /><char style="wj">kandi iyo bukeye, muravuga muti: ‘Uno musi ikirere ntikiza kuba ciza kuko ijuru ryiraburaniwe.’ Murazi kugenzura ikirere mukurikije uko ijuru risa, ariko ntimuzi kugenzura ibimenyetso vy’ibihe.</char> <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" /><char style="wj">Abantu ba kino gihe bameze nabi kandi b’abasambanyi ni bo basaba ikimenyetso! Ariko nta kindi kimenyetso bazohabwa atari ikimenyetso c’uwavugishwa n’Imana Yona.”</char> Maze Yesu aca abasiga ngaho arigira.<verse eid="MAT 16:4" /></para>
  <para style="s1">Umwambiro w’Abafarisayo n’Abasadukayo</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Bashitse hakurya y’ikiyaga, abigishwa biwe basanga bibagiye gutwara imikate. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yesu arababwira ati: <char style="wj">“Mube maso, mwirinde umwambiro w’Abafarisayo n’Abasadukayo.”</char><verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Maze abigishwa bavugana hagati yabo bati: “Ivyo abivuze kubera tutazanye imikate.”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Yesu amenye ivyo bariko baravugana, arababaza ati: <char style="wj">“Mwa bantu b’ukwizera guke, ni kuki muriko muvuga ko mudafise imikate?</char> <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" /><char style="wj">Mbega n’ubu ntimuratahura? Ntimwibuka ya mikate itanu yagaburiwe abantu ibihumbi bitanu, na vya biseke mwegeranya?</char> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" /><char style="wj">Canke ya mikate indwi yagaburiwe abantu ibihumbi bine, hamwe na vya biseke mwegeranya?</char> <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" /><char style="wj">Ni kuki mudatahura ko ntariko ndababwira ivyerekeye imikate? Nababwiye nti: Mwirinde umwambiro w’Abafarisayo n’Abasadukayo.”</char> <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Maze babona gutahura ko atariko ababwira kwirinda umwambiro w’imikate, ariko ko bakwiye kwirinda inyigisho z’Abafarisayo n’Abasadukayo.<verse eid="MAT 16:12" /></para>
  <para style="s1">Petero avuga ko Yesu ari Kristo</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Yesu ashitse i Kayisariya mu ntara yatwarwa na Filipo, abaza abigishwa biwe ati: <char style="wj">“Mbega abantu bavuga ko jewe Umwana w’Umuntu ndi nde?”</char><verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Baramwishura bati: “Bamwe bavuga ngo uri Yohana Umubatizi; abandi ngo uri Eliya, abandi na bo ngo uri Yeremiya canke umwe mu bandi bavugishwa.”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Aca arababaza ati: <char style="wj">“None mweho, muvuga ko ndi nde?”</char><verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Simoni Petero aramwishura ati: “Uri Kristo, Umwana w’Imana nzima.”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Yesu nawe aca amubwira ati: <char style="wj">“Uri umuhirwe, Simoni mwene Yona, kuko ivyo ntubihishuriwe n’umuntu buntu afise inyama n’amaraso gusa, ariko ni Data wo mw’ijuru abiguhishuriye.</char> <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" /><char style="wj">Nanje ndakubwiye ko uri Petero; bisigura ‘urutare’, kandi ko kuri urwo rutare, nzohubaka ishengero ryanje, kandi ko n’amarembo y’i kuzimu atazorinesha.</char> <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" /><char style="wj">Nzoguha impfunguruzo z’Ubwami bw’ijuru; ico uzoboha cose kw’isi, kizoba kiboshwe no mw’ijuru, kandi ico uzobohora kw’isi cose, kizoba kibohowe no mw’ijuru.”</char> <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Hanyuma aca yihanikiriza abigishwa biwe ngo ntihagire umuntu n’umwe babwira ko ari we Kristo.<verse eid="MAT 16:20" /></para>
  <para style="s1">Yesu avuga ivyerekeye urupfu rwiwe</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Kuva ico gihe, Yesu atangura kubwira abigishwa biwe ko ategerezwa kuja i Yerusalemu, akababazwa mu buryo bwinshi n’abakuru b’idini, n’abaherezi bakurubakuru, n’abigisha b’ivyagezwe, kandi ko azokwicwa hanyuma akazuka ku musi ugira gatatu.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Petero aramwihereranya, atangura kumwamira ati: “Mwami, ntibikabe! Ivyo ntibikakubeko!”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Yesu arahindukira abwira Petero ati: <char style="wj">“Mva i ruhande Satani, herera inyuma yanje! Uri igitsitaza kuri jewe; kuko ibikuraje ishinga si ivy’Imana, ariko ni ivy’abantu.”</char><verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Hanyuma Yesu abwira abigishwa biwe ati: <char style="wj">“Umuntu wese agomba kuba umwigishwa wanje, ategerezwa kwiheba, akikorera umusaraba wiwe, akankurikira.</char> <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" /><char style="wj">Kuko uwugomba gukiza ubugingo bwiwe azobubura, ariko uwubuheba ku bwanje azoburokora.</char> <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" /><char style="wj">Mbega umuntu vyomumarira iki yungutse ivyo mw’isi vyose, ariko agatakaza ubugingo bwiwe? Canke umuntu yotanga iki kugira ngo acungure ubugingo bwiwe?</char> <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" /><char style="wj">Kuko Umwana w’Umuntu agiye kugaruka ari mu bwiza bwa Se, ari kumwe n’abamarayika biwe, hanyuma ahe impembo umuntu wese ikwiranye n’ivyo yakoze.</char><verse eid="MAT 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 16:28" />
    <char style="wj">Ndababwire ukuri, bamwe mu bahagaze ngaha ntibazopfa batabonye Umwana w’Umuntu aje ari mu bwami bwiwe.”</char><verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">Ugukayangana kwa Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Haheze imisi itandatu, Yesu ajana Petero, Yakobo na mwene nyina Yohana, abadugana ku musozi muremure, ari bonyene. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Bari ngaho, akayanganira imbere yabo, mu maso hiwe hakaka nk’izuba, impuzu ziwe zirahinduka, zirera derere kurya kw’umuco. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Ubwo nyene, baja babona Mose na Eliya bariko bavugana na Yesu.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Petero abwira Yesu ati: “Mwami, bitubereye vyiza kuba hano hantu. Ubikunze, reka ndahashinge amahema atatu: iryawe, irya Mose, n’irya Eliya.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Akiriko aravuga, haza igicu cera derere kirabatwikira. Maze ijwi ryumvikanira muri ico gicu, rivuga riti: “Uwu ni Umwana wanje nkunda cane kandi ampimbara. Nimumwumvirize!”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Abigishwa bumvise iryo jwi, bagira ubwoba bwinshi, bituma bagwa hasi bubamye. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Maze Yesu arabegera abakorako, ababwira ati: <char style="wj">“Nimuve hasi, ntaco mutinya.”</char> <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Bunamuye amaso, ntibagira uwundi babona atari Yesu.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Bariko baramanuka bava kuri uwo musozi, Yesu arabihanikiriza ati: <char style="wj">“Ntihagire umuntu n’umwe mubwira ivyo mwabonye, kugeza Umwana w’Umuntu amaze kuzuka mu bapfuye.”</char><verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Hanyuma abigishwa baramubaza bati: “None ni kuki abigisha b’ivyagezwe bavuga ko Eliya ategerezwa kubanza kuza?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Yesu arabishura ati: <char style="wj">“Ni ukuri, Eliya ategerezwa kubanza kuza kugira ngo asubize vyose mu buryo.</char> <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" /><char style="wj">Ariko ndababwire, Eliya yaramaze kuza, yamara ntibamumenye, ahubwo bamukoreye ivyo bishakiye. Uko ni ko n’Umwana w’Umuntu bagiye kumugirira nabi.”</char> <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Abigishwa baca batahura ko yariko avuga Yohana Umubatizi.<verse eid="MAT 17:13" /></para>
  <para style="s1">Yesu akiza umuhungu aboshwe n’idayimoni</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Bashitse musi y’umusozi, basanga abantu isinzi babarindiriye. Umugabo umwe aramwegera, apfukama imbere yiwe. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />Amubwira ati: “Mwami, girira akagongwe umuhungu wanje, kuko arimwo idayimoni itera intandara kandi arababaye cane. Ni kenshi imuta mu muriro canke mu mazi. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Namuzaniye abigishwa bawe ariko vyabananiye kumukiza.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yesu arabishura ati: <char style="wj">“Yemwe bantu b’iki gihe mutizera kandi mwononekaye mu mitima, nzobana namwe gushika ryari? Nzobihanganira kugeza ryari? Nzanira uwo mwana hano.”</char> <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yesu aca akankamira iyo dayimoni, iva muri uwo mwana, aca akira ako kanya nyene.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Hanyuma biherereye, abigishwa ba Yesu baramubaza bati: “Mbega ni kuki twebwe vyatunaniye kwirukana irya dayimoni?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Yesu arabishura ati: <char style="wj">“Ni kubera ukwizera kwanyu guke. Ndababwire ukuri, iyo muba mwari mufise ukwizera kungana n’akabuto ka mutaride, mwobwira uriya musozi muti: ‘Imuka uve ngaha,’ kandi woca wimuka. Nta kintu na kimwe kitobashobokera.</char> [ <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" /><char style="wj">Ugusenga n’ukwisonzesha ni vyo vyonyene bishobora kwirukana idayimoni nk’irya.”</char>]<note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">Mu nzandiko zimwezimwe za Bibiliya aya majambo ntarimwo.</char></note><verse eid="MAT 17:21" /></para>
  <para style="s1">Yesu avuga ubugira kabiri ivy’urupfu rwiwe</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Umusi umwe, bakoraniye i Galilaya, Yesu abwira abigishwa biwe ati: <char style="wj">“Umwana w’Umuntu agiye gutabwa mu maboko y’abantu.</char> <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" /><char style="wj">Bazomwica, ariko ku musi ugira gatatu azozuka.”</char> Maze ivyo birabababaza cane.<verse eid="MAT 17:23" /></para>
  <para style="s1">Ikori ry’urusengero</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Yesu n’abigishwa biwe bashitse i Kaperinawumu, abatoza ikori ry’urusengero rigizwe na darakuma zibiri baza aho Petero ari, baramubaza bati: “Mbega umwigisha wanyu ntatanga ikori ry’urusengero?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Petero arabishura ati: “Egome araritanga.”</para>
  <para style="p" vid="MAT 17:25">Petero yinjiye mu nzu, Yesu aramwitanga, amubaza ati: <char style="wj">“Wiyumvira iki ga Simoni? Ni ba nde baha abami bo muri iyi isi amakori n’amatagisi? Ni abana babo canke ni abandi bantu?”</char><verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Petero aramwishura ati: “Ni abandi bantu.”</para>
  <para style="p" vid="MAT 17:26">Yesu aramubwira ati: <char style="wj">“Urumva rero ko abana batariha ikori.</char> <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" /><char style="wj">Ariko, kugira ngo ntituboneke nabi imbere y’aba batoza iri kori, genda ku kiyaga utere igera urobe. Ifi ya mbere uza kuroba, uyasamike; maze urayisangamwo igiceri kinini c’ifeza coriha ikori ryawe n’iryanje, uheze ugitange.”</char><verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">Kuba mukuru mu Bwami bw’ijuru</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Muri ico gihe, abigishwa begera Yesu baramubaza bati: “Mbega ni nde mukuru mu Bwami bw’ijuru?”<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Yesu aca ahamagara umwana mutoya, amuhagarika hagati yabo. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Hanyuma ababwira ati: <char style="wj">“Ndababwire ukuri, mudahindutse ngo mumere nk’abana bato, ntimuzokwigera mwinjira mu Bwami bw’ijuru.</char> <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" /><char style="wj">Kandi umuntu wese yicisha bugufi nk’aka kana ni we mukuru mu Bwami bw’ijuru.</char> <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" /><char style="wj">Umuntu wese yakira umwana muto mw’izina ryanje ni jewe aba yakiriye.</char><verse eid="MAT 18:5" /></para>
  <para style="s1">Kwirinda kuba inyanduruko yo gucumura</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />
    <char style="wj">Nihagira umuntu atuma umwe muri aba bato banyizera acumura, ikimukwiye ni uko yoboherwa urusyo kw’izosi, agakororerwa i bwina mu kiyaga.</char> <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" /><char style="wj">Isi iragowe kuko yuzuye ibituma abantu bacumura! Kandi ivyo ntibizokwigera bireka kubaho; ariko aragowe umuntu abizana!</char> <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" /><char style="wj">Nimba ukuboko kwawe canke ukuguru kwawe kugutuma gukora icaha, nuguce ugute kure yawe. Kuko vyokubera vyiza kwinjira mu bugingo budashira ufise ukuboko kumwe canke ukuguru kumwe, hako utererwa mu muriro utazima ufise amaboko yompi n’amaguru yompi.</char> <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" /><char style="wj">Kandi nimba ijisho ryawe rituma ukora icaha, rinogore urite kure yawe, kuko vyokubera vyiza kwinjira mu bugingo budashira ufise ijisho rimwe hako utererwa mu muriro wa Gehinomu ufise amaso yompi.</char><verse eid="MAT 18:9" /></para>
  <para style="s1">Umugani w’intama izimiye</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />
    <char style="wj">Mwirinde ntimugakengere umuntu n’umwe muri aba bato, kuko ndababwira yuko abamarayika babo bama bahanze amaso Data wo mw’ijuru.</char> [ <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" /><char style="wj">Kuko Umwana w’Umuntu yazanywe no gukiza abazimiye.</char>]<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">Mu nzandiko zimwezimwe za Bibiliya aya majambo ntarimwo.</char></note><verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />
    <char style="wj">Mbega ndababaze: umuntu atunze intama ijana hanyuma imwe muri zo ikazimira, yokora iki? Ntiyosiga mirongo icenda n’icenda ku musozi akaja kurondera iyo imwe yazimiye?</char> <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" /><char style="wj">Kandi ayitoye, ndababwira ukuri ko yoyinezererwa cane naho yari asanganywe izindi mirongo icenda n’icenda zitari zazimiye.</char> <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" /><char style="wj">Uko ni ko na So wo mw’ijuru atagomba ko hagira n’umwe muri barya bato azimira.</char><verse eid="MAT 18:14" /></para>
  <para style="s1">Iyo habaye amatati mw’ishengero</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />
    <char style="wj">Mwene So niyagucumurako, ugende umwihereranye muri babiri umwereke icaha yagukoreye. Niyakwumviriza akemera kwihana, uzoba wiyujuje na mwene So.</char> <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" /><char style="wj">Ariko, niyanka kukwumviriza, urondere abandi bene So, ari umwe canke babiri, kugira ngo ukore nk’uko ivyagezwe biri, aho bivuga ngo: ‘urubanza rwose ruze rucibwe habanje kwumvirizwa ivyabona bibiri canke bitatu.’</char><note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 19:15">Gusubiramwo 19:15</ref></char></char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" /><char style="wj">Na bo nyene yanse kubumviriza, ubibwire ishengero; kandi yanse kwumvira ishengero, umufate co kimwe n’uwutizera Imana canke umutozakori yiba.</char><verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />
    <char style="wj">Ndababwire ukuri, ico muzoboha kw’isi cose kizoba kiboshwe no mw’ijuru, kandi ico muzobohora kw’isi cose kizoba kibohowe no mw’ijuru.</char><verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />
    <char style="wj">Kandi, ndababwira ukuri ko babiri muri mwebwe nibahuriza inama kw’isi gusaba ikintu ico ari co cose, Data wo mw’ijuru azokibakorera.</char> <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" /><char style="wj">Kuko aho babiri canke batatu bakoraniye mw’izina ryanje, nanje mba ndi hagati muri bo.”</char><verse eid="MAT 18:20" /></para>
  <para style="s1">Umugani w’umukozi adaharira</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Hanyuma Petero araza abaza Yesu ati: “Mwami, mbega mugenzanje ancumuyeko, nzomuharira kangahe? Incuro indwi?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yesu aramwishura ati: <char style="wj">“Sindababwiye incuro indwi, ariko incuro mirongo indwi kugwiza indwi.</char><verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />
    <char style="wj">Ni co gituma Ubwami bw’ijuru bumeze nk’umwami yagomvye kumenya ubutunzi yabikije abakozi biwe uko bwifashe.</char> <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" /><char style="wj">Agitanguye, bamuzanira umuntu amuheraniye italanto ibihumbi cumi.</char><note caller="+" style="f"><char style="fr" closed="false">18:24 </char><char style="ft" closed="false">Ikigiriki </char><char style="fqa" closed="false">italanto </char><char style="fq" closed="false">ibihumbi cumi</char><char style="ft" closed="false">; italanto 1 yangana n’impembo y’umukozi mu kiringo c’imyaka 20.</char></note> <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" /><char style="wj">Kubera atari ashoboye kumwishura, shebuja ategeka ko umugore wiwe, n’abana bagurishwa hamwe n’ivyo bafise vyose kugira ngo umwenda wiwe wishurwe.</char><verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />
    <char style="wj">Uwo mukozi yikubita imbere ya shebuja aramupfukamira, amubwira ati: ‘Mbabarira unyihanganire, nzokwishura umwenda ndagufitiye wose!’</char> <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" /><char style="wj">Shebuja amutera ikigongwe, amuhebera uwo mwenda wiwe, aramurekura aragenda.</char><verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />
    <char style="wj">Uwo mukozi agisohoka ahura na mugenziwe bakorana amuheraniye idenariyo ijana.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">18:28 </char>
      <char style="ft" closed="false">Ikigiriki </char>
      <char style="fqa" closed="false">idenariyo </char>
      <char style="fq" closed="false">ijana</char>
      <char style="ft" closed="false">; idenariyo 1 yari impembo y’umukozi ku musi (raba <char style="xt"><ref loc="MAT 20:2">20:2</ref></char>).</char>
    </note> <char style="wj">Amufata mw’izosi atangura kumunigura ati: ‘Ndiha umwenda umfitiye ningoga!’</char><verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />
    <char style="wj">Mugenziwe apfukama imbere yiwe, aramwinginga ati: ‘Mbabarira unyihanganire, nzokwishura umwenda ndagufitiye wose!’</char><verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />
    <char style="wj">Ariko aranka. Ahubwo aramujana bamushira mw’ibohero kugira ngo azoveyo arishe umwenda wiwe wose.</char> <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" /><char style="wj">Abakozi bagenziwe babonye ibibaye, barababara baca baja kubwira shebuja ivyabaye vyose.</char><verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />
    <char style="wj">Shebuja avyumvise ahamagara wa mukozi yahebera umwenda munini amubwira ati: ‘Wa mukozi mubi we! Warantakambiye ndaguhebera umwenda wawe wose,</char> <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" /><char style="wj">none ntiwari ukwiye kugirira imbabazi mugenzawe nk’uko nanje nazikugiriye?’</char> <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" /><char style="wj">Maze shebuja aca araraka cane, amuta mw’ibohero kugira ngo azoveyo arishe umwenda wiwe wose.</char><verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />
    <char style="wj">Uko ni ko na Data wo mw’ijuru azobagirira nimutaharira bene So bivuye ku mitima.”</char><verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">Yesu yigisha ku bijanye n’ukwahukana</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Yesu ahejeje kuvuga ivyo, aca ava i Galilaya, amanuka mu ntara ya Yudaya, hakurya y’uruzi Yorodani. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Abantu benshi baramukurikira, akirizayo abagwaye babo.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Bamwe mu Bafarisayo baza aho ari bashaka kumutega umutego, bamubaza bati: “Mbega biremewe ko umugabo yahukana n’umugore wiwe bivuye ku mvo iyo ari yo yose?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Yesu arabishura ati: <char style="wj">“Ntimurasoma ko mu ntango Umuremyi yabaremye ari umugabo n’umugore,</char><note caller="+" style="f"><char style="fr" closed="false">19:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 1:27">Itanguriro 1:27</ref></char></char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" /><char style="wj">hanyuma akavuga ati: ‘Ni co gituma umugabo azosiga se na nyina akabana n’umugore wiwe ubutakivana, maze naho ari babiri bakaba umubiri umwe?’</char><note caller="+" style="f"><char style="fr" closed="false">19:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:24">Itanguriro 2:24</ref></char></char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" /><char style="wj">Gutyo ntibaba bakiri babiri, ahubwo baba babaye umubiri umwe. None rero ico Imana yamatanije, ntihakagire uwukimatanura.”</char><verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Baramubaza bati: “None ni kuki Mose yategetse ko umugabo yandikira umugore urwandiko rwemeza ko bahukanye, hanyuma akamwirukana?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yesu arabishura ati: <char style="wj">“Mose yabemereye kwirukana abagore banyu, kuko imitima yanyu ikomantaye. Ariko mu ntango ntivyari bimeze uko.</char> <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" /><char style="wj">Kandi ndababwire, umuntu wese yirukana umugore atamuhoye ubusambanyi, hanyuma akarongora uwundi, aba asambanye.”</char><verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Abigishwa biwe baramubwira bati: “Aho ho rero nimba ivy’abagabo n’abagore bimeze uko, umuntu yopfuma areka kurongora.”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Yesu arabishura ati: <char style="wj">“Si bose bashobora kwemera iyi nyigisho kiretse abo Imana ibishoboje.</char> <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" /><char style="wj">Kuko hariho bamwe bavutse ari inkone, hari n’ababaye inkone babigizwe n’abandi, hakaba rero n’abahisemwo kutarongora kubera Ubwami bw’ijuru. Uwushobora kuvyemera avyemere.”</char><verse eid="MAT 19:12" /></para>
  <para style="s1">Yesu ahezagira abana bato</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Abavyeyi bamwe bazanye abana babo ngo Yesu abarambikeko ibiganza abasengere. Ariko abigishwa barabakankamira.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Maze Yesu arababwira ati: <char style="wj">“Nimureke abana bato baze aho ndi, ntimubabuze, kuko Ubwami bw’ijuru ari ubw’abameze nka bo.”</char> <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Amaze kubarambikako ibiganza, arabahezagira aca ava ngaho.<verse eid="MAT 19:15" /></para>
  <para style="s1">Ubutunzi n’Ubwami bw’Imana</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Hanyuma haza umusore umwe, aramubaza ati: “Mwigisha, iciza nokora ni ikihe kugira ngo nze ndagwe ubugingo budashira?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Yesu aramwishura ati: <char style="wj">“Ni kuki umbaza ivyerekeye iciza? Umwiza ni umwe. Nimba ugomba kwinjira mu bugingo, kurikiza amabwirizwa.”</char><verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Na we ati: “Amabwirizwa ayahe?”</para>
  <para style="p" vid="MAT 19:18">Yesu aramwishura ati: <char style="wj">“ ‘Ntukice, ntugasambane, ntukibe, ntukagirize abandi ibinyoma,</char> <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" /><char style="wj">wubahe so na nyoko,’</char><note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">Abalewi 19:18</ref></char></char></note> <char style="wj">kandi ‘ukunde mugenzawe nk’uko wikunda.’</char><note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12-16">Kuvayo 20:12-16</ref>; <ref loc="DEU 5:16-20">Gusubiramwo 5:16-20</ref></char></char></note><char style="wj">”</char><verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Wa musore aramwishura ati: “Ayo yose narayakurikije. None ikindi nkwiye gukora ni igiki?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yesu aramwishura ati: <char style="wj">“Nimba ugomba kuba uwutunganye rwose, genda, ugurishe ivyo utunze vyose, maze amahera ukuyemwo uyahe aboro; ni ho uzoronka ubutunzi mw’ijuru. Hanyuma uce uza unkurikire.”</char><verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Uwo musore avyumvise, aca agenda ababaye, kuko yari afise ubutunzi bwinshi cane.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Yesu aca abwira abigishwa biwe ati: <char style="wj">“Ndababwire ukuri, biragoye cane ko abatunzi binjira mu Bwami bw’ijuru.</char> <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" /><char style="wj">Kandi ndabisubiyemwo: vyokworoha ko ingamiya ica mu gatoboro k’urushinge rwo kubarira kurusha ko umutunzi yinjira mu Bwami bw’Imana!”</char><verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Abigishwa bavyumvise baratangara cane, hanyuma baramubaza bati: “None nimba biri uko, ni nde ashobora gukizwa?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yesu arabitegereza, hanyuma ababwira ati: <char style="wj">“Ku bantu ntibishoboka, ariko ku Mana vyose birashoboka.”</char><verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Petero aramwishura ati: “None ko twebwe twasize vyose tukagukurikira, tuzoronka iki?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yesu arababwira ati: <char style="wj">“Ndababwire ukuri, mu gihe c’isi nsha, aho Umwana w’Umuntu azokwicarira ku ntebe yiwe y’icubahiro, mwebwe mwankurikiye, muzoba mwicaye ku ntebe cumi na zibiri, mucira imanza imiryango cumi n’ibiri y’Abisirayeli.</char> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" /><char style="wj">Kandi nta muntu n’umwe yasize inzu, canke abavukanyi, canke se, canke nyina, canke umugore, canke abana, canke amatongo kubera izina ryanje, atazobishumbushwa incuro ijana kandi akaragwa n’ubugingo budashira.</char> <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" /><char style="wj">Ariko benshi mu bari imbere bazoba ab’inyuma, abari inyuma na bo babe ab’imbere.</char><verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">Umugani w’abakozi bo mu murima</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />
    <char style="wj">Ubwami bw’ijuru bugereranywa n’umuntu yari afise umurima w’uruzabibu, hanyuma azinduka kare aja kurondera abakozi bamukorera muri uwo murima.</char> <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" /><char style="wj">Maze bumvikana ko aja kubahemba idenariyo imwe</char><note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">Iyo yari ingero y’umukozi ku musi.</char></note> <char style="wj">kuri uwo musi, hanyuma arabarungika mu ruzabibu rwiwe.</char><verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />
    <char style="wj">Nk’isaha zitatu zo mu gitondo, arongera aragenda abona abandi bahagaze mu mayirabiri ata co bariko barakora.</char> <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" /><char style="wj">Arababwira ati: ‘Namwe nimugende mukore mu murima wanje, ndabaha impembo mukwiranye.’</char> <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" /><char style="wj">Maze baja mu murima wiwe.</char></para>
  <para style="p" vid="MAT 20:5">
    <char style="wj">Nyene umurima yongera aragenda nk’isaha zitandatu n’isaha icenda, akora kwa kundi nyene.</char> <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" /><char style="wj">Nk’isaha icumi n’imwe z’umugoroba, aragenda abona abandi bahagaze ata co bariko barakora. Ababaza ati: ‘Ni kuki umusi wose uheze muhagaze ngaho ata co muriko murakora?’</char><verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />
    <char style="wj">Baramwishura bati: ‘Ni kubera twabuze uwuduha ico dukora.’</char></para>
  <para style="p" vid="MAT 20:7">
    <char style="wj">Na we arababwira ati: ‘Namwe nimugende mukore mu murima wanje.’</char><verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />
    <char style="wj">Bugorovye, nyene umurima abwira uwujejwe ubutunzi bwiwe ati: ‘Hamagara abakozi ubahembe, uhereye ku baje ubwa nyuma, uhereze ku baje ubwa mbere.’</char><verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />
    <char style="wj">Abakoze kuva isaha icumi n’imwe z’umugoroba, bahembwa idenariyo imwe.</char> <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" /><char style="wj">Maze abahawe igikorwa ubwa mbere baza guhembwa bazi ko baronka menshi kurusha. Ariko na bo nyene bahembwa idenariyo imwe.</char> <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" /><char style="wj">Abo bamaze guhembwa baca bidodombera nyene umurima,</char> <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" /><char style="wj">bavuga bati: ‘Abakoze isaha imwe ubahemba co kimwe natwe twiriwe turakora ku ruzuba ruri aho!’</char><verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />
    <char style="wj">Ariko nyene umurima abwira umwe muri bo ati: ‘Mugenzi, nakurenganije? Mbega ntiwari wemeye gukorera idenariyo imwe?</char> <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" /><char style="wj">Akira rero ingero yawe utahe. Nahisemwo kugerera urya nahaye akazi ubwa nyuma ingero ingana n’iyawe.</char> <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" /><char style="wj">Mbega simfise uburenganzira bwo gukoresha amahera yanje ico ngomba? Canke ubabajwe n’uko nagize umutima mwiza ku bandi?’</char><verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />
    <char style="wj">Abari inyuma bazoba ab’imbere, kandi abari imbere bazoba ab’inyuma.”</char><verse eid="MAT 20:16" /></para>
  <para style="s1">Yesu amenyesha ubugira gatatu ivy’urupfu rwiwe</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Yesu ariko araduga aja i Yerusalemu, afata bamwe cumi na babiri arabihereranya, ababwira ati: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" /><char style="wj">“Ehe, turaduze i Yerusalemu, kandi Umwana w’Umuntu azotangwa ku baherezi bakurubakuru n’abigisha b’ivyagezwe. Bazomucira urubanza rwo gupfa,</char> <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" /><char style="wj">hanyuma bamushikirize abanyamahanga kugira ngo bamushinyagurire, bamushishagure, hanyuma bamubambe ku musaraba. Ariko ku musi ugira gatatu, azozuka!”</char><verse eid="MAT 20:19" /></para>
  <para style="s1">Ivyo nyina wa Yakobo na Yohana yasavye</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Hanyuma nyina wa Yakobo na Yohana bene Zebedayo, aza aho Yesu ari azananye n’abo bahungu biwe babiri, apfukama imbere yiwe amwubashe cane, amusaba.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Yesu aramubaza ati: <char style="wj">“Wipfuza iki?”</char></para>
  <para style="p" vid="MAT 20:21">Na we aramwishura ati: “Ndagusavye, wemeze ko mu Bwami bwawe, aba bahungu banje bazokwicarana nawe, umwe i buryo bwawe, uwundi i bubamfu bwawe.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Yesu arabishura ati: <char style="wj">“Ntimuzi ico muriko murasaba. Mbega mwoshobora kunywa ku gikombe ngiye kunywako?”</char></para>
  <para style="p" vid="MAT 20:22">Baramwishura bati: “Egome twobishobora.”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yesu arababwira ati: <char style="wj">“Ni ivy’ukuri ko muzonywa ku gikombe canje. Ariko, ku vyerekeye kwicara i buryo canke i bubamfu bwanje si jewe ndabitanga. Ivyo bibanza ni ivy’abo Data yabiteguriye.”</char><verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Bamwe cumi bandi bavyumvise, bashavurira abo bahungu babiri bavukana. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Yesu aca arabahamagara bose, ababwira ati: <char style="wj">“Murazi ko abatware b’Abanyamahanga babatwaza umukazo, kandi ko ababaganza babacinyiza.</char> <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" /><char style="wj">Ariko muri mwebwe si ko bikwiye kumera. Ahubwo, uwushaka kuba umukuru muri mwebwe, ategerezwa kuba umukozi wanyu,</char> <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" /><char style="wj">kandi uwushaka kuba uwa mbere akwiye kuba umugurano wanyu;</char> <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" /><char style="wj">kuko n’Umwana w’Umuntu ntiyazanywe no gukorerwa, ahubwo yazanwe no gukorera abandi no gutanga ubuzima bwiwe ngo bube incungu ya benshi.”</char><verse eid="MAT 20:28" /></para>
  <para style="s1">Yesu ahumura impumyi zibiri</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Yesu n’abigishwa biwe bariko barava mu gisagara c’i Yeriko, abantu isinzi baramukurikira. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Hafi y’inzira, hari abantu babiri bahumye bicayeho. Bumvise ko Yesu azananye iyo nzira, batangura gusemerera n’ijwi rirenga bati: “Mwami, Mwana wa Dawidi, tugirire imbabazi!”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Abantu bari aho barabazibiza ngo bahore, ariko bo barushiriza gusemerera bati: “Mwami, Mwana wa Dawidi, tugirire imbabazi!”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yesu aca arahagarara, arabahamagara, ababaza ati: <char style="wj">“Mushaka ko ndabakorera iki?”</char><verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Baramwishura bati: “Mwami, twipfuza kubona.”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Yesu abagirira impuhwe, aca abakora ku maso; ubwo nyene baca barahumuka baramukurikira.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">Yesu ashika i Yerusalemu nk’Umwami</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Yesu n’abigishwa biwe begereje i Yerusalemu, bashika ahitwa Betifage ku Musozi wa Elayono. Yesu aca atuma babiri mu bigishwa ngo babitangire imbere, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />arababwira ati: <char style="wj">“Nimugende muri iriya mihana iri imbere yanyu; nimwashikayo, murahasanga indogoba n’inyana yayo ziziritse. Muce muzizitura muzinzanire.</char> <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" /><char style="wj">Nihagira uwugira ico ababaza, mumwishure muti: Umwami arazikeneye, aca abareka muzizane.”</char><verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Ivyo vyabaye kugira ngo ijambo ry’uwavugishwa n’Imana rishike; ryavuga ngo:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Mubwire umukobwa w’i Siyoni muti:</para>
  <para style="q2" vid="MAT 21:5">Raba Umwami wawe arakugendeye,</para>
  <para style="q1" vid="MAT 21:5">aciye bugufi, agendera ku ndogoba,</para>
  <para style="q2" vid="MAT 21:5">mbere aje ku nyana yayo.”<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 9:9">Zakariya 9:9</ref></char></char></note><verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Abo bigishwa baragenda, babikora nk’uko Yesu yabibabariye. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Bazana ya ndogoba n’inyana yayo, bazisasako impuzu zabo, hanyuma Yesu yicara kuri ya nyana. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Abantu benshi basasa impuzu zabo mu nzira, abandi na bo baca amashami y’ibiti, bayasasa mu nzira. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Maze abantu bagendera imbere ya Yesu, bagenda barasemerera bati:</para>
  <para style="q1" vid="MAT 21:9">“Hozana<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">Ni ijambo ry’Igiheburayo risigura ngo “Dukize!” Ariko ryahavuye rikoreshwa mu gushimagiza Imana.</char></note> Mwana wa Dawidi!”<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:26">Zaburi 118:26</ref></char></char></note></para>
  <para style="b" vid="MAT 21:9" />
  <para style="q1" vid="MAT 21:9">“Hahezagirwe uwuje mw’izina ry’Uhoraho!”</para>
  <para style="b" vid="MAT 21:9" />
  <para style="q1" vid="MAT 21:9">“Hozana hejuru mw’ijuru!”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Yesu yinjiye i Yerusalemu, mu gisagara cose haba uruhagarara. Abantu baja barabazanya bati: “Uwo ni nde?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Abandi bakishura bati: “Ni Yesu, umuvugishwa w’i Nazareti mu ntara ya Galilaya.”<verse eid="MAT 21:11" /></para>
  <para style="s1">Yesu yinjira mu rusengero</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Maze Yesu yinjira mu rusengero, yirukana abadandaza n’abariko barabagurira bose. Ahenagura imeza z’abavunja amahera hamwe n’intebe z’abadandaza inuma. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Arababwira ati: <char style="wj">“Handitswe ngo: ‘Inzu yanje izoba iyo gusengeramwo,’</char><note caller="+" style="f"><char style="fr" closed="false">21:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 56:7">Yesaya 56:7</ref></char></char></note> <char style="wj">ariko mweho mwayihinduye ubwihisho bw’ibisuma!”</char><note caller="+" style="f"><char style="fr" closed="false">21:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 7:11">Yeremiya 7:11</ref></char></char></note><verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Maze impumyi n’abacumbagira baraza baramwegera mu rusengero, arabakiza. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ariko, abaherezi bakurubakuru n’abigisha b’ivyagezwe bamaze kubona ibitangaza bihebuje akoze n’ingene abana baguma basemerera mu rusengero bavuga bati: “Hozana mwana wa Dawidi!” Baca barashavura cane.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />Babaza Yesu bati: “Mbega urumva ivyo aba bana bariko baravuga?”<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 8:2">Zaburi 8:2</ref></char></char></note></para>
  <para style="p" vid="MAT 21:16">Na we abishura ati: <char style="wj">“Egome. Mbega ntimurasoma Ivyanditswe bivuga ngo:</char></para>
  <para style="q1" vid="MAT 21:16">
    <char style="wj">‘Mu kanwa k’abana bato n’inzoya,</char></para>
  <para style="q2" vid="MAT 21:16">
    <char style="wj">wahironkeye amashimwe’?”</char><verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Maze aca abasiga ngaho, ava mu gisagara aja kurara i Betaniya.<verse eid="MAT 21:17" /></para>
  <para style="s1">Yesu avuma umusukoni</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Kare mu gitondo, Yesu ariko arasubira i Yerusalemu, yumva arashonje. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Nuko abona umusukoni uri hafi y’inzira, arawegera ariko asanga ata kintu na kimwe wamye, kiretse amababi gusa. Hanyuma aca arawubwira ati: <char style="wj">“Ntugasubire kwama na rimwe.”</char> Ubwo nyene uwo musukoni uca uruma.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Abigishwa biwe babibonye, baratangara cane. Baca babaza Yesu bati: “Ko uwo musukoni wumye ningoga?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yesu arabishura ati: <char style="wj">“Ndababwire ukuri, hamwe mwogira ukwizera ntimukekeranye na gatoya, namwe mwoshobora gukora ivyakorewe urya musukoni, mbere mwokora n’ibibirengeye. Mwoshobora no kubwira urya musozi muti: ‘Shinguka witerere mu kiyaga,’ kandi ni ko vyogenda.</char> <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" /><char style="wj">Nimwizera, ico muzosaba cose mu gusenga muzogihabwa.”</char><verse eid="MAT 21:22" /></para>
  <para style="s1">Babaza Yesu aho ububasha bwiwe buva</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yesu aca asubira mu rusengero hanyuma atangura kwigisha, abaherezi bakurubakuru n’abakuru b’Abayuda baza aho ari baramubaza bati: “Ni ubuhe bubasha butuma ukora ivyo? Ni nde yabuguhaye?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yesu arabishura ati: <char style="wj">“Reka nanje ndababaze ikibazo kimwe; nimwanyishura, nca ndababwira aho ububasha butuma nkora ibi buva.</char> <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" /><char style="wj">Mbega umubatizo wa Yohana wavuye he? Mw’ijuru ku Mana canke ku bantu?”</char></para>
  <para style="p" vid="MAT 21:25">Baravugana hagati yabo bati: “Nitwavuga tuti: ‘Wavuye mw’ijuru,’ ahava atubaza ati: ‘None ni kuki mutizeye ivyo Yohana yavuze?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Kandi nitwavuga tuti: ‘Wavuye ku bantu,’ dukwiye guca twirinda abantu, kuko bose baremera ko Yohana yari uwuvugishwa n’Imana.”<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Nuko bishura Yesu bati: “Ntituzi aho wavuye.”</para>
  <para style="p" vid="MAT 21:27">Na we aca ababwira ati: <char style="wj">“Nanje sindababwira aho ububasha butuma nkora ibi buva.</char><verse eid="MAT 21:27" /></para>
  <para style="s1">Umugani w’abahungu babiri bavukana</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />
    <char style="wj">Mbega ibi muvyibazako iki? Habaye umuntu yari afise abahungu babiri, hanyuma abwira umwe ati: ‘Mwana wanje, uno musi genda ukore mu murima w’uruzabibu.’</char><verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />
    <char style="wj">Aramwishura ati: ‘Oya, singenda,’ mugabo mu nyuma arisubirako, aragenda.</char><verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />
    <char style="wj">Hanyuma, se aragenda abwira umuhungu wiwe wa kabiri nk’uko yabwiye uwa mbere. Na we aramwishura ati: ‘Egome, muvyeyi, ndagiye,’ ariko ntiyajayo.</char><verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />
    <char style="wj">Mbega muri abo babiri, ni nde yakoze ivyo se yagomba?”</char></para>
  <para style="p" vid="MAT 21:31">Baramwishura bati: “Uwa mbere.”</para>
  <para style="p" vid="MAT 21:31">Yesu arababwira ati: <char style="wj">“Ndababwire ukuri, abatozakori biba n’abamaraya barabatanze kwinjira mu Bwami bw’Imana.</char> <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" /><char style="wj">Kuko Yohana yaraje abereka inzira yo kugororoka, ariko ntimwamwemeye, yamara abatozakori n’abamaraya baramwemeye. Ivyo mumaze kubibona, ntimwihanye ivyaha vyanyu ngo mumwizere.</char><verse eid="MAT 21:32" /></para>
  <para style="s1">Umugani w’abakozi babi mu ruzabibu</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />
    <char style="wj">Umviriza uwundi mugani. Habaye umuntu yari afise itongo hanyuma aririmamwo imizabibu. Ararizitirira, yimba ahantu ho kuganira imizabibu, yubaka n’umunara wo gucungererako urwo ruzabibu. Hanyuma azeza uwo murima abarimyi, afata urugendo rwa kure.</char> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" /><char style="wj">Hageze igihe co kwimbura, arungika abakozi biwe ngo baje gutora igice c’umwimbu kimwegukira.</char><verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />
    <char style="wj">Abo barimyi bafata abo bakozi, uwa mbere baramukubita, uwa kabiri baramwica, uwa gatatu bamutera amabuye.</char> <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" /><char style="wj">Hanyuma arungika abandi bakozi barusha aba mbere ubwinshi, na bo nyene abo barimyi babagira nk’uko bagize aba mbere.</char> <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" /><char style="wj">Ubwa nyuma, arungika umuhungu wiwe, yibwira ati: Umuhungu wanje we bazomusonera.</char><verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />
    <char style="wj">Ariko ba barimyi babonye uwo muhungu, baca baravugana bati: ‘Uwu ni we azoba samuragwa. Reka tumwice kugira ngo twegukire ivyo yorazwe.’</char> <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" /><char style="wj">Nuko baca baramufata, bamukwegera inyuma y’umurima w’uruzabibu, bamwicirayo.</char><verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />
    <char style="wj">None mwibaza ko nyene uruzabibu niyaza, azokorera iki abo barimyi?”</char><verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Baramwishura bati: “Azobica rubi hanyuma iryo tongo arizeze abandi barimyi bazohora bamuha umwimbu umwegukira uko iyimbura rigeze.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yesu aca ababwira ati: <char style="wj">“Nta ho murasoma mu Vyanditswe ahavuga ngo:</char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="wj">‘Ibuye abubatsi bagaye</char></para>
  <para style="q2" vid="MAT 21:42">
    <char style="wj">ni ryo ryahindutse irigumya imfuruka;</char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="wj">ibi Uhoraho ni we yabikoze,</char></para>
  <para style="q2" vid="MAT 21:42">
    <char style="wj">kandi ni igitangaza mu maso yacu’?</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">21:42 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 118:22">Zaburi 118:22</ref>,<ref loc="PSA 118:23">23</ref></char>
      </char>
    </note><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />
    <char style="wj">Ndababwire, muzokwakwa Ubwami bw’Imana, buhabwe ayandi mahanga azokwama ivyamwa bikwiranye na bwo.</char> <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" /><char style="wj">Umuntu wese azogwa kuri iryo buye azovunagurika, kandi uwo rizogwako, rizomusya.”</char><verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Abaherezi bakurubakuru n’Abafarisayo bumvise iyo migani ya Yesu, bamenya ko ari bo yariko aravuga. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Baca barondera ingene bomufata, ariko batinya abantu kuko kuri bo Yesu yari uwuvugishwa n’Imana.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">Umugani w’abatumiriwe ubukwe</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yesu yongera kuvugana na bo mu migani, ababwira ati: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" /><char style="wj">“Ubwami bw’ijuru bugereranywa n’umusi mukuru w’ubukwe umwami yateguriye umuhungu wiwe.</char> <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" /><char style="wj">Igihe co kuzimana abatumire gishitse, atuma abakozi biwe guhamagara abatumiwe, ariko banka kuza.</char><verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />
    <char style="wj">Hanyuma arungika abandi bakozi, ababwira ati: ‘Nimugende mubwire abatumiwe ko nateguye amazimano: nabaze impfizi n’ibindi bitungwa binuze, kandi ibintu vyose biteguye neza. Mubabwire baze ku mazimano y’ubukwe!’</char><verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />
    <char style="wj">Ariko, habura n’umwe avyitaho, bose bigira mu vyabo, umwe mw’itongo, uwundi mu bucuruzi,</char> <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" /><char style="wj">abandi na bo bafata abakozi biwe barabakubagura, hanyuma barabica.</char> <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" /><char style="wj">Maze umwami arashavura cane, aca arungika ingabo ziwe kwica izo nkozi z’ibibi, bongera batongoza umuriro igisagara cabo.</char><verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />
    <char style="wj">Hanyuma abwira abakozi biwe ati: ‘Amazimano y’ubukwe yateguwe, ariko abo natumiye nta n’umwe agomba kuza.</char> <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" /><char style="wj">None rero nimugende mu mabarabara no mu mayirabiri, mutumire umuntu wese muhasanga.’</char> <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" /><char style="wj">Nuko, abo bakozi baragenda begeranya abantu bose bahuye, ababi n’abeza, hanyuma inzu y’ubukwe yuzura abashitsi.</char><verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />
    <char style="wj">Ariko umwami yinjiye kuraba abatumire, abonamwo umuntu atambaye impuzu y’ubukwe.</char> <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" /><char style="wj">Aramubaza ati: ‘Mugenzi, winjiye gute hano kandi utambaye impuzu y’ubukwe?’ Uwo muntu ntiyashobora kuronka ico yishura.</char><verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />
    <char style="wj">Umwami aca abwira abakozi biwe ati: ‘Nimumubohe amaboko n’amaguru, mumuterere hanze mu mwijima, ahazoba amarira no gushinga amenyo ku yandi kubera umubabaro.’</char><verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />
    <char style="wj">Burya abatumiwe ni benshi, ariko abatoranijwe ni bake.”</char><verse eid="MAT 22:14" /></para>
  <para style="s1">Gutanga ikori rya Kayisari</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Hanyuma Abafarisayo barakorana barondera ingene bomutegera ku majambo avuga. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Barungika bamwe mu bigishwa babo bari kumwe n’abashigikiye Herode Antipa. Baramubwira bati: “Mwigisha, turazi ko utunganye, kandi ko wigisha inzira ihimbara Imana mu kuri kwose. Ntuhengamira ku ruhande na rumwe kuko utarobanura abantu ufatiye ku cubahiro cabo. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />None rero tubwire ico wiyumvira: Mbega ivyagezwe vyacu biratwemerera gutanga ikori rya Kayisari, canke ntibibitwemerera?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Ariko kuko Yesu yari azi intumbero mbi bari bafise, ababwira ati: <char style="wj">“Mwa ndyarya mwe, ni iki gituma muntega imitego?</char> <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" /><char style="wj">Nyereka igiceri mukoresha mu kuriha ikori.”</char> Bamuzanira idenariyo, igiceri c’Abaroma, <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />aca arababaza ati: <char style="wj">“Iyi shusho n’ibi vyandiko biriko ni ivya nde?”</char><verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Baramwishura bati: “Ni ivya Kayisari.”</para>
  <para style="p" vid="MAT 22:21">Aca ababwira ati: <char style="wj">“Nuko rero ivya Kayisari nimubihe Kayisari, ivy’Imana na vyo mubihe Imana.”</char><verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Bumvise ivyo barajorerwa cane, bamusiga ngaho baragenda.<verse eid="MAT 22:22" /></para>
  <para style="s1">Ivy’abagabo n’abagore inyuma y’izuka</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Uwo musi nyene, Abasadukayo, ari bo batemera ivy’izuka ry’abapfuye, baza aho ari, baramubaza bati: <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“Mwigisha, Mose yavuze ko umugabo apfuye adasize abana, uwo bavukana ategerezwa kurongora umupfakazi wiwe kugira ngo aronkere uruvyaro uwo yapfuye. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Rero, harigeze kuba hagati muri twebwe abavukana indwi. Mukuru muri bo ararongora, ariko apfa atavyaye; maze murumunawe arongora uwo mupfakazi. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Uwa kabiri na we nyene apfa atavyaye, n’uwugira gatatu bigenda gutyo kugeza ku wugira indwi. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Mu nyuma na wa mugore arapfa. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />None ku musi w’izuka, uwo mugore azoba uwa nde ko bose babaye abagabo biwe?”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yesu arabishura ati: <char style="wj">“Mwarazimiye kuko mudatahura ico Ivyanditswe bivuga, ntimumenye n’ubushobozi bw’Imana.</char> <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" /><char style="wj">Ku musi w’izuka abantu ntibazorongora canke ngo barongorwe, bazoba bameze nk’abamarayika bo mw’ijuru.</char> <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" /><char style="wj">Ku bijanye n’izuka ry’abapfuye, mbega nta ho murasoma mu Vyanditswe ingene Imana yavuze iti:</char> <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" /><char style="wj">‘Ndi Imana ya Aburahamu, ya Isaka na Yakobo’?</char><note caller="+" style="f"><char style="fr" closed="false">22:32 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:6">Kuvayo 3:6</ref></char></char></note> <char style="wj">Erega si Imana y’abapfuye, ni Imana y’abazima.”</char><verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Abantu bumvise ivyo baca batangazwa n’inyigisho ziwe.<verse eid="MAT 22:33" /></para>
  <para style="s1">Ibwirizwa rikuru</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Abafarisayo bumvise ko Yesu yajoreje Abasadukayo, baca barakorana. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Umwe muri bo w’umwigisha w’ivyagezwe, agerageza kumutega umutego, amubaza ati: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Mwigisha, ibwirizwa riruta ayandi mu Vyagezwe ni irihe?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Yesu aramwishura ati: <char style="wj">“ ‘Ukundishe Uhoraho Imana yawe umutima wawe wose, n’umushasha wawe wose n’ubwenge bwawe bwose.’</char><note caller="+" style="f"><char style="fr" closed="false">22:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:5">Gusubiramwo 6:5</ref></char></char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" /><char style="wj">Iryo ni ryo bwirizwa rya mbere kandi riruta ayandi.</char> <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" /><char style="wj">Irya kabiri na ryo risa n’iryo: ‘Ukunde mugenzawe nk’uko wikunda.’</char><note caller="+" style="f"><char style="fr" closed="false">22:39 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">Abalewi 19:18</ref></char></char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" /><char style="wj">Ivyagezwe n’ivyanditswe n’abavugishwa vyose bishingiye kuri ayo mabwirizwa abiri.”</char><verse eid="MAT 22:40" /></para>
  <para style="s1">Mbega Kristo ni umwana wa nde?</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Abafarisayo bakoranye, Yesu arababaza ati: <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" /><char style="wj">“Mbega mwibaza iki ku vyerekeye Kristo? Ni umwana wa nde?”</char></para>
  <para style="p" vid="MAT 22:42">Baramwishura bati: “Ni umwana wa Dawidi.”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Arababwira ati: <char style="wj">“None bishoboka gute ngo Dawidi, avugishijwe na Mpwemu, amwite Umwami? Kuko yavuze ati:</char><verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />
    <char style="wj">‘Uhoraho yabwiye Umwami wanje ati:</char></para>
  <para style="q2" vid="MAT 22:44">
    <char style="wj">“Icara i buryo bwanje kugeza</char></para>
  <para style="q1" vid="MAT 22:44">
    <char style="wj">abansi bawe bose ndabashize</char></para>
  <para style="q2" vid="MAT 22:44">
    <char style="wj">musi y’ibirenge vyawe.” ’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">22:44 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 110:1">Zaburi 110:1</ref>
        </char>
      </char>
    </note><verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />
    <char style="wj">None nimba Dawidi amwita Umwami, yoba umwana wiwe gute?”</char> <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Nta n’umwe yagize ico avuga ngo amwishure, kandi kuva uwo musi, nta n’uwongeye kwubahuka kumubaza ikibazo.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">Ukwirinda uburyarya n’ukwishira hejuru</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Yesu abwira abigishwa biwe hamwe n’abantu bose bari ngaho ati: <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" /><char style="wj">“Abigisha b’ivyagezwe hamwe n’Abafarisayo bicaye mu kibanza ca Mose.</char> <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" /><char style="wj">Mukwiye rero kwiyubara mugakora ico cose bababwiye. Ariko ntimukore ivyo bakora, kuko badakora ivyo bigisha.</char> <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" /><char style="wj">Bafata imitwaro iremereye y’amategeko y’idini bakayikoreza abantu ariko bobo ntibanayikozako urutoke.</char><verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />
    <char style="wj">Ivyo bakora vyose babikora kugira ngo biyerekane. Bambara udusaho turimwo imirongo y’Ivyanditswe mu ruhanga no ku maboko kandi n’imisozo yo ku mpuzu zabo bakayigira miremire gusumvya abandi.</char> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" /><char style="wj">Bakunda ivyicaro vy’icubahiro mu misi mikuru y’amazimano, n’intebe z’imbere mu masinagogi.</char> <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" /><char style="wj">Bakunda kuramutswa mu cubahiro bari mu makoraniro y’abantu, bagakunda ko babita Rabi risobanurwa ngo Mwigisha.</char><verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />
    <char style="wj">Ariko mwebwe, ntimukemere ko babita Rabi kuko mufise umwigisha umwe, namwe mukaba muvukana.</char> <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" /><char style="wj">Ntihakagire umuntu n’umwe kw’isi mwita ‘data’ kuko mufise Data umwe, ari we So wo mw’ijuru.</char> <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" /><char style="wj">Ntimuze mwemere n’uko babita abigisha kuko mufise umwigisha umwe ari we Kristo.</char> <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" /><char style="wj">Umukuru cane muri mwese, ategerezwa kuba umukozi wanyu.</char> <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" /><char style="wj">Uwishira hejuru wese azocishwa bugufi, ariko uwicisha bugufi azoshirwa hejuru.</char><verse eid="MAT 23:12" /></para>
  <para style="s1">Yesu aburira abigisha b’Ivyagezwe n’Abafarisayo</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />
    <char style="wj">Muzobona ibara yemwe bigisha b’ivyagezwe n’Abafarisayo, kuko muri indyarya! Mwugaye umuryango w’Ubwami bw’ijuru, ntimwinjira mwebwe ubwanyu, kandi n’abagomba kwinjira ntimwabakundira.</char></para>
  <para style="p" vid="MAT 23:13">[ <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" /><char style="wj">Muzobona ibara yemwe bigisha b’ivyagezwe n’Abafarisayo, kuko muri indyarya! Munyaga abapfakazi utwabo, hanyuma mukagira amasengesho maremare kugira ngo mwiyerekane. Ni co gituma muzohanwa kurusha abandi.</char>]<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">Mu nzandiko zimwezimwe za Bibiliya aya majambo ntarimwo.</char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />
    <char style="wj">Muzobona ibara yemwe bigisha b’ivyagezwe n’Abafarisayo, kuko muri indyarya! Mukwiragira hose ku misozi no mu biyaga murondera umuntu umwe ngo mumuhindure umunyedini, mumaze kumuronka mugaca mumuhindura incuro zibiri kuba uwo gutabwa muri Gehinomu, nk’uko muri!</char><verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />
    <char style="wj">Yemwe ndongozi zihumye, muzobona ibara kuko muvuga muti: ‘Nta co bitwaye kurahira urusengero rw’Imana, ariko kandi mukavuga ko uwurahiye inzahabu ziri mu rusengero aba yibohesheje iyo ndahiro.’</char> <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" /><char style="wj">Yemwe mwa mburabwenge zihumye, mbega igihambaye ni ikihe hagati y’inzahabu zo mu rusengero n’urusengero rutuma izo nzahabu ziba izejejwe?</char> <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" /><char style="wj">Muravuga muti: ‘Nta co bitwaye kurahira igicaniro, ariko mukavuga ko uwurahiye ku kimazi kiri ku gicaniro aba yibohesheje iyo ndahiro.’</char> <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" /><char style="wj">Mwa mpumyi mwe! Mbega igihambaye ni ikihe, hagati y’ikimazi n’igicaniro gituma ikimazi kiba icejejwe?</char> <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" /><char style="wj">Uwurahira ku gicaniro aba arahiye ku gicaniro ubwaco no ku biri kuri co vyose.</char> <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" /><char style="wj">Kandi umuntu wese arahira ku rusengero, aba arahiye ku rusengero ubwarwo no ku Mana iba muri rwo.</char> <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" /><char style="wj">Umuntu wese arahira kw’ijuru, aba arahiye no ku ntebe y’inganji no ku Mana iyicayeko.</char><verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />
    <char style="wj">Muzobona ibara yemwe bigisha b’ivyagezwe n’Abafarisayo, kuko muri indyarya! Mutanga ikigiracumi kuri vyose gushika no ku mboga zo mu matongo yanyu, ariko mukirengagiza ibikomeye vyo mu vyagezwe ari vyo: ukugororoka, imbabazi, n’ukwizera. Ibi mwari mukwiye kubikora, n’ivyo bindi mutavyirengagije.</char> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" /><char style="wj">Yemwe ndongozi zihumye! Murayungurura agatuku mu vyo munywa, ariko ingamiya mukayimirira rimwe!</char><verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />
    <char style="wj">Muzobona ibara yemwe bigisha b’ivyagezwe n’Abafarisayo, kuko muri indyarya! Mwoza neza igikombe n’isahani inyuma, ariko imbere huzuyemwo umwanda w’ivy’ubusuma n’ukwipfuza kwanyu.</char> <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" /><char style="wj">Yemwe mwa mpumyi z’Abafarisayo! Banza mwoze imbere h’igikombe n’isahani hanyuma n’inyuma hazoheza habe heza.</char><verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />
    <char style="wj">Muzobona ibara mwa bigisha b’ivyagezwe n’Abafarisayo, kuko muri indyarya! Mumeze nk’imva zera derere; zisa neza inyuma, ariko imbere muri zo huzuyemwo amagufa n’ibindi bintu vyose bihumanye.</char> <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" /><char style="wj">Namwe ni uko, inyuma mugaragara mugororotse, ariko imbere mu mitima mwuzuye uburyarya n’ikibi.</char><verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />
    <char style="wj">Muzobona ibara yemwe bigisha b’ivyagezwe n’Abafarisayo, kuko muri indyarya! Mwubakira imva z’abavugishwa n’Imana ba sogokuru banyu bishe, mugashariza ivyibutso vy’abagororotsi ba sogokuru bishe,</char> <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" /><char style="wj">hanyuma mukavuga muti: Iyo tuba twariho mu gihe ca ba sogokuru, ntituba twarifatanije na bo mu gusesa amaraso y’abavugishwa.</char> <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" /><char style="wj">Ariko iyo muvuze gutyo muba mwiyagirije mwebwe nyene ko muri uruvyaro rw’abo bishe abavugishwa.</char> <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" /><char style="wj">Bandanya rero murangize ibikorwa ba sogokuru banyu batanguye!</char><verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />
    <char style="wj">Mwa nzoka mwe, ruvyaro rw’imvuvyi! Mwibaza ko muzokira mute urubanza rwa Gehinomu?</char> <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" /><char style="wj">None rero, ngira ndabarungikire abavugishwa, abanyabwenge hamwe n’abigisha b’ivyagezwe b’ukuri. Bamwe muzobica, abandi mubabambe, abandi mubatonagurire mu masinagogi yanyu, hanyuma mubatoteze bave mu gisagara baja mu kindi.</char> <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" /><char style="wj">Ikizokurikira ni uko ingaruka z’amaraso y’abagororotsi bose bishwe, uhereye ku mugororotsi Abeli ukageza kuri Zakariya mwene Barakiya uwo mwiciye mu rusengero hagati y’igicaniro n’ihema ry’ibonaniro, zizoba kuri mwebwe.</char> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" /><char style="wj">Ndababwira ukuri ko ingaruka z’ivyo vyose zizoba ku bantu ba kino gihe.</char><verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />
    <char style="wj">Yewe Yerusalemu, yewe Yerusalemu! Wewe wica abavugishwa n’Imana, ugatera amabuye abagutumweko! Ni kangahe nagerageje kwegeranya abana bawe nk’uko inkoko yegeraniriza imiswi yayo mu mababa yayo, ariko ukanyankira!</char> <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" /><char style="wj">None raba inzu yanyu igiye kuba akahebwe.</char> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" /><char style="wj">Kuko ndababwira ukuri ko mutazosubira kumbona kugeza aho muzovugira muti: ‘Hahezagirwe uwuje mw’izina ry’Uhoraho!’</char><note caller="+" style="f"><char style="fr" closed="false">23:39 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:26">Zaburi 118:26</ref></char></char></note><char style="wj">”</char><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">Yesu avuga ibimenyetso vyo kugaruka kwiwe</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yesu ariko arasohoka ava mu rusengero, abigishwa biwe baramwegera, bamwereka ingene urusengero rwubatse. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Na we arabishura ati: <char style="wj">“Murabona ibi vyose? Ndababwira ukuri ko ata buye na rimwe rizosigara rigeretse ku rindi, yose azosamburirwa hasi.”</char><verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Hanyuma Yesu yicaye ku Musozi wa Elayono, biherereye, abigishwa biwe baramubaza bati: “Tubwire, ivyo bizoshika ryari, kandi ni ikihe kimenyetso kizokwerekana ukugaruka kwawe n’umuhero w’isi?”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yesu arababwira ati: <char style="wj">“Mwirinde ntihagire umuntu n’umwe abazimiza</char> <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" /><char style="wj">kuko benshi bazoza mw’izina ryanje bavuga ngo: ‘Ni jewe Kristo,’ kandi bazozimiza benshi.</char> <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" /><char style="wj">Muzokwumva intambara n’inkuru zivuga ivy’intambara hirya no hino, ariko ntimuze muhagarike imitima. Ivyo bitegerezwa gushika, ariko iherezo rya vyose ntirizoba rirashika.</char> <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" /><char style="wj">Ihanga rizotera irindi hanga, ubwami butere ubundi bwami. Ahantu henshi kw’isi hazotera ikigoyi n’ukunyiganyiga kw’isi.</char> <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" /><char style="wj">Ivyo vyose bizoba ari nk’intango y’ibise.</char><verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />
    <char style="wj">Hanyuma bazobafata babahame, ndetse banabice. Muzokwankwa n’amahanga yose babahora izina ryanje.</char> <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" /><char style="wj">Ico gihe benshi bazota ukwizera bahemukiranire kandi bankane.</char> <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" /><char style="wj">Hazokwaduka abavugishwa b’ibinyoma benshi kandi bazozimiza abantu benshi.</char> <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" /><char style="wj">Kuko ikibi kizogwira, urukundo rwa benshi na rwo ruzotimba.</char> <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" /><char style="wj">Ariko uwuzokwihangana gushitsa kw’iherezo azokizwa.</char> <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" /><char style="wj">Kandi ubu Butumwa Bwiza bw’Ubwami buzovugwa kw’isi yose, kugira ngo bubere ikimenyetso amahanga yose, hanyuma umuhero uzoca uza.</char><verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />
    <char style="wj">Nimwabona ca ‘kizira gihumanya’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">24:15 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="DAN 9:27">Daniyeli 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char>
      </char>
    </note> <char style="wj">cavugwa n’uwavugishwa n’Imana Daniyeli gihagaritswe Ahera; uwusoma natahure,</char> <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" /><char style="wj">abazoba bari i Yudaya baze bahungire ku misozi.</char> <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" /><char style="wj">Uwuzoba ari hejuru ku nzu, ntaze asubire mu nzu kurondera ivyo ahungana.</char> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" /><char style="wj">Uwuzoba ari mu murima ntaze asubire i muhira gutora impuzu.</char> <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" /><char style="wj">Ese ukuntu iyo misi izoba ari iy’umubabaro utagira uko ungana ku bagore bibungenze n’abazoba bonsa!</char> <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" /><char style="wj">Musenge kugira ngo uguhunga kwanyu ntikuze kube mu gihe c’imbeho nyinshi cane canke ku musi w’Isabato.</char> <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" /><char style="wj">Kuko muri iyo misi hazobaho umubabaro mwinshi utigeze kubaho kuva isi iremwa kugeza ubu, kandi ntuzosubira kubaho.</char><verse eid="MAT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 24:22" />
    <char style="wj">Kandi iyo misi iyo itagabanywa, nta muntu n’umwe yorokotse. Ariko kubera abatoranijwe, iyo misi izogabanywa.</char> <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" /><char style="wj">Muri ico gihe nihagira umuntu ababwira ati: ‘Ehe Kristo ari hano!’ canke ngo: ‘Ehe ng’uriya!’ ntimuze muvyemere.</char> <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" /><char style="wj">Kuko abiyita Kristo n’abavugishwa b’ibinyoma bazoza ari benshi, bagakora ibimenyetso n’ibitangaza kugira ngo bishobotse bazimize n’abatoranijwe.</char> <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" /><char style="wj">Ehe raba ndabibabwiye imbere y’uko bishika.</char><verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />
    <char style="wj">Nihagira uwubabwira ati: ‘Erega, Kristo ari mu bugaragwa,’ ntimuze muje kumuronderayo. Canke ati: ‘Raba ari hano mu vyumba,’ ntimuze muvyemere.</char> <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" /><char style="wj">Kuko nk’uko umuravyo urabiriza mu buseruko ukabonekera no mu burengero, ni ko bizomera Umwana w’Umuntu niyaza.</char> <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" /><char style="wj">Aho umuvyimba uzoba uri, ni ho ibisiga vy’amero bizokoranira.</char><verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />
    <char style="wj">Ubwo nyene, inyuma y’ivyo vyago vyo muri iyo misi,</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="wj">‘izuba rizocura umwijima,</char></para>
  <para style="q2" vid="MAT 24:29">
    <char style="wj">n’ukwezi ntikuzosubira kubonesha,</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="wj">inyenyeri zizokoragurika ziva kw’ijuru,</char></para>
  <para style="q2" vid="MAT 24:29">
    <char style="wj">n’ivy’inkomezi biri mu kirere bizonyiganyizwa.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">24:29 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 13:10">Yesaya 13:10</ref>; <ref loc="ISA 34:4">34:4</ref></char>
      </char>
    </note><verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />
    <char style="wj">Inyuma y’ivyo, ni ho ikimenyetso cerekana ukugaruka kw’Umwana w’Umuntu kizogaragara kw’ijuru, kandi hazoba amaborogo mu bantu bo mu moko yose yo kw’isi. Ni ho bazobona Umwana w’Umuntu azananye n’ibicu afise ububasha bwinshi n’icubahiro.</char> <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" /><char style="wj">Azotuma abamarayika biwe bavuze inzamba zisamirane cane, hanyuma begeranye abatoranijwe biwe bose bo mw’isi, kuva aho ijuru ritangurira gushika aho riherera.</char><verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />
    <char style="wj">Nimwigire ku giti c’umusukoni: iyo amashami yaco atanguye gutoha, amababi na yo agatutuza, muca mumenya ko agatasi kari hafi.</char> <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" /><char style="wj">Nuko namwe, nimwabona ivyo vyose, muzoce mumenya neza ko ukugaruka kwiwe kuri hafi, ko ageze kw’irembo.</char> <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" /><char style="wj">Ndababwire ukuri, abo muri runo runganwe ntibazopfa bose ivyo vyose bitarashika.</char> <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" /><char style="wj">Ijuru n’isi bizokurwaho, ariko amajambo yanje ntazovaho.</char><verse eid="MAT 24:35" /></para>
  <para style="s1">Nta wuzi umusi n’isaha</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />
    <char style="wj">Ariko ku bijanye n’umusi canke isaha, baba abamarayika bo mw’ijuru canke Umwana ubwiwe, nta n’umwe abizi uretse Data wenyene.</char> <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" /><char style="wj">Nk’uko vyari bimeze mu gihe ca Nowa, ni ko bizomera no mu gihe co kugaruka kw’Umwana w’Umuntu.</char> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" /><char style="wj">Kuko imbere y’uko umwuzure uza, bararya, baranywa, bararongora, bagashingiza, gushika ku musi Nowa yinjiriye mu bwato.</char> <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" /><char style="wj">Ntibigeze bamenya ibigira bibe kugeza umwuzure uje ukabatwara bose. Uko ni ko bizomera igihe Umwana w’Umuntu azozira.</char> <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" /><char style="wj">Abagabo babiri bazoba bari mu murima, umwe azojanwa uwundi asigare.</char> <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" /><char style="wj">Abagore babiri bazoba bariko barasya ku rusyo, umwe azojanwa, uwundi asigare.</char><verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />
    <char style="wj">Kubera ivyo rero mube maso, kuko mutazi umusi Umwami wanyu azozirako.</char> <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" /><char style="wj">Mutahure ibi: Iyaba nyene inzu yomenye isaha igisuma kizirako, yoteramye ntiyokwemera ko kimena inzu yiwe.</char> <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" /><char style="wj">Ni co gituma namwe mukwiye kwama mugavye, kuko Umwana w’Umuntu azoza mu gihe mutamwiteze.</char><verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />
    <char style="wj">Mbega umukozi w’umwizigirwa kandi w’umunyabwenge ni nde? Ni uwo shebuja ashobora guha ubukuru bwo kuganza abandi bakozi no kubagaburira mu gihe gikwiye.</char> <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" /><char style="wj">Azoba ahiriwe uwo mukozi shebuja azosanga akora gutyo niyagaruka.</char> <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" /><char style="wj">Ndababwire ukuri, azoshika amuzeza ivyo atunze vyose.</char> <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" /><char style="wj">Ariko vyogenda gute hamwe yoba ari umukozi mubi, maze akibwira mu mutima wiwe ati: ‘Databuja yatevye kugaruka,’</char> <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" /><char style="wj">hanyuma agatangura gukubita abakozi bagenziwe, kurya no kuborerwa hamwe n’izindi mborerwa?</char> <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" /><char style="wj">Shebuja azoshika umusi uwo mukozi atari yiteze ko ashikirako, no kw’isaha atazi.</char> <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" /><char style="wj">Azomuhimbagura hanyuma amusangize ikibanza n’indyarya, ahazoba amarira no guhekenya amenyo ku bw’umubabaro mwinshi.”</char><verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">Umugani w’inkumi cumi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Yesu abandanya avuga ati: <char style="wj">“Ico gihe Ubwami bw’ijuru buzoba bugereranywa n’inkumi cumi zateguye amatara yazo ngo zije gusanganira umukwe.</char> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" /><char style="wj">Batanu muri bo bari abanyabwenge buke abandi batanu bari abanyabwenge.</char> <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" /><char style="wj">Abo batanu b’abanyabwengebuke batwaye amatara yabo, ariko ntibajana amavuta.</char> <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" /><char style="wj">Bamwe batanu b’abanyabwenge bobo batwaye amatara yabo, hamwe n’ayandi mavuta mu macupa.</char> <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" /><char style="wj">Umukwe agitevye, bose bararambirwa, batangura gusinzira.</char><verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />
    <char style="wj">Ijoro ryitereye, humvikana ijwi risemerera ngo: ‘Ng’uwo umukwe araje nimumusanganire.’</char><verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />
    <char style="wj">Za nkumi zose ziravyuka zitunganya amatara yazo.</char> <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" /><char style="wj">Ba banyabwengebuke babwira abanyabwenge bati: ‘Nimuduhe ku mavuta yanyu kuko amatara yacu agira azime.’</char><verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />
    <char style="wj">Na bo barabishura bati: ‘Ntibishoboka kuko twohava tudakwirwa twese, ahubwo nimugende ku bayagurisha mwigurire.’</char><verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />
    <char style="wj">Maze bagiye kugura ayo mavuta, umukwe aca arashika, abari biteguye binjirana na we mu musi mukuru w’ubukwe, hanyuma umuryango urugarwa.</char><verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />
    <char style="wj">Mu nyuma, za nkumi z’abanyabwenge buke zigarutse, zihagarara hanze, zirahamagara ziti: ‘Nyakwubahwa, nyakwubahwa twugururire!’</char><verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />
    <char style="wj">Na we arabishura ati: ‘Ndababwire ukuri, sindabazi!’</char><verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />
    <char style="wj">Nuko rero mube maso, kuko mutazi umusi n’isaha.</char><verse eid="MAT 25:13" /></para>
  <para style="s1">Umugani w’ababikijwe ubutunzi</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />
    <char style="wj">Ubwami bw’ijuru bugereranywa kandi n’umuntu yafashe urugendo rwa kure. Imbere yo kugenda, ahamagara abakozi biwe abasigarana ubutunzi yari afise.</char> <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" /><char style="wj">Uwa mbere amuha italanto zitanu, uwa kabiri amuha zibiri, uwa gatatu amuha imwe, </char><note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">Italanto imwe yangana n’impembo y’umukozi mu kiringo c’imyaka 20.</char></note> <char style="wj">umwe wese amuha akurikije uko ashoboye gucuruza. Hanyuma afata urugendo.</char> <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" /><char style="wj">Wa mukozi yaronka italanto zitanu, aragenda arazicururisha yunguka izindi zitanu.</char> <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" /><char style="wj">N’uwahawe zibiri aragenda abigira gutyo nyene, yunguka izindi zibiri.</char> <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" /><char style="wj">Ariko umwe yahabwa italanto imwe, aragenda yimba ikinogo mw’ivu, anyegezamwo ya talanto ya shebuja.</char><verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />
    <char style="wj">Haheze igihe kirekire, shebuja aragaruka, ahamagara ba bakozi kugira ngo bamubwire ingene bakoresheje amahera yiwe.</char> <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" /><char style="wj">Umwe yahabwa italanto zitanu azana izindi zitanu, avuga ati: ‘Databuja, wari wansigaranye italanto zitanu, none raba nungutse izindi zitanu.’</char><verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />
    <char style="wj">Shebuja aramwishura ati: ‘Wakoze neza, mukozi wanje mwiza kandi w’umwizigirwa! Wabaye umwizigirwa kuri bike; nanje nzoguha kuganza vyinshi. Kaze usangire umunezero na shobuja!’</char><verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />
    <char style="wj">Uwari yasigaranywe italanto zibiri na we araza, avuga ati: ‘Databuja, wari wansigaranye italanto zibiri; none raba, nungutse izindi zibiri.’</char><verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />
    <char style="wj">Shebuja aramwishura ati: ‘Wakoze neza, mukozi wanje mwiza kandi w’umwizigirwa! Wabaye umwizigirwa kuri bike; nanje nzoguha kuganza vyinshi. Kaze usangire umunezero na shobuja!’</char><verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />
    <char style="wj">Hanyuma umwe yasigaranwa italanto imwe na we araza, avuga ati: ‘Databuja, nari nzi ko uri umuntu agoye, wimbura aho utateye kandi wegeranya umwimbu aho utabivye imbuto.</char> <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" /><char style="wj">Rero, naratinye nca ndagenda mpamba italanto yawe mw’ivu, none akira ivyawe.’</char><verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />
    <char style="wj">Shebuja aramwishura ati: ‘Wa mukozi mubi kandi w’ikinebwe! Ko wari uzi ko nimbura aho ntateye kandi negeranya umwimbu aho ntabivye imbuto,</char> <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" /><char style="wj">ni kuki utajanye amahera yanje ku bayadandarisha, kugira ngo ngarutse ndonke umutahe wanje n’inyugu yawo?’</char><verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />
    <char style="wj">Ubwo nyene aca atanga itegeko ati: ‘Nimumwake n’iyo talanto yari afise, muyihe uwufise icumi.</char> <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" /><char style="wj">Kuko uwufise azokwongererezwa asesekarizwe, ariko uwudafise azokwakwa n’ivyo yari afise.</char> <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" /><char style="wj">Uwo mukozi w’imburakimazi na we nimumute hanze mu mwijima ahazoba amarira no gushinga amenyo ku yandi kubera umubabaro.’</char><verse eid="MAT 25:30" /></para>
  <para style="s1">Umugani w’impene n’intama</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />
    <char style="wj">Aho Umwana w’Umuntu azozira, ari mu bwiza bwiwe, ari kumwe n’abamarayika biwe, azokwicara ku ntebe yiwe y’inganji.</char> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" /><char style="wj">Amahanga yose azokoranira imbere yiwe, hanyuma arobanure abantu, nk’uko umwungere arobanura intama mu mpene.</char> <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" /><char style="wj">Azoshira intama i buryo bwiwe, impene na zo azishire i bubamfu.</char><verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />
    <char style="wj">Maze Umwami azobwira abari i buryo bwiwe ati: ‘Nimuze mwebwe abo Data yahezagiye, muragwe Ubwami mwateguriwe uhereye isi ikiremwa.</char> <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" /><char style="wj">Kuko nari nshonje murangaburira, nari nyotewe mumpa ico kunywa, nari ingenzi mumpa indaro,</char> <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" /><char style="wj">nagenda gusa muranyambika, nari ngwaye muza kunsuhuza, nari mw’ibohero muza kundaba.’</char><verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />
    <char style="wj">Maze abagororotsi bazomwishura bati: ‘Mwami, twakubonye ryari ushonje turakugaburira, canke unyotewe tuguha ico kunywa?</char> <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" /><char style="wj">Ni ryari twakubonye uri ingenzi tuguha indaro, canke ugenda gusa turakwambika?</char> <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" /><char style="wj">Twakubonye ryari ugwaye canke uri mw’ibohero tuza kukuraba?’</char><verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />
    <char style="wj">Umwami azobishura ati: ‘Ndababwire ukuri, igihe cose mwabikoreye urya muntu muto muri aba bene Data, ni jewe mwabikoreye.’</char><verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />
    <char style="wj">Hanyuma Umwami azohindukira abwire abari i bubamfu bwiwe ati: ‘Mva mu maso mwa bivume mwe, muje mu muriro utazozima wateguriwe Satani n’abamarayika biwe.</char> <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" /><char style="wj">Kuko nari nshonje ariko ntimwampa ivyokurya, nari nyotewe ntimwampa ico kunywa,</char> <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" /><char style="wj">nari ingenzi ntimwampa indaro, nagenda gusa ntimwanyambika, naragwaye nja no mw’ibohero ntimwaza kundaba.’</char><verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />
    <char style="wj">Na bo bazomwishura bati: ‘Mwami, ni ryari twakubonye ushonje, canke unyotewe, canke uri ingenzi, canke ugenda gusa, canke ugwaye, canke uri mw’ibohero ntitwagufasha?’</char><verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />
    <char style="wj">Umwami azobishura ati: ‘Ndababwire ukuri, igihe cose mutabikoreye umwe muri aba bato, ni jewe mutabikoreye.’</char><verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />
    <char style="wj">Hanyuma bazoca baja mu gihano c’ibihe bidashira, ariko abagororotsi bo bazoja mu bugingo budashira.”</char><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">Baja inama yo kwica Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Yesu ahejeje kuvuga ivyo vyose, abwira abigishwa biwe ati: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" /><char style="wj">“Nk’uko musanzwe mubizi, umusi mukuru wa Pasika ugiye kuba mu misi ibiri: Umwana w’Umuntu azofatwa atangwe kugira ngo abambwe.”</char><verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Muri ico gihe nyene, abaherezi bakurubakuru hamwe n’abakuru b’Abayuda, bari bakoraniye mu rugo rw’umuherezi mukuru Kayafa, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />kugira ngo barabe ingene bofata Yesu mu mpisho, hanyuma bamwice. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Barumvikana bati: “Ariko ntidukwiye kumufata mu misi mikuru kuko abantu bohava bagumuka.”<verse eid="MAT 26:5" /></para>
  <para style="s1">Yesu asigirwa amavuta i Betaniya</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Ico gihe, Yesu yari i Betaniya, mu nzu kwa Simoni yahoze ari umunyamibembe. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Ariko arafungura haza umugore aramwegera afise icupa ryiza ririmwo amavuta amota cane kandi y’igiciro kinini, maze ayamusuka ku mutwe bicaye mu buriro.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Abigishwa babibonye ntibabishima baca bavuga bati: “Mbega ubu buhombe ni ubw’iki? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Aya mavuta yari kugurishwa amahera menshi agafasha aboro.”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Yesu amenye ivyo bariko baravuga, aca ababwira ati: <char style="wj">“Mbega uwu mugore mumugorera iki? Ankoreye ikintu ciza.</char> <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" /><char style="wj">Aboro muzokwamana, ariko jewe ntimuzonyamana.</char> <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" /><char style="wj">Ansutseko aya mavuta kugira ngo umubiri wanje awutegurire guhambwa.</char> <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" /><char style="wj">Ndababwire ukuri, kw’isi yose aho ubu Butumwa Bwiza buzovugwa, ibi akoze bizovugwa bitume yama yibukwa.”</char><verse eid="MAT 26:13" /></para>
  <para style="s1">Yuda arondera kugurisha Yesu</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Hanyuma Yuda Isikariyote, umwe muri ba bigishwa cumi na babiri, aragenda aja kurondera abaherezi bakurubakuru, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />arababaza ati: “Hamwe nobaha Yesu mwompa iki?” Baca bamuha ibiceri vy’ifeza mirongo itatu. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Kuva uwo mwanya aca atangura kurondera akaryo keza ko kumubashikiriza.<verse eid="MAT 26:16" /></para>
  <para style="s1">Yesu asangira n’abigishwa biwe ubwa nyuma</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Ku musi wa mbere w’imisi mikuru y’imikate itarimwo umwambiro, abigishwa baza aho Yesu ari baramubaza bati: “Ni hehe ugomba ko tugutegurira ivyokurya vya Pasika?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Arabishura ati: <char style="wj">“Nimugende mu gisagara, maze muraja kubona umuntu, mumubwire muti: Umwigisha avuze ko isaha yiwe yegereje, kandi ko agomba gusangirira n’abigishwa biwe ivya Pasika iwawe.”</char> <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Ba bigishwa baragenda babikora nk’uko Yesu yabibabwiye, bategura ivyokurya vya Pasika.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Ku mugoroba, Yesu yicarana ku meza n’abigishwa biwe cumi na babiri. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Bariko barafungura, Yesu avuga ati: <char style="wj">“Ndababwire ukuri, umwe muri mwebwe ahava angurisha.”</char><verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Abigishwa biwe barababara cane, umwe wese atangura kuvuga ati: “Mwami, nibaza ko atari jewe!”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Yesu arabishura ati: <char style="wj">“Uwo twahurije amaboko mw’isahani ni we ahava angurisha.</char> <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" /><char style="wj">Umwana w’Umuntu agiye gupfa nk’uko Ivyanditswe bivuga. Ariko aragowe uwo muntu amugurishije! Vyari kumubera vyiza iyo atavuka!”</char><verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Maze Yuda, uwari yateguye kumugurisha na we nyene avuga ati: “None yoba ari jewe ga Mwigisha?”</para>
  <para style="p" vid="MAT 26:25">Yesu aramwishura ati: <char style="wj">“Ubivuze nk’uwubizi.”</char><verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Bariko barafungura, Yesu afata umukate, awushimira Imana, arawumanyura, awuha abigishwa biwe, avuga ati: <char style="wj">“Nimwakire murye; uwu ni umubiri wanje.”</char><verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Yongera afata igikombe, agishimira Imana, arakibaha, ati: <char style="wj">“Nimwakire munyweko mwese.</char> <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" /><char style="wj">Aya ni amaraso yanje y’isezerano asesekeye benshi ngo baharirwe ivyaha vyabo.</char> <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" /><char style="wj">Ndababwire, sinzosubira kunywa kuri uwu muvinyu w’imizabibu guhera ubu gushitsa kuri wa musi aho nzosubira kuwusangirira namwe ari mushasha mu Bwami bwa Data.”</char><verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Bahejeje kuririmba barasohoka, baja ku Musozi wa Elayono.<verse eid="MAT 26:30" /></para>
  <para style="s1">Yesu avuga ko Petero ahava amwihakana</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Bariko baragenda Yesu arababwira ati: <char style="wj">“Iri joro mwese muraja guhungabana mu kwizera kwanyu, munte mwigire. Kuko Ivyanditswe bivuga ngo:</char></para>
  <para style="q1" vid="MAT 26:31">
    <char style="wj">‘Nzokubita umwungere,</char></para>
  <para style="q2" vid="MAT 26:31">
    <char style="wj">intama zo mu mukuku zisanzare.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">26:31 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ZEC 13:7">Zakariya 13:7</ref>
        </char>
      </char>
    </note><verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />
    <char style="wj">Ariko maze kuzuka, nzobitangira imbere mu kuja i Galilaya, ndabarindirireyo.”</char><verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Petero aramwishura ati: “Naho abandi bose boguta bagahunga, jewe sinzokwigera ndaguta.”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Yesu aramwishura ati: <char style="wj">“Ndakubwire ukuri, iri joro nyene, isake itarabika, uzoba umaze kunyihakana gatatu kose, uvuga ko utanzi.”</char><verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Ariko Petero arasubira avuga ati: “Sinshobora kukwihakana ngo sindakuzi naho vyonsaba gupfana nawe.” Mbere n’abandi bigishwa bavuga batyo.<verse eid="MAT 26:35" /></para>
  <para style="s1">Yesu asengera i Getsemane</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Hanyuma Yesu ajana n’abigishwa biwe ahantu hitwa Getsemane, arababwira ati: <char style="wj">“Nimube muricaye ngaha nje harya gusenga.”</char> <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Ahitana Petero na bene Zebedayo, hanyuma atangura kugira umubabaro mwinshi n’agahinda. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Arababwira ati: <char style="wj">“Umutima wanje wuzuye agahinda gashobora kunyica. Nimube muragumye ngaha mubane maso nanje.”</char><verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Nuko yigira imbere, yubama hasi arasenga ati: <char style="wj">“Data, nimba bishoboka, ndakwinginze unkure imbere iki gikombe c’imibabaro. Ariko, ntibibe nk’uko jewe ngomba, yamara bibe uko wewe ugomba.”</char><verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Hanyuma agaruka aho abigishwa biwe bari asanga basinziriye. Abaza Petero ati: <char style="wj">“Ntimushobora kubana maso nanje n’isaha n’imwe?</char> <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" /><char style="wj">Nimube maso musenge kugira ngo ntimutsindwe n’ibibagerageza. Kuko umutima urabikunze ariko umubiri ufise intege nke.”</char><verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Asubirayo ubugira kabiri arasenga ati: <char style="wj">“Data, nimba bidakunda ko iki gikombe c’imibabaro kimva imbere ntakinyoyeko, ivyo ushaka nibibe.”</char><verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Agarutse, asanga basubiriye gusinzira, kuko amaso yabo yari aremerewe cane n’itiro. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Maze yongera kubasiga ngaho asubira gusenga ubugira gatatu, avuga amajambo nk’amwe ya mbere.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Agarutse aho abigishwa biwe bari, ababwira ati: <char style="wj">“Mbega muracasinziriye, muriruhukiye? Ehe, isaha irageze, Umwana w’Umuntu agira atangwe mu maboko y’abanyavyaha.</char> <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" /><char style="wj">Nimuvyuke tugende. Nguwo uwangurishije arashitse!”</char><verse eid="MAT 26:46" /></para>
  <para style="s1">Bafata Yesu</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Yesu akiriko aravuga, Yuda umwe muri ba bigishwa cumi na babiri, arashika. Inyuma yiwe hari isinzi ry’abantu bitwaje inkota n’amahiri, barungitswe n’abaherezi bakurubakuru hamwe n’abakuru b’Abayuda. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Yuda, uwari yamugurishije yari yabahaye ikimenyetso, ababwira ati: “Uwo nja gusoma azoba ari we, muce mumufata.” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Maze Yuda aca agenda atumbereye Yesu, avuga ati: “Ndakuramukije Rabi!” Aca aramusoma.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yesu aramubwira ati: <char style="wj">“Mugenzi, kora ikikuzanye!”</char></para>
  <para style="p" vid="MAT 26:50">Ba bantu baca bashorera amaboko kuri Yesu, baramufata. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Umwe mu bari kumwe na Yesu aca asokora inkota yiwe, ayikubita umukozi w’umuherezi mukuru, amuca ugutwi.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Yesu aca amubwira ati: <char style="wj">“Subiza inkota yawe mu rwubati! Kuko abicisha inkota bose, bazokwicishwa inkota.</char> <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" /><char style="wj">Wibaza ko ntari gushobora gusaba Data ubwo nyene akandungikira ingabo zirenga legiyono</char><note caller="+" style="f"><char style="fr" closed="false">26:53 </char><char style="ft" closed="false">Legiyono imwe igizwe n’abasoda ibihumbi bitandatu.</char></note> <char style="wj">cumi na zibiri z’abamarayika bo kungwanira?</char> <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" /><char style="wj">None ko Ivyanditswe Vyera bivuga ko bitegerezwa kugenda gutya, vyoshitswa gute?”</char><verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Hanyuma Yesu abwira ba bantu benshi baje kumufata ati: <char style="wj">“Mbega mbaye umugumutsi, aho muza kumfata mwitwaje inkota n’amahiri? Ni kuki mutamfatiye mu rusengero kandi ari ho nama imisi yose nigisha?</char> <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" /><char style="wj">Ariko, ibi vyose bibaye kugira ngo ivyanditswe n’abavugishwa n’Imana bishike.”</char> Ubwo nyene abigishwa biwe bose baramuta barahunga.<verse eid="MAT 26:56" /></para>
  <para style="s1">Yesu ashikanwa imbere y’inama nkuru y’Abayuda</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Abaje gufata Yesu bamujana mu rugo rw’umuherezi mukuru Kayafa, ahari hakoraniye abigisha b’ivyagezwe hamwe n’abakuru b’Abayuda. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Ariko Petero we, aguma inyuma yiwe, amukurikira agendera kure, kugeza ashitse mu rugo rw’umuherezi mukuru. Ashitse yicarana n’abarinzi b’urugo, ngo arabe amaherezo.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Abaherezi bakurubakuru n’abagize inama nkuru y’idini ry’Abayuda bagerageza kurondera ibirego vyotuma Yesu acirwa urubanza rwo gupfa. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Ariko, ntibaronka na kimwe, naho ivyabona vy’ibinyoma vyari vyaje ari vyinshi.</para>
  <para style="p" vid="MAT 26:60">Ubwa nyuma, haza abantu babiri <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />bavuga bati: “Uwu mugabo yavuze ko ashobora gusambura urusengero rw’Imana, akarwubaka mu misi itatu.”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Hanyuma umuherezi mukuru aca arahaguruka, abwira Yesu ati: “None wewe nta co wireguza? Ibi birego bakwagiriza ubivugako iki?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Ariko Yesu aguma ahoze.</para>
  <para style="p" vid="MAT 26:63">Maze umuherezi mukuru aca amubwira ati: “Mw’izina ry’Imana nzima, tubwize ukuri: Uri Kristo, Umwana w’Imana?”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yesu aramwishura ati: <char style="wj">“Uravyivugiye ko ndi we. Kandi kuva ubu, mugiye kuzobona Umwana w’Umuntu yicaye mu kibanza c’icubahiro i buryo bw’Imana Mushoboravyose, kandi azananye n’ibicu vyo kw’ijuru.”</char><verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Maze umuherezi mukuru yitaburirako impuzu, avuga ati: “Aratutse Imana! None hari ibindi vyabona dukeneye? Ubu na ho ntimwiyumviye ingene atutse Imana? <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Mumucira urubanza ruki?”</para>
  <para style="p" vid="MAT 26:66">Baramwishura bati: “Akwiye gupfa.”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Hanyuma bamucira amate mu maso, bamukubita ingumu, abandi bamukubita amakofe, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />bavuga bati: “Ko uri Kristo, tubwire uwugukubise!”<verse eid="MAT 26:68" /></para>
  <para style="s1">Petero yihakana Yesu</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Ico gihe, Petero yari yicaye hanze mu rugo. Maze umwigeme yakora ngaho, aramwegera avuga ati: “Na wewe wari kumwe na Yesu w’i Galilaya.”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Ariko Petero, arabihakana imbere yabo ati: “Sinzi n’ivyo muriko muravuga.”<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Hanyuma aragenda ahagarara hafi y’irembo, uwundi mwigeme w’umukozi w’aho na we aramubona aca abwira abari ngaho ati: “Uwu mugabo yari kumwe na Yesu w’i Nazareti.”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Arongera arabihakana, ashirako n’indahiro ati: “Sindamuzi!”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Haheze akanya gato, abari bahagaze ngaho begera Petero bamubwira bati: “Ni ukuri na wewe uri umwe muri bo, kuko n’imvugo yawe, irakuranga ko uri Umunyagalilaya.”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Petero aca atangura kurahira yisiba ati: “Ndabarahiye urya muntu sindamuzi!”</para>
  <para style="p" vid="MAT 26:74">Uwo mwanya nyene, isake ica irabika. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Petero aca yibuka ivyo Yesu yari yamubwiye ati: <char style="wj">“Isake itarabika, uja kuba umaze kunyihakana gatatu kose, uvuga ko utanzi.”</char> Aca aja hanze araturikisha ararira cane.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">Yuda yiyahura</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Kare mu gatondo, abaherezi bakurubakuru hamwe n’abakuru b’Abayuda bagira inama yo kwica Yesu. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Baca baramufata, baramuboha, bamujana kwa Pilato, umutware w’Umuroma.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Yuda yamugurishije abonye ko baciriye Yesu urubanza rwo gupfa, aca aricuza, hanyuma afata vya biceri vy’ifeza mirongo itatu, abishira abaherezi bakurubakuru hamwe n’abakuru, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />ababwira ati: “Nacumuye kuko nagurishije umuntu atagira icaha.”</para>
  <para style="p" vid="MAT 27:4">Baramwishura bati: “Ivyo ntibituraba, ni ingorane yawe!”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Yuda aca aterera ayo mahera mu rusengero, arasohoka aja kwiyahura.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Abaherezi bakurubakuru batora ayo mahera, baravugana bati: “Ntivyemewe ko aya mahera tuyavanga n’ubutunzi bw’urusengero kuko yaguze amaraso.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Bamaze kuja inama, bafata ingingo yo kuyagura itongo ry’umubumvyi kugira ngo bazohore bahahamba abanyamahanga. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Ni co gituma, gushika n’ubu iryo tongo ryitwa itongo ry’amaraso. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Uko ni ko ivyavuzwe n’uwavugishwa n’Imana Yeremiya vyashitse, aho yavuze ngo: “Bafashe vya biceri vy’ifeza mirongo itatu, ikiguzi Abisirayeli babonye ko akwiye, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />bayakoresha mu kugura itongo ry’umubumvyi nk’uko Uhoraho yabintegetse.”<note caller="+" style="f"><char style="fr" closed="false">27:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 11:12">Zakariya 11:12</ref>,<ref loc="ZEC 11:13">13</ref>; <ref loc="JER 19:1-13">Yeremiya 19:1-13</ref>; <ref loc="JER 32:6-9">32:6-9</ref></char></char></note><verse eid="MAT 27:10" /></para>
  <para style="s1">Yesu ashikirizwa Pilato</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Nuko Yesu arengutswa imbere ya Pilato, umutware w’Umuroma, na we aramubaza ati: “Uri umwami w’Abayuda?”</para>
  <para style="p" vid="MAT 27:11">Yesu aramwishura ati: <char style="wj">“Uvuze ukuri, ndi we.”</char><verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Ariko abaherezi bakurubakuru hamwe n’abakuru b’Abayuda bamwagirije, ntiyishura na kimwe. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Pilato aramubwira ati: “Mbega ntiwumva ivyo bakurega?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Ariko Yesu ntiyagira ijambo na rimwe yishura, bituma uwo mutware atangara cane.<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Mu gihe c’imisi mikuru ya Pasika, umutware w’Umuroma yari afise umugenzo wo kurekura imbohe abantu bihitiyemwo. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Ico gihe, hariho imbohe izwi cane yitwa Yesu<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">Hariho inzandiko zimwezimwe za Bibiliya zidafise </char><char style="fq" closed="false">Yesu</char><char style="ft" closed="false">; ni ko biri no ku murongo wa 17.</char></note> Baraba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Nuko Pilato abaza abantu bari bakoraniye aho ati: “Mbega mugomba ko ndabarekurira imbohe iyihe: Baraba canke Yesu yitwa Kristo?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Pilato yari azi neza ko ari ishari ryatumye bamuzanira Yesu ngo amucire urubanza.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Pilato acicaye aho acira imanza, umugore wiwe amurungikira ubutumwa buvuga ngo: “Ntihagire ikintu na kimwe ugira uwo mugororotsi, kuko naraye mbabajwe cane mu ndoto kubera we.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Ariko abaherezi bakurubakuru n’abakuru b’Abayuda, bemeza abantu ko basaba Baraba kugira ngo Yesu abe ari we abambwa.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Hanyuma Pilato arababaza ati: “Ni nde muri aba babiri mugomba ko ndabarekurira?”</para>
  <para style="p" vid="MAT 27:21">Barishura bati: “Baraba.”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Hanyuma Pilato arababaza ati: “Yesu bita Kristo wewe ndamugire nte?”</para>
  <para style="p" vid="MAT 27:22">Bose bishurira rimwe bati: “Nabambwe!”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Ariko Pilato arababaza ati: “Kubera iki? Ni ikihe caha yakoze?”</para>
  <para style="p" vid="MAT 27:23">Ariko barushiriza gusemerera bati: “Nabambwe!”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Pilato abonye ko ata co ariko arashikako, ahubwo ko umuvurungano ukomeza kwiyongera, afata amazi, akarabira imbere y’abantu, avuga ati: “Jewe ndera, amaraso y’uwu muntu, ari kuri mwebwe!”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Abantu bose barishura bati: “Amaraso yiwe azotwagire twebwe n’abana bacu!”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Pilato aca abarekurira Baraba. Atanga itegeko ko bashishagura Yesu, hanyuma aramutanga kugira ngo bamubambe.<verse eid="MAT 27:26" /></para>
  <para style="s1">Abasoda bashinyagurira Yesu</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Abasoda ba Pilato batwara Yesu aho umutware w’Umuroma yakorera, hanyuma bakoranya abandi basoda bagize umugwi wabo. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Bamwambura impuzu ziwe, bamwambika ikanzu itukura, <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />hanyuma bajisha urugori rw’amahwa, barumwambika mu mutwe. Bamufatisha mu kuboko kw’i buryo inkoni y’irenga. Maze, bapfukama imbere yiwe bamushinyagurira bati: “Turagize bwakeye, mwami w’Abayuda!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Bamucirako amate, bafata rya renga baguma barimukubita mu mutwe. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Bahejeje kumushinyagurira, bamwambura ya mpuzu itukura, basubira kumwambika impuzu ziwe, hanyuma bamujana kumubamba.<verse eid="MAT 27:31" /></para>
  <para style="s1">Babamba Yesu ku musaraba</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Bariko barasohoka bava mu gisagara, bahura n’umuntu yitwa Simoni w’i Kurene, bamutegeka gutwaza Yesu umusaraba. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Nuko bashika ahantu hitwa Gologota bisigura “Ahantu h’Agahanga”. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Abasoda bamuha umuvinyu w’inkarisha, ariko amaze kuwumviriza, yanka kuwunywa. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Bamubamba ku musaraba, bagabura impuzu ziwe bakoresheje ubupfindo, <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />maze bicara ngaho kugira ngo bamucunge. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Hejuru y’umutwe wiwe, bashiraho icandiko c’ibirego vyatumye abambwa cavuga ngo:</para>
  <para style="pc" vid="MAT 27:37">
    <char style="sc">Uwu ni Yesu umwami w’Abayuda.</char><verse eid="MAT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />Abasoda bongera babamba ibisuma bibiri i ruhande ya Yesu, kimwe i buryo, ikindi i bubamfu. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Abahita bakagenda baramutuka bamuzunguriza umutwe, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />bakamubwira bati: “Wewe wavuze ko wosambura urusengero ukarwubaka mu misi itatu. Nimba uri Umwana w’Imana niwikize wikure ku musaraba!” <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Abaherezi bakurubakuru, abigisha b’ivyagezwe hamwe n’abakuru b’Abayuda, na bo nyene baramucokora, bavuga bati: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Yakijije abandi ariko we ntashobora kwikiza! Nimba ari Umwami w’Abisirayeli, niyikure ku musaraba natwe duce tumwizera.” <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Yizigiye Imana, rero Imana nimba imukunda nimutabare kuko yavuze ati: <char style="wj">“Ndi Umwana w’Imana.”</char> <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Kandi na vya bisuma vyari bibambanywe na we na vyo biramutuka.<verse eid="MAT 27:44" /></para>
  <para style="s1">Urupfu rwa Yesu</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Kuva isaha zitandatu z’umurango kugeza isaha icenda, haba umwijima, utwikira igihugu cose. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Isaha y’icenda igira ishike, Yesu arasemerera n’ijwi rirenga ati: <char style="tl"><char style="wj">“Eli, Eli,</char></char><note caller="+" style="f"><char style="fr" closed="false">27:46 </char><char style="ft" closed="false">Inzandiko zimwezimwe za Bibiliya zifise </char><char style="fqa" closed="false">Eloyi, Eloyi.</char></note> <char style="tl"><char style="wj">lema sabakitani?”</char></char> (bisobanurwa ngo: <char style="wj">“Mana yanje, Mana yanje, ni kuki wampevye?”</char>).<note caller="+" style="f"><char style="fr" closed="false">27:46 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:1">Zaburi 22:1</ref></char></char></note><verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Bamwe mu bari bahagaze aho bumvise ivyo, baca bavuga bati: “Ariko ahamagara Eliya!”<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />Ubwo nyene, umwe muri bo ariruka afata sipongo, ayijobeka mu nkarisha, ayishira kw’irenga ngo ayimunyweshe. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Ariko abandi baravuga bati: “Banza ureke turabe ko Eliya aza kumutabara!”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Yesu yongera gusemerera n’ijwi rirenga, hanyuma aracikana.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Uwo mwanya nyene, igitambara co mu rusengero gitandukanya Ahera n’Ahera Cane gitabukamwo kubiri kuva hejuru gushika hasi. Isi iranyiganyiga, ibitandara birasatagurika, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />imva ziruguruka kandi imibiri myinshi y’abera irazuka. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Bava mu mva, kandi Yesu amaze kuzuka, binjira i Yerusalemu, igisagara cera, babonekera abantu benshi.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Intwazangabo y’Umuroma n’abasoda yari arongoye mu gucunga Yesu, babonye ukunyiganyiga kw’isi hamwe n’ibibaye vyose, bafatwa n’ubwoba bwinshi, bavuga bati: “Ni ivy’ukuri uwu yari Umwana w’Imana!”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Abagore benshi bari bavuye i Galilaya bazananye na Yesu kugira ngo bamushigikire mu gikorwa ciwe, bari ngaho babirabira kure. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Muri bo harimwo Mariya Magadalena, Mariya nyina wa Yakobo na Yosefu, na nyina wa bene Zebedayo.<verse eid="MAT 27:56" /></para>
  <para style="s1">Bahamba Yesu</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Buriko burira, haza umutunzi w’i Arimataya yitwa Yosefu, kandi na we nyene yari umwigishwa wa Yesu. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Aja kwa Pilato, amusaba ikiziga ca Yesu. Maze Pilato ategeka ko bakimuha. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yosefu afata ico kiziga, akizingira mu gitambara cera, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />hanyuma agishira mu mva nshasha yari aherutse kwiyimbishiriza mu gitandara. Nuko aca atembagariza ikibuye kinini ku muryango w’iyo mva arayugara. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Mariya Magadalena na Mariya wundi, bari bicaye aharabana n’imva.<verse eid="MAT 27:61" /></para>
  <para style="s1">Bashiraho abarinda imva ya Yesu</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Umusi ukurikira, hari kw’Isabato, abaherezi bakurubakuru hamwe n’Abafarisayo baja kwa Pilato, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />bamubwira bati: “Nyakwubahwa, twibutse ivyo wa mubeshi yari yaravuze akiri muzima ngo: ‘Inyuma y’imisi itatu nzozuka.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Turagusavye rero utange itegeko ryo gucunga imva yiwe kugeza ku musi ugira gatatu. Ivyo bizotuma abigishwa biwe bataza kwiba ikiziga ciwe, hanyuma bakabwira abantu ko yazutse mu bapfuye. Bibaye uko ububeshi bwiwe bwa nyuma bwoba bubi kurusha ubwa mbere.”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Pilato arabishura ati: “Ng’abo abasoda, nimugende mucunge iyo mva yiwe uburyo bwose mwipfuza.” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Baca baragenda bashira ikimenyetso ku kibuye cugaye imva, hanyuma bashiraho abasoda bo kuyicunga.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">Ukuzuka kwa Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Umusi w’Isabato urangiye, mu mutwenzi wo ku musi wa mbere utangura iyinga, Mariya Magadalena na Mariya wundi baja kuraba imva ya Yesu.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Ubwo nyene, haca haba ukunyiganyiga gukomeye kw’isi, kuko umumarayika w’Umwami Imana yari yamanutse avuye mw’ijuru, agatembagaza ca kibuye cugaye imva ya Yesu akacicarako. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Mu maso hiwe hasa n’umuravyo, kandi impuzu ziwe zarera derere. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Ba bararirizi b’imva ya Yesu bagira ubwoba bwinshi ku buryo bamera nk’abapfuye.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Umumarayika abwira abo bagore ati: “Mweho ntimutinye, kuko ndazi ko murondera Yesu yabambwe. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Ntari hano, yazutse, nk’uko yari yarabivuze. Nimuze murabe aho umubiri wiwe wari uryamye. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Nuko rero, nimugende mwihuta mubwire abigishwa biwe ko yazutse kandi ko agiye kubarindirira i Galilaya; ni ho muzomubonera. Ubwo ni bwo butumwa nari ndabafitiye.”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Abo bagore baca bava ku mva, bagenda bihuta, bafise ubwoba ariko kandi n’akanyamuneza kenshi. Nuko bariruka baja kubwira abigishwa biwe iyo nkuru. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Ubwo nyene, Yesu aca ahura na bo arabaramutsa. Na bo baramwegera bamufata ku birenge baramusenga. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Yesu aca ababwira ati: <char style="wj">“Ntimutinye; nimugende mubwire bene Data baje i Galilaya, aho ni ho tuzobonanira.”</char><verse eid="MAT 28:10" /></para>
  <para style="s1">Ivyavuzwe n’abarinzi b’imva</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Ba bagore bakiri mu nzira bagenda, bamwe mu barinzi b’imva binjira mu gisagara, babwira abaherezi bakurubakuru ingene ibintu vyagenze. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Abo baherezi bakurubakuru baca bagirana inama n’abakuru b’Abayuda, baha amahera menshi ba barinzi b’imva, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />bababwira bati: “Muze muvuge muti: ‘Abigishwa biwe baraje mw’ijoro dusinziriye, biba ikiziga ciwe.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Pilato niyavyumva, tuzomwumvisha nta ngorane muzogira.” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Abo barinzi bakira ayo mahera hanyuma bakora nk’uko babwiwe. Inkuru yabo ikwira hose mu Bayuda, kugeza n’uno musi.<verse eid="MAT 28:15" /></para>
  <para style="s1">Yesu atuma abigishwa biwe</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Nuko ba bigishwa cumi n’umwe baja i Galilaya, ku musozi Yesu yari yarabarangiye. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Bamubonye, baramusenga, ariko bamwe muri bo bari bagifise ugukekeranya. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Maze Yesu arabegera, ababwira ati: <char style="wj">“Nahawe ububasha bwose mw’ijuru no mw’isi.</char> <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" /><char style="wj">Nuko nimugende, muhindure amahanga yose abigishwa: mubabatize mw’izina rya Data n’iry’Umwana n’irya Mpwemu Yera,</char> <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" /><char style="wj">mubigishe gushira mu ngiro ivyo nabategetse vyose. Kandi mumenye ko ndi kumwe namwe imisi yose gushika ku muhero w’isi.”</char><verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>