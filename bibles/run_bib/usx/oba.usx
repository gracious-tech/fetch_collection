  <para style="h">Obadiya</para>
  <para style="toc1">Igitabu c’uwavugishwa n’Imana Obadiya</para>
  <para style="toc2">Obadiya</para>
  <para style="toc3">Ob</para>
  <para style="mt2">Igitabu c’uwavugishwa n’Imana</para>
  <para style="mt1">Obadiya</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="s1">Ivyo Obadiya yeretswe</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />Ibi ni vyo Obadiya yeretswe.</para>
  <para style="b" vid="OBA 1:1" />
  <para style="b" vid="OBA 1:1" />
  <para style="p" vid="OBA 1:1">Uku ni ko <char style="nd">Uhoraho</char> Nyeninganji avuze kuri Edomu.</para>
  <para style="q1" vid="OBA 1:1">Twumvise inkuru ivuye k’<char style="nd">Uhoraho</char>, kandi</para>
  <para style="q2" vid="OBA 1:1">intumwa yatumwe ku mahanga kuyabwira iti:</para>
  <para style="q1" vid="OBA 1:1">“Nimuhaguruke, tugende kumutera tumugwanye.”<verse eid="OBA 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />“Raba, nzokugira muto mu yandi mahanga,</para>
  <para style="q2" vid="OBA 1:2">ube inkengerwa rwose.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />Ubwibone bwo mu mutima wawe bwaraguhenze,</para>
  <para style="q2" vid="OBA 1:3">wewe wibera mu myobo yo mu bitandara,</para>
  <para style="q2" vid="OBA 1:3">ukiyubakira inzu mu misozi miremire,</para>
  <para style="q1" vid="OBA 1:3">ukibwira mu mutima uti:</para>
  <para style="q2" vid="OBA 1:3">‘Ni nde yonkororera hasi kw’isi?’<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />Naho woguruka ukaja hejuru cane nk’inkona,</para>
  <para style="q2" vid="OBA 1:4">ukarika icari cawe mu nyenyeri,</para>
  <para style="q2" vid="OBA 1:4">nzokumanurayo ndagukororere hasi,”</para>
  <para style="q2" vid="OBA 1:4">ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />Hamwe ibisuma vyogutera,</para>
  <para style="q2" vid="OBA 1:5">canke abambuzi bakaza mw’ijoro;</para>
  <para style="q1" vid="OBA 1:5">ese ukuntu woba ugize ivyago!</para>
  <para style="q2" vid="OBA 1:5">Mbega ntibokwiba ikintu cose bipfuza?</para>
  <para style="q1" vid="OBA 1:5">Abimbuzi b’inzabibu baje kwimbura mw’itongo iwawe,</para>
  <para style="q2" vid="OBA 1:5">mbega ntibasigaza dukeya?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />Ariko, ese ukuntu Esawu yatswe ikintu cose,</para>
  <para style="q2" vid="OBA 1:6">n’ubutunzi bwiwe bwose bwari bunyegejwe bukanyagwa!<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />Abo mufitaniye amasezerano bazokwirukana uve mu gihugu cawe;</para>
  <para style="q2" vid="OBA 1:7">abagenzi bawe bazoguhinduka kandi bakuneshe;</para>
  <para style="q1" vid="OBA 1:7">abarya ivyokurya vyawe bazogutega umutego,</para>
  <para style="q2" vid="OBA 1:7">ariko ntuzowubona.<verse eid="OBA 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />“Kuri uwo musi,” ni ko <char style="nd">Uhoraho</char> avuze,</para>
  <para style="q2" vid="OBA 1:8">“mbega sinzoherengeteza abanyabwenge bose ba Edomu,</para>
  <para style="q2" vid="OBA 1:8">abafise ugutahura bari mu misozi ya Esawu?”<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />Abahizi bawe b’abagwanyi, ewe Temani, bazojugumira kubera ubwoba,</para>
  <para style="q2" vid="OBA 1:9">kandi umuntu wese wo mu misozi ya Esawu</para>
  <para style="q2" vid="OBA 1:9">azohimbagurwa ku musi wo gutikizwa.<verse eid="OBA 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />Kubera ibibi wakoreye umuvukanyi wawe Yakobo,</para>
  <para style="q2" vid="OBA 1:10">ibiteterwe bizogupfuka;</para>
  <para style="q2" vid="OBA 1:10">uzoherengetezwa ibihe vyose.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />Igihe baterwa wihagarariye ku ruhande,</para>
  <para style="q2" vid="OBA 1:11">igihe abansi banyaga ubutunzi bwiwe,</para>
  <para style="q1" vid="OBA 1:11">abanyamahanga bakinjira mu marembo yiwe,</para>
  <para style="q2" vid="OBA 1:11">bagapfindira ubupfindo Yerusalemu,</para>
  <para style="q2" vid="OBA 1:11">wari umeze nk’umwe muri bo.<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />Ntiwari ukwiye kunezerezwa no kugirirwa nabi kw’umuvukanyi wawe</para>
  <para style="q2" vid="OBA 1:12">ku musi yaboneyeko ivyago,</para>
  <para style="q1" vid="OBA 1:12">canke ngo utwenge Abayuda</para>
  <para style="q2" vid="OBA 1:12">ku musi wo kubona amakuba kwabo,</para>
  <para style="q1" vid="OBA 1:12">canke ngo wishime cane</para>
  <para style="q2" vid="OBA 1:12">ku musi w’ivyago vyabo.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />Ntiwari ukwiye kwinjira mu marembo y’abantu banje</para>
  <para style="q2" vid="OBA 1:13">ku musi baboneyeko ivyago,</para>
  <para style="q1" vid="OBA 1:13">canke ngo ubatwenge batewe n’ikiza</para>
  <para style="q2" vid="OBA 1:13">ku musi baboneyeko amagorwa,</para>
  <para style="q1" vid="OBA 1:13">canke ngo utware ubutunzi bwabo</para>
  <para style="q2" vid="OBA 1:13">ku musi w’ivyago vyabo.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />Ntiwari ukwiye kubarindirira mu masanganzira</para>
  <para style="q2" vid="OBA 1:14">ngo wice abo muri bo bagerageza guhunga,</para>
  <para style="q1" vid="OBA 1:14">canke ngo utange abacitse kw’icumu ubashikirize abansi,</para>
  <para style="q2" vid="OBA 1:14">ku musi wabo w’amagorwa.<verse eid="OBA 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />“Umusi w’<char style="nd">Uhoraho</char> uri hafi</para>
  <para style="q2" vid="OBA 1:15">aho azocira urubanza amahanga yose.</para>
  <para style="q1" vid="OBA 1:15">Ivyo wakoze, ni vyo uzokorerwa;</para>
  <para style="q2" vid="OBA 1:15">ibikorwa vyawe bizogusubira ku mutwe ubwawe.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />Nk’uko wimaze inyota ku bantu banje uri ku musozi wanje wera,</para>
  <para style="q2" vid="OBA 1:16">ni ko wewe n’amahanga agukikije muzoramizwa igihano ndabaciriye;</para>
  <para style="q1" vid="OBA 1:16">muzonywa mwongere munywe,</para>
  <para style="q2" vid="OBA 1:16">kugeza muzimanganye.<verse eid="OBA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />Ariko umusozi Siyoni uzoba ubukiriro bw’abahunga;</para>
  <para style="q2" vid="OBA 1:17">uzoba wejejwe;</para>
  <para style="q2" vid="OBA 1:17">kandi Yakobo azoganza umugabane wiwe.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />Yakobo azoba nk’umuriro</para>
  <para style="q2" vid="OBA 1:18">Yosefu abe nk’urubeya;</para>
  <para style="q1" vid="OBA 1:18">Esawu na we azoba nk’ivyatsi vyumye,</para>
  <para style="q2" vid="OBA 1:18">maze bazomuturira bamuherengeteze.</para>
  <para style="q1" vid="OBA 1:18">Ntihazosigara n’uwo kuvuga inkuru</para>
  <para style="q2" vid="OBA 1:18">mu ba Esawu.”</para>
  <para style="q2" vid="OBA 1:18">Ni ko <char style="nd">Uhoraho</char> avuze.<verse eid="OBA 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />Abantu b’i Negebu bazokwegukira</para>
  <para style="q2" vid="OBA 1:19">imisozi ya Esawu,</para>
  <para style="q1" vid="OBA 1:19">n’abantu bo mu biyaya begukire</para>
  <para style="q2" vid="OBA 1:19">igihugu c’Abafilisitiya.</para>
  <para style="q1" vid="OBA 1:19">Bazokwibera mu mirima ya Efurayimu n’i Samariya,</para>
  <para style="q2" vid="OBA 1:19">kandi Benyamini azokwegukira Gileyadi.<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />Abajanywe ari inyagano ba Isirayeli bazogaruka i Kanani</para>
  <para style="q2" vid="OBA 1:20">bazokwegukira igihugu gushika i Zarefati;</para>
  <para style="q1" vid="OBA 1:20">abajanywe ari inyagano bava i Yerusalemu bari i Sefaradi bazogaruka</para>
  <para style="q2" vid="OBA 1:20">begukire ibisagara vy’i Negebu.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />Abazoba barokotse bazoduga ku Musozi Siyoni</para>
  <para style="q2" vid="OBA 1:21">ngo baganze imisozi ya Esawu.</para>
  <para style="q2" vid="OBA 1:21">Maze ubwami buzoba ari ubw’<char style="nd">Uhoraho</char>.<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>