\b  
\li1
\v 43 Tukita te'uximayatamete 'ikɨ waniwema mepɨhɨkɨtɨkai Tsika, Katsupa, Tawahuti,  
\v 44 Kerutsi, Tsihaka, Paruni,  
\v 45 Rewana, Hakawa, 'Akuwi,  
\v 46 Hakawi, Tsarimahi, Kanahani,  
