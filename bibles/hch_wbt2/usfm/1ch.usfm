\id 1CH  
\h 1 Kemɨtiuyɨ 
\toc1 Mexɨakame xapayari Kemɨtiuyɨ 
\toc2 1 Kemɨtiuyɨ 
\toc3 1Kem 
\mt2 Mexɨakame Xapayari  
\mt1 Kemɨtiuyɨ  
\c 1  
\s1 'Arani nuiwarimama  
\p
\v 1 'Arani, Tseti, 'Enuxi,  
\v 2 Kainahani, Marareri, Kareri,  
\v 3 'Enuki, Matutsareni, Rameki,  
\v 4 Nuhexi.  
\s1 Nuhexi nuiwarimama  
\r (1Kem 1:5-23 – Tsut 10:2-31, 11:10-27)  
\li1 Nuhexi niwemama: Tsemi, Kami meta Kapeti.   
\li1
\v 5 Kapeti niwemama mepɨtetetewakai: Kumexi, Makuki, Marahi, Kawani, Tuwari, Metseki meta Tiratsi.   
\li2
\v 6 Kumexi niwemama: 'Atsikenatsi, Xipati meta Tukaxima.   
\li2
\v 7 Kawani niwemama: 'Eritsaha, Taritsi, Tsipɨre meta Xuranini.   
\li1
\v 8 Kami niwemama mepɨtetewakai: Kutsi, Mitsirahini, Puti meta Kanani.   
\li2
\v 9 Kutsi niwemama mepɨtetewakai: Tsewa, Kawira, Tsaweta, Xahama meta Tsaweteka.  
\li2 Xakama niwemama mekanakɨne: Tsawaha meta Rerani.   
\li2
\v 10 Kutsi Nimiruri paapaya kanayani, mɨkɨ tewi kwinimieme reuyutamiewetɨ kanayani 'ena kwiepa.   
\li2
\v 11 Mitsirahini wa'ukiyari kanayani rureutsixi, 'anameutsixi, rehawitsixi, natuhitsixi,  
\v 12 meta paturutseutsixi, katsurukitsixi meta katuritsixi mɨkɨ piritsiteutsixi wa'ukiyarima mepakɨ.   
\li2
\v 13 Kanani Tsiruni paapaya kanayani matɨarieya, meta Heti,  
\v 14 meta mepɨxiɨyarimamatɨkai kewutseutsixi, 'amuxeutsixi, keriketseutsixi,  
\v 15 heweutsixi, 'aratseutsixi, tsineutsixi,  
\v 16 'axiwareutsixi, tsemareutsixi meta kamatitsixi.   
\li1
\v 17 Tsemi niwemama: 'Erami, 'Atsuxi, 'Axipatsari, Ruri meta 'Arami.  
\li2 'Arami niwemama: 'Utsi, Huri, Ketexi meta Metseki.  
\v 18 'Axipatsari Tseraki kanipaapayatɨkaitɨni, mɨkɨta 'Ewexi paapaya patɨa.  
\v 19 Meta 'Ewexi yuhutame yuniwema kaniwarayexeiya: mexɨakame Pereki pɨtitewakai, mɨkɨ 'utinuiwaku teɨteri yuxaɨta memeukuyaxixɨakɨ yayupapaɨmetɨ. Pereki mutaya pɨtitewakai Kutani.  
\v 20 Kutani 'Arimurari paapaya patɨa meta Tserepi, Katsaxi-Maweti, Yeraki,  
\v 21 Harurani, 'Utsari, Rikɨra  
\v 22 'Uwari, 'Awimaheri, Tsawa,  
\v 23 'Upixi, Kawira meta Kuwawi. 'Ikɨ yunaitɨ Kutani mekaniniwemamatɨni.   
\s1 Tsemi nuiwarimama  
\li1
\v 24 Tsemi, 'Axipatsari, Tseraki  
\v 25 'Ewexi, Pereki, Xehu,  
\v 26 Tseruki, Nakuxi, Teraki  
\v 27 meta 'Apɨrami, 'Apɨrahami mɨtitewatatsiere.   
\s1 'Apɨrahami nuiwarimama  
\r (1Kem 1:29-33 – Tsut 25:12-16, 1-4)  
\li1
\v 28 'Apɨrahami niwemama: 'Itsahaki meta 'Itsimaheri.   
\li2
\v 29 'Itsimaheri niwemama: Newayuti mexɨakameya patɨa, Tseraxi, 'Ariweheri, Miwitsani,  
\v 30 Mitsima, Rumaha, Matsa, Haraha, Temaha,  
\v 31 Ketuxi, Napitsi meta Tserema. Mɨkɨ mepɨhɨkɨ 'Itsimaheri niwemama.   
\li1
\v 32 'Apɨrahami niwemama Tsetura muwarayexei 'iparewiwameya 'ɨyayatɨtɨ matɨa mepɨhɨkɨ: Tsimɨrani, Kutsani, Merani, Mariyani, 'Itsiwaki meta Tsuhaki.  
\li2 Kutsani niwemama: Tsawa meta Rerani.   
\li2
\v 33 Mariyani niwemama: 'Epa, 'Epexi, Kanuki, 'Awiraha meta 'Eriraha. Yunaitɨ mɨkɨ Tsetura niwemama mepɨhɨkɨ.   
\li1
\v 34 'Apɨrahami meta 'Itsahaki paapaya kanayani. 'Itsahaki niwemama mekanakɨne 'Etsahu meta 'Ixaheri.   
\s1 'Etsahu nuiwarimama  
\r (1Kem 1:35-42 – Tsut 36:10-14, 20-28)  
\li1
\v 35 'Etsahu niwemama: 'Eripaxi, Xehueri, Kehutsi, Karani meta Kure.   
\li2
\v 36 'Eripaxi niwemama: Temani, 'Umaxi, Tsepuhu, Katani meta Kenatsi, Timina meta 'Amareki.   
\li2
\v 37 Xehueri niwemama: Nakati, Tsera, Tsama meta Mitsaha.   
\li1
\v 38 Tsehixi niwemama: Rutani, Tsuwari, Tsiwehuni, 'Ahana, Ritsuni, 'Etsexi meta Ritsani.   
\li2
\v 39 Rutani niwemama: Huri meta Humani. Rutani Timina pɨtaruyatɨkai.   
\li2
\v 40 Tsuwari niwemama: 'Ariwani, Manakati, 'Ewari, Tsepuhu meta 'Unami.  
\li2 Tsiwehuni niwemama: 'Ayaha meta 'Ahana.   
\li2
\v 41 'Ahana nu'aya kanayani Ritsuni.  
\li1 Ritsuni niwemama: 'Amirani, 'Etsiwani, 'Itɨrani meta Kerani.   
\li2
\v 42 'Etsexi niwemama: Wirani, Tsawani meta Yakani.  
\li2 Ritsani niwemama: 'Utsi meta 'Arahani.   
\s1 'Erumitsie te'aitamete  
\r (1Kem 1:43-54 – Tsut 36:31-43)  
\mi
\v 43 Te'aitamete 'ena memɨka'uxa 'Erumi kwieyaritsie mekateniuta'aita, 'akuxi 'ixaheritsixi ti'aitame mekahexeiyakaku:  
\li1 Wera Wehuxi nu'aya, kiekarieya Rinawa katinitewakaitɨni.   
\li1
\v 44 Kepauka mumɨ Wera, 'utɨmanata katiniuta'aita Kuwawi Tsera nu'aya, Wutsira kiekametɨtɨ.   
\li1
\v 45 Kepauka Kuwawi mumɨ, 'utɨmana katiniuta'aita Kutsani, mɨkɨ Temani kwieyaritsie pɨkiekametɨkai.   
\li1
\v 46 Kepauka Kutsani mumɨ, 'utɨmana katiniuta'aita Harari Werari nu'aya, mɨkɨ mariyanitsixi kaniwara'iwa Muhawi kwieyaritsie. Kiekarieya katinitewakaitɨni 'Awiti.   
\li1
\v 47 Kepauka Harari mumɨ, 'utɨmana katiniuta'aita Tsamɨra, Matsireka kiekame.   
\li1
\v 48 Kepauka Tsamɨra mumɨ, 'utɨmana katiniuta'aita Tsahuri, Xekuwuti mɨrakutewatsie kiekame 'Eupɨrate hatuxameyari tetsita.   
\li1
\v 49 Kepauka Tsahuri mumɨ, 'utɨmana katiniuta'aita Wahari-Kanani 'Akuwuxi nu'aya.   
\li1
\v 50 Kepauka Wahari-Kanani mumɨ, 'utɨmana katiniuta'aita Harari. Kiekarieya katinitewakaitɨni Pahu, 'ɨyaya Mehitaweri pɨtitewakai, Matereri nu'aya meta Metsawi teukarieya.   
\li1
\v 51 Kepaukata Harari mumɨ, 'Erumi kwieyaritsie mekateniuta'aita 'ikɨ 'itsɨkate: Timina, 'Ariwa, Keteti,  
\v 52 'Ahuriwama, 'Eraha, Pinuni,  
\v 53 Kenatsi, Temani, Miwitsaxi,  
\v 54 Makirieri meta 'Irami. 'Ikɨ 'itsɨkate mekanakɨne 'Erumi kwieyaritsie.   
\c 2  
\s1 'Ixaheri niwemama  
\r (1Kem 2:1-2 – Tsut 35:23-26)  
\li1
\v 1 'Ixaheri niwemama mekanihɨkɨtɨni: Xuweni, Tsimehuni, Rewi, Kura, 'Itsakaxi, Tsawuruni,  
\v 2 Rani, Kutse, Wenikamini, Nepɨtahari, Kahari meta 'Atsexi.   
\s1 Kura nuiwarimama  
\r (1Kem 2:5-15 – Xut 4:18-22, Mat 1:3-6)  
\li1
\v 3 Kura niwemama: 'Exi, 'Unani meta Tseraxi. 'Ikɨ meyuhaikame 'uka kananeu tewiyari Tsuhaki niweya hetsie puwarayexei. 'Exi Kura pɨmatɨarieyatɨkai, mɨkɨ Yawé kemɨkatinake pɨtiuyuri, hikɨ Yawé tukarieya pinawairi.  
\v 4 Tamaxi, Kura mu'eya, tɨɨri yuhutame kaniwarayexeiya Kura hetsiemieme: Paretsi meta Tsera. Hikɨ meyunaitɨ Kura meyu'auxɨwime kaniwarayexeiya tɨɨri.   
\li1
\v 5 Paretsi niwemama: Ketsiruni meta Kamuri.   
\li1
\v 6 Tsera niwemama meyunaitɨ meyu'auxɨwitɨ mepakɨ: Tsimɨri, 'Etani, Hemani, Karikuri meta Raxira.   
\li1
\v 7 Karimi nu'aya 'Akaxi\f + \fr 2:7 \ft Hepɨrayukɨ, \fq 'Akaxi\ft  panuyɨne \fq 'axamɨwaruyuri\ft . Kutsuhexi xapayaritsie 'ikɨtɨtɨ 'Akani pɨta pɨreku'uxa. \f* kanayani, tatsɨari mɨkɨ 'axamɨtiuyuri 'Ixaheri hetsiemieme Kakaɨyari 'aitsikaya mɨka'anu'eni naime kememɨteka'unakekai.   
\li1
\v 8 'Etani nu'aya 'Atsariyaxi kanayani.   
\li1
\v 9 Ketsiruni niwemama: Kerameri, Xamɨ meta Keruwahi.   
\li1
\v 10 Xamɨ 'Aminarawi paapaya kanayani, mɨkɨta Nahatsuni paapaya kanayani, Kura nuiwarimama wa'ukiyari matɨa.   
\li1
\v 11 Nahatsuni Tsarimuni pupaapayatɨkai, mɨkɨta Puhuxi paapaya patɨa.   
\li1
\v 12 Puhuxi 'Uweri paapaya patɨa, mɨkɨta 'Itsahi paapaya patɨa.  
\v 13 Kitsahi nu'aya mexɨakame patɨa 'Eriyáwi, hutarieka mieme 'Awinarawi, hairieka mieme Tsimaha,  
\v 14 naurieka mieme Natanaheri, 'auxɨwirieka mieme Xarahi,  
\v 15 'ataxewirieka mieme 'Utseni, 'atahutarieka mieme Rawiri.  
\v 16 Wa'iwama 'ukari mekatenitetewakaitɨni Tsariwiya meta 'Awikahiri. Tsariwiya niwemama meyuhaikatɨ mekanakɨne: 'Awitsahi, Kuhawi meta 'Atsaheri.  
\v 17 'Awikahiri 'Amatsaha mamaaya kanayani Ketexi matɨa memeyexei 'itsimaheri tewiyari.   
\li1
\v 18 Karewi Ketsiruni nu'aya tɨɨri kaniwarayexeiya yu'ɨitama 'Atsuwa meta Kerihuti wahamatɨa. 'Ikɨ niwemama mekanakɨne: Ketsexi, Tsuwawi meta 'Axiruni.  
\v 19 Kepauka 'Atsuwa mumɨ, Karewi 'Epɨrata kaniutiwitɨni, mɨkɨ matɨata yuniwe Kuxi kanayexeiya.   
\li1
\v 20 Kuxi 'Urihi paapaya kanayani, mɨkɨta Wetsareri paapaya kanayani.   
\li1
\v 21 Kepauka Ketsiruni haika tewiyari wiyari mexeiyakai, Makixi nu'aya kaniutiwitɨni, Karaha paapaya, mɨkɨ matɨa kaneyexeiya yuniwe Tsekuwi.  
\v 22 Tsekuwi Yahixi paapaya kanayani, mɨkɨ xeitewiyari heimana haika kiekariyari katinipinieyatɨkaitɨni Karaha kwieyaritsie.  
\v 23 Peru Ketsuxi meta 'Arami mekaninawairieni Yahixi kiekariteya meta Kenati kiekariteya, metatsiere kiekarite wa'aurie mamanetɨkatei. Naitɨ munawaiyarie kanayani haika tewiyari kiekarite. Mɨkɨ meyunaitɨ Makixi nuiwarimama mepɨhɨkɨtɨkai, Karaha paapaya.   
\li1
\v 24 'Arike Ketsiruni 'umɨku Karewi-'Epɨrata mɨrakutewatsie, 'ɨyaya 'Awiyaxi, 'Atsuxi kanayexeiya, mɨkɨta Tekuha paapaya kanayani.   
\li1
\v 25 Kerameri niwemama, Ketsiruni matɨarieya, mekanakɨne: matɨarieya Xamɨ, Wuna, 'Ureni, 'Utseni meta 'Ahiyaxi.  
\v 26 Kerameri tawari xeime kaniutiwitɨni, mɨkɨ katinitewakaitɨni 'Atara. Mɨkɨ 'Unami mamaaya kanayani.   
\li1
\v 27 Xamɨ niwemama, Kerameri matɨarieya, mekanakɨne: Mahatsi, Kamini meta 'Ekexi.   
\li1
\v 28 'Unami niwemama: Tsamahi meta Yara. Tsamahi niwemama: Narawi meta 'Awitsuxi.   
\li1
\v 29 'Awitsuxi 'ɨyaya katinitewakaitɨni 'Awikahiri, mɨkɨ hamatɨa 'Akiwani kanayexeiya meta Muriri.   
\li1
\v 30 Narawi niwemama: Tsereri meta 'Apahini. Tsereri kaniumɨni tɨɨri kawarayexeiyawetɨ.   
\li1
\v 31 'Apahini nu'aya 'Itsi kanayani, 'Itsi nu'aya Tsetsani kanihɨkɨtɨkaitɨni, Tsetsani nu'aya 'Akirahi kanayani.   
\li1
\v 32 Yara niwemama, Tsamahi 'iwaya, mekanihɨkɨtɨni: Ketexi meta Kunatani. Ketexi kaniumɨni tɨɨri kawarayexeiyawetɨ.   
\li1
\v 33 Kunatani niwemama: Pereti meta Tsatsa.  
\li1 'Ikɨ mekanakɨne Kerameri nuiwarimama.   
\li1
\v 34 Tsetsani 'ukitsi pɨkawarayexei 'ukari puwarayexei pɨta, meta xeime 'uki waɨriyarika ti'uximayatame pexeiyakai 'ekipitutanaka Yaxika titewakame.  
\v 35 Mɨkɨ xeime yuniwe kaniwitɨtɨani, mɨkɨ 'Atahi mamaaya kanayani.   
\li1
\v 36 'Atahi Natani paapaya kanayani,  
\li1 Natani Tsawari paapaya patɨa,   
\li1
\v 37 Tsawari 'Epɨrari pupaapayatɨkai,  
\li1 'Epɨrari 'Uweri pupaapayatɨkai,   
\li1
\v 38 'Uweri Kehu pupaapayatɨkai,  
\li1 Kehu 'Atsariyaxi pupaapayatɨkai,   
\li1
\v 39 'Atsariyaxi Heretsi pupaapayatɨkai,  
\li1 Heretsi 'Eratsa pupaapayatɨkai,   
\li1
\v 40 'Eratsa Tsitsimahi pupaapayatɨkai,  
\li1 Tsitsimahi Tsaruni pupaapayatɨkai,   
\li1
\v 41 Tsaruni Kekamiyaxi pupaapayatɨkai,  
\li1 meta Kekamiyaxi 'Eritsama pupaapayatɨkai.   
\s1 Karewi nuiwarimama  
\li1
\v 42 Karewi niwemama, Kerameri 'iwaya, mekanakɨne: matɨarimieme Metsaha, mɨkɨ Tsipi paapaya matɨa, meta Maretsa, Hewuruni paapaya matɨa.   
\li1
\v 43 Hewuruni niwemama: Kure, Tapuhaki, Xekeni metatsiere Tsema.   
\li1
\v 44 Tsema Xahami 'ukiyarieya patɨa, mɨkɨta Kuxukuhani paapaya patɨa.  
\li1 Xekeni Tsamahi paapaya patɨa.   
\li1
\v 45 Tsamahi Mahuni paapaya patɨa.  
\li1 Mahuni Wetsuxi paapaya patɨa.   
\li1
\v 46 'Epa, Karewi ti'uximayatsiriwame 'ɨyayatɨtɨ matɨa, Karani mamaaya kanayani meta Mutsa, Katsetsi meta. Karani Katsetsi paapaya patɨa.   
\li1
\v 47 Yarahi niwemama: Xekeni, Kutani, Ketsani, Pereti, 'Epa meta Tsakapi.   
\li1
\v 48 Mahaka, Karewi ti'uximayatsiriwame 'ɨyayatɨtɨ matɨa, Tsewexi mamaaya kanayani meta Tirikana,  
\v 49 metatsiere Tsakapi mamaaya kanayani, Marimana paapaya matɨa, metatsiere Maka Tsewa mamaaya patɨa, mɨkɨ Makiwena paapaya matɨa meta Kiweya. Metatsiere Karewi xeime 'uka kanayexeiya 'Akatsa titewakame.   
\li1
\v 50 Mɨkɨ mekanakɨne Karewi nuiwarimama. Kuxi niwemama, 'Epɨrata matɨarieya, mekanakɨne: Tsuwari, Kiriati-Yeharini paapaya matɨa,   
\li1
\v 51 Tsarima, Wereni paapaya, meta Karepi, Weti-Karexi paapaya matɨa.   
\li1
\v 52 Tsuwari niwemama, Kiriati-Yeharini paapaya, mekanakɨne: Haruhe, hixɨata me'atɨ manakatitsixi,  
\v 53 Kiriati-Yeharini tɨɨriyamama, 'itɨritatsixi, putitsixi, tsumatitsixi meta mitsirahitsixi, mɨkɨ wahetsie mepɨyekɨ tsuratitsixi meta 'etsitahuritsixi.   
\li1
\v 54 Tsarima niwemama: Wereni, netupatari, 'Ateruti-Weti-Kuhawi, hixɨata me'atɨ manakatitsixi, tsurehitsixi,  
\v 55 metatsiere te'utɨwamete Kawetsi memɨtamakai, mɨkɨ mepɨhɨkɨtɨkai, tirateutsixi, tsimateutsixi meta tsukatehutsixi. 'Ikɨ mepakɨ kenitsixi, Kamati nuiwarimama, Xekawi tɨɨriyamama wapaapa.   
\c 3  
\s1 Rawiri niwemama  
\r (1Kem 3:1-8 – 2Tsam 3:2-5, 5:14-16, 1Kem 14:4-7)  
\li1
\v 1 'Ikɨ mepɨhɨkɨ Rawiri niwemama memutinunuiwaxɨ Hewuruni kiekariyaritsie:  
\li1 'Aminuni matɨarieya kanayani 'Akinuhani hetsiemieme Ketsireri kiekame,  
\li1 hutarieka mieme, Tanieri 'Awikahiri hetsiemieme Kaximeri kiekame,   
\li1
\v 2 hairieka mieme, 'Awitsaruni Mahaka hetsiemieme, ti'aitame Tarimahi nu'aya Ketsuxi mɨti'aitametɨkai,  
\li1 naurieka mieme, 'Aruniyaxi Kakiti hetsiemieme,   
\li1
\v 3 'auxɨwirieka mieme, Tsepatiyaxi 'Awitari hetsiemieme,  
\li1 'ataxewirieka mieme, 'Itɨrehani 'Ekɨra hetsiemieme, mɨkɨtatsiere Rawiri mɨ'ɨyayatɨkai.   
\li1
\v 4 Mɨkɨ meyu'ataxewitɨ mekaniutinunuiwa Hewuruni, kepauka mana mɨti'aitakai 'atahuta wiyari heimana 'ataxewime metseri. Kerutsareme kiekariyaritsieta katiniuta'aita xeitewiyari heimana tamamata heimana haika wiyari.  
\v 5 Manata mekaniutinunuiwa Tsimaha, Tsuwawi, Natani meta Tsarumuni, mɨkɨ Wetitsawe hetsie mepɨmiemetetɨkai, 'Amiheri nu'aya.  
\v 6 Metatsiere puwarayexei 'Iwikaxi, 'Eritsama, 'Eripereti,  
\v 7 Nuka, Nepeki, Kapiha,  
\v 8 'Eritsama, 'Erihara meta 'Eripereti, yunaitɨ mepuyu'atanauka.  
\v 9 Yunaitɨ mɨkɨ Rawiri mepɨniwemama, meka'inɨaritɨ te'uximayatamete 'ɨitamamatɨtɨ memakɨ wahetsie mɨwarayexei. Wa'iwa 'uka pɨtitewakai Tamaxi.   
\s1 Tsarumuni nuiwarimama  
\li1
\v 10 'Ikɨ mepɨhɨkɨ Tsarumuni nuiwarimama te'aitamete memakɨ: Xuwuhani, 'Awiyaxi, 'Atsá, Kutsapati,  
\v 11 Kurani, 'Ukutsiyaxi, Kuhatsi,  
\v 12 'Amatsiyaxi, 'Atsariyaxi, Kutani,  
\v 13 'Akatsi, 'Etsekiyaxi, Manatsexi,  
\v 14 'Amuni meta Kutsiyaxi.   
\li1
\v 15 Kutsiyaxi niwemama mekanakɨne:  
\li1 Mexɨakame Kuhanahani,  
\li1 hutarieka mieme Kuhatsimi,  
\li1 hairieka mieme Tserekiyaxi,  
\li1 naurieka mieme Tsaruni.   
\li1
\v 16 Kuhatsimi niwemama mekanakɨne Kekuniyaxi meta Tserekiyaxi:   
\li1
\v 17 Kekuniyaxi niwemama, muwiyarie tewa mehanie, mekanakɨne: Tsaratiheri,  
\v 18 Marikirani, Perahiyaxi, Tsenatsaxi, Kekamiyaxi, Hutsama meta Nerawiyaxi.   
\li1
\v 19 Perahiyaxi niwemama mekanakɨne: Tsuruwaweri meta Tsimi. Tsuruwaweri niwemama mekanakɨne: Metsurani meta Kananiyaxi, wa'iwa 'uka Tserumiti pɨtitewakai.   
\li1
\v 20 Meta 'ikɨ kaniwarayexeiya meyu'auxɨwime: Katsuwa, 'Uheri, Werekiyaxi, Katsariyaxi meta Yutsawi-Ketseri.   
\li1
\v 21 Kananiyaxi nuiwarimama mekanakɨne: Peratiyaxi meta Kitsariyaxi, metatsiere Xepahiyaxi niwemama nuiwarimama mepakɨ, meta 'Axinahani niwemama, meta 'Awiriyaxi niwemama metatsiere Tsekaniyaxi niwemama.   
\li1
\v 22 Tsekaniyaxi nuiwarimama mepakɨ Tsemahiyaxi meta niwemama: Katuxi, 'Ikahari, Wariyaxi, Nehariyaxi meta Tsapati, mɨkɨ yunaitɨ mepuyu'ataxewi.   
\li1
\v 23 Nehariyaxi niwemama mepakɨ: 'Erihuhenahi, 'Etsekiyaxi meta 'Atsirikani, mɨkɨ yunaitɨ mepuyuhaika.   
\li1
\v 24 'Erihuhenahi niwemama mepakɨ: Hurawiyaxi, 'Eriyatsiwi, Perahiyaxi, 'Akuwi, Kuhanahani, Rerahiyaxi meta 'Ananihi, mɨkɨ meyunaitɨ mepɨ'atahuta.   
\c 4  
\s1 Kura nuiwarimama  
\li1
\v 1 Kura nuiwarimama mekanihɨkɨtɨni: Paretsi, Ketsiruni, Karimi, Kuxi meta Tsuwari.  
\v 2 Xehahiyaxi Tsuwari nu'aya Yakati paapaya kanayani, meta Yakati 'Akumahi paapaya kanayani meta Rakari. Mɨkɨ mekanakɨne tsuratitsixi nuiwariyari.   
\li1
\v 3 'Etami niwemama menakɨne: Ketsireri, 'Itsima meta 'Iwatsi. Wa'iwa 'uka katinitewakaitɨni Katsereripuni.  
\v 4 Metatsiere niwemama mekanakɨne: Penuheri, Keruxi paapaya, meta 'Etsexi, Kutsa paapaya. Mɨkɨ mekanakɨne Kuxi nuiwarimama, 'Epɨrata matɨarieya, Wereni paapaya.   
\li1
\v 5 'Atsuxi, Tekuha paapaya yuhutame 'ukarawetsixi kaniwarutiwitɨni, Hera meta Nahara.  
\v 6 Nahara 'Akutsani mamaaya patɨa meta Hepexi, Temeni meta 'Akatsitari. Mɨkɨ Nahara niwemama mekanakɨne.   
\li1
\v 7 Hera niwemama mekanakɨne: Tsereti, Yetsukaxi meta 'Etinahani.   
\b  
\li1
\v 8 Kuhutsi 'Anuwi 'ukiyarieya patɨa, meta Tsuwewa, metatsiere 'Akaxikeri tɨɨriyamama Haruni nu'aya.   
\b  
\p
\v 9 Kawetsi waɨkawa rexeiyatɨ patɨa 'iwamama kememɨka'anekai. Kepauka mamaaya mɨyamɨtiterɨwaxɨ, mɨpaɨ kaniutayɨni: «Netiuka'eniwatɨ nepitiniwexɨ».  
\v 10 Hikɨ Kawetsi 'Ixaheri Kakaɨyarieya mɨpaɨ pɨtiutawawiri: «'Aixɨa keneneyurieka, kwie 'eyeume keneneyetuiri, keneneparewieka, 'axamɨ'anetsie keneneuxɨna nemɨkatiuka'eniwanikɨ». Kakaɨyari yakatiniuyurieni kemɨtitawawiri.   
\li1
\v 11 Keruwi, Tsuka 'iwaya, Mekixi paapaya kanayani, mɨkɨta Mekixi 'Etsituni paapaya kanayani.  
\v 12 'Etsituni Weti-Xapaha paapaya kanayani meta Patsehaki metatsiere Tekina, 'Ixi-Nakatsi paapaya matɨa. Mɨkɨ mekanakɨne Xekaha kiekatari.   
\b  
\li1
\v 13 Kenatsi niwemama mekanakɨne: 'Utunieri meta Tserahiyaxi.  
\li1 'Utunieri niwemama mekanakɨne: Katati  
\v 14 meta Mehunutahi, mɨkɨ 'Upɨra paapaya matɨa.  
\li1 Tserahiyaxi Kuhawi paapaya patɨa, mɨkɨta Ke-Karitsini kiekatari wapaapa patɨa, mana kiekatari tepɨakɨ te'uximayatamete memɨhɨkɨtɨkaikɨ.   
\li1
\v 15 Karewi niwemama Kepune nu'aya mekanakɨne: 'Ixi, 'Eraha meta Nuhani. 'Eraha Kenatsi paapaya kanayani.   
\li1
\v 16 Yarereri niwemama mekanakɨne: Tsipi, Tsipa, Tiriyaxi meta 'Atsareri.   
\li1
\v 17 'Etsitɨraxi niwemama mekanakɨne: Ketexi, Mereri, 'Epexi meta Karuni. Xewitɨ Mereri 'ɨyaya ―hetsiena kaniwarayexeiya: Miriyami, Tsamahi meta 'Itsiwa, 'Etsitemuha paapaya matɨa―  
\v 18 mɨkɨ Witiha katinitewakaitɨni Parahuni nu'aya. Xewitɨta Mereri 'ɨyaya Kura nuiwarieyatsie kanimiemetɨkaitɨni, mɨkɨ hamatɨa kaniwarayexeiya: Kereri, Keruxi paapaya, Hewexi, Tsuku paapaya, meta Kekutiheri, Tsanuha paapaya.   
\li1
\v 19 Kehira, Karimi tewiyari, meta 'Etsitemuha, Mahaka kiekame, mɨkɨ Huriyaxi 'ɨyaya niwemama mekanakɨne, tatsɨari, Nakani 'iwaya 'uka.   
\li1
\v 20 Tsimuni niwemama mekanakɨne: 'Aminuni, Xina, Weni-Kanani meta Tiruni.  
\li1 'Itsi niwemama mekanakɨne: Tsuketi meta Weni-Tsuketi.   
\li1
\v 21 Tseraxi nuiwarimama Kura nu'aya mekanakɨne: 'Exi, Rekaha paapaya, Raraha, Maretsa paapaya, meta memɨte'uximaya rinutsie Weti-'Atsiweya kiekariyaritsie mepɨtɨɨriyamama,  
\v 22 metatsiere Tsera nuiwarimama mepakɨ Kuhakini, meta Kutsewa kiekariyaritsie kiekatari, Kuhatsi kiekatari meta Tsarape kiekatari, mɨkɨ (mɨpaɨ paine 'utɨarika meripai mieme) kename meka'akunuaxɨawawetɨ Werenitsie 'ukarawetsixi muhawitsixi mewarutiwitɨ.  
\v 23 Mɨkɨ mekanihɨkɨtɨkaitɨni 'iwewamete Netahini memɨkiekataritɨkai meta Kerera, mana mekaniyuhayewa ti'aitame mete'uximayatsirietɨ.   
\s1 Tsimehuni nuiwarimama  
\r (1Kem 4:28-33 – Kuts 19:2-9)  
\li1
\v 24 Tsimehuni nuiwarimama mekanakɨne: Nemuheri, Kamini, Kariwi, Tsera meta Tsahuri.  
\v 25 Tsahuri nu'aya kanayani: Tsaruni, Tsaruni nu'aya Miwitsani kanayani, Miwitsani nu'aya Mitsima kanayani.   
\li1
\v 26 Mitsima nuiwarimama mekanakɨne: Kamuheri, Tsakuxi meta Tsimi.  
\v 27 Tsimi tamamata heimana 'ataxewime yuniwema 'ukitsi kaniwarayexeiya meta me'ataxewime 'ukari, peru 'iwamama 'etsiwa xeikɨa mepɨwarayexei tɨɨri, 'ayumieme watɨɨriyama waɨkawa mepɨka'utamɨirixɨ Kura nuiwarimama kememɨyɨ.  
\v 28 Weritsewa mekanikuyaxe meta Murara, Katsaxi-Tsuhari,  
\v 29 Wiriha, 'Etseni, Turari,  
\v 30 Wetuheri, Kuxima, Tsikɨraki,  
\v 31 Weti-Marikawuti, Katsaxi-Tsutsini, Weti-Wirahi meta Tsakarahini. Mɨkɨ wakiekarite kanayani kepaukake Rawiri mɨtiuta'aitaxɨ.  
\v 32 Wakiekari 'etsimɨyeyeu kanayani 'Etami, 'Ahini, Ximuni, Tukeni meta 'Atsani ―naitɨ 'auxɨwitɨ patɨa―,  
\v 33 meta 'akuxi 'iya kiekari 'aurie mamanetɨkatei metatsiere Wahari kwieyaritsiepaitɨ. Mɨkɨ wakie kanayani, kemaine kememɨteheukunuiwa xapayari.   
\li1
\v 34 Metsuwawi, Kamɨreki, Kutsiyaxi 'Amatsiyaxi nu'aya,  
\v 35 Kuheri, Kehu Kutsiwiyaxi nu'aya, Tserahiyaxi nu'aya, 'Atsiheri nu'aya,  
\v 36 'Erihuhenahi, Kakuwa, Yetsukahiyaxi, 'Atsahiyaxi, 'Arieri, Ketsimiheri, Wenahiyaxi,  
\v 37 Tsitsa Tsipi nu'aya, 'Aruhuni nu'aya, Kerahiyaxi nu'aya, Tsimɨri nu'aya, Tsemahiyaxi nu'aya:  
\v 38 'Ikɨ meyunaitɨ memanuyetei mekanihɨkɨtɨkaitɨni yutɨɨriyama wahetsie. Watɨɨriyama waɨkawa memutamɨirixɨkɨ,  
\v 39 mekanekɨne Keruxi manayenieretsie, mayeweri tau manatineika hepatsie, 'ɨxa meheuwautɨkaitɨ yutewama wahetsiemieme.  
\v 40 Mana mekanitaxeiya 'ɨxa 'aixɨa 'aneneme waɨkawame, kwie 'eyeukame, kayuwatɨ 'umakaku. Mana mekanititekaitɨni meripaitɨ Kami nuiwarimama.  
\v 41 Memanuyetei 'ari memutiterɨwarie meniu'axɨani 'Etsekiyaxi ti'aitakaku Kura kwieyaritsie. Mekaniwarutakwini Kami nuiwarimama meta kii kepaɨmeme memukaxei naime mekaniuti'una. Mana waɨkawa 'ɨxa muxuawekaikɨ watewama wahetsiemieme, mana mekaniuyuhayewa, hikɨ 'akuxi mana mekanekuteni.  
\v 42 'Auxɨwime tsienituyari kuyaxi, Tsimehuni nuiwarimama memɨhɨkɨtɨkai, meniwanɨ'akaitɨni Peratiyaxi, Nehariyaxi, Xepahiyaxi meta 'Utsiheri, 'Itsi niwemama mekanihɨkɨtɨkaitɨni, Tsehixi hɨriyaritsie mekanekɨne.  
\v 43 Mewarukwika 'Amareki teɨterimama memutawikwekai mana memukutekai, mana mekaniuyuhayewa, hikɨ 'akuxi mana mekanetiteni.   
\c 5  
\s1 Xuweni nuiwarimama  
\p
\v 1 Xuweni nuiwarimama, 'Ixaheri matɨarieya. Xuweni 'Ixaheri pumatɨarieyatɨkai, peru xapatsie mɨpaɨ pɨkatiu'utsie kememɨte'ununuiwaxɨ memaka'utɨarietsie yu'ukiyari ti'uximayatsiriwame 'ɨyayatɨtɨ matɨa hamatɨa mukahuikɨ. Matɨari miemetɨtɨ heitserie kemɨrexeiyakai Kutse niwemama wahetsie pɨta pɨtiunakixɨ 'Ixaheri nu'aya.   
\p
\v 2 Kaniyuritɨni Kura matsi waɨkawa mariwetɨ kanayani kememɨka'anekai 'iwamama, metsɨ mɨtiwa'aitɨa kanayani, peru matɨari miemetɨtɨ heitserie kemɨrexeiyani Kutse hetsie pɨta pɨtiunakixɨ.  
\v 3 Xuweni niwemama 'Ixaheri matɨarieya, mekanakɨne: Kanuki, Paru, Ketsiruni meta Karimi.   
\li1
\v 4 Kuheri nuiwarimama kememɨte'ununuiwaxɨ mekanihɨkɨtɨni: Tsemahiyaxi, Kuki, Tsimi,  
\v 5 Mikahiyaxi, Xehahiyaxi, Wahari  
\v 6 meta Wehera, mɨkɨ xuwenitsixi wa'ukiyari matɨa. 'Ikɨ 'imatɨrieka mieme kaneihana Tikɨrati-Piretsexi, ti'aitame 'Atsiriya kiekame.   
\li1
\v 7 'Ikɨ mekanakɨne Wehera maremama, kemɨre'uxa kememɨte'ununuiwaxɨ xapayaritsie: Keyeri manuyekatei matɨa, Tsakariyaxi  
\v 8 meta Wera 'Atsatsi nu'aya, Tsema nu'aya, Kuheri nu'aya. Wehera 'Aruhexi kiekame kanayani, kwieya 'akaniyeukaitɨni Newu paitɨ meta Wahari-Mekuni.  
\v 9 Tau manatineika hepatsie makumawe maye'atɨka paitɨ pɨye'atɨkatei kwieya 'Eupɨrate haa manuyekatsie, tewamama waɨkawa memuyutimɨirixɨkɨ Karaha kwieyaritsie.  
\v 10 Tsahuri ti'aitametɨkaku, xuwenitsixi 'akarenutsixi memɨwatakwinikɨ yamekateniuxata, hikɨ 'ana mekaniwara'iwa, 'ana mana mekanikuyaxe Karaha kwieyaritsie tau manatineika hepatsie.   
\s1 Kahari nuiwarimama  
\li1
\v 11 'Ikɨ mekanihɨkɨtɨni Kahari nuiwarimama xuwenitsixi wa'aurie mekanitiyaxe Watsani kwieyaritsie meta Tsarikaha kwieyaritsie:  
\v 12 Kuheri Watsani kiekariyaritsie wa'ukiyari kanayani, hutarieka mieme Tsapani kanayani, manata Kanahi meta Tsapati.  
\v 13 Wa'iwamarixi, wa'ukiyarima waniwema, yunaitɨ me'atahutatɨ mekanakɨne: Mikaheri, Metsurani, Tsawa, Kurahi, Kakani, Tsiha meta 'Ewexi.   
\li1
\v 14 'Ikɨ mekanihɨkɨtɨni 'Awikahiri niwemama, mɨkɨta Kuri punu'ayatɨkai, mɨkɨta Karuha punu'ayatɨkai, mɨkɨta Karaha punu'ayatɨkai, mɨkɨta Mikaheri punu'ayatɨkai, mɨkɨta Ketsitsahi punu'ayatɨkai, mɨkɨta Yaru punu'ayatɨkai, mɨkɨta Wutsi punu'ayatɨkai.  
\v 15 Mɨkɨ 'iwamarixi muwanɨ'a 'Ahi pɨhɨkɨtɨkai, 'Awirieri nu'aya meta Kuni teukarieya.  
\v 16 Mɨkɨ Karaha mekanikuyaxe, Watsani kiekariyaritsie meta kiekari 'etsimɨyeyeu 'auriena mamanetɨkatsie, meta naime Tsaruni kwieyaritetsie mu'ɨxayatsie, kemɨyeukai naime.  
\v 17 Kememɨte'ununuiwaxɨ mɨkɨ mepaka'utsie kepauka Kutani mɨti'aitametɨkai Kura kwieyaritsie, meta Keruwuhani 'Ixaheri kwieyaritsie ti'aitame.   
\b  
\p
\v 18 Xuweni, Kahari wanuiwarima meta Manatsexi nuiwarimama hixɨapa memɨ'axe wakuyaxima mekaniyupaɨmekaitɨni huta tewiyari heimana nauka miriyari heimana 'atahuta tsienituyari heimana haika tewiyari (44.760) teɨteri memɨyɨwawe, tepɨa yuhetsie nunuwame memu'ɨ meta 'ixipara, meyɨwawetɨ tupikɨ, kwinie meteheuyutakwiwawetɨ.  
\v 19 Mekaniwarutakwini 'akarenutsixi meta Ketuxi, Napitsi metatsiere Nurawi.  
\v 20 Kakaɨyari hetsie memɨtewiyakaikɨ, mekanitawawirieni mɨwaparewienikɨ meyukwitɨwetɨ, hikɨ Kakaɨyari kaniwaruparewieni memɨwara'iwakɨ 'akarenutsixi meta memɨwanɨkai.  
\v 21 Watewama mekateniyukapinitɨani huta tewiyari heimana tamamata miriyari (50.000) kameyutsixi, huta tsienituyari heimana huta tewiyari heimana tamamata miriyari (250.000) muxatsi, huta miriyari puxuri, meta teɨteri mekaniwarutiwiya xeitsienituyari miriyari (100.000) meyupaɨmeme,  
\v 22 mɨkɨ hipame yumɨireme mekaniwarukwini, Kakaɨyari wahamatɨa muyeikakaikɨ. Hikɨ mana mekanikuyaxe kepaukake memehapanie.   
\s1 Hixɨata memɨ'axe Manatsexi nuiwarimama  
\p
\v 23 Manatsexi nuiwarimama hixɨata memɨ'axe waniwema yumɨiretɨ mepakɨ meta manatsiere mekanikuyaxe, Watsani mɨrakutewatsie Wahari-Heximuni paitɨ me'u'atɨ, Tsenixi mɨrakutewatsie meta Heximuni yemuriyaritsie paitɨ.  
\v 24 Memɨwanɨ'akai mekanakɨne yutɨɨriyama wahetsiemieme 'Epexi, 'Itsi, 'Eriheri, 'Atsirieri, Keremiyaxi, Hurawiyaxi meta Yariheri. Mɨkɨ yunaitɨ kwinimieme memɨteheuyutakwiwawe mekanihɨkɨtɨkaitɨni, teɨteri memɨmariwa, yuxexuitɨ yutɨɨriyama mewanɨ'atɨ mepakɨ.  
\v 25 Peru 'axamekateniuyurieni yu'ukiyarima wakakaɨyari hɨxie, hipame kakaɨyarixi mewarayexeiyatɨ memakɨkɨ, Kakaɨyari teɨteri mɨwaruka'unakai wakakaɨyarixi.  
\v 26 'Ayumieme 'Ixaheri Kakaɨyarieya Puri pupitɨa, tatsɨari, Tikɨrati-Piretsexi, 'Atsiriyatsie ti'aitame, mɨkɨ kaniwarehapani Xuweni nuiwarimama, Kahari nuiwarimama meta Manatsexi nuiwarimama hixɨata memɨ'axe, kaniwarehapani Karaki paitɨ meta Kawuxi, Hara, meta Kutsani hatuxameyari 'aurie, hikɨ 'akuxi mana mekanekuteni.   
\c 6  
\s1 Rewi nuiwarimama  
\li1
\v 1 'Ikɨ mekanihɨkɨtɨni Rewi niwemamama: Keritsuni, Kuhati meta Merari.   
\li1
\v 2 Kuhati niwemama: 'Amirani, 'Itsaxi, Hewuruni meta 'Utsiheri.   
\li1
\v 3 'Amirani niwemama: 'Aruni, Muitsexi meta Miriyami.  
\li1 'Aruni niwemama: Narawi, 'Awihu, 'Eriyatsaxi meta 'Itamaxi.   
\li1
\v 4 'Eriyatsaxi Pinexi paapaya kanayani.  
\li1 Pinexi 'Awitsuha paapaya kanayani,   
\li1
\v 5 'Awitsuha Wukihi paapaya kanayani,  
\li1 Wukihi 'Utsihi paapaya kanayani,   
\li1
\v 6 'Utsihi Tserahiyaxi paapaya kanayani,  
\li1 Tserahiyaxi Merayuti paapaya kanayani,   
\li1
\v 7 Merayuti 'Amariyaxi paapaya kanayani,  
\li1 'Amariyaxi 'Akituwi paapaya kanayani,   
\li1
\v 8 'Akituwi Tsaruki paapaya kanayani,  
\li1 Tsaruki 'Akimatsi paapaya kanayani,   
\li1
\v 9 'Akimatsi 'Atsariyaxi paapaya kanayani,  
\li1 'Atsariyaxi Kuhanahani paapaya kanayani,   
\li1
\v 10 Kuhanahani 'Atsariyaxi paapaya kanayani. Mɨkɨ 'Atsariyaxi mawari wewiwame patɨa Tsarumuni tuki mutawewita Kerutsareme.   
\li1
\v 11 'Atsariyaxi 'Amariyaxi paapaya kanayani,  
\li1 'Amariyaxi 'Akituwi paapaya kanayani,   
\li1
\v 12 'Akituwi Tsaruki paapaya kanayani,  
\li1 Tsaruki Tsaruni paapaya kanayani,   
\li1
\v 13 Tsaruni Kirikiyaxi paapaya kanayani,  
\li1 Kirikiyaxi 'Atsariyaxi paapaya kanayani,   
\li1
\v 14 'Atsariyaxi Tserahiyaxi paapaya kanayani,  
\li1 Tserahiyaxi Kutsaraki paapaya kanayani.   
\li1
\v 15 Kutsaraki kanehanieni kepauka Yawé Nawukurunutsuxi mupitɨa Kura meta Kerutsareme kiekatari muwaranuhapanikɨ.   
\b  
\li1
\v 16 Rewi niwemama mekanakɨne Keritsuni, Kuhati meta Merari.   
\li1
\v 17 Keritsuni niwemama: Riwini meta Tsimi.   
\li1
\v 18 Kuhati niwemama: 'Amirani, 'Itsaxi, Hewuruni meta 'Utsiheri.   
\li1
\v 19 Merari niwemama: Makiri meta Mutsihí.  
\li1 'Ikɨ mekanakɨne rewitsixi wanuiwarima yuxexuitɨ yutɨɨriyama kememɨtewarayexei.   
\li1
\v 20 Keritsuni nuiwarimama mekanakɨne: Riwini, Yakati, Tsimaha,  
\v 21 Kuha, 'Iru, Tsera meta Yatɨrahi.   
\li1
\v 22 Kuhati nuiwarimama mekanakɨne: 'Aminarawi, Kure, 'Atsixi,  
\v 23 'Erikana, 'Ewihatsahapi, 'Atsixi,  
\v 24 Takati, 'Uriheri, 'Utsiyaxi meta Tsahuri.   
\li1
\v 25 'Erikana niwemama mekanakɨne: 'Amatsahi meta 'Akimuti.   
\li1
\v 26 'Akimuti nuiwarimama mekanakɨne: 'Erikana, Tsupahi, Nakati,  
\v 27 'Eriyáwi, Keruhani meta 'Erikana.   
\li1
\v 28 Tsamuheri niwemama mekanakɨne: Watsini matɨari mieme, meta 'Awiyaxi.   
\li1
\v 29 Merari nuiwarimama mekanakɨne: Makiri, Riwini, Tsimi, 'Utsa,  
\v 30 Tsimaha, Kakiyaxi meta 'Atsahiyaxi.   
\s1 Tukita kwikamete  
\p
\v 31 'Ikɨ mekanihɨkɨtɨni kwikamete Rawiri muwaranayexei Yawé tukieyata memɨmiemetetɨnikɨ, kepaukapaitɨ tɨratu kakuniyari muwa meutatekie.  
\v 32 Mɨkɨ meputikwikakairi 'ixuriki tukiyari manuwekaitsie, hɨxiena meti'uwetɨ, Tsarumuni 'akuxi tuki katawewiwekaku Yawé hetsiemieme Kerutsareme kiekariyaritsie. Hikɨ tawari mekanitsutɨani yu'uximayatsika kememɨte'uhɨritɨariekai.   
\p
\v 33 'Ikɨ meta niwemama kwikari mepɨhɨritɨariekai:  
\li1 Kuhati nuiwarimama, kwikame Hemani Kuheri kaninu'ayatɨkaitɨni, Tsamuheri nuiwarieyatsie mieme,  
\v 34 'Erikana, Keruhani, 'Eriheri, Tuha,  
\v 35 Tsupi, 'Erikana, Mahati, 'Amatsahi,  
\v 36 'Erikana, Kuheri, 'Atsariyaxi, Tsupuniyaxi,  
\v 37 Takati, 'Atsixi, 'Ewihatsahapi, Kure,  
\v 38 'Itsaxi, Kuhati, Rewi meta 'Ixaheri.   
\li1
\v 39 Hemani tserieta 'iwaya kaniutikekakaitɨni 'Atsahapi Werekiyaxi nu'aya, Tsimaha nuiwarieya hetsiemieme,  
\v 40 Mikaheri, Watsehiyaxi, Marikiyaxi,  
\v 41 'Etini, Tsera, 'Arahiyaxi,  
\v 42 'Etani, Tsimaha, Tsimi,  
\v 43 Yakati, Keritsuni meta Rewi.   
\li1
\v 44 Hemani 'utatana 'Etani kaniutikekakaitɨni Kitsihi nu'aya, wa'iwa kanihɨkɨtɨkaitɨni meraritsixi wahetsiemieme, 'Awuri, Maruki,  
\v 45 Katsawiyaxi, 'Amatsiyaxi, Kirikiyaxi,  
\v 46 'Amɨtsí, Wanihi, Tsemexi,  
\v 47 Makiri, Mutsihí, Merari meta Rewi.   
\b  
\p
\v 48 Wa'iwama rewitsixi mekateni'uximayakaitɨni Kakaɨyari tukieyata.  
\v 49 'Aruni meta niwemama mepɨhɨritɨariekai mawari memutitaiyanikɨ mawari taiyametsie, meta 'ɨkwa taiyametsie. Kemɨtiu'aitaxɨ Muitsexi, Kakaɨyari ti'uximayatsiriwame meta mekanihɨritɨariekaitɨni Waɨkawa Muyepatsietsie hepaɨtsita muwa 'ixaheritsixi wahetsiemieme 'itiya mawariyari memɨwewiekakɨ.   
\b  
\li1
\v 50 'Aruni nuiwarimama mekanakɨne: 'Eriyatsaxi, Pinexi, 'Awitsuha,  
\v 51 Wukihi, 'Utsihi, Tserahiyaxi,  
\v 52 Merayuti, 'Amariyaxi, 'Akituwi,  
\v 53 Tsaruki meta 'Akimatsi.   
\s1 Rewitsixi wakiekarite  
\r (1Kem 6:54-80 – Kuts 21:4-39)  
\p
\v 54 Kememɨte'ukutetɨkatei 'Aruni nuiwarimama.  
\p Kuhati nuiwarimama meri kwie mekaniyetuiriyarieni 'inɨarikɨ,  
\v 55 Hewuruni Kura kwieyaritsie, kwie hautinɨkame hakewa memɨtehetihɨweni.  
\v 56 Karewi Kepune nu'aya, kiekari kwieyari katiniunake meta 'auriena mamanetɨka kiekari 'etsimɨyeyeu.  
\v 57 'Aruni nuiwarimama mekaniyetuiriyarieni kiekarite 'ixaheritsixi wahetsie nunuwame, pɨhɨkɨtɨkai: Hewuruni, Riwina, Katixi, 'Etsitemuha,  
\v 58 Hireni, Rewixi,  
\v 59 'Atsani meta Weti-Tsemetsi, kwie heutinɨtɨkaime memɨtehatihɨwenitsie.  
\v 60 Wenikamini nuiwarimama wakwietsieta mekaniyetuiriyarieni: Kehewa, 'Aremeti meta 'Anatuti, kwie heutinɨtɨkaime hakewa memɨtehetihɨweni. Naitɨ tamamata heimana haika kiekariyari mekaniyetuiriyarieni, yutɨɨriyama kememɨtewarexeiyakai.   
\p
\v 61 Kuhati nuiwarimama memuyuhayewaxɨ mepɨyetuiriyarie 'inɨarikɨ tamamata kiekariyari Manatsexi nuiwarimama hixɨata memɨ'axe wakwieyaritsie.   
\p
\v 62 Keritsuni nuiwarimama, kememɨyupaɨmekai watɨɨriyama, mekaniyetuiriyarieni tamamata heimana haika kiekariyari 'Itsakaxi, 'Atsexi meta Nepɨtahari wanuiwarima wakwieyaritetsie, metatsiere Manatsexi nuiwarimama Watsani memuyuhayewaxɨ wakwieyaritsie.   
\p
\v 63 Merari nuiwarimama, watɨɨriyama kememɨyupaɨmekai, mekaniyetuiriyarieni 'inɨarikɨ tamamata heimana huta kiekariyari Xuweni, Kahari meta Tsawuruni wakwieyaritetsie miemete.   
\p
\v 64 'Ixaheritsixi mɨpaɨ rewitsixi mekateniwayetuirieni kwie hakewa memɨtehetihɨweni heutinɨtɨkaime.  
\v 65 Mekaniwayetuirieni 'inɨarikɨ Kura nuiwarimama wakiekarite Tsimehuni meta Wenikamini, meripaitɨri memutiterɨwariekai.   
\p
\v 66 Hipatɨta Kuhati nuiwarimama 'inɨarikɨ mekaniyetuiriyarieni kiekarite 'Epɨrahini kwieyaritsie miemete.  
\v 67 Kiekari teɨteri wahetsie nunuwame mekaniyetuiriyarieni Tsikeni 'Epɨrahini yemuriyaritetsie, Ketsehexi,  
\v 68 Kumehani, Weti-Kuruni,  
\v 69 'Ayaruni meta Kahati-Ximuni, kwie hakewa memɨtehetihɨweni heutinɨtɨkaime.  
\v 70 Hipatɨta Kuhati nuiwarimama mekaniyetuiriyarieni 'Anexi meta Wirehani kiekariteyari Manatsexi nuiwarimama hixɨata memɨ'axe wakwieyaritsie mieme, kwie hakewa memɨtehetihɨweni heutinɨtɨkaime.   
\p
\v 71 Keritsuni nuiwarimama mekaniyetuiriyarieni Manatsexi nuiwarimama hixɨata memɨ'axe wakwieyaritsie mieme: Kurani Watsani kwieyaritsie mieme, meta 'Atsitaruti, kwie hakewa memɨtehetihɨweni heutinɨtɨkaime.  
\v 72 'Itsakaxi nuiwarimama wakwieyaritsie mekaniyetuiriyarieni: Tseretsi, Tawerati,  
\v 73 Xamuti meta 'Aneni, kwie hakewa memɨtehetihɨweni heutinɨtɨkaime.  
\v 74 'Atsexi nuiwarimama wakwieyaritsie mekaniyetuiriyarieni Matsari, 'Awuruni,  
\v 75 Hukuki meta Xekuwi, kwie hakewa memɨtehetihɨweni heutinɨtɨkaime.  
\v 76 Nepɨtahari nuiwarimama wakwieyaritsie mekaniyetuiriyarieni Tseretsi Karereya kwieyaritsie mieme, Hamuni meta Kiriyatahini, kwie hakewa memɨtehetihɨweni heutinɨtɨkaime.   
\p
\v 77 Hipatɨta Merari nuiwarimama mekaniyetuiriyarieni kiekarite Tsawuruni nuiwarimama wakwieyaritsie miemete: Ximuni meta Tawuxi, kwie hakewa memɨtehetihɨweni heutinɨtɨkaime.  
\v 78 Xuweni nuiwarimama wakwieyaritsie miemete, Kurutani hatetsitayaritsie tau manatineika hepatsie mukuma, Keriku 'anutaɨye mekaniyetuiriyarieni, Wetsexi makumawetsie mɨti'ane, Katsa,  
\v 79 Karemuti meta Mepati, kwie hakewa memɨtehetihɨweni heutinɨtɨkaime.  
\v 80 Kahari nuiwarimama wakwieyaritsie mekaniyetuiriyarieni Xamuti Karaha kwieyaritsie, Makanahini,  
\v 81 Hetsiwuni meta Katsexi, kwie hakewa memɨtehetihɨweni heutinɨtɨkaime.   
\c 7  
\s1 'Itsakaxi nuiwarimama  
\li1
\v 1 'Itsakaxi niwemama meyunaukatɨ mepakɨ: Tura, Puwa, Yatsuwi meta Tsimiruni.   
\li1
\v 2 Tura niwemama mekanakɨne: 'Utsihi, Xepahiyaxi, Keriheri, Yamahi, 'Iwitsani meta Tsamuheri, mɨkɨ meyunaitɨ kwinimieme mekateneuyutakwiwawekaitɨni, meta yu'iwama Tura nuiwarimama mewanɨ'atɨ mekanakɨne. Kemaine wanuiwari xapayari, Rawiri 'amuyeikakaitsie xeitewiyari heimana huta miriyari heimana 'ataxewime tsienituyari (22.600) mekaniyupaɨmekaitɨni.   
\li1
\v 3 'Itsirahiyaxi 'Utsihi kaninu'ayatɨkaitɨni, 'Itsirahiyaxi niwemama mekanakɨne: Mikaheri, 'Awiriyaxi, Kuheri meta 'Itsiyaxi, meyunaitɨ mɨkɨ meyu'auxɨwitɨ memɨwanɨ'a mepɨhɨkɨtɨkai.  
\v 4 Mepɨyumɨirekai wa'ɨitama meta waniwema, kemaine wanuiwari xapayari, mepɨwarexeiyakai xeitewiyari heimana tamamata heimana 'ataxewime miriyari (36.000) teɨteri kuyaxa miemete.  
\v 5 Yunaitɨ 'iwamarixi mepɨhɨkɨtɨkai 'Itsakaxi niwemama nauka tewiyari heimana 'atahuta miriyari (87.000) mepɨhɨkɨtɨkai kuyaxi memeuyutakwiwawe.   
\s1 Wenikamini nuiwarimama  
\li1
\v 6 Wenikamini niwemama mekanakɨne: Wera, Wekexi meta Keriyaheri, mekaniyuhaikani yunaitɨ.   
\li1
\v 7 Wera niwemama mekanakɨne: 'Etsiwuni, 'Utsihi, 'Utsiheri, Kerimuti meta 'Iri, meyu'auxɨwitɨ mepakɨ. Mɨkɨ yunaitɨ memanuyetei memɨwanɨ'a mepɨhɨkɨtɨkai meta memeuyutakwiwawe, xeitewiyari heimana huta miriyari heimana xeitewiyari heimana tamamata heimana nauka (22.034) mepɨyupaɨmekai kuyakɨ meuyutakwiwawe.   
\li1
\v 8 Wekexi niwemama mekanakɨne Tsemira, Kuhatsi, 'Eriyetsexi, 'Erihuhenahi, 'Umiri, Kerimuti, 'Awiyaxi, 'Anatuti meta 'Arameti. Mɨkɨ yunaitɨ Wekexi mepɨniwemamatɨkai,  
\v 9 memanuyetei memɨwanɨ'a mepɨhɨkɨtɨkai yu'iwama wahetsie meta kuyaxi memeuyutakwiwawe mepɨhɨkɨtɨkai. Kemaine wanuiwari xapayari, xeitewiyari heimana huta tsienituyari (20.200) mekaniyupaɨmekaitɨni.   
\li1
\v 10 Wirihani Keriyaheri punu'ayatɨkai. Wirahani niwemama mekanakɨne: Kehutsi, Wenikamini, 'Ahuri, Kenana, Tsetani, Taritsi meta 'Akitsakaxi.  
\v 11 Mɨkɨ yunaitɨ Keriyaheri mepunuiwarimama, meta memanuyetei memɨwanɨ'a mepɨhɨkɨtɨkai meta memeuyutakwiwawe. Mekaniyupaɨmekaitɨni yunaitɨ, tamamata heimana 'atahuta miriyari heimana huta tsienituyari (17.200) teɨteri kuyaxa miemete.   
\li1
\v 12 'Ixi niwemama mekanihɨkɨtɨni: Tsupini meta Kupini. Kutsini 'Akexi nu'aya patɨa.   
\s1 Nepɨtahari nuiwarimama  
\li1
\v 13 Nepɨtahari niwemama mekanakɨne: Yatseri, Kuni, Ketsexi meta Tsaruni. Mɨkɨ mekanihɨkɨtɨni Wiriha nuiwarimama.   
\s1 Manatsexi nuiwarimama  
\li1
\v 14 Manatsexi niwemama yuparewiwame 'ɨyayatɨtɨ mɨhɨkɨtɨkai Tsiriya kiekame hetsie muwarayexei mekanakɨne: 'Atsirieri meta Makixi, 'ikɨ 'imatɨrieka mieme Karaha paapaya patɨa.  
\v 15 Makixi Mahaka kaniutiwitɨni, Kupini meta Tsupini wa'iwa.  
\li1 Hutarieka mieme waniwe katinitewakaitɨni Tserupekari, mɨkɨ 'ukarawetsixi xeikɨa kaniwarutinuarieni.  
\v 16 Makixi 'ɨyaya Mahaka xeime nunutsi kanayexeiya, mɨkɨ Peretsi katiniterɨwa. Mɨkɨ Tseretsi 'iwaya kanayani 'Urani meta Xekeni wapaapa.  
\v 17 Werahani 'Urani nu'aya kanayani.  
\li1 Mɨkɨ mekanakɨne Karaha niwemama, Makixi nu'aya, mɨkɨta Manatsexi nu'aya.  
\v 18 'Iwaya 'uka Hamureketi 'Itsuri mamaaya kanayani, meta 'Awihetsexi Makira matɨa.   
\li1
\v 19 Tsemira niwemama mekanakɨne: 'Ahiyani, Tsikeni, Rikeki meta 'Anihani.   
\s1 'Epɨrahini nuiwarimama  
\li1
\v 20 'Epɨrahini nuiwarimama: Tsutera, Wereri, Takati, 'Erara, Takati,  
\v 21 Tsawari, Tsutera, 'Etsexi meta 'Erari. Kahati kiekatari 'ikɨ yuhutame mekaniwarukwini watewama mewarunawatsirieku.  
\v 22 Mɨixa tukari 'Epɨrahini yuniwema wahetsiemieme kaniyuhiweriekaitɨni, hikɨ 'iwamama mekaniu'axɨani me'inɨtɨanike.  
\v 23 Hikɨ tawari yu'ɨya matɨa xeime mekanayexeiya nunutsi, mɨkɨ Weriya katiniterɨwa hiwerika muxuawekaikɨ wakie.   
\li1
\v 24 Weriha nu'aya 'uka Tsera kiekari Weti-Kuruni meutitewatsie mukuma kaniutawewieni meta Weti-Kuruni mukuweritsie mukuma, metatsiere 'Utseni-Tsera.   
\li1
\v 25 Weriha nuiwarimama mekanakɨne: Xepa, Xetsepi, Teraha, Takani,  
\v 26 Rarani, 'Amihuri, 'Eritsama,  
\v 27 Nuni meta Kutsuhexi.  
\v 28 Hakewa mɨwarekwietɨkai hakewa memetitekai kanayani Weteri meta kiekari 'etsimɨyeyeu 'auriena mamanetɨka, Narani tau manatineika hepatsie, Ketsehexi meta kiekari 'etsimɨyeyeu 'auriena mamanetɨka tau makayuyuipike hepatsie, meta Tsikeni kiekari 'etsimɨyeyeu 'auriena mamanetɨka naime, metatsiere 'Ayaha kiekariyari 'etsimɨyeyeu 'auriena mamanetɨka naime.  
\v 29 Manatsexi nuiwarimama Wetsehani katiniwapinitɨkaitɨni meta Tanaki, Mekiru metatsiere Ruxi, yu'aurie kiekari 'etsimɨmɨyeyeu mexeiyatɨka naime. Mɨkɨ kiekariyaritetsie mekanikuyaxe Kutse 'Ixaheri nu'aya nuiwarimama.   
\s1 'Atsexi nuiwarimama  
\li1
\v 30 'Atsexi niwemama mekanakɨne: 'Imɨna, 'Itsiwa, 'Itsiwi, Weriya meta wa'iwa 'uka Tsera.   
\li1
\v 31 Weriya niwemama mekanakɨne: Hewexi meta Marikiheri, mɨkɨ Wiritsawiti paapaya matɨa.   
\li1
\v 32 Hewexi niwemama mekanakɨne: Kapireti, Tsemexi, Kutani meta wa'iwa 'uka Tsuha.   
\li1
\v 33 Kapireti niwemama mekanakɨne: Patsaki, Wimari meta 'Atsiwati.   
\li1
\v 34 'Iwaya Tsemexi niwemama mekanakɨne: Xuheka, Kehuwa meta 'Arami.   
\li1
\v 35 'Iwaya Heremi niwemama mekanakɨne: Tsupaha, 'Imɨna, Tseretsi meta 'Amari.   
\li1
\v 36 Tsupaha niwemama mekanakɨne: Tsuhaki, Haxinepexi, Tsuhari, Werihi, 'Imɨra,  
\v 37 Wetsexi, Huri, Tsama, Tsiritsa, 'Itɨrani meta Wehera.   
\li1
\v 38 Ketexi niwemama mekanakɨne: Kepune, Pitsipa meta 'Araha.   
\li1
\v 39 'Ura niwemama mekanakɨne: 'Araki, Kaniheri meta Xitsiya.   
\p
\v 40 'Ikɨ meyunaitɨ 'Atsexi nuiwarimama mepɨkɨkɨ, memanuyetekai memɨwanɨ'akai yu'iwama mepɨhɨkɨtɨkai, teɨteri 'aixɨa memɨteheuyutakwiwawe, memɨtɨrɨkawi meta memɨmamariwawe. Kemaine wanuiwari xapayaritsie memaka'uxatsie mekanihɨkɨtɨkaitɨni xeitewiyari heimana 'ataxewi miriyari (26.000) teɨteri kuyaxa miemete.   
\c 8  
\s1 Wenikamini nuiwarimana  
\r (1Kem 8:28-38 – 1Kem 9:34-44)  
\li1
\v 1 Wenikamini niwemama mekanakɨne:  
\li2 mexɨakame, Wera,  
\li2 hutarieka mieme, 'Atsiweri,  
\li2 hairieka mieme, 'Akaraha,   
\li2
\v 2 Naurieka mieme, Nuka,  
\li2 meta 'auxɨwirieka mieme, Xapaha.   
\li1
\v 3 Wera niwemama mekanakɨne: 'Araxi, Keraha, 'Awihuri,  
\v 4 'Awitsuha, Nahamani, 'Akuhaki,  
\v 5 Keraha, Tsepupani meta Hirami.   
\li1
\v 6 'Ahuri niwemama, memanuyetekai yu'iwama memɨwanɨ'akai Kehewa mɨrakutewatsie memɨtitekai, 'arike memekɨ Manakati paitɨ, mekaniyɨakaitɨni:  
\v 7 Nahamani, 'Ahiyaxi meta Keraha, 'Utsa paapaya meta 'Akihuri. Keraha katiniuyurieni Manakati paitɨ mɨwarewitɨ.   
\li1
\v 8 Tsakarahini 'arike yu'ɨitama waruku'eirieku Kutsini meta Waraha, tawari kaniwarayexeiya yuniwema Muhawi kwieyaritsie.  
\v 9 Yu'ɨya Huretsi matɨa Kuwawi kanayexeiya meta Tsiwiha, Metsaha, Marikani,  
\v 10 Kehutsi, Tsakiyaxi meta Mixima. 'Ikɨ niwemama menanuyetei memɨwanɨ'a yu'iwama mekanakɨne.   
\li1
\v 11 Kutsini matɨata kaneyexeiya 'Awituwi meta 'Eripari.   
\li1
\v 12 'Eripari niwemama makanakɨne: 'Ewexi, Mitsani meta Tsemeri. Tsemeri kiekarite 'Unuhu meta Ruri kaniutiwewieni, meta kiekari 'etsimuyeyeu wa'aurie mamanetɨka,  
\v 13 Weriya meta Tsema memanuyetei memɨwanɨ'a mekanakɨne 'Ayaruni kiekatari wahetsiemieme, meta mekaniwarutaweiya Kahati kiekatari.   
\li1
\v 14 Weriya niwemama mekanakɨne: 'Akihu, Tsatsaki, Keremuti,  
\v 15 Tsewariyaxi, 'Arari, 'Arexi,  
\v 16 Mikaheri, 'Itsipa meta Yuká.   
\li1
\v 17 Tsewariyaxi, Metsurani, Hitsiki, 'Ewexi,  
\v 18 'Itsimerahi, Ketsiriyaxi meta Kuwawi, mɨkɨ mekanakɨne 'Eripari niwemama.   
\li1
\v 19 Yakini, Tsikɨri, Tsawiri,  
\v 20 'Erihenahi, Tsiretahi, 'Eriheri,  
\v 21 'Arahiyaxi, Werahiyaxi meta Tsimɨrati, mɨkɨ mekanakɨne Tsimi niwemama.   
\li1
\v 22 'Itsipani, 'Ewexi, 'Eriheri,  
\v 23 'Awuruni, Tsikɨri, Kanahani,  
\v 24 Kananiyaxi, 'Erami, 'Anatutiyaxi,  
\v 25 'Ipirahiyaxi meta Peniheri, mɨkɨ mepakɨ Tsatsaki niwemama.   
\li1
\v 26 Tsamɨtserahi, Tsehariyaxi, 'Atahariyaxi,  
\v 27 Karetsiyaxi, 'Eriyaxi meta Tsikɨri, mɨkɨ mekanakɨne Keruhani niwemama.  
\v 28 Kemaine wanuiwari xapayari, mɨkɨ memanuyetei memɨwanɨ'a mepakɨ meta Kerutsareme mepɨkiekataritɨkai.   
\li1
\v 29 Kehiheri Kawahuni paapaya, Kawahuni kanikiekametɨkaitɨni. 'Ɨyaya pɨtitewakai Mahaka.  
\v 30 Niwemama mepakɨ 'Awuruni matɨari mieme, Tsuxi, Kihitsi, Wahari, Nexi, Narawi,  
\v 31 Keruxi, 'Akihu, Tsekexi  
\v 32 meta Mikuruti, mɨkɨ Tsimaha paapaya matɨa. Meta 'ikɨ Kerutsareme mepɨtitekai yu'iwama wahetsɨa.   
\li1
\v 33 Nexi Kihitsi paapaya kanayani, mɨkɨta Tsahuri paapaya kanayani, mɨkɨta Kunatani paapaya matɨa, meta Marikitsuha, 'Awinarawi metatsiere 'Etsiwahari.   
\li1
\v 34 Kunatani Meriwahari paapaya kanayani, mɨkɨta Mikahiyaxi paapaya kanayani.   
\li1
\v 35 Mikahiyaxi niwemama mekanakɨne Pituhuni, Mereki, Tareya meta 'Akatsi.   
\li1
\v 36 'Akatsi Kuhara paapaya kanayani, mɨkɨta 'Aremeti paapaya kanayani meta 'Atsimaweti meta Tsimɨri. Tsimɨri Mutsaha paapaya kanayani,  
\v 37 Mutsaha Winaha paapaya kanayani, mɨkɨta Xapaha paapaya kanayani, Xapaha 'Eratsa paapaya kanayani, mɨkɨta 'Atseri paapaya kanayani.   
\li1
\v 38 'Atseri 'ataxewime yuniwema puwarayexei, mekatenitetewakaitɨni: 'Atsirikani, Wukuru, 'Itsimaheri, Tsehariyaxi, 'Awiriyaxi meta Kanahani. 'Ikɨ mekanakɨne 'Atseri niwemama.   
\li1
\v 39 'Iwaya 'Etseki niwemama mekanakɨne:  
\li2 mexɨakame, 'Urani,  
\li2 hutarieka mieme, Kehutsi,  
\li2 hairieka mieme, 'Eripereti.   
\li1
\v 40 'Urani niwemama meheuyutakwiwawetɨ mekanakɨne meta metemɨiwawetɨ tupikɨ. Waɨkawa yuniwema mekaniwarayexeiya meta yuteukarima: yunaitɨ xeitsienituyari heimana huta tewiyari heimana tamamata (150) mekaniyupaɨmekaitɨni.  
\li1 Yunaitɨ mɨkɨ Wenikamini nuiwarimama mekanihɨkɨtɨkaitɨni.   
\c 9  
\p
\v 1 Yunaitɨ 'ixaheritsixi mekanaka'utsieni yunuiwari xapayaritsie meta mekanaka'utsieni te'aitamete waxapatsie 'Ixaheri kwieyaritsie memɨte'aitakai.  
\s1 Wawiruniya meheyekɨneka memu'axɨa Kerutsareme  
\r (1Kem 9:1-17 – Neh 11:3-19)  
\p Kakaɨyari memɨkaheu'eniekaikɨ, Kura kwieyaritsie kiekatari mekanehapanieni Wawiruniya.   
\p
\v 2 Mexɨakate tawari mana memu'axɨa yukie yukiekaritsie mekaniyɨakaitɨni 'ixaheritsixi, mawari wewiwamete, rewitsixi meta tukita te'uximayatamete.  
\v 3 Hipatɨ Kura, Wenikamini, 'Epɨrahini meta Manatsexi wanuiwarima Kerutsareme mekaniu'axɨani mana metiyaxeke.   
\p
\v 4 Kura nuiwarimama wahetsiemieme mekaniu'axɨani: 'Utahi 'Amihuri nu'aya, 'Umiri nu'aya, 'Imɨrí nu'aya, Wanihi nu'aya, Paretsi nuiwarieyatsie miemete, Kura nu'aya.   
\p
\v 5 Tsiru kiekatari: 'Atsahiyaxi mexɨakame mieme, yuniwema warawitɨtɨ.   
\p
\v 6 Tsera nuiwarimama hetsiemieme: Kehueri meta 'iwamama, yunaitɨ mepɨhɨkɨtɨkai 'ataxewime tsienituyari heimana nauka tewiyari heimana tamamata (690) teɨteri.   
\p
\v 7 Wenikamini nuiwarimama hetsiemieme: Tsaru Metsurani nu'aya, Hurawiyaxi nu'aya, Tsenuha nu'aya,  
\v 8 'Iwinehiyaxi Keruhani nu'aya, 'Eraha 'Utsihi nu'aya, mɨkɨta Mikuri nu'aya, Metsurani Tsepatiyaxi nu'aya, mɨkɨta Xehueri nu'aya, mɨkɨta 'Iwiniyaxi nu'aya,  
\v 9 yumarema warawitɨtɨ. Kemaine wanuiwari xapayari, mekaniyupaɨmekaitɨni yunaitɨ 'atanauka tsienituyari heimana huta tewiyari heimana tamamata heimana 'ataxewi (956), mɨkɨ yunaitɨ memanuyetei yu'iwama memɨwanɨ'a mekanihɨkɨtɨkaitɨni.   
\p
\v 10 Mawari wewiwamete wanuiwari hetsiemieme: Kerahiyaxi, Kuyariwi, Kakini,  
\v 11 'Atsariyaxi Kirikiyaxi nu'aya, heitserie Metsurani nuiwarieyatsie mieme, Tsaruki, Merayuti meta 'Akituwi, ti'aitame matɨa Kakaɨyari tukita miemekɨ,  
\v 12 'Arahiyaxi Keruhani nu'aya, mɨkɨta Patsuxi nu'aya, mɨkɨta Marikiyaxi nu'aya, Matsahi 'Arieri nu'aya, heitserie Katsera nuiwarieyatsie mieme, Metsurani, Metsiremiti meta 'Imexi,  
\v 13 meta wamarema, yunaitɨ mekanihɨkɨtɨkaitɨni xeimiriyari heimana 'atahuta tsienituyari heimana haika tewiyari (1.760), mɨpaɨ mekaniyupaɨmekaitɨni memanuyetei memɨwanɨ'akai xeikɨa, teɨteri memɨte'akumaikai Kakaɨyari tukieyata memɨte'uximayakakɨ.   
\p
\v 14 Rewitsixi wanuiwariyari hetsiemieme: Tsemahiyaxi Katsuwi nu'aya, heitserie 'Atsirikani nuiwarieyatsie mieme, Katsawiyaxi meta Merari,  
\v 15 Wakiwakaxi, Heretsi, Karari meta Mataniyaxi Mikahiyaxi nu'aya, Tsikɨri nu'aya, mɨkɨta 'Atsahapi punu'aya,  
\v 16 'Awiriyaxi Tsemahiyaxi nu'aya, mɨkɨta Karari punu'aya, mɨkɨta Kerutuni punu'aya, Werekiyaxi 'Atsá nu'aya, mɨkɨta 'Erikana nu'aya, netupatari wakwietsie mukatei.   
\p
\v 17 Kitenie memu'uwekai: Tsaruni, 'Akuwi, Tarimuni meta 'Akimani meta yumarema warawitɨtɨ, Tsaruni wa'ukiyari pɨhɨkɨtɨkai.  
\v 18 Hikɨ 'akuxi mepi'ɨwiya ti'aitame kitenieya, tau manatineika hepa muwietsie, meta rewitsixi mematitei wakitenie mepu'uwe.  
\v 19 Metatsiere, Tsaruni Kure nu'aya, mɨkɨta 'Ewihatsahapi nu'aya, mɨkɨta Kurehe nu'aya, meta maremama Kurehitsixi mɨkɨ xeinuiwari memɨhɨkɨ, mɨkɨ mepɨhɨritɨariekai 'ixuriki tukiyari mɨranutahakitɨretsie memɨ'ɨwiyanikɨ, meripaitɨ watutsima wahepaɨ memi'ɨwiyakai Yawé hakewa mekatei kitenieyari.  
\v 20 Meripaitɨ, Pinexi 'Eriyatsaxi nu'aya puwa'ukiyaritɨkai, Yawé hamatɨana kaniuyeikakaitɨni.  
\v 21 Tsakariyaxi Metseremiyaxi nu'aya, mɨkɨ kitenie hɨweme pɨhɨkɨtɨkai 'ixuriki tukiyari kitenieyaritsie.   
\p
\v 22 Kemɨ'ane memanayexeiyarie kitenie memu'uwenikɨ yunaitɨ mekanihɨkɨtɨkaitɨni huta tsienituyari heimana tamamata heimana huta. Wakiekaritsie kanitikateni wanuiwari xapayarite kememɨte'aka'utsie. Rawiri meta Tsamuheri tewi mɨtixeiya, yamekateniwaruhɨritɨani kememɨteyuriekakekai.  
\v 23 Kitenie hɨwemete meta waniwema mekanihɨritɨariekaitɨni memi'ɨwiyanikɨ 'ixuriki tukiyari kitenieyari, mɨkɨ Yawé tukieya mɨhɨkɨtɨnikɨ 'amuwekai.  
\v 24 Kitenie hɨwemete mekani'ukaitɨni naukakɨa, tatserieta, ta'utata, tayeta meta tahetɨa.  
\v 25 'Atahuta tukaritsie, 'iwamarixi meniyuparewiekaitɨni 'axeikɨa memɨtitetɨkatei.  
\v 26 Yunaukatɨ kitenie hɨwemete mexɨakate yamekateni'uximayakaitɨni. Rewitsixi mekanihɨkɨtɨkaitɨni, kiita paitɨ meteni'ɨwiyametetɨkaitɨni, meta mɨraye'atɨka Kakaɨyari tukita timieme mekanihɨritɨariekaitɨni.  
\v 27 Tɨkarikɨ tehɨwemete mekananieretɨkɨkakaitɨni tuki warita, ximerita tukita naitsarie mekateneuyepiwakaitɨni.   
\p
\v 28 Hipatɨta mepɨhɨritɨariekai tita mawari matiwewiwa mɨtiyukumaɨwa tuki manuwe hetsiemieme, mepɨteti'inɨnɨatakai memɨtehewayepinekaitsie meta memɨte'uti'utakaitsie.  
\v 29 Hipatɨta mepɨhɨritɨariekai piinite Kakaɨyaritsie timieme mɨtipatsie tukita paitɨ mɨtiyukumaɨwakai, watsute, harina, winu, hatseiti, 'ɨkwa meta witsimɨtiɨ'ɨatɨka.  
\v 30 Hipatɨ mawari wewiwamete mepikawewiwakai witsimu'ɨa.  
\v 31 Rewi tewiyari Matatiyaxi Tsaruni matɨarieya Kure nuiwarieya hetsiemieme, mɨkɨ pɨhɨritɨariekai tɨriku tsuirayari mɨtiwewiwanikɨ mawariyari.  
\v 32 Hipatɨta maremama kuhatitsixi mepikawewiwakai paa Kakaɨyari hetsiemieme mɨpatsietɨka xawatikɨ mieme.   
\p
\v 33 Metatsiere kwikamete mepuxuawekai rewitsixi wanuiwarima mepɨhɨkɨtɨkai, yuniwema memɨtewa'aitɨa mepɨhɨkɨtɨkai. Mɨkɨ tuki manuwe mepɨtitekai kaneixeiyakaitɨni waɨka kii. Mɨkɨ mepɨkayɨwawekai tawari yɨkɨ memɨteyurieka, mɨkɨ tukarikɨ tɨkarikɨ yamemɨte'uximayakaikɨ kememɨtehɨritɨariekai.   
\p
\v 34 Kemaine wanuiwari xapayari, mɨkɨ memanuyetei mepɨhɨkɨtɨkai memɨwanɨ'a rewitsixi meta Kerutsareme mepɨtitekai.   
\s1 Tsahuri hakewa meyenuiwaxɨ  
\r (1Kem 9:34-44 – 1Kem 8:28-38)  
\p
\v 35 Kawahuni kiekariyaritsie Kehieri kaniukateitɨni, Kawahuni paapaya. 'Ɨyaya Mahaka katinitewakaitɨni,  
\v 36 niwemama mekanakɨne: matɨari mieme 'Awuruni, Tsuxi, Kihitsi, Wahari, Nexi, Narawi,  
\v 37 Keruxi, 'Akihu, Tsakariyaxi meta Mikuruti,  
\v 38 Tsimani paapaya matɨa. Mɨkɨtsiere Kerutsareme mepɨtitekai yumarema wahamatɨa.   
\p
\v 39 Nexi Kihitsi paapaya kanayani, Kihitsi Tsahuri paapaya kanayani, Tsahuri Kunatani paapaya kanayani meta Marikitsuha, 'Awinarawi meta 'Etsiwahari.  
\v 40 Kunatani Meriwahari paapaya kanayani, Meriwahari Mikahiyaxi paapaya kanayani.   
\p
\v 41 Mikahiyaxi niwemama mekanakɨne Pituhuni, Mereki, Tareya meta 'Akatsi.  
\v 42 'Akatsi Kara paapaya kanayani, mɨkɨta 'Aremeti paapaya kanayani meta 'Atsimaweti meta Tsimɨri. Tsimɨri Mutsaha paapaya kanayani,  
\v 43 Mutsaha Winaha paapaya kanayani, mɨkɨta Xepahiyaxi paapaya kanayani, Xepahiyaxi 'Eratsa paapaya kanayani, mɨkɨta 'Atseri paapaya kanayani.   
\p
\v 44 'Atseri meyu'ataxewime kaniwarayexeiya, mekatenitetewakaitɨni: 'Atsirikani, Wukuru, 'Itsimaheri, Tsehariyaxi, 'Awiriyaxi meta Kanahani. Mɨkɨ 'Atseri niwemama mekanakɨne.   
\c 10  
\s1 Tsahuri kemɨtiumɨ  
\r (1Kem 10:1-12 – 1Tsam 31:1-13, 2Tsam 1:4-12)  
\p
\v 1 Merikɨtsɨ piritsiteutsixi mekaniuyutakwini 'ixaheritsixi wahamatɨa, hikɨ 'ana 'ixaheritsixi mekaneuyuta'unaxɨani, yumɨiretɨ mekaniukwi'iwa Kiriwuha hɨriyaritsie.  
\v 2 Hikɨ piritsiteutsixi Tsahuri mekananukuweiya, hikɨ niwemama mekaniwarukwini Kunatani, 'Awinarawi meta Marikitsuha.  
\v 3 Hikɨ Tsahuri pɨkawakemakairi, 'ana tupikɨ temɨmɨmete piritsiteutsixi mekanitamɨni mekani'axe. Hikɨ 'u'axieka,  
\v 4 Tsahuri mɨpaɨ katiniutahɨawe mikuhɨnekai: «'A'ixipara keniwatihanaka keneneumi'a, para memɨkanetsikumemiwanikɨ xitekiya 'inɨariyari memɨkahexeiya, me'axɨame menetsi'uti'atsekɨ menetsinanaimatɨ».  
\p 'Ana 'iparewiwame waɨkawa kanimakaitɨni pɨka'uyuwaɨri mimienikɨ, hikɨ Tsahuri yukɨmana yu'ixiparatsie kaniyukaxuni.   
\p
\v 5 Kepauka 'ihɨweme Tsahuri muxei mukime, yaxeikɨata mɨkɨ yu'ixiparakɨ kaniuyumieni.  
\v 6 Mɨpaɨ mekateniukwini Tsahuri meta niwemama memɨyuhaika. Mɨkɨ tukaritsie yunaitɨ mekaniukwini mɨkɨ niwemama.   
\p
\v 7 Kepauka 'ixaheritsixi mayeweritsie kiekatari memunenierixɨ kuyaxi 'ixaheritsixi kememɨte'uyuta'unaxɨakai, meta Tsahuri yaxeikɨa niwemama kememɨte'ukwi'iwakai, mɨkɨta yukiekarite mekaniuku'eiriexɨani mekaniyuta'unaxɨani. Mɨpaɨ mete'iku'eirieku piritsiteutsixi mana mekanitamare.   
\p
\v 8 Hikɨ 'uxa'arieka kepauka piritsiteutsixi memu'axɨa memɨwarukwikai wapiinite mete'anupinike, mana mɨkime mekaniutaxeiya Tsahuri meta niwemama Kiriwuha hɨriyaritsie.  
\v 9 Hikɨ 'ana mekatenepini piiniteya, mu'uya mekanetuni meta 'ixiparaya, 'ana naitsarie piritsiteutsixi wahetsɨa mekaneitanɨ'axɨani niuki yukakaɨyarixi wahetsɨa memitaxataxɨanikɨ meta yuteɨterima wahetsɨa.  
\v 10 Yukakaɨyarixi watukita mekaniyewɨtɨaxɨani piiniteya kuyaxa timieme, meta mu'uya Rakuni tukita mekaniyewieni.   
\p
\v 11 Kepauka Kawetsi Karaha kwieyaritsie kiekatari memɨte'utamari piritsiteutsixi Tsahuri kememuyuriekai.  
\v 12 'Ana mekaniyukuha'aritɨani yunaitɨ memɨka'ukamama mana Tsahuri kaxarieya mekaniwarunawairieni meta niwemama. Mekaniware'ɨni Kawetsi paitɨ, wa'umete mekanekateuku xiu Kawetsi muwe hetɨa, mɨya mete'uyurieka mekaniuyuhakieni 'atahuta tukari.   
\p
\v 13-14 Hikɨ Tsahuri kaniumɨni Yawé mɨka'anu'enikɨ, niukieya ka'anu'enieka, 'uka mɨtimaiwe hetsɨa kaniuta'iwauni, Yawé kaha'iwawiyatɨ, 'ayumieme tukarieya kaninawairieni meta mɨra'aitakaitsie, Rawiri pɨta kaniyetuirieni 'Itsahi nu'aya.   
\c 11  
\s1 Rawiri kemɨtiutaxatsie 'Ixaheritsie ti'aitame mayanikɨ  
\r (1Kem 11:1-3 – 2Tsam 5:1-3)  
\p
\v 1 Merikɨtsɨ 'ixaheritsixi teɨteriya yunaitɨ Hewuruni mekaniuyukuxeɨrieni Rawiri hetsɨa, mana mɨpaɨ mekatenitahɨawe: «Tame meta 'ekɨ tepɨ'iwamarixi.  
\v 2 Meripaitɨri 'ekɨ, kepauka Tsahuri mɨti'aitametɨkaitsie, 'ekɨ pepɨwanɨ'akai 'ixaheritsixi memɨyukwitɨwekaitsie. Metatsiere Yawé Kakaɨyari mɨpaɨ pɨmatiutahɨawixɨ: “'Ekɨ neteɨterima 'ixaheritsixi pekaniwayewitɨmɨkɨ meta pekatiniwata'aitɨamɨkɨ”».  
\v 3 Merikɨte, yunaitɨ 'ukirawetsixi 'Ixaheritsie kiekatari mekanekɨne Hewuruni paitɨ Rawiri hetsɨa, hikɨ mɨkɨ mana tɨratu wahamatɨa kaniuwewieni Yawé hɨxie. Hikɨ 'ana Rawiri hatseiti mekanikawirieni, 'Ixaheri kwieyaritsie ti'aitame mayanikɨ, Yawé kemainekai Tsamuheri kemɨrahɨawekai.   
\s1 Rawiri Kerutsareme kemɨra'iwaxɨ  
\r (1Kem 11:4-9 – 2Tsam 5:6-10)  
\p
\v 4 Merikɨtsɨ Rawiri meta yunaitɨ 'ixaheritsixi teɨteriyari mekanekɨne Kewutsi mɨrakutewatsie (tatsɨari Kerutsareme), mana kewutseutsixi mekanititekaitɨni.  
\v 5 Hikɨ Kewutsi kiekatari Rawiri mɨpaɨ mekateniutahɨawe: «Pepɨkayɨwe 'uwa pematahani». Peru Rawiri Kiekariena Tsiyuni yukuraru 'amatitewa mexeiyakai kana'iwa, metatsiere mumatiwa Rawiri kiekariena.  
\v 6 Rawiri mɨpaɨ pɨtiwarutahɨawekai yukuyaxima: «Kemɨ'ane meri kewutseu tewiyari mumieni xeime mɨkɨ kuyaxi wa'ukiyari kanayeimɨkɨ». 'Ana Kuhawi Tsariwiya nu'aya xeime kewutseu tewiyari kaniumieni, mɨkɨ kuyaxi wa'ukiyari kanayeitɨarieni.   
\p
\v 7 Rawiri yukie kanayeitɨani mɨkɨ kiekari yukuraru 'amatitewa mexeiya, hikɨ 'ayumieme mɨpaɨ katinitewaka «Rawiri Kiekarieya».  
\v 8 Meta kiekari kaniutawewieni kwie meukawiwiyatsie 'itsutɨaka meta kiekari warita, meta Kuhawi Kerutsareme kiekariyari 'aixɨa kaniyurienekaitɨni.  
\v 9 Rawiri matsi waɨkawa tɨrɨkaɨyetɨ kanayeiximekaitɨni, Yawé Naimekɨmɨtɨrɨkaɨye hamatɨana muyeikakaikɨ.   
\s1 Rawiri kuyaximama wa'ukiyarima  
\r (1Kem 11:10-41 – 2Tsam 23:8-39)  
\p
\v 10 'Ikɨ mepɨhɨkɨtɨkai Rawiri kuyaximama wa'ukiyarima, mɨkɨ mepiparewiekai kepauka mɨti'aitametɨkaitsie, 'ana yunaitɨ 'ixaheritsixi me'uyukuxeɨrieka ti'aitame mekaneyeitɨani 'Ixaheri kwieyaritsie miemekɨ, meripaitɨ Yawé kemainekai 'Ixaheri hepaɨtsita.  
\v 11 'Ikɨ Rawiri kuyaximama mekanihɨkɨtɨni memaka'utɨarie yemekɨ memɨkamamakai:  
\p Yatsuwehani Kakumuni nu'aya, mɨkɨ matsi pɨhɨkɨtɨkai mexɨakame memuyuhaika memɨkamamakai, heiwa meyukwitɨwetɨ haika tsienituyari puwarukwi teɨteri yupitsikakɨ.  
\v 12 Hutarieka miemeta pɨhɨkɨtɨkai 'Eriyatsaxi Ruruhu nu'aya, 'Akuki nuiwarieya, mɨkɨtatsiere yemekɨ pɨkamakai peuyutamiewekai.  
\v 13 Rawiri hamatɨa Patsiramini kaniuyeikakaitɨni, hakewa piritsiteutsixi memeyukuxeɨriekai mewatakwinike. Manata tsewara pɨ'etsiekai, kepauka kuyaxi 'ixaheritsixi memuyuta'unaxɨ,  
\v 14 'Eriyatsaxi meta Rawiri tsewara mayema mekaniyuhayewa waheima mekaniutanuani piritsiteutsixi mekaniwarukwini. 'Ana Yawé kaniwarupitɨani memɨtehayu'iwakɨ.   
\p
\v 15 Xeitewiyari heimana tamamata kuyaxi tewa'aitɨwamete, mɨkɨ meyuhaikatɨ, mekanekɨne mu'aiyatsiepaitɨ, Rawiri muwayekateitsie paitɨ 'Arurani terɨyarita paitɨ, piritsiteutsixi mayeweritsie Xepahini mekanikutekaitɨni.  
\v 16 'Ana Rawiri kaniyu'awietakaitɨni, 'anata Wereni kiekariyaritsie piritsiteutsixi mekanihɨkaitɨni.  
\v 17 Hikɨ Rawiri mɨyeharimɨnekaikɨ mɨpaɨ kaniutayɨni: «Nemɨniyɨweniketɨ haa nemɨtiharenikɨ Wereni kitenieyaritsie mɨtiniere».  
\v 18 Hikɨ memuyuhaika memɨkamama piritsiteutsixi memakuteitsie me'uyekɨneka, Wereni haputsuyarita haa mekaniwatihana, hikɨ Rawiri mekanehanirieni. Peru Rawiri pɨka'enuhari, kanitayeurieni pɨta Yawé hetsiemieme,  
\v 19 mɨpaɨ kaniutayɨni: «Kakaɨyari hɨxie 'ikɨ haa nepɨka'anuhareni. Xɨka ne'enuhareni, memi'atɨa waxuriya nemanuhareni hepaɨ nepɨyɨni. Yutukari mepɨyetua kemɨ'ane haa memɨ'atɨa». Hikɨ 'ayumieme pɨka'enuhari.  
\p 'Ikɨ meyuhaikatɨ mɨpaɨ mepɨteyuriekai waɨkawa.   
\p
\v 20 'Awitsahi Kuhawi 'iwaya, mɨkɨ memɨyuhaika katiniwa'aitɨwametɨkaitɨni, mɨkɨ 'aixɨa katinikuxaxatsiwakaitɨni. Mɨkɨ heiwa yupitsika hakwetɨ kaniyutamieni, haika tsienituyari teɨteri kaniwarukwini.  
\v 21 Mɨkɨ matsi waɨkawamekɨ kaniyɨwekaitɨni kuyakɨ keyuri memɨyuhaika, 'ana mɨkɨ muwanɨ'a kanayani, peru mɨkɨ wahamatɨa pɨka'u'inɨatsie.   
\p
\v 22 Wenahiyaxi Kuyara nu'aya kuya pɨhɨkɨtɨkai Kawɨtseri kiekame. Mɨkɨ teɨteri yuhutame memeuyutakwiwawe pɨwarukwi Muhawi kiekatari, meta heiwa 'u'ɨwiyakaku putsu muyewakita heukahaka xeime maye kaniumieni.  
\v 23 Meta xeime 'ekipitutanaka huta meturuyari heimana 'imeriyu 'utewime kaniumieni, pitsika kanakwekaitɨni kwiniepame. Wenahiyaxi matsi kɨye xeikɨa pakwekai, pitsikaya kaninawairieni mɨkɨkɨ kanimieni.  
\v 24 Wenahiyaxi Kuyara nu'aya mɨpaɨ pɨtiyurienekai waɨkawa, mɨkɨta 'aixɨa tikuxaxatsiwatɨ patɨa memuyuhaika hepaɨ,  
\v 25 peru mɨkɨ wahamatɨa pɨka'u'inɨatsie, tsepa xeitewiyari heimana tamamata memuyupaɨme memɨkamama muwara'iwakai. Hikɨ 'ana Rawiri yuhɨwemete muwanɨ'a kaneyeitɨani.   
\b  
\li1
\v 26 'Ikɨ kuyaxi memɨyɨwawekai memɨkamamakai mekanihɨkɨtɨni:  
\li2 'Atsaheri, Kuhawi 'iwaya, 'Erikanani Ruruhu nu'aya Wereni kiekame,  
\v 27 Tsamuti Haruri kiekame, Heretsi Peruni kiekame,  
\v 28 'Ira 'Iketsi nu'aya Tekuha kiekame, 'Awihetsexi 'Anatuti kiekame,  
\v 29 Tsiwekahi Kutsa kiekame, 'Irahi 'Akuki nuiwarieya hetsiemieme,  
\v 30 Marahi netupatanaka, Kereri Wanaha nu'aya Netupaha kiekame,  
\v 31 'Itahi Xiwahi nu'aya, Kiweha kiekame Wenikamini kwieyaritsie mɨti'ane, Wenahiyaxi Piratuni kiekame,  
\v 32 Kurahi Kahatsi 'akiyaritsie kiekame, 'Awiheri Weti-'Arawa kiekame,  
\v 33 'Atsimaweti Wakurini kiekame, 'Erihawa Tsariwini kiekame,  
\v 34 Katseni Kitsuni kiekame niwemama, Kunatani Tsakehe nu'aya 'Arari kiekame,  
\v 35 'Ahiyani Tsakaxi nu'aya 'Arari kiekame, 'Eripari 'Uxi nu'aya,  
\v 36 Hepexi Mekera kiekame, 'Ahiyaxi Peruni kiekame,  
\v 37 Ketsiru Kaximeri kiekame, Narahi 'Etsiwahi nu'aya,  
\v 38 Kuheri Natani 'iwaya, Miwaxi Hakɨri nu'aya,  
\v 39 Tsereki 'amuni tewiyari, Nakarahi Weruti kiekame Kuhawi hɨwemetɨkai Tsariwiya nu'aya,  
\v 40 'Ira 'itɨrita tewiyari, Karewi 'itɨrita tewiyari,  
\v 41 'Uriyaxi Heti tewiyari, Tsawari 'Akirahi nu'aya,  
\v 42 'Arinaha Tsitsaha nu'aya Xuweni nuiwarieya, xuwenitsixi muwanɨ'a pɨhɨkɨtɨkai meta xeitewiyari heimana tamamata teɨteri mekaneweiyakaitɨni.  
\v 43 Kanahani Mahaka nu'aya, Kutsapati Mitini kiekame,  
\v 44 'Utsiyaxi 'Atsitaruti kiekame, Tsama meta Kehieri Kutani niwemama 'Aruhexi kiekame,  
\v 45 Keriyaheri Tsimɨri nu'aya, meta 'iwaya Yuká Titsi kiekame,  
\v 46 'Eriheri Mahawa kiekame, Kerewahi meta Kutsawiyaxi 'Erinahani niwemama, 'Itimaha Muhawi tewiyari,  
\v 47 'Eriheri, 'Uweri meta Katsiheri Tsuwaha kiekame.   
\c 12  
\s1 Kuyaxi Rawiri memutinɨi  
\p
\v 1 'Ikɨ mekanihɨkɨtɨni Rawiri memutinɨi kuyaxi Tsikɨraki 'uyeikakaku, kepauka mɨkɨ 'ateewa muyeikakai heyeweiyaku Tsahuri Kihitsi nu'aya. Mɨkɨ mekaniparewieni kepauka mɨkɨ muyumienekaitsie.  
\v 2 Tupikɨ temɨmɨmete mekanihɨkɨtɨkaitɨni meta tewɨpamekɨ mepɨtetuaxiwawekai meta mepɨtemɨiwawekai yutserieta meta yu'utata.  
\b  
\li1 Wenikamini nuiwarimama Tsahuri maremama:   
\li2
\v 3 Mɨtiwa'aitɨa 'Akihetsexi pɨhɨkɨtɨkai meta Kuhatsi, Tsema mepɨniwemamatɨkai Kiweya kiekame, Ketsiheri meta Pereti 'Atsimaweti mepɨniwemamatɨkai, Weraka meta Kehu 'Anatuti kiekatari,  
\v 4 'Itsimahiyaxi kawahunitanaka, mɨkɨ xeitewiyari heimana tamamata kuyaxi puwa'iwatɨkai meta muwanɨ'a pɨhɨkɨtɨkai, Keremiyaxi, Kahatsieri, Kuhanahani, Kutsawari Kerera kiekame,  
\v 5 'Erutsahi, Kerimuti, Wehariyaxi, Tsemariyaxi, Tsepatiyaxi Harupi nuiwarieya hetsiemieme,  
\v 6 'Erikana, 'Itsiyaxi, 'Atsareri, Kuhetsexi meta Yatsuwehani mɨkɨ Kure mepɨnuiwarimamatɨkai,  
\v 7 Kuhera meta Tsewariyaxi, Keruhani niwemama mepɨhɨkɨtɨkai Keruxi kiekatari.   
\b  
\p
\v 8 Hipatɨta Kahari nuiwarimama Rawiri mekaniutinɨni kepauka muyu'awietakai makumawetsie. Memeuyutakwiwawe memɨkamama mepɨhɨkɨtɨkai, kuyakɨ mepɨha'aritsiekai, mepakumexɨxɨakai pitsikakɨ meta yuhetsie nunuwamekɨ, mayetsi wahepaɨ mepɨtehayu'eririyakai, maxatsi yeutari wahepaɨ mepɨtehanautsawawekai.  
\v 9 Mɨpaɨ mepɨtetetewakai: Mexɨakame pɨhɨkɨtɨkai 'Etsexi, 'Awiriyaxi hutarieka mieme, 'Eriyáwi hairieka mieme,  
\v 10 Mitsimanaha naurieka mieme, Keremiyaxi 'auxɨwirieka mieme,  
\v 11 'Atahi 'ataxewirieka mieme, 'Eriheri 'atahutarieka mieme,  
\v 12 Kuhanahani 'atahairieka mieme, 'Eritsawari 'atanaurieka mieme,  
\v 13 Keremiyaxi tamamatarieka mieme meta Makawanahi tamamata heimana xewi mieme.  
\v 14 'Ikɨ Kahari nuiwarimama kuyaxi wa'ukiyarima mepɨhɨkɨtɨkai, yakɨ mɨtitɨrɨkaɨye puwakemakai xeitsienituyari, yemekɨ mɨtɨrɨkaɨye puwakemakai xeimiriya.  
\v 15 'Ikɨ mekanihɨkɨtɨni Kurutani hatuxameyaritsie memanukɨ mexɨakame metseriyari 'anuhaku, kepauka haa muwayeneikatsie naime muweritsie meuyunitɨwa, hikɨ mana kiekatari mekaniwareutaweiyaxɨani 'anutaɨyetari meta 'anataɨyetari.   
\p
\v 16 Hipatɨta kuyaxi Wenikamini nuiwarimama hetsiemiemete meta Kura hetsiemiemete Rawiri mekaniutinɨni mayu'awietakaitsie.  
\v 17 Rawiri kanayeyani waranukunakeke mɨpaɨ katiniwarutahɨawe:  
\p ―Xɨka 'aixɨa 'anemekɨ xekɨyɨaka xenetsiparewienike nekanixetanaki'erimɨkɨ, peru xɨka xenetsi'aye'unietɨ xeyɨaka xenetsiyetuanike, ta'ukiyarima wakakaɨyari yakeretimani meta ketiwarukwinitɨani, netsɨ tiyumiekame nepɨkahɨkɨ.   
\p
\v 18 'Amatsahi hetsie 'Iyari kaninuani, xeitewiyari heimana tamamata mɨwanɨ'a, mɨpaɨ kaniutayɨni karima:  
\q1 «Rawiri tame 'ahetsɨa tepumiemete.  
\q2 'Ahamatɨa tepu'uwa, 'Itsahi pemɨnu'aya.  
\q1 Haikakɨa yatepaitɨka kayuwatɨ tepɨmatsipitɨa,  
\q2 'ekɨ meta kemɨ'ane mɨmatsiparewie.  
\q2 Kemɨ'ane mɨmatsiparewie Kakaɨyari kanihɨkɨtɨni».  
\p 'Ana Rawiri kaniwarutanaki'erieni meta yukuyaxima wa'ukiyarima wahamatɨa kaniwaranuka'uitɨani.   
\p
\v 19 Yaxeikɨatatsiere hipatɨ kuyaxi Manatsexi nuiwarimama Rawiri mekaniutinɨni kepauka 'ikɨ piritsiteutsixi wahamatɨa mumiekai Tsahuri metamienike. Peru piritsiteutsixi wa'ukiyarima mepuyu'eni mɨkawaparewienikɨ. Waɨkawa mete'utixataka mekanita'imaiya yu'ɨtɨa mɨyemiekɨ, mɨpaɨ me'utiyuaka: «Rawiri tiyu'aitɨwame Tsahuri kanitinɨimɨkɨ, mɨpaɨ katatinikwimɨkɨ».  
\v 20 'Ikɨ mekanihɨkɨtɨni Manatsexi nuiwarimama Rawiri memutinɨi kepauka Tsikɨraki metɨa: 'Arinatsi, Kutsawari, Keriyaheri, Mikaheri, Kutsawari, 'Erihú meta Tsiretahi, manatsexitsixi wa'ukiyarima mepɨhɨkɨtɨkai xeimiriyari kuyaxi memɨwanɨ'akai.  
\v 21 Rawiri mekaniparewiekaitɨni kepauka memɨwakwitɨwekai hipame tenawayamete, mɨkɨ yuxexuitɨ memɨkamama memeuyutakwiwawe mepɨhɨkɨtɨkai meta kuyaxi memɨwanɨ'a mepɨhɨkɨtɨkai.  
\v 22 Yamepɨte'axekai kuyaxi Rawiri hetsɨa me'itinɨnike, mɨpaɨ yumɨireme tiwarexeiyatɨ kanayani Rawiri kuyaxi.   
\s1 Kemɨ'ane Rawiri memutinɨi Hewurunitsie  
\p
\v 23 'Ipaɨ mekaniyupaɨmekaitɨni kuyaxi waɨkawa memeuyutakwiwawe Rawiri hetsɨa memu'axɨa Hewuruni mɨrakutewatsie, ti'aitame memeyeitɨanikɨ Tsahuri hetsiemieme, Yawé kemutayɨkai:   
\li1
\v 24 Kura nuiwarimama mepɨyupaɨmekai: 'ataxewi miriyari heimana 'atahaika tsienituyari (6.800) kuyaxi 'ari meha'aritsietɨ kuyaxa miemekɨ.   
\li1
\v 25 Tsimehuni nuiwarimama mekaniyupaɨmekaitɨni: 'atahuta miriyari heimana xeitsienituyari (7.100) kuyaxi yemekɨ memeuyutakwiwawe.   
\li1
\v 26 Rewi nuiwarimama mekaniyupaɨmekaitɨni: nauka miriyari heimana 'ataxewi tsienituyari (4.600),  
\v 27 'Aruni nuiwarimama mekaniyupaɨmekaitɨni, haika miriyari heimana 'atahuta tsienituyari (3.700) kuyaxi, Kuyara wa'ukiyari pɨhɨkɨtɨkai,  
\v 28 meta temaikɨ Tsaruki, waɨkawa meuyutamiewe, pɨwa'ukiyaritɨkai xeitewiyari heimana huta yu'iwama memanuyetekai.   
\li1
\v 29 Wenikamini nuiwarimama, Tsahuri 'iwamama mekaniyupaɨmekaitɨni: haika miriyari teɨteri, mɨkɨ Tsahuri mepaweiyakai 'aixɨa mepɨte'ixeiyakai meripaitɨ.   
\li1
\v 30 'Epɨrahini nuiwarimama mekaniyupaɨmekaitɨni: xeitewiyari miriyari heimana 'atahaika tsienituyari (20.800) teɨteri memɨkamama, yu'iwama watsata memɨmariwakai.   
\li1
\v 31 Manatsexi nuiwarimamata hixɨata me'atɨ mekaniyupaɨmekaitɨni: tamamata heimana 'atahaika miriyari teɨteri memanayexeiyarie Rawiri ti'aitame memanukakenikɨ.   
\li1
\v 32 'Itsakaxi nuiwarimama mekaniyupaɨmekaitɨni: huta tsienituyari memanuyetei yu'iwama wahetsie mieme. Mɨkɨ teɨteri mepɨtemaiwawekai tukari hepaɨtsita, 'Ixaheri hepaɨtsita tita 'aixɨa mɨti'anekai mepɨtemaikai.   
\li1
\v 33 Tsawuruni nuiwarimama mekaniyupaɨmekaitɨni: huta tewiyari heimana tamamata miriyari (50.000) teɨteri memeuyutakwiwawekai tsepa tita mete'ɨ'ɨtɨ, memɨyuwaɨriyakai memɨyutakwinikɨ Rawiri hetsiemieme.   
\li1
\v 34 Nepɨtahari nuiwarimama mepɨyupaɨmekai: xeimiriyari mepɨhɨkɨtɨkai memanuyetei, mɨkɨ yuxexuitɨ mepɨwanɨ'akai xeitewiyari heimana tamamata heimana 'atahuta miriyari (37.000) teɨteri, yuhetsie nunuwame meta pitsika me'u'ɨkame.   
\li1
\v 35 Rani nuiwarimama mekaniyupaɨmekaitɨni: xeitewiyari heimana 'atahaika miriyari heimana 'ataxewime tsienituyari (28.600) kuyaxi memɨyuwaɨriyakai memɨyutakwinikɨ.   
\li1
\v 36 'Atsexi nuiwarimama mekaniyupaɨmekaitɨni: huta tewiyari miriyari teɨteri kuyakɨ memɨha'aritsiekai.   
\li1
\v 37 Hipatɨta nuiwarite Kurutani 'anutaɨye memɨtamakai tatsɨari Xuweni nuiwarimama meta Kahari nuiwarimama meta hixɨata me'atɨ Manatsexi nuiwarimama mekaniyupaɨmekaɨtɨni: xeitsienituyari heimana xeitewiyari miriyari (120.000) teɨteri mete'upitɨ tita kuyaxa mɨreuyewetse.   
\p
\v 38 Yunaitɨ mɨkɨ kuyaxi meyuwaɨriyatɨ memɨyutakwinikɨ mekanekɨne Hewuruni paitɨ, mana Rawiri memanukakenikɨ ti'aitame memeyeitɨanikɨ naitsarie 'Ixaheri kwieyaritsie miemekɨ. Hipatɨta 'ixaheritsixi mepɨwarutinɨi yunaitɨ Rawiri mekananukakeni.  
\v 39 Yunaitɨ mana mekaniyuhayewa haika tukari, metekwatɨ meta mete'ietɨ Rawiri hamatɨa, meripaitɨri 'iwamama mepɨte'ukuha'aritakai tita memɨtekwanikekai.  
\v 40 Metatsiere hurawa kiekatari meta 'Itsakaxi, Tsawuruni, Nepɨtahari wanuiwarima mepɨwa'atɨwakai puxuri, kameyutsixi, muratsixi, meta tuurutsixi kwietsanamete wahetsie meteha'ikatatɨ tɨriku mɨtɨxiyari, xapa patsaruyari papatsietɨkaime, kaxie patsaruyari, winu meta huriwa hatseitiyari. Meta mekateniwarehapanirieni tuurutsixi meta muxatsi meyumɨireme, 'ixaheritsixi waɨkawa temawierika memexeiyakaikɨ mana.   
\c 13  
\s1 Kakaɨyari tɨratuya kakuniyari 'Uweri-'Erumi kie kemɨti'atɨarie  
\r (1Kem 13:1-14 – 2Tsam 6:1-11)  
\p
\v 1 Hikɨ Rawiri waruta'iwawiyaka kuyaxi xeimiriyari meta kuyaxi xeitsienituyari memɨtewa'aitɨatɨka meta yunaitɨ memanuyetei,  
\v 2 mɨpaɨ katiniwarutahɨawe 'ixaheritsixi yunaime memɨyuxeɨriekai: «Xɨka 'aixɨa'aneni, xɨka Yawé takakaɨyari mɨpaɨ tinakeni, tepɨwata'inieni yunaime 'Ixaheri kwieyaritsie memɨtama, meta mawari wewiwamete metatsiere rewitsixi xexuime kiekaritetsie memeutitei, meketatsi'utinɨni  
\v 3 Kakaɨyari tɨratuya kakuniyari temɨkweiyukɨ temi'atɨanikɨ. Yurikɨ Tsahuri mɨti'aitakaitsiepaitɨtɨ tepɨkahe'eriwa».   
\p
\v 4 Kemɨtiwarutahɨawixɨ yunaitɨ teɨteri pɨwarunakixɨ, hikɨ yunaitɨ yamekaniutiyuani mɨpaɨ mɨtiyɨnikɨ.   
\p
\v 5 Hikɨ Rawiri yunaime kaniwarukuxeɨrieni 'ixaheritsixi, Tsikuxi 'Ekipitu kwieyari maka'atɨkatsie paitɨ meye'atɨkaime meta Rewu-Kamati paitɨ meye'atɨkaime, Kakaɨyari tɨratuya kakuniyari memɨkweiyukɨ Kiriati-Yeharini paitɨ mekatei.  
\v 6 Hikɨ Rawiri meta yunaitɨ 'ixaheritsixi mekanekɨne Wará paitɨ, Kiriati-Yeharini tɨtɨ Kura kwieyaritsie, mana memiyekwenikɨ Kakaɨyari tɨratuya kakuniyari, mɨkɨtsie Yawé mutahɨawarɨwa yuteɨtamete watsata mɨti'aita.  
\v 7 Tɨratu kakuniyari kaxeta hekwametsie mekanikateni, 'Awinarawi kie mekaneyekweni. 'Utsa meta 'Akihu kaxeta mekaniunɨ'aximekaitɨni.  
\v 8 Rawiri meta yunaitɨ 'ixaheritsixi Kakaɨyari hɨxie mekaniuhukaitɨni waɨkawa meyutemamawietɨ meta me'utikwitɨ, mete'ukayuitɨwatɨ, me'ukanariwiximetɨ, me'ukaitsawiximetɨ, meta kuxineta me'uhɨtsiximetɨ.   
\p
\v 9 Kiruni kwieyatsie me'uyehutɨ, tɨriku matihenatsie, tuurutsixi kwietsanamete mekanekaxɨrieni, hikɨ 'Utsa yumamatekɨ tɨratu kakuniyari kaniutuika 'anatiwenikɨ.  
\v 10 Yawé kaniuyeha'ani 'Utsa hetsiemieme tɨratu kakuniyari mumayɨakɨ, 'ana kwitɨwa kanimieni.   
\p
\v 11 'Ana Rawiri kaniuyeha'ani Yawé 'Utsa mumikɨ. 'Ayumieme mana Peretsi-'Utsa katiniuterɨwa, hikɨ 'akuxi mɨpaɨ pɨrakutewa.  
\v 12 'Ana Rawiri Kakaɨyari heumakatɨ mɨpaɨ kaniutayɨni: «Nepɨkahenukweniri Kakaɨyari tɨratuya kakuniyari».  
\v 13 'Ayumieme Rawiri yukiekaritsie pɨkaheitɨ, matsi mɨpaɨ katiniu'aita 'Uweri-'Erumi kie manukweiyanikɨ, Kahati kiekame hetsɨa.  
\v 14 Mɨpaɨ tiuyɨku Kakaɨyari tɨratuya kakuniyari 'Uweri-'Erumi kie kaniyuhayewa haika metseri, hikɨ 'ana Yawé 'Uweri-'Erumi tɨɨriyamama 'aixɨa kaniwayuriekaitɨni meta tita mɨrexeiyakai.   
\c 14  
\s1 Rawiri tɨɨriyamama meta Paratsiyuya  
\r (1Kem 14:1-7 – 2Tsam 5:11-16, 1Kem 3:5-8)  
\p
\v 1 Ti'aitame Hirami Tiru kiekame, yunɨ'arima Rawiri kanenɨ'arieni mete'utɨkɨme kariuxa kɨyeyari, meta kii wewiwamete metatsiere kɨyekɨ te'uximayatamete paratsiyuya memɨtawewienikɨ.  
\v 2 Mɨkɨkɨ Rawiri mɨpaɨ katinetimani kename Yawé, yuteɨterima wanaki'erietɨ, 'enukake 'Ixaheri kwieyaritsie mɨti'aitanikɨ, meta mariweme hayeitɨaximekai hakewa mɨre'aita.   
\p
\v 3 Rawiri hipameta 'ukari kaniwarutiwitɨni Kerutsareme kiekariyaritsie, mɨkɨ wahamatɨa tɨɨri kaniwarayexeiya 'ukitsi 'ukari.  
\v 4 Mɨpaɨ mepɨtetewakai 'ukitsi mɨwarayexei: Tsamuha, Tsuwawi, Natani, Tsarumuni,  
\v 5 'Iwikaxi, 'Eritsuha, 'Eripereti,  
\v 6 Nuka, Nepeki, Kapiha,  
\v 7 'Eritsama, Weriyara meta 'Eripereti.   
\s1 Rawiri piritsiteutsixi kemɨtiwara'iwaxɨ  
\r (1Kem 14:8-17 – 2Tsam 5:17-25)  
\p
\v 8 Hikɨ kepauka memɨte'utamari piritsiteutsixi kename Rawiri hanukakeriekai 'Ixaheri kwieyaritsie ti'aitame mayanikɨ, mekanayekɨne me'itamienike. Peru Rawiri yakatinetimani wahepa kaneyani.  
\v 9 'Ari piritsiteutsixi Xepahini mayeweritsie hipame wahetsɨa mekanitahaxɨakaitɨniri.  
\v 10 Hikɨ 'ayumieme Rawiri Kakaɨyari mɨpaɨ katiniuta'iwawiya:  
\p ―¿Netiyɨwe piritsiteutsixi nemɨwatakwini? ¿penetiparewieni nemɨwara'iwakɨ?  
\p Yawé mɨpaɨ katinita'eiya:  
\p ―Keniwarutakuya, ne nekameniparewimɨkɨ pemɨwara'iwakɨ.   
\p
\v 11 Hikɨ Rawiri mekanekɨne Wahari-Peratsini paitɨ, mana Rawiri kaniwara'iwa. Hikɨ Rawiri mɨpaɨ kaniutayɨni mana: «Kakaɨyari peutaha memɨnetsi'aye'unie watsata haa waɨkawa mɨtɨrɨkaɨye hepaɨ». 'Ayumieme mana Rawiri Wahari-Peratsini katiniuterɨwa.  
\v 12 Mana piritsiteutsixi yukakaɨyarixima mekaniwaruku'eirieni, hikɨ mɨkɨ mekaniutitaiyarieni Rawiri mɨpaɨ tiuta'aitaku.   
\p
\v 13 Piritsiteutsixi tawarita hekwamekɨ mayeweritsie kiekatari mekaniwarutakwini.  
\v 14 'Ayumieme tawarita Rawiri Kakaɨyari kaniutahɨawe, mɨkɨta mɨpaɨ katinita'eiya:  
\p ―Wahɨxie pe'uyame pepɨkayɨwe, wawarita pɨta kenemie waritsamu kɨyexiyari mati'upaitɨ, hikɨ mana xekeniwaretakuya wa'utɨma memɨhu meri.   
\p
\v 15 Kepauka yuariya peme'enieni kuyaxi muwa memeuhuni hepaɨ, wapaitɨ kɨyexi kɨtsita, 'ana xekanayekɨnikuni xemɨwaretakwinikɨ, mɨkɨ pɨ'inɨaritɨni kename ne Kakaɨyari 'ahɨxie ne'umie kuyaxi piritsiteutsixi nemɨwakwinikɨ.   
\p
\v 16 Mɨpaɨ Rawiri katiniuyurieni, Kakaɨyari kemɨrehɨawekai, kuyaxi piritsiteutsixi yunaime mekaniwarukwini Kawahuni huyeyari 'utɨma meta Ketsehexi huyeyari 'utɨma paitɨ.  
\v 17 Rawiri waɨkawa mariwetɨ kanayani naitsarie kaniutamariwa, Yawé mɨpaɨ katiniuyurieni yunaitɨ teɨteri memimakaxenikɨ.   
\c 15  
\s1 Rawiri tɨratu kakuniyari Kerutsareme paitɨ kemɨti'atɨa  
\r (1Kem 15:25–16:3 – 2Tsam 6:12-19)  
\p
\v 1 Merikɨte Rawiri kii yuhetsiemieme kaniutiwewieni Kerutsareme kiekariyaritsie, xeimeta kaniutawewieni 'ixuriki kiyari, tɨratu kakuniyari hetsiemieme.  
\v 2 Hikɨ mɨpaɨ kaniutayɨni: «Rewitsixi xeikɨa mepɨyɨwawe Kakaɨyari tɨratuya kakuniyari memukweiximenikɨ, mɨkɨ Yawé kaniwaranayexeiya mɨpaɨ memɨte'uximayakakɨ yuheyemekɨ».   
\p
\v 3 Hikɨ Rawiri 'ixaheritsixi yunaime kaniwarukuxeɨrieni Kerutsareme Yawé tɨratuya kakuniyari memɨ'atɨanikɨ hakewa 'aixɨa mɨrekuyuriekai hetsiena mieme.  
\v 4 Metatsiere 'Aruni nuiwarimama kaniwarukuxeɨrieni meta rewitsixi. 'Ipaɨ yupaɨmeme kaniwaruta'inieni:   
\li1
\v 5 Kuhati nuiwarimama, xeitsienituyari heimana xeitewiyari mepɨhɨkɨtɨkai, 'Uriheri pɨwanɨ'akai mɨkɨ yu'iwama.   
\li1
\v 6 Merari nuiwarimama, huta tsienituyari heimana xeitewiyari mepɨyupaɨmekai, 'Atsahiyaxi yu'iwama muwanɨ'a pɨhɨkɨtɨkai.   
\li1
\v 7 Keritsuni nuiwarimama, xeitsienituyari heimama xeitewiyari heimana tamamata mepɨyupaɨmekai yunaitɨ, wa'iwa Kuheri mɨtiwa'aitɨa pɨhɨkɨtɨkai.   
\li1
\v 8 'Eritsapani nuiwarimama, huta tsienituyari mepɨyupaɨmekai, wa'iwa Tsemahiyaxi muwanɨ'a pɨhɨkɨtɨkai.   
\li1
\v 9 Hewuruni nuiwarimama, nauka tewiyari mepɨhɨkɨtɨkai, 'Eriheri muwanɨ'a pɨkɨkɨtɨkai yu'iwama.   
\li1
\v 10 'Utsiheri nuiwarimama, xeitsienituyari heimama tamamata heimana huta mepɨyupaɨmekai, 'Aminarawi muwanɨ'a pɨhɨkɨtɨkai mɨkɨ yu'iwama.   
\p
\v 11 Meta Rawiri mawari wewiwamete katiniwarutanɨ'airieni, Tsaruki meta 'Awiyataxi, meta rewitsixi 'Uriheri, 'Atsahiyaxi, Kuheri, Tsemahiyaxi, 'Eriheri meta 'Aminarawi,  
\v 12 hikɨ mɨpaɨ katiniwarutahɨawe: «Xeme rewitsixi xemɨwa'ukiyarimakɨ, xeme 'aixɨa xekeneuyuyurieka Kakaɨyari hetsɨa metatsiere yu'iwama, Yawé 'Ixaheri Kakaɨyarieya, tɨratuya kakuniyari xemɨkweiyukɨ, temi'atɨanikɨ hakewa 'aixɨa nemɨrekuyuri hetsiena mieme.  
\v 13 Matɨari tepɨkaxe'uta'ini xeme, tameta Yawé takakaɨyari tepɨka'uta'iwawiyaxɨ, yemekɨ kemɨreuyewetse, 'ayumieme mɨkɨ puyeha'a tahepaɨtsita».   
\p
\v 14 Merikɨte mawari wewiwamete meta rewitsixi 'aixɨa mekaniuyuyurieni Yawé tɨratuya kakuniyari memɨkweiyukɨ, 'Ixaheri Kakaɨyarieya.  
\v 15 Hikɨ rewitsixi mekaneikweni yunaiparitsie Kakaɨyari tɨratuya kakuniyari, Yawé Muitsexi kemɨtiuta'aitɨakai.   
\p
\v 16 Hikɨ Rawiri rewitsixi wa'ukiyarima katiniwaruta'aitɨani kwikamete memɨwaranuka'uitɨanikɨ, yu'iwamatɨme kwikari witsi'anuyɨneme memutikwikanikɨ 'aripakɨ, kanaritekɨ, meta tepɨa mɨxikɨrawi mutitirirɨka.  
\v 17 'Ayumieme Rewitsixi Hemani Kuheri nu'aya mekananukakeni, meta 'Atsahapi Werekiyaxi mɨnu'ayatɨkai, meta 'Etani Kutsahiyaxi nu'aya, Merari nuiwarimama.  
\v 18 Metatsiere mekaniwaranuka'uitɨani wa'iwama waparewiwamete memakɨnekɨ, hipatɨ mɨkɨ tuki kitenie tehɨwemete mepɨhɨkɨtɨkai: Tsakariyaxi Katsiheri nu'aya, Tsemiramuti, Kehieri, 'Unihi, 'Eriyáwi, Wenahiyaxi, Matsehiyaxi, Matatiyaxi, 'Eriperehu, Mikiniyaxi, 'Uweri-'Erumi meta Keyeri.   
\p
\v 19 Memutikwika: Hemani, 'Atsahapi meta 'Etani wurunitse tepɨayarikɨ mɨxikɨrawi mutitirirɨkakɨ mepɨte'ukayuitɨwakai.  
\v 20 Tsakariyaxi, 'Atsiheri, Tsemiramuti, Kehieri, 'Unihi, 'Eriyáwi, Matsehiyaxi meta Wenahiyaxi kanaritekɨ mepukakanariwiwakai.  
\v 21 Matatiyaxi, 'Eriperehu, Mikiniyaxi, 'Uweri-'Erumi, Keyeri meta 'Atsatsiyaxi, mɨkɨ 'arɨpa mepu'ɨkai 'atahaikatɨ pɨrime manutiwɨ kwikamete memɨwaruwitɨximenikɨ.  
\v 22 Kenaniyaxi rewitsixi wa'ukiyari, waɨkawa mɨtimaiwekaikɨ, kwikamete pɨwaranukuwitɨkɨkai.  
\v 23 Werekiyaxi 'Erikana matɨa kitenie tehɨwemete mepɨhɨkɨtɨkai tɨratu kakuniyari muwayekatsie.  
\v 24 Mawari wewiwamete Tsewaniyaxi, Kutsapati, Natanaheri, 'Amatsahi, Tsakariyaxi, Wenahiyaxi meta 'Eriyetsexi, kuxineta meputihɨtsiwakai tɨratu kakuniyari hɨxie meti'utɨ. 'Uweri-'Erumi meta Kehiyaxi mɨkɨtatsiere kitenie tehɨwemete tɨratu kakuniyari muyeka mepɨhɨkɨtɨkai.   
\p
\v 25 Waɨkawa meyutemamawietɨ, Rawiri meta 'ukirawetsixi 'ixaheritsixi wa'ukiyarima, meta kuyaxi memanuyetei xeimiriyari memɨtewa'aitɨatɨka, Yawé tɨratuya kakuniyari mekanekukweni 'Uweri-'Erumi kie paitɨ.  
\v 26 Kakaɨyari rewitsixi muwaparewiekaikɨ Yawé tɨratuya kakuniyari memukweiximenikɨ, tuurutsixi mekaniwarutimawa 'atahuta meyupaɨmeme meta muxatsi 'ukitsi wahepaɨ meyupaɨmeme.  
\v 27 Rawiri rinu witsimɨ'ane 'ixurikiyari kananakatɨkɨkaitɨni, yaxeikɨata yunaitɨ rewitsixi tɨratu kakuniyari memukweiximekai, meta kwikamete meta Kenaniyaxi kwikamete mɨtiwa'aitɨa. Metatsiere Rawiri penakatɨkɨkai mawari wewiwame kamixaya 'etsimɨnena.  
\v 28 Hikɨ temawierika hiwariyaritsata meta muxatsi wa'awate 'utihɨtsieriwakaku meta kuxinetate, tepɨa mɨxikɨrawi mutitirirɨka, 'arɨpatetsie meta kanarite tiutiyuanekaku, yunaitɨ 'ixaheritsixi Yawé tɨratuya kakuniyari mekaniukweiximekaitɨni.   
\p
\v 29 Hikɨ kepauka Yawé tɨratuya kakuniyari meutahatɨarieximekai Kerutsareme kiekariyari kitenieyaritsie, Mikari Tsahuri nu'aya yukiita wapaitɨ kananierekaitɨni, hikɨ kepauka ti'aitame Rawiri muxei 'utsunarɨmeme temawierikakɨ, kaneikaxani'erietɨyani yu'iyaritsie.   
\c 16  
\p
\v 1 Kakaɨyari tɨratuya kakuniyari kani'atɨarieni Rawiri hakewa 'ixuriki kiyari meta'aitakai. Muwa mekaneitateni hikɨ mawari taiyariyari mekaniuwewieni meta memɨyuxewinikɨ mawariyari Kakaɨyari hɨxie.  
\v 2 'Arike mawari heutipareku, Rawiri Yawé kaniutawawirieni teɨteri 'aixɨa mɨwayurienikɨ  
\v 3 meta 'ixaheritsixi yuxexuime 'ukitsi meta 'ukari paa kaniwaruta'ɨitɨani meta takɨ takari tsuirayari, meta kaxie patsaruyari tsuirayari.   
\p
\v 4 Hikɨ Rawiri hipame rewitsixi Yawé tɨratuya kakuniyari kaniwaruhɨritɨani hetsiena mieme memɨte'uximayakakɨ, pamɨpariyutsi memipitɨakakɨ meta witsimemutiyuanenikɨ Yawé hepaɨtsita, 'Ixaheri kakaɨyarieya.  
\v 5 Memanayexeiyarie mepɨhɨkɨtɨkai: 'Atsahapi mexɨakame pɨhɨkɨtɨkai: Tsakariyaxi, hutarieka mieme pɨhɨkɨtɨkai: manatari mepɨhɨkɨtɨkai Kekiyeri, Tsemiramuti, Kehieri, Matatiyaxi, 'Eriyáwi, Wenahiyaxi, 'Uweri-'Erumi meta Keyeri, mɨkɨ 'arɨpakɨ teyuitɨwamete mepɨhɨkɨtɨkai meta kanaritekɨ. 'Atsahapi tepɨa mutitirirɨka pɨyuitɨwametɨkai.  
\v 6 Mawari wewiwamete Wenahiyaxi meta Kahatsieri matɨa kuxineta meputihɨtsiwakai Yawé tɨratuya kakuniyari hɨxie.   
\s1 Rawiri nɨawarieya  
\r (1Kem 16:8-36 – Nɨa 105:1-15, 96:1-13, 106:1,47-48)  
\p
\v 7 Mɨkɨ tukaritsie, matɨari pɨyɨanekai Rawiri kwikari mɨyetɨa 'Atsahapi meta 'iwamama wahetsɨa 'ikɨ nɨawari Yawé hetsiemieme.   
\q1
\v 8 «'Aixɨa xekenaitɨkani Yawé hetsiemieme, kemɨtimariwe xekenekuxatani,  
\q2 xekenekuxatani kemɨtiuyuri teɨteri watsata.   
\q1
\v 9 Xekeneutikwikani, nɨawari hetsiena mieme.  
\q2 xekenekuxatani mariwemekɨ kemɨtiuyuri.   
\q1
\v 10 Xekeneyutemamawieka mɨmariwe mɨpatsie xemexeiyakɨ.  
\q2 xekeneyutemamawieka yurikɨ Yawé xemɨkuwautɨwe.   
\q1
\v 11 Yawé hetsɨa xekeneyu'awietani mɨtɨrukaɨyekɨ,  
\q2 yaxeketenahɨaweni yuheyemekɨ.   
\q1
\v 12 Xekenaye'eriwani mariwemekɨ kemɨtiuyuri,  
\q2 'inɨari kemɨtiuwewi meta 'aitsika ke'aneneme mɨyetɨa.   
\b  
\q1
\v 13 »'Ixaheri nuiwarimama, Yawé ti'uximayatsiriwame  
\q2 Kakuwu niwemama, Yawé mɨxe'anayexei:   
\q1
\v 14 Yawé takakaɨyari pɨhɨkɨ,  
\q2 naitsarie kwiepa katini'aitani kemɨtiheitserie.   
\q1
\v 15 Mɨkɨ yutɨratɨ yuhemekɨ kana'eriwani,  
\q2 xeimiriyari nuiwariyari wahamatɨa yuniuki kaniyetɨani.   
\q1
\v 16 'Apɨrahami matɨa tɨratu kemɨtiuwewi,  
\q2 meta 'Itsahaki matɨa kemɨtiuyuhɨritɨa,   
\q1
\v 17 Kakuwu yakatiniutahɨawe, 'aitsika kaneyeitɨirieni,  
\q2 'ixaheritsixi wahetsiemieme tɨratu yuheyemekɨ mieme kanayeitɨani:   
\q1
\v 18 “'Ekɨ Kanani kwieyari nekamaniyetuiriemɨkɨ,  
\q2 piinitɨarika 'ahetsiemieme mɨhɨkɨtɨni hepaɨ”.   
\q1
\v 19 Kepauka 'akuxi temɨkatamɨirekai,  
\q2 tewatari tekanihɨmetɨkaitɨni yakɨ teyupaɨmetɨ mɨkɨ kwieyaritsie,   
\q1
\v 20 kepauka hipame kwieyaritetsie xemu'uwakai  
\q2 meta kepauka hipame te'aitamete wahetsɨa xemu'uwakai,   
\q1
\v 21 Kakaɨyari pɨkatiupitɨa waɨriyarika temɨteta'aitɨarienikɨ,  
\q2 te'aitamete kaniwarutatieni 'iya wanaki'erietɨ:   
\q1
\v 22 “Neteɨterima nemɨwaranayexei xepɨkawa'uximatɨaka.  
\q2 Neniukamete xepɨkatewakwinitɨaka”.   
\b  
\q1
\v 23 »Yunaitɨ teɨteri kwiepa memɨtama Yawé mekenɨawani.  
\q2 Meke'ikuxatani tukari mɨyehane kemɨtiyuwikweitsitɨwa.   
\q1
\v 24 Nuiwarite watsata xekenekuxatani witsikemɨ'ane,  
\q2 meta mariwemekɨ kemɨtiyuriene xekenekuxatani yunaime teɨteri watsata.   
\q1
\v 25 Yawé matsi kanimariweni,  
\q2 hetsiena pɨtinake witsimɨtikɨhɨawarɨwani,  
\q2 matsi waɨkawa makaxiwatɨ keyuri hipatɨ kakaɨyarixi.   
\q1
\v 26 Tixaɨtɨ mepɨkatehɨkɨ teɨteri wakakaɨyarixi,  
\q2 matsi Yawé muyuawi kaniutawewieni,   
\q1
\v 27 Xawatɨriya meta kemɨtimariwe hɨxiena kanixuaweni,  
\q2 temawierika kanixuaweni meta tɨrɨkariya tukieya muyepatsieta.   
\b  
\q1
\v 28 »Yawé xeketeneyetuiri, yunaitɨ teɨteri,  
\q2 Yawé yaxeketeneutahɨawi witsikemɨ'ane meta kemɨtitɨrɨkaɨye.   
\q2
\v 29 Yawé yaxeketeneutahɨawi witsikemɨ'ane mɨmariwekɨ,  
\q1 hɨxiena xekeneu'axɨa 'imikieri xete'epinirietɨ,  
\q2 Yawé xekenayexeiyani tukieya witsimɨ'aneta.   
\q1
\v 30 Yunaitɨ teɨteri kwiepa memɨtama meke'eyemakaxeni.  
\q2 Mɨkɨ kwie 'apuyeye, mɨkɨta pɨkakuyuani.   
\q1
\v 31 Muyuawi keyutemawieka meta kwie ke'utanaweni.  
\q2 nuiwarite mɨpaɨ meke'utiyuani: “Yawé pɨti'aitame”.   
\b  
\q1
\v 32 »Haramara ke'utayuaneni meta yunaitɨ mana memɨteye'uwa.  
\q2 'Ɨtsi keyutemawieka meta tita mana memɨtexɨawe.   
\q1
\v 33 Kɨyexi hɨritsie mieme ke'utikwikani temawierikakɨ Yawé hɨxie,  
\q2 mɨkɨ 'ukanamieni kwiepa tita'aitake.   
\b  
\q1
\v 34 »'Aixɨa xeketenahɨaweni Yawé mɨkɨ 'aixɨa mɨtiuka'iyarikɨ,  
\q2 meta naki'eriyaya mɨwaɨkawa hawaikɨ pɨkaheu'axe.   
\q1
\v 35 Mɨpaɨ xeketenahɨaweni: “Ketaneutawikweitsitɨa, Kakaɨyari, tawikweitsitɨwame pemɨhɨkɨ.  
\q1 Ketaneukuxeɨri ketaneɨxɨna Kakaɨyari memɨka'ayexeiya watsata temɨka'u'uwanikɨ,  
\q1 temɨmatsinɨawanikɨ kepemɨtimariwe,  
\q2 temɨyutemamawiekakɨ tematsinɨawatɨ”.   
\q1
\v 36 Yawé 'aixɨa kerahɨawarɨwani, 'Ixaheri Kakaɨyarieya,  
\q2 yuheyemekɨ meta kaheu'akamekɨ».  
\m Hikɨ yunaitɨ teɨteri mɨpaɨ mekaniutiyuani: «Mɨpaɨ ketiɨyɨni», hikɨ 'aixɨa mekaniutiyuani Yawé hepaɨtsita.   
\b  
\p
\v 37 Rawiri Yawé tɨratuya kakuniyari 'Atsahapi kaniuhɨritɨani meta 'iwamama, memɨte'uximayakakɨ hetsiena mieme, yamemɨteyuriekakɨ kemɨreuyewekai tukarikɨ.  
\v 38 'Uweri-'Erumi kitenie tihɨwemekɨ kaniutahɨawe meta 'iwamama haika tewiyari heimana 'atahaika memɨyupaɨmekai, metatsiere 'Uweri-'Erumi Kerutuni nu'aya meta Kutsa.  
\v 39 Mawari wewiwame Tsaruki meta 'iwamama mawari wewiwamete kaniwaruhɨritɨani Yawé tukieya Kawahuni hɨriyaritsie paitɨ makawekai,  
\v 40 mana mawari taiyariyari yamemɨtehewewiekakɨ Yawé hetsiemieme, ximeri meta taikai Yawé 'aitsikaya kemainekai 'ixaheritsixi memɨyetuiriyarie.  
\v 41 Hipameta kaniwaranayexeiya, Hemani meta Kerutuni meta hipame, Yawé hetsiemieme memutikwikanikɨ: «Naki'eriyaya hawaikɨ pɨkaheu'axe».  
\v 42 Hemani meta Kerutuni matɨa kuxinetate mepexeiyakai, tepɨa mutitiraurɨka meta hipame, Kakaɨyari nɨawarieya hamatɨa memɨte'ukayuitɨwanikɨ. Kerutuni niwemama kitenie mepɨtehɨwemetetɨkai.   
\p
\v 43 Hikɨ 'arike yunaitɨ mekaneutayeixɨani yukie, meta Rawiri yutɨɨriyama wahetsɨa kanakunuani meta Kakaɨyari kaniutawawirieni 'aixɨa muwayurienikɨ niwemama.   
\c 17  
\s1 Kakaɨyari Rawiri kemɨtiutahɨawixɨ  
\r (1Kem 17:1-15 – 2Tsam 7:1-17)  
\p
\v 1 Merikɨtsɨ Rawiri yuparatsiyuta 'ayekaitɨri Natani kakaɨyari niukameya mɨpaɨ katiniutahɨawe:  
\p ―Neuxei, 'aixɨa pɨka'ane ne kariuxa paratsiyuyarita nemayekani, Yawé tɨratuya kakuniyari 'ixuriki tukiyarita hayekaikaku.   
\p
\v 2 Natani mɨpaɨ katinita'eiya:  
\p ―'Aixɨa pɨ'ane, yaketineuyuri 'a'iyaritsie kepemɨti'akuhɨawe, Kakaɨyari 'ahamatɨa kaniuyeikani.   
\p
\v 3 Peru mɨkɨ tɨkariyaritsie Kakaɨyari niukieya Natani hetsie kaninuani mɨpaɨ katinitahɨawe:   
\b  
\p
\v 4 «Kenemie Rawiri neti'uximayatsiriwame mɨpaɨ ketinetaxatɨa kename Yawé ne mɨpaɨ nehaine: “'Ekɨ pepɨkahɨkɨtɨni kii pemɨtawewieni muwa ne nemayekanikɨ.  
\v 5 Meripaitɨ 'ixaheritsixi nemɨwarayewitɨtsietɨtɨ meta hikɨ 'akuxi kiita nepɨkahayeyerɨwe, matsi 'ixuriki tukiyarita xeikɨa ne'ayekaitɨ nepukuyeikakai.  
\v 6 Kepauka 'ixaheritsixi wahamatɨa nemuyeikakai, kepauka 'itsɨkate nemɨwarutanɨ'a, neteɨterima memɨwa'ɨwiyanikɨ, ne mɨkɨ nepɨkawarutati kariuxa kiyari newa'aitɨatɨ”.   
\pi1
\v 7 »'Ayumieme, Rawiri neti'uximayatsiriwame mɨpaɨ ketinetahɨawi, Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ paine: “Ne muxatsi wakuraruta nepɨmatsi'aye'ini, neteɨterima 'ixaheritsixi pɨta pemɨtiwata'aitɨanikɨ.  
\v 8 Ne 'ahamatɨa nepuyeikakai tsepa hakewa pemuyeikakai, meyunaime nepɨwaruka'unaxɨ kemɨ'ane memɨmatsi'aye'uniekai. Hikɨri waɨkawa pemariweme nekamanayeitɨamɨkɨ, 'ena kwiepa hipatɨ memɨmamariwawe wahepaɨ.  
\v 9 Yaxeikɨatatsiere kwie nekanikuha'aritɨamɨkɨ neteɨterima 'ixaheritsixi wahetsiemieme, mana nemɨwaka'eni hepaɨ nepɨwayurieni mana mepɨtiteni mekamariutsietɨ. 'Axamemɨte'u'iyari mepɨkaxe'uximatɨaniri kememɨxeyuriekai tsutɨapai,  
\v 10 kepauka 'itsɨkate nemɨwaranuka'uitɨa neteɨterima wahetsie 'ixaheritsixi. Meta mɨpaɨ nekamatinahɨaweni, ne yunaime memɨmatsi'aye'unie nekaniwaka'unamɨkɨ, metatsiere ne, Yawé, nekamanipitɨamɨkɨ 'anuiwari pehexeiyatɨ pemayanikɨ.  
\v 11 Kepauka pemɨkumawere 'atewarima memakuhe pemɨyemie, ne xeime 'aniwetɨme nekananukakemɨkɨ 'ahetsiemieme, mɨkɨta nepiparewieni heitserie mɨtita'aitakɨ.  
\v 12 Mɨkɨ katiniyuriemɨkɨ kii mɨtawewieni nehetsiemieme, neta nekaniparewimɨkɨ yuheyemekɨ mɨtita'aitakɨ.  
\v 13 Ne nepu'ukiyarieyatɨni, mɨkɨta pɨneniwetɨni. Hatsuaku ne'inaki'erietɨ nepɨka'ihayewa, meripaitɨ 'ayeta mɨtiuta'aitaxɨ kenemɨtihayewaxɨ.  
\v 14 Matsi, mɨkɨ yuheyemekɨ nekie nepihɨrita meta nemɨra'aitatsie meta hikɨ yuheyemekɨ pɨti'aitani”».   
\b  
\p
\v 15 Natani 'ikɨ tinaime Rawiri katiniutaxatɨani, kemɨtiuhekɨatsitɨiyarie yemekɨ.   
\s1 Rawiri nenewierieya  
\r (1Kem 17:16-27 – 2Tsam 7:18-29)  
\p
\v 16 Hikɨ ti'aitame Rawiri 'ixuriki tukiyarita kaninuani tɨratu kakuniyari muyeka, hikɨ Yawé hɨxie mɨpaɨ kaniutayɨni:  
\pm «Yawé pemɨkakaɨyari, ne tixaɨtɨ nepɨkatihɨkɨ meta netɨɨriyama, titayari nemariweme penerayeitɨwa.  
\v 17 Yawé nekakaɨyari, ¿ketitayari waɨkawa matsi penetiyexatɨa penetiyetuiriekatɨtɨri, meta kename yuheyemekɨ nenuiwarima 'aixɨa pewayurieka? wa'atɨtɨ ne tewi mɨmariwe nepɨtihɨkɨ pepɨnetsiyuriene, Yawé Kakaɨyari 'aku.  
\v 18 ¿Ketsɨkuta tawari ne ne'utayɨni ke'aixɨa pemɨnetixeiyakɨ, 'ekɨtsɨ pekanenimateni ne ti'a'uximayatsiriwame?  
\v 19 Yawé, 'ekɨ 'ikɨ naime mɨtimamariwawe pekatiniyurieneni, ne ti'a'uximayatsiriwame pemɨnetsinaki'eriekɨ, mɨpaɨ mɨmatinakekɨ, meta matsiɨkɨme pekatinayeitɨani mɨkɨ.  
\v 20 Yawé, tame yatepɨtehetima 'ahepaɨ tiuka'iyaritɨ pumawe, meta tawarita xewitɨ 'ahepaɨ Kakaɨyari pumawe.  
\v 21 Pumawe 'ateɨterima 'Ixaheri nuiwariyari wahepaɨ me'anetɨ. Mɨkɨ nuiwari xeikɨa mepɨhɨkɨ pemɨwaranayexei 'ena kwiepa, 'ateɨterima pemɨwarayeitɨanikɨ, meta kepemɨtimariwe pemɨ'ahekɨatakɨ wahetsiemieme. Kepauka 'Ekipitu pemɨwarayewitɨ 'ateɨrima, huyeta mamariwaweme pepɨtiuyuri meta hipame nuiwarite pepɨwarayewei meta wakakaɨyarixi.  
\v 22 'Ixaheritsixi 'ahetsiemieme pepɨwarayeitɨa 'ateɨterima memakɨnekɨ yuheyemekɨ, 'ekɨta Yawé, wakakaɨyari pemɨhɨkɨtɨnikɨ.   
\pm
\v 23 »Kamɨtsɨ Yawé, kepemɨtitahɨawixi mati'uximayatsiriwame meta nuiwarimama wahetsiemieme, mɨpaɨ ketinaye'atɨa 'aniuki,  
\v 24 kepemɨtimariwe pema'eriwanikɨ 'aixɨa pemɨrahɨawarɨwanikɨ yuheyemekɨ, meta yunaitɨ mɨpaɨ memutiyuanenikɨ: “Yawé Naimekɨmɨtɨrɨkaɨye 'ixaheritsixi wakakaɨyari kanihɨkɨtɨni”. Hikɨ 'ana Rawiri ti'a'uximayatsiriwame nuiwarimama mematsi'ayexeiyatɨ mekaniu'uwakuni.   
\pm
\v 25 »'Ekɨ nekakaɨyari, ne ti'a'uximayatsiriwame pekanetiniutaxatɨani kename nenuiwarima te'aitamete pewarayeitɨani, 'ayumieme ne ti'a'uximayatsiriwame nepɨyuwaɨri 'ipaɨ nemɨmatitahɨawekɨ.  
\v 26 Yawé, Kakaɨyari 'ekɨ pepɨhɨkɨ, 'ekɨ pepɨtitaxatɨa ke'aixɨa pemiyurieni ti'a'uximayatsiriwame.  
\v 27 'Aixɨa pepɨtiwaruxei ti'a'uximayatsiriwame nuiwarimama 'aixɨa pemɨwayurienikɨ, pewa'uwiyakaku yuheyemekɨ 'amemu'uwanikɨ. 'Ekɨ Yawé 'aixɨa pepɨwaruyuri, 'ayumieme 'aixɨa me'itɨarietɨ mepɨyuhayewa yuheyemekɨ».   
\c 18  
\s1 Rawiri kepaɨmexɨa mɨrayu'iwaxɨ  
\r (1Kem 18:1-13 – 2Tsam 8:1-14)  
\p
\v 1 Merikɨtsɨ yapaɨmexɨa tukari 'anukayaku, Rawiri piritsiteutsixi kaniwarutakwini kaniwara'iwa, tiwa'aitɨatɨ kanayani meta wakiekari kaniwarunawairieni Kahati meta 'auriena kiekari mamanetɨka.  
\v 2 Yaxeikɨata muhawitsixi kaniwara'iwa, hikɨ Rawiri tiwa'aitɨatɨ kanayani, hetsɨana meteyukutuayatɨ mekanakɨne.   
\p
\v 3 Metatsiere Rawiri Harari-'Etsexi kana'iwa ti'aitame Tsuwa kiekame, Kamati kwieyaritsie, kepauka mɨkɨ 'Eupɨrate kwieyaritsie mɨtamiekai 'aixɨa 'iyurienike mana mɨti'aitanikɨ.  
\v 4 Rawiri kaninawairieni xeimiriyari kaxetate kuyaxa miemete, 'atahuta miriyari kuyaxi memutei kawayutsixi wahetsie, meta xeitewiyari miriyari kuyaxi yu'ɨkama memuhukai, meta kawayutsixi tirutari puwaruti'ɨkamɨraxɨa, puwaruhayewaxɨ xeikɨa xeitsienituyari kaxetate wahetsiemieme.   
\p
\v 5 Meta kepauka tsiriyutsixi Ramatsiku kiekatari memu'axɨa ti'aitame Harari-'Etsexi Tsuwa kiekame meparewienike, mɨkɨ Rawiri kaniwarukwini xeitewiyari heimana huta miriyari meyupaɨmeme.  
\v 6 Hikɨ Ramatsikutsie kuyaxi tehɨwemete kaniwaru'uitɨani, mɨkɨta tsiriyutsixi meteyukutuayatɨ Rawiri hetsɨa mekanakɨne. Naitsarie Rawiri kemɨtiyumienekai katinayu'iwakaitɨni, Yawé miparewiekaikɨ.   
\p
\v 7 Huru tepɨayari kɨmana memɨyukunaruma memi'ɨkai Harari-'Etsexi parewiwamete 'ahurawa memuti'u, Rawiri yupiini katinayeitɨani Kerutsareme paitɨ katinetɨni.  
\v 8 Metatsiere waɨkawa wurunitse kaniukaxeiya, Tewaki kiekariteyaritsie muxɨawekai, meta Kuni kiekariyaritsie, Harari-'Etsexi mɨkiekariteyatɨkai. Mɨkɨ wurunitse kaniuyurieni Tsarumuni mitiwewi haa makamare katsu 'emɨyewa, keuruwite tuki hɨxie mɨti'ukai meta hipatɨta pɨtimɨirekai wurunitsekɨ mɨtiwewiyatɨkatei tukita timieme.   
\p
\v 9 Tuhu, Kamati kiekariyaritsie ti'aitame, katiniutamarieni kename Rawiri, Tsuwa kwieyaritsie ti'aitame Harari-'Etsexi ha'iwakai.  
\v 10 Meta ti'aitame Tuhu Harari-'Etsexi paye'uniekai, 'ayumieme yuniwe 'Arurani kanenɨ'ani ti'aitame Rawiri hetsɨa meitawaɨritɨanikɨ, Harari-'Etsexi ma'iwaxɨkɨ. Meta Tuhu katineinɨ'airiekaitɨni 'imikierite piinite hurukɨ mɨtiwewiyatɨka, pɨratakɨ meta wurunitsekɨ.  
\v 11 Hikɨ mɨkɨ 'imikieri naime ti'aitame Rawiri Yawé katiniyetuirieni, yaxeikɨa kemɨtiuyuriekai 'Erumi kwieyaritsie mɨreyetɨkai meta Muhawi, 'Amuni, Piritsiteu kwieyari meta 'Amareki kwieyaritsie.   
\p
\v 12 Meta 'Awitsahi Tsariwiya nu'aya 'erumitsixi kaniwara'iwa Mayeweri Maye'unaya mɨrayetewatsie, mana kaniwarukwini tamamata heimana 'atahaika miriyari.  
\v 13 Yaxeikɨatatsiere 'Erumi kiekariyaritsie kuyaxi tehɨwemete kaniwaru'uitɨani, 'ana 'erumitsixi Rawiri hetsɨa meteyukutuayatɨ mekanakɨne. Naitsarie kemɨtiyumienekai Rawiri, Yawé kaniparewiekaitɨni mɨrayu'iwakɨ.   
\s1 Ti'aitame Rawiri memɨparewiekai  
\r (1Kem 18:14-17 – 2Tsam 8:15-18)  
\p
\v 14 Rawiri naitsarie 'Ixaheri kwieyaritsie katiniuta'aita, kemɨtiheitserie 'aixɨa 'anemekɨ.  
\v 15 Kuhawi Tsariwiya nu'aya kuyaxi tiwa'aitɨwame manuyeka pɨhɨkɨtɨkai, Kutsapati 'Akiruri nu'aya ti'utɨwame pɨhɨkɨtɨkai.  
\v 16 Tsaruki 'Akituwi nu'aya meta 'Akimereki 'Awiyataxi nu'aya, mɨkɨ mawari wewiwamete mepɨhɨkɨtɨkai, Tsawitsa kemɨtiuyɨ ti'utɨwame pɨhɨkɨtɨkai.  
\v 17 Wenahiyaxi Kuyara nu'aya kuyaxi kereteutsixi meta pereteutsixi pɨtiwa'aitɨwametɨkai, matsi ti'aitame Rawiri niwemama mexɨakate te'uximayatamete mepɨhɨkɨtɨkai paratsiyuta.   
\c 19  
\s1 'Amunitsixi ke'axamemɨtekakɨ  
\r (1Kem 19:1-19 – 2Tsam 10:1-19)  
\p
\v 1 Yapaɨmexɨa 'anuyeyaku, Nakaxi kaniumɨni 'amunitsixi tiwa'aitɨwame, nu'aya pɨta kanitsutɨani ti'aitatɨ.  
\v 2 'Ana Rawiri mɨpaɨ katiniu'erieni: «'Aixɨa 'anemekɨ tepɨyuxeiyani Kanuni Nakaxi nu'aya matɨa, 'ukiyarieya matɨa 'aixɨa ketemɨteyuxeiyakai». Hikɨ yunɨ'arima kaniwarenɨ'ani memeinɨtɨanikɨ Rawiri hetsiemieme 'ukiyarieya mumɨkaikɨ.  
\p Kepauka Rawiri nɨ'arimama memu'axɨa 'amunitsixi wakwieyaritsie Kanuni mekunɨtɨatɨwetɨ.   
\p
\v 3 Hikɨ memanuyetei 'amunitsixi mɨpaɨ mekateneyemaritɨani ti'aitame: «¿Yuri petiwa'eririe 'ekɨ ti'aitame, kename Rawiri wareyenɨ'a memɨmatsinɨtɨanikɨ xeikɨa 'a'ukiyari hetsiemieme? Matsitsɨ 'ikɨ mekaniku'awienieretɨweni takiekaritsie 'arike me'ika'unake».  
\v 4 Merikɨte Kanuni katiniuta'aita Rawiri nɨ'arimama memɨtiwiyarienikɨ meta wamɨxiya mataxiriexɨanikɨ meta wakamixate manutsanariexɨanikɨ hixɨapa, mehanamamawetɨ mekanenɨ'arieni yu'utɨma.   
\p
\v 5 Rawiri nɨ'arimama yemekɨ mekaniyutetewiyakaitɨni. Kepauka Rawiri mɨtiutamari kememɨte'anuyekɨ, niuki kanenɨ'ani mɨpaɨ haineme yuhetsiemieme: «Keriku xekeneyuhayewa, kepaukake xemɨxiya metiwawere xekanahuni».   
\p
\v 6 Kepauka Kanuni meta 'amunitsixi memɨtehetima Rawiri ke'axamemuyuriekai, 'ana kwitɨ xeitewiyari heimana tamamata heimana haika miriyari kiruyari raheteme pɨrata mekanenɨ'ani Metsuputamiya\f + \fr 19:6  \ft \+it 'Arami-Nakarahini\+it* tatsɨaritɨtɨ.\f* paitɨ, memɨniɨtɨarienikɨ kaxetate meta kuyaxi kawayutsixi wahetsie memutei, metatsiere 'Arami-Mahaka kiekatari meta Tsuwa kiekatari.  
\v 7 Kaxetate kuyaxa miemete xeitewiyari heimana tamamata heimana huta miriyari paɨmemekɨ mekatenayukatuani memɨparewiyanikɨ meta ti'aitame Mahaka kiekame mekaniuta'inieni kuyaximama yunaime, mɨkɨ Merewa murakutewa hɨxie mekanitiyaxe. Meta 'amunitsixi mekanayekɨne yukiekaritetsie mekaniuyukuha'aritɨani memɨyutakwinikɨ.  
\v 8 Kepauka Rawiri mɨpaɨ mɨretima, Kuhawi kanenɨ'ani yunaime kuyaxi warawitɨkɨme.  
\v 9 Hikɨ 'amunitsixi mekanekɨne yukiekari kitenie mekanitiyaxe, hipatɨta te'aitamete memuta'iniriekai 'ateewa mɨtahekɨatsie mekanitiyaxe.   
\p
\v 10 Kepauka Kuhawi yamɨretima kememɨte'uniwakai yuhɨxie meta yu'utɨma, 'ayumieme kaniwaranuyeteɨxɨ kuyaxi 'ixaheritsixi yemekɨ memɨyɨwawe tsiriyutsixi memɨwatakwinikɨ,  
\v 11 memuyuhayewaxɨ kuyaxi yumuta 'Awitsahi kaniuhɨritɨani 'amunitsixi memɨwatakwinikɨ.  
\v 12 Kuhawi 'Awitsahi mɨpaɨ katiniuhɨritɨani: «Xɨka tsiriyutsixi menetsiha'iwani 'ekɨ pekaneniparewimɨkɨ. Xɨkata 'amunitsixi mematsiha'iwani ne nekameniparewimɨkɨ.  
\v 13 Pepɨkamaka, tateɨterima wahetsiemieme tekaniyutakwikuni meta takakaɨyari kiekariteya hetsiemieme. Yawé yaketiuyurieni kehapaɨ mɨkɨ mɨtinake».   
\p
\v 14 Hikɨ Kuhawi meta kuyaximama tsiriyutsixi mekaniwarutakwini, peru tsiriyutsixi Kuhawi mekaniutimakani mekaniuyuta'una.  
\v 15 'Amunitsixi me'uneniereka tsiriyutsixi kememɨteyuta'unakai mɨkɨta mekaniyuta'una 'Awitsahi memakatɨ yukiekaritsie mekaniyuti'awieta. Hikɨ Kuhawi Kerutsareme kanakunuani.   
\p
\v 16 Hikɨ tsiriyutsixi 'ixaheritsixi mewara'iwaku, niuki mekanenɨ'ani 'Eupɨrate 'anutaɨye yu'iwama tsiriyutsixi wahetsɨa. Tsupaki pɨhɨkɨtɨkai Harari-'Etsexi kuyaximama tiwa'aitɨwame, mɨkɨ kananuyeyerɨni wahetsiemieme.  
\v 17 Kepauka Rawiri mɨtiutamari 'ixaheritsixi yunaime kaniwarukuxeɨrieni, hikɨ Kurutani hatuxameyari 'anutaɨye mekananukɨne, hikɨ mana 'aixɨa mekateniuyu'uitɨani tsiriyutsixi mewatakwinike. Hikɨ tsiriyutsixi mekanitsutɨani mekaniwarutakwini,  
\v 18 peru mɨyatɨtɨ mekaniuyuta'una 'ixaheritsixi mewamakatɨ. Rawiri kaniwarukwini 'atahuta miriyari kuyaxi tsiriyutsixi kawayutsixi wahetsie memutekai meta huta tewiyari miriyari kuyaxi yɨ'ɨkama memuhukai, metatsiere Tsupaki kaniumieni kuyaxi wa'ukiyari.  
\v 19 Tsiriyutsixi meha'iwarieku, 'ixaheritsixi mewara'iwaku, yunaitɨ Harari-'Etsexi hetsɨa memɨtehawiyakai memɨteyukutuayakai metehetimaika Rawiri hetsɨa pɨtari mekaniyuyetuani kayuwatɨ memexeiyanikɨ. Mana mɨtiyehane tsiriyutsixi tawari mepɨka'uyuwaɨri 'amunitsixi memɨwaparewienikɨ.   
\c 20  
\s1 Xawaha kemɨtiuka'unarie  
\r (1Kem 20:1-3 – 2Tsam 11:1, 12:29-31)  
\p
\v 1 Merikɨtsɨ taxarita kepauka te'aitamete memayekɨkatsie, Kuhawi kanayeyani yukuyaxima warawitɨtɨ, hikɨ 'amunitsixi wakwieyaritsie meye'axɨaka mekaniwarakuyuniya. Metatsiere Xawaha kiekariyaritsie paitɨ mekaniye'axɨani, mekaniwarutakwini mekanika'una. Peru Rawiri Kerutsareme kanekunuakaitɨni.  
\v 2 'Amunitsixi tiwa'aitɨwame huru mumayari manamakai Rawiri kaninawairieni, xeitewiyari heimana tamamata heimana haika kiruyari pɨrahetekai, tetexi witsimɨ'anene peukutetɨkaitei. Hikɨ Rawiri pɨta mekananutiketsirieni. Metatsiere mɨkɨ kiekariyaritsie waɨkawa mekatenayetɨni piinitɨarika mɨraye'atɨka.  
\v 3 Hikɨ Rawiri mana Xawaha kiekatari waɨriyarika te'uximayatamete kaniwarayeitɨani, kɨyexi xitekemete, tepɨa manuxɨtekɨ te'uximayatamete meta kɨ'ewemete. Yaxeikɨata kaniwaruyurieni 'amunitsixi teɨteriyari, hikɨ 'arike Kerutsareme kanakunuani yunaime yukuyaxima warawitɨtɨ.   
\s1 Piritsiteutsixi kememɨteha'iwarie  
\r (1Kem 20.4-8 – 2Tsam 21:15-22)  
\p
\v 4 Merikɨtsɨ mɨyatiuyɨku tawarita piritsiteutsixi wahamatɨa mekaniuyutakwini Ketsehexi mɨrakutewatsie. 'Ana Tsiwekahi Kutsa kiekame Tsipahi kaniumieni, mɨkɨ 'amemutɨtɨ wanuiwari pɨhɨkɨtɨkai. Mɨpaɨ 'ixaheritsixi mekateniwara'iwa piritsiteutsixi.   
\p
\v 5 Metatsiere hutarieka mewarutakwiku piritsiteutsixi, 'Erikanani Yahixi nu'aya Rakimi kaniumieni, Kuriyati Kahati kiekame 'iwaya, mɨkɨ pitsika pakwekai 'epakame.   
\p
\v 6 Tawarita mekaniuyutakwini Kahati kiekariyaritsie. Manata xewitɨ 'ememutɨtɨ kaniukateitɨni, mɨkɨ yumamatetsie yu'ɨkatetsie 'ataxexuime pexeiyatɨkatei yumamate tɨɨrixi, tatsɨari xeitewiyari heimana nauka yumamate tɨɨrixi pexeiyakai.  
\v 7 Mɨkɨ 'ixaheritsixi wahɨxie pɨyutamariwekatakai, peru Kunatani Tsimaha nu'aya, tatsɨari Rawiri 'iwaya, mɨkɨ kanimieni.   
\p
\v 8 Mɨkɨ 'ememutɨtɨ Xapaha nuiwarimama mepɨhɨkɨtɨkai Kahati mɨkiekametɨkai, peru Rawiri meta kuyaximama mekaniwarukwini.   
\c 21  
\s1 Rawiri kuyaxi kemɨtiwaruti'inɨataxɨ  
\r (1Kem 21:1-17 – 2Tsam 24:1-17)  
\p
\v 1 Merikɨte kauyumarie 'ixaheritsixi waraye'unietɨ kanayani Rawiri kaniuyuitɨani kuyaxi mɨwati'inɨatakɨ.  
\v 2 'Ayumieme Rawiri Kuhawi mɨpaɨ katiniuta'aitɨani, meta teɨteri memanuyetei:  
\p ―Xekenehu kuyaxi xekeniwareti'inɨata Weritsewa xe'itsutɨame 'atsita Rani meye'atɨkaime, yanemɨretimanikɨ keyupaɨmetɨ memɨyɨwawe kuyakɨ memɨnete'uximayatsiriekakɨ.   
\p
\v 3 Kuhawi mɨpaɨ katinita'eiya:  
\p ―Matsi Yawé kewarutimɨiriya xeitsienituyari mexɨa 'ateɨterima. Mɨkɨrikɨ yunaitɨ mepɨ'ateɨterima, ¿peru ketitayarikuta 'akuxi petimaimɨkɨ ketemɨtapaɨme, ti'aitame? Mɨya pemɨtiyurimɨkɨ 'ateɨterima 'ixaheritsixi 'axapewaruyurieni xeikɨa.   
\p
\v 4 Matsi ti'aitame niukieya kananu'enierieni keyuri Kuhawi, hikɨ 'ayumieme kanayeyani naitsarie 'Ixaheri kwieyaritsie. 'Ariketa kanakunuani Kerutsareme,  
\v 5 hikɨ 'ana Rawiri katiniyetuirieni keyupaɨmeme muwaraka'utɨakai kuyaxi: 'Ixaheri kwieyaritsie xeimiyuniyari heimana xeitsienituyari miriyari (1.100.000) mepɨyupaɨmekai, meta Kura kwieyaritsie kiekatari nauka tsienituyari heimana haika tewiyari heimana tamamata miriyari (470.000) mepɨyupaɨmekai.  
\v 6 Peru Kuhawi Rewi nuiwarimama pɨkawaruti'inɨataxɨ meta Wenikamini nuiwarimama, Kuhawi hepaɨtsita 'axamɨ'anekaikɨ mɨkɨ ti'aitame 'aitsikaya.  
\v 7 Metatsiere Kakaɨyari hepaɨtsita mɨkɨ 'aitsika 'axapɨ'anekai, 'ayumieme 'ixaheritsixi 'axapuwaruyuri.   
\p
\v 8 Hikɨ Rawiri Kakaɨyari mɨpaɨ katiniutahɨawe: «Yemekɨ waɨkawa 'axanepɨtiuyuri 'ikɨ kuyaxi nemɨwaruti'inɨataxɨkɨ. Mɨka'uka'iyari hepaɨ nepɨtiuyuri. Nepɨmatsiwawirie kwerietɨ netineuyehɨwiri ne ti'a'uximayatsiriwame».   
\p
\v 9 Yawé Kahari mɨpaɨ katiniutahɨawe yuniukame, Rawiri hetsiemieme mɨti'uximayakai:  
\v 10 «Kenemie Rawiri mɨpaɨ ketinetahɨawi, Yawé mɨpaɨ kanaineni: “Nepɨmatsipitɨa xeime pemanayexeiyakɨ 'ikɨ haikame 'uximatɨarikate. Yakenetineutahɨawi ke'aneme nepɨmatsipitɨani”».   
\p
\v 11 Hikɨ Kahari Rawiri hetsɨa kaneyani mɨpaɨ katineitahɨawe:  
\p ―Yawé mɨpaɨ kanaineni: “'Ikɨ mɨhaika ke'aneme pepɨnakierie:  
\v 12 haika wiyari haakaxa, nutsu haika metseri memɨxe'aye'unie mepɨxekwitɨweni 'ixiparakɨ, nutsu haika tukari kwiniya pɨtaweni meta niuki tuayame Yawé hetsɨa mieme pɨxekwika naitsarie 'Ixaheri kwieyaritsie”. Keneutimaixɨa yanetineutahɨawi neta yanemɨreitahɨawekɨ kemɨ'ane mɨnetsiheyenɨ'a.   
\p
\v 13 Rawiri Kahari mɨpaɨ katiniuta'eiya:  
\p ―Yemekɨ 'atsinepɨkatiyumaiwe ke'aneme nemanayexeiya. Matsi 'aixɨa pɨ'ane Yawé mɨnetsi'uximatɨanikɨ, naki'eriyaya mɨmariwekɨ, 'aixɨa pɨka'ane teɨteri xɨka menetsi'u'uximatɨani.   
\p
\v 14 Yawé, 'ayumieme 'Ixaheri kwieyaritsie kwiniya kanenɨ'ani, 'ana haika tewiyari heimana tamamata miriyari (70.000) mekaniukwini 'ixaheritsixi.  
\v 15 Meta Kerutsareme kiekariyaritsie yuniuki tuayame kanenɨ'ani mana kiekatari mɨwakwinikɨ. Hikɨ Yawé kepauka mixei wakwineme, kemɨtiwakwinitɨakai pɨwarutinenimayataxɨ, hikɨ niuki tuayame mɨpaɨ katiniutahɨawe: «'Ariri. Ketineuhayewa 'ari». 'Ana yemekɨ, niuki tuayame Yawé hetsɨa mieme 'Uxinahani kewutseu tewiyari tɨriku matihenatsie kaniuwekaitɨni.   
\p
\v 16 Rawiri kepauka manukunierixɨ, 'ana niuki tuayame Yawé hetsɨa mieme kaniuxeiya wapaitɨ 'uyewiekame, yu'ixipara Kerutsareme hepa heutatserakame. Hikɨ 'ana Rawiri meta 'ukirawetsixi hiwerika kamixayari me'anakatɨtɨkaitɨ mekaniukahɨxima'uni kwiepa.  
\v 17 Hikɨ Rawiri Kakaɨyari mɨpaɨ katiniutahɨawe: «Yawé pemɨnekakaɨyari, ne nepɨtiuyuri nemɨtiuta'aitaxɨ memɨti'inɨatsienikɨ teɨteri. Mɨkɨ teɨteri 'atsimepɨkate'uyuri. Nepɨta nekanihɨkɨtɨni 'axanemɨtiuyuri. Nepɨta netineukwinitɨa meta netɨɨriyama, 'ariri 'ateɨterima pepɨkawakwika».   
\s1 Rawiri mawari wewiwame kemɨtiutawewi  
\r (1Kem 21:18-26 – 2Tsam 24:18-25)  
\p
\v 18 Merikɨte niuki tuayame Yawé hetsɨa mieme Kahari mɨpaɨ katiniutahɨawe: «Rawiri mɨpaɨ ketinetahɨawi tenutsari mawari wewiwame Yawé hetsiemieme pɨtawewieni 'Uxinahani kewutseu tewiyari tɨriku matihenatsie».  
\v 19 Hikɨ Rawiri mana kaneyani mɨraye'atɨanikɨ, Kahari kemɨtitahɨawekai Yawé hetsiemieme.   
\p
\v 20 'Uxinahani tɨriku mana pu'unekai, kepauka ta'aurie manakunierixɨ niuki tuayame kaniuxeiya. Meyunaukatɨ niwemama hamatɨana memu'uwakai mekaniutinautsa mekaniuyuti'awieta.  
\v 21 Kepauka 'Uxinahani Rawiri muxei kwieya makuma hepa 'amiekame, hepana kanayeyani 'enunakeke, hikɨ hɨxiena kaniukahɨximakeni.  
\v 22 Hikɨ Rawiri mɨpaɨ katinitahɨawe:  
\p ―'Ikɨ 'akwie yayeume keneneutuiri, mana mawari wewiwame Yawé hetsiemieme nemɨtawewienikɨ, mɨtihayewakɨ kwiniya tatsikwitɨ teɨteri. Keneneutuiri yemekɨ kemɨraye'axe.   
\p
\v 23 'Uxinahani Rawiri mɨpaɨ katiniutahɨawe:  
\p ―Neti'aitɨwame, ne nekamanimimɨkɨ, 'ekɨ mana kemɨmatinake yaketineuyuri. Ne tuurutsixi kwietsanamete nekaniwayetɨamɨkɨ mawari taiyariyari pemɨwarayeitɨanikɨ, meta kɨyexi tɨriku 'uwame nepɨyetuani kɨmana pematinainikɨ meta tɨriku hatsi mawariyari pemayeitɨanikɨ. Ne mɨkɨ tinaime nekametinimikwani.   
\p
\v 24 Peru ti'aitame Rawiri 'Uxinahani mɨpaɨ katiniutahɨawe:  
\p ―Hawaikɨ mɨpaɨ 'aixɨa pɨka'ane. Yawé nepɨkatiyetuirieni tita mɨti'apiini, meta mawari taiyariyari nepɨka'iwewirieni nekarayukatuame. Naimekɨ nekatinayukatuamɨkɨ kepaɨmemetsie mɨti'axe.   
\p
\v 25 Rawiri 'Uxinahani huru tuminiyari 'ataxewime tsienituyari kaniu'ɨitɨani mɨkɨ kwiekɨ.  
\v 26 Mana kanitawewieni mawari wewiwame Yawé hetsiemieme, mana mawari taiyariyari kaniuwewieni meta memɨyuxewinikɨ mawariyari. Hikɨ Rawiri kaniuyutanenewieni, 'ana Yawé Kakaɨyari kanita'eiya mɨkɨ mawari hetsie tai kaneyenɨ'ani muyuawitsie mieme.   
\p
\v 27 Hikɨ Yawé yuniuki tuayame katiniutaxatɨani, mɨkɨ yu'ixipara muka'utakɨ.  
\v 28 Rawiri 'uniereka Yawé menu'eniekaikɨ, mana mawari kaniwewirieni.  
\v 29 'Ana 'ixuriki tukiyari Yawé hetsiemieme meta mawari taiyariyari wewiwame Muitsexi mitiwewiekai makumawetsie, Kawahuni paitɨ pɨreku'ukai.  
\v 30 Peru Rawiri waɨkawa heumatɨ Yawé pɨkaheku'iwawiyaxɨ mana, niuki tuayame Yawé hetsɨa mieme 'ixiparaya muxeikɨ.   
\c 22  
\p
\v 1 Hikɨ Rawiri mɨpaɨ kaniutayɨni: «'Ena Yawé Kakaɨyari tukieya kaniyutawewimɨkɨ, meta mawari taiyariyari wewiwame 'ixaheritsixi mana mawari memɨtiwewiwanikɨ».   
\s1 Kemɨtiukuha'aritsie tuki hetsie timieme  
\p
\v 2 Merikɨtsɨ Rawiri katiniuta'aita tewatari memɨkuxeɨriyanikɨ 'Ixaheri kwieyaritsie memɨtitekai. Mɨkɨ hipame kaniwaranayexeiya tetexi memɨtixixienikɨ kɨmana Kakaɨyari tukieya mɨtawewiyanikɨ.  
\v 3 Metatsiere Rawiri waɨkawa tepɨa kaniukuxeɨrieni mɨkɨkɨ mɨtitiwewiyanikɨ kɨrapuxite meta 'ituparitsie mawɨwɨre, meta waɨkawa wurunitse kaniukuxeɨrieni.  
\v 4 Yaxeikɨatsiere kariuxa kɨyeyari waɨkawa kaniukuxeɨrieni, mɨkɨ Tsirunitari meta Tiru kiekatari kariuxa kɨyeyari waɨkawa meni'atɨiriekaitɨni.   
\p
\v 5 Rawiri mɨpaɨ pɨtiku'eriwakai: «Neniwe Tsarumuni 'akuxi pɨtemaikɨ meta pɨkarakumate, tuki muyutawewieni Yawé hetsiemieme yemekɨ 'apɨtimariweni pumariwani naitsarie kwiepa, 'ayumieme tinaime nepɨtikuha'aritsirieni». Hikɨ mexi Rawiri 'uyeikakai tinaime katiniukuxeɨrieni.   
\p
\v 6 Hikɨ yuniwe Tsarumuni 'utakwewieka kanihɨritɨani tuki mɨtawewienikɨ Yawé 'Ixaheri Kakaɨyarieya hetsiemieme.  
\v 7 Rawiri Tsarumuni mɨpaɨ katiniutahɨawe: «Neniwe, ne mɨpaɨ nepɨtinekɨhɨawekai tuki nepɨtawewienikekai Yawé nekakaɨyari hetsiemieme.  
\v 8 Peru Yawé mɨpaɨ kanetiniutahɨawe: “'Ekɨ nehɨxie waɨkawa teɨteri pepɨwarukwi meta waɨkawamexɨa kuyaxa pepɨwewienekai, 'ayumieme 'ekɨ tuki pepɨkatawewieni.  
\v 9 Peru xewitɨ 'aniwe kayuwatɨ 'uyeikatɨ payani, ne yanepɨtiyurieni hipatɨ nuiwarite kemɨ'ane memeye'unieka 'aixɨa memɨte'ixeiyakɨ kayuwatɨ nekaniwapitɨamɨkɨ, 'ayumieme Tsarumuni katinitewakamɨkɨ. Kepauka mɨkɨ mɨtita'aita, ne 'ixaheritsixi kayuwatɨ nekaniwapitɨamɨkɨ meta 'aixɨa 'iyarikɨ memu'uwanikɨ.  
\v 10 Mɨkɨ pɨtiyurieni tuki mɨtawewieni nehetsiemieme. Mɨkɨ mɨneniwetɨni hepaɨ nepɨtimaika, neta nemɨ'ukiyarieyatɨni hepaɨ nepɨ'aneni hetsiena mieme. Meta yanekatiniyuriemɨkɨ yuheyemekɨ nuiwarimama memɨteta'aitakɨ 'Ixaheri kwieyaritsie”.   
\p
\v 11 »Hikɨ 'ayumieme neniwe, Yawé 'akakaɨyari kematsiparewieka tukieya pemɨtawewienikɨ, yemekɨ mɨkɨ kemutayɨ.  
\v 12 Kematsi'upitɨani pemɨtimaiwenikɨ meta pemɨrakumaikakɨ, kepauka pemanuyeyerɨni 'ixaheritsixi wahetsiemieme, 'aitsikaya pemaye'atɨanikɨ. Mɨkɨ Yawé 'akakaɨyari kanihɨkɨtɨni.  
\v 13 Xɨka peheye'atɨaka 'aitsikate kemutiyuane Yawé mɨwayetuiri 'Ixaheri meta Muitsexi yatikuxatakaku, mɨpaɨ 'aixɨa pekatiniuyeikamɨkɨ. Petɨrɨkaɨyetɨ pepɨra'iwani. Pepɨkamaka meta pepɨkatihayewani.   
\p
\v 14 »Neuxei, waɨkawa netiuta'uximayataka nepɨtiukuxeɨri Yawé tukieya hetsie timieme, haika miyuniyari heimana haika tsienituyari miriyari kiruyari raheteme huru, xeitewiyari heimana tamamata heimana haika miyuniyari kiruyari raheteme pɨrata, metatsiere wurunitse meta tepɨa waɨkawa nekaniukuxerieni kayu'inɨatsinɨakame. Meta tetexi, yaxeikɨa kɨyexi nekatiniukuxeɨrieni, peru 'ekɨta matsi waɨkawa ketinekuwawa.  
\v 15 Metatsiere pekaniwarexeiyani te'uximayatamete meyuwaɨkawame: Tetexi xixiwamete, kii wewiwamete, kɨyexikɨ te'uximayatamete, meta naime 'uximayatsikatsie mekatenakumaika,  
\v 16 hurukɨ, pɨratakɨ, wurunitsekɨ, meta tepɨakɨ. Merikɨ keneutsutɨa ketine'uximayakari Yawé kematsiparewieka».   
\p
\v 17 Hikɨ Rawiri yunaime 'ixaheritsixi wa'ukiyarima kaniwaruhɨritɨani yuniwe Tsarumuni memiparewienikɨ.  
\v 18 Mɨpaɨ pɨtiwarutahɨawixɨ: «Yawé xekakaɨyari xehamatɨa kaniuyeikani, kayuwatɨ kanixepitɨaka naitsarie muyehane. Ta'aurie kiekatari kaneniyetuirieni, meta mɨkɨ hikɨ Yawé katiniwa'aitɨaka meta xeme teɨterimama.  
\v 19 'Ayumieme hikɨ Yawé yukakaɨyari xekeneutiwawa yurikɨ yemekɨ yu'iyarikɨ. Xekeneutsutɨa tuki 'uximayatsikayari Yawé kakaɨyari hetsiemieme, tɨratu kakuniyari meta naime Kakaɨyari tipiiniteya mɨtipatsietɨka muwa xemɨte'atɨanikɨ tukieya mɨtawewiyanita».   
\c 23  
\s1 Rewitsixi  
\p
\v 1 Merikɨte Rawiri waɨkawa 'ukiratsitɨtɨri yuniwe Tsarumuni kananukakeni ti'aitame mayanikɨ 'Ixaheri kwieyaritsie.  
\v 2 Yunaime 'ixaheritsixi wa'ukiyarima kaniwarukuxeɨrieni meta mawari wewiwamete metatsiere rewitsixi.  
\v 3 Hikɨ rewitsixi mekaniuti'inɨatsieni, xeitewiyari heimana tamamata wiyari memɨhɨtɨkatei, meputipaɨmerixɨ xeitewiyari heimana tamamata heimana 'atahaika miriyari (38.000) 'ukitsi.  
\v 4 Mɨkɨ, xeitewiyari heimana nauka miriyari (24.000) meyupaɨmetɨ Yawé tukieya manuwe mepɨhɨritɨariekai 'uximayatsika, meta 'ataxewi miriyari meyupaɨmetɨ ti'aitame 'aurie meputi'ukai hipatɨta mepɨ'itsɨkatetɨkai,  
\v 5 nauka miriyari kitenie tehɨwemete mepɨhɨkɨtɨkai, hipatɨta nauka miriyari Yawé hetsiemieme kwikamete mepɨhɨkɨtɨkai kanaritekɨ, Rawiri miti'aitakai mɨpaɨ 'ayumieme.   
\p
\v 6 Hikɨ Rawiri rewitsixi me'ayehaikame kaniwarayeitɨani Rewi niwemama kememɨyupaɨmekai, mekanihɨkɨtɨni: Keritsuni, Kuhati meta Merari.   
\s1 Keritsunitsixi  
\li1
\v 7 Keritsuni niwemama: Rarani meta Tsimi.   
\li1
\v 8 Rarani niwemama mepɨyuhaikakai: Kehieri puwamatsikatɨkai, Tsetani meta Kuheri.   
\li1
\v 9 Mɨkɨ mepakɨ Rarani nuiwarimama wa'ukiyarima. Tsimi yuhaikame pɨwarayexei: Tserumiti, Katsiheri meta Karani.   
\li1
\v 10 Tawari Tsimi niwemama yunaukatɨ mepakɨ: Yakati, Tsitsa, Kehutsi meta Weriya. Mɨkɨ Tsimi niwemama mepakɨ.  
\v 11 Yakati wamatsika pɨhɨkɨtɨkai, Tsitsa hutarieka mieme. 'Ikɨ Kehutsi meta Weriya matɨa waɨkawa tɨɨri memɨkawarayexeikɨ, xeinuiwari memɨhɨkɨtɨni hepaɨ xeikɨa mepɨte'inɨatsiekai, yunaitɨ xei'uximayatsikayari mepupitɨarie.   
\s1 Kuhatitsixi  
\li1
\v 12 Kuhati niwemama mepɨyunaukakai: 'Amirani, 'Itsaxi, Hewuruni meta 'Utsiheri.   
\li1
\v 13 'Amirani niwemama mepakɨ, 'Aruni meta Muitsexi. 'Aruni meta nuiwarimama mepanayexeiyarie mawari memɨwewiekakɨ yemekɨ mɨpatsietɨka, 'ɨkwa memukutaiyanikɨ, Yawé hetsiemieme memɨte'uximayakakɨ meta Kakaɨyari memɨwawiriekakɨ 'aixɨa muwayuriekakɨ teɨteri.  
\v 14 Muitsexi, tewi Kakaɨyari menayexei, meta niwemama mekaniu'inɨatsieni Rewi nuiwarimama wahamatɨa.   
\li1
\v 15 Muitsexi niwemama mepakɨ, Keritsuni meta 'Eriyetsexi.   
\li1
\v 16 Keritsuni nu'aya matɨarieya patɨa, Tsewuheri.   
\li1
\v 17 'Eriyetsexi xeime xeikɨa payexei yuniwe, Xekawiyaxi patɨa, mɨkɨ hɨrixɨa waɨkawa yuniwema puwarayexei.   
\li1
\v 18 'Itsaxi nu'aya mexɨakame patɨa Tserumiti.   
\li1
\v 19 Hewuruni nu'aya mexɨakame patɨa Keriyaxi, hutarieka mieme 'Amariyaxi, hairieka mieme Kahatsieri, naurieka mieme Kekamani.   
\li1
\v 20 'Utsiheri nu'aya mexɨakame patɨa Mikahiyaxi, hutarieka mieme 'Itsiyaxi pɨtitewakai.   
\s1 Meraritsixi  
\li1
\v 21 Merari niwemama mepɨhɨkɨtɨkai Makiri meta Mutsihí.  
\li1 Makiri niwemama mepɨhɨkɨtɨkai 'Eriyatsaxi meta Kihitsi.   
\li1
\v 22 'Eriyatsaxi tɨɨri 'ukitsi kawarayexeiyaka kaniumɨni: 'ukari xeikɨa pɨwarayexei. Mɨkɨ yatewa yu'iwama mepɨwarutiwitɨ Kihitsi niwemama.   
\li1
\v 23 Mutsihí yuniwema yuhaikame puwarayexei: Makiri, 'Eraxi meta Keremuti.   
\b  
\p
\v 24 'Ikɨ Rewi nuiwarimama mepɨhɨkɨ, niwemama yuxexuitɨ kememɨteyutamɨiriyaxɨ. 'Ana mepaka'utsie kemɨtetewakai wa'ukiyarima. Mɨkɨ mepɨte'uximayakai Yawé tukieya manuwe 'amemɨyumate xeikɨa, xeitewiyari heima meutiyune wiyari xeikɨa mepexeiyatɨkatei.   
\p
\v 25 Rawiri mɨpaɨ kaniutayɨni: «Kepauka paitɨtɨ Yawé, 'ixaheritsixi takakaɨyari, yuteɨterima mɨtatsi'anukayatsaxɨ meta yukie mayeitɨa yuheyemekɨ Kerutsareme kiekariyatsie,  
\v 26 pɨkaheuyewetseri rewitsixi tuki memɨkutɨtɨwenikɨ meta piinitɨarika muwa mawaritsie timieme».   
\p
\v 27 'Imatɨrieka Rawiri kemɨtiu'aitaxɨ, yunaitɨ rewitsixi xeitewiyari wiyari memɨhɨtɨka mekanaka'utsieni memɨteta'uximayatakɨ,  
\v 28 'Aruni nuiwarimama memɨwaparewienikɨ, Yawé tukieya manuwe memɨteta'uximayatakɨ. Takwa mepɨhɨritɨariekai meta kiita 'etsimuyeyeyeuta yaxeikɨa meta mepɨhɨritɨariekai piinite mawaritsie timieme memɨteti'itiwanikɨ, meta hipame 'uximayatsika tuki hetsiemieme.  
\v 29 Yaxeikɨata mepɨhɨritɨariekai paa Kakaɨyari hɨxie mieme, meta tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatsite mawariyari hetsiemieme, harina papayari mɨkakuxanariyarietɨka meta mawari mɨtixarikietɨka mɨti'etsarietɨka metatsiere te'inɨnɨatamete naime hepaɨtsita mepɨhɨkɨtɨkai.  
\v 30 Mepɨhɨritɨariekai ximeri meta taikai memɨ'axenikɨ pamɨpariyutsi memipitɨakakɨ meta meminɨawanikɨ Yawé.  
\v 31 Metatsiere mepɨhɨritɨariekai mawari taiyariyari memutiwewiwanikɨ Yawé hetsiemieme mutiwewiwakai xawatikɨ meta metseri 'etsimɨpenitsie meta hipatɨ 'ixɨarari maye'axenitsie. Mɨpaɨ yamekateni'uximayakaitɨni Yawé hetsiemieme yayupapaɨmetɨ, kememɨte'aitɨariekai.  
\v 32 Mɨpaɨ mepɨtehɨritɨariekai 'ixuriki tukiyari memɨ'ɨwiyanikɨ meta tuki muyepatsie. Kepauka memɨte'uximayakai Yawé tukieyata, wa'iwama 'Aruni nuiwarimama yametewarahɨawekaku mepɨte'uximayakai.   
\c 24  
\s1 Mawari wewiwamete kememɨte'uximayata  
\p
\v 1 'Aruni nuiwarimama 'ipaɨ mekateniuyu'uitɨani: 'Aruni niwemama mepɨhɨkɨ Narawi, 'Awihu, 'Eriyatsaxi meta 'Itamaxi.   
\p
\v 2 Narawi meta 'Awihu mekaniukwini tɨɨri mekawarayexeiyawawetɨ wapaapa kamɨwekaku 'akuxi, hikɨ 'Eriyatsaxi meta 'Itamaxi xeikɨari mawari wewiwamete mekanakɨne.   
\p
\v 3 'Eriyatsaxi nuiwarieya Tsaruki, meta 'Itamaxi nuiwarieya 'Akimereki, mɨkɨ Rawiri meparewiekaku 'aixɨa katiniwaru'uitɨani mawari wewiwamete kehapaɨ memɨte'uximayatakekai.  
\v 4 'Eriyatsaxi nuiwarimama wa'ukiyarima memɨyuwaɨkawakai keyuri 'Itamaxi nuiwarimama wa'ukiyarima, 'ipaɨ mekateniwaru'uitɨani: Tamamata heimana 'ataxewi mepɨyupaɨmekai 'Eriyatsaxi nuiwarimama wa'ukiyarima, meta 'Itamaxi nuiwarimama wa'ukiyarima 'atahaika mepɨyupaɨmekai.  
\v 5 Yunaitɨ 'inɨarikɨ mekaniupitɨarieni 'uximayatsika, yunaitɨ 'Eriyatsaxi nuiwarimama meta 'Itamaxi nuiwarimama watsata mepanu'ukai 'uximayatsika memakumate tukita mieme meta Kakaɨyaritsɨa mieme.  
\v 6 Ti'utɨwame Tsemahiyaxi Natanaheri nu'aya, Rewi nuiwarieya hetsiemieme, mɨkɨ kaniwaraka'utɨani kememɨtetewakai ti'aitame hɨxie meta 'iparewiwamete, mawari wewiwamete Tsaruki meta 'Akimereki 'Awiyataxi nu'aya, mawari wewiwamete nuiwariyari wa'ukiyarima, meta rewitsixi nuiwariyari wa'ukiyarima wahɨxie. 'Eriyatsaxi nuiwarimama hutakɨa mekaniupitɨarieni 'inɨari, peru 'Itamaxi nuiwarimama heiwamieme xeikɨa.   
\b  
\li1
\v 7 'Inɨari matɨari mieme pɨtiunakixɨ Kuyariwi,  
\li1 hutarieka pɨtiunakixɨ Kerahiyaxi,   
\li1
\v 8 hairieka pɨtiunakixɨ Karini,  
\li1 naurieka pɨtiunakixɨ Tsehurini,   
\li1
\v 9 'auxɨwirieka pɨtiunakixɨ Marikiyaxi,  
\li1 'ataxewirieka pɨtiunakixɨ Mikamini,   
\li1
\v 10 'atahutarieka pɨtiunakixɨ Kuhutsi,  
\li1 'atahairieka pɨtiunakixɨ 'Awiyaxi,   
\li1
\v 11 'atanaurieka pɨtiunakixɨ Ketsuha,  
\li1 tamamatarieka pɨtiunakixɨ Tsekaniyaxi,   
\li1
\v 12 tamamata heimana xewi mieme patɨa 'Eriyatsiwi,  
\li1 tamamata heimana hutarieka mieme patɨa Yakini,   
\li1
\v 13 tamamata heimana hairieka mieme patɨa Hupá,  
\li1 tamamata heimana naurieka mieme patɨa Ketsewa,   
\li1
\v 14 tamamata heimana 'auxɨwi mieme patɨa Wirika,  
\li1 tamamata heimana 'ataxewi mieme patɨa 'Imexi,   
\li1
\v 15 tamamata heimana 'atahuta mieme patɨa Hetsixi,  
\li1 tamamata heimana 'atahaika mieme patɨa 'Aputsexi,   
\li1
\v 16 tamamata heimana 'atanauka mieme patɨa Petahiyaxi,  
\li1 xeitewiyaritsie mieme patɨa 'Etsekieri,   
\li1
\v 17 xeitewiyari heimana xewitsie mieme patɨa Kakini,  
\li1 xeitewiyari heimana hutarieka mieme patɨa Kamuri,   
\li1
\v 18 xeitewiyari heimana hairieka mieme patɨa Rerahiyaxi,  
\li1 xeitewiyari heimana naurieka mieme patɨa Mahatsiyaxi.   
\b  
\p
\v 19 Mɨpaɨ mekateniuyu'uitɨani Yawé tukieyata memɨteta'uximayatakɨ, yemekɨ Yawé 'ixaheritsixi takakaɨyari 'Aruni kemɨrahɨawekai, mawari wewiwamete wa'ukiyari.   
\s1 Rewitsixi memɨyuhayewaxɨ  
\p
\v 20 'Ikɨ Rewi nuiwarimama memuyuhayewaxɨ memaka'utɨarie mepɨhɨkɨ:  
\li1 'Amirani nuiwarimama Tsuwaheri wa'ukiyari patɨa,  
\li1 Tsuwaheri nuiwarimama Keheriyaxi wa'ukiyari patɨa.   
\li1
\v 21 Xekawiyaxi nuiwarimama 'Itsiyaxi wa'ukiyari patɨa, mɨkɨ mɨmexɨakametɨkai.   
\li1
\v 22 'Itsaxi nuiwarimama Tserumuti wa'ukiyari patɨa,  
\li1 Tserumuti nuiwarimama Yakati wa'ukiyari patɨa.   
\li1
\v 23 Hewuruni niwemama: mexɨakame Keriyaxi patɨa, hutarieka mieme 'Amariyaxi patɨa, hairieka mieme Kahatsieri patɨa, naurieka mieme Kekamani.   
\li1
\v 24 'Utsiheri nuiwarimama Mikahiyaxi wa'ukiyari patɨa,  
\li1 Mikahiyaxi nuiwarimama Tsamixi wa'ukiyari patɨa,   
\li1
\v 25 'Itsiyaxi Mikahiyaxi pɨ'iwayatɨkai,  
\li1 'Itsiyaxi nuiwarimama Tsakariyaxi wa'ukiyari patɨa,   
\li1
\v 26 Merari nuiwarimama Makiri meta Mutsihí wa'ukiyarima mepakɨ,  
\li1 Wenuhu nuiwarimama Katsiyaxi wa'ukiyari patɨa.   
\li1
\v 27 Merari nuiwarimama hipatɨta:  
\li1 Katsiyaxi hetsiemiemete: Wenuhu, Tsukani, Tsakuxi meta 'Iwiri.   
\li1
\v 28 Makiri hetsiemiemete: 'Eriyatsaxi, mɨkɨ tɨɨri pɨkawarayexei.   
\li1
\v 29 Kihitsi hetsiemiemete: nu'aya Kerameri.   
\li1
\v 30 Mutsihí niwemama wahetsiemieme: Makiri, 'Eraxi meta Keremuti.  
\b  
\p 'Ikɨ mepɨhɨkɨ rewitsixi wanuiwarima wa'ukiyarima kememɨyutipaɨmerixɨ.  
\v 31 Yaxeikɨa yu'iwama 'Aruni nuiwarimama wahepaɨ 'inɨarikɨ 'uximayatsika mepupitɨarie ti'aitame Rawiri hɨxie, meta Tsaruki, 'Akimereki meta mawari wewiwamete nuiwariyari wa'ukiyarima meta rewitsixi wa'ukiyarima. 'Amemɨyumate meta yakɨ memɨyumate yaxeikɨa mepɨtepitɨariekai 'uximayatsikakɨ.   
\c 25  
\s1 Teyuitɨwamete meta kwikamete  
\p
\v 1 Teyuitɨwamete memakɨne, Rawiri meta kuyaxi tewa'aitɨwamete mekaniwaranayexeiya 'Atsahapi niwemama, Hemani meta Kerutuni niwemama, mɨkɨ Kakaɨyari niukieya memɨtahekɨatakɨ meteyuitɨatɨ 'aripatsie, kanarikɨ meta mɨtiutitirirɨkakɨ. 'Ikɨ mekanihɨkɨtɨni memaka'utɨarie mɨpaɨ memɨteta'uximayatakɨ:   
\b  
\li1
\v 2 'Atsahapi niwemama: Tsakuxi, Kutse, Netaniyaxi meta 'Atsarera. Mɨkɨ pɨwakuyuitɨwakai 'Atsahapi, meta pɨtihekɨatakai kwikarikɨ ti'aitame Rawiri yarehɨawekaku.   
\li1
\v 3 Kerutuni niwemama me'ataxewitɨ: Kerariyaxi, Tseri, Kitsariyaxi, Tsimihi, Katsawiyaxi meta Matatiyaxi. 'Ikɨ wapaapa Kerutuni pɨtiwa'aitɨakai, mɨkɨ meteyuitɨatɨ 'aripakɨ Yawé niukieya mepɨhekɨatakai meta pamɨpariyutsi mepipitɨakai me'inɨawatɨ.   
\li1
\v 4 Hemani niwemama: Wukiyaxi, Mataniyaxi, 'Utsiheri, Tsewuheri, Keremuti, Kananiyaxi, Kananihi, 'Erihata, Kirariti, Xumaniti-'Etsexi, Kutsiwekatsa, Maruti, Hutixi meta Mahatsihuti.  
\v 5 Mɨkɨ yunaitɨ Hemani mepɨniwemama, ti'aitame hetsiemieme Kakaɨyari niukameya mɨhɨkɨtɨkai, hikɨ mɨkɨ Kakaɨyari niukieyakɨ 'aixɨa meputiyuanekai tɨrɨkariyaya hepaɨtsita. Kakaɨyari Hemani tɨɨri peiyenɨ'airi, tamamata heimana meyunaukame 'ukitsi meta 'ukari yuhaikame.   
\b  
\p
\v 6 Mɨkɨ Yawé tukieyatapaitɨ wapaapa pɨtiwaku'ɨkitɨwakai kepauka memutikwikakai mɨtiutitiraurɨkakɨ, kanaritekɨ meta 'aripakɨ. 'Atsahapi, Kerutuni meta Hemani, mɨkɨ yamepɨteyuriekai ti'aitame kemɨtiwa'aitɨakai.  
\v 7 Mɨkɨ huta tsienituyari heimana nauka tewiyari heimana 'atahaika (288) mepɨyupaɨmekai yunaitɨ, mɨkɨ mepɨte'uti'ɨkitɨariekai Yawé hetsiemieme kwikamete memɨhɨkɨtɨnikɨ.   
\p
\v 8 Yu'uximayatsika mepupitɨarie 'inɨarikɨ kepauka memɨte'ukayuitɨwani, yunaitɨ 'etsimemɨyumate meta 'amemɨyumate meta te'ɨkitamete metatsiere teyu'ɨkitɨwamete meyunaitɨ.   
\b  
\li1
\v 9 Hikɨ mexɨakame pɨtiunakixɨ Kutse 'Atsahapi nu'aya, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai,  
\li1 hutarieka pɨtiunakixɨ Kerariyaxi, 'iwamama meta niwemama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 10 Hairieka pɨtiunakixɨ Tsakuxi, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 11 Naurieka pɨtiunakixɨ 'Itsihiri, niwemama meta 'iwamama, meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 12 'Auxɨwirieka pɨtiunakixɨ Netaniyaxi, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 13 'Ataxewirieka pɨtiunakixɨ Wukiyaxi, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 14 'Atahutarieka pɨtiunakixɨ Ketsarera, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 15 'Atahairieka pɨtiunakixɨ Kitsariyaxi, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 16 'Atanaurieka pɨtiunakixɨ Mataniyaxi, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 17 Tamamatarieka pɨtiunakixɨ Tsimi, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 18 Tamamata heimana xewi pɨtiunakixɨ 'Atsareri, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 19 Tamamata heimana huta pɨtiunakixɨ Katsawiyaxi, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta memɨyupaɨmekai.   
\li1
\v 20 Tamamata heimana hairieka pɨtiunakixɨ Tsuwaheri, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 21 Tamamata heimana naurieka pɨtiunakixɨ Matatiyaxi, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 22 Tamamata heimana 'auxɨwirieka pɨtiunakixɨ Keremuti, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 23 Tamamata heimana 'ataxewirieka pɨtiunakixɨ Kananiyaxi, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 24 Tamamata heimana 'atahutarieka pɨtiunakixɨ Kutsiwekatsa, niwemama meta 'iwamama tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 25 Tamamata heimana 'atahairieka pɨtiunakixɨ Kananihi, yuniwema meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 26 Tamamata heimana 'atanaukarieka pɨtiunakixɨ Maruti, niwemama meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 27 Xeitewiyaritsie pɨtiunakixɨ 'Eriyata, yuniwema meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 28 Xeitewiyari heimana xewi pɨtiunakixɨ Hutixi, yuniwema meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 29 Xeitewiyari heimana huta pɨtiunakixɨ Kirariti yuniwema meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 30 Xeitewiyari heimana hairieka pɨtiunakixɨ Mahatsihuti, yuniwema meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\li1
\v 31 Xeitewiyari heimana naurieka pɨtiunakixɨ Xumaniti-'Etsexi, yuniwema meta 'iwamama meyunaitɨ tamamata heimana huta mepɨyupaɨmekai.   
\c 26  
\s1 Kitenie tehɨwemete  
\p
\v 1 Kitenie tehɨwemete kememɨte'u'uitɨarie:  
\b  
\li1 Kurehe nuiwarimama hetsiemieme: Metseremiyaxi Kurehe nu'aya, 'Atsahapi nuiwarieyatsie mieme.   
\li1
\v 2 Metseremiyaxi niwemama mepakɨ:  
\li1 Matɨari mieme Tsakariyaxi,  
\li1 hutarieka mieme Keriyaheri,  
\li1 hairieka mieme Tsewariyaxi,  
\li1 naurieka mieme Katinieri   
\li1
\v 3 'auxɨwirieka mieme 'Erami  
\li1 'ataxewirieka mieme Kuhanahani,  
\li1 'atahutarieka mieme 'Erihuhenahi.   
\li1
\v 4 'Uweri-'Erumi niwemama mepakɨ:  
\li1 Mexɨakame mieme Tsemahiyaxi,  
\li1 hutarieka mieme Kutsawari,  
\li1 hairieka mieme Kuha,  
\li1 naurieka mieme Tsakaxi,  
\li1 'auxɨwirieka mieme Natanaheri,   
\li1
\v 5 'ataxewirieka mieme 'Amiheri,  
\li1 'atahutarieka mieme 'Itsakaxi.  
\li1 'atahairieka mieme Pehuritahi.  
\li1 Kakaɨyari 'Uweri-'Erumi 'aixɨa kaniuyurieni tɨɨri waɨkawa mɨwarayexeiyakɨ.   
\b  
\li1
\v 6 'Uweri-'Erumi nu'aya Tsemahiyaxi mɨkɨta tɨɨri pɨwarayexei, mɨkɨ mepakɨ yutɨɨriyama wahetsiemieme memanuyetekai, teɨteri memɨkamama mepɨhɨkɨtɨkai.  
\v 7 Tsemahiyaxi niwemama mepɨhɨkɨtɨkai, 'Utini, Xapahiri, 'Uweri, 'Eritsawari meta wa'iwama 'Erihu meta Tsamakiyaxi, mɨkɨ yunaitɨ teɨteri memɨkamama mepɨhɨkɨtɨkai.  
\v 8 Mɨkɨ yunaitɨ 'Uweri-'Erumi mepɨnuiwarimamatɨkai. Mɨkɨ meta waniwema meta wa'iwama teɨteri memɨkamama memɨtɨrɨkawi mepɨhɨkɨtɨkai 'uximayatsikakɨ. Yunaitɨ haika tewiyari heimana huta mepɨyupaɨmekai, 'Uweri-'Erumi nuiwarimama.   
\li1
\v 9 Metseremiyaxi niwemama meta 'iwamama meyunaitɨ, tamamata heimana 'atahaika mepɨyupaɨmekai, mɨkɨ teɨteri memɨkamama mepɨhɨkɨtɨkai.   
\b  
\li1
\v 10 Kutsa niwemama, Merari nuiwarieya hetsiemieme, mepɨhɨkɨ Tsimɨri, wa'ukiyari matɨa (tsepa mɨkamexɨakametɨkai, peru 'ukiyarieya manuyeka kaneyeitɨani),  
\v 11 hutarieka mieme Kirikiyaxi patɨa, hairieka mieme Tewariyaxi patɨa meta naurieka Tsakariyaxi. Mɨkɨ yunaitɨ Kutsa niwemama meta 'iwamama mepakɨ tamamata heimana haika.   
\p
\v 12 Merikɨte mɨpaɨ mekateniu'uitɨarieni kitenie tehɨwemete, memanuyetei meta wa'iwama, Yawé tukieyata memɨte'uximayakakɨ.  
\v 13 Kitenie kepauka memɨtetahɨnikekai mepupitɨarie 'inɨarikɨ yuxexuitɨ nuiwarite 'amemɨyumate meta 'etsimemɨyumate yunaitɨ.   
\p
\v 14 'Inɨarikɨ kememɨte'upitɨarie, Tseremiyaxi pɨtiunakixɨ 'itupari tau manatineika hepa meuwie, meta nu'aya Tsakariyaxi, mɨtimaiwekai mɨ'ɨxatsitametɨkai, pɨtiunakixɨ 'itupari tayetatsie meuwie.  
\v 15 'Uweri-'Erumi pɨtiunakixɨ kitenie tahetɨa hepatsie meuwie, meta niwemama mepɨhɨritɨarie 'ikwaite mɨtiuyepine tukita timieme.  
\v 16 Tsupini meta Kutsa matɨa Tsareketi kitenieyari mekateniunake, tau makayuyuipike hepatsie, huye teikɨmana meutiyɨnetsie.  
\p Yuxexuitɨ nuiwarite kemɨ'ane kitenieyaritsie memɨte'unakixɨ mana mekatenihɨkaitɨni yayupapaɨmetɨ:  
\v 17 Xexuime tukaritsie me'ataxewitɨ rewitsixi tau manatineika hepa meukitenietsie mepu'uwekai, yunaukatɨ tayeta hepatsie, meta yunaukatɨ tahetɨa hepatsie, meta yuhuhutatɨ xexuime 'ikwaite mɨtiuyepitɨkatsie mepɨtehɨkai.  
\v 18 Takwa tau makayuyuipike hepa mukumatsie yuhutatɨ mepɨtehɨkai rewitsixi meta yunaukatɨ mɨkɨ huyeyari 'utɨma.   
\p
\v 19 Mɨpaɨ mekateniu'uitɨarieni kitenie tehɨwemete Kure meta Merari wanuiwarima.   
\s1 Piinite mɨraye'atɨka tehɨwemete  
\p
\v 20 Hipatɨta rewitsixi mepɨte'ɨhɨritɨarie tukita timieme piini mɨraye'atɨka meta mɨtipatsietɨka Kakaɨyari hetsie timieme muwa mɨtiuyepitɨkatsie.  
\v 21 Rarani Keritsuni punuiwarieyatɨkai, Kehieri manuyeka kanayani Rarani nuiwarimama wahetsie.  
\v 22 Kehieri niwemama Tsetani meta Kuheri, mɨkɨ mepɨhɨritɨarie piinite mɨraye'atɨka Yawé tukita timieme.   
\p
\v 23-24 Tsewuheri, Keritsuni nuiwarieya Muitsexi nu'aya, mɨkɨ tumini hɨwemete wa'ukiyari pɨhɨkɨtɨkai yunaime wahetsiemieme, 'Amirani nuiwarimama, 'Itsaxi nuiwarimama, Hewuruni nuiwarimama meta 'Utsiheri nuiwarimama.   
\li1
\v 25 'Eriyetsexi nuiwarimama kememɨte'unuiwaxɨ, Xekawiyaxi, Kitsariyaxi, Kurani, Tsikɨri meta Tserumiti.  
\v 26 Tserumiti meta 'iwamama mepuhɨritɨarie piinite mɨtipatsietɨka hipatɨ memɨteyetua, ti'aitame Rawiri, meta nuiwarite wa'ukiyarima, meta kuyaxi xeimiriyari meta xeitsienituyari tewa'aitɨwamete meta hipatɨ kuyaxi tewa'aitɨwamete.  
\v 27 Mɨkɨ mepɨteyetuakai piinitɨarika kuyaxa memɨteha'iwakai, kɨmana Yawé tukieya 'aixɨa muku'itɨarienikɨ.  
\v 28 Tserumiti meta 'iwamama mepɨhɨritɨariekai, Tsamuheri Kakaɨyari niukameya mɨtiyetua, Tsahuri Kihitsi nu'aya mɨtiyetua, meta 'Awinexi Nexi nu'aya meta Kuhawi Tsariwiya nu'aya memɨteyetua.   
\li1
\v 29 Kenaniyaxi meta niwemama, 'Itsaxi memɨnuiwarimama, mɨkɨ mepɨ'itsukatetɨkai ti'aitame mepɨparewiekai 'aixɨa mepɨte'akayuruwakai naime 'uximatɨarikatsie 'Ixaheri kwieyaritsie.   
\li1
\v 30 Katsawiyaxi meta maremama, mɨkɨ Hewuruni nuiwarimama mepɨhɨkɨtɨkai, xeimiriyari heimana 'atahuta tsienituyari mepɨkɨkɨtɨkai teɨteri memɨkamama. Mɨkɨ Kurutani 'anutaɨye tau makayuyuipike hepa 'ixaheritsixi watsata mepɨte'uximayakai Yawé hetsiemieme meta ti'aitame hetsiemieme.  
\v 31 Hewuruni nuiwarimama wa'ukiyari Keriyaxi pɨhɨkɨtɨkai. Huta tewiyari wiyari Rawiri ti'aitakaku, kaneutixeiyariexɨani Hewuruni nuiwarieya xapayari, mekaniutaxeiyarieni Katsexi kiekariyaritsie Karaha kwieyaritsie teɨteri memɨkamama.  
\v 32 Mɨkɨ teɨteri memɨkamama mekaniyupaɨmekaitɨni huta miriyari heimana 'atahuta tsienituyari (2.700). Rawiri ti'aitame kaniwaruhɨritɨani memɨte'uximayakakɨ Xuweni nuiwarimama, Kahari nuiwarimama, meta Manatsexi nuiwarimama hixɨapa memɨ'axe wahetsiemieme, tinaimekɨ Kakaɨyari hetsiemieme meta ti'aitame hetsie timieme.   
\c 27  
\s1 Kuyaxi kememɨte'u'uitɨarie  
\p
\v 1 'Ikɨ mekanihɨkɨtɨni kememɨte'aka'utɨarie xapatsie nuiwarite wa'ukiyarima, xeimiriyari meta xeitsienituyari kuyaxi memɨtewa'aitɨa, meta ti'aitame parewiwametemama kuyaxi 'ixaheritsixi memɨhɨritɨariekai. Xeikuyaxiyari mepɨyupapaɨmekai xeitewiyari heimana nauka miriyari, mɨkɨ mepɨte'utahɨwekai xeimetseri xeiwiyaritsie ti'aitame hetsiemieme.   
\b  
\li1
\v 2 Matɨari metseritsie miemete kuyaxi, xeitewiyari heimana nauka miriyari memɨyupaɨme, wa'ukiyari pɨhɨkɨtɨkai Yatsuwehani Tsawirieri nu'aya,  
\v 3 Paretsi nuiwarieya hetsiemieme. Mɨkɨ wa'ukiyari pɨhɨkɨtɨkai yunaime kuyaxi memɨwanɨ'a mexɨakame metseritsie memɨte'uta'uximayatakai.   
\li1
\v 4 Hutarieka metseritsie miemete kuyaxi, xeitewiyari heimana nauka miriyari memɨyupaɨme, Rurahi 'Akuki nuiwarieya hetsiemieme, mɨkɨ manuyeka pɨhɨkɨtɨkai. Mɨkɨ wa'ukiyari Mikuruti pɨtitewakai.   
\li1
\v 5 Hairieka metseritsie miemete kuyaxi xeitewiyari heimana nauka miriyari memɨyupaɨme, wa'ukiyari pɨhɨkɨtɨkai Wenahiyaxi, mawari wewiwamete tiwa'aitɨwame Kuyara nu'aya.  
\v 6 Wenahiyaxi xeitewiyari heimana tamamata kuyaxi memɨkamama puwanɨkai, meta mɨkɨ muwanɨ'a pɨhɨkɨtɨkai. Mɨkɨ nu'aya 'Amitsawari hairieka metseritsie miemete wahamatɨa payewekai.   
\li1
\v 7 Naurieka metseritsie miemete kuyaxi xeitewiyari heimana nauka miriyari memɨyupaɨme, 'Atsaheri muwanɨ'a pɨhɨkɨtɨkai, Kuhawi 'iwaya. 'Arike hetsiena mieme kananukakeni nu'aya Tsewariyaxi.   
\li1
\v 8 'Auxɨwirieka metseritsie miemete kuyaxi xeitewiyari heimana nauka miriyari memɨyupaɨme, Tsamuti 'Itsiraha kiekame muwanɨ'a pɨhɨkɨtɨkai.   
\li1
\v 9 'Ataxewirieka metseritsie miemete kuyaxi xeitewiyari heimana nauka miriyari memɨyupaɨme, 'Ira muwanɨ'a pɨhɨkɨtɨkai 'Iketsi Tekuha kiekame nu'aya.   
\li1
\v 10 'Atahutarieka metseritsie miemete kuyaxi xeitewiyari heimana nauka miriyari memɨyupaɨme, Heretsi muwanɨ'a pɨhɨkɨtɨkai Peruni kiekame 'Epɨrahini nuiwarieya.   
\li1
\v 11 'Atahairieka metseritsie miemete kuyaxi xeitewiyari heimana nauka miriyari memɨyupaɨme, Tsiwekahi Kutsa kiekame muwanɨ'a pɨhɨkɨtɨkai, Tsera nuiwarieyatsie mieme.   
\li1
\v 12 'Atanaurieka metseritsie miemete kuyaxi xeitewiyari heimana nauka miriyari memɨyupaɨme, 'Awihetsexi 'Anatuti kiekame muwanɨ'a pɨhɨkɨtɨkai Wenikamini nuiwarieya hetsiemieme.   
\li1
\v 13 Tamamata metseritsie mieme, Marahi Netupa kiekame muwanɨ'a pɨhɨkɨtɨkai, mɨkɨta pɨwarexeiyakai xeitewiyari heimana nauka miriyari, Tsera nuiwarieya hetsiemieme.   
\li1
\v 14 Tamamata heimana xewi metseritsie miemete, muwanɨ'a pɨhɨkɨtɨkai Wenahiyaxi Piratuni kiekame, 'Epɨrahini nuiwarieya hetsiemieme, mɨkɨta pɨwarexeiyakai xeitewiyari heimana nauka miriyari.   
\li1
\v 15 Tamamata heimana huta metseritsie miemete, Kerirahi Netupa kiekame muwanɨ'a pɨhɨkɨtɨkai, 'Utunieri nuiwarieya hetsiemieme, mɨkɨta xeitewiyari heimana nauka miriyari puwarexeiyakai.   
\s1 Nuiwarite memɨwanɨ'a  
\p
\v 16 Merikɨte 'ikɨta mepɨhɨkɨ 'Ixaheri nuiwarimama wa'ukiyarima memakɨ:  
\b  
\li1 Xuweni nuiwarimama wahetsiemieme: 'Eriyetsexi Tsikɨri nu'aya muwanɨ'a pɨhɨkɨtɨkai,  
\li1 Tsimehuni nuiwarimama wahetsiemieme: Tsepatiyaxi Mahaka nu'aya muwanɨ'a pɨhɨkɨtɨkai,   
\li1
\v 17 Rewi nuiwarimama wahetsiemieme: Katsawiyaxi Kemuheri nu'aya muwanɨ'a pɨhɨkɨtɨkai,  
\li1 'Aruni nuiwarimama wahetsiemieme: Tsaruki muwanɨ'a pɨhɨkɨtɨkai,   
\li1
\v 18 Kura nuiwarimama wahetsiemieme: 'Erihú Rawiri 'iwaya muwanɨ'a pɨhɨkɨtɨkai,  
\li1 'Itsakaxi nuiwarimama wahetsiemieme: 'Umiri Mikaheri nu'aya muwanɨ'a pɨhɨkɨtɨkai,   
\li1
\v 19 Tsawuruni nuiwarimama wahetsiemieme: 'Itsimahiyaxi 'Awiriyaxi nu'aya muwanɨ'a pɨhɨkɨtɨkai,  
\li1 Nepɨtahari nuiwarimama wahetsiemieme: Kerimuti 'Atsirieri nu'aya muwanɨ'a pɨhɨkɨtɨkai,   
\li1
\v 20 'Epɨrahini nuiwarimama wahetsiemieme: 'Utseyaxi 'Atsatsiyaxi nu'aya muwanɨ'a pɨhɨkɨtɨkai,  
\li1 hixɨata me'atɨ Manatsexi xiɨyarimama wahetsiemieme: Kuheri Perahiyaxi nu'aya muwanɨ'a pɨhɨkɨtɨkai,   
\li1
\v 21 Tawarita hixɨata me'atɨ Manatsexi nuiwarimama Karaha kwieyaritsie memɨtitekai wahetsiemieme: 'Iruhu Tsakariyaxi nu'aya muwanɨ'a pɨhɨkɨtɨkai,  
\li1 Wenikamini nuiwarimama wahetsiemieme: Katsiheri 'Awinexi nu'aya muwanɨ'a pɨhɨkɨtɨkai,   
\li1
\v 22 Rani nuiwarimama wahetsiemieme: 'Atsareri Keruhani nu'aya muwanɨ'a pɨhɨkɨtɨkai.  
\li1 'Ikɨ mepɨhɨkɨtɨkai 'Ixaheri nuiwarimama memɨwanɨ'akai.   
\b  
\p
\v 23 Peru Rawiri pɨkawaraka'utɨa 'ukitsi xeitewiyari wiyari memɨkahexeiyakai, mɨkɨ Yawé mɨpaɨ putayɨkai kename 'ixaheritsixi mekayu'inɨatsinɨakakekai, mɨyuawitsie miemete xɨrawetsixi wahepaɨ.  
\v 24 Kuhawi Tsariwiya nu'aya kanitsutɨani waraka'utɨanike, peru yunaime pɨkawaraka'utɨa Kakaɨyari muyeha'akɨ 'ixaheritsixi wahetsiemieme. 'Ayumieme kememɨyupaɨmekai mepɨkahaka'utɨarie Rawiri ti'aitakaku kemɨtiuyɨ xapayaritsie.   
\s1 Ti'aitame hetsɨa timieme memɨtehɨritɨariekai  
\p
\v 25 Mɨraye'atɨka mɨtiuyepine ti'aitame tipiinieya pɨhɨritɨariekai 'Atsimaweti 'Arieri nu'aya.  
\p Kunatani 'Utsiyaxi nu'aya pɨtihɨritɨariekai watsiyata timieme, kiekaritetsie timieme, kiekari 'etsimɨyeyeutsie timieme meta kiekarite kuraru 'amatitetewa mexeiyatɨkatsie timieme.   
\p
\v 26 Memuka'etsa mɨwanɨ'a 'Etsiri pɨhɨkɨtɨkai Keruwi nu'aya.   
\p
\v 27 Tsimi Xamati kiekame pɨhɨritɨariekai kaxie haraweriyarite.  
\p Tsawiri Tsepani kiekame pɨhɨritɨariekai winu mɨti'utakɨ kita.   
\p
\v 28 Wahari-Kanani Kerexi kiekame pɨhɨritɨariekai huriwa haraweriyarite meta xapa 'iteɨriyarite Tsepera yemuriyaritetsie mieme.  
\p Kuhatsi pɨhɨritɨariekai hatseiti mɨwa'utsie.   
\p
\v 29 Tsitɨrahi Tsaruni kiekame wakaitsixi pɨhɨritɨariekai Tsaruni kwieyaritsie memu'uwakai.  
\p Tsapati 'Arurahi nu'aya wakaitsixi pɨhɨritɨariekai mayeweweritsie memɨye'uwakai.   
\p
\v 30 'Uwiri 'Itsimaheri nuiwarieya kameyutsixi pɨhɨritɨariekai.  
\p Keheriyaxi merunutitanaka mɨkɨta puxuri 'ukari pɨhɨritɨariekai.   
\p
\v 31 Katsitsi Hakaxi nuiwarieya muxatsi pɨhɨritɨariekai.  
\p 'Ikɨ yunaitɨ mekanihɨkɨtɨkaitɨni ti'aitame parewiwametemama tipiinieya memɨtehɨritɨariekai.   
\b  
\p
\v 32 Kunatani Rawiri tatatsieya, ti'utɨwame mɨtimaiwekai, ti'aitame 'ɨxatsitɨwameya pɨhɨkɨtɨkai. Kehieri Kakumuni nu'aya pɨwa'ɨwiyakai ti'aitame niwemama.   
\p
\v 33 'Akituperi mɨkɨtatsiere ti'aitame 'ɨxatsitɨwameya pɨhɨkɨtɨkai. Hutsahi 'araki tewiyari ti'aitame 'aixɨa mɨtimate pɨhɨkɨtɨkai.  
\v 34 Kuyara Wenahiyaxi nu'aya meta 'Awiyataxi 'arike 'Akituperi hetsiemieme mepanuka'ui.  
\p Kuhawi kuyaxi yunaime wa'ukiyari pɨhɨkɨtɨkai.   
\c 28  
\s1 Kememɨte'utahɨawarie tuki mɨtawewiyanikɨ  
\p
\v 1 Merikɨtsɨ Rawiri Kerutsaremetsie kaniwarukuxeɨrieni: yunaime 'Ixaheri nuiwarimama memɨwanɨ'a, yunaime kuyaxi memɨwanɨ'a xeimetseri memɨte'utahɨwekai, xeimiriyari meta xeitsienituyari memɨhɨritɨarietɨkatei, meta ti'aitame tipiinieya memɨtehɨritɨariekai, tewamama memɨwahɨkai meta niwemama, paratsiyu memɨhɨritɨariekai, kuyaxi memeuyutakwiwawe meta kuyaxi memɨkamama.   
\p
\v 2 Kananukukeni ti'aitame Rawiri mɨpaɨ kaniutayɨni: Ne'iwamarixi xekeneneu'eni. Ne mɨpaɨ nepɨtiku'eriwakai tuki nepɨtawewienikekai, muwa Yawé takakaɨyari tɨratuya kakuniyari mayekanikɨ meta muwa mayeyerɨnikɨ Kakaɨyari. Tinaimeri nepɨtiuxeɨriekai mɨtawewierekɨ,  
\v 3 peru Kakaɨyari mɨpaɨ pɨnetiutahɨawixi: “Tuki 'ekɨ pepɨkanetsitawewirieni, 'ekɨtsɨ kuya yumemiwame pekanihɨkɨtɨni meyuwaɨkawame pekaniwarukwini”.   
\p
\v 4 »Merikɨte Yawé 'Ixaheri Kakaɨyarieya, ne'iwama watsata pɨnetsi'anayexei 'Ixaheritsie munetsi'anukakenikɨ nemɨtita'aitakɨ yuheyemekɨ. Mɨkɨtsɨ Kura nuiwariyari kananayexeiya te'aitamete nuiwariyari memakɨnekɨ, mɨkɨ nuiwaritsie penayexei nenuiwari, meta ne'iwama watsata ne pɨnetsi'anayexei, 'Ixaheritsie ti'aitame nemayanikɨ.  
\v 5 Meta neniwema memɨyɨmɨire Yawé mɨnetsi'upitɨa watsata, neniwe Tsarumuni panayexei Yawé 'uwenieyatsie mayerɨnikɨ 'ixaheritsixi mɨtiwata'aitɨanikɨ.  
\v 6 Kakaɨyari mɨpaɨ pɨnetiutahɨawixɨ: “Tsarumuni 'aniwe kaniyɨanemɨkɨ tuki mɨtawewieni meta kuraruyari, ne nepenayexei neniwe pɨhɨkɨtɨni neta 'ukiyarieya nepɨhɨkɨtɨni.  
\v 7 Xɨka yatikamieni ne'inɨari niukiyaritsie meta kenemɨti'aita, hikɨ kemɨtikamie, hikɨ 'ana nepipitɨani yuheyemekɨ mɨti'aitanikɨ”.   
\p
\v 8 »Kakaɨyari mɨtatsi'enie hɨxie, meta yunaitɨ 'ixaheritsixi Yawé teɨterimama xemɨhɨkɨ, nepɨxehɨritɨa yaxemɨtekahunikɨ naime 'inɨari niukiyaritsie Yawé takakaɨyari kemɨti'aita. Xɨka mɨpaɨ xetekakɨne 'ikɨ kwie witsimɨraku'anetsie xepu'uwani meta xeniwema wahetsiemieme payani yuheyemekɨ.   
\p
\v 9 »'Ekɨ Tsarumuni neniwe kena'eriwani 'a'ukiyari Kakaɨyarieya. Meta kenayexeiyani naime 'a'iyarikɨ meta 'aixɨa 'anemekɨ 'a'eriwamekɨ. Karikɨ Yawé 'iyari kanixeiyani meta naime 'iyaritɨarika kanimaika. Xɨka pe'itiwauni, pɨmatsipitɨani pemitaxeiyakɨ, mexɨka pe'iku'eirieni yuheyemekɨ kamaniku'eirimɨkɨ.  
\v 10 Pepɨkaratɨtɨmaiyani Yawé kemɨmaranayexei tuki pemitawewirienikɨ muyepatsie mayanikɨ hetsiena mieme. 'Ayumieme keneyuwaɨriyani 'ari ketine'uximayaka».   
\p
\v 11 Hikɨ Rawiri Tsarumuni kaniyetuirieni tuki 'inɨariyari kemɨtiwewierekekai meta kiite 'auriena mawetɨkatei, tatsɨari tuki kitenie hɨxie kii 'etsimɨpe mukuwewiere, kii mɨrewati'utsiwa, kii yuheima ma'u, kii kemuyepaɨmenikekai taɨtana, meta muyepatsie tɨratu kakuniyari kanamikiyari mɨwayuhayewatsie.  
\v 12 Meta kaniyetuirieni kemɨtiyɨnikekai Yawé tukieya takwayaritsie kemɨtiku'eriwakai, meta kii mawetɨka kemɨ'ayumiemetɨnikɨ, tumini tukita mieme hepaɨtsita meta hakewa mɨreti'utsiwani piinite mɨtipatsietɨka tukita timieme.  
\v 13 Metatsiere, kaniyetuirieni mawari wewiwamete meta rewitsixi kememɨte'uximayatakekai, meta piinite mɨtipatsietɨka muwa mɨtiyepikai kemɨ'ayumiemetɨnikekai Yawé tukita.  
\v 14 Yaxeikɨata, huru 'anayuhayewame kaniyetuirieni meta pɨrata mɨtitiwewiyanikɨ piinite tukita timieme xexuime 'uximayatsikatsie timieme.  
\v 15 Metatsiere kaniti'inɨatsirieni huru meta pɨrata kɨxeme 'uitɨwame mɨtiwewierekɨ meta kɨxemeya, kepaɨmetɨ mɨyɨnikekai hurukɨ mɨtiwewieri meta pɨratakɨ mɨtiwewiere, xexuitɨ hakewa mɨ'ayumiemetɨkai.  
\v 16 Metatsiere kaniti'inɨatsirieni huru meta pɨrata mexa paa maname hetsiemieme, huru mɨtiwiriyarieni hetsiemieme meta pɨrata mɨtiwiriyarieni.  
\v 17 Meta kaniyetuirieni huru 'aixɨa mɨ'ane, ti'itɨpiyame manuxɨte 'amupapa mɨtiwewiyanikɨ meta watsu 'amɨnene metatsiere xarite. Kaniti'inɨatsirieni 'aye'akame huru meta pɨrata xexuime tekɨxitetsie mieme kepaɨmetɨ mɨyɨnikekai huru meta pɨrata.  
\v 18 Mexa 'ɨkwa taiyame hetsiemieme kaniyetuirieni huru 'aixɨa mɨ'ane. Metatsiere kaniyetuirieni ke'anetɨ mɨtawewierekekai Yawé kaxetaya, tatsɨari Kakaɨyari teɨtametemama yu'anatekɨ Yawé tɨratuya kakuniyari memanukanakai.   
\p
\v 19 Rawiri mɨpaɨ kaniutayɨni: «'Ikɨ tinaitɨ katinaka'utɨarieni Yawé yatiutahekɨataku, yanemɨretimanikɨ keti'anenetɨ mɨtitiwewiyani».   
\p
\v 20 Meta mɨpaɨ Rawiri yuniwe Tsarumuni katiniutahɨawe: «Kenetɨrɨkaɨyeni meta ketinayu'iwani, hikɨri ketine'uximayaka. Pepɨkamaka meta pepɨkayuweranariyani, karikɨ Kakaɨyari Yawé, nekakaɨyari, 'ahamatɨa kaniuyeikamɨkɨ. Pɨkamatsiku'eirieni pɨkamatsinutuita kepaukake tuki pemɨnɨni.  
\v 21 Pepɨwarexeiya mawari wewiwamete meta rewitsixi memɨteta'uximayata Kakaɨyari tukieyata. Metatsiere pewarexeiyatɨ pepayani kemɨ'ane memɨyuwaɨriya yɨkɨmana waɨkawa memɨte'akumate tinaime 'uximayatsika hepaɨtsita. Nuiwarite memɨwanɨ'a meta yunaitɨ teɨteri mepɨmatsiparewieni».   
\c 29  
\s1 Tuki hetsiemieme kememɨte'ikuxeɨri 'imikieri  
\p
\v 1 Rawiri ti'aitame memɨyuxeɨriekai mɨpaɨ katiniwarutahɨawe: «Kakaɨyari neniwe Tsarumuni kananayexeiya, peru mɨkɨ 'akuxi pɨkarakumate 'uximayatsika pɨmariwe. 'Ikɨ tuki 'amɨpa tewi pɨkatipiinieya, matsi Kakaɨyari Yawé pɨta katinipiinieyatɨni.  
\v 2 Waɨkawamekɨ neyuwaɨriyatɨ nekatiniukuha'arita Kakaɨyari tukieya hetsiemieme. Piinite tukita timieme mɨtitiwewiyanikɨ nekatiniuxeɨrieni, huru, pɨrata, wurunitse, tepɨa, kɨyexi, meta waɨkawa 'unitse teteyari, tetexi 'ixurikitsie mɨkayatsarɨwa, tetexi mɨherɨkarietɨka witsimutiyɨtɨka, tetexi witsimɨ'anene yutsata meta waɨkawame marimuri teteyari.  
\v 3 Ketipaɨmeme nemɨtiukuxeɨriekai mɨkɨ nekati'inɨatatɨ, nekakaɨyari tukieya nenaki'erietɨ nepiyetuani tuki hetsiemieme naime huru meta pɨrata nemeixeiya:  
\v 4 xeitsienituyari miriyari kiruyari pɨrahetekai huru 'Upixi mieme, meta huta tsienituyari heimana xeitewiyari heimana tamamata miriyari kiruyari raheteme pɨrata 'aixɨa mɨ'ane, mɨkɨkɨ tuki muwakuwiriyarienikɨ,  
\v 5 piinite hurukɨ mɨtitiwewierekɨ meta pɨratakɨ, metatsiere tsepa tita memɨte'utiwewi tepɨakɨ te'uximayatamete. ¿Kemɨ'aneta hikɨ xeme 'imikieri pɨyetuani Yawé hetsiemieme?»   
\p
\v 6 Hikɨ 'ukirawetsixi yutɨɨriyama memɨwareuxeiya, 'Ixaheri nuiwarimama memɨwanɨ'a, xeimiriyari kuyaxi memɨwanɨ'a meta xeitsienituyari kuyaxi memɨwanɨ'a metatsiere ti'aitame 'uximayatsikaya memɨhɨritɨariekai, mɨkɨ 'imikieri mekaniyetuani kememɨteheuyɨwawekai.  
\v 7 Mɨkɨ mekaniyetuani Kakaɨyari tukieya hetsiemieme mɨtitiwewiyanikɨ, xeitsienituyari heimana haika tewiyari heimana 'auxɨwi miriyari (165.000) kiruyari raheteme meta tamamata miriyari huru tuminiyari, haika tsienituyari heimana xeitewiyari heimana tamamata (330.000) kiruyari raheteme huru, 'ataxewi tsienituyari miriyari kiruyari raheteme wurunitse tepɨayari, meta haika miyuniyari heimana haika tsienituyari kiruyari raheteme tepɨa.  
\v 8 Kemɨ'ane tetexi memeixeiyakai witsimɨ'anene mekaniyetɨani Kehieri hetsɨa, mɨkɨ Keritsuni nuiwarieya pɨhɨkɨtɨkai, mekaniyetuani Yawé tukieyata mieme mɨrayanikɨ.  
\v 9 Hikɨ yunaitɨ kiekatari waɨkawa mekaniyutemamawiekaitɨni memɨyɨwawekaikɨ memiyetuani 'imikieri Yawé hetsiemieme, yaxeikɨa ti'aitame Rawiri waɨkawa kaniyutemawiekaitɨni.   
\s1 Rawiri kemɨtiuyutanenewi  
\p
\v 10 Merikɨte Rawiri Yawé 'aixɨa katiniutahɨawe yunaime teɨteri wahɨxie, mɨpaɨ 'utaitɨ:  
\b  
\q1 «'Aixɨa peketikɨhɨawarɨwani Yawé,  
\q2 ta'ukiyari 'Ixaheri Kakaɨyarieya,  
\q2 yemekɨ yuheyemekɨ.   
\q1
\v 11 'Ekɨ Yawé katini'apinitɨni,  
\q2 kepemɨtimariwe meta kepemɨtitɨrɨkaɨye,  
\q2 witsikepemɨ'ane, kepemɨrayu'iwa meta kepemɨti'aitame.  
\q1 Naitɨ katini'apinitɨni ketipaɨmetɨ mɨtixuawe  
\q2 muyuawitsie meta kwiepa.  
\q1 Yaxeikɨata 'ekɨ xeikɨa pekatini'aitametɨni,  
\q2 'ekɨ yunaime waheima pekatini'aitani.   
\q1
\v 12 'Ahetsɨa xikutɨriya payeneika meta 'aixɨa mɨti'ane,  
\q2 'ekɨ yunaime pekatiniwa'aitɨaka.  
\q1 'Ahetsie puxuawe tɨrɨkariya meta mɨyɨwenikɨ,  
\q2 meta 'ekɨ pepɨhɨkɨ mariweme pemɨrayeitɨani meta yunaime pemuwatɨrɨkariya.   
\q1
\v 13 'Ayumieme, takakaɨyari, pamɨpariyutsi tepɨmatsipitɨa,  
\q2 meta witsipemɨ'anetsie mieme 'aixɨa tepaitɨka.   
\p
\v 14 »Peru, ne tixaɨtɨ nepɨkatihɨkɨ meta neteɨterima tixaɨtɨ mepɨkatehɨkɨ, tita meta 'imikieri temateyetuiri tixaɨtɨ pɨkatihɨkɨ. Yurikɨtsɨ 'ekɨ, tinaitɨ 'apiini katinihɨkɨtɨni, tame ketita temateyetuiri, mɨkɨ katinihɨkɨtɨni 'ekɨ pemɨtatiyetuiri.  
\v 15 'Ahɨxie tame, ku'uwamete tekanihɨkɨtɨni meta kɨkamete, ta'ukiyarima memɨ'anekai hepaɨ meripaitɨ. Tatukari 'ena kwiepa 'etɨri hepaɨ kani'aneni mɨkareutetere.  
\v 16 Yawé takakaɨyari, 'ikɨ naitɨ ketita temɨte'ukuxeɨri tuki temɨtawewienikɨ 'ahetsiemieme, 'ekɨ pepɨtatiupitɨa. Naitɨ pɨti'apiini.  
\v 17 Nekakaɨyari 'aku, ne nepɨtimate 'ekɨ 'iyarite pepɨxeiya kemɨtiku'eriwa meta pepinaki'erie tita mɨtiheitserie. 'Ayumieme ne'iyari heitseriekaku nematiyetuiri 'ikɨ naime piinite, meta nepɨwaruxei 'ateɨterima meyutemamawietɨ kememɨte'iyetua yumawari kememɨteyuwaɨriya.  
\v 18 Yawé, ta'ukiyarima wakakaɨyari 'Apɨrahami, 'Itsahaki meta 'Ixaheri, hikɨ hepaɨ meteyɨkɨhɨaweme keniwapitɨaka wa'iyaritsie yuheyemekɨ, mɨkɨ yu'iyaritsie memɨmatsiha'eriwanikɨ keniwapitɨaka.  
\v 19 Yaxeikɨata neniwe Tsarumuni keneupitɨa 'iyari 'aixɨa tiyɨkɨhɨaweme, yamɨtikamienikɨ meta yamɨtiyurienenikɨ 'a'aitsikatsie meta 'a'inɨari niukiyari naimetsie. Keneupitɨa tuki mɨtawewienikɨ hetsiena timieme nemɨtiukuha'aritaxɨ».   
\p
\v 20 Hikɨ Rawiri yunaime teɨteri mɨpaɨ katiniwarutahɨawe: «Yawé xekenenɨawani yukakaɨyari». Hikɨ yunaitɨ teɨteri Yawé mekaniutanɨawa, yu'ukiyarima wakakaɨyari, meta Yawé hɨxie mekaniukahɨxima'uni metatsiere ti'aitame hɨxie.   
\s1 Tsarumuni ti'aitame kemɨratɨa  
\r (1Kem 29:21-25 – 1Te 1:28-53)  
\p
\v 21 Hikɨ 'uxa'arieka, Yawé mekaniyetuirieni waɨkawa mawari meta mawari taiyariyari, yunaime 'ixaheritsixi wahetsiemieme: xeimiriyari turutsixi temari, xeimiriyari muxatsi 'ukitsi meta xeimiriyari muxatsi 'etsimemɨpepe, winu mawariyari heutinɨtɨkaime, meta waɨkawa hipame mawari.  
\v 22 Mɨkɨ tukaritsie mepɨte'ukwai meta mepɨte'anu'i meyutemamawietɨ Yawé hɨxie.  
\p Hikɨ 'ana hutarieka teɨteri Tsarumuni ti'aitame mayanikɨ yamekaniutiyuani Rawiri nu'aya, Yawé hɨxie hatseiti mu'uyatsie mekanikawirieni ti'aitame mayanikɨ, meta Tsaruki mekaniukawirieni mawari wewiwame mayanikɨ.   
\p
\v 23 Hikɨ Tsarumuni Yawé 'uwenieya hetsie kanayerɨni yu'ukiyari hetsiemieme Rawiri, hikɨ ti'aitakaku naitɨ 'aixɨa katiniuyɨni. Yunaitɨ 'ixaheritsixi yamekatenikahukaitɨni kemainekai.  
\v 24 Yunaitɨ 'ixaheritsixi wa'ukiyarima, kuyaxi waɨkawa memɨyɨwawe meta ti'aitame Rawiri niwemama yamekaniutiyuani 'aixɨa 'anemekɨ memiparewienikɨ ti'aitame Tsarumuni.   
\p
\v 25 Yawé mariweme kanayeitɨani Tsarumuni naitsarie 'Ixaheri kwieyaritsie, meta kanipitɨani mɨti'aitanikɨ mariwemekɨ mariwatɨ, nixewitɨ mɨkareixeiyakai hepaɨ te'aitamete 'Ixaheritsie memanuka'ui.   
\s1 Rawiri kemɨtiumɨ  
\r (1Kem 29:26-28 – 1Te 2:10-12)  
\p
\v 26 Rawiri 'Itsahi nu'aya katiniuta'aita naitsarie 'Ixaheri kwieyaritsie.  
\v 27 Naimekɨ, pɨtiuta'aitaxɨ huta tewiyari wiyari 'Ixaheri kwieyaritsie: Hewuruni pukatei ti'aitatɨ 'atahuta wiyari, meta Kerutsareme 'ukaitɨ pɨtiuta'aitaxɨ xeitewiyari heimana tamamata heimana haika wiyari.  
\v 28 Hikɨ kaniumɨni waɨkawa 'ukiratsitɨtɨri, 'aixɨa raniuwakaku hetsiena mieme meta waɨkawa xikutɨtɨ, nu'aya Tsarumuni hetsiena mieme katiniuta'aita.  
\v 29-30 Naime Rawiri kemɨtiuyuri, mɨtiutsutɨatsie meta 'imatɨrieka kemɨtiuyuri, kemɨtiuta'aitaxɨ kemɨtitɨrɨkaɨyekai, meta kemɨtiyuri, 'Ixaheri kwieyaritsie kemɨtiuyɨ meta kiekari 'auriena mamanetɨkatsie, naitɨ katinaka'utɨarieni kemɨtiuyɨ xapayaritetsie mɨtaniere Tsamuheri meka'utɨatsie, Kakaɨyari niukameya Natani meka'utɨatsie meta mɨtaniere Kahari meka'utɨatsie.   