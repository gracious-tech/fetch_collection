\tr
\tc1  
\v 43 'Ikɨ rewitsixi mekanihɨkɨtɨni memakunuaxɨa Ketsuha meta Karimieri nuiwarimama, Hurawiyaxi tɨɨriyamama memɨhɨkɨtɨkai
\tc2 74  
\b  
\tr
\tc1  
\v 44 Kwikamete 'Atsahapi nuiwarimama 
\tc2 148  
\b  
\tr
\tc1  
\v 45 Kitenie tehɨwemete Tsaruni, 'Atexi, Tarimuni, 'Akuwi, Katita meta Tsuwahi wanuiwarima 
\tc2 138  
\b  
\tr
\tc1  
\v 46 Tukita te'uximayatamete 'ikɨ wanuiwarima mepɨyɨakai: Tsika, Katsupa, Tawahuti,  
\v 47 Kerutsi, Tsikaka, Paruni,  
\v 48 Rewana, Hakawa, Tsarimahi,  
\v 49 Kanahani, Kireri, Kahaxi,  
\v 50 Xehahiyaxi, Xetsini, Nekura,  
\v 51 Katsani, 'Utsa, Patsehaki,  
\v 52 Wetsahi, Mehunini, Nepitsetsini,  
\v 53 Wakuwuki, Kakupa, Kaxikuxi,  
\v 54 Watsiruti, Mekira, Karitsa,  
\v 55 Warikuxi, Tsitsara, Temaha,  
\v 56 Netsihaki meta Katipaha.  
\b  
\tr
\tc1  
\v 57 Tsarumuni memɨparewiekai wanuiwarima, Tsutahi niwemama mekanihɨkɨtɨkaitɨni, meta Tsupereti niwemama, Perura niwemama,  
\v 58 Kahara niwemama, Rarikuni niwemama, Kireri niwemama,  
\v 59 Tsepatiyaxi niwemama, Katiri niwemama, Pukereti-Hatsewahini niwemama meta 'Amuni niwemama.  
\b  
\tr
\tc1  
\v 60 Tukita te'uximayatamete meta Tsarumuni te'uximayatsiriwamete wanuiwarima 
\tc2 392  
\b  
\p
\v 61 Hipatɨta mekaniu'axɨani Teri-Meraki mehanexɨaka, Teri-Karitsa, Keruwi, 'Aruhuni meta 'Imexi, peru mɨkɨ wahetsiemieme xapa pumawekai wa'ukiyarima memaye'uxa, kemɨ'ane memɨtehanuiwaritɨkai xɨka 'ixaheritsixi mehɨkɨtɨkaitɨni:   
\b  
\tr
\tc1  
\v 62 Rerahiyaxi, Tuwiyaxi meta Nekura wanuiwarima
\tc2 642  
\b  
\li1
\v 63 Hipatɨta mawari wewiwamete, mepɨka'uyɨwekaxɨa yamemɨtiyuani kemɨ'ane memɨtehanuiwaritɨkai 'Ixaheri hetsiemieme, 'ikɨ: Kawahiyaxi meta Kuhutsi meta Waxitsirahi wanuiwarima ('ikɨ 'imatɨrieka mieme Karaha kiekame Waxitsirahi titewakame niweya kaniutiwitɨni, mana 'eyehanaka mɨpaɨ katiniuyuterɨwa).  
\v 64 Mɨkɨ mekaniuyutiwauni memaka'uxatsie watutsima, peru mepɨkawarukaxei, 'ayumieme mepanayexɨriya mawari wewiwamete memɨkahɨkɨtɨnikɨ.  
\v 65 Mɨkɨ kuwexinaruri katiniwarukunamirieni mawari memɨkatekwakakɨ, 'arike mawari wewiwame wahetsiemieme 'inɨari kemɨtiwewienikekai \tl 'urimi\tl* meta \tl tumimikɨ\tl*.\f + \fr 7:65 \fq 'urimi meta tumimikɨ. \ft Mawari wewiwame mekatɨkɨkaita pɨyetekai tetexi hutatɨ, mɨkɨ pɨtitetewakai, memɨtehetimamatekenikɨ Kakaɨyari kemɨtinake pɨ'ayumiemetɨkai (\fr Mem 28:30\ft ).\f*   
\b  
\li1
\v 66 Yunaitɨ teɨteri mekaniyupaɨmekaitɨni, huta tewiyari heimana huta miriyari heimana haika tsienituyari heimana haika tewiyari (42.360) teɨteri.  
\v 67 Meka'inɨaritɨ waɨriyarika te'uximayatamete 'ukitsi 'ukari, memɨyupaɨmekai, 'atahuta miriyari heimana haika tsienituyari heimana xeitewiyari heimana tamamata heimana 'atahuta (7.337), meta mekaniwarexeiyakaitɨni huta tsienituyari heimana huta tewiyari heimana 'auxɨwi kwikamete 'ukitsi meta 'ukari.  
\v 68 Matsita mekaniwarexeiyakaitɨni 'atahuta tsienituyari heimana xeitewiyari heimana tamamata heimama 'ataxewi (736) kawayutsixi, huta tsienituyari heimana huta tewiyari heimana 'auxɨwi muratsixi,  
\v 69 nauka tsienituyari heimana xeitewiyari heimana tamamata heimana 'auxɨwi (435) kameyutsixi meta 'ataxewi miriyari heimana 'atahuta tsienituyari heimana xeitewiyari (6.720) puxuri.   
\b  
\p
\v 70 Hipatɨ 'ixaheritsixi wa'ukiyarima mɨraye'axe mepɨteyetɨa 'uximayatsika hetsiemieme: kuwexinaruri 'atahaika kiruyari huru kaniyetuani, meta watsute 'amɨnene huta tewiyari heimana tamamata meta 'auxɨwi tsienituyari heimana xeitewiyari heimana tamamata (530) mawari wewiwame wakemarite,  
\v 71 'Ixaheritsixi wa'ukiyarima xeitsienituyari heimana haika tewiyari kiruyari huru mekaniyetuani meta xeimiriyari heimana huta tsienituyari heimana tamamata (1.210) kiruyari pɨrata,  
\v 72 yunaitɨ teɨteri xeitsienituyari heimana haika tewiyari kiruyari huru mekaniyetuani meta xeimiriyari heimana xeitsienituyari (1.100) kiruyari pɨrata, mawari wewiwamete wakemariteta 'amɨtɨtɨ haika tewiyari heimana 'atahuta paɨmeme.   
\p
\v 73 Mawari wewiwamete, rewitsixi, kitenie tehɨwemete, kwikamete, teɨteri kiekatari, tukita te'uximayatamete meta hipatɨta 'ixaheritsixi yukiekaritsie mekaneukuyaxixɨani.  
\s1 'Inɨari niukiyari 'Etsitɨraxi kemɨrakaterɨwaxɨ  
\p 'Atahuta metseri haye'aku, 'ixaheritsixi yukiekaritsie mekaniukutetɨkateitɨni.   
\c 8  
\p
\v 1 Hikɨ teɨteri yunaitɨ mekaniuyukuxeɨrieni, takwa Haa kitenieyari hɨxie mukumakaitsie. Hikɨ ti'ɨkitame 'Etsitɨraxi mekananayexeiya 'inɨari niukiyari Muitsexi hetsɨa mieme makaterɨwakɨ, Yawé 'ixaheritsixi mɨwayetuiriekai yamemɨtekahunikɨ.  
\v 2 Hikɨ 'atahutarieka metseritsie mexɨakame tukaritsie, mawari wewiwame 'Etsitɨraxi 'inɨari niukiyari kani'atɨani memayuxeɨrie wahɨxie, mekaniyuxeɨriekaitɨni 'ukitsi meta 'ukari metatsiere tɨɨri memɨteheutamariwawe,  
\v 3 kanekaterɨwa yunaime wahɨxie mana takwa Haa kitenieyari hɨxie. Yunaitɨ teɨteri kayuwatɨ mekaniumakaitɨni me'i'enietɨ, 'inɨari niukiyari xapayari kemɨtikuterɨwarɨwakai, ximeri me'utayuaka tukake mekateniutahayewa.   
\p
\v 4 Ti'ɨkitame 'Etsitɨraxi wapai kanakawekaitɨni kɨyexi 'a'uyeheikametsie mutawewiyakai 'anamieme. Tserietana mekaniuti'ukaitɨni Matatiyaxi, Tsema, 'Aniyaxi, 'Uriyaxi, Kirikiyaxi meta Matsehiyaxi, 'utatanata mekaniuti'ukaitɨni, Perahiyaxi, Mitsaheri, Marikiyaxi, Katsumi, Katsiwarana, Tsakariyaxi meta Metsurani.  
\v 5 'Etsitɨraxi wapaitɨ nakawekaitɨni yunaitɨ teɨteri mekanixeiyakaitɨni. Kepauka memunenierixɨ 'inɨari niukiyari nanutayepiwakaitɨni, 'ana yunaitɨ 'amekaniti'uni.  
\v 6 Hikɨ 'Etsitɨraxi Yawé pamɨpariyutsi kaniupitɨani, Kakaɨyari mɨmariwe. Hikɨ teɨteri yunaitɨ teikɨ mekanemeixɨani, mɨpaɨ me'utiyuatɨ: «Mɨpaɨ ketiɨyɨni, mɨpaɨ ketiɨyɨni». Hikɨ mekaniukahɨxima'uni kwiepa, Yawé hepaɨtsita 'aixɨa mekaniutiyuani.   
\p
\v 7 Rewitsixi Ketsuha, Wanihi, Tserewiyaxi, Kamini, 'Akuwi, Tsawetahi, Huriyaxi, Matsehiyaxi, Kerita, 'Atsariyaxi, Kutsaweri, Kanahani meta Perahiyaxi mekaniwahekɨatɨakaitɨni teɨteri 'inɨari niukiyari, mɨkɨ me'enanatɨ mepɨkakuyuatɨkatei.  
\v 8 Mɨkɨ 'aixɨa mekateniterɨwakaitɨni 'inɨari niukiyari Kakaɨyari hetsɨa mieme meta mekanihekɨatakaitɨni kemaine memeiti'enietɨkɨkanikɨ.   
\p
\v 9 Teɨteri me'i'enieka 'inɨari niukiyari mekanitsutɨani me'utitsuatɨ. 'Ayumieme kuwexinaruri Nehemiyaxi, mawari wewiwame meta ti'ɨkitame 'Etsitɨraxi, rewitsixi teɨteri memɨtewa'ɨkitɨakai, mɨpaɨ mekateniwarutahɨawe: «Xepɨka'utitsuanani meta xepɨkanututuixieka, 'ikɨ tukari patsietɨ kanayeimɨkɨ Yawé hetsiemieme takakaɨyari».   
\p
\v 10 Hikɨta Nehemiyaxi mɨpaɨ katiniwarutahɨawe: «Xekeneuhuniri. 'Aixɨa xeketenekwaka, xeketene'ieka mɨrakaka meta 'ikwaikɨ xekeneyuparewieka kemɨ'ane mɨkarexeiya hamatɨa, 'ikɨ tukari patsietɨ matɨakɨ Yawé hetsiemieme. Xepɨkanututuixieka, temawierika Yawé hetsiemieme katanitɨrɨkariyani».   
\p
\v 11 Yaxeikɨatsiere rewitsixi yunaime mekaniwanɨtɨakaitɨni. Mɨpaɨ metewakɨhɨawetɨ: «Kayuwatɨ. Xepɨkanututuixieka, 'ikɨ tukari kanipatsieka».   
\p
\v 12 Hikɨ yunaitɨ teɨteri mekanekɨne metehekwanike metehe'ienike meta 'ikwai meteheyutaminike, meyutemamawietɨ metehetimaika kememɨteheta'ɨkitɨarie.   
\s1 Xamaru 'ixɨarariyari  
\p
\v 13 'Uxa'arieka, yunaitɨ 'ukirawetsixi, mawari wewiwamete yunaitɨ meta rewitsixi, 'Etsitɨraxi ti'ɨkitame hetsɨa mekaniuyukuxeɨrieni 'inɨari niukiyari memuyuti'ɨkitɨanikɨ kehapaɨ mɨtikuxatatɨka.  
\v 14 Mana mekanikaxeiya mɨpaɨ re'ukame Yawé Muitsexi kemɨtiuta'aitɨa kename 'ixɨarari memɨwewienitsie 'atahuta metseriyaritsie 'ixaheritsixi xamarutɨa me'ukutetɨkanikekai,  
\v 15 mɨpaɨta katine'ukaitɨni meketewarutaxatɨanike naitsarie kiekaritsie meta Kerutsaremetsie 'ikɨ 'aitsika: «Yemuritsie xekenehu huriwu xawari xekenetɨyu, huriwu yeuta mieme, tsikwai, takɨ meta naime tita waɨka mɨtixawariyatɨka, xamaru temɨtiwewienikɨ, kemɨre'uxa».   
\p
\v 16 Teɨteri yamekatenikakɨne tupiriya mekani'atɨani, mɨkɨkɨ xamaru mekaniutiwewieni kii heima, takwa, Kakaɨyari tukieya takwayaritsie, Haa kitenieyari takwayaritsie meta 'Epɨrahini kitenieyari takwayaritsie.  
\v 17 Yunaitɨ teɨteri mehehapanieka memu'axɨa xamaru mekaniutiwewieni mɨkɨtɨa mekanayetetɨkateitɨni. Mɨpaɨ mepɨkateyuriwawekai 'ixaheritsixi kepauka Kutsuhexi Nuni nu'aya 'amuyeikakaitsietɨtɨ, 'ixɨarari mariweme mekaniuwewieni.   
\p
\v 18 'Ixɨarari mewewietɨ 'atahuta tukari mekaniuyurieni, naime mɨkɨ tukaritsie 'Etsitɨraxi 'inɨari niukiyari Kakaɨyari hetsɨa mieme kaniwaterɨwiriekaitɨni. 'Atahaika tukaritsie 'ixɨarari mɨpatsie mekaniuwewieni, kemɨre'ukai 'inɨari niukiyari.   
\c 9  
\s1 'Ixaheritsixi kememɨteyetua 'axakememɨte'uyuri  
\p
\v 1 Xeitewiyari heimana nauka tukariyaritsie mɨkɨ metseriyaritsie mekaniuyukuxeɨrieni 'ixaheritsixi meyuhakienike, hiwerika kamixayari mekananakatɨxɨani meta naxi yumu'utsie meneutiwiwiexɨani.  
\v 2 Teewatari wahetsɨari me'ayekɨneka meniuyutihekɨata 'axakememɨte'uyuri yumɨireme wahɨxie meta watewarima ke'axamemɨte'uyuri,  
\v 3 hikɨ yamekaniutiyuani yuhetsie mekatenahɨani. Haika hurayari mekaniuyurieni 'inɨari niukiyari meterɨwatɨ Yawé yukakaɨyari hetsɨa mieme, meta haika hurayari mekaniyuhekɨatakaitɨni ke'axamemɨte'uyuri, 'imatɨrieka hɨxiena mekaniukahɨxima'uni.  
\v 4 Hikɨ rewitsixi Ketsuha, Wanihi, Karimieri, Tsewaniyaxi, Wuni, Tserewiyaxi, Wahani meta Kenani wapaitɨ mekaneuti'uni karima mekaniuyutanenewieni Yawé Kakaɨyari mehahɨawetɨ.  
\v 5 Rewitsixi Ketsuha, Karimieri, Wanihi, Katsawiniyaxi, Tserewiyaxi, Huriyaxi, Tsewaniyaxi meta Petahiyaxi mɨpaɨ mekaniutiyuani karima:  
\q1 «Hikɨmɨtɨka, Yawé hetsiemieme 'aixɨa xekeneutiyua takakaɨyari  
\q2 hikɨ mɨtiyehane meta yareuyuhanemekɨ.  
\q1 'Aixɨa peke'itɨarieka Tati'aitɨwame.  
\q2 Pekenɨawarieka witsikepemɨ'ane kepemɨtitewa,  
\q2 'aixɨa pɨ'ane pemɨnɨawarieka 'aixɨa pemɨ'itɨariekakɨ.   
\b  
\q1
\v 6 »'Ekɨ xeikɨa Yawé pepɨhɨkɨ.  
\q2 'Ekɨ muyuawi peputawewi,  
\q1 naime muyuawi kemɨyewa  
\q2 xurawetsixi warexeiyakame.  
\q1 'Ekɨ tukari pepɨwapitɨa tita pemɨtiutawewi:  
\q2 kwie meta haramara  
\q1 yunaime mana memɨtexuawe.  
\q2 'Ayumieme xurawetsixi muyuawitsie miemete 'ahɨxie mepukahɨxima'uwe.   
\b  
\q1
\v 7 »'Ekɨ, Yawé meta Kakaɨyari,  
\q2 'Apɨrami pemanayexei pepɨhɨkɨ.  
\q1 'Ekɨ 'Uxi karireutsixi wakwieyaritsie paitɨ pepiyewitɨ,  
\q2 'Apɨrahami pepɨtiterɨwaxɨ.   
\q1
\v 8 Hetsiena pepikaxei 'iyari heitserie yamɨtikamie  
\q2 'ayumieme tɨratu hamatɨana pepuwewi.  
\q1 Mɨpaɨ pepɨtitahɨawixɨ kename nuiwarimama  
\q2 kananeutsixi wakwie pewayetuirienikekai,  
\q1 meta 'etitsixi, 'amuxeutsixi meta peretseutsixi,  
\q2 kewutseutsixi, keriketseutsixi wakwie.  
\q1 Pepɨraye'atɨa kepemutayɨ  
\q2 heitseriemekɨ yapemɨtikamie pemɨhɨkɨkɨ.   
\b  
\q1
\v 9 »'Ekipitu tatewarima wa'uximatɨarika pepu'eni,  
\q2 Haramara Mɨxeta 'aurie kememɨteyuhiweriekai pepuwaru'eni.   
\q1
\v 10 Mariweme pepɨtiuyuri waɨkawamexɨa  
\q2 Parahuni hetsɨa, 'iparewiwametemama meta yunaitɨ teɨteri,  
\q1 penieretɨ kememɨtewananaimakai  
\q2 'ateɨterima kememɨwayuriekai.  
\q1 Mɨpaɨ petiuyurieku  
\q2 hikɨ pepukuxaxatsiwa naitsarie.   
\q1
\v 11 Wahɨxie haramara pepanutayepi,  
\q2 mepanukɨ 'ayewakikaku.  
\q1 Peru memɨwaruweiyakai  
\q2 haramara 'ameukatewatsie pepɨwareukaxɨri,  
\q2 tetexi wahepaɨ tetɨata paitɨ.   
\q1
\v 12 Haiwitɨri 'a'uwemekɨ pepɨwaruwitɨximekai tukarikɨ,  
\q2 tai 'a'uwemekɨ tɨkarikɨ pepɨwaruwitɨximekai:  
\q2 memuhunikɨ wahuye pepɨhekɨariwiekai.   
\b  
\q1
\v 13 »Tsinahi hɨriyaritsie pepunua,  
\q2 muyuawitsie paitɨ pepuwarutahɨawixɨ.  
\q1 Ketitamɨtiheitserie pepɨtiwarutaxatɨa meta 'inɨari niukiyari yuri maine,  
\q2 'aitsika 'aixɨa mɨ'anene.   
\q1
\v 14 Pepɨwarutaxatɨa Xawati tukariyari mɨpatsie,  
\q2 Muitsexi ti'a'uximayatsiriwame mɨhɨkɨtɨkaitsie  
\q2 'aitsika 'inɨari niukiyari pepɨwayetuiri.   
\b  
\q1
\v 15 »Meheuhaakakwikukaku paa muyuawitsie miemekɨ pepɨwarutihuxaitɨa,  
\q2 meheuharikukaku pepɨwaruharitɨa haa 'aitsie mieme.  
\q1 Kwie pepɨwayetuiri  
\q2 pemɨwayetuirienikekai pemainekai.   
\q1
\v 16 Tatewarima ta'ukiyarima mepuyuta'ɨrixɨ,  
\q2 yamemɨtekakɨne mepɨka'uyuwaɨri 'a'aitsika hetsie.   
\q1
\v 17 Mematsi'enienike mepɨkayuwaɨri,  
\q2 mariweme kepemɨtiuyuri  
\q2 wahetsiemieme mepɨkahaye'eri.  
\q1 Waɨkawa mepɨtsetse'ikai meta mepɨkaheu'enanakai  
\q2 'atsita xeime mepanuyeye  
\q1 muwarakunuitɨanikɨ 'Ekipitu  
\q2 waɨriyarika memɨteha'uximayakaitsie.  
\q1 Peru 'ekɨ pepɨkawaruku'eiri  
\q2 Kakaɨyari pemɨtareuyehɨwirie pemɨhɨkɨkɨ,  
\q2 pemɨtiuyukakwewimɨkɨ meta pemɨtiuyukanenimaya,  
\q2 haxɨakɨ pekayumexɨitɨatɨ, peru waɨkawa petiuyukanaki'erietɨ.   
\b  
\q1
\v 18 »Tsepa tsikeru memutawewi  
\q2 tepɨakɨ wewiyakame,  
\q1 mɨpaɨ memutiyua: “'Ikɨ kani'akakaɨyaritɨni  
\q2 'Ekipitu matsiyewitɨ”,  
\q1 tsepa yemekɨ kwinimieme  
\q2 'ahɨxie 'axamemɨte'uyuri,   
\q1
\v 19 'ekɨ pepɨkawaruku'eiri makumawetsie  
\q2 'ekɨ kwinimieme pemɨtiuyukanenimayakɨ.  
\b  
\q1 »Hatsuaku pɨkawaruku'eiri hai 'amuwekai  
\q2 tukarikɨ mɨwaruwitɨximekai huyeta,  
\q1 meta pɨkatiuhayewaxɨ wahekɨariwiyatɨ tai 'a'uwemekɨ  
\q2 tɨkarikɨ mɨwa'inɨaritɨkai kememɨteheuyune.   
\b  
\q1
\v 20 »'A'iyari 'aixɨa mɨ'anekɨ memɨtemaiwawenikɨ pepɨwarupitɨa.  
\q2 Manana pepɨkawarunawairi me'ikwakaku,  
\q2 haa pepɨwaruharitɨa memɨkaheuharikunikɨ.   
\q1
\v 21 Huta tewiyari wiyari makumawetsie pepɨtiwamikwakai.  
\q2 Tixaɨtɨ reuyewetɨ pɨkaratɨa wahetsiemieme.  
\q1 Wakamixate pɨka'utitsanixɨ  
\q2 meta wa'ɨkate pɨka'utihai.   
\b  
\q1
\v 22 »Pepɨwayetuiri te'aitamete meta kiekari,  
\q2 yuxexuime kwie pepɨwaruxatɨa.  
\q1 Te'aitamete mepɨwara'iwaxɨ 'Uhuki meta Tsikuni,  
\q2 memɨte'aitakai Hetsiwuni kwieyaritsie meta Watsani kwieyaritsie.   
\q1
\v 23 Waniwema pepɨwarutimɨiriyaxɨ  
\q2 xurawetsixi muyuawitsie miemete wahepaɨ,  
\q1 kwietsie pepɨwa'atɨa  
\q2 watewarima pemɨwaraxaxatɨwakaitsie.   
\q1
\v 24 Waniwema mɨkɨ kwieyaritsie mepu'axɨa.  
\q2 Wahɨxie pepɨtiwaruta'aitɨa kananeutsixi mana memu'uwakai,  
\q1 te'aitamete pepɨwayetuiri meta teɨteri mana kiekatari,  
\q2 kemɨtiwanake wahetsie yamemɨteyurienikɨ.   
\q1
\v 25 Kiekarite kuraruyari 'amatitetewa mepɨwara'iwaxɨ meta  
\q2 kwie 'aixɨa mɨ'anene,  
\q1 kiite yukii mepayeitɨaxɨa piinitɨarika tihɨpɨneme,  
\q2 meta putsute muyewawaki, kaxie haraweriyarite meta huriwu,  
\q2 metatsiere waɨkawa 'iteɨrite 'ikwaxi mɨrexeiyatɨka.  
\q1 Meteniutikwani meta meniutihuxani metatsiere meniutiwaiyata,  
\q2 mepɨteha'inɨataxɨ waɨkawa ke'aixɨa pemɨwaruyuri.   
\b  
\q1
\v 26 »Peru mekaheu'enanatɨ mepakɨ:  
\q2 menetsi'aye'unietɨ mepakɨ,  
\q2 'a'aitsika meputixani'eri,  
\q1 'aniukamete 'ahetsɨa miemete mepɨwarukwi  
\q2 memɨwa'iniekai memɨ'axɨanikɨ 'ahetsɨa,  
\q2 yemekɨ 'ahɨxie 'axamepɨte'uyuri.   
\q1
\v 27 'Ayumieme memɨwaraye'unie hetsɨa pepɨwayetua,  
\q2 mɨkɨta mekaniwaru'uximatɨani.  
\q1 'Uximatɨarikatsata memanahiwiwakaitɨni,  
\q2 muyuawitsie paitɨ peniwaru'enieni,  
\q1 pemɨtiuyukakwewimɨkɨkɨ pekaniwareyenɨ'ani memɨwatawikweitsitɨani  
\q2 memɨwaxɨnakɨ memɨwaraye'unie wahetsɨa.   
\q1
\v 28 Peru kepauka memuxɨnarie,  
\q2 yaxeikɨatsiere mepɨteyuriekai,  
\q1 'ekɨta pepɨwayetuayakai memɨwaraye'unie wahetsɨa,  
\q2 mɨkɨ mekateniwaruta'aitɨwakaitɨni.  
\q1 Hekwamekɨ mekameniutahiwiwakaitɨni pemɨwaparewienikɨ,  
\q2 hikɨ muyuawitsie paitɨ pekaniwaku'eniwakaitɨni.  
\q1 Waɨkawa pemɨwanaki'eriekaikɨ  
\q2 mɨixa peniwarutawikweitsitɨani.   
\q1
\v 29 Pepɨwaraye'eritɨa 'a'inɨari niukiyaritsie memanuaxɨanikɨ,  
\q2 peru mɨkɨ mepuyuta'ɨrixɨ  
\q2 meta 'a'aitsikatsie yamepɨkatekakɨ.  
\q1 'Axamepɨte'uyuri 'a'aitsikate hepaɨtsita,  
\q2 tukari mɨtiyupitɨwa kemɨ'ane meye'atɨwa.  
\q1 Mekaheu'enanatɨ mepɨmatsi'uku'eiri,  
\q2 metsetse'itɨ mepayuyeitɨa meta mepɨkayuwaɨri memɨmatsi'enieni.   
\b  
\q1
\v 30 »Mɨixa wiyari pepɨwanewiekai,  
\q2 'a'iyarikɨ pepɨwaraye'eritɨwakai  
\q1 'aniukamete yame'utiyuanekaku,  
\q2 peru mɨkɨ mepɨka'u'enana.  
\q1 'Ayumieme pepɨwayetua mɨkɨ  
\q2 kwieyaritsie memɨtama wahetsɨa.   
\q1
\v 31 Peru 'ekɨ, waɨkawa pemɨtiuyukanenimayakɨ  
\q2 pepɨkawarukwi meta pepɨkawaruku'eiri,  
\q2 Kakaɨyari 'aixɨa pemɨtiuka'iyari meta pemɨti'akanenimaya.   
\b  
\q1
\v 32 »Hikɨta, takakaɨyari,  
\q2 Kakaɨyari pemɨmariwe, pemɨmakaxiwa meta pemɨtɨrɨkaɨye,  
\q2 tɨratu pemaye'atɨwa meta yapepɨtikamie,  
\q1 'etsiwa tiuyɨme pepɨka'erieka kememɨte'ukwinitɨarie,  
\q2 tate'aitɨwamete,  
\q2 kuwexinaruritsixi, mawari wewiwamete meta 'aniukamete,  
\q1 ta'ukiyarima meta teyunaitɨ 'ateɨteri,  
\q2 te'aitamete 'Atsiriya kiekatari memɨtatsi'a'iwaxɨtsietɨtɨ 'atsita hikɨ.   
\q1
\v 33 'Ekɨ heitserie pepɨtiyurienekai  
\q1 tame kemɨtatiuyuri,  
\q2 'ekɨ yapepɨtikatɨa.  
\q1 Tame 'apɨta 'axatepɨte'uyuri.   
\q1
\v 34 Tate'aitɨwamete meta kuwexinaruritsixi,  
\q2 tamawari wewiwamete meta tatewarima,  
\q1 'a'inɨari niukiyaritsie yamepɨkatekakɨ  
\q2 meta mepɨka'i'eni 'a'aitsikate  
\q2 metatsiere kepemɨtiwaraye'eritɨwakai.   
\q1
\v 35 Mɨkɨ, kepauka memɨte'aitakai,  
\q2 mepɨka'uyuwaɨri memɨmetsi'ayexeiyani  
\q2 meta mepɨka'uyuwaɨri 'axakememɨteyuriekai memuku'eirienikɨ,  
\q1 tsepa waɨkawa petiwarumikutɨtɨ  
\q2 meta kwie pewayetuirieku 'ayeukame tiuxuaweriweme.   
\b  
\q1
\v 36 »'Ayumieme hikɨ waɨriyarika te'uximayatamete tepɨhɨkɨ,  
\q2 waɨriyarika te'uximayatamete 'ikɨ kwieyaritsie  
\q1 pemɨwayetuiritsie tatewarima  
\q2 mana timieme 'ikwaxi memɨtekwakakɨ meta memɨte'ukaxexeiyanikɨ.   
\q1
\v 37 Waɨkawa kemɨtiutixuxuawere hikɨ te'aitamete wahetsiemieme katinihɨkɨtɨni  
\q2 'axatemɨte'uyurikɨ tahetsie pemɨwarupitɨa.  
\q1 Tɨrɨkariya memexeiyakɨ, kemɨtiwanake mepɨtatsiyurie  
\q2 tame meta tatewama.  
\q2 Waɨkawa tepu'uximatɨarie.   
\p
\v 38 »Naimekɨ mɨkɨkɨ, tame tɨratu tepɨwewieni meta tepɨte'aka'utɨani, kuwexinaruritsixi, rewitsixi meta mawari wewiwamete mepitseyumani».   
\c 10  
\s1 Teɨteri yamekaniutiyuani yamemɨtekakɨnekɨ 'inɨari niukiyaritsie  
\p
\v 1 'Ikɨ mekanihɨkɨtɨni memitseyuma:  
\b  
\li1 Nehemiyaxi Hakariyaxi nu'aya kuwexinaruri mɨhɨkɨ,  
\li1 Tserekiyaxi,   
\li1
\v 2 Tserahiyaxi, 'Atsariyaxi, Keremiyaxi,   
\li1
\v 3 Patsuxi, 'Amariyaxi, Marikiyaxi,   
\li1
\v 4 Katuxi, Tsewaniyaxi, Maruki,   
\li1
\v 5 Karini, Meremuti, 'Awiriyaxi,   
\li1
\v 6 Tanieri, Kinetuni, Waruki,   
\li1
\v 7 Metsurani, 'Awiyaxi, Mikamini,   
\li1
\v 8 Mahatsiyaxi, Wirikai meta Tsemahiyaxi.  
\li1 'Ikɨ mawari wewiwamete mekanihɨkɨtɨkaitɨni.   
\b  
\m
\v 9 Rewitsixi teɨteriyari:  
\b  
\li1 Ketsuha 'Atsaniyaxi nu'aya, Winuhi, Henarari xiɨyarimama, Karimieri,   
\li1
\v 10 meta wa'iwama Tsewaniyaxi, Huriyaxi, Kerita, Perahiyaxi, Kanahani,   
\li1
\v 11 Mikahiyaxi, Xekuwi, Katsawiyaxi,   
\li1
\v 12 Tsakuxi, Tserewiyaxi, Tsewaniyaxi,   
\li1
\v 13 Huriyaxi, Wanihi meta Weninu.   
\b  
\m
\v 14 Memanuyetei mana kiekatari:  
\b  
\li1 Parutsi, Pakati, Muhawi, 'Erami, Tsatuhu, Wanihi,   
\li1
\v 15 Wunihi, 'Atsikari, Wewahi,   
\li1
\v 16 'Aruniyaxi, Wihiwahi, 'Arini,   
\li1
\v 17 'Atexi, 'Etsekiyaxi, 'Atsuxi,   
\li1
\v 18 Huriyaxi, Wetsahi, Katsumi,   
\li1
\v 19 Karipi, 'Anatuti, Newahi,   
\li1
\v 20 Makipiyaxi, Metsurani, Hetsixi,   
\li1
\v 21 Metsetsaweri, Tsaruki, Karuha,   
\li1
\v 22 Peratiyaxi, Kanahani, 'Anahiyaxi,   
\li1
\v 23 'Utseyaxi, Kananiyaxi, Katsuwi,   
\li1
\v 24 Haruketsi, Pirika, Tsuweki,   
\li1
\v 25 Xekuni, Katsawina, Matsehiyaxi,   
\li1
\v 26 'Ahiyaxi, Kanahani, 'Anahani,   
\li1
\v 27 Maruki, Karini meta Wanaha.   
\b  
\p
\v 28 Meta hipatɨta teɨteri ―mawari wewiwamete, rewitsixi, kitenie tehɨwemete, kwikamete, tukita memɨte'uximaya, meta yunaitɨ kemɨ'ane memɨwaruku'eiriekai hipame teɨteri kwiepa memɨtama 'inɨari niukiyari memaye'atɨanikɨ, wa'ɨitama, waniwema 'ukitsi 'ukari meta yunaitɨ kemɨ'ane memɨ'enawawekai―  
\v 29 yu'iwama mekaniwarutinɨni memanuyetei, yurikɨ meyuhɨritɨatɨ yamekaniutiyuani kename yametekakɨne, yamemɨte'u'uwanikɨ 'inɨari niukiyari Kakaɨyari Muitsexi tiyu'uximayatsiriwame mɨyetuiri kemaine, meta yamemɨtekakɨnekɨ naime Yawé 'aitsikateyatsie.  
\v 30 Metatsiere yatekaniutiyuani taniwema temɨkawawikitɨatɨwenikɨ memɨka'ixaheritsixi 'ikɨ kwieyaritsie memu'uwa wahamatɨa meta memɨkawikietɨwenikɨ waniwema taniwema wahamatɨa.  
\v 31 Metatsiere yatekaniutiyuani xɨka teɨteri xaɨtsie kiekatari xawatikɨ me'u'axɨani metetuatɨ piinite tewaxi yatɨni tsepa kepauka 'ixɨarari hatinekaku, tame tixaɨtɨ tepɨkatenaneni. Yaxeikɨatatsiere tepɨte'uxa 'atahutarieka wiyaritsie tepɨkaka'eni, meta memɨtehapitɨka tepɨtewareuyehɨwirieni.   
\p
\v 32 Mɨpaɨta tekateniuxata, tepiyetuayani nauka kɨramuyari raheteme pɨrata xeiwiyari 'anuyeyeikakaku, takakaɨyari tukita tita mɨreuyewetse hetsiemieme mayanikɨ:  
\v 33 paa Kakaɨyari hɨxie mamanarɨwa, mɨtiutimawarɨwani, meta mawari taiyariyari tukarikɨ yamɨtiutiwewiwa hetsiemieme, mawari xawati mieme, mawari metseri mɨhekwanitsie mieme meta 'ixɨarari mɨpatsietɨka mutiwewiwanitsie mieme, 'imikieri mɨpatsietɨka hetsiemieme, meta mawari 'ixaheritsixi ke'axamemɨte'uyuri memɨ'itiyanikɨ hetsiemieme, meta naime tita memɨteheuyehɨwa takakaɨyari tukita.   
\p
\v 34 Kɨyexi temɨyetuayani hetsiemieme, teyunaitɨ 'inɨarikɨ tekaniuyuta'iwa, kemɨ'ane wahetsie mɨtinakekekai, mawari wewiwamete, rewitsixi meta teyunaitɨ teɨteri, mɨpaɨ temɨtemaikakɨ kemɨ'ane memi'atɨwani kepauka tukaritsie, xeiwiyari 'aye'axekaku, Yawé tukieyata mieme takakaɨyari, mɨtakakɨ mawarieya matiwewiwa, 'inɨari niukiyaritsie kemaine.  
\v 35 Yaxeikɨata yatekaniutiyuani Yawé tukieyata temɨteyetuayanikɨ xeiwiyari 'anuyeyeikakaku tawaxata mɨtikaxuawere matɨari timieme meta ta'iteɨritetsie timieme 'ikwaxi,  
\v 36 metatsiere muwa temɨwayetuayanikɨ taniwema matɨari miemete meta tatewama mexɨakate, wakaitsixi meta muxatsi, mawari wewiwamete wahetsɨa Kakaɨyari tukieyata memɨte'uximaya, kemɨreuku'uxa 'inɨari niukiyaritsie.   
\p
\v 37 Metatsiere mɨpaɨ tekateniuxata temɨteyetuayanikɨ Kakaɨyari tukieyata timieme mɨtiwati'utsiwatsie, muwa tepiyetuani harina 'aixɨa mɨ'ane, meta hipame 'imikieri, ta'iteɨri 'ikwaxiyari, kaxie winuyari mɨhekwa meta hatseiti, mawari wewiwamete wahetsie timieme takakaɨyari tukita memɨte'uximaya. Metatsiere yatekateniuxata temiyetuanikɨ tamamatatsie mieme xeime tita temɨte'uka'etsa rewitsixi wahetsiemieme mɨrayanikɨ, mɨkɨtsɨ mekanihɨkɨtɨni naime 'ikɨ memɨte'uyetɨtɨkɨka  
\v 38 Xewitɨ mawari wewiwame 'Aruni xiɨyarieyatɨtɨ rewitsixi wahamatɨa kaniyemieni kepauka tamamatatsie mieme xeime hetsie timieme memɨtetɨyu. Rewitsixi tamamata hetsiemieme xeime tawarita mana hepaɨna paɨmeme mepɨte'anakapineni memiyetuayanikɨ Kakaɨyari tukieyata mɨtiuyepinetsie.  
\v 39 'Ixaheritsixi meta rewitsixi mekaniyetuayakuni 'imikieri, tɨriku, kaxie winuyari meta hatseiti mɨtipatsietɨka mɨtiuyepinetsie meta mawari wewiwamete memɨwayeyaxike wa'aurie, kitenie tehɨwemete meta kwikamete, kepauka memɨte'uximaya.  
\p Mɨpaɨ tekateniuxata takakaɨyari tukieya mɨpaɨ temɨte'ɨwiyanikɨ.   
\c 11  
\s1 Kemɨ'ane Kerutsareme memɨtiyaxixɨ  
\p
\v 1 'Ixaheritsixi memanuyetei Kerutsareme mekanitiyaxe. Hipatɨta memuyuhayewaxɨ mekaniyuta'iwa tamamatatsie mieme xewitɨ Kerutsareme muyuhayewakɨ kiekari mɨpatsietsie, hipatɨta me'atanaukatɨ hipame kiekaritetsie mekaniyuhayewa.  
\v 2 Hikɨ teɨteri Kakaɨyari mekaniutawawirieni 'aixɨa muwayurienikɨ kemɨ'ane yukɨmana memuyuyetua Kerutsareme memɨtiyaxekɨ wahetsiemieme.   
\p
\v 3 'Ikɨ mekanihɨkɨtɨni 'ikɨ kwieyaritsie memanuyetei Kerutsareme memuyuhayewaxɨ meta hipame kiekaritetsie Kura kwieyaritsie. 'Ixaheritsixi, mawari wewiwamete, rewitsixi, tukita te'uximayatamete meta Tsarumuni te'uximayatsiriwamete wanuiwarima mana mekaniyuhayewa, yuxexuitɨ yukiekaritsie meta yukwieyaritsie.  
\v 4 'Ikɨ mekanihɨkɨtɨni huriyutsixi wenikamini xiɨyarimama Kerutsareme memuyuhayewaxɨ:  
\b  
\m Kura memɨxiɨyarimama:  
\b  
\mi 'Atahiyaxi 'Utsiyaxi nu'aya, Tsakariyaxi nu'aya, 'Amariyaxi nu'aya, Tsepatiyaxi nu'aya, Marareri nu'aya, mɨkɨ Paretsi memɨxiɨyarimamatɨkai.  
\v 5 Meta Matsehiyaxi Waruki nu'aya, Kurikutse nu'aya, Katsahiyaxi nu'aya, 'Arahiyaxi nu'aya, Kuyariwi nu'aya, Tsakariyaxi nu'aya, Tsiruni niwemama.  
\v 6 Yunaitɨ Paretsi nuiwarimama Kerutsareme memuyuhayewaxɨ nauka tsienituyari heimana haika tewiyari heimana 'atahaika kuyaxi memɨkamama (468) mekaniyupaɨmekaitɨni.   
\b  
\m
\v 7 Wenikamini xiɨyarimama:  
\b  
\mi Tsaru Metsurani nu'aya, Kuhe nu'aya, Perahiyaxi nu'aya, Kurahiyaxi nu'aya, Matsehiyaxi nu'aya, 'Itiheri nu'aya, Kitsariyaxi nu'aya,  
\v 8 'iwamama Kawahi meta Tsarahi. Yunaitɨ 'atanauka tsienituyari heimana xeitewiyari heimana 'atahaika (928) mekaniyupaɨmekaitɨni.  
\v 9 Manuyekatei mexɨakame mieme Kuheri kanihɨkɨtɨkaitɨni Tsikɨri nu'aya, hutarieka mieme manuyeka kanihɨkɨtɨkaitɨni Kura Tsenuha nu'aya.   
\b  
\m
\v 10 Mawari wewiwamete:  
\b  
\mi Kerahiyaxi Kuyariwi nu'aya, Kakini,  
\v 11 Tserahiyaxi Kirikiyaxi nu'aya, Metsurani nu'aya, Tsaruki nu'aya, Merayuti nu'aya, 'Akituwi nu'aya, Kakaɨyari tukieya mɨhɨritɨarie mɨhɨkɨtɨkai,  
\v 12 meta maremama memɨhɨkɨtɨkai 'atahaika tsienituyari heimana xeitewiyari heimana huta (822) tukita mekateni'uximayakaitɨni, metatsiere 'Arahiyaxi Keruhani nu'aya, Perariyaxi nu'aya, 'Amɨtsí nu'aya, Tsakariyaxi nu'aya, Patsuxi nu'aya, Marikiyaxi nu'aya,  
\v 13 meta wamarema, mɨkɨ memanuyetei mepɨhɨkɨtɨkai yuniwema memɨwareuxeiya, yunaitɨ huta tsienituyari heimana huta tewiyari heimana huta mekaniyupaɨmekaitɨni, metatsiere 'Amatsahi 'Atsareri nu'aya, 'Akitsahi nu'aya, Metsiremuti nu'aya, 'Imexi nu'aya,  
\v 14 meta maremama, yunaitɨ xeitsienituyari heimana xeitewiyari heimana 'atahaika (128) mekaniyupaɨmekaitɨni yemekɨ memɨtehayu'iwa. Wa'ukiyari Tsawirieri Kerurini nu'aya kanihɨkɨtɨkaitɨni.   
\b  
\m
\v 15 Rewitsixi:  
\b  
\mi Tsemahiyaxi Katsuwi nu'aya, 'Atsirikani nu'aya, Katsawiyaxi nu'aya, Wunihi nu'aya,  
\v 16 Tsawetahi meta Kutsawari memanuyetei mekanihɨkɨtɨkaitɨni rewitsixi wahetsie, mekanihɨritɨariekaitɨni 'uximayatsika Kakaɨyari tukieya warita mieme.  
\v 17 Mataniyaxi Mikahiyaxi nu'aya, Tsawiri nu'aya, 'Atsahapi nu'aya, muwa'ukiyaritɨkai memutikwikakai pamɨpariyutsi Kakaɨyari mɨpitɨariekatsie meta memɨyunenewiekatsie, Wakuwukiyaxi Mataniyaxi pɨparewiwametɨkai yu'iwamaritsie meta 'Awɨra Tsamuha nu'aya, Karari nu'aya, Kerutuni nu'aya.  
\v 18 Rewitsixi kiekari mɨpatsietsie memuyuhayewaxɨ yunaitɨ huta tsienituyari heimana nauka tewiyari heimana nauka (284) mekaniyupaɨmekaitɨni.   
\b  
\m
\v 19 Kitenie tehɨwemete:  
\b  
\mi 'Akuwi, Tarimuni meta maremama, kitenie tehɨwemete. Yunaitɨ xeitsienituyari heimana haika tewiyari heimana tamamata heimana huta (172) mekaniyupaɨmekaitɨni.   
\b  
\p
\v 20 Hipatɨta 'ixaheritsixi meta mawari wewiwamete, hipatɨ rewitsixi, Kura kwieyaritsie mekanitamakaitɨni naitsarie, yuxexuitɨ yukwietsie.   
\p
\v 21 Tukita te'uximayatamete Tsika meta Kitsipa memɨwanɨ'akai, 'Uperi yemuriyaritsie mekaniyuhayewa.   
\p
\v 22 Rewitsixi wa'ukiyari Kerutsareme memɨtitekai 'Utsihi katinitewakaitɨni Wanihi nu'aya, Katsawiyaxi nu'aya, Mataniyaxi nu'aya, Mikahiyaxi nu'aya, xewitɨ 'Atsahapi nuiwarieya mɨhɨkɨ. 'Ikɨ mepɨhɨritɨariekai kwikari hepaɨtsita Kakaɨyari tukieyata.  
\v 23 Mɨkɨ ti'aitame pɨtiwa'aitɨakai kehapaɨ memɨte'uximayakakekai kwikamete naime tukaritsie.   
\p
\v 24 Ti'aitame, Petahiyaxi Metsetsaweri nu'aya kananukakeni yunaime teɨteri wahetsiemieme miparewiekakɨ, mɨkɨ Tsera nuiwarieyatsie pumiemetɨkai Kura nu'aya.   
\s1 Hipatɨ kiekaritetsie memɨtitekai  
\p
\v 25 Hipatɨ huriyutsixi 'ikɨ kiekaritetsie mekaniuyuhayewa meta yu'aurie 'etsiyeyeume mexeiyatɨkatsie: Kiriati-'Ariwa, Riwuni, Yekatseri,  
\v 26 Ketsuha, Murara, Weti-Pereti,  
\v 27 Katsaxi-Tsuhari, Weritsewa,  
\v 28 Tsikɨraki, Mekunaha,  
\v 29 'Eniximuni, Tsura, Karimuti,  
\v 30 Tsanuha, 'Arurani, Rakixi meta 'Atseka, tatsɨari Weritsewa tsutɨtɨ 'atsita mayeweri Hinuni paitɨ ye'atɨkaitɨ.   
\p
\v 31 Wenikamini nuiwarimama Kehewa kiekariyaritsie mekanitiyaxe, Mikimatsi, 'Ahiyatsi, Weteri meta kiekari 'auriena mamanetɨkatsie,  
\v 32 'Anatuti, Nuwi, 'Ananiyaxi,  
\v 33 Katsuxi, Xama, Kitahini,  
\v 34 Kariri, Tsewuhini, Newarati,  
\v 35 Ruri meta 'Unuhu, mayeweritsie Yumamakɨ Memɨteheutawewiwawe mɨrayetewatsie.   
\p
\v 36 Hipatɨ rewitsixi Kura kwieyaritsie kiekatari Wenikamini nuiwarimama mekaniwarutinɨni.   
\c 12  
\s1 Memu'axɨa mawari wewiwamete meta rewitsixi  
\p
\v 1 'Ikɨ mawari wewiwamete mekanihɨkɨtɨni meta rewitsixi memu'axɨa Tsuruwaweri hamatɨa Tsaratiheri nu'aya, meta Ketsuha hamatɨa:  
\li1 Tserahiyaxi, Keremiyaxi, 'Etsitɨraxi,   
\li1
\v 2 'Amariyaxi, Maruki, Katuxi,   
\li1
\v 3 Tsekaniyaxi, Xekuni, Meremuti,   
\li1
\v 4 'Iru, Kinetuni, 'Awiyaxi,   
\li1
\v 5 Mikamini, Mariyaxi, Wirika,   
\li1
\v 6 Tsemahiyaxi, Kuyariwi, Kerahiyaxi,   
\li1
\v 7 Tsaru, 'Amuki, Kirikiyaxi meta Kerahiyaxi.  
\li1 'Ikɨ mekanihɨkɨtɨni memanuyetei mawari wewiwamete meta wamarema Ketsuha muyeikakaitsie.   
\p
\v 8 Rewitsixi mekanihɨkɨtɨkaitɨni Ketsuha, Winuhi, Karimieri, Tserewiyaxi, Kura meta Mataniyaxi, kepauka Kakaɨyari pamɨpariyutsi mukupitɨariwakai mɨkɨ pɨhɨritɨariekai 'ana memutikwikanikɨ yu'iwama yunaitɨ.  
\v 9 Wakuwukiyaxi meta 'Unihi, memɨwa'iwama, wahɨxie mekaniti'uwekaitɨni mewaranutaxeiyatɨ memutikwikakaitsie.   
\p
\v 10 Ketsuha xiɨyarimama mekanihɨkɨtɨkaitɨni Kuhakimi, 'Eriyatsiwi, Kuyara,  
\v 11 Kuhanahani meta Karuha.   
\p
\v 12 Mawari wewiwamete wa'ukiyarima, Kuhakimi ti'aitakaku 'ikɨ mekanihɨkɨtɨkaitɨni:  
\li1 Tserahiyaxi nuiwarimama: Merahiyaxi puwa'ukiyaritɨkai,  
\li1 Keremiyaxi nuiwarimama: Kananiyaxi puwa'ukiyaritɨkai,   
\li1
\v 13 'Etsitɨraxi nuiwarimama: Metsurani puwa'ukiyaritɨkai,  
\li1 'Amariyaxi nuiwarimama: Kuhanahani puwa'ukiyaritɨkai,   
\li1
\v 14 Meriku nuiwarimama: Kunatani puwa'ukiyaritɨkai,  
\li1 Tsewaniyaxi nuiwarimama: Kutse puwa'ukiyaritɨkai,   
\li1
\v 15 Karini nuiwarimama: 'Arɨna puwa'ukiyaritɨkai,  
\li1 Merayuti nuiwarimama: Kerikahi puwa'ukiyaritɨkai,   
\li1
\v 16 'Iru nuiwarimama: Tsakariyaxi puwa'ukiyaritɨkai,  
\li1 Kinetuni nuiwarimama: Metsurani puwa'ukiyaritɨkai,   
\li1
\v 17 'Awiyaxi nuiwarimama: Tsikɨri puwa'ukiyaritɨkai,  
\li1 Minikamini nuiwarimama: mɨkɨta yuxeime yu'ukiyari mepexeiyakai,  
\li1 Muhariyaxi nuiwarimama: Piritahi puwa'ukiyaritɨkai,   
\li1
\v 18 Wirika nuiwarimama: Tsamuha puwa'ukiyaritɨkai,  
\li1 Tsemahiyaxi nuiwarimama: Kunatani puwa'ukiyaritɨkai,   
\li1
\v 19 Kuyariwi nuiwarimama: Matenahi puwa'ukiyaritɨkai,  
\li1 Kerahiyaxi nuiwarimama: 'Utsihi puwa'ukiyaritɨkai,   
\li1
\v 20 Tsarahi nuiwarimama: Karahi puwa'ukiyaritɨkai,  
\li1 'Amuki nuiwarimama: 'Ewexi puwa'ukiyaritɨkai,   
\li1
\v 21 Kirikiyaxi nuiwarimama: Katsawiyaxi puwa'ukiyaritɨkai,  
\li1 Kerahiyaxi nuiwarimama: Natanaheri puwa'ukiyaritɨkai.   
\p
\v 22 Kepauka 'Eriyatsiwi, Kuyara, Kuhanahani meta Karuha mawari wewiwamete wa'ukiyarima memɨhɨkɨtɨkaitsie rewitsixi wa'ukiyarima meta mawari wewiwamete wa'ukiyarima mekanaka'utsieni Raríyu ti'aitakaku Peritsiya kiekame.  
\v 23 Rewitsixi wa'ukiyarima Kuhanahani 'Eriyatsiwi nu'aya muyeikakaitsie xeikɨari mekanaka'utsieni kemɨtiuyɨ xapayaritsie.  
\v 24 Rewitsixi wa'ukiyarima mekanihɨkɨtɨkaitɨni Katsawiyaxi, Tserewiyaxi meta Ketsuha Karimieri nu'aya. Kepauka maye'axekai memɨtikwika wa'iwama mɨkɨ wahɨxie mekaniti'uwekaitɨni memɨtikwikakɨ meta pamɨpariyutsi memipitɨanikɨ, Rawiri kemɨtiu'aitaxɨ, tewi Kakaɨyari hetsɨa mieme.   
\p
\v 25 Mataniyaxi, Wakuwukiyaxi, 'Awiriyaxi, Metsurani, Tarimuni meta 'Akuwi kitenie tehɨwemete mekanihɨkɨtɨkaitɨni meta mɨtiuyepitɨkatsie kitenie 'aurie.  
\v 26 Yunaitɨ 'ikɨ Kuhakimi Ketsuha nu'aya meta Kutsaraki teukarieya muyeikakaitsie mekaniu'uwakaitɨni, meta Nehemiyaxi mukuwexinaruritɨkaitsie, meta mawari wewiwame meta ti'ɨkitame 'Etsitɨraxi mɨhɨkɨtɨkaitsie.   
\s1 'Ixɨarari kuraru hetsiemieme  
\p
\v 27 Kepauka maye'a kuraru hetsiemieme 'ixɨarari memɨwewienikɨ, mekaniwarutiwauni rewitsixi naitsarie kememɨte'ukutetɨkatei mekaniwarewitɨni, Kerutsareme 'ixɨarari memɨwewienikɨ kwikarikɨ meta pamɨpariyutsi me'ipitɨatɨ, meteyuitɨatɨ mɨtiutitiraurɨkakɨ, 'aripakɨ meta 'aripa 'etsimupekɨ.  
\v 28 Hikɨ mekaniuyukuxeɨrieni kwikamete Kerutsareme 'aurie kiekatari meta Netupa 'aurie kiekarite 'etsimɨyeyeutsie kiekatari,  
\v 29 meta Weti-Kirikari kiekatari, yaxeikɨatsiere Kehewa kwieyaritsie kiekatari meta 'Atsimaweti kiekatari, mɨkɨ Kerutsareme 'aurie mekaniuyutikitɨakaitɨni kwikamete.  
\v 30 Mawari wewiwamete meta rewitsixi me'uyu'itieka meri, 'ariketa teɨteri, meta kiteniete, metatsiere kuraru mekateniu'itieni.   
\p
\v 31 Hikɨ Kura kwieyaritsie kiekatari memanuyetei yanekatiniwarutahɨawe memanutikɨnekɨ kurarutsie, meta kwikamete meyumɨireme nekaniwarukuxeɨrieni me'ayehutame. Hipatɨ tatserieta meneutayune kuraru hetsie me'uhutɨ, Xatsi kitenieyari hepa me'erietɨ,  
\v 32 kwikamete wa'utɨa 'Utsahiyaxi kaniumiekaitɨni Kura kwieyaritsie memanuyetei warawitɨtɨ,  
\v 33 'Atsariyaxi, 'Etsitɨraxi, Metsurani,  
\v 34 Kura, Wenikamini, Tsemahiyaxi meta Keremiyaxi.  
\v 35 'Ikɨ mekaniwaruweiyakaitɨni mawari wewiwamete kuxineta me'u'ɨtɨ: Tsakariyaxi Kunatani nu'aya, Tsemahiyaxi nu'aya, Mataniyaxi nu'aya, Mikahiyaxi nu'aya, Tsakuxi nu'aya, 'Atsahapi nu'aya,  
\v 36 meta maremama Tsemahiyaxi, 'Atsareri, Mirarahi, Kirarahi, Mahi, Natanaheri, Kura meta Kananihi, kanarite memu'ɨkai Rawiri tipiinieya, tewi Kakaɨyari hetsɨa mieme. Matsi yunaime wahɨxie ti'ɨkitame 'Etsitɨraxi kaniumiekaitɨni.  
\v 37 Haixata kitenieyaritsie meye'axɨaka, heitserie mekaneutiyune teikɨmana tetexi 'imɨmɨiyari 'amatayewatsie Rawiri kiekariena, kuraru teikɨmana meutiyunetsie, Rawiri paratsiyuya manuwe 'aurie muyehanetsie mekaniuyekɨne, Haa kitenieyaritsie paitɨ mekaniye'axɨani, tau manatineika hepatsie.   
\p
\v 38 Hutarieka miemete kwikamete ta'utata meneutayune memanuyukunakekɨ, Huxunu tuxiyuyari kuraruyari 'utɨma meta kuraru 'amatayewa 'utɨma. Ne wa'utɨa nekaniumiekaitɨni, hipame teɨteri hixɨapa memɨ'axe newarawitɨtɨ.  
\v 39 Kitenie 'Epɨrahini mɨtitewa heima tekaniuyekɨne meta Ketsahana heima, meta kitenie Tsapari mɨtitewa heima, tuxiyu Kananeri mɨtitewa hetsie meta tuxiyu Xeitsienituyari mɨtitewatsie meta Muxatsi wakitenie mɨtitewatsie, 'atsita Kuyaxi kitenie mɨtitewatsie paitɨ tekaniye'axɨani. Mana tekaniwa'uni.  
\v 40 Kwikamete memayehuta tukita 'aixɨa mekateniuyu'uitɨani. Yaxeikɨata ne meta memanuyetei hixɨapa memɨ'axe 'aixɨa tekateniuyu'uitɨani,  
\v 41 meta mawari wewiwamete 'Eriyakini, Matsehiyaxi, Minikamini, Mikahiyaxi, 'Erihuhenahi, Tsakariyaxi, Kananiyaxi,  
\v 42 Matsehiyaxi, Tsemahiyaxi, 'Eriyatsaxi, 'Utsihi, Kuhanahani, Marikiyaxi, 'Erami meta 'Etsexi, mekateniukayuitɨwakaitɨni meta mekaniutikwikakaitɨni yutɨrɨkarima, 'Itsirahiyaxi mɨtiwa'aitɨa pɨhɨkɨtɨkai.   
\p
\v 43 Mɨkɨ tukaritsie mawari waɨkawa kaniuwewiyani meta 'ixɨarari mepuwewi Kakaɨyari temawierika muwarupitɨakɨ. Metatsiere 'ukarawetsixi meta tɨɨri mepɨte'uparewi. Yemekɨ waɨkawa temawierika Kerutsareme puxuawekai teewapaitɨ mepɨ'enieriekai.   
\s1 Kemɨtiyetuiwa mawari wewiwamete meta rewitsixi wahetsiemieme  
\p
\v 44 Mɨkɨ tukaritsie, mekaniutihɨawarieni 'imikierite mɨtiwati'utsiwa memɨhɨritɨarieni, matɨari mɨtiukaxuxuawere, tamamatatsie timieme. Mɨkɨ naitsarie mepɨtehatɨtɨkɨkani mɨraka'etsitɨre timieme kiekarite 'aurie, 'inɨari niukiyari kemɨti'aita, mawari wewiwamete wahetsiemieme meta rewitsixi. Teɨteri Kura kwieyaritsie kiekatari waɨkawa mekaniyutemamawiekaitɨni mawari wewiwamete meta rewitsixi wahetsiemieme kememɨte'uximayakai,  
\v 45 mɨkɨ wahetsiemieme kememɨte'u'aitakai Rawiri meta nu'aya Tsarumuni mɨpaɨ mekateni'uximayakaitɨni Kakaɨyari hetsiemieme meta 'itiya hepaɨtsita mekateni'uximayakaitɨni, kwikamete meyɨnɨtɨ meta kitenie tehɨwemete.  
\v 46 Mɨixa wiyari panuyemie kepauka Rawiri muyeikakaitsie meta 'Atsahapi, 'ana mepɨte'ukatsutɨa mewarexeiyatɨ kwikamete wa'ukiyarima, nɨawari memutikwika meta pamɨpariyutsi memipitɨa Kakaɨyari.  
\v 47 Tsuruwaweri muyeikakaitsie meta Nehemiyaxi, 'ixaheritsixi yamepɨteyetuayakai ketipaɨmetɨ memutikwika mɨtiwahetsiemieme meta kitenie tehɨwemete. Metatsiere 'imikierite mekaniyetuayakaitɨni rewitsixi wahetsiemieme, mɨkɨta rewitsixi 'Aruni niwemama mepɨtewayetuiriwakai ketipaɨmetɨ mɨtiwahetsiemiemetɨkai.   
\c 13  
\s1 'Imatɨrieka Nehemiyaxi kemɨtiuyuri  
\p
\v 1 Mɨkɨ tukaritsie teɨteri wahɨxie kanakaterɨwarieni Muitsexi xapaya 'inɨari niukiyari maye'uxa, mana kaniukaxeiyarieni kename 'amunitsixi meta muhawitsixi mekawapitɨakakekai Kakaɨyari teɨterimama wahamatɨa,  
\v 2 memɨkatewarumikɨ meta memɨkawaruharitɨakɨ makumawetsie. Meta 'akuxi matsi Warami memɨte'upitɨakɨ mɨwakewaiyakɨ, peru ke'axatemɨ'itɨarienikekai takakaɨyari pipataxɨ 'aixɨa pɨtatsi'uyuri pɨta.   
\p
\v 3 Hikɨ me'i'enieka 'inɨari niukiyari kemainekai, 'ana 'ixaheritsixi watsata mekaniwarayenɨ'ani yunaime kemɨ'ane yu'ukiyarima memɨwarexeiyakai teewapai kiekatari.   
\p
\v 4 Mɨpaɨ katiyɨwekaku 'akuxi, mawari wewiwame 'Eriyatsiwi mɨhɨritɨarie Kakaɨyari tukita timieme mɨtiuyepitɨkatsie, Tuwiyaxi kaniutimareta,  
\v 5 kii kanixatɨani 'apakame. Muwa pɨtiti'utsiwakai 'imikierite, 'ɨkwa, piinite tita tukita mɨtiyukumaɨwa, tamamatatsie mieme xewitɨ mɨtiyetuiwa: tɨriku, kaxie winuyari meta hatseiti rewitsixi wahetsiemieme, kwikamete meta kitenie tehɨwemete, meta mɨtiyetuiwa mawari wewiwamete wahetsie timieme.   
\p
\v 6 Ne 'ana Kerutsareme nepɨka'uyeikakai, xeitewiyari heimana tamamata heimana huta wiyaritsie ti'aitakaku 'Aritakexiketsi, Wawiruniya kwieyaritsie ti'aitame, ne 'ana nepetɨa ti'aitame hetsɨa. 'Arike yapaɨmexɨa wiyari 'anuyeyaku, ti'aitame netsi'upitɨaku,  
\v 7 nekanakunuani Kerutsareme, hikɨ 'ana nekatinetimani 'Eriyatsiwi ke'axamɨtiuyuriekai Tuwiyaxi muxatɨakɨ kii Kakaɨyari tukieya takwayaritsie 'uweme.  
\v 8 Mɨkɨkɨ waɨkawa nepuyeha'a kiita nepɨtiwayexɨri naime Tuwiyaxi tipiiniteya.  
\v 9 Hikɨta nepɨtiuta'aitaxɨ kii mɨ'itiyanikɨ meta muwa mɨreutapiyanikɨ piinite mɨtipatsietɨka Kakaɨyari tukieyata timieme, 'imikierite meta 'ɨkwa.   
\p
\v 10 Metatsiere yanepɨretima kename rewitsixi tita mɨtiwahetsiemieme mekateyetuiriyarɨwakai, meta kename rewitsixi meta kwikamete memɨhɨritɨariekai tukita memɨte'uximayakakɨ meheutayeixɨakai yukwietsie.  
\v 11 'Ana nepɨwarutati memanuyetei, mɨpaɨ nepɨtiwarutahɨawixɨ: «¿Titayari Kakaɨyari tukieya yuxaɨta xete'uku'eiri?» Hikɨ nekaniwarukuxeɨrieni meta kememɨte'uximayakai mɨpaɨ nekatiniwaru'uitɨani.   
\p
\v 12 Yunaitɨ Kura kwieyaritsie kiekatari kiita mɨtiwati'utsiwatsie mekateni'atɨani tamamatatsie mieme xeime memɨteyetuaya, tɨriku, kaxie winuyari meta hatseiti.  
\v 13 Mɨkɨ kiite mɨtiwati'utsiwa nekaniwaruhɨritɨani mawari wewiwamete Tseremiyaxi, ti'utɨwame Tsaruki, meta rewi tewiyari Perahiyaxi, waparewiwame nekaniutahɨawe Kanahani Tsakuxi nu'aya Mataniyaxi teukarieya. Mɨkɨ yunaitɨ 'aixɨa mekateniu'iyarikaitɨni, meta mɨkɨtsiere memɨtewatapitɨwa mekanihɨkɨtɨkaitɨni.   
\p
\v 14 «'Ikɨ naime ketina'eriwani, nekakaɨyari, 'aixɨa keneneyurieka, pepɨkaratɨtɨmaiyani ke'aixɨa nemɨtiuyuri 'atukitsie mieme meta pemayexeiyarieka hetsiemieme».   
\p
\v 15 'Ana mɨtiyehane Kura kwieyaritsie mɨpaɨ netiniuniere, xawatikɨ hipatɨ kaxie takari mekaniutiketsinakaitɨni, hipatɨta muratsixi wahetsie mekateni'ikatatɨwekaitɨni, tɨriku 'anahɨatɨkaime, kaxie winuyari, kaxie takari, xapa takariyari meta naime tita mɨti'ikatsiwa Kerutsareme mekatenetɨkɨkaitɨni. 'Ana nekaniwarutatieni memɨtetuakaikɨ 'ikwaite mɨkɨ tukaritsie.  
\v 16 Metatsiere Tiru kiekatari Kerutsareme memɨtitekai, kiekaritsie tsapari mekaniwa'atɨwakaitɨni, huriyutsixi mekaniwatuiriekaitɨni xawatikɨ.  
\v 17 Hikɨ Kura kwieyaritsie kiekatari wahetsiemieme memanuyetei 'ukirawetsixi nekaniwarutatieni, mɨpaɨ nekatiniwarutahɨawe: «Xeme 'axaxekateniyurieka xawati kapatsiekame xemayeitɨwakɨ.  
\v 18 Mɨpaɨ mekateniuyurieni xe'ukiyarima meripaitɨ, 'ayumieme takakaɨyari katatiniukwinitɨani meta 'ikɨ kiekari. ¿Kamɨtsɨ yaxeteha'eriwa tawarita 'Ixaheri hetsiemieme Kakaɨyari mɨyeha'anikɨ xawati kapatsiekame xemayeitɨwakɨ?»   
\p
\v 19 Hikɨ nekatiniuta'aita Kerutsareme kitenieyaritetsie mɨreunamiexɨanikɨ, xawati tukariyari kayutsutɨawekaku, mepɨkateheuyepiwanikekai 'atsita 'uxa'ariekake. Metatsiere hipame memɨnete'uximayatsirie kitenie nepɨwaru'uitɨaxɨa nixeimetɨma 'ika memɨkapitɨakakɨ meutahatɨarieni.  
\v 20 Heiwa yatɨ hutakɨa tetuayamete me'ayemɨiretɨ Kerutsareme warie mekaniukatariyarieni.  
\v 21 Mɨpaɨ nekatiniwarutatieni: «Kuraru warie xepɨkayukuhayeikawani. Tawari xɨka mɨpaɨ xe'uyɨni, ne nepɨxe'anutaxɨrieni». 'Anatɨtɨ mɨtiyehane tawariri xawatikɨ mepɨkaheukɨkɨnixɨa.  
\v 22 Hikɨ rewitsixi nekaniwaruta'aitɨani memɨyu'itienikɨ meta memɨtetahɨnikɨ kitenie, xawatikɨ patsiekame memayeitɨakakɨ.  
\p «'Ikɨ naime ketina'eriwani, nekakaɨyari, meta waɨkawa pemɨti'akanaki'eriekɨ, kenenenenimayaka».   
\p
\v 23 'Ana mɨtiyehane tsiere nepɨretima hipatɨ huriyutsixi 'ukari memɨwaruwitɨkɨkai 'Atsiruri kiekatari, 'Amuni kiekatari meta Muhawi.  
\v 24 Waniwema hixɨapa me'atɨ 'Atsiruri niukiyarikɨ mekaniutiniukakaitɨni meta yatɨni hipame waniukikɨ, huriyutsixi waniukikɨ mekaniuwawetɨ.  
\v 25 Hikɨ nekaniwarutatieni yanekatiniwarutahɨawe 'axamemɨ'itɨarienikɨ, hipame nekaniwarutiwani, meta wakɨpate nekaniukahuna, meta waɨriyarika nekaniwarupitɨani yamemɨtiyuanikɨ Kakaɨyari hɨxie. Mɨpaɨ nekatiniwarutahɨawe: «Yaxepɨkatenaki'erieka xeniwema 'ukari 'iya waniwema memɨwawitɨtɨweni, meta xeme, meta xeniwema 'ukitsi, waniwema 'ukari mepɨkawawitɨtɨweni.  
\v 26 ¿Xekatemate mɨpaɨ yɨanetɨ Tsarumuni 'axakatiuyuri 'Ixaheri kwieyaritsie ti'aitame? Nixeime kwieyaritsie tawarita mɨpaɨ 'anetɨ ti'aitame pɨka'anukake: Kakaɨyari pinaki'eriekai, ti'aitame peyeitɨa 'Ixaheri kwieyaritsie. Peru mɨkɨ 'ɨitamama 'ukarawetsixi 'ateewa kiekatari mekateniuyurieni Tsarumuni ke'axamɨtiuyuri.  
\v 27 Xemeta tsiere mɨpaɨ 'axaxekateniuyurieni xewawitɨtɨwetɨ 'ukari 'ateewa kiekatari».   
\p
\v 28 Kuyara niwemama xewitɨ, mawari wewiwamete tiwa'aitɨwame 'Eriyatsiwi nu'aya, nepitanɨ'a nehamatɨa mɨka'uyeikanikɨ Tsamɨwarati huruni tewiyari mumunieyatɨkaikɨ.   
\p
\v 29 «Nekakaɨyari, keniwara'eriwani mawari wewiwamete mekapatsietɨkaime memayuyeitɨa meta tɨratu memiwewi mawari wewiwamete meta rewitsixi tixaɨtɨ memɨkatehayeitɨa».   
\p
\v 30 Ne mɨpaɨ nekatiniwaru'itieni huriyutsixi teewakiekatari nekaniwarayenɨ'ani, meta mawari wewiwamete meta rewitsixi yanepɨtiwaru'uitɨa kememɨte'uximayakai.  
\v 31 Metatsiere 'aixɨa nekatiniwaru'uitɨani kɨyexi mɨyetuiwa hepaɨtsita kemɨ'ane tukaritsie memiyetuayani, metatsiere matɨari timieme 'ikwaxi mɨtiyetuiwa hepaɨtsita 'aixɨa nekatiniwaru'uitɨani.  
\p «Nekakaɨyari, kenena'eriwani, 'aixɨa keneneyurieka».   