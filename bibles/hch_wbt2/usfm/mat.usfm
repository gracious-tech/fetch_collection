\id MAT  
\h Mateu 
\toc1 Mateu niuki 'aixɨa manuyɨne kemɨraka'utɨa 
\toc2 Mateu 
\toc3 Mat 
\mt1 Mateu  
\mt2 Niuki 'aixɨa manuyɨne kemɨraka'utɨa  
\c 1  
\s1 Ketsutsi Kɨritsitu 'inɨarieya, kemɨ'ane mɨnu'ayatɨkai  
\r (Mat 1:1-17 – Ruk 3:23-38, Xuti 4:18-22, 1Kem 3:10-17)  
\p
\v 1 'Inɨari kanihɨkɨtɨni 'ikɨ. Nuiwarite mekani'inɨarini, Ketsutsi Kɨritsitu kemɨ'ane mɨxiɨyarieyatɨkai. Rawiri kanitutsieyatɨkaitɨni, meta 'Apɨrahami:   
\b  
\li1
\v 2 'Apɨrahami, 'Itsahaki, kanipaapayatɨkaitɨni.  
\li2 'Itsahaki, Kakuwu, pɨpaapayatɨkai.  
\li2 Kakuwu, Kura pɨpaapayatɨkai meta 'iwamama.   
\li2
\v 3 Kura, Paretsi meta Tsara pɨwapaapatɨkai meta Tamaxi pɨwamaamatɨkai.  
\li2 Paretsi, Hetsirumi pɨpaapayatɨkai.  
\li2 Hetsirumi 'Arami pɨpaapayatɨkai.   
\li2
\v 4 'Arami 'Aminarawi pɨpaapayatɨkai.  
\li2 'Aminarawi Nahatsuni pɨpaapayatɨkai.  
\li2 Nahatsuni Tsarimuni pɨpaapayatɨkai.   
\li2
\v 5 Tsarimuni Wuhutsi pɨpaapayatɨkai meta Xahawi pɨmaamayatɨkai.  
\li2 Wuhutsi Huweri pɨpaapayatɨkai meta Xuti pɨmaamayatɨkai.  
\li2 Huweri Kitsahi pɨpaapayatɨkai.   
\li2
\v 6 Kitsahi Rawiri ti'aitame pɨpaapayatɨkai.  
\b  
\li1 Rawiri Tsarumuni pɨpaapayatɨkai, Huriyaxi mɨ'ɨyayatɨkaitsie meyexei.   
\li2
\v 7 Tsarumuni Xuwuhani pɨpaapayatɨkai.  
\li2 Xuwuhani 'Awiyaxi pɨpaapayatɨkai.  
\li2 'Awiyaxi 'Atsa pɨpaapayatɨkai.   
\li2
\v 8 'Atsa Kutsapati pɨpaapayatɨkai.  
\li2 Kutsapati Kurami pɨpaapayatɨkai.  
\li2 Kurami 'Utsiyaxi pɨpaapayatɨkai.   
\li2
\v 9 'Utsiyaxi Kutami pɨpaapayatɨkai.  
\li2 Kutami 'Akaxi pɨpaapayatɨkai.  
\li2 'Akaxi 'Etsekiyaxi pɨpaapayatɨkai.   
\li2
\v 10 'Etsekiyaxi Manatsexi pɨpaapayatɨkai.  
\li2 Manatsexi 'Amuni pɨpaapayatɨkai.  
\li2 'Amuni Kutsiyaxi pɨpaapayatɨkai.   
\li2
\v 11 Kutsiyaxi Kekuniyaxi pɨpaapayatɨkai, meta 'iwamama kepauka waɨriyarika memehapanie Wawiruniyatsie paitɨ.   
\b  
\li1
\v 12 Mehehapanieka Wawiruniyatsie,  
\li2 Kekuniyaxi Tsaratieri pɨpaapayatɨkai.  
\li2 Tsaratieri Tsuruwaweri pɨpaapayatɨkai.   
\li2
\v 13 Tsuruwaweri 'Awihuri pɨpaapayatɨkai.  
\li2 'Awihuri 'Eriyakimi pɨpaapayatɨkai.  
\li2 'Eriyakimi 'Atsuxi pɨpaapayatɨkai.   
\li2
\v 14 'Atsuxi Tsaruki pɨpaapayatɨkai.  
\li2 Tsaruki 'Akimi pɨpaapayatɨkai.  
\li2 'Akimi 'Eriyuri pɨpaapayatɨkai.   
\li2
\v 15 'Eriyuri 'Eriyatsaxi pɨpaapayatɨkai.  
\li2 'Eriyatsaxi Matani pɨpaapayatɨkai.  
\li2 Matani Kakuwu pɨpaapayatɨkai,   
\li2
\v 16 meta Kakuwu Kutse pɨpaapayatɨkai, Kutse Mariya pɨkɨnayatɨkai, hikɨ Mariya hetsie kaniyenuiwa Ketsutsi, Kɨritsitu mɨtitewa.   
\b  
\p
\v 17 'Ikɨ 'Apɨrahami hetsie memɨyekɨ nuiwarite tamamata heimana nauka xiɨyariyari mekaniyupaɨmekaitɨni Rawiri 'amuyeikakaitsie. Tamamata heimana nauka xiɨyariyari mepɨyupaɨmekai Rawiri hetsie memɨyekɨ Wawiruniya paitɨ memehapanietsie, meta tamamata heimana nauka xiɨyariyari mepɨyupaɨmekai, Wawiruniya paitɨ memehapanietsie Kɨritsitu putinuiwaxɨ.   
\s1 Ketsutsi Kɨritsitu kemɨtiunuiwaxɨ  
\p
\v 18 Merikɨtsɨ mɨpaɨ katiniuyɨni kepauka Ketsutsi Kɨritsitu mutinuiwaxɨ: Mariya mɨmamayatɨkai Kutse matɨa mepɨyutiwitɨnikekai, peru mekayutiwitɨwetɨ 'akuxi, mɨkɨ kaniutihukata, 'Iyari Mɨtiyupata ya'ane 'ipitɨaku.  
\v 19 Kutse kɨnaya mayanikekai, mɨkɨ heitseriemekɨ yakatinikamiekaitɨni, peru pɨkayuwaɨriyakai mixanetanikɨ. 'Ayumieme pi'eirimɨkɨkai 'awie.  
\v 20 Merikɨtsɨ mɨpaɨ tiku'eriwakaku, hikɨ Ti'aitame hetsɨa mieme niuki tuayame kaniuxeiya yuheinɨtsita mɨpaɨ 'utaineme: «Kutse 'aku Rawiri pemɨnu'aya, pepɨkamaka Mariya pemɨtiwitɨnikɨ 'a'ɨya mayani, 'Iyari Mɨtiyupata ya'ane 'ipitɨaku, hetsiena pɨyeya 'ikɨ nunutsi.  
\v 21 'Ukitɨme pɨtiniweni, Ketsutsi pɨtitewaka, mɨkɨ yuteɨterima kaniwatawikweitsitɨamɨkɨ ke'axamemɨteyurie».   
\p
\v 22 'Ikɨ naitɨ mɨpaɨ katiniuyɨni, maye'anikɨ tita mɨtixatakai Ti'aitame, Kakaɨyari niukameya mɨpaɨ 'utainekaku:  
\v 23 «Kamɨtsɨ 'ɨimari mɨyuxewi pɨtihukata, 'ukitɨme pɨtiniweni, 'Emanuheri xepɨte'iterɨwa» (mɨkɨ mɨpaɨ panuyɨne «Kakaɨyari tahamatɨa muyeika»).   
\p
\v 24 Merikɨtsɨ Kutse yatiheinɨtɨ kananutaniere, mɨpaɨ katiniuyurieni kemɨtita'aitɨa Ti'aitame hetsɨa mieme niuki tuayame, kanitiwitɨni 'ɨyaya mayanikɨ.  
\v 25 Peru pɨka'ikumaɨwakai, 'arikeke yumexɨakame nunutsi 'utinuiwitɨakuke, hikɨ Ketsutsi pɨtiterɨwaxɨ.   
\c 2  
\s1 Temaiwawemete kememɨte'u'axɨa  
\p
\v 1 Merikɨtsɨ Ketsutsi Wereni paitɨ hetinuiwaku Kureya kwieyaritsie, kepauka Herurexi mana mɨti'aitametɨkai. 'Ana yukwiepa meheyekɨneka temaiwawemete tayeta mepayenexɨa, kiekaritsie Kerutsareme mekaniu'axɨani,  
\v 2 mɨpaɨ me'utiyuatɨ:  
\p ―¿Hakewari peka Huriyutsixi teɨteriyari tiwa'aitɨwame metinuiwaxɨ? Tame xurawe tepexei 'anatineximekaku, tepu'axɨa nenewieri te'ipitɨanike.   
\p
\v 3 Kepauka ti'aitame Herurexi mɨtiutamari kaniuyeha'ani, meta yunaitɨ Kerutsareme kiekatari.  
\v 4 Hikɨ yunaime kiekatari kaniwarukuxeɨrieni mawari wewiwamete tewa'aitɨwamete, meta 'inɨarikɨ memɨte'ɨkitametetɨkai, teɨteri watsata miemete yunaime, kaniwaruta'iwawiya hakewa metinuiwakekai Kɨritsitu.  
\v 5 Mɨpaɨ mekatenitahɨawe:  
\p ―Wereni paitɨ Kureya kwieyaritsie, mɨpaɨ mɨtiu'ɨtɨakaikɨ Kakaɨyari niukameya:   
\q1
\v 6 »“Peru 'ekɨ, Wereni, Kureya kwieyaritsie mukuma,  
\q2 kepemɨtinenixeiyarie te'aitamete Kura kwieyaritsie watsata, kanimariwani xekiekari.  
\q1 'Ahetsɨa pɨyenuiwa ti'aitametɨtɨ,  
\q2 neteɨterima 'ixaheritsixi wa'ɨwiyame kanayeimɨkɨ”».   
\p
\v 7 Hikɨ Herurexi temaiwawemete kaniwaruta'inieni 'awie. Kaniwaruta'iwawiya heitseriemekɨ kepauka muyuhekɨataxɨ xurawe.  
\v 8 Hikɨ kaniwarenɨ'ani Wereni paitɨ, mɨpaɨ tiwarutahɨaweka:  
\p ―Mana xekenehu, heitseriemekɨ xekeneti'iwau nunutsi hepaɨtsita. Kepauka xemeitaxeiya yaxekeneteneutahɨawi, manata ne neminenewiyamiekɨ.   
\p
\v 9 Ti'aitame me'u'enieka mekanekɨne, kamɨtsɨ xurawe memexeiyakai 'anatineximekaku, mɨkɨ wahɨxie kaniumiekaitɨni. Heta'aka hakewa meyekatei nunutsi, heimana kaniuyeyerɨni.  
\v 10 Me'ixeiyatɨ xurawe kwini mieme mekateniyutemamawiekaitɨni yemekɨ.  
\v 11 Hikɨ kiita meheutahaxɨaka, nunutsi mekaniuxeiya Mariya mɨmaamaya hamatɨa, hikɨ me'utihɨxima'uka nenewieri mekanipitɨani. Yupiinite metewatipika, 'imikieri mekatenimini huru, 'ɨkwa witsimu'ɨa meta mixaxi.  
\v 12 Hikɨ yuheinɨtsita mete'utaxatɨarieka kename Herurexi hetsɨa tawari mekaheuhuni, xeime huyeyari 'utɨa pɨta me'uhutɨ yukwiepapai mekanakunuaxɨani.   
\s1 Kememɨte'uyuta'unaxɨ 'Ekipitu kwieyaritsie paitɨ  
\p
\v 13 Merikɨtsɨ mehekɨnekuri mɨkɨ, Kutse yuheinɨtsita Ti'aitame hetsɨa mieme niuki tuayame kaniuxeiya, mɨpaɨ katinitahɨawe: «Kenanukukexi, keniwaranuwitɨki nunutsi meta maamaya, 'Ekipitu paitɨ xekeneuyuta'una. Mana xekenekuteni, kepaukake yanemɨtayɨni. Herurexi nunutsi kanitiwaumɨkɨ 'imienike».   
\p
\v 14 Hikɨ 'anukukeka Kutse, yɨwikɨta kaniwarewitɨni nunutsi meta maamaya 'Ekipitu paitɨ.  
\v 15 Mana mekanikutekaitɨni mexi Herurexi kamɨwekai. Mɨpaɨ katinaye'atɨarieni Ti'aitame kemainekai Kakaɨyari niukameya mɨpaɨ mainekaikɨ: «'Ekipitu kwieyaritsie neniwe nekaniutahɨawe».   
\p
\v 16 Hikɨ kepauka mɨtiutamari Herurexi kememɨte'ikwamanaxɨ temaiwawemete, kwinimieme katiniuyeha'ani. Hikɨ katiniuta'aita tɨɨri memɨwakwinikɨ yunaime huta wiyari memɨkahɨtɨka 'akuxi, Wereni memɨtitekai meta naitsarie 'auriena memɨtitekai, kememɨte'itahɨawixɨ temaiwawemete tukari hepaɨtsita.  
\v 17 Hikɨ mɨpaɨ katinaye'atɨarieni Keremiyaxi Kakaɨyari niukameya kemutayɨkai:   
\q1
\v 18 «Xewitɨ pe'enierie Xama kiekariyaritsie  
\q2 'utatsuatɨ yuheiwerietɨ kwinimieme,  
\q1 Xakeri putatsuaka yuniwema wahekɨ  
\q2 kayunɨtɨarinɨatɨ 'amemɨka'u'uwakɨri».   
\p
\v 19 Merikɨtsɨ 'arike Herurexi 'umɨku, Kutse yuheinɨtsita kanixeiya Ti'aitame hetsɨa mieme niuki tuayame 'Ekipitu kwieyaritsie heyeikatɨ,  
\v 20 mɨpaɨ katinitahɨawe: «Kenanukukexi, keniwaranuwitɨki nunutsi meta maamaya 'Ixaheri kwieyaritsie kenemie. Mekanekwiniri mɨkɨ nunutsi memɨmiekukai».   
\p
\v 21 Hikɨ 'anukukeka kaniwarewitɨni nunutsi meta maamaya, mana kaneta'ani 'Ixaheri kwieyaritsie.  
\v 22 Merikɨ tiutamarieka kename 'Arikerau ti'aitametɨkai Kureya kwieyaritsie yupaapa hetsiemieme Herurexi, peumakai mana mɨye'anikɨ. Mɨpaɨ Kakaɨyari katinitahɨawe heinɨtsitana, Karereya kwieyaritsie pɨta kenemie,  
\v 23 mana kiekari Natsareti mɨrakutewatsie kaninuani. Mɨpaɨ katinaye'ani Ti'aitame kemutayɨ, Kakaɨyari niukametemama yame'utiyuanekaku kename: «Natsarenu titewakakekai».   
\c 3  
\s1 Ti'ɨyame Wani kemɨtikuxatakai  
\r (Mat 3:1-12 – Mar 1:3-8, Ruk 3:2-17)  
\p
\v 1 Merikɨtsɨ mɨkɨ tukaritsie Kureya kwieyaritsie Wani Ti'ɨyame kaninuani tikuxatatɨ makumawetsie,  
\v 2 mɨpaɨ 'utaitɨ: «Xeketeneuhayewa ke'axaxemɨteyurie, kanehuraniri Kakaɨyari kemɨtita'aita».  
\v 3 Mɨkɨ Wani kanihɨkɨtɨni, Kakaɨyari niukameya Kitsariyaxi hepaɨtsitana mɨpaɨ mɨraka'utɨa:  
\q1 «Xewitɨ makumawetsie mɨpaɨ pɨrehiwa:  
\q1 “Xekeneukuha'aritɨa Ti'aitame huyeya,  
\q2 xexeurawime huyeya xekeneutiwewi”».   
\p
\v 4 Wani kemarieya kameyu huxarieyakɨ pɨwewiyakai. Nawikɨ kananayukuhɨakaitɨni meta pɨti'ikwaiyatɨkai tɨpuxi meta xiete yeuta mieme.  
\v 5 Hikɨ teɨteri mekani'axekaitɨni hetsɨana Kerutsareme kiekatari, yunaitɨ Kureyatsie kiekatari, meta Kurutani hatuxame tetsita kiekatari.  
\v 6 Mɨkɨ meyuhekɨatakaku 'axakememɨteyuriekai, mɨkɨ kaniwaruka'ɨyakaitɨni Kurutani hatuxameyaritsie.   
\p
\v 7 Hikɨ yumɨireme waxeiyatɨ paritseutsixi meta tsarutseutsixi hetsɨana memɨ'axekaikɨ mɨra'ɨyanekaitsie, mɨpaɨ katiniwarutahɨawe: «Kuterixi waniwema. ¿Kemɨ'ane mɨpaɨ pɨtixe'utahɨawixɨ xemɨyuta'unakɨ kapa 'uxa'atɨniwarie xe'uyehekarienikɨ?  
\v 8 Yaxeketeneu'uwani xematsiɨkɨtɨ xemɨte'uhayewaxɨkɨ 'axaxeteyurietɨ.  
\v 9 Mɨpaɨ xepɨkateku'eriwani kename xeyɨwawe xemɨteyukɨhɨawe: “Tame tepɨnaki'eriwa tapaapa 'Apɨrahami mɨhɨkɨkɨ”. Mɨpaɨ nepɨtixekɨhɨawe, Kakaɨyari kaniyɨweni 'ikɨ tetexi teɨteri mɨwarayeitɨanikɨ, 'Apɨrahami niwemama memakɨnekɨ.  
\v 10 Hatsa kaniha'aritsieka 'iteɨrite tsutɨana maxɨriyanikɨ. 'Ayumieme naitɨ 'iteɨri mɨka'ukaxuxuawere kanawitekiemɨkɨ, meta taipa kaneukahɨiyamɨkɨ.   
\p
\v 11 »Ne nekanixe'uka'ɨyani hakɨkɨ, mɨpaɨ mɨtimatsiɨkɨnikɨ kename 'axaxeteyurietɨ xete'uhayewaxɨ. Peru ne'utɨma 'umamie mɨkɨ matsi waɨkawa kanitɨrɨkaɨyeni keyuri ne, 'aixɨa nepɨka'ane nehetsie mɨtinakenikɨ nemiparewienikɨ. Mɨkɨ pɨxeka'ɨya 'Iyari Mɨtiyupatakɨ meta taikɨ.  
\v 12 Ti'itiwame pakwe'e, yutɨriku xatsiyari panuyewiwieni, kaniti'utamɨkɨ takariyari kaxetunitsie, hikɨ xatsiyari pɨtitaiyarieni tai mɨkatɨwetsie».   
\s1 Ketsutsi kemɨtiuka'ɨyarie  
\r (Mat 3:13-17 – Mar 1:9-11, Ruk 3:21-22, Wa 1:31-34)  
\p
\v 13 Merikɨtsɨ 'ana Ketsutsi Karereya kwieyaritsie heyeyaka, Kurutani hatuxameyaritsie kaninuani Wani mika'ɨyakɨ.  
\v 14 Peru Wani kaniyuku'imawakaitɨni mɨpaɨ tikɨhɨawetɨ:  
\p ―Matsi kaneuyeweka 'ekɨpɨta pemɨnetsika'ɨyakɨ, 'ekɨtapɨta nehetsɨa petinua.   
\p
\v 15 Ketsutsi mɨpaɨ katinitahɨawe:  
\p ―Mɨpaɨ pɨtiyɨni hikɨ, 'aixɨa kani'aneni yatemɨtekahunikɨ naime heitseriemekɨ.  
\p Hikɨ Wani yapɨtikatɨa.   
\p
\v 16 Hikɨ Ketsutsi 'uka'ɨyarieka, kwitɨ hapa 'anatiyaku. 'Ana taheima muyuawitsie katineuyepiere, hikɨ mɨkɨ Kakaɨyari 'Iyarieya kaniuxeiya heimana 'akamiekame kukuru hepaɨ 'anetɨ, hetsiena yuhayewake.  
\v 17 Hikɨ xewitɨta muyuawitsie mɨpaɨ kanetayɨni: «'Ikɨ Neniwe kanihɨkɨtɨni neminaki'erie, mɨkɨkɨ nekaniyutemawieka».   
\c 4  
\s1 Ketsutsi kemɨtiuta'inɨatsie  
\r (Mat 4:1-11 – Mar 1:12-13, Ruk 4:1-13)  
\p
\v 1 Hikɨ 'Iyari Ketsutsi kanewitɨni makumawetsie paitɨ, mana Kauyumarie mita'inɨatakɨ.  
\v 2 Hikɨ huta tewiyari tukari, huta tewiyari tɨkari yuhakietɨ, kaneuhakamɨkɨkaitɨni.  
\v 3 Hikɨ tiyu'irɨwiyame nuaka mɨpaɨ katinitahɨawe:  
\p ―Kamɨtsɨ, xɨka 'ekɨ Kakaɨyari penu'ayatɨni, mɨpaɨ ketineutahɨawi 'ikɨ tetexi paa makɨnekɨ.   
\p
\v 4 Ketsutsi mɨpaɨ katinita'eiya:  
\p ―'Utɨarika mɨpaɨ kanaineni: “Tewi paakɨ xeikɨa pɨka'ayeniereni, Kakaɨyari kemutayɨ, niukieya naitɨ peuyewetseta”.   
\p
\v 5 Hikɨta kauyumarie Kerutsareme kiekariyaritsie paitɨ kaneiwitɨni, tuki yekɨrita 'amanutitewatsie kanenutiwitɨni.  
\v 6 Hikɨ mɨpaɨ katinitahɨawe:  
\p ―Xɨka 'ekɨ Kakaɨyari penu'ayatɨni, 'ena keneukatsuna. 'Utɨarika mɨpaɨ kanaineni:  
\q1 »“Niuki tuayamete pɨtiwa'aitɨaka 'ahepaɨtsita,  
\q2 yumamakɨ mepɨmatsituikani  
\q1 kapa tetetsie pe'uti'ɨkamɨrekɨ”».   
\p
\v 7 Hikɨ Ketsutsi mɨpaɨ katinita'eiya:  
\p ―Mɨpaɨta kanaineni 'utɨarika: “Ti'aitame mɨ'akakaɨyari pepɨka'inɨataneni”.   
\p
\v 8 Hikɨ tawari Kauyumarie kaneiwitɨni hɨri 'amanutitewatsie, kwiepa memɨte'aita wakwie xexuime kanixeiyatsitɨani witsimɨ'anene.  
\v 9 Mɨpaɨ tikuhɨawetɨ:  
\p ―'Ikɨ naime nepɨmatsiyetuirieni, xɨka pe'awaɨriyani pemɨnetsi'ayexeiyanikɨ.   
\p
\v 10 Hikɨ Ketsutsi mɨpaɨ katinitahɨawe:  
\p ―Kenemie Kauyumarie. 'Utɨarika mɨpaɨ kanaineni: “Ti'aitame mɨ'akakaɨyari xeikɨa kenayexeiyani”.   
\p
\v 11 Hikɨ Kauyumarie kanihayewa kaneyani, niuki tuayamete me'u'axɨaka mekaniparewiekaitɨni.   
\s1 Ketsutsi kemɨtitsutɨa tikuxatatɨ  
\p
\v 12 Kepauka Ketsutsi mɨtiutamari kename Wani hanutahɨiyakai, Karereya paitɨ kaneyani.  
\v 13 Natsaretitsie yeyaka, Kaperunaume kaneyani mana mekanikɨ harakuna tetsita mɨti'ane, Tsawuruni kwieyaritsie meta Nepɨtahari,  
\v 14 mɨpaɨ katinaye'ani Kakaɨyari niukameya Kitsariyaxi kemutayɨ:   
\q1
\v 15 «Tsawuruni kwieyari meta Nepɨtahari kwieyari,  
\q2 harakuna mananiere Kurutani 'anutaɨye meta,  
\q2 Karereya memɨkatateɨterima memakutei,   
\q1
\v 16 teɨteri makuyɨwitsie memɨtitei  
\q2 mɨkɨ hekɨariya kwimɨxawatɨ mekaniuxeiya,  
\q1 mɨkɨ yɨwipa memɨkutei hake memɨkwiximekai,  
\q2 mɨkɨ wahetsiemieme hekɨariya kaniuhekɨariwieni».   
\p
\v 17 Merikɨtsɨ 'ana Ketsutsi kanitsutɨani mɨpaɨ tikuxatatɨ: «Xeketeneuhayewa ke'axaxemɨteyurie, karikɨ kanehuraniri Kakaɨyari kemɨtita'aita».   
\s1 Ketsutsi ketsɨweiyamete kemɨtiwaruta'ini yunaukame  
\r (Mat 4:18-22 – Mar 1:16-20, Ruk 5:2-11, Wa 1:35-42)  
\p
\v 18 Kepauka harakuna tetsita muyemiekai Karereya kwieyaritsie, kaniwaruxeiya yuhutame yu'iwamakame: xewitɨ Tsimuni Pekuru mɨtitewakai, meta 'Atɨrexi. Mana wipikɨ mekateniwiwietɨwekaitɨni harakunatsie, mɨkɨ memɨketsɨweiyametetɨkaikɨ.  
\v 19 Hikɨ Ketsutsi mɨpaɨ katiniwarutahɨawe: «Hikɨmɨ, nehetsie xeketeneuwiya, teɨteri waxexeɨriwamete nekanixe'ayeitɨamɨkɨ».  
\v 20 'Ana yapauka wipi me'uku'eiriexɨaka, hetsiena mekateniuwiya.   
\p
\v 21 Manata kwitɨwa ya'amietɨ kaniwaruxeiyata yuhutame yu'iwamakame: Kakuwu meta Wani, Tsewereu niwemama, kanuwatsie mekaniyetekaitɨni yupaapa hamatɨa yuwipi memanetsikitɨatɨ. Hikɨ kaniwaruta'inieni.  
\v 22 Hikɨ 'ana kwitɨwa kanuwa me'uku'eirieka meta yupaapa, mekaneiweiya.   
\s1 Ketsutsi kemɨtiwa'ɨkitɨakai yumɨireme  
\p
\v 23 Merikɨtsɨ Ketsutsi naitsarie Karereya kwieyaritsie kanikuyeikakaitɨni, tukiteta tiku'ɨkitanetɨ, niuki 'aixɨa manuyɨne taheima mieme hepaɨtsita tikuxatatɨ, 'aixɨa meteheu'eriekame warayeitɨwatɨ naime kwiniya hepaɨtsita meta kememɨte'uka'eniwakai teɨteri.  
\v 24 Naitsarie Tsiriya kwieyaritsie kaniutamariwa. Mekaniwa'atɨwakaitɨni kwiniya yukɨ 'anenemekɨ memɨtekukuyekai, kukuiniyakɨ waɨkawa memɨte'uka'eniwa, kakaɨyarixi 'axamemɨ'anene memɨwanɨ'ɨ, meta kierixiekate, meta huriekate, hikɨ mɨkɨ kaniwaranayexɨrɨwakaitɨni.  
\v 25 Yumɨiretɨ teɨteri mekaneweiyakaitɨni Karereyatari, Tamamata Kiekaritsietari meta Kerutsaremetari, Kureyatari, meta Kurutani 'anutaɨyetari.   
\c 5  
\s1 Mɨkɨ 'aixɨa memɨ'itɨarie meta mɨkɨ 'axamemɨ'itɨarie  
\r (Mat 5:3-12 – Ruk 6:20-23)  
\p
\v 1 Merikɨtsɨ teɨteri yumɨireme waxeiyatɨ, mana yemuritsie neutiyune, hikɨ nanukayerɨni. Teyɨ'ɨkitɨwametemama 'auriena mekaniu'axɨani,  
\v 2 mɨkɨ katiniwaruti'ɨkitɨani mɨpaɨ 'utaitɨ:   
\q1
\v 3 «'Aixɨa mekani'itɨarieka mɨkɨ waɨkawa memɨteheuyehɨwa yu'iyaritsie kememɨteyumate,  
\q2 kemɨ'ane taheima makawe mekanexeiyakakuni tiwa'aitɨwametɨme.   
\q1
\v 4 'Aixɨa mekani'itɨarieka mɨkɨ memɨyuheiwerie,  
\q2 mepɨnɨtɨarieni.   
\q1
\v 5 'Aixɨa mekani'itɨarieka mɨkɨ memɨka'ayu'eririya,  
\q2 wahetsie pɨtinake kwie naitɨ.   
\q1
\v 6 'Aixɨa mekani'itɨarieka mɨkɨ memɨyuwaɨriya heitseriemekɨ yamemɨtekahunikɨ  
\q2 yaxeikɨa tewi hepaɨ meuhakamɨkɨ meuharimɨkɨ hepaɨ,  
\q2 yamepɨtepitɨarieni mepɨtihuxani.   
\q1
\v 7 'Aixɨa mekani'itɨarieka mɨkɨ memɨteyukanenimaya,  
\q2 mepɨtinenimayatsieni.   
\q1
\v 8 'Aixɨa mekani'itɨarieka mɨkɨ memɨ'itiyatɨka wa'iyari mɨyuxewinikɨ,  
\q2 mepixeiya Kakaɨyari.   
\q1
\v 9 'Aixɨa mekani'itɨarieka mɨkɨ memɨwanɨtɨani teɨteri, 'aixɨa memɨteyuxeiyanikɨ,  
\q2 mepɨmatsiɨkɨni Kakaɨyari niwemama kememɨtehɨkɨ.   
\q1
\v 10 'Aixɨa mekani'itɨarieka mɨkɨ memuweiyarie memɨyuwaɨriyakɨ heitseriemekɨ yamemɨtekahunikɨ,  
\q2 kemɨ'ane taheima makawe mekanexeiyakuni tiwa'aitɨwametɨme.   
\p
\v 11 »'Aixɨa xekani'itɨarieka xeme kepauka memɨxeta'uxiwe'erieni, kepauka memɨxe'uweiyani, kepauka mete'itawatɨ 'axamemutiyuaneni xehepaɨtsita naimekɨ nehetsie xemɨmiemetekɨ.  
\v 12 Xekeneyutemamawieka 'ana xekenenaki'aka mɨpaɨ xetemaitɨ, 'aixɨa 'aneme xekanipitɨariekuni waɨkawa taheima mieme. Mɨpaɨta meteniwaruweiyakaitɨni Kakaɨyari niukametemama meripaitɨ miemete.   
\s1 Kwiepa memɨtama wa'una wahekɨariwiwamete  
\p
\v 13 »Xeme kwiepa memɨtama wa'una xekanihɨkɨtɨni. Xɨka 'una hamuritɨ 'ayani, ¿titakɨ ha'utsiwitɨ rayani? Pɨkatiyunaki'erieri, panuyewiwiyani xeikɨa, teɨteri hetsiena memu'uwanikɨ.   
\p
\v 14 »Xeme kwiepa memɨtama wahekɨariwiwamete xekanihɨkɨtɨni. Yemuri heima kiekari mɨkama pɨkayɨwe mɨti'awietsieni.  
\v 15 Mɨkɨ meta, kɨxeme 'utaiyame kakunikɨ pɨka'enukanani. Matsi pɨta, wapaitɨ neitiyemɨkɨ mɨwahekɨariwiyakɨ yunaime kiita memayetei.  
\v 16 Yaxeikɨata xeme, hekɨariya xehetsɨa mieme mɨpaɨ ketihekɨaka teɨteri wahɨxie, memɨxexeiyanikɨ 'aixɨa kexemɨteyurie, 'aixɨa memutiyuanenikɨ xe'ukiyari taheima makawe hepaɨtsita.   
\s1 Ketsutsi kemutayɨ 'inɨari niukiyari hepaɨtsita  
\p
\v 17 »Mɨpaɨ xepɨkateku'eriwani kename nenua ne'ika'unake 'inɨari niukiyari, Kakaɨyari niukametemama waniukiyari. Kenemɨtinua, ne'ika'unake nekapunua, ne'eye'atɨanike pɨta nekaninuani.  
\v 18 Yurikɨ mɨpaɨ nepɨxerahɨawe, mexi kataxɨwe muyuawi meta kwie, xeihɨxiyari xeituniyari pɨkatatɨmaiyarieni 'inɨari niukiyaritsie mieme, naitɨ mexi karaye'awe.  
\v 19 Kemɨ'ane mitixani'erieni 'ikɨ 'aitsika tsepa 'imatɨme, yatiwa'ɨkitɨatɨ teɨteri, mɨkɨta 'imatɨme pɨtaterɨwarieni, kememɨtemariwa mɨkɨ memeixeiya kemɨ'ane taheima makawe tiwa'aitɨwametɨme. Perutsɨ kemɨ'ane yamɨtikamie yamɨti'ɨkita, mexɨakame pɨta pɨtaterɨwarieni.  
\v 20 Mɨpaɨ nepɨtixekɨhɨawe, xeme xepɨyuwaɨriya heitseriemekɨ yaxemɨtekahunikɨ. Mɨkɨ meta 'inɨarikɨ memɨte'ɨkitamete, paritseutsixi meta, mɨkɨ yaxeikɨa waniu mepɨteyuwaɨriya. Merikɨte, peuyewetse xeme matsi yemekɨ yaxemɨtekahunikɨ. Mexɨka katixaɨtɨni, tixaɨ xepɨkaheutahaxɨani hakewa mɨra'aita kemɨ'ane taheima makawe.   
\s1 Ketsutsi kemutayɨ memɨha'a wahepaɨtsita  
\r (Mat 5:25-26 – Ruk 12:58-59)  
\p
\v 21 »Xepɨ'enana kename mɨpaɨ mete'utahɨawarie meripaitɨ xetutsima: “Pepɨkati'amemiwani, kemɨ'ane mɨtiyumemiwani, 'itsɨkame hetsiena 'apɨrahɨpani”.  
\v 22 Ne matsi mɨpaɨ nepɨtixekɨhɨawe, kemɨ'ane miheka yu'iwa, 'itsɨkame hetsiena pɨrahɨani. Kemɨ'ane 'axamɨtikɨhɨaweni yu'iwa, mɨkɨtsie mepɨte'uhɨpani ta'ukiyarima. Kemɨ'ane mɨpaɨ mɨtitahɨawe: “Kari pepɨka'amate”. Mɨkɨ panutahɨiyani tai yamɨtita'atsie.   
\p
\v 23 »'Ayumieme xɨka 'a'imikieri pe'atɨani mɨrayutimawatɨre, mana xɨka pehaye'erieni kename 'a'iwa tixaɨtɨkɨ 'aixɨa kamatixeiya,  
\v 24 mana mɨrayutimawatɨre keneuku'eirieka 'a'imikieri. Kenemie meri, 'aixɨa xeteyuxeiyatɨ xekenakɨni yu'iwamatɨ, 'anake muwa pe'ayeneme keneutimawa.   
\p
\v 25 »Kwitɨ kenehamikutani kemɨ'ane mɨmatsixaneta mexi huyeta pe'umie hamatɨana, kapa matsiyetuanikɨ 'itsɨkame hetsɨa matsixanetame, 'itsɨkame kapa matsiyetuanikɨ tupiri hetsɨa, kapa pe'anutahɨiyanikɨ.  
\v 26 Yurikɨ mɨpaɨ nekanaineni, muwa pepɨkawayeyani mexi pekati'atuawe naimekɨ.   
\s1 Ketsutsi kemutayɨ, kemɨ'ane mikumaɨwa xeime 'ɨyaya xeime kɨnaya hepaɨtsita  
\p
\v 27 »Xepɨ'enana kename mɨpaɨ mete'utahɨawarie: “Xeime 'ɨyaya kɨnaya pepɨkakumaɨwani”.  
\v 28 Ne matsi mɨpaɨ nepɨtixekɨhɨawe, kemɨ'ane mixeiya 'uka 'ihiwe'erietɨ, mɨkɨ kanikumaɨwani yu'iyaritsie.  
\v 29 'Ayumieme, xɨka 'ahɨxi 'atserieta miemekɨ xɨka 'axapetiyurieneni, keniwatitu'i meta kenehɨwa. Matsi 'aixɨa pɨyɨni tixaɨtɨ mɨreuyewenikɨ 'awaiyaritsie mieme, kapa pe'axewitɨ peheukahɨiyanikɨ xatsi taiyariyaritsie.  
\v 30 Meta, xɨka 'amamá 'atserieta mieme matsihekahɨpani, kenewayewiteki meta kenehɨwa. Matsi 'aixɨa kaniyɨmɨkɨ pemɨwayepurunikɨ, kapa pe'axewitɨ peheukahɨiyanikɨ xatsi taiyariyaritsie.   
\s1 Ketsutsi kemutayɨ, 'eiriya hepaɨtsita  
\p
\v 31 »Mɨpaɨta mepɨte'utahɨawarie meripaitɨ: “Kemɨ'ane yu'ɨya muku'eiri, 'eiriya xapayari ke'ihuritɨani”.  
\v 32 Peru ne matsi mɨpaɨ nepɨxerahɨawe, kemɨ'ane miku'eiri yu'ɨya, mɨkɨ xeime kɨnaya kumaɨwame kanayeitɨani yu'ɨya, mexɨka 'uka 'uki 'ukumayɨani mɨkayɨkɨna xeikɨa. Kemɨ'ane mitiwitɨni 'uka muku'eiriwaxɨ, mɨkɨta pikumaɨwani xeime 'ɨyaya.   
\s1 Ketsutsi kemutayɨ, memɨyɨhɨritɨa wahepaɨtsita  
\p
\v 33 »Mɨkɨ meta, xepɨ'enana kename meripai miemetexi mɨpaɨ metekɨhɨawarɨwakai: “Pepɨka'ahɨritɨani peti'itawatɨ, matsi kepemɨti'ahɨritɨa yapepɨtikamieni Ti'aitame matsixeiyakaku”.  
\v 34 Ne matsi mɨpaɨ nepɨtixekɨhɨawe: Yemekɨ xepɨkayɨhɨritɨaka. Taheima mieme muyuawi xexatatɨ xepɨkayɨhɨritɨaka Kakaɨyari muwa yu'uwenitsie 'akaitɨ mɨti'aitakɨ.  
\v 35 Kwie xexatatɨ xepɨkayɨhɨritɨaka kwie 'uwenieyatɨa mieme ketayatɨa mieme mɨhɨkɨkɨ. Kerutsareme xexatatɨ xepɨkayɨhɨritɨaka ti'aitame mɨtɨrɨkaɨye kiekarieya mɨhɨkɨkɨ.  
\v 36 'Amu'u pexatatɨ pepɨka'ahɨritɨaka pemɨkayɨwekɨ tuxame yɨwime pemeyeitɨanikɨ nixei kɨpayari.  
\v 37 Xɨka xeyuwaɨriyani, “huu” xekeneutiyuaneni xeikɨa, mexɨka xekayuwaɨriyani, “tixaɨ” xekeneutiyuaneni. Tawari xeiniukiyari panayuhayewa, kemɨ'ane 'axamɨtiyuruwa hetsɨa kanimiemetɨni.   
\s1 Ketsutsi kemutayɨ, 'axamemɨwayurie 'axame'u'itɨarieka wahepaɨtsita  
\p
\v 38 »Xepu'enana kename mɨpaɨ metekɨhɨawarɨwakai: “Xɨka xeime hɨxieya watituni mɨkɨta hɨxieya kewatituiyani meta tameya xɨka 'anaye'una mɨkɨta ke'anaye'uniyarieni”.  
\v 39 Ne matsi mɨpaɨ nepɨtixekɨhɨawe: Mɨpaɨ xeteyurietɨ xepɨka'inenaka kemɨ'ane 'axamɨxeyurie. Matsi kemɨ'ane 'a'auritapatsie mɨmatsikuwaya 'atserieta, ta'aurie pe'aweme keneupitɨa tapata.  
\v 40 Kemɨ'ane matsixanetatɨ mɨmatsinawairiemɨkɨ 'akamixa, keneuhuritɨa meta 'a'ɨkari.  
\v 41 Kemɨ'ane mɨmatsiwiya hetsiena mieme tixaɨtɨ pemɨranutɨnikɨ xeimiriyari keyari, huta miriyari keyari keneumieni 'utɨana.  
\v 42 Kemɨ'ane tixaɨtɨ mɨmatiwawirie, ketineupitɨa, kemɨ'ane mɨmatiniɨwiriemɨkɨ pepɨkatikweririeka.   
\s1 Kemɨtiwanaki'erieka mɨkɨ memɨtatsi'aye'unie  
\p
\v 43 »Xepɨ'enana kename mɨpaɨ metekɨhɨawarɨwakai: “'Ahepaɨ tewi kenenaki'erieka, pepi'uxiwe'erieka kemɨ'ane mɨmatsi'aye'unie”.  
\v 44 Ne matsi mɨpaɨ nepɨtixekɨhɨawe: Xekeniwanaki'erieka mɨkɨ memɨxe'aye'unie, xekeneyunenewieka mɨkɨ memɨxe'uweiya wahetsiemieme.  
\v 45 Mɨpaɨ xeyɨatɨ puyuritɨni yu'ukiyari taheima makawe niwemama xemɨhɨkɨkɨ. Mɨkɨ kanenatinenetɨwani yutau 'axamemɨteyurie wahetsie 'aixɨa memɨteyurie wahetsie. Wiyeri panakanɨ'awa mɨkɨ heitseriemekɨ yamemɨtekahu wahetsie mɨkɨ heitseriemekɨ yamemɨkatekahu wahetsie yaxeikɨa.  
\v 46 Xɨka xewanaki'erieka mɨkɨ memɨxenaki'erie, ¿kexete'a'iwa mɨkɨkɨ? Kamɨ, 'atsita mɨkɨ kuwiyexinutsie mieme tewawamete yaxeikɨa mepɨteyurie.  
\v 47 Xɨka yu'iwamarixi xewawaɨritɨaka hɨkɨa, titatsɨ xeteyurie hipatɨ yamemɨkateyurie. Kamɨ, mɨkɨ memɨkatateɨterima yaxeikɨa mepɨteyurie.  
\v 48 Xeme pɨta heitseriemekɨ yaxeketenekahuni, xe'ukiyari taheima makawe heitserie yamɨtikamie hepaɨ.   
\c 6  
\s1 Ketsutsi kemutayɨ, 'aixɨa memɨteyurie wahepaɨtsita  
\p
\v 1 »Xekeneyukweriwayurieka kapa kemɨtiheitserie xeteyurieka teɨteri wahɨxie, mɨkɨ memɨxexeiyakɨ xeikɨa. Mexɨka wahɨxie xeikɨa yaxeteyurieka, xe'ukiyari taheima makawe tixaɨtɨ pɨkatixepitɨani xe'iwarika.   
\p
\v 2 »Kepauka pemiparewi tixaɨtɨ mɨkarexeiya, kuxineta pepɨka'aitani 'ahɨxie mɨhɨtsieriekakɨ pemɨxeiyarienikɨ, tukita kaye 'utɨa kememɨteyurie mɨkɨ memɨte'itawamete, teɨteri 'aixɨa memutiyuanenikɨ wahepaɨtsita. Yurikɨ mɨpaɨ nekanaineni, 'ari meheixeiyatɨ mepakɨ yu'iwarika.  
\v 3 Matsi 'ekɨ pɨta kepauka pemɨwaparewie tixaɨtɨ memɨkatehexeiya, 'atsipepɨkatayɨni, 'amamá 'a'utata mieme 'atsipɨkatimaika kemɨtiyuriene 'atserieta mieme,  
\v 4 kepemɨtiuparewi mɨ'awiekakɨ. 'Ana 'a'ukiyari 'ixeiyatɨ tita mɨti'awietsie pɨmatipitɨani 'a'iwarika yunaime wahɨxie.   
\s1 Ketsutsi kemutayɨ nenewieri hepaɨtsita  
\r (Mat 6:9-13 – Ruk 11:2-4)  
\p
\v 5 »Kepauka xemɨyunenewie, mɨkɨ memɨte'itawamete wahepaɨ xepɨkayɨaka, pɨwanake tukipa memɨti'unikɨ meta 'itsikinatsie memɨti'unikɨ meyunenewietɨ teɨteri memɨwaxeiyanikɨ. Yurikɨ mɨpaɨ nekatinixehahɨaweni, 'ari meheixeiyatɨ mepakɨ yu'iwarika.  
\v 6 'Ekɨ pɨta kepauka pemɨ'anenewie 'akiita keneutahaka, kitenie pereuname, nenewieri kenepitɨaka 'a'ukiyari mana muyeika muye'awietsie. 'A'ukiyari 'ixeiyatɨ tita mɨti'awietsie pɨmatipitɨani 'a'iwarika yunaime wahɨxie.  
\v 7 Xeyunenewietɨ xepɨka'imɨiriyani niuki hipame nuiwarite wahepaɨ. Mɨkɨ waɨkawa me'utiniutɨ, me'enierienike mepɨyu'erie.  
\v 8 Wahepaɨ xe'anenetɨ xepɨka'akɨne. Kakaɨyari mɨxe'ukiyari yapɨtimate tita xemɨteheuyehɨwa, yaxekate'itawawiriewawekaku 'akuxi.   
\p
\v 9 »'Ayumieme 'ipaɨ pɨta xeketeneyunenewieka xeme:  
\q1 »“Ta'ukiyari taheima pemakawe,  
\q1 yuhemekɨ mɨpatsie peke'ayeitɨariwani,   
\q1
\v 10 'enata keneutsutɨa peti'aitatɨ,  
\q1 yameketeyurieka kemɨmatinake  
\q2 'ena kwiepa taheima kememɨteyurie.   
\q1
\v 11 'Ikwai ketaneumikwa hikɨ temeiyehɨwa.   
\q1
\v 12 Ketatineuyehɨwirieka 'axatemɨte'uyurikɨ  
\q1 tameta temɨtewareuyehɨwirikɨ mɨkɨ 'axamemɨtatsi'uyuri.   
\q1
\v 13 Pepɨkatatsipitɨaka temɨta'inɨatsienikɨ,  
\q1 matsi ketaneutawikweitsitɨa 'axatemɨka'itɨarienikɨ.  
\q1 'Ekɨtsɨ 'aheyemekɨ pekatini'aitametɨni pekanitɨrɨkaɨyeni witsipekani'aneni 'aheyemekɨ.  
\q1 Mɨpaɨ xeikɨa kani'aneni”.   
\p
\v 14 »Xɨka xetewareuyehɨwirieni teɨteri 'axamemɨxeyurie, xe'ukiyari muyuawitsie makawe pɨxereuyehɨwirieni xemeta.  
\v 15 Peru, xɨka xekatewareuyehɨwirieni teɨteri, xe'ukiyari pɨkaxereuyehɨwirieni xemeta 'axaxete'uyurieyu.   
\s1 Ketsutsi kemutayɨ hakiya hepaɨtsita  
\p
\v 16 »Kepauka xemɨyuhakiwa mɨkɨ memɨte'itawamete wahepaɨ xepɨkayɨaka. Mɨkɨ yuheiweriekate wahepaɨ meteyuxexeiyame mepayuyeitɨwa, meta yuhakiwamete wahepaɨ teɨteri memɨwaxeiyakɨ. Yurikɨ mɨpaɨ nepɨxerahɨawe, mɨkɨ 'ari meheixeiyatɨ mepakɨ yu'iwarika.  
\v 17 'Ekɨ pɨta kepauka pemɨ'ahakiwa, kene'akawiri witsimu'ɨa 'amu'utsie, kenanaka'ɨtaima,  
\v 18 tiyuhakiwame hepaɨ pemɨkati'axexeiyanikɨ, teɨteri kemematexeiya. 'A'ukiyari mana muyeika muye'awietsie, mɨkɨ pɨta kematixeiya pepɨmatsiɨkɨni. 'A'ukiyari 'ixeiyatɨ tita mɨti'awietsie, mɨkɨ pɨmatipitɨaka 'a'iwarika yunaime wahɨxie.   
\s1 Kemɨtiti'uta taheima mieme  
\r (Mat 6:22-23 – Ruk 11:34-36)  
\p
\v 19 »Xeketeneuhayewa kwiepa timieme piinitɨarika xetexeɨrietɨ xeikɨa. Kwiepa timieme tekɨmemete mepɨtetikɨme meta pɨtiyutikwitamawa, metatsiere tenawayamete mepɨyɨwawe mɨkɨ memɨtenawani.  
\v 20 Taheima mieme matsi piinitɨarika xeketenexeɨrieka. Mana tekɨmemete mepɨkatehetikɨme meta pɨkareyutikwitamawa, metatsiere tenawayamete mepɨkaheutahake memɨtenawanikɨ.  
\v 21 Hakewa pemɨrekuxeɨri piinitɨarika, manata 'a'iyari puyeikani.   
\p
\v 22 »Tahɨxi tawaiyari kɨxemeya kanihɨkɨtɨni. 'Ayumieme xɨka 'ahɨxi yuxewini 'aixɨa 'aneni, 'awaiyaritsie naitɨ pepɨhekɨariwiyarieka.  
\v 23 Mexɨka 'ahɨxi 'axa'aneni peti'akahiwe'eriekaku, 'awaiyaritsie pekaniyɨriyariekamɨkɨ. Merikɨte, 'akɨxeme xɨka 'uyɨre, yemekɨ pepɨyɨriyarieni.   
\p
\v 24 »Tewi pɨkayɨwe yuhutame yukutsiyarima wahetsie tiwiyatɨ mɨti'uximayaka. Ni'uxiwe'eriekamɨkɨ xeime 'inaki'erietɨ xeime, yatɨni matsi xeime waɨkawa ninaki'eriekamɨkɨ xeime xani'erietɨ. Pɨkayɨwe xemɨte'uximayaka Kakaɨyari hetsie xetewiyatɨ meta yupiinitɨarikatsie xetewiyatɨ.   
\s1 Kakaɨyari kemɨtiwa'ɨwiya yuniwema  
\r (Mat 6:25-33 – Ruk 12:22-31)  
\p
\v 25 »'Ayumieme mɨpaɨ nepɨtixekɨhɨawe: Xeketeneuhayewa xeyu'iyaritɨatɨ yutukari hepaɨtsita, tita tetekwani tita tete'ieni xeteyukɨhɨawetɨ, yuwaiyari hepaɨtsita xepɨkayu'iyaritɨaka tita tete'anakatɨxɨani xeteyukɨhɨawetɨ. ¿Tukari matsi waɨkawa kareuyewetse keyuri 'ikwai meta xewaiyari keyuri kemari?  
\v 26 Xekeniwaru'ixɨari wikixi taheima miemete: Mepɨka'uka'etsa mepɨka'uka'itsana, kaxetunitsie mepɨkateti'uta. Mɨyatɨtɨ, xe'ukiyari taheima makawe pɨtiwamikwa. Merikɨte, xeme matsi waɨkawa xepeuyewetse keyuri mɨkɨ.  
\v 27 ¿Xeme kemɨ'ane pɨyɨwe yu'iyaritɨatɨ 'a'utewitɨ mayuyeitɨani xɨka 'etsi'utewini, xeitsikuriyari manawere?   
\p
\v 28 »¿Meta titayarikuta xeteyu'iyaritɨa 'ixuriki hepaɨtsita? Xekeneuxeiya tuturi texuxuri 'ɨtsita mieme kemɨtiuwawere. Pɨkati'uximaya pɨkawita,  
\v 29 peru mɨpaɨ nepɨxerahɨawe, Tsarumuni tsepa naimekɨ mariwetɨ mayuyeitɨwakai witsipɨkatiyukemaritɨwakai texuxuri hepaɨ.  
\v 30 Xɨka Kakaɨyari mɨpaɨ tikemaritɨaka tupiriya hikɨ 'ɨtsita meuti'u meta 'uxa'a huxunuta meukawiwiyani, matsi yemekɨ katixekemaritɨaka xeme, teɨteri 'etsiwa xeikɨa yuri xemɨte'erie.  
\v 31 'Ayumieme xepɨkayu'iyaritɨaka 'ipaɨ xe'utiyuatɨ: ¿Titari tetekwaka? ¿titari tete'ieka? ¿titakɨ tetetakemaritɨaka?  
\v 32 Mɨkɨ memɨkatateɨterima mepiwautɨwe mɨkɨ naime, peru xe'ukiyari taheima makawe yapɨtimate kename xeteuyehɨwa 'ikɨ naime.  
\v 33 Xeme matsi xekeneyuwaɨriyani mɨkɨ tixe'aitɨwame mɨhɨkɨtɨnikɨ, heitseriemekɨ yaxemɨtekahunikɨ, mɨpaɨ xeteyurietɨ, xepɨtemikienita mɨkɨ naime.  
\v 34 'Ayumieme xepɨkayu'iyaritɨaka 'uxa'a miemekɨ, 'uxa'ata peixeiyani 'iyaritɨarika. Xexuitɨ tukari peixeiyari 'axamɨti'ane.   
\c 7  
\s1 Hipame wahetsie xepɨkate'uhɨpani  
\r (Mat 7:3-5 – Ruk 6:41-42)  
\p
\v 1 »Hipame wahetsie xepɨkate'uhɨpani, xemeta xehetsie mɨkarahɨiwanikɨ.  
\v 2 Hipame wahetsie kexemɨte'uhɨpa, mɨpaɨta xeme xehetsie pɨrahɨiyani, kexemɨtewa'inɨatsirie hipame, yaxeikɨata xeme mɨpaɨ xepɨte'inɨatsiyarieni.   
\p
\v 3 »¿Titayari kwi petixeiya xatsi 'a'iwa hɨxita meutawiwi, pekahe'eriwatɨ keuruwi 'ekɨ 'ahɨxita meutawe?  
\v 4 ¿Pepɨkayɨwe mɨpaɨ pemɨtitahɨawe 'a'iwa: “Xatsi 'ahɨxita meutawiwi nepɨmatsiwaye'itirieni”, keuruwi 'akuxi 'ekɨ 'ahɨxita yeyeikakaku?  
\v 5 Yakɨ peputaine xeikɨa. 'Ahɨxita meri keniwayehɨwa keuruwi, mɨpaɨke 'aixɨa pereunieretɨ pekanayeimɨkɨ pemiwaye'itirienikɨ xatsi 'a'iwa hɨxita meutawiwi.   
\p
\v 6 »Tita Kakaɨyaritsie mieme mɨtipatsie xepɨkatewamikwani tsɨikɨri, kuka kwinie mɨraye'atɨka tuixuri wahɨxie xepɨkatixɨrɨwani, nɨka me'itiketsinikɨ, nɨka ta'aurie me'axɨrieme mexe'utitsanakɨ tsɨikɨri.   
\s1 Xeketeneuta'iwau, xeketenekuwawa, 'itupari xekeneuyuitɨa  
\r (Mat 7:7-11 – Ruk 11:9-13)  
\p
\v 7 »Xekatehayewatɨ xɨka xete'uta'iwauni, yaxepɨtemikieni. Xɨka xetekuwautɨweni xekatehayewatɨ, yaxepɨte'itaxeiya, 'itupari xɨka xe'uyuitɨani xekatehayewatɨ, xepɨteheuyepiyarieni.  
\v 8 Kemɨ'ane mɨtiku'iwawa pɨtiyetuiriyarɨwa yu'iwaurika, kemɨ'ane mɨtikuwaune pɨtikaxeiya, kemɨ'ane 'itupari mukuyuitɨwa pɨreuyepiyarɨwa.   
\p
\v 9 »Xewitɨ pɨkayuwaɨriya tete yuniwe mumini, mɨkɨ paa ha'iwawakaku.  
\v 10 Meta pɨkayuwaɨriya kuu mimini tsaapa ha'iwawakaku.  
\v 11 Xeme 'axaxete'u'iyaritɨtɨ, 'aixɨa 'anemekɨ xɨka xetewamikwani yuniwema, matsi waɨkawamekɨ xe'ukiyari taheima makawe 'aixɨa ti'aneme katiniwamimɨkɨ kemɨ'ane memɨte'itawawirieni.  
\v 12 'Ayumieme xeme hipame teɨteri yaxeketeniwaxeiyani, mɨkɨ kememɨtexexeiyanikeyu xeme. Mɨpaɨ tiyurienetɨ kanitaxewiriyamɨkɨ 'inɨari niukiyari meta Kakaɨyari niukametemama waniuki.   
\s1 Kitenie 'etsimayewa  
\p
\v 13 »Kitenie 'etsimayewatsie xekeneutahaxɨa. Karikɨ 'ekanayeuka kitenie, 'ekanatayeuka huye hakewa memeuyexɨrɨwe meukayune, mepɨyumɨire mana memeutahake.  
\v 14 Peru 'etsipayewa kitenie meta 'itsipatayewa huye tukaritsiepai meutiyune, hipatɨ xeikɨa mepikaxexeiya.   
\s1 Kɨye kemɨtimatsiɨkɨ yu'ikwaxitsie  
\p
\v 15 »Xekeneyukweriwayurieka Kakaɨyari niukametemama memɨte'itawa wahepaɨtsita. Xehetsɨa mepeutahake muxatsi wahepaɨ meteyuxexeiyatɨ, matsi yutaɨta mepɨ'ɨrawetsixi pɨta memɨtenawaya.  
\v 16 Kememɨte'ukaxuxuawere xepɨwaretimani kememɨ'anene. ¿Kaxie tika'inɨiwa xuyatsie. Piní takari tika'inɨiwa witsaxatsie?  
\v 17 Naitɨ 'iteɨri 'aixɨa mɨ'anene 'ikwaxi 'aixɨa 'anenetɨ pukaxuxuawere. Peru 'iteɨri 'axamɨ'anene 'ikwaxi 'axa'aneneme pexeiya.  
\v 18 'Iteɨri 'aixɨa mɨ'ane pɨkayɨwe 'axamɨtiutixuxuawereni, meta 'iteɨri 'axamɨ'ane pɨkayɨwe 'aixɨa mɨtiutixuxuawereni.  
\v 19 Naitɨ 'iteɨri 'aixɨa mɨkatiutixuxuawere kanawitewani, taipa kaneuxɨriwani.  
\v 20 'Ayumieme kememɨte'ukaxuxuawere xepɨwaretimani.   
\p
\v 21 »Mɨkɨ mɨpaɨ memɨnetekɨhɨawe: “Ti'aitame, Ti'aitame 'aku”, yunaitɨ mɨkɨ mepɨkaheutahaxɨani hakewa mɨre'aita taheima makawe. Matsi xeikɨa kemɨ'ane yamemɨtekahu kemɨtinake ne'ukiyari taheima makawe.  
\v 22 Mɨkɨ tukaritsie yumɨiretɨ mɨpaɨ mepɨnetetahɨawe: “Ti'aitame, Ti'aitame 'aku, tame 'ahetsiemieme tetenikuxatakaitɨni, 'ahetsiemieme kakaɨyarixi 'axamemɨ'anene tepɨwarayenɨ'axɨa, 'ahetsiemieme mariwemekɨ tepɨteyuriekai”.  
\v 23 'Ana ne mɨpaɨ nepɨtiwatahɨawe: “Hatsuaku nepɨkaxehetima. Xekeneuyupata nehetsɨa xepɨka'u'uwani, xeme 'axateyuruwamete”.   
\s1 Tsimiyenitu 'aixɨa mɨ'ane 'axamɨ'ane  
\r (Mat 7:24-27 – Ruk 6:47-49)  
\p
\v 24 »'Ayumieme, kemɨ'ane mi'enie 'ikɨ neniuki kenemutayɨ, meta yamɨtikatɨa mɨkɨ tewi mɨtimaiwepaɨ kani'aneni, mɨkɨ kaniyutakitɨani tetetsie.  
\v 25 'Ukawiyeku, hatuxame wayeneku, 'uku'ekaku, mɨkɨ kitsie 'ukexɨaku 'eka, kii pɨkahatiwe, tetetsie mutiwiyakaikɨ tsimiyenituyari.  
\v 26 Peru kemɨ'ane 'i'enietɨ neniuki yamɨkatikamie, mɨkɨ tewi 'atsimɨkatimate hepaɨ kani'aneni xiekaripa muyutakitɨa hepaɨ.  
\v 27 'Ukawiyeku, hatuxame wayeneku, 'uku'ekaku, mɨkɨ kitsie 'ukexɨaku, kanatiweni, naitɨ 'unitɨ 'anetɨ kaniukeni».   
\b  
\p
\v 28 Hikɨ Ketsutsi kepauka minɨ 'ikɨ xatsika, teɨteri mekaniuhɨxiyani 'ɨkitsikayakɨ,  
\v 29 kemɨ'ane heitserie mexeiya hepaɨ mɨtiwa'ɨkitɨakaikɨ, mɨkɨ 'inɨarikɨ memɨte'ɨkitakai wahepaɨ pɨkati'ɨkitakai.   
\c 8  
\s1 Ketsutsi kemɨrenayehɨa tewi nawi kwiniyayari mexeiyakai  
\r (Mat 8:2-4 – Mar 1:40-45, Ruk 5:12-16)  
\p
\v 1 Merikɨtsɨ kepauka yemuritsie makane, teɨteri yumɨiretɨ mekaniweiyakaitɨni.  
\v 2 Hikɨ tewi nawi kwiniyayari mexeiyakai hetsɨana nuaka hɨxiena 'utitunumakeka mɨpaɨ katinitahɨawe:  
\p —Ti'aitame, xɨka pe'awaɨriyani, pepɨyɨwe pemɨnetsi'itieni.   
\p
\v 3 Ketsutsi yumamá 'utatseraka kanimayɨani, mɨpaɨ 'utaitɨ:  
\p —Nepɨnewaɨriya. Pekaniu'itiyaniri.  
\p Hikɨ yapauka kwiniyaya neunuani, 'itiyatɨ kanayani.  
\v 4 Hikɨ Ketsutsi mɨpaɨ katinitahɨawe:  
\p —Neuxei, xeimetɨma pepɨkaraxaxatɨwani, mawari wewiwame hetsɨa pɨta kenemie kene'ahekɨata matsihexeiyakɨ, meta 'imikieri kenanutimawa kemɨtiu'aitaxɨ Muitsexi yapemɨtiwatahekɨatɨanikɨ.   
\s1 Kuyaxi tiwa'aitɨwame yuri kemɨti'eriekai  
\r (Mat 8:5-13 – Ruk 7:1-10)  
\p
\v 5 Merikɨtsɨ Kaperunaume kiekariyaritsie heutahaku kuya hetsɨana kaninuani xeitsienituyari kuyaxi tiwa'aitɨwame, mɨkɨ waɨriyarika kanipitɨani  
\v 6 mɨpaɨ 'utaitɨ:  
\p —Ti'aitame 'aku, neti'uximayatsiriwame nekiita payeka hurietɨ kwiyɨanetɨ kwiniyakɨ.   
\p
\v 7 Ketsutsi mɨpaɨ katinita'eiya:  
\p —Ne nekanimieni 'aixɨa reu'eriekame nemayeitɨanikɨ.   
\p
\v 8 Kuya rehɨawe:  
\p —Ti'aitame, 'aixɨa nepɨka'ane nekiita pemeutahanikɨ, niukikɨ xeikɨa yakeneutayɨki, mɨkɨkɨ panayehɨiyani neti'uximayatsiriwame.  
\v 9 Netatsiere nekatini'aitɨarieka nekuyatɨtɨ, meta kuyaxi nepɨtiwa'aitɨwame. Xɨka mɨpaɨ netitahɨawe xeime: “Kenemie”, mɨkɨ pɨyemie. Xeimeta mɨpaɨ xɨka netiutahɨawe: “Kenaye'a”, mɨkɨ kanayeimɨkɨ. Xɨka mɨpaɨ netitahɨawe neti'uximayatsiriwame: “'Ipaɨ ketineyurieneni”, mɨkɨ mɨpaɨ pɨtiyurieni.   
\p
\v 10 Ketsutsi 'i'enieka nihɨxiyakaitɨni, mɨpaɨ katiniwarutahɨawe mɨkɨ memikuweiyatɨwekai:  
\p —Yurikɨ mɨpaɨ nepɨxerahɨawe, nixeime tɨma 'ixaheritsixi watsata 'ikɨ hepaɨ 'aneme nepɨkakaxeiyawe yuri ti'eriekame.  
\v 11 Mɨpaɨ nepɨtixekɨhɨawe, yumɨiretɨ mekani'axɨakuni tau manatineika hepatsie kiekatari meta makayuyuipike hepatsie kiekatari, 'Apɨrahami, 'Itsahaki meta Kakuwu wahamatɨa mekaniutiyaxikuni hakewa mɨre'aita taheima makawe.  
\v 12 Peru mɨkɨ mana memeutahaxɨanikekai mɨpaɨ 'ayumieme memutinunuiwakai, mɨkɨ mekananuyexɨriyakuni takwa yɨwipa yemekɨ memu'uwanikɨ, mana meniutitsuanakuni meniyutakewekuni.   
\p
\v 13 Hikɨ Ketsutsi mɨpaɨ kuyaxi tiwa'aitɨwame katiniutahɨawe:  
\p —Kenemie. Yuri kepemɨti'erie, mɨpaɨ pɨtiyɨni. 'Anatɨtɨ 'aixɨa reu'erietɨ kanayani ti'uximayatame mɨkɨ hurayaritsie.   
\s1 Yumɨireme kemɨtiwaranayexɨri  
\r (Mat 8:14-16 – Mar 1:29-34, Ruk 4:38-41)  
\p
\v 14 Hikɨ kepauka Ketsutsi Pekuru kie munua, warɨkaɨya kaniuxeiya yu'utatsie kakaime hɨiyakame.  
\v 15 Mamayatsie kanimayɨani, hikɨ hɨiya kanihayewa. Hikɨ mɨkɨ 'anukukeka katiniwarumini.   
\p
\v 16 Hikɨ taikai, mekani'atɨirieni yumɨireme teɨteri kakaɨyarixi 'axamemɨ'anene memɨwawiyakai, hikɨ kakaɨyarixi niwarayenɨ'ani xeiniukiyarikɨ, 'ana yunaime 'aixɨa meteheu'eriekame kaniwarayeitɨani memɨtekukuyekai.  
\v 17 Mɨpaɨ tiuyurieku, paye'a Kakaɨyari niukameya Kitsariyaxi kemutayɨ:  
\q1 «Mɨkɨtɨtɨ kataniunawairieni takwiniya, meta takukuiniya petɨ».   
\s1 Kemɨtikwaniwe Ketsutsi muweiyanikɨ  
\r (Mat 8:19-22 – Ruk 9:57-62)  
\p
\v 18 Merikɨtsɨ Ketsutsi waxeiyatɨ teɨteri kememɨteyuxeɨriekai 'auriena yumɨiretɨ, kaniuyuta'aita harakuna 'anutaɨye paitɨ manutuiyanikɨ.  
\v 19 Hikɨ xewitɨ 'inɨarikɨ mɨti'ɨkitametɨkai hetsɨana nuaka, mɨpaɨ katinitahɨawe:  
\p —Ti'ɨkitame 'aku, 'ahetsie nekatiniwiyamɨkɨ, hakewa pemeyemie neta nekaniyemieni 'a'utɨma.   
\p
\v 20 Ketsutsi mɨpaɨ katinita'eiya:  
\p —Kauxaitsi yuterɨ mepexeiya, wikixi yu'itua mepexeiyata, peru ne, Yuri Tewi kenemɨtitewa, nepɨkaheixeiya hakewa nemeyukamuritɨani.   
\p
\v 21 Xewitɨta tiyu'ɨkitɨwame mɨpaɨ katinitahɨawe:  
\p —Ti'aitame, keneneupitɨa meri nemɨyemiekɨ nepaapa nemɨteukimiekɨ.   
\p
\v 22 Ketsutsi mɨpaɨ katinitahɨawe:  
\p —Nehetsie ketineuwiya, mɨkite keniwaruhayewa, mɨkɨ mɨkite yuhetsɨa miemete mekewarukateuku.   
\s1 Ketsutsi 'eka kemɨreunuitɨa  
\r (Mat 8:23-27 – Mar 4:35-41, Ruk 8:22-25)  
\p
\v 23 Merikɨtsɨ kanuwatsie kayerɨka Ketsutsi meta teyɨ'ɨkitɨwametemama yunaitɨ mekanekɨne.  
\v 24 Hikɨ harakunatsie me'uyehukaku kaniuyutawewieni 'eka waɨkawa tɨrɨkaɨyetɨ hikɨ hamewari kanuwatsie kanakayeuriwekaitɨni. Ketsutsi matsi kanikutsukaitɨni.  
\v 25 Hikɨ teyɨ'ɨkitɨwamete hetsɨana me'u'axɨaka mekanenutahɨtɨani, mɨpaɨ me'utiyuatɨ:  
\p —Ti'aitame, ketaneutawikweitsitɨa, tepeuyewexime.   
\p
\v 26 Mɨkɨ mɨpaɨ katiniwarutahɨawe:  
\p ―Teɨteri 'etsiwa xeikɨa yuri xemɨte'erie, ¿titayari xetemama waɨkawa?  
\p Hikɨ 'anukukeka 'eka kaniutatieni meta hamewari, hikɨ naitɨ kayuwatɨ kaniutamare.   
\p
\v 27 Hikɨ mɨkɨ teyu'ɨkitɨwamete mekanihɨxiyakaitɨni, mɨpaɨ me'utiyuatɨ: «¿Tita tewiyari tihɨkɨ 'ikɨ, 'atsita 'eka meta hamewari memei'enie?»   
\s1 Kakaɨyarixi kememɨtewawiyakai Katarenatari  
\r (Mat 8:28-34 – Mar 5:1-20, Ruk 8:26-39)  
\p
\v 28 Merikɨtsɨ 'anutaɨye paitɨ heta'aku Ketsutsi, katarenatari wakwietsie paitɨ, yuhutatɨ teɨteri kakaɨyarixi 'axamemɨ'anene memɨwawiyakai teukiyapa mehayenexɨaka mekanenukunake. Kwinimieme metenayu'eririyakaitɨni, 'ayumieme hipatɨ mepɨkayuwaɨriyakai mana memuyekɨnekɨ.  
\v 29 Merikɨtsɨ mɨkɨ mɨpaɨ mekatenihiwieni:  
\p —¿Ketita perayexeiya, Kakaɨyari nu'aya? ¿'Ena petinua petatsi'uximatɨanike tukari ka'aye'awekaku 'akuxi?   
\p
\v 30 Merikɨtsɨ mana memanu'uwakaitsie yatewa mekatenikwatɨwekaitɨni tuixuri yumɨiretɨ.  
\v 31 Kakaɨyarixi 'axamemɨ'anene menitawawirieni mɨpaɨ me'utiyuatɨ:  
\p —Xɨka petatsi'ayenɨ'amɨkɨ, ketaneupitɨa tuixuri temɨwawiyakɨ.   
\p
\v 32 Mɨpaɨ katiniwarutahɨawe:  
\p —Xekenehu.  
\p Hikɨ mɨkɨ mekanayekɨne teɨteri wahetsie tuixuri wahetsie pɨta mekaneutahaxɨani, hikɨ yunaitɨ tuixuri mekaniutinautsa tekɨata mekaneukaxɨrieni harakunapa, hapa mekaniukwini.   
\p
\v 33 Hikɨ tuixuri wahɨwemete mekaniyuta'una, hikɨ kiekaritsie me'uxɨaka naime mekateniutaxata meta kakaɨyarixi 'axamemɨ'anene memɨwawiyakai kememu'itɨariekai.  
\v 34 'Ayumieme yunaitɨ teɨteri kiekatari mekanayekɨne Ketsutsi me'anukunakeke. Hikɨ kepauka memixei waɨriyarika mekanipitɨani mɨyemiekɨ wakwiepa mɨka'uyeikanikɨ.   
\c 9  
\s1 Ketsutsi kemɨrenayehɨa huriekame  
\r (Mat 9:2-8 – Mar 2:3-12, Ruk 5:18-26)  
\p
\v 1 Merikɨtsɨ kanuwatsie kayerɨka 'anutaɨye paitɨ kaneyani, yukiekaritsie kaninuani.  
\v 2 Hikɨ mana hipatɨ teɨteri huriekame mekani'atɨirieni 'itaritsie yekaime. Ketsutsi waxeiyatɨ yuri kememɨte'eriekai mɨpaɨ huriekame katiniutahɨawe:  
\p —Yukɨ pepɨkati'akɨhɨaweni, nehamiku, 'ari pepɨreuyehɨwiyarie 'axapemɨtiuyurikɨ.   
\p
\v 3 Hikɨ hipatɨ 'inɨarikɨ memɨte'ɨkitametetɨkai mɨpaɨ mekateniyukɨhɨawekaitɨni yu'iyaritsie: «'Ikɨ Kakaɨyari hepaɨtsita 'axaputaine.»   
\p
\v 4 Ketsutsi wa'iyaritɨarika maitɨ, mɨpaɨ katiniwarutahɨawe:  
\p ―¿Titayari 'axaxeteyukɨhɨawe yu'iyaritsie?  
\v 5 ¿Tita matsi katikwaniwe: “Pepɨreuyehɨwiyarie 'axapemɨtiuyurikɨ”, xɨka'utayɨni, nutsu: “Kenanukukexi kenekuyeikani, xɨka'utayɨni”?  
\v 6 Hikɨtsɨ ya'aneme xekanetimaikuni kename heitserie nehexeiya kwiepa nemɨtiwareuyehɨwirienikɨ 'axamemɨte'uyuri, Yuri Tewi nehɨkɨtɨtɨ.  
\p Hikɨ mɨpaɨ katinitahɨawe huriekame:  
\p —Kenanukukexi, 'a'itari kenakwetɨ, 'akie kenemie.   
\p
\v 7 Hikɨ tewi 'anukukeka yukie kaneyani.  
\v 8 Teɨteri me'ixeiyaka waɨkawamekɨ mekanimamakaitɨni, 'aixɨa mekaniutiyuanekaitɨni Kakaɨyari hepaɨtsita, heitserie mɨwarupitɨakɨ teɨteri mɨpaɨ memɨteyurienikɨ.   
\s1 Mateu kemɨtiuta'ini  
\r (Mat 9:9-13 – Mar 2:14-17, Ruk 5:27-32)  
\p
\v 9 Hikɨ kepauka Ketsutsi mana mɨyetɨa, xeime tewi kaniuxeiya Mateu titewakame mana memɨte'ayutituayatsie 'akaime. Mɨpaɨ katinitahɨawe: «Nehetsie ketinewiyani». Mateu 'anukukeka hetsiena katiniuwiya.   
\p
\v 10 Hikɨ Ketsutsi katinikwakaitɨni kiita, yumɨiretɨ kuwiyexinu hetsiemieme tewawamete meta 'axateyuruwamete, me'u'axɨaka Ketsutsi matɨa meta teyɨ'ɨkitɨwametemama wahamatɨa metenikwakaitɨni 'axeikɨa.  
\v 11 Kepauka paritseutsixi memɨwaruxei mɨkɨ, mɨpaɨ mekateniwarutahɨawe teyɨ'ɨkitɨwametemama:  
\p —¿Titayarikuta tewawamete meta 'axateyuruwamete wahamatɨa tixe'ɨkitɨwame tikwa'a?   
\p
\v 12 'Ikɨ tiu'enieka, Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —'Aixɨa memɨteheu'erie mepɨkaheiyehɨwa tiyu'uayemawame, mɨkɨ memɨtekukuye pɨta mekaneiyehɨaka.  
\v 13 Peuyewetse 'akuxi yaxemɨtehetimanikɨ kemaine mɨkɨ niuki mɨpaɨ manuyɨne: “Ne nepɨxewawirie xeketeneuyukanenimayaka, nepɨkaxewawirie mawari”. Ne nepɨkanua newata'inienike mɨkɨ heitseriemekɨ yamemɨtekahu, mɨkɨ 'axamemɨteyurie pɨta newata'inienike nekaninuani.\f + \fr 9:13 \ft RV60 meta hipatɨ mepenanɨitɨa \fq memɨtehayewakɨ ke'axamemɨteyuriekai.\f*   
\s1 Kemɨtiuta'iwawiyarie hakiya hepaɨtsita  
\r (Mat 9:14-17 – Mar 2:18-22, Ruk 5:33-39)  
\p
\v 14 Hikɨ Wani hetsɨa miemete teyɨ'ɨkitɨwamete Ketsutsi hetsɨa me'u'axɨaka mɨpaɨ mekatenita'iwawiya:  
\p —¿Titayari tame meta paritseutsixi tete'utatihakiwa, peru 'ahetsɨa miemeteta teyɨ'ɨkitɨwamete titayari hawaikɨ?   
\p
\v 15 Ketsutsi mɨpaɨ katiniwaruta'eiya:  
\p —¿Neɨkiyapa kemeteyɨwawe neneɨkeme 'inierimama memɨyuheiwerieka mexi neneɨkeme wahamatɨa 'uyeika? Tukari kanaye'amɨkɨ kepauka neneɨkeme mɨtihanieni watsata, hikɨ 'anake mekaniyuhakikuni.  
\v 16 Nixewitɨ tewi 'ixuriki mɨye'i pɨkamanetsikitɨwa 'ixuriki mɨhekwakɨ, 'ixuriki mɨhekwa xɨka yutatuni mɨye'i pɨtatsana, tsanimeyari matsi waɨkawa 'axa'anetɨ payeika.  
\v 17 Yaxeikɨata tsixai mɨyeye'itsie pɨkakatuariwa kaxie winuyari mɨhekwa mukwanakɨ. Mexɨka mɨpaɨ tiuyurieni, tsixai kanititsanikeni, winu kanitayeuriweni, meta tsixai kaneuyewautseni. Matsi kaxie winuyari mɨhekwa tsixai mɨhehekwatsie kanikatuariwani, mɨpaɨ naitɨ 'atsipɨkatiyɨni.   
\s1 'Uka nunutsi kemɨtimɨkikai meta 'ukaratsi mɨtikuyekai  
\r (Mat 9:18-26 – Mar 5:22-43, Ruk 8:41-56)  
\p
\v 18 Mexi mɨpaɨ tiwakuxaxatɨwakai, xewitɨ kaninuani teɨteri wa'ukiyari, hɨxiena kaniutitunumakeni, mɨpaɨ tikɨhɨawetɨ:  
\p —Neniwe 'uka kanemɨni xike. Peru kenemie hetsiena keneutime'i, 'ana kananutanierimɨkɨ.   
\p
\v 19 Ketsutsi 'anukukeka 'utɨmana kaneyani, teyu'ɨkitɨwamete warawitɨtɨ.  
\v 20 Hikɨ 'ana, 'uka mɨtikuyekai tamamata heimana huta wiyari mɨyuriekai xuriyaya kaheunuawekaku, 'ahurawa kaniuyani waritana 'uyemietɨ kanimayɨani 'ɨkarieya putuniyaritsie.  
\v 21 Mɨpaɨ katiniku'eriwakaitɨni: «Xɨka ne'imayɨani tsikere 'ɨkarieya xeikɨa, 'aixɨa nereu'erietɨ nepayani».  
\v 22 Peru Ketsutsi ta'aurie 'aweka 'ixeiyaka mɨpaɨ katinitahɨawe:  
\p —Pepɨka'a'iyaritɨakari, neniwe. Yuri pemɨti'eriekɨ 'aixɨa pereu'erietɨ pepatɨa.  
\p 'Anatɨtɨ 'aixɨa reu'erietɨ patɨa 'uka.   
\p
\v 23 Hikɨ Ketsutsi teɨteri wa'ukiyari kie nuaka, kɨrautawiwamete meta teɨteri meniukixiekame waruxeiyaka,  
\v 24 mɨpaɨ katiniwarutahɨawe:  
\p —Xekeneutayeixɨa. 'Ɨimari pɨkamɨki, matsi pukutsu.  
\p Hikɨ mɨkɨ mekani'atsekaitɨni.  
\v 25 Peru kepauka memanuyenɨ'arie teɨteri, Ketsutsi kaneutahani, mamayatsie kawiereku, kananukukeni 'ɨimari.  
\v 26 Hikɨ mɨpaɨ pɨtiutamariwaxɨ mɨkɨ kwieyaritsie naitsarie.   
\s1 Memakɨkɨpe meta memɨkaniuwawe Ketsutsi 'aixɨa kemɨwaruyuri  
\p
\v 27 Merikɨtsɨ kepauka Ketsutsi mana mɨyetɨa, yuhutatɨ memɨkaheuneniere mekanenukuweiya, mɨpaɨ mete'uhiwatɨ:  
\p —Ketaneutinenimayata, Rawiri pemɨnu'aya.   
\p
\v 28 Kiita heutahaku mɨkɨ, memakɨkɨpe 'ahurawa mekaniukɨne, Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —¿Yuri xete'erie kename neyɨwe?  
\p Mɨkɨ mɨpaɨ metenitahɨawe:  
\p —Huu, Ti'aitame.   
\p
\v 29 Hikɨ kaniwaramayɨaxɨani wahɨxita, mɨpaɨ 'utaitɨ:  
\p —Xehetsie yaketiuyɨni yuri kexemɨte'erie.   
\p
\v 30 Hikɨ meheunenieretɨ mekanakɨne. Peru memɨkatehaxaxatanikɨ Ketsutsi mɨpaɨ yemekɨ katiniwaruhɨritɨani:  
\p —Neuxei, 'ikɨ hepaɨtsita nixeime xepɨkatehaxaxatɨwani.   
\p
\v 31 Peru, kepauka mɨkɨ memayekɨ, mekateniutaxata mɨkɨ hepaɨtsita naitsarie mɨkɨ kwieyaritsie.   
\p
\v 32 Hikɨ mehewayekɨkakaku mɨkɨ, hetsɨana kani'atɨarieni tewi kaniuwetɨ kakaɨyari 'axamɨ'ane miwiyakai.  
\v 33 Hikɨ kepauka Ketsutsi kakaɨyari 'axamɨ'ane manuyenɨ'a, mɨkaniuwekai kaniutaniuni. Teɨteri mekanihɨxiyakaitɨni mɨpaɨ me'utiyuatɨ: «Hatsuaku mɨpaɨ tepɨkatenenieriwawe 'Ixaheri kwieyaritsie».  
\v 34 Peru paritseutsixi mɨpaɨ mekaniutiyuanekaitɨni: «Mɨkɨ kakaɨyarixi 'axamemɨ'anene tiwa'aitɨwame 'iparewiekaku kaniwarayenɨ'awani kakaɨyarixi 'axamemɨ'anene».   
\s1 'Itsanamete mepeuyewetse  
\p
\v 35 Merikɨtsɨ Ketsutsi naitsarie kiekaritetsie 'emɨyeyeutsie meta 'etsimɨyeyeutsie kanikuyeikakaitɨni tukiteta tiku'ɨkitanetɨ, niuki 'aixɨa manuyɨne taheima mieme kuxatatɨ, 'aixɨa meteheu'eriekame warayeitɨwatɨ naime kwiniyakɨ meta naime kememɨte'uka'eniwakai.  
\v 36 Hikɨ teɨteri yumɨireme waxeiyatɨ, kaniwarutinenimayata, yuxaɨtame memu'uwakaikɨ meta metaxɨrietɨkaitɨ muxatsi yɨhɨweme memɨkahexeiya wahepaɨ.  
\v 37 Hikɨ mɨpaɨ katiniwarutahɨawe yuhetsɨa miemete teyɨ'ɨkitɨwamete: «'Itsanari pɨwaɨkawa, peru 'itsanamete mepɨkayumɨire.  
\v 38 'Ayumieme xekeneutawawiri 'itsanari kutsiyari, 'itsanamete mɨwatanɨ'anikɨ yu'itsanarita».   
\c 10  
\s1 Tamamata heimana huta nɨ'ariekate kemɨtiwarutanɨ'a  
\r (Mat 10:2-35 – Mar 3:16-19, 6:8-11, 13:11-13, Ruk 6:14-16, 9:3-5, 21:12-17, 12:2-9, 51-53)  
\p
\v 1 Merikɨtsɨ teyɨ'ɨkitɨwamete yuhetsɨa miemete warukuxeɨrieka tamamata heimana huta, heitserie kaniwarupitɨani kakaɨyarixi 'axamemɨ'anene wahepaɨtsita memɨwaranuyenɨ'awanikɨ, meta 'aixɨa meteheu'eriekame memɨwarayeitɨwanikɨ naime kwiniyakɨ meta naime titakɨ memɨte'uka'eniwakai.   
\p
\v 2 'Ikɨ nɨ'ariekate tamamata heimana huta mɨpaɨ mekatenitetewaka: Tsimuni meri Pekuru mɨtitewakai, meta 'iwaya 'Atɨrexi, Kakuwu meta 'iwaya Wani, mɨkɨ Tsewereu memɨniwemamatɨkai,  
\v 3 Peripe meta Wariturume, Tumaxi meta Mateu kuwiyexinutsie mieme tiwawame mɨhɨkɨtɨkai, Kakuwu 'Aripeu nu'aya, Reweu titewatɨ Tareu mɨtitewakaitatsiere,  
\v 4 Tsimuni (yuteɨterima wahetsie munuakai),\f + \fr 10:4 \ft 'Ikɨ Tsimuni yuteɨterima wahetsie memunua pɨwanɨkai ti'aitame xumatanaka kemɨtiwa'aitɨakai yamepɨkateha'eriwakai.\f* meta Kura 'Itsikariutitanaka 'arike Ketsutsi mɨyetua.   
\p
\v 5 Merikɨtsɨ Ketsutsi kaniwareutanɨ'axɨani tamamata heimana huta mɨpaɨ tiwaruta'aitɨaka: «Memɨkatateɨterima wahuyeta xepɨkaheuhuni meta Tsamariyatari wakiekaritetsie xepɨkaheutahakeni,  
\v 6 matsi muxatsi memeuyexɨrie wahetsɨa xekenehu, 'ixaheritsixi teɨteriyari wahetsɨa.  
\v 7 Tsepa hakewa xemekɨ, 'ikɨ niuki xekenekuxatani: “Kanaye'aximeniri kemɨ'ane taheima mɨti'aita 'enata mitsutɨani ti'aitatɨ”.  
\v 8 Tekwikwikate 'aixɨa meteheu'eriekame xekeniwarayeitɨwani, mɨkite xekeniwaranutanieritɨwani, xekeniwa'itieka mɨkɨ nawi kwiniyayari memexeiyatɨka, xekeniwarayenɨ'awani kakaɨyarixi 'axamemɨ'anene. Tita xeme xekawiyarietɨ xemɨteyetuiriyarie, xemeta xekateyuwiyatɨ xeketeneyetua.  
\v 9 Xepɨkahei'ɨweni huru, nipɨrata, nikuwɨre tuminiyari yutumini manameta.  
\v 10 Kɨtsiuri xepɨkahehuruwani huyeta mieme, huta kamixayari xepɨkahehuruwani, kakai xepɨkahe'ɨweni, meta 'itsɨ xepɨkahe'ɨweni, karikɨ ti'iwame heitserie kanexeiyani 'ikwai mɨmikienikɨ yu'iwarika.   
\p
\v 11 »Kiekaritsie kepauka xemeutahaxɨani 'amɨyewatsie yatɨni 'etsimɨyewatsie, xekenekuwawa kemɨ'ane mana meka 'aixɨa mɨtiuka'iyari, hetsɨana xekeneyuhayewani 'atsita kepaukake xemɨyehu.  
\v 12 Kiita xeheutahaxɨaximetɨ waɨritsika xekenewapitɨaka kiekatari.  
\v 13 Xɨka kiekatari 'aixɨa mete'u'iyarini, xewaɨritsika keyuhayewani wahetsie, mexɨka 'aixɨa mekate'u'iyarini, xewaɨritsika ke'akunuani xehetsie.  
\v 14 Kemɨ'ane mɨkaxetanaki'erieni, kemɨ'ane mɨkayuwaɨriya xeniuki mɨ'enienikɨ, kiita xewayekɨneme yatɨni mɨkɨ kiekaritsie, tumuanari xekeneukatsixɨa yu'ɨkatetsie,  
\v 15 Yurikɨ mɨpaɨ nepɨxerahɨawe, tukari 'aye'ayu kepauka 'itsɨkame mɨwatahɨawe, Tsurumatari meta Kumuxatari 'etsiwa xeikɨa mekatenikwinitɨariekuni, peru mana kiekatari waɨkawa matsi mekatenikwinitɨariekuni.   
\p
\v 16 Neri nepɨxeheutanɨ'axɨa muxatsi wahepaɨ 'ɨrawetsixi watsata. 'Ayumieme, xeketenemaiwaweni kuterixi wahepaɨ, peru xepɨka'inɨka tita 'axamɨti'ane kukuruxi wahepaɨ.   
\p
\v 17 »Xekeneyukweriwayurieka teɨteri wahepaɨtsita, mɨkɨ mekanixeyetuakuni yu'itsɨkate wahetsɨa meta mepɨxetiwani yutukiteta.  
\v 18 Kuwexinaruritsixi meta te'aitamete wahɨxie xekananuhapaniekuni nehetsɨa xemɨmiemetekɨ, mɨpaɨ xe'itɨarietɨwetɨ xekaniwatahekɨatsitɨiyakuni mɨkɨ meta hipame memɨkatateɨterima.  
\v 19 Peru, kepauka memɨxetiwiya, xepɨkayu'iyaritɨaka kexemutiyuaneni hepaɨtsita meta kehapaɨ xemɨtewakɨhɨaweni. 'Anake yaxekatenipitɨariekuni kexemutiyuaneni,  
\v 20 xemetsɨ xepɨkahɨkɨtɨni kemɨ'ane yamɨtayɨni 'ana, matsi xe'ukiyari 'Iyarieya kanihɨkɨtɨkamɨkɨ kemɨ'ane mɨtaniuni xekuyuitɨwatɨ.   
\p
\v 21 »'Iwamarixi xewitɨ yu'iwa kaniyetuamɨkɨ mɨmierienikɨ, meta nuariekame yuniwe kaniyetuamɨkɨ. Tɨɨri mekaniyeha'akuni yupaapama wahepaɨtsita meta mekatenita'aitakuni memɨkwi'iwakɨ.  
\v 22 Yunaitɨ mekanixe'uxiwe'eriekakuni nehetsɨa xemɨmiemetekɨ, peru kemɨ'ane tiuka'eniwatɨ 'amuyeikani heutipareyuke, mɨkɨ kanitawikweitsitɨariemɨkɨ.  
\v 23 Kepauka xemayeweiyarieni xeime kiekariyaritsie, xeimetsie pɨtata xekeneyuta'una. Yurikɨ mɨpaɨ nepɨxerahɨawe, kiekarite 'Ixaheri kwieyaritsie miemetetsie xeka'ayenɨwawekaku nepunuani, Yuri Tewi kenemɨtihɨkɨ.   
\p
\v 24 »Tiyɨ'ɨkitɨwame pɨkamariwe keyuri ti'ɨkitame, meta ti'uximayatame pɨkamariwe keyuri kutsiyarieya.  
\v 25 'Aixɨa kani'aneni xɨka tiyɨ'ɨkitɨwame ti'ɨkitame hepaɨ 'anetɨ 'ayani xeikɨa, xɨka ti'uximayatame yukutsiyari hepaɨ 'anetɨ 'ayani xeikɨa. Merikɨte, kiekame Weheritsewu xɨka tiuterɨwarieni, matsi tɨɨriyamamata kemeteterɨwarieni.   
\p
\v 26 »'Ayumieme xepɨkawamakaka. Karikɨ naitɨ tita mɨti'awietsie katinahekɨarimɨkɨ, meta naitɨ tita 'awie mɨtimieme katinitamariwamɨkɨ.  
\v 27 Kenemɨtixekɨhɨawe tahɨkɨate yɨwikɨta, xeme mɨpaɨ xeketenekuxatani hekɨta. Tita xenakata nemɨtixekuxaxatɨwa, kii heima paitɨ xe'aka'utɨ xe'utihiwatɨ yaxekeneutiyua.  
\v 28 Xepɨkawamakarɨka mɨkɨ memɨyɨwawe wai memumieni xeikɨa, peru mepɨkayɨwawe 'iyari memumieni. Matsi xekenemakarɨka kemɨ'ane mɨyɨwe mika'una 'iyari meta waiyari naime tai yamɨtita'atsie.  
\v 29 Wikixi yuhutatɨ mepɨnanaiya xeitsenitawuyari, peru nixewitɨ mɨkɨ kwiepa pɨkakaweni xe'ukiyari yakatimaikaku.  
\v 30 Xemeta xekɨpate xemu'utsie mieme xexuitɨ pɨ'inɨari kemɨpaɨme.  
\v 31 'Ayumieme xepɨkaheumamaka, xeme matsi waɨkawa xepɨte'aye'axe keyuri yumɨiretɨ wikixi.   
\p
\v 32 »Kemɨ'ane mɨyuhekɨata teɨteri wahɨxie kename nehetsɨa mieme 'utaitɨ, neta kename hetsiena netiwiya nepɨnehekɨatani ne'ukiyari taheima makawe hɨxie.  
\v 33 Peru kemɨ'ane matsi muyuku'imawa teɨteri wahɨxie kename nehetsɨa kamieme 'utaitɨ, neta nepuyuta'imani kename nehetsie katiwiya nepɨtayɨni ne'ukiyari taheima makawe hɨxie.   
\p
\v 34 »Mɨpaɨ xepɨkateku'eriwani kename ne nenua kwiepa memɨtama 'aixɨa meteyuxeiyame nemɨwarayeitɨanikɨ. 'Aixɨa meteyuxeiyame nemɨwarayeitɨanikɨ nepɨkanua, matsi memayuye'uniekakɨ pɨta nekaninuani.  
\v 35 Matsi nekaninuani memɨkayu'enienikɨ  
\q1 »“tewi yupaapa hamatɨa,  
\q2 'uka yumaama hamatɨa,  
\q2 wikiwame yumu'e hamatɨa,   
\q1
\v 36 xeme memɨxe'aye'unie,  
\q2 xekie kiekataritɨtɨ mekanakɨnikuni”.   
\p
\v 37 »Kemɨ'ane waɨkawa mɨwanaki'erie yupaapa meta yumaama 'etsiwa netsinaki'erietɨ ne, 'aixɨa pɨka'ane mɨnetsihexeiyani. Kemɨ'ane waɨkawa minaki'erie yuniwe 'uki yatɨ 'uka 'etsiwa netsinaki'erietɨ ne, mɨkɨta 'aixɨa pɨka'ane mɨnetsihexeiyani.  
\v 38 Kemɨ'ane yemekɨ mɨkayuwaɨriya 'atsita kuruxitsie mɨmierieni, tsepa nehamatɨa muyeika nehetsie tiwiyatɨ, mɨkɨta 'aixɨa pɨka'ane mɨnetsihexeiyanikɨ.  
\v 39 Kemɨ'ane yutukari hepaɨtsita muyu'iyaritɨa pitatɨmaiya. Peru kemɨ'ane miyetuani yutukari nehetsɨa mɨmiemekɨ, mɨkɨ tukari hexeiyatɨ payani.   
\p
\v 40 »Kemɨ'ane mɨxetanaki'erieni neta pɨnetsitanaki'erieni, kemɨ'ane mɨnetsi'utanaki'eri kanitanaki'erienita 'iya mɨnetsiheyenɨ'a.  
\v 41 Kemɨ'ane mitanaki'eri Kakaɨyari niukameya, Kakaɨyari niukameya mɨhɨkɨkɨ xeikɨa, mɨkɨ Kakaɨyari niukameya hepaɨ pɨtipitɨarieni. Kemɨ'ane mitanaki'eri tewi heitseriemekɨ yamɨtikamie, yamɨtikamiekɨ xeikɨa, mɨkɨta tewi heitseriemekɨ yamɨtikamie hepaɨ yapɨtipitɨarieni.  
\v 42 Mɨkɨ tsepa memɨkamamariwawe, kemɨ'ane miharitɨani mɨkɨ xeime, tsepa xeiwatsuyari haɨtɨme xeikɨa miharitɨa, tiyɨ'ɨkitɨwame nehetsɨa mieme mɨhɨkɨkɨ, yurikɨ mɨpaɨ nepɨxerahɨawe, mɨkɨ yu'iwarika pɨkareuyehɨani pɨtipitɨarieni».   
\c 11  
\s1 Ketsutsi meta Wani Ti'ɨyame  
\r (Mat 11:2-9 – Ruk 7:18-35)  
\p
\v 1 Merikɨtsɨ Ketsutsi kepauka mɨtiutahayewaxɨ tiwa'aitɨatɨ yuhetsɨa miemete teyɨ'ɨkitɨwamete tamamata heimana memuyuhuta, mana kanayeyani hipame kiekaritetsie mɨti'ɨkitanikɨta mɨtikuxatanikɨ meta.   
\p
\v 2 Wani katsariyanata kanayewekaitɨni, tiutamarieka Kɨritsitu kemɨtiyurienekai, kaniwarutanɨ'ani yuhetsɨa miemete teyɨ'ɨkitɨwamete,  
\v 3 mɨpaɨ memɨte'ita'iwawiyakɨ:  
\p —¿'Ekɨ petihɨkɨ kemɨ'ane 'umamienikekai, nutsu xeime 'akuxi tepɨtakwewieka?   
\p
\v 4 Ketsutsi mɨpaɨ katiniwaruta'eiya:  
\p —Xekenehu, xeketenetaxatɨa Wani tita xemɨte'u'eni tita xemɨte'uxei hepaɨtsita:  
\v 5 Memɨkaheuneniere meheunenieretɨ kememɨte'akɨka, huriekate kememɨte'anuku'uwe, mɨkɨ nawi kwiniyayari memexeiya me'itiyatɨ kememɨte'akɨka, memɨkaheu'enana meheu'enanatɨ kememɨte'akɨka, mɨkite kememɨte'anuku'uitɨariwa, tixaɨtɨ memɨkatehexeiya niuki 'aixɨa manuyɨne kememɨtekuxaxatɨariwa.  
\v 6 Meta 'aixɨa kani'itɨarieka kemɨ'ane nekɨmana mɨkakunuani.   
\p
\v 7 Merikɨtsɨ mehekɨneku Wani hetsɨa miemete, Ketsutsi kanitsutɨani tiwakuxaxatɨwatɨ teɨteri Wani hepaɨtsita mɨpaɨ 'utaitɨ: «¿Tita xetehekuxei makumawetsie? ¿Haka 'ekakɨ 'uyuaneme xeteheku'ixɨari? Tixaɨ xɨari.  
\v 8 ¿Kamɨtsɨ tita xeteheku'ixɨari? ¿Xiku 'ixuriki mɨyumeni manakatɨkɨ xetehekuxei? Nekatixaɨtsietɨ. Matsi mɨkɨ mɨyumemeni memanakatɨkɨ te'aitamete wakiita mepayetei.  
\v 9 Kamɨtsɨ, ¿tita yemekɨ xeteheku'ixɨari? ¿Kakaɨyari niukameya xeteheku'ixɨari? Huu, mɨpaɨ nepɨtixekɨhɨawe, Kakaɨyari niukameya xepekuxei, yemekɨ Kakaɨyari niukameya keyuri hipatɨ.  
\v 10 'Ikɨ kanihɨkɨtɨni 'utɨarika hepaɨtsitana mɨpaɨ maine:  
\q1 »“Kamɨ, ne neniuki tuayame nekananunɨ'amɨkɨ 'ahɨxie paitɨ,  
\q2 mikuha'aritɨanikɨ 'ahuye pekanuawekaku 'akuxi”.   
\m
\v 11 Yurikɨ mɨpaɨ nepɨxerahɨawe, 'akuxi pɨkatinuiwawe nixewitɨ Wani Ti'ɨyame hepaɨ timariwetɨ, peru matsi tewi tixaɨtɨ mɨkatihɨkɨ Kakaɨyari mɨra'aitatsie Wani reuyeta katinimariweni.  
\v 12 Wani Ti'ɨyame 'amɨtinua meta 'atsita hikɨ, Kakaɨyari kemɨti'aita tiuka'eniwatɨ kaniumieni 'apɨta waye'ekakaku meta wayetɨrɨkarekaku. Kemɨ'ane memɨte'ukanenewie meta yurikɨ memɨyɨa xeikɨa mepɨkɨyɨwekare hetsiena memɨtewiya.  
\v 13 Kakaɨyari niukametemama yunaitɨ meta 'inɨari niukiyari metenikuxatakaitɨni 'arike kemɨtiyɨnikekai 'atsita Wani munuatsie.  
\v 14 Xɨka xeyuwaɨriyani xemitanaki'erieni 'ikɨ neniuki, mɨkɨ Wani kanihɨkɨtɨni 'Eriyaxi 'umamiekai.  
\v 15 Xewitɨ netɨ mu'enaxɨ, ke'u'ena.   
\p
\v 16 »¿Tita 'inɨari netitaxata hikɨ miemete teɨteri wahetsiemieme? Tɨɨri wahepaɨ mekani'aneneni kiekari hixɨapa memɨtitei memɨwahiwie yu'iwama mɨpaɨ me'utiyuatɨ:   
\q1
\v 17 »“Tepɨxekɨrautawiyakai,  
\q2 xemeta xepɨkate'ukanei.  
\q1 Hiwerika kwikariyari teputikwikaxɨ,  
\q2 xemeta xepɨka'utitsua”.   
\p
\v 18 »Wani kaninuani, katikwa'atɨ meta kaye'etɨ, xemeta mɨpaɨ xeputiyuanekai: “Kakaɨyari 'axamɨ'ane kaninɨka”.  
\v 19 Neta Yuri Tewi nehɨkɨtɨtɨ nemunua, netikwa'atɨ meta netiye'etɨ, mɨpaɨta xeputiyuane: “'Ikɨ tewi 'ikwaikɨ xeikɨa pɨyɨane, winukɨ xeikɨa pɨyɨane, pɨwahamiku mɨkɨ kuwiyexinu hetsiemieme tewawamete meta 'axateyuruwamete”. Peru pɨmatsiɨkɨ kemɨ'ane mɨtimaiwe kemɨtiyurienekɨ».   
\s1 Kememɨkateyuwaɨriyakai hipatɨ kiekarite  
\r (Mat 11:21-23 – Ruk 10:13-15)  
\p
\v 20 Hikɨ kanitsutɨani warutate'atɨ teɨteri hipame kiekaritetsie kiekatari hakewa mariwemekɨ mɨreyuri mɨiremekɨ, memɨkatehayewakaikɨ kememɨteyuriekai.  
\v 21 Mɨpaɨ kaniutayɨni: «Xɨa'ui, Kuratsini kiekatari. Xɨa'ui Wetsaira kiekatari. Tirutsie meta Tsirunitsie xɨka mariwemekɨ tiuyɨnike kemɨtiuyɨ xehetsɨa, mana kiekatari meripaitɨri mepɨte'uhayewake kememɨteyuriekai, waɨkawa mepɨyuheiweriekakeyu maixa me'anakatɨtɨ heiwerika 'inɨariyari, naxi meyukawiriwatɨ.  
\v 22 Peru mɨpaɨ nepɨxerahɨawe Tiru meta Tsiruni kiekatari wahetsiemieme tukari 'aye'ayu kepauka 'itsɨkame mɨwatahɨawe 'etsiwa xeikɨa mekatenikwinitɨariekuni, peru xeme waɨkawa matsi xekatenikwinitɨariekuni.  
\v 23 Xemeta Kaperunaumetari, ¿muyuawitsie paitɨ xe'anuwitɨkienike xeteyu'erie? Hawaikɨ, mɨkite wahetsɨa xepeukaxɨriyani pɨta. Xɨka Tsurumatsie mariwemekɨ tiuyɨnike kemɨtiuyɨ xehetsɨa, mɨkɨ kiekari 'apukumakakeyu 'akuxi hikɨ.  
\v 24 Peru mɨpaɨ nepɨxerahɨawe, Tsuruma kiekatari tukari 'aye'ayu kepauka 'itsɨkame mɨwatahɨawe 'etsiwa xeikɨa mekatenikwinitɨariekuni, xeme waɨkawa matsi xekatenikwinitɨariekuni».   
\s1 Nehetsɨa xekeneu'axɨa xekene'uxipieka  
\r (Mat 11:25-27 – Ruk 10:21-22)  
\p
\v 25 Merikɨtsɨ 'ana Ketsutsi mɨpaɨ kaniutayɨni: «Ne'ukiyari, taheima pemɨti'aita meta kwiepa, pamɨpariyutsi nepɨmatsipitɨa, pemɨtiuti'awietaxɨkɨ 'ikɨ naime memɨkaheitimanikɨ mɨkɨ memɨteyɨ'ɨkitɨawawe meta memɨtemaiwawe, tɨɨri pɨta wahetsiemieme matsiɨkɨme pemayeitɨakɨ.  
\v 26 Huu, ne'ukiyari, pepɨ'awaɨriyakai mɨpaɨ pemɨtiyurienenikɨ.   
\p
\v 27 »Ne'ukiyari naime kanetiniyetuirieni. Nixewitɨ pɨka'imate Nu'aya 'Ukiyarieya xeikɨa pimate, meta nixewitɨ pɨka'imate 'Ukiyarieya Nu'aya xeikɨa pimate meta mexɨka nu'aya yuwaɨriyani matsiɨkɨme meyeitɨani peitimani 'ukiyarieya.   
\p
\v 28 »Nehetsɨa xekeneu'axɨa xeme yunaitɨ xemu'u'uxe xete'uximayatɨ meta xemu'ika, ne nepɨxeka'uxipitɨani.  
\v 29 Neyuku xekenanuyetekani, xenetsi'enietɨ xeketeneyɨ'ɨkitɨaka, ne nepɨka'ane'eriya meta nepɨkatinekatawe'erie ne'iyaritsie, 'uxipiya xekanitaxeiyakuni yu'iyaritsie.  
\v 30 Neyuku 'aixɨa pɨ'ane meta ne'ika pa'exani».   
\c 12  
\s1 Kemɨ'ane 'uxipiya tukari hetsie mɨti'aita  
\r (Mat 12:1-14 – Mar 2:23-28, 3:1-6, Ruk 6:1-11)  
\p
\v 1 Merikɨtsɨ 'ana tukaritsie Ketsutsi tɨriku ma'etsietsie kaniuyemiekaitɨni 'uxipiya tukaritsie, teyɨ'ɨkitɨwametemama meyunaitɨ. Hikɨ mepeuhakakwikukai teyɨ'ɨkitɨwamete, 'ayumieme mekanitsutɨani me'enutihurukatɨ tɨriku mɨayeyari meta me'ikwatɨ.  
\v 2 Hikɨ paritseutsixi mewaxeiyatɨ, Ketsutsi mɨpaɨ mekateniutahɨawe:  
\p —Neuxei. 'Ahetsɨa miemete teyɨ'ɨkitɨwamete kemɨkareuyewetse mepɨteyurie 'uxipiya tukaritsie.   
\p
\v 3 Mɨkɨ mɨpaɨ katiniwarutahɨawe:  
\p —¿Kari xepɨka'ekaterɨwawawe kemɨtiuyuri Rawiri kepauka memuhakakwi mɨkɨ meta hamatɨana memu'uwakai?  
\v 4 Kakaɨyari kiyata kaneutahani, hikɨ mɨkɨ meta hamatɨana memu'uwakai mekanitikwani paa Kakaɨyari hɨxie mamanekai, mɨkɨ heitserie mepɨkahexeiyakai memitikwanikɨ, mawari wewiwamete xeikɨa heitserie mepexeiyakai.  
\v 5 ¿Mɨkɨ meta, xɨari xepɨka'ekaterɨwawawe kemaine 'inɨari niukiyari mawari wewiwamete keyamemɨkatekahu 'uxipiya tukari 'inɨariyari tukipa me'u'uwatɨ 'uxipiya tukaritsie peru wahetsie pɨkarahɨiwa mɨkɨkɨ?  
\v 6 Ne matsi mɨpaɨ nepɨxerahɨawe 'ena kaniuyeikani xewitɨ kwi mariwetɨ, tuki 'amɨpa kamariwekaku hepaɨna.  
\v 7 Xɨka xeme xe'imaikake 'ikɨ niuki mɨpaɨ manuyɨne: “Ne nepɨxewawirie xeketeneuyukanenimayaka, nepɨkaxewawirie mawari”.\f + \fr 12:7 \ft \+bd 'Uts 6:6\+bd*\f* Xɨka xeheiti'enietɨkɨkanike, mɨkɨ 'atsimemɨkate'uyuri wahetsie xepɨkate'uhɨpanikeyu.  
\v 8 Karikɨ Yuri Tewi nehɨkɨtɨtɨ 'uxipiya tukari hetsie nekatini'aitani.   
\p
\v 9 Hikɨ mana mɨyetɨa, tukita kaneutahani.  
\v 10 Hikɨ tewi muwa nayekateitɨni mamawakitɨ. Mɨkɨ mɨpaɨ Ketsutsi meteniuta'iwawiya, me'ixanetakutɨ:  
\p —¿Tiyɨwe 'uxipiya tukaritsie tikwikame 'aixɨa reu'eriekame mayeitɨani?   
\p
\v 11 Mɨkɨ mɨpaɨ katiniwaruta'eiya:  
\p —Xewitɨ xeme xɨka muxa hexeiyani, xɨka 'uxipiya tukaritsie hewatixawakaku heukaweni, ¿katiwatihana? Xɨari puwatihana.  
\v 12 Matsi tewi kwini mieme karaye'axe, keyuri muxa. 'Ayumieme, pɨyɨwe 'aixɨa mɨtiyurieneni 'uxipiya tukaritsie.   
\p
\v 13 Hikɨ mɨpaɨ tewi katiniutahɨawe:  
\p —'Amamá keneutatsera.  
\p Hikɨ mɨkɨ kanitatsera, 'ana 'aixɨa 'anetɨ kanayani yuxewitɨ tapa mieme hepaɨ.  
\v 14 Peru paritseutsixi mewayekɨneka mekanitsutɨani Ketsutsi hepaɨtsita metekuxatatɨ kememɨte'imienikɨ.   
\s1 Ti'uximayatame Kakaɨyari menayexei  
\p
\v 15 Kepauka Ketsutsi mɨretima, xaɨtsie kaneyani. Meta yumɨiretɨ teɨteri mekanenukuweiya, mɨkɨta yunaime tekwikwikate 'aixɨa meteheu'eriekame kaniwarayeitɨwakaitɨni,  
\v 16 peru kaniwaku'imaiyakaitɨni memɨka'ikuxatanikɨ kapa matsiɨkɨme meheyeitɨanikɨ.  
\v 17 Mɨpaɨ katinaye'ani Kakaɨyari niukameya Kitsariyaxi kemutayɨ:   
\q1
\v 18 «'Ikɨ neti'uximayatsiriwame kanihɨkɨtɨni, nemenayexei,  
\q2 neminaki'erie, hetsiena mieme nepɨnaki'a ne'iyaritsie,  
\q1 nekanipitɨamɨkɨ Ne'iyari,  
\q2 hikɨ nuiwarite katiniwataxatɨamɨkɨ tita mɨtiheitserie hepaɨtsita.   
\q1
\v 19 Mɨkɨ pɨkayumieneni niukikɨ meta pɨka'utahiwani,  
\q2 nixewitɨ pɨka'i'enieni kaye 'utɨa hiwarieya.   
\q1
\v 20 Haka mutapɨnarie pɨka'anumura,  
\q2 meta pɨka'itɨni kɨxeme witayari mɨkwauniyake,  
\q1 'atsita yatiyuriemeke mɨrayu'iwakɨ tita mɨtiheitserie.   
\q2
\v 21 Meta mɨkɨ memɨkatateɨterima yuri mepɨteta'erieni hetsiena».   
\s1 Ketsutsi meta kakaɨyarixi 'axamemɨ'anene tiwa'aitɨwame  
\r (Mat 12: 25-29 – Mar 3:23-27, Ruk 11:17-22)  
\p
\v 22 Merikɨtsɨ heiwa tewi hetsɨana kani'atɨarieni kakaɨyari 'axamɨ'ane minɨkai mɨkaheunierekai meta mɨkaniuwekai, hikɨ Ketsutsi 'aixɨa 'aneme kanayeitɨani, mɨkaniuwekai niuwetɨ kanayani meta heunieretɨ.  
\v 23 Yunaitɨ teɨteri mekanihɨxiyakaitɨni, meta mɨpaɨ mekaniutiyuanekaitɨni: «¿'Ikɨri Rawiri Nu'aya katihɨkɨ?»   
\p
\v 24 Peru, paritseutsixi me'u'enanaka, mɨpaɨ mekaniutiyuani: «'Ikɨ kakaɨyarixi 'axamemɨ'anene puwarayenɨ'awa Weheritsewu tɨrɨkariyayakɨ, kakaɨyarixi 'axamemɨ'anene tiwa'aitɨwame».   
\p
\v 25 Peru Ketsutsi wa'iyaritɨarika maitɨ, mɨpaɨ katiniwarutahɨawe: «Xɨka xeime kwieyaritsie kiekatari yuhixɨata xɨka meyutsana, mana pakumawere, meta kiekari yatɨni xeinuiwaritsixi xɨka yuhixɨata meyutsana, 'emepɨkateheutere.  
\v 26 Kauyumarie xɨka 'enuyenɨ'ani Kauyumarie, hixɨata kaniyutsanani yɨkɨmana. Xɨka mɨpaɨ 'aneni, pika'una yɨkɨmana hakewa mɨre'aita.  
\v 27 Merikɨte, xɨka ne Weheritsewu hetsie xeniu netiwiyatɨ newarayenɨ'awani kakaɨyarixi 'axamemɨ'anene, ¿xemeta xemɨtewa'ɨkitɨa kemɨ'anetsie metewiyatɨ mepɨwaranuyenɨ'awa? 'Ayumieme mɨkɨ xehetsie mepɨte'ahɨpani.  
\v 28 Peru xɨka Kakaɨyari 'Iyarieya hɨkɨtɨni kemɨ'ane mɨnetsiparewie nemɨwaranuyenɨ'awaniku kakaɨyarixi 'axamemɨ'anene, Kakaɨyari 'ari kanitsutɨani ti'aitatɨ xehetsɨa.   
\p
\v 29 »Xɨka xewitɨ tinawamɨkɨni tewi mɨtɨrɨkaɨye tita yukiita mɨrexeiya, mɨkɨ tewi katiuhɨani meri, 'anake kaniyɨwemɨkɨ piiniteya naime mɨtiunawani.   
\p
\v 30 »Kemɨ'ane nehetsie mɨkatiwiya, mɨkɨ pɨnetsi'aye'unie, kemɨ'ane nehamatɨa mɨkatiukuxexeɨriwa, mɨkɨ pitaxɨrɨwa.  
\v 31 'Ayumieme mɨpaɨ nepɨtixekɨhɨawe, teɨteri mepɨteheuyehɨwiyarieni naime 'axakememɨte'uyuri meta 'axakememutiyua, peru mepɨkateheuyehɨwiyarieni kemɨ'ane 'axamemutiyua 'Iyari hepaɨtsita.  
\v 32 Kemɨ'ane yɨkɨmɨtayɨni nehepaɨtsita, Yuri Tewi kenemɨtihɨkɨ, mɨkɨ pɨreuyehɨwiyarieni, peru kemɨ'ane 'axamɨtayɨni 'Iyari Mɨtiyupata hepaɨtsita mɨkɨ pɨkareuyehɨwiyarieni 'ena kwiepa meta 'umamietsie.   
\p
\v 33 »'Iteɨri xɨka xehexeiyani 'aixɨa mɨ'ane, 'ikwaxi mexeiya 'aixɨa kani'aneni, mexɨka 'iteɨri 'axamɨ'ane hɨkɨtɨni, 'ikwaxi mexeiyata 'axakani'aneni. 'Iteɨri yu'ikwaxikɨ pɨmatsiɨkɨ.  
\v 34 Xeme kuterixi xepɨhɨkɨ, xeme xepɨkayɨwawe 'aixɨa xemɨtekuxatani, xeme 'axaxepɨte'u'iyari. Tita yu'iyaritsie mɨtihɨniyani, mɨpaɨ katinikuxatamɨkɨ.  
\v 35 Tewi 'aixɨa mɨtiuka'iyari 'ikuxeɨrieme tita 'aixɨa mɨti'ane yuhetsie, tita 'aixɨa mɨti'ane katinikuxatamɨkɨ, peru tewi 'axamɨtiuka'iyari 'ikuxeɨrieme tita 'axamɨti'ane yuhetsie, tita 'axamɨti'ane katinikuxatamɨkɨ.  
\v 36 Matsi yurikɨ mɨpaɨ nepɨtixekɨhɨawe, naime niuki yakɨ xeikɨa memutiniuka teɨteri, mɨkɨ hepaɨtsita mepɨtiniuni kepauka 'itsɨkame mɨwatahɨawe.  
\v 37 Karikɨ kepemutayɨkɨ, mɨkɨkɨ heitserie pekanipitɨariekamɨkɨ, meta kepemutayɨkɨ, mɨkɨkɨ pepanutahɨiyani».   
\s1 Kunatsi 'inɨariyari  
\r (Mat 12:39-45 – Ruk 11:24-32)  
\p
\v 38 Merikɨte 'ana hipatɨ 'inɨarikɨ te'ɨkitamete meta hipatɨ paritseutsixi, mɨpaɨ mekatenitahɨawe:  
\p —Ti'ɨkitame 'aku, tepɨmatsiheuxeiyaku 'inɨari mariweme keneuwewi.   
\p
\v 39 Ketsutsi mɨpaɨ katiniwaruta'eiya:  
\p —Hikɨ miemete teɨteri 'axamemɨte'u'iyari, hipame memɨwakumaɨwa, 'inɨari mariweme mekaniku'iwawani. Peru 'inɨari mepɨkapitɨarieni, Kakaɨyari niukameya Kunatsi 'inɨarieya xeikɨa mekanipitɨariekuni.  
\v 40 Kunatsi ketsɨ 'amupatsie kemɨtiyekatei haika tukari haika tɨkari, mɨpaɨta yaxeikɨa Yuri Tewi kenemɨtitewa, kwieta nepɨyekani haika tukari haika tɨkari.  
\v 41 Niniwe hetsie kiekatari 'amepɨti'uni metetahekɨatake hikɨ miemete teɨteri wahepaɨtsita kepauka 'itsɨkame mɨwatahɨawe. Hikɨ miemete wahetsie pɨrahɨiyani 'ana, Niniwe kiekatari memɨte'uhayewaxɨkɨ kememɨteyuriekai, Kunatsi tiwarutaxatɨaku, matsi 'ena kaniuyeikani xewitɨ waɨkawa mariwetɨ keyuri Kunatsi.  
\v 42 Metatsiere 'uka ti'aitame Tsawa mekatei, mɨkɨ panukukeni titahekɨatake hikɨ miemete wahepaɨtsita, wahetsie pɨrahɨani 'ana, mɨkɨ meyetɨakɨ kwie manuniere paitɨ, mi'enienikɨ Tsarumuni kemɨtimaiwekai, matsi 'ena kaniuyeikani xewitɨ waɨkawa mariwetɨ keyuri Tsarumuni.   
\p
\v 43 »Xewitɨ kakaɨyari 'axamɨ'ane tewi hetsie 'ayeyame, makumawetsie pɨkuyeikani 'uxipiya kuwaunetɨ, yutexienetɨ.  
\v 44 'Ana mɨpaɨ pɨtayɨni: “Nekie nepɨyemie nemɨwayekateitsie”. Nuame xɨka 'ixeiya 'uyemaweme waye'itiyakame 'aixɨa tiuye'aneme.  
\v 45 'Ana pɨyemie, hipame pɨwata'inieni kakaɨyarixi 'atahutame matsi kwini mieme 'axamemɨ'anene, meheutahaxɨame, muwa me'ayetetɨ mepakɨne yunaitɨ. 'Imatɨrieka mɨkɨ tewi matsi yemekɨ 'axa'anetɨ payani, mɨka'anekai hepaɨ matɨari paitɨ. Mɨpaɨta mekani'itɨariekuni 'ikɨ teɨteri hikɨ miemete 'axamemɨteyurie».   
\s1 Ketsutsi maamaya meta 'iwamama  
\r (Mat 12:46-50 – Mar 3:31-35, Ruk 8:19-21)  
\p
\v 46 Ketsutsi tiwakuxaxatɨwakaku 'akuxi teɨteri yumɨireme, maamaya meta 'iwamama mekaniu'axɨani, takwa mekaniti'uni me'ihɨawikutɨ.  
\v 47 Xewitɨ mɨpaɨ katinitahɨawe:  
\p —Neuxei, 'amaama meta 'a'iwama takwa mekaneti'uka mematsihɨawikutɨ.   
\p
\v 48 Ketsutsi mɨpaɨ katinita'eiya niukame:  
\p —¿Kemɨ'aneri pɨnemaama meta kehateri mepɨne'iwama?   
\p
\v 49 Yumamá 'utatseratɨ yuhetsɨa miemete teyɨ'ɨkitɨwamete wahepa, mɨpaɨ kaniutayɨni:  
\p —Kamɨ 'ena nemaama meta ne'iwama.  
\v 50 Karikɨ kemɨ'ane yamɨtiyuriene kemɨtinake ne'ukiyari taheima makawe, mɨkɨ kanine'iwatɨni meta kaninemaamatɨni.   
\c 13  
\s1 Ti'iwiwame 'ɨxatsiyarikɨ kemɨti'ɨkitakai  
\r (Mat 13:1-23 – Mar 4:1-20, Ruk 8:4-15, 10:23-24)  
\p
\v 1 Merikɨtsɨ 'ana kiita hewayeyaka Ketsutsi, harakuna tetsita kaniukayerɨni.  
\v 2 Hikɨ teɨteri yumɨiretɨ mekaniuyukuxeɨrieni 'auriena, 'ayumieme kanuwatsie pɨta kanikayerɨni, mana 'atikaitɨ teɨteri xiekaripa meti'ukaku katini'ɨkitakaitɨni.  
\v 3 Waɨkawa katiniwaruta'ɨkitɨani 'ɨxatsi hepaɨtsita tikuxatatɨ, mɨpaɨ 'utaitɨ: «Merikɨtsɨ ti'iwiwame kanayeyani.  
\v 4 Merikɨtsɨ mexi 'imɨari 'iwienekaku, hipatɨ huye tetsita kaniukaxɨrieni, wikixi me'u'axɨaka mekanikuxɨni.  
\v 5 Hipatɨta mutetexiyatsie kaniukaxɨrieni waɨkawa mɨka'akukwieyatsie. Mɨkɨ kwitɨwa kaniutinexɨani kwie 'emɨkatsuikaikɨ,  
\v 6 peru, kepauka tau manatine maxɨrixɨ, kaniutiyɨnare, mɨkahananayatɨkateikɨ kaniutiwani.  
\v 7 Hipatɨta xuyatsata kaniukaxɨrieni, hikɨ kepauka xuya mutiwawerixɨ kanenukanani.  
\v 8 Matsi hipatɨta kwie 'aixɨa mɨraku'anetsie kaniukaxɨrieni, mɨkɨ putixuawerixɨ hipatɨ xeitsienituyari kanayani, hipatɨ haika tewiyari ratɨa, hipatɨ xeitewiyari heimana tamamata ratɨa.  
\v 9 Xewitɨ netɨ mu'enaxɨ, ke'u'ena».   
\p
\v 10 Merikɨtsɨ teyɨ'ɨkitɨwamete 'ahurawa me'akɨneka mɨpaɨ metenita'iwawiya:  
\p —¿Titayari 'ɨxatsikɨ xeikɨa hepaɨtsita petikuxatatɨ teɨteri petiwa'ɨkitɨa?   
\p
\v 11 Mɨkɨ mɨpaɨ katiniwaruta'eiya:  
\p —Xeme xekaniupitɨarieni xemimaikakɨ tita mɨti'awietsiekai Kakaɨyari mɨra'aitatsie timieme, peru mɨkɨ mɨpaɨ mepɨkatepitɨarie.  
\v 12 Kemɨ'ane tixaɨtɨ mɨrexeiya, tawari matsi pɨtimikieni, hikɨ ranayuhayewame pɨrexeiyani. Kemɨ'ane mɨkarexeiya, tsepa 'etsiwa mɨrexeiya katininawaiyariemɨkɨ.  
\v 13 'Ayumieme mɨkɨ nepɨtiwakuxaxatɨwa 'ɨxatsikɨ xeikɨa:  
\q1 »Tsepa memɨtaneniere, mepɨkaheuneniere,  
\q2 tsepa memɨta'enana, mepɨkaheu'enana ni mepɨkaheitimaitɨkɨka.   
\m
\v 14 Wahetsie paye'atɨarie Kakaɨyari niukameya Kitsariyaxi kemutayɨ:  
\q1 »“Tsepa kwi xemɨta'enana, peru xepɨkaheitimaitɨkɨkani,  
\q2 tsepa kwi xemɨtaneniere, peru tixaɨtɨ xepɨkatexeiya.   
\q1
\v 15 'Ikɨ teɨteri yu'iyaritsie mepɨtsetse'i,  
\q2 yunakata mepeukanatɨka,  
\q2 meta yuhɨxita mepeunaname.  
\q1 Mexɨka mɨpaɨ meka'anenenike, yɨhɨxikɨ mepeunenierenikeyu,  
\q2 yunakakɨ mepeu'enanakakeyu,  
\q2 yu'iyaritsie mepɨtemaiwawenikeyu,  
\q1 meta mepɨtehayewakeyu ke'axamemɨteyurie, neta 'aixɨa me'aneneme nepɨwarayeitɨanikeyu”.   
\m
\v 16 Xeme matsi 'aixɨa xepɨ'itɨarie xemeunenierekɨ yɨhɨxitekɨ, xemeu'enanakɨ yunakakɨ  
\v 17 Yurikɨ mɨpaɨ nepɨxerahɨawe, yumɨiretɨ Kakaɨyari niukametemama, yumɨiretɨ teɨteri heitseriemekɨ yamemɨtekahukai, mɨkɨ mepixeiyakukai tita xemɨtexeiya xeme, peru mepɨka'ixei, mepi'eniekukai tita xemɨte'enie, peru mepɨka'i'eni.   
\p
\v 18 »Merikɨte, xekeneu'enana kemɨti'inɨari ti'iwiwame 'ɨxatsiyari:  
\v 19 Kemɨ'ane mi'eni 'ikɨ niuki Kakaɨyari mɨra'aitatsie mieme, peru 'atsimɨkaretimaiwe, 'axamɨ'ane nuame pinawairieni tita 'iyarieyatsie mɨtiuka'iwiya. Mɨpaɨ kani'itɨarieka huye tetsita muka'iwiya.  
\v 20 Makutetexiyatsie muka'iwiya, mɨkɨ kanihɨkɨtɨni kemɨ'ane mi'eni niuki, yutemawietɨ mitanaki'eri xeimieme,  
\v 21 peru, mɨkahananakaikɨ, 'apɨkareuterixɨ. 'Ayumieme kepauka mu'uximatɨarieni, kepauka mɨtaweiyarieni 'ikɨ niuki hepaɨtsita, hikɨ yapauka 'ikɨ niuki mɨkɨ niku'eirimɨkɨ.  
\v 22 Meta xuyatsata muka'iwiya, mɨkɨ kanihɨkɨtɨni kemɨ'ane mi'eni niuki, peru 'iyaritɨarika kwiepa timiemekɨ, tuminitɨarikakɨ ti'irɨwiyarietɨ, 'ayumieme mɨkɨ niuki kananukanamieni meta mɨkaxuawere pɨkapitɨarie.  
\v 23 Peru kwie 'aixɨa mɨraku'anetsie muka'iwiya, mɨkɨ kanihɨkɨtɨni kemɨ'ane niuki mu'eni meta meitima. Mɨkɨ niutixuxuawereni hipatɨ xeitsienituyari pakɨ, hipatɨta haika tewiyari pakɨ, meta hipatɨ xeitewiyari heimana tamamata pakɨ».   
\s1 Tɨriku meta hamɨrixa hepaɨtsita tikuxatatɨ kemɨti'ɨkitakai  
\p
\v 24 Merikɨtsɨ tawarita 'ɨkitsika kaniwayetuirieni 'ɨxatsi hepaɨtsita tikuxatatɨ, mɨpaɨ 'utaitɨ: «Kakaɨyari kemɨti'aita tewi hepaɨ kani'aneni 'imɨari 'aixɨa mɨ'anene muka'iwi yuwatsiyata.  
\v 25 Peru mekutsukaku te'uximayatamete, xewitɨ mana kaninuani 'eye'unietɨ, hamɨrixa 'uka'iwieka tɨrikutsata, kaneyani.  
\v 26 Kepauka tɨriku mutine meta mutixuawerixɨ, hikɨ 'anata matsiɨkɨtɨ kanayani hamɨrixa.  
\v 27 Hikɨ te'uximayatamete me'u'axɨaka yukutsiyari hetsɨa, mɨpaɨ mekatenitahɨawe: “Takutsiyari 'aku, ¿'imɨari 'aixɨa kati'anenekai pemika'iwi 'awatsiyata? Kamɨtsɨ, ¿keranexɨa hamɨrixa?”  
\v 28 Mɨkɨ mɨpaɨ pɨtiwaruta'ei: “Tewi xewitɨ mɨnetsi'aye'unie katineyurieni”. Te'uximayatamete mɨpaɨ metenitahɨawe: “¿Merikɨte, pekati'awaɨriya temuhu temenuyehuna?”  
\v 29 Mɨkɨ mɨpaɨ kaniutayɨni: “Tixaɨ, xɨka xe'enuyehuna hamɨrixa tɨriku 'ɨarime xepɨwatihunaxɨani.  
\v 30 Xekeneuhayewa 'axeikɨa mɨwawerenikɨ 'itsanaxake. 'Anake mɨpaɨ nepɨtiwatahɨawe 'itsanamete: Hamɨrixa meri xekeneukuxeɨri, xekenanahɨaxɨa xemititaiyakɨ, meta tɨriku xekeneuti'uta nekaxetunitsie”».   
\s1 Mutsitatsa 'imɨariyari meta paa kuxanariyame  
\r (Mat 13:31-33 – Mar 4:30-32, Ruk 13:18-21)  
\p
\v 31 Hikɨ tawari 'ɨxatsi hepaɨtsita tikuxatatɨ 'ɨkitsika kaniwarutaxatɨani mɨpaɨ 'utaitɨ: «Kakaɨyari kemɨti'aita mutsitatsa 'imɨariyari hepaɨ kani'aneni tewi mika'e hepaɨ yuwatsiyata.  
\v 32 'Imɨarite pɨkaxuawe hepaɨna 'anenetɨ 'etsipepetɨ, peru kepauka mɨtineni, tupiriyate pɨkaxuawe hepaɨna 'anenetɨ 'epapatɨ, 'iteɨri payeika 'epatɨ, taheima miemete wikixi mepɨyɨwawe hetsiena memɨ'axɨani memɨyuti'ituatɨani».   
\p
\v 33 Tawarita katiniwaruta'ɨkitɨani 'ɨxatsi hepaɨtsita tikuxatatɨ, mɨpaɨ 'utaitɨ: «Kakaɨyari kemɨti'aita, paa kuxanariyame hepaɨ kani'aneni, 'uka 'iwatituka nenutinɨitɨani harina tɨxiyari waɨkawametsie, hikɨ 'arike kaniutakuxanare naitɨ».   
\p
\v 34 Mɨpaɨ naimekɨ Ketsutsi katiniwakuxaxatɨwakaitɨni teɨteri, 'ɨxatsi hepaɨtsita tikuxatatɨ tiwa'ɨkitɨatɨ. 'Ɨxatsi hepaɨtsita katikuxatatɨ, 'atsipɨkatiwakɨhɨawekai.  
\v 35 Mɨpaɨ pɨraye'a, Kakaɨyari niukameya kemutayɨ:  
\q1 «'Ɨxatsi hepaɨtsita netikuxatatɨ nepɨtaniuni,  
\q2 nepɨtitaxata tita mɨti'awietsiekai kwie munetɨarietsie paitɨ».   
\s1 Ketsutsi kemɨtihekɨataxɨ yu'ɨkitsika hamɨrixa hepaɨtsita  
\p
\v 36 Hikɨ teɨteri warutateutɨaka kiita kaneutahani. Teyɨ'ɨkitɨwamete 'auriena mekaniu'axɨani, mɨpaɨ mekatenitahɨawe:  
\p —Ketaneutahekɨatsitɨiya 'a'ɨkitsika hamɨrixa watsita mieme hepaɨtsita.   
\p
\v 37 Ketsutsi mɨpaɨ katiniwaruta'eiya:  
\p —Kemɨ'ane mika'iwi 'imɨari 'aixɨa mɨ'anene, Yuri Tewi kenemɨtihɨkɨ ne nekanihɨkɨtɨni.  
\v 38 Watsiya kwie naitɨ kanihɨkɨtɨni, 'imɨari 'aixɨa mɨ'anene, mɨkɨ mekanihɨkɨtɨni Kakaɨyari mɨra'aitatsie miemete. Hamɨrixa, mɨkɨ 'axamɨ'ane hetsɨa miemete mekanihɨkɨtɨni,  
\v 39 tewi kiekame maye'uniekai hamɨrixa muka'iwi, Kauyumarie kanihɨkɨtɨni. 'Itsanaxa, mɨkɨ kanihɨkɨtɨni kepauka tukari meutipare. 'Itsanamete meta niuki tuayamete mekanihɨkɨtɨni.   
\p
\v 40 »Hamɨrixa kemɨtiukuxexeɨriwa kemɨtiutitaiyarɨwa taipa, mɨpaɨrita katiniyɨmɨkɨ kepauka kwie meutipare.  
\v 41 Yuri Tewi kenemɨtihɨkɨ, nepɨwatanɨ'ani neniuki tuayamete, mɨkɨ mepɨwakuxeɨrieni teɨteri hipame memɨwarukununuitɨwa 'axamemɨteyuriekakɨ, meta teɨteri kemɨkatiheitserie memɨteyurie.  
\v 42 Mɨkɨ huxunu mɨwatita'atsie mepeukaxɨriyani. Muwa meputitsuanani meta mepɨyutikeweni.  
\v 43 Mɨkɨ heitseriemekɨ yamemɨtekahu pɨta memamariwawetɨ mekanakɨnikuni 'ana hakewa wa'ukiyari mɨre'aita, tau kemɨtimerɨkaɨye. Xewitɨ netɨ mu'enaxɨ, ke'u'ena.   
\s1 Tumini mɨ'awietsiekai meta perɨra  
\p
\v 44 »Merikɨte Kakaɨyari kemɨti'aita waɨkawa tumini hepaɨ kani'aneni kwieta mɨ'awietsiekai hepaɨ. Tewi 'itaxeiyaka, tawari niti'awieta, hikɨ kwi yutemawietɨ heyaka, katiniutuani naime mɨrexeiyakai, hikɨ ninaneni mɨkɨ kwie.   
\p
\v 45 »Metatsiere Kakaɨyari kemɨti'aita tituayame hepaɨ kani'aneni mikuwaunekai perɨra witsimɨ'anene.  
\v 46 Xeime perɨra hetaxeiyaka kwinie mɨraye'akai, hikɨ heyaka katinetuani naime mɨrexeiyakai, hikɨ mɨkɨ tuminiyarikɨ kaneinaneni mɨkɨ perɨra.   
\s1 Wipi  
\p
\v 47 »Metatsiere Kakaɨyari kemɨti'aita wipi hepaɨ kani'aneni haramaratsie meukawiwiya hepaɨ, mɨkɨ ketsɨte yɨkɨ me'aneneme yutsata muwakuwiwiya.  
\v 48 Kepauka memutahɨnixɨ, ketsɨteweiyamete menenatihanani haramara tetsita, mana metitetɨ 'aixɨa memɨ'anene mekaniwaranuyeteɨxɨni kiriwatsie mekaniwareukaxɨrieni, meta 'axamemɨ'anene mepɨwarexɨrɨwa.  
\v 49 Mɨpaɨta katiniyɨmɨkɨ kepauka kwie meutipare. Niuki tuayamete mekani'axɨakuni, mekaniwaranuyeteɨxikuni 'axateyuruwamete mɨkɨ heitseriemekɨ yamemɨtekahu watsata,  
\v 50 huxunu mɨwatita'atsie mepɨwareukaxɨrieni, muwa meputitsuanani meta mepɨyutikeweni.   
\p
\v 51 Hikɨ mɨpaɨ katiniwarutahɨawe:  
\p —¿'Ikɨ naime xeteheti'enietɨkɨ?  
\p Mɨkɨ mɨpaɨ metenitahɨawe:  
\p —Huu.   
\p
\v 52 Mɨkɨ mɨpaɨ katiniwarutahɨawe:  
\p —Kemɨ'ane 'inɨarikɨ mɨti'ɨkitame kepauka yamɨretimani Kakaɨyari kemɨti'aita, mɨkɨ kii kutsiyari hepaɨ kaniyɨaneni, tita mɨtiuti'utaxɨtsata pɨtiwayepine mɨraye'atɨka mɨtihehekwa meta meripaitɨ timieme.   
\s1 Ketsutsi kemɨtiuyuri Natsaretitsie  
\r (Mat 13:54-58 – Mar 6:1-6)  
\p
\v 53 Kepauka Ketsutsi mɨtiutahayewaxɨ ti'ɨkitatɨ 'ɨxatsi hepaɨtsita, mana kanayeyani.  
\v 54 Hikɨ yukiekaritsie nuaka, tiniwa'ɨkitɨakaitɨni watukita. Mɨkɨ mekanihɨxiyakaitɨni, mɨpaɨ mekaniutiyuanekaitɨni:  
\p —¿'Ikɨ hakewa pɨretima mɨyamɨtimaiwe, meta tɨrɨkaɨyemekɨ kemɨtiyuriene?  
\v 55 ¿'Ikɨ kɨyekɨ mɨreutawewiwe katinu'aya? ¿Maamaya Mariya katitewa, 'iwamama Kakuwu, Kutse, Tsimuni meta Kura mekatehɨkɨ?  
\v 56 ¿'Iwamama 'ukari yunaitɨ 'ena mekatetitei tahetsɨa? ¿Kamɨtsɨ hakewa pɨretima 'ikɨ naime kemɨtiyuriene?   
\p
\v 57 Mepɨkayɨwawekai yuri memɨte'i'eririekakɨ. Peru Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —Kakaɨyari niukameya naitsarie we'eme kani'eriwani, peru yukwiepa meta yukie mariweme pɨka'eriwa.   
\p
\v 58 Hikɨ mana waɨkawa mamariwaweme pɨkatiuyuri, mɨkɨ yuri memɨkate'eriekaikɨ.   
\c 14  
\s1 Wani Ti'ɨyame kemɨtiumierie  
\r (Mat 14:1-12 – Mar 6:14-29)  
\p
\v 1 Merikɨtsɨ kuwexinaruri Herurexi kanihɨritɨariekaitɨni Karereya kwieyari. Hikɨ kaniu'ena Ketsutsi hepaɨtsita kemɨraniuwakai,  
\v 2 mɨpaɨ katiniwarutahɨawe memiparewiekai: «Wani Ti'ɨyame kanihɨkɨtɨni, 'umɨka panukuke, 'ayumieme tɨrɨkariya kanexeiyani mariwemekɨ mɨtiyurienenikɨ».   
\p
\v 3 Mɨkɨ Herurexi yatiuta'aitaku meripaitɨ, kaniuwiyarieni Wani. Kanihɨani meta kanenutahɨani katsariyanata, mɨpaɨ mɨtinakekaikɨ Heruriya, yu'iwa 'ɨyaya Peripe.  
\v 4 Meripaitɨ Wani kawiyariewetɨ 'akuxi, mɨpaɨ Herurexi katiniutahɨawe: «Pɨkayɨwe pemewitɨkɨni, 'inɨari niukiyari mɨpaɨ paine».  
\v 5 Herurexi Wani pɨmiemɨkɨkai, peru teɨteri pɨwamakarɨkai, kename Kakaɨyari niukameya hɨkɨtɨkai memɨteku'eriwakaikɨ.  
\v 6 Merikɨtsɨ Herurexi kepauka mutinuiwaxɨ 'ixɨarariyari wewiekaku, Heruriya niweya 'ukatɨtɨ katiniutineini wahɨxie, pinakixɨ Herurexi,  
\v 7 'ayumieme yurikɨ kaniyɨhɨritɨani, kename tita mɨtitawawirienike timinikekai.  
\v 8 'Iya maamaya yatitahɨaweku, mɨpaɨ katinitahɨawe: «Wani Ti'ɨyame mu'uya keneneu'ɨitɨa hikɨ xakɨtsie yekaime».   
\p
\v 9 Hikɨ ti'aitame waɨkawa kaniuyukahiwerieni, peru mɨyɨhɨritɨakaikɨ teɨteri hamatɨana memɨtekwakai wahɨxie, katiniuta'aita mɨkɨ mɨtiyetuiriyarienikɨ,  
\v 10 hikɨ katiniutanɨ'ani Wani mu'uya manutixitekienikɨ katsariyanata.  
\v 11 Mu'uya kani'atɨarieni xakɨtsie yekaitɨ, hikɨ 'ɨimari kaniyetuiriyarieni, mɨkɨta yumaama kaniyetuirieni.   
\p
\v 12 Hikɨ Wani teyɨ'ɨkitɨwametemama me'u'axɨaka meneikweni kaxarieya, mekanikateuku. 'Arike mekanekɨne Ketsutsi mekateniutaxatɨani.   
\s1 Ketsutsi 'auxɨwime miriyari kemɨtiwarumi  
\r (Mat 14:13-21 – Mar 6:32-44, Ruk 9:10-17, Wa 6:1-13)  
\p
\v 13 Merikɨtsɨ Ketsutsi mɨkɨ tiutamarieka, kaneyani kanuwatsie kayerɨka makumawetsie paitɨ yuxaɨta. Teɨteri mete'utamarieka, yɨ'ɨkama mekanekɨne mekanenukuweiya yukiekaritetsie meyekɨneka.   
\p
\v 14 Hikɨ kepauka Ketsutsi manatitɨa kanuwatsie, teɨteri kaniwaruxeiya yumɨireme, hikɨ kaniwarutinenimayata, 'aixɨa meteheu'eriekame kaniwarayeitɨani memɨtekukuyekai.   
\p
\v 15 Hikɨ tau 'akayunirɨmekaku teyɨ'ɨkitɨwamete 'auriena mekaniuyukuxeɨrieni, mɨpaɨ me'utiyuatɨ:  
\p —'Ena kanakumaweni, kananukayaniri memɨtekwanikekai. Keniwarutateutɨari teɨteri, kiekaritetsie memɨtayeixɨanikɨ, 'ikwai memɨteheyutinanairienikɨ.   
\p
\v 16 Ketsutsi mɨpaɨ katiniwaruta'eiya:  
\p —Pɨkaheuyewetse memɨyehukɨ. Xeme pɨta xeketeniwarumikwa.   
\p
\v 17 Mɨkɨ mɨpaɨ mekatenita'eiya:  
\p —Ketɨri 'ena tixaɨtɨ tepɨkatehexeiya, paa 'auxɨwime meta tsapari yuhutame xeikɨa tepɨwarexeiya.   
\p
\v 18 Mɨpaɨ katiniwarutahɨawe Ketsutsi:  
\p —'Ena nehetsɨa xeketenatua.   
\p
\v 19 Hikɨ katiniwaruta'aitɨani teɨteri memɨkuyaxixɨanikɨ 'ɨxapa, paa 'auxɨwime 'anu'ɨka meta tsapari meyuhutame, taheima heutinieretɨ pamɨpariyutsi Kakaɨyari kaniupitɨani. Hikɨ paa 'utitaraka kaniwaru'ɨitɨani teyu'ɨkitɨwamete, mɨkɨta mekaniwaruta'ɨitɨani teɨteri.  
\v 20 Yunaitɨ mekateniukwani mekaniutihuxani, hikɨ teyu'ɨkitɨwamete mekanikuxeɨrieni tarimeyari muyuhayewaxɨ, mekanitihɨniya tamamata heimana huta tsikɨiwitiyari.  
\v 21 Memɨte'ukwai 'ukitsi 'auxɨwime miriyari yakɨtɨtɨ mekaniyupaɨmekaitɨni, meka'inɨaritɨ 'ukari meta tɨɨri.   
\s1 Ketsutsi haa heima kemɨtiumiekai  
\r (Mat 14:22-36 – Mar 6:45-56, Wa 6:15-21)  
\p
\v 22 Hikɨ Ketsutsi teyɨ'ɨkitɨwamete kaniwarutamexɨitɨani kanuwatsie memɨkayaxekɨ mɨkɨ meri memɨyehukɨ 'anutaɨye paitɨ, mexi mɨkɨ teɨteri wateutɨanekai.  
\v 23 'Arike warutateutɨaka teɨteri, yemuritsie kaneutiyune yuxaɨta yutanenewienike. Hikɨ kaniukuyɨre mana 'ukaiku yuxaɨta,  
\v 24 meta kanuwa haa hixɨapa paitɨri kaniuyemiekaitɨni, hamewari kanenutawayakaitɨni, hepana meuye'ekakaikɨ.  
\v 25 Merikɨte 'etsiwatɨkaku kahekɨarirɨmekaku, wahepa kanamiekaitɨni Ketsutsi haa heima 'umietɨ.  
\v 26 Kepauka teyɨ'ɨkitɨwamete memixei haa heima 'amieme, waɨkawa mekaniutimamani, marikakɨ mɨpaɨ mekateniuhiwa:  
\p —Mɨki pɨyɨane.   
\p
\v 27 Peru kwitɨwa Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —Kayuwatɨ xeketeneuyaxi. Ne nepɨyɨane. Xepɨkamamaka.   
\p
\v 28 Hikɨ Pekuru mɨpaɨ katinita'eiya:  
\p —Ti'aitame, xɨka 'ekɨ peyɨaneni, kenetineuta'aitɨa mana nemɨmiekɨ 'ahetsɨa, haa heima ne'umietɨ.   
\p
\v 29 Ketsutsi mɨpaɨ kaniutayɨni:  
\p —Kenaye'a.  
\p Pekuru kanuwatsie kananatiyani, hikɨ haa heima kaniumiekaitɨni Ketsutsi hepa.  
\v 30 Peru, kepauka 'eka mɨ'eni kemɨtitɨrɨkaɨyekai, kaniutimani, 'ana kanitsutɨani kayunirɨmetɨ. Hikɨ mɨpaɨ katiniuhiwa:  
\p —Ti'aitame, keneneutawikweitsitɨa.   
\p
\v 31 Hikɨ Ketsutsi yumamakɨ 'iwiyaka, mɨpaɨ katinitahɨawe:  
\p —'E'e, kari 'ekɨ 'etsiwa xeikɨa yuri pepɨti'erie. ¿Titayari peti'a'iyaritɨakai?   
\p
\v 32 Kepauka kanuwatsie memɨkayaxixɨ 'eka kaneunuani.  
\v 33 Mɨkɨ kanuwatsie memɨyetekai hɨxiena metitunuma'utɨ mɨpaɨ mekatenitahɨawe:  
\p —Yurikɨ Kakaɨyari nu'aya 'ekɨ pekanihɨkɨtɨni.   
\p
\v 34 Hikɨ 'anutaɨye meheutanexɨaka, Kenetsareti kwieyaritsie mekaniye'axɨani.  
\v 35 Mana kiekatari Ketsutsi mekanetimani, hikɨ niuki mekaneutanɨ'axɨani yu'aurie kiekatari yunaime wahetsɨa. Mekani'atɨiriwakaitɨni tekwikwikate yunaime,  
\v 36 waɨkawa me'iwawirietɨ muwapitɨakakɨ tsikere 'ixurikieya tetsimeyaritsie memimayɨanikɨ, yunaitɨ kemɨ'ane memimayɨa 'aixɨa meteheu'erietɨ mepakɨkakai.   
\c 15  
\s1 Mɨti'itiya meta mɨkati'itiya  
\r (Mat 15:1-20 – Mar 7:1-23)  
\p
\v 1 Merikɨtsɨ 'ana Ketsutsi hetsɨa mekaniu'axɨani paritseutsixi meta 'inɨarikɨ memɨte'ɨkitametetɨkai, Kerutsareme memeyekɨnekai, mɨpaɨ mekatenita'iwawiya:   
\p
\v 2 —¿Titayari 'ahetsɨa miemete teyɨ'ɨkitɨwamete yamekatekahu yututsima wayeiyaritsie? Mepɨka'ukamaimawa kepauka memɨte'utikwa'a.   
\p
\v 3 Ketsutsi mɨpaɨ katiniwaruta'eiya:  
\p —¿Titayarita xeme yaxekateyurie Kakaɨyari kemɨti'aita, yuyeiyaritsie xetewiyatɨ?  
\v 4 Kakaɨyari mɨpaɨ katiniuta'aita: “Yaketinekamieni kememaitɨka 'apaapa meta 'amaama”, metatsiere: “Kemɨ'ane 'axamutaineni yupaapa meta yumaama wahepaɨtsita, ke'umierieni”.  
\v 5 Xemeta, 'apɨta, mɨpaɨ xekateni'ɨkitani kename xewitɨ yɨwe mɨpaɨ mɨtitahɨawe yupaapa yatɨni yumaama: “Nepɨkayɨwe nemɨmatsi'uparewieni, naime nemɨrexeiya Kakaɨyari nemɨtiyetuirikɨri”.  
\v 6 Merikɨte kemɨ'ane mɨpaɨ mɨtayɨni, waɨriyarika pɨkapitɨarieri yupapama muwaparewienikɨ. Mɨpaɨ yuyeiyari xete'uweiyatɨ tixaɨtɨ katihɨkɨtɨme xepayeitɨa Kakaɨyari niukieya.  
\v 7 Xemɨte'itawamete. Kitsariyaxi 'aixɨa putayɨ tihekɨatatɨ xehepaɨtsita, mɨpaɨ 'utaitɨ:   
\q1
\v 8 »“'Ikɨ teɨteri yutenikɨ xeikɨa 'aixɨa meputiyuane nehepaɨtsita,  
\q2 peru wa'iyari 'ateewa puyeika.   
\q1
\v 9 Yakɨ xeikɨa mekanenayexeiyani,  
\q2 tita memɨte'ɨkita teɨteri wa'aitsika xeikɨa pɨhɨkɨ”».   
\p
\v 10 Merikɨtsɨ Ketsutsi yu'aurie waruta'inieka teɨteri, mɨpaɨ katiniwarutahɨawe:  
\p —Xekeneu'enana meta xeketenemaiwaweni.  
\v 11 Tita ka'itiyakame tewi mɨrayeitɨwa, tetana mɨranukayeikakɨ mɨkɨkɨ 'axapɨka'itɨarieni. Matsi tita tetana mɨratineikakɨ, mɨkɨkɨ pɨta ka'itiyatɨ payeika.   
\p
\v 12 Hikɨ teyɨ'ɨkitɨwamete 'ahurawa me'ukɨneka mɨpaɨ mekatenitahɨawe:  
\p —¿Mɨpaɨ petimate, paritseutsixi 'aniuki me'u'enieka mɨkawarunakixɨ?   
\p
\v 13 Mɨkɨ mɨpaɨ katiniwaruta'eiya:  
\p —Naitɨ 'iteɨri ne'ukiyari taheima makawe mɨka'ika'e pɨwatihunaxɨani.  
\v 14 Xekeniwahayewani, me'akɨkɨpetɨ mepɨwarahapana hipame. 'Akɨpetɨ xeime makɨpe xɨka hehana, yuhutatɨ mewatixawatsie meneukaxɨriekuni.   
\p
\v 15 Hikɨ Pekuru mɨpaɨ katinitahɨawe:  
\p —Ketaneutahekɨatsitɨiya 'ikɨ 'ɨkitsika.   
\p
\v 16 Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —Kari xemeta 'atsixepɨkatemate.  
\v 17 Tamɨ tita teta mɨranukayeika yuriepa nikayuyuipikeni, 'ariketa kanihɨamɨkɨ.  
\v 18 Peru tita teta mɨrayeneika 'iyaritsie patineika, mɨkɨkɨ tewi 'axakani'itɨarieka.  
\v 19 Karikɨ 'iyaritsie katinatineikani 'axa'iyaritɨarika, xeime kemɨtiumieni, xeime kemɨtiukumayɨani kayɨ'ɨya kayɨkɨna, kememɨteyukumaɨwa teɨteri kemɨkatiheitserie, 'inawari, 'itarika meta 'axaniuki hipame wahepaɨtsita.  
\v 20 'Ikɨ katinihɨkɨtɨni tewi ka'itiyakame memayeitɨwa, xɨka tiukwani kamaimatɨ mɨkɨkɨ tewi ka'itiyatɨ pɨkahayeika.   
\s1 Yuri kemɨti'eriekai 'uka Kanani kiekame  
\r (Mat 15:21-28 – Mar 7:24-30)  
\p
\v 21 Merikɨtsɨ mana mɨyetɨa Ketsutsi, kaneyani Tiru kwieyaritsie meta Tsiruni.  
\v 22 Hikɨ mana 'uka Kanani kiekame, mɨkɨ kwieyaritsie heyeyaka, hepana kaniuyani mɨpaɨ 'utaitɨ:  
\p —Kenenenenimayaka, Ti'aitame, Rawiri pemɨnu'aya. Neniwe 'uka waɨkawamekɨ pɨtiuka'eniwa, kakaɨyari 'axamɨ'ane 'inɨkaku.   
\p
\v 23 Peru Ketsutsi pɨka'ita'ei. Hikɨ 'ahurawa me'akɨneka teyɨ'ɨkitɨwamete, mɨpaɨ mekatenitahɨawe:  
\p —Kenanunɨ'a, pɨtatsi'uweiya xeikɨa 'utahiwatɨ.   
\p
\v 24 Ketsutsi mɨpaɨ kaniutayɨni:  
\p —Ne Kakaɨyari muxatsimama memeuyexɨri wahetsɨa xeikɨa nekaneyenɨ'arieni, 'ixaheritsixi teɨteriyari wahetsɨa.   
\p
\v 25 'Uka 'ahurawa 'ayaka kaniutihɨximakeni hɨxiena, hikɨ mɨpaɨ katinitawawirieni:  
\p —Ti'aitame 'aku, keneneuparewi.   
\p
\v 26 Mɨkɨ mɨpaɨ katinita'eiya:  
\p —'Aixɨa pɨka'ane xɨka yuniwema paa warunawairieni, tsɨikɨri pɨta xɨka warumini.   
\p
\v 27 'Uka mɨpaɨ katinitahɨawe:  
\p —Yuri peputaine Ti'aitame, peru 'atsita tsɨikɨri temɨxikiyari mepukukwa'a wakutsiyarima wamexatsie manakawiwike.   
\p
\v 28 Hikɨ Ketsutsi mɨpaɨ katinita'eiya:  
\p —'Uka 'aku, waɨkawa yuri pepɨti'erie. Yakereyɨni tita pemɨra'iwawa.  
\p Hikɨ 'ana kwitɨwa 'aixɨa reu'erietɨ kanayani nu'aya.   
\s1 Ketsutsi kemɨtiwarumi nauka miriyari  
\r (Mat 15:29-39 – Mar 7:31-37, 8:1-10)  
\p
\v 29 Merikɨte Ketsutsi mana kaniyeyani, hikɨ Karereya harakunayari tetsita paitɨ kaninuani. Mana yemuritsie kanitiyune mana kanayerɨni.  
\v 30 Hikɨ hetsɨana mekaniu'axɨani yumɨiretɨ teɨteri, mekaniwa'atɨani memɨ'ɨkatetutuni, memɨkaheuneniere, memɨwaritutuni, memɨkaniuwawe meta hipame tekwikwikate, hɨxiena mekaniwa'atɨani, mɨkɨta 'aixɨa meteheu'eriekame kaniwarayeitɨani.  
\v 31 Hikɨ teɨteri mekanihɨxiyakaitɨni mewaxeiyatɨ memɨkaniuwawekai me'utiniukame, memɨwaritutunikai 'aixɨa me'aneneme, memɨ'ɨkatutunikai meku'uwame, meta memɨkaheunenierekai meheuneniereme mewaxeiyatɨ. 'Aixɨa mekaniutiyuanekaitɨni 'ixaheritsixi yukakaɨyari hepaɨtsita.   
\p
\v 32 Hikɨ Ketsutsi yu'aurie waruta'inieka yuhetsɨa miemete teyɨ'ɨkitɨwamete, mɨpaɨ katiniwarutahɨawe:  
\p —Ne 'ikɨ teɨteri nepɨwareunenimaya, haika tukari mekaniyuriekari nehetsɨa meta 'ikwai mepɨkahexeiya. Nepɨkanewaɨriya mekatekwakame nemɨwarutateutɨani, kapa mehetiweranaxɨame mehekaxɨrieni huyeta.   
\p
\v 33 Hikɨ teyɨ'ɨkitɨwamete mɨpaɨ mekatenita'eiya:  
\p —¿'Ena makumawetsie hakewa tepeikaxeiya paa mɨyapaɨmeme temɨtewaminikɨ teɨteri mɨyameyupaɨmeme?   
\p
\v 34 Ketsutsi mɨpaɨ katiniwaruta'iwawiya:  
\p —¿Kepaɨmeme paa xepexeiya?  
\p Mɨkɨ mɨpaɨ mekaniutiyuani:  
\p —'Atahutame, meta tsapari yayupaɨmeme 'etsimepepeme.   
\p
\v 35 Hikɨ katiniuta'aita teɨteri 'amemukuyaxixɨanikɨ kwiepa.  
\v 36 Paa 'atahutame 'anu'ɨka meta tsapari, pamɨpariyutsi Kakaɨyari kaniupitɨani, hikɨ kanititara paa meta kaniwayetuirieni teyɨ'ɨkitɨwamete. Mɨkɨta teyɨ'ɨkitɨwamete teɨteri mekaniwaruta'ɨitɨani.  
\v 37 Yunaitɨ mekateniukwani yemekɨ mekaniutihuxani. 'Arike teyɨ'ɨkitɨwamete mekanikuxeɨrieni tarimeyari muyuhayewaxɨ, 'atahuta tsikɨiwitiyari hɨpɨnetɨ patɨa.  
\v 38 Memɨte'ukwai 'ukitsi nauka miriyari mekaniyupaɨmekaitɨni, 'ukari meta tɨɨri meka'inɨaritɨ.  
\v 39 Hikɨ warutateutɨaka teɨteri, kanuwatsie kanikayerɨni, Makarani kwieyaritsie kaneyani.   
\c 16  
\s1 Ketsutsi 'inɨari kemɨtiutawawiyarie  
\r (Mat 16:1-12 – Mar 8:11-21)  
\p
\v 1 Merikɨtsɨ paritseutsixi meta tsarutseutsixi Ketsutsi 'aurie mekaniu'axɨani, me'i'inɨatakutɨ, 'inɨari mekanitawawirieni muyuawitsie mieme memixeiyakɨ.   
\p
\v 2 Mɨkɨ mɨpaɨ katiniwaruta'eiya: «Taikai, xeme mɨpaɨ xeputiyuane, 'uxa'a xɨari tsipɨreu'aneni, kamɨ haiwitɨri nixuxureni,  
\v 3 meta ximeri mɨpaɨ xeputiyuane, kename kawiye haiwitɨri 'aheutsuye. Xeme xepimate kemɨtiyuxexeiya haiwitɨri, peru xepɨkayɨwawe xemeitimani hikɨ kenemɨtiyuriene mɨkɨ Kakaɨyari 'inɨarieya kanihɨkɨtɨni.  
\v 4 Hikɨ miemete teɨteri 'axamemɨteyurie meta hipame memɨwakumaɨwa, 'inɨari mepɨkuwautɨwe memixeiyakɨ, peru 'inɨari mepɨkapitɨarieni, Kunatsi 'inɨarieya xeikɨa mekanipitɨariekuni». Hikɨ Ketsutsi waruku'eirieka kaneyani.   
\s1 Tiyukuxanariyame paritseutsixi wahetsɨa mɨmieme  
\p
\v 5 Merikɨte harakuna 'anutaɨye mekananukɨne, peru teyɨ'ɨkitɨwamete paa memanu'ɨnikekai mekatenatɨmaiyakaitɨni.   
\p
\v 6 Hikɨ Ketsutsi mɨpaɨ katiniwarayehɨtɨani:  
\p —Yumarima 'aixɨa, xekeneyɨ'ɨwiyani tiyukuxanariyame paritseutsixi meta tsarutseutsixi wahetsɨa mieme hepaɨtsita.   
\p
\v 7 Mɨkɨ mɨpaɨ mekateniyutahɨawekaitɨni: «Paa temɨkaheye'ɨikɨ 'ayumieme mɨya kanaineni».  
\v 8 Ketsutsi retimaika kememɨteyɨtahɨawekai, mɨpaɨ kaniutayɨni:  
\p —¿Titayari niuki xetexɨatɨa paa tepɨkahexeiya xeteyɨkɨhɨawetɨ? 'Etsiwa kari yuri xepɨte'erie.  
\v 9 ¿'Akuxi 'atsixekatehetimaiwawe? ¿Tamɨ xekatehe'eriwa 'auxɨwime payarikɨ yu'auxɨwime miriyari memɨte'ukwai, meta kepaɨmeme kiriwayari xemekuxeɨri?  
\v 10 ¿Meta xekatehe'eriwa 'atahuta payarikɨ nauka miriyari memɨte'ukwai, meta kepaɨmeme kiriwayari xemekuxeɨri?  
\v 11 ¿Titayari 'atsixekateheitimaitɨkɨka kename ne paa nekaxatakai? Tawarita mɨpaɨ nepɨxerahɨawe: Xekeneyukweriwayurieka tiyukuxanariyame paritseutsixi meta tsarutseutsixi wahetsɨa mieme hepaɨtsita.   
\p
\v 12 'Anake yamekatenetimani kename memɨyɨ'ɨwiyanikɨ paa kuxanariyame hepaɨtsita kahainekai, matsi paritseutsixi meta tsarutseutsixi wa'ɨkitsika hepaɨtsita memɨyɨ'ɨwiyanikɨ pɨta hainekai.   
\s1 Pekuru kemɨtiyutahekɨataxɨ  
\r (Mat 16:13-16 – Mar 8:27-30, Ruk 9:18-20)  
\p
\v 13 Merikɨte kepauka Ketsutsi Tsetsareya Piripu kwieyaritsie munua, yuhetsɨa miemete teyɨ'ɨkitɨwamete mɨpaɨ katiniwaruta'iwawiya:  
\p —¿Teɨteri keme'utiyuane nehepaɨtsita, Yuri Tewi kenemɨtihɨkɨ?  
\p Mɨkɨ mɨpaɨ mekatenita'eiya:   
\p
\v 14 —Hipatɨ mɨpaɨ meputiyuane kename Wani Ti'ɨyame pehɨkɨ, hipatɨta kename 'Eriyaxi pehɨkɨ, meta hipatɨta kename Keremiyaxi pehɨkɨ, yatɨni kename xewitɨ Kakaɨyari niukameya pepɨhɨkɨ.   
\p
\v 15 Hikɨ mɨpaɨta katiniwarutahɨawe:  
\p —Xemeta, ¿kexe'utiyuane kemɨ'ane nepɨyɨane ne?   
\p
\v 16 Tsimuni Pekuru mɨpaɨ katinita'eiya:  
\p —'Ekɨ Kɨritsitu pekanihɨkɨtɨni, Kakaɨyari mayeniere Nu'aya.   
\p
\v 17 Hikɨ Ketsutsi mɨpaɨ katinitahɨawe:  
\p —'Aixɨa pepɨ'itɨarie 'ekɨ, Tsimuni Kunatsi pemɨnu'aya, tewi mɨmɨwe pɨkamatiutahekɨatɨa, matsi ne'ukiyari taheima makawe pɨta.  
\v 18 Netsɨ mɨpaɨ nekamatinahɨaweni 'ekɨ Pekuru\f + \fr 16:18 \fq Pekuru\ft . \fq Tete\ft  panuyɨne.\f* pekanihɨkɨtɨni, 'ikɨ tetetsie nepɨwatsutɨani memɨyutixexeɨriwani nehetsɨa miemete, meta mɨkɨ mepɨka'a'iwarieni tsepa memukwi'iwaxɨ.  
\v 19 Yawi nepɨmatsitɨkitɨani mɨreuyepiwa hakewa Kakaɨyari mɨre'aita, tita pemɨtihɨani kwiepa taheimata pehɨiyani, meta tita kwiepa pemɨtixɨna taheimata pexɨnarieni.   
\p
\v 20 Hikɨ 'ana kaniwaruhɨritɨani teyɨ'ɨkitɨwamete nixeime memɨkatehaxaxatɨwanikɨ kename mɨkɨ Kɨritsitu hɨkɨtɨkai.   
\s1 Ketsutsi kemɨtiwarutaxatɨa kemɨtimierienikekai  
\r (Mat 16:21-28 – Mar 8:31-9:1, Ruk 9:22-27)  
\p
\v 21 Merikɨtsɨ 'ana Ketsutsi kanitsutɨani yuhetsɨa miemete teyɨ'ɨkitɨwamete mɨpaɨ tiwakuxaxatɨwatɨ: «Kaneuyeweka Kerutsareme nemɨmiekɨ, meta waɨkawa nemɨtikwinekɨ ta'ukiyarima meta mawari wewiwamete tewa'aitɨwamete wahetsɨa, meta 'inɨarikɨ memɨte'ɨkitamete wahetsɨa, mana nekanimieriemɨkɨ, matsi hairieka tukari nepanukukeni».  
\v 22 Hikɨ Pekuru yatewa heiwitɨka kanitsutɨani 'iku'imaiyatɨ, mɨpaɨ 'utaitɨ:  
\p —Tixaɨ Ti'aitame. Mɨpaɨ pepɨka'itɨarieni.   
\p
\v 23 Ketsutsi kwi 'enutaxeiyatɨ mɨpaɨ Pekuru katiniutahɨawe:  
\p —Xaɨtsie keneuye'a, Kauyumarie. Pepɨnetsikunuitɨamɨkɨ, Kakaɨyari hepaɨ pepɨkare'iyari, teɨteri wahepaɨ pɨta pepɨre'iyari.   
\p
\v 24 Hikɨ Ketsutsi mɨpaɨ katiniwarutahɨawe yuhetsɨa miemete teyɨ'ɨkitɨwamete:  
\p —Xɨka xewitɨ yuwaɨriyani tiyu'ɨkitɨwame nehetsɨa mieme mayani, ketihayewani kemɨtinake yuhetsiemieme tiyurienetɨ, yukuruxi ke'utitɨni, kenetsi'uweiyani.  
\v 25 Kemɨ'ane yutukari mɨwikweitsitɨamɨkɨ, kanitatɨmaiyamɨkɨ, peru kemɨ'ane yutukari mɨtatɨmaiya nehetsiemieme, kanikaxeiyamɨkɨ.  
\v 26 Tixaɨtɨ pɨkarayeika xɨka tewi kwiepa timieme naime ra'iwa, yaxeikɨa yutukari kanitatɨmaiyamɨkɨ. Nixewitɨ pɨkayɨwe mɨtiyutuani yutukari hetsiemieme.  
\v 27 Yuri Tewi kenemɨtihɨkɨ, nekaninuamɨkɨ ne'ukiyari hepaɨ nemariwetɨ neniuki tuayamete wahamatɨa, hikɨ 'ana nepɨtiwarakapitɨani, yuxexuitɨ kememɨte'uyuri.  
\v 28 Yurikɨ mɨpaɨ nepɨxerahɨawe, hipatɨ 'ena memu'uwa mepɨkakwini Yuri Tewi menetsixeiyameke neye'akaku nemɨra'aitatsie.   
\c 17  
\s1 Yɨkɨ tiyuxexeiyatɨ kemɨratɨa  
\r (Mat 17:1-13 – Ruk 9:28-36, Mar 9:2-13,)  
\p
\v 1 Merikɨtsɨ 'ataxewi tukari 'anukayaku, Ketsutsi kaniwarewitɨni Pekuru, Kakuwu, meta 'iwaya Wani, yemuri 'emutewitsie yɨhɨkɨame.  
\v 2 Hikɨ mana wahɨxie yɨkɨ 'anetɨ kanayani, yuhɨxie kanayexawatɨre tau hepaɨ, meta 'ixurikieya tuxatɨ xawatɨtɨ kanayani.  
\v 3 Hikɨ, me'ixeiyakaku Muitsexi meta 'Eriyaxi mekaniuyuhekɨata hamatɨana mekatenikuxatakaitɨni.  
\v 4 Hikɨ Pekuru mɨpaɨ Ketsutsi katiniutahɨawe:  
\p —Ti'aitame, 'aixɨa kani'aneni, 'ena temu'uwakɨ tame. Xɨka mɨpaɨ matinakeni, 'ena haikame xamaru nepɨtiwewieni: 'ahetsiemieme xeime, Muitsexi hetsiemieme xeime meta 'Eriyaxi hetsiemieme xeime.   
\p
\v 5 Hikɨ 'utaniukakaku 'akuxi, yapauka haiwitɨri xawatɨtɨ kaniwaranukanani, hikɨ mɨkɨ haiwitɨritsata xewitɨ kanetaniuni mɨpaɨ 'utaitɨ: «'Ikɨ kanineniwetɨni neminaki'erie, mɨkɨkɨ waɨkawa nekaniyutemawieka. Xekene'enieka».   
\p
\v 6 Me'i'enieka teyɨ'ɨkitɨwamete, mekaniutihɨxima'uni kwinimieme metemamatɨ.  
\v 7 Ketsutsi 'aurawa 'ayaka, warutimayɨaka mɨpaɨ katiniwarutahɨawe:  
\p —Xekenanuku'uti, xepɨkaheumamaka.   
\p
\v 8 Kepauka memanukunenierixɨ, Ketsutsi xeikɨa mepuxei, tawari xeime mepɨka'uxei.   
\p
\v 9 Hikɨ yemuritsie me'akahutɨ, Ketsutsi mɨpaɨ katiniwaruhɨritɨani:  
\p —Nixeime xepɨkatehaxaxatɨwani kexemɨte'unenierixɨ, kepaukake Yuri Tewi kenemɨtihɨkɨ, mɨkite watsata nemanukuketɨarieni.   
\p
\v 10 Hikɨ teyɨ'ɨkitɨwamete mɨpaɨ mekatenitahɨawe:  
\p —¿Mɨkɨ 'inɨarikɨ memɨte'ɨkitamete titayari mɨpaɨ mete'utiyuane kename heuyewetse 'Eriyaxi meri munuani?   
\p
\v 11 Ketsutsi mɨpaɨ katiniwaruta'eiya:  
\p —Kaniyuritɨni. 'Eriyaxi meri kaninuamɨkɨ, 'aixɨa mɨtiyurienikɨ tinaime.  
\v 12 Matsi ne mɨpaɨ nepɨxerahɨawe, 'Eriyaxi 'ari kaninuani, peru mepɨkaheitima me'ixeiyakatɨtɨ, matsi kemɨtiwanakekai yamepiyuri. Yaxeikɨata Yuri Tewi kenemɨtihɨkɨ mɨpaɨ nepɨtikwine mɨkɨ mepɨnetekwinitɨani.   
\p
\v 13 'Ana mɨpaɨ mepɨtehetima teyɨ'ɨkitɨwamete, Wani Ti'ɨyame mɨxatakaikɨ.   
\s1 Ketsutsi kemɨrenayehɨa temaikɨ mɨkierixiekai  
\r (Mat 17:14-19 – Mar 9:14-29, Ruk 9:37-43)  
\p
\v 14 Merikɨtsɨ kepauka memu'axɨa teɨteri yumɨiretɨ memanu'uwatsie, xewitɨ tewi 'ahurawa kaniuyani hetsɨana, 'utitunumakeka hɨxiena, mɨpaɨ kaniutayɨni:   
\p
\v 15 —Ti'aitame 'aku, neniwe keneutinenimayata. Putarɨwewe meta waɨkawa yemekɨ pɨtiuka'eniwa. Heiwa taipa kaneuwautseni heiwata hapa.  
\v 16 Nekaniwa'atɨirieni 'ahetsɨa miemete teyɨ'ɨkitɨwamete, peru mepuyutatexi 'aixɨa reu'eriekame memayeitɨanikɨ.   
\p
\v 17 Hikɨ Ketsutsi mɨpaɨ kaniutayɨni:  
\p —Xeme hikɨ xemɨmiemete yuri xepɨkate'erie meta kemɨkatiheitserie xepɨteyurie. ¿Kepaɨmexɨa peuyewetse 'akuxi xehamatɨa nemuyeikani? ¿kepaɨmexɨa 'akuxi nepɨxenewieka? Xekenawitɨki 'ena nehetsɨa.   
\p
\v 18 Ketsutsi kakaɨyari 'axamɨ'ane kaniutatieni, hikɨ mɨkɨ kanayeyani temaikɨtsie, 'anatɨtɨ 'aixɨa reu'erietɨ kanayani temaikɨ.   
\p
\v 19 Hikɨ 'arike teyɨ'ɨkitɨwamete 'ahurawa mekaniukɨne Ketsutsi 'aurie, yɨhɨkɨate, mɨpaɨ mekatenita'iwawiya:  
\p —¿Titayari tame teteyutatexi te'eyenɨ'anike?   
\p
\v 20 Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —'Etsiwa xeikɨa yuri xemɨte'eriekɨ, 'ayumieme xepitatexi. Yurikɨ mɨpaɨ nepɨxerahɨawe, xɨka mutsitatsa 'imɨariyari hepaɨ 'etsipemekɨ xɨka yuri xete'eriekake, xepɨyɨwawenike mɨpaɨ xemɨte'itahɨawe 'ikɨ yemuri: “Keneu'apata huma pɨta”, mɨkɨ kaniyupatakeyu. Xehetsiemieme katiyɨwetɨ pɨtiumawenike.  
\v 21 Peru yunenewietɨ yuhakietɨ xeikɨa kaniyɨweni meyenɨ'anikɨ mɨpaɨ mɨ'ane.   
\p
\v 22 Merikɨtsɨ meyuxeɨrietɨ Karereyatsie, mɨpaɨ katiniwarutahɨawe Ketsutsi: «Yuri Tewi kenemɨtihɨkɨ, nekaniyetuiyamɨkɨ teɨteri wahetsɨa.  
\v 23 Mɨkɨ mekanenimiekuni, peru hairieka tukaritsie nekananukukemɨkɨ». Hikɨ teyɨ'ɨkitɨwamete waɨkawa mekaniyuhiweriekaitɨni.   
\s1 Ketsutsi kemɨtiuyutua tuki hetsiemieme  
\p
\v 24 Merikɨtsɨ Ketsutsi meta teyɨ'ɨkitɨwamete kepauka Kaperunaume memu'axɨa, mɨkɨ tuki 'amɨpatsie mieme tumini memukuxexeɨriwa meniu'axɨani Pekuru hetsɨa, mɨpaɨ mekatenitahɨawe:  
\p —¿Tixe'ɨkitɨwame tuki 'amɨpatsie mieme tiyukutuaya?   
\p
\v 25 Pekuru mɨpaɨ kaniutayɨni:  
\p —Huu, pɨtiyukutuaya.  
\p Hikɨ kiita heutahaku 'atsikatayɨwekaku 'akuxi, Ketsutsi meri mɨpaɨ katinitahɨawe:  
\p —¿Kepetiku'eriwa 'ekɨ Tsimuni? Te'aitamete kwiepa memɨtama, ¿kemɨ'ane mepɨwakwetatɨa 'amemɨtewarapiniriekakɨ meta memɨteyutuakakɨ: yuniwema nutsu hipame?   
\p
\v 26 Pekuru mɨpaɨ kaniutayɨni:  
\p —Hipatɨ mepɨteyukutuaya.  
\p Ketsutsi mɨpaɨ katinitahɨawe:  
\p —Merikɨte, waniwema mepɨkateyukutuaya.  
\v 27 Peru, temɨkawahaxɨatɨakakɨ 'ikɨ teɨteri, 'ayumieme harakunatsie kenemie, mana keneukawiwi kwaitsɨ. Ke'anetɨ meri manuwiere ketsɨ, mɨkɨ kenanatihani, pehenutatetapieme mana tumini pepetaxeiya 'auxɨwime 'inɨariyari. Mɨkɨ keniwaye'ɨi meta keneyetua nehetsiemieme meta 'ahetsiemieme.   
\c 18  
\s1 Kemɨ'ane matsi mɨwe'eme  
\r (Mat 18:1-5 – Mar 9:33-37, Ruk 9:46-48)  
\p
\v 1 Merikɨte 'ana Ketsutsi 'aurie 'ahurawa mekaniukɨne teyɨ'ɨkitɨwamete, mɨpaɨ me'utiyuatɨ:  
\p —¿Kemɨ'ane pɨhɨkɨ matsi waɨkawa meuyewetse, Kakaɨyari mɨra'aitatsie?   
\p
\v 2 Ketsutsi nunutsi kaniuta'inieni, hikɨ wahixɨapa kanitakeni.  
\v 3 Mɨpaɨ kaniutayɨni:  
\p —Yurikɨ mɨpaɨ nepɨxerahɨawe, xɨka xekate'uhayewa 'axaxeteyurietɨ, tɨɨri wahepaɨ xe'anenetɨ xɨka xekahakɨne, xepɨkaheutahaxɨani Kakaɨyari mɨra'aitatsie.  
\v 4 Kemɨ'ane yuhepaɨtsita 'atsika'utaitɨ mayuyeitɨani 'ikɨ nunutsi hepaɨ, mɨkɨ kanihɨkɨtɨkamɨkɨ waɨkawa meuyewetse Kakaɨyari mɨra'aitatsie.   
\p
\v 5 »Meta kemɨ'ane mitanaki'erieni xeime nunutsi 'ikɨ hepaɨ 'aneme, nehetsɨa mɨmiemekɨ, mɨkɨta ne pɨnetsitanaki'erieni.  
\v 6 Peru, kemɨ'ane yamɨtiyurieni 'axamɨtiyurienikɨ xewitɨ 'ikɨ tɨɨri yuri memɨte'erie nehetsie, 'aixɨa kaniyɨnikeyu matsi xɨka tete matayari mahete 'akatɨtɨarienike meta xɨka haramaratsie heukahɨiyanike meukatewatsie.   
\p
\v 7 »Kwiepa waɨkawa pɨtixuawe kɨmana teɨteri 'axamemɨteyurie. Kaneuyewekatsɨ teɨteri memɨkunuitɨarienikɨ, peru xɨa'ui mɨkɨ tewi kemɨ'ane mɨwakunuitɨani.  
\v 8 Xɨka 'amamakɨ yatɨni 'a'ɨkakɨ 'axapetiyurieneni, kenawiteki kenehɨwa. 'Aixɨa kaniyɨmɨkɨ matsi pemeutahanikɨ tukari maxuawetsie pemamapurutɨ yatɨni pe'ɨkapurutɨ, keyuri huta mamayari meta huta 'ɨkayari pehexeiyatɨ xɨka peheukahɨiyani tai yuheyemekɨ mɨta'atsie.  
\v 9 Meta, xɨka 'ahɨxikɨ 'axapetiyurieneni, keniwayetu'i kenehɨwa. Matsi 'aixɨa kaniyɨmɨkɨ tapa xeikɨa peheunieretɨ pemeutahanikɨ tukari maxuawetsie, keyuri naitsata peheunieretɨ xɨka peheukahɨiyani mɨrataiyarietsie.   
\s1 Muxa meuyewe niukiyari  
\r (Mat 18:12-14 – Ruk 15:3-7)  
\p
\v 10 »Yumarima 'aixɨa xeime xepɨkananaimaka 'ikɨ tɨɨri. Mɨpaɨ nepɨxerahɨawe, mɨkɨ waniuki tuayamete yuheyemekɨ 'amekaniu'uwani ne'ukiyari taheima makawe hɨxie, mepɨte'ikuxaxatɨwa.  
\v 11 Karikɨ Yuri Tewi nehɨkɨtɨtɨ kenemɨtinua, memeuyexɨri newatawikweitsitɨanike nekaninuani.   
\p
\v 12 »¿Kexeteku'eriwa? Xɨka tewi xeitsienituyari warexeiyani yumuxatsi, xɨka xewitɨ mɨkɨ heuyeweni, ¿katiwaku'eirieni hɨritsie nauka tewiyari heimana tamamata heimana 'atanauka memɨyupaɨme, katiwaumie meuyewe?  
\v 13 Yurikɨ mɨpaɨ nepɨxerahɨawe, xɨka 'aku heitaxeiya, mɨkɨ muxakɨ kaniyutemawieka matsi waɨkawa, kemɨkatiyutemawie memɨkaheuyexɨri wahekɨ nauka tewiyari heimana tamamata heimana 'atanauka memɨyupaɨme.  
\v 14 Mɨpaɨ yaxeikɨa, xe'ukiyari taheima makawe pɨkayuwaɨriya meuyeweni xewitɨ 'ikɨ tɨɨri.   
\s1 Kemɨreuyewetse yu'iwa mɨreuyehɨwirieni  
\p
\v 15 »'A'iwa xɨka 'axa'utayɨni 'ahepaɨtsita, hetsɨana kenemie yaketineutahɨawi yɨhɨkɨate xeti'utɨ 'ekɨ mɨkɨ hamatɨa. Xɨka matsi'u'enieni, 'a'iwa pɨhɨkɨtɨni xepuyunaki'erieka.  
\v 16 Mexɨka kamatsi'u'enieni, xeime kenanuwitɨki yatɨni yuhutame memɨtetamarienikɨ, mɨkɨ “tsepa titakɨ mɨti'ayumieme 'aixɨa pɨtiyɨni yamehaitɨkaikaku yuhutatɨ yatɨni yuhaikatɨ memunenierixɨ”.  
\v 17 Xɨka mɨkɨ kawaru'enieni, yaketiniwarutahɨawi memɨyutixexeɨriwa, mexɨka kawaru'enieni memɨyutixexeɨriwa, kemɨ'ane tanuiwaritsie mɨkamieme hepaɨ ketineuxeiya yatɨni tiyukwamaname hepaɨ.   
\p
\v 18 »Yurikɨ mɨpaɨ nepɨxerahɨawe, tita xemɨtehɨani 'ena kwiepa, mɨkɨ pɨrehɨiyani taheimata, meta tita xemɨtexɨna 'ena kwiepa, mɨkɨta pɨrexɨnarieni taheima.   
\p
\v 19 »Tawarita mɨpaɨ nepɨxerahɨawe, yuhutatɨ xeme xeyu'enietɨ xɨka yaxeikɨa xeteyumaika 'ena kwiepa tita xemɨtetawauni hepaɨtsita, tsepa kemɨtitita, ne'ukiyari taheima makawe mɨpaɨ katinixepitɨamɨkɨ.  
\v 20 Karikɨ hakewa yuhutatɨ yuhaikatɨ memeyuxeɨrie menetsitahɨaweke, mana nepuyeikani watsata».   
\s1 Tewi yu'iwa mɨkareuyehɨwiri  
\p
\v 21 Pekuru Ketsutsi 'aurie 'ahurawa 'uyaka mɨpaɨ katinitahɨawe:  
\p —Ti'aitame, ¿kepaɨmexɨa nepɨreiyehɨwirieka ne'iwa, nehepaɨtsita xɨka 'axa'utayɨni? ¿'Atahutamexɨa wa'atɨ?   
\p
\v 22 Ketsutsi mɨpaɨ katinitahɨawe:  
\p —Ne 'atahutamexɨa nepɨkahaine, matsi haika tewiyari heimana tamamata heimana 'atahutamexɨa pɨta.   
\p
\v 23 »'Ayumieme nepaine, Kakaɨyari mɨra'aitatsie, mɨpaɨ kani'aneni, tewi yukwiepa mɨti'aitametɨkai hepaɨ, mɨpaɨ mɨtiuta'ai, te'uximayatametemama memɨte'ipitɨanikɨri kepaɨmeme memɨtehepiniriekai.  
\v 24 Merikɨtsɨ 'itsutɨaku wawawirietɨ, xewitɨ hetsɨana pɨ'atɨarie, mɨrepiniriekai xeimiriyari miriyari tumini 'inɨariyari.  
\v 25 Mɨkaheixeiyakaikɨ kɨmana mɨtiyutuani, mɨkɨ ti'aitame pɨtiuta'ai memɨtuiyanikɨ mɨkɨ tewi, 'ɨyaya meta tɨɨriyamama metatsiere piiniteya, mɨkɨ tuminiyarikɨ 'aixɨa mɨyɨnikɨ kemɨrapikai.  
\v 26 Hikɨ hetɨana kaniutihɨximakeni ti'uximayatame mɨpaɨ 'utaitɨ: “Kenenekwewieka kwerietɨ, naime nepɨmatipitɨani”.  
\v 27 Hikɨ mɨkɨ ti'uximayatame kutsiyarieya 'inenimayatɨ kanixɨna, pɨreiyehɨwiri kepaɨmeme mɨrepiniriekai.   
\p
\v 28 »Merikɨtsɨ ti'uximayatame hewayeyaka kaneikaxeiya yuhepaɨ ti'uximayatame, mɨrepiniriekai xeitsienituyari tumini 'inɨariyari. 'Iwiyaka kɨipitɨana mɨpaɨ katinitahɨawe: “Keneneu'ɨitɨa kepaɨmeme pemɨnerapinirie”.  
\v 29 Hikɨ hetɨana kaniutihɨximakeni 'iwaya ti'uximayatame, mɨpaɨ 'utaitɨ: “Kenenekwewieka kwerietɨ, naime nepɨmatipitɨani”.  
\v 30 Peru mɨkɨ pɨkayuwaɨri. Matsi katiniuta'aita katsariyanata manutahɨiyanikɨ muwa muwayexɨnekɨ tiyutuameke.  
\v 31 Hikɨ kepauka hipatɨ te'uximayatamete memixei kemɨtiuyuri, kwini mieme mekaniyutihiwerieni, meta mekanekɨne kutsiyarieya hetsɨa mekateneitaxatɨani naime kemɨtiuyɨ.  
\v 32 Hikɨ kutsiyarieya 'itakwewieka mɨpaɨ katinitahɨawe: “Kari 'axapepɨtiuka'iyari. Kamɨ ne nepɨmareuyehɨwiri tita pemɨnerapiniriekai naimekɨ, 'ekɨ haweri pemutainekaikɨ.  
\v 33 ¿Mɨpaɨ kareuyewekai 'ekɨtari peminenimayakakɨ 'iya 'ahepaɨ ti'uximayatame, yaxeikɨa kenemɨmatiutinenimayataxɨ ne?”  
\v 34 Kutsiyarieya ha'atɨ yemekɨ kaniyetuani teyu'uximatɨwamete wahetsɨa 'atsita kepaukake mɨtiyutuanikekai.   
\p
\v 35 »Yaxeikɨata ne'ukiyari taheima makawe pɨxeyurieni xɨka yuxexuitɨ 'aixɨa 'iyarikɨ xekatewareuyehɨwiriwani yu'iwama».   
\c 19  
\s1 Ketsutsi kemutayɨ 'eiriya hepaɨtsita  
\r (Mat 19:1-9 – Mar 10:1-12)  
\p
\v 1 Merikɨtsɨ Ketsutsi tiutahayewaka tikuxatatɨ, Karereya kwieyaritsie kanayeyani, Kureya kwieyaritsie kaneyani Kurutani hatuxameyaritsie 'anutaɨye.  
\v 2 Teɨteri yumɨiretɨ mekaniweiyakaitɨni, meta mana tekwikwikate 'aixɨa meteheu'eriekame kaniwarayeitɨani.   
\p
\v 3 Hikɨ paritseutsixi hetsɨana mekaniu'axɨani me'ita'inɨatake, mɨpaɨ mekatenitahɨawe:  
\p —¿Tiyɨwe tewi yɨ'ɨya muku'eirieni tsepa titakɨ?   
\p
\v 4 Ketsutsi mɨpaɨ katiniwaruta'eiya:  
\p —¿Xekate'ekaterɨwawawe, mɨkɨ matɨaripai mɨwarunetɨa, “'uki meta 'uka mɨwarutiwewi”,  
\v 5 meta mɨpaɨ mutayɨ: “'Ayumieme 'uki kaniyupatamɨkɨ, yupaapa yumaama wahetsɨa kaniyeyeimɨkɨ, yɨ'ɨyatsie katiniwiyamɨkɨ pɨta, memɨyuhutakai xeiwaiyari mekanakɨnikuni meyuxewitɨ”?  
\v 6 'Ayumieme mepɨkayuhutari, matsi mekaniyuxewini xeiwaiyari mepɨhɨkɨ. 'Ayumieme, tita Kakaɨyari mɨtiutaxewiriyaxɨ, tewi pɨkawataxɨrɨwani.   
\p
\v 7 Peru mɨkɨ mɨpaɨ mekatenitahɨawe:  
\p —Merikɨte, xɨka mɨpaɨ 'aneni, ¿titayari, Muitsexi mɨpaɨ tiu'aitaxɨ, kename yu'ɨya 'eiriya xapayari ke'ihuritɨani hikɨ 'ana ke'iku'eirieni?   
\p
\v 8 Mɨkɨ mɨpaɨ katiniwarutahɨawe:  
\p —Muitsexi yu'iyaritsie xemɨtsetse'ikɨ kanixe'upitɨani xemɨwaku'e'eiriwanikɨ yu'ɨitama. Peru matɨari paitɨ mɨpaɨ pɨka'anekai.  
\v 9 Ne mɨpaɨ nepɨxerahɨawe, kemɨ'ane miku'eiri yu'ɨya, xeime pɨta mɨtiwitɨ, mɨkɨ xeime 'ɨyaya kanikumaɨwani, mexɨka 'ɨyaya meri 'ikumayɨani xeime mɨkayɨkɨna hɨrixɨa.\f + \fr 19:9 \ft RV60 hikɨ pananɨitɨa \fq meta kemɨ'ane mitiwitɨni 'uka muku'eiriwaxɨ, mɨkɨta kanikumaɨwamɨkɨ xeime 'ɨyaya.\f*   
\p
\v 10 Hikɨ teyɨ'ɨkitɨwamete mɨpaɨ mekatenitahɨawe:  
\p —Xɨka mɨpaɨ 'aneni 'uki 'uka hamatɨa kemɨtiwayakɨ, 'aixɨa pɨ'ane matsi xɨka tewi kaneɨkenike.   
\p
\v 11 Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —'Ikɨ niuki yunaime wahetsie pɨkamieme, mɨkɨ mɨpaɨ memɨtepitɨarie wahetsie xeikɨa kanimiemetɨni.  
\v 12 Hipatɨ mepɨkaneɨkiwawe mɨpaɨ me'anenetɨ memutinunuiwaxɨkɨ, hipatɨta mepɨkaneɨkiwawe mɨpaɨ me'aneneme teɨteri memɨwarayeitɨakɨ, hipatɨta yɨkɨmana mepɨkaneɨkiwawe memɨte'uximayakakɨ xeikɨa Kakaɨyari hetsiemieme. Kemɨ'anetsie mɨmieme 'ikɨ, hetsiena ketinakeni.   
\s1 Ketsutsi kemutayɨ tɨɨri wahetsiemieme  
\r (Mat 19:13-15 – Mar 10:13-16, Ruk 18:15-17)  
\p
\v 13 Merikɨtsɨ 'ana tɨɨri mekani'atɨarieni Ketsutsi hetsɨa, wahetsie 'utimeme mɨyutanenewienikɨ, peru teyɨ'ɨkitɨwamete mekaniwarutate'akaitɨni memɨwa'atɨwakai.   
\p
\v 14 Ketsutsi mɨpaɨ katiniwarutahɨawe: «Xekeniwapitɨaka tɨɨri nehetsɨa memɨ'axenikɨ, wahɨxie xepɨka'u'uka, mɨpaɨ memɨ'anene kaniwahetsiemiemetɨni Kakaɨyari mɨra'aita».  
\v 15 Hikɨ wahetsie 'utimeka kaneyani.   
\s1 Temaikɨ mɨxikutɨkai  
\r (Mat 19:16-29 – Mar 10:17-30, Ruk 18:18-30)  
\p
\v 16 Hikɨ xewitɨ tewi hetsɨana kaninuani mɨpaɨ katinita'iwawiya:  
\p —Ti'aitame 'aku, ¿kehapaɨ 'aixɨa nepɨtiyurieni, tukari mɨkaxɨwe nehexeiyatɨ nemayanikɨ?   
\p
\v 17 Ketsutsi mɨpaɨ katinita'eiya:  
\p —¿Titayari penetiku'iwawiya tita 'aixɨa mɨti'ane hepaɨtsita? Kemɨ'ane 'aixɨa mɨ'ane yuxewitɨ 'apuyeika Kakaɨyaritɨtɨ. Xɨka peheutahamɨkɨ tukari maxuawetsie, yaketinekamieni 'inɨari niukiyaritsie.   
\p
\v 18 Tewi mɨpaɨ katinitahɨawe:  
\p —¿Kemɨ'ane 'aitsikate?  
\p Ketsutsi mɨpaɨ katinita'eiya:  
\p —“Pepɨkati'amemiwani, xeime 'ɨyaya kɨnaya pepɨkakumaɨwani, pepɨkatinawayani, peti'itawatɨ pepɨkatihekɨatani,  
\v 19 keniwareu'enieka meta keniwa'ɨwiyani 'apaapa meta 'amaama”, meta “'ahepaɨ tewi kenenaki'erieka kepemɨti'anaki'erie 'ekɨ”.   
\p
\v 20 Hikɨ temaikɨ mɨpaɨ katinitahɨawe:  
\p —Mɨkɨ naimetsie yanepɨtikamie temaikɨyari paitɨ. ¿Tita 'akuxi reuyewetse?   
\p
\v 21 Ketsutsi mɨpaɨ katinitahɨawe:  
\p —Xɨka pe'awaɨriyani naimekɨ yapemɨtikamienikɨ, kenemie ketinetua 'apiini, ketiniwarumikwa tixaɨtɨ memɨkatehexeiya, mɨpaɨ petiyurieme waɨkawa perexeiyatɨ pepayani taheima. 'Ana kenaye'a nehetsie ketineuwiya.   
\p
\v 22 Kepauka temaikɨ 'ikɨ niuki mu'eni kaneyani yuhiwerietɨ, waɨkawa mɨrexeiyakaikɨ.   
\p
\v 23 Hikɨ Ketsutsi mɨpaɨ katiniwarutahɨawe yuhetsɨa miemete teyɨ'ɨkitɨwamete:  
\p —Yurikɨ mɨpaɨ nepɨxerahɨawe, kanikwaniweni xiku meutahanikɨ Kakaɨyari mɨra'aitatsie.  
\v 24 Tawari mɨpaɨ nepɨxerahɨawe, pɨkakwaniwe kameyu 'iwipame hɨxieyatsie manuyehanikɨ matsi pɨkwaniwe xiku meutahanikɨ Kakaɨyari mɨra'aitatsie.   
\p
\v 25 Me'u'enanaka teyɨ'ɨkitɨwamete yemekɨ meputimama mɨpaɨ memɨkatemaikaikɨ, mɨpaɨ mekaniutiyuanekaitɨni:  
\p —Kamɨtsɨ xɨka mɨpaɨ 'aneni, ¿kemɨ'ane pɨyɨwe mɨtawikweni?   
\p
\v 26 Hikɨ Ketsutsi kwi waxeiyatɨ mɨpaɨ katiniwarutahɨawe:  
\p —Teɨteri mepɨkayɨwawe, peru Kakaɨyari naimekɨ kaniyɨweni.   
\p
\v 27 Hikɨ Pekuru mɨpaɨ katinitahɨawe:  
\p —Neuxei, tame tepɨte'uku'eiri naime 'ahetsie temɨtewiyakɨ, merikɨte, ¿mɨkɨkɨ tita teteha'iwa?   
\p
\v 28 Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —Yurikɨ mɨpaɨ nepɨxerahɨawe, xeme nehetsie xemɨtewiya, kepauka kwie mɨhekwatsie temɨ'axɨani, Yuri Tewi nehɨkɨtɨtɨ kepauka ne'uwenitsie nemayerɨni neti'aitatɨ witsine'anetɨ, 'ana xemeta 'itsɨkate xekanakɨnikuni, tamamata heimana huta 'uweniyaritsie xe'ayaxeme xekateniwata'aitɨakuni teɨteri tamamata heimana huta 'Ixaheri nuiwarimama.  
\v 29 Kemɨ'ane nehetsɨa mɨmiemekɨ miku'eiri yukii, yu'iwama 'ukitsi 'ukari, yupaapa, yumaama, yuniwema, yukwie, mɨkɨ xeitsienituyari matsi warexeiyatɨ kanayeimɨkɨ, meta tukari mɨkaxɨwe hexeiyatɨ kanayeimɨkɨ.  
\v 30 Peru yumɨiretɨ hikɨ miemete memɨmexɨakate 'imatɨremete mekanakɨnikuni, meta yumɨiretɨ memɨ'imatɨremete mexɨakate mekanakɨnikuni.   
\c 20  
\s1 Kaxie haraweriyarita te'uximayatamete  
\p
\v 1 »'Ipaɨ katini'aneni Kakaɨyari kemɨti'aita, tewi kiekame ximeri paitɨ mayetɨa hepaɨ kani'aneni wata'inienike te'iwamete haraweritana kaxie 'inɨiyarikɨ memɨteta'iwakɨ.  
\v 2 Yatiwarutahɨaweka xeitukaritsie mieme kemɨtiyutuanikekai, kaniwarenɨ'ani yuharawerita.  
\v 3 Hikɨ tau 'anatineku, heyaka kaniwaruxeiyata hipame kiekari hixɨapa metiteme mekate'iwatɨwetɨ.  
\v 4 Mɨpaɨ katiniwarutahɨawe: “Xemeta neharawerita xekenehu, kemɨtiheitserie nepɨtixepitɨani”.  
\v 5 Hikɨ mɨkɨ mekanekɨne. Merikɨte tawarita kanayeyani tuka, 'anata yaxeikɨa katiniuyurieni, meta tawarita tau kɨa kawiekaku.  
\v 6 'Akayunirɨmekakuta kanayeyani, hipame tawarita kaniwaretaxeiya mekate'uximayakame. Mɨpaɨ katiniwarutahɨawe: “¿Titayari 'ena xetetitei tukarikɨ xekate'iwatɨwetɨ?”  
\v 7 Mɨkɨ mɨpaɨ mekatenitahɨawe: “Xewitɨ pɨkatatsita'iniewe”. Mɨkɨ mɨpaɨ katiniwarutahɨawe: “Xemeta neharawerita xekenehu”.   
\p
\v 8 »Hikɨ 'ukutaikaireku haraweri kutsiyari mɨpaɨ katinitahɨawe yuparewiwame: “Te'iwamete keniwarukuxeɨri meta ketiniwarupitɨa, xike miemetexi meri 'imatɨrieka ximeri miemetexi”.  
\v 9 Hikɨ mekaniu'axɨani 'akayunirɨmekaku memuta'inierie xeitukaritsie mieme meniuta'ɨitɨarieni yuxexuitɨ.  
\v 10 'Ayumieme kepauka matɨari memuta'inierie memu'axɨa, mɨpaɨ meteniku'eriwakaitɨni waɨkawa matsi me'ɨitɨarienike meniyu'eriekaitɨni, peru mɨkɨta yaxeikɨa xeitukaritsie mieme mekaniuta'ɨitɨarieni yuxexuitɨ.  
\v 11 Kepauka memenu'ɨi yu'iwarika, menitiniukimatɨkɨne harawerikame.  
\v 12 Mɨpaɨ me'utiyuatɨ: “Mɨkɨ 'imatɨriekake memuta'inierie xeihurayari mepuyuri xeikɨa, matsi yaxeikɨa pepɨtiwarupitɨa tahepaɨ tsepa tame temɨte'uka'eniwakai tukarikɨ meta tsepa temɨkwaxiyatɨkatei xɨripa tame”.  
\v 13 Peru mɨkɨ xeime mɨpaɨ katiniuta'eiya: “Nehamiku, kemɨkatiheitserie nepɨkatiuyuri 'ahepaɨtsita. ¿Pekatiu'awaɨri kenemainekai xeitukari hetsiemieme kenemɨmatipitɨanikekai?  
\v 14 'Ayumieme kenanu'ɨi 'atumini, hikɨ kenemie. Nepɨnewaɨriya nemi'ɨitɨanikɨ 'ikɨ 'imatɨreme kenemɨmatiupitɨa 'ekɨ.  
\v 15 ¿Katiyɨwe mɨpaɨ nemɨtiyurienenikɨ netuminikɨ kemɨnetinake? ¿Peti'ɨtetsa 'aixɨa nemɨtiuka'iyarikɨ hipame wahamatɨa?”   
\p
\v 16 »Mɨpaɨ, mɨkɨ hikɨ memɨ'imatɨremete mexɨakate mekanakɨnikuni, meta memɨmexɨakate 'imatɨremete mekanakɨnikuni».\f + \fr 20:16 \ft RV60 penanɨitɨa \fq Karikɨ yumɨiretɨ mekaniuta'inierieni, peru hipatɨ xeikɨa mepanayexeiyarie\ft . Peru kɨriyekutsie pɨka'ayemie.\f*   
\s1 Tawarita Ketsutsi kemutayɨ kemɨtimierienikekai  
\r (Mat 20:17-19 – Mar 10:32-34, Ruk 18:31-33)  
\p
\v 17 Merikɨtsɨ Ketsutsi Kerutsareme heyaka huyeta 'umietɨ, yatewa kaniwarewitɨni tamamata heimana memɨyuhuta yɨhɨkɨame, mɨpaɨ katiniwarutahɨawe:  
\v 18 «Neuxei, Kerutsareme tepɨtiyune hikɨ, Yuri Tewi kenemɨtihɨkɨ nekaniyetuiyamɨkɨ mawari wewiwamete tewa'aitɨwamete wahetsɨa meta 'inɨarikɨ memɨte'ɨkita wahetsɨa. Mɨkɨ yamekanitiyuakuni kename neke'umierieni,  
\v 19 meta mekaneniyetuakuni mɨkɨ memɨkahuriyutsixi wahetsɨa memɨnetsitewiyatsitɨanikɨ, memɨnetsikuwaxɨanikɨ meta kuruxitsie memɨnetsimienikɨ. Peru hairieka tukari 'aye'ayu nekananukuketɨariemɨkɨ».   
\s1 Kakuwu Wani matɨa kememɨte'itawawiri  
\r (Mat 20:20-28 – Mar 10:35-45)  
\p
\v 20 Hikɨ Tsewereu niwemama wamaama, Ketsutsi 'aurie hurawa kaninuani yuniwema warawitɨtɨ, kaniutihɨximakeni hɨxiena, titawawirienike.   
\p
\v 21 Ketsutsi mɨpaɨ katinitahɨawe:  
\p —¿Tita pereuyehɨwa?  
\p Mɨkɨ 'ukaratsi mɨpaɨ katinitahɨawe:  
\p —Mɨpaɨ keneutayɨki, 'ikɨ neniwema yuhutatɨ 'ameke'ayaxe xewitɨ 'atserieta xewitɨta 'a'utata kepauka peti'aitatɨ pemayani.   
\p
\v 22 Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —'Atsixepɨkatemate tita xemɨteku'iwawa. ¿Xeteyuwaɨriya xemɨteka'eniexɨani naimekɨ ne kenemɨtika'eniexɨani?\f + \fr 20:22 \ft RV60 penanɨitɨa \fq meta ¿xeteyuwaɨriya kenemɨtika'ɨyarieni ne xemeta mɨpaɨ xemɨteka'ɨyarieni?\ft  Peru kɨriyekutsie pɨka'ayemie.\f*  
\p Mɨkɨ mɨpaɨ mekatenitahɨawe:  
\p —Huu, tepɨyɨwawe.   
\p
\v 23 Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —Yurikɨtsɨ nehepaɨ xekatenikwinikuni ne kenemɨtikwine. Peru heitserie nepɨkahexeiya nemɨxepitɨanikɨ netserieta ne'utata xemayaxekɨ. Matsi mɨkɨ puwahetsiemieme ne'ukiyari kemɨ'ane wahetsiemieme mikuha'aritɨa.   
\p
\v 24 Kepauka memu'enana hipatɨ tamamata, mekaniuyeha'ani mɨkɨ 'iwamarixi memuyuhuta wahepaɨtsita.  
\v 25 Ketsutsi yu'aurie waruta'inieka mɨpaɨ katiniwarutahɨawe:  
\p —Xeme mɨpaɨ xepɨtemate, mɨkɨ nuiwarite watsata memɨte'aitamete, mɨkɨ meteniwa'uxitɨaka yuteɨterima, meta ti'aitame hurawa parewiwametemama mepanutikɨka mete'aitatɨ kememɨtepitɨarie.  
\v 26 Peru mɨpaɨ pɨkatiyɨni xeme xetsata. 'Apɨta, xeme kemɨ'ane mariwetɨ mɨyeimɨkɨni, mɨkɨ yunaime xeparewiwame kehɨkɨtɨni,  
\v 27 meta kemɨ'ane mexɨakame mɨyeimɨkɨ xeme xewitɨ, hipame wahetsiemieme waɨriyarika ti'uximayatame kehɨkɨtɨni,  
\v 28 yaxeikɨa Yuri Tewi kenemɨtihɨkɨ, nepɨkanua nemɨparewiyakakɨ, matsi hipame newaparewienike nekaninuani meta netukari nemɨyetuanikɨ, yumɨireme nemɨwaxɨnakɨ.   
\s1 Kememɨte'anutanenierixɨ yuhutatɨ memɨkaheunenierekai  
\r (Mat 20:29-34 – Mar 10:46-52, Ruk 18:35-43)  
\p
\v 29 Merikɨtsɨ Keriku me'ayekɨnirɨmekaku, yumɨiretɨ teɨteri mekaniweiyakaitɨni.  
\v 30 Yuhutatɨ memɨkaheuneniere huye tetsita mekanikatekaitɨni, hikɨ mete'utamarieka kename Ketsutsi mana 'uyemiekai, mɨpaɨ mekateniuhiwa:  
\p —Ti'aitame, Rawiri pemɨnu'aya, ketaneutinenimayata.   
\p
\v 31 Teɨteri mekaniwarutite'akaitɨni kayuwatɨ memɨteyaxekɨ, peru matsi mɨkɨ karima mekaniutihiwatɨkɨne mɨpaɨ me'utiyuatɨ:  
\p —Ti'aitame 'aku, Rawiri pemɨnu'aya, ketaneutinenimayata.   
\p
\v 32 Hikɨ Ketsutsi 'ukukeka kaniwarutahɨawe, mɨpaɨ kaniutayɨni:  
\p —¿Tita xeteheuyehɨwa kenetiyurieni xehetsiemieme?   
\p
\v 33 Mɨkɨ mɨpaɨ mekatenitahɨawe:  
\p —Ti'aitame, tepeunenierenikeyu.   
\p
\v 34 Hikɨ Ketsutsi kaniwarutinenimayata, kaniwaramayɨaxɨani wahɨxita. 'Ana kwitɨ meheunenieretɨ mekanakɨne, hikɨ hamatɨana mekanekɨne.   
\c 21  
\s1 Kerutsareme hetsie kemɨreutaha  
\r (Mat 21:1-9 – Mar 11:1-10, Ruk 19:29-38, Wa 12:12-15)  
\p
\v 1 Kepauka Kerutsareme mehurakairi, meta Wetɨpake mɨrakutewatsie memu'axɨa, Huriwa Mati'u yemuriyari hetɨa, Ketsutsi teyɨ'ɨkitɨwamete yuhutame kaniwarutanɨ'ani,  
\v 2 mɨpaɨ tiwarutahɨaweka: «Kiekari 'anutaɨye mukumatsie xekenehu, kwitɨwa mana xekaneitaxeiyakuni puxu 'akuwiekame meta puxu temaikɨ hamatɨana. Xewarakuxɨname xekeniwarahapani nehetsɨa.  
\v 3 Xewitɨ xɨka yɨkɨ tixehetahɨawe, mɨpaɨ xepɨteheitahɨawe: Ti'aitame pɨwareuyehɨwa, kwitɨwata pɨwaranɨ'ani».   
\p
\v 4 Mɨpaɨ katiniuyɨni maye'anikɨ Kakaɨyari niukameya kemutayɨ:   
\q1
\v 5 «Mɨpaɨ xeketenetahɨawi Tsiyuni mɨrakutewa kiekame:  
\q2 “Neuxei, mati'aitɨwame 'ahetsɨa kanamieni,  
\q1 tixaɨtɨ karayuyeitɨatɨ meta puxutsie 'anakaitɨ,  
\q2 puxu temaikɨ hetsie, ti'ikatɨariwame nu'ayatsie”».   
\p
\v 6 Hikɨ teyɨ'ɨkitɨwamete mekanekɨne meta mɨpaɨ mekatenikakɨne kemɨtiwaru'aitɨa Ketsutsi.  
\v 7 Puxu mekaneyehana meta nu'aya temaikɨ, hikɨ yɨ'ɨkarite me'anuti'itaku, Ketsutsi kananutiyerɨni.  
\v 8 Yumɨiretɨ teɨteri huyeta mekani'itɨaximekaitɨni yɨ'ɨkarite, hipatɨ kɨye meheukuwiteketɨ mekani'itɨaximekaitɨni huyeta.  
\v 9 Teɨteri yumɨiretɨ memanuyetekai meta wa'utɨa memuhukai mekaniutihiwakaitɨni mɨpaɨ me'utiyuatɨ:  
\p —'Ari ketaneutawikweitsitɨa Rawiri Nu'aya.  
\b  
\p —'Aixɨa ke'itɨarieka kemɨ'ane 'umamie Ti'aitame hetsɨa miemetɨtɨ.  
\b  
\p —'Ari ketaneutawikweitsitɨa taheima pemakawe.   
\p
\v 10 Kepauka Ketsutsi Kerutsareme meutaha, yunaitɨ kiekatari mekananuku'uni, mɨpaɨ me'utiyuatɨ:  
\p —¿Kemɨ'aneta pɨyɨane 'ikɨ?   
\p
\v 11 Teɨteri mɨpaɨ mekateniwaku'eiyakaitɨni:  
\p —'Ikɨ Ketsutsi Kakaɨyari niukameya kaniyɨaneni, Natsareti kiekame Karereya kwieyaritsie.   
\s1 Ketsutsi tuki manuwe  
\r (Mat 21:12-16 – Mar 11:15-18, Ruk 19:45-47)  
\p
\v 12 Ketsutsi Kakaɨyari tukieya kuraruyarita kaneutahani, hikɨ muwa kaniwarayeweiya yunaime memɨtenanekai meta memɨtetuakai. Tumini patamete wamexate kanatixɨrieni meta kukuruxi watuayamete wa'ɨpari.  
\v 13 Mɨpaɨ katiniwarutahɨawe: «'Ipaɨ katine'uka: “Nekitsɨ mɨpaɨ katinitewakamɨkɨ nenewieri kiyari”. Peru xeme “tenawayamete waterɨ” xekanayeitɨani».   
\p
\v 14 Hikɨ tuki kuraruyarita 'uyeikakaku, memɨkaheunenierekai meta memɨhurietɨkatei hetsɨana mekaniu'axɨani, hikɨ mɨkɨ 'aixɨa me'aneneme kaniwarayeitɨani.  
\v 15 Hikɨ mawari wewiwamete tewa'aitɨwamete meta 'inɨarikɨ memɨte'ɨkitakai me'ixeiyaka mariwemekɨ kemɨtiyurienekai, meta mewaxeiyatɨ tɨɨri mɨpaɨ memɨte'uhiwakai tuki manuwe: «'Ari ketaneutawikweitsitɨa Rawiri Nu'aya». Mɨkɨ mekaniuyeha'ani.   
\p
\v 16 Mɨpaɨ mekatenitahɨawe:  
\p —¿Petiwa'enie 'iya kememutiyuane?  
\p Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —Huu, ¿kamɨtsɨ xeme xekate'ekaterɨwawawe 'ikɨ:  
\q1 »“Tɨɨri 'etsimemutɨtɨ  
\q2 meta tɨɨri memɨtsitsewe  
\q2 pepɨwarupitɨa 'ahepaɨtsita 'aixɨa memaitɨkanikɨ”?»   
\p
\v 17 Hikɨ kaniwaruku'eirieni, kiekaritsie kanayeyani, Wetaniya paitɨ kananuhuni.   
\s1 Xapa mutawa  
\r (Mat 21:18-22 – Mar 11:12-14, 20-24)  
\p
\v 18 Hikɨ ximeri paitɨ, tawari kiekaritsie yemieximetɨ, neuhakamɨkɨkaitɨni.  
\v 19 Xapa kɨyeyari 'uxeiyaka huye tetsita 'uweme, hepana kaneyani, peru tixaɨtɨ hetsiena pɨkatiukaxei xawari xeikɨa, hikɨ mɨpaɨ xapa katiniutahɨawe:  
\p —Tawari pepɨkatakaka.  
\p Hikɨ yapauka kaniutawani xapa.   
\p
\v 20 Me'ixeiyaka teyɨ'ɨkitɨwamete mekanimamakaitɨni, mɨpaɨ me'utiyuatɨ:  
\p —¿Kepaɨtɨtɨri yapauka tiutawa xapa?   
\p
\v 21 Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —Yurikɨ mɨpaɨ nepɨxerahɨawe, xɨka yuri xete'erieka, xɨka xe'iyari kahutani, 'ikɨ xapa hepaɨtsita kenemɨtiuyuri mɨpaɨ xeikɨa xepɨkateyurieni, matsi xepɨyɨwaweni 'ikɨ hɨri mɨpaɨ xemɨte'utahɨawe: “Keneu'apata, haramaratsie keneukawetsi”, hikɨ mɨpaɨ pɨtiyɨni.  
\v 22 Meta tita xeme, xeyunenewietɨ, yuri xete'erietɨ xemɨteta'iwauni, mɨkɨ xepɨteyetuiriyarieni.   
\s1 Ketsutsi heitserie kemɨrexeiyakai  
\r (Mat 21:23-27 – Mar 11:27-33, Ruk 20:1-8)  
\p
\v 23 Hikɨ Ketsutsi tuki manuwe kaneutahani, mexi ti'ɨkitakai, mawari wewiwamete tewa'aitɨwamete meta teɨteri wa'ukiyarima hetsɨana 'ahurawa mekaniukɨne, mɨpaɨ mekatenita'iwawiya:  
\p —¿Hakewa miemekɨ heitserie pehexeiyatɨ mɨya pepɨtiyuriene? ¿Kemɨ'ane mɨkɨ heitserie pɨmatsi'upitɨa?   
\p
\v 24 Ketsutsi mɨpaɨ katiniwaruta'eiya:  
\p —Netatsiere nepɨxeta'iwawiya. Xɨka xenetsi'uta'eiya, neta yanepɨtixetahɨawe kemɨ'ane heitserie mɨnetsi'upitɨa yanemɨtiyurienenikɨ 'ikɨ naime.  
\v 25 Wani kepauka mɨti'ɨyanekai, ¿hakewa pemiemetɨkai 'ɨyarikaya? ¿Taheima makawe tipitɨa, nutsu teɨteri mepipitɨa?  
\p Hikɨ mɨkɨ niuki mekaniutixɨatɨatɨkɨne mɨpaɨ meteyɨkɨhɨawetɨ yunaitɨ: «Xɨka tame mɨpaɨ te'utiyuani: “Taheima makawe pipitɨakai”, mɨkɨ mɨpaɨ pɨtatitahɨawe: “Merikɨte, ¿titayari yuri xekate'ita'eriri?”  
\v 26 Xɨkata mɨpaɨ te'utiyuani: “Teɨteri mepipitɨakai”, tepɨwamakaxe teɨteri, yunaitɨ Wani Kakaɨyari niukameya mepɨ'eriekai». Hikɨ Ketsutsi mɨpaɨ mekateniuta'eiya:   
\p
\v 27 —'Atsitepɨkatemate.  
\p Mɨkɨta mɨpaɨ katiniwarutahɨawe:  
\p —Merikɨte, neta 'atsinepɨkatixetahɨawe kemɨ'ane heitserie mɨnetsi'upitɨa yanemɨtiyurienenikɨ 'ikɨ naime.   
\s1 Tewi yuniwema yuhutame kemɨtiwarutahɨawixɨ  
\p
\v 28 »¿Kexeteku'eriwa 'ikɨ hepaɨtsita? Tewi yuniwema kaniwarexeiyakaitɨni yuhutame. Xeime hetsɨa nuaka mɨpaɨ katinitahɨawe: “Neniwe, hikɨ ketine'uximayatamie kaxie haraweriyarita”.  
\v 29 Nu'aya rehɨawe: “Ne nepɨkaheuyeimɨkɨ”. Peru 'arikeke yɨkɨtiyutihɨaweka kaneyani.  
\v 30 Hikɨ wapaapa yuniwe xeime hetsɨa pɨtata nuaka yaxeikɨa katinitahɨawe. Mɨkɨ mɨpaɨ katinita'eiya: “'Au, nepaapa”, peru pɨkahetɨa.  
\v 31 Merikɨte, ¿kemɨ'ane mɨkɨ yapɨtikatɨa paapaya kemɨtinakekai?»  
\p Mɨkɨ mɨpaɨ mekatenitahɨawe:  
\p —Matɨari mutanɨ'arie.  
\p Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —Yurikɨ mɨpaɨ nepɨxerahɨawe, mɨkɨ kuwiyexinu hetsiemieme tewawamete meta 'ukari tuminikɨ memɨyuwitɨnɨa meri mepeutahaxɨani Kakaɨyari mɨra'aitatsie keyuri xeme.  
\v 32 Karikɨ Wani xehetsɨa kaninuani huye xexeitsitɨanike, mɨtixetaxatɨanikɨ kemɨtiheitserie yaxemɨtekahunikɨ, xeme yuri xepɨkate'uta'eri hetsiena, peru mɨkɨ tewawamete meta 'ukari tuminikɨ memɨyuwitɨnɨa yuri mekateniuta'erieni hetsiena. Meta mɨkɨ xewaruxeiyakatɨtɨ, xemeta xepɨkate'uhayewaxɨ yuri xemɨteta'erienikɨ hetsiena.   
\s1 Te'ɨwiyamete 'axamemɨte'u'iyarikai  
\r (Mat 21:33-46 – Mar 12:1-12, Ruk 20:9-19)  
\p
\v 33 »Xeimeta 'ɨxatsi xekeneu'eni 'inɨarikɨ mɨtikuxata: Merikɨtsɨ xewitɨ kiekame kaxie haraweriyari kaniutawewieni. Kanikurarutɨiya, kaxie pɨname kaniwati'inieni, tuxiyu kaniutawewieni ti'ɨwiyame hetsiemieme.  
\p Hikɨ te'ɨwiyamete waruhɨritɨaka wakwetatɨatɨ, 'ateewa kaneyani.  
\v 34 Kepauka tukari maye'a matikwakwaxetsie, yuhetsɨa miemete te'uximayatamete kaniwarenɨ'ani te'ɨwiyamete wahetsɨa memenutɨnikɨ 'ikwaxi kutsiyari hetsiemieme kepaɨmetɨ mɨtinakekai.  
\v 35 Te'ɨwiyamete matsi mekaniwarutiwiya mɨkɨ te'uximayatamete, xeime mekaneutiwaxɨani, xeimeta mete'umi, meta xeime meteheutituaxixɨa.  
\v 36 'Arike tawarita hipame kaniwareyenɨ'ani te'uximayatamete, yumɨireme matsi, mɨkɨta yaxeikɨa mepɨwaruyuri.   
\p
\v 37 »'Imatɨrieka, kaniwarenɨ'airieni yuniwe, mɨpaɨ 'utaitɨ: “Neniwe hɨrixɨa mekanetimakakuni”.  
\v 38 Peru, kepauka te'ɨwiyamete nu'aya memuxei, mɨpaɨ mekateniuxata: “'Ikɨ hetsie 'arike katininakimɨkɨ kutsiyari tipiinieya. Hikɨmɨ tepimieni, tahetsie temɨtehɨnikɨ tita hetsiena mɨtinakekekai”.  
\v 39 Hikɨ mekaniwiya, haraweri warie mekaneikahɨani meta mekanimieni.   
\p
\v 40 »Merikɨte, kepauka munuani haraweri kutsiyari, ¿kewayurieni mɨkɨ te'ɨwiyamete?»   
\p
\v 41 Mɨpaɨ mekatenitahɨawe:  
\p —Mɨkɨ 'axamemɨte'u'iyari kaniwakwimɨkɨ kawanenimayatɨ, meta hipame pɨta kaniwahɨritɨamɨkɨ te'ɨwiyamete, 'ikwaxiyari kutsiyari memɨyetuirieni kepauka tukarieya maye'ani.   
\p
\v 42 Hikɨ Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —¿Xekate'ekaterɨwawawe 'utɨarika xapayaritsie:  
\q1 »“Mɨkɨ teté memitixani'eri kii wewiwamete  
\q2 mɨkɨ teté 'itsikina mieme kanayani,  
\q1 Ti'aitame mɨya katiniuyurieni,  
\q2 meta kanimariweni ketemɨte'ixeiya”?   
\p
\v 43 »'Ayumieme mɨpaɨ nepɨtixekɨhɨawe, xeme xepɨnawaiyarieni Kakaɨyari kemɨti'aita, hikɨ hipatɨ pɨta teɨteri mekaniyetuiriyariekuni 'ikwaxi memɨtixuawitɨani hetsiena mieme.  
\v 44 Xɨka xewitɨ 'iya tetetsie 'ukaweni pɨtanexɨani, xɨka mɨkɨ teté xeime hetsie 'ukaweni, kwauni xeikɨa pɨtanexɨani».   
\p
\v 45 Hikɨ mawari wewiwamete tewa'aitɨwamete meta paritseutsixi me'i'enieka 'ɨxatsieya, mɨpaɨ mekatenetimani mɨwaxatakaikɨ mɨkɨ.  
\v 46 Hikɨ mekatenikuwautɨwekaitɨni kememɨte'iwiyakɨ, peru 'atsimepɨkate'uyuri mewamakatɨ teɨteri, mɨkɨ mɨpaɨ memɨteku'eriwakaikɨ kename Kakaɨyari niukameya hɨkɨtɨkai Ketsutsi.   
\c 22  
\s1 Neɨkiya 'ixɨarariyari 'ɨxatsiyarikɨ kemɨti'ɨkitakai  
\p
\v 1 Merikɨtsɨ tawarita Ketsutsi 'ɨxatsikɨ katiniwa'ɨkitɨakaitɨni, mɨpaɨ 'utaitɨ:  
\v 2 «Kakaɨyari kemɨti'aita, tewi yukwiepa mɨti'aitametɨkai hepaɨ kani'aneni, neɨkiya 'ixɨarariyari muwewi yuniwe hetsiemieme.  
\v 3 Yuhetsɨa miemete te'uximayatamete kaniwarutanɨ'ani memɨwa'iniyukɨri mɨkɨ meripaitɨ memuta'inierie neɨkiyapa, peru mɨkɨ mepɨka'uyuwaɨri memayenexɨani.  
\v 4 Hikɨ tawari kaniwarutanɨ'ani te'uximayatamete hipame, mɨpaɨ tiwarutahɨaweka: “Memuta'inierie mɨpaɨ xeketeniwaretahɨawi kename 'ari ne'ikwai netiukawewi: 'Ari netuurutsixi mepukwi'iwaxɨ meta newakaitsixi memɨwaiyatɨka, 'ari naitɨ pɨtiha'aritsie. Xekenahu neɨkiya 'ixɨarariyaripa”.  
\v 5 Peru memuta'inierie mepɨkahanu'enana matsi meneutayeixɨani: xewitɨ kaneyani yukwie heuxeiyamieka, xewitɨta kaneyani mɨretuakakɨ.  
\v 6 Hipatɨta mekaniwarutiwiya te'uximayatamete, mekaniwarutiwani meta mekaniwarukwini.  
\v 7 Hikɨ ti'aitame kaniuyeha'ani. Yukuyaxima kaniwarutanɨ'ani memɨwakwinikɨ mɨkɨ teyumiekate meta wakiekari memɨtataiyakɨ.  
\v 8 Hikɨta mɨpaɨ katiniwarutahɨawe yuhetsɨa miemete te'uximayatamete: “Neɨkiya 'ixɨarariyari pɨkuha'aritsieri, peru 'iya memuta'inieriekai 'aixɨa pɨka'anekai memayenexɨanikekai.  
\v 9 'Ayumieme, xekenehu huyeta manuxexuitsie, hikɨ xekeniwareta'ini neɨkiya 'ixɨarariyaripa yunaime keyupaɨmeme xemɨwarekaxeiya”.  
\v 10 Hikɨ te'uximayatamete huyeta meheutayeixɨaka mekaniwarukuxeɨrieni yunaime keyupaɨmeme memɨwaretaxei, 'axamemɨte'u'iyari meta 'aixɨa memɨte'u'iyari, hikɨ mekaniutahɨne memuta'inierie hakewa neɨkiya mewewiyakai.   
\p
\v 11 »Merikɨte ti'aitame kepauka meutaha waxeiyake memuta'inierie, xeime tewi kaniuxeiya muwa 'ayekaime neɨkiyapa mieme 'ixuriki mɨka'anakatɨkɨkai.  
\v 12 Mɨpaɨ katinitahɨawe: “Nehamiku, ¿kepetiuha 'uwa neɨkiyapa mieme 'ixuriki peka'anakatɨtɨ?” Mɨkɨ kayuwatɨ tinikateitɨni.  
\v 13 Hikɨ ti'aitame mɨpaɨ katiniwarutahɨawe yuparewiwamete: “Xekenanahɨa 'ɨkateyatsie meta mamateyatsie, xekenanuyehɨwa takwa yɨwipa, mana putatsuakani meta puyutikeweni”.  
\v 14 Karikɨ yumɨiretɨ meputa'inierie, peru hipatɨ xeikɨa mepanayexeiyarie».   
\s1 Kuwiyexinu tuminieya  
\r (Mat 22:15-22 – Mar 12:13-17, Ruk 20:20-26)  
\p
\v 15 Hikɨ paritseutsixi mekanekɨne meta mepuyu'eni kememɨte'iwiyakɨ niukieyatsie.  
\v 16 Mekaniwarenɨ'ani yuhetsɨa miemete teyɨ'ɨkitɨwamete hetsɨana meta hipame Herurexi hetsie memɨtewiyakai, mɨpaɨ memɨte'itahɨawekɨ:  
\p —Ti'ɨkitame, tame mɨpaɨ tepɨtemate yurikɨ yapepɨtikamie, meta Kakaɨyari huyeya hepaɨtsita pepɨti'ɨkita yurikɨ. Yunaime yaxeikɨa pepɨtiwaxeiya, yayupaɨmeme xeikɨa pepɨkawanaki'erie.  
\v 17 Kamɨtsɨ ketatineutaxatɨa kepetiku'eriwa: ¿Ti'aitame Tsetsaxi tumini kemɨtiwawa, 'aixɨa ti'ane temɨteyutuaka nutsu pɨkatixaɨ?   
\p
\v 18 Ketsutsi timaitɨ 'axameteniukutɨ memutiyuanekaikɨ mɨpaɨ kaniutayɨni:  
\p —Xemɨte'itawamete. ¿Titayarikuta xenetewiniyatɨwe?  
\v 19 Tumini xeime xekeneneuxeitsitɨa kɨmana mɨtiuyutuani.  
\p Hikɨ xeituminiyari mekani'ɨitɨani.   
\p
\v 20 Hikɨ mɨpaɨ katiniwarutahɨawe:  
\p —¿Kepai ramu'u pɨra'uxa, kepai pɨra'utɨarika 'ikɨ?   
\p
\v 21 Mɨkɨ mɨpaɨ mekatenitahɨawe:  
\p —Tsetsaxi.  
\p Hikɨ mɨpaɨ katiniwarutahɨawe:  
\p —Kamɨtsɨ xeketeneyetua Tsetsaxi hetsɨa tita Tsetsaxi hetsɨa mɨtimieme, meta xeketeneyetua Kakaɨyari hetsɨa tita Kakaɨyari hetsɨa mɨtimieme.   
\p
\v 22 Hikɨ me'i'enieka mekaniutimamani, meta mekanekɨne mekaniku'eirieni.   
\s1 'Iwaurika mɨkite kememɨte'anuku'uni hepaɨtsita  
\r (Mat 22:23-33 – Mar 12:18-27, Ruk 20:27-40)  
\p
\v 23 Mɨkɨ tukaritsietsiere tsarutseutsixi hetsɨana mekaniu'axɨani, mɨkɨ mɨpaɨ meputiyuanekai kename mɨkite meka'anuku'uwe, hikɨ mɨpaɨ mekatenita'iwawiya:   
\p
\v 24 —Ti'ɨkitame, Muitsexi mɨpaɨ kaniutayɨni, tewi xɨka 'umɨni tɨɨri kawarayexeiyawetɨ, mutaya kanitiwitɨmɨkɨ yukwe, tɨɨri mɨwarayexeiya matsieya nuiwarieya memakɨnekɨ.  
\v 25 Merikɨte, tahetsɨa 'amenititekaitɨni 'iwamarixi 'atahuta meyupaɨmetɨ. Wamatsika 'utineɨkeka kaniumɨni, tɨɨri mɨkawarexeiyakaikɨ, yɨ'ɨya kaniuku'eirieni mutaya mitiwitɨnikɨ.  
\v 26 Mutaya yaxeikɨa katiniyurieni, 'itiwitɨka kaniumɨni, hairieka mieme meta, mɨpaɨ mekaniuyɨni yunaitɨ 'atahuta meyupaɨmetɨ.  
\v 27 'Imatɨrieka, kaniumɨni 'uka.  
\v 28 Merikɨte, kepauka xeniu memanuku'uni, ¿'atahuta meyupaɨmetɨ memitiwitɨ 'ikɨ 'uka, kemɨ'ane ra'ɨya pɨrayani?   
\p
\v 29 Ketsutsi mɨpaɨ katiniwaruta'eiya:  
\p —Xeme xepeuyexɨri xemɨka'imatekɨ 'utɨarika xapayari kemaine meta Kakaɨyari kemɨtitɨrɨkaɨye.  
\v 30 Kepauka mɨkite memanuku'uni mepɨkatineɨkixɨani meta mepɨkatiwikitɨariexɨani, matsi Kakaɨyari niukieya tuayamete taheima miemete wahepaɨ mepɨ'aneneni.  
\v 31 Peru, mɨkite kememɨte'anuku'uni kemɨre'uxa ¿kauka xeka'ekaterɨwawawe Kakaɨyari kemɨtixe'utahɨawixɨ, mɨpaɨ 'utaitɨ:  
\v 32 “Ne 'Apɨrahami, 'Itsahaki meta Kakuwu wakakaɨyari nekanihɨkɨtɨni”? Mɨkɨ mɨkite pɨkawaxata, kename wakakaɨyari maine. Memayeneniere pɨta wakakaɨyari kaniyuxatani, tsepa memukwi.   
\p
\v 33 Teɨteri me'u'enanaka, mekanimamakaitɨni 'ɨkitsikayakɨ.   
\s1 'Aitɨarika waɨkawa meuyewetse  
\r (Mat 22:34-40 – Mar 12:28-31)  
\p
\v 34 Hikɨ paritseutsixi mekaniuyukuxeɨrieni me'u'enanaka kayuwatɨ kememɨte'uyatsariekai tsarutseutsixi.  
\v 35 Hikɨ xewitɨ mɨkɨ, 'inɨari niukiyari mɨmaikai, kanita'inɨata mɨpaɨ tiku'iwawiyatɨ:   
\p
\v 36 —Ti'ɨkitame, ¿kemɨ'ane 'aitɨarika matsi peuyewetse 'inɨari niukiyari hetsiemieme?   
\p
\v 37 Ketsutsi mɨpaɨ katinitahɨawe:  
\p —“Kenenaki'erieka Ti'aitame 'akakaɨyari, naimekɨ kepemɨtiuka'iyari, naimekɨ kepemɨti'amate, naimekɨ pemɨtimaiwekɨ”.  
\v 38 'Ikɨ 'aitɨarika mexɨakame kanihɨkɨtɨni meta yemekɨ matsi waɨkawa meuyewetse.  
\v 39 'Utɨmana mieme hepaɨna kananuyɨneni: “'Ahepaɨ tewi kenenaki'erieka kepemɨti'anaki'erie 'ekɨ”.  
\v 40 'Ikɨ 'aitɨarika hutametsie naitɨ 'inɨari niukiyari hetsiena katiniwiyani meta texaxatamete waniuki naitɨ.   
\s1 Kɨritsitu kemɨ'ane pɨraniwe  
\r (Mat 22:41-46 – Mar 12:35-37, Ruk 20:41-44)  
\p
\v 41 Hikɨ mexi paritseutsixi meyuxeɨriekai, Ketsutsi mɨpaɨ katiniwaruta'iwawiya:   
\p
\v 42 —¿Kexeteku'eriwa Kɨritsitu hepaɨtsita? ¿Kemɨ'ane pɨranuiwari?  
\p Mɨkɨ mɨpaɨ mekatenita'eiya:  
\p —Rawiri kaninuiwarieyatɨni.   
\p
\v 43 Mɨkɨ mɨpaɨ katiniwarutahɨawe:  
\p —Titayaritsɨkamɨ, Kakaɨyari 'Iyarieya 'ikuyuitɨwakaku, Rawiri “Neti'aitɨwame” titerɨwaxɨ? Mɨpaɨ kaniutayɨni:   
\q1
\v 44 »“Ti'aitame mɨpaɨ katinitahɨawe kemɨ'ane Mɨneti'aitɨwame:  
\q2 ‘Netserieta kenakani,  
\q1 mexi mɨkɨ memɨmatsi'aka'unie,  
\q2 'ahetɨapai newa'atɨani’ ”.   
\m
\v 45 Merikɨte, xɨka Rawiri “Neti'aitɨwame” Kɨritsitu tiuterɨwani, ¿kehapaɨtɨtɨ nu'aya pɨhɨkɨtɨni?»   
\p
\v 46 Nixewitɨ pɨkayɨwekai mita'eiyakɨ, tawari nixewitɨ pɨkayuwaɨri tixaɨtɨkɨ mɨtita'iwawiyakɨ.   
\c 23  
\s1 Ketsutsi kemɨtiwaruniukima 'inɨarikɨ te'ɨkitamete meta paritseutsixi  
\r (Mat 23:1-7, 37-39 – Mar 12:38-39, Ruk 20:45-46, 13:34-35)  
\p
\v 1 Merikɨtsɨ Ketsutsi tiniwakuxaxatɨwakaitɨni teɨteri meta yuhetsɨa miemete teyɨ'ɨkitɨwamete, mɨpaɨ 'utaitɨ:  
\v 2 «Mɨkɨ 'inɨarikɨ memɨte'ɨkita meta paritseutsixi mekanihɨritɨarieka memihekɨatanikɨ 'inɨari niukiyari Muitsexi kemɨraka'utɨa.  
\v 3 'Ayumieme naime kememɨtexekɨhɨawe yaxeketeneyurieka yaxeketenekahuni, peru kememɨteyurie mɨkɨ yaxepɨkateyurieka xeme, karikɨ mɨkɨ kememɨtekuxata mɨpaɨ mepɨkateyurie.  
\v 4 'Ika mekaniukuha'aritɨani mahete mɨkwaniwetɨka, teɨteri wanaiparitsie mekaniwarutitɨtɨwani, peru mɨkɨ mepɨkayuwaɨriya niyu'itɨwamekɨ memɨwaparewienikɨ.   
\p
\v 5 »Naime kememɨteyurie, yamepɨteyurie teɨteri memɨwaxeiyakɨ xeikɨa: Yukanata mepeyatsatɨka nawi kakuniyari 'aneneme hetsiena niuki mɨye'uxa, meta 'apɨnene wa'ɨkari putuniyari.  
\v 6 Pɨwanake kiekame 'aurie memayaxekɨ 'ikwai 'ixɨararipa meta teɨteri wahɨxie memayaxekɨ tuki 'etsimɨpepeta,  
\v 7 meta pɨwanake waɨritsika memɨpitɨarieka kiekari hixɨapa meta pɨwanake teɨteri “Ti'ɨkitame” memɨtewaruterɨwani.   
\p
\v 8 »Peru xeme yaxepɨkatenaki'erieka “Ti'ɨkitame” xemɨte'uterɨwarɨwani, yuxewitɨ xeikɨa 'akaniuyeikani ti'ɨkitame, xemeta yunaitɨ xekaniyu'iwamaka.  
\v 9 Meta xeme “Ne'ukiyari” xeime xepɨkate'uterɨwani kwiepa, karikɨ xeime xeikɨa xekanexeiyani Yu'ukiyari, mɨkɨ taheima kanakaweni.  
\v 10 Metatsiere “te'ɨkitamete” xepɨkate'uterɨwarɨwani, karikɨ xewitɨ xeikɨa Tixe'ɨkitɨwame kanihɨkɨtɨni, Kɨritsitu kanihɨkɨtɨni.  
\v 11 Kemɨ'ane xeme xetsata mexɨakame mɨhɨkɨtɨni kaneuyeweka xeparewiwame mɨhɨkɨtɨni.  
\v 12 Karikɨ kemɨ'ane mariweme mayuyeitɨwa mɨkɨ tixaɨtɨ katihɨkɨtɨtɨ kanayeitɨariemɨkɨ, kemɨ'ane tixaɨtɨ katihɨkɨtɨtɨ mayuyeitɨwa mɨkɨ matsi mariweme kanayeitɨariemɨkɨ.   
\p
\v 13 »Xɨa'ui xeme, 'inɨarikɨ xemɨte'ɨkitamete, meta xeme paritseutsixi, xemɨte'itawamete. Xepɨtewareunamiriwa teɨteri meheutahaxɨanikɨ Kakaɨyari mɨra'aitatsie, meta xemetɨtɨ xepɨkaheutahake meta mɨkɨ memanuyehaku xepɨkawapitɨa.\f + \fr 23:13 \ft Kɨriyekutsie 14 payemawe. RV60 mɨpaɨ paine: \fq »Xɨa'ui xeme, 'inɨarikɨ xemɨte'ɨkita meta xeme paritseutsixi, xemɨte'itawamete. Piinite xepɨtewaxɨtɨirie wiuraxi, meta xemɨxeiyarienikɨ 'exepɨteheutetere xeyunenewietɨ mɨkamatsiɨkɨnikɨ kexemɨteyurie. Mɨkɨkɨ xehetsie matsi waɨkawa katinahɨiyamɨkɨ.\f*   
\p
\v 15 »Xɨa'ui xeme, 'inɨarikɨ xemɨte'ɨkita, meta xeme paritseutsixi, kexemɨ'itɨarieni xemɨte'itawamete. Naitsarie haramaratsie kwiepa xepɨku'uwa xeime xewautɨwetɨ yuhetsɨa mieme xemeyeitɨanikɨ. Kepauka xemitaxeiya, kwinimieme 'axatiuka'iyarime xepayeitɨwa keyuri xeme, meta yemekɨ hetsiena tinakeme mɨrataiyarietsie meukahɨiyanikɨ keyuri xeme.   
\p
\v 16 »Xɨa'ui xeme, xe'akɨkɨpetɨ xemɨwarahapana hipame, mɨpaɨ xemutiyuane: “Kemɨ'ane tuki haxaxatatɨ mɨyɨhɨritɨa, mɨkɨ tixaɨtɨ pɨkatihɨkɨ, peru xɨka yɨhɨritɨani huru tepɨayari tukita mieme haxaxatatɨ, mɨkɨ peuyewetse yamɨtikayani kemutayɨ”.  
\v 17 Xeme 'atsixepɨkatemate, xepakɨkɨpe. ¿Kemɨ'ane matsi yemekɨ peuyewetse: huru, nutsu tuki peuyewetse huru patsiekame mayeitɨwa Kakaɨyari hetsɨa mieme mayanikɨ?  
\v 18 Metatsiere mɨpaɨ xeputiyuane xeme: “Xewitɨ xɨka mawari taiyame haxaxatatɨ 'uyɨhɨritɨani, mɨkɨ tixaɨtɨ pɨkatihɨkɨ, peru xɨka mawari heimana mɨrapine haxaxatatɨ 'uyɨhɨritɨani, mɨkɨ peuyewetse yamɨtikayani kemutayɨ”.  
\v 19 Xemakɨkɨpe. ¿Kemɨ'ane matsi yemekɨ peuyewetse: mawari, nutsu mawari taiyame peuyewetse patsiekame mayeitɨwa mawari Kakaɨyari hetsɨa mieme mayani?  
\v 20 'Ayumieme, kemɨ'ane mawari taiyame haxaxatatɨ mɨyɨhɨritɨa, mɨkɨ hetsiemieme xeikɨa pɨkayɨhɨritɨa, naitɨ heimana mɨrapine meta pɨtixata.  
\v 21 Kemɨ'ane mɨyɨhɨritɨa tuki haxaxatatɨ, mɨkɨ xeikɨa xatatɨ pɨkayɨhɨritɨa, kemɨ'ane tukita mayeka hetsiemiemeta pɨyɨhɨritɨa.  
\v 22 Kemɨ'ane muyuawi haxaxatatɨ mɨyɨhɨritɨa Kakaɨyari 'uwenieya xatatɨ pɨyɨhɨritɨa meta kemɨ'ane hetsiena maka.   
\p
\v 23 »Xɨa'ui xeme, 'inɨarikɨ xemɨte'ɨkitamete meta paritseutsixi, xemɨte'itawamete. Tamamatatsie mieme xeime xepɨyuwaɨriya xemixatɨanikɨ Kakaɨyari: yerɨwawena, texuxuri meta kuminu, peru xepihayewa tita matsi mɨreuyewetse 'inɨari niukiyaritsie, kemɨtiheitserie hetsiemieme, kemɨtiuyukanenimayaka meta yaxemɨtekahunikɨ kexemutiyuane. Mɨpaɨ xemɨtekahunikekai peuyewekai xekatehayewatɨ 'iya kexemɨteyurie.  
\v 24 Xe'akɨkɨpetɨ xemɨwarahapana hipame. Yu'itsaritsie xepenatihɨpa xekɨi xehexɨnikɨ, peru xepexɨ kameyu 'amupa.   
\p
\v 25 »Xɨa'ui xeme, 'inɨarikɨ xemɨte'ɨkita meta paritseutsixi, xemɨte'itawamete. Herie xeikɨa xepika'itiwa tekɨxi meta xakɨ, peru yutaɨta xepɨhɨpɨne 'inawarikɨ meta xeyutatuatɨ 'axaxemɨteyuriekakɨ.  
\v 26 Paritseu pemakɨpe. Taɨtana meri keniwaku'iti tekɨxi meta xakɨ, mɨpaɨ herieta 'itiyatɨ kanayeimɨkɨ.   
\p
\v 27 »Xɨa'ui xeme, 'inɨarikɨ xemɨte'ɨkitamete meta paritseutsixi, xemɨte'itawamete, mɨki teukiya mutuxa mɨkawiriyarietɨka hepaɨ xekani'aneneni. Herie witsipɨtiyuxexeiya, peru pɨhɨne mɨkite wa'umeyari meta naitɨ tita mɨkati'itiya.  
\v 28 Xemeta yaxeikɨa herie xeikɨa mɨkɨ heitseriemekɨ yamemɨtekahu wahepaɨ xepɨteyuxexeiya, peru xepɨhɨpɨne yakɨ xeikɨa xeyɨatɨ meta 'axamɨti'anekɨ.   
\p
\v 29 »Xɨa'ui xeme, 'inɨarikɨ xemɨte'ɨkitamete meta paritseutsixi, xemɨte'itawamete. Kakaɨyari niukametemama wateukiya xepɨtiwewiwa, meta mɨkɨ heitseriemekɨ yamemɨtekahukai wateukiya witsixeputiyuri.  
\v 30 Mɨpaɨta xete'utiyuane: “Tame xɨari xɨka 'ate'u'uwanike kepauka ta'ukiyarima 'amemu'uwakaitsie, tame tepɨkawaparewienikekai memitayeuritsie texaxatamete waxuriya”.  
\v 31 Peru xeme xekaniyuhekɨatani kename mɨkɨ Kakaɨyari niukametemama memɨwarukwi wanuiwari xehɨkɨ.  
\v 32 Kamɨtsɨ xetutsima kememɨte'itsutɨa xemeta xekeneunɨtsa.   
\p
\v 33 »Kuterixi xepɨhɨkɨ. Kuterixi waniwema. ¿Kehepaɨ xeteyutawikweitsitɨani xemɨkaheukaxɨriyanikɨ mɨrataiyarietsie?  
\v 34 'Ayumieme xehetsɨa nepɨwaranunɨ'ani Kakaɨyari niukametemama, temaiwawemete meta te'ɨkitamete. Hipame mɨkɨ xeme xepɨwakwini meta kuruxitsie xepɨwakawɨtɨani, hipame mɨkɨ xepɨwatiwayani yutuki 'etsimupepeta meta kiekaritetsie xepɨwakuweiyatɨweni.  
\v 35 'Ayumieme xehetsie pɨrahɨiyani yunaime heitseriemekɨ yamemɨtekahu waxuriyakɨ kwiepa mɨtayeuri, 'Aweri heitseriemekɨ yamɨtikamiekai xuriyayakɨ meri, 'atsita Tsakariyaxi Werekiyaxi nu'aya xuriyayakɨ, xemimi tuki meta mawari taiyame wahixɨapa.  
\v 36 Yurikɨ mɨpaɨ nekanaineni, 'ikɨ naitɨ hikɨ miemete teɨteri wahetsie pɨrahɨiyani.   
\p
\v 37 »Kerutsareme, Kerutsareme 'aku, 'ahetsɨa kiekatari mekaniwatakukuyani Kakaɨyari niukametemama meta mekaniwatituaxani Kakaɨyari nɨ'arimama 'ahetsɨa memɨ'axe. Mɨixa nepɨnewaɨriyakai nemɨwakuxeɨrienikɨ 'atɨɨriyama, wakana yuniwema kemɨtiwakuxexeɨriwa yu'anatɨa hepaɨ, peru mepɨkayuwaɨri.  
\v 38 Neuxei, xekii 'uyemawetɨ pɨyuhayewa.  
\v 39 Mɨpaɨ nepɨtixetahɨawe, tawari xepɨkanetsixeiya mexi ka'aye'awe kepauka mɨpaɨ xemutiyuaneni: “'Aixɨa ke'itɨarieka kemɨ'ane 'umamie Ti'aitame hetsɨa miemetɨtɨ”».   
\c 24  
\s1 Kemɨtiyɨaneni kwie heutiparirɨmekaku  
\r (Mat 24:1-51 – Mar 13:1-37, Ruk 21:5-36)  
\p
\v 1 Ketsutsi tukita kaniwayeyani, hikɨ 'umiekaku, hetsɨana miemete teyɨ'ɨkitɨwamete 'ahurawa mekaniukɨne mekanixeitsitɨani kiite tuki kuraruyarita miemete.   
\p
\v 2 Mɨkɨ mɨpaɨ katiniwarutahɨawe:  
\p —¿Xete'ixeiya 'ikɨ naime? Yurikɨ mɨpaɨ nepɨxerahɨawe, tete pɨkahayewarieni yuheima 'atetɨ, matsi naitɨ kanika'unariemɨkɨ.   
\p
\v 3 Hikɨ Huriwu Mati'u yemuriyaritsie 'ukaiku, teyɨ'ɨkitɨwamete 'auriena mekaniu'axɨani yɨhɨkɨate, mɨpaɨ mekatenitahɨawe:  
\p —Ketatineutaxatɨa, ¿kepauka mɨpaɨ pɨtiyɨni kepemainekai, tita ti'inɨariyaritɨni kepauka pemunuani, meta kepauka kwie meutiparirɨmeni?   
\p
\v 4 Hikɨ Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —Xekeneyukweriwayurieka nɨka xewitɨ tixe'u'itaiyakɨ.  
\v 5 Yumɨiretɨ mepɨ'axɨani kename ne neyɨane, mɨpaɨ me'utiyuatɨ: “Neri Kɨritsitu nepɨhɨkɨ”, mepɨtewa'itaiya yumɨireme.  
\v 6 Xeme mɨpaɨ xepɨte'enanani kename xaɨtsie kuyaxa hexuawe meta kename xaɨtsie kiekatari hipame wahamatɨa 'ari meheyutakwini, peru xepɨkamamaka. Peuyewetse mɨpaɨ mɨtiyɨni, peru 'akuxi 'ana kwie naitɨ pɨkaheutipare.  
\v 7 Nuiwarite mekaniwatakwikuni hipame nuiwarite meta xexuime kwieyaritsie kiekatari hipame kwieyaritsie kiekatari. Naitsarie haka kanitawemɨkɨ\f + \fr 24:7 \ft RV60 \fq kwiniya paxaxata.\f* metatsiere kwie kanitayuamɨkɨ.  
\v 8 Mɨkɨ naitɨ xɨka mɨpaɨ tiyɨaneni kukuiniya 'akuxi yutsutɨanetɨ pɨtiyɨaneni.   
\p
\v 9 »'Ana xekaniyetuiyakuni xemɨ'uximatɨariekakɨ meta xemɨkwi'iwakɨ, metatsiere yunaitɨ nuiwarite mekanixe'uxiwe'eriekakuni nehetsɨa xemɨmiemetekɨ.  
\v 10 'Ana yumɨiretɨ mepɨtehayewa yuri mete'erietɨ, mepɨyuyetuani meta meyu'uxiwe'erietɨ mepakɨne,  
\v 11 meta yumɨiretɨ Kakaɨyari niukametemama meyuxatatɨ mepɨtixuawere mete'itawatɨ, mɨkɨ mepɨtewa'itaiya yumɨireme.  
\v 12 Waɨkawa 'axamɨti'ane pɨtitixuawere 'ayumieme yumɨiretɨ mepɨtiwaɨripiexɨani meteyukanaki'erietɨ,  
\v 13 peru kemɨ'ane tiuka'eniwatɨ mɨkatihayewa 'atsita 'imatɨrieka tukaritsie, mɨkɨ kanitawikweitsitɨariemɨkɨ.  
\v 14 Meta 'ikɨ niuki 'aixɨa manuyɨne Kakaɨyari mɨra'aitatsie mieme, kanitaxatsiemɨkɨ naitsarie kwiepa teɨteri watsata, yunaitɨ nuiwarite memi'enienikɨ, hikɨ 'anake tukari kanaye'amɨkɨ.   
\p
\v 15 »Hikɨ kepauka xemixeiya muyepatsietsie “'axamɨti'ane mɨkatipatsie mawariyari”, Kakaɨyari niukameya Tanieri kemutayɨ (titerɨwame ketimaiweni tita mɨtixata),  
\v 16 kemɨ'ane 'ana Kureya kwieyaritsie memu'uwani hɨritetsie meke'uyuta'una.  
\v 17 Kemɨ'ane yukii heima makakani niyukiita pɨkaheutahakeni yupiini mɨtiwayepinikɨ.  
\v 18 Kemɨ'ane yeuta meyeikani yu'utɨma pɨka'akununuwani yɨ'ɨkari mahurimiekɨ.  
\v 19 Xɨa'ui mɨkɨ memuhukani meta memɨtetsitsitɨwani mɨkɨ tukaritsie.  
\v 20 Xekeneyunenewieka muhaɨtɨnitsie mɨpaɨ mɨkatiyɨnikɨ xemɨyuta'unatsie yatɨni 'uxipiya tukaritsie mɨkatiyɨnikɨ.  
\v 21 Karikɨ 'ana kwini mieme 'uximatɨarika 'anetɨ kanitixuawerimɨkɨ kemɨkatitixuaweriwe kwie munetɨarietsie paitɨtɨ 'atsita hikɨ, meta tawari pɨkatixuawere 'ariketa.  
\v 22 Mɨkɨ 'uximatɨarika xɨka 'etsika'utateriyarieni, nixewitɨ pɨkatawikweni, peru memanayexeiyarie wahekɨ, 'uximatɨarika 'etsipɨtateriyarieni.  
\v 23 Hikɨ, 'ana xeme xewitɨ xɨka mɨpaɨ tixekɨhɨaweni: “Kamɨ 'ena kaniuyeikani Kɨritsitu”, yatɨni “Kamɨ huma”, yuri xepɨkate'erieka.  
\v 24 Karikɨ yakɨ Kɨritsitutsixi mekanitixuawerikuni meta Kakaɨyari niukametemama meyuxatatɨ, mɨkɨ 'inɨari mepɨtiwewieni mamariwaweme metewa'itaiyake 'atsita mɨkɨ memanayexeiyarie xɨka tiyɨwenike.  
\v 25 Kamɨtsɨ nepɨxe'ayehɨtɨari xeme mɨpaɨ katiyɨwekaku 'akuxi.   
\p
\v 26 »'Ayumieme, xɨka mɨpaɨ metexekɨhɨaweni: “Neuxei, makumawetsie kaneyeikani”, mana xepɨkahekɨkani. Xɨka mɨpaɨ metexekɨhɨaweni: “Neuxei, 'uwa kiita puyu'awieta”, yuri xepɨkate'erieka.  
\v 27 Merɨkariya naitsarie kemɨtimatsiɨkɨ muyuawitsie tahixɨata 'umerɨkatɨ tatsutɨa paitɨ, mɨpaɨta naitsarie katinimatsiɨkɨkamɨkɨ kepauka munuani Yuri Tewi.  
\v 28 Kanimatsiɨkɨni kaxari tsepa hakewa meeka, mana mekaniyukuxeɨrikuni wirɨkɨxi.   
\p
\v 29 »'Ana kwitɨ 'uximatɨarika 'utɨmata,  
\q1 »“tau kaniyɨrimɨkɨ,  
\q2 meta metseri tawari pɨkahekɨariwieni,  
\q1 xurawetsixi mepɨkaxɨrieni muyuawitsie  
\q2 meta tɨrɨkariya memexeiya muyuawitsie miemete mepɨkuyuitɨarieni”.   
\p
\v 30 »'Ana matsiɨkɨtɨ kanayeimɨkɨ Yuri Tewi 'inɨarieya taheima, 'ana yunaitɨ nuiwarite kwiepa memɨtama mekaniyutihiweriekuni. Mekanixeiyakuni Yuri Tewi muyuawitsie haitsata 'akamiekame tɨrɨkariya hexeiyakame meta waɨkawa xawatɨme.  
\v 31 Meta kuxineta hɨtsieriekaku pɨwatanɨ'axɨani yuniuki tuayamete, hikɨ mɨkɨ mepɨwakuxeɨrieni memanayexeiyarie, naitsarie kiekatari muyuawi hetɨa.   
\p
\v 32 »Pinikɨ xeketeneyɨ'ɨkitɨaka: Kepauka mɨkaneika xawari meta xɨka yɨrani, xeme mɨpaɨ xepɨtemate tatsɨari 'ahurakaku.  
\v 33 Yaxeikɨata 'ikɨ, kepauka xemɨneniere mɨpaɨ naitɨ tiyɨaneme, mɨpaɨ xeketenemaika kename hehurari, kitenie mɨta'aximeni hepaɨ.  
\v 34 Yurikɨ mɨpaɨ nepɨxerahɨawe, 'ikɨ naitɨ yapɨtiyɨni mexi hikɨ miemete mekakwiwawe.  
\v 35 Muyuawi meta kwie pukumawere, peru neniuki pɨkakumawere.   
\s1 Pɨkamatsiɨkɨ tukariyari meta hurayari  
\r (Mat 24:37-39, 45-51 – Ruk 17:26-27, 12:42-46)  
\p
\v 36 »Peru, nixewitɨ 'atsipɨkatimate kepauka maye'ani mɨkɨ tukari, taheima miemete niuki tuayamete 'atsimepɨkatemate, meta Kakaɨyari Nu'aya 'atsipɨkatimate,\f + \fr 24:36 \ft RV60 \fq Nu'aya\ft  pɨkahaine.\f* 'ukiyarieya xeikɨa katinimaika.  
\v 37 Kemɨtiuyɨ Nuhexi 'amuyeikakaitsie, mɨpaɨta katiniyɨmɨkɨ kepauka Yuri Tewi munuani.  
\v 38 'Ana memɨkatihauwekaitsie 'akuxi, mepɨtekwatɨwekai, mepɨ'ietɨwekai, mepɨneɨketɨwekai meta mepɨtewikitɨatɨwekai, 'atsita kepauka Nuhexi meutaha kanuwatsie,  
\v 39 'atsimepɨkatemaikai, 'arikeke xeikɨa haa pɨtitɨa pɨwarehautsitɨa yunaime. Yaxeikɨata katiniyɨmɨkɨ kepauka Yuri Tewi munuani.  
\v 40 'Ana yuhutatɨ xɨka waxata me'u'uwani: xewitɨ panutiwitɨkieni xewitɨta pɨku'eiriwa.  
\v 41 Yuhutatɨ 'ukari mepɨtɨxɨni: xewitɨ panutiwitɨkieni xewitɨta kaniku'eiriwamɨkɨ.   
\p
\v 42 »'Ayumieme, xekenayeneniereni 'atsixemɨkatematekɨ kemɨ'ane tukaritsie munuani xekutsiyari.  
\v 43 Peru 'ipaɨ xeketenemaika: xɨka kiekame yatimaikake kemɨ'ane hurayaritsie tɨkarikɨ munuani tinawayame, payenierenikeyu mɨka'ipitɨanikɨ kiita meutahani.  
\v 44 'Ayumiemeta xeme kaneuyeweka xemɨyuha'aritɨaka, karikɨ kepauka Yuri Tewi kanuaximeme xemɨ'erieka 'ana kaninuamɨkɨ.   
\p
\v 45 »Ti'uximayatame yamɨtikamie meta mɨtimaiwe kanihɨkɨtɨni mɨyɨwe kutsiyarieya mɨtihɨritɨani mɨtiwa'aitɨakakɨ hipameta te'i'uximayatsiriwamete meta mɨtiwamikwanikɨ kepauka memeiyehɨwa.  
\v 46 'Aixɨa ke'itɨarieka mɨkɨ ti'uximayatame xɨka kutsiyarieya nuame 'itaxeiya yatiyurieneme kemɨtiuta'aitɨarie.  
\v 47 Yurikɨ mɨpaɨ nepɨxerahɨawe, pɨtihɨritɨani yupiinite tinaime.  
\v 48 Peru mexɨka mɨkɨ ti'uximayatame 'axatiuka'iyarini, mɨpaɨ tiuyɨhɨawe: “Nekutsiyari 'epɨreutere kwitɨ pɨkanuani”,  
\v 49 hikɨ xɨka warutiwatɨyani yuhepaɨ te'uximayatamete, meta xɨka tikwaneni meta 'ieneni tarɨwekarixi wahamatɨa.  
\v 50 Mɨkɨ ti'uximayatame kutsiyarieya kaninuamɨkɨ kepauka mɨka'ikwewie meta kemɨ'ane hurayaritsie yemekɨ mɨka'ikwewie.  
\v 51 Waɨkawa pi'uximatɨani meta mɨkɨ memɨte'itawamete wahepaɨ pɨtipitɨani. Manari putatsuakani puyutikeweni.   
\c 25  
\s1 Tamamata 'ɨimarixi  
\p
\v 1 »Kakaɨyari mɨra'aitatsie 'ipaɨ katiniyɨmɨkɨ, kememɨyɨ mɨkɨ tamamata 'ɨimarixi yɨkɨxeme me'utihapaka memekɨ me'enunakeke neneɨkeme.  
\v 2 Yu'auxɨwitɨ mɨkɨ 'atsimemɨkatemate mepɨhɨkɨtɨkai, meta yu'auxɨwitɨ mepɨtemaiwawekai.  
\v 3 Mɨkɨ 'atsimemɨkatemaikai yɨkɨxeme mepehapakai, peru hatseitiyari tawari mepɨkahehapa.  
\v 4 Matsi, memɨtemaiwawekai hatseiti mekanehanɨni puteyutsie yɨkɨxeme hamatɨa.  
\v 5 Hikɨ neneɨkeme mɨkanuawekaikɨ, yunaitɨ mekanekakutsikutɨkɨne hikɨ mekaneukutsu.  
\v 6 Tɨkari hixɨapa xewitɨ mɨpaɨ katinehiwa: “Neuxei, neneɨkeme mana pamie. Xekenenakiyu”.  
\v 7 Hikɨ 'ɨimarixi yunaitɨ mekananuku'uni, mekanikuha'aritɨani yɨkɨxeme.  
\v 8 Mɨkɨ 'atsimemɨkatemaikai mɨpaɨ mekateniwarutahɨawe memɨtemaiwawekai: “Xeketaneumikwa 'etsiwa yuhatseiti tame takɨxeme mɨtɨxɨaximekɨ”.  
\v 9 Memɨtemaiwawekai mɨpaɨ mekateniwaruta'eiya: “Hauyewetɨ mɨkahayeikanikɨ tahetsiemieme meta xehetsiemieme, matsi xekenehu 'ituayamete wahetsɨa, xekenetinanai yuhetsiemieme”.  
\v 10 Peru mexi hatseiti mehenanetɨwekai neneɨkeme kaninuani, mɨkɨ 'ɨimarixi memuyukuha'aritɨakai 'utɨmana mekaneutahaxɨani neɨkiya 'ixɨararipa. Hikɨ kitenie katineunamieni.  
\v 11 'Arikeketa 'ɨimarixi memɨkatemaiwawekai mekaniu'axɨani mɨpaɨ me'utiyuatɨ: “Ti'aitame. Ti'aitame 'aku. Ketatineuyepiri”.  
\v 12 Mɨkɨ mɨpaɨ katiniwarutahɨawe: “Hawaikɨ, yurikɨ nepɨkaxemate”.   
\p
\v 13 Ketsutsi mɨpaɨ kaniutayɨni:  
\p —'Ayumieme nepaine, xemeta xekenayeneniereni 'atsixemɨkatematekɨ kemɨ'ane tukaritsie kemɨ'ane hurayaritsie munuani.   
\s1 Tumini 'ɨxatsiyarikɨ kemɨti'ɨkitakai  
\p
\v 14 »Kakaɨyari mɨra'aitatsie 'ipaɨ katini'anemɨkɨ, tewi 'ateewa yemieximetɨ kemɨtiuyuri hepaɨ, yuhetsɨa miemete te'uximayatamete kaniwarutakwewieni yuhɨxie, hikɨ yupiini katiniwaruhɨritɨani.  
\v 15 Xeime kaniu'ɨitɨani 'auxɨwime kiriwayari tumini, xeimeta huta kiriwayari tiu'ɨitɨa, xeimeta xeikiriwayari, kememɨteyɨwawekai yuxexuitɨ mɨpaɨ mepɨte'upitɨarie. Hikɨ kanayeyani.  
\v 16 Kemɨ'ane 'auxɨwime kiriwayari mu'ɨitɨarie tumini, kwitɨwa kaneyani, mɨkɨkɨ katinituakaitɨni, tawari 'auxɨwime kiriwayari pana'iwaxɨ tumini.  
\v 17 Yaxeikɨata, 'iya huta kiriwayari mu'ɨitɨarie tawari hutame pana'iwaxɨ.  
\v 18 Peru 'iya xeikiriwayari mu'ɨitɨarie kaneyani, kwieta kaniwati'ine kaniti'awieta yukutsiyari tuminieya.   
\p
\v 19 »Hikɨ 'arike mɨixa heyurieka te'uximayatamete wakutsiyari kaninuani, katiniwarutawawirieni tita mɨtiwayetuiriekai.  
\v 20 Kemɨ'ane 'auxɨwime kiriwayari mu'ɨitɨariekai kaninuani, tawarita 'auxɨwime kiriwayari kani'atɨirieni, mɨpaɨ 'utaitɨ: “Neti'aitɨwame, 'ekɨ tumini 'auxɨwime kiriwayari pepɨnetsiyetuiri. Neuxei, mɨkɨkɨ tawari 'auxɨwime kiriwayari nepana'iwaxɨ”.  
\v 21 Ti'aitɨwameya mɨpaɨ katinitahɨawe: “'Aixɨa pepɨtiuyuri, ti'uximayatame 'aixɨa pemɨtiuka'iyari pekanihɨkɨtɨni meta yapemɨtikamie. 'Etsiwakɨtɨtɨ yapepɨtikatɨa, hikɨri waɨkawa nepɨmatihɨritɨani. Nepɨmatsi'inie teyunaitɨ mɨkɨkɨ temawierika temɨwewienikɨ”.  
\v 22 Hikɨ kaninuanita huta kiriwayari mu'ɨitɨariekai, mɨpaɨ kaniutayɨni: “Neti'aitɨwame, 'ekɨ tumini huta kiriwayari pepɨnetsiyetuiri. Neuxei, mɨkɨkɨ tawari huta kiriwayari nepana'iwaxɨ”.  
\v 23 Ti'aitɨwameya mɨpaɨ katinitahɨawe: “'Aixɨa pepɨtiuyuri, ti'uximayatame 'aixɨa pemɨtiuka'iyari pekanihɨkɨtɨni meta yapemɨtikamie. 'Etsiwakɨtɨtɨ yapepɨtikatɨa, hikɨri waɨkawa nepɨmatihɨritɨani. Nepɨmatsi'inie teyunaitɨ mɨkɨkɨ temawierika temɨwewienikɨ”.   
\p
\v 24 »Peru 'iya xeikiriwayari muyetuiriyariekai kaninuanita, mɨpaɨ kaniutayɨni: “Neti'aitɨwame, nepɨmatsimate 'ekɨ pepa'a'eriya. Pepuka'itsana hakewa pemɨkaheka'e meta pepikuxexeɨriwa hakewa pemɨkaheikaxɨri.  
\v 25 'Ayumieme ne neputima, nekaneyani nekaniti'awieta 'atumini kwieta. Kamɨ neuxei 'apiini 'ena katinikupika”.  
\v 26 Hikɨ ti'aitɨwameya mɨpaɨ katinita'eiya: “Ti'uximayatame 'axapemɨtiuka'iyari meta pemɨ'a'ɨraxie pekanihɨkɨtɨni. 'Ekɨ pepɨnetsimaikai kenemɨtiuka'itsana hakewa nemɨkaheka'e, kenemɨtikuxexeɨriwa hakewa nemɨkaheikaxɨri.  
\v 27 Neuxei tsikere netumini pemɨniyetuakaitɨni tumini hɨwemete wahetsɨa, ne nenuame nemɨwaye'ɨnikekai netumini meta mena'iwaxɨ.   
\p
\v 28 »”Xekeneunawairi tuminieya, xekeneɨ'ɨitɨa 'iya tamamata kiriwayari mexeiya.  
\v 29 Karikɨ kemɨ'ane tixaɨtɨ mɨrexeiya, tawari matsi pɨtimikieni, hikɨ ranayuhayewame pɨrexeiyani. Kemɨ'ane mɨkarexeiya, tsepa 'etsiwa mɨrexeiya katininawaiyariemɨkɨ.  
\v 30 Meta mɨkɨ ti'uximayatame tixaɨtɨ mɨkatiyunaki'erie xekenanuyehɨwa takwa, yɨwipa, mana putatsuakani puyutikeweni”.   
\s1 Muxatsi meta tsipuri  
\p
\v 31 »Kepauka munuani Yuri Tewi yuxawatɨriyatsie, yunaime yuniuki tuayamete warawitɨtɨ, 'ana 'apayerɨni yu'uweni mɨxawatɨtsie.  
\v 32 Yunaitɨ nuiwarite mekanikuxeɨriyakuni hɨxiena, mɨkɨta kaniwaranuyeteɨximɨkɨ hipame, muxatsi wahɨweme kemɨtiwaranuyeteɨxɨ muxatsi tsipuri watsata hepaɨ.  
\v 33 Muxatsi yutserieta kaniwati'uitɨamɨkɨ, meta tsipuri yu'utata.   
\p
\v 34 »Hikɨ Ti'aitame mɨpaɨ pɨtiwatahɨawe mɨkɨ tserietana memɨti'uka: “Xeme xekenakɨni, ne'ukiyari 'aixɨa mɨxe'uyuri, ne'ukiyari mɨra'aita yuhetsiemieme xekenayeitɨa mukuha'aritsie kepauka kwie munetɨarietsie paitɨtɨ.  
\v 35 Ne neheuhakamɨkɨkaku xeme xepɨnete'umi, neheuharimɨkɨkaku xeme xepɨnetsi'uharitɨa, kuyeikame nehɨkɨtɨkaku yukie xepɨnetsi'utanaki'eri,  
\v 36 nemawekaku xepɨnetsi'utikemaritɨa, netikuyekaku xepɨnetsi'ɨwiyakai, meta ne'anutahɨiyaku xepɨnetsi'uyexeiyatɨkɨkakai”.  
\v 37 'Anari mɨkɨ heitseriemekɨ yamemɨtekahu mɨpaɨ mekatenitahɨawikuni: “Ti'aitame, ¿kepauka tepɨmatsi'uxei peheuhakamɨkɨme tepɨmate'umi? ¿kepauka tepɨmatsi'uxei peheuharimɨkɨme tepɨmatsi'uharitɨa?  
\v 38 ¿Kepauka tepɨmatsi'uxei kuyeikame pehɨkɨtɨkaku takie tepɨmatsi'utanaki'eri? ¿kepauka tepɨmatsi'uxei pemaweme tepɨmatsi'utikemaritɨa?  
\v 39 ¿Kepauka tepɨmatsi'uxei petikuyeme yatɨni pe'anutahɨiyakame tepɨmatsihekuxei?”  
\v 40 Hikɨ Ti'aitame mɨpaɨ katiniwatahɨawimɨkɨ: “Yurikɨ mɨpaɨ nepɨxerahɨawe, naime kexemɨte'uyuri 'ikɨ ne'iwama wahetsiemieme tsepa tixaɨtɨ mɨkatihɨkɨ hetsiemieme, mɨkɨ nehetsiemieme xepɨte'uyuri”.   
\p
\v 41 »Hikɨ mɨpaɨ pɨtiwatahɨaweta mɨkɨ 'utatana memɨti'uka: “Xekenehu nehetsɨa xepɨkayuhayewani, xeme haxɨa xehetsie pɨtiunakixɨ, tai yuheyeme mɨta'atsie xekenehu Kauyumarie hetsiemieme meta niuki tuayametemama wahetsiemieme mukuha'aritsietsie.  
\v 42 Karikɨ ne nepeuhakamɨkɨkai xemeta xepɨkanete'umi, nepeuharimɨkɨkai xepɨkanetsi'uharitɨa,  
\v 43 kuyeikame nepɨhɨkɨtɨkai xepɨkanetsi'utanaki'eri yukie, nepɨmawekai xepɨkanetsi'utikemaritɨa, nepɨtikuyekai meta nepanutahɨiyakai xepɨkanetsihekuxei”.  
\v 44 Mɨkɨta mɨpaɨ mekatenitahɨawikuni: “Ti'aitame, ¿kepauka kuta tepɨmatsi'uxei peheuhakamɨkɨme, peheuharimɨkɨme, kuyeikame pehɨkɨtɨkaku, pemaweme, petikuyeme, pe'anutahɨiyaku, tepɨkamatsi'uparewi?”  
\v 45 Hikɨ mɨpaɨ katiniwatahɨawimɨkɨ: “Yurikɨ, mɨpaɨ nepɨxerahɨawe, naime kexemɨkate'uyuri 'ikɨ ne'iwama wahetsiemieme tsepa tixaɨtɨ mɨkatihɨkɨ hetsiemieme, neta nehetsiemieme yaxepɨkate'uyuri”.   
\p
\v 46 »Mɨkɨ mekaniyehuni yuheyemekɨ mema'uximatɨariekatsie, meta mɨkɨ heitseriemekɨ yamemɨtekahu tukari 'atsimɨkayɨwe maxuawe mekaniyehuni».   
\c 26  
\s1 Ketsutsi kememɨtemienikekai  
\r (Mat 26:2-5 – Mar 14:1-2, Ruk 22:1-2)  
\p
\v 1 Merikɨte kepauka Ketsutsi mɨtiutahayewaxɨ mɨpaɨ tiwakuxaxatɨwatɨ, mɨpaɨ katiniwarutahɨawe yuhetsɨa miemete teyɨ'ɨkitɨwamete:  
\v 2 «Xeme mɨpaɨ xepɨtemateri, huta tukari peuyewetse Patsikwa 'ixɨarariyari maye'anikɨ, meta Yuri Tewi nehɨkɨtɨtɨ nekaniyetuiyamɨkɨ kuruxitsie nemɨmierienikɨ».   
\p
\v 3 Hikɨ 'ana mawari wewiwamete tewa'aitɨwamete meta teɨteri wa'ukiyarima mekaniuyukuxeɨrieni mawari wewiwamete tiwa'aitɨwame Kaipatsi mɨtitewakai hetsɨa,  
\v 4 mekaniuyu'enieni, Ketsutsi memɨwiyakɨ me'i'itame mɨpaɨ memɨte'imienikɨ.  
\v 5 Mɨpaɨ mekaniutiyuanekaitɨni: «Xeikɨa 'ixɨarari xuawekaku hawaikɨ, teɨteri me'uyeha'anikɨ waɨkawa me'uyukuxeɨrienikɨ».   
\s1 Witsimu'ɨa kemɨtiukawiriyarie Ketsutsi  
\r (Mat 26:6-13 – Mar 14:3-9)  
\p
\v 6 Merikɨtsɨ Ketsutsi Wetaniya kiekariyaritsie kaniukateitɨni, Tsimuni hetsɨa meripaitɨ nawi kwiniyayari mexeiyakai hetsɨa,  
\v 7 hikɨ 'uka mana kaninuani tete puteyuyari witsimɨ'ane 'ahanatɨ witsimu'ɨa 'ayemakame kwinimieme mɨraye'axe, hikɨ kaneitituani Ketsutsi mu'uyatsie mexi mexatsie 'utikatei.   
\p
\v 8 Hikɨ teyɨ'ɨkitɨwamete me'uneniereka mekaniuyeha'ani mɨpaɨ mekaniutiyuani:  
\p —¿Titayarikuta yakɨ xeikɨa mɨkɨ pɨreuyewe?  
\v 9 Pɨyɨwekai mɨkɨ witsimu'ɨa waɨkawamekɨ mutuiyanikekai, tuminiyari memɨmikienikɨ tixaɨtɨ memɨkateheuxeiya.   
\p
\v 10 Ketsutsi retimaika kememutiyuanekai, mɨpaɨ katiniwarutahɨawe:  
\p —¿Titayari xete'i'uximatɨa 'ikɨ 'ukaratsi? 'Aixɨa katiniuyurieni nehetsiemieme.  
\v 11 'Uxa'atɨni warie 'amekaniu'uwakuni tixaɨtɨ memɨkateheuxeiya xehetsɨa, peru ne xehetsɨa 'anepɨka'uyeikani 'uxa'atɨni warie.  
\v 12 Kemɨreititua witsimu'ɨa nehetsie, netsikuha'aritɨwatɨ katiniuyurieni nemɨkateukienikɨ.  
\v 13 Yurikɨ mɨpaɨ nepɨxerahɨawe, tsepanetɨ hakewa 'ikɨ niuki 'aixɨa manuyɨne mekuxaxatsiwani naitsarie kwiepa, kanitaxatsiemɨkɨ kana'eriwamɨkɨ 'ikɨ 'uka kemɨtiuyuri.   
\s1 Kura kemɨtiuyuwaɨri Ketsutsi mɨyetuanikɨ  
\r (Mat 26:14-16 – Mar 14:10-11, Ruk 22:3-6)  
\p
\v 14 Xewitɨ tamamata heimana memɨyuhuta mɨwanɨkai, Kura 'Itsikariutitanaka mɨtitewakai, kaneyani mawari wewiwamete tewa'aitɨwamete wahetsɨa.   
\p
\v 15 Mɨpaɨ katiniwarutahɨawe:  
\p —¿Kepaɨmeme xepɨnetsi'ɨitɨani, neta Ketsutsi nekanixeyetuiriemɨkɨ?  
\p Mɨkɨ me'uyu'enieka xeitewiyari heimana tamamata pɨrata tuminiyari mekani'ɨitɨani.  
\v 16 'Ana kanitsutɨani tikuwaunetɨ kepauka 'aixɨa mɨyɨnikekai mɨwayetuirienikɨ.   
\s1 Ti'aitame 'ikwaiya  
\r (Mat 26:17-29 – Mar 14:12-25, Ruk 22:7-13, 17-20, 1Kur 11:23-25)  
\p
\v 17 Hikɨ mexɨakame tukaritsie Paa mɨkakuxanariyarietɨka 'ixɨarariyaritsie, teyɨ'ɨkitɨwamete Ketsutsi 'aurie mekaniuyukuxeɨrieni, mɨpaɨ mekatenita'iwawiya:  
\p —¿Hakewa matsihenake 'aixɨa temɨtehekuyurienikɨ, Patsikwa 'ikwaiyari pemekwanikɨ?   
\p
\v 18 Mɨkɨ mɨpaɨ katiniwaruta'eiya:  
\p —Xeime hetsɨa xekenehu kiekaritsie, mɨpaɨ xeketenetahɨawi: «Ti'ɨkitame mɨpaɨ paine: “Netukari kaneutihuraniri, 'akiita Patsikwa 'ixɨarariyari nepɨwewieni nehetsɨa miemete teyɨ'ɨkitɨwamete wahamatɨa”».  
\v 19 Hikɨ Ketsutsi kemɨtiwaruta'aitɨa yamepɨte'uyuri, 'aixɨa mepikuyuri Patsikwa 'ikwaiyari.   
\p
\v 20 Hikɨ 'ukuyɨreku mexatsie kaniutiyerɨni tamamata heimana yuhutame wahamatɨa.  
\v 21 Mexi metekwakai, mɨpaɨ katiniwarutahɨawe:  
\p —Yurikɨ mɨpaɨ nepɨxerahɨawe, xewitɨ xeme pɨnetsiyetuani.   
\p
\v 22 Hikɨ kwinimieme meteyuhiwerietɨ yuxexuitɨ mɨpaɨ metenitihɨawetɨkɨne:  
\p —¿Ne netihɨkɨ, Ti'aitame?   
\p
\v 23 Mɨkɨ mɨpaɨ katiniwarutahɨawe:  
\p —Xewitɨ kanihɨkɨtɨni nehamatɨa paa manati'ɨwe xakɨtsie, mɨkɨ kaneniyetuamɨkɨ.  
\v 24 Yuri Tewi kenemɨtitewa, nepɨyemie nemɨmierienikɨ kemɨre'uxa nehepaɨtsita, perutsɨ xɨa'ui kemɨ'ane mɨnetsiyetuani Yuri Tewi nehɨkɨtɨme. Matsi 'aixɨa kani'anenikeyu xɨka ka'utinuiwake mɨkɨ tewi.   
\p
\v 25 Hikɨ miyetuanikekai Kura mɨpaɨ kaniutayɨni:  
\p —¿Ti'ɨkitame, ne netihɨkɨ?  
\p Ketsutsi mɨpaɨ katinita'eiya:  
\p —'Ekɨtsɨ mɨpaɨ pekanaineni.   
\p
\v 26 Hikɨ metekwakaku Ketsutsi paa kananuku'ɨni, 'aixɨa 'utayɨka Kakaɨyari hepaɨtsita paa hepaɨtsita, kanititara kaniwarumini teyɨ'ɨkitɨwamete, mɨpaɨ tiwakɨhɨawetɨ:  
\p —Xekenanu'ɨi meta xekeneutikwa'i, 'ikɨ kaninewaiyaritɨni.   
\p
\v 27 'Ariketa tekɨxi kananukuhana, pamɨpariyutsi 'ipitɨaka Kakaɨyari, kaniwaru'itɨani mɨpaɨ tiwakɨhɨawetɨ:  
\p —Yunaitɨ xekenanuti'iexɨa 'ikɨ.  
\v 28 'Ikɨ kaninexuriyatɨni, mɨkɨ tɨratu mɨhekwa 'aixɨa kaniyurimɨkɨ Kakaɨyari meta yuteɨterima wahamatɨa mieme. Yumɨireme wahetsiemieme kanitayeurimɨkɨ memɨteheuyehɨwiyarienikɨ ke'axamemɨte'uyurikɨ.  
\v 29 Mɨpaɨ nepɨxerahɨawe, tawari hawaikɨ nepɨka'enu'ieni 'ikɨ kaxie hayari, 'arikekeri tukari 'aye'ayu kepauka hekwamekɨ nemenu'ieni kaxie winuyari mɨhekwa xehamatɨa ne'ukiyari mɨra'aitatsie.   
\p
\v 30 Hikɨ nɨawari Kakaɨyari hetsɨa mieme me'utikwikaka, mekanekɨne yemuritsie Huriwu Mati'u.   
\s1 Ketsutsi kemutayɨ Pekuru kemɨtiyuku'imawanikekai  
\r (Mat 26:31-35 – Mar 14:27-31, Ruk 22:31-34)  
\p
\v 31 Mana Ketsutsi mɨpaɨ katiniwarutahɨawe:  
\p —'Ikɨ tɨkaritsie, xeme yunaitɨ xepɨnetsiku'eirieni, mɨpaɨ mɨre'uxakɨ:  
\q1 »“Nepimieni muxatsi wahɨweme,  
\q2 hikɨ muxatsi mɨwa'ɨwiyakai mekanitaxɨriexɨakuni”.   
\m
\v 32 Peru ne'anukukeme, ne meri nepɨyemie Karereyatsie paitɨ».   
\p
\v 33 Hikɨ Pekuru mɨpaɨ katinitahɨawe:  
\p —Tsepanetɨ yunaitɨ memɨmatsi'uku'eiri, ne hawaikɨ nepɨkakunuani.   
\p
\v 34 Ketsutsi mɨpaɨ katinitahɨawe:  
\p —Yurikɨ mɨpaɨ nepɨmarahɨawe, 'ikɨ tɨkaritsie wakana 'ukiri katahiwawekaku 'akuxi, 'ekɨ haikakɨa pepɨ'aku'imawani, kename pekanetsimate pe'utaitɨ.   
\p
\v 35 Pekuru tawari mɨpaɨ katinita'eiya:  
\p —Tsepanetɨ meuyeweka 'ahamatɨa nemɨmierieni, nepɨkaneku'imawani kename nekamatsimate ne'utaitɨ.  
\p Meta hipatɨta teyɨ'ɨkitɨwamete yaxeikɨa mekaniutiyuani.   
\s1 Ketsutsi kemɨtiuyutanenewi Ketitsemani mɨrayetewatsie  
\r (Mat 26:36-46 – Mar 14:32-42, Ruk 22:40-46)  
\p
\v 36 Hikɨta Ketsutsi teyu'ɨkitɨwamete warawitɨtɨ kaneyani Ketitsemani reyetewakaku. Mɨpaɨ katiniwarutahɨawe: «'Ena xekenekuteni mexi huma nepɨyunenewimie».  
\v 37 Pekuru meta Tsewereu niwemama yuhutame kaniwarewitɨni mana paitɨ, hikɨ kanitsutɨani yuhiwerietɨ yu'iyaritɨatɨ.  
\v 38 Hikɨ mɨpaɨ katiniwarutahɨawe: «Ne'iyaritsie kwini mieme nekaninehiwerieka, mɨkɨkɨ nekanimɨximeni. 'Ena xekeneuyuhayewa meta xekenayeneniereni nehamatɨa».   
\p
\v 39 'Etsiwa huma 'uyaka kaniutihɨximakeni, kaniyutanenewieni mɨpaɨ 'utaitɨ: «Ne'ukiyari, xɨka tɨma tiyɨwenike, yanepɨra'eriwakaku mɨka'aye'anikɨ kenemɨtikwinitɨarieni. Peru kemɨnetinake ne pɨkatixaɨ, 'ekɨ pɨta kemɨmatinake».   
\p
\v 40 Hikɨ teyɨ'ɨkitɨwamete mematitekaitsie kaninuani, kaniwarutaxeiya mekutsume. Mɨpaɨ Pekuru katiniutahɨawe: «¿'E'e xekateyɨwawekai tsikere xeihurayari xemayeneniereni nehamatɨa?  
\v 41 Xekenetaneniereni, xekeneyunenewieka kapa 'axaxete'uyurienikɨ xemɨta'inɨatsienitsie. Xe'iyari kaniyuwaɨriyani, peru xewaiyari matsi puwerani».   
\p
\v 42 Hikɨ hutarieka heyaka kaniyutanenewieni mɨpaɨ 'utaitɨ: «Ne'ukiyari, xɨka heuyeweka mɨpaɨ nemɨtikwinitɨarieni, kemɨmatinake yaketiuyɨni».   
\p
\v 43 Tawarita kepauka munua, kaniwarutaxeiyata mekutsume, memɨkayɨwawekaikɨ memayeneniereni kutsikɨ.  
\v 44 Hikɨ kaniwaruku'eirieni, tawari heyaka hairieka kaniyutanenewieni yaxeikɨa 'utaitɨ.   
\p
\v 45 Tawarita kaninuani teyɨ'ɨkitɨwamete mematitekaitsie, nuaka mɨpaɨ katiniwarutahɨawe: «¿Xetekutsu 'akuxi, xete'uxipie? Neuxei, kanaye'aximeniri, Yuri Tewi kenemɨtihɨkɨ, nemɨyetuiyani 'axateyuruwamete wahetsɨa.  
\v 46 Xekenanuku'uti, kɨmɨtɨkari. Kemɨ'ane mɨnetsiyetuani mana kanamieni».   
\s1 Ketsutsi kemɨtiuwiyarie  
\r (Mat 26:47-56 – Mar 14:43-50, Ruk 22:47-53)  
\p
\v 47 Merikɨte 'utaniukakaku 'akuxi Kura mana kaninuani, tamamata heimana memɨyuhuta mɨwanɨkai. Yuwaɨkawame teɨteri yuhamatɨa kaniwarawitɨkɨkaitɨni 'ixiparate meta kɨyexi mete'u'ɨkame, mawari wewiwamete tewa'aitɨwamete meta teɨteri wa'ukiyarima mewareyenɨ'aku.  
\v 48 'Iya miyetuanikekai 'inɨari pɨwarutaxatɨakai, mɨpaɨ 'utaitɨ: «Kemɨ'ane nemɨtawaɨritɨani 'itsiyakɨ, mɨkɨ kanihɨkɨtɨkamɨkɨ, xekenewiya».  
\v 49 Hikɨ Ketsutsi hetsɨa nuaka mɨpaɨ kaniutayɨni:  
\p —Ke'aku Ti'ɨkitame. Hikɨ kani'itseni.   
\p
\v 50 Hikɨ Ketsutsi mɨpaɨ katinitahɨawe:  
\p —Nehamiku, kepemɨtikuyuriene yaketineuyuri.  
\p Hikɨ teɨteri 'auriena me'aketɨkɨneka, Ketsutsi mekaniuwiya.  
\v 51 Mɨkɨ Ketsutsi hamatɨa memu'uwakai xewitɨ kaniwatihana yu'ixipara, ti'uximayatame mawari wewiwamete tiwa'aitɨwame hetsɨa mieme, nakaya kanawiteni.   
\p
\v 52 Hikɨ Ketsutsi mɨpaɨ katinitahɨawe:  
\p —Keneuka'uta 'a'ixipara, karikɨ yunaitɨ 'ixiparakɨ memɨteyumemiwa, 'ixiparakɨta mekanikwi'iwakuni.  
\v 53 Kari mɨpaɨ pepɨkatimate, ne nekaniyɨweni nemitawawirieni ne'ukiyari, miriyari meyupaɨmeme niuki tuayametemama mɨkɨta kwitɨwa kaniwaranɨ'aweni.  
\v 54 Peru xɨka mɨpaɨ netiuyurieni, ¿kehepaɨ raye'ani 'utɨarika meuyewetse 'ipaɨ mɨtiyɨni manuyɨne?   
\p
\v 55 Hikɨ 'ana Ketsutsi mɨpaɨ katiniwarutahɨawe teɨteri:  
\p —¿Kari xepeyekɨ 'ixiparate meta kɨyexite xete'u'ɨtɨ xenetsiwiyake, kemɨtiwiwiyarɨwa tinawayame? Mɨixa tukita nenayekateitɨni tukarikɨ neti'ɨkitatɨ, 'ana xepɨkanetsi'uwi.  
\v 56 Peru naitɨ 'ikɨ mɨya pɨtiyɨni, maye'anikɨ Kakaɨyari niukametemama kememutiyua 'utɨarika xapayaritsie.  
\p Hikɨ teyɨ'ɨkitɨwamete yunaitɨ mekaniku'eirieni meta mekaniyuta'una.   
\s1 Ketsutsi 'itsɨkate wahɨxie  
\r (Mat 26:57-68 – Mar 14:53-65, Wa 18:12-13, 19-24)  
\p
\v 57 Mɨkɨ Ketsutsi memuwiyaxɨ Kaipatsi hetsɨa mekani'atɨani, mɨkɨ mawari wewiwamete tiwa'aitɨwame kanihɨkɨtɨkaitɨni, hetsɨana mekaniyuxeɨriekaitɨni 'inɨarikɨ te'ɨkitamete meta 'ukirawetsixi.  
\v 58 Peru Pekuru kaniweiyakaitɨni yatewa mawari wewiwamete tiwa'aitɨwame kiita paitɨ. Muwa kaneutahani tukita tehɨwemete wa'aurie kanayerɨni niereke kemɨ'itɨarienikekai.   
\p
\v 59 Hikɨ mawari wewiwamete tewa'aitɨwamete meta 'itsɨkate yunaitɨ mekaniwawautɨwekaitɨni hipame memunenierixɨ memɨte'itani Ketsutsi hepaɨtsita, mɨpaɨ hetsiena memɨte'ahɨanikɨ memita'aitakɨ mɨmierienikɨ.  
\v 60 Peru mepɨyutatexi, tsepa yumɨiretɨ wahetsɨa memu'axɨa me'i'itatɨ.  
\p 'Imatɨrieka yuhutatɨ mekaniu'axɨani,  
\v 61 mɨpaɨ mekaniutiyuani:  
\p —'Ikɨ mɨpaɨ putayɨ: “Ne nekaniyɨweni nemika'una Kakaɨyari tukieya, tawarita netitawewiwe hekwamekɨ haika tukari”.   
\p
\v 62 Hikɨ mawari wewiwamete tiwa'aitɨwame 'anukukeka mɨpaɨ katinitahɨawe:  
\p —¿Pekatitaniuni 'ahepaɨtsita? ¿ketitayari mɨya mete'utiyuane 'ikɨ 'ahepaɨtsita?   
\p
\v 63 Peru Ketsutsi 'atsipɨkahainekai. Hikɨ mawari wewiwamete tiwa'aitɨwame mɨpaɨ katinitahɨawe:  
\p —Kakaɨyari mayeniere matsi'eniekaku yaketatineutahɨawi xɨka Kɨritsitu pehɨkɨtɨni, Kakaɨyari nu'aya.   
\p
\v 64 Ketsutsi mɨpaɨ katinitahɨawe:  
\p —Metsɨ 'ekɨ mɨpaɨ pekanaineni. Peru ne mɨpaɨ nepɨxerahɨawe: 'Uxa'atɨni xekanenixeiyakuni Yuri Tewi kenemɨtihɨkɨ, 'ane'akaime Naimekɨmɨtɨrɨkaɨye tserieta, meta haitsata ne'akamiekame taheima.   
\p
\v 65 Hikɨ mawari wewiwamete tiwa'aitɨwame yukamixa kaneukatsana mɨpaɨ 'utaitɨ karima:  
\p —Kakaɨyari hepaɨtsita 'axaputayɨ. Tawari tepɨkawareuyehɨwa memunenierixɨ. Neuxei, xeme hikɨ xepi'eni, Kakaɨyari hepaɨtsita 'axaputayɨ.  
\v 66 ¿Kexeteku'eriwa 'ikɨ hepaɨtsita?  
\p Mɨkɨ mɨpaɨ mekaniutiyuani:  
\p —Peuyewetse mɨmierieni.   
\p
\v 67 Hikɨ mekaniti'aɨtsikawiyatɨkɨne hɨxitana meta mekanitihutsutɨkɨne. Hipatɨta 'auritapana mekaneitiwayakaitɨni  
\v 68 mɨpaɨ me'utiyuatɨ:  
\p —Ketatineutaxatɨa, Kɨritsitu, ¿kemɨ'ane pɨmatsiheutiwa?   
\s1 Pekuru kemɨtiyuta'ima kename Ketsutsi kamate 'utaitɨ  
\r (Mat 26:69-75 – Mar 14:66-72, Ruk 22:55-62, Wa 18:16-18, 25-27)  
\p
\v 69 Mexi mɨyatiyɨanekai, Pekuru takwa kaniukateitɨni, hikɨ ti'uximayatame hetsɨana nuaka 'ɨimaritɨtɨ, mɨpaɨ katinitahɨawe:  
\p —'Ekɨtatsiere Ketsutsi Karereya kiekame hamatɨa pekaniuyeikakaitɨni.   
\p
\v 70 Peru mɨkɨ kaniyuta'imani yunaime wahɨxie mɨpaɨ 'utaitɨ:  
\p —'Atsinepɨkatimate kehapaɨtɨtɨ pemɨnerahɨawe.   
\p
\v 71 Hikɨ mɨkɨ kaneyani kitenie hepa, xewitɨta kanixeiya 'uka, mɨpaɨ katiniwarutahɨawe mana memɨti'ukai:  
\p —'Ikɨtatsiere Ketsutsi natsaretitanaka hamatɨa kaniuyeikakaitɨni.   
\p
\v 72 Peru mɨkɨ tawarita kaniyuta'imani, mɨpaɨ 'utaitɨ:  
\p —Kakaɨyari netsi'eniekaku nepaine, nepɨka'imate mɨkɨ tewi.   
\p
\v 73 Hikɨ yareutewikaku mana memɨti'ukai hurawa me'akɨneka mɨpaɨ Pekuru mekateniutahɨawe:  
\p —Yurikɨ 'ekɨ xewitɨ mɨkɨ wa'iwa pekanihɨkɨtɨni, pepɨmatsiɨkɨ kepemɨtiuniuka.   
\p
\v 74 Pekuru mɨpaɨ kaniutayɨni:  
\p —Kakaɨyari 'axakenetiupitɨani xɨka netiku'itawani, nepɨka'imate mɨkɨ tewi nepaine.  
\p Hikɨ 'ana yapauka kanetahiwa wakana.  
\v 75 Pekuru Ketsutsi niukieya kanaye'erieni kemɨtitahɨawixɨ: «Wakana katahiwawekaku 'akuxi, 'ekɨ haikakɨa pepɨ'aku'imawani kename pekanetsimate pe'utaitɨ». Hikɨ 'anuyeyaka kaniutatsuani kwinimieme tiyuhiwerietɨ.   
\c 27  
\s1 Kura kemɨtiumɨ  
\p
\v 1 Merikɨtsɨ ximeri, yunaitɨ mawari wewiwamete tewa'aitɨwamete meta teɨteri wa'ukiyarima yunaitɨ mekaniuyukuxeɨrieni meyu'enienike Ketsutsi hepaɨtsita, memimienikɨ.  
\v 2 Mekaneihana hɨakame, Piratu mekaniyetuirieni kuwexinaruri.   
\p
\v 3 Kepauka Kura miyetua mɨtiutamari kename 'itsɨkate mete'uta'aitaxɨ mɨmierienikɨ, yɨkɨ katiniyɨkɨhɨawekaitɨni meta watumini kaniwarekɨ'ɨitɨani mawari wewiwamete tewa'aitɨwamete meta 'ukirawetsixi, xeitewiyari heimana tamamata pɨrata tuminiyari,  
\v 4 mɨpaɨ 'utaitɨ:  
\p —'Axanepɨtiuyuri nemiyetuakɨ tewi hetsiena mɨkarahɨiya, xuriyaya mɨtayeurienikɨ.  
\p Mɨkɨ mɨpaɨ mekatenitahɨawe:  
\p —Tame mɨkɨ tepɨkateha'iwawa, 'ekɨri katini'amaiyatɨni.   
\p
\v 5 Hikɨ tukita heitaxɨrieka tumini kaniwayeyani, heyaka kaniuyukawieni.   
\p
\v 6 Mawari wewiwamete tewa'aitɨwamete me'iti'ɨka tumini mɨpaɨ mekaniutiyuani: «'Ikɨ pɨkayɨwe tuki tuminiyari muyemanetsie temeikamana, tewi xuriyaya mɨtayeuriyanikɨ mɨyetuiyakɨ».  
\v 7 Me'uyu'enieka kwie mekaniunaneni mɨkɨ tuminikɨ xari wewiwame kwieya, mana 'ateewa kiekatari wateukiyapa mayanikɨ.  
\v 8 'Ayumieme mɨkɨ kwie Xuriya Mataxɨri katiniuterɨwarɨwani 'akuxi hikɨ.  
\v 9 'Ana kanaye'ani Keremiyaxi Kakaɨyari niukameya, mɨpaɨ kemutayɨ: «Mekanei'ɨni xeitewiyari heimana tamamata pɨrata tuminiyari, 'Ixaheritsixi teɨteriyari kememɨte'ika'inɨaritɨiri kemɨraye'akai,  
\v 10 mɨkɨkɨ 'iwewame kwieya mepunanai, Ti'aitame kemɨnetiuta'aitɨa».\f + \fr 27:10 \ft Keneuxeiya \xt Tsak 11:12,13\ft , \xt Ker 19:1-13, 32:6-9\ft .\f*   
\s1 Piratu Ketsutsi kemɨtiuta'iwawiyaxɨ  
\r (Mat 27:11-26 – Mar 15:12-15, Ruk 23:2-3, 18-25, Wa 18:29–19:16)  
\p
\v 11 Merikɨtsɨ Ketsutsi kuwexinaruri hɨxie kani'atɨarieni, mɨkɨ mɨpaɨ katinita'iwawiya:  
\p —¿'Ekɨ huriyutsixi teɨteriyari tiwa'aitɨwame petihɨkɨ?  
\p Ketsutsi kayuku'imawatɨ mɨpaɨ katinita'eiya:  
\p —'Ekɨ metsɨri mɨyapenaine.   
\p
\v 12 Mawari wewiwamete tewa'aitɨwamete meta 'ukirawetsixi me'ixanetakaku 'atsipɨkatiuta'a.   
\p
\v 13 Hikɨ Piratu mɨpaɨ katinitahɨawe:  
\p —¿Pekatiwa'enie kepaɨmemekɨ memɨmatsixaneta?   
\p
\v 14 Peru Ketsutsi hawaikɨ pɨka'ita'ei, 'ayumieme waɨkawa ni'iyarixiekaitɨni kuwexinaruri.   
\p
\v 15 Merikɨte, mɨkɨ 'ixɨararitsie kuwexinaruri kaniyeiyarieyatɨkaitɨni memanutaxɨriya xeime mɨxɨnakɨ teɨteri kemɨ'ane memanayexeiya.  
\v 16 'Ana 'anutahɨiyakame mekanexeiyakaitɨni waɨkawa mɨmariwakai Waxawaxi titewakame.  
\v 17 Hikɨ me'uyukuxeɨrieku teɨteri, Piratu mɨpaɨ katiniwarutahɨawe:  
\p —¿Kemɨ'ane pɨxenake nemɨxexɨnirieni: Waxawaxi nutsu Ketsutsi, Kɨritsitu mɨtiuterɨwarɨwa?   
\p
\v 18 (Mɨkɨ mɨpaɨ pɨtimaikai, huriyutsixi wa'ukiyarima mepiyetuakai mete'ikwatsirietɨ).   
\p
\v 19 Mexi Piratu 'itsɨkame 'uwenieyatsie 'akatei, 'ɨyaya niuki kaneinɨ'airieni mɨpaɨ 'utaitɨ: «Keneuhayewa mɨkɨ tewi heitseriemekɨ yamɨtikamie, kɨmana waɨkawa nepɨtiukwinixɨ neheinɨtsita hikɨ yɨwikɨta».   
\p
\v 20 Peru mawari wewiwamete tewa'aitɨwamete meta 'ukirawetsixi mekaniwarukemakaxɨani teɨteri Piratu memɨtawawirienikɨ Waxawaxi mɨxɨnakɨ meta Ketsutsi mɨmierienikɨ.   
\p
\v 21 Hikɨ mɨpaɨ katiniwarutahɨawe kuwexinaruri:  
\p —¿'Ikɨ yuhutame kemɨ'ane pɨxenake nemɨxexɨnirieni?  
\p Mɨkɨ mɨpaɨ meputiyua:  
\p —Waxawaxi keneuxɨna.   
\p
\v 22 Piratu mɨpaɨ katiniwarutahɨaweta:  
\p —Merikɨte, ¿keta ne'iyurieni Ketsutsi, Kɨritsitu mɨtiuterɨwarɨwa?  
\p Yunaitɨ mɨpaɨ mekatenitahɨawe:  
\p —Kuruxitsie ke'umierieni.   
\p
\v 23 Kuwexinaruri mɨpaɨ katiniwarutahɨawe:  
\p —¿Titayarikuta? ¿titakɨ 'axatiuyuri?  
\p Peru mɨkɨ kwinimieme matsi mekateniuhiwakaitɨni, mɨpaɨ me'utiyuatɨ:  
\p —Kuruxitsie ke'umierieni.   
\p
\v 24 Kepauka Piratu mɨretima kename mekahei'eniekai, matsi waruxeiyaka kememɨteyutimɨirirɨmekai meniukixietɨ teɨteri, haa kaniuta'aita, hikɨ kaniukamaimani teɨteri wahɨxie mɨpaɨ 'utaitɨ:  
\p —Nehetsie pɨkarahɨiwani 'ikɨ xuriyayakɨ, xeme pɨta xehetsie kerahɨiyani.   
\p
\v 25 Yunaitɨ teɨteri mɨpaɨ mekatenitahɨawe:  
\p —Xuriyayakɨ tahetsie kerahɨiyani, meta tatɨɨriyama wahetsie.   
\p
\v 26 Hikɨ kaniwaruxɨnirieni Waxawaxi, peru Ketsutsi kaniuta'aita mɨkuweiyaxɨanikɨ, meta kaniyetuani kuruxitsie mɨmierienikɨ.   
\s1 Kuyaxi Ketsutsi kememɨtenanaimakai  
\r (Mat 27:27-31 – Mar 15:16-20)  
\p
\v 27 Kuwexinaruri hetsɨa miemete kuyaxi paratsiyu manuwe Ketsutsi mekanehana, meta mekaniwaruta'inieni yunaime kuyaxi waritana mekanaketɨkɨne.  
\v 28 Me'itikemaripieka, 'ɨkari xetame mekanenakuwirieni.  
\v 29 Meta xuya kurunayari me'utatsaka mu'uyatsie mekanenutimanirieni, meta haka 'itsɨyari mekanikweitɨani tserietana. Hikɨ hɨxiena metitunuma'uwetɨ me'inanaimatɨ mɨpaɨ mekatenikuhɨawekaitɨni:  
\p «Ke'aku huriyutsixi tiwa'aitɨwame».   
\p
\v 30 Meta mekaniku'aɨtsikawiyakaitɨni, meta haka memikweitɨakaikɨ mɨkɨkɨ mu'uyatsie mekanitiwayakaitɨni.  
\v 31 'Arike mɨya mete'itinanaimaka mekaninawairieni 'ɨkari, mekanitikemaritɨani 'ixurikieyakɨ, hikɨ mekaneihana kuruxitsie mɨmierienikɨ.   
\s1 Ketsutsi kemɨtiumierie kuruxitsie  
\r (Mat 27:33-44 – Mar 15:22-32, Ruk 23:33-43, Wa 19:17-24)  
\p
\v 32 Merikɨtsɨ mana me'uyehutɨ xeime mekaniutaxeiya Tsirene kiekame Tsimuni titewakame, mekaniwiya menutɨkirienikɨ kuruxieya.   
\p
\v 33 Kurukuta mɨrakutewatsie mekaniu'axɨani (taniukikɨ «Mɨki Mu'uya Manuka» mɨrakutewatsie).  
\v 34 Mana mekani'itɨani kaxie winuyari tsiɨrika hepaɨ ma'ane nɨkame, peru he'inɨataka pɨkayuwaɨri menu'ieni.   
\p
\v 35 Kuruxitsie mekanikawieni meta kuyaxi mekaniyuta'iwa kememɨte'itahuriexɨanikekai 'ixurikiteya.  
\v 36 Hikɨ mana mekutetɨ mekani'ɨwiyakaitɨni.  
\v 37 Mu'uya heima mekaneiwera xapa, titakɨ mɨtiutaxanetsie mɨpaɨ re'ukame: «\sc 'Ikɨ Ketsutsi Kanihɨkɨtɨni, Huriyutsixi Tiwa'aitɨwame\sc*».  
\v 38 Hamatɨana mekaniwarukawɨtɨani tenawayamete yuhutame kuruxitsie, tserietana xeime meta 'utatana xeime.  
\v 39 Hikɨ mana memuyekɨkakai 'axamekatenikɨhɨawekaitɨni yumu'u me'utitsiketɨ,  
\v 40 mɨpaɨ me'utiyuatɨ:  
\p —'Ekɨ, pepika'unakekai tuki, haika tukari 'anukayayu hekwamekɨ pepitawewienikekai. Keneu'atawikweitsitɨa xɨka Kakaɨyari penu'ayatɨni, kuruxitsie kenakaye'a.   
\p
\v 41 Yaxeikɨata mawari wewiwamete tewa'aitɨwamete meta 'inɨarikɨ te'ɨkitamete meta 'ukirawetsixi yunaitɨ me'inanaimatɨ mɨpaɨ mekaniutiyuanekaitɨni:   
\p
\v 42 —Hipame waniu kaniwatawikweitsitɨwakaitɨni, peru pɨkayɨwe mɨyutawikweitsitɨani yɨkɨmana. Meta 'ixaheritsixi katatini'aitɨwametɨni waniu. Merikɨte, hikɨ ke'akayani kuruxitsie, 'ana yuri temɨteta'erienikɨ tame hetsiena.  
\v 43 Mɨkɨ Kakaɨyaritsie yuri pɨti'erie, hikɨtsɨari xɨka 'inaki'erieka mɨkɨ ke'itawikweitsitɨani, mɨpaɨ mainekaikɨ: “Ne Kakaɨyari nekaninu'ayatɨni”.   
\p
\v 44 Meta tenawayamete 'auriena kuruxitsie memuyewɨkai yaxeikɨa 'axamekatenikɨhɨawekaitɨni.   
\s1 Ketsutsi kemɨtiyetua yu'iyari  
\r (Mat 27:45-56 – Mar 15:31-41, Ruk 23:44-49)  
\p
\v 45 Merikɨte tuka kaniukuyɨre naitsarie mana kwiepa, tau kɨa kawiekakuke kaniukuhekɨare.  
\v 46 Hikɨ tau kɨa kawiekaku Ketsutsi karima kaniutahiwa mɨpaɨ 'utaitɨ:  
\p —\tl Herí, Herí, ¿rama tsawatani?\tl* (taniukikɨ manuyɨne: “Nekakaɨyari, nekakaɨyari, ¿titayari penetiuku'eiri?”)   
\p
\v 47 Kepauka hipatɨ mɨkɨ mana memɨti'ukai memu'enana mɨpaɨ mekaniutiyuani:  
\p —'Eriyaxi kaniutahɨawe.   
\p
\v 48 Xewitɨ mɨkɨ 'unautsarɨmetɨ kaneyani, haa 'itsiweme 'utituka winu matsiwita heikahatsika, hakatsie 'iyeka kaneititserieni menu'ienikɨ.  
\v 49 Hipatɨ mɨpaɨ mekaniutiyuanekaitɨni:  
\p —Keneuhayewa, tepɨtaneniereni tsipara 'Eriyaxi kapunuani 'itawikweitsitɨanike.   
\p
\v 50 Hikɨ Ketsutsi tawari karima 'utahiwaka kaniyetuani yu'iyari.   
\p
\v 51 Hikɨ 'ixuriki 'emayetsuikai meuwiekai tukita hixɨata kanitsane heimana 'akayuaka. Kwie putayua meta tetexi kaniutitare.  
\v 52 Teukiya nanutiyepierixɨani, yumɨiretɨ Kakaɨyari teɨterimama memukwikairi mekananuku'uni.  
\v 53 Teukiyata mekanewatikɨne, 'arike Ketsutsi 'anukukeku, kiekari mɨpatsietsie mekaneutahaxɨani, meta yumɨiretɨ mepɨwaruxei.   
\p
\v 54 Xeitsienituyari kuyaxi tiwa'aitɨwame meta hipatɨ hamatɨana Ketsutsi memɨ'ɨwiyakai, kepauka kwie memuxei 'uyuaneme meta naime kemɨtiuyɨ mete'uxeiyaka, waɨkawa mekanimamakaitɨni meta mɨpaɨ mekaniutiyuani:  
\p —Yurikɨ 'ikɨ Kakaɨyari punu'ayatɨkai.   
\p
\v 55 Yumɨiretɨta 'ukari mana mekaniti'ukaitɨni 'ateewa metanenieretɨ, mɨkɨ Ketsutsi hamatɨa mekaneyekɨnekaitɨni Karereyatsie mekaniparewiekaitɨni.  
\v 56 Mariya Mararatanaka, xewitɨta Mariya Kakuwu Kutse mamaayatɨkai, meta Tsewereu niwemama wamaama, meta hipatɨ mana mekaniti'ukaitɨni.   
\s1 Ketsutsi kemɨtiukateukie  
\r (Mat 27:57-61 – Mar 15:42-47, Ruk 23:50-56, Wa 19:38-42)  
\p
\v 57 Hikɨ 'akayunirɨmekaku, tewi mana kaninuani xikutɨtɨ 'Arimateya kiekame Kutse titewatɨ mɨtiyɨ'ɨkitɨwametɨkai Ketsutsi hetsɨa mieme mɨhɨkɨtɨkai.  
\v 58 Piratu hetsɨa nuaka kanitawawirieni Ketsutsi kaxarieya, hikɨ Piratu mɨpaɨ pɨtiuta'aitaxɨ mɨyetuiriyarienikɨ.  
\v 59 Hikɨ Kutse Ketsutsi kaxarieya kanekweni kanita'eima rinu tsawanayari 'itiyakamekɨ.  
\v 60 Yuteukiyapa kaneitateni mɨhekwakaitsie meripaitɨ mita'aitakai mɨwaye'inierienikɨ 'aitɨa. Meta tete 'amɨnena kaneukurupa kɨmana teukiya heunaka, kaneyani.  
\v 61 Mana mekanititekaitɨni Mariya Mararatanaka meta xewitɨ Mariya, teukiya hɨxie.   
\s1 Kuyaxi kememɨte'i'ɨwiyakai teukiya  
\p
\v 62 Merikɨtsɨ 'uxa'arieka, pienixi 'utaxɨku, mawari wewiwamete tewa'aitɨwamete meta paritseutsixi mekaniuyukuxeɨrieni Piratu hetsɨa,  
\v 63 mɨpaɨ me'utiyuatɨ:  
\p —Ti'aitame tame tepe'eriwa 'iya tiyu'itaiyame kemainekai 'ayeyuritɨ 'akuxi: “Haika tukari 'aye'ayu nepanukukeni”.  
\v 64 'Ayumieme ketineuta'aita teukiya mɨta'ɨwiyarienikɨ haika tukari, kapa teyɨ'ɨkitɨwamete yɨwikɨta me'u'axɨame me'inawanikɨ, mɨpaɨ kapa metewarutahɨawekɨ teɨteri: “Mɨkite watsata panukuke”. Xɨka mɨpaɨ mete'uyurieni, 'imatɨrieka mieme 'itarika pe'iwa matɨari mieme.   
\p
\v 65 Piratu mɨpaɨ katiniwarutahɨawe:  
\p —Kuyaxi xekeniwaranuwitɨki, xekenehu yemekɨ 'aixɨa renakame xekenehayewa teukiya.   
\p
\v 66 Hikɨ mɨkɨ mehekɨneka, teukiya mekaneunani tetekɨ, meta mekaniyu'inɨaritɨani, metatsiere kuyaxi mana mekaniwaru'uitɨani memihɨkakɨ.   
\c 28  
\s1 Kemɨranukuke  
\r (Mat 28:1-8 – Mar 16:1-8, Ruk 24:1-10)  
\p
\v 1 Merikɨtsɨ 'uxipiya tukari 'utaxɨku, tumikuti ximeri yuimuana Mariya Mararatanaka meta xewitɨ Mariya matɨa mana mekaniu'axɨani me'ixeiyake teukiya.   
\p
\v 2 Hikɨ kwie karima kaniutayuani, taheima kanakaneni niuki tuayame Ti'aitame hetsɨa mieme, hikɨ nuaka teté kaneukɨhɨani, meta hetsiena kanayerɨni.  
\v 3 Merɨkariya hepaɨ pɨtiyuxexeiyakai, 'ixurikiteya pɨtuxakai 'ɨwi hepaɨ.  
\v 4 Tehɨwemete kuyaxi me'imakatɨ meputiyɨyɨakaxɨ meta marikakɨ mekaniu'amɨxɨani.   
\p
\v 5 Hikɨ niuki tuayame mɨpaɨ katiniwarutahɨawe 'ukari:  
\p —Xepɨkamamaka, ne mɨpaɨ nepɨtimate Ketsutsi xepɨkuwautɨwe, kuruxitsie mumierie.  
\v 6 'Uwa pɨkayeka, panukuketɨarie kemainekai. Xekenakɨni xekeneutanenieri hakewa matekiekai.  
\v 7 Hikɨ kwitɨwa xekenehu, mɨpaɨ xeketeniwaretahɨawi teyɨ'ɨkitɨwametemama: “Mɨkɨ panukuketɨarie mɨkite watsata, meta petɨari Karereyatsie paitɨ. Mana xekaneixeiyakuni”. Xekena'eriwani kenemɨtixe'utahɨawixɨ.   
\p
\v 8 Hikɨ 'ukarawetsixi mekanayekɨne meyumexɨitɨatɨ teukiyapa meyekɨneka, memamatɨ peru waɨkawa meyutemamawietɨ, meta mekaniutinautsa memɨtewataxatɨanikɨ teyɨ'ɨkitɨwametemama.  
\v 9 Hikɨ mexi me'uhukai, Ketsutsi kaniwaranukunake, hikɨ kaniwarutawaɨritɨani.  
\p Hikɨ mɨkɨ hurawa mekaniukɨne, 'ɨkateya mekaniu'ɨni meta mekaniutihɨxima'uni hɨxiena.   
\p
\v 10 Hikɨ mɨpaɨ katiniwarutahɨawe Ketsutsi:  
\p —Xepɨkaheumamaka, xekenehu, xeketeniwaretaxatɨa ne'iwama Karereya mekehekɨne, mana mekanenexeiyakuni.   
\s1 Kuyaxi kememutiyua  
\p
\v 11 Merikɨtsɨ mexi 'ukari huyeta me'uhukai, hipatɨ kuyaxi kiekaritsie mekanekɨne, kemɨtiuyɨ naime mekateniwarutaxatɨani mawari wewiwamete tewa'aitɨwamete.  
\v 12 Hikɨ mɨkɨ 'ukirawetsixi wahamatɨa me'uyukuxeɨrieka me'uyu'enieka yunaitɨ, tumini waɨkawa mekaniwaru'ɨitɨani kuyaxi,  
\v 13 mɨpaɨ metewarahɨawetɨ: «Xeme mɨpaɨ xekeneutiyuaneni: Mexi tekutsukai, teyɨ'ɨkitɨwametemama mekaniu'axɨani mekaninawani kaxari.  
\v 14 Xɨka kuwexinaruri tiutamarieni, tame 'aixɨa tepɨteyurieni xehetsie mɨkarahɨiyanikɨ».   
\p
\v 15 Hikɨ mɨkɨ tumini me'anu'ɨka yamekaniutiyuanekaitɨni kememɨte'uta'aitɨariekai. Mɨpaɨ tiuyɨku mɨpaɨ pɨtikuxaxatsiwa naitsarie huriyutsixi watsata hikɨ 'akuxi.   
\s1 Ketsutsi kemɨtiwaruhɨritɨa nɨ'ariekate  
\p
\v 16 Hikɨ teyɨ'ɨkitɨwamete tamamata heimana xewi Karereya mekanekɨne, mɨkɨ yemuritsie paitɨ Ketsutsi kemɨtiwarahɨawekai.  
\v 17 Me'ixeiyaka hɨxiena mekaniukatunuma'uni, peru hipatɨ mɨkɨ 'akuxi yuri mepɨkate'eriekai xɨka yuritɨkaitɨni.  
\v 18 Hikɨ Ketsutsi 'ahurawa kaniuyani, katiniwarutaxatɨani, mɨpaɨ 'utaitɨ:  
\p —Naimekɨ heitserie nepexeiya taheima meta kwiepa.  
\v 19 'Ayumieme, xekenehu, teyɨ'ɨkitɨwamete xekeniwarayeitɨa yunaime nuiwarite, xewaka'ɨyatɨ Ta'ukiyari meta Nu'aya meta 'Iyari Mɨtiyupata hetsiemieme,  
\v 20 xetewa'ɨkitɨatɨ yamemɨtekahunikɨ naime xeme kenemɨtixe'u'aitɨa. Yurikɨ mɨpaɨ xeketenemaika, netsietɨ tukarikɨ xehamatɨa nekaniuyeikamɨkɨ, kepaukake kwie meutipare. Mɨpaɨ xeikɨa kani'aneni.   