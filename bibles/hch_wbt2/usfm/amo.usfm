\id AMO  
\h 'Amuxi 
\toc1 'Amuxi 
\toc2 'Amuxi 
\toc3 'Amu 
\mt1 'Amuxi  
\c 1  
\p
\v 1 'Ikɨ 'Amuxi kaniniukieyatɨni. Mɨkɨ muxatsi wahɨweme pɨhɨkɨtɨkai Tekuha paitɨ. Mɨpaɨ katiniuniere 'ixaheritsixi teɨteriyari wahepaɨtsita. 'Ana 'Utsiyaxi pɨti'aitametɨkai Kura kwieyaritsie, meta Keruwuhani Kuhatsi nu'aya 'Ixaheri kwieyaritsie pɨti'aitametɨkai. Yakatinikuxatakaitɨni huta wiyari heuyewekakaku 'akuxi kepauka kwie mutayua.   
\p
\v 2 'Amuxi mɨpaɨ kaniutayɨni:  
\q1 «Yawé kaniuyutahaxɨatɨwani Tsiyunitsie 'uyeikatɨ,  
\q2 Kerutsareme paitɨ hiwarieya pe'enierie.  
\q1 Muxatsi wa'ɨxa kaniutiyɨnare,  
\q2 meta Kaximeru hɨriyaritsie naitɨ katiniukuwaukeni».   
\s1 Kiekari hurawa mukumane hepaɨtsita  
\p
\v 3 Yawé mɨpaɨ kanaineni:  
\q1 «Ramatsiku kiekatari waɨkawa 'axamepɨte'uyuri,  
\q2 'ayumieme ne nepɨkareiyehɨwirieni.  
\q1 Karaha kwieyari memakupɨnaxɨkɨ,  
\q2 tepɨa 'uwamekɨ.   
\q1
\v 4 'Ayumieme tai nepanunɨ'ani Katsaheri paratsiyuyata,  
\q2 Weni-'Arari kuraruya 'aixɨa mɨ'ane mɨtaxɨtsitɨanikɨ.   
\q1
\v 5 Ramatsiku kiekatari wa'ituparitsie meukuwe nepeumura,  
\q2 mayeweritsie 'Aweni mɨti'aitame nekanika'unamɨkɨ,  
\q2 meta Weti-'Ereni mieme 'itsɨ makwe'e.  
\q1 Tsiriya kiekatari waɨriyarika mepanuhapanieni  
\q2 'ateewa Kixi paitɨ»,  
\qr Yawé mɨpaɨ kanaineni.   
\p
\v 6 Yawé mɨpaɨ kanaineni:  
\q1 «Kahatsa kiekatari waɨkawa 'axamepɨte'uyuri,  
\q2 'ayumieme ne nepɨkatiwareuyehɨwirieni.  
\q1 Xei nuiwariyari yunaime memɨwarehapakɨ,  
\q2 'Erumi kiekatari wahetsɨa mewatuanike,   
\q1
\v 7 'ayumieme tai nepanunɨ'ani Kahatsa kiekatari watetsariyatsie,  
\q2 kuraruya mɨtaxɨtsitɨanikɨ.   
\q1
\v 8 'Atsiruri kiekariyaritsie mɨti'aita nepɨka'una,  
\q2 meta 'Atsikaruni 'itsɨ makwe'e nepɨka'una.  
\q1 'Ekuruni kiekatari nepɨwatihutsuni nemamakɨ,  
\q2 meta piritsiteutsixi yunaitɨ mepukumaweriyarieni»,  
\qr Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni.   
\p
\v 9 Yawé mɨpaɨ kanaineni:  
\q1 «Tiru kiekatari waɨkawa 'axamepɨte'uyuri  
\q2 'ayumieme, ne nepɨkatiwareuyehɨwirieni:  
\q1 Yunaime kiekarite teɨteri memehapanie meha'atɨkaime 'Erumi xemutuirikɨ,  
\q2 mepɨkahaye'eri tsepa yu'iwama wahamatɨa kememɨte'uxatakai.   
\q1
\v 10 'Ayumieme tai nepanunɨ'ani Tiru kiekatari watetsariyatsie,  
\q2 kuraru 'aixɨa mɨ'ane mɨtaxɨtsitɨanikɨ».   
\p
\v 11 Yawé mɨpaɨ kanaineni:  
\q1 «'Erumi kiekatari waɨkawa 'axamepɨte'uyuri,  
\q2 'ayumieme ne nepɨkatiwareuyehɨwirieni,  
\q1 mepɨwareutaweiyaxɨa yu'iwama mewakwikutɨ 'ixiparakɨ,  
\q2 mepɨka'uyupitɨa memɨte'uyukanenimayakakɨ,  
\q1 'amepɨteheuterixɨ meha'atɨ  
\q2 'amepɨtitekai meha'atɨ.   
\q1
\v 12 'Ayumieme tai nepanunɨ'ani Temani kiekatari wahetsie,  
\q2 Wutsira kiekatari wakuraru 'aixɨa mɨ'ane mɨtaxɨtsitɨanikɨ».   
\p
\v 13 Yawé mɨpaɨ kanaineni:  
\q1 «'Amunitsixi waɨkawa 'axamemɨte'uyuri,  
\q2 'ayumieme ne nepɨkatiwareuyehɨwirieni.  
\q1 Karikɨ yukwie 'amemɨtayeuriyakɨ,  
\q2 Karaha kiekatari 'ukarawetsixi memayehukatɨkatei  
\q2 wahukatsie 'ixiparakɨ mepɨwareuxitexɨa.   
\q1
\v 14 'Ayumieme tai nepɨtaiya Xawaha kuraruyaritsie,  
\q2 wakuraru 'aixɨa mɨ'ane mɨtaxɨtsitɨanikɨ,  
\q1 'ana meputihiwani meyukwitɨwetɨ,  
\q2 teɨka putatɨrarɨkani nepi'enieni.   
\q1
\v 15 Tiwa'aitɨwame 'ateewa paitɨ panuhanieni,  
\q2 meta 'iparewiwamete yunaitɨ»,  
\qr Yawé mɨpaɨ kanaineni.   
\c 2  
\p
\v 1 Yawé mɨpaɨ kanaineni:  
\q1 «Muhawi ke'axamɨtiuyuri waɨkawa katiniuyurieni,  
\q2 'ayumieme nepɨkareiyehɨwirieni:  
\q1 'Erumi kwieyaritsie ti'aitame 'umeteya memutitaiyaxɨkɨ,  
\q2 naxi memeyeitɨakɨ,   
\q1
\v 2 tai nekananunɨ'amɨkɨ Muhawi hetsie  
\q2 Keriuti kiekariyari 'aixɨa mɨ'ane mɨtaxɨtsitɨanikɨ,  
\q1 'ana Muhawi kanimɨmɨkɨ waɨkawa tɨranariyatsata  
\q2 meta me'utihiwakaku yukukuyamete meta kuxineta hayuanekaku.   
\q1
\v 3 Ti'aitame wahetsɨa mieme nekanikumaweriyamɨkɨ,  
\q2 meta yunaitɨ memiparewie nepɨwakwini»,  
\qr Yawé mɨpaɨ kanaineni.   
\p
\v 4 Yawé mɨpaɨ paine:  
\q1 «Kura ke'axamɨtiuyuri waɨkawa katiniuyurieni,  
\q2 'ayumieme nepɨkareiyehɨwirieni:  
\q1 Mɨkɨ yu'itarikatsie metewitɨ mepeuyexɨri,  
\q2 kememɨte'uyuri watutsima,  
\q1 mepiku'eiri Yawé 'aitsikaya  
\q2 mepɨkaheye'atɨa kemɨtiu'aitaxɨ.   
\q1
\v 5 'Ayumieme tai nepanunɨ'ani Kura hetsie,  
\q2 Kerutsareme kuraruya 'aixɨa mɨ'ane mɨtaxɨtsitɨanikɨ».   
\s1 'Ixaheritsie ke'axamemɨte'anuyekɨne  
\p
\v 6 Yawé mɨpaɨ kanaineni:  
\q1 «'Ixaheritsixi waɨkawa 'axakememɨte'uyurikɨ,  
\q2 'ayumieme, nepɨkatiwareuyehɨwirieni.  
\q1 Teɨteri 'aixɨa memɨte'u'iyari mepɨwatua tuminikɨ,  
\q2 tixaɨtɨ memɨkatehexeiya, kakai xeiparitsikɨ mepɨtepata.   
\q1
\v 7 Haweri memɨyɨa wamu'utsie mepa'uwe  
\q2 kwie tumuanariyari memɨhɨkɨtɨni hepaɨ,  
\q2 meta memɨteheuyehɨwa wahuye mepɨyeitɨa.  
\q1 Paapaya meta nu'aya xeime xeikɨa 'ukaratsi hamatɨa mepukahipite,  
\q2 mɨpaɨ meteyurietɨ kenemɨtipatsie nekapatsiekame mepɨnetsi'ayeitɨwa.   
\q1
\v 8 Tsepa kemɨ'ane mawari taiyame 'aurie  
\q2 mepahipite, 'ixuriki tixaɨtɨ mɨkarexeiya miku'eiri mɨtiupataxɨ mɨkɨ hetsie mekanahipiteni,  
\q1 meta winukɨ hipame mewarutiwiyaka memɨte'akapitɨariekɨ  
\q2 Kakaɨyari tukita kɨmana mekani'ieka.   
\q1
\v 9 »Mɨya mekateniyurieka, tsepanetɨ wahetsiemieme  
\q2 'amuxeutsixi nemɨtiwaruka'unaxɨ,  
\q1 wa'ikwaxi nekaniukawani wapaitɨ  
\q2 meta wananari nekanatekixɨani wahetɨa,  
\q1 tsepanetɨ 'amemutɨkai kariuxa hepaɨ  
\q2 meta tsepa memɨtɨrɨkawikai xiu hepaɨ.   
\q1
\v 10 »Ne 'Ekipitu nekanixe'ayewitɨni,  
\q2 meta nekaniwaruwitɨximekaitɨni huta tewiyari wiyari makumawetsie,  
\q1 'amuxeutsixi wakwiepa nemɨye'anikɨ xehetsiemieme.   
\q1
\v 11 Meta nekaniwarunetɨani Kakaɨyari niukametemama xeniwema watsata  
\q2 metatsiere 'aitsika memuyuhɨritɨa temari watsata.  
\q2 ¿'Ixaheritsixi 'aku, mɨpaɨ katiɨyɨ?  
\qr Yawé mɨpaɨ kanaineni.   
\q1
\v 12 Peru xeme winu xepɨwaranu'itɨaxɨa 'aitsika memuyɨhɨritɨa  
\q2 meta Kakaɨyari niukametemama xepɨkawarupitɨa nehetsiemieme memɨtehekɨatanikɨ.   
\q1
\v 13 »'Aixɨa kani'aneni, hikɨri ne 'ari nekanixetipɨnarɨmeni,  
\q2 kemɨtiyupɨna kaxeta tɨriku 'atɨtɨ.   
\q1
\v 14 Hikɨ xewitɨ muyuta'una pɨkayɨweni kwinimieme mɨranautsawe,  
\q2 meta mɨtɨrɨkaɨye tɨrɨkariyaya hawaikɨ pɨkarenake,  
\q2 meta kwinimieme mɨreuyutamieme yutukari pɨkatawikweitsitɨani.   
\q1
\v 15 'Ɨrɨkɨ kwinimieme mɨreutamɨiwe pɨkayuta'una,  
\q2 meta kwinimieme mɨranautsawe pɨkatawikweni,  
\q2 meta kawayutsie meutayerɨwe pɨkayuta'una.   
\q1
\v 16 'Iya tukaritsie matsi tixaɨtɨ karapitɨ kaniyuta'unamɨkɨ,  
\q2 tsepanetɨ kuya kwinimieme mɨreuyutamiewe»,  
\qr Yawé mɨpaɨ kanaineni.   
\c 3  
\s1 Kakaɨyari niukameya 'Amuxi kemutayɨ  
\p
\v 1 Xekeneu'eni 'ixaheritsixi, 'ikɨ Yawé niukieya kemaine xehepaɨtsita, yunaime nuiwari hetsiemieme 'Ekipitu nemɨwarayewitɨ:   
\q1
\v 2 «Xeme xeikɨa nekanixe'anayexeiya  
\q2 yunaime kwiepa memɨtama watsata.  
\q1 'Ayumieme, nekatinixe'akapitɨamɨkɨ  
\q2 naimekɨ ke'axaxemɨte'uyuri».   
\b  
\q1
\v 3 Pɨkayɨwe yuhutatɨ muhunikɨ  
\q2 yamekatexatawawetɨ.   
\q1
\v 4 Maye yeuta pɨkahayuhaxɨatɨwa  
\q2 xɨka tixaɨtɨ katikwaka.  
\q1 Maye nunutsi pɨkaha'a yuterɨta  
\q2 xɨka tixaɨtɨ katikwaka.   
\q1
\v 5 Wiki winiyaritsie pɨka'uyewiere xɨka  
\q2 mana katiuyewieka.  
\q1 Winiyari pɨkakuyuane xɨka  
\q2 tixaɨtɨ katiwieriweni.   
\q1
\v 6 Kuxineta kiekaritsie kaniutahɨtsieriwani  
\q2 kiekatari mɨpaɨ memɨteyu'ɨwiyanikɨ.  
\q1 Kiekaritsie yɨkɨ pɨkatiyɨni  
\q2 xɨka Yawé mɨpaɨ kahaineni.   
\b  
\q1
\v 7 Yurikɨ, Yawé naimekɨmɨyɨwe yɨkɨ pɨkatiyurieni  
\q2 yuniukamete katiwataxatɨawetɨ  
\q2 kemɨtiyurieni.   
\b  
\q1
\v 8 Maye xɨka heyutahaxɨatɨani,  
\q2 ¿kemɨ'ane pɨkatimani?  
\q1 Xɨka Yawé naimekɨmɨyɨwe haniukani,  
\q2 ¿kemɨ'ane niukameyatɨtɨ pɨkatitaxata?   
\s1 'Ixaheri kemɨti'uximatɨarieni  
\q1
\v 9 'Ikɨ xeketenekuxatani kiekari 'aixɨa mɨrekukurarutɨiyarie 'Atsiruri  
\q2 meta kiekari 'aixɨa mɨ'anene 'Ekipitu mieme:  
\q1 «Tsamariya hɨriyaritetsie xekeneuyukuxeɨri  
\q2 meke'uneniere kememɨtemama,  
\q2 nanaimarika kemɨtixuawe mana».   
\b  
\q1
\v 10 «Yukii 'aixɨa mɨ'aneneta memɨtehɨniya  
\q2 'inawari meta memɨtewanawairie hipame waɨriyarika  
\q2 mɨkɨ mepɨka'imate tita heitserie muyeikani mɨranɨyɨne»,  
\qr Yawé mɨpaɨ kanaineni.   
\p
\v 11 'Ayumieme, Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni:  
\q1 «Xewitɨ mɨmetsi'aye'unie 'akiekari kanika'unamɨkɨ,  
\q2 kepemɨtitɨrɨkaɨye kamena'iwamɨkɨ  
\q2 meta 'apiinite kametininawairiemɨkɨ».   
\p
\v 12 Yawé mɨpaɨ kanaineni:  
\q1 «Muxatsi wahɨweme maye kemɨtikunawairiwa  
\q2 heiwa hutame 'ɨkate ya naka 'etsiyeume,  
\q1 mɨpaɨ mekatenitawikweitsitɨariekuni 'ixaheritsixi,  
\q2 Tsamariyatsie kiekatari  
\q2 yu'utá 'etsikinayaritsie xeikɨa meta Ramatsikutsie».   
\p
\v 13 Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni, Kakaɨyari Naimekɨmɨtɨrɨkaɨye:  
\p «'Ikɨ xeketeneu'eni xeketenekuxatani Kakuwu tɨɨriyamama wahepaɨtsita.   
\q1
\v 14 »Kepauka nemɨrekapitɨani 'Ixaheri 'axamɨtiuyurikɨ,  
\q2 nekanika'unamɨkɨ mɨratimawatɨre Weteri,  
\q1 mɨratimawatɨre 'awateya kanakainixɨamɨkɨ,  
\q2 kwiepa kanikaxɨrimɨkɨ.   
\q1
\v 15 Nekaneti'unamɨkɨ kii muhaɨtɨnitsie mieme  
\q2 meta witarita mieme.  
\q1 Kanati'unixɨamɨkɨ kii maripirikɨ witsimɨreukuwewiyatɨka  
\q2 meta waɨkawa kii witsimɨ'anene kanika'unixɨamɨkɨ»,  
\qr Yawé mɨpaɨ kanaineni.   
\b  
\c 4  
\q1
\v 1 'Ikɨ niuki xeme xekeneu'eni, wakaitsixi Watsani miemete,  
\q2 Tsamariya hɨriyaritsie xemu'uwa,  
\q1 haweri memɨ'anene xemɨwananaima  
\q2 meta tixaɨtɨ memɨkatehexeiya,  
\q1 yɨkɨnama mɨpaɨ xemɨtewakɨhɨawe:  
\q2 «Xeketatenahapaniri tepanu'ieni».   
\q1
\v 2 Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni kemɨtipatsiekɨ:  
\q2 «Tukari kanaye'amɨkɨ xeme xenuiwaritsie, 'imatɨrieka mieme  
\q2 kananuhaniemɨkɨ tepɨa 'utakeitsitɨarietɨ.   
\q1
\v 3 Kuraru haxawakaku xekananetɨariekuni yu'utɨa xeheu'utɨ,  
\q2 Heximuni hɨriyaritsie xekanitiyunitɨariekuni  
\qr —Yawé mɨpaɨ kanaineni—.   
\b  
\q1
\v 4 »Xekenehu Weteri mana 'axaxeketeneyurieka.  
\q2 Kirikari xekenehu manata yaxeikɨa 'axaxeketeneyurieka,  
\q1 ximeri xeketenemawatɨweni,  
\q2 meta hairieka tukaritsie tamamata hetsiemieme xeime xekeneyetuayani.   
\q1
\v 5 Paa mukuxanariyarie xekenetitaiyani pamɨpariyutsi mawariyari mɨhɨkɨtɨnikɨ  
\q2 meta hipame xeketeniwarutaxatɨa mawari memɨyetuanikɨ kememɨteyuwaɨriya.  
\q1 Yaxeketeneuyuri yunaitɨ 'ixaheritsixi yamemɨtehetimanikɨ,  
\q2 mɨkɨ xeme mɨxenakekɨ  
\qr —Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni—.   
\s1 'Ixaheritsixi kememɨkateyuwaɨriya  
\q1
\v 6 »Ne haaka nekaniutixuawitɨani naitsarie xekiekaritetsie,  
\q2 paa memɨkakwakakɨ yanepɨtiuyuri xemukutetɨkatsie.  
\q2 Mɨyatɨtɨ, xeme nehetsɨa xepɨka'u'axɨa  
\qr —Yawé mɨpaɨ kanaineni—.   
\b  
\q1
\v 7 »Ne yanepɨtiuyuri mɨkakawiyekɨ  
\q2 kepauka meuyewekai 'akuxi haika metseri mɨtika'itsanatɨtsie.  
\q1 Xeime kiekariyaritsie pukawiyexɨ,  
\q2 xaɨtsieta hawaikɨ,  
\q1 xeime 'etsarita xeikɨa pukawiyexɨ,  
\q2 xaɨtsie pɨka'ukawiyexɨ, 'ayumieme pɨtiutiwa.   
\q1
\v 8 Hau'erietɨ mekaneu'uwakaitɨni tsepa kemɨ'ane kiekaritsie teɨteri haa mekuwautɨwetɨ,  
\q2 peru yaxeikɨa mepɨteheuharikukai.  
\q2 Mɨyatɨtɨ, xeme nehetsɨa xepɨka'u'axɨa  
\qr —Yawé mɨpaɨ kanaineni—.   
\b  
\q1
\v 9 »Wa'etsaripa 'utsikari wahekɨ nepɨwaru'uximatɨa meta mɨtitiwanikɨ,  
\q2 'utsikari naime mepɨteheukuxɨxɨa waharawerita meta kaxie memɨwa'etsatsie,  
\q1 wapiní meta wahuriwu.  
\q2 Mɨyatɨtɨ, xeme nehetsɨa xepɨka'u'axɨa  
\qr —Yawé mɨpaɨ kanaineni—.   
\b  
\q1
\v 10 »Waɨkawa 'uximatɨarika nepenɨ'a  
\q2 'Ekipitu hepaɨ.  
\q1 Temari 'aixɨa memɨ'anene 'ixiparakɨ nepɨwarukwi,  
\q2 wakawayutsixi yunaitɨ meputiwiyarie.  
\q1 Yanepɨtiuyuri yutsurita memi'ɨkwekɨ  
\q2 mɨkite wa'ɨakariyari.  
\q2 Mɨyatɨtɨ, xeme xepɨkanetsihaye'eri  
\qr —Yawé mɨpaɨ kanaineni—.   
\b  
\q1
\v 11 »Ne nepɨxe'uka'unaxɨ  
\q2 Tsuruma meta Kumuxa hepaɨ,  
\q1 tɨɨyari xeikɨa xepuyuhayewaxɨ tai mihayewaxɨ hepaɨ.  
\q2 Mɨyatɨtɨ, xeme xepɨkanetsi'aye'eri  
\qr ―Yawé mɨpaɨ kanaineni―.   
\b  
\q1
\v 12 »'Ixaheri, 'ayumieme hikɨta nepɨmetika'enitsitɨani,  
\q2 yanemɨtiyurienikɨ,  
\q2 'Ixaheri, keneyukuha'aritɨwani, 'akakaɨyari pemanunakekɨ».   
\b  
\q1
\v 13 Ne nekanihɨkɨtɨni hɨri nemɨtiwewiwa,  
\q2 meta 'eka nemunenetɨwa,  
\q2 ne nekanihɨkɨtɨni tewi kemɨtiyurieni nemihekɨata,  
\q1 meta hekɨariya yɨriya nemunenetɨwa,  
\q2 meta kwie heima nemuyeika:  
\q2 Yawé Kakaɨyari Naimekɨmɨtɨrɨkaɨye nekatinitewaka.   
\c 5  
\s1 Mari'itɨarika meta heiwerika  
\q1
\v 1 'Ikɨ niuki xekeneu'eni, 'ixaheritsixi teɨteriyari,  
\q2 'ikɨ heiwerika kwikariyari 'ahetsiemieme neminɨawa:   
\b  
\q1
\v 2 «'Ari 'Ixaheri 'uka 'ɨimari kanatiweni,  
\q2 tawariri pɨka'anukukeni,  
\q1 yukwiepa kaniukani,  
\q2 pumaweni kemɨ'ane menukuhana».   
\p
\v 3 Yawé naimekɨmɨyɨwe mɨpaɨ 'Ixaheri kwieyari katinahɨaweni:  
\q1 «'Iya kiekari kuyaxa mɨwewienekai xeimiriyari warawitɨtɨ kuyaxi  
\q2 mɨkɨ xeitsienituyari warexeiyatɨ xeikɨa payani,  
\q1 meta xeitsienituyari kuyaxi warawitɨtɨ muyumienekai  
\q2 tamamata xeikɨa warexeiyatɨ kanayeimɨkɨ».   
\p
\v 4 Yawé mɨpaɨ 'Ixaheri kwieyari katinahɨaweni:  
\q1 «Xekeneneutiwawa hikɨ 'ana xe'ayeyuyuritɨ xepakɨne.   
\q2
\v 5 Peru Weteri xepɨkaheta'axeni,  
\q1 meta Kirikari xepɨkahekɨkani,  
\q2 meta Weritsewa xepɨka'uyekɨkani,  
\q1 mɨkɨ Kirikari kananuhaniemɨkɨ 'ateewa paitɨ,  
\q2 meta Weteri, nitixaɨtɨ pɨkarayeitɨarieni».   
\b  
\q1
\v 6 Yawé xekeneutiwawa xe'ayeyuyuritɨ xemakɨnekɨ,  
\q2 kapa mɨkɨ tai hepaɨ 'anetɨ 'ukawenikɨ,  
\q2 Kutse nuiwarimama wahetsie,  
\q1 tai Weteri kaniutataiyaweni  
\q2 nixewitɨ pɨka'itɨwe.   
\q1
\v 7 Xeme tita mɨtiheitserie ratsiwime xepɨtehayeitɨwa  
\q2 meta 'aixɨa mɨti'ane kwiepa xepehɨpa.   
\b  
\q1
\v 8 Yawé Tsimanixi meta Terɨka puwarutiwewi,  
\q2 yɨriya xawatɨriya payeitɨwa  
\q2 meta tukari tɨkari payeitɨwa.  
\q1 Mɨkɨ haa haramaratsie mieme putahɨawe  
\q2 'ana kwie pukahatuiya.  
\q2 Mɨkɨ Yawé katinitewaka.   
\q1
\v 9 Mɨkɨ, naime 'aixɨa mɨrekukurarutɨiyarie nitixaɨtɨ pɨkarayeitɨwa  
\q2 meta kii mɨmamariwawe 'u'unime payeitɨwa.   
\b  
\q1
\v 10 Xeme xepi'uxiwe'erie tita mɨtiheitserie hetsie munua 'itsɨkate wahɨxie  
\q2 meta xepixani'erie kemɨ'ane yurikɨ mɨtikuxata.   
\q1
\v 11 Haweri memɨ'anene xemɨwaketsitɨwekɨ  
\q2 meta waɨkawa 'anamanemekɨ xemɨtewawawirie 'ikukɨ meteyutuakaku,  
\q1 'ayumieme xeme yutetexi kiiyarita xepɨka'ayeyaxe xemitiwewi,  
\q2 meta winu xepɨka'anu'ieni yukaxietsie mieme xemika'e.   
\q1
\v 12 Ne nepɨtimate kepaɨmeme xemɨte'apine,  
\q2 pɨmɨireri ke'axaxemɨte'uyuri.  
\b  
\q1 Xeme xepɨwananaima heitseriemekɨ yamemɨtekahu, waɨriyarika xepɨtewawawirie  
\q2 meta 'itsɨkate wahɨxie mɨreuyehɨwa xepekahɨpa.   
\q1
\v 13 'Ayumieme mɨya mɨ'anekɨ mɨtimaiwe kayuwatɨ pɨta puyeika,  
\q2 'ikɨ tukari 'aixɨa mɨka'anenekɨri.   
\b  
\q1
\v 14 'Aixɨa mɨti'ane xeketenekuwawa 'axamɨti'ane xepɨkatewautɨweni, hikɨ 'ana xepu'uwani,  
\q2 mɨpaɨ xe'anenekaku Yawé Kakaɨyari Naimekɨmɨtɨrɨkaɨye xehamatɨa puyeikani,  
\q2 xeme kexemaitɨka.   
\b  
\q1
\v 15 'Axamɨti'ane xeketenexani'erieka matsi 'aixɨa mɨti'ane xeketenenaki'erieka.  
\q2 Tita mɨtiheitserie keti'aitani memati'iwawiyarɨwatsie,  
\q1 mɨpaɨ heiwatɨ Yawé, Kakaɨyari Naimekɨmɨtɨrɨkaɨye,  
\q2 Kutse nuiwarimama memuyuhayewatɨwe warutinenimayata.   
\p
\v 16 'Ayumieme Yawé naimekɨmɨyɨwe, Kakaɨyari Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni:  
\q1 «Naitsarie teɨteri memayukuxexeɨriwatsie kani'enieriemɨkɨ hiwerika,  
\q2 meta naitsarie kayetetsie 'uximatɨarika hiwariyari puxuaweni.  
\q1 Memɨte'uximayatatɨwe yu'etsita mepɨta'inierieni memɨyuhiweriekakɨ,  
\q2 meta waɨkawa memeutatsuawawe mepɨta'inierieni memɨtitsuanikɨ memɨwahiweritɨanikɨ.   
\q1
\v 17 Pɨ'enierieni tsuari naitsarie kaxie haraweriyaritetsie  
\q2 kepauka ne mana 'ahetsɨa nemunuani»,  
\qr Yawé mɨpaɨ kanaineni.   
\b  
\q1
\v 18 Xɨa'ui xeme, kekuta tekanitakwewieka,  
\q2 xemaitɨka Yawé munuanikɨ.  
\q1 'Ana kuhekɨareke xepɨka'erieka  
\q2 matsi yɨriya kaninuamɨkɨ 'axa'anemekɨ.   
\q1
\v 19 Mɨpaɨ katiniyɨmɨkɨ xewitɨ maye 'umakarɨmetɨ  
\q2 matsi hutse pɨta mitakwani hepaɨ,  
\q1 yatɨni xewitɨ nuame yukie  
\q2 yukitenie mɨrawiyakekai  
\q2 kuu hetsie mumei mikei hepaɨ.   
\q1
\v 20 Yawé munuanitsie pɨkakuhekɨare matsi pɨkɨyɨre.  
\q2 Yurikɨ temawierika pɨkaxuaweni matsi pɨta nutuixiya puxuaweni.   
\b  
\q1
\v 21 «Ne nepi'uxiwe'erie 'ixɨarari kexemɨte'ayexeiya,  
\q2 nepɨkanaki'a tsepa patsiekamekɨ xemɨyukuxexeɨriwa nehetsiemieme.   
\q1
\v 22 Tsepa xemɨnetsi'atɨiriwa mawari taiyariyari meta hatsi mawariyari,  
\q2 ne nepɨka'itanaki'erieni,  
\q1 meta nepɨkaxe'enieni  
\q2 tsepa tsikeru xemɨnetsi'utimawiri 'aixɨa temɨteyuxeiyanikɨ mawariyari.   
\q1
\v 23 'Akwikari pepɨkanetsi'enitsitɨaka,  
\q2 'akanari yuariyaya nepɨkaheu'enimɨkɨ.   
\q1
\v 24 Matsi pɨta 'aixɨa mɨti'ane kexuaweni,  
\q2 mɨtiheitserie ke'uhaneni haixa mɨka'ukawauke hepaɨ.   
\b  
\q1
\v 25 »Teɨteri 'ixaheritsixi, mawari xepɨkanetsi'uwewiri meta 'imikieri,  
\q2 makumawetsie xe'uhutɨ huta tewiyari wiyari.   
\q1
\v 26 Hikɨ xeme xekanititɨkuni Tsikuti 'ɨkiyari ti'aitame xemɨte'iterɨwa,  
\q2 metatsiere Kiyuni,  
\q1 xurawetsixi wa'ɨkiyari  
\q2 xemetɨtɨ xemɨwarutiwewi.   
\q1
\v 27 Hikɨ nekanixe'anunɨ'amɨkɨ xemanuhapanienikɨ Ramatsiku yeta paitɨ»,  
\q2 Yawé mɨpaɨ kanaineni, Kakaɨyari Naimekɨmɨtɨrɨkaɨye mɨtitewa.   
\b  
\c 6  
\q1
\v 1 Xɨa'ui xeme Kerutsareme xemɨtama kayuwatɨ xemexeiya,  
\q2 xɨa'ui meta xeme Tsamariya hɨriyaritsie xemɨtama 'aixɨa 'iyari xemu'uwa.  
\q1 Xɨa'ui xeme xemɨmamariwawe 'ikɨ kwieyaritsie xemu'uwa,  
\q2 teɨteri 'ixaheritsixi memɨxe'ayexeiya xeikɨa.   
\q1
\v 2 Karine xekenehu, xekenexeiya,  
\q2 manata Kamati mɨmariwe hetsie xekenehu,  
\q2 metatsiere Kahati xekenehu piritsiteutsixi wakiekaritsie.  
\q1 ¿Kamɨtsɨ xeme matsi waɨkawa xetemamariwawe keyuri mɨkɨ te'aitamete,  
\q2 matsi xekwieyari 'atiyewa?   
\q1
\v 3 Xeme mɨpaɨ xepɨtemate 'uximatɨarika tukariyari xe'uku'eirieme xepuyu'erie,  
\q2 matsi te'aitamete memɨxekwinikɨ hurawa xekaniuhuni.   
\q1
\v 4 Xeme hupume witsimɨ'anenetsie xemahipite 'eripanite 'awateyakɨ ra'utɨkaime,  
\q2 xe'uheitɨ xepaka'iyuniwa,  
\q1 muxatsi 'aixɨa memɨ'anene xemɨwakwa'a  
\q2 meta tsikerutsixi memɨwaiyatɨarietɨka,   
\q1
\v 5 Rawiri hepaɨ xeikɨa,  
\q2 kwikari xepɨ'aita kaitsa hayuanekaku,  
\q2 meta xepinetɨa tiyuitɨwamete yukɨ 'aneneme,   
\q1
\v 6 winu xepɨye'e watsu 'amɨneneta  
\q2 meta witsimu'ɨa xepɨyutiwiriwa 'aixɨa mɨ'ane,  
\q2 xekayu'iyaritɨatɨ Kutse kemɨtika'unarieni,   
\q1
\v 7 xeme meri xe'anuyetetɨ xekananuhapaniekuni,  
\q2 mɨpaɨ katineutiparimɨkɨ 'ikwai memuxuawitɨa 'atsimekateyurietɨ.   
\b  
\q1
\v 8 Yawé naimekɨmɨyɨwe mɨpaɨ kaniutayɨni yɨhɨritɨatɨ,  
\q2 Yawé Kakaɨyari Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni:  
\b  
\q1 «'Ixaheritsixi kememɨteyuti'ɨre nepɨxani'erie,  
\q2 waparatsiyu nepu'uxiwe'erie,  
\q1 'ayumieme wakiekari nepɨyetuani mɨwaraye'unie hetsɨa,  
\q2 meta naime mana mɨtiyepine».   
\p
\v 9 Mɨpaɨ katiniyɨmɨkɨ xɨka xeikiiyarita tamamata teɨteri meyuhayewa, mɨkɨ yunaitɨ mekanikwikuni.  
\v 10 Kepauka memɨ'axɨani mɨkite mewaku'ɨtɨwetɨ mewatitaiyake, xewitɨ mɨpaɨ katinitahɨawimɨkɨ yu'iwa: «¿Xewitɨ 'akuxi 'ahamatɨa tiuyeika?» 'Iya mɨpaɨ katinita'eiyamɨkɨ: «Hawaikɨ». Hikɨta mɨpaɨ katinitahɨawimɨkɨ: «Kayuwatɨ». Yawé kemɨtitewa tepɨka'ikuxatani».   
\q1
\v 11 Neuxei, Yawé katini'aitani  
\q2 mɨta'unarienikɨ kii 'amɨpa 'etsipepetɨ kanitaxɨriexɨamɨkɨ  
\q2 meta kii 'etsimupepe kanika'unamɨkɨ.   
\b  
\q1
\v 12 ¿Kamɨtsɨ kawayutsixi 'aitsie mete'utinanautsa yatɨni  
\q2 'ayeparitsie tuurutsixi metekwietsana?  
\q1 Peru xeme 'aixɨa mɨti'ane 'uaye mumɨya xepayeitɨa,  
\q2 meta tita mɨtiheitserie 'ikwaxi hatsiwime xepayeitɨa.   
\q1
\v 13 Xeme xepɨyutemamawie Ru-Rewaxi kiekariyari xema'iwaxɨkɨ,  
\q2 mɨpaɨ xeputiyuane: «¿Tatɨrɨkariyakɨ tepɨte'uyuri  
\q2 Kaxinahini tema'iwaxɨ?»   
\b  
\q1
\v 14 «'Ayumieme, 'ixaheritsixi  
\q2 xehetsɨa xeime nepanunɨ'ani  
\q1 mɨmatita'aitɨanikɨ waɨriyarika Rewu-Kamati xeyeta,  
\q2 meta 'Arawa 'akiyari manuyeka xehetɨapai ye'atɨkaime»,  
\qr Yawé mɨpaɨ kanaineni, Kakaɨyari Naimekɨmɨtɨrɨkaɨye.   
\c 7  
\s1 Haikakɨa 'Amuxi kemɨtiunieritɨarie  
\p
\v 1 Yawé naimekɨmɨyɨwe mɨpaɨ kanetiniunieritɨani: Tupiriya kanitineikakaitɨni 'ari ti'aitame hetsiemieme tiuka'itsanatɨku, hikɨ Ti'aitame nekaniuxeiya 'utsikari wakuha'aritɨwame.  
\v 2 Kepaukari 'utsikari tupiriya kwiepa memukaxɨkai mɨpaɨ nekatiniuhiwa:  
\p ―Yawé nekakaɨyari, waɨkawa nepɨmatsiwawirie ketiniwareuyehɨwiri Kakuwu nuiwarimama. Pɨkayɨwe xɨari memukuwikweni, 'etsimekaniyupaɨmeni.   
\p
\v 3 Hikɨ Yawé kaniwarutinenimayata, mɨpaɨ kaniutayɨni:  
\p ―Matsi mɨpaɨ pɨkatiyɨni.   
\p
\v 4 Meta Yawé naimekɨmɨyɨwe mɨpaɨ kanetiniunieritɨani: Mana Yawé kaniuwekaitɨni, mɨpaɨ haitɨ kename 'aixɨa tiyurienikekai taikɨ, mɨkɨ haramara meukatewatsie naime pɨtaxɨxɨtsitɨwakai metatsiere kwiepa mu'ɨtsiyatsie.  
\v 5 Hikɨ mɨpaɨ nekatiniuhiwa:  
\p ―Yawé nekakaɨyari, waɨkawa nepɨmatsiwawirie, mɨpaɨ pepɨkatiyurieneni. Xɨari mepɨkakuwikweni Kakuwu nuiwarimama, 'etsimepuyupaɨme.   
\p
\v 6 Hikɨ Yawé kaniwarutinenimayata, mɨpaɨ kaniutayɨni:  
\p ―'Ikɨ mɨpaɨta pɨkatiyɨni.   
\b  
\p
\v 7 Yawé tawarita kanetiniuxeitsitɨani: Mɨkɨ 'akaniuwekaitɨni kuraru 'amatayewa 'aurie, mɨkɨ kii 'inɨnɨatame mahete pahanakai.  
\v 8 Yawé mɨpaɨ kanetiniuta'iwawiya:  
\p ―¿'Amuxi, tita petixeiya?  
\p Mɨpaɨ nekatinita'eiya:  
\p ―Kii 'inɨnɨatame mahete pepahana.  
\p Hikɨ Ti'aitame mɨpaɨ kaniutayɨni:  
\p ―Keneuxeiya, 'ikɨ kii 'inɨnɨatame mahete neteɨterima 'ixaheritsixi wahixɨapa nekaneikahɨamɨkɨ, 'ari tawariri nepɨkatiwareuyehɨwirieni.   
\q1
\v 9 »'Itsahaki kakaɨyarixi mɨtiwaratimawiriwakaitsie naitɨ kaniti'unimɨkɨ,  
\q2 meta kaniti'unimɨkɨ 'ixaheritsixi watukite,  
\q1 nekaninuamɨkɨ 'ixipara nehakwetɨ  
\q2 Keruwuhani paratsiyuyata».   
\s1 'Amatsiyaxi 'Amuxi maye'unie  
\p
\v 10 Hikɨ 'Amatsiyaxi, mawari wewiwame Weteri kiekame, Keruwuhani niuki kanenɨ'airieni 'Ixaheritsie ti'aitame: «'Amuxi 'axakametinikuxatani 'ixaheritsixi yunaime wahɨxie. 'Ari 'ena kiekatari mepɨwaɨripie me'i'enietɨ,  
\v 11 mɨpaɨ kaniutaineni:  
\q1 »“Keruwuhani 'ixiparakɨ kanimɨmɨkɨ,  
\q2 'Ixaheri kwieyaritsie memɨtama mekananuhapaniekuni  
\q2 'ateewa paitɨ kayukwietsie”».   
\p
\v 12 Hikɨ 'Amatsiyaxi mɨpaɨ 'Amuxi katiniutahɨawe:  
\p ―Keneumieni 'ekɨ pemɨniere, mɨpaɨ petikuxatatɨ xɨka pereu'iwamɨkɨni, kenemie Kura kwieyaritsie.  
\v 13 Tawariri Weteri pepɨkarehekɨatani, 'ena ti'aitame tukieya manuwe kanihɨkɨtɨni, meta 'ikɨ kwieyaritsie tuki manuwe.   
\p
\v 14 'Amuxi mɨpaɨ 'Amatsiyaxi katiniuta'eiya:  
\p ―Ne Kakaɨyari niukameya nepɨkahɨkɨ meta Kakaɨyari niukameya nu'aya nepɨkahɨkɨ, matsi ne muxatsi nepɨwahɨweme meta piní nekaniuka'etsani.  
\v 15 Peru Yawé muxatsi watsata kanenayewitɨni, mɨpaɨ kanetiniutahɨawe: “Kenemie neniukame pepayani ketiniwarutaxatɨa 'ixaheritsixi neteɨterima”.  
\v 16 'Ayumieme Yawé niukieya keneu'eni. 'Ekɨ mɨpaɨ peputaine:  
\q1 »“'Ixaheritsixi pepɨkatiwakuxaxatɨwani,  
\q2 'Itsahaki nuiwarimama wahamatɨa petikuxatatɨ ketineuhayewa”.   
\p
\v 17 »'Ayumieme, Yawé mɨpaɨ kanaineni:  
\q1 »“'A'ɨya tuminikɨ muyumayɨinɨa payani kiekaritsie,  
\q2 'aniwema 'ukari meta 'ukitsi 'ixiparakɨ mepɨkwi'iwa.  
\q1 'Akwie pɨti'inɨatsieni meta hipatɨ mepɨxatɨarieni,  
\q2 'ekɨta pepɨmɨni kakaɨyarixi wakwieyaritsie.  
\q1 Metatsiere 'ixaheritsixi mepanuhapanieni  
\q2 'ateewa paitɨ mepuyuhayewa kayukwieyaritsie”».   
\c 8  
\s1 Naurieka kemɨtiunierixɨ meta mari'itɨarika  
\p
\v 1 Yawé naimekɨmɨyɨwe kaneniuxeitsitɨanita xeitsikɨiwitiyari 'ikwaxi kwakwaxime,  
\v 2 hikɨ mɨpaɨ kanetiniuta'iwawiya:  
\p ―¿'Amuxi, tita petixeiya?  
\p Ne mɨpaɨ nekatinita'eiya:  
\p ―Xei tsikɨiwitiyari 'ikwaxi kwakwaxime.  
\p Hikɨ Yawé mɨpaɨ kanetiniutahɨawe:  
\p ―'Ari kanaye'ani 'Ixaheri makaweni 'ikwaxi mukwaxi makaweni hepaɨ, tawariri nepɨkareiyehɨwirieni.   
\p
\v 3 »Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni:  
\p ―'Iya tukaritsie, kwikari paratsiyuta mieme hiwerika kwikariyari kanayeimɨkɨ. Yuwaɨkawatɨ mepɨkwini naitsarie mɨkite mepeutiheni. 'Ayumieme kayuwatɨ».   
\q1
\v 4 'Ikɨ xekeneu'eni, xeme memɨteheuyehɨwa xemɨwatiketsina  
\q2 meta haweri memɨ'anene xemɨwakuya 'ena kwiepa.   
\p
\v 5 Xeme mɨpaɨ xekaniutiyuaneni:  
\q1 «¿Kepaukari payeika metseri mɨhekwa 'ixɨarariyari  
\q2 'iku 'uriyari temutuanikɨ,  
\q1 yatɨni, kepaukari 'uxipiya tukari paye'ani  
\q2 tɨriku temutuanikɨ?»  
\p Xeme xepiwautɨwe  
\q1 'inɨari 'etsipeme xemeyeitɨanikɨ  
\q2 meta matsi 'amɨraye'akakɨ,  
\q1 tepɨa ti'inɨnɨatame tinawayame xemayeitɨakɨ   
\q2
\v 6 meta tɨriku meuyewexime xemutuakɨ,  
\q1 xepɨwanane teɨteri haweri memɨyɨa,  
\q2 meta memɨteheuyehɨwa, kakai xeiparitsikɨ xepɨtewapatsirie.   
\q1
\v 7 Yawé kaniyuhɨritɨani Kakuwu kemɨtiyuta'ɨrixɨkɨ: «Ne nepɨkaratɨmaiya kexemɨte'uyuri.   
\q1
\v 8 »'Ikɨ naimekɨ kwie kaniwatayuamɨkɨ.  
\q2 Mana kiekatari mekanitinutuixiekuni.  
\q1 Kwie kanitiyeimɨkɨ Niru hayari hepaɨ,  
\q2 kaniwatayuamɨkɨ meta kanikayeimɨkɨ,  
\q2 'Ekipitu hatɨayari hepaɨ.   
\p
\v 9 »Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni: 'Iya tukaritsie,  
\q1 »tuka tau nepanukayunitɨani,  
\q2 meta naitsarie kwiepa kanikuyɨrimɨkɨ.   
\q1
\v 10 Memɨte'ayexeiya wa'ixɨarari hiwerika payani,  
\q2 meta wanɨawari hiwerika kwikariyari nekanayeitɨamɨkɨ.  
\q1 Nutuixiya kamixayari nekaniwaranakatɨtɨamɨkɨ  
\q2 meta wakɨpate nekanikaximɨkɨ.  
\q1 Kemɨtiyuhiwerieka raniwe muyuxewi tiumɨyu mɨpaɨ mekatenitsuakuni,  
\q2 'imatɨrieka ratsiwitɨ pɨrayani.   
\b  
\q1
\v 11 »Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni: Tukari kanaye'amɨkɨ,  
\q2 kepauka 'ikɨ kwieyaritsie haakaxa nemanɨ'ani,  
\q1 matsi paa haakaxayari pɨka'ayani meta hariya,  
\q2 Yawé niukieya mepɨ'eniekuni matsi  
\q2 pukumawere mɨkɨ haakaxayari pɨtixuawere.   
\q1
\v 12 Teɨteri mepeu'uwani xeime haramaratsie xeimetsieta,  
\q2 mepeu'uwani xeikɨa tayeta meta tau manatineika hepatsie,  
\q1 Yawé niukieya mekuwautɨwetɨ,  
\q2 peru mepɨka'itaxeiya.   
\b  
\q1
\v 13 »Mɨkɨ tukaritsie hariyakɨ mepɨ'amɨxɨani  
\q2 'ukari witsimemɨte'ɨimarixi meta temari memɨtɨrɨkawi.   
\q1
\v 14 Meta mepatixɨrieni yuheyemekɨ  
\q2 'iya Tsamariya kakaɨyariximama wahetsɨa memɨyuhɨritɨa,  
\q1 meta mɨpaɨ me'utiyuatɨ: “Rani kakaɨyariximama, me'ayeneniereme memɨwa'erie.  
\q2 Meta Weritsewa kakaɨyariximama pemɨwarayexeiya”».   
\c 9  
\s1 'Auxɨwirieka kemɨtiunierixɨ  
\p
\v 1 Hikɨ Ti'aitame nekaniuxeiya mawari taiyame 'aurie 'uweme, mɨkɨ mɨpaɨ kaniutayɨni:  
\q1 «Keneutihutsuna memanutakɨkatsie mituikatɨka  
\q2 muwatayuanikɨ,  
\q1 wahetsie mɨkaxɨrienikɨ 'etsipepetɨ.  
\q2 Kemɨ'ane memuyuhayewa 'ixiparakɨ nekaniwakwimɨkɨ.  
\q1 Xewitɨ pɨkayuta'una,  
\q2 nixewitɨ 'ayenieretɨ pɨkayuhayewa.   
\q1
\v 2 Tsepa mɨki teukiyata 'upaitɨ memɨyuti'awietaxɨ,  
\q2 muwa nepɨwaratihapani.  
\q1 Tsepa muyuawitsie paitɨ memanutikɨ,  
\q2 manata nepɨwarakaxɨrieni.   
\q1
\v 3 Tsepa Kaximeru hɨriyaritsie memuyuti'awietaxɨ,  
\q2 mana nepɨwatiwauni nepɨwatiwiya.  
\q1 Tsepa menetsimakatɨ haramara tetɨatapai memɨyuti'awietaxɨ,  
\q2 mana kuu nepɨta'aitɨani mɨwatikenikɨ.   
\q1
\v 4 Tsepa mɨwaraye'unie mɨwarehapa xeikɨa,  
\q2 mana nepɨtita'aita 'ixiparakɨ memɨkwi'iwakɨ.  
\q1 'Axanewayurienike meta 'aixɨa nemɨkawayuriekakɨ,  
\q2 nepɨwaxeiyani».   
\b  
\q1
\v 5 Yawé naimekɨmɨyɨwe, Naimekɨmɨtɨrɨkaɨye,  
\q2 kwie kanikumaɨwani, mɨkɨ kaneukupenikeni.  
\q1 Kanitiyeikani meta kanikayeikani kwie  
\q2 Niru hayari hepaɨ, 'Ekipitu muyeka,  
\q2 meta mana memɨteye'uwa meyuhiwerietɨ mekanakɨkani.   
\q1
\v 6 Kakaɨyari yuparatsiyu kaniutawewieni muyuawitsie  
\q2 meta kwiepa tsutɨmeyari kaniutsutɨani,  
\q1 haa haramaratsie mieme kaniutahɨaweni  
\q2 hikɨ kanitayeuriwani kwiepa:  
\q2 Yawé katinitewaka.   
\b  
\q1
\v 7 «Yawé mɨpaɨ kanaineni:  
\q1 'Ixaheritsixi, ¿tamɨ xeme  
\q2 nehetsiemieme 'etiupetsixi wahepaɨ xekate'ane?  
\q1 ¿Tamɨ 'ixaheritsixi 'Ekipitu nekatiwarayewitɨ,  
\q2 Kɨretatsie piritsiteutsixi wakwiepa,  
\q2 meta Kixi tsiriyutsixi wakwiepa nekatiwarayewitɨ?   
\q1
\v 8 'Ayumieme Yawé naimekɨmɨyɨwe  
\q2 'ena kwiepa 'axakemɨtiyɨane kanitaniereni.  
\q1 Nekaniwarakumaweriyamɨkɨ kwiepa Kakuwu nuiwarimama,  
\q2 tsepa yunaime nekawaruyuri,»  
\qr Yawé mɨpaɨ kanaineni.   
\q1
\v 9 Nekatinita'aitamɨkɨ 'ixaheritsixi memɨtikatsienikɨ  
\q2 yunaime nuiwarite watsata,  
\q1 xiekari manuyekatsieni hepaɨ tikatsemetsie,  
\q2 xewitɨ tete kapitɨarietɨ kwiepa mɨkaweni.   
\q1
\v 10 'Ixiparakɨ mekanikwi'iwakuni  
\q2 yunaitɨ 'axamemɨteyurie neteɨterima,  
\q1 yunaitɨ mɨpaɨ memutiyuane:  
\q2 “Tame mɨkɨ 'uximatɨarika tahetsie pɨkanuani  
\q2 hatsuaku tɨma tahetsie pɨkaye'ani”.   
\s1 'Ixaheri kemɨtihekwatɨarieni  
\q1
\v 11 »Mɨkɨ tukaritsie nekanenukuketɨamɨkɨ  
\q2 Rawiri kiiya matiwe.  
\q1 Kemɨtiukatsitsini 'aixɨa nekaniyurimɨkɨ,  
\q2 mɨti'u'uni 'aixɨa nekatinitiyurimɨkɨ  
\q2 'aixɨa nekatinitiyurimɨkɨ meripaitɨ kemɨti'anenekai,   
\q1
\v 12 mɨkɨ wapiini katinayeimɨkɨ 'Erumi mɨtiyuhayewa  
\q2 meta hipame nuiwarite memɨnetsimate,»  
\qr Yawé mɨpaɨ kanaineni, mɨpaɨ katiniyurimɨkɨ.   
\p
\v 13 »Yawé mɨpaɨ kanaineni: Tukari kanamieni,  
\q1 kemɨ'ane mukwietsanane mɨ'itsanane kananuku'aximɨkɨ  
\q2 meta kaxie mɨketsinane, mɨ'ene panuku'axe.  
\q1 Naitɨ hɨritetsie winu makaka paneikatɨkani,  
\q2 naitsarie mayeweweritsie puhapaneni.   
\q1
\v 14 'Aixɨa nekaniwayurimɨkɨ neteɨterima 'ixaheritsixi, tawarita nekaniwa'atɨamɨkɨ  
\q2 mɨkɨ kiekarite mu'u'uni 'aixɨa mekanitiyuriekuni  
\q2 mana mekanikutekuni.  
\q1 Kaxie mekanika'ekuni meta winuyari mekani'iekakuni,  
\q2 yuharaweri mepexeiyani meta mana mɨtiukaxuxuawereni mepɨtekwaka.   
\q1
\v 15 'Ixaheri yukwietsie nepɨka'iteɨta,  
\q2 para hatsuakuri mɨkahahunarienikɨ yukwieyaritsie nemiyetuiritsie»,  
\b  
\qr Yawé 'akakaɨyari mɨpaɨ kanaineni.   