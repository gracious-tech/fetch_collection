\id SNG  
\h Kwikari 
\toc1 Kwikari witsimɨ'ane 
\toc2 Kwikari 
\toc3 Kwi 
\mt1 Kwikari witsimɨ'ane  
\c 1  
\p
\v 1 Tsarumuni kwikarieya xapayari.   
\sp 'Uka mɨnaki'eriwa  
\q1
\v 2 Xɨka, penetsi'u'itsenike 'ateni kemɨtiyu'itsewekɨ,  
\q2 matsi 'aixɨa pɨ'ane 'anaki'eriya, keyuri winu.   
\q1
\v 3 Witsimu'ɨata pemɨ'akawiriwa, yemekɨ puwanake,  
\q2 'ekɨtɨtɨ pekanihɨkɨtɨni waritsamu witsimu'ɨa.  
\q2 Kauka 'ayumieme 'ɨimarixi memenenaki'erie.   
\q1
\v 4 Kene'amexɨitɨaka, 'ahetsiemieme yemekɨ kenenayeitɨa.  
\q2 Kenenanuwitɨki pemuyehuputsie, ti'aitame.  
\sp Wahamikuma  
\q1 Tepuyutemamawieka ta'iyarikɨ teyunaitɨ,  
\q2 tepiku'eriwani kepemɨti'amaɨwa keyuri winu.  
\q2 Titakɨ mɨmatinaki'erieka panayuhayewa.   
\sp 'Uka mɨnaki'eriwa  
\q1
\v 5 'Uka mɨyɨwi nepɨhɨkɨ, peru witsinepɨti'iɨmari,  
\q2 'ukari 'aku Kerutsaremetari,  
\q1 nekaniyɨwini Tseraxi teɨteriyari waxamaru hepaɨ,  
\q2 witsinekatini'ɨimarika Tsarumuni 'ixuriki kiiyarieya hepaɨ.   
\q1
\v 6 Newaiyaritsie xepɨkanetsixeiyani nemɨyɨwikɨ,  
\q2 tau nenawiyari mɨyakaniuyurieni.  
\q1 Ne'iwama 'ukitsi mekaneniuyeheka,  
\q2 kaxie haraweriyari 'ɨwiyariyarikɨ mekaneniuta'aitɨani waɨriyarika,  
\q2 meta nekaxie 'aixɨa nepɨkatiɨ'ɨwiyaxɨ.   
\q1
\v 7 Kenetineutaxatɨa, 'uki nemɨmatsinaki'erie,  
\q2 ¿hakewa 'amuxatsima pepɨwaretihɨwe?  
\q2 ¿hakewa tuka pepɨwareti'uxipitɨwa?  
\q1 ¿Ne titayari netikuyeika xeikɨa,  
\q2 'ahamikuma wamuxatsima wahamatɨa?   
\sp Wahamikuma  
\q1
\v 8 Xɨka 'atsipekatimaika, 'uka witsipemɨti'ɨimari 'ukari watsata pe'uyeikatɨ,  
\q2 muxatsi waketate kemɨreuyuyune kenanukuweiya  
\q1 meta 'atsipuri tɨɨrixi keniwahɨneni,  
\q2 muxatsi wahɨwemete wakii maku'utsie.   
\sp 'Uki mɨnaki'eriwa  
\q1
\v 9 'Ekɨ meta kepemɨreuyukuniɨtɨa, 'uka nemɨmatsi naki'erie,  
\q2 Kawayutsixi nepɨwaraye'eriwa witsimemɨtehekɨniɨtɨarietɨka yumu'uyaritsie  
\q2 Parahuni kaxetaya memuhaxime.   
\q1
\v 10 Witsipɨtiyuxexeiya 'a'aurite meta kepemɨti'akutsa'a.  
\q2 'Akɨipi witsipɨtiutimerɨka 'akukakɨ.   
\q1
\v 11 'Anakɨtsa tepɨtiwewieni hurukɨ  
\q2 meta pɨratakɨ.   
\sp 'Uka mɨnaki'eriwa  
\q1
\v 12 Ti'aitame mexi mexatsie 'utika,  
\q2 witsimu'ɨa nemɨnetawiri kaniɨkɨ'ɨareni hetsiena.   
\q1
\v 13 'Uki neminaki'erie, mixaxi witsimu'ɨa purutsata mɨyeka hepaɨ kani'aneni,  
\q2 netawitsie kaneukukutsuni neheikukwekaku.   
\q1
\v 14 'Uki neminaki'erie, 'aukwe tuturiyari witsimu'ɨa hepaɨ kani'aneni  
\q2 'Enikaritsie kaxie 'iteɨriyari hepaɨ.   
\sp 'Uki mɨnaki'eriwa  
\q1
\v 15 Kwinimieme pepɨti'ɨimari, 'uka nemɨmatsinaki'erie.  
\q2 Witsipepɨ'ane.  
\q2 'Ahɨxite, kukuruxi memɨyuhuta wahepaɨ pɨtiyuxexeiya.   
\sp 'Uka mɨnaki'eriwa  
\q1
\v 16 Kwinimieme pepɨtitemaikɨ, 'uki nemɨmatsinaki'erie.  
\q2 Yemekɨ 'ekɨ pepɨnetsinake.  
\sp 'Uki mɨnaki'eriwa  
\q1 'Ɨxa mɨtsitsiɨrawi ta'itari kanayeimɨkɨ kepauka temɨyutiwitɨnitsie,   
\q2
\v 17 takii pikaxiyari kariuxa kanihɨkɨtɨni  
\q2 Huku mɨxexeurawi xawarikɨ kananukakitsieka.   
\c 2  
\sp 'Uka mɨnaki'eriwa  
\q1
\v 1 Ne tuutu Tsarunitsie mayeweri mɨxuawe nekanihɨkɨtɨni,  
\q2 xewitɨ tuturi texuxuri mayeweritsie mieme.   
\sp 'Uki mɨnaki'eriwa  
\q1
\v 2 'Uka neminaki'erie, kepauka hipame 'ukarawetsixi watsata muyeika,  
\q2 tuturi texuxuri xuyatsata muwe hepaɨ katiniyuxexeiyani.   
\sp 'Uka mɨnaki'eriwa  
\q1
\v 3 'Uki neminaki'erie kepauka hipame 'ukitsi watsata muyeika,  
\q2 xikɨti\f + \fr 2:3 \ft Manzana.\f* 'ɨtsitsata mɨkawe hepaɨ katiniyuxexeiyani.  
\q1 Kaneninakeni hetɨana nemɨ'etɨpieka,  
\q2 witsikatinakakani takariyari.   
\q1
\v 4 Kanenewitɨni kiita 'ixɨarari muwatiwewiwatsie,  
\q2 muwa yunaki'eriya 'inɨariyari kaniwarepitɨani.   
\q1
\v 5 Kaxie takari patsaruyarikɨ keneneutatɨrɨkariya,  
\q2 manitsanakɨ keneneutahuxaitɨa,  
\q2 nekanimɨximeni naki'eriyakɨ.   
\q1
\v 6 Mamaya 'utatana miemetsie nemu'u  
\q2 mɨniuka'uxipitɨanike,  
\q2 meta yutserieta miemekɨ kwimɨneniukwenike.   
\sp 'Uki mɨnaki'eriwa  
\q1
\v 7 Ne mɨpaɨ nepɨtixewawirie, 'ukarawetsixi Kerutsareme kiekatari,  
\q2 maxatsi 'ɨimarixi yeuta memu'uwakɨ,  
\q1 'uka neminaki'erie xepɨkahehɨtɨaka xepɨkahei'uximatɨaka  
\q2 tsepa kepaukake yukɨmana manutanierixɨ.   
\ms1 Hutariekamieme Kwikari  
\sp 'Uka mɨnaki'eriwa  
\q1
\v 8 'Uki neminaki'erie hiwarieya.  
\q2 Neuxei, 'ena kanamieni,  
\q1 'utsunarɨmetɨ hɨritetsie,  
\q2 'anutitsukwakatɨ hɨri 'amɨnenetsie.   
\q1
\v 9 'Uki neminaki'erie maxa hepaɨ katiniyuxexeiyani,  
\q2 maxa temaikɨ hepaɨ kani'aneni.  
\q1 Paratsɨ xekeneuxeiya, takiiwarie warita kaniutiweni,  
\q2 'awienierenetɨ maxawariyarietɨkata,  
\q2 yɨkɨ'ɨwiyatɨ mayexaxawata.   
\b  
\q1
\v 10 'Uki neminaki'erie mɨpaɨ kanetiniutahɨawe:  
\q1 «Kenanukukexi 'uka nemɨmatsinaki'erie,  
\q2 hikɨmɨ kenewaye'a, 'uka witsipemɨti'ɨimari.   
\q1
\v 11 Neuxei, kananuyeyaniri xexerixa,  
\q2 hamatɨanata kaniutanɨni wiyeri.   
\q1
\v 12 Yeuta 'ari tuturi kanitineikani,  
\q2 kwikari tukariyari kanaye'aniri.  
\q1 'Ariri naitsarie kwiepa kani'eniɨriɨkɨni  
\q2 kukuruxi memeɨyɨyɨxawi wakwikari.   
\q1
\v 13 'Ariri piní matɨari mieme takariyari kanixuaweni,  
\q2 'Ari kaxie xututɨ witsikaniukɨ'ɨareni.  
\q1 Kenanukukexi, 'uka nemɨmatsinaki'erie,  
\q2 nehetsɨa kenaye'a, 'uka witsipemɨti'ɨimari».   
\sp 'Uki mɨnaki'eriwa  
\q1
\v 14 Nekukuru pemeutuxa, 'ai mukatataritsie  
\q2 pemuyu'awieta,  
\q2 meta hɨri 'amɨtiumariwetsie paitɨ,  
\q1 kenanieri nepɨmatsixeiya,  
\q2 keneutaniu nepumatsi'enieni,  
\q1 'aniuki 'aixɨa kanimayaka  
\q2 meta witsipekatini'axexeiyani.   
\sp 'Uki meta 'uka memuyunaki'erie  
\q1
\v 15 Kauxaitsi xekeniwarutiwiya,  
\q2 mɨkɨ kauxaitsi tɨɨrixi  
\q1 takaxie memɨtsewixima,  
\q2 takaxie haraweriyari xuturiyari.   
\sp 'Uka mɨnaki'eriwa  
\q1
\v 16 'Uki neminaki'erie nehetsiemieme kanihɨkɨtɨni, neta hetsiena mieme,  
\q2 mɨkɨ yumuxatsima kaniwarutihɨweni tuturi texuxuritsata.   
\q1
\v 17 Tau ka'akayuniwekaku 'akuxi  
\q2 meta 'etɨri ka'akumaweriwekaku 'akuxi,  
\q2 nehetsɨa kani'axeni, 'uki neminaki'erie.  
\q1 Maxa hepaɨ katiniunanautsani,  
\q2 maxa temaikɨ hepaɨ, hɨritsie paitɨ.   
\b  
\c 3  
\q1
\v 1 Tɨkarikɨ, ne'itaritsie ne'ukaitɨ  
\q2 'uki neminaki'erie nekaniutiwauni,  
\q2 matsi nepɨka'itaxei.   
\q1
\v 2 Ne 'anukukeme nekaneyeikani kiekaritsie,  
\q2 huye mayehapanetsie meta waɨkawa mɨrewatuiyatsie,  
\q1 'uki neminaki'erie nekuwaunetɨ.  
\q2 Ne'iwaunetɨ nepɨka'itaxeiyawe.   
\b  
\q1
\v 3 Mekaneniukaxexeyani  
\q2 kiekaritsie tehɨwemete.  
\q1 Mɨpaɨ netiwara'iwawiya:  
\q2 «¿'Uki neminaki'erie hawaikɨ xekatehexeiya?»   
\q1
\v 4 Mɨya netiwaru'iwawiyakake nekanikaxeiya  
\q2 'uki neminaki'erie.  
\q1 Nekanitapa, neka'itatuayatɨ,  
\q2 nemaama kie nekaneiwitɨkɨni,  
\q2 kiita paitɨ hakewa nemaama mɨnetsiwatiniwexɨtsie.   
\sp 'Uki mɨnaki'eriwa  
\q1
\v 5 Ne mɨpaɨ nepɨtixewawirie, 'ukarawetsixi Kerutsareme kiekatari,  
\q2 maxatsi 'ɨimarixi yeuta memu'uwakɨ,  
\q1 'uka neminaki'erie xepɨkahehɨtɨaka xepɨkahei'uximatɨaka  
\q2 tsepa kepaukake manutanierixɨ.   
\ms1 Hairiekamieme Kwikari  
\sp Yunaitɨ mɨkwikarɨwa  
\q1
\v 6 ¿Titatihɨkɨ makumawetsie mɨretineika  
\q2 kɨtsi 'amuweni hepaɨ tiyuxexeiyatɨ,  
\q1 mixaxi meta 'ɨkwa witsimu'ɨa tsata,  
\q2 meta waɨkawa witsimu'ɨatɨka nɨtɨ?   
\q1
\v 7 Neuxei,  
\q2 Tsarumuni kaxetaya kaniyɨaneni.  
\q1 Haika tewiyari kuyaxi me'eweiyatɨ mana pamie,  
\q2 'ixaheritsixi kuyaxiyaritsie memanayexeiyarie kwinimieme yeme memɨteheuyutakwiwawe.   
\q1
\v 8 Yunaitɨ 'ixipara mekanakawɨtɨatɨkani,  
\q2 meta mekateniuti'ɨkitɨarieni memeuyutakwiwawenikɨ,  
\q1 yunaitɨ yu'ixipara yuhɨiyametsie mekanikawɨtɨatɨkani  
\q2 tɨkarikɨ mɨkweriwa'anekɨ.   
\q1
\v 9 Tsarumuni yukaxeta kaniutawewieni  
\q2 kɨye 'aixɨa mɨ'anenekɨ Riwanu mieme.   
\q1
\v 10 Matiwetɨka Pɨratakɨ kaniutiwewieni,  
\q2 hurukɨta mitseiriyatɨka.  
\q1 'Ɨpariyarita kaniutawipa taɨraɨyemekɨ,  
\q2 taɨtana mekaniwaku'utɨani me'inaki'erietɨ  
\q2 'ukari Kerutsareme kiekatari.   
\b  
\q1
\v 11 Xekeniwayekɨni 'ukarawetsixi Tsiyunitari.  
\q2 Ti'aitame Tsarumuni xekenexeiyani.  
\q1 Yumu'utsie kanenamaka Kuruna maamaya menamaniri  
\q2 kepauka mutineɨkixɨtsie mieme  
\q2 kepauka 'iyarieya muyutemawiekai.   
\c 4  
\sp 'Uki mɨnaki'eriwa  
\q1
\v 1 Kwinie yemekɨ pepɨti'ɨimari 'uka nemɨmatsinaki'erie.  
\q2 Witsipepɨti'axexeiya.  
\q1 'Ahuxite 'ixuriki pemeukuwera warita, kukuruxi memeutuxa mepɨhɨkɨ.  
\q1 'Akɨpate tsipuri xeitewayari memeuyɨyɨwi wahepaɨ pɨtiyuxexeiya  
\q2 Karaha hɨriyaritsie memu'uwa.   
\q1
\v 2 'Atamete muxatsi hekwamekɨ memutixikieni hepaɨ pɨtiyuxexeiya,  
\q2 xike memanatikɨ me'uka'ɨyarieka.  
\q1 Yuxexuitɨ mɨkɨ yu'iwama mepuwarexeiya,  
\q2 xewitɨ pɨkayuxaɨta.   
\q1
\v 3 'Ateni hɨiyame mɨxeta hepaɨ pɨtiyuxexeiya,  
\q2 'aniuki pɨnetsihehana.  
\q1 'A'aurite 'ixuriki pemeukuwera warita,  
\q2 xikɨti hixɨata mɨxitekieka hepaɨ pɨtiyuxexeiya.   
\q1
\v 4 'Akɨipi Rawiri tuxiyuya hepaɨ pɨtiyuxexeiya,  
\q2 tetexi mɨxitekietɨkakɨ mɨwewiya,  
\q1 hetsiena pukuwɨ xeimiriyari kɨmana memɨyukunarɨma,  
\q2 kuyaxi memɨyukunarɨma mɨkɨ naitɨ pɨhɨkɨ.   
\q1
\v 5 'Atsitsi yuhutatɨ maxatsi yeutari wahepaɨ mepɨteyuxexeiya,  
\q2 'ɨimari niwemama yuhutame muwarayexei  
\q2 memɨtekwatɨwe tuturi texuxuritsata.   
\q1
\v 6 'Akuxi kakɨyɨriwekaku,  
\q2 'akuxi 'etɨri katipariwekaku,  
\q1 nekananutiyeimɨkɨ mixaxi yemuriyaritsie,  
\q2 meta 'ɨkwa witsimu'ɨa hɨriyaritsie.   
\b  
\q1
\v 7 Naitɨ 'ekɨ witsipepɨ'ane, 'uka nemɨmatsinaki'erie,  
\q2 naitɨ 'aixɨa pepɨ'ane.   
\q1
\v 8 Hikɨmɨ tepanukakɨne Riwanu hɨriyaritsie, 'uka nemɨmatsihɨawene,  
\q2 Hikɨmɨ tepanukakɨne Riwanutsie.  
\q1 Kenanakaye'a 'Amaná hɨriyari 'amanutitewitsie,  
\q2 Tsenixi meta Heximuni yekɨrita.  
\q1 Kenanakaye'a hakewa mayetsi meme'uwatsie,  
\q2 mɨkɨ hɨritsie hakewa tɨwexi memayu'eririya wakietsie.   
\b  
\q1
\v 9 Ne'iyari pepɨhɨa,  
\q2 ne'iwa 'uka nemetsihahɨawe,  
\q2 xeihɨxiyarikɨtɨtɨ penetsi'uxeiyaku,  
\q1 'akuka xeiwiwierikɨ  
\q2 ne'iyari pepɨhɨa.   
\q1
\v 10 Kwinie yemekɨ witsipa'ane 'anaki'eriya,  
\q2 ne'iwa 'uka nemetsihɨawene.  
\q1 Matsi witsipa'ane 'anaki'eriya, winu kemɨkaha'ane,  
\q2 meta pemuyutawiriwa witsimu'ɨa  
\q2 tixaɨtɨ kemɨkatiɨ'ɨa hepaɨ pepɨ'ɨa.   
\q1
\v 11 'Uka nemetsihahɨawe, 'atenitsie xiete payeneika,  
\q2 retsi meta xiete 'anenitɨa pepɨ'awieta.  
\q1 Riwanu kemu'ɨa  
\q2 mɨpaɨta pɨ'ɨatɨka 'akamixate.   
\b  
\q1
\v 12 Haraweri tuturi muwa'etsie mɨreuname pekanihɨkɨtɨni,  
\q2 ne'iwa 'uka nemetsihahɨawe,  
\q2 haraweri tuturi muwa'etsie mɨreuname meta haixa manukaname pekanihɨkɨtɨni.   
\q1
\v 13 'Atsitsi xeiharaweriyari pɨhɨkɨtɨka xikɨti muwa'etsie,  
\q2 witsi'anenetɨ 'ikwaxi,  
\q2 tuturiyari naaru meta hatsahaxi,   
\q1
\v 14 naitɨ kɨyexi muwatsuayatɨka witsimu'ɨatɨka,  
\q2 naaru meta 'atsapɨrani,  
\q2 karamu meta kanera,  
\q2 mixaxi meta 'aruhe,  
\q2 witsimɨti'anene xeikɨa naitɨ.   
\q1
\v 15 'Ekɨ haa pekanihɨkɨtɨni harawerita mieme,  
\q2 haixa haa mayenierenikɨ mɨ'ayumieme mexeiya pekanihɨkɨtɨni,  
\q2 haa 'akiyari pekanihɨkɨtɨni Riwanu makanena.   
\sp 'Uka mɨnaki'eriwa  
\q1
\v 16 Kenanutanieri, 'eka tayeta mieme.  
\q2 'Eka tatsutɨa mieme, niwa kenaye'a.  
\q1 Neharawerita xekeneuka'ekawi,  
\q2 witsikemɨtiuye'ɨa xekeneutawiwiexɨa.  
\q1 Yuharawerita 'uki neminaki'erie kehamieni  
\q2 muwa mieme 'ikwaxi witsima'ane keha'inɨata.   
\c 5  
\sp 'Uki mɨnaki'eriwa  
\q1
\v 1 Neharaweritari nekaninuani,  
\q2 'uka ne'iwa nemɨmatsi naki'erie,  
\q1 muwa nepikaxei mixaxi waritsamu meta,  
\q2 muwa xiete kwaiyarikɨ ne'iyari paye'axe.  
\q1 Muwa nepikaxexeiya waɨkawa winu meta retsi,  
\q2 naitɨ 'ikɨ pɨtinehetsiemieme.  
\sp Wahamikuma  
\q1 Hamikutsixi, xeketenekwaka xeketene'ieka,  
\q2 xekeneutitarɨwai naki'eriyakɨ.   
\ms1 Nauriekamieme Kwikari  
\sp 'Uka mɨnaki'eriwa  
\q1
\v 2 Ne nepukutsukai, matsi ne'iyari payenierekai.  
\q2 Hikɨ xeime niuki nekaniu'enieni.  
\q2 'Uki neminaki'erie kitenie kanatawekaitɨni.  
\b  
\q1 «Ne'iwa 'uka nemɨmatsi naki'erie,  
\q2 witsipemɨti'ɨimari nekukuru,  
\q2 keneneupitɨa nemeutahanikɨ.  
\q1 Nemu'utsie haɨtsikɨ nepumu'uhawi,  
\q2 tɨkarikɨ mieme hawiriya nekɨpatetsie panakaxɨrɨwe».   
\b  
\q1
\v 3 Nematsi nekaniyutikemaripieni,  
\q2 nekapɨyɨwe tawari nemɨranakatɨni.  
\q1 Nematsi ne'ɨkatetsie nekaneuyuhauxixɨaniri,  
\q2 titayari tawari nereuyukwiemawani.   
\b  
\q1
\v 4 'Uki neminaki'erie mɨreukukekatsie hewakuxawakaku,  
\q2 muwa kaneukumeni,  
\q2 netaɨta nemeiyehɨakaikɨ waɨkawa nepɨnekatemawi.   
\q1
\v 5 Ne'anukukeka 'uki nemɨnaki'eirie nekatineuyepirieni,  
\q2 mixaxi nemamatetsie kanikakukekaitɨni.  
\q1 Ne'itɨwametetsie paitɨ kananuyetsukekaitɨni  
\q2 mɨreuyepieriketsie paitɨ kanikaxɨrɨwekaitɨni.   
\b  
\q1
\v 6 Kepauka nemɨreiyepiriri 'uki neminaki'erie,  
\q2 'ari kaniukumawekaitɨniri.  
\q1 Neyakaitɨniri,  
\q2 hikɨ 'utɨmana nekaneyani.  
\q1 Nekanitiwauni peru nepɨka'itaxei.  
\q2 Kepauka nemitahiwi pɨkanetsiheta'ei.   
\q1
\v 7 Mekaneniutaxeiya tehɨwemete  
\q2 kiekaritsie meye'uwatɨ,  
\q1 kiekari kuraruyari memɨ'ɨwiya  
\q2 mekaneteniukwinitɨani mekaneneutiwaxɨani,  
\q2 nexikuri mekananutihurieni.   
\b  
\q1
\v 8 Ne mɨpaɨ nepɨtixewawirie 'ukari Kerutsareme kiekatari,  
\q2 xɨka 'uki neminaki'erie hawaikɨ xehekaxeiya,  
\q2 mɨpaɨ xeketenetahɨawi kename netikuye ne'inaki'erietɨ.   
\sp Yunaitɨ kwikarɨwame  
\q1
\v 9 'Uka kwinie yemekɨ witsipemɨti'ɨimari, ketatineutaxatɨa,  
\q2 ¿kehepaɨ timatsiɨkɨ 'uki peminaki'erie hipame 'ukitsi watsata?  
\q1 ¿Kehepaɨ timatsiɨkɨ 'uki peminaki'erie hipame 'ukitsi watsata,  
\q2 mɨkɨ pemɨtatsiwawirie?   
\sp 'Uka mɨnaki'eriwa  
\q1
\v 10 'Uki neminaki'erie kwinie yemekɨ pɨtitemaikɨ, xetamekɨ 'utimerɨkatɨ,  
\q2 tsepa tamamata miriyari wahamatɨa muyeika kanimatsiɨkɨni.   
\q1
\v 11 Mu'uya kanihurutɨni xeikɨa,  
\q2 kɨpateya 'etsiwa kanitutunini  
\q2 yɨyɨwitɨ kwatsa kemeu'ane hepaɨ.   
\q1
\v 12 Hɨxiteya kukuruxi wahepaɨ kani'aneneni  
\q2 'aki'utɨa memɨyetei  
\q1 retsikɨ me'ɨwatɨkaitɨ,  
\q2 tetexi witsimɨ'anene hepaɨ metehekutetɨ.   
\q1
\v 13 'Auriteya waritsamu 'etsiyari hepaɨ pɨ'anene,  
\q2 tupiriya witsimu'ɨatɨka 'etsiyari.  
\q1 Teniteya tuturite 'atsutsena kanihɨkɨtɨni  
\q2 muwa matineika mixaxi.   
\q1
\v 14 Mamateya huru tepɨayari kanihɨkɨtɨni  
\q2 tupatsiyukɨ ti'utɨkaitɨ.  
\q1 Hukaya putimerɨka witsimɨtiharuani hepaɨ  
\q2 ti'utɨ yuyuawimekɨ.   
\q1
\v 15 Teuriteya huta 'ikitsaraɨyari pɨhɨkɨ 'anuyexawawatɨtɨ  
\q2 huru mɨhɨkɨakɨ yuwetɨkaitɨ.  
\q1 Hɨxiena xɨka 'uyeikani pumariwekare,  
\q2 Riwanu muyeikani hepaɨ kariuxa tsata.   
\q1
\v 16 Tenieya kanakakani,  
\q2 mɨkɨ witsikani'aneni 'uki.  
\b  
\q1 Mɨpaɨ kani'aneni 'uki neminaki'erie, nehamiku,  
\q2 'ukarawetsixi Kerutsareme kiekatari.   
\c 6  
\sp Yunaitɨ kwikarɨwame  
\q1
\v 1 ¿Kekuta reuyunixɨ 'uki peminaki'erie,  
\q2 'uka yemekɨ witsipemɨti'ɨimari?  
\q1 ¿Hakewa kuta petɨa?  
\q2 'Ahamatɨa te'uhutɨ tepiwauyu.   
\sp 'Uka mɨnaki'eriwa  
\q1
\v 2 'Uki neminaki'erie kaneyani yuharawerita,  
\q2 waritsamu muye'etsietsie,  
\q1 muwa mɨtiwaikakɨ,  
\q2 tuturi 'atsutsena tipinike.   
\q1
\v 3 Ne 'uki neminaki'erie hetsiemieme nekanihɨkɨtɨni,  
\q2 'uki neminaki'erie nehetsieta kanimiemetɨni,  
\q1 Mɨkɨ yumuxatsima tuturi 'atsutsena tsata kaniwarutihɨweni.   
\ms1 'Auxɨwirieka Kwikari  
\sp 'Uki mɨnaki'eriwa  
\q1
\v 4 'Ekɨ 'uka nemɨmatsinaki'erie, witsipepɨti'ɨimari kiekari Tiritsa hepaɨ,  
\q2 witsipe'anetɨ kiekari Kerutsareme hepaɨ,  
\q2 pemɨmariwe xurawetsixi wahepaɨ.   
\q1
\v 5 Kwi pepɨkanetsixeiyaniri,  
\q2 nepeɨxɨyarie 'ahɨxite netsixeiyakaku.  
\q1 'Akɨpate tsipuri xeitewayari wahepaɨ pɨtiyuxexeiya  
\q2 memuyuhayatɨwe Karaha hɨriyaritsie.   
\q1
\v 6 'Atamete tsipuri 'ukari tɨɨrixi wahepaɨ pɨ'anene  
\q2 hekwamekɨ memuti'ɨwaxɨ.  
\q1 Yuxexuitɨ mɨkɨ mepuyuhuhuta,  
\q2 xewitɨ yuxaɨta pɨka'uyeika.   
\q1
\v 7 'A'aurite pemeuyukunama warita  
\q2 manitsana hepaɨ pɨtiyuxexeiya.   
\q1
\v 8 Tsepa haika tewiyari 'ukari te'aitamete wa'ɨitama memakɨne,  
\q2 tsepa nauka tewiyari 'ukari memɨhɨkɨ ti'aitame hutarieka 'ɨitamama  
\q2 tsepa mekate'inɨaritɨ 'ukari 'ɨimarixi,   
\q1
\v 9 peru xewitɨ hɨkɨa xeikɨa kanihɨkutɨni nekukuru 'etsimupe witsimɨti'ɨimari,  
\q2 'uka kwinie maamaya mɨtinaki'erie,  
\q2 'aixɨa mɨtixeiya mitiniwexɨ.  
\q1 Hipatɨ 'ukari kepauka memixeiya 'aixɨa mepɨtehehɨawe,  
\q2 'ukari te'aitamete wa'ɨitama witsimemɨ'anene meta  
\q2 hipatɨ 'ukarawetsixi ti'aitame hutarieka 'ɨitamama mekaninɨawani.   
\sp Yunaitɨ kwikarɨwame  
\q1
\v 10 ¿Kemɨ'ane 'ikɨ pɨyɨane witsi'anetɨ tau 'ɨrɨya hepaɨ?  
\q2 Witsikani'aneni metsa hepaɨ,  
\q2 xawatɨtɨ tau hepaɨ,  
\q2 mariwetɨ xurawetsixi muyuawitsie memeukatei wahepaɨ.   
\sp 'Uki mɨnaki'eriwa  
\q1
\v 11 Nekaneyani kariu haraweriyari muyema  
\q2 nemɨtixeiyakɨ hekwamekɨ mayeweritsie mɨtiyɨyɨra,  
\q1 ne'ixeiyamɨtɨ kaxie mɨyɨyɨra,  
\q2 meta manitsana kɨyeyariteyari muxutu.   
\q1
\v 12 'Atsinekareyutimaiwekaku, netemawierikakɨ kauka kaxetatsie nenekaya,  
\q2 takiekaritsie ti'aitame kaxetayatsie.   
\sp Wahamikuma  
\q1
\v 13 Keneukunua, 'uka Tsurami kiekame keneukunua,  
\q2 keneukunua tahamatɨa keneuyeikani,  
\q2 tepɨmatsiheuxeiyaku.  
\sp 'Uki mɨnaki'eriwa  
\q1 ¿Titayarikuta 'uka Tsunami kiekame xeteheuxeiyaku,  
\q2 neiya hutakɨa yu'utɨma mehewetɨkaikaku miemetsie hepaɨ?   
\b  
\c 7  
\q1
\v 1 'Uka ti'aitame pemunu'aya witsipemɨti'ɨimari,  
\q2 witsipɨtiyuxexeiya 'a'ɨkate kakaitsie heutawetɨkaitɨ.  
\q1 Witsipemanupe, nakɨtsa hepaɨ pɨ'ane  
\q2 'aixɨa reutamaiwetɨ mitiwewiwa hepaɨ.   
\q1
\v 2 'Axɨtemutsi tekɨxi hepaɨ pɨ'ane  
\q2 winu witsi'anetɨ mɨhɨne hepaɨ pɨ'ane.  
\q1 'Ahuka tɨriku hɨriyari hepaɨ pɨ'ane  
\q2 waritana tuturi 'atsutsena mahane.   
\q1
\v 3 'Atsitsi maxatsi tɨɨrixi yuhutatɨ wahepaɨ mepɨteyuxexeiya,  
\q2 maxa 'ɨimari yuhutame yuniwema muwarayexeiya hepaɨ.   
\q1
\v 4 'Akɨipi tuxiyu mutuxa mɨtse'i kanihɨkɨtɨni,  
\q1 'Ahɨxite huta haixayari pɨhɨkɨ Hetsiwuni mieme,  
\q2 Wati-Xawini kitenie 'aurie mɨtineniere.  
\q1 'Atsuri Riwanu tuxiyuyari hepaɨ pɨ'ane,  
\q2 Ramatsiku meutaniere.   
\q1
\v 5 'Amu'u waɨkawa pahekɨa Kaximeru hɨriyari kɨtsie mieme hepaɨ.  
\q2 Hiru mɨyɨtsikimawi hepaɨ pɨ'anene 'akɨpate,  
\q2 'etsiwa tsiturawime pehewawɨtɨatɨ ti'aitame kwi pɨmatsixeiya 'aumɨ.   
\b  
\q1
\v 6 Yemekɨ kwinie pepɨti'ɨimari, 'uka nemɨmatsinaki'erie,  
\q2 'ukaratsi witsipemɨtiuka'iyari pepɨhɨkɨ.   
\q1
\v 7 Kwinie peputewi takɨ 'amɨtɨtɨ hepaɨ,  
\q2 meta 'atsitsi huta takariyarieya pɨhɨkɨ.   
\q1
\v 8 Ne mɨpaɨ nepɨtiuyɨhɨawixɨ: «Nekananutimakimɨkɨ takɨ 'amutewitsie,  
\q2 takariyari nepiini netinayeitɨamɨkɨ».  
\q1 'Atsitsi kaxie takari hepaɨ ke'aneneni,  
\q2 manitsana hepaɨ peke'ɨ'ɨaka,   
\q2
\v 9 winu witsima'ane hepaɨ keha'aneni 'ateni.  
\sp 'Uka mɨnaki'eriwa  
\q1 Winu witsima'ane 'uki neminaki'erie hetsɨa keye'ani,  
\q2 tenieyatsie ke'utayani meta tameteyatsie.   
\b  
\q1
\v 10 Ne 'uki neminaki'erie hetsiemieme nepɨhɨkɨ,  
\q2 kanenikuwauneni waɨkawa netsihaunaki'erietɨ.   
\q1
\v 11 Niwa kenaye'a, 'uki nemɨmatsinaki'erie,  
\q2 yeuta tekaniyehuni,  
\q2 muwa yɨwikɨta tepeka'iyunieni tuturite yeutamieme tsata.   
\q1
\v 12 Ximeri paitɨ tepeuhu kaxie haraweriyari tsata,  
\q2 tepeunieriyu kaxie kareyɨyɨrari,  
\q1 Xɨkari tuturiyari hetixutuweni,  
\q2 xɨka 'ikwaxi mayehatsiyatɨka hexutukari.  
\q2 Mana nekameneyetuiriemɨkɨ nenaki'eriya.   
\b  
\q1
\v 13 Manirakura witsimu'ɨa kanitawiwiwani,  
\q2 meta naitɨ takitenie katinapika  
\q2 'ikwaxi witsimɨ'anene hikɨketimieme  
\q1 meta 'aikɨ paitɨ timieme,  
\q2 nekametini'utsirieka 'ahetsietimieme 'uki nemɨmatsinaki'erie.   
\b  
\c 8  
\q1
\v 1 Xɨka ne'iwa pehɨkɨtɨnike,  
\q2 nemaama tsitsieyatsie pemutawerixɨ.  
\q1 Kepauka nemɨmatsi'anukunake kiekaritsie nepɨmatsiku'itsewenikeyu,  
\q2 xewitɨ pɨkayɨwenikeyu kename 'axaneyɨane mɨnerahɨaweni.   
\q1
\v 2 'Amamatsie nekawietɨ,  
\q2 nemaamakie nepɨmatsi'atɨanikeyu,  
\q2 pemɨnetita'ɨkitɨanikɨ naki'eriya hepaɨtsita.  
\q1 Winu nepɨmatsi'anu'itɨanikeyu naitɨ tinɨkame,  
\q2 meta 'ikwaxi neharaweritamieme hayari.   
\b  
\q1
\v 3 Mɨtiniyɨweniketɨ nemu'u  
\q2 'utatana nemɨniuka'uxipitɨani.  
\q2 Mɨtiniyɨweniketɨ yutseriekɨ mɨneniuwiya.   
\sp 'Uki mɨnaki'eriwa  
\q1
\v 4 Ne nepɨxewawirie, 'ukarawetsixi Kerutsareme kiekatari,  
\q2 xepɨka'ihɨtɨaka meta xepɨka'i'uximatɨaka 'uka neminaki'erie,  
\q2 mɨkɨ yɨkɨmana kepaukake manutaniere.   
\ms1 'Ataxewiriekamieme Kwikari  
\sp Yunaitɨ kwikarɨwame  
\q1
\v 5 ¿Kemɨ'ane pɨyɨane makumawetsie matimie  
\q2 'uki minaki'erie hetsie rawiyatɨ?  
\sp 'Uki mɨnaki'eriwa  
\q1 Xikɨti hetɨa nepɨmatsi'anutahɨtɨa,  
\q2 mana 'amaamatsie pepɨkaya,  
\q2 meta manatsiere pɨmatsi'utiniwexɨ.   
\sp 'Uka mɨnaki'eriwa  
\q1
\v 6 Kenena'utɨaka 'a'iyaritsie tseyu hepaɨ,  
\q2 tepɨa hepaɨ 'amamatsie kenena'utɨaka.  
\q1 Waɨkawa pɨtɨrɨkaɨye naki'eriya, mɨki hepaɨ,  
\q2 kaniyuritɨni naki'eriya, mɨki teukiya hepaɨ.  
\q1 Naki'eriya taiyari  
\q2 Kakaɨyari taiyaya hepaɨ kani'aneni.   
\q1
\v 7 Tsepa haa muwaɨkawa pɨkayɨwe mitɨnikɨ,  
\q2 meta haa hatɨa mieme mikumaweriya tɨma pɨkayɨwe.  
\q1 Xewitɨ xɨka tita naime mɨrexeiya  
\q2 tipatamɨkɨni naki'eriyakɨ,  
\q2 'axamɨtikɨhɨawarɨwanikɨ xeikɨa katinikaxeiyamɨkɨ.   
\sp Yunaitɨ kwikarɨwame  
\q1
\v 8 Kwinimieme yemekɨ 'etsipuyumate tataru 'uka  
\q2 'akuxi tsitsiteya pɨkahanexɨawawe.  
\q1 ¿Keteteyurieni xɨka ta'iwa  
\q2 'uta'iwaurieni?   
\q1
\v 9 Xɨka kiekari kuraruyaritɨnike,  
\q2 heimana tepetayatsakeyu pɨrata.  
\q1 Xɨkata 'itupari hɨkɨtɨnike,  
\q2 heimana tepikamanikeyu kariuxa mexayari.   
\sp 'Uka mɨnaki'eriwa  
\q1
\v 10 Ne kiekari kuraruyari nekanihɨkɨtɨni,  
\q2 meta netsitsite huta tuxiyuyari pɨhɨkɨ.  
\q1 'Ayumieme kepauka 'uki neminaki'erie mɨnetsikuxexeiyatsie  
\q2 kayuwatɨ nemukaxeiya hepaɨ nekatiniyumaika.   
\b  
\q1
\v 11 Tsarumuni kaxie haraweriyari kanexeiyakaitɨni Wahari-Kamuni paitɨ,  
\q2 hipame te'uximayatamete kaniwarehɨritɨani.  
\q1 Mɨkɨ yuxexuitɨ mekaniyetuiriwakaitɨni 'ikwaxi mekaxuxuawerekai,  
\q2 xeimiriyari pɨrata tuminiyari.   
\q1
\v 12 Tsarumuni xeimiriyari tumini kena'ɨtɨ,  
\q2 xemeta te'uximayatamete huta tsienituyari,  
\q2 peru nekaxie haraweriyari nexeikɨa pɨtinepiini.   
\sp 'Uki mɨnaki'eriwa  
\q1
\v 13 'Ekɨ, tuturi muwa'etsietɨkatsie pemɨti'aita,  
\q2 'aniuki xeikɨa mekanita'enieka tahamikuma,  
\q2 kenetaniu kuta tepi'enieni.   
\sp 'Uka mɨnaki'eriwa  
\q1
\v 14 Xeiya keneumietɨ, 'uki nemɨmatsinaki'erie.  
\q2 Keneunautsarɨmetɨ maxa hepaɨ, maxa 'etsimupe hepaɨ,  
\q2 hɨritetsie waritsamukɨ muwiriyarietɨkatsie.   