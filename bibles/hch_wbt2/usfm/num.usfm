\id NUM  
\h Kememɨte'uti'inɨatsie 
\toc1 Kememɨte'uti'inɨatsie 
\toc2 'Inɨatsie 
\toc3 'Inɨa 
\mt1 Kememɨte'uti'inɨatsie  
\c 1  
\s1 'Ixaheri xiɨyarimama kememɨte'uti'inɨatsie  
\p
\v 1 Merikɨtsɨ Yawé Muitsexi kaniutahɨawe, 'ixuriki tukiyari manuwe, Tsinahi mɨrakutewa makumawetsie, mexɨakame tukaritsie hutarieka metseriyaritsie, kepauka 'ixaheritsixi 'Ekipitu memayewitɨkie huta wiyari 'anuyemiekakuri. Mɨpaɨ katinitahɨawe:  
\v 2 «Yunaime keniwaraka'utɨa mana kiekatari, 'Ixaheri xiɨyarimama meta nuiwarimama yuxexuitɨ kememɨyɨpapaɨme, yunaime 'ukitsi kememɨtetetewa xewaraka'utɨwatɨ yuxexuime.  
\v 3 'Ekɨ, 'Aruni hamatɨa xekaniwaraka'utɨakuni 'ixaheritsixi waniwema yunaime 'ukitsi kuyakɨ 'aixɨa memɨ'anene, xeitewiyari wiyari memɨhɨtɨka.  
\v 4 'Ikɨ xemɨwati'inɨatakɨ xeime xekanita'inikuni wa'ukiyari mɨkɨ yuxexuime wanuiwaritsie mieme manuyeka.   
\s1 Memɨhɨritɨarie memɨwaka'utɨanikɨ  
\p
\v 5 »'Ikɨ mekanihɨkɨtɨni kemɨ'ane memɨxeparewieni:  
\b  
\li1 Xuweni xiɨyarimama hetsiemiemete, 'Eritsuxi Tserehuxi nu'aya,   
\li1
\v 6 Tsimehuni xiɨyarimama, Tserumieri Tsuritsarahi nu'aya,   
\li1
\v 7 Kura xiɨyarimama, Nahatsuni 'Aminarawi nu'aya,   
\li1
\v 8 'Itsakaxi xiɨyarimama, Natanaheri Tsuhaxi nu'aya,   
\li1
\v 9 Tsawuruni xiɨyarimama, 'Eriyawi Heruni nu'aya,   
\li1
\v 10 Kutse nu'aya xiɨyarimama hetsiemiemete: 'Eritsama 'Amihuri nu'aya, 'Epɨrahini xiɨyarimama hetsiemiemete meta Manatsexi xiɨyarimama Kamarieri Peratsuxi nu'aya,   
\li1
\v 11 Wenikamini xiɨyarimama hetsiemiemete, 'Awirani Kerehuni nu'aya,   
\li1
\v 12 Rani xiɨyarimama, 'Akihetsexi 'Amitsarahi nu'aya,   
\li1
\v 13 'Atsexi xiɨyarimama, Pakieri 'Ukɨrani nu'aya,   
\li1
\v 14 Kahari xiɨyarimama hetsiemiemete, 'Eriyatsati Rehuheri nu'aya,   
\li1
\v 15 Nepɨtahari xiɨyarimama hetsiemiemete, 'Akira 'Enahani nu'aya».   
\b  
\p
\v 16 'Ikɨ mekanihɨkɨtɨni kiekatari memanuyeyaxe, memaka'utɨarie nuiwarite kememɨtehɨkɨ meta kuyaxi 'Ixaheritsixi tewa'aitɨwamete.   
\s1 Memaka'utsie kememutipaɨmerixi  
\p
\v 17 Hikɨ Muitsexi, 'Aruni hamatɨa 'ukitsi mekaniwarukuxeɨrieni memɨwaraka'utɨanikɨ kememɨtetetewatɨka memanayexeiyarie wahetsie,  
\v 18 hutarieka metseriyaritsie 'itsutɨakaku yunaime kiekatari mekaniwarukuxeɨrieni. Yuxexuitɨ mekanaka'utsieni hakewa memeyenunuiwaxɨ kemɨ'ane memɨtehaxiɨyari. 'Ana mekanaka'utuarieni yunaitɨ 'ukitsi xeitewiyari wiyari memexeiyatɨka,  
\v 19 Muitsexi yakatinikayani, Yawé kemɨtita'aitɨakai. 'Ikɨ Muitsexi kaniwaraka'utɨani Tsinahi 'uyeikatɨ makumawatsie.   
\b  
\li1
\v 20 Xuweni xiɨyarimama, 'Ixaheri matɨarieya, mekanaka'utsieni kemɨ'ane memutehaniwema meta memɨtehaxiɨyarima, kehepaɨ memɨte'ununuiwaxɨ. Yunaitɨ 'ukitsi xeitewiyari wiyari memɨhɨtɨka mekanaka'utɨarieni kuyaxikɨ 'aixɨa memɨ'anenekai memɨyɨwawe.  
\v 21 Xuweni xiɨyarimama huta tewiyari heimana 'ataxewi miriyari heimana 'auxɨwi tsienituyari (46.500) 'ukitsi mekanakɨne.   
\b  
\li1
\v 22 Tsimehuni xiɨyarimamata mekanaka'utsieni kemɨ'ane memutehaniwema meta kemɨ'ane memɨtehaxiɨyarima, kehepaɨ memɨte'ununuiwaxɨ. Yunaitɨ 'ukitsi xeitewiyari wiyari memɨhɨtɨka mekanaka'utɨarieni kuyakɨ 'aixɨa memɨ'anene.  
\v 23 Tsimehuni xiɨyarimama huta tewiyari heimana tamamata heimana 'atanauka miriyari heimana haika tsienituyari (59.300) 'ukitsi mekanakɨne.   
\b  
\li1
\v 24 Kahari xiɨyarimama mekanaka'utsieni kemɨ'ane memɨtehaniwema meta memɨtehaxiɨyarima, kehepaɨ memɨte'ununuiwaxɨ. Yunaitɨ 'ukitsi xeitewiyari wiyari memɨhɨtɨka mekanaka'utsieni kuyaxikɨ 'aixɨa memɨ'anenekai.  
\v 25 Kahari xiɨyarimama huta tewiyari heimana 'auxɨwi miriyari heimana 'ataxewime tsienituyari heimana huta tewiyari heimana tamamata (45.650) 'ukitsi mekanakɨne.   
\b  
\li1
\v 26 Kura xiɨyarimama mekanaka'utsieni kemɨ'ane memɨtehaniwema meta memɨtehaxiɨyarima, kehepaɨ memɨte'ununuiwaxɨ. Yunaitɨ 'ukitsi xeitewiyari wiyari memɨhɨtɨkatei mekanaka'utsieni kuyakɨ 'aixɨa memɨ'anene.  
\v 27 Kura xiɨyarimama haika tewiyari heimana tamamata heimana nauka miriyari heimana 'ataxewime tsienituyari (74.600) 'ukitsi mekanakɨne.   
\b  
\li1
\v 28 'Itsakaxi xiɨyarimama mekanaka'utsieni kemɨ'ane memɨtehaniwema meta kemɨ'ane memɨtehaxiɨyarima, kehepaɨ memɨte'ununuiwaxɨ. Yunaitɨ 'ukitsi xeitewiyari wiyari memɨhɨtɨkatei mekanaka'utsieni kuyakɨ 'aixɨa memɨ'anene.  
\v 29 'Itsakaxi xiɨyarimama huta tewiyari heimana tamamata heimana nauka miriyari heimana nauka tsienituyari (54.400) 'ukitsi mekanakɨne.   
\b  
\li1
\v 30 Tsawuruni xiɨyarimama mekanaka'utsieni kemɨ'ane memɨtehaniwema meta kemɨ'ane memɨtehaxiɨyarima, kehepaɨ memɨte'ununuiwaxɨ. Yunaitɨ 'ukitsi xeitewiyari wiyari memɨhɨtɨka mekanaka'utsieni kuyakɨ 'aixɨa memɨ'anene.  
\v 31 Tsawuruni xiɨyarimama huta tewiyari heimana tamamata heimana 'atahuta miriyari heimana nauka tsienituyari (57.400) 'ukitsi mekanakɨne.   
\b  
\li1
\v 32 Kutse xiɨyarimama:  
\li1 'Epɨrahini xiɨyarimama mekana'utsieni kemɨ'ane memutehaniwema meta kemɨ'ane memɨtehaxiɨyarima, kehepaɨ memɨte'ununuiwaxɨ. Yunaitɨ 'ukitsi xeitewiyari wiyari memɨhɨtɨkatei mekanaka'utsieni kuyakɨ 'aixɨa memɨ'anene.  
\v 33 'Epɨrahini xiɨyarimama huta tewiyari miriyari heimana 'auxɨwime tsienituyari (40.500) 'ukitsi mekanakɨne.   
\li1
\v 34 Manatsexi xiɨyarimamata mekanaka'utsieni kemɨ'ane memɨtehaniwema meta memɨtehaxiɨyarima, kehepaɨ memɨte'ununuiwaxɨ. Yunaitɨ 'ukitsi xeitewiyari wiyari memɨhɨtɨkatei mekanaka'utsieni kuyakɨ 'aixɨa memɨ'anene.  
\v 35 Manatsexi xiɨyarimama xeitewiyari heimana tamamata heimana huta miriyari heimana huta tsienituyari (32.200) 'ukitsi mekanakɨne.   
\b  
\li1
\v 36 Wenikamini xiɨyarimama mekanaka'utsieni kemɨ'ane memɨtehaniwema meta memɨtehaxiɨyarima, kehepaɨ memɨte'ununuiwaxɨ. Yunaitɨ 'ukitsi xeitewiyari wiyari memɨhɨtɨkatei mekanaka'utsieni kuyakɨ 'aixɨa memɨ'anene.  
\v 37 Wenikamini xiɨyarimama xeitewiyari heimana tamamata heimana 'auxɨwi miriyari heimana nauka tsienituyari (35.400) 'ukitsi mekanakɨne.   
\b  
\li1
\v 38 Rani xiɨyarimama mekanaka'utsieni kemɨ'ane memɨtehaniwema meta memɨtehaxiɨyarima, kehepaɨ memɨte'ununuiwaxɨ. Yunaitɨ 'ukitsi xeitewiyari wiyari memɨhɨtɨka mekanaka'utsieni kuyakɨ 'aixɨa memɨ'anene.  
\v 39 Rani xiɨyarimama haika tewiyari heimana huta miriyari heimana 'atahuta tsienituyari (62.700) 'ukitsi mekanakɨne.   
\b  
\li1
\v 40 'Atsexi xiɨyarimamata mekanaka'utsieni kemɨ'ane memɨtehaniwema meta memɨtehaxiɨyarima, kehepaɨ memɨte'ununuiwaxɨ. Yunaitɨ 'ukitsi xeitewiyari wiyari memɨhɨtɨkatei mekanaka'utsieni kuyakɨ 'aixɨa memɨ'anene memɨkamama.  
\v 41 'Atsexi xiɨyarimama huta tewiyari heimana xewi miriyari heimana 'auxɨwime tsienituyari (41.500) 'ukitsi mekanakɨne.   
\b  
\li1
\v 42 Nepɨtahari xiɨyarimama mekanaka'utsieni kemɨ'ane memutehaniwema meta memɨtehaxiɨyarima, kehepaɨ memɨte'ununuiwaxɨa. Yunaitɨ 'ukitsi xeitewiyari wiyari memɨhɨtɨka mekanaka'utsieni kuyakɨ 'aixɨa memɨ'anene.  
\v 43 Nepɨtahari xiɨyarimama huta tewiyari heimana tamamata heimana haika miriyari heimana nauka tsienituyari (53.400) 'ukitsi mekanakɨne.   
\b  
\p
\v 44 Merikɨte 'ipaɨ yupaɨmetɨ mekanakɨne kepauka Muitsexi 'Aruni hamatɨa memɨwaraka'utɨatsie, mewaparewiekaku 'Ixaheri xiɨyarimama tamamata heimana huta meyupaɨmetɨ, mɨkɨ yuxexuitɨ yunuiwari hetsiemieme mekaniyɨakaitɨni.  
\v 45 Yunaitɨ 'ixaheritsixi xeitewiyari wiyari memɨhɨtɨkatei, kuyakɨ 'aixɨa memɨ'anene mekanaka'utsieni, kememɨyupaɨmekai nuiwarite.  
\v 46 Yunaitɨ 'ixaheritsixi memaka'utsie, 'ataxewime tsienituyari heimana haika miriyari heimana 'auxɨwime tsienituyari heimana huta tewiyari heimana tamamata (603.550) meyupaɨmetɨ mekanakɨne.   
\s1 Rewitsixi  
\p
\v 47 Rewitsixi teɨteriyari mepɨkahaka'utɨarie hipame wahamatɨa,  
\v 48 matsi Yawé Muitsexi mɨpaɨ mɨtiutahɨawekaikɨ:  
\v 49 «Rewi xiɨyarimama pepɨkawaraka'utɨani, 'Ixaheri niwemama wahamatɨa memɨkayutinɨnɨwenikɨ.  
\v 50 'Aixɨa kaniyɨmɨkɨ, 'ekɨ pemɨwahɨritɨanikɨ tɨratu tukita mayeka hepaɨtsita meta naime hepaɨtsita ketipaɨmetɨ muwa mɨtiyepine kemɨtiyukumaɨwa. Rewitsixi Kakaɨyari tukieya mepɨ'ɨwiyani naime muwa mɨtiyepine. Yaxeikɨa yuheyemekɨ muyepatsietsie mekatene'uximayakakuni 'ahurawa memakuteitsie meheitayeme.  
\v 51 Kepauka tukieya xemanukwenitsie rewitsixi xeikɨa mekanitaxɨnakuni, kepauka memeitawewienitsie mɨkɨ xeikɨa mekaneyɨakakuni. Kemɨ'ane 'ahurawa mauyani tukieya manuka kamawari wewiwametɨtɨ kanemɨmɨkɨ.  
\v 52 Yunaitɨ 'ixaheri teɨteriyari yateewa mekanikuyaxixɨakuni yuxexuitɨ me'ukutetɨkaitɨ yupatera mehexeiyatɨkaitɨ kememɨteyunuiwari.  
\v 53 Hikɨ rewitsixi tɨratu tukita manuka 'aurie mekanikuyaxikuni, 'Ixaheri kwieyaritsie xemɨnuakakɨ kepauka Kakaɨyari ha'atɨ wahetsie munuani. Merikɨ rewitsixi xeikɨa mekanihɨkɨtɨkakuni tɨratu tukita hepaɨtsita tehɨwemete».   
\p
\v 54 Hikɨ naimekɨ 'ixaheritsixi yamekatenikakɨne Yawé Muitsexi kemɨtiuta'aitɨa.   
\c 2  
\s1 Makumawetsie nuiwarite kememɨtekuyaxixɨ  
\p
\v 1 Merikɨtsɨ Yawé Muitsexi 'Aruni mame mɨpaɨ katiniwarutahɨawe:  
\v 2 «'Ixaheritsixi 'ixuriki tukiyari manuwe memayutixexeɨriwa 'aurie mekanayaxetɨkɨnikuni yupatera mehexeiyatɨ meta yu'inɨari, hepana meheutanenieretɨ, yuxexuitɨ kememɨyupapaɨme nuiwarite.   
\b  
\pi1
\v 3 »Tau manatineika 'aurie, mana mekanitiyaxikuni kemɨ'ane Kura memaweiya, kememɨyupapaɨme. Nahatsuni wa'ukiyari kanihɨkɨtɨni 'Aminarawi nu'aya.  
\v 4 Yunaitɨ haika tewiyari heimana tamamata heimana nauka miriyari heimana 'ataxewime tsienituyari (74.600) 'ukitsi mekaniyupaɨmeni.   
\pi1
\v 5 »Kura memakutei wa'aurie 'Itsakaxi xiɨyarimama mekanitiyaxikuni. Natanaheri wa'ukiyari kanihɨkɨtɨni Tsuhaxi nu'aya.  
\v 6 Yunaitɨ huta tewiyari heimana tamamata heimana nauka miriyari heimana nauka tsienituyari (54.400) 'ukitsi mekaniyupaɨmeni.   
\pi1
\v 7 »Tapa pɨtata Tsawuruni xiɨyarimama mekanikuyaxikuni. 'Eriyáwi wa'ukiyari kanihɨkɨtɨni Heruni nu'aya.  
\v 8 Yunaitɨ huta tewiyari heimana tamamata heimana 'atahuta miriyari heimana nauka tsienituyari (57.400) 'ukitsi mekaniyupaɨmeni.   
\pi1
\v 9 »Yunaitɨ Kura xiɨyarimama mekaniyupaɨmeni, xeitsienituyari heimana nauka tewiyari heimana 'ataxewi miriyari heimana nauka tsienituyari (186.400), mɨkɨ mekananuyeyaxikuni.   
\b  
\pi1
\v 10 »Tatsutɨata Xuweni memaweiya yunaitɨ kememuyupaɨme yupatera hetɨa mana mekanitiyaxikuni, 'ikɨ yameyupaɨmetɨ. 'Eritsuxi wa'ukiyari kanihɨkɨtɨni Tserehuxi nu'aya.  
\v 11 Yunaitɨ kuyaximama huta tewiyari heimana 'ataxewi miriyari heimana 'auxɨwime tsienituyari (46.500) 'ukitsi mekaniyupaɨmeni.   
\pi1
\v 12 »Xuweni wa'aurie Tsimehuni xiɨyarimama mekanitiyaxikuni. Tserumieri wa'ukiyari katinitewaka Tsuritsarahi nu'aya.  
\v 13 Yunaitɨ huta tewiyari heimana tamamata heimana 'atanauka miriyari heimana haika tsienituyari (59.300) 'ukitsi mekaniyupaɨmeni.   
\pi1
\v 14 »Wa'aurieta mekanitiyaxikuni Kahari xiɨyarimama. 'Eriyatsati wa'ukiyari kanihɨkɨtɨni Xehueri nu'aya.  
\v 15 Yunaitɨ huta tewiyari heimana 'auxɨwi miriyari heimana 'ataxewi tsienituyari heimana huta tewiyari heimana tamamata (45.650) 'ukitsi mekaniyupaɨmeni.   
\pi1
\v 16 »Yunaitɨ Xuweni xiɨyarimama memakutei, me'inɨaritɨ kememuyupaɨme wanuiwarite, xeitsienituyari heimana huta tewiyari heimana tamamata heimana xewi miriyari heimana nauka tsienituyari heimana huta tewiyari heimana tamamata (151.450) 'ukitsi memuyupaɨme, mɨkɨ hutariekatsie memɨyehu.   
\b  
\pi1
\v 17 »Merikɨte 'ixuriki tukiyari me'akwetɨ rewitsixi mekaniyekɨkakaɨtɨni yunaime wahixɨapa memukutei. Yaxeikɨa mekateniyaxikuni kehepaɨ memɨteheukutekai yuxexuitɨ yuhuyeripa meta yupatera me'akwetɨ.   
\b  
\pi1
\v 18 »Tau makayuyuipiketsie yupatera hetɨa mekanitiyaxikuni 'Epɨrahini xiɨyarimama, kehepaɨ memɨteheukununuiwa. 'Eritsama wa'ukiyari kanihɨkɨtɨni 'Amihuri nu'aya.  
\v 19 Kuyaximama nauka tewiyari miriyari heimana 'auxɨwime tsienituyari (40.500) 'ukitsi memuyupaɨme.   
\pi1
\v 20 »'Epɨrahini 'aurieta mekanitiyaxikuni Manatsexi xiɨyarimama. Kamarieri wa'ukiyari kanihɨkɨtɨni Peratsuxi nu'aya.  
\v 21 Kuyaximama xeitewiyari heimana tamamata heimana huta miriyari heimana huta tsienituyari (32.200) 'ukitsi mekaniyupaɨmeni.   
\pi1
\v 22 »Xaɨtsieta mekanitiyaxikuni Wenikamini xiɨyarimama. 'Awirani wa'ukiyari mɨhɨkɨ Kerehuni nu'aya.  
\v 23 Yunaitɨ xeitewiyari heimana tamamata heimana 'auxɨwi miriyari heimama nauka tsienituyari (35.400) 'ukitsi mekaniyupaɨmeni.   
\pi1
\v 24 »Yunaitɨ kuyakɨ memɨyɨwawe 'Epɨrahini 'aurie memukutei, yunaitɨ me'inɨaritɨ yameyupapaɨmetɨ, xeitsienituyari heimana 'atahaika miriyari heimana xeitsienituyari (108.100) 'ukitsi, mɨkɨ mekaniyehuni hairiekatsie.   
\b  
\pi1
\v 25 »Tayeta mekanitiyaxikuni Rani xiɨyarimama, kememɨyupaɨme. 'Akihetsexi wa'ukiyari kanihɨkɨtɨni 'Amitsarahi nu'aya.  
\v 26 Mekaniyupaɨmeni yunaitɨ haika tewiyari heimana huta miriyari heimana 'atahuta tsienituyari (62.700) 'ukitsi.   
\pi1
\v 27 »Rani 'aurieta 'Atsexi xiɨyarimama mekanitiyaxikuni. Pakieri wa'ukiyari mɨhɨkɨ 'Ukɨrani nu'aya.  
\v 28 Yunaitɨ huta tewiyari heimana xewi miriyari heimana 'auxɨwi tsienituyari (41.500) 'ukitsi memɨhɨkɨ.   
\pi1
\v 29 »Wa'auriepaita mekanikuyaxikuni Nepɨtahari xiɨyarimama. Wa'ukiyari pɨhɨkɨ 'Akira 'Enahani nu'aya.  
\v 30 Yunaitɨ mekaniyupaɨmeni huta tewiyari heimana tamamata heimana haika miriyari heimana nauka tsienituyari (53.400) 'ukitsi.   
\pi1
\v 31 »Yunaitɨ memuta'inierie kuyaxi Rani 'aurie mekanikuyaxe, yunaitɨ xeitsienituyari heimana huta tewiyari heimana tamamata heimana 'atahuta miriyari heimana 'ataxewime tsienituyari (157.600) 'ukitsi mekaniyutipaɨmere, mɨkɨ wa'utɨmake mekanayekɨnikuni yupatera me'akwetɨ».   
\b  
\p
\v 32 Merikɨte 'ikɨ mekanihɨkɨtɨni 'ixaheritsixi waniwema memaka'utɨarie kuyaxikɨ memɨyɨwawe kememɨyupapaɨmekai. Yunaitɨ Kuyaxi memuta'inierie yuxexuitɨ 'ataxewi tsienituyari heimana haika miriyari heimana 'auxɨwi tsienituyari heimana huta tewiyari heimana tamamata (603.550) 'ukitsi mekaniyutipaɨmere.  
\v 33 Peru Rewitsixi hipame 'ixaheritsixi wamahatɨa mepɨka'utinɨitɨarie, Yawé Muitsexi kemutiuta'aitɨakai yapɨtiuyɨ.   
\b  
\p
\v 34 Hikɨ 'ixaheritsixi Yawé Muitsexi mɨpaɨ kemɨtiutahɨawekai yamekatenikakɨne: kememɨyupapaɨmekai 'axeikɨa mekanikuyaxikekaitɨni yupatera mehexeiyatɨkaitɨ meta memayekɨkakaitsie kememɨte'ununuiwaxɨ mɨpaɨ mekatenayekɨkakaitɨni 'iwamarixi xeinuiwaritetsie miemete.   
\c 3  
\s1 Rewi xiɨyarimama  
\p
\v 1 Merikɨte 'Aruni niwemama mɨpaɨ mekatenaka'utɨarieni Muitsexi hamatɨa, kepauka Yawé Muitsexi hamatɨa mɨtiutixa Tsinahi hɨriyaritsie.   
\s1 Mawari wewiwamete  
\p
\v 2 Mɨpaɨ mekatenaka'utɨarieni kememɨtetetewakai 'Aruni niwemama: Narawi matɨarimieme, 'Awihu, 'Eriyatsaxi meta 'Itamaxi 'imatɨreme.  
\v 3 Mɨkɨ 'Aruni tɨɨriyamama memanayexeiyarie memɨpatsie mekanihɨkɨtɨni, mawari wewiwamete te'uximayatamete memakɨnekɨ.  
\v 4 Narawi 'Awihu matɨari mekaniukwini Yawé hɨxie, kepauka makumawetsie Tsinahi mɨrakutewa memu'uwakai, mawari taiyariyari mekaniwaruwewirieni yakɨxeikɨa mɨhɨkɨ. Matsi Narawi 'Awihu hamatɨa tɨɨri memɨkawarayexeikɨ, 'Eriyatsaxi 'Itamaxi hamatɨa xeikɨa mekanimawari wewiwametetɨkaitɨni yupaapa tukarieya hepaɨtsita, 'Aruni hetsiemieme.   
\s1 Rewitsixi kememɨteta'uximayata  
\p
\v 5 Yawé Muitsexi mɨpaɨ katiniutahaɨwe:  
\v 6 «Rewi xiɨyarimama keniwawitɨmie 'Aruni hɨxie keniwati'uitɨa. Rewitsixi mekaniparewikuni mɨra'uximayatsie.  
\v 7 'Aruni kemɨtiyurienekai yamekateniyuriekakuni hetsiena mieme meta yunaitɨ mana kiekatari, mewahɨritɨatɨ memɨte'uximayakakɨ mɨkɨ 'ixuriki tukiyarita.  
\v 8 Naime muwa mɨtiyepine 'ixuriki tukiyarita mekateni'ɨwiyakakuni, muwa mete'uximayatɨ 'ixaheritsixi, yamemɨteyuriekakɨ memɨte'uximayakakɨ meyɨhɨritatɨ 'ixuriki tukiyarita.  
\v 9 'Aruni, rewitsixi pekaniwahɨritɨamɨkɨ mɨtiwata'aitɨanikɨ meta waniwema. Mɨkɨ xeikɨa mekanihɨkɨtɨkakuni nehetsiemieme memɨte'uximayaka 'ixaheritsixi watsata.  
\v 10 'Aruni niwemama mawari wewiwametekɨ xeikɨa mekaniwaranayexeiyakuni. Kemɨ'ane kamawari wewiwametɨtɨ 'ixuriki tukiyarita mɨye'ani mɨkɨ kanimieriemɨkɨ kareuyehɨwiyarietɨ».   
\s1 Rewitsixi kememɨte'anayexeiyarie  
\p
\v 11 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 12 «Ne 'Ixaheritsixi wanuiwaritsie rewitsixi nekaniwaranuyexeiya, matɨari nunuiwakate wahepaɨ. Rewitsixi nehetsɨa miemete mekanihɨkɨtɨni,  
\v 13 matsi matɨari nunuiwakate nehetsɨa miemete memɨhɨkɨkɨ. Kepauka 'Ekipitu matɨari nunuiwakate nemɨwarutayuniyaxɨtsie, 'ana nekaniwarupata nehetsɨa memɨmiemetetɨnikɨ matɨari nunuiwakate 'ixaheritsixi teɨteriyari, teɨteri meta tewaxi. 'Ayumieme hikɨ nehetsɨa mekanimiemetetɨni. Ne Yawé nekanihɨkɨtɨni».   
\s1 Rewi xiɨyarimama kememɨte'uti'inɨatsie  
\p
\v 14 Merikɨtsɨ Yawé Muitsexi mɨpaɨ katiniutahɨawe Tsinahi makumawetsie paitɨ:  
\v 15 «Rewi xiɨyarimama meta nuiwarimama kememɨyupapaɨme keniwaraka'utɨa, yunaime 'ukitsi xeimetseri memexeiyatɨka mana meutiyune».   
\p
\v 16 Hikɨ Muitsexi kanitsutɨani waraka'utɨwatɨ, Yawé kemɨrehɨawekai yakatinikayani.   
\li1
\v 17 Rewi niwemama mepɨhɨkɨ:  
\li2 Keritsuni, Kuhati meta Merari.   
\li1
\v 18 Keritsuni nuiwarimama memakɨ:  
\li2 Riwini hamatɨa Tsimi.   
\li1
\v 19 Kuhatitsixi memɨhɨkɨtɨkai:  
\li2 'Amirani, 'Itsaxi, Hewuruni meta 'Utsiheri.   
\li1
\v 20 Merari nuiwarimama:  
\li2 Makiri meta Mutsihí.  
\p 'Ikɨ mekanihɨkɨtɨni rewitsixi wanuiwarima, memaka'utsie kememɨte'ununuiwaxɨ.   
\s1 Kerutsunitsixi memɨhɨkɨ  
\p
\v 21 Keritsuni hetsie memɨyenunuiwakai Riwini mekanihɨkɨtɨni Tsimi hamatɨa. 'Ikɨ kerutsunitsixi memɨwaraweiyakai mekanihɨkɨtɨni.  
\v 22 Yunaime 'ukitsi xeimetseri memexeiyatɨka mana meutiyune, 'atahuta miriyari heimana 'auxɨwi tsienituyari (7.500) 'ukitsi meyupaɨmetɨ mekanakɨne.  
\v 23 Keritsuni nuiwarimama memɨhɨkɨ tau manukayuyuipike 'aurie mekanikutekaitɨni tuki manuwe hetɨa.  
\v 24 Keritsuni nuiwarimama wa'ukiyari 'Eriyatsati kanihɨkɨtɨkaitɨni Raheri nu'aya.  
\v 25 'Ixurikite tukiyari hetsiemieme, Keritsuni nuiwarimama mekanihɨritɨariekaitɨni tuki manukanakaikɨ mɨreutahakitɨretsie, nawi manukawere 'ixurikite heima,  
\v 26 'ixuriki kuraruyari takwa maka meta 'ixuriki meuwu kuraru kiteniyaritsie meta mawari taiyame warita makatei, yaxeikɨata tinaime kɨmana mɨrakuwɨwɨre memɨtekumaɨwakai.   
\s1 Kuhatitsixi memɨwaraweiyakai  
\p
\v 27 Kuhati hetsie mepɨyekɨ 'Amirani nuiwarimama, 'Itsaxi nuiwarimama, Hewuruni nuiwarimama meta 'Utsiheri nuiwarimama. 'Ikɨ Kuhati nuiwarimama mepɨhɨkɨtɨkai,  
\v 28 memɨte'uximayakai tukita. Yunaime 'ukitsi xeimetseri memexeiyatɨka mana meutiyune, 'atahaika miriyari heimana 'ataxewi tsienituyari (8.600) mekaniyupaɨmekaitɨni 'ukitsi.  
\v 29 Kuhati memaweiyakai tuki manuwe tserieta mekanititekaitɨni.  
\v 30 Kuhatitsixi kememɨyupaɨmekai 'Eritsapani wa'ukiyari kanihɨkɨtɨkaitɨni 'Utsiheri nu'aya.  
\v 31 Mɨkɨ mekanihɨritɨariekaitɨni tukita kakuni, mexa, kɨxeme, mawari taiyameta, tukita mɨrayepine xakɨrɨte, watsute, 'itɨte mɨkɨ mepɨtekumaɨwa meta 'ixuriki waɨkawa muyepatsieta meuwɨkai, yaxeikɨa naime tita mɨreuyewekai memɨte'uximayakakɨ.   
\p
\v 32 Rewitsixi wa'ukiyari yemekɨ 'Eriyatsaxi kanihɨkɨtɨkaitɨni 'Aruni nu'aya mawari wewiwame, mɨkɨ mɨhɨritɨariekaikɨ tuki muyepatsieta mɨtiwa'aitɨakakɨ mɨwa'ukiyaritɨkaikɨ.   
\s1 Meraritsixi memɨwaraweiya  
\p
\v 33 Merari hetsɨa miemete Makiri hamatɨa Mutsihí mekanihɨkɨtɨni. 'Ikɨ mekanihɨkɨtɨni Meraritsixi nuiwarimama.  
\v 34 Yunaime 'ukitsi xeimetseri memexeiyatɨka mana meutiyune, 'ataxewime miriyari heimana huta tsienituyari (6.200) meyupaɨmetɨ mekanakɨne 'ukitsi.  
\v 35 Meraritsixi wa'ukiyari Tsurieri kanihɨkɨtɨkaitɨni 'Awikahiri nu'aya. Merari nuiwarimama tuki manuwe 'utata mekanikutekaitɨni.  
\v 36 Mɨkɨ mekanihɨritɨariekaitɨni memɨtetimɨwanikɨ, tatsɨari tukitsie mɨranuyehipite, mexa hetsiena ma'uni, meta muka'utɨka meta tinaitɨ muwa mɨtiyepine mɨtiyukumaɨwa.  
\v 37 Yaxeikɨa kɨyexi muka'utɨka mekani'ɨwiyakaitɨni meta tekɨapai maheitɨkatei naime makuwutɨkatei kaunariyari.   
\s1 Rewi xiɨyarimama  
\p
\v 38 Muitsexi 'Aruni hamatɨa meta waniwema yunaitɨ 'ixuriki tukiyari hɨxie mekanititekaitɨni, tatsɨari tau manatineika 'aurie, 'ixuriki tukiyari memɨhɨritɨariekaikɨ 'ixaheritsixi wahetsiemieme memɨwayetuayanikɨ. Peru kemɨ'ane kamawari wewiwametɨtɨ mana 'ahurawa mɨye'ani, mɨkɨ mekanitakwikwiwakaitɨni.   
\p
\v 39 Muitsexi 'Aruni hamatɨa rewitsixi mekaniwaruka'utɨani Yawé kemɨtiwaruta'aitɨakai tiwarutaxatɨaka. Yunaitɨ rewitsixi xeimetseri memexeiyatɨka huteikɨ mautiyune mekanaka'utsieni, kememɨyupapaɨmekai mekaniuti'ani xeitewiyari heimana huta miriyari (22.000) meyupaɨmetɨ mekanakɨne 'ukitsi.   
\s1 Rewitsixi meta matɨari miemete  
\p
\v 40 Merikɨtsɨ Yawé Muitsexi mɨpaɨ katiniutahɨawe: «Keniwaruka'utɨa yunaime 'ixaheritsixi matɨari miemete 'ukitsi xeimetseri memexeiyatɨka mana meutiyune kememɨtetetewa pewaraka'utɨwatɨ.  
\v 41 Yunaitɨ rewitsixi nehetsiemieme mepakɨne 'ixaheritsixi matɨari miemete wahetsiemieme, metatsiere rewitsixi watewama, 'ixaheritsixi watewama matɨari miemete wahetsiemieme. Ne Yawé nekanihɨkɨtɨni».   
\p
\v 42 Muitsexi 'ixaheritsixi kaniwaruka'utɨani matɨari miemete, Yawé kemɨtita'aitɨakai.  
\v 43 Yunaitɨ me'inɨaritɨ 'ukitsi xeimetseri memexeiyatɨka mana meutiyune, mexɨakate memaka'utsiwakai kememɨtetetewa xeitewiyari heimana huta miriyari heimana huta tsienituyari heimana haika tewiyari heimana tamamata heimana haika (22.273) mekaniuyutipaɨmere 'ukitsi.   
\p
\v 44 Hikɨ Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 45 «Yunaitɨ rewitsixi nehetsiemieme mepakɨne 'ixaheritsixi matɨari miemete wahetsiemieme, metatsiere rewitsixi watewama, 'ixaheritsixi watewama matɨari miemete wahetsiemieme. Rewitsixi nehetsiemieme mepakɨne. Ne Yawé nekanihɨkɨtɨni.   
\p
\v 46 »Para pemɨwatawikweitsitɨanikɨ huta tsienituyari heimana haika tewiyari heimana tamamata heimana haika (273) mexɨakate 'ixaheritsixi, rewitsixi memɨkayuwaɨkawakɨ,  
\v 47 pekaniyetuamɨkɨ 'auxɨwime tumini pɨrata raheteme yuxexuime wahetsiemieme, tukita mieme tumini kemɨrahete, tamamata heimana xewi kɨramuyari pɨrahete.  
\v 48 Mɨkɨ tumini yunaime pekaniwayetuiriemɨkɨ 'Aruni meta niwemama, 'ixaheritsixi kepemɨtiwarutawikweitsitɨa memuti'inɨatsietsie memɨyumɨirekaikɨ».   
\p
\v 49 Hikɨ Muitsexi mɨkɨ tumini kananu'ɨni 'ixaheritsixi wahetsiemieme, rewitsixi memɨkayuwaɨkawakaikɨ.  
\v 50 Kaniuku'ɨni, xeimiriyari heimana haika tsienituyari heimana haika tewiyari heimana 'auxɨwi (1.365) tumini pɨratayari, kemɨti'inɨatakai tumini tukita mieme.  
\v 51 Hikɨ kaniyetuani mɨkɨ tumini 'Aruni hetsɨa meta niwemama wahetsɨa, yemekɨ Yawé kemɨtita'aitɨa.   
\c 4  
\s1 Kuhatitsixi kememɨteyurieka  
\p
\v 1 Merikɨte Yawé Muitsexi 'Aruni mame mɨpaɨ katiniwarutahɨawe:  
\v 2 «Rewitsixi xekeniwaraka'utɨa, Kuhati nuiwarimama meta hetsiena memɨyekɨ.  
\v 3 Yunaime xekeniwaraka'utɨa xeitewiyari heimana tamamata wiyari huteikɨ meheutiyuneme, huta tewiyari heimana tamamata wiyari me'uti'akame 'ukitsi 'aixɨa memɨ'anene 'ixuriki tukiyarita memɨte'uximayakakɨ.   
\p
\v 4 »Kuhatitsixi tehɨwemete mekanihɨtɨkakuni 'ixuriki tukita mɨtiyepine kwinimieme mɨtimaiwetɨka hepaɨtsita piinitɨarika.  
\v 5 Kepauka 'ixaheritsixi memayekɨnetsie, 'Aruni yuniwematɨ 'ixuriki tukita mekaneutahaxɨakuni mekaneixɨnakuni 'ixuriki meuwie memeikunanikɨ kakuni tɨratuyari maukunakakɨ.  
\v 6 'Ariketa ketsɨ 'amɨpa nawiyarieya mekaneikunakuni meta tuwaxakɨ mɨyɨtsikimaɨye, kɨyexita mekananukutuakuni kɨmana memikukwetɨwenikɨ.   
\p
\v 7 »Yawé hɨxie mexa muwe 'ixuriki mɨyɨtsikimaɨye mekananakawerakuni, mana mekatenapikuni xakɨrɨte, pateyute yakɨmɨpepe, tekɨxite, ye'ɨrɨte 'amɨnene kaxie winuyari mɨtiyeuriwa mawariyari yunɨkame. Yaxeikɨata paa mana kanamakamɨkɨ yuheyemekɨ mɨmawarie.  
\v 8 Naime 'ikɨ wahetsie xekanenukawerakuni 'ixuriki mɨxetakɨ. Yaxeikɨa mexa ketsɨ 'amɨpa nawiyarieya xekanenukanakuni meta kɨyexita mekananukutuakuni kɨmana memikukwetɨwenikɨ.   
\p
\v 9 »Xeime 'ixuriki mɨyɨtsikimaɨyekɨ kɨxeme 'uitɨwame meta kɨxemete, titɨkɨme, naxi yetsame meta naime tita mɨtiyukumaɨwa hatseitikɨ xekatenanukanakuni.  
\v 10 Hikɨ xekanenukanakunita kɨxeme 'uitɨwame meta naime mana timieme ketsɨ 'amɨpa nawiyarieya, kaxetatsie xekaneikayekuni.   
\p
\v 11 »Meta 'ixuriki mɨyɨtsikimaɨye, mɨratimawatɨre hurukɨ xeikɨa mɨwewiya xekanenukaweriekuni metatsiere ketsɨ 'amɨpa nawiyarieyakɨ, kɨyexita xekananukutuakuni kɨmana mukukweiyanenikɨ.   
\p
\v 12 »Xekanita'eimakuni 'ixuriki mɨyɨtsikimaɨyekɨ naime tita mɨtiyukumaɨwa 'ixuriki tukita, heimana ketsɨ 'amɨpa nawiyarieyakɨ xekanikanakuni meta kɨyexitsie xekaniyehɨakuni manɨtɨkienikɨ.   
\p
\v 13 »Mɨtiwatitaiyarɨwatsie naxi xekanewayewiwikuni, 'ana 'ixurikikɨ kwimɨxetakɨ xenita'eimakuni.  
\v 14 Hetsiena xekatenikapikuni naime tita mana mɨtiyukumaɨwakai, tɨ muiname, tepɨa manɨxɨte, 'itɨ 'amɨpa, tekɨxite ye'ɨrɨte 'amɨnene, meta naime tita mana mɨtiyukumaɨwa. Hikɨ heimana ketsɨ 'amɨpa nawiyarieyakɨ xekanenuka'eimakuni meta kɨyexi xekananuye'uitɨakuni para mɨkutɨkienenikɨ.   
\p
\v 15 »Kepauka 'Aruni yuniwema wahamatɨa memɨtinɨni mete'anukanarɨmatɨ naime, hikɨ 'anake 'ixaheritsixi mekaniyehuni. 'Ana kuhatitsixi mekanenɨtɨkuni tuki, perutsɨ meka'ikumaɨwatɨ nɨkahɨrixie me'ukwinikɨ. Yaxeikɨata muwa 'ixuriki tukita mɨrayepine mekatenanutɨkuni.   
\p
\v 16 »Hikɨ, 'Eriyatsaxi 'Aruni nu'aya, kanihɨritɨariekamɨkɨ hatseiti kɨxeme hetsiemieme 'ɨkwa witsimu'ɨa meta tɨriku mawariyari hetsiemieme meta hatseiti mɨtiyupata. Metatsiere 'ixuriki tukita ti'ɨwiyame kanihɨkɨtɨkamɨkɨ meta naitɨ muwa mɨtiyepine».   
\p
\v 17 Yawé Muitsexi 'Aruni mame mɨpaɨ katiniwarutahɨawe:  
\v 18 «Kuhati hetsie memɨyekɨ xekeniwa'ɨwiyani para Rewi nuiwarimama memɨkaheuyewautsenikɨ.  
\v 19 Kepauka 'ahurawa memɨkɨkanitsie mɨtimaiwetɨka hetsie, memɨkakukukuwenikɨ mɨpaɨ xekateniyuriekakuni: 'Aruni yuniwema wahamatɨa mekaniwaranayexeiyakuni, yuxexuime kememɨteyurieka meta memɨte'anɨtɨnikɨ.  
\v 20 Peru kuhatitsixi mepɨkatetixexeiyani piinite mɨtimaiwetɨka 'etsiwa tɨma, kapa me'ukwinikɨ».   
\s1 Kerutsunitsixi kememɨte'uximayata  
\p
\v 21 Merikɨte Yawé Muitsexi 'Aruni mame mɨpaɨ katiniwarutahɨawe:  
\v 22 «Xekeniwaraka'utɨata Keritsuni nuiwarimama, wanuiwarima yunaime xewa'inɨatatɨ kememɨyupapaɨme.  
\v 23 Yunaime xekeniwaraka'utɨa xeitewiyari heimana tamamata wiyari huteikɨ meheutiyuneme, huta tewiyari heimana tamamata wiyari me'uti'akame 'ukitsi 'aixɨa memɨ'anene 'ixuriki tukiyarita memɨte'uximayakakɨ.   
\p
\v 24 »Keritsuni nuiwarimama tetɨkɨmete mehɨritɨarietɨ mekateni'uximayakakuni.  
\v 25 'Ixuriki tukiyaritsie timieme xepɨte'anutɨni, memayutixexeɨriwa heima manukawerire, ketsɨ 'amɨpa nawiyarieya manukawerire heimana meta 'ixuriki mɨrewatixaxatsiwa memanutakɨkatsie meuwie.  
\v 26 'Ixuriki kuraruyari takwa maka meta 'ixuriki meuwɨ kuraru kitenieyaritsie mepɨte'anutɨni meta takwa mieme maka, yaxeikɨata tinaime muwa mɨtiyukumaɨwa kɨmana mɨrakuwɨwɨre memɨtekumaɨwakai.  
\v 27 'Ikɨ naitɨ 'uximayatsika memɨte'anɨtɨnikɨ mɨtiyukumaɨwa, yatɨni 'ixuriki tukita xɨka meteta'uximayatakuni, 'Aruni meta niwemama wahetsɨa xeikɨa xekaniyɨwawekuni. Mɨkɨ xeikɨa yamehaitɨkaikaku pɨyɨweni mɨranutɨkieni.  
\v 28 Kepauka memɨte'uximayaka Keritsuni nuiwarimama 'ixuriki tukiyari memayutixexeɨriwatsie, 'Itamaxi 'Aruni nu'aya mawari wewiwame kaniwataxeiyakamɨkɨ.   
\s1 Meraritsixi kememɨte'uximayakai  
\p
\v 29 »Xekeniwaraka'utɨa Merari xiuyarimama, wanuiwarima yunaime xewa'inɨatatɨ kememɨyupapaɨme.  
\v 30 Yunaime keniwaraka'utɨa xeitewiyari heimana tamamata wiyari memexeiyatɨka huteikɨ meutiyune meta huta tewiyari heimana tamamata wiyari me'uti'akame, 'ukitsi memɨyɨwawe 'ixuriki tukiyarita memɨte'uximayakakɨ.  
\v 31 Mɨkɨ mekanihɨritɨariekaitɨni memɨtetimɨwanikɨ, tatsɨari tukitsie mɨranuyehipite, mexa hetsiena ma'uni, meta muka'utɨka meta tinaime muwa mɨtiyepine mɨtiyukumaɨwa,  
\v 32 yaxeikɨata takwa warita ma'utɨyeika, muka'uwe, manukuhipite meta kɨmana mahɨaretɨyeika naime tita mɨtiyɨkɨmaɨwa waɨkawa mɨreuyewetse. 'Ekɨ yapetiwakɨhɨawekaku kehepaɨ memɨteyurieka yuxexuitɨ tita memɨte'anutɨxɨani.  
\v 33 Merari nuiwarimama memɨte'uximayakatsie 'ixuriki tukita memayutixexeɨriwatsie, 'Itamaxi waxexeiyame pɨhɨkɨtɨni mawari wewiwame 'Aruni nu'aya».   
\s1 Kuhati maremama kememɨte'uti'inɨatsie  
\p
\v 34 Muitsexi 'Aruni hamatɨa meta 'ukirawetsixi memanuyetei, Kuhati nuiwarimama mekaniwaruti'inɨata kememɨyupapaɨme.  
\v 35 Mekanaka'utsieni yunaitɨ xeitewiyari heimana tamamata wiyari meutiyune meta huta tewiyari heimana tamamata wiyari me'uti'atɨ, 'aixɨa memɨ'anene 'ixuriki tukiyarita memɨte'uximayakakɨ.  
\v 36 Yunaitɨ me'inɨaritɨ mɨkɨ nuiwari mekanakɨne huta miriyari heimana 'atahuta tsienituyari heimana huta tewiyari heimana tamamata (2.750) 'ukitsi.  
\v 37 Mɨpaɨ meyupaɨmetɨ mekanakɨne Kuhati nuiwarimama memɨte'uximayakakɨ 'ixuriki tukita, memɨwaruti'inɨataxɨ Muitsexi meta 'Aruni, Yawé kemɨtiwaruta'aitɨakai.   
\s1 Keritsuni nuiwarimama kememɨte'aka'utɨarie  
\p
\v 38 Mekanaka'utsieni Keritsuni maremama kememɨyupapaɨmekai nuiwari.  
\v 39 Mekanaka'utsieni yunaitɨ xeitewiyari heima tamamata wiyari meheutiyunetɨ meta huta tewiyari heimana tamamata wiyari me'uti'atɨ 'aixɨa memɨ'anene 'ixuriki tukiyarita memɨte'uximayakakɨ.  
\v 40 Yunaitɨ me'inɨaritɨ mɨkɨ nuiwari mekanakɨne huta miriyari heimana 'ataxewime tsienituyari heimana xeitewiyari heimana tamamata (2.630) 'ukitsi.  
\v 41 Mɨpaɨ yupaɨmetɨ mekanakɨne Keritsuni maremama 'ixuriki tukita memɨteta'uximayata, Muitsexi kememɨtewaruti'inɨataxɨ 'Aruni hamatɨa, Yawé kemɨtiwaruta'aitɨa.   
\s1 Merari maremama kememɨte'uti'inɨatsie  
\p
\v 42 Merari xiɨyarimama mekanaka'utsieni kememɨyupapaɨmekai nuiwarite.  
\v 43 Yunaitɨ mekanaka'utsieni 'ukitsi xeitewiyari heimana tamamata wiyari meutiyune meta huta tewiyari heimana tamamata wiyari me'uti'atɨ, 'aixɨa memɨ'anene 'ixuriki tukiyarita memɨte'uximayakakɨ.  
\v 44 Yunaitɨ me'inɨaritɨ mekanakɨne haika miriyari heimana huta tsienituyari (3.200) 'ukitsi.  
\v 45 Mɨpaɨ meyupaɨmetɨ mekanakɨne memaka'utsie Merari nuiwarimama, Muitsexi meta 'Aruni kememɨtewaraka'utɨa, Yawé kemɨtiwaru'aitɨakai.   
\s1 Kememɨte'unɨ  
\p
\v 46 Muitsexi meta 'Aruni hamatɨa, meta memanuyetei 'ixaheritsixi mekaniwaruti'inɨata rewitsixi kehepaɨ memɨte'ununuiwaxɨ kemɨ'ane memɨtehanuiwari.  
\v 47 Yunaitɨri me'inɨaritɨ 'ukitsi xeitewiyari heimana tamamata mehautiyunetɨ meta huta tewiyari heimana tamamata me'uti'atɨ 'aixɨa memɨ'anene 'ixuriki tukiyarita memɨte'uximayakakɨ meta memɨte'anutɨnikɨ,  
\v 48 mekanakɨne 'atahaika miriyari heimana 'auxɨwime tsienituyari heimana nauka (8.580) tewiyari.  
\v 49 Yawé, Muitsexi kemɨtiutahɨawixɨ, yuxexuitɨ yamekateniuta'aitɨarieni kememɨteyuriekakekai meta tita memɨte'utitɨkɨnikekai.  
\p Mɨpaɨ mekatenaka'utsieni Yawé Muitsexi kemɨtiuta'aitɨakai.   
\c 5  
\s1 Memakuteitsie kememɨte'itiyaka  
\p
\v 1 Hikɨ Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 2 «'Ixaheritsixi mɨpaɨ ketiniwaruta'aitɨa kemɨ'ane kati'itiyakame mɨtimayɨani haiya yunawiyaritsie memexeiyatɨka yuhetsɨa memɨwarayenɨ'anikɨ, yatɨni timɨkime mɨtiumayɨani, yatɨni mikumayɨa xeime pɨniya 'uhanitsitɨakame.  
\v 3 Tsepanetɨ 'ukitsi meta memɨ'ukari, xemakuteitsie pekaniwarayenɨ'amɨkɨ, para memɨkaxewiriekakɨ mana xemakuteitsie xeme neteɨterima».  
\v 4 Hikɨ mɨpaɨ mekateniuyurieni 'ixaheritsixi memakuteitsie mekaniwarayenɨ'ani, Yawé Muitsexi kemɨrehɨawekai ti'aitɨatɨ.   
\s1 Kemɨranuyeyani 'axatiuyurieme  
\p
\v 5 Yawé Muitsexi mɨpaɨ katiniuta'aitɨani  
\v 6 'ixaheritsixi mɨpaɨ mɨtiwatahɨawekɨ: «Kemɨ'ane 'uki yatɨni 'uka, yu'iwa 'axamuyuri yatɨni mɨtinawatsiri, ne Yawé nehɨxie 'axakatiniuyurieni 'ayumieme yukɨmana katinayukatuamɨkɨ.  
\v 7 Kaniyutahekɨatamɨkɨ ke'axamɨtiuyuri, meta katinekapitɨamɨkɨ kemɨ'ane 'axamuyuri 'auxɨwimexɨa 'anamanekame kaniyetuiriemɨkɨ.  
\v 8 Peru xɨka mɨyamɨranuyetɨa 'iwamama me'umaweni, mɨtiyetuiyani Yawé hetsiemieme katinayeimɨkɨ mawari wewiwame katiniyetuiriyariemɨkɨ, muxa 'uki heutinɨkame mɨtimawarienikɨ 'axamɨtiuyurikɨ.  
\v 9 Naitɨ mawari 'ixaheritsixi memiyetuaya mawari wewiwame hetsɨa mɨkɨ hetsiena mieme katinihɨkɨtɨni.  
\v 10 Kemɨ'ane yɨkɨmana mɨtiupata mɨkɨ katinihetsienamiemeyaritɨni, peru mawari wewiwame tita mutiyetuiriyarɨwa katinipiinieyatɨni».   
\s1 'Inɨari 'ɨtetsarika hetsiemieme  
\p
\v 11 Yawé Muitsexi mɨpaɨ katiniuta'aitɨani  
\v 12 'ixaheritsixi mɨpaɨ mɨtiwatahɨawekɨ: «'Inɨarikɨ tetekuxatatɨ, xewitɨ 'uka 'aixɨa tiwikietɨtɨ xaɨtsie kaneukuyune yɨkɨna 'aixɨa 'iyari kapawitɨkɨkai  
\v 13 xeime hamatɨa hunetɨ, 'inɨarikɨ tetekuxatatɨ kename kahahekɨa mɨyamɨyɨane, mɨkɨ 'awie mukahuikɨ, meta xewitɨ mɨkarakumatekɨ memɨka'uxeiyariekɨ mɨpaɨmeyɨatɨ.  
\v 14 Xɨka kɨnaya 'ɨtetsarikaya hetsiena ye'ani mɨpaɨ retimani kename 'ɨyaya mayɨiya, tsepa mɨka'ukumayɨiya,  
\v 15 hikɨ nenuwitɨmɨkɨ mawari wewiwame hetsɨa, harina tsewarayari huta kiruyari kanitimawamɨkɨ hetsienamieme. Mawarika hetsie hatseiti pɨkaheutitu'ani meta 'ɨkwa witsimu'ɨa, 'ɨtetsarika hetsiemieme mɨtiyɨanekɨ, hatsi mawarikayari 'axamɨti'ane mɨtihekɨarekɨ.   
\p
\v 16 »Mawari wewiwame Yawé hɨxie 'ukaratsi kananuwitɨmɨkɨ,  
\v 17 haa mɨpatsie tekɨxita kaniukatuamɨkɨ, 'etsiwata kwie kaniukawiwimɨkɨ tukita mieme.  
\v 18 Hikɨ Yawé hɨxie kanenuwitɨmɨkɨ, kɨpaya kanikuxɨnamɨkɨ, 'iyaritɨarika mawariyari katinipitɨamɨkɨ, mawari wewiwame mexi tekɨxi 'ahana 'axamɨ'ane matsiwi muyema.  
\v 19 Hikɨ mawari wewiwame 'uka yurikɨ mɨpaɨ katinitahɨawimɨkɨ: “Xɨka 'akɨna matsi'awitɨkɨkaku xeime hamatɨa pekakahuiweni, xɨka 'axamɨ'ane peka'anukuweiyaweni, 'ikɨ haa matsiwi 'axamɨ'itɨarie 'atsipɨkamatsiyurieni.  
\v 20 Peru xɨka 'akɨna pehexeiyatɨtɨ pe'iku'eirieni, 'axapekani'ayurieni 'akɨmana xeime pɨta hamatɨa 'uki pehuimɨtɨ  
\v 21 —'ena mawari wewiwame 'ukaratsi yurikɨ yakatinitahɨawimɨkɨ—, Yawé, 'ahetsie 'axamɨti'ane ke'ukawiwieni kemaine 'ahetsiemieme, pekaniweweme kematsi'ayeitɨani, 'aniweyame ke'utahani.  
\v 22 Kepauka 'ikɨ haa pemanuhareni, 'ahuka ke'utahairiya, pekaniweweme kematsi'ayeitɨani”. 'Ukaratsi mɨpaɨ ke'utayɨni: “'Aixɨa pɨ'ane. Mɨpaɨ ketiɨyɨni kemɨtinake”.   
\p
\v 23 »Mawari wewiwame 'ikɨ 'axamɨ'ane xapatsie kaneka'utɨamɨkɨ, haa matsiwi 'ukaratsi menuhareni 'aixɨa katiniyurimɨkɨ.  
\v 24 Hikɨ 'ukaratsi haa matsiwi kana'itɨamɨkɨ hetsiena mɨkayunekɨ waɨkawa mɨtikwinitɨanikɨ.   
\p
\v 25 »Mawari wewiwame mawarika katinanupimɨkɨ 'ɨtetsarika hetsiemieme. Katinitimawamɨkɨ Yawé hɨxie mawari matitaiyarɨwatsie,  
\v 26 xeimamayari kananatitɨkimɨkɨ hatsi mititaiyakɨ mawari taiyametsie Yawé me'eriwanikɨ. 'Anakeri 'ukaratsi haa kananu'itɨamɨkɨ.  
\v 27 Kepauka mɨkɨ haa manuhareni 'axamɨ'itɨarie, xɨka yukɨna 'aixɨa 'iyari kahawitɨkɨkaitɨni, hukaya kanitahaimɨkɨ kaniwewetɨ kanayeimɨkɨ. Mɨpaɨ mɨkɨ katinikwinitɨariemɨkɨ hipame wahɨxie.  
\v 28 Xɨkata hawaikɨ mɨpaɨ ka'utiyɨni, xɨka 'aixɨa tiuyeikakaitɨni, 'ana mɨkɨ 'atsipɨkayɨni, tiniweyatɨ kanayeimɨkɨ.   
\p
\v 29 »'Ikɨ 'inɨari kanihɨkɨtɨni 'ɨtetsarika hetsiemieme, kepauka 'ukaratsi yukɨna mɨnanaimani, 'axakaniyuyurimɨkɨ yɨkɨmana xeime hamatɨa pɨta mɨkahuikɨ,  
\v 30 kepauka kɨnaya 'ɨtetsarika hexeiyatɨ mayani meta yu'ɨya mɨtixeɨmani. Mawari wewiwame 'ukaratsi Yawé hɨxie 'enuwitɨme 'ikɨ 'inɨari kaniwewiriemɨkɨ kemɨre'uxa.  
\v 31 Kɨnaya tixaɨtɨ hetsiena pɨkarahɨiyani, 'ukaratsi hɨrixɨa tiuka'eniwatɨ kanayeimɨkɨ mɨya mɨtiuyurikɨ».   
\c 6  
\s1 'Aitsika memɨyɨhɨritɨa wahetsiemieme  
\p
\v 1 Yawé Muitsexi katiniuta'aitɨani  
\v 2 'ixaheritsixi mɨpaɨ mɨtiwatahɨawekɨ: «Xɨka xewitɨ 'uki yatɨni 'ukaratsi natsareyukɨ yɨhɨritɨamɨkɨni, Yawé hɨxie yake'utayɨni,  
\v 3 mɨkɨ kaxie winuyari pɨkaye'eni matsiwi meta kwinimieme mɨratsiwi. Meta hipame winu, kaxie hayari, kaxie takariyari mɨpatsarutsietɨka pɨkakwa'ani.  
\v 4 Mexi kexemɨte'uxa 'areutewini natsareyu hepaɨ, kaxie takariyari xepɨkakwa'ani meta kararayari hatsiyari nitɨma.   
\p
\v 5 »Mexi 'areutewini Yawé hetsiemieme patsietɨ, tatsɨari natsareyu hepaɨ pɨtimatsiɨkɨni, yaxeikɨata pɨka'ikaxikani yukɨpa matsi kanihayewakamɨkɨ mɨtiwawerekɨ meta puyukweriwayurieka 'itiyatɨ.   
\p
\v 6 »Kepauka mɨpaɨ 'anetɨ muyeikani Yawé hɨxie, mɨki manukatsie 'ahurawa pɨka'uyeikani,  
\v 7 tsepa paapaya, maamaya, mutaya, kurieya memukwi. Mɨkɨ wahekɨ ka'iyatɨ pɨkahayuyeitɨwani, matsi mɨpaɨ pɨkayɨaneni Yawé 'inɨarieya mexeiyakɨ yumu'utsie.  
\v 8 Kepauka patsietɨ 'amuyeikani Yawé hetsiemieme, yu'itietɨ kaniuyeikamɨkɨ patsietɨ.   
\p
\v 9 »Xɨka 'atsikara'eriwakaku xewitɨ 'auriena 'umɨni, yumu'utsie kemɨtipatsiekai mɨpaɨ ka'anetɨ kanayeimɨkɨ, 'atahuta tukari heutineyu, kepauka mɨ'itiyanitsie, 'ana naime yumu'utsie kaniyukaximɨkɨ.  
\v 10 'Atahaika tukari heutineyu yuhutame kukuruxi kaniwaranɨtɨkimɨkɨ yatɨni haɨmɨxi, mawari wewiwame kaniyetuiriemɨkɨ 'ixuriki tukiyari mɨranutahakitɨretsie muka memayutixexeɨriwatsie.  
\v 11 Mɨkɨ xeime mawari wewiwame kanitimawamɨkɨ 'itiya mawariyari meta hipame mawari taiyariyari mɨhɨkɨtɨnikɨ. 'Ana mawari wewiwame natsareyu patsiekame kaneyeitɨamɨkɨ, 'ikɨ 'axamɨtiuyurikɨ mɨki 'umayɨaka. 'Ana mɨkɨ tukaritsie natsareyu pɨ'itiyani yumu'utsie,  
\v 12 'axakemɨtiyurienekai natsareyu Yawé hɨxie 'aixɨa pɨyɨyuriekai muxatsi warehapanatɨ xeiwiyari mehɨtɨkaime mawariwewietɨ mɨkɨkɨ mɨreuyehɨwiyariekakɨ. 'Ayumieme pɨkanaki'eriwani meripai mieme matsi puhayewariekairi 'aixɨa mɨka'uyuyurikɨ mana pɨtiuyu'a.   
\p
\v 13 »'Ikɨ 'inɨari natsareyu hetsiemieme kanihɨkɨtɨni kepauka manutinetɨarieni patsietɨ. Nanuwitɨkiemɨkɨ tuki kitenieyaritsie,  
\v 14 mana katinitimawamɨkɨ kanitataiyamɨkɨ muxa Yawé hetsiemieme xeiwiyari hɨkame katikuyeme, meta xeime muxa 'ukitɨme 'itiya mawariyari mayanikɨ, meta 'aixɨa memɨteyuxeiyanikɨ mawariyari.  
\v 15 Meta kanitimawamɨkɨ xeitsikɨiwitiyari paa mɨkakuxanariyarietɨka, meta tɨriku mɨtɨxiyari 'aixɨa mɨ'ane pɨhɨkɨtɨni wiyamatɨkaitɨ, tsuiraxi kakuxanariyarietɨkaime wiyamatɨkaime xeikɨa meta hatsite mawariyari, metatsiere kaxie winuyari mɨtiyeuriwa yɨnɨkame.   
\p
\v 16 »Hikɨ mawari wewiwame Yawé hɨxie kanitimawamɨkɨ, mawarika mɨreuyehɨwiyarienikɨ, mawarika taiyariyari natsareyu hetsiemieme.  
\v 17 Muxa 'uki kanitimawamɨkɨ Yawé hetsiemieme 'aixɨa memɨteyuxeiyanikɨ mawariyari mayanikɨ, paa xeitsikɨiwitiyari hamatɨa. Meta hatsite kanitimawamɨkɨ metatsiere kaxie winuyari mɨtiyeuriwa yɨnɨkame.   
\p
\v 18 »Hikɨ tuki kitenie memayutixexeɨriwatsie natsareyu kaniyukaximɨkɨ yumu'utsie. Yukɨpa mupatsietɨka, taipa kaneuwiwimɨkɨ 'aixɨa memɨteyuxeiyanikɨ mawariyari mataiyarietsie.   
\p
\v 19 »'Ariri natsareyu yukaxiyu, mawari wewiwame paa kananatituimɨkɨ tsikɨiwititsie mɨkakuxanariyarie meta muxa 'uki naiparieya, mɨkɨ naime natsareyu katinipitɨamɨkɨ,  
\v 20 'anaketa naime Yawé hɨxie pekaniyuitɨwamɨkɨ mawarika hepaɨ. Naitɨ katinipatsieka mawari wewiwame hetsiemieme katinihɨkɨtɨni, naitɨ tawitsiemieme, teurite kɨmana mɨrayukatuiya. Mɨpaɨ tiyurieme naime natsareyu winu manu'ieni kaniyɨweni.   
\p
\v 21 »'Ikɨ 'inɨari kani'ayumiemetɨni kemɨ'ane natsareyukɨ mɨyɨhɨritɨani. 'Ikɨ naime mawarika katiniwewimɨkɨ Yawé hetsiemieme natsareyu hetsiemieme meta kaniyɨweni tita mɨtiyetuani ketita mɨrexeiyani. 'Inɨari kemaine natsareyu hetsiemieme, xɨka natsareyu yuyeitɨamɨkɨni kaneye'atɨamɨkɨ kemaine».   
\s1 Mawari wewiwamete hipame 'aixɨa memɨwayurienikɨ  
\p
\v 22 Yawé Muitsexi mɨpaɨ katiniuta'aitɨani:  
\v 23 «Mɨpaɨ ketiniwarutahɨawi 'Aruni meta niwemama, 'ixaheritsixi 'aixɨa memɨwayuriekakɨ 'ikɨ niukikɨ:   
\q1
\v 24 »“Yawé kematsi'ɨwiyani  
\q2 'ahamatɨa ke'uyeikani,   
\q1
\v 25 Yawé 'aixɨa kematixeiyani  
\q2 yunaki'eriya kematsipitɨaka,   
\q1
\v 26 Yawé kematsiparewieka  
\q2 kayuwatɨ kematsipitɨaka”.   
\p
\v 27 »Mɨpaɨ xeputiyuaneni kenemɨtitewa 'ixaheritsixi watsata, yurikɨ ne neheyemekɨ nemɨxe'ɨwiyanikɨ».   
\c 7  
\s1 'Imikierite 'ixuriki tukiyarita timieme memɨteyetua  
\p
\v 1 Muitsexi kepauka tuki munɨ, 'aixɨa kaniyurieni naime katiniuti'ɨya hatseitikɨ muwa mɨtiyepine. Metatsiere mawari taiyame 'aixɨa kaniuyurieni meta naime muwa mɨrakapine.  
\v 2 Hikɨ 'Ixaheri nuiwarimamatsie yuxexuime memanuyetei, memɨwaruka'utɨakai, kememɨteyɨwawe mekateniyetuani wanuiwarima yunaitɨ mɨkɨ 'imikierite.  
\v 3 Tukita paitɨ mekatenetɨni Yawé hɨxie memɨteheyetuanikɨ. Yuhuhutakatɨ memanuyetei xeikaxetayaritsie mekatenetɨni, yuxexuitɨta tuurutsixi mekaniwayetuaxɨani, yunaitɨ 'ataxewi kaxetate 'anukanatɨkaitɨ meta tamamata heimana huta tuurutsixi mekanakɨne.   
\p
\v 4 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 5 «'Ikɨ mawarite 'ahetsie katinimiemetɨni memɨmeteyetuiriwa 'ahetsie ketinehɨka, mɨtikumayɨiyanikɨ mɨtiwakumayɨiwatsie 'ixuriki tukiyari hetsiemieme. 'Ekɨ rewitsixi pekaniwayetuiriemɨkɨ, yuxexuitɨ kememɨte'uximaya 'uximayatsika hepaɨtsita».   
\p
\v 6 Hikɨ Muitsexi kaxetate meta tuurutsixi katiniyetuiriyarieni, mɨkɨta rewitsixi kaniwayetuirieni.  
\v 7 Keritsuni nuiwarimama hutame kaxetate mekaniuhapatɨarieni meta yunaukame tuurutsixi, memɨtehauyehɨakaikɨ yu'uximayatsika hepaɨtsita.  
\v 8 Meraritsixi yunaukame kaxetate mekaniuhapatɨarieni meta tuurutsixi 'atahaikame, mɨreuyewekaikɨ wa'uximayatsikatsie. 'Aruni mawari wewiwame nu'aya 'Itamaxi yunaime mɨkɨ katiniwa'aitɨakaitɨni.  
\v 9 Kuhatitsixi tixaɨtɨ mepɨkateyetuiriyarie, mɨkɨ memɨhɨritɨariekaikɨ memɨteheutɨtɨkanikɨ yuwaritsie piinite naime mɨti'itiyatɨka.   
\s1 Mawari taiyame hetsiemieme mawarika  
\p
\v 10 Kepauka mawari taiyame 'aixɨa mu'itɨarie, 'ixaheritsixi wa'ukiyarima mawari muwa mekaniyetuani,  
\v 11 Yawé Muitsexi mɨpaɨ mɨtikɨhɨawekaikɨ: «Mawari memɨyetuayanikɨ mawari taiyame hetsiemieme, yuxexuitɨ wa'ukiyarima xexuime tukaritsie mekateniyuriekakuni».   
\s1 Kura mawarikaya  
\p
\v 12 Mexɨakame tukaritsie mɨtitimawakɨ Nahatsuni kananayexeiyarieni 'Aminarawi nu'aya, Kura xiɨyarieya.   
\p
\v 13 'Ikɨ hatsite 'imikieriyari, pɨrata xakɨyari 'amatikuni katiniyetuani meta xeime pɨrata pateyuyari, mɨkɨtsie tɨriku mɨtɨxiyari 'aixɨa mɨ'ane pɨhɨpɨnekai hatseitikɨ pɨnariekame. Kemɨti'inɨatakai tuki xakɨ 'amatikuni xeikiruyari heimana 'imeriyu katinahetekaitɨni meta pateyu 'atahaika tsienituyari kɨramuyari rahetetɨ.   
\p
\v 14 Meta xeime pateyu yakɨmɨpe hurukɨ mɨwewiya kaniyetuani, xeitsienituyari heimana tamamata kɨramuyari katinahetekaitɨni, 'ɨkwa witsimu'ɨa hɨneme.   
\p
\v 15 Mawari taiyariyari hetsiemieme, tsikeru xeiwiyari hɨkame kaniyetuani, xeime muxa 'uki meta xeime muxa xeiwiyari hɨkame.   
\p
\v 16 Mɨreuyehɨwiyarienikɨ, xeime tsipu 'ukitɨme kaniyetuani mawari mayanikɨ.   
\p
\v 17 'Aixɨa memɨteyuxeiyanikɨ mawariyari, yuhutame tuurutsixi kaniwayetuani, yu'aɨxɨwimeta muxatsi 'ukitsi, meyu'aɨxɨwime tsipuri 'ukitsi meta meyu'aɨxɨwime muxatsi xeiwiyari memɨhɨtɨka.  
\p Nahatsuni 'Aminarawi nu'aya 'ikɨ mawarikaya kanihɨkɨtɨni.   
\s1 'Itsakaxi mawarikaya  
\p
\v 18 Hutarieka tukaritsie Natanaheri Tsuhaxi nu'aya mawari mɨwewienikɨ kananayexeiyarieni, 'Itsakaxi xiɨyarieya wa'ukiyari.   
\p
\v 19 Hatsite mɨtitimawarienikɨ, katiniyetuani pɨrata xakɨ 'amatikuni meta pɨrata pateyuyari hɨpɨneme tɨriku mɨtɨxiyari 'aixɨa mɨ'ane pɨnarietɨ hatseitikɨ. Kemɨti'inɨatakai tuki, xakɨ 'amatikuni xeikiruyari heimana 'imeriyu katinahetekaitɨni, meta pateyu 'atahaika tsienituyari kɨramuyari katinahetekaitɨni.   
\p
\v 20 Metatsiere xeime pateyu yakɨmɨpe hurukɨ mɨwewiya kaniyetuani xeitsienituyari heimana tamamata kɨramuyari raheteme, 'ɨkwa witsimu'ɨa hɨneme.   
\p
\v 21 Mawari taiyariyari hetsiemieme, tsikeru xeime kaniyetuani, xeimeta muxa 'uki meta muxa xeiwiyari hɨkame.   
\p
\v 22 'Itiya mawariyari hetsiemieme, xeime tsipu 'ukitɨme kaniyetuani.   
\p
\v 23 'Aixɨa memɨteyuxeiyanikɨ mawariyari, yuhutame tuurutsixi kaniwayetuani, meta yu'aɨxɨwime muxatsi 'ukitsi kaniwayetuani, yu'auxɨwimeta tsipuri 'ukitsi meta yu'aɨxɨwime muxatsi xeiwiyari memɨhɨtɨka kaniwayetuani.  
\p 'Ikɨ Natanaheri mawarieya kanayani Tsuhaxi nu'aya.   
\s1 Tsawuruni mawarikaya  
\p
\v 24 Hairieka tukaritsie 'Eriyáwi Heruni nu'aya kananayexeiyarieni mɨtitimawakɨ, Tsawuruni xiɨyarimama wa'ukiyari.   
\p
\v 25 Hatsite mɨtitimawakɨ, katiniyetuani pɨrata xakɨyari 'amatikuni meta xeime pɨrata pateyuyari, hɨneme tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ pɨnariekame. Kemɨti'inɨatakai tuki xakɨ 'amatikuni xeikiruyari heimana 'imeriyu katinahetekaitɨni, meta pateyu 'atahaika tsienituyari kɨramuyari katinahetekaitɨni.   
\p
\v 26 Metatsiere xeime pateyu yakɨmɨpe hurukɨ mɨwewiya kaniyetuani, xeitsienituyari heimana tamamata kɨramuyari katinahetekaitɨni, 'ɨkwa witsimu'ɨa hɨneme.   
\p
\v 27 Mawari taiyariyari hetsiemieme, xeime tsikeru kaniyetuani, xeimeta muxa 'ukitɨme meta xeime muxa xeiwiyari hɨkame.   
\p
\v 28 'Itiya mawariyari hetsiemieme, xeime tsipu 'uki kaniyetuani.   
\p
\v 29 'Aixɨa memɨteyuxeiyanikɨ mawariyari, yuhutame tuurutsixi kaniwayetuani, yu'aɨxɨwime muxatsi 'ukitsi, yu'auxɨwimeta tsipuri 'ukitsi meta meyu'auxɨwime muxatsi xeiwiyari mehɨtɨkaime kaniwayetuani.  
\p 'Ikɨ 'Eriyáwi mawarikaya kanihɨkɨtɨni Heruni nu'aya.   
\s1 Xuweni mawarikaya  
\p
\v 30 Naurieka tukaritsie 'Eritsuxi kananayexeiyarieni mutitimawakɨ Tserehuxi nu'aya, Xuweni xiɨyarimama wa'ukiyari.   
\p
\v 31 Hatsite mawariyari, pɨrata xakɨyari 'amatikuni kaniyetuani meta xeime pɨrata pateyuyari, hɨpɨneme tɨriku mɨtɨxiyari hatseitikɨ pɨnariekame. Kemɨti'inɨatakai tuki, xakɨ 'amatikuni xeikiruyari heimana 'imeriyu katinahetekaitɨni, meta pateyu 'atahaika tsienituyari kɨramuyari katinahetekaitɨni.   
\p
\v 32 Meta xeime pateyu yakɨmɨpe hurukɨ mɨwewiya kaniyetuani, xeitsienituyari heimana tamamata kɨramuyari raheteme, 'ɨkwa witsimu'ɨa hɨneme.   
\p
\v 33 Mawari taiyariyari hetsiemieme, tsikeru xeime kaniyetuani, xeimeta muxa 'uki meta xeime muxa xeiwiyari hɨkame.   
\p
\v 34 'Itiya mawariyari hetsiemieme, xeime tsipu 'ukitɨme kaniyetuani.   
\p
\v 35 'Aixɨa memɨteyuxeiyanikɨ mawariyari hetsiemieme, yuhutame tuurutsixi kaniwayetuani, meta yu'aɨxɨwime muxatsi 'ukitsi meta yu'aɨxɨwime tsipuri 'ukitsi meta meyu'aɨxɨwime muxatsi xeiwiyari mehɨtɨkaime kaniwayetuani.  
\p 'Eritsuxi Tserehuxi nu'aya 'ikɨ mawarieya kanihɨkɨtɨni.   
\s1 Tsimehuni mawarikaya  
\p
\v 36 'Auxɨwirieka tukariyaritsie kananayexeiyarieni Tserumieri Tsuritsarahi nu'aya mɨtitimawakɨ, Tsimehuni xiɨyarimama wa'ukiyari.   
\p
\v 37 Hatsite mawariyari, xeime pɨrata xakɨyari 'amanukuyewa kaniyetuani meta xeime pɨrata pateyuyari, hɨpɨneme tɨriku mɨtɨxiyari hatseitikɨ pɨnariekame. Kemɨti'inɨatakai tuki, xakɨ 'amatikuni xeikiruyari heimana 'imeriyu katinahetekaitɨni, meta pateyu 'atahaika tsienituyari kɨramuyari katinahetekaitɨni.   
\p
\v 38 Meta xeime pateyu yakɨmɨpe hurukɨ wewiyakame kaniyetuani, xeitsienituyari heimana tamamata kɨramuyari katinahetekaitɨni, 'ɨkwa witsimu'ɨa hɨneme.   
\p
\v 39 Mawari taiyariyari hetsiemieme, tsikeru xeime kaniyetuani, xeime muxa 'uki meta xeime muxa xeiwiyari hɨkame.   
\p
\v 40 'Itiya mawariyari hetsiemieme, xeime tsipu 'ukitɨme kaniyetuani.   
\p
\v 41 'Aixɨa memɨteyuxeiyanikɨ mawariyari hetsiemieme, yuhutame tuurutsixi kaniwayetuani, yu'aɨxɨwimeta muxatsi 'ukitsi, meta yu'aɨxɨwime tsipuri 'ukitsi meta muxatsi meyu'aɨxɨwime xeiwiyari mehɨtɨkaime.  
\p 'Ikɨ kanihɨkɨtɨtɨni Tserumieri mawarikaya Tsuritsarahi nu'aya.   
\s1 Kahari mawarikaya  
\p
\v 42 'Ataxewirieka tukaritsie kananayexeiyarieni 'Eriyatsati Rehuheri nu'aya mɨtitimawakɨ, Kahari xiɨyarimama wa'ukiyari.   
\p
\v 43 Hatsite mawariyarikɨ, pɨrata xakɨyari 'amanukuyewa meta xeime pɨrata pateyuyari kaniyetuani, hɨpɨneme tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ pɨnariekame katiniyetuani. Kemɨti'inɨatakai tuki, xakɨ 'amatikuni xeikiruyari heimana 'imeriyu katinahetekaitɨni, pateyuta 'atahaika tsienituyari kɨramuyari katinahetekaitɨni.   
\p
\v 44 Meta xeime pateyu yakɨmɨpe hurukɨ wewiyakame kaniyetuani, xeitsienituyari heimana tamamata kɨramuyari raheteme, 'ɨkwa witsimu'ɨa hɨneme.   
\p
\v 45 Mawari taiyariyari hetsiemieme, tsikeru xeime kaniyetuani, meta muxa 'uki meta xeime muxa xeiwiyari hɨkame kaniyetuani.   
\p
\v 46 'Itiya mawariyari hetsiemieme, xeime tsipu 'ukitɨme kaniyetuani.   
\p
\v 47 'Aixɨa memɨteyuxeiyanikɨ mawariyari hetsiemieme, yuhutame tuurutsixi, yu'aɨxɨwimeta muxatsi 'ukitsi, meta meyu'aɨxɨwime tsipuri 'ukitsi meta meyu'aɨxɨwime muxatsi xeiwiyari memɨhɨtɨka.  
\p 'Ikɨ kanihɨkɨtɨni 'Eriyatsati mawarikaya Rehuheri nu'aya.   
\s1 'Epɨrahini mawarikaya  
\p
\v 48 'Atahutarieka tukaritsie kananayexeiyarieni 'Eritsama mɨtitimawakɨ 'Amihuri nu'aya, 'Epɨrahini nuiwarimama wa'ukiyari.   
\p
\v 49 Hatsite mawariyarikɨ, xeime pɨrata xakɨyari 'amakuni meta xeime pɨrata pateyuyari katiniyetuani, hɨpɨneme tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ pɨnarietɨ. Kemɨti'inɨatakai tuki, pateyu xeikiruyari heimana 'imeriyu katinahetekaitɨni, meta xakɨ 'amakuni 'atahaika tsienituyari kɨramuyari pɨrahetekai meta pateyu 'atahaika tsienituyari kɨramuyari raheteme.   
\p
\v 50 Meta xeime pateyu yakɨmɨpe hurukɨ wewiyakame kaniyetuani, xeitsienituyari heimana tamamata kɨramuyari katinahetekaitɨni, 'ɨkwa witsimu'ɨa hɨneme.   
\p
\v 51 Mawari taiyariyari hetsiemieme, tsikeru xeime kaniyetuani, xeime muxa 'uki meta xeime muxa xeiwiyari hɨkame kaniyetuani.   
\p
\v 52 'Itiya mawariyari hetsiemieme, xeime tsipu 'uki kaniyetuani.   
\p
\v 53 'Aixɨa memɨteyuxeiyanikɨ mawariyari hetsiemieme, yuhutame tuurutsixi, meta yu'aɨxɨwime muxatsi 'ukitsi, meyu'aɨxɨwime tsipuri 'ukitsi meta meyu'aɨxɨwime muxatsi xeiwiyari mehɨtɨkaime kaniwayetuani.  
\p 'Ikɨ kanihɨkɨtɨni 'Eritsama mawarikaya 'Amihuri nu'aya.   
\s1 Manatsexi mawarikaya  
\p
\v 54 'Atahairieka tukaritsie kananayexeiyarieni Kamarieri mɨtitimawakɨ Peratsuxi nu'aya, Manatsexi nuiwarimama wa'ukiyari.   
\p
\v 55 Hatsite mawariyari, xeime pɨrata xakɨyari 'amakuni meta xeime pɨrata pateyuyari katiniyetuani, hɨpɨneme tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ pɨnariekame. Kemɨti'inɨatakai tuki, xakɨ 'amakuni xeikiruyari heimana 'imeriyu katinahetekaitɨni, pateyuta 'atahaika tsienituyari kɨramuyari katinahetekaitɨni.   
\p
\v 56 Meta xeime pateyu yakɨmɨpe hurukɨ wewiyakame kaniyetuani, xeitsienituyari heimana tamamata kɨramuyari katinahetekaitɨni, 'ɨkwa witsimu'ɨa hɨneme.   
\p
\v 57 Mawari taiyariyari hetsiemieme, tsikeru xeime, xeime muxa 'uki meta xeime muxa xeiwiyari hɨkame.   
\p
\v 58 'Itiya mawariyari hetsiemieme, xeime tsipu 'uki kaniyetuani.   
\p
\v 59 'Aixɨa memɨteyuxeiyanikɨ mawariyari hetsiemieme, yuhutame tuurutsixi kaniwayetuani, yu'aɨxɨwime muxatsi 'ukitsi, meyu'aɨxɨwimeta tsipuri 'ukitsi meta meyu'aɨxɨwime muxatsi xeiwiyari mehɨtɨkaime kaniwayetuani.  
\p 'Ikɨ kanihɨkɨtɨni Kamarieri mawarikaya Peratsuxi nu'aya.   
\s1 Wenikamini mawarikaya  
\p
\v 60 'Atanaurieka tukarietsie kananayexeiyarieni 'Awirani mɨtitimawakɨ Kereuni nu'aya, Wenikamini nuiwarimama wa'ukiyari.   
\p
\v 61 Hatsite mawariyari, xeime pɨrata xakɨyari 'amakuni meta xeime pɨrata pateyuyari katiniyetuani, hɨpɨneme tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ pɨnariekame. Kemɨti'inɨatakai tuki, xakɨ 'amakuni xeikiruyari heimana 'imeriyu katinahetekaitɨni, meta pateyu 'atahaika tsienituyari kɨramuyari raheteme.   
\p
\v 62 Meta xeime pateyu yakɨmɨpe hurukɨ wewiyakame kaniyetuani, xeitsienituyari heimana tamamata kɨramuyari raheteme, 'ɨkwa witsimu'ɨa hɨneme.   
\p
\v 63 Mawari taiyariyari hetsiemieme, tsikeru xeime, xeime muxa 'uki xeimeta muxa xeiwiyari hɨkame kaniwayetuani.   
\p
\v 64 'Itiya mawariyari hetsiemieme, xeime tsipu 'uki kaniyetuani.   
\p
\v 65 'Aixɨa memɨteyuxeiyanikɨ mawariyari hetsiemieme, tuurutsixi yuhutame kaniwayetuani, yu'aɨxɨwime muxatsi 'ukitsi, meyu'aɨxɨwime tsipuri 'ukitsi meta meyu'aɨxɨwime muxatsi xeiwiyari mehɨtɨkaime kaniwayetuani.  
\p 'Ikɨ kanihɨkɨtɨni 'Awirani mawarikaya, Kereuni nu'aya.   
\s1 Rani mawarikaya  
\p
\v 66 Tamamata tukaritsie kananayexeiyarieni 'Akihetsexi mɨtitimawakɨ 'Amitsarahi nu'aya, Rani nuiwarimama wa'ukiyari.   
\p
\v 67 Hatsite mawariyari, xeime pɨrata xakɨyari 'amatikuni meta xeime pɨrata pateyuyari, hɨpɨneme tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ pɨnariekame. Kemɨti'inɨatakai tuki, xakɨ 'amatikuni xeikiruyari heimana 'imeriyu raheteme, meta pateyu 'atahaika tsienituyari kɨramuyari raheteme.   
\p
\v 68 Meta xeime pateyu yakɨmɨpe hurukɨ wewiyakame kaniyetuani, xeitsienituyari heimana tamamata kɨramuyari raheteme, 'ɨkwa witsimu'ɨa hɨneme.   
\p
\v 69 Mawari taiyariyari hetsiemieme, xeime tsikeru, xeime muxa 'uki meta xeime muxa xeiwiyari hɨkame kaniwayetuani.   
\p
\v 70 'Itiya mawariyari hetsiemieme, xeime tsipu 'uki kaniyetuani.   
\p
\v 71 'Aixɨa memɨteyuxeiyanikɨ mawariyari hetsiemieme, yuhutame tuurutsixi, yu'aɨxɨwime muxatsi 'ukitsi, meyu'aɨxɨwimeta tsipuri 'ukitsi meta meyu'aɨxɨwime muxatsi xeiwiyari mehɨtɨkaime.  
\p 'Ikɨ kanihɨkɨtɨni 'Akihetsexi mawarikaya 'Amitsarahi nu'aya.   
\s1 'Atsexi mawarikaya  
\p
\v 72 Tamamata heimana xewi tukariyaritsie kananayexeiyarieni Pakieri mɨtitimawakɨ 'Ukɨrani nu'aya, 'Atsexi nuiwarimama wa'ukiyari.   
\p
\v 73 Hatsite mawariyari, xeime pɨrata xakɨyari 'amakuni meta xeime pɨrata pateyuyari katiniyetuani, hɨpɨneme tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ pɨnariekame. Tuki kemɨti'inɨatakai, xakɨ 'amakuni xeikiruyari heimana 'imeriyu katinahetekaitɨni, meta pateyu 'atahaika tsienituyari kɨramuyari raheteme.   
\p
\v 74 Meta xeime pateyu yakɨmɨpe hurukɨ wewiyakame kaniyetuani, xeitsienituyari heimana tamamata kɨramuyari raheteme, 'ɨkwa witsimu'ɨa hɨneme.   
\p
\v 75 Mawari taiyariyari hetsiemieme, tsikeru xeime, xeimeta muxa 'uki, meta xeime muxa xeiwiyari mehɨtɨkaime kaniwayetuani.   
\p
\v 76 'Itiya mawariyari hetsiemieme xeime tsipu 'uki kaniyetuani.   
\p
\v 77 'Aixɨa memɨteyuxeiyanikɨ mawariyari hetsiemieme, yuhutame tuurutsixi kaniwayetuani, yu'aɨxɨwime muxatsi 'ukitsi, meyu'aɨxɨwimeta tsipuri 'ukitsi meta meyu'aɨxɨwime muxatsi xeiwiyari memɨhɨtɨka.  
\p 'Ikɨ Pakieri 'Ukɨrani nu'aya mawarikaya kanihɨkɨtɨni.   
\s1 Nepɨtahari mawarikaya  
\p
\v 78 Tamamata heimana huta tukaritsie kananayexeiyarieni, 'Akira mɨtitimawakɨ 'Enahani nu'aya, Nepɨtahari nuiwarimama wa'ukiyari.   
\p
\v 79 Hatsite mawariyari, xeime pɨrata xakɨyari 'amakuni meta xeime pɨrata pateyuyari katiniyetuani, hɨpɨneme tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ pɨnariekame. Tuki kemɨti'inɨatakai, xakɨ 'amakuni xeikiruyari heimana 'imeriyu raheteme, meta pateyu 'atahaika tsienituyari kɨramuyari raheteme.   
\p
\v 80 Meta xeime pateyu yakɨmɨpe hurukɨ wewiyakame kaniyetuani, xeitsienituyari heimana tamamata kɨramuyari raheteme, 'ɨkwa witsimu'ɨa hɨneme.   
\p
\v 81 Mawari taiyariyari hetsiemieme, xeime tsikeru, xeimeta muxa 'ukitɨme meta xeime muxa xeiwiyari hɨkame kaniwayetuani.   
\p
\v 82 'Itiya mawariyari hetsiemieme, xeime tsipu 'uki kaniyetuani.   
\p
\v 83 'Aixɨa memɨteyuxeiyanikɨ mawariyari hetsiemieme, yuhutame tuurutsixi kaniwayetuani, yu'aɨxɨwimeta muxatsi 'ukitsi, meyu'aɨxɨwimeta tsipuri 'ukitsi meta meyu'aɨxɨwime muxatsi xeiwiyari mehɨtɨkaime.  
\p 'Ikɨ 'Akira 'Enahani nu'aya mawarikaya kanihɨkɨtɨni.   
\s1 Kemɨtiɨnɨrixɨ  
\p
\v 84 Mawarika mɨtiyetuiya 'ixaheritsixi wa'ukiyarima memuwewi kepauka mawari taiyame 'aixɨa mu'itɨarie, 'ikɨ katiniyetuiyani: Tamamata heimana huta pɨrata xakɨyari 'amɨpapa, tamamata heimana huta pɨrata pateyuyari meta tamamata heimana huta pateyu yakɨmɨpepe hurukɨ mɨwewiyatɨka.  
\v 85 Pɨrata xakɨyari 'amɨpapa xeikiruyari heimana 'imeriyu pɨrahetekai, meta pateyute 'atahaika tsienituyari kɨramuyari pɨrahetekai. Naitɨ pɨratakɨ mɨtiwewiyatɨka xeitewiyari heimana 'atahuta kiruyari katinahetekaitɨni, tuki kemɨti'inɨatakai.  
\v 86 Tamamata heimana huta pateyute yakɨmɨpepe hurukɨ mɨwewiyatɨka, 'ɨkwa witsimu'ɨa hɨpɨneme xeitsienituyari heimana tamamata kɨramuyari katinahetekaitɨni, tuki kemɨti'inɨatakai. Naitɨ pateyute yakɨmɨpepe hurukɨ muwewiyatɨka xeikiruyari heimana nauka tsienituyari kɨramuyari katinahetekaitɨni.  
\v 87 Tewaxi mawari taiyariyari hetsiemieme tamamata heimana huta tsikerutsixi, tamamata heimana huta muxatsi 'ukitsi, tamamata heimana huta muxatsi xeiwiyari memɨhɨtɨka, meta tamamata heimana huta tsipuri 'ukitsi mekanakɨne 'itiya mawariyari hetsiemieme, meta hatsite mawariyari.  
\v 88 Tewaxi 'aixɨa memɨteyuxeiyanikɨ mawariyari hetsiemieme xeitewiyari heimana nauka tuurutsixi mepakɨ, meta haika tewiyari muxatsi 'ukitsi meta tsipuri 'ukitsi haika tewiyari, meta haika tewiyari muxatsi xeiwiyari memɨhɨtɨka. 'Ikɨ mawarika kanayani kepauka mawari taiyame 'aixɨa memuyuritsie.   
\s1 Kakaɨyari teɨteri watsata kemɨtiuyuhekɨataxɨ  
\p
\v 89 Muitsexi kepauka 'ixuriki tukiyarita meutaha, Yawé hamatɨa mɨtitaxatakɨ, mana tɨratu kakuniyari heima Kakaɨyari teɨtametemama memana'utsie kanitahɨawe.   
\c 8  
\s1 Kɨxemete manu'utɨka hetsiemieme  
\p
\v 1 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 2 «'Aruni mɨpaɨ ketineutahɨawi: “Kepauka 'atahutame kɨxemete tatɨkaime pemanu'uitɨani, mɨkɨ kɨxeme 'uitɨwame hɨxie kanihekɨariwiekamɨkɨ”».   
\p
\v 3 'Aruni mɨpaɨ katiniuyurieni. Kɨxeme tatɨkaime 'atahutame kananu'uitɨani kɨxeme 'uitɨwame hɨxie maukakɨxenikɨ, Yawé Muitsexi kemɨtita'aitɨa.  
\v 4 Kɨxeme 'uitɨwame tsutɨmeyaritɨa meta tuturiyari titsunamekɨ pɨwewiyakai naitɨ mɨkɨ huru xeikɨa pɨhɨkɨtɨkai, matsi Yawé Muitsexi mɨpaɨ mɨtiutahekɨatɨakɨ.   
\s1 Rewitsixi ke'aixɨa memu'itɨarie  
\p
\v 5 Merikɨte Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 6 «Rewitsixi keniwaruta'inieka 'ixaheritsixi watsata, keniwaru'iti.  
\v 7 Memɨ'itiyanikɨ, haa mɨ'itiyakɨ keniwaruhatuiya, mɨpaɨ ketiniwarutahɨawi naime memɨyukaxinikɨ meta yukamixate memɨteti'ekwakɨ. Mɨpaɨ 'aixɨa me'itɨarietɨ mekanakɨnikuni.  
\v 8 Hikɨ xeime tsikeru meta tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ pɨnariekame xekateniyetuakuni mawari mayanikɨ. 'Ekɨta xeime 'ahetsiemieme pekaniyetuamɨkɨ 'itiya mawariyari mayanikɨ.  
\v 9 Rewitsixi 'ixuriki tukiyari manuwetsie paitɨ pekaniwaranuwitɨmɨkɨ meta yunaime 'ixaheritsixi pekaniwakuxeɨrimɨkɨ.  
\v 10 Yawé hɨxie rewitsixi pekaniwataxatamɨkɨ meta 'ixaheritsixi wahetsie mekaniutimeikuni.  
\v 11 Hikɨ 'Aruni Yawé hɨxie rewitsixi kaniwayetuamɨkɨ, 'ixaheritsixi wahetsiemieme mawari teikɨ hetserarietɨ 'uyuitɨariwatɨ mayanikɨ. Mɨpaɨ me'itɨarieme Yawé hetsiemieme te'uximayatamete mekanakɨnikɨni.   
\p
\v 12 »Rewitsixi yumamakɨ tsikerutsixi wahetsie mekaneutimeikuni, 'ekɨta pemɨwaxɨnakɨ wahetsiemieme xeime keneutimawa memɨ'itiyanikɨ, xeimeta Yawé hetsiemieme pekanitataiyamɨkɨ.  
\v 13 Hikɨ rewitsixi 'Aruni hɨxie mekaniti'uikuni meta niwemama wahɨxie, Yawé hetsɨa pekaniwayetuamɨkɨ mawari teikɨ hetserarietɨ muyuitɨariwa mayanikɨ.  
\v 14 Mɨpaɨ pekatiniwapatamɨkɨ 'ixaheritsixi watsata, rewitsixi nehetsiemiemete memakɨnekɨ.   
\p
\v 15 »Hikɨ rewitsixi pewa'itieyu, mawari muyuitɨariwa hepaɨ, mɨkɨ tukita mekatenita'uximayatakuni.  
\v 16 'Ixaheritsixi watsata xewitɨ pumawe, mɨkɨ xeikɨa nehetsiemiemete mekanihɨkɨtɨkakuni, mɨkɨ xeikɨa nepɨwaranuyexei. Matɨarixi 'ixaheritsixi waniwema, nekaniwarupata nehetsiemieme.  
\v 17 Nehetsiemiemete memɨhɨkɨkɨ matɨari nunuiwakate 'ixaheritsixi waniwema, tsepa tewi mɨtihɨkɨ yatɨni tewa mɨtihɨkɨ. Nehetsiemieme nekaniwarayeitɨani kepauka 'ekipitutari waniwema matɨari miemete nemɨtiwarukwinitɨatsie.  
\v 18 Hikɨ rewitsixi nekaniwaranayexeiya 'ixaheritsixi waniwema matɨari miemete wahetsiemieme,  
\v 19 'Aruni meta niwemama, nekaniwayetuirieni 'imikieri hepaɨ. Rewitsixi pɨta mekateni'uximayakakuni 'ixuriki tukiyarita, 'ixaheritsixi wahetsiemieme memɨwaxɨnakɨ, memɨkatekwinitɨariekakɨ 'axame'itɨarietɨ tuki 'aurie meye'axetɨ».   
\p
\v 20 'Aruni Muitsexi hamatɨa meta yunaitɨ 'Ixaheri kiekatari mɨpaɨ mekateniuyurieni. 'Ixaheritsixi mɨpaɨ naime mekateniuyurieni Yawé Muitsexi kemɨtiuta'aitɨakai rewitsixi wahetsiemieme,  
\v 21 mɨkɨ yu'ixurikite mekaniuti'ekwa mekaniuyu'itieni. 'Aruni kaniwayetuani Yawé hɨxie mawari 'aixɨa mɨ'ane hepaɨ, wahetsiemieme kaniutaniuni 'aixɨa memɨ'itɨarienikɨ.  
\v 22 Mɨpaɨ me'uyɨkake rewitsixi tukita mekanekɨne memayutixexeɨriwatsie, muwa memɨteheta'uximayatakɨ 'Aruni meta niwemama meteware'aitɨakaku, hikɨ naitɨ kanaye'atɨarieni Yawé Muitsexi kemɨrahɨawekai rewitsixi wahetsiemieme.   
\p
\v 23 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 24 «'Ikɨ 'inɨari rewitsixi wahetsiemieme kanihɨkɨtɨni: Tuki memɨyutixexeɨriwatsie memɨteta'uximayatakɨ mewaraka'utɨwatɨ xeitewiyari heimana 'auxɨwi wiyari memexeiyatɨka meta muwa memautiyune,  
\v 25 kepaukari huta tewiyari heimana tamamata wiyari maye'atɨarieni mekateniutahayeikawakuni,  
\v 26 'anari xeikɨa mekateniparewiekakuni tukita kememɨteyurieka wa'iwama, 'uximayatsikari mepɨkahɨritɨarieka. 'Ikɨ rewitsixi pɨwa'uximayatsikatɨni kememɨtehɨritɨarie».   
\c 9  
\s1 Patsikwa 'ixɨarariyari  
\p
\v 1 Yawé Muitsexi kaniutahɨawe makumawetsie metitekaku Tsinahi mɨrakutewatsie, mexɨakame metseriyaritsie hutarieka wiyari 'anuyemiekaku kepauka 'Ekipitu memayekɨtsie. Mɨpaɨ katinitahɨawe:  
\v 2 «'Ixaheritsixi Patsikwa 'ixɨarariyari mekaniuwewiximekuni kemɨ'ane tukaritsie yanepɨtayɨni.  
\v 3 Taikai xekaniwewiximekuni tamamata heimana naurieka tukari 'umiekaku mexɨakame metseritsie, mana kanika'inɨarikamɨkɨ. Xekaniwewikuni 'inɨari niukiyari xemaye'atɨanikɨ».   
\p
\v 4 Muitsexi katiniuta'aita Patsikwa 'ixɨarariyari 'ixaheritsixi memɨwewienikɨ,  
\v 5 mɨkɨta mekaniwewieni Tsinahi mɨrakutewatsie makumawetsie, taikai tamamata heimana naurieka tukari 'umiekaku mexɨakame metseriyaritsie. Yawé Muitsexi kemɨtiuta'aitɨakai 'ixaheritsixi naimekɨ yamekateniuyurieni kemainekai.   
\s1 Xɨka 'aixɨa ka'aneni  
\p
\v 6 Peru matsi hipatɨ Patsikwa 'ixɨarariyari memɨwewieni mepɨka'upitɨarie, memɨka'itiyakaikɨ timɨkime memɨte'umayɨakaikɨ. Mɨkɨ tukaritsie Muitsexi meta 'Aruni wahetsɨa mekananukɨne,  
\v 7 mɨpaɨ mekateniwarutahɨawe:  
\p —Timɨkime tepɨtehemayɨa, 'ayumiemexɨari 'aixɨa tepɨka'anene. Hikɨ tepimaiku xɨka teyɨwaweni Yawé hetsiemieme temɨtetimawakɨ mɨkɨ tukaritsie hipame 'ixaheritsixi wahepaɨ.   
\p
\v 8 Muitsexi mɨpaɨ katiniwarutahɨawe:  
\p —Yaxeketeneutewini Yawé kemɨnetitahɨawe kemɨtiyurimɨkɨ xehetsiemieme.   
\p
\v 9 Hikɨ Yawé Muitsexi mɨpaɨ katiniutahɨawe  
\v 10 'ixaheritsixi mɨpaɨ mɨtiwatahɨawekɨ: «Kepauka xewitɨ xe'iwa 'aixɨa mɨka'aneni xeime timɨkime mɨremayɨa yatsepa xewitɨ yukwiepa mɨka'uyeika, mɨpaɨtsiere 'anetɨ miwewieni pɨyɨwe Patsikwa Yawé hetsiemieme.  
\v 11 Hɨrixɨatsɨ xɨka mɨpaɨ 'aneni, kaniwewimɨkɨ taikai tamamata heimana naurieka tukariyaritsie hutarieka metseriyaritsie 'umiekaku. Muxa kanitakwaimɨkɨ paa mɨkakuxanariyarietɨkakɨ meta tupiriya matsiwi,  
\v 12 muxa waiyarieya 'uxa'arieka mieme mayanikɨ xepɨkakuhayeikawani meta 'umeyarieya xepɨka'anumurani. Kepauka Patsikwa 'ixɨarariyari mɨwewieni kehepaɨ mɨrayuwewiwa mɨpaɨ katiniyurimɨkɨ.   
\p
\v 13 »Xɨka xewitɨ Patsikwa 'ixɨarariyari ka'uwewieni 'aixɨa 'anetɨtɨ meta 'ateewa kaheyeikatɨ, manuyeikatsie kanayeweiyariemɨkɨ Yawé mɨkatiutimawirikɨ mɨkɨ tukaritsie. 'Ana katinikwinitɨariemɨkɨ 'axamɨtiuyurikɨ.   
\p
\v 14 »Xɨka 'ateewa kiekame xehamatɨa muka Patsikwa 'ixɨarariyari wewimɨkɨni Yawé hetsiemieme, kaniyɨweni 'inɨari kemaine mɨpaɨ 'anetɨ. Mɨkɨ Patsikwa 'inɨarieya kemaine yunaime wahetsiemieme pɨhɨkɨ, mana nunuiwakate meta 'ateewatari».   
\s1 Tuki heima hai kemɨtiuyeya  
\p
\v 15 Kepauka tuki 'ixurikiyari munɨrie Kakaɨyari tɨratuya muyeka, tukarikɨ tuki hai kanenukanakaitɨni, meta tɨkarikɨ tai hepaɨ 'anetɨ kanayani.  
\v 16 Mɨpaɨ kaniuyɨnekaitɨni: Tukarikɨ hai tuki kananukanarɨmakaitɨni, tɨkarikɨta tai kanayeikakaitɨni.  
\v 17 Kepauka hai manuku'ekekai tuki heima, 'ixaheritsixi 'ana mekanayekɨkakaitɨni, hakewata hai meyuhayewa manata mekanitiyaxikekaitɨni.  
\v 18 Yawé kemɨtiwakɨhɨawekai 'ixaheritsixi mɨpaɨ mekateniyekɨkakaitɨni yatɨni mɨpaɨ mekatenikuyaxikekaitɨni, kemɨreuteterekai hai tuki heima 'uyekaitɨ mana mekaniyukuhayeikawakaitɨni.  
\v 19 Tsepa mɨixa tukari tuki heima muyeya, 'ixaheritsixi Yawé mekaneu'eniekaitɨni kemɨtiwa'aitɨakai mepɨka'ayekɨkakai.  
\v 20 Yaxeikɨata kepauka yakɨ mɨreuteterekai tuki heima: Kepauka Yawé mɨpaɨ mɨtiku'inɨaritakai, 'ixaheritsixi 'amenitiyaxikekaitɨni yatɨni mekanekɨkakaitɨni.  
\v 21 Heiwa hai xeitɨkari xeikɨa kanikuyuruwakaitɨni, tsepa tɨkarikɨ tsepa tukarikɨ, kepauka meyeikakai 'ana 'ixaheritsixi mekananuku'uwekaitɨni.  
\v 22 Tsepa huta tukari yatɨni xeimetseri yatɨni mɨixa tukari, 'ixaheritsixi mana mekaniyukuhayeikawakaitɨni mekapekɨkakai, kepaukata meyeikakai hai mekanekɨkakaitɨni 'utɨmana.  
\v 23 Kepauka Yawé yamɨtiwaku'inɨaritɨwakai, 'ixaheritsixi mana mekanikuyaxikekaitɨni yatɨni mepekɨkakai. Yawé mɨpaɨ mekateneu'eniekaitɨni yaxeikɨata Muitsexi Yawé yatikɨhɨawekaku.   
\c 10  
\s1 Kuxinetate yuarikayari  
\p
\v 1 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 2 «Hutame kuxineta titsunamekɨ keneutiwewi pɨratakɨ wewiyatɨkaime, mana memukutei pemɨwakuxexeɨriwanitsie keneutahɨtsiwani meta kepauka memayekɨnetsie.  
\v 3 Kepauka hutatɨ mɨtiyuani, yunaitɨ teɨteri 'ahamatɨa mekaniyukuxeɨrikuni 'ixuriki tukiyari mɨranutahakitɨretsie.  
\v 4 Kepauka xewitɨ xeikɨa mɨtayuani, 'ahamatɨa mekaniyukuxeɨrikuni xeikɨa memanuyetei 'Ixaheri nuiwarimama.  
\v 5 Kuxineta haikakɨa hetayuayu memɨyehutsiemieme, mekananuyeyaxikuni tau makayuyuipiketsie memɨtitei,  
\v 6 hutariekata tatsutɨa memɨtitei. 'Ana kanitayuamɨkɨ kuxineta memɨyehutsie 'amemayekɨnekɨ.  
\v 7 Kepauka memɨyuxeɨrikuni mematiteitsie kuxineta kanitayuamɨkɨ yɨkɨ pɨta tiuyuatɨ.   
\p
\v 8 »Kuxineta memɨtihɨtsieni mawari wewiwamete 'Aruni niwemama mekateniyurikuni. 'Ikɨ 'aitsika kanihɨkɨtɨkamɨkɨ xehetsiemieme meta xenuiwarima.   
\p
\v 9 »Kepaukari yukwietsie xemeta'axɨani xemayekɨne xekaneyɨwawekuni xeheyutakwinike memɨxe'aye'unie wahetsɨa, mɨkɨ kuxineta kanitiyuamɨkɨ kepauka xemeyutakwini. Hikɨ 'ana xeme Yawé kanixehaye'erimɨkɨ kanixetawikweitsitɨamɨkɨ memɨxe'aye'unie watsata.   
\p
\v 10 »Kepauka 'ixɨarari waɨkawa meuyewetse xemutiwewiwani, meta metseri mɨhekwa tukariyari 'anatsiere xekateniutihɨtsiwakuni mawari taiyariyari memewewienikɨ meta 'aixɨa memɨteyuxeiyani mawariyari hetsiemieme. 'Ana Kakaɨyari xeme pɨxehaye'erieni. Ne Yawé 'akakaɨyari nekanihɨkɨtɨni».   
\s1 Tsinahi memɨyekɨ Parani memu'axɨa  
\p
\v 11 Xeitewiyari tukari 'umiekaku hutarieka metseriyaritsie, hutarieka wiyaritsie, hai kananuku'ene tuki heima.  
\v 12 Hikɨ 'ixaheritsixi Tsinahi mekaniyekɨne memakutekaitsie makumawetsie paitɨ mekaniu'axɨani, Parani mɨrakutewatsie hai hakewa meuyeya.  
\v 13 Yawé Muitsexi kemɨtiuta'aitɨa, 'ana 'ixaheritsixi mekaniyekɨne matɨari.   
\p
\v 14 Matɨari memanuyeyaxixɨ Kura teɨterimama mekaniyɨakaitɨni yupatera me'akwetɨ. Kaniwara'iniekaitɨni Nahatsuni titewatɨ 'Aminarawi nu'aya.  
\v 15 Natanaheri Tsuhaxi nu'aya kaniwara'iniekaitɨni 'Itsakaxi nuiwarimama.  
\v 16 'Eriyáwi Heruni nu'aya kaniwara'iniekaitɨni Tsawuruni nuiwarimama.   
\p
\v 17 Hikɨ tuki 'utaxɨnarieka, Keritsuni nuiwarimama meta meraritsixi mete'utɨtɨ mekanekɨne.   
\p
\v 18 Wa'utɨmata memayekɨ Xuweni teɨterimama mekaniyɨakaitɨni yupatera me'akwetɨ. Kaniwarawitɨkɨkaitɨni 'Eritsuxi Tserehuxi nu'aya.  
\v 19 Tserumieri Tsuritsarahi nu'aya Tsimehuni nuiwarimama kaniwarawitɨkɨkaitɨni,  
\v 20 'Eriyatsati Rehuheri nu'aya Kahari nuiwarimama kaniwarawitɨkɨkaitɨni.  
\v 21 Hikɨta mɨkɨ wa'utɨa mekanekɨne Kuhatitsixi mɨtipatsietɨka tetɨkɨmete. 'Ixuriki tukiyari kaniutawewierikekaitɨni mexi meka'uye'axɨawaweni hakewa memetiyaxe.   
\p
\v 22 Mɨkɨta wa'utɨma mekanekɨne 'Epɨrahini teɨterimama yupatera me'akwetɨ. Mɨkɨ 'Eritsama 'Amihuri nu'aya kaniwarawitɨkɨkaitɨni.  
\v 23 Kamarieri Peratsuxi nu'aya Manatsexi nuiwarimama kaniwarawitɨkɨkaitɨni,  
\v 24 'Awirani Kereuni nu'aya Wenikamini nuiwarimama kaniwarawitɨkɨkaitɨni.   
\p
\v 25 'Imatɨrieka yunaime wahɨwemete mekanayekɨne Rani teɨterimama yupatera me'akwetɨ. 'Akihetsexi 'Amitsarahi nu'aya kaniwarawitɨkɨkaitɨni.  
\v 26 Pakieri 'Ukɨrani nu'aya, 'Atsexi nuiwarimama kaniwarawitɨkɨkaitɨni,  
\v 27 'Akira 'Enahani nu'aya, Nepɨtahari nuiwarimama kaniwarawitɨkɨkaitɨni.  
\v 28 Mɨpaɨ mekateneuku'ukaitɨni 'ixaheritsixi kepauka memayekɨkakai.   
\s1 Muitsexi Huwawi kemɨtiuta'ini  
\p
\v 29 Hikɨ Muitsexi Huwawi Xehueri mariyani tewiyari nu'aya mɨpaɨ katiniutahɨawe:  
\p —Tame tepayekɨnirɨme Yawé kwie mɨtatsi'axatɨatsie. Hikɨmɨ tanaitɨ tekaniyehuni 'aixɨa temɨteheyuxeiyanikɨ, Yawé 'ixaheritsixi wahetsiemieme 'aixɨa mɨtiuka'iyarikɨ.   
\p
\v 30 Huwawi mɨpaɨ kaniutayɨni:  
\p —Ne hawaikɨ, ne nepɨkayemie, ne nekwiepa pɨta nekaniyemieni nemarema wahetsɨa.   
\p
\v 31 Muitsexi mɨpaɨ katinitahɨawe:  
\p —Neuxeitsɨ, pepɨkatatsi'uku'e'eiriwani, 'Ekɨ pepukumate makumawetsie hakewa temeka'uxipiweni. 'Ekɨ pemɨtatsi'anuwitɨni pepɨhɨkɨtɨni.  
\v 32 Xɨka petatsi heweiya, tame tematsi heyetuirieni 'aixɨa mɨti'ane Yawé mɨtareyetuirieni.   
\s1 Kepauka 'ixaheritsixi memayekɨ  
\p
\v 33 'Ixaheritsixi mekanayekɨne Yawé hɨrieya manukatsie, haika tukari mekaniuhukaitɨni Yawé tɨratuya mayeka me'akwetɨ, wahɨxie kaniumiekaitɨni 'ikuwaunetɨ hakewa memeka'uxipienikekai.  
\v 34 Kepauka memayekɨkakai, Yawé haiwitɨrieya waheima tukarikɨ puyeyeixakai.  
\v 35 Kepauka kakuni manukukweiwakai, Muitsexi mɨpaɨ kaniutainekaitɨni:  
\q1 «Yawé, kenanukukexi.  
\q2 Mekeheutaxɨriexɨani memɨmatsi 'aye'unie,  
\q2 Mekeheuyuta'unaxɨani memɨmatsiheka».   
\m
\v 36 Kepaukata kakuni muwakekakai, Muitsexi mɨpaɨ kaniutainekaitɨni:  
\q1 «Yawé, kenenua,  
\q2 'ateɨterima 'ixaheritsixi wahetsɨa memɨkayu'inɨatsinɨa memɨhɨkɨ».   
\c 11  
\s1 Taweratsie Yawé taikɨ kemɨtiwareuyehɨa  
\p
\v 1 Tawera metitetɨ 'ixaheritsixi 'axamekaniutiyuanekaitɨni Yawé hepaɨtsita mete'uka'eniwatɨ. Mɨkɨ waru'enieka waɨkawa kaniuyeha'ani, taikɨ wawarita mematiteitsie katinaxɨtsitɨatɨyani.  
\v 2 Hikɨ 'ixaheritsixi Muitsexi waɨkawa mekaniwawiriekaitɨni, kaniuyutanenewieni Yawé mɨtiwareuyehɨwirienikɨ, 'ana tai kaniutɨni.  
\v 3 'Ayumieme mana mɨya mɨtiɨyɨkɨ Tawera katiniuterɨwarieni, Yawé taikɨ mɨwarutitaiyaxɨkɨ.   
\s1 Kiwuruti-Hatawa kiekatari kememɨteyu'uximatɨakai  
\p
\v 4 Hipatɨ teɨteri kɨkamete memaye'ukai waɨkawa meteheukwaikɨtɨ mekanakɨne. Hikɨ 'ixaheritsixi mekaniutitsuani meta mɨpaɨ me'utiyuatɨ: «Kemɨ'ane wai pɨtatsimini.  
\v 5 Titayari tsapari 'Ekipitutsie temɨwaretikwa'akai tekateyutuatɨ tetewareku'eiri. Yaxeikɨata pepinu meta meruni temetikwa'akai metatsiere wexu, 'uyuri meta 'axuxi.  
\v 6 Hikɨ neuxei tekananatiwawakini, manana xeikɨa tekanixeiyani».   
\p
\v 7 Manana tsiranituru hatsiyari hepaɨ katiniyuxexeiyakaitɨni, witsuanari mutimerɨka hepaɨ.  
\v 8 'Ixaheritsixi mekanikuteɨxɨkaitɨni tetexi hutamekɨ mekanititɨxɨkaitɨni, yatɨni mekanititsunakaitɨni xɨka me'ika'etsakuni meta paa kɨmana mekaniwewiekaitɨni. Paa mɨwiyamarie hepaɨ kana'anekaitɨni.  
\v 9 Tɨkarikɨ kepauka haɨtsi mɨkaxɨrɨwekai memakuteitsie, manatsiere manana kanikaxɨrɨwekaitɨni.   
\s1 Muitsexi Kiwuruti-Hatawa kemɨtiuyu'uximatɨa  
\p
\v 10 Hikɨ Muitsexi kaniu'ena 'ixaheritsixi meta watɨɨriyama kememɨte'utsuanakai, yuxexuitɨ yuxamaru kitenie, Yawé mekanihaxɨatɨakaitɨni. Hikɨ yu'uximatɨatɨ,  
\v 11 Muitsexi Yawé kaniutahɨawe nenewierikɨ:  
\p —Xɨka ne neti'a'uximayatsiriwametɨni, ¿titayari peneti'uximatɨa? ¿titayari pekanetiparewie, teɨteri yunaitɨ nehetsie memɨte'uhɨpanikɨ penetihɨritɨa?  
\v 12 ¿Netsɨ neniwema menehɨkɨ, neniwarutiniwexɨ, pemɨnetsi'aitɨakɨ kename newa'ɨwiyani, 'atɨɨriyama waweriyame hepaɨ, newarakatɨtɨ nemɨwareta'atɨanikɨ hakewa paitɨ kwie wa'ukiyarima pemɨwarexatɨatsie?  
\v 13 'Ikɨ yunaitɨ teɨteri wai mekaneniwawirieka me'utitsuatɨ. ¿Ne hakewa nepeikaxeiya?  
\v 14 Ne nexaɨtame nepɨkayɨwe 'ikɨ teɨteri wahetsiemieme. Waɨkawa 'uximayatsika pɨhɨkɨ nehetsiemieme.  
\v 15 Xɨka mɨpaɨ petiyurienemɨkɨ, ne nepɨmatsiwawirie netukari pemɨnetsi nawairienikɨ. Mɨpaɨ nepɨratɨmaiya hikɨ kenemɨtiuka'eniwa.   
\s1 Yawé Muitsexi kemɨtiuta'ei  
\p
\v 16 Yawé Muitsexi mɨpaɨ katiniuta'eiya:  
\p —'Ukirawetsixi 'ixaheritsixi haika tewiyari heimana tamamata kenene'atɨiri, mɨpaɨ ketinemaika yuteɨterima memɨwakuyuitɨwa xeikɨa mekaniyɨakakɨni. 'Ixuriki tukiyari manuwe keniwaranuwitɨki, mana 'etsiwa 'ahamatɨa yameketeheutewini.  
\v 17 Ne 'ahamatɨa nemɨtitaxatakɨ nekananukatemɨkɨ, mɨkɨ wahetsieta yanekatiniyurimɨkɨ 'iyari pemexeiya memexeiyanikɨ, memɨmatsiparewiekakɨ 'ikɨ teɨteri mɨmatsihɨritɨa wahekɨ. Mɨpaɨ 'ekɨ 'axaɨtame xeikɨa pemɨkayɨanenikɨ.   
\p
\v 18 »Teɨteri xeikɨa mɨpaɨ pekatiniwatahɨawimɨkɨ: “Xekeneuyu'iti 'uxa'a miemekɨ, 'uxa'a wai xekanitikwaikuni. Xeme xekaniutitsuani Yawé hɨxie, mɨpaɨ xe'utiyuatɨ: ‘Wai ketatsi'umini. 'Ekipitutsie naime tepɨtehetikwa'akai.’ Mɨkɨta hikɨ wai kanixemimɨkɨ, xekanitikwaikuni.  
\v 19 Xeitukari, nihuta tukari ni'aɨxɨwime tukari, tamamata tukari, meta nixeitewiyari tukari xepɨka'itikwa'ani,  
\v 20 matsi xeimetseri, kepaukake xetsurita makanexɨani, kepaukake xemitixani'erieni. Yawé xemu'uximatɨakɨ, xehamatɨa muyeika, xemutitsuakɨ mɨpaɨ xe'utiyuatɨ: ‘¿Titayari 'Ekipitutsie tetehayekɨ?’”»   
\s1 Kakaɨyari niukieya kanaye'atɨarieni  
\p
\v 21 Muitsexi mɨpaɨta kaniutayɨni:  
\p —Ne kuyaxi 'ataxewime tsienituyari miriyari wahamatɨa nekaniuyeikani, ¿'ekɨta wai xeimetseritsie xeikɨa petiwamini peraine?  
\v 22 Tsepanetɨ xeikuraruyari tsipuru mɨwarukwi'iri mepɨkatenake, tsepanetɨ haramaratsie tsapari memuye'uwa yunaime mɨwarukwi'iri yunaitɨ mepɨkatenake.   
\p
\v 23 Yawé Muitsexi mɨpaɨ katiniuta'eiya:  
\p —¿Kamɨtsɨ Yawé tɨrɨkariyaya reu'atɨka? Hikɨtsɨ pekaninierimɨkɨ, xɨka neniuki nehaye'atɨamɨkɨ yatɨ pɨtikatixaɨ.   
\p
\v 24 Hikɨ Muitsexi 'ixaheritsixi yakatiniwarutahɨawe Yawé kemɨtitahɨawekai. Mɨkɨ kaniwarukuxeɨrieni haika tewiyari heimana tamamata 'ukirawetsixi, wa'aurie kaniyuhayewa ta'ikwewatɨ 'ixuriki tukiyari 'aurie.  
\v 25 Yawé haitsie 'uyekaitɨ Muitsexi hamatɨa katiniutaxata, meta haika tewiyari heimana tamamata 'ukirawetsixi 'iyari kaniwarupitɨani Muitsexi meixeiyakai. Kepauka 'iyari wahetsie mɨyuhayewaxɨ, metekuxatatɨwetɨ mekanakɨne. Tawarita mɨpaɨ pɨkatiɨyɨ.   
\p
\v 26 Yuhutatɨ 'ukirawetsixi yukie memuyuhayewakai. Xewitɨ 'Erirari titewatɨ, xewitɨta Merari. Tsepa memanayexeiyariekai tuki manuwe mepɨkahekɨ. Yatɨtɨ, 'iyari wahetsie pɨtiunakixɨ, mɨkɨta metekuxatatɨwetɨ mekanakɨne mematiteitsie.  
\v 27 Hikɨ xewitɨ temaikɨtɨtɨ kaniutanautsa Muitsexi mɨkɨkɨ retaxatɨanike, mɨpaɨ kaniutayɨni:  
\p —'Erirari, Merari hamatɨa mekatenekuxatatɨweni temakuteitsie.   
\p
\v 28 Kutsuhexi Nuni nu'aya, ti'uximayatame manayexeiyarie Muitsexi parewiwameyakɨ temaikɨyari paitɨ, mɨpaɨ kaniutayɨni:  
\p —Muitsexi, neti'aitɨwame, keniwaruta'imaiya.   
\p
\v 29 Muitsexi mɨpaɨta kaniutayɨni:  
\p —¿Nekɨmana peti'ɨtetsa? Mɨpaɨ nepɨtiku'eriwakaku yunaitɨ 'ikɨ Yawé teɨterimama 'iyari mepexeiyanikeku memɨtekuxatanikɨ.   
\p
\v 30 Hikɨ Muitsexi meta 'ukirawetsixi mekaniu'axɨani mematitekaitsie.   
\s1 Xɨ'aurixi  
\p
\v 31 Yawé 'eka kaniuyuitɨani xɨ'aurixi haramaratsie miemete waratɨkɨme, mematiteitsie kaniwarukaxɨrieni. Memakuteitsie wa'aurie xɨ'aurixi mekanakunɨkaitɨni, xeitukari 'umietɨ ranuyenakeme me'atayeutɨ, xeimeturuyari metsuitɨ kwiepa.  
\v 32 'Ixaheritsixi mekaniwarukuteɨxɨ xɨ'aurixi mɨkɨ tukaritsie meta naime mɨkɨ tɨkaritsie meta 'uxa'arieka. Yunaitɨ tamamata 'ikayari mekaniukuxeɨrieni. Memakuteitsie takwa yateewa mekaniwarutiwatsiɨxa.   
\p
\v 33 Hikɨ kepauka memeitakwaixɨa yuteta meka'itikeiwawekaku 'akuxi, Yawé kaniuyeha'ani 'ixaheritsixi wahetsiemieme, 'ana yuwaɨkawatɨ mekaniukwini.  
\v 34 'Ayumieme mana mekateniuterɨwa Kiwuruti-Hatawa, mana memukateukiekɨ 'ikwaitsie xeikɨa memɨyukɨhɨawekaikɨ.   
\p
\v 35 Mana Kiwuruti-Hatawa memɨyekɨ 'ixaheritsixi, mekanekɨne pɨta Katseruti mana mekaniuyuhayewa.   
\c 12  
\s1 Miriyami, 'Aruni hamatɨa Muitsexi kememɨteniukimakai  
\p
\v 1 Muitsexi xeime 'uka 'ekipitutanaka kaniutiwitɨni, hikɨ Miriyami 'Aruni hamatɨa mekanitiniukimatɨkɨne mɨkɨkɨ.  
\v 2 Mɨpaɨ mekaniutiyuanekaitɨni: «¿Kamɨtsɨ Yawé Muitsexi xeikɨa tikuhɨawe? ¿Tamɨ tameta katatikɨhɨawe?» Hikɨ Yawé kaniwaru'enieni.   
\p
\v 3 Matsi Muitsexi tixaɨtɨ karayuyeitɨatɨ 'amuyeika kanihɨkɨtɨkaitɨni, nixewitɨ tawarita hepaɨna 'anetɨ kwiepa pumawekai.   
\p
\v 4 Yapauka Yawé Muitsexi, 'Aruni meta Miriyami mɨpaɨ katiniwarutahɨawe: «Xekenehu 'ixuriki tukiyari manuwe xeme xeyuhaikatɨ». Mɨkɨ mekanekɨne.  
\v 5 Hikɨ Yawé kanakateni hai 'a'uwekametsie, 'ixuriki tukiyari hɨxie kaniuyuhayewa. 'Aruni meta Miriyami mame kaniwaruta'inieni, kepauka yuhutatɨ memɨwakɨ,  
\v 6 Yawé mɨpaɨ katiniwarutahɨawe: «Xekeneneu'eni kenemɨtixetahɨawe:  
\q1 »Kepauka Yawé niukameya  
\q2 xetsata 'amuyeika,  
\q1 ne nekanikɨhɨaweni heinɨtsika hepaɨ 'anemetsie  
\q2 meta nematsiɨkɨtɨ nekanayuyeitɨwani heinɨtsikatana.   
\q1
\v 7 Peru 'ikɨ mɨpaɨ pɨka'ane  
\q2 Muitsexi neti'uximayatsiriwame hamatɨa,  
\q1 yunaitɨ nete'uximayatsiriwamete watsata  
\q2 mɨkɨ matsi yamɨtikamie kanihɨkɨtɨni.   
\q1
\v 8 Ne nekatinikuxaxatɨwani hɨxiena ne'utinieretɨ,  
\q2 hekɨakamekɨ nekarenukanamirietɨ.  
\q1 Ne Yawé kenemɨ'ane kanenikuxexeiyani.  
\q2 ¿Ketitayari mɨya xete'utiyuane  
\q2 neti'uximayatsiriwame Muitsexi hepaɨtsita?»   
\p
\v 9 Yawé waɨkawa kaniuyeha'ani wahepaɨtsita hikɨ kaneyani.  
\v 10 Yapauka hai 'anuku'eneku tuki heima, Miriyami nawiyarieya tuxatɨ kanayani 'ɨwi hepaɨ. Kepauka 'Aruni hepana mutɨa, kanixeiya yuwaiyaritsie kwiniya hexeiyakame.  
\v 11 Hikɨ 'Aruni 'ana Muitsexi mɨpaɨ katiniutahɨawe: «Waɨkawa nepɨmatsiwawirie, neti'aitɨwame, ke'axatemɨte'uyuri pepɨkahe'eriwani 'atsitekatemaitɨ temutiyuakɨ.  
\v 12 Miriyami yuwaiyaritsie kanepɨnini, nunutsi yumaama hetsie manuyemɨ nawiyarieya hepaɨ. Ximɨxi kwerietɨ mɨpaɨ pɨka'aneni ketineuyehɨwirieka».   
\s1 Muitsexi Miriyami hetsiemieme kemɨtiyutanenewi  
\p
\v 13 Muitsexi Yawé mɨpaɨ katiniutawawirieni: «Kakaɨyari, waɨkawa nepɨmatsiwawirie pemenayehɨanikɨ».   
\p
\v 14 Yawé Muitsexi kaniuta'eiya: «Xɨka paapaya hɨxienatsie 'ita'aɨtsikawiyake ¿katiyɨwe 'atahuta tukari muyuhiwerieka? Keheyani 'atahuta tukari kiepa pɨka'ukani, mɨkɨ tukari 'aye'ayuke kanipitɨariemɨkɨ».   
\p
\v 15 Mɨpaɨ Miriyami 'atahuta tukari yeuta kaniukateitɨni. 'Ixaheritsixi mepɨkahekɨ kepaukake mɨkɨ wahetsɨa munua.  
\v 16 'Anake 'ixaheritsixi mekanayekɨne Katseruti, Parani makumawetsie mekaniu'axɨani.   
\c 13  
\s1 'Ixaheritsixi Kanahani kememɨtehekuxei  
\p
\v 1 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 2 «Mɨpaɨ nepaine keniwaranunɨ'a hipame kwie memɨxeiyayukɨ 'ixaheritsixi nemɨwayetuirieni. Yuxexuime nuiwaritetsie memanuyetei mekaniwaranunɨ'akuni».   
\p
\v 3 Yawé kemainekai, Muitsexi kaniwarenɨ'ani Parani makumawetsie mekaniyekɨne. Yunaitɨ mɨkɨ 'ixaheritsixi memanuyetei mekanihɨkɨtɨkaitɨni.  
\v 4 Mɨpaɨ mekatenitetewakaitɨni:  
\b  
\li1 Tsamuha, Tsakuxi nu'aya, Xuweni nuiwarimama wahetsiemieme,   
\li1
\v 5 Tsapati, Huri nu'aya, Tsimehuni nuiwarimama,   
\li1
\v 6 Karewi, Kepune nu'aya, Kura nuiwarimama,   
\li1
\v 7 'Ikari, Kutse nu'aya, 'Itsakaxi nuiwarimama memɨhɨkɨ,   
\li1
\v 8 'Utseyaxi, Nuni nu'aya, 'Epɨrahini nuiwarimama memɨhɨkɨ,   
\li1
\v 9 Pariti, Xapuhu nu'aya, Wenikamini nuiwarimama,   
\li1
\v 10 Kariheri, Tsuhuri nu'aya, Tsawuruni nuiwarimama wahetsiemieme,   
\li1
\v 11 Kari, Tsutsi nu'aya, Manatsexi nuiwarimama (Kutse nu'aya xewitɨ mɨhɨkɨ),   
\li1
\v 12 'Amiheri, Kemari nu'aya, Rani nuiwarimama memɨhɨkɨ,   
\li1
\v 13 Tsetuxi, Mikaheri nu'aya, 'Atsexi nuiwarimama wahetsiemieme,   
\li1
\v 14 Nakiwi, Watsi nu'aya, Nepɨtahari nuiwarimama wahetsiemieme,   
\li1
\v 15 Kehueri, Maki nu'aya, Kahari nuiwarimama wahetsiemieme.   
\b  
\p
\v 16 Mɨpaɨ mekatenitetewakaitɨni memanuyetei Muitsexi mɨwarenɨ'a kwie memɨxeiyayukɨ. ('Utseyaxi mɨtitewakai Nuni nu'aya, Muitsexi kanipata Kutsuhexi pɨta katiniterɨwa).   
\p
\v 17 Kepauka Muitsexi mɨwarenɨ'a Kanani kwieyari memɨxeiyayukɨ, mɨpaɨ katiniwarutahɨawe: «Nekexi xekaneutiyunikuni, hɨritsie paitɨ xekaniye'axɨakuni.  
\v 18 Kwie naime xekenexeiya, xekeneyɨ'ɨwiya teɨteri kememe'anene, xɨka mehetɨrɨkawini yatɨ mepɨkatehetɨrɨkawi, xɨka meheyuwaɨkawani yatɨ 'etsi mepɨteheyupaɨme.  
\v 19 Xekenexeiya kwie keme'ane, xɨka 'aixɨa he'aneni yatɨ 'axapɨre'ane, xɨka waki hekurarutsietɨkani yatɨ pɨtikatixaɨ.  
\v 20 Kwie xekenexeiya xɨka 'aixɨa rexuaweriyani yatɨ hawaikɨ, xɨka kɨyexi hexuaweni yatɨ pɨremawe. Hikɨ xekenehu xekamamatɨ. Tixaɨtɨ 'ikwaxi xekateni'atuakuni muwa timieme».  
\p Mɨkɨ tukaritsie kaxie takari matɨari mieme matikwakwaxetsie mekaniyɨakaitɨni.   
\p
\v 21 Mekanekɨne tamamata heimama huta meyupaɨmetɨ 'ukitsi kwie meheuxeiyayuka, makumawetsie Tsini Xekuwi ye'atɨkaime, Rewu Kamati heuhurakaku.  
\v 22 Nekexi mekaneutiyune, Hewuruni mekaniye'axɨani, 'Akimani, Tsetsahi meta Tarimahi memanu'uwakai 'Anaki nuiwarimama mematitekai. ('Epuruni kiekariyari meri kaniukamarieni 'ariketa 'atahuta wiyari 'anuyemiekaku Tsuhani kiekariyari kaniukamarieni 'Ekipitu mieme).  
\v 23 Kepauka memu'axɨa mayeweritsie 'akitsie 'Etsikuri, xeixatsimuyari mekanaka'inɨni kaxie takari, yuhutatɨ meneitɨni kɨyetsie me'iyewietɨ. Metatsiere hipame 'ikwaxite kɨranaraxi meta xapa takariyari mekanaka'inɨni.  
\v 24 'Ikɨ kaxie takari memaka'inɨikɨ 'ixaheritsixi, mana mekateniuterɨwa 'Etsikuri mayeweri.   
\s1 Kememutiyua nenieremete  
\p
\v 25 Huta tewiyari tukari 'anukayaku mekaniu'axɨani tamamata heimana huta 'ukitsi kwie mehekuxeiyaka.  
\v 26 Karetsi mekaniu'axɨani makumawetsie Parani Muitsexi manukatei, 'Aruni meta yunaitɨ 'ixaheritsixi, mekateniwarutaxatɨani kemɨre'anekai meta 'ikwaxite mekateniwaruxeitsitɨani mana mɨrexuawekai.  
\v 27 Mɨpaɨ mekateniwaruxatɨani:  
\p —Hakewa pemɨtatsihetanɨ'a mɨkɨ kwieyaritsie tepanɨkɨ, puyuri mana waɨkawa pexuawe retsi meta xiete. 'Ena xeketeneuxeiya 'ikwaxi mana mɨrexuawe.  
\v 28 Perutsɨ mana teɨteri memexuawe waɨkawa mepetɨrɨkawi, wakiekarite 'apɨremamariwawe, 'aixɨa rekukurarutsietɨkaitɨ. Matsita mana tekaniwarexeiya 'Anaki xiɨyarimama 'amemutɨtɨ.  
\v 29 'Amarekitsixi Nekexitsie mekaniu'uwani, hɨritsieta hetitsixi, kewutseutsixi meta 'amuxeutsixi hɨritsie mekane'uwani metatsiere kananeutsixi haramara tetsita mekaniu'uwani Kurutani tetsita.   
\p
\v 30 Karewi kaiwatɨ katiniwaruyatsa 'ixaheritsixi Muitsexi hɨxie, mɨpaɨ kaniutayɨni:  
\p —Hikɨmɨtɨka tekanihuni mɨkɨ kwie tema'iwakɨ. Ne mɨpaɨ nepɨtiku'eriwa tepɨyɨwawe.   
\p
\v 31 Hamatɨana memanɨkɨnekai mɨpaɨ mekaniutiyuani:  
\p —Tepɨkayɨwawe mɨkɨ teɨteri wahamatɨa temuyutakwini. Mɨkɨ mepɨtɨrɨkawi waɨkawa. Tame tepɨkatɨrɨkawi.   
\p
\v 32 Hikɨ 'itarikakɨ mekateniutixatatɨkɨne 'ixaheritsixi watsata kwie memekuxei hepaɨtsita. Mɨpaɨ mekaniutiyuanekaitɨni:  
\p —Kwie temekuxei yuteɨterima kaniwarekwaka, teɨteri mana meme'uwa 'amekaniutɨni.  
\v 33 Matsi manata tekaniwarexeiya 'Anaki xiɨyarimama 'amemutɨtɨ. Temeyuku'inunɨatakai 'utsikari wahepaɨ tepepepekai, mɨpaɨ mɨkɨ mekatatenexeiyakaitɨni.   
\c 14  
\s1 'Ixaheritsixi Kakaɨyari hetsie mepɨte'uhɨpakai  
\p
\v 1 Mɨkɨ tɨkaritsie 'ixaheritsixi mekaniutayuani me'utihiwatɨ meta me'utitsuatɨ.  
\v 2 Meyu'uximatɨatɨ Muitsexi hetsiemieme meta 'Aruni, yunaitɨ mɨpaɨ mekaniutiyuanekaitɨni: «Matsi temɨnekwikaitɨni 'Ekipitu paitɨ. 'Ena 'aixɨa pɨyɨni makumawetsie xɨka te'ukwini.  
\v 3 ¿Titayari Yawé 'ikɨ kwieyaritsie tareyewitɨ? ¿'Ixiparakɨtsɨ temɨkwi'iwakɨ, ta'ɨitama taniwema memɨwaranuwitɨnikɨ? ¿'Aixɨa kati'ane xɨka tehakunuaxɨani 'Ekipitu?»  
\v 4 Mɨpaɨ mekateniyɨkɨhɨawekaitɨni hipatɨ: «Xeime manuyeyerɨni tepanuyexeiya mɨtatsi'anuwitɨnikɨ 'Ekipitu paitɨ».   
\p
\v 5 Hikɨ Muitsexi, 'Aruni hamatɨa kwiepa mekaniukaxɨrieni yɨhɨxima 'ixaheritsixi wahɨxie.  
\v 6 Mana mekaniti'ukaitɨni Kutsuhexi Nuni nu'aya meta Karewi Kepune nu'aya yukamixa mekaneukatsanaxɨani hiwerika 'ɨnɨariyari mewewietɨ. Mɨkɨ memekɨkɨnixɨakai kepauka kwie memekuxeitsie,  
\v 7 hikɨ mɨpaɨ mekateniwarutahɨawe yunaime 'ixaheritsixi:  
\p —Kwie temekuxei matsi 'aixɨa kane'aneni temɨkateheyeneniere hepaɨ.  
\v 8 Xɨka Yawé tatsiparewiekamɨkɨ mana kataniye'atɨamɨkɨ. Kataniyetuiriemɨkɨ kwie hakewa waɨkawa mexuawe retsi meta xiete.  
\v 9 'Ayumieme Yawé hɨxie 'axaxepɨkateyu'eniwani meta mana teɨteri memetama xepɨkawareumakaxeni. Tixaɨtɨri mepɨkatehɨkɨ, yuhetsie nunuwame mepɨkahexeiya, tame Yawé kataniparewimɨkɨ. 'Ayumieme xepɨkawareumakaka.   
\p
\v 10 Peru yunaitɨ 'ixaheritsixi mɨpaɨ memɨte'uxatakaikɨ memɨwatituaxakɨ, Yawé xawatɨriyaya tuki hɨxie kaniuyuhekɨata 'ixaheritsixi yunaime wahɨxie.  
\v 11 Hikɨ Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\p —¿Kepaukake mepɨtehayewa 'axamenetekumamateketɨ 'ikɨ teɨteri? ¿Kepaukake yuri mepɨteta'erieni nehetsie, mamariwaweme tɨtɨtsɨ watsata nemɨtiyuriene?  
\v 12 Kwiniya nekananunɨ'amɨkɨ wahetsiemieme mɨwakwinikɨ, 'ahetsie xeikɨa kiekari kanayenemɨkɨ mariwetɨ tɨrɨkaɨyetɨ keyamemutiyuane.   
\p
\v 13 Muitsexi Yawé mɨpaɨ katiniutahɨawe:  
\p —Kenaye'eri kepauka 'ekɨ 'atɨrɨkariyakɨ 'Ekipitu pemɨwarayewitɨ 'ikɨ teɨteri. Kepauka 'ekipitutari memɨtehetimani kepemɨtiuyuri,  
\v 14 mɨpaɨ mekateniwataxatɨakuni 'ikɨ kwieyaritsie kiekatari, mɨpaɨ memɨtemate kename 'ekɨ Yawé 'ahɨxie tematsixeiya, 'ahai 'ateɨterima waheima muyeyeixa, kename 'ekɨ pehɨkɨ pemɨwaruwituxime, tukarikɨ hai 'a'uwemekɨ, tɨkarikɨta taikɨ.  
\v 15 Xɨka pewarukwini yunaime 'ikɨ teɨteri, yunaitɨ nuiwarite mumanetɨka memu'enana hepaɨtsita mɨpaɨ mekanitiyuakuni:  
\v 16 “Yawé pɨka'uyɨwekaxɨa 'ikɨ teɨteri mɨwaranuwitɨnikɨ hakewa kwie mɨwarexatɨakai, kaniwarutixɨtɨani makumawetsie wakwitɨ”.   
\p
\v 17 »Neuxei hikɨ Yawé, 'atɨrɨkariya kenehekɨatani. 'Ekɨ mɨpaɨ pemainekɨ  
\v 18 Yawé kename pekahayu'eriya matsi waɨkawa peti'akanaki'erie meta xeniu pereuyehɨwirieni 'axamɨti'ane meta kemɨ'ane matsi'uku'eiri, peru matsi kemɨ'ane 'axamɨtiuyuri pepɨtikwinitɨani meta niwemamatsie, teukarimamatsie, tutsimamatsie, meta mɨkɨ waniwema wahetsiepaitɨ.  
\v 19 Waɨkawa pemɨti'akanaki'eriekɨ nepɨmatsiwawirie pemɨtiwareuyehɨwirienikɨ 'ikɨ teɨteri 'axakememɨte'uyuri, 'Ekipitu memayekɨtsietɨtɨ kepemɨtiwareuyehɨwiriekai hikɨta yaxeikɨa».   
\p
\v 20 Yawé mɨpaɨ katinita'eiya:  
\p —Penetiwawirie nemɨtiwareuyehɨwirienikɨ, nekatiniwareuyehɨwiriemɨkɨ.  
\v 21 Yurikɨ nehetsiemieme mɨpaɨ nekanaineni, meta nexawatɨriya kwiepa naitsarie mɨhɨnekɨ,  
\v 22 tsepanetɨ nexawatɨriya memuxei meta mamariwawemekɨ kenemɨtiuyuri 'Ekipitu meta makumawetsie, 'iya kemɨ'ane yuri memɨkaneteheta'eriri, mɨixamexɨa memɨnetsiheta'inɨataxɨ  
\v 23 pɨka'ixeiya kwie wa'ukiyarima yuri nehaitɨ nemɨwayetuirienikekai. Nixewitɨtɨma mɨnetsi'utaniukima pɨka'ixeiya.  
\v 24 Neti'uximayatsiriwame Karewi, yɨkɨ'anekame 'iyari kanexeiyani, 'aixɨa katinikamieni, nekanixatɨamɨkɨ kwie ke'anekame mexei meta nuiwarimama wahetsiemieme kanayeimɨkɨ.  
\v 25 'Uxa'a Haramara Mɨxeta hepa xekenehu, 'amarekitsixi meta kananeutsixi mayeweritsie memekiekɨ.   
\p
\v 26 Yawé Muitsexi 'Aruni mame mɨpaɨ katiniwarutahɨawe:   
\p
\v 27 —¿Kepaukake mepɨtehayewa 'ikɨ teɨteri 'axame'utiyuatɨ menetsiniukimatɨ? Nekaniwa'enieka kehepaɨ memɨteniukixie 'ixaheritsixi nehetsiemieme.  
\v 28 Hikɨ mɨpaɨ ketiniwarutahɨawi nehetsiemieme: “Yurikɨ nehetsiemieme mɨpaɨ nepaine, ketita xemɨteheuyehɨwa yanekatiniyurimɨkɨ.  
\v 29 Yunaitɨ xeme xekanikwikuni makumawetsie xekaxari 'ena puyuhayewa. Nixewitɨ memaka'utsie xeitewiyari wiyari mehexeiyatɨkaitɨ 'axamemutiyua nehetsiemieme,  
\v 30 kwie pɨkayetuiriyarieni nemɨxexatɨa. Mana xeikɨa mekaneutahaxɨakuni Karewi Kepune nu'aya meta Kutsuhexi Nuni nu'aya.  
\v 31 Tɨɨri xeikɨa kwiepa mekaneutahaxɨakuni xeme mɨpaɨ xemutiyuakɨ kename kuyaxi mewaranuwitɨni wahetsiemieme memakɨnekɨ. Mɨkɨ mekaniyɨakakuni mɨkɨ kwietsie memu'uwani xeme xemitixani'eritsie.  
\v 32 Xeme xe'umete 'ena makumawetsie kaniyuhayewamɨkɨ.  
\v 33 Huta tewiyari wiyari xeniwema 'ena makumawetsie mekaniu'uwakuni. 'Ikɨ mekatenanutɨkuni kexemɨkateheu'enana, yunaitɨ xe'akuxɨyuke.  
\v 34 Kwie xemekuxeitsie huta tewiyari tukari xepeyuri, hikɨta xeitukari pɨ'inɨarini xeiwiyari. Huta tewiyari wiyari xekaniyurikuni xete'uka'eniwatɨ 'axaxemɨte'uyurikɨ, mɨpaɨ xekatenetimaikuni kenemɨtixe'aye'unie”.  
\v 35 Ne Yawé nekanihɨkɨtɨni, nekatinaye'atɨamɨkɨ kemɨre'uxa kenemutayɨ 'ikɨ teɨteri 'axamemɨte'u'iyari wahetsiemieme, mekaniyukuxeɨrieni menetsi'aye'unietɨ. 'Ena makumawetsie mekanikumawerikuni. 'Enatɨtɨ mekanikwikuni.   
\p
\v 36 'Iya 'ukitsi Muitsexi mɨwarutanɨ'akai kwie memɨxeiyayukɨ mɨkɨ mekaniɨyɨni, mehakunuaxɨaka yɨkɨpɨta memɨte'uxa kename kwie 'axahe'anekai. Mɨpaɨ me'utiyuaku yunaitɨ teɨteri mekaniuyu'uximatɨani.  
\v 37 'Ayumieme 'ikɨ 'itarikakɨ niuki memutsutɨa kwie hepaɨtsita miemeyari, Yawé hɨxie mekaniukwini kwiniyakɨ.  
\v 38 Yunaitɨ kwie memekuxeiyakai, Kutsuhexi xeikɨa kaniuyuhayewa Nuni nu'aya meta Karewi Kepune nu'aya.   
\s1 'Ixaheritsixi mekaniyuta'inɨata kwietsie mieme  
\p
\v 39 Kepauka Muitsexi mɨtiutahayewaxɨ mɨpaɨ tiwakɨhɨawetɨ yunaitɨ 'ixaheritsixi mekaniutitsuanakaitɨni karima meyuhiwerietɨ.  
\v 40 'Uxa'arieka ximeri paitɨ mekananutikɨne hɨritsie 'amanutitewatsie 'ixaheritsixi mɨpaɨ me'utiyuatɨ:  
\p —Tekanihuni kwie Yawé mɨtatsi haxatɨatsie, mɨpaɨ temɨtematekɨ kename 'axatete'uyuri.   
\p
\v 41 Peru Muitsexi mɨpaɨ katiniwarutahɨawe:  
\p —¿Titayari tawarita Yawé niukieya xekate'enieni? Hikɨ kexemɨteku'eriwa yapɨkatiyunake.  
\v 42 Xɨka xeheukɨne xekana'iwariekuni, Yawé xehamatɨa mɨka'uyeikakɨri.  
\v 43 'Amarekitsixi meta kananeutsixi wahamatɨa xekaneyutakwikuni, mɨkɨ mekanixekwikuni 'ixiparakɨ. Xeme Yawé xemuku'eiri, mɨkɨ pɨkaxeparewieni.   
\p
\v 44 Mɨkɨ meka'enanatɨ matsi mekanekɨne mɨhɨriyatsie paitɨ, Muitsexi meta Yawé kakunieya tɨratu mayeka wahamatɨa mekahayekɨneku mematiteitsie.  
\v 45 Hikɨ 'amarekitsixi meta kananeutsixi mana memɨkiekataritɨkai mekaniwarutakwini mekaniwara'iwa, mewaruweiyatɨ Kuxima mɨrayetewatsie paitɨ mekaniwaye'atɨani.   
\c 15  
\s1 'Aitsika mawarika hetsiemieme  
\p
\v 1 Yawé Muitsexi mɨpaɨ katiniutahɨawe  
\v 2 'ixaheritsixi mɨpaɨ mɨtiwatahɨawekɨ: «Kepauka xemeutahaxɨani kwietsie hakewa nemɨxehexatɨa mana xemutitenikɨ,  
\v 3 xɨka xewitɨ Yawé reumawiriemɨkɨni, xeime wakaxi, xeime muxa, meta mawari taipa warɨkariekame, mawari taiyariyari meta mɨyɨhɨritɨani mawariyari, yatɨni kemɨtiyuwaɨriya mawariyari, yatɨni 'ixɨarari patsiekamekɨ memɨyukuxexeɨriwa. Mɨkɨ mawarika witsimu'ɨa Yawé minake,  
\v 4 kemɨ'ane yumawari mɨyetuani kanenayatsamɨkɨ hatsite mawariyari, huta kiruyari tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseiti xeirituruyarikɨ pɨnariekame.  
\v 5 Yawé xɨka muxa nunutsi 'utimawirieni mawari taiyariyari mayanikɨ, yaxeikɨata heutinɨkame xeirituruyari kaxie winuyari mɨtayeuriwa.   
\p
\v 6 »Muxa 'uki xɨka hɨkɨtɨni, hamatɨana hatsite mawariyari kaniyetuamɨkɨ nauka kiruyari tɨriku mɨtɨxiyari 'aixɨa mɨ'ane, hatseiti xeirituruyari heimana 'imeriyukɨ pɨnariekame.  
\v 7 Mɨta'ɨyarienikɨ winu xeirituruyari heimana 'imeriyu. Mɨpaɨ 'anetɨ 'aixɨa 'u'ɨatɨ kanayeimɨkɨ Yawé hetsiemieme.   
\p
\v 8 »Xɨka tsikeru xeime peyetuamɨkɨ mawari taiyariyari mayanikɨ, yatɨni kemɨtiyɨhɨritɨa meye'atɨanikɨ, yatɨni 'aixɨa memɨteyuxeiyanikɨ mawariyari Yawé hetsiemieme,  
\v 9 tsikeru hamatɨa pekanitimawamɨkɨ hatsite mawariyari, 'ataxewime kiruyari tɨriku mɨtɨxiyari 'aixɨa mɨ'ane huta rituruyari hatseitikɨ pɨnariekame.  
\v 10 Yaxeikɨata kaxie winuyari mɨtiyeuriwa huta rituruyari heutinɨkame. Taipa warɨkariekame mawariyari mayanikɨ, mɨkɨ mawarika witsimu'ɨa Yawé minake.  
\v 11 Yuxexuitɨ wamawarikayari tsikeru, muxa 'uki, muxa temaikɨ, meta tsipu, yapɨtikuwewiwani kemɨre'inɨari.  
\v 12 Mɨpaɨ pekatiniyurienemɨkɨ yuxexuime wahetsiemieme, tsepa kememɨyupaɨme tewaxi pemɨwayetua.   
\p
\v 13 »Kemɨ'ane 'Ixaheri tewiyari mɨtitimawa taipa miemeyaritsie, Yawé 'aixɨa mɨti'ɨkwekɨ, 'ikɨ 'aitsika kehaye'atɨani.  
\v 14 Yatɨni ku'uwamete xehamatɨa muka yaxeikɨa katiniyurimɨkɨ taipa mawariyari meta 'aixɨa mu'ɨa Yawé hetsiemieme wewimɨkɨni 'ikɨ 'aitsika kehaye'atɨani,  
\v 15 xekiekaritsie xewitɨ 'aitsika xeikɨa kaniuyeikamɨkɨ 'ahetsiemieme meta 'ateewa kiekame hetsie 'akiekaritsie muka. 'Ikɨ 'aitsika 'anuiwarima wahetsiemieme kanihɨkɨtɨni. 'Ekɨ meta 'ateewa kiekame yaxeikɨa xekani'aneneni Yawé hɨxie.  
\v 16 'Ayumieme mɨkɨ 'aitsika xeyunaime xehetsie katini'aitani 'ahetsie meta kuyeikame hetsie 'ahamatɨa muka».   
\s1 'Ikwaxi matɨari mieme mawariyari  
\p
\v 17 Yawé Muitsexi mɨpaɨ katiniutahɨawe  
\v 18 'ixaheritsixi mɨpaɨ mɨtiwatahɨawekɨ: «Kepauka kwietsie xemeutahaxɨani hakewa nemɨxehewitɨ,  
\v 19 mana mɨretixuxuawere xɨka xetehetikwani, Yawé hetsie timieme xekateneyetuakuni.  
\v 20 Kepauka matɨari paa peme'imanitsie, mɨtiyetuiwatsie timieme pekaniyetuamɨkɨ, harina 'aixɨa mɨ'ane papayari.  
\v 21 Yunaitɨ 'anuiwarima mekateniyetuayakuni yemekɨ Yawé hetsiemieme matɨari memɨte'imanitsie timieme.   
\s1 Mawarika 'axamɨtiuyuri hetsiemieme kepauka mɨka'imani  
\p
\v 22 »Mɨpaɨta pɨtiɨyɨwe mɨpaɨ xekateha'eriwatɨ 'axaxepɨte'uyuriwawe, 'inɨari niukiyaritsie Yawé miyetua Muitsexi hetsɨa,  
\v 23 naime 'inɨari Yawé mɨxeyetuirie Muitsexi hetsɨa, kepauka mɨpaɨ mutayɨ kename xenuiwari wahetsiemiemetɨni.  
\v 24 Xɨka 'axamete'uyurieni yunaitɨ kiekatari mɨpaɨ mekateha'eriwatɨ, hikɨ mɨkɨ xeime tsikeru xeiwiyari hɨkame mekanitataiyakuni witsi'u'ɨakame Yawé minake, kaxie winuyari mɨtayeuriwa heutinɨkame, hatsite mawariyari, xeime tsipu 'uki 'itiya mawariyari mayanikɨ, kemɨre'uxa.  
\v 25 Hikɨ mawari wewiwame yunaime 'ixaheritsixi kaniwaxɨnamɨkɨ, mekateneuyehɨwiyariekuni memɨka'imakɨ, meta Yawé hetsiemieme mawarika taiyariyari memuwewikɨ meta 'itiya mawariyari memuwewikɨ meta 'axamemɨte'uyuri meka'imaitɨwetɨ.  
\v 26 Yunaitɨ teɨteri 'ixaheritsixi mekateneuyehɨwiyariekuni, meta 'ateewa kiekatari, yunaitɨ 'axamemɨte'uyurikɨ meka'imaitɨwetɨ yuhetsie.   
\p
\v 27 »Xɨka yuxaɨta 'axatiuyurieni ka'imainetɨ, xeime tsipu 'ukaratsi kaniyetuamɨkɨ xeiwiyari hɨkame 'itiya mawariyari mayanikɨ.  
\v 28 Mawari wewiwame kanixɨnamɨkɨ Yawé hɨxie 'axamɨtiuyuri ka'imainetɨ. Mawari wewiwame yakatiniyurimɨkɨ, hikɨ tewi 'axamɨtiuyuri katineuyehɨwiyariemɨkɨ.  
\v 29 'Ikɨ yuxewitɨ xeikɨa 'inɨari yunaitɨ wahetsie kanimiemetɨni kemɨ'ane 'axamɨtiuyuri ka'imainetɨ, 'ixaheri tewiyari hetsiemieme meta 'ateewa kiekame wahamatɨa muka hetsiemieme.   
\p
\v 30 »Peru kemɨ'ane 'axamɨtiuyuri mima, tsepa mana munuiwakame yatɨni 'ateewa mɨkiekame, Yawé hɨxie 'axakatiniuyurieni. Mɨkɨ yuteɨterima watsata payeweiyarieni.  
\v 31 Yuhetsie kanihɨimɨkɨ Yawé niukieya mutananaimakɨ, 'inɨari niukiyaritsie yamɨkatikatɨakɨ».   
\s1 'Uxipiya tukari mɨnanaima  
\p
\v 32 Heiwamieme 'uxipiya tukaritsie, 'ixaheritsixi me'uxipiekaku makumawetsie, xewitɨ 'ixaheri kaniuxeiyarieni kɨyexi naiwame 'ɨnetɨ.  
\v 33 Hikɨ kemɨ'ane memixei meneiwitɨni Muitsexi meta 'Aruni wahetsɨa yunaime 'ixaheritsixi wahɨxie.  
\v 34 Matɨari kananutahɨiyakatɨni xeikɨa, mɨkahahekɨakaikɨ kememiyurienikekai.  
\v 35 Hikɨ Yawé Muitsexi mɨpaɨ katiniutahɨawe: «Mɨkɨ tewi ke'umierieni. Yunaitɨ 'ixaheritsixi mekeheitituaxixɨani 'ateewa paitɨ».  
\v 36 Hikɨ 'ixaheritsixi mematiteitsie 'aheteewakaku mekaneihana, mekaneitituaxixɨani mekanimieni, Yawé Muitsexi kemɨrahɨawekai.   
\s1 Matawɨ memaye'eriwanikɨ  
\p
\v 37 Yawé Muitsexi mɨpaɨ katiniuta'aitɨani  
\v 38 'ixaheritsixi mɨpaɨ mɨtiwatahɨawekɨ: «Xeme xeyunaitɨ xenuiwarima yukamixa 'amɨtɨtɨtsie matawɨre xekanawipaxɨakuni hiru mɨyɨtsikimaɨyekɨ.  
\v 39 Mɨkɨ matawɨ xekamixatetsie kanixeparewiemɨkɨ xemaye'eriwanikɨ, naime 'inɨari niukiyari Yawé hetsiemieme xemɨkayuwaɨriyanikɨ xe'iyari kemɨtixekuyuitɨwa meta xehɨxite ketita mɨreuhiwe'erie.  
\v 40 Naime ne'aitsika xekanexeiyakakuni, xekaneye'atɨakakuni. Mɨpaɨ xe'anetɨ neteɨterima memɨpatsie xekanihɨkɨtɨkakuni  
\v 41 Ne Yawé xekakaɨyari nekanihɨkɨtɨni, nemɨxe'ayewitɨ 'Ekipitu xekakaɨyari nemayanikɨ. Ne Yawé nepɨhɨkɨ».   
\c 16  
\s1 Kure, Ratani meta 'Awirani ke'axamemɨte'uyuri  
\p
\v 1 Merikɨte Kure 'Itsaxi munu'ayatɨkai, Kuhati mɨteukarieyatɨkai meta Rewi mɨtutsieyatɨkai. Meta xuwenitsixi Ratani meta 'Awirani 'Eriyáwi niwemama meta 'Uni Pereti niweya,  
\v 2 mɨkɨ Muitsexi hepaɨtsita mekateniutixatatɨkɨne mewaparewiekaku huta tsienituyari heimana huta tewiyari heimana tamamata 'ixaheritsixi. Yunaitɨ mɨkɨ mekani'uitɨariekaitɨni, memanuyetei 'ixaheritsixi memɨwaranuka'uitɨakai.  
\v 3 Mekaniuyukuxeɨrieni Muitsexi meta 'Aruni wahepaɨtsita memeuniunikɨ, mɨpaɨ mekateniwarutahɨawe:  
\p —Xemeri yemekɨ mamariwawemete xepayuyeitɨa. Xɨka 'ikɨ kiekari patsieka meta kiekatari, ¿titayari xeme Yawé kiekarieya kutsiyarima xetehayuyeitɨwa?   
\p
\v 4 Kepauka Muitsexi mu'enaxɨ kememutiyuanekai, kaniukatunumakeni  
\v 5 mɨpaɨta Kure katiniutahɨawe meta yunaime:  
\p —'Uxa'a Yawé yapɨtayɨni kemɨ'ane hetsienamieme mɨpatsie. Mɨkɨ menayexei kanihɨkɨtɨni, mɨkɨ kanita'inimɨkɨ.  
\v 6 Merikɨte Kure, mɨpaɨ xekateniyurikuni 'uxa'a 'ateɨterima yunaitɨ: 'ɨkwa taiyame xekaniti'ɨikuni,  
\v 7 tɨɨ xekanakayatsakuni 'ɨkwa witsimu'ɨa xekenakawiwiexɨa Yawé hɨxie. Kemɨ'ane manayexeiya mɨkɨ kanihɨkɨtɨkamɨkɨ. Xemetɨtɨ Rewi niwemama xepɨhɨkɨ kwinimieme memɨtehanutihu.   
\p
\v 8 Muitsexi Kure mɨpaɨ katiniutahɨawe:  
\p —Hikɨta xekeneneu'eni rewitsixi.  
\v 9 ¿Kamɨtsɨ tixaɨtɨ xekatehayeitɨa Yawé mɨxe'anayexei 'ixaheritsixi watsata 'ahurawa 'auriena xemu'uwanikɨ, Yawé tukita xemɨte'uximayakakɨ, hipatɨ memɨka'ane wahepaɨ xemɨte'uximayakakɨ?  
\v 10 Kakaɨyaritɨtɨ yu'aurie kanixeti'uitɨaka, 'ekɨ meta rewitsixi yunaitɨ, ¿hikɨta mawari wewiwamete xetekɨniku?  
\v 11 'Ekɨ, 'ateɨterima yunaitɨ xekaniuyukuxeɨrieni Yawé hepaɨtsita 'axaxe'utiyuatɨ, tixaɨtɨ 'Aruni pɨkatihɨkɨ xeminiukima.   
\p
\v 12 Muitsexi Ratani meta 'Awirani, 'Eriyáwi niwemama katiniwarutanɨ'airieni, peru mɨkɨ mɨpaɨ mekaniutiyuani:  
\p —Tame tepɨkahu.  
\v 13 ¿Kamɨtsɨ tixaɨtɨ pekarayeitɨa pemɨtatsi'ayewitɨ hakewa retsi meta xiete waɨkawa mexuawe, pemɨtatsikwiximenikɨ 'ena makumawetsie ti'aitame pemayuyeitɨanikɨ tahetsie?  
\v 14 Kaniyuritɨni 'ekɨ pepɨkatatsi 'atɨawe 'akuxi hakewa xeniu retsi meta xiete waɨkawa mexuawe meta kwiepa mɨraka'etsitɨre meta kaxie haraweriyari pepɨkatatsiyetuiriewe. Xɨari tekaheuneniereme pekatani'erieka para temɨmatsi'uweiyanikɨ. Tame matsi tepɨkayehu.   
\p
\v 15 Hikɨ Muitsexi waɨkawamekɨ ha'atɨ, Yawé mɨpaɨ katiniutahɨawe:  
\p —Wamawari pepɨkanaki'erieka tita memɨtehapini, ne xeime nixeime wapiinite nepɨkatiwanawairiewe meta watewama nepɨkatiwakwinitɨa.   
\p
\v 16 Muitsexi Kure mɨpaɨ katiniutahɨawe:  
\p —'Ekɨ meta 'ateɨterima meta 'Aruni 'uxa'a 'ena Yawé hɨxie xekaniti'uikuni.  
\v 17 Yuxexuitɨ xeme Yawé hɨxie 'ahurawa xekaniɨkɨnikuni 'ɨkwa taiyametsie 'ɨkwa witsimu'ɨa hɨpɨneme xe'u'ɨtɨ, huta tsienituyari heimana huta tewiyari heimana tamamata 'ɨkwa taiyame xe'u'ɨtɨ 'ahurawa xekaniɨkɨnikuni. Meta 'ekɨ 'Aruni hamatɨa yuputsiwiwame xekananu'ɨikuni.   
\p
\v 18 Hikɨ yuxexuitɨ 'ɨkwa taiyame me'u'ɨtɨ 'ixuriki tukiyari hɨxie mekaniti'uni, Muitsexi meta 'Aruni wahamatɨa.  
\v 19 Kepauka Kure yunaime yuteɨterima muwarukuxeɨri Muitsexi meta 'Aruni wahepaɨtsita 'axamemɨtiyuanekai 'ixuriki tukiyari hɨxie Yawé yuxawatɨriya kaniuhekɨata mɨkɨ wahɨxie.  
\v 20 Hikɨ Yawé Muitsexi meta 'Aruni mɨpaɨ katiniwarutahɨawe:   
\p
\v 21 ―Xekeneutayeixɨa mɨkɨ teɨteri wahamatɨa xepɨkati'uka, ne nekaniwakwimɨkɨ hikɨ.   
\p
\v 22 Hikɨ Muitsexi 'Aruni hamatɨa kwiepa mekaniukahɨxima'uni, mɨpaɨ mekateniuhiwa:  
\p —Yawé, yunaime teɨteri wahetsiemieme pemɨkakaɨyari: xewitɨ xeikɨa tewi 'axapɨtiuyuri, ¿'ekɨta petiyeha'ani yunaime 'ikɨ wahetsiemieme?   
\p
\v 23 Hikɨ Yawé Muitsexi mɨpaɨ katiniutahɨawe:   
\p
\v 24 —Yunaime 'ixaheritsixi mɨpaɨ ketiniwarutahɨawi Kure, Ratani meta 'Awirani waxamaru mati'u mepɨka'ukɨkani.   
\p
\v 25 Hikɨ Muitsexi meta 'ukirawetsixi 'ixaheritsixi wahetsiemiemete mekanekɨne hakewa memetitekai Ratani meta 'Awirani.  
\v 26 Hikɨ Muitsexi 'ixaheritsixi mɨpaɨ katiniwarutahɨawe:  
\p —'Ikɨ 'axamemɨte'u'iyari waxamaru 'aurie xepɨka'u'uwani. Tixaɨtɨ wapiini xepɨkatekumaɨwani, xemeta kapa xete'ukwinitɨarienikɨ mɨkɨ 'axamemɨte'uyurikɨ.   
\p
\v 27 Hikɨ teɨteri mekaneutayeixɨani, Kure, Ratani meta 'Awirani waxamaru 'aurie. Ratani meta 'Awirahami 'amemɨtewayekɨ yuxamaru kitenie, mana mekaniti'ukaitɨni yu'ɨitama meta yuniwema mewarawitɨtɨ.   
\p
\v 28 Muitsexi tawarita mɨpaɨ kaniutayɨni:  
\p —Hikɨ xekatenetimaikuni xɨka Yawé netsinɨ'aka yatɨ kenemɨtinekɨhɨawe xeikɨa nepɨtiyuriene.  
\v 29 Xɨka 'ikɨ teɨteri kwiniyakɨ me'ukwini, 'ana mɨpaɨ katinimatsiɨkɨni kename ne Yawé kanetsiheyenɨ'a.  
\v 30 Xɨkata Yawé hekwamekɨ yɨkɨ tiuyurieni kwie 'anutayepieni, xɨka wareukakwani meta naime wapiinite, xɨka me'ayenenieretɨ meheukateukieni, hikɨ 'ana mɨpaɨ xekatenetimaikuni kename mɨkɨ Yawé tixaɨtɨ katihɨkɨtɨme me'ayeitɨa.   
\p
\v 31 Kepauka Muitsexi 'amɨtiutahayewaxɨ, kwie wahetɨa kaneukapene,  
\v 32 kaneukaxaware kaniwareukakwani, mɨkɨ meta watɨɨriyama, meta hipatɨ teɨteri Kure tipiinieya naitɨ.  
\v 33 Me'ayenenieretɨ kwieta mekaneukayune, meta naitɨ tita memɨtehexeyakai, kwie waheimata nanunare. Mɨpaɨ mɨkɨ mekateniukumaweriyarieni 'ixaheritsixi watsata.  
\v 34 Yunaitɨ 'ixaheritsixi mekaniyuta'unaxɨani mewa'enietɨ mɨpaɨ mete'uhiwatɨ:  
\p —Tepɨtinautsa, tameta kwie tatsi'anukakwani.   
\p
\v 35 Meta mɨkɨ 'ukitsi huta tsienituyari heimana huta tewiyari heimana tamamata 'ɨkwa taiyame memu'ɨkai Yawé taikɨ kaniwarukwini.   
\s1 'Ɨkwa taiyamete  
\p
\v 36 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 37 «'Eriyatsaxi mawari wewiwame mɨpaɨ ketineuta'aitɨa 'Aruni nu'aya, 'ɨkwa taiyamete mɨpatsietɨka mɨ'ɨimiekɨ, mana tɨɨxariyari muyuhayewaxɨ kehewiwieni 'ateewa paitɨ.  
\v 38 'Ɨkwa taiyamete keneuti'ɨi 'iya 'axameteyurietɨ memukwi tiwapiini, kɨmana mawari taiyame pekanikawiriemɨkɨ. Mɨkɨtsɨ kanipatsietɨkani, Yawé mɨyetuiriyariekɨ, mɨkɨ 'inɨari 'ixaheritsixi wahetsiemieme mɨhɨkɨtɨnikɨ».   
\p
\v 39 Hikɨ mawari wewiwame 'Eriyatsaxi mɨkɨ 'ɨkwa taiyamete kaniuku'ɨni, mɨkɨkɨ tepɨa weweritɨ mɨtiwewiyanikɨ katiniuta'aita mawari taiyame heima mɨkawerarienikɨ.  
\v 40 Mɨkɨ tepɨa muwa kaniuyuhayewa 'ixaheritsixi memimakaxenikɨ, xewitɨ 'Aruni kaxiɨyarieyatɨtɨ meta mɨpaɨ kati'aitɨarietɨ mɨpaɨ mɨkatiyurienenikɨ Yawé 'ɨkwa witsimu'ɨa mɨkatairiekakɨ, xɨka mɨpaɨ tiuyurieni Kure meta niwemama wahepaɨ mekatenikwikuni, mɨpaɨ katiniuyɨni Yawé Muitsexi kemɨtiuta'aitɨakai.   
\s1 'Aruni teɨteri wahetsie kemɨtiutanua  
\p
\v 41 'Uxa'ariekata, yunaitɨ 'ixaheritsixi Muitsexi meta 'Aruni mekaniwarutiniukimatɨkɨne mɨpaɨ me'utiyuatɨ:  
\p —Xeme Yawé teɨterimama xekaniwarukwini.   
\p
\v 42 Teɨteri 'axamemutiyuanekaikɨ Muitsexi meta 'Aruni wahepaɨtsita mɨkɨ mekanekɨne 'ixuriki tukiyarita. Hikɨ yapauka hai tuki kananukanani, Yawé xawatɨriyaya kaniuyuhekɨare.  
\v 43 Hikɨ Muitsexi 'Aruni hamatɨa mekanewa'uni tuki hɨxie,  
\v 44 Yawé Muitsexi mɨpaɨ katiniutahɨawe:   
\p
\v 45 —'Ikɨ teɨteri pepɨkawanɨka, ne hikɨ nepɨwatixɨtsitɨani yunaime.  
\p Hikɨ mɨkɨ mekaniutihɨxima'uni kwiepa,  
\v 46 hikɨ Muitsexi 'Aruni mɨpaɨ katiniutahɨawe:  
\p —'A'ukwa taiyame keneuti'ɨka mana tɨɨ kenekayatsaka mawari taiyametsie mieme, muwa 'ɨkwa witsimu'ɨa mana kenekawiwi, kenemie mexɨima hakewa memeyuxeɨrie watsata, mana pemɨwarexɨnakɨ, Yawé haxɨaya kaninuani wahetsie meta 'iwaɨyɨ wahetsie katiniunake.   
\p
\v 47 'Aruni yakatinikayani Muitsexi kemɨrehɨawekai, kaniutanautsa teɨteri wahixɨapa mɨtakenikɨ. 'Iwaɨyɨ wahetsie katiniunakekaitɨniri, hikɨ 'Aruni 'ɨkwa witsimu'ɨa kaniutaiya teɨteri kɨmana memɨxɨnarienikɨ.  
\v 48 Mana memayeneniere meta memɨkwikwi'i watsata kaniutakeni, 'ana kwiniya katiniuhayewa.  
\v 49 'Ana tamamata heimana nauka miriyari heimana 'atahuta tsienituyari teɨteri mekaniukwini, meka'inɨaritɨ Kure hamatɨa memukwi.  
\v 50 Hikɨ kememɨtekwi'ikai heunuaku, 'Aruni kaninuani tuki hɨxie hakewa Muitsexi mekatei.   
\c 17  
\s1 'Aruni 'itsɨya  
\p
\v 1 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 2 «'Ixaheritsixi mɨpaɨ ketiniwarutahɨawi tamamata heimana huta 'itsɨ mepa'ɨni xeinuiwariyaritsie miemete xexuime. Wa'itsɨtsie mepa'utɨkani kemɨtitewaka nuiwari.  
\v 3 Rewi 'itsɨyatsie 'Aruni pɨta pekaneu'utɨamɨkɨ, yuxexuitɨ memanuyetei yu'itsɨ mekanexeiyakakuni.  
\v 4 Tɨratu kakuniyari manuka hɨxie keneuti'uitɨa hakewa xehamatɨa nemɨretixaxata.  
\v 5 Kemɨ'ane 'itsɨya mɨtayɨra mɨkɨ nemenayexeiya kanayeimɨkɨ. Mɨpaɨ 'ixaheritsixi mekatenihayewakuni menetsi'uximatɨatɨ ke'axamemutiyuane xehepaɨtsita».   
\p
\v 6 Hikɨ Muitsexi 'ixaheritsixi mɨpaɨ katiniwarutahɨawe, memanuyetei tamamata heimana huta 'itsɨ mekaniyetuaxɨani, xexuime nuiwaritetsie miemete. 'Aruni 'itsɨya wahamatɨa kanayewekaitɨni.  
\v 7 Muitsexi 'aixɨa katini'uitɨani tukita paitɨ Yawé hɨxie meta tɨratu kakuniyari muyeka hɨxie.   
\p
\v 8 'Uxa'arieka ximeri Muitsexi heutahaku tɨratu kakuniyari muyeka, kepauka 'Aruni 'itsɨya muxei Rewi nuiwariyaritsiemieme kaniyɨrakaitɨni 'arimetɨra, 'etsipepetɨ heukatetɨ meta tuturiyari yutakariyari hexeiyatɨ.  
\v 9 Hikɨ Yawé hɨxie naime 'itsɨte kanewaye'ɨni, 'ixaheritsixi wahɨxie kaniti'uitɨani, memixeiyakɨ kemɨtiuyɨkai, hikɨ yuxexuitɨ yu'itsɨ mekaniuti'ɨni memanuyetei.   
\p
\v 10 Yawé Muitsexi mɨpaɨ katiniutahɨawe: «Hutarieka 'Aruni 'itsɨya tɨratu kakuniyari hɨxie keneutiketsa, mana mekanixeiyakuni 'axamemutiyuane. Mɨpaɨ mekatenihayewakuni 'axame'utiyuatɨ nehetsiemieme meta 'ixaheritsixi memɨkakwi'inikɨ».   
\p
\v 11 Muitsexi yakatiniuyurieni Yawé kemɨtita'aitɨakai.  
\v 12 Hikɨ 'ixaheritsixi Muitsexi mɨpaɨ mekateniutahɨawe: «Tame tekanitatɨmaiyariekuni, yemekɨ tekaneuyewekuni. Tekanikwikuni.  
\v 13 Yunaitɨ kemɨ'ane Yawé tukieya manuwe memɨye'axe mekanitakukuweni, 'ayumieme tame teyunaitɨ tekanikwikuniri».   
\c 18  
\s1 Mawari wewiwamete meta rewitsixi kemɨtiwahɨritɨarika  
\p
\v 1 Yawé 'Aruni mɨpaɨ katiniutahɨawe: «Yunaitɨ Rewi xiɨyarimama muwa mɨtipatsietɨka mɨrayepine 'aurie mepɨka'ukɨkani, 'ekɨ meta 'aniwema xehetsie xeikɨa katinahɨiyamɨkɨ, xeme xɨka 'axaxete'uyurieni kemɨkatixe'uximayatsika xemɨmawari wewiwametekɨ.  
\v 2 Kepauka 'ekɨ meta 'aniwema xemɨte'uximayaka 'ixuriki tukiyarita kakuni tɨratuyari muyeka, xe'iwama Rewi nuiwarimama mekanixeparewiekakuni.  
\v 3 Mɨkɨ mekameniparewiekakuni kepemɨtiyurieneni, mɨkɨ mekani'ɨwikakuni 'ixuriki tukiyari, 'ahurawa xeikɨa mepɨka'ukɨkani piinite mɨtipatsietɨka 'aurie meta mawari taiyametsie, xemɨkatakukuwenikɨ.  
\v 4 Mɨkɨ 'aparewiwamete mekanihɨkɨtɨkakuni, tuki mekanixeiyakakuni meta naitɨ muwa kemɨtikumayɨiwa. Merikɨte kepauka xeme xemɨte'uximaya xewitɨ pɨkaxeparewieka mɨpaɨ mɨkaranayexeiyarie.   
\p
\v 5 »Xeme xeikɨa xekatenikumaɨwakuni mɨtipatsietɨka meta mawari taiyame hetsie mɨrakapine, nehaxɨa tawarita 'ixaheritsixi nemɨkawakupitɨwanikɨ.  
\v 6 Mɨpaɨ ketinemaika ne nekatiniuyurieni nemɨwaranayexei, 'ixaheritsixi watsata, 'a'iwama Rewitsixi nemɨmatsiyetuirienikɨ 'imikieri hepaɨ. Mɨkɨ Yawé hetsiemiemeteri mekanihɨkɨtɨni 'ixuriki tukiyarita memɨte'uximayakakɨ.  
\v 7 'Ekɨ xeikɨa meta 'aniwema nekanixepitɨaka xemɨmawari wewiwametetɨnikɨ, xemɨtekumaɨwanikɨ mawari taiyametsie timieme meta 'ixuriki meuwie warita timieme. Xeme nekanixepitɨaka xemɨmawari wewiwametetɨnikɨ, kemɨ'ane tawarita 'ahurawa mayani mɨtimaiwetɨkatsie mɨpaɨ katipitɨarietɨ kanimɨmɨkɨ».   
\s1 Mawari wewiwamete ke'aixɨa memɨteyurieka  
\p
\v 8 Yawé 'Aruni mɨpaɨ katiniutahɨawe: «Ne nekamatinihɨritɨaka naime mɨtimaiwetɨka 'ixaheritsixi memɨteyetuaya. 'Ekɨ meta 'aniwema nekatinixeyetuirieka xehetsiemieme 'aixɨa mɨti'ane, 'inɨari 'aitsikayari hepaɨ.  
\v 9 'Ahetsiemieme katinayeikamɨkɨ piinite kwinimieme mɨtimaiwetɨka mɨkatititaiyarɨwa. 'Ahetsiemieme katinihɨkɨtɨkamɨkɨ 'ixaheritsixi memitimawani hatsite hamatɨa, 'itiya mawariyari meta wahetsie mɨrahɨiwa mawariyari. 'Ikɨ naime memɨnete'atɨirieni waɨkawa mɨtipatsie katinihɨkɨtɨkamɨkɨ 'ahetsiemieme meta 'aniwema.  
\v 10 Pekatinikwakamɨkɨ waɨkawa mɨtipatsietɨka, mɨpaɨ pekatinimaikamɨkɨ. Yunaitɨ 'ukitsi mekanitikwa'akuni.   
\p
\v 11 »Metatsiere mɨtiyetuiwa 'ahetsiemieme katinayeimɨkɨ mawari teikɨ hetserarietɨ 'uyuitɨariwatɨ 'ixaheritsixi memɨteyetuaya. 'Ekɨ meta 'aniwema 'ukitsi 'ukari 'aitsika nekaniwayetuirieni yuheyemekɨ 'amɨtiteriwe.   
\p
\v 12 »Matɨari timiemete memɨte'atɨwa Yawé hetsiemieme, nekamaniyetuirieka hatseiti 'aixɨa mɨ'ane, winu mɨhekwa meta hatsite.  
\v 13 Mɨkɨ kwie matɨari mɨtiutixuaweriyatsiemieme mɨkɨ mekateni'atɨakuni, neta nekameniyetuiriemɨkɨ. Kemɨ'ane tewi mɨ'itiya mitikwani kaniyɨweni.   
\p
\v 14 »Naitɨ 'ixaheritsixi Yawé naimekɨ memɨteyetuiriwa 'apiinite katinayeimɨkɨ.  
\v 15 Yunaitɨ matɨari nuiwakate Yawé hetsiemieme memɨyetuiwa 'ahetsiemieme katinayeimɨkɨ, tsepa tewi yatɨni tewaxi. Peru pekanitawikweitsitɨamɨkɨ matɨari nuiwakame tewi yatɨni tewa 'axɨa mɨka'ane.  
\v 16 Pekanitawikwetsitɨamɨkɨ kepauka matɨari mieme xeimetseri mexeiyani. Mɨtawikweitsitɨarienikɨ katinaye'akamɨkɨ 'aɨxɨwime pɨrata tuminiyari, kemɨti'inɨata tuki, tamamata heimana xewi kɨramuyari raheteme.   
\p
\v 17 »Peru pepɨka'itawikweitsitɨani matɨari mieme tuuru, muxa nu'aya, tsipu nu'aya, mɨkɨ 'aixɨa memɨpatsiekɨ. Xuriyaya mawari taiyametsie pekanitayeurimɨkɨ, wiyarieya pekanitataiyamɨkɨ, 'aixɨa mu'ɨa Yawé hetsiemieme mayanikɨ.  
\v 18 Waiyarieya 'ahetsiemieme kanayeimɨkɨ, yaxeikɨata tawieya mawariyari teikɨ hetserarietɨ muyuitɨariwa meta teurieya tserietana mieme.  
\v 19 Ne Yawé nekametiniyetuirieka naime mɨtipatsietɨka 'ixaheritsixi memɨneteyetuirie. Katini'ahetsiemiemetɨni meta 'aniwema 'ukitsi 'ukari, 'aitsika hepaɨ. 'Ikɨ tɨratu 'aixɨa mɨ'ane kanihɨkɨtɨni, mutseyumarie nehɨxie 'unakɨ. Tɨratu nekaniwewieka 'ahamatɨa meta 'anuiwarima wahamatɨa».   
\s1 Rewitsixi kememɨteyetuiriyarie  
\p
\v 20 Yawé 'Aruni mɨpaɨ katiniutahɨawe: «'Ekɨ kwietsie tixaɨtɨ pepɨkatipitɨarieni, kwie pepɨkaxatɨarieni 'ixaheritsixi watsata, ne nemɨ'ahetsiemiemekɨ, ne tita pemɨtimikieni nekanihɨkɨtɨni.   
\p
\v 21 »Rewitsixi nekaniwayetuirieka 'ixuriki tukiyarita memɨte'uximayakɨ, 'ixaheritsixi memɨteyetuaya tamamatatsie mieme xeime.  
\v 22 'Ixaheritsixi xɨka 'axamete'uyurieni 'ixuriki tukiyari hɨxie 'ahurawa me'ɨkɨneme mekanikwikuni.  
\v 23 'Ayumieme rewitsixi xeikɨa 'ixuriki tukiyarita te'uximayatamete mekanihɨkɨtɨkakuni 'ixaheritsixi wahetsiemieme. Hutarieka 'ikɨ 'aitsika kanihɨkɨtɨni 'umemahu wahetsiemieme: Rewitsixi tixaɨtɨ mekapɨteyetuiriyarieni,  
\v 24 ne nemɨtiwayetuirikɨ tamamatatsie mieme 'ixaheritsixi memɨteyetuaya Yawé hetsiemieme xeime. 'Ayumieme mɨpaɨ nekanaineni tixaɨtɨ memɨkateyetuiriyarienikɨ 'ixaheritsixi memɨteyetuiriyarienitsie».   
\s1 Tamamata hetsiemieme xeime memɨteyetuayakai  
\p
\v 25 Yawé Muitsexi mɨpaɨ katiniuta'aitɨani  
\v 26 Mɨpaɨ mɨtiwatahɨawekɨ Rewitsixi: «Kepauka xemɨte'anupineni tamamatatsie mieme xeime 'ixaheritsixi memɨteyetuaya, manata xepɨte'anakapini tamamatatsie timieme xeime xemɨneteyetuirienikɨ.  
\v 27 Xeme xemɨneteyetuirieni tɨriku meripaitɨ mieme hepaɨ nekatinimaimɨkɨ, yatɨni kaxie winuyari witsi'anetɨ mayeika.  
\v 28 Mɨpaɨ xekateniyuriekakuni nehetsiemieme xekatenanakapinekuni, xemɨteyetuayanikɨ yuhetsiemieme, 'ixaheritsixi memiyetuaya tamamatatsie timieme, mɨkɨ 'Aruni mawari wewiwame xekateniyetuiriwakuni.  
\v 29 Titakɨ xemɨte'anayexeiyarieni, nehetsiemieme xekateniti'utakuni xemiyetuayanikɨ. 'Aixɨa ti'aneneme tipatsiekame xekaneteniyetuiriwakuni.   
\p
\v 30 »Kepauka 'aixɨa ti'aneme xemɨnetexatɨani, mɨkɨ mɨpaɨ pɨtimatsiɨkɨni winu hepaɨ yatɨni 'imɨari hepaɨ.  
\v 31 Tita mɨtiyuhayewa, mɨkɨ xeme meta xeniwema yunaitɨ tsepa naitsarie xemitikwai pɨyɨweni. Mɨpaɨ xekatenipitɨariekakuni 'ixuriki tukiyari muyepatsieta xemɨte'uximayakɨ.  
\v 32 Xenetsiyetuiriemeri tamamatatsie mɨranukapiwa, mɨtiyuhayewari pɨkatimaiweni tsepa xemɨtekwa'a.  
\p »Xepɨkatetsewiximaka mɨtipatsietɨka 'ixaheritsixi wamawari, xɨka mɨpaɨ xeteyurieka xekanikwikuni».   
\c 19  
\s1 Memɨka'itiyatɨka memɨ'itiyanikɨ  
\p
\v 1 Yawé Muitsexi, 'Aruni mame mɨpaɨ katiniwarutahɨawe:  
\v 2 «'Ikɨta 'aitɨarika 'inɨari niukiyaritsie kanimiemetɨni ne Yawé nemiyetua: 'Ixaheritsixi wakaxi mekani'atɨakuni heuxetame, 'aixɨa 'aneme katikuyeme, katakwietsanaweme xekaniyetuiriekuni.  
\v 3 Mawari wewiwame 'Eriyatsaxi xekaniyetuiriekuni, mɨkɨ katinita'aitamɨkɨ mematitei takwayaritsie wakaxi manuyehanienikɨ, hɨxiena kananutixitekiemɨkɨ.  
\v 4 Hikɨ mawari wewiwame xuriyatsie kameme, 'atahutamexɨa 'ixuriki tukiyaritsie katineu'ɨyamɨkɨ.  
\v 5 Metatsiere wakaxi hɨxiena mɨtataiyarienikɨ katinita'aitamɨkɨ. Nawiyarieya meta waiyarieya, xuriyaya metatsiere kwitaya kanititaiyariemɨkɨ.  
\v 6 Hikɨ mawari wewiwame kariuxa xawari kanitihurimɨkɨ meta 'itsupu xawari, metatsiere tuwaxa mɨxetakɨ, mɨkɨ taipa katineuwiwimɨkɨ hakewa wakaxi metaiyarie.  
\v 7 'Imatɨrieka mawari wewiwame yupiinite katiniti'ekwamɨkɨ meta kaniti'ɨwamɨkɨ. 'Anake kaninuamɨkɨ mematiteitsie, peru 'akuxi ka'itiyatɨ kaniyuhayewamɨkɨ kepaukake mɨkɨyɨretsie.  
\v 8 Metatsiere kemɨ'ane wakaxi mutataiyaxɨ kaniyuti'ekwamɨkɨ kaniti'ɨwamɨkɨ, ka'itiyatɨ 'akuxi kaniyuhayewakamɨkɨ kepaukake mɨkɨyɨretsieke.   
\p
\v 9 »Xewitɨ tewi 'itiyatɨ wakaxi naxiyari kanikutuimɨkɨ, 'ateewa paitɨ kanenutuimɨkɨ. Muwa kaneikayemɨkɨ naxi 'ixaheritsixi 'itiya mawariyari mematiwewiwatsie meta haa 'aixɨa mɨ'ane mekaninɨitɨakuni.  
\v 10 Kemɨ'ane wakaxi naxiyari mukutuni, mɨkɨta kaniyuti'ekwamɨkɨ ka'itiyatɨ 'akuxi kaniyuhayewamɨkɨ kepauka mɨkɨyɨretsieke 'itiyatɨ kanayeimɨkɨ. 'Ikɨ 'aitsika yuheyemekɨ pɨhɨkɨtɨnɨ 'ixaheritsixi wahetsiemieme meta 'ateewatari wahamatɨa memɨtitei.   
\s1 Hakɨ kememɨte'itiyakai  
\p
\v 11 »Kemɨ'ane xeime tewi mɨkime mɨmayɨani, mɨkɨ ka'itiyatɨ kanayeimɨkɨ 'atahuta tukari.  
\v 12 'Aixɨa puyuyurieni, hairieka tukari 'anukamiekaku meta 'atahutarieka tukaritsie haa 'aixɨa mɨ'anekɨ kaniyu'itimɨkɨ, mɨpaɨ 'itiyatɨ kanayeimɨkɨ xɨka mɨpaɨ katiuyurieni pɨka'itiyani.   
\p
\v 13 »Kemɨ'ane mɨki 'umayɨame 'aixɨa mɨkayuyurieni, Yawé tukieya kaninanaimaka. Mɨkɨ tewi kanikumaweriyariemɨkɨ 'ixaheritsixi watsata 'axa'anetɨ muyuhayewaxɨkɨ 'aixɨa mɨkayuyurikɨ haa 'aixɨa mɨtiyuyuruwakɨ.   
\p
\v 14 »'Ikɨ 'aitsika kanihɨkɨtɨni kepauka kemɨ'ane 'ixuriki xamaruyaritɨa mɨmɨni: Yunaitɨ kemɨ'ane muwa memeutahaxɨani, yunaitɨ kemɨ'ane muwa memayeteni, 'axamekani'itɨariekakuni 'atahuta tukari.  
\v 15 Xɨka xarite 'aixɨa kareukunatɨkani naitɨ mɨkɨtsiere ka'itiyatɨ kaniyuhayewamɨkɨ.   
\p
\v 16 »Kemɨ'ane mɨki memayɨani yeuta 'uyeikatɨ 'umierieku, yatɨni yɨkɨmana 'umɨku, yatɨni 'umeyari 'umayɨani, yatɨni mɨki teukiya, 'atahuta tukari ka'itiyatɨ kanayeimɨkɨ.   
\p
\v 17 »Xeime tewi 'aixɨa muyurienikɨ 'axamɨ'itɨarie, xarita naxi kaniukawiwiemɨkɨ 'itiya mawariyari hetsie, meta haa haixatamieme kaniukatuariemɨkɨ.  
\v 18 'Anatari xewitɨ 'aixɨa 'anetɨ 'itsupu kanitihawiyamɨkɨ, xamaruya kanita'ɨyamɨkɨ naime piiniteya meta hamatɨana memɨtitei. Metatsiere kanita'ɨyariemɨkɨ kemɨ'ane 'umete mekumayɨa, yatɨni mɨki teukiya, yatɨni xewitɨ hemierieku, yatɨni yɨkɨmana 'umɨku.  
\v 19 Tewi mɨ'itiya kaniti'ɨyamɨkɨ hairieka tukaritsie meta 'atahutarieka tukaritsie. 'Atahutarieka tukaritsie tewi mɨka'itiya 'itiyakame kanayeitɨamɨkɨ, mɨkɨ kaniyuti'ekwamɨkɨ kaniti'ɨwamɨkɨ. Mɨpaɨ mɨkɨyɨretsie 'aixɨa 'anetɨ kanayeimɨkɨ.  
\v 20 Xɨka tewi mɨka'itiya ka'uyu'itieni, kanakumaweriyariemɨkɨ 'ixaheritsixi watsata Yawé tukieya ka'itiyakame mayeitɨakɨ. Mɨkɨ tewi pɨka'itiyaka haa 'aixɨa mɨtiyuyuruwakɨ mɨka'uyu'itikɨ.  
\v 21 'Ikɨ 'aitsika yuheyemekɨ pɨhɨkɨtɨni 'ixaheritsixi wahetsiemieme.  
\p »Kemɨ'ane haa mɨmayɨani mɨkɨta kaniyuti'ekwamɨkɨ, kemɨ'aneta haa mumayuani 'aixɨa tiyuyuruwame mɨkɨta 'axakani'itɨariemɨkɨ kepaukake mɨkɨyɨre 'anake 'aixɨa kaniyɨmɨkɨ.  
\v 22 Tewi mɨka'itiya tita mɨtimayɨani mɨkɨta kati'itiyatɨ katinayeimɨkɨ, kemɨ'aneta mɨkɨ mɨmayɨani ka'itiyatɨ kanayeimɨkɨ».   
\c 20  
\s1 Haa 'aitsie kemɨrane  
\p
\v 1 Yunaitɨ 'ixaheritsixi makumawetsie Tsini mekaniu'axɨani mexɨakame metseriyaritsie, Karetsi rakutewakaku mekanitiyaxe. Mana Miriyami mamɨtsie meta mana kaniukateukieni.   
\p
\v 2 Mana haa waɨkawa mumawekaikɨ, 'ixaheritsixi mekaniutiniukixietɨkɨne Muitsexi hepaɨtsita meta 'Aruni,  
\v 3 Muitsexi mɨpaɨ mekateniutatieni: «Yawé kuta ta'iwama wahamatɨa temekwinikɨ mɨtanepitɨakaitɨni.  
\v 4 ¿Tamɨ tame Yawé tekateteɨterimama? ¿Titayari 'ena makumawetsie petareyewitɨ temɨkwinikɨ tatewama wahamatɨa?  
\v 5 ¿Titayari 'Ekipitu petarayewitɨ 'ena 'axa'anekɨa petati'atɨa? 'Ena kaniumaweni 'imɨari, piní, kaxie, 'ikwaxi mayehatsiyatɨka, matsi 'akuxi haa tiumawe».   
\p
\v 6 Muitsexi meta 'Aruni mewaruhayewaka mekanekɨne 'ixuriki tukiyari hɨxie, mana mekaniutihɨxima'uni. Hikɨ Yawé xawatɨriyaya kaniyuhekɨata wahɨxie,  
\v 7 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 8 «'A'itsɨ keneutikwe'i teɨteri keniwarukuxeɨrieka. Mɨkɨ wahɨxie 'ekɨ meta 'Aruni, 'ai mɨpaɨ xekatenitahɨawikuni haa kehanetɨani. Mɨpaɨ xeteyurieyu haa kananemɨkɨ teɨteri meta tewaxi xekaniwatiharitɨakuni».   
\p
\v 9 Yawé kemainekai mɨpaɨ Muitsexi katiniuyurieni, 'itsɨ kaniutikweni Yawé hɨxie mutiwekai.  
\v 10 Hikɨ Muitsexi, 'Aruni hamatɨa teɨteri mekaniwarukuxeɨrieni 'ai hɨxie, Muitsexi mɨpaɨ kaniutayɨni: «Xekeneu'enana, 'axaxemɨte'u'iyari. ¿Kamɨtsɨ teteyɨwawe 'ikɨ 'aitsie haa temanetɨani?»  
\v 11 Mɨpaɨ 'utayɨka yu'itsɨkɨ 'ai hutakɨa kaniuwani, hikɨ haa kananeni waɨkawa, mana teɨteri meta watewama mekaniutihareni.   
\p
\v 12 Yawé, Muitsexi 'Aruni mame mɨpaɨ katiniwarutahɨawe: «Nehetsie yuri xemɨkate'eriekɨ, kenemɨtipatsie xemɨka'imatekɨ 'ixaheritsixi wahɨxie, xeme xepɨkahɨkɨtɨni xemɨwaranuwitɨni hakewa kwie nemɨxehexatɨa».   
\p
\v 13 Mɨkɨ haa mɨpaɨ katinimatiwani, haa manakaxɨrɨwe Meriwa, mana 'ixaheritsixi Yawé memutatikɨ, mana kemɨtipatsie muyuhekɨataxɨkɨ.   
\s1 'Erumi 'Ixaheri huyeyari mutikweri  
\p
\v 14 Karetsi 'ukaitɨ Muitsexi kaniwarenɨ'ani texaxatamete ti'aitame 'Erumi kiekame hetsɨa, mɨpaɨ tiwarahɨawetɨ:  
\pm «Mɨpaɨ 'a'iwa 'Ixaheri kanaineni: “'Ekɨ pepɨtimate kehepaɨ temɨte'uka'eniwa.  
\v 15 Pepɨrakumate tatutsima 'Ekipitu memekɨ, hakewa mɨixa wiyari teme'uwakai, metatsiere pepɨtimate 'Ekipitu kiekatari kememɨtate'u'uximatɨakai tame meta tapaapama.  
\v 16 Metatsiere pepɨtimate Yawé ketemɨte'utawawiri tatsi'u'enieka, yuniuki tuayame kataneyenɨ'airieni 'Ekipitu mɨtatsi'ayewitɨ.  
\pm »”'Enari tekaniuhuni Karetsi, hakewa 'akwie meka'atɨka.  
\v 17 Mɨpaɨ tematewawirie pemɨtatsipitɨanikɨ 'akwietsie temuyekɨnekɨ. Yurikɨ mɨpaɨ nepaine nixeime 'a'etsaripa mana tepɨkaheuyekɨne meta xeime putsuta tepɨkahetihareni. Huyeta xeikɨa tepɨyehu 'amatayewa 'utɨma, hawaikɨ tekaheukuyuyuipiketɨ kepaukake temanuyekɨne”».   
\p
\v 18 Hikɨ ti'aitame 'Erumi kiekame mɨpaɨ katineinɨ'airieni:  
\pm «Hakewa nemɨre'aita 'etsiwatɨma mana xepɨka'uyekɨkani, xɨka mɨpaɨ xeheyɨni, ne nekanayeyeimɨkɨ nekuyaxima newarawitɨtɨ muwa tekanixehetaxeiyakuni».   
\p
\v 19 'Ixaheritsixi tawarita mɨpaɨ mekaniutiyuani:  
\pm «Huye 'amatayewa 'utɨma xeikɨa tepɨyehu, xɨka tatewama yatɨni tame hawaikɨ 'aputsuta tehetihareni tepɨte'ayukatuani. Tame tematsiwawirie xeikɨa mana temuyekɨnekɨ».   
\p
\v 20 'Erumi kwieyaritsie ti'aitame haxɨama mɨpaɨ kaniutayɨni:  
\pm «'Ena xeme xepɨka'uyekɨne».  
\p Hikɨ kanayeyani kuyaxi waɨkawa memɨyɨwawe warawɨtɨtɨ,  
\v 21 kawapitɨanike kwieyatsie memuyekɨnekɨ. Hikɨ 'ixaheritsixi xaɨtsie pɨta mekaneukanɨ'arieni yamekateha'eriwatɨ.   
\s1 'Aruni kaniumɨni  
\p
\v 22 Hikɨ yunaitɨ 'ixaheritsixi Karetsi mekanayekɨne Huxi hɨriyaritsie mekaniu'axɨani,  
\v 23 'Erumi kwieya mata'atɨkatsie. Mana Yawé Muitsexi meta 'Aruni mame mɨpaɨ katiniwarutahɨawe:  
\v 24 «'Aruni 'apɨka'uyeikani 'ena kwiepa 'ari kanimɨmɨkɨ, kwie hakewa 'ixaheritsixi nemɨwarexatɨa mana pɨkaheutahani, xeme xeyuhutatɨ xemɨkanetsi'anu'enikɨ kenemɨxerahɨawekai haa Meriwa maneikakaitsie.  
\v 25 Hikɨ 'Aruni meta nu'aya 'Eriyatsaxi keniwaranuwitɨki Huxi hɨriyaritsie.  
\v 26 Mana 'Aruni pekanetikemaripiemɨkɨ mawari wewiwame kamixateya mɨranakatɨkɨ, nu'aya 'Eriyatsaxi pekatinanakatɨtɨamɨkɨ, manari 'Aruni kanimɨmɨkɨ».   
\p
\v 27 Muitsexi yakatiniuyurieni Yawé kemɨrehɨawekai. Yunaime teɨteri wahɨxie, yuhaikatɨ Huxi hɨriyaritsie mekanitiyune.  
\v 28 Hikɨ Muitsexi, 'Aruni mawari wewiwame kamixateyari kanenutihɨnirieni, 'Eriyatsaxi pɨta kananakatɨtɨani. Mana hɨritsie 'Aruni kaniɨmɨni. Hikɨ Muitsexi 'Eriyatsaxi hamatɨa hɨritsie mekananakakɨne.  
\v 29 Kepauka yunaitɨ memɨtehetima kename 'Aruni hemɨkai, xeitewiyari heimana tamamata tukari mekanitsuariwiyatɨwekaitɨni.   
\c 21  
\s1 'Arari kemɨra'iwarie  
\p
\v 1 Kepauka kananeu tewiyari mɨti'aitametɨkai 'Arari kiekariyaritsie, Nekexi 'ukaitɨ, katinetimani kename 'ixaheritsixi Hatarimi huyeyari 'utɨa mehahu, kaniwarutakwini hipameta kaniwarutiwiya.  
\v 2 Hikɨ 'ixaheritsixi mɨpaɨ mekaniutiyuani Yawé hetsiemieme: «Xɨka 'ekɨ teme'iwa yapehaineni mɨtatsi'aye'unie, naime wakiekari tekanika'unakuni».  
\v 3 Yawé kaniwaru'enieni 'ixaheritsixi kememɨte'iwawiriekai, kaniwarupitɨani kananeutsixi memɨwara'iwakɨ, yunaime teɨteri mekaniwarukwini meta wakiekarite mekaniuka'una. 'Ayumieme mana Kuxima katiniuterɨwarieni.   
\s1 Kuu wurunitsekɨ mɨwewiya  
\p
\v 4 'Ixaheritsixi mekanayekɨne Huxi hɨriyaritsie Haramara Mɨxeta hepatsie me'eerietɨ, 'Erumi kwieyari warita me'ahutɨ. Huyeta me'uhutɨ mepɨkate'unenewi  
\v 5 mekaniutiniukixietɨkɨne Kakaɨyari hepaɨtsita meta Muitsexi:  
\p —¿Titayari kuta 'Ekipitu xetatehayewitɨ makumawetsie temɨkwinikɨ? 'Ena 'ikwai haa kaniumaweni. 'Ariri ta'iyaritsie katineuyemieni 'ikɨ 'ikwai kwaiyarikɨ.   
\p
\v 6 'Ayumieme Yawé kuuterixi memɨmɨya kaniwareyenɨ'airieni memɨwatikenikɨ, 'ana yumɨiretɨ 'ixaheritsixi mekaniukwini.  
\v 7 'Ixaheritsixi Muitsexi 'aurie me'ukɨneka mɨpaɨ mekatenitahɨawe:  
\p —Yawé hepaɨtsita te'uniukixieka 'axatepɨte'uyuri meta 'ahepaɨtsita. Yawé keneutawawiri kuuterixi mɨwakumaweriyakɨ.  
\p Muitsexi wahetsie 'utanuaku,  
\v 8 Yawé mɨpaɨ katinitahɨawe:  
\p —Kuu 'ɨkiyari keneutawewieka, kɨyetsie 'ateewa keneuyeteka. Kemɨ'ane mekukeiwatɨ kwimemixeiya mekanitawikweikuni.   
\p
\v 9 Muitsexi kuu 'ɨkiyari purunitsekɨ 'utawewieka kɨyetsie 'ateewa kaniyeteni. Kemɨ'ane me'utikeiyaka kuu kwi memukuxexeiyakai meputawikweitsitɨariwakai.   
\s1 Muhawi huyeyari  
\p
\v 10 Hikɨ 'ixaheritsixi mekaniyekɨne 'Uwuti rakutewakaku mekanitiyaxe.  
\v 11 Manata 'Uwuti memɨyekɨ 'Iye-'Awarini rakutewakaku mekanitiyaxe makumawetsie, Muhawi 'aurie tau makayuyuipike hepatsie.  
\v 12 Manata memɨyekɨ mayeweritsie Tsereri mekanitiyaxe.  
\v 13 Manata memɨyekɨ haa 'Axinuni 'anutaɨye mekanitiyaxe, makumawetsie 'amuxeutsixi wakwietsie muyehane. Haa 'Axinuni manuyehane kani'inɨaritɨni muhawitsixi wakwie meta 'amuxeutsixi kwieyari manuye'atɨkatsie.  
\v 14 'Ayumieme puyuterɨwanɨa Yawé kemɨtiyutami xapayaritsie:  
\q1 «Haramara Mɨxeta hepatsie, mayeweweritsie meta haa 'Axinuni.   
\q1
\v 15 Mayeweweri mukɨatsie 'akaniyeuka 'Axi  
\q2 meta Muhawi kwieyari manuye'atɨkatsie».   
\m
\v 16 Manata memɨyekɨ Wehexi paitɨ, putsu matinieretsie Yawé hakewa Muitsexi mɨpaɨ mɨtiutahɨawixɨ: «Yunaime teɨteri keniwarukuxeɨri ne nekaniwaharitɨamɨkɨ».  
\v 17 'Ana yameteyurietɨ 'ixaheritsixi mɨpaɨ mekateniukwika:  
\q1 «Haa kehewatineni.  
\q2 Putsu ke'utakwika.   
\q1
\v 18 Mɨkɨ putsu, te'aitamete yu'itsɨkɨ mepɨwati'inixɨ  
\q2 mariwemekɨ memɨteyurie yu'itsɨkɨ memeiyepikɨ».  
\p Makumawetsie memɨyekɨ Matana mekanekɨne,  
\v 19 Manata memɨyekɨ Nakarieri mekaniu'axɨani, Nakarieri memɨyekɨ Wamuti mekaniu'axɨani,  
\v 20 Wamuti memɨyekɨ Muhawi kwieyaritsie mayeweri mekaniu'axɨani, Pitsikaha hɨriyari manukatsie, Ketsimuni mautahekɨatsie makumawe.   
\s1 Tsikuni kemɨra'iwarie  
\p
\v 21 'Ixaheritsixi mekaniwarenɨ'ani texaxatamete Tsikuni hetsɨa, 'amuxeutsixi tiwa'aitɨwame, mɨpaɨ metehehɨawetɨ:   
\pm
\v 22 «Tepɨmatsiwawirie pemɨra'aitatsie temuyekɨnekɨ. Yurikɨ mɨpaɨ tepaitɨka hawaikɨ mɨra'etsietsie tepɨkaheuyekɨne meta putsuta tepɨkahetihareni. Huye 'amatayewa 'utɨa xeikɨa tepuyekɨne, kepaukake temanuyekɨne 'akwieyaritsie».   
\p
\v 23 Peru Tsikuni pɨkawarupitɨa hakewa mɨra'aita 'ixaheritsixi memuyekɨnekekai. Matsi pɨta yukuyaxima kaniwarukuxeɨrieni watakwinike makumawetsie. Kepauka Yahatsa mɨye'a mekaniwarutiwiya.  
\v 24 Matsi 'ixaheritsixi mekaniwara'iwa wakwie mekaniwarunawairieni, haa 'Axinuni manuyekatsie ye'atɨkaime haa Kawuki manuye'axetsie ye'atɨkaime, 'amunitsixi wakwie mananiere, kwie 'aixɨa mɨrekukurarutɨiyarietsie paitɨ.  
\v 25 'Ixaheritsixi 'amuxeutsixi wakiekaritetsie mekaniye'axɨani, mana wakiekaritsie mekaniyukuhayeikawakaitɨni, metatsiere kiekari Hetsiwuni meta kiekarite 'auriena mamanetɨkateitsie.  
\v 26 Kiekari Hetsiwuni, Tsikuni kiekarieya 'amɨyewa kanihɨkɨtɨkaitɨni, 'amuxeutsixi tiwa'aitɨwame, meripaitɨ ti'aitame Muhawi kiekame mutamiekai, kwieya minawairiekai haa 'Axinuni manuyekatsie paitɨ ye'atɨkaime.   
\p
\v 27 'Ayumieme niuki wewiwamete mɨpaɨ mekaniutiyuaneni:  
\q1 «Ketsuwuni kiekariyaritsie xekenahu, Tsikuni kiekarieyatsie.  
\q2 'Aixɨa xekeneuyuri. 'Aixɨa xekeneukuyuriexɨa.   
\q1
\v 28 Hetsiwuni kiekariyaritsie tai kanatineni,  
\q2 Tsikuni kiekarieyatsie nerɨkwari kanatinexɨani.  
\q1 Muhawi kiekariteya naime kaniutixɨtsitɨani  
\q2 'Axinuni hatɨayari hɨriyari manuye'atɨka.   
\q1
\v 29 Muhawi 'ahetsiemieme xɨa'ui nepaine.  
\q2 Pekani'uniniri, Kemuxi kiekarieya.  
\q1 'Akakaɨyari 'aniwema kaniwareutaweiyaxɨani  
\q2 'aniwema 'ukari Tsikuni paitɨ mɨwaranuhapanikɨ,  
\q2 'amuxeutsixi tiwa'aitɨwame wahetsɨa.   
\b  
\q1
\v 30 »Yunaime tekanixe'uka'una,  
\q2 Hetsiwuni ye'atɨkaime meta Riwuni paitɨ ye'akame.  
\q1 Yunaime Nupa paitɨ tekanixe'uxɨrietɨkɨne,  
\q2 tekanixe'uka'una Merewa paitɨ xeye'atɨkaime».   
\b  
\p
\v 31 Mɨpaɨ mekateniuyaxe 'ixaheritsixi 'amuxeutsixi wakwieyaritsie.   
\s1 'Uhuki Watsanitsie ti'aitame kemɨra'iwarie  
\p
\v 32 Muitsexi katiniuta'aita kwie Katsexi memuxeiyayukɨ, 'ixaheritsixi kiekari mamanetɨka mekaniwarutakwini, 'amuxeutsixi mekaniwarutaweiya mana memɨkiekai.  
\v 33 Me'akunuaxɨaka, Watsani huyeyari mekaniuwiya. Mana ti'aitame 'Uhuki, Watsani kiekame kaniwaranukunake yukuyaxima warawitɨtɨ watakwinike 'Erurehi mɨrakutewatsie.   
\p
\v 34 Hikɨ Yawé Muitsexi mɨpaɨ katiniutahɨawe: «Pepɨkawamakaka, 'Uhuki nekanixeyetuiriemɨkɨ kuyaximama, meta kwieya naime. Tsikuni kepemeyuri 'amuxeutsixi tiwa'aitɨwame Hetsiwuni kiekame mɨpaɨta pekatiniyurimɨkɨ».   
\p
\v 35 Mɨpaɨ mekatenimieni 'ixaheritsixi 'Uhuki ti'aitame meta niwemama, kuyaximama, nixeime mepɨka'uhayewaxɨ 'ayeniereme, mɨpaɨ kwie mekatena'iwa.   
\c 22  
\s1 Waraki Warami hekɨ mɨrenɨ'a  
\p
\v 1 'Ixaheritsixi tawarita mekaniyekɨne, mayeweritsie Muhawi mekaniuyuhayewa, Kurutani 'anutaɨye, Keriku hɨxie.   
\p
\v 2 Kepauka Waraki Tsipuxi nu'aya mɨretima 'ixaheritsixi 'amuxeutsixi kememɨwaruyuriekai,  
\v 3 muhawitsixi 'ixaheritsixi mekaniwarutimakani. Kwinie yemekɨ mekatenimamakaitɨni kwinimieme memɨyupaɨmekaikɨ.   
\p
\v 4 Hikɨ muhawitsixi 'ukirawetsixi Mariyani kiekatari mɨpaɨ mekateniwarutahɨawe: «'Ikɨ mɨya memɨyupaɨme ta'aurie mɨrahane naime mekatenixɨkuni, wakaxi 'ɨxa kemɨrakumaweriya hepaɨ».  
\p 'Ana mana Waraki tsipuxi nu'aya katini'aitametɨkaitɨni Muhawi kwieyaritsie,  
\v 5 'ayumieme Warami katiniutanɨ'airieni Wehuxi nu'aya, Petuxi paitɨ mukatei, 'Eupɨrata hatetsitayaritsie, 'amawitsixi wakwieyaritsie. Waraki mɨpaɨ mekateneinɨ'airieni:  
\pm «Hipatɨ teɨteri mepu'axɨa 'Ekipitu mehanexɨaka, hikɨ naime kwie mepukunama, hikɨta ne'aurie mekaniu'axɨani.  
\v 6 Waɨkawa nemetsiwawirie pemamiekɨ 'ikɨ 'axapemɨwayurienikɨ nehetsiemieme, waɨkawa pemɨtɨrɨkaɨyekɨ. Mɨpaɨke newara'iwake nepɨne'erie 'ateewapai newaranunɨ'ame. Ne mɨpaɨ nepɨtimate kemɨ'ane 'aixɨa pemuyurieni 'aixɨa'itɨarietɨ payeika, kemɨ'aneta 'axapemuyurieni 'axa'itɨarietɨ payeika».   
\p
\v 7 Hikɨ 'ukirawetsixi Muhawi meta Mariyani kiekatari Warami mekatenekuxatɨani Waraki kemainekai, mekaniu'axɨani tumini me'a'ɨtɨ mete'ipitɨanike xɨka ya'utayɨnike 'ixaheritsixi 'axamɨwayurienikɨ.   
\p
\v 8 Warami kaniwaruta'inieni mana memɨtihenikɨ, mɨpaɨ tiwarahɨawetɨ kename 'uxa'ariekake tiwataxatɨanikekai Yawé kemɨtitahɨawekekai. Hikɨ 'itsɨkate mana mekanitiheteitɨni.   
\p
\v 9 Kakaɨyari Warami hetsɨa kaniuyuhekɨata mɨpaɨ katinitahɨawe:  
\p —¿Kemɨ'ane mepɨyɨa mɨkɨ teɨteri 'akie memɨtihe?   
\p
\v 10 Warami mɨpaɨ kaniutayɨni:  
\p —Texaxatamete mekaniyɨaka Waraki Tsipuxi nu'aya mɨwareyenɨ'a, ti'aitame Muhawi kwieyaritsie. Kaniwareyenɨ'ani memɨnetetaxatɨanikɨ:  
\v 11 “Teɨteri 'Ekipitu kiekatari kwie hikɨ 'ena naime mekanikunaka. Kenamieka 'axakeniwaruyuri nehetsiemieme. Mɨpaɨke xɨari nepɨyɨwe newakwinetɨ nemɨwarutaweiya nekwietsie”.   
\p
\v 12 Kakaɨyari Warami mɨpaɨ katiniutahɨawe:  
\p —Pepɨkayemie wahamatɨa meta pepɨkawakewaiyaneni 'ixaheritsixi, kiekari 'aixɨa memu'itɨarie mekanihɨkɨtɨni.   
\p
\v 13 'Uxa'arieka Warami 'anukukeka 'itsɨkate mɨpaɨ katiniwarutahɨawe Waraki mɨwareyenɨ'a: «Xekenakunuaxɨa yukie, Yawé pɨka'inake xehamatɨa nemeumienikɨ».   
\p
\v 14 Memanuyetei muhawitsixi mekanakunuaxɨani hakewa Waraki mekatei, mɨpaɨ mekatenitahɨawe: «Warami pɨkaheyuwaɨri tahamatɨa mamiekɨ».   
\p
\v 15 Waraki tawarita kaniwarenɨ'ani 'itsɨkate matsi meyuwaɨkawame, waɨkawa memauka'u,  
\v 16 meheta'axɨaka mɨpaɨ Warami mekateniutahɨawe:  
\p —Waraki Tsipuxi nu'aya mɨpaɨ kanetaineni:  
\pm “Yemekɨ tixaɨtɨkɨ pepɨkarekununuwani pemɨnetsi haxeiyamiekɨ,  
\v 17 ne nekamatinipitɨamɨkɨ waɨkawa perexeiyatɨ pemayanikɨ, tsepa tita pemɨnetiutawawiri ne yanekatinikayeimɨkɨ. Waɨkawa nekamaniwawirieka pemamiekɨ 'ikɨ teɨteri 'axapemɨwayurienikɨ nehetsiemieme”.   
\p
\v 18 Warami mɨpaɨ kaniutayɨni:  
\p —Tsepa Waraki yuparatsiyu mɨnetiyetuiri hurute meta pɨratate tihɨneme, ne 'atsinepɨkatiyurieni 'etsitipeme yatɨni timariweme, matsi Yawé nekakaɨyari kemɨti'aita yanepɨtiyurieneni.  
\v 19 Xemeta hikɨ tɨkarikɨ 'ena xekenetiheni, ne Yawé 'akuxi nepɨta'iwawiya kemɨnetitahɨawe.   
\p
\v 20 Mɨkɨ tɨkarikɨ Kakaɨyari kaniyuhekɨata Warami hetsɨa: «Metsɨ 'ikɨ teɨteri mekameniku'inietɨweni, kenemietsɨ wahamatɨa, xeikɨatsɨ ne kenemerekɨhɨaweni yapekatinekamiemɨkɨ».   
\s1 Warami meta puxuya  
\p
\v 21 'Uxa'arieka ximeri Warami kananukukeni, yupuxu kaniutixiratɨani, hikɨ kaneyani 'itsɨkate muhawi kiekatari wahamatɨa.  
\v 22 Hikɨ wahamatɨa 'umiekaku Kakaɨyari kaniuyeha'ani, huyetana kaniutakeni Yawé niuki tuayameya, ka'ipitɨanike mana muyeyanikɨ. Warami 'anakaitɨ kaniumiekaitɨni yupuxutsie meta hamatɨana yuhutatɨ mekaniuhukaitɨni 'iparewiwamete.  
\v 23 Kepauka puxu Yawé niuki tuayameya muxei 'ixipara 'akwekame, huye kaniuku'eirieni xaɨtsie kaneukuyune. Hikɨ Warami kanikuwaxɨani huyeta mɨyemiekɨ.   
\p
\v 24 Yawé niuki tuayameya hetsimanuyewatsie kaniukeni, kaxie haraweriyari makumanetsie, mɨkɨ tetexikɨ kanikurarutɨariekaitɨni naitsarie.  
\v 25 Kepauka puxu Yawé niuki tuayameya muxei, kwi hurawa tetsariyatsie kaniukuyani Warami yu'ɨkatsie katiniukwine. Hikɨ tawarita Warami kaniwani.   
\p
\v 26 Yawé niuki tuayameya kananuyeyerɨni xaɨtsie paitɨ kaniukeni kwi manuyewatsie, hakewa mɨkaheyɨwe xaɨtsie meukuyune.  
\v 27 Kepauka puxu Yawé niuki tuayameya muxei, kaniukahuni Warami 'anakaiku. Hikɨ Warami kaniuyeha'ani kɨyekɨ yupuxu kaniukuwaxɨani.  
\v 28 Hikɨ Yawé puxu kaniupitɨani mɨtaniunikɨ, hikɨ mɨkɨ mɨpaɨ Warami katiniutahɨawe:  
\p —¿Kekuta ne nematsi'uyuri, titayari haikakɨa penetiukuwaxɨa?   
\p
\v 29 Warami mɨpaɨ katinitahɨawe:  
\p —Penetsinanaimatɨ pepumie. Xɨka 'ixipara nehakwekake, nekameniumienikeri.   
\p
\v 30 Puxu Warami mɨpaɨ katiniutahɨawe:  
\p —¿Netsɨ 'apuxu nepɨhɨkɨ nehetsie pemɨkuyerɨne, hɨkɨa mɨreukayunetsie? ¿Kepauka mɨpaɨ nematsiheyuri?  
\p Warami mɨpaɨ kaniutayɨni:  
\p —Nekatixaɨtsietɨ.   
\p
\v 31 'Ana Yawé yuniuki tuayame kaniuhekɨata 'ixipara hakwekame Warami mixeiyakɨ. Warami kwiepa paitɨ kaniutihɨximakeni.   
\p
\v 32 Yawé niuki tuayameya kanita'iwawiya:  
\p —¿Titayari haikakɨa 'apuxu petiukuwaxɨa? ¿Pekatimate ne nematsikunuitɨanike 'ena nemunuakɨ, nemixeiyakɨ kepemɨtimie 'aixɨa mɨka'anekɨ?  
\v 33 Kepauka puxu mɨnetsihexei, haikakɨa hukaniuyune. Xɨka mɨkɨ mɨpaɨ kaheyɨnike, 'ekɨri pekanimɨkinike, mɨkɨta rayenierenike.   
\p
\v 34 Warami Yawé niuki tuayameya mɨpaɨ katiniutahɨawe:  
\p —'Axanepɨtiuyuri. Mɨpaɨ nepɨkaretima kename nehuye pe'anunarɨmakai. Kamɨtsɨ xɨka 'aixɨa kane'ane, nekanikunuamɨkɨ.   
\p
\v 35 Niuki tuayame Yawé hetsɨa mieme mɨpaɨ katinitahɨawe:  
\p —Kenemie wahamatɨa, keni'akweriwayurieka, ne kenemarekuhɨaweni mɨpaɨ xeikɨa pekanetainemɨkɨ.  
\p Hikɨ Warami kaneyani Waraki mɨwareyenɨ'a wa'ukiyarima wahamatɨa.   
\s1 Waraki Warami hamatɨa kememɨte'uyukaxei  
\p
\v 36 Kepauka Waraki mɨretima kename Warami 'uhamiekai, kanayeyani 'enukunakeke xeime muhawi kiekariyaritsie kwie manu'axetsie haa manuyekatsie 'Axinuni.  
\v 37 Waraki Warami mɨpaɨ katiniutahɨawe:  
\p —¿Tamɨ ne nekamatiutanɨ'airi? ¿Titayari nehetsɨa pekatinua? ¿Nekamarakapitɨaweme peti'erie?   
\p
\v 38 Warami mɨpaɨ Waraki katiniuta'eiya:  
\p —'Ari, 'ena nekaniuyeikani. Kepauka Kakaɨyari xeikɨa mɨpaɨ mɨnetikuhɨaweni yaneputaineni.   
\p
\v 39 Mana memɨyekɨ Warami meta Waraki mekanekɨne, Kiriati-Kutsuti hepatsie.  
\v 40 Waraki wakaitsixi kaniwarutimawa meta muxatsi, mekaniwarutikwani Warami hamatɨa meta 'itsɨkate wahamatɨa memu'uwakai.  
\v 41 'Uxa'arieka Waraki Warami kanewitɨni Wamuti-Wahari hɨriyari 'amanutitewatsie, hakewa 'ixaheritsixi memetitekai 'etsiwa mɨwaxeiyakɨ.   
\c 23  
\s1 Matɨari Warami kemɨtikuxatakai  
\p
\v 1 Warami, Waraki mɨpaɨ katiniutahɨawe: «'Atahutame mawarite taiyame keneutiwewi meta 'atahutame tsikerutsixi meta 'atahutame muxatsi 'ukitsi».  
\v 2 Waraki yakatiniuyurieni Warami kemɨrehɨawekai, yunaitɨ mekanitimawa xeime tsikeru meta xeime muxa 'ukitɨme mawari taiyame xexuimetsie.   
\p
\v 3 Hikɨ Warami, Waraki mɨpaɨ katiniutahɨawe: «'Ena keneuyuhayewa, 'amawari taiyariyari 'aurie, 'akuxi ne Yawé nepeta'iwawiya kemaineni. Yareutewitɨta nekametinitaxatɨamɨkɨ kemɨneretahɨawe». Hikɨ yemuri metsekametsie kaneutimiekaitɨni.   
\p
\v 4 Kakaɨyari kanenukunake, Warami mɨpaɨ katiniutahɨawe:  
\p —'Atahutame mawari taiyame nekaniutiwewieni xexuimetsie xeime tsikeru xeime muxa 'uki nekaniutimawa.   
\p
\v 5 Hikɨ Yawé Warami katiniutaxatɨani, mɨpaɨ katinitahɨawe:  
\p —Kenakunua Waraki hetsɨa kenemɨtayɨni mɨpaɨ ketinetahɨawi.   
\p
\v 6 Warami kanakunuani Waraki kaniutaxeiya 'a'uweme yumawari taiyariyari 'aurie muhawitsixi tewa'aitɨwamete wahamatɨa.  
\v 7 Warami mɨpaɨ katinikuxatakaitɨni:  
\q1 «'Arami paitɨ, tau manatineika hɨri hepatsie,  
\q2 Waraki kaneneyewitɨni, ti'aitame Muhawi kiekame hetsɨa.  
\q1 Mɨpaɨ kanetiniutahɨawe: “Kenamieka, Kakuwu 'axakeneuyuri nehetsiemieme.  
\q2 Kenamieka, 'Ixaheri 'axakeneuyuri”.   
\q1
\v 8 ¿Titayari 'axanetiwayurieneni  
\q2 kemɨ'ane Kakaɨyari 'axamɨkawayurie?  
\q1 ¿Keneyɨme 'axanepɨwayurieni  
\q2 Yawé mɨpaɨ mɨkatiwara'eriya?   
\q1
\v 9 'Ai 'amanutitewitsie paitɨ nepuwataxeiya,  
\q2 hɨri 'ametitɨtɨtsie paitɨ nepɨwaxeiya:  
\q1 teɨteri memanayexeiyarie mepɨhɨkɨ,  
\q2 mepɨka'inɨatsie 'ena kwiepa miemete wahamatɨa.   
\q1
\v 10 ¿Kemɨ'ane pɨyɨwe Kakuwu nuiwarimama mɨwaruti'inɨata,  
\q2 tumuanari hepaɨ memuyupaɨme,  
\q2 yatɨni tsikere yayupaɨmeme mɨwaruti'inɨata 'Ixaheri nuiwarimama?  
\q1 'Aixɨa mɨtiuka'iyari hepaɨ ne'anetɨ neke'umɨni.  
\q2 Wahepaɨ netiyurienetɨ neke'ukumawere».   
\p
\v 11 Hikɨ Waraki, Warami mɨpaɨ katiniutahɨawe:  
\p —¿Kepenetsi'uyuri? Nekamani'atɨani 'axapemɨwayurienikɨ memɨnetsi'aye'unie wahetsiemieme, matsi pɨta 'aixɨa petiwayurie.   
\p
\v 12 Hikɨ Warami mɨpaɨ katinita'eiya:  
\p —¿Kamɨtsɨ nekatiyɨwe Yawé kemɨnerahɨawe mɨpaɨ nemutayɨni?   
\s1 Hutarieka Warami kemɨtiutaxa  
\p
\v 13 Hikɨ Waraki mɨpaɨ katinitahɨawe:  
\p —Neuxei, hikɨmɨ xaɨtsie pɨta. Manata xeitapari xeikɨa pekaniwarexeiyamɨkɨ, yunaime hawaikɨ, mana hɨrixɨa 'axapekaniwareyurimɨkɨ.   
\p
\v 14 Hikɨ mekanekɨne Tsupini hɨriyaritsie Pitsikaha mɨtitewatsie. Mana mawari taiyame 'atahutame kaniutiwewieni, xexuimetsie xeime tsikeru xeime muxa 'uki mekaniutimawa.  
\v 15 Mana Warami Waraki mɨpaɨ katiniutahɨawe: «'Ena keneuyuhayewa 'amawari taiyariyari 'aurie, 'akuxi ne Kakaɨyari hamatɨa nepɨretaxata».   
\p
\v 16 Yawé Warami 'anukunakeka yuniuki kaniyetuirieni mɨpaɨ katinitahɨawe: «Waraki hetsɨa kenakunua, kenemɨtayɨni mɨpaɨ ketinetahɨawi».   
\p
\v 17 Warami kaneyani hakewa Waraki mekatei, kanitaxeiya 'a'uwekame yumawari taiyariyari 'aurie meta muhawitsixi 'ukirawetsixi wahamatɨa. Waraki mɨpaɨ katinita'iwawiya:  
\p —¿Yawé kehetayɨ?   
\p
\v 18 Hikɨ Warami katiniutaxata:  
\q1 «Kenanukukexi, Waraki, keneu'ena,  
\q2 Tsipuxi nu'aya, keneneu'eni.   
\q1
\v 19 Kakaɨyari mɨmɨwe pɨkahɨkɨ  
\q2 mɨkati'itawa meta mɨka'ikupata.  
\q1 Katinaye'atɨwani kemɨtayɨni  
\q2 yakatinikamieni.   
\q1
\v 20 Mɨpaɨ kanetinahɨaweni 'aixɨa nemɨwayurienenikɨ,  
\q2 xɨka Kakaɨyari mɨpaɨ tinakeni,  
\q2 ketsɨkuta tawarita netiyurieneni.   
\b  
\q1
\v 21 »Kakaɨyari Kakuwu pɨkaxeiya 'axatiyurieneme  
\q2 'Ixaheri pɨkatiuyukananaima.  
\q1 Yawé wakakaɨyari wahamatɨa puyeika,  
\q2 wahamatɨa ti'aitame puyuxata.   
\q1
\v 22 Kakaɨyari 'Ekipitu kaniwarayewitɨni  
\q2 tuuru kemɨtitɨrɨkaɨye hepaɨ.   
\q1
\v 23 Kakuwu hetsɨa 'ikewari pumawe,  
\q2 meta 'Ixaheri hetsɨa 'awie memɨte'uyemate mepɨkaxuawe.  
\q1 Kakuwu meta 'Ixaheri wahepaɨtsita mɨpaɨ katinitaniukiemɨkɨ:  
\q2 “Xeketeneuxeiya Kakaɨyari 'aixɨa kemɨtiuyuri”.   
\q1
\v 24 'Ikɨ teɨteri, xeimieme mekanixatani maye 'uka hepaɨ,  
\q2 mɨkɨ maye 'uki mɨtikuwaɨne hepaɨ.  
\q1 Pɨkaka'uxipieni tita mɨtikuweiyane 'i'axemeke  
\q2 mɨwakwini waxuriya ha'iemeke».   
\p
\v 25 Hikɨ Waraki, Warami mɨpaɨ katiniutahɨawe:  
\p —Xɨka 'axapekawayurimɨkɨ, kamɨtsɨ tsikere 'aixɨa pepɨkawayurieka.   
\p
\v 26 Warami mɨpaɨ kaniutayɨni:  
\p —¿Ne tamɨ mɨpaɨ nekamerahɨawekai, kename ne Yawé kemɨnetitahɨawekekai yanetiyurienikekai?   
\s1 Hairieka Warami kemɨtiuxa  
\p
\v 27 Hikɨ Waraki, Warami mɨpaɨ katiniutahɨawe:  
\p —Hikɨmɨ neuxei, xaɨtsie pɨta nepɨmatsi'anuwitɨni. Heiwatɨ mana Kakaɨyari 'inakeni 'axapemɨwayurienikɨ.   
\p
\v 28 Hikɨ Warami kanewitɨni Pehuxi hɨriyaritsie paitɨ, makumawetsie Ketsimuni mahekɨatsie.  
\v 29 Mana Warami mɨpaɨ katinitahɨawe:  
\p —'Ena keneneutiwewiri 'atahutame mawari taiyame meta keniwarukuha'aritɨa 'atahutame tsikerutsixi meta muxatsi 'ukitsi.   
\p
\v 30 Waraki yakatiniuyurieni Warami kemɨrehɨawekai, mana kaniwarutimawa 'atahutame tsikerutsixi meta muxatsi 'ukitsi.   
\c 24  
\p
\v 1 Hikɨ kepaukua Warami mɨpaɨ mɨretima Yawé minakekai 'Ixaheri 'aixɨa muyuriekakɨ, hikɨ pɨkawarukewaiyaxɨ, meripaitɨ hepaɨ, matsi tawarita makumawetsie kaneutaniere.  
\v 2 Kepauka Warami meutanierixɨ 'ixaheritsixi kaniwaruxeiya kememɨteheunuiwari mɨpaɨ meteheukuteme, hikɨ Yawé 'iyarieya hetsiena kaninuani,  
\v 3 hikɨ mɨpaɨ kaniutayɨni:  
\q1 «Warami niukieya Wehuxi nu'aya,  
\q2 tewi niukieya 'aixɨa mɨti'ane mɨtixeiya.   
\q1
\v 4 Niukieya mɨ'enie Kakaɨyari kaniniukieyatɨni,  
\q2 Naimekɨmɨtɨrɨkaɨye mɨtixeiya,  
\q2 mukakukutsutsie hepaɨ mɨtikuxaxatɨariwa.   
\b  
\q1
\v 5 »Kakuwu, 'axamarute witsipɨ'anene.  
\q2 'Ixaheri, witsipɨtiyuxexeiya pemanukatsie.   
\q1
\v 6 'Aki muyehapane hepaɨ pɨtiyuxexeiya manuyunanake,  
\q2 tuturi hatetsita mɨ'iteɨritsie hepaɨ pɨtiyuxexeiya,  
\q1 'aruhe 'iteɨriyari Yawé mika'iteɨtaxɨ hepaɨ,  
\q2 kariuxa hatetsita mɨti'u hepaɨ pɨ'anene.   
\q1
\v 7 Xariteya haa panakayeuriwe,  
\q2 'imɨarieya puyutemawie haa waɨkawa mexeiyakɨ.  
\q1 Ti'aitame pɨmariwe 'Akaki reuyeta,  
\q2 mariwetɨ 'aitsikaya payuyeitɨwa.   
\b  
\q1
\v 8 »Kakaɨyari 'Ekipitu kaniwarayewitɨni  
\q2 tuuru tsimaruni mɨtitɨrɨkaɨye hepaɨ.  
\q1 'Ixaheri nuiwarite memeye'unie kaniwatikwa'ani,  
\q2 wa'umete kanititarani,  
\q2 yu'ɨrɨkɨ kaniwatimɨmɨni.   
\q1
\v 9 Maye 'uki hepaɨ kanakatutsitani,  
\q2 maye 'ukaratsi hepaɨ 'akaniuhupuni:  
\q2 ¿kemɨ'ane ka'ukamatɨ piyehaxɨatɨawe?  
\q1 'Aixɨa meke'itɨarieka 'aixɨa memɨmatsiyurie.  
\q2 'Axameke'itɨarieka 'axamemɨmatsiyurie».   
\p
\v 10 Hikɨ Waraki kaniuyeha'ani Warami hepaɨtsita, yumamatetsie heuyɨtɨminatɨ mɨpaɨ katinitahɨawe:  
\p —Nekametiniutanɨ'airieni 'axapemɨwayurienikɨ nemɨwaraye'unie, hikɨri hairieka matsi 'aixɨa petiwayurie pɨta.  
\v 11 Tsepa hikɨ kenemie 'akie. Ne mɨpaɨ nepɨmarahɨawekai kename nematipitɨanikekai, peru mɨkɨ Yawé pɨkamatiutanaki'eriri.   
\p
\v 12 Warami mɨpaɨ katinitahɨawe:  
\p —Ne mɨpaɨ nepɨtiwarahɨawekai netsi'iniwamete pemɨwarenɨ'a:  
\v 13 “Tsepa Waraki yuparatsiyu hurukɨ meta pɨratakɨ hɨneme mɨnetiuxatɨa, ne 'aixɨa nepɨkatiuyuriwe meta 'axanepɨkatiuyuriwe, matsi Yawé nekakaɨyari xeikɨa 'aitsikaya kemaine mɨpaɨ nepɨ'aneni. Yawé xeikɨa kemɨneti'aitɨa mɨpaɨ nepɨtiyurieneni”.  
\v 14 Hikɨ mexi neka'akunuawe nekie, nepɨmatitaxatɨani 'ikɨ kiekari 'ateɨterima kemɨwayurieni 'uxa'atɨni warie haye'ayu.   
\s1 Warami naurieka kemɨtiutaxa  
\p
\v 15 Hikɨ Warami mɨpaɨ kaniutayɨni:  
\q1 «Warami niukieya Wehuxi nu'aya,  
\q2 tewi 'aixɨa mɨti'ane mɨtixeiya niukieya.   
\q1
\v 16 Niukieya mɨ'enie Kakaɨyari kaniniukieyatɨni.  
\q2 'Amutewi kemɨtiku'eriwa mɨmate,  
\q1 Naimekɨmɨtɨrɨkaɨye mɨtixeiya,  
\q2 mukakukutsutsie hepaɨ mɨtikuxaxatɨariwa:   
\b  
\q1
\v 17 »Nekanixeiyani, peru hikɨ 'akuxi hawaikɨ,  
\q2 nekanixeiyani, peru 'ahurawa hawaikɨ.  
\q1 Kakuwu xuraweya kananatinemɨkɨ,  
\q2 xewitɨ ti'aitame 'Ixaheri hetsie kananukukemɨkɨ.  
\q1 Muhawi mu'uya kanitapɨnamɨkɨ  
\q2 meta Tseti niwemama wamu'ute.   
\q1
\v 18 'Erumi kana'iwariemɨkɨ,  
\q2 Tsehixi meye'unie, tipiinieya katinayeimɨkɨ,  
\q2 mexi 'Ixaheri yukuha'aritɨwani, mariwemekɨ mɨtiyurienikɨ.   
\q1
\v 19 Kakuwu nuiwarieyatsie xewitɨ rayu'iwatɨ kanitinemɨkɨ,  
\q2 'Ahixi kiekatari memuyuhayewaxɨ kaniwatayuniyamɨkɨ».   
\s1 'Imatɨrieka Warami kemɨtiuxa  
\p
\v 20 Warami 'Amareki 'uxeiyaka mɨpaɨ kaniutayɨni:  
\q1 «'Amareki mexɨakame nuiwari kanihɨkɨtɨni,  
\q2 peru 'imatɨrieka naitɨ kanika'unariemɨkɨ».   
\p
\v 21 Hikɨ Warami kenitsixi waruxeiyaka mɨpaɨ kaniutayɨni:  
\q1 «Tsepa kuraru 'aixɨa 'aneme pemateka  
\q2 meta tsepa 'a'itua 'aitsie paitɨ makama,   
\q1
\v 22 'ekɨri Kahini, taipa pekaneyani,  
\q2 meta 'Atsiriya kamenanuhanimɨkɨ».   
\p
\v 23 Hikɨ Warami mɨpaɨ kaniutayɨni:  
\q1 «Xɨa'ui, ¿kemɨ'anetsɨ kuta pɨtawikweni  
\q2 kepauka Kakaɨyari mɨpaɨ mɨtiyurieni?   
\q1
\v 24 Kanuwate 'amɨpapa kani'axɨakuni Tsipɨre manexɨani,  
\q2 'Atsiriya meta 'Ewexi memɨtewakwinitɨanike,  
\q2 mɨkɨ yaxeikɨa mekanika'unariekuni».   
\p
\v 25 Mɨpaɨ titaxatɨaka Warami kaneyani yukwiepa paitɨ, yaxeikɨata Waraki yuhuyeta kaneyani.   
\c 25  
\s1 'Ixaheritsixi ke'axamemɨte'uyuri  
\p
\v 1 Kepauka 'ixaheritsixi Tsitini memɨtitekai, 'ukari muhawitsixi wahamatɨa mekaniutihitɨkɨne,  
\v 2 mɨkɨ mekaniwa'iniekaitɨni wakakaɨyarixi mawari memɨwawewiriekakɨ. 'Ixaheritsixi mɨkɨ kakaɨyarixi wahɨxie mekateniutikwa'akaitɨni meta wahɨxie mekaniutitunuma'uwekaitɨni.  
\v 3 Wahari-Pehuxi mehayexeiyatɨ mekanayuyeitɨwakaitɨni. 'Ayumieme Yawé kaniuyeha'ani.   
\p
\v 4 Hikɨ Yawé Muitsexi mɨpaɨ katiniutahɨawe: «Yunaime 'ixaheritsixi wa'ukiyarima keniwarukawɨtɨa 'utukakaku, nemɨhaxɨapienikɨ 'ixaheritsixi nemɨkatiwakwinitɨanikɨ».   
\p
\v 5 Muitsexi mɨpaɨ katiniwarutahɨawe 'ixaheritsixi wa'itsɨkate: «Xekeniwarukuya kemɨ'ane Wahari-Pehuxi me'ayexeiyatɨ memakɨ».   
\p
\v 6 'Ixaheritsixi me'utitsuanakaku 'ixuriki tukiyari mɨranutahakitɨretsie, 'ixaheri tewiyari xeime 'uka mariyani tewiyari kani'atɨani, Muitsexi nierekaku meta yunaitɨ teɨteri 'ixaheritsixi, yu'iwama kaniwarutahɨawitsitɨani.  
\v 7 Hikɨ 'uniereka mawari wewiwame Pinexi 'Eriyatsaxi nu'aya 'Aruni teukarieya. Teɨteri waruku'eirieka pitsika 'amɨtewi 'akwetɨ kaneyani,  
\v 8 mɨkɨ tewi kananukuweiya, xamarutana kaneutahani kaniwarutimɨni 'uki 'ixaheri meta 'uka. Mɨpaɨ tiuyɨku 'ixaheritsixi kememɨtekwi'ikai katineuyunuani.  
\v 9 'Ana mɨkɨ kwiniyakɨ xeitewiyari heimana nauka miriyari (24.000) mekaniukwini.   
\p
\v 10 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 11 «Pinexi, 'Eriyatsaxi nu'aya meta 'Aruni teukarieya, mɨkɨ katiniuyurieni nehaxɨa manukanuitɨa, ne newakwerietɨ kenemɨrehɨawekai mɨpaɨ katiniuyurieni. 'Ayumieme ne'ɨtetsarikakɨ 'ixaheritsixi nepɨkawaruka'unaxɨ.  
\v 12 Pinexi mɨpaɨ ketineutahɨawi tɨratu temɨwewienikɨ ne nemikuhɨawenikɨ,  
\v 13 yukɨmana mɨkɨ meta nuiwarimama mawari wewiwamete yuheyemekɨ mepɨhɨkɨtɨni, nehetsie mutanuakɨ 'ɨtetsatɨ, meta 'ixaheritsixi wahetsie 'itiya mawariyari muwewikɨ».   
\p
\v 14 Tewi mumierie 'uka mariyani tewiyari hamatɨa, Tsimɨri katinitewakaitɨni Tsaru nu'aya, manuyeka kanihɨkɨtɨkaitɨni Tsimehuni xeime nuiwarieyatsie mieme.  
\v 15 'Uka mariyani tewiyari Kutsiwi katinitewakaitɨni, Tsuxi kaninu'ayatɨkaitɨni, manuyeka Mariyani xeime nuiwaritsie mieme.   
\p
\v 16 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 17 «Mariyanitsixi xekeniwaretakuya keniwarekuya,  
\v 18 mɨkɨ memɨxe'utakwikɨ mexete'irɨwiyatɨ, Wahari-Pehuxi hetsɨa memɨxeye'atɨakɨ, kemuyɨ Kutsiwi manuyeka Mariyani niweya mumɨ, kepauka memɨkwi'ikaitsie Wahari Pehuxi hekɨ».   
\c 26  
\s1 Hutarieka 'ixaheritsixi kememɨte'uti'inɨatsie  
\p
\v 1 Merikɨte 'ixaheritsixi mɨyamete'ukwiku reutiyetana, Yawé Muitsexi mɨpaɨ katiniutahɨawe meta mawari wewiwame 'Eriyatsaxi 'Aruni nu'aya:  
\v 2 «Xekeniwaruka'utɨa 'ixaheritsixi yunaime waniwema kemɨ'ane memɨwa'ukiyarima. Xekeniwaraka'utɨa xeitewiyari wiyari memɨhɨtɨka huteikɨ meutiyune, kuyakɨ 'aixɨa memɨ'anene 'ixaheritsixi wahetsiemiemekɨ».   
\p
\v 3 Muitsexi meta 'Eriyatsaxi hamatɨa, yunaime teɨteri wahamatɨa mekateniutaxata mayeweri Muhawi kwieyaritsie, haa Kurutani manuyeka 'aurie, Keriku hɨxie, mɨpaɨ mekateniwaruta'aitɨani  
\v 4 memɨwaraka'utɨanikɨ 'ukitsi xeitewiyari wiyari meutiyune memexeiyatɨka, Yawé Muitsexi kemɨrahɨawekai.  
\b  
\p 'Ixaheritsixi 'Ekipitu memɨyekɨ 'ikɨ mekanihɨkɨtɨkaitɨni:   
\b  
\p
\v 5-6 Xuweni niwemama 'Ixaheri matɨarieya: 'Enuki, Paru, Ketsiruni meta Karimi, mɨkɨ wanuiwari mekanihɨkɨtɨni: 'enukitsixi, parutsixi, ketsirunitsixi meta Karimitsixi.  
\v 7 Mɨkɨ mekanihɨkɨtɨni Xuweni nuiwarimama. Yunaitɨ mekanihɨkɨtɨkaitɨni huta tewiyari heimana haika miriyari, heimana 'atahuta tsienituyari, heimana xeitewiyari heimana tamamata (43.730) teɨteri.   
\p
\v 8 Paru nu'aya 'Eriyawi yuxewitɨ xeikɨa kanayani.  
\v 9 'Eriyawi niwemamata mekanakɨne: Nemuheri, Ratani meta 'Awirani, me'anayexeiyariekatɨtɨ teɨteri wahetsiemiemekɨ, Muitsexi meta 'Aruni mekaniutiniukimani kepauka Kure mɨwa'iniekai kepauka 'axamɨtiuyuri Yawé hɨxie.  
\v 10 Kepauka kwie mɨwareukakwai Kure yunaime, meta kemɨ'ane memeweiyakai. Tai kaniwarutitaiya huta tsienituyari, heimana huta tewiyari heimana tamamata teɨteri, mɨpaɨ tawari memɨkayɨakakɨ katiniuyɨni.  
\v 11 Matsi Kure niwemama mepɨka'ukwi.   
\b  
\p
\v 12-13 Nemuheri nuiwarimama, Kamini, Tsera meta Tsahuri, Tsimehuni niwemama, Wanuiwari mekanihɨkɨtɨni: nemuheritsixi, kaminitsixi, tseratsixi meta tsahuritsixi.  
\v 14 'Ikɨ mekanihɨkɨtɨni Tsimehuni nuiwarimama. Yunaitɨ mekanakɨne xeitewiyari heimana huta miriyari heimana huta tsienituyari (22.200) teɨteri.   
\b  
\p
\v 15-17 Tsepuni, Kaki, Tsuni, 'Utsini, 'Eri, 'Aruri meta 'Areri, 'ikɨ Kahari niwemama mekanihɨkɨtɨni, 'ikɨta wanuiwarima: tsepunitsixi, kawuhitsixi, tsunitsixi, 'utsinitsixi, 'eritsixi, 'aruritsixi meta 'areritsixi.  
\v 18 'Ikɨ Kahari nuiwarimama mekanihɨkɨtɨni. Yunaitɨ mekanakɨne huta tewiyari miriyari heimana 'auxɨwi tsienituyari (40.500) teɨteri.   
\b  
\p
\v 19-20 'Exi meta 'Unani Kura mepɨniwemama, Kanani mɨkɨ mekaniukwini. Tseraxi, Paretsi meta Tseratsi wanuiwari mekanihɨkɨtɨni: tseraxitsixi, paretsixi meta tserahitsixi.   
\p
\v 21 Paretsi niwemama, Ketsiruni meta Kamuri, wanuiwari mekanihɨkɨtɨni ketsirunitsixi meta kamuritsixi.  
\v 22 Mɨkɨ Kura mekaninuiwarieyatɨni. Yunaitɨ mekanakɨne haika tewiyari heimana tamamata heimana 'ataxewime miriyari heimana 'auxɨwi tsienituyari (76.500) teɨteri.   
\b  
\p
\v 23-24 'Itsakaxi niwemama, Tura, Puwa, Yatsuwi meta Tsimiruni, wanuiwari mekanihɨkɨtɨni: turahitsixi, puwitsixi, yatsuwitsixi meta tsimirunitsixi.  
\v 25 Mɨkɨ 'Itsakaxi nuiwarimama mekanihɨkɨtɨni. Yunaitɨ mekanakɨne haika tewiyari heimana nauka miriyari heimana haika tsienituyari (64.300) teɨteri.   
\b  
\p
\v 26 Tsawuruni niwemama, Tsereri, 'Eruni meta Yareri, wanuiwari mekanihɨkɨtɨni: tserenitsixi, 'erunitsixi meta yareritsixi.  
\v 27 'Ikɨ Tsawuruni nuiwarimama mekanihɨkɨtɨni. Yunaitɨ mekanakɨne haika tewiyari miriyari heimana 'auxɨwi tsienituyari (60.500) teɨteri.   
\b  
\p
\v 28 Kutse niwemama, Manatsexi meta 'Epɨrahini, wanuiwari mekanihɨkɨtɨni:   
\pi1
\v 29 Manatsexi niwemama, Makixi meta Karaha, Makixi nuiwarimama mekanihɨkɨtɨni, makiritsixi meta Karaha nuiwarimama.   
\pi1
\v 30-32 Karaha niwemama, Ketsexi, Kere, 'Atsirieri, Tsikeni, Tsemira meta Hepexi, wanuiwari mekanihɨkɨtɨni: ketseritsixi, kerekitsixi, 'atsiriheritsixi, tsikenitsixi, tsemirahitsixi meta heperitsixi.  
\v 33 Tserupekari Hepexi nu'aya 'ukitsi pɨkawarutinuari 'ukari xeikɨa, mekatenitetewakaitɨni, Makira, Nuha, Kukɨra, Mirika meta Tiritsa.  
\v 34 'Ikɨ Manatsexi wanuiwari mekanihɨkɨtɨni. Yunaitɨ mekanakɨne huta tewiyari heimana tamamata heimana huta miriyari heimana 'atahuta tsienituyari (52.700) teɨteri.   
\pi1
\v 35 'Epɨrahini niwemama, Tsutera, Wekexi meta Takani, wanuiwari mekanakɨne, tsuterahitsixi, wekeritsixi meta takanitsixi.   
\pi1
\v 36 Tsutera nu'aya 'Erami, nuiwarieya mekanihɨkɨtɨni, 'eramitsixi.  
\v 37 'Ikɨ mekanihɨkɨtɨni 'Epɨrahini nuiwarimama. Yunaitɨ xeitewiyari heimana tamamata heimama huta miriyari heimana 'auxɨwi tsienituyari (32.500) teɨteri mekanakɨne.  
\p 'Ikɨ yunaitɨ nuiwarite Kutse hetsie mekaniyekɨne.   
\b  
\p
\v 38-39 Wenikamini niwemama, Wera, 'Atsiweri, 'Akirani, Tsupani meta Kupani, mekaniwanuiwaritɨni: werahitsixi, 'atsiweritsixi, 'akiranitsixi, tsupanitsixi meta kupanitsixi.   
\p
\v 40 Wera niwemama 'Axi meta Nahamani, wanuiwari mepɨhɨkɨ 'aritsixi meta namanitsixi.  
\v 41 'Ikɨ Wenikamini wanuiwari mekanihɨkɨtɨni. Yunaitɨ mekanakɨne huta tewiyari heimana 'auxɨwi miriyari heimana 'ataxewime tsienituyari (45.600) teɨteri.   
\b  
\p
\v 42 Rani nu'aya Tsukani nuiwarieya tsukanitsixi mepɨhɨkɨ, mɨkɨ xeikɨa mekanihɨkɨtɨkaitɨni Rani nuiwarieya.  
\v 43 Haika tewiyari heimana nauka miriyari heimana nauka tsienituyari (64.400) teɨteri mepɨhɨkɨtɨkai.   
\b  
\p
\v 44 'Atsexi niwemama 'Imɨna, 'Itsiwi meta Weriya, wanuiwarima mepɨhɨkɨ: 'imɨnatsixi, 'itsiwitsixi meta weriahitsixi.   
\p
\v 45 Weriya niwemama Hewexi meta Marikiheri wanuiwari mepɨhɨkɨ: heweritsixi meta marikieritsixi.  
\v 46 'Atsexi xeimeta 'uka kanayexeiya Tsera titewakame.  
\v 47 'Ikɨ 'Atsexi wanuiwari mekanihɨkɨtɨni. Yunaitɨ mekanakɨne huta tewiyari heimana tamamata heimana haika miriyari heimana nauka tsienituyari (53.400) teɨteri.   
\b  
\p
\v 48-49 Nepɨtahari niwemama Yatseri, Kuni, Ketsexi meta Tsireni, wanuiwari mekanihɨkɨtɨni: yatseritsixi, kunitsixi, ketsexitsixi meta tsirenitsixi.  
\v 50 'Ikɨ mekanihɨkɨtɨni Nepɨtahari nuiwarimama. Yunaitɨ mekanakɨne huta tewiyari heimana 'auxɨwime miriyari, heimana nauka tsienituyari (45.400) teɨteri.   
\b  
\p
\v 51 Yunaitɨ teɨteri 'ixaheritsixi 'ataxewime tsienituyari heimana xeimiriyari, heimana 'atahuta tsienituyari heimana xeitewiyari heimana tamamata (601.730) mekaniyupaɨmekaitɨni.   
\s1 Kwie kememɨteyetuiriyarie 'inɨaritɨkaime  
\p
\v 52 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 53 «Kwie keniwayetuiri 'inɨaritɨkaime 'ikɨ nuiwarite wahetsiemieme mɨhɨkɨtɨnikɨ. Keyupaɨmetɨ memaka'utɨarie mɨpaɨ meyupaɨmeme keniwaruxatɨa.  
\v 54 Kemɨ'ane nuiwari memɨyumɨire 'ayeukame pekaniwayetuiriemɨkɨ, kemɨ'ane nuiwari 'etsimemɨyupaɨmeni, 'etsiyeukame pekaniwaxatɨamɨkɨ. Yuxexuitɨ nuiwari yamekatenimikiekuni keyupaɨmetɨ memaye'uka.  
\v 55 Kwie 'inɨarikɨ mekanita'iwakuni nuiwari wa'ukiyarima kememɨtetetewakai.  
\v 56 Mekaniyuta'iwakuni yunaitɨ nuiwarite wahetsie, 'etsimemɨyupaɨme meta 'amemɨyupapaɨme wahamatɨa».   
\s1 Rewitsixi kememute'aka'utsie  
\p
\v 57 Rewitsixi Keritsuni, Kuhati meta Merari, wanuiwari mepɨhɨkɨtɨkai keritsunitsixi, kuhatitsixi meta meraritsixi.   
\p
\v 58 Rewitsixi wanuiwaritsie memɨyekɨ mepɨhɨkɨta: Riwinitsixi nuiwariyari, hewurunitsixi nuiwariyari, Makiri nuiwarimama, Muhutsi nuiwarimama meta Kure nuiwarimama. Kuhati 'ukiyarieya 'Amirani pɨhɨkɨtɨkai.  
\v 59 'Amirani 'ɨyaya Kukaweri pɨtitewakai 'ukiyarieya Rewi pɨhɨkɨtɨkai, 'Ekipitu putinuiwakai. Tɨɨri mepɨwarayexei 'Amirahami hamatɨa mekanihɨkɨtɨni 'Aruni, Muitsexi meta wa'iwa 'uka Miriyami.  
\v 60 'Aruni Narawi puwapaapatɨkai, 'Awihu, 'Eriyatsaxi meta 'Itamaxi.  
\v 61 Narawi 'Awihu hamatɨa mekaniukwini Yawé hɨxie taipa 'axa'aneme memɨte'itimawirikɨ.   
\b  
\p
\v 62 Rewitsixi xeimetseri memexeiyatɨka mana meutiyune yunaitɨ xeitewiyari heimana haika miriyari (23.000) mekanakɨne. Hipatɨ 'ixaheritsixi wahamatɨa mepɨka'u'inɨatsie, wahepaɨ memɨkateyetuiriyarienikekaikɨ.   
\b  
\p
\v 63 'Ikɨ mekanihɨkɨtɨni 'ixaheritsixi Muitsexi mɨwaruti'inɨataxɨ meta 'Eriyatsaxi hamatɨa, mayeweri Muhawi kwieyaritsie, haa Kurutani manuyehane 'aurie, Keriku hɨxie.  
\v 64 Meripaitɨ makumawetsie Tsinahi Muitsexi 'Aruni hamatɨa memɨwaraka'utuakai, xewitɨ pɨka'ayemiekai hekwamekɨ memaka'utsietsie,  
\v 65 Yawé mɨpaɨ mutayɨkaikɨ kename yunaitɨ mekwinikekai. Mekaniyuhayewaxeikɨa Karewi, Kepune nu'aya, meta Kutsuhexi Nuni nu'aya, tawarita xewitɨ pɨka'utawikwei.   
\c 27  
\s1 Tserupekari niwemama 'ukari  
\r ('Inɨa 27:1-11 – 'Inɨa 36:1-12)  
\p
\v 1 Makira, Nuha, Kukɨra, Mirika meta Tiritsa Manatsexi nuiwarimama hetsie menimiemetetɨkaitɨni Kutse nu'aya, 'ukari Tserupekari niwemama mekanihɨkɨtɨkaitɨni Hepexi nu'aya, Karaha nu'aya, Makixi nu'aya meta Manatsexi nu'aya. Hikɨ mɨkɨ meyu'auxɨwitɨ mekanekɨne  
\v 2 'ixuriki tukiyari manuwetsie, Muitsexi meta mawari wewiwame 'Eriyatsaxi wahamatɨa metetaxatake meta memanuyetei wahamatɨa. Hikɨ mɨpaɨ mekateniwarutahɨawe:  
\v 3 «Tapaapa kanemɨni 'ukitsi kawatinuariwetɨ, Kure mɨnɨkaikɨ pɨka'uyɨ Yawé hepaɨtsita mauniukakaikɨ. Kaniumɨni makumawetsie yukɨmana 'axakemɨtiyurienekaikɨ.  
\v 4 ¿Kamɨtsɨ metehayeyeitɨarieni nuiwarimama tapaapa kemɨtitewa 'ukitsi mɨkawarutinuarikɨ? Tame tekaniniwemamatɨni. Ketaneyetuiri kwie tapaapa 'iwamama wahamatɨa».   
\p
\v 5 Muitsexi Yawé kaniuta'iwawiya kememɨtehehɨawekai,  
\v 6 Yawé mɨpaɨ katinita'eiya:  
\v 7 «Kememaitɨka Tserupekari niwemama 'aixɨa kani'aneni, 'ayumieme keniwayetuiri wahetsiemieme wapaapa 'iwamama wahepaɨ. Wapaapa mɨhetsiemiemetɨkai mɨkɨ keniwaruxatɨa.   
\p
\v 8 »Metatsiere 'ixaheritsixi mɨpaɨ ketiniwarutahɨawi: “Kepauka xewitɨ tewi mɨmɨni 'uki katinuariwetɨ, 'uka pɨta katinanupimɨkɨ.  
\v 9 Xɨkata mɨkɨ 'uka ka'utinuarieni, 'iwamama pɨta mekatenanupikuni.  
\v 10 Xɨka 'uki ka'uti'iwatakaitɨni, paapaya 'iwamama mekatenanupikuni.  
\v 11 Xɨka paapaya kareka'iwaka, Xewitɨ 'ahurawa 'iwaya katinanupimɨkɨ hetsiena mieme mɨrayanikɨ. Mɨpaɨ 'ixaheritsixi mekatenikahukuni 'aitsika mɨheitserie kanihɨkɨtɨkamɨkɨ, ne Muitsexi kenemɨtiuta'aitɨa”».   
\s1 Muitsexi kemɨtiutahɨawarie mɨmɨximekaikɨ  
\p
\v 12 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\p —'Awarini hɨriyaritsie paitɨ kenemie, mana keneuxeiya kwie 'ixaheritsixi nemɨwayetuirieni.  
\v 13 Hikɨ 'ari pe'ixeiyame, pekanimɨmɨkɨ pekaniyemieni 'apaapama wahetsɨa 'a'iwa 'Aruni hepaɨ.  
\v 14 Makumawe Tsini mɨrakutewatsie, kepauka teɨteri 'axamemutiyuanekai, xeme xeyuhutatɨ xepɨkanetsi'anu'eni, kepauka haa tetetsie xemanetɨa, teɨteri wahɨxie mɨpaɨ xepɨkatehetima kenemɨtipatsie.  
\p Mɨkɨ haa Meriwa mɨtitewa Karetsi paitɨ katine'aneni, Tsini makumawetsie.   
\s1 Muitsexi xeime kemɨtiuta'iwau 'Ixaheri mɨyewitɨnikɨ  
\p
\v 15 Muitsexi Yawé mɨpaɨ katiniuta'eiya:   
\p
\v 16 ―Yawé, yunaime teɨteri wakakaɨyari, xeime keneutahɨawi manuyekanikɨ 'ikɨ teɨteri wahetsiemieme,  
\v 17 mɨwaruwitɨximenikɨ hakewa memetiyaxe, mɨwaranuwitɨnikɨ memuyukwiyutsie meta mɨwarakunuitɨanikɨ wakie. Mɨpaɨ Yawé 'ateɨterima muxatsi memɨka'ukutsiyari hepaɨ mepɨkateyuxexeiyani.   
\p
\v 18 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\p —Kutsuhexi Nuni nu'aya xekenayeitɨa, mɨkɨ yu'iyarikɨ 'aixɨa katiniyɨkɨhɨaweni. Hetsiena keneutime'i,  
\v 19 mawari wewiwame 'Eriyatsaxi hɨxie kene'atɨa meta yunaime teɨteri wahɨxie. Hikɨ yunaime wahɨxie mɨti'aitanikɨ pekaniyetuiriemɨkɨ.  
\v 20 Pekatinihɨritɨamɨkɨ 'ekɨ kepemɨti'aitakai, mɨpaɨ yunaitɨ 'ixaheritsixi memei'eniekakɨ.  
\v 21 Hikɨ mawari wewiwame 'Eriyatsaxi hetsɨa kaniye'amɨkɨ, yamɨtayɨnikɨ 'inɨari wewietɨ \tl 'urimi\tl* meta \tl tumimi\tl* hekɨ Yawé kanitahɨawimɨkɨ. Kepauka Kutsuhexi mɨta'inieni memuyukwiyukɨ, yunaitɨ teɨteri mekaniyehuni hamatɨana, meta kepauka mɨta'inieni memakunuaxɨanikɨ, mɨkɨta mekanakununuwakuni.   
\p
\v 22 Muitsexi yakatiniuyurieni Yawé kemɨtita'aitɨa. Kutsuhexi 'uta'inieka mawari wewiwame 'Eriyatsaxi hɨxie kanei'inieni meta yunaime teɨteri wahɨxie.  
\v 23 Hikɨ heimana kaneutimeni hɨritɨarika kaniyetuirieni, mɨpaɨ katiniuyurieni Yawé kemɨtita'aitɨakai.   
\c 28  
\s1 Wiyari 'inɨariyari  
\p
\v 1 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 2 «Mɨpaɨ ketiniwarutahɨawi 'ixaheritsixi memɨkatehatɨtɨmaiyanikɨ kemɨ'ane tukaritsie memɨnete'utimawiriwanikɨ. Mɨkɨ mawari taiyarikayari witsimu'ɨa mɨkɨ ne'ikwai kanihɨkɨtɨni.   
\s1 Tita yamɨtimawarieka  
\p
\v 3 »Mɨpaɨta ketiniwarutahɨawi 'ixaheritsixi, mawari taiyarika hetsiemieme, yamepɨnete'atɨiriwani xexuime tukaritsie mawari taiyariyari yareuyuhanemekɨ yuhutame muxatsi xeiwiyari mehɨtɨkaime 'aixɨa me'anenekame.  
\v 4 Xeime ximeri pekanitimawamɨkɨ, xeimeta taikai,  
\v 5 meta wahamatɨa huta kiruyari tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ pɨnariekame pekanitimawamɨkɨ.  
\v 6 'Ikɨ mawari taiyariyari yamɨreuyuhane kanihɨkɨtɨni, kenemɨtixekɨhɨawekai Tsinahi hɨriyaritsie taiyarika mawarikayaritsie, witsimu'ɨa Yawé minake.  
\v 7 Yuxexuime muxatsi wahetsie xeirituruyari kaxie winuyari mɨtiyeuriyani mawariyari heutinɨkame kaniyetuamɨkɨ, tukita Yawé minake hetsiemieme kanitiyeuriyamɨkɨ.  
\v 8 Hutarieka mieme muxa taikai pekanitimawamɨkɨ, hatsite mawarikayari hamatɨa meta winu hatuiyariyari ximeri pemitimawaxɨ hepaɨ. Taiyarika mawarikayari kanihɨkɨtɨni, Yawé minake 'ɨakariyari.   
\s1 Mawarika xawatikɨ mieme  
\p
\v 9 »Xawatikɨ pekaniwarutimawamɨkɨ yuhutame muxatsi xeiwiyari memɨhɨtɨka, 'aixɨa me'aneneme mekatekukuyeme, meta kaxie winuyari manutituarike heutinɨkame, metatsiere nauka kiruyari 'imeriyu tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ wiyamakame.  
\v 10 'Ikɨ mawari taiyariyari kanihɨkɨtɨni xawatikɨ mieme, hutariekamieme 'ikɨ taiyarika kanihɨkɨtɨni kaxie winuyari mɨtiyeuriwa heutinɨkame.   
\s1 Mawarika xeimetseritsie mieme  
\p
\v 11 »Metseri maye'axenitsie mexɨakame tukaritsie mawari taiyariyari pekaniutiwewiwamɨkɨ Yawé hetsiemieme, yuhutame tsikerutsixi, xeime muxa 'ukitɨme, meta 'atahutame muxatsi xeiwiyari mehɨtɨkaime 'aixɨa memɨ'anene memɨkatekukuye.  
\v 12 Yuxexuime tsikerutsixi wahamatɨa pekaninɨitɨamɨkɨ tɨriku mɨtɨxiyari 'aixɨa mɨ'ane 'ataxewime kiruyari 'imeriyu hatseitikɨ wiyamakame, muxa 'uki hamatɨata nauka kiruyari 'imeruyu tɨriku mɨtɨxiyari 'aixɨa mɨ'ane wiyamakame hatseitikɨ,  
\v 13 meta yuxexuime muxatsi wahamatɨa, huta kiruyari tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ wiyamakame. 'Ikɨ mawari taiyariyari kanayeimɨkɨ, 'imikieri taipa kwaxiyariekame, witsimu'ɨa Yawé minake hetsiemieme.  
\v 14 Menutinɨni 'ikɨ kaniyɨmɨkɨ: Yuxexuime tsikerutsixi wahetsie huta rituruyari winu, muxa 'uki hetsiemieme xeirituruyari heimana hixɨapa 'akame winu, yuxexuime muxatsi wahetsieta xeirituruyari winu. 'Ikɨ taiyarika mawarikayari pekaniuwewiximemɨkɨ, naime wiyaritsie, xexuime metseriyaritsie 'aye'axekaku metseri 'anatiwautsekaku.  
\v 15 Mɨpaɨta kani'aneni mawarika taiyariyari yapemɨtiutiwewiwanitsie meta hetsiena mautituarieni, yaxeikɨata pekanitimawamɨkɨ Yawé hetsiemieme, mɨ'itiyani mawariyari, xeime tsipu 'ukitɨmekɨ.   
\s1 Patsikwa 'ixɨarariyari  
\p
\v 16 »Patsikwa 'ixɨarariyari Yawé hetsiemieme xekaniuwewiximekuni mexɨakame metseriyaritsie tamamata heimana nauka tukariyaritsie 'umiekaku.  
\v 17 Tamamata heimana 'auxɨwi tukariyaritsie 'ixɨarari pekaniwewiemɨkɨ meta 'atahuta tukari paa mɨkakuxanariyarie pekanikwakamɨkɨ.  
\v 18 Mexɨakame tukaritsie 'ixɨarari patsiekamekɨ memuyukuxexeɨriwa pekaniwewiemɨkɨ, xewitɨ tixaɨtɨkɨtɨma pɨkati'uximayaka.  
\v 19 Yawé pekanitimawiriemɨkɨ taikɨ, yuhutame tsikerutsixi pekaniwatitaiyamɨkɨ, xeime muxa 'uki meta 'atahuta muxatsi xeiwiyari memɨhɨtɨka. 'Aixɨa memɨ'anene memɨkatekukuye.  
\v 20 Yuxexuime tsikerutsixi wahetsie pekaninɨitɨamɨkɨ 'ataxewime kiruyari tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ wiyamakame, meta muxa 'uki hetsie nauka kiruyari heimana 'imeriyu,  
\v 21 yuxexuime muxatsi xeiwiyari memɨhɨtɨka wahetsieta huta kiruyari.  
\v 22 Meta xeime tsipu pekaniyetuamɨkɨ mɨ'itiyani mawariyari mayanikɨ mɨxɨnarienikɨ, 'ahetsiemieme.  
\v 23 'Ikɨ pekatinitimawamɨkɨ metatsiere mawari taiyariyari yamɨtiutimawarɨwa pekahayewatɨ.  
\v 24 Meta yapekatinimawanemɨkɨ 'atahuta tukari, 'ikɨ 'ikwai kanihɨkɨtɨni witsimu'ɨa tai hetsie mɨwewiya, Yawé minake witsikemu'ɨa. 'Ikɨ mɨpaɨ pekatiniyurienemɨkɨ mawari taiyariyari yamɨtiutimawarɨwa pekahayewatɨ meta manutituarike.  
\v 25 'Atahutarieka tukariyaritsie 'ixɨarari patsiekamekɨ memuyukuxexeɨriwa pekaniwewiemɨkɨ, xewitɨtɨma tixaɨtɨkɨ pɨkati'uximayaka.   
\s1 Tsemana 'ixɨarariyari  
\r ('Inɨa 28:26-31 – Maw 23:15-22, Hut 16:9-12)  
\p
\v 26 »Tsemana 'ixɨarari muwewierirɨmetsie, Yawé pekatinitimawiriemɨkɨ 'imɨari hehekwame matɨari mɨtiukaxɨawerixɨ, meta 'ixɨarari patsiekamekɨ memuyukuxexeɨriwa pekaniwewiemɨkɨ. Mɨkɨ tukaritsie xewitɨ tixaɨtɨkɨ pɨkati'uximayaka.  
\v 27 Yuhutame tsikerutsixi pekaniwatimawamɨkɨ, xeime muxa 'uki meta 'atahuta tsipuri 'ukitsi xeiwiyari mehɨtɨkaime, mɨkɨ mawari taiyariyari witsimu'ɨa Yawé minake mayanikɨ.  
\v 28 Yuxexuime tsikerutsixi wahamatɨa 'ataxewi kiruyari heimana 'imeriyu tɨriku mɨtɨxiyari 'aixɨa mɨ'ane pekanitimawamɨkɨ hatseitikɨ pɨnariekame, muxa 'uki hamatɨata tɨriku mɨtɨxiyari 'aixɨa mɨ'ane nauka kiruyari 'imeriyu,  
\v 29 yuxexuime muxatsi wahamatɨa huta kiruyari.  
\v 30 Xeimeta tsipu pekanitimawamɨkɨ 'ekɨ pemɨxɨnarienikɨ.  
\v 31 'Ikɨ naime pekatinitimawamɨkɨ pemenutitu'a heuyutinɨkame meta mawari taiyariyari yamɨtiutimawarɨwa pekahayewatɨ meta manutituariwa. Mɨkɨ tewaxi 'aixɨa memɨ'anene memɨkatekukuye mepɨhɨkɨtɨni.   
\c 29  
\s1 Kuxineta 'ixɨarariyari  
\r ('Inɨa 29:1-6 – Maw 23:23-25)  
\p
\v 1 »Mexɨakame tukaritsie 'atahutarieka metseritsie pekaniwewimɨkɨ 'ixɨarari patsiekamekɨ memuyukuxexeɨriwa, 'ana nixewitɨ pɨkati'uximayaka. Mɨkɨ tukaritsie kuxineta kanitihɨtsieriemɨkɨ.  
\v 2 Mawari taiyarika pemɨwewienikɨ witsimu'ɨa Yawé minake, pekaniwatimawamɨkɨ xeime tsikeru, xeime muxa 'uki meta 'atahuta muxatsi xeiwiyari memɨhɨtɨka 'aixɨa memɨ'anene memɨkatekukuye.  
\v 3 Tsikeru hamatɨa pekanitimawamɨkɨ tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ pɨnariekame 'ataxewi kiruyari 'imeriyu, meta muxa 'uki hetsie nauka kiruyari heimana 'imeriyu,  
\v 4 meta 'atahuta muxatsi yuxexuime wahetsie, huta kiruyari heuyutinɨkame.  
\v 5 Yaxeikɨata xeime tsipu heutinɨkame mɨ'itiyani mawariyari mayanikɨ, kɨmana mɨxɨnarieni mɨ'ayumieme.  
\v 6 'Ikɨ pekatinitimawamɨkɨ, pekatihayewatɨ hatsite mawariyari meta kaxie winuyari mɨtiyeuriyani, taiyarika mawarikayari metseri maye'axetsie mieme, taiyarika mawariyari yamɨtiwewiya. Naime kenemɨti'aita, 'ikɨ naime taiyarika witsimu'ɨa Yawé minake pekaniyurimɨkɨ.   
\s1 Murukwitɨarika tukariyari  
\r ('Inɨa 29:7-11 – Maw 16:2-34, 23:26-32)  
\p
\v 7 »Tamamata tukaritsie 'atahutarieka metseriyaritsie 'ixɨarari patsiekamekɨ memuyukuxexeɨriwa pekaniwewiemɨkɨ. Mɨkɨ tukaritsie mekaniyuhakiekuni, meta nixewitɨ pɨkati'uximayaka.  
\v 8 Mawari taiyariyari witsimu'ɨa Yawé minake pemɨwewienikɨ xeime tsikeru pekanitimawamɨkɨ, xeime muxa 'uki meta 'atahuta muxatsi xeiwiyari memɨhɨtɨka. Mɨkɨ tewaxi 'aixɨa mepɨ'aneneni mepɨkatekukuyeni.  
\v 9 Tsikeru hamatɨa tɨriku mɨtɨxiyari 'aixɨa mɨ'ane pekanitimawamɨkɨ hatseitikɨ pɨnariekame 'ataxewime kiruyari 'imeriyu, muxa 'uki hetsieta tɨriku mɨtɨxiyari 'aixɨa mɨ'ane nauka kiruyari 'imeriyu,  
\v 10 meta 'atahuta muxatsi yuxexuime wahetsie, huta kiruyari.  
\v 11 Metatsiere tsipu 'uki mɨ'itiyanikɨ mawariyari heutinɨkame, meta mɨxɨnarienikɨ mawariyari meta mawari taiyariyari yamɨtiutiwewiwa meta hatsite mawariyari yaxeikɨata kaxie winuyari mɨtiyeuriyani.   
\s1 Xamararu 'ixɨarariyari  
\r ('Inɨa 29:12-39 – Maw 23:33-43, Hut 16:13-17)  
\p
\v 12 »Tamamata heimana 'auxɨwi tukaritsie 'atahuta metseriyari 'umiekaku 'ixɨarari patsiekamekɨ memuyukuxexeɨriwa pekaniwewimɨkɨ, 'ana xewitɨ pɨkati'uximayaka. 'Atahuta tukari 'ixɨarari patsiekamekɨ memukuxexeɨriwa pekaniwewiemɨkɨ Yawé minake.  
\v 13 Mawari taiyariyari pemɨwewieni Yawé hetsiemieme witsimu'ɨa, tamamata heimana haika tsikerutsixi pekaniwatimawamɨkɨ, meta yuhutame muxatsi 'ukitsi meta tamamata heimana nauka muxatsi xeiwiyari memɨhɨtɨka, 'aixɨa memɨ'anene memɨkatekukuye.  
\v 14 Yuxexuime tsikerutsixi wahamatɨa pekanitimawamɨkɨ tɨriku mɨtɨxiyari 'aixɨa mɨ'ane hatseitikɨ pɨnariekame 'ataxewi 'imeriyu kiruyari, muxatsi 'ukitsi wahamatɨata tɨriku mɨtɨxiyari 'aixɨa mɨ'ane nauka kiruyari 'imeriyu,  
\v 15 yuxexuime tamamata heimana nauka muxatsi memɨhɨkɨtsie, huta kiruyari xeikɨa.  
\v 16 Metatsiere xeime tsipu mɨ'itiyanikɨ mawariyari heuyutinɨkame, meta taiyarika mawariyari yamɨtiutiwewiwa hatsi meutinɨ'ɨ meta kaxie winuyari mɨtiyeuriyani.   
\p
\v 17 »Hutarieka tukariyaritsie, tamamata heimana huta tsikerutsixi pekaniwayurimɨkɨ, yuhutame muxatsi 'ukitsi meta tamamata heimana nauka muxatsi xeiwiyari memɨhɨtɨka 'aixɨa memɨ'anene memɨkatekukuye.  
\v 18 Tsikerutsixi wahamatɨa meta muxatsi 'ukitsi, muxatsi xeiwiyari memɨhɨtɨka wahamatɨa meta hatsite mawariyari meta kaxie winuyari mɨtiyeuriyani heutinɨkame, yuxexuitɨ kememɨteheiyehɨwa.  
\v 19 Meta xeime tsipu mɨ'itiyanikɨ mawariyari heutinɨkame, mawarika taiyariyari yamɨtiutiwewiwa meta hatsite mawariyari meta kaxie winuyari mɨtiyeuriyani.   
\p
\v 20 »Hairieka tukaritsie tamamata heimana xewi tsikerutsixi pekaniwayurimɨkɨ, yuhutame muxatsi 'ukitsi meta tamamata heimana nauka muxatsi xeiwiyari memɨhɨtɨka 'aixɨa memɨ'anene memɨkatekukuye.  
\v 21 Tsikerutsixi wahamatɨa meta muxatsi 'ukitsi wahamatɨa, muxatsi xeiwiyari memɨhɨtɨka wahamatɨa meta hatsite mawariyari meta kaxie winuyari mɨtiyeuriyani heutinɨkame, yuxexuitɨ kememɨteheiyehɨwa.  
\v 22 Metatsiere xeime tsipu mɨ'itiyanikɨ mawariyari heutinɨkame, mawari taiyariyari yamɨtiutiwewiwa meta hatsite mawariyari meta kaxie winuyari mɨtiyeuriyani.   
\p
\v 23 »Naurieka tukaritsie tamamata tsikerutsixi pekaniwayurimɨkɨ, yuhutame muxatsi 'ukitsi meta tamamata heimana nauka muxatsi xeiwiyari memɨhɨtɨka 'aixɨa memɨ'anene memɨkatekukuye.  
\v 24 Tsikerutsixi wahamatɨa meta muxatsi 'ukitsi wahamatɨa, muxatsi xeiwiyari memɨhɨtɨka wahamatɨa meta hatsite mawariyari meta kaxie winuyari mɨtiyeuriyani, yuxexuitɨ kememɨteheiyehɨwa.  
\v 25 Metatsiere xeime tsipu mɨ'itiyanikɨ mawariyari, mawarika taiyariyari yamɨtiutiwewiwa meta hatsite mawariyari meta kaxie winuyari mɨtiyeuriyani heutinɨkame.   
\p
\v 26 »'Auxɨwirieka tukariyaritsie 'atanauka tsikerutsixi pekaniwayurimɨkɨ, yuhutame muxatsi 'ukitsi meta tamamata heimana nauka muxatsi xeiwiyari memɨhɨtɨka 'aixɨa memɨ'anene memɨkatekukuye.  
\v 27 Tsikerutsixi wahamatɨa meta muxatsi 'ukitsi wahamatɨa, muxatsi xeiwiyari memɨhɨtɨka wahamatɨa pekanitimawamɨkɨ hatsite meta kaxie winuyari mɨtiyeuriyani, yuxexuitɨ kememɨteheiyehɨwa.  
\v 28 Metatsiere xeime tsipu pekanitimawamɨkɨ mɨ'itiyanikɨ mawariyari, mawarika taiyariyari yamɨtiutiwewiwa meta hatsite mawariyari meta kaxie winuyari mɨtiyeuriyani.   
\p
\v 29 »'Ataxewirieka tukari 'atahaika tsikerutsixi pekaniwayurimɨkɨ, yuhutame muxatsi 'ukitsi meta tamamata heimana nauka muxatsi xeiwiyari memɨhɨtɨka 'aixɨa memɨ'anene memɨkatekukuye.  
\v 30 Tsikerutsixi wahamatɨa meta muxatsi 'ukitsi wahamatɨa, muxatsi xeiwiyari memɨhɨtɨka wahamatɨa pekanitimawamɨkɨ meta hatsite mawariyari meta kaxie winuyari mɨtiyeuriwa, yuxexuitɨ kememɨteheiyehɨwa.  
\v 31 Metatsiere xeime tsipu mɨ'itiyanikɨ mawariyari heutinɨkame, mawarika taiyariyari yamɨtiutiwewiwa meta hatsite mawariyari meta kaxie winuyari mɨtiyeuriyani heutinɨkame.   
\p
\v 32 »'Atahutarieka tukaritsie 'atahuta tsikerutsixi pekaniwayurimɨkɨ, yuhutame muxatsi 'ukitsi meta tamamata heimana nauka muxatsi xeiwiyari memɨhɨtɨka 'aixɨa memɨ'anene memɨkatekukuye.  
\v 33 Tsikerutsixi wahamatɨa meta muxatsi 'ukitsi wahamatɨa, muxatsi xeiwiyari memɨhɨtɨka wahamatɨa pekanitimawamɨkɨ meta hatsite mawariyari meta kaxie winuyari mɨtiyeuriyani yuxexuitɨ kememɨteheiyehɨwa.  
\v 34 Metatsiere xeime tsipu pekanitimawamɨkɨ mɨ'itiyanikɨ mawariyari, mawarika taiyariyari yamɨtiutiwewiwa meta hatsite mawariyari meta kaxie winuyari mɨtiyeuriyani heutinɨkame.   
\p
\v 35 »'Atahairieka tukari 'ixɨarari patsiekamekɨ memuyukuxexeɨriwatsie, 'ana xewitɨ pɨkati'uximayaka.  
\v 36 Mawari taiyariyari pemɨwewienikɨ Yawé witsimu'ɨa minake, xeime tsikeru pekaniyurimɨkɨ meta xeime muxa 'uki metatsiere 'atahuta muxatsi xeiwiyari memɨhɨtɨka 'aixɨa memɨ'anene memɨkatekukuye.  
\v 37 Tsikeru hamatɨa meta muxa 'uki metatsiere muxatsi xeiwiyari memɨhɨtɨka wahamatɨa pekanitimawamɨkɨ hatsite meta manutinɨire kememɨteheiyehɨwa.  
\v 38 Metatsiere xeime tsipu pekanitimawamɨkɨ mɨ'itiyanikɨ mawariyari pekatihayewatɨ mawarika yapemɨtitiwewiwa tukarikɨ, hatsite mawarikayari meta kaxie winuyari mɨtiyeuriyani.   
\p
\v 39 »'Ikɨ mawarika kanihɨkɨtɨni Yawé hetsiemieme pemutiwewiwani kemɨ'ane tukaritsie mɨka'inɨaritɨka, hipatɨta tsepa kememɨteyɨhɨritɨa memiwewirie, kememɨteyuwaɨriya wamawarika, mawari taiyariyari, hatsite mawarikayari, kaxie winuyari mɨtiyeuriyani meta 'aixɨa memɨteyuxeiyanikɨ mawariyari».   
\p
\v 40 Hikɨ Muitsexi Yawé kemɨtita'aitɨakai naime 'ixaheritsixi yakatiniwarutahɨawe.   
\c 30  
\s1 'Ukarawetsixi kememɨteyuhɨritɨa  
\p
\v 1 Muitsexi mɨpaɨ katiniwarutahɨawe 'Ixaheri nuiwarieyatsie memanuyetei: «Yawé mɨpaɨ kanaineni kename  
\v 2 kepauka 'uki Yawé hetsiemieme muyuhɨritɨa tixaɨtɨ mɨtiyetuanikɨ, yarehɨawetɨ kename yatikayani, mɨkɨ pɨkatiku'itawani matsi keheye'atɨani kemutayɨ.   
\p
\v 3 »Kepauka 'uka 'ɨimari, yupaapa kie 'ukaitɨ 'akuxi Yawé hetsɨa muyuhɨritɨa yamɨtikayanikɨ,  
\v 4 xɨka paapaya retimaime 'atsikatitahɨawe, mɨkɨ kemɨtiyuhɨritɨakai naime katinaye'atɨamɨkɨ.  
\v 5 Peru xɨka paapaya retimaimetɨtɨ yakatiutanaki'erieni kemɨtiyuhɨritɨakai yamɨtikayanikɨ, naimekɨ kemutayɨkai tixaɨtɨ pɨkarayani, Yawé katineiyehɨwiriemɨkɨ paapaya yamɨkatiutanaki'erikɨ.   
\p
\v 6 »Xɨka 'uka 'utiwikieni yuhɨritɨame yamɨtikayanikɨ, xɨka kahayuye'erieni,  
\v 7 xɨka kɨnaya retimani peru xɨka 'atsikatitahɨawe ka'itatieni, mɨkɨ kaneye'atɨamɨkɨ kemɨtiyuhɨritɨa.  
\v 8 Peru xɨka kɨnaya retimaime yakatiutanaki'erieni, mɨkɨ kemɨtiuyuhɨritɨakai tixaɨtɨ pɨkarayani Yawé katineiyehɨwiriemɨkɨ.   
\p
\v 9 »Wiura yatɨni 'eiriyakame kemɨtiuyuhɨritɨa kaneye'atɨamɨkɨ.   
\p
\v 10 »Kepauka 'ukaratsi wikiekame tixaɨtɨkɨ mɨtiuyuhɨritɨa yamɨtikayanikɨ,  
\v 11 xɨka kɨnaya retimaime 'atsikatitahɨawe ka'itatieni, mɨkɨ kaneye'atɨamɨkɨ naime kemɨtiuyuhɨritɨa.  
\v 12 Peru xɨka kɨnaya retimaime 'ita'imaiya, hikɨ mɨkɨ pɨkayɨwe meye'atɨanikɨ xeimetɨma kemɨtiuyuhɨritɨa, kɨnaya yamɨkatiutanaki'erikɨ. Yawé katineiyehɨwiriemɨkɨ.   
\p
\v 13 »Kɨnaya heitserie kaneixeiyani yamɨtayɨnikɨ yatɨni yamɨkatitanaki'erienikɨ titakɨ mɨtiyuhɨritɨakai Yawé hetsɨa.  
\v 14 Xɨkata kɨnaya retimaimetɨtɨ kayuwatɨ 'uyeikani, 'atsimɨkahainekɨ kani'inɨaritɨni kename yara'eriwa kemɨtiuyuhɨritɨa. Kunaya yara'eriwatɨ kaniyɨanemɨkɨ 'atsimɨka'utayɨkɨ kepauka mɨretima.  
\v 15 Xɨkata retimaimetɨtɨ 'arikeketa 'uta'imani, mɨkɨ hetsiena katinahuimɨkɨ yɨ'ɨya hetsiemieme».   
\p
\v 16 'Ikɨ 'aitsika Yawé Muitsexi kaniyetuirieni, kememɨ'anenikekai yɨkɨnamatɨ yɨ'ɨitatɨ kememɨ'anenikekai meta 'uki 'uka munuarie kememɨ'anenikekai mexi hetsɨana 'ukani.   
\c 31  
\s1 Mariyani kememɨte'utami  
\p
\v 1 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 2 «Mexi pekamɨwe, 'apaapama wahetsɨa pekaheyeiwe, mariyanitsixi pekaniwatakwimɨkɨ pekatiniwakuhɨwieriemɨkɨ 'ateɨterima wahetsiemieme».   
\p
\v 3 Muitsexi 'ixaheritsixi mɨpaɨ katiniwarutahɨawe: «Xekeneuyukuha'aritɨa hipatɨ temuhukɨ mariyanitsixi temuwatakwinikɨ. Mɨkɨ wahetsie Yawé katinayukatuamɨkɨ.  
\v 4 Yuxexuitɨ 'Ixaheri nuiwarimama xeimiriyari yuteɨterima mekewarenɨ'axɨani».   
\p
\v 5 'Ixaheri nuiwarimama yuxexuitɨ mekaniwarenɨ'axɨani xeimiriyari yuteɨterima, yunaitɨ mekanakɨne tamamata heimana huta miriyari (12.000) 'ukitsi memuyukwiyukɨ.  
\v 6 Muitsexi kaniwarenɨ'ani tamamata heimana huta miriyari 'ukitsi. Wahamatɨa kaneyani Pinexi mawari wewiwame nu'aya 'Eriyatsaxi, mɨhɨritɨariekai piinite tukita timieme metatsiere kuxineta mutahɨtsiwanikɨ kepauka memuyutakwini hetsiemieme.   
\p
\v 7 Yawé Muitsexi kemɨtiuta'aitɨakai, 'ixaheritsixi mekaniuyutakwini, mekaniwarukwini yunaime 'ukitsi mariyanitsixi.  
\v 8 'Ewi, Xekeni, Tsuxi, Kuxi meta Xewa mariyani kwieyaritsie yu'aɨxɨwitɨ memɨte'aitamete 'ixiparakɨ mekaniukwi'iwa, metatsiere Warami Wehuxi nu'aya mekaniumieni.  
\v 9 'Ukarawetsixi mekaniwarutiwiya meta tɨɨri mariyanitsixi waniwema, wa'iwarika mayanikɨ wawakaitsixi mekaniwarehapani, wamuxatsi meta wapiinite.  
\v 10 Mariyanitsixi wakiekari meta memukutetɨkateitsie naime mekateniutitaiya,  
\v 11 yunaime teɨteri mekaniwarehapani meta tewaxi. Naime tita memɨte'u'axixɨ meta tita mɨtiwapiinitɨkai  
\v 12 Muitsexi meta mawari wewiwame 'Eriyatsaxi mekateniyetuirieni meta yunaime 'ixaheritsixi. Yunaime memɨwarehapa meta tita memɨte'u'axixɨ mekatenepini memakuteitsie Muhawi makuweritsie, haa manuyehane Kurutani 'aurie, metatsiere Keriku hɨxie.   
\p
\v 13 Muitsexi, mawari wewiwame 'Eriyatsaxi hamatɨa meta yunaitɨ 'ixaheri kiekariyaritsie memanuyetei mekanayekɨne mewareunakiyuka 'ateewa mematiteitsie.  
\v 14 Muitsexi waɨkawa kaniha'akaitɨni xeimiriyari wa'ukiyari wahetsɨa xeitsienituyari xeikɨa memanuaxɨakɨ.  
\v 15 Mɨpaɨ katiniwaruta'iwawiya: «¿Titayarikuta 'ukarawetsixi xekatewarekwi?  
\v 16 Mɨkɨ 'ukarawetsixi Warami kemɨtiwakuxaxatɨwakai 'axawayurietɨ, 'ayumieme 'ixaheritsixi Yawé mepuku'eirie Wahari-Pehuxi pɨta memayexeiyanikɨ. 'Ayumieme Yawé teɨterimama mekaniukwini kwiniyakɨ.  
\v 17 Yunaime tɨɨri xekeniwarukuya meta yunaime 'ukarawetsixi memɨmayɨiyatɨka,  
\v 18 kaniyɨweni hɨrixɨa 'ukari memɨkamayɨiyatɨka xemɨwarewitɨni.   
\s1 Ke'aixɨa memɨteyu'itiekai teyukwikate meta memanutaxɨriwa  
\p
\v 19 »Yunaitɨ kemɨ'ane hipame memɨwarekwi, yatɨni kemɨ'ane mɨkite memɨwaremayɨa, 'ateewa meniyuhayewakuni xematiteitsie 'atahuta tukari. Hairieka tukari 'anukamiekaku meta 'atahuta tukari 'anukamiekaku, xekaniyu'itiekuni meta kemɨ'ane xemɨwaretiwi.  
\v 20 Metatsiere yukemarite mekaniti'ekwakuni, meta nawikɨ mɨtiwewiyatɨka, tsipuri wahuxari 'ɨkariyari, yatɨni kɨyekɨ mɨtiwewiyatɨka».   
\p
\v 21 'Eriyatsaxi mawari wewiwame mɨpaɨ katiniwarutahɨawe kuyaxi kemɨ'ane memeyukukwikai: «Mɨpaɨ kanaineni 'inɨari niukiyari Yawé Muitsexi miyetuiri:  
\v 22 Huru tepɨayari, pɨrata, purunitse, tepɨa, 'Etsitaniyu, purumu,  
\v 23 naitɨ tita tai mɨtinewiwe, taipa katineuxɨriyamɨkɨ mɨti'itiyanikɨ, perutsiere haa mɨtiyu'itiwakɨ kanitihauxinariemɨkɨ. Tita tai mɨkatinewie mɨkɨ hakɨkɨ xeikɨa 'aixɨa kaniti'itɨariemɨkɨ.  
\v 24 'Atahutarieka tukaritsie, 'ana xeme yukamixate xekateniti'ekwakuni 'ana xe'itiyatɨ xekaniyuhayewakuni. 'Anake yunaitɨ mematitei xekani'axɨakuni».   
\s1 Tita memɨteha'iwaxɨ kememɨteyutapitɨani  
\p
\v 25 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 26 «'Ekɨ meta mawari wewime 'Eriyatsaxi meta 'ukirawetsixi 'ixaheritsixi xekaniwati'inɨatakuni teɨteri memutiwiyarie meta tewaxi.  
\v 27 Xekateniwatapitɨakuni kuyaxi memɨteha'iwaxɨ kemɨ'ane memeyukukwi meta yunaitɨ kiekatari yaxeikɨa tipapaɨmeme.  
\v 28 Kemɨ'ane memeyukukwi mɨpaɨ pekatiniwatahɨawimɨkɨ memɨte'a'iwaxɨ hetsie Yawé hetsiemieme memenaka'ɨnikɨ. Teɨteri yunaime tewaxi puxuri, wakaitsixi, muxatsi, xeime pekananakahanimɨkɨ 'auxɨwime tsienituyaritsie.  
\v 29 Ketipaɨmeme memɨte'uta'axixɨtsie kuyaxi mana pekaniwaranakahapaniriexɨamɨkɨ, mawari wewiwame 'Eriyatsaxi pekatiniyetuiriemɨkɨ 'imikieri mayanikɨ Yawé hetsiemieme.  
\v 30 'Ixaheritsixi ketipaɨmetɨ wahetsie mɨtikunanake, yuxexuime pekatiniwareukuhapaniriemɨkɨ huta tewiyari heimana tamamatatsie, 'ɨimarixi yaxeikɨata wapuxuri, wakaitsixi, muxatsi tsepa tita tewayari, mɨkɨ rewitsixi pekatiniwayetuiriemɨkɨ, mɨkɨ netuki memɨ'ɨwiya memɨhɨkɨkɨ».   
\p
\v 31 Muitsexi meta mawari wewiwame 'Eriyatsaxi yamekateniuyurieni Yawé Muitsexi kemɨtiuta'aitɨa.   
\p
\v 32 Kuyaxi tita memɨtehepikairi kati'inɨaritɨ, tita memɨte'a'iwaxɨ katinihɨkɨtɨkaitɨni 'ataxewime tsienituyari heimana haika tewiyari heimana tamamata heimana 'auxɨwime miriyari (675.000) muxatsi,  
\v 33 haika tewiyari heimana tamamata heimana huta miriyari (72.000) wakaitsixi,  
\v 34 haika tewiyari heimana tamamata heimana xewi miriyari (71.000) puxuri  
\v 35 metatsiere xeitewiyari heimana tamamata heimana huta miriyari (32.000) 'ukari 'ukitsi wahamatɨa memɨkakahiwawe.   
\p
\v 36 Kemɨ'ane memeyukukwi mɨpaɨ tipaɨmeme mekatenepini:  
\b  
\li1 Haika tsienituyari heimana xeitewiyari heimana tamamata heimana 'atahuta miriyari, heimana 'auxɨwi tsienituyari (337.500) muxatsi,  
\v 37 Yawé hetsiemieme mekaniyetuiyani 'ataxewime tsienituyari heimana haika tewiyari heimana tamamata heimana 'auxɨwi (675).   
\li1
\v 38 Xeitewiyari heimana tamamata heimana 'ataxewime miriyari (36.000) wakaitsixi, meta Yawé hetsiemieme mekaniyetuiyani haika tewiyari heimana tamamata heimana huta.   
\li1
\v 39 Huta tewiyari heimana tamamata miriyari heimana 'auxɨwime tsienituyari (30.500) puxuri, mekaniyetuiyani Yawé hetsiemieme haika tewiyari heimana xewi.   
\li1
\v 40 Tamamata heimana 'ataxewime miriyari (16.000) 'ukari, Yawé hetsiemiemeta mekaniyetuiyani xeitewiyari heimana tamamata heimana huta.   
\b  
\p
\v 41 Yawé hetsie mɨtimiemetɨkai, Muitsexi mawari wewiwame 'Eriyatsaxi katiniyetuirieni Yawé kemɨtiwaruta'aitɨakai.   
\p
\v 42 Kuyaxi memɨteha'iwaxɨ memɨte'atɨa, Muitsexi hixɨata ti'akame 'ixaheritsixi katiniwayetuirieni,  
\v 43 'ayumieme 'ixaheritsixi wahetsiemieme katinayani haika tsienituyari heimana xeitewiyari heimana tamamata heimana 'atahuta miriyari heimana 'auxɨwime tsienituyari (337.500) muxatsi,  
\v 44 xeitewiyari heimana tamamata heimana 'ataxewi miriyari (36.000) wakaitsixi,  
\v 45 xeitewiyari heimana tamamata miriyari heimana 'auxɨwi tsienituyari (30.500) puxuri  
\v 46 metatsiere tamamata heimana 'ataxewi miriyari (16.000) 'ukari.  
\v 47 'Ixaheritsixi wahetsiemieme mɨratɨa, Muitsexi huta tewiyari heimana tamamata teɨteriyaritsie yuxexuime kaniwareukuhapanirieni meta huta tewiyari heimana tamamatatsie yuxexuime tewaxi, yemekɨ Yawé kemɨtita'aitɨakai, hikɨ mɨkɨ tinaime mepɨteyetuiriyarie rewitsixi, Yawé tukieya memɨhɨritɨariekai.   
\s1 Kuyaxi tewa'aitɨwamete wamawarika  
\p
\v 48 Hikɨ teɨteri kuyaxi memɨhɨritɨarietɨka, tatsɨari xeimiriyari memɨhɨritɨarietɨka meta xeitsienituyari memɨhɨritɨarietɨka, Muitsexi hepa me'ukɨneka  
\v 49 mɨpaɨ mekatenitahɨawe: «'Anɨ'arima yukuyaxima mekaniwaruti'inɨata, nixewitɨ pɨkaheuyewetse keyupaɨmeme temuhɨritɨarie.  
\v 50 'Ayumieme Yawé hetsiemieme mawari tepɨwewie, ketita temɨteyetuaxɨa hurute taxexuitɨ: mamatsiemieme, tepɨa kukari huru matsɨwayari, kuka menawutɨa meta kukate. 'Ikɨ naime tepɨte'atɨwa temɨxɨnarienikɨ mawariyari Yawé hɨxie».   
\p
\v 51 Muitsexi meta mawari wewiwame 'Eriyatsaxi mekatenanupini tiwaɨkawame hurukɨ mɨtiwewiyatɨka.  
\v 52 Huru yunaitɨ memiyetɨa xeimiriyari memɨwaruwitɨkɨ meta xeitsienituyari mawari Yawé hetsiemieme mayanikɨ kanayani xeitsienituyari heimana nauka tewiyari heimana tamamata kiruyari.  
\v 53 Yuxaxaɨtatatɨ kuyaxi yu'iwarika mekani'atɨaxɨakaitɨni.  
\v 54 Muitsexi meta mawari wewiwame 'Eriyatsaxi naime mɨkɨ huru mekatenanupini kuyaxi tewa'aitɨwamete memɨtewayetuiri, hikɨ mekaneitɨni 'ixuriki tukiyarita muwa Yawé 'ixaheritsixi yamɨtiwara'eriwanikɨ.   
\c 32  
\s1 Xuweni meta Kahari Kurutani hatuxameyari 'anataɨye memuyuhayewaxɨ  
\p
\v 1 Xuweni nuiwarieya meta Kahari tewaxi mepuwarexeiyakai yemekɨ waɨkawa, mekaniuneniere Katsexi kwieyaritsie meta Karaha, mana 'aixɨa mɨraku'anekaikɨ tewaxi wahetsiemieme.  
\v 2 'Ayumieme Muitsexi mɨpaɨ mekateniutahɨawe meta mawari wewiwame 'Eriyatsaxi meta yunaime 'ukirawetsixi 'ixaheritsixi:   
\p
\v 3 —'Ataruti kwieyari meta Riwuni, Katsexi, Nimira, Hetsiwuni, 'Eraré, Tsewani, Newu metatsiere Wehuni,  
\v 4 Yawé tatsiparewiekaku mana tepɨtehayu'iwaxɨ 'ixaheritsixi wahetsiemieme mayanikɨ, 'ayumieme 'aixɨa pɨ'ane 'ikɨ 'ateɨterima watewama wahetsiemieme.  
\v 5 Xɨka yapera'eriwani ketaneupitɨa mɨkɨ takwie temayeitɨanikɨ. Tame pepɨkatatsi 'anuwitɨkɨni hapa Kurutani hatuxameyaritsie 'anutaɨye paitɨ.   
\p
\v 6 Hikɨ Muitsexi mɨpaɨ katiniwarutahɨawe Xuweni nuiwarimama meta Kahari:  
\p —¿Kamɨtsɨ 'aixɨa ti'ane xe'iwama xeikɨa memuyukwitɨweni xemeta 'ena xetetiteni xeikɨa?  
\v 7 'Ixaheritsixi mɨpaɨ meputiyuane kwie Yawé mɨwayetuiritsie mepɨye'axɨani, xɨka mɨpaɨ xe'uyɨni mɨkɨ xekayuwaɨriyatɨ xepakɨne.  
\v 8 Mɨpaɨ mekaniɨyɨnitsiere xe'ukiyarima kepauka ne nemɨwarenɨ'a kwie memɨxeiyayukɨ Karetsi-Waxineya.  
\v 9 Mekanekɨne kwie mekanexeiya mayeweri 'Etsikuri, kepauka memu'axɨa, mekaniwarutiweranariya 'ixaheritsixi, Yawé kwie hakewa mɨwareyetuiri mana memɨkaye'axɨanikɨ.  
\v 10 Mɨkɨ tukaritsie Yawé waɨkawa kaniuyeha'ani yurikɨ mɨpaɨ kaniutayɨni:  
\v 11 “Yu'iyarikɨ xemɨkanetsi'u'enikɨ, nixewitɨtɨma xeitewiyari wiyari heimana mexeiya 'Ekipitu memɨyekɨ kwie kapɨxeiya 'Apɨrahami, 'Itsahaki meta Kakuwu nemɨwaruxatɨa.  
\v 12 Mekanixeiyakuni xeikɨa Karewi Kepune nu'aya Keni tewiyari, mɨkɨri Kutsuhexi Nuni nu'aya, mɨkɨ xeikɨa yu'iyarikɨ mekaneni'eniekaitɨni, hipatɨri hawaikɨ mekapixeiya”.  
\v 13 Yawé kaniuyeha'ani waɨkawa 'ixaheritsixi wahepaɨtsita, makumawetsie mekaniu'uwakaitɨni huta tewiyari wiyari, kepaukake memukwi mɨkɨ yunaitɨ 'axamemɨte'uyuriekai.   
\p
\v 14 »Xemeta hikɨ 'axateyuruwamete, yaxeikɨa xekateniyurikuni xepaapama wahepaɨ Yawé haxɨaya tawarita xekaninɨitɨakuni 'ixaheritsixi wahetsiemieme.  
\v 15 Xɨka xeme xeka'uyuwaɨriya Yawé kemaine, mɨkɨta yaxeikɨa makumawetsie 'ikɨ teɨteri kaniwatixɨrimɨkɨ, xemetsɨ teɨteri xekaniwaka'unakuni».   
\p
\v 16 Hutarieka mɨkɨ Muitsexi mɨpaɨ mekateniutahɨawe:  
\p —Kuraru tepɨtiwewieni tatewama wahetsiemieme, meta kiekari tepɨtiwewieni taniwema wahetsiemieme.  
\v 17 Hikɨ ta'ɨrɨ teti'ɨme tepanuyeyaxe 'ixaheritsixi wahɨxie muwapaitɨ tepɨwareye'atɨani hakewa paitɨ memeyuhayewa. Taniwema peru 'aixɨa kiekaritsie meteheukutekaku wahetsie munuakakɨ mana kiekatari mewarukwinikɨ.  
\v 18 Takie kwitɨwa tepɨka'akunuaxɨani kepaukake 'ixaheritsixi yunaitɨ yukwie meme'axe.  
\v 19 Tame mɨkɨ wahamatɨa tixaɨtɨ tapiini tepɨkatehayeitɨani haa manuyehane Kurutani 'anutaɨye timieme, tame tahetsie timieme 'ena pɨta pɨtikupine haa manuyehane tau manatineika hepatsie.   
\p
\v 20 Muitsexi mɨpaɨ katiniwarutahɨawe:  
\p —Xɨka xeyuwaɨriyani mɨpaɨ xemuyɨni, yu'ɨrɨ xeketeneutipika hikɨmɨtɨka tekaniyukwiyuni.  
\v 21 Xekenanukɨni Kurutanitsie yu'ɨrɨ xete'upitɨ, Yawé xeparewiekaku xekeneuyutakuya kepaukake yunaime xemɨwara'iwa.  
\v 22 Kepauka Yawé kwie mɨtatsiyetuirienitsie, hikɨ 'ana xekanakunuaxɨakuni yukie, mɨpaɨ xeyɨme xekatenaye'atɨakuni Yawé hetsiemieme metatsiere 'ixaheritsixi wahetsiemieme. Yawé mɨxehetimakɨ 'ikɨ kwie xehetsiemieme payani.   
\p
\v 23 »Peru xɨkata xeyuti'imani, mɨpaɨ xeketenemaika 'axaxekateniyurieka Yawé hetsiemieme. Peru xepɨkateheuyehɨwiyarieni 'axaxemɨte'uyurikɨ.  
\v 24 Xekeneutiwewi kiekari xeniwema wahetsiemieme, meta kuraru xetewama wahetsiemieme, meta xekatenaye'atɨakuni kexemutiyua».   
\p
\v 25 Kahari nuiwarimama meta Xuweni nuiwarimama mɨpaɨ Muitsexi mekateniutahɨawe:  
\p —Tame 'anɨ'arima yatekateniyurikuni Yawé kemɨti'aita.  
\v 26 'Ena Karaha kiekariyaritsie mekaniyuhayewakuni taniwema, tawakaitsixi meta tamuxatsi,  
\v 27 peru tame 'anɨ'arima tekananɨkɨnikuni Kurutanitsie ta'ɨrɨ te'u'ɨtɨ tekaniwatakwikuni Yawé memaye'unie, mɨkɨ kemɨti'aita.   
\p
\v 28 Hikɨ Muitsexi mawari wewiwame 'Eriyatsaxi mɨpaɨ katiniutahɨawe, meta Kutsuhexi Nuni nu'aya metatsiere 'ixaheritsixi 'ukirawetsixi:   
\p
\v 29 —Xɨka Kahari meta Xuweni wanuiwarima Kurutanitsie yu'ɨrɨ me'u'ɨtɨ me'anukɨne memuyukwiyukɨ kwie xemɨ'axekɨ, Yawé kemaine, xeme xekaniwayetuiriekuni 'ikɨ kwie Karaha kwieyari.  
\v 30 Xɨkata meka'anukɨne, mɨkɨ kwie mekani'axikuni xehamatɨa Kanani paitɨ.   
\p
\v 31 Kahari meta Xuweni wanuiwarima mɨpaɨ mekaniutiyuani:  
\p —Tame 'anɨ'arima yatepɨtekakɨne Yawé kemaine.  
\v 32 Mɨkɨ kemaime, tekananɨkɨnikuni ta'ɨrɨ te'u'ɨtɨ Kanani kwieyaritsie. Tapiini mɨrayani peru 'uwapɨta katinikupika Kurutani 'anataɨye.   
\p
\v 33 Hikɨ Muitsexi kaniwayetuirieni Kahari meta Xuweni nuiwarimama, metatsiere Manatsexi Kutse nu'aya nuiwarimama hixɨapa memɨ'axe, ti'aitame Tsikuni kwieya 'amuxeutsixi tiwa'aitɨwame, ti'aitame 'Uhuki kwieya Watsani kiekariyaritsie ti'aitame. Niwayetuirieni kwie kemɨyeukai naime kiekari mana mukumanekai, tatsɨari kiekari naime mɨkɨ kwieyaritsie mɨmiemetɨkai.   
\p
\v 34 Kahari nuiwarimama kiekari mekaniutiwewieni Riwuni, 'Ataruti, 'Aruhexi,  
\v 35 'Ataruti-Tsupani, Katsexi, Yukiweya,  
\v 36 Weti-Nimɨra metatsiere Weti-'Arani. Kiekari 'aixɨa mɨ'anene hepaɨ mekateniwewieni metatsiere kuraru mekaniutiwewieni muxatsi wahetsiemieme.  
\v 37 Metatsiere mekanitiwewieni kiekari Hetsiwuni, 'Eraré, Kiriyatahini,  
\v 38 Newu, Wahari-Mekuni metatsiere Tsiwima, mekanipataxɨani kemɨtitetewakai.   
\p
\v 39 Makixi nuiwarimama Manatsexi nu'aya Karaha mekananɨkɨne mekane'iwa, mana memɨtitekai 'amuxeutsixi mekaniwarukwini.  
\v 40 Hikɨ 'ayumieme Muitsexi Makixi Kutse nu'aya Manatsexi nuiwarimama mɨkɨ Karaha kwieyari kaniwayetuirieni, mɨkɨ mana mekaniyuhayewa.  
\v 41 Meta Yahixi Manatsexi nu'aya hipame kiekari kaniwara'iwa, mɨkɨ Kawuti-Yahixi katiniuterɨwa.  
\v 42 Nuwa Kenati kana'iwa meta nuiwarimama 'auriena mamanetɨka, mɨkɨ kwieyari yuhepaɨ katiniuterɨwa.   
\c 33  
\s1 'Ixaheritsixi kememɨte'ɨkɨ  
\p
\v 1 Kepauka 'ixaheritsixi 'Ekipitu memayekɨ Muitsexi meta 'Aruni mewaruwitɨximekaku, mekaniuhukaitɨni yunaitɨ kuyaxi wahepaɨ.  
\v 2 Yawé Muitsexi ti'aitɨakaku katinaka'utɨwakaitɨni hakewa memeye'axekai hakewa memekɨkakai. Mɨpaɨ mekateniɨkɨne:   
\b  
\pi1
\v 3 Mexɨakame metseritsie tamamata heimana 'auxɨwi 'umiekaku, xeitukari 'anukamiekaku Patsikwa 'ixɨarariyari me'uwewieka, mekanayekɨne 'ixaheritsixi Xamɨtsexi mɨrakutewatsie. Mete'ayu'iwaka 'ekipitutari wahɨxie mekanayekɨne,  
\v 4 mɨkɨ mexixi yuniwema matɨari miemete mewateukutɨwekai, Yawé mɨwarukwikai kwiniyakɨ. Yaxeikɨata yaputayɨkai kakaɨyarixi 'ekipitutari wahepaɨtsita.   
\pi1
\v 5 'Ixaheritsixi Xamɨtsexi mekaniyekɨne, Tsukuti mekaniu'axɨani.   
\pi1
\v 6 Manata memɨyekɨ Tsukuti, 'Etami mekaniu'axɨani, makumawe kwieyari manuye'atɨka.   
\pi1
\v 7 Manata memɨyekɨ 'Etami, mekanakunuaxɨani Pi-'Akiruti, Wahari-Tsepuni tau manatineika hepatsie, Mikiruri hɨxie mekaniu'axɨani.   
\pi1
\v 8 Manata memɨyekɨ Pi-'Akiruti mekananukɨne haramaratsie makumawetsie mekaniu'axɨani. Mana me'u'uwatɨ makumawetsie haika tukari 'Etami mɨrakutewatsie Maraha mekanitiyaxe.   
\pi1
\v 9 Manata Maraha memɨyekɨ 'Erimi hepa mekanekɨne, mana kanitinenierekaitɨni tamamata heimana huta haixateyari meta haika tewiyari heimana tamamata takɨ 'amɨpapa mati'u, hikɨ mana mekanitiyaxe.   
\pi1
\v 10 'Erimi memɨyekɨ Haramara Mɨxeta 'aurie mekaniu'axɨani.   
\pi1
\v 11 Haramara Mɨxeta 'aurie memɨyekɨ Tsini makumawetsie mekaniu'axɨani.   
\pi1
\v 12 Makumawetsie Tsini memɨyekɨ Ruka mekaniu'axɨani.   
\pi1
\v 13 Ruka memɨyekɨ, 'Arutsi mekaniu'axɨani.   
\pi1
\v 14 'Arutsi memɨyekɨ, Xepirini mekaniu'axɨani, hakewa 'ixaheritsixi haa memanuharenikɨ memɨkahexeiyakai.   
\pi1
\v 15 Xepirini memɨyekɨ, Tsinahi makumawetsie mekaniu'axɨani.   
\pi1
\v 16 Makumawetsie Tsinahi memɨyekɨ, Kiwuruti-Hatawa mekaniu'axɨani.   
\pi1
\v 17 Kiwuruti-Hatawa memɨyekɨ, Katseruti mekaniu'axɨani.   
\pi1
\v 18 Katseruti memɨyekɨ, Xima mekaniu'axɨani.   
\pi1
\v 19 Xima memɨyekɨ, Ximuni-Peretsi mekaniu'axɨani.   
\pi1
\v 20 Ximuni-Peretsi memɨyekɨ, Riwina mekaniu'axɨani.   
\pi1
\v 21 Riwina memɨyekɨ, Xitsa mekaniu'axɨani.   
\pi1
\v 22 Xitsa memɨyekɨ, Tserata rakutewakaku mekaniu'axɨani.   
\pi1
\v 23 Tserata memɨyekɨ, Tsepexi hɨriyaritsie mekaniu'axɨani.   
\pi1
\v 24 Tsepexi hɨriyaritsie memɨyekɨ, Karara rakutewakaku mekaniu'axɨani.   
\pi1
\v 25 Karara memɨyekɨ, Makeruti rakutewakaku mekaniu'axɨani.   
\pi1
\v 26 Makeruti memɨyekɨ, Takati rakutewakaku mekaniu'axɨani.   
\pi1
\v 27 Takati memɨyekɨ, Teraki rakutewakaku mekaniu'axɨani.   
\pi1
\v 28 Teraki memɨyekɨ, Mitika rakutewakaku mekaniu'axɨani.   
\pi1
\v 29 Mitika memɨyekɨ, Katsimuna rakutewakaku mekaniu'axɨani.   
\pi1
\v 30 Katsimuna memɨyekɨ, Mutseruti rakutewakaku mekaniu'axɨani.   
\pi1
\v 31 Mutseruti memɨyekɨ, Wene-Yakani rakutewakaku mekaniu'axɨani.   
\pi1
\v 32 Wene-Yakani memɨyekɨ, Kikahari hɨriyaritsie mekaniu'axɨani.   
\pi1
\v 33 Kikahari hɨriyaritsie memɨyekɨ, Kutiwata rakutewakaku mekaniu'axɨani.   
\pi1
\v 34 Kutiwata memɨyekɨ, 'Awuruna rakutewakaku mekaniu'axɨani.   
\pi1
\v 35 'Awuruna memɨyekɨ, 'Etsihuni-Kewexi rakutewakaku mekaniu'axɨni.   
\pi1
\v 36 'Etsihuni-Kewexi memɨyekɨ, Karetsi mekaniu'axɨani Tsini makumawetsie.   
\pi1
\v 37 Karetsi memɨyekɨ, Huxi hɨriyaritsie mekaniu'axɨani 'Erumi kwieyari manuye'atɨka.  
\v 38 Yawé yahainekaku 'Aruni Huxi hɨriyaritsie nanutiyani, mana kaniumɨni mexɨakame tukaritsie 'auxɨwirieka metseritsie, huta tewiyari wiyari 'anuyemiekaku kepauka 'ixaheritsixi memayekɨ 'Ekipitu.  
\v 39 'Aruni kaniumɨni Huxi hɨriyaritsie xeitsienituyari heimana xeitewiyari heimana haika (123) wiyari hɨtɨ.   
\pi1
\v 40 Ti'aitame kananeu tewiyari 'Arari mɨti'aitakai, Nekexi kiekame Kanani kwieyaritsie meta 'Ara, katinetimani kename 'ixaheritsixi 'ahurawa me'uhukai.   
\pi1
\v 41 Huxi hɨriyaritsie memɨyekɨ, Tsarimuna rakutewakaku mekaniu'axɨani.   
\pi1
\v 42 Tsarimuna memɨyekɨ, Pununi rakutewakaku mekaniu'axɨani.   
\pi1
\v 43 Pununi memɨyekɨ, 'Uwuti rakutewakaku mekaniu'axɨani.   
\pi1
\v 44 'Uwuti memɨyekɨ, 'Iye-'Awarini rakutewakaku mekaniu'axɨani, Muhawi kwieyari manuye'atɨka.   
\pi1
\v 45 'Iye-'Awarini memɨyekɨ, Riwuni Kahari rakutewakaku mekaniu'axɨani.   
\pi1
\v 46 Riwuni Kahari memɨyekɨ hikɨ 'Arimuni-Riwuratahini rakutewakaku mekaniu'axɨani.   
\pi1
\v 47 'Arimuni-Riwuratahini memɨyekɨ hikɨ 'Awarini hɨriyaritsie mekanitiyaxe, Newu mɨrakutewa 'aurie.   
\pi1
\v 48 'Awarini hɨriyaritsie memɨyekɨ, Muhawi makuweritsie mekaniu'axɨani, Kurutani 'aurie, Keriku hɨxie.  
\v 49 Kurutani 'utɨma mekanikuyaxe Weti-Yetsimuti meye'atɨkaitɨ 'Aweri-Tsitini me'unieretɨ, Muhawi kwieyari makuweritsie.   
\s1 Kememɨte'utahɨawarie kwie memɨxatɨariekaitsie mieme  
\p
\v 50 Muhawi makuweritsie, Kurutani 'aurie, metatsiere Keriku 'aurie, Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 51 «'Ixaheritsixi mɨpaɨ ketiniwarutahɨawi, kepauka Kurutanitsie memanɨkɨne kepauka Kanani memɨye'axɨani,  
\v 52 yunaime mana kiekatari mekaniwarayeweiyakuni yunaime wakakaɨyarixima memɨxixiyatɨka meta tepɨakɨ memɨwewiyatɨka mekaniwaka'unakuni. Metatsiere keniwaruta'aitɨa watukite memɨti'unakɨ,  
\v 53 xɨka xetehayu'iwa mana xepɨtiyaxe mɨkɨ kwieyaritsie nemɨxeyetuiri.  
\v 54 Mɨkɨ kwie pekaniwatawiyatsitɨamɨkɨ 'inɨarikɨ, 'iwamarixi hɨkɨa meke'ukuyaxixɨani. Kemɨ'ane nuiwari kwinimieme memɨyɨpaɨmeni mɨkɨ matsi kwie 'ayeukame mekani'axikuni, metatsiere kemɨ'ane yakɨ memɨyupaɨmeni mɨkɨ 'etsiyeume mekani'axikuni. Kemɨ'ane 'inɨarikɨ memi'axe mɨkɨ tiwapiini katinayeimɨkɨ, yunaitɨ nuiwari kememɨyupaɨmeni mɨpaɨ yeyeukame mekani'axikuni.   
\p
\v 55 »Xɨkata xekawarayeweiya mana kiekatari hakewa xemetiyaxe, xɨka pɨta mana xewaruhayewa, mɨkɨ teɨteri 'uxa'awarie mekanixe'uximatɨakuni, xehɨxita mɨreuwiwieni hepaɨ yatɨni xuya xe'akita maweni hepaɨ.  
\v 56 Hikɨ ne 'anapɨta kexemɨwayurienikekai xemepɨta mɨpaɨ nekanixeyurimɨkɨ».   
\c 34  
\s1 Kanani kwieyari mata'atɨkatsie  
\p
\v 1 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 2 «'Ixaheritsixi memɨtemaikakɨ mɨpaɨ ketiniwarutahɨawi Kanani kwieyari hakewa meuye'atɨka, kwie xehetsiemieme mayani, mana kaniuye'atɨkani:   
\b  
\p
\v 3 »Tahetɨa manuye'atɨkatsie kanitsutɨkamɨkɨ Tsini makumawetsie, 'Erumi kwieya mata'atɨkatsie. Tau manatineikatsieta, Haramara Mɨmɨki mayema manuyeniere tahetɨa manuye'axe mana katinawiyakamɨkɨ.  
\v 4 Manata mɨyeyani xekwie manuye'atɨkani, tau makayuyuipike hepatsie, Terɨkaxi mematihetsie wahepa, makumawe Tsini kaniuyeyeimɨkɨ Karetsi-Waxineya paitɨ, Katsaxi-'araxi meta 'Atsimuni kaniye'atɨkaimɨkɨ.  
\v 5 Manata 'Ekipitu 'akiyaritsie kaneukayunimɨkɨ haramara Meritexaniyu mata'atɨka mɨye'anikɨ.   
\p
\v 6 »Kwie manuye'atɨkani tau makayuyuipike hepatsie mieme haramara mata'atɨka tetsita kaniuye'atɨkaimɨkɨ.   
\p
\v 7 »Kwie manuye'atɨkani tayeta manuye'atɨkatsie haramaratsie heukawetɨ hɨri 'Uxi mɨtitewatsie,  
\v 8 manata 'Uxi mɨyeyani Rewu Kamati paitɨ. Manata mɨyeyani Tserari kaniye'amɨkɨ,  
\v 9 manata mɨyeyani Tsipuruni paitɨ, Katsaxi-'Enahani mɨrakutewatsie kaniuye'amɨkɨ. Xekwie manuye'atɨka mɨkɨ kanayeimɨkɨ tayeta muyekatsie.   
\p
\v 10 »Xekwie manuye'atɨkani tau manatineika hepatsie mieme, Katsaxi-'Enahani kanitsutɨamɨkɨ, Tsepani mɨrakutewatsie kaniukayeimɨkɨ.  
\v 11 Tsepani mɨyeyani Xiwɨra kaneukayunimɨkɨ, 'Ahini tserieta mukuma, mana mɨyeyani tau manatineika kaneutayunimɨkɨ harakuna Kinereti tetsitayaritsie ye'anike,  
\v 12 manata Kurutani hatuxameyari 'utɨma kaneukayunimɨkɨ, Haramara Mɨmɨki mɨtitewatsie kaniye'amɨkɨ.  
\p »Mɨkɨ naukatɨ xekwieyari manuye'atɨka kanayeimɨkɨ».   
\p
\v 13 Muitsexi 'ixaheritsixi mɨpaɨ katiniwaruta'aitɨani: «'Ikɨ kwie kanihɨkɨtɨni xeyu'iwatɨwetɨ xemitawiya. Yawé mɨpaɨ kanaineni 'atanauka heimana 'imeriyu nuiwari xeikɨa mekanitawiyakuni,  
\v 14 Xuweni meta Kahari, metatsiere Manatsexi nuiwarimama hixɨata me'atɨ yukwie memu'axixɨkɨri.  
\v 15 'Ikɨ huta nuiwariyari heimana 'imeriyu yukwie mekanexeiyakaitɨni tau manatineika hepatsie, haa Kurutani manuyehane 'aurie, Keriku 'anutauye, tau manatineika hepa».   
\s1 Kwie kememɨteyetuiriyarie  
\p
\v 16 Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 17 «'Ikɨ teɨteri kwie memɨyetuani mekanihɨkɨtɨni wakwie mayanikɨ: mawari wewiwame 'Eriyatsaxi meta Kutsuhexi Nuni nu'aya.  
\v 18 Xemeta, xeime xekanitahɨawikuni yunuiwaritsie, mɨxeparewienikɨ kwie mɨxeyetuirienikɨ».   
\p
\v 19 Kememɨtetetewakai memanuyetekai nuiwaritsie:  
\b  
\li1 Karewi Kepune nu'aya, Kura nuiwarimama wahetsiemieme,   
\li1
\v 20 Tsamuheri 'Amihuri nu'aya, Tsimehuni nuiwarimamatsie.   
\li1
\v 21 'Erirari Kitsiruni nu'aya, Wenikamini nuiwarimamatsie,   
\li1
\v 22 Wukihi Kukiri nu'aya, Rani nuiwarimamatsie,   
\li1
\v 23 Kaniheri 'Epuri nu'aya, hixɨapa memɨ'axe Manatsexi Kutse nu'aya nuiwarimama wahetsiemieme.   
\li1
\v 24 Kemuheri Tsipitani nu'aya, manuyeka 'Epɨrahini Kutse nu'aya nuiwarimama wahetsie,   
\li1
\v 25 'Eritsapani Parinaki nu'aya, manuyeka Tsawuruni nuiwarimama wahetsie,   
\li1
\v 26 Paritiheri 'Atsani nu'aya, manuyeka 'Itsakaxi nuiwarimama wahetsiemieme,   
\li1
\v 27 'Akihuri Tserumi nu'aya, manuyeka 'Atsexi nuiwarimama wahetsiemieme,   
\li1
\v 28 Peraheri 'Amihuri nu'aya, manuyeka Nepɨtahari nuiwarimama wahetsiemieme.   
\p
\v 29 Yawé 'ikɨ kaniwaruhɨritɨani kwie 'ixaheritsixi memɨwayetuirienikɨ, Kanani kwieyaritsie.   
\c 35  
\s1 Rewitsixi wakiekaritetsie  
\p
\v 1 Muhawi makuweritsie, haa manuyeka Kurutani 'aurie, Keriku 'anutaɨye, Yawé Muitsexi mɨpaɨ katiniutahɨawe:  
\v 2 «Mɨpaɨ ketiniwaruta'aitɨa 'ixaheritsixi kepauka memɨteyetuiriyarieni, rewitsixi kiekari mekaniwayetuiriekuni mana memɨtitenikɨ, naime kwie 'auriena mahane.  
\v 3 Mɨpaɨ 'ana rewitsixi mekaneixeiyakakuni yukiekari mana memɨtiteni meta kwie mekanexeiyakakuni wamuxatsima meta yutewama wahetsie mieme.   
\p
\v 4 »Kwie xemɨwayetuirieni rewitsixi mana memɨtetihɨwenikɨ kiekari 'aurie kanahanekamɨkɨ, kiekari kuraruyaritsie 'auxɨwime tsienituyari heutatewakametsie.  
\v 5 Kiekari hakewa meye'atɨka, mana xekani'inɨatakuni xeimiriyari meturuyari tau manatineika hepatsie, hɨkɨapɨtata xeimiriyari meturuyari, tau makayuyuipike hepata xeimiriyari meturuyari metatsiere kiekari yeta meutiyunetsie xeimiriyari meturuyari. 'Ikɨ kwie kanayeimɨkɨ mana memɨtetihɨwenikɨ yukiekari 'aurie.   
\b  
\p
\v 6 »Kiekari rewitsixi memɨyetuiriyarieni, 'ataxewitɨ kiekari yu'awiwietame kanakɨnimɨkɨ. Mana xewitɨ muyuti'awieta kaniyɨwemɨkɨ tiuyumieme. 'Ikɨ kiekari mɨ'ataxewi, tawarita 'akuxi xekaniwayetuiriekuni huta tewiyari heimana huta.  
\v 7 Naitɨ kanayeikani huta tewiyari heimana 'atahaika kiekari yukwie memɨtehatihɨweni heuyutinɨkame mɨpaɨ xekateniwayetuiriekuni.  
\v 8 Kiekari kepaɨmeme 'ixaheritsixi rewitsixi memɨwayetuirieni yukwie memumikietsietɨtɨ mieme yuxexuitɨ nuiwarite, kememɨyupapaɨmeni mɨpaɨ katini'inɨatsiemɨkɨ. Tatsɨari kemɨ'ane kwinie memɨyupaɨmeni waɨkawa kiekari mekaniyetuakuni, kemɨ'aneta nuiwari yakɨmemɨyupaɨmeni yakɨpaɨmeme kiekari mekaniyetuakuni».   
\s1 Kiekari hakewa memeyuti'awiwietani  
\p
\v 9 Yawé Muitsexi mɨpaɨ katiniutahɨawe  
\v 10 'ixaheritsixi mɨpaɨ mɨtiwatahɨawekɨ: «Kepauka Kurutani hatuxameyaritsie xemanukɨne, Kanani xemɨ'axɨani,  
\v 11 kiekari meke'utiwauni yu'awiwietame, mɨyɨweni muwa memɨyu'awietanikɨ kemɨ'ane ka'imaime xeime mɨmieni.  
\v 12 Mɨkɨ tewi kaniyɨwemɨkɨ muwa muyu'awietanikɨ tikɨhɨwiyarienikɨ. Mɨpaɨ pɨkamierieni mɨtiuyumi teɨteri mekataxanetsitɨariewekaku.   
\p
\v 13 »Kiekari 'ataxewitɨ kanayeimɨkɨ xemenuyewaunikɨ kiekari yu'awiwietame mɨhɨkɨtɨnikɨ.  
\v 14 Haikatɨ kaniti'ukamɨkɨ Kurutani hatuxameyari manuyeka tau manatineika hepatsie, haikatɨta Kanani kwieyaritsie.  
\v 15 'Ikɨ kiekari 'ataxewitɨ yu'awiwietame kanayeimɨkɨ 'ixaheritsixi wahetsiemieme meta 'ateewa kiekatari, mana kiekatari yatɨni tsepa mana memɨkakiekatari. Kemɨ'ane mɨtiuyumi ka'imaime, mɨkɨ kiekaritsie muyuta'una kaniyɨwemɨkɨ.   
\p
\v 16 »Xɨka xewitɨ tepɨakɨ tiuyuwani, xɨka mɨkɨ tewi muweiya 'umɨni, mɨtiuyuwa katiniyumiekametɨni, mɨkɨta ke'umierieni.   
\p
\v 17 »Xɨka xewitɨ tetekɨ xeime 'utuaxa, xɨka mɨkɨ mutuaxie 'umɨni, mɨtiuyutuaxixɨ katiniyumiekametɨni, mɨkɨta ke'umierieni.   
\p
\v 18 »Xɨka xewitɨ kɨyekɨ tiuyuwani, xɨka mɨkɨ mukuweiyaxɨa 'umɨni, mutiuyuwa katiniyumiekametɨni, mɨkɨta ke'umierieni.  
\v 19 Mumierie 'iwaya tiyumiekame pukuwaune. Kepauka mikaxeiya kanimiemɨkɨ.   
\p
\v 20 »Xɨka xewitɨ xeime 'utamieyu 'umɨni yɨkɨ ti'anemekɨ, yatɨni tixaɨtɨ mɨreitahɨwirikɨ yɨkɨ tiku'eriwatɨ,  
\v 21 yatɨni mihutsukɨ 'eye'unietɨ, kemɨ'ane mimi katiniyumiekametɨni mɨkɨta ke'umierieni. Mumierie 'iwaya tiyumiekame pukuwaune. Kepauka mikaxeiya kanimiemɨkɨ.   
\p
\v 22 »Heiwa yakatiniuyɨweni xewitɨ 'atsikara'eriwatɨ xeime kanetaimamɨkɨ, yatɨni xeime kaniutuaximɨkɨ,  
\v 23 yatɨni ka'imaime tete xeimetsie kaniukahɨamɨkɨ, xɨkata mɨkɨ tewi 'umɨni. Mɨkɨ memɨka'ayuye'uniekai, mɨka'ima mɨtikwinitɨanikɨ,  
\v 24 hikɨ mɨkɨ teɨteri mekateniyurikuni, 'ikɨ 'aitsika kemaine mexeiyatɨ, 'aixɨa mekateniyurikuni mɨxanetsie hetsiemieme meta mixaneta hetsiemieme,  
\v 25 teɨteri hetsiena mɨrahɨiwa hetsie mekanitanuakuni, mekanitatuakuni kiekari muwayu'awieta tawarita munuanikɨ, muwa keyuhayewani, mawari wewiwamete tiwa'aitɨwame hatseiti mɨpatsie mukawiriyarie mɨyuke kaniwayeyeimɨkɨ.   
\p
\v 26 »Xɨkata mukuweiyariene wayeyani kiekari hakewa meyu'awieta kwieya maye'atɨka 'anayeyani,  
\v 27 meye'unie mimieni kaniyɨwemɨkɨ, hetsiena pɨkarahɨiyani xɨka mɨpaɨ tiuyurieni 'ateewa paitɨ 'uyeikakaku.  
\v 28 'Ayumieme mukuweiyariene mɨkɨ kiekaritsie keyuhayewani mayu'awietatsie kepaukake mɨmɨni mawari wewiwamete tiwa'aitɨwame. 'Anake kaniyɨwemɨkɨ munuanikɨ yukwietsie.   
\p
\v 29 »'Ikɨ 'aitsika ke'aye'atɨariwani yunaime 'anuiwari wahetsiemieme, tsepa hakewa xeme'uwa.   
\p
\v 30 »Yuwaɨkawatɨ xeikɨa yamehaitɨkaikaku pɨyɨweni xewitɨ mumierieni mɨtiuyumi. Xewitɨ xeikɨa yahainekaku pɨkayɨweni xewitɨ mɨmierieni.   
\p
\v 31 »Yapepɨkatinaki'erieka mɨtawikweitsitɨarienikɨ kemɨ'ane mɨmierienikɨ hetsiena mɨtiunakixɨ. Mɨkɨ ke'umierieni.   
\p
\v 32 »Metatsiere yapepɨkatinaki'erieka mɨrayukatuayani muyu'awieta yukwietsie munuanikɨ mawari wewiwamete tiwa'aitɨwame kamɨwekaku.   
\p
\v 33 »Kwie xemanu'uwatsie xepɨkatsewiximaka. Xuriya kepauka mɨtayeuriyani kwie ka'itiyatɨ kanayeimɨkɨ, kemɨ'ane xuriya mutayeuri mɨkɨ xuriyayakɨ xeikɨa kwie kani'itiyamɨkɨ.   
\p
\v 34 »Kwie ka'itiyakame pepɨka'ayeitɨaka hakewa pemeyeikatsie, neta mana nekaniuyeikani, karikɨ ne Yawé nekanihɨkɨtɨni 'ixaheritsixi watsata nemuyeika».   
\c 36  
\s1 'Ukarawetsixi kwie kememɨte'umikie  
\r ('Inɨa 36:1-12 – 'Inɨa 27:1-11)  
\p
\v 1 Karaha nuiwarimama wa'ukiyarima Muitsexi hetsɨa mekananukɨne meta hipame 'ixaheritsixi memanuyetei wahetsɨa. Karaha Makixi kaninu'ayatɨkaitɨni, Manatsexi teukarieya, mɨkɨ nuiwari Kutse hetsie mekaniyekɨne.  
\v 2 Mɨpaɨ mekateniwarutahɨawe:  
\p —Kepauka Yawé mɨmatsi'uta'aitɨa kwie 'ixaheritsixi pemɨwayetuirienikɨ, metatsiere pɨmatsi'uta'aitɨa ta'iwa Tserupekari kwieya niwemama 'ukari pemɨwayetuirienikɨ.   
\p
\v 3 Neuxei, xɨkata mɨkɨ 'ukitsi mewarutiwitɨni xeime nuiwaritsie miemete, wakwie meta tanuiwaritsie miemetɨkai mɨkɨ kemɨ'ane nuiwaritsie miemete memɨwarutiwitɨ mɨkɨ wakwie pɨtari kanayeimɨkɨ. Hikɨtari tame takwie tekaneuyehɨpani yayeume pemɨtatsiyetuiri.  
\v 4 Kepauka maye'ani mematatuiwa wiyariyari, mɨkɨ kwie kemɨ'ane nuiwaritsiemiemete memɨwaruwitɨkɨ mɨkɨ wahetsiemieme kanayeimɨkɨ, tametari takwie tekaneuyehɨpani taniwema wahetsiemieme.   
\p
\v 5 Hikɨ Yawé yahainekaku, Muitsexi 'ikɨ 'aitsika 'ixaheritsixi kaniwayetuirieni:  
\p —Kutse nuiwarimama heitseriekamekɨ mekaniutiyuaneni.  
\v 6 Tserupekari niwemama 'ukari, wahetsiemieme Yawé mɨpaɨ katina'aitani: Mɨkɨ mepɨyɨwawe tsepa kemɨ'ane memɨwarutiwitɨ, perutsɨ Kutse nuiwarieya hetsie xeikɨa.  
\v 7 'Ixaheri kwieyaritsie mɨpaɨ pɨkatiyɨaneni kwie xeinuiwaritsie mieme tawarita xeime nuiwaritsiemieme pɨka'ayeikani, yuxexuitɨtsɨ 'ixaheritsixi mekaneixeiyani yuhɨritɨarika memi'ɨwiyanikɨ yukwie watutsima memɨwayetuiri.  
\v 8 Yunaitɨ 'ukari tsepa kemɨ'ane nuiwariyari, kwie xɨka 'umikieni, 'uki ke'utiwitɨni yunuiwaritsie mieme. Mɨpaɨ xɨka xe'aneni xeyunaitɨ 'ixaheritsixi xekaneixeiyakakuni yukwie xepaapama memɨxe'umi.  
\v 9 Xewitɨ kwie xeime nuiwaritsie pɨka'uyuyuipikeni, yuxexuitɨ nuiwari 'Ixaheri hetsiemiemete meke'i'ɨwiyani yukwie memumikie.   
\p
\v 10 Hikɨ Tserupekari niwemama yamekatenikakɨne Yawé Muitsexi kemɨtiuta'atɨakai.  
\v 11 Mɨpaɨ mekatenitetewakaitɨni 'ukari: Makira, Tiritsa, Kukɨra, Mirika meta Nuha. Mɨkɨ yu'iwama yateewa mekaniwarutiwitɨni,  
\v 12 Manatsexi Kutse nu'aya nuiwarimama wahetsiemiemete, mɨpaɨ 'ana wakwie wahetsiemieme kaniuyuhayewa meta mɨkɨ nuiwari hetsiemieme.   
\p
\v 13 'Ikɨ 'aitsika meta 'inɨari niukiyari kanihɨkɨtɨni Yawé 'ixaheritsixi mɨwayetuiri, Muitsexi yatikɨhɨawekaku, Muhawi makuweritsie haa manuyehane Kurutani 'aurie, Keriku hɨxie.   