\id ECC  
\h Ti'ɨkitame 
\toc1 Ti'ɨkitame 
\toc2 Ti'ɨkitame 
\toc3 'Ɨki 
\mt1 Ti'ɨkitame  
\c 1  
\s1 Ti'ɨkitame  
\p
\v 1 'Ikɨ kanihɨkɨtɨni ti'ɨkitame niukieya, Rawiri nu'aya, Kerutsareme mɨti'aitametɨkai.   
\q1
\v 2 Mɨpaɨ kanaineni ti'ɨkitame:  
\q2 —Tita tixaɨtɨ temɨte'erie,  
\q1 tixaɨtɨ pɨkatihɨkɨ,  
\q2 naitɨ tixaɨtɨ pɨkatihɨkɨ.   
\q1
\v 3 ¿Ketita ra'iwa tewi,  
\q2 waɨkawa tiyurienetɨ 'ikɨ tukaritsie timieme?   
\q1
\v 4 Hipatɨ mepɨtakukuwe, hipatɨta mepɨtinunuiwa,  
\q2 matsi kwie yaxeikɨa kani'aneni.   
\q1
\v 5 Tau panatineika meta pakayuyuipike,  
\q2 mɨkɨ yumexɨitɨatɨ yuhuyeripa  
\q2 tawarita yu'ɨtɨma manatinenikɨ.   
\q1
\v 6 Tatsutɨa kaniu'ekani,  
\q2 tatsierieta hekututuketɨ,  
\q1 tawarita hekwamekɨ muku'ekakɨ yu'utɨma  
\q2 katihayewatɨ kaniu'ekani.   
\q1
\v 7 'Aki 'amɨpapa haa muhapane haramaratsie peukayuyuipike,  
\q2 peru hatsuaku haramara pɨkatahɨne.  
\q1 Tawarita yu'utɨma kani'atɨwani,  
\q2 mɨkɨ muhapanenikɨ 'axeikɨa.   
\q1
\v 8 Waɨkawa pɨkwaniwe nemɨtitaxatakɨ  
\q2 matsi waɨkawa kemɨtiyɨwe mɨtiutaxatakɨ.  
\q1 Naka matsi waɨkawa mɨpaɨ katineu'enamɨkɨni,  
\q2 Meta hɨxite pɨka'uxiwe mɨtanierenikɨ.   
\q1
\v 9 Meripaitɨ kemɨtiuyɨ  
\q2 mɨpaɨta katiniyɨmɨkɨ:  
\q1 ketita meripaitɨ mɨtiutiwewiya  
\q2 naitɨri katinihekɨaka,  
\q2 tawari tihekwatɨ pɨtiumawe 'ena muyuawitɨa.   
\q1
\v 10 Xewitɨ pɨyɨwe mɨpaɨ mutayɨni:  
\q2 «Neuxei 'ikɨ kanihekwanike».  
\q1 Matsi meripaitɨ katinixuawekaitɨni yuheyemekɨ,  
\q2 tame 'akuxi tekatinunuiwawawekaku.   
\q1
\v 11 Tame hikɨ hipame tepɨkawara'eriwa kememɨte'uyuri,  
\q2 ta'utɨmata memɨtinunuiwa 'atsimepɨkatehetimani ketemɨteyurie hikɨ.   
\s1 Matɨari mieme 'ɨkitɨarika  
\p
\v 12 Ne, Ti'ɨkitame, Kerutsareme nepɨti'aitametɨkai 'Ixaheritsixi watsata.  
\v 13 Nepɨnewaɨri yanemɨretimanikɨ kemɨti'anekɨ 'ena kwiepa, mɨpaɨ nepɨretima Kakaɨyari 'uximayatsika pɨtatsi'uku'eiriri waɨkawa haheteme tame yatemɨtekakɨnekɨ hetsiena.  
\v 14 Naime mɨpaɨ nepɨretima ketemɨteyurie 'ena kwiepa, pɨkatiyupata 'eka muweiyani hepaɨ kani'aneni.   
\q1
\v 15 Titunime mutaxeurariya pɨkayɨwe,  
\q2 meta pɨkayɨwe miti'inɨatakɨ kepaɨmetɨ meuyewetse.   
\p
\v 16 Merikɨte nepɨneti'iyaritɨa: «Waɨkawa nepeukawe meta nepɨtimaiwe keyuri meripaitɨ te'aitamete Kerutsaremetsie, ne naimekɨ nepɨyɨwe nemɨtitiwaunikɨ netimaiwetɨ waɨkawamekɨ meta neheitimaitɨyeikatɨ.  
\v 17 Ne yemekɨ nepɨneyetua netimaiwetɨ nemayanikɨ, nekanimaikata mɨkayɨkɨhɨawe meta mɨka'uka'iyari, matsi mɨkɨ 'eka manuku'axe hepaɨ kani'aneni.  
\v 18 Matsi puyuri,  
\q1 »kepauka waɨkawa memɨtemaiwawe matsi waɨkawa kanixuaweni 'uximatɨarika,  
\q2 kepauka waɨkawa memɨtemate waɨkawa mepɨte'ukakukuine».   
\c 2  
\p
\v 1 Merikɨte mɨpaɨ nekatiniunehɨawe: «Kamɨtsɨ nekatinita'inɨatamɨkɨ naime nemuyutemawieritɨanikɨ 'aixɨa muti'anekɨ matsi waɨkawa tukari nemɨnepitɨanikɨ». Peru tsepa mɨpaɨ nemɨtiuyuri tixaɨtɨ nepɨkatiukaxei.  
\v 2 Mɨpaɨ nepɨretima yutemawierikakɨ purukuyaneni xeikɨa, kemɨmatinake pe'uyeikatɨ mɨkɨ tixaɨtɨ pɨkatihɨkɨta.   
\p
\v 3 Mɨpaɨta nekatiniuyɨhɨawe yanemɨretimanikɨ winu nekananu'ieni, mexi mɨpaɨ neretimaiximekai, nepɨneyetua nemɨka'uka'iyarini hepaɨ, yanemɨretimanikɨ tita 'aixɨa muti'ane tewi tikaxeiya kemɨtiyurienekɨ 'ena 'uyeikatɨ 'ena kwiepa mexi'ayeniere.   
\p
\v 4 Waɨkawa mamariwaweme nekatiniutiwewieni: kii nepunetiwewiri, meta kaxie haraweriyari nepexeiyakai,  
\v 5 nehetsie timieme nekatini'uximayakaitɨni, harawerita meta 'iteɨrite, mana nekatiniuka'iteɨrita kɨyexite yu'ikwaxi mexeiyatɨka.  
\v 6 Yaxeikɨa putsu 'emeukatetewa nekaniutiwewieni waɨkawa kɨyexi mana muxuawekai nemɨhatuiyanikɨ mɨtiwawerenikɨ.  
\v 7 Te'uximayatamete waɨkawa nepɨwarexeiyakai 'ukitsi 'ukari, meta waɨkawa wakaitsixi, meta muxatsi meripaitɨ kiekatari te'aitamete Kerutsareme kememɨkateheuxeiyakai.  
\v 8 Huru, pɨrata, piinite mɨraye'axe nepɨtiukuxeɨri te'aitamete tiwapiinite meta kiekarite. Nepɨwarexeiyakaita kwikamete 'ukitsi meta 'ukari, waɨkawa nepɨnetemawiekai teɨteri wahamatɨa, nerexeiyatɨ titakɨ tewi mɨtiyutatua mɨrexeiyanikɨ.   
\p
\v 9 Nematsi nemariwetɨ nekanayani, keyuri hipatɨ meripaitɨ te'aitamete Kerutsareme miemete, metatsiere yaxeikɨa nepɨtimaiwekai.  
\v 10 Naime mɨpaɨ nepɨtiuyuri kenemɨtiyurimɨkɨkai nekɨmana, naime mɨpaɨ nepɨtiuyuri kemɨnetinakekai, nepɨnekatemawi mɨpaɨ netiuyurieka naime ne'uximayatsikakɨ. 'Ikɨkɨ xeikɨa waɨkawa ne'uximayatsika patɨa.   
\p
\v 11 Nepuyuti'iyaritɨa naimekɨ ne'uximayatsikatsie kenemɨtiuyuriekaikɨ, waɨkawa nemɨtineti'uxitɨakɨ neti'uximayatɨ, mɨpaɨ nepɨretima mɨkɨ tixaɨtɨ pɨkatihɨkɨtɨkai, xɨka 'eka pe'anukuweiya pepɨkahenuku'axe, mɨpaɨta katinimatsiɨkɨni tixaɨtɨ pɨkatihɨkɨ 'atukaritsie timieme.   
\s1 Tixaɨtɨ kwiepa timieme tepɨkatehanutɨni  
\p
\v 12 Merikɨtsɨ nepeuyuti'eriexɨa kenemɨtimaiwekaikɨ, meta mɨkayukɨhɨawekɨ meta mɨka'uka'iyarikɨ —¿ketiyɨwe tawari ne'utɨma ti'aitame manukakeni yamɨtiyurienikɨ, nehepaɨ pɨtiyurieni xeikɨa?—,  
\v 13 mɨpaɨ nepɨretima matsi waɨkawa peuyewetse mɨtimaiwenikɨ keyuri mɨka'uka'iyarini, hekɨariya 'aixɨa mɨ'ane hepaɨ keyuri yɨriya.   
\q1
\v 14 Kemɨ'ane mɨtimaiwe tanenieretɨ kaniumieni,  
\q2 peru kemɨ'ane 'atsimɨkatimate yɨwipa kaniuyeikani.  
\p Peru tawari mɨpaɨ nepɨretima teyunaitɨ yaxeikɨa katatinitakwewieka temɨkwinikɨ.   
\p
\v 15 Merikɨte mɨpaɨ nepɨtiunehɨawixɨ: «Kamɨtsɨ mɨka'uka'iyari hepaɨ nepɨtimɨni, ¿merikɨte titakɨ tiyunaki'erie kenemɨtimaiwe?» Mɨpaɨ nepɨtiunehɨawixɨ mɨkɨ tixaɨtɨ pɨkatihɨkɨtɨkai,  
\v 16 Mɨtimaiwe meta mɨkatimaiwe tɨma pɨkahaye'eriwa, 'ureumietɨ yaxeikɨa mepɨtehatɨmaiyarieni, metatsiere yaxeikɨa mepɨtekwini memɨtemaiwawe meta memɨkatemaiwawe.   
\p
\v 17 Merikɨ netukari neputi'uxiwe'eri, tsepa naimekɨ mɨpaɨ nemɨtiyurienekai 'axapɨ'anekai nekɨmana. Yurikɨ naitɨ tixaɨtɨ pɨkaratɨa, matsi 'eka 'utɨma pemunautsarɨmeni hepaɨ kani'aneni.   
\p
\v 18 Yaxeikɨata nepiti'uxiwe'eri kenemɨtiuyuri waɨkawa neti'uximayatɨ 'ena ne'uyeikatɨ, nemiku'eiririenikɨ xeikɨa ne'utɨma manukakeni ti'aitatɨ,  
\v 19 'Atsipɨkatimatsiɨkɨ xɨka mɨkɨ timaiwemɨkɨ yatɨ pɨkatimaiweni. Matsi katiniyukapinitɨamɨkɨ waɨkawa neyu'iyaritɨatɨ meta netimaiwetɨ kenemɨtiuyuri 'ena ne'uyeikatɨ. Mɨkɨ meta tixaɨtɨ pɨkaratɨa.   
\p
\v 20 Waɨkawa neyu'iyaritɨatɨ matsi 'ipaɨ nepɨtinehɨawixɨ, netixeiyatɨ waɨkawa kenemɨtiuyuriekaikɨ 'ena kwiepa,  
\v 21 matsi hipatɨ kememɨtemaiwawekɨ, kememɨte'uyematekɨ mekateni'uximayatakuni, mɨkɨ xeime memɨyetuirienikɨ mɨkatiuta'uximayataxɨ hatsuaku hetsiemieme naimekɨ kememɨte'uyuri. Peru mɨkɨta tixaɨtɨ pɨkatihɨkɨ meta 'axapɨ'ane,  
\v 22 Kamɨtsɨ, ¿tita ra'iwanikeyu tewi xɨka yutɨrɨkariyakɨ yɨaneni kemɨtiku'eriwa, waɨkawa yu'iyaritɨatɨ tixaɨtɨ pɨkara'iwa 'ena muyuawitɨa?  
\v 23 Naime tukaritsie 'axakani'itɨarieka tiuka'eniwatɨ meta tsikere tɨkarikɨ pɨka'uka'uxipiwe tiku'eriwatɨ. Mɨkɨta yaxeikɨa tixaɨ pɨkatihɨkɨ.   
\p
\v 24 Matsi tewitsie pɨtiumawe 'aixɨa ti'anetɨ 'ikwaikɨ xeikɨa 'iiyakɨ pɨ'ayumie yutemawietɨ yu'uximayatsikatsie. Mɨpaɨ nepɨretima mɨkɨta Kakaɨyari hetsɨa kanayeneikani,  
\v 25 kamɨtsɨ ¿kemɨ'ane pɨyɨwe mɨtikwanikɨ meta muyutemawiekakɨ xɨka Kakaɨyari hetsɨa katimiemetɨni?  
\v 26 Kakaɨyari matsi mɨtimaiwenikɨ meta meitimaitɨyeikanikɨ meta muyutemawiekakɨ kaniyetuirieka kemɨ'ane mɨkɨ minake miyetuirienikɨ, matsi 'axamɨtiyuriene kanihayewani para mɨkɨ mɨtixeɨrienikɨ miyetuirienikɨta kemɨ'anetsiere mɨnaki'erie. Peru mɨkɨta 'axakani'aneni 'eka muweiyani hepaɨ.   
\c 3  
\s1 Tukari puxuawe kemɨtiuyurieni hepaɨtsita  
\p
\v 1 Xexuime tukaritetsie pɨtika'inɨaritɨka, tukari puxuawe naimetsie timieme kemɨtiuyurieni muyuawi hetɨa:   
\q1
\v 2 Kepauka temɨtinunuiwa,  
\q2 kepaukata temɨkwini,  
\q1 kepauka mɨtiuka'iteɨrita,  
\q2 kepaukata temɨteka'uta,   
\q1
\v 3 kepauka mɨtiuyumieni,  
\q2 kepaukata muwaranayexɨrɨwani,  
\q1 kepauka mɨtiuka'unakɨ,  
\q2 kepaukata menukuketɨanikɨ,   
\q1
\v 4 kepauka mutatsuakanikɨ,  
\q2 kepaukata mutanawenikɨ,  
\q1 kepauka muyuhiwerieka,  
\q2 kepaukata temawierika mexeiyani,   
\q1
\v 5 kepauka tetexi mutaxɨrieni,  
\q2 kepaukata mititɨkɨ,  
\q1 kepauka muyutapatɨkani,  
\q2 kepaukata muyutateutɨaxɨani,   
\q1
\v 6 kepauka mɨtikuwauneni,  
\q2 kepaukata mɨkatikuwauneni,  
\q1 kepauka mutiuti'uta,  
\q2 kepaukata mɨrexɨrieni,   
\q1
\v 7 kepauka mutiutatsana,  
\q2 kepaukata mɨtiutawipa,  
\q1 kepauka mɨka'utaniukani,  
\q2 kepaukata mɨtikuxatani,   
\q1
\v 8 kepauka muyunaki'erietɨkani,  
\q2 kepaukata mɨtiyuka'uxiwe'erieka,  
\q1 kepauka mukuyaxatɨni,  
\q2 kepaukata kayuwatɨ memexeiyani.   
\s1 Tixaɨtɨ pɨkarayani tsepa waɨkawa temɨte'uximaya  
\p
\v 9 Tixaɨtɨ pɨkara'iwa kemɨ'ane waɨkawa tiyu'uxitɨatɨ mɨti'uximaya.  
\v 10 Mɨpaɨ nepɨtiniere Kakaɨyari mɨpaɨ pɨtiwarupitɨa hahetemekɨ, tewi mɨpaɨ muti'uximayakakɨ.  
\v 11 Kakaɨyari witsiti'aneme katiniunetɨani, mɨpaɨ tewi katiniupitɨani mɨpaɨ mɨtiku'eriwanikɨ 'uxa'atɨniwarie, tsepa tewi mɨkaheitimaitɨyeika Kakaɨyari 'uximayatsikaya mɨkɨ kemɨtiyuriene matɨari paitɨ meta 'imatɨrieka.   
\p
\v 12 Ne nepɨtimate tewitsie puxuawe xeikɨa, temawierika meta 'aixɨa mɨtiyurienekɨ mexi'ayeyuri.  
\v 13 Mɨpaɨta nepɨtimate kename Kakaɨyari 'imikierieya hɨkɨ, tewi mɨtikwakakɨ mɨti'iekakɨ, meta naime yu'uximayatsikatsie timieme mɨra'inɨnɨatani.  
\v 14 Yaxeikɨata mɨpaɨ nepɨtimate naime Kakaɨyari mɨtiunetɨa yuheyemekɨ katiniwiyani, pɨkayɨwe temitanɨitɨanikɨ meta temenakaxɨrienikɨ, Kakaɨyari mɨpaɨ katiniuyurieni temimakaxenikɨ.   
\q1
\v 15 Hikɨ tita mɨtixuawe, katinixuawekaitɨniri,  
\q2 ketitamɨtinenikekai, 'ariri katinixuaweni.  
\q2 Kakaɨyari mɨpaɨ katiniyurieneni 'ɨxatsieya yamɨreuyuhanenikɨ.   
\s1 'Axaketemɨteyurie tatukaritsie  
\p
\v 16 Matsi tawari tixaɨtɨ nekatinixeiyanita 'ikɨ tukaritsie: 'axakatiniyɨaneni hakewa meta'iwawiyarienitsie, hakewa mɨheitserie mekuxaxatsiwatsie 'axamɨti'ane kanixuaweni.  
\v 17 Merikɨ mɨpaɨta nepɨtiu'eri: «Kakaɨyari heitserie mexeiya meta 'axamɨtiuka'iyari kaniwaranutaxɨriemɨkɨ, muxuawekɨ tukarite yamɨtiuyurienikɨ naimekɨ meta hakewa yamɨreyurienikɨ».   
\p
\v 18 Meta mɨpaɨ nepɨtiu'eri teɨteri kememɨteyumate wahepaɨtsita: «Kakaɨyari kaniwa'inɨataneni, mɨkɨ mɨpaɨ memɨteheyutimanikɨ kename yeuta memɨte'u'uwa wahepaɨ me'anene.  
\v 19 Teɨteri yeutari wahepaɨ mekatenitakukuweni, yaxeikɨa mekatenita'ikwewani metakukuwetɨ yuxexuitɨ, yaxeikɨa meta kani'aneneni yunaitɨ kememɨte'ayeyuyuri, 'ayumieme tewi pɨkawe'eme tewaxi wahetsiemieme. Yurikɨ naitɨ tixaɨtɨ pɨkarayani,  
\v 20 'Axeikɨa naitɨ katiniyemieni.  
\q1 »Naitɨ tumuanaritsie mɨtiyetɨa,  
\q2 tumuanaritsie katininuamɨkɨ.   
\p
\v 21 »¿Kemɨ'ane pɨtimate xɨka tewi 'iyarieya 'anutiyeikani 'ameutitewatsie, meta yeutari wa'iyari xɨka 'anukayeikani, 'emeukatewatsie kwiepa?»  
\v 22 Mɨpaɨ nepɨretima, tewi hetsie puxuawe xeikɨa, yu'uximayatsikatsie mɨtiwiyanikɨ mɨkɨ hetsiena pɨtiunakixɨ. Kamɨtsɨ, xewitɨ pumawe xeime mɨpaɨ mɨtitahɨawekɨ kemɨtiyɨnikɨ.   
\c 4  
\s1 Memɨyuhiwerie memɨyutemamawie  
\p
\v 1 Merikɨte neniune'ɨwiyata 'ikɨ tukaritsie waɨkawa kememɨte'uka'eniwakai. Nekaniwaruxeiya 'axamemute'anuyehu me'utitsuaname, xewitɨ pumawekai mɨwanɨtɨanikɨ, tɨrɨkariya memexeiya mekaniwa'uximatɨakaitɨni, pumawekai kemɨ'ane muwanɨtɨani.  
\v 2 Mɨpaɨ nepɨtiunehɨawixɨ. Matsi waɨkawa mepuyutemamawie kemɨ'ane memukwiri, keyuri memayeneniere,  
\v 3 matsi mekaniyutemamawieka kemɨ'ane memɨkatinunuiwawe 'akuxi, 'atsimemɨkatematekɨ ketita 'axamɨti'ane 'ena kwiepa.   
\p
\v 4 Meta nekaniuniere 'aixɨa 'aneme yu'uximayatsikakɨ yutukaritsie mekaniwaranutanieritɨwani 'axamemɨtewakɨhɨawe. Mɨkɨta yaxeikɨa tixaɨtɨ pɨkarayani, 'eka pemuweiyani hepaɨ kani'aneni.   
\q1
\v 5 'Atsimɨkatimate yutapa kanawieka,  
\q2 ya'anetɨ haakakɨ kwikaniyɨaneni.   
\q1
\v 6 Matsi 'aixɨa pɨ'ane kayuwatɨ mɨti'uximayaka 'etsiwa mɨrexeiyanikɨ,  
\q2 keyuri waɨkawa tikumaɨwatɨ waɨkawa mɨrexeiyanikɨ  
\q2 xɨka waɨkawa tikumaɨwani tixaɨtɨ pɨkarayeika,  
\q2 'eka muweiyani hepaɨ xeikɨa pɨ'ane.   
\s1 Teyuxewitɨ matsi tekanitɨrɨkaɨyeni  
\p
\v 7 Xaɨtsie tawari tixaɨtɨ mɨkatihɨkɨtsie nekanine'ɨwiya 'ena kwiepa:  
\v 8 tewi xeime nekaniuxeiya yuxaɨtame 'uyeikame, tɨɨri kawarexeiyame meta yu'iwama, peru pɨkatihayewakai waɨkawamekɨ yu'iyaritɨatɨ yu'uximayatsikakɨ, hatsuaku mɨpaɨ pɨkatiuyuhɨawixɨ waɨkawa kemɨrexeiyakaikɨ «¿Kamɨtsɨ kemɨ'ane rahetsiemieme ne waɨkawa nepɨti'uximaya, 'aixɨa nemɨtiyurienenikɨ nekayuwaɨriyatɨ?» mɨpaɨ katiniuyuhɨawe. Mɨkɨta tixaɨtɨ pɨkatihɨkɨ kenemɨtiune'uxitɨa waɨkawa.   
\q1
\v 9 'Aixɨa matsi kani'aneni yuhutatɨ keyuri yuxewitɨ,  
\q2 mɨkɨ matsi waɨkawa mekanitatseirikuni kememɨteyu'uxitɨa.   
\q1
\v 10 Xɨka xewitɨ 'atiweni, xewitɨ kanenukuhanimɨkɨ.  
\q2 Matsi xɨa'ui kemɨ'ane matiweni,  
\q2 mɨkaheixeiya kemɨ'ane menukuhana.   
\q1
\v 11 Yuhutatɨ xɨka me'uheni,  
\q2 mekaniyuxɨriyani,  
\q2 matsi yuxaɨta ¿kehepaɨ tiyutaxɨriya?   
\q1
\v 12 Yuxaɨtame kana'iwariemɨkɨ,  
\q2 matsi yuhutatɨ mekaniyuparewieka.  
\q1 Kaunari xɨka haikani  
\q2 yapauka pɨka'anutekieni.   
\s1 Pemɨtemaikɨ ketinemaiweni  
\q1
\v 13 'Aixɨa matsi kani'aneni temaikɨ tixaɨtɨ karexeiyatɨ peru xɨka timaiweni,  
\q2 keyuri ti'aitame meripai mieme 'atsimɨkatimate,  
\q2 kayɨ'ɨxatsitɨarinɨatɨ.   
\p
\v 14 Tsepanetɨ 'anutahɨiyame wayeyame 'uwenitsie maya, yatɨni tixaɨtɨ karexeiyatɨ 'utinuiwame ti'aitame mayanikɨ,  
\v 15 ne mɨpaɨ nepɨtimate matsi 'ikɨ temaikɨ waɨkawa teɨteri mekaniparewieka, manukakenikɨ ti'aitametɨtɨ.  
\v 16 Peru tsepanetɨ teɨteri memɨkayu'inɨatsinɨa te'aitamete memɨwaruweiya, yumɨiretɨta 'arike memɨ'axe, mekayutemamawietɨ mekaniyuhayewani hetsienamieme. Mɨkɨta yaxeikɨa tixaɨtɨ pɨkatihɨkɨ, 'eka manuku'axe hepaɨ pɨ'ane.   
\c 5  
\s1 Ketinaye'atɨwani kepemɨtayɨni  
\p
\v 1 Kepauka Kakaɨyari kiita pemeutahani, pe'a'ɨwiyatɨ kepemɨtiuyeikakɨ kene'enieka keyuri pe'iyetuirienike mawari 'atsimemɨkatemate wahepaɨ, mɨkɨ 'axameteyuriekame mepɨkayu'erie.   
\q1
\v 2 Pepɨka'amexɨitɨaka,  
\q2 'atenikɨ meta kepemɨtiku'eriwakɨ,  
\q2 pe'ahɨritɨatɨ Kakaɨyari hɨxie xeiniukiyarikɨ,  
\q1 mɨkɨ muyuawitsie kanakakani 'ekɨta kwiepa pekaniuyeikani.  
\q2 'Ayumieme 'aniuki kenexewiriyani.   
\q1
\v 3 Kemɨ'ane waɨkawa muyu'iyaritɨa katiniuka'eniwani 'axati'aneme tiheinɨtɨ,  
\q2 kemɨ'aneta waɨkawa mutaniuka yakɨ xeikɨa katinikuxatani.   
\p
\v 4 Kepauka Kakaɨyari hetsɨa tixaɨtɨkɨ pemɨti'ahɨritɨa, 'apepɨkareutewini yapemɨtikayanikɨ, Kakaɨyari matsi pɨkayutemawie yamemɨkatekahu wahetsiemieme. Kenaye'atɨa kepemutayɨkɨ:   
\q1
\v 5 Matsi 'aixɨa kani'aneni xɨka tixaɨtɨkɨ katiyuhɨritɨaka,  
\q2 mɨpaɨ tiuyurieme kapa kaheye'atɨanikɨ.   
\p
\v 6 'Ateni pepɨkapitɨaka kapa 'axapetiuyurienikɨ, yapepɨkahaineni Kakaɨyari tupirieya hɨxie, kename yapekara'eriwamekɨ petiuyuri. ¿Titayari matsi Kakaɨyari petihaxɨatɨa mɨyape'utaitɨ naime mɨtika'unakɨ 'a'uximayatsika?  
\v 7 Matsi waɨkawa xɨkaxuaweni tixaɨtɨ mɨkatihɨkɨ, heinɨtsi 'axa'anenetɨ tiyu'uximatɨwatɨ, yakɨxeikɨa waɨkawa mayeniuwenikɨ, 'ekɨ matsi Kakaɨyari kenayemakaxeni.   
\s1 Tsepa pemɨxiku tixaɨtɨ pɨkatihɨkɨ  
\p
\v 8 Xɨka xeime kwieyaritsie pewaruxeiya mewananaimakame tixaɨtɨ memɨkatehexeiya, meta teɨteri mekawapitɨatɨ heitserie memexeiyanikɨ, mɨkɨkɨ pepɨkahɨxiyaka, kemɨ'ane waɨkawa muwe'eme xewitɨ matsi waɨkawa we'emetɨtɨ kanixeiyani, meta waheima matsi xewitɨ mariwetɨ kaniwaxeiyani.  
\v 9 Kamɨtsɨ 'ikɨ naimekɨ tixaɨtɨ pɨkatixuawe 'aixɨa mɨti'ane 'ikɨ kwieyaritsie, mɨraka'etsitɨretsieri mɨti'ɨwiyani peuyewetse ti'aitame.   
\p
\v 10 Tumini kemɨ'ane mɨnakie'erie, pɨkatahɨniwe tuminikɨ. Kemɨ'ane waɨkawa mɨrexeiyanikɨ mɨyɨane matsi waɨkawa pɨreuyehɨwa. Mɨkɨta yaxeikɨa tixaɨtɨ pɨkatihɨkɨ.  
\v 11 Hakewa waɨkawa mɨrexuawe, kananuyuhayewanita mitixɨtɨanikɨ, ¿ketita 'aixɨa mɨti'ane kamɨtsɨ tiutixuaweriyaxɨ kutsiyarieya 'ixeiyaka xeikɨa?  
\v 12 Ti'uximayatame 'aixɨa 'anemekɨ kaniukakukutsuni, heiwa waɨkawa tiutikwa'atɨ heiwa 'etsiwa xeikɨa. Mɨxikuta waɨkawa mɨrexeiyakɨ piiniteya pɨka'ipitɨa 'aixɨa 'iyari mɨkutsunikɨ.   
\p
\v 13 Hikɨ tukaritsie nepɨtixeiya waɨkawa 'axamɨti'ane: waɨkawa tumini muti'utakɨ xeikɨa kemɨ'ane miti'utaxɨ mu'uximatɨarienikɨ,  
\v 14 meta mɨkɨ piinitɨarika pɨreuyewautse hau'erietɨ xɨka petita'uximayatsitɨani. Mɨkɨ kutsiyarieya xɨka heiwa yuniwe hexeiyatɨ 'ayani tixaɨtɨri pɨkarexeiyani miku'eiririenikɨ.  
\v 15 Ke'anetɨ mutinuiwaxɨ yumaamatsie, mɨpaɨta 'anetɨ kaniyemieni: mawetɨ kemɨtinua 'ena kwiepa, tixaɨtɨ pɨkaranutɨni waɨkawa yu'uximayatsikatsie timieme.   
\p
\v 16 Mɨkɨ matsi mari'itɨarika kanihɨkɨtɨni: ke'anetɨ mɨnua tewi mɨpaɨ 'anetɨta kaniyemieni. ¿Ketitayari kamɨtsɨ waɨkawa rexeiyani tixaɨtɨ karayanikeyu?  
\v 17 'Imatɨrieka kepaɨmexɨa muyeikani yɨwipa katinikwakamɨkɨ, meta waɨkawa 'uximatɨarietɨ katinikuyekamɨkɨ 'ayu'eriyatɨ.   
\p
\v 18 'Ikɨ kanihɨkɨtɨni kenemɨretima: 'ikɨ tukaritsie 'aixɨa kani'aneni matsi mɨtiutikwa'ani mɨranuye'eni, ketipaɨmeme pemɨrexeiyakɨ pe'atemawietɨ matsi ketinekwaka. Mɨkɨ kanihɨkɨtɨni Kakaɨyari mɨtatsiyetuiri, mɨkɨ tahetsie mɨtiunakixɨ pɨhɨkɨ.  
\v 19 Matsi Kakaɨyari kemɨ'ane mɨtiyetuirie waɨkawa mɨrexeiyanikɨ, kaniyetuiriekata yu'uximayatsikatsie timieme mɨtikwakakɨta, mɨkɨ kanihɨkɨtɨni Kakaɨyari kemɨtatimikwa teyuxexuime.  
\v 20 Kakaɨyari wa'iyaritsie kemɨtiwahɨniya temawierikakɨ, tewi yutukari 'etsiwa xeikɨa kaniku'eriwani.   
\c 6  
\s1 Ketitari rexeiya tatukari  
\p
\v 1 Xeimeta nekanixeiyani 'axati'aneme 'ikɨ tukaritsie teɨteri watsata:  
\v 2 Kakaɨyari hipame kaniwapitɨaka waɨkawa memɨtehexeiyanikɨ meta 'aixɨa memɨtexeiyariekakɨ, meta tixaɨtɨ mepɨkateheuyehɨwa tita memɨteheiwe'erie, matsi hipameta pɨta pɨwapitɨa memɨtetikwanikɨ mɨkɨ naime. 'Ikɨta tixaɨtɨ pɨkatihɨkɨ 'axamɨti'ane.   
\p
\v 3 Tewi xɨka warexeiyani xeitsienituyari yuniwema, meta mɨixa wiyari 'uyeikatɨ, tsepa kepaɨmexɨa muyeikani xɨka kayukatemawiwani 'aixɨa mɨti'anekɨ, meta xewitɨ ka'ikateuku, matsi 'aixɨa kani'aneni nunutsi mɨtinuiwa mukitɨ keyuri mɨkɨ.  
\v 4 Kamɨtsɨ mɨkɨ nunutsi tixaɨtɨ pɨkaratɨa, yɨriyatsata petɨa, yɨwipa puyuhayewa kemɨtitewakai.  
\v 5 Hatsuaku tau pɨkaxeiya meta tixaɨtɨ pɨkaretimani, matsi mɨkɨ kayuwatɨ hexeiyatɨ kanayeimɨkɨ keyuri mɨkɨ tewi,  
\v 6 tsepa huta miriyari wiyari 'amuyeikani, 'aixɨa mɨti'ane yakatiyurienetɨ. Matsi teyunaitɨ 'axeikɨa tekanekɨkani.  
\v 7 Tewi waɨkawa katini'uximayaka mɨtikwakakɨ, matsi hatsuaku pɨkatahuxani kɨmana.  
\v 8 ¿Mɨtimaiwe waɨkawa matsi kerexeiya keyuri mɨkatimaiwe? ¿Ketitari ra'iwakeyu tixaɨtɨ mɨkarexeiya, yutukari hetsiemieme mɨyɨwenikɨ?  
\v 9 Matsi tita mɨtiyuhekɨa 'aixɨa kani'aneni keyuri tikuwaunetɨ. Mɨkɨta tixaɨtɨ pɨkatihɨkɨ, 'eka muweiyani hepaɨ kani'aneni.   
\q1
\v 10 Ketita hikɨ mɨtixuawe 'ari kaneixeiyakaitɨniri kemɨtitewa,  
\q2 yakatinimatsiɨkɨni tita mɨtihɨkɨ: tewitɨtɨ.  
\q1 Xewitɨ muyutamieni pɨkayɨwe  
\q2 xeime waɨkawa mɨtɨrɨkaɨye hamatɨa.   
\q1
\v 11 Niuki waɨkawa mekananutiyayatsani,  
\q2 matsi tixaɨtɨ pɨkatihɨkɨ.  
\p ¿Peru tita tete'a'iwa kɨmana?  
\v 12 'Atsitepɨkatemate, ketita matsi 'aixɨa mɨti'ane tahetsiemieme. Tixaɨtɨ pɨkatihɨkɨ yapaɨmexɨa xeikɨa mayeyurini 'etɨri hepaɨ xeikɨa yapauka makumawere. ¿Kemɨ'ane pɨyɨwe yamɨtitahɨawekɨ tukarieya hepaɨtsita, kemɨtiyɨni 'arike mɨyuke?   
\c 7  
\s1 Hekwamekɨ kepemɨtiuyeikani  
\q1
\v 1 Matsi tewi 'aixɨa peketixeiyarieka,  
\q2 keyuri witsipe'u'ɨatɨ.  
\q1 Matsi katiniyunaki'erieka kepauka temɨkwinitsie,  
\q2 keyuri temɨtinunuiwatsie.   
\q1
\v 2 'Aixɨa matsi kani'aneni mɨki makateukienitsie pemumie,  
\q2 keyuri 'ixɨararipa.  
\m Temɨkwinikɨ teyunaime teɨteri tahetsie kanimiemetɨni, memayeneniereta matsi mɨpaɨ meketemaika.   
\q1
\v 3 Mɨyuhiwerieka kaneuyeweka keyuri mutanaweni,  
\q2 kananakanutuixieka yuhɨxie,  
\q2 matsi 'aixɨa kaniyurieka 'iyarieya.   
\q1
\v 4 Mɨtimaiwe kaniku'eriwani kepauka mɨmɨni,  
\q2 matsi 'atsimɨkatimate kaniyu'iyaritɨaka xeikɨa kemɨtiyurienekɨ.   
\q1
\v 5 Matsi 'aixɨa kani'aneni mɨtimaiwe mɨratate'anikɨ,  
\q2 keyuri 'atsimɨkatimate niukieya tsi'aneneme 'enietɨ.   
\m
\v 6 Tixaɨtɨ pɨkatihɨkɨ 'atsimɨkatimate kemɨtikuxata, mɨpaɨ xeikɨa katinimatsiɨkɨni, xuya xarita matikateni hepaɨ. Mɨkɨta tixaɨtɨ pɨkatihɨkɨ.   
\q1
\v 7 Mɨtimaiwe nanaimarikakɨ katimaiwetɨ kanayeimɨkɨ,  
\q2 tuminikɨ yu'iyari kanikwiemaka.   
\q1
\v 8 Matsi 'aixɨa kani'aneni tixaɨtɨ mɨreutiparekɨ,  
\q2 keyuri titsutɨarietɨ.  
\q1 Matsi 'aixɨa kani'aneni mɨtiuka'eniwanikɨ waɨkawa  
\q2 keyuri yu'ariwietɨ.   
\q1
\v 9 Haxɨakɨ xeikɨa pepɨka'ayeweni,  
\q2 matsi mɨkɨ 'atsimɨkatimate kani'iyarieyatɨni.   
\p
\v 10 Mɨpaɨ pepɨkahaineni kename meripaitɨ 'aixɨa metiyuriekai. Mɨkɨ kememutiyuane memɨtemaiwawe wahetsɨa pɨkamieme.   
\p
\v 11 'Aixɨa kani'aneni pemɨtimaiwenikɨ tita 'aixɨa mɨti'ane hepaɨtsita, hikɨ memu'uwa wahetsie 'aixɨa mɨti'anenikɨ.  
\v 12 Pekaniyɨweni mɨtimaiwenikɨ 'etɨriyayatsie pemuyeikanikɨ metatsiere tumini 'etɨriyayaritsie, matsi mɨtimaiwenikɨ mɨ'ayumieme tukari kaniwapitɨamɨkɨ kemɨ'ane memeixeiyani.   
\p
\v 13 Kakaɨyari 'uximayatsikaya keneuxeiya: ¿kemɨ'ane pɨyɨwe mitixeurariyakɨ tita mɨkɨ mutiutitunaxɨ?  
\v 14 Kepauka 'aixɨa ti'aneme pemɨrexeiyani, kene'atemawieka, matsi kepauka 'axati'aneme pemɨrexeiya, keneutimaixɨa 'uximayatsika naitɨ Kakaɨyari hetsɨa kanayeneikani, tewi 'atsimɨkatimatekɨ ketita mɨtikaxeiya 'arike.   
\p
\v 15 Hikɨ tukaritsie nemuyeikakai tinaime nepɨtiuxei: teɨteri 'aixɨa memɨte'u'uwa 'aixɨa mɨti'ane kaniwaka'unani, teɨteri 'axamemɨteyurie 'axamɨti'ane 'apɨtiwareuteritɨa.   
\q1
\v 16 Kwinimieme 'aixɨa mɨtiyuriene pepɨka'a'erieka,  
\q2 meta kwinimieme mɨtimaiwe pepɨka'ayuyeitɨwani.  
\q1 ¿Matsi ketitayari peti'aka'unamɨkɨ  
\q2 'akɨmana?   
\b  
\q1
\v 17 'Axapetiyurienetɨ pepɨka'ayuyeitɨwani,  
\q2 meta 'atsimɨkatimate hepaɨ.  
\q1 ¿Ketitayari petimɨni  
\q2 kwitɨwa?   
\b  
\q1
\v 18 'Aixɨa kani'aneni 'ikɨ peha'eriwatɨ,  
\q2 peka'itatuayatɨ tita pemɨrexeiya.  
\q1 Kakaɨyari kemɨ'ane mayemakaxe,  
\q2 mɨkɨ naimetsie yakatinikamieni.   
\b  
\q1
\v 19 Mɨtimaiwenikɨ mɨ'ayumieme matsi mɨtimaiwe kanitɨrɨkariyani,  
\q2 keyuri tamamata te'aitamete xeikiekariyaritsie.   
\q1
\v 20 Xewitɨ pumawe 'ena kwiepa 'aixɨa 'anetɨ,  
\q2 'aixɨa tiyurienetɨ hatsuaku 'axakatiyuriwetɨ.   
\p
\v 21 Pepɨkawa'enieka yunaime kememutiyuane, mɨpaɨ matsi peyɨanetɨ mati'uximayatsiriwame pepɨka'enieni kepauka 'ahepaɨtsita 'axamɨtayɨni,  
\v 22 'ekɨta pekatinimaika, heiwa mɨixa 'axapekaniutaineni hipame wahepaɨtsita.   
\s1 Piinitɨarika kenemɨtikuwaunekai  
\p
\v 23 Naime 'ikɨ 'aixɨa nekatiniuyurieni netimaiwetɨ, mɨpaɨ nepɨtiku'eriwakai waɨkawa netimatetɨ nepaneyeitɨani, peru mɨtimaiwenikɨ mɨ'ayumieme 'ateewa paitɨ kaniyuhayewakaitɨni nehetsɨa.  
\v 24 'Ateewa yemekɨ 'aheukatewakaku katiniyuhayewa naitɨ tita mɨtixuawe. ¿Kemɨ'ane pɨyɨwe meitimanikɨ?   
\p
\v 25 Merikɨte nekaninuani nemɨtitamarienikɨ meta nemɨretimanikɨ, mɨtimaiwenikɨ mɨ'ayumieme nemɨtixeiyaxɨanikɨ, meta piinitɨarika hetsiemieme, 'ana mɨpaɨ nepɨretima 'atsimɨkatimate hɨkɨtɨtɨ 'axakatiniyurieneni meta mɨka'uka'iyari kanirukuyaneni xeikɨa.  
\v 26 Tixaɨtɨ matsi nekatiniukaxeiya kwimieme ratsiwime keyuri mɨmɨnikɨ: 'uka mɨtiyu'itaiya kanihɨkɨtɨni, wipi winiyariyari kanexeiyani yu'iyaritsie meta yumamatetsie tepɨa kaunariyari kanexeiyani. Kemɨ'ane Kakaɨyari mɨtemawieritɨa kaniyɨxɨnamɨkɨ mɨkɨ hetsɨa, peru 'axamɨtiyuriene mɨkɨ winiyarieyatsie kaniyukahɨamɨkɨ.   
\p
\v 27 Ti'ɨkitameta mɨpaɨ kaniutayɨni: «Neuxei 'ikɨ nekatiniukaxeiya netiutiwauka piinite hepaɨtsita, xexuimetsie:  
\v 28 'akuxi nepɨtiwaune ketita nemɨkatikaxeiyawe, matsi tewi xeime nekaniutaxeiya xeimiriyari wahetsɨa mieme, peru yunaime 'ukari wahetsɨa xeimetɨma nepɨkataxeiyawe.  
\v 29 'Ikɨ xeikɨa nekatiniukaxeiya: Kakaɨyari tewi kaniutawewieni 'aixɨa 'anekame, peru mɨkɨ kanikuwauni yɨkɨ ti'aneneme».   
\c 8  
\p
\v 1 ¿Kemɨ'ane mɨtimaiwe hepaɨ pɨ'ane? ¿Kemɨ'ane pimate kemɨtikuxata? Tewi mɨtimaiwe kanimatsiɨkɨni yuhɨxie meta kemɨtiyukanaki'erie kaniyutemawieka.   
\s1 Ti'aitame kepemɨreu'enieka  
\p
\v 2 Ne mɨpaɨ nepaine: Ti'aitame keneu'enieka, Kakaɨyari yapemɨtiutahɨawixɨkɨ.  
\v 3 Pepɨka'amexɨitɨaka hɨxiena pemuwayeyanikɨ. Meta tita 'axamɨti'ane pepɨkatiyexɨatɨaka mɨkɨ mɨpaɨ katiniyurieneni kemɨtinake.  
\v 4 Ti'aitame niukieya kani'enierieka, xewitɨ pɨkayɨwe mita'iwawiyakɨ kemɨtiuyuri hepaɨtsita.   
\p
\v 5 Kemɨ'ane yamɨtikamie mɨkɨ kemɨti'aitɨa pɨkatikwinitɨarieni tixaɨtɨkɨ. Yu'iyaritsie mɨtimaiwe katinimaika kehapaɨ mɨtiyurieneni meta kepauka.  
\v 6 Kaniyuritɨni teyunaitɨ ketemɨteyurie kanixɨaweni kepauka, meta kehepaɨ yamɨtiuyurienikɨ, tsepanetɨ tewi waɨkawa mɨtiuka'eniwa yuhepaɨtsita:  
\v 7 'atsikatimaitɨ kemɨtiyɨni hetsienamieme, xewi tɨma pɨkayɨwe para mɨtitaxatɨanikɨ.  
\v 8 Xewitɨ matsi pumawe tɨrɨkariya hexeiyatɨ yu'iyari mukunuitɨanikɨ, meta pumawe tɨrɨkariya hexeiyatɨ mɨmɨnikɨ hepaɨtsita. Xewitɨri pɨkayɨwe mɨrayukwinetsie meyuta'una meta 'axamɨti'ane 'axatiyuruwame mutatuani.   
\s1 Tukari metimanikɨ kanikwaniweni  
\p
\v 9 Naimekɨ mɨpaɨ nekatiniukaxeiya waɨkawa netimaimɨtɨ kenemɨtiutiwau nemɨretimanikɨ naime kemɨti'ane 'ena kwiepa: heiwa tewi xeime mɨti'aitɨakakɨ kaniyɨweni 'axamɨtiyurienenikɨ.  
\v 10 Nekaniwaruxeiyata 'axateyuruwamete memukateukiexɨa —mɨkɨ memeutahakekai mewayekɨkatɨ hakewa Muyepatsietsie—, mɨkɨtsɨ mekanatɨmaiyarieni yukiekaritsie hakewa mɨpaɨ memeyɨakai. Mɨkɨta yaxeikɨa tixaɨtɨ pɨkatihɨkɨ.  
\v 11 Kepauka xeiya mɨkataxanetsieni xɨka 'axatiuyurieni, 'ana teɨteri yu'iyaritsie 'axameteyurietɨ mekanakɨnikuni.   
\p
\v 12 'Axatiyuruwame kaniyɨweni xeitsienituyari paɨmexɨa 'axamɨtiuyurieni, meta mɨixa wiyari kaniuyeikamɨkɨ, matsi mɨpaɨta nekatinimaika, 'aixɨa katiniwayuriekamɨkɨ kemɨ'ane Kakaɨyari memayemakaxe mariweme me'ayeitɨatɨ.  
\v 13 Matsi 'axateyuruwamete 'aixɨa pɨkatiwayurieka meta mɨixa wiyari mepɨkayurieni. Mɨkɨ 'etɨri hepaɨ xeikɨa mekani'anenekuni, Kakaɨyari memɨkamakaxekɨ.   
\p
\v 14 'Ena kwiepa waɨkawa katinixuaweni tixaɨtɨ katiyunaki'erietɨ, teɨteri hipatɨ mekanixuaweni 'aixɨa 'anemekɨ me'u'uwatɨ, matsi 'axateyuruwamete wahepaɨ mekani'itɨarieka, meta mepuxuawe 'axateyuruwamete mɨkɨta yaxeikɨa 'aixɨa mekani'itɨarieka 'aixɨa memɨtekahu wahepaɨ. Neta mɨpaɨ nekanaineni tixaɨtɨ pɨkarayani.   
\p
\v 15 'Ayumieme, temawierika nekanexeiyani, tawari tixaɨtɨ pɨkatixuawe 'aixɨa mɨti'ane tewi hetsiemieme hikɨ tukaritsie, matsi mɨtikwakakɨ, mɨranuye'enikɨ xeikɨa, meta yutemawietɨ, mɨpaɨ xeikɨa 'aixɨa kani'aneni xɨka waɨkawa yu'iyaritɨatɨ ti'uximayaka hikɨ tukaritsie, Kakaɨyari 'ipitɨakaku.   
\p
\v 16 Naimekɨ yanemɨretimanikɨ mɨtimaiwenikɨ mɨ'ayumieme nemɨtixeiyakɨ naime kemɨti'ane 'ena kwiepa 'uyeikatɨ, nepɨkakuwekai tukarikɨ meta tɨkarikɨ neyu'iyaritɨatɨ.  
\v 17 Naime nekatiniuxeiya tita Kakaɨyari mɨtiutawewi. Tewi pɨkayɨwe naime mɨretimanikɨ, Kakaɨyari kemɨtiuyuri 'ikɨ tukaritsie mieme, tsepanetɨ xewitɨ matsi waɨkawa muyutatua mɨretimanikɨ pɨka'itaxeiya, tsepanetɨ xewitɨ mɨtimaiwe mɨpaɨ maine nenepimate, pɨkayɨwe yamɨretimanikɨ.   
\c 9  
\s1 Teyunaitɨ kemɨtatikwewie  
\p
\v 1 'Ikɨ naimekɨ waɨkawa mɨpaɨ nekatiniyurienekaitɨni, 'ikɨkɨ meta naime nekatiniuta'inɨata, 'aixɨa memɨteyurie meta memɨtemaiwawe kememɨte'uximaya, mɨkɨ Kakaɨyari hetsɨa katinimiemetɨni, tewi 'atsipɨkatimate kemɨtiyukanaki'erieka meta kemɨtiyuka'uxiwe'erie, tsepa hɨxiena mɨti'ane.  
\v 2 Teyunaitɨ tekanikukuwemetetɨni:  
\q1 heitseriekamekɨ muyeika meta 'axa'anemɨkɨ muyeika,  
\q1 'aixɨa mɨtiyuriene 'axamɨtiuka'iyari,  
\q1 mɨ'itiya meta mɨka'itiya,  
\q1 kemɨ'aneta mawari mɨwewie  
\q2 meta kemɨ'ane mɨka'iwewie,  
\q1 'aixɨa mɨtiuka'iyari 'axatiyuruwame,  
\q1 kemɨ'ane tixaɨtɨkɨ mɨtiyuhɨritɨa  
\q2 meta xewitɨ mɨkatiyɨhɨritɨa.   
\p
\v 3 Xewitɨ xeikɨa kaniuyeikani 'axamɨtiyurienenikɨ 'ikɨ tukaritsiemieme: Teyunaitɨ tsieretsɨ tekanikwikuni. Metatsiere tewi 'iyarieya 'axamɨti'anekɨ kanihɨneni, rukuxiya xeikɨa yu'iyaritsie kanexeiyani yuheyemekɨ, 'imatɨrieka xeikɨari kanimɨmɨkɨ.  
\v 4 Kamɨtsɨ ¿kemɨ'ane rahetsɨa yapepɨra'eriwa? Yunaitɨ memayeneniere mekanita'ikwewani, matsi  
\q1 'aixɨa kani'aneni tsɨkɨ mayeniereni  
\q2 keyuri maye mɨkitɨ.   
\m
\v 5 Memayeneniere mɨpaɨ mekatenimaika kename mekwini, peru mɨkite 'atsimepɨkatemate meta tixaɨtɨ mepɨkatetakwewie, mɨkɨ yapauka mepatɨmaiyarɨwa.  
\v 6 Kememɨteyukanaki'eriekai kememɨte'uyuka'uxiwe'eriekai, meta kememɨte'ukaheiwe'eriekai mana katiniu'axeni, meta hatsuaku yamepɨkateyurieni kememɨteyurie 'ikɨ tukaritsie mieme.   
\p
\v 7 Ketinekwaka 'a'ikwaite pe'atemawietɨ, kene'ieka 'awinu yemekɨ pe'awaɨriyatɨ, 'ariri Kakaɨyari kaninaki'aka kepemɨti'uximayakɨ,  
\v 8 Tsieretsɨ 'akemarite ketuxani meta hatsuaku pɨkaheuyeweka 'akɨpatetsie witsimu'ɨa.  
\v 9 Kene'atemawieka 'uka penaki'erietɨ tukarikɨ kepemɨreutere kepaɨmexɨa Kakaɨyari metsipitɨa 'ena kwiepa. Xexuime tukaritsie yakɨxeikɨa kepemɨtiyuriene. Mɨkɨ kanihɨkɨtɨni 'ahetsie mɨtiunakixɨ kepeti'atatuatɨ pemɨtiukaxei 'ena kwiepa.  
\v 10 Naitɨ 'ahetsie mɨti'axe 'aixɨa 'anemekɨ yaketineuyuri, hakewa pemekateukieni, mana mɨkahexuawekɨ 'uximayatsika, kepemɨti'atukaritɨani meta tita pemɨtiuyemate meta kepemɨtimaiwe pɨremaweni.   
\s1 Kaneuyeweka matsi mɨrakumaika keyuri tɨrɨkariya  
\p
\v 11 Nepune'ɨwiyaxɨta 'ena kwiepa memanautsawawe xeikɨa mepɨkatehayu'iwa, meta mepɨkatehayu'iwa xeikɨa waɨkawa memɨyɨwawe, metatsiere memɨtemaiwawe xeikɨa mepɨkate'utikwa'ani, meta memɨtemateta tumini waɨkawa mepɨkahexeiya, meta memɨte'uyemate mepɨkayutemamawie 'aixɨa metexeiyarietɨ, matsi pɨta yunaitɨ wahetsie kani'axeni tukarite 'aixɨa 'anenetɨ meta 'axa'anenetɨ.   
\p
\v 12 Mɨpaɨta netinetimani xewitɨ 'atsipɨkatimate kepauka tukarieya maye'ani. Ketsɨte kememɨtekuwiniyarɨwa wipi 'axa'anemetsie meta wikixi winiyaritsie mekaniuyewɨwɨreni, yaxeikɨata teɨteri mekaniwiniyarieka mɨpaɨ memɨkateha'eriwanitsie katinaye'axeni wahetsie xeimieme.   
\p
\v 13 Tawarita xeime nekanetimani kwiepa nekaratɨmaiyatɨ mɨpaɨ mɨtimaiwekaikɨ:  
\v 14 kiekari 'etsiyeukame, teɨteri yakɨ meyupaumetɨ memakuteitsie, xewitɨ ti'aitame tɨrɨkaɨyetɨ mana kaneutahani 'e'iwake, waritana 'imumɨi 'ematayewa mekaniutawewieni memuwara'iwakɨ.  
\v 15 Mɨkɨ kiekaritsie tewi mana kaniukateitɨni, tixaɨtɨ karexeiyatɨ matsi xeikɨa pɨtimaiwekai, kemɨtimaiwekaikɨ kaniyɨwekaitɨni kiekari mutawikweitsitɨanikɨ, xewitɨ tɨma pɨkaheye'eri mɨkɨ tewi tixaɨtɨ mɨkarexeiyakaikɨ.   
\p
\v 16 Ne mɨpaɨ nepaine «matsi peuyewetse mɨrakumaika keyuri tɨrɨkaɨyetɨ», tsepa kepauka mu'uxiwe'eriwa 'iya tewi mɨtimaiwekɨ tixaɨtɨ karexeiyatɨ, meta xɨka niukieya ka'u'enierieni.   
\q1
\v 17 Mɨtimaiwe niukieya matsi kaneuyeweka kayuwatɨ mɨ'enierieka,  
\q2 keyuri 'atsimemɨkatemate tiwa'aitɨwame 'utahiwakaku.   
\q1
\v 18 Kaneuyeweka matsi waɨkawa mɨtimaiwenikɨ,  
\q2 keyuri tituaxame kuyaxa mieme.  
\q1 Xeimekɨ 'axaxɨkapetiuyurieni  
\q2 pekatinitixɨtɨamɨkɨ 'aixɨa mɨti'ane.   
\c 10  
\s1 Mɨtimaiwekɨ 'ɨxatsiyari  
\q1
\v 1 Xaipɨtsi memɨkwikwi'i 'axamekaniu'ɨatɨkani,  
\q2 tita witsimɨtiu'ɨa katinanuyeitɨwani.  
\q1 Mɨpaɨ katinimatsiɨkɨni xɨka 'etsiwa mɨkayɨkɨhɨawe pe'ayani,  
\q2 pɨkayɨwe muyutaxewire mɨtimaiwenikɨ meta 'aixɨa mɨtixeiyariekakɨ.   
\b  
\q1
\v 2 Mɨtimaiwe katinikuwauneni tita 'aixɨa mɨti'ane yu'iyaritsie,  
\q2 matsi 'atsimɨkatimate katinikuwauneni 'axamɨti'ane.   
\m
\v 3 Meta huye'utɨa kemɨtimie 'atsimɨkatimate waɨkawa katineiyehɨaka mɨretimanikɨ, 'anari yunaitɨ mɨpaɨ mekatenetimaikuni kename 'atsikatimate.   
\p
\v 4 Xɨka ti'aitame 'uyeha'ani 'ahepaɨtsita, pepɨka'iku'e'eiriwani ketitakɨ pemɨtihɨritɨarie. Petiukanewietɨ waɨkawa 'axapemɨtiuyurikɨ kani'ayumiemetɨni.   
\p
\v 5 Xewitɨ kanixuaweni tita 'axamɨti'ane, te'aitamete meheuyexɨrɨwetɨ kememɨteyurie hepaɨ tiyuxexeiyatɨ:  
\v 6 'atsimɨkatimate matsi waɨkawa katinihɨritɨarieka timamariwawemekɨ, peru memɨyɨwawe matsi 'etsiwa xeikɨa mekatenihɨritɨarieka.  
\v 7 Nekaniwaxeiyanita waɨriyarika te'uximayatamete kawayutsixi wahetsie mekaniuteni te'aitamete wahepaɨ, teɨterita tewa'aitɨwamete yu'ɨkama mekaniku'uwani waɨriyarika te'uximayatamete wahepaɨ.   
\q1
\v 8 Putsu xɨka 'utawewieni,  
\q2 muwa kaneukawemɨkɨ.  
\q1 Kemɨ'ane 'ixumeri hixɨata 'akame mɨta'una,  
\q2 kuu kanikeimɨkɨ.   
\b  
\q1
\v 9 Xɨka tetexi pe'utitara,  
\q2 mɨkɨ tetexi kametinikwinitɨamɨkɨ.  
\q1 Kemɨ'ane kɨye mawiteni,  
\q2 mɨkɨ kɨyexikɨ katiniyukwinitɨaka.   
\b  
\q1
\v 10 Hatsa xɨka ka'ataxikaunini,  
\q2 meta xɨka ka'etamɨani,  
\q2 matsi karima katinewitekemɨkɨ.  
\q1 Xɨka petimaimɨkɨni ketine'uximayaka 'aixɨa 'anekamekɨ,  
\q2 petimaitɨ meta 'aixɨa peti'a'ɨwiyatɨ.   
\b  
\q1
\v 11 Xɨka kuu tiuyukeni meri 'akuxi kwikarikɨ kakewaiyariewetɨ,  
\q2 tixaɨtɨ pɨkara'iwa 'ikewaiyame.   
\b  
\q1
\v 12 Kepauka mɨtimaiwe mɨtiwakuxaxatɨwa, teɨteri 'aixɨa 'anemekɨ mekani'enieka,  
\q2 matsi kepaukata 'atsimɨkatimate mɨtikuxata, mɨkɨ xeikɨa kaniwaka'unani,   
\q1
\v 13 Matɨari mieme niukieya tixaɨtɨ pɨkatihɨkɨ,  
\q2 'imatɨrieka 'aixɨa pɨkatinɨni 'atsimɨkatimatekɨ.   
\q2
\v 14 Matsi xewitɨ pɨkayɨwe yamɨtayɨnikɨ.  
\b  
\q1 Xewitɨ pɨkatimate kemɨtiyɨni,  
\q2 meta 'arikeke kemɨyɨni,  
\q2 xewitɨ pɨkayuwe yamɨtayɨnikɨ.   
\b  
\q1
\v 15 Mɨka'uka'iyari kemɨti'uximaya yakɨ xeikɨa katiniyu'uxitɨaka,  
\q2 meta kiekari huyeyari 'utɨma pɨkahemarie.   
\q1
\v 16 Xɨa'ui kiekari ti'aitame mɨkatseɨye mɨra'aitatsie, meta tewa'aitɨwamete  
\q2 ximeri paitɨ mekanayatsarɨwani memɨtekwanikɨ.   
\b  
\q1
\v 17 Matsi witsikatinikɨhɨawarɨwani kemɨ'ane kiekaritsie ti'aitame 'aixɨa mɨti'uximaya,  
\q2 meta te'aitamete kepauka memɨtekwa'a mauyewetsetsie,  
\q2 waɨkawa memɨtitɨrɨkaxɨanikɨ memɨtarɨwekakɨ pɨkatixaɨ.   
\b  
\q1
\v 18 Mɨyu'ɨraxie kiiya heima mieme kananuka'unikeni,  
\q2 mɨkatikumaɨwa kiiya kaniuhayeweni.   
\b  
\q1
\v 19 Paa kwatɨ kaniutanawemɨkɨ,  
\q2 winu'ietɨ kaniyutemawiekamɨkɨ,  
\q2 tuminita mitixɨtɨanikɨ kani'ayumiemetɨni.   
\b  
\q1
\v 20 Ti'aitame 'axapepɨkatikumamateni meta 'axapepɨkatiku'eriyani,  
\q2 meta mɨxiku 'awie 'axapepɨkarahɨaweni,  
\q1 wikixi muyuawitsie miemete mekaniyɨwaweni niuki memenɨtɨkirienikɨ.  
\q2 Mekaniu'anani mekaniyɨwaweni memɨte'itaxatɨanikɨ.   
\b  
\c 11  
\q1
\v 1 Hata keneukahɨwa 'apaa,  
\q2 yapaɨmexɨa tukari 'anukayayu 'ana keta pekanitaxeiyamɨkɨ.   
\b  
\q1
\v 2 Me'atahutame yatɨni me'atahaikame  
\q2 ketiniwarumikwa tita pemɨrexeiya,  
\q1 'atsipemɨkatimatekɨ tita 'uximatɨarikayari  
\q2 'umɨramie 'ena kwiepa.   
\b  
\q1
\v 3 Haiwitɨri kepauka mayemanenitsie,  
\q2 kwiepa wiyeri kanikaxɨriemɨkɨ.  
\b  
\q1 Kɨye xɨka tatsutɨa hataweni,  
\q2 yatɨni tayeta,  
\q2 hakewa meutaweni mana kaniyuhayewamɨkɨ.   
\b  
\q1
\v 4 Kemɨ'ane 'eka xeikɨa mɨtaxeiya, pɨka'uka'etsa,  
\q2 kemɨ'aneta haiwitɨri xeikɨa mɨtaxeiya mɨkɨta pɨka'uka'itsana.   
\p
\v 5 Mɨpaɨ 'atsipemɨkatimatekɨ 'eka kemɨreumie, meta kehepaɨ memɨtekununuiwa tɨɨri yumamama wahukatsie, yaxeikɨata Kakaɨyari 'uximayatsikaya pepɨka'enie naime mɨtiutiwewi.   
\p
\v 6 Ximeri paitɨ 'a'imɨari keneuka'etsa, taikaita 'uxipiya pepɨkahexeiyani, matsi 'atsipepɨkatimate ke'anetɨ 'etsiyari 'aixɨa mɨtiyɨni, xɨka 'iya yatɨni 'ikɨ, yamatsi naitɨ 'aixɨa 'anenetɨ pɨrayani.   
\p
\v 7 Hekɨariya witsikani'aneni, 'aixɨata kani'aneni tau hekɨariyayari xeiyatɨ 'amuyeikani.  
\v 8 Xɨka tewi matsi mɨixa wiyari 'a'uyeikani hetsiena yutemawietɨ, matsi tukari tekeha'eriwani 'uximatɨarika mɨtixuaweretsie waɨkawa katiniyɨmɨkɨ, meta tita 'umɨramie 'ana yakɨ xeikɨa pɨkarayani.   
\s1 Matsi'utawewi kena'eriwani  
\p
\v 9 Hikɨ kene'atemawieka mexi petemaikɨ, 'a'iyari keneupitɨa mɨyutemawiekakɨ. Kemɨtiku'eriwa keneyeweiyani meta 'ahɨxitekɨ kepemɨtiuyukahiwe'erie, matsi kena'eriwani Kakaɨyari mɨkɨ naimekɨ kamenita'iwawiyamɨkɨ.  
\v 10 'A'iyaritsie haxɨa pepɨkapitɨaka, 'ahetsie tita 'axamɨti'ane ketinayeweiya, matsi temaikɨ yu'erietɨ meta temaikɨyari yakɨxeikɨa kanihɨkɨtɨni.   
\c 12  
\q1
\v 1 Kemɨ'ane matsi'utawewi kena'eriwani,  
\q2 hikɨri pemɨtemaikɨ,  
\q1 mexinetɨ tukari 'axamɨ'ane ka'aye'awe,  
\q2 kepauka mɨpaɨ pemɨtayɨni:  
\q2 «Pɨkanetsinakeri 'anemuyeikanikɨ mɨixa wiyari»,   
\q1
\v 2 matsi'utawewi kena'eriwani mexinetɨ mehekɨariwie  
\q2 tau meta hekɨariya xuawe,  
\q1 metseri meta xurawetsixi mehekɨariwie,  
\q2 meta mexi haiwitɨri 'anuku'eke kepauka wiyeri mɨtitahayewatsie.   
\q1
\v 3 Tukari Kanaye'amɨkɨ kepauka kii hɨwemete memɨtiyɨyɨaka marikakɨ,  
\q2 mekananakatutsirikuni yukukuyamete,  
\q1 'anari mekatenihayewakuni tɨxɨmete memɨkayumɨirenikɨ,  
\q2 'anarita mepɨkaneniereni, 'itupari 'etsi mayeyeutsie memaneniere.   
\q1
\v 4 Katinaunarirɨmemɨkɨ kitenie kaye 'utɨa mieme,  
\q2 'anari kananukanuaximemɨkɨ murina yuariyaya,  
\q1 wikixi yukwikari mekananukuhanikuni,  
\q2 matsi wakwikari pɨtɨkini puka'enierieka.   
\q1
\v 5 Marika Kanitixuawerimɨkɨ hɨrite 'amanutitɨtɨtsie,  
\q2 'anarita huyeta kaniumariwemɨkɨ.  
\q1 'Arimenitɨra meta 'ana kanitixutuimɨkɨ,  
\q2 'utsikari mekani'axɨakuni yumɨiretɨ,  
\q2 mekanikakɨmikuni 'anari tixaɨtɨ tiyunaki'erietɨ pɨka'ayani,  
\q1 tewi kaniyemieni kiekari 'emɨtiteriwetsie,  
\q2 kaye'utɨa mekaniyexɨrietɨwekuni, meyuhiwerietɨ 'akaxari mexeiyatɨ.   
\b  
\q1
\v 6 Kena'eriwani kemɨ'ane matsi'utawewi,  
\q2 mexi katatsaniwe pɨrata hɨiyameyari,  
\q2 meta mexi katatariwe huru xariyari,  
\q1 meta xari haa manakaxɨrɨwetsie katitawaxɨawe,  
\q2 tsikɨrɨrɨiya katitarixɨawawe putsuta mɨiretɨ ka'ayeiwe.   
\q1
\v 7 'Anari kwiepa tumuanari kanayeimɨkɨ,  
\q2 meripaitɨ mɨ'anekai hepaɨ,  
\q1 'iyari kanakunuamɨkɨ Kakaɨyari hetsɨa,  
\q2 mɨkɨ mana meiyenɨ'akɨ.   
\b  
\q1
\v 8 Ti'ɨkitame mɨpaɨ nekanaineni:  
\q2 'ikɨ tukari tixaɨtɨ pɨkarexeiya,  
\q2 naitɨ 'axakatini'aneni.   
\s1 Niuki 'imatɨarieka mieme  
\p
\v 9 Matsi waɨkawa timaiwetɨ, ti'ɨkitame teɨteri katiniwarutaxatɨani naime ketita mɨretima. Mɨkɨ naime katineutixeiyaxɨani yumarima, mɨireme temaiwawemete kememɨte'u'ɨxatsita waxapa kanayeitɨani.  
\v 10 Tsiepɨre hipame niukite kaniutaxeiya 'aixɨa 'anuyɨtɨkaime, mɨkɨta kaniti'utɨani yumarima yuri mainekɨ.   
\p
\v 11 Memɨtemaiwawe waniuki tiyutseweme hepaɨ kani'aneneni. Kɨrapuxite 'aixɨa mɨretsunini hepaɨ mekatenikuxatani, xewitɨ xeikɨa tixaxatame tiwakuxaxatɨwakaku.  
\v 12 Ne matsi mɨkɨ hepaɨtsita nematsihaye'eritɨwa 'ekɨ neniwe nematsinaki'erie, waɨkawa xapate xɨka'utiwewieni pɨkayɨnɨrinɨa, meta xɨka pe'ititerɨwa pekaniti'uximɨkɨ waɨkawa.  
\v 13 'Imatɨarieka 'ikɨ niuki naitɨ kaniu'enierieni. Kakaɨyari matsi kenayemakaxeni, yaketinekamieni 'aitsikayatsie, 'ikɨ naitɨ tewi hetsie kanimiemetɨni.  
\v 14 'Uximayatsika matsi, 'axamɨ'anene meta 'aixɨamɨ'ane meta 'awie ketemɨteyurie Kakaɨyari naime kanita'iwaumɨkɨ.   