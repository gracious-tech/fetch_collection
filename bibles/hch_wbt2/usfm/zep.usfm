\id ZEP  
\h Tsupuniyaxi 
\toc1 Tsupuniyaxi 
\toc2 Tsupuniyaxi 
\toc3 Tsup 
\mt1 Tsupuniyaxi  
\c 1  
\p
\v 1 'Ikɨ Yawé niukieya kanihɨkɨtɨni, Tsupuniyaxi kemɨtiutahɨawarie Kutsi nu'aya, mɨkɨta Kerariyaxi nu'aya, mɨkɨta 'Amariyaxi nu'aya, mɨkɨta 'Etsekiyaxi nu'aya, kepauka mɨti'aitakai Kutsiyaxi 'Amuni nu'aya, Kura kwieyaritsie:   
\s1 Kememɨte'utaxatɨarie kememɨteka'unarieni 'arike  
\q1
\v 2 «Meteyunaime nepɨtiwareuyehɨani  
\q2 kemeteyupaɨmetɨ kwiepa memɨtexuawe  
\qr —Yawé mɨpaɨ kanaineni—.   
\q1
\v 3 Teɨteri meta tewaxi nekaniwareuyehɨamɨkɨ,  
\q2 meta memɨte'awɨwawe  
\q2 meta haramaratsie memɨteye'uwa,  
\q2 metatsiere kakaɨyarixi memɨwewiyatɨka metatsiere teɨteri 'axamemɨte'u'iyari yaxeikɨa.  
\b  
\q1 »Teɨteri nekaniwarakumaweriyamɨkɨ  
\q2 'ena kwiepa naitsarie  
\qr —mɨpaɨ kanaineni Yawé—.   
\s1 Kura kemɨtika'unarieni  
\q1
\v 4 »Kura kwieyaritsie kiekatari nepɨtiwakwinitɨani,  
\q2 meta yunaime Kerutsareme kiekatari.  
\q1 Wahari huyerieya 'ɨarime naime nepakuyeitɨani,  
\q2 meta mawari wewiwamete hetsɨana miemete kememɨtetetewa naime,   
\q1
\v 5 meta kemɨ'ane yukii heima memukatunuma'uwe,  
\q2 muyuawitsie miemete xurawetsixi mewarayexeiyatɨ,  
\q1 meta kemɨ'ane metitunuma'utɨ,  
\q2 kename Yawé me'ayexeiya memutiyuane,  
\q2 kwitɨwata kakaɨyari Muruki yaxeikɨa memɨtehahɨawe,   
\q1
\v 6 meta kemɨ'ane Yawé memuku'e'eiriwa,  
\q2 meta memɨka'ikuwautɨwe meta memɨkahe'iwawiya.   
\q1
\v 7 Kayuwatɨ xekeneumaka Yawé Naimekɨmɨyɨwe hɨxie,  
\q2 Yawé mɨtixekwinitɨanitsie pehurari,  
\q1 Yawé mawari kaniukuha'aritɨani  
\q2 meta yu'inierima kaniwaru'itieniri.   
\q1
\v 8 'Iya tukaritsie Yawé yumɨireme muwakwinitsie  
\q2 nepɨtiwakwinitɨani ti'aitame parewiwametemama meta niwemama,  
\q2 meta kemɨ'ane kamixate hipame kwieyaritsie miemete memanakatɨtɨka.   
\q1
\v 9 'Iya tukaritsie nekatiniwakwinitɨamɨkɨ  
\q2 kemɨ'ane hipame kakaɨyarixi memɨwarayexeiya,  
\q1 meta memɨtehɨniya yukakaɨyarixi watukita piinite,  
\q2 'itarikakɨ memɨte'a'iwaxɨ meta hipame mewananaimatɨ.   
\b  
\q1
\v 10 »Yawé mɨpaɨ kanaineni: 'Iya tukaritsie parewiya hiwariyari pɨ'enierieni,  
\q2 kitenie Tsapa mɨtitewatsie paitɨ,  
\q2 'aiwari pɨ'enierieni Kiekari Hutarieka Mieme makumatsie,  
\q2 meta waɨkawa hiwari pa'eniɨriɨkɨni yemuritetsie paitɨ.   
\b  
\q1
\v 11 »Xemeta xekeneutitsuanani, tetuayamete memakutei xemɨtama.  
\q2 Naitɨ tita xemɨtetua katineuyehɨiyamɨkɨ,  
\q2 xepeuyehɨiyani yunaitɨ kemɨ'ane pɨrata xemexeiyanikɨ xemɨyɨa.   
\q1
\v 12 'Iya tukaritsie Kerutsareme nepayekexiya kɨxeme ne'akwetɨ,  
\q2 nemɨtiwakwinitɨanikɨ kemɨ'ane yu'iyarikɨ memɨ'uxipie,  
\q2 kaxie winuyari mɨkakuyuitɨariwa meuyewexime hepaɨ memɨ'ane,  
\q1 kemɨ'ane mɨpaɨ memutiyuane: “Yawé 'atsipɨkatiyurieni,  
\q2 ni'aixɨa pɨkatatsiyurieni ni'axa pɨkatatsiyurieni”.   
\q1
\v 13 Xepiinitɨarika memɨxeka'una wa'iwarika pɨrayani,  
\q2 xekii yuxaɨta puyuhayewaxɨani:  
\q1 “Yukii xepɨtiwewieni,  
\q2 peru muwa xepɨka'ayeyaxe,  
\q1 kaxie xepɨka'iteɨta,  
\q2 peru winuyari xepɨkaha'inɨata”.   
\s1 Yawé haxɨaya tukariyari  
\q1
\v 14 »Yawé haxɨaya tukariyari paye'axime,  
\q2 kanaye'aximeni yapauka.  
\q1 Yawé tukarieyatsie pɨ'enierieni kwinimieme memɨte'uka'eniwa hiwariyari,  
\q2 meta kemɨ'ane mɨkama 'ana kanitatsuamɨkɨ.   
\q1
\v 15 'Iya tukaritsie haxɨa tukariyari kanayeimɨkɨ,  
\q2 meta 'uximatɨarika meta hiwerika tukariyari,  
\q1 xemɨka'unarieni meta xemakumaweriyarieni tukariyari,  
\q2 yɨriya tukariyari,  
\q1 meta haiwitɨri mɨyɨyɨxawi tukariyari,   
\q2
\v 16 kuxineta meta kuyaxa hiwariyari tukariyari  
\q1 kiekarite kuraruyari 'amatitɨtɨ hepaɨtsita mieme,  
\q2 meta tuxiyu 'amutɨtɨ hepaɨtsita mieme.   
\q1
\v 17 Ne nepɨwaranukuweiya teɨteri nekawa'uxipitɨatɨ,  
\q2 memɨkaheuneniereni hepaɨ me'anenetɨ mepu'uwani,  
\q2 Yawé hepaɨtsita 'axamemɨte'uyurikɨ.  
\q1 Waxuriya nitayeuriyamɨkɨ tumuanari hepaɨ,  
\q2 meta wakwinurite kwitarai hepaɨ pɨtiyuxexeiyani.   
\q1
\v 18 Wahuru meta wapɨrata  
\q2 pɨkawatawikweitsitɨani,  
\q2 Yawé haxɨaya tukariyaritsie.  
\q1 'Ɨtetsarikaya taiyari  
\q2 naime kwie pakuxɨtsitɨani,  
\q1 yapauka kaniwarakumaweriyamɨkɨ  
\q2 yunaime teɨteri kwiepa memɨtama».   
\b  
\c 2  
\q1
\v 1 Xekeneyuyetua, tixaɨtɨ xekatehɨmetɨtɨ xekenayuyeitɨa,  
\q2 teɨteri xemɨkayukatetewiya,   
\q1
\v 2 yaxeketenekakɨni mexi kahaye'awe kenemutayɨ,  
\q2 mexi tukari xemɨkwewiyatsie xemɨtehayewakɨ xatsi yapauka kemɨre'enitsitɨariwa hepaɨ kayɨwe,  
\q1 mexi xehetsie kakawewe Yawé haxɨaya mɨta'a,  
\q2 mexi xehetsie ka'aye'awe Yawé haxɨaya tukariyari.   
\q1
\v 3 Yawé xekeneutiwawa, yunaitɨ xeme tixaɨtɨ xemɨkatehayuyeitɨa 'ena kwiepa,  
\q2 yaxemɨteyurie 'aitsikateya kemaine.  
\q1 Xekeneutiwawa tita mɨtiheitserie meta 'axekeneu'uwani tixaɨtɨ xekatehayuyeitɨatɨ,  
\q2 heiwatɨ 'ana xe'uti'awieta,  
\q2 kepauka Yawé haxɨaya tukarieya maye'anitsie.   
\s1 Piritsiteutsixi kememɨte'utahɨawarie  
\q1
\v 4 Kahatsa kiekariyari yuxaɨtame kaniyuhayewamɨkɨ,  
\q2 meta yaxeikɨa 'Atsikaruni kiekariyari 'unitɨ kaniyuhayewamɨkɨ.  
\q1 'Atsiruri kiekatari mekanayeweiyariekuni hekɨta,  
\q2 yaxeikɨata 'Ekuruni kiekatari mekanitaweiyariekuni.   
\q1
\v 5 Xɨa'ui kereteutsixi teɨteriyari  
\q2 haramara tetsita memɨtama.  
\q1 Yawé niukieya xehepaɨtsita yakanaineni kemɨtixekwinitɨani,  
\q2 piritsiteutsixi Kanani kwieyaritsie xemɨtama:  
\b  
\q1 «Ne nekanixekwimɨkɨ  
\q2 nixeimetɨma mana nepɨkahayewa».   
\b  
\q1
\v 6 Haramara tetsita 'uweritɨ 'utsiɨraɨyetɨ kanayeimɨkɨ,  
\q2 mɨratihɨriwa meta muxatsi wakuraru makumane.   
\q1
\v 7 Mana muxatsi mekatenitikwaikuni  
\q2 Kura nuiwarimama memɨyuhayewa watewama.  
\q1 Taikai meputi'uxipiweni  
\q2 'Atsikaruni kiekariyari muku'eiriwaxɨtsie,  
\q1 Yawé wakakaɨyari waparewienike mana kaninuamɨkɨ  
\q2 'aixɨa wayurienike.   
\s1 Muhawi meta 'amunitsixi kememɨte'utahɨawarie  
\q1
\v 8 «Ke'axamemutiyuane muhawitsixi nekaniwa'enieka,  
\q2 meta 'amunitsixi wayuriyarika,  
\q1 neteɨterima wahepaɨtsita kememɨteheuniuka  
\q2 meta wakwie mewanawairietɨwetɨ.   
\q1
\v 9 Yurikɨ mɨpaɨ nekanaineni,  
\q2 —Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye, 'Ixaheri Kakaɨyarieya—,  
\q1 Muhawi Tsuruma kwieyari hepaɨ 'anetɨ kanayeimɨkɨ,  
\q2 meta 'amunitsixi Kumuxa kiekariyari hepaɨ mepɨ'itɨarieni:  
\q1 witsaxa 'ɨtsiyari xeikɨa payani meta 'una maxuawe,  
\q2 yuheyemekɨ 'akumawetɨ payani.  
\q1 Neteɨterima memɨyuhayewa wapiini mepɨtewanawairieni,  
\q2 meta neteɨterima 'akuxi memu'uwani wakwie yupiini mepayeitɨani».   
\b  
\q1
\v 10 'Ikɨkɨ mekatenakapitɨariekuni memuyuta'ɨrixɨkɨ,  
\q2 memɨwarutaniukimakɨ meta memɨwaxani'eriekaikɨ Yawé Naimekɨmɨtɨrɨkaɨye teɨterimama.   
\q1
\v 11 Mepɨtimamani kepauka Yawé  
\q2 yunaime kakaɨyarixi kwiepa memɨtama muwaka'una,  
\q1 'ana nuiwarite teewanarixitɨtɨ,  
\q2 mekanikatunuma'uikuni nenewieri me'ipitɨanike,  
\q2 yuxexuitɨ yukwieyaritsie paitɨ.   
\s1 'Etiupetsixi kememɨte'utahɨawarie  
\q1
\v 12 «Yaxeikɨata xeme, 'etiupetsixi,  
\q2 ne'ixiparakɨ xekanikwi'iwakuni».   
\s1 'Atsiriyutsixi kememɨte'utahɨawarie  
\q1
\v 13 Yawé yutɨrɨkariya kanitanɨ'amɨkɨ tayeta memukuma wahepa.  
\q2 'Atsiriya kiekatari yunaime kaniwarakukwimɨkɨ,  
\q1 meta Niniwe 'akumaweme kanayeitɨamɨkɨ,  
\q2 xiekaripa makuwaki hepaɨ.   
\q1
\v 14 Kiekari muyuta'ɨre maku'ɨxaya payani muxatsi memɨte'atikwa'ani  
\q2 meta hipatɨ tewaxi.  
\q1 Mana yukie mepayeitɨani meteyunaitɨ yeutari.  
\q2 Nɨpe hamatɨa mikɨri tuxiyu mu'u'uni hetsie mepakayaxikeni.  
\q1 Watsuari kii hixɨapa nenieremetsie mepayetsuatɨkani,  
\q2 kitenie mɨranutahakitɨretsie pɨranu'u'unini,  
\q2 kariuxa kɨyeyari kii hetsie manuyehe hayekɨa puyehini.   
\q1
\v 15 'Ikɨ kiekari muyutemawiekai kanihɨkɨtɨni,  
\q2 yu'iyarikɨ 'aixɨa 'iyari 'amukumakai,  
\q1 yukɨmana mɨpaɨ mutainekai:  
\q2 «Ne xeikɨa nepɨhɨkɨ, xewitɨ tawari pumawe».  
\q1 Matsi neuxei puka'unarie meta  
\q2 yeutari wakie patɨa.  
\q1 Kehate mana memuyekɨne me'ixeiyame  
\q2 mepuyukatemamawieni me'inanaimatɨ.   
\c 3  
\s1 Kerutsareme manutimietsie kemɨtiyɨni  
\q1
\v 1 Xɨa'ui kiekari hipame pemɨwananaima,  
\q2 pemɨkaheu'ena meta tita 'axamɨti'ane pemɨrexeiya.   
\q1
\v 2 Mɨkayu'ɨxatsitɨarinɨa,  
\q2 meta mɨkatiyuxatɨarinɨa.  
\q1 Yawé hetsie yuri mɨkati'erie,  
\q2 meta yukakaɨyari hetsɨa 'ahurawa mɨka'uyeika.   
\q1
\v 3 'Itsɨkate mana memanuka'u  
\q2 mayetsi memɨtehaketɨkɨka wahepaɨ mepɨ'anene,  
\q1 wakuwexinaruritsixi 'ɨrawetsixi yɨwikɨta memuku'uwa mekanihɨkɨtɨni  
\q2 tita memɨtetakwani tixaɨtɨ mepɨkatekuhayeikawa memɨkakayeikienikɨ.   
\q1
\v 4 Kakaɨyari niukametemama mana kiekatari mepɨte'itawa,  
\q2 Kakaɨyari mepuku'eiri.  
\q1 Mawari wewiwamete piinite netukita timieme katipatsiekame mepɨte'ayeitɨa,  
\q2 meta 'aitsika kemaine yamepɨkatekahu.   
\q1
\v 5 Matsi Yawé mana muka kemɨtiheitserie yapɨtiyuriene,  
\q2 kemɨkatiheitserie pɨkatiyuriene.  
\q1 Xexuime tukari mukatataretsie kemɨtiheitserie yapɨtiyuriene,  
\q2 meta pɨkatihayewa tukari mɨyehane mukatataretsie,  
\q2 peru 'axatiyuruwame tewiyarika pɨkamate.   
\b  
\q1
\v 6 «Nekaniwaruka'una nuiwarite,  
\q2 kanakumawere wakuraru meta watuxiyu.  
\q1 Nekanihayewa kaye 'utɨa teɨteri 'umaweme,  
\q2 nixewitɨ tɨma mɨkɨ 'utɨa pɨka'uyeika.  
\q1 Kaniuyuhayewa wakiekarite 'u'unitɨ,  
\q2 nixewitɨ pɨkayuhayewaxɨ mana mukanikɨ.   
\q1
\v 7 Kiekari mɨpaɨ nepɨtiutahɨawixɨ:  
\q2 “Yurikɨ pepɨnetsi'ayemakaxeni,  
\q2 kenemɨmetita'ɨxatsitɨani pepeu'enani”.  
\q1 Hikɨ 'ayumieme wakiekari pɨkaka'unarienikekai,  
\q2 naimekɨ nemɨtita'aitɨakaikɨ.  
\q1 Peru mɨyatɨtɨ, meyumexɨitɨatɨ mekanakɨne pɨta  
\q2 'axamemɨteyurienikɨ naime hepaɨtsita.   
\q1
\v 8 'Ayumieme xekenenetakwewieka,  
\q2 yapauka nepɨrayu'iwa  
\qr —Yawé mɨpaɨ kanaineni—,  
\q1 'ari nuiwarite neniwakuxeɨrimɨkɨ,  
\q2 meta te'aitamete  
\q1 nemɨtiwakwinitɨanikɨ nehaxɨakɨ,  
\q2 meta naimekɨ kenemɨreuha'a.  
\q1 Ne'ɨtetsarika taiyariyarikɨ,  
\q2 naitɨ kwie kanakuxɨtsitɨariemɨkɨ.   
\b  
\q1
\v 9 »Teɨteri 'aixɨa me'utiyuaneme nekaniwarayeitɨamɨkɨ,  
\q2 para yunaitɨ memɨnetsihahɨawenikɨ Yawé kenemɨtitewa  
\q2 meta memɨnetsi'ayexeiyanikɨ yaxeikɨa meteyukɨhɨawetɨ.   
\q1
\v 10 Kutsi hatɨayari manuyehapane 'anutaɨye me'anexɨame,  
\q2 'imikieri mekaneni'atɨiriekuni  
\q2 memɨnetsi'ayexeiya, neteɨterima memeutaxɨriexɨa.   
\q1
\v 11 Mɨkɨ tukaritsie tewiyarika xepɨkapitɨarieniri,  
\q2 'ari 'axaxeteyurietɨ nehepaɨtsita xepɨtehayewa.  
\q1 Nekaniwarayeweiyamɨkɨ xetsata  
\q2 mɨkɨ teɨteri mamariwemete memayuyeitɨwa,  
\q1 hikɨ 'ana mepukumawere memɨyuti'ɨre  
\q2 nehɨri makupatsietsie.   
\q1
\v 12 Mekaniyuhayewakuni xeikɨa,  
\q2 tixaɨtɨ memɨkatehɨkɨ.  
\q1 Mɨkɨ Yawé hetsie memɨtewiya memɨhɨkɨkɨ,   
\q2
\v 13 'etsimeyupaɨmetɨ memɨyuhayewaxɨ 'ixaheritsixi,  
\q1 tita 'axamɨti'ane mepɨkateyuriekari,  
\q2 'itarikakɨ mepɨkatekuxatani,  
\q2 kwamanarikakɨ mepɨkatekuxatani.  
\q1 Mekateniutikwa'akuni meta mekaniuka'uxipiwekuni  
\q2 nixewitɨ kawamariutakaku».   
\b  
\q1
\v 14 Keneutahiwani, neniwe 'uka Tsiyuni, temawierikakɨ,  
\q2 memɨtehayu'iwa wahepaɨ xeketeneuhiwani, 'ixaheritsixi.  
\q1 Xekeneutikwikani meta xekeneyutemamawieka yu'iyarikɨ,  
\q2 neniwe 'uka Kerutsareme.   
\q1
\v 15 Yawé pɨkatixekwinitɨaniri,  
\q2 kaniwarutaweiya memɨmetsi'aye'unie.  
\q1 Yawé, 'Ixaheritsie ti'aitame, xetsata kaniukani:  
\q2 hatsuakuri pepɨkaheumaka.   
\q1
\v 16 Mɨkɨ tukaritsie Kerutsareme mɨpaɨ pɨtitahɨawarieni:  
\q2 «Tsiyuni, pepɨkamaka meta pepɨka'utaweranareni,   
\q1
\v 17 Yawé 'akakaɨyari 'ahamatɨa kaniukani  
\q2 mɨkɨ kuya mɨrayu'iwa pɨhɨkɨ.  
\q1 Pɨyutemawieka 'ahetsiemieme,  
\q2 pɨmetsihekwariyani yunaki'eriyakɨ,  
\q1 kaniutakwikamɨkɨ yutemawietɨ 'ahetsiemieme   
\q2
\v 18 'ixɨarari mɨhɨkɨtɨni hepaɨ».  
\b  
\q1 «Ne xehetsie nepɨtanuani xemɨkahiweritɨarienikɨri,  
\q2 mɨixari kexemɨte'anuyehu xetewiyatsitɨarietɨ.   
\q1
\v 19 Mɨkɨ tukaritsie ne nekaniwaranukuweiyamɨkɨ  
\q2 kemɨ'ane waɨriyarika memɨtexe'aitɨa,  
\q1 nepɨwatawikweitsitɨani muxatsi memɨ'ɨkamɨmɨri,  
\q2 meta nekaniwaranukuwaumɨkɨ memeuyexɨri.  
\q1 Xeme xemariwame waɨkawa nepɨxe'ayeitɨani  
\q2 'iya nuiwarite watsata hakewa xemetewinɨarie.   
\q1
\v 20 Mɨkɨ tukaritsie ne nekanixe'atɨamɨkɨ,  
\q2 mɨkɨ tukaritsie nepɨxekuxeɨrieni.  
\q1 Xeme xemariwame waɨkawa nepɨxe'ayeitɨani  
\q2 yunaime teɨteri kwiepa memɨtama watsata  
\q1 kepauka nemɨxehakunuitɨani mɨkɨ wahɨxie  
\q1 'ateewa xehehapanieku».  
\qr Mɨpaɨ kaniutayɨni Yawé.   