\id JOL  
\h Kuheri 
\toc1 Kuheri 
\toc2 Kuheri 
\toc3 Kuh 
\mt1 Kuheri  
\c 1  
\p
\v 1 'Ikɨ Yawé niukieya kanihɨkɨtɨni, Kuheri hetsɨa munua Petuheri nu'aya.   
\s1 Tekɨmemete kememɨteheuyehɨa  
\q1
\v 2 Teɨteri 'ukirawetsixi 'ikɨ xekeneu'eni,  
\q2 Yemekɨ xekeneu'enana, yunaitɨ teɨteri 'ikɨ kwieyaritsie xemɨtitei.  
\q1 ¿Heiwamieme 'ipaɨ kapɨtiɨyɨ xeme xe'u'uwakaku  
\q2 yatɨni meripaitɨ kiekatari memu'uwakaitsie?   
\q1
\v 3 'Ikɨkɨ yuniwema xeketeniwarutaxatɨa,  
\q2 mɨkɨta yuniwema mepɨtewataxatɨani,  
\q2 yaxeikɨata mɨkɨ xetutsima memɨtewataxatɨanikɨ.   
\q1
\v 4 'Utsikari 'amemɨnene tita memɨte'utatexi  
\q2 'utsikari yakɨmemɨnene naime mekaniutikwani,  
\q1 meta 'utsikari yakɨmemɨnene tita memɨte'uhayewaxɨ  
\q2 'utsikari 'etsimemɨpepe naime mekateniutikwani,  
\q1 'utsikari 'etsimemɨpepe tita memɨte'uhayewakai  
\q2 'utsikari kwimemɨpepe mekateniutikwani.   
\b  
\q1
\v 5 Xemɨtarɨwe, xekenanutaneniereni xekeneutitsuanani.  
\q2 Yemekɨ xekeneuti'aiwani winutsie xemɨyuyetua,  
\q2 matsi kaxie winuyari makaka xekaniunawaiyarieni xemi'iekaikɨ.   
\q1
\v 6 Xewitɨ kiekari mɨtɨrɨkaɨye memɨkayu'inɨatsinɨa  
\q2 mekaniu'axɨani nekwietsie:  
\q1 Mɨkɨ mayetsi wahepaɨ mekateniutameni,  
\q2 maye 'uka tameteya 'emɨtɨtɨ hepaɨ.   
\q1
\v 7 Naime mepɨte'ukakɨmixɨ kaxie xawari,  
\q2 piní mepukamuraxɨ.  
\q1 Mamateya naime meputimetseriyaxɨ,  
\q2 naime mepukakarauxi 'ɨkaya meta xawari.   
\b  
\q1
\v 8 Neteɨterima meputitsuana 'uka 'ɨimari heiwerika 'iwiyari manahɨwa hepaɨ  
\q2 mitiwitɨnikekai 'umɨku hetsiemieme.   
\q1
\v 9 Hatsite mawariyari meta kaxie winuyari mɨtiyeuriwakai,  
\q2 mɨkɨri Yawé tukieyata pɨkareyetuiwa.  
\q1 Mawari wewiwamete mepuyuheiwerie,  
\q2 Yawé hetsiemieme te'uximayatamete.   
\q1
\v 10 Naitɨ 'ikwaxi pɨka'ukaxuxuawereri mɨraku'etsitɨretsie,  
\q2 naitɨri kwie kaniuwakini,  
\q1 hatsiteri naitɨ katineuyeweni,  
\q2 kaxie winuyariri mɨhekwa kaniukawani  
\q2 meta hatseiti kaniuxɨniri naitɨ.   
\q1
\v 11 Xemetatsiere xeke'utiwani, te'uximayatamete,  
\q2 xekeneutitsuanani meta te'etsamete,  
\q1 xemɨte'ekai tsewara meta tɨriku xemɨteheuyehɨakɨ,  
\q1 naitɨtsɨari mɨraku'etsitɨre mɨtiuka'etsiwakai katineuyeweni.   
\q1
\v 12 Kaxie naitɨ kaniutiyɨnare,  
\q2 piní kaniutawani,  
\q1 'ikwaxi manitsana hepaɨ mɨ'anene kaniutiyɨnare,  
\q2 takɨ meta manitsana,  
\q2 naitɨ kɨyexite 'ɨtsita mɨreuka'u.  
\q1 Yaxeikɨa teɨteri watemawierika kaniutiyɨnare.   
\s1 Kememɨte'uta'inierie memɨtehayewanikɨ ke'axamemɨteyurie  
\q1
\v 13 Xeme mawari wewiwamete, heiwerika kamixayari xekenanakatɨkɨni xe'utitsuatɨ.  
\q2 Xekeneyuheiwerieka, mawari taiyame te'uximayatamete.  
\q1 'Ena xekenakɨni, xeme Kakaɨyari hetsɨa te'uximayatamete,  
\q2 tɨkarikɨ hiwerika kamixayari xekenanakatɨkɨni,  
\q1 hatsite mawariyari meta kaxie winuyari mɨka'atɨariwanikɨ  
\q2 Kakaɨyari kiitana mɨtiuta'imaritɨxɨkɨ.   
\q1
\v 14 Xekeneyuhakieka xeyuyetuatɨ,  
\q2 xekenewa'inieka teɨteri memayuxeɨrietsie.  
\q1 'Ixaheritsixi teɨteriyari 'ukirawetsixi xekeniwaxeɨrieka  
\q2 Yawé xekakaɨyari kiita,  
\q1 yunaime teɨteri kiekari mɨtama xekeniwarukuxeɨri,  
\q2 meta Yawé xekeneutahɨawi.   
\b  
\q1
\v 15 Xɨa'ui 'iya tukaritsie, Yawé tukarieya maye'aximekɨ.  
\q2 Mɨkɨ tukaritsie naime katinika'unamɨkɨ Naimekɨmɨtɨrɨkaɨye.   
\b  
\q1
\v 16 Ta'ikwai kataniunawairieni  
\q2 tame tenenierekaku,  
\q1 te'utinawetɨ meta ketemɨteyutemamawiekai  
\q2 takakaɨyari tukieyata mieme.   
\q1
\v 17 'Imɨari kaniutipɨne  
\q2 muka'etsiekai.  
\q1 'Imɨari muwati'utsiwatsie puyexɨ  
\q2 meta naitɨ puti'unixɨ kiiyari  
\q2 mɨtiuka'etsiekai mɨreuyewekɨ.   
\q1
\v 18 Tewaxi yemekɨ meputitsuana.  
\q2 Hau'erietɨ mepeu'uwa wakaitsixi  
\q1 hakewatsɨ metehetikwani katiniumaweni,  
\q2 yaxeikɨa muxatsi mekateniuka'eniwani.   
\b  
\q1
\v 19 'Ekɨ, Yawé, ne nepɨmetsiwawirie,  
\q2 'ɨxatsɨ 'ayeparitsie meuka'ukai taikɨ mutitai,  
\q2 tai 'amanutiteterekɨ naime katiniutitaiya kɨyexite 'ɨtsita mɨreuka'ukai.   
\q1
\v 20 Tewaxi yeutari mepɨmetsikuwautɨwe meteheuyehɨatɨ,  
\q2 wahaa 'akiitsie naitsarie mukawaxɨakɨ  
\q2 tai 'ɨxa mutitaiyaxɨkɨ 'ayeparitsie.   
\c 2  
\s1 'Utsikari kuyaxiyari  
\q1
\v 1 Kerutsaremetsie kuxineta xekeneutahɨtsiwani,  
\q2 nehɨri mɨpatsie hetsie xekeneutihiwani mɨ'enieriekakɨ.  
\q1 Yunaitɨ teɨteri kwiepa xemɨtama xekenemamaka,  
\q2 'aritsɨari Yawé tukarieya 'ukanamieni  
\q2 kaniyuritɨni kanehuraniri.   
\q1
\v 2 Yɨriya tukariyari kanaye'amɨkɨ,  
\q2 hai tukariyari mɨyɨyɨxawi kanaye'amɨkɨ.  
\q1 Hekɨariya kemɨtiyuhekɨa kahekɨarirɨmetɨ kwiepa,  
\q2 mɨpaɨ katinimakatsiukɨni kiekari mɨmariwe mɨtɨrɨkaɨye,  
\q1 meripaitɨ hatsuaku kemɨkatiɨyɨ,  
\q2 nuiwarite 'umemahu wahetsiemiemeri hatsuaku yapɨkatiyɨni.   
\q1
\v 3 Mexiyukukuyamete meka'aye'axɨawawe 'iya tai kaniwatixɨtsitɨwani,  
\q2 kepauka mɨpaɨ mɨraye'ani tai pɨtititaiya naime.  
\q1 Mexixi kahaye'awe kiekari 'Ereni haraweriyari witsimɨraku'ane hepaɨ pɨtiyuxexeiya,  
\q2 kepauka mɨpaɨ mɨtiyɨni yeuta makumawe payani.  
\q2 Tɨrɨkariyaya hepaɨtsita tixaɨtɨ pɨkatitawikweni.   
\q1
\v 4 Kawayutsixi wahepaɨ mepɨteyuxexeiya,  
\q2 kawayutsixi meha'atɨ meheuyukwiyuka wahepaɨ mepɨte'unanautsa.   
\q1
\v 5 Kepauka hɨri 'emutɨtɨtsie memeutatsukwaka,  
\q2 kaxetatsixi yukukuyamete wayuarika hepaɨ pɨtiyu'eniɨriɨkɨ,  
\q1 xatsi taipa taiyarietɨ mutatsipɨarɨka hepaɨ.  
\q2 Kuyaxi memɨtɨrɨkawi 'aixɨa memɨteheku'u meyutakwinike mɨpaɨ mepɨteyuhekɨa.   
\b  
\q1
\v 6 Teɨteri marikakɨ meputiyɨyɨaka,  
\q2 yunaitɨ mepunututuixietɨka.   
\q1
\v 7 Mepaye'axɨa memeuyutakwiwawe wahepaɨ,  
\q2 wapaitɨ mepeutimake kuyaxi wahepaɨ.  
\q1 Yuxexuitɨ mepuhu  
\q2 'aixɨa meteheuku'utɨ kememɨteyu'uitɨakai.   
\q1
\v 8 Yuhetsie mepɨka'uyexɨrɨwe,  
\q2 heitserie mepuhu yuxexuitɨ.  
\q1 'Ɨrɨtsata mekaniuhuni  
\q2 meka'anuyutaxɨrɨwatɨ.   
\q1
\v 9 Kiekaritsie mekanitahakeni,  
\q2 kuraru heima mepeukamake,  
\q1 kiitetsie mepɨtimake,  
\q2 'etsimeuyeyeutsie mepeuhake tenawayamete wahepaɨ.   
\b  
\q1
\v 10 'Ikɨ kuyaxi wahɨxie kwie naitɨ puyuane  
\q2 meta muyuawi pukuyuane,  
\q1 tau meta metseri pɨyɨrixɨani,  
\q2 meta xurawetsixi mepɨtehayewa mehekɨariwietɨ.   
\q1
\v 11 Yawé niukieya kanekutɨrarɨkani  
\q2 yukuyaxima wahɨxie,  
\q1 mepɨkayu'inɨatsinɨa kuyaximama  
\q2 mepɨtɨrɨkawi niukieyatsie yamemɨtekahu.  
\q1 Yawé tukarieya waɨkawa kanimariweni kanimakaxiwani.  
\q2 Xewitɨ pɨkayɨwe mɨtinewirienikɨ.   
\s1 Kememɨte'uta'imaiyarie memɨtehayewakɨ 'axameteyurietɨ  
\q1
\v 12 Yawé mɨpaɨ kanaineni: «Merikɨ,  
\q2 yunaitɨ yu'iyarikɨ nehetsɨa xekeneu'axɨa,  
\q2 xe'utitsuatɨ, xeyuheiwerietɨ xekatekwatɨ».   
\b  
\q1
\v 13 Yu'iyaritsie xekeneuyukatsanani  
\q2 yukamixatsie pɨkatixaɨ.  
\q1 Yawé yukakaɨyari hetsɨa xekeneu'axɨa,  
\q2 mɨkɨ pɨtiuyukanenimaya pɨkahayu'eriya,  
\q1 naki'eriyakɨ pɨhɨne kwitɨwa pɨka'uyeha'arɨwe,  
\q2 pɨyuwaɨriya naime mɨreuyehɨwirienikɨ meta pɨkarakwinitɨani.   
\q1
\v 14 Heiwatɨ Kakaɨyari 'aixɨa mɨtinixe'uxei kemɨtiku'eriwakai mɨnipataxɨ,  
\q2 'aixɨa mɨti'ane mɨtatiniuhayewi.  
\q1 'Imikieri hatsite mɨkɨ meta kaxie winuyari mɨtiyeuriwa  
\q2 Yawé xekakaɨyari hetsɨa katinimiemetɨni.   
\b  
\q1
\v 15 Kerutsaremetsie kuxineta xekeneutahɨtsiwani,  
\q2 xeketeniwarukaxatɨa memɨyuhakienikɨ,  
\q1 xekeniwaruta'ini yunaime 'axeikɨa.   
\q1
\v 16 Kiekatari xekeniwarukuxeɨri,  
\q2 xekenepatsieka xeyuxeɨrietɨ  
\q1 'ukirawetsixi mana kiekatari xekeniwarukuxeɨri,  
\q2 'etsimemupepe meta xekeniwarukuxeɨri  
\q2 meta tɨɨri memɨtsitsewetɨka.  
\q1 Kewayeyani hekwamekɨ mutineɨkixɨ,  
\q2 meta 'uka mɨhekwawikie kewayeyani yukiita.   
\q1
\v 17 Xekeneutitsuanani te'uximayatamete mawari wewiwamete Yawé hetsɨa miemete,  
\q2 tuki mɨranutahakitɨre hɨxie meta mawari taiyame hɨxie xeti'utɨ,  
\q1 mɨpaɨ xe'utiyuatɨ: «Yawé 'ateɨterima ketiniwareuyehɨwirieka.  
\q2 Pepɨkatatsiyetuayani 'axatemɨka'itɨarienikɨ  
\q2 kapa nuiwarite tahetsiemieme 'axame'utiyuanikɨ.  
\q1 Hipatɨ mɨpaɨ memɨka'utiyuanenikɨ teɨteri:  
\q2 “¿Hakewa xekakaɨyari peyeika?”»   
\s1 Yawé kemɨtiwaruta'ei  
\q1
\v 18 Merikɨtsɨ Yawé matsiɨkɨme kanayeitɨani kemɨtinaki'eriekai yukwie hetsiemieme,  
\q2 katiniwareuyehɨwirieni yuteɨterima.   
\p
\v 19 Yawé mɨpaɨ katiniwaruta'eiya:  
\q1 «Neuxei nepɨtixeyetuirieni, hatsite, kaxie winuyari mɨhekwa meta hatseiti,  
\q2 waɨkawa nepɨxetihuxaitɨani 'aixɨa xeteyukuhɨaweme nepɨxehayewa.  
\q1 Nepɨkaxeyetuani tawari  
\q2 hipame kiekarite wahetsɨa xemɨnanaimarienikɨ.   
\b  
\q1
\v 20 »Nepɨkawapitɨani 'utsikari xeyeta 'amemayehu,  
\q2 kwie makumawetsie meta makuwakitsie nepɨwareukɨnɨ'ani:  
\q1 Haramara Mɨmɨkitsie nepɨwakayunitɨani wakuyaxi memanuyetei,  
\q2 wa'utɨmata memuhu Haramara Meritexaniyatsie.  
\q1 Wakaxari pɨtipɨne  
\q2 waɨkawa pɨtiukuri'ɨaka».  
\q1 Yawé waɨkawa mariwemekɨ katiniyurimɨkɨ.   
\q1
\v 21 Nekiekari pepɨkamaka,  
\q2 matsi kene'atemawieka kene'uxipieka,  
\q1 matsi Yawé waɨkawa mariweme katiniyuriemɨkɨ.   
\q1
\v 22 Tewaxi xepɨkamamaka 'ɨtsita xemu'uwa,  
\q2 'ɨxa mumawekaitsie pɨtixuawere naitɨ pɨtiyɨra,  
\q1 'iteɨrite yutakariri mɨtikwaiwa pɨtixuawitɨani,  
\q2 piní meta kaxie waɨkawa pɨtixuawere.   
\q1
\v 23 Xekeneyutemamawieka Tsiyuni tɨɨriyamama,  
\q2 temawierika xekenexeiyani Yawé yukakaɨyari hetsiemieme,  
\q2 kepauka maye'ani wiyeri pukuyuitɨani tukarieyatsie.  
\q1 Wiyeri pɨxehanɨ'airieni  
\q2 xekaka'ewawekaku meta xeka'itsanayu,  
\q2 meripaitɨ manukatɨatsie kemɨtiyurienekai hepaɨ.   
\q1
\v 24 Mɨrati'uritɨretsie tɨriku waɨkawa pɨtixuawere,  
\q2 kaxie mahinarietsie winu mɨhekwa waɨkawa puxuaweni meta hatseiti.   
\q1
\v 25 «Ne nepɨtixekɨhɨwirieni  
\q2 kepaɨmexɨa wiyari xemɨteheuyehɨa naime,  
\q1 'iya kuyaxi memɨyumɨire tekɨmemete wahekɨ  
\q2 kenemɨtiwarenɨ'a xehetsɨa:  
\q1 'amemɨnene, meta yakɨmemɨnene,  
\q2 'etsimemɨpepe meta kwimemɨpepe.   
\q1
\v 26 Xeme waɨkawa xepɨte'utikwa'ani, kexemɨteheukwaikɨ,  
\q2 Yawé yukakaɨyari hetsiemieme 'aixɨa xeputiyuaneni,  
\q1 xehetsiemieme 'aixɨa kemɨtiyurieni.  
\q2 Tawariri hatsuaku neteɨterima nepɨkawatewiyatsitɨani.   
\q1
\v 27 Merikɨte 'ana mɨpaɨ mekatenetimaikuni kename ne 'ixaheritsixi wahamatɨa ne'uyeika,  
\q2 kename ne Yawé xekakaɨyari nehɨkɨ,  
\q2 xewitɨ tawari 'apɨka'uyeika kakaɨyaritɨtɨ ne'aurie.  
\q1 Tawari hatsuaku neteɨterima mepɨkatewiyatsitɨarieni.   
\s1 Yawé tukarieya  
\q1
\v 28 »'Arike mɨpaɨ tiyɨyu,  
\q2 ne'iyari nepɨtatuani yunaime teɨteri wahetsie.  
\q1 Xeme xeniwema 'ukitsi 'ukari mepɨtetaxata,  
\q2 'ukirawetsixi mepɨteheinɨni  
\q2 temarita mepɨtexeiyatsitɨarieni.   
\q1
\v 29 Mɨkɨ tukaritsie ne'iyari nepɨtatuani  
\q2 'ukitsi meta 'ukari te'uximayatamete wahetsie.   
\q1
\v 30 Mɨyuawitsie meta kwiepa 'inɨari nepɨtiyurieni:  
\q2 xuriya, tai, meta kɨtsi 'e'utɨtɨme.   
\q1
\v 31 Tau yɨwitɨ kanayeimɨkɨ  
\q2 metserita xuriyapaɨ 'anetɨ kanayeimɨkɨ  
\q1 mexi Yawé tukarieya kahaye'aweni,  
\q2 kepauka mariwemekɨ mɨtiyurienitsie.   
\q1
\v 32 Yunaitɨ Yawé memahɨawe kemɨtimariwe  
\q2 yutukari mekanitawikweitsitɨakuni,  
\q1 hɨritsie xeikɨa Tsiyuni meta Kerutsaremetsie,  
\q2 pɨyɨweni muyuta'una,  
\q2 Yawé kemɨtiwarutahuawekai.  
\q1 Memayeneniere wahamatɨa  
\q2 xeikɨa mepu'uwani Yawé mɨwaruta'ini.   
\c 3  
\s1 Nuiwarite kememɨte'ukwinitɨarie  
\q1
\v 1 »'Iya tukaritsie, kemɨtika'inɨaritsie maye'anikɨ,  
\q2 kepauka ne Kura 'aixɨa nemɨwayurieni meta Kerutsareme newahekwariyatɨ,   
\q1
\v 2 yunaime nuiwarite nekaniwakuxeɨriemɨkɨ  
\q2 Kutsapati mayeweritsie nekaniwakanɨ'amɨkɨ.  
\q1 Mana nekaneutahamɨkɨ teɨteri nemɨtiwakwinitɨanikɨ  
\q2 neteɨterima 'Ixaheritsixi wahetsiemieme,  
\q1 'ateewa nuiwarite watsata memɨwareutaweiyaxɨakɨ  
\q2 meta nekwie memuyutaxitekiexɨakɨ.   
\q1
\v 3 Neteɨterima mepuyuta'iwiri kemɨ'anetsie mɨtinakenikɨ,  
\q2 tɨɨri mepuwarupataxɨ 'ukari tuminikɨ memɨyuwitɨnɨa wahekɨ,  
\q1 meta memɨtitarɨwenikɨ,  
\q2 'ukari tɨɨrixi winukɨ mepuwarutua.   
\p
\v 4 »Merikɨte, Tiru meta Tsiruni, meta naitsarie mɨtiuyehane Piritsiteu kwieyari hetsie, ¿ketita kuta xetehayexeiya nehetsiemieme? ¿Xenetekɨhɨwirienike xeteyu'erie? Xɨka mɨpaɨ 'aneni, nematsi kwitɨ yanepɨtiyurieni xehetsie mɨtinakenikɨ kexemɨnetsiyuriku,  
\v 5 xemetsɨ nehuru meta nepɨrata xekaniunawani, yutukita paitɨ xekatenetɨni piinite waɨkawa nemɨreuyehɨwa.  
\v 6 Xeme kɨriyekutsixi wahetsɨa neteɨterima xekaniwarutuani Kerutsareme meta Kura memɨtama yukwiepa memɨka'u'uwanikɨ.   
\p
\v 7 »Matsi mɨpaɨ xeketenemaika, ne nepuwarayewitɨni tsepa hakewa paitɨ memetuiyakai, ne yanepɨtiyurieni mɨkɨ 'axakexemɨte'uyuri xehetsie mɨtinakenikɨ.  
\v 8 Xeniwema 'ukitsi 'ukari Kura kiekariyaritsie nepɨwatuani, mɨkɨta yaxeikɨa tsaweutsixi wahetsɨa mekaniwatuakuni nuiwarite 'ateewa kiekatari wahetsɨa». Yawé mɨpaɨ kaniutayɨni.   
\q1
\v 9 Nuiwarite mɨpaɨ xeketeniwarutaxatɨa:  
\q2 Xekeneyuha'aritɨaka xemɨyutakwinikɨ.  
\q1 Kuyaxi xekeniwaxeɨrieka.  
\q2 Xekeneyuha'aritɨaka yunaitɨ 'ukitsi kuyaxa miemete xemuyutakwinikɨ.   
\q1
\v 10 Hatsaruni yu'ixipara xekenayeitɨa  
\q2 meta huxa tɨriku xikame tepɨa 'amɨtewi xekenayeitɨa.  
\q1 Kemɨ'ane meumaka mɨpaɨ ke'utayɨni:  
\q2 «Ne nepɨka'ukama».   
\q1
\v 11 Xeiya xekeneyumexɨitɨaka, nuiwarite xemɨtama ta'aurie,  
\q2 mana xekeneyuxeɨrieka mayeweritsie.  
\b  
\q1 Yawé, keniwaranɨ'a memayu'eririya 'ahetsɨa miemete.   
\b  
\q1
\v 12 «Nuiwarite xekeneyukuxeɨri,  
\q2 xekenehu Kutsapati muyeweri paitɨ,  
\q1 mana nekananukayerɨmɨkɨ  
\q2 teɨteri 'auriena kiekatari nemɨtiwakwinitɨanikɨ.   
\q1
\v 13 Keneukaxitekiri,  
\q2 tɨriku 'aixɨa mɨ'anene kanihɨkɨtɨni.  
\q1 Kaxie xekeneutiketsina,  
\q2 matiketsinarɨwatsie pɨhɨpɨne.  
\q1 Kaxie xariyariri panakayeuriwe:  
\q2 puwaɨkawari 'axakememɨteyurie».   
\b  
\q1
\v 14 Mekaniyɨmɨireni memɨyɨxeɨrie  
\q2 Mayeweri maye'atɨarienitsie.  
\q1 'Ari Yawé tukarieya kanehuraniri  
\q2 Mayeweri maye'atɨarienitsie.   
\q1
\v 15 Tau meta metseri kaniyɨrixɨakuni,  
\q2 xurawetsixi mepɨkahekɨariwieniri.   
\q1
\v 16 Yawé puyutahaxɨatɨani Tsiyunitsie paitɨ,  
\q2 Kerutsareme paitɨ tɨranarieya kani'enieriemɨkɨ,  
\q2 kwie meta muyuawi kanitayuamɨkɨ.  
\q1 Matsi Yawé kemɨ'ane memɨteɨterimama pɨwa'awietani,  
\q2 'ixaheritsixi pɨwatɨrɨkariya.   
\s1 Kakaɨyari yuteɨterima 'aixɨa kemɨwaruyuri  
\q1
\v 17 «Merikɨtsɨ xeme mɨpaɨ xekatenetimaikuni, ne Yawé xekakaɨyari,  
\q2 Tsiyuni nemukakɨ neyemuri mɨpatsietsie.  
\q1 Kerutsareme mɨpatsie kanayeimɨkɨ,  
\q2 tawari 'ateewa kiekatari waɨriyarika mepɨkawatahaxɨani mexenawairienike.   
\b  
\q1
\v 18 »'Iya tukaritsie kaxie winuyari makaka hɨritsie panexɨani,  
\q2 yemuritetsie retsi puhapaneni.  
\q2 Haa puwayenexɨani 'akite manuyehapanetsie kura kwieyaritsie.  
\q1 Yawé tukieyata haixa pɨtineikani,  
\q2 'Akatsiya kɨyeyari pɨhatuiyani mayeweritsie mɨye'u.   
\q1
\v 19 'Ekipitu naime nepɨrakumaweriya,  
\q2 'Erumi makumawe nepayeitɨani,  
\q1 'axamemɨwaruyurikɨ Kura kwieyaritsie kiekatari,  
\q2 wakwiepa waxuriya memutayeurikɨ 'atsimekateyuriekame.   
\q1
\v 20 Kura kwieyaritsie meta Kerutsaremetsie kiepa payani yuheyemekɨ,  
\q2 yunaime nuiwari 'umemahu wahetsiemieme.   
\q1
\v 21 ¿Kamɨtsɨ netiwareuyehɨwirieni xuriya memutayeuri?  
\q2 Matsi hawaikɨ nepɨkatiwareuyehɨwirieni».   
\b  
\qc Yawé Tsiyunitsie 'ukaitɨ kanayeimɨkɨ.  