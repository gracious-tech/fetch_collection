\id HAB  
\h 'Awakuxi 
\toc1 'Awakuki 
\toc2 'Awakuki 
\toc3 'Awa 
\mt1 'Awakuxi  
\c 1  
\p
\v 1 'Ikɨ kemɨtiyɨni niukiyari kanihɨkɨtɨni 'Awakuxi Kakaɨyari niukameya kemɨtiunieritɨarie.   
\s1 'Awakuxi Kakaɨyari kemɨtiutahɨawixɨ  
\q1
\v 2 Yawé, ne'utahiwatɨ parewiya nepɨmatsiwawirie,  
\q2 peru 'ekɨ pepɨkanetsi'enie,  
\q1 ¿Kepaukakeri pepɨnetsihanu'enieni?  
\q2 Waɨkawamekɨ nepɨmatsiwawiriekai mukumawerekɨ ketemɨtenanaimarie, peru 'ekɨ 'atsipepɨkara'eriwa.   
\q1
\v 3 ¿Titayari penetixeiyatsitɨa hipatɨ kememɨtenanaimarie?  
\q2 ¿Titayari netiwaxeiyani hipatɨ kememɨtehiweritɨarie?  
\q1 Naitsarie nepɨtixeiya kememɨteyuka'una meta kememɨteyunanaima,  
\q2 kememɨteyukwitɨwe meta kememɨte'ayuye'unie.   
\q1
\v 4 Nixewitɨ 'a'aitsika hetsie yapɨkatikamie  
\q2 meta nixewitɨ kemɨtiheitserie yapɨkatikamie yu'iwa hetsɨa.  
\q1 'Axamemɨte'u'iyari kemɨtiheitserie memɨte'u'uwa mekaniwananaimaka,  
\q2 meta 'itsɨkame kemɨtiheitserie yapɨka'utaine.   
\s1 Yawé kemɨtiuta'a  
\q1
\v 5 «Xekeniwaruxeiya nuiwarite.  
\q2 Kwixekeniwaruxeiya meta xemamatɨ xekeneuyuhayewa.  
\q1 'Ikɨ tukariyaritetsie yanepɨtiyurixime tixaɨtɨ yaxemɨkateha'eriwa  
\q2 tsepa xewitɨ mɨpaɨ mɨtixe'uxatɨa yuri xepɨkate'erieka.   
\q1
\v 6 Karireutsixi nekaniwayuitɨamɨkɨ,  
\q2 mɨkɨ teɨteri memayu'eririya memɨhɨkɨ meta memɨtɨrɨkawi,  
\q1 naitsarie kwiepa memuku'uwa  
\q2 hipame wakwie yuhetsiemieme meyeitɨakutɨ.   
\q1
\v 7 Mɨkɨ teɨteri mepɨmamariwawe meta mepɨmakaxiwa,  
\q2 yu'inɨari niukiyaritsie xeikɨa yamekatenikahuni.   
\q1
\v 8 Wakawayutsixi tɨwexi wareuyeta mepayɨwawe,  
\q2 'ɨrawetsixi tɨkakɨta miemete wareuyeta mepɨte'u'iyari.  
\q1 Kawayutsixi wahetsie me'utetɨ yumɨiretɨ meputinanautsa,  
\q2 memutei 'atewapaitɨ mepaneika.  
\q2 Wirɨkɨxi kememɨte'uxɨrɨwe memɨtetakwanitsie mɨpaɨ mekateniyumateni.   
\q1
\v 9 Mekani'axɨakuni naime meteye'unarɨmetɨ,  
\q2 memɨyehunitsie marika puxuaweni,  
\q2 memɨwaranutaxɨrɨwa xiekari mɨranukutuiwa hepaɨ mekateniwaruxexeɨriwani.   
\q1
\v 10 Te'aitamete mekaniwatewiyatsitɨaka,  
\q2 kuwexinaruritsixi mekaniwananaimaka,  
\q1 mekaniutinaweni kiekari yukuraru 'amatitetewa memexeiyatɨka wahepaɨtsita,  
\q2 xiekari 'imɨmɨiyari mekaniutiwewiwani, hikɨ kiekaritsie mekaneutahakeni.   
\q1
\v 11 'Eka naime mɨtiye'unatɨyeika hepaɨ mekani'aneni,  
\q2 peru waɨkawa 'axamekateniuyurieni, yutɨrɨkariyatɨme yukakaɨyari memayeitɨakɨ».   
\s1 Hutarieka 'Awakuxi Kakaɨyari kemɨtiutahɨawixɨ  
\q1
\v 12 'Ekɨ, Yawé, yuheyemekɨ 'apekaniuyeikani.  
\q2 'Ekɨ, nekakaɨyari pemɨpatsie, hatsuakutɨma pemɨkamɨwe pekanihɨkɨtɨni.  
\q1 'Ekɨ, Yawé, kemɨtiheitserie memɨteyurienikɨ pepɨwa'atɨani,  
\q2 'ekɨ, ne'ai, pekaniwa'atɨamɨkɨ memɨtatsi'ayemari'itɨanikɨ.   
\q1
\v 13 'Ahɨxite yemekɨ pɨ'itiyatɨka 'axamɨti'ane pepɨkareuxeiyawe,  
\q2 pepɨkayɨwe pemɨwaxeiyani hipatɨ menanaimariekaku.  
\q1 ¿Titayari kamɨtsɨ 'axamemɨte'u'iyari 'atsipekatiwayuriwe?  
\q2 ¿Titayari kayuwatɨ petiuma  
\q2 mexi 'axamemɨte'u'iyari 'aixɨa memɨte'u'uwa mewakwa'a?   
\q1
\v 14 Teɨteri tsapari haramaratsie memɨye'uwa pepɨwarayeitɨa,  
\q2 kwiepa yuhukama memɨteku'uwa memɨkatehekakutsiyari pepɨwarayeitɨa.   
\q1
\v 15 Wawiruniya yukwaitsɨkɨ yunaime kaniwaranatihapanani,  
\q2 yuwipitekɨ yunaime kaniwakuyuruwani,  
\q1 yu'ataxayakɨ kaniwaranatitutuweni,  
\q2 mɨpaɨ meteyurietɨ mekaniyutemamawieka.   
\q1
\v 16 'Ayumieme wawiruniyutsixi yu'ixiparate yukakaɨyari mekanayeitɨwani,  
\q2 meta mekaniwarayexeiyani.  
\q1 'Ixiparate waparewiekaku  
\q2 waɨkawa xikutsixi mekanayexɨrieni.   
\q1
\v 17 ¿Kamɨtsɨ petiwapitɨaka yuheyemekɨ mɨpaɨ memɨteyurieka?  
\q2 ¿Yuheyemekɨ metehayu'iwani hipame wakiekaritsie metahaketɨ mewakwitɨ mekawanenimayatɨ?   
\b  
\c 2  
\q1
\v 1 Netanieretɨ nekaniyuhayewamɨkɨ,  
\q2 wapaitɨ nenieremetsie ne'akakaitɨ,  
\q1 nepɨta'ikwewani kemɨnetitahɨawe,  
\q2 kemɨnetita'eiya mɨyanemɨtitahɨawixɨkɨ.   
\s1 Yawé kemɨtiuta'a  
\p
\v 2 Hikɨ Yawé mɨpaɨ kanetiniuta'eiya:  
\q1 «Kepemɨtiunierixɨ ketinaka'utɨa,  
\q2 yuhekɨakamekɨ haxu 'etsitsutsuimetsie  
\q2 para xeiya mekaterɨwa mɨyɨwenikɨ.   
\q1
\v 3 Karikɨ kepemɨtiunierixɨ yakatiniyɨmɨkɨ yemekɨ kepauka tukaritsie yamɨtiyɨnikekai,  
\q2 tukari kaniyemieni maye'anikɨ, mɨkɨ tukari pɨkahayewarieni mɨka'aye'anikɨ.  
\q1 Tsepanetɨ 'amɨreɨtewini yakatiyɨwetɨ, keneta'ikwewani,  
\q2 mɨkɨ tukari kanaye'amɨkɨ kahauyewekamekɨ.   
\b  
\q1
\v 4 »Memuyuti'ɨre 'iyari heitseriekame mepɨkahexeiya,  
\q2 peru kemɨtiheitserie 'amuyeika yuri mɨti'eriekɨ payeyurini.   
\q1
\v 5 Matsi, xikutɨriya pɨtiyu'itaiya,  
\q2 'ayumieme memuyuti'ɨre 'amepɨkateheutere.  
\q1 Yukɨipitsie 'emepanatiyeyeure, mɨki teukiya hepaɨ,  
\q2 meta mepɨkahuxaiwawe mɨki yɨwikame hepaɨ.  
\q1 Yu'aurie yunaime nuiwarite mekaniwarukuxexeɨriwani  
\q2 meta yunaime teɨteri mekaniwarehapanani.   
\q1
\v 6 Peru mɨkɨ hatsuakutɨni tixaɨtɨ mepɨkatehayeitɨarieni.  
\q2 Nuiwarite mepɨwatinanaimani hikɨ 'ikɨ kwikari wahetsiemieme mepɨtakwika:  
\b  
\q1 »Xɨa'ui waɨkawa rexeiyatɨ mayuyeitɨa hipame tiwapiinitekɨ,  
\q2 meta piinitɨarika waɨkawa mɨtiukuxeɨri 'itarikakɨ.  
\q2 ¿Kepaukakeri pɨtihayewa mɨyatiyurienetɨ?   
\q1
\v 7 Yapauka mekananuku'uikuni memɨmetehapinirie.  
\q2 Memetsi'aye'unietɨ mekanakɨnikuni tinaime mekameteninawairiekuni tita pemɨrexeiya,  
\q2 mexi 'ekɨ pe'uyɨyɨakani pekatɨrɨkaɨyetɨ.   
\q1
\v 8 Nuiwarite mekaniyumɨireni pemɨtiwarunawatsiri,  
\q2 keyupaɨmetɨ teɨteri memɨyutawikweitsitɨani mɨkɨta mepɨmetenawatsirieni,  
\q1 mɨmɨirekɨ xuriya pemutayeuri,  
\q2 meta 'ikɨ kwie hetsie waɨkawamekɨ pemɨtiunanaimakɨ,  
\q2 meta 'ikɨ kiekari hetsie meta mana kiekatari pemɨwarunanaimakɨ.   
\b  
\q1
\v 9 »Xɨa'ui kemɨ'ane yukiita mɨtihɨniya kwamanarikakɨ rana'iwaka  
\q2 yuniwema watawikweitsitɨanike  
\q2 wahetsie mɨkatinakenikɨ 'axamɨti'ane.   
\b  
\q1
\v 10 »Kepemɨtiu'eri 'akie kiekatari pepɨwarutewiyatsitɨa xeikɨa:  
\q2 yumɨireme nuiwarite pepɨwareuyehɨa,  
\q2 peru 'ekɨtɨtɨ pepɨ'ayuri.   
\q1
\v 11 'Ayumieme tetexitɨtɨ kuraru 'amatayewa hetsiemiemete mepahiwatɨka,  
\q2 meta kii pikaxiyaritetsie puwa'eiya wahiwari.   
\b  
\q1
\v 12 »Xɨa'ui kemɨ'ane kiekari mutawewiwa hipame wakwitɨ  
\q2 meta kemɨ'ane kiekari mukama hipame wananaimatɨ.   
\q1
\v 13 Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni,  
\q2 teɨteri tai hetsiemieme mekete'uximayaka  
\q2 meta nuiwarite yakɨ xeikɨa meketeyu'uxitɨaka.   
\q1
\v 14 Haa haramara kemɨranukanama hepaɨ,  
\q2 mɨpaɨta kwie hetsie mekateniyɨkuni  
\q2 teɨteri Yawé tɨrɨkariyaya memaitɨ.   
\b  
\q1
\v 15 »Xɨa'ui 'ekɨ, 'a'iwa pemutitawaitɨwa.  
\q2 Xɨa'ui 'ekɨ, winukɨ pemititawaitɨwa  
\q2 waiyarieya maweme pexeiyamɨtɨ.   
\q1
\v 16 Mɨkɨkɨ pepɨtewiyatsitɨarieni pɨta, hawaikɨ witsipepɨkatixeiyarieni.  
\q2 Kamɨtsɨ 'ekɨta kenanu'i, pemɨwaxeitsitɨanikɨ xitekiya 'inɨariyari kepemɨkarexeiya.  
\q1 Yawé yutekɨxi yutseriekɨ mehana 'ahetsie ke'itiyeurieni,  
\q2 meta witsikepemɨtixeiyariekai hetsiemieme, tewiyarika kematsi'upitɨani.   
\q1
\v 17 Riwanu hepaɨtsita kepemɨtiunanaima mɨkɨta kematsi'utapɨna.  
\q2 Tewaxi kepemɨtiwareuyehɨa mɨpaɨta peketiuka'unarieni.  
\q1 Karikɨ kanimɨireni xuriya pemitayeuri,  
\q2 meta pɨwaɨkawa 'ikɨ kwie hepaɨtsita kepemɨtiunanaima,  
\q2 meta 'ikɨ kiekari hetsie meta teɨterimama.   
\b  
\q1
\v 18 »¿Tita tiyunaki'erie kakaɨyari mɨwewiya,  
\q2 kemɨ'ane mitawewi tewi kɨyekɨ tiwewiwame xɨka hɨkɨtɨni?  
\q1 ¿Tita tiyunaki'erie kakaɨyari mukwaxiyarie,  
\q2 'itarika xeikɨa mɨti'ɨkita?  
\q1 Tiwewiwame kakaɨyarixi mɨwawewie mekaniuwaweme  
\q2 mɨkɨ xeikɨa yuri katini'erieka yuwewiyatsie.   
\q1
\v 19 Xɨa'ui kemɨ'ane kɨye mɨpaɨ mɨtikɨhɨawe: “Kenanutanieri”,  
\q2 meta tete mɨkaniuwe: “Kenanukukexi”.  
\q1 Tsepanetɨ huru meta pɨrata memɨkawiriyarietɨka,  
\q2 tixaɨtɨ memɨxete'uta'ɨkitɨani mepɨkayɨwawe,  
\q2 memɨkahayeyuyurikɨ.   
\q1
\v 20 Peru, Yawé yutuki muyepatsieta kanayekani,  
\q2 naitsarie kwiepa mɨtiuyehane hɨxiena kayuwatɨ meke'umaka».   
\c 3  
\s1 'Awakuxi kemɨtiyutanenewi  
\p
\v 1 'Awakuxi Kakaɨyari niukameya nenewierieya. Mɨpaɨ katiniukwikarieni.   
\q1
\v 2 Yawé, ke'aixɨa pemɨtikuxaxatsiwa nekatinimarieka,  
\q2 tita pemɨtiutiwewi, Yawé, mɨkɨkɨ nepɨma.  
\q1 Hikɨta yaketineuyuri hekwamekɨ tame te'u'uwakaku,  
\q2 hikɨta tahetsiemieme yaketineuyuri temixeiyakɨ,  
\q2 'ahaxɨatsie, kepemɨti'akanenimaya kena'eriwani.   
\b  
\q1
\v 3 Kakaɨyari Temani mɨrayetewatsie kanayemieni,  
\q2 Parani hɨriyaritsie Mɨpatsie kanakamieni.  
\qr \qs Tepɨ'uxipieni\qs*  
\q1 Xawatɨriyayakɨ muyuawitsie naitɨ puxawatɨ  
\q2 meta kwiepa naitsarie 'aixɨa pɨrahɨawarɨwa.   
\q1
\v 4 Xawatɨriyaya merɨkariya hepaɨ pɨtiyuxexeiya,  
\q2 mamateyatsie mimierɨkari kaneuneikatɨkani,  
\q2 mɨkɨ warita tɨrɨkariyaya kaniyu'awietani.   
\q1
\v 5 Kwiniya mɨyatɨ hɨxiena kananuyekani,  
\q2 tai kaniweiyani 'utɨmana.   
\q1
\v 6 Kepauka muwakeka, kwie kaniutimamaweni,  
\q2 kepauka mɨtaneniere, nuiwarite mekaniutiyɨyɨakani.  
\q1 Meripaitɨ mieme hɨrite kanikapenikeni  
\q2 meta yemurite meripaitɨ miemete kanati'unikeni,  
\q2 matsi Kakaɨyari huyeteya yuheyemekɨ 'atsipɨkayɨwe.   
\q1
\v 7 Nekaniwaxeiyani meyuhiweriekame Kutsani mɨrakutewa memɨkutei,  
\q2 meta Mariyani memɨkutei mekaniuyɨyɨakatɨkani.   
\b  
\q1
\v 8 ¿Petiha'akai, Yawé, kepauka pemiwa hatɨate?  
\q2 ¿Petiha'akai haa mɨtɨrɨkawi hepaɨtsita?  
\q1 ¿Waɨkawa petiha'akai haramara hepaɨtsita  
\q2 'ayumieme 'akawayutsixi wahetsie peranutiya,  
\q2 meta 'akaxetate kuyaxa miemete memɨtehayu'iwa wahetsie?   
\q1
\v 9 'Atupi 'ari pepuhekɨataxɨ,  
\q2 'ɨrɨ peputahɨniyaxɨ 'i'uitɨwameta. \qs Tepɨ'uxipieni\qs*  
\q1 Kwie hetsie hatɨate pekaniukatuani,   
\q2
\v 10 hɨrite mematsixeiyatɨ mekaniutimamani.  
\q1 Waɨkawa wiyeri 'ekamatɨ kaniukaxɨrieni,  
\q2 meta hamewari 'amatiyewatsie mieme kaniuyutihaxɨatɨwani, hamewariyari 'anenetɨ muyuawitsie paitɨ kaneutimemeni.   
\q1
\v 11 Tau meta metseri matɨa muyuawitsie kanewa'uweni,  
\q2 'a'ɨrɨte kwinie mayɨwawe xawatɨriyayakɨ,  
\q2 'apitsika 'amɨtewi xawatɨriyayakɨ.   
\q1
\v 12 Peha'atɨ, naitsarie kwiepa pekaniuyeikani,  
\q2 waɨkawa peha'atɨ, nuiwarite pekaniwatipɨnani.   
\b  
\q1
\v 13 Pekanayeyani 'ateɨterima pewaxɨnake,  
\q2 pekanayeyani pemenayexei 'ahetsiemieme petawikweitsitɨanike.  
\q1 Ti'aitame pekaniutapɨna 'axateyuruwamete wanuiwari mɨhɨkɨtɨkai,  
\q2 maweme pekaniuhayewa 'ɨkateyatsie katsutɨme mu'uyatsie 'u'akame. \qs Tepɨ'uxipieni\qs*   
\q1
\v 14 'Apitsika 'amɨtewikɨ kuyaximama wamu'ute pekananutixɨriexɨani,  
\q2 meha'atɨ mekatanitaxɨriexɨakukaitɨni,  
\q1 meyutemamawietɨ tahetsie kwinie netɨ mekaniukeni,  
\q2 mɨkayuhɨawexɨa kemɨ'itɨariwa hepaɨ.   
\q1
\v 15 Haramara pekaniutaketsini 'akawayutsixi wahekɨ,  
\q2 pewatayuitɨwatɨ haa mɨmariwe.   
\b  
\q1
\v 16 Kepauka 'ikɨ nemɨtiu'eni, netaɨta nekaniutimani,  
\q2 niukieyakɨ, netenite kaniutiyɨyɨaka,  
\q1 ne'umete mutikwaire hepaɨ nepɨreka'erietɨya,  
\q2 meta ne'ɨkate putiweranaxɨa.  
\q1 Peru ne netiukanewietɨ nekanita'ikwewani  
\q2 kepauka 'uximatɨarika tukari  
\q2 munuani 'iya nuiwari wahetsie hikɨ memɨtatsika'una.   
\q1
\v 17 Tsepanetɨ xapa mɨka'ukaxutuwe,  
\q2 meta tsepa kaxie takari mɨka'ukayaxikeni,  
\q1 tsepa huriwu takari mɨkatiukaxuawerixɨ,  
\q2 meta kwiepa tsepa 'ikwaxite mɨkatiutixuawerixɨ,  
\q1 tsepanetɨ muxatsi kuraruta memuyemaweni,  
\q2 meta tsepa kuraruta nixewitɨ tewa mɨkayeyeika,   
\q1
\v 18 tsepanetɨ mɨpaɨ mɨti'ane, ne Yawé hetsie nekaniyutemawiekamɨkɨ,  
\q2 nepɨnetemawieka Kakaɨyari hetsie netiwiyatɨ, netsiwikweitsitɨwame.   
\b  
\q1
\v 19 Yawé naimekɨmɨyɨwe netɨrɨkariya kanihɨkɨtɨni,  
\q2 maxa kemayɨwe mɨpaɨ ne'ɨkate katinipitɨaka  
\q2 meta 'ameutitewatsie paitɨ ne'uyeikame kanenayeitɨwani.   
\b  
\qc \it Teyuitɨwamete wa'ukiyari. 'Ikɨ kanaritekɨ ke'utakwikarieni.\it*  