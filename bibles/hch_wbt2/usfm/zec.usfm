\id ZEC  
\h Tsakariyaxi 
\toc1 Tsakariyaxi 
\toc2 Tsakariyaxi 
\toc3 Tsak 
\mt1 Tsakariyaxi  
\c 1  
\s1 Kememɨte'utahɨawarie Yawé hetsie memɨtewiyakɨ  
\p
\v 1 Merikɨtsɨ 'atahairieka metseriyaritsie, meta hutarieka wiyaritsie Raríyu ti'aitakaku, 'ana Yawé Tsakariyaxi kaniutahɨawe, Werekiyaxi nu'aya meta 'Iru teukarieya, mɨpaɨ katinitahɨawe:   
\p
\v 2 «Yawé kaniha'aka meripaitɨ kiekatari xetutsima wahepaɨtsita.  
\v 3 'Ayumieme, mɨpaɨ ketiniwarayehɨtɨa yunaime teɨteri, mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:  
\q1 »“Nehetsɨa xekeneu'axɨa,  
\q2 neta xehetsɨa nepunuani  
\qr —Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni—.   
\b  
\q1
\v 4 »”Xetutsima kememɨ'anenekai wahepaɨ xepɨka'aneneni,  
\q2 mɨpaɨ memɨtewakuxaxatɨwakai  
\q2 Kakaɨyari niukametemama meripai miemetexi,  
\q1 mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:  
\q2 ‘'Axaxete'u'iyaritɨ xeketeneuhayewa  
\q2 meta 'axaxeteyurietɨ.’  
\q1 Merikɨte kenemainekai mɨkɨ yamepɨkatekakɨ  
\q2 meta mepɨkanetsi'u'eni  
\qr —mɨpaɨ kanaineni Yawé—.   
\b  
\q1
\v 5 »”¿Hakewa mepe'uwa xetutsima?  
\q2 ¿Kakaɨyari niukametemamata mete'ayeyuyuri?   
\q1
\v 6 ¿Kamɨtsɨ karaye'atɨarie xetutsima wahetsie  
\q2 niuki meta 'aitsikate  
\q1 nemɨwarupitɨa menete'uximayatsiriwamete neniukamete  
\q2 mɨpaɨ memɨtewataxatɨanikɨ?  
\p »”Hikɨ mɨkɨ Yawé hetsie metewiyatɨ mekanakɨne, meta mɨpaɨ mekaniutiyuani: ‘Yawé Naimekɨmɨtɨrɨkaɨye yapɨtatsi'uyuri kemɨtiu'eri: tahetsie kemɨreuyewekai 'axatete'u'iyarikaku 'axateteyuriekaku.’”»   
\s1 Tewi tsikwaitsata  
\p
\v 7 Hutarieka wiyaritsie ti'aitakaku Raríyu, xeitewiyari heimana naurieka tukaritsie \it tsewati\it* metseriyaritsie, tamamata heimana xewi metseriyari mɨhɨkɨ, 'ana Yawé Tsakariyaxi kaniutahɨawe, Werekiyaxi nu'aya 'Iru teukarieya:  
\v 8 Xeitɨkaritsie mɨpaɨ nepɨtiunierixɨ, tewi nepuxei kawayutsie 'anakaime heukɨtaxaɨyemetsie. Mɨkɨ tewi tsikwaitsata kaniyekeni 'etsiwa heukatewakaku 'aki 'utɨma. Waritanata mepɨti'ukai meheukɨtaxawimetsie me'utetɨ meta meheutɨtɨnimetsie meta meheutuxametsie.  
\v 9 Ne 'ipaɨ nepɨtita'iwawiyaxɨ: «¿Neti'aitɨwame, 'ikɨri ketita mete'inɨariyari kawayutsixi wahetsie memutei?» Nehamatɨa mɨtikuxatakai niuki tuayame, mɨpaɨ kanetiniuta'eiya: «Nepɨmatitaxatɨani ketita memɨte'inɨariyarite».  
\v 10 Hikɨ tewi tsikwaitsata muwekai pɨta mɨpaɨ kanetiniutahɨawe: «Yawé kaniwareyenɨ'ani 'ikɨ kawayutsixi wahetsie memutei, naitsarie kwiepa memakunierekɨ».   
\p
\v 11 Merikɨte mɨkɨ memutekai Yawé niuki tuayameya tsikwai tsata muwekai, mɨpaɨ mekateniutahɨawe: «Naitsarie tepukexiyaxɨri kwiepa. Yurikɨ yemekɨ naitsarie kayuwatɨ kaniumaka».  
\v 12 Mɨpaɨ me'utiyuaku, niuki tuayame Yawé hetsɨa mieme, mɨpaɨ kaniutayɨni: «Yawé Naimekɨpemɨtɨrɨkaɨye, ¿kepaukake 'aixɨa pepɨtixeiya Kerutsareme meta Kura kiekariteyari, pemɨwaheka haika tewiyari heimana tamamata wiyari?»   
\p
\v 13 Niuki tuayame nehamatɨa mɨtikuxatakai Yawé kanita'eiya niuki 'aixɨa 'anemekɨ meta kayuwatɨ tiyupitɨwamekɨ,  
\v 14 'ariketa niuki tuayame mɨpaɨ kanetiniutahɨawe: «Karima 'ikɨ niuki keneutaxata Yawé Naimekɨmɨtɨrɨkaɨye hetsɨa mieme:  
\q1 »“Neminaki'eriekɨ Kerutsareme meta Tsiyuni  
\q2 wahetsiemieme nepɨ'ɨtetsa.   
\q1
\v 15 Matsi pɨta, waɨkawamekɨ nepɨha'a  
\q2 'iya nuiwarite memuyutemamawie wahetsiemieme.  
\q1 Kepauka nemuyeha'a kwinimiemetɨtɨ nepɨkatiha'akai,  
\q2 peru matsi mɨkɨ kwinimieme mepɨte'ikwinitɨa”.   
\b  
\q1
\v 16 »Peru hikɨ, mɨpaɨ kanaineni Yawé:  
\q2 “Tawarita 'ari nekanitinenimayatamɨkɨ Kerutsareme.  
\q1 Mana tawari netuki kananukuketɨariemɨkɨ,  
\q2 hikɨ kii wewiwame ti'inɨnɨatameya kanitahaniemɨkɨ,  
\qr mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye”.   
\p
\v 17 »Tawarita 'ikɨ karima ketineutaxata, Yawé Naimekɨmɨtɨrɨkaɨye hetsiemieme:  
\q1 »“Tawarita nekiekarite ranayuhayewame pɨrexeiyani 'aixɨa mɨti'ane,  
\q2 tawarita Yawé Tsiyuni pɨnɨtɨani,  
\q2 tawarita Kerutsareme panayexeiya”».   
\p
\v 18 Hikɨ kepauka nemeutanierixɨa, nehɨxie nauka 'awayari nekaniuxeiya.  
\v 19 Hikɨ nenita'iwawiya niuki tuayame nehamatɨa mɨtikuxatakai: «¿'Ikɨ 'awate ketita ti'inɨariyarite?» Niuki tuayame mɨpaɨ kanetiniuta'eiya: «'Ikɨ 'awate tɨrɨkariyate kanihɨkɨtɨni kɨmana Kuratsie kiekatari, 'ixaheritsixi meta Kerutsaremetari memeutaweiyariexɨa».   
\p
\v 20 Hikɨ 'arike Yawé kaneniuxeiyatsitɨanita yunaukame tepɨa tsunamete.  
\v 21 Mɨpaɨ nekatinita'iwawiya «¿'Ikɨta kemetekuyurie?» Hikɨ Yawé mɨpaɨ kanetiniuta'eiya: «'Ikɨ 'awate kaniwa'inɨaritɨni nuiwarite yutɨrɨkariyakɨ Kura nuiwarimama memɨwareutaweiyaxɨa, 'ana nitɨma mepɨka'uyɨwekaxɨa xewitɨ mɨyukɨhɨanikɨ. 'Ikɨta tepɨa tsunamete mepu'axɨa mɨkɨ memɨwatimariutakɨ yemekɨ, watɨrɨkariya memɨwanawairienikɨ kemɨ'ane nuiwarite Kura kwieyaritsie memɨtahaxɨa mana kiekatari memɨwareutaweiyaxɨa».   
\c 2  
\s1 Tewi ti'inɨnɨatame mahurie  
\p
\v 1 Kepauka nemanukunierixɨta, xeimeta tewi nekaniuxeiya ti'inɨnɨatame 'ahuriekame.  
\v 2 Ne nekanita'iwawiya: «¿Hakewa pepeutɨa?» Mɨkɨ mɨpaɨ kanetiniuta'eiya: «Kerutsareme nekaneu'inɨatamieni. Nepɨtimaimɨkɨ kehatayewa meta kehayetewi».   
\p
\v 3 Niuki tuayame pɨyemieximekairi nehamatɨa mɨtikuxatakai, yapauka xewitɨta niuki tuayame punua hetsɨana.  
\v 4 Mɨpaɨ katinitahɨawe: «Yapauka mɨkɨ temaikɨ 'ipaɨ ketineutaxatɨa:  
\q1 »“Kerutsareme kiekariyaritsie waɨkawa teɨteri mepuxuaweni,  
\q2 meta tewaxi waɨkawa mepuxuaweni,  
\q1 'ayumieme Kerutsareme  
\q2 yukuraru kahexeiyatɨ payani.   
\q1
\v 5 Hikɨ kiekari warita —Yawé mɨpaɨ paine—  
\q2 tai kuraruyari nepɨhɨkɨtɨni,  
\q1 meta kiekari taɨta  
\q2 nepitahɨniya waɨkawa 'aixɨa mɨti'anekɨ”.   
\b  
\q1
\v 6 »Xekenayekɨni, xekenayekɨni.  
\q2 Xekeneuyuta'una mɨkɨ kiekari tayeta mukumatsie  
\qr —Yawé mɨpaɨ kanaineni—.  
\b  
\q1 »Ne nepɨtiuyuri nemɨxeheutaxɨriexɨa  
\q2 nauka 'ekayarikɨ mɨyuawitsie miemekɨ  
\qr —mɨpaɨ kanaineni Yawé—.   
\p
\v 7 »Xeme Tsiyunitari, Wawiruniya xemu'uwa xekenayekɨni mana, xekeneyuta'una».  
\v 8 Karikɨ Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni, mɨnetsiheyenɨ'a 'iya nuiwarite naime memɨxete'unawairi wahetsɨa:  
\q1 «Kemɨ'ane teɨteri neteɨterima memɨwa'uximatɨa,  
\q2 nehɨxita memeumemeni hepaɨ mekaniyɨaka.   
\q1
\v 9 Ne nepɨyeha'ani mɨkɨ teɨteri wahepaɨtsita,  
\q2 hikɨ waɨriyarika tewa'uximayatsiriwametetɨtɨ mepɨtewanawatsirieni wapiinite.  
\p »'Ana mɨpaɨ mekatenetimaikuni kename Yawé Naimekɨmɨtɨrɨkaɨye netsiheyenɨ'a.   
\q1
\v 10 »Xekeneutihiwani temawierikakɨ, Tsiyunitari.  
\q2 Ne nekaninuamɨkɨ xehamatɨa ne'ukaitɨ nekanayeimɨkɨ  
\qr —Yawé mɨpaɨ kanaineni—.   
\b  
\q1
\v 11 »Mɨkɨ tukaritsie,  
\q2 yuwaɨkawatɨ nuiwarite Yawé mekanitinɨikuni.  
\q1 Mɨkɨ neteɨterima mepakɨne,  
\q2 neta watsata nepuyeikani.  
\p »'Ana mɨpaɨ xekatenetimaikuni kename Yawé Naimekɨmɨtɨrɨkaɨye hɨkɨ mɨnetsiheyenɨ'a xehetsɨa.  
\v 12 Tawarita Kura kwieyari Yawé yuhetsiemieme payeitɨani, kwieya mɨpatsie, meta tawarita Kerutsareme panayexeiya.  
\v 13 Yunaitɨ kwiepa xemɨtama kayuwatɨ xekeneumaka Yawé hɨxie, 'ariri kanayeyani muyuawitsie yukii mupatsieta tahetsɨa nuanike».   
\c 3  
\s1 Mawari wewiwamete tiwa'aitɨwame 'ixurikiteya mɨ'e'ekwi  
\p
\v 1 Hikɨ kaneniuxeiyatsitɨani Kutsuhexi, mawari wewiwamete tiwa'aitɨwame pɨhɨkɨtɨkai, Yawé niuki tuayameya hɨxie 'apuwekai, meta Kauyumarie nepuxei tserietana 'utiweme, 'ixanetamɨtɨ.  
\v 2 Niuki tuayame Yawé hetsɨa mieme Kauyumarie mɨpaɨ katiniutahɨawe:  
\q1 «Yawé kemetsi'utatieni,  
\q2 Kerutsareme manayexei.  
\q2 Yawé kematsi'utatieni, Kauyumarie.  
\q1 'Ikɨ tewi kɨye taxɨximetɨ  
\q2 taipa manayehanie hepaɨ kaniuyɨni».   
\p
\v 3 Kutsuhexi yukemari tɨtɨnime 'anakatɨtɨ niuki tuayame hɨxie puwekai.  
\v 4 Hikɨ mɨpaɨ niuki tuayame katiniwarutahɨawe mana memɨti'ukai, me'iparewikutɨ: «Xekenanutihɨniri kemariteya mɨtɨtɨni». Hikɨ Kutsuhexi mɨpaɨta katiniutahɨawe: «Mɨpaɨ ketinemaika, tita 'axapemɨtiuyuri 'ari nekamatinanuyeitɨirieni, 'ayumieme hikɨri 'ixurikite nekamenanakatɨtɨamɨkɨ witsimɨ'anene».   
\p
\v 5 Hikɨ neta mɨpaɨ nekaniutayɨni: «Mukuretsi xekenanutiketsirita mɨ'itiya». Hikɨ mekanenutiketsirieni mukuretsi mɨ'itiya meta mekanitikemaritɨani, mexi niuki tuayame Yawé hetsɨa mieme mana 'uwekai.  
\v 6 Hikɨ niuki tuayame Yawé hetsɨa mieme Kutsuhexi mɨpaɨ katinayehɨtɨani:  
\v 7 «Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:  
\q1 »“Xɨka ne'aitsikatetsie yapetikamieni,  
\q2 meta xɨka mawari wewiwame pehɨkɨtɨtɨ peraye'atɨani,  
\q1 hikɨ 'ana netukita pepɨtita'aita  
\q2 meta netakwa hepaɨtsita mieme pepɨti'ɨwiyani.  
\q1 Ne 'ena tixaɨtɨ nepɨmatihɨritɨani  
\q2 'ena memu'uwa 'ikɨ wahamatɨa.   
\b  
\q1
\v 8 »”Kutsuhexi, keneneu'eni, mawari wewiwamete tiwa'aitɨwame,  
\q2 meta 'a'iwama meke'u'enanani,  
\q1 'ahɨxie memayaxike,  
\q2 xeme xekani'inɨaritɨni kemɨtiyɨni:  
\q1 Neti'uximayatsiriwame nekani'atɨaximeni,  
\q2 nekani'atɨaximeni Meukuyɨraxɨ.   
\q1
\v 9 Kutsuhexi, tete keneuxeiya  
\q2 'ahɨxie nemitaye.  
\q1 Mɨkɨ hetsie hɨxite 'atahutatɨ patei,  
\q2 mɨkɨtsie nepɨreu'utɨani.  
\q1 Xeitukaritsie kwiepa memɨtama  
\q2 ke'axamemɨte'uyuri nepɨtiwaranuyeitɨirieni  
\qr —mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye—.   
\p
\v 10 »”Mɨkɨ tukaritsie, yuxexuitɨ xekaniwata'iniexɨakuni yu'iwama kaxie hetɨa xemɨtitenikɨ meta piní hetɨa, mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye”».   
\c 4  
\s1 Kɨxeme 'uitɨwame hurukɨ mɨwewiya meta huriwu hutatɨ  
\p
\v 1 Merikɨtsɨ niuki tuayame nehamatɨa mɨtikuxatakai tawarita kaninuani, hikɨ kanenanutahɨtɨani, xewitɨ kutsutɨ manutahɨtɨarieni hepaɨ.  
\v 2 Hikɨ mɨpaɨ kanetiniuta'iwawiya: «¿Tita petixeiya?» Ne mɨpaɨ nekatinita'eiya: «Xeime kɨxeme 'uitɨwame huru mɨtse'ikɨ wewiyakame nepɨxeiya, yuheima peixeiya xakɨ hepaɨ 'aneme 'e'akunime, kɨxeme 'uitɨwame heima puye'u 'atahutatɨ kɨxeme, meta yunanari pexeiya 'atahutame.  
\v 3 'Aurienata pɨti'u hutatɨ huriwu, xewitɨ xakɨ hepaɨ mɨ'ane tserieta, xewitɨta 'utatana».   
\p
\v 4 Hikɨ niuki tuayame mɨpaɨ nekatiniuta'iwawiya nehamatɨa mɨtikuxatakai: «¿Neti'aitɨwame, tita ti'inɨariyari 'ikɨ naitɨ?»  
\v 5 Niuki tuayame mɨpaɨ kanetiniutahɨawe: «¿Kamɨtsɨ 'atsipekatimate tita mɨti'inɨariyari?»  
\p Ne yaneputayɨ kename 'atsinekatimate.  
\v 6 Hikɨ niuki tuayame mɨpaɨ kanetiniutahɨawe: «'Ikɨ Yawé kaniniukieyatɨni Tsuruwaweri hetsiemieme kanihɨkɨtɨni:  
\q1 »“Kuyaxi watɨrɨkariyakɨ pɨkatiyɨni  
\q2 meta nixeime tɨrɨkariyayakɨ,  
\q1 matsi Ne'iyari mupatsiekɨ pɨta  
\q2 —Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni—.   
\q1
\v 7 ¿Ketita peti'a'erie 'ekɨ, hɨri 'apemutewi?  
\q2 Tsuruwaweri hɨxie makuweri pekanihɨkɨtɨni xeikɨa.  
\q1 Mɨkɨ tete pɨkayeni tsutɨmeyari mayani,  
\q2 teɨteri me'utihiwakaku hepaɨtsitana 'aixɨa mehaitɨkaitɨ witsimɨ'anekɨ”».   
\p
\v 8 Hikɨ Yawé niukieya nehetsɨa kaninuani:   
\q1
\v 9 «Tsuruwaweri 'ikɨ tuki tenariyari kaniutsutɨani,  
\q2 meta mɨkɨtsiere 'iwewienetɨ kaninɨmɨkɨ.  
\q1 'Ana mɨpaɨ xepɨtehetimani kename  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye xehetsɨa netsiheyenɨ'a.   
\q1
\v 10 Kepauka Tsuruwaweri xemɨxeiya  
\q2 tepɨa 'atukame ti'inɨnɨatame,  
\q1 'anake mepuyukatemamawieni 'iya kemɨ'ane  
\q2 yuri memɨkate'i'eririekai 'etsiwa xeikɨa mɨtitsutɨakaitsie.  
\q1 'Ikɨ 'atahuta Yawé hɨxiteya kanihɨkɨtɨni,  
\q2 naitsarie kwiepa mɨtaneniere».   
\p
\v 11 Hikɨta niuki tuayame mɨpaɨ nekatiniuta'iwawiya: «¿Tita ti'inɨariyari 'ikɨ huriwu hutatɨ xewitɨ kɨxeme tserieta mutiwe meta 'utatanata xewitɨ?»  
\v 12 Metatsiere mɨpaɨ nekatinita'iwawiya: «¿Tita ti'inɨariyari 'ikɨ hutatɨ huriwu xawariteya hatseiti nanayari hurukɨ mɨwewiyatɨka muhuta 'aurie muti'u, taɨtana muhapane hatseiti hurumaɨyetɨ?»   
\p
\v 13 Niuki tuayame mɨpaɨ kanetiniuta'eiya: «¿Kamɨtsɨ 'atsipekatimate ketita mɨti'inɨariyarite?» Ne yanepetayɨ kename 'atsinekatimate.  
\v 14 Hikɨ niuki tuayame mɨpaɨ kanetiniutaxatɨani: «'Ikɨ yuhutatɨ memanayexeiyarie mekanihɨkɨtɨni ti'aitame memɨte'uximayatsirie naitsarie kwiepa».   
\c 5  
\s1 Xapa mukwikwiya mɨku'enenekai  
\p
\v 1 Merikɨtsɨ tawarita neneutanierixɨani, hikɨ xapa kwikwiekame nekaniuxeiya nehɨxie 'u'enirɨmeme.  
\v 2 Niuki tuayame kaneniuta'iwawiya: «¿Ketita petixeiya?» Neta mɨpaɨ nekatinita'eiya: «Xapa kwikwiekame nepɨxeiya 'u'enirɨmeme, tamamata meturuyari tewime 'auxɨwime meturuyari 'atayeume».\f + \fr 5:2 \fq tamamata meturuyari tewime 'auxɨwime meturuyari 'atayeume\ft . Yaxeikɨa panuyɨne \fq xeitewiyari tsikuriyari tewime, tamamata tsikuriyari 'atayeume. \f*   
\p
\v 3 Hikɨ niuki tuayame mɨpaɨ kanetiniutahɨawe: «'Ikɨ kanihɨkɨtɨni 'axakememɨtepitɨarieni 'inɨariyari naitsarie kwiepa kemɨtitaweni. Kemɨre'uxa mɨkɨ xapatsie, yunaime memɨtenawaya wahetsie katininakimɨkɨ meta memɨte'itawa.  
\v 4 'Ayumieme 'ikɨ 'uximatɨarika neputatua mɨtinawaya kiita meutahanikɨ meta yakɨ mɨtikuxata netsihaterɨwatɨ kename yuri 'utaine. Kiitana kaneutahamɨkɨ hikɨ kanika'unamɨkɨ, meta naime 'ikitsaraɨteya meta tenariyari kanika'unamɨkɨ, mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye».   
\s1 'Ukaratsi puteyu ti'inɨnɨatametsie mɨyekatei  
\p
\v 5 Hikɨ niuki tuayame nehamatɨa mɨtikuxatakai newayani, mɨpaɨ kanetiniutahɨawe: «Keneutanierixɨa kene'a'ɨwiya 'ikɨ matsiɨkɨtɨ mɨratɨa hepaɨtsita».   
\p
\v 6 Mɨpaɨ nekatinita'iwawiya: «¿Ketita tihɨkɨ?» Mɨkɨ mɨpaɨ kanetiniuta'eiya: «Mɨkɨ ti'inɨnɨatame kanihɨkɨtɨni xeitewiyari heimana huta rituruyari katiniukanakeni. Mɨkɨ ke'axamemɨte'uyuri kani'inɨariyaritɨni teɨteri naitsarie 'ikɨ kwieyaritsie».   
\p
\v 7 Hikɨ kananuti'ɨiyani ti'inɨnɨatame kanamikieya purumu tepɨayarikɨ mɨwewiyakai, mɨkɨ taɨta 'uka pɨyekatei 'a'ukaitɨ.  
\v 8 Niuki tuayame mɨpaɨ kaniutayɨni: «'Ikɨ kanihɨkɨtɨni tita 'axamɨti'ane», yapauka tawarita 'uka muwa kaneukataima ti'inɨnɨatameta, hikɨ kanenukanani purumu kanamikiyarikɨ.   
\p
\v 9 Tawarita neneutanierixɨani, hikɨ nekaniwaruxeiya nehɨxie yuhutame 'ukari mekanayekɨnekaitɨni yu'anatekɨ me'uwiwetɨ 'ekatsie. Mɨkɨ wa'anate wiuri 'anateya hepaɨ pɨ'anenekai, hikɨ mɨkɨ ti'inɨnɨatame mekanehana 'ekatsie.   
\p
\v 10 Ne nenita'iwawiya niuki tuayame nehamatɨa mɨtikuxatakai: «¿Hakewari mepeiha mɨkɨ ti'inɨnɨatame?»  
\v 11 Mɨkɨ mɨpaɨ kanetiniuta'eiya: «Wawiruniya paitɨ mekaneihana, tuki muwa metawewiyarienikɨ. Kepauka tuki menɨrieni, muwa ti'inɨnɨatame peutayerieni, 'ɨkayari hetawewiyame mana peuyeyerieni».   
\c 6  
\s1 Kaxetate naukatɨ  
\p
\v 1 Merikɨte hekwamekɨ neneutanierixɨani, hikɨ nekaniwaruxeiya yunaukame kaxetate kuyaxa miemete hɨri hutame hixɨata mekanayenexɨani, mɨkɨ wurunitse tepɨayarikɨ mepɨwewiyatɨkatei.  
\v 2 Mexɨakame kaxeta mekanehanakaitɨni kawayutsixi meheukɨtaxawitɨ, hutarieka mieme kawayutsixi meheuyɨyɨwitɨ mepehanakai,  
\v 3 hairieka mieme kawayutsixi meheutuxatɨ, naurieka mieme kawayutsixi meheupipitutɨ. Mɨkɨ yunaitɨ kawayutsixi memɨtɨrɨkawi mepɨhɨkɨtɨkai.  
\v 4 Hikɨ nekanita'iwawiya niuki tuayame nehamatɨa mɨtikuxatakai: «¿Ketita ti'inɨariyari 'ikɨ kaxetate, neti'aitɨwame?»   
\p
\v 5 Niuki tuayame mɨpaɨ kanetiniuta'eiya: «'Ikɨ yunaukatɨ 'iyarite mekanihɨkɨtɨni muyuawitsie miemete, mekanayekɨneri naitsarie kwiepa Ti'aitame hɨxie meheyukuxataka.  
\v 6 Kaxeta kawayutsixi memeuyɨyɨwi memehana mɨkɨ kaniyemieni xeime kwieyaritsie tayeta hepatsie, kawayutsixi memeutuxa memehana kaniyemieni tau makayuyuipike hepatsie, memeupipitu memehana kaniyemieni tatsutɨa kwieyari mukumatsie».   
\p
\v 7 Mɨkɨ kawayutsixi memɨtɨrɨkawi menitsunatɨwekaitɨni naitsarie kwiepa mekɨnikutɨ. Hikɨ niuki tuayame mɨpaɨ katiniwarutahɨawe: «Xekenehu, kwiepa naime xekenakukexiya tapa xe'itsutɨame 'atsita tapa xekaninɨkuni». Hikɨ mɨkɨ mɨpaɨ mekatenikakɨne.   
\p
\v 8 Merikɨte niuki tuayame kaneniuta'inieni mɨpaɨ kanetiniutahɨawe: «Neuxei, mɨkɨ memekɨ tayeta kwieyaritsie mana nehaxɨa mekaneunɨtɨayuni mɨkɨ kwieyaritsie».   
\s1 Kuruna Kutsuhexi hetsiemieme  
\p
\v 9 Yawé niukieya nehetsɨa kaninuani, mɨpaɨ kanetiniutahɨawe:  
\v 10 «Kenemie hikɨ kwitɨwa Kutsiyaxi kie Tsupuniyaxi nu'aya hetsɨa, mana mekane'axɨani Wawiruniya memehapaniekai Kerirahi, Tuwiyaxi meta Kerahiyaxi. Keniwaretanaki'eriri  
\v 11 pɨrata meta huru mematɨkɨ, mɨkɨ hurukɨ meta mɨkɨ pɨratakɨ xeime kuruna keneutawewi, mɨkɨ kuruna pekanenutiketsiriemɨkɨ Kutsuhexi mawari wewiwamete tiwa'aitɨwame Kutsaraki nu'aya.  
\v 12 Hikɨ mɨpaɨ Kutsuhexi pepɨtitahɨawe Yawé Naimekɨmɨtɨrɨkaɨye hetsiemieme:  
\q1 »“'Ikɨ kanihɨkɨtɨni 'iya Meukɨyɨraxɨ mɨtitewa,  
\q2 karikɨtsɨ yunanaritsie kanayɨraxɨamɨkɨ,  
\q2 meta mɨkɨ tuki pɨtawewieni Yawé hetsiemieme.   
\q1
\v 13 Mɨkɨ tawari Yawé tukieya panukuketɨani,  
\q2 ti'aitame hepaɨ pɨtiyukemaritɨani,  
\q2 yu'uwenitsie payerɨni ti'aitatɨ.  
\q1 Meta xewitɨ mawari wewiwame 'uwenieyatsie 'apayerɨni,  
\q2 peru mɨkɨ yuhutatɨ mepɨyuxewini mepɨyunaki'erieka”.   
\p
\v 14 »Mɨkɨ kuruna Yawé tukieyata puyuhayewani temɨwara'eriwanikɨ Kerirahi, Tuwiyaxi, Kerahiyaxi meta Heni Tsupuniyaxi nu'aya.  
\v 15 Xɨka xeme yaxetekahuni Yawé xekakaɨyari kemaine, 'ateewa memu'uwa mekani'axɨakuni mexeparewienike Yawé tukieya tawari xemɨtawewienikɨ. 'Ana mɨpaɨ xepɨtehetimani kename Yawé Naimekɨmɨtɨrɨkaɨye netsiheyenɨ'a».   
\c 7  
\s1 Kakaɨyari hakiya pɨkaheuyehɨwa  
\p
\v 1 Naurieka wiyaritsie ti'aitakaku Raríyu, naurieka tukaritsie 'atanauka metseritsie, \it kitsirehu\it* metseriyaritsie mɨyatɨtɨ, 'ana Yawé niukieya Tsakariyaxi hetsɨa kaninuani.  
\v 2 Weteri kiekatari mekaniwareyenɨ'akaitɨni Tsaretsexi meta Xekeni-Mereki, metatsiere wateɨterima, memiwauyukɨ Yawé parewiyaya,  
\v 3 meta memeta'iwaunikɨ mawari wewiwamete wahetsɨa memɨhɨritɨarie Yawé Naimekɨmɨtɨrɨkaɨye tukieya, metatsiere Kakaɨyari niukametemama: «¿Tetehe'eriwani 'akuxi 'auxɨwirieka metseriyaritsie xeitukari teteyuhiwerieka meta teteyuhakieka teyɨhɨtɨ, yaxeikɨa meripaitɨ wiyaritsie ketemɨ'anekai?»   
\p
\v 4 Hikɨ 'ikɨ niuki nehetsɨa kaninuani Yawé Naimekɨmɨtɨrɨkaɨye hetsɨa mieme:   
\q1
\v 5 «Mɨpaɨ ketiniwarutahɨawi yunaime mɨkɨ kwieyaritsie memɨtama,  
\q2 metatsiere mawari wewiwamete:  
\q1 “Kepauka xeme xemuyutihakiwakai meta xemuyuhiweriekai  
\q2 'auxɨwirieka metseriyaritsie meta 'atahutarieka metseriyaritsie  
\q1 haika tewiyari heimana tamamata wiyari manukatɨatsie,  
\q2 'ana yurikɨ nehetsiemieme xepɨkayuhakiekai.   
\q1
\v 6 Kepauka xeme xemɨtekwa'a xemɨte'ie,  
\q2 yuhetsiemieme xeikɨa xekaniyɨaka”».   
\b  
\q1
\v 7 'Ikɨ niuki pɨhɨkɨ  
\q2 neniukamete meripaitɨ miemete  
\q2 ne Yawé yanetiwapitɨakaku memitaxataxɨ  
\q1 kepauka 'akuxi Kerutsareme meta kiekari 'auriena mamanetɨkatsie  
\q2 mɨkiepatɨkai meta kayuwatɨ memexeiyakaitsie,  
\q1 kepauka 'akuxi Nekexi meta muweritsie tau makayuyuipike hepa  
\q2 mɨkiepatɨkai.   
\p
\v 8 Yawé niukieya kaninuani hekwamekɨ Tsakariyaxi hetsɨa. Mɨpaɨ katineyehɨtɨani:   
\b  
\p
\v 9 «Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:  
\q1 »“Xeketeneheitseritɨaka yurikɨ kemɨtiheitserie,  
\q2 xekeneyunaki'erieka meta xekeneyunenimayaka  
\q2 xeyunɨtɨ yunaitɨ.   
\q1
\v 10 Xepɨkawananaimaka wiuraxi meta nutuite,  
\q2 meta 'ateewa kiekatari metatsiere tixaɨtɨ memɨkateheuxeiya.  
\q1 'Axamɨti'ane xepɨkawewieka yu'iyaritsie  
\q2 hipame wahetsiemieme”.   
\p
\v 11 »Peru mɨkɨ mepɨka'uyuwaɨri mɨpaɨ memɨtekakɨnekɨ. Me'i'inɨatatɨwetɨ mekanawaritaxɨani meta mepeuyukanaxɨa yunakata.  
\v 12 Memɨka'i'enienikɨ niuki 'aitsika meripai miemetexi Kakaɨyari niukametemama Yawé Naimekɨmɨtɨrɨkaɨye muwareyenɨ'airiekai 'Iyari yuhetsɨa miemekɨ, 'ana yu'iyari mekaniutseiriya tete kwinimieme mɨtitse'i hepaɨ. Hikɨ 'ayumieme, Yawé Naimekɨmɨtɨrɨkaɨye yemekɨ kaniuyeha'ani.  
\v 13 “Memɨkanetsi'u'enikɨ kepauka nemɨwarutahɨawixɨtsie, neta nepɨkawa'enieni kepauka memɨnetsitahɨawetsie —mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye—.  
\v 14 Haikɨri waɨkawa mɨtɨrɨkaɨye hepaɨ, nekaniwareutaxɨriexɨani naitsarie hipame nuiwarite memɨkawamatekai wahetsɨa. Yukwie memiku'eiri yuxaɨta puyuhayewaxɨ nixewitɨ tɨma mana pɨka'uyeyeikakai. Mɨpaɨ me'ɨyɨka yukwie 'akumaweme mekanayeitɨani meripaitɨ witsimɨraku'anekai”».   
\c 8  
\s1 Yawé kemutayɨ Kerutsareme kename 'aixɨa yurieni  
\p
\v 1 Tawarita Yawé Naimekɨmɨtɨrɨkaɨye niukieya nehetsɨa kaninuani. Mɨpaɨ kanetiniutahekɨatɨani:   
\b  
\p
\v 2 «Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:  
\q1 »“Ne waɨkawa nepɨ'ɨtetsa Tsiyuni hepaɨtsita.  
\q2 Waɨkawa yemekɨ nepikwerie  
\q2 hetsiena mieme nepuyeha'arɨwe”.   
\p
\v 3 »Mɨpaɨ kanaineni Yawé:  
\q1 »“Nepunuani tawarita Tsiyunitsie,  
\q2 meta Kerutsareme ne'ukaitɨ nepayani.  
\q1 Hikɨ Kerutsareme pɨmatiwani  
\q2 tita Yuri Mɨraine Kiekariyari,  
\q1 meta Yawé Naimekɨmɨtɨrɨkaɨye yemurieya  
\q2 Yemuri Mɨpatsie pɨtitewaka”.   
\p
\v 4 »Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:  
\q1 »“'Ukirawetsixi meta 'ukaraixi tawarita  
\q2 Kerutsareme kayeyari'utɨa metiyaxiketɨ mepakɨne,  
\q1 yuxexuitɨ yu'itsɨ me'u'ɨtɨ  
\q2 waɨkawa wiyari memexeiyatɨkanikɨ.   
\q1
\v 5 Tɨɨri 'ukitsi meta 'ukari tawarita mekanitiwaikakuni  
\q2 mɨkɨ kiekari kayeyaritetsie”.   
\p
\v 6 »Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:  
\q1 »“Kemɨ'ane 'ana memuyuhayewatɨweni  
\q2 'ana tukaritsie kayɨweme mepɨ'erieka mɨpaɨ mɨtiyɨni,  
\q1 peru ne nehepaɨtsita pɨtiyɨwe,  
\q2 mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye”.   
\p
\v 7 »Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:  
\q1 »“Neteɨterima nepɨwatawikweitsitɨani,  
\q2 tau manatineika hepatsie kiekatari wahetsɨa memu'uwa meta makayuyuipike hepatsie.   
\q1
\v 8 Nepɨwarakunuitɨani  
\q2 Kerutsareme pɨta memɨkutenikɨ,  
\q1 mɨkɨ neteɨterima mepɨhɨkɨtɨni  
\q2 neta wakakaɨyari nepɨhɨkɨtɨni,  
\q2 yurikɨ nepɨtiyurieneni meta heitseriemekɨ”.   
\p
\v 9 »Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:  
\q1 »“Xekeneyuwaɨriyani, xeme,  
\q2 'ikɨ tukaritsie xemi'eni  
\q2 Kakaɨyari niukametemama waniuki,  
\q1 mexi tenari wewiyane  
\q2 tuki hutarieka mieme manukuhanienikɨ  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye hetsiemieme.   
\q1
\v 10 Meripaitɨ mɨreukayunetsie  
\q2 teɨteri mepɨkatepitɨariekai yu'uximayatsikakɨ  
\q2 meta tewaxi yu'ikwai mepɨkakumikiwakai.  
\q1 Hipatɨ memɨxe'aye'uniekaikɨ  
\q2 kɨkamete 'aixɨa 'iyari mepɨkaku'uwakai,  
\q1 netsɨ yanekatiniwarupitɨani yunaime teɨteri  
\q2 yunaitɨ memayuye'uniekakɨ.   
\q1
\v 11 Hikɨri mɨpaɨ nepɨkatiwapitɨani memɨyuhayewaxɨ 'ikɨ teɨteri  
\q2 meripaitɨ kenemɨtiwarupitɨa hepaɨ  
\q2 —mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye—.   
\q1
\v 12 Kayuwatɨ mepexeiyani kepauka mɨtika'etsitɨ,  
\q2 meta kaxie yu'ikwaxi putixuaweriyani,  
\q1 kwie pɨtiutixuaweriyani tita mɨtika'etsieni  
\q2 meta muyuawi yuwiyeri panakanɨ'ani.  
\q1 Mɨkɨ naime nepɨtiwapitɨani mɨtiwahetsiemiemetɨnikɨ  
\q2 'ikɨ teɨteri memɨyuhayewatɨwe.   
\q1
\v 13 Kura kwieyaritsie kiekatari meta 'Ixaheritsie,  
\q2 xepɨkaheumamaka, matsi xekeneyuwaɨririyani.  
\q1 Xeme hipame nuiwarite watsata  
\q2 'axaxemɨ'itɨarie xepɨhɨkɨtɨkai,  
\q1 ne peru nepɨxetawikweitsitɨani,  
\q2 hikɨ hipatɨta 'aixɨa mepɨ'itɨarieni xekɨmana”.   
\p
\v 14 »Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:  
\q1 »“Kepauka xetutsima memɨnetsi'uyehaxɨatɨa,  
\q2 ne yaneputayɨ nemɨwarakumaweriyakɨ nekawareunenimayatɨ  
\q2 —mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye—.   
\q1
\v 15 Peru hikɨta nepɨnewaɨri  
\q2 Kerutsareme 'aixɨa nemɨyurienikɨ meta Kura kwieyari.  
\q2 'Ayumieme xepɨkaheumamaka.   
\b  
\q1
\v 16 »”Peuyewetse xeme 'ipaɨ xemɨtekahuni,  
\q2 yurikɨ xeketeneyukuxaxatɨwani,  
\q1 xekeneyuxanetani 'itsɨkate wahetsɨa  
\q2 yurikɨ meta kemɨtiheitserie.  
\q2 Mɨpaɨ xɨka xeteyurieka kayuwatɨ kaniumakamɨkɨ.   
\q1
\v 17 'Axamɨti'ane xepɨkatewewieka yu'iwa hepaɨtsita,  
\q2 'itarikakɨ xepɨkatekuxatani,  
\q1 karikɨ ne mɨkɨ naime nekatini'uxiwe'erieka,  
\q2 mɨpaɨ kanaineni Yawé”».   
\p
\v 18 Nehetsɨa kaninuani Yawé Naimekɨmɨtɨrɨkaɨye niukieya, mɨpaɨ kanetiniutahɨawe:   
\b  
\p
\v 19 «Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:  
\q1 »“Kura teɨteriyari wahetsiemieme, hakiya mematinenetɨwakai  
\q2 naurieka metseritsie meta 'auxɨwirieka, 'atahutarieka meta tamamata metseriyaritsie,  
\q1 hikɨri temawierika mepexeiyani,  
\q2 'ixɨarari mepatinenetɨwani.  
\q2 Kamɨtsɨ, xekenenaki'erieka tita yuri mɨraine meta tita kayuwatɨ mɨtiyupitɨwa”.   
\p
\v 20 »Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:  
\q1 »“Mekani'axɨakuni teɨteri,  
\q2 waɨkawa kiekari mukumanetsie kiekatari,   
\q1
\v 21 hipame kiekaritsie mekanitikɨnikuni  
\q2 mɨpaɨ metewakuxaxatɨwatɨ mana kiekatari:  
\q1 Hikɨmɨ tepuhu Yawé hetsɨa tepiwawirieyu 'aixɨa mɨtatsiheyurienikɨ.  
\q2 Tepiwauyu Yawé Naimekɨmɨtɨrɨkaɨye.  
\q2 Netatsiere nekaneiwaumieni.   
\q1
\v 22 Meta yumɨiretɨ teɨteri metatsiere nuiwarite memɨtɨrɨkawi  
\q2 Kerutsareme mekani'axɨakuni  
\q1 me'ikuwautɨwetɨ Yawé Naimekɨmɨtɨrɨkaɨye  
\q2 meta 'aixɨa mɨwayurienikɨ”.   
\p
\v 23 »Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye: “'Iya tukaritsie yuwaɨkawatɨ mepuxuaweni teɨteri, yɨkɨ memɨte'uniuka yunaitɨ, hipatɨ nuiwarite yunaitɨ, hikɨ xeime huriyu tewiyari kamixaya tetsimeyaritsie mekawɨreme mɨpaɨ mekatenitahɨawikuni: Neuxei tepɨmatsi'anuteɨta. Mɨpaɨ tepɨtehetima kename Kakaɨyari xehamatɨa 'uyeika”».   
\c 9  
\s1 Yawé niukieya 'Ixaheri memaye'unie wahepaɨtsita mieme  
\p
\v 1 'Ikɨ, kemɨtiyɨni niukiyari kanihɨkɨtɨni Yawé kemutayɨ, Karɨraki kwieyari hetsiemieme kanihɨkɨtɨni meta Ramatsiku. Yurikɨ Yawé teɨteri kwi kaniwataxeiyani metatsiere yunaime 'Ixaheri nuiwarimama,  
\v 2 meta 'auriena mukuma Kamati kanitaxeiyani, metatsiere Tiru, Tsiruni mame, tsepa mɨkɨ kwinimieme memɨtemaiwawe.   
\q1
\v 3 Tiru kiekatari yukiekari kuraruyari 'e'atitewame meputawewi,  
\q2 pɨrata mepukuxeɨri tumuanari mɨhɨkɨtɨni hepaɨ,  
\q2 meta huru haxu kaye 'utɨa mieme mɨhɨkɨtɨni hepaɨ.   
\q1
\v 4 Peru Ti'aitame pɨtiwanawairieni wapiinitɨarika,  
\q2 haramaratsie kaneikaxɨrimɨkɨ tita mɨtiwaxikutɨriya,  
\q2 meta tai kanitixɨtsitɨamɨkɨ.   
\q1
\v 5 'Atsikaruni kiekatari mepixeiya, hikɨ waɨkawa mepɨtimamani,  
\q2 Kahatsa kiekatari waɨkawa mepɨteka'eniexɨani,  
\q1 meta yaxeikɨa mepɨyɨni 'Ekuruni kiekatari  
\q2 kepauka kememɨteta'ikwewakai yamɨkatiyɨni.  
\q1 Kahatsa kiekatari ti'aitame mepɨnawaiyarieni,  
\q2 meta 'Atsikaruni kiekatari mepakumawere.   
\q1
\v 6 Teɨteri memɨka'upapa 'Atsiruri kiekariyaritsie mepɨyutikiitɨani,  
\q2 meta ne piritsiteutsixi kememɨteyuti'ɨre nepɨwanawairieni.   
\q1
\v 7 Wateta nepɨwanawairieni wai muxuxure,  
\q2 meta 'ikwai mɨka'itiya.  
\q1 Meta piritsiteutsixi yayupaɨmetɨ  
\q2 mepɨyuhayewa takakaɨyari hetsiemieme,  
\q1 Kura kwieyaritsie kuyaxi tewa'aitɨwamete mepakɨne,  
\q2 meta 'Ekuruni kiekatari kewutseutsixi wahepaɨ me'anetɨ mepakɨne.   
\q1
\v 8 Hikɨri ne netuki nepɨta'ɨwiya  
\q2 xewitɨ mɨkaheutahakenikɨ meta xewitɨ mɨkahewayeyeikanikɨ.  
\q1 Hatsuakuri xewitɨ mɨtatsi'aye'unie pɨkawaka'una neteɨterima,  
\q2 karikɨ hikɨri ne nekatinita'ɨwiyani.   
\s1 Ti'aitame kemɨtinuani Kerutsareme  
\q1
\v 9 Waɨkawa keneyutemawieka, neniwe 'uka Tsiyuni.  
\q2 Keneutahiwani temawierikakɨ, neniwe 'uka Kerutsareme.  
\q1 Neuxei, mana pamie 'ahepa meti'aitɨwame,  
\q2 heitserie yamɨtikamie, tiyuwikweitsitɨwame meta mariwetɨ mɨkahayuyeitɨwa.  
\q1 'Akanamieni puxutsie 'anakaitɨ,  
\q2 puxu temaikɨ hetsie, puxu 'ukaratsi nu'ayatsie.   
\q1
\v 10 'Epɨrahini kaxetamama kuyaxa mieme pukumaweriya  
\q2 meta kawayutsixi Kerutsareme miemete.  
\q1 Tupite kuyaxa miemete pɨtimura,  
\q2 hikɨ nuiwarite memɨyuxewinikɨ niukiyari pɨwataxatɨani.  
\q1 Pɨtita'aita haramaratsie ka'atɨkaime meta tapa haramaratsie paitɨ ye'atɨkaime,  
\q2 'Eupɨrate hatuxameyaritsie tsutɨme  
\q2 'atsita kwie manu'axe paitɨ.   
\s1 'Ixaheritsixi kememɨtehekwariyarieni  
\q1
\v 11 'Ekɨta,  
\q2 tɨratu nemuwewikɨ nexuriyakɨ 'ahamatɨa  
\q2 nepɨwaxɨna putsu muyewakita memati'u 'ahetsɨa miemete memanutaxɨriya.   
\q1
\v 12 Xekenehu yukiekari 'aixɨa mɨrekukurarutuiyarietsie,  
\q2 xe'anutaxɨriyatɨ xemɨta'ikwewakai,  
\q1 karikɨ hikɨ mɨpaɨ nekanaineni mɨpaɨ xemɨtemaikakɨ  
\q2 nekatinixepitɨamɨkɨ hutakɨa tita xemɨteheuyehɨa.   
\q1
\v 13 Kura netupi hepaɨ nekanikuha'aritɨamɨkɨ,  
\q2 meta 'Epɨrahini ne'ɨrɨ nekanayeitɨamɨkɨ.  
\q1 Tsiyuni, 'aniwema nepɨwayuitɨani,  
\q2 Kɨretsiya kiekatari waniwema memɨwatakwinikɨ,  
\q2 yumemiwame 'ixiparaya nepɨmatsihayeitɨani.   
\b  
\q1
\v 14 Yawé matsiɨkɨtɨ payuyeitɨani wahetsie,  
\q2 meta 'ɨrɨteya mimierɨkari hepaɨ 'anenetɨ payekɨne.  
\q1 Yawé naimekɨmɨyɨwe pitahɨtsieni 'awa,  
\q2 hikɨ kanayeyeimɨkɨ 'eka mɨtɨrɨkaɨye tatsutɨa miemetsie yewetɨ.   
\q1
\v 15 Yawé Naimekɨmɨtɨrɨkaɨye pɨwa'ɨwiyani yuteɨterima,  
\q2 mɨkɨ naime mekanititarakuni  
\q2 tetexi kɨmana memɨtituaxienikekai.  
\q1 Kwinie mepɨte'uhiwani winukɨ memɨtarɨweka hepaɨ,  
\q2 xuriyakɨ mepeu'ɨwatɨkani tekɨxi tukita mieme hepaɨ,  
\q2 meta mawari taiyame 'awateya hepaɨ.   
\q1
\v 16 'Iya tukaritsie Yawé Kakaɨyari  
\q2 yuteɨterima puwatawikweitsitɨani muxatsi wahepaɨ,  
\q1 hikɨ Yawé kwieyatsie  
\q2 meputixawatɨreni tetexi witsimɨ'anene kuruna hetsie matei hepaɨ.   
\q1
\v 17 'Aixɨa pɨti'aneni meta witsipɨti'aneni naitɨ.  
\q2 Tɨriku temari metɨrɨkawime puwarayeitɨani,  
\q2 meta kaxie winuyari mɨhekwa 'ukari 'ɨimarixi puwatemawieritɨani.   
\c 10  
\s1 Yawé Kura pɨ'ɨwiyani  
\q1
\v 1 Yawé xekeneutawawiri mɨkawiyekɨ witarita.  
\q2 Mɨkɨ kanihɨkɨtɨni hai mɨyɨyɨwi mɨtiwewiwa  
\q2 meta wiyeri meyenɨ'awa.  
\q1 Mɨkɨ kanihɨkɨtɨni yunaime teɨteri wahetsiemieme  
\q2 kwiepa tupiriyate mɨtiutinenetɨwa.   
\q1
\v 2 Kakaɨyarixi memɨwewiyatɨka 'itarikakɨ mepɨtekuxata,  
\q2 temaiwawemete 'itarika mepɨteheinɨtsa,  
\q1 mepɨtekuxata 'itarikakɨ kememɨtenieritɨarie  
\q2 meta kememɨteyɨnɨtɨwa pɨtiyakɨ.  
\q1 'Ayumieme xeme xepeuyexɨrie  
\q2 muxatsi memɨkatehekakutsiyari wahepaɨ.   
\b  
\q1
\v 3 Nepɨha'a tehɨwemete wahepaɨtsita,  
\q2 nepɨwa'uximatɨani mɨkɨ memanuyetei.  
\q1 Yurikɨ Yawé Naimekɨmɨtɨrɨkaɨye  
\q2 Kura kwieyaritsie kiekatari kaniwa'ɨwiyani, mɨkɨ muxatsimama mekanihɨkɨtɨni,  
\q1 'arike yukawayutsixima memɨtɨrɨkawi kaniwarayeitɨamɨkɨ  
\q2 kepauka muyutamieni.   
\q1
\v 4 Kura hetsie mepɨyekɨne  
\q2 tete 'itsikina mieme meta kɨye 'ixuriki kiyari mukuhanani,  
\q2 tupi kuyaxa mieme meta yumɨiretɨ te'aitamete.   
\q1
\v 5 Meyuxewitɨ yunaitɨ memɨte'ayu'iwa mepɨhɨkɨtɨni  
\q2 meyukwitɨwetɨ mepɨte'ayu'iwani kaye'utɨma muhaxuyatsie,  
\q1 kawayutsixi wahetsie memutei mepɨwaranakaxɨrɨwani,  
\q2 Yawé wahamatɨa muyeikanikɨ waparewietɨ.   
\b  
\q1
\v 6 «Ne Kura nuiwarimama tɨrɨkariya nepuwapitɨani  
\q2 meta nepɨwatawikweitsitɨani Kutse nuiwarimama.  
\q1 Nepɨwarutinenimayataxɨ  
\q2 hikɨ 'ayumieme nepuwarakunuitɨani.  
\q1 Wa'atɨtɨ hatsuaku nepɨkatiwaruku'eiri nepɨ'aneni,  
\q2 Ne Yawé nemɨhɨkɨkɨ wakakaɨyari,  
\q2 nepuwata'eiya.   
\q1
\v 7 'Epɨrahini kiekatari kuyaxi memɨte'ayu'iwa wahepaɨ mepɨ'aneni,  
\q2 wa'iyari puyutemamawieka  
\q2 winu memanu'ieni hepaɨ.  
\q1 Waniwema kepauka memɨwaxeiya mekaniyukatemamawikuni,  
\q2 wa'iyari puyutemawieka Yawé hetsiemieme.   
\q1
\v 8 Ne nepuwatahɨawe hikɨ nepuwakuxeɨrieni.  
\q2 Kepauka nemɨwatawikweitsitɨani netinetuame,  
\q2 meyumɨiretɨ mepakɨne meripai hepaɨ.   
\q1
\v 9 Tsepa nemɨwareutaxɨriexɨa hipame teɨteri watsata,  
\q2 'ateewa paitɨ me'u'uwatɨ mepɨnetsihaye'erieni.  
\q1 Tsepa muwa meme'uwakai yuniwema yunaitɨ,  
\q2 mekani'axɨakuni yukwietsie.   
\q1
\v 10 'Ekipitutsie nepɨwarayewitɨni,  
\q2 metatsiere 'Atsiriya kwieyaritsie,  
\q1 Karaha kwieyaritsie nepɨwa'atɨani meta Riwanu hɨriyaritsie,  
\q2 'akuxi hipatɨ hakewa memetiyaxe kwie hauyewetɨ kanayeimɨkɨ.   
\q1
\v 11 Haramara kayuwatɨ mɨkatimatsie mepɨkɨne,  
\q2 ne peru hamewari kayuwatɨ nepɨpitɨani,  
\q2 meta Niru hatuxameyari 'amatiyewa pakawani.  
\q1 'Atsiriya kemɨtiyuta'ɨre nepeitiparitɨani,  
\q2 meta 'Ekipitu kemɨti'aita nepikumaweriya.   
\q1
\v 12 Netɨtɨ nepɨhɨkɨtɨni nemɨwatɨrɨkariyani,  
\q2 hikɨ mɨkɨ mepuhuni nekɨmana»,  
\qr mɨpaɨ kanaineni Yawé.   
\b  
\c 11  
\q1
\v 1 Riwanu hɨriyari, keneupitɨa  
\q2 tai 'akariuxa mɨtitaiyakɨ.   
\q1
\v 2 Keneutatsuakani 'ekɨ, huku kɨyeyari, kariuxa kɨyeyari matixɨriyakɨ  
\q2 meta kɨyexi mumamariwawekai matixɨrikɨ.  
\q1 Xekeneutitsuanani, tuaxa Watsani miemete.  
\q2 Mukumaweriyariekɨ kɨyexi wawemete.   
\q1
\v 3 Xekeneu'eni muxatsi wahɨwemete watsuari,  
\q2 wa'ɨxa witsimɨtiu'anekai kanakuxɨtsitɨarieni.  
\q1 Xekeneu'eni mayetsi watsuari,  
\q2 Kurutani muweritsie 'ɨtsi 'amayetsuikai makumaweriyariekɨ.   
\s1 Muxatsi wahɨwemete yuhutatɨ  
\p
\v 4 Mɨpaɨ kanaineni Yawé nekakaɨyari: «Keniwa'ɨwiyani muxatsi kemɨ'ane 'ari memɨyetuiya memɨkwi'iwakɨ.  
\v 5 Kemɨ'ane memɨwanane mekaniwakwika mekawanenimayatɨ, meta kemɨ'ane memɨwatua mɨpaɨ meputiyuane: “'Aixɨa ke'itɨarieka Yawé, 'ari xiku nepatɨa”. Memɨwahɨtɨtɨ nenimayatsika mepɨkahexeiya wahepaɨtsita mieme.  
\v 6 'Ayumieme 'ariri nepɨkawatinenimayata 'ikɨ kwieyaritsie memɨkiekatari —mɨpaɨ kanaineni Yawé—, pɨta nekaniwayetuamɨkɨ wa'aurie kiekatari wahetsɨa meta tiwa'aitɨwame hetsɨa. Tsepa wakwieyaritsie memɨtetahaxɨa meteyuniyatɨ, ne wahetsie nepɨkatanuani».   
\p
\v 7 Hikɨ newahɨnetɨ nekanayani muxatsi memɨkwi'iwakɨ memɨ'ayumiemetetɨkai. Hutame tihɨweme 'itsɨya nekaniuti'ɨni: xeime 'Aixɨa Mɨtiuka'iyari nekatiniuterɨwa, xeimeta Memɨyunɨ'ɨ, hikɨ newa'ɨwiyatɨ nepatɨa muxatsi.  
\v 8 Kwitɨwa xeimetseritsie nepɨwaranayexɨri yuhaikame muxatsi wahɨwemete.  
\p Peru neputi'uxixɨ muxatsi wahekɨ, mɨkɨta muxatsi nekɨmana yaxeikɨa meputi'uxixɨ.  
\v 9 'Ayumieme mɨpaɨ nepɨtiwarutahɨawixɨ: «Neri xehɨweme nepɨkahayani. Kehate xemɨkwini tsepatsɨ xemukwi, kehate xemɨkwi'iwa, tsepa xemukwi'iwaxɨ, kemɨ'aneta memɨyuhayewa, tsepa memɨyutikwai».   
\p
\v 10 Hikɨ 'itsɨ ne'utikweka 'Aixɨa Mɨtiuka'iyari nemɨtiterɨwaxɨ, nekanenumura. Mana memɨtanenierekai mɨpaɨ memɨtehetimanikɨ kename Kakaɨyari tɨratu nuiwarite wahamatɨa kemɨrexeiyakai 'enumurakai.  
\v 11 'Ana tukaritsie kwitɨwa tɨratu kaneutipare, muxatsi wanawemete memɨnetsixeiyakai mɨpaɨ mekatenetimani kename Yawé niukieyatɨkai.   
\p
\v 12 Hikɨ mɨpaɨ nekatiniwarutahɨawe: «Xɨka 'aixɨa 'aneni xehepaɨtsita, xekeneteneupitɨa ne'uximayatsikakɨ, yatɨ pɨtikatixaɨ, tsepa xekena'ɨtɨ». Mekaneteniupitɨani xeitewiyari heimana tamamata pɨrata tuminiyarikɨ.  
\v 13 Kenemɨtiupitɨarie 'etsipupaɨmekai.  
\p Hikɨ Yawé mɨpaɨ kanetiniutahɨawe: «Keneyetua tepɨa mɨtikwaxiya hetsɨa». Hikɨ pɨrata tuminiyari nene'ɨni xeitewiyari heimana tamamata, nekaneiyetuani tewi mitikwaxiya hetsɨa Yawé tukita.   
\p
\v 14 Hikɨ nekanenumurata hutarieka mieme 'itsɨ Memɨyunɨ'ɨ nemɨtiterɨwaxɨ, mɨpaɨ mɨtimatsiɨkɨnikɨ Kura 'Ixaheri hamatɨa kememɨteyuxewikai hikɨri mepeutaxɨriyaxɨakai.  
\v 15 Yawé hikɨ mɨpaɨ kanetiniutahɨaweta: «Hikɨta 'iya muxatsi wahɨwemete memɨka'u'iyari wahepaɨ ketineuyukemaritɨa,  
\v 16 karikɨ ne xeime muxatsi wahɨweme nekananukakemɨkɨ 'ikɨ kwieyaritsie, mɨkɨ pɨkayu'iyaritɨaka muxatsi memɨkwixime wahetsiemieme, meta pɨkawatiwauni 'etsimemɨpepe, meta pɨkawati'uayemani memɨti'ɨkamɨrike, meta 'aixɨa memɨ'anene pɨkatiwamini, matsi pɨwatikwani kemɨ'ane memɨwaiyatɨka meta wakarutsa panutihɨnaxɨani».   
\q1
\v 17 Xɨa'ui tihɨweme nitixaɨtɨkɨ mɨkatiyunaki'erie  
\q2 mɨwaruku'eiri yumuxatsima.  
\q1 'Ixipara pewiteni mamaya,  
\q2 meta hɨxieya tserietana mieme nawaxakɨ ke'uyetsekieni.  
\q1 Mamaya kayuawetɨ ke'ayani,  
\q2 meta hɨxieya tserietana mieme, kanieretɨ ke'ayani.   
\c 12  
\s1 Kememɨteka'unarieni Kerutsareme memaye'unie  
\p
\v 1 'Ikɨ kemɨtiyɨni niukiyari Yawé niukieya kanihɨkɨtɨni, 'Ixaheri hepaɨtsita mieme.  
\q1 Mɨpaɨ kanaineni Yawé, muyuawi munetɨa,  
\q2 kwie tenariyari mukayatsaxɨ,  
\q2 meta tewi tukari 'iyayari mupitɨa:   
\p
\v 2 «Kerutsareme tekɨxi nepayeitɨani puwatitarɨwaitɨani yunaime 'auriena kiekatari. Kura kiekariteyari warita kuyaxi mepayaxetɨkɨne meta Kerutsareme warita,  
\v 3 meta yunaitɨ nuiwarite kwiepa memɨtama mepɨyunɨni memika'unakɨ.  
\p »'Iya tukaritsie Kerutsareme tete mɨkayukemarinɨa nepayeitɨani yunaime teɨteri wahetsiemieme. Kemɨ'ane memikuyuitɨani mɨkɨ pɨwatipɨna.   
\p
\v 4 »'Iya tukaritsie nepɨwatimariuta yunaime kawayutsixi meta memanatei meka'u'iyarime nepɨwarayeitɨani —mɨpaɨ kanaineni Yawé—. 'Ana nepɨwa'ɨwiyani Kura kwieyaritsie kiekatari, matsi mekaheuneniereme nepɨwarayeitɨani yunaime nuiwarite wakawayutsixima.  
\v 5 Hikɨ Kura kwieyaritsie kiekatari wa'ukiyarima mɨpaɨ mepɨtiyuani: “Kerutsaremetari hakewa temeyu'awietani takakaɨyari kanihɨkɨtɨni, Yawé Naimekɨmɨtɨrɨkaɨye”.   
\p
\v 6 »Mɨkɨ tukaritsie Kura kwieyaritsie kiekatari wa'ukiyarima tɨɨ yayatsame mɨta'a nekaniwarayeitɨamɨkɨ 'ɨtsi tsata, yatɨni kɨye manuta'a 'itsanari tsata. Yutserieta miemete meta yu'utata miemete mekaniwatitaiyakuni teɨteri yu'aurie kiekatari, peru Kerutsareme tawari kiepa payani.  
\v 7 Yawé kuyaxi Kuratsie kiekatari wakimeri kaniwatawikweitsitɨamɨkɨ, Rawiri nuiwarimama meta Kerutsareme kiekatari mariweme memɨkahayuyeitɨwanikɨ.   
\p
\v 8 »'Iya tukaritsie ne, Yawé, Kerutsareme kiekatari wahetsie nepɨtanuani. Mana kiekame yemekɨ mɨkatɨrɨkaɨye Rawiri hepaɨ pɨtitɨrɨkaɨyeni, meta Rawiri nuiwarimama Kakaɨyari hepaɨ mepɨ'aneni, niuki tuayame Yawé hetsɨa mieme hepaɨ teɨteri muwaruwitɨxime.   
\s1 Hiwerika pitsikakɨ mumierie hetsiemieme  
\p
\v 9 »'Iya tukaritsie nepuwaka'unani yunaime nuiwarite kemɨ'ane Kerutsareme memɨmietɨweni.  
\v 10 Rawiri nuiwarimama wahetsie meta Kerutsareme kiekatari nepɨwapituani 'iyari mɨtiyukanenimaya meta nenewierikɨ mɨ'ayumieme, hikɨ 'ana mepɨnetsixeiya. Kemɨ'ane pitsikakɨ memutse hetsiemieme mepuyukahiwerieni, yuniwe matɨari mieme memutatɨmaiya hepaɨ mepɨteyuhiwerieka.   
\p
\v 11 »'Iya tukaritsie Kerutsareme kiekariyaritsie waɨkawa hiwerika puxuaweni, Harari-Ximuni hetsiemieme kemɨtiutitsuaritɨre hepaɨ Mekiru makuweritsie.  
\v 12 Naitsarie 'ikɨ kwieyaritsie kiekatari mepuyuhiwerieka, yuxexuitɨ 'iwamarixi kememɨyukupapaɨme.  
\q1 »Rawiri nuiwarimama  
\q2 meta wa'ɨitama,  
\q1 Natani nuiwarimama  
\q2 meta wa'ɨitama,   
\q1
\v 13 Rewi nuiwarimama  
\q2 meta wa'ɨitama,  
\q1 Tsimi nuiwarimama  
\q2 meta wa'ɨitama,   
\q1
\v 14 meta hipatɨ 'iwamarixi kememɨyukupapaɨme  
\q2 meta yaxeikɨa wa'ɨitama.   
\c 13  
\s1 'Axamɨti'ane kemɨti'itiyani  
\p
\v 1 »'Iya tukaritsie haixa kaneuyepierimɨkɨ mɨkɨkɨ ke'axamemɨte'uyuri memɨhauxinarienikɨ meta memɨ'itiyanikɨ Rawiri nuiwarimama meta Kerutsareme kiekatari.   
\p
\v 2 »'Iya tukaritsie kakaɨyarixi memɨwewiyatɨka kememɨtetetewa nepikumaweriya, hatsuaku tawari me'ayexeiyarietɨ mepɨka'akɨne —mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye—. Metatsiere nepɨwakumaweriya Kakaɨyari niukametemama memɨyuxatakai meta 'iyari mɨka'itiya mɨwanɨkai.  
\v 3 Xɨka 'akuxi xewitɨ Kakaɨyari niukame yuxatatɨ tixatamɨkɨni, paapamamatɨtɨ mɨpaɨ mepɨte'itahɨawe: “'Ekɨ Yawé hetsiemieme pepɨtiku'itawa. 'Ayumieme 'ekɨ pekanimieriemɨkɨ”. Hikɨ Kakaɨyari niukameya muyuxatakaikɨ, paapamamatɨtɨ mepitseni mepimieni.   
\p
\v 4 »'Iya tukaritsie Kakaɨyari niukametemama mepɨyutitetewiya kemɨtiyɨni kememɨtenieritɨarie hepaɨtsita. Hipameri mepɨkatewa'itaiya nawi kamixayari me'anakatɨkɨtɨ,  
\v 5 matsi yunaitɨ mɨpaɨ mekaniutiyuanekuni: “Ne Kakaɨyari niukameya nepɨkahɨkɨ, ne nemuka'etsa nekanihɨkɨtɨni. Temaikɨyaritɨtɨ ne, mana kwiepa nekatini'uximayaka”.  
\v 6 Xɨkata xewitɨ mɨpaɨ tiwaruta'iwawiya: “¿Ketitayari 'amamatsie peraxitekietɨka?”, mɨkɨ mɨpaɨ kanitayɨmɨkɨ: “Nehamikuma wakie neheyeikatɨ mɨya nepɨranuyetɨa”».   
\s1 'Uximatɨarika meta kemɨreuyehɨwiyarieni  
\q1
\v 7 Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:  
\q1 «'Ixipara, kenanukukexi, nemuxatsi wahɨweme kenaye'unietɨ,  
\q2 kenaye'unietɨ tewi 'aixɨa nemɨtimate.  
\q1 Muxatsi wahɨweme keneumi'a  
\q2 memɨtaxɨriexɨanikɨ muxatsi  
\q2 hikɨ neta muxatsi 'etsimemɨpepe nepɨtiwakwinitɨani».   
\q1
\v 8 Mɨpaɨ kanaineni Yawé:  
\q2 «'Ikɨ kwieyaritsie kiekatari mepayehaikariyarieni  
\q1 me'ayehutatɨ mekanikwi'iwakuni,  
\q2 hairieka miemete mekaniyuhayewakuni.   
\q1
\v 9 Peru mɨkɨ memuyuhayewaxɨ taipa nekaniwakayatsamɨkɨ,  
\q2 'aixɨa nepɨwayurieni pɨrata ke'aixɨa mɨ'itɨariwa taipa hepaɨ,  
\q2 nepɨwata'inɨata huru taipa kemɨti'inɨatsiwa hepaɨ.  
\q1 Hikɨ 'ana menetsi'ayexeiyatɨ mepakɨne  
\q2 neta nepɨwata'eiya.  
\q1 Ne mɨpaɨ nepɨtayɨni: “Mɨkɨ mepɨneteɨterima”,  
\q2 mɨkɨta mɨpaɨ mepɨtiyuani: “Yawé takakaɨyari kanihɨkɨtɨni”».   
\c 14  
\s1 'Arike Yawé kemɨtita'aita  
\p
\v 1 »Kerutsareme. Tukari kanaye'amɨkɨ Yawé yahainekaku, kepauka 'apiinite 'akaye'utɨma mɨtitapiyaxɨanitsie.  
\v 2 Nekaniwayuitɨamɨkɨ yunaime nuiwarite 'ekɨ memɨmatsitamienikɨ. 'Akiekaritsie mekaneutahaxɨakuni, piinite kiita mɨrayepitɨka mekateninawakuni meta kiekatari wa'ɨitama mepɨwatinanaimani. 'Ateɨterima hixɨata me'atɨ mepanuhapanieni xeime kwieyaritsie, peru hipatɨ xeikɨa mepɨyuhayewa 'ahetsɨa.  
\v 3 Hikɨ 'ana Yawé payeyani, kaniwatakwimɨkɨ mɨkɨ nuiwarite, kepauka kuyaxa muyutamemiwa hepaɨ.   
\p
\v 4 »Mɨkɨ tukaritsie Yawé Huriwa mati'u yemuriyaritsie kanitakexɨamɨkɨ, Kerutsareme 'aurie mekatsie tau manatineika hepatsie, hikɨ Huriwa mati'u yemuriyari hixɨata kanitsanimɨkɨ tau kemɨtiuyeika mɨpaɨ katinitsanimɨkɨ hutatɨ kanayexɨrimɨkɨ, xewitɨ tayeta kanitayunimɨkɨ xewitɨta tatsutɨa, hixɨapa waɨkawa 'ayeweritɨ kanayeimɨkɨ.  
\v 5 Hikɨ xeme xekaniyuta'unakuni mayeweritsie, karikɨ mɨkɨ 'Atsari mɨrakutewa paitɨ kaniye'atɨyeimɨkɨ. Xekaniyuta'unakuni kexemɨteyuta'unaxɨ kwie mutayuatsie 'Utsiyaxi ti'aitakaku, Kura kwieyaritsie. Hikɨ 'ana Yawé kaninuamɨkɨ takakaɨyari, hetsɨana miemete memɨpatsie yunaime warawitɨtɨ.   
\p
\v 6 »Mɨkɨ tukaritsie hekɨariya pumaweni meta pɨka'uhaɨtɨni.  
\v 7 'Ana mɨkɨ tukari yɨkɨ pɨ'aneni, Yawé xeikɨa mimate: tukari pɨkahexeiyani meta tɨkari, karikɨ kepauka taikai mayani, hekɨariya yaxeikɨa puxuaweni.   
\p
\v 8 »'Iya tukaritsie haa tukari tiyupitɨwame puhaneni Kerutsareme 'ayeneikatɨ, puhaneni witarita meta tsepa mɨtitaxata, hixɨata'atɨ yapaɨmetɨ peukakukeni Harakuna Mɨmɨkitsie, hixɨata'atɨta yapaɨmetɨ peukakukeni haramara Meritexaniyutsie.  
\v 9 Yawé katinita'aitamɨkɨ naime kwie kemɨyewatsie. Mɨkɨ tukaritsie Yawé yuxewitɨ xeikɨa Kakaɨyari pɨhɨkɨtɨni, mɨkɨ mɨyamɨtitewa xeikɨa pɨhɨkɨtɨni.   
\p
\v 10 »Kehewa mɨtiyetewatsie 'atsita Ximuni mɨtiyetewatsie 'uyenieretɨ, Kerutsareme hetɨa meukayunetsie, mɨkɨ kwieyari naitɨ 'akuweritɨ kanayeimɨkɨ. Matsi Kerutsareme yuyemuritsie pɨyuhayewani, yaxeikɨa pɨreukumaka, ye'atɨkaitɨ Wenikamini 'itupariyari manuwietsie meta Mexɨakame mɨtitewa 'itupari manuwietsie, meta 'itupari 'Itsikina mɨtitewa manuwietsie ye'atɨkaitɨ, metatsiere Kananeri tuxiyuyari manuwe ye'atɨkaitɨ 'atsita kaxie pɨname ti'aitame tipiinieya matineniere paitɨ ye'atɨkaitɨ.  
\v 11 Kerutsareme tawarita kiepa kanayeimɨkɨ, kayuwatɨ mepu'uwani, meta hatsuakuri pɨkaka'unarieni.   
\p
\v 12 »'Ikɨ kanihɨkɨtɨni 'uximatɨarika Yawé miyetuani kɨmana mɨtiwakwinitɨani nuiwarite kemɨ'ane Kerutsareme memutami: Me'ayeyuyurikaku wawaiyari pɨkapɨne, wahɨxite pɨtipɨne 'ayetetɨ wahetsie, meta waneni pɨtipɨne wateta.  
\v 13 'Iya tukaritsie Yawé waɨkawa memɨtimamanikɨ puwapitɨani. Yunaitɨ me'ayuye'unietɨ mepakɨne, mepɨyutikwini yu'iwamatɨtɨ.  
\v 14 Metatsiere Kura kwieyaritsie kiekatari mekaniyutakwikuni Kerutsareme kiekariyaritsie, hikɨ katinikuxeɨriyamɨkɨ yunaime hurawatari nuiwarite wapiinite mɨraye'atɨka, meta waɨkawa huru meta pɨrata meta kemarite.  
\v 15 Kwiniya 'etsiwatɨkaku mɨpaɨ 'anetɨ pɨwata'axiyata kawayutsixi meta muratsixi, kameyutsixi meta puxuri, meta yunaitɨ tewaxi mɨkɨ mematiteitsie memu'uwani.   
\p
\v 16 »Hikɨ kemɨ'ane memutawikwei yunaitɨ nuiwarite Kerutsareme memutami, mepeta'axeni xeiwiyari 'anuyeyeikakaku Ti'aitame hɨxie memɨkatunuma'unikɨ, Yawé Naimekɨmɨtɨrɨkaɨye, meta Xamaru 'ixɨarariyari memɨwewienikɨ.  
\v 17 Xɨka xewitɨ kiekari kaheuyani Kerutsareme Ti'aitame hɨxie ka'ukatunumakeni, Yawé Naimekɨmɨtɨrɨkaɨye hɨxie, mɨkɨ kiekaritsie pɨkahekawiye.  
\v 18 Xɨka 'ekipitutari mekaheukɨne, mɨkɨta yaxeikɨa mepɨkakawiyerieni. Yawé penunɨ'ani kwiniya mɨtiwakwinitɨanikɨ nuiwarite kemɨ'ane memɨkahu Xamaru 'ixɨarariyari memɨwewienikɨ.  
\v 19 Mɨpaɨ pɨtikwinitɨarieni 'Ekipitu meta yunaitɨ nuiwarite kemɨ'ane Xamaru 'ixɨarariyari memɨkawewiyu.   
\p
\v 20 »'Iya tukaritsie kawayutsixi wakapana 'etsimupepe 'ipaɨ pɨre'utɨkani: “Mɨpatsie Yawé Hetsie Mieme”. Xarite ti'etsame Yawé tukita mieme mɨkɨ pɨpatsietɨkani watsute 'amɨnene tewaxi mematikwikwiwa hɨxie mɨtitei hepaɨ.  
\v 21 Naitɨ xarite Kerutsareme mieme meta Kura kwieyaritsie miemete pɨpatsietɨkani Yawé Naimekɨmɨtɨrɨkaɨye hetsiemieme, hikɨ kemɨ'ane mana mɨtimawamie mɨkɨ yapaɨmeme panuhapani hikɨ muwa pɨreka'etsa. 'Ana mɨkɨ tukaritsie tetuayameteri mepumaweni Yawé Naimekɨmɨtɨrɨkaɨye tukita».   