\id LAM  
\h Hiwerika 
\toc1 Hiwerika kwikariyari 
\toc2 Hiwerika 
\toc3 Hiw 
\mt1 Hiwerika kwikariyari  
\c 1  
\q1
\v 1 Xɨa'ui, yuxaɨta puyuhayewaxɨ,  
\q2 kiekari meripaitɨ witsimɨ'anekai teɨteri warexeiyatɨ.  
\q1 'Ukaratsi wiura hepaɨ pɨtiyuxexeiya,  
\q2 meripaitɨ mumariwekai yunaime nuiwarite watsata.  
\q1 Meripaitɨ wamaama mɨhɨkɨtɨkai.  
\q2 Hikɨri waɨriyarika ti'uximayatame pɨhɨkɨ wahetsiemieme.   
\b  
\q1
\v 2 Tɨkakɨta kwinimieme tiutsuatɨ kaniukatariyarɨwani,  
\q2 'ukaiya 'aurieyatsie kaniukakɨkani.  
\q1 Nixewitɨtɨma muwanaki'eriekai  
\q2 hikɨ pɨkahenɨtɨwa.  
\q1 Hamikumama yunaitɨ mekaniku'eirieni,  
\q2 me'eye'unietɨ pɨta mekanakɨne.   
\b  
\q1
\v 3 Tixaɨtɨ karayeitɨarieka, tepɨa kaunariyarikɨ 'uwiwitɨarieka,  
\q2 Kura kanehanieni 'ateewa paitɨ.  
\q1 Hipame nuiwarite watsata meyuhayewakɨ,  
\q2 hikɨ 'uxipiya pɨkahekaxeiyawe.  
\q1 Yunaitɨ memiweiyakai mekanenuku'axe,  
\q2 pɨkaheixeiyari kemɨ'ane miparewieni.   
\b  
\q1
\v 4 Kerutsareme huyeyarite 'utɨma 'umietɨ puhiweriyɨkɨ,  
\q2 nixewitɨri patsiekamekɨ 'ixɨararipa memuyukuxexeɨriwatsie pɨkaheta'axe.  
\q1 Kiekari kitenieyarite yuxaɨtame puyuhayewaxɨa:  
\q2 mawari wewiwamete meputi'aiwa,  
\q1 'ukari 'ɨimarixi mekaneu'erietɨweni,  
\q2 mɨkɨ yunaitɨ 'atsiwimekɨ mekaniu'uwani.   
\b  
\q1
\v 5 Memɨwaraye'uniekai metewa'aitɨatɨ mekanakɨne,  
\q2 kayuwatɨ mekaniu'uwani memɨwaraye'unie.  
\q1 Yawé kaniwaru'uximatɨani,  
\q2 waɨkawa 'axamemɨte'uyurikɨ.  
\q1 Waniwema mekanewitɨkieni 'ateewa paitɨ,  
\q2 memɨwaraye'unie hau'erietɨ mekaniwaruhapaximekaitɨni.   
\b  
\q1
\v 6 Kerutsareme witsikemɨ'anekai  
\q2 naime witsikemɨtiyuxexeiyakai katineuyehɨani.  
\q1 Mana memɨte'aitakai maxatsi wahepaɨ mekani'aneni,  
\q2 'ɨxa memɨwautɨwe hakewa meheikaxeiya.  
\q1 Mekaniyuta'unani mekayɨwawetɨri,  
\q2 memɨwaruweiya wahɨxie.   
\b  
\q1
\v 7 Paye'eriwa Kerutsareme,  
\q2 kepauka yɨxaɨta nutuixietɨ 'amuyeikakai,  
\q1 meripaitɨ waɨkawa kemɨrexeiyakai pɨra'eriwa  
\q2 meripaitɨ mɨtipiinieyatɨkai.  
\q1 Kepauka memeye'unie hetsɨana memɨye'axɨa,  
\q2 nixewitɨ 'ana pɨkanua 'iparewienike.  
\q1 Memeye'unie mepixei kepauka matiwe,  
\q2 'ana mɨkɨ mepi'atsekai me'inanaimatɨ.   
\b  
\q1
\v 8 Kwinimieme 'axapɨtiuyuri Kerutsareme,  
\q2 'ayumieme ka'itiyatɨ kanayani.  
\q1 Meripaitɨ 'aixɨa memɨte'ixeiyakai hikɨ mepi'uxiwe'erie,  
\q2 maweme memɨxeiyakɨ,  
\q1 'ayumieme mɨkɨ putatsuaka,  
\q2 meta puyutewiya hɨxiena xɨka 'ixeiyamɨkɨni.   
\b  
\q1
\v 9 Kemarieya kaniutatɨnire,  
\q2 'atsipɨkareitimaitɨya 'arike hetsiena kemɨtiyɨnikekai.  
\q1 Kemɨratiwe pɨkatimaritɨa,  
\q2 kaniumawekaitɨni kemɨ'ane 'inɨtɨani.  
\q1 «Yawé, keneneuxeiya kenemɨtiuka'eniwa.  
\q2 Pɨnetsi'a'iwaxɨ mɨnetsi'aye'unie».   
\b  
\q1
\v 10 Meye'unie naime pɨtiyukapiinitɨa  
\q2 naime mɨraye'atɨka Kerutsareme mɨrexeiyakai,  
\q1 meta mɨkɨ puwaruxei tukita kepauka memeutahaxɨa  
\q2 hipatɨ teɨteri Kakaɨyari memɨka'ayexeiya,  
\q1 'ekɨ pemɨkawapitɨakai,  
\q2 muwa 'ateɨterima memɨwayutixexeɨriwatsie memeutahakeni.   
\b  
\q1
\v 11 Yunaitɨ teɨterimama mekaniutitsuanani,  
\q2 meta mekaniku'uwani 'ikwai meheuwautɨkaitɨ,  
\q1 yupiinite mɨraye'atɨkakɨ mekatenipatani 'ikwaikɨ  
\q2 memayeyuyurinikɨ 'akuxi.  
\q1 «Yawé, neuxei keneu'a'ɨwiya  
\q2 kehepaɨ memɨnetenanaima».   
\b  
\q1
\v 12 «Xeme huyeta xemuyekɨka, xekeneuyu'ɨwiya:  
\q2 ¿Kamɨtsɨ xekateyu'iyaritua nehetsiemieme?  
\q1 ¿Hakewa xewitɨ nehepaɨ 'aneme 'uximatɨarika pexeiya,  
\q2 Yawé 'uximatɨarika mɨnetsiyetuiri hepaɨ 'anekame?  
\q1 Yawé kepauka muyeha'a nehamatɨa,  
\q2 'ikɨ 'uximatɨarika kaneyenɨ'ani nehetsiemieme.   
\b  
\q1
\v 13 »Muyuawitsie Yawé tai kaneyenɨ'ani,  
\q2 mɨkɨ ne'umeyari 'ɨarime kaniutitaiya.  
\q1 Winiyari kaniukeni nehɨxie,  
\q2 hikɨ mɨpaɨ kanetiniukunuitɨani.  
\q1 Kaneniuku'eirieni yuheyemekɨ,  
\q2 tukarikɨ yanekatineumɨmɨkɨni.   
\b  
\q1
\v 14 »'Axakenemutiuyuri pahete nehetsie yuku hepaɨ,  
\q2 Kakaɨyari katiniuyurieni mɨnetsi'utitɨtɨa.  
\q1 Nekɨipitɨa kanenakatɨtɨani,  
\q2 'ariri kɨmana nekani'uxeni.  
\q1 Kaneniyetuani 'iya teɨteri wahetsɨa  
\q2 kemɨ'ane nemɨkawakema nemɨwatanewieni wahetsɨa.   
\b  
\q1
\v 15 »Nekiekaritsie Yawé nekuyaxima  
\q2 yunaime pɨkawaruparewi,  
\q1 hipame pɨta kuyaxi kaniwarukuxeɨrieni memɨnetsitamienikɨ,  
\q2 meta netɨɨriyama memɨwarakuxɨtɨanikɨ.  
\q1 Yawé kanitapɨna yukiekari minaki'erie 'ɨimari Kura niweya,  
\q2 kaxie kemɨtipɨnarɨwa winu mayanikɨ hepaɨ.   
\b  
\q1
\v 16 »'Ikɨ naitɨ pɨnetsitsuaritɨa,  
\q2 hiwerikakɨ nepɨkaheuniereri.  
\q1 Xewitɨ 'ahurawa pɨka'uyeika mɨnetsinɨtɨanikɨ,  
\q2 meta mɨnetsituikakɨ.  
\q1 Neniwema mekaneutaxɨriexɨani  
\q2 mɨtatsi'aye'unie mɨtatsi'a'iwaxɨkɨ».   
\b  
\q1
\v 17 Tsiyuni pahiwa parewiya ha'iwawatɨ,  
\q2 peru pumawe xewitɨ minɨtɨanikɨ.  
\q1 Yawé mɨpaɨ tiuta'aitaku  
\q2 Kakuwu 'aurie mematetɨkatei hikɨ mepeye'unie,  
\q1 hikɨ Kerutsareme kanihɨkɨtɨni  
\q2 xatsi xeikɨa meta mɨka'itiya.   
\b  
\q1
\v 18 «Yawé heitserie kanexeiyani,  
\q2 peru ne 'aitsikateyatsie yanepɨkatikatɨa.  
\q1 Xekeneu'enana, xeme hikɨ teɨteri,  
\q2 kenemɨtiuka'eniwa xekeneuyu'ɨwiya.  
\q1 Mekanehapanieni 'ateewa paitɨ  
\q2 nehetsɨa miemete temari meta 'ɨimarixi.   
\b  
\q1
\v 19 »Meripaitɨ nemɨwanaki'eriekai nekaniwarutahɨawe,  
\q2 peru mɨkɨ mekaneniuku'eirieni.  
\q1 Mawari wewiwamete meta 'ukirawetsixi nehetsɨa miemete  
\q2 yunaitɨ kiekaritsie mekaniukwini,  
\q1 'ikwai mekuwautɨwetɨ,  
\q2 'akuxi memayeyuyurinikɨ.   
\b  
\q1
\v 20 »Yawé, keneneuxeiya nepɨtiuka'eniwa.  
\q2 'Ari nepi'enie nepɨmɨxime.  
\q1 Ne'iyari pɨkayumaiwe,  
\q2 kwinimieme nemɨkaheu'enakaikɨ.  
\q1 Netɨɨriyama mekaniukwi'iwa takwa,  
\q2 'upaitɨta mɨɨya xeikɨa kanixuaweni.   
\b  
\q1
\v 21 »Teɨteri netsuari mekani'enieka,  
\q2 xewitɨ kaniumaweni mɨnetsinɨtɨani.  
\q1 Yunaitɨ memɨnetsi'aye'unie mekatenimaika kenemɨtiuka'eniwa,  
\q2 mekaniyutemamawieka nehetsie kepemɨtiuyurikɨ.  
\q1 'Ari kenanɨ'a 'uximatɨarika kepemutayɨ,  
\q2 mɨkɨta mɨpaɨ memɨte'uka'eniwanikɨ ne kenemɨtiuka'eniwa.   
\b  
\q1
\v 22 »'Ahetsɨa paitɨ keheye'ani  
\q2 tita ke'axamemɨte'uyuri.  
\q1 Kepemɨnetiupitɨa 'uximatɨarika ke'axanemɨtiuyurikɨ,  
\q2 mɨkɨta mɨpaɨ ketiniwarupitɨa.  
\q1 'Ari pɨmɨire kenemɨtiutatsuaka,  
\q2 meta ne'iyari 'ari pɨkɨmɨmɨkɨ».   
\b  
\c 2  
\q1
\v 1 Xɨa'ui, Tsiyuni niweya witsimɨti'ɨimarikai Yawé 'akɨyɨwime kanayeitɨani  
\q2 yuhaxɨa kwauniyarikɨ.  
\q1 Muyuawitsie paitɨ kwiepa kamenakahɨani, haweri pe'anekame  
\q2 kamenayeitɨani kepemɨtimariwekai 'Ixaheri.  
\q1 Kepauka mɨmetsi'uka'unaxɨ ha'atɨ katinatɨmaiya  
\q2 kemɨti'aitakai 'ena kwiepa.   
\b  
\q1
\v 2 Yawé pɨtiuka'unaxɨa katinenimayatɨ  
\q2 naime 'ixaheritsixi wakii,  
\q1 meta ha'atɨ kanika'una  
\q2 Kura witsimɨti'ɨimari hakewa meyutɨrɨkariyakai,  
\q1 meta tixaɨtɨ pɨkarayeitɨa  
\q2 mana ti'aitame meta 'iparewiwamete kaniwarukwini.   
\b  
\q1
\v 3 Yemekɨ Kakaɨyari waɨkawa kaniuyeha'ani,  
\q2 naime 'Ixaheri tɨrɨkariyaya kanakuyeitɨani.  
\q1 Mɨtatsi'aye'unie kaninuani tahetsɨa,  
\q2 hikɨ 'ana Yawé pɨkatatsi'uparewi.  
\q1 Kakuwu hetsie tai manutatani hepaɨ 'anetɨ,  
\q2 watixɨtsitɨaximetɨ yunaime 'auriena mematetɨka.   
\b  
\q1
\v 4 Mɨtatsi'aye'unie hepaɨ, yutupi kaniukuha'aritɨani,  
\q2 yutseriekɨ pekwekai.  
\q1 Mɨtatsi'aye'unie hepaɨ, kaniwarukwini  
\q2 nehetsɨa miemete temuwanaki'erie.  
\q1 Yuhaxɨa tai hepaɨ 'aneme kaniukawiwieni  
\q2 Tsiyuni witsimɨti'ɨimari 'ixuriki kiiya hetsie.   
\b  
\q1
\v 5 Yawé mɨtatsi'aye'unie hepaɨ pɨtiyurie:  
\q2 'Ixaheri kaniuka'una.  
\q1 Naime paratsiyuya kaniuka'una  
\q2 meta hakewa meyutɨrɨkariyakai.  
\q1 Putimɨiriyaxɨ tahiwerika meta ta'ukai,  
\q2 Kura witsimɨraku'ane hetsiemieme.   
\b  
\q1
\v 6 Xewitɨ xamaru makumaweriya hepaɨ,  
\q2 mɨpaɨ yutuki katiniuka'una.  
\q1 Yawé Tsiyuni pɨratɨmaiyatsitɨa  
\q2 xawati mɨka'utiwewiwanikɨ meta patsiekamekɨ kememɨteyukuxexeɨriwa 'ixɨarariyari,  
\q1 ti'aitame hepaɨtsita puyeha'a  
\q2 meta puwaruhayewaxɨ mawari wewiwamete hetsɨana memɨmiemetetɨkai.   
\b  
\q1
\v 7 Yawé yumawari taiyame puka'utanaki'eri,  
\q2 muyepatsie kaniuku'eirieni.  
\q1 Kaniyetuani memɨtatsi'aye'unie wahetsɨa  
\q2 kuraru paratsiyu mukunakai.  
\q1 Yawé tukita meputihiwa  
\q2 'ixɨarari mɨwewiyaka hepaɨ.   
\b  
\q1
\v 8 Yawé puyuwaɨri mika'unakɨ  
\q2 kuraru 'amatayewa Tsiyuni witsimɨti'ɨimari warie maka.  
\q1 Kɨye 'utikweka kani'inɨata,  
\q2 hikɨ kanika'una ka'inenimayatɨ.  
\q1 Hiwerika putixuawerixɨ tetsariya 'imɨmɨiyarite mɨranutikɨkatɨre meta kurarute 'amatitetewa wahetsiemieme,  
\q2 mɨkɨ naitɨ kaniuka'unarieni.   
\b  
\q1
\v 9 'Ituparite kaneuxɨriexɨani kwiepa kaniyuhayewa,  
\q2 kaneimuraxɨani 'ituparite warita mauku'uwe.  
\q1 Ti'aitame meta 'iparewiwamete  
\q2 mekane'uwani hipame nuiwarite watsata,  
\q1 'inɨari niukiyari pɨkakuxaxatsiwari meta Kakaɨyari niukametemama mepɨka'u'uwari,  
\q2 Yawé pɨkatiwaxeitsitɨari.   
\b  
\q1
\v 10 Tsiyuni witsimɨraku'anekaitsie, mana 'ukirawetsixi  
\q2 kwiepa mepeutitei kayuwatɨ xeikɨa,  
\q1 yumu'utsie naxi meheutiwiwatɨ  
\q2 meta hiwerika kamixayari me'anakatɨtɨkaitɨ.  
\q1 Kerutsaremetari 'ɨimarixi  
\q2 mekaneutiteni kwiepa me'akatututsitɨ.   
\b  
\q1
\v 11 Tsuarikɨ nehɨxite pɨtixɨxime,  
\q2 'ariri kakwaniwemekɨ nepeɨmɨmɨkɨ.  
\q1 Yemekɨ ne'iyarikɨ nepɨkaheuwaɨre  
\q2 nekiekari muka'unariekɨ.  
\q1 Tɨɨritɨtɨ yakɨ memɨyumate mekanitiweranareni,  
\q2 'ikɨ kiekari kayeyarite 'utɨma.   
\b  
\q1
\v 12 Tɨɨri yumaamama mɨpaɨ metewaku'iwawiyatɨ:  
\q2 «¿Hakewa pexuawe 'ikwai meta winu?»,  
\q1 'anari mepatixɨrɨwe kaye'utɨma  
\q2 mekwikwi'itɨ memɨte'uhipite hepaɨ,  
\q1 meta memɨtsitsewe wamaamama mewareukɨ'ɨkaku  
\q2 'imatɨrieka mepuka'ietɨkɨka.   
\b  
\q1
\v 13 ¿Kehepaɨ netayɨni 'ahetsiemieme, Kerutsareme witsipemɨti'ɨimari?  
\q2 ¿Kemɨ'ane hepaɨ pepɨ'ane?  
\q1 ¿Ketita 'inɨariyarikɨ nemetitahɨawe nemɨmatsinɨtɨanikɨ,  
\q2 kiekari Tsiyuni 'ɨimari?  
\q1 Haramara kemeukatewa hepaɨ pɨ'ane 'akwinitɨarika.  
\q2 ¿Kemɨ'ane 'aku pɨyɨwe mɨmatsi'u'uayemani?   
\b  
\q1
\v 14 Kakaɨyari niukametemama 'ahetsɨa miemete mepɨmate'utaxatɨa  
\q2 'itarikakɨ kename kehapaɨ mete'unenierixɨ.  
\q1 Mepɨkamatsi'utahekɨataxɨ ke'axapemɨtiyurienekai,  
\q2 'ateɨterima kememɨte'anuhapanienikekai mepɨka'itaxataxɨ.  
\q1 Niuki memɨmatsikuxaxatɨwakai  
\q2 'itarika xeikɨa pɨhɨkɨtɨkai.   
\b  
\q1
\v 15 Keyupaɨmetɨ mana huyeta memuyekɨka  
\q2 mematsixeiyatɨ mekameninanaimaka mekateniutapineni.  
\q1 'Ahetsiemieme Kerutsareme witsipemɨ'anekai, nanaimarika mepɨwewie,  
\q2 meta me'utiwikɨayatɨ mɨpaɨ mepɨte'u'iwawa:  
\q1 «¿'Ikɨ xeniu tihɨkɨ kiekari witsimɨ'ane?  
\q2 ¿'Ikɨ xeniu kiekari waɨkawa temawierika mexeiya tihɨkɨ yunaime muwara'iwa?»   
\b  
\q1
\v 16 Yunaitɨ memɨmetsi'aye'unie meputiniuka  
\q2 'axametekuxatatɨ 'ahepaɨtsita,  
\q1 yutamete me'utixikauteketɨ, mematsinanaimatɨ mɨpaɨ meputiyuane:  
\q2 «'Ayeniereme tekaniutakwani.  
\q1 Tukari paye'a temikwewiekai,  
\q2 hikɨri 'ari tahɨxikɨ tepixei».   
\b  
\q1
\v 17 Yawé kaneye'atɨani kemɨtiku'eriwakai,  
\q2 kaneye'atɨani yuniuki,  
\q2 meripaitɨ kemutayɨkai.  
\q1 Kametsinenimayatɨ kwiepa kamenehɨani,  
\q2 katiniupitɨani mɨmatsi'aye'unie mɨmatsitananaimanikɨ,  
\q2 mɨkɨ pɨtata watɨrɨkariya mariweme kanayeitɨani.   
\b  
\q1
\v 18 Teɨteri wa'iyari  
\q2 Yawé mekanihiwieka mete'uka'eniwatɨ.  
\q1 Tsiyuni witsipemɨ'ane 'akuraru 'amatitɨtɨ,  
\q2 tukarikɨ tɨkarikɨ keneuhayewa  
\q2 tsepa 'a'ukai muhanenikɨ haa hepaɨ.  
\q1 Hawaikɨ 'etsiwa pepɨka'uxipieka.  
\q2 'A'ukai pepɨkaheununuitɨwani.   
\b  
\q1
\v 19 Kenanukukeka keneutahiwani tɨkarikɨ,  
\q2 kepauka tɨkarikɨ tehɨwemete memitsutɨanitsie.  
\q1 Keneu'eiri 'a'iyari 'ukaiya  
\q2 mawari kenayeitɨa Yawé hɨxie.  
\q1 Keneyunenewieka Kakaɨyari hetsɨa kenewauka teikɨ pehemetɨ  
\q2 'atɨɨriyama watukari hetsiemieme,  
\q1 haakakɨ memɨkwixime  
\q2 kaye'utɨma memeutihe.   
\b  
\q1
\v 20 «Neuxei Yawé, keneu'ati'iyaritɨa:  
\q2 ¿Kemɨ'aneri mɨpaɨ pepɨtiukwinitɨa meripaitɨ?  
\q1 ¿Kamɨtsɨ 'ukarawetsixi yuniwema metewatikwani  
\q2 yuhetsie memɨwarayexei?  
\q1 ¿Metekwi'iwa tsɨkamɨ mawari wewiwamete meta 'ahetsiemiemete niukamete  
\q2 Yawé 'atuki muyepatsietsie?   
\b  
\q1
\v 21 »'Ukirawetsixi meta temari yunaitɨ  
\q2 kaye'utɨma tumuanaritsata mekanitiheni,  
\q1 temari meta 'ɨimarixi nehetsɨa miemete  
\q2 'ixiparakɨ mekaniukwi'iwa.  
\q1 Peha'atɨ watukari pekaniwarunawairieni,  
\q2 pekaniwarukwini pekawanenimayatɨ.   
\b  
\q1
\v 22 »'Ixɨararipa pemɨta'inieni hepaɨ,  
\q2 kenemɨtika'unarienikɨ naitsarie pekatiniutanɨ'axɨani.  
\q1 Kepauka Yawé pemuyeha'a  
\q2 nixewitɨ pɨkayɨwekai muyuta'una, meta nixewitɨ pɨka'uyuhayewaxɨ 'ayenieretɨ.  
\q1 Kemɨ'ane waɨkawa nemɨwanaki'eriekai meta nemɨtiwaruti'ɨkitɨa,  
\q2 mɨkɨ yunaime mɨtatsi'aye'unie kaniwarukwini».   
\c 3  
\b  
\q1
\v 1 Ne nekanihɨkɨtɨni nemɨtiuka'eniexɨa 'uximatɨarikakɨ  
\q2 Kakaɨyari 'uyeha'aka yukɨyekɨ pɨnetsi'uwa.   
\q1
\v 2 Kaneniupitɨani yɨwipa nemuyeikanikɨ,  
\q2 hekɨariyatsie pɨkanetsi'upitɨari.   
\q1
\v 3 Yakanetini'uximatɨaka,  
\q2 heiwatɨma xeitukari pɨka'anukayeika.   
\b  
\q1
\v 4 Newaiyari meta nenawiyaritsie pɨnetsi'utawatsiɨxaxɨ,  
\q2 ne'umeyari pakamuraxɨa.   
\q1
\v 5 Pɨnetsi'ukurarutɨiyaxɨ  
\q2 'axamɨti'anekɨ meta nemɨtiuka'eniwanikɨ.   
\q1
\v 6 Waɨriyarika kaneninɨ'aka yɨwipa xeikɨari nemuyeikanikɨ,  
\q2 meripaitɨri memukwi wahepaɨ.   
\b  
\q1
\v 7 'Ukaneniyenaka, nepɨkayɨwe nemɨyuta'una,  
\q2 tepɨa kaunariyarikɨ mahetekɨ kaneniuhɨani.   
\q1
\v 8 Tsepa karima nemutahiwa tsepa parewiya nemɨwawa,  
\q2 mɨkɨ nenenewieri pɨka'enimɨkɨ.   
\q1
\v 9 Nehuyeta tetexi puyatsaxɨ,  
\q2 meta nehuye waɨkawa pekutunaxɨa.   
\b  
\q1
\v 10 Kakaɨyari pɨnetsi'awiexeiyane hutse mɨtihupie hepaɨ,  
\q2 meta maye hepaɨ pɨnetsihupie.   
\q1
\v 11 Huyeta kanenanayehanani mɨnetsititsanaxɨanikɨ,  
\q2 haweri ne 'anekame mɨnetsihayewakɨ.   
\q1
\v 12 Yutupi 'ukuha'aritɨaka,  
\q2 kanenimɨneni xeikɨa.   
\b  
\q1
\v 13 Ne'iyaritsie kaneniutamɨni  
\q2 yu'ɨrɨtekɨ metɨkɨta miemetekɨ.   
\q1
\v 14 Ne, 'atsieriwame xeikɨari nekanihɨkɨtɨni yunaime teɨteri wahɨxie,  
\q2 tukarikɨ nehɨxie mekaniutikwikani menetsinanaimatɨ.   
\q1
\v 15 Hatsiwimekɨ xeikɨa kaneniutahɨniya,  
\q2 meta kaneniu'itɨani tsiɨrika hepaɨ ratsiwime.   
\b  
\q1
\v 16 Netsi'uwiyaka kwiepa katiniukatuaxixɨani nekɨmana,  
\q2 tumuanari nemɨtikwanikɨ kaneniupitɨani.   
\q1
\v 17 Pɨnetsi'unawairi kayuwatɨ kenemɨrexeiyakai,  
\q2 'aixɨa 'iyari 'uyeikatɨ kemɨreu'erieka nepɨka'imateri.   
\q1
\v 18 Hikɨ mɨpaɨ nekaniutaineni: «Netukari pɨtixɨxime,  
\q2 meta neta'ikwewatɨ Yawé hetsiemieme».   
\b  
\q1
\v 19 Kena'eriwani kuyeikame nemɨhɨkɨ netiuka'eniwatɨ,  
\q2 ratsiwimekɨ nemɨmɨximekɨ.   
\q1
\v 20 Mɨpaɨ tsiere nepɨtiku'eriwa,  
\q2 'ayumieme mɨkɨkɨ nepaunutuixie ne'iyaritsie.   
\q1
\v 21 Peru 'akuxi tawarita mɨpaɨ nepɨtiku'eriwa,  
\q2 mɨkɨ waɨkawa neta'ikwewame pɨnetsihayeitɨwa:   
\b  
\q1
\v 22 Yawé naki'eriyaya mɨmariwe hatsuaku pɨkakumawere,  
\q2 meta kemɨtiyukanenimaya hatsuaku pɨkaxɨni.   
\q1
\v 23 Xexuime ximeriyaritsie pihekwariya kemɨtiyukanaki'erie,  
\q2 pɨmariwe ke'aixɨa mɨtiuka'iyari.   
\q1
\v 24 'Ayumieme 'imatɨrieka, mɨpaɨ neputaine:  
\q2 «Yawé xeikɨa kanihɨkɨtɨni tita nemɨrexeiya.  
\q2 'Ayumieme hetsiena xeikɨa netiwiyatɨ nepɨta'ikwewani».   
\b  
\q1
\v 25 Yawé 'aixɨa katiniuka'iyarini kemɨ'ane yuri memɨte'erie hetsiena wahetsie,  
\q2 meta kemɨ'ane memikuwautɨwe wahetsiemieme.   
\q1
\v 26 'Aixɨa kani'aneni kayuwatɨ 'umatɨ mitakwewieka,  
\q2 Yawé mayenenikɨ tatsitawikweitsitɨanike.   
\q1
\v 27 'Aixɨa pɨ'ane xɨka tewi retimani  
\q2 yuku mɨtitɨnikɨ temaikɨyari hepaɨ.   
\b  
\q1
\v 28 Xekeneuhayewa yuxaɨtame xeikɨa muyuhayewanikɨ,  
\q2 mɨpaɨtsɨ Yawé katinipitɨani.   
\q1
\v 29 Tumuanaripa yɨhɨxima keheuhakeni.  
\q2 Heiwatɨ 'akuxi 'uparewiyani.   
\q1
\v 30 Tawarita ta'aurie kehaweni tapata yu'auritapa mɨtikwinitɨarienikɨ,  
\q2 para mɨpaɨ 'axa'itɨarietɨ muyuhayewanikɨ.   
\b  
\q1
\v 31 Yawé katanexɨrieni,  
\q2 peru yuheyemekɨ pɨkatatsihexɨrieni.   
\q1
\v 32 Waɨkawa temɨte'uka'eniwanikɨ pɨtatsipitɨa, peru pɨtatsitinenimayata,  
\q2 naki'eriyaya mɨmariwekɨ.   
\q1
\v 33 Ti'aitame pɨtatikwinitɨa meta pɨtatsihiweritɨa  
\q2 peru mɨpaɨ mɨtinakekɨ pɨkatiyuriene.   
\b  
\q1
\v 34 Kepauka memɨtiketsinarɨwa  
\q2 yunaitɨ pɨretsutsixi kwiepa memɨtama,   
\q1
\v 35 kepauka 'Amutewi hɨxie  
\q2 tewi heitserie kemɨrexeiya mɨpaɨ mɨkatipitɨarie,   
\q1
\v 36 kepauka heitseriemekɨ mɨkaparewiya,  
\q2 ¿Yawé tamɨ mɨpaɨ karetimamateke?   
\b  
\q1
\v 37 ¿Kemɨ'ane pɨyɨwe tixaɨtɨ hepaɨtsita mɨtiutaxata 'ariketa hekɨatsime mayeitɨani  
\q2 Yawé mɨpaɨ kahainekaku?   
\q1
\v 38 ¿Tamɨ Kakaɨyari xeikɨa yahainekaku yakatikuyɨne,  
\q2 mɨtiutixuxuawere 'axati'anetɨ meta 'aixɨati'anetɨ?   
\q1
\v 39 ¿Titayari 'ayeyuritɨ 'axaraineni  
\q2 kemɨ'ane 'axatiuyurieyu mɨtiukwinitɨarienitsie?   
\b  
\q1
\v 40 Neuxei hikɨmɨ tepɨtatimaixɨani yateteku'eriwatɨ  
\q2 hikɨ 'ana tepɨ'axɨani Yawé huyeya 'utɨa.   
\q1
\v 41 Tekaninɨawakakuni Kakaɨyari muyuawitsie makawe  
\q2 ta'iyarikɨ meta tamamatekɨ.   
\q1
\v 42 'Axatepɨte'uyuri, temɨkaheu'enana tepɨhɨkɨ,  
\q2 'ekɨta pepɨka'awaɨriya pemɨtareuyehɨwirienikɨ.   
\b  
\q1
\v 43 Waɨkawa peha'atɨ pekataniuweiyani,  
\q2 pekatanikwika pekatatsinenimayatɨ.   
\q1
\v 44 Haiwitɨritsata pepɨ'ati'awiwieta  
\q2 tanenewieri pemɨka'eniekakɨ.   
\q1
\v 45 Tepɨa temɨxikiyari mɨkaheuyewetse hepaɨ,  
\q2 pekataneutaxɨriexɨani nuiwarite watsata.   
\b  
\q1
\v 46 Yunaitɨ memɨtatsi'aye'unie meputiniuka  
\q2 tahetsiemieme xeikɨa 'axamepɨtekuxata.   
\q1
\v 47 'Ari tepatixɨriya tete'uka'eniwatɨ temariutsietɨ,  
\q2 kepauka takiekari muta'unarie.   
\q1
\v 48 Haa muhane hepaɨ pɨyɨne ne'ukai ne'auritsie,  
\q2 neteɨterima wakiekari mɨmariwe muka'unariekɨ.   
\b  
\q1
\v 49 Nehɨxite xɨari pɨkayunixɨani 'ukaikɨ,  
\q2 katihayewatɨ meta xewitɨ ka'inɨtɨakaku,   
\q1
\v 50 kepaukake muyuawitsie paitɨ  
\q2 Yawé mɨtatsihaye'erieni mɨtatsixeiya.   
\q1
\v 51 Pɨnetsihekukukuine yemekɨ ne'iyari taɨta paitɨ,  
\q2 newaxeiyatɨ 'ukarawetsixi mete'uka'eniwame nekiekaritsie kiekatari.   
\b  
\q1
\v 52 Memɨnetsi'aye'unie mekaneniuweiyani nitixaɨtɨ mekatehayexeiyatɨ nehamatɨa,  
\q2 wiki hepaɨ mekaneniwiniyatɨweni.   
\q1
\v 53 Ne'ayeniereme mekaneniteukikuni  
\q2 tetexikɨ menetsiheukananike newatiyanikɨ.   
\q1
\v 54 Haa nemu'utsie paitɨri kaniuku'atɨkani,  
\q2 'ari mɨpaɨ katinimatsiɨkɨni netukari kaniutixɨni.   
\b  
\q1
\v 55 Hikɨ meukatewatsie mɨki teukiyata  
\q2 nekameniutahɨawe, parewiya Yawé nekameniutawawirieni,   
\q1
\v 56 'ekɨta pepɨnetsi'u'eni kenemɨmatiwawiriekai yemekɨ,  
\q2 hawaikɨ pepɨkaheikanaxɨa 'a'enakareme ne kenemutainekai karima.   
\q1
\v 57 Ne nepɨmatsi'utahɨawixɨ, hikɨ 'ekɨ nehetsɨa pepunua,  
\q2 mɨpaɨ pepɨnetiutahɨawixɨ: «Pepɨkamaka».   
\b  
\q1
\v 58 Yawé, 'ekɨ nehetsie peputanua  
\q2 'ana netukari peputawikweitsitɨa.   
\q1
\v 59 Yawé, 'ekɨ pepunierixɨ ke'aixɨa nemɨkatixeiyariekai,  
\q2 nehetsiemieme kemɨtiheitserie 'aixɨa ketineuyuri.   
\q1
\v 60 'Ekɨ pepuwaruxei kwinimieme kemenete'aye'unietɨ memɨnetsi'uyuri  
\q2 meta pepɨtimaikai kememɨteku'eriwakai nehetsiemieme.   
\b  
\q1
\v 61 Yawé, 'ekɨ pepɨwaru'eni ke'axamemɨtate'utahɨawixɨ  
\q2 meta naime kememɨteku'eriwakai nehetsiemieme,   
\q1
\v 62 'ekɨ pepɨtimate tukarikɨ memɨnetsi'aye'unie  
\q2 mepɨnetsikuxata kememɨteyurieni nehetsiemieme.   
\q1
\v 63 Keniwaruxeiya. Tsepa kememɨteyurie  
\q2 mekaneninanaimaka me'utikwitɨ.   
\b  
\q1
\v 64 Yawé, yaketiniwarakapitɨa,  
\q2 naime kememɨte'uyurikɨ.   
\q1
\v 65 Mekatemaiwaweme keniwarayeitɨa,  
\q2 'axamɨti'ane wahetsie ketiunake.   
\q1
\v 66 Yawé, keniwaranukuweiya peha'atɨ,  
\q2 'ena kwiepa keniwarakumaweriya.   
\c 4  
\b  
\q1
\v 1 Huru 'ari pɨka'utixawatɨre.  
\q2 Huru 'aixɨamɨ'ane putayɨrixɨ puyutakwitama.  
\q1 Tetexi mɨpatsietɨka kwinimieme mɨraye'atɨka tukita timieme kaye'utɨma katineutiteni.   
\b  
\q1
\v 2 Tsiyuni kiekatari,  
\q2 meripaitɨ mepɨtehaye'akai huru kemɨraye'axe,  
\q1 hikɨri haxu xariteyari hepaɨ mepɨtexeiyarie,  
\q2 'iwewame nenikamɨti'ane mitiwewi.   
\b  
\q1
\v 3 Yeutari memayu'eririya yutsitsi mepɨyexata  
\q2 yuniwema mepɨwatsitsitɨa,  
\q1 peru 'ukari Kerutsaremetari mepɨka'u'iyari.  
\q2 Yuniwema mepɨwata'e'eiriwa 'aruxi 'amemɨnene makumawetsie memu'uwa wahepaɨ.   
\b  
\q1
\v 4 Tɨɨri yemekɨ waɨkawamekɨ mepeuhariku,  
\q2 waneni 'ari puwawaki.  
\q1 Paa tɨɨri mekaniku'iwawani,  
\q2 peru neuxei nixewitɨ pɨkawamimɨkɨ.   
\b  
\q1
\v 5 Kemɨ'ane meripaitɨ memɨte'utikwa'akai witsiti'anekame  
\q2 hikɨ mekanikwiximeni haakakɨ kaye'utɨma.  
\q1 Meripaitɨ witsimemɨte'ukemarikai mɨyɨtsikimaɨyekɨ  
\q2 hikɨ xatsitsata mekanikurupetɨweni.   
\b  
\q1
\v 6 Ke'axamemɨte'uyuri Tsurumatari  
\q2 matsi kwinimieme 'axamepɨte'uyuri Kerutsareme kiekatari,  
\q1 yapauka kaniuka'unarieni,  
\q2 nixewitɨ pɨka'iparewi.   
\b  
\q1
\v 7 Kwinimieme matsi mepɨtetuxakai mana te'aitamete 'ɨwi hepaɨ,  
\q2 meta retsi hepaɨ,  
\q1 wawaiyari yemekɨ pɨtataɨrawikai,  
\q2 Tete mɨraye'axe mutimerɨka hepaɨ mepɨteyuxexeiyakai.   
\b  
\q1
\v 8 Peru hikɨ kwinimieme mepɨteheutɨtɨni keyuri yɨxari,  
\q2 nixewitɨ pɨkawamate kaye'utɨa.  
\q1 Yuwaiyaritsie kwinimieme mekateniwawakini kɨye hepaɨ,  
\q2 wa'umeyaritetsie kaniuwerixɨani.   
\b  
\q1
\v 9 'Aixɨa mekani'itɨarieka kemɨ'ane memukwi'iwaxɨ 'ixiparakɨ,  
\q2 keyuri haakakɨ memukwi.  
\q1 Haaka wara'iwakaku mekanitakukuweni,  
\q2 karikɨ mɨtiumawekɨ 'ikwaxite 'ɨtsita timieme.   
\b  
\q1
\v 10 'Ukarawetsixi 'aixɨa memɨte'u'iyarikai, yumamá mekaniuhɨniri  
\q2 yuniwematɨme mekaniwaruka'etsa.  
\q1 Yuniwema wahekɨ mekatenikwakaitɨni,  
\q2 kepauka Kerutsareme muka'unarietsie.   
\b  
\q1
\v 11 Yawé yuhaxɨa kaniutatuani,  
\q2 yuhaxɨa mɨtiyukukuine kananayetuani.  
\q1 Tsiyuni taikɨ kaniutataiya  
\q2 meta kanitaxɨtsitɨani tsutɨmeyari naime.   
\b  
\q1
\v 12 Mɨpaɨ mepɨkateha'eriwakai naitsarie te'aitamete,  
\q2 meta yunaitɨ teɨteri naitsarie kiekatari,  
\q1 kename Kerutsareme memaye'unie  
\q2 kiteniena meheutahaxɨanikekai.   
\b  
\q1
\v 13 Peru mɨpaɨ katiniɨyɨni.  
\q2 Kakaɨyari niukametemama 'axamete'uyurieku.  
\q2 Mawari wewiwamete 'axamete'uyurieku.  
\q1 Teɨteri 'axamekateyuriekame memɨwarukwikɨ  
\q2 kiekaritsie kaye'utɨma.   
\b  
\q1
\v 14 Yumamatetsie meheuxuxuretɨ,  
\q2 kaye 'utɨma mekaniu'uwani memɨkaheuneniere wahepaɨ meyɨatɨ.  
\q1 Xewitɨtɨma pɨkayuwaɨriya muwamayɨanikɨ  
\q2 tsikeretɨma wa'ixurikitsie.   
\b  
\q1
\v 15 Teɨteri mɨpaɨ mekateniwaruhiwiwani: «'Ena xepɨka'u'uwani, xemɨka'itiya.  
\q2 Xekeneuhuni. Xekeneuhuni. Xepɨkatatsikumaɨwani tame».  
\q1 Hipame nuiwarite watsata mɨpaɨ mekatenikɨhɨawarɨwani:  
\q2 «Ku'uwamete mekanihɨkɨtɨni, memuyu'unaxɨaxime.  
\q2 Mepɨkayɨwawe 'ena memu'uwani yuheyemekɨ».   
\b  
\q1
\v 16 Yawé tɨtɨ katiniuyurieni muwareutaxɨriexɨa,  
\q2 hikɨri pɨkayu'iyaritɨa wahetsiemieme.  
\q1 Mawari wewiwamete mamariwawemete mepɨkaxatsiwa  
\q2 meta 'ukirawetsixi mepɨkanenimayatsieri.   
\b  
\q1
\v 17 'Imatɨrieka, tahɨxite pɨtitɨximeri  
\q2 teta'ikwewatɨ yakɨxeikɨa xewitɨ tatsiparewienike te'erietɨ.  
\q1 Tuxiyutsie paitɨ tetanenieretɨ tekanita'ikwewani  
\q2 hipatɨ teɨteri memɨtatsitawikweitsitɨanikɨ.   
\b  
\q1
\v 18 'Etsiwa temuku'uwatsie tepuhupierie,  
\q2 kaye 'utɨma temɨye'uwani pɨkayɨweri.  
\q1 Ta'imatɨrieka tukariyari kanehuraniri, 'ariri kanaye'ani,  
\q2 tatukari naitɨ pɨ'inɨatsie.   
\b  
\q1
\v 19 Memɨtatsi'aye'unie matsi kwinimieme mepayɨwawekai  
\q2 keyuri kwixɨtsi muyuawitsie miemete,  
\q1 hɨritsie mepɨtatsi'uweiyatɨkɨkakai,  
\q2 makumawetsieta mekataniuhupieni.   
\b  
\q1
\v 20 Meta kaniuwiyarieni ti'aitame Yawé menayexei,  
\q2 mɨkɨ hetsie tetewiyatɨ temu'uwakai.  
\q1 Mɨkɨ pɨhɨkɨtɨkai hetsiena mieme mɨpaɨ temutiyuanekai:  
\q2 Mɨkɨ 'etɨriyayatɨa te'u'uwatɨ nuiwarite watsata tepu'uwani.   
\b  
\q1
\v 21 Kene'atemawieka meta keneutanaweni, 'Erumi kiekariyari,  
\q2 'Utsi kwieyaritsie, 'uka ti'aitame hepaɨ pemɨtika.  
\q1 Peru 'arike 'ikɨ tekɨxita 'ekɨta pepanu'ieni,  
\q2 hikɨ 'ana pepɨtitaweni meta pemawetɨ pepayani.   
\b  
\q1
\v 22 Tsiyuni witsipemɨti'ɨimarikai, kanaye'atɨarieni kepemɨtikwinitɨarienikekai,  
\q2 Kakaɨyari tawariri xeime kwieyaritsie pɨkamatsi'anɨnɨ'ani.  
\q1 Peru 'ekɨ, mɨmariwe 'Erumi kiekariyari, kamani'uximatɨamɨkɨ ke'axapemɨtiuyurikɨ  
\q2 meta naime ke'axapemɨtiuyuri katinitahekɨatamɨkɨ.   
\b  
\c 5  
\q1
\v 1 Yawé, kenaye'eri kemɨtatiuyuri,  
\q2 ketemɨteyutewinɨa kenaye'eri.   
\q1
\v 2 Takwie hipatɨ tiwapiini pɨratɨa,  
\q2 meta takii, 'ateewa kiekatari wapiini katinayani.   
\q1
\v 3 Tepɨkatehekapaapari, nutuite teputahayewaxɨ,  
\q2 tamaamama wiuraxi mepuyuhayewaxɨ.   
\q1
\v 4 Haa temɨhare, tekaninaneka xeikɨa,  
\q2 kɨyexi, yaxeikɨa tekaninaneka.   
\q1
\v 5 Memɨtatsi'uweiya takeputsatsie mekana'uweni,  
\q2 tepu'u'uxe xeikɨa, temuka'uxipieni tepɨkayɨwawe.   
\q1
\v 6 Tɨratu tekaniuwewieni 'Ekipitu meta 'Atsiriya wahamatɨa,  
\q2 mɨpaɨ 'ikwaite temɨtekaxeiyakɨ.   
\q1
\v 7 Tapaapama 'axameteyurietɨ mekaniukwini,  
\q2 tame pɨta tekaniu'uximatɨarieni wahetsiemieme.   
\q1
\v 8 Hikɨri waɨriyarika te'uximayatamete memɨhɨkɨtɨkai mɨkɨ mekatateni'aitɨaka,  
\q2 xewitɨ kaniumaweni mɨtatsixɨnakɨ wahetsɨa.   
\q1
\v 9 Makumawetsie makukweriwa'anetsie tekaniuyekɨkani,  
\q2 tatukari tekanitatuaka ta'ikwai temukaxexeiyanikɨ.   
\q1
\v 10 Tanawiyari pɨtatsikutaiya huxunu mɨxɨka hepaɨ,  
\q2 haakakɨ tekanihɨiyatɨkani.   
\q1
\v 11 Tsiyuni kiekatari 'ukarawetsixi meta Kura kiekariyaritsie 'ɨimarixi  
\q2 waɨriyarika mekaniutimayɨiyani.   
\q1
\v 12 Ta'ukiyarima memanuyehaitɨtɨakai mekaniukawɨtɨarieni yumamatsie mehɨatɨkaitɨ,  
\q2 meta tixaɨtɨ mepɨkatewarayeitɨa 'ukirawetsixi.   
\q1
\v 13 Taniwema temari 'aixɨa memɨ'anene tɨxɨmete mepɨwarayeitɨa,  
\q2 tɨɨri kɨyexi mahete me'ɨtɨtɨ mepekaxɨrɨwekai.   
\q1
\v 14 Hawaikɨri 'ukirawetsixi  
\q2 kiekari kitenie mepɨkatiyaxike,  
\q2 hawaikɨri temari wakwikari tepɨka'enie.   
\q1
\v 15 Temawierika pɨkaxɨaweri ta'iyaritsie,  
\q2 teye'amete watemawierika nutuixiya pɨta kanayani.   
\q1
\v 16 Tamu'utsie kuruna tepɨka'anamanari.  
\q2 Xɨa'ui tametsɨari: 'axatekateniuyurieni.   
\q1
\v 17 Ta'iyarite pukwiximeri,  
\q2 tahɨxite kanititɨximeni,   
\q1
\v 18 Karikɨ Tsiyuni hɨriyaritsie kanakukiɨriyaka,  
\q2 mana xeikɨa yeutari mekaniu'uwani.   
\b  
\q1
\v 19 Yawé, peru 'ekɨ 'aheyemekɨ pekatini'aitametɨni,  
\q2 'a'uweni yuheyemekɨ 'akaniuweni.   
\q1
\v 20 ¿Ketitayarikuta 'aheyemekɨ petaratɨtɨmaiya?  
\q2 ¿Ketitayarikuta mɨixa tukari petatiuku'eiri?   
\q1
\v 21 Yawé, 'ekɨ ketaneupitɨa 'ahetsɨa temɨ'axɨanikɨ, hikɨ 'ana tame ta'aurie tepaxɨrieni.  
\q2 Meripaitɨ ke'aixɨa temɨ'anekai mɨpaɨ ketatineupitɨa.   
\q1
\v 22 Yurikɨ, 'ekɨ pepɨtatsi'uku'eiri  
\q2 waɨkawa yemekɨ pepɨha'a tahamatɨa.   