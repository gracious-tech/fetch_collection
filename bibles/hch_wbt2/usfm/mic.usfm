\id MIC  
\h Mikeyaxi 
\toc1 Mikeyaxi 
\toc2 Mikeyaxi 
\toc3 Mik 
\mt1 Mikeyaxi  
\c 1  
\p
\v 1 'Ikɨ niuki kanihɨkɨtɨni Yawé Mikeyaxi Muretseti kiekame kemɨtiutaxatɨa, kepauka memɨte'aitakaitsie Kutani, 'Akatsi meta 'Etsekiyaxi, Kura kwieyaritsie te'aitamete. 'Ikɨ kanihɨkɨtɨni kemɨtiunieritɨarie mɨkɨ Tsamariya hepaɨtsita meta Kerutsareme hepaɨtsita.   
\s1 Yawé kemɨtinuani  
\q1
\v 2 Yunaitɨ teɨteri, xekeneu'enana,  
\q2 kwie keneu'ena  
\q2 meta yunaitɨ hetsiena xemɨte'u'uwa.  
\q1 Yutuki mɨpatsieta paitɨ  
\q2 Ti'aitame, Yawé naimekɨmɨyɨwe,  
\q2 kaninierekamɨkɨ xeme ke'axaxemɨteyurie.   
\q1
\v 3 Neuxei. Yawé yukiita kanayeyeiximeniri,  
\q2 'akanakamieniri meta kaniumieni  
\q2 hɨri 'amanutitɨtɨtsie.   
\q1
\v 4 Hɨri heima makekatsie kanitipenikeni,  
\q2 xɨrɨka taikɨ mukwanani hepaɨ,  
\q1 kwie mayeweweri hixɨata kanitsanikeni,  
\q2 haa mɨtɨrɨkaɨye hixɨata mɨtsana hepaɨ.   
\q1
\v 5 'Ikɨ naitɨ mɨya katiniyɨmɨkɨ Kakuwu nuiwarimama 'axamemɨte'uyurikɨ,  
\q2 'ixaheritsixi teɨteriyari 'axamemɨte'uyurikɨ.  
\q1 Tsamariya kanihɨkɨtɨni ya'aneme meutiwiwiexɨa 'Ixaheri 'axamɨtiyurienikɨ.  
\q2 Meta Kerutsareme kanihɨkɨtɨni kakaɨyarixi watukite 'etsimupepe mati'ukai hɨri 'amanutitɨtɨtsie Kura kwieyaritsie.   
\q1
\v 6 Tsamariya 'unimeyari kwinienetɨ 'uweme nepɨhayewa:  
\q2 kwietsanaripa payani kaxie maka'iteɨtsieni.  
\q1 Tetexiyari mayeweritsie nekaneukaxɨrimɨkɨ,  
\q2 meta tenariyari heyekɨa nekanihayewamɨkɨ.   
\q1
\v 7 Yunaitɨ kakaɨyariximama mekanititarariekuni,  
\q2 tuminikɨ memuyumayɨinɨa wa'iwarikakɨ memɨwewiyatɨkakɨ taipa katineuxɨriyamɨkɨ.  
\q2 Ne wakakaɨyarixi yunaime nepɨwatitemɨxikita.  
\q1 Naitɨ tita mɨtiyutiwewi tuminikɨ kumayɨiwatɨ me'iwakaikɨ,  
\q2 tuminikɨ muyumayɨinɨa mɨtipitɨarieni tawari payani.   
\s1 Mikeyaxi hiwerikaya  
\q1
\v 8 'Ayumieme nekanititsuamɨkɨ meta kukuiniyakɨ nekaniutahiwamɨkɨ,  
\q2 neheumamawetɨ 'anepuyeikani meta neheumawetɨ.  
\q1 Yawi mayu'eriya hepaɨ nekatiniutsuakamɨkɨ,  
\q2 'aru 'amɨnena hepaɨ nekatiniutsuakamɨkɨ.   
\q1
\v 9 Tsamariya kemɨtiukwinitɨarie pɨkayu'uayemarinɨa:  
\q2 Kura kwieyaritsie kaniye'ani.  
\q1 Neteɨterima wahetsiepai naime kanakɨnɨni,  
\q2 Kerutsareme kitenieyaritsie paitɨ.   
\q1
\v 10 Kahati kiekariyaritsie mɨkɨ xepɨkatehekuxatani,  
\q2 yemekɨ xepɨkahetitsuanani,  
\q1 xekenetikurupi kukuiniyakɨ  
\q2 Weti-Rehapɨra tumuanariyaritsie.   
\q1
\v 11 Tsahapixi kiekatari,  
\q2 xekenayekɨni xemamawetɨ meta tixaɨtɨ xekatehayuyeitɨatɨ.  
\q1 Tsanani memɨtama  
\q2 mepɨka'uyuwaɨri memɨwayekɨnekɨ.  
\q1 Weti-'Etseri kiekariyari kaniuta'aiwani,  
\q2 'ari pɨkaxeparewieni.   
\q1
\v 12 'Aixɨa ti'aneme metetakwewietɨ mepɨte'ukakukuine,  
\q2 Maruti kiekatari,  
\q1 Yawé 'axamɨti'ane kaneyenɨ'ani  
\q2 Kerutsareme kitenieyaritsie paitɨ.   
\b  
\q1
\v 13 Rakixi kiekatari,  
\q2 kawayutsixi kaxetate xekeniwaranawɨtɨiri.  
\q1 Xeme xehetsɨa putsutɨrixɨ Tsiyuni niweya 'axamɨtiyurienikɨ,  
\q2 xeme meri xepɨte'utsutɨa ke'axamɨtiyurienekai 'Ixaheri.   
\q1
\v 14 'Ayumieme, Muretseti-Kahati kiekariyari xekeneutateutɨa.  
\q1 'Akitsiwi kiekariyaritsie kii 'amutɨtɨ  
\q2 'Ixaheri kwieyaritsie te'aitamete wawiniyari kanihɨkɨtɨni.   
\b  
\q1
\v 15 Maretsa kiekatari,  
\q2 ne xeime tiyu'uname muwara'iwa nekananunɨ'amɨkɨ xehetsɨa,  
\q1 'ixaheritsixi yemekɨ memɨkamama  
\q2 'Arurani paitɨ mekani'axɨakuni memuyuti'awietakɨ.   
\q1
\v 16 'Ayumieme 'amɨxiya kenanuyexika meta 'amu'utsie keneuyukametseriya,  
\q2 hiwerika keneuwewi 'aniwema pemɨwanaki'erie wahetsiemieme,  
\q1 waɨkawa keneuyukametseriya wirɨkɨ kemɨremu'u hepaɨ,  
\q2 karikɨ 'aniwema pekaninawaiyariemɨkɨ.   
\c 2  
\s1 Kememɨtekwinitɨarieni xikutsixi memɨteyukananaima  
\q1
\v 1 Xɨa'ui kemɨ'ane xeikɨa memɨyu'iyaritɨa 'axamemɨteyurienikɨ,  
\q2 me'uheitɨ 'akuxi ke'axamemɨteyurienikɨ memitiwewiwa.  
\q1 'Amɨtikataretsie, mɨpaɨ mepɨte'eye'atɨwa  
\q2 mɨkɨ tɨrɨkariya memexeiyakɨ yuhetsie.   
\q1
\v 2 Kwie mɨraka'etsitɨre mehiwe'erietɨ, yupiini mekanayeitɨwani,  
\q2 meta kiite, mɨkɨta yukii mekanayeitɨwani.  
\q1 Waɨriyarika me'inanaimatɨ 'uki mekateni'aitɨaka meta tɨɨriyamama,  
\q2 tewi meta tita mɨrexeiyakai.   
\p
\v 3 'Ayumieme, Yawé mɨpaɨ kanaineni:  
\q1 «Hikɨta nepɨta nekanihɨkɨtɨni nemɨne'iyaritɨa  
\q2 wahetsie nemi'atɨanikɨ 'axamɨtiwayuriekakɨ,  
\q2 mɨkɨ tsata memayuye'una mepɨkayɨwekaxɨani.  
\q1 Mepɨkaku'uwaniri heitserie meheutanenieretɨ meyuti'ɨretɨ,  
\q2 maye'akɨri tukari ke'axamemɨ'itɨarienikɨ.   
\q1
\v 4 'Ana tukaritsie hipatɨ mepɨwananaimaka,  
\q2 hikɨ 'ikɨ hiwerika kwikariyari wahetsiemieme pɨtakwikarieni:  
\q1 “Tepeuyexɨri.  
\q2 Neteɨterima wakwie memaka'etsa mekaniyutaxitekiwani.  
\q1 Kehepaɨtɨtɨ menetenawairietɨwe.  
\q2 Memɨtatsi'a'iwaxɨ takwie mekaniyetuiriyarɨwani”».   
\b  
\q1
\v 5 'Ayumieme xepɨkaheixeiyani Yawé teɨterimama watsata  
\q2 xeime kwie wayetuiriwame.   
\s1 Kakaɨyari niukametemama memɨkahɨkɨ  
\q1
\v 6 'Ikɨ Kakaɨyari niukametemama mɨpaɨ mepɨnetekɨhɨawe:  
\q2 «'Ari ketineuhayewa petihekɨatatɨ.  
\q2 Pepɨkataraxaxatɨwani kename teka'unarieni».   
\q1
\v 7 Kakuwu nuiwarimama mɨpaɨ mekaniutiyuaneni:  
\q2 «¿Kamɨtsɨ Yawé tinewatɨ 'ari tiuhayewaxɨ?  
\q2 ¿Kamɨtsɨ mɨyatiuka'iyari?  
\q1 ¿Tamɨ niukieya 'aixɨa katiyuyuruwa?  
\q2 ¿Tamɨ tame 'aixɨa mɨtiuka'iyari hepaɨ tekate'u'uwa?»   
\q1
\v 8 Takai xeme neteɨterima xepɨhɨkɨtɨkai,  
\q2 peru hikɨri xemɨnetsi'aye'unie xepakɨ.  
\q1 Hakewa mɨreyukwine memeyekɨka,  
\q2 kayuwatɨ me'uhukaku huyeta,  
\q2 wakamixa 'amɨtɨtɨ xepɨtewanawairietɨwe.   
\q1
\v 9 Neteɨterima 'ukarawetsixi  
\q2 wakiita 'aixɨa memɨtemateta xepɨwarayexɨrɨwa,  
\q1 meta watɨɨriyama yuheyemekɨ xepɨtewanawairie  
\q2 naime tita nemɨtiwayetuiri.   
\b  
\q1
\v 10 Xekenanuku'uti. Xekeneuhuni,  
\q2 'ikɨ 'ena xema'uxipie pɨkahɨkɨ.  
\q1 Tita 'axamɨti'ane xepɨte'utahɨniyaxɨ,  
\q2 xepika'unaxɨ naime yemekɨ.   
\q1
\v 11 Xɨka xewitɨ tixe'itaiyamɨtɨ,  
\q2 xɨka nuani ti'itawatɨ mɨpaɨ tixe'utahɨawe:  
\q1 «Ne nepɨtixetahekɨatɨani kaxie winuyari meta kaxie hayari wahepaɨtsita»,  
\q2 'ikɨ teɨteri Kakaɨyari niukameya mepayeitɨani.   
\s1 Kemutayɨ kemɨtiwaxɨnakekai  
\q1
\v 12 Kakuwu, yurikɨ mɨpaɨ nekanaineni,  
\q2 ne yunaime 'ateɨterima nekaniwakuxeɨrimɨkɨ.  
\q1 'Ixaheri, yurikɨ mɨpaɨ nekanaineni,  
\q2 ne nekaniwakuteɨximɨkɨ memuyuhayewaxɨ.  
\q1 Nepuwakuxeɨrieni muxatsi kuraruta memeuta'ɨnarieni hepaɨ,  
\q2 muxatsi wahepaɨ, maku'ɨxaya hixɨapa,  
\q2 memɨyuwaɨkawani hepaɨ tɨranari mepɨwewieni.   
\q1
\v 13 Panuyekani kemɨ'ane muhuyetarɨmeni,  
\q2 meta mɨkɨtatsiere huye mepuyuwewirieximeni,  
\q1 kitenie mekaniuyekɨnikuni hikɨ mekaniyehuni,  
\q2 mexi tiwa'aitɨwame 'umieni 'anuyekaitɨ,  
\q2 mexi Yawé 'anuyekaitɨ 'umieni.   
\c 3  
\s1 Kememɨtekwinitɨarieni kuwexinaruritsixi kemɨkatiheitserie memɨte'uximaya  
\p
\v 1 Hikɨ mɨpaɨ nekaniutayɨni:  
\q1 «Xekeneu'enana, Kakuwu nuiwarimama wakuwexinaruritsixi,  
\q2 xemɨ'itsɨkate 'ixaheritsixi wahetsiemieme:  
\q1 ¿Kareuyewetse xeme  
\q2 xemimaika tita mɨtiheitserie?   
\q1
\v 2 Xeme 'aixɨa mɨti'ane xekateni'uxieka, tita mɨkatiheitserie pɨtata xetenaki'erie,  
\q2 neteɨterima me'ayeneniereme wanawiyari xepɨkatsana  
\q2 meta wawaiyari wa'umeyaritsie,   
\q1
\v 3 xeme neteɨterima xepɨwakwa'a,  
\q2 wanawiyari xepɨkatsana, wa'umeteyari xepɨtimura,  
\q1 'etsipepeme xepɨwatixiteke wai xarita mɨka'etsarieni hepaɨ,  
\q2 wai huxunuta mɨ'imaiyani hepaɨ».   
\b  
\q1
\v 4 'Uxa'atɨni Yawé mekanitahiwikuni parewiya mehewawiriwatɨ,  
\q2 matsi mɨkɨ pɨkawata'eiya,  
\q1 wahetsiemieme puyuti'awieta  
\q2 'axamemɨte'uyurikɨ.   
\s1 Kakaɨyari niukametemama memɨte'itawa meta yuri memɨtekuxata  
\q1
\v 5 'Ipaɨ kanaineni Yawé xehepaɨtsita,  
\q2 Kakaɨyari niukametemama neteɨterima xemɨwareuyexɨrɨwa:  
\b  
\q1 «Kemɨ'ane 'ikwai memɨxemikwa, kename kayuwatɨ'uma xepɨtewakuxaxatɨwa,  
\q2 kemɨ'ane 'ikwai memɨkaxemikwa, kename kuyaxa 'ayani xepɨtewakuxaxatɨwa.   
\q1
\v 6 Hikɨ 'ayumieme, mepɨyɨriyarieni tawari tixaɨtɨkɨ mepɨkatexeiyatsitɨarieni,  
\q2 mepɨkayɨwekaxɨaniri memɨtetaxata kemɨtiyɨni 'arike».  
\b  
\q1 'Ikɨ Kakaɨyari niukametemama wahetsiemieme tau pakayune,  
\q2 tukarikɨ wahetsiemieme yɨriya payani.   
\q1
\v 7 'Iyaritsie mieme memɨtaneniere mepɨyutitetewiya,  
\q2 kakaɨyarixi memɨwaruta'iwawiya kemɨtiyɨnikɨ tixaɨtɨ mepɨkate'ayeitɨarieni.  
\q1 Kakaɨyari wateta pɨreunani,  
\q2 mɨkɨ tawari pɨkawata'eiya.   
\q1
\v 8 Ne, matsi, tɨrɨkariyakɨ nekanihɨneni,  
\q2 nekanihɨneni Yawé 'iyarieyakɨ,  
\q2 meta nekanihɨneni tita mɨtiheitseriekɨ meta tɨrɨkariyakɨ,  
\q1 nekaniyɨweni Kakuwu nuiwarimama nemɨwarutaxatɨani ke'axamemɨtekahu  
\q2 nekaniyɨwenita 'ixaheritsixi nemɨwataxatɨani ke'axamemɨte'uyuri.   
\s1 'Itsɨkame 'axamɨtikamiekɨ, 'ayumieme Tsiyuni puka'unarie  
\q1
\v 9 Xeme 'ikɨ xekeneu'eni,  
\q2 Kakuwu nuiwarimama wakuwexinaruritsixi,  
\q1 meta 'itsɨkate 'Ixaheri kwieyaritsie miemete,  
\q2 tita mɨtiheitserie xepɨxani'erie meta xepitituna niuki heitserie mɨtikuxata,   
\q1
\v 10 Kerutsareme meta netuki manuwe  
\q2 'imieri meta kemɨkatiheitserie tukarikɨ yapɨtixuawe.   
\q1
\v 11 Wa'itsɨkate metepitɨarietɨ xeikɨa 'aixɨa mepɨteyurie,  
\q2 wamawari wewiwamete mepɨwa'ɨxatsitɨa meteyuwiyatɨ,  
\q2 meta wakakaɨyari niukametemama tuminikɨ xeikɨa mekatenikuxatani kemɨtiyɨni,  
\q1 'imatɨrieka matsi, Yawé hetsie mekaniyutɨrɨkariyani, mɨpaɨ mekaniutiyuaneni:  
\q2 «¿Tamɨ Yawé tahamatɨa katiuyeika?  
\q2 Tame hawaikɨ 'axatepɨka'itɨarieni».   
\q1
\v 12 'Ayumieme, xeme ya'aneme xewiwiekaku  
\q2 Tsiyuni kwietsanaripa hepaɨ tiyuxexeiyatɨ kanayeimɨkɨ,  
\q1 Kerutsareme 'unimeyari xeikɨa kaniyuhekɨarimɨkɨ,  
\q2 meta yemuri tuki manuwekai 'ɨtsita kanayeimɨkɨ.   
\c 4  
\s1 'Arike Tsiyuni kiekariyari ke'aixɨa mɨtitahɨawarieni  
\r (Mik 4:1-3 – Kits 2:1-4)  
\q1
\v 1 'Imatɨrieka tukari 'umahutsie,  
\q2 yemuri Yawé tukieya manuwekai  
\q1 hɨrite 'amutɨtɨ heima kanakayeriemɨkɨ  
\q2 meta mɨkɨ matsi yunaime hɨrite wara'iwatɨ kanayeimɨkɨ.  
\q1 Hikɨ teɨteri hepana mekaniukɨnikuni,   
\q2
\v 2 meta nuiwarite yumɨiretɨ hetsɨana mekani'axɨakuni, mɨpaɨ mekanitiyuakuni:  
\q1 «Xekenakɨni, tepanutikɨne Yawé yemurieyatsie,  
\q2 Kakuwu Kakaɨyarieya tukita.  
\q1 Kakaɨyari yukɨmana yu'aitsikate kataneta'ɨkitɨamɨkɨ,  
\q2 'ana mɨpaɨ tepɨte'u'uwani».  
\q1 Karikɨ Tsiyunitsie kanayeneikani 'ɨkitɨarika,  
\q2 Kerutsareme hetsie, Yawé niukieya.   
\q1
\v 3 Kakaɨyari yɨkɨmana yumɨireme teɨteri wahetsiemieme 'aixɨa katinakayurimɨkɨ,  
\q2 meta tita mɨtiheitserie hepaɨtsita pɨtita'uximayata  
\q2 nuiwarite memɨtɨrɨkawi wahetsie meta 'ateewa kiekatari.  
\q1 Yu'ixiparate hatsarunite mepayeitɨaxɨani,  
\q2 meta yupitsikate 'ɨxa xikame mepayeitɨaxɨani.  
\q1 'Ari nuiwarite mepɨkayukwitɨweniri,  
\q2 meta tawariri 'imieri kuyaxa mieme mepɨkayuti'ɨkitɨani.   
\q1
\v 4 Yuxexuitɨ kaxie meta piní  
\q2 'iteɨriyari hetɨa xepɨtiyaxikeni,  
\q1 nixewitɨ 'axamatɨarietɨ pɨka'ayani  
\q2 —Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kaniutayɨni—.   
\q1
\v 5 Teɨteri yunaitɨ yukakaɨyarixi  
\q2 wahetsie metewiyatɨ mekaniuhuni,  
\q1 matsi tame Yawé hetsie tetewiyatɨ xeikɨa tekaniuhuni,  
\q2 takakaɨyari hetsie tetewiyatɨ,  
\q2 hikɨ 'ena mɨtiyehane meta yuheyemekɨ.   
\s1 'Arike Tsiyuni kiekariyari kemɨtihekwatɨarieni  
\q1
\v 6 «Yawé mɨpaɨ kanaineni: 'Iya tukaritsie,  
\q2 muxatsi memɨte'utikwinitɨarie nekaniwakuxeɨrimɨkɨ,  
\q2 memeutaxɨriexɨa meta memɨnanaimarie.   
\q1
\v 7 Muxatsi memɨwitekietɨka memuyuhayewaxɨ nekaniwarayeitɨamɨkɨ,  
\q2 meta 'ateewa memehapanie, xeinuiwariyari metɨrɨkaɨyeme nepɨwarayeitɨani.  
\q1 Yawé mɨkɨ wahetsie katini'aitakamɨkɨ Tsiyuni hɨriyaritsie  
\q2 hikɨ 'ena mɨtiyehane meta yuheyemekɨ.   
\q1
\v 8 'Ekɨta, Muxatsi Watuxiyu,  
\q2 yemuri kuraru 'amatitetewa Tsiyuni kiekariyari:  
\q1 'ahetsɨa kaninuamɨkɨ meripai tɨrɨkariya kepemɨrexeiyakai,  
\q2 mariwemekɨ kepemɨti'aitakai Kerutsareme kiekariyari».   
\s1 Kemɨti'uximatɨarieni meta kemɨra'iwa Tsiyuni  
\q1
\v 9 Hikɨta, ¿ketitayari kwinimieme petiuhiwa?  
\q2 ¿Kamɨtsɨ ti'aitame pekarexeiya?  
\q1 ¿Titayari 'ukaratsi niweyame kukuiniyaya meti'axiya?  
\q2 ¿Kamɨtsɨ matsi'ɨxatsitɨwame tiumɨ?   
\q1
\v 10 Ketineukakukuineni meta keneu'atawawaɨriyani, neniwe 'uka Tsiyuni,  
\q2 'ukaratsi mɨtiniwerɨmeni hepaɨ,  
\q1 karikɨ hikɨri 'akiekaritsie pekanayeyeimɨkɨ,  
\q2 meta yeuta pe'ukaitɨ pekanayeimɨkɨ.  
\q1 Wawiruniya pekaniyemieni, matsi mana pe'uyeikatɨ pekanixɨnariemɨkɨ,  
\q2 Yawé kamenixɨnamɨkɨ memɨmatsi'aye'unie kememɨmete'aitɨatsie.   
\b  
\q1
\v 11 Hikɨri nuiwarite yumɨiretɨ mepɨyukuxeɨri memetsi'aye'unietɨ.  
\q2 Mɨpaɨ meputiyuane: «Tsiyuni kapatsietɨ ke'ayeitɨarieni.  
\q2 Tenenieretɨ tepɨyutemamawieka».   
\q1
\v 12 Matsi mɨkɨ Yawé kemɨtiku'eriwa mepɨkatemate,  
\q2 meta mepɨkaheitimaitɨkɨka kemɨtiyurimɨkɨ 'arike,  
\q1 'atsimepɨkatemate mɨkɨ mɨwarukuxexeɨriwa  
\q2 mɨwaka'itsanakɨ waxata hepaɨ.   
\q1
\v 13 Kenanukukexi, neniwe 'uka Tsiyuni.  
\q2 Kene'uneni.  
\q1 'A'awate tepɨa nekanayeitɨaxɨamɨkɨ  
\q2 meta 'akarutsate wurunitse nekanayeitɨaxɨamɨkɨ,  
\q1 yumɨireme teɨteri tumuanari pemɨwarayeitɨanikɨ,  
\q2 meta Yawé pekatiniyetuiriemɨkɨ tita memɨte'a'iwaxɨ 'axa'anemekɨ,  
\q2 tita waɨkawa memɨteheuxeiya pekatiniyetuamɨkɨ, Ti'aitame mɨhɨkɨ naitsarie kwiepa.   
\c 5  
\s1 Ti'aitame Rawiri nuiwarieya hepaɨtsita  
\q1
\v 1 Neniwe 'uka yumemiwame, 'akuyaxima keniwarukuxeɨri,  
\q2 takuraruri kananutinamieka.  
\q1 'Iwaɨyɨkɨ yu'auritapa peutiweiyani  
\q2 'Ixaheri kwieyaritsie ti'aitame.   
\q1
\v 2 Matsi 'ekɨ, Wereni 'Epɨrata,  
\q2 kiekari 'etsipemɨyewa Kura nuiwarimama watsata,  
\q2 'ahetsie pɨyeyani 'Ixaheritsie mɨtita'aita,  
\q1 tsutɨa paitɨ kiekatari puwanuiwari,  
\q2 watukari mɨka'inɨari.   
\q1
\v 3 'Ayumieme Kakaɨyari kaniwayetuamɨkɨ mɨwaraye'unie hetsɨa,  
\q2 kepaukake 'ukaratsi mayehuka 'ukitɨme mɨtiniweni,  
\q1 hikɨ 'ixaheritsixi memehapaniekai  
\q2 yu'iwama 'ixaheritsixi wahetsɨa mepɨ'axɨani.   
\q1
\v 4 Peru xewitɨ kaninemɨkɨ muxatsi wahepaɨ wahɨweme mayani  
\q2 Yawé tɨrɨkariyayakɨ,  
\q2 mɨkɨ kemɨtimariwe 'ipitɨakaku Yawé kakaɨyarieya.  
\q1 'Aixɨa 'iyari mepu'uwani, mɨkɨ mɨti'aitanikɨ  
\q2 kwie kemɨyewa naimetsie.   
\q2
\v 5 Mɨkɨ kayuwatɨ temu'uwanikɨ yapɨtiyurieni.  
\q1 Xɨka 'Atsiriya nuani takwieyaritsie  
\q2 takwieyari ka'unake takiekarite kuraruyari 'amatitetewa,  
\q1 tepitamieni yu'atahutame muxatsi wahɨwemete tewarawitɨtɨ,  
\q2 meta 'atahaika kuyaxi memanuyetei wahekɨ,   
\q1
\v 6 mɨkɨ 'Atsiriyatsie mepɨtetahɨni 'ixiparakɨ,  
\q2 Nimiruri kwieyatsie, nawaxakɨ mepɨteta'aita.  
\q1 Xɨka 'Atsiriya takwieyari 'uka'unake,  
\q2 xɨka takwieyaritsie watahanike,  
\q2 mɨkɨ pɨtatsitawikweitsitɨani.   
\s1 Memuyuhayewa  
\q1
\v 7 Kakuwu nuiwarimama memuyuhayewa,  
\q2 teɨteri meyumɨireme watsata,  
\q1 haɨtsi Yawé hetsɨa mieme hepaɨ mepɨ'aneni,  
\q2 wiyeri 'amayetsuye tupiriya hetsie mɨkaxɨrɨwe hepaɨ,  
\q1 teɨteri memɨka'inɨ'a,  
\q2 meta tixaɨtɨ mɨkatiwarawawiriwa.   
\q1
\v 8 Kakuwu nuiwarimama memuyuhayewa nuiwarite watsata,  
\q2 yumɨireme teɨteri watsata,  
\q1 maye yeutarite watsata kemɨtiyumate mɨkɨ hepaɨ mepɨ'aneni,  
\q2 maye temaikɨ muxatsi watsata kemɨtiyumate hepaɨ,  
\q1 kepauka watsata meutahani puwatixutsina meta puwatikwa'a,  
\q2 nixewitɨ wahetsie mɨtanuani mɨkayɨwekɨ.   
\q1
\v 9 Memɨxe'aye'unie xepɨwatakwini,  
\q2 hikɨ yunaime xepɨwakwini memɨxekwitɨwe.   
\s1 Kememɨte'itiyani kakaɨyarixi memɨkawarayexeiyanikɨ  
\p
\v 10 Yawé mɨpaɨ kanaineni:  
\q1 «Mɨkɨ tukaritsie 'akawayutsixi kuyaxa miemete nekaniwareuyehɨamɨkɨ,  
\q2 metatsiere 'akaxetate kuyaxa miemete.   
\q1
\v 11 Kiekarite 'akwieyaritsie miemete nekanakuxɨtɨamɨkɨ  
\q2 metatsiere naime 'akiekarite kuraruyari 'ematitɨtɨ.   
\q1
\v 12 Kepemɨtiyukewaiya nekaneitipariyamɨkɨ  
\q2 meta kakaɨyarixi memuwaruta'iwawiya kemɨtiyɨnikɨ pepɨkawarexeiyaniri.   
\q1
\v 13 'Akakaɨyarixi nekaniwareutipariyamɨkɨ  
\q2 meta 'atetexi memɨpatsietɨka 'amɨti'u,  
\q1 tawariri hatsuaku wahɨxie pepɨkatitunumakeni  
\q2 'amamakɨ pemɨtiwawewie wahɨxie.   
\q1
\v 14 'Atserá 'ɨkiyarite nepatihunaxɨani,  
\q2 meta 'akiekarite 'unimeyari kwinieneme nekanikemɨkɨ,   
\q1
\v 15 neha'atɨ waɨkawa nekatiniwarakapitɨamɨkɨ  
\q2 kemɨ'ane nuiwarite memɨkanetsi'anu'eni».   
\c 6  
\s1 Kakaɨyari yuteɨterima kemɨtiwaxaneta  
\p
\v 1 Yawé kemutaine xekeneu'eni:  
\q1 «Kenanukukexi, hɨrite wahɨxie 'axanetsika keneyetua,  
\q2 yemurite 'aniuki meke'u'enieni».   
\b  
\q1
\v 2 Yemurite xekeneu'eni, Yawé xanetsikaya,  
\q2 kayuwatɨ xekeneu'enana, kwie tsutɨmeyari,  
\q1 Yawé kanitsutɨaka yuteɨterima waxanetatɨ,  
\q2 kanitsutɨani 'ixaheritsixi wahamatɨa 'aixɨa mɨtiyurienikɨ:   
\q1
\v 3 «Neteɨterima, ¿ne kenexe'uyuri?  
\q2 Yaxekeneteneutahɨawi kepauka nepɨxe'umuinaxɨ.   
\q1
\v 4 Ne nekatiniuyurieni 'Ekipitu kwieyaritsie nemɨxe'ayewitɨ,  
\q2 nemɨxe'uxɨnaxɨ mɨkɨ kwieyaritsie waɨriyarika xete'aitɨariekaku.  
\q1 Ne nekaniwarutanɨ'ani Muitsexi, 'Aruni meta Miriyami,  
\q2 memɨxe'uwitɨximenikɨ.   
\q1
\v 5 Neteɨterima, xekena'eriwani  
\q2 Waraki Muhawi kwieyaritsie ti'aitame kemɨtiyurimɨkɨkai,  
\q2 meta Warami Wehuxi nu'aya kemɨtita'ei.  
\q1 Xekena'eriwani kexemɨte'ukɨ Tsitini xemɨyekɨ Kirikari paitɨ xemu'axɨa,  
\q2 meta mɨpaɨ xeketenemaika Yawé kemɨtixe'utawikweitsitɨa».   
\b  
\q1
\v 6 ¿Kehepaɨ neyɨme Yawé hɨxie 'ahurawa nepunuani  
\q2 meta kehepaɨ Kakaɨyari Mɨmariwe hɨxie netikatunumakeni?  
\q1 ¿Netiyɨwe mawari taiyariyarikɨ  
\q2 yatɨni tsikeru xeiwiyari mexeiya neyetuatɨ?   
\q1
\v 7 ¿Yawé tiyukatemawieni miriyaritekɨ muxatsi 'ukitsi wahekɨ,  
\q2 yatɨni tamamata miriyari 'akiyarikɨ hatseiti muhapane?  
\q1 ¿Neniwe mexɨakame netiyetuani,  
\q2 nehetsie mɨyetɨa netiyetuani 'axanemɨtiuyurikɨ?   
\b  
\q1
\v 8 Yapekatiniutaxatɨarieniri tita 'aixɨa mɨti'ane.  
\q2 Pepɨtiutaxatɨarieri tita mɨtitakwewie 'ahetsiemieme Yawé:  
\q1 Yapepɨtiyurieneni tita mɨtiheitserie hepaɨtsita,  
\q2 pepinaki'erieka nenimayatsika,  
\q2 meta Kakaɨyari hɨxie mariweme pepɨka'ayuyeitɨwani.   
\s1 Kememɨtekwinitɨarieni 'axamemɨte'uyurikɨ tuminikɨ meta teɨteri wahetsie  
\q1
\v 9 Nuiwarite meta teɨteri kiekaritsie kiekatari,  
\q2 Yawé niukieya xekeneu'eni, pɨxeha'iniwa,  
\q2 xɨka xetemaiwaweni, Yawé xekenemakaxeni.   
\q1
\v 10 «'Axaxemɨte'u'iyari.  
\q2 ¿'Atsinekaraineni tumini xemexeiya 'axa'anemekɨ xeme'iwaxɨ,  
\q2 meta heuyewekamekɨ xemɨteku'inɨnɨata hepaɨtsita?   
\q1
\v 11 ¿Kename 'aixɨa 'ane nera'eriwani kirutame mɨtinawaya hepaɨtsita  
\q2 meta tepɨa mahete manuyeyaxike 'aixɨa mɨkareuku'inɨatsie?   
\q1
\v 12 Xikutsixi kiekaritsie kiekatari 'axamepɨte'u'iyari,  
\q2 kiekatari mepɨte'itawa,  
\q2 yuteta yuneni mepexeiya ti'itawame.   
\q1
\v 13 'Ayumieme ne, nekametinikwinitɨamɨkɨ nemetsitiwayatɨ,  
\q2 ne nepɨmetsika'una 'axapemɨtiuyurikɨ.   
\q1
\v 14 Pepɨtiutikwa'ani, matsi pepɨka'utahuxarɨweni,  
\q2 matsi yaxeikɨa pepɨhaakatɨarieka.  
\q1 Pemɨtiukaxexeiyani yapɨreuyeikani,  
\q2 meta tita 'etsiwa pemɨrexeiyani memɨmatsi'aye'unie nekaniwayetuiriemɨkɨ.   
\q1
\v 15 Tita pemɨtika'eni mɨkɨ pepɨkaka'itsana,  
\q2 huriwu takari tsepa pemutipɨnaxɨ hatseiti pepɨkahexeiyani,  
\q2 meta kaxie winuyari pepɨka'anu'ieni tsepanetɨ takariyari pemutiketsi.   
\q1
\v 16 'Ekɨ 'aixɨa 'anemekɨ 'Umiri 'aitsikaya pekaniuweiyani  
\q2 meta naime 'Akawi nuiwarimama kememɨteyurie,  
\q2 yapepɨtiuyeika 'ɨxatsieya kemutiyuane.  
\q1 'Ayumieme pemɨka'unarienikɨ nekameniyetuamɨkɨ,  
\q2 meta 'ateɨterima nekaniwatewinɨamɨkɨ.  
\q2 Teɨteri 'axakemematekɨhɨaweni pepinewieka».   
\c 7  
\s1 Hiwerika matsi kemɨtikuxatakai tixaxatame  
\q1
\v 1 Xɨa'ui ne.  
\q1 Wiita 'ikwaxi muti'inɨiwatsie 'anutiyaku nepunua,  
\q2 pɨkayɨweri kaxie nemɨtiwauni,  
\q1 tsikere xeixatsimuyari nepɨkahexeiya nemitikwanikɨ,  
\q2 xapa takari yɨrime tɨma nepɨkahexeiya, kɨmana nemɨmɨxime.   
\q1
\v 2 Teɨteri Kakaɨyari memayexeiya 'ikɨ kwieyaritsie mekanakuxɨtɨarieniri,  
\q2 'ena kwiepa mepumaweri teɨteri 'aixɨa memɨte'u'iyari.  
\q1 Yunaitɨ hipame mepɨwakwiku,  
\q2 meta yunaitɨ mekaniyuwiniyatɨweni.   
\q1
\v 3 Nixewitɨ pɨkawara'iwa ke'axamemɨteyuriekɨ,  
\q2 ti'aitame parewiwametemama meta 'itsɨkate mepiku'iwawa 'awie memɨtepitɨarienikɨ.  
\q1 Memɨtɨrɨkawi mekateniku'iwawani xeikɨa,  
\q2 meta yunaitɨ mekaniyutemawieritɨaka ketita memɨtehiwe'eriekɨ.   
\q1
\v 4 Watsata muyeika 'aixɨa mɨtiuka'iyari kwinimieme matsi katinihɨaka keyuri 'ɨtsi,  
\q2 kemɨ'ane heitserie 'amuyeika, matsi kanitunini keyuri xuya.  
\q1 Matsi kanaye'aximeniri memɨhɨxiyatɨarienitsie,  
\q2 kanehuraniri tukari memɨtekwinitɨarienitsie,  
\q2 kememutiyua memɨtaneniere 'ahetsɨa miemete.   
\q1
\v 5 Xeime 'ahepaɨ tewi yuri pepɨkati'eririeka,  
\q2 'ahamikuma wahetsie pepɨkatiwiyani,  
\q1 kene'akweriwayurieka kepemɨtikuxaxatɨwa  
\q2 'ahamatɨa mukahupu.   
\q1
\v 6 Nu'ayatɨtɨ yupapa pɨxani'erie,  
\q2 'uka yumaama pɨkaheu'enie,  
\q2 meta mu'etsiekame yumu'e paye'unie,  
\q1 memɨxe'aye'unie xeme yuxexuitɨ  
\q2 xekiitatɨtɨ mepayetetɨka.   
\q1
\v 7 Matsi ne Yawé hetsie netiwiyatɨ nepɨta'ikwewa,  
\q2 nepɨta'ikwewani Kakaɨyari hetsie netsiwikweitsitɨwame.  
\q2 Nekakaɨyari kaneni'eniemɨkɨ.   
\s1 'Ikwewarika memɨtawikweitsitɨarienikɨ  
\q1
\v 8 Pemɨnetsi'aye'unie 'aku, 'axakemɨnetiyuriekɨ pepɨkayutemawieka.  
\q2 Nepatiwe, matsi nepanukukeni,  
\q2 yɨwipa nepuyeika, matsi Yawé nehekɨariya pɨhɨkɨ.   
\q1
\v 9 Yawé hepaɨtsita 'axanekatiniuyurieni,  
\q2 'ayumieme nepinewieni haxɨaya  
\q1 kepaukake 'aixɨa mɨtiyurieni kenemɨtiuyurikɨ  
\q2 meta kemɨtiheitserie nehetsiemieme.  
\q1 Hikɨ 'ana hekɨaripa pɨnetsi'atɨani  
\q2 meta neyutemawietɨ nepayani wikweitsitɨarikayakɨ.   
\q1
\v 10 Mɨnetsi'aye'unie kepauka mɨniere,  
\q2 mɨpaɨ mɨnetikɨhɨawekai: «¿Hakewari 'akakaɨyari?»,  
\q2 waɨkawamekɨ puyutitewiya.  
\q1 Nekanixeiyamɨkɨ kemɨtika'unarieni,  
\q2 karikɨ haxu huye 'utɨa mieme hepaɨ katiniketsinariemɨkɨ.   
\b  
\q1
\v 11 Kepauka 'akuraru 'amatayewa tawari mawewiyatɨyani  
\q2 'ana kanihɨkɨtɨkamɨkɨ 'akwie 'apemɨtayeuriya.   
\q1
\v 12 Mɨkɨ tukaritsie 'ahetsɨa mepɨ'axɨani teɨteri,  
\q2 'Atsiriya metsutɨtɨ meta 'Ekipitu kiekariteyaritsie paitɨ meye'atɨ,  
\q1 Niru hatuxameyari manuyeka metsutɨtɨ meta 'Eupɨrate hatuxameyaritsie meye'atɨ,  
\q2 haramaratsie metsutɨtɨ meta tapa haramaratsie paitɨ, meta teewanarixi xeime hɨritsietari.   
\q1
\v 13 Karikɨ mɨkɨ kwieyarite makumawe kanayeixɨamɨkɨ  
\q2 teɨterimama ya'aneme meheutiwiwiexɨaku,  
\q2 'axamemɨteyuriekaikɨ.   
\b  
\q1
\v 14 'A'itsɨ pe'akwetɨ 'ateɨterima keniwahɨneni,  
\q2 muxatsi 'atewama,  
\q1 yuxaɨta 'ɨtsita memɨkie,  
\q2 'ɨtsi hixɨapa.  
\q1 Watsani meta Karaha mu'ɨxayatsie ketiniwarutimikwa  
\q2 meripaitɨ hepaɨ.   
\q1
\v 15 Mariweme ketineuyuri wahɨxie,  
\q2 'Ekipitu kwieyaritsie pemɨwarayewitɨtsie hepaɨ.   
\q1
\v 16 Hipatɨ nuiwarite mekaninenierikuni mariwemekɨ kepemɨtiyurieni,  
\q2 hikɨ yutɨrɨkariya mekanititewiyakuni,  
\q1 yutenie mekaniuwɨrikuni  
\q2 meta memɨkaheu'enana mekanayuyeitɨakuni.   
\q1
\v 17 Tumuanari mekanikutsenakuni kuuterixi wahepaɨ,  
\q2 kwiepa yutawima memɨteku'uwa wahepaɨ.  
\q1 Mepɨwayekɨne me'utiyɨyɨakatɨ hakewa memeyu'awietatɨka  
\q2 meta, memamatɨ 'ahɨxie,  
\q2 mekaniyuyetuakuni 'ahetsɨa, Yawé meta takakaɨyari.   
\b  
\q1
\v 18 Pumawe Kakaɨyari 'ahepaɨ tiuka'iyaritɨ,  
\q2 'axamɨti'ane mɨtareuyehɨwiriwa  
\q1 meta tixaɨtɨ mɨkarayeitɨwa ke'axamemɨte'uyuri  
\q2 teɨterima memuyuhayewaxɨ.  
\q1 'Aheyemekɨ pepɨkaha'a,  
\q2 naki'eriya mɨmatsinakekɨ pɨta.   
\q1
\v 19 Tawari ketaneutinenimayata.  
\q2 Ke'axatemɨte'uyuritsie kenakexi,  
\q2 meta naime 'axaketemɨte'uyuri haramara 'amatiyewatsie ketineukaxɨri.   
\q1
\v 20 Matsiɨkɨme kenayeitɨa Kakuwu pemɨkaku'eiriwe hatsuaku,  
\q2 meta 'Apɨrahami heitserie kepemɨtinaki'erie,  
\q1 meripaitɨ tsutɨa paitɨ  
\q2 kepemɨti'ahɨritɨa tatutsima wahamatɨa.   