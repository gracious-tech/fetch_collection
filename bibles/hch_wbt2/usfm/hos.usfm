\id HOS  
\h 'Utseyaxi 
\toc1 'Utseyaxi 
\toc2 'Utseyaxi 
\toc3 'Uts 
\mt1 'Utseyaxi  
\c 1  
\p
\v 1 'Ikɨ Yawé kaniniukieyatɨni 'Utseyaxi Weherí nu'aya kemɨtiyetuiri, 'Utsiyaxi, Kutani, 'Akatsi meta 'Etsekiyaxi kepauka memɨte'aitakai Kura kwieyaritsie, meta Keruwuhani Kuhatsi nu'aya ti'aitakaku 'Ixaheri kwieyaritsie.   
\s1 'Utseyaxi 'ɨyaya meta niwemama  
\p
\v 2 Kepauka Yawé 'Utseyaxi hamatɨa matɨari mɨtiutaxa, mɨpaɨ katinitahɨawe: «Kenemie xeime 'ukaratsi tuminikɨ muyuwitɨnɨa kenetiwitɨki, hetsiena tɨɨri keniwarayexeiya, mɨkɨ kwieyaritsie mɨpaɨ memɨyɨakɨ yunaitɨ. Yawé me'uku'eirieka hipame kakaɨyarixi pɨta mekaniwarayexeiyakaitɨni».   
\p
\v 3 Hikɨ 'Utseyaxi kaneyani, Kumexi titewakame kaniutiwitɨni Riwɨrahini niweya, mɨkɨ kaniutihukata nunutsi mekanayexeiya.   
\p
\v 4 Hikɨ Yawé mɨpaɨ katinitahɨawe: «Ketsireri ketineuterɨwa, kwitɨwari Kehú nekatinakapitɨamɨkɨ nuiwarimama nekatiniwakwinitɨamɨkɨ, mana Ketsireri mɨrakutewatsie mɨkɨ teɨteri yɨwaɨkawa mɨwarekwikɨ. Mɨpaɨ nekatiniwaka'unamɨkɨ 'Ixaheri kwieyaritsie te'aitamete.  
\v 5 Mɨkɨ tukaritsie 'ixaheritsixi watupi nepɨtimuraxɨani mayeweritsie Ketsireri mɨrayetewatsie».   
\p
\v 6 Kumexi tawarita kaniutihukata 'ukatɨme kaniutiniweni. Hikɨ Yawé 'Utseyaxi mɨpaɨ katiniutahɨawe: «Mɨpaɨ ketineuterɨwa Ruxuhama, taniukikɨ manuyɨne “Nepɨka'itinenimayatari”, nepɨkareiyehɨwiriekari 'Ixaheri mɨra'aitatsie, matsi nepɨka'itinenimayatari.  
\v 7 Matsi pɨta wahetsiemieme nekaniwatinenimayatamɨkɨ Kura nuiwarimama meta nekaniwatawikweitsitɨamɨkɨ, peru 'ɨrɨkɨ, 'ixiparakɨ, kuyaxakɨ meta kawayutsixi wahetsie me'anatetɨkaitɨ pɨkatiyɨni, matsi pɨta Yawé xekakaɨyari tɨrɨkariyayakɨ pɨtiyɨni».   
\p
\v 8 Kepauka Kumexi niweya katsitsewetɨ matɨa «Nepɨka'itinenimayatari» mɨtitewa, tawarita kaniutihukata 'ukitɨme kaniutiniweni.  
\v 9 Hikɨ Yawé 'Utseyaxi mɨpaɨ katiniutahɨawe: «Mɨpaɨ ketineuterɨwa Ruhami, taniukikɨ panuyɨne “Mepɨkaneteɨterimari”, xemeri xepɨkaneteɨterima neta nepɨkaxekakaɨyari.   
\p
\v 10 »Peru 'uxa'atɨni warie 'ixaheritsixi teɨteriyari, yumɨiretɨ mepakɨne xiekari haramaratetsita mɨtika mɨkayu'inɨatsinɨa hepaɨ. Kepauka tukari maye'ani xeme hakewa mɨpaɨ xemɨteheterɨwarie: “Mepɨkaneteɨterimari”, mana mɨpaɨ xepɨteterɨwarieni: “Kakaɨyari mayeyuri niwemama”.  
\v 11 Kura teɨterimama meta 'Ixaheri teɨterimama wahamatɨa mekaniyutaxewirikuni, xeime xeikɨa ti'aitame mehexeiyatɨ mepakɨne yukiekaritsie, 'ana Ketsireri mariwetɨ kanayeimɨkɨ.   
\c 2  
\p
\v 1 »Kepauka memɨ'axɨani xe'iwama 'ukitsi mɨpaɨ xeketeniwaruterɨwa: Hami, taniukikɨ manuyɨne “Mepɨneteɨterimari”. Meta 'ukari Xuhama, taniukikɨ manuyɨne “Nepitinenimayatari”.   
\s1 'Ixaheritsixi kememɨtekwinitɨariekai meta kememɨte'utinenimayatsie  
\q1
\v 2 »Peru hikɨ yumaama hetsie xeketeneuhɨpani,  
\q2 mɨkɨri hikɨ pɨkane'ɨya neta nepɨkakɨnaya.  
\q1 Yuhɨxie mayuyewirie witsimɨtixeiyariekakɨ ke'ayuye'itieni 'axamɨtiuka'iyarikɨ,  
\q2 meta yutawie kemɨratikuka ketiuhayewa.   
\q1
\v 3 Ya mɨpaɨ pɨkatiuyuri, ne naime nekatininawairiemɨkɨ,  
\q2 ke'anetɨ mutinuiwaxɨ mɨpaɨ 'anekame nekanihayewamɨkɨ.  
\q1 Makuwakitsie nekanihɨamɨkɨ.  
\q2 Kwiepa tixaɨtɨ mɨkaraxuawe nenihayewamɨkɨ, yeharimɨnetɨ kanimɨmɨkɨ.   
\q1
\v 4 Niwemama nepɨkawatinenimayata,  
\q1 'axamɨtiyuriene hetsie memɨmiemetekɨ.   
\q1
\v 5 Wamaama tuminikɨ muyuwitɨnɨa kanihɨkɨtɨni,  
\q2 Mɨwarutiniwexɨ ka'uyukatewiyatɨ.  
\q1 Mɨpaɨ kaniutayɨni: “Netuxexerima wahamatɨa nepukuyeikani,  
\q2 memɨnetemikwa memɨnetsiharitɨa,  
\q2 muxa huxarieya, rinu 'ixurikiyari, nehatseiti meta tita nemɨranuye'e”.   
\q1
\v 6 'Ayumieme ne huyetana nepɨranutanani xuyakɨ,  
\q2 muwa xeikɨa nepiyenaka huye mɨkataxeiyakɨ.   
\q1
\v 7 Waɨkawa tiuka'eniwatɨ yutuxexerima pɨwakuwauneni,  
\q2 kawataxeiyame mɨpaɨ pɨtayɨni:  
\q1 “Nekɨna matɨari nemitiwitɨ hetsɨa nepɨnuanikeyu,  
\q2 matsi meripaitɨ 'aixɨa nepɨtixeiyariekai keyuri hikɨ”.   
\q1
\v 8 Mɨkɨ mɨpaɨ pɨkaretimaiwe kename ne nehɨkɨ nemɨtimikwa,  
\q1 kaxie winuyari mɨhekwa meta hatseiti nemɨtiyetuirie.  
\q2 Ne waɨkawa nepɨtimɨiririe pɨrata meta huru,  
\q1 ¿ketiuyuri kɨmana? Memɨkayuri kakaɨyarixi pɨwarutiwewi.\f + \fr 2:8\ft  Pɨyɨwe mɨtayɨni \fq Wahari kakaɨyarixiyari puwarutiwewi. \f*   
\b  
\q1
\v 9 »'Ayumieme kepauka tukarieya maye'ani  
\q1 ne tɨriku nepinawairieni kaxie winuyari mɨhekwa.  
\q2 Muxa kaheuhuxakame nepɨhayewa meta rinu 'ixurikiyari kahexeiyame  
\q1 nemɨtiyetuiriekai mawekaku kɨmana meuyukunakakɨ.   
\q1
\v 10 Nepitewiyatsitɨani mɨirikɨa  
\q1 tuxexerimama me'ixeiyakaku,  
\q2 nixewitɨ pɨkayɨweni hetsiena mutanuani.   
\q1
\v 11 Naitɨ mana pɨtiuye'atɨyani 'ixɨarari temawierikayari kemɨtiwewiekai.  
\q1 Meta kemɨtikuyeikakai metseri xikɨraɨyekaku,  
\q2 meta kepauka muka'uxipiwekai meta 'ixɨarari kemɨtiutiwewiwakai xeiwiyari 'aye'axekaku.   
\q1
\v 12 Kaxie haraweriyari kemɨrexeiyakai meta piní,  
\q2 kename mɨkɨ tuxexerimama mete'iyetuiriekai.  
\q1 Maku'ɨtsiya nepayeitɨani,  
\q2 yeuta memɨte'u'uwa mekanitikwaikuni xeikɨa.   
\q1
\v 13 Nepɨtikwinitɨani mɨkɨ tukaritsie  
\q2 hipame kakaɨyarixi mɨtiwarutimawiriwakaikɨ,  
\q1 kepauka witsitiyukukemaritɨwatɨ nakɨtsatekɨ meta kukakɨ  
\q2 ne kanetsiha'eriwatɨ, yutuxexerima wa'utɨma xeikɨa peyeikakai  
\qr —Yawé mɨpaɨ kanaineni—.   
\b  
\q1
\v 14 »'Ayumieme hikɨ nekatini'irɨwiyamɨkɨ:  
\q2 makumawetsie nekanenuwitɨmɨkɨ  
\q2 mana witsi'anekamekɨ nekaneitahɨawimɨkɨ.   
\q1
\v 15 'Ana nekaniyetɨiriemɨkɨ kaxie haraweriyari,  
\q1 mayeweritsie waɨkawa Kemɨtiuka'eniwakai  
\q2 'aixɨa 'aneme nepayeitɨani memanukɨka Mɨnetsitakwewiekɨ.  
\q1 Mana pɨnetsita'eiya temaikɨyari hepaɨ,  
\q2 kepauka 'Ekipitu mayetɨatsie hepaɨ.   
\b  
\q1
\v 16 »Yawé mɨpaɨ kanaineni: Kepauka maye'ani tukari  
\q2 mɨpaɨ pepɨkanetiuterɨwani: “neti'aitɨwame”,  
\q2 matsi pɨta: “nepɨmatsinaki'erie nekɨna”.   
\q1
\v 17 Ne nepɨmeratɨmaiyatsitɨani tawarita pemɨkawakuxatanikɨ memɨkayuri kakaɨyarixi,  
\q2 hatsuakuri pemɨkawatahɨawe.   
\q1
\v 18 Mɨkɨ tukaritsie tɨratu nepɨwewieni  
\q2 Yeutari wahamatɨa,  
\q1 muyuawitsie memɨte'uwɨtɨkɨka wahamatɨa  
\q2 kwiepa memɨteku'ɨretɨwe wahamatɨa.  
\q1 Kiekari mukumanetsie tupi nepɨwanawairieni, 'ixipara, kuyaxi meta  
\q2 para 'aixɨa 'anemekɨ xemu'uwanikɨ yunaitɨ.   
\q1
\v 19 Ne ne'ɨya nematsi'ayeitɨani yuheyemekɨ,  
\q2 nematsi'awitɨkɨni heitseriemekɨ 'aixɨa 'iyari,  
\q2 teyunaki'erietɨ teteheuyuyehɨwirietɨ.   
\q1
\v 20 Pepɨnetsihetimani heitseriemekɨ kenemɨtiuka'iyari hatsuaku nepɨkamatsiku'eirieni,  
\q2 hikɨ 'ana Yawé pekanetimaimɨkɨ.   
\b  
\q1
\v 21 »Yawé mɨpaɨ kanaineni: Mɨkɨ tukaritsie ne yanepɨtikamieni,  
\q1 ne muyuawitsie paitɨ nepɨxeku'eiyani,  
\q2 meta muyuawi kwie pɨ'enieka,   
\q1
\v 22 Kwieta 'imɨari pɨxuaweriyani,  
\q2 kaxie winuyari mɨhekwa huriwa hatseitiyari meta,  
\q2 mɨkɨkɨ mekaniwata'eiyakuni Ketsireri.\f + \fr 2:22 \fq Ketsireri\ft  taniukikɨ paine \fq Kakaɨyari puka'etsa. \f*   
\q1
\v 23 Ne nehetsiemieme kwiepa nepɨwaka'eni.  
\q2 “Nepɨka'itinenimayatari” mɨkɨ wahetsiemieme nepɨwatinenimayata.  
\q1 “Mepɨkaneteɨterimari” nepɨtiwaterɨwa, “Mepɨneteɨterimari”,  
\q2 mɨkɨta mɨpaɨ mepɨtiyuani, “Pɨtakakaɨyari”».   
\c 3  
\s1 'Utseyaxi hutarieka yu'ɨya kemɨtiutiwitɨ  
\p
\v 1 Tawarita Yawé mɨpaɨ kanetiniutahɨawe: «Kenemie tawarita mɨkɨ 'ukaratsi keneutiwitɨki tuminikɨ muyuwitɨnɨa, xeime pɨta mawitɨkɨ. Kenenaki'erieka ne Yawé kenemɨtiwanaki'erie 'ixaheritsixi, tsepa hipame kakaɨyarixi memɨtewarayexeiya tsepa kaxie patsaruyari tsuirayari memikwa'a mawariekame».   
\p
\v 2 Ne mɨkɨ 'ukaratsi nepunanai tamamata heimana 'auxɨwime pɨrata tuminiyarikɨ meta tsewara xei'ikayari heimana 'imeriyu,  
\v 3 mɨpaɨ nekatinitahɨawe: «Mɨixa wiyari nehamatɨa pepukani peru 'axapekayɨanetɨ. Nixeime hamatɨa pepɨkakahuni. Ne meta nepɨkamatsi kumayɨani».   
\p
\v 4 Yurikɨ mɨpaɨ mepɨyɨni 'ixaheritsixi mɨixa wiyari mepu'uwani tiyu'aitɨwame mekahexeiyatɨ, meta mekate'umawarɨmetɨ mawari matitaiyarɨwatsie, meta mekaheixeiyatɨ mawari wewiwame kamixaya meta memɨkayuri kakaɨyarixi.  
\v 5 Peru 'arike 'ixaheritsixi hekwamekɨ Yawé mepɨtiwauni yukakaɨyari, meta Rawiri ti'aitame mekani'eniekuni. 'Imatɨarieka tukaritsie Yawé hetsɨa mepɨ'axɨani memamatɨ mepɨtihɨxima'uni, waɨkawa 'aixɨa kemɨtiuka'iyari.   
\c 4  
\s1 'Ixaheritsixi kememɨte'ayuye'unie  
\q1
\v 1 Xekeneu'enana 'ixaheritsixi,  
\q2 Yawé niukieya xekeneu'eni,  
\q1 'ari Yawé yuxanetsika kanitsutɨamɨkɨ  
\q2 mɨkɨ mana kiekatari wahetsie:  
\b  
\q1 «Neteɨterima wahetsie pumawe 'aixɨa mɨti'ane meta naki'eriya mepɨkahexeiya,  
\q2 meta Kakaɨyari mepɨkamate.   
\q1
\v 2 Matsi mepɨtexuaweriya 'axamɨti'ane meta 'itarika.  
\q2 Waɨkawa mepɨtenawatɨwe, hipame wahamatɨa mepɨhitɨwe, mepɨteyumemiwa.  
\q2 Xewitɨ xɨka tiuyumieni mɨkɨta xewitɨ pimieni.   
\q1
\v 3 Hikɨ 'ayumieme kwiepa pukuwani pɨkatitixuawere,  
\q2 'anari yunaitɨ mepukwini teɨteri.  
\q1 Yunaitɨ mepɨtekwini yeuta memɨte'u'uwa,  
\q2 memɨte'awɨwawe meta haramaratsie memɨteye'uwa.   
\b  
\q1
\v 4 »Xewitɨ yu'iwa pɨkaxanetani meta pɨka'itate'ani.  
\q2 'Ateɨterima mawari wewiwame meputate'a.   
\q1
\v 5 Tukarikɨ tɨkarikɨ mepetiketamɨrike,  
\q2 Kakaɨyari niukametemama yaxeikɨata 'ahamatɨa mepekaxɨrɨwe,  
\q1 'amaamari pɨka'uyeikani,   
\q2
\v 6 neteɨterima mepuka'unarie  
\q2 'atsimekatehetimaika mepɨkwixime.  
\b  
\q1 »Metsɨ pepɨka'itanaki'eri tita yuri mɨraine,  
\q2 neta nepɨkametsinaki'erie mawari wewiwame pemɨhɨkɨtɨni.  
\q1 Kakaɨyari niukieya pematɨmaiyaxɨkɨ,  
\q2 netatsiere 'aniwema nekaniwaratɨmaiyamɨkɨ.   
\q1
\v 7 Kepauka mawari wewiwamete memɨyutimɨirixɨ,  
\q2 matsi waɨkawa 'axamepɨteyuriekai nehetsɨa,  
\q1 kemɨtimariwekai mekanipata  
\q2 mepɨtewinɨarieni yuhetsiemieme.   
\q1
\v 8 Mɨkɨ teɨteri 'axamɨti'ane mawariyari mawari wewiwamete pɨtiwa'ikwai,  
\q2 'ayumieme mawari wewiwamete mepɨyutemamawie teɨteri 'axamemɨteyuriekɨ.   
\q1
\v 9 Mawari wewiwamete meta teɨteri yaxeikɨa mepɨ'anene.  
\q1 'Ayumieme yanepɨtiwatawawirieni kememɨte'u'uximayataxɨ  
\q2 meta yuxexuime yanepɨtiwapitɨani kememɨte'uyuriexɨa.   
\b  
\q1
\v 10 »Tsepa memɨte'utikwa'a peru mepauhakakwikuni,  
\q2 tsepa tɨɨri yuwaɨkawa memɨwarayexeiyaku, peru hatsuaku mepɨkawarayexeiya,  
\q1 Yawé memuku'eirikɨ  
\q2 para memɨyuyetuanikɨ,  
\v 11 hipame 'ukarawetsixi wahamatɨa me'ietɨwetɨ,  
\q2 kaxie winuyari pɨwareuyexɨrɨwa wa'eriwametsie.   
\q1
\v 12 Neteɨterima kɨye kakaɨyariyari xeikɨa mepayexeiya,  
\q2 mɨkɨ kuta kɨye tiwaku'eiya,  
\q1 mepɨkayumaiwawe hipame 'ukarawetsixi wahamatɨa mehitɨwetɨ xeikɨa mepauyexɨrie,  
\q2 yukakaɨyari mepuku'eiri mɨyameyɨatɨ.   
\q1
\v 13 Hɨrite 'amutitɨtɨtsie meta yemuritetsie  
\q2 mana mawari taiyariyari mepɨtiwewiwa meta 'imikieri,  
\q1 tuaxa kɨyeyaritɨa meta haramu meta xiutɨa.  
\q2 'Ayumieme waniwema tuminikɨ memuyuwitɨnɨa mepɨhɨkɨ  
\q1 meta wamu'e'ema hipame mepɨwakumaɨwa.   
\q1
\v 14 Peru nepɨkawaranutaxɨrieni  
\q2 hipame yumɨireme wahamatɨa memɨhitɨwekɨ,  
\q1 wakɨnamata tuminikɨ  
\q2 memuyuwitɨnɨa wahamatɨa memukahipitekɨ,  
\q1 metatsiere 'ukitsi 'ukari mawari wewiwamete tukita wahamatɨa 'ixɨarari mepɨwewie.  
\q1 'Ayumieme 'ikɨ teɨteri mɨpaɨ mepɨteka'unarieni  
\q2 memɨka'u'enanakɨ.   
\b  
\q1
\v 15 »Xɨka 'ekɨ, 'Ixaheri, mɨpaɨ peyɨaneni,  
\q2 Kura hetsie pepɨkarahɨpani.  
\b  
\q1 »Kirikari xepɨkaheuhuni Weti-'Aweni\f + \fr 4:15 \fq Weti-'Aweni\ft  manɨyɨne \fq 'Axamɨti'ane kiita.\f* tukita xepɨkaheutahakeni,  
\q2 mɨpaɨ xepɨkahaitɨkani xeyɨhɨritɨatɨ: “Yawé 'apuyeika”.   
\q1
\v 16 'Ixaheri tsikeru mɨma hepaɨ pɨ'ane.  
\q2 Ketsɨ Yawé tiwaru'ɨwiya  
\q2 yeuta 'a'uyeukaku, muxatsi wahepaɨ pɨka'ane.   
\q1
\v 17 'Epɨrahini memɨkayuri kakaɨyarixi pɨwarutinɨi,  
\q2 tsepatsɨ wahamatɨa mɨtiuyuhayewaxɨ.   
\q1
\v 18 Kepaukari winu memɨkahexeiya,  
\q1 hipame wahamatɨa mepukahipite,  
\q2 metatsiere te'aitamete pɨwanake 'axamɨti'ane.   
\q1
\v 19 'Ayumieme haikɨri mɨtɨrɨkaɨye pɨwataxɨriexɨani,  
\q2 mepɨyutitetewiya hipame kakaɨyarixi memɨwarayexeiyakaikɨ.   
\c 5  
\s1 'Ixaheritsixi kememɨtekwinitɨarieni  
\q1
\v 1 »'Ikɨ niuki xekeneu'eni xeme mawari wewiwamete.  
\q2 Xekeneu'enana 'ixaheritsixi.  
\q1 Xekene'enanaka ti'aitame nuiwarimama.  
\q2 Xehetsie pɨmieme kexemɨte'anutaxɨriyani.  
\q1 Mitsipa kiekariyaritsie xeme xekateni'irɨwiyarieka,  
\q2 Tawuxi hɨriyaritsie winiyari 'amɨtewi xekaniutawieka.   
\q1
\v 2 Tsitihini mɨrakutewatsie putsu muwatixawa xekaniutawewieni.  
\q2 'Ayumieme ne netinixekwinitɨaka 'aixɨa nexeyurietɨ.   
\q1
\v 3 Ne 'Epɨrahini nekanimateni,  
\q2 meta 'Ixaheri nepɨkahatɨmaiyawe.  
\q1 Peru 'Epɨrahini tuminikɨ kaniyumayɨinɨaka,  
\q2 meta 'ixaheritsixi meka'itiyatɨ mepayuyeitɨwa.   
\b  
\q1
\v 4 »'Axakememɨteyurie pɨkawapitɨa  
\q2 Kakaɨyari hetsɨa memɨ'axɨani,  
\q1 mepɨkayumaiwawe 'axamemɨteyuriekɨ hipame wa'ɨitama memɨwakumaɨwakɨ  
\q2 mepɨkayɨwawe Yawé memetimanikɨ.   
\q1
\v 5 'Ixaheri 'uyuta'ɨretɨ 'uxa'atɨniwarie yuhetsie pɨrahɨani.  
\q2 'Ixaheri meta 'Epɨrahini ke'axamemɨte'uyuri yukɨmana mepekaxɨrieni,  
\q2 Kura meta wahamatɨa kanekawemɨkɨ.   
\q1
\v 6 Yumuxatsima meta yuwakaitsixi metewara'arietɨ,  
\q2 Yawé mekanitiwaukuni,  
\q1 peru mepɨka'itaxeiya  
\q2 mɨkɨ mɨwaruku'eirikɨ.   
\q1
\v 7 Yawé xekaniuku'eirieni,  
\q2 yumɨiretɨ tɨɨri mekaniutinunuiwa hipame waniwema.  
\q2 Hikɨ 'ayumieme xekanika'unariekuni meta naitɨ xekwie.   
\b  
\q1
\v 8 »Kuxineta xekenetahɨtsi Kiweya kiekariyaritsie,  
\q2 Xamatsie paitɨ 'awa kehetahɨtsieni,  
\q1 Weti-'Aweni meta xekenetihiwa xemɨyutakwinikɨ, mɨpaɨ mete'uhiwatɨ:  
\q2 “Wenikamini, kene'a'ɨwiyani 'awarita”.   
\q1
\v 9 Kepauka memɨtekwinitɨarieni,  
\q2 'Epɨrahini yuxaɨta puyuhayewa.  
\q1 'Ixaheri nuiwaritemama watsata  
\q2 yanepɨtiwatahɨawe kemɨtiwayurieni.   
\q1
\v 10 'Itsɨkate te'aitamete Kura kwieyaritsie miemete  
\q2 kwie memɨnawatɨwe wahepaɨ mepɨ'anene.  
\q1 Wahetsie nehaxɨa nepɨtatuani  
\q2 haa nemɨwayenetɨani hepaɨ.   
\q1
\v 11 'Epɨrahini 'axapɨtixeiyarie,  
\q2 memeye'unie xeikɨa mepitsaipɨna,  
\q2 memɨkayuri kakaɨyarixi mɨwaruweiyakɨ.   
\q1
\v 12 'Epɨrahini tepaxi wahepaɨ nekaniwakwimɨkɨ,  
\q2 kɨye mɨkɨmie Kura teɨterimama mepɨhɨkɨtɨni.   
\b  
\q1
\v 13 »Kepauka 'Epɨrahini yukwiniya muxei,  
\q2 Kura katinetimani haiyayatsie,  
\q1 'Epɨrahini kaneyani 'Atsiriyatsie  
\q2 mana parewiya kaniutawauni ti'aitame mɨmariwe hetsɨa.  
\q1 Peru ti'aitame mana kiekame pɨkayɨwekai menayehɨanikɨ,  
\q2 meta haiyaya mu'uayemani.   
\q1
\v 14 Ne maye nepayani 'Epɨrahini hetsiemieme,  
\q2 maye nunutsita Kura hetsiemieme.  
\q1 Ne nekɨmana nekaniwatitsanamɨkɨ,  
\q2 meta nekaniyemieni,  
\q1 nemiwiyaxɨ ne'atɨtɨ,  
\q2 nixewitɨ pɨkayɨweni mɨnetsi'unawairieni.   
\q1
\v 15 'Ana nepakunuani nemɨra'aitatsie,  
\q2 kepaukake mɨpaɨ memɨtehetimani kename 'axamete'uyuri.  
\q1 Mepitiwauni kehepaɨ meyɨakaku nemɨwatanaki'erieni,  
\q2 me'u'uxetɨ mepɨnetsitiwauni meyuwaɨriyatɨ».   
\c 6  
\s1 'Ixaheritsixi me'uyu'enieka ta'aurie mekanaxɨrieni  
\q1
\v 1 Mɨpaɨ mekaniutiyuani: Hikɨmɨtɨka Yawé hetsɨa tepɨ'axɨani.  
\q2 Tsepa mɨkɨ mɨtatsi'utitsanaxɨ, peru 'aixɨa teteheu'eriekameta pɨtatsi'ayeitɨanita,  
\q2 mɨkɨ pɨtatiukwinitɨa peru pɨtatsiti'uayemani.   
\q1
\v 2 Huta tukari 'anukayayu tukari pɨtatsi pitɨani,  
\q2 hairieka tukari pɨtatsi 'anuku'uitɨani,  
\q2 'ana mɨpaɨ hamatɨana tepu'uwani.   
\q1
\v 3 'Ana Yawé tepetimani,  
\q2 kemɨtiku'eriwa 'utɨmana tepuhuni.  
\q1 Yurikɨ tau manatineika hepaɨ,  
\q2 tahamatɨa matsiɨkɨtɨ payuyeitɨani,  
\q1 tahamatɨa punuani wiyeri xexerixa mieme hepaɨ,  
\q2 wiyeri witarita mieme hepaɨ kwie mukuhawiya.   
\b  
\q1
\v 4 «¿'Epɨrahini 'ahetsɨa kenetiyurieni?  
\q2 ¿Kura meta kenetiyurieni 'ahetsɨa?  
\q1 Xenaki'eriya hai ximeri mieme hepaɨ pɨ'ane,  
\q2 haɨtsi hepaɨ yapauka mɨtipaparike.   
\q1
\v 5 'Ayumieme nepɨxeheutaxɨriexɨa Kakaɨyari niukametemama newanɨ'akaku,  
\q2 nepɨxe'utiwa neniukikɨ.  
\q2 Kenemɨtixetaxaneta mimierɨkari hepaɨ pɨxeyurieni.   
\q1
\v 6 Ne naki'eriya nepɨxewawirie, mawarika pɨkatixaɨ,  
\q2 matsi Kakaɨyari pɨta xekene'enieka mawari taiyariyari pɨkatixaɨ.   
\q1
\v 7 Xeme 'Arani hepaɨ xepɨte'uyuri:  
\q2 tɨratu ketemɨte'uwewi yaxepɨkatekakɨ,  
\q2 xepɨnetsi'uku'eiri.   
\q1
\v 8 Karaha kiekariyari 'axamemɨte'u'iyari pɨwakiekari,  
\q2 yu'ɨkatekɨ xeikɨa xuriya mepɨtayeuriwa.   
\q1
\v 9 Mawari wewiwamete mepɨyuxeɨrie  
\q2 Tsikeni huyeri'utɨa 'awie metanenieretɨ,  
\q1 tenawayamete wahepaɨ  
\q2 mekaniwakwika mana memuyekɨka metewawawirietɨ.   
\q1
\v 10 'Ixaheri mɨra'aitatsie  
\q2 'axati'aneme nepɨtixeiya.  
\q1 Mana 'Epɨrahini tuminikɨri puyumayɨinɨa  
\q2 meta 'Ixaheri ka'itiyatɨ payuyeitɨwa.   
\b  
\q1
\v 11 »'Ekɨtatsiere Kura,  
\q2 'axamɨti'anekɨ pepɨka'itsana.  
\b  
\q1 »Kepauka ne neteɨterima wahetsie 'aixɨa nemɨtiyurieni,   
\c 7  
\q2
\v 1 ne kepauka 'Ixaheri nemu'uayema,  
\q1 'Epɨrahini meta Tsamariya ke'axamemɨteyuriekai waɨkawa  
\q2 mɨkɨ naitɨ pɨtihekɨare.  
\q1 Mɨkɨ mepɨtewa'itaiyakai,  
\q2 kepauka mɨtinawarienekaitsie kiita,  
\q2 yumɨiretɨ kaye'utɨma mepɨtenawatɨwe.   
\q1
\v 2 Mɨpaɨ mepɨkateku'eriwani  
\q2 ne naime nekatinimaika 'axakememɨte'u'iyari.  
\q1 Ke'axamemɨteyurie mɨkɨ pɨwakunama,  
\q2 ne naime nepɨtimate.   
\b  
\q1
\v 3 »'Axamemɨteyuriekɨ ti'aitame mepɨtemawieritɨa,  
\q2 meta yaxeikɨa 'itsɨkate memɨtewa'itaiyakɨ.   
\q1
\v 4 Huxunu muwatita'a hepaɨ mepɨ'anene  
\q2 taitsie kɨyexi manunetɨani pɨkaheuyewetse  
\q1 kepauka paa wewiwame harina mɨhawiya  
\q2 kepauka 'aixɨa mɨyɨnike.  
\q2 Yunaitɨ mɨpaɨ mepɨ'anene kayu'ɨitama wahamatɨa memɨhitɨwe.   
\q1
\v 5 Ti'aitame 'ixɨarari matiwewiwatsie 'itsɨkate  
\q2 winukɨ mepɨtitarɨwewe,  
\q1 ti'aitame pɨreuyehɨpa kemɨtimariwe  
\q2 tɨratu wewietɨ yunaime meminanaima wahamatɨa.   
\q1
\v 6 Huxunu hepaɨ putiutatawe wa'iyari,  
\q2 'axamɨti'ane ti'eriyakɨ.  
\q1 Tɨkarikɨ wahaxɨa peukukutsu,  
\q2 ximerita panutaneniere.   
\q1
\v 7 Yunaitɨ mɨkɨ huxunu mɨtixɨka hepaɨ mepɨtexɨxɨka,  
\q2 wahetsɨa memɨte'aita mepɨwatakukuya.  
\q1 Yunaime te'aitamete mepɨwaranakaxɨrɨwa,  
\q2 peru xewitɨ mɨkɨ pɨkanetsikuwaune nemiparewienikɨ.   
\b  
\q1
\v 8 »'Epɨrahini yumɨireme nuiwarite pɨwanɨ'ɨ,  
\q2 papa tapaxeikɨa mɨwakwani hepaɨ pɨ'ane.   
\q1
\v 9 Nuiwarite kiekatari tɨrɨkariyaya mepɨkɨme,  
\q2 perutsɨ mɨkɨ 'atsipɨkatiyumate.  
\q1 Kɨpateya putituxarixɨ,  
\q2 peru mɨkɨ 'atsipɨkatimate.   
\q1
\v 10 Mariwemekɨ 'Ixaheri pɨtihekɨata yuhepaɨtsita,  
\q2 peru mɨkɨ Yawé yukakaɨyari hetsɨa pɨkanuawe.  
\q2 Mɨyaranuyemietɨ, pɨka'ikuwaune tɨma.   
\b  
\q1
\v 11 »'Epɨrahini kukuru mautuxa  
\q2 mɨkatiyu'aitɨarinɨa meta mɨkatimaiwe hepaɨ pɨ'ane,  
\q1 heiwa parewiya puta'iwawa 'Ekipitu kwieyaritsie,  
\q2 heiwata 'Atsiriyatsie.   
\q1
\v 12 Peru kepauka mɨpaɨ memɨteyurieni  
\q2 yapauka newipi waheima nepuwiwieni,  
\q1 wikixi wahepaɨ nepɨtiwaxɨrieni,  
\q2 'atahutamexɨa matsi nepɨwaranutaxɨrieni 'axamemɨte'uyurikɨ.   
\q1
\v 13 Xɨa'ui nepaine memɨnetsi'uku'eiri wahetsiemieme.  
\q2 Meke'uka'unarieni nehɨxie memɨnetsi'aye'uniekai.  
\q1 Ne yemekɨ nepɨwaranayexeiyawe,  
\q2 peru mɨkɨ hatsuaku yuri mehaitɨkaitɨ mepɨkanetsihahɨaweni.   
\q1
\v 14 Yu'iyarikɨ mepɨkanetsihahɨawe,  
\q2 yu'utatsie xeikɨa mekaheitɨ meputitsuana.  
\q1 Yu'iku mekuwaunike meta yuwinu 'axa'anekɨa mekanekɨkani  
\q2 nehepaɨtsita meheuniutɨ menakɨkani.   
\q1
\v 15 Ne'aixɨa nepɨtiwaru'ɨkitɨa meta wamamate neputitɨrɨkariyaxɨ,  
\q2 peru mɨkɨ 'axa xeikɨa mepɨteku'eriwakai nehepaɨtsita.   
\q1
\v 16 Kakaɨyari 'Amutewi hetsɨa mepɨka'axɨaku,  
\q2 tupi tiyu'irɨwiyame hepaɨ mepɨ'anene.  
\q1 Peru wa'itsɨkate 'ixiparakɨ mepɨka'unarieni  
\q2 waniuki 'axamanuyɨnekɨ,  
\q1 meta 'Ekipitu kiekatari  
\q2 mepuwatinanaimani.   
\c 8  
\s1 'Eka xekeneuka'etsa meta haikɨri 'amɨpa xepɨka'itsana  
\q1
\v 1 »Kuxineta keneutahɨtsiri 'inɨari mayanikɨ.  
\q2 Kwixɨ hepaɨ 'akanamieni mɨkɨ waneɨkixiwi Yawé teɨterimama wahetsɨa.  
\q1 Tɨratu ketemɨte'uwewi mɨkɨtsie yamepɨkatekakɨ  
\q2 meta ne'inɨari niukiyari mɨkɨ mepuku'eiri,   
\q1
\v 2 hikɨta mɨyamenetekɨhɨawe:  
\q2 “'Ixaheri Kakaɨyarieya tepɨmatsimate”.   
\q1
\v 3 Peru 'Ixaheri 'aixɨa mɨti'ane pɨkatinaki'erie,  
\q2 'ayumieme xewitɨ waneɨkixiwi pɨwaranukuweiya.   
\q1
\v 4 Yɨkɨmana mepɨwaranuka'uitɨwa te'aitamete ne yanekahainekaku,  
\q2 hipame 'itsɨkate mepɨwaranuka'uitɨwa nemɨkawamate.  
\q1 Pɨratakɨ meta hurukɨ yukakaɨyarixi memɨwatiwewiwa  
\q2 para mɨkɨkɨ memuyuka'unakɨ.   
\q1
\v 5 Tsamariya kiekatari tsikeru  
\q2 kakaɨyariyari xemayexeiya xekeneuku'eiri.  
\q1 Xehetsiemieme ne nepuyeha'a.  
\q2 'Atsitake kepauka xeyu'itietɨ xemakɨne.   
\q1
\v 6 Neuxei keneu'ena 'Ixaheri: Mɨkɨ tsikeru Kakaɨyari pɨkahɨkɨ,  
\q2 mɨkɨ tewi pɨwewiyaya.  
\q1 Mɨkɨ tsikeru Tsamariya mieme  
\q2 kanitatarariemɨkɨ.   
\b  
\q1
\v 7 »'Eka xepuka'e,  
\q2 haikɨri 'amɨpa xepɨka'itsana.  
\q1 Tɨriku kɨyeyari yumɨayeyari pɨkahexeiya  
\q2 tɨriku pɨkatixuawere.  
\q1 Xɨka 'utixuawere,  
\q2 teewatari kɨkamete mepitikwani.   
\q1
\v 8 Metsɨ 'Ixaheri kananukaxɨwieni,  
\q2 hikɨri 'etsiwa xeikɨa nuiwarite mepɨmetsinaki'erie.   
\q1
\v 9 'Ixaheritsixi mekanekɨne 'Atsiriya paitɨ,  
\q2 mekaniuyupata puxuri yeutari memɨkaheu'enana wahepaɨ,  
\q2 meta 'Epɨrahini yutuxexerima katiniwayetuiriwakaitɨni.   
\q1
\v 10 Tsepa nuiwarite watsata naitsarie mɨwananene,  
\q2 ne mana neniwakuxeɨrimɨkɨ,  
\q1 'ana mekatenita'aitɨariekuni  
\q2 xewitɨ ti'aitame waɨkawa mariwemekɨ katiniwata'aitɨamɨkɨ.   
\b  
\q1
\v 11 »'Epɨrahini waɨkawa mawarite taiyame kaniutiwewieni,  
\q2 para 'axamɨti'anekɨ memɨteheuyehɨwiyariekakɨ,  
\q1 peru mɨkɨ mawarite taiyame  
\q2 'axamemɨteyuriekakɨ pɨta patɨa.   
\q1
\v 12 Ne nepeka'utɨawe ne'aitsika waɨkawamexɨa,  
\q2 peru mɨkɨ memɨka'imateni hepaɨ mepɨte'ixeiya.   
\q1
\v 13 Mepɨnetemawirie mawari taiyariyarikɨ meta 'imikierite, waiyari mekwatɨ,  
\q2 ne mɨkɨ pɨkanetsinake.  
\q1 Hikɨ ne ke'axamemɨteyurie naime nepɨkaratɨmaiya,  
\q2 ke'axamemɨte'uyurikɨ mɨkɨkɨ nepɨwaranutaxɨrieni,  
\q2 mekanakunuaxɨakuni 'Ekipitu.   
\q1
\v 14 'Ixaheri kemɨ'ane mitawewi patɨmai, meta yɨkɨmana paratsiyute puyutiwewiri,  
\q2 meta Kura kiekaritetsie waɨkawa kuraru 'amatitetewa kanawewietɨyani,  
\q1 peru ne wakiekarite 'aixɨa mɨreukunatɨkatsie  
\q2 tai nepaukaxɨriexɨani mɨwatixɨtsitɨanikɨ».   
\c 9  
\s1 'Ixaheri 'uximatɨarika kemɨtipitɨarieni  
\q1
\v 1 Merikɨte 'Ixaheri, pepɨka'atemawieka,  
\q2 'ixɨarari pepɨkawewieka nuiwarite wahepaɨ.  
\q1 'Axapekatiniuyurieni:  
\q2 'Akakaɨyari pekaniuku'eirieni.  
\q1 Tɨriku tuminiyari kepaɨmeme pemukaxexeiya kakaɨyarixi pepuwayetuiriwa.   
\q1
\v 2 Tɨriku meta kaxie takari pɨkatixuawere,  
\q2 ni winu mɨhekwa pumaweni 'aixɨa ha'anetɨ.   
\q1
\v 3 Yawé kwieyatsie xepɨka'u'uwaniri,  
\q2 'Epɨrahini 'Ekipitu kanakunuamɨkɨ  
\q2 meta 'Atsiriya timieme mɨkati'itiya pepɨtitikwani.   
\q1
\v 4 Tawariri Yawé winu xepɨkayetuirieni,  
\q2 mɨkɨri pɨka'inakeni xemawarika.  
\q1 Mɨkɨ paa pɨkaxetanaki'eririeni, 'ayumieme xepɨtitsuani,  
\q2 kemɨ'ane memitikwani mɨkɨ meka'itiyatɨ mepakɨne.  
\q1 Haaka nunuitɨwame xeikɨa pɨhɨkɨ,  
\q2 peru Yawé yutukita pɨka'inaki'erie.   
\b  
\q1
\v 5 ¿Kexeteyurieni 'ixɨarari matineikatsie,  
\q2 yatɨni Yawé hetsiemieme waɨkawa kɨkamete xemuyukuxexeɨriwatsie?   
\q1
\v 6 Tsepa xemuyuta'unaxɨ xemɨka'unarienitsie,  
\q2 'ekipitutari mepɨxetiwiya, Menipitsi kiekariyaritsie mepɨxekateuku.  
\q1 Witsimɨti'anene xemɨtehexeiya pɨratakɨ, mɨtiwewiyatɨka tupiriyatsata pɨtiyuhayewa,  
\q2 xexamaru xuya penukanani.   
\q1
\v 7 'Uximatɨarika tukariyari paye'ari,  
\q2 meta tukari paye'a memɨte'ayukatuanikɨ.  
\q2 'Ixaheri mɨpaɨ ketinemaika  
\q1 'Ariri pɨwaɨkawa 'axakepemɨtiuyuri,  
\q2 mɨixari pepɨkaheu'ena,  
\q1 Kakaɨyari niukameya mɨka'uka'iyari xeikɨa pepɨxata,  
\q2 tewi Kakaɨyari 'iyarieya mɨkahexeiya pɨkaheyuta'eriwa.   
\q1
\v 8 Kakaɨyari meta niukameya,  
\q2 'Epɨrahini mɨtaniere kanihɨkɨtɨni,  
\q1 peru naitsarie huyeta pepiwiniyane,  
\q2 pepitixani'eri Kakaɨyari kiitana.   
\q1
\v 9 Kemɨkatiheitserie xeteyurietɨ 'ari xepakɨ,  
\q2 Kiweya mɨtiuyɨ hepaɨ,  
\q1 Peru Kakaɨyari pɨkaratɨmaiya waɨkawa kexemɨte'uyuri  
\q2 'uximatɨarika pɨxepitɨani 'axaxemɨte'uyurikɨ.   
\b  
\q1
\v 10 Mɨpaɨ kanaineni Yawé: «Kepauka 'Ixaheri nemutaxei,  
\q2 makumawetsie kaxie takari nemutaxeiya hepaɨ nepuyɨ,  
\q1 kepauka 'atutsima nemɨwaruxei meripai miemete,  
\q2 xapa takari yɨyɨrime nemuxeiya hepaɨ nepuyɨ.  
\q1 Peru mɨkɨ mepekɨ Wahari-Pehuxi kakaɨyariyari hetsɨa,  
\q2 mepɨnetsi'uku'eiri, tewiyarikatsie mepuyuyetua,  
\q1 'anari wahepaɨ 'axame'anenetɨ mepakɨ  
\q2 menaki'eriwatɨ hepaɨna.   
\q1
\v 11 'Epɨrahini kemɨrexeiyakai 'aixɨa ti'anekame, mɨkɨri kanitawimɨkɨ wiki hepaɨ kanayeyeimɨkɨ,  
\q2 'anari 'aniwema mepɨkatinunuiwa meta 'ukari mepɨkatihukataxɨani.   
\q1
\v 12 Tsepa tɨɨri memɨwaxeiya hipame mewawereme,  
\q2 ne nepɨwarakuyeitɨani 'ena kwiepa.  
\q2 Xɨa'ui kepauka mɨkɨ memɨxeku'eirieni.   
\q1
\v 13 'Epɨrahini mɨpaɨ nepɨtixeiya, Tiru kwieyari hepaɨ witsimɨraku'anetsie mɨye'etsieka hepaɨ.  
\q2 Peru 'Epɨrahini pɨwayetuaya yuniwema memɨkwi'iwakɨ».   
\b  
\q1
\v 14 Neuxei Yawé, ¿Ketita petiwayetuirieni?  
\q2 'Uka 'anuye'ikwitɨwame meta tsitsi ka'ayemaneme.   
\b  
\q1
\v 15 «Kirikari mepikatsutɨa 'axameteyurietɨ,  
\q2 mana nepikatsutɨa newa'uxiwe'erietɨ.  
\q1 'Axameteyuriekaku,  
\q2 nekiita nepɨwaranuyexɨrieni.  
\q1 Ne nepɨkawatanaki'erieniri,  
\q2 yunaitɨ wa'itsɨkate 'axamemɨteyuriekɨ meteyukahiwe'erietɨ.   
\q1
\v 16 'Epɨrahini kaniutayɨnare:  
\q2 nanari kaniutiwani takari pɨka'ukayaxixɨ.  
\q1 Tsepa mutiutihukataxɨ,  
\q2 nekanenuyemiemɨkɨ nunutsi tsepa witsimɨ'ane».   
\b  
\q1
\v 17 Xemɨkahenu'enikɨ, 'ayumieme ne Kakaɨyari pɨkaxetanaki'erieni,  
\q2 kɨkamete xepakɨne nuiwarite watsata.   
\b  
\c 10  
\q1
\v 1 'Ixaheri Kaxie takari waɨkawa meukatei hepaɨ pɨ'anekai  
\q2 putixuxuawerekai witsi'anenetɨ kayunewierinɨatɨ.  
\q1 Peru kepauka matsi waɨkawa mutixuxuawerekai,  
\q2 matsi waɨkawa mawari taiyamete mepɨtiwewiwakai,  
\q1 kepauka wakwiepa waɨkawa mɨtiutixuaweriyakai,  
\q2 waɨkawa matsi tetexi patsietɨkaime witsi'anenekame mepɨtiwewiwakai.   
\q1
\v 2 'Iyarieya pɨharuani,  
\q2 peru yɨkɨmana katinayukatuamɨkɨ kemɨtiuyuri.  
\q1 Yawé wamawari taiyamete kaniti'unamɨkɨ  
\q2 meta naime tetexi mɨpatsietɨka memeyexeiyakai.   
\b  
\q1
\v 3 Heiwatɨ mɨpaɨ me'utiyuani: «Yawé tepɨkahayemakaxe,  
\q2 'ayumieme tati'aitɨwame tepɨkahexeiya».  
\q1 Peru xɨka teheixeiyanike,  
\q2 ¿Ketiyurienikekai tahetsiemieme?»   
\q1
\v 4 Mekatenikuxatani xeikɨa kememɨteyukuhɨawe,  
\q2 yuri hepaɨ me'utiyuatɨ peru yakɨxeikɨa tɨratu mekanikuwewiwani,  
\q1 'ayumieme 'axamɨ'ane xeikɨa kanixuaweni watsata  
\q2 kanikaxutuweni tupiriya 'axamɨ'anene yeuta mieme hepaɨ.   
\q1
\v 5 Tsamariyatari waɨkawa mekanimamaka  
\q2 tsikeru Weti-'Aweni kakaɨyariyari memayexeiyakɨ.  
\q1 Tsikeru teteyari memayexeiya waɨkawa mepɨyutihiwerieni,  
\q2 yaxeikɨata mawari wewiwamete memɨwarayexeiya kakaɨyarixi.  
\q1 Waɨkawa meyuhiwerietɨ mepɨtihiwa mɨmariwekaikɨ,  
\q2 wakakaɨyari xeime kwieyaritsie manutɨkienikɨ.   
\q1
\v 6 Tsikeru nanutɨkiemɨkɨ 'Atsiriya paitɨ  
\q2 'imikieri hepaɨ ti'aitame mɨmariwe mekaniyetuiriekuni.  
\q1 'Epɨrahini kaniyutitewiyamɨkɨ,  
\q2 'Ixaheri meta kaniyutitewiyamɨkɨ yukakaɨyarixi wahetsiemieme.   
\q1
\v 7 Tsamariya kiekariyari kanikumawerimɨkɨ meta ti'aitame,  
\q2 kɨye 'etsipetɨ mehautsitɨarieni hepaɨ.   
\q1
\v 8 Watukite 'etsimupepe kaniti'unariemɨkɨ kwiepa mieme,  
\q2 hakewa 'Ixaheri 'axatiyurienetɨ matɨa.  
\q2 Xuya meta tupiriya kanitiwawerimɨkɨ mawari taiyame matiwewiwakaitsie.  
\q1 Hikɨ hɨri mɨpaɨ mekatenitahɨawikuni:  
\q2 «Xeketananukanama», hɨrite 'etsimɨpepe:  
\q2 «Tahetsie keneukaxɨri mɨtatsikwinikɨ».   
\b  
\q1
\v 9 «'Ekɨ, 'Ixaheri, 'axapetiyurienetɨ pepumie  
\q2 Kiweya paitɨ mɨtiyukatsutɨatsietɨtɨ,  
\q2 pepɨkatihayewa 'axapetiyurienetɨ.  
\q1 Kiweya kanitamieriemɨkɨ  
\q2 'axamɨtiuka'iyarikɨ.   
\q1
\v 10 Kepauka ne yanemɨra'eriwa, nepɨtiwakwinitɨani,  
\q2 'ana nuiwarite meyukuxeɨrieme mekanitamiekuni,  
\q2 mewaranutaxɨrienike waɨkawari 'axamemɨte'uyurikɨ.   
\q1
\v 11 'Epɨrahini tsikeru mɨmaxiutɨarie pɨhɨkɨ,  
\q2 mɨkɨ pinake tɨriku mu'uneni,  
\q2 peru ne yuku nepɨka'enutitekiri.  
\q1 Peru hikɨ 'Epɨrahini yuku nekananutitekiriemɨkɨ,  
\q2 Kura kanitakwietsanamɨkɨ,  
\q2 Kakuwu kwie 'aixɨa kaniyurimɨkɨ».   
\b  
\q1
\v 12 Xekeneuka'etsa yuhetsiemieme kemɨtiheitserie,  
\q2 Naki'eriya takariyari xekeneuka'itsana,  
\q2 kwietsanaripa xeketene'uximayaka.  
\q1 'Ari tukari paye'ari Yawé xema'eriwanikɨ,  
\q2 kepaukake munuani penɨ'ani heitserie mɨtiyupitɨwa wiyeriyari.   
\q1
\v 13 Peru xeme 'axamɨti'ane xepuka'e, 'ayumieme mɨkatiheitserie xepɨka'itsana,  
\q2 'itarika takariyari xekaniutikwani,  
\q1 wakaxetatetsie xemeuwawaɨrekaikɨ  
\q2 meta wakuyaxi memɨyumɨirekaikɨ.   
\q1
\v 14 Kuyaxa payani tɨranari kemɨtiutayuane pɨti'eniɨriɨkɨni,  
\q2 kememɨteyuku'awietatɨka naitɨ pɨtiti'unarieni,  
\q1 kemɨtiuyuri Tsarimani Weti-'Axiweri kuyaxa matɨatsie,  
\q2 kepauka wamamama memutixitekie  
\q2 meta tɨɨri yunaitɨ.   
\q1
\v 15 'Ikɨ Weteri kiekatari mɨyamekanixe'uyurieni,  
\q2 'axaxemɨteyuriekɨ kwinimieme.  
\q1 'Ixaheri kwieyaritsie ti'aitame kanimieriemɨkɨ yuheyemekɨ  
\q2 'amɨtikataretsie.   
\c 11  
\s1 Kakaɨyari kemɨtitanaki'eri 'Ixaheri  
\q1
\v 1 «Kepauka 'Ixaheri mununutsitɨkai 'anapai nepinaki'eriekai,  
\q2 'Ekipitu 'uyeikakaku neniwe nepenayexei.   
\q1
\v 2 Kepauka matsi waɨkawa nemehɨawekai,  
\q2 matsi humapai kaniumiekaitɨni.  
\q1 Mawari taiyariyari pɨwamawirienekai memɨkayuri kakaɨyarixi,\f + \fr 11:2\ft  Pɨyɨweta mɨtayɨni \fq Wahari kakaɨyarixiyari. \f*  
\q2 'ɨkwa pɨwatairienekai.   
\q1
\v 3 Ne 'Epɨrahini muyeiwenikɨ nepɨtiti'ɨkitɨa,  
\q2 ne mamayatsie nemɨkawiekai nepɨhɨkɨ.  
\q1 Peru mɨkɨ pɨkanetsihetima  
\q2 kename ne 'aixɨa reu'eriekame neheyeitɨwakai kepauka mɨtikuyeni.   
\q1
\v 4 'Ahurawa nepuwaha kaunari witsimɨ'anenekɨ,  
\q2 'ahurawa nepuwaha naki'eriya kaunariyarikɨ.  
\q1 Kemɨti'uximayakai mɨkɨ yuku nepinawairi,  
\q2 ne'inaki'erietɨ 'ahurawa neputɨa nemɨtitaminikɨ.   
\b  
\q1
\v 5 »'Ekipitu xepɨkahakunuaxɨaniri,  
\q2 'Atsiriya pɨta xehetsie pɨtita'aita,  
\q2 nehetsɨa xemɨ'axɨanikɨ xemɨka'uyuwaɨrikɨ.   
\q1
\v 6 Xekiekaritetsie 'ixipara me'u'ɨtɨ mekani'axɨakuni,  
\q2 xekitenie mepɨteheuwitexɨani  
\q2 kememɨteku'eriwakai mepɨkaheye'atɨani.   
\q1
\v 7 Neteɨterima mepuyuwaɨriya memɨkanetsinaki'eriekakɨ kenemɨtitewa,  
\q2 'ayumieme tsepa memɨnetsihahɨawe ne nepɨkawaparewieni.   
\b  
\q1
\v 8 »'Epɨrahini, nepɨkayɨwe nemetsiyetuani.  
\q2 'Ixaheri, nepɨkayɨwe nemetsi'uku'eirieni.  
\q1 Ne nepɨkayɨwe nemetsiyetuani 'Arimaha kenemɨtiyetua hepaɨ.  
\q2 Ne nepɨkayɨwe nemetsi'uku'eirieni Tsewuhini hepaɨ.  
\q1 Netaɨta, ne'iyari pɨkarexeiya,  
\q2 metatsiere nekwinurite panukuyuane.   
\q1
\v 9 Peru ne tawarita nepɨkayeha'ani meta  
\q2 'Epɨrahini tawarita nepɨkaka'una.  
\q1 'Ahamatɨa tewi pɨka'uyeika,  
\q2 ne mana nemuyeikakɨ, Kakaɨyari nemɨpatsie,  
\q2 'ayumieme kiekari nepɨkatamieni».   
\b  
\q1
\v 10 Yawé maye hepaɨ puyutahaxɨatɨani,  
\q2 mɨkɨta mepenukuweiya.  
\q1 Kepauka Yawé haxɨaya meme'enieni,  
\q2 niwemama tau makayuyuipiketsie hepa mepatinexɨani memamatɨ.   
\b  
\q1
\v 11 «'Ekipitu paitɨ mepanexɨani, wikixi wahepaɨ me'uyu'unarɨmetɨ.  
\q2 'Atsiriya paitɨ mepanexɨani kukuruxi wahepaɨ memamatɨ,  
\q2 ne wakiita nekaniwareuta'ɨnaxɨamɨkɨ  
\qr —Yawé mɨpaɨ kanaineni—.   
\s1 'Ixaheri ke'axamɨtiuyuri  
\q1
\v 12 »'Epɨrahini pɨneti'itaiyane,  
\q2 'Ixaheri mɨra'aita 'itarikakɨ xeikɨa niuki pɨxɨatɨa,  
\q1 Kura kuyeikame pɨhɨkɨ, Kakaɨyari hetsɨa 'ateewa paitɨ puyeika.  
\q2 Kakaɨyari mɨpatsie yamɨtikamie hetsɨa 'ateewa paitɨ puyeika.   
\c 12  
\q1
\v 1 'Epɨrahini 'eka xeikɨa kanikwaka,  
\q2 tukarikɨ 'eka mɨxɨka 'utɨa pukuyeika,  
\q2 waɨkawa 'itarika kaniwewieka meta kaniyumieneni.  
\q1 'Atsiriya ti'aitame hamatɨa tɨratu mepɨwewietɨwe,  
\q2 'Ekipitu ti'aitame hetsɨa hatseiti kaniyetuayani mɨtiyutuaka hepaɨ».   
\b  
\q1
\v 2 Yawé Kura kanixanetani,  
\q2 pɨrayukatɨani Kakuwu naime kemuyuri,  
\q2 naime kemɨtiuyuri mɨkɨta mɨpaɨ pɨtipitɨarieni.   
\q1
\v 3 Yumaama hukayatsie paitɨ yekaitɨ yu'iwa putami,  
\q2 meta kepauka temaikɨ matɨa Kakaɨyari hamatɨa puyutami.   
\q1
\v 4 Niuki tuayame putami pe'iwaxɨ,  
\q2 putatsua pitawawiri 'aixɨa miyurienikɨ.  
\q1 Weteri pikaxei,  
\q2 mana hamatɨana pɨtiutixa,   
\q1
\v 5 Yawé Kakaɨyari Naimekɨmɨtɨrɨkaɨye hamatɨa pɨtiutixa,  
\q2 Yawé mɨtitewa.   
\q1
\v 6 Peru 'ekɨ kenenua 'akakaɨyari hetsɨa,  
\q2 peti'akanaki'erietɨ kemɨtiheitserie ketineyurieneni,  
\q2 hetsiena yuri peti'erietɨ.   
\b  
\q1
\v 7 Kanani ti'inɨnɨatameya 'aixɨa pɨka'anene,  
\q2 pinake hipame mɨtiwanawatsirieneni.   
\q1
\v 8 'Epɨrahini mɨpaɨ putaine yuta'ɨretɨ.  
\q2 «Waɨkawa nepɨrexeiya,  
\q2 waɨkawa ne'ukatewame pɨnetsi'ayeitɨa.  
\q1 Naime nemɨrana'iwaxɨtsie xɨka xete'utixeiya  
\q2 mana xepɨkatekaxeiya 'axamɨti'ane».   
\b  
\q1
\v 9 «Ne Yawé nekanihɨkɨtɨni 'akakaɨyari  
\q2 'Ekipitu pe'uyeikakaku paitɨ,  
\q1 nekamanakunuitɨamɨkɨ 'ixuriki kiiyarita pekanayekaimɨkɨ,  
\q2 kepauka makumawetsie temutakaxei hepaɨ.   
\q1
\v 10 Ne Kakaɨyari niukametemama nepɨtiwarutaxatɨa,  
\q2 mamariwaweme 'inɨari nepɨtixe'uxeitsitɨa,  
\q2 ne ne'utainekaku 'ɨxatsikɨ mepɨtexekuxaxatɨwakai».   
\b  
\q1
\v 11 Karaha kiekatari 'axamekateniu'iyarini,  
\q2 Kanahekɨakari tixaɨ pɨkarayani.  
\q1 Kirikari paitɨ tuurutsixi mepɨwaretimawa,  
\q2 'ayumieme mɨrayutimawatɨre tetexi kanitaxɨriexɨamɨkɨ,  
\q2 'ɨtsita paitɨ.   
\q1
\v 12 Kakuwu kaniuyuta'una 'Arami hɨriyaritsie,  
\q2 'Ixaheri katiniuta'uximayata muxatsi wahɨiyarikɨ  
\q2 yu'ɨya 'iwanetɨ.   
\q1
\v 13 'Ixaheri 'Ekipitu mayewitɨkienikɨ meta mita'ɨwiyakɨ,  
\q2 Yawé yuniukame kanenɨ'ani.   
\q1
\v 14 Peru 'Epɨrahini Yawé kaniuyehaxɨatɨani,  
\q2 'ayumieme Kakaɨyari waɨkawa kaniwarutixani'erieni.  
\q1 Hikɨ Yawé pɨrekapitɨani ke'axamɨtiuyuri,  
\q2 kemɨtiuka'iyari mɨpaɨ katinanuyeyeimɨkɨ.   
\c 13  
\s1 Yawé 'Ixaheri hetsiemieme kemɨtiuyeha'a  
\q1
\v 1 'Epɨrahini pɨmariwekai 'ixaheritsixi wahɨxie.  
\q2 Kepauka mɨtikuxatakai teɨteri mepɨmamakai me'i'enietɨ.  
\q1 Peru mɨkɨ Wahari hayexeiyatɨ patɨa,  
\q2 'ayumieme 'axamɨti'anekɨ kaniumɨni.   
\q1
\v 2 Hikɨ yaxeikɨa 'axapɨtiyuriene,  
\q2 mɨkɨ katiniyuwewirieka kemɨtiyukɨhɨawe,  
\q1 kakaɨyarixi pɨratakɨ pɨtiwawewie, kakaɨyarixi memɨkwaniyarietɨka,  
\q2 mamakɨ memɨwewiyatɨka.  
\q1 Wahepaɨtsita meputiyuane:  
\q2 «Teɨteri mepɨtewamawirie  
\q2 meta mepɨwati'itsewe tsikerutsixi wahepaɨ me'aneneme».   
\q1
\v 3 'Ayumieme hai ximeri mieme hepaɨ me'anenetɨ mepakɨne,  
\q2 haɨtsi ximeri paitɨ manuku'eke hepaɨ,  
\q1 xatsi 'eka mei'enitsitɨwa hepaɨ,  
\q2 kɨtsi huxunuta matineika hepaɨ.   
\b  
\q1
\v 4 «Peru ne Yawé 'akakaɨyari nekanihɨkɨtɨni,  
\q2 'Ekipitu paitɨ pe'uyeikakaku.  
\q1 'Ayumieme tawarita xeime Kakaɨyari pepɨkahetimani ne xeikɨa,  
\q2 nixeime 'awikweitsitɨwame pepɨkakaxeiya ne xeikɨa.   
\q1
\v 5 Ne nepɨyɨanekai makumawetsie nemɨmatsihetima,  
\q2 mɨkahakawiwiye makuwakitsie.   
\q1
\v 6 Ne nepɨtixe'umi xeme xeputihuxai,  
\q2 peru xehuxatɨ xepuyuti'ɨrixɨ  
\q2 meta xepɨnetsihatɨmai.   
\q1
\v 7 'Ayumieme ne wakɨmana maye nepayani,  
\q2 nepɨwatihupieni huye tetsita, hatɨwe hepaɨ.   
\q1
\v 8 Nepɨwatakwini meta watawitsie nepɨwareuxutsixɨani  
\q2 hutse yuniwema wakwerietɨ mɨtiyuyuruwa hepaɨ.  
\q1 Maye hepaɨ nepɨtiwakwani.  
\q2 Yeutanaka 'ɨtsita mɨtiyutsana hepaɨ.   
\b  
\q1
\v 9 »'Ixaheri nepɨmatsika'una,  
\q2 kemɨ'ane mɨmatsiparewie pemaye'uniekɨ.   
\q1
\v 10 ¿Hakewa ti'a'aitɨwame,  
\q2 para naime 'akiekarite mɨtawikweitsitɨanikɨ?  
\q1 ¿Hakewa 'a'itsɨkate pemɨwaruta'iwau:  
\q2 “Ti'aitame meta 'itsɨkate keneneyetuiri”?   
\q1
\v 11 Neha'atɨ ti'aitame nemetsi yetuiri,  
\q2 neha'atɨ nemetsi'unawairi.   
\q1
\v 12 Ke'axamɨtiuyuri 'Epɨrahini kaniuti'utsieni,  
\q2 naitɨ paka'utɨarie ke'axamɨtiuyuri.   
\q1
\v 13 'Ukaratsi tiniwerɨmetɨ kukuiniyaya paye'axime,  
\q2 peru mɨkɨ nunutsi pɨkayɨkɨhɨawe:  
\q1 kepauka maye'ani manuyeyanikɨ,  
\q2 'aixɨa pɨkatikuyeixa mɨpaɨ kani'aneni 'Ixaheri mɨkayuwaɨriyakɨ.   
\b  
\q1
\v 14 »¿Netixetawikweitsitɨani mɨkite wateukiyapa?  
\q2 ¿Ne mɨkite watsata netixe'ayehapani?  
\q1 ¿Kewari mɨya, kemɨtiyuruwa?  
\q2 ¿Kewari mɨki teukiyapa, kepemɨtiyuka'una?  
\q2 Xekenahuni, ne nepɨkaxetinenimayata».   
\b  
\q1
\v 15 Tsepa 'Epɨrahini rexeiyatɨ matɨa yu'iwama watsata,  
\q2 Yawé 'ekaya kaninuamɨkɨ,  
\q1 'eka mɨxɨka makumawetsie mieme,  
\q2 hamuhapane meta haixate kanikawaxɨamɨkɨ.  
\q1 Tita memɨteheuxeiya katinika'unariemɨkɨ,  
\q2 naime tita witsiti'anenekame memɨtehexeiyakai katinikumawerimɨkɨ.   
\q1
\v 16 Teɨteri Tsamariya kiekatari yuhetsie mekatenahɨakuni,  
\q2 yukakaɨyari me'aye'unietɨ mepakɨ.  
\q1 'Ixiparatekɨ mekanikwi'iwakuni,  
\q2 tɨɨri mekanititetseweiyakuni kwiepa,  
\q2 memayehukatɨka yuhukatsie mekaneuxitekiexɨakuni.   
\c 14  
\s1 'Ixaheri ta'aurie kemɨrawenikekai para mɨreuyehɨwiyarienikɨ  
\q1
\v 1 'Ixaheri, kenenua Yawé 'akakaɨyari hetsɨa.  
\q2 Ke'axapemɨtiyuriene mɨkɨ pɨmatsihekahɨpa.   
\q1
\v 2 'Aixɨa ketineu'ahɨawi kepemɨtayɨni,  
\q2 Yawé hetsɨa kenenua mɨpaɨ ketineutahɨawi:  
\q1 «Ketatineuyehɨwirieka ke'axaketemɨte'uyuri,  
\q2 'aixɨa 'anemekɨ ketaneutanaki'eri  
\q1 mawari hepaɨ,  
\q2 tepɨmatetaxatɨani.   
\q1
\v 3 'Atsiriya pɨkatatsitawikweitsitɨani,  
\q2 kawayutsixi kuyaxa miemete wahetsie tepɨka'anutiyaxe.  
\q1 Tawariri tepɨka'itaterɨwani “'ekɨ takakaɨyari pepɨhɨkɨ”  
\q2 tixaɨtɨ tamamakɨ tiwewiyakame tepɨkate'ayexeiya,  
\q2 'ahetsie nutui pikaxeiya kepemɨti'akanenimaya».   
\s1 Kakaɨyari kemɨtiwaruta'ei  
\q1
\v 4 «Ne ke'axamemɨte'uyuri 'aixɨa nepɨwayurieni  
\q2 nepɨwanaki'erieka 'aixɨa 'anemekɨ,  
\q2 kenemɨtiha'akai wahetsiemieme nepɨtiuhayewaxɨ.   
\q1
\v 5 Ne wiyeri hepaɨ nepɨ'aneni 'Ixaheri hetsiemieme,  
\q2 yanepɨtiyurieni mɨkaxutunikɨ texuxuri tuturiyari hatetsita mieme hepaɨ.  
\q2 Nanayari tetɨata paitɨ ratiwiwiyame nepayeitɨani Riwanu kɨyeyari hepaɨ.   
\q1
\v 6 Yɨrariyari waɨkawa pɨtiwawere,  
\q2 huriwu kemɨtimamariwawe mɨpaɨ pɨtipapare  
\q2 meta witsimu'ɨa kariuxa Riwanu mieme hepaɨ.   
\q1
\v 7 Ne'etɨritɨa mepuyutikiitɨani,  
\q2 mepɨtiwawere tɨriku hepaɨ.  
\q1 Mepɨkayɨyɨrani kaxie hepaɨ,  
\q2 mepukuxaxatsiwani winu Riwanu mieme hepaɨ.   
\q1
\v 8 Neuxei 'Epɨrahini, kakaɨyarixi wa'ɨkiyari tixaɨtɨ pɨkatihɨkɨ.  
\q2 Ne nemetsiku'eiya nekanihɨkɨtɨni meta nemetsi'ɨwiya.  
\q1 Huku kɨyeyari yamɨtitsiɨraɨye nekanihɨkɨtɨni,  
\q2 kepemɨtiutixuxuawere ne nekatiniyurieneni».   
\b  
\q1
\v 9 Kemɨ'ane mɨtimaiwe kaneitimaitɨyeikani,  
\q2 kemɨ'ane waɨkawa mɨtiuyemate.  
\q1 Kaniyuritɨni Yawé huyeya kanixeuraɨyeni,  
\q2 mɨkɨ 'utɨma mekaniuhuni heitserie memexeiya,  
\q2 peru kemɨ'ane 'axamemɨteyurie mekanetiketamɨrikeni meteyukahiwe'erietɨ.   