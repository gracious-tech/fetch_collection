\id PRO  
\h Temaiwawemete 
\toc1 Temaiwawemete kememɨte'ɨ'ɨxatsita 
\toc2 Temaiwawemete 
\toc3 Temai 
\mt1 Temaiwawemete kememɨte'ɨ'ɨxatsita  
\c 1  
\ms1 'Ɨxatsi kehepaɨ mɨ'ayumieme  
\p
\v 1 Tsarumuni 'ɨxatsiteya Rawiri nu'aya, 'Ixaheri kwieyaritsie ti'aitame:   
\q1
\v 2 petimaiwetɨ pemayanikɨ meta 'aixɨa 'anemekɨ pemuyeikanikɨ,  
\q2 meta mɨtiuyemate niukieya pemetimaitɨyeikanikɨ,   
\q1
\v 3 mɨtaheitseritɨarienikɨ yamɨtimaikakɨ tita 'aixɨa mɨti'ane tita 'axamɨti'ane,  
\q2 heitseriemekɨ yamɨtikamienikɨ hepaɨtsita, heitseriemekɨ 'aixɨa mɨtiyurienenikɨ meta yunaime 'aixɨa mɨtiwaxeiyanikɨ,   
\q1
\v 4 'aixɨa 'anemekɨ pɨtiwapitɨa kemɨ'ane 'atsimemɨkatemate, meta temari mete'uyemaitɨ memakɨnekɨ,  
\q2 kemɨtiuyurieni hepaɨtsita.   
\q1
\v 5 Mɨtimaiwe 'ikɨ ke'u'enieni, matsi waɨkawa mɨretimanikɨ,  
\q2 matsi heitserie kaneti'enatɨyeimɨkɨ,   
\q1
\v 6 meitimanikɨ tita 'ɨxatsi 'inɨariyari mɨtixata mɨkɨ pɨtimaika,  
\q2 temaiwawemete waxatsika mɨkayumainɨa.   
\b  
\q1
\v 7 Yawé 'ayemakatɨ mɨtiuyemaikakɨ kanitsutɨni,  
\q2 'atsimemɨkatemate mɨtimaiwenikɨ mɨ'ayumieme mepɨxani'erie meta memɨtaheitseritɨarienikɨ.   
\ms1 Mari'itɨarika mɨtimaiwenikɨ mukuwauni hepaɨtsita  
\q1
\v 8 Temaikɨ, keneu'eni 'apaapa kemɨmatiku'ɨxatsitɨwa,  
\q2 meta 'amaama kemɨmati'ɨkitɨa pepɨkahetɨtɨmaiyani.   
\q1
\v 9 Mɨpaɨ xɨka yapetikamieni 'amu'utsie witsimɨ'ane pemanakeka hepaɨ pepɨ'aneni,  
\q2 meta kuka pematitɨkɨni hepaɨ pepɨ'aneni.   
\b  
\q1
\v 10 Temaikɨ, xɨka 'axateyuruwamete memateku'itaiyani,  
\q2 wahamatɨa pepɨkaheyeikani.   
\q1
\v 11 Xɨka mɨpaɨ memetehahɨaweni:  
\q2 «Kɨmɨ tahamatɨa kenemie.  
\q1 Xeime tepuhupieni tsepa 'atsimɨkatiuyuri  
\q2 tepeimieni yakɨxeikɨa.   
\q1
\v 12 Tepeitakwani naime 'ayeniereme  
\q2 mɨki teukiyata teɨteri kemɨtiwakwa'a hepaɨ,  
\q1 yaxeikɨa meukatewatsie meukahɨiya naimitɨ hepaɨ.   
\q1
\v 13 Tetetinawame naime piinitɨarika tetehexeiyatɨ tepakɨne,  
\q2 'Ana 'inawari tinaime takiita tekatenitihɨniyakuni.   
\q1
\v 14 Teyunaitɨ teyutinɨme tepɨtekunawatɨweni,  
\q2 tita temɨtenawani teyunaitɨ tahetsiemieme pɨrayeikani».   
\q1
\v 15 Peru neuxei temaikɨ, pepɨkawareu'enieka mɨkɨ.  
\q2 'Axamemɨteyurie wahuye keneuku'eiri.   
\q1
\v 16 Mɨkɨ mepuyuwaɨriya 'axamemɨteyuriekakɨ,  
\q2 mekaniyumexɨitɨaka xuriya memɨtayeurienikɨ xeikɨa.   
\q1
\v 17 Xɨka winiyari 'anutawieni yakɨ xeikɨa pɨrayeika,  
\q2 wikixi yunaitɨ me'ixeiyakaku.   
\q1
\v 18 Peru mɨkɨ 'axamemɨte'u'iyari yɨkɨmana yutukari mepɨwiniyatɨwe,  
\q2 mɨpaɨ mekateniyuka'unakuni.   
\q1
\v 19 Mɨpaɨ mepɨtetakukuwe kemɨ'ane yuhetsiemieme xeikɨa memutekuwautɨwe,  
\q2 mɨpaɨ yutukari mepɨtetatɨmaiya.   
\s1 Mari'itɨarika mɨtimaiwenikɨ mɨkayuwaɨriya hepaɨtsita  
\q1
\v 20 Mɨtimaiwenikɨ mɨ'ayumieme 'uka hepaɨ kaye 'utɨa kanahiwani,  
\q2 yuwaɨkawatɨ teɨteri memaxuawetsie waɨkawa kanahiwani.   
\q1
\v 21 Kaye 'itsikinayaritsie waɨkawa mɨranuyekɨkatɨretsie kanahiwani,  
\q2 kiekari mɨranutahakitɨretsie yurikɨ katinikuxatani:   
\b  
\q1
\v 22 «Xeme temari 'atsixemɨkatehetimaiwawe 'akuxi,  
\q2 ¿kepaukake xepɨtehayewa mɨyaxeteyurietɨ?  
\q1 Xemeta xeteyukatawe'erietɨ xemutiwaweriyarie,  
\q2 ¿kepaukake xepɨtehayewa xeyutemawietɨ kexemɨte'u'iyarikɨ?  
\q1 Xemeta 'atsixemɨkatemate,  
\q2 ¿kepaukake xepɨtehayewa 'aixɨa mɨti'ane xete'uxiwe'erietɨ?   
\q1
\v 23 Xekeneneu'eni kenemɨxerahɨawe,  
\q2 ne nepɨnewaɨriya nemɨtixetaxatɨanikɨ 'iyaritsie miemekɨ kenemɨtiyumate netaɨta,  
\q2 yanekatinixepitɨamɨkɨ kenemɨtiku'eriwa yaxemɨtehetimanikɨ.   
\q1
\v 24 Kepauka nemɨxekɨhɨawekaitsie xeme xepɨkanetsi'u'eni,  
\q2 kepauka nemɨxe'u'iniwakaitsie nehetsɨa xepɨkahakɨ,   
\q1
\v 25 Matsi pɨta naime ne'ɨxatsitɨarika xeputixani'eri,  
\q2 meta kenemɨtixeha'imaiyakai xemɨkanetsi'anu'enikɨ,   
\q1
\v 26 'Ayumieme neta 'ana neputanaweni xehetsiemieme,  
\q2 kepauka xemɨ'uximatɨariekatsie.  
\q1 Ne nepɨhɨkɨtɨni nemutanaweni xehepaɨtsita,  
\q2 kepauka marika mɨxe'axenitsie,   
\q1
\v 27 kepauka marika xehetsie munuani 'eka mɨtɨrɨkaɨye hepaɨ  
\q2 meta kepauka 'uximatɨarika mɨxe'anuhapani haikɨri kwinimieme mɨtitɨrɨkaɨye hepaɨ.   
\b  
\q1
\v 28 »Hikɨ 'ana xekanenitahɨawikuni, peru ne nepɨkaxeta'eiya,  
\q2 'ana xepɨnetsitiwauni, peru xepɨkanetsitaxeiya.   
\q1
\v 29 Xemɨtemaiwawenikɨ xeputixani'eri  
\q2 meta Yawé xe'ayemakatɨ xemɨkahakɨkɨ,   
\q1
\v 30 Neniuki ne'ɨxatsi xemɨkahanu'enikɨ,  
\q2 kenemɨtixeku'imaiyakai xemɨka'anu'enikɨ,   
\q1
\v 31 Tita tewi mɨtiuka'e mɨkɨ katinika'itsanamɨkɨ,  
\q2 pɨtitimɨiriya tita yuhetsie mɨtiupitɨa pɨka'ikemakaxɨani,   
\q1
\v 32 Kememɨteheuyexɨri meta tita 'atsimemɨkatematekɨ mɨkɨ puwakwini,  
\q2 watemawierika tixaɨtɨ mɨkatiyunaki'erie puwareuyehɨani.   
\q1
\v 33 Matsi kemɨ'ane mɨnetsi'anu'enieni 'aixɨa 'iyari 'apuyeikani,  
\q2 meta tixaɨtɨ pɨkareumakaxeni».   
\c 2  
\s1 Mɨtimaiwenikɨ 'aixɨa pɨ'itɨarieka  
\q1
\v 1 Temaikɨ, xɨka neniuki pe'anu'enieni,  
\q2 meta ne'aitsika pe'uti'uta 'ahetsie.   
\q1
\v 2 Xɨka 'anaka mɨtimaiwenikɨ mɨ'ayumieme 'u'enieni.  
\q2 Meta 'a'iyarikɨ pe'ayetuani pemɨrakumaikakɨ.   
\q1
\v 3 Xɨka mɨrakumaikakɨ pe'utahɨawe,  
\q2 meta pemeitimaitɨyeikanikɨ pe'uta'iwauni.   
\q1
\v 4 Xɨka pɨrata hepaɨ petikuwauneni,  
\q2 tumini mɨ'awietɨ hepaɨ,   
\q1
\v 5 hikɨ yapepɨretimani Yawé kemɨrayemakaxenikɨ  
\q2 meta pepikaxeiya Kakaɨyari kemɨtiuyemate.   
\q1
\v 6 Yawé xeikɨa katiniyupitɨwani mɨtimaiwenikɨ mɨ'ayumieme,  
\q2 mɨrakumaikakɨ tatsiere pɨtiyupitɨwa tetana kanayeneikani.   
\q1
\v 7 Mɨkɨ kaniwaparewieka 'aixɨa memɨte'u'iyari.  
\q2 Meta kaniwa'ɨwiyani kemɨ'ane heitserie memu'uwa.   
\q1
\v 8 Mɨkɨ heitserie yamemɨtekahu wahuye kani'ɨwiyani  
\q2 meta 'aixɨa memɨteyurie wahuye.   
\q1
\v 9 Hikɨ 'ana pekaneitimaimɨkɨ heitseriemekɨ 'apemuyeikanikɨ,  
\q2 meta hipame 'aixɨa pemɨtiwaxeiyanikɨ yunaime.   
\q1
\v 10 Mɨtimaiwenikɨ mɨ'ayumieme 'a'iyaritsie kaninuamɨkɨ,  
\q2 meta pemɨtimaikakɨ 'ana 'aixɨa 'iyari 'apepuyeikani pe'atemawietɨ.   
\q1
\v 11 'Aixɨa pemɨreitimamatekɨ pɨmatsi'ɨwiyani,  
\q2 'ahetsie kepemɨtiuyemate pumatsi'awietani.   
\b  
\q1
\v 12 Mɨtimaiwenikɨ mɨ'ayumiememe 'axamɨti'anetsie pɨmatsixɨna,  
\q2 meta teɨteri 'axamemutiyuane wahetsɨa,   
\q1
\v 13 huye mɨheitserie me'uku'eirieka,  
\q2 huye mumariwetsie pɨta memuhunikɨ.   
\q1
\v 14 Mepuyutemawie 'axameteyurietɨ,  
\q2 pɨwanake kepauka teɨteri 'axamemɨteyurietsie.   
\q1
\v 15 Huye mututuni memuweiya  
\q2 meta huye xaɨtsie meukuyuyune.   
\q1
\v 16 Xɨka petimaiweni 'uka mɨwikie hepaɨtsita pepɨ'a'ɨwiyani,  
\q2 meta 'uka pemɨka'imate niukieya witsimutaine hepaɨtsita.   
\q1
\v 17 Mɨkɨ 'uka Kakaɨyari hamatɨa tɨratu kemɨtiuwewi hatɨmaiyaka,  
\q2 yɨkɨna kemɨtiuku'eiri 'ɨimariyari mitiwitɨ,   
\q1
\v 18 kemɨ'ane menuweiya mɨkɨ mɨkitewatsata kaniyɨaneni,  
\q2 huyeteya yɨwipa xeikɨa kanimiemetetɨni.   
\q1
\v 19 Kemɨ'ane mɨkɨ 'uka winiyarieyatsie mɨyɨhɨani hatsuakuri pɨkahakunuani,  
\q2 tukari huyeyari pɨkakaxeiya.   
\b  
\q1
\v 20 'Ayumieme mɨpaɨ pepɨtiuyeikani huye 'aixɨa mɨ'ane 'utuma,  
\q2 meta huye heitserie memu'uwa memiweiya pepuweiyani.   
\q1
\v 21 Heitseriemekɨ yamemɨtekahu wahetsie mɨkarahɨiwa,  
\q2 kwie wahetsiemieme kanayeimɨkɨ meta yuheyemekɨ mana mekaniu'uwakuni.   
\q1
\v 22 Kemɨ'ane 'axamemɨteyurie mepakumaweriyarieni,  
\q2 yukwie memɨtsewiximakɨ yuheyemekɨ mekanikwi'iwakuni.   
\c 3  
\s1 Kehepaɨ mɨ'aneni mɨtimaiwenikɨ mɨ'ayumieme  
\q1
\v 1 Temaikɨ, pepɨkaratɨtɨmaiyani kenemɨmati'ɨxatsitɨa,  
\q2 matsi pɨta, yuheyemekɨ kena'eriwani ne'aitsika.   
\q1
\v 2 Karikɨ xɨka mɨpaɨ pe'aneni mɨixa wiyari pekanitihuimɨkɨ  
\q2 meta 'aixɨa 'iyari pepuyeikani.   
\q1
\v 3 Hatsuaku pepɨkaratɨtɨmaiyani peti'akanaki'erietɨ meta yuri petikuxatatɨ:  
\q2 'Aheyemekɨ mɨpaɨ ketinekamieni  
\q2 meta 'a'iyaritsie paitɨ kena'utɨaka.   
\q1
\v 4 Mɨpaɨ xɨka petikamieni Kakaɨyari 'aixɨa pɨmatixeiyani,  
\q2 meta teɨteri 'aixɨa meputiyuaneni 'ahepaɨtsita.   
\q1
\v 5 Yawé hetsie ketinewiyani naime 'a'iyarikɨ,  
\q2 hawaikɨ kepemɨtimaiwe 'ahetsie pepɨkatiwiyani.   
\q1
\v 6 Kakaɨyari kena'eriwani naimekɨ kepemɨtiyurienekɨ,  
\q2 'ana mɨkɨ 'ahuye pɨheitseritɨaka.   
\q1
\v 7 Kwinimieme perakumaikame pepɨkayuxatani:  
\q2 matsi pɨta Yawé kenayemakaxeni meta 'axamɨti'ane hepaɨtsita kene'apatani.   
\q1
\v 8 Mɨpaɨ xɨka petikamieni 'aixɨa pepɨreu'erieka 'awaiyaritsie,  
\q2 meta pepɨtɨrɨkaɨyeni.   
\q1
\v 9 Yawé kenayexeiyani tita pemɨrexeiyakɨ,  
\q2 meta matɨarimieme 'ikwaxi keneyetuirieka tita pemɨtiukaxexeiya.   
\q1
\v 10 Mɨpaɨ xɨka petiyurieneni 'akaretatsie tɨriku takariyari panakaxɨrɨweni,  
\q2 meta 'akiita kaxie winuyari mɨhekwa pɨxuaweni.   
\q1
\v 11 Temaikɨ, xɨka Yawé matsi'anayewayani meti'ɨkitɨatɨ pepɨka'i'uxiwe'erieka,  
\q2 meta kepauka mɨmatsi'utate'ani pepɨka'uyeha'arɨweni.   
\q1
\v 12 Yawé matsi pɨwaranayewaya tiwa'ɨkitɨatɨ kemɨ'ane mɨwanaki'erie,  
\q2 tewi yuniwe 'inaki'erietɨ kemɨti'ɨxatsitɨa hepaɨ.   
\b  
\q1
\v 13 'Aixɨa kani'itɨarieka kemɨ'ane mɨtimaiwenikɨ mɨ'ayumieme mukaxei,  
\q2 meta kemɨ'ane waɨka mɨtiuyemaikakɨ mutaxei.   
\q1
\v 14 Kepauka pemɨtimaiwe, matsi waɨkawa pekanipitɨarieka  
\q2 keyuri pɨrata meta huru.   
\q1
\v 15 Kepauka pemɨtimaiwe, matsi waɨkawa pekanipitɨarieka  
\q2 keyuri tetexi witsimɨ'anene, pɨtiumawe hepaɨna witsiti'anetɨ.   
\q1
\v 16 Kepauka pemɨtimaiwe, pepɨxatɨarieni mɨixa wiyari pemexeiyanikɨ,  
\q2 meta 'aixɨa pepɨtixeiyarieka meta waɨkawa pepɨrexeiyani.   
\q1
\v 17 Kepauka pemɨtimaiwe witsi'anemetsie pepumieni,  
\q2 naitɨ 'aixɨa katini'anemɨkɨ 'ahetsiemieme.   
\q1
\v 18 Mɨkɨ kɨye tukari tiyupitɨwame kanihɨkɨtɨni kemɨ'ane memitapa wahetsie,  
\q2 'Aixɨa mekani'itɨarieka kemɨ'ane memeixeiya.   
\q1
\v 19 Yawé kwie kaniutawewieni kemɨtiuyematekɨ,  
\q2 muyuawi tatsiere 'akaniuyemani taheima kemɨrakumatekɨ.   
\q1
\v 20 Mɨkɨ yareitimaixɨaku haramara kaniupatsirixɨani meta haa kanetinetɨaxɨani,  
\q2 meta haiwitɨritsie wiyeri 'akaneikatɨ kanayani.   
\b  
\q1
\v 21 Temaikɨ, kene'a'ɨwiyani 'aixɨa ti'aneme pemɨranayexeikɨ,  
\q2 pepɨkahetɨtɨmaiyani 'ɨxatsi 'aixɨa pemɨtiu'eni.   
\q1
\v 22 Xɨka mɨpaɨ petikamieni mɨixa wiyari 'apepuyeikani,  
\q2 meta kuka pematitɨkɨni hepaɨ pepɨ'aneni.   
\q1
\v 23 Hikɨ 'aixɨa 'iyari pepumieni,  
\q2 meta hatsuaku pepɨkahekaweni.   
\q1
\v 24 Kepauka pemɨkahunitsie, tixaɨtɨkɨ pepɨkareumaka,  
\q2 hikɨ pekahume 'aixɨa 'iyari pekaneukumɨkɨ.   
\q1
\v 25 Pepɨkaheumaka xɨka yapauka 'axamɨti'ane tiukuyani,  
\q2 meta kepauka 'uximatɨarika 'axateyuruwamete wahetsiemieme munuani pepɨkaheumaka.   
\q1
\v 26 Yawé yuheyemekɨ 'ahamatɨa kaniuyeikamɨkɨ,  
\q2 meta kameni'ɨwiyakamɨkɨ winiyaritsie kapa pe'uwierekɨ.   
\b  
\q1
\v 27 Pepɨkahe'imaiyani kemɨ'ane parewiya mɨmatsitawawirieni,  
\q2 xɨka perexeiyani tita mɨreuyehɨwa.   
\q1
\v 28 'Ahepaɨ tewi hatsuaku 'ipaɨ pepɨkarahɨaweni:  
\q2 «Nepɨkayɨwe 'arike pepayeneni, 'uxa'ake nepɨmatsiparewieni»,  
\q2 xɨka perexeiyanitɨtɨ hikɨ titakɨ pemɨtiparewieni.   
\q1
\v 29 Tita 'axamɨti'ane 'ahepaɨ tewi pepɨkawiwirieka,  
\q2 'iya 'aixɨa mɨmatiku'eriya.   
\q1
\v 30 'Imieri pepɨkakuwauneni xeime hetsie,  
\q2 xɨka mɨkɨ 'atsikametsi'uyurieni.   
\q1
\v 31 Memayu'eririya ketita memɨtehexeiya pepɨkatihiwe'erieka,  
\q2 'ekɨ meta memayu'eririya pepɨkawa'ɨkeni.   
\q1
\v 32 Yawé kaniwaxani'erieka 'axamemɨte'u'iyari,  
\q2 peru kemɨ'ane 'aixɨa memɨte'u'iyari kaniwanaki'erieka.   
\q1
\v 33 Yawé 'uximatɨarika kanipitɨaka, kemɨ'ane 'axamɨtiyuriene kie,  
\q2 matsi 'aixɨa katiniyurieka kemɨ'ane yamemɨtekahu wakie.   
\q1
\v 34 Yawé kaniwananaimaka kemɨ'ane memɨte'uyukatawe'erie,  
\q2 peru kemɨ'ane tixaɨtɨ memɨkate'ayuyeitɨa mɨkɨ puwaparewie.   
\q1
\v 35 Kemɨ'ane memɨtemaiwawe 'aixɨa mepɨtehamamatiwani,  
\q2 matsi kemɨ'ane memɨkayuwaɨriya memɨwaparewienikɨ teɨteri hipame 'aixɨa pɨ'ane 'axamemɨtehamamatiwanikɨ.   
\c 4  
\s1 Mɨtimaiwenikɨ mɨ'ayumieme matsi 'aixɨa kani'aneni  
\q1
\v 1 Temari nemɨxenaki'erie, xekeneneu'eni rapaapa kemɨtiyu'ɨxatsitɨwa hepaɨ,  
\q2 xekeneyuwaɨriyani waɨkawa xemɨtemaikakɨ.   
\q1
\v 2 Ne nepɨxeyetuirieni 'ɨxatsi 'aixɨa manɨyɨtɨka,  
\q2 'ayumieme ne'ɨkitɨarika xepɨkahatɨtɨmaiyani.   
\q1
\v 3 Kepauka ne nemununutsitɨkaitsie nepaapa hetsɨa nepukatei,  
\q2 meta nemaama nemuyuxewini hepaɨ pɨnetinaki'eriekai,   
\q1
\v 4 nepaapa 'ipaɨ pɨnetiu'ɨxatsitɨa:  
\q2 «'A'iyarikɨ keneu'eni 'ikɨ 'ɨxatsitɨarika,  
\q2 yaketinekamieni ne'aitsikatsie, 'ana mɨixa wiyari pepuyeikani.   
\q1
\v 5 Mɨtimaiwenikɨ mɨ'ayumieme kenekuwawa meta waɨkawa perakumaitɨ pemayanikɨ,  
\q2 neniuki pepɨkahatɨtɨmaiyani, meta 'aheyemekɨ kena'eriwani.   
\q1
\v 6 Mɨtimaiwenikɨ mɨ'ayumieme hatsuaku pepɨka'uku'e'eiriwani.  
\q2 Mɨkɨ pɨmatsi 'awietani,  
\q2 kenenaki'erieka mɨkɨta pɨmatsi'ɨwiyani.   
\q1
\v 7 Mɨtimaiwenikɨ mɨ'ayumieme yemekɨ peuyewetse pemɨtimaiwenikɨ 'ahetsie kenexeiyani.  
\q2 'Ekɨ pemeitimaitɨyeikanikɨ kenekuwaɨneni keyuri piinitɨarika.   
\q1
\v 8 Mɨtimaiwenikɨ mɨ'ayumieme waɨkawa keneku'eriwani, mɨkɨ matsi 'aixɨa perahɨawarɨwame kamenayeitɨamɨkɨ,  
\q2 kene'awaɨriyani pemɨtimaiwenikɨ 'aixɨa pekatinitamatiwamɨkɨ,   
\q1
\v 9 'amu'utsie witsimɨ'ane pehanakekame pumatsi'ayeitɨani,  
\q2 kuruna witsi'aneme kameniyetuiriemɨkɨ».   
\b  
\q1
\v 10 Temaikɨ 'aku, keneu'eni neniuki,  
\q2 hikɨ 'ana mɨixa wiyari 'apepuyeikani.   
\q1
\v 11 Ne nepɨmati'ɨkitɨa petimaiwetɨ 'apemuyeikanikɨ,  
\q2 nepɨmetsi'uwitɨxime huye mɨheitserie pemuweiyanikɨ.   
\q1
\v 12 Kepauka mɨkɨ 'utɨa pemumienitsie, hawaikɨ pepɨkahekaweni,  
\q2 tsepa pemunautsarɨme, pepɨkahetiketamɨre.   
\q1
\v 13 Kenemɨmati'ɨkitɨa yuheyemekɨ kena'eriwani,  
\q2 'aixɨa ketine'ɨwiyani ne'ɨkitsika mɨkɨ pɨ'atukari.   
\q1
\v 14 'Axamemɨteyurie wahuye pepɨka'anukuweweiyani,  
\q2 'axamemɨteyurie wahuyeta pepɨka'umieni.   
\q1
\v 15 Mɨkɨ wahuye hepaɨtsita kene'a'ɨwiyani. Mɨkɨ 'utɨa pepɨka'umieni.  
\q2 Mana pepɨka'uyeikani, keneuku'eiri.   
\q1
\v 16 'Axateyuruwamete mepɨka'ukakukutsu xɨka 'akuxi 'axakatiyuriweni,  
\q2 mepukakukutsu kepaukake xeime memɨka'una.   
\q1
\v 17 'Axamɨti'ane kaniwa'ikwaitɨni,  
\q2 meta nanaimarika kaniwawinutɨni.   
\b  
\q1
\v 18 Heitseriemekɨ yamemɨtekahu wahuye witsipɨ'ane,  
\q2 kepauka tau 'ɨrɨya ximeri manatinexɨaxime hepaɨ:  
\q1 hekɨariya waɨkawa mɨhekɨariwiexime hepaɨ  
\q2 kepaukake hekɨariya 'aixɨa tixawatɨtɨ mayani.   
\q1
\v 19 Peru 'axateyuruwamete wahuye mɨpaɨ pɨka'ane,  
\q2 yɨriya kwinimieme mɨtiyɨwi hepaɨ pɨ'ane,  
\q2 'atsimepɨkatemate ketitatsie memɨtehekaxɨrɨwe.   
\b  
\q1
\v 20 Temaikɨ 'aku, neniuki keneu'eni,  
\q2 'a'iyarikɨ keneu'ena.   
\q1
\v 21 Hawaikɨ neniuki pepɨkaheuyehɨpani,  
\q2 'a'iyaritsie yemekɨ keneye'ɨnani.   
\q1
\v 22 Mɨkɨ kemɨ'ane memikaxexeiya tukari kaniwapitɨaka,  
\q2 'Aixɨa pemɨreu'eriekakɨ 'awaiyaritsie meta 'a'iyaritsie kani'ayumiemetɨni.   
\q1
\v 23 Matsi 'a'iyari kene'ɨwiyani tinaime piinitɨarika hepaɨtsita,  
\q2 mɨkɨ hetsie tukari mayeneikakɨ.   
\q1
\v 24 'Atetakɨ keneyu'ɨwiyani 'axapemɨkatikuxatanikɨ,  
\q2 kemɨkatiheitserie petikuxatatɨ ketineuhayewa.   
\q1
\v 25 Heitseriemekɨ pɨta keneutaniereni,  
\q2 tita pemɨtixeiya mɨkɨkɨ kene'a'ɨwiyani.   
\q1
\v 26 'Ahuye kene'ɨwiyani kepemɨtimie,  
\q2 keneheitseritɨaka naime 'ahuye.   
\q1
\v 27 Heitserie keneumieni 'a'utata pepɨkaheukuyuyuipikeni meta 'atserieta.  
\q2 'Axamɨti'ane ketineuku'eiri.   
\c 5  
\s1 Mari'itɨarika kayɨ'ɨya kayɨkɨna hepaɨtsita  
\q1
\v 1 Temaikɨ, keneneu'eni kenemɨtimaiwe,  
\q2 Yemekɨ keneu'ena heitserie kemɨtikamieni,   
\q1
\v 2 merikɨte kepauka pemɨtikuxatanitsie  
\q2 petimaiwetɨ ketinekuxatani.   
\q1
\v 3 'Uka mɨka'a'ɨya tenieyatsie xiete kaniuhaneni,  
\q2 nenieya matsi witsiputaine, keyuri huriwa hatseitiyari.   
\q1
\v 4 Peru 'imatɨriekake matsi waɨkawa hatsiwitɨ payeika keyuri tsiɨrika,  
\q2 meta kwinimieme pɨrataxikaunare keyuri 'ixipara naitsata meutixikakauni.   
\q1
\v 5 Mɨkɨ mɨkite watsata kaniumieni,  
\q2 mɨkɨ mɨki teukiyapa kaneyani.   
\q1
\v 6 'Etsiwa tɨma tukari huyeyari pɨkamate,  
\q2 yakɨxeikɨa puyeika 'atsikatimaitɨ.   
\b  
\q1
\v 7 Neuxei, temaikɨ 'aku, keneneu'eni,  
\q2 neniuki pepɨkahatɨtɨmaiyani.   
\q1
\v 8 Mɨkɨ 'uka mɨka'a'ɨya pepɨka'enieka,  
\q2 'ahurawa kiteniena tɨma pepɨkaye'axeni,   
\q1
\v 9 'Atɨrɨkariya peyetuayu kapa petiutakwine,  
\q2 kapa 'atukari memayu'eririya wahetsɨa peyetuani,   
\q1
\v 10 'atumini waɨriyarika peme'iwaxɨ kapa hipame wahetsiemieme rayanikɨ,  
\q2 kapa hipame wakiita tiyuhayewanikɨ titapemɨra'iwaxɨ.   
\q1
\v 11 'Imatɨarieka tixaɨtɨ pekarexeiyatɨ pepɨtatsuani,  
\q2 kepauka haweri pe'anetɨ pemayani tixaɨtɨ pekarexeiyatɨ.   
\q1
\v 12 'Anake mɨpaɨ pekanitayɨmɨkɨ: «Titayari 'ɨxatsi nekatiu'eni kemɨtikuxaxatsiwakai.  
\q2 Titayari ne'iyaritsie netitatawe'eri mɨkɨ 'ɨkitɨarika.   
\q1
\v 13 Nepɨka'i'eni nete'ɨkitɨwamete waniuki,  
\q2 hatsuaku nepɨkawaru'eni nete'ɨkitɨwamete.   
\q1
\v 14 Hikɨri yemekɨ kwinimieme haweri 'anekɨa nekaniyuhayewa,  
\q2 yunaime teɨteri wahɨxie».   
\b  
\q1
\v 15 Haa 'ahaputsuta mieme xeikɨa kenehareka,  
\q2 haa 'ahaixata maneika xeikɨa.   
\q1
\v 16 ¿'Ahaa kaye'utɨma mɨtayeuriweni metinake  
\q2 metatsiere 'ahaa 'ahaixata mieme teɨteri memayukuxexeɨriwatsie mɨtayeuriweni metinake?   
\q1
\v 17 Mɨkɨ haixa katini'apiinitɨni, 'ekɨ xeikɨa,  
\q2 hawaikɨ pɨkayɨwe hipame pemɨwaharitɨaka.   
\q1
\v 18 'Aixɨa ke'itɨarieka 'a'ɨya.  
\q2 Kene'atemawieka temaikɨyari pemitiwitɨ hamatɨa.   
\q1
\v 19 Maxa witsimɨti'ɨimari hepaɨ kani'aneni,  
\q2 kapura yeutanaka 'ɨimari hepaɨ kani'aneni mɨtiyukanaki'erie.  
\q1 Naki'eriyaya kematsitemawieritɨaka.  
\q2 Naki'eriyaya yuheyemekɨ 'ahetsie ketiwiyani.   
\q1
\v 20 ¿Temaikɨ 'aku, titayari peti'awaɨriyani 'uka mɨka'a'ɨya hamatɨa?  
\q2 ¿Titayari xeime 'ɨyaya naki'eriyaya petikuwauneni?   
\b  
\q1
\v 21 Tahuyeta ketemɨteyurie Yawé naime kanixeiyani,  
\q2 tahuye naime kanimaika.   
\q1
\v 22 'Axatiyuruwame yɨkɨmana puyuwiniya 'axatiyurienetɨ,  
\q2 'axamɨti'ane mɨrexeiya kaunariyari mɨkɨ kanenutahɨaximeni.   
\q1
\v 23 Mɨpaɨ mekatenitakukuweni memɨkayɨ'ɨxatsitɨarinɨa,  
\q2 kanimɨmɨkɨ mɨkaheu'enakɨ.   
\c 6  
\s1 Mari'itɨarika mɨkaheu'ena hepaɨtsita  
\q1
\v 1 Temaikɨ 'aku, xɨka xewitɨ pemimate matsi'inieka hetsiena mieme pemɨrayukatuanikɨ,  
\q2 xɨka pemɨka'imate kename pera'akatuani petitahɨawe,   
\q1
\v 2 xɨka 'aniuki 'anatiyani kename yapetikayani,  
\q2 pekaniyutahɨamɨkɨ 'aniukikɨ,   
\q2
\v 3 merikɨte 'ahepaɨ tewi kameniuwiniya.  
\q1 Temaikɨ 'aku, xɨka peyuxɨnamɨkɨni, 'ikɨ huye kanihɨkɨtɨni:  
\q2 Xeiya kenemie hetsɨana tixaɨtɨ pekarayuyeitɨatɨ,  
\q2 tɨratu kepemɨtiuwewi keneutawawiri pemɨtihayewanikɨ.   
\q1
\v 4 Pepɨkakutsuni,  
\q2 kenayeniereni.   
\q1
\v 5 Keneu'ata'una maxa mɨtiutananautsa hepaɨ hupierienetɨ,  
\q2 meta wiki winiyari mɨtiutawikweiya hepaɨ.   
\b  
\q1
\v 6 'Ekɨ pemɨ'a'ɨraxie, paratsɨ tsarɨ keneuxeiya.  
\q2 Mana keneye'ɨki kemɨtiyuriene petimaiwetɨ pekanayeimɨkɨ.   
\q1
\v 7 Mɨkɨ mepɨkaheixeiya kemɨ'ane mɨwanɨ'a,  
\q2 meta kemɨ'ane mɨtiwa'aitɨa.   
\q1
\v 8 Mɨkɨ yunaitɨ, witarita mekateniuka'utani,  
\q2 'itsanaxa yu'ikwaite mekateniuka'utani.   
\b  
\q1
\v 9 'Ekɨ pemɨ'a'ɨraxie, ¿kepaɨmexɨa 'akuxi mɨpaɨ pepɨtiuhupuni?  
\q2 ¿Kepaukake tamɨ pepanutaniere?   
\q1
\v 10 'Etsiwa peheukukutsutɨ,  
\q2 'etsiwa pe'uka'uxipiwetɨ, meta 'atapa pe'awietɨ,   
\q1
\v 11 tinawayame hepaɨ katininuamɨkɨ tixaɨtɨ pekarexeiyatɨ pemayani,  
\q2 tewi titakɨ mɨramieni 'akwetɨ 'ahetsɨa munuani hepaɨ katininuamɨkɨ haakaxa.   
\b  
\q1
\v 12 'Axamɨtiuka'iyari tewi mɨka'uyukatewiya,  
\q2 ti'itawatɨ xeikɨa kanikuyeikani tsepa hakewa,   
\q1
\v 13 mɨpaɨ mepɨtekuxata yu'iwama wahamatɨa 'iyari mewewietɨ,  
\q2 yu'ɨkatekɨ meta yu'itɨwamekɨ mekaniku'inɨaritani xeikɨa.   
\q1
\v 14 'Axamɨtiyuriene kaniyu'iyaritɨaka 'axamɨti'anekɨ xeikɨa,  
\q2 meta kanikuwauneni mɨpaɨ tiyuhaxɨatɨamɨtɨ.   
\q1
\v 15 'Ayumieme yapauka haweri katiniwakuyuruwani,  
\q2 yapauka 'ana kanika'unariemɨkɨ pɨkayɨwekaxɨani yuheima mɨtanuanikɨ.   
\b  
\q1
\v 16 'Ataxewitɨ kanixuaweni teɨteri kememɨteyurie Yawé mi'uxiwe'erie,  
\q2 meta xeime matsi mixani'erie:   
\q2
\v 17 yuhɨxitekɨ kwinie memɨte'uneniere,  
\q2 yunenikɨ memɨte'itawa,  
\q2 yumamatekɨ 'axamɨkatiuka'iyari xuriyaya mɨtayeuriwa,   
\q2
\v 18 yu'iyaritsie mɨtiha'aritɨa 'axatiyurimɨtɨ,  
\q2 yu'ɨkatekɨ xeikɨa mɨyumexɨitɨa 'axamɨtiyurienenikɨ,   
\q2
\v 19 kemɨtiunierixɨ ti'itawatɨ mɨtikuxata,  
\q2 meta kemɨ'ane yu'iwama mɨwakwamana memuyukwitɨwenikɨ.   
\s1 Mari'itɨarika xeime kɨnaya 'ɨyaya hepaɨtsita  
\q1
\v 20 Neuxei temaikɨ, 'apaapa 'aitsikaya naime kenaye'atɨwani  
\q2 meta 'amaama 'ɨkɨtɨarikaya pepɨkahehɨpani.   
\q1
\v 21 'A'iyaritsie kenaka'utɨa,  
\q2 kenakatɨkɨni kuka hepaɨ.   
\q1
\v 22 Kepauka pemukuyeika 'apaapa meta 'amaama wa'aitsika pɨmatsi'uwitɨximeni,  
\q2 kepauka pemukutsu wahɨritɨarika pɨmatsi'ɨwiyani,  
\q2 meta kepauka pemanutanieretsie, 'ahamatɨa memɨtekuxatani hepaɨ kani'aneni yu'aitsikakɨ.   
\q1
\v 23 Kɨxeme kanihɨkɨtɨni 'aitsika,  
\q2 meta 'ɨkitɨarika hekɨariwiwame kanihɨkɨtɨni,  
\q2 'ɨxatsitɨarika tukari huyeyari kanihɨkɨtɨni pemɨkaheuyewenikɨ.   
\q1
\v 24 Mɨkɨ 'ɨxatsi pɨmatsi'ɨwiyani 'iya 'uka hepaɨtsita 'axamɨtiuka'iyari,  
\q2 xewitɨ mɨka'a'ɨya, yuniukikɨ mɨtiyuwiniya hepaɨtsita.   
\q1
\v 25 'A'iyaritsie pepɨka'ihiwe'erieka witsimɨti'ɨimarikɨ,  
\q2 kene'akweriwayurieka yuhɨxitekɨ metsi'uwiniyakɨ,   
\q1
\v 26 karikɨ 'uka tuminikɨ muyuwitɨnɨa 'atumini xeikɨa kanitixɨtɨamɨkɨ,  
\q2 meta xɨka xeime 'ɨyaya peyurieneni kɨnaya 'atukari pumatsinawairieni.   
\q1
\v 27 ¿Kepaikɨ pɨyɨwe tɨɨ yutawitsie mayatsa,  
\q2 kamixaya kahataiyatɨ?   
\q1
\v 28 ¿Kepaikɨ pɨyɨwe matitɨɨyatsie muyeyani,  
\q2 kakukwaxiketɨ?   
\q1
\v 29 Kamɨtsɨta kemɨ'ane xeime 'ɨyaya mukumayɨani,  
\q2 hamatɨana mɨkahuni hetsienatsɨ pɨrahɨiyani.   
\b  
\q1
\v 30 'Axapɨkatiyuxexeiya xewitɨ tinawanetɨ,  
\q2 mɨyehaakamɨnekɨ xeikɨa,   
\q1
\v 31 xɨka 'uwiyarieni, matsi katiniyetuamɨkɨ,  
\q2 'atahutamexɨatsie timieme mɨtiunawakɨ,  
\q2 matsi yupiinite naime katininawaiyariemɨkɨ.   
\q1
\v 32 Peru matsi kemɨ'ane xeime 'ɨyaya meta kɨnaya mukumaɨwa, pɨkaheitimaitɨyeika,  
\q2 kemɨ'ane mɨpaɨ mɨtiuka'iyari yɨkɨmana kaniyukamiemɨkɨ.   
\q1
\v 33 Katinikwinitɨariemɨkɨ kanitewiyatsitɨariemɨkɨ,  
\q2 meta hatsuaku pɨkaratɨmaiya kemɨtiuyuri.   
\q1
\v 34 Meta 'uki kaniha'akamɨkɨ 'ɨyaya munanaimakɨ,  
\q2 kepauka 'uki mɨyɨkɨhɨani 'anatukaritsie pɨkareiyehɨwirieni.   
\q1
\v 35 'Uki mɨnanaimarie tixaɨtɨ pɨkatitanaki'erieni,  
\q2 tsepa witsiti'aneneme mɨtiyexatɨarie, mɨkɨkɨ pɨkayukatemawieni.   
\c 7  
\s1 Mari'itɨarika xeime 'ɨyaya hepaɨtsita  
\q1
\v 1 Temaikɨ, ne'ɨkitsikatsie yaketinekamieni,  
\q2 meta ne'aitsika keneuti'uta 'a'iyaritsie.   
\q1
\v 2 Yaketinekamieni kenemɨti'aita pe'ayenieretɨ 'apekaniuyeikamɨkɨ,  
\q2 ne'ɨkitsika kene'ɨwiyani 'ahɨxi mɨyɨwi kepemɨtikweriwayurie hepaɨ.   
\q1
\v 3 'A'itɨwametetsie keneutapietɨkani,  
\q2 kenaka'utɨa 'a'iyaritsie paitɨ.   
\q1
\v 4 Titakɨ yapemɨtimaiwe mɨkɨ pumatsiparewieni yaxeikɨa 'akuri hepaɨ,  
\q2 titakɨ kepemɨtimate mɨkɨ pumatsiparewieni kemɨ'ane pemumate hepaɨ.   
\q1
\v 5 Mɨkɨ mepɨmatsixɨna 'ukaratsi mɨka'a'ɨya hepaɨtsita,  
\q2 meta 'uka mɨwikie hepaɨtsita pepɨ'a'ɨwiyani witsitikuxatakaku.   
\b  
\q1
\v 6 Heiwa nekiita ne'ayekaitɨ  
\q2 'itupari 'etsimayewatsie neheunieretɨ,   
\q1
\v 7 Nepɨne'ɨwiyaxɨ temari memɨka'u'iyari wahetsie,  
\q2 mɨkɨ temari watsata xeime kwi nepuxei  
\q2 xeime yemekɨ 'atsimɨkatimate.   
\q1
\v 8 Kayetsie kananuyani, 'etsikina kaniye'ani,  
\q2 hikɨ 'anɨari 'umietɨ 'ukaratsi kiiya hepa kaneyani.   
\q1
\v 9 Hikɨ kanikɨyɨrirɨmekaitɨni.  
\q2 'Ari waɨkawa 'ukuyɨrekuri.   
\b  
\q1
\v 10 Yapauka 'ukaratsi kanewayeyani 'enukunakeke,  
\q2 'uka tuminikɨ muyuwitɨnɨa hepaɨ reyukukemaritɨatɨ,  
\q2 yuhetsie pɨkamatsiɨkɨkai kemɨtiyurienikekai.   
\q1
\v 11 (Mɨkɨ 'uka waɨkawa pɨtikuxata 'utahiwatɨ hipame kawa'enietɨ,  
\q2 mɨpaɨ memɨ'anene 'ukarawetsixi yukiita yemekɨ mepɨkahayetei.   
\q1
\v 12 Kaye'utɨma mepu'uwa meta teɨteri memayuxeɨrietsie,  
\q2 meta yamepɨtehupa 'itsikinatsie).   
\q1
\v 13 Hikɨ yapauka temaikɨ kananakawiyatɨyani meta kani'itseni,  
\q2 metatsiere kayukatewiyakamekɨ mɨpaɨ katinitahɨawe:   
\b  
\q1
\v 14 «Nekiita 'aixɨa memɨteyuxeiyanikɨ mawariyari nekanexeiyani,  
\q2 tɨratu nemuwewiekai nekakaɨyari hamatɨa hikɨri nekatinaye'atɨani.   
\q1
\v 15 'Ayumieme nepeyetɨa nepɨmatsihekunakixɨ,  
\q2 nepɨmatsikuwaunekai, 'ari nepɨmatsi'ukaxei.   
\q1
\v 16 Ne'utatsie nekaneika'ita  
\q2 rinu 'ixurikiyari waɨkawa mɨti'utɨka 'Ekipitu miemekɨ.   
\q1
\v 17 Nemukahuputsie witsimu'ɨa nekaneukawirieni,  
\q2 mixaxi witsimu'ɨa, 'aruhe meta kanera.   
\q1
\v 18 Hikɨmɨ, naki'eriya tekɨxi winuyari naime tepanu'ieni,  
\q2 naki'eriyakɨ tepuyutitemamawieni tsepa temukatariyarie.   
\q1
\v 19 Nekɨna yukie pɨka'uka,  
\q2 kanayeyani hikɨ 'ateewa paitɨ.   
\q1
\v 20 Yutumini waɨkawa kane'ɨni,  
\q2 kwitɨwa pɨkanuani xeimetseri kaneyurimɨkɨ».   
\b  
\q1
\v 21 Mɨpaɨ witsitikuxaxatɨwatɨ,  
\q2 kanikemakaxɨani.   
\q1
\v 22 Hikɨ 'ana 'utɨmana kaneyani,  
\q2 tuuru huyeta metɨa hemierienike hepaɨ,  
\q1 maxa winiyaritsie muyewierixɨ hepaɨ,   
\q2
\v 23 'ɨrɨkɨ mumɨiya yutawitsie,  
\q1 wiki winiyaritsie muyewierixɨ hepaɨ,  
\q2 'atsikatimaitɨ mana yutukari kanitatɨmaiyamɨkɨ.   
\b  
\q1
\v 24 'Ayumieme hikɨ temaikɨ, keneneu'eni,  
\q2 neniuki yemekɨ keneu'eni.   
\q1
\v 25 'A'iyari xaɨtsie pɨka'uyuyuipikeni 'uka kemɨmetikɨhɨawekɨ,  
\q2 mɨkɨ 'ɨxatsieya huyeyari 'utɨa pepɨkaheuyewautseni,   
\q1
\v 26 karikɨ yumɨiretɨ mɨpaɨ mekateniukwini,  
\q2 mepuyumɨire kɨmana memukwi.   
\q1
\v 27 Kiitana mɨki teukiyapa kanihɨkɨtɨni,  
\q2 yunaitɨ muwa memɨtahake mepɨtakukuwe.   
\c 8  
\s1 Kemɨti'inie mɨtimaiwenikɨ mɨ'ayumieme  
\q1
\v 1 Mɨtimaiwenikɨ mɨ'ayumieme 'uka hepaɨ kani'inieka.  
\q2 Mɨtiuyemaikakɨ mɨ'ayumieme waɨkawa kanahiwani.   
\q1
\v 2 Mɨtimaiwenikɨ mɨ'ayumieme wapaitɨ kanakekani,  
\q2 meta huye 'utɨa kaniutakekani teɨteri wahamatɨa tikuxatatɨ, meta huye manuyunanaketsie.   
\q1
\v 3 Kiekari kitenieyaritsie 'utakekatɨ,  
\q2 karima kanahiwani mɨpaɨ 'utaitɨ:   
\q1
\v 4 «Xeme teɨteri, nekatinixekɨhɨaweni,  
\q2 nekanixehahɨaweni xeyunaime teɨteri.   
\q1
\v 5 Xeme 'atsixemɨkatemate, xetemaiwawetɨ xekenayuyeitɨa.  
\q2 Xeme xemɨkayuwaɨriya xemɨteyɨ'ɨkitɨakakɨ, xeheitimaitɨkɨkatɨ xekenakɨni.   
\q1
\v 6 Xekeneneu'eni, waɨkawa tita mɨreuyewetse nepɨtitaxata,  
\q2 nepɨtitaxata kemɨtiheitserie.   
\q1
\v 7 Ne netetakɨ tita mɨtiyuri xeikɨa nepɨtikuxata,  
\q2 yaxeikɨa neteni 'itarika kanixani'erieka.   
\q1
\v 8 Niuki neteta mayeneika naitɨ 'aixɨa pɨ'anene,  
\q2 nitixaɨtɨ 'axamɨti'ane pɨkatinɨ'ɨ ninanaimarika.   
\q1
\v 9 Kanihekɨaka neniuki memɨtemaiwawe wahetsiemieme,  
\q2 meta kaniyuritɨni memɨtemate wahepaɨtsita.   
\q1
\v 10 Ne'ɨkitsika pɨta xekeneutanaki'eri pɨrata pɨkatixaɨ,  
\q2 kenemɨtimaiwe xekeneutanaki'eri pɨkatixaɨ huru.   
\q1
\v 11 Mɨtimaiwenikɨ mɨ'ayumieme matsi waɨkawa katinaye'aka keyuri tetexi witsimɨ'anene,  
\q2 tsepa tita witsimɨti'ane hepaɨna pɨka'ane.   
\b  
\q1
\v 12 »Ne, mɨtimaiwenikɨ, nemɨ'ayumieme mɨtiuyematekɨ hamatɨa nekaniuyeikani,  
\q2 kepauka yɨkɨnemɨtiyurieni nekanine'iyaritɨaka meri.   
\q1
\v 13 Kemɨ'ane Yawé mayemakaxe, mɨkɨ 'axamɨti'ane pɨtixani'erie,  
\q2 ne muyuta'ɨrenikɨ nekani'uxieka meta nanaimarika,  
\q2 'aixɨa 'anemekɨ mɨka'uyeika meta niuki 'axamanɨyɨtɨka.   
\q1
\v 14 'Ɨkitɨarika nehetsie kanayeneikani meta tita mɨtiheitserie,  
\q2 nehetsie kanayeneikani petimaiwetɨ pemayanikɨ meta pemɨtɨrɨkaɨyenikɨ.   
\q1
\v 15 Newaparewiekaku te'aitamete mekateni'aitani  
\q2 meta kuwexinaruritsixi 'aitsika 'aixɨa 'aneneme mekanitiwewiwani.   
\q1
\v 16 Te'aitamete mexɨakate nekɨmana mepɨteha'aita  
\q2 meta 'itsɨkate naitsarie kwiepa nepuwaranuka'uitɨwa.   
\q1
\v 17 Kemɨ'ane memɨnetsinaki'erie, neta nekaniwanaki'erieka,  
\q2 kemɨ'ane memɨnetsikuwautɨwe, ne nematsiɨkɨme nepaneyeitɨwa.   
\q1
\v 18 Nehetsɨa waɨkawa mɨrexeiyanikɨ kanixuaweni meta 'aixɨa pemɨramamatiwanikɨ,  
\q2 waɨkawa pepɨtiukaxexeiyani meta 'atiteriwemekɨ pepɨrexeiyani.   
\q1
\v 19 Pemɨtimaiwenikɨ mɨ'ayumieme yanematipitɨakaku matsi 'ikwaxi 'aixɨa mɨ'ane kanihɨkɨtɨni keyuri huru,  
\q2 ne'iwarika matsi 'aixɨa pɨ'ane keyuri pɨrata.   
\q1
\v 20 Tita mɨtiheitserie hetsie nekaniumieni,  
\q2 'aixɨa mɨti'ane hetsie nekananiukani,   
\q1
\v 21 waɨkawa nepɨtiyetuirie kemɨ'ane mɨnetsinaki'erie,  
\q2 meta waɨkawa mɨrexeiyanikɨ.   
\b  
\q1
\v 22 »Yawé pɨnetsi'utawewi mexɨakame wewiyaya nemayanikɨ,  
\q2 matsi meripaitɨ timieme 'akuxi hipame katitiwewiwetɨ.   
\q1
\v 23 Ne matsi yemekɨ meripaitɨ nekaniunetɨarieni,  
\q2 meripaitɨ kwie 'akuxi kanetɨariewekaku.   
\q1
\v 24 Kepauka nemunetɨarietsie haramara mumariwe pumawekai,  
\q2 meta 'ana haixa pumawekai waɨkawa 'uhanetɨ.   
\q1
\v 25 Nekaniutinuiwa meripaitɨ 'akuxi yemurite kanetɨariewekaku,  
\q2 meta hɨri tsutɨmeyari 'umawekaku,   
\q1
\v 26 meripaitɨ mɨkɨ kwie kanetɨariewekaku meta mana witsikemutiu'ane  
\q2 metatsiere 'akuxi kwie tumuanariyari mexɨakame kanetɨariewekaku.   
\q1
\v 27 Ne nepunierixɨ kepauka Kakaɨyari muyuawi 'amuyematsie,  
\q2 meta haramara heima ketewa 'atɨ muyuxeiyanɨa muka'inɨaritaxɨtsie,  
\q2 ne 'ana nepɨtanierekai.   
\q1
\v 28 Kepauka muyuawitsie haiwitɨri muyeye,  
\q2 meta haixate tɨrɨkawime metinetɨaxɨa haramara 'ameukatewatsie,   
\q1
\v 29 kepauka haramara mupitɨa hakewa meye'atɨkani,  
\q2 meta 'aitsikaya meu'eniekakɨ,  
\q1 kepauka kwie tsutɨmeyari mukayatsaxɨtsie,   
\q2
\v 30 ne 'ana nepɨnierekai, 'uximayatsikaya 'aixɨa nepɨyuriekai.  
\q1 Tukari mɨyehane ne waɨkawa nepɨnetemawiekai,  
\q2 temawierika nepexeiyakai hɨxiena ne'uyeikatɨ,   
\q1
\v 31 kwie mɨkɨ mutawewikɨ nepɨnetemawiekai,  
\q2 meta teɨteri memunetɨariekɨ nepɨnetemawiekai.   
\b  
\q1
\v 32 »Hikɨ 'ayumieme, temari 'aku, xekeneneu'eni:  
\q2 'aixɨa mepɨ'itɨarieni kemɨ'ane nehuye 'utɨa memuhuni.   
\q1
\v 33 Ne'ɨxatsi xekeneu'eni meta xeketenemaiwaweni,  
\q2 hawaikɨ xepɨka'itawe'erieka temaiwawemete wa'ɨkitsika.   
\q1
\v 34 'Aixɨa mepɨ'itɨarieni kemɨ'ane memɨnetsi'enie,  
\q2 kemɨ'ane nekitenie memutatei tukarikɨ meta'enanatɨ,  
\q2 mɨranutakɨkatɨretsie meta'ikwewatɨ.   
\q1
\v 35 Yuri nekanaineni, kemɨ'ane mɨnetsikaxeiya, tukari kanikaxeiyamɨkɨ,  
\q2 metatsiere Yawé 'aixɨa kaniyurimɨkɨ.   
\q1
\v 36 Kemɨ'ane mɨkanetsitanaki'erieni, mɨkɨ yɨkɨmana kaniyutsewiximamɨkɨ,  
\q2 kemɨ'ane mɨnetsitixani'erieni, mɨkɨ mɨɨya pɨta kaninaki'erieka».   
\c 9  
\s1 Mɨtimaiwenikɨ mɨ'ayumieme kemɨti'inie meta mɨkatimaiwe  
\q1
\v 1 Mɨtimaiwenikɨ mɨ'ayumieme 'uka hepaɨ yukii kaniutawewieni  
\q2 meta 'atahutame mituikatɨka kaniutiwewieni.   
\q1
\v 2 Hikɨ 'ixɨarari kaniukuha'aritɨani, kaxie winuyari kaniukawewieni  
\q2 meta mexatsie 'aixɨa katiniupini.   
\q1
\v 3 Kaniwarutanɨ'ani 'ukari mɨtiwa'aitɨa, 'emanutitewatsie  
\q2 kiekaritsie mɨpaɨ memɨteheukahiwakɨ.   
\q1
\v 4 «Nehetsɨa xekeneu'axɨa xemɨkatemaiwawe,  
\q2 xeme temari peuyewetse xemɨtemaika.   
\q1
\v 5 Xekenakɨni, nepaa xekena'inɨata  
\q2 meta kaxie winuyari nemikawewi.   
\q1
\v 6 'Atsixekatemaitɨ xeketeneuhayewa, hikɨ 'ana xekanayenenierekakuni,  
\q2 timaiweme huyeya 'utɨa xekeneuhuni.   
\b  
\q1
\v 7 »Kemɨ'ane mɨtiyuyuriya mɨta'ɨxatsitɨani mɨkɨ pɨtatierieni xeikɨa,  
\q2 kemɨ'ane mɨtiyukatawe'erie mɨtaheitseritɨani mɨkɨ pɨtananaimarieni xeikɨa.   
\q1
\v 8 Mɨtiyukatawe'erie pepɨka'ɨxatsitɨaka kapa metsi'uti'uxiwe'erieni,  
\q2 'aixɨa pɨyɨni xɨka mɨtimaiwe pe'uta'ɨxatsitɨani, mɨkɨ hɨrixɨa matsinaki'erietɨ payani.   
\q1
\v 9 Mɨtimaiwe keneuta'ɨxatsitɨa, hikɨ mɨkɨ waɨkawa timaiwetɨ kanayeimɨkɨ,  
\q2 heitserie yamɨtikamie ketineuta'ɨkitɨa, hikɨ mɨkɨ waɨkawa timaitɨ kanayeimɨkɨ.   
\b  
\q1
\v 10 »Kemɨ'ane timaiwetɨ meuyeimɨkɨ ke'itsutɨani meri Yawé 'ayemakatɨ,  
\q2 xɨka Kakaɨyari Mɨpatsie maika mɨkɨ pɨtimaiweni.   
\q1
\v 11 Nehetsie petiwiyakaku, 'atukari nepɨtimɨiriya,  
\q2 nehetsie petiwiyatɨ waɨkawa wiyari pepɨtihuni.   
\q1
\v 12 Xɨka petimaiweni, 'a'iwarika kanihɨkɨtɨni pemɨtimaiwenikɨ,  
\q2 xɨka memɨtemaiwawe pewatawe'erieka mɨkɨkɨ 'ekɨ pekatinika'eniexɨamɨkɨ».   
\b  
\q1
\v 13 'Uka mɨka'uka'iyari, 'axakatiniuka'iyarini,  
\q2 mɨkayɨkɨhɨawe meta pɨkayukatewiya.   
\q1
\v 14 Yukitenie kanayeyeixani,  
\q2 xɨkata kiekaritsie 'uyeikani waɨkawa teɨteri memaxuawetsie kaniyeixarini,   
\q1
\v 15 meta kaniwa'iniwani kɨkamete  
\q2 yuhuyeta mɨheitserietsie me'uhukaku.   
\q1
\v 16 «Nehetsɨa xekeneu'axɨa xeme temari  
\q2 yakɨ xeikɨa xemɨteyurie.   
\q1
\v 17 Haa 'inawariekame matsi yemekɨ witsipa'ane.  
\q2 Paa matsi witsikana'aneni xiete hepaɨ xɨka 'itikwani 'awie».   
\q1
\v 18 Perɨ mɨkɨ 'atsimepɨkatemate xɨka kiitana mɨki 'ayekani,  
\q2 mɨkɨ 'inierimama 'atsimepɨkatemate xɨka mɨki teukiyata meheukaxɨrɨweni.   
\c 10  
\ms1 Tsarumuni niukieya kemɨtimaiwekai  
\p
\v 1 Tsarumuni niukieya kemɨtimaiwekai:  
\q1 Nunutsi mɨtimaiwe yupaapa pɨtemawieritɨa,  
\q2 nunutsi mɨkayuwaɨriya teɨteri muwaparewienikɨ yumaama kanihiweritɨaka.   
\b  
\q1
\v 2 Tumini 'axa'anemekɨ 'iwariekame nitixaɨtɨkɨ pɨkatiyunaki'erie,  
\q2 matsi tewi heitseriemekɨ yamɨtiyuriene pɨkamɨni.   
\b  
\q1
\v 3 Kemɨ'ane heitserie yamɨtiyuriene Yawé pɨka'ihayewa heuhakamɨkɨme,  
\q2 peru kemɨ'ane 'axamɨtiyuriene tita mɨreukwaimɨkɨ mɨra'inɨatakɨ pɨka'ipitɨa.   
\b  
\q1
\v 4 Xɨka pe'a'ɨraxieka tixaɨtɨ pekarexeiyatɨ pepayani,  
\q2 xɨka peti'uximayaka waɨkawa perexeiyatɨ pekanayeimɨkɨ.   
\b  
\q1
\v 5 Kemɨ'ane mɨtimaiwe 'itsanaxa katiniuti'utani,  
\q2 kemɨ'ane 'itsanaxa mukutsu puyutitewiya 'arike.   
\b  
\q1
\v 6 Tewi heitseriemekɨ yamɨtikamie waɨkawa 'aixɨa kani'itɨarieka,  
\q2 'axatiyuruwame witsipɨtikuxata matsi katiniyukananaimaka.   
\b  
\q1
\v 7 Heitserie memu'uwakai tewara'eriwatɨ 'aixɨa tepɨ'itɨarie,  
\q2 mɨkɨ 'axamemɨte'u'iyarikai kwitɨwa mepatɨmaiyarɨwa.   
\b  
\q1
\v 8 Kemɨ'ane yu'iyaritsie mɨtimaiwe mɨkɨ yapɨtikamie kemɨti'aitɨarie,  
\q2 peru 'axamɨtiyuriene yutemawietɨ meta 'axamɨtiniuki kanika'unariemɨkɨ.   
\b  
\q1
\v 9 Kemɨ'ane heitseriemekɨ 'amuyeika, 'aixɨa 'iyari 'apuyeika,  
\q2 'axatiuka'iyaritɨ 'amuyeika teɨteri mepɨtehetimani kemɨtiyuriene.   
\b  
\q1
\v 10 Yɨhɨxikɨ yu'iwa putitaxatɨani meta waɨkawa 'uximatɨarika pɨtixuawitɨani,  
\q2 'axamɨtiyuriene yutemawietɨ meta 'axamɨtiniuki pɨka'unarieni xeikɨa.   
\b  
\q1
\v 11 Tewi heitserie 'amuyeika niukieya tukari tiyupitɨwame kanihɨkɨtɨni,  
\q2 'axamɨtiuka'iyari witsipɨtiuxaxata peru katiniyukananaimaka.   
\b  
\q1
\v 12 'Uxiwe'erika matsi waɨkawa 'imieri kaninetɨaweni,  
\q2 peru naki'eriya naime mɨtareuyehɨwirienikɨ kaniyɨweni.   
\b  
\q1
\v 13 Mɨtimaiwe teta mɨtimatenikɨ niukiyari payeneika,  
\q2 kemɨ'aneta yakɨ xeikɨa mɨtiyuriene kaneuyeweka yuwaritsie mukuweiwanikɨ.   
\b  
\q1
\v 14 Kemɨ'ane mɨtimaiwe kemɨtimaiwe kani'utani,  
\q2 peru 'axamɨtiyuriene yutemawietɨ kemɨtiuxaxata yapauka katinaka'unamɨkɨ.   
\b  
\q1
\v 15 Xiku xikutɨriyaya hetsiena kaninuaka,  
\q2 peru tewi tixaɨtɨ mɨkarexeiya hetsiena nitixaɨtɨ pɨkatitanuani.   
\b  
\q1
\v 16 Tewi 'aixɨa mɨtiyuriene tukari kanipitɨariemɨkɨ,  
\q2 'axamɨtiuka'iyari 'iwarikaya 'axamɨti'ane katinihɨkɨtɨni.   
\b  
\q1
\v 17 Kemɨ'ane muyuwaɨriya mɨtaheitseritɨarienikɨ tukari kanikaxeiyamɨkɨ,  
\q2 kemɨ'ane mɨka'enu'eni mɨkɨ peuyeweni.   
\b  
\q1
\v 18 Kemɨ'ane 'uxiwe'erika mɨ'awieta mɨkɨ katini'itawani,  
\q2 kemɨ'ane mɨkayuwaɨriya muwapariewienikɨ teɨteri hipame wahetsiemieme kananiuweni.   
\b  
\q1
\v 19 Kemɨ'ane kwinimieme mɨraniuwe, waɨkawa 'axakatinikuyuruwani,  
\q2 kemɨ'ane mɨtimaiwe 'atsipɨka'utaine.   
\b  
\q1
\v 20 Heitseriemekɨ yamɨtikamie niukieya pɨrata mɨ'itiya hepaɨ kani'aneni,  
\q2 matsi 'axamɨtiuka'iyari kemɨtiku'eriwa tixaɨtɨkɨ pɨkatiyunaki'erie.   
\b  
\q1
\v 21 Heitserie 'amuyeika niukieya hipame waɨkawa kaniwaparewieka,  
\q2 yakɨxeikɨa 'axamemɨteyurie meyutemamawietɨ kememɨteyurie yuwiniyaritsie mekanixɨrɨweni.   
\b  
\q1
\v 22 Yawé hetsɨa katinayeneikani waɨkawa mɨrexeiyanikɨ,  
\q2 yu'iyaritɨatɨ tixaɨtɨ pɨkara'iwa.   
\b  
\q1
\v 23 Mɨkayuwaɨriya teɨteri waparewienike yɨkɨmana puyutemawieritɨa 'axatiyurienetɨ,  
\q2 peru mɨtimaiwe puyutemawieritɨa kemɨtiuyematekɨ.   
\b  
\q1
\v 24 'Axamɨtiuka'iyari ketita mɨtimakaxe, mɨpaɨ yapɨtipitɨarieni,  
\q2 tewi heitseriemekɨ 'amuyeika tita mɨreuyehɨwa, mɨkɨ pɨraye'ani hetsienamieme.   
\b  
\q1
\v 25 Kepauka wiyeri mumariwe mukuyani pukumawere 'axatiyuruwame,  
\q2 peru kemɨ'ane heitseriemekɨ yamɨtikamie yuheyemekɨ pɨtseɨyeni.   
\b  
\q1
\v 26 Mɨratsiwi rakwame ratametsie 'axapɨrayurieni meta kɨtsi rahɨxita kemɨtiyukukuine,  
\q2 mɨpaɨ kani'aneni mɨyɨ'ɨraxie kemɨ'ane mɨti'aitɨa hepaɨtsita.   
\b  
\q1
\v 27 Kemɨ'ane Yawé mayemakaxe tukari mɨireme kanipitɨariemɨkɨ,  
\q2 peru kemɨ'ane 'axamɨtiyuriene tukarieya pɨkamɨire.   
\b  
\q1
\v 28 Yamemɨtekahu temawierika mekanikaxeiyakuni,  
\q2 'axamemɨteyurieta tita memɨtetakwewie pɨkahaye'ani.   
\b  
\q1
\v 29 Yawé huyeyatsie yamemɨtekahu kaniwa'ɨwiyani,  
\q2 kaniwaka'unanita 'axamemɨteyurie.   
\b  
\q1
\v 30 Heitserie yamemɨtekahu hatsuaku mepɨkahekaxɨrieni,  
\q2 'axamemɨteyurie hatsuaku kwiepa mepɨka'u'uwani.   
\b  
\q1
\v 31 Heitserie yamemɨtekahu 'aixɨa 'anemekɨ mepɨtekuxata memɨtemaiwawekɨ,  
\q2 peru 'axamemɨteniniuki mepɨkapitɨarie memɨtiniunikɨ.   
\b  
\q1
\v 32 Heitserie 'amemu'uwa witsimepɨte'uniuka,  
\q2 peru 'axamemɨteyurie 'axa'anenemekɨ xeikɨa meputiniuka.   
\b  
\c 11  
\q1
\v 1 Yawé kaniwa'uxieka memɨteyukwamana,  
\q2 peru kemɨ'ane memɨkateyukwamana matsi 'aixɨa katiniwaxeiyani.   
\b  
\q1
\v 2 Kemɨ'ane mɨtiyukatawe'erie kaniyutewiyatsitɨamɨkɨ,  
\q2 kemɨ'ane mariweme mɨka'ayuyeitɨa, timaiwetɨ payani.   
\b  
\q1
\v 3 Heitserie 'amemu'uwa tita mɨtiheitserie puwaruwitɨxime,  
\q2 kemɨ'ane memɨte'itawa wa'itarika puwaka'una.   
\b  
\q1
\v 4 Xikutɨriya tixaɨtɨ pɨkarayani kepauka 'itsɨkame mɨmariwe hɨxie mɨtaxanetsienitsie,  
\q2 peru heitserie 'axɨka'uyeikani mɨkitsata pɨtawikweni.   
\b  
\q1
\v 5 Heitseriemekɨ 'amemu'uwa tita mɨtiheitserie puwaruwitɨxime,  
\q2 peru 'axamɨti'ane 'axateyuruwamete pɨwarekaxɨrɨwa.   
\b  
\q1
\v 6 Tita mɨtiheitserie puwawikweitsitɨa heitseriemekɨ yamemɨtekahu,  
\q2 peru tita memɨtehiwe'erie 'axateyuruwamete kaniwaranutaxɨrɨwani.   
\b  
\q1
\v 7 Kepauka 'axatiyuruwame mɨmɨni, pɨmɨnita tita mɨtitakwewiekai,  
\q2 meta pɨmɨni kemɨtiku'eriwakai mariwetɨ kemɨrayanikekai.   
\b  
\q1
\v 8 Heitseriemekɨ yamemɨtekahu mepɨwikweitsitɨarie kwaniwemetsata,  
\q2 matsi 'axatiyuruwame haweri pɨranuyeyani.   
\b  
\q1
\v 9 'Axatiyuruwame yutetakɨ yuhepaɨ tewi kanika'unani,  
\q2 peru heitseriemekɨ yamemɨtekahu memɨtehakumatekɨ mepuwikwe.   
\b  
\q1
\v 10 Kepauka heitseriemekɨ muyeika Yawé miparewie, naitɨ kiekari puyutemawie,  
\q2 kepauka 'axatiyuruwame mumɨni, waɨkawa temawierika puxuawe.   
\b  
\q1
\v 11 Heitseriemekɨ yamemɨtekahu kiekari 'aixɨa mepuyurie,  
\q2 peru 'axateyuruwamete yuniukikɨ mepika'una.   
\b  
\q1
\v 12 Yakɨ xeikɨa mɨtiyuriene 'axaputaine yuhepaɨ tewi hepaɨtsita,  
\q2 peru kemɨ'ane mɨtimaiwe puyupirenutɨa.   
\b  
\q1
\v 13 Teɨteri niuki peraixi tinaime mepɨte'axatawawe hipatɨ memɨtemaikakɨ,  
\q2 teɨteri 'aixɨa memɨte'u'iyari naime mepɨkatekuxata.   
\b  
\q1
\v 14 Ti'aitame xɨka 'aixɨa kati'aitani kiekari kanatiwemɨkɨ,  
\q2 'aixɨa mɨtiyɨnikɨ yuwaɨkawatɨ 'ɨxatsitamete mepeuyewetse.   
\b  
\q1
\v 15 Kanikweriwa'aneni xeime pemɨka'imate hetsiemieme pemɨre'akatuayanikɨ,  
\q2 kemɨ'ane mɨkayuwaɨriya xeime hetsiemieme mɨrayukatuanikɨ 'aixɨa 'iyari kaniuyeikani.   
\b  
\q1
\v 16 'Ukaratsi 'aixɨa mɨtiuka'iyari 'aixɨa pɨtixeiyarie,  
\q2 teɨteri memɨteyukananaima tumini xeikɨa mepɨ'iwaku.   
\b  
\q1
\v 17 Kemɨ'ane 'aixɨa 'iyarikɨ mɨtiyukanenimaya yɨkɨmana puyuparewie,  
\q2 kemɨ'ane 'axamuwayurie hipame mɨkɨta yɨkɨmana 'axapuyuyurie.   
\b  
\q1
\v 18 'Axatiyuruwame kwamanarikakɨ xeikɨa katina'i'iwani,  
\q2 matsi kemɨ'ane heitseriemekɨ yamemɨtekahu wa'iwarika 'aixɨa kani'aneni.   
\b  
\q1
\v 19 Kemɨ'ane heitseriemekɨ yamɨtikamie waɨkawa tukari pupitɨarieni,  
\q2 kemɨ'ane 'axamɨti'ane mɨranukuwei kwitɨwa pumierieni.   
\b  
\q1
\v 20 Yawé puwaxani'erie kemɨ'ane wa'iyari mututuni,  
\q2 matsi puyutemawie kemɨ'ane heitseriemekɨ yamemɨtekahu wahetsiemieme.   
\b  
\q1
\v 21 'Axateyuruwamete mepɨkateheuyehɨwiyarieni 'axamemɨte'uyurikɨ,  
\q2 peru heitseriekamekɨ yamemɨtekahu mepuyutawikweitsitɨani.   
\b  
\q1
\v 22 'Uka witsimɨti'ɨimari matsi kayɨkɨhɨawetɨ mutaniuka,  
\q2 huru hanirayari hepaɨ kani'aneni tuixu tsurieyatsie muyewie.   
\b  
\q1
\v 23 Heitseriemekɨ yamemɨtekahu ketita memɨtehiwe'erie 'aixɨa pɨtikuyɨne,  
\q2 'axateyuruwamete kememɨteku'eriwa 'axapɨtikuyɨne.   
\b  
\q1
\v 24 Kemɨtiwamikwa waɨkawa yutemawietɨ, mɨkɨ waɨkawa matsi pɨtipitɨarieni,  
\q2 matsi hipatɨ kememɨte'apitɨkakɨ xɨka mɨpaɨ mekate'uyutuani matsi kwinimieme haweri me'anenetɨ mepakɨne.   
\b  
\q1
\v 25 Kemɨ'ane tita mɨrexeiyakɨ hipame muwaparewie 'aixɨa pɨ'itɨarie,  
\q2 kemɨ'ane hipame muwaparewie mɨkɨta waɨkawa puparewiyani.   
\b  
\q1
\v 26 Kemɨ'ane tɨriku mɨti'awieta yuhetsiemieme mɨkɨ teɨteri 'axameke'utiyuani hepaɨtsitana,  
\q2 peru 'aixɨa pɨ'itɨarieni kemɨ'ane 'aixɨa 'iyari mituani.   
\b  
\q1
\v 27 Kemɨ'ane ximeri paitɨ manukukeka 'aixɨa tiyurienike, 'aixɨa ti'aneme pɨtiukaxexeiya,  
\q2 kemɨ'ane 'axamɨti'ane mɨtinake, 'axamɨti'ane pɨrenuku'axe.   
\b  
\q1
\v 28 Kemɨ'ane yupiinitɨarikatsie mɨtiwiya kanitayɨnarimɨkɨ,  
\q2 matsi heitseriemekɨ yamɨtikamie kɨye mɨyɨra hepaɨ kani'aneni.   
\b  
\q1
\v 29 Kemɨ'ane yukie 'uximatɨarika mɨwiwie tixaɨtɨ 'aixɨa ti'aneme pɨkatikuhayeikawa,  
\q2 kemɨ'ane 'axamɨtiyuriene yutemawietɨ xeime mɨtimaiwe ti'uximayatsirietɨ payani.   
\b  
\q1
\v 30 Heitseriemekɨ yamɨtikamie mɨkɨ kɨye tukari tiyupitɨwame hepaɨ kani'aneni.  
\q2 Mɨtimaiwe tukari 'aixɨa 'aneme kaniwapitɨaka memeuyexɨrixime.   
\b  
\q1
\v 31 Heitseriemekɨ yamemɨtekahu 'ena kwiepa yu'iwarika mekanexeiyani,  
\q2 matsi waɨkawa yemekɨ mekatenakapitɨariwani 'axateyuruwamete.   
\b  
\c 12  
\q1
\v 1 Kemɨ'ane muyuwaɨriya mɨtita'ɨkitɨarieni puyuwaɨriyata mɨretimanikɨ,  
\q2 matsi kemɨ'ane 'ɨkitɨarika mu'uxiwe'erie mɨkɨ pɨka'uka'iyari.   
\b  
\q1
\v 2 Tewi 'aixɨa mɨtiuka'iyari mɨkɨ Yawé piparewie,  
\q2 matsi kemɨ'ane 'axamɨtiuka'iyari hetsiena katiniɨhɨpani.   
\b  
\q1
\v 3 Xewitɨ pɨkayɨwe 'axamɨti'ane hetsie tiwiyatɨ 'aixɨa muyukuyurieni,  
\q2 matsi heitseriemekɨ yamemɨtekahu wananari 'atsipɨkayɨni.   
\b  
\q1
\v 4 'Uka 'inɨari mayuyeitɨwa yɨkɨna pɨtemawieritɨa,  
\q2 matsi 'uka tewinɨarika mɨwewie yɨkɨna 'umeteya pɨtixɨtɨaxime.   
\b  
\q1
\v 5 Teɨteri heitseriemekɨ yamemɨtekahu kememɨteku'eriwa pɨheitserie,  
\q2 matsi 'axatiyuruwame 'ɨxatsieyatsie 'itarika xeikɨa puxuawe.   
\b  
\q1
\v 6 'Axateyuruwamete waniuki winiyari mɨmɨɨya pɨhɨkɨ,  
\q2 matsi heitseriemekɨ yamemɨtekahu yuniukikɨ hipame mepɨwawikweitsitɨa.   
\b  
\q1
\v 7 'Axateyuruwamete mepatixɨrɨwe tawari hatsuaku mepɨka'anuku'uwe,  
\q2 matsi heitseriemekɨ yamemɨtekahu waniwema 'amepu'uwani yuheyemekɨ.   
\b  
\q1
\v 8 Tewi mɨtimaiwe 'aixɨa pɨtikuxaxatsiwa,  
\q2 matsi kemɨ'ane 'aixɨa mɨkatiuka'iyari kanixani'eriwani.   
\b  
\q1
\v 9 Matsi 'aixɨa pɨ'ane waɨkawa mɨkarexeiya peru yu'uximayatamete warexeiyatɨ 'amuyeika,  
\q2 'aixɨa pɨka'ane kename matiwa 'utaitɨ peru yu'ikwai karexeiyatɨ.   
\b  
\q1
\v 10 Tewi heitseriemekɨ yamɨtikamie yapɨtimate yunaime tewaxi wahetsiemieme kememɨte'uka'eniwa,  
\q2 matsi 'axatiyuruwame nitixaɨtɨ pɨkatinenimaya.   
\b  
\q1
\v 11 Kemɨ'ane yukwietsie mɨti'uximaya mɨkɨ 'anayuhayewame 'ikwai kanexeiyakamɨkɨ,  
\q2 kemɨ'ane yakɨxeikɨa mɨti'uximaya yakɨxeikɨa pɨtiyuriene.   
\b  
\q1
\v 12 'Axateyuruwamete ke'axamemɨteyuriku wawiniyari pɨhɨkɨ xeikɨa,  
\q2 matsi heitseriemekɨ yamemɨtekahu wananari 'aixɨa pɨ'itɨarie.   
\b  
\q1
\v 13 Kemɨ'ane mɨti'itawa yuniukikɨ pɨyutahɨani,  
\q2 matsi heitseriemekɨ yamɨtikamie 'uximatɨarikatsata panukukeka.   
\b  
\q1
\v 14 Xewitɨ 'aixɨa kemɨtikuxatakɨ,  
\q2 meta yumamakɨ kemɨti'uximayakɨ mɨkɨkɨ pɨtipitɨarieni.   
\b  
\q1
\v 15 'Axamɨtiyuriene yutemawietɨ tsepa kemɨtiyuriene hetsiena mieme 'aixɨa pɨ'ane,  
\q2 matsi kemɨ'ane mɨtimaiwe memɨtemaiwawe wa'ɨxatsi pɨta kani'enieka.   
\b  
\q1
\v 16 'Axamɨtiyuriene yutemawietɨ yapauka kaniuyeha'arɨweni,  
\q2 matsi mɨtimaiwe katiniukanewieka kepauka 'axamɨtitahɨawarieni.   
\b  
\q1
\v 17 Kemɨ'ane yurikɨ munierixɨ mɨkɨ heitseriemekɨ katinikuxatani,  
\q2 matsi kemɨ'ane mɨka'unierixɨ mɨkɨ 'itarikakɨ pɨtikuxata xeikɨa.   
\b  
\q1
\v 18 Kemɨ'ane 'axamɨtiuxaxata mɨkɨ niukieya 'ixipara hepaɨ pɨtiyuxiteke,  
\q2 matsi mɨtimaiwe niukieya pu'uaye.   
\b  
\q1
\v 19 Kemɨ'ane yurikɨ mɨtikuxata yuheyemekɨ 'apuyeikani,  
\q2 matsi kemɨ'ane mɨti'itawa yatewimekɨ xeikɨa 'apuyeikani.   
\b  
\q1
\v 20 Kemɨ'ane 'axamemɨteyurie wa'iyaritsie kwamanarika puxuawe,  
\q2 matsi kemɨ'ane 'aixɨa 'iyari temu'uwanikɨ mɨtikuxata mɨkɨ temawierika pexeiya.   
\b  
\q1
\v 21 Heitseriemekɨ yamɨtikamie 'axamɨti'ane 'atsipɨka'iyurieni,  
\q2 matsi 'axatiyuruwame 'axamɨti'ane pɨrenukanani.   
\b  
\q1
\v 22 Yawé memɨte'itawa puwaxani'erie,  
\q2 matsi pɨnaki'a yuri memɨtekuxata wahetsiemieme.   
\b  
\q1
\v 23 Tewi mɨtimaiwe yapɨka'utaine tita mɨrakumate,  
\q2 matsi memɨkayuwaɨriya teɨteri memuwaparewieni wa'iyari pahiwa tinaime tikuxatanetɨ.   
\b  
\q1
\v 24 Kemɨ'ane waɨkawa mɨti'uximaya mɨkɨ ti'aitame kanayeitɨariemɨkɨ,  
\q2 matsi muyu'ɨraxie waɨriyarika ti'uximayatame payani.   
\b  
\q1
\v 25 'Uximatɨarikakɨ tewi punutuixie yu'iyaritsie,  
\q2 peru niuki 'aixɨa manɨyɨne pitemawieritɨa.   
\q1
\v 26 Heitseriemekɨ yamɨtikamie yuhepaɨ tewi kaniuwitɨximeni 'aixɨa 'anemekɨ,  
\q2 matsi 'axatiyuruwame xɨka huyeya 'anukuweiya pɨreuyehɨani xeikɨa.   
\b  
\q1
\v 27 Kemɨ'ane mɨyɨ'ɨraxie pɨkayɨwe yu'ikwai mɨtikaxeiya,  
\q2 matsi kemɨ'ane mɨti'uximaya waɨkawa 'ikwai pɨrexeiya.   
\b  
\q1
\v 28 Heitseriemekɨ yamemɨtekahu wahuye tukari maxuawe peutiyune,  
\q2 mɨkɨ huyeta mɨɨya pɨkaxuawe.   
\b  
\c 13  
\q1
\v 1 Nunutsi mɨtimaiwe yupaapa 'ɨxatsieya kani'enieka,  
\q2 matsi mɨtiyukatawe'erie kepauka mɨ'ɨxatsitɨarie pɨka'iku'eniwa.   
\b  
\q1
\v 2 Kemɨ'ane 'aixɨa 'anemekɨ mɨtikuxata, mɨkɨ 'aixɨa 'anemekɨ pɨtiyumikwa,  
\q2 kemɨ'ane 'axamemɨte'u'iyari puwanake hipame memuwananaimanikɨ.   
\b  
\q1
\v 3 Kemɨ'ane mɨyupirenutɨa yutukari kanikweriwayurieka,  
\q2 matsi kemɨ'ane kwinimieme mɨtiyuxatsikawie yukɨmana puyuka'una.   
\b  
\q1
\v 4 Mɨyɨ'ɨraxie pɨreuyehɨwa, peru nitixaɨtɨ pɨkatiukaxexeiya,  
\q2 kemɨ'ane mɨti'uximaya naime yu'ikwai pɨrexeiya.   
\b  
\q1
\v 5 Heitseriemekɨ yamɨtikamie 'itarika pɨxani'erie,  
\q2 'axatiyuruwame tewiyarika pukuwewiene meta 'axamɨramamatiwanikɨ.   
\b  
\q1
\v 6 Heitseriemekɨ yamɨtikamie pɨ'ɨwiyarie,  
\q2 matsi 'axatiyuruwame 'axamɨti'ane pika'una.   
\b  
\q1
\v 7 Xewitɨ xiku puyuxata, peru tixaɨtɨ karexeiyatɨ,  
\q2 xewitɨ tixaɨtɨ mɨkarexeiya hepaɨ pɨ'ane, peru naime pɨrexeiya.   
\b  
\q1
\v 8 Xiku yutuminikɨ xeikɨa yutukari putawikweitsitɨwa,  
\q2 matsi tixaɨtɨ mɨkarexeiya xewitɨ pɨkaheye'unie.   
\b  
\q1
\v 9 Kemɨ'ane heitseriemekɨ yamemɨtekahu wahekɨariya waɨkawa pɨxawatɨ,  
\q2 matsi 'axateyuruwamete kɨxeme mɨtɨtɨki hepaɨ mepɨ'anene.   
\b  
\q1
\v 10 Teɨteri memɨteyukatawe'erie mekaniyukwitɨweni xeikɨa,  
\q2 matsi kemɨ'ane 'ɨxatsi memɨ'enie mɨkɨ mekatenimaiwaweni.   
\b  
\q1
\v 11 Tumini mexɨiwa mayu'i'iwa yapaukata kanitixɨrɨweni,  
\q2 kemɨ'ane tumini meuta'ɨwiyawe, mɨkɨ 'axɨkai xiku kanayeimɨkɨ.   
\b  
\q1
\v 12 Kepemɨtiku'eriwa xɨka yakatiuyunake mɨkɨ 'iyari pɨhiweritɨawe,  
\q2 kepemɨtiku'eriwa xɨka yatiuyunake mɨkɨ kɨye tukari tiyupitɨwame hepaɨ pɨ'ane.   
\b  
\q1
\v 13 Kemɨ'ane 'ɨxatsi mɨka'anu'enieni pɨkareuyehɨwiyarieni,  
\q2 kemɨ'ane 'aitsika kemainetsie yamɨtikayani 'aixɨa 'anemekɨ pɨrakapitɨarieni.   
\b  
\q1
\v 14 Memɨtemaiwawe wa'ɨkitɨarika mɨkɨ haa tukari mɨtiyupitɨwa hepaɨ pɨ'ane,  
\q2 meta winiyari mɨtiyumemiwatsata pɨtiyuwikweitsitɨwame.   
\b  
\q1
\v 15 Kemɨ'ane 'ɨxatsi 'aixɨa 'aneme mukuxata, mɨkɨ 'aixɨa pɨtikuxaxatsiwa,  
\q2 matsi 'axamɨtiuka'iyari huyeya yuheyemekɨ pɨkayupata.   
\b  
\q1
\v 16 Mɨtimaiwe puyuwaɨriya 'aixɨa mɨtiyurienikɨ yatimaitɨ tita mɨtiheitserie,  
\q2 matsi mɨkayɨwaɨriya mɨwaparewienikɨ kemɨtiyɨkɨhɨawe xeikɨa pɨtiyuriene.   
\b  
\q1
\v 17 Tupiri 'axamɨtiuka'iyari niuki 'axa'aneneme xeikɨa pɨ'atɨwa,  
\q2 tupiri 'aixɨa mɨtiuka'iyari 'aixɨa ti'aneneme pɨti'atɨwa.   
\b  
\q1
\v 18 Kemɨ'ane 'ɨkitɨarika mɨka'anu'enieni tixaɨtɨ karexeiyatɨ payani meta tewiyatsitɨarietɨ,  
\q2 matsi kemɨ'ane manu'ena waɨkawa 'aixɨa pɨrahɨawarɨwani.   
\b  
\q1
\v 19 Kepauka yamɨraye'ani ketemɨteku'eriwa 'ana tepuyutemamawie,  
\q2 matsi mɨkayuwaɨriya hetsiemieme pukwaniwe 'axamɨti'ane mɨtihayewakɨ.   
\b  
\q1
\v 20 Kemɨ'ane memɨtemaiwawe wahamatɨa 'amuyeika, timaiwetɨ kanayeimɨkɨ wahepaɨ,  
\q2 kemɨ'ane memɨkayuwaɨriya wahamatɨa 'amuyeika 'axa'anemɨtsie kaniyukakemɨkɨ.   
\b  
\q1
\v 21 'Axatiyuruwame 'axamɨti'ane hetsiena kaniye'axeni,  
\q2 matsi heitseriemekɨ yamɨtikamie 'aixɨa mɨti'anekɨ 'apɨrapiniyarieni.   
\b  
\q1
\v 22 Tewi 'aixɨa mɨtiuka'iyari yuteukarima piinitɨarika pɨtiwaku'e'eiririwa,  
\q2 'axatiyuruwame piinitɨarikaya mɨkɨ heitseriemekɨ yamemɨtekahu wahetsiemieme pɨta katinayeimɨkɨ.   
\b  
\q1
\v 23 Teɨteri tixaɨtɨ memɨkateheuxeiya memati'etsatsie waɨkawa 'ikwai kanixuaweni,  
\q2 matsi naitɨ katineuyewautseni xɨka kemɨtiheitserie mekate'uyurieni.   
\b  
\q1
\v 24 Kemɨ'ane yuniwe mɨkati'ɨkitɨa ka'enayewayatɨ mɨkɨ pɨka'inaki'erie,  
\q2 matsi xɨka 'ikuwayani ti'ɨkitɨatɨ mɨkɨ yuniwe pɨnaki'erie.   
\b  
\q1
\v 25 Tewi heitseriemekɨ yamɨtikamie pɨtikwa'a kepaukake mɨtahuxani,  
\q2 matsi 'axatiyuruwame heuhaakamɨtɨ 'apuyeikani.   
\b  
\c 14  
\q1
\v 1 'Uka mɨtimaiwe yuniwema 'aixɨa mɨti'anekɨ puwaxewiriya,  
\q2 matsi 'uka mɨkatimaiwe, yɨkɨmana puwataweiyaxɨani yuniwema.   
\b  
\q1
\v 2 Kemɨ'ane 'aixɨa 'anemekɨ mumie Yawé kanayemakaxeni,  
\q2 kemɨ'ane Yawé xani'erietɨ mumie mɨkɨ 'axakatiniyurieneni.   
\b  
\q1
\v 3 'Axamɨtiyuriene yutemawietɨ yuta'ɨretɨ xeikɨa katinikuxatani,  
\q2 matsi mɨtimaiwe kemɨtikuxata puyukweriwayurie.   
\b  
\q1
\v 4 Hakewa tuurutsixi kwietsanamete mememawe mana 'iku payewawaki,  
\q2 tuurutsixi kwietsanamete watɨrɨkariyakɨ 'itsanari putiwawaɨkare.   
\b  
\q1
\v 5 Kemɨ'ane munierixɨ mɨkɨ yurikɨ pɨtikuxata 'itsɨkame hɨxie yapɨtayɨni,  
\q2 matsi mɨti'itawa 'itsɨkame hɨxie yuri pɨkatikuxata yakɨ xeikɨa putaineni.   
\b  
\q1
\v 6 Kemɨ'ane mɨtiyukatawe'erie mɨtimaiwenikɨ mɨ'ayumieme pukuwaune matsi pɨka'ikaxexeiya,  
\q2 matsi kemɨ'ane yamɨtimate tita mɨti'aixɨa hetsiena mieme pɨkakwaniwe mɨtimaiwenikɨ.   
\b  
\q1
\v 7 Mɨkayuwaɨriya hamatɨa pepɨka'uyeikani,  
\q2 hatsuaku mɨkɨ niukieyatsie tixaɨtɨ pepɨkaretimani.   
\b  
\q1
\v 8 Mɨtimaiwe yapɨtimate kemɨtiyurieni ke'anemekɨ mumieni,  
\q2 matsi mɨkatimaiwe yukɨmana puyukwamana.   
\b  
\q1
\v 9 'Axamemɨteyurie meyutemamawietɨ kepauka wahetsie mɨrahɨiwa meputinawe meyuku'imawatɨ,  
\q2 matsi memɨtemaiwawe Kakaɨyari 'aixɨa pɨtiwaxeiya.   
\b  
\q1
\v 10 Ta'iyari yapɨtimate ketemɨte'uka'eniwa  
\q2 meta xewitɨ pɨkayɨwe xeime temawierikaya mɨhekɨatani.   
\b  
\q1
\v 11 'Axatiyuruwame kiiya kanika'unariemɨkɨ,  
\q2 matsi heitseriemekɨ yamemɨtekahu wakii 'aixɨa pɨ'itɨarie.   
\q1
\v 12 Tewi mɨpaɨ pɨtimate kename huye muxuawe naitɨ 'aixɨa 'anene,  
\q2 matsi mɨkɨ naitɨ huye mɨki teukiyapa kaneukayuyuneni.   
\b  
\q1
\v 13 Xɨka waɨkawa 'utananeni ra'iyaritsie pɨtiyukukuine,  
\q2 matsi temawierika kepauka meu'atɨyani tsuari xeikɨa payeika.   
\b  
\q1
\v 14 Mɨka'uka'iyari puyutemawie ke'axamɨtiyuriene hepaɨtsita,  
\q2 tewi 'aixɨa mɨtiuka'iyari puyutemawie 'aixɨa mɨtiyurienekɨ.   
\b  
\q1
\v 15 Tewi 'atsimɨkatimate kemɨreuyewetse naime yuri pɨrayeitɨwa,  
\q2 matsi mɨtimaiwe kaniyɨ'ɨwiyani kemɨtimie.   
\b  
\q1
\v 16 Mɨtimaiwe Yawé kanayemakaxeni 'ayumieme kaniyɨ'ɨwiyani 'axamɨti'ane hepaɨtsita,  
\q2 matsi mɨkayuwaɨriya puyuta'ɨre meta puyuwaɨriya mɨpaɨ 'utaitɨ nenekaniyɨweni.   
\b  
\q1
\v 17 Kemɨ'ane mayu'eriya yapauka 'axapɨtiyurieni 'atsikatimaitɨ,  
\q2 matsi kemɨ'ane mɨtimaiwe mɨkɨ pɨtiukanewie.   
\b  
\q1
\v 18 'Atsimemɨkatemate kemɨreuyewetse yamemɨteyurienikɨ wa'imikieri 'axamɨti'anene pɨrayani,  
\q2 matsi memɨtemaiwawe mepɨpitɨarie metemaiwawetɨ kemɨreuyewetse memumatsiɨkɨnikɨ.   
\b  
\q1
\v 19 'Axateyuruwamete 'aixɨa memɨte'u'iyari wahɨxie mekanikatunuma'uikuni,  
\q2 'axamemɨte'u'iyari mekanitihɨxima'uikuni heitseriemekɨ yamemɨtekahu wakitenietsie.   
\b  
\q1
\v 20 Kemɨ'ane tixaɨtɨ mɨkarexeiya hamikumamatɨtɨ mekani'uxiwe'erieka,  
\q2 matsi mekaniyumɨireni xiku memɨnaki'erie.   
\b  
\q1
\v 21 'Axapɨtiyurieneni xɨka yuhepaɨ tewi 'uxieka,  
\q2 'aixɨa pɨ'itɨarieka kemɨ'ane tixaɨtɨ memɨkatehexeiya mɨwanenimaya.   
\b  
\q1
\v 22 Kemɨ'ane 'axamemɨteyuriku mepeiyehɨani huye 'aixɨa mɨ'ane,  
\q2 matsi naki'eriya meta tita yuri mɨraine mepukaxexeiya kemɨ'ane 'aixɨa memɨteyurie.   
\b  
\q1
\v 23 Naime 'uximayatsikatsie 'ikwaxi puxuawe  
\q2 matsi xɨka yakɨxeikɨa tikuxatani tixaɨtɨ karexeiyatɨ payani.   
\b  
\q1
\v 24 Mɨtimaiwe pumatsiɨkɨ yatimaitɨ tita mɨreuyewetse yamɨtiyurienikɨ,  
\q2 memɨka'u'iyari mepumatsiɨkɨ kememɨterukutsixikɨ.   
\b  
\q1
\v 25 Kemɨ'ane yurikɨ munierixɨ pɨtikuxata 'itsɨkate wahɨxie hipame wawikweitsitɨatɨ,  
\q2 matsi kemɨ'ane ka'uniereka yamɨtikuxata 'atsimɨkatiuyuri kanimierinɨamɨkɨ.   
\b  
\q1
\v 26 Kemɨ'ane Yawé mayemakaxe mɨkɨ yuhetsie nunuwame pexeiya  
\q2 meta tɨɨriyamama mepɨ'ɨwiyarieka.   
\b  
\q1
\v 27 Kemɨ'ane Yawé mayemakaxe mɨkɨ tukari pupitɨarie 'anayuhayewame,  
\q2 meta mɨki winiyariyaritsie kaniutawikweweni.   
\b  
\q1
\v 28 Ti'aitame teɨteri yuwaɨkawame wahetsie ti'aitatɨ pumariwe,  
\q2 ti'aitame kawarexeiyatɨ kemɨ'ane mɨtiwaruta'aitɨani pɨtewiyatsitɨarieni.   
\b  
\q1
\v 29 Kemɨ'ane mɨka'ayu'eriya pɨmatsiɨkɨ waɨkawa kemɨtimaiwe,  
\q2 matsi yapauka mayu'eriya pɨmatsiɨkɨ ke'axamɨtiyurie yutemawietɨ.   
\b  
\q1
\v 30 Xɨka yu'iyaritsie 'aixɨa tiyɨkɨhɨaweni 'aixɨa pɨreu'erieka yuwaiyaritsie,  
\q2 matsi 'uxiwe'erika naime 'umete pɨtixɨtɨaxime.   
\b  
\q1
\v 31 Kemɨ'ane tixaɨtɨ mɨkarexeiya mɨnanaima mɨkɨ Kakaɨyari pɨnanaima kemɨ'ane mitawewi,  
\q2 matsi tixaɨtɨ mɨkarexeiya mɨnenimaya mɨkɨ Kakaɨyari hepaɨtsita 'aixɨa pɨtiyukɨhɨawe.   
\b  
\q1
\v 32 'Axatiyuruwame kanekawautseni yukɨmana 'axatiyurienetɨ,  
\q2 kemɨ'ane heitseriemekɨ yamɨtikamie tsepa mɨmɨxime pɨ'ɨwiyarieka.   
\b  
\q1
\v 33 Memɨtemaiwawe yu'iyaritsie kememɨte'uyemate pɨtihɨpɨne,  
\q2 matsi memɨkayuwaɨriya 'etsiwatɨma mepɨka'imate.   
\b  
\q1
\v 34 Kepauka teɨteri heitseriemekɨ yamemɨtekahu kiekari mariwetɨ payeika,  
\q2 matsi kepauka teɨteri 'axamemɨteyurie naime kiekari mepɨtewiyatsitɨa.   
\b  
\q1
\v 35 Kemɨ'ane mɨtimaiwe ti'aitame pɨtemawieritɨa yu'uximayatsikakɨ,  
\q2 matsi ti'aitame pɨha'a ti'uximayatameya yamɨkatikamiekɨ mitewiyatsitɨakɨ.   
\b  
\c 15  
\q1
\v 1 Niuki heitserie 'aixɨa manɨyɨne haxɨa pukuxeriya,  
\q2 matsi niuki mɨxɨka waɨkawa haxɨa kanayeitɨwani.   
\b  
\q1
\v 2 Memɨtemaiwawe metekuxatakaku hipatɨ waɨkawa mepɨtehetimamateke,  
\q2 mɨkayuwaɨriya teɨteri muwaparewienikɨ yakɨ xeikɨa katinikuxatani.   
\b  
\q1
\v 3 Yawé naitsarie puyeika tanieretɨ,  
\q2 waxeiyatɨ 'aixɨa memɨte'u'iyari meta 'axamemɨteyurie.   
\b  
\q1
\v 4 Niuki mɨtiyɨnɨtɨwa mɨkɨ ra'iyaritsie tukari tiyupitɨwame kanihɨkɨtɨni,  
\q2 matsi niuki 'axamanɨyɨne 'iyari pɨhiweritɨawe.   
\b  
\q1
\v 5 'Axamɨtiyuriene yutemawietɨ panati'ewa paapaya 'i'ɨxatsitɨakaku,  
\q2 katinimaiweni kemɨ'ane mɨyɨ'ɨxatsitɨarinɨa.   
\b  
\q1
\v 6 Heitseriemekɨ yamɨtikamie kiena 'ikwai panayuhayewa,  
\q2 matsi 'axamɨtiuka'iyari kie 'uximatɨarika waɨkawa puxuawe.   
\b  
\q1
\v 7 Memɨtemaiwawe metekuxatakaku hipatɨta metemaitɨ mepakɨka,  
\q2 memɨkayuwaɨriya hipame memuwaparewienikɨ wa'iyari 'etsiwatɨma mɨpaɨ pɨkatiku'eriwa.   
\b  
\q1
\v 8 Yawé 'axateyuruwamete wamawari kani'uxiwe'erieka,  
\q2 matsi puyutemawie heitseriemekɨ yamemɨtekahu wanenewierikɨ.   
\b  
\q1
\v 9 Yawé 'axateyuruwamete wahuye kani'uxiwe'erieka,  
\q2 matsi puwanaki'erie kemɨ'ane tita mɨtiheitserie memɨte'uweiya.   
\b  
\q1
\v 10 Kemɨ'ane huye 'aixɨa mɨ'ane muku'eirieni waɨkawa katinita'ɨkitɨariemɨkɨ 'anayeweiwatɨ,  
\q2 matsi kemɨ'ane mitixani'eri mɨkɨ pumierieni.   
\b  
\q1
\v 11 Yawé naime katinimaika teukiyapa meta meukatewatsie timieme,  
\q2 matsi tewi kemɨtiyɨkɨhɨawe yu'iyaritsie mɨkɨ pumate.   
\b  
\q1
\v 12 Kemɨ'ane mɨtiyukatawe'erie pɨka'inake mɨta'ɨxatsitɨarienikɨ,  
\q2 meta pɨka'inake memɨtemaiwawe mɨwanɨka.   
\b  
\q1
\v 13 'Iyari xɨka yutemawieka pɨmatsiɨkɨ tahɨxie paitɨ,  
\q2 'iyari xɨka tiuka'eniwani yaxeikɨa pɨmatsiɨkɨta.   
\b  
\q1
\v 14 Memɨtemaiwawe mepɨyuwaɨriya matsi waɨkawa memɨte'uyemaikakɨ,  
\q2 memɨkayuwaɨriya hipame memuwaparewienikɨ 'axaniuki xeikɨa mepukwa'a.   
\b  
\q1
\v 15 Naitɨ tukari 'axapɨ'anene munutuixie hetsiemieme,  
\q2 matsi muyutemawie hetsiemieme tukarikɨ 'ixɨarari puxuawe.   
\b  
\q1
\v 16 Matsi 'aixɨa pɨ'ane 'etsiwa mɨrexeiyani Yawé 'ayemakatɨ,  
\q2 matsi 'aixɨa pɨka'ane waɨkawa mɨrexeiyani tiuka'eniwatɨ.   
\b  
\q1
\v 17 'Aixɨa pɨ'ane mɨtitsitsiɨrawi xɨka tetekwaka teyunaki'erietɨ,  
\q2 'aixɨa pɨka'ane wai xɨka tekwaka teyu'uxiwe'erietɨ.   
\b  
\q1
\v 18 Kemɨ'ane mayu'eriya yapauka payumiewe,  
\q2 kemɨ'ane mɨka'ayu'eriya kayuwatɨ puwapitɨa hipame.   
\b  
\q1
\v 19 Mɨyɨ'ɨraxie huyetana waɨkawa xuya kanixuaweni,  
\q2 matsi heitseriemekɨ yamemɨtekahu wahuye 'apatayewa.   
\b  
\q1
\v 20 Temaikɨ mɨtimaiwe yupaapa pɨtemawieritɨa,  
\q2 matsi temaikɨ mɨka'uka'iyari yumaama pɨtewiyatsitɨa xeikɨa.   
\b  
\q1
\v 21 Mɨkatimaiwe puyutemawie yakɨ xeikɨa tiyurienetɨ,  
\q2 matsi mɨtimaiwe yuhuye yɨkɨmana pɨheitseritɨa.   
\b  
\q1
\v 22 Kepauka 'ɨxatsi meuyewetse ketemɨteku'eriwa yapɨkatikɨyɨne,  
\q2 kepauka tanaitɨ temuyu'enie teyu'ɨxatsitɨatɨ 'aixɨa pɨtikɨyɨne.   
\b  
\q1
\v 23 Witsipɨ'ane xɨka 'aixɨa 'anemekɨ waku'eiyani,  
\q2 meta waɨkawa witsipɨ'ane xɨka 'uta'eiyarieni kepauka meuyewetse.   
\b  
\q1
\v 24 Mɨtimaiwe tukari huyeyari taheima meutiyune 'utɨa pumie,  
\q2 mɨki teukiyapa meukahɨiyanikɨ puyutawikweitsitɨwa.   
\b  
\q1
\v 25 Yawé memɨyuti'ɨre wakii kaniti'unani,  
\q2 matsi wiuraxi wakwie pɨ'ɨwiya kapa me'unawaiyarienikɨ.   
\b  
\q1
\v 26 Yawé kaniwa'uxieka 'axateyuruwamete yakɨ xeikɨa kememɨteku'eriwa,  
\q2 matsi pinake niuki mɨheitserie.   
\b  
\q1
\v 27 Kemɨ'ane waɨkawa mɨrexeiyanikɨ mɨtihiwe'erie 'aixɨa pɨka'ane tɨɨriyamama wahetsiemieme,  
\q2 matsi tumini mɨka'anu'ɨwe hetsiena mɨraka memɨteheuyehɨwirienikɨ mɨkɨ yuheyemekɨ tukari hexeiyatɨ payani.   
\b  
\q1
\v 28 Heitseriemekɨ yamɨtikamie yapɨtimate yu'iyaritsie kemɨtayɨni,  
\q2 matsi 'axamemɨteyurie 'axati'aneme xeikɨa mepɨtekuxata.   
\b  
\q1
\v 29 Yawé 'axateyuruwamete kawa'enietɨ 'ateewa puyeika,  
\q2 matsi heitseriemekɨ yamemɨtekahu wanenewieri kani'enieka.   
\b  
\q1
\v 30 Kepauka xewitɨ 'aixɨa 'iyari mɨratahɨawe 'ana 'iyari puyutemawieka,  
\q2 meta niuki 'aixɨa manɨyɨne tɨrɨkariya pɨtiyupitɨwa.   
\b  
\q1
\v 31 Matsi kemɨ'ane 'ɨxatsi mɨ'enie yapɨretimaixime yutukari hetsiemieme,  
\q2 'ayumieme memɨtemaiwawe watsata puyeikani.   
\b  
\q1
\v 32 Kemɨ'ane 'ɨxatsi mɨkanaki'erie yɨkɨmana puyunanaimani,  
\q2 matsi kemɨ'ane 'ɨxatsi manu'enieni timaiwetɨ payani.   
\b  
\q1
\v 33 Kemɨ'ane Yawé mayemakaxe heitseriemekɨ yapɨtikamie meta pɨtimaiweni,  
\q2 kemɨ'ane tixaɨtɨ mɨkarayuyeitɨa 'aixɨa pɨrahɨawarɨwa 'aixɨa mɨtiyurienekɨ.   
\b  
\c 16  
\q1
\v 1 Tewi yaputaine kemɨtiyurimɨkɨ,  
\q2 matsi Yawé pɨta yapɨtipitɨani kemɨtiyurieni.   
\b  
\q1
\v 2 Tewi yapɨtiku'eriwa yuhetsiemieme kemɨtiyurieni kename 'aixɨa ti'ane naitɨ,  
\q2 matsi Yawé pimate kehepaɨtɨtɨ mɨtiyuriene.   
\b  
\q1
\v 3 Naime kepemɨtiyurienekɨ Yawé ketineuhɨritɨa,  
\q2 kepemɨtiku'eriwa 'ana yapɨtiyɨni.   
\b  
\q1
\v 4 Yawé naime kemɨtiyuriene yatimaitɨ pɨtiyuriene,  
\q2 meta 'axatiyuruwame putawewi 'imatɨrieka tukaritsie mutika'eniexɨanikɨ.   
\b  
\q1
\v 5 Yawé memuyuti'ɨre kaniwa'uxiwe'erieka,  
\q2 matsi kaniyuritɨni katinika'eniexɨamɨkɨ.   
\b  
\q1
\v 6 Xeyunaki'erietɨ meta yuri xehaitɨkaitɨ xekateneuyuyehɨwiriekakuni,  
\q2 Yawé 'ayemakatɨ xeikɨa pɨyɨwe 'axamɨti'ane mɨnewienikɨ.   
\b  
\q1
\v 7 Yawé kepauka tewi 'aixɨa mɨtixeiya hetsienamieme kaniyutemawieka,  
\q2 metatsiere memeye'unie 'aixɨa mete'ixeiyakame kaniwarayeitɨaka.   
\b  
\q1
\v 8 Matsi 'aixɨa pɨ'ane 'etsiwa mɨrexeiyani heitseriemekɨ yatikamietɨ,  
\q2 matsi 'aixɨa pɨka'ane waɨkawa mɨrexeiyani heitseriemekɨ yakatikamietɨ.   
\b  
\q1
\v 9 Tewi yapɨtiku'eriwa kemɨtiyurienikɨ yuhetsiemieme,  
\q2 matsi Yawé pɨta heitserie pexeiya mɨpaɨ mɨtiyurienikɨ.   
\b  
\q1
\v 10 Ti'aitame Kakaɨyaritsie timieme pɨtikuxata,  
\q2 mɨkɨ 'itarikakɨ manutahɨiyanikɨ yapɨkatayɨni.   
\b  
\q1
\v 11 Ti'inɨnɨatamete 'aixɨa mɨ'anene Yawé hetsɨa pumieme,  
\q2 naime ti'inɨnɨatamete Kakaɨyari kaninetɨani.   
\b  
\q1
\v 12 Ti'aitame 'axamemɨteyurie kaniwa'uxiwe'erieka,  
\q2 karikɨ 'uweni 'aixɨa 'anemekɨ katini'aitametɨni.   
\b  
\q1
\v 13 Ti'aitame kaniyutemawieka mɨkɨ yamemɨtekahu wa'enietɨ,  
\q2 kemɨ'ane yurikɨ mɨtikuxata pɨnaki'erie.   
\b  
\q1
\v 14 Ti'aitame haxɨaya katiniyumemiwani,  
\q2 matsi kemɨ'ane mɨtimaiwe kaniyɨweni minɨtɨanikɨ.   
\b  
\q1
\v 15 Ti'aitame xɨka 'aixɨa 'anemekɨ ratahɨawe putukari,  
\q2 parewiyaya 'imikieri mɨraye'axe hepaɨ kani'aneni.   
\b  
\q1
\v 16 Matsi mɨtimaiwenikɨ mɨ'ayumieme katinaye'aka keyuri huru,  
\q2 meta katinaye'aka mɨtiuyemaikakɨ keyuri pɨrata.   
\b  
\q1
\v 17 Kemɨ'ane heitseriemekɨ yamɨtikamie huyetana 'axamɨti'ane pɨtiumawe,  
\q2 kemɨ'ane yutukari mɨwikweitsitɨamɨkɨ, kaniyɨ'ɨwiyani kemɨtimie.   
\b  
\q1
\v 18 Kemɨ'ane mɨtiyukatawe'erie tiyu'uname hetsiena pɨye'ani,  
\q2 kemɨ'ane muyuta'ɨre pekaweni.   
\b  
\q1
\v 19 'Aixɨa pɨ'ane xɨka haweri memɨ'anene wahamatɨa tixaɨtɨ katihɨkɨtɨni,  
\q2 keyuri memuyuti'ɨre wahamatɨa pemɨxikutɨnikɨ.   
\b  
\q1
\v 20 Kemɨ'ane niuki meti'enietɨyeika, 'aixɨa ti'aneme pɨtiukaxexeiya,  
\q2 meta 'aixɨa pɨ'itɨarie kemɨ'ane Yawé hetsie mɨtiwiya.   
\b  
\q1
\v 21 Kemɨ'ane mɨtimaiwe mɨtiuyemate katinitewaka,  
\q2 kemɨ'ane witsi'anemekɨ mɨtikuxata 'aixɨa pɨti'enierie.   
\b  
\q1
\v 22 Haa muhane hepaɨ mekani'aneneni kemɨ'ane kememɨteyuriekɨ 'aixɨa memɨtehakumate,  
\q2 'axamemɨteyurie meyutemamawietɨ pɨkayɨwe mɨtiwaruti'ɨkitɨani.   
\b  
\q1
\v 23 Kemɨ'ane 'aixɨa mɨtiyukɨhɨawe kaniyɨweni yuneni mupirenutɨani,  
\q2 yunenikɨ kemɨtiyuriene naime katinimaika.   
\b  
\q1
\v 24 Mutiyukanaki'erie niukieya xiete hepaɨ kana'aneni,  
\q2 'atukari 'aixɨa kaniyurieka meta 'awaiyaritsie 'aixɨa pekatineu'erieka.   
\b  
\q1
\v 25 Teɨteri kememɨteyurie 'aixɨa ti'aneme mepɨte'erie,  
\q2 matsi mɨkɨ huye mɨki teukiyapa kaneukayuneni.   
\b  
\q1
\v 26 Kemɨ'ane yehaakamɨnetɨ 'amuyeika haaka waɨriyarika pipitɨa mɨti'uximayakakɨ,  
\q2 kemɨtiyehaakamɨnekɨ waɨriyarika pɨti'uximaya mɨtikwanikɨ.   
\b  
\q1
\v 27 Mɨka'uka'iyari pɨhɨne 'axamɨti'anekɨ huxunu hepaɨ,  
\q2 meta 'axamɨraniuwe tai hepaɨ katiniyutaiyani.   
\b  
\q1
\v 28 Kemɨ'ane 'axamɨtiuka'iyari 'imieri pawiwiwe,  
\q2 niukiperai kaniwataxɨrɨwani 'aixɨa memɨteyuku'eriya.   
\b  
\q1
\v 29 Mayu'eriya yuhepaɨ tewi kanikwamanani,  
\q2 kani'inieka xeikɨa yuhuyeta 'axakemɨtiyurienetsie.   
\b  
\q1
\v 30 Kemɨ'ane yuhɨxikɨ 'inɨari metsiwewirie mɨkɨ 'axametsiyurimɨtɨ pɨyɨane,  
\q2 kemɨ'ane mita'atse 'ariri mɨkɨ 'axakatiniuyurieni.   
\b  
\q1
\v 31 Mutuxaiya kuruna kanihɨkɨtɨni 'aixɨa kemɨtixeiyariekakɨ,  
\q2 'aixɨa 'anemekɨ 'uyeikatɨ kane'iwamɨkɨ.   
\b  
\q1
\v 32 Matsi 'aixɨa pɨ'ane petiukanewietɨ keyuri pera'a'iwamɨtɨ,  
\q2 matsi 'ekɨ 'a'iyari kenenɨtɨaweni keyuri kiekarite peka'a'iwake.   
\b  
\q1
\v 33 Teɨteri kememɨteyurienikɨ yamepɨtekuwaɨtɨwe,  
\q2 matsi Yawé pɨta yapɨtikuyuruwa.   
\b  
\c 17  
\q1
\v 1 'Aixɨa pɨ'ane matsi kayuwatɨ temu'uwanikɨ tsepa paa tsetse'ime temukwa'a,  
\q2 keyuri temuyukwitɨweni 'ixɨarari tewewietɨwetɨ.   
\b  
\q1
\v 2 Ti'uximayatame mɨtimaiwe yukutsiyari nu'aya mɨkayukatewiya pɨtita'aitɨani,  
\q2 hikɨ mɨkɨta pɨtiyetuiriyarieni tita mɨtipiinieyatɨkai yukutsiyari niwemama wahamatɨa.   
\b  
\q1
\v 3 Tai kwinimieme mɨtixɨkakɨ huru meta pɨrata kanikwaxiyarieka huxunuta,  
\q2 matsi ta'iyari Yawé pɨta kani'inɨatani.   
\b  
\q1
\v 4 'Axatiyuruwame yuhepaɨ 'axatiyuruwame kani'enieka,  
\q2 mɨti'itawa yuhepaɨ mɨti'itawa kani'enieka.   
\b  
\q1
\v 5 Kemɨ'ane tixaɨtɨ mɨkarexeiya muyuriya mɨkɨ Kakaɨyari mitawewi kani'uxiwe'erieka,  
\q2 kemɨ'ane muyutemawie 'ixeiyatɨ tiuka'eniwame mɨkɨ pɨkareuyehɨwiyarieni pu'uximatɨarieni.   
\b  
\q1
\v 6 'Ukiratsi teukarimama kurunaya mekanihɨkɨtɨni,  
\q2 tɨɨri yupaapama wahekɨ mepuyuti'ɨre.   
\b  
\q1
\v 7 'Aixɨa pɨka'ane mɨka'uka'iyari 'aixɨa mɨtikuxatani,  
\q2 yaxeikɨa 'aixɨa pɨka'ane ti'aitame mɨtiku'itawanikɨ.   
\b  
\q1
\v 8 Kemɨ'ane tumini mɨwata'ɨitɨwa 'awie yamemɨteyurienikɨ hipatɨ kemɨtinake,  
\q2 mɨkɨ 'itsɨ mariweme makwe'e puyu'erie,  
\q1 matsi mɨkɨ kemɨtiyuriene naitɨ yapɨtikɨyɨne.   
\b  
\q1
\v 9 Kemɨ'ane mɨreiyehɨwirie 'axamutayɨ mɨkɨ naki'eriya pukaxexeiya,  
\q2 kemɨ'ane 'axamɨraniuwe kareiyehɨwirietɨ hamiku pɨkahexeiya.   
\b  
\q1
\v 10 Kemɨ'ane mɨtimaiwe xeiniukiyarikɨ peu'ena,  
\q2 mɨka'uka'iyarita tsepa xeitsienituyarimexɨa muweiya mɨkɨ pɨka'anu'ena.   
\b  
\q1
\v 11 Kemɨ'ane mayu'eriya kemɨ'ane mɨtamieni kanikuwauneni,  
\q2 peru xeime panɨnɨ'aiyarieni matsi waɨkawa mɨtɨrɨkaɨye.   
\b  
\q1
\v 12 'Aixɨa pɨ'ane hutse xɨka 'anukunake mayu'eriya yuniwema munawaiyarie,  
\q2 keyuri 'atsimɨkatimate xɨka ranukunake.   
\b  
\q1
\v 13 Kemɨ'ane 'aixɨa tixeiyarietɨ 'axamɨti'anekɨ mɨtiwarakapitɨwa,  
\q2 yuheyemekɨ tɨɨriyamama 'axamepɨ'itɨarieka.   
\b  
\q1
\v 14 Xɨka 'imieri 'utsutɨani haa manutanama manuta'una hepaɨ pɨtikɨyɨne,  
\q2 matsi 'aixɨa pɨ'ane mɨtihayewani 'axatiyurienetɨ.   
\b  
\q1
\v 15 Yawé 'ikɨ hutame pu'uxiwe'erie:  
\q2 hetsiena mɨrahɨiwa xɨka 'uxɨnarieni 'aixɨa pɨka'ane  
\q2 hetsiena mɨkarahɨiwa pɨta xɨka 'anutahɨiyani.   
\b  
\q1
\v 16 Mɨka'uka'iyari xɨka 'atsikatimaika tsepa tumini mexeiya,  
\q2 pɨkayɨweni mɨtimaiwenikɨ mɨ'ayumieme mɨnanenikɨ.   
\b  
\q1
\v 17 Hamiku yuheyemekɨ pɨtiuyukanaki'erie,  
\q2 kepauka 'uximatɨarika mexeiyanitsie yu'iwa hepaɨ pɨtimaika.   
\b  
\q1
\v 18 Tewi mɨkatimaiwe yapɨtayɨni xeime hetsiemieme mɨrayukatuanikɨ,  
\q2 mɨkɨ xeime hetsiemieme rapitɨ payeika.   
\b  
\q1
\v 19 Kemɨ'ane minake 'axamɨtiyurienenikɨ mɨkɨ kaninakeni muyutamienikɨ,  
\q2 kemɨ'ane kwinimieme mɨraniuwe tenieya manutatsanarienikɨ kanikuwaneni.   
\b  
\q1
\v 20 Kemɨ'ane mɨtiyukwamana hatsuaku 'aixɨa 'itɨarietɨ pɨka'ayani,  
\q2 kemɨ'ane mɨti'itawa tsiepɨre hetsiena katinahɨiwani.   
\b  
\q1
\v 21 Kemɨ'ane temaikɨ katiyu'aitɨarinɨakame mexeiya mɨkɨ pɨrahiweritɨaka,  
\q2 xɨka mɨpaɨ 'anekame hexeiyani temawierika pɨka'ukaxeiya.   
\b  
\q1
\v 22 Waɨkawa yu'iyaritsie xɨka yutemawieka 'uaye hepaɨ kani'aneni,  
\q2 kepauka pemɨkayutemawieka 'awaiyaritsieta pepuwerani.   
\b  
\q1
\v 23 'Axateyuruwamete tumini memɨnaki'erie tixaɨtɨkɨ 'awie yameteyurienike,  
\q2 'itsɨkate niuki tutunime xeikɨa mekani'enieka tumini memanɨ'ɨwekɨ.   
\b  
\q1
\v 24 Kemɨ'ane mɨtimaiwenikɨ mɨ'ayumieme mexeiya waɨkawa kaninaki'erieka,  
\q2 mɨkayuwaɨriya hipame muwaparewienikɨ 'atsipɨkatimate ketita mɨreuyehɨwa.   
\b  
\q1
\v 25 Temaikɨ mɨka'uka'iyari yupaapa xeikɨa pɨhaxɨatɨwame,  
\q2 yaxeikɨata yumaama kani'uximatɨaka.   
\b  
\q1
\v 26 'Aixɨa mɨtiuka'iyari xɨka 'anutahɨani 'aixɨa pɨka'ane,  
\q2 yaxeikɨata 'aixɨa pɨka'ane 'aixɨa mɨtiuka'iyari xɨka 'ukuwaxɨani heitseriekamekɨ 'amuyeikakɨ.   
\b  
\q1
\v 27 Kemɨ'ane mɨtimaiwe 'etsiwa xeikɨa pɨtikuxata,  
\q2 kemɨ'ane mɨtiuyemate mɨkɨ yapauka yuhetsie pɨkatikupitɨwa.   
\b  
\q1
\v 28 Matsi 'axamɨtiyuriene yutemawietɨ timaiwetɨ payani xɨka kayuwatɨ tiuyerɨni,  
\q2 xɨka tiuhayewa yutetakɨ matsi timatetɨ pɨ'eriwani tsepa 'atsimɨkatimate.   
\b  
\c 18  
\q1
\v 1 Kemɨ'ane yuxaɨtame xeikɨa mayu'eriwa yuhetsiemieme xeikɨa pɨtikuwaune,  
\q2 naime 'ɨxatsi 'aixɨa mɨ'ane hepaɨtsita puyeha'arɨwe.   
\b  
\q1
\v 2 Mɨkayuwaɨriya teɨteri muwaparewienikɨ pɨka'inake meitimaitɨyeikanikɨ,  
\q2 pinake xeikɨa 'etsiwa kemɨtiuyemate mɨtikuxatani.   
\b  
\q1
\v 3 'Axamɨtiuka'iyari 'axapɨraxaxatsiwa xeikɨa,  
\q2 tewinɨarikaya xeikɨa hetsiena puxuawe.   
\b  
\q1
\v 4 Tewi mɨtimaiwe niukieya haramara 'amatiyewa 'emeukatewa hepaɨ kani'aneni,  
\q2 meta haa 'aki'utɨa muhane hepaɨ kani'aneni kemɨ'ane mɨtimaiwe.   
\b  
\q1
\v 5 'Aixɨa pɨka'ane xɨka hetsiena mɨrahɨiwa 'uxɨna,  
\q2 meta 'aixɨa pɨka'ane xɨka heitserie mexeiya hetsie pɨta rahɨiwani.   
\b  
\q1
\v 6 Mɨkayuwaɨriya teɨteri muwaparewienikɨ 'axa'anemekɨ xeikɨa putaniuka,  
\q2 yutetakɨ xeikɨa 'axaputaine mɨtamierienikɨ.   
\b  
\q1
\v 7 Tewi kenametimate mutaine mɨkɨ yuwiniyaritsie puyutahɨani,  
\q2 yutenikɨ kemɨtikuxata mɨkɨ yakɨ xeikɨa pɨrayani.   
\b  
\q1
\v 8 'Axaniuki witsikatini'eniɨriɨkɨni 'aixɨa ma'aneni hepaɨ,  
\q2 mɨkɨ rataɨta paitɨ kaniye'axeni.   
\b  
\q1
\v 9 Kemɨ'ane mɨyɨ'ɨraxie mɨkati'uximaya,  
\q2 kaniyutaxewireni xeime mɨraka'una hamatɨa.   
\b  
\q1
\v 10 Yawé kawi 'amutewi hepaɨ kani'aneni,  
\q2 hetsɨana mekaniutinanautsani heitseriemekɨ yamemɨtekahu memɨtawikweitsitɨarienikɨ.   
\b  
\q1
\v 11 Kiekari mɨtɨrɨkaɨye mukurarutɨarie hepaɨ katinimaika xiku tita waɨkawa mɨrexeiyakɨ,  
\q2 meta kuraru 'amatitɨtɨ mɨkayu'unanɨa hetsiena nunuwame kani'erieka kemɨrexeiyakɨ mɨxiku.   
\b  
\q1
\v 12 Muyuta'ɨre yukɨmana kaniyutaxɨtɨamɨkɨ,  
\q2 kemɨ'ane tixaɨtɨ mɨkarayuyeitɨa 'aixɨa tixeiyarietɨ kanayeitɨariemɨkɨ.   
\b  
\q1
\v 13 Mɨka'uka'iyari kaniyutewiyatsitɨmɨkɨ,  
\q2 xɨka 'aixɨa kati'enawetɨ waruta'eiya.   
\b  
\q1
\v 14 Yuwaɨriyatɨ kemɨtiuka'eniwa kananayewemɨkɨ mɨtikuye,  
\q2 ¿matsi kemɨ'aneta mukayuwaɨriya keranayeweni yuhiwerietɨ?   
\b  
\q1
\v 15 Kemɨ'ane mɨtiuyemate yu'iyaritsie katinimaiweni,  
\q2 memɨtemaiwawe mɨtiuyemaikakɨ mekanikuwaɨtɨweni.   
\b  
\q1
\v 16 'Imikierikɨ naitsarie kitenietsie katineuyepierikeni,  
\q2 meta yaxeikɨa teɨteri memɨmamariwawe yukitenietsie mepɨmeteheuyepirieni.   
\b  
\q1
\v 17 'Itsɨkame hɨxie kemɨ'ane matɨari mieme maniuka kename 'axakatiuyuri 'utaitɨ,  
\q2 peru hipatɨta mekani'axɨakuni memunenierixɨ yame'utiyuatɨ kename 'axatiuyuri.   
\b  
\q1
\v 18 Kakaɨyari 'imieri mayetɨrɨkaɨye kaneutiparitɨwani,  
\q2 'imatɨrieka pɨhekɨare kemɨ'ane heitserie mexeiya.   
\b  
\q1
\v 19 Matsi pukwaniwe ta'iwa temɨnɨtɨanikɨ keyuri kiekari naitsata heunatɨkaime,  
\q2 kepauka tewi mɨtiyuxaneta tepɨa 'itupari warita mutuika hepaɨ 'aneme kanexeiyani yu'iyaritsie.   
\b  
\q1
\v 20 Tewi pɨhɨne tita mɨtikuxatakɨ,  
\q2 meta putahuxarɨwa yatikuxatatɨ.   
\b  
\q1
\v 21 Neni tɨrɨkariya kanexeiyani tukari mɨrapitɨanikɨ meta mɨranawairienikɨ,  
\q2 'apepɨrapiniyarieni 'atenikɨ kepemutayɨ.   
\b  
\q1
\v 22 Kemɨ'ane yu'ɨya mukaxei temawierika kanikaxeiyamɨkɨ:  
\q2 Yawé 'inaki'erietɨ mɨtiyetuirikɨ.   
\b  
\q1
\v 23 Tixaɨtɨ mɨkarexeiya katiniku'iwawani,  
\q2 xikuta kanita'eiyamɨkɨ 'ihekatɨ.   
\b  
\q1
\v 24 Mekanixuaweni hipatɨ hamikutsixi 'axamɨraku'anetsie memumatsi'atɨanikɨ,  
\q2 hipatɨta hamikutsixi mekanixuaweni 'aixɨa mete'u'iyaritɨ keyuri 'a'iwa.   
\b  
\c 19  
\q1
\v 1 Matsi 'aixɨa pɨ'ane tixaɨtɨ karexeiyatɨ peru 'aixɨa tikamietɨ,  
\q2 keyuri kayuwaɨriyatɨ teɨteri muwaparewienikɨ meta 'axatiniukitɨ.   
\b  
\q1
\v 2 'Aixɨa pɨka'ane pekareutamaiwetɨ xɨka petiutsutɨani,  
\q2 kemɨ'ane muyutimexɨitɨani mɨkɨ puyutewinɨani.   
\b  
\q1
\v 3 Tewi mɨka'uka'iyarikɨ 'ayumieme yuhuye peuyehɨpa,  
\q2 meta Yawé hetsiemieme puyeha'awe.   
\b  
\q1
\v 4 Kemɨ'ane mɨxiku hamikumama mekaniyumɨireni,  
\q2 matsi kemɨ'ane tixaɨtɨ mɨkarexeiya hamikuya piku'eiri.   
\b  
\q1
\v 5 Kemɨ'ane 'uniereme muyuxata tiku'itawatɨ mɨkɨ katinika'enitsitɨariemɨkɨ,  
\q2 yaxeikɨata kemɨ'ane mɨti'itawa pɨkareuyehɨwiyarieni.   
\b  
\q1
\v 6 Xikutsixi waɨkawa hamikutsixi mekaniwareuxeiyani,  
\q2 yunaitɨ teɨteri mekaniwatemawikuni 'etsiwa 'imikierikɨ.   
\b  
\q1
\v 7 Kemɨ'ane tixaɨtɨ mɨkarexeiya 'iwamama mekanixani'erieka,  
\q2 matsiri hamikumamatɨtɨ mepɨkahenuku'erieni.  
\q1 Tsepanetɨ mɨwakuwaune memiparewienikɨ,  
\q2 hawaikɨ pɨkawarekaxeiya.   
\b  
\q1
\v 8 Kemɨ'ane timaitɨ 'amuyeika mɨkɨ yukɨmana yu'iyaritsie kaniyunaki'erieka,  
\q2 kemɨ'ane yuhetsie mɨtimaiwe 'aixɨa pɨtiyeyani.   
\b  
\q1
\v 9 Kemɨ'ane 'uniereme muyuxata tiku'itawatɨ mɨkɨ katinika'enitsitɨariemɨkɨ,  
\q2 kemɨ'aneta mɨti'itawa mɨkɨ kanika'unariemɨkɨ.   
\b  
\q1
\v 10 Mɨkayuwaɨriya hipame muwaparewienikɨ 'aixɨa pɨka'ane witsimɨtiuye'anetsie mayekanikɨ,  
\q2 meta 'aixɨa pɨka'ane waɨriyarika mɨti'uximaya te'aitamete memanuyetei mɨtiwata'aitɨanikɨ.   
\b  
\q1
\v 11 Mɨtimaiwe heitseriemekɨ yakatinikamieni katiniyukanenimayaka,  
\q2 matsi witsimɨtiuka'iyari kaninenimayaka kemɨ'ane 'axamiyuri.   
\b  
\q1
\v 12 Maye mahiwa hepaɨ kani'aneni ti'aitame haxɨaya,  
\q2 kepauka mɨkɨ muyutemawie 'ɨxa mɨhatuiyarie hepaɨ kani'aneni.   
\b  
\q1
\v 13 Temaikɨ 'axamɨtiuka'iyari yupaapa kanihiweritɨaka,  
\q2 'uka muwikie mayu'eriya haa mɨkatsuke hepaɨ yɨkɨna katini'uximatɨaka.   
\b  
\q1
\v 14 Kii meta tumini rapaapa katinaku'eiririemɨkɨ,  
\q2 'uka mɨtimaiwe Yawé 'imikierieya kɨnaya hetsiemieme kanihɨkɨtɨni.   
\b  
\q1
\v 15 Kemɨ'ane mɨyɨ'ɨraxie kwinimieme katinikuneni xeikɨa,  
\q2 meta kaniyehaakamɨneni.   
\b  
\q1
\v 16 Kemɨ'ane 'inɨari niukiyaritsie yamɨtikamie mɨkɨ yuhetsiemieme kaneye'atɨaka,  
\q2 matsi kemɨ'ane mitixani'erieni kanimɨmɨkɨ.   
\b  
\q1
\v 17 Tixaɨtɨ mɨkarexeiya xɨka tumini pe'umini Yawé pekaniniɨtɨaka.  
\q2 Mɨkɨ Yawé pumerakapitɨani 'aixɨa kepemɨtiuyurikɨ.   
\b  
\q1
\v 18 'Aniwe keneheitseritɨaka mexixi 'akuxi yu'ɨxatsitɨarinɨa,  
\q2 matsi pepɨka'iparewieka mɨmɨnikɨ peka'ita'ɨxatsitɨayu.   
\b  
\q1
\v 19 Kemɨ'ane mayu'eriya waɨkawa katinika'eniexɨamɨkɨ 'uximatɨarikakɨ,  
\q2 kemɨ'ane minɨtɨamɨkɨ matsi waɨkawa piyehaxɨatɨani.   
\b  
\q1
\v 20 Kemɨ'ane 'ɨxatsi mɨ'enie kaniyuwaɨriyani 'aixɨa mɨtitahɨawarienikɨ,  
\q2 matsi waɨkawa timaiwetɨ kanayeimɨkɨ.   
\b  
\q1
\v 21 Tewi waɨkawa puyu'iyaritɨa yu'iyaritsie yamɨtiyurienikɨ,  
\q2 matsi 'imatɨrieka Yawé kemɨtinake yapɨtiyɨni.   
\b  
\q1
\v 22 Yunaitɨ teɨteri mekanitakwewieka kemɨ'ane wa'enietɨ muwatanaki'erienikɨ,  
\q2 matsi 'aixɨa pɨ'ane tixaɨtɨ mɨkarexeiyani keyuri ti'itawatɨ.   
\b  
\q1
\v 23 Yawé 'ayemakatɨ xɨka 'uyeikani tukari kaniukaxeiyamɨkɨ,  
\q2 hamatɨana 'akaniuyeikamɨkɨ 'aixɨa 'iyari meta katiuka'eniwatɨ.   
\b  
\q1
\v 24 Mɨyu'ɨraxie xakɨtsie xeikɨa kaneukamemeni,  
\q2 matsi 'akuxi kaneiyehɨaka mɨramikiwanikɨ yuteta paitɨ.   
\b  
\q1
\v 25 Kemɨ'ane mɨtiyukatawe'erie ke'ukuweiyaxɨani, 'ana 'atsimɨkatimate kemɨreuyewetse yamɨtiyurienikɨ niereme yapɨretimani,  
\q2 kemɨ'ane mɨtiuyemate keneutaheitseritɨa 'ana tiuyemaitɨa kanayeimɨkɨ.   
\b  
\q1
\v 26 Kemɨ'ane yupaapa mɨtinawatsiriwa meta yumaama takwa paitɨ manuyehɨpa,  
\q2 mɨkɨ temaikɨ mɨka'uka'iyari meta mɨka'uyukatewiya kanihɨkɨtɨni.   
\b  
\q1
\v 27 Temaikɨ, xɨka ne'ɨkitsika peka'u'enieni,  
\q2 'ɨxatsi 'aixɨa mɨ'ane pekaniku'eirimɨkɨ.   
\b  
\q1
\v 28 Kemɨ'ane 'uniereme yuxatatɨ mɨtiku'itawa mɨkɨ tita mɨtiheitserie kaninanaimaka,  
\q2 'axatiyuruwame teta kanayeneikani tita 'axamɨti'ane xeikɨa.   
\b  
\q1
\v 29 'Iwaɨyɨ kaniha'aritsieka mɨtiuyukatawe'erie hetsiemieme,  
\q2 mɨkayuwaɨriya teɨteri muwaparewienikɨ kanikuweiyaxɨamɨkɨ.   
\b  
\c 20  
\q1
\v 1 Xɨka winu 'anu'ieni ka'uka'iyaritɨ payani,  
\q2 yaxeikɨa nawa xɨka 'anu'ieni teɨteri pɨwaxamurieni,  
\q2 xewitɨ 'ietɨ timaiweme hepaɨ pɨkatiku'eriwa.   
\b  
\q1
\v 2 Ti'aitame kepauka mɨha'a maye muyutahaxɨatɨwa hepaɨ kani'aneni,  
\q2 kemɨ'ane miyehaxɨatɨani tukarieya pukweriwa'aneni.   
\b  
\q1
\v 3 Kemɨ'ane haxɨa mɨnɨtɨawe 'aixɨa pɨrahɨawarɨwa,  
\q2 matsi 'axamɨtiyuriene yutemawietɨ pitsutsutɨwame.   
\b  
\q1
\v 4 Mɨyɨ'ɨraxie kepauka mɨkatakwietsana pɨkaka'eni,  
\q2 kepauka 'itsanaxa maye'ani pɨreuyehɨaka peru pɨkarexeiyani.   
\b  
\q1
\v 5 Tewi kemɨtiku'eriwa haa 'ameukateewa hepaɨ pɨ'ane,  
\q2 matsi kemɨ'ane mɨtimaiwe yapauka peitimaitɨyeika.   
\b  
\q1
\v 6 Yumɨiretɨ mɨpaɨ meputiyuane kename 'ahetsie metewiya,  
\q2 ¿kemɨ'ane pɨyɨwe tewi 'aixɨa mɨtiuka'iyari mɨtaxeiyakɨ yuri mɨti'eririekakɨ?   
\b  
\q1
\v 7 'Aixɨa katinixeiyarieka kemɨ'ane 'aixɨa 'anemekɨ 'amuyeika,  
\q2 Niwemama yupaapa hepaɨ meteyurietɨ 'aixɨa mekani'itɨarieka.   
\b  
\q1
\v 8 Kepauka ti'aitame yu'uwenitsie 'amayerɨni wataxanetake,  
\q2 mɨkɨ 'ana xeinieriyarikɨ tinaime 'axamɨti'ane katinaku'itiwani.   
\b  
\q1
\v 9 ¿Kemɨ'ane mɨpaɨ pɨtayɨni:  
\q2 «Ne'iyari kani'itiyaka 'axamɨti'ane katiniumaweni»?   
\b  
\q1
\v 10 Tiwɨwɨtɨwame 'axamɨ'ane meta 'inɨaritsie mɨtiyukwamana:  
\q2 mɨkɨ tihutame Yawé pɨtixani'erie.   
\b  
\q1
\v 11 'Ikɨ temaikɨ kemɨtiyuriene teɨteri yamepɨtemate,  
\q2 kemɨtiyuriene yemekɨ xɨka 'aixɨa ti'aneni yatɨ hawaikɨ.   
\b  
\q1
\v 12 Tanakatekɨ temeu'enanakɨ meta tahɨxitekɨ temeunenierenikɨ,  
\q2 mɨkɨ tihuhutame Yawé katiniutiwewieni.   
\b  
\q1
\v 13 Pekunetɨ xeikɨa tixaɨtɨ perexeiyatɨ pepɨka'ayani,  
\q2 matsi pɨta peti'uximayatɨ 'ikwai pekanexeiyakamɨkɨ 'anayuhayewame.   
\b  
\q1
\v 14 Tinaweme mɨpaɨ kanaineni: «Tixaɨtɨ pɨkatiyunaki'erie 'utaitɨ»,  
\q2 matsi 'arikeketa mɨpaɨ kanainemɨkɨ 'aixɨa pɨ'ane.   
\b  
\q1
\v 15 Huru waɨkawa kanixuaweni meta tetexi witsi'anenetɨ,  
\q2 matsi waɨkawa pɨraye'axe timaiweme 'ɨxatsieya kemanɨyɨne.   
\b  
\q1
\v 16 Xɨka xeime hetsiemieme pera'akatuani kemɨ'ane pemɨka'imatetsiemieme,  
\q2 tixaɨtɨ pepɨtitawawiyarieni pemɨtiyetuanikɨ 'akamixa 'emutsuye paitɨ pekaneuyehɨamɨkɨ.   
\b  
\q1
\v 17 Tewi mɨti'itawa witsira'anekame pɨtikwa'a xeime tiu'itaiyaka,  
\q2 matsi 'imatɨrieka mɨkɨ tewi kanitahɨnimɨkɨ xiekari 'axamɨ'ane tetana meutawiwieni hepaɨ.   
\b  
\q1
\v 18 Kepemɨti'a'ɨwiyanikɨ kene'enieka memɨtemaiwawe wa'ɨxatsika,  
\q2 matsi pemɨyɨwekaxɨanikɨ waɨkawa mɨrayukwitɨnetsie.   
\b  
\q1
\v 19 Kemɨ'ane niukiperai mɨhɨkɨ tinaime pɨraxatawe teɨteri memɨtehetimanikɨ,  
\q2 kemɨ'ane waɨkawa memutiniuka wahamatɨa pepɨka'axewiriyani.   
\b  
\q1
\v 20 Kemɨ'ane yupaapa yumaama wahepaɨtsita 'axamutaine,  
\q2 mɨkɨ kanimɨmɨkɨ yemekɨ yɨwipa kaniyuhayewakɨ.   
\b  
\q1
\v 21 Tita pemɨra'iwaxɨ pekati'uximayatɨ,  
\q2 'imatɨrieka temawierika pepɨkahexeiyani.   
\b  
\q1
\v 22 Hatsuaku mɨpaɨ pepɨkahaineni: «Yanepɨrekapitɨani mɨkɨ 'axamɨnetsi'uyurikɨ».  
\q2 Yawé yuri ketine'eririeka mɨkɨ pumatsiparewieni.   
\b  
\q1
\v 23 Yawé tiwɨwɨtɨwame 'axamɨ'anene meta 'inɨaritsie mɨtiyukwamana,  
\q2 mɨkɨ tihutame Yawé pɨtixani'erie.   
\b  
\q1
\v 24 Tewi kemɨtimie Yawé kaniwitɨximeni.  
\q2 ¿Tewi yukɨmana yuhuye keretimani?   
\b  
\q1
\v 25 Pukweriwa'ane xɨka Yawé hɨxie kename petiyetuani hetsɨana timieme pehaitɨ,  
\q2 matsi 'arikeke xɨka yapekatikayani kepemutayɨ 'aixɨa pɨka'ane.   
\b  
\q1
\v 26 Ti'aitame mɨtimaiwe tɨriku manuyexɨrɨwa hepaɨ pɨtiyuriene,  
\q2 mɨkɨ 'axateyuruwamete murinata hepaɨ kaniwareuyetɨxɨni.   
\b  
\q1
\v 27 Tewi 'iyarieya Yawé kɨxemeya kanihɨkɨtɨni,  
\q2 temɨtemaiwawenikɨ tahetsie ketemɨ'anene meta tataɨta.   
\b  
\q1
\v 28 Nenimayatsika meta tita yuri mɨraine ti'aitame kanitɨrɨkariyani,  
\q2 mɨkɨ tiyukanenimayatɨ xeikɨa yu'uwenitsie kanayeixani.   
\b  
\q1
\v 29 Temari witsikememɨteheu'erie mɨkɨ kaniwatɨrɨkariyatɨni,  
\q2 meta 'ukirawetsixi yamemɨtekahu mɨkɨ wamutuxaiya mɨixa wiyari memu'uwa kaniwa'inɨaritɨni.   
\b  
\q1
\v 30 'Iwaɨyɨ mɨtiyukukuine pu'uaye meta 'aixɨa kamaniyurimɨkɨ,  
\q2 xɨka pekuweiwani matsi 'aixɨa pekaniyɨmɨkɨ 'a'iyaritsie.   
\b  
\c 21  
\q1
\v 1 Ti'aitame 'iyarieya 'aki'utua haa muhane hepaɨ kani'aneni Yawé yatinɨ'akaku,  
\q2 'itanɨ'awakaku mɨkɨ hakewa meinake.   
\b  
\q1
\v 2 Yunaitɨ teɨteri 'aixɨa meteyuriekame mekaniyu'erieka,  
\q2 matsi Yawé pɨtatsixeiya ta'iyaritsie ketemɨteyuriku.   
\b  
\q1
\v 3 Kepauka teɨteri kemɨtiheitserie yamemɨteyurie,  
\q2 mɨkɨ Yawé pinake keyuri mawari.   
\b  
\q1
\v 4 Kemɨ'ane mɨtiyukatawe'erie yu'iyaritsie meta timaiweme muyu'erie,  
\q2 meta 'axateyuruwamete wahepaɨ xɨka tiyurieneni mɨkɨ 'axamɨti'ane pɨtihɨkɨ.   
\b  
\q1
\v 5 Kepauka 'aixɨa mɨtiuyu'iyaritɨani: 'aixɨa pɨtiyɨni,  
\q2 kepauka mexɨiwa mɨtiuyurieni: 'axapɨtiyɨni.   
\b  
\q1
\v 6 'Itarikakɨ xɨka tiukaxeiya waɨkawa  
\q2 pɨtiparike yapauka haiwitɨri hepaɨ peru pɨmɨya winiyari hepaɨ.   
\b  
\q1
\v 7 Memɨteyukananaima yɨkɨmana mekaniyuka'unakuni,  
\q2 memɨkayuwaɨriyakɨ heitseriemekɨ yamemɨteyuriekakɨ.   
\b  
\q1
\v 8 Kepauka tewi 'aixɨa mɨkatiuyeika huyeya tunitɨ payani,  
\q2 matsi kemɨ'ane heitseriemekɨ 'amuyeika huyeya kanixeuraɨyeni.   
\b  
\q1
\v 9 Matsi 'aixɨa kati'ane 'etsi'uyeyeukaku mayekani,  
\q2 keyuri kii 'apameta 'uka mayu'eriya hamatɨa.   
\b  
\q1
\v 10 'Axatiyuruwame 'axamɨti'anetsie xeikɨa kaniyu'iyaritɨaka,  
\q2 hatsuaku 'aixɨa tiyurienetɨ pɨka'ayani yuhepaɨ tewi hetsiemieme.   
\b  
\q1
\v 11 Kepauka 'axamɨtiuka'iyari mɨtika'enitɨarieni,  
\q2 'ana mɨtiyukatawe'erie yapɨretimani,  
\q1 kepauka mɨtimaiwe mɨ'ɨxatsitɨarie,  
\q2 'ana mɨkatimaiwe yapɨretimani.   
\b  
\q1
\v 12 Heitseriemekɨ yamɨtikamie 'axatiyuruwame kiiya kanixeiyani,  
\q2 meta kemɨtika'unarieni kanixeiyani.   
\b  
\q1
\v 13 Kemɨ'ane tixaɨtɨ mɨkarexeiya mɨka'enieni ra'iwawakaku,  
\q2 mɨkɨtatsiere yaxeikɨa petatsuani 'anari xewitɨ pɨka'ita'eiya.   
\b  
\q1
\v 14 'Awie 'imikieri xɨka pe'utuituarieni haxɨa kaninɨtɨaweni,  
\q2 'ana kwitɨwa pekaninɨtɨarieka kepemɨtiha'akai.   
\b  
\q1
\v 15 Tewi heitseriemekɨ yamɨtikamie pinake muyutemawieka kepauka hipatɨ hepaɨna memɨteyurie,  
\q2 matsi 'axatiyuruwame kanimaka xeikɨa.   
\b  
\q1
\v 16 Kemɨ'ane mɨtihayewa 'aixɨa tiyurienetɨ yuhuyeta,  
\q2 mɨkɨ yapauka mɨkite watsata kaniyuhayewamɨkɨ.   
\b  
\q1
\v 17 Kemɨ'ane 'ixɨarari minake tixaɨtɨ karexeiyatɨ payani:  
\q2 winu xeikɨa mɨnaki'eriekɨ meta witsimɨtiu'ɨatɨka mɨkɨ hatsuaku waɨkawa rexeiyatɨ pɨkahayani.   
\b  
\q1
\v 18 'Axamɨtiyuriene 'aixɨa mɨtiyuriene hetsiemieme katinayukatuamɨkɨ,  
\q2 tiyumiekame meta tinawayame mepɨtehayukatuani teɨteri 'aixɨa memɨte'u'iyari wahetsiemieme.   
\b  
\q1
\v 19 Matsi 'aixɨa pɨ'ane makumawetsie pemukani 'axaɨta,  
\q2 matsi 'aixɨa pɨka'ane 'uka mɨha'a meta mayu'eriya hamatɨa pemukanikɨ.   
\b  
\q1
\v 20 Timaiweme kiitana waɨkawa witsipɨtiuye'ɨa meta xikutɨriya pɨtihɨne,  
\q2 matsi mɨkayuwaɨriya muwaparewienikɨ hipame katinitsewiximaka.   
\b  
\q1
\v 21 Kemɨ'ane heitseriemekɨ yamɨtikamie meta mɨtiyukanaki'erie,  
\q2 mɨkɨ tukari kanikaxeiyamɨkɨ, 'aixɨa ti'aneme pɨtikaxeiya meta 'aixɨa pɨraxaxatsiwani.   
\b  
\q1
\v 22 Mɨtimaiwe memɨtɨrɨkawi wakiekaritsie kaniye'amɨkɨ kaniwara'iwamɨkɨ,  
\q2 meta wa'ixumeri kananuta'unaxɨamɨkɨ ka'uniweme mɨkɨ memɨ'eriekai.   
\b  
\q1
\v 23 Kemɨ'ane mɨyukweriwayurie kemɨtikuxatakɨ,  
\q2 mɨkɨ hatsuaku hipatɨ mepɨka'i'uximatɨani.   
\b  
\q1
\v 24 Mɨtiyukatawe'erie mɨkɨ puwatewiyatsitɨa hipame meta pɨtiyuyuriya,  
\q2 meta kemɨtiyuta'ɨrekɨ xeikɨa hipame 'axapuwayurie.   
\b  
\q1
\v 25 Mɨyu'ɨraxie hiwe'erikakɨ kanimɨmɨkɨ,  
\q2 mɨkati'uximayatamɨkɨkɨ,   
\q1
\v 26 tukarikɨ xeikɨa kanaka'iyuniwani tihiwe'erietɨ,  
\q2 matsi heitseriemekɨ yamɨtikamie katiniyetuaka 'iyarieya ya'anekaku tixaɨtɨ katiwakweririetɨ.   
\b  
\q1
\v 27 Yawé 'axateyuruwamete wamawari pɨxani'erie,  
\q2 meta tsiere kepauka 'axa'anemekɨ mawari memɨyetua mɨkɨ pɨxani'erie.   
\b  
\q1
\v 28 Kemɨ'ane 'uniereme muyuxata ti'itawatɨ mɨkɨ kanika'unariemɨkɨ,  
\q2 matsi kemɨ'ane yuri mɨtikuxata kemɨtiunierixɨ pupitɨarieni yamɨtayɨnikɨ kemɨtiunierixɨ.\f + \fr 21:28 \ft Yatɨni \fq kemɨ'ane mi'enie pukumaweriyarieni yuheyemekɨ. \f*   
\b  
\q1
\v 29 'Axamɨtiuka'iyari kemɨtiyuhɨawixɨ kename 'aixɨa 'ane putaine,  
\q2 matsi tewi heitseriemekɨ yamɨtikamie kemɨtiuyeikakɨ kaniyuti'eriexɨamɨkɨ.   
\b  
\q1
\v 30 Tewi kemɨtimaiwe Yawé hɨxie tixaɨtɨ pɨkatihɨkɨ,  
\q2 meta tiuyemaitɨ, 'ɨxatsitawetɨ tixaɨtɨ pɨkatihɨkɨ kemutaine.   
\b  
\q1
\v 31 Yukawayu kanikuha'aritɨwani kuyaxa 'imieriyari tukaritsie mieme,  
\q2 matsi kemɨ'aneta mɨrayu'iwa Yawé yatipitɨakaku pɨrayu'iwani.   
\b  
\c 22  
\q1
\v 1 Matsi 'aixɨa pɨ'ane pemumatiwanikɨ 'aixɨa petiuka'iyaritɨ,  
\q2 keyuri huru meta pɨrata waɨkawa pehexeiyatɨ xeikɨa.   
\b  
\q1
\v 2 Mɨxiku meta tixaɨtɨ mɨkarexeiya mɨkɨ yaxeikɨa mepɨ'anene,  
\q2 mɨkɨ yuhutame Yawé kaniwarutiwewieni.   
\b  
\q1
\v 3 Kemɨ'ane mɨtimaiwe 'axamɨti'ane katinixeiyani mɨkɨ 'ateewa puyeyeika,  
\q2 matsi mɨkatimaiwe mana kaniuyeyeikani 'ayumieme pɨtiuka'eniwa.   
\b  
\q1
\v 4 Tixaɨtɨ pekare'ayeitɨatɨ Yawé pe'ayemakatɨ mɨpaɨ pekatinipitɨariemɨkɨ,  
\q2 waɨkawa pepɨrexeiyani 'aixɨa pepɨrahɨawarɨwani meta tukari pepupitɨarieka.   
\b  
\q1
\v 5 'Axateyuruwamete wahuyeta xuya puxuawe meta winiyari,  
\q2 matsi kemɨ'ane yutukari mɨ'ɨwiya mana pɨka'uyeyani.   
\b  
\q1
\v 6 'Aniwe 'etsimuyumate kenekuxaxatɨwani huye 'aixɨa mɨ'ane,  
\q2 kepauka 'ukiratsi mayani hatsuaku pɨka'iku'eirieni.   
\b  
\q1
\v 7 Tixaɨtɨ mɨkarexeiya xiku katini'uximayatsiriwametɨni,  
\q2 waɨriyarika mekateniwa'uximayatsirieka memɨtewarapiniriekɨ.   
\b  
\q1
\v 8 Kemɨ'ane 'axa'anekamekɨ muka'etsa mɨkɨ 'axati'aneme katinika'itsanamɨkɨ,  
\q2 Yawé ha'atɨ yu'itsɨkɨ kanika'unamɨkɨ.   
\b  
\q1
\v 9 Kemɨ'ane mɨtiyukanenimaya mɨkɨta Kakaɨyari 'aixɨa kaniyuriekamɨkɨ,  
\q2 tixaɨtɨ memɨkatehexeiya mɨtiwamikwakɨ.   
\b  
\q1
\v 10 Keneuku'eiri kemɨ'ane mɨtiyukatawe'erie 'ana 'imieri pukumawere,  
\q2 'ana kayuwatɨ pɨtamare tierika meta tewiyarika.   
\b  
\q1
\v 11 Kemɨ'ane yu'iyaritsie mɨti'itiya mɨtinaki'erie mɨkɨ kanipitɨarieka 'aixɨa mɨti'anekɨ mɨtaniunikɨ,  
\q2 mɨkɨ ti'aitame kanihamikutani.   
\b  
\q1
\v 12 Yawé mɨtimaiwe pɨ'ɨwiya kemɨ'ane waɨkawa mɨtimate,  
\q2 matsi kemɨ'aneta mɨti'itawa niukieya kani'uxiwe'erieka.   
\b  
\q1
\v 13 Muyu'ɨraxie mɨpaɨ kaniutaineni: «Maye takwa peyeika,  
\q2 mana kaye'utɨa netsihetatsana».   
\b  
\q1
\v 14 'Uka hipatɨ memikumaɨwa tenieya mɨkɨ putsu 'emeukatewa hepaɨ kani'aneni,  
\q2 mɨkɨta muwa kaneukahɨiyamɨkɨ kemɨ'ane hamatɨana muyutaxewire Yawé 'ihekakaku.   
\b  
\q1
\v 15 'Axamɨtiuyurienikɨ yutemawietɨ temaikɨ hetsie kaniyekani,  
\q2 matsi kɨyekɨ kuweiwatɨ ti'ɨkitɨatɨarietɨ 'ana pɨretimani.   
\b  
\q1
\v 16 Xɨka tixaɨtɨ mɨkarexeiya petiunawatsirieni xiku pehayeimɨtɨ,  
\q2 xɨka waɨkawa 'imikieri xiku petikumikwani,  
\q2 matsi pɨta 'akɨmana tixaɨtɨ pekarexeiyatɨ pepa'ayeitɨwa.   
\ms1 Xeitewiyari heimana tamamata niukite memɨtemaiwawe kememutiyuane  
\mr (Temai 22:17—24:22)  
\q1
\v 17 Memɨtemaiwawe waniuki kene'enieka yemekɨ kememutiyuane,  
\q2 'a'iyaritsie 'aixɨa ketineu'ahɨawi kenematikɨhɨawe ne'ɨkitɨarikatsie.   
\q1
\v 18 Matsi 'aixɨa kani'aneni pemeixeiyani 'ataɨta paitɨ ne'ɨkitsika,  
\q2 meta pe'ikuxatatɨ witsi'anemekɨ.   
\q1
\v 19 Yawé hetsie yuri ketine'eririeka,  
\q2 'ekɨ nekamatiniuta'ɨkitɨani 'ikɨ tukaritsie.   
\q1
\v 20 Ne nematsi'uti'utɨiri xeitewiyari heimana tamamata xatsikayari,  
\q2 mana niuki kanayehuni temaiwawemete wa'ɨxatsi.   
\q1
\v 21 'Ikɨ niuki yuri maitɨka kametinita'ɨkiatɨamɨkɨ pe'ihiwe'eriekaku,  
\q2 kɨmana 'aixɨa pemɨtiwata'eiyakɨ kemɨ'ane memetsita'iwawiya.   
\s2 Xewi  
\q1
\v 22 Tixaɨtɨ mɨkarexeiya pepɨkananaimaka, mɨkɨ tixaɨtɨ mɨkarexeiyakɨ,  
\q2 meta 'itsɨkate wahetsɨa pepɨkawaxanetani mɨkɨ parewiya mekaneuyehɨaka.   
\q1
\v 23 Yawé tixaɨtɨ mɨkarexeiya hetsie kanitanuamɨkɨ,  
\q2 kemɨ'ane naime mɨtinawairieni mɨkɨta naime pɨtinawaiyarieni.   
\s2 Huta  
\q1
\v 24 Teɨteri memɨteyukananaima pepɨkawahamikutaneni,  
\q2 meta memayu'eririya wahamatɨa pepɨka'uyeikani,   
\q1
\v 25 nɨka ke'axamemɨteyurikɨ pewaruta'ɨke,  
\q2 'ekɨta nɨka winiyaritsie wahepaɨ pe'ahɨani.   
\s2 Haika  
\q1
\v 26 Mɨrapine hetsiemieme pepɨkare'akatuayani,  
\q2 meta pepɨkarapika xeime hetsiemieme,   
\q1
\v 27 'ekɨ xɨka peka'iyemanani ketitakɨ pemɨrekapitɨani,  
\q2 pekaninawaiyariemɨkɨ naime 'ahupume.   
\s2 Nauka  
\q1
\v 28 Pepɨka'ikupatani kwie 'inɨariyari meripaitɨ mieme,  
\q2 kememɨte'u'inɨaritaxɨ tatutsima meripaitɨ miemetexi.   
\s2 'Auxɨwi  
\q1
\v 29 ¿Tewi xeime yemekɨ 'aixɨa mɨtiu'uximayata petixexeiya?  
\q2 Mɨkɨ te'aitamete wahetsɨa pɨti'uximayaka,  
\q2 teɨteri memɨkamatiwa wahetsɨa pɨkati'uximayaka.   
\c 23  
\s2 'Ataxewi  
\q1
\v 1 Kepauka ti'aitame hetsɨa pemɨtikwani,  
\q2 kwiyemekɨ keneu'a'ɨwiya ketita 'ahɨxie mɨrapine.   
\q1
\v 2 Xɨka kwinimieme peti'akwaiwieka,  
\q2 yapauka pepɨkatikwaka.   
\q1
\v 3 'Ikwaiya witsimɨ'ane pepɨkahiwe'erieka,  
\q2 matsi mɨkɨ 'ikwai kwamanarika kanihɨkɨtɨni.   
\s2 'Atahuta  
\q1
\v 4 Pepɨkati'a'uxitɨaka xiku pemayanikɨ,  
\q2 kwinimieme pepɨkatihiwe'erieka.   
\q1
\v 5 ¿Kamɨtsɨ pemixeiya petiyɨwe?, matsi pumawe.  
\q2 Wa'atɨ wa'anate manexɨani hepaɨ mekani'aneneni,  
\q2 mɨkɨ mekananɨwɨxɨakuni xeikɨa kwixɨri wahepaɨ.   
\s2 'Atahaika  
\q1
\v 6 Mexa 'aurie pepɨka'utiyeixani xeime tewi mɨtiukakwerie hamatɨa,  
\q2 meta 'ikwaiya witsimɨ'anene pepɨkahiwe'erieka,   
\q2
\v 7 mɨkɨ kanihɨkɨtɨni 'axatiyukɨhɨawetɨ mumatsi'inie,  
\q1 mɨpaɨ kanitayɨmɨkɨ «ketinekwaka ketine'ieka»,  
\q2 matsi 'iyarieya yaka'anekaku pumatikɨhɨawe.   
\q1
\v 8 Naime pekatinanatihayamɨkɨ ketita pemɨtiutikwai,  
\q2 'ekɨ kepemɨtitixatɨa tixaɨtɨ pɨkarayani hetsienamieme.   
\s2 'Atanauka  
\q1
\v 9 Mɨkayuwaɨriya muwaparewienikɨ hipame pɨkaheuyewetse pemi'ɨxatsitɨaka,  
\q2 'anari mɨkɨ matsiyuriyatɨ kanayeimɨkɨ tsepa 'ɨxatsi pemikuxaxatɨwa.   
\s2 Tamamata  
\q1
\v 10 Pepɨka'ikupatani kwie 'inɨariyari meripaitɨ miemete kemɨtiu'inɨatsie,  
\q2 tɨɨri nutuite wakwie pepɨkawanawairieka,   
\q1
\v 11 matsi waɨkawa kanitɨrɨkaɨyeni wahetsie nunuwame,  
\q2 mɨkɨ wahetsie kanitanuamɨkɨ pemɨkawatsewiximanikɨ.   
\s2 Tamamata heimana xewi  
\q1
\v 12 'Aixɨa ketineu'ena 'a'iyaritsie meta kepemɨti'ɨkitɨarie,  
\q2 'ana pemɨtimaiwenikɨ naime yapepɨretimani.   
\s2 Tamamata heimana huta  
\q1
\v 13 Temaikɨ peheitseritɨatɨ pepɨka'ihayewani,  
\q2 tsepa pemikuwaxɨa mɨkɨkɨ pɨkamɨni.   
\q1
\v 14 Matsi yaperehɨawetɨ keneukuwaxɨa,  
\q2 mɨkɨ mɨpaɨ katiniyutawikweitsitɨamɨkɨ mɨkite watsata.   
\s2 Tamamata heimana haika  
\q1
\v 15 Neuxei temaikɨ xɨka petimaiwetɨ 'a'iyaritsie pe'ayani,  
\q2 neta ne'iyaritsie neyutemawietɨ nekanayeimɨkɨ.   
\q1
\v 16 Yaxeikɨa waɨkawa netaɨta paitɨ nekaninetemawiekamɨkɨ,  
\q2 kepauka 'akɨmana 'aixɨa pemɨtikuxata kemɨreuyewetse.   
\s2 Tamamata heimana nauka  
\q1
\v 17 'A'iyaritsie pepɨkatihiwe'erieka 'axateyuruwamete waɨkawa kememɨteheuxeiya,  
\q2 matsi pɨta Yawé pe'ayemakatɨ meta pe'akwerietɨ yaketinekamieni yuheyemekɨ.   
\q1
\v 18 Mɨpaɨ peti'atemawietɨ pe'ukiratsitɨtɨ pepɨmɨni,  
\q2 titakɨ pemɨtita'ikwewa mɨkɨ hatsuaku pɨkaka'unarieni.   
\s2 Tamamata heimana 'auxɨwi  
\q1
\v 19 Temaikɨ, kenene'enieka meta waɨkawa ketinemaiweni,  
\q2 'ahuyeta heitseriemekɨ keneumieni 'aixɨa petiyurienetɨ.   
\q1
\v 20 Kwinimieme memɨteyu'iwawie wahamatɨa pepɨka'uyeikani,  
\q2 meta kwinimieme memɨteyukwaiwawie wahamatɨa,   
\q1
\v 21 kwinimieme memɨteyu'iwawie meta kwinimieme memɨteyukwaiwawie mɨkɨ tixaɨtɨ mekatehexeiyatɨ mepakɨne,  
\q2 memɨyɨ'ɨraraxiekɨ 'ixuriki tsatsanime mepanakatɨxɨani.   
\s2 Tamamata heimana 'ataxewi  
\q1
\v 22 Kene'enieka 'apaapa mumatsi'ayexei,  
\q2 'amaama pepɨka'uxieka kepauka waɨkawa mɨtseɨyeni yuwaiyaritsie.   
\q1
\v 23 Tita mɨtiyuri meta mɨtimaiwenikɨ mɨ'ayumieme 'ahetsie keneupitɨa,  
\q2 meta pemɨheitseritɨariekakɨ meta pemeitimaitɨyeikanikɨ,  
\q2 meta pepɨka'itsewiximaka.   
\q1
\v 24 Temaikɨ yamɨtikamie yupaapa waɨkawa kanitemawieritɨaka,  
\q2 meta kemɨ'ane yuniwe timaiweme mexeiya kaniyutemawieka.   
\q1
\v 25 Mekeyutemamawieka 'apaapa meta 'amaama,  
\q2 mɨkɨ mematsi'utinuiwitɨakɨ.   
\s2 Tamamata heimana 'atahuta  
\q1
\v 26 Temaikɨ, yakenetineutahɨawi 'aixɨa peti'akɨhɨawetɨ 'a'iyaritsie pemumienikɨ,  
\q2 nehuyeta keneumieni pepɨkaheuyewautseni.   
\q1
\v 27 Karikɨ 'uka tuminikɨ mɨyuwitɨnɨa putsu 'emeukatewa kanihɨkɨtɨni,  
\q2 meta 'uka mɨka'a'ɨya putsu 'amuwakuyewa kanihɨkɨtɨni.   
\q1
\v 28 Mɨkɨ 'uka 'ukitsi muwahupie tinawayame hepaɨ kaniyɨaneni,  
\q2 mɨkɨ 'ukitsi yɨ'ɨitama wahetsie memɨkatewiyanikɨ xeikɨa puwakuwaune.   
\s2 Tamamata heimana 'atahaika  
\q1
\v 29 ¿Kemɨ'ane pɨwahetsiemieme hiwerika?  
\q2 ¿Kemɨ'ane mepɨte'uka'eniwani?  
\q2 ¿Kemɨ'ane pɨwahetsiemieme 'imieri?  
\q2 ¿Kemɨ'aneta niukixiya pɨwahetsiemieme?  
\q2 ¿Kemɨ'aneta yakɨ xeikɨa mepɨte'uka'eniwani?  
\q2 ¿Kemɨ'aneta puwahetsiemieme hɨxite mukuyuyuawi?   
\q1
\v 30 Kemɨ'ane puteyu winu mayema mɨka'utatuaya,  
\q2 meta kemɨ'ane mɨkatihayewa hehekwame manu'ienikɨ.   
\q1
\v 31 Pepɨka'aku'ɨwiyani winu kemɨ'anekɨ,  
\q2 meta tekɨxita yematɨ kemɨtiumerɨkakɨ,  
\q2 meta tsepa witsikemukɨ'ɨare,   
\q1
\v 32 karikɨ mɨkɨ kuu mayu'eriya mɨrakeni hepaɨ kani'aneni,  
\q2 'imatɨrieka mɨrakenitsie kukuiniyakɨ katinamiemɨkɨ.   
\q1
\v 33 'Ahɨxitekɨ yɨkɨ ti'aneneme pepɨtixeiya,  
\q2 'anari 'axapetiyukɨhɨawetɨ pekanayeimɨkɨ.   
\q1
\v 34 Haramara hixɨapa muhauxime hepaɨ pepɨti'amaika,  
\q2 meta kanuwa nɨ'awame hepaɨ pepɨyɨaneni peheuyuyehɨatɨ.   
\q1
\v 35 Mɨpaɨ peputaineni: «Nepeutiweiyaxɨa, matsi pɨkanetsihekwinixɨ,  
\q2 Nekaneutiweiyaxɨani, matsi pɨkanetsi'ukukuine.  
\q1 Kepauka pemanutaniere mɨpaɨ pepɨti'erieni, tawarita nepikuwauni 'etsiwa nemenu'ienikɨ».   
\c 24  
\s2 Tamamata heimana 'atanauka  
\q1
\v 1 'Axateyuruwamete kememɨteyurie meta tita memɨtehexeiya pepɨkatihiwe'erieka,  
\q2 meta pemuwanɨkakɨ pepɨkakuwauneni,   
\q1
\v 2 mɨkɨ meteyukananaimatɨ xeikɨa mekaniu'uwani,  
\q2 meta hipame 'uximatɨarika memuwapitɨanikɨ xeikɨa mekatenikuxatani.   
\s2 Xeitewiyari  
\q1
\v 3 Waɨkawa rakumaitɨ pɨyɨwe kii mutsutɨani,  
\q2 kepemɨtiuyematekɨ kii tenarieya peputsutɨani.   
\q1
\v 4 'Aixɨa perakumaitɨ 'akiita pepɨtitahɨniya,  
\q2 witsimɨti'anenekɨ meta waɨkawa mɨraye'atɨkakɨ.   
\s2 Xeitewiyari heimana xewi  
\q1
\v 5 Tewi mɨtimaiwe waɨkawa kanitɨrɨkaɨyeni,  
\q2 meta kemɨ'ane meu'ena matsi waɨkawa tɨrɨkaɨyetɨ payeixime.   
\q1
\v 6 Kepauka pemɨ'atamieni kaneuyeweka pemɨ'atimaixɨanikɨ,  
\q2 meta pemɨra'a'iwanikɨ yumɨireme wa'ɨxatsi keneu'eni.   
\s2 Xeitewiyari heimana huta  
\q1
\v 7 Xewitɨ tewi 'axamutiyuriene yutemawietɨ hatsuaku timaiwetɨ pɨka'ayani,  
\q2 meta teɨteri wahɨxie 'aixɨa mɨtayɨni pɨkayɨwe.   
\s2 Xeitewiyari heimana haika  
\q1
\v 8 Kemɨ'ane 'axatiyurimɨtɨ muyuha'aritɨa,  
\q2 mɨkɨ 'axatiyuruwame katiniterɨwariemɨkɨ.   
\q1
\v 9 'Axamɨtiyuriene yutemawietɨ kemɨtiku'eriwa 'axamɨti'ane kanihɨkɨtɨni,  
\q2 teɨteri memɨteyukatawe'erie mekaniwaxani'erieka.   
\s2 Xeitewiyari heimana nauka  
\q1
\v 10 Kepauka pemu'uximatɨarietsie pemɨkayuwaɨriya,  
\q2 'ekɨ pepumatsiɨkɨ pemɨkatɨrɨkaɨyekɨ.   
\s2 Xeitewiyari heimana 'auxɨwi  
\q1
\v 11 Keniwarutawikweitsitɨa kemɨ'ane memɨkwini yuheyemekɨ,  
\q2 keniwarukunuitɨa kemɨ'ane memɨte'uka'eniwa mekwiximetɨ.   
\q1
\v 12 Tsepa mɨpaɨ pemutaine, «Ne 'atsinepɨkatimaikai»,  
\q2 Kakaɨyari hɨrixɨa pɨtimaikai 'a'iyari kemɨtiyukɨhɨawekai.  
\q1 Meta 'atukari mɨ'ɨwiya yapɨtimate,  
\q2 mɨkɨ tewi 'akatinapiniyariemɨkɨ kemɨtiu'uximayataxɨ.   
\s2 Xeitewiyari heimana 'ataxewi  
\q1
\v 13 Xiete kenanu'i, 'ekɨ temaikɨ nemɨmatsinaki'erie, mɨkɨ 'aixɨa kana'aneni,  
\q2 yemekɨ witsikatinakakani 'anenitsie xietexi waxieteyari.   
\q1
\v 14 Mɨpaɨta katinakakani xɨka waɨkawa petimaiweni 'a'iyaritsie,  
\q2 heitseriemekɨ xɨka yapetikamieni Kakaɨyari pɨmatsiparewieka,  
\q2 tita pemɨtitakwewie mɨkɨ hatsuaku pɨkaka'unarieni.   
\s2 Xeitewiyari heimana 'atahuta  
\q1
\v 15 Heitseriemekɨ yamɨtikamie kie pepɨkahupaneni 'axatiyuruwame hepaɨ,  
\q2 meta kiitana pepɨkatinanaimaka.   
\q1
\v 16 Tewi heitseriemekɨ yamɨtikamie tsepa 'atahutamexɨa mekawe,  
\q2 mɨkɨ kananukukemɨkɨ,  
\q1 matsi 'axateyuruwamete mekanekaxɨrɨweni,  
\q2 matsi hatsuaku tawari mepɨka'anuku'uni.   
\s2 Xeitewiyari heimana 'atahaika  
\q1
\v 17 Kemɨ'ane metsi'aye'unie kepauka mekawenitsie pepɨka'atemawieka,  
\q2 meta pepɨka'atemawieka 'a'iyaritsie mɨkɨ mɨtiuka'eniwakɨ.   
\q1
\v 18 Yawé mɨkɨ pɨka'inakire 'ekɨ kepemɨtiku'eriwa,  
\q2 hikɨ mɨkɨ hepaɨtsita Yawé kemɨtiha'akai pɨtihayewa.   
\s2 Xeitewiyari heimana 'atanauka  
\q1
\v 19 'Axateyuruwamete wahepaɨtsita pepɨka'uyeha'arɨweni,  
\q2 meta pepɨka'awaɨriyani pemuwa'ɨkenikɨ yamemɨkatekahu,   
\q1
\v 20 matsi 'axatiyuruwame tixaɨtɨ pɨkatitakwewie,  
\q2 kemɨ'ane yamɨkatikamie kɨxemeya kanitɨmɨkɨ.   
\s2 Xeitewiyari heimana tamamata  
\q1
\v 21 Temaikɨ, Yawé kenayemakaxeni meta yaketinekamieni ti'aitame hetsiemieme,  
\q2 Yawé memu'uxie wahamatɨa pepɨka'axewiriyani,   
\q1
\v 22 yapauka xekatenika'eniexɨakuni,  
\q2 'atsipɨkatimatsiɨkɨ tita 'umuramie.   
\ms1 Tawarita kememutiyua temaiwawemete  
\p
\v 23 'Ikɨ kanihɨkɨtɨnita tawarita kememutiyua temaiwawemete:  
\q1 'Aixɨa pɨka'ane hipame xeikɨa waparewietɨ kepauka 'iwaurika muwewienitsie.   
\b  
\q1
\v 24 'Axamɨtiuyuri xɨka hetsiena karahɨiyani kename 'atsikatiuyuri,  
\q2 'ana yunaitɨ nuiwarite hetsienamieme 'axameputiyuaneni mɨkɨ 'itsɨkame hepaɨtsita meta mekaniti'uxiwe'erikuni.   
\q1
\v 25 Kemɨ'ane heitseriemekɨ mɨti'aita mɨkɨ 'aixɨa pɨtixeiyarieni,  
\q2 'axatiyuruwame hetsie mɨrahɨakɨ 'ayumieme pɨnaki'eriwa.   
\b  
\q1
\v 26 Kemɨ'ane 'aixɨa mɨtikuxata yuri mutaine,  
\q2 mɨkɨ witsikani'aneni 'itsiya hepaɨ.   
\b  
\q1
\v 27 'Awaxa meri keneukuha'arita,  
\q2 meta 'aixɨa ketinakuyuri pemaku'etsatsie,  
\q2 mɨpaɨ meri petiyurieme 'arikeketa 'akii pepɨtawewieni.   
\q1
\v 28 Peti'itawatɨ 'ahepaɨ tewi hepaɨtsita pepɨkatikuxatani 'itsɨkame hɨxie,  
\q2 pepɨkatiku'itawani 'atenikɨ.   
\q1
\v 29 Mɨpaɨ pepɨkahaineni: «Kemɨnetsi'uyuri mɨkɨ,  
\q2 neta yaxeikɨa nekatinekapitɨamɨkɨ».   
\b  
\q1
\v 30 Mɨyu'ɨraxie mati'etsatsie nekaniuyeyani,  
\q2 meta 'atsimɨkatimate kaxie ma'iteɨritsie 'aurie nekaniuyeyani.   
\q1
\v 31 Xuya xeikɨa naitsarie kananaye'ukaitɨni,  
\q2 meta tupiriya 'etsiya xeikɨa kananukanakaitɨni,  
\q2 tetexi kuraruyari petaxɨriyatɨkatei xeikɨa.   
\q1
\v 32 Kenemɨrenierixɨ ne'iyaritsie nepika'ɨnaxɨ,  
\q2 netixeiyatɨ mɨpaɨ nepɨretima:   
\q1
\v 33 'etsiwa peheukukutsɨtɨ,  
\q2 meta 'etsiwa pe'uka'uxipiwetɨ, meta 'atapa pe'awietɨ,   
\q1
\v 34 tixaɨtɨ pekarexeiyatɨ pepayani tiyumemiwame 'ahetsɨa munuani hepaɨ pɨtiyɨni,  
\q2 meta pereuyehɨatɨ tinawayame 'ixipara 'akwetɨ 'ahetsɨa munuani hepaɨ pumatiyurieni.   
\c 25  
\ms1 Tsarumuni matsi waɨkawa kemɨtimaiwekai  
\p
\v 1 'Ikɨta hipatɨ tawari temaiwawemete kememɨte'ɨ'ɨxatsita kanihɨkɨtɨni Tsarumuni meka'utɨa, 'Etsekiyaxi Kura kwieyaritsie ti'aitame, te'utɨwametemama kememɨteheka'ɨkixɨ.   
\q1
\v 2 Kakaɨyari 'aixɨa kerahɨawarɨwani tixaɨtɨ mɨti'awietakɨ,  
\q2 matsi witsimepɨ'itɨarie te'aitamete kepauka memikaxexeiya.   
\b  
\q1
\v 3 Te'aitamete kememɨteku'eriwa yu'iyaritsie 'atsitepɨkatemate,  
\q2 yaxeikɨa tepɨkatemate muyuawi kemeutitewa meta kwieta kemeukatewa.   
\b  
\q1
\v 4 'Axamɨ'ane pɨrata hetsie keneuka'iti,  
\q2 mɨkɨtsie payeneni tepɨakɨ tiwewiwame mɨtitiwewienikɨ.   
\q1
\v 5 'Axamɨtiyuriene ti'aitame hetsɨa keneupata,  
\q2 'ana ti'aitame yu'uweni heitseriemekɨ mɨti'aitanikɨ payeitɨani.   
\b  
\q1
\v 6 Ti'aitame hɨxie mariweme pepɨka'ayuyeitɨwani,  
\q2 meta kwinimieme pepɨka'utaineni 'ahetsiemieme.   
\q1
\v 7 Matsi pɨta 'aixɨa pɨyɨni ti'aitame xɨka mɨpaɨ metiutahɨawe: «'Ena 'ahurawa kenatiye'a»,  
\q2 teɨteri memumariwawe wahɨxie pepɨka'atewiyatsitɨaka.  
\b  
\q1 Tita pemɨtiuxei 'ahɨxitekɨ,   
\q2
\v 8 yapauka pepɨkatihekɨatani mɨrewatixanetsiwatsie,  
\q1 nɨka 'ahepaɨ tewi,  
\q2 yɨkɨ 'utayɨme metsi'utewiyatsitɨani.   
\b  
\q1
\v 9 'Ahepaɨ tewi hepaɨtsita 'aixɨa keneu'ayuri ke'axapemutayɨkɨ,  
\q2 meta xeime 'awie mɨpaɨ pepɨkarahɨaweni mɨkɨ 'axakemɨtiuyurikɨ.   
\q1
\v 10 Kapa xewitɨ metsi'u'enieme metsi'utewiyatsitɨani,  
\q2 'anari 'aixɨa pepɨkarahɨawarɨwani.   
\b  
\q1
\v 11 Huru manitsana pɨrata tsikɨiwitiyaritsie mɨyetei hepaɨ kani'aneni,  
\q2 niuki witsimɨ'ane mɨpaɨ kani'aneni xɨka 'aixɨa tiuxatsieni.   
\b  
\q1
\v 12 Hanira meta kuka tɨwame hurukɨ muwewiya hepaɨ kani'aneni,  
\q2 timaiweme matsi'utatieyu xɨka yemekɨ pe'i'enieni.   
\b  
\q1
\v 13 Nɨ'ariekame mɨraye'atɨwa 'aixɨa 'anemekɨ kaniwaxeripitɨaka 'ɨwi hepaɨ kepauka muxɨkanitsie,  
\q2 yukutsiyari puwaɨririe muyuwaɨriyanikɨ.   
\b  
\q1
\v 14 Haiwitɨri meta 'eka wiyeri mɨkakaxɨrɨwa hepaɨ,  
\q2 mɨpaɨ tewi kani'aneni kwinimime mutaine yakatikamietɨ.   
\b  
\q1
\v 15 'A'inɨkai pe'ikɨhɨawetɨ kemɨ'ane kwiepa mɨti'aita kemɨtiku'eriwa pepipata,  
\q2 meta petiu'akanaki'erietɨ petikuxatɨtɨ waɨkawa katinikemaka.   
\b  
\q1
\v 16 Xɨka xiete pe'ukaxeiya, kwinimieme pepɨkatikukwa'ani,  
\q2 nɨkahɨrixɨa waɨkawa pehenu'ieyu pe'utihayani.   
\b  
\q1
\v 17 'Ahepaɨ tewi kie yapepɨkatiyaneni,  
\q2 kapa 'utiwaɨripieme metsi'utixani'erieni.   
\b  
\q1
\v 18 Kemɨ'ane 'itsɨkame hɨxie mɨtikuxata ti'itawatɨ yuhepaɨ tewi hepaɨtsita,  
\q2 mɨkɨ 'ixipara meta titsuname meta 'ɨrɨ manuyemɨtsɨ hepaɨ kani'aneni.   
\b  
\q1
\v 19 Kepauka pemɨ'uximatɨariekatsie xɨka yuri peti'erieka tewi tiyukwamaname hetsie,  
\q2 tamé kɨmietɨ kemɨtiyukukuine meta ra'ɨka 'anumuritɨ mɨpaɨ pepɨti'amaika.   
\b  
\q1
\v 20 Xɨka muyuhiwerie hetsiemieme 'utakwika,  
\q2 winu matsina haiyatsie meuwirieni hepaɨ kani'aneni,  
\q2 yatɨni mawetɨ muyeikani hepaɨ kani'aneni kepauka muhaɨtɨnitsie.   
\b  
\q1
\v 21 Mumatsi'aye'unie xɨka yehaakamɨneni ketineumikwa,  
\q2 meta xɨka heuharimɨkɨni keneuharitɨa.   
\q1
\v 22 Mɨpaɨ petiyurienetɨ pekanitewiyatsitɨamɨkɨ ke'axamɨtiuyuri hepaɨtsita,  
\q2 'ana Yawé kametiniyetuiriemɨkɨ 'a'iwarika.   
\b  
\q1
\v 23 Tayetatsie 'eka mayeneika wiyeri kani'atɨwani,  
\q2 yutenikɨ 'axamemutiyuane teɨteri xeikɨa mekaniwahaxɨatɨaka.   
\b  
\q1
\v 24 Matsi 'aixɨa kani'aneni 'etsi'uyeukaku pemayekani,  
\q2 keyuri kii 'apameta 'uka mayu'eriya hamatɨa.   
\b  
\q1
\v 25 Haa haɨtɨme yɨkɨipitsie 'anatiwakitɨ manuhareni hepaɨ,  
\q2 kani'aneni niuki 'aixɨa manuyɨne 'ateewa paitɨ mieme.   
\b  
\q1
\v 26 Haixa muwaikarie meta haa putsuta mieme mu'uayemarie,  
\q2 hepaɨ kaniyɨmɨkɨ tewi heitseriemekɨ 'amuyeika kepauka 'axamɨtiuka'iyari mitaweranariyatsie.   
\b  
\q1
\v 27 Pɨkayɨwe waɨkawa xiete mɨkwaka,  
\q2 meta 'aixɨa pɨka'ane 'aixɨa pemɨrahɨawarɨwanikɨ pemɨtikuwaɨneni.   
\b  
\q1
\v 28 Kiekari muka'unarie kakurarutɨiyarietɨ,  
\q2 tewi yu'iyaritsie mɨpaɨ kani'aneni yukɨmana mɨkatiyu'aitɨawekɨ.   
\b  
\c 26  
\q1
\v 1 'Ɨwi taxarixa pɨkamieme,  
\q2 meta witari 'itsanaxa pɨkamieme,  
\q2 meta 'aixɨa pɨka'ane mɨkayuwaɨriya hipame muwaparewienikɨ hepaɨtsita 'aixɨa mɨraniuwani.   
\b  
\q1
\v 2 Wiiki mukuwiene xeikɨa yatɨni 'itsitame yu'itɨa mɨkahexeiya hepaɨ,  
\q2 mɨpaɨ kani'aneni tewi 'axamɨ'itɨarienikɨ yamɨtiutawawie matsi hetsiena pɨkaye'ani.   
\b  
\q1
\v 3 Kwitaxi kawayutsixi wawayame kanihɨkɨtɨni,  
\q2 meta pirenu puxu hetsiemieme kanihɨkɨtɨni,  
\q2 yaxeikɨata mɨkayuwaɨriya hipame muwaparewienikɨ kaneuyeweka mukuweiyaxɨanikɨ.   
\b  
\q1
\v 4 'Axamɨtiyuriene yutemawietɨ kemɨtiuniuka mɨpaɨ pepɨkatiku'eiyani,  
\q2 kapa 'ekɨta hepaɨna petiyurienetɨ pe'ayani.   
\b  
\q1
\v 5 Tewi mɨkayuwaɨriya muwaparewienikɨ hipame keneuta'eiya kemɨreuyewetse,  
\q2 yɨkɨmana waɨkawa timaiweme mɨkayu'eriekakɨ.   
\b  
\q1
\v 6 Mɨkayuwaɨriya hipame muwaparewienikɨ nɨ'ari pexɨka'ayeituani,  
\q2 yɨ'ɨkatsie yuxiteka mɨtiukakukuineni hepaɨ 'anetɨ payani.   
\b  
\q1
\v 7 Tewi mɨkayuwaɨriya hipame muwaparewienikɨ 'ɨxatsieya tixaɨtɨ pɨkatiyunaki'erie,  
\q2 mɨka'uyeiwe 'ɨkateya tixaɨtɨ mɨkatiyunaki'erie hepaɨ kani'aneni.   
\b  
\q1
\v 8 Mɨkayuwaɨriya hipame muwaparewienikɨ 'aixɨa mɨrahɨaweni tixɨatɨ pɨkatihɨkɨ,  
\q2 tete texɨpametsie 'atatɨarietɨ mehɨiyani hepaɨ katinimatsiɨkɨni.   
\b  
\q1
\v 9 Mɨkayuwaɨriya hipame muwaparewienikɨ kemɨtikuxata,  
\q2 tawekame xuya mamayatsie mutatseni hepaɨ kani'aneni.   
\b  
\q1
\v 10 Tupikɨ timɨmɨme watamɨmɨtɨ mɨtiwakukuinitɨwa yunaime mana memuyekɨka hepaɨ  
\q2 kani'aneni kemɨ'ane mɨkayukuhɨawe muta'ini yukie.   
\b  
\q1
\v 11 Tsɨkɨ 'ukunuaka tawarita yuhayari kemɨtiukukwa'a hepaɨ,  
\q2 mɨpaɨ kani'aneni mɨkayuwaɨriya teɨteri muwaparewienikɨ yaxeikɨa kemɨtiyuriene.   
\b  
\q1
\v 12 ¿Tewi petimate kemɨ'ane timaiweme muyuxata?  
\q2 Tewi mɨkayuwaɨriya muwaparewienikɨ hipame mɨkɨ hetsie matsi katinitakwewiyaka keyuri mɨtiuyemate.   
\b  
\q1
\v 13 Muyu'ɨraxie mɨpaɨ kaniutaineni: «Huyeta tiyukwa'ame kaneyeikani.  
\q2 Kaye'utɨma maye kaneyeikani 'akuxɨnitɨ».   
\b  
\q1
\v 14 'Itupari kemɨranakuwautse mɨrawiyatɨkatsie,  
\q2 yaxeikɨa muyu'ɨraxie mɨpaɨ yu'itaritsie ta'aurie katinawautseni.   
\b  
\q1
\v 15 Mɨyu'ɨraxie xakɨtsie xeikɨa kanikameka,  
\q2 matsi 'akuxi kaneiyehɨaka mɨramikiwanikɨ yuteta paitɨ.   
\b  
\q1
\v 16 Mɨyu'uraxie kwinimieme timaiweme kaniyuxatani,  
\q2 kename 'atahutame temaiwawemete waruta'ɨxatsitɨawe.   
\b  
\q1
\v 17 Kemɨ'ane mɨrayukwitɨnetsie meuyehake ka'inierietɨ,  
\q2 tsɨkɨ nakateyatsie tiwietɨ manukuhana hepaɨ kani'aneni.   
\b  
\q1
\v 18 Xewitɨ heuyuyehɨatɨ mɨtiutatuaxa hepaɨ,  
\q2 'ɨrɨ tatɨkaimekɨ watakukuyatɨ,   
\q1
\v 19 mɨpaɨ kani'aneni kemɨ'ane yuhamiku mɨkwamana mɨpaɨ rehɨawetɨ:  
\q2 «Netɨ nepɨka'imainekai».   
\b  
\q1
\v 20 Tai pɨtɨni xɨka kɨyexi ka'anutanetɨarieni,  
\q2 niuki peraixi memɨkahaxuawetsie 'imieri kanikumawerimɨkɨ.   
\b  
\q1
\v 21 Tɨxari tɨɨ kanayeikani, kɨyexikɨ tai kananutatataweni,  
\q2 tewi haxɨa mawauwe 'imieri kanitsutsutɨwametɨni.   
\b  
\q1
\v 22 Niuki perai niukieya yemɨkɨ witsikatini'enierieka,  
\q2 wataɨta paitɨ kaniye'axeni.   
\b  
\q1
\v 23 Kwitame pɨratakɨ muwewiya haxu xariyari hetsie muyeka,  
\q2 tewi mɨpaɨ kani'aneni yu'iyaritsie mɨtihɨniya 'axamɨti'ane.   
\b  
\q1
\v 24 Kemɨ'ane mɨtiyuka'uxiwe'erie yuniukita katini'awietani,  
\q2 matsi yutaɨta 'axakatiniyurimɨkɨni.   
\q1
\v 25 Kepauka witsimetikuxaxatɨwa yuri pepɨkati'eririeka,  
\q2 'iyarieyatsie 'axamɨti'ane mɨtihɨnekɨ.   
\q1
\v 26 Tsepa 'uxiwe'erika muti'awietaxɨ yuhetsie,  
\q2 matsi mɨkɨ mɨirikɨa memayuxeɨrietsie katinitahekɨatsiemɨkɨ ke'axamɨtiuyuri.   
\b  
\q1
\v 27 Putsu xɨka 'utawewieni muwa kaneukawemɨkɨ,  
\q2 meta tete 'amɨnena xɨka hakaina yuhetsie kanikahɨamɨkɨ.   
\b  
\q1
\v 28 Mɨti'itawa kemɨ'ane 'axamɨtikɨhɨawe mɨkɨ kani'uxiwe'erieka,  
\q2 witsimɨtiuxaxata wakwamanatɨ kaniwarekaxɨriemɨkɨ.   
\b  
\c 27  
\q1
\v 1 Pepɨka'uyuta'ɨreni 'uxa'a kepemɨtiyurieni hetsiemieme,  
\q2 'atsipemɨkatimatekɨ 'uxa'a kemɨtiyɨni.   
\b  
\q1
\v 2 'Ekɨ 'akɨmana 'ahetsiemieme 'aixɨa pepɨkahaineni,  
\q2 hipatɨ pɨta 'aixɨa mekehaitɨkani 'ahepaɨtsita.   
\b  
\q1
\v 3 Tete pahete, xiekari pahete,  
\q2 matsi waɨkawa pahete kepauka tewi mɨha'a yutemawietɨ 'axamɨtiyuriene.   
\b  
\q1
\v 4 Haxɨa 'axapɨtiyuruwame meta pɨtiyu'uname,  
\q2 yaxeikɨata 'uxiwe'erika xewitɨ pɨka'inewie.   
\b  
\q1
\v 5 'Aixɨa pɨ'ane xɨka hekɨa heitserie 'utatierieni,  
\q2 'aixɨa pɨka'ane mɨnaki'eriwani 'awiexeikɨa.   
\b  
\q1
\v 6 Waɨkawa matsi pepinaki'erieka 'ahamiku kepauka mumatikwinitɨa,  
\q2 keyuri mɨmatsi'aye'unie kepauka mɨmatsi'itseni.   
\b  
\q1
\v 7 Kemɨ'ane mɨkaheuhaakamɨkɨ, xiete kanixani'erieka,  
\q2 matsi kemɨ'ane meuhaakamɨkɨ, tsepa mɨratsiwi katinakakani hetsienamieme.   
\b  
\q1
\v 8 Wiki yu'itɨa kemɨtiuku'e'eiriwa tsepa hakewa,  
\q2 yaxeikɨata tewi mɨpaɨ 'ateewa katineyeikani yutɨɨriyama waku'eirieme.   
\b  
\q1
\v 9 Mixaxi meta witsimɨtiu'ɨatɨka 'iyari kanitemawieritɨwametɨni,  
\q2 'ekɨta witsikepemɨtiwaxeiya 'iwatamete mɨkɨta waɨkawa pewaparewiekaku mekaniyuwaɨriyani.   
\b  
\q1
\v 10 Pepɨka'iku'e'eiriwani 'ahamiku meta 'apaapa hamikuya.  
\b  
\q1 Xɨka pe'a'uximatɨaka 'a'iwa hetsɨa pepɨkaheumieni.  
\b  
\q1 'A'iwa pɨkayɨwe 'ateewa kiekame matsi'uparewieni, 'akie 'ahurawa muka pɨta pɨyɨwe.   
\b  
\q1
\v 11 Temaikɨ, nematsinaki'erie xɨka petimaiwetɨ 'ape'uyeikani ne'iyari kaniyutemawieka,  
\q2 'ana nekaniyɨwemɨkɨ nemɨwata'eiyakɨ kemɨ'ane memɨnetsi'uxiwe'erie.   
\b  
\q1
\v 12 Kemɨ'ane mɨtimaiwe 'axamɨti'ane katinixeiyani mɨkɨ 'ateewa kaniuyeyeikani,  
\q2 mɨkatimaiwe matsi mana kaniuyeyeikani 'ayumieme pɨtiuka'eniwa.   
\b  
\q1
\v 13 Kemɨ'ane yamɨtayɨni ka'imateme hetsiemieme kename rayukatuani yukemari paitɨ kaneuyehɨamɨkɨ,  
\q2 kemɨ'ane muyuyetuani 'uka xeime 'ɨyaya hetsiemieme yupiini tinaime mɨrexeiya katininawaiyariemɨkɨ.   
\b  
\q1
\v 14 Matsi xɨka pe'itawaɨritɨani 'ahamiku karima pe'utahiwatɨ ximeri paitɨ,  
\q2 mɨpaɨ pumatitahɨawe: «Ketitayari heu'erietɨ penetiutahiwi».   
\b  
\q1
\v 15 Haa mɨkatsuke katihayewatɨ kepauka muwiyenitsie,  
\q2 mɨpaɨ kani'aneni 'uka muyumieriwie.   
\q1
\v 16 Kemɨ'ane 'uka mɨyamɨ'ane mɨkemakaxɨani, 'eka mɨkemakata pɨyɨweni,  
\q2 meta pɨyɨwe hatseiti yumamatsie mukwewienikɨ.   
\b  
\q1
\v 17 Tepɨa hepaɨna tepɨakɨ xɨka 'atamɨani kanetaxikaunariyamɨkɨ,  
\q2 meta tewi yuhepaɨ teɨteri wahamatɨa katinetimamateni.   
\b  
\q1
\v 18 Kemɨ'ane piní 'iteɨriyari mɨ'ɨwiya mɨkɨ takariyari kanikakwaimɨkɨ,  
\q2 kemɨ'ane 'aixɨa mɨti'uximaya yukutsiyari hetsɨa, matsi 'aixɨa katinixeiyariekamɨkɨ.   
\b  
\q1
\v 19 Hatsie kemɨtihekɨa kepemɨraka'erie 'ahɨxie,  
\q2 meta tewi yu'iyaritsie mɨpaɨ katinimatsiɨkɨni.   
\b  
\q1
\v 20 Teukiya, mɨɨya meta tita teɨteri memɨtehiwe'erie metexeiyatɨ,  
\q2 hatsuaku wa'iyaritsie pɨkareuyeyeika.   
\b  
\q1
\v 21 Taipa pɨrata kani'inɨatsieka,  
\q2 huru huxunuta kani'inɨatsieka,  
\q2 tewi kani'inɨatsiekata kepauka hipatɨ 'aixɨa memaitɨka hepaɨtsitana.   
\b  
\q1
\v 22 'Axamɨtiyuriene yutemawietɨ tsepa meuyetɨxiwa heiwa meta hutarieka,  
\q2 tsepa pemitɨxɨni matatsie 'ikú hepaɨ,  
\q2 hawaikɨ pɨkanawaiyarieni kemɨtiyuriene.   
\b  
\q1
\v 23 Keneu'a'ɨwiya pemɨretimanikɨ kemeteheu'erie 'atewama,  
\q2 'amuxatsima waɨkawa keniwa'ɨwiyani,   
\q1
\v 24 kepemɨrexeiya waɨkawa mɨkɨ pɨkatiteriwe,  
\q2 meta tumini tsepa pemexeiya tixaɨtɨ pɨkatihɨkɨ.   
\q1
\v 25 Kepauka mɨraka'etsitɨretsie 'ɨxa makuwatsienitsie meta matiyɨraxɨanitsie,  
\q2 meta hɨritsie paitɨ tupiriyate mukuxeɨriyanitsie,   
\q1
\v 26 muxatsi 'akemari mepɨmatsiyetuirieni,  
\q2 kapuratsixita peminanenikɨ hɨritsie 'amakuyewa,   
\q1
\v 27 mana pekaneixeiyakamɨkɨ kapuratsixi waretsiyari 'anayuhayewame,  
\q2 kɨmana xemɨteyumikwanikɨ yunaitɨ 'atɨɨriyama,  
\q2 meta yaxeikɨa yunaitɨ mete'uximayatsiriwamete.   
\b  
\c 28  
\q1
\v 1 'Axatiyuruwame kaniuyu'unarɨmeni tsepa xewitɨ mɨka'iweiya,  
\q2 matsi heitseriemekɨ yamɨtikamie kayuwatɨ 'apuyeika maye hepaɨ.   
\b  
\q1
\v 2 Kiekaritsie xɨka 'axatiyɨaneni,  
\q2 'itsɨkate mepɨyutimɨmɨire,  
\q1 kepauka kuwexinaruri mɨtiuyemate,  
\q2 kayuwatɨ putamarike.   
\b  
\q1
\v 3 Kuwexinaruri tixaɨtɨ memɨkatehexeiya muwananaima,  
\q2 mɨkɨ wiyeri mɨtɨrɨkaɨye 'ekamatɨ waxa kemɨreuyehɨpa hepaɨ kani'aneni.   
\b  
\q1
\v 4 Kemɨ'ane 'inɨari niukiyari memuku'eiri 'aixɨa meputiyuaneni 'axateyuruwamete wahepaɨtsita,  
\q2 matsi kemɨ'ane memi'enie mekaniwa'uxiwe'erieka.   
\b  
\q1
\v 5 'Axateyuruwamete tita mɨtiheitserie mepɨkahetimaitɨkɨka,  
\q2 matsi kemɨ'ane Yawé memukuwautɨwe mɨkɨ naime mekatenimaika yamemɨtekahukɨ.   
\b  
\q1
\v 6 'Aixɨa kani'aneni tixaɨtɨ mɨkarexeiya heitseriemekɨ 'amuyeika,  
\q2 matsi 'aixɨa pɨka'ane kepauka xiku 'axa'anemekɨ muyeika.   
\b  
\q1
\v 7 Temaikɨ meti'enatɨyeika yakatinikamieni 'inɨari niukiyaritsie,  
\q2 matsi kemɨ'ane waɨkawa memɨtekwa'a wahetsie mɨtiwiya mɨkɨ yupaapa kanitewiyatsitɨaka.   
\b  
\q1
\v 8 Kemɨ'ane kwinimieme rana'iwamɨtɨ tumini muwaniɨtɨa,  
\q2 matsi kemɨ'ane muwanenimaya memɨkatehexeiya hetsie pɨta pɨtinakeni.   
\b  
\q1
\v 9 Kemɨ'ane 'inɨari niukiyaritsie yamɨkatikamie,  
\q2 Kakaɨyari mɨkɨ nenewierieya kani'uxiwe'erieka.   
\b  
\q1
\v 10 Kemɨ'ane heitseriemekɨ yamemɨtekahu xaɨtsie muwareukuyunitɨani,  
\q2 mɨkɨta yukɨmana yuwiniyaritsie kaniyuhɨamɨkɨ,  
\q2 matsi heitseriemekɨ yamemɨtekahu yu'iwarika 'amepɨtehapiniyarieni 'aixɨa mɨti'ane.   
\b  
\q1
\v 11 Xiku timaiweme kaniyu'erieka,  
\q2 matsi tewi tixaɨtɨ mɨkarexeiya rakumaitɨ yakatineitimamateni mɨkɨ kemɨtiyuriene.   
\b  
\q1
\v 12 Kepauka heitseriemekɨ yamemɨtekahu memɨtehayu'iwa kanimariweni wa'ixɨarari meta watemawierika,  
\q2 matsi kepauka yamemɨkatekahu memɨtehayu'iwa yunaitɨ teɨteri mekaniyuti'awiwietani.   
\b  
\q1
\v 13 Kemɨ'ane 'axamɨti'ane mɨti'awieta hatsuaku 'aixɨa pukatiyeyani,  
\q2 matsi kemɨ'ane muyutahekɨata 'axamɨti'ane mɨtiku'eirieni mɨkɨ katineuyehɨwiyariemɨkɨ.   
\b  
\q1
\v 14 'Aixɨa kani'itɨarieka kemɨ'ane Yawé yuheyemekɨ mayemakaxe,  
\q2 matsi kemɨ'ane yu'iyari mɨtse'iriya 'axa'anekɨa kaniyuhayewamɨkɨ.   
\b  
\q1
\v 15 Maye mahiwa meta hutse meuhakamɨkɨ hepaɨ,  
\q2 kuwexinaruri 'axamɨtiuka'iyari kani'aneni tixaɨtɨ memɨkateheuxeiya muwananaima.   
\b  
\q1
\v 16 Kuwexinaruri 'atsimɨkaretimaitɨyeika katininawayani teɨteri wakwamanatɨ,  
\q2 matsi kemɨ'ane mɨpaɨ mɨkatiyuriene mɨkɨ mɨixa tukari 'apuyeikani.   
\b  
\q1
\v 17 Kemɨ'ane tiyumieme mukuweiyariene,  
\q2 kaniyuku'unanemɨkɨ kepaukake mumierieni,  
\q2 xewitɨ tɨma pɨka'iparewieni.   
\b  
\q1
\v 18 Kemɨ'ane 'aixɨa mɨtixeiyarie heitseriemekɨ yamɨtikamie mɨkɨ kaniyutawikweitsitɨamɨkɨ,  
\q2 matsi kemɨ'ane 'axatiyurienetɨ 'amuyeika putsuta kaneukawemɨkɨ.   
\q1
\v 19 Kemɨ'ane yukwietsie mɨtikumaɨwa waɨkawa 'ikwai katinexeiyakamɨkɨ,  
\q2 matsi kemɨ'ane muyukuwie tixaɨtɨ karexeiyatɨ kanayeimɨkɨ.   
\b  
\q1
\v 20 Tewi heitseriemekɨ yamɨtikamie mɨkɨ waɨkawa 'aixɨa kani'itɨarieka,  
\q2 kemɨ'aneta mɨyumexɨitɨa xiku mayanikɨ tikwinitɨarietɨ pɨkahayewarieni.   
\b  
\q1
\v 21 'Aixɨa pɨka'ane hipame xeikɨa teɨteri muwaparewieka hipame yɨkɨ tiwaxeiyatɨ,  
\q2 hipatɨ 'axamekateniyurieka paa 'etsipemekɨtɨtɨ.   
\b  
\q1
\v 22 Kemɨ'ane mɨtiukakwerie xiku mayanikɨ puyumexɨitɨa,  
\q2 'atsikatimaitɨ kepauka tixaɨtɨ karexeiyatɨ mayanikɨ.   
\b  
\q1
\v 23 'Imatɨrieka matsi hatsua 'aixɨa pɨtitahɨawarieni,  
\q2 kemɨ'ane mɨtiyutaheitseritɨani keyuri witsimutaine wakwamanatɨ xeikɨa.   
\b  
\q1
\v 24 Kemɨ'ane yupaapa meta yumaama mɨtinawatsiriwa,  
\q2 katihayewatɨ kename 'axakatiyuriene,  
\q2 mɨkɨ teɨteri 'axamemɨteyurie kaniwahamikutɨni.   
\b  
\q1
\v 25 Kemɨ'ane tumini mɨnaki'erie xeikɨa mɨkɨ waɨkawa kaniyumienemɨkɨ,  
\q2 matsi Yawé hetsie kemɨ'ane yuri mɨti'erie 'aixɨa kani'itɨariekamɨkɨ.   
\b  
\q1
\v 26 Xɨka tewi yuhetsiemieme yuri tiyu'eririeka mɨkɨ pɨkayuwaɨriya muwaparewienikɨ hipame,  
\q2 matsi kemɨ'ane timaiwetɨ yamɨtiyurieni kaniyutawikweitsitɨamɨkɨ.   
\b  
\q1
\v 27 Kemɨ'ane tixaɨtɨ mɨkarexeiya mɨparewie mɨkɨ tixaɨtɨ reuyehɨatɨ pɨkahayani,  
\q2 kemɨ'ane miti'uxiwe'erieni parewiya kemɨreuyehɨwa, mɨkɨ 'axakani'itɨariekamɨkɨ.   
\b  
\q1
\v 28 Kepauka yamemɨkatekahu memɨte'ayu'iwa, teɨteri mekaniyuti'awiwietani,  
\q2 kepaukata memukumaweriyarieni, 'aixɨa memɨteyurie 'aixɨa mekani'itɨariekuni.   
\b  
\c 29  
\q1
\v 1 Kemɨ'ane mɨixa tierikayarikɨ mɨkaheu'ena  
\q2 yapauka kanika'unariemɨkɨ kanenimayatsietɨ.   
\b  
\q1
\v 2 Kepauka heitseriemekɨ yamemɨtekahu memɨte'aitani teɨteri mepuyukatemamawieni,  
\q2 kepauka 'axateyuruwamete memɨte'aitani teɨteri mepɨte'uka'eniwa.   
\b  
\q1
\v 3 Kemɨ'ane mɨtimaiwenikɨ muyuwaɨriya, mɨkɨ yupaapa pɨtemawieritɨa,  
\q2 kemɨ'ane 'ukari 'axateyuruwamete wahamatɨa muyeika, mɨkɨ yutumini pɨxɨtɨa.   
\b  
\q1
\v 4 Kwiepa ti'aitame xɨka kemɨtiheitserie ti'aitani 'aixɨa pɨti'ane kiekariena,  
\q2 kemɨ'ane tuminikɨ memɨtehayukatuayanikɨ xeikɨa muwawawirie kiekari kanika'unani.   
\b  
\q1
\v 5 Kemɨ'ane yuhepaɨ tewi witsimɨtikuxaxatɨwa ti'itaiyatɨ,  
\q2 winiyari hɨxiena puteika.   
\b  
\q1
\v 6 'Axatiyuruwame ke'axamɨtiuyurikɨ pekawautse,  
\q2 matsi heitseriemekɨ yamɨtikamie yutemawietɨ putakwika.   
\b  
\q1
\v 7 Heitseriekamekɨ 'amuyeika puyu'iyaritɨa kememɨte'uka'eniwa tixaɨtɨ memɨkatehexeiya wahetsiemieme matsi waheima kaninuaka,  
\q2 matsi 'axatiyuruwame 'atsipɨkatimate ketita mɨtixatsiwa.   
\b  
\q1
\v 8 Memɨteyukatawe'erie kiekari mekanixamurieka,  
\q2 memɨtemaiwawe matsi waɨkawa kayuwatɨ mekaniwapitɨaka.   
\b  
\q1
\v 9 Kepauka mɨtimaiwe meta yutemawietɨ 'axamɨtiyuriene hamatɨa memuyutakwini,  
\q2 tsepa mutanawe yatɨni muyeha'a mɨkɨkɨ 'aixɨa pɨkatiyɨni.   
\b  
\q1
\v 10 Memɨteyumemiwa mekaniwa'uxiwe'erieka teɨteri 'aixɨa memɨte'u'iyari,  
\q2 meta heitseriemekɨ yamemɨtekahu mekaniwakwika.   
\b  
\q1
\v 11 Tewi mɨkayuwaɨriya hipame muwaparewienikɨ yuhaxɨa pɨkawahana,  
\q2 matsi kemɨ'ane mɨtimaiwe katinakumaika kemɨtiuyunɨtɨani.   
\b  
\q1
\v 12 Kwiepa ti'aitame xɨka memɨte'itawa xeikɨa wareu'enieka,  
\q2 yunaitɨ te'i'uximayatsiriwamete 'axamekateniu'iyarikakuni.   
\b  
\q1
\v 13 Tewi tixaɨtɨ mɨkarexeiya meta mɨtiyukananaima hamatɨa yaxeikɨa mekani'aneneni:  
\q2 Yawé mɨkɨ yuhutame kaniwapitɨaka memayenenierenikɨ.   
\b  
\q1
\v 14 Kwiepa ti'aitame heitseriekamekɨ xɨka 'aixɨa tikuyuruwani tixaɨtɨ memɨkateheuxeiya wahetsiemieme,  
\q2 mɨkɨ meta xiɨyarimama yuheyemekɨ heitserie mekanexeiyakakuni memɨtewata'aitɨanikɨ yuteɨterima.   
\b  
\q1
\v 15 Tewi xɨka ti'ɨkitɨarieka kuweiwatɨ timaiwetɨ kanayeimɨkɨ,  
\q2 matsi kemɨ'ane mɨkaheu'ena yumaama kanitewiyatsitɨaka.   
\b  
\q1
\v 16 Kepauka 'axateyuruwamete memɨyumɨire 'axamɨti'aneta kaniwaɨkawani,  
\q2 matsi teɨteri heitseriemekɨ yamemɨtekahu mekaniwaxeiyakuni kememɨte'atixɨriyani.   
\b  
\q1
\v 17 'Aniwe ketine'ɨkitɨaka, xɨka mɨpaɨ petiuyurieni 'arike 'aixɨa 'iyari pepuyeikani,  
\q2 'ana temawierika pepexeiyani 'a'iyaritsie hetsienamieme.   
\b  
\q1
\v 18 Hakewa teɨteri 'atsimemɨkatehemate Kakayari kemaine, mekaneuyexɨrɨweni,  
\q2 'aixɨa mekani'itɨarieka yamemɨtekahu 'inɨari niukiyaritsie.   
\b  
\q1
\v 19 Hawaikɨ niukikɨ xeikɨa pɨkayɨwe ti'uximayatame mɨtiti'ɨkitɨanikɨ,  
\q2 tsepa mumetsi'enie yapɨkatikayani.   
\b  
\q1
\v 20 ¿Tewi petimate kemɨ'ane kaheitimaixɨame mutaniuka?  
\q2 Tewi mɨkayuwaɨriya muwaparewienikɨ hipame mɨkɨ hetsie matsi katinitakwewiyaka keyuri mɨkɨ.   
\b  
\q1
\v 21 Kemɨ'ane tiyu'uximayatsiriwame mɨkaheitseritɨakai kepauka mɨkɨ mununutsitɨkaitsie,  
\q2 'arikeke mɨkɨ yapɨkatikayani kemɨtita'aitɨani.   
\b  
\q1
\v 22 Tewi mayu'eriya 'imieri xeikɨa kanixuawitɨaka,  
\q2 meta kemɨ'ane mayumiewe waɨkawa 'axapɨtiyurie.   
\b  
\q1
\v 23 Kemɨ'ane muyuta'ɨre tixaɨtɨ pɨkarayani,  
\q2 matsi kemɨ'ane tixaɨtɨ mɨkarayuyeitɨa matsi mariwetɨ kanayeitɨariemɨkɨ.   
\b  
\q1
\v 24 Xɨka tenawayamete pewanɨka, 'ekɨ 'akɨmana pekani'a'uxiwe'erieka,  
\q2 kepauka memɨtiwiyarienitsie, 'itsɨkame hɨxie 'ahetsie pɨrahɨiyani, 'ekɨ 'atsipepɨkatayɨni.   
\b  
\q1
\v 25 Pewamakatɨ teɨteri 'akɨmana pepɨ'awiniya,  
\q2 kemɨ'ane Yawé hetsie yuri mɨti'erie kaniwikweitsitɨarieka.   
\b  
\q1
\v 26 Yumɨiretɨ parewiya ti'aitame hetsɨa mekanikuwautɨweni,  
\q2 matsi Yawé xeikɨa kanihɨkɨtɨni teɨteri heitserie muwapitɨani yuxexuime.   
\b  
\q1
\v 27 Yamemɨtekahu mekaniwa'uxiwe'erieka 'axamemɨteyurie, yaxeikɨata 'axateyuruwamete heitseriekamekɨ 'amemu'uwa mekaniwa'uxiwe'erieka.   
\c 30  
\b  
\ms1 'Akuhuxi niukieya kemɨtimaiwekai  
\p
\v 1 'Akuhuxi niukieya kemɨtimaiwekai Kakehe nu'aya Matsaha kiekame. Tixaxatame niukieya. 'Ikɨ tewi mɨpaɨ kaniutayɨni:  
\q1 «Neuxei Kakaɨyari 'aku ne nepu'uxe,  
\q2 Kakaɨyari 'aku ne nepu'uxe meta nepɨwerani.   
\b  
\q1
\v 2 »Ne tewi kwinimieme 'atsinemɨkatimate nepɨhɨkɨ,  
\q2 'etsiwa tɨma ne nepɨkatiuyemate tewi kemɨtimaiwe.   
\q1
\v 3 Nemɨtimaiwenikɨ 'akuxi ne nepɨkatanaki'eriwe,  
\q2 meta Kakaɨyari mɨpatsie nepɨkamate.   
\b  
\q1
\v 4 »¿Muyuawitsie kemɨ'ane panutitɨari  
\q2 meta kemɨ'ane mana pakane?  
\q1 ¿Kemɨ'ane 'eka puwiyawe yumamakɨ,  
\q2 yatɨni kemɨ'ane haramara pakawimawe?  
\q1 ¿Kemɨ'ane kwie manuye'atɨkanitsie pu'inɨataxɨ?  
\q2 ¿Kemɨ'ane yapɨtimate kepemɨtitewa yatɨni 'aniwe kemɨtitewa?   
\b  
\q1
\v 5 »Kakaɨyari niukieya naitɨ taikɨ puti'inɨatsie,  
\q2 Kakaɨyari kaniwaparewieka kemɨ'ane hetsɨana memɨtewautɨwe 'aixɨa memɨ'itɨariekakɨ.   
\q1
\v 6 Niukieya pepɨka'anutiyayatsani,  
\q2 kapa metsi'utatienikɨ  
\q2 meta peti'itawame matsiɨkɨme 'ahetsie rayeitɨanikɨ.   
\b  
\q1
\v 7 »Tihutame xeikɨa Yawé nepɨmatiwawirie,  
\q2 mexixi nekamɨwe yakenetineupitɨa.   
\q1
\v 8 Keneneparewieka nemɨkati'itawanikɨ,  
\q2 tixaɨtɨ nekarexeiyame pepɨkanetsihayeitɨwani meta xiku nemɨka'ayanikɨ,  
\q2 matsi pɨta paa xeitukariyaritsie mieme keneneyetuiriwani.   
\q1
\v 9 Waɨkawa xɨka nerexeiyani nepɨmatsihatɨmaiyawe,  
\q2 mɨpaɨ ne'utaitɨ: “¿Yawé kemɨ'ane pɨhɨkɨ?”  
\q1 Meta xɨka 'etsiwa xeikɨa nerexeiyanike tinawayame nepayeiwe,  
\q2 'ekɨ nekakaɨyari 'axapemɨtitahɨawarienikɨ xeikɨa.   
\b  
\q1
\v 10 »Ti'uximayatame 'axapepɨkatikɨhɨaweni kutsiyarieya hɨxie,  
\q2 nɨka 'axape'itɨarietɨ pemayanikɨ mɨkɨ yametiutahɨawe meta yapetiuka'eniexɨani.   
\b  
\q1
\v 11 »Hipatɨ mekanixuaweni yupaapama 'axametewakumamatetɨ,  
\q2 meta yumaamama 'aixɨa mekatewarahɨawetɨ.   
\q1
\v 12 Hipatɨ mekanixuaweni me'itiyakame meyuxatatɨ,  
\q2 matsi 'akuxi mepɨkayu'itiewawe kememɨkate'itiyakɨ.   
\q1
\v 13 Hipatɨta mekanixuaweni waɨkawa meyɨwaweme meyu'erietɨ,  
\q2 mɨkɨ yunaitɨ mekaniwaxeiyani mewa'uxietɨ.   
\q1
\v 14 Hipatɨ tamé 'ixiparayari mekanexeiyani  
\q2 meta natsɨkwai nawaxayari,  
\q1 kwiepa memuwatikwanikɨ tixaɨtɨ memɨkatehexeiya,  
\q2 meta teɨteri memɨteheuyehɨwa 'ena kwiepa memu'uwa.   
\b  
\q1
\v 15 »Xuriya 'itseweme yuhutame yuniwema kaniwarexeiyani,  
\q2 mɨpaɨ mekaniutiyuaneni: “Kena, kena”.  
\b  
\q1 »Haikatɨ kanixuaweni 'inɨari hatsuaku memɨkahuxaiwawe,  
\q2 nauriekata mieme hatsuaku mɨpaɨ pɨka'utaine: “Nepɨwaɨripie”:   
\q1
\v 16 Teukiyapa, meta 'uka mɨkaniwewe,  
\q2 meta kwie hakɨ mɨka'utahɨpɨrike,  
\q2 meta tai hatsuaku mɨkakutɨtɨtse.   
\b  
\q1
\v 17 »Kemɨ'ane yupaapa mɨka'enie,  
\q2 meta yumaama mɨkaheu'enie,  
\q1 kwatsari mana mayeweritsie memu'uwa hɨxiteya meke'utikwani,  
\q2 meta maraikatsixi 'ayeniereme waiyarieya meke'utakwani.   
\b  
\q1
\v 18 »Haikatɨ kanixuaweni 'inɨari mɨnetsihɨxiyatsitɨa,  
\q2 matsi naurieka mieme nepɨka'uyɨwekaxɨa nemeitimanikɨ:   
\q1
\v 19 kwixɨ huyerieya kemɨtikuwiene muyuawitsie,  
\q2 kuu huyerieya tetetsie kemɨtikuyeika,  
\q1 kanuwa 'amɨpa huyerieya haramaratsie mɨyeyeika,  
\q2 meta 'uki 'uka 'iyarieya kemɨra'i'iwa.   
\b  
\q1
\v 20 »Mapaɨ katiniyurieka 'uka muwikie memɨkakɨnamama memikumaɨwa:  
\q2 tiutikwa'atɨ wayetereuxinatɨ,  
\q2 mɨpaɨ kaniutaineni: “Hawaikɨ matsi 'axanepɨkatiyuriwe”.   
\b  
\q1
\v 21 »Mɨkɨ haikatɨ 'inɨari kwie kaniwatayuitɨwani,  
\q2 naurieka miemeta yaxeikɨa pɨtiyuriene:   
\q1
\v 22 Waɨriyarika ti'uximayatame ti'aitatɨ mayanikɨ kanaye'aweni,  
\q2 tewi 'atsimɨkatimate 'ikwaiya mɨranayuhayewa.   
\q1
\v 23 'Uka mɨxani'eriwakai kepauka mɨtiwikieni,  
\q2 meta 'uka waɨriyarika ti'uximayatame ti'aitatɨ mayanikɨ yukutsiyari kiita.   
\b  
\q1
\v 24 »Yunaukatɨ kwiepa 'etsimetepepetɨ mekatenixuaweni,  
\q2 matsi waɨkawa metemaiwawetɨ keyuri temaiwawemete:   
\q1
\v 25 tsarɨxi mekatɨrɨkawitɨtɨ,  
\q2 yu'ikwaite taxata timieme mekateniuti'utani,   
\q1
\v 26 haitsɨrixita, yeutari 'etsimepepetɨ,  
\q2 mɨkɨ yuterɨ mekanexeiyani 'aitsie paitɨ,   
\q1
\v 27 'utsikarita tiyu'aitɨwame memɨkahexeiya,  
\q2 matsi yaxeikɨata mɨkɨ mekateniukɨkani kuyaxi wahepaɨ,   
\q1
\v 28 'atakwaixita, mekaniyuwiyanɨaka yumamakɨ,  
\q2 matsi mɨkɨta paratsiyuta paitɨ mekaneutahakeni.   
\b  
\q1
\v 29 »Yuhaikatɨta mekanixuaweni 'aixɨa mete'ɨkɨkatɨ,  
\q2 matsi naurieka mieme wahepaɨ 'aixɨa pɨtiuyeika:   
\q1
\v 30 maye, 'ɨrawetsixi watsata mɨtɨrɨkaɨye,  
\q2 tixaɨtɨ timakatɨ mɨka'ukununuwa,   
\q1
\v 31 wakanata 'uki yu'anatekɨ kanitɨrɨkaɨyeni, tsiputa 'uki yaxeikɨa,  
\q2 ti'aitameta yukuyaxima wahamatɨa kanitɨrɨkaɨyeni.   
\b  
\q1
\v 32 »Xɨka yamɨkatikamie hepaɨ petiuyeikani, kwinimieme petiu'ata'ɨretɨ,  
\q2 xɨka xewitɨ mɨpaɨ tiku'eriwani, kaneuyeweka yapauka muyutimaixɨanikɨ,   
\q1
\v 33 kwahu hayari xɨka retsita 'ukatuame xɨka 'iwakumuina kexiu kanihekɨarimɨkɨ,  
\q2 meta xɨka karima 'ukatsurixike xuriya ratsurita kaniwakanemɨkɨ,  
\q2 meta haxɨa xɨka 'utsutɨani kaniuyutakwixɨakuni».   
\c 31  
\ms1 Ti'aitame Remuheri niukieya kemɨtimaiwekai  
\p
\v 1 Ti'aitame Remuheri niukieya kemɨtimaiwekai. Tixaxatame niukieya, maamaya kemɨtiti'ɨxatsitɨa niukiyari:   
\q1
\v 2 «¿Temaikɨ 'aku kepetiku'eriwa?  
\q2 ¿Temaikɨ 'aku, kepetiku'eriwa nemɨmatsi'utiniwexɨ?  
\q2 Neyutanenewieku Yawé 'ekɨ pɨmatsiyetua, ¿kehepaɨ nemati'ɨxatsitɨani?   
\q1
\v 3 'Atɨrɨkariya pepɨkayetuaka 'ukari wahetsie,  
\q2 mɨkɨ te'aitamete paitɨ mekaniwareuyexɨrɨwani.   
\b  
\q1
\v 4 »Remuheri 'aku,  
\q2 'aixɨa pɨka'ane te'aitamete kaxie winuyari memɨ'ieka,  
\q2 meta nawa kuwexinaruritsixi memanuye'eni,   
\q1
\v 5 kapa metarɨwetɨ mehetɨmaiya 'inɨari niukiyari kemaine,  
\q2 meta tixaɨtɨ memɨkatehexeiya metewarunawairieni heitserie kememɨtehexeiya.   
\q1
\v 6 Memukwixime nawa memanu'einikɨ keniwarupitɨa,  
\q2 meta kaxie winuyari kemɨ'ane waɨkawa memɨyu'iyaritɨa.   
\q1
\v 7 Meke 'enu'ieni, memɨtehatɨmaiyakɨ tixaɨtɨ memɨkatehexeiyakɨ,  
\q2 tawariri memɨkahe'eriwanikɨ kememɨte'uka'eniwa.   
\b  
\q1
\v 8 »Kenewaparewieka yɨkɨmana memɨkaniuwawe 'itsɨkate wahɨxie,  
\q2 kenewanenimayaka wiuraxi meta nutuite.   
\q1
\v 9 Mɨkɨ wahetsiemieme keneutaniukani 'aixɨa memɨ'itɨarienikɨ,  
\q2 memɨkatehexeiya kenewanenimayaka memɨteheuyehɨwa wahetsie kenenuaka».   
\ms1 'Uka 'aixɨa kemɨtiuka'iyari, kemɨtiyuriene  
\q1
\v 10 'Uka 'inɨari mayuyeitɨwa, ¿hakewa peikaxeiya?  
\q2 Matsi kwinimieme katinaye'aka keyuri tetexi witsimɨ'anene waɨkawa mɨraye'atɨka,  
\q2 yukie 'uyeikatɨ yapɨtikamie.   
\b  
\q1
\v 11 Kɨnaya matsi hetsiena kaneuwaɨreni,  
\q2 tixaɨtɨ 'iwarika pɨkareuyehɨwa.   
\b  
\q1
\v 12 Mɨkɨ naime kemɨtiyuriene 'aixɨa kani'aneni kɨnaya hetsiemieme,  
\q2 'axapɨkatiyuriene kepaɨmexɨa tukari hamatɨana muyeikani.   
\b  
\q1
\v 13 Kanikuyeikani 'ikunanenetɨ muxa huxarieya meta rinu witsimɨ'ane 'ixurikiyari,  
\q2 yumamakɨ tikumaɨwatɨ katini'uximayaka yutemawietɨ.   
\b  
\q1
\v 14 Kanuwa 'amɨpapa yuharerutamete hepaɨ kani'aneni,  
\q2 mɨkɨ 'ateewa katinatɨtɨyeikani yu'ikwaite.   
\b  
\q1
\v 15 Ximeri paitɨ kananukukekani,  
\q2 yuniwema katiniwarutimikwani,  
\q2 meta yuparewiwamete yuhetsɨa miemete katiniwakumikwani.   
\b  
\q1
\v 16 Kwie xeiyame kemɨraye'aka kaninanaimɨkɨ:  
\q2 manata kaxie kanika'iteɨtamɨkɨ me'iwaxɨkɨ.   
\b  
\q1
\v 17 Yuwaɨriyatɨ katini'uximayaka,  
\q2 ximeri meta kwi taikai katiniutahayeikawani ka'uxetɨ.   
\b  
\q1
\v 18 Mɨkɨ yukɨmana katinimaika kemɨtiyuharerutani,  
\q2 yukɨxeme pɨkakutɨtsa tɨkarikɨ yamɨti'uximayakɨ.   
\b  
\q1
\v 19 Xeitapakɨ yumamakɨ kaniwiyakamɨkɨ muxa huxarieya,  
\q2 xeimekɨta 'utsikɨikɨ kanikaunakamɨkɨ.   
\b  
\q1
\v 20 Yumamakɨ ti'uximayatɨ tixaɨtɨ memɨkatehexeiya kaniwaparewieka,  
\q2 mɨkɨkɨ kaniwatuikani kemɨ'ane memɨteheuyehɨwa.   
\b  
\q1
\v 21 Tsepa muhaɨtɨ pɨkayu'iyaritɨa yuniwema wahetsiemieme,  
\q2 mɨkɨ yunaitɨ 'aixɨa memɨte'ukemarikɨ 'ɨkari memɨwawɨtɨatɨkakɨ.   
\b  
\q1
\v 22 'Itsiwame yukɨmana mɨkɨ kanitiwipani,  
\q2 meta rinu 'ixurikiyari 'aixɨa mɨ'anene kanitiwewiwani menakatɨkɨnikɨ meta mɨyɨtsikimaɨye.   
\b  
\q1
\v 23 Meta kɨnaya 'aixɨa katinimariwani yukiekaritsie,  
\q2 mɨkɨ katinihɨritɨarieka 'itsɨkate wahamatɨa hakewa mɨkɨ meme'uwa.   
\b  
\q1
\v 24 Rinu kemariyari wewietɨ kanituaka,  
\q2 meta hɨiyamete mɨtiwewiyatɨka tetuayamete katiniwatuirieka.   
\b  
\q1
\v 25 'Aixɨa katinamamatiwani meta teɨteri yunaitɨ 'aixɨa mepɨte'ixeiya,  
\q2 mɨpaɨ 'anetɨ pɨkama kemɨtiyɨnikɨ 'uxa'atɨni warie.   
\b  
\q1
\v 26 Kepauka mutikuxata, timaiwetɨ katinikuxatani,  
\q2 kepauka mɨti'ɨkita, wanaki'erietɨ kaniyɨaneni.   
\b  
\q1
\v 27 Yukie mɨkɨ yakatiniukani tanieretɨ,  
\q2 kepauka paa mukwa'a me'iwaxɨkɨ katiniutikwa'ani.   
\b  
\q1
\v 28 Tɨɨriyamama me'anuku'uwetɨ mekanitananakeni,  
\q2 kɨnayata yaxeikɨa kaniyutemawieka 'inaki'erietɨ:   
\b  
\q1
\v 29 «Yuwaɨkawatɨ 'ukari 'aixɨa memɨte'u'iyari mekanixuaweni,  
\q2 matsi 'ekɨ yunaime pekaniwara'iwani».   
\b  
\q1
\v 30 Katiniyukwamanani kemɨ'ane witsimɨtiyuxexeiya xeikɨa meta pɨkareutetere,  
\q2 matsi 'uka Yawé mayemakaxe 'aixɨa katinaniuwamɨkɨ hetsiena mieme.   
\b  
\q1
\v 31 'Uka pumatiwani naitsarie kemɨtiukaxuxuawere,  
\q2 meta 'uximayatsikayatsie naitɨ mɨtihekɨakɨ 'aixɨa pɨraniuwani.   