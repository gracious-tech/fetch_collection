\id OBA  
\h 'Awiriyaxi 
\toc1 'Awiriyaxi 
\toc2 'Awiriyaxi 
\toc3 'Awi 
\mt1 'Awiriyaxi  
\c 1  
\p
\v 1 'Awiriyaxi kemɨtiunieritɨarie.  
\s1 'Erumi kemɨtiuka'unarie 'uyuta'ɨreka  
\r ('Awi 1-6 – Ker 49:14-16, 49:9-10)  
\p Niuki tepu'eni Yawé hetsɨa mieme, xeime niuki tuayame kaneyenɨ'ani para mɨtiwataxatɨanikɨ naitsarie nuiwarite, mɨpaɨ tiwakɨhɨawetɨ: «Hikɨmɨ, tepayekɨne tekaniwaretakwikuni».  
\b  
\p Mɨpaɨ kanaineni Yawé naimekɨmɨyɨwe 'Erumi kiekariyaritsie mieme:   
\q1
\v 2 «Tixaɨtɨ pekatihɨkɨtɨme nekamanayeitɨamɨkɨ nuiwarite watsata,  
\q2 waɨkawamekɨ pekani'uxiwe'eriwakamɨkɨ,   
\q1
\v 3 kepemɨtiyuta'ɨre pekaniu'akwamana.  
\q1 'Aita pemɨkiekɨ kwinimieme mutɨtɨtsie,  
\q2 'akiita 'ateewa paitɨ pe'akanieretɨ,  
\q1 mɨpaɨ pekatini'akuhɨaweni:  
\q2 ¿Kemɨ'ane 'ena kwiepa pɨnetsi'a'iwa?   
\q1
\v 4 Peru tsepanetɨ wapaitɨ pemuwietɨyeika kwixɨ hepaɨ,  
\q2 tsepa xurawetsixi watsata paitɨ 'a'itua pemexeiya,  
\q2 mana paitɨ nekamanakahɨamɨkɨ  
\qr —Yawé mɨpaɨ kanaineni—.   
\q1
\v 5 Xɨka tenawayamete me'u'axɨani tɨkarikɨ  
\q2 mɨkɨ naime mepɨkatenawani,  
\q1 naime mepɨkate'anutɨni ketita xeikɨa memɨteheuyehɨwa 'aixɨa mɨti'anene,  
\q2 peru 'ekɨri, kehepaɨ petika'unarieni.  
\q1 Xɨka 'itsanamete mematsi'utaxeiya,  
\q2 mɨkɨ tinaime mepɨkate'anupini.   
\q1
\v 6 Peru 'Etsahu kepemɨtiukaxeiyarie,  
\q2 tinaime pepɨtiunawatsiyarieri mɨraye'atɨka mɨti'awietsiekai paitɨ.   
\q1
\v 7 Memɨmatsiparewie mekamanitaweiyakuni kwie manu'atɨka paitɨ,  
\q2 mepɨmate'itaiya mepɨmatsiha'iwa  
\q2 mekamateni'irɨwiyakuni.  
\q1 'Ahamatɨa mexatsie memutiyaxikekai  
\q2 mɨkɨ mekamanihupiekuni.  
\q1 'Erumi 'ari tixaɨtɨ pɨkarexeiya pɨkatimaiwe.   
\q1
\v 8 'Iya tukaritsie nepɨwaka'una  
\q2 temaiwawemete 'Erumi kwieyaritsie kiekatari,  
\q2 'Etsahu hɨriyaritsie miemete memɨtemaiwawe  
\qr —Yawé mɨpaɨ kanaineni—.   
\q1
\v 9 Temani kiekatari, yukukuyamete 'ahetsɨa miemete marikakɨ mekanatixɨrikuni,  
\q2 nixewitɨ tewi pɨkayuhayewa  
\q2 'Etsahu yemurieyatsie yunaitɨ mekanikwi'iwakuni.   
\b  
\q1
\v 10 »'A'iwa Kakuwu kepemɨtiunanaimakɨ,  
\q2 pekanitewiyatsitɨariemɨkɨ,  
\q2 meta 'aheyemekɨ pekanikumaweriyariemɨkɨ.   
\q1
\v 11 Kepauka pemɨyukuxaɨtametaxɨ,  
\q2 kepauka 'ateewa kiekatari kuyaximama memɨwarehapa 'ateewa memanutaxɨriyanikɨ,  
\q1 kepauka 'ateewa kiekatari Kerutsareme kitenie memeutahaxɨa,  
\q2 meta kepauka hetsiena mieme memuyuta'iwaxɨ,  
\q2 'ekɨ 'ana mɨkɨ pekaniwanɨkaitɨni.   
\q1
\v 12 Pɨkaheuyewekai 'a'iwa hetsiemieme pemutanaweni pe'inanaimatɨ mɨtiuka'eniwakaitsie,  
\q2 kepauka waɨkawa mu'uximatɨariekai.  
\q1 Pɨkaheuyewekai 'ekɨ pemɨ'atemawieka kepauka  
\q2 Kura teɨterimama memakumaweriyarietsie.  
\q1 Hawaikɨ pɨkaheuyewekai 'axapemutaineni kepauka 'iya tukaritsie mete'uka'eniwakaku.   
\q1
\v 13 Pɨkaheuyewekai pemeutahanikɨ nekiekari kitenie  
\q2 kepauka 'iya tukaritsie memɨte'uka'eniwakai.  
\q1 Hawaikɨ pɨkaheuyewekai pe'utanawetɨ pemɨwaxeiyanikɨ me'uxiwe'eriwakaku  
\q2 meta 'iya tukaritsie mete'uka'eniwakaku.  
\q1 Tixaɨtɨ pepɨkatinawanikekai wapiini  
\q2 mɨkɨ tukaritsie me'uximatɨariekaku.   
\q1
\v 14 Pɨkaheuyewekai 'ekɨ huyeta tsimanuyeyeutsie pemɨwahupieni,  
\q2 para memɨyuta'unakai pemɨwakwinikɨ.  
\q1 Pɨkaheuyewekai pemɨwayetuani waneneɨkixiwima wahetsɨa  
\q2 'iya tukaritsie mete'uka'eniwakaku.   
\b  
\q1
\v 15 »'Ari kanehuraniri Yawé tukarieya meye'atɨanikɨ  
\q2 yunaime nuiwarite wahetsiemieme.  
\q1 'Erumi, kepemɨtiuyuri, yakatiniyɨmɨkɨ  
\q2 'ahetsie katininakeni 'uximatɨarika.   
\q1
\v 16 Yaxeikɨata 'ixaheritsixi kexemɨte'ukwinixɨ,  
\q2 hɨri mɨpatsietsie netekɨxita kexemɨtehanu'i,  
\q1 mɨpaɨta yaxeikɨa mekatenenu'ikuni yunaitɨ nuiwarite mukumane mekatehayewatɨ.  
\q2 Hikɨ yunaitɨ mehenu'ieme mekanikumawerikuni,  
\q2 hikɨ mɨpaɨ pɨtimatsiɨkɨre kename hatsuaku meka'u'uwakai.   
\q1
\v 17 Matsi Tsiyuni hɨriyaritsie wikweitsitɨarika kanitixuawerimɨkɨ, meta kanipatsiekamɨkɨ.  
\q2 Kakuwu teɨterimama yupiinitɨarika mepɨtekaxeiya.   
\q1
\v 18 Kakuwu xiɨyarimama tai kemɨtititaiya mɨpaɨ mekani'anenekuni,  
\q2 Kutse hetsɨa miemete, nerɨkwari hepaɨ mepɨ'aneneni,  
\q1 peru 'Etsahu xiɨyarimama xatsi hepaɨ mekani'aneneni:  
\q2 taikɨ kanitataiyariemɨkɨ,  
\q1 mɨpaɨ tiyɨyɨ nixewitɨ 'ayenieretɨ pɨkayuhayewa  
\q2 yunaitɨ 'Etsahu hetsɨa miemete».  
\qr Yawé yurikɨ mɨpaɨ kaniutayɨni.   
\s1 Kememɨte'uparewiya Kakaɨyari teɨterimama  
\p
\v 19 Nekexi kiekatari 'Etsahu hɨrieyatsie mekanitiyaxikuni, Tsapexi kiekatarita piritsiteutsixi wakwietsie mekanikuyaxikuni. Meta 'ixaheritsixi 'Epɨrahini meta Tsamariya wakwie kanayeimɨkɨ, Wenikamini xiɨyarimama Karaha kwieyari mekananunakikuni mana memɨtitenikɨ.   
\p
\v 20 Memehapanieta, 'ixaheritsixi kuyaxiyari hikɨ kananeutsixi wahamatɨa memu'uwa, Tsareta wakwie kaniye'atɨkaimɨkɨ. Meta Kerutsaremetari, Tseparari memɨtitei, mekaniyuhayewakuni Nekexi kiekariyaritetsie,  
\v 21 memɨtehayu'iwaxɨta mekananutikɨnikuni Tsiyuni hɨriyaritsie paitɨ, 'Etsahu hɨriyaritsie memɨtama memɨtewata'aitɨanikɨ. Meta mana Yawé pɨti'aitametɨni.   