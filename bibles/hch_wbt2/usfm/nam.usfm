\id NAM  
\h Nahumi 
\toc1 Nahumi 
\toc2 Nahumi 
\toc3 Nah 
\mt1 Nahumi  
\c 1  
\p
\v 1 Kemɨtiyɨni niukiyari Niniwe hepaɨtsita mieme. 'Ikɨ xapa kanihɨkɨtɨni Nahumi 'Erikutsi kiekame kemɨtiunieritɨarie hepaɨtsita mɨtikuxata.   
\s1 Yawé kemɨtiuyeha'a Niniwe hepaɨtsita  
\q1
\v 2 Yawé Kakaɨyari mɨtiuyukakwerie kanihɨkɨtɨni meta mɨyɨkɨhɨpa.  
\q2 Yawé mɨyɨkɨhɨpa, Ti'aitame mayu'eriya.  
\q1 Yawé pɨtiwarakapitɨwa kemɨ'ane memeye'unie,  
\q2 mɨwaraye'unie wahepaɨtsita pɨkayuhaxɨapitɨarinɨa.   
\q1
\v 3 Yawé yapauka muyeha'ani pɨkayɨwe,  
\q2 peru tɨrɨkariyaya pɨmariwe.  
\q2 Yawé tiwakwinitɨatɨ xeime tɨma pɨkahayewa.  
\q1 'Eka meta wiyeri mɨtɨrɨkawitsata kaniumieni,  
\q1 hai tumuanari kanihɨkɨtɨni ketateya hetɨa mieme.   
\q1
\v 4 Kepauka mɨkɨ mɨtita'aita haramara kaniukawaukeni,  
\q2 meta haa muhapane kaniukawaukeni.  
\q1 Watsani meta Kaximeru hɨriyaritsie 'ɨxa 'aixɨa mɨ'anene pɨtiwauke,  
\q2 meta kɨyexi 'emɨpapa Riwanu mieme kanitiyɨnareni.   
\q1
\v 5 Kakaɨyari hɨxie hɨrite kaniutiyɨyɨakani,  
\q2 meta yemurite kanika'unikeni.  
\q1 Metatsiere hɨxiena kwie kaniutayuaneni,  
\q2 meta yunaitɨ hetsiena memɨte'u'uwa.   
\q1
\v 6 ¿Kemɨ'ane pɨyɨwe mɨtiunewieni haxɨaya hepaɨtsita?  
\q2 ¿Kemɨ'ane putawikweiwe haxɨaya mɨtiyukukuinetsie?  
\q1 Haxɨaya tai hepaɨ katiniyukukuineni,  
\q2 hɨxiena tetexi kanititarikeni.   
\s1 Niniwe kiekatari memuka'unarie  
\q1
\v 7 Yawé 'aixɨa katiniuka'iyarini,  
\q2 'uximatɨarika muxuawenitsie mɨkɨ tiyu'awietame kanihɨkɨtɨni,  
\q2 meta kemɨ'ane hetsiena memɨtewiya wahetsie nunuwame kanihɨkɨtɨni.   
\q1
\v 8 Peru Niniwe kanika'unamɨkɨ  
\q2 kaniwatihautsitɨamɨkɨ waɨkawa mekaneuyewekuni,  
\q2 tsepa makuyɨwitsie mɨwaraye'unie kaniwaranukuweiyamɨkɨ.   
\q1
\v 9 ¿Kemetekuxata Yawé hepaɨtsita?  
\q2 Mɨkɨ kememɨte'uxa katiniwamuririemɨkɨ.  
\q2 Xeimieme xeikɨa pɨtiwakwinitɨani.   
\q1
\v 10 Tupiriya mɨwawaki hepaɨ mekanitixɨtsitɨariekuni,  
\q2 xuya mayuyewiya hepaɨ,  
\q2 meta tarɨwekarixi winu 'iiyarikɨ memanutikɨ hepaɨ.   
\q1
\v 11 'Ekɨ, Niniwe, 'ahetsie pɨyetɨa  
\q2 Yawé hepaɨtsita 'axamɨtikuxata,  
\q2 'axa'anemekɨ mɨ'ɨxatsita.   
\s1 Kakaɨyari teɨterimama kememɨte'utaxatɨarie  
\p
\v 12 Yawé mɨpaɨ kanaineni:  
\q1 «Tsepanetɨ 'atsiriyutsixi memɨmɨire metɨrɨkawitɨ,  
\q2 mekanikwi'iwakuni meta mekanikumaweriyariekuni.  
\q1 'Ekɨta, Kura tsepa nemɨmatsi'uhiweritɨa,  
\q2 tawariri nepɨkamatsihiweritɨani.   
\q1
\v 13 Yuku pemetɨkɨ nekanitamuramɨkɨ  
\q2 kepemɨrakuwie nekamanixɨnamɨkɨ».   
\q1
\v 14 Peru 'ekɨ Niniwe, 'ahepaɨtsita,  
\q2 Yawé 'ipaɨ katiniu'aita:  
\q1 «Tawari 'anuiwarima mepɨkatixuawere memɨmatsiha'eriwani kepemɨtitewa,  
\q2 watukita paitɨ nekaniwatitaramɨkɨ  
\q2 kakaɨyarixi memɨxixiyatɨka meta memɨkwaxiyarietɨka.  
\q1 'Ateukiya nenikuha'aritɨamɨkɨ,  
\q2 'axapemɨtiuka'iyari pemɨhɨkɨkɨ».   
\s1 Niuki Niniwe kemɨtiuka'unarie  
\q1
\v 15 Neuxei. 'Ari hɨritetsie kanakamieni,  
\q2 niuki 'aixɨa manuyɨne matɨkɨ kememɨte'ayu'iwaxɨ titaxatake,  
\q2 kemɨ'ane mɨtatitaxatɨani kayuwatɨ temexeiyanikɨ.  
\q1 Kura, 'a'ixɨarari kenewewieneniri.  
\q2 Kepemutayɨ ketinaye'atɨwani.  
\q1 'Axamemɨte'u'iyari tawari 'akwiepa mepɨkaheutahaxɨani,  
\q2 'ari mekaniukwi'iwa yunaitɨ yemekɨ.   
\c 2  
\s1 Niniwe kiekariyari kemɨtika'unarieni  
\q1
\v 1 Niniwe, 'ahepa kanamieni mɨmatsika'una,  
\q2 'ayumieme kuyaxi wapaitɨ keniwaranutinɨ'a memɨtanenierenikɨ,  
\q1 huye keneta'ɨwiyani, 'akuyaxima keniwaxeɨrieka,  
\q2 'ahetsie titakɨ pemɨtitanuani ketineha'aritɨaka.   
\q1
\v 2 Karikɨ Yawé yakatiniyurimɨkɨ Kakuwu tawari witsimɨtixeiyarienikɨ,  
\q2 meta 'Ixaheri witsimɨtixeiyarienikɨ,  
\q1 teyu'unamete mekateninawatsirieni,  
\q2 'iteɨri mukahurukarieni hepaɨ katinanuyeyani.   
\b  
\q1
\v 3 Kuyaximama memɨkamama kɨmana memeuyukunarɨma kanixetani,  
\q2 yaxeikɨa kuyaxi mekaneuxetani.  
\q1 Wakaxetate tepɨayari kaniutixawatɨreni tai hepaɨ  
\q2 mexi meyukuha'aritɨwa meyutakwinike  
\q2 meta kuyaximama yupitsikate teikɨ mekanetsetserani.   
\q1
\v 4 Kaxetate hau'erietɨ kaye'utɨa mekaniye'uwani,  
\q2 teɨteri memayukuxexeɨriwatsie mekani'axeni metewakwinitɨatɨ.  
\q1 Tai kɨxeme hepaɨ mekateniyuxexeiyatɨkani,  
\q2 meta mimierɨkari hepaɨ mekanikɨyɨaka.   
\s1 Niniwe kemɨtiuka'unarie meta kemɨtiunawatsiyarie  
\q1
\v 5 Niniwe kiekariyaritsie ti'aitame yukuyaxima 'aixɨa memɨ'anene kaniwaruta'inieni,  
\q2 mɨkɨta mexɨitɨarikakɨ mekanekaxɨrɨweni.  
\q1 Kuraru 'amatitewatsie meyumexɨitɨatɨ mekani'axeni  
\q2 mana memɨte'anutananikɨ.   
\q1
\v 6 Peru haa manutaname kaneuyepierixɨani,  
\q2 paratsiyu pɨka'unirɨme.   
\q1
\v 7 Yakatiniu'aitsieniri:  
\q2 Niniwetari 'ateewa mekananuhapaniekuni.  
\q1 'Ukari tewa'uximayatsiriwamete kukuruxi wahepaɨ mekateniutsuanani,  
\q2 meta yutawitsie mekaneuyuhutsunani hiwerikakɨ.   
\b  
\q1
\v 8 Niniwe kiekariyari haa manutaname mɨtari hepaɨ kani'aneni,  
\q2 teɨterimama mekanitayuruweni.  
\q1 «Xekeneukunuaxɨa» «Xekeneukunuaxɨarikɨ», mekateniuhiwieriwani,  
\q2 peru nixewitɨ tɨma pɨka'ukuneniere.   
\q1
\v 9 Pɨrata xekenewayetɨki.  
\q2 Huru xekenewayetɨki.  
\q1 Piinitɨarika mɨraye'atɨka pɨkati'inɨari,  
\q2 meta piinite pɨtimɨire witsimɨti'anene mɨraye'atɨka.   
\q1
\v 10 Kiekari katiniunawatsiyarieni, yuxaɨta kaniyuhayewa meta 'unitɨ.  
\q1 Wa'iyari kaniku'amɨwetɨkani,  
\q2 watunute niutiyɨyɨakatɨkani,  
\q1 wawaiyarite niutiyɨyɨakani,  
\q2 yuhɨxie mekanayetukwarawiniri.   
\s1 'Ɨrawe mɨtiyukwa'a kanimɨmɨkɨ  
\q1
\v 11 ¿Mayetsi waterɨ keranuyetɨa  
\q2 meta mayetsi tɨɨrixi waterɨ,  
\q1 hakewa maye 'uki, maye 'ukaratsi meta waniwema  
\q2 memeyu'awietakai nixewitɨ kawa'uximatɨakakɨ?   
\q1
\v 12 ¿Maye keranuyetɨa,  
\q2 yuniwema wahetsiemieme 'etsitipepeme mɨtititsanakai  
\q2 meta maye 'ukaratsi hetsiemieme yuxɨ'erika kɨipitɨa mawiwierekai,  
\q1 yuterɨta yuxɨ'erika mɨtiutahɨniyakai  
\q2 meta wai mutahɨniyakai mɨwayuti'awiwietatsie?   
\q1
\v 13 «Peru ne hikɨ nekaninuani nematsi'aye'unietɨ  
\q2 —Yawé Mɨtɨrɨkaɨye mɨpaɨ kanaineni—.  
\q1 'Akaxetate kuyaxa miemete naxi nekaniwarayeitɨamɨkɨ,  
\q2 meta 'ixiparakɨ 'aniwema mayetsi tɨɨrixi nekaniwakwimɨkɨ.  
\q1 'Akwieyaritsie kiekatari memɨtenawaya nekaniwakumaweriyamɨkɨ,  
\q2 hatsuakuri tawarita 'atupiritsixima waniuki pɨka'enierieni».   
\c 3  
\s1 Niniwe kemɨtika'unarieni  
\q1
\v 1 Xɨa'ui, kiekari xuriya pemɨtayeuriwa,  
\q2 'itarikakɨ pemɨhɨne,  
\q1 pemɨkatihayewa 'inawarikɨ,  
\q2 meta pemɨkatihayewamɨkɨ pe'amienetɨ.   
\q1
\v 2 Kaunari 'iwaɨyɨpame yuariyaya kana'eniɨriɨkɨni,  
\q2 meta kaxeta 'ɨkateya yuariyari,  
\q1 kawayutsixi watɨranari,  
\q2 kaxetate wayuariya,   
\q1
\v 3 kawayutsixi wanautsari,  
\q2 putimerɨka wa'ixiparate,  
\q1 pitsikate putixawatɨre,  
\q2 mepɨyumɨire mɨkite,  
\q1 kaxarite pukuxeɨrietɨka,  
\q2 kaxarite naitsarie kaneutiheni,  
\q2 yunaitɨ wahetsie mekanekaxɨrɨweni.   
\q1
\v 4 'Ikɨ naitɨ mɨyakatiniuyɨni waɨkawamexɨa muyutuakɨ,  
\q2 mɨkɨ 'ukaratsi tuminikɨ muyumayɨinɨa witsimɨti'ɨimari,  
\q2 mɨkɨ mɨrakumate kemɨtiwaru'irɨwiya.  
\q1 Kiekarite katiniwaru'irɨwiya wahamatɨa 'ukahuputɨ,  
\q2 meta nuiwarite wakewaiyatɨ.   
\b  
\q1
\v 5 «Ne nematsi'aye'unietɨ 'ena nekaniuweni  
\qr —Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni—.  
\q1 'Ahɨxie paitɨ 'a'iwi nenitihanimɨkɨ,  
\q2 nuiwarite memɨmatsixeiyakɨ kepemɨtimawe,  
\q2 meta te'aitamete 'atewiyarika memɨxeiyakɨ.   
\q1
\v 6 Mɨkati'itiya nekamanikawirimɨkɨ,  
\q2 nepɨmatsitewiyatsitɨani teɨteri wahɨxie nepɨmatsihɨani.   
\q1
\v 7 Yunaitɨ memɨmatsixeiya mekaniyuta'unaxɨakuni,  
\q2 mɨpaɨ menitiyuakuni: “Niniwe 'ari kaniuka'unarieni.  
\q1 ¿Kemɨ'ane puyuhiwerieka hetsiena mieme?”  
\q2 ¿Hakewa nepeikaxeiya kemɨ'ane minɨtɨani?»   
\s1 Niniwe yuheyemekɨ kemɨtika'unarieni  
\q1
\v 8 ¿Kamɨtsɨ 'ekɨ matsi 'aixɨa peti'ane keyuri Tewatsi,  
\q2 kiekari haa hixɨapa mɨyema,  
\q2 Niru hatɨayari manuyehane 'aurie mukuma,  
\q1 haramara hetsiena munua mayeitɨa  
\q2 meta haa yukuraru mayeitɨa?   
\q1
\v 9 Kutsi meta 'Ekipitu mepiparewiekai yemekɨ,  
\q2 Puti meta Riwiya meminɨ'ɨ mepɨhɨkɨtɨkai.   
\q1
\v 10 Mɨyatɨtɨ, Tewatsi kiekariyari kanehanieni 'ateewa,  
\q2 'ateewa paitɨ kananutahɨiyani.  
\q1 Niwemama mekaniutitetseweiyani  
\q2 kaye 'itsikinayaritsie.  
\q1 Teɨterimama waɨkawa memeuka'u meniyuta'iwirieni,  
\q2 meta mekaniwarutihɨani teɨteri wa'ukiyarima.   
\b  
\q1
\v 11 Yaxeikɨata 'ekɨ, Niniwe, pekanititawaimɨkɨ,  
\q2 peka'uka'iyaritɨ pekanayeimɨkɨ  
\q1 Yaxeikɨata 'ekɨ, mɨmatsi'aye'unie pemakatɨ,  
\q2 pekanitiwaumɨkɨ hakewa peme'ati'awieta.   
\q1
\v 12 'Akuraru 'amatitewa piní kanihɨkɨtɨni  
\q2 mexɨakame mieme takari mɨkwakwaxi:  
\q1 xɨka 'utakatsieni,  
\q2 kemɨ'ane mitikwani teta kaneukaxɨrɨweni.   
\q1
\v 13 Neuxei, kepauka memɨwaraye'unie memɨwatakwinitsie  
\q2 'akuyaxima 'ukarawetsixi wahepaɨ mekaniyɨaka.  
\q1 'Akwieyaritsie mieme 'ituparite heuyepietɨkaitɨ huhutatɨ kaniyuhayewamɨkɨ,  
\q2 karikɨ kɨmana mɨreunamirikekai tai kanitixɨtsitɨamɨkɨ.   
\s1 Yakɨ xeikɨa kemɨtiukuxeɨri  
\q1
\v 14 Haa waɨkawa keneuxeɨri kuyaxi 'awarita memaketɨkɨnetsie mieme,  
\q2 'akuraru 'akenatitɨriya.  
\q1 Haxupa kenekakexi, 'a'ɨkakɨ haxu 'aixɨa keneuyuri  
\q2 meta xɨnariya keneutiwewi.   
\q1
\v 15 Mana kwitɨ tai kamenitaxɨtsitɨamɨkɨ  
\q2 meta 'ixiparakɨ pekanimieriemɨkɨ,  
\q2 mɨmatsi'aye'unie 'utsika mɨtikɨme hepaɨ kametinikwaimɨkɨ.  
\q1 Kene'amɨiriyani 'utsikari wahepaɨ  
\q2 meta kene'axiɨtɨaka tekɨmemete wahepaɨ.   
\q1
\v 16 Tetuayamete 'ahetsɨa miemete pepɨwarutimɨiriyaxɨ  
\q2 xurawetsixi wareuyeta meyupaɨmeme   
\q1
\v 17 Matsiparewiwamete 'utsikari wahepaɨ mekani'aneni  
\q2 meta 'aparatsiyuta te'uximayatamete, 'etsimemɨtepepe memɨka'u'umeyari wahepaɨ,  
\q2 muhaɨtɨnitsie 'ixumeri 'amɨtɨtɨ hetsie menikayaxikeni,  
\q1 matsi tau manatinenitsie mekaniyuta'unani,  
\q2 xewitɨtɨma pɨkatimate hakewa memeyuti'awietaxɨa wataxeiyake.   
\b  
\q1
\v 18 'Atsiriyatsie ti'aitame,  
\q2 'amuxatsi wahɨwemete karima meneukutsu,  
\q2 'akuyaxima pemɨwaranayexie meneukutsixɨani.  
\q1 'Ateɨterima hɨritetsie meneutaxɨriyaxɨani,  
\q2 pumawe xewitɨ muwakuxeɨrienikɨ.   
\q1
\v 19 Kepemɨtiukakukuine 'uayeyari pumawe,  
\q2 'ahaiya pɨkayu'uayemarinɨa.  
\b  
\q1 Yunaitɨ memɨtehetimani kepemɨranuyetɨakɨ,  
\q2 'ixɨarari mekaniwewikuni ke'axapemɨranuyetɨa hepaɨtsita.  
\q1 ¿Kemɨ'ane nutsɨ puyuhayewaxɨ katiuka'eniexɨaka  
\q2 waɨkawamekɨ 'axamɨti'ane hepaɨtsita? Nixewitɨ.   