\id GEN  
\h Tsutɨarika 
\toc1 Tsutɨarika 
\toc2 Tsutɨarika 
\toc3 Tsut 
\mt1 Tsutɨarika  
\c 1  
\s1 Naitɨ kemɨtiunetɨarie  
\q1
\v 1 Tsutɨapai Kakaɨyari muyuawi  
\q2 meta kwie kaniutawewieni.   
\q1
\v 2 Kwie puyuxamuriekai meta pakumawekai,  
\q2 hapa 'ameukateewa yɨriya penukanakai.  
\q1 Kakaɨyari 'iyarieya\f + \fr 1:2 \ft \fq 'iyari\ft . Ya \fqa 'eka.\f* haa heima  
\q2 pɨyeyeikakai.   
\q1
\v 3 Hikɨ Kakaɨyari mɨpaɨ kaniutayɨni: «Hekɨariya ke'uneni».  
\q2 'Ana hekɨariya kaniuneni.   
\q1
\v 4 Kakaɨyari hekɨariya 'aixɨa katiniuxeiya,  
\q2 'ana yɨriyatsata kanipata.   
\q1
\v 5 Hekɨariya «tukari» katiniuterɨwa,  
\q2 yɨriyata «tɨkari».  
\q1 Hikɨ kaniukɨyɨre, ximerita kanayani,\f + \fr 1:5 \ft \fq tukari\ft . Huriyutsixi wahetsiemieme, xeitukari putsutɨarie 'akayuneku tau, 'atsita 'uxa'arieka 'epauka.\f*  
\q2 mexɨakame tukari kanayani.   
\b  
\q1
\v 6 Kakaɨyari mɨpaɨ kaniutayɨni:  
\q2 «'Amakuyewa ke'uneni haa hixɨapa  
\q2 ke'ipata haa taheima mieme meta kwiepa mieme».   
\q1
\v 7 Mɨpaɨ katiniuyɨni. Kakaɨyari 'amakuyewa kaniutawewieni,  
\q2 mipataxɨanikɨ haa, tahetɨa mɨtamakakɨ,  
\q2 taheimata muyemakakɨ.   
\q1
\v 8 'Amakuyewa, Kakaɨyari «muyuawi» katiniuterɨwa.  
\q2 Hikɨ kaniukuyɨre, ximerita kanayani,  
\q2 Hutarieka tukari kanayani.   
\b  
\q1
\v 9 Hikɨ Kakaɨyari mɨpaɨ kaniutayɨni: «Haa muyuawitɨa mɨtama  
\q2 ke'uyukuxeɨrieni 'axeikɨa,  
\q2 'uwakitɨ ke'ayani».  
\q1 Kemutayɨ mɨpaɨ pɨtiɨyɨ.  
\v 10 Muwaki «kwie» Kakaɨyari katiniterɨwa,  
\q2 haa muyukuxeɨri «haramara» katiniterɨwa.  
\q1 'Ixeiyatɨ Kakaɨyari «'Aixɨa pɨ'ane», kaniutayɨni.   
\q1
\v 11 Hikɨta Kakaɨyari mɨpaɨ kaniutayɨni: «Ketiutineni kwiepa,  
\q2 ke'utineni tupiriyate yuhatsiyarite hexeiyatɨ,  
\q1 'iteɨrite yutakari kehexeiyatɨkani meta yuhatsiyarite.  
\q2 Naitɨ xexuitɨ kemɨtiupitɨarie».  
\q1 Mɨpaɨ katiniuyɨni.  
\v 12 'Ana katiniutineni naitɨ,  
\q2 tupiriyate yuhatsiyari hexeiyatɨ,  
\q1 kɨyexi yu'ikwaxi yuhatsiyari hexeiyatɨ kanayani,  
\q2 naitɨ kemɨtiupitɨarie.  
\q2 Kakaɨyari mɨkɨ 'aixɨa katiniuxeiya.   
\q1
\v 13 Hikɨ kaniukuyɨre, ximerita kanayani,  
\q2 hairieka tukari kanayani.   
\b  
\q1
\v 14 Kakaɨyari mɨpaɨta kaniutayɨni:  
\q2 «Meke'utixuawere muyuawitsie hekɨariwiwamete,  
\q2 meke'ipata tukari tɨkari,  
\q1 mɨkɨ 'inɨari meke'akɨne  
\q2 taxarita, witarita, 'ahurakaku, xexerixa, tukari meta wiyari,  
\q2 'inɨariyari meke'akɨne.   
\q1
\v 15 Muyuawitsie meke'utimerɨkani,  
\q2 kwiepata memɨhekɨariwiekakɨ».  
\q1 Mɨpaɨ katiniuyɨni.  
\v 16 Kakaɨyari hutame mamariwaweme hekɨariwiwamete kaniutiwewieni,  
\q2 xeime 'anekame tau tukarikɨ mieme,  
\q1 xeimeta yakɨ tixawatɨme metseri tɨkarikɨ mieme,  
\q2 meta xurawetsixi tɨkarikɨ miemete.   
\q1
\v 17 Kakaɨyari hekɨariwiwamete muyuawitsie katiniwarukayatsa  
\q2 memɨhekɨariwiekakɨ kwiepa.   
\q1
\v 18 Pɨwarutiwewi mɨme matsi waɨkawa memɨmamariwawenikɨ tukarikɨ tɨkarikɨ,  
\q2 hekɨariya memɨpatanikɨ.  
\q1 Hikɨ Kakaɨyari «'Aixɨa pɨ'ane», kaniutayɨni.   
\q2
\v 19 Hikɨ kaniukɨyɨre, ximerita kanayani.  
\q2 Naurieka tukari kanayani.   
\b  
\q1
\v 20 Mɨpaɨ kaniutayɨni Kakaɨyari: «Yumɨiretɨ haapa meketeye'uwani,  
\q2 meketeheɨwɨtɨkani wikixi kwie heima  
\q2 muyuawi kemɨyewa».   
\q1
\v 21 Hikɨ Kakaɨyari katiniwarutiwewieni yunaime metemamariwaweme haramaratsie miemete,  
\q2 meta yunaime memɨte'ayeneniere 'etsimepepetɨ memɨkuyuatɨka memɨyuxiɨtɨa haata paitɨ,  
\q1 meta yunaime memɨte'awɨwawe,  
\q2 yuxexuime kemɨtiwarupitɨa.  
\q1 Hikɨ Kakaɨyari 'aixɨa katiniwaruxeiya.   
\q2
\v 22 'Aixɨa kaniwaruyurieni mɨpaɨ 'utaitɨ:  
\q1 «Xekeneyuxiɨtɨaka xekeneyumɨiriyani,  
\q2 xekenehɨneni haapa haramaratsie.  
\q2 Wikixi meta xekeneyɨmɨiriyani kwiepa».   
\q1
\v 23 Hikɨ kaniukuyɨre, ximerita kanayani,  
\q2 'auxɨwirieka tukari kanayani.   
\b  
\q1
\v 24 Kakaɨyari mɨpaɨ kaniutayɨni: «Xekeneyɨmɨiriyani kwiepa yunaitɨ xemayeyuyurini,  
\q2 yunaitɨ memɨteyutewatsinɨa, yeutari meta,  
\q2 yuhukama memuku'uwa kwiepa, yunaime kememɨteheupaɨme».  
\q1 Mɨpaɨ pɨtiuyɨ.  
\v 25 Kakaɨyari yunaime katiniwarunetɨani memɨteyutewatsinɨa,  
\q2 yeutari, yunaime yuhukama memɨteku'uwa,  
\q2 yunaime kemɨtiwarupitɨa.  
\q1 Kakaɨyari mɨpaɨ kaniutayɨni: «'Aixɨa pɨ'ane».   
\q2
\v 26 Mɨpaɨta kaniutayɨni: «Tewi tepɨtawewieni  
\q2 tahepaɨ tiyuxexeiyame tahepaɨ tiyɨkɨhɨaweme.  
\q1 Pɨtiwata'aitɨani ketsɨte haramaratsie miemete,  
\q2 wikixi meta muyuawitsie miemete,  
\q1 yunaime memɨteyutewatsinɨa,  
\q2 yeutari,\f + \fr 1:26 \ft \fq yeutari\ft  (tsiriyatari waniuki), \fqa naitsarie kwiepa\ft  (hepɨrayutsixi waniuki).\f*  
\q1 yunaime memɨka'ukɨniwawe  
\q2 yuhukama memuku'uwa kwiepa».   
\q1
\v 27 Kakaɨyari tewi kaniutawewieni yuhepaɨ 'anekame,  
\q2 pitawewi 'inɨarieya mayanikɨ yuhepaɨ 'anekame.  
\q1 'Uki meta 'uka pɨwarutiwewi.   
\q2
\v 28 'Aixɨa kaniwaruyurieni mɨpaɨ 'utaitɨ:  
\q1 «Xekeneyuxiɨtɨaka xekeneyɨmɨiriyani,  
\q2 kwiepa xekenehɨneni xeketene'aitani.  
\q1 Xepɨhɨritɨarieni ketsɨte haramaratsie miemete, wikixi yunaime muyuawitsie miemete,  
\q2 yunaime memɨka'ukɨniwawe yuhukama memuku'uwa kwiepa».   
\q1
\v 29 Mɨpaɨta katiniwarutahɨawe: «Ne nepɨxeyetuiri kwiepa mieme 'iteɨrite,  
\q2 naime 'iteɨrite yuhatsiyari hexeiyakame,  
\q1 naime 'iteɨrite yutakari yuhatsiyari hexeiyakame.  
\q2 Mɨkɨ naitɨ xe'ikwai pɨrayani.   
\q1
\v 30 Tupiriya nepɨxeyetuirieni, xe'ikwai mayanikɨ,  
\q2 yunaitɨ yeutari kwiepa memɨtexuawe,  
\q2 yunaitɨ wikixi muyuawitsie miemete  
\q1 yunaitɨ memeumaketɨka kwiepa».  
\q2 Kemutayɨ mɨpaɨ pɨtiuyɨ.   
\q1
\v 31 Kakaɨyari naime katiniuxeiya tita mɨtiutiwewi.  
\q2 «'Aixɨa pɨ'ane», kaniutayɨni.  
\q1 Hikɨ kaniukuyɨre, ximerita kanayani,  
\q2 'ataxewirieka tukari kanayani.   
\b  
\c 2  
\q1
\v 1 Mɨpaɨ katiniutinɨrieni muyuawi,  
\q2 kwie meta naitɨ tita hetsiena mɨtixuawe.   
\q1
\v 2 'Atahutarieka tukaritsie, Kakaɨyari kaniuka'uxipieni,  
\q2 naime mɨtiutinɨkɨ yu'uximayatsika kemɨtiuyɨhɨawixɨ.   
\q1
\v 3 Kakaɨyari 'aixɨa kaniyurieni 'atahutarieka tukari hetsiena mieme mɨpatsiekakɨ,  
\q2 'ana muka'uxipikɨ, naime yu'uximayatsika tiutinɨka muyuawi meta kwie kemɨtiutawewi.   
\q1
\v 4 Kepauka mɨtiutiwewiya muyuawi meta kwie,  
\q2 'ikɨ pɨ'ɨxatsiyari.  
\s1 'Arani meta 'Ewa  
\p Kepauka Yawé Kakaɨyari muyuawi meta kwie mutiwewi,  
\v 5 'ana 'akuxi 'iteɨrite pɨtiumawekai pɨkatitinewekai tupiriyate. 'Ana 'akuxi wiyeri Yawé Kakaɨyari pɨkakuyuitɨwakai, 'ana 'akuxi 'apɨka'uyeikakai tewi mɨtita'uximayatakɨ.  
\v 6 Matsi kwiepa kaniti'ekekaitɨni 'aɨxi. Mɨkɨ naime kwie puyuniyakai.  
\v 7 Hikɨ Yawé Kakaɨyari tewi kaniutawewieni kwiekɨ. Tsurieyatsie 'ihɨtsieka tukari kanipitɨani mayenierenikɨ muta'iwenikɨ. 'Ana 'ayeyuritɨ tewi kanayani.   
\p
\v 8 Yawé Kakaɨyari haraweri kaniutawewieni 'Ereni mɨrakutewatsie, tau manatineika hepatsie. Tewi mutawewi muwa katiniuhɨritɨani.  
\v 9 Yawé Kakaɨyari kanitinetɨani mɨtiwerekɨ naime xexuime 'iteɨrite witsitiuxuxuawereme 'aixɨa 'aneneme kwaiyari. Haraweri hixɨapa 'iteɨri tukari tiyupitɨwame kaniutinetɨani, xeimeta 'iteɨri putinetɨa mɨtimaikakɨ tita 'aixɨa mɨti'ane tita 'axamɨti'ane.   
\p
\v 10 'Ereni payeneikakai hatuxame mariwetɨ pɨ'ipakai harawerita, manata nauka 'akiyarite puhapanekai pɨtihatuiyakai harawerita.  
\v 11 Mexɨakame pɨtitewakai Pitsuni, naitsarie puyehanekai Kawira mɨrakutewatsie hakewa huru maxuawekaitsie.  
\v 12 Huru 'aixɨa pɨ'ane 'iya kwieyaritsie mieme. Puxuaweta xetsina witsi'anetɨ, puxuaweta 'unitse teteyari mutuxa.  
\v 13 Hutarieka mieme haa pɨtitewakai Kikuni mɨkɨ Kutsi kwieyaritsie 'aurie kananakuneka naitsarie.  
\v 14 Hairieka mieme haa, Tikɨritsi pɨtitewakai mɨkɨ 'Atsiriya tserieta puyehane. Naurieka mieme 'Eupɨrate hatuxameyari pɨhɨkɨ.   
\p
\v 15 Merikɨtsɨ Yawé Kakaɨyari tewi kaniuhɨritɨani haraweri 'Ereni mɨti'uximayakakɨ, mɨti'ɨwiyanikɨ.  
\v 16 Yawé Kakaɨyari kanihɨritɨani mɨpaɨ rehɨawetɨ: «Ketinekwaka naime 'ikwaxi harawerita mieme.  
\v 17 Peru mɨkɨ 'iteɨri xeikɨa, tewi xɨka 'itikwani 'ikwaxiyari mɨkɨ tewi pɨretimani tita 'aixɨa mɨti'ane tita 'axamɨti'ane, mɨkɨ 'iteɨri 'ikwaxiyari pepɨkakwaka. Mexɨka pe'itikwani, 'ana pepɨmɨni».   
\p
\v 18 Hikɨta Yawé Kakaɨyari mɨpaɨ kaniutayɨni: «'Aixɨa pɨka'ane, 'uki yuxaɨta muyeikanikɨ. Peiyehɨwa yuteɨtame. Nepitawewirieni 'iparewiwame hetsiena mieme».  
\v 19 Yawé Kakaɨyari katiniwarunetɨani 'ena kwiepa yunaime memɨte'awɨwawe meta yunaime yeutari, hikɨ Kakaɨyari 'uki hetsɨa kaniwa'atɨani muwatiterɨwakɨ yuxexuime. 'Uki kaniwarutiterɨwa yunaime kememɨteheupaɨme, hikɨ mɨpaɨ mepɨtematiwa.  
\v 20 Mɨpaɨ 'ana tewi kaniwarutiterɨwa yunaime keyupaɨmetɨ memɨtexɨawe memɨteyutewatsinɨa, yunaime memɨte'awɨwawe, yunaime yeutari. Matsi mɨkɨ nixewitɨ tewi parewiwameya yemekɨ pɨka'atɨa.   
\p
\v 21 Hikɨ Yawé Kakaɨyari 'uki heukutɨaka, waɨkawa kutsukaku kaniwakuhana 'akieya, hutariekata waiyarieya kaneunani.  
\v 22 Mɨkɨ 'uki 'akieyakɨ, Yawé Kakaɨyari 'uka kaniutawewieni, hikɨ 'uki kani'atɨirieni.  
\v 23 'Arani 'uka xeiyatɨ mɨpaɨ kaniutayɨni:  
\q1 «'Ikɨ hɨrixɨa waiyarieya newaiyaritsie pumieme,  
\q2 'umeyarieyata ne'umeyaritsie pumieme.  
\q1 “'Uka” katinitewakamɨkɨ  
\q2 'uki waiyarieyakɨ mutawewiyakɨ».   
\p
\v 24 Mɨpaɨ mɨtiuyɨkɨ, 'ayumieme 'uki kaniyupatamɨkɨ yupaapa yumaama wahetsɨa kaniyeyeimɨkɨ, yɨ'ɨya hamatɨa mekaniyutaxewirikuni meyunaki'erietɨ, xeiwaiyari mekanakɨnikuni.   
\p
\v 25 Hikɨ 'uki meta 'uka mepumamawekai mepɨkayutetewiyakai.   
\c 3  
\s1 Tewi kemɨtiu'irɨwiyarie  
\p
\v 1 Kuu, kwinimieme katinimaiwekaitɨni keyuri hipatɨ yeutari Yawé Kakaɨyari muwarutawewiekai, hikɨ 'uka mɨpaɨ pɨtiuta'iwawiyaxɨ:  
\p ―¿Kakaɨyari mɨpaɨ pɨkahainekai xɨari kename xeka'ikwaka naime 'ikwaxi harawerita mieme?   
\p
\v 2 'Uka mɨpaɨ katinita'eiya:  
\p —Tepɨyɨwawe naime 'ikwaxi temɨtikwanikɨ.  
\v 3 Mɨkɨ xeikɨa 'iteɨri 'ikwaxiyari haraweri hixɨapa muwe, tepɨkayɨwawe temitikwanikɨ Kakaɨyari pɨtarahɨawekai kename teka'ikwakakekai 'ikwaxi mɨkɨ 'iteɨritsiemieme, xɨka te'itikwani tepɨkwini.   
\p
\v 4 Kuu 'uka mɨpaɨ kaniutahɨawe:  
\p —Tixaɨ xepɨkakwini.  
\v 5 Kakaɨyari katinimaika kepauka xemitikwani mɨkɨ 'ikwaxi, kwinimieme xetemaiwawetɨ xepakɨne, xepɨtemaika tita 'aixɨa mɨti'ane, tita 'axamɨti'ane, Kakaɨyari hepaɨ xepɨ'aneneni.   
\p
\v 6 Hikɨ 'uka mɨkɨ 'ikwaxi witsi'anekame kaniuxeiya kanitihiwe'erieni mitakwanikɨ, timaiwetɨ mayanikɨ. Hikɨ kaneka'inɨni kanitakwani. Kwitɨta yɨkɨna kaniumini mɨkɨta kanitakwani.  
\v 7 'Ana kwitɨ mekananutaneniere yuhutatɨ 'arike mɨpaɨ mepɨtehetima mepɨmamawekai, hikɨ piní xawarikɨ petsera mekaniyutiwewirieni memuyutetewiyakaikɨ.   
\p
\v 8 'Uki yɨ'ɨya hamatɨa mekani'enieni Yawé Kakaɨyari harawerita 'uyeikame taikai 'ekatsie, hikɨ mekaniyuti'awieta memɨmamawekaikɨ 'iteɨritsata harawerita.  
\v 9 Peru Yawé Kakaɨyari 'uki kaniutahɨawe mɨpaɨ 'utaitɨ:  
\p —¿Hakewa pepeyeika?   
\p
\v 10 'Uki mɨpaɨ kaniutayɨni:  
\p —Nepɨmatsi'u'eni 'uwa pe'uyeikame nepɨmatsi'utimaka nemɨmawekaikɨ, 'ayumieme nepɨyuti'awietaxɨ.   
\p
\v 11 Hikɨ Kakaɨyari mɨpaɨ kaniutayɨni:  
\p —¿Kemɨ'ane mɨpaɨ matiutahɨawixɨ kename pemawekai? Mɨkɨ 'ikwaxi nemɨxemaiwe'erikatsitɨakai xekate'utikwai.   
\p
\v 12 'Uki mɨpaɨ kaniutayɨni:  
\p —Mɨkɨ 'uka pemɨnetsi'uwitɨtɨa, pɨnetsi'umi nepitakwai.   
\p
\v 13 Hikɨ Yawé Kakaɨyari 'uka mɨpaɨ katiniuta'iwawiya:  
\p —'Uka 'aku kepetiuyuri.  
\p 'Uka mɨpaɨ kaniutayɨni:  
\p —Kuu pɨnetiu'irɨwiyaxɨ 'ayumieme 'ikwaxi neputakwai.   
\p
\v 14 Yawé Kakaɨyari 'ayumieme kuu mɨpaɨ katiniutahɨawe:  
\q1 «Kuu 'aku 'axapepɨtiuyuri,  
\q2 Yeuta kiekatari watsata pe'uyeikatɨ,  
\q2 'axapekani'itɨariekamɨkɨ.  
\q1 'Ayumieme 'ahukama pepukuyeikani,  
\q2 tumuanari pekwatɨ yuheyemekɨ.   
\q1
\v 15 'Ekɨ kuu 'ukamatɨa xepayuye'unieka,  
\q2 meta 'aniwema 'uka niwemama wahamatɨa,  
\q1 'uka nu'aya xewitɨ pumatikwinitɨani 'amu'utsie,  
\q2 'ekɨta pepɨtikwinitɨani keputsayatsie».   
\p
\v 16 Meta 'uka mɨpaɨ katiniutahɨawe:  
\q1 «Kukuiniya nepɨtimɨiriya kepauka pemɨtiniweyanitsie,  
\q2 matsi 'akɨna pepinaki'erieka,  
\q2 mɨkɨ mati'aitɨwame payani».   
\p
\v 17 'Uki meta mɨpaɨ katiniutahɨawe:  
\q1 «'Uki 'aku 'Arani,  
\q2 'ekɨtsɨ pepenu'eni 'a'ɨya, pepitakwai 'ikwaxi,  
\q2 mɨkɨ kɨyetsie mieme tsepa mɨpaɨ nematiutahɨawixɨ pemɨka'ikwakakɨ.  
\q1 'Ayumieme kwie 'axakani'itɨariekamɨkɨ mɨpaɨ pemɨtiuyurikɨ,  
\q2 haweri mieme peti'uximayatɨ xeikɨa pepɨtikwaka kwiepa mieme, mexi 'ape'uyeikani.   
\q1
\v 18 Kwie kanitinetɨamɨkɨ xuya 'ahetsiemieme,  
\q2 yeuta mɨtiutixuxuawereni 'a'ikwai payeikani.   
\q1
\v 19 Tukarikɨ peti'uximayatɨ pekwaxiyatɨ 'a'ikwaite pekatinexeiyakamɨkɨ,  
\q2 mexi kwiepa pekanuaweni,  
\q2 hakewa pemetawewiya.  
\q1 Tumuanari pekanihɨkɨtɨni,  
\q2 hutarieka pekaninuamɨkɨ tumuanari pemayanikɨ».   
\p
\v 20 'Uki yu'ɨya 'Ewa pɨtiuterɨwaxɨ, mɨkɨ yunaime nuiwarite wamaama mayanikekaikɨ.\f + \fr 3:20 \ft Hepɨrayukɨ \fq 'Ewa\ft , \fqa Tukari\ft  panuyɨne.\f*   
\p
\v 21 Yawé Kakaɨyari puwarutiwewiri nawi kamixayari 'Arani meta 'ɨyaya, mɨkɨkɨ puwarutikemaritɨa.   
\p
\v 22 Hikɨ Yawé mɨpaɨ kaniutayɨni: «Hikɨri 'uki meta 'uka tahepaɨ mekani'aneneni, metemaitɨ tita 'aixɨa mɨti'ane tita 'axamɨti'ane, xɨka me'itikwani 'ikwaxi tukari mɨtiyupitɨwa, mepɨyɨwaweni yuheyemekɨ me'ayeyuyuritɨ memuyuhayewanikɨ».   
\p
\v 23 'Ayumieme Yawé Kakaɨyari kaniwaranuyeweiya teɨteri 'Ereni haraweriyarita, kaniwarupitɨani memɨte'uximayakakɨ kwiepa, 'Arani kwiekɨ mutawewiyakɨ.  
\v 24 Waranuyeweiyaka, haraweri 'Ereni tau manatineika hepatsie Kakaɨyari teɨtametemama memayeneniere meta xeime 'ixipara takame naitsarie 'uyuaneme, huye mɨ'ɨwiyanikɨ kɨye tukari tiyupitɨwame hetsɨa meutayune.   
\c 4  
\s1 Kahini meta 'Aweri  
\p
\v 1 'Arani yu'ɨya 'Ewa hamatɨa xeime nunutsi mekanayexeiya Kahini katiniterɨwa. Mɨpaɨ kaniutayɨni 'Ewa: «Yawé netsiparewiekaku nunutsi 'ukitɨme nepayexei».  
\v 2 'Ariketa hutarieka 'Aweri kanayexeiya, Kahini mutaya. 'Aweri muxatsi wahɨweme kanayani, meta Kahini kwiepa ti'uximayatame patɨa.  
\v 3 Mɨixa tukari 'anuyeyaku Kahini Yawé katiniutimawirieni tita kwiepa mɨtiuka'e.  
\v 4 'Aweri kani'atɨanita Yawé hetsiemieme muxa 'aixɨa mɨ'ane matɨari mieme muwaiya mawari mayanikɨ, Yawé 'Aweri 'aixɨa katiniuxeiya meta mawarieya pinakixɨ,  
\v 5 peru Kahini mɨpaɨ pɨkatiuxei meta mawarieya pɨka'inakixɨ. 'Ayumieme Kahini kaniuyeha'ani, yu'uximatɨatɨ 'aniuyeikakaitɨni.   
\p
\v 6 Hikɨ Yawé mɨpaɨ katinitahɨawe: «¿Titayari kwinimieme petiha'a? ¿Titayari peti'uxiwa'a petitihɨximawe?  
\v 7 Xɨka 'aixɨa petiyurienenike heitserie pekanatinierenikeyu. Xɨka 'aixɨa pekatiyurieneni, 'axamɨ'ane kamenihupieka metsiwiyake tiyukwa'ame hepaɨ. Peru 'ekɨ pekaniyɨweni peme'iwa».   
\p
\v 8 Hikɨ Kahini yumuta 'Aweri hamatɨa katiniutixata. Kepauka yeuta yuxaɨta memu'uwakai, Kahini yumuta kaniumieni.   
\p
\v 9 Hikɨ Yawé Kahini mɨpaɨ katiniuta'iwawiya:  
\p —¿Hakewari 'a'iwa 'Aweri?  
\p Kahini mɨpaɨ kaniutayɨni:  
\p —Nepɨkatimate. ¿Nekuta ne'iwa neti'ɨwiyame?   
\p
\v 10 Yawé mɨpaɨ katinitahɨawe:  
\p —Kepetiuyuri. 'A'iwa xuriyaya kwiepa kumatɨ kanahiwani ne kename 'aixɨa neketiuyurieni.  
\v 11 'Ayumieme 'axapepɨ'itɨarieka kwie hepaɨtsita, 'a'iwa xuriyaya muta'itsikɨ, 'ekɨ pemitayeuri.  
\v 12 Kepauka kwiepa pemɨka'eni, pɨkatiutixuxuawereni, kwiepa pepuyeikani peyuku'unanetɨ.   
\p
\v 13 Kahini Yawé mɨpaɨ katiniutahɨawe:  
\p —Kwinimiemeri pepɨnetikwinitɨa nepɨkayɨweri neminewieka.  
\v 14 Hikɨ pepɨnetsi'ayewei, tawarita 'ahɨxie nepɨka'uyeikani. 'Ena kwiepa nepuyeikani neyuku'awietanetɨ yu'uname hepaɨ, xewitɨ xɨka netsihanukunake pɨnetsihemieni.   
\p
\v 15 Yawé mɨpaɨ katinita'eiya:  
\p —Mɨpaɨ pepɨkaranuyeyani. Kemɨ'ane Kahini mɨmieni, katinikwinitɨariemɨkɨ 'atahutamexɨa. Hikɨ Yawé Kahini kaniu'inɨaritɨani, kemɨ'ane menukunake mɨka'ikumemiwanikɨ.   
\p
\v 16 'Ana Kahini Yawé kaniuku'eirieni, Nuri kwieyaritsie kaneyani, 'Ereni makuma tau manatineika hepatsie.   
\p
\v 17 Kahini yu'ɨya hamatɨa xeime nunutsi kanayexeiya 'Enuki katiniterɨwa. Kahini kiekari kanikamaximekaitɨni, 'Enuki katiniterɨwa yuniwe hepaɨ.  
\v 18 'Enuki xeimeta yuniwe kanayexeiya 'Irari katiniterɨwa, mɨkɨ pupaapayatɨkai Mekuyaheri. Mɨkɨta pupaapayatɨkai Metutsaheri, Metutsaherita pupaapayatɨkai Rameki.  
\v 19 Rameki yuhutame puwarutiwitɨ. Xewitɨ pɨtitewakai 'Ara meta Tsira.  
\v 20 'Ara Kawari titewakame kanayexeiya, mɨkɨ 'ixuriki kiiyari memukii meta wakaitsixi memɨwaxiɨtɨa watutsi kanayani.  
\v 21 Kawari yumuta pexeiyakai Kuwari titewakame, mɨkɨ haripakɨ meta pirikɨxakɨ memɨteyuitɨawawe watutsi patɨa.  
\v 22 Tsira meta Tuwari-Kahini kanayexeiya, tepɨa tsuname kanayani meta purunitsekɨ tiwewiwame meta tepɨakɨ. Tuwari-Kahini xeime yutaru 'ukatɨme kanexeiyakaitɨni Nuhama titewakame.   
\p
\v 23 Rameki mɨpaɨ katiniwarutahɨawe yu'ɨitama 'Ara meta Tsira:  
\q1 «Xekeneu'enana 'ukari Rameki 'ɨitamama.  
\q2 Xekeneu'eni neniuki.  
\q1 Xeime nepumi tewi  
\q2 netiukwinitɨaku,  
\q2 xeimetatsiere temaikɨ netsihetamieku.   
\q1
\v 24 Xɨka kemɨ'ane Kahini mɨmieni 'atahutamexɨa tikwinitɨariemɨkɨ,  
\q2 matsi kemɨ'ane Rameki mɨmieni haika tewiyari heimana tamamata heimana 'atahutamexɨa katinikwinitɨariemɨkɨ».   
\p
\v 25 'Arani hairiekata yɨ'ɨya matɨa xeime nunutsi mekanayexeiya, Tseti katiniterɨwa, mɨpaɨ 'utayɨka: «Kakaɨyari pɨtatsi'upitɨa xeimeta nunutsi temayexeiyakɨ, 'Aweri hetsiemieme, Kahini mimiekaikɨ».  
\v 26 Tseti xeimeta yuniwe kanayexeiya 'Enuxi katiniterɨwa. Hikɨ mana mekanitsutɨani teɨteri Yawé mehahɨawetɨ kemɨtitewa.   
\c 5  
\s1 'Arani nuiwarimama  
\p
\v 1 'Ikɨ 'Arani nuiwarimama mekanihɨkɨtɨni.  
\p Kepauka Kakaɨyari tewi mutawewi, yuhepaɨ 'aneme putawewi.  
\v 2 'Uki 'uka puwarutiwewi, meta 'aixɨa kaniwaruyurieni. Kepauka muwarutiwewi «teɨteri».\f + \fr 5:2 \ft \fq teɨteri\ft . Hepɨrayukɨ \fqa 'Arani\ft  meta \fqa teɨteri\ft  panuyɨne. \f*   
\p
\v 3 Kepauka 'Arani xeitsienituyari heimana xeitewiyari heimana tamamata wiyari mexeiyakai, xeimeta kaniutinuarieni yuhepaɨ 'anekame yuhepaɨ tiyuxexeiyame, Tseti katiniterɨwa.  
\v 4 Tseti 'utinuiwaku, 'Arani kaniuyurieni 'atahaika tsienituyari wiyari, warayexeiyaka tawarita 'ukitsi meta 'ukari.  
\v 5 'Arani kaniumɨni 'atanauka tsienituyari heimana xeitewiyari heimana tamamata wiyari hexeiyatɨ.   
\p
\v 6 Tseti pexeiyakai xeitsienituyari heimana 'auxɨwime wiyari kepauka 'Enuxi mayexei.  
\v 7 'Utinuiwaku 'Enuxi, Tseti kaniuyurieni 'atahaika tsienituyari heimana 'atahuta wiyari, warayexeiyaka tawarita 'ukitsi meta 'ukari.  
\v 8 Tseti kaniumɨni 'atanauka tsienituyari heimana tamamata heimana huta wiyari hexeiyatɨ.   
\p
\v 9 'Enuxi pexeiyakai nauka tewiyari heimana tamamata wiyari kepauka Kainahani mayexei.  
\v 10 Kainahani 'utinuiwaku, 'Enuxi kaniuyurieni 'atahaika tsienituyari heimana tamamata heimana 'auxɨwime wiyari, warayexeiyaka tawarita 'ukitsi 'ukari.  
\v 11 'Enuxi kaniumɨni 'atanauka tsienituyari heimana 'auxɨwime wiyari hexeiyatɨ.   
\p
\v 12 Kainahani pexeiyakai haika tewiyari heimana tamamata wiyari kepauka Marareri mayexei.  
\v 13 Marareri 'utinuiwaku, Kainahani kaniuyurieni 'atahaika tsienituyari heimana huta tewiyari wiyari, tawarita warayexeiyaka 'ukitsi 'ukari.  
\v 14 Kainahani kaniumɨni 'atanauka tsienituyari heimana tamamata wiyari hexeiyatɨ.   
\p
\v 15 Marareri pexeiyakai haika tewiyari heimana 'auxɨwime wiyari kepauka Kareri mayexei.  
\v 16 Kareri 'utinuiwaku, Marareri kaniuyurieni 'atahaika tsienituyari heimana xeitewiyari heimana tamamata wiyari, tawarita warayexeiyaka 'ukitsi 'ukari.  
\v 17 Marareri kaniumɨni 'atahaika tsienituyari heimana nauka tewiyari heimana tamamata heimana 'auxɨwime (895) wiyari hexeiyatɨ.   
\p
\v 18 Kareri pexeiyakai xeitsienituyari heimana haika tewiyari heimana huta wiyari kepauka 'Enuki mayexei.  
\v 19 'Utinuiwaku 'Enuki, Kareri kaniutihuni 'atahaika tsienituyari wiyari, tawarita warayexeiyaka 'ukitsi 'ukari.  
\v 20 Kareri kaniumɨni 'atanauka tsienituyari heimana haika tewiyari heimana huta (962) wiyari hexeiyatɨ.   
\p
\v 21 'Enuki pexeiyakai haika tewiyari heimana 'auxɨwime wiyari kepauka Matutsareni mayexei.  
\v 22 'Utinuiwaku Matutsareni, 'Enuki Kakaɨyari hamatɨa 'aixɨa pɨtiuyeikakai haika tsienituyari wiyari, tawarita hipame pɨwarayexei 'ukitsi 'ukari.  
\v 23 'Enuki kaniuyurieni haika tsienituyari heimana haika tewiyari heimana 'auxɨwime wiyari,  
\v 24 'aixɨa mɨtiyurienekaikɨ Kakaɨyari hamatɨa, kaniutatɨmaiyarieni Kakaɨyari meiwitɨkɨ.   
\p
\v 25 Matutsareni pexeiyakai xeitsienituyari heimana nauka tewiyari heimana 'atahuta wiyari kepauka Rameki mayexei.  
\v 26 'Utinuiwaku Rameki, Matutsareni kaniuyurieni 'atahuta tsienituyari heimana nauka tewiyari heimana huta wiyari, tawarita warayexeiyaka 'ukitsi 'ukari.  
\v 27 Matutsareni kaniumɨni, 'atanauka tsienituyari heimana haika tewiyari heimana 'atanauka (969) wiyari hexeiyatɨ.   
\p
\v 28 Rameki pexeiyakai xeitsienituyari heimana nauka tewiyari heimana huta wiyari kepauka Nuhexi mayexei.  
\v 29 Rameki Nuhexi pɨtiterɨwaxɨ mɨpaɨ mutayɨkɨ: «'Ikɨ nunutsi pɨtatsika'uxipitɨani ketemɨte'uximaya tete'uka'eniwatɨ meta ketemɨte'uximaya kwiepa Yawé 'axa'iyurieku».  
\v 30 Nuhexi 'utinuiwaku, Rameki kaniuyurieni 'auxɨwime tsienituyari heimana nauka tewiyari heimana tamamata heimana 'auxɨwime (595) wiyari, tawarita warayexeiyaka 'ukitsi 'ukari.  
\v 31 Rameki kaniumɨni 'atahuta tsienituyari heimana haika tewiyari heimana tamamata heimana 'atahuta (777) wiyari hexeiyatɨ.   
\p
\v 32 Nuhexi peixeiyakai 'auxɨwime tsienituyari wiyari kepauka Tsemi, Kami, Kapeti, muwapaapatɨkai.   
\c 6  
\s1 Teɨteri 'axakememɨte'uyuri  
\p
\v 1 Merikɨtsɨ kepauka teɨteri memutamɨirixɨ kwiepa meta 'ukari memɨwarayexei,  
\v 2 Kakaɨyari niwemama mekaniwaruxeiya teɨteri waniwema witsimemɨte'ɨimarixitɨkai, hikɨ mekaniwarutiwitɨni kemɨ'ane memɨwarutihiwe'eri.  
\v 3 Hikɨ Yawé mɨpaɨ kaniutayɨni: «'Ari ne'iyari tewi hetsie pɨkayekani, tewi mɨmɨwe xeikɨa kanihɨkɨtɨni, xeitsienituyari heimana xeitewiyari wiyari xeikɨa puyuruwani».   
\p
\v 4 Kepauka Kakaɨyari niwemama teɨteri waniwema memɨwarutiwitɨ, tɨɨri kwinimieme me'utɨtɨme mekaniwarayexeiya, kwinimieme mete'ayu'iwatɨ mekanakɨne meripaitɨ. Mana mɨtiyetɨa kwinimieme me'utɨtɨ mekaniutixuawere kwiepa.   
\p
\v 5 Hikɨ Yawé nieretɨ teɨteri ke'axa kwinimieme memɨteyuriekai, 'axamɨti'ane hetsie xeikɨa memɨyɨkɨhɨawekaikɨ,  
\v 6 kaniuta'iyarixieni titayari kwiepa tewi mɨtiutawewiekai, hikɨ 'iyarieyatsie neikwine.  
\v 7 'Ayumieme Yawé mɨpaɨ kaniutayɨni: «Tewi kwiepa nemitawewi nekanekumaweriyamɨkɨ, yaxeikɨata nekatiniyurimɨkɨ yeutari wahetsie, kuterixi meta memɨte'awɨwawe. ¿Titayari netiwarutawewi?»  
\v 8 Matsi Yawé Nuhexi kanixeiyakaitɨni, kaninakekaitɨni ke'aixɨa mɨtiuyeikakai.   
\s1 Kememɨte'utihautsitɨarie  
\p
\v 9 'Ikɨ Nuhexi kemuyɨ pɨ'ɨxatsiyari.  
\p Nuhexi 'aixɨa katiniuka'iyarikaitɨni, yakatinikamiekaitɨni yuteɨterima wahamatɨa. Kakaɨyari hetsiemieme 'aixɨa katiniuyeikakaitɨni.  
\v 10 Yuniwema yuhaikame kaniwarayexeiya: Tsemi, Kami meta Kapeti.  
\v 11 Kakaɨyari kaniuniere kwiepa 'axamɨti'ane kemɨtixuawekai, teɨteri kememɨteyunanaimakai.  
\v 12 Kakaɨyari 'uniereka kwiepa kwinimiemeri matsi 'axamɨti'ane muxuawekaikɨ teɨteri wahetsie,  
\v 13 Nuhexi mɨpaɨ katiniutahɨawe: «Teɨteri nekaniwatayuniyamɨkɨ, mɨkɨ meteyuriekaku kwiepa 'axamɨti'ane kwinimieme katinixuaweni. 'Ayumieme teɨteri nekaniwareuyehɨamɨkɨ meta kwie naime.  
\v 14 Kɨye maye'utsiya kanuwayari keneutawewi 'apakame, 'uyewaɨkawame kenayeitɨa, kwetsɨka mɨyɨwikɨ kenewakuwiri taɨtana meta herie.  
\v 15 Mɨpaɨ pakame: xeitsienituyari heimana huta tewiyari meturuyari 'ayetewime, xeitewiyari heimana haika meturuyari 'atayeukame, tamamata heimana nauka meturuyari heutitewame.  
\v 16 Kii yuheima haikakɨa manawewiya hepaɨ mɨpaɨ paɨmeme hexeiyakame keneutawewi, meriumeturuyari heutitewame 'axawatɨkaime 'anakunekame yukanamiki hetɨa meta yu'etsata yu'itupari hexeiyakame.  
\v 17 Ne haa waɨkawa nekananɨ'amɨkɨ kwiepa, yunaitɨ memɨtekwinikɨ kwiepa memɨte'u'uwa memɨte'ayeneniere.  
\v 18 Peru 'ekɨ hamatɨa ne tɨratu tepexeiyani, kanuwa 'amɨtimariwetsie xekaneutahaxɨakuni 'ekɨ meta 'aniwema, 'a'ɨya meta 'amu'e'ema.  
\v 19 Ketiniwareuta'ɨna kanuwa 'amɨtimariwetsie yuhuhutame yunaime kwiepa memɨte'u'uwa memɨte'ayeneniere, 'uki 'uka mame xeikɨa, yunaime memɨtexuawe.  
\v 20 'Ahamatɨa mekaneutahaxɨakuni yuhuhutatɨ memɨte'awɨwawe, tewaxi meta yeutari, kuterixi, memɨtawikwenikɨ.  
\v 21 Meta waɨkawa 'ikwaite ketinekuwawa ketineuta'ɨna, 'ahetsiemieme meta tewaxi wahetsiemieme, xemɨtekwakakɨ».  
\v 22 Hikɨ Nuhexi mɨpaɨ katiniuyurieni, Kakaɨyari kemɨtita'aitɨa.   
\c 7  
\p
\v 1 Hikɨ Yawé Nuhexi mɨpaɨ katiniutahɨawe: «'Ekɨ xeikɨa 'aixɨa pekatiniuka'iyarini 'ena pemuyeika, kanuwa 'amɨtimariwetsie keneutahaki 'atɨɨriyama xeyunaitɨ.  
\v 2 Yunaime tewaxi mawariyari memɨnaki'eriwa, keniwareuta'ɨna me'atahutame 'ukitsi meta 'ukari, yeutari 'aixɨa memɨka'anene mawariyari yuxexuime 'ukitsi meta 'ukari.  
\v 3 Memɨte'awɨwaweta yunaime me'atahutame, 'ukitsi meta 'ukari, memɨkaheuyewautsenikɨ 'ena kwiepa.  
\v 4 Karikɨ 'atahutarieka tukari 'aye'ayu, wiyeri nekaniyuitɨamɨkɨ 'ena kwiepa mɨkawiyekɨ huta tewiyari tukari meta tɨkarikɨ, mɨpaɨ nekatiniwarakumaweriyamɨkɨ kwiepa memɨtama nemɨwarutawewi».   
\p
\v 5 Nuhexi naime yakatiniuyurieni Yawé kemɨtita'aitɨa.  
\v 6 'Ataxewime tsienituyari wiyari pexeiyakai Nuhexi, kepauka mɨtiutihauritɨxɨ.  
\v 7 Hikɨ kaneutahani kanuwa 'amɨtimariwetsie niwemama yunaitɨ, 'ɨyaya meta mu'e'emama, meyutawikweitsitɨanike mɨtitihauritɨkekaikɨ.  
\v 8 Yunaitɨ tewatsiekate memɨmawarɨwa meta memɨkamawarɨwa yeutari, memɨte'awɨwawe meta kuterixi,  
\v 9 mekaneutahaxɨani Nuhexi hamatɨa yuhuhutatɨ meheuyuti'iwatɨkaitɨ 'uki 'uka, Kakaɨyari kemɨra'aitakai.  
\v 10 'Atahutarieka tukari 'anukayaku, wiyeri kanitsutɨani kwiepa memɨtihaunitsie mieme.   
\p
\v 11 Kepauka Nuhexi 'ataxewime tsienituyari wiyari mexeiyakai, hutarieka metseriyaritsie tamamata heimana 'atahuta tukariyaritsie, 'ana haramaratsie haa patinexɨa, muyuawitsie pɨreuyepierixɨa mɨkawiyekɨ.  
\v 12 Huta tewiyari tukari meta tɨkari kaniwiyekaitɨni kwiepa.  
\v 13 Mɨkɨ tukaritsie Nuhexi kanuwatsie mekaneutahaxɨani, niwemama Tsemi, Kami meta Kapeti, Nuhexi 'ɨyaya meta mu'e'emama yuhaikatɨ.  
\v 14 Wahamatɨa mekaneutahaxɨani yunaitɨ yeutari meta tewaxi, kuterixi metatsiere memɨte'awɨwawe.  
\v 15 Mɨpaɨ mekateneutahaxɨani kanuwa 'amɨtimariwetsie Nuhexi hamatɨa yunaitɨ meheuyuti'iwatɨkaitɨ kwiepa memɨtexuawe,  
\v 16 yunaitɨ memɨtexuawe yɨkɨ mete'anenetɨ, mekaneutahaxɨani meheuyutinɨtɨ 'uki 'uka, Kakaɨyari Nuhexi kemɨra'aitɨwakai. Hikɨ Yawé 'ana katineunani kitenie kanuwatsie.   
\p
\v 17 Hikɨ karima kaniwiyekaitɨni huta tewiyari tukari. Kepauka haa muwayenexɨa kanuwa 'amɨtimariwe kananuyewiere kwie heima.  
\v 18 Hikɨ matsi haa waɨkawa kanewayenetɨkateitɨni haa kanitimiekaitɨni, kanuwata kananuyewiekaitɨni hetsiena.  
\v 19 Waɨkawa haa kanitiyani hɨri 'amanutitɨtɨ kwiepa meutitekai naime kaneuyunitɨaxɨani.  
\v 20 Hɨri heima 'atahuta meturuyari kuxi haa kanitiyani.  
\v 21 Mɨpaɨ mekateneuyehɨiyani kwiepa memɨte'u'uwakai: memɨte'awɨwawe, yeutari, tewaxi, kuterixi, metatsiere teɨteri.  
\v 22 Yunaitɨ mekateniukwini kwiepa memɨte'u'uwakai, yunaitɨ memɨte'ayeyuyurikai.  
\v 23 Kakaɨyari kwiepa katiniwarakuyeitɨani yunaime memɨte'u'uwakai, teɨteri meta tewaxi meta yeutari, kuterixi, meta memɨte'awɨwawe meteyunaime. Yunaitɨ mekatenakuyeituarieni kwiepa memu'uwakai. Nuhexi xeikɨa mekaniuyuhayewa meta kemɨ'ane hamatɨana memɨyetekai kanuwa 'amɨtimariwetsie.  
\v 24 Xeitsienituyari heimana huta tewiyari heimana tamamata tukari kwie kaneuyunekaitɨni.   
\c 8  
\p
\v 1 Merikɨtsɨ Kakaɨyari Nuhexi kanaye'erieni meta yeutari, tewaxi hamatɨana memɨyetekai kanuwatsie. 'Eka kaniuyuitɨani, waɨkawa tɨrɨkaɨyetɨ kaniuku'eka, 'ana haa kanitsutɨani 'etsiwa kawaximetɨ.  
\v 2 Haramara tetɨata haa matineikakai kaneunarixɨani, muyuawitsieta katineunarixɨani, wiyerita katiniuhayewa.  
\v 3 Haa kanikawaximekaitɨni 'anɨari kwiepa. Xeitsienituyari heimana huta tewiyari heimana tamamata tukari heutineku, haa waɨkawa kanikawaximekaitɨni.  
\v 4 'Atahuta metseritsie tamamata heimana 'atahuta tukaritsie kanuwa kananutateni 'Ararati hɨriyaritsie.  
\v 5 Haa tsietɨ kanikamiekaitɨni, tamamata metseritsie mexɨakame tukaritsie waɨkawa hɨri petihekɨarixɨa.   
\p
\v 6 Huta tewiyari tukari 'aye'aku, Nuhexi 'itupari 'etsimɨyewa kaneuyepieni kanuwa 'amɨtimariwe kanamikieyatsie mewewiekai,  
\v 7 hikɨ kwatsa kaniutatuani, mɨkɨ mana xeikɨa kaniuwietɨyeikakaitɨni, 'ikwewietɨ haa mɨkawanikɨ.  
\v 8 Tawarita kukuru meutuxa kaniutatuani, timaimɨtɨ xɨka'akuri haa waɨkawa kawatɨyani.  
\v 9 Kukuru kaninuani kanuwatsie memawekaikɨ hakewatsɨ heka'uxipieni haa 'akuxi kwie manukanakaikɨ. Nuhexi yumama kaneutatsera, 'enutuka mana kanuwatsie kaneitatuani.  
\v 10 Tawarita 'atahuta tukari 'anukayaku, hutariekata kukuru kaniutatuani.  
\v 11 Kɨyɨrirɨmekaku kukuru kaninuani, yuyekaraukɨ huriwa yɨrariyari 'atɨtɨ hekwame yurime. 'Anari Nuhexi mɨpaɨ katinetimani kename haa kawatɨyakai kwieri hahekɨakai.  
\v 12 Tawarita 'atahuta tukari kanikakwewieni, hairiekari kukuru kanenɨ'ani, 'anari kukuru pɨkanua.   
\p
\v 13 'Ataxewime tsienituyari heimana xewi wiyari pexeiyakai Nuhexi kepauka haa mukawa. Mexɨakame metseriyaritsie mexɨakame tukaritsie Nuhexi kanuwa 'amɨtimariwe kanamikieya kananutiyepieni meta kwie mɨwakini hepaɨ katinixeiyakaitɨni.  
\v 14 Hutarieka metseritsie xeitewiyari heimana 'atahuta tukaritsie, kwieri waɨkawa kaniwakikaitɨni.  
\v 15 'Anari Kakaɨyari Nuhexi mɨpaɨ katiniutahɨawe:  
\v 16 «Kanuwatsie kenanayeye'ari 'atɨɨriyama, 'a'ɨya, 'amu'e'ema yunaitɨ.  
\v 17 Yaxeikɨata keniwaranaye'ari 'ahamatɨa memɨteye'ɨnekai: memɨte'awɨwawe, tewaxi meta kuterixi. Mekeyumɨiriyani, mekeyuxiɨtɨaka, kwiepa mekehɨneni».   
\p
\v 18 Hikɨ kanuwatsie mekananayekɨne, Nuhexi meta niwemama, 'ɨyaya meta mu'e'emama.  
\v 19 Mekatenanayekɨneta yunaitɨ: tewaxi, memɨte'awɨwawe, metatsiere yunaitɨ kuterixi, meta kwiepa memɨtexuawe yuxexuitɨ yɨkɨ memɨte'anene.   
\p
\v 20 Hikɨ Nuhexi mawari tenutsariyari kaniutawewieni Yawé hetsiemieme, mana katiniwarutitaiya tewaxi memɨmawarɨwa meta memɨte'awɨwawe memɨmawarɨwa.  
\v 21 Kepauka Yawé 'ɨakariyari witsimu'ɨa mu'ukwixɨ mɨpaɨ katiniuyuhɨawe:  
\p «Tsepa teɨteri tɨɨriyari paitɨ 'axamemɨteyurie, tawarita kwie 'axanepɨkayurieni tewi ya'ane wiwiekaku. Metatsiere hatsuakuri nepɨkatiwakwini kwiepa memɨtexɨawe, hikɨ kenemɨtiuyuri.   
\q1
\v 22 »Mexi'akuxi kwie 'atsikayɨwe,  
\q2 pɨtiuka'etsitɨreni pɨtiuka'itsanatɨreni,  
\q1 Xexerixa payeikani meta pukuxɨxɨreni,  
\q2 witarita payeikani meta taxarita,  
\q2 pukuhekɨkɨareni meta pukuyɨyɨreni».   
\c 9  
\s1 Kakaɨyari tɨratu kemɨtiuwewi Nuhexi hamatɨa  
\p
\v 1 Kakaɨyari Nuhexi 'aixɨa kaniuyurieni meta niwemama mɨpaɨ 'utaitɨ: «Xekeneyuxiɨtɨaka, xekeneyumɨiriyani kwiepa xekenehɨneni.  
\v 2 Yunaitɨ kwiepa memɨtexuawe mepɨtexemakaxeni: memɨte'awɨwawe, yeutari, kuterixi, ketsɨte haramaratsie memɨteye'uwa. Yunaime xepɨtewata'aitɨani.  
\v 3 Yunaitɨ memɨtekuyuatɨka memɨte'ayeneniere meta mɨtitsitsiɨrawi tupiriyate xe'ikwaite katinayeimɨkɨ. Ne naime 'ikɨ nekatinixeyetuirieka.  
\v 4 Peru xeikɨa 'ayeniereme xepɨkakwa'ani, wai 'ayexureme nekanixatani xuriyatsie tukari muxuawekɨ.  
\v 5 Yurikɨtsɨ xuriyakɨ nekatinixetawawiriemɨkɨ. Yunaime yeutari yunaime teɨteri kememuyuyurieka nekaniwaxeiyakamɨkɨ.   
\q1
\v 6 »Xɨka xewitɨ tewi xuriyaya 'utayeurieni,  
\q2 mɨkɨta xewitɨ tewi kanimiemɨkɨ,  
\q1 tewi mutawewiyakɨ  
\q2 Kakaɨyari hepaɨ 'anetɨ.   
\p
\v 7 »Xeme matsi xekeneyumɨiriyani, xekeneyuxiɨtɨaka, kwiepa xekenehɨneni».   
\p
\v 8 Tawarita Kakaɨyari Nuhexi meta niwemama katiniwarutaxatɨani, mɨpaɨ katiniwarutahɨawe:   
\p
\v 9 «Ne tɨratu nepɨwewieni xehetsie, xexiɨyarimata wahetsie,  
\v 10 meta yunaime xehamatɨa memɨte'u'uwa wahamatɨa, tatsɨari yunaitɨ kwiepa memɨtexuawe kanuwatsie memɨyetekai: memɨte'awɨwawe, tewaxi meta yeutari.  
\v 11 'Ikɨ netɨratu kanihɨkɨtɨni: Tawarita teɨteri mepɨkaheuyehɨiyani wiyerikɨ, tawariri pɨkatitihauritɨ yunaime mɨtiwareuyehɨpakɨ».   
\p
\v 12 Tawarita Kakaɨyari mɨpaɨ kaniutayɨni: «Tɨratu 'inɨariyari nepɨxexeitsitɨani yuheyemekɨ xehetsiemieme meta yunaime xehamatɨa memɨte'u'uwa memɨte'ayeneniere:  
\v 13 Haiwitɨritsie nekuwiwi nekaniuyeteni, mɨkɨ kani'inɨaritɨkamɨkɨ kwie hamatɨa tɨratu kenemɨtiuwewi.  
\v 14 Kepauka kwiepa haiwitɨri nemanunɨ'ani, hetsiena xɨka nekuwiwi 'uyehuni,  
\v 15 nepaye'erieni tɨratu kenemɨtiuwewi xehamatɨa meta yunaime kwiepa memɨtexuawe wahamatɨa. Hatsuakuri waɨkawa pɨkakawiye mɨtiwareuyehɨanikɨ memɨtekwiwawe.  
\v 16 Kepauka nekuwiwi haiwitɨritsie manutahuni, ne ne'ixeiyame nepaye'erieni tɨratu kenemɨtiuwewi yuheyemekɨ xehamatɨa meta yunaime kwiepa memɨtexuawe wahamatɨa».   
\p
\v 17 Kakaɨyari katinanunɨni Nuhexi mɨpaɨ tikɨhɨawetɨ: «'Ikɨ kanihɨkɨtɨni tɨratu nemuwewi yunaime kwiepatari wahetsiemieme».   
\s1 Nuhexi niwemama  
\p
\v 18 Nuhexi niwemama kanuwatsie memanayekɨ mekanihɨkɨtɨkaitɨni: Tsemi, Kami meta Kapeti. Mɨkɨ Kami xeime payexei yuniwe Kanani titewakame.  
\v 19 'Ikɨ meyuhaikatɨ Nuhexi niwemama kiekari mepukama naitsarie kwiepa.   
\p
\v 20 Hikɨ Nuhexi kwiepa kaniuti'etɨyani, meta kaxie kaniuka'iteɨta.  
\v 21 Heiwa kaxie winuyari kaniuti'ieni kaniutitaweni, mawetɨ katiniuhuni 'ixuriki kiiyarita paitɨ.  
\v 22 Kami Kanani paapaya, yupaapa kaniuxeiya maweme, hikɨ mɨkɨ katiniwarekuxatɨani yu'iwama.  
\v 23 Tsemi Kapeti hamatɨa mata 'ixurikiyari me'utihurieka yunaiparitsie meheitiyexɨaka, yukutama me'uhutɨ mekanenukanani yupaapa mɨmawekaikɨ. Mɨkɨ mepɨka'ixei maweme, xaɨtsiepɨta memeukunenierekaikɨ.   
\p
\v 24 Hikɨ kepauka Nuhexi mukatawaiparixɨ, pɨretima nu'aya hetsimɨyumate mixeiyakaikɨ.  
\v 25 Mɨpaɨ kaniutayɨni:  
\q1 «Kanani 'axake'itɨarieka.  
\q2 'Iwamama memɨyuhuta  
\q2 yemekɨ mepɨte'i'aitɨaka waɨriyarika».   
\p
\v 26 Mɨpaɨta kaniutayɨni:  
\q1 «'Aixɨa ketikɨhɨawarɨwani Yawé Tsemi Kakaɨyarieya.  
\q2 Kanani ke'ayani waɨriyarika ti'uximayatsiriwame.   
\q1
\v 27 Kakaɨyari Kapeti kwieya 'ake'utayeuriya.  
\q2 Tsemi manukatsie Kapeti ke'ukani,  
\q2 Kanani tiwa'uximayatsiriwame ke'ayani».   
\p
\v 28 Kepauka memutihau waritana Nuhexi 'apuyeikakai 'akuxi haika tsienituyari heimana huta tewiyari heimana tamamata wiyari.  
\v 29 'Atanauka tsienituyari heimana huta tewiyari heimana tamamata (950) wiyari hexeiyatɨ kaniumɨni.   
\c 10  
\s1 Nuiwarite kwiepa  
\r (Tsut 10:2-31 – Tsut 11:10-27, 1Kem 1:5-27)  
\p
\v 1 'Ikɨ mepɨhɨkɨ Tsemi, Kami meta Kapeti Nuhexi niwemama meta wanuiwarima, tiutihauritɨkuke memɨwarayexei.   
\li1
\v 2 Kapeti tɨɨriyamama\f + \fr 10:2 \ft \fq Tɨɨriyamama\ft  panuyɨne \fqa nuiwarimamata. \f* mɨpaɨ mepɨtetetewakai: Kumexi, Makuki, Marahi, Kawani, Tuwari, Metseki meta Tiratsi.   
\li1
\v 3 Kumexi tɨɨriyamamata: 'Atsikenatsi, Xipati meta Tukaxima.   
\li1
\v 4 Kawani tɨɨriyamamata: 'Eritsaha, Taritsi, Kitini meta Xuranini.\f + \fr 10:4 \ft \fq Xuranini\ft  waɨkawa pɨhekɨa, heiwa \fqa Ruranini.\f*   
\p
\v 5 Hipatɨ mɨkɨ haramara tetsita memɨtiyaxixɨ, yuxexuitɨ yunuiwarima mehexeiyatɨ mepakɨ yukwie meta yuniuki.   
\li1
\v 6 Kami tɨɨriyamamata mɨpaɨ mepɨtetewakai: Kutsi, Mitsirahini, Puti meta Kanani.   
\li1
\v 7 Kutsi tɨɨriyamamata mepɨtetewakai: Tsewa, Kawira, Tsaweta, Xakama meta Tsaweteka.  
\li1 Xakama niwemama Tsawa meta Rerani mepɨhɨkɨ.   
\p
\v 8 Kutsi Nimiruri paapaya pɨhɨkɨtɨkai, mutamariwaxɨ mexɨakame tewi kwinimieme titɨrɨkaɨyetɨ matɨakɨ 'ana,  
\v 9 mɨkɨ waɨkawa reutamiewetɨ meta heuyutamiewetɨ kamatɨ kanayani Yawé hɨxie. 'Ayumieme hipatɨ mɨpaɨ meputiyuane: «'Ikɨ tewi Nimiruri hepaɨ pɨreuyutamiewe Yawé hɨxie».  
\v 10 Kiekarieya 'amɨtimamariwawekai mɨra'aitakaitsie kanihɨkɨtɨkaitɨni Waweri, 'Ereki, 'Akari, meta Karine, Tsinaxi kwieyaritsie.  
\v 11 Mɨkɨ kwieyaritsie 'uyeikatɨ Nimiruri kaneyani 'Atsuxi paitɨ, manata kanitiwewieni Niniwe kiekariyari, Xekuwuti-'Ixi meta Kahara  
\v 12 meta Xetseni, kiekari mɨmariwe Niniwe meta Kahara wahixɨapa mɨyema.   
\b  
\li1
\v 13 Mitsirahini, watutsi kanayani rureutsixi, 'anameutsixi, rehawitsixi, natuhitsixi,  
\v 14 paturutseutsixi, katsurukitsixi meta katuritsixi mɨkɨ piritsiteutsixi wanuiwarima memakɨ.   
\li1
\v 15 Kanani nu'aya Tsiruni kanayani matɨarieya, hutarieka mieme Heti,  
\v 16 meta nuiwarimama kewutseutsixi mekanihɨkɨtɨkaitɨni metatsiere 'amuxeutsixi, keriketseutsixi,  
\v 17 heweutsixi, 'aratseutsixi, tsineutsixi,  
\v 18 'axiwareutsixi, tsemareutsixi metatsiere kamatitsixi.  
\p Hikɨta 'ikɨ nuiwarite kananeutsixi mekaneuyutaxɨriexɨani,  
\v 19 mɨkɨ wakwie kaniye'atɨyani Tsiruni tsutɨarietɨ Keraxi paitɨ 'u'atɨ meta Kahatsa paitɨ, Tsuruma hepatsieta, Kumuxa, 'Arimaha, meta Tsewuhini, metatsiere Ratsa paitɨ.   
\p
\v 20 'Ikɨ Kami nuiwarimama mekanakɨne, yuxexuitɨ yuxiɨyarima mewarexeiyatɨ meta yuniuki, yukwie meta yunuiwarite.   
\p
\v 21 Tsemi, Kapeti matsikaya, 'Ewexi niwemama watutsi kanihɨkɨtɨkaitɨni, mɨkɨta tɨɨri kaniwarayexeiya.   
\li1
\v 22 Tsemi niwemama mekanihɨkɨtɨkaitɨni: 'Erami, 'Atsuxi, 'Axipatsari, Ruri, meta 'Arami.   
\li1
\v 23 'Arami niwemamata mekanakɨne: 'Utsi, Huri, Ketexi, meta Mahatsi.   
\li1
\v 24 'Axipatsari Tseraki paapaya kanayani. Meta Tseraki 'Ewexi paapaya patɨa.   
\li1
\v 25 'Ewexi yuhutame yuniwema pɨwarayexei: matɨarieya Pereki pɨtitewakai, 'ana kwie mutixitekiekɨ, hutarieka miemeta pɨtitewakai Kutani.\f + \fr 10:25 \ft Hepɨrayukɨ \fq Pereki\ft  panuyɨne \fqa kwie mutixitekie.\f*   
\li1
\v 26 Kutani meta puwapaapatɨkai: 'Arimurari, Tserepi, Katsaxi-Maweti, Yeraki,  
\v 27 Harurani, 'Utsari, Rikɨra.  
\v 28 'Uwari, 'Awimaheri, Tsawa,  
\v 29 'Upixi, Kawira meta Kuwawi. Yunaitɨ 'ikɨ Kutani niwemama mepakɨ,  
\v 30 mɨkɨ Metsa kwieyaritsie mepɨtitekai meta Tsepaxi paitɨ, tau manatineika hepatsie mɨhɨriyatsie.   
\p
\v 31 'Ikɨ mepɨhɨkɨ Tsemi niwemama wanuiwarima meta yuniuki mehexeiyatɨkaitɨ yukwie meta yunuiwarite.   
\b  
\p
\v 32 'Ikɨ mekanihɨkɨtɨni Nuhexi xiɨyarimama waniwema, kememɨteheukunuiwa, meta wakwie naitɨ. 'Ikɨ waxiɨyarima wahetsie mekanayenexɨani naitɨ kiekari mɨtama kwiepa, kepauka memutihau reutiyetana.   
\c 11  
\s1 Teɨteri tuxiyu kememɨte'utawewi  
\p
\v 1 Merikɨtsɨ mɨkɨ tukaritsie teɨteri xeiniukiyari xeikɨa mekanexeiyakaitɨni naitsarie kwiepa.  
\v 2 Hikɨ mehekɨneka tau manatineika hepatsie, mekanitaxeiya hakuwerime Tsinaxi kwieyaritsie, mana mekanikuyaxe.  
\v 3-4 Hikɨ mɨpaɨ mekateniuxata: «Kiekari tepɨkamani xeime tuxiyu hexeiyakame muyuawitsie heuti'akame, xɨnariya tepɨtiwewieni tepititaiya. Mɨpaɨ teteyurieyu 'aixɨa tepɨtexeiyarieni, meta tepɨkataxɨriyaxɨani naitsarie kwiepa». 'Ana xɨnariya mekaniuyurieni tetexi mɨkaxuawekaikɨ, kwetsɨka mɨyɨwi mekaniuyurieni mana kwieta matineikakaikɨ tsepa haxu muxuawekai.   
\p
\v 5 Hikɨ Yawé kaniukateni kiekari mɨxeiyakɨ meta tuxiyu teɨteri memiwewietɨwekaikɨ,  
\v 6 mɨpaɨ kaniutayɨni: «Yunaitɨ mepɨxeikiekariyari meta xeiniukiyari xeikɨa mepexeiya, 'ayumieme mɨkɨ 'uximayatsika meputsutɨa, kememɨtexata yamepɨteyurieni.  
\v 7 Matsi 'aixɨa pɨyɨni waniuki nepɨpataxɨani, memɨkayu'eniekakɨri yunaitɨ».   
\p
\v 8 Mɨpaɨ Yawé waruyurieku mekaneutayeixɨani naitsarie kwiepa, mekateniuhayewata me'iwewietɨwetɨ kiekari.  
\v 9 'Ayumieme mɨkɨ kiekari Waweri katiniuterɨwarieni, mana Yawé waniuki kaniupataxɨani teɨteri kwiepa memɨtama yunaime memɨkayu'eniekakɨ, manata yaxeikɨa naitsarie mɨwareutaxɨriexɨakɨ.   
\s1 Tsemi nuiwarimama  
\r (Tsut 11:10-27 – Tsut 10:21-31, 1Kem 1:17-27)  
\p
\v 10 'Ikɨ Tsemi nuiwarimama wa'ɨxatsi kanihɨkɨtɨni:  
\p Kepauka teɨteri memutihau huta wiyari 'anuyemiekaku kepauka Tsemi xeitsienituyari mexeiyakai, 'ana nu'aya 'Axipatsari kaniutinuiwa.  
\v 11 'Axipatsari 'utinuiwaku Tsemi kaniutihuni 'akuxi 'auxɨwime tsienituyari wiyari, tawarita warayexeiyaka 'ukitsi 'ukari.   
\p
\v 12 Kepauka 'Axipatsari xeitewiyari heimana tamamata heimana 'auxɨwime wiyari mexeiyakai, niweya Tseraki kaniutinuiwa.  
\v 13 Tseraki 'utinuiwaku, 'Axipatsari kaniutihuni 'akuxi nauka tsienituyari heimana haika wiyari, tawarita warayexeiyaka 'ukitsi 'ukari.   
\p
\v 14 Kepauka Tseraki xeitewiyari heimana tamamata wiyari mexeiyakai, niweya 'Ewexi kaniutinuiwa.  
\v 15 'Ewexi 'utinuiwaku Tseraki kaniutihuni 'akuxi nauka tsienituyari heimana haika wiyari, tawarita warayexeiyaka 'ukitsi 'ukari.   
\p
\v 16 Kepauka 'Ewexi xeitewiyari heimana tamamata heimana nauka wiyari mexeiyakai, niweya Pereki kaniutinuiwa.  
\v 17 Pereki 'utinuiwaku 'Ewexi kaniutihuni 'akuxi nauka tsienituyari heimana xeitewiyari heimana tamamata wiyari, tawarita warayexeiyaka 'ukitsi 'ukari.   
\p
\v 18 Kepauka Pereki xeitewiyari heimana tamamata wiyari mexeiyakai, niweya Xehu kaniutinuiwa.  
\v 19 Xehu 'utinuiwaku Pereki kaniutihuni 'akuxi huta tsienituyari heimana 'atanauka wiyari, tawarita warayexeiyaka 'ukitsi 'ukari.   
\p
\v 20 Kepauka Xehu xeitewiyari heimana tamamata heimana huta wiyari mexeiyakai, niweya Tseruki kaniutinuiwa.  
\v 21 Tseruki 'utinuiwaku Xehu kaniutihuni 'akuxi huta tsienituyari heimana 'atahuta wiyari, tawarita warayexeiyaka 'ukitsi 'ukari.   
\p
\v 22 Kepauka Tseruki xeitewiyari heimana tamamata wiyari mexeiyakai, niweya Nakuxi kaniutinuiwa.  
\v 23 Nakuxi 'utinuiwaku Tseruki kaniutihuni 'akuxi huta tsienituyari wiyari, tawarita warayexeiyaka 'ukitsi 'ukari.   
\p
\v 24 Kepauka Nakuxi xeitewiyari heimana 'atanauka wiyari mexeiyakai, niweya Teraki kaniutinuiwa.  
\v 25 Teraki 'utinuiwaku Nakuxi kaniutihuni 'akuxi xeitsienituyari heimana tamamata heimana 'atanauka wiyari, tawarita warayexeiyaka 'ukitsi 'ukari.   
\p
\v 26 Kepauka Teraki haika tewiyari heimana tamamata wiyari mexeiyakai, mekaniutinunuiwakaitɨniri niwemama 'Apɨrami, Nakuxi, Karani.   
\s1 Teraki nuiwarimama  
\p
\v 27 'Ikɨ Teraki kemuyɨ 'ɨxatsieya kanihɨkɨtɨni, 'Apɨrami, Nakuxi meta Karani wapaapa.  
\p Karani Ruti pupaapayatɨkai,  
\v 28 Karani kaniumɨni 'Uxi karireutsixi wakwieyaritsie, matinuiwaxɨtsie, paapaya Teraki 'ayeyurikaku 'akuxi.  
\v 29 'Apɨrami Tsarahi kaniutiwitɨni, meta Nakuxi Mirika kaniutiwitɨni Karani niweya, mɨkɨ tawarita xeime 'uka kanayexeiya 'Itsika titewakame.  
\v 30 Perutsɨ Tsarahi pɨkaniwewekai, pɨkayɨwekai tɨɨri mɨwarayexeiya.   
\p
\v 31 Teraki kanayeyani 'Uxi karireutsixi wakwieyaritsie Kanani 'uta'eriwatɨ. Yuniwe 'Apɨrami 'awitɨtɨ meta yuteukari Ruti, meta yumu'e Tsarahi 'Apɨrami 'ɨyaya. Peru Karani kiekariyaritsie me'u'axɨaka mana mekanikuyaxe,  
\v 32 mana Teraki kaniumɨni huta tsienituyari heimana 'auxɨwime wiyari hexeiyatɨ.   
\c 12  
\s1 'Apɨrami kemɨranayexeiyarie  
\p
\v 1 Merikɨtsɨ Yawé 'Apɨrami mɨpaɨ katiniutahɨawe:  
\q1 «Keneuku'eiri 'akwie,  
\q2 'amarema meta 'apaapa kie,  
\q2 kenemie kemɨ'ane kwie nemɨmatsixeitsitɨanitsie.   
\q1
\v 2 »'Ekɨ 'ahetsie nuiwari mariweme nepɨnetɨani,  
\q2 'aixɨa nepɨmatsiyurieni,  
\q1 'aixɨa petikuxaxatsiwame nepɨmatsi'ayeitɨani,  
\q2 'ahekɨ hipatɨta 'aixɨa mepɨ'itɨarieni.   
\q1
\v 3 Ne 'aixɨa nepɨwayurieka kemɨ'ane 'aixɨa memɨmatexeiyani,  
\q2 meta 'axanepɨwayurieni kemɨ'ane 'axamemɨmatsiyurieni.  
\q2 'Ekɨ 'akɨmana 'aixɨa mepɨ'itɨarieka yunaitɨ nuiwarite kwiepa memɨtama».   
\p
\v 4 Hikɨ 'Apɨrami kanayeyani, Yawé kemɨrehɨawekai, meta Ruti hamatɨana kaneyani. Kepauka mayetɨa 'Apɨrami Karani kiekariyaritsie haika tewiyari heimana tamamata heimana 'auxɨwime wiyari pexeiyakai.  
\v 5 Kepauka metɨa 'Apɨrami Kanani paitɨ, yu'ɨya pewitɨ Tsarahi, meta yumatsu Ruti, yaxeikɨa yunaime te'i'uximayatsiriwamete Karani mɨwarutinanekai, meta tita memɨtehexeiyakai. Kepauka Kanani memuye'axɨa,  
\v 6 'Apɨrami mana 'uyeyaka Tsikeni mɨrakutewatsiepai kaninuani, xiu manuwe mɨrayutimawatɨre Mure mɨrakutewatsie. 'Ana mana kananeutsixi mepɨtitekai mɨkɨ kwieyaritsie.  
\v 7 Mana Yawé 'Apɨrami mɨpaɨ katiniutahɨawe: «Ne 'ikɨ kwie 'anuiwarima nekaniwayetuiriemɨkɨ». Hikɨ mana 'Apɨrami tenutsari mawari wewiwame kaniutawewieni Yawé hetsiemieme, mana mitahɨawixɨkɨ.  
\v 8 Mana mɨyetɨa kaneyani muhɨriyatsie Weteri 'aurie, mana nuaka kaniuyutaxamarutɨani, Weteri tau makayuyuipike katini'anekaitɨni 'Ahi kiekariyarita tau manatineika. Manatatsiere tenutsari timawame kaniutawewieni, Yawé mahɨawenikɨ.  
\v 9 Manata mɨyetɨa 'Apɨrami 'axɨkai 'umietɨ 'uyerɨximetɨ Nekexi kwieyaritsie paitɨ kaniye'ani.   
\s1 'Apɨrami kemɨretɨa 'Ekipitu  
\p
\v 10 Hikɨ 'ana haakaxa kanayani waɨkawa 'Apɨrami manukateitsie, 'ayumieme kaneyani 'Ekipitu paitɨ.  
\v 11 Hikɨ kepauka 'Ekipitu meutahanikekai, mɨpaɨ yu'ɨya Tsarahi katiniutahɨawe: «Ne nepɨtimate 'ekɨ 'uka witsipepɨti'ɨimari.  
\v 12 Nepɨtimate kepauka memɨmatsihexeiya 'ekipitutari mɨpaɨ mepetiyuani: “Ti'a'ɨya 'ikɨ”, 'anari mekanenemiekuni, 'ekɨta mekamanehayewakuni.  
\v 13 Peru neuxei mɨpaɨ kenetayɨki ximɨxi kename ne'iwa pehɨkɨ, ne 'atsinemɨkaheku'itɨariwanikɨ 'ekɨ mɨpaɨ pehetayɨyu, nemɨkahekumemieriwanikɨ».   
\p
\v 14 Kepauka meta'a 'Apɨrami 'Ekipitu kwieyaritsie, 'ekipitutari Tsarahi witsimekateniuxeiya.  
\v 15 Yaxeikɨata mekanixeiya, te'uximayatamete Parahuni hetsɨa miemete, hikɨ mekanekɨne meteheitaxatɨanike 'uka witsikemɨti'ɨimarikaikɨ. Hikɨ 'ayumieme kanewitɨkieni paratsiyu paitɨ.  
\v 16 Tsarahi hetsiemieme 'Apɨrami 'aixɨa mekateniuxeiya. Katiniyetuiriyarieni muxatsi, wakaitsixi, puxuri, kameyutsixi meta te'uximayatamete 'ukitsi 'ukari.  
\v 17 Perutsɨ Tsarahi hetsiemiemekɨ 'Apɨrami 'ɨyaya, Yawé Parahuni kaniu'uximatɨani meta yunaime tɨɨriyamama waɨkawa kwiniyakɨ.  
\v 18 'Ayumieme Parahuni pɨtiutanɨ'a, mɨwitɨkiemiekɨ 'Apɨrami, mɨpaɨ katinitahɨawe: «¿Titayari mɨya penetiuyuri? ¿Titayari mɨpaɨ pekanetiutahɨawixɨ kename 'ikɨ 'a'ɨyatɨkai?  
\v 19 ¿Titayari kename 'a'iwa petiutayɨ? Ketakuta matsi ne'itiwitɨnike. Hikɨri 'a'ɨya kenawitɨtɨ keneumieni».  
\v 20 Parahuni yuteɨterima kaniwaruta'aitɨani 'Apɨrami memayeweiyakɨ meta 'ɨyaya metatsiere tita mɨrexeiyakai.   
\c 13  
\s1 'Apɨrami Ruti hamatɨa kememɨteheuyutaxɨriexɨa  
\p
\v 1 Merikɨtsɨ 'Apɨrami kanayeyani 'Ekipitutsie yu'ɨya hawitɨtɨ meta yumatsu Ruti yunaitɨ, yunaime metewara'arietɨ yutewama, Nekexi mɨrakutewatsie me'erietɨ.  
\v 2 'Apɨrami pɨxikutɨkai tewaxi pɨwarexeiyakai, pɨrata pexeiyakai meta huru.  
\v 3 Kepaukata Nekexi kwieyaritsie mɨyetɨa, 'Apɨrami 'axɨkai kaneyani Weteri kanakunuani tatsɨari meripaitɨ matɨari manukateitsie Weteri meta 'Ahi wahixɨapa.  
\v 4 Mana meripaitɨ mawari taiyame mutawewiekaitsie, mana 'Apɨrami Yawé kaniutahɨawe.   
\p
\v 5 Meta Ruti 'Apɨrami maweiyakai pukatewakai, muxatsi, wakaitsixi, meta waɨkawa 'ixuriki kiyari pexeiyakai.  
\v 6 Peru hakewa memakutekai pɨkawareunanakekai yuhutatɨ mana memɨtitenikɨ, memɨyuwaɨkawakaikɨ watewama.  
\v 7 'Ayumieme mekaniuyutikwitɨkɨne 'Apɨrami memɨtehɨiriekai meta Ruti tehɨwemetemama wahamatɨa. Metatsiere mana mekanikiekaitɨni 'ana kananeutsixi meta peretseutsixi.   
\p
\v 8 Hikɨ 'Apɨrami mɨpaɨ Ruti katiniutahɨawe: «Pɨkaheuyewetse tame temɨtakwitɨweni, meta tateɨterima, hurawa temɨ'iwamarixikɨ.  
\v 9 Mana pukuma kwie 'apɨyewa. Nepɨmatsiwawirie nexaɨtame pemɨnetsihayewakɨ. Xɨka 'ekɨ peheyani ta'utata neta tatserieta nepɨyemie, xɨka tatserieta peheyani neta ta'utata nepɨyemie».   
\p
\v 10 Ruti kananieretɨyani naitsarie, Kurutani 'utɨma muweritsie kaneuyeniere, naitɨ 'aixɨa katiniu'anekaitɨni Tsuhaxi paitɨ 'uyenieretɨ, 'aixɨa katiniuhaxiekaitɨni, Yawé harawerita hepaɨ meta 'Ekipitu kwieyaritsie hepaɨ. Mɨpaɨ katiniu'anekaitɨni mana Tsuruma meta Kumuxa kepauka Yawé mɨka'ika'unawekaitsie.  
\v 11 Hikɨ Ruti kaninakire hetsiena mieme mayanikɨ naitɨ haa Kurutani 'utɨma muyeweritsie, 'ayumieme kaneyani tau manatineika hepatsie. Mɨpaɨ mekateneuyutaxɨriexɨani 'Apɨrami meta Ruti.  
\v 12 'Apɨrami Kanani kwieyaritsie kaniuyuhayewa, Ruti kaneyani mayeweritsie kiekari makumanetsie, Tsuruma 'aurie kaniutayerɨni.  
\v 13 Teɨteri Tsuruma kiekatari 'axamekateniu'iyarikaitɨni, Yawé hepaɨtsita waɨkawa 'axamɨti'ane mekateniyuriekaitɨni.   
\p
\v 14 'Arike Ruti 'Apɨrami 'uku'eirieku Yawé mɨpaɨ katinitahɨawe: «'Apɨrami 'aku, mana pemanuwetsie keneutanierixɨa, ta'utata, tatserieta, tayeta meta tatsutɨa.  
\v 15 Mɨkɨ nepɨmatsiyetuirieni meta 'anuiwarima yuheyemekɨ pemixeiya kwie naime.  
\v 16 Ne yumɨireme nepɨwarayeitɨani 'anuiwarima tumuanari hepaɨ. Xewitɨ xɨka tumuanari 'inɨataweni, kaniyɨwemɨkɨta 'anuiwarima mɨwati'inɨatakɨ.  
\v 17 Kenemie kenayekexiya 'ikɨ kwie kemayetewi meta kematayewa, ne nekamaniyetuiriemɨkɨ».   
\p
\v 18 Hikɨ 'Apɨrami kaniuyupata kaneyani Hewuruni 'aurie paitɨ makuxiuya, Mamɨre 'iteɨrieya maku'u 'aurie. Manata mawari taiyame kaniutawewieni Yawé hetsiemieme.   
\c 14  
\s1 'Apɨrami Ruti hetsie kemɨtiutanua  
\p
\v 1 Hikɨ 'ana tukaritsie te'aitamete: 'Amɨxaperi Tsinaxi kiekame, 'Ariuki 'Eratsaxi kiekame, Keruxirahumexi 'Erami kiekame, Tirari Kuyetihimi kiekame,  
\v 2 mɨkɨ mekaniwarutakwini te'aitamete: Wera Tsuruma kiekame, Wiritsa Kumuxa kiekame, Tsinawi 'Arimaha kiekame, Tsemewexi Tsewuhini kiekame, meta ti'aitame Tsuhaxi kiekame.  
\v 3 Mɨkɨ meyu'auxɨwitɨ me'uyutinɨka mepɨwarukuxeɨri yukuyaxima mayeweritsie Tsirini mɨrayetewatsie, metatsiere Haramara Mɨmɨki mɨtimatiwatsie.  
\v 4 Ti'aitame Keruxirahumexi tamamata heimana huta wiyari katiniwa'aitɨakaitɨni, tamamata heimana haika wiyaritsieke mewaraye'unietɨ mekanakɨne.   
\p
\v 5 Xeiwiyari 'anuyeyaku, Keruxirahumexi meta hipatɨ te'aitamete memitinɨkai mekanayekɨne, mekaniwaruka'una xepahitsixi 'Atsitaruti-Karinahini kwieyaritsie meta mekaniwaruka'una tsutsitsixi Kami kwieyaritsie meta 'emitsixi Tsawe-Kiriyatahini kwieyaritsie,  
\v 6 yaxeikɨata hureutsixi Tsehixi hɨriyaritsie kiekatari, 'atsitapaitɨ Parani mekaniye'axɨani makumawe meuhuratsie.  
\v 7 Me'akunuaxɨaka 'Enimitsipati paitɨ mekaniye'axɨani, tatsɨari Karetsi mɨtiyetewatsie, 'amarekitsixi wakwie naime mepɨwarunawairi, 'amuxeutsixi wakwietsie mekaniye'axɨani Katsetsuni-Tamaxi kwieyari mekaniwarunawairieni.   
\p
\v 8 Hikɨ Tsuruma te'aitamete, Kumuxa kiekame, 'Arimaha kiekame, Tsewuhini kiekame, meta Wera kiekame, tatsɨari Tsuhaxi manuyɨne, mekanayekɨne mayeweritsie Tsirini mɨtiuyetewatsie muwa mekaniwarutakwini,  
\v 9 te'aitamete, Keruxirahumexi 'Erami kiekame, Tirari Kuyehini kiekame, 'Amɨxaperi Tsinaxi kiekame, meta 'Ariuki 'Eratsaxi kiekame. Mekaniyunaukakaitɨni yu'auxɨwime mewaraye'unietɨ.  
\v 10 Mayeweritsie Tsirini putsu puxuawekai waɨkawa kwetsɨka mɨyɨwi 'uyemanetɨ, kepauka memeuyuta'unaxɨa te'aitamete Tsuruma kiekame meta Kumuxa kiekame, muwa mekaneukaxɨrieni, hipatɨ xeikɨa mekaniuyɨwekaxɨani mekaniuyuta'una hɨritsie paitɨ.  
\v 11 Mɨkɨ memɨte'ayu'iwaxɨ, Tsuruma meta Kumuxa timieme mekateniunawani naime tewaxi, meta wa'ikwaite, mɨpaɨ mete'uyurieka mekanekɨne.  
\v 12 Ruti mana mukateikɨ Tsuruma kiekariyaritsie 'Apɨrami matsuya, mɨkɨta mekanehana meta yunaime tewamama.   
\p
\v 13 Perutsɨ xewitɨ 'uyuta'unaka, 'Apɨrami hepɨrayu tewiyari katinekuxatɨani kemɨtiuyɨ, Mamɨre 'amuxeu tewiyari xiuya makuma mukateikɨ. Mamɨre pɨ'iwayatɨkai 'Etsikuri meta 'Anexi, mɨkɨ 'Apɨrami matɨa mekaniyu'eniekaitɨni.  
\v 14 Hikɨ kepauka 'Apɨrami 'amɨtiutaxatɨarie kename matsuya hehanie, kaniwaruta'inieni haika tsienituyari heimana tamamata heimana 'atahaika teɨteri me'u'ixiparame kiena memutinunuiwaxɨ xeikɨa, hikɨ mekaniwaranukuweiya Rani kwieyaritsie paitɨ.  
\v 15 Yɨwikɨta 'Apɨrami yuteɨterima yunaitɨ mekaniwarutakwini mekaniwara'iwa, mekaniwaranukuweiya Huwa mɨtiyetewatsie paitɨ Ramatsiku yeta.  
\v 16 Mɨpaɨ mekateniwarunawairieni tinaime, metatsiere yumatsu Ruti kaniutawikweitsitɨani meta tinaime piiniteya, hipame 'ukarawetsixi meta hipame teɨteri.   
\p
\v 17 Kepauka 'Apɨrami makunua ti'aitame Keruxirahumexi ha'iwaka meta hipame te'aitamete memeweiyakai, ti'aitame Tsuruma kiekame neikunake mayeweritsie Tsawe meta Ti'aitame mɨrayetewatsie.   
\p
\v 18 Meta Merikitsereki, ti'aitame Tsareme kiekariyaritsie meta mawari wewiwame Kakaɨyari 'Amutewi hetsiemieme, paa meta winu kanimini.  
\v 19 Hikɨ Kakaɨyari kaniutawawirieni 'Apɨrami 'aixɨa muyurienikɨ, mɨpaɨ 'utaitɨ:  
\q1 «Kakaɨyari 'Amutewi, muyuawi mutawewi meta kwie,  
\q2 'Apɨrami 'aixɨa keyurieka.   
\q1
\v 20 Kakaɨyari 'Amutewi naimekɨmɨyɨwe pamɨpariyutsi nekanipitɨaka,  
\q2 mɨmatsi'uparewi memɨmatsi'aye'unie pemɨwara'iwakɨ».  
\p Hikɨ 'Apɨrami pɨtiyetuiri, tamamatatsie timieme xeime naime.   
\p
\v 21 Ti'aitame Tsuruma kiekame, mɨpaɨ 'Apɨrami katiniutahɨawe:  
\p —Neteɨterima keneneyetuiri, piinite ketinapitɨ.   
\p
\v 22 'Apɨrami mɨpaɨ katinita'eiya:  
\p —Yawé hɨxie mɨpaɨ neputayɨ, Kakaɨyari 'Amutewi, muyuawi mutawewi meta kwie,  
\v 23 kename nitixaɨtɨ nekaranupini mɨti'apiini, hiru tɨma, nawi kakaitsie mieme tɨma. Mɨpaɨ hatsuaku pepɨkayɨwe mɨpaɨ pemɨtayɨni: “Ne 'Apɨrami xiku nepeyeitɨa”.  
\v 24 Ne tixaɨtɨ nepɨkareuyehɨwa nehetsiemieme, hɨrixɨatsɨ neteɨterima memɨte'utikwai. Meta memɨnetsi'aweiya 'Anexi, 'Etsikuri meta Mamɨre, mɨkɨ hɨrixɨa mekete'utipini yuhetsiemieme.   
\c 15  
\s1 Kakaɨyari tɨratu kemɨtiuwewi 'Apɨrami hamatɨa  
\p
\v 1 Hikɨ mɨpaɨri tiɨyɨku, Yawé 'Apɨrami kaniutahɨawe heinɨtsika hepaɨ tiyuxexeiyamekɨ:  
\q1 «'Apɨrami, pepɨkaheumaka.  
\q2 Ne 'ahetsie nunuwame nekanihɨkɨtɨni,  
\q2 kenemɨmatiyetuirieni waɨkawa katinayeimɨkɨ».   
\p
\v 2 Hikɨ 'Apɨrami mɨpaɨ katinita'eiya:  
\p —Yawé nekakaɨyari, ¿titayari 'imikieri penetiyetuirieni, ne nunutsi 'akuxi nepɨkahexeiya, tita nemɨrexeiya neti'uximayatsiriwame 'Eriyetsexi Ramatsiku kiekame tipiinieya katinayeimɨkɨ?  
\v 3 Xeimetɨma nunutsi pemɨkanetsiyetuiriewekɨ, xewitɨ netsiparewiwame nepiinite katinanupimɨkɨ.   
\p
\v 4 Yawé mɨpaɨ katinitahɨawe:  
\p —Hawaikɨ mɨkɨ tewi 'apiinite mɨranupini pɨka'ayani, 'apiinite mɨranupini yurikɨ 'aniwe pɨyɨaneni.   
\p
\v 5 Hikɨ Yawé kanenuyewitɨni takwa paitɨ, mana mɨpaɨ katinitahɨawe:  
\p —Muyuawitsie keneutinieri, keniwaruti'inɨata xurawetsixi, xɨka peyɨweni pemɨwaruti'inɨata. Mɨpaɨ mekaniyupaɨmekakuni 'anuiwarima.   
\p
\v 6 'Apɨrami Yawé yuri pɨtiuta'eriri, 'ayumieme Yawé mɨkɨ heitserie hexeiyame kanayeitɨani.  
\v 7 Mɨpaɨta katinitahɨawe:  
\p —Ne Yawé nekanihɨkɨtɨni, nemɨmatsi'ayewitɨ 'Uxi karireutsixi wakwieyaritsie nemɨmatsiyetuirienikɨ 'ikɨ kwie.   
\p
\v 8 Perutsɨ 'Apɨrami mɨpaɨ katinita'iwawiya:  
\p —Yawé neti'aitɨwame, ¿kehepaɨ neretimani kename penetsiyetuirieni?   
\p
\v 9 Yawé mɨpaɨ katinita'eiya:  
\p —Kenene'atɨiri xeime wakaxi, xeimeta kapura, xeimeta tuuru muxa yunaitɨ haika wiyari mehɨtɨkaime, yaxeikɨata xeime haɨmɨ 'amɨnena xeimeta kukuru yakɨmɨnena.   
\p
\v 10 'Apɨrami 'ikɨ naime katini'atɨirieni, hixɨata kaniwaxitexɨani, huhutatame 'anuyutaxeiyatɨkaime katiniuyatsa, peru pɨkawarutixite memawɨwawe.  
\v 11 Hikɨ wirɨkɨxi mekani'axekaitɨni wahetsie memɨkwikwi'ikaikɨ, matsi 'Apɨrami kaniwatatuaxakaitɨni.   
\p
\v 12 Kepauka kɨyɨrirumekakɨ, 'Apɨrami kaniukumɨni, yapauka yɨriya kananukateni hetsiena, hikɨ kanimakaitɨni.  
\v 13 Yawé mɨpaɨ 'Apɨrami katiniutahɨawe:  
\p —Mɨpaɨ ketinemaika 'anuiwarima xeime kwieyaritsie mepɨtiteni yapaɨmexɨa, mana mepɨteta'aitɨarieni, menanaimarietɨ, nauka tsienituyari wiyari.  
\v 14 Peru neta yaxeikɨa nepɨwa'uximatɨani mɨkɨ teɨteri memɨtewata'uximayatsitɨani, 'ana mepayekɨne 'anuiwarima metixɨnarieme, waɨkawa mɨraye'atɨka mete'upitɨ.  
\v 15 'Ekɨta pekanikumawerimɨkɨ peka'uximatɨarietɨ, waɨkawa pe'ukiratsitɨtɨke pekanimɨmɨkɨ.  
\v 16 Nauka nuiwariyari me'anuyeyayu, waxiɨyarima 'ena mekani'axɨakuni, hikɨ 'ena memɨtama 'amuxeutsixi 'axamekateniu'iyarini 'ana nekaniwarakumaweriyamɨkɨ.   
\p
\v 17 Kepauka tau makayunixɨ, kepauka mukuyɨrixɨ, kaniuhekɨare huxunu hepaɨ 'anetɨ kɨtsi watiwietɨ, meta tai mana puyewiekai, mɨkɨ tewaxi memɨxitekietɨka wahixɨata mekaniuyekɨkakaitɨni.  
\v 18 Mɨkɨ tukaritsie Yawé 'Apɨrami hetsɨa tɨratu kaniuwewieni. Mɨpaɨ katinitahɨawe:  
\p —'Ikɨ kwie nepɨwayetuirieni 'anuiwarima, haa 'Ekipitu mieme manuyeka, meta 'amɨpa manuyekatsie paitɨ 'Eupɨrate mɨtitewatsie.  
\v 19 Keni teɨteriyari wakwie nekanixatani, meta kenitsixi, karimuneutsixi,  
\v 20 hetitsixi, peretseutsixi, xepahitsixi,  
\v 21 'amuxeutsixi, kananeutsixi, keriketseutsixi meta kewutseutsixi wakwie.   
\c 16  
\s1 Hakari meta 'Itsimaheri  
\p
\v 1 Merikɨtsɨ Tsarahi 'Apɨrami hamatɨa nunutsi mepɨkahexeiyakai. Tsarahi xeime pexeiyakai 'uka ti'uximayatame 'ekipitutanaka Hakari titewakame,  
\v 2 hikɨ Tsarahi mɨpaɨ katinitahɨawe yukɨna:  
\p —Yawé pɨkanetsipitɨawe nunutsi nemayexeiyakɨ. 'Ayumieme, keneukahu'i neti'uximayatsiriwame Hakari hamatɨa. Heiwatɨ mɨkɨ 'utiniweni neniwema memakɨnekɨ.  
\p 'Apɨrami yakatiniutanaki'erieni 'ɨyaya kemɨrehɨawekai.  
\v 3 Hikɨ Tsarahi tiyu'uximayatsiriwame 'ekipitutanaka Hakari 'uwiyaka, 'Apɨrami kaniyetuirieni mɨ'ɨyayatɨnikɨ. Mɨpaɨ katiniuyɨni kepauka 'Apɨrami tamamata wiyari muyuriekai Kanani kwieyaritsie.   
\p
\v 4 'Apɨrami Hakari hamatɨa kaniukahuni, mɨkɨ kaniutihukata. Kepauka Hakari mɨretima kename 'ayehukakai, kaniyuti'ɨretɨyani yukutsiyari Tsarahi hɨxie.  
\v 5 Hikɨ Tsarahi 'Apɨrami mɨpaɨ katiniutahɨawe:  
\p —'Ekɨtsɨ ya'anekame pekaniwiwieka kenemɨtinanaimarie. Ne nepɨmatsiyetuiri ti'uximayatame 'a'ɨya mayanikɨ, hikɨri mayehuka mariweme kanayuyeitɨwani. Yawé yake'utayɨni kemɨ'ane heitserie mexeiya, xɨka 'ekɨ yatɨni ne.   
\p
\v 6 'Apɨrami mɨpaɨ katinita'eiya:  
\p —'Ekɨ heitserie pepexeiya ti'uximayatame pemɨti'aitɨakakɨ, ketine'aitɨaka kemɨmatinake kehepaɨ 'aixɨa mɨ'ane.  
\p Hikɨ Tsarahi waɨkawa kaniti'uximatɨatɨyani, 'ana Hakari kaniuyuta'una makumawetsie paitɨ.  
\v 7 Mana niuki tuayame Yawé hetsɨa mieme kanitaxeiya, haixa matinieretsie huye Tsuhuxi mieme manuyehanetsie  
\v 8 mɨpaɨ katinita'iwawiya:  
\p —Hakari, Tsarahi ti'uximayatsiriwame, ¿hakewa pepeyetɨa, hakewa pepeutɨa?  
\p Hakari mɨpaɨ kaniutayɨni:  
\p —Nepeyuta'unaxɨ nekutsiyari Tsarahi hetsɨa.   
\p
\v 9 Niuki tuayame mɨpaɨ katinitahɨawe:  
\p —Kenakunua hetsɨana, yaketinekamieni kemɨmare'aitɨa.  
\v 10 Yaxeikɨata 'anuiwarima nepɨwatimɨiriya, xewitɨ pɨkayɨweni mɨwaruti'inɨata.   
\q1
\v 11 »Hikɨri pemayehuka xeime nunutsi 'uki pekanayexeiyamɨkɨ,  
\q2 'Itsimaheri pekatiniterɨwamɨkɨ,  
\q2 Yawé mi'enikɨ 'ahiwerika.   
\q1
\v 12 Tewi mɨkatiyu'aitɨarinɨa kanayeimɨkɨ, puxu tsimaruni hepaɨ.  
\q2 Yunaime kaniwatakwimɨkɨ, yunaitɨta mekanitamiekuni,  
\q2 yu'uximatɨatɨ puyeikani yu'iwama yunaime wahamatɨa».   
\p
\v 13 Yawé Hakari mɨtiutaxatɨakɨ mɨpaɨ pɨtiterɨwaxɨ «Kakaɨyari pemɨniere». Mɨpaɨ mutainekaikɨ: «Hikɨ nepixei kemɨ'ane mɨnetsixeiya».  
\v 14 'Ayumiemeta mɨpaɨ pɨtitewa putsu Karetsi Wereri wahixɨapa mɨtiniere «Kakaɨyari mayeyuri putsuya mɨnetsixeiya».   
\p
\v 15 Hakari xeime nunutsi kaniutiniweni 'Apɨrami niweyatɨme, 'Apɨrami mɨkɨ 'Itsimaheri katiniuterɨwa.  
\v 16 'Apɨrami nauka tewiyari heimana 'ataxewi wiyari kanexeiyakaitɨni kepauka 'Itsimaheri mutinuiwaxɨtsie.   
\c 17  
\s1 Tɨratu meta xitekiya 'inɨariyari  
\p
\v 1 Kepauka 'Apɨrami nauka tewiyari heimana tamamata heimana 'atanauka wiyari mexeiyakai, Yawé mɨpaɨ katinitahɨawe:  
\p «Ne Kakaɨyari Naimekɨmɨtɨrɨkaɨye nekanihɨkɨtɨni, nehɨxie keneuyeikani 'aixɨa ketineyurienetɨ.  
\v 2 Mɨpaɨ nepeye'atɨani 'ahetsɨa tɨratu meta yumɨireme nepɨwarayeitɨani 'anuiwarima».   
\p
\v 3 Hikɨ mɨpaɨ tiu'enaka 'Apɨrami, kwiepa kaniukahɨximakeni, Kakaɨyari 'akuxi kaniyeweiyakaitɨni tikuxatatɨ:   
\p
\v 4 «'Ikɨ tɨratu 'ahamatɨa nekaniwewieka: 'Ekɨ yumɨireme nuiwarite wapaapa pekanayeimɨkɨ.  
\v 5 Hikɨri 'Apɨrami pepɨkatitewaka, matsi pɨtari 'Apɨrahami pepɨtitewaka, mɨpaɨ nemɨmarahɨawekɨ kename yumɨireme nuiwarite wapaapa nematsi'ayeitɨani.\f + \fr 17:5 \ft \fq 'Apɨrami\ft  hepɨrayukɨ panuyɨne \fqa 'ukiyari mɨmariwe\ft . \fq 'Apɨrahami \ft hepɨrayukɨ panuyɨne \fqa yumɨireme wa'ukiyari\ft  yatɨni \fqa wa'ukiyari mɨtiuyukanenimaya.\f*  
\v 6 Kwinimieme petixiɨweme nepɨmatsi'ayeitɨani 'ahetsie mepɨyekɨne te'aitamete meta nuiwarite.  
\v 7 'Ahetsiemieme 'ikɨ tɨratu nepɨwewie meta 'anuiwarite wahetsiemieme, 'ikɨ tɨratu yuheyemekɨ mieme payani, yunaime 'anuiwarima wahetsiemieme. Ne 'akakaɨyari nepɨhɨkɨtɨni, meta 'anuiwarima wakakaɨyari.  
\v 8 'Ekɨ meta 'anuiwarima nepɨxeyetuirieni naime Kanani kwieyari, yuheyemekɨ mɨxekwietɨnikɨ, hakewa hikɨ xeme'uwa teewatari wahepaɨ xe'anetɨ. Neta xekakaɨyari nepɨhɨkɨtɨni».   
\p
\v 9 Kakaɨyari 'Apɨrahami mɨpaɨ katiniutahɨawe:  
\p «Netɨratu xekenaye'atɨa, 'ekɨ meta yaxeikɨa 'anuiwarima yuheyemekɨ.  
\v 10 'Ikɨ kanihɨkɨtɨni tɨratu 'ahamatɨa nemiwewie meta 'anuiwarima wahamatɨa, meta yunaitɨ xemeye'atɨanikɨ: Yunaitɨ 'ukitsi xitekiya 'inɨariyari meke'uwewiyarieni.  
\v 11 Yuwaiyaritsie xitekiya 'inɨariyari xepɨwewieni, mɨkɨ pɨ'inɨaritɨni tɨratu kenemɨtiwewie ne xehamatɨa.  
\v 12 Hikɨ 'ena mɨtiyehane memɨtinunuiwa yunaitɨ xitekiya 'inɨariyari mekekuwewiyarɨwani 'atahaika tukaritsie, meta yunaitɨ tɨɨri 'akie memɨtinunuiwa, meta nanaiyakate teɨteri tsepa xenuiwarima wahetsiemieme mekahɨkɨ.  
\v 13 Yunaitɨ xewitɨ pɨkayukuhayeikawani, 'akie memɨtinunuiwa meta kemɨ'ane pemɨwatinawe, xitekiya 'inɨariyari meke'uwewiyarieni. Mɨpaɨ pɨtiyuhayewa netɨratu xewaiyaritsie kayeiwetɨ, tɨratu yuheyemekɨ mɨhɨkɨkɨ.  
\v 14 Merikɨte kemɨ'ane mɨka'inɨaritɨarieni, yuwaiyaritsie mɨka'uxitekieni, mɨkɨ pukumaweriyarieni xehetsɨa. Yamɨkatikatɨakɨ netɨratu kemaine».   
\p
\v 15 Mɨpaɨtatsiere Kakaɨyari 'Apɨrahami katiniutahɨawe:  
\p «Tsarahi 'a'ɨya, Tsarahi pepɨkatiuterɨwaniri, Tsara pɨta pɨtitewaka.\f + \fr 17:15 \ft \fq Tsara\ft  hepɨrayukɨ panuyɨne \fqa ti'aitame niweya.\f*  
\v 16 Ne 'aixɨa nepiyurieni, nunutsi xeime nepɨxeyetuirieni. Waɨkawa 'aixɨa nepiyurieni, mɨkɨ yumɨireme nuiwarite wamaama payani, hetsiena mepɨyekɨne te'aitamete kiekaritsie memɨteta'aitaxɨani».   
\p
\v 17 Hikɨ 'Apɨrahami kaniutihɨximakeni kwiepa kaniutananeni mɨpaɨ tiku'eriwatɨ: «¿Kamɨtsɨ tiyɨwe 'uki nunutsi mayexeiya xeitsienituyari wiyari hexeiyatɨ, meta tiyɨwe mɨtiniweni Tsara nauka tewiyari heimana tamamata wiyari hexeiyatɨ?»  
\v 18 'Ayumieme 'Apɨrahami Kakaɨyari mɨpaɨ katiniutahɨawe:  
\p —'Itsimaheri 'aixɨa pe'iyuriekaku ke'uyeikani.   
\p
\v 19 Kakaɨyari mɨpaɨ katinita'eiya:  
\p —Tsara nepɨxata 'a'ɨya xeime nunutsi payexeiya 'aniwetɨme, 'Itsahaki pekatiniterɨwamɨkɨ. Mɨkɨ hamatɨa netɨratu payeyurini meta nuiwarimama wahetsɨa, tɨratu yuheyemekɨ mieme mɨhɨkɨkɨ.\f + \fr 17:19 \ft \fq 'Itsahaki\ft  hepɨrayukɨ panuyɨne \fqa mutanawe.\f*  
\v 20 'Itsimaheri hetsiemiemeta nepɨmatsi'enie. Ne 'aixɨa nepiyurieni, waɨkawa mɨiriweme nepayeitɨani, yuwaɨkawa nuiwarimama nepɨwarayeitɨani. Tamamata heimana huta te'aitamete wapaapa kanayeimɨkɨ. Hetsiena nuiwari mariweme nekaninetɨamɨkɨ.  
\v 21 Matsi netɨratu 'aniwe 'Itsahaki hetsie kanayeyurikamɨkɨ, Tsara peyexeiya yurika 'epauka xeiwiyari 'anuyeyayu.   
\p
\v 22 Kepauka Kakaɨyari mɨtiutahayewaxɨ 'Apɨrahami hamatɨa tikuxatatɨ kaniukumawere hɨxiena.  
\v 23 Mɨkɨ tukaritsie kwitɨwa 'Apɨrahami yuniwe 'Itsimaheri xitekiya 'inɨariyari kaniwewirieni, meta kiena memutinunuiwakai metatsiere muwarutinanekai, meta hipame 'ukitsi kiena memɨtitekai yunaime, Kakaɨyari kemɨre'aitɨwakai.  
\v 24 Nauka tewiyari heimana tamamata heimana 'atanauka wiyari pexeiyakai, 'Apɨrahami kepauka xitekiya 'inɨariyari muwewiyarie,  
\v 25 nu'aya 'Itsimaheri tamamata heimana haika wiyari kanihɨkaitɨni.  
\v 26 Meta 'Apɨrahami yuniwematɨ yunaitɨ xitekiya 'inɨariyari mekaniuwewiyarieni mɨkɨ tukaritsie  
\v 27 yunaitɨ meyunɨtɨ 'ukitsi wahetsɨa kiekatari, meta memutinunuiwaxɨ wahetsɨa, meta nanaiyakate teewatari waniwema.   
\c 18  
\s1 Yawé 'Apɨrahami kemɨtitaxatɨa nunutsi  
\p
\v 1 Merikɨtsɨ Yawé kaniuyuhekɨata 'Apɨrahami hetsɨa Mamɨre makuxiuyatsie, 'Apɨrahami 'ixuriki kiiyari hɨxie 'uxipiekaku tuka 'uxɨkakaku.  
\v 2 Hikɨ 'Apɨrahami kepauka manukunierixɨ, yuhaikame 'ukitsi kaniwaruxeiya yateewa meti'ukame. Waruxeiyaka kaniutanautsa yuxamaru hɨxie tikeka watahɨaweke. Wahɨxie 'utihɨximakeka,  
\v 3 mɨpaɨ kaniutayɨni:  
\p —Neti'aitɨwame, xɨka yapera'eriwani, yemekɨ nepɨmatsiwawirie ne'aurie xeikɨa pemɨka'uyeyeikanikɨ.  
\v 4 Haa nepɨta'aita kɨmana yu'ɨkate xemɨtihauxinikɨ, 'anake xepɨka'uxipieni 'ikɨ kɨye 'etɨpiwari hetɨa.  
\v 5 Tixe'uximayatsiriwame manukatsie xemɨye'axɨakɨ, 'ikwai nekanita'aitamɨkɨ 'aixɨa xeteheu'erietɨ xemɨyehukɨ kexemɨtehu.  
\p Mɨkɨ mɨpaɨ mekaniutiyuani:  
\p —Kamɨtsɨ 'aixɨa pɨ'ane, mɨpaɨ ketineuyuri.   
\p
\v 6 'Apɨrahami kaneyani yapauka Tsara 'ixuriki kiiyarita, hikɨ mɨpaɨ Tsara katiniutahɨawe:  
\p —Mexɨiwa 'aixɨa. Harina 'aixɨa mɨ'ane xeitewiyari kiruyari keneuhawiya, paa keneutiwewi.   
\p
\v 7 Meta 'Apɨrahami kaneyani 'unautsarɨmetɨ hakewa tewaxi memeyenakai, muwa xeime tsikeru kaniwayehana waiyakame waiyarieya mɨkatse'i, ti'uximayatame kaniyetuirieni, mɨkɨta mexɨima kanitawarɨka.  
\v 8 Hikɨ katiniwarumini kunerekɨ retsikɨ meta tsikeru warɨkariyarikɨ. Kepauka memɨtekwakai 'Apɨrahami kɨyetɨa kaniuwekaitɨni wa'aurie.   
\p
\v 9 —¿Hakewari 'a'ɨya, Tsara?  
\p 'Apɨrahami mɨpaɨ katiniwaruta'eiya:  
\p —Huma payeka 'ixuriki kiiyarita.   
\p
\v 10 Hikɨ xewitɨ mɨpaɨ katinitahɨawe:  
\p —Xeiwiyari 'anuyeyayu tawarita nepɨmatsiha'iwatamie, 'ana 'a'ɨya Tsara nunutsi kanexeiyakamɨkɨ.  
\p Tsara kanita'enakaitɨni yu'ixuriki kiiyari hɨxie, mɨyamɨtikuxatakai waritana yateewa pɨti'enakai.  
\v 11 'Apɨrahami Tsara hamatɨa mepɨ'ukirawetsixitɨkai, Tsara mɨtihukata pɨkayɨwekairi.  
\v 12 'Ayumieme, Tsara kaniutananeni mɨpaɨ tiku'eriwatɨ: «Pɨkayɨwe nemuyutemawieka mɨyamɨraniuwakɨ, neri 'ari nepɨkayɨwe, nekɨnatari pɨ'ukiratsi».  
\v 13 Hikɨ Yawé mɨpaɨ 'Apɨrahami katiniutahɨawe:  
\p —¿Titayari Tsara tiutanawe? ¿Kamɨtsɨ yurikati'erie mɨtiniwenikɨ mɨyayumaitɨ?  
\v 14 ¿Kamɨtsɨ Yawé hepaɨtsita tixaɨtɨ tixuawe katiyɨwetɨ? Yurika nekanayenemɨkɨ 'epauka, 'ana Tsara nunutsi kanexeiyakamɨkɨ.   
\p
\v 15 Tsara kaniutimani, katini'itaiya mɨpaɨ katinitahɨawe:  
\p —Nematsi nepɨka'utanawekai.  
\p Peru Yawé tawarita mɨpaɨ katinitahɨawe:  
\p —Huu, peputananai.   
\s1 'Apɨrahami tsurumatari kemɨtiwawikweitsitɨamɨkɨkai  
\p
\v 16 Hikɨ mekananuku'uni 'iwatamete mekanekɨne Tsuruma hepatsie. 'Apɨrahami wahamatɨa kaneyani waretateutɨanike.  
\v 17 Yawé mɨpaɨ katiniku'eriwakaitɨni: «¿Nekapɨtitaxatɨani 'aumɨ 'Apɨrahami kenemɨtiyurieni?  
\v 18 'Apɨrahami nuiwarieya mariwetɨ payani meta tɨrɨkaɨyetɨ, mɨkɨ kɨmana yunaitɨ nuiwarite kwiepa memɨtama 'aixɨa mepɨ'itɨarieni.  
\v 19 Ne nepenayexei yuniwema muwata'ɨxatsitɨanikɨ meta watɨɨriyama, Yawé huyeya'utɨa memuhunikɨ, yamemɨteyuriekakɨri tita 'aixɨa mɨti'ane tita mɨtiheitserie. Hikɨ mɨpaɨ me'anekaku Yawé pɨraye'atɨani 'Apɨrahami kemɨtiutahɨawixɨ».   
\p
\v 20 Hikɨ 'ayumieme Yawé 'Apɨrahami mɨpaɨ katiniutahɨawe:  
\p —Nepɨka'inewieri hiwerika Tsuruma Kumuxa wahepaɨtsita mieme, waɨkawa 'axamepɨteyurie.  
\v 21 'Ayumieme nepɨnierimie, xɨka 'aku yuritɨni 'axamete'u'iyarini kememutiyuane memutitsuana, yatɨ pɨtikatixaɨ nekatinetimaimɨkɨ.   
\p
\v 22 Yuhutatɨ 'iwatamete xeikɨa mekanekɨne Tsuruma, 'Apɨrahami 'akuxi kaniuyuhayewa Yawé hamatɨa.  
\v 23 Hikɨ 'Apɨrahami Yawé hɨxie hurawa kaniuyani mɨpaɨ katinitahɨawe:  
\p —¿Kamɨtsɨ yurikɨ petika'una heitseriemekɨ yamɨtikamie 'axamɨtiyuriene hamatɨa?  
\v 24 Mɨkɨ kiekaritsie xɨka me'u'uwani huta tewiyari heimana tamamata heitseriemekɨ yamemɨtekahu. ¿Yunaime petiwaka'una, pekareiyehɨwirieni kiekari pewanaki'erietɨ heitserie memexeiya?  
\v 25 Mɨpaɨ pemɨtiyurieneni matsi 'aixɨa pɨka'ane. Heitseriemekɨ yamɨtikamie xɨka 'umieni 'axamɨtiyuriene hamatɨa meta yaxeikɨa memɨte'anuyehuni yunaitɨ. Mɨpaɨ matsi hatsuaku pepɨkatiyurieneni. 'Ekɨ 'itsɨkame pekanihɨkɨtɨni 'ikɨ kwie naime hetsiemieme. ¿Tamɨ kemɨtiheitserie pekatiyurieni?   
\p
\v 26 Yawé mɨpaɨ katinita'eiya:  
\p —Xɨka huta tewiyari heimana tamamata heitserie yamemɨtekahu Tsuruma kiekariyaritsie newarukaxeiya, wahetsiemieme kiekari naime nekatineuyehɨwiriemɨkɨ.   
\p
\v 27 'Apɨrahami mɨpaɨ katinitahɨawe:  
\p —Ne nepɨnemate kenetineuyehɨwirieka kwinimieme nematiku'iwawiyakɨ neti'aitɨwame, ne tumuanari naxi nepɨhɨkɨ.  
\v 28 Peru xɨka meheuyewekake yu'auxɨwitɨ mema'atɨkɨnekɨ huta tewiyari heimana tamamata. ¿Petika'una naime kiekari yu'auxɨwitɨ memeuyewetsekɨ?  
\p Yawé mɨpaɨ katinita'eiya:  
\p —Xɨka huta tewiyari heimana yu'auxɨwime newaretaxeiya heitserie memexeiya nepɨka'ika'una.   
\p
\v 29 'Apɨrahami tawarita mɨpaɨ kaniutayɨni:  
\p —Keri xɨka huta tewiyari xeikɨa pewaretaxeiya.  
\p Yawé mɨpaɨ katinita'eiya:  
\p —Heitserie memexeiya mɨkɨ huta tewiyari meyupaɨmemekɨ nepɨka'ika'una kiekari.   
\p
\v 30 'Apɨrahami tawarita mɨpaɨ kaniutayɨni:  
\p —Pepɨkaha'aka neti'aitɨwame, matsi kenenepitɨaka nemɨtikuxatanikɨ. Keri xɨka xeitewiyari heimana tamamata xeikɨa pewaretaxeiya.  
\p Yawé mɨpaɨ katinita'eiya:  
\p —Nepihayewa xeitewiyari heimana tamamata wahetsiemiemekɨ.   
\p
\v 31 'Apɨrahami tawarita mɨpaɨ kaniutayɨni:  
\p —Kenetineuyehɨwirieka mɨya nematikuxaxatɨwakɨ neti'aitɨwame, peru xɨka pewaretaxeiya xeikɨa xeitewiyari heitserie memexeiya.  
\p Yawé mɨpaɨ katinita'eiya:  
\p —Mɨkɨ xeitewiyarikɨ nepɨka'ika'una.   
\p
\v 32 Mɨkɨ tawarita mɨpaɨ katinitahɨawe:  
\p —Pepɨka'uyeha'arɨweni neti'aitɨwame, keneneupitɨa tawarita nemɨtaniunikɨ. Xɨkata tamamata pewaretaxeiya xeikɨa.  
\p Yawé 'imatɨrieka mɨpaɨ katinitahɨawe:  
\p —Mɨkɨ tamamata wahekɨ nepɨka'ika'una.   
\p
\v 33 Kepauka mɨtiutahayewaxɨ Yawé tikuxatatɨ kaneyani, 'Apɨrahami meta kanakunuani yukie 'ixuriki kiiyarita.   
\c 19  
\s1 Yawé kemɨtika'unaxɨ Tsuruma meta Kumuxa  
\p
\v 1 Merikɨtsɨ kanikuyɨrirɨmekaitɨniri kepauka niuki tuayamete Tsuruma memɨye'axɨa. Ruti kiekari kitenie kanakateitɨni mɨranutakɨkatɨretsie. Kepauka mɨkɨ mɨwaruxei, kananukukeni watahɨaweke, wahɨxie kwiepa kaniukahɨximakeni.  
\v 2 Mɨpaɨ katiniwarutahɨawe:  
\p —Neuxei 'iwatamete, nepɨxewawirie waɨkawa 'ikɨ tɨkaritsie nekiita xemuyuhayewanikɨ. Muwa yɨ'ɨkate xemetihauxini peyɨwe, 'uxa'akeri ximeri xekaniyehuni kexemɨtehu.  
\p Peru mɨkɨ mɨpaɨ mekaniutiyuani:  
\p —'Aixɨa pɨ'ane mɨyapemɨtarahɨawe, matsi tame kiekari hixɨapa teɨteri memayutixexeɨriwatsie tepetiheni.   
\p
\v 3 Peru Ruti katihayewakaku yukie wa'inietɨ mepekɨ 'utɨmana, kiitana mekaniu'axɨani. Ruti wa'ikwai muwa putiwarukawewiri 'aixɨa ti'anekame, paa mɨkakuxanariyarietɨka kaniutikwaxiya, mɨkɨ mekateniukwani.   
\p
\v 4 Hikɨ mekakakutsiwawekaku 'akuxi, kii 'aurie mekanaketɨkɨne teɨteri mana Tsuruma kiekariyaritsie kiekatari. Yunaitɨ teɨteri kiekatari mekaniyɨakaitɨni xewitɨ tɨma kayuhayewatɨ, temari 'ukirawetsixi yunaitɨ mekateniyɨakaitɨni.  
\v 5 Ruti mekanewaye'inieni, mɨpaɨ mekatenitahɨawe:  
\p —¿Hakewari 'ukitsi memu'axɨa 'akie metihenike? Keniwarayenɨ'a. Tame wahamatɨa tepɨkahini.   
\p
\v 6 Hikɨ Ruti yukiita hewayeyaka, reunaka kitenie,  
\v 7 mɨpaɨ katiniwarutahɨawe:  
\p —Neuxei nehamikuma, mɨpaɨ xepɨkayɨaka.  
\v 8 Ne yuhutame nepɨwarexeiya neniwema 'ukari 'ɨimarixi 'akuxi, nekaniwarayenɨ'amɨkɨ tsepa kexemɨwayuriku mɨkɨ, peru 'ikɨ 'ukitsi 'axaxepɨkawayurieka, mɨkɨ mekaniu'axɨani nekiita memayehenikɨ.   
\p
\v 9 Peru mɨkɨ mɨpaɨ mekatenita'eiya:  
\p —Mana keneukuye'a. 'Ikɨ 'ena pɨkakiekame, hikɨta tati'aitɨamɨkɨ. Hikɨtsɨari matsi 'ekɨ kwinimieme 'axatekamaniyuriekakuni 'ena mɨtiyehane pemɨkawatauniekɨ.  
\p Hikɨ Ruti mekaneukutaima hurawa kitenie mekaniuti'uni 'itupari meheu'unake.  
\v 10 Peru memuyuhuta 'ukitsi yumamate mekaniutitsera, Ruti mekaneutahana kiitana meta mekateneunani kitenie.  
\v 11 Hikɨ mɨkɨ, 'itupari memeu'unakai temari 'ukirawetsixi mekaheunenieretɨ mekanayeitɨarieni, kitenie hakewa mehɨkɨtɨkai mepɨka'itaxeiri.  
\v 12 Hikɨ Ruti mɨpaɨ mekateneye'eritɨani:  
\p —¿Tawarita 'atɨɨriyama pekatiwarexeiya 'ena? Keniwaranuwitɨki xaɨtsie yunaime 'amunema, 'aniwema 'ukitsi meta 'ukari, yunaime kemɨ'ane memɨ'a'iwama, 'ikɨ kiekaritsie mepɨkayuhayewani,  
\v 13 hikɨ tame tekanika'unakuni. 'Axamɨti'ane hiwerika Yawé hetsɨa paitɨ kaniye'ani, 'ari 'iyarieyatsie katineuyeyani. 'Ayumieme tame pɨtatsiheyenɨ'a temika'unakɨ.   
\p
\v 14 Hikɨ Ruti kanayeyani wata'inienike yuniwema wakɨnama memakɨnekekai, kemɨ'ane memɨwatiwitɨnikekai.  
\p Mɨpaɨ katiniwarutahɨawe:  
\p —Mexɨima. Kiekaritsie xekenayekɨni, Yawé kanika'unarɨmeni.  
\p Matsi mɨkɨ yakɨ 'utaineme mepɨ'eriekai.  
\v 15 'Ari kuhekɨarirɨmekaku tawarita Ruti yaxeikɨa mekatenikɨhɨawekaitɨni niuki tuayamete. Karima mɨpaɨ mekaniutiyuani:  
\p —Keneyumexɨitɨatɨ. Keniwaranuwitɨki 'a'ɨya meta 'aniwema memuyuhuta, xemɨkakukukuwenikɨ kepauka kiekari mɨka'unarieni.   
\p
\v 16 Ruti kayumexɨitɨakaku, niuki tuayamete mamayatsie mekanikawɨre, 'ɨyaya meta niwemama memuyuhutakai, kiekaritsie mekaniwaranuyewitɨni, Yawé mɨwarutinenimayataxɨkɨ.  
\v 17 Mewarayewitɨkari kiekaritsie, xewitɨ niuki tuayame mɨpaɨ kaniutayɨni:  
\p —Xekeneuyuta'una. Yu'utɨma xepɨka'anakuneniereni mayeweritsie xepɨkahewa'uweni. Hɨritsie paitɨ xekeneuyuta'una, nɨkahɨrixɨa xe'ukwini.   
\p
\v 18 Ruti mɨpaɨ kaniutayɨni:  
\p —Neuxeitsɨ hawaikɨ, waɨkawamekɨ nepɨmatsiwawirie, neti'aitɨwame.  
\v 19 'Ekɨtsɨ 'aixɨa pekanetiniuxeiya, ke'aixɨa nehetsiemieme pemɨtiuyuri pɨmariwe netukari pemutawikweitsitɨakɨ. Ne matsi nepɨkayɨwe nemɨneta'una hɨritsie paitɨ, nɨka netsi'anuku'axe kepauka mɨka'unarieni kiekari, tietɨtsɨ nemɨnemɨ.  
\v 20 'Ena kiekari yateewa pukuma 'etsiyeutɨ, mana nepɨneta'una. ¿Xekaneneupitɨa mana pɨta nemɨneta'unakɨ? Mɨkɨ kiekari 'etsikaniyeuka, mɨkɨtsie nekaniyuti'awietamɨkɨ.   
\p
\v 21 Hikɨ xewitɨ mɨkɨ mɨpaɨ katinitahɨawe:  
\p —Kepemɨnerawawiriwa yanepɨra'eriwa. Nepɨka'ika'una kiekari pemexaxata.  
\v 22 Keneumienitsɨari xeiya, kene'ata'una mana paitɨ, peheta'ayuke yanepɨtiyurieni.  
\p 'Ayumieme mɨkɨ kiekari Tsuhaxi titewatɨ patɨa.\f + \fr 19:22 \ft Hepɨrayukɨ \fq Tsuhaxi \fqa 'etsimɨyewa\ft  kananuyɨneni.\f*   
\p
\v 23 Ruti Tsuhaxi peta'a tau haneximekaku.  
\v 24 Hikɨ Yawé tai wiyeriyari kaneyenɨ'ani meta 'atsupɨre taiyari kaniukawiwieni muyuawitsie mieme Tsuruma meta Kumuxa wahetsie.  
\v 25 Mɨpaɨ katiniwaruka'una mɨkɨ kiekarite meta yunaime mana kiekatari, naime mayeweritsie meta tita mana mɨtixuawekai.  
\v 26 Peru Ruti 'ɨyaya yu'utɨma kananakuniere 'una teteyari kanayani.   
\p
\v 27 Hikɨ 'uxa'arieka ximeri paitɨ 'Apɨrahami kananukukeni, kaneyani hakewa Yawé hamatɨa mɨrekuxatakai.  
\v 28 Kaneutaniere Tsuruma meta Kumuxa wahepatsie meta naitsarie mayeweritsie, hikɨ mana kɨtsi kaniuxeiya mana hatineikame, huxunuta wa'atɨ pɨratineika.   
\p
\v 29 Mɨpaɨ Kakaɨyari pɨtika'unaxɨ mɨkɨ kiekarite makuweritsie mukumanekai, peru 'Apɨrahami kemɨrehɨawekai paye'eri, Ruti mana putawikweitsitɨa kiekari ka'unarieximekaku mana mukateikɨ.   
\s1 Ruti meta niwemama  
\p
\v 30 Hikɨ Ruti marikakɨ Tsuhaxi kayuhayewamɨtɨ, kaneyani hɨritsie paitɨ yuniwema memuyuhuta warawitɨtɨ. Mana paitɨ terɨta kanayekateitɨni wahamatɨa.  
\v 31 Merikɨtsɨ mɨixari muwa me'ayetetɨ, Ruti niweya 'amɨyumate yutaru mɨpaɨ katiniutahɨawe:  
\p —Tapaapa pɨ'ukiratsiri, meta naitsarie 'ena mɨtiuyehanetsie mepumawe 'ukitsi memɨtatsitiwitɨnikɨ, naitsarie teɨteri kememɨteyutiwitɨkɨ.  
\v 32 Hikɨmɨ, tepititawaitɨani, 'anari hamatɨana tekanikahikuni, mɨpaɨ teyɨme tanuiwarima tepɨwarayexeiya.   
\p
\v 33 Hikɨ mɨkɨ tɨkaritsie yupaapa mekaniuti'itɨani, hikɨ kahayu'eriwakaku, 'ana niweya 'amɨyumate kaniukahuni hamatɨana.  
\v 34 'Uxa'arieka, 'amɨyumate mɨpaɨ yutaru katiniutahɨawe:  
\p —Neuxei, ne hikɨ tɨkaritsie nepaapa hamatɨa nepukahui. Yaxeikɨata hikɨ taikai tepiti'itɨani, 'ekɨta hamatɨana pepɨkahuni, mɨpaɨ teyɨme tanuiwarima tepɨwarayexeiya.   
\p
\v 35 Mɨkɨ tɨkaritsieta yupaapa mekaniuti'itɨani, mɨkɨ kahayu'eriwakaku, niweya yakɨmɨyumate hamatɨana kaniukahuni.  
\v 36 Mɨpaɨ me'uyɨka yuhutatɨ Ruti niwemama mekaniutihukataxɨani yupapatsie miemekɨ.  
\v 37 'Amɨyumate xeime 'ukitɨme kaniutiniweni, Muhawi katiniterɨwa, muhawitsixi wapaapa matɨa.\f + \fr 19:37 \ft Hepɨrayutsixi waniukikɨ, \fq Muhawi\ft  'etsiwatɨkaku yaxeikɨa pɨti'eniɨriɨkɨ \fqa yupaapa hetsiemieme.\f*  
\v 38 Taruyata yaxeikɨa, 'ukitɨme kaniutiniweni, Weni-'Ami\f + \fr 19:38 \ft Hepɨrayutsixi waniukikɨ, \fq Weni-'Ami\ft  'etsiwatɨkaku yaxeikɨa pɨti'eniɨriɨkɨ \fqa ne'iwama wanu'aya.\f* katiniterɨwa, 'amunitsixi wapaapa matɨa.   
\c 20  
\s1 'Apɨrahami meta 'Awimereki  
\p
\v 1 'Apɨrahami mana mɨyetɨa kaneyani Nekexi mɨrakutewatsie 'erietɨ, Karetsi Tsuhuxi wahixɨapa kaniuyuhayewa Keraxi mɨrakutewatsie.  
\v 2 'Apɨrahami, Tsara mɨ'ɨyayatɨkai, kename 'iwayatɨkai kaniutainekaitɨni. 'Ayumieme mana 'Awimereki, Keraxi kwieyaritsie ti'aitame, katiniuta'aita mɨwitɨkiemiekɨ Tsara, neiwitɨni 'ɨyaya mayanikɨ.  
\v 3 Hikɨ mɨkɨ tɨkaritsie, Kakaɨyari 'Awimereki kaniutahɨawe heinɨtsitana, mɨpaɨ katinitahɨawe:  
\p —Neuxei 'ekɨ pekanimɨmɨkɨ 'ukaratsi pemewitɨkɨ, mɨkɨ 'ukaratsi kaniwikieka.   
\p
\v 4 Hikɨ 'Awimereki 'ukaratsi hamatɨa mɨkakahuiwekaikɨ, mɨpaɨ katinitahɨawe:  
\p —Ti'aitame, pepɨkanetsikumemiwani, ne 'axanepɨkatiuyuri,\f + \fr 20:4 \ft \fq 'axanepɨkatiuyuri\ft . Hepɨrayutsixi waniukikɨ \fqa ne meta neteɨterima 'axatepɨkate'uyuri.\f*  
\v 5 'Apɨrahami mɨpaɨ pɨnerahɨawekai kename 'iwayatɨkai, 'ukaratsi yaxeikɨata pɨnetiutahɨawixɨ, neri yurikɨ neti'erietɨ nepeiwitɨ, peru ne'ɨyaya ne'inawairienike nepɨkatiuyuri.   
\p
\v 6 Kakaɨyari mɨpaɨ katinita'eiya:  
\p —Mɨpaɨ nepɨtimate, yuri petiwa'eririetɨ pepeiwitɨ, 'ayumieme nepɨkamatsi'upitɨa pemikumayɨanikɨ, xurikime pemɨkatiwiwiwanikɨ nehetsɨa.  
\v 7 Peru mɨkɨ 'ukaratsi keneyetua hikɨ, mɨkɨ kɨnaya niukame kanihɨkɨtɨni nehetsiemieme, kanenitawawiriemɨkɨ 'ahetsiemieme pemuyeikanikɨ 'akuxi, peru xɨka peka'iyetuani 'ekɨ yaxeikɨa 'akie kiekatari wahamatɨa pekanimɨmɨkɨ.   
\p
\v 8 'Uxa'arieka ximeri 'Awimereki yuteɨterima warutahɨaweka, katiniwarutaxatɨani kemɨtiuheinɨkai. Mɨkɨ me'i'enieka waɨkawa mekaniutimamani.  
\v 9 Hikɨ 'Awimereki, 'Apɨrahami katiniutanɨ'airieni mɨpaɨ katinitatieni:  
\p —Neuxei, kepetatsi'uyuri. ¿Kepaukakuta 'axanepɨmatsi'uyuri, titayari xurikime petatitiwiwiriwa nehetsie meta nemɨra'aita wahetsie? 'Axamemɨte'u'iyari kememɨkanetsi'uyuri 'ekɨ pɨta waɨkawa 'axapepɨnetsi'uyuri.  
\v 10 ¿Kepetiku'eriwatɨ mɨyapeputayɨ?  
\p 'Awimereki mɨpaɨ titatieku,  
\v 11 hikɨ 'Apɨrahami mɨpaɨ katinita'eiya:  
\p —Ne mɨpaɨ nepɨtiku'eriwakai, xeme Kakaɨyari xeka'ayemakaxeme nepɨ'eriekai, xenetsimienike nepɨ'eriekai ne'ɨya hetsiemieme.  
\v 12 Peru kaniyuritɨni mɨkɨ kanine'iwatɨni, nepaapa niweya kanihɨkɨtɨni, peru nemaama pɨkaniweya, 'ayumieme pɨyɨwekai ne'ɨya mayanikɨ.  
\v 13 Kepauka mɨpaɨ mɨnetiuta'aitɨa Kakaɨyari, kename nepaapa nemaama newaku'eirienikekai, kename 'ateewa neyemiekai, ne ne'ɨya mɨpaɨ nepɨtiutahɨawixɨ: «Neuxei mɨpaɨ nepɨmatiwawirie: Tsepa hakewa temekɨ, kename ne 'amatsika nehɨkɨ peputaineni».   
\p
\v 14 Hikɨ 'Awimereki Tsara 'Apɨrahami kaniyetuirieni meta katinimini muxatsi, wakaitsixi, te'uximayatamete 'ukitsi meta 'ukarawetsixi.  
\v 15 Meta 'Awimereki mɨpaɨ katinitahɨawe:  
\p —Neuxei, nekwie 'ena kanikumaka, hakewa mɨmatsihenakeni mana keneukani.   
\p
\v 16 Tsara meta mɨpaɨ katiniutahɨawe:  
\p —Neuxei, 'a'iwa nepu'ɨitɨa tamamata heimana xewi kiruyari heimana 'imeriyu pɨrata tepɨayari, mɨkɨ kani'ayumiemetɨni 'axapemɨkaramamatiwanikɨ, mɨpaɨ memɨtehetimanikɨ 'a'iwama kename 'ekɨ 'atsipekatiuyuri, mɨpaɨ xewitɨ 'atsipɨkametitamani.\f + \fr 20:16 \ft Hepɨrayukɨ pɨkahekɨa.\f*   
\p
\v 17 Hikɨ 'Apɨrahami Kakaɨyari kaniutawawirieni, kepauka muyutanenewi Kakaɨyari 'aixɨa kaniwaruyurieni 'Awimereki meta 'ɨyaya, metatsiere mɨtiwa'aitɨakai, memɨniwewawenikɨ hutarieka,  
\v 18 Tsara mɨya mɨranuyetɨakɨ, 'Apɨrahami 'ɨyaya, Yawé 'Awimereki kie kiekatari 'ukarawetsixi mekaniwewaweme kaniwarayeitɨakaitɨni.   
\c 21  
\s1 'Itsahaki kemɨtiunuiwaxɨ  
\p
\v 1 Yawé kemainekai, Tsara 'aixɨa kaniuyurieni, katinaye'atɨani kemɨrehɨawekai.  
\v 2 Tsara kaniutihukata 'Apɨrahami nu'ayatɨme kanayexeiya 'ukiratsitɨkaku. Kakaɨyari kepauka mainekai 'ana katiniunake.  
\v 3 'Apɨrahami yuniwe 'Itsahaki katiniuterɨwa, Tsara hamatɨa memeyexei.  
\v 4 'Apɨrahami xitekiya 'inɨariyari 'Itsahaki kaniuwewirieni 'atahaika tukari 'anukayaku, Kakaɨyari kemɨtita'aitɨa.  
\v 5 Xeitsienituyari wiyari kanexeiyakaitɨni 'Apɨrahami kepauka 'Itsahaki mutinuiwaxɨ.  
\v 6 Hikɨ Tsara mɨpaɨ kaniutayɨni: «Kakaɨyari nemutanawenikɨ yapɨnetiupitɨa, yaxeikɨata kemɨ'ane memɨtehetimani meputinaweni nehamatɨa.  
\v 7 Matsi nixewitɨ 'Apɨrahami mɨpaɨ pɨkarehɨawekai kename ne tɨɨri newatitsitsitɨanikekai, matsi hikɨ nunutsi nepayexei nu'ayatɨme 'ukiratsitɨkaku».   
\s1 Hakari meta 'Itsimaheri kememɨtehayenɨ'arie  
\p
\v 8 Nunutsi 'Itsahaki kaniutawere, tsitsieya mekaniku'eiritsitɨani. Mɨkɨ tukaritsie 'Apɨrahami 'ixɨarari kaniuwewieni yuniwe hetsiemieme.  
\v 9 'Ana Tsara mɨpaɨ katinetimani 'Itsahaki 'ekipitutanaka Hakari nu'aya 'Apɨrahami hamatɨa meyexeiyakai kaninanaimakaitɨni 'i'atsetɨ.\f + \fr 21:9 \ft Kɨriyekutsixi waniukikɨ \fq 'Itsahaki\ft . Peru hepɨrayutsixi waniukikɨ pɨkahexaxata.\f*  
\v 10 Hikɨ 'ayumieme Tsara 'Apɨrahami mɨpaɨ katiniutahɨawe:  
\p —Kenanunɨ'a ti'a'uximayatsiriwame yuniwemakame, neniwe 'Itsahaki tita pemɨtiyetuirieni 'apiini, mɨkɨ mana heitserie pɨkahexeiyani ti'a'uximayatsiriwame nu'aya.   
\p
\v 11 Kepauka 'Apɨrahami mɨyamɨtiutahɨawarie, kaniuyukahiwerieni nu'aya mɨhɨkɨtɨkaikɨ Hakari hetsiemieme.  
\v 12 Peru Kakaɨyari 'Apɨrahami mɨpaɨ katiniutahɨawe: «Pepɨka'a'iyaritɨaka nunutsikɨ meta maamaya ti'uximayatamekɨ. Tsara kemerahɨawe yaketineuyuri, 'anuiwarima 'Itsahaki hetsie pɨta mekaniyekɨnikuni.  
\v 13 Meta ti'uximayatame nu'aya nuiwari mariweme nepayeitɨani, 'aniwe mɨhɨkɨkɨ».   
\p
\v 14 'Uxa'arieka, ximeripaitɨ 'Apɨrahami nanukukeni, paa, nawi haa 'uyemakame Hakari naiparieyatsie nekawirieni. Hikɨta nu'aya kaniyetuirieni, meta kaniwarutateutɨani. Hakari kanayeyani, mekaniuhukaitɨni me'u'erietɨ makumawetsie Weritsewa mɨrakutewatsie.  
\v 15 Kepauka yuhaa memayexɨ nawita mɨyemakai, Hakari yuniwe 'ɨtsitɨa 'itiyeka,  
\v 16 kaneyani yateewa mana 'ukaitɨ kaniutitsɨatɨyani maamaya, temaikɨ kaxeiyamɨtɨ kepauka mɨmɨnikekai.\f + \fr 21:16 \ft Hepɨrayukɨ \fq kaneyani yateewa\ft , yatɨni \fqa tupikɨ tiutamɨyɨ 'ɨrɨ keteewa mukawautse\ft  panuyɨne.\f*   
\p
\v 17 Hikɨ Kakaɨyari temaikɨ tsuarieya kaniu'enieni, Hakari kaniutahɨawe muyuawitsie paitɨ niuki tuayame Kakaɨyari hetsiemieme mɨpaɨ katinitahɨawe: «Hakari mɨpaɨ pepɨkayɨaneni. Pepɨkamaka, Kakaɨyari temaikɨ tsuarieya kaniu'enieni.  
\v 18 Xeiya kenemie hetsɨana keneuwitɨximeni pepɨka'itatuayani, ne mɨkɨ nuiwarieya mariweme nekanayeitɨamɨkɨ».   
\p
\v 19 Hikɨ Kakaɨyari Hakari haixa kaniuxeitsitɨani. 'Anari yapauka 'utihanɨka nawi kɨxauriyaritsie temaikɨ kaniuharitɨani.  
\v 20 Hikɨ Kakaɨyari temaikɨ hamatɨa kaniuyeikakaitɨni, mɨkɨ kaniwerekaitɨni makumawetsie kaniukateitɨni, tupi 'ɨrɨkɨ kwinimieme timɨiwetɨ kanayani.  
\v 21 Parani mɨrakutewatsie kaniukateitɨni makumawetsie, maamaya 'ekipitutanaka kaniwitɨtɨani.   
\s1 'Apɨrahami meta 'Awimereki tɨratu kemɨte'uwewi  
\p
\v 22 'Ana 'Awimereki 'Apɨrahami hetsɨa kaninuani, Pikuuri titewatɨ kaneteɨtakaitɨni kuyaximama wa'ukiyari, mɨpaɨ 'Apɨrahami katiniutahɨawe:  
\p —Mɨpaɨ tepɨtemate, Kakaɨyari waɨkawa pɨmatsiparewie naime kepemɨtiyuriene.  
\v 23 'Ayumieme, yakenetineutahɨawi Kakaɨyari hɨxie, hikɨ kwitɨwa, kename pekaneti'itaiyani meta neniwema yaxeikɨa nenuiwarima, yakeneutayɨki kename yaxeikɨa penetixeiyani kenemɨmatixeiya, meta yunaime teɨteri 'ikɨ kwieyaritsie kiekatari pemanuyeika 'ateewa kiekame hepaɨ.   
\p
\v 24 'Apɨrahami mɨpaɨ kaniutayɨni:  
\p —Huu, yanepɨra'eriwa.   
\p
\v 25 Peru 'Apɨrahami 'Awimereki katiniutaxatɨani putsu hepaɨtsita, mɨkɨ teɨterimama meminawairiekaikɨ.  
\v 26 'Awimereki mɨpaɨ kaniutayɨni:  
\p —Nematsi mɨpaɨ nepɨkatimaikai, 'ekɨtsɨ mɨpaɨ penerahɨaweka, ne 'atsinepɨkatimate kemɨ'ane mɨyamɨtiuyuri.   
\p
\v 27 Hikɨ 'Apɨrahami wakaitsixi kaniwarutiwiya muxatsi meta, 'Awimereki kaniumini, mɨkɨ tukaritsie yuhutatɨ tɨratu mekaniuwewieni.  
\v 28 Peru 'Apɨrahami 'atahutame muxatsi 'ukarawetsixi kaniwarayehapani yukuraruta,  
\v 29 'Awimereki 'Apɨrahami mɨpaɨ katiniuta'iwawiya:  
\p —¿Titayari petiwarayehapana mɨkɨ 'atahutame muxatsi?   
\p
\v 30 'Apɨrahami mɨpaɨ katinita'eiya:  
\p —'Ikɨ 'atahuta muxatsi 'ukari keniwarutanaki'eri. Matsi mɨpaɨ mɨtimatsiɨkɨnikɨ kename ne putsu ne'utawewi.   
\p
\v 31 'Ayumieme mana Weritsewa pɨtiuterɨwarie, mana tɨratu memuwewikɨ yuhutatɨ.\f + \fr 21:31 \ft \fq Weritsewa\ft  hepɨrayukɨ \fqa putsu 'atahuta muxatsi\ft  panuyɨne meta \fqa tɨratu.\f*   
\p
\v 32 Hikɨ tɨratu me'uwewiekari Weritsewa, 'Awimereki Pikuuri matɨa kuyaxi wa'ukiyari piritsiteutsixi yukwieyaritsie mekanakunuaxɨani.  
\v 33 Hikɨ mana Weritsewa, 'Apɨrahami tamaritsiku titewakame kaniuka'eni, mɨkɨtɨa Yawé Kakaɨyari 'atsimɨkayɨwe kaniutahɨawekaitɨni.  
\v 34 Mɨixa wiyari 'Apɨrahami kaniutihuni piritsiteutsixi wakwieyaritsie 'ukaitɨ.   
\c 22  
\s1 Kakaɨyari 'Apɨrahami kemɨtiuta'inɨataxɨ  
\p
\v 1 Merikɨtsɨ yapaɨmexɨa tukari 'anukayaku, Kakaɨyari 'Apɨrahami kaniuta'inɨata, mɨpaɨ katinitahɨawe:  
\p —'Apɨrahami 'aku.  
\p 'Apɨrahami mɨpaɨ katinita'eiya:  
\p —'Ena nepuyeika.   
\p
\v 2 Kakaɨyari mɨpaɨ katinita'aitɨani:  
\p —'Aniwe muyuxewi 'a'iyarikɨ peminakierie, kenawitɨtɨ kenemie Muriya kwieyaritsie paitɨ. Hikɨ mana keneutimawa mawari naitɨ mɨtaiyarɨwa hepaɨ, xeime hɨri nemɨmatsixeitsitɨanitsie.   
\p
\v 3 'Uxa'arieka ximeri paitɨ kananukukeni 'Apɨrahami yupuxu kaniutixiratɨani mɨranu'ikatakɨ. Meta kɨye kaniutiwiteni mɨretimawarieni hetsiemieme, hikɨ meyuhutame te'uximayatamete meta yuniwe 'Itsahaki warawitɨtɨ kanayeyani hakewa Kakaɨyari mɨrehɨawekai.  
\v 4 Hairieka tukaritsie me'uhutɨ, 'Apɨrahami hɨri 'ateewa kaniuxeiya hakewa Kakaɨyari mexatakai.  
\v 5 Hikɨ 'Apɨrahami mɨwarawitɨkɨ te'uximayatamete yuhutame, mɨpaɨ katiniwarutahɨawe:  
\p —'Ena xekeneyuhayewa puxu hamatɨa. 'Akuxi temaikɨ meta ne tepuhuni, Kakaɨyari temetahɨawekɨ, kwitɨwata tepakunuaxɨani xehetsɨa.   
\p
\v 6 'Apɨrahami kɨyexi 'uti'ɨka 'Itsahaki kaniutitɨtɨani, mɨkɨta tai kaniutikweni meta nawaxa kanakakeni. Hikɨ mekanekɨne yunaitɨ me'uhutɨ.   
\p
\v 7 'Itsahaki 'Apɨrahami mɨpaɨ katiniutahɨawe:  
\p —Nepaapa.  
\p Paapaya mɨpaɨ katinita'eiya:  
\p —¿Tita neniwe?  
\p 'Itsahaki mɨpaɨ kaniutayɨni:  
\p —Neuxei, kɨyexi tema'ɨ, tai temakwe'e, peru ¿hakewa muxa temeitimawa?   
\p
\v 8 'Apɨrahami mɨpaɨ katinita'eiya:  
\p —Neniwe. Kakaɨyari kaniyɨweni mɨkɨ muxa kaneyetuamɨkɨ.  
\p Hikɨ mekaniuhukaitɨni.   
\p
\v 9 Hikɨ kepauka memuye'axɨa Kakaɨyari hakewa mexatakai, mana 'Apɨrahami mawari taiyame kaniutawewieni meta kɨyexi 'aixɨa katiniunetɨani mana. Hikɨ yuniwe 'Itsahaki 'uwiyaka kanihɨani mawari taiyametsie kaneteni kɨyexi heima.  
\v 10 Hikɨ 'Apɨrahami yunawaxa kaniwatihana yuniwe mienike mawari mayanikɨ,  
\v 11 peru Yawé niuki tuayameya 'anakwitɨ heimana kanetaniuni karima mɨpaɨ tikɨhɨawetɨ:  
\p —'Apɨrahami. 'Apɨrahami 'aku.  
\p Mɨkɨta mɨpaɨ katinita'eiya:  
\p —'Ena nepuyeika.   
\p
\v 12 Hikɨ niuki tuayame mɨpaɨ katinitahɨawe:  
\p —Keneuhayewa temaikɨ, pepɨkatikwinitɨaka. Nepɨretimari 'ekɨ Kakaɨyari pepayemakaxe, pepɨka'uyuta'ima 'aniwe penetsiyetuirienike muyuxewi.   
\p
\v 13 Hikɨ 'Apɨrahami kananieretɨyani, muxa kaniuxeiya yu'awatekɨ tsekame 'ɨtsitsie. Hikɨ 'Apɨrahami 'ixɨnaka kanitimawa taipa yuniwe hetsiemieme.  
\v 14 'Ayumieme 'Apɨrahami mana pɨtiuterɨwaxɨ: «Yawé pɨrayetuirieni tita mɨreuyehɨaka». 'Ayumieme teɨteri mɨpaɨ meputiyuane: «Hɨritsie Yawé pɨrayetuirieni».   
\p
\v 15 Yawé niuki tuayameya 'Apɨrahami kaniutahɨawe hutarieka taheima paitɨ,  
\v 16 mɨpaɨ katinitahɨawe:  
\p —'Ekɨ pepɨraye'atɨa kenemutayɨ, 'aniwe muyuxewi pepɨka'utikweri, 'ayumieme ne yurikɨ nekanaineni ―Yawé mɨpaɨ kanaineni—.  
\v 17 'Aixɨa nepɨmatsiyurieni waɨkawamekɨ, 'anuiwarima yɨmɨireme nepuwarayeitɨani xurawetsixi muyuawitsie memɨtama wahepaɨ meta xiekari haramara tetsita mɨtika hepaɨ. Meta 'anuiwarima mepɨte'ayu'iwani kemɨ'ane memɨwaraye'unie wakiekarite mepɨwanawairieni.  
\v 18 Yemekɨ kenematiutahɨawixɨ yapemɨtikatɨakɨ, yunaitɨ nuiwarite kwiepa memɨtama 'aixɨa mepɨ'itɨarieka 'anuiwarima wahekɨ.   
\p
\v 19 'Apɨrahami kanakunuani hakewa memeyuhayewakai te'i'uximayatsiriwametemama, hikɨ yunaitɨ mekanekɨne Weritsewa, hakewa 'Apɨrahami mekatei.   
\s1 Nakuxi niwemama  
\p
\v 20 Hikɨ kepauka, 'Apɨrahami katiniutamarieni kename 'iwaya Nakuxi yɨ'ɨya Mirika hamatɨa, tɨɨri mewarayexei.  
\v 21 Matɨarieya 'Utsi titewatɨ kanayani, 'utɨmanata mekaniutinunuiwa Wutsi, Kemuheri matɨa. 'Ikɨ wa'utɨamieme 'Arami paapaya kanayani.  
\v 22 Mɨkɨ wa'utɨata mekaniutinunuiwa Ketseri, Katsú, Piriratsi, Hirurapi, 'imatɨrieka Wetuheri,  
\v 23 mɨkɨ Xeweka paapaya patɨa. 'Ikɨ mepɨhɨkɨ 'atahaika tɨɨri Mirika Nakuxi hamatɨa memɨwarayexei, 'Apɨrahami 'iwaya.  
\v 24 Nakuxi meta kaniwarayexeiya tɨɨri Xeuma titewakametsie, hutarieka yɨ'ɨyatsie. Mɨkɨ mepɨtetetewakai, Tewaki, Kakani, Takatsi, meta Mahaka.   
\c 23  
\s1 Tsara kemɨtiumɨ  
\p
\v 1 Tsara xeitsienituyari heimana xeitewiyari heimana 'atahuta wiyari kaniutihuni,  
\v 2 kaniumɨni Kiriati-'Ariwa mɨrakutewatsie, tatsɨari Hewuruni kiekariyaritsie Kanani kwieyaritsie. 'Apɨrahami puyuheiweriekai waɨkawa hetsiena mieme.  
\v 3 Hikɨ 'Apɨrahami mana 'auriena 'anukukeka, kaneyani Heti nuiwarimama mɨpaɨ tiwaretahɨaweke:   
\p
\v 4 —Neuxei, ne 'ena nepɨkakiekame, peru kwie terɨ xepɨnetsituirieni muwa ne'ɨya nemeutatenikɨ.   
\p
\v 5 Hikɨ hetitsixi mɨpaɨ 'Apɨrahami mekateniuta'eiya:   
\p
\v 6 —Neuxei 'ekɨ ketaneu'eni, 'ekɨ mariweme mexɨakame pepɨhɨkɨ. Keneuka'awieta 'a'ɨya taterɨ 'aixɨa mɨ'aneneta tsepa kemɨ'ane terɨyarita. Xewitɨ yuterɨ pɨkametsitikweririeni 'a'ɨya muwa pemeutatenikɨ.   
\p
\v 7 Hikɨ 'Apɨrahami kananukukeni nakatutsita hetitsixi wahɨxie,  
\v 8 mɨpaɨ katiniwarutahɨawe:  
\p —Xɨka yurikɨ xenakeni ne'ɨya 'ena nemɨka'awietakɨ, xekeneneuparewi, 'Epuruni mɨpaɨ xeteneutahɨawi Tsukaxi nu'aya,  
\v 9 kenetsi'utuirieni terɨ Makipera mɨrakutewatsie muka, mɨkɨ kwieya maka'atɨkatsie. Mɨpaɨ xeketeneutahɨawi kenetsi'utuirieni yemekɨ kemɨraye'axe, mɨpaɨ ne 'ena mɨkite wateukume nehexeiyatɨ nepayani netɨɨriyama wahetsiemieme.   
\p
\v 10 Hikɨ 'Epuruni Heti tewiyari mana kaniukateitɨni yuteɨterima wahamatɨa, 'ayumieme 'Apɨrahami katiniutaxatɨani humapaitɨ 'eniɨriɨkɨmekɨ, hipatɨta memi'enienikɨ yaxeikɨata kiekari kitenie memuyekɨkakai:   
\p
\v 11 —Hawaikɨ, neti'aitɨwame keneneu'eni, nematsi nepɨmatsimikwa mɨkɨ terɨ meta kwie naime. Ne'iwama mepɨ'enana kename nematsimikwa. Mana keneukateuki 'a'ɨya.   
\p
\v 12 Peru 'Apɨrahami tawarita nakatutsita yunaime wahɨxie mana kiekatari,  
\v 13 hikɨ yunaitɨ me'enanakaku 'Epuruni mɨpaɨ katiniutahɨawe:  
\p —Neuxei, keneneu'eni kwerietɨ. Ne tawarita yanepaine nemɨmatipitɨanikɨ kwie kemɨraye'axe. 'Ekɨ yaketineutanaki'eri, mɨpaɨke ne'ɨya mana nepɨka'awieta.   
\p
\v 14 Hikɨ 'Epuruni mɨpaɨ 'Apɨrahami katiniuta'eiya:   
\p
\v 15 —Neti'aitɨwame, keneneu'eni. Kwie nauka tsienituyari pɨrata tuminiyarikɨ\f + \fr 23:15 \ft \fq tumini.\ft  Hepɨrayutsixi waniukikɨ \fqa tsekerexi.\f* pɨraye'axe. Mɨpaɨ paɨmemekɨ 'atsitepɨkatiyuani. Hikɨ 'a'ɨya keneka'awieta.   
\p
\v 16 'Apɨrahami 'Epuruni matɨa 'aixɨa mekateniuxata, hikɨ hetitsixi wahɨxie katinayukatuani kemɨtiheitserie: nauka tsienituyari pɨrata tuminiyarikɨ, tumini waɨkawa mɨti'axe hepaɨ katininaneni tetuayamete wahepaɨ.   
\p
\v 17 Mɨpaɨ 'Apɨrahami kwie katiniunaneni 'Epuruni tipiinieya, Makipera mɨrakutewa Mamɨre 'aurie tserietana. Mɨkɨ terɨ naime kɨyexite mɨreuti'ukai mɨkɨ kwieyaritsie 'Apɨrahami tipiinieya kanayani.  
\v 18 'Apɨrahami tipiinieya pɨratɨa yuheyemekɨ hetitsixi teɨteriyari wahɨxie meta kiekari kitenie memutakɨkakai.  
\v 19 Hikɨ 'Apɨrahami yu'ɨya Tsara kaniukateuku terɨta kaneitateni, Makipera mɨrakutewatsie Mamɨre tserieta, yaxeikɨata Hewurunikɨ pumatiwa, Kanani kwieyaritsie katini'aneni.  
\v 20 Mɨpaɨ tiuyɨku mɨkɨ kwie meta terɨ hetitsixi wapiini pɨkaratɨari, 'Apɨrahami tipiinieya pɨta kanayani mɨkite wateukume mayanikɨ yuheyemekɨ.   
\c 24  
\s1 'Itsahaki meta Xeweka  
\p
\v 1 Merikɨtsɨ 'Apɨrahami kani'ukiratsitɨkaitɨniri waɨkawa wiyari kanexeiyakaitɨni, Yawé Kakaɨyari kaniparewiekaitɨni naimekɨ.  
\v 2 Hikɨ 'Apɨrahami 'ukiratsi meripaitɨ miparewi kaniuta'inieni, kiena naime mɨti'uximayatsiriekai tita mɨrexeiyakai, mɨpaɨ katinitahɨawe:  
\p —Neteuritɨa keneutame'i,  
\v 3 Yawé hɨxie yurikɨ yakenetineutahɨawi, kemɨ'ane kwie meta muyuawi mutawewi, kename 'uka 'ena kiekame Kanani peka'iwitɨtɨani neniwe  
\v 4 'Itsahaki, matsi pekaniyemieni nemarema wahetsɨa, muwa neniwe 'ɨyaya mayani pekananuyewaumɨkɨ.   
\p
\v 5 Ti'uximayatame mɨpaɨ katinitahɨawe:  
\p —¿Perutsɨ xɨka 'uka ne'utɨma mamie kaheyuwaɨriyani 'ikɨ kwieyaritsie paitɨ? ¿Kamɨtsɨ neramie 'aniwe neranuwitɨni wakie paitɨ?   
\p
\v 6 'Apɨrahami mɨpaɨ katinitahɨawe:  
\p —Hawaikɨ, neniwe pepɨkahewitɨkɨni muwa paitɨ,  
\v 7 Yawé Kakaɨyari muyuawi mutawewi nekie pɨnetseheyewitɨ ne'iwama wahetsɨa, mɨpaɨ netihɨritɨatɨ: «'Anuiwarima nepɨwayetuirieni 'ikɨ kwie», mɨkɨ yuniuki tuayame kananunɨ'amɨkɨ 'ahamatɨa mɨmatsi'anuwitɨnikɨ, 'ekɨ pemeyɨwekaxɨanikɨ 'uka pemawitɨni neniwe 'Itsahaki hetsiemieme.  
\v 8 Xɨka 'uka 'a'utɨa mamie kaheyuwaɨriyani, 'ekɨ pepɨxɨne kenemerahɨawe, peru neniwe pepɨkahewitɨkɨni muwa paitɨ.   
\p
\v 9 Hikɨ ti'uximayatame 'Apɨrahami teurieyatɨa kaneutameni, mɨpaɨ katinitahɨawe kename yurikɨ yatikayani kemɨtihɨritɨa.  
\v 10 Hikɨ kameyutsixi kaniwarukuha'aritɨani tamamata meyupaɨmeme 'Apɨrahami tewamama, meta waɨkawa 'imikierite katiniukuha'aritɨani, kaneyani Nakuxi manukateitsie Metsuputamiya kwieyaritsie.  
\v 11 Mana nuaka kiekari warita haputsu 'aurie yukameyutsixi kaniwarukatuani. Hikɨ kaniukutaikaire, kepauka 'ɨimarixi mematihanɨwetsie kanaye'ani.  
\v 12 Hikɨ ti'uximayatame mɨpaɨ katiniuyutanenewieni: «Yawé, 'Apɨrahami neti'aitɨwame Kakaɨyarieya, waɨkawa nepɨmatsiwawirie hikɨ 'aixɨa nemɨtiyurienikɨ, 'Apɨrahami nekutsiyari kepemɨtinaki'erie yaketineuyuri.  
\v 13 Ne 'ena nepuwe haa matineika newatakwewietɨ, 'ena kiekatari waniwema memayekɨnirɨme metihanɨnike.  
\v 14 Keneupitɨa 'iya 'uka kemɨ'ane mɨpaɨ nemɨtitahɨawe: “Neuxei 'aye'ɨ kenanakahani 'etsiwa nemanuharenikɨ”, mɨkɨta mɨpaɨ kenetiuta'eiya: “Kenanutihareka, 'akameyutsixita nekaniwatiharitɨamɨkɨ”, mɨkɨ 'uka kehɨkɨtɨni pemenayexei 'Itsahaki hetsiemieme mati'uximayatsiriwame. 'Ana mɨpaɨ nepɨretimani kename yapetiuyuri pe'inaki'erie 'Apɨrahami neti'aitɨwame».   
\p
\v 15 Hikɨ yunenewietɨ karanunɨwekaku Xeweka kaniuxeiya, 'akanamiekaitɨni yuye'ɨ 'anakayetɨ. Xeweka Wetueri kaniniweyatɨkaitɨni, Wetuheri kaniwaniwetɨkaitɨni Mirika Nakuxi hamatɨa, Nakuxi 'Apɨrahami 'iwaya.  
\v 16 Mɨkɨ 'uka witsipɨti'ɨimarikai, pɨkawikiekai, 'uki pɨkamaikai 'akuxi. Mɨkɨ haa matineika nuaka kaniutihanɨni. 'Ari pɨyemieximekai  
\v 17 hikɨ ti'uximayatame kaniutanautsa hepana, mɨpaɨ katinitahɨawe:  
\p —¿'Etsiwa 'ekɨ pekanetiuharitɨawe haa 'aye'ɨta miemekɨ?   
\p
\v 18 'Uka mɨpaɨ katinita'eiya:  
\p —Kenanuhareka.  
\p Yuye'ɨ 'anakahanaka kanenutiharitɨani.   
\p
\v 19 Kepauka ti'uximayatame 'anuharekuri, Xeweka mɨpaɨ katinitahɨawe:  
\p —Nekaniwatihanɨimɨkɨta 'akameyutsixi wahetsiemieme memɨtiharenikɨ kememɨteuhariku.   
\p
\v 20 Hikɨ tewaxi mematiharewetsie 'ikatuaka, waɨkawamexɨa kanakunuani hanɨnetɨ memɨte'atiharewetsie 'ikatu'atɨ, yunaitɨ memɨtiharenikɨ kameyutsixi.  
\v 21 'Apɨrahami ti'uximayatsiriwame kanixeiyakaitɨni, mɨpaɨ tiku'eriwatɨ xɨka'aku Yawé tiyurienekaitɨni, 'aixɨa 'anemekɨ makunuanikɨ.   
\p
\v 22 Kepauka kameyutsixi memɨte'utahayewaxɨ meharetɨ, ti'uximayatame huru nakɨtsayari hewati'ɨka tsurieyatsie kaniyewirieni 'ataxewime kɨramuyari raheteme, meta huru matsɨwayari kaneimaniriexɨani hutame, xeitsienituyari kɨramuyari raheteme, ti'uximayatame mɨpaɨ katinita'iwawiya:   
\p
\v 23 —Neuxei, ¿kemɨ'ane 'ekɨ pepɨraniwe, 'apaapa kie meyekani 'aumɨ reyɨwe?   
\p
\v 24 Mɨkɨ mɨpaɨ katinita'eiya:  
\p —Ne Wetuheri nepɨniweya, Mirika meta Nakuxi waniwe,  
\v 25 mana xemetiheni peyɨwe meta mɨaxa waɨkawa pexɨawe kameyutsixi wahetsiemieme.   
\p
\v 26 Hikɨ ti'uximayatame kaniutitunumakeni Yawé pamɨpariyutsi kaniupitɨani  
\v 27 mɨpaɨ 'utaitɨ: «'Aixɨa pepɨtiuka'iyari Yawé 'Apɨrahami neti'aitɨwame Kakaɨyarieya, pe'inaki'erietɨ pepɨkatihayewa meta 'aixɨa pepɨnetiuye'atɨa 'iwamama wahetsɨa».   
\p
\v 28 Xeweka kaneyani 'unautsarɨmetɨ yumaama hetsɨa, mana katinitaxatɨani kemɨreiyuriekai.  
\v 29 Xeweka xeime yumatsika kanexeiyakaitɨni Rawani titewakame, mɨkɨ 'unautsarɨmetɨ kanayeyani ti'uximayatame heuwaumieka, haa matineika 'akuxi mɨkɨ kaniukateitɨni.  
\v 30 Rawani yu'iwa nakɨtsa kaniuxeirieni meta matsɨwa metatsiere kani'enieni tikuxatakaku ti'uximayatame kemɨrehɨawekai. 'Ayumieme kanayeyani ti'uximayatame heuwaumieka, haputsu matiniere kanitaxeiya, yukameyutsixi wahamatɨa.   
\p
\v 31 Mɨpaɨ katinitahɨawe:  
\p —Kɨmɨ, 'ekɨ 'aixɨa pepɨ'itɨarie Yawé yametipitɨakaku. ¿Titayari 'ena peti'akuhayeikawani kiekari warita? Neri 'aixɨa nepɨrekuyuri kiita xemeyehenikɨ, meta 'akameyutsixi wahetsiemieme.   
\p
\v 32 Hikɨ ti'uximayatame kiepa kaniye'ani. Yapauka Rawani kameyutsixi kaniwaruti'ikapieni mɨaxa kaniwarutimini, meta haa kaniwaruhanitɨani ti'uximayatame meta mɨwarawitɨkɨkai yu'ɨkatetsie memauyuhauxixɨanikɨ.  
\v 33 Kepauka memɨtekwanikekai 'Apɨrahami ti'uximayatameya mɨpaɨ kaniutayɨni:  
\p —Ne, nepɨkatikwani yanetayɨmeke titakɨ nemɨtikuyɨane.  
\p Hikɨ Rawani mɨpaɨ katinitahɨawe:  
\p —Yakeneutayɨkikuta.   
\p
\v 34 Ti'uximayatame mɨpaɨ katinitsutɨani:  
\p —Ne 'Apɨrahami ti'uximayatsiriwame nekanihɨkɨtɨni.  
\v 35 Yawé waɨkawa 'aixɨa kaniyurieka kaniparewieka. Katinikupinirieka muxatsi, wakaitsixi, huru, pɨrata, te'uximayatamete 'ukitsi 'ukari, kameyutsixi, meta puxuri.  
\v 36 Meta neti'aitɨwame 'ukiratsitɨtɨri yu'ɨya Tsara hamatɨa xeime nunutsi mekanayexeiya, neti'aitɨwame yuniwe naime katiniupitɨani.  
\v 37 Hikɨ neti'aitɨwame mɨpaɨ pɨnerehɨritɨa: “Neniwe pepɨkakuwitɨtɨwani 'ena kiekame kananeutsixi waniwe, nemanukatsie.  
\v 38 Matsi pɨta kenemie ne'iwama memanu'uwatsie, mana kenetiwawa 'uka neniwe 'ɨyaya mayanikɨ”.  
\v 39 Ne mɨpaɨ nekatineitahɨawe neti'aitɨwame: “Neuxeitsɨ. ¿Peru xɨka 'uka kaheyuwaɨriyani ne 'utɨma mamie?”  
\v 40 Hikɨ mɨpaɨ nerahɨawe: “Yawé nehamatɨa puyeika, mɨkɨ 'ahamatɨa yuniuki tuayame panunɨ'ani, 'aixɨa 'anemekɨ pemakunuanikɨ pemeikaxeiyakɨta 'uka neniwe hetsiemieme nepaapa tɨɨriyamama wahetsɨa.  
\v 41 Xɨka ne'iwama mekaheitaunieni 'uka, mɨpaɨ 'ekɨri pepɨkaraye'atɨani kepemutayɨ neri waɨriyarika nepɨkamatsipitɨani”.   
\p
\v 42 »Kepauka haa matineika nemunua mɨpaɨ neputayɨ: “Yawé 'Apɨrahami Kakaɨyarieya, xɨka mɨpaɨ matinakeni, waɨkawamekɨ nepɨmatsiwawirie 'aixɨa ketineuyuri 'aixɨa nemɨrakunuanikɨ.  
\v 43 'Ena nepuka, neta'ikwewatɨ haputsu matinieretsie. Xɨka xewitɨ 'ɨimari hayeyani kuhanɨnetɨ, mɨpaɨ nepɨtitahɨawe: ‘Neuxei, 'Etsiwa keneneuharitɨa 'aye'ɨta mieme’,  
\v 44 xɨka kemɨ'ane mɨpaɨ mɨtayɨni: ‘Kenanuhareka 'ekɨ, nekaniwatihanɨimɨkɨta kameyutsixi wahetsiemieme’, mɨkɨ kehɨkɨtɨni 'uka pemanayexei Yawé, neti'aitɨwame nu'aya hetsiemieme”.   
\p
\v 45 »'Akuxi nekaranunɨwekaku neyunenewietɨ, Xeweka nekaniuxeiya mana 'amiekame yuye'ɨ 'anakayetɨ. Hikɨ kaniutihanɨni haputsuta, mɨpaɨ nekatineitahɨawe: “Neuxei, keneneuharitɨa”.  
\v 46 Mɨkɨ yapauka yuye'ɨ 'anakahanaka mɨpaɨ kanetinetahɨawe: “Kenanutihareka 'ekɨ, meta 'akameyutsixi nekaniwatiharitɨamɨkɨ”. Mexi ne neheharekai mɨkɨta nekameyutsixi kaniwaretiharitɨani.  
\v 47 Hikɨ nekaneita'iwawiya: “¿Kemɨ'ane pepɨraniwe?” Kepauka mɨkɨ mɨpaɨ mɨnereta'ei: “Wetuheri nepɨniweya, Nakuxi Mirika waniwe”, ne tsurieyatsie nekaneiyewirieni nakɨtsa meta matsɨwa hutame nekaneimini,  
\v 48 hikɨ nekanetitunumakeni Yawé pamɨpariyutsi nekanepitɨani, 'Apɨrahami Kakaɨyarieya, 'aixɨa mɨnetiuye'atɨa 'uka nemɨtaxeiyakɨ 'iwamama waniwetɨme neti'aitɨwame nu'aya hetsiemieme.  
\v 49 Hikɨ, yaxekeneteneutahɨawi xɨka 'aixɨa xetekakɨnikuni xe'inaki'erietɨ neti'aitɨwame, metatsiere yaxeneteneutahɨawi xɨka katixaɨtɨni. Netari kenemɨyɨaneni».   
\p
\v 50 Hikɨ Rawani Wetuheri hamatɨa mɨpaɨ mekaniutiyuani:  
\p —Xɨari Yawé matsi mɨpaɨ paine, tame huu temaitɨkani tepɨkayɨwawe meta tixaɨ.  
\v 51 Mana puka Xeweka kenanuwitɨki mati'aitɨwame nu'aya 'ɨyaya kanayeimɨkɨ, heitseriemekɨ Yawé kemaine.   
\p
\v 52 Hikɨ kepauka 'Apɨrahami ti'uximayatsiriwame mɨpaɨ mɨtiutahɨawarie, kaniukatunumakeni kananakatutsire Yawé hɨxie.  
\v 53 Hikɨ katinewatipini hurukɨ mɨtiwewiyatɨka meta pɨratakɨ metatsiere 'ixurikite mɨraye'atɨka Xeweka katiniupitɨani. Yaxeikɨa matsikaya meta maamaya katiniwayetuirieni 'imikierite.  
\v 54 'Anari mɨkɨ meta mɨwarawitɨkɨkai mekateniukwani mekateniu'ieni, mana mekanikuheteitɨni wahetsɨa.  
\p 'Uxa'arieka ximeri kepauka memanuku'ui, 'Apɨrahami ti'uximayatsiriwame mɨpaɨ kaniutayɨni:  
\p —Nekanakunuamɨkɨtsɨari neti'aitɨwame hetsɨa.   
\p
\v 55 Peru Xeweka matsikaya meta maamaya mɨpaɨ mekaniutiyuani:  
\p —Tamamata tukari 'akuxi ke'ukunuani Xeweka, 'anake tsepa metɨa.   
\p
\v 56 Ti'uximayatame mɨpaɨ kaniutayɨni:  
\p —Neuxeitsɨ xepɨkanetsi'ukununuitɨwani, 'aixɨa 'anemekɨ nemakunuanikɨ Yawé yapɨtiuyuri, 'ayumieme xekeneneupitɨa nemɨyemiekɨ neti'aitɨwame kie.   
\p
\v 57 Hikɨ mɨkɨ mɨpaɨ mekaniutiyuani:  
\p —Xeweka tepɨta'iwawiya ketayɨni.   
\p
\v 58 Mɨkɨ me'ita'inieka mɨpaɨ mekatenita'iwawiya:  
\p —¿Petiyemie 'ikɨ 'utɨa?  
\p Xeweka mɨpaɨ katiniwaruta'eiya:  
\p —Huu.   
\p
\v 59 Hikɨ mekanipitɨani Xeweka mɨyemiekɨ, meta 'ukaratsi yamɨti'ɨwiyakai mitaweriyaxɨ 'Apɨrahami ti'uximayatsiriwame 'utɨa meta memeweiyakai.  
\v 60 Hikɨ Kakaɨyari mekaniutawawirieni Xeweka hetsiemieme 'aixɨa miyurienikɨ mɨpaɨ me'utiyuatɨ:  
\q1 «Ta'iwa, tame mɨpaɨ tepɨteku'eriwa:  
\q2 Yuwaɨkawame wamaama peke'ayani.  
\q1 'Anuiwarima kemɨ'ane memɨwaraye'unie meketewaruta'aitɨani  
\q2 wakiekaritetsie».   
\p
\v 61 Hikɨ Xeweka meta memɨte'ita'uximayatsirieni me'anutiyaxeka kameyutsixi wahetsie mekanekɨne 'Apɨrahami ti'uximayatsiriwame 'utɨa. Mɨpaɨ Xeweka katinewitɨkieni, 'ana kanayeyani.   
\p
\v 62 Hikɨ 'Itsahaki kaninuakaitɨni haputsu matinieretsie «'Amuyeika Mɨnetsixeiya» mɨtitewatsie, 'anatsɨ Nekexi mɨrakutewatsie kaniuyeikakaitɨni.  
\v 63 Merikɨtsɨ taikai kanikuyani yeuta. Hikɨ yapauka kameyutsixi kaniwaruxeiya me'aye'axɨaximeme mematiteitsie.  
\v 64 Yaxeikɨata Xeweka 'Itsahaki kaniuxeiya, 'ixeiyaka kananakayani kameyutsie  
\v 65 ti'uximayatame mɨpaɨ katiniuta'iwawiya:  
\p —¿Kemɨ'ane pɨyɨane mana yeuta matimie tahepa?  
\p Ti'uximayatame mɨpaɨ kaniutayɨni:  
\p —Neti'aitɨwame kaniyɨaneni.  
\p Hikɨ Xeweka kaneuyuku'eima yɨhɨxie 'ixurikikɨ.   
\p
\v 66 Hikɨ ti'uximayatame 'Itsahaki naime katiniutaxatɨani kemɨrakunua.  
\v 67 Hikɨ 'Itsahaki Xeweka 'ixuriki kiiyarita kaneutawitɨni maamaya muyehupukaitsie Tsara, kanitiwitɨni waɨkawa 'inaki'erietɨ, 'ɨyaya kanayani. Mɨpaɨ 'Itsahaki yu'iyaritsie katiniuyɨnɨtɨani maamaya mumɨkaikɨri.   
\c 25  
\s1 'Apɨrahami kemɨtiumɨ  
\r (Tsut 25:1-4 – 1Kem 1:32-33)  
\p
\v 1 Merikɨtsɨ 'Apɨrahami tawarita 'ukaratsi kaniutiwitɨni Tsetura titewakame.  
\v 2 Mɨkɨ hamatɨa yuniwema kaniwarayexeiya: Tsimɨrani, Kutsani, Merani, Mariyani, 'Itsiwaki 'imatɨrieka Tsuhaki.   
\p
\v 3 Kutsani Tsawa paapaya kanayani meta Rerani.  
\p Rerani nuiwarimama mekanakɨne 'atsureutsixi, retutseutsixi, rehumeutsixi.   
\p
\v 4 Mariyani niwemama mekanakɨne, 'Epa, 'Epexi, Kanuki, 'Awiraha, 'imatɨrieka 'Eriraha. 'Ikɨ yunaitɨ Tsetura niwemama mekanihɨkɨtɨni.   
\p
\v 5 'Apɨrahami yuniwe 'Itsahaki naime katiniyetuirieni tita mɨrexeiyakai.  
\v 6 Meta 'Apɨrahami hipame yɨ'ɨitama waniwema tiwayetuirieka kaniwarenɨ'ani, mexi'akuxi 'a'uyeikakai, 'Itsahaki hamatɨa memɨkatitenikɨ, tau manatineika hepatsie kaniwarenɨ'ani.   
\p
\v 7 'Apɨrahami kaniutihuni xeitsienituyari heimana haika tewiyari heimana tamamata heimana 'auxɨwi (175) wiyari.  
\v 8 Mɨya paɨmexɨa 'utihuka 'Apɨrahami kaniumɨni waɨkawa 'ukiratsitɨtɨri, tutsimama memakuhe wahetsɨa kaneyani.  
\v 9 Niwemama 'Itsahaki meta 'Itsimaheri meyunaitɨ mekanika'awieta terɨta Makipera mɨrakutewatsie Mamɨre 'aurie, 'Epuruni kwieyatsie, Heti tewiyari Tsukaxi nu'aya.  
\v 10 'Apɨrahami minanekai pɨhɨkɨtɨkai hetitsixi muwarunanairiekai, muwa mekaneitateni 'ɨyaya Tsara hamatɨa.  
\v 11 Hikɨ 'Apɨrahami 'ukumawereku, Kakaɨyari 'Itsahaki 'aixɨa kaniuyurieni 'Apɨrahami nu'aya, putsu 'aurie kaniuyuhayewa «'Amuyeika Mɨnetsixeiya» mɨtitewa 'aurie.   
\s1 'Itsimaheri nuiwarimama  
\r (Tsut 25:12-16 – 1Kem 1:29-31)  
\p
\v 12 'Ikɨ mekanihɨkɨtɨni 'Itsimaheri nuiwarimama, 'Apɨrahami nu'aya Hakari hetsie meyexei, 'ekipitutanaka Tsara parewiwameya.  
\v 13 Mɨpaɨ mekatenitetewaka 'Itsimaheri niwemama: Newayuti, Tseraxi, 'Ariweheri, Miwitsani,  
\v 14 Mitsima, Rumaha, Matsa,  
\v 15 Haraxi, Temaha, Ketuxi, Napitsi meta Tserema.  
\v 16 'Ikɨ mepɨhɨkɨ 'Itsimaheri niwemama, tamamata heimana huta nuiwarite mepakɨ kememɨtetetewa yaxeikɨa, yuxexuitɨ kwie mehexeiyatɨ mepakɨ me'ukutetɨkaitɨ.   
\p
\v 17 'Itsimaheri xeitsienituyari heimana xeitewiyari heimana tamamata heimana 'atahuta (137) wiyari puyeikakai. Kaniumɨni tutsimama memakuhe wahetsɨa kaneyani.  
\v 18 Nuiwarimama Kawira mekaniuyuhayewa meta Tsuhuxi, 'Ekipitu 'aurie mekatenitekaitɨni, huye 'Atsiriya haneme manuyehanetsie, mana mekaniuyuhayewa yu'iwama mewaraye'unietɨ.   
\s1 Kakuwu meta 'Etsahu kememɨte'ununuiwaxɨ  
\p
\v 19 'Ikɨ 'Itsahaki kemuyɨ pɨ'ɨxatsiyari, 'Apɨrahami nu'aya.  
\v 20 'Itsahaki huta tewiyari wiyari kanexeiyakaitɨni kepauka Xeweka mutiwitɨ, Wetuheri niweya, Rawani taruya. Wetuheri Rawani hamatɨa 'arameu teɨteriyari mepɨhɨkɨtɨkai Parani-'Arami mepɨkiekataritɨkai.  
\v 21 Hikɨ Xeweka pɨkaniwewekai, 'ayumieme 'Itsahaki Yawé kaniutawawirieni hetsiena mieme, hikɨ Yawé kani'enieni nenewierieya, Xeweka kaniutihukata.  
\v 22 Peru hukayahetsie paitɨ meyetetɨ yuhutatɨ tɨɨri mekaniyukwitɨwekaitɨni, mɨkɨ 'ayumieme mɨpaɨ kaniutayɨni: «Xɨka mɨpaɨ netiuka'eniwamɨkɨ, ¿titayari 'anetiuyeikani?» Hikɨ Yawé kaniutahɨawe kanita'iwawiya.  
\v 23 Mɨkɨ mɨpaɨ katinita'eiya:  
\q1 «'Ahukatsie huta nuiwariyari mepɨyetei,  
\q2 huta nuiwariyari 'ahukatsie meyetetɨ mepayuye'unie.  
\q1 Xewitɨ tɨrɨkaɨyetɨ kanayeimɨkɨ xewitɨta hawaikɨ,  
\q2 'amɨyumate yutaru katinita'uximayatsiriemɨkɨ».   
\p
\v 24 Hikɨ Xeweka kepauka maye'atɨarie matiniwenitsie, yuhutame kaniwarayexeiya tɨɨri.  
\v 25 Matɨari mutinuiwaxɨ kɨpateya kanitataɨrawikaitɨni, naitɨ hauhuxatɨ. 'Etsahu mekateniterɨwa.  
\v 26 'Utɨmanata mutinuiwaxɨ yu'iwa 'Etsahu keputsayatsie 'awietɨ kaniutinuiwa. Mɨkɨ Kakuwu mekateniterɨwa. Kepauka mɨkɨ tɨɨri yuhutatɨ memutinunuiwaxɨ 'Itsahaki haika tewiyari wiyari kanexeiyakaitɨni.   
\p
\v 27 Tɨɨri mekaniutiwawere. 'Etsahu yeuta kaninakekaitɨni, yeutari kwinimieme tiwareutakwiwetɨ kanayani. Kakuwu meta kayuwatɨ muyeika kanayani, yukie mukani kaninakekaitɨni.  
\v 28 'Itsahaki matsi waɨkawa 'Etsahu kaninaki'eriekaitɨni, minakekaikɨ xɨ'erikaya mɨtikwaka, Xeweka matsi Kakuwu waɨkawa kaninaki'eriekaitɨni.   
\p
\v 29 Hikɨ Kakuwu pɨtiyuwewiriekai tikwanike, mana 'Etsahu kaninuani 'uxetɨ yeuta hanuyaka mɨpaɨ katinitahɨawe:   
\p
\v 30 —Netineumikwa mɨkɨ 'itsari mɨxetakɨ, kwinimieme nepɨti'uxe. ('Ayumieme 'Etsahu 'Erumi pɨtiuterɨwarie).\f + \fr 25:30 \ft \fq 'Erumi\ft  hepɨrayukɨ panuyɨne \fqa mɨxeta.\f*   
\p
\v 31 Kakuwu mɨpaɨ katinita'eiya:  
\p —Keneneutuiriekameri heitserie kepemɨrexeiya 'ekɨ meri pemɨmiemekɨ.   
\p
\v 32 'Etsahu mɨpaɨ kaniutayɨni:  
\p —Haakakɨ nepɨmɨxime, tixaɨtɨkɨ pɨkatiyunaki'erie heitserie kenemɨrexeiya nemexɨakametɨtɨ.   
\p
\v 33 Kakuwu matsi tawarita mɨpaɨ katinitahɨawe:  
\p —Kamɨtsɨ keneneutuiri heitserie kepemɨrexeiya yanetineutahɨawi 'aheyemekɨ.  
\p 'Etsahu yurikɨ yakaniutayɨni, mɨkɨ mɨpaɨ katiniyetuirieni heitserie kemɨrexeiyakai mexɨakametɨtɨ.  
\v 34 Kakuwu 'Etsahu katiniumini mume 'etsimɨpepe 'itsariyarikɨ meta paa kanimini.  
\p Hikɨ tiukwaka 'anutihareka kaneyani. Mɨpaɨ tiuyurieka tixaɨtɨ katiyunaki'erikame payeitɨa heitserie kemɨrexeiyakai mexɨakametɨtɨ.   
\c 26  
\s1 'Itsahaki meta 'Awimereki  
\p
\v 1 Mɨkɨ tukaritsie waɨkawa haakaxa kanayani mɨkɨ kwieyaritsie, meripaitɨ 'Apɨrahami muyeikakaitsie hepaɨ. 'Ayumieme 'Itsahaki kaneyani Keraxi, 'Awimereki manuyeikakai piritsiteutsixi tiwa'aitɨwame.  
\v 2 Mana Yawé kaniyuhekɨata mɨpaɨ katinitahɨawe: «Pepɨkaheyeikani 'Ekipitu. Mɨkɨ kwieyaritsie keneuyuhayewa kemɨ'ane nemɨmatsi'uxeitsitɨatsie.  
\v 3 Mana keneuyeikani yatewimekɨ. Ne'ahamatɨa nepuyeikani, 'aixɨa nepɨmatsiyurieka, karikɨ matsi 'ekɨ meta 'anuiwarima nepɨxeyetuirieni 'ikɨ naime kwie. Mɨpaɨ yurikɨ nepɨreye'atɨani 'apaapa 'Apɨrahami kenemɨrahɨawekai.  
\v 4 Nepɨwatimɨiriya 'anuiwarima xurawetsixi wahepaɨ, 'ikɨ naime kwie nepɨxeyetuirieni, 'anuiwarima wahekɨ yunaitɨ nuiwarite kwiepa memɨtama 'aixɨa mepɨ'itɨarieka.  
\v 5 'Apɨrahami mɨnetsi'anu'enikɨ naime kenemɨti'aitɨakai, 'inɨari niukiyarikɨ, kenemɨrehɨawekai meta kenemɨti'ɨkitɨakai».   
\p
\v 6 Hikɨ 'Itsahaki Keraxi kaniuyuhayewa.  
\v 7 Kepauka teɨteri mana kiekatari memiku'iwawiyakai 'ɨyaya hepaɨtsita, mɨkɨ kename 'iwaya kaniutainekaitɨni, Xeweka kwinimieme witsikatini'ɨimarikaitɨni, 'Itsahaki kaneumakaitɨni heitserie mɨtiwataxatɨanikɨ, mɨpaɨ pɨtiku'eriwakai me'imienike 'ɨyayakɨ pɨ'eriekai.   
\p
\v 8 Mɨixa tukari 'anukayakuke, 'Awimereki piritsiteutsixi tiwa'aitɨwame yukiita paitɨ 'ayekaitɨ kanitanierekaitɨni kiekaritsie, hikɨ 'Itsahaki kaniuxeiya yɨ'ɨya Xeweka 'ikamaɨwame.  
\v 9 Hikɨ 'Awimereki 'Isahaki hekɨ katiniutanɨ'ani, mɨpaɨ katinitahɨawe:  
\p —¿Kamɨtsɨ mɨkɨ ti'a'ɨya? ¿Titayari kename 'a'iwa petiutayɨ?  
\p 'Itsahaki mɨpaɨ kaniutayɨni:  
\p —Ne nepɨxemakakai, xe'iwitɨkutɨ xenetsimienike nepɨ'eriekai.   
\p
\v 10 Peru 'Awimereki mɨpaɨ katinitahɨawe:  
\p —Mɨpaɨ pepɨkatatsiyurieneni 'ekɨ tame, tawarita xeitɨkari xɨka 'anukayanike, xewitɨ hamatɨana xɨka 'ukahunike, hikɨ 'ekɨ teyunaime 'axapepɨtatsiyurienikekai.   
\p
\v 11 Hikɨ 'Awimereki yunaime yuteɨterima mɨpaɨ katiniwarutahɨawe:  
\p —Kemɨ'ane 'ikɨ tewi 'axamɨmatɨaka yatɨni 'ɨyaya, kanimieriemɨkɨ.   
\p
\v 12 Mɨkɨ wiyaritsie 'Itsahaki kaniuka'eni mɨkɨ kwieyaritsie, 'aixɨa katiniuxuawere Yawé miparewiekaikɨ.  
\v 13 Mɨpaɨ titsutɨaka 'Itsahaki waɨkawa rexeiyatɨ kanayani.  
\v 14 Muxatsi waɨkawa pɨwarexeiyakai, wakaitsixi, meta teɨteri mɨtiwa'aitɨakai, piritsiteutsixi waɨkawa piiniteyakɨ mekaniniukimakaitɨni.  
\v 15 Kepauka 'Itsahaki paapaya mayeyurikaitsie 'Apɨrahami, mɨkɨ teɨterimama putsu meputiwewiekai, peru 'ariketa piritsiteutsixi mepenuteukixɨa.  
\v 16 Hikɨ 'Awimereki 'Itsahaki mɨpaɨ katiniutahɨawe:  
\p —Hikɨri 'ekɨ matsi waɨkawa pepɨrexeiya, pepɨtatsi'a'iwari, 'ayumieme keneumieni 'enari pepɨka'ukani.   
\p
\v 17 Hikɨ 'Itsahaki kaneyani mayeweritsie Keraxi mɨrayetewatsie, mana kaniuyuhayewa.  
\v 18 Tawarita putsu kanewatiwiwiexɨani, paapaya 'Apɨrahami muyeikakaitsie mieme, piritsiteutsixi memeikanaxɨakai 'umɨkuri, 'Itsahaki yaxeikɨata katiniterɨwaxɨani paapaya kemɨtiterɨwaxɨakai.   
\p
\v 19 Hikɨ heiwa mieme 'Itsahaki hetsɨa te'uximayatamete putsu mekaniutawewieni mana mayeweritsie, hikɨ haixa mekaniutaxeiya.  
\v 20 Peru manata Keraxi kiekatari mana memɨtetihɨwekai mekaniwarutitieni 'Itsahaki teɨterimama muxatsi wahɨwemete, mɨkɨ mɨpaɨ me'utiyuatɨ kename mɨkɨ pɨta wahetsiemiemetɨkai. 'Ayumieme 'Itsahaki Mɨrayukwine katiniterɨwa mɨkɨ putsu, kɨmana meyukwitɨwekaikɨ.  
\v 21 Tawarita xaɨtsie 'Itsahaki teɨterimama putsu mekaniutawewieni, hutariekata mana mekaniuyutitieni, mɨkɨ putsu 'Itsahaki Temataye'unie katiniterɨwa.  
\v 22 'Itsahaki kaneyani 'aheteewakaku mana tawarita putsu kaniutawewieni, mɨkɨkɨ hɨrixɨa mepɨka'uyutikwi, 'ayumieme katiniterɨwa 'Amakuyewa, mɨpaɨ kaniutayɨni: «Hikɨ Yawé pɨtatsi'upitɨa 'ena temu'uwanikɨ».   
\p
\v 23 Mana mɨyetɨa Weritsewa kaneyani.  
\v 24 'Ana tɨkaritsie Yawé kaniuyuhekɨata mɨpaɨ katinitahɨawe:  
\q1 «Ne 'apaapa 'Apɨrahami Kakaɨyarieya nekanihɨkɨtɨni.  
\q1 Pepɨkamaka, ne 'ahamatɨa nepuyeika.  
\q1 'Apɨrahami 'aixɨa mɨtiuyurikɨ,  
\q1 'aixɨa nepɨmatsiyurieni nepɨwatimɨiriya 'anuiwarima».   
\p
\v 25 Hikɨ 'Itsahaki mawari taiyame kaniutawewieni, mana Yawé kaniutahɨawe. Mana kaniuyuhayewa, teɨterimamata mana putsu mekaniutawewieni.  
\v 26 Hikɨ 'Awimereki kaninuani Keraxi paitɨ 'ayeneka, 'Itsahaki hamatɨa titaxatake, 'Akutsati kaneweiyakaitɨni tixaxatɨwameya meta Pikuuri kuyaximama wa'ukiyari.  
\v 27 'Itsahaki mɨpaɨ katinita'iwawiya:  
\p —Xeme xepɨkanetsinaki'erie, xepɨnetsi'ayewei, ¿titayarita 'uxete'ahu?   
\p
\v 28 Mɨkɨ mɨpaɨ mekatenita'eiya:  
\p —Mɨpaɨ tepɨtehetima Yawé 'ahamatɨa puyeika, mɨpaɨ tepɨteku'eriwakaku tɨratu tepɨwewienikeyu. Yurikɨ tepɨtahɨritɨanikeyu. Mɨpaɨ tɨratu tepuyurienikeyu:  
\v 29 'Ekɨ 'atsipepɨkatatsiyurienekɨ, tameta 'axatepɨkamatsiyuriekɨ, matsi pɨta 'aixɨa 'anemekɨ tepɨmatsixeiya, 'aixɨa 'anemekɨ tematsihetateutɨa. Hikɨ 'ekɨ Yawé 'aixɨa kameniyurieka.   
\p
\v 30 Hikɨ 'Itsahaki 'ixɨarari kaniwaruwewirieni, mekateniukwani mɨkɨ mekateniu'ieni.  
\v 31 'Uxa'arieka ximeri me'anuku'uka yunaitɨ me'uyu'enieka tɨratu mekaniuwewieni, hikɨ 'Itsahaki kaniwarutateutɨani, mɨkɨta mekanitahɨawe hamikutsixi mekanakɨne.   
\p
\v 32 Mɨkɨ tukaritsie 'Itsahaki teɨterimama mekaniu'axɨani mɨpaɨ me'utiyuatɨ xeime putsu hepaɨtsita:  
\p —Haa tekanetaxeiya tewati'ineka.   
\p
\v 33 'Itsahaki kanitaterɨwa mɨkɨ haputsu, Tsewa katiniterɨwa, 'ayumieme hikɨ mana kiekari Weritsewa katinakutewaka.   
\s1 'Itsahaki Kakaɨyari kemɨtiutahɨawixi Kakuwu 'aixɨa muyurienikɨ  
\p
\v 34 Kepauka 'Etsahu huta tewiyari wiyari mexeiyakai Yuhuri titewakame kaniutiwitɨni, Weherí niweya Heti tewiyari. Tawarita xeime tiutiwitɨ Watsemati titewakame, 'Eruni Heti tewiyari niweya.  
\v 35 'Ikɨ 'ukari yuhutatɨ 'Itsahaki meta Xeweka waɨkawa mekaniwaru'uximatɨani, mete'uka'eniwatɨ 'amepu'uwakai hipatɨ memɨhɨkɨtɨkaikɨ.   
\c 27  
\p
\v 1 Merikɨtsɨ 'Itsahaki kepauka 'ukiratsi matɨa kahaunieretɨ kanayani. Hikɨ kepauka 'Etsahu katiniutanɨ'airieni yuniwe matɨari mieme, mɨpaɨ katinitahɨawe:  
\p —Neniwe.  
\p 'Etsahu mɨpaɨ katinita'eiya:  
\p —Tita perayexeiya nepaapa.   
\p
\v 2 'Itsahaki mɨpaɨ kaniutayɨni:  
\p ―Pepɨnetsixeiya nepu'ukiratsiri, kwitɨwa nepumɨwe.  
\v 3 Hikɨ yeuta kenemie 'atupi meta 'a'ɨrɨ perapitɨ tixaɨtɨ ketinemi'a mɨtikwaiwa.  
\v 4 Witsi'anekame kenenekawewiri mɨnetsinake hepaɨ, kenene'atɨiri nemikwanikɨ. Hikɨ 'ana Kakaɨyari nepɨtawawirieni 'aixɨa mɨmatsiyurienikɨ nekamɨwetɨkuxi.   
\p
\v 5 Hikɨ Xeweka kanita'enakaitɨni, 'Itsahaki yuniwe 'Etsahu kemɨtikɨhɨawekai, 'ayumieme 'amɨretɨa 'Etsahu yeuta reumiemieka yupaapa hetsiemieme,  
\v 6 Xeweka yuniwe Kakuwu mɨpaɨ katiniutahɨawe:  
\p —Neuxei, 'apaapa nepe'eni 'Etsahu matɨa pɨrekuxatakai, mɨpaɨ pɨreikɨhɨawekai:  
\v 7 ketinemiemie kenenekawewiri tsiha'anekame nemikwanikɨ. Mɨpaɨtsiere pɨrehɨawe kename 'aixɨa 'iyurieni Yawé hɨxie mexi kamɨwe.  
\v 8 Hikɨ keneneu'eni neniwe kenemɨmatitahɨawe, yaketinekaye'a.  
\v 9 Kenemie tsipuri memuyename keniwarahapani yuhutame 'etsimemɨpepe 'aixɨa memɨ'anene nepikawewirieni 'apaapa 'itsari tsiha'anekame minake.  
\v 10 'Ekɨ pepenu'ɨirieni meikwanikɨ mɨpaɨ mɨkɨ Kakaɨyari petawawirieni 'aixɨa mɨmatsiheyurienikɨ kamɨwetɨ 'akuxi.   
\p
\v 11 Perutsɨ Kakuwu yumaama mɨpaɨ katiniutahɨawe:  
\p —Neuxeitsɨ, peru nematsika 'Etsahu kwinimieme pɨreuhuxa neta hawaikɨ.  
\v 12 Xɨka nepaapa netsihemayɨani, pɨretimani kename neti'itaiyane, 'anari peitawawirieni 'axanemɨ'itɨariekakɨ, 'aixɨa nemɨ'itɨariekakɨ pɨkatixaɨ.   
\p
\v 13 Hikɨ maamaya mɨpaɨ katinitahɨawe:  
\p —Neuxei nepɨta nehetsie ketiunake mɨkɨ 'axamɨ'ane. 'Ekɨtɨ yaketineuyuri kenemɨmarahɨawe, kenemie kapuratsixi kenenehapaniriemie.   
\p
\v 14 Kakuwu tsipuri kaniwarekuhapani yumaama kani'atɨirieni, mɨkɨ 'itsari kanikawewirieni kemɨtinakekai 'Itsahaki.  
\v 15 Hikɨ Xeweka 'Etsahu kamixaya kaniwayehurieni 'aixɨa mɨ'ane mi'utakai yukiita, mɨkɨ Kakuwu kananakatɨtɨani.  
\v 16 Hikɨta kapuratsixi wanawiyarikɨ mamateya kaniuti'eima, meta kɨipitɨana hakewa mɨkaheuhuxakai,  
\v 17 hikɨ Xeweka Kakuwu yuniwe katiniyetuirieni 'itsari paa mame.   
\p
\v 18 Kakuwu yupaapa hetsɨa nuaka mɨpaɨ katinitahɨawe:  
\p —Nepaapa.  
\p 'Itsahaki mɨpaɨ katiniuta'iwauni:  
\p —¿Kemɨ'ane neniwe 'ekɨ peputaine?   
\p
\v 19 Kakuwu mɨpaɨ katinita'eiya:  
\p —Ne 'Etsahu neputaine, 'aniwe mexɨakame. 'Ari nepɨrekawewi kepemɨnerahɨawekai. Kenanukukeka ketineukwa'i tita nemɨremi, 'anari Kakaɨyari pepɨtawawirieni 'aixɨa mɨnetsiyurienikɨ.   
\p
\v 20 Hikɨ 'Itsahaki kanita'iwawiya:  
\p —¿Kwitɨwa kuta peremi, neniwe?  
\p Kakuwu mɨpaɨ katinita'eiya:  
\p —Yawé 'akakaɨyari pɨnetsiheparewi nemeitaxeiyakɨ kwitɨwa.   
\p
\v 21 Hutarieka 'Itsahaki mɨpaɨ katinitahɨawe:  
\p —'Ena 'aurawa kenayaka nemetsimayɨani mɨpaɨ nemɨretimanikɨ xɨka 'aku neniwe 'Etsahu peyɨaneni.   
\p
\v 22 Kakuwu 'aurawa kaniuyani paapaya 'imayɨaka mɨpaɨ kaniutayɨni:  
\p —Kakuwu hepaɨ pepɨtiuxaxata, peru mamate 'Etsahu pɨmamateya.   
\p
\v 23 Hikɨ paapaya pɨkaheitima, mamateya muhuxatɨkateikɨ 'Etsahu hepaɨ. Kepaukari Kakaɨyari mɨtawawirienikekai 'aixɨa miyurienikɨ,  
\v 24 tawarita kanita'iwawiya:  
\p —¿Yurikɨ 'aku neniwe 'Etsahu petiyɨane?  
\p Kakuwu mɨpaɨ katinita'eiya:  
\p —Yurikɨ ne nekaniyɨaneni.   
\p
\v 25 Hikɨ paapaya mɨpaɨ kaniutayɨni:  
\p —Netinatuiri neniwe nemɨtikwanikɨ tita pemɨremi, hikɨ Kakaɨyari nekanitawawiriemɨkɨ 'aixɨa mɨmatsiyurienikɨ.  
\p Kakuwu katinekatu'irieni paapaya mɨtikwanikɨ, meta kaxie winuyari kanikatu'irieni, 'Itsahaki katiniukwani meta kananu'ieni.  
\v 26 Hikɨ paapaya mɨpaɨ katinitahɨawe:  
\p —'Aurawa kenaye'a neniwe, keneneu'itsi.   
\p
\v 27 Kakuwu 'aurawa kaniuyani kani'itseni. Kepauka 'Itsahaki mi'ɨkwixɨ kamixaya, hikɨ Kakaɨyari kaniutawawirieni 'aixɨa miyurienikɨ, mɨpaɨ 'utaitɨ:  
\q1 «Huu, 'ikɨ neniwe 'ɨtsita timieme hepaɨ pɨ'ɨa  
\q2 Yawé 'aixɨa miyuriekaikɨ.   
\q1
\v 28 Kakaɨyari waɨkawa wiyeri kematsiheyenɨ'airiwani muyuawitsie mieme,  
\q2 waɨkawa pemɨtiukaxexeiyanikɨ 'ena kwiepa timieme  
\q2 tɨriku meta kaxie winuyari.   
\q1
\v 29 Waɨkawa teɨteri 'ahetsɨa mekete'uta'uximayata,  
\q2 nuiwarite 'ahɨxie meke'utitunuma'uni.  
\q1 'A'iwamatɨme peketiwaruta'aitɨani,  
\q2 'amaama niwemama 'ahɨxie meke'utitunuma'uni.  
\q1 Kemɨ'ane 'axamɨmatsiyurieni mɨkɨta 'axapɨ'itɨarieka,  
\q2 meta kemɨ'ane 'aixɨa mɨmatixeiyani mɨkɨta 'aixɨa pɨ'itɨarieka».   
\p
\v 30 Hikɨ 'Itsahaki yuniwe hetsiemieme Kakaɨyari 'utawawirieku, Kakuwu 'amɨtiwayetɨa 'Etsahu kaninuani rekumieka.  
\v 31 Mɨkɨta katiniukawewieni 'ikwaiya, yupaapa katine'ɨirieni, mɨpaɨ katinitahɨawe:  
\p —Nepaapa, kenanukukeka ketineukwa'i tita nemɨremi. Hikɨ Kakaɨyari keneutawawiri 'aixɨa mɨnetsiyurienikɨ.   
\p
\v 32 Hikɨ 'Itsahaki kanita'iwawiya.  
\p —¿Kemɨ'aneta 'ekɨ peputaine?  
\p 'Etsahu mɨpaɨ kaniutayɨni:  
\p —Ne 'Etsahu neputaine, 'aniwe 'anemɨyumate.   
\p
\v 33 'Itsahaki kaniutimani 'uyɨyɨakatɨ mɨpaɨ kaniutayɨni:  
\p —¿Kamɨtsɨ kemɨ'ane pɨyɨanekai xikepaitɨ mɨnerekumi 'itsari mɨnetsi'atɨiri? 'Ekɨ 'akuxi pekanuawekaku, ne nekanikwani naime. Meta Kakaɨyari nekaniutawawirieni hetsiena mieme 'aixɨa nekaniyurieni, mɨkɨri 'aixɨa 'itɨarietɨ kanayeimɨkɨ.   
\p
\v 34 Kepauka 'Etsahu mu'enaxɨ paapaya kemainekai karima kaniutatsuani yuhiwerietɨ, mɨpaɨ yupaapa katiniutahɨawe ha'atɨ:  
\p —Ne waɨkawa nepɨmatsiwawirie, nepaapa 'aku, Kakaɨyari keneutawawiri nehetsiemieme neta 'aixɨa mɨnetsiyurienikɨ.   
\p
\v 35 Peru 'Itsahaki mɨpaɨ katinitahɨawe:  
\p —'Amuta kaneukuyeixɨani kanetiniu'itaiya, mɨkɨri naime katinepiini tita mɨti'ahetsiemiemetɨkai.   
\p
\v 36 'Etsahu mɨpaɨ kaniutayɨni:  
\p —'Ayumieme xɨari Kakuwu xepɨte'iterɨwaxɨ, hikɨri hutarieka kaneniukwamana, matɨari meri kaneniunawairieni kenemɨtimexɨakame, hikɨta 'aixɨa kenemɨ'itɨarienikekai kaneniunawairieni. ¿Pekatiyɨwe Kakaɨyari pemɨtawawirieni 'aixɨa mɨnetsiyurienikɨta ne?   
\p
\v 37 'Itsahaki mɨpaɨ katinita'eiya:  
\p —Neuxei ne, Kakaɨyari neputawawiri Kakuwu hetsiemieme mɨmati'aitɨakakɨ, nepitawawiri tsiere maremama yunaitɨ memɨte'ita'uximayatsirienikɨ, tɨriku waɨkawa mukaxexeiyanikɨ meta kaxie winuyari. ¿Hikɨ tita netiutawauni 'ahetsiemieme pɨtiumaweri, neniwe 'aku?   
\p
\v 38 Peru 'Etsahu pɨkatihayewakai:  
\p —¿Xeimieme xeikɨa petiyɨwekai Kakaɨyari pemɨtawawirieni 'aixɨa xewitɨ xeikɨa mɨ'itɨarienikɨ? Keneutawawiri Kakaɨyari neta 'aixɨa mɨnetsiyurienikɨ.  
\p Mɨpaɨ 'utayɨka tawarita kaniutatsuani karima.  
\v 39 Hikɨ 'Itsahaki mɨpaɨ katinitahɨawe:  
\q1 «'Ekɨ kwiepa 'aixɨa mɨraku'anetsie pepɨka'uyeikani,  
\q2 wiyeri muyuawitsie makaneika makaxɨruwe pepɨka'uyeikani.   
\q1
\v 40 'A'ixiparakɨ pe'amienetɨ pepuyeikani,  
\q2 'amuta pepɨti'uximayatsirieka.  
\q1 Peru kepauka petɨrɨkaɨyetɨ pemayani,  
\q2 pepɨyuxɨna kemɨmati'aitɨa».   
\s1 Kakuwu kemɨtiuyuta'unaxɨ  
\p
\v 41 Mana mɨtiyetɨa, 'Etsahu Kakuwu kanihekakaitɨni paapaya Kakaɨyari mutawawirikɨ hetsiena mieme 'aixɨa miyuriekakɨ. 'Etsahu mɨpaɨ katiniku'eriwakaitɨni: «'Arikutari kwitɨwa pɨmɨni nepaapa mɨyuke, nemuta Kakuwu nepɨmieni».   
\p
\v 42 Hikɨ kepauka Xeweka mɨretima 'Etsahu kemɨtiku'eriwakai, Kakuwu kaniuta'inieni mɨpaɨ katinitahɨawe:  
\p —Neuxei, 'a'iwa 'Etsahu pɨmatsimiemɨkɨ pemɨtinawairikɨ.  
\v 43 'Ayumieme neniwe, keneneu'eni: Keneuyuta'una Karani paitɨ, ne'iwa kie Rawani,  
\v 44 mɨkɨ hetsɨa kenekani kepaukake 'amatsika mɨratɨmaiya ha'atɨ.  
\v 45 Ratɨmaiyayu kepemɨtiuyuri, 'anake niuki nepanunɨ'ani pemamiekɨ. Yanepɨkara'eriwa tietɨtsɨ xeitukaritsie yunaitɨ xemɨneuyukwixɨa.   
\p
\v 46 Hikɨ Xeweka 'Itsahaki mɨpaɨ katiniutahɨawe:  
\p —Neri nepɨkayɨwe 'anemuyeikani 'ikɨ hetitsixi wahamatɨa 'Etsahu 'ɨitamama mepɨnetsihiweritɨa. Xɨkata Kakuwu Heti tewiyari 'utiwitɨni 'ena kiekame Kanani matsi 'aixɨa pɨyɨnikeyu xɨka ne'umɨnike.   
\c 28  
\p
\v 1 Hikɨ 'Itsahaki Kakuwu katiniutanɨ'airieni. 'Aixɨa kaniyurieni, meta mɨpaɨ katinita'aitɨani:  
\p —'Uka 'ena Kanani kiekame pepɨka'utiwitɨkɨni.  
\v 2 Hikɨ kwitɨwa kenemie Parani-'Arami paitɨ, 'ateukari Wetuheri hetsɨa, xeime kenetiwitɨki 'atatatsi Rawani niweya.  
\v 3 Kakaɨyari Naimekɨmɨtɨrɨkaɨye 'aixɨa kematsiyurieka waɨkawa peke'utaxiɨni, 'ahetsie memɨyekɨnekɨ nuiwarite yuwaɨkawatɨ.  
\v 4 'Ekɨta kematsiyetuirieni meta 'anuiwarima 'Apɨrahami 'aixɨa kemuyuriekai, 'ikɨ xepiini mayanikɨ hikɨ temanu'uwa teewanarixi wahepaɨ, 'Apɨrahami kemɨtiutahɨawarie 'ikɨ kwie hepaɨtsita.   
\p
\v 5 Mɨpaɨ titahɨaweka kaneinɨ'ani yuniwe 'Itsahaki Parani-'Arami kwieyaritsie Rawani hetsɨa, 'Etsahu meta Kakuwu wamaama Xeweka matsikaya hetsɨa, Rawani matɨa Xeweka Wetuheri pɨwapaapatɨkai 'arameu tewiyari kanihɨkɨtɨkaitɨni.   
\p
\v 6 'Etsahu katinetimani kepauka 'Itsahaki Kakuwu 'aixɨa miyuriekai meta kename heinɨ'akai Parani-'Arami kwieyaritsie paitɨ mana metineɨkekɨ. Yaxeikɨata katinetimani kepauka paapaya 'aixɨa 'iyurieka, mɨpaɨ mɨtitahɨawixɨ kename 'uka mana Kanani kiekame katiwitɨkɨnikekai,  
\v 7 meta Kakuwu kepauka metɨa Parani-'Arami paapaya meta kememɨtehehɨawekai.  
\v 8 'Ana mɨpaɨ katinetimani 'Etsahu, kename paapaya 'ukarawetsixi Kanani kiekatari kawanaki'eriekai.  
\v 9 'Ayumieme tsepa mɨneɨkekai 'Etsahu kaneyani hakewa paitɨ tatatsieya mekatei 'Itsimaheri 'Apɨrahami nu'aya. Mana xeime kaniutiwitɨni nu'ayatɨme Makarati titewakame, Newayuti taruya kanihɨkɨtɨkaitɨni.   
\s1 Kakuwu Weteri kemɨtiuheinɨ  
\p
\v 10 Kakuwu kanayeyani Weritsewa, huye kananukuweiya Karani haneme.  
\v 11 Kepauka tau makayunixɨ 'umiekaku mana kaniukateitɨni, tete kaniutituni kanikamu'urita, hikɨ 'ukahuka kaneukuni.  
\v 12 Mana katiniuheinɨni, 'imɨmui 'ahatayeume kaniuxeiya kwiepa yuwetɨkaime muyuawitsie heutiyuneme, mɨkɨ 'ɨtɨma mekananutikɨkaitɨni niuki tuayamete Kakaɨyari hetsɨa miemete me'anutikɨkame me'anakakɨkame.  
\v 13 Metatsiere Yawé kaniuxeiya 'auriena 'uweme, mɨpaɨ tikɨhɨaweme: «Ne Yawé nepɨhɨkɨ 'ateukari Kakaɨyarieya 'Apɨrahami meta 'apaapa 'Itsahaki. 'Ekɨ yaxeikɨa 'anuiwarima 'ikɨ kwie nepɨxeyetuirieni mana hikɨ pemanukatsie.  
\v 14 Mɨkɨ yumɨiretɨ mepakɨne kwie tumuanariyari hepaɨ. 'Amepɨtayeure 'ayeta, 'atsutɨa, 'atserieta, 'a'utata meye'atɨkaitɨ meta yunaitɨ nuiwarite kwiepa memɨtama 'aixɨa mepɨ'itɨarieni 'ekɨ 'akɨmana meta 'anuiwarima».  
\v 15 Ne 'ahamatɨa nepuyeikani. Nepɨmatsi'ɨwiyani tsepa hakewa pemeyeika, meta nepɨmatsi'akunuitɨani 'ikɨ kwieyaritsie. Nepɨkamatsiku'eirieni neraye'atɨameke kenemutayɨkai».   
\p
\v 16 Kepauka Kakuwu manutanierixɨ mɨpaɨ katiniu'erieni: «Yurikɨ Yawé 'ena puyeika, ne 'atsinepɨkatimaikai».  
\v 17 Heumatɨri waɨkawa tawarita mɨpaɨ kaniutayɨni: «'Ena xɨari pakupatsie, 'ena xɨari pɨhɨkɨ Kakaɨyari kie, muyuawi kitenie pɨti'ane».   
\p
\v 18 'Uxa'arieka ximeripaitɨ kananukukeni Kakuwu, tete kaniutituni mimu'uritakai 'a'uweme kanayeitɨani huriwa hatseitiyarikɨ kanika'ɨya patsiekame kanayeitɨani.  
\v 19 'Ana mana kiekari kanikumakaitɨni 'Arimetɨra maku'u titewatɨ, peru Kakuwu kanipata Weteri pɨta katiniterɨwa.   
\p
\v 20 Hikɨ mana Kakuwu mɨpaɨ kaniutayɨni: «Xɨka Kakaɨyari nehamatɨa 'uyeikani netsi'ɨwiyani hakewa nemeutɨa, xɨka neremikwani meta nereketɨaka,  
\v 21 xɨka ne'akunuani 'aixɨa nereu'erietɨ nepaapa hetsɨa, hikɨ 'ana Yawé nekakaɨyari kanayeimɨkɨ.  
\v 22 'Ikɨta tete 'anemitake Kakaɨyari kiiya kanayeimɨkɨ, naime tita Kakaɨyari mɨnetimini, nekaniyetuiriemɨkɨ tamamata hetsiemieme xeime».   
\c 29  
\s1 Kakuwu kemɨreta'a Parani-Harami  
\p
\v 1 Merikɨtsɨ Kakuwu kaneyani, tau manatineika hepatsie kiekatari wakwieyaritsie kaniye'ani.  
\v 2 Hikɨ mana 'uta'aka yeuta haputsu kaniuxeiya, 'auriena haika tewayari muxatsi mekani'uxipitɨariekaitɨni mana memɨtiharewekaikɨ. Mɨkɨ haputsu tete 'ayeukamekɨ kananukanakaitɨni.  
\v 3 'Ayumieme yunaitɨ tehɨwemete meyukuxeɨriemeke mekaniyexɨrakaitɨni, hikɨ yunaime mewatiharitɨame, tawarita yunaitɨ mekanenukanarɨmakaitɨni haputsu.   
\p
\v 4 Hikɨ Kakuwu kaniwaruta'iwawiya tehɨwemete:  
\p —¿Hakewa xepekiekatari xeme?  
\p Mɨkɨ mɨpaɨ mekatenita'eiya:  
\p —Karani tepɨkiekatari.   
\p
\v 5 Tawarita Kakuwu kaniuta'iwauni:  
\p —¿Kamɨtsɨ xeme Rawani xetemate, Nakuxi nu'aya?  
\p —Huu tepimate —mekatenita'eiya.   
\p
\v 6 Tawarita mɨpaɨ Kakuwu katiniwaruta'iwawiya:  
\p —¿'Aixɨa kapɨreu'erietɨtɨ?  
\p Mɨkɨta mɨpaɨ mekatenita'eiya:  
\p —'Aixɨa pɨreu'erie. Kamɨmatsi niweya huma kanamieni Xakeri muxatsi wara'arietɨ.   
\p
\v 7 Hikɨta Kakuwu mɨpaɨ katiniwarutahɨawe:  
\p —Matsi 'akuxi puximeri, yakɨpupauka 'akuxi muxatsi xemɨwareunaxɨanikɨ wakuraruta, 'aixɨa pɨyɨni yumuxatsima xekeniwarutiharitɨaka xeketenewamiyu.   
\p
\v 8 Mɨkɨ mɨpaɨ mekatenita'eiya:  
\p —Hawaikɨ tepɨkayɨwawe mɨpaɨ temɨte'uyurieni taxaɨtame, teyukwewiemeke tanaitɨ tehɨwemete tepenuku'ɨwe tete. 'Anake tepɨyɨwawe tamuxatsima temɨwarutiharitɨani.   
\p
\v 9 Wahamatɨa tikuxatakaku 'akuxi, Xakeri kaninuani muxatsi wara'arietɨ yupaapa tewamama, mɨkɨ kaniwahɨwemetɨkaitɨni.  
\v 10 Hikɨ kepauka Kakuwu Xakeri muxei, yutatatsi Rawani niweya, mana 'uyaka haputsu kananutiyepieni, muxatsimama kaniwarutiharitɨani.  
\v 11 'Anata kwitɨwa Xakeri kaniu'itseni, meta kaniutatsuani,  
\v 12 mɨkɨ katinitaxatɨani kename me'iwamarixi Xeweka mɨnu'ayatɨkaikɨ. Hikɨ 'ayumieme Xakeri yapauka 'unautsarɨmetɨ kaneyani yupaapa hetsɨa reitaxatɨanike.   
\p
\v 13 Hikɨ Rawani yumatsu Kakuwu 'utamarieka kaneyani kaneikunake kanitatapa meta kani'itseni, yukie kanei'inieni. Hikɨ Kakuwu naime katinitaxatɨani naime kemɨreyɨ,  
\v 14 Rawani mɨpaɨ katinitahɨawe: «'Ekɨtsɨ yuheyemekɨ ta'iwa pekanihɨkɨtɨni».  
\s1 Kakuwu Reya meta Xakeri kemɨtiwarutiwitɨ  
\p Merikɨtsɨ Kakuwu xeimetseri kaniukateitɨni Rawani hetsɨa.  
\v 15 Mɨpaɨ katinitahɨawe:  
\p —Tsepanetɨ hurawa pemɨne'iwa yakɨxeikɨa pepɨkati'uximayaka nehetsɨa. Yakenetineutahɨawi kepaɨmeme pepeu'iwamɨkɨ.   
\p
\v 16 Rawani yuhutame kaniwarexeiyakaitɨni yuniwema 'ukari, kurieya Reya pɨtitewakai, taruyata Xakeri.  
\v 17 Reya hɨxiteya witsipɨ'anenekai, peru Xakeri witsipɨtiyuxexeiyakai naitɨ.  
\v 18 Hikɨ Kakuwu Xakeri mɨhiwe'eriekaikɨ yutatatsi mɨpaɨ katiniutahɨawe:  
\p —'Atahuta wiyari nepɨti'uximayaka 'ahetsɨa, 'aniwe yakɨ mɨyumate Xakeri nemɨtiwitɨnikɨ.   
\p
\v 19 Rawani mɨpaɨ katinita'eiya:  
\p —'Aixɨa kaniyɨmɨkɨ nemɨmatsiwitɨtɨanikɨ 'ekɨ, xeime nemɨka'imate nemɨkakuwitɨtɨwanikɨ. Nehetsɨa keneuyuhayewa.   
\p
\v 20 Hikɨ Kakuwu 'atahuta wiyari katini'uximayakaitɨni Xakeri mɨtiwitɨnikɨ, hikɨ 'apɨkareuterixɨ tsepa mɨixa tukari manuyetɨa waɨkawa minaki'eriekaikɨ.  
\v 21 Hikɨ Kakuwu mɨpaɨ Rawani katiniutahɨawe:  
\p —'Ari nepɨraye'atɨa kenemutayɨ. Keneneyetuiriri nemitiwitɨnikɨ.   
\p
\v 22 Rawani mana kiekatari yunaime kaniwaruta'inieni, 'ixɨarari mariweme kaniuwewieni.  
\v 23 Peru kepauka mukɨyɨrixɨ, kurieya pɨta Kakuwu kaniyetuirieni Reya mɨtitewakai, 'ana Kakuwu hamatɨana kaniukahuni.  
\v 24 Reya xeime ti'uximayatame pexeiyakai Tsiripa titewakame, 'ayumiemeta Rawani kanixatɨani miparewiekakɨ.   
\p
\v 25 Hikɨ 'uxa'arieka katinetimani Reya matɨa pɨta mukateikɨ, 'ayumieme Rawani mɨpaɨ katiniutahɨawe:  
\p —¿Titayari mɨyapenetiuyuri? ¿Netamɨ nekamatiuta'uximayatsiri Xakeri nemɨtiwitɨnikɨ? ¿Ketitayari penetiu'itai?   
\p
\v 26 Rawani mɨpaɨ katinita'eiya:  
\p —Tame tayeiyari mɨpaɨ pɨ'ane 'ikɨ kwieyaritsie, Kurieya meri pɨtiwikieni 'ariketa taruya.  
\v 27 'Ayumieme hikɨ kenaye'atɨa tsemana kemɨreuyewetse, tawarita 'uximayatsikakɨ 'atahuta wiyarikɨ tawarita xeime nepɨmatsiwitɨtɨani.   
\p
\v 28 Kakuwu mɨpaɨ katinikayani, kepauka tsemana maye'atɨa xeimetsie mieme kemɨreuyewetse, Rawani Xakeri kaniyetuirieni 'ɨyaya mayanikɨ.  
\v 29 Xakeri xeimeta ti'uximayatame kanexeiyakaitɨni Wiriha titewakame, Rawani kaniyetuirieni miparewiekakɨ.  
\v 30 Hikɨ Kakuwu kaniukahuni hamatɨana, waɨkawa matsi Xakeri kaninaki'eriekaitɨni Reya 'akuxi matsi 'etsiwa, tsepa 'akuxi 'atahuta wiyari tawarita Rawani mɨtiuta'uximayatsiri.   
\s1 Kakuwu niwemama  
\p
\v 31 Kepauka Yawé Reya muxei kanaki'eriwame, kanipitɨani tɨɨri mɨwarayexeiyakɨ, Xakeri 'akuxi pɨkaniwewekai.  
\v 32 Hikɨ Reya kaniutihukata, xeime 'ukitɨme kaniutiniweni Xuweni katiniterɨwa, mɨpaɨ 'utayɨka: «Yawé pɨnetsi'uxei kenemɨtinehiweriekai, hikɨrixɨa nekɨna pɨnetsinaki'erieka».  
\v 33 Hutarieka kaniutihukata xeimetsiere 'ukitɨme kanayexeiya, Tsimehuni katiniterɨwa, mɨpaɨ 'utayɨka: «Yawé pe'enaxɨ, kename nekanaki'eriwa, 'ayumieme xeimeta pɨnetsiheyenɨ'airi nunutsi 'ukitɨme».   
\p
\v 34 Hairiekata kaniutihukata xeime nunutsi 'ukitɨme kanayexeiya, Rewi katiniterɨwa, mɨpaɨ 'utayɨka: «Hikɨrixɨari nekɨna netsinaki'erietɨ payani, yuhaikameri tɨɨri hetsiena mieme nemɨwarayexeikɨ».   
\p
\v 35 Nauriekata kaniutihukata Reya, xeime 'ukitɨme kaniutiniweni, Kura katiniterɨwa, mɨpaɨ 'utayɨka: «Hikɨ Yawé nekanitanɨawamɨkɨ». Mɨpaɨ tiuniweka tawarita pɨka'utiniwexɨ.   
\c 30  
\p
\v 1 Kepauka Xakeri tɨɨri mɨkawarayexeiyawekai Kakuwu hetsiemieme, yukuri kani'uxiwe'erikaitɨni, hikɨ Kakuwu mɨpaɨ katiniutahɨawe:  
\p —Neta keneneupitɨa tɨɨri nemɨwaraxeiyakɨ, xɨka pekanetsi'upitɨani, nepɨmɨni.   
\p
\v 2 Hikɨ Kakuwu kaniuyeha'ani waɨkawa, mɨpaɨ katinitahɨawe:  
\p —¿Ne Kakaɨyari peneti'erie? Mɨkɨ kanihɨkɨtɨni pekaniweweme mɨmatsi'ayeitɨa.   
\p
\v 3 Xakeri mɨpaɨ katinitahɨawe:  
\p —Mana puka neti'uximayaitsiriwame Wiriha, hamatɨana keneukahu'i. Kepauka meyexeiya netunutetɨa pihɨani, neta 'ana nepɨwarexeiyani tɨɨri mɨkɨ tiyurieyu.   
\p
\v 4 Hikɨ Xakeri Kakuwu kaniyetuirieni tiyu'uximayatsiriwame Wiriha 'ɨyaya mayanikɨ, Kakuwu hamatɨana kaniukahuni.  
\v 5 'Ana Wiriha kaniutihukata, xeime nunutsi mekanayexeiya Kakuwu matɨa.  
\v 6 Xakeri mɨpaɨ kaniutayɨni: «Kakaɨyari nehetsiemieme 'aixɨa katiniuyurieni. Kenemɨtiyuhiweriekai kaneniu'enieni, xeime nunutsi kaneneyenɨ'airieni». 'Ayumieme Xakeri Rani katiniterɨwa.   
\p
\v 7 Tawarita Wiriha Xakeri parewiwameya, hutarieka kaniutihukata mekaneyexeiya xeime tawarita nunutsi 'ukitɨme Kakuwu matɨa.  
\v 8 Xakeri mɨpaɨ kaniutayɨni: «Mariwemekɨ nepɨnemiene nekuri hamatɨa, hikɨ peru nepɨrayu'iwa». 'Ayumieme Xakeri Nepɨtahari katiniterɨwa.   
\p
\v 9 Reya timaitɨri tawarita mɨkatiniwekekaikɨ, tiyu'uximayatsiriwame Tsiripa Kakuwu kaniyetuirieni 'ɨyaya mayanikɨ,  
\v 10 mɨkɨta xeime mekanayexeiya nunutsi Kakuwu matɨa.  
\v 11 Hikɨ Reya mɨpaɨ kaniutayɨni: «Nehetsie pɨreuyɨwe». 'Ayumieme Kahari pɨtiterɨwaxɨ.   
\p
\v 12 Hutarieka Tsiripa, Reya ti'uximayatameya, Kakuwu matɨa xeime nunutsi 'ukitɨme mekanayexeiya.  
\v 13 Reya mɨpaɨ kaniutayɨni: «Waɨkawa nepɨnetemawie. 'Ukarawetsixi mɨpaɨ mepɨnetekɨhɨaweni pepɨ'atemawie». 'Ayumieme mɨkɨ 'Atsexi katiniterɨwa.   
\p
\v 14 Merikɨtsɨ tɨriku mati'itsanarɨwa tukariyaritsie, Xuweni kaneyani mɨrati'uximayatsiwatsie, mana 'ikwaxi kanetaxeiya manirakura, yumaama Reya kanetɨkirieni. Hikɨ Xakeri mɨpaɨ Reya katiniutahɨawe:\f + \fr 30:14 \ft \fq manirakura\ft . Tupiriya 'ɨtsita mieme mɨniwewenikɨ 'uayeyari mepɨ'eriekai 'ana, yeriyari tewi hepaɨ pɨ'anekai, 'ikwaxiyari witsipu'ɨatɨkatei.\f*  
\p —Neuxei, mɨkɨ manirakura keneneumikwa 'etsiwa 'aniwe mɨmatsi'atɨiri.   
\p
\v 15 Peru Reya mɨpaɨ katinita'eiya:  
\p —'A'iyari 'aixɨa kati'ane nekɨna pemɨnetsi'unawairi, 'akuxita hikɨ manirakura penetinawairiemɨkɨ neniwe mi'atɨa.  
\p Mɨpaɨ katinita'eiya Xakeri:  
\p —Xɨka penetsi'umini manirakura 'aniwe mi'atɨa hikɨ tɨkarikɨ Kakuwu 'ahamatɨa pɨkahuni.   
\p
\v 16 Hikɨ kepauka Kakuwu munua taikai, Reya kaneikunake mɨpaɨ katinitahɨawe:  
\p —Hikɨ tɨkarikɨ nehamatɨa pekanikahuimɨkɨ, ne 'akɨmana nekatiniupata 'ikwaxi manirakurakɨ neniwe mi'atɨa.  
\p 'Ana tɨkarikɨ kaniukahuni Kakuwu Reya matɨa.   
\p
\v 17 Kakaɨyari Reya kaniu'enieni, mɨkɨ kaniutihukata 'auxɨwirieka nunutsi 'ukitɨme Kakuwu matɨa mekaneyexeiya.  
\v 18 Reya mɨpaɨ kaniutayɨni: «Kakaɨyari kanetiniupitɨani ti'uximayatame nekɨna nemuwitɨtɨakɨ». 'Ayumieme 'Itsakaxi katiniterɨwa.   
\p
\v 19 Tawarita Reya kaniutihukata, 'ataxewirieka nunutsi 'ukitɨme mekanayexeiya Kakuwu matɨa.  
\v 20 Reya mɨpaɨ kaniutayɨni: «Kakaɨyari 'aixɨa pɨnetsi'uyuri 'aixɨa ti'aneme pɨnetiumi, hikɨri nekɨna 'aixɨa pɨnetixeiyani, 'ataxewirieka nunutsi temayexeikɨ». 'Ayumieme Tsawuruni pɨtiterɨwaxɨ.   
\p
\v 21 'Imatɨrieka Reya xeime 'ukatɨme kanayexeiya Rina katiniterɨwa.  
\v 22 Meta Kakaɨyari Xakeri kanaye'erieni, nenewierieya kaniu'enieni kanipitɨani mɨtiniwenikɨ.  
\v 23 Hikɨ mɨkɨ kaniutihukata xeime 'ukitɨme kanayexeiya. Mɨpaɨ kaniutayɨni: «'Axanemɨkaramamatiwanikɨ pɨneranuyeitɨiri Kakaɨyari».  
\v 24 'Ayumieme Kutse pɨtiterɨwaxɨ, mɨpaɨ 'utayɨka: «Xɨka tɨma tiyɨwenike Yawé netsi'upitɨanike xeime tawarita nemɨtiniwenikɨ».   
\s1 Kakuwu rexeiyatɨ kemɨratɨa  
\p
\v 25 Hikɨ 'ari Xakeri Kutse 'ayexeiyaku, Kakuwu Rawani mɨpaɨ katiniutahɨawe:  
\p —Keneneupitɨa nemɨyemiekɨ nekiepaitɨ.  
\v 26 Keneneyetuiriri ne'ɨitama kɨmana nemɨmatiuta'uximayatsiri meta neniwema, keneneupitɨa nemɨyemiekɨ. 'Ekɨ pepɨtimate kenemɨti'uximayakai 'ahetsiemieme.   
\p
\v 27 Rawani mɨpaɨ katinita'eiya:  
\p —Neuxeitsɨ, pepɨkaheyeikani. Ne mɨpaɨ nepɨretima Yawé 'aixɨa pɨnetsiyurie, 'ekɨ penetsiparewiekaku.   
\p
\v 28 Mɨpaɨtatsiere katinitahɨawe:  
\p —'Ekɨ yakeneutayɨki kepaɨmeme pemeu'iwamɨkɨ, ne mɨpaɨ nepɨmatipitɨani.   
\p
\v 29 Kakuwu mɨpaɨ katinita'eiya:  
\p —'Ekɨ pepɨtimate kehepaɨ nemɨti'uximayakai, neyuhɨtɨatɨ kenemɨtiwa'ɨwiyakai 'atewama.  
\v 30 Kepauka nekanuawekaku pemɨrexeiyakai pɨkatimɨirekai, hikɨri waɨkawa mepɨte'utamɨirixɨ, ne netiyurienekaku Yawé 'aixɨa pɨmatsiyurie. Hikɨri ne xaɨtsie nepɨtita'uximayata netɨɨriyama wahetsiemieme.   
\p
\v 31 Rawani mɨpaɨ katinita'iwawiya:  
\p —¿Kepaɨmeme pepau'iwamɨkɨ?  
\p Kakuwu mɨpaɨ katinita'eiya:  
\p —Pepɨkanetikupitɨwani. Xɨka 'ekɨ yapetiutanaki'erieni kenemɨmatitahɨawe, nekaniwa'ɨwiyakamɨkɨ 'amuxatsima.  
\v 32 Hikɨ ne kepauka yunaime 'amuxatsima memuyenatɨkatsie nemuyeyani, 'ekɨ pepɨwaranuyeteɨxɨ memeuyɨyɨwi, memeukutuxa, meta tsipuri memeukɨyɨyɨwi memeukutuxa. Mɨkɨ nemɨwa'iwani mekanihɨkɨtɨkakuni.  
\v 33 Hikɨ kepauka 'uxa'a pemɨnierimie keyupaɨmeme nemɨwara'iwaxɨri ke'aixɨa nemɨtiuka'iyari pekatinetimaimɨkɨ: Xɨka xeime pehetaxeiya muxa yatɨni tsipu kaheukɨyɨyɨwime kaheukutuxame meta muxa kaheuyɨwime tatsɨari ne nematsi'unawatsirieku.   
\p
\v 34 Rawani mɨpaɨ kaniutayɨni:  
\p —'Aixɨa pɨyɨni, yanepɨra'eriwa kepemaine.   
\p
\v 35 Hikɨ kwitɨwa mɨkɨ tukaritsie kaniwaranuyeteɨxɨ tsipuri 'ukitsi 'ukari, memeukuyɨyɨwi, memeuririnawi, yunaime kemɨ'ane 'etsiwa memeukutuxa, metatsiere yunaime muxatsi memeuyɨyɨwi, mɨkɨ yunaime kaniwaruhɨritɨani yuniwema.  
\v 36 'Ana Rawani kaneyani haika tukari heteewakaku Kakuwu manukateitsie yeyaka. Peru Kakuwu yaxeikɨa kaniwa'ɨwiyakaitɨni memuyuhayewaxɨ Rawani tewamama.   
\p
\v 37 Kakuwu meta haramu kaniutiwiteni yuyurime meta 'arimerituru metatsiere karu kɨyeyari, mɨkɨ kanikaxixiexɨani 'ukatuxatɨ kanayani.  
\v 38 Mɨkɨ kɨyexi mɨxixiyatɨka kaniuka'uitɨani muxatsi wahareweme matinenieretsie 'auriena memɨtiharewenikɨ. Kepauka muxatsi 'ukari meyuweiyanɨatɨ mematiharewetsie mekani'axekaitɨni,  
\v 39 'ukitsi mekaniwarutiweweiyakaitɨni 'ukari mana kɨyexi mɨxixiyatɨka hɨxie, mɨpaɨ 'ana mekaniwarayexexeiyakaitɨni meheuririnawime, meheukutuxame, meheukuyɨyɨwime.  
\v 40 Hikɨ Kakuwu xaɨtsie kaniwakupatakaitɨni memeuririnawi wahetsɨa, memeuyɨyɨwi Rawani muxatsimama wahetsɨa. Mɨpaɨ tiuyurieka yutewama warexeiyatɨ kanayani Rawani tewamama wahepaɨ meka'aneneme.  
\v 41 Matsi kepauka muxatsi 'ukari memɨ'axekai 'amemɨpapa, Kakuwu kanika'uitɨwakaitɨni kɨyexi, hɨxiena memuyutiweiyakɨ.  
\v 42 Peru kepauka memɨ'axekai memɨwawaki, 'ana pɨka'ika'uitɨwakai kɨyexi. Mɨkɨ memɨwawaki Rawani hetsɨa miemete mepɨhɨkɨtɨkai, memɨwaiyatɨkata Kakuwu hetsɨa miemete.  
\v 43 Mɨpaɨ 'ana Kakuwu waɨkawa rexeiyatɨ kanayani, yuwaɨkawame muxatsi, te'uximayatamete 'ukitsi 'ukari, puxuri meta kameyutsixi.   
\c 31  
\s1 Kakuwu kemɨtiyuta'unaxɨ Rawani hetsɨa  
\p
\v 1 Hikɨ Kakuwu mɨpaɨ katiniuyumarieni kename Rawani niwemama mɨpaɨ me'utiyuanekai: «Kakuwu naime katinepiini tapaapa tewamama, piiniteyakɨ waɨkawa rexeiyatɨ kanayuyeitɨani».  
\v 2 Yaxeikɨata Kakuwu katinetimani Rawani 'aixɨari mɨkatixeiyakaikɨ meripaitɨ kemɨkatixeiyakai.  
\v 3 Hikɨ Yawé Kakuwu mɨpaɨ katiniutahɨawe: «Kenakunua 'apaapa kwieyatsie, hakewa 'a'iwama meme'uwa, ne 'ahamatɨa nepuyeikani».   
\p
\v 4 Hikɨ Kakuwu katiniutanɨ'ani yu'ɨitama Xakeri meta Reya wahekɨ, muxatsi mɨwarahɨnetsie paitɨ,  
\v 5 mɨpaɨ katiniwarutahɨawe:  
\p —Mɨpaɨ nepɨtimate xepaapa 'aixɨa pɨkanetixeiyari meripaitɨ hepaɨ. Peru tsepa, nepaapa Kakaɨyarieya pɨnetsiparewie.  
\v 6 Xeme xekatenimaika kenemɨtiuta'uximayataxɨ xepaapa Rawani hetsiemieme neyutatuatɨ yuheyemekɨ.  
\v 7 Peru mɨkɨ matsi mɨixa pɨnetsi'ukwamanaxɨ, waɨkawa 'ikupatatɨ ne'iwarika. Peru Kakaɨyari pɨka'ipitɨa 'axamɨnetsiyurienikɨ.  
\v 8 Kepauka mɨpaɨ mɨnetikɨhɨawekai: «Yunaitɨ tewaxi memeupipitu 'a'iwarika mepakɨne», 'ana 'ukari yunaitɨ mepɨwatiniweyakai meheupipitume xeikɨa. Kepaukata mɨpaɨ mɨnetikɨhɨawekai: «Yunaitɨ tewaxi memeuririnawi 'a'iwarika mepakɨne», 'ana 'ukari yunaitɨ mepɨwatiniweyakai meheuririnawime xeikɨa.  
\v 9 Mɨpaɨ Kakaɨyari xepaapa tewamamata katiniunawairieni, nepɨta kanetiniupitɨani.   
\p
\v 10 »Merikɨtsɨ kepauka tewaxi mematiniweiyatsie 'ana mɨpaɨ nekatiniuheinɨni. 'Ukitsi mekaniwaweiyatɨwekaitɨni 'ukari, memeuririnawi meta memeupipitu.  
\v 11 Mɨkɨ heinɨtsikatsie meta niuki tuayame Kakaɨyari hetsɨa mieme, mɨpaɨ kanetiniutahɨawe: “Kakuwu”. 'Ana mɨpaɨ nekatinita'eiya: “'Ena nepuyeika”.  
\v 12 Hikɨ mɨkɨ mɨpaɨ kanetiniutahɨawe: “Paratsɨ keneuyɨ'ɨwiya, tuurutsixi 'ukari memɨwaweiyatɨwe mekaneuririnawini meta mekaneupipitɨni. Ne nepɨtimate kemɨmatsi'uyuri Rawani.  
\v 13 Ne Kakaɨyari nekanihɨkɨtɨni Weteri nemunehekɨataxɨ, hakewa mawari pemewewi nehetsiemieme tetetsie, meta kepemainekai nehɨxie. 'Ayumieme kenanukukexi 'ikɨ kwieyaritsie, kenemie kemɨ'ane kwieyaritsie pemetinuiwaxɨ”».   
\p
\v 14 Xakeri Reya matɨa mɨpaɨ mekatenita'eiya:  
\p —Tixaɨtɨri tame pɨkatatikupinierie tapaapa tahetsie timieme.  
\v 15 Matsi mɨkatatsimateni hepaɨ pɨtatixeiya. Pɨtatsi'utua, mɨkɨ naimeri pɨtiutixɨtɨa tita mɨrakapitɨarie tahetsiemieme.  
\v 16 Kaniyuritɨni Kakaɨyari naime mɨtinawairi tapaapa mɨrexeiyakai tahetsiemieme katinihɨkɨtɨni meta tatɨɨriyama wahetsiemieme. 'Ayumieme yaketineuyuri Kakaɨyari kemɨmarahɨawe.   
\p
\v 17 Hikɨ Kakuwu kaniyukuha'aritɨani, yuniwema yu'ɨitama kaniwaranutiyatsa kameyutsixi wahetsie.  
\v 18 Yunaime tiwara'arietɨ yutewama Parani-'Arami mɨtiukaxeiyakai, mekanekɨne Kanani me'erietɨ, 'ukiyarieya 'Itsahaki manukateitsie.   
\p
\v 19 Mexi Rawani yumuxatsima warexinekai, Xakeri yapauka heyaka kaniwarunawani kakaɨyariximama.  
\v 20 Mɨpaɨ katinikwamana Kakuwu Rawani 'arameu tewiyari, kaniuyuta'una 'atsikatitahɨaweka.  
\v 21 Kakuwu kaneyani yunaime tiwara'arietɨ tita mɨrexeiyakai. 'Epɨrata hatuxameyaritsie 'uyeyaka, muhɨriyatsie Karaha kanitiyune.   
\s1 Rawani Kakuwu kemɨranukuweiyaxɨ  
\p
\v 22 Hairieka tukari 'anukayaku Rawani katiniutaxatɨarieni, kename Kakuwu 'uyuta'unakai.  
\v 23 Hikɨ Rawani kaniwarukuxeɨrieni yu'iwamarixi, mɨkɨ mekaniwaranukuweiya 'atahuta tukari mekaniuhukaitɨni, mekaniwaranuku'axeke Karaha hɨriyaritsie paitɨ.  
\v 24 Perutsɨ mɨkɨ tɨkaritsie Kakaɨyari Rawani 'arameu tewiyari katiniutaxatɨani kutsukaku mɨpaɨ katinitahɨawe: «'Amarima 'aixɨa Kakuwu pepɨka'utate'ani».   
\p
\v 25 Rawani Kakuwu kaniwaranuku'axe Karaha hɨriyaritsie mɨkɨ mana me'uxipiekaku. Metatsiere Rawani mana kaniyuhayewa yu'iwama warawitɨtɨ.  
\v 26 Mɨpaɨ Kakuwu katiniutahɨawe:  
\p —¿Kepetiuyuri 'aku? Pekanetiniu'itaiya, neniwema pekaniwareyewitɨni pɨretsutsixi wahepaɨ.  
\v 27 ¿Ketitayari pereyetɨa 'atsipekaneretahɨaweka? Ne 'aixɨa 'anemekɨ nekamenetateutɨanikekaitɨni neyutemawietɨ ne xawererutsixi nepɨwareta'inienikekai.  
\v 28 Tsikere neniwema nemɨwareti'itsenikekai pepɨkanetsihepitɨa meta neteukarima. Pemɨka'uka'iyarini hepaɨ pepeyɨ.  
\v 29 Ne nekaniyɨweni nemɨtixe'utikwinitɨani, peru 'ikɨ tɨkaritsie 'apaapa Kakaɨyarieya pɨneretaxatɨa mɨpaɨ pɨneretahɨawixɨ: “'Amarima 'aixɨa Kakuwu pepɨka'utate'ani”.  
\v 30 Mɨpaɨ nepɨretima 'apaapa manuyeikatsie peyeimɨtɨ pepɨyɨane, ¿peru ketitayari petiwarenawa nekakaɨyarixi?   
\p
\v 31 Kakuwu mɨpaɨ katinita'eiya:  
\p —Ne yemekɨ waɨkawa ne petima, mɨpaɨ nepɨre'eri ne'ɨitama penetsihenawairienike nepe'eriekai.  
\v 32 Keniwarutiwawa 'akakaɨyarixi, kemɨ'ane pemɨtaxeirieni mɨkɨ ke'ukumawere. Ta'iwama memunenierixɨ mekanakɨnikuni: Ketineutiwawa tita mɨti'apiini, ketinapitɨ.  
\p Perutsɨ Kakuwu 'atsipɨkatimaikai, Xakeri Rawani kakaɨyariximama mɨwarenawakai,  
\v 33 Hikɨ Rawani Kakuwu xamaruyata meri kaniuti'iwauni, kwitɨwata Reya xamaruyata meta memɨyuhuta te'uximayatamete 'ukarawetsixi waxamaruta, nitixaɨtɨ pɨkatiukaxei. Kepauka Reya xamaruyata mɨwayetɨa, Xakeri xamaruyata kaneutahani.  
\v 34 Hikɨ Xakeri kakaɨyarixi kaniwaruti'awieta kameyu xirayatɨa, mɨpaɨ tiuyurieka waheima kanayerɨni. Rawani naime kaniu'iwauxiwiya, mɨkɨ pɨkawarutaxei.  
\v 35 Hikɨ Xakeri yupaapa mɨpaɨ katiniutahɨawe:  
\p —Neuxeitsɨ, nepɨtikuye, nepaapa, 'ukarawetsixi ketemɨyɨtɨka mɨpaɨ nepɨ'ane, nepɨkayɨwe 'anemutakeni pepɨkaha'aka.  
\p Rawani kakaɨyarixi kaniwarutiwauni, peru pɨkawarutaxei.   
\p
\v 36 Merikɨtsɨ Kakuwu kaniuyeha'ani, Rawani hepaɨtsita mɨpaɨ katinenutahɨawixɨani:  
\p —¿Kekuta yemekɨ netiuyuri, xurikime nekapeutiwiwiexɨa, titayari mɨya petatiyuriene?  
\v 37 Nepiinite naime pemɨtiutixei, ¿tita petiukaxei mɨti'apiini? Xɨka tixaɨtɨ petiutaxeiya, ta'iwama wahɨxie ketinekupini, mɨkɨ yameke'utiyuani kemɨ'ane tame temɨtahuta heitserie pexeiya.  
\v 38 Xeitewiyari wiyari 'ahetsɨa nepuyeikakai, 'amuxatsima 'atsipurima hatsuaku mepɨka'anuye'ikwitɨaxɨa, nitɨma xeime muxa nepɨka'utakwai 'akurarutamieme.  
\v 39 Xeime hatsuaku nepɨka'atɨa 'ɨrawe 'itexierieya, nepɨta nepɨrayukatuayakai mɨkɨkɨ. Yaxeikɨata hekɨta tɨkarikɨ memɨnawarietɨwekai 'ekɨ mɨkɨkɨ pepɨnetsiwiyakai.  
\v 40 Tukarikɨ xɨrikɨ nepɨtiuka'eniwakai, tɨkarikɨ xerikɨ neputimɨmɨwekaitɨma, yemekɨ nepɨkatikukutsukai.  
\v 41 Xeitewiyari wiyari 'akie nepuyuri, tamamata heimana nauka wiyari nepɨti'uximayakai 'aniwema wahetsiemieme, 'ataxewime wiyari 'atewama nepuwahɨkai, peru 'ekɨ mɨixa pepipataxɨ kenemɨti'iwakai.  
\v 42 Xɨka nepaapa Kakaɨyarieya 'Itsahaki meyemakaxe, meta 'Apɨrahami Kakaɨyarieya, xɨka kanetsiparewiekake, 'ekɨ nemaweme pekanenanunɨ'anikekaitɨni. Kakaɨyari pɨnetsi'uxei kenemɨtiuka'eniwakai neti'uximayatɨ, 'ayumieme takai tɨkarikɨ kename ne heitserie nehexeiya putayɨ.   
\p
\v 43 Rawani Kakuwu mɨpaɨ katiniuta'eiya:  
\p —'Ikɨ 'ukari mepɨneniwema, 'ikɨ temari mepɨneteukarima, muxatsitsiere mepɨnetewama, tita pemɨrexeiya nepiini pɨtihɨkɨ naitɨ. ¿Ketsukuta newaruyurieni 'ikɨ neniwema neteukarima?  
\v 44 Matsi tɨratu tepɨwewieni 'ekɨ matɨa ne, mɨkɨ tɨratu teme'eriwanikɨ mɨpaɨ temɨtemaikakɨ.   
\p
\v 45 Hikɨ Kakuwu tete 'anukutuka 'akanitakeni 'inɨari hepaɨ,  
\v 46 mɨpaɨ katiniwarutahɨawe yu'iwama:  
\p —Tetexi xekeneukuxeɨri.  
\p Mɨkɨ mepititɨkixɨa, 'axeikɨa mepikuxeɨri, mana mepɨte'ukwai, tetexi makuxeɨrietsie.  
\v 47 Mana Rawani Yekaxi-Tsaruta katiniuterɨwa meta Kakuwu Karaha katiniterɨwa.\f + \fr 31:47 \ft \fq Yekaxi-Tsaruta \ft 'arameukɨ paine meta hepɨrayukɨ \fq Karaha\ft , \fqa 'inɨari mɨtihekɨata\ft  panuyɨne.\f*   
\p
\v 48 Rawani mɨpaɨ kaniutayɨni:  
\p —'Ikɨ tetexi 'ena mukuxeɨrie teme'eriwanikɨ pɨ'inɨaritɨni.  
\p 'Ayumieme mana Karaha pɨtiuterɨwarɨwakai,  
\v 49 metatsiere Mitsipa pɨtiuterɨwarɨwakai, Rawani mɨpaɨ mutayɨkɨ:  
\p —Yawé ketatsixeiyani kepauka tahamatɨa temɨka'u'uwanitsie tame teyuhutatɨ.  
\v 50 Xɨka 'ekɨ neniwema 'axapewareyurieneni, xɨka hipame pɨta pewaretiwitɨni 'ukari, kena'eriwani Kakaɨyari yapɨretima, tsepa xewitɨ tawarita mɨkatatsixeiya.   
\p
\v 51 Rawani tetexi 'itɨiyatɨ mɨpaɨ kaniutayɨni:  
\p —Keneuxeiya tetexi mukuxeɨrie meta tete temikake.  
\v 52 Mɨkɨ ya'ane mepɨmaika kename 'ekɨ meta ne 'ena teka'anuyekɨkani 'axatetatiyuriexɨanike.  
\v 53 'Apɨrahami Kakaɨyarieya meta Nakuxi Kakaɨyarieya ta'itsɨkame kehɨkɨtɨni.  
\p Hikɨ Kakuwu 'aixɨa kaniutayɨni Kakaɨyari hepaɨtsita paapaya 'Itsahaki mimakaxekai hetsie.  
\v 54 Hikɨ mawari kaniuwewieni yemuri 'amanutitewatsie paitɨ, yu'iwama waruta'inieka yunaitɨ memɨtehekwanikɨ. Yunaitɨ mete'ukwakari, mana mekanitiheteitɨni.   
\p
\v 55 'Uxa'arieka ximeripaitɨ Rawani 'anukukeka, yuteukarima kaniwaruti'itseni Yawé wawirietɨ 'aixɨa mɨwayuriekakɨ meta yuniwema, hikɨ nakunuani yukie.   
\c 32  
\s1 Kakuwu 'Etsahu hetsɨa yuteɨterima kemɨtiwarenɨ'a  
\p
\v 1 Merikɨtsɨ Kakuwu kanayeyani kemɨtimiekai, 'umiekaku mekanenukunake niuki tuayamete Kakaɨyari hetsɨa miemete.  
\v 2 Kakuwu waruxeiyaka mɨpaɨ kaniutayɨni: «'Ena xɨari Kakaɨyari manuka pɨti'ane». 'Ayumieme mana Makanahini pɨtiuterɨwaxɨ.   
\p
\v 3 Hikɨ Kakuwu kaniwarenɨ'ani yuteɨterima 'Etsahu hetsɨa, Tsehixi kwieyaritsie paitɨ, 'Erumi mɨrakutewatsie.  
\v 4 Mɨpaɨ katiniwarutahɨawe mɨpaɨ memɨteheitahɨawekɨ: «Neti'aitɨwame 'Etsahu, mati'uximayatsiriwame Kakuwu, pɨtatsiheyenɨ'a mɨpaɨ tematetaxatɨanikɨ mɨkɨ Rawani kie pekatei kemɨreuterixɨ,  
\v 5 hikɨ pɨwarexeiya wakaitsixi, puxuri, muxatsi, te'uximayatamete 'ukitsi 'ukari. Mɨpaɨ pɨreyenɨ'a, 'aixɨa 'anemekɨ pemitakwewiekakɨ».   
\p
\v 6 Kepauka teɨterimama memakunuaxɨa, Kakuwu mɨpaɨ mekateniutaxatɨani: «'A'iwa 'Etsahu tepɨtehetaxatɨa, 'upamie pɨmatsihanakimie nauka tsienituyari wara'inietɨ yuteɨterima».   
\p
\v 7 Kakuwu waɨkawa kanekamatɨyani yu'iyaritɨatɨ. 'Ayumieme yuteɨterima muwarawitɨkɨkai hixɨapa kaniwatsana, yaxeikɨata kaniwarukuxeɨrieni muxatsi, wakaitsixi, kameyutsixi,  
\v 8 mɨpaɨ tiu'erieka: «Xɨka 'Etsahu warutakwini hipame, hipatɨ xeikɨa mepɨyuta'una».   
\p
\v 9 Hikɨ Kakuwu 'ayumieme kaniuyutanenewieni: «Yawé neteukari 'Apɨrahami meta nepaapa 'Itsahaki wakakaɨyari pemɨhɨkɨ, mɨpaɨ pemɨnerahɨawekai nekehakunuanike nekie ne'iwama wahetsɨa, meta kename penetsiparewiekakekai:  
\v 10 ne xɨari mati'uximayatsiriwame heitserie nepɨkahexeiya 'aixɨa pemɨnetixeiyanikɨ pemɨnetsiparewiekaku. Kepauka Kurutani hatuxameyaritsie nemanatɨa tixaɨtɨ nepɨkarexeiyakai ne'itsɨ xeikɨa nepakwekai, peru hikɨ hutakɨa mepukutei neteɨterima.  
\v 11 Kenenewikweitsitɨaka ne'iwa 'Etsahu netsi'umienikɨ nepeuma 'ukarawetsixi warukwini meta tɨɨri.  
\v 12 'Ekɨ mɨpaɨ pepɨnetiutahɨawixi kename penetsiparewiekakekai, kename nexiɨyarima yumuiretɨ mehakɨnekekai, xiekari haramara tetsita mɨtixeɨrie mɨkayu'inɨatsinɨa hepaɨ».   
\p
\v 13 Mɨkɨ tɨkaritsie Kakuwu mana puyuhayewaxɨ, kepaɨmeme mɨrexeiyakai katiniwaranuyeteɨxɨ yu'iwa 'Etsahu mɨtiminikɨ,  
\v 14 huta tsienituyari tsipuri 'ukari, xeitewiyari tsipuri tuurutsixi, huta tsienituyari muxatsi 'ukari meta xeitewiyari muxatsi 'ukitsi,  
\v 15 xeitewiyari heimana tamamata kameyutsixi 'ukari meniwetɨkaime, huta tewiyari wakaitsixi, tamamata tsikerutsixi xeiwiyari mehɨtɨkaime, xeitewiyari puxuri 'ukari meta tamamata puxuri 'ukitsi.  
\v 16 Hikɨ kaniwaruhɨritɨani yuxexɨime te'uximayatamete mɨpaɨ katiniwarutahɨawe: «Xeme xekenanuyeyaxi xete'u'arietɨ perutsɨ yunaitɨ xeka'uhutɨ yaxe'ayuxeiyatɨ».   
\p
\v 17 Manuyehaitɨanikekai mɨpaɨ katiniuhɨritɨani: «Kepauka mɨmatsihanukunake ne'iwa 'Etsahu, xɨka matsiheta'iwawiya, kemɨ'ane hetsɨa pepɨmieme, hakewa pepeutɨa, kemɨ'ane mepɨtehatewama 'ikɨ pemɨwara'arie,  
\v 18 mɨpaɨ pepɨreita'eiya: “'Ikɨ 'imikieri 'ahetsie pɨtimieme neti'aitɨwame 'Etsahu, Kakuwu mati'uximayatsiriwame pɨmatsiheyenɨ'airi yutewama wahetsie waranuyeteɨxɨka, mɨkɨtatsiere ta'utɨma kanamieni”».   
\p
\v 19 Kakuwu yaxeikɨata katiniuhɨritɨani hutarieka mieme, meta hairieka mieme, yaxeikɨa yunaime katiniwarutahɨawe tewaxi memuwaru'ariekai. Mɨpaɨ katiniwarutahɨawe: «Kepauka 'Etsahu xemanukunake mɨpaɨ xekateneitahɨawikuni,  
\v 20 mɨpaɨtatsiere xekateneitahɨawikuni: “Mati'uximayatsiriwame Kakuwu ta'utɨma 'ukanamieni”».  
\p Mɨpaɨ pɨtiku'eriwakai Kakuwu: «'Imikierikɨ meri nekaninɨtɨamɨkɨ, 'ariketa ne kanenanukunakimɨkɨ heiwatɨ 'aixɨa netiutahɨawe».  
\v 21 Hikɨ mɨpaɨ 'imikieri meri katinenɨ'ani, Kakuwu 'akuxi mana puyuhayewaxɨ mɨkɨ tɨkaritsie mematitekaitsie.   
\s1 Kakuwu kememɨte'uyutakwi niuki tuayame hamatɨa  
\p
\v 22 Hikɨ mɨkɨ tɨkaritsie Kakuwu kaniuyukuha'aritɨani, yu'ɨitama meta memuyuhuta te'uximayatamete, meta tamamata heimana xewi wara'inietɨ yuniwema, haa 'etsimɨpetsie mekaniukɨne Kawuki mɨrayetewatsie.  
\v 23 Hikɨ kepauka muwaranutua, yutewama yupiinite naime katinanutuanita,  
\v 24 hikɨ yuxaɨtame kaniuyuhayewa. 'Ana xewitɨ tewi kanitamieni kaniukatare 'imienekaku.  
\v 25 Kepauka 'iya tewi mɨpaɨ mɨretima Kakuwu mɨkaha'iwakaikɨ, teurieya mɨtiwayewiyatsie kanitahutsuni, 'anari kaniwayexɨne 'uti'ɨtsaiwatɨ kanayani meyukwitɨwekaku.  
\v 26 Hikɨ tewi mɨpaɨ katinitahɨawe:  
\p —Keneneutatua, 'ari pɨkahekɨarirɨme.  
\p Kakuwu mɨpaɨ katinitahɨawe:  
\p —Kepaukake 'aixɨa pemɨnetsiyurieni 'anake nepɨmatsitatuani.   
\p
\v 27 Tewi mɨpaɨ katinita'iwawiya:  
\p —¿Kepetitewa?  
\p —Kakuwu nepɨtitewa —katinita'eiya.   
\p
\v 28 Hikɨ tewi mɨpaɨ katinitahɨawe:  
\p —Kakuwu pepɨkatitewakari, 'Ixaheri pɨta, Kakaɨyari pemutamikɨ meta teɨteri, pemɨrayu'iwakɨ.   
\p
\v 29 Kakuwu mɨpaɨta katinita'iwawiya:  
\p —'Ekɨta, ¿kepetitewa?  
\p Tewi mɨpaɨ kaniutayɨni:  
\p —¿Titayarikuta penetiku'iwawiya kenemɨtitewa?  
\p Mana kwitɨwa 'aixɨa kaniyurieni.  
\v 30 Hikɨ Kakuwu mana Penuheri katiniuterɨwa, mɨpaɨ 'utayɨka: «Kakaɨyari nierikaya nepuxei, 'ayɨwekatɨka nepayeyuri 'akuxi».   
\p
\v 31 Tau panatine Penuheri 'uyemiekaku Kakuwu. Mutiteurimɨrariekaikɨ 'uti'ɨtsaiwatɨ kaneyani.  
\v 32 'Ayumieme 'ixaheritsixi wai teuri mɨrawiyatsie mieme mepɨkakwa'a, Kakuwu mana mutahutsunariekɨ.   
\c 33  
\s1 Kememɨte'anuyukunakixɨ Kakuwu 'Etsahu matɨa  
\p
\v 1 Kepauka Kakuwu 'Etsahu muxei 'a'amiekame teɨteri nauka tsienituyari warawitɨkɨme, yu'ɨitama waniwema me'ayenaukame kaniwarayeitɨani Reya, Xakeri meta te'uximayatamete memuyuhuta.  
\v 2 Mɨkɨ 'ukarawetsixi memuyuhuta te'uximayatamete kaniwaranuyeyatsa yuniwemakame, wa'utɨmata Reya yuniwemakame, 'imatɨrieka Xakeri yuniwe Kutse matɨa.  
\v 3 Hikɨ Kakuwu meri nanuyeyerɨni, 'atahutamexɨa 'umietɨ kananakatutsitakaitɨni kwiepa paitɨ yu'iwa 'anukunakirɨmetɨ.  
\v 4 Peru 'Etsahu kaniutanautsa 'enukunakeke, 'itapaka kani'itseni. Hikɨ yuhutatɨ mekaniutitsuani.  
\v 5 Kepauka 'Etsahu 'ukarawetsixi mɨwaruxei meta tɨɨri, mɨpaɨ katiniuta'iwauni:  
\p —¿Kemɨ'aneta 'ikɨ mepɨyɨa, memɨmatsi'aweiya?  
\p Kakuwu mɨpaɨ katinita'eiya:  
\p —Mɨkɨ tɨɨri mepɨhɨkɨ Kakaɨyari ti'a'uximayatsiriwame meyenɨ'airi.   
\p
\v 6 Mɨkɨ yuhutatɨ te'uximayatamete 'ukarawetsixi 'amenakɨne yuniwema mewaruwitɨtɨ 'Etsahu hɨxie mekanakatutsitaxɨani.  
\v 7 Kwitɨta Reya meta niwemama yaxeikɨata mekaniuyɨni, 'imatɨrieka Kutse Xakeri matɨa yaxeikɨata mekaniutihɨxima'uni.   
\p
\v 8 'Etsahu mɨpaɨ katiniuta'iwauni:  
\p —¿Kepaɨtɨtɨri mɨkɨ tewaxi pemɨnetsihenɨ'airi?  
\p Kakuwu mɨpaɨ katinita'eiya:  
\p —Kɨmana 'aixɨa pemɨneranunakekɨ nepɨtiuyuri.   
\p
\v 9 'Etsahu mɨpaɨ kaniutayɨni:  
\p —Neuxeitsɨ, nemuta, matsi neta waɨkawari nepɨrexeiya. Ketinapitɨ 'apiinite.   
\p
\v 10 Kakuwu mɨpaɨ kaniutayɨni:  
\p —Neuxeitsɨ hawaikɨ, xɨkari 'aixɨa 'anemekɨ penetsi'utahɨawe, ketineutanaki'eri tita nematimikwa. 'Aixɨa 'anemekɨri pekaneniutahɨawe, 'anierika nexeiyatɨ Kakaɨyari nemɨxeiyani hepaɨ nekatinimaika.  
\v 11 Ketineutanaki'eri 'imikieri nemɨmati'atɨiri. Kakaɨyari 'aixɨa pɨtiuka'iyari nehetsiemieme, waɨkawa matsi nepɨrexeiya tita nemɨreuyehɨwa.  
\p Mɨya tikɨhɨawetɨ Kakuwu 'ameteneutere, 'imatɨrieka 'Etsahu yakatiniutanaki'erieni.  
\v 12 'Arikekeri 'Etsahu mɨpaɨ katinitahɨawe:  
\p —Kɨmɨtsɨari tekaniyehuni, ne nekamenanuteɨtamɨkɨ.   
\p
\v 13 Peru Kakuwu mɨpaɨ kaniutayɨni:  
\p —Neuxeitsɨ, nematsika meta neti'aitɨwame, tɨɨri mepɨka'ɨkɨniwawe meta muxatsi wakaitsixi meputiniwexɨa, nepɨwata'ɨwiya. Xɨka xeiya neware'arieni yunaitɨ xeitukaritsie mepɨkwini.  
\v 14 'Ayumieme peuyewetse pemanuyeyerɨni mati'uximayatsiriwame hɨxie, ne'anɨkai nepɨyemie netewama wahamatɨa meta tɨɨri, Tsehixi paitɨke tekaneyukaxeiyakuni.   
\p
\v 15 'Etsahu mɨpaɨ kaniutayɨni:  
\p —'Aixɨa kani'aneni, peru neteɨterima nekaniwaku'eirimɨkɨ yayupaɨmeme memɨmatsi'anuteɨtakɨ.  
\p Kakuwu mɨpaɨ katinita'eiya:  
\p —Neuxeitsɨ pepɨka'a'iyaritɨaka, matsi 'aixɨa 'anemekɨri tepuyutahɨawixɨ, mɨkɨ matsi waɨkawa peuyewekai.   
\p
\v 16 Mɨkɨ tukaritsie kwitɨwa 'Etsahu kanakunuani Tsehixi paitɨ.  
\v 17 Kakuwu, kaneyani Tsukuti 'erietɨ, mana kaniuyutakitɨani meta kuraru kaniutiwewieni yutewama wahetsiemieme. 'Ayumieme mana pɨtiuterɨwarie Tsukuti.   
\p
\v 18 Kepauka Kakuwu makunua Parani-'Arami, 'aixɨa 'anemekɨ meta 'aixɨa reu'erietɨ Tsikeni kiekariyaritsie kaninuani, Kanani kwieyaritsie, mɨkɨ hɨxie kaniutayerɨni.  
\v 19 Hikɨ xeitsienituyari pɨrata tuminiyarikɨ kwie kaniunaneni, Kamuxi niwemama kaniwarunanairieni Tsikeni paapaya mana kaniyutaxamarutɨani.  
\v 20 Metatsiere mana mawari taiyame kaniutawewieni, 'Eruhe-'Ixaheri katiniterɨwa.   
\c 34  
\s1 Rina kemɨtiunawarie  
\p
\v 1 Merikɨtsɨ Rina Kakuwu niweya Reya hetsie meyexei, hipame 'ukarawetsixi kaniwareku'iwata mana kiekatari.  
\v 2 Kepauka mixei Tsikeni, Kamuxi nu'aya, heweu tewiyari, mana mɨtiwa'aitɨakai, 'iwiyaka waɨriyarika 'ipitɨatɨ hamatɨana kaniukahuni kaninanaimani.  
\v 3 Mɨya 'iyuriekaketa kanitihiwe'erieni 'aixɨa katinixeiyakaitɨni pitiwitɨnikekai.  
\v 4 Hikɨ yupaapa mɨpaɨ katiniutahɨawe: «Mɨkɨ 'uka keneutawawa ne'ɨya mayanikɨ».   
\p
\v 5 Hikɨ Kakuwu mɨpaɨ katinetimani kename Tsikeni nu'aya Rina 'unanaimakai, 'atsipɨka'utayɨ niwemama yeuta meme'uwakaikɨ tewaxi metewarehɨtɨwetɨ, me'u'axɨakuke katiniwarutaxatɨani.  
\v 6 Hikɨ Kamuxi Tsikeni paapaya, Kakuwu hetsɨa kaneyani hamatɨana titaxatake.  
\v 7 Kepauka Kakuwu niwemama memu'axɨa mekateniutamarieni kemɨtiɨyɨkai, pɨkawarunakixɨ waɨkawa meha'atɨ mekaniuyuhayewa. Tsikeni waɨkawa 'axakatiniuyuriekaitɨni 'Ixaheri hepaɨtsita niweya munanaimakɨ, pɨkaheuyewekai matsi mɨpaɨ mɨtiyurienikɨ.  
\v 8 Kamuxi peru mɨpaɨ katiniwarutahɨawe:  
\p —Neniwe Tsikeni xe'iwa 'uka kanihiwe'erieka. Neuxeikuta xekeneupitɨa memuyutiwitɨnikɨ.  
\v 9 Tepɨtatimareta. Taniwema mepuyuwitɨtɨweni.  
\v 10 Mɨpaɨ xepɨteyuhayewani xeme tahamatɨa, 'ikɨ kwie xehetsiemieme pɨhɨkɨtɨni 'ena xekeneu'uwani kemɨtixenake xete'uximayatɨ, meta kwie xekeneukukurarutɨiyaxɨa.   
\p
\v 11 Hikɨ Tsikeni mɨpaɨta katiniwarutahɨawe Rina 'iwamama meta paapaya:  
\p —Xɨka xeme xenetsi'utanaki'erieni, ne nepɨtixepitɨani tita xemɨnetetawawirieni.  
\v 12 Xepɨyɨwawe tita xemɨnete'utawawirieni kɨmana, meta 'imikieri nemɨtixeminikɨ, peru yemekɨ xekeneneupitɨa 'uka ne nemɨtiwitɨnikɨ.   
\p
\v 13 Hikɨ wa'iwa Rina munanaimariekɨ, Kakuwu niwemama mekaniwaruta'eiya kwamanarikakɨ Tsikeni meta paapaya Kamuxi.   
\p
\v 14 Mɨpaɨ mekateniwarutahɨawe:  
\p —Tame tepɨkayɨwawe mɨpaɨ temɨte'uyurieni. Xɨka ta'iwa teyetuani xeime xitekiya 'inɨariyari kahexeiyame hetsɨa tepɨtatewiyatsitɨani tame.  
\v 15 Ketemɨtexetahɨawe xɨka mɨpaɨ xe'uyɨni 'ana yatepɨtetanaki'erieni: yunaitɨ xeme 'ukitsi xitekiya 'inɨariyari xekeneuyuwewiri tahepaɨ xemɨ'anenenikɨ.   
\p
\v 16 'Anake taniwema temɨwatawitɨtɨwani kaniyɨwemɨkɨ, xehamatɨa temɨtiteni xeikiekariyari temɨhɨkɨtɨni.  
\v 17 Mexɨka yaxekate'utanaki'erieni xitekiya xeka'uyuwewirieni, ta'iwa te'awitɨtɨ tame tekaniyehuni.   
\p
\v 18 Kamuxi Tsikeni matɨa yameteniutanaki'erieni kememutiyua,  
\v 19 Tsikeni kwitɨwa kaniuyu'inɨaritɨani Kakuwu nu'aya kwiniemieme mɨtinaki'eriekaikɨ.  
\p Tsikeni waɨkawa 'iwamama memei'eniekaikɨ,  
\v 20 paapaya Kamuxi kaneiteɨta kiekari kitenie paitɨ, mana mekateniutixata kiekatari wahamatɨa. Mɨpaɨ mekateniwarutahɨawe:   
\p
\v 21 —'Ikɨ teɨteri 'aixɨa mepɨtekahu mepɨhamikutsixi. Xekeniwarupitɨa takwieyaritsie memu'uwanikɨ, mekete'uximayaka 'ena, 'apakuyewakuta wahetsiemieme. Meta tame tepɨyɨwaweni temɨwatiwitɨni waniwema, mɨkɨta taniwema.  
\v 22 Mɨkɨ yamepɨteha'eriwa tahamatɨa memuyuhayewakɨ xeikiekariyari temakɨnekɨ, xɨka yatetekakɨne kememaitɨka: xɨka teyunaitɨ 'ukitsi xitekiya 'inɨariyari te'uyuwewirieni, mɨkɨ kememɨte'uhu.   
\p
\v 23 Hikɨmɨtɨka yatepɨtekakɨne, tahamatɨa memuyuhayewanikɨ. Mɨpaɨ wawakaitsixi naime tita memɨtehexeiya tapiini mepɨtehɨkɨtɨni.   
\p
\v 24 Yunaitɨ kiekari kitenie memuyuxeɨriekai, yameteniutanaki'erieni Kamuxi meta nu'aya Tsikeni kememaitɨkatei, 'ana yunaitɨ 'ukitsi mekaniu'inɨaritɨarieni xitekiyakɨ.  
\v 25 Hairieka tukaritsie, 'ukitsi 'akuxi mete'ukakukuinekaku, yuhutatɨ Kakuwu niwemama Tsimehuni Rewi matɨa, Rina matsikamama, yu'ixipara me'u'ɨtɨ kiekaritsie mekanekɨne, 'ukitsi memuyeheitɨkateitsie mekayɨ'ɨwiyatɨ, yunaime mekaniwarukwini.  
\v 26 Kamuxi meta nu'aya Tsikeni mekaniumieni, Rina Tsikeni kiita mewayehanaka mekanekɨne.  
\v 27 Hikɨ hipatɨta Kakuwu niwemama mekaniu'axɨani, mɨkite watsata me'utakɨneka, kiekaritsie naime wapiini mekatene'arieni wa'iwa munanaimariekɨ.  
\v 28 Yupiini mekatenayeitɨani wamuxatsima, wawakaitsixima, wapuxurima, naime tita kiekaritsie mɨtiyepikai meta tita memɨte'ekai.  
\v 29 Naime mekatenepini tita memɨtehexeiyakai, meta waniwema wa'ɨitamata naime mekateniunawani kiita mɨrayepitɨkatei.   
\p
\v 30 Hikɨ Kakuwu mɨpaɨ katiniwarutahɨawe Tsimehuni Rewi mame:  
\p —Waɨkawa 'uximatɨarika xepɨnetsiheutiwiwiriexɨa. Hikɨ 'ena mɨtiyehane kananeutsixi, peretseutsixi, 'enakiekatari yunaitɨ, menetsi'aye'unietɨ mepakɨne. Xɨka mɨkɨ me'uyukuxeɨrieni menetsi'utamieni, mepɨnetsimieni netɨɨriyama yunaime mepɨwakwini, waɨkawa teɨteri nepɨkawarexeiya.   
\p
\v 31 Peru mɨkɨ mɨpaɨ mekatenita'eiya:  
\p —Kamɨtsɨ tete'ihayewakekai tsepa 'iya ta'iwa tuminikɨ muyumayɨinɨa hepaɨ mɨranuyemienikɨ.   
\c 35  
\s1 Kakuwu Weteri kemɨretɨa  
\p
\v 1 Merikɨtsɨ Kakaɨyari Kakuwu mɨpaɨ katiniutahɨawe: «Kenemie, Weteri kenekani. Mana mawari taiyame kenetawewi nehetsiemieme hakewa pemɨnetsihexei mana pe'uyemietɨ 'Etsahu hekɨ pe'uyu'unarɨmetɨ».   
\p
\v 2 Hikɨ Kakuwu mɨpaɨ katiniwarutaxatɨani yutɨɨriyama meta hamatɨana memu'uwakai: «Xekeniwaruhayewa hipame wakakaɨyarixi yuhetsɨa xemɨwarexeiya, xekeneuyu'iti, hipame pɨta yu'ixurikite xeketenanakatɨxɨa.  
\v 3 Weteri paitɨ tekaniyehuni. Mana tenari mawari taiyame nekanetawewimɨkɨ Kakaɨyari hetsiemieme mɨnetsi'uparewi ne'uweiyariekaku, huyeta nehamatɨa mumie».   
\p
\v 4 Hikɨ Kakuwu mekateniyetuirieni yukakaɨyarixi memɨwarexeiyakai, yunakɨtsate yunakatesie memanuyewutɨakai, Kakuwu katiniukateuku xiu hetɨa Tsikeni hehurakaku muwekai.  
\v 5 Kepauka memekɨ, nixewitɨ pɨkawaranukuwei Kakuwu tɨɨriyamama, waɨkawa memutimamakaikɨ kiekari mamanetɨkatsie.   
\p
\v 6 Mɨpaɨ tiɨyɨku Kakuwu 'Arimetɨra maku'u kaninuani, tatsɨari Weteri, meta memeweiyakai yunaitɨ, Kanani kwieyaritsie.  
\v 7 Mana mawari taiyame kaniutawewieni, meta Weteri katiniuterɨwa, mana matsiɨkɨme mayuyeitɨakɨ Kakaɨyari kepauka 'Etsahu hekɨ muyu'unarɨmekai.   
\p
\v 8 Hikɨ 'ana Rewura kaniumɨni, Xeweka mɨ'ɨwiyakai, xiu manuwe hetɨa mekanikateuku Weteri 'aurie. 'Ayumieme Kakuwu mana 'Eruni-Wakuti katiniuterɨwa.   
\p
\v 9 Kepauka Kakuwu Parani-'Arami heyeyaka munua, hutarieka Kakaɨyari matsiɨkɨme kanayuyeitɨani 'aixɨa kaniyurieni,  
\v 10 mɨpaɨ tikɨhɨawetɨ: «Kakuwu pepɨtitewa, hikɨri mɨpaɨ pepɨkatitewaka. 'Ena mɨtiyehane 'Ixaheri pepɨtitewaka pɨta». Mɨpaɨ katiniterɨwa.   
\p
\v 11 Tawarita Kakaɨyari mɨpaɨ kaniutayɨni: «Ne Kakaɨyari Naimekɨmɨtɨrɨkaɨye nekanihɨkɨtɨni. Kenexiɨka kene'amɨiriyani. 'Ahetsie mepɨyekɨne yumɨiretɨ 'anuiwarima xeikɨa, manata te'aitamete mepɨtixuawere.  
\v 12 'Apɨrahami meta 'Itsahaki kwie nemɨwarumi 'ekɨ nepɨmatsiyetuirie meta 'anuiwarima».  
\v 13 Hikɨ Kakaɨyari Kakuwu hamatɨa tiutaxataka kaneyani.   
\p
\v 14 Kakuwu mana tete kaniutakeni hakewa Kakaɨyari hamatɨa mɨretixa. Mɨkɨ tete kaxie winuyarikɨ kanika'ɨya meta huriwa hatseitiyari kanikawirieni,  
\v 15 hakewa Kakaɨyari Kakuwu metahɨawixɨ Weteri katiniuterɨwa.   
\s1 Xakeri meta 'Itsahaki kememɨte'ukumawerixɨ  
\r (Tsut 35:23-26 – 1Kem 2:1-2)  
\p
\v 16 Hikɨ 'arike Weteri mekaniyekɨne. 'Epɨrata 'akuxi 'ahetewakaku Xakeri kaniutiniweni, waɨriyarika nunutsi kanayexeiya.  
\v 17 Kwiyɨanekaku niwenetɨ, tiniweritsitɨwame mɨpaɨ katinitahɨawe: «Pepɨkamaka, tawarita xeime nunutsi 'uki pekanayexeiyarɨmeni».  
\v 18 Perutsɨ mɨkɨ mɨximetɨ, 'imatɨrieka yuniwe Wenuní katiniuterɨwa, peru paapaya Wenikamini pɨta katiniterɨwa.   
\p
\v 19 Mɨpaɨ Xakeri katiniumɨni, 'Epɨrata huyeyari 'utɨa mekanikateuku, hikɨ Wereni mɨrakutewatsie.  
\v 20 Memekateukixɨtsie Kakuwu 'inɨari kaniutakeni, hikɨ 'akuxi peyuhekɨa hakewa Xakeri mekateukie.   
\p
\v 21 'Ixaheri yuhuyeta kaneyani hikɨ Mirari-'Eraxi manunieretsie kaniutayerɨni.  
\v 22 Mɨkɨ kwieyaritsie mekutetɨ, Xuweni Wiriha hamatɨa kaniukahuni, yupaapa 'ɨyaya hamatɨa. Kepauka 'Ixaheri mɨretima waɨkawa kaniuyeha'ani.  
\b  
\p Kakuwu tamamata heimana yuhutame kaniwarutinuarieni:   
\li1
\v 23 Reya niwemama mepɨhɨkɨ: Xuweni, Kakuwu matɨarieya matɨa, Tsimehuni, Rewi, Kura, 'Itsakaxi meta Tsawuruni.   
\li1
\v 24 Xakeri niwemama mepɨhɨkɨ: Kutse meta Wenikamini.   
\li1
\v 25 Wiriha niwemama mepɨhɨkɨ Xakeri parewiwameya: Rani meta Nepɨtahari.   
\li1
\v 26 Tsiripa niwemama mepɨhɨkɨ Reya parewiwameya: Kahari meta 'Atsexi.  
\p 'Ikɨ mepɨhɨkɨ tɨɨri Kakuwu mɨwarayexei Parani-'Arami kwieyaritsiepai.   
\b  
\p
\v 27 Kakuwu yupaapa kie kanakunuani Mamɨre, Kiriati-'Ariwa 'aurie, Hewuruni mɨrakutewatsiere, 'Apɨrahami meripaitɨ manuyeikakai meta 'Itsahaki.  
\v 28 'Itsahaki xeitsienituyari heimana nauka tewiyari wiyari kanexeiyakaitɨni kepauka mumɨ.  
\v 29 Waɨkawa 'ukiratsitɨtɨ kaniɨyɨni, niwemama 'Etsahu, Kakuwu 'ukiyarimama wahamatɨa mekanikateuku.   
\c 36  
\s1 'Etsahu nuiwarimama  
\r (Tsut 36:10-14, 20-28 – 1Kem 1:35-42)  
\p
\v 1 Merikɨtsɨ 'ikɨ mepɨhɨkɨ 'Etsahu nuiwarimama, meta 'Erumi mɨtitewakaita.   
\b  
\pi1
\v 2 'Etsahu, 'ukari Kanani kiekatari pɨwarutiwitɨ: 'Ara kaniutiwitɨni 'Eruni niweya Heti tewiyari, 'Ahuriwama kaniutiwitɨni 'Ahana niweya Tsiwehuni teukarieya heweu tewiyari,  
\v 3 meta Watsemati kaniutiwitɨni 'Itsimaheri niweya Newayuti taruya.   
\pi1
\v 4 'Ikɨ mepɨniwemama 'Etsahu: 'Ara hamatɨa kaneyexeiya 'Eripaxi. Watsemati hamatɨa kaneyexeiya Xehueri.  
\v 5 'Ahuriwama matɨa mekaniwarayexeiya Kehutsi, Karani meta Kure. 'Ikɨ tɨɨri 'Etsahu muwarayexei mekanihɨkɨtɨni Kanani kwieyaritsie 'uyeikatɨ.   
\pi1
\v 6 Hikɨ 'arikeke 'Etsahu kaneyani yu'ɨitama yuniwema meta yunaime teɨteri memiparewiekai warawitɨtɨ, yutewama wara'arietɨ naime yupiinite Kanani kwieyaritsie mɨtiukaxeiyakai, xeime kwieyaritsie kaniuyupata Kakuwu hamatɨa mɨka'uyeikanikɨ.  
\v 7 Yuhutatɨ waɨkawa mepɨtehexeiyakai yupiinite 'ayumieme mepɨkayɨwawekai 'axeikɨa memukuteni, 'ɨxa pumawekai watewama wahetsiemieme.  
\v 8 Mɨpaɨ katininuani 'Etsahu, metatsiere 'Erumi mɨtitewakai, hɨritsie Tsehixi kwieyaritsie.   
\b  
\p
\v 9 'Ikɨ mekanihɨkɨtɨni 'Etsahu nuiwarimama, 'erumitsixi wa'ukiyari, hɨritsie Tsehixi kwieyaritsie memɨtamarixɨ.  
\v 10 Waniwema mɨpaɨ mekatenitetewakaitɨni:  
\li1 'Eripaxi 'Ara nu'aya, 'Etsahu 'ɨyaya, Xehueri Watsemati nu'aya, 'Etsahu 'ɨyaya.   
\li1
\v 11 'Eripaxi niwemama mekanakɨne: Temani, 'Umaxi, Tsepuhu, Katani meta Kenatsi.   
\li2
\v 12 'Eripaxi yutuxeri Timina hamatɨa xeime kanayexeiya nunutsi 'Amareki katiniterɨwa.  
\li2 Mɨkɨ yunaitɨ 'Ara teukarimama mekanakɨne, 'Etsahu 'ɨyaya.   
\li1
\v 13 Xehueri niwemama mekanakɨne: Nakati, Tsera, Tsama meta Mitsaha. 'Ikɨ Watsemati teukarimama mekanihɨkɨtɨni, 'Etsahu 'ɨyaya.   
\li1
\v 14 Hipatɨta 'Etsahu niwemama 'Ahuriwama hetsiemieme, 'Ahana niweya Tsiwehuni teukarieya, mekanihɨkɨtɨni: Kehutsi, Karani meta Kure.   
\b  
\p
\v 15 'Ikɨ memanuyetei mekanakɨne 'Etsahu nuiwarimama wahetsie:  
\li1 'Eripaxi 'Etsahu matɨarieya nuiwarimama memanuyetei mepakɨ: Temani, 'Umaxi, Tsepuhu, Kenatsi,  
\v 16 Kure, Katani meta 'Amareki. 'Ikɨ memanuyetei mekanakɨne 'Eripaxi nuiwarimama wahetsie 'Erumi kwieyaritsie, mɨkɨ yunaitɨ 'Ara teukarimama xeikɨa mepɨhɨkɨtɨkai.   
\li1
\v 17 'Etsahu nu'aya Xehueri niwemama, memanuyetei mekanakɨne Nakati, Tsera, Tsama meta Mitsaha.  
\p 'Ikɨ memanuyetei mekanakɨne Xehueri nuiwarimama wahetsie 'Erumi kwieyaritsie, yunaitɨ mɨkɨ Watsemati teukarimama mekanihɨkɨtɨkaitɨni, 'Etsahu 'ɨyaya mɨhɨkɨtɨkai.   
\li1
\v 18 'Ahuriwama niwemamata 'Ahana niweya, 'Etsahu 'ɨyaya, memanuyetei mekanakɨne Kehutsi, Karani meta Kure.   
\p
\v 19 'Ikɨ 'Etsahu nuiwarimama mepakɨ, metatsiere 'Erumi mɨtitewakai, meta yuxexuitɨ nuiwarite wahetsie memanuyetekai.   
\b  
\p
\v 20 'Ikɨ Tsehixi nuiwarimama mekanihɨkɨtɨni hureu tewiyari, mana memɨtamakai:  
\li1 Rutani, Tsuwari, Tsiwehuni, 'Ahana,  
\v 21 Ritsuni, 'Etsexi meta Ritsani. 'Ikɨ Tsehixi nuiwarimama wahetsie memanuyetei mekanakɨne hureutsixi wahetsie 'Erumi kwieyaritsie.   
\li2
\v 22 Rutani niwemama mekanakɨne: Huri, Humani matɨa. Rutani xeime yu'iwa 'uka kanexeiyakaitɨni Timina titewakame.   
\li2
\v 23 Tsuwari niwemama mepɨhɨkɨ: 'Ariwani, Manakati, 'Ewari, Tsepuhu meta 'Unami.   
\li2
\v 24 Tsiwehuni niwemama mepɨhɨkɨ: 'Ayaha meta 'Ahana. 'Ikɨ 'imatɨrieka mieme haa xɨkame mutaxei kanihɨkɨtɨni makumawetsie hetineikatɨkaime, yupaapa puxurimama wahɨnetɨ Tsiwehuni.   
\li2
\v 25 'Ahana niwemama mepɨhɨkɨ: Ritsuni meta 'Ahuriwama, 'Ahana niweya.  
\v 26 Ritsuni niwemama mepɨhɨkɨ: Hemɨrani, 'Etsiwani, 'Itɨrani meta Kerani.   
\li2
\v 27 'Etsexi niwemama mepɨhɨkɨ: Wirani, Tsawani meta 'Akani.   
\li2
\v 28 Ritsani niwemama mepɨhɨkɨ: 'Utsi meta 'Arahani.   
\li1
\v 29 Hureutsixi wa'ukiyarima mepakɨ Rutani, Tsuwari, Tsiwehuni, 'Ahana,  
\v 30 Ritsuni, 'Etsexi meta Ritsani. Mɨkɨ yuxexuitɨ yunuiwari hetsie memanuyetei mepakɨ Tsehixi kwieyaritsie.   
\s1 Te'aitamete 'Erumi kwieyaritsie  
\r (Tsut 36:31-43 – 1Kem 1:43-54)  
\p
\v 31 'Ixaheritsixi te'aitamete mekawarexeiyakaku 'akuxi, 'ikɨ mepanuka'ui 'Erumi kwieyaritsie:   
\li1
\v 32 Wera Wehuxi nu'aya 'Erumi katiniuta'aita. Kiekarieya Rinawa katinitewakaitɨni.   
\li1
\v 33 Kepauka Wera mumɨ, hetsienamieme katiniuta'aita Kuwawi Tsera nu'aya, Wutsira meyeyakai.   
\li1
\v 34 Kepauka Kuwawi mumɨ, hetsienamieme katiniuta'aita Kutsani Temani kiekame.   
\li1
\v 35 Kepauka Kutsani mumɨ hetsienamieme katiniuta'aita Harari Werari nu'aya. Mɨkɨ mariyanitsixi mɨwara'iwaxɨ Muhawi kwieyaritsie. Kiekarieya 'Awiti pɨtitewakai.   
\li1
\v 36 Kepauka mumɨ Harari, hetsienamieme katiniuta'aita Tsamɨra, Matsireka kiekariyaritsie kiekame.   
\li1
\v 37 Kepauka mumɨ Tsamɨra, hetsienamieme katiniuta'aita Tsahuri, 'aki Xekuwuti manuyeka kiekame.   
\li1
\v 38 Kepauka mumɨ Tsahuri, hetsienamieme katiniuta'aita Wahari-Kanani 'Akuwuxi nu'aya.   
\li1
\v 39 Kepauka Wahari-Kanani mumɨ 'Akuwuxi nu'aya, hetsienamieme katiniuta'aita Hara. Kiekarieya katinitewakaitɨni Pahu. 'Ɨyaya katinitewakaitɨni Mehitaweri, Matereri kaninu'ayatɨni, Metsawi teukarieya.   
\b  
\li1
\v 40 Mɨpaɨ mepɨtetetewakai me'anuyetetɨmemakɨ 'Etsahu nuiwarimama, yuxexuitɨ yutɨɨriyama mewarexeiyatɨ meta yukwie: Timina, 'Ariwa, Keteti,  
\v 41 'Ahuriwama, 'Eraha, Pinuni,  
\v 42 Kenatsi, Temani, Miwitsaxi,  
\v 43 Makirieri meta 'Irami. 'Ikɨ mepɨhɨkɨ memanuyeyaxixɨ 'Erumi kwieyaritsie, kememɨte'ukutetɨkatei.  
\b  
\p 'Ikɨ 'Etsahu 'erumitsixi wa'ukiyari kanihɨkɨtɨni.   
\c 37  
\s1 Kutse heinɨtsikateya  
\p
\v 1 Merikɨtsɨ Kakuwu Kanani kwieyaritsie kaniukateitɨni, 'ukiyarimama memakutekaitsie, peru mana mepɨkakiekataritɨkai 'akuxi.   
\p
\v 2 'Ikɨ pɨhɨkɨ 'ɨxatsi yuri maine, yaxeikɨata Kakuwu, tɨɨriyamama wahepaɨtsita kemɨtiuyɨ.  
\p Merikɨtsɨ kepauka Kutse tamamata heimana 'atahuta wiyari mɨhɨkai, yu'iwama kaniwaparewienekaitɨni, Wiriha Tsiripa watɨɨriyama, muxatsi wahɨiyarikɨ. Mɨkɨ Kutse yupaapa katinikuxaxatɨwakaitɨni 'iwamama 'axakememɨteyuriekai.   
\p
\v 3 'Ixaheri matsi waɨkawa Kutse kaninaki'eriekaitɨni ke hipame 'iwamama, 'ukiratsitɨtɨ meyexeikɨ. 'Ayumieme kamixa 'atewime witsi'aneme\f + \fr 37:3 \ft \fq kamixa 'atewime witsi'anekame\ft . Yatɨni \fqa kamixaya witsimɨ'ane 'amɨmamatetɨtɨ\ft  pɨkwaniwe. Yaxeikɨa 37:23. \f* pita'aitsiri.  
\v 4 Hikɨ 'iwamama me'ixeiyatɨ paapaya kemɨtinaki'eriekai, matsi waɨkawa mekani'uxiwe'eriekaitɨni ni tɨma 'aixɨa mepɨkate'ikuhɨawekai.   
\p
\v 5 Merikɨtsɨ heiwa Kutse tiuheinɨka, yu'iwama katiniwarutaxatɨani. 'Ana matsi waɨkawa mekaniti'uxiwe'erietɨkɨne,  
\v 6 mɨpaɨ mɨtiwarutaxatɨakɨ:  
\p —Xekeneneu'eni nepɨtixetaxatɨani kenemɨreheinɨ.  
\v 7 Hikɨ tɨriku tenehɨatɨwekaitɨni mɨrati'uximayatsiwatsie. Yapauka ne nemenahɨa 'akaniutakeni, xemeta xemenahɨaxɨa 'auriena 'u'axɨaka hɨxiena kaniukahɨxima'uni.   
\p
\v 8 'Iwamama mekanita'eiya:  
\p —Mɨpaɨ xɨari pepɨtiku'eriwa, 'ekɨ petatita'aitɨanike pepɨ'a'erie petatsitanɨ'anike.  
\p Hikɨ matsi waɨkawa mekaniuyeha'ani heinɨtsika hepaɨtsita mɨtiwarutaxatɨakɨ.   
\p
\v 9 Merikɨtsɨ hutarieka katiniuheinɨni, tawarita katiniwarutaxatɨani. Mɨpaɨ katiniwarutahɨawe:  
\p —Tawarita mɨpaɨ nepɨreheinɨ. Tau, metseri, tamamata heimana xewi xurawetsixi nehɨxie mekaniukahɨxima'uni.   
\p
\v 10 Kepauka mɨpaɨ mɨtiwarutahɨawixɨ, paapaya mɨpaɨ katinitatieni:  
\p —¿Kehepaɨtɨtɨri 'ekɨ pepɨreheinɨ? ¿Kamɨtsɨ ne, 'amaama, 'a'iwama tanaitɨ 'ahɨxie tetekahɨxima'uni?   
\p
\v 11 'Iwamama waɨkawa mepihekakai, paapaya matsi pɨta puyu'iyaritɨakai naime mɨkɨ hepaɨtsita.   
\s1 Kutse 'iwamama kememɨte'itua  
\p
\v 12 Merikɨtsɨ Kutse 'iwamama mekanekɨne, yupaapa muxatsimama metewareumiyuka Tsikeni paitɨ.  
\v 13 Hikɨ 'Ixaheri\f + \fr 37:13 \ft \fq 'Ixaheri\ft  yaxeikɨa panuyɨne \fqa Kakuwu.\f* Kutse mɨpaɨ katiniutahɨawe:  
\p —'A'iwama keniwaxeiyamie, muxatsi memɨwarahɨtɨwetsie Tsikeni paitɨ mepekutei.  
\p Kutse mɨpaɨ katinita'eiya:  
\p —'Aixɨa pɨ'ane.   
\p
\v 14 Tawarita katinitaxatɨani paapaya:  
\p —Naime pepɨnetitaxatɨani 'a'iwama kememɨteheu'erie, meta xɨka muxatsi mewarehɨtɨweni, mɨpaɨ nemɨretimanikɨ hekwamekɨ.  
\p Hikɨ kaneyani. Hewuruni 'uyeyaka Tsikeni neta'ani.  
\v 15 Xewitɨ tewi kanenukunake yeuta 'uyeikakaku kawataxeiyawekaku. Mɨkɨ mɨpaɨ katinita'iwawiya:  
\p —¿Tita petiwaune?   
\p
\v 16 Kutse kanita'eiya:  
\p —Ne'iwama nepɨwawaune. ¿'Ekɨ pekatimate hakewa memɨtehehɨtɨwe?   
\p
\v 17 Mɨkɨ tewi mɨpaɨ katinitaxatɨani:  
\p —Takai 'atupaitɨ mepekɨ, nepɨwaru'eni mɨpaɨ mepɨtekuxatakai kename Rutani kiekariyaritsie meyehukai.  
\p Hikɨ Kutse waruwauximetɨ kaneyani, Rutani 'aurie kaniwarutaxeiya.  
\v 18 Hikɨ 'iwamama mekanixeiya 'ateewa 'amiekaku kuxi. Mexi kata'awekai mekaniuyu'enieni kememɨte'imienikɨ.  
\v 19 Mɨpaɨ meteniyukuxaxatɨwakaitɨni yuxexuitɨ:  
\p —Mana pamie mɨtiheinɨwe.  
\v 20 Hikɨrixɨa tukarieya kanaye'ani. Tekanimiekuni xeime putsu muyewakita tekaneikahɨakuni, mɨpaɨ tekanetiyuakuni kename tiyukwa'ame 'itakwai. Mɨpaɨ tepɨtehetimani xɨka 'aku heinɨtsieya yuritɨni.   
\p
\v 21 Hikɨ kepauka Xuweni mɨwaru'eni yu'iwama, yu'iwatsie tanuanike memɨka'ikumemiwanikɨ, mɨpaɨ katiniwarutahɨawe:  
\p —Matsi tepɨka'ikumemiwani.  
\v 22 Putsu muyewakita xeikɨa xekeneukahɨwa makumawetsie, xepɨka'ikumemiwani, xepɨkate'ikwinitɨaka.  
\p Xuweni mɨpaɨ pɨtiwarutahɨawixɨ 'arike Kutse watihanake 'iyetuanike paapaya hetsɨa.   
\p
\v 23 Kepauka Kutse yu'iwama wahetsɨa muta'a, mekaniwiya kamixaya witsimɨ'ane 'amɨmamatetɨtɨ mekaniutatsana.  
\v 24 'Anari meheihanaka putsu muyewakita mekaneikahɨani.  
\v 25 Hikɨ mekateniukwani. Yareutewikaku mekaniwaruxeiya harerutsixi tenawemete 'itsimaheritsixi teɨteriyari, Karaha memayenexɨa. Kameyutsixi wahetsie mepɨte'a'ikatakai witsimu'ɨa waritsamu mixaxi\f + \fr 37:25 \ft \fq waritsamu mixaxi\ft . 'Ɨkwa tsuayari witsimu'ɨa.\f* meheituanike 'Ekipitu.  
\v 26 Merikɨtsɨ Kura mɨpaɨ katiniwarutahɨawe yu'iwama:  
\p —¿Tita teteha'iwa xɨka ta'iwa te'umieni 'atsiteka'utiyuani?  
\v 27 Matsi 'aixɨa katiyɨni 'itsimaheritsixi teɨteriyari xɨka tewarutuirieni muta'iwakɨ.  
\p 'Iwamama yamepɨte'utanaki'eri kemainekai,  
\v 28 'ayumieme kepauka wahetsɨa memu'axɨa harerutsixi mariyanitsixi, yu'iwa Kutse putsuta mekanewatihana 'itsimaheritsixi mekaniwarutuirieni xeitewiyari pɨrata tuminiyarikɨ. Mɨpaɨ tiunanaiyaka 'Ekipitu kanewitɨkieni Kutse.   
\p
\v 29 Hikɨ Xuweni nuaka putsu muyewakita, yu'iwa kaniwatihanakekaitɨni. Meukanierixɨ Kutse puyemawekai. Hikɨ yukamixa neukatsana, mɨpaɨ mɨtimatsiɨkɨnikɨ kename yuhiwerie waɨkawa.  
\v 30 Hikɨ yu'iwama wahetsɨa kaneyani mɨpaɨ katiniwaretahɨawe:  
\p —Temaikɨ peuyemawe. Hikɨta, ¿keri nehaineni?   
\p
\v 31 Hikɨ Kutse kamixaya me'utihurieka, tsipu me'umieka mekanitaxurimani.  
\v 32 Hikɨ hipame mekaniwarenɨ'ani kamixa me'ahuriekame yupaapa hetsɨa, mɨpaɨ memɨteheitahɨawekɨ: «'Ikɨ 'aniwe katikamixaya tekaneitaxeiya».   
\p
\v 33 Kepauka Kakuwu kamixa metima mɨpaɨ kaniutayɨni: «Mɨkɨ pɨhɨkɨ neniwe kamixaya. Kauka tiyukwa'ame neitakwai».  
\v 34 Hikɨ Kakuwu hiwerikakɨ yukamixa kaneukatsana, mɨyuhiwerie hepaɨ katiniuyukemaritɨani, mɨixa pɨyuhiweriekai yuniwekɨ.  
\v 35 Hikɨ yunaitɨ niwemama mekanikɨnɨtɨwakaitɨni peru mɨkɨ pɨkayɨnɨtɨarinɨakai mɨpaɨ 'utaitɨ: «Hawaikɨ, ne nepɨkahetɨmaiya hetsɨana neheta'ameke mɨkite watsata». Mɨpaɨ 'utaitɨ pɨkatihayewakai yuhiwerietɨ Kutse ha'eriwatɨ.   
\p
\v 36 Merikɨtsɨ harerutsixi mariyanitsixi Kutse mekaniutuani, 'Ekipitu paitɨ Putipaxi hetsɨa, Parahuni parewiwameya kaninaneni kuyaxi wa'ukiyari mɨtiwa'aitɨwametɨkai.   
\c 38  
\s1 Kura Tamaxi matɨa  
\p
\v 1 Merikɨtsɨ Kura yu'iwama waruku'eirieka kaneyani xaɨtsie paitɨ. Xeime kie kaniutayerɨni Hiraxi titewakame hetsɨa, 'Arurani kiekame hetsɨa.  
\v 2 Mana Kura 'uka kaniutiwitɨni Tsua titewakame niweya kananeu tewiyari. Kepauka hamatɨana mukahui  
\v 3 mɨkɨ kaniutihukata 'ukitɨme kaniutiniweni, 'Exi katiniterɨwa.  
\v 4 'Ariketa hutarieka kaniutihukata 'ukitɨmetsiere kaniutiniweni, 'Unani katiniterɨwa.  
\v 5 Tawarita 'arike xeime nunutsi mekanayexeiya 'ukitɨme, Ketsiwi kiekariyaritsie mutinuiwaxɨ, Tseraxi katiniterɨwa.   
\p
\v 6 Hikɨ Kura 'uka kaniutawauni Tamaxi titewakame 'Exi, yuniwe 'amɨyumate hetsiemieme.  
\v 7 Matsi Yawé pɨka'inakixɨ Kura nu'aya kemɨtiyurienekai, kaninawairieni tukarieya.  
\v 8 Hikɨ Kura yuniwe 'Unani mɨpaɨ katiniutahɨawe: «'A'iwa wiuraya keneutiwitɨki, 'aitsika kemaine kwetsikatsiemieme kenaye'atɨa, mɨpaɨ 'amatsika niweya payeneni».  
\v 9 Perutsɨ 'Unani pɨtimaikai nu'aya mɨtinuiwakekai nu'aya pɨka'ayanikekai. 'Ayumieme kepauka mikumaɨwakai puyu'ɨwiyakai 'ɨyaya mɨkatihukatanikɨ. Mɨpaɨ pɨtiyurienekai matsikaya nu'aya mɨkatinuiwakɨ.  
\v 10 Hikɨ Yawé pɨka'inakixɨ mɨyamɨtiyurienekaikɨ, 'ayumieme yaxeikɨa kanimieni.  
\v 11 Merikɨte Kura yumu'e mɨpaɨ pɨtiutahɨawixɨ: «'Apaapa kie pewiuratɨtɨ kene'ahayewani, kepaukake neniwe Tseraxi 'amuyutamani». Peru Kura mɨpaɨ pɨtiku'eriwakai Tseraxi mɨnike pɨ'eriekai, yumatsikama wahepaɨ. Hikɨ Tamaxi kaneyani yupaapa kie mekanikɨ.   
\p
\v 12 Hikɨ mɨixa tukari 'anuyeyaku Kura 'ɨyaya kaniumɨnita Tsua niweya. Hikɨ hiwerika hatɨmaiyaka, kaneyani Kura Timinati kiekariyaritsie yumuxatsi waretixinike. Hamikuya kaneiweiya Hiraxi mɨtitewa 'Arurani kiekame.  
\v 13 Kepauka Tamaxi mɨretima kename mu'eya Timinati heyakai yumuxatsima wareuximieka,  
\v 14 wiura kamixayari kananutihɨna, yɨhɨxie kaneuyukunani kapa xewitɨ heitimanikɨ, kiekari 'Enahini manuyeniere mɨranuyekɨkatɨretsie kanayerɨni, Timinati huyeyari manuyehane kiekari mukumatsie. Mɨpaɨ kaniuyɨni, mɨpaɨ mɨtimaikaikɨ Tseraxi 'amuyumaikaikɨri memɨka'iwitɨtɨawekaiku kɨnaya mayanikɨ.   
\p
\v 15 Kepauka Kura heuyuku'eimame muxei, 'uka tuminikɨ muyumayɨinɨa kani'eriekaitɨni.  
\v 16 Yumu'e ka'erietɨ hepana kaneyani, mɨpaɨ katinitahɨawe:  
\p —'Ahamatɨa nepɨkahuni pekati'awaɨriya.  
\p 'Uka mɨpaɨ katinita'iwawiya:  
\p —¿Tita penetipitɨani, xɨka ne'unewaɨriya?   
\p
\v 17 Kura mɨpaɨ katinita'eiya:  
\p —Xeime tsipu nunutsi nepɨmatsihanɨ'airieni nekuraruta mieme.  
\p 'Ukata mɨpaɨ katinitahɨawe:  
\p —'Aixɨa kani'aneni. Peru hikɨ mexixi tixaɨtɨ kenetineupitɨa yanemɨtimaikakɨ kename 'aku penetipitɨani.   
\p
\v 18 Kura mɨpaɨ katinita'iwawiya:  
\p —¿Ketitakuta pereuyehɨwa nemɨreukapine?  
\p Tamaxi mɨpaɨ katinita'eiya:  
\p —Kena 'atseyu wiwierimakame meta 'a'itsɨ pemakwe'e.  
\p Kura katiniyetuirieni, hamatɨana kaniukahuni, mɨkɨ kanitihukatɨani.  
\v 19 Tamaxi kepauka manukuke kaneyani yapauka, yuhɨxie meuyukunakai kaneuyukuyepieni, wiura kamixayari kananakatɨni.   
\p
\v 20 'Ariketa Kura tsipu kanenɨ'ani, yuhamiku 'Arurani kiekame kaniutanɨ'ani mɨrewayepinikɨ tita mɨreku'eiriekai, hikɨ hamikuya 'uka pɨkahetaxei.  
\v 21 Merikɨte teɨteri mana kiekatari kaniwaruta'iwawiya:  
\p —¿Hakewari 'uka tuminikɨ muyumayɨinɨa 'Enahini kiekame huye tetsita mutiyeixakai?  
\p Mɨkɨ mɨpaɨ mekatenita'eiya:  
\p —'Ena 'ukaratsi muyumayɨinɨa mɨtiwawa yukakaɨyarixi wahetsiemieme matsi pumawe.   
\p
\v 22 Hamikuya kanakunuani hakewa Kura meyeikakai, mɨpaɨ katinitahɨawe:  
\p —Nepɨkaheitaxei. Teɨteri mana kiekatari mɨpaɨ mekanaitɨkani, kename mana 'umawe 'ukaratsi mɨpaɨ tiuka'iyaritɨ.   
\p
\v 23 Kura mɨpaɨ kaniutayɨni:  
\p —Tsepa mɨrepi nepiinite, ne nepɨkatiu'ita. Heitseriemekɨ pɨtihekɨa teɨteri 'axamemɨkahaitɨkanikɨ nehepaɨtsita: Ne nepeinɨ'airi tsipu, 'ekɨta pepɨkaheitaxei.   
\p
\v 24 Haika metseri 'anukayaku, Kura mɨpaɨ katiniutahɨawarieni:  
\p —'Amu'e Tamaxi tuminikɨ muyumayɨinɨa kanayuyeitɨani, mɨyayɨanetɨ kaniutihukata.  
\p Kura mɨpaɨ karima kaniutayɨni:  
\p —Xekenewayehani xekenetataiya.   
\p
\v 25 Hikɨ kepauka mɨwayehaniwakai yumu'e hetsɨa xeime kanenɨ'ani mɨpaɨ haineme: «'Ikɨ piinite kutsiyari pɨnetsi'utihukatɨa. Heiwatɨ peheitimani kemɨ'ane 'ikɨ tseyu yuwiwierimakame mukutsiyarieya meta 'ikɨ 'itsɨ».   
\p
\v 26 Kura retimaika mɨpaɨ kaniutayɨni: «Ne kenemɨtikamie, matsi mɨkɨ 'aixɨa katinikamieni, ne neniwe Tseraxi nemɨka'iwitɨtɨakɨ». Peru tawarita hamatɨana pɨka'ukahui.   
\p
\v 27 Kepauka maye'a mɨtiniwekɨ Tamaxi, yuhutame kaniwarayexeiya.  
\v 28 Xewitɨ katinuiwawetɨ 'akuxi, mamaya meri kananeni, hikɨ 'ukaratsi tiniweritsitɨwame, wita xetame mamayatsie kaneitapirieni, mɨpaɨ kaniutayɨni: «'Ikɨ meri kaniutinuiwa».  
\v 29 Hikɨ nunutsi yumama kaneutahana, xewitɨ pɨta meri kaniutinuiwa 'iwaya. Hikɨ 'ukaratsi tiniweritsitɨwame mɨpaɨ kaniutayɨni: «Kehepaɨ peretɨa». 'Ayumieme Paretsi mepɨte'iterɨwaxɨ.  
\v 30 Mɨkɨ 'utɨaketa 'iwaya kaniutinuiwa, yumamatsie wita xetame meutapiekai, mɨkɨ Tsera mekateniterɨwa.   
\c 39  
\s1 Kutse Putipaxi 'ɨyaya hamatɨa  
\p
\v 1 Merikɨtsɨ kepauka mewitɨkie Kutse 'Ekipitu, 'Itsimaheri nuiwarimama mekanituani Putipaxi hetsɨa, xeime 'ekipitutanaka Parahuni parewiwameya kuyaxi wa'ukiyari hetsɨa.  
\v 2 Hikɨ matsi Kutse 'aixɨa katini'uximayakaitɨni Yawé 'iparewiekaku. Kepauka 'ekipitutanaka ti'aitɨwameya hetsɨa mayekatei,  
\v 3 mɨkɨ mɨpaɨ pɨretima Yawé miparewiekaikɨ waɨkawa 'aixɨa mɨtiyurienenikɨ.  
\v 4 Hikɨ Putipaxi Kutse 'aixɨa katiniumani 'aixɨa mɨtiuka'iyarikaikɨ, 'ayumieme katinihɨritɨani naime yupiinite meta kiena mɨti'aitanikɨ kanipitɨani.  
\v 5 'Ekipitutanaka kepauka Kutse mɨtiɨhɨritɨa yukie timieme, Yawé 'aixɨa katiniyuriekaitɨni 'ekipitutanaka Putipaxi tita mɨrexeiyakai hetsiemieme takwana timieme meta kiita.  
\v 6 'Ayumieme Putipaxi matsi Kutse naime katiniuhɨritɨani, tixaɨtɨkɨ pɨkatiyu'iyaritɨakai pɨtiutikwa'akai xeikɨa.  
\p Kutse matsi witsipɨtiyuxexeiyakai pɨtemaikɨtɨkai.  
\v 7 Hikɨ 'arikeke ti'aitɨwameya 'ɨyaya kanitixeiyatɨyani 'ihiwe'erietɨ, mɨpaɨ katinitahɨawe:  
\p —Nehamatɨa keneukahu'i.   
\p
\v 8 Kutse kayuwaɨriyatɨ, mɨpaɨ katinitahɨawe:  
\p —Neuxei 'ukaratsi: neti'aitɨwame netsinaki'erietɨ pɨnetiuhɨritɨa, yupiinite yukie timieme naime mɨkareukweriwayuriekakɨ.  
\v 9 'Ikɨ kiita xewitɨ pumawe 'aixɨa tiuka'iyaritɨ mɨhɨritɨariekakɨ nehepaɨ. Neti'aitɨwame tixaɨtɨ pɨkanetikweririe. 'Ekɨ pemɨ'ɨyaya, xɨka nematsi'ukumayɨani, 'axanepɨtiyurieni Kakaɨyari hɨxie.   
\p
\v 10 Matsi mɨkɨ tukarikɨ nikuxeiyanekaitɨni yaxeikɨa tikɨhɨawetɨ. Peru Kutse kaniyuku'imawakaitɨni.   
\p
\v 11 Merikɨtsɨ xeime tukaritsie, kiita Kutse kaneutahani yukuha'aritɨanike kemɨtihɨritɨariekai, mexi me'uyemawekai te'uximayatamete hipatɨ.  
\v 12 Hikɨ Putipaxi 'ɨyaya manayuku'eimatsie kanikawiere. Mɨpaɨ katinitahɨawe: «Nehamatɨarikɨ keneukahu'i».  
\p Perutsɨ Kutse manayuku'eimakai 'uku'eirieka takwa kananuyeyani.  
\v 13 'Ukaratsi 'ixuriki 'uxeiyaka Kutse miku'eiriekai,  
\v 14 kiita te'uximayatamete kaniwarutahiwieni, mɨpaɨ katiniwarutahɨawe: «Neuxei, nekɨna 'ikɨ hepɨrayu tewiyari mɨtatsi'atɨiri, mɨtatsinanaimanikɨ xeikɨa punua. Nekiita 'atahaka nehamatɨa puhuimɨkɨkai, peru ne karima neputahiwaxɨ.  
\v 15 Kepauka ne'utahiwakaku mɨnetsi'u'eni kaniuyuta'una, yu'ixuriki 'uku'eirieka ne'aurie».   
\p
\v 16 Hikɨ 'ukaratsi Kutse 'ixurikieya kaniuti'uta, yukɨna mɨtitaxatɨanikɨ nuayuke.  
\v 17 Kepauka kɨnaya munua, yaxeikɨa kaniutayɨni: «Hepɨrayu tewiyari pemɨ'atɨa nehamatɨa puhuimɨkɨkai.  
\v 18 Peru ne kepauka karima nemutahiwaxɨ, kananuyenautsa yu'ixuriki 'uku'eirieka ne'aurie».   
\p
\v 19 Hikɨ Putipaxi yu'ɨya 'u'enieka, waɨkawa kaniuyeha'ani.  
\v 20 'Anari katiniuta'aita Kutse manutahɨiyanikɨ katsariyanata, Parahuni pɨretsutsiximama memanutaxɨriwatsie.  
\p Matsi tsepa manutahɨiyakai  
\v 21 Yawé Kutse pɨka'uku'eiri 'aixɨa katiniparewiekaitɨni. Yakatiniuyurieni 'aixɨa mɨtixeiyakɨ katsariyanata mɨtihɨritɨarie,  
\v 22 hikɨ mɨkɨ Kutse kaniuhɨritɨani memanutaxɨriya muwaxeiyanikɨ meta mɨti'aitanikɨ muwa.  
\v 23 Yawé Kutse miparewiekaikɨ kemɨtiyurienekai naitɨ 'aixɨa pɨtikuyɨnekai, katsariyana hɨritɨariekame pɨkareukweriwayuriekairi, Kutse mɨtiuhɨritɨakaikɨ naime.   
\c 40  
\s1 Kutse heinɨtsi kemɨtitahekɨata  
\p
\v 1 Merikɨtsɨ mɨixa tukari 'anukayaku, Parahuni tekɨxi memikuhanitɨwa winu 'uyemakame tiwa'aitɨwame, meta paa wewiwamete tiwa'aitɨwame, 'Ekipitu kwieyaritsie ti'aitame hetsiemieme memɨte'uximayakai 'axamekateniuyurieni.  
\v 2 Hikɨ kaniuyeha'ani ti'aitame Parahuni, mɨkɨ yuhutame wahetsiemieme hetsɨana te'uximayatamete, tekɨxi hanamete wa'ukiyari, meta paa wewiwamete wa'ukiyari.  
\v 3 'Ayumieme kaniwarenɨ'ani kuyaxi wa'ukiyari hetsɨa katsariyana mexeiyakaikɨ, mɨkɨ katsariyana Kutse muwayewekaitsie pɨhɨkɨtɨkai.  
\v 4 Muwa Kutse puhɨritɨariekai mɨwa'ɨwiyanikɨ, kuyaxi wa'ukiyari tawarita yuhutame pihɨritɨa.  
\p Mɨixa tukari me'aye'utɨ katsariyanata,  
\v 5 tɨkarikɨ mekateniuheinɨni, 'ikɨ yuhutatɨ te'uximayatamete, tekɨxi winu muyema 'uitɨwamete tiwa'aitɨwame, paa wewiwamete tiwa'aitɨwame, yuxexuitɨ mepɨte'uheinɨxɨa, yaxeikɨa ka'anuyɨtɨkaime.  
\v 6 'Ukatareku ximeri, kepauka Kutse mɨwarekuxei me'iyarixietɨkaime kaniwarutaxeiya.  
\v 7 'Ayumieme pɨwaruta'iwawiyaxɨ:  
\p —¿Titayari xetenututuixie?   
\p
\v 8 Mɨkɨ mɨpaɨ mekatenitahɨawe:  
\p —Tame hikɨ tepɨte'uheinɨxɨa, pumawe mɨtatsitahekɨatɨani.  
\p Kutse mɨpaɨ katiniwarutahɨawe:  
\p —Kakaɨyari kaniyɨweni mitahekɨata. Tsiparatsɨ xekeneneutaxatɨa kexemɨte'uheinɨ.   
\p
\v 9 Hikɨ tekɨxi 'uitɨwamete wa'ukiyari Kutse katiniutaxatɨani kemɨtiuheinɨkai, mɨpaɨ katinitsutɨani:  
\p —Mɨpaɨ nepɨtiuheinɨ, nehɨxie kaxie puwekai,  
\v 10 'anutahaikatɨ. Mɨkɨ kaxie kepauka mutayɨraxɨ kaniukaxutuni, yapauka 'ukayaxeka takari kaniutikwani.  
\v 11 Ne, nemamatsie nepehanakai Parahuni ti'aitame tekɨxieya. Hikɨ kaxie takari ne'aka'inɨka tekɨxita nepeikapɨnaxɨ, mɨkɨ tekɨxi Parahuni mamayatsie nepeke.   
\p
\v 12 Kutse mɨpaɨ katinitahɨawe:  
\p —Kepemɨtiuheinɨ mɨpaɨ pɨtimatsiɨkɨ: Kaxie manuhaika, haika tukari pɨ'inɨariyari.  
\v 13 Haika tukari 'anukayayu, Parahuni ti'aitame tawarita peiti'erieni kepemɨreyuri, hekwamekɨ matsihepitɨani pemɨtita'uximayatakɨ hetsɨana meripai hepaɨ. Hikɨ Parahuni ti'aitame tekɨxieya kaxie takari hayari muyema hekwamekɨ mamayatsie penekemɨkɨ, meripai pemɨtiyurienekai hepaɨ.  
\v 14 Ne, nepɨmatsiwawirie waɨkawa pepɨkanetsihatɨtɨmaiyani, kepauka 'aixɨa mɨreyɨni kenemaine, Parahuni ti'aitame nehetsiemieme ketinetaxatɨa, 'uwa nemɨka'ayewenikɨ.  
\v 15 Hepɨrayutsixi takwieyaritsie paitɨ waɨriyarika nepeyehanie 'ena nepɨ'atɨarie, tixaɨtɨ 'atsinekareyurieka 'uwa nepayewe.   
\p
\v 16 Paa wewiwamete wa'ukiyari 'u'enaka, 'iwaya 'aixɨa mɨti'ane hetsiemieme mɨtiutahekɨatɨariekɨ, mɨpaɨ Kutse katiniutahɨawe:  
\p —Neta mɨpaɨ nepɨtiuheinɨ. Nemu'utsie haika tsikɨiwitiyari paa nepanamanakai,  
\v 17 tsikɨiwiti mutinatɨtsie yutsata paa witsimɨ'anene pɨyemanekai, Parahuni ti'aitame hetsiemieme. Hikɨ maraikatsixi mepɨ'axekai me'itikwanike tsikɨiwititsie nemenamanakai.   
\p
\v 18 Kutse kanita'eiya:  
\p —Kepemɨtiuheinɨ mɨpaɨ pɨti'inɨariyari: Haika tsikɨiwitiyari pɨ'inɨariyari haika tukari.  
\v 19 Haika tukari 'anukayayu, Parahuni ti'aitame pɨmatsita'aita, 'amu'u manutiwitekienikɨ, kɨyetsie pemɨkaxuiyanikɨ, 'ana maraikatsixi 'awaiyari mepɨtakwani.   
\p
\v 20 Hikɨ haika tukari 'anukayaku, Parahuni ti'aitame yutukari kaniuwewieni yuhetsɨamiemete wahetsiemieme. Hikɨ mɨkɨ yunaime wahɨxie katiniuta'aita memanutaxɨriyakai memɨwayehapanienikɨ, tekɨxi 'uitɨwamete tiwa'aitɨwame, paa wewiwamete tiwa'aitɨwame.  
\v 21 Tekɨxi 'uitɨwamete tiwa'aitɨwame, hekwamekɨ kaniupitɨarieni mɨtita'uximayatakɨ hetsɨana, mɨpaɨ mɨkɨ katininuani Parahuni ti'aitame mamayatsie tekɨxieya mikuhanitɨwanikɨ meripai hepaɨ.  
\v 22 Paa wewiwameta kaniuta'aita kɨyetsie mɨmierienikɨ, Kutse kemɨtiwaruhekɨatɨakai mɨpaɨ katiniuyɨni.  
\v 23 'Ana tekɨxi kaxie hayari muyema 'uitɨwamete tiwa'aitɨwame, Kutse kemɨrehɨawekai pɨkaheye'eri, yuheyemekɨ katinatɨmaiya.   
\c 41  
\s1 Parahuni heinɨtsikateya  
\p
\v 1 Merikɨtsɨ huta wiyari 'anukayaku, Parahuni mɨpaɨ katiniuheinɨni: Niru hatuxameyari tetsita kaniuwekaitɨni.  
\v 2 Yapauka hapa mekanatinexɨani, 'atahuta meyupaɨmetɨ wakaitsixi mewaiyatɨkaitɨ, mekatenikwatɨwekaitɨni makutsiɨraɨyetsie.  
\v 3 Hikɨ wa'utɨmata mekanatinexɨani, wahepaɨ meyupaɨmetɨ, mewawakitɨ 'axameteyuxexeiyatɨ, mana mekaniti'uni memɨwaiyatɨka wa'aurie Niru hatetsitayaritsie.  
\v 4 Wakaitsixi memɨwawaki mekaniwarutikwani memɨwaiyatɨka.  
\p 'Anari Parahuni kananutaniere.  
\v 5 Hutariekata kaneukuni. 'Ana tawarita pɨtiuheinɨ. Tɨriku xeikɨyeyaritsie 'uye'ukame puxei kɨkɨreme witsi'aneneme.  
\v 6 'Utɨmanata kanixeiya, hepaɨna paɨmeme wawakime 'eka mɨxɨkakɨ.  
\v 7 'Atahuta tɨriku mɨwawaki kanitikwani tɨriku mɨkɨkɨre witsimɨ'anene.  
\p 'Ana Parahuni kananutaniere, mɨpaɨ retimaika mɨheinɨtsikatɨkaikɨ.  
\v 8 Nutuixietɨ yu'iyaritɨatɨ ximeri kananukukeni. Katiniwarutanɨ'airieni 'awie temaiwawemete 'ekipitutari. Katiniwarutaxatɨani kemɨtiuheinɨ, peru nixewitɨ pɨka'itahekɨatɨa heinɨtsikaya.  
\v 9 Hikɨ tewi tekɨxi 'uitɨwamete mɨtiwa'aitɨa, mɨpaɨ Parahuni katiniutahɨawe: «Neuxei, nepaye'eri ke'axanemɨtiuyuri.  
\v 10 Kepauka Parahuni muyeha'a teyu'uximayatsiriwamete wahekɨ, kuyaxi mɨtiwa'aitɨa katananutaxɨrieni ne meta paa wewiwame.  
\v 11 Xeime tɨkaritsie taxexuitɨ tepɨte'uheinɨ, xexuitɨ peixeiyakai heinɨtsika kemɨti'ayumiemetɨkai.  
\v 12 Hikɨ xewitɨ tahamatɨa payekatei, temaikɨtɨtɨ Hepɨrayu tewiyari kuyaxi mɨtiwa'aitɨa mɨparewiekai. Tepitaxatɨa ketemɨte'uheinɨ. Mɨkɨ pɨtatsi'utahekɨatɨa xexuime.  
\v 13 Naitɨ yapɨraye'a mɨkɨ kemɨtatiutaxatɨa. Ne hutarieka nepuhɨritɨarie ne'uximayatsika, xewitɨta pumierie kɨyetsie».   
\p
\v 14 Hikɨ ti'aitame Kutse katiniutanɨ'airieni. 'Ana kwitɨ kaniwayexɨnarieni katsariyanata. Kwitɨ 'uyutikemaritɨaka, kaninuani Parahuni hɨxie.  
\v 15 Ti'aitame mɨpaɨ katinitaxatɨani:  
\p —Ne nepɨtiuheinɨ, xewitɨ pɨka'ihekɨatawe. Peru xewitɨ pɨnetiutaxatɨa, kename 'ekɨ peyɨwe pemitahekɨata heinɨtsi.   
\p
\v 16 Hikɨ Kutse kanita'eiya:  
\p —Ne nepɨkahɨkɨ. Kakaɨyari kanihɨkɨtɨni mitahekɨata.   
\p
\v 17 Hikɨ ti'aitame Parahuni Kutse mɨpaɨ katiniutaxatɨani:  
\p —Neheinɨtsita, Niru hatuxameyari tetsita nepuwekai.  
\v 18 Hikɨ yapauka hapa mekanatinexɨani, 'atahuta meyɨpaɨmetɨ wakaitsixi mewaiyatɨkaitɨ, witsime'anenetɨ 'ɨxapa mekatenikwatɨwekaitɨni.  
\v 19 Yapaukata wa'utɨma mekanatinexɨani wahepaɨ meyupaɨmetɨ, mewawakitɨ 'axameteyuxexeiyatɨ. Hatsuaku kenemɨkatiwaxeiyawekai mɨpaɨ me'aneneme 'Ekipitutsie.  
\v 20 Kwitɨwata 'atahuta wakaitsixi memɨwawaki, mekaniwarutikwani memɨwaiyatɨka.  
\v 21 Tsepa memɨwarutikwakai, yaxeikɨa mepɨtewawakikai. 'Ana nepanutanierixɨ.   
\p
\v 22 »Hutariekata nepɨtiuheinɨ, 'atahutame nepuxei tɨriku mɨayeyari kɨkɨreme witsi'aneneme, pɨwawerekai xeikɨyeyaritsie tiwiyatɨ.  
\v 23 'Utɨmanata nepixei, hepaɨna paɨmeme tɨriku wawakime 'eka mɨxɨkakɨ.  
\v 24 Tɨriku mɨwawaki 'aixɨa mɨ'anene kaniutikwani. 'Ikɨ naime nepɨwarutaxatɨa 'awie temaiwawemete peru nixewitɨ pɨkanetsi'utahekɨatɨa».   
\p
\v 25 Hikɨ Kutse kanitahekɨatɨani naime kemɨtiuheinɨkai Parahuni. Mɨpaɨ kaniutayɨni:  
\p —Puyuxewitɨtɨ kepemɨtiuheinɨ. Kakaɨyari kanihɨkɨtɨni mɨmatiutahekɨatɨa kemɨtiyɨni.  
\v 26 Mɨkɨ matsi 'atahuta wakaitsixi memɨwaiyatɨka, yaxeikɨa tɨriku mɨkɨkɨre, mɨkɨ 'atahuta wiyari pɨ'inɨariyari. Mɨkɨ puyuxewi heinɨtsika.  
\v 27 Wakaitsixi 'atahuta memɨwawaki 'axamemɨ'anene, memɨwaiyatɨka wa'utɨa mematinexɨa, meta 'atahuta tɨriku 'etsimɨpepe mɨwawaki 'eka mɨxɨkakɨ, mɨkɨta pɨhɨkɨ 'atahuta wiyari. Mɨpaɨ paɨmexa haakaxa payani.   
\p
\v 28 »Kenemɨmarahɨawe Parahuni, yurikɨ Kakaɨyari kemɨmatihekɨatɨa, pɨtihekɨata kemɨtiyurieni.  
\v 29 'Anari kanaye'amɨkɨ, 'atahuta wiyari waɨkawa mɨtitixuawere 'Ekipitu kwieyaritsie.  
\v 30 Hepaɨna paɨmetɨ mahu, haakaxa payani, 'anari pɨkatitixuawere, mepɨtehatɨmaiyani waɨkawa kememɨtehexeiyakai meripaitɨ mɨkɨ kwieyaritsie.  
\v 31 Yemekɨ waɨkawa haakaxa payani keyamɨkatiyɨwekai meripaitɨ.  
\v 32 'Ekɨ Parahuni hutame pemuheinɨ, Kakaɨyari puyumexɨitɨa kwitɨwa mɨpaɨ mɨtiyurienikɨ.   
\p
\v 33 »'Ayumieme, hikɨ Parahuni xeime keneutiwawa waɨkawa yɨweme, timaiweme, pemihɨritɨanikɨ 'Ekipitu kwieyari hepaɨtsita.  
\v 34 'Ekɨ Parahuni mɨpaɨ ketineuyuri, keniwarutihɨawi nenieremete naitsarie 'Ekipitu, 'atahuta wiyari waɨkawa mɨtitixuawere 'itsanari 'auxɨwimexɨa tixeɨriekame, xeime xemɨti'utakɨ Parahuni hetsiemieme, naitsarie 'akwiepa.  
\v 35 'Ekɨ Parahuni peti'aitakaku, mɨkɨ nenieremete meke'ikuxeɨrieni 'ikwai 'aixɨa mɨtixuaweretsie mieme, meke'iti'uta naitsarie kiekaritetsie, 'ikwai xemexeiyanikɨ mɨtiumawenitsie.  
\v 36 Mɨkɨ 'ikwai mɨti'utsieni 'Ekipitutsie mieme payani, 'atahuta wiyari mɨhaakaxatɨnitsie, mɨpaɨ teɨteri mɨkɨ kwieyaritsie haakakɨ mepɨkakwini».   
\p
\v 37 Hikɨ Parahuni 'iyarieya 'aixɨa kaniuyɨni Kutse kemɨtitahekɨatɨa, yaxeikɨata 'iparewiwametemama.  
\v 38 Hikɨ Parahuni mɨpaɨ katiniwaruta'iwawiya memiparewiekai:  
\p —Kamɨtsɨ hakewa tepeikaxeiya xeime 'ikɨ hepaɨ 'anekame, Kakaɨyari 'iyarieya hexeiyame.   
\p
\v 39 Hikɨ ti'aitame Kutse mɨpaɨ katiniutahɨawe:  
\p —Mɨpaɨ nepɨretima Kakaɨyari pɨmatihekɨatɨa 'ikɨ naime, xewitɨ pumawe yɨwetɨ, timaiwetɨ, 'ahepaɨ.  
\v 40 'Ekɨ nepɨmatsihɨritɨani nemɨra'aitatsie, neteɨterima yamepɨtekakɨne 'ekɨ petiwa'aitɨakaku. Ne xeikɨa matsi nemɨmariwe nepɨhɨkɨtɨni, nemɨti'aitamekɨ.   
\s1 Kutse kemɨti'aitakai 'Ekipitu kwieyaritsie  
\p
\v 41 Hikɨ Parahuni mɨpaɨ Kutse katiniutaxatɨani:  
\p —Hikɨ ne nepumatsihɨritɨa 'Ekipitu kwieyari naime.   
\p
\v 42 'Ana kwitɨwa Parahuni yuhanira 'anutihɨnaka Kutse 'itɨwameyatsie kanekamanirieni, katiniuta'aita memenakatɨtɨanikɨ kamixa witsimɨ'ane meta huru kukayari mepetitɨtɨa kɨipitɨana.  
\v 43 Hikɨ yuparewiwame kaxetayatsie kanenutiyeni, teparewiwamete me'utihiwakaku ya'ane mewapitɨakaku yunaitɨ mekaniukatunuma'uwekaitɨni hɨxiena. Kanihɨritɨani 'Ekipitu kwieyaritsie naime.   
\p
\v 44 Hikɨ Parahuni mɨpaɨ katinitahɨawe:  
\p —Ne ti'aitame Parahuni nepɨhɨkɨ, peru xewitɨ 'Ekipitutsie yapɨkatiyurieni 'ekɨ yapekahainekaku.   
\p
\v 45 Hikɨ kanipata kemɨtitewakai, Tsapenati-Paneha katiniterɨwa. 'Uka kaniwitɨtɨani 'Atsenati titewakame, Putipera niweya mawari wewiwame 'Uni kiekame. Mɨpaɨ katinanukakeni Kutse 'Ekipitu ti'aitatɨ.  
\v 46 Xeitewiyari heimana tamamata kanihɨkaitɨni Kutse kepauka mɨtiukatsutɨa ti'uximayatɨ ti'aitame tsiemieme.  
\p Kutse Parahuni hɨxie kaniutateuta, kaneyani 'Ekipitu kwieyaritsie, kanikuniere.  
\v 47 Mɨkɨ 'atahuta wiyaritsie 'aixɨa mɨtiwiyekekaitsie, 'ana waɨkawa katiniutixuawere.  
\v 48 Hikɨ Kutse katiniuti'uta naime tikwaiwamete, mɨkɨ 'atahuta wiyaritsie mieme katiniuti'uta kiekaritsie.  
\v 49 Kutse tɨriku puti'utaxɨ xiekari muti'uta hepaɨ, pɨtiyuxexeiyakai mi'inɨatakai pɨtiuhayewaxɨ mɨkayu'inɨatsinɨakaikɨ.   
\p
\v 50 Mexɨakame ka'anuyeyeiwekaku haakaxa wiyari, Kutse tɨɨri yuhutame mepɨwarayexei 'Atsenati matɨa, Putipera mawari wewiwame niweya 'Uni kiekame.  
\v 51 Yumatɨari Manatsexi katiniuterɨwa mɨpaɨ 'utayɨka: «Kakaɨyari pɨtiyuriene nemɨratɨmaiyakɨ naime 'uximatɨarikakɨ nekie hakewa nemetinuiwaxɨ».  
\v 52 Hutarieka mieme 'Epɨrahini pɨtiterɨwaxɨ mɨpaɨ 'utayɨka: «Kakaɨyari pɨnetsi'upitɨa nemɨxiɨkakɨ, 'ikɨ kwieyaritsie hakewa nemɨreka'eniwakai».   
\p
\v 53 Hikɨ 'atahuta wiyari 'aixɨa mɨtiwiyekekaitsie kanaye'ani.  
\v 54 Kutse kemutayɨkai haakaxa kaniuyutsutɨani 'atahuta wiyari, haakaxa kanayani naitsarie kwie mumanetɨkateitsie. 'Ekipitu kwieyaritsie xeikɨa puxuawekai, Kutse mɨtiuta'aitakaikɨ mɨtiti'utsienikɨ.  
\v 55 Kepauka 'ekipitutari memuhaakakwi, teɨteri Parahuni hetsɨa mekaniye'axɨani 'ikwai mete'iwawirietɨ, hikɨ Parahuni mɨpaɨ katiniwarutahɨawe teɨteri 'ekipitutari: «Xekenehu Kutse hetsɨa yaxeketenekakɨni kemetayɨni».   
\p
\v 56 Kepauka yuwaɨkawatɨ memɨyehaakakwitɨwekai, Kutse katineuyepieni tɨriku mɨwa'utɨkaitsie watuirienike 'ekipitutari.  
\v 57 Yaxeikɨata 'ateewa paitɨ meheyekɨkatɨ 'Ekipitu mekani'axekaitɨni, tɨriku mekunanetɨwetɨ Kutse hetsɨa, mɨhaakaxatɨkaikɨ kwinimieme naitsarie kwie kemɨyewa.   
\c 42  
\s1 Kutse 'iwamama 'Ekipitutsie mepekɨ  
\p
\v 1 Merikɨtsɨ Kakuwu kepauka mɨtiutamari, kename tɨriku hexɨawe 'Ekipitu, mɨpaɨ yuniwema katiniwarutahɨawe: «¿Ketitayari mana xetekutei, kwi xeyuxexeiyatɨ xeikɨa?  
\v 2 Mɨpaɨ nekatinimarieka kename tɨriku hexɨawe. Mana xekenehu xekenenanaiyu tahetsimieme temɨkakwinikɨ hakakɨ».   
\p
\v 3 Tamamata meyupaɨmetɨ mekaniyukuha'aritɨani Kutse 'iwamama 'Ekipitu meteheunanaiyuka.  
\v 4 Peru Kakuwu Wenikamini pɨka'upitɨa mɨyemiekɨ Kutse mutaya, mɨpaɨ tiku'eriwatɨ: Nɨkahɨrixɨa mɨwa hemierieni.  
\v 5 Hikɨ 'Ixaheri tɨɨriyamama kepauka memeta'axɨa metetaxɨawienike, matsi naitsarie waɨkawa kanihaakaxatɨkaitɨni, Kanani kwieyaritsie.   
\p
\v 6 Kutse kuwexinaruri pɨhɨkɨtɨkai mɨkɨ kwieyaritsie. Tɨriku mepɨwatuiriekai, naitsarie kiekaritetsie teɨteri memɨ'axekai. Kepauka 'iwamama hetsɨana memu'axɨa, kwiepapai mekaniukahɨxima'uni.  
\v 7 Kutse waruxeiyaka yu'iwama, kaniwaretimani. Perutsɨ mɨkawamateni hepaɨ katiniwarutahɨawe:  
\p —Xemetsɨ, ¿hakewa xepeyekɨ?  
\p Mɨkɨ mɨpaɨ mekatenita'eiya:  
\p —Tame Kanani kwieyaritsie tepeyekɨ tɨriku tepɨkunanetɨwe.   
\p
\v 8 Kutse pɨwaretimaikai, peru mɨkɨ 'iwamama mepɨka'imatekai.  
\v 9 Merikɨ 'ana Kutse kanaye'erieni, kemɨtiuheinɨkai wahetsiemieme. 'Ayumieme mɨpaɨ katiniwarutahɨawe:  
\p —Xemetsɨ 'awie nenieremete xepɨyɨa xetatsihupietɨwetɨ.   
\p
\v 10 Mɨpaɨ mekatenita'eiya:  
\p —Hawaikɨ ti'aitame, matsiparewiwamete tepɨyɨa. Tɨriku tepɨkunanetɨwe xeikɨa.  
\v 11 Tame tepɨxeinuiwari tapaapa puyuxewi, heitseriemekɨ yatepɨtekahu, tepɨka'awienenieremete.   
\p
\v 12 Kutse mɨpaɨ katiniwaruta'eiya:  
\p —Pɨkayuri, xeme kexemutiyuane. Xepɨkunieretɨwe xeikɨa kemɨtiu'ane.   
\p
\v 13 Perutsɨ mɨkɨ tawarita mɨpaɨ mekatenita'eiya:  
\p —Tame, mate'uximayatsiriwamete, tamamata heimana huta tepɨyupaɨmekai, tanaitɨ tapaapa puyuxewi Kanani kwieyaritsie kanekani. Tamuta peyuhayewaxɨ yupaapa hetsɨa, xewitɨri pɨka'uyeika.   
\p
\v 14 Merikɨtsɨ Kutse tawarita mɨpaɨ katiniwarutahɨawe:  
\p —Netsɨ kenemɨtixekɨhɨawe, 'awie nenieremete xekaniyɨaka.   
\p
\v 15 Kamɨtsɨ xɨka yuri xe'utiyuaneni: Ti'aitame kemaine yaxeikɨa tepɨxe'anutaxɨrieni 'ena, yu'iwa xe'atɨayuke xepanuyekɨne.  
\v 16 Xeme, xewitɨ yu'iwa pɨwitɨmie, xekenanunɨ'a. Hipatɨta katsariyanata xepaye'uka. 'Anake mɨpaɨ tekatenetimaikuni xɨka 'aku yuri xe'utiyuaneni, mexɨka katixaɨtɨni, yurikɨ mɨpaɨ nekanaineni Parahuni hetsiemieme, hupamete xekaniyɨaka.   
\p
\v 17 Hikɨ Kutse kaniwaranutaxɨrieni katsariyanata haika tukari.  
\v 18 Hikɨ hairieka tukaritsie mɨpaɨ katiniwarutahɨawe:  
\p —Ne tewi Kakaɨyari nemayemakaxe nepɨhɨkɨ, xemeta yaxeketeneuyuri kenemɨtixetahɨawe, xemɨyutawikweitsitɨanikɨ.  
\v 19 Xɨkatsɨ xeme heitseriemekɨ yaxetekahuni, 'uwa xewitɨ xeikɨa kaniyuhayewamɨkɨ. Hipatɨta xekaniyehuni, tɨriku xekanituayuni xeniwema memɨtehekwakakɨ.  
\v 20 Perutsɨ tsiere yumuta xekaneni'atɨiriekuni, neyuri nemɨtixeta'eririenikɨ xemɨkakwinikɨ 'ena.  
\p Mɨpaɨ mekaniutiyuani:  
\p —'Aixɨa pɨyɨni, mɨpaɨ tepɨteyurieni.   
\p
\v 21 'Ana mɨpaɨ metenanuyutahɨawekaitɨni yunaitɨ:  
\p —Xɨari hikɨ tepɨte'uka'eniwa tamuta temɨte'ukwinitɨakɨ, tsepa mɨtatsiku'imaiyakai tepɨka'enu'eni, hikɨri xɨari 'ayumieme tekateniuka'eniwani.   
\p
\v 22 Hikɨ Xuweni mɨpaɨ katiniwarutahɨawe:  
\p —Ne 'ayumieme mɨpaɨ nepɨtixekɨhɨawekai, tepɨkate'ikwinitɨaka tepɨka'ikumemiwani, xepɨkanetsi'u'eni. Hikɨri xɨari 'ayumieme tekatenayukatuayani mumawekɨ.   
\p
\v 23 Kutse 'ekipitutari waniukikɨ mɨwakɨhɨawekaikɨ, 'iparewiwameya pɨwahekɨatɨakai waniukikɨ. Mɨkɨ mɨpaɨ mepɨkatemaikai wa'eniekame mepɨka'eriekai waniukikɨ.  
\v 24 'Anari Kutse 'anayeyaka yuxaɨta 'awie kaniutatsuani. Heyunɨtɨaka hutarieka nuaka, Tsimehuni kaniuta'aita, mɨhɨiyanikɨ yu'iwama wahɨxie.   
\p
\v 25 Hikɨ Kutse katiniuta'aita memuka'ikatɨarienikɨ tɨriku hɨpɨneme, yaxeikɨata watumini mukamanariexɨanikɨ wa'ikata, meta memuka'inɨatɨarienikɨ huyeta mieme. Mɨpaɨ mekateniuyurieni.  
\v 26 Hikɨ yupuxuri mewaruti'ikatɨaka, mekanakunuaxɨani yu'utɨma.   
\p
\v 27 Perutsɨ hakewa memekuhenikekai taikai, xewitɨ mana yupuxu titiminike, yukuxitari kananukɨxɨna, muwa yutumini kaniutaxeiya.  
\v 28 Hikɨ yu'iwama mɨpaɨ katiniwarutahɨawe:  
\p —Neuxei, kari netumini nepeukayetsiyarie. 'Uwa patika yaxeikɨa paɨmetɨ.  
\p Hikɨ 'iwamama waɨkawa mekaniutimamani. Mɨpaɨ mekaniutiyuanekaitɨni:  
\p —¿Kehepaɨtɨtɨri Kakaɨyari pɨtatsiyuriene?   
\p
\v 29 Kepauka memuta'axɨa Kanani kwieyaritsie, yupaapa Kakuwu mekateniutaxatɨani, naime kememɨte'anuyekɨ:   
\p
\v 30 —Kuwexinaruri 'Ekipitu kwieyaritsie ti'aitame, waɨkawa pɨtatsiheku'iwawiyakai. Mɨpaɨ pɨtarekuhɨawekai: “'Awienenieremete xekateyɨa”.  
\v 31 Tame mɨpaɨ tepɨteheitahɨawixɨ: “Tixaɨ tame heitseriemekɨ yatepɨtekahu tepɨka'awienenieremete.  
\v 32 Tame tepɨxeinuiwari tapaapa puyuxewi. Tamamata heimana huta tepɨyupaɨmekai, xewitɨri pumawe, tamuta xeikɨa peyuhayewaxɨ Kanani kwieyaritsie”.   
\p
\v 33 »Hikɨ tewi mana mɨti'aita mɨpaɨ katatinetahɨawe: «'Ikɨkɨ mɨpaɨ nekatinimaikamɨkɨ xɨka 'aku heitseriemekɨ yaxetekahuni, xewitɨ 'ena kaniyuhayewamɨkɨ, hipatɨ xeikɨa xekaniyehuni xeniwema memɨkaheyehaakakwitɨwenikɨ.  
\v 34 Perutsɨ xekaneni'atɨiriekuni yumuta 'imatɨreme, yuri nemɨtixeta'eririenikɨ kename 'awie nenieremete xekayɨa. 'Anake xe'iwa nekanixeyetuiriemɨkɨ, yaxeikɨata heitseriemekɨ tepɨxemateni, 'ena xemu'uwanikɨ\f + \fr 42:34 \ft \fq xemu'uwanikɨ\ft . Yaxeikɨa \fqa nekutsiyu xemɨwewiekakɨ.\f* takwiepa kemɨtixenake».   
\p
\v 35 Hikɨ kepauka yukuxitari memanukuxɨnaxɨa, mekanitaxeiya purutsa watumini muyetei. Mɨkɨkɨ yunaitɨ mekaniutimamani.  
\v 36 Hikɨ Kakuwu mɨpaɨ katiniwarutahɨawe:  
\p —Xemeri neniwema tixaɨtɨ xepɨkanetehayewieni. Kutse tahamatɨari 'apɨka'uyeika, Tsimehuni meta pumawe. Hikɨtari Wenikamini xepɨyewitɨxime. Waɨkawa xepɨnetsihiweritɨa xeikɨa.   
\p
\v 37 Perutsɨ Xuweni, yupaapa mɨpaɨ katiniutahɨawe:  
\p —Ne Wenikamini nepanuwitɨni nepɨyɨhɨritɨani nemi'atɨanikɨ. Mexɨka neka'i'atɨani, pepɨyɨwe neniwema yuhutame pemɨwarukwini.   
\p
\v 38 Kakuwu tawarita mɨpaɨ kaniutayɨni:  
\p —Neniwe pɨkayemie xe'utɨma. Kutseri pɨka'uyeika, mutaya xeikɨa puyuhayewane. Xɨka huyeta yɨkɨ reiyurieni, xemetsɨ pɨxehetsietɨni xɨka ne 'ukiratsi hiwerikakɨ ne'umɨni.   
\c 43  
\s1 Kutse 'iwamama kememɨte'u'axɨa hutarieka 'Ekipitu  
\p
\v 1 Naitsarie Kanani kwieyaritsie matsi waɨkawa mepɨyehaakakwitɨwekai.  
\v 2 Merikɨte kepauka tɨriku memuxɨ, memeikuxɨawiekai 'Ekipitu, mɨpaɨ katiniwarutahɨawe wapaapa:  
\p —Xekenehuta hutarieka tawarita xekenexɨawiyu tɨriku temeixeiyanikɨ ta'ikwai.   
\p
\v 3 Matsi Kura mɨpaɨ katinitahɨawe:  
\p —'Iya tewi heitseriemekɨ mɨpaɨ pɨtaretahɨawixɨ kename tawariri tekaheuhunikekai, ta'iwa xeikɨa Wenikamini te'awitɨtɨ teyɨwawekai.  
\v 4 Xɨka 'ekɨ pe'itaunieka tamuta, tekatenixɨawiyuni.  
\v 5 Ya pɨtikatixaɨ, titayari teteheuhuni. Mɨkɨ tewi heitserie mɨpaɨ painekai kename tekahauhunikekai, tamuta xɨka tekahawitɨkɨni.   
\p
\v 6 'Ixaheri mɨpaɨ katiniwarutahɨawe:  
\p —¿Titayari mɨpaɨ xeteheitahɨawixɨ mɨkɨ tewi, kename yu'iwa xeime xehexeiya? 'Uximatɨarika waɨkawa xepɨnetsiwiwirie.   
\p
\v 7 Mɨkɨ mɨpaɨ mepɨte'ita'ei:  
\p —Mɨkɨ tewi pɨtatsiheku'iwawiyakai waɨkawa tahepaɨtsita: “¿Xepaapa 'akuxi reyeika? ¿Xemuta 'akuxi, xewitɨ reyeika?” 'Utaitɨ, ta'iwama tatɨɨriyama wahepaɨtsita. Tame tepɨkaheyɨwawekai yɨkɨ temetiyuanikekai. Ta'iwa tatsihetawawirienike tepɨkahe'eriekai.   
\p
\v 8 Yuhetsiemieme Kura yupaapa 'Ixaheri mɨpaɨ katiniutahɨawe:  
\p —Wenikamini keheyani tahamatɨa. Keneneuhɨritɨa, kwitɨwa tekaniyehuni temɨwikwekakɨ tame meta taniwema.  
\v 9 Ne hetsiena mieme nekaninehɨritɨamɨkɨ. Xɨka nekamatsi'atɨirieni 'ena, ne hetsiena mieme nerapitɨ nekanayeimɨkɨ neheyemekɨ.  
\v 10 Xɨka niuki tekaxɨatɨakake waɨkawa, 'ari hutakɨa tepakunuaxɨanike.   
\p
\v 11 Hikɨ 'Ixaheri wapaapa mɨpaɨ katiniwarutahɨawe:  
\p —Kamɨtsɨ mɨpaɨ xeketeneuyuri, yu'iwa xekenanuwitɨki. Takwiepa mɨtixuawe 'aixɨa mɨti'anene xeketeneuka'ikata yukuxitariteta. Xeketenanutɨkiri 'iya tewi, xekenemikwa waritsamu 'etsiwa, xiete, witsimu'ɨa, mixaxi, pitsitatsi, 'erimenitɨra nuetsi hepaɨ mɨ'anene.  
\v 12 Tawarita pɨrata hepaɨna paɨmeme xekenanu'ɨiri. Mɨkɨ xepeiyetuirieni mamayatsie yukuxitariteta xemeitaxei, tietɨtsɨ mɨpaɨ kara'eriwatɨ muwa mɨneikamanaxɨ.  
\v 13 Yumuta xekenanuwitɨki mɨkɨ tewi hetsɨa.  
\v 14 Kakaɨyari Naimekɨmɨtɨrɨkaɨye mɨkɨ tewi 'aixɨa mɨtixexeiyanikɨ ke'upitɨani, Wenikamini xeime meta 'iwaya, meke'akunuaxɨani xehamatɨa. Xɨkari ne neniwema newareuyehɨamɨkɨ, ¿ketsɨari ne'uyɨni? Tsepari.   
\p
\v 15 'Ixaheri niwemama mekatenetɨni 'imikierite, tawarita pɨrata hepaɨna paɨmeme, Wenikamini me'awitɨtɨ, meyumexɨitɨatɨ mekanekɨne 'Ekipitu. Me'uta'axɨaka Kutse hɨxie mekaniti'uni.  
\v 16 Kepauka Kutse Wenikamini muxei yunaime wahamatɨa, yuparewiwame mɨpaɨ katiniutahɨawe: «Keniwaranuwitɨki 'ikɨ teɨteri nekie, kenemi'a tuuru muwaiya 'ikwai kenekawewi, tuka nehamatɨa mekatenekwaikuni».   
\p
\v 17 Ti'uximayatame katinaye'atɨani kemɨtiu'aitɨarie. Kaniwarewitɨni Kutse kie.  
\v 18 Mɨkɨ metehetimaika Kutse kie memewitɨkiekaikɨ waɨkawa mekanimamakaitɨni. Mɨpaɨ mepɨte'u'eri: «'Ikɨ tewi pɨtatsi'atɨa yukie tapɨrata mɨkahe'ɨikɨ matɨari mieme. 'Ikɨ xɨari pɨtatsikwini 'uximayatsikakɨ waɨriyarika tati'aitɨatɨ meta tapuxurima».   
\p
\v 19 'Ayumieme kiita meheutahaxɨanike 'ahurawa mekaniukɨne, Kutse kie ti'uximayatame mɨpaɨ mekateniutahɨawe:   
\p
\v 20 —Neuxei ti'aitame, 'ekɨ pekatinimaika xeimiemeri tepeɨkɨkɨnixɨa, tɨriku tepekunanai.  
\v 21 Kepauka mana temeta'axɨa hakewa temekuhenikekai tɨkarikɨ, hikɨ takuxitarite temanukɨxɨnaxɨa. Muwa kanatimanekaitɨni pɨrata, kepaɨmemekɨ temɨteyutuakai. Hikɨ tekane'ɨka mɨkɨ pɨrata.  
\v 22 Hipameta pɨrata tekana'ɨka, tawarita tɨriku teminanenikɨ. 'Atsitepɨkatemate kemɨ'ane muwa meikamanaxɨ.   
\p
\v 23 Ti'uximayatame mɨhɨritɨarie mɨpaɨ katiniwarutahɨawe:  
\p —Xepɨkayu'iyaritɨaka, ne nekanenɨ'ɨni mɨkɨ pɨrata kɨmana xemɨte'uyutua. Xekakaɨyari xepaapa kakaɨyarieya muwa xɨari peikamanaxɨa mɨkɨ 'imikieri.  
\p Ti'uximayatame Tsimehuni kaniwa'atɨirieni,  
\v 24 'ana kaniwarewitɨni memeutahaxɨanikɨ Kutse kiita. Haa meta kaniwaruhanitɨani yuketate memɨtihauxinikɨ, wapuxurimata katiniwarutimini.  
\v 25 Mɨkɨri mepɨtemaikai Kutse wahamatɨa mɨtikwanikekaikɨ tuka. Mekateniukuha'aritɨani 'imikieri kepauka munuanikekai.   
\p
\v 26 Kepauka Kutse munua yukie, mɨkɨ mekaniukahɨxima'uni hɨxiena. Mekaniyetuirieni 'imikieri memeiyetɨkiriekai meta mekanitawaɨritɨani.  
\v 27 Kutse kaniwaruta'iwawiya kememɨteheu'eriekai. Mɨpaɨta katiniwaruta'iwawiya:  
\p —¿'Aixɨa reu'eriekai xepaapa, mɨkɨ 'ukiratsi xemɨnetsihaxaxatɨwakai? ¿Rayeyuri 'akuxi?   
\p
\v 28 Mɨkɨ mekatenita'eiya:  
\p —Mɨkɨtsɨ tapaapa payeyuri, 'aixɨa katineu'erieka.  
\p 'Ana hutarieka hɨxiena mekaniukahɨxima'uni.  
\v 29 Kutse waranuxeiyatɨyaka, kepauka Wenikamini yu'iwa muxei paapaya warutsieya hetsiemieme, mɨpaɨ katiniwaruta'iwawiya:  
\p —¿'Ikɨ tihɨkɨ xe'iwa 'etsimɨyumate xemɨnetsihaxaxatɨwakai? Kakaɨyari kematsi'ɨwiyani neniwe —katinitahɨawe.   
\p
\v 30 Kutse kaneyukaheiwerietɨyani yumuta xeiyatɨ 'inaki'erietɨ. Yapauka kanewayeyani, mɨwayehuputsie heutahaka, kaniutatsuani.  
\v 31 'Uyunɨtɨaka 'anaka'ɨtaimaka, kaniwayeyani. Mɨpaɨ kaniutayɨni: «'Ikwai xekenakatuaxɨa».   
\p
\v 32 Kutse 'ikwaiya yuxaɨtame kanamaniyarieni, 'ekipitutari wa'ikwai yuxaɨtameta. Hepɨrayutsixi meta Kutse 'iwamama wa'ikwai yuxaɨta mepamaniyariexɨa, 'ekipitutari wahepaɨtsita 'axapɨ'anekai hipame wahamatɨa xɨka mete'ukwani.  
\v 33 Kutse 'iwamama hɨxiena mekanayaxe, kememɨte'ununuiwaxɨ, kwimeniyuxexeiyakaitɨni mehɨxiyatɨ.  
\v 34 Kepauka 'ikwai Kutse mamaniyarie mexayatsie, Wenikamini kanamaniyarieni 'auxɨwime xakɨyari Kutse mexayatsie miemetɨme, 'iwamamata xeixakɨyari xeikɨa mekanamaniyariexɨani yuxexuitɨ. Kaxie winuyari mekananu'ieni Kutse hamatɨa.   
\c 44  
\s1 Kutse tekɨxieya  
\p
\v 1 Merikɨtsɨ 'ana kwitɨ Kutse tiyu'uximayatsiriwame katiniuta'aitɨani kiiya hepaɨtsita mɨhɨritɨariekai: «Kenetihɨniya 'ikɨ teɨteri wakuxitarite tɨrikukɨ. Yuxexuime wa'ikata wapɨrata keneukayatsa.  
\v 2 Netekɨxi keneukaketsiri wamuta 'ikayata, pɨrata mame mɨtiuyutua». Ti'uximayatame naime katinaye'atɨani Kutse kemɨtita'aitɨakai.   
\p
\v 3 Hikɨ 'amɨtiukatarixɨ, Kutse kaniwarupitɨani memɨyehukɨ yupuxurima mewaru'arietɨ.  
\v 4 Mehekɨneku yareutewikaku Kutse tiyu'uximayatsiriwame mɨpaɨ pɨtiutahɨawixɨ: «'Ikɨ teɨteri memekɨ, keniwaranukuweiya. Xɨka pewaranuku'axe mɨpaɨ ketiniwaretahɨawi: “¿Titayari 'axa'anemekɨ xenetehakapitɨa, titayari neti'aitɨwame tekɨxieya xetehenawa pɨrata tekɨxiyari?  
\v 5 Kexemɨte'uyuri 'aixɨa pɨka'ane, mɨkɨ tekɨxi kanihɨkɨtɨni neti'aitɨwame kɨmana manuye'e, kɨmana mɨretimamate kemɨtiyɨni 'arike”».   
\p
\v 6 Kepauka ti'uximayatame mɨwaranuku'axixɨ yaxeikɨa katiniwarutahɨawe kemɨretahɨawarie.  
\v 7 Mɨkɨ mɨpaɨ mekatenita'eiya:  
\p —¿Ketitayari 'ekɨ mɨya petatikɨhɨawe? Hatsuaku tame mɨpaɨ tepɨkateheyurieka.  
\v 8 Perutsɨ tame tepeyekɨ takie Kanani kwieyaritsie, pɨrata teyetuanike temitaxei takuxitariteta. ¿Kehapaɨ matsi huru, pɨrata tete'unawani mati'aitɨwame kiita mieme?  
\v 9 Mɨkɨ pɨrata tekɨxiyari, kemɨ'ane kuxitarieyata pemitaxeiya, ke'umierieni. Tameta teyunaitɨ te'a'uximayatsiriwamete tepakɨne.   
\p
\v 10 Ti'uximayatame mɨpaɨ katiniwarɨtahɨawe:  
\p —Kexemaitɨka 'aixɨa kani'aneni, mɨpaɨ nepɨtiyurieni. Perutsɨ kemɨ'ane tekɨxi muyekeka, mɨkɨ xeikɨa neti'uximayatsiriwame kanayeimɨkɨ, xeme yunaitɨ xepɨxɨxɨnini.   
\p
\v 11 Yapauka yunaitɨ mɨkɨ mekaniuti'ikapiexɨani, yukuxitarite mekananukuxɨnaxɨani.  
\v 12 Hikɨ ti'uximayatame kanitiwauni yuxexuime wakuxitarita wamatsikatsie 'itsutɨaka. Kanitaxeiya tekɨxi wamuta Wenikamini kuxitarieyata.  
\v 13 Kepauka memixei, Kutse 'iwamama yukamixa mekaneukatsanaxɨani hiwerikakɨ. Hikɨ mewaruti'ikatɨaka yupuxurima, mekaniukunuaxɨani yu'utɨma kiekaritsie.   
\p
\v 14 Kepauka Kura yu'iwama warawitɨtɨ memu'axɨa Kutse kie, yukiita payekatei 'akuxi. Hikɨ mekaniukahɨxima'uni kwiepa paitɨ hɨxiena,  
\v 15 hikɨ Kutse mɨpaɨ katiniwarutahɨawe:  
\p —¿Titayari mɨyaxenete'uyuri? ¿'Atsixekatemaikai kɨmana nemɨtimaiwe, kemɨtiyɨni 'arike?   
\p
\v 16 Kura mɨpaɨ katinita'eiya:  
\p —¿Ketsɨ'aku te'utiyuani? 'Ekɨ tati'aitɨwame pepɨhɨkɨ. Tepɨkayɨwawe temuyutahekɨata 'atsitemɨkate'uyurikɨ. Kakaɨyari kanikaxeiya tahetsie tita 'axatemɨte'uyuri, 'ena tekaniti'uka. Te'a'uximayatsiriwamete tepɨhɨmetɨni waɨriyarika, meta kemɨ'ane 'atekɨxi muyekekai.   
\p
\v 17 Kutse mɨpaɨ katinita'eiya:  
\p —Ne nepɨkayɨwe mɨpaɨ nemɨxe'uyurieni. Xewitɨ xeikɨa netsiparewiwame kanayeimɨkɨ, kemɨ'ane tekɨxi muyekekai. Hipatɨta xekaniyehuni xekayu'iyaritɨatɨ yupaapa hetsɨa.   
\p
\v 18 Kura 'ahurawa kaniuyani Kutse hɨxie, mɨpaɨ katinitahɨawe:  
\p —Pepɨkaha'aka neti'aitɨwame, 'awie nepɨmatitaxatɨanikeyu. 'Ekɨtsɨ ti'aitame pepɨmariwe yaxeikɨa Parahuni hepaɨtɨtɨ.  
\v 19 'Ekɨ pepɨtatsiku'iwawiyakai xɨka tapaapa tehexeiyani, yata'iwa xeime tehexeiyani.  
\v 20 Tame tepɨmatsi'uta'ei, tapaapa 'ariri pɨ'ukiratsi. Yuniwema yuhutame pɨwarayexei, wamaama pɨyuxewikai. Xewitɨ kaniɨmɨni, xewitɨ xeikɨa kaneyeikani mutaya. Waɨkawa kaninaki'erieka tapaapa, 'ukiratsitɨtɨ meyexeikɨ.  
\v 21 Merikɨte 'ekɨ pepɨtatsi'utawawiri temewitɨnikɨ pemeitimanikɨ.  
\v 22 Tame mɨpaɨ teputiyua, temaikɨ pɨkaheyɨwe yupaapa meku'eirieni, yuxaɨtame xɨka heiku'eirieni hiwerikakɨ pemɨni.  
\v 23 Peru 'ekɨ pepɨtarahɨawekai xɨka ta'iwa tekahawitɨnike tepɨkamatsixeiyanikekai.  
\v 24 Kepauka takie temeta'axɨa tapaapa naime tepɨteheitaxatɨa kepemɨtatiutahɨawixɨ.  
\v 25 'Ariketa tapaapa mɨpaɨ katatinetahɨawe: “Xekenehu tawarita 'etsiwa tɨriku xekenenanaiyu”.  
\v 26 Peru tame mɨpaɨ tepɨteheitahɨawixɨ: “Tepɨkayɨwawe temeixeiyakɨ mɨkɨ ti'aitame, xɨka ta'iwa tamuta kaheyani tahamatɨa”.  
\v 27 Tapaapa mɨpaɨ pɨtaretahɨawixɨ: “Xeme xepɨtemate Xakeri matɨa yuhutame tepɨwarayexei.  
\v 28 Xewitɨri nu'aya pukumawerixɨ nehetsɨa, mana mɨtiyetɨa 'anatɨtɨri nepɨka'ixeiyawe. Mɨpaɨ nepɨtiku'eriwa, xɨari yeutanaka peitakwai.  
\v 29 Xɨkata 'ikɨ xehewitɨni, xɨka yɨkɨ reiyurieni, xemetsɨ pɨxehetsietɨni xɨka ne 'ukiratsi hiwerikakɨ ne'umɨni”.   
\p
\v 30 »Xɨka nepaapa hetsɨa nehenuani, tamuta xɨka kahenuani tahamatɨa tapaapa matɨa xei'iyariyari memɨhɨkɨ,  
\v 31 tapaapa heitatɨmaiyame kanemɨmɨkɨ. Kamɨtsɨ tame tahetsie pɨrayani, xɨka tapaapa hemɨni hiwerikakɨ.  
\v 32 Ne nepenehɨritɨa 'ikɨ temaikɨ tapaapa hɨxie. Mɨpaɨ nepɨreitahɨawixɨ: “Nepaapa, xɨka nekamatsi'atɨirieni 'aniwe, nehetsie kerahɨiyani 'atsita kepauka nemɨmɨni”.  
\v 33 'Ayumieme ne nepɨmatsiwawirie, 'ekɨ pemɨnetsipitɨanikɨ ne pɨta nemɨnehayewakɨ matsiparewiwame nemayani hetsienamieme. Mɨkɨ temaikɨ keneupitɨa mɨyemiekɨ yumatsikama wahamatɨa.  
\v 34 Titayari nereumieni nepaapa hetsɨa xɨka temaikɨ nehamatɨa kaheyani, ne tixaɨ nepɨkaheixeiyamɨkɨ nepaapa yuhiweriekame».   
\c 45  
\s1 Kutse kemɨtiyutahekɨataxɨ  
\p
\v 1 Merikɨtsɨ Kutse pɨkayɨwekairi mɨtinewienikɨ yuparewiwamete wahɨxie. Mɨpaɨ katiniwarutahɨawe: «Yunaitɨ xekenanuyekɨni 'uwa xemayetei». Nixewitɨ pɨka'uyuhayewaxɨ hamatɨana. Kepauka muyutahekɨataxɨ kename wa'iwa,  
\v 2 mɨkɨ 'ana pitsutɨa yuhiwerietɨ 'utatsuatɨ karima. 'Ekipitutari mepu'enana, yaxeikɨata Parahuni pɨtiutamari.   
\p
\v 3 Mɨpaɨ katiniwarutahɨawe yu'iwama:  
\p —Ne Kutse xe'iwa nekanihɨkɨtɨni. ¿Nepaapa 'akuxi rayeyuri?  
\p Mɨkɨ matsi mekaniutimamani mepɨkayɨwawekai memita'eiyakɨ.  
\v 4 Mɨkɨ mɨpaɨ katiniwarutahɨawe:  
\p —'Ahurawa xekenakɨni.  
\p Mɨkɨ 'ahurawa mekaniukɨne. Hikɨ mɨpaɨ katiniwarutahɨawe:  
\p —Ne Kutse nekanihɨkɨtɨni, xe'iwa 'ekipitutari xemɨwarutuiri.  
\v 5 Hikɨri yɨkɨ xepɨkateyɨkɨhɨaweni mɨya xemɨte'uyurikɨ. Kakaɨyari pɨta pɨtiuyuri, 'ena ne meri mɨnetsi'atɨa, para xemɨtawikwenikɨ.  
\v 6 Huta wiyari panuyemie, 'ena mepɨte'uka'eniwa haakakɨ. Peru 'akuxi peuyewetse 'auxɨwime wiyari mepɨka'uka'etsani mepɨka'uka'itsanani.  
\v 7 'Ayumieme Kakaɨyari pɨnetsiheyenɨ'a meripaitɨ, xetukari mɨtawikweitsitɨarienikɨ Kakaɨyari mariwemekɨ tiyurienekaku, xetɨɨriyama meta memɨkaheuyewenikɨ 'ena kwiepa.  
\v 8 Kakaɨyari pɨta pɨnetsiheyenɨ'a, xeme pɨkatixaɨ. Mɨkɨ 'ena pɨnetsi'upitɨa, yanemɨti'aitanikɨ Parahuni ti'aitame paratsiyuyata kemɨti'uximayatsieka, meta naitsarie 'Ekipitu kwieyaritsie.  
\v 9 'Ayumieme kwitɨ xekenakunuaxɨa yupaapa hetsɨa. Mɨpaɨ xeketenetaxatɨa: “'Aniwe Kutse mɨpaɨ paine: ‘Kakaɨyari pɨnetsi'upitɨa ti'aitame nemayanikɨ 'Ekipitu kwieyaritsie naitsarie. Kenamie kwitɨwa, pemɨnetsixeiyakɨ.  
\v 10 Kutseheni mɨrakutewatsie xepɨkuteni, 'ekɨ 'aniwema 'amu'e'ema watewama xepiini naitɨ. Mana hurawa pepukani.  
\v 11 'Auxɨwime wiyari pɨhaakaxatɨni 'akuxi, peru ne 'ena nepɨxeparewieka 'ikwai xemexeiyanikɨ. Mexɨka mana xeheyuhayewani Kanani kwieyaritsie, naime xepɨteheuyehɨani yupiinite’”.  
\v 12 Hikɨri xeme xepɨhɨme xemunenierixɨ kenemɨtixe'utahɨawixɨ hikɨ. Ne'iwata Wenikamini pɨnetsi'uxei, yapɨretima ne Kutse nemɨhɨkɨkɨ.  
\v 13 Naime xeketenetaxatɨa nepaapa tita xemɨte'uxei, kenemɨtimariwe 'ena 'Ekipitu kwieyaritsie. Peru xekeneyukumexɨitɨa 'ena xemi'atɨanikɨ.   
\p
\v 14 Hikɨ Kutse yumuta Wenikamini kaniutapa, 'ana kaniutatsuani, 'iwayata yaxeikɨa.  
\v 15 'Ariketa yunaime pɨwaruti'itsi yu'iwama 'utatsuatɨ, 'anakeri mepitahɨawixɨ 'iwamama.   
\p
\v 16 Kepauka niuki mu'eni ti'aitame Parahuni, kename Kutse 'iwamama me'u'axɨa, 'ana kaniyutemawiekaitɨni, yaxeikɨata teɨterimama.  
\v 17 Hikɨ Parahuni Kutse mɨpaɨ katiniutahɨawe: «Mɨpaɨ ketiniwarutahɨawi 'a'iwama: «Xekeniwaruti'ikatɨa yutewama, xekenakunuaxɨa Kanani kwieyaritsie.  
\v 18 Yupaapa xekenawitɨki, yutɨɨriyama yunaime. Nehetsɨa xekenahu. Ne nepɨwaxatɨani kwie yemekɨ 'aixɨa mɨraku'ane 'ena 'Ekipitu kwieyaritsie, meta mepɨtekwaka tita yemekɨ 'aixɨa mɨti'anene yu'ikwaite mepɨtehexeiyani.  
\v 19 Mɨpaɨta ketiniwarutahɨawi: Xekeniwaranuhapani kaxetate 'Ekipitutsie miemete para xemɨteha'ikatakɨ, yutɨɨriyama yu'ɨitama, meta yupaapa xematɨnikɨ.  
\v 20 Xepɨkahe'iyarixieka, yupiinitekɨ tita xemɨteheku'eirieni. 'Ikɨ kwieyaritsie tita mɨtixɨawe 'aixɨa ti'anenetɨ, xepiinite katinayeimɨkɨ».   
\p
\v 21 Hikɨ mɨpaɨ mepɨte'uyuri, 'Ixaheri niwemama. Kutse kaxetate pɨwayetuiri, kemainekai Parahuni, 'ikwai pɨwarenɨ'airi huyeta mieme.  
\v 22 Meta yuxexuime 'imikieri pɨwayetuiri 'ixurikite mɨhehekwa. Wenikamini pɨrata pɨyetuiri haika kiruyari raheteme, 'ixuriki meta 'auxɨwime kemariyari witsi'aneneme.  
\v 23 Yaxeikɨata Kutse yupaapa pɨrenɨ'airi: tamamata 'ikayari puxuri wahetsie, tita matsi 'aixɨa mɨti'anenekai 'Ekipitu mɨtixuawe, puxuri 'ukari wahetsie tamamata 'ikayari tɨriku, meta tikwaiwame Kutse paapaya hetsiemieme huyeta mamietsiemieme.  
\v 24 Merikɨ Kutse wateutɨatɨ, mɨpaɨ katiniwarutahɨawe yu'iwama, «Huyeta xepɨkaheyukwitɨweni».   
\p
\v 25 Hikɨ mɨkɨ 'iwamama mekanayekɨne 'Ekipitutsie. Kanani kwieyaritsie paitɨ mekaneta'axɨani hakewa wapaapa mekatei Kakuwu.  
\v 26 Meheta'axɨaka mɨpaɨ mekatenitahɨawe: «Kutse 'apuyeika 'akuxi. Kuwexinaruri kanehɨkɨtɨni, naitsarie 'Ekipitu kwieyaritsie pɨre'aita». Kakuwu matsi pɨhɨxiyakai, yuri pɨkatiwa'eririekai,  
\v 27 perutsɨ mɨkɨ yameputiyuanekai, naime Kutse kemɨtiwaretahɨawixɨ. Hikɨ kepauka Kakuwu kaxetatsixi muwaruxei Kutse mɨwareyenɨ'a memenutɨnikɨ, 'anake puyukatemawi.  
\v 28 Hikɨ mɨpaɨ kaniutayɨni: «'Aku yuri xeputiyuane. Neniwe Kutse payeniere. Nepɨyemie nepixeiyamie mexi nekamɨwe».   
\c 46  
\s1 Kakuwu 'Ekipitu kemɨretɨa  
\p
\v 1 Merikɨtsɨ 'Ixaheri kanayeyani, yupiinite naime ratɨtɨ, tita memɨtehexeiyakai. Kepauka Weritsewa meta'a, mawari kaniuwewieni, kemɨ'ane paapaya 'Itsahaki mɨkakaɨyarieyatɨkai.  
\v 2 Mɨkɨ tɨkaritsie heinɨtsitana, Kakaɨyari 'Ixaheri mɨpaɨ katiniutaxatɨani:  
\p —Kakuwu. Kakuwu 'aku.  
\p —'Uwa nepayeka —tinita'eiya.   
\p
\v 3 Kakaɨyari mɨpaɨ katinitahɨawe:  
\p —Ne Kakaɨyari nepɨhɨkɨ, 'apaapa Kakaɨyarieya. Pepɨkaheumaka 'Ekipitu pemɨyemiekɨ. Matsi ne yumɨireme nepɨxe'ayeitɨani, mana xehekutekaku.  
\v 4 Ne 'ahamatɨa nepuyeikani 'Ekipitu paitɨ. Yaxeikɨa nepɨmatsi'akunuitɨani hutarieka. Kepauka pemɨmɨximeni, Kutse pɨhɨkɨtɨni mɨmatsi'ɨwiyani, pemɨyu pɨmatsi'anuka'eima.   
\p
\v 5 Hikɨ Kakuwu kanayeyani Weritsewa mɨrakutewatsie, hikɨ 'Ixaheri niwemama mekaniyukuha'aritɨani, Kakuwu yupaapa mekananutiyeni, meta yuniwema yɨ'ɨitama mekaniwaranutiyatsa kaxetatetsie Parahuni ti'aitame mɨwareyenɨ'atsie.  
\v 6 Meta mekateniware'arieni yutewama metatsiere tita memɨte'ukaxeiyakai Kanani kwieyaritsie. Mɨpaɨ Kakuwu meta nuiwarimama 'Ekipitu mekateniu'axɨani.  
\v 7 Mɨkɨ yunaime kanewarewitɨni yutɨɨriyama 'ukitsi 'ukari, meta yuteukarima 'ukitsi 'ukari, yunaime yunuiwari.   
\b  
\p
\v 8 'Ikɨ mepɨhɨme 'ixaheritsixi teɨteriyari kememɨtetetewakai, Kakuwu niwemama memeyekɨ 'Ekipitu paitɨ:  
\li1 Xuweni, Kakuwu matɨarieya pɨhɨkɨtɨkai.   
\li1
\v 9 Xuweni niwemama mepɨtetetewakai: Kanuki, Paru, Ketsiruni meta Karimi.   
\li1
\v 10 Niwemamata Tsimehuni mepɨtetetewakai: Kemueri, Kamini, 'Uhari, Kakini, Tsukaxi, meta Tsahuri, maamaya kananeu tewiyari pɨhɨkɨtɨkai.   
\li1
\v 11 Rewi niwemama: Keritsuni, Kuhati, meta Merari.   
\li1
\v 12 Kura niwemama: 'Exi, 'Unani, Tseraxi, Paretsi, Tsera. (Peru 'Exi matɨa 'Unani, mepekwikairi Kanani kwieyaritsie paitɨ).  
\li2 Paretsi niwemama: Ketsiruni meta Kamuri.   
\li1
\v 13 'Itsakaxi niwemama: Tura, Puwa, Kuwi, meta Tsimiruni.   
\li1
\v 14 Tsawuruni niwemamata: Tsereri, 'Eruni, meta Yareri.   
\p
\v 15 'Ikɨ mepɨhɨme Kakuwu Reya memɨwarayexei Parani-'Arami me'u'uwatɨ, meta waniwe Rina 'uka. Yunaitɨ mɨpaɨ mepɨyupaɨmekai, 'ukitsi 'ukari, xeitewiyari heimana tamamata heimana yuhaikatɨ.   
\li1
\v 16 Kahari niwemama, Tsepuni, Kaki, 'Etsiwuni, Tsuni, 'Eri, 'Aruri, meta 'Areri.   
\li1
\v 17 'Atsexi niwemama: 'Imɨna, 'Itsiwa, 'Itsiwi, Weriya, 'iwaya 'ukatɨtɨ Tsera mɨtitewakai.  
\li1 Weriya niwemamata mepɨtetetewakai: Hewexi meta Marikiheri.   
\p
\v 18 Mɨkɨ mekanihɨkɨtɨni Tsiripa niwemama Kakuwu matɨa memɨwarayexei, mɨkɨ ti'uximayatame pɨhɨkɨtɨkai Rawani hetsiemieme, yuniwe Reya pɨyetɨiri hetsiena mieme mɨti'uximayakakɨ. Wanuiwari mepɨyupaɨmekai tamamata heimana 'ataxewi mekanihɨkɨtɨkaitɨni.   
\li1
\v 19 Xakeri niwemama Kakuwu 'ɨyaya: Kutse meta Wenikamini.   
\li1
\v 20 'Ekipitu Kutse yuniwema pɨwarayexei, 'Atsenati matɨa Putipera nu'aya mawari wewiwame pɨhɨkɨtɨkai 'Uni mieme: Manatsexi, meta 'Epɨrahini.   
\li1
\v 21 Wenikamini tɨɨriyamama: Wera, Wekexi, 'Atsiweri, Keraha, Nahamani, 'Ehi, Xutsi, Mupini, Kupini, meta 'Axi.   
\p
\v 22 'Ikɨ mepɨhɨkɨkai Kakuwu nuiwarimama Xakeri matɨa memɨwarayexei, yunaitɨ tamamata heimana yunaukatɨ mepɨyupaɨmekai.   
\li1
\v 23 Rani nu'aya pɨtitewakai: Kutsini.   
\li1
\v 24 Nepɨtahari niwemama: Yatseri, Kuni, Ketsexi, meta Tsireni.   
\p
\v 25 Mɨkɨ mekanihɨkɨtɨkaitɨni Wiriha niwemama Kakuwu matɨa memɨwarayexei, mɨkɨ ti'uximayatame pɨhɨkɨtɨkai Rawani hetsiemieme, yuniwe Xakeri pɨyetɨiri hetsiena mieme mɨti'uximayakakɨ. Wanuiwari mepɨyupaɨmekai 'atahuta mekanihɨkɨtɨkaitɨni.   
\b  
\p
\v 26 Yunaitɨ Kakuwu tɨɨriyamama memu'axɨa 'Ekipitu, xeinuiwari mepɨhɨkɨtɨkai, haika tewiyari heimana 'ataxewi mepɨyupaɨmekai 'ukari meka'inɨaritɨ.  
\v 27 Kutse meta yuhutame pɨwarexeiyakai yuniwema memutinunuiwakai 'Ekipitu kwieyaritsie. Mɨkɨ yunaitɨ haika tewiyari heimana tamamata mepɨyupaɨmekai Kakuwu nuiwarimama mana memu'axɨa.   
\b  
\p
\v 28 Kakuwu Kura kaniutanɨ'ani manuyehaitɨanikɨ Kutse mɨretaxatɨanikɨ, menunakekɨ Kutseheni paitɨ, kepauka mana memeta'axɨanikekai. Kepauka mana memu'axɨa,  
\v 29 Kutse pɨtiuta'aitaxɨ mukuha'aritɨarienikɨ kaxetaya, 'anari mɨkɨ petɨa Kutseheni paitɨ mitahɨawekɨ yupaapa 'Ixaheri. Kepauka mixei 'anakayaka 'utanautsaka kanitapa, mana 'epɨreuterixɨ 'utatsuatɨ tapana heukunieretɨ.  
\v 30 Hikɨ 'Ixaheri Kutse mɨpaɨ katiniutahɨawe:  
\p —Hikɨrixɨa nepɨmatsi'uxei nehɨxikɨ, neka'uximatɨarietɨri nepɨmɨni, 'akuxi 'apepuyeika pepayeniere.   
\p
\v 31 Mɨpaɨ Kutse yu'iwama katiniwarutahɨawe:  
\p —Tsiparatsɨ, Parahuni nepɨretaxatɨani kename xe'u'axɨari nehetsɨa ne'iwama, nepaapa niwemama Kanani kwieyaritsie memetitekai.  
\v 32 Mɨpaɨ nepɨreitahɨawe kename tewaxi wahɨwemete xehɨkɨ, kename muxatsi wakaitsixi xetewa'atɨa, naime tita xemɨtehexeiyakai.  
\v 33 'Ayumieme kepauka Parahuni mɨxeta'iwawiya: “¿Ketitakɨ xete'uximayatamete?”,  
\v 34 mɨpaɨ xeketeneutahɨawi kename xeme xetehɨwemete yaxeikɨa yuteukarima wahepaɨ. Xɨka matsi mɨpaɨ xete'itahɨawe, mana xepɨyuhayewani Kutseheni mɨrakutewatsie. Mɨkɨ 'ekipitutari pɨkawanake 'ahurawa memɨtehɨrieka.   
\c 47  
\p
\v 1 Hikɨ Kutse katineikuxatɨani Parahuni ti'aitame. Mɨpaɨ katineitahɨawe:  
\p —Nepaapa ne'iwama mepu'axɨari, Kanani kwieyaritsie meheyekɨneka yutewama yunaime tita memɨtehexeiyakai meteha'arietɨ. Kutseheni mɨrakutewatsie mekanetiteni.   
\p
\v 2 Kutse kaniwarawitɨkɨkaitɨni yu'auxɨwime yu'iwama Parahuni xeitsitɨanike.  
\v 3 Parahuni mɨpaɨ katiniwaruta'iwawiya:  
\p —¿Ketitakɨ xeme xete'uximayatamete?  
\p Mɨkɨ mɨpaɨ mekatenita'eiya:  
\p —Tame te'a'uximayatsiriwamete, muxatsi wahɨwemete tepɨhɨkɨ, yaxeikɨa meripaitɨ tateukarima kememɨte'uximayakai.  
\v 4 Tame 'ena tepu'axɨa 'ikɨ kwieyaritsie, 'ɨxa memawekaikɨ Kanani kwieyaritsie, tatewama wehetsiemieme, waɨkawa pehaakaxari mɨkɨ kwieyaritsie. 'Ayumieme tepɨmatsiwawirie waɨkawamekɨ pemɨtatsipitɨanikɨ Kutseheni mɨrakutewatsie temɨtahayewakɨ.   
\p
\v 5 Hikɨ Parahuni Kutse mɨpaɨ katiniutahɨawe:  
\p —'Apaapa 'a'iwama mepu'axɨa 'ahamatɨa memu'uwanikɨ.  
\v 6 'Ekipitu kwieyari katini'ahetsiemiemetɨni. 'Aixɨa mɨraku'anetsie keniwarexatɨa mana memekutenikɨ Kutseheni mɨrakutewatsie. Meta xɨka hipame pewamaika 'aixɨa meteheutahɨiwaweme keniwarehɨritɨa netewama.   
\p
\v 7 Hikɨ Kutse yupaapa Kakuwu newitɨni, Parahuni kaniutahɨawitsitɨani. Kakuwu Parahuni 'aixɨa katiniutahɨawe,  
\v 8 'ana Parahuni mɨpaɨ katinita'iwawiya:  
\p —¿Kepaɨmeme wiyari pepexeiyari?   
\p
\v 9 Kakuwu mɨpaɨ katinita'eiya:  
\p —Xeitsienituyari heimana xeitewiyari heimana tamamata wiyari nepexeiya nekuyeikatɨ. Netukari pɨkwaniwe neka'anutinewetɨ, ne'ukiyarima netutsima kememɨteheuterixɨa.   
\p
\v 10 Hikɨ Kakuwu Parahuni kaniutateutɨani, tixaɨtɨ karayuyeitɨatɨ.   
\p
\v 11 Hikɨ Kutse yupaapa yu'iwama kaniwayetuirieni kwie 'Ekipitu kwieyari 'aixɨa mɨraku'anetsie, Parahuni kemutayɨkai Kutseheni mɨrakutewatsie, 'arikeke Xamɨtsexi mɨtiuterɨwarie.  
\v 12 Kutse katiniwamikwakaitɨni yupaapa yu'iwama watɨɨriyama, yuxexuitɨ kememɨteheuyehɨakai.   
\s1 Kutse kemɨtiuta'aitaxɨ  
\p
\v 13 Merikɨtsɨ haaka kaniwekaitɨni 'Ekipitu, yaxeikɨa Kanani. 'Ikwai katiniumawekaitɨni naitsarie, teɨteri mekanikwiximekaitɨni.  
\v 14 Naime pɨrata 'Ekipitu kiekatari meta Kanani kiekatari kɨmana yu'ikwai memunanekai, Kutse kaniwaye'ɨni Parahuni kiita neita'ɨna.  
\v 15 Kepauka 'Ekipitu kiekatari meta Kanani kiekatari pɨratakɨ memu'ixɨa, Kutse hetsɨa mekaniu'axɨani mɨpaɨ me'utiyuatɨ:  
\p —'Ikwai ketaneumikwa. Tepɨkwixime haakakɨ 'ahɨxie, pɨratari tepɨkahexeiya.   
\p
\v 16 Kutse kaniwaruta'eiya:  
\p —Xɨka pɨrata xekahexeiyaniri, yutewama xekeniwarahapani, nepɨtixepatsirieni 'ikwaikɨ.   
\p
\v 17 Hikɨ 'ekipitutari yutewama Kutse mekaniyetuirieni, wakaitsixi, kawayutsixi, muxatsi, puxuri, tsipuri, Kutse tɨrikukɨ katiniwapatsiriekaitɨni mɨkɨ wiyaritsie.  
\v 18 Hairieka wiyaritsie Kutse mɨpaɨ mekateniutahɨawe:  
\p —'Ekɨ pepɨti'aitame, temɨte'anukanaka pɨkayɨwe, pɨrata tepɨkahexeiyari, tatewama 'atewama mepɨhɨkɨri, tixaɨtɨri tepɨkatehexeiya. Tame xeikɨari meta kwie temexeiya.  
\v 19 'Ekɨ pepɨkatatsipitɨaka temɨkwinikɨ, takwie meta kapa reuyewenikɨ. Ketaneutinanai 'ekɨ takwie mame, petipatatɨ 'ikwaikɨ. Mɨpaɨ Parahuni te'uximayatametemama tepɨhɨkɨtɨni takwie teyunaitɨ. Mɨpaɨ teteyurieme 'ekɨ, 'imɨari pemɨtatsitɨkitɨani temayeyuyurinikɨ, 'akuxi takwie yuxaɨta mɨkayukuhayeikawanikɨ.   
\p
\v 20 Hikɨ mɨpaɨ tiuyɨku, Kutse 'Ekipitu kwieyari kaniunaneni naime Parahuni hetsiemieme, 'ekipitutari meyehaakakwitɨwetɨ memituirikɨ naime yukwie. Mɨpaɨ tiuyɨku, naitɨ 'Ekipitu kwieyari Parahuni tipiinieya katinayani.  
\v 21 'Ana yunaitɨ 'ekipitutari waɨriyarika te'uximayatamete mekanakɨne.\f + \fr 47:21 \ft \fq waɨriyarika te'uximayatamete mekanakɨne\ft . Meripaitɨ mieme Kakaɨyari niukieya muti'utsie, tsamariyatari waxapa meta Haika tewiyari heimana tamamata xapayari, Ratinitsixi waxapa.\f*  
\v 22 Kutse mawari wewiwamete wakwie pɨka'unanai. Parahuni mɨtiwamikwakaikɨ, 'ayumieme yukwie mepɨka'utua.   
\p
\v 23 Hikɨ Kutse teɨteri mɨpaɨ katiniwarutahɨawe:  
\p —Hikɨtɨtɨ xeme meta xekwie, Parahuni hetsɨa xekanimiemetetɨni ne nemɨxe'utinanaikɨ. Kamɨ 'imɨari xekeneuka'etsa.  
\v 24 Kepauka 'itsanaxa mayani, 'auxɨwimexɨa tixeɨriekame xepɨtiwewieni yaxeikɨa papaɨmeme, xeime Parahuni xekaniyetuiriekuni, xemerita naukame xemɨtekwakakɨ, meta xemɨka'enitsiemieme.   
\p
\v 25 Teɨteri mɨpaɨ mekaniutiyuani:  
\p —'Ekɨ pepɨtatsi'utawikweitsitɨa, waɨkawa pepɨtatsi'uparewi. Parahuni te'uximayatsiriwamete tepɨhɨkɨtɨni.   
\p
\v 26 Kutse mɨkɨ 'inɨari, 'aitsika kanayeitɨani naitsarie 'Ekipitu kwieyaritsie. Hikɨ 'akuxi kaneyuhekɨaka yapaɨmetɨ Parahuni tsiemieme kanayeikani. Perutsɨ mawari wewiwamete xeikɨa wakwie Parahuni tipiinieya pɨkaratɨa.   
\p
\v 27 Hikɨ 'ixaheritsixi 'Ekipitu mekanitiyaxe Kutseheni mɨrakutewatsie. Mana waɨkawa metehexeiyatɨ mekanakɨne, waɨkawa mekaniutamɨire.  
\v 28 Kakuwu tamamata heimana 'atahuta wiyari 'Ekipitu kaniukateitɨni. Xeitsienituyari heimana huta tewiyari heimana 'atahuta wiyari kaniutihuni.  
\v 29 Kepauka 'Ixaheri\f + \fr 47:29 \ft \fq 'Ixaheri\ft . Kakuwu pɨtitewata.\f* mɨximetɨ, Kutse katiniutanɨ'airieni. Mɨpaɨ katinitahɨawe:  
\p —Xɨka 'aheyemekɨ penetsinaki'erieka, neteuritɨa keneutame'i 'inɨari mayanikɨ kename yapemɨtikayani, yakenetineutahɨawi yuri pe'utaitɨ, pemɨkanetsikateukunikɨ 'Ekipitu.  
\v 30 Kepauka nemɨmɨni, ne'ukiyarima wahetsɨa kenenetuamie, 'Ekipitu pepɨkanetsi'ukateukuni.  
\p Kutse mɨpaɨ katinita'eiya:  
\p —Kepemaine yanepɨtikayani.   
\p
\v 31 Paapaya tawarita kanita'iwawiya:  
\p —Xɨka yapetikayeimɨkɨ yakenetineutahɨawi heitseriemekɨ Kakaɨyari matsi'eniekaku.  
\p Kutse yatinitahɨawe. Hikɨ 'Ixaheri yu'utatsie kakaitɨ 'utihɨximakeka kaniyutanenewieni.   
\c 48  
\s1 'Epɨrahini meta Manatsexi 'aixɨa kememu'itɨarie  
\p
\v 1 Merikɨtsɨ 'arike Kutse katiniutamarieni kename paapaya rekuye. Hikɨ kaneyani yuniwema warawitɨtɨ Manatsexi 'Epɨrahini mame.  
\v 2 Kepauka Kakuwu mɨretima, waɨriyarika kananukuyerɨni yu'utatsie.  
\v 3 Kutse kaniutahɨawe mɨpaɨ 'utaitɨ:  
\p —Kakaɨyari Naimekɨmɨtɨrɨkaɨye kaneniutahɨawe Rutsi kiekaritsie, Kanani kwieyaritsie. 'Aixɨa kaneniuyurieni,  
\v 4 mɨpaɨ 'utaitɨ: «Ne yanepɨtiyurieni waɨkawa tɨɨri pemɨwarayexeiyakɨ, pemɨtamɨirekɨ, 'anuiwaritsie yuwaɨkawatɨ nuiwarite mepayenexɨani. 'Ikɨ kwie yuheyemekɨ puwakwietɨni».   
\p
\v 5 Merikɨte 'aniwema memuyuhuta 'Ekipitu pemɨwarayexei nekamatsitahɨawiwekaku 'akuxi, mepɨneniwematɨni. 'Epɨrahini Manatsexi yuheyeme mepɨneniwematɨni yaxeikɨa Xuweni meta Tsimehuni kememɨneteniwema.  
\v 6 Mɨkɨ wa'utɨmake pemɨwarayexeiya mepɨ'aniwematɨni, kwie memɨyetuiriyarienitsie wamatsikama mɨkɨta mana mepɨwayetuirieni.  
\v 7 Parani-'Arami ne'akunuaku, Xakeri 'amaama kanemɨni 'Epɨrata 'aurie, hikɨ Wereni mɨrakutewa, mɨkɨ huyeyari'utɨa tekaneikateuku, Kanani kwieyaritsie.   
\p
\v 8 Hikɨ 'Ixaheri Kutse niwemama waruxeiyaka, mɨpaɨ katiniuta'iwauni:  
\p —¿Mɨkɨ temari kemɨ'ane mepɨyɨa?   
\p
\v 9 Kutse yupaapa mɨpaɨ katiniutahɨawe:  
\p —Mɨkɨ neniwema mepɨhɨkɨ Kakaɨyari mɨnetsiheyenɨ'airi 'ena memutinunuiwaxɨ.  
\p Hikɨ 'Ixaheri yuniwe mɨpaɨ katiniutahɨawe:  
\p —'Enahurawa keniwati'uitɨa nemɨyutanenewienikɨ wahetsiemieme.   
\p
\v 10 'Ixaheri matsi kani'ukiratsitɨkaitɨniri, pɨkahaunierekairi. 'Ayumieme Kutse 'ahurawa kaniwati'uitɨani yuniwema. Paapaya kaniwaruti'itseni kaniwarutitapa.  
\v 11 Hikɨ Kutse mɨpaɨta katiniutahɨawe:  
\p —Neri tawarita nekamatsixeiyake nepɨne'eriekai. Matsi hikɨ Kakaɨyari pɨnetsi'upitɨa meta 'aniwemata nemɨwaxeiyakɨ.   
\p
\v 12 Hikɨ Kutse yuniwema kaniwaranukuhapani yupaapa hɨxie, mɨkɨta kaniutihɨximakeni.  
\v 13 'Anukukeka yuniwe 'Epɨrahini yutseriekɨ kaniuwiya, yu'utakɨta Manatsexi. Hikɨ yupaapa hɨxie kaniwati'uitɨani, 'Epɨrahini 'etsimutewikaikɨ, yuteukari 'Ixaheri 'utata mutikenikɨ, Manatsexi mɨmatsikayatɨkaikɨ yuteukari tserieta mutikenikɨ.  
\v 14 Peru wateukari 'Ixaheri yutanenenewienike yumamate kaniupataxɨani, 'Epɨrahini hetsɨa yutseriekɨ heimana kaneutimeni tsepa 'etsimutewikai, Manatsexi hetsɨata yu'utata miemekɨ pɨtiunakixɨ tsepa mɨmatsikayatɨkai.  
\v 15 Kanitsutɨani mɨpaɨ 'utaitɨ:  
\q1 «Kakaɨyari 'aku,  
\q2 'Apɨrahami 'Itsahaki 'ahamatɨa kememɨte'u'uwakai,  
\q1 pemɨnetsi'ɨwiya kepaukapai nemutinuiwaxɨ,  
\q2 mana mɨtiyetɨa meta hikɨ.   
\q1
\v 16 Niuki tuayame mɨnetsi'utawikweitsitɨa naime 'axamɨti'anetsie,  
\q2 'aixɨa keniwayurieka 'ikɨ tɨɨri.  
\q1 'Uxa'atɨni warie nepaxaxatsiwani,  
\q2 yaxeikɨata ne'ukiyarima 'Apɨrahami 'Itsahaki wahepaɨ.  
\q1 Xeke'utiwawere xeke'utaxiɨni 'ena kwiepa».   
\p
\v 17 Hikɨ Kutse pɨka'inakixɨ yupaapa xeiyatɨ, 'Epɨrahini mutayatsie meutimekaikɨ yutseriekɨ. Yupaapa mamaya 'uwiyaka, kanipata Manatsexi hetsie pɨta,  
\v 18 mɨpaɨ rehɨawetɨ:  
\p —Nepaapa, tixaɨ mɨpaɨ neniwe 'amɨyumate, Manatsexi pɨhɨkɨ. 'Atserieta miemekɨ mana pɨta keneutime'i.   
\p
\v 19 Perutsɨ paapaya yapɨkatiutanaki'eri. Mɨpaɨ katinitahɨawe yuniwe:  
\p —Ne nepɨtimate Manatsexi kiekarieya mariwetɨ kanayeimɨkɨ, matsi mutaya pɨta waɨkawa kanitaxiɨmɨkɨ, nuiwaritemama kiekari makate mekanakɨnikuni.   
\p
\v 20 Mɨkɨ tukaritsie Kakuwu 'aixɨa kaniwaruyurieni mɨpaɨ 'utaitɨ:  
\q1 «Kepauka nenuiwarima xeime hepaɨtsita 'aixɨa memutiyuaneni,  
\q2 mɨpaɨ mepɨtekɨhɨawarɨwani:  
\q1 “Kakaɨyari kematsi'ɨwiyani.  
\q2 Kemɨtiwa'ɨwiyakai 'Epɨrahini meta Manatsexi”».  
\p Mɨpaɨ 'utayɨka, 'Ixaheri 'Epɨrahini mexɨakame kanayeitɨani 'arike Manatsexi.   
\p
\v 21 Hikɨ 'imatɨrieka 'Ixaheri Kutse mɨpaɨ katiniutahɨawe:  
\p —Pehurari nemɨmɨnikɨ, perutsɨ Kakaɨyari xehamatɨa kaniuyeikamɨkɨ, kanixe'akunuitɨamɨkɨ xeteukarima wakwietsie.  
\v 22 'Ekɨ Kutse 'a'iwama wahetsiemieme heitserie pepexeiya waɨkawa, nepɨmatsixatɨa Tsikeni\f + \fr 48:22 \ft \fq Tsikeni\ft . Kiekari panuyɨne \fqa hɨri meta naipari. \f* kwieyari, 'amuxeutsixi teɨteriyari nemɨwarunawairi newakwinetɨ.   
\c 49  
\s1 Kakuwu yuniwema kemɨtiwarutahɨawixɨ  
\p
\v 1 Merikɨtsɨ Kakuwu yuniwema kaniwarutakwewieni, mɨpaɨ katiniwarutahɨawe: «Xekeneuyukuxeɨri nepɨtixetaxatɨani kemɨtiyɨni xehetsie.   
\q1
\v 2 »Neniwema: 'Ahurawa xekenakɨni,  
\q2 xekeneneu'eni kenemɨtixetahɨawe.   
\b  
\q1
\v 3 »'Ekɨ meri Xuweni pemɨnematɨari,  
\q2 'akɨmana meri pɨmatsiɨkɨkai kenemɨtitɨrɨkaɨyekai tɨɨri nemɨwarexeiyanikɨ.  
\q1 'Ekɨ matsi heitserie pepexeiya,  
\q2 'Ekɨ matsi pepɨtɨrɨkaɨye.   
\q1
\v 4 Perutsɨ 'ekɨ mexɨakame pepɨkahɨkɨtɨniri:  
\q2 'Axapemɨnetsi'uyurikɨ.  
\q1 Ne'ɨya matɨa pemukahuikɨ neti'uximayatsiriwame,  
\q2 'ayumieme hamewari mɨkayunɨtɨarinɨa hepaɨ pepɨ'aneni.   
\b  
\q1
\v 5 »Tsimehuni matɨa Rewi yawixi memayu'eririya wahepaɨ mekani'aneneni,  
\q2 yu'ixiparakɨ mepɨteyumemiwa.   
\q1
\v 6 Ne wahetsɨa nepɨkaheu'ixɨaramɨkɨ.  
\q2 Kapa 'axatiyuruwame hepaɨ netiuxeiyarienikɨ.  
\q1 Yuhaxɨakɨ teɨteri mepɨwarukwi,  
\q2 mewaikatɨwetɨ tuurutsixi mepɨwarutixite wa'ɨkatetsie.   
\q1
\v 7 Wahaxɨa 'axake'itɨarieka kememɨteyumemiwa,  
\q2 yuhaxɨakɨ pɨwanake hiwerika memɨwapitɨakakɨ hipame.  
\q1 Ne nepɨwatanɨ'axɨani nekwiepa,  
\q2 nepɨwataxɨriexɨani 'Ixaheri kwieyaritsie.   
\b  
\q1
\v 8 »'Ekɨ Kura, 'a'iwama 'aixɨa meputiyuaneni 'ahetsiemieme.  
\q2 Memɨmatsi'aye'unie pepɨwara'iwani,  
\q2 'ahɨxie mepɨtitunuma'uni 'a'iwamatɨtɨ.   
\q1
\v 9 Neniwe Kura, maye temaikɨ hepaɨ pepɨ'ane,  
\q2 maxa muwiyarie mɨkwa'a hepaɨ.  
\q1 Maye 'amɨpa hepaɨ, pe'itakwaka pehakunuaka pemanuhuputsie pekaniyuhayewa.  
\q2 Maye 'uka hepaɨ, xewitɨ pɨkayɨwe mɨmatsi'uximatɨanikɨ.   
\q1
\v 10 Kura xewitɨ pɨka'inawairieni ti'aitame 'itsɨya, nuiwarimama yuheyemekɨ mepɨteta'aita.  
\q1 Kepaukake munuani yurikɨ ti'aitame,  
\q2 'aixɨa mɨtiuka'iyari meuyewetse hɨxiena yamemɨtekahunikɨ kwiepa memɨtama.   
\q1
\v 11 Kura kaxie waɨkawa pexeiya.  
\q2 'Ayumieme yupuxu pakuwiwa kaxie kɨyeyaritsie,  
\q2 meta puxu nunutsi pikwa'a kaxie xawariyari.  
\q1 Yu'ixurikite pɨti'ekwa kaxie winuyaritsie,  
\q2 yɨ'ɨkarite kaxie takari hayariyaritsie piti'ekwa.   
\q1
\v 12 Kaxie winuyari waɨkawa pexeiya, 'ayumieme hɨxiteya pɨyɨyɨwi.  
\q2 Retsi kemɨtituxa, matsi waɨkawa putuxa tameteya.   
\b  
\q1
\v 13 »Tsawuruni haramara tetsita kiekame kanayeimɨkɨ,  
\q2 nawiyatsixi mɨwa'axe 'aixɨa mɨtiuye'ane kanayeimɨkɨ,  
\q2 Tsiruni paitɨ kwieya kaniye'atɨkaimɨkɨ.   
\b  
\q1
\v 14 »'Itsakaxi puxu hepaɨ pɨranuweri,  
\q2 peru naitsata heuti'ikatɨkaitɨ 'apuka.   
\q1
\v 15 Kepauka mixei yukuraru 'aixɨa tiuye'anekame,  
\q2 kwiepa 'aixɨa raku'anekame mɨka'uxipienikɨ,  
\q1 puyuwaɨri 'ika matɨkɨnikɨ,  
\q2 ti'uximayatame payuyeitɨa.   
\b  
\q1
\v 16 »Rani 'itsɨkame hepaɨ pɨtiyurieni yuteɨterima wahetsiemieme  
\q2 'Ixaheri nuiwaritemama watsata.   
\q1
\v 17 Rani pɨtɨrɨkaɨyeni, kuu mɨtiyumemiwa hepaɨ huyeta mɨkaka,  
\q2 kepauka kawayu 'ɨkayatsie mɨtakeni,  
\q2 manaka yuwarima peukaweni.   
\b  
\q1
\v 18 »Yawé 'aku 'awikweitsitɨarika nepɨtakwewie.   
\b  
\q1
\v 19 »Kahari, tenawayamete memanitamiekuni,  
\q2 matsi mɨkɨ wawarita kanakuyeimɨkɨ kaniwakwimɨkɨ.   
\b  
\q1
\v 20 »'Ekɨta 'Atsexi, 'ikwai 'aixɨa ra'anekame pepɨtikwa'a,  
\q2 'aixɨa ra'anekame petiukawewiwatɨ pepɨtiwamikwani kwiepa te'aitamete.   
\b  
\q1
\v 21 »Nepɨtahari, maxa 'uka yuxaɨta muyeikani hepaɨ pɨ'aneni,  
\q2 maxatsi tɨɨrixi witsimemɨ'anene yumaama wahepaɨ.   
\b  
\q1
\v 22 »Kutse, hatetsita 'iteɨritsiekame hepaɨ pɨ'ane,  
\q2 waɨkawa mɨyɨra,  
\q2 mamateya kurarutsie manutimake hepaɨ.   
\q1
\v 23 Kuyaxi tupi memu'ɨ mekanitamɨni,  
\q2 mekaheinenimayatɨ me'ihekatɨ.   
\q1
\v 24 Perutsɨ Kutse yutupi heitserie pakwe'e,  
\q2 mamateya pɨka'akatutuke.  
\q1 Pamɨpariyutsi Kakuwu kakaɨyarieya pemɨtɨrɨkaɨye,  
\q2 pemɨtatsi'ɨwiyame 'ixaheritsixi,  
\q2 tete mɨtse'i hepaɨ.   
\q1
\v 25 Neuxei Kutse:  
\q2 Pamɨpariyutsi 'apaapa Kakaɨyarieya mɨmatsiparewie.  
\q2 Pamɨpariyutsi Kakaɨyari Naimekɨmɨtɨrɨkaɨye,  
\q2 'aixɨa mɨmatsiyurie.  
\q1 Ke 'aixɨa mɨmatsiyurie taheima miemekɨ wiyerikɨta,  
\q2 matsipitɨatɨ meta 'emeukatewatsie miemekɨ haixakɨ,  
\q2 niwekate tɨɨri kememɨtewarayexexeiya kememɨtewatsitsitɨa.   
\q1
\v 26 Matsi 'aixɨa pɨti'anene tita 'apaapa nehɨkɨtɨtɨ nematiyetuirie,  
\q2 hɨri ke 'aixɨa mɨtipitɨarie meripaitɨ mieme reutiyetana,  
\q2 matsi waɨkawa 'aixɨa peke'itɨarieka.  
\q1 Hikɨ 'aixɨa kenemɨmatsiyurie pɨ'ahetsiemieme Kutse,  
\q2 'a'iwama watsata pepanayexeiyarie.   
\b  
\q1
\v 27 »Wenikamini, 'ɨrawe mayu'eriya hepaɨ pɨ'ane,  
\q2 ximeri tikwatɨ tita mɨtiumi,  
\q2 taikaita hipame pɨtiwamikwa tita mɨtiutatexi».   
\p
\v 28 Mɨpaɨ katiniwarutahɨawe 'Ixaheri yuniwema, tamamata heimana huta nuiwariyari, yuxexuime 'aixɨa kaniwaruyurieni, yuhetsie memeixeiyanikɨ.   
\s1 'Imatɨrieka Kakuwu yuniwema kemɨtiwarutahɨawixɨ  
\p
\v 29 'Imatɨrieka Kakuwu mɨpaɨ katiniwarutahɨawe yuniwema: «'Ariri nekanimɨximeni, kepauka nemɨmɨni. Nepaapama memuyehetsie xekeneneutateka, terɨta 'Epuruni Heti tewiyari mɨkwieyatɨkaitsie.  
\v 30 Terɨ Makipera nekanixatani Mamɨre hɨxie mɨti'ane, Kanani kwieyaritsie 'Apɨrahami minanai, 'Epuruni Heti tewiyari kaniunanairieni, yunaitɨ tɨɨriyamama muwa memeutatuariwanikɨ.  
\v 31 Muwa mekanayeheni 'Apɨrahami, 'ɨyaya Tsara, 'Itsahaki, 'ɨyaya Xeweka, muwa tsiere Reya neneutateni.  
\v 32 Mɨkɨ kwie terɨ kaniunanaiyani, Heti teɨteriyari meri katiniwapiinitɨkaitɨni».   
\p
\v 33 Kepauka mɨtiutahayewaxɨ Kakuwu yuniwema tiwakuxaxatɨwatɨ, 'ukahuka 'imatɨrieka kaniuka'ietɨyani kaniumɨni. Kaneyani yu'ukiyarima wahetsɨa.   
\c 50  
\p
\v 1 Merikɨtsɨ Kutse yupaapa kaniutapa, 'utatsuatɨ kani'itseni.  
\v 2 Hikɨ katiniwaruta'aitɨani Kutse teyu'uayemawamete, memita'uayemanikɨ waritsamu witsimu'ɨakɨ paapaya kaxarieya, hikɨ mɨpaɨ mekateniuyurieni.  
\v 3 Mepeye'atɨa huta tewiyari tukari, mɨpaɨ mepɨtewaraye'atɨwakai memɨwati'uayemawanikɨ wakaxarite. 'Ekipitutari haika tewiyari heimana tamamata tukari mepɨyuhiweriekai.   
\p
\v 4 Hiwerika 'anuyeyaku, Kutse kaniwarutahɨawe Parahuni parewiwametemama, mɨpaɨ katiniwarutahɨawe:  
\p —Ximɨxi Parahuni mɨpaɨ xeketenetahɨawi,  
\v 5 kepauka nepaapa mɨmɨximekai, mɨpaɨ pɨnetiuhɨritɨa, kename nekeheiteukimienike 'ukiyarimama memɨwayehetsie, Kanani kwieyaritsie paitɨ. Mɨpaɨ xeketenetawawiri Parahuni, nemiteukimiekɨ, kenameta ne'akunuani.   
\p
\v 6 Parahuni mɨpaɨ katinita'eiya:  
\p ―Kenemie, 'apaapa keneuteukimie, kemɨmatiutahɨawixɨ.   
\p
\v 7 Merikɨtsɨ Kutse kaneyani yupaapa mekateukukɨ. Yunaitɨ mekanekɨne 'iwamama, watɨɨriyama, yaxeikɨa 'ekipitutari 'ukirawetsixi memiteɨtakai Parahuni, 'ekipitutari wa'ukiyarima yunaitɨ.  
\v 8 Yunaitɨ Kutse kie kiekatari, meta 'iwamama, meta paapaya kie kiekatari. Mekanekɨne, yutɨɨriyama xeikɨa mepɨwareku'eiri Kutseheni kwieyaritsie, yumuxatsima meta yuwakaitsixi.  
\v 9 Mepanutiyaxixɨa kaxetatetsie, kawayutsixi wahetsie me'utetɨta, waɨkawa 'ame'atayeutɨ mekaniuhukaitɨni.   
\p
\v 10 Mekaneta'axɨani hakewa Hatahari tɨriku matihenatsie, mana Kurutani hatuxameyaritsie pehurakai. Mana Kutse 'atahuta tukari pɨyuhiweriekai paapaya mumɨkɨ.  
\v 11 Kepauka kananeutsixi memɨwaruxei meyuxeɨriekame Hatahari maka'etsatsie me'utitsuaname, mɨpaɨ mekaniutiyuani: «'Ekipitutari hiwerika mepɨwewie yemekɨ waɨkawa patsiekamekɨ». 'Ayumieme mana, Kurutani meuhuratsie, mekateniuterɨwa 'Aweri-Mitsirahini.\f + \fr 50:11 \ft Hepɨrayukɨ \fq 'Aweri-Mitsirahini\ft  panuyɨne \fqa 'ekipitutari wahiwerika.\f*   
\p
\v 12 Hikɨ mɨpaɨ mekateniuyurieni Kakuwu niwemama kemɨtiwarutahɨawekai meripaitɨ.  
\v 13 Mekaneikweni Kanani paitɨ, mana mekaneitateni terɨta Makipera kwieyaritsie, Mamɨre hɨxie, hikɨ Hewuruni mɨrakutewatsie, 'Apɨrahami meripaitɨ minanekai mɨkɨ terɨ 'Epuruni Heti tewiyari 'ituirieku, 'Apɨrahami tɨɨriyamama wateukiya mayanikɨ.  
\v 14 Hikɨ Kutse kanakunuani 'Ekipitupai yupaapa hekateukuka, yu'iwama wahamatɨa, meyunaitɨ memeiweiyakai wahamatɨa.   
\s1 Kutse kemɨtiwarunɨtɨa yu'iwama  
\p
\v 15 Kakuwu 'ukumawereku, Kutse 'iwamama mɨpaɨ mekateniyukuhɨawekaitɨni: «Xɨari pɨha'a tahepaɨtsita. Xɨari puyukɨhɨani 'axaketemiyuri».  
\v 16 'Ayumieme mɨpaɨ mekatenitanɨ'airieni mɨpaɨ mete'itahɨaweke: «'Apaapa kamɨwetɨ 'akuxi mɨpaɨ pɨtatiuhɨritɨa:  
\v 17 “Mɨpaɨ Kutse xeketeneutahɨawi, kexereuyehɨwirieka 'axakexemiyuri 'iwamama”. 'Ayumieme kwerietɨxɨa ketatineuyehɨwirieka, tame 'apaapa Kakaɨyarieya te'uximayatametemama tepɨhɨkɨ».  
\p Kepauka Kutse 'ikɨ niuki mu'eni, kaniutatsuani.  
\v 18 Hikɨ 'iwamama mekaniu'axɨani, mekaniutihɨxima'uni hɨxiena, mɨpaɨ mekatenitahɨawe:  
\p —'Ena pepɨtatsiti'uitɨa, waɨriyarika mate'uximayatsiriwamete tepɨhɨkɨ.   
\p
\v 19 Kutse mɨpaɨ katiniwarutahɨawe:  
\p —Xepɨkamamaka. Ne Kakaɨyari nemaneyeitɨwani nepɨkayɨwe.  
\v 20 Yurikɨ xeme xepɨnetsi'unanaimakai, peru Kakaɨyari pipataxɨ 'aixɨa mɨti'anekɨ, yamɨtiyɨnikɨ hikɨ ketemɨteneniere: yɨmɨiretɨ teɨteri memɨkaheuyewenikɨ.  
\v 21 'Ayumieme, hikɨ xepɨkaheumamaka. Ne nepɨxeparewieka xeme meta xetɨɨriyama.  
\p Kutse mɨpaɨ katiniwarunɨtɨani, wanaki'erietɨ waɨkawa.   
\s1 Kutse kemɨtiumɨ  
\p
\v 22 Kutse meta paapaya tɨɨriyamama 'Ekipitu kwieyaritsie mekaniuyuhayewa. Kutse xeitsienituyari heimana tamamata wiyari kaniutihuni,  
\v 23 kaniwaruxeiya 'Epɨrahini niwemama meta yututsima. Metatsiere Makixi niwemama yuniwema kaniwarayeitɨani Manatsexi teukarimama.   
\p
\v 24 Hikɨ 'arikemɨkake, Kutse mɨpaɨ katiniwarutahɨawe yu'iwama: «'Etsiwa xeikɨari peuyewetse nemɨmɨnikɨ, peru Kakaɨyari kanixeparewiekamɨkɨ, kanixe'ayewitɨmɨkɨ 'ikɨ kwieyaritsie kanixe'anuwitɨmɨkɨ kwie 'Apɨrahami, 'Itsahaki meta Kakuwu mɨwaxatɨakaitsie».  
\v 25 Hikɨ Kutse mɨpaɨ katiniwaruhɨritɨani yuniwema: «Kaniyuritɨni Kakaɨyari kanixeparewimɨkɨ. Kepauka mɨpaɨ mɨtiyɨni 'ana ne'umeyarite xekananutɨkuni».   
\p
\v 26 Kutse kaniumɨni xeitsienituyari heimana tamamata wiyari hexeiyatɨ, 'Ekipitu kwieyaritsie. Waiyarieya me'uta'uayemaka waritsamu witsimu'ɨakɨ, kakuni witsimɨ'anetsie mekanikateni.   