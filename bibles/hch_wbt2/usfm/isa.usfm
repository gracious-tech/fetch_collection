\id ISA  
\h Kitsariyaxi 
\toc1 Kitsariyaxi 
\toc2 Kitsariyaxi 
\toc3 Kits 
\mt1 Kitsariyaxi  
\c 1  
\p
\v 1 Kemɨtiunierixɨ Kitsariyaxi 'Amuxi nu'aya Kura nuiwariyari hepaɨtsita meta Kerutsareme, 'Utsiyaxi, Kutani, 'Akatsi meta 'Etsekiyaxi, Kura kwieyaritsie te'aitamete mete'aitakaku.   
\s1 Kura, nuiwari mɨkaheu'ena  
\q1
\v 2 Muyuawi, xekeneu'enana. Kwie, meta keneu'ena.  
\q2 Yawé mɨpaɨ kanaineni:  
\q1 «Ne tɨɨri nekaniwarutiwaweriya 'ameyumateme nekaniwarayeitɨani,  
\q2 peru mɨkɨ menetsi'aye'unietɨ mekanakɨne.   
\q1
\v 3 Tuuru kwietsaname yukutsiyari kanimateni  
\q2 meta puxu kanemarieka hakewa kutsiyarieya mɨreitimikwa,  
\q1 peru 'ixaheritsixi mɨpaɨ mepɨkatemate,  
\q2 neteɨterima mepɨkaheu'enana».   
\b  
\q1
\v 4 Xɨa'ui nuiwari 'axateyuruwamete,  
\q2 teɨteri xehetsie mɨrahɨiwa,  
\q1 'axateyuruwamete nuiwariyari,  
\q2 tɨɨri heitseriemekɨ yaxemɨkateyurie.  
\q1 Yawé xekaniuku'eirieni.  
\q2 Mɨpatsie 'Ixaheri hetsiemieme tixaɨtɨ tihɨkɨtɨme xepɨka'ayeitɨa.  
\q2 Yu'ɨtɨma xekanekɨne.   
\b  
\q1
\v 5 ¿Ketitayari tawarita xetetiweiwani?  
\q2 ¿Ketitayari xete'iyeweiyani xe'eye'unietɨ?  
\q1 Naitɨri'amu'u kaniweiyaka,  
\q2 naitɨri 'a'iyari katinikuyeni.   
\q1
\v 6 Xeketatetsie tsutɨtɨ xeyekɨrita paitɨ ye'atɨ  
\q2 naitsarie xepɨteheukukuye:  
\q1 mɨkɨ naimetsie xepeukuweiyatɨka, xepeukuyuyuawi,  
\q2 meta haiya hayepietɨkaime xepexeiya,  
\q1 nixewitɨ pɨkaxeti'uayemawe meta pɨkaxe'anakɨhɨaxɨawe,  
\q2 nixewitɨ hatseitikɨ pɨkaxeka'uayemawe.   
\b  
\q1
\v 7 Xekwieyaritsie kanakumaweni,  
\q2 kiekariteya tai harakunayari kanihɨkɨtɨkani,  
\q1 metanenierekakutɨtɨ  
\q2 kɨkamete wa'etsarita timieme mekateniukaxɨrɨwani,  
\q1 wakwie kanakumaweni,  
\q2 'ateewa kiekatari memɨwaruka'una hepaɨ.   
\q1
\v 8 Tsiyuni witsimɨti'ɨimari  
\q2 xamaru 'ewiweme harawerita mieme hepaɨ kaniuyɨni,  
\q1 pinixi ma'etsietsie 'etɨpiweme hepaɨ kaniuyɨni,  
\q2 kiekari manutinamieka hepaɨ kani'aneni.   
\q1
\v 9 Xɨka Yawé Naimekɨmɨtɨrɨkaɨye  
\q2 hipame kawaruhayewake me'ayeneniereme,  
\q1 hikɨ xɨari Tsuruma hepaɨ pɨraku'anenike,  
\q2 meta xɨari Kumuxa hepaɨ tepauyewenike.   
\b  
\q1
\v 10 Yawé niukieya xekeneu'eni,  
\q2 xeme Tsuruma hetsie xemɨte'aita.  
\q1 Xekeneu'eni takakaɨyari 'ɨkitɨarikaya,  
\q2 Kumuxa kiekatari.   
\q1
\v 11 Yawé mɨpaɨ kanaineni:  
\q2 «Tixaɨtɨ pɨkatihɨkɨ waɨkawa memɨnetemawirie.  
\q1 Muxatsi 'ukitsi wamawari taiyarikakɨ 'ari nepɨwaɨripieri  
\q2 meta tewaxi memɨwaiyatɨka wawiyayarikɨ,  
\q1 tuurutsixi, muxatsi meta tsipuri  
\q2 waxuriya pɨkanetsinake.   
\q1
\v 12 ¿Titayari nehɨxie xete'axe?  
\q2 ¿Kemɨ'ane pɨxe'uta'aitɨa tewaxi  
\q2 xemɨwa'atɨwanikɨ netuki takwa memɨte'akuketsinanikɨ?   
\q1
\v 13 Xepɨkanetsi'atɨiriwaniri mawari tixaɨtɨ mɨkatihɨkɨ,  
\q2 'ɨkwa witsimu'ɨa nekanixani'erieka.  
\q1 Metsa manatiwenitsie, 'uxipiya tukari, mɨrayutixexeɨritɨretsie,  
\q2 nepɨkayɨweri nemɨtinewieka yakɨ xeikɨa kememɨnete'ayexeiya.   
\q1
\v 14 Metsa 'ixɨarariyari meta wa'ixɨarari naime ne nepɨxani'erie,  
\q2 xekaneniuti'ikatɨani  
\q2 netinewietɨri nepu'uxe.   
\q1
\v 15 Kepauka teikɨ xemememe,  
\q2 ne nepɨkaxexeiyaniri,  
\q1 tsepanetɨ yunenewieri xemɨmɨiriya,  
\q2 ne nepɨka'i'enieni,  
\q2 yumamatetsie naitɨ xemeuxuxurekɨ.   
\q1
\v 16 Xekeneuyuhauxixɨa, xekeneuyu'itiexɨa.  
\q2 Nehɨxieri 'axaxepɨkateyurieka.  
\q1 'Axaxeteyurietɨ xeketeneuhayewa.   
\q2
\v 17 'Aixɨa mɨti'ane pɨta xeketenemaika.  
\q1 Mɨtiheitserie xekeneutiwawa, mɨtiuyukananaima xekeneutati'a.  
\q2 Nutui hetsiemieme xekeneutaniu meta wiura hetsie xekenenuaka».   
\b  
\q1
\v 18 Yawé mɨpaɨ kanaineni:  
\q2 «Xekenakɨni, 'aixɨa tepɨtayurieni 'ahekɨakamekɨ,  
\q1 ¿'Axakexemɨteyuriekɨ xuriya muweka hepaɨ ti'ane?  
\q2 'Ɨwi hepaɨ tituxatɨ kanayeimɨkɨ.  
\q1 ¿'Axakexemɨteyuriekɨ tixeta mɨyɨtsikimaɨyeni hepaɨ?  
\q2 Muxa huxarieya mutuxa hepaɨ kaniyɨmɨkɨ.   
\q1
\v 19 Xɨka xeme xeyuwaɨriyani yaxemɨtekakɨnekɨ,  
\q2 kwiepa timieme 'aixɨa mɨti'anene xekatenikwakakuni.   
\q1
\v 20 Xɨka xekayuwaɨriyani meta 'akuxi xeheye'unieka.  
\q2 'Ixiparakɨ xekanikwi'iwakuni».  
\qr Yawé mɨpaɨ kaniutayuni.   
\b  
\q1
\v 21 Kiekari pemɨkawatayuanekai hikɨri xeime hamatɨa tuminikɨ pepukahupu.  
\q2 Meripaitɨ 'aixɨa ti'aneme waɨkawa pepɨrexeiyakai.  
\q1 Mɨtiheitserie hetsiena puyuhayewakai,  
\q2 hikɨ matsi teyumiekate xeikɨa mepuyuhayewatɨwe.   
\q1
\v 22 'Apɨrata temɨxikitɨ kanayani,  
\q2 'akaxie winuyari 'aixɨa ma'ane, haa kanayani.   
\q1
\v 23 Te'aitamete 'ahetsɨa miemete mepunetsi'aye'unie,  
\q2 tenawayamete mepuwa'iwama,  
\q1 yunaitɨ 'itarikakɨ metekuxatatɨ memɨtepitɨariekakɨ mepɨnaki'erie  
\q2 tixaɨtɨ xeikɨa mepɨte'iwaku.  
\q1 Nutui hetsiemieme mepɨkahaniutɨka,  
\q2 meta wiura hetsiemieme.   
\b  
\q1
\v 24 'Ayumieme Ti'aitame mɨpaɨ kanaineni,  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye, mɨtɨrɨkaɨye 'Ixaheri hetsiemieme:  
\q1 «Kenemɨtiha'akɨ yanepɨtiyurieni memɨnetsi'aye'unie wahetsie,  
\q2 nekatiniwarakapitɨamɨkɨ mɨkɨ kememɨnetsi'uyuri.   
\q1
\v 25 Tawarita netɨrɨkariya xehetsie nepɨtatuani,  
\q2 temɨxikiyari xapunikɨ nepuku'itieni  
\q2 meta naime nekanakuyeitɨamɨkɨ titakɨ pemɨkati'itiyakaikɨ.   
\q1
\v 26 'A'itsɨkate 'aixɨa nekaniwatiyurimɨkɨ matɨari hepaɨ,  
\q2 meta 'a'ɨxatsitɨwamete matɨari hepaɨ.  
\q1 Hikɨ 'ana “Kiekari heitserie mexeiya” pekatinitewakamɨkɨ,  
\q2 “Kiekari mɨkawatayuitɨariwa”».   
\b  
\q1
\v 27 Tsiyuni pɨnanaiyani mɨtawikweitsitɨarienikɨ tika'eniexɨame,  
\q2 meta tita mɨtiheitseriekɨ, kemɨ'ane mɨtihayewa 'axatiyurienetɨ.   
\q1
\v 28 Peru kemɨ'ane memɨkayuwaɨriya meta 'axamemɨteyurie mekanikumaweriyariekuni,  
\q2 meta mekanikwikuni kemɨ'ane Yawé memuku'eirieni.   
\q1
\v 29 Xekanititewiyakuni xiu kɨyeyari kwinimieme xemɨtenaki'erie,  
\q2 tuturite muwa'iteɨtsietsie memenayexei wahetsiemieme tewiyarika katinayeimɨkɨ.   
\q1
\v 30 Xiu kɨyeyari xawariyari muwawaki hepaɨ kanitiyɨmɨkɨ,  
\q2 haraweri tuturi mɨwa'etsietsie mɨka'ukahatuiyarɨwa hepaɨ.   
\q1
\v 31 Tewi mɨtɨrɨkaɨye mɨaxa hepaɨ kaniyɨmɨkɨ,  
\q2 meta 'uximayatsikaya tai tsipɨrikiyari hepaɨ,  
\q1 'axeikɨa hutatɨ kanititaimɨkɨ,  
\q2 xewitɨ pumaweni mitɨnikɨ.   
\c 2  
\s1 Yawé hɨrieya  
\r (Kits 2:1-4 – Mik 4:1-3)  
\p
\v 1 Kitsariyaxi kemɨtiunieritɨarie 'Amuxi nu'aya Kura hetsiemieme meta Kerutsareme:   
\q1
\v 2 'Imatɨrieka tukaritsie,  
\q2 hɨri Yawé kiiya manuwe pɨkawatayuitɨarieni  
\q2 matsi 'a'utewitɨ kanayeimɨkɨ,  
\q1 hɨrite naime kana'iwamɨkɨ,  
\q2 hetsɨana yunaitɨ nuiwarite mekani'axɨakuni.   
\q1
\v 3 Teɨteri meyumɨiretɨ mekani'axɨakuni, meta mɨpaɨ mekanitiyuakuni:  
\q2 «Xekenakɨni, Yawé hɨrieyatsie tepanutikɨne,  
\q2 Kakuwu Kakaɨyarieya kie,  
\q1 yuhuye mɨtatsiheta'ɨkitɨanikɨ  
\q2 meta huyetana xeikɨa temuhunikɨ».  
\q1 Karikɨ Tsiyunitsie xeikɨa 'ɨkitɨarika kanayenexɨamɨkɨ,  
\q2 meta Kerutsaremetsie Yawé niukieya.   
\q1
\v 4 Mɨkɨ nuiwarite watsata kaniwataxanetamɨkɨ  
\q2 meta mɨkɨ yuwaɨkawame wa'itsɨkame kanihɨkɨtɨkamɨkɨ.  
\q1 Yu'ixipara hararu mepayeitɨaxɨani  
\q2 meta yupitsika 'ɨxa xikame mekanayeitɨaxɨakuni.  
\q1 Nuiwariteri 'ixiparakɨ mepɨkayutakwini,  
\q2 tawariri mepɨkayuti'ɨkitɨani kuyaxa miemekɨ.   
\q1
\v 5 Kakuwu kiekarieya, niwa kenaye'a,  
\q2 Yawé hekɨariyayatsie tepuhuni.   
\s1 Yawé tukarieya  
\q1
\v 6 'Ateɨterima pepɨwaruku'eiri,  
\q2 Kakuwu nuiwarimama,  
\q1 tau manatineika kiekatari muyuawitsie miemekɨ memɨteyɨ'ɨkitɨa wayeiyarikɨ memɨhɨpɨnekɨ,  
\q2 meta memɨtehetimamateke piritsiteutsixi kememɨtewarexeiya wahepaɨ,  
\q2 meta tɨratu mepuyuwewirie 'ateewa kiekatari wahamatɨa.   
\q1
\v 7 Wakwietsie huru meta pɨrata pɨhɨne,  
\q2 mɨraye'atɨka memɨteheuxeiya pɨkati'inɨari.  
\q1 Wakwietsie kawayutsixi kwinimieme mepɨte'ane,  
\q2 meta wakaxetate kuyaxa mieme pɨkati'inɨari.   
\q1
\v 8 Wakwietsie kakaɨyarixi memɨwewiyatɨka mepɨhɨne,  
\q2 teɨteri yuwewiya hɨxie mepukatunuma'uwe,  
\q2 yumamakɨ ketitamemɨte'utiwewi.   
\q1
\v 9 Tewi tixaɨtɨ pɨkarayeitɨariwa,  
\q2 tewi pɨkayɨwe 'atsimɨtiuyurieni.  
\q2 Pɨkayɨweri pemɨtiwareuyehɨwirieni.   
\b  
\q1
\v 10 'Aitá keneutahaki,  
\q2 kwauni tsata keneuyuti'awieta  
\q1 Yawé pe'ayemakatɨ  
\q2 meta witsikemɨ'anekɨ mariwetɨ.   
\q1
\v 11 Kwinimieme mɨtiyuta'ɨre hɨxiteya tixaɨtɨ pɨkarayeitɨarieni  
\q2 teɨteri kememɨteyuti'ɨre kanititunariexɨariemɨkɨ.  
\q1 'Iya tukaritsie Yawé xeikɨa 'aixɨa katinikuxaxatsiwamɨkɨ.   
\b  
\q1
\v 12 Yawé Naimekɨmɨtɨrɨkaɨye xeime tukaritsie kanayenemɨkɨ  
\q2 yunaitɨ memuyuti'ɨre meta mamariwaweme memayuyeitɨwa wahepaɨtsita,  
\q2 yunaime memuyuti'ukita wahepaɨtsita, tixaɨtɨ mekatehɨkɨtɨme mɨwarayeitɨanikɨ,   
\q2
\v 13 kariuxa Riwanutsie mieme, muyuti'ɨre meta kwinimieme mutɨtɨ hepaɨtsita,  
\q2 meta naime xiu Watsanitsie mieme hepaɨtsita,   
\q2
\v 14 hɨri naime 'amutɨtɨtsie mieme hepaɨtsita,  
\q2 meta yemurite 'amutɨtɨ hepaɨtsita,   
\q2
\v 15 tuxiyu kwinimieme mutɨtɨ naime hepaɨtsita,  
\q2 kuraru mɨtɨrɨkawi hepaɨtsita,   
\q2
\v 16 yunaime kanuwate 'amupapa Taritsi mɨye'axe wahepaɨtsita,  
\q2 meta yunaime kanuwate 'amupapa witsimɨ'anene wahepaɨtsita.   
\q1
\v 17 Tewi kwinimieme mɨtiyuta'ɨre kanititunariexɨamɨkɨ,  
\q2 teɨteri kememɨteyuti'ɨre tixaɨtɨ pɨkarayeitɨarieni.  
\q1 'Iya tukaritsie Yawé xeikɨa 'aixɨa katinikuxaxatsiwamɨkɨ,   
\q2
\v 18 meta yuri memɨkakakaɨyarixi yuheyemekɨ mepukumaweriyarieni.   
\b  
\q1
\v 19 Teɨteri terɨta mekaneutahaxɨakuni,  
\q2 meta kwiepa makutsitsinitsie,  
\q1 Yawé me'ayemakatɨ  
\q2 meta witsikemɨ'anekɨ mariwetɨ,  
\q1 kepauka mɨkɨ manukukenitsie  
\q2 kwie tayuitɨanike.   
\q1
\v 20 'Iya tukaritsie tewi  
\q2 yukakaɨyarixi hurukɨ memɨwewiyatɨka meta pɨratakɨ,  
\q1 mɨkɨ mɨwarutiwewiekai muwarayexeiyanikɨ,  
\q2 teuxari meta 'atsixi memuyekietsie puwareutaxɨrieni.   
\q1
\v 21 Tetexi terɨyarita kaneutahamɨkɨ  
\q2 meta 'ai mukatatarita,  
\q1 Yawé me'ayemakatɨ  
\q2 meta witsikemɨ'anekɨ mariwetɨ,  
\q1 kepauka mɨkɨ manukukeni  
\q2 kwie mɨwatayuitɨanikɨ.   
\q1
\v 22 Tewitsie yuri xete'erietɨ xeketeneuhayewa,  
\q2 mɨkɨ 'etsiwa xeikɨa katinaye'aka.  
\q2 Tukarieya xeihɨtsieriyari kanihɨkɨtɨni.   
\c 3  
\s1 Ke'aixɨa mɨtiyɨni Kerutsareme meta Kura kwieyaritsie  
\q1
\v 1 Tsiparatsɨ xekeneu'enana.  
\q2 Ti'aitame, Yawé Naimekɨmɨtɨrɨkaɨye,  
\q1 Kerutsareme meta Kura pɨtinawairieni,  
\q2 naime parewiya meta naime titakɨ memɨteyumikwakai:  
\q2 naime 'ikwai memɨteheuyehɨakai,  
\q2 meta naime haa kememɨteheuyehɨakai.   
\q1
\v 2 Mɨkɨ mɨka'utimamawe meta kwinimieme mɨreuyutamiewe pakumaweriya,  
\q2 'itsɨkame meta Kakaɨyari niukameya,  
\q2 muyuawitsie miemekɨ mɨtiyɨ'ɨkitɨa meta 'ukiratsi,   
\q2
\v 3 kuyaxi wa'ukiyari meta mariwemekɨ ti'uximayatame,  
\q2 'ɨxatsitame, meta kwinimieme mɨreutawewiwe  
\q2 meta 'utakwitɨ tixaɨtɨmexi mɨtiwawiwiya.   
\b  
\q1
\v 4 Memanuyetei temari pɨta nepɨwarayeitɨani,  
\q2 meta tɨɨri te'aitamete nepuwarayeitɨani.   
\q1
\v 5 Yuxexuitɨ hipame wahamatɨa mepuyuti'uximatɨani:  
\q2 yuhepaɨ 'ukitsi mepuyu'uximatɨaka,  
\q2 yu'aurie kiekatari,  
\q2 temaikɨ, 'ukiratsi hamatɨa,  
\q2 tewi tixaɨtɨ mɨkatihɨkɨ, waɨkawa mɨtiyunaki'erie hamatɨa.   
\b  
\q1
\v 6 Hikɨ xewitɨ tewi yu'iwa kaniwiyamɨkɨ  
\q2 yupaapa kie, mɨpaɨ katinitahɨawimɨkɨ:  
\q1 «'Ekɨ pemanuyeyerɨni pepɨhɨkɨtɨni, 'ekɨ tuwaxa 'amɨyewa pemexeiyakɨ,  
\q2 'ikɨ kiekari naitɨ mu'unitsie 'aixɨa ketineuyuri».   
\q1
\v 7 Matsi mɨkɨ mɨpaɨ katinita'eiyamɨkɨ:  
\q2 «Ne tiyu'uayemawame nepɨkahɨkɨ,  
\q1 nekie paa pɨkaxɨawe meta tuwaxa 'amɨyewa nepɨkahexeiya,  
\q2 teɨteri nemɨtiwata'aitɨanikɨ pepɨkanetsi'anuyeyetsani».   
\b  
\q1
\v 8 Kerutsareme kaniwatayuakeni,  
\q2 Kura kanika'unikeni,  
\q1 mɨya mepɨte'anuyehu  
\q2 Yawé kemɨkatinake memutiyuanekɨ meta mɨpaɨ memɨte'u'uwakɨ:  
\q2 me'ixani'erietɨ mɨkɨ mariwetɨ witsikemɨtiyuxexeiya.   
\q1
\v 9 Kememɨteyurie yuhɨxie paitɨ mepumatsiɨkɨ  
\q2 meta ke'axamemɨteyuriekɨ mekaniyutemamawieka Tsurumatari wahepaɨ,  
\q2 kememɨteyurie naime mepɨtewaxeitsitɨa.  
\q1 Xɨa'ui mɨkɨ wahetsiemieme,  
\q2 yɨkɨmana 'axa'anekɨa memeuyukaxɨrɨwakɨ.   
\q1
\v 10 Heitseriemekɨ yamɨtikamie mɨpaɨ xeketeneutahɨawi kename 'aixɨa 'anemekɨ yeyani,  
\q2 kemɨtiuyurikɨ kaniyutemawiekamɨkɨ 'ikwaxi xeiyatɨ.   
\q1
\v 11 Xɨa'ui 'axamɨtiuka'iyari, matsi 'aixɨa 'anemekɨ pɨkayeyani.  
\q2 Ti'uximayatɨ kemɨtiuyuri yakatinipitɨariemɨkɨ.   
\b  
\q1
\v 12 Xɨa'ui neteɨterima, waɨriyarika memɨtewa'aitɨa tɨɨri mepɨhɨkɨ  
\q2 meta 'ukarawetsixi mepɨte'aitamete.  
\q1 Xɨa'ui neteɨterima, memɨxe'uwitɨxime mepɨxeheuyexɨrie,  
\q2 huyeta yeuta mepeukuyuyuipike.   
\q1
\v 13 Yawé puyukuha'aritɨwa wahetsie mɨrahɨanikɨ,  
\q2 'apuwe yuteɨterima wataxanetake.   
\q1
\v 14 Yawé 'iwaurika kaniwewimɨkɨ  
\q2 'ukirawetsixi wahepaɨtsita meta yuteɨterima wahɨxie memanuyetei:  
\q1 «Xeme kaxie xekaniukaxɨtɨani,  
\q2 tixaɨtɨ mɨkarexeiya tipiiniteya xekiita katineyepika.   
\q1
\v 15 ¿Titakɨ heitserie xetehexeiyatɨ neteɨterima xetewananaima  
\q2 tixaɨtɨ memɨkatehexeiya waheima xete'uyehu?»,  
\q1 mɨpaɨ kanaineni Ti'aitame,  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye.   
\b  
\q1
\v 16 Yawé mɨpaɨ kanaineni:  
\q2 «Tsiyuni niwemama 'ukari kwinimieme mekateniyuti'ɨreni  
\q1 yɨkɨipi mehutseratɨkaitɨ mekaniku'uwani,  
\q2 xeime kwamanamɨtɨ kemɨtiuneniere meta kememɨte'ɨkɨka mepuyumatsiɨkɨ,  
\q2 yu'ɨkatetsie memɨteheutapietɨka mete'utiyuitɨwatɨ.   
\q1
\v 17 'Ayumieme Yawé nerɨitsitekɨ kaniwakanɨmɨkɨ  
\q2 Tsiyuni niwemama 'ukari wamu'utsie,  
\q2 Yawé yemekɨ memu'umetsekame kaniwahayewamɨkɨ».   
\p
\v 18 'Iya tukaritsie, Ti'aitame naime pɨtikɨxɨnaxɨani tita memɨteheukapine: kakaitsie tepɨa mɨkamanetɨka, kɨpatetsinamete, tɨpunite,  
\v 19 nakɨtsate, matsɨwate, 'ixurikite kɨmana memanuyukunarɨma,  
\v 20 tuwaxate, tepɨa kaunariyari 'ɨkatetsie mieme, hɨiyamete, witsimɨtiu'ɨatɨka, mɨrakatɨriketɨka,  
\v 21 hanira, mɨxikɨrawi tsuritsiemieme,  
\v 22 kamixate witsimɨti'anene, matate, kamixa witsimɨnene, kɨtsɨurite 'etsimɨnene,  
\v 23 xikɨrite, 'ixurikite 'aixɨa mɨ'anene, mukuretsi meta xikurite.   
\q1
\v 24 Witsimɨtiu'ɨakai katinitikuri'ɨakaxɨamɨkɨ,  
\q2 hɨiyame kaunari pɨhɨkɨtɨni,  
\q2 mepɨkahunixɨani witsimemɨteyutsikeniyari,  
\q2 hiwerika kamixayari mepanakatɨni witsimɨ'anene memanakatɨkɨniyari,  
\q2 mepuyutetewiyani witsimemuyukuyuruwaniyari.   
\q1
\v 25 'Ateɨterima 'ixiparakɨ mepɨkwi'iwa,  
\q2 meta memɨka'ukamama 'ahetsɨa miemete meyukwitɨwetɨ mepukwi'iwa.   
\q1
\v 26 Kiekari 'itupariyari putitsuanani meta hiwerika kamixayari panakatɨni,  
\q2 yuxaɨta kiekari nutuixietɨ, kwiepa pɨtayerɨni.   
\c 4  
\q1
\v 1 'Iya tukaritsie, 'ukarawetsixi me'atahutatɨ  
\q2 'uki xeime mepuwiya, mɨpaɨ mepɨte'itahɨawe:  
\q1 «Tame taxaɨtame tepɨteyumikwani  
\q2 meta tepɨteyuketɨaka,  
\q1 'ekɨ tsikere kepemɨtitewakɨ ketaneyetuiri:  
\q2 Ketaneɨxɨna temɨkatewinɨariekakɨ».   
\p
\v 2 'Iya tukaritsie, Yawé 'iteɨrieya meukuyɨra witsipɨ'aneni meta witsipɨtiyuxexeiyani, kwiepa timieme 'ikwaxi puwatemawieritɨani keyupaɨmetɨ 'ixaheritsixi memɨtawikweni.  
\v 3 Hikɨ kemɨ'ane Tsiyunitsie 'ayenieretɨ muyuhayewa meta kemɨ'ane Kerutsaremetsie 'ayenieretɨ muyuhayewa mɨkɨ Memɨpatsietɨka mepɨtetetewaka, meta mepaye'uxani Kerutsaremetsie tukari memexeiyanikɨ.  
\v 4 Ti'aitame Yawé 'iyari tiyu'uximatɨwamekɨ meta 'iyari taikɨ mɨtiyuxɨtsitɨwakɨ, Yawé Tsiyuni niwemama 'ɨimarixi kaniwahauximɨkɨ titakɨ memɨkate'itiyatɨkateikɨ meta xuriya pakuyeitɨani Kerutsareme kepaɨmetɨ makuxuaweni.  
\v 5 Hikɨ Yawé hai kɨtsiyari pɨtawewieni tukarikɨ mieme meta tai kwinimieme 'anutatetereme tɨkarikɨ mieme, Tsiyuni hɨriyaritsie meta kemɨ'ane mana memuyutixexeɨriwa yunaime waheima. Naime xawatɨriya heima panukawereni 'ɨkari 'atsuitɨ  
\v 6 mɨkɨ mɨwaranukanakakɨ, tukarikɨ mɨ'etɨriwiekakɨ, muwa'awietanikɨ wiyerikɨ meta wiyeri mɨ'ekama hepaɨtsita.   
\c 5  
\s1 Kaxie kwikariyari  
\q1
\v 1 Nepɨtakwika nehamiku nemɨnaki'erie hetsiemieme  
\q2 kaxie haraweriyari nɨawariyari hepaɨtsita.  
\q1 Nehamiku kwinimieme nemɨtinaki'erie kaxie haraweri xeime pexeiyakai  
\q2 'ukakɨakaku 'aixɨa tiuxuaweriwekaku.   
\q1
\v 2 Kaniwati'ine, tetexi kananuyexɨrieni  
\q2 'aixɨa 'anekɨa kanika'iteɨta.  
\q1 Mɨkɨ hixɨapa tuxiyu kaniutakeni  
\q2 meta mana matipɨnarɨwani kaniutawewieni.  
\q1 Mɨkɨ 'aixɨa 'anenetɨ kaxie mɨtixuawerekɨ pɨta'ikwewakai,  
\q2 matsi xeikɨa kaxie hatsinatɨ kaniukaxuawere.   
\q1
\v 3 Hikɨ Kura teɨteriyari,  
\q2 Kerutsareme kiekatari,  
\q2 yaxekeneutiyua kemɨ'ane mɨya'aneme peutiwiwiexɨa nekaxie haraweriyari nutsɨtɨ ne pɨnehetsiemieme.   
\q1
\v 4 ¿Tawarita 'akuxi kenetiyurienikekai nekaxie haraweriyari hetsiemieme  
\q2 tita reuyewetɨ ratɨa?  
\q1 Ne 'aixɨa 'anenetɨ kaxie mɨkayaxekɨ nepɨta'ikwewakai.  
\q2 ¿Titayari kaxie hatsinatɨ tiukaxuawerixɨ?   
\q1
\v 5 Ne nepɨtixetaxatɨani  
\q2 kenemɨtiyurieni nekaxie haraweriyari hepaɨtsita:  
\q1 Kuraruyari nepa'unatɨyani, kanika'unariemɨkɨ,  
\q2 tetsariya 'amɨtɨtɨ nekanika'unamɨkɨ, hetsiena katina'uitɨmɨkɨ.   
\q1
\v 6 Yuxaɨta nekaniku'eirimɨkɨ,  
\q2 pɨkakawitekieni mɨkakayɨrakɨ meta pɨkakakwietsanarieni,  
\q2 mana xuya pɨtinexɨani meta 'ɨtsi.  
\q1 Ne hai nepɨtita'aitɨani  
\q2 mɨkɨ hetsie mɨka'ukawiwiyenikɨ.   
\q1
\v 7 Kaxie haraweriyari Yawé Naimekɨmɨtɨrɨkaɨye tipiinieya 'ixaheri teɨteriyari mekanihɨkɨtɨni,  
\q1 Kura teɨteriyari kwiepa mɨraka'etsitɨre manayexeiyarie mekanihɨkɨtɨni.  
\q1 Mɨkɨ 'aixɨa mɨti'ane pɨtitakwewiekai,  
\q2 matsi xeikɨa xuriya 'uhaneme pukaxei,  
\q1 mɨtiheitserie pɨtitakwewiekai,  
\q2 matsi xeikɨa kukuiniya hiwariyari pukaxei.   
\s1 Memɨteyukananaima wahetsiemieme  
\q1
\v 8 Xɨa'ui 'iya kemɨ'ane yukii waɨkawa mexeiya  
\q2 meta kwie mɨraka'etsitɨre waɨkawa yupiini memɨte'ayeitɨwa  
\q1 nixeime tɨma mekahayewirietɨ mana mɨtayerɨnikɨ,  
\q2 yuxaɨta xeikɨa 'axeikɨa metitetɨ mepuyukuhayeikawa.   
\q1
\v 9 Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ nerahɨaweme nekaniu'enieni:  
\q2 «Kiite waɨkawatɨ yuxaɨta kaniyuhayewamɨkɨ,  
\q2 pumaweni kemɨ'ane kiite 'amupapata mayekanikɨ.   
\q1
\v 10 Kaxie haika hetariyayari xeikɨxauriyari xeikɨa payani,  
\q2 meta tamamata merirayari 'imɨari  
\q2 xeimerirayari xeikɨa kanayeimɨkɨ».   
\b  
\q1
\v 11 Xɨa'ui kemɨ'ane ximeri paitɨ memanuku'uwe  
\q2 winu xeikɨa me'iyuka memɨtitaruwenikɨ,  
\q1 memukutaikaiyarɨwa  
\q2 winukɨ metaruwetɨ.   
\q1
\v 12 Wa'ixɨararitsie winu puxuawe meta kanarite,  
\q2 xawerite, tepu meta pirikɨxa.  
\q1 Peru Yawé kemɨtiuyuri mepɨkayɨkɨ'ɨwiya  
\q2 meta ketita mɨtiutiwewi yamepɨkatemate.   
\q1
\v 13 'Ayumieme neteɨterima 'ateewa mepanuhapanieni  
\q2 memɨkanetsimatekɨ,  
\q1 waɨkawa memeuka'u hetsɨana miemete haakakɨ mekanikwikuni  
\q2 meta teɨteri meyumuiretɨ hariyakɨ mekanikwikuni.   
\q1
\v 14 'Ayumieme teukiya yukɨipi waɨkawa panatixawariya,  
\q2 ka'inɨarimekɨ yuteni kananutayepiwani.  
\q1 Muwa mepeukakɨka waɨkawa memeuka'u meta tixaɨtɨ memɨkatehɨkɨ,  
\q2 'ixɨarari yuariyaya meta waikari meta kememutiyɨ naime mete'atɨtɨ.   
\q1
\v 15 Tewi tixaɨtɨ pɨkarayeitɨarieni,  
\q2 teɨteri mekanitihɨxima'uikuni,  
\q2 kwinimieme memɨteyuti'ɨre mekanika'unariekuni.   
\q1
\v 16 Yawé Naimekɨmɨtɨrɨkaɨye 'aixɨa katinikuxaxatsiwamɨkɨ 'axamɨti'ane mɨtiukwinitɨakɨ,  
\q2 Kakaɨyari mɨpatsie matsiɨkɨtɨ kanayuyeitɨamɨkɨ kemɨtiheitserie patsietɨ.   
\q1
\v 17 Muxatsi mepɨtetikwani yu'ɨxata memɨyɨaka hepaɨ,  
\q2 tsipuri mepɨtetikwani xikutsixi mematitekaitsie.   
\b  
\q1
\v 18 Xɨa'ui kemɨ'ane 'axamɨti'ane memɨte'uhaxime 'itarika kaunariyarikɨ,  
\q2 meta 'axakememɨteyurie memuhaxime kaxeta kaunariyarikɨ.   
\q1
\v 19 Mɨpaɨ mekaniutiyuaneni: «Kakaɨyari keyumexɨitɨaka,  
\q2 kemɨtiyurieni keyukumexuitɨani  
\q2 tame temixeiyakɨ,  
\q1 'ahurawa kehayani meta yaketiɨyɨni  
\q2 'Ixaheri hetsiemieme Mɨpatsie kemɨtiyurimɨkɨ,  
\q2 mɨpaɨ yatemɨtehetimanikɨ».   
\b  
\q1
\v 20 Xɨa'ui kemɨ'ane 'axamɨti'ane 'aixɨa ti'anekame mɨtiuterɨwa,  
\q2 meta 'aixɨa mɨti'ane 'axati'anekame mayeitɨwa,  
\q1 yɨriya hekɨariya memɨxata,  
\q2 meta hekɨariya yɨriya memayeitɨwa,  
\q1 mɨratsiwi hakakame memɨxata,  
\q2 meta makaka hatsiwime memayeitɨwa.   
\b  
\q1
\v 21 Xɨa'ui kemɨ'ane waɨkawa metemaiwaweme memuyuxata,  
\q2 kwinimieme meteheutamaiwaweme memuyu'erie.   
\b  
\q1
\v 22 Xɨa'ui kemɨ'ane kwinimieme winu memɨteheuta'iwawe,  
\q2 memɨkamama timɨireme mete'anuye'etɨ memɨtitaruwenikɨ,   
\q1
\v 23 tumini memanu'ɨwe hetsiena mɨraka memɨteheuyehɨwirienikɨ,  
\q2 meta 'atsimɨkatiuyuri heitserie kemɨrexeiyakɨ mepɨkaparewiku.   
\q1
\v 24 'Ayumieme, tai nerɨkwari xatsi kemɨtitixɨxɨtsitɨwa  
\q2 meta tai 'ɨxa muwawaki kemɨtititaiya,  
\q1 nanarieya mɨtipɨniya,  
\q2 meta kwauni hepaɨ tuturiyari katiniti'enimɨkɨ.  
\q1 Yawé Naimekɨmɨtɨrɨkaɨye 'inɨari niukiyarieya memɨka'utanaki'erikɨ  
\q2 meta 'Ixaheri hetsiemieme Mɨpatsie niukieya memɨnanaimakɨ.   
\q1
\v 25 'Ayumieme Yawé haxɨaya kaniutani yuteɨterima wahepaɨtsita,  
\q2 hetsiena yumamá kananukuhana meta kaniwani,  
\q1 hɨrite kaniwatayuatɨkani,  
\q2 mɨkite xatsi hepaɨ mekateniyukuhayeikawani  
\q2 mɨranuyekɨkatɨretsie hixɨapa.  
\b  
\q1 Mɨyatɨtɨ haxɨaya pɨkatiuhayewaxɨ,  
\q2 yumamate 'akuxi kanitatseratɨkani.   
\b  
\q1
\v 26 Paterakɨ xeime nuiwari teewatanaka kani'iniemɨkɨ,  
\q2 kwie manu'axe paitɨ kiekame kanitawikɨiyamɨkɨ,  
\q2 mɨkɨ nuiwari kwitɨwa kaninuamɨkɨ meta mexɨima.   
\q1
\v 27 Mɨkɨ nixewitɨ pɨkati'uxe meta pɨkahekaweni,  
\q2 pɨkaheukumɨkɨni meta pɨkaheukuni,  
\q1 nixewitɨ hɨiyameya pɨkaweranaxɨani  
\q2 meta kakaiya kwitaxiyari pɨkahatekixɨani.   
\q1
\v 28 Wa'ɨrɨ kwinimieme pɨranuyemɨtsɨ,  
\q2 naitɨ watupi payuhapatɨka,  
\q1 wakawayutsixi tepɨa memeumanatɨka tete mɨtse'i hepaɨ pɨ'anene,  
\q2 meta wakaxetate 'itsikɨriyarita teɨka puwayenenetɨwa.   
\q1
\v 29 Maye 'ukaratsi mɨtiyuhaxɨatɨwa hepaɨ katiniyu'eniɨriɨkɨni,  
\q2 meta mayetsi tɨɨrixi wahepaɨ,  
\q1 'utitsinawatɨ yutahaxɨatɨame kaniwiyamɨkɨ tita mɨtitakwani,  
\q2 meta kanenuhanimɨkɨ nixewitɨ pɨkayɨwe minawairienikɨ.   
\q1
\v 30 'Iya tukaritsie kaniyutahaxɨatɨamɨkɨ hepaɨtsitana,  
\q2 haramara kemɨtiutarɨrɨrɨka hepaɨ.  
\q1 Xɨka xewitɨ kwie 'uxeiya,  
\q2 'ɨyɨwime hetsiena pɨxeiya meta 'uximatɨariekame,  
\q2 'ana hekɨariya kaniyuti'awietamɨkɨ hai 'amayetsuye warita.   
\c 6  
\s1 Kitsariyaxi 'uximayatsikaya  
\p
\v 1 Mɨkɨ wiyaritsie ti'aitame 'Utsiyaxi 'ɨmɨkuri, Ti'aitame Kakaɨyari nekaniuxeiya wapaitɨ 'aheutitewametsie 'akakaime mariwetɨ 'uwenitsie 'akaime, yu'ixurikitsie mataxitɨanikɨ tukita naitɨ puyenɨkakai.  
\v 2 Heimana mepuyewɨkai 'iteɨtametemama, yuxexuitɨ 'anate 'ataxexuime mepexeiyatɨkatei, hutamekɨ yuhɨxie mekaneuyutinatɨkateitɨni, hutamekɨta yɨ'ɨkate meteheutinatɨkatei meta hutamekɨ mete'ɨwɨwekai.  
\v 3 Mɨpaɨ yuxexuitɨ meteyutahɨawetɨ:  
\q1 «Kanipatsieka, kanipatsieka, kanipatsieka Yawé Naimekɨmɨtɨrɨkaɨye,  
\q2 naitsarie kwiepa pɨmatsiɨkɨ witsikemɨ'ane».   
\m
\v 4 Waniuki yuariyaya me'u'enieka, kitenie tsutumeyari kɨyeyari kaniwatayuaxɨani meta tukita kɨtsi kaniuyeyerɨni.  
\v 5 Hikɨ nekaniutahiwa: «Xɨa'ui ne, nehetsie pɨrahɨiwa. Tewi nepɨhɨkɨ neteta mɨkati'itiya pɨrayeneika meta teɨteri 'axame'utiyuaneme watsata nepuyeika, matsi Ti'aitame nepuxei, Yawé Naimekɨmɨtɨrɨkaɨye».   
\p
\v 6 Hikɨ 'ana xewitɨ Kakaɨyari teɨtameya nehepa kanawietɨyani. Yumamatsie tɨɨ kanatukaitɨni, tepɨa titɨkɨmekɨ mawari taiyametsie meyetukai.  
\v 7 Mɨkɨkɨ netenitsie kaneniuyuitɨani, mɨpaɨ kanetiniutahɨawe:  
\q1 «Neuxei, 'ikɨ 'ateni kaniuyuitɨani,  
\q2 'axamɨti'ane pemɨrexeiyakai katineukuyeitɨarieni,  
\q2 meta ke'axapemɨtiuyuri, pekatineuyehɨwiyarieni».   
\p
\v 8 Hikɨ Ti'aitame niukieya nekaniu'enieni mɨpaɨ 'utaineme:  
\p ―¿Kemɨ'ane nepɨtanɨ'ani? ¿Kemɨ'ane tahetsiemieme pɨmie?  
\p Hikɨ mɨpaɨ nekaniutayɨni:  
\p ―Ne kenenanɨnɨ'a. 'Ena nekaniuweni.   
\p
\v 9 Mɨkɨ mɨpaɨ kaniutayɨni:  
\p ―Kenemie mɨkɨ teɨteri mɨpaɨ ketiniwaretahɨawi:  
\q1 »“Tsepa kwi xemɨta'enana matsi xepɨkaheti'enatɨkɨne,  
\q2 tsepa kwi xemɨtaneniere matsi tixaɨtɨ xepɨkatexeiya”.   
\q1
\v 10 'Ikɨ teɨteri wa'iyari tsetse'ime kenayeitɨa,  
\q2 wa'enakareme kenanunaxɨa  
\q2 meta mekaheuneniereme keniwarayeitɨa,  
\q1 nɨkahɨrixɨa me'uneniere,  
\q2 me'u'enanani,  
\q2 meta yu'iyarikɨ meheitimaixɨani,  
\q1 kapa mete'uhayewame  
\q2 'aixɨa meteheu'erietɨ mehayeitɨarieni».   
\p
\v 11 Hikɨ mɨpaɨ nekaniutayɨni:  
\p ―¿Ti'aitame, 'ikɨ kereutere?  
\p Mɨkɨ mɨpaɨ kaniutayɨni:  
\q1 «Kepaukake kiekarite mɨka'unariexɨanitsie  
\q2 nixewitɨ mana mɨka'uyeikanitsie,  
\q1 kepaukake kiita teɨteri memɨka'ayetetɨkanitsie,  
\q2 meta 'ɨtsi yuxaɨta kumanekaku 'axa'anekɨa,   
\q1
\v 12 Yawé yunaime teɨteri kepaukake 'ateewa paitɨ mɨwaranɨnɨ'anitsie,  
\q2 meta mɨkɨ kwie kepaukake yuheyemekɨ yuxaɨta muyuhayewatsie.   
\q1
\v 13 Xɨka 'akuxi kwie tamamatatsie mieme xewitɨ yuhayewaneni,  
\q2 mɨkɨ 'akuxi mekanakumaweriyariekuni.  
\q1 Peru kepauka xiu mawitekietsie meta tuaxa  
\q2 kutsunuyari kemɨtiyukuhayeikawa,  
\q2 mɨkɨ yɨrameyari mɨpatsie kanihɨkɨtɨni».   
\c 7  
\s1 Hemanuheri 'inɨarieya  
\p
\v 1 'Akatsi, Kutani nu'aya, 'Utsiyaxi teukarieya, Kura kwieyaritsie katini'aitakaitɨni. Mɨkɨ tukaritsie Xetsini, ti'aitame Tsiriya kwieyaritsie, Pekaki Xemariyaxi nu'aya, ti'aitame 'Ixaheri kwieyaritsie, Kerutsareme mekaniu'axɨani me'itamienike, matsi mɨkɨ mepɨka'ɨyɨwekaxɨa me'e'iwake.   
\p
\v 2 Rawiri paratsiyuyata niuki kaniuye'ani kename Tsiriya 'Epɨrahini hamatɨa meheyutinɨkai, 'Akatsi 'iyarieya kaniwatayuani meta teɨterimama mekaniutimamani, 'ɨtsita kɨyexite 'ekakɨ kemɨtiutiyuatɨka hepaɨ.   
\p
\v 3 Yawé Kitsariyaxi mɨpaɨ katiniutahɨawe: «Kenemie 'aniwe Tsehaxi-Yatsuwi\f + \fr 7:3 \ft Hepɨrayukɨ panuyɨne \fq 'Etsimeyupaɨmetɨ memuyuhayewaxɨ mepɨ'axɨani.\f* pe'awitɨtɨ 'Akatsi hetsɨa, haa wapaitɨ meukatuarike manuhuyeritɨarie manu'axe pekaneikaxeiyamɨkɨ, huyeta 'Ekwame Kwieya makuma huyeyari manuyehane 'utɨa.  
\v 4 Mɨpaɨ ketinetahɨawi meyɨ'ɨwiyanikɨ, meta kayuwatɨ meyeikanikɨ, pɨkamaka Xetsini Tsiriyu tewiyari mɨha'akɨ, meta Xemariyaxi nu'aya hɨxie pɨkamaka, mɨkɨ wahekɨ pɨkayu'iyaritɨaka huta kɨyexiyari manukɨtsiyatɨkakɨ.  
\v 5 Mɨpaɨtatsiere ketinetahɨawi kename 'Epɨrahini, Xemariyaxi nu'aya hamatɨa meyunɨtɨ meta Tsiriyu tewiyari, mɨpaɨ mete'uxa kename me'itamieni, mɨpaɨ memɨteku'eriwakɨ  
\v 6 Kura kwieyaritsie mekaniye'axɨanikeyu, mexetimariutame, mexeha'iwame manata ti'aitame Taweri nu'aya memanukakenikɨ.  
\v 7 Matsi neuxei mɨpaɨ ketinetahɨawi mɨpaɨ kename ne nehaine Yawé naimekɨmɨyɨwe:  
\q1 »“Mɨkɨ mɨpaɨ pɨkaraye'ani meta mɨpaɨ pɨkatiyɨni.   
\q2
\v 8 Ramatsiku, Tsiriya kanimu'uyatɨni,  
\q2 meta Xetsini, Ramatsiku kanimu'uyatɨni,  
\q1 matsi haika tewiyari heimana 'auxɨwi wiyari 'anuyeyayu  
\q2 'Epɨrahini kanika'unariemɨkɨ yuheyemekɨ kanikumawerimɨkɨ.   
\q1
\v 9 Tsamariya 'Epɨrahini kanimu'uyatɨni,  
\q2 meta Xemariyaxi nu'aya Tsamariya kanimu'uyatɨni.  
\q1 Xɨka xeme nehetsie yuri xekate'erieka,  
\q2 yuheyemekɨ 'axepɨkateheutere”».   
\p
\v 10 Yawé hutarieka 'Akatsi mɨpaɨ katiniutahɨawe:   
\p
\v 11 ―Yawé 'akakaɨyari keneutawawiri 'inɨari mɨmatsiwewirienikɨ, tsepa kwieta tetɨata paitɨ, yatsepa muyuawi meutitewatsie paitɨ.   
\p
\v 12 Peru 'Akatsi mɨpaɨ katinita'eiya:  
\p ―Ne Yawé nepɨkata'inɨata, meta tixaɨtɨ nepɨkatitawawirieni.   
\p
\v 13 Hikɨ Kitsariyaxi mɨpaɨ kaniutayɨni: «Xekeneu'enana hikɨ xeme Rawiri nuiwarimama. Xeme teɨteri xewa'uximatɨatɨ xepɨkatehayewaku, yaxeikɨata nekakaɨyari xe'uximatɨatɨ.  
\v 14 'Ayumieme Ti'aitame 'inɨari kanixewewiriemɨkɨ: 'Ɨimari kanitihukatamɨkɨ kanitiniwemɨkɨ, 'Emanuheri katiniterɨwamɨkɨ.\f + \fr 7:14:\ft  Hepɨrayukɨ, \fq 'Emanuheri\ft  panuyɨne \fq Kakaɨyari tahamatɨa muyeika.\f*  
\v 15 Kepauka 'aixɨa mɨti'ane xeikɨa mɨtinaki'erieka, 'axamɨti'ane mɨkatinaki'erieka, retsi kuneriyari xietemakame kanikwa'amɨkɨ.  
\v 16 Karikɨ mɨkɨ nunutsi 'aixɨa mɨti'ane katitanaki'eriwekaku 'akuxi meta 'axamɨti'ane karehɨawekaku, mɨkɨ te'aitamete memɨyuhuta pemɨwamakaxe wakwie kaniku'eiriwamɨkɨ.   
\p
\v 17 »Yawé 'ahetsɨa kani'atɨamɨkɨ, meta 'ateɨterima wahetsie metatsiere 'apaapa nuiwarimama wahetsie, hatsuaku mɨkatiyɨwekai hepaɨ kepauka 'Epɨrahini Kura hamatɨa memeyutaxɨriexɨatsie paitɨ, karikɨ mɨkɨ 'Atsiriyatsie ti'aitame kanita'inimɨkɨ».   
\p
\v 18 'Iya tukaritsie Yawé yuwikɨarikɨ xaipɨ kanita'inimɨkɨ 'Ekipitu hatɨayaritsie 'aheteewakaku muyeika, meta xiete kanita'inimɨkɨ 'Atsiriya kwieyaritsie muyeika.  
\v 19 Mɨkɨ yunaitɨ mekani'axɨakuni 'aki'utɨma meukatetewatsie mekaniyuti'ituatɨakuni, 'ai mukatataritsie, naime 'aki'utɨma muyexuyatɨkatsie meta naime haa matinenieretsie.   
\p
\v 20 'Iya tukaritsie, ti'aitame 'Atsiriya kiekame hetsɨa nawaxa niɨwiekame hepaɨ 'Eupɨrata 'anutauye miemekɨ, Yawé 'Ixaheri mu'uyatsie kanikaximɨkɨ, meta huxarieya 'awie mieme metatsiere mɨxiyaya.   
\p
\v 21 'Iya tukaritsie, xewitɨ tewi xeime tsikeru meta yuhutame tsipuri kaniwatiwaweriyamɨkɨ,  
\v 22 waɨkawa retsi mekanayexexeiyakuni retsi kunerimakame kanexeiyakamɨkɨ kɨmana mɨtiutikwa'anikɨ. Meta kemɨ'ane mana yunaitɨ kwiepa memuyuhayewa retsi kuneriyari xietemakame mekani'iekakuni.   
\p
\v 23 'Iya tukaritsie, hakewa xeimiriyari kaxie kɨyeyari meku'ukai xeimiriyari pɨrata tuminiyarikɨ xewitɨ mɨraye'akai, mɨkɨ tixaɨtɨ pɨkatiyuhayewa 'ɨtsi meta xuya xeikɨa,  
\v 24 mɨkɨ naitsarie kwiepa kanakɨnɨmɨkɨ. Mana mɨye'anikɨ xeikɨa tupi meta 'ɨrɨ rapitɨ kaniyɨwemɨkɨ.  
\v 25 Mɨkɨ xuya meta 'ɨtsi pemakatɨ, hɨritetsie hakewa meripaitɨ hatsarunikɨ mɨreka'etsitɨrekaitsie pepɨkamie, mana tewaxi mematatuiwatsie kanayeimɨkɨ meta muxatsi memanu'uwatsie.   
\c 8  
\s1 'Atsiriya, Yawé kemɨtikuyuitɨa  
\p
\v 1 Yawé mɨpaɨ kanetiniutahɨawe: «Xeime mexa 'a'atayeume keneuti'ɨka, ti'utɨwamekɨ mana ketinaka'utɨa: “Mahexi-Tsarari-Katsiwatsi\f + \fr 8:1 \ft Hepɨrayukɨ panuyɨne \fq Kwitɨwa piinite mɨraye'atɨka pɨtiunawarie.\f* hetsie timieme”.  
\v 2 Ne nekaniwata'inimɨkɨ hipame 'aixɨa nemɨtiwamate memɨnenierekɨ, mawari wewiwame 'Uriyaxi meta Tsakariyaxi Kewerekiyaxi nu'aya».   
\p
\v 3 Hikɨ 'uka tixaxatame hamatɨa nekaniukahuni, mɨkɨ kaniutihukata, xeime nunutsi kaniutiniweni. Hikɨ Yawé mɨpaɨ kanetiniutahɨawe: «Mahexi-Tsarari-Katsiwatsi ketineuterɨwa.  
\v 4 Mɨkɨ nunutsi “nepaapa” “nemaama” 'akuxi mɨtayɨni kayɨwekaku, Ramatsiku waɨkawa kemɨrexeiyakai meta Tsamariya piinitɨarika mɨra'iwakai 'Atsiriyatsie ti'aitame hetsɨa katinanɨtɨkiemɨkɨ».   
\p
\v 5 Yawé tawarita mɨpaɨ kanetiniutahɨawe:   
\q1
\v 6 «'Ikɨ teɨteri memiku'eirikɨ  
\q2 Tsiruhe hayari kayuwatɨ muhane  
\q1 Xetsini hetsie pɨta memuyutemamawie  
\q2 meta Xemariyaxi nu'ayatsie,   
\q1
\v 7 Ti'aitame 'ari haa 'Eupɨrate hatɨayari wahetsie kaniwayenetɨamɨkɨ  
\q2 haa waɨkawa mɨtɨrɨkaɨye:  
\q2 ti'aitame 'Atsiriya kiekame kaniyɨanemɨkɨ kemɨtimariwe.  
\q1 Naime haa manuyehapanekai tihɨniyame kanenatiyeuriexɨamɨkɨ,  
\q2 hakewa meta'atɨkatsie panakayeurieni.   
\q1
\v 8 Kura kwieyaritsie paitɨ kaniye'amɨkɨ, kanikayunitɨamɨkɨ,  
\q2 kɨipitɨana paitɨ kaniuku'atɨyeimɨkɨ.  
\q1 Neuxei 'Emanuheri\f + \fr 8:8 \fq Kakaɨyari tahamatɨa muyeika.\f*, yu'anate taweratɨkaitɨ,  
\q2 'akwie kemɨyewa kananukanamɨkɨ».   
\b  
\q1
\v 9 'Ikɨ xekeneu'eni, nuiwarite,  
\q2 yunaitɨ nuiwarite 'ateewa kietari:  
\q1 Xekeneutihiwa kuyaxa miemekɨ,  
\q2 xekanakawitekiexɨakuni.  
\q1 Xekeneuyukuha'aritɨa kuyaxa xemuhukɨ,  
\q2 xekanititsanariexɨakuni.  
\q1 Xekeneuyukuha'aritɨa kuyaxa xemuhukɨ,  
\q2 temɨxiki xepayeitɨarieni.   
\q1
\v 10 Yaxeketeneu'utɨa kexemɨteyurieni,  
\q2 matsi kanitayeitɨariemɨkɨ,  
\q1 Yaxeketeneuxata,  
\q2 matsi mɨkɨ yapɨkatiyɨni,  
\q2 Kakaɨyari tahamatɨa muyeikakɨ.   
\s1 Kakaɨyari teke'ayemakaka  
\p
\v 11 Yawé karima kaneniutahɨawe mɨpaɨ kanetinayehɨtɨani kename 'ikɨ teɨteri wahuye neka'uweiyani. Mɨpaɨ kanetiniutahɨawe:   
\q1
\v 12 «Xeme 'ikɨ teɨteri 'iya memaye'unie memɨte'uterɨwa  
\q2 xemeta mɨpaɨ mɨkɨ xepɨkate'uterɨwani,  
\q1 tita mɨkɨ memɨtemakaxe xeme mɨkɨ xepɨkatemakaxeni,  
\q2 meta xemɨmariutsiekakɨ xepɨkayupitɨaka.   
\q1
\v 13 Yawé Naimekɨmɨtɨrɨkaɨye xeikɨa  
\q2 xeme patsiekame xekanayeitɨakakuni,  
\q1 mɨkɨ xeikɨa xekanayexeiyakakuni,  
\q2 mɨkɨ xeikɨa xekanayemakaxekakuni.   
\q2
\v 14 Yawé tuki kanihɨkɨtɨkamɨkɨ.  
\q1 Matsi tete kanihɨkɨtɨkamɨkɨ hetsiena memɨtiketamɨrike  
\q2 'Ixaheritsie nuiwarite memuyuhuta wahetsiemieme,  
\q2 mɨkɨ tete puwarekaxɨrieni.  
\q1 Kerutsareme kiekatari wahetsiemieme  
\q2 Kaunari kanayeimɨkɨ meta winiyari.   
\q1
\v 15 Yuwaɨkawatɨ mekanitiketamɨrixɨakuni,  
\q2 mekanekaxɨrikuni meta mekanitimurixɨakuni.  
\q1 Winiyari mekaniwɨtɨiyariekuni,  
\q2 mɨkɨtsie mekaniwɨrikuni».   
\b  
\q1
\v 16 Kepemɨtiwatahekɨatɨanikɨ mɨ'ayumieme 'aixɨa ketineu'uta,  
\q2 keneutseyuma 'inɨari niukiyari memɨnetsi'aweiya watsata.   
\q1
\v 17 Yawé katiniuhayewa  
\q2 Kakuwu kiekarieya xeiyatɨ,  
\q1 peru ne hetsiena netiwiyatɨ nepɨta'ikwewani,  
\q2 mɨkɨtsie kenemɨtita'ikwewa nekanexeiyani.   
\p
\v 18 'Ena xepɨnetsixeiya, neniwemama Yawé mɨnetsiyetuiri wahamatɨa. 'Ixaheritsie 'uxa'atɨni kemɨtiyɨni 'inɨari tepɨhɨkɨ Yawé Naimekɨmɨtɨrɨkaɨye hetsiemieme, Tsiyuni hɨriyaritsie 'amuka.   
\p
\v 19 Xɨka xewitɨ mɨpaɨ xerahɨaweni: «Mɨkite wahamatɨa memɨtekuxata meta memɨtehetimamateke wikixi wahepaɨ me'utiyuatɨ wahetsɨa tepɨta'iwauni, ¿tamɨ kareuyewetse teɨteri yukakaɨyarixi memɨwarahɨawenikɨ meta mɨkite, memu'uwa wahetsiemieme?»,  
\v 20 ne mɨpaɨ nekatinixehahɨaweni: «'Inɨari niukiyari meta kepemɨtiwatahekɨatɨanikɨ mɨ'ayumiemetsie xeketenewiyani». Kemɨ'ane mɨkɨtsie tiwiyatɨ mɨtihayewa, 'uxa'atɨni pɨkakahekɨariwiyarieni.   
\p
\v 21 Xeme xekaniyeha'akuni kepauka xemu'uximatɨarieka meta xeyehakakwitɨwetɨ kwiepa naitsarie xeku'uwatɨ. 'Ana teikɨ xehenenieretɨ, ti'aitame meta Kakaɨyari wahepaɨtsita 'axaxekanitiyuakuni,  
\v 22 meta kwiepa mekanenieretɨ, 'uximatɨarika xeikɨa mepɨxeiya, yɨriya meta marika 'etɨriya tsata, mewatiyɨwitsie yuheyemekɨ mekaneukaxɨriyakuni.   
\c 9  
\s1 Nunutsi tahetsɨa mutinuiwaxɨ  
\p
\v 1 Mɨyatɨtɨ, tawarita 'etɨriya pɨkatixuawere kemɨ'ane mu'uximatɨariekai hetsiemieme. Meripaitɨ Kakaɨyari Tsawuruni kwieyari tixaɨtɨ pɨkarayeitɨa meta Nepɨtahari kwieyari, matsi 'uxa'atɨni Karereya hetsiemieme 'aixɨa katinaniuwamɨkɨ, memɨkahuriyutsixi wakwieyaritsie, haramara huyeyaritsie, Kurutani 'anutaɨye hetsie.   
\q1
\v 2 Teɨteri yuwipa memu'uwakai  
\q2 hekɨariya mariweme mekaniuxeiya,  
\q1 kemɨ'ane yɨriya 'a'ayetsuime hetsie memu'uwakai  
\q2 hekɨariya kaniwaruhekɨariwiya.   
\q1
\v 3 'Ekɨ nuiwari muwerenikɨ yapepɨtiuyuri,  
\q2 waɨkawa temawierika pepɨwarupitɨa.  
\q1 Mɨkɨ 'ahɨxie mepuyutemamawie  
\q2 kepauka memuka'itsana hepaɨ,  
\q2 kepauka mete'a'iwaka piinitɨarika memɨteyutapitɨwa hepaɨ.   
\q1
\v 4 Yemekɨ 'ekɨ pepitamuraxɨ,  
\q2 Mariyani kemɨra'iwarie hepaɨ,  
\q1 wayuku kemɨtiwa'aitɨakai waɨriyarika,  
\q2 tepɨa kemɨrahete memanakatekakai,  
\q2 'itsɨ ti'aitame waɨkawamekɨ kemɨtiwara'ikatɨakai.   
\q1
\v 5 Naitɨ kakai kuyaxamieme  
\q2 'imieritsata manɨkɨ,  
\q1 meta kamixate naitɨ xuriya mɨwetɨka  
\q2 taipa katineuwiwiyamɨkɨ,  
\q2 nerɨkwari kanitixɨtsitɨamɨkɨ.   
\q1
\v 6 Matsi nunutsi tahetsɨa mutinuiwaxɨkɨ,  
\q2 'uki xeime tekaniutuitɨarieni,  
\q1 tɨrɨkariya naiparieyatsie kanika'uxipimɨkɨ,  
\q2 meta 'ipaɨ katiniterɨwariemɨkɨ:  
\q1 'Ɨxatsitame, mɨmariwe, Kakaɨyari mɨtɨrɨkaɨye,  
\q2 Yuheyemekɨ mɨtapaapa, Ti'aitame kayuwatɨ tiyupitɨwame.   
\q1
\v 7 Kemɨti'aitanikɨ kanitamɨirimɨkɨ meta kayuwatɨ kemɨtiyupitɨwakɨ,  
\q2 meta mɨkɨ pɨka'uye'atɨyani.  
\q1 Rawiri 'uwenieyatsie 'akaitɨ katinita'aitamɨkɨ  
\q2 meta hakewa mɨre'aitakaitsie,  
\q1 'amuwenikɨ meta mituikanikɨ  
\q2 heitseriemekɨ meta kemɨreuyewetse  
\q2 hikɨ meta yuheyemekɨ.  
\q1 'Ikɨ yakatinaye'atɨamɨkɨ  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye 'ɨtetsarikaya.   
\s1 Yawé kemɨtiuyeha'a 'ixaheritsixi wahepaɨtsita  
\q1
\v 8 Yawé yuniuki kaneyenɨ'ani,  
\q2 Kakuwu hepaɨtsita kaneiyenɨ'ani,  
\q2 'Ixaheri hetsie kaniukaweni.   
\q1
\v 9 'Ikɨ hepaɨtsita yunaitɨ teɨteri mepɨtehetimamateke  
\q2 ―'Epɨrahini meta Tsamariya kiekatari―,  
\q1 yunaitɨ meyuti'ɨretɨ mɨpaɨ memutiyuane  
\q2 meta yu'iyaritsie meyɨwaweme meyu'erietɨ:   
\q1
\v 10 «Xɨka xɨnariya 'uka'une,  
\q2 tetexi xitekietɨkaimekɨ tekanitawewiekuni,  
\q1 xɨka piní pikaxiyari 'anuyexɨrieni,  
\q2 kariuxa pikaxiyarikɨ tekanenukahekwatɨakuni».   
\b  
\q1
\v 11 Peru Yawé matsi kaniwatɨrɨkariyamɨkɨ  
\q2 Xetsini memaye'unie,  
\q2 memeye'unie kaniwarukuyuitɨani.   
\q1
\v 12 Tsiriyutsixi tau makayuyuipike hepatsie kiekatari,  
\q2 meta piritsiteutsixi tau manatineika hepatsie kiekatari  
\q2 'Ixaheri mekaniutakwani xeikwaiyarikɨ.  
\b  
\q1 Tsepanetɨ 'ikɨ naitɨ mɨyamɨtiɨyɨ,  
\q2 Kakaɨyari haxɨaya pukaheunuawe,  
\q2 matsi 'akuxi yumamá kanitatseratɨkani.   
\b  
\q1
\v 13 Peru teɨteri mɨpaɨ mepɨkatehetimaiwawe  
\q2 kemɨ'ane mɨyɨane mɨtiwakwinitɨa,  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye mepɨkatiwauwawe.   
\q1
\v 14 'Ayumieme xeitukaritsie  
\q2 Yawé 'Ixaheri mu'uya  
\q1 kananutixitemɨkɨ meta kwaxieya,  
\q2 takɨ meta haka.   
\q1
\v 15 'Ukirawetsixi mu'u mekanihɨkɨtɨni  
\q2 meta teɨteri waɨkawa memauka'u mepɨhɨkɨ.  
\q1 Kakaɨyari niukametemama kwaxi mekanihɨkɨtɨni,  
\q2 te'ɨkitamete memɨte'itawa.   
\q1
\v 16 Kemɨ'ane 'ikɨ kiekari memuwitɨxime mepeiyehɨa,  
\q2 kemɨ'ane memuwitɨkiexime mepɨ'iyɨrie.   
\q1
\v 17 'Ayumieme Ti'aitame temari 'aixɨari pɨkatiwaxeiya,  
\q2 nutuite meta wiuraxi pɨkawatinenimayata,  
\q1 mɨkɨ yunaitɨ 'axamemɨteyuruwametekɨ,  
\q2 wateni 'axamɨti'anene pɨtikuxata.  
\b  
\q1 Tsepanetɨ 'ikɨ naitɨ mɨyamɨtiɨyɨ,  
\q2 Kakaɨyari haxɨaya pukaheunuawe,  
\q2 matsi 'akuxi yumamá kanitatseratɨkani.   
\b  
\q1
\v 18 'Axamɨti'ane tai hepaɨ panutitetere  
\q2 'ɨtsi meta xuya mɨtixɨxɨtsitɨwa,  
\q1 meta kɨyexi 'amayetsuye mɨtaiyawe  
\q2 hikɨ panutiyeika teɨka hepaɨ,  
\q2 kɨtsi 'a'utewime hetsie.   
\q1
\v 19 Yawé Naimekɨmɨtɨrɨkaɨye haxɨayakɨ  
\q2 kwie taikɨ kananutataimɨkɨ.  
\q1 Teɨteri mɨtitaiwawe mepakɨne:  
\q2 'Ana nixewitɨ yu'iwa pɨkatinenimayata.   
\q1
\v 20 Hipatɨ tita watserieta mɨtitipika mepɨtetikwani,  
\q2 matsi yaxeikɨa mepɨteheuhaakakwikuni,  
\q1 hipatɨta tita wa'utata mɨtitipika mepɨtetikwani,  
\q2 peru yaxeikɨa mepɨkatihuxani.  
\q2 Yuniwema mekaniwatikwaikuni.   
\q1
\v 21 Manatsexi 'Epɨrahini kanitakwaimɨkɨ,  
\q2 meta 'Epɨrahini Manatsexi kanitakwaimɨkɨ,  
\q2 mɨkɨ meyunɨtɨ yuhutatɨ Kura mekanitamiekuni.  
\b  
\q1 Tsepanetɨ 'ikɨ naitɨ mɨyamɨtiɨyɨ,  
\q2 Kakaɨyari haxɨaya pukaheunuawe,  
\q2 matsi 'akuxi yumamá kanitatseratɨkani.   
\b  
\c 10  
\q1
\v 1 Xɨa'ui kemɨ'ane 'aitsika 'axa'aneneme memɨtiwewiwa  
\q2 te'utɨwamete me'eka'utɨwatɨ mewananaimatɨ.   
\q1
\v 2 Tixaɨ memɨkatehexeiya wahetsie heitserie kememɨtehexeiya memukunama,  
\q2 meta kemɨtiheitserie memɨkawapitɨa neteɨterima memɨte'uka'eniwa.  
\q1 Wiuraxi wa'ikwai mepɨtewanawairie  
\q2 meta nutuite mepɨwanawatɨwe.   
\q1
\v 3 ¿Kemeteyurieni kepauka memɨta'iwawiyarienitsie,  
\q2 kepauka 'ateewa paitɨ wiyeri tɨrɨkaɨyetɨ muwayanitsie?  
\q1 ¿Kemɨ'ane mepanukuwauni xɨka parewiya meheuyehɨaka?  
\q2 ¿Hakewa yupiinite waɨkawa memɨtehexeiya mepɨteheti'uta?   
\q1
\v 4 Tawariri yɨkɨ memɨte'uyurieni mepɨkayɨwaweni  
\q2 tixaɨtɨ memɨkatehɨkɨ mekanayuyeitɨakuni xeikɨa memanuhapanieni wahamatɨa  
\q2 yatɨni mekanikwikuni hipatɨ memɨkwi'iwa wahamatɨa.  
\b  
\q1 Tsepanetɨ 'ikɨ naitɨ mɨyamɨtiɨyɨ,  
\q2 Kakaɨyari haxɨaya pukaheunuawe,  
\q2 matsi 'akuxi yumamá kanitatseratɨkani.   
\s1 Kakaɨyari 'Atsiriya kemɨtiukwinitɨa  
\q1
\v 5 «Xɨa'ui 'Atsiriya, nehaxɨa kɨyeyari.  
\q2 Nehaxɨa 'iwaɨyɨyari wamamatsie katini'aneni.   
\q1
\v 6 Nekanitanɨ'amɨkɨ xeinuiwariyaritsie 'axamemɨteyurie wahetsɨa,  
\q2 nekanitanɨ'amɨkɨ teɨteri memɨnetsihaxɨatɨa wehetsɨa,  
\q1 memɨtewanawatsirienikɨ meta tita waɨkawa memɨtehexeiya,  
\q2 meta memuwatiketsinikɨ haxu kaye 'utɨa mɨtikani hepaɨ.   
\q1
\v 7 Matsi 'Atsiriya mɨpaɨ pɨkatiyɨkɨhɨawekai yamɨtiyurienikɨ 'ikɨ hepaɨtsita,  
\q2 meta tsikere pɨka'iti'eriexɨa.  
\q1 Xeikɨatɨ pɨtiutiwau mɨtiyuka'unakɨ  
\q2 meta yɨmɨireme nuiwarite muwarakumaweriyakɨ.   
\q1
\v 8 Mɨpaɨ xeikɨa 'utaitɨ: “Yunaitɨ memanuyetei nehetsɨa miemete te'aitamete mekanihɨkɨtɨni.   
\q2
\v 9 Karinu Karikemitsi hepaɨ kani'aneni.  
\q1 Kamati 'Axipari hepaɨ kani'aneni,  
\q2 meta Tsamariya Ramatsiku hepaɨ kani'aneni.   
\q1
\v 10 Kehepaɨ netɨrɨkariyakɨ nemɨtiwara'iwaxɨ  
\q2 hipame te'aitamete kakaɨyarixi yuwaɨkawame mewarexeiyakame,  
\q1 wakakaɨyarixi 'ɨkiyari meyumɨireme  
\q2 keyuri Kerutsareme meta Tsamariya kiekatari,   
\q1
\v 11 Tsamariya kenemuyuri meta kakaɨyariximama,  
\q2 mɨpaɨta Kerutsareme nekaniyurimɨkɨ meta kakaɨyariximama”».   
\p
\v 12 Kepauka Yawé mɨtitahayewa Tsiyuni hɨriyaritsie kemɨtiyurienikɨ meta Kerutsareme hetsie, mɨkɨ mɨpaɨ kanitayɨmɨkɨ: «'Atsiriyatsie Ti'aitame nekatinikwinitɨamɨkɨ 'iyarieya kwinimieme mɨtiyuta'ɨrekɨ, meta kwinimieme mɨtiyukatawe'eriekɨ hɨxiteya».  
\v 13 Mɨpaɨtsɨ kaniutaineni:  
\q1 «'Ikɨ netɨrɨkariyakɨ nekatiniuyurieni,  
\q2 kenemɨtimaiwe nekatiniuyurieni,  
\q2 netsɨ kwinimieme nekatineuta'eriweni.  
\q1 Hipame teɨteri wakwie manuka'atɨkatsie nekaniupataxɨani,  
\q2 kwinimieme mɨraye'atɨka memɨtehexeiyakai nekatiniwarunawairieni,  
\q1 kwinimieme mɨreuyutamiewe hepaɨ ne'anetɨ  
\q2 tewa'aitɨwamete nekaniwaruka'una.   
\q1
\v 14 Xewitɨ 'itua hetsie meukamemeni hepaɨ,  
\q2 teɨteri tita memɨteheuxeiyakai nehetsie timieme pɨratɨa,  
\q1 tawári 'uku'eiriwaku xewitɨ menatitɨkɨ hepaɨ,  
\q2 naime kwie nepiini nepayeitɨa,  
\q1 xewitɨ tɨma pɨka'utawerikixɨ  
\q2 nitɨma yuyekarau pɨka'anutayepi mɨtatsuanikɨ».   
\b  
\q1
\v 15 ¿Kamɨtsɨ tiyɨwe hatsa yɨweme muyuxatani  
\q2 keyuri mikumaɨwa,  
\q2 yatɨni tixitekeme yɨweme muyuxatani keyuri kemɨ'ane mikumaɨwa?  
\q1 'Itsɨ mɨyɨweni hepaɨ mikuhananenikɨ  
\q2 kemɨ'ane mekwe'e,  
\q1 yatɨni kɨye mɨkaxani mɨyɨweni hepaɨ menukukwenikɨ  
\q2 waɨkawa matsi haheteme keyuri mexa.   
\q1
\v 16 'Ayumieme Ti'aitame kanenunɨ'amɨkɨ  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye,  
\q1 kwiniya mɨyakame panunɨ'ani  
\q2 kuyaximama memɨtɨrɨkawi wahetsie.  
\q1 Mamariwaweme mɨwarayeitɨaniyari, matsi pɨta kanatinaimɨkɨ wahetsiemieme,  
\q2 tai nerɨkwariyari mɨtiyukukuine hepaɨ.   
\q1
\v 17 'Ixaheri hekɨariyari tai kanayeimɨkɨ,  
\q2 wahetsie Mɨpatsie nerɨkwari kanayeimɨkɨ.  
\q1 Xeitukaritsie xuyayari kanititaiyamɨkɨ,  
\q2 meta wa'ɨtsite kanitixɨtsitɨamɨkɨ.   
\q1
\v 18 Katinika'unamɨkɨ naime hakewa meuye'atɨka  
\q2 muhukuya witsikemɨtiyuxexeiya meta harawerieya mukumane,  
\q2 mɨtikukuyeni hepaɨ kwaiyatɨkaime kanihayewamɨkɨ.   
\q1
\v 19 'Etsiwa xeikɨa kɨyexi hɨritsie kaniyuhayewakɨmɨ  
\q2 nunutsitɨtɨ kaniyɨwemɨkɨ miti'inɨatakɨ.   
\s1 'Ixaheri nuiwarimama memuyuhayewaxɨ  
\q1
\v 20 'Iya tukaritsie 'ixaheri nuiwarimama memuyuhayewaxɨ  
\q2 meta Kakuwu kie kiekatari memukuwikwei  
\q1 tawariri hetsiena mepɨkatewiya  
\q2 kemɨ'ane tiwakwinitɨatɨ mɨwarukwi,  
\q1 matsi yurikɨ waparewiwame  
\q2 Yawé, Mɨpatsie 'Ixaheri hetsiemieme, kanihɨkɨtɨkamɨkɨ.   
\q1
\v 21 Memuyuhayewaxɨ mekani'axɨakuni,  
\q2 Kakuwu nuiwarieya memuyuhayewaxɨ mekani'axɨakuni Kakaɨyari Mɨtɨrɨkaɨye hetsɨa.   
\q1
\v 22 'Ixaheri,  
\q2 tsepanetɨ 'ateɨterima xiekari haramara tetsita mɨtika hepaɨ memɨyupaɨme,  
\q2 memuyuhayewaxɨ xeikɨa mekani'axɨakuni.  
\q1 'Ari yakatiniutaniukieni memɨka'unarienikɨ,  
\q2 heitseriemekɨ katiniyɨmɨkɨ yuheyemekɨ.   
\q1
\v 23 Karikɨ Ti'aitame, Yawé Naimekɨmɨtɨrɨkaɨye,  
\q2 yakatinaye'atɨamɨkɨ mika'unakɨ kemutayɨ  
\q2 mɨkɨ nuiwari.   
\p
\v 24 'Ayumieme, Ti'aitame mɨpaɨ paine, Yawé Naimekɨmɨtɨrɨkaɨye:  
\q1 «Neteɨterima, Tsiyuni xemɨtama,  
\q2 'Atsiriya pepɨkamakaka.  
\q1 Tsepanetɨ yu'itsɨkɨ mɨmatsi'uwa  
\q2 meta tsepa kɨye 'iwaɨyɨpame manukukwei,  
\q2 'Ekipitu mɨtiuyuri hepaɨ.   
\q1
\v 25 'Ena mɨtiyehane yapaɨmexɨa tukari 'anukayayu  
\q2 neha'atɨ 'ahepaɨtsita nepɨtihayewa,  
\q2 meta nehaxɨa memɨmetsi'aye'unie kaniwaka'unamɨkɨ».   
\b  
\q1
\v 26 Yawé Naimekɨmɨtɨrɨkaɨye  
\q2 kawayatsixi wawayamekɨ kaniwatiwamɨkɨ,  
\q1 Mariyani kemɨtiuka'unaxɨ hepaɨ  
\q2 'Urewi 'aiyaritsie.  
\q1 Haramara hetsie yu'itsɨ kaneutatseramɨkɨ,  
\q2 'Ekipitu kemɨtiuyuri.   
\q1
\v 27 'Iya tukaritsie  
\q2 mɨkɨ 'ika 'anaiparitsie pemetɨkɨ pekaninawairiemɨkɨ  
\q1 meta waɨkawa pemɨtawaiyatakɨ  
\q2 yuku 'akwipitɨa pemateka kananumurimɨkɨ.   
\b  
\q1
\v 28 'Ayati paitɨ kaninuamɨkɨ rayuye'uniekame,  
\q2 Mikuruni kaniuyeyeimɨkɨ,  
\q2 meta yupiinite Mikimatsi katiniku'eirimɨkɨ.   
\q1
\v 29 Mayekuni 'uyaka, mɨpaɨ kanaineni:  
\q2 «Kehewa tekananukutsikuni».  
\q1 Xama kaniuyɨyɨakani marikakɨ,  
\q2 meta Kiweya kiekatari, Tsahuri kiekarieya mepuyuta'unaxɨ.   
\q1
\v 30 Karini niweya witsipemɨti'ɨimari, karima keneutahiwa.  
\q2 Rahitsi, keneu'ena.  
\q2 Xɨa'ui 'Anatuti.   
\q1
\v 31 Marimena kaniuyuta'una,  
\q2 Kewini kiekatari hakewa memeyuti'awieta mekaniwautɨweni.   
\q1
\v 32 Hikɨtɨtɨ Nuwi mekaniwa'uikuni,  
\q2 yumamá kanitakatsimɨkɨ hɨri hepaɨtsita  
\q2 Tsiyuni niweya witsimɨti'ɨimari kiekariyaritsie,  
\q2 Kerutsareme hɨriyaritsie.   
\b  
\q1
\v 33 Xekeneuxeiya. Ti'aitame, Yawé Naimekɨmɨtɨrɨkaɨye,  
\q2 kɨyexi pɨtimura yemekɨ waɨkawa tɨrɨkaɨyemekɨ.  
\q1 Kɨyexi 'amɨtɨtɨ kanawitekiexɨamɨkɨ,  
\q2 matsi waɨkawa 'amutɨtɨ kanatixɨriwani.   
\q1
\v 34 Hatsakɨ 'ɨtsi 'amayetsuye kanayewitewani,  
\q2 meta Riwanu witsimɨtiyuxexeiyakai puwakapenixɨ.   
\c 11  
\s1 'Itsahi yɨrariyari  
\q1
\v 1 'Itsahi kutsunuyaritsie xewitɨ yɨrari kananemɨkɨ,  
\q2 mɨkɨ yɨrari nanaritsie kananemɨkɨ.   
\q1
\v 2 Yawé 'Iyarieya mɨkɨ hetsie kanika'uxipiemɨkɨ:  
\q2 'iyari mɨtimaiwenikɨ meta meti'enatɨyeikanikɨ,  
\q2 'iyari 'ɨxatsi mexeiya meta tɨrɨkariya,  
\q2 'iyari waɨkawa mɨrakumate meta Yawé mayemakaxe.   
\b  
\q1
\v 3 Mɨkɨ puyutemawieka Yawé 'ayemakatɨ,  
\q2 kemɨtinierekɨ mɨkɨkɨ pɨkawaxanetani,  
\q2 meta yapɨkatiyurieni kemɨti'enakɨ,   
\q1
\v 4 matsi heitseriemekɨ 'aixɨa pɨtiyurieni memɨnanaimarie wahetsiemieme,  
\q2 meta 'aixɨa pɨtiyurieni  
\q2 tixaɨtɨ memɨkatehexeiya wahetsiemieme 'ena kwiepa.  
\q1 Kwie pɨka'una kɨye 'iwaɨyɨpame yuteta miemekɨ,  
\q2 'axatiyuruwame yu'iiyakɨ pumieni.   
\q1
\v 5 Tita mɨtiheitserie hɨiyame yunaiparie manakateika pɨhɨkɨtɨni  
\q2 meta yuri mɨraine hɨiyame manakuteika pɨhɨkɨtɨni.   
\b  
\q1
\v 6 Yawi muxa hamatɨa 'apuyeikani,  
\q2 tɨwe tsipu 'etsimupe hamatɨa pukuhuneni,  
\q1 meta tsikeru temaikɨ meta maye temaikɨ yuhamatɨa mepuku'uwani,  
\q2 nunutsi 'etsiyumaitɨ pɨwaku'arieneni.   
\q1
\v 7 Wakaxi hutse 'ukaratsi hamatɨa pɨtitikwani,  
\q2 waniwema yuhamatɨa mepukuhitɨweni,  
\q2 meta maye tuuru hepaɨ 'ɨxa pɨtikwani.   
\q1
\v 8 Nunutsi mɨtsitsewe kuu 'amumu'uyewa 'uaye mumɨya mexeiya  
\q2 muwayekie 'aurie pɨtiwaika,  
\q1 meta nunutsi yutsitsi muku'eiritsitɨarieke  
\q2 kuu 'ituayatsie peukameni.   
\q1
\v 9 Xewitɨ pumaweni 'axamɨwayurienikɨ meta mɨtiwakwinitɨanikɨ  
\q2 nehɨri naitɨ mɨpatsie hetsie,  
\q1 kwie kanitahɨnimɨkɨ  
\q2 Yawé memaitɨ memakɨne mɨ'ayumiemekɨ  
\q2 haramara hakɨ kemɨranatiyeuriwe hepaɨ.   
\b  
\q1
\v 10 'Iya tukaritsie 'Itsahi nanarieya panukukeni  
\q2 teɨteri wa'inɨari hepaɨ,  
\q1 mɨkɨ hepa nuiwarite mepɨtinautsa,  
\q2 meta witsi'anetɨ payani hakewa mɨkɨ metayerɨni.   
\q1
\v 11 'Iya tukaritsie Yawé tawarita yumamá kaneutatseramɨkɨ  
\q2 yuteɨterimama memuyuhayewatɨwe muwakuxeɨrienikɨ,  
\q1 'Atsiriyatsie memuyuhayewaxɨ,  
\q2 'Ekipitu, Paturutsi meta Kutsi,  
\q1 'Erami, Tsinaxi meta Kamati,  
\q2 meta haramara hatetsitayari 'ametetewatsie.   
\q1
\v 12 Patera panuwieni nuiwarite wahetsiemieme,  
\q2 'ixaheritsixi memutaweiyarie puwaxeɨrieni,  
\q1 naitsarie kwiepa  
\q2 Kura nuiwarimama memeutaweiyariexɨa puwakuxeɨrieni.   
\q1
\v 13 'Epɨrahini 'ɨtetsarikaya pukumawere,  
\q2 Kura memaye'unie mepukumaweriyarieni,  
\q1 'Epɨrahini Kura tawariri pɨkatitikwatsirieni,  
\q2 Kura 'Epɨrahini tawariri waɨriyarika pitɨatɨ pɨkatita'aitɨani.   
\q1
\v 14 Yunaitɨ tau makayuyuipike hepatsie mepeutayune,  
\q2 piritsiteutsixi wakwie mukɨatsie mepɨwatakwini,  
\q1 yunaitɨ tau manatineika kiekatari mepɨtewanawatsirieni,  
\q2 'Erumi meta Muhawi wahetsie mepɨteta'aita,  
\q2 metatsiere 'amunitsixi mekateniwata'aitɨakuni.   
\q1
\v 15 Yawé 'Ekipitu haramarayari kanikawatsiɨxamɨkɨ,  
\q2 yumamá haa 'Eupɨrate hetsie kaneutatseramɨkɨ,  
\q2 meta 'eka xɨkame kanikuwiwimɨkɨ,  
\q1 'atahutame 'akiyari kaniuyetuamɨkɨ  
\q2 mana memɨkɨnekɨ yukakaitsie me'u'utɨ.   
\q1
\v 16 Teɨterimama memuyuhayewaxɨ wahetsiemieme,  
\q2 'Atsiriya memuyuhayewaxɨ wahetsiemieme,  
\q1 huye kanitixuawerimɨkɨ, kemɨtiɨyɨ hepaɨ 'ixaheritsixi wahetsiemieme  
\q2 'Ekipitu kepauka memayekɨtsie.   
\c 12  
\s1 Kwikari nɨawariyari  
\p
\v 1 'Iya tukaritsie 'ekɨ mɨpaɨ pepɨtayɨni:  
\q1 «Yawé, ne nepɨmetsinɨawani  
\q2 tsepanetɨ meripaitɨ nehepaɨtsita pemɨtiuyeha'akai.  
\q1 Peha'atɨ pepɨtiuhayewaxɨ,  
\q2 meta pekaneniɨnɨtɨaniri.   
\q1
\v 2 Kakaɨyari netsiwikweitsitɨwame kanihɨkɨtɨni.  
\q2 Hetsiena yuri nepɨti'erieka meta nepɨkaheumaka.  
\q1 Yawé netɨrɨkariya kanihɨkɨtɨni,  
\q2 Yawé nekwikari pɨhɨkɨ,  
\q2 mɨkɨ netsiwikweitsitɨwame kanihɨkɨtɨni».   
\q1
\v 3 Xeme xeyutemamawietɨ haa xepuwatihanɨni  
\q2 wikweitsitɨarika hayaritsie.   
\p
\v 4 'Iya tukaritsie mɨpaɨ pɨtitaniukieni:  
\q1 «Yawé xekenenɨawani, xekenahɨaweni,  
\q2 kemɨtiuyuri xekenekuxatani teɨteri watsata,  
\q2 xekenekuxatani kemɨtimariwe kemɨtitewakɨ.   
\q1
\v 5 Yawé hetsiemieme nɨawari xekeneutikwikani,  
\q2 mariwemekɨ mɨtiyuriene,  
\q1 'ikɨ mɨpaɨ ketiutaxatsieni  
\q2 kwiepa naitsarie.   
\q1
\v 6 Keneutakwikani meta keneutahiwani temawierikakɨ,  
\q2 Tsiyuni kiekatari,  
\q1 pumariwe yurikɨ, 'ahamatɨa 'uyeikatɨ,  
\q2 Mɨpatsie 'Ixaheri hetsiemieme».   
\c 13  
\s1 Niuki Wawiruniya hepaɨtsita mieme  
\p
\v 1 Niuki Wawiruniya hepaɨtsita Kitsariyaxi 'Amuxi nu'aya kemɨtiuhekɨatsitɨiyarie:   
\q1
\v 2 Xeime hɨri metsekame hetsie patera xekeneuyuitɨwani,  
\q2 kuyaxi xekeniwarutahɨawi xe'utihiwatɨ,  
\q1 yumamakɨ xekeniwaru 'inɨaritɨa  
\q2 'itupari meuwietsie memɨxikutsixi wakitenie memeutahaxɨanikɨ.   
\q1
\v 3 Memɨpatsie nehetsɨa miemete nekatiniwaruta'aitɨaniri,  
\q2 nekuyaxima nekaniwaruta'inieni,  
\q1 memuyutemamawie nemɨrayu'iwakɨ,  
\q2 memɨnetsiparewienikɨ 'iya nemɨtiwakwinitɨanikɨ.   
\q1
\v 4 Neuxei xekeneu'enana. Hɨritsie meyuwaɨkawatɨ wayuariya pa'eniɨriɨkɨ,  
\q2 yuwaɨkawatɨ wa'atɨ muwa mepɨtehahu.  
\q1 Neuxei xekeneu'enana. Yuwaɨkawatɨ te'aitamete wayuarika pa'eniɨriɨkɨ,  
\q2 nuiwarite memuyukuxeɨri.  
\q1 Yawé Naimekɨmɨtɨrɨkaɨye kaniwakuha'aritɨamɨkɨ  
\q2 kuyaxi memuyukwiyutsie.   
\q1
\v 5 'Ateewa kwieyaritsie mekaneyekɨne,  
\q2 kwie manuye'atɨkatsie paitɨ.  
\q1 Yawé yuhaxɨakɨ yuha'aritɨatɨ 'ukanamieni  
\q2 naime kwie mɨka'unakɨ.   
\q1
\v 6 Xekeneutitsuanani, Yawé munuanikɨ kanehuraniri.  
\q2 Naimekɨmɨtɨrɨkaɨye hetsie yeyaka kaniwareuyehɨamɨkɨ.   
\q1
\v 7 'Ayumieme mamate naitɨ kanitiweranareni,  
\q2 teɨteri yunaitɨ mekayuwaɨriyatɨ mekaniyukuhayeikawani.   
\q1
\v 8 Yunaitɨ mekanimamaka,  
\q2 kukuiniya meta hiwerika kaniwawiyani:  
\q1 kukuiniyakɨ mekaniyu'uimɨratɨweni,  
\q2 memɨniwetuweni hepaɨ.  
\q1 Me'akamamatɨ, yuxexuitɨ mekananuyutaxexeiyani,  
\q2 yuhɨxie me'ayexetatɨ.   
\q1
\v 9 Neuxei. Yawé 'ari tukarieya kanaya'aximeni  
\q2 ―tukari 'axamɨ'ane, haxɨa tukariyari―,  
\q1 kwie 'akumaweme kanayeitɨamɨkɨ  
\q2 meta 'axateyuruwamete kaniwarakumaweriyamɨkɨ.   
\q1
\v 10 Xurawetsixi meta taheima temiemete  
\q2 mehekɨariewietɨ mekatenihayewakuni,  
\q1 tau 'anatineximetɨ kaniyɨrimɨkɨ  
\q2 meta metseri pɨkahekɨariwieni.   
\q1
\v 11 Kwiepa memɨtama 'axakememɨteyuriekɨ nepɨtiwakwinitɨani,  
\q2 meta 'axateyuruwamete 'axamemɨteyuriekɨ.  
\q1 Memɨteyukananaima kememɨte'uyuti'ɨre nekaneutiparitɨamɨkɨ  
\q2 memamariwaweme memuyuxata memuyuti'ɨre tixaɨtɨ nepɨkatiwarayeitɨani.   
\q1
\v 12 Teɨteri yakɨ meyupaɨmeme nekaniwarayeitɨamɨkɨ keyuri huru 'aixɨa mɨ'ane,  
\q2 teɨteri memɨkwiwawe yakɨ mepɨyupaɨmeni huru matsi 'apɨpaɨmeni 'Upixi mieme.   
\q1
\v 13 'Ayumieme yanepɨtiyurieni muyuawi mɨtayuanikɨ  
\q2 meta kwie hakewa meuyema mɨtayuanikɨ,  
\q1 Yawé Naimekɨmɨtɨrɨkaɨye haxɨayakɨ  
\q2 kepauka mɨyeha'ani tukariyaritsie.   
\q1
\v 14 Maxa 'ɨimari yeutanaka muweiyarieka hepaɨ,  
\q2 muxatsi memɨkatehekakutsiyari hepaɨ,  
\q1 yukie yuxexuitɨ mekani'axɨakuni,  
\q2 yuxexuitɨ yukwietsie mekaniyuta'unaxɨakuni.   
\q1
\v 15 Kemɨ'ane mɨwiyarieni mɨkɨ kananuyetsekiemɨkɨ,  
\q2 kemɨ'ane manutahɨiyani 'ixiparakɨ kanemieriemɨkɨ.   
\q1
\v 16 Menenierekaku,  
\q2 waniwema mekanititetseweiyakuni,  
\q1 wakiita katininawariemɨkɨ  
\q2 meta wa'ɨitama wahamatɨa waɨriyarika mewapitɨatɨ mekanikahikuni.   
\q1
\v 17 Neuxei. Ne merutsixi nekaniwata'inimɨkɨ mɨkɨ wahepaɨtsita,  
\q2 teɨteri pɨrata memɨkaheuyehɨwa  
\q2 meta hurukɨ memɨkayutemamawiekai.   
\q1
\v 18 Yutupikɨ temari mekaniwaranuyemɨixɨakuni,  
\q2 nunutsi hukatsie mɨyeka mepɨkatinenimayata  
\q2 meta tɨɨri mepɨkawatinenimayata.   
\q1
\v 19 Wawiruniya, witsimɨtiyuxexeiya te'aitamete wahetsiemieme,  
\q2 karireutsixi memiheiwe'erie meta memuyuta'ɨrenikɨ mɨ'ayumieme,  
\q1 Tsuruma meta Kumuxa wahepaɨ katinanuyeyeimɨkɨ  
\q2 kepauka mɨkɨ Kakaɨyari mɨwaruka'unaxɨ.   
\q1
\v 20 Tawariri teɨteri mana mepɨkayutikitɨani,  
\q2 meta 'uxa'atɨni mana pɨkatikuyaxitɨ.  
\q1 Harawe tewiyari mukatewa tɨma mana yu'ixuriki kiiyari pɨkatawewieni,  
\q2 nimana tɨma muxatsi wahɨweme yumuxatsi pɨkawaka'uxipitɨani.   
\q1
\v 21 Mana teyukwa'amete makumawetsie kiekatari mekanika'uxipikuni,  
\q2 wakiita mikɨrixi mepɨtahɨne.  
\q1 Mana 'aruxi 'amemɨnene wakie payani  
\q2 meta tsipuri yeutari mana mepɨtitsuna.   
\q1
\v 22 Wakiita 'aixɨa mɨ'aneneta tsɨikɨri yeutari mepɨtitsuani,  
\q2 meta waparatsiyu witsimɨ'aneneta yawixi memayu'eririya mepɨtitsuani.  
\q1 Mɨkɨ huraya kanaye'aximeni,  
\q2 mɨkɨ tukarieya 'apɨkareutere.   
\c 14  
\p
\v 1 Yurikɨ, Yawé Kakuwu kanitinenimayatamɨkɨ, hekwamekɨta 'Ixaheri kananayexeiyamɨkɨ. Wakwietsie kaniwa'atɨamɨkɨ. Kɨkamete mekaniwatinɨikuni, Kakuwu nuiwarimama wahamatɨa mekaniyutinɨikuni.  
\v 2 Teɨteri yukwietsie mepɨwatanaki'erieni meta wakiekaritsie paitɨ mepuwatuayu. 'Ixaheritsixi teyu'uximayatsiriwamete 'ukitsi meta 'ukarawetsixi Yawé kwieyatsie mepɨwarayeitɨani, memɨwaraye'uniekai mekaniwaranutaxɨriekuni meta mekateniwata'aitɨakuni kemɨ'ane memɨtewa'aitɨakai.   
\p
\v 3 Kepauka Yawé kexemɨte'uka'eniwakaikɨ mɨxeka'uxipitɨani, kexemute'u'uximatɨarie meta waɨriyarika xepitɨarietɨ xemɨte'aitɨariekaitsie,  
\v 4 'ikɨ xatsika xepɨtaxata ti'aitame Wawiruniya hetsiemieme:  
\q1 Neuxei kereutiparixɨ waɨriyarika mɨtati'aitɨakai,  
\q2 meta haxɨaya kereutiparixɨ.   
\q1
\v 5 Yawé 'axateyuruwamete wakɨye kananumura,  
\q2 memɨmamariwawe wa'itsɨ pakamuraxɨ   
\q1
\v 6 haxɨakɨ meta yatiwaruwayatɨ  
\q2 teɨteri pɨtiwakwinitɨakai,  
\q1 haxɨa mɨkapariwekɨ  
\q2 nuiwarite mɨtiwa'aitɨakai meta puwaruweiyakai.   
\q1
\v 7 Kwie naitɨ 'aixɨa 'iyari kani'uxipieka,  
\q2 meta temawierikakɨ mekaniutihiwani.   
\q1
\v 8 Metsɨ huku meta kariuxa Riwanu mieme  
\q2 'ɨaritɨ mekaniutinaweni 'ahepaɨtsita, mɨpaɨ mekaniutiyuaneni:  
\q1 «Kepauka pematihɨiyatsie paitɨ,  
\q2 tawariri xewitɨ pɨkatatsihawitexɨawe».   
\q1
\v 9 Hutipaitɨ meukatewatsie, 'ahekɨ,  
\q2 teukiyapa putayɨyɨaka  
\q2 matsi'anunakeke,  
\q1 'ahekɨ mɨyapemuyɨkɨ mɨkite mepanutaneniere,  
\q2 kemɨ'ane kwiepa memanuyetekai.  
\q1 Yapɨtiyurie yunaitɨ nuiwaritetsie te'aitamete  
\q2 yu'uwenitsie memanuku'unikɨ.   
\q1
\v 10 Mɨkɨ yunaitɨ mekaniti'akuni mɨpaɨ mekametenikɨhɨaweni:  
\q2 «'Ekɨta pekaniutaweranaxɨani.  
\q2 'Ekɨtsɨari ta'iwa pekanihɨkɨtɨni».   
\q1
\v 11 'Ekɨ kepemɨtiyuta'ɨrekai teukiyapa kaneukahɨiyani,  
\q2 'a'aripa yuariyaya yunɨkame.  
\q1 Kwitsiteri watsata pekanikutsuni,  
\q2 meta harekuxi mekamaninɨkani.   
\q1
\v 12 Kekuta pe'ɨyɨka muyuawitsie pepanakahɨiya,  
\q2 xurawe tuxakɨta mieme.  
\q1 'Ekɨ, nuiwarite pemɨtiwa'aitɨakai,  
\q2 kwiepa pekaniukaweni.   
\q1
\v 13 'A'iyaritsie mɨpaɨ peputainekai:  
\q2 «Muyuawitsie paitɨ nepanutiyani.  
\q1 Ne'uweni mana paitɨ nepɨtakeni  
\q2 Kakaɨyari xurawetsiximama waheima.  
\q1 Tayeta mutiniere paitɨ nepɨtita'aita,  
\q2 kakaɨyarixi wahɨritsie paitɨ.   
\q1
\v 14 Nekananutiyeimɨkɨ haiwitɨri yekɨrita paitɨ 'emeutitewatsie,  
\q2 'Amutewi hepaɨ nekani'anekamɨkɨ».   
\q1
\v 15 Peru neuxei teukiyapa pepeukahɨiya,  
\q2 putsu 'emeukatewatsie.   
\q1
\v 16 Kemɨ'ane memɨmatsixeiya, kwi mepɨmatsikuxexeiya,  
\q2 meta kepemɨranuyeyanikɨ mɨpaɨ meputiyuane:  
\q1 «¿Kamɨtsɨ 'ikɨ kwie mutayuitɨwakai tihɨkɨ  
\q2 meta te'aitamete muwamariutakai,   
\q1
\v 17 kwie naime 'akumaweme mayeitɨwakai,  
\q2 wakiekarite mɨti'unakai  
\q2 meta memanutaxɨriya hatsuaku mɨkawatatuayakai?»   
\q1
\v 18 Yunaitɨ nuiwarite tewa'aitɨwamete  
\q2 'aixɨa 'anemekɨ mepu'uxipie,  
\q2 yuteukiyapa yuxexuitɨ.   
\q1
\v 19 Matsi 'ekɨ teukiya kameniuhayani  
\q2 kɨye kutsunuyari mutaxainixɨ hepaɨ.  
\q1 Kemɨ'ane 'ixiparakɨ memukwi'iwaxɨ,  
\q2 kemɨ'ane teukiyapa tetɨata memeukakɨ,  
\q1 mɨkɨri naime mepɨmatsi'anukana.  
\q2 Mɨki ketsinariekame hepaɨ pekani'aneni.   
\q1
\v 20 Te'aitamete wahamatɨa teukiya pehexeiyatɨ pepɨka'ayani,  
\q2 'akwie pemuka'unaxɨkɨ  
\q2 meta 'ateɨterima pemɨwarukwikɨ.  
\b  
\q1 Tawariri pɨkataxatsieni  
\q2 'axateyuruwamete wanuiwari.   
\q1
\v 21 Wapaapama 'axamemɨte'uyurikɨ,  
\q2 xekeneukuha'arita niwemama hakewa memekwi'iwakɨ.  
\q1 Mepɨka'anuku'uweni kwie wahetsie mɨtinakenikɨ  
\q2 meta kiekaritekɨ kwiepa mepɨkahakɨnɨtsani.   
\b  
\q1
\v 22 «Ne mɨkɨ wahepaɨtsita nekananukukemɨkɨ  
\qr ―Yawé mɨpaɨ kanaineni―.  
\q1 Ne Wawiruniya nepɨka'una  
\q2 kemɨtitewakɨ meta nuiwarieya,  
\q2 tsutumeyari meta 'imatɨreme  
\q2 ―Yawé mɨpaɨ kanaineni Naimekɨmɨtɨrɨkaɨye―.   
\q1
\v 23 Naikatsi 'ɨtsita kiekatari wakie nepayeitɨani,  
\q2 haa mayema,  
\q1 meta tiyu'uname matsikɨiyarikɨ nepeku'itieni»,  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni.   
\s1 Niuki 'Atsiriya hepaɨtsita mieme  
\q1
\v 24 Yawé Naimekɨmɨtɨrɨkaɨye kaniyuhɨritɨani:  
\q2 «Yemekɨ kenemɨtiku'eriwa, mɨpaɨ katinaye'amɨkɨ,  
\q2 kehepaɨ nemɨtiyurienikekai, mɨpaɨ katiniyɨmɨkɨ.   
\q1
\v 25 'Atsiriya 'ena nekwiepa nekanika'unamɨkɨ,  
\q2 nehɨritetsie nekanitiketsixɨamɨkɨ.  
\q1 Neteɨterima mɨkɨ yuku hetsɨana mieme me'anuyetetɨ mekatenihayewakuni,  
\q2 'ari wanaiparietsie mɨkɨ 'ika pɨkahahetere».   
\q1
\v 26 'Ipaɨ nekatiniyurimɨkɨni  
\q2 naime kwie hetsie,  
\q1 'ikɨ kanihɨkɨtɨni nemamá nemeutatsera  
\q2 nuiwarite yunaime wahetsie.   
\q1
\v 27 Xɨkari mɨpaɨ tiɨyɨhɨawe Yawé Naimekɨmɨtɨrɨkaɨye,  
\q2 ¿kemɨ'ane pɨyɨwe mita'imaiyakɨ?  
\q1 Xɨkari mɨkɨ yumamá hautatserani,  
\q2 ¿kemɨ'ane pɨyɨwe muwaketɨanikɨ?   
\s1 Niuki piritsiteutsixi wahepaɨtsita mieme  
\p
\v 28 'Ikɨ niuki Kitsariyaxi hetsie kaninuani kepauka ti'aitame 'Akatsi mumɨ mɨkɨ wiyaritsie:   
\q1
\v 29 Piritsiteutsixi yunaitɨ xeme,  
\q2 xepɨkayutemamawieka kename 'akamurixɨ  
\q2 'itsɨ kɨmana pemɨtiweiwakai,  
\q1 matsi kuu xewitɨ kanayenemɨkɨ  
\q2 kuu nanayaritsie,  
\q2 mɨkɨ nuiwarieya kuu hawiwetɨ kanayeimɨkɨ.   
\q1
\v 30 Kemɨ'ane memɨnanaimarie muxatsi wahepaɨ mepɨtetikwani,  
\q2 memɨteheuyehɨwa 'aixɨa 'anemekɨ mepɨka'uxipieni.  
\q1 Matsi wananayari haakakɨ nepɨmieni,  
\q2 memuyuhayewa nekaniwaka'unamɨkɨ.   
\q1
\v 31 Keneutatsuakani meta keneutahiwani, kiekari 'ituparieya.  
\q2 Keneuyɨyɨakani marikakɨ, naitɨ Piritsiteu kwieyari.  
\q1 Matsi tayeta kuyaxi kɨtsi haiyari hepaɨ meteyuxexeiyatɨ 'umekanayehuni,  
\q2 meta nixewitɨ pɨkahanayeyeika yu'utuma kememɨtehewetɨka.   
\q1
\v 32 ¿Ke'aneme niuki tepɨwayetuirieni tupiritsixi mɨkɨ nuiwaritsie miemete?  
\q2 Kename Yawé Tsiyuni 'a'utake,  
\q1 mana memuyuti'awietakɨ  
\q2 teɨterimama memɨte'ukakukuine.   
\c 15  
\s1 Niuki Muhawi hepaɨtsita mieme  
\r (Kits 16:6-12 – Ker 48:29-36)  
\p
\v 1 Niuki Muhawi hepaɨtsita mieme:  
\q1 'Axi kiekariyari Muhawi kwieyaritsie mukuma, kaniuka'unarieni,  
\q2 xeitɨkariyaritsie kaneutipariyarieni.  
\q1 Kixi kiekariyari Muhawi kwieyaritsie mukuma, kaniuka'unarieni,  
\q2 xeitɨkariyaritsie kaneutipariyarieni.   
\q1
\v 2 Riwuni kiekatari tukita mekaneutahakeni,  
\q2 kakakaɨyarixi memɨte'atimawiyarɨwatsie, memɨtitsuanikɨ.  
\q1 Muhawi kaniutatsuakani  
\q2 Newu hetsiemieme meta Merewa.  
\q1 Yunaitɨ yumu'utsie mekanimu'uxirietɨkani,  
\q2 meta yɨmɨxiya naime mekanataxitɨkani.   
\q1
\v 3 Yunaitɨ, mekaniutitsuanani,  
\q2 kaye 'utɨma mekaniu'uwani, hiwerika kamixayari me'anakatɨtɨkaitɨ.  
\q2 Kii heima mekaniutitsuanani meta teɨteri memayukuxexeɨriwatsie.   
\q1
\v 4 Hetsiwuni meta 'Eraré karima mekaniutihiwani,  
\q2 Yahatsa mɨrakutewatsie paitɨ kana'eniɨriɨkɨni wahiwari.  
\q1 'Ayumieme memɨkamama muhawitsixi mekaniutihiwani,  
\q2 peru mekaniutiyɨyɨakani marikakɨ.   
\q1
\v 5 Ne 'iyari Muhawi hetsiemieme kaniutahiwani,  
\q2 memuyu'unatɨwe Tsuhaxi paitɨ mekanekɨkani,  
\q2 meta 'Ekɨrati-Tseritsiya paitɨ.  
\q1 Ruhiti paitɨ mekananutikɨkani me'utitsuatɨ,  
\q2 'uximatɨarikatsata, mekaniutihiwani me'u'uxetɨri  
\q2 Kurunahini huyeyari 'utɨma.   
\q1
\v 6 Haa kanakawaxɨani Nimirini mieme,  
\q2 tupiriya kaniutiyɨnare.  
\q1 'Ɨtsiri kaniumaweni,  
\q2 tiyɨratɨ tixaɨtɨ pɨkatiyuhayewaxɨ.   
\q1
\v 7 'Ayumieme mekatenetɨni,  
\q2 Hapuri 'akiyari manuyeka matsi huma paitɨ,  
\q2 waɨkawa piinitɨarika memɨte'ukuxeɨriekai.   
\q1
\v 8 Me'u'uxetɨ memutihiwa  
\q2 Muhawi kwieyari manuye'atɨkatsie paitɨ kaniumieni.  
\q1 'Ekɨrahini paitɨ watsuari kaniye'axeni,  
\q2 metatsiere Wexi-'Erini kaniye'axeni.   
\q1
\v 9 Rimuni hayaritsie xuriyakɨ pɨhɨpɨne,  
\q2 matsi tawarita kwiniya nekanikawiwimɨkɨ:  
\q1 xeime maye nepanɨnɨ'ani muhawitsixi memuyuta'unaxɨa wahetsiemieme  
\q2 meta kemɨ'ane 'akuxi kwiepa memu'uwani wahetsiemieme.   
\b  
\c 16  
\q1
\v 1 Muxatsi xekenanɨ'airi 'ikɨ kwieyaritsie mɨti'aita hetsɨa,  
\q2 Tseratsie meyekɨneme makumawetsie 'utɨa,  
\q2 meta Tsiyuni niweya hɨriyaritsie paitɨ.   
\q1
\v 2 'Ukarawetsixi muhawitsixi,  
\q2 'Axinuni mayekunitsie,  
\q1 wikixi memutamariutsieni hepaɨ mepɨteyuxexeiya,  
\q2 memamatɨ yu'itua memuku'e'eiriwa.   
\b  
\q1
\v 3 «Ketaneuta'ɨxatsitɨa,  
\q2 yaketineɨyɨhɨawi.  
\q1 Tuka yemekɨ muhekɨakatsie,  
\q2 'a'etɨriya kenetawerani tɨkarikɨ hepaɨ.  
\q1 Memuyuta'unaxɨa keniwaruti'awieta,  
\q2 memuyu'awieta pepɨkawaruku'e'eiriwani.   
\q1
\v 4 Muhawitsixi memuyuta'unaxɨa keniwarupitɨa  
\q2 'ahetsie memuyuti'awietakɨ.  
\q2 Keniwakweriwayurieka tiyuka'uname hepaɨtsita».  
\b  
\q1 Kepauka kememɨtekwinitɨariekai meutipare,  
\q2 meta kememɨteka'unarienikekaikɨ mana mɨtiu'anitsie,  
\q2 kwiepa mɨtatsi'aye'unie kanikumawerimɨkɨ.   
\q1
\v 5 Heitseriemekɨ 'uweni 'apuweni,  
\q2 xewitɨ Rawiri nuiwarieyatɨtɨ  
\q2 mana katinita'aitamɨkɨ 'aixɨa 'anemekɨ:  
\q1 'itsɨkame mɨ'ɨtetsa heitserie mɨtikuxatani kanayeimɨkɨ  
\q2 meta 'inaketɨ 'aixɨa mɨtiyurieneni.   
\b  
\q1
\v 6 Mɨpaɨ tekatenimaika Muhawi  
\q2 yemekɨ kaniyuta'ɨreni,  
\q1 tepɨtemate kemɨtiuyukatawe'erie,  
\q2 kemɨtiuyutamariwekata meta kemɨtiyukananaima,  
\q2 ke'axamɨtiuxaxata kayu'enietɨ.   
\q1
\v 7 'Ayumieme meputitsuana Muhawitsixi,  
\q2 mɨkɨ yunaitɨ Muhawi hetsiemieme meputitsuana.  
\q1 Xekeneutitsuanani, xekeneyuhiwerieka,  
\q2 kaxie patsaruyari tsuirayari Kixi-Karetseti miemekɨ.   
\q1
\v 8 Hetsiwuni mɨraka'etsitɨretsie katiniutiyɨnare,  
\q2 yaxeikɨata Tsiwima mieme kaxie haraweriyari.  
\q1 Nuiwarite tewa'aitɨwamete  
\q2 kaxie 'aixɨa mɨ'anenekai mekaniutiketsini,  
\q1 Katsexi paitɨ mɨye'axekai  
\q2 meta makumawetsie paitɨ mɨye'akai.  
\q1 Nanarieya 'ateewa pɨta'atɨkatei  
\q2 haramaratsie paitɨ pɨye'akai.   
\q1
\v 9 'Ayumieme neputatsuaka, Katsexi kemɨtiutatsuaka hepaɨ,  
\q2 kaxie Tsiwima miemekɨ.  
\q1 Xemeta, Hetsiwuni kiekariyari meta 'Eraré,  
\q2 ne'ukaikɨ nepɨxetihawiya.  
\q1 Temawierika hiwariyari pepeunuitɨa  
\q2 'a'ikwaxi witsitikwakwaxime meta kepemɨtika'inɨwekai hetsiemieme.   
\q1
\v 10 Harawerita pumaweri temawierika.  
\q1 Nixewitɨ kaxie harawerita pɨkaheyekwika meta pɨkahahiwa,  
\q2 nixewitɨ kaxie pɨkaketsinane muwatiketsinarɨwatsie,  
\q2 ne hiwari kaxie tsata mieme nekaneutiparitɨani.   
\q1
\v 11 'Ayumieme netaɨta neputayɨyɨaka Muhawi hetsiemieme,  
\q2 'aripatsie manutiwɨ hepaɨ puyɨne,  
\q2 naitɨ ne'iyari puyuane Kixi-Karetseti hetsiemieme.   
\q1
\v 12 Tsepa muhawi kiekatari kakaɨyarixi memɨte'atimawiyarɨwa memɨteheutahake,  
\q2 tixaɨtɨ mepɨkatekaxeiya matsi xeikɨa mepɨti'uxe,  
\q1 kepauka yutukita memuyunenewiyu,  
\q2 tsepa kememɨyɨa yakɨ xeikɨa mepɨyɨaka.   
\p
\v 13 'Ikɨ Yawé kaniniukieyatɨni meripaitɨ kemutayɨ Muhawi hepaɨtsita mieme.  
\v 14 Hikɨ matsi Yawé mɨpaɨ kanaineni: «Haika wiyari ka'anuyeyeiwekaku, ti'uximayatame kemɨtiu'inɨnɨata hepaɨ ti'inɨaritɨ, 'ana kemɨtimariwe Muhawi meta teɨterimama memɨyumɨire mepɨnanaimarieni, yayupaɨmetɨ xeikɨa mepuyuhayewa meta memɨwerarani mekaniyuhayewakuni».   
\c 17  
\s1 Niuki Ramatsiku hepaɨtsita mieme  
\p
\v 1 Niuki Ramatsiku hepaɨtsita mieme:  
\q1 «Ramatsiku xekeneuxeiya.  
\q2 Kiekariri pɨkahɨkɨtɨni.  
\q2 'Unitɨ kwinie netɨ kanikemɨkɨ.   
\q1
\v 2 Kiekarite 'Aruhexi mieme  
\q2 kaniku'eiriwamɨkɨ,  
\q1 'ɨ'ɨxayatɨ kanayeimɨkɨ mana muxatsi  
\q2 mekatenitikwaikuni nixewitɨ kawamariutakaku.   
\q1
\v 3 'Epɨrahini kiekari mɨtɨrɨkaɨye kaneuyehɨamɨkɨ,  
\q2 Ramatsiku ti'aitame kahexeiyatɨ kaniyuhayewamɨkɨ.  
\q1 'Arami memuyukuhayewaxɨ meta tita memɨtehexeiyakai  
\q2 mɨkɨ 'ixaheritsixi waniwema wahetsiemieme katinayeimɨkɨ  
\qr ―mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye―.   
\b  
\q1
\v 4 »'Iya tukaritsie  
\q2 Kakuwu kemɨtimariwekai kanitaweranaxɨamɨkɨ  
\q2 meta kemɨtiwaiyakai kanitawamɨkɨ.   
\q1
\v 5 Tɨriku 'itsaname hepaɨ kani'anekamɨkɨ,  
\q2 yumamakɨ tɨriku 'uriyari pɨka'itsana,  
\q1 kepauka 'uriyari manukutɨkieni  
\q2 Xepahini mayeweritsie hepaɨ pɨtiyɨni.   
\q1
\v 6 Peru hipatɨ puyuhayewa,  
\q2 kepauka huriwu manuyekatsiwa hepaɨ,  
\q1 hutatɨ yatɨni haikatɨ takari puyukuhayeikawa  
\q2 xawaritetsie meutitetewatsie,  
\q1 heiwatɨ naukatɨ yatɨni 'auxɨwitɨ  
\q2 naime xawarite kɨyeyaritetsie».  
\qr Yawé mɨpaɨ kanaineni, 'Ixaheri Kakaɨyarieya.   
\b  
\q1
\v 7 'Iya tukaritsie  
\q2 tewi, kemɨ'ane mitawewi pɨtiwauni,  
\q2 Mɨpatsie 'Ixaheri hetsiemieme kwi pɨxeiya.   
\q1
\v 8 Kakaɨyarixi memɨte'atimawiyarɨwari pɨkaxeiya  
\q2 mitiwewiekai,  
\q1 meta kakaɨyarixi 'Atserá 'ɨkiyarite pɨka'anakuxeiya,  
\q2 meta hakewa 'ɨkwa matitaiyakaitsie  
\q2 mɨtiutiwewiekai.   
\p
\v 9 'Iya tukaritsie kiekarite mɨtɨrɨkawi, muku'eiriwaxɨ 'ixaheritsixi ya'aneme meheutiwiwiexɨaku, kiekarite muku'eiriwaxɨ hepaɨ tiyuxexeiyatɨ kanayeimɨkɨ 'uhukuyatɨ meta 'u'ɨtsiyatɨ mayeika hepaɨ. Naitɨ 'akumawetɨ kanayeimɨkɨ.   
\q1
\v 10 'Akakaɨyari metsiwikweitsitɨwame pematɨmaikɨ,  
\q2 'ai mɨmatsitseiriya pemɨkahaye'erikɨ.  
\q1 'Ayumieme, tsepanetɨ 'iteɨri 'aixɨa 'aneme pemuka'iteɨtaxɨ  
\q2 meta tsepa kaxie 'ateewa mieme pemukayatsaxɨ,   
\q1
\v 11 tsepanetɨ tsipemɨtikuweriya 'apemɨtika'iteɨtaxɨtsie paitɨ,  
\q2 meta tsepanetɨ 'uxa'arieka pemitixutuitsitɨa,  
\q1 kukuiniya tukariyaritsie meta kwiniya mɨkayu'uayemarinɨa tukariyaritsie,  
\q2 tixaɨtɨ pɨkatikaxuawere.   
\b  
\q1
\v 12 Xɨa'ui yumɨiretɨ nuiwarite wayuarika.  
\q2 Haramara kemɨtiutapauwarɨka mɨpaɨ meputaine.  
\q1 Xɨa'ui teɨteri wahiwari.  
\q2 Wayuarika haa 'ateewa meukaxɨrɨweni hepaɨ meputaine.   
\q1
\v 13 Tsepanetɨ mɨkɨ teɨteri memutihiwa haa 'ateewa meukaxɨrɨweni hepaɨ tiyu'eniɨriɨkɨmekɨ,  
\q2 kepauka mɨkɨ mɨwarutate'a mepuyuta'una,  
\q1 'ekakɨ mepu'enitsitɨariexime  
\q2 xatsi hɨritetsie mieme hepaɨ,  
\q2 meta 'eka tɨrɨkaɨyetɨ kwauni mu'enitsitɨaximeni hepaɨ.   
\q1
\v 14 Kutaikaireyu, mekaniutimariutsiwani.  
\q2 Kakatariwekaku 'akuxi, mepukumamawere.  
\q1 Mɨpaɨta mepɨte'anuyekɨne kemɨ'ane memɨtatsitaweiya,  
\q2 mɨpaɨta ti'anetɨ wahetsie 'upɨramie kemɨ'ane takie memɨtenawatɨwe.   
\c 18  
\s1 Niuki 'Etihupiya hepaɨtsita mieme  
\q1
\v 1 Xɨa'ui kwie waɨkawa 'utsikari memutitsiwarɨkatsie  
\q2 Kutsi hatɨayarite manuyehetsie matsi humapaitɨ,   
\q1
\v 2 Niru hayari 'utɨma  
\q2 tupiritsixi pɨwarayenɨ'awa haka kanuwayaritsie.  
\b  
\q1 Xekeneuhuni, tupiritsixi kwinimieme xemayɨwawe,  
\q2 xeime kwieyaritsie teɨteri kwinie me'utɨtɨ memaxuawetsie meta yuwaiyaritsie meheumerɨkawitɨ,  
\q1 mɨkɨ nuiwari naitsarie kiekaritsie mɨmakaxiwa,  
\q2 mɨkɨ nuiwari mɨtɨrɨkaɨye mɨtiyu'aitɨwa,  
\q2 mɨkɨ kiekari haa 'anuyehapanekaku mukuma.   
\b  
\q1
\v 3 Kepauka hɨritsie  
\q2 'inɨari manukuhanieni meta kuxineta metayuani,  
\q1 xekeneyɨ'ɨwiya, kwiepa xemɨtama,  
\q2 xekeneu'enana, 'ikɨ kwietsie kiekatari.   
\b  
\q1
\v 4 Mɨpaɨ Yawé kanetiniutahɨawe:  
\q2 «Muyuawitsie paitɨ kayuwatɨ nehexeiyatɨ nekanakanierekamɨkɨ,  
\q1 tau xawatɨriyaya hepaɨ,  
\q2 haɨtsi hai kemɨranutinenetɨwa hepaɨ 'uxɨkakaku kepauka mɨtiuka'inɨiwatsie».   
\q1
\v 5 Katika'inɨiyawekaku 'akuxi,  
\q2 kepauka tuturi mɨkawiwieni meta kaxie takari mutikwakwaxe,  
\q1 'ana yɨrariyari kanikawitekiemɨkɨ  
\q2 meta xawari nanari naitɨ kanewatihunariexɨamɨkɨ.   
\q1
\v 6 Mɨkɨ naitɨ kaniku'eiriwamɨkɨ,  
\q2 wirɨkɨxi hɨritsie kiekatari  
\q2 meta yeutari teyukwa'amete wahetsiemieme katinayeimɨkɨ,  
\q1 witaritata  
\q2 kwixɨri wa'ikwai katinayeimɨkɨ,  
\q1 muhaɨtɨnitsieta,  
\q2 yunaitɨ yeutari teyukwa'amete.   
\p
\v 7 'Iya tukaritsie mɨkɨ teɨteri 'amemutɨtɨ meta yuwaiyaritsie memeumerɨkawi, teɨteri mɨkɨ naitsarie memɨmakaxiwa, mɨkɨ nuiwari memɨtɨrɨkaɨye memɨteyu'aitɨwa, wakiekari haa 'anuyehapanekaku mɨyema, Yawé Naimekɨmɨtɨrɨkaɨye mawari mekaniwewiriekuni. Tsiyuni hɨriyaritsie mekanenutɨkiriekuni hakewa mekiena kemɨtitewakɨ Yawé Naimekɨmɨtɨrɨkaɨye.   
\c 19  
\s1 Niuki 'Ekipitu hepaɨtsita mieme  
\p
\v 1 Niuki 'Ekipitu hepaɨtsita mieme:  
\q1 Yawé xekeneuxeiya.  
\q2 'Ekipitu kaniye'aka hai kwinimieme 'ayɨweme hetsie 'akaitɨ.  
\q1 'Ekipitu miemete kakaɨyarixi  
\q2 me'ixeiyatɨ mekaniutiyɨyɨakani,  
\q1 'ekipitutari wa'iyari  
\q2 kanitiweranareni.   
\b  
\q1
\v 2 «Yanekatiniyurimɨkɨ 'ekipitutari memayuye'uniekakɨ,  
\q2 yu'iwamatɨ mepuyutakwini,  
\q1 yuhamikumatɨ mepuyutakwini,  
\q2 kiekarite mepuyutakwini,  
\q2 te'aitamete mepuyutakwini.   
\q1
\v 3 'Ekipitutari mekayuwaɨriyatɨ mepakɨne  
\q2 meta yukakaɨyarixi mekaniwatahɨawikuni:  
\q1 meta mɨkite wa'iyarite,  
\q2 teyukewaiyamete meta mɨkite wahamatɨa memɨtekuxata meta memɨtehetimamateke,  
\q2 ne matsi kememɨteku'eriwa nepɨkawapitɨani.   
\q1
\v 4 Nepɨwapitɨani 'axamete'u'iyaritɨ memɨtewata'uximayatsitɨanikɨ,  
\q2 ti'aitame 'axatiuka'iyaritɨ katiniwata'aitɨamɨkɨ»,  
\q1 Ti'aitame mɨpaɨ kanaineni,  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye.   
\b  
\q1
\v 5 Niru hayari pakawani,  
\q2 xiekari xeikɨa wakitɨ pahekɨare.   
\q1
\v 6 Haa muhapanekaitsie 'axapɨraye'ɨatɨkani,  
\q2 meta 'Ekipitu 'akiyarite pakawaxɨani,  
\q2 yemekɨ 'uwakitɨ puyuhayewa.  
\q2 'Uwá meta haka hatetsita mieme kanitiyɨnarimɨkɨ.   
\q1
\v 7 Niru hatetsitayaritsie,  
\q2 haa hakewa meye'akai,  
\q2 naitɨ pɨkaretsiɨraɨyeniri.  
\q1 Niru 'aurie naitɨ mɨti'etsiekai  
\q2 'akumawetɨ puyuhayewa, pɨtikumawere.   
\q1
\v 8 Yunaitɨ ketsɨteweiyamete mepɨtitsuani mepuyutihiwerieni,  
\q2 Niru hetsie kemɨ'ane kwaitsɨ memeukawiwiwa,  
\q2 wipi memɨwiwietɨwe mekani'amɨxɨakuni.   
\q1
\v 9 Me'iyɨrietɨ mekanakɨnikuni memɨte'uximaya rinu 'aixɨa meyurietɨ,  
\q2 kememɨteta'ikwewa rinukɨ 'itsamete mekateneuyehɨakuni.   
\q1
\v 10 Mepɨ'iyɨrienita 'ixuriki memɨwewie,  
\q2 yunaitɨ te'uximayatamete mekaniyutihɨawikuni.   
\q1
\v 11 Tsuhani kiekatari memanuyetei 'atsimemɨkatemate mepɨhɨkɨ,  
\q2 'ɨxatsitamete waɨkawa memɨtemaiwawe  
\q2 Parahuni mepɨ'ɨxatsitɨa tixaɨtɨ 'atsimekatemaitɨ.  
\q1 ¿Titayari mɨpaɨ xete'ikɨhɨawe:  
\q2 «Ne xewitɨ memɨtemaiwawe nekanihɨkɨtɨni,  
\q2 te'aitamete meripaitɨ miemete memɨnete'uta'ɨkitɨa»?   
\b  
\q1
\v 12 ¿Kwinimieme pemɨtimaiwekai hakewa peyuhayewaxɨ?  
\q2 Peketiuxeitsitɨarieni meta peketiutaxatɨarieni  
\q1 Yawé Naimekɨmɨtɨrɨkaɨye  
\q2 'Ekipitu hepaɨtsita kemɨtiyurimɨkɨ.   
\q1
\v 13 Tsuhani kiekatari memanuyetei 'atsimemɨkatemate mepakɨ,  
\q2 Menipitsi kiekatari memanuyetei mepɨte'u'irɨwiyarie.  
\q1 Teɨteri watetexi memɨhɨkɨtɨkai tsikurita mieme  
\q2 'Ekipitu mepeuyehɨa kemɨtimiekai.   
\q1
\v 14 Yawé wahetsie pupitɨa  
\q2 'iyari 'iyɨriwame.  
\q1 'Ekipitu naimekɨ kemɨtiyuriene  
\q2 kemɨtimiekai mekaneiyehɨani.  
\q1 Tawekame mutahewa hepaɨ,  
\q2 'Ekipitu kanitakitsarietɨyeikani.   
\q1
\v 15 'Ekipitu hetsie 'aixɨa mutiuyurieni pɨkayɨwe,  
\q2 tsepa mu'uya mɨhɨkɨ yatɨni kwaxieya, yatɨni takɨ yatɨni haka.   
\p
\v 16 'Iya tukaritsie 'ekipitutari 'ukari wahepaɨ mepɨteyuxexeiyani. Meputiyɨyɨakani marikakɨ kepauka Yawé Naimekɨmɨtɨrɨkaɨye yumamá manukuhana 'iyuitɨwatɨ yukuha'aritɨwatɨ mɨtiwakwinitɨanikɨ.  
\v 17 Kura kwieyari 'ekipitutari mepimakaxeni. Yawé Naimekɨmɨtɨrɨkaɨye kemɨtiyurimɨkɨ wahepaɨtsita mieme, Kura kwieyari xɨka haterɨwarɨwani kemɨ'ane memi'enieni me'enaname waɨkawa meputimamaweni.   
\p
\v 18 'Iya tukaritsie 'Ekipitu kwieyaritsie 'auxɨwitɨ kiekari pukumare kananitari waniukikɨ me'utiniutɨ, Yawé Naimekɨmɨtɨrɨkaɨye hetsie memɨtewiyanikɨ yamepɨtiyuani. Mɨkɨ xewitɨ Tau Kiekariyari pɨtitewaka.   
\p
\v 19 'Iya tukaritsie Yawé hetsiemieme mawari taiyame xewitɨ 'Ekipitu kwieyari hixɨapa pɨtakeni, metatsiere kwieyari manuye'atɨkatsie tete pɨtakerieni Yawé hetsiemieme.  
\v 20 Mɨkɨ 'inɨari pɨhɨkɨtɨni 'Ekipitutsie ma'eriwanikɨ Yawé Naimekɨmɨtɨrɨkaɨye. Kepauka mɨkɨ Yawé memɨtahɨawe waɨriyarika memɨtewa'aitɨa wahepaɨtsita, mɨkɨ wawikweitsitɨwame kaniwaranɨ'airiemɨkɨ meta wahetsie nunuwame kaniwaxɨnamɨkɨ.  
\v 21 'Ayumieme Yawé 'ekipitutari wahetsie matsiɨkɨme kanayuyeitɨamɨkɨ, 'iya tukaritsie mɨkɨ Yawé mekanetimaikuni: mawari me'iwewirietɨ mekaneyexeiyakakuni hatsite mekateniyetuiriwakuni, Yawé hetsiemieme yamekateniyɨhɨritɨakuni meta mekateneye'atɨiriekuni.  
\v 22 Yawé 'ekipitutari katiniwakwinitɨamɨkɨ, tiwakwinitɨametɨtɨ kaniwa'uayemamɨkɨ. Mɨkɨ Yawé hetsɨa mekani'axɨakuni, mɨkɨ kaniwa'enimɨkɨ kememɨte'ikɨhɨaweni meta 'aixɨa meteheu'eriekame puwarayeitɨani.   
\p
\v 23 'Iya tukaritsie huye pɨtixuawere 'Ekipitu yehanetɨ 'Atsiriya ye'atɨ. 'Atsiriya kiekatari 'Ekipitu mepɨyehu meta 'Ekipitu kiekatarita 'Atsiriya mepɨyehu, yuxexuitɨ mɨkɨ meyunɨtɨ Kakaɨyari mepayexeiyani.  
\v 24 'Iya tukaritsie 'Ixaheri puhɨkɨtɨni, 'Ekipitu meta 'Atsiriya meyunɨtɨ, kwiepa memɨtama 'aixɨa mepɨ'itɨarieni wakɨmana.  
\v 25 Yawé Naimekɨmɨtɨrɨkaɨye 'aixɨa kaniwayurimɨkɨ, mɨpaɨ 'utaitɨ: «'Aixɨa kani'itɨarieka 'Ekipitu neteɨterima meta 'Atsiriya nemɨwarutawewi, metatsiere 'Ixaheri neteɨterima nemɨwaranayexei memɨhɨkɨ».   
\c 20  
\s1 Niuki 'Ekipitu meta Kutsi wahepaɨtsita mieme  
\p
\v 1 Kepauka kuyaxi tiwa'aitɨwame menɨ'arie 'Atsiriyatsie ti'aitame Tsarikuni meinɨ'a, 'Atsiruri kiekariyaritsie mekaniu'axɨani, 'ana mɨkɨ mekaniwarutakwini meta mekaniwara'iwa.  
\v 2 Mɨkɨ tukaritsie Yawé Kitsariyaxi hetsie kaniutaniuni 'Amuxi nu'aya. Mɨpaɨ katinitahɨawe: «Neuxei, hiwerika kamixayari pemanakatɨkɨ kenanutihɨna meta 'akakai». Mɨpaɨ Kitsariyaxi katiniuyurieni, heumawetɨ 'akaniuyeikakaitɨni meta heumamawetɨ.   
\p
\v 3 Hikɨ Yawé mɨpaɨ kaniutayɨni: «Mɨpaɨ kemɨtiuyeikakai nenɨ'ari Kitsariyaxi haika wiyari heumawetɨ meta kaheukakaitɨ, pɨ'inɨari 'Ekipitu meta Kutsi wahetsiemieme,  
\v 4 mɨpaɨta, 'ekipitutari memuyutetewiyanikɨ, ti'aitame 'Atsiriya kiekame kaniwaranuhapamɨkɨ memamaweme meta meka'ukakaikame, me'anamamaweme, 'ekipitutari mepanuhapanieni meta Kutsi kemɨ'ane memanutaxɨriyani, yaxeikɨa temari tsepa 'ukirawetsixi.  
\v 5 Kemɨ'ane 'Etihupiya hetsie memɨtewiya meta kemɨ'ane 'Ekipitu hetsiemieme memuyuti'ɨre mɨkɨ mepɨtimamani meta mepuyutitetewiya.  
\v 6 'Iya tukaritsie haramara tetsita kiekatari mɨpaɨ mepɨtiyuani: “Neuxei, mɨya mepɨte'anuyehu wahetsie temɨtetakwewiekai, wahetsɨa temeta'axekai parewiya teheuyehɨatɨ, ti'aitame 'Atsiriya tatsi'uweiyakaku tahetsie memɨtanuanikɨ. Hikɨtari, ¿hakewa tepeyuta'una?”»   
\c 21  
\s1 Niuki Wawiruniya hepaɨtsita mieme  
\p
\v 1 Niuki makumawe haramara 'aurie mukuma hepaɨtsita:  
\q1 Nekexi muyekɨka haikɨri mɨtɨrɨkaɨye hepaɨ,  
\q2 kwie makumawetsie xewitɨ kanayeneximeni mariwetɨ.   
\q1
\v 2 Mariweme nepɨtiuxeiyatsitɨarie  
\q2 nepɨtiuhekɨatsitɨiyarie:  
\q1 mɨtiyukwamana pɨtiyukananaimaka,  
\q2 tiyu'uname pɨtiyuka'unani.  
\q1 'Erami keneyumieneni. Meriya kiekatari xeiya xekeneyukwitɨweni.  
\q2 Naime hiwerika nepautiparitɨani.   
\b  
\q1
\v 3 'Ayumieme newaiyari puyɨyɨaka kukuiniyakɨ,  
\q2 'etsipemekɨ kukuiniyakɨ nepɨtiuka'eniwa,  
\q2 niweyame hepaɨ,  
\q1 ketitanemɨti'eniekɨ, nepɨtiuka'eniwa,  
\q2 ketita nemɨtixeiyakɨ, nemakame pɨnetsi'ayeitɨa.   
\q1
\v 4 Nepɨkaheneta'eriwa,  
\q2 nemariutsietɨ xeikɨa nepɨyɨyɨaka,  
\q1 taikai kwinimieme mɨnetinakekai  
\q2 hikɨri nepimakaxe.   
\b  
\q1
\v 5 Mɨkɨ mexate mana mepuku'uitɨa,  
\q2 'itari mekanikuwerani,  
\q2 mepɨtekwa'a meta mepɨte'ie.  
\q1 Xemanuyetei, 'axekeneti'uka.  
\q2 Xekenanuku'uti, yuheima nunuwame xekeneutiwiyama.   
\m
\v 6 Yawé mɨpaɨ kanetiniutahɨawe:  
\q1 «Kenemie, xeime tihɨweme keneuketsa,  
\q2 mɨtikuxatanikɨ naime kemɨtiniereni.   
\q1
\v 7 Kepauka kaxetate yukukuyamete kawayutsixi mehenawɨtɨakame mɨwaxeiyani,  
\q2 yatɨni teɨteri puxuri wahetsie me'utekame yatɨni kameyutsixi wahetsie,  
\q1 ke'uniere yukɨ'ɨwiyatɨ,  
\q2 waɨkawamekɨ yukɨ'ɨwiyatɨ».   
\m
\v 8 Tihɨweme kaniutahiwa:  
\q1 «Ti'aitame, tukari manukayeika,  
\q2 tuxiyutsie ne'akawetɨ nepɨkatihayewa,  
\q1 tɨkarikɨ mana nepukatariyarɨwa  
\q2 kenemɨtihɨritɨarie netita'ɨwiyatɨ.   
\q1
\v 9 Mana xewitɨ tewi kanamieni  
\q2 kaxetatsie kawayutsixi me'ehanatɨ.  
\q1 'Ikɨ kaniniukieyatɨni:  
\q2 “'Ari Wawiruniya kanatiweni, kanatiweni.  
\q1 Naitɨ kakaɨyariximama wa'ɨkiya  
\q2 kwiepa katinanukuheni”».   
\b  
\q1
\v 10 Neteɨterima, tɨriku mu'urie hepaɨ mɨ'ane,  
\q2 ne nekamatinaxaxatɨwani kenemɨtiu'enaxɨ  
\q1 Yawé Naimekɨmɨtɨrɨkaɨye hetsiemieme,  
\q2 'Ixaheri Kakaɨyarieya.   
\s1 Niuki 'Erumi hepaɨtsita mieme  
\p
\v 11 Niuki Rumaha hepaɨtsita mieme:  
\q1 Xewitɨ Tsehixi kwieyaritsie paitɨ pɨnetsihehiwie:  
\q2 «Tihɨweme, ¿'ɨyɨwitɨ 'akuxi kereutere?  
\q2 Ti'ɨwiyame, ¿mɨkahekɨarekɨ kereutere?»   
\q1
\v 12 Tihɨweme mɨpaɨ kaniutayɨni:  
\q2 «'Ari kanikahekɨarirɨmeniri, peru yaxeikɨata tɨkari 'ukanamieni.  
\q1 Xɨka xeheu'iwaukuni, xekeneku'iwawani,  
\q2 xɨka tawari xehayenexɨakuni xekenayenexɨa».   
\s1 Niuki 'Arawiya hepaɨtsita mieme  
\p
\v 13 Niuki 'Arawiya hepaɨtsita mieme:  
\q1 Kɨkamete Rerani kiekatari,  
\q2 makumawetsie 'akɨ'ɨtsiyakaku xemukutei:   
\q1
\v 14 mɨyeharimɨne xekenanunaki  
\q2 haa xekeneuharitɨa.  
\q1 Temaha kwieyaritsie kiekatari,  
\q2 yu'unamete 'ikwai xeketeniwarumikwa,   
\q1
\v 15 mɨkɨ 'ixipara memakatɨ mekaniyu'unarɨmeni,  
\q2 'ixipara mɨhekɨa,  
\q1 tupi karima mayuhapatɨka  
\q2 meta mɨrayukwitɨnetsie.   
\m
\v 16 Yawé mɨpaɨ kanetiniutahɨawe: «Xeiwiyari ka'anuyeyeiwekaku, ti'uximayatame mɨtiu'inɨnɨata hepaɨ ti'inɨatsieme, Tseraxi kemɨtimariwekai naitɨ kaneutiparimɨkɨ.  
\v 17 Temɨmɨmete 'etsiyupaɨmetɨ mekaniyuhayewakuni, Tseraxi kiekatari yukukuyamete, mana memutawikwei». Yawé mɨpaɨ kaniutayɨni, 'Ixaheri Kakaɨyarieya.   
\c 22  
\s1 Niuki Kerutsareme hepaɨtsita mieme  
\p
\v 1 Niuki mayeweri hepaɨtsita mieme kenemɨtiuxeiyatsitɨarie:  
\q1 Hikɨta kepeyɨane,  
\q2 kii heima paitɨ pepanutitɨa,   
\q1
\v 2 kiekari waɨkawamekɨ 'axamɨretainetsie,  
\q2 mepɨkayu'enie meta mepɨ'ietɨwe.  
\q1 'Ateɨterima nixewitɨ 'ixiparakɨ pɨka'umierie  
\q2 meta mepɨkahekwi'iwaxɨ mɨrayukwitɨnetsie.   
\q1
\v 3 Meyunaitɨ 'ahetsɨa memanuyetei mepuyuta'unaxɨ meyunɨtɨ,  
\q2 matsi mekaniutiwiyarieni  
\q2 tupi mekahapaxɨawawetɨ 'akuxi.  
\q1 Yunaitɨ pemuwaranutaxɨrie mekaniutiwiyarieni  
\q2 mexi'akuxi meyuta'unarɨmekai.   
\b  
\q1
\v 4 'Ayumieme mɨpaɨ neputayɨ: «Nexaɨtame xekeneneuhayewa,  
\q2 nekanitatsuamɨkɨ netiuka'eniwatɨ.  
\q1 Waɨriyarika xepɨkanetsikunɨtɨwani:  
\q2 Nekiekari niweya kaniuka'unarieni».   
\b  
\q1
\v 5 Ti'aitame, Yawé Naimekɨmɨtɨrɨkaɨye,  
\q2 yakaniutayɨni xeitukari marika mɨtixuawerekɨ,  
\q1 xeitukaritsie tixaɨtɨ temɨkate'ayeitɨarienikɨ meta temeuyuyexɨriekakɨ  
\q2 mayeweri nemuxeiyatsitɨarietsie,  
\q1 xeitukaritsie kuraru mɨka'unarienikɨ  
\q2 meta hɨritetsie temekahiwanikɨ.   
\q1
\v 6 Kaxetate yukukuyame hetsie me'utetɨ,  
\q2 'Erami yu'ɨrɨ kaniuti'ɨni,  
\q2 Kixi yuheima nunuwame kaniwaruxeiyatsitɨani.   
\q1
\v 7 Kaxetate yukukuyame pɨhɨpɨne  
\q2 mayeweri manayexeiyarietsie,  
\q2 'akitenie me'utetɨ mepuyutsaipɨna.   
\q1
\v 8 Kura kwieyari mɨyɨkɨhɨani pɨkayɨwe.  
\b  
\q1 Mɨkɨ tukaritsie xeme xepɨyu'ɨwiyaxɨ  
\q2 Paratsiyuta makukariuxaya kuyaxa timieme mɨtiyepikai.   
\q1
\v 9 Xepunenierixɨ Rawiri kiekariena  
\q2 waɨkawamexɨa meutahani pɨyɨwekai,  
\q1 haputsu kiekari hetɨamiemetsie  
\q2 haa xeputi'utaxɨ,   
\q1
\v 10 Kii Kerutsareme mieme xeputi'inɨataxɨ  
\q2 hipame xeputi'unaxɨ kuraru 'aixɨa xemuyurienikɨ,   
\q1
\v 11 huta kuraruyari tsata xeime haputsu xeputawewi  
\q2 haa mukamarekɨ haputsu meripaitɨ mieme taɨta,  
\q1 peru xepɨkayu'ɨwiyaxɨ kemɨ'ane mɨtiyurienekai,  
\q2 meta kemɨ'aneri meripaitɨ mɨpaɨ mutayɨkai.   
\b  
\q1
\v 12 'Iya tukaritsie Ti'aitame,  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye,  
\q1 pɨxe'utahɨawixɨ xemutitsuananikɨ xeyuhiwerietɨ,  
\q2 yumu'utsie xemuyukaxinikɨ meta xemuyutihiwerienikɨ.   
\q1
\v 13 Peru neuxei, temawierika puxuawe.  
\q2 Wakaitsixi mepɨmawarie, muxatsi mepɨtakwikwiwa,  
\q2 wai pukwaiya meta winu pɨ'iya.  
\b  
\q1 «Tepɨtekwaka tepɨ'ietɨweni,  
\q2 'uxa'a temɨkwinikɨri».   
\p
\v 14 Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanetiniu'enitsitɨiya: «'Ikɨ 'axakememɨte'uyurikɨ hatsuaku nepɨkatiwareuyehɨwirieni kepaukake memukwini. Ne nekanaineni Ti'aitame, Yawé Naimekɨnemɨtɨrɨkaɨye».   
\b  
\p
\v 15 Ti'aitame mɨpaɨ kanaineni, Yawé Naimekɨmɨtɨrɨkaɨye: «Kenemie Tsewina hetsɨa, paratsiyu mɨhɨritɨarie, mɨpaɨ ketinetahɨawi:   
\q1
\v 16 »“¿'Ena kepetiyuriene?  
\q2 ¿Kemɨ'ane heitserie pɨmatsi'upitɨa  
\q2 'uwa teukiya pemɨti'inekɨ?  
\q1 ¿Titayari meutitewatsie 'a'uxipiweme petiwewiene,  
\q2 ketitayari 'aitsie perewaye'ine?   
\b  
\q1
\v 17 »”Neuxei tewi pemɨtɨrɨkaɨye  
\q2 Yawé 'ari kameniwiyarɨmeni  
\q2 metsihehɨanike metsinanaimatɨ.   
\q1
\v 18 Perúta hepaɨ kametinikurupamɨkɨ,  
\q2 meta kwie 'ahakuyeumetsie kameneutahɨamɨkɨ.  
\q1 Mana pekanemɨmɨkɨ, manari kaniyuhayewamɨkɨ  
\q2 'akaxetate witsimɨ'anenekai kuyaxa miemete.  
\q2 Mati'aitɨwame kiita pekanitewiyatsitɨariemɨkɨ.   
\q1
\v 19 Nekamenanakahɨamɨkɨ kepemɨtihɨritɨarietsie,  
\q2 meta pemɨra'uximayatsie pekananayehɨiyamɨkɨ”.   
\p
\v 20 »'Iya tukaritsie neti'uximayatsiriwame 'Eriyakini Kirikiyaxi nu'aya nekanitahɨawimɨkɨ.  
\v 21 'Akamixa 'amɨtewi nepenakatɨtɨani, 'ahɨiyamekɨ nepenahɨani, kepemɨti'aitakai mɨpaɨ nepɨtihɨritɨani. Kerutsareme kiekatari wapaapa hepaɨ 'anetɨ payani meta Kura nuiwariyari wahetsiemieme.  
\v 22 Rawiri kiiya yawiyari naiparieyatsie nepayatsa, mɨkɨ tita mɨreuyepieni nixewitɨ mɨreunani pɨkayɨweni meta tita mɨkɨ mɨreunani nixewitɨ pɨkayɨweni mɨreuyepieni.  
\v 23 Kutsunu hepaɨ kwiepa 'a'uweme nekanikatsunamɨkɨ, meta 'uweni 'aixɨa mɨtixeiyarie hepaɨ pɨ'aneni paapaya xiɨyarimama wahetsiemieme.  
\v 24 Mɨkɨ hetsie pɨtiyeyani naitɨ 'aixɨa mɨti'ane waniwematsie: nuiwarimama neta wayɨrari, ye'ɨ 'etsimupe hetsie, tekɨxite hetsie meta ye'ɨrɨte hetsie.   
\b  
\p
\v 25 »'Iya tukaritsie ―Yawé mɨpaɨ kanaineni Naimekɨmɨtɨrɨkaɨye― kɨtsunu kanakainimɨkɨ makuweritsie muwe, kanahunariemɨkɨ nanari'ɨaritɨ kanatiwemɨkɨ, naime kemɨre'ikakai ratɨtɨ». Yawé mɨpaɨ kanaineni.   
\c 23  
\s1 Niuki Tiru hepaɨtsita mieme  
\p
\v 1 Niuki Tiru hepaɨtsita mieme:  
\q1 Xekeneutitsuanani, kanuwate Taritsi miemete,  
\q2 xekii meti'unariekɨ meta haramara tetsita xemuwa'axetsie.  
\q1 Tsipɨre kwieyaritsie paitɨ  
\q2 mana paitɨ me'u'uwatɨ mekateniutamarieni.   
\b  
\q1
\v 2 Kayuwatɨ xekeneumaka, haramara tetsita kiekatari,  
\q2 Tsiruni kiekatari tetuayamete,  
\q2 kanuwa nɨ'awamete waɨkawa metehexeiyame xemɨwarayeitɨa.   
\q1
\v 3 Haa mɨmamariwawetsie  
\q2 Tsikuxi hatsiyari kananetɨarieni,  
\q1 Tiru kiekariyari waɨkawa mɨratuiya patɨa nuiwarite wahetsiemieme,  
\q2 Niru hatetsitayaritsie mutiuka'etsiwakai mɨkɨkɨ waɨkawa mepɨte'ana'iwakai.   
\q1
\v 4 Tsiruni, keneyutewiyani, haramaratsie pemɨtiwiya,  
\q2 haramara mɨpaɨ kaniutayɨni:  
\q1 «Kemɨtiyukukuine niwenetɨ nepɨkatimate meta nepɨkaheyeniweya,  
\q2 tɨɨri nepɨkawareyewaweriya meta 'ukari nepɨkawareuta'ɨxatsitɨawe».   
\q1
\v 5 Kepauka 'Ekipitu niuki mɨye'ani,  
\q2 Tiru hepaɨtsita metemarietɨ mekaniyutihiwerikuni.   
\b  
\q1
\v 6 Taritsi xekeneuyekɨni,  
\q2 haramara tetsita kiekatari, xekeneutitsuanani.   
\q1
\v 7 ¿'Ikɨ xekiekari muyutemawie tihɨkɨ,  
\q2 kiekari meripaitɨ mieme,  
\q1 teɨterimama memeiwitɨ  
\q2 'ateewa paitɨ mekuyaxeke?   
\q1
\v 8 ¿Kemɨ'ane mɨyaputayɨ Tiru hepaɨtsita,  
\q2 kiekari piinite raye'atɨkaime mɨtitiwewiwakai,  
\q1 tetuayametemama memanuyetei mepɨhɨkɨtɨkai,  
\q2 meta wahamatɨa memɨte'uximaya naitsarie kwiepa mepɨmatiwakai?   
\q1
\v 9 Yawé Naimekɨmɨtɨrɨkaɨye hepaɨtsitana mɨpaɨ kaniutayɨkaitɨni  
\q2 kemɨ'ane kwinimieme mɨtiyuta'ɨre mɨka'unakɨ  
\q2 meta yunaime teɨteri memeuka'u kwiepa tixaɨtɨ mɨkatiwarayeitɨanikɨ.   
\b  
\q1
\v 10 Taritsi niweya,  
\q2 Niru hepaɨ 'akwie keneuka'etsa,  
\q2 'ari 'akanuwa muwaye'axekaitsie kaniukumaweni.   
\q1
\v 11 Yawé haramaratsie yumamá kaneutatsera,  
\q2 meta te'aitamete kaniwarutiyɨyɨakitsitɨani,  
\q2 meta katiniuta'aita Kanani kiekariyari 'aixɨa mɨ'ane mɨka'unarienikɨ.   
\q1
\v 12 Mɨkɨ mɨpaɨ kaniutayɨni:  
\q2 «'Ɨimari waɨriyarika 'ahamatɨa mɨtiukahitɨxɨ, Tsiruni niweya:  
\q2 tawarita peyutemawietɨ pepɨkahayani.  
\b  
\q1 »Kenanukukeka, Tsipɨre paitɨ 'anutaɨye kenanuye'a,  
\q2 peru yaxeikɨa mana 'aixɨa 'anemekɨ pepɨkatayerɨni».   
\q1
\v 13 Karireutsixi wakwie keneuxeiya.  
\q2 Mɨkɨ teɨteriyari mekaniumaweniri.  
\q1 'Atsiriya makumawetsie yeutari  
\q2 memayu'awieta wakie pɨta kanayeitɨani.  
\q1 Makeme me'utawewieka wakurarutsie mekaneukatsunaxɨani,  
\q2 wakii 'aixɨa mɨ'anenekai mekaniuti'una,  
\q2 naime 'u'unime mekaniuhayewa.   
\b  
\q1
\v 14 Kanuwate Taritsi mieme, xekeneutitsuanani,  
\q2 xekiekari 'aixɨa mɨ'ane muka'unariekɨ.   
\p
\v 15 'Iya tukaritsie Tiru kanatɨmaiyariemɨkɨ haika tewiyari heimana tamamata wiyari, ti'aitame kemɨreutetere 'ayenieretɨ. Peru mɨkɨ wiyari tixɨyu, kemanɨyɨne 'uka tuminikɨ muyuwitɨnɨa kwikariyari mɨpaɨ katiniyurimɨkɨ Tiru kiekariyari:   
\q1
\v 16 «'Ekɨ, 'uka tuminikɨ pemuyuwitɨnɨa,  
\q2 'aripa keneutikweka kiekari warita kenaye'a,  
\q1 yemekɨ kepemɨtiyɨwe ketineukayuitɨa,  
\q2 meta waɨkawa kwikari keneutikwika,  
\q2 'uxa'atɨniwarie pemuku'eriwanikɨ».   
\p
\v 17 Haika tewiyari heimana tamamata wiyari 'anuyeyayu, Yawé Tiru panukuketɨani, mɨkɨ tawarita puyutuani, tuminikɨ muyumayɨinɨa payuyeitɨani yunaime te'aitamete wahamatɨa.  
\v 18 Peru ketipaɨmeme mɨtiyetua meta kepaɨmeme mana'i'iwani Yawé hetsɨa mieme tipatsietɨ pɨrayeikani, pɨkati'utɨni meta pɨkatixeɨriyaka xeikɨa. Tita mɨrana'iwarieka Yawé hetsiemieme memɨte'uximaya wahetsiemieme pɨrayeikani, memɨteyumikwanikɨ 'anayuhayewamekɨ meta 'ixuriki witsimɨ'anenekɨ memuyukemaritɨakakɨ.   
\c 24  
\s1 Kwiepa ke'aixɨa mɨtiyɨni  
\q1
\v 1 Neuxei, Yawé kwiepa puwaka'una meta puwarakumaweriya,  
\q2 puwa'uximatɨa yunaime, meta mana kiekatari puwataweweiya.   
\q1
\v 2 Yaxeikɨata mepɨte'anuyekɨne  
\q2 mawari wewiwame meta teɨteri,  
\q2 'uki ti'aitame meta ti'uximayatame,  
\q2 'ukaratsi ti'aitame meta 'ukaratsi ti'uximayatame,  
\q2 tituayame meta tinaweme,  
\q2 tumini tiyuniniɨtɨwame meta yuniɨrɨweme,  
\q2 mɨrapiniyarie meta mɨrapine.   
\q1
\v 3 Kwie naitɨ kanakumaweriyarieni,  
\q2 yuheyemekɨ mekanakumaweriyarieni,  
\q2 Yawé mɨpaɨ mutayɨkɨ.   
\q1
\v 4 Kwie kaniwakini kaniyɨnani,  
\q2 'iteɨrite kaniyɨyɨnani meta kanitakukuweni,  
\q2 kwiepa memɨmamariwawekai mekaniweraranini.   
\q1
\v 5 Kwie puyutsewixima,  
\q2 mana kiekatari memiketsinakɨ,  
\q1 yamemɨkatekakɨkɨ 'inɨari niukiyaritsie,  
\q2 'inɨari niukiyari memɨkahanu'enikɨ,  
\q2 'aitsikate memeutitsanaxɨakɨ,  
\q2 tɨratu yuheyemekɨ mumieme mekaneutitsanaxɨani.   
\q1
\v 6 'Ayumieme kwie 'axa'itɨrietɨ kanitaxɨximeni,  
\q2 mana kiekatari wahetsie mɨrahɨiwakɨ.  
\q1 'Ayumieme tai kaniwaxɨtsitɨaka,  
\q2 yayupaɨmetɨ xeikɨa mekaniyuhayewatɨweni.   
\q1
\v 7 Winu mɨhekwa kaniukawani, meta kaxie kaniutayɨnare,  
\q2 naitɨ 'iyarite muyutemamawiekai meripaitɨ kaniyuhiwerietɨkani.   
\q1
\v 8 Tepu 'utiyuatɨri katiniuhayewa,  
\q2 temawierika 'ixɨarariyariri kaniukumawere,  
\q2 'aripa hayuatɨ katiniutahayewa.   
\q1
\v 9 Kwikamete me'utikwitɨ winuri mepɨka'ie,  
\q2 tarɨwekarixi wahetsiemieme winu patsiwiri.   
\q1
\v 10 Kiekari muyuxamurie 'unitɨ kaniyuhayewa,  
\q2 naitɨ kitenie pɨtiukaname.   
\q1
\v 11 Tsuari puxuawe kaye'utɨma winu mumawekɨ,  
\q2 naitɨ temawierika pukumawerixɨ,  
\q2 naitɨ temawierika kaniukumaweriyarieni.   
\q1
\v 12 Kiekari naitɨ kani'u'unini,  
\q2 'itupariyari 'etsiyeyeutɨ kaneutimaneni.   
\q1
\v 13 Mɨpaɨ kwie hixɨapa katiniyɨmɨkɨ  
\q2 nuiwarite wahetsie,  
\q1 kepauka huriwu takariyari mɨka'inɨiwatsie karima kuweiwatɨ hepaɨ,  
\q2 kepauka muyuhayewaxɨ mutiwawiwa hepaɨ  
\q2 matɨari mɨka'inɨiwatsie 'anuyeyayu.   
\q1
\v 14 Muyuhayewaxɨ paniuka meta kanahiwani temawierikakɨ,  
\q2 tau makayuyuipiketsie pahiwa Yawé mɨmariwe hahɨawetɨ.   
\q1
\v 15 'Ayumieme, tau manatineikatsie, Yawé 'aixɨa xeketenekuxatani,  
\q2 Yawé kemɨtitewa, 'Ixaheri Kakaɨyarieya,  
\q2 haramara tetsita mɨtiuyehanetsie mɨpaɨ xekenaitɨkani.   
\q1
\v 16 Kwie manu'axetsie paitɨ kwikarieya tekani'enieka:  
\q2 «'Aixɨa mɨtiuka'iyari 'aixɨa ketikuxaxatsiwani».  
\q1 Ne matsi mɨpaɨ nepaine: «Ne xɨa'ui.  
\q2 Kukuinari nehetsie pɨye'a».  
\q1 Kemɨ'ane memɨteyukananaima mepɨteyukananaima,  
\q2 'axamemɨte'u'iyari yamekateniyurieka kememɨteyurienikɨ.   
\q1
\v 17 Marika, mɨki teukiya meta winiyari  
\q2 mepɨxe'aye'unie, kwiepa xemɨtama.   
\q1
\v 18 Kemɨ'ane muyuta'una mɨkɨ hiwari makatɨ  
\q2 putsu 'emeukatewata kaneukawemɨkɨ,  
\q1 kemɨ'ane meukatewata muwatiyani  
\q2 winiyaritsie kaniyɨhɨamɨkɨ,  
\q1 katineuyepiekari muyuawitsie kitenie 'etsimayeyeutsie neniereme,  
\q2 meta kwie tsutɨmeyari kaniwatayuaneniri.   
\q1
\v 19 Kwie kaniutaxɨkeni, pɨkayuwiyamɨkɨ,  
\q2 kwie pukatsinetɨyeika, pukatarike,  
\q2 kwie putayuane yemekɨ waɨkawa putayuane.   
\q1
\v 20 Kwie pɨkitsariene tawekame hepaɨ,  
\q2 kɨyexi kiiyari hepaɨ kaniwatayuaneni.  
\q1 Waɨkawa pahete hetsiena 'axamɨti'ane mɨrexeiyakɨ,  
\q2 kanatiwemɨkɨ tawarita mɨka'anukukenikɨ.   
\q1
\v 21 'Iya tukaritsie Yawé katiniwakwinitɨamɨkɨ  
\q2 muyuawitsie tɨrɨkariya memexeiya  
\q2 meta kwiepa te'aitamete.   
\q1
\v 22 Xeime putsuta mekaneukaxɨriyakuni,  
\q2 pɨretsutsixi wahepaɨ katsariyanata memaye'u,  
\q2 'arike mɨixa tukari 'anukayayu mekatenikwinitɨariekuni.   
\q1
\v 23 Metseri kaniyɨrimɨkɨ  
\q2 tau kaniyutitewiyamɨkɨ,  
\q1 'ana Tsiyuni hɨriyaritsie,  
\q2 Kerutsareme hetsie,  
\q1 Yawé Naimekɨmɨtɨrɨkaɨye katinita'aitamɨkɨ,  
\q2 mana miemete 'ukirawetsixi mepixeiyani mariweme.   
\c 25  
\s1 Yawé hetsiemieme kwikari nɨawari  
\q1
\v 1 Yawé, 'ekɨ pepɨnekakaɨyari,  
\q2 'aixɨa nepaineni kepemɨtitewakɨ meta nepɨmetsinɨawani  
\q2 mariweme pemɨtiyurienekɨ.  
\q1 Meripaitɨ kepemɨtiyɨhɨawixɨ  
\q2 mɨpaɨ pepɨtiyuriene heitseriemekɨ.   
\q1
\v 2 Kiekari, 'uniyari kwiniemieme netɨ 'uweme pepayeitɨa,  
\q2 kiekari 'aixɨa mɨreukukurarutɨarie pepanuti'unaxɨ.  
\q1 'Ari 'ateewa kiekatari waparatsiyu kiekari pɨkahɨkɨ,  
\q2 tawariri pɨka'anukuketɨarieni.   
\q1
\v 3 'Ayumieme teɨteri metɨrɨkawitɨ 'aixɨa mepɨmatehahɨawe,  
\q2 nuiwarite 'axamemɨte'u'iyari wakiekari pɨmatsi'ayemakaxe.   
\q1
\v 4 'Ekɨtsɨ pemɨhɨkɨkɨ,  
\q2 kepauka memu'uximatɨariekatsie,  
\q1 tixaɨtɨ memɨkate'eriwa wa'inɨari,  
\q2 mɨreuyehɨwa hetsie nunuwame,  
\q1 wiyeri mɨtɨrɨkaɨye hepaɨtsita 'ewiweme hetsiemieme,  
\q2 'etɨriya xɨri hepaɨtsita mieme,  
\q1 Matsi, 'axamemɨte'u'iyari wahɨtsierikayari  
\q2 wiyeri mɨtɨrɨkaɨye hepaɨ kani'aneni kuraru mɨtse'i maye'unie,   
\q2
\v 5 xɨri makumawetsie mieme hepaɨ kani'aneni.  
\q1 'Ekɨ teewatari wayuariya kayuwatɨ pepɨkupitɨwa,  
\q2 xɨri haiwitɨri kemɨtixeriya hepaɨ,  
\q2 meta pepenukayunitɨa 'axamemɨte'u'iyari wakwikari.   
\b  
\q1
\v 6 Yawé Naimekɨmɨtɨrɨkaɨye, 'ikɨ hɨriyaritsie  
\q2 katinikuha'aritɨamɨkɨ yunaime teɨteri wahetsiemieme  
\q2 'ikwai 'ixɨarariyari witsiti'aneneme ranapikame,  
\q2 winu xeiwiyari mexeiya 'ixɨarariyari,  
\q2 'ikwaite 'aixɨa ti'anenekame meta winu 'aixɨa mɨ'ane xeiwiyari mexeiya.   
\q1
\v 7 'Ikɨ hɨriyaritsie kaneikutsanamɨkɨ  
\q2 'ixuriki teɨteri yunaime muwareukunama,  
\q2 meta matakɨ nuiwarite yunaime muwakanama.   
\q1
\v 8 Mɨki mɨɨya kanikumaweriyamɨkɨ yuheyemekɨ,  
\q2 Yawé naimekɨmɨyɨwe yunaime teɨteri kaniwara'ukaipiexɨamɨkɨ,  
\q1 meta naitsarie kwiepa  
\q2 teɨterimama memɨkananaimariekakɨri katinikumaweriyamɨkɨ.  
\qr Yawé yɨkɨmana mɨpaɨ kanaineni.   
\p
\v 9 'Iya tukaritsie mɨpaɨ pɨtitaniukieni:  
\q1 «Huu, 'ikɨ pɨtakakaɨyari,  
\q2 hetsiena yuri tepɨte'erieka, mɨkɨ pɨtatsi'utawikweitsitɨa.  
\q1 'Ikɨ pɨhɨkɨ Yawé, hetsiena yuri temɨte'erie,  
\q2 tepɨtatemamawieka tepuyutemamawieka wikweitsitɨarikayatsie».   
\b  
\q1
\v 10 Yawé tɨrɨkariyaya 'ikɨ hɨritsie puyuhayewa,  
\q2 peru Muhawi makumatsie pɨtaketsinarieni,  
\q2 'ɨxa mɨtiketsinarɨwa hepaɨ muwatiketsinaruwatsie.   
\q1
\v 11 Mana yumamá pɨtatseraxɨani,  
\q2 tewi hauweme hepaɨ.  
\q1 Peru Yawé kememɨteyuti'ɨre kaniwanawairiemɨkɨ,  
\q2 meta ke'axamɨtiyurimɨkɨ yumamatekɨ.   
\q1
\v 12 Kanika'unamɨkɨ, kanetihɨamɨkɨ meta kaniwatayuitɨamɨkɨ  
\q2 'akuraru 'amatitewa meta 'aixɨa mɨ'anene,  
\q2 kepaukake tumuanari mayani 'anake kanihayewamɨkɨ.   
\c 26  
\s1 Mɨrayu'iwaxɨ kwikarieya  
\p
\v 1 'Iya tukaritsie 'ikɨ kwikari pɨtakwikarieni Kura kwieyaritsie:  
\q1 «Kiekari tepexeiya tɨrɨkaɨyeme.  
\q2 Kuraru 'amatayewa hepaɨ, tahetsie nunuwame hepaɨ,  
\q2 Kakaɨyari yuwikweitsitɨarika pɨyetua.   
\q1
\v 2 'Itupari xekeneuyepi, meutahanikɨ  
\q2 nuiwari 'aixɨa mɨtiuka'iyari heitseriemekɨ yamɨtikamie.   
\q1
\v 3 'Aixɨa 'anemekɨ 'amuyeika  
\q2 pepipitɨani kayuwatɨ hexeiyatɨ 'amuyeikanikɨ,  
\q2 'ahetsie yuri mɨti'eriekɨ.   
\q1
\v 4 Yawé hetsie yuri xeketene'erieka yuheyemekɨ,  
\q2 Yawé 'ai mɨhɨkɨkɨ yuheyemekɨ.   
\q1
\v 5 Mɨkɨ memeuka'u pɨwaratixɨrɨwa  
\q2 meta puwaka'una kiekari muyuta'ɨre:  
\q1 pika'una kwiepa petihɨpa,  
\q2 kanetihɨpani tumuanaripa heutenime kanayeitɨwani.   
\q1
\v 6 Memɨkatɨrɨkawi meta memɨnanaimarie  
\q2 mekaniwatiketsinani yuketakɨ».   
\b  
\q1
\v 7 Heitserie mexeiya huyeya makuweri kanihɨkɨtɨni.  
\q2 'Ekɨ, heitseriemekɨ 'apemuyeika, huyeya 'akuwerime kenayeitɨirieka.   
\q1
\v 8 Yawé, huu, 'ahetsie tepɨta'ikwewa,  
\q2 petati'ɨkitɨakaku yatepɨtehetimamateke mɨpaɨ temɨte'u'uwanikɨ,  
\q1 kepemɨtitewa meta pemɨkahatɨtɨmaiyarɨwa  
\q2 mɨkɨ pɨhɨkɨ temeiyehɨwa tatukaritsie.   
\q1
\v 9 Tɨkarikɨ naime ne'iyarikɨ nepɨmatsi heuyehɨwa,  
\q2 ximeri ne'iyari pɨmatsi'utiwawa.  
\q1 Kepauka 'aixɨa pemɨtiyuriene kwiepa,  
\q2 kwiepa memɨtama mepɨtehetimamateke tita mɨtiheitserie.   
\q1
\v 10 Tsepa 'axamɨtiuka'iyari mɨnenimayatsie,  
\q2 pɨkaretimamateke tita mɨtiheitserie,  
\q1 'aixɨa mɨti'ane mɨraxuawetsie 'axapɨtiyuriene pɨta,  
\q2 Yawé kemɨtimariwe pɨka'imate.   
\b  
\q1
\v 11 Yawé, 'amamá pepanukuhana,  
\q2 peru mɨkɨ mepɨka'ixeiya.  
\q1 'Ateɨterima wahetsiemieme kepemɨti'ɨtetsa meke'ixeiya, 'ana meke'uyutitetewiya,  
\q2 taikɨ meke'utixɨtsitɨarieni  
\q2 memɨmetsi'aye'unie muwahetsiemieme.   
\b  
\q1
\v 12 Yawé, 'ekɨ kayuwatɨ pepɨxuawitɨa tahetsiemieme,  
\q2 'ekɨtsɨ pekanihɨkɨtɨni yapemɨtiyuriene naime ta'uximayatsikakɨ.   
\q1
\v 13 Yawé, takakaɨyari,  
\q2 hipatɨ te'aitamete meripaitɨ mepɨtate'uta'aitɨa,  
\q2 peru 'ahetsiemieme xeikɨa 'aixɨa tepaitɨka.   
\q1
\v 14 'Ari mepukwi, tawariri mepɨka'anutaneniere,  
\q2 'etɨri mepɨhɨkɨri, tawarita mepɨka'anuku'uni.  
\q1 'Ekɨ 'uximatɨarika pepɨwarupitɨa meta pepɨwaruka'unaxɨ,  
\q2 yapepɨtiuyuri memɨkaha'eriwanikɨri.   
\q1
\v 15 Yawé, 'ekɨ nuiwari mariweme pepayeitɨa,  
\q2 mariweme pepa'ayeitɨa meta witsipe'anetɨ pepe'ayeitɨa,  
\q2 kwie hakewa meuye'atɨkatei tawarita 'apepitayeuritaxɨ.   
\q1
\v 16 Yawé, 'uximatɨarikatsata mepɨmatsi'utiwau,  
\q2 nenewierikɨ 'etsiwa xeikɨa me'eniɨriɨkɨtɨ  
\q2 kepauka 'ekɨ pemɨtiwaruka'enitsitɨatsie.   
\q1
\v 17 Yawé, tame 'ahɨxie tepu'axɨa  
\q2 kepauka 'uka mayehuka hepaɨ te'utiyuatɨ  
\q1 mutahiwa yu'ɨimɨranetɨ kukuiniyakɨ  
\q2 kepauka mɨtiniwerɨmenitsie.   
\q1
\v 18 Tekaneyexeiya, tekaniyuti'ɨimɨra,  
\q2 peru 'eka xeikɨa tekanayexeiya.  
\q1 Kwiepa wikweitsitɨarika tepɨka'atɨa,  
\q2 meta kwiepa memɨtama mepɨka'utinunuiwaxɨa.   
\b  
\q1
\v 19 Peru 'ahetsie metewiyatɨ memukwi mepanutaneniere,  
\q2 wa'umete tukari hexeiyatɨ payani.  
\q1 Xekenanutanenieri xekeneutihiwani temawierikakɨ,  
\q2 tumuanaripa xemɨkiekatari.  
\q1 Haɨtsi 'ahetsɨa mieme, haɨtsi ximeri mieme hepaɨ kani'aneni,  
\q2 kwie meta yumɨkite puwayetuani.   
\b  
\q1
\v 20 Neteɨterima nehetsɨa miemete, yukiita xekeneutahaxɨa  
\q2 xeheutahaxɨame xeketeneunama,  
\q1 yaxeketeneuteri xeyu'awietatɨ,  
\q2 haxɨa hanuyeyayuke.   
\q1
\v 21 Xekenayeneniereni,  
\q2 Yawé yukiita kaniwayeyeimɨkɨ  
\q1 'axamemɨteyurie tiwakwinitɨanike  
\q2 kwiepa memɨtama.  
\q1 Kwie xuriya mutayeuriya kanihekɨatamɨkɨ,  
\q2 xuriya mana memutayeuri pɨkawa'awietaniri.   
\c 27  
\s1 'Ixaheri kemɨtiuxɨnarie  
\q1
\v 1 'Iya tukaritsie Yawé kuu Rewiyatahini mɨtitewa katinikwinitɨamɨkɨ,  
\q2 kwinimieme mɨrayu'unawe,  
\q2 kwinimieme mɨrakwinɨriwawe.  
\q1 Yu'ixiparakɨ mɨtiyumemiwakɨ, mɨmariwekɨ meta mɨtɨrɨkaɨyekɨ,  
\q2 kuu mɨmariwe kanimiemɨkɨ haramaratsie mɨyeyeika.   
\q1
\v 2 «'Iya tukaritsie kaxie nanari haraweriyari  
\q2 manayexeiyarie xekenenɨawani:   
\q1
\v 3 Ne, Yawé, 'ihɨweme nekanihɨkɨtɨni,  
\q2 tukarikɨ nekaxie nanayari yanekatinihatuiyani.  
\q1 Tukarikɨ tɨkarikɨ yanekatini'ɨwiyani  
\q2 nitixaɨtɨ 'axamɨkatiyurienikɨ.   
\q1
\v 4 Nepɨkaha'a.  
\q2 Xɨka 'ɨtsi meta xuya hexeiyani,  
\q1 ne nekanitamieweni  
\q2 meta naime nekaniutitaiyaweni,   
\q1
\v 5 xɨka mɨkɨ nemi'awietanikɨ yara'eriwanike  
\q2 nehamatɨa kayuwatɨ hexeiyatɨ 'ayuyeitɨani,  
\q2 huu, nehamatɨa kayuwatɨ hexeiyame ke'ayuyeitɨaka».   
\b  
\q1
\v 6 Tukari kanaye'amɨkɨ kepauka Kakuwu nanarieya manexɨani,  
\q2 kepauka 'Ixaheri mɨtayɨra meta mɨkaxutuni,  
\q2 kwiepa yu'ikwaxikɨ kanakɨnɨmɨkɨ.   
\q1
\v 7 Yawé pɨka'ikuwaxɨa  
\q2 kemɨ'ane memikuwayakai muwarukuwaxɨa hepaɨ.  
\q1 Pɨkawarukwi memɨteyumemiwa  
\q2 mutiwarukwi hepaɨ.   
\q1
\v 8 Kaniyuritɨni hetsiena kuyaxa kaniutixuawitɨani,  
\q2 kaneyeweiya yu'iiyakɨ  
\q2 'eka 'iiyayari tau manatineika miemekɨ.   
\q1
\v 9 Mɨpaɨ Kakuwu 'axakemɨtiuyurikɨ pɨti'itiyarieni,  
\q2 mɨpaɨ xeikɨa katiniyɨmɨkɨ  
\q2 'axakemɨtiuyuri mɨreuyehɨwiyarienikɨ:  
\q1 tetexi kakaɨyarixi memɨte'atimawiyarɨwa naitɨ tumuanari kehayani,  
\q2 tetexi mu'uniwe mɨtɨxieka hepaɨ,  
\q1 meta 'Atserá 'ɨkiyaya 'a'uwetɨ pɨkakuhayeikarɨwani  
\q2 meta mawari taiyame 'ɨkwa witsimu'ɨa nixewitɨ tɨma.   
\b  
\q1
\v 10 Kiekari 'aixɨa mɨreukukurarutɨarie panuka'unarie,  
\q2 mɨka'akukiepaya pɨhɨkɨ,  
\q2 makumawe muku'eiriwaxɨ hepaɨ.  
\q1 Muwa tsikeru kaneuta'ariwani,  
\q2 mana katiniutikwa'ani meta tupiriyate katinikwaka.   
\q1
\v 11 Kepauka mɨtiwauke, kɨyexiyari kanitimurikeni,  
\q2 hikɨ 'ukarawetsixi mekani'axeni kɨmana me'atinainike.  
\q1 'Ikɨ teɨteri memɨkayɨkɨhɨawe mekanihɨkɨtɨni,  
\q2 'ayumieme muwarutawewi pɨkawanenimaya,  
\q2 nitɨma pɨkawanenimaya kemɨ'ane mɨwarutawewi.   
\p
\v 12 'Iya tukaritsie Yawé tɨriku pɨtiketsini 'Eupɨrate hayari manuye'anetsie paitɨ 'itsutɨame 'Ekipitu hayari manuyekatsie paitɨ ye'atɨkaime, xeme 'ixaheritsixi yuxexuitɨ xepeu'itsanariexɨani xemukuxeɨriyanikɨ.  
\v 13 'Iya tukaritsie kuxineta mariwetɨ kanitahɨtsieriemɨkɨ. Kemɨ'ane 'Atsiriya memehapanie meta kemɨ'ane 'Ekipitu memanutaxɨriya mekani'axɨakuni Yawé memayexeiyanikɨ hɨri mɨpatsietsie Kerutsareme.   
\c 28  
\s1 Xɨa'ui 'Epɨrahini  
\q1
\v 1 Xɨa'ui memuyuti'ɨre wakuruna 'Epɨrahini kiekatari memɨtarɨwe,  
\q2 tutu mɨyɨna witsikemɨtiyuxexeiyakai,  
\q1 hɨri 'ayewerikaku 'aixɨa raye'anekaku muwe.  
\q2 Xɨa'ui winukɨ mematixɨri.   
\q1
\v 2 Neuxei, Ti'aitame xeime kanexeiyani  
\q2 tɨrɨkaɨyeme meta mariweme:  
\q1 Mɨkɨ kwiepa katinahɨamɨkɨ rananaimatɨ,  
\q2 tee mukaxɨrieni hepaɨ,  
\q2 'eka mɨtiyuka'una hepaɨ,  
\q2 wiyeri mɨhaikɨrima hepaɨ,  
\q2 haa muwayeneni hepaɨ.   
\q1
\v 3 'Epɨrahini memɨtarɨwe wakuruna kɨmana memuyuti'ɨre,  
\q2 kanitaketsinariemɨkɨ.   
\q1
\v 4 Mɨkɨ tutu mɨyɨna witsikemɨtiyuxexeiyakai,  
\q2 hɨri 'ayewerikaku 'aixɨa raye'anekaku mɨyewe,  
\q1 mexɨakame xapa mukwaxi kanayeimɨkɨ katika'inɨiyawekaku 'akuxi:  
\q2 xewitɨ 'ixeiyame yapauka 'eka'inɨme,  
\q2 kanitakwaimɨkɨ.   
\b  
\q1
\v 5 'Iya tukaritsie Yawé Naimekɨmɨtɨrɨkaɨye  
\q2 kuruna witsimɨtiyuxexeiya kanihɨkɨtɨkamɨkɨ,  
\q1 patsaruxi mutixawatɨre  
\q2 keyupaɨmetɨ memuyuhayewa mehe'eriwatɨ wahetsiemieme.   
\q1
\v 6 Mɨkɨ 'iyari pupitɨani heitseriemekɨ yamɨtiyurienenikɨ  
\q2 kemɨ'ane mɨtita'aita,  
\q1 meta kuyaxi pɨwapitɨani memuyuwaɨriyanikɨ  
\q2 kiekaritsie mɨranutahakitɨretsie memɨtetahɨkakɨ.   
\b  
\q1
\v 7 Metatsiere mawari wewiwamete meta Kakaɨyari niukametemama,  
\q2 kaxie winuyarikɨ mepeukeitsarietɨweni,  
\q2 mepeukeitsarietɨwe winu waɨkawa mɨtɨrɨkaɨyekɨ  
\q1 winukɨ mepɨkaheta'eriwawe,  
\q2 winukɨ mepetiketamɨrike.  
\q1 Kepauka Kakaɨyari mɨtiwaxeitsitɨa mɨpaɨ mepɨkatekuxata,  
\q2 kepauka yamemaitɨka, meputirukuwa xeikɨa.   
\q1
\v 8 Puyuri, naitɨ wamexate pɨhayarimatɨka,  
\q2 hawaikɨ tɨma pɨkahanaka'itiyarie.   
\b  
\q1
\v 9 «¿Kemetemate kemɨ'ane mepɨteha'ɨkitɨa?  
\q2 ¿Kemɨ'ane niuki mepɨtehakuxaxatɨwa?  
\q1 ¿Tɨɨri metate'erie hekwamekɨke temutsitsinawaiyarie,  
\q2 hekwamekɨke tatsitsi temuku'eiri?   
\q1
\v 10 ¿Tɨɨri mɨixamexɨa mɨpaɨ memutiyuane:  
\q2 “a-b-c-d-e, a-e-i-o-u,  
\q2 'etsiwa 'ena, 'etsiwa huma”?»   
\b  
\q1
\v 11 Matsitsɨ 'aixɨa kani'aneni, Kakaɨyari 'ikɨ yuteɨterima kaniwatahɨawimɨkɨ  
\q2 wayuriyatɨ yɨkɨ niuki 'anuyɨnemekɨ meka'i'eniekamekɨ,   
\q1
\v 12 mɨkɨ teɨteri mɨpaɨ mɨtiwarutahɨawekai:  
\q2 «'Ena 'uxipiya maxuawe kanihɨkɨtɨni,  
\q2 kemɨ'ane mu'uxe ke'uka'uxipieni»,  
\q1 metatsiere mɨpaɨ mɨtiwarutahɨawixɨ:  
\q2 «'Ena 'uxipiya tukari kanihɨkɨtɨni».  
\q2 Matsi mepɨka'i'eni.   
\q1
\v 13 'Ayumieme Yawé niukieya  
\q2 wahetsiemieme kanayeimɨkɨta:  
\q2 «a-b-c-d-e, a-e-i-o-u,  
\q2 'etsiwa 'ena, 'etsiwa humapaitɨ».  
\q1 Kepauka memɨyekɨne yukutama pɨta me'uhutɨ,  
\q2 memɨtekwinekɨ, winiyaritsie memeyuxɨrienikɨ meta putsuta memeukaxɨrienikɨ.   
\b  
\q1
\v 14 'Ayumieme, teɨteri xemɨte'aita xeyuti'ɨretɨ  
\q2 'ikɨ kiekariyaritsie Kerutsareme,  
\q2 Yawé niukieya xekeneu'eni:   
\b  
\q1
\v 15 Xeme mɨpaɨ xemutiyuane: «Tɨratu tepuwewi mɨki hamatɨa,  
\q2 mɨki teukiyapa hamatɨa tɨratu tepuwewi.  
\q1 Kepauka 'uximatɨarika munuani,  
\q2 pɨkayɨwe mɨkatatsi'axekɨ,  
\q1 tame tita mɨti'itarika tahetsie nunuwame temayeitɨakɨ  
\q2 meta tita kwamanarika mɨtihɨkɨ tatsi'awiwietame».   
\p
\v 16 'Ayumieme Yawé naimekɨmɨyɨwe mɨpaɨ paine:  
\q1 «Ne Tsiyunitsie tete nepayeni 'inɨatsiekame,  
\q2 tete 'uta'etsikiname witsi'aneme tenaritsie miemetɨme,  
\q2 kemɨ'ane hetsiena mɨtiwiyani 'aixɨa 'iyari puyeikani.   
\q1
\v 17 Tita 'aixɨa mɨti'ane ti'inɨnɨatame hepaɨ 'aneme 'anepɨtakeni,  
\q2 meta mɨtiheitserie hetsiemieme, tepɨa mahete hiru manawie.  
\q1 Tee, xehetsie nunuwame 'itarikakɨ mɨhɨkɨ kaneuyehɨamɨkɨ,  
\q2 meta haa hakewa xemeyu'awieta kanikayunitɨamɨkɨ.   
\q1
\v 18 Pɨhayewarieni tɨratu xemuwewi mɨki hamatɨa,  
\q2 'atsikapɨtiyɨni tsepa mɨki teukiya hamatɨa xemɨte'utaxa.  
\q1 Kepauka 'uximatɨarika tiyumemiwame 'umamie,  
\q2 mɨkɨ kanixetipɨnamɨkɨ.   
\q1
\v 19 Kepauka manuyeyeikani, pɨxehehapanani,  
\q2 ximeri yapɨranuyeyeikani, tukarikɨ meta tɨkarikɨ».  
\b  
\q1 Kepauka xemeitimani 'ikɨ niuki  
\q2 yemekɨ xekanitimamakuni.   
\q1
\v 20 'Utá 'etsipɨtɨtɨ hetsiena muta'ɨtserita pɨkayɨwe,  
\q2 'ixuriki 'etsipɨyewa kɨmana muyuta'eima pɨkayɨwe.   
\q1
\v 21 Kaniyuritɨni, Yawé kananukukemɨkɨ Peratsini hɨriyaritsie hepaɨ,  
\q2 Kemɨtiukuyua Kawahuni mayeweritsie hepaɨ,  
\q1 yu'uximayatsika 'aye'atɨanike xewitɨ mɨka'imaiwe,  
\q2 yu'aitɨarika maye'atɨanikɨ.   
\q1
\v 22 'Ayumieme hikɨ, xeketeneuhayewa xeteyukananaimatɨ,  
\q2 kapa matsi kwinimieme tepɨa kaunariyarikɨ xeyutihɨani,  
\q1 Ti'aitame mɨpaɨ mɨnetiutaxatɨakɨ,  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye,  
\q1 'ikɨ kexemɨteheuyehɨiyani hepaɨtsita  
\q2 kemɨtiuxatsie 'ikɨ kwieyari naime hepaɨtsita.   
\b  
\q1
\v 23 Xekeneu'enana, neniuki xekeneu'eni,  
\q2 kayuwatɨ xekeneu'enana, neniuki xekeneu'eni:   
\q1
\v 24 Kepauka ti'uximayatame mukwietsanane ka'enike,  
\q2 ¿ka'uxipietɨ tiyuriene?  
\q1 ¿Tukarikɨ kwietsananetɨ meta rakuxexeɨriwatɨ raka'iyuniwa?   
\q1
\v 25 Kepauka kwie 'aixɨa makuyurieni,  
\q2 'imɨari witsima'ane meta kuminutsi kanika'emɨkɨ.  
\q1 Tɨriku kaniuka'etsani xuruku tiwewieme,  
\q2 tsewara hakewa maka'etsiwatsie,  
\q2 meta manunenieretsie 'iku kanika'emɨkɨ.   
\q1
\v 26 Kakaɨyari kanihɨkɨtɨni kemɨ'ane mɨtikuxaxatɨwa  
\q2 mɨti'ɨkitɨa kehepaɨ mɨtiyurienikɨ.   
\b  
\q1
\v 27 'Imɨari witsima'ane manuxɨtetɨkakɨ pɨkakaweiwa,  
\q2 meta kuminutsi hetsie kaxeta 'ɨkaya pɨka'uyeyeika,  
\q1 matsi witsimu'ɨa tuturiyari kɨye 'etsipemekɨ kaniweiwani,  
\q2 meta kuminutsi kɨye 'apamekɨ.   
\q1
\v 28 'Uriyari kanitiketsinarɨwani, peru waɨkawa pɨkaketsinarɨwa,  
\q2 meta ka'uxipietɨ pɨtiketsinarɨwa.  
\q1 Hetsiena kaxeta 'ɨkaya kaniuyehanietɨyeikani,  
\q2 peru kawayutsixi mepɨka'itɨxiwawe.   
\q1
\v 29 'Ikɨtsiere Yawé Naimekɨmɨtɨrɨkaɨye hetsie katinayeneikani,  
\q2 kanimariweni yu'ɨxatsikɨ  
\q2 meta waɨkawa katinimaika.   
\c 29  
\s1 Xɨa'ui Rawiri kiekariena  
\q1
\v 1 Xɨa'ui, 'Ariheri, 'Ariheri,  
\q2 kiekari hakewa Rawiri metayatsie.  
\q1 Tawarita xeiwiyari xekenanutiyetsa meta tawarita xeiwiyari,  
\q2 'ixɨarari tukariyari yakereuyuweiyani.   
\q1
\v 2 Peru 'Ariheri hetsɨa nekaninuamɨkɨ nemɨtika'enitsitɨanikɨ,  
\q2 tsuari kanitixuawerimɨkɨ meta hiwerika,  
\q2 nehetsiemieme tɨɨ yayatsame pɨhɨkɨtɨni mawari matitaiyarɨwatsie.   
\q1
\v 3 'A'aurie nekanitayerɨmɨkɨ nemetsitamienieke,  
\q2 kɨyexikɨ nekamanakurarutɨiyatɨyeimɨkɨ,  
\q2 'akurarutsie temeukatsunaxɨani tekanitiwewiekuni.   
\q1
\v 4 Nitixaɨtɨ pekatihɨkɨtɨtɨ, kwiepa pe'ukaitɨ pekanitahiwamɨkɨ,  
\q2 tumuanaripa 'aniuki waɨriyarika xeikɨa kani'eniɨriɨkɨkamɨkɨ.  
\q1 'Aniuki kwieta kanatinemɨkɨ  
\q2 tiyumariutame niukieya hepaɨ,  
\q1 'aniuki tumuanari tsatapaitɨ,  
\q2 waɨriyarika kaniyu'eniɨriɨkɨkamɨkɨ.   
\b  
\q1
\v 5 Peru memɨyumɨire memɨmetsi'aye'unie  
\q2 kwie waɨkawa mutumuani mekanakɨnikuni,  
\q1 meta yumɨiretɨ memɨkateyukanenimaya  
\q2 kuxari mekanakɨnikuni 'eka mei'enitsitɨwa.  
\q1 Yapauka, kwitɨwa,   
\q2
\v 6 Yawé Naimekɨmɨtɨrɨkaɨye 'ahetsɨa kaninuamɨkɨ,  
\q1 mimierɨkarikɨ kaninuamɨkɨ, kwie watayuitɨwatɨ,  
\q2 meta waɨkawa tɨranari xuawitɨatɨ,  
\q1 kaninuamɨkɨ haikɨri 'amɨpa mɨtɨrɨkɨye 'ayu'eriyame hamatɨa  
\q2 meta tai tiyutaiyame hamatɨa.   
\q1
\v 7 Memɨyɨmɨire nuiwarite  
\q2 'Ariheri memɨmietɨwe,  
\q1 yunaitɨ kemɨ'ane memimietɨwe  
\q2 meta titatsie mɨtiyutɨrɨkariya,  
\q1 kemɨ'ane memenutinama,  
\q2 heinɨtsi hepaɨ mekaniyɨkuni,  
\q2 heiwa yɨwikɨta mɨtiuniere hepaɨ.   
\q1
\v 8 Haakamɨkame rekwatɨ mɨtiyuheinɨtsa hepaɨ,  
\q2 peru manutanieretsie reuhaakamɨkɨni,  
\q1 harimɨkame heharetɨ mɨtiyuheinɨtsa hepaɨ,  
\q2 matsi manutanieretsie ranatiwakini.  
\q1 Nuiwarite mɨpaɨ mekaniyɨkuni yunaitɨ memɨyuwaɨkawa  
\q2 Tsiyuni hɨriyari memɨmietɨwe.   
\b  
\q1
\v 9 'Atsixekatemaitɨ xekenakɨni, xemamatɨ xekaniuwawetɨ xekeneti'uti,  
\q2 xekaheunenieretɨ xekenakɨni, tixaɨtɨ tɨma xekatexeiyatɨ,  
\q1 xekenetarɨweka, peru winukɨ hawaikɨ,  
\q2 xekenekeitsarietɨweni, peru winukɨ hawaikɨ.   
\q1
\v 10 Yawé xehetsie kanikawiwieni  
\q2 'iyari waɨkawa xemeukutsukɨ,  
\q1 Kakaɨyari niukametemama mekaneniereme puwarayeitɨa,  
\q2 Kakaɨyari hetsie timiemekɨ memɨtaneniere wahɨxie pɨwareutinaxɨa.   
\p
\v 11 Xehetsiemieme, naitɨ 'ikɨ kexemɨteneniere xekanixeiyani xeikɨa nawi kwikwiekametsie 'anukanakame. Xɨka mɨkɨ mukwikwiya xeime xeyetuirieni mɨreutaterɨwawe, mɨpaɨ xɨka xete'itahɨawe: «Pamɨpariyutsi xɨa'ui, 'ikɨ kenakaterɨwa», mɨkɨ mɨpaɨ kanitayɨmɨkɨ: «Nepɨkayɨwe, kananukanaka».  
\v 12 Xɨka xeimeta mɨkɨ mukwikwiya xeyetuirieni mɨkatiterɨwawe, xɨka mɨpaɨ xete'itahɨawe: «Pamɨpariyutsi xɨa, 'ikɨ kenakaterɨwa», mɨkɨ mɨpaɨ kanitayɨmɨkɨ: «Matsi nepɨkatiterɨwawe».   
\b  
\p
\v 13 Ti'aitame mɨpaɨ kanaineni:  
\q1 «'Ikɨ teɨteri mepɨnetsinɨawa yutenikɨ  
\q2 meta 'aixɨa mepɨnetehahɨawe,  
\q2 peru wa'iyari 'ateewa puyeika.  
\q1 Memɨnetsihayexeiya 'aitsikakɨ xeikɨa mekaniyɨaka  
\q2 teɨteri yametewa'aitɨakaku.   
\q1
\v 14 'Ayumieme, tawarita 'ikɨ teɨteri nekaniwahɨxiyatsitɨamɨkɨ  
\q2 mariwemekɨ netiyurienetɨ,  
\q1 temaiwawemete kememɨtemaiwawe mekaneiyehɨakuni  
\q2 kememɨteheutamaiwawekai metematetɨri mepɨka'akɨne».   
\q1
\v 15 Xɨa'ui kemɨ'ane, kememɨteyuriku me'awietakutɨ,  
\q2 Yawé hɨxie memuyu'awieta meukatetewatsie,  
\q1 'axamepɨteyurie yɨwikɨta, meta mɨpaɨ mepɨteku'eriwa:  
\q2 «¿Kemɨ'ane kuta pɨtatsixeiya? ¿Kemɨ'ane pɨtatsimate?»   
\q1
\v 16 Keri titayari mɨya meteyɨa.  
\q2 ¿Kamɨtsɨ 'iwewame haxu hamatɨa yaxeikɨa mete'anene?  
\q1 ¿Kamɨtsɨ mutawewiya kemɨ'ane mitawewi mɨpaɨ titahɨawe:  
\q2 «Mɨkɨ pɨkanetsi'utawewi»?  
\q1 ¿Kamɨtsɨ xari yu'iwewame mɨpaɨ tiutahɨawiwe:  
\q2 «Mɨkɨ 'atsipɨkatimate»?   
\b  
\q1
\v 17 Riwanu kwitɨwa  
\q2 kwie 'aixɨa mɨ'ane mɨraku'etsitɨre kanayeimɨkɨ,  
\q2 meta mɨraku'etsitɨrekaitsie makukariuxaya kanayeimɨkɨ.   
\q1
\v 18 'Iya tukaritsie memɨkaheu'enana mepɨyɨwaweni  
\q2 nawi kwikwiyaritsie terɨwarika mayemie memɨ'enienikɨ,  
\q1 meta memɨkaheuneniere wahɨxite pɨneniereni  
\q2 muyɨwitsie meta 'etɨriyaritsie me'u'uwatɨ.   
\q1
\v 19 Tixaɨtɨ memɨkateheuxeiya meyutemamawietɨ Yawé hetsiemieme mekanakɨnikuni,  
\q2 yemekɨ waɨkawa memɨteheuyehɨwa mekaniyukatemamawikuni Mɨpatsie 'Ixaheri hetsiemieme.   
\q1
\v 20 Memɨteyukananaima mepɨka'u'uwaniri,  
\q2 memɨteyukatawe'erie mekanikumawerikuni,  
\q1 Meta yunaitɨ kemɨ'ane memɨkakutsu 'axameteyurietɨ  
\q2 mekaneuyehɨiyakuni.   
\q1
\v 21 Kemɨ'ane niukikɨ xeime hetsie mɨtiɨhɨpa,  
\q2 kemɨ'ane tixanetɨariwame memɨwiniya,  
\q2 meta 'itarikakɨ 'aixɨa mɨtiuyeika memɨnanaima.   
\p
\v 22 'Ayumieme, Yawé, 'Apɨrahami hetsie nunuwame, mɨpaɨ katiniwarahɨaweni Kakuwu nuiwarimama:  
\q1 «Kakuwu pɨkayutewiyaniri,  
\q2 meta yuhɨxie pɨka'ayexetare.   
\q1
\v 23 Kepauka mɨkɨ yuniwema muwaxeiya,  
\q2 meta neti'uximayakame mɨkɨ watsata,  
\q1 mɨkɨ yunaitɨ nepatsiekame mepayeitɨaka kenemɨtitewa,  
\q2 patsiekame mepayeitɨaka Kakuwu hetsie Mɨpatsie,  
\q2 meta 'Ixaheri Kakaɨyarieya mepayemakaxeni.   
\q1
\v 24 Kemɨ'ane 'iyari heuyexɨriekame memexeiyakai yamepɨtehetimani,  
\q2 meta 'axamemɨteniniukikai yamepɨtetanaki'erieni memɨta'ɨxatsitɨarienikɨ».   
\c 30  
\s1 'Ekipitu hetsie memɨtewiya wahetsiemieme  
\p
\v 1 Yawé mɨpaɨ kaniutayɨni:  
\q1 «Xɨa'ui tɨɨri memɨkaheu'enana  
\q2 kememɨteyurienikɨ memɨtekuxata nehetsɨa mɨkatimiemekɨ,  
\q1 ne'iyari kemɨkatinake memɨtekuxata,  
\q2 'axamɨti'ane waɨkawa memukuxeɨrie,   
\q1
\v 2 mekanetsi 'uta'iwawiyatɨ 'Ekipitu memeukakɨka,  
\q2 Parahuni hetsɨa memekɨka wahetsie munuakakɨ,  
\q2 meta 'Ekipitu 'etɨriyayatɨa memuyu'awieta.   
\q1
\v 3 Parahuni xehetsie munua xetewiyarika payani.  
\q2 'Ekipitu hetɨa xemɨ'etɨpie, tixaɨtɨ xetehɨkɨtɨme pɨkaxe'ayeitɨani.   
\q1
\v 4 Tsepa Tsuhani xemɨwarexeiya paratsiyuta te'uximayatamete,  
\q2 yatɨni tsepa Kanetsi paitɨ xenɨ'arima memɨte'u'axɨa,   
\q1
\v 5 yunaitɨ mepɨtewiyatsitɨarieni,  
\q2 mɨkɨ teɨteri tixaɨtɨ memɨkateyunaki'erie ya'aneme meheutiwiwiexɨaku,  
\q1 nitixaɨtɨkɨ memɨkatewaparewie meta memɨkawareuyehɨwa,  
\q2 tewiyarika xeikɨa meta 'atsimepɨkatematé kememɨteyurienikɨ».   
\p
\v 6 'Ikɨ kanihɨkɨtɨni kenemutayɨ tewaxi wahepaɨtsita Nekexi makumawetsie memuyekɨka:  
\q1 Kwiepa kweriwa'anekɨa 'uximatɨarika tsata,  
\q2 mayetsi mexuawekaku,  
\q2 kuuterixi mexuawekaku meta kuuterixi memawɨwawe,  
\q1 mɨkɨ mekatenetɨni puxuri wahetsie  
\q2 nuiwari tixaɨtɨkɨ memɨkateyunaki'erie mana tita waɨkawa memɨtehexeiyakai,  
\q2 tita waɨkawa mɨraye'atɨka memɨtehexeiyakai kameyutsixi wahetsie mekatene'ikata.   
\q1
\v 7 'Ekipitu parewiyaya nitixaɨtɨ pɨkatihɨkɨ,  
\q2 'ayumieme mɨpaɨ nepɨtiterɨwa: «Xahawi, mɨkakuyuane».   
\b  
\q1
\v 8 Kamɨtsɨ, mɨkɨ wahɨxie kenemie,  
\q2 meta mexatsie ketina'utɨa.  
\q1 Nawi kwikwiekametsie kenaka'utɨa,  
\q2 'uxa'atɨni warie  
\q2 yamɨre'ukakɨ kemɨtiɨyɨ yuheyemekɨ.   
\q1
\v 9 'Ikɨ teɨteri memɨkaheu'enana memɨhɨkɨkɨ 'ayumieme,  
\q2 tɨɨri memɨteyukwamana mekanihɨkɨtɨni,  
\q1 tɨɨri Yawé 'ɨnɨari niukiyari memɨka'eniku.   
\q1
\v 10 Memɨtaneniere Kakaɨyari hetsie timiemekɨ,  
\q2 mɨpaɨ mekateniwakɨhɨaweni:  
\q2 «Kexemɨtetanenierekɨ xeketeneuhayewa»,  
\q1 meta Kakaɨyari niukametemama mɨpaɨ mekateniwakɨhɨaweni:  
\q2 «Tawariri tita yuri mɨraine xepɨkatatekuxaxatɨwani.  
\q1 Witsimɨranuyɨtɨka pɨta xeketatenekuxaxatɨwani,  
\q2 xeketenekuxatani witsiketemɨteku'eriwa.   
\q1
\v 11 Huye xekeneuku'eiri,  
\q2 mɨkɨ huye xekeneuhayewa,  
\q1 xeketaneuhayewa Mɨpatsie 'Ixaheri hetsiemieme  
\q2 kemɨtatsiyurieneni».   
\p
\v 12 Mɨpaɨ kanaineni 'Ixaheri hetsie Mɨpatsie:  
\q1 «Xeme 'ikɨ niuki xepɨkahanu'eni,  
\q2 'uximatɨarikatsie pɨta yuri xepɨte'uta'eri meta 'axamɨti'anetsie,  
\q2 mɨkɨtsie pɨta xepuyutɨrɨkariya.   
\q1
\v 13 'Ayumieme 'axakexemɨte'uyuri xehɨxie pɨtakeni  
\q2 kuraru 'amatitewa hepaɨ meta 'ukatsitsinitɨ,  
\q2 hatiweximetɨ:  
\q2 hikɨ, yapauka, kanatiwemɨkɨ.   
\q1
\v 14 'Axakexemɨye'uyuri 'etsipepetɨ kanayeimɨkɨ,  
\q2 'etsipepetɨ, xari mutatare hepaɨ:  
\q2 nixewitɨ tɨma 'etsiyeutɨ tiyunaki'erietɨ pɨkayuhayewa,  
\q2 kɨmana tɨɨ taipa manayetɨkɨ pɨkayɨweni  
\q2 meta putsuta haa muwatihana».   
\p
\v 15 'Ayumieme mɨpaɨ kanaineni Yawé naimekɨmɨyɨwe, 'Ixaheri hetsie Mɨpatsie:  
\q1 «Xɨka xete'uhayewa meta kayuwatɨ xehexeiyatɨ xe'akɨne, xekanitawikweitsitɨariekuni,  
\q2 'aixɨa 'iyari xe'u'uwatɨ meta yuri xete'erietɨ xekanitɨrɨkariyariekuni,  
\q2 peru xeme mɨpaɨ xemɨtehetimani xepɨkayuwaɨriya.   
\q1
\v 16 Xepɨkayɨne mɨpaɨ xeputiyuane: “Tekaniyuta'unakuni kawayutsixi wahetsie te'utetɨ”.  
\q2 'Ayumieme, mɨpaɨ xekateniyuta'unakuni.  
\q1 Mɨpaɨ xekaniutiyuaneni: “Kawayutsixi memanautsawawetsie tekananutiyaxikuni”.  
\q2 'Ayumieme, kwinimieme mehayɨwawetɨ mepayenexɨani memɨwaraye'unie.   
\q1
\v 17 Yuxewitɨ xekwinekaku,  
\q2 xeimiriyari xeme xekaniyuta'unakuni,  
\q1 yu'auxɨwitɨ mexekwitɨwekaku,  
\q2 xeme yunaitɨ xekaniyuta'unakuni.  
\q1 Xekaniku'eiriwakuni  
\q2 hɨritsie kɨye patera manuyewiwierekai hepaɨ  
\q2 yemuritsie patera 'inɨari hepaɨ».   
\b  
\q1
\v 18 'Ayumieme Yawé kanixekwewieka, mɨxeparewienikɨ,  
\q2 'ayumieme kanixehahɨaweni kemɨtixenenimaya xemeitimanikɨ.  
\q1 Yawé Kakaɨyari heitserie mɨtiyurienekɨ.  
\q2 'Aixɨa meke'itɨarieka kemɨ'ane hetsiena timieme memɨtetakwewie.   
\p
\v 19 Teɨteri Tsiyunitari, Kerutsareme xemɨtama, tawariri xepɨkatitsuani. Kakaɨyari mɨtiyukanenimaya pɨxetinenimayata kepauka xemitahiwieni parewiya xeku'iwawatɨ. Yapauka kepauka mɨxe'enieni, pɨxeta'eiya.  
\v 20 Tsepa ti'aitame paa mɨxe'umi xemaye'uniwanikɨ meta haa xemu'uximatɨariekakɨ, xeti'ɨkitɨwame tawariri pɨkayuti'awieta, yuhɨxitekɨ xepixeiya.  
\v 21 Tsepa tatserieta pemeukuyunixɨ yatsepa ta'utata, 'anakata mɨpaɨ pepɨti'ena niuki mɨpaɨ matikɨhɨaweme: «'Ikɨ mɨkɨ huye kanihɨkɨtɨni, keneuweiyani».  
\v 22 Hikɨ memɨkakakaɨyarixi pemɨwarexeiya mekapatsiekame pekaniwarayeitɨamɨkɨ pɨratakɨ meta hurukɨ memɨkawiriyarietɨka, pekaniwarexɨrimɨkɨ tixaɨtɨ mɨkati'itiyaka hepaɨ, mɨpaɨ pekatiniwatahɨawimɨkɨ: «Xekenanuyekɨni».   
\p
\v 23 Yawé wiyeri pɨxehanɨ'airieni 'imɨari xemɨka'eni hetsiemieme, meta 'ikwaxi waɨkawa mɨtitixuawere witsipa'aneni. 'Iya tukaritsie xetewama 'ɨxa 'eyeyeumetsie mepɨtetikwani.  
\v 24 Tuurutsixi meta puxuri memɨte'uximaya 'aixɨa 'aneneme mume 'etsime mekanitikwaikuni, nakitsaraɨkɨ meta parakɨ teikɨ mewiwiya.  
\v 25 'Imieri tukariyari maye'anitsie, kepauka tuxiyu makainariexɨani, 'ana 'akitsie haa 'uhapanetɨ kanayeimɨkɨ meta haixa kanitixuawerimɨkɨ naitsarie hɨritsie 'amutɨtɨtsie.  
\v 26 Kepauka Yawé yuteɨterima wa'umete manaku'eimaxɨanitsie meta muwa'uayemanitsie mɨtiwarukwinitɨakai, 'ana metsa tau hepaɨ tixawatɨtɨ kanayeimɨkɨ, meta tau xawatɨriyaya 'atahutamexɨa tawarita xawatɨtɨ kanayeimɨkɨ, tau 'axeikɨa 'atahutatɨ mɨkɨxeni hepaɨ.   
\q1
\v 27 Neuxei. Yawé kemɨtitewa 'ateewa kanamieni,  
\q2 haxɨakɨ tatɨ waɨkawa kɨtsi 'anawietɨ,  
\q1 tenieyatsie pɨhɨpɨne haxɨa,  
\q2 nenieya tai mɨtiyuxɨtsitɨwa hepaɨ pɨ'ane.   
\q1
\v 28 'Iyaya haa manatiyeurieni hepaɨ kani'aneni  
\q2 takɨipitɨa paitɨ pɨye'axe,  
\q1 nuiwarite kaniwaranuyekatsimɨkɨ  
\q2 katsemetsie wareuyehɨanike.  
\q1 Teɨteri wateta kaniwarutakeitsitɨani  
\q2 pirenu yeuta memeukuyunekɨ.   
\q1
\v 29 Xeme xeputikwikani patsiekamekɨ memuyukuxexeɨriwa tɨkariyaritsie hepaɨ,  
\q2 xe'iyarite puyutemamawieka,  
\q1 kepauka xewitɨ manutiyani pirikɨxa 'uhɨtsieximetɨ hepaɨ  
\q2 Yawé hɨrieyatsie,  
\q2 'Ixaheri 'Aiya hetsie.   
\q1
\v 30 Yawé katani'enitɨamɨkɨ yuniuki mɨmariwe,  
\q2 yutɨrɨkariya tahɨxie kanikatetɨamɨkɨ:  
\q1 haxɨaya mutarɨrɨrɨka meta taiya mɨtiyuxɨxɨtsitɨwa,  
\q2 haa tsata, 'eka tsata meta tee tsata.   
\q1
\v 31 Yawé niukieya 'Atsiriya kanitimuraxɨamɨkɨ,  
\q2 yu'itsɨkɨ kaniwamɨkɨ.   
\q1
\v 32 Xei'iwaɨyɨyarikɨ Yawé hetsiena kemɨranutatetɨwa  
\q2 yukɨye 'iwaɨyɨpame mɨtiyukwinitɨwakɨ  
\q1 tepu meta haripa hayuanekaku katiniyurimɨkɨ,  
\q2 yumamá 'uyuitɨwatɨ, kaniwatakwimɨkɨ.   
\q1
\v 33 Tupeti meripaitɨri kaniyukuha'aritɨani,  
\q2 ti'aitame hetsiemieme kanihɨkɨtɨni.  
\q1 Teeka kaniwati'inierieni heukatewatɨ 'awatiyeutɨ,  
\q2 waɨkawa tai meta kɨyexi hexeiyame,  
\q1 Yawé 'ihɨtsieyu kanitaimɨkɨ,  
\q2 tai hayari hatɨa muhaneni hepaɨ.   
\c 31  
\s1 Xɨa'ui kemɨ'ane 'Ekipitu hetsie memɨtewiya  
\q1
\v 1 Xɨa'ui kemɨ'ane 'Ekipitu memekɨka parewiya mekuwautɨwetɨ,  
\q2 meta kemɨ'ane kawayutsixi wahetsie memuyukuparewie,  
\q1 kemɨ'ane kaxetate kuyaxa miemetetsie memuyukuparewie  
\q2 meta memanutiyaxike wahetsie,  
\q1 peru Mɨpatsie 'Ixaheri hetsiemieme memɨkaha'eriwa,  
\q2 meta Yawé memɨkakuwautɨwe.   
\q1
\v 2 Yawé, matsi mɨtimaiwe kanihɨkɨtɨni,  
\q2 kwiniya kani'atɨamɨkɨ,  
\q2 meta kemɨtayɨni yakatinikamieni.  
\q1 'Axamemɨte'u'iyari kaniwa'uximatɨamɨkɨ,  
\q2 meta kemɨ'ane memɨwaparewie.   
\q1
\v 3 'Ekipitutari, matsi, mepɨteɨteri, mepɨkakakaɨyarixi,  
\q2 wakawayutsixi mepɨwaite, 'iyarite mepɨkahɨkɨ.  
\q1 Kepauka Yawé mɨtiwakwinitɨani,  
\q2 kemɨ'ane parewiya mɨyetua kanekawemɨkɨ,  
\q1 meta kemɨ'ane memuparewiya kanatiwemɨkɨ.  
\q2 Yunaitɨ mekanikwikuni.   
\p
\v 4 Mɨpaɨtsɨ Yawé kanetinahɨaweni:  
\q1 «Maye muyutahaxɨatɨwa yu'ikwai hetsie nuatɨ,  
\q2 kepauka hepaɨtsitana memuyukuxeɨrieni  
\q2 yunaitɨ muxatsi wahɨwemete,  
\q1 maye temaikɨ hepaɨ  
\q2 wahiwarikɨ mɨka'utimamawe  
\q2 meta kayuwatɨ mɨkatiukieka wayuarikakɨ,  
\q1 mɨpaɨta Yawé Naimekɨmɨtɨrɨkaɨye  
\q2 katininuamɨkɨ watakwinike,  
\q2 Tsiyuni hɨriyaritsie, 'amanutitewitsie.   
\q1
\v 5 Memawɨwawe yu'itua kememɨte'ɨwiya,  
\q2 mɨpaɨta Yawé Naimekɨmɨtɨrɨkaɨye  
\q2 Kerutsareme pɨtita'ɨwiya,  
\q1 pi'awietani meta piparewieka,  
\q2 hetsiena punuaka meta pitawikweitsitɨwani».   
\p
\v 6 Xeme 'ixaheritsixi, xekeneu'axɨa 'iya hetsɨa kemɨ'ane xe'aye'unietɨ xemakɨ waɨkawamekɨ.  
\v 7 Karikɨ 'iya tukaritsie xeme yuxexuitɨ xepɨwarexɨrieni yukakaɨyarixi memɨwewiyatɨka pɨratakɨ meta hurukɨ mɨkɨ xemamate 'axamɨtiyuruwame mɨwarutiwewiekaikɨ.   
\q1
\v 8 «'Atsiriya 'ixiparakɨ kanimieriemɨkɨ, peru tewi pɨka'imieni,  
\q2 'ixipara kanikumaweriyamɨkɨ, peru tewi 'ixiparaya pɨkatixaɨ.  
\q1 Kaniyuta'unamɨkɨ 'ixipara makatɨ,  
\q2 meta temarimama mekatenita'aitɨariekuni waɨriyarika mepitɨarietɨ.   
\q1
\v 9 Marikakɨ memɨwayuti'awiwieta kanita'unimɨkɨ,  
\q2 memanuyetei yupatera mekaniku'eirikuni».  
\q1 Yawé mɨpaɨ kanaineni,  
\q2 yutai Tsiyunitsie mexeiya,  
\q2 meta yuhuxunu Kerutsaremetsie mexeiya.   
\c 32  
\s1 Ti'aitame 'aixɨa tiuka'iyaritɨ  
\q1
\v 1 Neuxei, xewitɨ ti'aitame heitseriemekɨ katinita'aitamɨkɨ  
\q2 meta kuwexinaruritsixi 'aixɨa 'anemekɨ mekatenita'uximayatakuni.   
\q1
\v 2 Yuxexuitɨ mɨkɨ 'eka hepaɨtsita memuyu'awietani hepaɨ mekani'anekuni,  
\q2 wiyeri mɨ'ekama mɨkawakema,  
\q1 haa 'akite 'utɨma muhapaneni hepaɨ makumawetsie,  
\q2 'ai 'etɨriyari mekanihɨkɨtɨkakuni makumawetsie.   
\b  
\q1
\v 3 Kemɨ'ane memeuneniereni 'aixɨa mepɨteneniereni,  
\q2 memeu'enana mepuku'enakareni.   
\q1
\v 4 Mekaheitimaitɨkɨkatɨ memutiniuka mepeitimaitɨkɨkani meta mepeti'enatɨkɨkani,  
\q2 memɨnenurietɨka 'aixɨa mepɨte'uxaxatani.   
\q1
\v 5 Tewi 'aixɨa mɨtiuka'iyariri pɨkatiuterɨwarɨwani mɨka'uka'iyari  
\q2 meta mɨtiuyuka'irɨwiya heitserie pɨkaxeiyarieka.   
\q1
\v 6 Mɨka'uka'iyari tixaɨtɨ mɨkatiyunaki'eriekɨ katinikuxatani,  
\q2 'axamɨti'ane xeikɨa katiniku'eriwani,  
\q1 'inɨari niukiyaritsie yapɨkatikamie  
\q2 meta Yawé hepaɨtsita 'itarikakɨ katinikuxatani,  
\q1 meuhaakamɨkɨ heuhakamɨkɨme kanikuhayeikawani,  
\q2 meta kemɨ'ane meuharimɨkɨ pɨkakuharitɨwa.   
\q1
\v 7 Mɨtiyukwamana katinikuwauneni kemɨtiwakwamanakɨ,  
\q2 meta yakatinikuxatani kehepaɨ mɨtiwananaimanikɨ,  
\q1 tixaɨtɨ memɨkatehexeiya kaniwaka'unani 'itarikakɨ,  
\q2 tsepanetɨ tixaɨtɨ mɨkarexeiya mɨtixanetane.   
\q1
\v 8 Matsi, tewi 'aixɨa mɨtiuka'iyari,  
\q2 'aixɨa mɨti'anekɨ kaniyɨhɨaweni,  
\q2 meta ke'aixɨa mɨtiyuriene mɨkɨtsie kanimatsiɨkɨni.   
\s1 'Ukari Kerutsaremetari  
\q1
\v 9 'Ukarawetsixi nitixaɨtɨkɨ xemɨkateyɨhɨawe,  
\q2 xekenanuku'uti meta xekeneneu'eni.  
\q1 'Ukari kename 'atsikatixeyurieni xemɨteku'eriwa,  
\q2 xekeneneu'eni kenemɨtixetahɨawe.   
\q1
\v 10 Xeme, 'atsikatixeyurienike xemuyu'erie,  
\q2 xeiwiyari 'anuyeyayu matsi xekanitiyɨyɨakakuni marikakɨ,  
\q1 karikɨ kaxie pɨkatixuawere,  
\q2 pɨkatika'inɨiyani.   
\q1
\v 11 'Ukarawetsixi xemɨkayu'iyaritɨa, xekenemamaka.  
\q2 Xeme, 'aixɨa 'iyari xemu'uwa,  
\q2 xekeneuyɨyɨakatɨkani.  
\q1 Xekeneuyutikemaripi, xekeneuyutimaweripi,  
\q2 hiwerika kamixayari pɨta xekenanakatɨki.   
\q1
\v 12 Yutawitsie xekeneuyuhutsunani,  
\q2 kwie 'aixɨa mɨ'anene xemaka'etsa hetsiemieme,  
\q2 kaxie 'aixɨa mutiukaxuxuawere hetsiemieme,   
\q1
\v 13 kwie hetsiena neteɨterima memu'uwa hetsiemieme  
\q2 xuya xuawekaku meta 'ɨtsi,  
\q1 naitsarie kiita hakewa temawierika mexuawe  
\q2 meta 'ikɨ kiekari temawierika mexeiya hetsiemieme.   
\q1
\v 14 Paratsiyu kaniku'eiriwamɨkɨ  
\q2 meta kiekari teɨteri yuwaɨkawa memimatekai,  
\q1 yuheyemekɨ terɨ xeikɨa kanakɨnikuni kiekari  
\q2 'aixɨa mɨ'anene meta tuxiyute,  
\q1 puxuri tiwa'iyari kanayeimɨkɨ,  
\q2 'ɨxa mɨtineni muxatsi wahetsiemieme kanayeimɨkɨ,   
\q1
\v 15 kepaukake taheima paitɨ  
\q2 'Iyari temakanɨ'airiyarieni tahetsie mɨtinakenikɨ.  
\q1 Hikɨ makumawetsie kwie 'aixɨa mɨ'ane mɨraka'etsitɨre kanayeimɨkɨ,  
\q2 meta kwie 'aixɨa mɨ'ane mɨraka'etsitɨre 'uhukuyatɨ kanayeimɨkɨ.   
\q1
\v 16 Tita mɨtiheitserie makumawetsie kaniuyeikamɨkɨ,  
\q2 meta kwie 'aixɨa mɨ'ane mɨraka'etsitɨretsie tita mɨtiheitserie mana kaniuyeikamɨkɨ.   
\q1
\v 17 Tita mɨtiheitserie kayuwatɨ mexeiyanikɨ mɨ'ayumieme kanayehɨamɨkɨ,  
\q2 'aixɨa 'iyari temu'uwanikɨ 'ikwaxiyari kanayehɨamɨkɨ.   
\q1
\v 18 Neteɨterima kayuwatɨ 'umakaku mekaniu'uwakuni,  
\q2 kiite 'aixɨa 'anenemeta,  
\q2 witsitiu'anekaku mepu'uxipieka.   
\q1
\v 19 Tsepanetɨ tee waɨkawa huku mukatuaxixɨ  
\q2 meta tsepa kiekari 'akuweritɨ mayeitɨarie,   
\q1
\v 20 'aixɨa xeke'itɨarieka xeme,  
\q2 xemuka'etsa haatetsita,  
\q2 meta tuuru puxu hamatɨa xemɨwarutatuaya.   
\c 33  
\s1 Hiwerika meta parewiya  
\q1
\v 1 Xɨa'ui 'ekɨ, pemɨtiyuka'uname, 'akuxi pemɨkaka'unariewe.  
\q2 Xɨa'ui 'ekɨ, pemɨtiyukananaima, 'akuxi pemɨkananaimariewe.  
\q1 Kepauka 'ari pemɨtiyuka'una, 'ekɨta pepɨka'unarieni,  
\q2 kepauka pemɨtiyunanaimani, 'ekɨta pepɨnanaimarieni.   
\b  
\q1
\v 2 Yawé, tame ketanenenimayaka,  
\q2 'ahetsiemieme temɨta'ikwewakɨ.  
\q1 Tsiepɨre ximeri tahetsie nunuwame kenehɨkɨtɨni,  
\q2 meta tawikweitsitɨwame kepauka temu'uximatɨarie.   
\q1
\v 3 'Aniuki mutarɨrɨrɨka me'enietɨ, teɨteri mekanitakɨkani,  
\q2 kepauka pemanukukiekatsie, nuiwarite kwiepa memɨtama mekanitananautsani.   
\q1
\v 4 Xepiinite xepɨtenawaiyarietɨwe  
\q2 wa'atɨ 'utsikari waxa mepɨtekwa'a mepɨteyurie,  
\q1 wahetsɨa mepɨ'axe memɨwaraye'unie  
\q2 'utsikari kwinie memɨyenexime wahepaɨ.   
\b  
\q1
\v 5 'Aixɨa pɨrahɨawarɨwa Yawé meutitewatsie muyeika  
\q2 Tsiyunitsie 'aixɨa pɨtiyuriene kemɨtiheitserie.   
\q1
\v 6 Mɨkɨ pɨhɨkɨtɨni 'aixɨa 'iyari pemuyeikanikɨ,  
\q2 waɨkawa wikweitsitɨarika pɨmatsimini, meta pemɨtimaiwenikɨ meta pemɨtimaikakɨ,  
\q2 xɨka Yawé pemakaka mɨkɨ waɨkawa mɨraye'axe pɨhɨkɨtɨni 'ahetsiemieme.   
\b  
\q1
\v 7 Xekeniwaruxeiya kememɨte'uhiwa kuyaxi memɨka'ukamama kaye 'utɨma,  
\q2 nɨ'ariekate kayuwatɨ mumakakɨ memɨtekuxata meputitsuana kwi meyuhiwerietɨ.   
\q1
\v 8 Huye yuxaɨtame puyehapane,  
\q2 nixewitɨ huyeta pukaheyeika.  
\q1 Tɨratu peutitsanariexɨa,  
\q2 memunenierixɨ 'aixɨa 'iyari mepɨkaxeiyarie,  
\q2 nixewitɨ 'aixɨa pɨkatixeiyarie.   
\q1
\v 9 Kwie kaniyuheiwerieka meta kaniuwakini,  
\q2 Riwanu kaniyutewiyani meta kanitiyɨnareni,  
\q1 mayeweri Tsaruni makumawetsie hepaɨ 'anetɨ kanayani,  
\q2 Watsani meta Kaximeru kemɨtiutsiɨraɨyekai mɨpaɨri pɨkatiu'ane.   
\b  
\q1
\v 10 Yawé mɨpaɨ kanaineni:  
\q1 «Hikɨ nekananukukemɨkɨ.  
\q2 Hikɨ 'aixɨa nekatinitahɨawariemɨkɨ,  
\q2 nehetsiemieme 'aixɨa katinitaniukiemɨkɨ.   
\q1
\v 11 Xeme kuxarikɨ xepɨtihukata  
\q2 meta xatsi xepɨtiniweni,  
\q1 peru ne'iiya tai mɨhɨkɨ kanitixɨtsitɨamɨkɨ.   
\q1
\v 12 Teɨteri naxi mekanayeitɨariekuni,  
\q2 xuya mawitekietɨka hepaɨ mekatenitaiyariekuni».   
\b  
\q1
\v 13 Xeme, 'ateewa xemu'uwa,  
\q2 kenemɨtiuyuri xekeneu'enana,  
\q1 meta xeme, hurawa xemutetɨka,  
\q2 netɨrɨkariya xekenetimati.   
\q1
\v 14 'Axateyuruwamete Tsiyuni hetsie mekanimamaka,  
\q2 kwie mutayuane 'axateyuruwamete kaniwaranuku'axikeni:  
\q1 «¿Kemɨ'ane tame pɨyɨwe  
\q2 taipa mɨkiekametɨnikɨ mɨtiyɨxɨtsitɨwatsie?  
\q1 ¿Kemɨ'ane tame pɨyɨwe  
\q2 yuheyemekɨ mukuma nerɨkwari tsata mukiekametɨnikɨ?»   
\q1
\v 15 Kemɨ'ane xeikɨa heitserie yamɨtikamie  
\q2 meta heitseriekamekɨ mɨtikuxata,  
\q1 'axa'anemekɨ tumini mɨkaha'i'iwa,  
\q2 meta tumini mɨtanaki'erienikɨ 'aixɨa mɨtiuka'iyari mɨnanaimanikɨ yuhetsie mɨkapitɨa,  
\q1 mɨkayuwaɨriya teyumemiwamete muwa'enienikɨ,  
\q2 mayukɨpiriya 'axamɨti'ane mɨkatixeiyanikɨ.   
\q1
\v 16 Mɨkɨ meutitewatsie pɨkiekametɨni,  
\q2 yu'awiwietame pexeiyani 'aitsie mɨtɨrɨkaɨyetsie,  
\q1 paa pemikieka,  
\q2 haa waɨkawa pexeiyani.   
\b  
\q1
\v 17 'Ahɨxite ti'aitame witsi'anemekɨ pɨxeiya,  
\q2 meta kwie xekanixeiyakuni 'ayeukame.   
\q1
\v 18 'Ataɨta mɨpaɨ pepɨti'erieni pematɨ, meta mɨpaɨ pepɨtayɨni:  
\q2 «¿Hakewari peyeika wa'inɨnɨatame?  
\q1 ¿Hakewari peyeika tumini mɨtatsiwawiriekai?  
\q2 ¿Hakewari peyeika tuxiyutsie timieme mɨraka'utɨwa?»   
\q1
\v 19 Tawari mɨkɨ teɨteri memuyuti'ɨre pepɨkawaxeiya,  
\q2 mɨkɨ teɨteri waniuki mɨkayu'eniɨriɨkɨ,  
\q2 niuki kayumainɨakame memexeiya.   
\b  
\q1
\v 20 Tsiyuni keneuxeiya, ta'ixɨarari kiekariyari,  
\q2 'ahɨxite Kerutsareme kanixeiyamɨkɨ,  
\q1 kii 'aixɨa mɨrewe, 'ixuriki kiiyari 'aixɨa mɨrekuwe,  
\q2 kɨyeyarite mukatsutsuni pɨkahatihunixɨani,  
\q2 kaunariteya pɨkahatekixɨani.   
\q1
\v 21 Mana Yawé matsiɨkɨme payeitɨani yutɨrɨkariya.  
\q2 Haa 'a'atayeyeutɨ maxuawe payani meta 'etsihatayeyeutɨ manuyehapane.  
\q1 Kanuwa 'etsimupe muwekiexime mana pɨka'uyeyani,  
\q2 meta kanuwa 'amupapa mɨtɨrɨkawi.   
\q1
\v 22 Yawé mɨtatsi'uwitɨxime mɨhɨkɨkɨ,  
\q2 Yawé manuyeka kanihɨkɨtɨni.  
\q1 Yawé tati'aitɨwame mɨhɨkɨkɨ:  
\q2 Mɨkɨ katanitawikweitsitɨamɨkɨ.   
\b  
\q1
\v 23 'Akaunarite kaniuweranaxɨani:  
\q2 Patera manuwie pɨkakuhana  
\q2 'ixuriki heitserie pɨka'anuyewɨ.  
\q1 Waɨkawa piinitɨarika memɨte'a'iwaxɨ mekatenetapixɨakuni,  
\q2 meta memɨka'ɨkɨniwawe 'ɨaritɨ mekateninawakuni.   
\q1
\v 24 Nixewitɨ mɨpaɨ pɨkatayɨni: «Nepɨtikuye»,  
\q2 mana kiekatari 'axakememɨte'uyurikɨ mepɨteheuyehɨwiyarieni.   
\c 34  
\s1 Niuki nuiwarite wahetsiemieme  
\q1
\v 1 Nuiwarite, 'ahurawa xekenewakɨni xemɨ'enananikɨ.  
\q2 Teɨteri, kayuwatɨ xekeneu'enana.  
\q1 Kwie ke'i'enieni, meta naitɨ mana mɨtixuawe,  
\q2 kwiepa kemakuyewa, meta tita mɨtixuaweriya.   
\q1
\v 2 Yawé kaniha'aka yunaime nuiwarite wahamatɨa,  
\q2 meta yunaime kuyaxi wahamatɨa.  
\q1 Mɨkɨ kaniwaruka'una yunaime  
\q2 memɨkwi'iwakɨ kaniwayetuani.   
\q1
\v 3 Wakaxarite kanexɨriyamɨkɨ,  
\q2 wawaiyari 'ukuri'ɨatɨkaitɨ kanitipɨnimɨkɨ,  
\q2 waxuriya hɨrite kanitixɨtɨaximeni.   
\q1
\v 4 Xurawetsixi muyuawitsie memeukatei mekanitaxɨriexɨakuni,  
\q2 meta muyuawi kaniyutakwikwiemɨkɨ xapa hepaɨ,  
\q1 yunaitɨ xurawetsixi yuxawatɨriya meneuyehɨakuni,  
\q2 kaxie xawari wakitɨ kemɨrakawiwike,  
\q2 meta xapa takari wawakitɨ kemɨtikaxɨrɨwe.   
\b  
\q1
\v 5 Ne'ixipara muyuawitsie kaniutitaweni,  
\q2 'ari 'akanakamieni 'Erumi hetsie tiwakwinitɨanike,  
\q2 mɨkɨ teɨteri 'ari yanepɨtiwarutahɨawixɨ nemɨwareuyehɨanikɨ.   
\q1
\v 6 Yawé 'ixiparaya kanixuriyamaka,  
\q2 tsipuri meta muxatsi waxuriyakɨ,  
\q1 kaniwiyamaka,  
\q2 muxatsi 'ukitsi wamumé wiyayari xiteyarikɨ.  
\q1 Yawé mawarika puwewie Wutsira paitɨ,  
\q2 meta puwarukwi 'Erumi kwieyaritsie yumɨireme.   
\q1
\v 7 Wahamatɨa mekanikwikuni tuurutsixi yeutari wahepaɨ memɨ'anene,  
\q2 meta tsikerutsixi metatsiere tuurutsixi.  
\q1 Wakwietsie xuriya kanitayeurimɨkɨ,  
\q2 wiya tumuanaritsie kanakɨnɨmɨkɨ.   
\b  
\q1
\v 8 Yawé mɨyɨkɨhɨanikɨ kanitukarieyatɨni,  
\q2 mɨrayukatuani wiyari kanihɨkɨtɨni  
\q2 Tsiyuni hetsie tanuanike.   
\q1
\v 9 'Erumi 'akiyaritetsie kwetsɨka muwitsɨani hayari kaniuhapanekamɨkɨ,  
\q2 kwauniyari hatsupure mɨta'a kanayeimɨkɨ  
\q2 meta tiyutaiyatɨ kwetsɨka muwitsɨani kanayeimɨkɨ mɨkɨ kwieyari.   
\q1
\v 10 Tukarikɨ meta tɨkarikɨ pɨkakutɨtɨtseni,  
\q2 kɨtsi yapɨretineikani.  
\q1 Yuheyemekɨ 'akumawetɨ payani waxiɨyari,  
\q2 hatsuaku xewitɨ mana pɨka'uyeyani.   
\q1
\v 11 Piwame meta naika 'ɨtsita kiekatari mana mepɨkiekataritɨni  
\q2 mana mikɨri meta kwatsa hamatɨa mepuyuti'ituatɨani.  
\q1 Kakaɨyari 'Erumi kwieyaritsie pɨtitamɨiriya  
\q2 ti'inɨnɨatamekɨ yuxamuriekame payeitɨwa  
\q2 tepɨa mahete hirukɨ mɨwiwiekɨ pɨrakumaweriya.   
\q1
\v 12 Memanuyetei mana mepɨka'u'uwani  
\q2 meta mana xewitɨ pɨkati'aitani,  
\q2 yunaitɨ mana te'aitamete mekanikumawerikuni.   
\q1
\v 13 Waparatsiyuta xuya pɨtinexɨani,  
\q2 meta wakii 'aixɨa mɨ'aneneta 'ɨtsi pɨtinexɨani.  
\q1 Yawixi memayu'eririya wakii payani  
\q2 meta 'aruxi 'amemɨnene wa'itua.   
\q1
\v 14 Teyukwa'amete makumawetsie miemete mepuyutinɨni tsɨikɨri yeutari wahamatɨa,  
\q2 tsipuri yeutari mepuyɨkɨhɨaweni hipame wahamatɨa,  
\q1 metatsiere mana mepɨkiekataritɨni memawɨwawe tɨkarikɨ miemete  
\q2 mekanikaxeiyakuni yu'uxipiweme.   
\q1
\v 15 Mana mikɨri puyuta'ituatɨani pɨtitixɨrieni,  
\q2 yu'anatetɨa yupixɨxɨitsi puwata'ɨwiya.  
\q1 Manatatsiere mepuyukuxeɨrieni wirɨkɨxi,  
\q2 meyu'iwamatɨkaitɨ.   
\p
\v 16 Yawé xapaya xekenakaxeiya, hikɨ xekenakaterɨwa:  
\q1 Nixewitɨ 'ikɨ yeutanaka pɨkaheuyeweka,  
\q2 yunaitɨ yu'iwama mepɨwareuxeiyani.  
\q1 Yawé mɨpaɨ katiniu'aita,  
\q2 meta 'Iyarieya kaniwakuxeɨrimɨkɨ.   
\q1
\v 17 Mɨkɨ kaniwaranuyexeirieni hakewa memeyuhayewa,  
\q2 yumamakɨ kaniwaru'itɨirieni wakwie.  
\q1 Mɨkɨ mana yukie mekanayeitɨakuni yuheyemekɨ,  
\q2 mana mekaniyuhayewakuni waxiɨyarima yuheyemekɨ.   
\c 35  
\s1 Memutawikwetsitɨarie watemawierika  
\q1
\v 1 Makumawe puyukatemawieni meta 'ɨtsi mɨtiwawaki,  
\q2 makumawe puyutemawieka  
\q2 meta tuturi hepaɨ pɨtaxutuni.   
\q1
\v 2 Pɨkaxutuni puyutemawieka:  
\q2 putahiwani temawierikakɨ.  
\q1 Riwanu tsimɨtiyuxexeiya mɨpaɨ pɨtipitɨarieni,  
\q2 meta Kaximeru metatsiere Tsaruni 'aixɨa kememɨte'utixuawitɨwakai.  
\q1 Mɨkɨ Yawé mariweme mepɨxeiya,  
\q2 Kakaɨyari witsi'anetɨ kemɨtimariwe.   
\b  
\q1
\v 3 Xekenetseiriyani mamate mɨwerarani,  
\q2 tuunute xekenetseiriyani muyɨyɨakatɨka,   
\q1
\v 4 mɨpaɨ xeketeniwarutahɨawi yu'iyaritsie memɨmama:  
\q2 «Xekenetɨrɨkawini, xepɨkamamaka  
\q1 Xekakaɨyari kaninuamɨkɨ,  
\q2 punuani mɨtiwarakapitɨanikɨ,  
\q1 tiwapitɨanike kahekɨakamekɨ  
\q2 kanixetawikweitsitɨamɨkɨ».   
\b  
\q1
\v 5 Hikɨ 'ana memɨkaheuneniere wahɨxite heunenieretɨ kanayeimɨkɨ,  
\q2 meta memɨkaheu'enana meheu'enanatɨ mekanakɨnikuni,   
\q1
\v 6 mɨka'uyeiwe kanititsunamɨkɨ maxa hepaɨ,  
\q2 meta mɨkaniuwe temawierikakɨ kanitahiwamɨkɨ.  
\q1 Makumawetsietsɨ haa kanitinexɨamɨkɨ,  
\q2 waɨkawa haa kanetinexɨamɨkɨ makuwakitsie.   
\q1
\v 7 Xiekari mɨxɨka haa kwekwewiwame kanayeimɨkɨ,  
\q2 kwie waɨkawa meuharimɨkɨ hetsiena haixa kanetinexɨamɨkɨ meta hapurarai.  
\q1 Hakewa yawixi memayu'eririya memetikukutsukai  
\q2 mana haka kɨyexi hatamete kanitinexɨamɨkɨ.   
\b  
\q1
\v 8 Mana huye puyehaneni  
\q2 “Huye mɨpatsie” katiniterɨwariemɨkɨ.  
\q1 Mɨkɨ 'utɨma memɨka'itiyatɨka mepɨka'uyekɨne,  
\q2 meta memɨka'u'iyari mana memuyekɨne mepɨkayɨwaweni,  
\q2 huye memuweiya wahetsiemieme xeikɨa kanayeimɨkɨ.   
\q1
\v 9 Mana maye pɨka'uyeikani,  
\q2 meta tiyukwa'ame mɨkɨ 'utɨma pɨkayemie,  
\q1 Mɨkɨ 'utɨma nitixaɨtɨ pɨkatitaxeiyarieni.  
\q2 Mana mekaniuyekɨnikuni xeikɨa memutawikweitsitɨarie.   
\q1
\v 10 Yawé hetsɨa mekani'axɨakuni memutawikweitsitɨarie,  
\q2 Tsiyuni mekaneutahaxɨakuni temawierika kwikariyari mekwikatɨ,  
\q2 yuheyeme temawierikakɨ mekurunatɨarietɨkaitɨ.  
\q1 Temawierika pɨta kaniwaranuku'aximɨkɨ,  
\q2 nutuixiya meta hiwerika kaniyemieni.   
\c 36  
\s1 Tsenakeriwi Kerutsareme kemɨtiuta'uni  
\r (Kits 36:1-22 – 2Te 18.13, 17-37, 2Kem 32.9-19)  
\p
\v 1 Tamamata heimana nauka wiyari ti'aitakaku 'Etsekiyaxi, Tsenakeriwi 'Atsiriya kwieyaritsie ti'aitame, Kura kaniutamieni meta kiekariteya mɨtɨrɨkawi yuhetsiemieme kanayeitɨani.  
\v 2 Ti'aitame 'Atsiriya kiekame Rakixi paitɨ 'ukaitɨ kuyaxi tiwa'aitɨwame kanenɨ'ani, yumɨireme kuyaxi warawitɨkɨme, ti'aitame 'Etsekiyaxi hamatɨa mɨretaxatakɨ Kerutsareme paitɨ. Kepauka kuyaxi tiwa'aitɨwame, haa wapaitɨ meukatuarike manuhuyeritɨarie manuyekatsie mu'uxipi, 'Ekwame Kwieya makuma huyeyari manuyehane 'utɨa,  
\v 3 hikɨ kanayeyani 'enunakeke 'Eriyakini paratsiyuta mɨti'aitakai Kirikiyaxi nu'aya, warawitɨtɨ kemɨtiuyɨ ti'utɨwa Tsewina meta ti'utɨwame Kuha 'Atsahapi nu'aya.   
\p
\v 4 Kuyaxi tiwa'aitɨwame manuyeka mɨpaɨ katiniwarutahɨawe:  
\p ―Mɨpaɨ xeketenetahɨawi 'Etsekiyaxi kename mɨpaɨ haine ti'aitame mɨmariwe, ti'aitame 'Atsiriya kiekame: “¿Ketitatsie peti'atɨrɨkariya?   
\p
\v 5 'Ekɨ mɨpaɨ pemutaine kename perakumate meta kename kuyaxi pewarexeiya, peru neuxei mɨkɨ pɨniuki xeikɨa. ¿Ketitatsie petiwiya, titayari peti'awaɨriya penetsi'aye'unietɨ pemayanikɨ?  
\v 6 Neuxei, 'ekɨ 'Ekipitutsie pemɨtiwiya, mɨkɨ 'itsɨ mɨxainitsie, xɨka hetsiena perawiya manumure meta mɨtiwakwinitɨa kemɨ'ane mana memɨtehawiwiya. Mɨkɨ Parahuni kanihɨkɨtɨni ti'aitame 'Ekipitu kiekame, kemɨ'ane hetsiena memɨtewiya wahetsiemieme.  
\v 7 Xɨka 'ekɨ mɨpaɨ penetiutahɨawe: ‘Tame Yawé hetsie tepɨtewiya takakaɨyaritsie’, ¿kamɨtsɨ mɨkɨ katixatsiwa, 'Etsekiyaxi, 'iya hakewa Kakaɨyari hetsiemieme mawari matiwewiwatɨkateitsie meta tukite 'etsimupepe pemuti'unaxɨ, mɨpaɨ petiwakɨhɨawetɨ Kuratsie kiekatari meta Kerutsaremetari: ‘'Ikɨ mawari taiyame hɨxie xeikɨa kaniyɨwemɨkɨ xemeyexeiyanikɨ’?”   
\p
\v 8 »Hikɨ 'Etsekiyaxi, 'ikɨ tɨratu keneuwewi neti'aitɨwame hamatɨa, ti'aitame 'Atsiriya kiekame: Ne nepɨmatsiyetuirie huta miriyari kawayutsixi, xɨkata 'ekɨ mɨpaɨ yupaɨmeme pewakuwaumɨkɨ memanutiyaxe.  
\v 9 'Ekɨ pepɨkayɨwe xeime tɨma pemutaweiyakɨ tsepa waɨkawa mɨkayɨwe neti'aitɨwame hetsɨa miemete, tsepa 'Ekipitu hetsie pemuyɨkɨ'ɨ kaxetate yumemiwame mexeiyakɨ meta kawayatsixi.  
\v 10 ¿Kamɨtsɨ xeme mɨpaɨ xɨari xepɨteku'eriwa kename ne Yawé kanetsiparewiekaku neyɨane 'ikɨ kiekari nemu'unamɨkɨ? Matsi mɨkɨ mɨpaɨ kanetineta'aitɨani: “Mɨkɨ kwieyaritsie kenemieka keneka'una”».   
\p
\v 11 'Eriyakini hamatɨa Tsewina meta Kuha mɨpaɨ kuyaxi tiwa'aitɨwa mekateniutahɨawe:  
\p ―Neuxei pamɨpariyutsixɨa, tame temate'uximayatsiriwamete 'arameu niukiyarikɨ ketatinekuxaxatɨwani tame mɨkɨ tekani'enieka. Hepɨrayukɨ pepɨkatatsikɨhɨaweni, yunaitɨ kurarutsie memakatei mepɨta'enana.   
\p
\v 12 Peru kuyaxi tiwa'aitɨwame mɨpaɨ kaniutayɨni:  
\p ―Ne neti'aitɨwame pɨkanetsiheyenɨ'a 'ekɨ meta mati'aitɨwame hamatɨa xeikɨa nemɨtixetaxatɨanikɨ, matsita kurarutsie memakatei yunaime. Metsɨ yunaitɨ mɨkɨ meta xeme yukwita xekanitikwaikuni meta yuxixi xekanitiharikuni.   
\p
\v 13 Mɨpaɨ 'utayɨka, kuyaxi tiwa'aitɨwame 'akaniutakeni, hikɨ kwi 'utahiwatɨ hepɨrayukɨ mɨpaɨ kaniutayɨni:  
\p ―Ti'aitame mumariwe niukieya xekeneu'eni, ti'aitame 'Atsiriya kiekame:  
\v 14 Mɨpaɨ kainaneni ti'aitame: “'Etsekiyaxi nɨka tixe'u'itaiya. Mɨkɨ mɨxe'utawikweitsitɨani pɨkayɨwe.  
\v 15 'Etsekiyaxi xepɨka'enieka mɨxekemakaxɨanikɨ Yawé hetsie yuri xemɨte'eriekakɨ mɨpaɨ xetikɨhɨawetɨ: ‘Yurikɨ Yawé pɨtatsixɨna, 'ikɨ kiekari 'Atsiriyatsie ti'aitame hetsɨa pɨkakaweni.’”   
\p
\v 16 »'Etsekiyaxi xepɨka'enieka. Mɨpaɨ kanaineni ti'aitame 'Atsiriya kiekame: “Nehamatɨa kayuwatɨ xemexeiyanikɨ tɨratu xekeneuwewi, xekeneyuyetua. Mɨpaɨ xɨka xe'ɨyɨni xepɨtetikwani yukaxietsie timieme meta yupiní 'ikwaxiyari, metatsiere xepɨtihareni yuputsuta,  
\v 17 kepaukaketa ne nemayeneni nemɨxe'anuwitɨni xekwie hepaɨ 'anemetsie, kwie tɨriku maxuawetsie meta kaxie winuyari, paa maxuawetsie meta kaxie harawerita”.   
\p
\v 18 »Xepɨka yuwaɨriyani xɨka 'Etsekiyaxi mɨpaɨ tixekɨhɨaweni: “Yawé tahetsie kanitanuamɨkɨ”. ¿Hipatɨ nuiwari kamɨtsɨ wakakaɨyarima wahetsie mete'utanua kepauka ti'aitame 'Atsiriya kiekame wahetsɨa mɨye'a?  
\v 19 ¿Hakewa kamɨtsɨ Kamati kakaɨyarimama meta 'Axipari? ¿Hakewa kamɨtsɨ Tsepariwahini kakaɨyarimama? ¿Kamɨtsɨ Tsamariya tiutawikweitsitɨa 'Atsiriya hetsɨa?  
\v 20 Xewitɨtɨma kakaɨyaritɨtɨ 'ikɨ nuiwarite wakwieyaritsie 'uyeikatɨ pɨkayɨwe yukiekari mɨxɨnakɨ netɨrɨkariyatsie. ¿Kamɨtsɨ tiyɨweta Yawé Kerutsareme hetsie mutanuani kepauka nemika'una?»   
\p
\v 21 Peru teɨteri kayuwatɨ mepumakai ni'etsiwatɨma mepɨka'utiniu, ti'aitame mɨpaɨ mainekaikɨ: «Xepɨka'iku'eiyani».   
\p
\v 22 Hikɨ 'Eriyakini Kirikiyaxi nu'aya, mɨti'uximayakai paratsiyuta, meta Tsewina kemɨtiuyɨ ti'utɨwame metatsiere mɨraka'utɨwa Kuha 'Atsahapi nu'aya, yukamixa meheukatsanaxɨaka hiwerika 'inɨariyari memexeiyanikɨ, menekɨne 'Etsekiyaxi hetsɨa, mekatenitaxatɨani kemutayɨkai kuyaxi tiwa'aitɨwame.   
\c 37  
\s1 Yawé Kerutsareme hetsie kemɨtiutanua  
\r (Kits 37:1-13 – 2Te 19:1-13)  
\p
\v 1 Kepauka ti'aitame 'Etsekiyaxi mɨpaɨ mɨtiu'enaxɨ, yukamixa kaneukatsana, hiwerika kamixayari 'anakatɨka Yawé tukita kaneyani.  
\v 2 Metatsiere 'Eriyakini paratsiyuta mɨti'aitametɨkai, meta kemɨtiuyɨ ti'utɨwame Tsewina metatasiere 'ukirawetsixi mawari wewiwamete kaniwarenɨ'ani, yunaitɨ mɨkɨ hiwerika kamixayari me'anakatɨtɨkaime, Kakaɨyari niukameya Kitsariyaxi 'Amuxi nu'aya hamatɨa memɨtehetixatakɨ.  
\v 3 Mɨpaɨ mekatenitahɨawe: «'Etsekiyaxi mɨpaɨ kanaineni: “Hikɨ 'ikɨ tukaritsie nutuixiya tukariyari kanihɨkɨtɨni meta kukuiniya metatsiere 'axatekaniu'itɨarieni, kepauka nunutsi yumaamatsie mɨka'anuyeyeiwe tinuiwake hepaɨ, matsi maamaya mɨkaheutɨrɨkaɨye mitinuiwitɨanikɨ.  
\v 4 Heiwatɨ Yawé 'Akakaɨyari kuyaxi tiwa'aitɨwame niukieya 'u'enieni, ti'aitɨwameya 'Atsiriyatsie ti'aitame meinɨ'a, Kakaɨyari mayeniere 'axamɨretahɨawekɨ. Yawé 'Akakaɨyari ketiwarukwinitɨani niuki mɨya'aneme mɨwaru'enirikɨ. Hikɨ keneyutanenewi, teɨterimama memuyuhayewatɨwe wahetsiemieme, 'akuxi 'amemu'uwa”».   
\p
\v 5 Kepauka ti'aitame 'Etsekiyaxi te'uximayatsiriwamete Kitsariyaxi memɨtehekuxatɨa,  
\v 6 mɨkɨ mɨpaɨ katiniwarutahɨawe: «Tixe'aitɨwame mɨpaɨ xeketenetahɨawi Yawé mɨpaɨ kanaineni: “Pepɨkamaka mɨkɨ niuki 'axamanɨyɨne pemu'enikɨ, meta kemutayɨ nehetsiemieme ti'aitame 'Atsiriya kiekame nɨ'arieya.  
\v 7 Neuxei, ne xeime 'iyari hetsiena nekanikayemɨkɨ, kepauka mɨ'ena kename kereyɨ kaniyemieni yukwieyaritsie. Muwapaitɨ yanekatiniyurimɨkɨ 'ixiparakɨ memierienikɨ”».   
\p
\v 8 Kepauka kuyaxi tiwa'aitɨwawe mɨretima kename 'Atsiriya kwieyaritsie ti'aitame kiekari Rakixi mɨrakutewatsie 'ayeyakai, 'ayumieme kaneyani, hikɨ ti'aitame kanetaxeiya yumieneme Riwina hamatɨa.   
\p
\v 9 Metatsiere Tsenakeheri katiniutaxatɨarieni kename Tiraka, ti'aitame Kutsi kiekame, hayeyakai 'itamienike. Hikɨ mɨpaɨ retimaka niuki tuayamete 'Etsekiyaxi hetsɨa kaniwarenɨ'ani  
\v 10 mɨpaɨ memɨteheitahɨawekɨ: «'Ekɨ 'Etsekiyaxi, ti'aitame Kura kwieyaritsie: 'Akakaɨyari hetsiena yuri pemɨti'erie nɨkatɨ metiu'itaiya, mɨpaɨ matikɨhɨawetɨ: “Ti'aitame 'Atsiriya kiekame Kerutsareme pɨkaka'una”.  
\v 11 Pekatinimaikari kememɨte'uyuri te'aitamete 'Atsiriyatsie miemete hipame kwieyaritsie, yunaime mepɨwarakumaweriyaxɨ. ¿Kamɨtsɨ 'ekɨ petitawikweiya?  
\v 12 ¿Kamɨtsɨ netutsima memɨwaruka'unaxɨ: Kutsani, Karani, Xetsepi meta Hereni kiekatari Teratsaxi memɨtamakai, wakakaɨyarima wahetsie mete'utanua?  
\v 13 ¿Kamɨtsɨ hakewa mepe'uwa te'aitamete, Kamati kiekame, 'Axipari kiekame, meta Tsepariwahini kiekariyaritsie kiekame, yatɨni Hena kiekame meta Hiwa kiekame?»   
\s1 'Etsekiyaxi nenewierieya  
\r (Kits 37:14-20 – 2Te 19:14-19)  
\p
\v 14 'Etsekiyaxi yutupiritsixi waxapa 'anuhurieka, mɨkɨ kanekaterɨwa. Hikɨta Yawé tukita kaneyani, Yawé hɨxie 'itawenaka,  
\v 15 mɨpaɨ katiniyunenewieni Yawé hɨxie:  
\v 16 «Yawé Naimekɨpemɨtɨrɨkaɨye, 'Ixaheri Kakaɨyarieya, 'ekɨ 'uweni pemexeiya 'ateɨtamete wahetsie: 'ekɨ xeikɨa te'aitamete kwiepa memɨtama pepɨwakakaɨyari. 'Ekɨ muyuawi peputawewi meta kwie.  
\v 17 Keneta'enani, Yawé, keneu'ena, kenanutanieri, Yawé meta keneniereni, naime niuki keneu'eni Tsenakeriwi kemɨtiunɨ'a Kakaɨyari pemayeniere 'axapemɨtitahɨawarienikɨ.   
\p
\v 18 »Yawé, kaniyuritɨni te'aitamete 'atsiriyutsixi yunaime 'ikɨ nuiwarite mekaniwarakumaweriya meta wakwie.  
\v 19 Wakakaɨyarixima taipa mekaniwareuxɨrieni meta mekaniwaruti'una, mɨkɨ memɨkakakaɨyarixitɨkaikɨ matsi xeikɨa kɨyexi meta tetexi memɨhɨkɨtɨkaikɨ, teɨteri wawewiya.  
\v 20 Merikɨte hikɨ, Yawé, takakaɨyari, ketaneutawikweitsitɨa mɨkɨ memɨtatsi'uniekɨ, yunaitɨ nuiwarite kwiepa memɨtama mɨpaɨ memɨtehetimanikɨ kename 'ekɨ xeikɨa Yawé, Kakaɨyari pehɨkɨ».   
\s1 Tsenakeriwi kemɨtiɨmɨ  
\r (Kits 37:21-38 – 2Te 19:20-37, 2Kem 32:20-21)  
\p
\v 21 Hikɨ Kitsariyaxi 'Amuxi nu'aya 'ikɨ niuki 'Etsekiyaxi kanenɨ'airieni: «Yawé mɨpaɨ kanaineni, 'Ixaheri Kakaɨyarieya: “Kepemɨnerawawiriwa Tsenakeriwi hepaɨtsita, 'Atsiriyatsie ti'aitame,  
\v 22 'ikɨ niuki kanihɨkɨtɨni ne Yawé kenemutayɨ hetsiena mieme:  
\q1 »”Tsiyuni niweya 'ɨimari  
\q2 kamenixani'erieka meta kaniutanaweni 'ahetsiemieme.  
\q1 Kerutsareme niweya 'uka matsixeiyatɨ  
\q2 yumu'u kaniuyuitɨwani pemɨ'ata'unaxɨkɨ.   
\q1
\v 23 ¿Kemɨ'ane 'axapepɨranutahɨawixɨa?  
\q2 ¿Kemɨ'ane hetsiemieme 'axapeputayɨ?  
\q1 ¿Kemɨ'ane pepanutahiwiexɨa  
\q2 meta kemɨ'ane hɨxie pepuyuta'ɨrixɨ?  
\q2 Mɨpatsie 'Ixaheri hetsiemieme hepaɨtsita.   
\q1
\v 24 Te'a'uximayatsiriwamete pepɨwarenɨ'a  
\q2 Yawé 'axamemɨtehetahɨawekɨ, mɨpaɨ pe'utaitɨ:  
\q1 ‘Nekaxetate yukukuyamete memɨyɨmɨirekɨ  
\q2 hɨri 'amɨtɨtɨtsie nepanutitɨa,  
\q2 Riwanu mukɨatsie.  
\q1 'Iteɨrieya kariuxa 'amutɨtɨ nepawitexɨa,  
\q2 hukuya mɨxexeurawi 'aixɨa mɨ'anene.  
\q1 Hɨriteya 'amanutitɨtɨ nepanuku'axixɨa,  
\q2 muhukuyatɨka witsimɨtiu'anene.   
\q1
\v 25 Haputsu neputiwewi 'ateewa kwie mukumanetsie,  
\q2 haa mana mieme nepanuhari.  
\q1 Neketatekɨ  
\q2 'Ekipitu hatɨayarite nepayewatsiɨxaxɨa’.   
\b  
\q1
\v 26 »”¿Mɨpaɨ pekaretimaiwe?  
\q2 Mɨixa wiyari panuyemieri ne nemɨtiukuha'aritaxɨ.  
\q1 Ne meripaitɨ yaneputayɨ,  
\q2 hikɨta nepeye'atɨa,  
\q1 'Ayumieme 'ekɨ pepɨwaruka'unaxɨ  
\q2 kiekarite mɨtɨrɨkawi.   
\q1
\v 27 Mana kiekatari, mepɨkatɨrɨkawi,  
\q2 meputimama meta mepuyutetewiya.  
\q1 Kɨyexi 'ɨtsita mieme hepaɨ mepɨ'ane,  
\q2 'ɨxa mɨyɨra hepaɨ,  
\q1 Kii heima tupiriya mɨnewe hepaɨ  
\q2 kataweriwetɨ mutawauke.   
\b  
\q1
\v 28 »”Ne nepɨtimate kepauka pemanukayeixa,  
\q2 kepauka pemeutahake, kepauka pemɨwayeyeika,  
\q2 meta kepauka nehepaɨtsita pemuyeha'arɨwe.   
\q1
\v 29 Nehepaɨtsita pemuyutahaxɨatɨakɨ  
\q2 hau'erietɨ pe'utaniuku 'aniuki nemu'enikɨ,  
\q1 'atsuritsie tixikɨraɨyeme nepɨtiuyewieni  
\q2 'ateta nepɨmatsi'utapirenutɨani,  
\q1 kemɨ'ane huye 'utɨa pemunua  
\q2 mɨkɨ 'utɨa nepɨmatsi'anunɨ'ani.   
\p
\v 30 »”'Etsekiyaxi 'ikɨ pɨ'inɨaritɨni 'ahetsiemieme:  
\q1 »”'Ikɨ wiyaritsie xepɨtetikwani tita mɨtitineni yuxaɨta,  
\q2 hutarieka wiyaritsie manatsiere mɨtitinexɨani.  
\q1 Peru hairieka wiyaritsie xepɨka'eni meta xepɨka'itsana,  
\q2 kaxie haraweri xepɨka'eni meta 'ikwaxiyari xepɨtikwani.   
\q1
\v 31 Tawarita Kura xiɨyarimama 'amemu'uwa  
\q2 mepananayataxɨani, meta mepɨkaxuawere.   
\q1
\v 32 Kerutsaremetsie hipatɨ memuyuhayewaxɨ,  
\q2 Tsiyuni hɨriyaritsie hipatɨ mepukuwikweni.  
\q1 'Ikɨ ne'ɨtetsari mɨyapɨtiyurieni,  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye 'ɨtetsarikaya.   
\p
\v 33 »”Ne, Yawé, mɨpaɨ nekanaineni ti'aitame 'Atsiriya kiekame hetsiemieme:  
\q1 »”'Ikɨ kiekaritsie pɨkaheutahani,  
\q2 meta 'ɨrɨ hetsɨana tɨma pɨkaheutahɨani.  
\q1 Kuya muyukunarɨma 'a'ɨtɨ hetsɨana pɨkaye'ani,  
\q2 meta kurarutana meukatsunakɨ pɨkatiwewieni.   
\q1
\v 34 Ke'aneme huye 'utɨa munua mɨkɨ 'utɨa kaniyemieni,  
\q2 'ikɨ kiekaritsie pɨkaye'ani.  
\q2 Ne, Yawé, mɨpaɨ nekanaineni.   
\q1
\v 35 Nekɨmana neminaki'eriekɨ, meta Rawiri neti'uximayatsiriwame nemɨnaki'eriekɨ,  
\q2 'ikɨ kiekari hetsie nepɨtanuani meta nepitawikweitsitɨani”».   
\p
\v 36 Hikɨ Yawé niuki tuayameya muyuawitsie mieme kanayeyani xeitsienituyari heimana nauka tewiyari heimana 'auxɨwi miriyari (185.000) kuyaxi 'atsiriyutsixi memakutekatsie kaniwarukwini. 'Uxa'arieka ximeri memanuku'ui hipatɨ wa'iwama, mana yunatɨ mɨkite mepukuhetei.  
\v 37 'Ayumieme Tsenakeriwi, ti'aitame 'Atsiriya kiekame, manukateitsie kaneyani. Niniwe kiekariyaritsie kaninuani mana kaniyuhayewa.  
\v 38 Peru kepauka, tukita yunenewienekaku yukakaɨyari 'ayexeiyakaku Nitsiruki, niwemama 'Aruramereki, Tsaretsexi hamatɨa mekanimieni 'ixiparakɨ, mɨya mete'uyurieka mekaniuyuta'una 'Ararati kwieyaritsie paitɨ. Hikɨ nu'aya 'Etsaxikaruni 'utɨmana ti'aitame kanayani.   
\c 38  
\s1 'Etsekiyaxi kwiniyaya  
\r (Kits 38:1-8 – 2Te 20:1-11, 2Kem 32:24-26)  
\p
\v 1 Mɨkɨ tukaritsie 'Etsekiyaxi katiniutakwine waɨkawamekɨ, 'ari kanimɨximekaitɨni. Hikɨ Kakaɨyari niukameya Kitsariyaxi 'Amuxi nu'aya kaneikuxeiya, mɨpaɨ katineitahɨawe: «Yawé mɨpaɨ kanaineni: “'Akie 'aixɨa ketineukuyuri, 'ari pekanimɨmɨkɨ, 'aixɨa pepɨkatika'erieniri”».   
\p
\v 2 'Etsekiyaxi 'ixumeritsie heunieritaka Yawé mɨpaɨ katiniutawawirieni:  
\v 3 «Yawé, kena'eriwani ne 'ahɨxie 'aixɨa nepɨtikatɨa meta ne'iyarikɨ 'aixɨa netinekɨhɨawetɨ, kemɨmatinake yanepɨtiuyuri». Hikɨ 'Etsekiyaxi karima kaniutatsuani.   
\p
\v 4 Hikɨ Yawé niukieya Kitsariyaxi hetsie kaninuani mɨpaɨ katinitahɨawe:  
\v 5 «'Etsekiyaxi hetsɨa kenemie mɨpaɨ ketinetahɨawi Yawé mɨpaɨ kanaineni, 'atutsi Rawiri Kakaɨyarieya: “Nekani'enieni 'anenewieri meta 'a'ukai nekaniuxeiya, tawarita 'akuxi tamamata heimana 'auxɨwi wiyari nekamanipitɨaka pemuyeikanikɨ.  
\v 6 'Ekɨ meta 'ikɨ kiekari nepɨxetawikweitsitɨani ti'aitame 'Atsiriya kiekame mɨkaxeka'unanikɨ. Ne 'ikɨ kiekaritsie nekanitanuamɨkɨ.  
\v 7 'Ikɨ kani'inɨaritɨni nemɨmatsiyetuirieni kenemɨmarahɨawe:  
\v 8 Yanepɨtiyurieni 'Akatsi 'inɨarieyatsie tau 'etɨriyaya tamamata 'inɨariyari pɨkayani yu'utɨma”». Hikɨ mɨpaɨ katiniɨyɨni tamamata 'inɨariyari kanikayani tau 'etɨrieya.   
\s1 'Etsekiyaxi kemɨraka'utɨa  
\p
\v 9 'Arike 'Etsekiyaxi Kura kwieyaritsie ti'aitame tikuyetɨ 'aixɨa tiuka'erieka mɨpaɨ katinaka'utɨani:   
\q1
\v 10 «Ne mɨpaɨ neputainekai:  
\q2 “'Ari kauka mɨki teukiyata nenikayune,  
\q2 kaukari tukari nekahexeiyatɨ nenayani”.   
\q1
\v 11 Ne mɨpaɨ neputainekai: “Tawariri Yawé nepɨkaxeiya  
\q2 memayeneniere memanu'uwatsie,  
\q1 tawariri teɨteri nepɨkawaxeiya,  
\q2 'ena kwiepa memɨte'u'uwa”.   
\q1
\v 12 Nekii nekaniuka'uniyarieni, nekaniunawaiyarieni,  
\q2 muxatsi wahɨweme 'ixuriki xamaruya hepaɨ.  
\q1 'Itsame hepaɨ, netukari nekatiniutakwikwieni,  
\q2 maye'itse mɨkɨ kananuyeteke.  
\q2 Yapauka xeitɨkariyaritsie kaneniukumaweriya.   
\q1
\v 13 Netinewietɨ nepikwewi kepaukake tau 'ɨrɨya manatine,  
\q2 mɨkɨ peru, maye hepaɨ naime ne'umeyarite putimuraxɨ.  
\q2 Yapauka xeitɨkariyaritsie kaneniukumaweriya.   
\q1
\v 14 Wiki 'itsitame kuyeikame hepaɨ nekatiniutsuani, meta waurai hepaɨ,  
\q2 kukuru hepaɨ neputainekai.  
\q1 Muyuawitsie nieriyakɨ nehɨxite puti'uxixɨa.  
\q2 Nepu'uximatɨarie, Yawé.  
\q2 Kwerietɨ keneneuparewi.   
\b  
\q1
\v 15 »Neuxei ¿kenehaineni?  
\q2 Mɨkɨ mɨpaɨ kanetiniutaxatɨani, meta mɨpaɨ katiniuyurieni.  
\q1 Ne'iyaritsie kukuiniyakɨ  
\q2 nepɨkakutsu.   
\q1
\v 16 Yawé, teɨteri 'aniukitsie xeikɨa mepɨtewiya,  
\q2 yaxeikɨata ne'iyari mana 'aixɨa ti'aneme pɨtiukaxexeiya.  
\q1 'Ekɨ 'aixɨa pepɨnetiuka'eritɨa  
\q2 tukari pepɨnetsi'upitɨa.   
\q1
\v 17 Mɨpaɨ nepɨtimate, 'aixɨa mɨti'anenikɨ  
\q2 'uximatɨarikatsata nepuyetɨa.  
\q1 Penetsinaki'erietɨ pepɨkanetsi'upitɨa  
\q2 mɨki teukiyata nemɨkayunekɨ,  
\q2 'axakenemɨtiuyuri pepuwarixiwiyaxɨ.   
\q1
\v 18 Mɨki teukiya 'aixɨa pɨkamarahɨawe,  
\q2 mɨki pɨkamatsinɨawa.  
\q1 Mɨki teukiyata memeukakɨka  
\q2 tixaɨtɨ mepɨkatetakwewie wahetsie kepemɨtiwiyanikɨ.   
\q1
\v 19 Kemɨ'ane memu'uwa, peru kemɨ'ane xeikɨa memu'uwa,  
\q2 mɨkɨ mepɨhɨkɨ memɨmatsinɨawa,  
\q2 hikɨ ne kenemɨmatinɨawa.  
\q1 Wapaapama yunaitɨ yuniwema mekateniwataxatɨakuni  
\q2 wahetsie kepemɨtiwiyanikɨ.   
\b  
\q1
\v 20 »Yawé pɨnetsitawikweitsitɨani,  
\q2 Yawé tukita  
\q1 teye'uwatɨ kanaritekɨ tepinɨawani  
\q2 naimekɨ ketemɨteheutere».   
\p
\v 21 Kitsariyaxi mɨpaɨ painekai: «xapa 'ikwaxiyari witsɨanime xekenekawewi, haiyayatsie xekeneuwiri, mɨkɨkɨ 'aixɨa katinika'erimɨkɨ».   
\p
\v 22 'Etsekiyaxi meta mɨpaɨ katiniuta'iwaukaitɨni: «¿Ke'aneme 'inɨari nepɨyetuiriyarieni Yawé tukita nemanutiyanikɨ?»   
\c 39  
\s1 Wawiruniyatari tupiritsiximama  
\r (Kits 39:1-8 – 2Te 20:12-19)  
\p
\v 1 'Iya tukaritsie ti'aitame Wawiruniya kiekame Meruraki-Wararani Wararani nu'aya, xapa niuki 'aye'ukame 'Etsekiyaxi kanenɨ'airieni meta 'imikieri, tiutamarieka kename rekuyekai meta kenameri 'etsiwa 'aixɨa reu'eriekai.  
\v 2 'Etsekiyaxi mɨkɨ ranupika kaniyutemawiekaitɨni, mɨkɨta tupiritsixi katiniwaruxeitsitɨani naime yupiinite waɨkawa mɨraye'atɨka mɨrexeiyakai: pɨrata, huru, witsimɨtiɨ'ɨatɨka, hatseiti 'aixɨa mɨ'ane, meta kuyaxa timieme mɨtiuyepine tinaime. 'Etsekiyaxi naime yuparatsiyuta timieme pɨtiwaruxeitsitɨa nitixaɨtɨ pɨkatiuhayewaxɨ meta keyeumetsie mɨti'aita naime puwaruxeitsitɨa.   
\p
\v 3 Hikɨ Kakaɨyari niukameya Kitsariyaxi ti'aitame 'Etsekiyaxi hetsɨa kaneyani mɨpaɨ katinita'iwawiya:  
\p ―¿Ketita mɨkɨ teɨteri meteheuyehɨakai? ¿Hakewa mepeyekɨ?  
\p 'Etsekiyaxi mɨpaɨ katinita'eiya:  
\p ―'Ateewa mekaneyekɨne Wawiruniya kwieyaritsie paitɨ, mana meheyekɨneka mepɨnetsiheku'iwataxɨ.   
\p
\v 4 Kakaɨyari niukameya mɨpaɨ katinita'iwawiya:  
\p ―¿Ketita 'aparatsiyuta timieme mete'uxei?  
\p 'Etsekiyaxi mɨpaɨ katinita'eiya:  
\p ―Tinaime muwa timieme mepɨte'uxei, tixaɨtɨ nepɨkatiuti'awietaxu mɨraye'axe memɨkatexeiyakɨ tinaime nepɨtiwaruxeitsitɨa.   
\p
\v 5 Hikɨ Kitsariyaxi mɨpaɨ katinitahɨawe:  
\p ―Yawé Naimekɨmɨtɨrɨkaɨye niukieya keneu'eni:  
\v 6 “Tukari kanaye'amɨkɨ kepauka tita naitɨ 'aparatsiyuta mɨtiyepine mɨraye'atɨka 'apaapama muwa memɨte'uku'eiri, mɨkɨ Wawiruniya katinanutɨkiemɨkɨ. Nitixaɨtɨ pɨkatiyuhayewa ―Yawé mɨpaɨ kanaineni―.  
\v 7 Meta hipatɨ 'aniwema meta 'anuiwarima mekananuhapaniekuni mekaneneɨkiwawetɨ memayeitɨarienikɨ Wawiruniya kiekariyaritsie ti'aitame paratsiyuyata memɨte'uximayakakɨ”.   
\p
\v 8 'Etsekiyaxi mɨpaɨ katinita'eiya:  
\p ―Yawé niukieya 'ekɨ pemɨnetsi'atɨiri 'aixɨa kani'aneni.  
\p Mɨkɨ mɨpaɨ pɨtiku'eriwakai: «Mexi ne ne'uyeikani, kayuwatɨ pumaka meta 'aixɨa 'iyari nepuyeikani».   
\c 40  
\s1 Nɨtɨarika Kakaɨyari teɨterimama wahetsiemieme  
\q1
\v 1 Xekenewanɨtɨaka, neteɨterima xekenewanɨtɨaka  
\q2 —wakakaɨyari mɨpaɨ kanaineni—.   
\q1
\v 2 Kerutsareme witsixeketenekɨhɨaweni,  
\q2 mɨpaɨ xeketeneutahɨawi  
\q1 'ari mekatenaye'atɨani mete'uximayatɨ,  
\q2 'axamɨtiuyurikɨ 'ari katiniuyutuani,  
\q1 'ari Yawé kaniwaru'uximatɨani  
\q2 'axakememɨte'uyurikɨ matsi waɨkawa hepaɨna paɨmemekɨ.   
\b  
\q1
\v 3 Xewitɨ kanahiwani:  
\q1 «Makumawetsie huye xekeneukuha'aritɨa  
\q2 Yawé hetsiemieme,  
\q1 mu'ayepariyatsie kwie xekeneutihɨniya  
\q2 huye 'aixɨa xekeneuyuri takakaɨyari hetsiemieme.   
\q1
\v 4 Mayeweweritsie kwie ke'utihɨne,  
\q2 meta hɨri matitei 'akuweritɨ pɨta kehayani,  
\q1 'aki manuyeheitɨkatsie ke'akuparekure  
\q2 meta 'aki 'amɨpapa manuyeheitɨkatsie.   
\q1
\v 5 Hikɨ Yawé yuxawatɨriya kanihekɨatamɨkɨ,  
\q2 yunaitɨ kwiepa memɨtama mekanixeiyakuni.  
\qr Yawé yɨkɨmana mɨpaɨ kaniutayɨni».   
\b  
\q1
\v 6 Niuki mɨpaɨ kanaineni: «Keneutahiwani».  
\q2 Neta mɨpaɨ neraine: «Kehepaɨ netiuhiwani kuta».  
\b  
\q1 «Yunaitɨ teɨteri tupiriya hepaɨ mepɨ'anene,  
\q2 meta witsikememɨ'anene tuturi yeuta mieme hepaɨ kani'aneni.   
\q1
\v 7 Tupiriya kaniutawaukeni, tuturi kaniutayɨnareni,  
\q2 Yawé 'iiyaya wahetsie mɨye'axekɨ.  
\q2 Yurikɨ, teɨteri tupiriya mekanihɨkɨtɨni.   
\q1
\v 8 Tupiriya kanitiwaukeni meta tuturi kanitiyɨnareni,  
\q2 matsi takakaɨyari niukieya  
\q2 yuheyemekɨ kanayeniereni».   
\b  
\q1
\v 9 Tsiyuni, niuki 'aixɨa manɨyɨne xaxatame,  
\q2 hɨri 'a'utewime hetsie keneutiye'a.  
\q1 Kerutsareme, niuki 'aixɨa manɨyɨne tuayame,  
\q2 karima keneutahiwa.  
\q1 Keneutahiwa, pepɨkamaka,  
\q2 kiekarite Kura kwieyaritsie mukumane mɨpaɨ ketiniwarutahɨawi:  
\q2 «'Ena puyeika xekakaɨyari».   
\b  
\q1
\v 10 Neuxei, Yawé naimekɨmɨyɨwe kaniye'aka waɨkawa tɨrɨkaɨyetɨ,  
\q2 yutɨrɨkariyakɨ katini'aitani.  
\q1 Teɨterimama mekaniweiyani,  
\q2 tita mɨra'iwaxɨ hamatɨana kaniumieni.   
\q1
\v 11 Muxatsi wahɨweme yumuxatsima kemɨtiwa'ɨwiya hepaɨ,  
\q2 muxatsi tɨɨrixi kaniwaratɨkɨni,  
\q1 yutawie kaniwarutiyatsani,  
\q2 meta memɨhehekwa niwetɨka wakweriwayurietɨ kaniwaruwitɨximeni.   
\b  
\q1
\v 12 ¿Kemɨ'ane haramara pu'inɨatawe yumama meuwewerikɨ,  
\q2 meta kemɨ'ane yu'itɨwametekɨ muyuawi naime pu'inɨatawe?  
\q1 ¿Kemɨ'ane kwie tumuanariyari kiriwata pu'inɨataxɨ?  
\q2 ¿Kemɨ'ane hɨri panuyewi ti'inɨnɨatametsie?   
\q1
\v 13 ¿Kemɨ'ane Yawé 'iyarieya ketewamɨ'axe pi'inɨataxɨ,  
\q2 yatɨni kemɨ'ane 'i'ɨxatsitɨwameya payeiwe?   
\q1
\v 14 ¿Yawé kemɨ'ane hetsɨa pɨye'a ta'iwaunike yamɨtiyurienikɨ,  
\q2 kemɨ'ane huye mɨheitserie pixeitsitɨa?  
\q1 ¿Kemɨ'ane mɨtimaiwenikɨ pipitɨa  
\q2 yatɨni kemɨ'ane mɨtimaiwenikɨ huyeyari pixeitsitɨa?   
\b  
\q1
\v 15 Kakaɨyari hɨxie,  
\q2 haa tsuniyari wariteta meukatsuke hepaɨ nuiwarite mepɨ'anene,  
\q2 ti'inɨnɨatame mɨranuyewɨwɨtɨwatsie tumuanari 'etsipetɨ matikani hepaɨ.  
\q1 Yawé kwie haa hixɨapa mɨyetei ti'inɨnɨatemetsie kananuyewɨwɨtɨwani  
\q2 kwie kwi mɨmiyuanini mɨhɨkɨtɨni hepaɨ.   
\q1
\v 16 Riwanu kɨyexiyarikɨ xɨka hatinaini mawari taiyame heuyewetɨ 'akuxi payani,  
\q2 meta tewamamakɨ mawari taiyariyari xɨka 'uwewieni mepeuyeweka 'akuxi.   
\q1
\v 17 Yunaitɨ nuiwarite hɨxiena tixaɨtɨ mepɨkatehɨkɨ,  
\q2 mepɨkate'aye'atɨka hetsiena mieme.   
\b  
\q1
\v 18 ¿Kemɨ'ane Kakaɨyari hepaɨ 'aneme mepayeitɨani?  
\q2 ¿Kehepaɨ mete'iwewieni?   
\q1
\v 19 Tiwewiwame kakaɨyaritɨme kanitawewimɨkɨ,  
\q2 hurukɨ tiwewiwame huru pikawiriwa  
\q2 meta pɨrata kukayari pitiwewiriwa.   
\q1
\v 20 Kemɨ'ane tixɨatɨ mɨkarexeiya mawari mɨyetuanikɨ  
\q2 kɨye kaniutiwawani mɨkapɨniwe,  
\q1 meta kwinimieme mɨreutawewiwe kaniutiwawani  
\q2 kɨye kakaɨyariyari mɨtawewienikɨ ka'atiwautseme.   
\b  
\q1
\v 21 ¿Kamɨtsɨ xeme mɨpaɨ xekatemaikai?  
\q2 ¿Mɨpaɨ xekatehetimaiwawekai?  
\q1 ¿Mɨpaɨ xakate'utahɨawarie matɨari paitɨ?  
\q2 ¿Mɨpaɨ xekatehetima kwie muyukamatsie paitɨ?   
\q1
\v 22 Mɨkɨ katini'aitani muyuawi taheima muyema hetsie,  
\q2 mana teɨteri memu'uwa 'utsikari wahepaɨ mekateniyuxexeiyani.  
\q1 Mɨkɨ muyuawi kaniutawerani 'ixuriki xamaruyari hepaɨ,  
\q2 meta 'aixɨa katinikuwerani muwa mayekanikɨ.   
\q1
\v 23 Mɨkɨ memɨtɨrɨkawi kaniwarexɨrɨwani,  
\q2 meta 'ena kwiepa memɨte'aita tixaɨtɨ pɨkatiwarayeitɨwa.   
\q1
\v 24 Yu'aweri 'iteɨriyarikɨ mekaniukayatsarieni,  
\q2 hikɨke mekaniuka'etsieni,  
\q2 kwiepa wananayari katiniwiyaxɨaximenike,  
\q1 kepauka wahepa mɨreutahɨtsiwatsie mɨkɨ mekanitiwaukeni,  
\q2 hikɨ 'eka mɨtɨrɨkaɨye xatsi hepaɨ kaniware'enitsitɨwani.   
\b  
\q1
\v 25 «¿Kamɨtsɨ kemɨ'ane hepaɨ kename ne'ane xepɨtiyuani?  
\q2 ¿Kemɨ'ane nehepaɨ pɨ'ane?», mɨpaɨ kanaineni Mɨpatsie.   
\q1
\v 26 Teikɨ xekenenenieri, muyuawi xekeneutixeiya:  
\q2 ¿Kemɨ'ane mɨkɨ naime pɨtiutawewi?  
\q1 Kemɨ'ane xurawetsixi memuyumɨire 'aixɨa mɨtiwakuyayatsa yuxexeime,  
\q2 meta mɨwakɨhɨawe waterɨwatɨ yuxexuime.  
\q1 Kanimariweni tɨrɨkariyaya, kanitɨrɨkaɨyeni tɨrɨkariyaya,  
\q2 tixaɨtɨ wapaitɨ pɨkareuyewetse.   
\b  
\q1
\v 27 ¿Titayari Kakuwu petiniukixie?  
\q2 ¿Titayari 'Ixaheri peha'atɨ mɨyapetiutaine:  
\q1 «Yawé nehuye pɨkaxeiya,  
\q2 nekakaɨyari heitserie kenemɨrexeiya pɨka'imate»?   
\q1
\v 28 ¿Kamɨtsɨ pekatimate?  
\q2 ¿Kamɨtsɨ mɨpaɨ pekaretimaiwe?  
\q1 Yawé yuheyeme Kakaɨyari kanihɨkɨtɨni,  
\q2 naime kwie manu'atɨka mutawewi.  
\q1 Mɨkɨ pɨka'uxiwe meta pɨkawaɨripiwe,  
\q2 meta kemɨtiuyemate yemekɨ pɨkayumainɨa.   
\q1
\v 29 Mɨkɨ kemɨ'ane mu'uxe tɨrɨkaɨyeme payeitɨwa,  
\q2 meta kemɨ'ane memɨwerarani puwatɨrɨkariyatɨa.   
\q1
\v 30 Temari 'akuxi meputi'uxike, meputiwaɨripiwe,  
\q2 tɨɨri mehetixɨtemɨriketɨ mepekaxɨrɨwe,   
\q1
\v 31 peru Yawé hetsie kemɨ'ane memɨtewiya  
\q2 tɨrɨkariya hekwamekɨ mepukaxexeiya,  
\q1 kwixɨri wahepaɨ mepɨtiwɨxɨani:  
\q2 mepɨtinautsa mepɨkatiwaɨripieni,  
\q2 mepuhuni mepɨkati'uxe.   
\c 41  
\s1 'Ixaheri kemɨtiuparewiya  
\q1
\v 1 «'Ateewa haramara tetsita xemɨtitei, nehɨxie kayuwatɨ xekeneumaka.  
\q2 Nuiwarite, yutɨrɨkariya xekenehekwariyani.  
\q1 'Ahurawa xekenakɨneka xeketenekuxatani,  
\q2 tepɨtaxeɨrieka nemɨxetaxanetakɨ.   
\b  
\q1
\v 2 »¿Kemɨ'ane pita'ini 'iya yuheyemekɨ yamɨrayu'iwa  
\q2 tau manatineika kiekame?  
\q1 Mɨkɨ yumamatsie nuiwarite kaniwakuhɨweni,  
\q2 mɨkɨ hɨxie te'aitamete mekaniyuyetuayani.  
\q1 Yu'ixiparakɨ tumuanari kaniwarayeitɨwani,  
\q2 yutupikɨ kaniwata'enitsitɨwani xatsi memɨhɨkɨtɨni hepaɨ.   
\q1
\v 3 Hikɨ 'aixɨa 'iyari kaniwaranukuweweiyani  
\q2 mɨkɨ huye 'utɨa hatsuaku mɨka'uyetɨatsie.   
\q1
\v 4 ¿Kemɨ'ane 'ikɨ pɨtiuyuri? ¿Kemɨ'ane yamɨtiyɨnikɨ yapainekai?  
\q2 ¿Kemɨ'ane nuiwarite puwarutahɨawixɨ tsutɨa paitɨ?  
\q1 Ne, Yawé, mexɨakame nekanihɨkɨtɨni,  
\q2 meta mɨkɨtsiere nekanihɨkɨtɨkamɨkɨ 'imatɨrieka tukaritsie».   
\b  
\q1
\v 5 Haramara tetsita kiekatari mekanixeiya, mekanimamaka meta  
\q2 kwie manuye'atɨkatsie kaniwatayuaneni.  
\q1 'Ari 'ahurawa mekanahuni, 'umekanahuniri.   
\q1
\v 6 'Iwamarixi yunaitɨ mekaniyuparewieka,  
\q2 yu'iwamatɨ mɨpaɨ mekateniyutahɨaweni: «Kenetɨrɨkaɨyeni».   
\q1
\v 7 Mɨreutawewiwe yuwaɨriyame kanayeitɨaka hurukɨ tiwewiwame,  
\q2 meta titsunamekɨ mɨtitiweririta  
\q1 mɨpaɨ tepɨa hetsie tiwerime mɨrayeitɨwa pɨrahɨawe:  
\q2 «'Aixɨa pɨ'ane tepɨa mɨtiwiyatsitɨwani»,  
\q1 hikɨ kakaɨyari wewiyakame pukɨrapuxima  
\q2 mɨkawatayuanenikɨ.   
\b  
\q1
\v 8 «Peru 'ekɨ, 'Ixaheri, neti'uximayatsiriwame,  
\q2 'ekɨ Kakuwu, nemɨmatsi'anayexei,  
\q2 'Apɨrahami nehamiku nuiwarieya.   
\q1
\v 9 Kwie manu'axetsie paitɨ nepɨmatsiyewitɨ,  
\q2 kwie manuye'atɨkatsie paitɨ nepɨmatsi'utahɨawixɨ,  
\q1 mɨpaɨ nekametiniutahɨawe: “'Ekɨ neti'uximayatsiriwame pekanihɨkɨtɨni”.  
\q2 Ne nepɨmatsi'anayexei, nepɨkamatsi'utixani'eri.   
\q1
\v 10 'Ayumieme pepɨkamaka, netsɨ 'ahamatɨa nekaniuyeikani,  
\q2 pepɨka'a'uximatɨaka, ne nepɨ'akakaɨyari.  
\q1 Nepɨmatsitɨrɨkariyani meta nepɨmatsiparewieka,  
\q2 ne nepɨmatsituikani nemamakɨ 'aixɨa mɨtiyuriekɨ.   
\b  
\q1
\v 11 »Yunaitɨ kemɨ'ane memuyeha'awe 'ahepaɨtsita  
\q2 yurikɨ mekanitewiyatsitɨariekuni nitixaɨtɨ mepɨkate'akɨne,  
\q1 kemɨ'ane memɨmetsi'aye'unie mepukumawere,  
\q2 wa'atɨtɨ mepɨkate'u'uwakai.   
\q1
\v 12 Tsepa pemɨwarutiwau memɨmetsi'aye'unie,  
\q2 pepɨkawataxeiya.  
\q1 Kemɨ'ane memɨmatsimietɨwe nitixaɨtɨ mepɨkatehakɨne,  
\q2 wa'atɨtɨ mepɨkate'u'uwakai.   
\q1
\v 13 Netsɨ Yawé nekanihɨkɨtɨni, 'Akakaɨyari,  
\q2 'amamá 'atserie mieme mutuika,  
\q1 Ne nekanihɨkɨtɨni mɨpaɨ nemɨmerahɨawe:  
\q2 “Pepɨkamaka, ne nepɨmatsiparewieni”.   
\q1
\v 14 Kakuwu kwitsi, pepɨkamaka, 'Ixaheri 'etsipemɨpe  
\q2 ―Yawé mɨpaɨ kanaineni―,  
\q1 yaxeikɨa netsiere nekamaniparewimɨkɨ,  
\q2 Mɨpatsie 'Ixaheri hetsiemieme matsiwikwetsitɨwame kanihɨkɨtɨni.   
\b  
\q1
\v 15 »'Ekɨ tipɨname nekamanayeitɨamɨkɨ  
\q2 pehekwame meta pe'atamɨariekame, hutakɨa peheutixikakaunime.  
\q1 Hɨri pepɨtipɨna, tumuanari pekaneyeitɨamɨkɨ,  
\q2 hɨri 'amanutitɨtɨ mɨaxa pepayeitɨani.   
\q1
\v 16 Pekaniwarexɨrimɨkɨ, meta 'eka kanenu'enitsitɨamɨkɨ,  
\q2 'eka mɨtɨrɨkaɨye kaniwataxɨriexɨamɨkɨ.  
\q1 Peru 'ekɨ Yawé hetsie petiwiyatɨ pekaniyutemawiekamɨkɨ,  
\q2 'Ixaheri hetsie Mɨpatsie kɨmana pekani'ata'ɨrimɨkɨ.   
\b  
\q1
\v 17 »Tixaɨtɨ memɨkatehexeiya meta memɨteheuyehɨwa haa mekanikuwautɨweni,  
\q2 matsi mepɨka'itaxeiyawawe,  
\q2 harimɨyakɨ waneni pɨwawaki.  
\q1 Peru ne, Yawé, nepɨwata'eiya,  
\q2 ne, 'Ixaheri Kakaɨyarieya, nepɨkawaku'eirieni.   
\q1
\v 18 Haa nepanetɨaxɨani hɨrite muwawakitsie,  
\q2 meta mayeweweritsie haixa nepetinetɨaxɨani.  
\q1 Makumawetsie haa xuaweme nepayeitɨani,  
\q2 meta makuwakitsie haixa xuaweme nepayeitɨani.   
\q1
\v 19 Makumawetsie nekatinikayatsamɨkɨ,  
\q2 kariuxa, meki, tsikwai kɨyeyari meta huriwu.  
\q1 Kwie muwakitsie huku mɨxexeurawi nekanikayatsamɨkɨ,  
\q2 huku yunɨkame metatsiere kwetsi kɨyeyari,   
\q1
\v 20 teɨteri memɨnenierekɨ meta mɨpaɨ memɨtemaikakɨ,  
\q2 meta kwi memɨyɨ'ɨwiyakɨ meta mɨpaɨ memɨtehetimamatenikɨ,  
\q1 Yawé tɨrɨkariyaya mɨyamɨtiuyurikɨ,  
\q2 'Ixaheri Kakaɨyarieya mɨpatsie mɨtiutawewikɨ.»   
\b  
\q1
\v 21 Yawé mɨpaɨ kanaineni:  
\q1 «Yuhetsie xekeneutanua,  
\q2 xeketeneuhekɨata naime kexemɨteheima —Kakuwu ti'aitɨwameya mɨpaɨ kanaineni—.   
\q1
\v 22 Hurawa xekenakɨni meta xeketenekuxatani  
\q2 kemɨtiyɨni,  
\q2 meta kemɨtiɨyɨ meripaitɨ,  
\q1 mɨpaɨ temɨtemaikakɨ  
\q2 kehepaɨ mɨtiyeyɨximekai.  
\q2 Xeketateneutaxatɨa kemɨtiyɨni 'uxa'awarie.   
\q1
\v 23 Yaxekeneutiyua 'uxawarietɨni kemɨtiyɨni,  
\q2 'ana mɨpaɨ tepɨtehetimani kename xeme xekakaɨyarixi.  
\q1 Yɨkɨ xeketeneuyuri, 'aixɨa ti'aneme yatɨni 'axati'aneme,  
\q2 temɨnenierekɨ meta temɨtimamanikɨ.   
\q1
\v 24 Yurikɨ xeme nitixaɨtɨ xepɨkatehɨkɨ,  
\q2 metatsiere tixaɨtɨ yɨkɨ xemɨte'uyurieni xepɨkayɨwawe.  
\q2 Kanixani'eriwani xeikɨa kemɨ'ane mɨxe'anayexei.   
\b  
\q1
\v 25 »Tayeta xeime nekaniuta'inieni,  
\q2 hikɨ kaninuani ne'itahɨaweku,  
\q2 tau manatineikatsie kanenahɨaweni.  
\q1 'Iwewame hepaɨ yɨ'ɨkakɨ haxu katiniɨpɨnani,  
\q2 te'aitamete haxu hepaɨ katiniwarupɨnani.   
\q1
\v 26 ¿Kemɨ'ane yaputayɨ meripaitɨ,  
\q2 yatemɨtemaikakɨ?  
\q1 ¿Kemɨ'ane meri yaputayɨ,  
\q2 mɨpaɨ temɨtiyuanikɨ: “Yurikɨ painekai”?  
\q1 Nixewitɨ yapɨka'utayɨ,  
\q2 nixewitɨ pɨka'u'enierie niuki kuxatatɨ.   
\q1
\v 27 Ne mexɨakame nekanayani Tsiyuni mɨpaɨ nemɨtiutahɨawixɨ:  
\q2 “Neuxei, mekaniu'axɨaniri”.  
\q1 Ne Kerutsaremetsie nemeiyenɨ'a nekanihɨkɨtɨni  
\q2 tupiri niuki 'aixɨa 'anuyɨneme mukuxata.   
\q1
\v 28 Nekananuyeneniereni watsata, nixewitɨtɨma pumawe,  
\q2 mana watsata 'ɨxatsitawetɨ,  
\q2 nixewitɨ pɨkanetsiku'eiya nemɨwaku'iwawiyatsie.   
\q1
\v 29 Mɨkɨ yunaitɨ te'itawamete mepɨhɨkɨ.  
\q2 Kememɨteyurie tixaɨtɨ pɨkatihɨkɨ,  
\q2 wakakaɨyarixi 'eka xeikɨa mepɨhɨkɨ, teyu'uximatɨwamete.   
\c 42  
\s1 Yawé ti'uximayatsiriwame  
\q1
\v 1 »'Ikɨ neti'uximayatsiriwame kanihɨkɨtɨni, nemiparewie,  
\q2 nemenayexei, hetsiena mieme nemɨnetemawie,  
\q1 ne'iyari hetsiena nekaniupitɨani,  
\q2 kemɨtiheitserie nuiwarite watsata yakatiniyurimɨkɨ.   
\q1
\v 2 Pɨkatahiwa, pɨka'enierieni 'utahiwatɨ,  
\q2 kaye 'utɨma pɨkatahiwa.   
\q1
\v 3 Haka mutapɨnarie pɨka'anumura,  
\q2 kɨxeme witayari tsepa mɨkwauniya pɨka'ikutɨtsani.  
\q1 Kemɨtiheitserie yuheyemekɨ yapɨtiyurieni,   
\q2
\v 4 pɨkatirukuniuni meta pɨkatiwaɨripieni  
\q1 kepaukake kemɨtiheitserie mitatse'iriya.  
\q2 'Ateewa haramara tetsita kiekatari 'inɨari niukiyarieya mepɨtakwewie».   
\b  
\q1
\v 5 Kakaɨyari mɨpaɨ kanaineni, Yawé,  
\q2 kemɨ'ane muyuawi mutawewi meta mitaweraxɨ,  
\q1 kemɨ'ane kwie mukama,  
\q2 meta tita mana mɨtixuawe,  
\q1 mana kiekatari teɨteri wa'iiya muwapitɨa,  
\q2 tukari muwapitɨa mana memu'uwa:   
\q1
\v 6 «Ne, Yawé, heitseriemekɨ nepɨmatsi'anayexei,  
\q2 'amamatsie nepɨkawierixɨ.  
\q1 Ne nepɨmatsi'utawewi,  
\q2 ne tɨratu nepɨmatsi'ayeitɨa teɨteri wahetsiemieme,  
\q2 hekɨariya pemɨhɨkɨtɨnikɨ nuiwarite wahetsiemieme,   
\q1
\v 7 memɨkaheuneniere pemɨwaranutanieritɨanikɨ,  
\q2 pɨretsutsixi pemɨwarayehapanikɨ,  
\q2 meta kemɨ'ane yɨriya tsata memu'uwa pemɨwarayehapanikɨ.   
\b  
\q1
\v 8 »Ne Yawé nekanihɨkɨtɨni, mɨpaɨ nekatinitewaka.  
\q2 Hipame kenemɨtimariwe nepɨkawapitɨa,  
\q2 meta nenɨawari kakaɨyarixi nepɨkawapitɨa.   
\q1
\v 9 Meripaitɨtimieme pɨraye'atɨarieri,  
\q2 hikɨta hekwame nepɨtikuxata,  
\q2 mɨpaɨ katiyɨwekaku 'akuxi nepɨtikuxata».   
\s1 Kwikari nɨawari Yawé hetsiemieme  
\q1
\v 10 Yawé hetsiemieme xeime kwikari hekwame xekeneutakwika,  
\q2 xeme, haramaratsie xematineika,  
\q2 meta yunaitɨ mana xemɨye'uwa,  
\q1 xekeneutikwikani kwie manu'axe xemɨtitei,  
\q2 xeme, 'ateewa haramara tetsita xemɨtitei.   
\q1
\v 11 Xeme makumawetsie meta kiekarite mana mukumane xekeneutihiwani,  
\q2 meta kiekarite hakewa Tseraxi meyeika.  
\q1 Tsera kiekatari temawierikakɨ meke'utikwikani,  
\q2 meta meke'utihiwani hɨri 'amanutitɨtɨtsie paitɨ.   
\q1
\v 12 Yawé mariwemekɨ xekenekuxatani  
\q2 kwikarieya xekeneutikwikani 'ateewa paitɨ haramara tetsita.   
\q1
\v 13 Yawé kanayeyeimɨkɨ kuya yumemiwame hepaɨ,  
\q2 tewi yumemiwame hepaɨ 'ɨtetsatɨ.  
\q1 Hiwaritsata kaniyutamiemɨkɨ,  
\q2 memeye'unie kaniwara'iwamɨkɨ.   
\b  
\q1
\v 14 «Mɨixa tukari kayuwatɨ neputamarixɨ,  
\q2 nepɨka'utaniuka meta nepɨtinewie.  
\q1 Peru hikɨ nepɨtahiwa niweyame hepaɨ,  
\q2 nekanitatsuamɨkɨ ne'uta'aiwatɨ kukuiniyakɨ.   
\q1
\v 15 Hɨrite yemurite nekaniti'unamɨkɨ,  
\q2 naime mana mɨtixuawe nekatinitiwatsiɨxamɨkɨ,  
\q1 haa manuyehapane nekanikawatsiɨxamɨkɨ,  
\q2 meta haa muyemanetsie,   
\q1
\v 16 memɨkaheuneniere nekaniwaranuwitɨmɨkɨ huyeta memɨkahemaririetsie,  
\q2 huyeta nepɨwaranuwitɨni xewitɨ mɨkahemarietsie,  
\q1 wahetsiemieme yɨriya hekɨariya nepayeitɨani,  
\q2 nepakuweririta mɨkahakuweweritsie.  
\q1 Mɨpaɨ nekatiniyurimɨkɨ,  
\q2 meta nepɨkawaku'eirieni.   
\q1
\v 17 Peru kakaɨyarixi wahetsie memɨtewiya mepeuyexɨrieni meta tewiyarika mehexeiyatɨ mepakɨne,  
\q1 kemɨ'ane wewiyakate mɨpaɨ memɨtewakɨhɨawe:  
\q2 “Xeme takakaɨyarixi xekanihɨkɨtɨni”.   
\s1 'Ixaheri mɨkaheuniere meta mɨkaheu'ena  
\q1
\v 18 »Xemɨkaheu'enana, xekeneu'enana.  
\q2 Xemɨkaheuneniere, xekeneɨyɨ'ɨwiya.   
\q1
\v 19 ¿Kemɨ'ane matsi waɨkawa pɨkaheuniere keyuri neti'uximayatsiriwame,  
\q2 meta kemɨ'ane matsi waɨkawa pɨkaheu'ena keyuri neniuki tuayame?  
\q1 ¿Kemɨ'ane matsi waɨkawa pɨkaheuniere keyuri nenɨ'ari,  
\q2 meta kemɨ'ane matsi waɨkawa pɨkaheuniere keyuri Yawé ti'uximayatsiriwame?   
\q1
\v 20 'Ekɨ pepɨtiuxei waɨkawa,  
\q2 peru 'atsipepɨkaretimaiwe,  
\q1 pepɨwatixaxawa 'anakata,  
\q2 peru nitixaɨtɨ pepɨkati'enie».   
\q1
\v 21 Yawé puyukatemawi,  
\q2 kemɨtiheitserie tinaki'erietɨ,  
\q2 'aitsikaya mɨmariwenikɨ witsi'anetɨ.   
\q1
\v 22 Peru 'ikɨ teɨteri mepɨte'unawatsiyarie meta mepɨte'unawaiyarie yupiinite,  
\q2 yunaitɨ terɨta meputiwiyarie  
\q2 yatɨni mepanutaxɨriya xaɨtsie paitɨ.  
\q1 Mepɨte'unawatsiyarie,  
\q2 nixewitɨ wahetsie pɨkanua,  
\q1 mepɨte'unawaiyarie yupiinite,  
\q2 nixewitɨ wahetsiemieme pɨkahaniuka.   
\b  
\q1
\v 23 ¿Kemɨ'ane xeme 'ikɨ pɨti'enieni,  
\q2 'arikeketa kemɨ'ane 'ikɨ pɨtitaxata?   
\q1
\v 24 ¿Kemɨ'ane Kakuwu pɨyetua mɨtinawaiyarienikɨ yupiinite  
\q2 yatɨni kemɨ'ane 'Ixaheri pɨyetua mɨtinawatsiyarienikɨ?  
\q1 Yawé kanihɨkɨtɨni kemɨ'ane  
\q2 hetsiena mieme teɨterimama 'axamemɨte'uyuri.  
\q1 Huyeya mepɨka'anukuwei  
\q2 meta 'aitsikaya mepɨka'anu'eni.   
\q1
\v 25 'Ayumieme Yawé hetsiena  
\q2 yuhaxɨa pukawiwi, haxɨa kuyaxa mieme pipitɨa.  
\q1 Taikɨ penukana, peru 'atsipɨkaretima,  
\q2 pitaxɨtsitɨa, matsi mɨkɨ yakɨ yɨaneme puta'eri.   
\c 43  
\s1 Tiyuwikweitsitɨwame muyuxewi 'Ixaheri hetsiemieme  
\q1
\v 1 Peru hikɨ Yawé mɨpaɨ kanaineni,  
\q2 Kakuwu, mɨmatsi'unetɨa,  
\q2 'Ixaheri, mɨmatsi'uta'iwewaxɨ:  
\q1 «Pepɨkamaka, ne nekameniutawikweitsitɨani,  
\q2 ne nekamenahɨaweni kepemɨtitewakɨ, 'ekɨ nehetsɨa mieme pekanihɨkɨtɨni.   
\q1
\v 2 Kepauka hapa pemuyani,  
\q2 ne 'ahamatɨa nekaniumiemɨkɨ,  
\q1 kepauka hatuxametsie pemanuyani,  
\q2 haa 'aheima pɨka'uyeuriweni,  
\q1 kepauka taipa pemumieni,  
\q2 pepɨkakwaxe pepɨkatatani,   
\q1
\v 3 Ne Yawé nekanihɨkɨtɨni, 'akakaɨyari,  
\q2 Mɨpatsie 'Ixaheri hetsiemieme, matsiwikweitsitɨwame,  
\q1 ne 'Ekipitu nekaniyetuani nemɨtinetuanikɨ 'ahetsiemieme nemɨmatsitawikweitsitɨanikɨ,  
\q2 Kutsi meta Tsewa mame.   
\q1
\v 4 'Ekɨ 'ahetsiemiemekɨ teɨteri nekaniwayetuamɨkɨ,  
\q2 'atukari hetsiemieme hipame kiekari nekaniwayetuamɨkɨ.  
\q1 Ne nemɨmatsinaki'eriekɨ, witsinemɨmatixeiyakɨ meta  
\q2 'ekɨ waukawa pepɨraye'axe.   
\q1
\v 5 Pepɨkamaka, ne 'ahamatɨa nekaniuyeikani,  
\q2 tau manatineika hepa meme'uwa 'anuiwarima nekaniwa'atɨamɨkɨ,  
\q2 meta tau makayuyuipike hepa meme'uwa nepɨwa'atɨani nemɨxekuxeɨrienikɨ.   
\q1
\v 6 Tayeta mieme mɨpaɨ nekatinitahɨawimɨkɨ: “Keniwayetua”  
\q2 meta tatsutɨa mieme mɨpaɨ nekatinitahɨawimɨkɨ: “Pepɨkawarukununuitɨwani”.  
\q1 Xekeniwa'atɨa neniwema 'ateewa paitɨ memu'uwa  
\q2 meta neniwema 'ukari kwie manu'axe memu'uwa.   
\q1
\v 7 Yunaime xekeniwa'atɨa kemɨ'ane nehetsiemieme mematerɨwarɨwa,  
\q2 kemɨ'ane mɨnetsinɨawanikɨ nemitawewi,  
\q2 kemɨ'ane nemitawewi meta nemita'iwewaxɨ”».   
\b  
\q1
\v 8 Kiekari mɨkaheuniere xekenayeweiya, tsepa netɨ mɨrekahɨxi,  
\q2 kiekari mɨkaheu'ena, tsepa netɨ nakate mexeiya.   
\q1
\v 9 Meke'uyukuxeɨrieni yunaitɨ nuiwarite  
\q2 meta kiekarite mekeyukuxexeuriwani.  
\q1 ¿Kemɨ'ane mɨkɨ watsata xewitɨ 'ikɨ niuki putaxataxɨ  
\q2 meta kemɨ'ane pɨtatiutaxatɨa meripaitɨ kemɨtiɨyɨ?  
\q1 Memunenierixɨ mekewaruxeɨrieni  
\q2 mɨmatsiɨkɨrekɨ kename yuri me'utiyuane,  
\q1 hipatɨta memɨ'enananikɨ mɨpaɨ memɨtiyuanikɨ:  
\q2 «Puyuri».   
\q1
\v 10 Yawé mɨpaɨ kanaineni:  
\q1 «Xeme nehetsɨa miemete xekanihɨkɨtɨni xemunenierixɨ,  
\q2 nete'uximayatsiriwamete nemɨxe'anayexei,  
\q1 xemɨnetsimatenikɨ meta nehetsie yuri xemɨte'eriekakɨ,  
\q2 meta mɨpaɨ xemɨtemaikakɨ kename Ne nehɨkɨ.  
\q1 Meripaitɨ ne 'akuxi neka'uyeikakaku xewitɨ kakaɨyaritɨtɨ 'apɨka'uyeikakai,  
\q2 meta ne'utɨma xewitɨ pɨkatineni.   
\q1
\v 11 Ne, Yawé nekanihɨkɨtɨni,  
\q2 tawarita xewitɨ tiyuwikweitsitɨwame kaniumaweni.   
\q1
\v 12 Ne nekatiniutaxata, nekanixe'utawikweitsitɨani meta neniuki nekaniutaxata.  
\q2 Ne nekatiniuyurieni xetsata, hawaikɨ xewitɨ kakaɨyaritɨtɨ mɨpaɨ pɨkatiuyuri».  
\q1 Yawé mɨpaɨ kanaineni:  
\q1 «Xeme xemunenierixɨ xekanihɨkɨtɨni,  
\q2 neta Kakaɨyari nekanihɨkɨtɨni.   
\q1
\v 13 Meripaitɨtɨ, Ne nekanihɨkɨtɨni.  
\q2 Nixewitɨ nemamatsie muyuxɨna pɨkayɨwe.  
\q2 Kenemɨtiyurieni, nixewitɨ pɨka'itatara».   
\s1 Kakaɨyari kemɨtiyukanenimaya 'Ixaheri ke'axamɨtiuka'iyari  
\q1
\v 14 Yawé mɨpaɨ kanaineni,  
\q2 xewikweitsitɨwame, Mɨpatsie 'Ixaheri hetsiemieme:  
\q1 «Xehetsiemieme teɨteri Wawiruniya nepɨwaranɨnɨ'ani,  
\q2 yunaime nepɨwataxɨriexɨani yu'unamete nepuwarayeitɨani.  
\q1 Kanuwa 'amupapa hetsie kɨmana memɨyuti'ɨrekaitsie,  
\q2 karireutsixi nepɨwara'iwa.   
\q1
\v 15 Ne Yawé nekanihɨkɨtɨni, mɨpatsie,  
\q2 tixe'aitɨwame, 'Ixaheri nuiwariyari nemukama».   
\b  
\q1
\v 16 Yawé mɨpaɨ kanaineni,  
\q2 kemɨ'ane haramaratsie huye mutawewi,  
\q2 'anuyeyɨkɨme mayeitɨa haramara 'uyuanekaku,   
\q1
\v 17 kemɨ'ane kaxetate kuyaxamieme mɨwarayewitɨ meta kawayutsixi,  
\q2 kuyaxi meta kuyaxa wewiwamete,  
\q1 mɨkɨ 'amemukuhi tawarita memɨka'anuku'unikɨ,  
\q2 kɨxeme witayari hepaɨ kaniɨtɨni:   
\q1
\v 18 «Xeketenatɨmaiya meripaitɨ timieme,  
\q2 meripaitɨ hepaɨ xepɨkate'u'uwani.   
\q1
\v 19 Hekwame nekatininetɨamɨkɨ.  
\q2 'Ari yakatiniyɨaneni, ¿Kari xepɨkatemate?  
\q1 Makumawetsie huye nekaniwewieneni,  
\q2 meta nitixaɨtɨ mɨkaranuyeikatsie haixa nekaniwewieneni.   
\q1
\v 20 Yeuta memɨte'u'uwa mekanenayexeiyani,  
\q2 yawixi memayu'eririya meta 'aruxi 'amemɨnene,  
\q1 haa makumawetsie nepanenetɨwa,  
\q2 meta nitixaɨtɨ mɨkaranuyeika hatuxame nekananuyetu'ani,  
\q1 neteɨterima nemɨwaranayexei nemɨwatiharitɨanikɨ,   
\q2
\v 21 neteɨterima nehetsiemieme nemuwarutawewi,  
\q2 memɨnetsinɨawanikɨ naitsarie.   
\b  
\q1
\v 22 »Peru 'ekɨ Kakuwu, pepɨkanetsihahɨawe,  
\q2 'ekɨ 'Ixaheri, peputi'uxixɨ nehetsiemieme.   
\q1
\v 23 Muxa pepɨkanetsi'atɨiriewe 'amawari taiyariyari,  
\q2 nehetsiemieme yapepɨkatikamie 'amawarikɨ.  
\q1 Peru nepɨkamatsi'uximatɨa hatsi mawariyari pemɨwewienikɨ,  
\q2 meta 'ɨkwa witsimu'ɨa pemɨtaiyakɨ.   
\q1
\v 24 Pepɨkanetsinanairiewe 'uwá witsimu'ɨa,  
\q2 meta 'amawarite wiyayarikɨ pepɨkanetsihuxaitɨa.  
\q1 Matsi, 'ekɨpɨta 'axapepɨneranutahɨawe 'axakepemɨtiuyurikɨ  
\q2 meta pepɨnetsiwaɨripitɨa 'axapetiyurienetɨ.   
\b  
\q1
\v 25 »Ne matsi nekɨmana nemɨnenaki'eriekɨ  
\q2 'aitsikaya pemutitsanaxɨkɨ nekananuyeitɨani,  
\q2 meta tawariri 'axakepemɨtiuyurikɨ nepɨkaha'eriwa.   
\q1
\v 26 Kenenaye'eritɨa kuta. Tepuyutaxaneta,  
\q2 yakeneutayɨki xɨka yakɨ xeikɨa petiukwinitɨarieni.   
\q1
\v 27 'Axiɨyari mexɨakame 'axakatiniuyurieni,  
\q2 'aniukamete menetsi'aye'unietɨ mekanakɨne.   
\q1
\v 28 'Ayumieme tukita memɨte'uximayakai nitixaɨtɨ nepɨkatiwarayeitɨa,  
\q2 Kakuwu nepɨyetua mɨka'unarienikɨ naitɨ,  
\q2 'Ixaheri nepɨyetua mɨtixani'eriwakɨ.   
\c 44  
\s1 'Ixaheri manayexeiyarie  
\q1
\v 1 »Peru hikɨ, Kakuwu, neti'uximayatsiriwame,  
\q2 'Ixaheri, nemɨmatsi'anayexei, keneu'ena.   
\q1
\v 2 Yawé mɨpaɨ kanaineni, kemɨ'ane mɨmatsi'unetɨa,  
\q2 kemɨ'ane 'amaama hetsie mɨmatsikaye,  
\q2 mɨkɨ pɨmatsiparewimɨkɨ:  
\q1 “Kakuwu pepɨkamaka, neti'uximayatsiriwame,  
\q2 Ketsuruni, nemenayexei,   
\q1
\v 3 kwie meuharimɨkɨ hakɨ nekanakuhatuiyamɨkɨ,  
\q2 kwie mɨwaki, haixa 'akiyari nekaniuyetuaxɨamɨkɨ,  
\q1 ne'iyari 'anuiwarima nekaniwapitɨamɨkɨ,  
\q2 meta 'aixɨa nekaniwayurimɨkɨ kemɨ'ane memɨtiyɨrarɨme 'anuiwarima,   
\q1
\v 4 Mayeweritsie tupiriya kemɨranukɨyɨyɨra mɨpaɨ mepɨtetayɨra,  
\q2 hapuri 'aki'utɨma mɨnewe hepaɨ.   
\q1
\v 5 Xewitɨ mɨpaɨ pɨtayɨni: ‘Yawé hetsɨa nepɨmieme’,  
\q2 xewitɨta Kakuwu nuiwarieya payuyeitɨwani,  
\q1 xewitɨta yumamatsie mɨpaɨ pɨre'utɨaka: ‘Ne Yawé hetsɨa nepɨmieme’,  
\q2 meta 'Ixaheri pɨtiyuterɨwani”.   
\s1 Yawé meta kakaɨyarixi memɨwewiyatɨka  
\q1
\v 6 »Yawé mɨpaɨ kanaineni, Yawé Naimekɨmɨtɨrɨkaɨye,  
\q2 'Ixaheri ti'aitameya meta 'iwikweitsitɨwame:  
\q1 “Ne mexɨakame nekanihɨkɨtɨni meta 'imatɨreme netɨhɨkɨ,  
\q2 tawarita xewitɨ kakaɨyaritɨtɨ kaniumaweni.   
\q1
\v 7 ¿Kemɨ'ane nehapaɨ pɨ'ane?  
\q2 Yake'utayɨni.  
\q1 Yake'utayɨni kemɨratiyɨxime  
\q2 kepauka nekiekari meripaitɨtɨ nemukamatsie,  
\q1 yake'utayɨni kemɨtiyɨni 'arike,  
\q2 kehepaɨ mɨtiyɨni ketikuxatani.   
\q1
\v 8 Xepɨka'uyɨyɨakatɨkani nixepɨkamamaka.  
\q2 ¿Xekateha'eriwa nemitahekɨataxɨ meripaitɨ?  
\q1 Xeme xemunenierixɨ xekanihɨkɨtɨni.  
\q2 ¿Tawarita xewitɨ Kakaɨyari tiuyeika?  
\q1 Hawaikɨ, tawarita xewitɨ 'Ai pumawe,  
\q2 ne xeime tawarita nepɨkamate”».   
\b  
\q1
\v 9 Kakaɨyarixi memɨwatiwewiwa tixaɨtɨ mepɨkatehɨkɨ,  
\q2 wawewiya kwinimieme mɨraye'axe yakɨxeikɨa pɨtihɨkɨ.  
\q1 Yutewinɨarika puyuriene,  
\q2 kemɨ'ane memixeiya mepɨkatemate mepɨkaneniere.   
\q1
\v 10 ¿Kemɨ'ane kakaɨyaritɨme puwewie yatɨni tepɨakɨ pitakwaxiya  
\q2 nitixaɨtɨ katiyunaki'eriekame hetsiena mieme?   
\q1
\v 11 Kemɨ'ane memeyexeiya mɨkɨ mekaniyutewiyatsitɨakuni,  
\q2 tewewiwamete teɨteri xeikɨa mepɨhɨkɨ.  
\q1 Yunaitɨ mɨkɨ nehetsɨa mekeye'axɨani,  
\q2 memamatɨ meta meyutetewiyatɨ yunaitɨ mɨkɨ mekaniyuhayewakuni.   
\b  
\q1
\v 12 Tepɨakɨ ti'uximayatame tepɨa kaniutikwekweweni,  
\q2 kɨmana tɨɨpa katini'uximayaka,  
\q1 titsunamekɨ kakaɨyaritɨme kaniutawewiwani,  
\q2 kemɨreutɨrɨkaɨye katiniuta'uximayatani.  
\q1 Heuhaakamɨtɨ, 'uxetɨ,  
\q2 kaharetɨ, meta 'ari 'anutarɨwewetɨ.   
\q1
\v 13 Kɨyekɨ ti'uximayatame katiniuti'inɨnɨatani ti'inɨnɨatamekɨ,  
\q2 katiniuta'utɨwani kɨyetsie,  
\q1 tepɨa 'i'inemekɨ katiniuta'uximayatani,  
\q2 meta xikɨraɨyeme kaniutawewiwani.  
\q1 Tewi hepaɨ 'aneme kaniutawewiwani,  
\q2 tewi mu'uya kaniuta'ɨkeni,  
\q2 tukita mayewenikɨ.   
\q1
\v 14 Kariuxa mekanawitekeni,  
\q2 huku mɨxexeurawi meta tuaxa mekaniutayayatsani,  
\q1 mana mekanikuhayeikawani mɨtiwawerekɨ,  
\q2 yatɨni huku mekaniukayayatsani wiyeri mitiweriyakɨ.   
\q1
\v 15 Tewi tikwaxiyamekɨ kaneiyehɨaka,  
\q2 yapaɨmemekɨta kaniutikɨxeweni,  
\q2 'atinaime papa kaniuta'ɨariyani.  
\q1 Metatsiere kɨmana kakaɨyaritɨme kaniutawewiwani hɨxiena kaniukatunumakekani,  
\q2 kakaɨyaritɨme tawewieme hɨxiena kanakatutsitani.   
\q1
\v 16 Hixɨapa 'akame kɨyexi kanititaiyani,  
\q2 mɨkɨkɨ yu'ikwai kaniukawewiwani,  
\q2 mana wai kaniutawarɨkani, mɨkɨkɨ kaniutahuxarɨwani.  
\q1 Metatsiere kaniutikɨxeweni, mɨpaɨ 'utaitɨ:  
\q2 «'Ari nepɨtaxɨrirɨmeri,  
\q2 tai ne'anutaxeiyatɨ».   
\q1
\v 17 Peru yapaɨmetɨ mɨyuhayewaxɨkɨ, yukakaɨyaritɨme kaniutawewiwani,  
\q2 hɨxiena kaniukatunumakekani.  
\q1 Waɨkawa 'iwawirietɨ mɨpaɨ tikɨhɨawetɨ:  
\q2 «Keneneutawikweitsitɨa, 'ekɨtsɨ nekakaɨyari pekanihɨkɨtɨni».   
\b  
\q1
\v 18 'Atsimepɨkatemate, tixaɨtɨ 'atsimepɨkatehetimaitɨkɨka,  
\q2 wahɨxite peukutsiku, mepɨkaneniere,  
\q2 mepɨkatemaiwawe, mepɨkaheiti'enietɨkɨka.   
\q1
\v 19 Memɨtemaika meta memɨtemaiwaweni pɨwareuyehɨwa,  
\q2 mepɨkayu'iyaritɨa meta mɨpaɨ mɨtayɨni mepɨkayɨwawe:  
\q1 «Kɨye hixɨapa 'akamekɨ nepatinai,  
\q2 papa nekaniuta'ɨariya tɨɨtsie,  
\q2 wai ne'utawarɨkaka nepitakwai.  
\q1 ¿Kamɨtsɨ netiyɨwe tixaɨtɨ tixani'eriwame nemayeitɨani kɨyexi mana mɨtihekɨ?  
\q2 ¿Kɨye yatewime hɨxie netititunumakeni?»   
\q1
\v 20 Naxikɨ mepɨtekwa'a,  
\q2 xe'iyari kemɨtiyɨkɨhɨawe xepiweiya pɨtixe'itaiya,  
\q1 yɨkɨmana xemuyutawikweitsitɨani xepɨkayɨwawe, meta mɨpaɨ xemutiyuani:  
\q2 «'Ikɨ nemɨrexeiya katini'itarikatɨni».   
\b  
\q1
\v 21 «Kakuwu kena'eriwani 'ikɨ,  
\q2 'ekɨ neti'uximayatsiriwame pekanihɨkɨtɨni, 'Ixaheri.  
\q1 Ne nekameniunetɨani, 'ekɨ neti'uximayatsiriwame pekanihɨkɨtɨni,  
\q2 'Ixaheri, ne nepɨkametsihatɨmaiya.   
\q1
\v 22 'Aitsika pemutitsanaxɨakɨ neputayeitɨa haiwitɨri ximeri mieme hepaɨ,  
\q2 metatsiere ke'axapemɨtiuyuri nepekuyeitɨa haɨtsi hepaɨ.  
\q2 Nehetsɨa kenenua, nekameniutawikweitsitɨani».   
\b  
\q1
\v 23 Muyuawi taheima mieme temawierikakɨ xekeneutikwikani,  
\q2 Yawé 'ikɨ katiniuyurieni.  
\q1 Karima xekeneutihiwani,  
\q2 meukatewatsie kwieta.  
\q1 Hɨrite xekenekwikani,  
\q2 meta muhukuya, naitɨ yukɨyeximatɨ.  
\q1 Karikɨ Yawé Kakuwu kaniutawikweitsitɨani,  
\q2 Kakaɨyari kemɨtimariwe 'Ixaheri kaniuhekɨatsitɨiya.   
\s1 Kerutsareme tawari kiepa kemɨratɨa  
\q1
\v 24 «Yawé mɨpaɨ kanaineni, Metsiwikweitsitɨwame,  
\q2 kemɨ'ane 'amaamatsie mɨmetsikaye:  
\b  
\q1 »“Ne Yawé nekanihɨkɨtɨni,  
\q2 naime mɨtiutiwewi,  
\q1 ne nexaɨta muyuawi 'anekaniuyemani  
\q2 meta kwie 'anekanikumani.  
\q2 ¿Kemɨ'ane 'ana nehamatɨa puyeikakai?   
\b  
\q1
\v 25 »”Kakaɨyari niukametemama memɨte'itawa wa'inɨari yanepɨkaraye'atɨwa,  
\q2 meta memɨtehetimamateke nepuwatewiyatsitɨa,  
\q1 memɨtemaiwawe mekatemaiwaweme nepɨwarayeitɨwa  
\q2 meta kememɨtemaiwawekɨ tixaɨtɨ katiyunaki'eriekame nepayeitɨwa.   
\q1
\v 26 Nete'uximayatsiriwamete waniuki nepaye'atɨwa  
\q2 meta netupiritsixi waniuki nepaye'atɨwa.  
\q1 Ne mɨpaɨ nekanaineni Kerutsareme tawarita kiepa kanayeimɨkɨ,  
\q2 kiekarite Kura kwieyaritsie miemete kananukakitsiemɨkɨ,  
\q2 mu'u'uni 'aixɨa kaniti'itɨariemɨkɨ.   
\q1
\v 27 Ne mɨpaɨ nekanaineni haramara mɨmariwe ke'akawani,  
\q2 meta haa mana meukayuyune ke'ukawaxɨani.   
\q1
\v 28 Ne mɨpaɨ nekanaineni Tsiru nemuxatsi wahɨweme kanihɨkɨtɨni,  
\q2 kemɨnetinake mɨkɨ yapɨtikayani,  
\q1 yapɨtitanaki'erieni Kerutsareme manukakitɨarienikɨ,  
\q2 meta tuki tenariyari manukuwewiyanikɨ”».   
\b  
\c 45  
\q1
\v 1 Yawé mɨpaɨ Tsiru katinahɨaweni, menayexei,  
\q2 kemɨ'ane mamaya tserietanatsie mɨtiwierixɨ  
\q1 nuiwarite mɨtiwata'aitɨanikɨ,  
\q2 meta te'aitamete watepɨate mɨwanawairienikɨ,  
\q1 memanutakɨnetsie kiteniete mɨreuyepiexɨanikɨ,  
\q2 meta kiteniete reuyepietɨkaime mɨhayewaxɨanikɨ:   
\b  
\q1
\v 2 «'Ahɨxie nepumieni,  
\q2 hɨri meutiteitsie nepɨrakuweririta,  
\q1 wurunitse 'itupariyarite nepɨtitara,  
\q2 meta tepɨa meuku'uwetɨka nepanuxitexɨani.   
\q1
\v 3 Yɨwita timieme mɨraye'axe nepɨmatipitɨani,  
\q2 meta piinitɨarika 'awie mɨti'utsie,  
\q1 ne Yawé nemɨhɨkɨ mɨpaɨ pemɨtimaikakɨ,  
\q2 'Ixaheri Kakaɨyarieya, kepemɨtitewakɨ mɨmatsihaterɨwa.   
\q1
\v 4 Kakuwu neti'uximayatsiriwame hetsiemieme,  
\q2 'Ixaheri nemenayexei,  
\q1 nepɨmetsihahɨawe kepemɨtitewakɨ,  
\q2 meta 'aixɨa pemɨtixeiyariekakɨ mɨpaɨ nepumatiuterɨwaxɨ,  
\q2 tsepa 'ekɨ pemɨkanetsimate.   
\q1
\v 5 Ne Yawé nekanihɨkɨtɨni, tawarita xewitɨ pumawe,  
\q2 tawari xewitɨ Kakaɨyaritɨtɨ pumawe.  
\q1 Tsepa 'ekɨ pemɨkanetsimate,  
\q2 ne nepɨmatsitɨrɨkariyani,   
\q1
\v 6 mɨpaɨ xemɨtemaikakɨ tau manatineika hepatsie meta makayuyuipiketsie  
\q2 tawarita xewitɨ Kakaɨyari kaniumaweni.  
\q2 Ne Yawé nekanihɨkɨtɨni, tawarita xewitɨ kaniumaweni.   
\q1
\v 7 Ne hekɨariya nekaniunenetɨwani meta yɨriya,  
\q2 'aixɨa mɨti'ane nekatini'atɨwani meta 'uximatɨarika,  
\q2 ne, Yawé, naime 'ikɨ nekatiniunenetɨwani.   
\b  
\q1
\v 8 »Wiyeri keneukaxɨrɨwani muyuawi meutitewatsie,  
\q2 haiwitɨri, tita mɨtiheitseriekɨ keneukawiwiyeni.  
\q1 Kwie huhutakatɨ ke'anutayepierixɨani.  
\q2 Wikweitsitɨarika ke'utineni.  
\q1 Hamatɨana ke'utawere tita mɨtiheitserie.  
\q2 Ne, Yawé, nekaninetɨani».   
\b  
\q1
\v 9 Xɨa'ui kemɨ'ane mɨniukixie mitawewi hepaɨtsita.  
\q2 Xɨa'ui kemɨ'ane mɨtari  
\q2 mɨtitariwe kwiepa timieme tsata.  
\q1 ¿Kamɨtsɨ tiyɨwe haxu kemɨ'ane mipɨna mɨpaɨ mɨtiutahɨawe:  
\q2 «Kepemɨtiyuriene kene'a'ɨwiya.  
\q2 'Aye'ɨ pɨkahawiwietɨkari.»?   
\b  
\q1
\v 10 Xɨa'ui kemɨ'ane yupaapa mɨpaɨ mɨranutahɨawe:  
\q2 «Neuxei ketitayari penetiutinuiwitɨa».  
\q1 Xɨa'ui yumaama mɨpaɨ mɨranutate'a:  
\q2 «Neuxei ketitayari penetiutiniwexɨ».   
\b  
\q1
\v 11 Yawé mɨpaɨ kanaineni,  
\q2 Mɨpatsie 'Ixaheri hetsiemieme, mitawewi:  
\q1 «Xeme neniwema wahetsiemieme xemɨnetsi'uta'iwawiya 'uxa'atɨni kemɨtiwayurieni pɨkayɨwe,  
\q2 yatɨni yaxemɨnetetahɨawekɨ kenemɨtiyurienikɨ.   
\q1
\v 12 Ne kwie nekaniutawewieni,  
\q2 hetsiena teɨteri nekaniwarunetɨani.  
\q1 Nemamate katiniuyurieni muyuawi 'amuyemanaxɨ,  
\q2 meta mana xurawetsixi memuyeyaxekɨ nekaniwaruta'aitɨani.   
\q1
\v 13 Tsiru hetsiemieme kemɨtiheitseriekɨ nekatiniyurimɨkɨ,  
\q2 huyeya heitserie nekaniuyetemɨkɨ.  
\q1 Mɨkɨ nekiekari kananukuketɨamɨkɨ,  
\q2 meta kemɨ'ane memanutaxɨriya kaniwatixɨnamɨkɨ,  
\q1 peru tixaɨtɨ tuminikɨ meta 'axamɨtayɨnikɨ xɨka xewitɨ tumini 'i'ɨitɨaka.  
\q2 Ne mɨpaɨ nekanaineni, Yawé Naimekɨnemɨtɨrɨkaɨye».   
\p
\v 14 Yawé mɨpaɨ kanaineni:  
\q1 «'Ekipitu mɨtiwewiya meta piinitɨarika Kutsi timieme,  
\q2 naitɨ 'apiinite katinayeimɨkɨ,  
\q1 tsaweutsixi, teɨteri kwinimieme memɨtɨtɨ,  
\q2 'a'utɨa mepuhuni tepɨakɨ mehɨatɨkaitɨ.  
\q1 'Ahɨxie mepɨtitunuma'uni,  
\q2 waɨkawa memetsiwawirietɨ mɨpaɨ mepɨtiyuani:  
\q1 “Yuxewitɨ xeikɨa Kakaɨyari 'apuyeika tawarita xewitɨ pumawe,  
\q2 mɨkɨ Kakaɨyari 'ahamatɨa puyeika”».   
\b  
\q1
\v 15 'Ekɨ, Kakaɨyari meta 'Ixaheri wikweitsitɨwame,  
\q2 'ekɨ Kakaɨyari pemɨkahekɨa pepɨhɨkɨ.   
\q1
\v 16 Yunaitɨ kemɨ'ane kakaɨyarixi memɨwawewie  
\q2 mepɨtewiyatsitɨarieni meta nitixaɨtɨ mepɨkatehayeitɨarieni,  
\q2 nitixaɨtɨ mekatehɨkɨtɨtɨ mepɨyehu.   
\q1
\v 17 Peru 'Ixaheri Yawé pitawikweitsitɨani,  
\q2 yuheyeme wikweitsitɨarikakɨ,  
\q1 tawarita hatsuaku pɨkatewiyatsitɨarieni  
\q2 meta tawariri tixaɨtɨ pekatihɨkɨtɨtɨ pepɨka'ayeitɨarieni.   
\b  
\q1
\v 18 Karikɨ Yawé mɨpaɨ kanaineni,  
\q2 kemɨ'ane muyuawi 'amuyema,  
\q1 Kakaɨyari kwie mutawewi,  
\q2 minetɨa meta 'amiyeye,  
\q1 makumawenikɨ mɨka'itawewi,  
\q2 mitawewi mana mɨkiepatɨnikɨ:  
\q1 «Ne Yawé nekanihɨkɨtɨni,  
\q2 tawarita xewitɨ kaniumaweni.   
\q1
\v 19 Hawaikɨ 'ikɨ kwieyari mɨyɨwitsie  
\q2 'awiekamekɨ nepɨkaxetahɨawiwe.  
\q1 Meta Kakuwu nuiwarimama mɨpaɨ nepɨkatiwatahɨawiwe:  
\q2 “Xekeneneutiwawa peru xepɨkanetsitaxeiya”.  
\q1 Ne, Yawé, nepɨtikuxata tita mɨtiheitserie,  
\q2 meta yanepaine tita 'aixɨa mɨti'anekɨ.   
\b  
\q1
\v 20 »Xekeneuyukuxeɨri xemeyuta'unaxɨa nuiwarite watsata,  
\q2 xekeneuyukuxeɨri, xekenakɨni.  
\q1 'Atsimemɨkatemate mekanihɨkɨtɨni kemɨ'ane kɨye kakaɨyarixiyari memɨwarɨ'ɨ,  
\q2 meta kakaɨyarixi wahɨxie memuyunenewixime memɨkateyuwikweitsitɨwa.   
\q1
\v 21 Yaxekeneutiyua,  
\q2 xeketeneutahekɨata.  
\q1 ¿Kemɨ'ane 'ipaɨ putayɨ meripaitɨ,  
\q2 kemɨ'ane yaputayɨ meripaitɨ?  
\q1 ¿Kamɨtsɨ ne, Yawé, yanekatiutayɨ?  
\q2 Tawarita xewitɨ Kakaɨyari kaniumaweni,  
\q1 Kakaɨyari heitserie hexeiyatɨ meta tiyuwikweitsitɨwatɨ,  
\q2 tawarita xewitɨ kaniumaweni.   
\b  
\q1
\v 22 »Nehetsɨa tawarita xekeneu'axɨa, xemɨtawikweitsitɨarienikɨ,  
\q2 yunaitɨ kwie manu'axetsie paitɨ xemu'uwa,  
\q2 karikɨ ne nekanikakaɨyaritɨni, tawarita xewitɨ kaniumaweni.   
\q1
\v 23 Ne mɨpaɨ yurikɨ nekaniuyuhɨritɨani nehetsiemieme,  
\q2 heitseriekamekɨ yanekaniutayɨni  
\q2 niuki nemɨka'ipatakɨ:  
\q1 Nehɨxie yunaitɨ mepɨkatunuma'uni,  
\q2 nehetsiemieme yamepɨteyuhɨritɨani yunaitɨ teɨteri.   
\q1
\v 24 Mɨkɨ mɨpaɨ mepɨtiyuani nehetsiemieme: “Yawé hetsie xeikɨa kanixuaweni  
\q2 tita mɨtiheitserie meta tɨrɨkariya”».  
\q1 Yunaitɨ kemɨ'ane memiyehekaxɨ  
\q2 mɨkɨ hɨxie mekaniti'uikuni,  
\q2 mekanitewiyatsitɨariekuni.   
\q1
\v 25 Matsi yunaitɨ 'Ixaheri nuiwarimama  
\q2 Yawé katinehekɨatamɨkɨ heitserie kememɨtehexeiyakɨ meta 'aixɨa kememɨtexeiyarie.   
\c 46  
\s1 Wawiruniya kakaɨyariximama  
\q1
\v 1 Weri panakatutsi, Newu kwiepa kaniukaweni,  
\q2 wakakaɨyarixi tetɨkɨmete wahetsie meputɨkiexime.  
\q1 Wa'ɨkiyarite 'ahetetɨ naitsarie pukɨtɨkiene,  
\q2 'ika mɨtiyu'uxitɨwa pɨhɨkɨ xeikɨa.   
\q1
\v 2 Mana 'axeikɨa yunaitɨ mekaniyuyetuani meta mekananakatutsireni,  
\q2 'ika memukuwikweitsitɨani mepɨkayɨwawe,  
\q2 mɨkɨtɨtɨ memanutaxɨriwatatsie mekanekɨkani.   
\b  
\q1
\v 3 «Kakuwu tɨɨriyamama, xeneneu'eni,  
\q2 'Ixaheri niwemama yunaitɨ kexemɨyupaɨme,  
\q1 huriepapaitɨ xeyeteme nemɨxe'utitɨkixɨ,  
\q2 meta warɨitsie nemɨxe'utiwaweriyaxɨ.   
\q1
\v 4 Meta kepauka 'akuxi xemu'ukirawetsixitɨni meta xemumutuxatɨkanitsie,  
\q2 ne mɨkɨ yaxeikɨa nekanihɨkɨtɨkamɨkɨ, ne nekanixetuikakamɨkɨ.  
\q1 Ne nekaxeniutiwewieni, nepɨxe'ɨwiyani,  
\q2 nepɨxeparewieka meta nepɨxewikweitsitɨaka.   
\b  
\q1
\v 5 »¿Kemɨ'ane hamatɨa pepɨnetsi'inɨata,  
\q2 kemɨ'ane hepaɨ nepɨ'ane?  
\q1 ¿Kemɨ'ane hepaɨ nepɨtinexexeiya,  
\q2 kemɨ'ane hamatɨa yaxeikɨa tepɨ'anene?   
\q1
\v 6 Hipatɨ huru yukɨtsiurita mieme mepɨxɨtɨa  
\q2 meta pɨrata ti'inɨnɨatametsie mepɨku'inɨnɨata,  
\q1 xeimeta tiwewiwame meputa'iniwa kakaɨyaritɨme mɨwatawewirienikɨ,  
\q2 mɨkɨ kakaɨyaritɨme hɨxie panakatutsita 'itahɨaweke.   
\q1
\v 7 Yunaiparitsie me'etetɨ mekanititɨkɨni,  
\q2 manuwekaitsie mekanitaketsani, mana puyukuhayeikawa.  
\q2 Mukuyuaxɨani manuwetsie pɨkayɨwe.  
\q1 Tsepa waɨkawa memihiwie, pɨkawata'eiya,  
\q2 mɨkɨ pɨkayɨwe xe'uximatɨarikatsie mɨxe'utawikweitsitɨani.   
\b  
\q1
\v 8 »Xemɨkateheuyu'enie, 'ikɨ xekena'eriwani,  
\q2 xekeneutimaixɨa, yumu'utsie xekeneye'ɨnani.   
\q1
\v 9 Meripaitɨ timieme xeketenaye'eri,  
\q2 ne Kakaɨyari nepɨhɨkɨ, tawarita xewitɨ pumawe,  
\q2 ne Kakaɨyari nepɨhɨkɨ, tawarita xewitɨ nehepaɨ 'anetɨ pumawe.   
\q1
\v 10 Ne yanekaniutayɨni tsutɨa paitɨ kepauka tukari maye'ani,  
\q2 meripaitɨ nepɨtikuxata, kemɨtiyɨni.  
\q1 Ne mɨpaɨ nepaine: Ne kenemaineni yapɨtiyɨni,  
\q2 meta kemɨnetinake yanepɨtiyurieni.   
\q1
\v 11 Tau manatineika hepa paitɨ 'uyeikame  
\q2 wirɨkɨ wai mukwa'a neputa'iniwa,  
\q1 meta kwiepa 'aheteewametsie,  
\q2 tewi kemɨ'ane kenemɨtiyurieni mɨraye'atɨani nepɨta'inieni.  
\q1 Kenemutayɨ, yanepɨtiyurieni maye'anikɨ,  
\q2 kenemɨtiu'iyaritaxɨ, mɨpaɨ nepɨtiyurieni.   
\q1
\v 12 Xeme xekeneneu'eni, xe'iyari mɨtsetse'i,  
\q2 tita mɨtiheitserietsie 'ateewa xemu'uwa.   
\q1
\v 13 Tita mɨtiheitserie nehetsɨa mieme pɨkaheteewa,  
\q2 newikweitsitɨarika kwitɨwari paye'ani pɨkareutere.  
\q2 'Ari nekani'atɨamɨkɨ.  
\q1 Tsiyuni wikweitsitɨarika nekanipitɨamɨkɨ,  
\q2 meta 'Ixaheri kenemɨtimariwe nepɨxeitsitɨani.   
\c 47  
\s1 Wawiruniya kemɨtiuka'unixɨ  
\q1
\v 1 »Kenanakaye'a, tumuanaripa keneutayexi,  
\q2 Wawiruniya niweya 'uka 'ɨimari,  
\q1 kwiepa keneutayexi, 'uka karireutsixi waniwe,  
\q2 'uweni kaniumaweniri.  
\q1 Hatsuakuri witsipetiyɨritɨ witsipe'anetɨ  
\q2 pepɨkatitahɨawarieni.   
\q1
\v 2 Tete murinayari keneutitu'i, harina keneuyetɨxi,  
\q2 'ixuriki 'ahɨxie pemeukuwera keneɨkɨxɨna.  
\q1 'A'iwi keneukutuka, 'a'ɨkate keneutimaweriyaka,  
\q2 hatɨatetsie kenanuye'a.   
\q1
\v 3 Kepemɨtimawe kanihekɨarimɨkɨ,  
\q2 'atewiyarika pekanihekɨatamɨkɨ.  
\q1 Ne nekaninekɨhɨamɨkɨ,  
\q2 nixeime nepɨkareuyehɨwirieni».   
\b  
\q1
\v 4 Tatsiwikweitsitɨwame Mɨpatsie 'Ixaheri hetsiemieme kanihɨkɨtɨni,  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye katinitewaka.   
\b  
\q1
\v 5 «Kayuwatɨ ketineuyexi, 'uka karireutsixi waniwe,  
\q2 yɨwita keneutahaki.  
\q1 Tawariri hatsuaku “'uka nuiwarite tiwa'aitɨwame”  
\q2 pemɨkatiterɨwarienikɨ.   
\q1
\v 6 Ne neteɨterima wahetsiemieme nepɨha'akai,  
\q2 'ayumieme mekapatsiekame nepuwarayeitɨa nehetsiemiemete.  
\q1 Nepuwayetua 'amamatsie,  
\q2 'ekɨta pepɨkawarutinenimayataxɨ.  
\q1 'Ukirawetsixi waɨkawa raheteme  
\q2 pepɨtiwaruta'aitɨa.   
\q1
\v 7 Mɨpaɨ peputayɨ: “'Uka neheyemekɨ ti'aitame nepɨhɨkɨtɨni”.  
\q2 Peru mɨpaɨ pepɨkatimaikai,  
\q2 meta pepɨkaheitimaixɨa kepemɨreutiparekekai.   
\b  
\q1
\v 8 »Hikɨ 'ikɨ keneu'eni, pemɨtiukahiwe'erie,  
\q2 'ekɨ kayuwatɨ pemuyeika, mɨpaɨ pemuti'akɨhɨawe:  
\q1 “Ne nekanihɨkɨtɨni, tawarita xewitɨ kaniumaweni.  
\q2 Hatsuaku wiura nepɨkahayani meta neniwema nekawarexeiyatɨ nepɨka'ayani”.   
\q1
\v 9 Yapauka, xeitukaritsie,  
\q2 naitɨ mɨkɨ 'ahetsie katinaye'amɨkɨ:  
\q1 'aniwema pekaniwareuyehɨamɨkɨ meta wiura pekanayeimɨkɨ,  
\q2 mɨkɨ mekamenitimariutakuni,  
\q2 tsepa waɨkawa pemɨti'akewaiya  
\q2 meta kepemɨtiuyemate yɨkɨ pemɨtiyurienikɨ.   
\q1
\v 10 'Ekɨ 'axapemɨtiyurienetsie pepɨtiwiya,  
\q2 mɨpaɨ pekaniutaineni: “Nixewitɨ pɨkanetsixeiya”.  
\q1 Kepemɨtimaiwe meta kepemɨtimate pɨmati'itaiya  
\q2 kepauka 'axɨata mɨpaɨ pemutaine:  
\q2 “Ne nekanihɨkɨtɨni, tawarita xewitɨ kaniumaweni”.   
\q1
\v 11 Peru 'uximatɨarika kaninuamɨkɨ 'ahetsie  
\q2 pemuwaranayexɨrieni pepɨkayɨweni kepemɨtiuyematekɨ,  
\q1 kwiniya 'ahetsie kaninuamɨkɨ  
\q2 'ekɨ pepɨka'itawikweiya.  
\q1 'Ahetsie katininuamɨkɨ kepemɨkati'akɨhɨawetsie,  
\q2 yapauka 'ahetsie katininuamɨkɨ.   
\b  
\q1
\v 12 »Merikɨte, keneyeweiyani, peti'akewaiyatɨ  
\q2 'ikewari kepaɨmeme pemuyematekɨ,  
\q2 nunutsiyari paitɨ pemiti'ati'ɨkitɨa.  
\q1 Heiwatɨ petiunakitsitɨani,  
\q2 heiwatɨ pemakaxiwatɨ pe'ayani.   
\q1
\v 13 Waɨkawa 'ɨxatsikɨ pepu'uxe.  
\q2 Muyuawitsie miemekɨ memɨteyɨ'ɨkitɨa 'ahetsɨa miemete meke'uyukuxeɨrieni,  
\q1 xurawetsixi memɨwaxeiya,  
\q2 kemɨtiyɨni memɨtekuxata xeimetseri 'anukayeikakaku,  
\q2 mekematsi'utawikweitsitɨani tita 'ahetsie mɨraye'aximekɨ.   
\q1
\v 14 Keniwaruxeiya. Mɨaxa hepaɨ mekani'aneni,  
\q2 tai kaniwatixɨtsitɨamɨkɨ.  
\q1 Yɨkɨmana taipa memuyutawikweitsitɨani mepɨkayɨwawe.  
\q1 'Ena tɨɨ pumawe muyutaxɨriyakɨ,  
\q2 meta tai 'auriena mutiyerɨni.   
\q1
\v 15 Mɨpaɨ mekani'aneneni teyukewaiyamete 'ahetsiemieme  
\q2 wahetsɨa pemuta'axekai,  
\q2 wahamatɨa nunutsiyari paitɨ pemuyuharerutakai.  
\q1 Mɨkɨ yuxexuitɨ 'axamepɨteyurie,  
\q2 xewitɨ pumawe mɨwatawikweitsitɨanikɨ.   
\c 48  
\s1 'Ixaheri kemɨtitse'i  
\q1
\v 1 »'Ikɨ xeme xeketeneu'eni,  
\q2 Kakuwu tɨɨriyamama,  
\q1 Kura nuiwarimama,  
\q2 'ixaheritsixi xemɨte'uterɨwarɨwa,  
\q1 Yawé hetsiemieme xemɨyuhɨritɨa,  
\q2 meta 'Ixaheri Kakaɨyarieya memahɨawe,  
\q2 peru yu'iyarikɨ xemɨkayɨa meta kemɨtiheitseriekɨ.   
\q1
\v 2 Xeme mɨpaɨ xemɨteyuterɨwa “kiekari mɨpatsietsie kiekatari,”  
\q2 'Ixaheri Kakaɨyarieyatsie yuri xemɨte'erie,  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye mɨtitewa hetsie:   
\q1
\v 3 Mɨixa panuyemie  
\q2 nepɨtiutaxa meripaitɨ kemɨtiɨyɨ.  
\q1 Ne nepitahekɨataxɨ,  
\q2 netɨtɨ nepɨxe'utaxatɨa.  
\q1 Yapauka mɨpaɨ nepɨtiuyuri,  
\q2 hikɨ yapɨraye'atɨarie mɨkɨ.   
\q1
\v 4 Ne nemɨtimaikaikɨ 'ekɨ pemɨ'iyari tse'i,  
\q2 'akɨipi tepɨa mɨhɨkɨkɨ,  
\q2 meta 'anierika wurunitse mɨhɨkɨkɨ.   
\q1
\v 5 'Ayumieme ne meripaitɨ mɨkɨ nepɨmatiutaxatɨa,  
\q2 nepɨmatiuhekɨatɨa mɨpaɨ 'akuxi katiyɨwekaku,  
\q1 mɨpaɨ pemɨkahainenikɨ:  
\q2 “Mɨkɨ nekakaɨyari mamakɨ muwewiya katiniuyurieni.  
\q2 Mɨkɨ nekakaɨyarixi memɨxixiyatɨka meta memɨtaiyarietɨka mɨyamekateniuyurieni”.   
\q1
\v 6 Naime 'ikɨ hepaɨtsita pepɨtimate,  
\q2 ¿kamɨtsɨ pekatitaxata?  
\b  
\q1 »Hikɨ mɨtiyehane tihehekwame nepɨmatixeitsitɨani,  
\q2 tita mɨti'awietɨ meta tita pemɨkatimate.   
\q1
\v 7 Hikɨke mɨtiutawewiya katinihɨkɨtɨni, meripaitɨ kapɨtimieme,  
\q2 meripaitɨ mɨkɨ pepɨkati'eniwekai,  
\q1 mɨpaɨ pemɨkahainenikɨ:  
\q2 “'Ari ne mɨpaɨ nepɨtimaikai”.   
\q1
\v 8 Hatsuaku mɨpaɨ pepɨkati'enawekai, meta mɨpaɨ pepɨkatimaikai,  
\q2 meripaitɨ pepɨkaheu'enakai.  
\q1 Ne nekatinakumaika pemɨtiyukananaima,  
\q2 nunutsiyari paitɨtɨ “mɨrayuye'unie” pekatiniuterɨwarɨwani.   
\q1
\v 9 Kenemɨtitewa nemɨnaki'eriekɨ nehaxɨa nepɨnewie,  
\q2 nenɨawarikɨ nepuyupirenutɨa,  
\q2 nemɨkametsikumaweriyakɨ.   
\q1
\v 10 Neuxei. Nekameniu'itieni peru hawaikɨ pɨrata hepaɨ,  
\q2 nekameniuta'inɨata 'uximatɨarika huxunuyarita.   
\q1
\v 11 Nehetsiemieme nekameniuyurieni.  
\q2 Yanepɨkatinaki'erie nekapatsiekame xemɨnetsi'ayeitɨwanikɨ kenemɨtitewakɨ.  
\q2 Tawarita xeime nepɨkapitɨani witsikenemɨ'anekɨ.   
\s1 'Ixaheri kemɨtiɨxɨnarie  
\q1
\v 12 »Kakuwu keneneu'eni,  
\q2 'Ixaheri, nemɨmatsi'anayexei:  
\q1 Ne Kakaɨyari nepɨhɨkɨ,  
\q2 ne mexɨakame nepɨhɨkɨ, meta 'imatɨrieka mieme.   
\q1
\v 13 Ne'utakɨ kwie 'aixɨa nepuyuri,  
\q2 netseriekɨ muyuawi neputaweraxɨ.  
\q1 Ne nepuwarutaterɨwaxɨ,  
\q2 hikɨ mɨkɨ yunaitɨ mepuhekɨarixɨa.   
\b  
\q1
\v 14 »Xekeneuyukuxeɨri xeme yunaitɨ xekeneu'enana:  
\q2 ¿Kemɨ'ane mɨkɨ xewitɨ pɨtiutaxa 'ikɨ?  
\q1 Yawé minaki'erie  
\q2 yapɨtiyurieni Wawiruniya hetsie,  
\q2 tɨrɨkariyaya karireutsixi wahetsie pɨtinakeni.   
\q1
\v 15 Ne xeikɨa mɨpaɨ nekaniutayɨni,  
\q2 ne nekanita'inieni.  
\q1 Ne nekani'atɨamɨkɨ,  
\q2 katinayu'iwamɨkɨ kenemɨtita'aitɨani.   
\b  
\q1
\v 16 »Hurawa ne'aurie xekeniwakɨni, 'ikɨ xeketeneu'eni:  
\b  
\q1 »Tsutɨa paitɨtɨ, hawaikɨ 'awie nepɨkaretaxa,  
\q2 kepaukata mɨpaɨ mɨtiyɨni, ne mana nepuyeikani».  
\b  
\q1 Hikɨta Yawé naimekɨmɨyɨwe  
\q2 pɨnetsiheyenɨ'a 'Iyari yuhetsɨa miemekɨ.   
\b  
\q1
\v 17 Yawé mɨpaɨ kanaineni,  
\q2 Matsiwikweitsitɨwame, Mɨpatsie 'Ixaheri hetsiemieme:  
\q1 «Ne Yawé Kakaɨyari nepɨhɨkɨ,  
\q2 mɨmati'ɨkitɨa tita 'ahetsiemieme 'aixɨa mɨti'ane,  
\q2 mɨmatsi'uwitɨxime kemɨ'ane huye pemuweiyanitsie.   
\q1
\v 18 Xɨka ne'aitsika pe'u'enienike,  
\q2 kayuwatɨ pemexeiyakɨ hatɨa hepaɨ pɨ'anenike,  
\q2 heitseriekamekɨ kepemɨtiuyeika haramara hamewariyari muwakɨka hepaɨ pɨ'anenike.   
\q1
\v 19 Xiekari hepaɨ 'anuiwarima mepɨyupaɨmenike,  
\q2 'aniwema, xiekari 'uriyari hepaɨ,  
\q1 kememɨtetewa hatsuaku mepɨka'akuyeitɨarienikekai,  
\q2 metatsiere nehɨxie mepɨkahayeitɨarienikekai».   
\b  
\q1
\v 20 Wawiruniya kiekariyaritsie xekenayekɨni.  
\q2 Karireutsixi watsata xekenayekɨni xemuyuta'unakɨ.  
\q1 Mɨpaɨ xeketeneutaxata xe'utihiwatɨ temawierikakɨ,  
\q2 meta yunaitɨ meketehetimani.  
\q1 'Ikɨ niuki xekeneuta hekɨata kwie manu'axe paitɨ,  
\q2 mɨpaɨ xekeneutiyua: «Yawé Kakuwu kaniutawikweitsitɨani tiyu'uximayatsiriwame».   
\q1
\v 21 Kepauka makumawetsie muwaruwitɨtɨya,  
\q2 mepɨka'uharikwi,  
\q1 yapɨtiuyuri 'aitsie manenikɨ haa wahetsiemieme,  
\q2 tete kaneutara, haixa mana kananexɨani.   
\b  
\q1
\v 22 «'Axamɨtiuka'iyari kayuwatɨ pɨkahexeiya»,  
\q2 Yawé mɨpaɨ kanaineni.   
\c 49  
\s1 Yawé ti'uximayatsiriwame  
\q1
\v 1 Xekeneneu'eni, haramara tetsita 'ateewa xemeutitei,  
\q2 'ikɨ xeketeneu'eni, nuiwarite teewatari:  
\q1 Yawé pɨnetsi'anayexei nekatinuiwawekaku 'akuxi,  
\q2 nemaamatsie neyekaiku pɨnetsi'utaterɨwaxɨ.   
\q1
\v 2 Neteta 'ixipara 'atamɨariekame patike,  
\q2 pɨnetsi'uti'awietaxɨ yumamá 'etɨrieyatsie,  
\q1 'ɨrɨ hepaɨ witsine'aneme pɨnetsihayeitɨa,  
\q2 meta pɨnetsi'uti'awietaxɨ yɨ'ɨrɨ 'uitɨwameta.   
\q1
\v 3 Mɨpaɨ kanetiniutahɨawe: «'Ixaheri,  
\q2 'ekɨ neti'uximayatsiriwame pepɨhɨkɨ,  
\q2 'ahekɨ 'aixɨa nepɨtitahɨawarieni».   
\q1
\v 4 Neta mɨpaɨ neputayɨ: «Yakɨ xeikɨa nepɨti'uximaya,  
\q2 neputiwaɨripiri 'atsinekatiyuriwetɨ.  
\q1 Peru heitserie kenemɨrexeiya Yawé mamayatsie pɨti'ane,  
\q2 tita nemɨra'iwaxɨ nekakaɨyari hetsɨa pɨrekupine».   
\b  
\q1
\v 5 Hikɨta Yawé mɨpaɨ kanaineni,  
\q2 nemaamatsie mɨnetsikaye,  
\q2 ne ti'uximayatame hetsiena mieme nemayanikɨ,  
\q1 Kakuwu nemɨ'atɨanikɨ hetsɨana,  
\q2 'ixaheritsixi 'auriena memɨ'axɨanikɨ,  
\q1 Yawé hɨxie ne 'aixɨa nemɨtiuka'iyarikɨ,  
\q2 Kakaɨyarita nehetsie nunuwame pɨhɨkɨ:   
\q1
\v 6 «Neti'uximayatsiriwame pepɨhɨkɨ,  
\q2 meta Kakuwu nuiwarimama pemɨwahekwariya,  
\q1 meta 'ixaheritsixi pemɨwa'atɨani,  
\q2 kemɨ'ane nemɨwa'ɨwiya,  
\q1 hikɨ 'ayumieme nuiwarite wahekɨariwiyame nekamenayeitɨamɨkɨ,  
\q2 newikweitsitɨarika kwie manu'axe paitɨ pemɨtaxatakɨ».   
\b  
\q1
\v 7 Mɨpaɨ kanaineni Yawé,  
\q2 Tiyuwikweitsitɨwame meta Mɨpatsie 'Ixaheri hetsiemieme,  
\q1 mɨnanaimarie nuiwarite memixani'erie mɨpaɨ katinahɨaweni,  
\q2 ti'uximayatame kuwexinaruritsixi wahetsiemieme:  
\q1 «Te'aitamete mepɨmatsixeiya 'ana 'amepɨti'uni,  
\q2 memanuyetei memetsixeiyame 'ana mepakatutsitaxɨani,  
\q1 Yawé hekɨ, 'Ixaheri hetsie Mɨpatsie,  
\q2 yamɨtikamie meta mɨmetsi'anayexei».   
\s1 'Ixaheri kemɨrakunuitɨarieni  
\p
\v 8 Mɨpaɨ kanaineni Yawé:  
\q1 «Yemekɨ kepauka yanemɨra'eriwakai 'ana nepɨmetsi'uta'ei,  
\q2 kepauka newikweitsitɨarika maye'a 'ana nepɨmetsi'uparewi.  
\q1 Hikɨri nekameni'ɨwiyakamɨkɨ,  
\q2 meta ne tɨratu nepɨmetsi'ayeitɨa teɨteri wahetsiemieme,  
\q1 tawari 'akwieyari 'aixɨa pemukuyurienikɨ,  
\q2 meta kwie yuxaɨta mukumane 'aniwema pemɨwaxatɨanikɨ,   
\q1
\v 9 mɨpaɨ pemɨtiwatahɨawekɨ memanutaxɨriya:  
\q2 “Xekenewayekɨni”,  
\q1 meta yɨwita memu'uwa:  
\q2 “Xekanixɨxɨniniri”.  
\b  
\q1 »Huye 'aurie xepɨtetikwani  
\q2 meta naitsarie hɨri mu'aiyatsie yu'ikwai xepɨkaxeiya.   
\q1
\v 10 Xepɨkaheuhaakakwikuni meta xepɨkaheuharikuni,  
\q2 tau pɨkaxetiweranariya meta xepɨkaxɨrikwini,  
\q1 kemɨ'ane mɨxenenimaya mɨxekuwitɨnenikɨ,  
\q2 meta haixa muhapanetsie kanixekuwitɨnemɨkɨ.   
\q1
\v 11 Naime nehɨritetsie huye nekanitiwewimɨkɨ,  
\q2 meta nehuye 'a'atayeyeume nekanitiwewimɨkɨ.   
\q1
\v 12 Neuxei. Mɨkɨ mekani'axɨakuni 'ateewa paitɨ meheyekɨneme,  
\q2 hipatɨ tayeta mepakanexɨani, hipatɨta tau makayuyuipiketsie,  
\q2 hipatɨta 'Atsuhani kwieyaritsie mepanexɨani».   
\b  
\q1
\v 13 Xeme muyuawi, xekeneutihiwani temawierikakɨ.  
\q2 Kwie, keneyutemawieka.  
\q2 Hɨrite, kwikari xekenekwikani.  
\q1 Yawé yuteɨterima muwanɨtɨakɨ  
\q2 meta tixaɨtɨ memɨkateheuxeiya muwanenimayakɨ.   
\b  
\q1
\v 14 Peru Tsiyuni mɨpaɨ putayɨ: «Yawé pɨnetsi'uku'eiri.  
\q2 Ti'aitame pɨnetsihatɨmai».   
\q1
\v 15 «¿Kamɨtsɨ tiyɨwe niwekame yuniwe tsitsitɨwatɨ metɨmaiya,  
\q2 meta yuniwe naki'erietɨ miku'eirieni?  
\q1 Tsepa mɨkɨ mɨyɨwe metɨmaiya,  
\q2 peru ne nepɨkamatsihatɨmaiya.   
\q1
\v 16 Nemamá meuweweritsie nepɨmatsiha'utɨa,  
\q2 'akuraru yuheyemekɨ nepɨkahatɨtɨmaiya.   
\q1
\v 17 Memɨmatsi'anukakitɨani mepuyukumexɨitɨani,  
\q2 memɨmatsi'uka'unakai mepɨmatsiku'eirieni,  
\q2 meta heyekɨa memɨmatsi'ɨhɨa.   
\q1
\v 18 Keneutanierixɨa, kenanieretɨye'a,  
\q2 yunaitɨ mekaniyukuxeɨriximeni, 'ahepa 'umekanahuni.  
\q1 Ne yuri nekaniutaineni ne'ayenieretɨ, —kanaineni Yawé—,  
\q2 yunaime mɨkɨ witsipemɨtiyuxexeiyanikɨ pekaniwarayeitɨamɨkɨ,  
\q2 mɨkɨ wahekɨ wikiwame kamixayari pemanakatɨnitsie tetexi mɨraye'axe pemɨreukapine pepɨtihekɨata.   
\b  
\q1
\v 19 »Tsepa pemuka'unarienike, tsepa yeuta pemuhayewarienike,  
\q2 tsepa 'axaɨta pemu'ahayewake,  
\q1 hikɨri mepɨkatenakeni 'ateɨterima 'ahetsie,  
\q2 'ateewa mepuyuhayewari memɨmetsikwakai.   
\q1
\v 20 'Aniwema meheuyexɨrieme pemɨ'eriekai  
\q2 'anakata mɨpaɨ mepɨmeteheukahɨawe:  
\q1 “'Ena nehetsiemieme 'etsipakuyewa,  
\q2 tawari 'ayeume kwie nepeuyehɨwa mana nemukanikɨ”.   
\q1
\v 21 Hikɨ mɨpaɨ pepɨti'erieni:  
\q2 “¿Kemɨ'ane tɨɨri waɨkawa pɨnetsiyetuiri?  
\q1 Ne tɨɨri nepɨkawarexeiyakai, nepɨkaniwewekai,  
\q2 nepuka'unariekai, nepehɨiyakai,  
\q2 peru 'ikɨ, ¿kemɨ'ane puwarutiwaweriyaxɨ?  
\q1 Nexaɨtame nepunehayewakai,  
\q2 peru 'ikɨ, ¿kemetehanexɨa?”»   
\p
\v 22 Mɨpaɨ kanaineni Yawé naimekɨmɨyɨwe:  
\q1 «Ne nuiwarite mɨpaɨ nepɨtiwatahɨawe,  
\q2 yunaime teɨteri mɨpaɨ nepɨtiwata'aitɨani.  
\q1 Mɨkɨ 'aniwema yumamatsie mepɨwara'ɨka,  
\q2 meta 'aniwema 'ukari yuwaritsie mepɨwarutɨkɨni.   
\q1
\v 23 Te'aitamete yuniwema wahepaɨ mepɨwatiwaweriya,  
\q2 meta wa'ɨitama mepɨmatsitiwaweririeni.  
\q1 'Ahɨxie mepɨtihɨxima'uni kwiepa,  
\q2 kwie mepakutsena pemiketsina.  
\q1 'Ana mɨpaɨ pepɨretimani ne Yawé nemɨhɨkɨkɨ,  
\q2 mepɨkatewiyatsitɨarieni  
\q2 kemɨ'ane nehetsie yuri memɨte'erie».   
\b  
\q1
\v 24 ¿Yukukuyamete piinitɨarika memɨte'a'iwaxɨ mɨtiwarunawairieni tiyɨwe?  
\q2 ¿Tiyɨwe manutahɨiya manayexɨnekɨ?   
\p
\v 25 Peru mɨpaɨ paine Yawé:  
\q1 «Huu, kuya mɨtɨrɨkaɨye xeime tewi manutahɨa pɨnawaiyarieni,  
\q2 meta mɨkatiyukanenimaya piinitɨarika mɨra'iwaxɨ pɨtinawaiyarieni,  
\q1 kemɨ'ane memɨmatsimietɨwe nekaniwatakwimɨkɨ,  
\q2 netɨtɨ nekaniwatawikweitsitɨamɨkɨ 'aniwema.   
\q1
\v 26 Yanepɨtiyurieni memɨmatsi'aye'unie yuwaiyari memɨtikwanikɨ,  
\q2 meta yuxuriyakɨ memɨtitarɨwenikɨ  
\q2 winu mɨhɨkɨtɨni hepaɨ.  
\q1 Hikɨ 'ana yunaitɨ teɨteri mɨpaɨ mepɨtehetimani  
\q2 ne, Yawé, 'awikweitsitɨwame nemɨhɨkɨkɨ,  
\q2 ne, Mɨtɨrɨkaɨye Kakuwu hetsiemieme, Nemumatsixɨname nemɨhɨkɨkɨ».   
\c 50  
\s1 'Ixaheri ke'axamɨtiuyuri meta ti'uximayatsiriwame kemɨreu'ena  
\p
\v 1 Yawé mɨpaɨ kanaineni:  
\q1 «Ne xemaama, nepuku'eiri,  
\q2 ¿Peru hakewa 'eiriya xapayari?  
\q2 ¿Yatɨni kemɨ'ane nemɨrapiinirie hetsɨa nepɨxe'utua?  
\q1 Xeme xekaniutuiyani 'axaxemɨte'uyurikɨ,  
\q2 xeme xekaniutuiyani,  
\q1 'axaxemɨteyuriekaikɨ xeme  
\q2 xemaama kaniuku'eiriwa.   
\q1
\v 2 ¿Titayari nemunuatsie xeime tɨma nekatiutaxei?  
\q2 ¿Titayari xewitɨ kanetiuta'ei nemɨxe'utahɨawixɨtsie?  
\q1 ¿Kamɨtsɨ nekatiyɨwe nemɨxe'utawikweitsitɨanikɨ?  
\q2 ¿Kamɨtsɨ netɨrɨkariya katiyɨwe mɨxe'uxɨna?  
\q1 'Etsiwa ne neyutahaxɨatɨayu haramara kanakawaukeni,  
\q2 meta hatɨa makumawe nekanayeitɨwani,  
\q1 haa heuyewekakaku tsapari mekanitakukuweni hariyakɨ,  
\q2 meta mekanitipɨkeni.   
\q1
\v 3 Muyuawi yɨriyakɨ nekaniukemaritɨani  
\q2 meta naxi nekanikawiriwani muyuhiwerieka hepaɨ».   
\b  
\q1
\v 4 Yawé naimekɨmɨyɨwe pɨnetsi'upitɨa  
\q2 nemeutaniuwenikɨ netimaiwetɨ,  
\q2 kemɨ'ane mu'uxe neniukikɨ nemutuikanikɨ.  
\q1 Ximeri yakanetinanutahɨtuwani,  
\q2 meta nenakata neheu'ename kanenayeitɨaka  
\q2 para nemeu'enanikɨ teyɨ'ɨkitɨwamete wahepaɨ.   
\q1
\v 5 Yawé naimekɨmɨyɨwe neheu'ename kanenayeitɨani,  
\q2 hawaikɨ nepɨkahe'eiyani, meta ne'utɨa nepɨkayeyeika.   
\q1
\v 6 Newari nepɨyetua kemɨ'ane memɨnetsikuwayakai wahetsɨa,  
\q2 ne'auri nepɨyetua kepauka hipatɨ nemɨxiya memanuyehunakai,  
\q1 neyuriyariekaku meta kepauka nemuku'aɨtsikawiyarɨwakai  
\q2 nenierika nepɨka'uti'awietaxɨ.   
\q1
\v 7 Yawé naimekɨmɨyɨwe matsi mɨnetsiparewiekɨ,  
\q2 hatsuaku tixaɨtɨ mekanete'ayeitɨatɨri mepɨkahakɨne.  
\q1 'Ayumieme nenierika neputseiriyaxɨ tete mɨtse'i hepaɨ,  
\q2 mɨpaɨ nepɨtimate hawaikɨ nepɨkatewiyatsitɨarieni.   
\q1
\v 8 Ne'aurie hurawa kaniuyeikani kemɨ'ane nehetsie mɨtanuani.  
\q2 ¿Kemɨ'ane kamɨtsɨ pɨnetsitaniukimani?  
\q2 Kehamieni nehetsɨa.  
\q1 ¿Kemɨ'ane pɨnetsixaneta?  
\q2 Kenetsi'utaxaneta kuta.   
\q1
\v 9 Yawé naimekɨmɨyɨwe kanihɨkɨtɨni mɨnetsiparewie.  
\q2 ¿Kemɨ'ane pɨnetsi'anutahɨani?  
\q1 Yunaitɨ mɨkɨ mepukumawere,  
\q2 'ixuriki mutaxɨ tepaxietɨ hepaɨ.   
\b  
\q1
\v 10 ¿Kemɨ'ane xeme Yawé payemakaxe  
\q2 meta kemɨ'ane xeme tiyu'uximayatsiriwame peu'enie?  
\q1 Tsepanetɨ yɨwikɨta mumie,  
\q2 'etsiwa tɨma kahekɨariwiyarietɨ,  
\q1 Yawé hetsie yuri keti'erieka,  
\q2 meta Kakaɨyari hetsie ketiwiyani.   
\q1
\v 11 Peru xeme tai xemukutaiya  
\q2 meta 'utsi xemuti'ɨwe,  
\q1 kɨmana xeyukɨxirietɨ xemuhunikɨ,  
\q2 xemitaiyatɨka xehekɨariwiyakaku.  
\q1 'Ayumieme nepɨxe'anunɨ'airieni:  
\q2 'uximatɨarika waɨkawa, mana xepɨkwini.   
\c 51  
\s1 Wikweitsitɨarika yuheyemekɨ mieme Tsiyuni hetsiemieme  
\q1
\v 1 «Xeme, mɨtiheitserie xemɨtekuwautɨwe,  
\q2 meta Yawé xemukuwautɨwe, xekeneneu'eni.  
\q1 'Ai xekeneuxeiya kemɨ'ane hetsie xemɨyekɨ,  
\q2 tetexi mɨxixiyatɨka muwati'inieriwa hetsie pemaye'inierie.   
\q1
\v 2 'Apɨrahami xekeneuxeiya, yupaapa,  
\q2 meta Tsara, mɨxe'utiniwexɨ.  
\q1 Kepauka ne nemenayexei, puyuxaɨtatɨkai,  
\q2 peru ne 'aixɨa nepiyuri, mɨtamɨirekɨ.   
\q1
\v 3 Yurikɨ, Yawé Tsiyuni kaninɨtɨamɨkɨ,  
\q2 mɨti'u'uni naime katininɨtɨamɨkɨ.  
\q1 Makumawe 'Ereni kanayeitɨamɨkɨ,  
\q2 Yawé yuharaweri pɨtawewieni kwie makuwakitsie.  
\q1 Mana temawierika pɨtixuawere,  
\q2 pamɨpariyutsi meta kwikari nɨawari.   
\b  
\q1
\v 4 »Xekeneneu'eni, neteɨterima,  
\q2 xekeneneu'eni, nuiwari nehetsɨa mieme:  
\q1 nehetsie kaniyeyeimɨkɨ 'ɨkitɨarika,  
\q2 meta 'aixɨa mɨti'ane hekɨariya kanihɨkɨtɨkamɨkɨ nuiwarite wahetsiemieme.   
\q1
\v 5 'Ari kanehurani tita mɨtiheitserie,  
\q2 newikweitsitɨarika 'ari 'ukanamieni,  
\q2 netɨrɨkariya 'aixɨa puwayurieni nuiwarite.  
\q1 Hatetsita 'ateewa memukutetɨka nehetsie yuri mepɨte'erie,  
\q2 netɨrɨkariyatsie mepɨta'ikwewa.   
\q1
\v 6 Teikɨ muyuawitsie xekeneutinenieri,  
\q2 meta kwie xekeneuxeiya:  
\q1 muyuawi kɨtsi hepaɨ pukumawere,  
\q2 kwie 'ixuriki hepaɨ pɨtaxɨni,  
\q2 meta xaipɨtsi wahepaɨ mana kiekatari meputekwini.  
\q1 Peru newikweitsitɨarika yuheyemekɨ puxuaweni,  
\q2 peru mɨtiheitserie nehetsɨa mieme hatsuaku pɨkaheuyeweni.   
\b  
\q1
\v 7 »Xekeneneu'eni, xeme tita mɨtiheitserie xemɨtemate,  
\q2 teɨteri ne'inɨari niukiyari yu'iyaritsie xemɨye'ɨna:  
\q1 Teɨteri 'axametexekɨhɨawekaku xepɨkamamaka,  
\q2 meta xepɨka'utiweranareni mexe'anutate'akaku,   
\q1
\v 8 Kɨpi kaniwatikwaimɨkɨ 'ixuriki mɨtikwa'a hepaɨ,  
\q2 kwitsi kaniwatikwaimɨkɨ muxa huxarieya kemɨtikwa'a hepaɨ.  
\q1 Peru tita mɨtiheitserie nehetsɨa mieme yuheyemekɨ puxuaweni,  
\q2 newikweitsitɨarika, yuheyemekɨ pɨka'uye'atɨkani».   
\b  
\q1
\v 9 Kenanutanieri, Yawé tɨrɨkariyaya.  
\q2 Kenanutanieri, tɨrɨkariya kamixayari kenanakatɨki.  
\q1 Kenanutanieri meripaitɨ hepaɨ,  
\q2 meripaitɨ memu'uwakai wahepaɨ.  
\q1 ¿'Ekɨ pekatiuyuri Xahawi pemutaxite,  
\q2 meta hapa kiekame pemanuyetse?   
\q1
\v 10 ¿'Ekɨ pekatiuyuri haramara pemakawatsiɨxaxɨ,  
\q2 haramara 'amatiyewa?  
\q1 ¿Haramara tetɨata huye pemutawewi  
\q2 mana memɨkɨnekɨ pemɨwarutawikweitsitɨa?   
\q1
\v 11 Yawé kemɨ'ane wahetsiemieme mɨrayukatua mepɨ'axɨani,  
\q2 Tsiyuni mepeutahaxɨani me'utikwitɨ,  
\q2 temawierika yuheyeme mieme mepɨpitɨarieni.  
\q1 Temawierika waɨkawa mepexeiyani,  
\q2 kukuiniya mepɨkahexeiyani meta 'ukai.   
\b  
\q1
\v 12 «Ne nekanihɨkɨtɨni kemɨ'ane nemɨwanɨtɨa.  
\q2 ¿Kemɨ'aneta 'ekɨ pepɨhɨkɨ, teɨteri pemɨwarayemakaxe,  
\q2 memɨkwiwawe, tupiriya mehɨkɨtɨme?   
\q1
\v 13 ¿Yawé pepatɨmai, mɨmatsi'utawewi,  
\q2 muyuawi mutaweraxɨ meta kwie mukama?  
\q1 ¿Pematɨ tukarikɨ 'apetiuyeikani  
\q2 mɨmatsi'aye'unie haxɨayakɨ  
\q2 muyuwaɨriya mɨraka'unakɨ?  
\q1 Peru, ¿hakewa peyuhayewaxɨ mɨkɨ haxɨaya?   
\q1
\v 14 Kwitɨwa mepɨtixɨnarieni pɨretsutsixi,  
\q2 kiita me'aye'utɨ mepɨkakwini,  
\q2 meta paa meheuyehɨatɨ mepɨkahakɨne.   
\q1
\v 15 Ne Yawé nemɨhɨkɨkɨ 'akakaɨyari,  
\q2 ne haramara neputayuitɨwa, hamewarieya putixiuwarɨka,  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye nekatinitewaka.   
\q1
\v 16 Neniuki 'ateta nekameniupitɨani  
\q2 meta nemamá 'etɨrieyatsie pekaniyeweni,  
\q1 muyuawi 'anepuyema meta kwie nepukama,  
\q2 meta Tsiyuni mɨpaɨ nepɨrahɨawe: “'Ekɨ nekiekari pepɨhɨkɨ”».   
\s1 Kakaɨyari haxɨaya tekɨxiyari  
\q1
\v 17 Kenanutanieri, Kerutsareme, kenanutanieri.  
\q2 'Ekɨ kenanukukexi, Yawé mamayatsie  
\q2 haxɨa tekɨxiyari pemanu'i,  
\q1 'ekɨ, tekɨxieya naime pemanɨxɨ  
\q2 'iya tekɨxi teɨteri muwaratixɨrɨwa.   
\q1
\v 18 Yunaitɨ tɨɨri pemɨwarayexei,  
\q2 nixewitɨ mɨkɨ pɨkamatsi'anukuwitɨ,  
\q1 tɨɨri pemɨwarutiwaweriyaxɨ,  
\q2 nixewitɨ mɨkɨ pɨkamatsi'anukuha.   
\q1
\v 19 'Ikɨ tihutatɨ 'axamɨmetiyurie 'ahetsie katiniu'axɨani:  
\q2 pemakumaweriyarienikɨ meta pemɨka'unarienikɨ, haaka meta 'ixipara.  
\q1 ¿Kemɨ'ane pɨmatsitinenimayata?  
\q2 ¿Kemɨ'ane pumatsinɨtɨani?   
\q1
\v 20 'Aniwema mekaniukwinitɨma,  
\q2 tsipuri yeutari wahepaɨ winiyaritsie,  
\q2 kaye'utɨma 'itsikina mekaniukaxɨrieni.  
\q1 Yawé haxɨaya wahetsie katininakeni,  
\q2 meta Kakaɨyari kemɨtiwaraye'uxiwe'erie.   
\b  
\q1
\v 21 'Ayumieme 'ikɨ ketineu'eni, 'ekɨ pemɨyuhiwerie,  
\q2 pemɨtawe, winu peka'ietɨ.   
\q1
\v 22 Yawé 'ahetsɨa mumieme 'ipaɨ kanaineni meta 'akakaɨyari,  
\q2 'akakaɨyari, maniuka yuteɨterima wahetsiemieme:  
\q1 «'Amamatsie nekamaniunawairieni,  
\q2 tekɨxi mɨmatsi'anutawaitɨakai.  
\q1 Mɨkɨ tekɨxita nehaxɨa muyema,  
\q2 hawaikɨ tawarita pepɨka'enu'ieni.   
\q1
\v 23 Kemɨ'ane memɨmatsi'uximatɨa wamamatsie nepekeni,  
\q2 'iya mɨpaɨ memɨmate'utahɨawixɨ wahetsie:  
\q1 “Kwiepa keneuhu'i  
\q2 'ahetsie temuyekɨnekɨ”.  
\q1 Hikɨ kwiepa peheumu'utɨ pekatiniuhuni,  
\q2 yunaitɨ kwiepa memɨtama memɨmatsitaketsinikɨ».   
\b  
\c 52  
\q1
\v 1 Kenanutanieri, Tsiyuni, kenanutanieri.  
\q2 Tɨrɨkariya kenanakatɨki.  
\q1 Kerutsareme, kiekariyari pemɨpatsie,  
\q2 'akamixa witsimɨ'ane kenanakatɨki,  
\q1 kemɨ'ane xitekiya 'inɨariyari memɨkahexeiya meta kemɨ'ane memɨka'itiyatɨka,  
\q2 'ahetsie tawari mepɨkaheutahaxɨani.   
\q1
\v 2 Kerutsareme keneuyutakwiepi.  
\q2 Kenanukukexi, 'a'uwenitsie kenenua.  
\q1 'Akɨipitɨa tepɨa kaunariyari maka kenewaxɨna,  
\q2 tsiyuni niweya 'uka pemanutahɨiya.   
\p
\v 3 Yawé mɨpaɨ kanaineni:  
\q1 «Xeme nitixaɨtɨkɨ xepɨkate'utuiya,  
\q2 'ayumieme tuminikɨ xepɨkaxɨnarieni».   
\p
\v 4 Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni:  
\q1 «Meripaitɨ manuyetɨatsie,  
\q2 neteɨterima 'Ekipitu mepekɨ mana mepɨtitekai,  
\q1 'imatɨrieka 'ikɨ tukaritsie,  
\q2 'Atsiriya pɨtiwa'uximayatsitɨa yakɨ xeikɨa».   
\b  
\q1
\v 5 Yawé mɨpaɨ kanaineni:  
\q2 «¿'Ena ne kenetiyuriene?  
\q1 Neteɨterima yakɨ mepɨwarehapa,  
\q2 tewa'aitɨwamete mepɨwananaima.  
\q1 Meta tukarikɨ  
\q2 nehetsiemieme 'axameputiyuane.   
\q1
\v 6 'Ayumieme neteɨterima kenemɨtitewa mepɨnetsihetimani,  
\q2 'iya tukaritsie mɨpaɨ mepɨtehetimani  
\q2 ne nemɨhɨkɨkɨ mɨpaɨ nemutaine: “'Ena nepuwe”».   
\b  
\q1
\v 7 Witsipɨ'anene 'ɨkateya kemɨ'ane  
\q2 niuki 'aixɨa manuyɨne mukuxata hɨritsie,  
\q1 kemɨ'ane “kayuwatɨ mumakakɨ” mukuxata,  
\q2 kemɨ'ane niuki 'aixɨa manɨyɨne mukuxata,  
\q1 kemɨ'ane wikweitsitɨarika mukuxata,  
\q2 kemɨ'ane Tsiyuni mɨpaɨ mɨrahɨawe: «'Akakaɨyari pɨti'aita».   
\q1
\v 8 Keneu'ena. Matsihɨwemete meputihiwa,  
\q2 yunaitɨ temawierikakɨ meputihiwa,  
\q1 yɨhɨxikɨ memixeiyakɨ  
\q2 Yawé Tsiyuni kaniye'amɨkɨ.   
\q1
\v 9 Kerutsareme mu'uni,  
\q2 xekenekwikani temawierika kwikariyari.  
\q1 Yawé yuteɨterima muwarɨnɨtɨakɨ,  
\q2 Kerutsareme mutawikweitsitɨakɨ.   
\q1
\v 10 Yawé yutɨrɨkariya matsiɨkɨme kanayeitɨamɨkɨ  
\q2 yunaime nuiwarite wahɨxie,  
\q1 meta yunaitɨ kwie manu'axe kiekatari  
\q2 takakaɨyari wikweitsitɨarikaya mepɨxeiya.   
\b  
\q1
\v 11 Xeme, Yawé tipiiniteya xemɨte'u'ikata,  
\q2 xekenewayekɨni.  
\q1 Xeketeneuku'eiri, xekeneuyu'iti.  
\q2 Tixaɨtɨ mɨkati'itiya xepɨkatekumaɨwani.   
\q1
\v 12 Perutsɨ mexɨima xepɨkawayekɨkani, xepɨkawayenanautsani,  
\q2 Yawé pɨxe'uwitɨxime,  
\q2 'Ixaheri Kakaɨyarieya xehetsie pɨtanuani.   
\s1 Kemɨtiuka'eniwa meta kemɨra'iwa ti'uximayatame  
\q1
\v 13 Neuxei, neti'uximayatsiriwame pɨra'iwa,  
\q2 'aixɨa pɨtitamatiwa, mariweme payeitɨarieni 'aheutitewametsie payerieni.   
\q1
\v 14 Yumɨiretɨ mepɨhɨxiyani me'ixeiyatɨ,  
\q2 'axamɨraka'eriekaikɨ,  
\q2 tewi hepaɨ mɨkatiyuxexeiyakaikɨ.   
\q1
\v 15 Yaxeikɨata, yumɨiretɨ nuiwarite mepɨhɨxiyani,  
\q2 hɨxiena te'aitamete memɨtiniuni mepɨkayɨwekaxɨani,  
\q1 tita memɨkate'utaxatɨarie memɨtexeiyakɨ,  
\q2 meta mepɨtehetimani tita memɨkate'eniwawekai.   
\b  
\c 53  
\q1
\v 1 ¿Kemɨ'ane taniukitsie yuri pɨtiuta'eri,  
\q2 kemɨ'ane Yawé tɨrɨkariyaya puxeiyatsitɨarie?   
\q1
\v 2 Mɨkɨ hɨxie putawerixɨ yɨrari mɨyɨri hepaɨ,  
\q2 makuwakitsie tiwiyatɨ.  
\q1 Witsipɨka'anekai meta pɨkamariwekai,  
\q2 kemɨtiyuxexeiyakai pɨkaheiwa'anekai  
\q2 meta witsipɨkatiyuxexeiyakai pɨkaheiwe'eriwakai.   
\q1
\v 3 Teɨteri mepinanaimakai mepɨka'inaki'eriekai,  
\q2 pɨtiukakukuinekai, mɨtiuka'eniwanikɨ pɨ'ayumiemetɨkai.  
\q1 Nixewitɨ pɨka'ixeiyamɨkɨkai,  
\q2 putixani'eriwaxɨ, mariweme tepɨka'eriekai.   
\b  
\q1
\v 4 Peru yurikɨ takwiniya putitɨ,  
\q2 kukuiniya tahetsiemieme punewi,  
\q1 peru tame tiukwinitɨarieme teputa'eri,  
\q2 Kakaɨyari 'enayewaxɨame teputa'eri meta tixaɨtɨ kareyeitɨame.   
\q1
\v 5 Matsi mɨkɨ putsekie 'aitsika temutitsanaxɨakɨ,  
\q2 temɨxiki payeitɨarie 'axatemɨte'uyurikɨ,  
\q1 mɨkɨ hetsie pɨtiunakixɨ mɨtikwinitɨarienikɨ, kemɨraye'akai kayuwatɨ temu'uwanikɨ,  
\q2 pamɨpariyutsi mɨtiukwinitɨariekɨ kɨmana 'aixɨa teteheu'erietɨ tepayeitɨarie.   
\q1
\v 6 Teyunaitɨ tepeuyexɨriekai, muxatsi wahepaɨ,  
\q2 teyuxexuitɨ tepu'uwakai kemɨtatinake,  
\q1 peru Yawé hetsiena pɨtiɨhɨa  
\q2 naime 'axatemɨte'uyurikɨ.   
\q1
\v 7 Pɨtiukwinitɨarie, nitixaɨtɨ pɨkarayeitɨarie,  
\q2 peru 'etsiwatɨma pɨka'utaniu,  
\q1 muxa nunutsi hepaɨ, pehanie memierienikɨ,  
\q2 muxa 'uka mɨxikie hepaɨ, pɨka'utatsua,  
\q2 meta 'etsiwatɨma pɨka'utaniu.   
\q1
\v 8 Hikɨ me'iwiyakari meta me'itaxanetaka, mekanimieni,  
\q2 xewitɨ pɨkayuti'iyaritɨa nuiwarieya hepaɨtsita mukumawerekɨ.  
\q1 Kanawitekieni 'ena kwiepa teɨteri memanu'uwatsie,  
\q2 kaniukuweiyaxɨani teɨteri 'axamemɨte'uyurikɨ.   
\q1
\v 9 Pukateukie 'axateyuruwamete watsata,  
\q2 meta pumierie 'axateyuruwamete wahamatɨa,  
\q1 tsepa hatsuaku 'axamɨkatiuyuri,  
\q2 meta nanaimarika tetana mɨka'utixuawerixɨ.   
\b  
\q1
\v 10 Peru Yawé puyuwaɨri temɨxiki meyeitɨanikɨ meta mɨtika'enitsitɨanikɨ,  
\q2 matsi mɨkɨ yutukari 'itiya mawariyari mayeitɨakɨ,  
\q1 yunuiwari puwaxeiya, tukari waɨkawa pɨpitɨarieni,  
\q2 meta yapɨtiyurieneni Yawé kemɨtinake.   
\q1
\v 11 'Arikeke tikwineme,  
\q2 hekɨariya kanixeiyamɨkɨ meta 'iyarieya 'aixɨa kaniyɨmɨkɨ,  
\q1 mɨrakumatekɨ  
\q2 neti'uximayatsiriwame heitserie mexeiya heitserie kaniwapitɨamɨkɨ yuwaɨkawame,  
\q2 'axamemɨte'uyurikɨ pɨranukɨtɨni.   
\q1
\v 12 'Ayumieme, nepipitɨani mariwemekɨ mɨti'aitanikɨ,  
\q2 piinitɨarika mɨra'iwaxɨ memɨtɨrɨkawi wahamatɨa pɨtiyetuiriyarieni,  
\q1 yutukari mɨyetuakɨ tsepa mumierie,  
\q2 'axatiyuruwame payeitɨarie.  
\q1 Yumɨiretɨ ke'axamemɨte'uyuri putitɨ,  
\q2 'axateyuruwamete wahetsie putanua.   
\c 54  
\s1 Tsiyuni 'arike kemɨtimariweni  
\q1
\v 1 «'Ekɨ 'ukaratsi hatsuaku pemɨkatiniwewe,  
\q2 keneutahiwani temawierikakɨ.  
\q1 'Ekɨ, hatsuaku niweyame kukuiniyaya pemɨkamate,  
\q2 keneutakwikani meta keneutahiwani temawierikakɨ.  
\q1 'Ukaratsi muku'eiriwaxɨ matsi waɨkawa tɨɨri warexeiyatɨ kanayeimɨkɨ,  
\q2 mɨwikie kemɨkatiwarexeiya  
\qr —Yawé mɨpaɨ kanaineni—.   
\b  
\q1
\v 2 »'Axamaru 'akeneutayeuriya,  
\q2 'ixuriki meɨwɨ 'akiita keneɨxɨnaxɨa.  
\q1 Hawaikɨ peheuye'atɨkaitɨ pepɨkahayuyeitɨwani.  
\q2 'Akaunari 'akeneutitɨriya, 'akɨtsunute kwi keneuka'uitɨa.   
\q1
\v 3 Karikɨ 'atserieta meta 'a'utata pekanitawerimɨkɨ,  
\q2 'anuiwarite hipame nuiwarite waɨkawa mepuwara'iwa,  
\q2 kiekaritetsie hikɨ makumamawe mana mepɨyutikiitɨani.   
\b  
\q1
\v 4 »Pepɨkamaka,  
\q2 hatsuaku pepɨkatewiyatsitɨarieni.  
\q1 Pepɨkayu'iyaritɨaka,  
\q2 hatsuaku nitixaɨtɨ petihɨkɨtɨtɨ pepɨkahayeitɨarieni.  
\q1 Pemɨ'ɨimaritɨkaitsie mieme tewiyarika pepatɨmaiya,  
\q2 meta tawariri pemɨwiuratɨkaitsie 'axapemɨtikɨhɨawarɨwakai pepɨkahaye'erieni.   
\q1
\v 5 Kemɨ'ane mɨmatsi'utawewi mɨkɨ kani'akɨnatɨni,  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye katinitewaka.  
\q1 Matsiwikweitsitɨwame kanihɨkɨtɨni Mɨpatsie 'Ixaheri hetsiemieme,  
\q2 naime kwie Kakaɨyarieya katinitewaka.   
\q1
\v 6 Yawé kamanitahɨawimɨkɨ  
\q2 'ukaratsi 'eiriwakame hepaɨ,  
\q1 'ukaratsi tiuka'eniwatɨ muyu'iyaritɨa hepaɨ,  
\q2 'uka wikiekame 'etsiyumaitɨ mutiwiki hepaɨ  
\q2 mɨtixani'eriwakɨ xeikɨa  
\qr ―'akakaɨyari mɨpaɨ kanaineni―.   
\q1
\v 7 Nepɨmatsi'uku'eiri yatewimekɨ xeikɨa,  
\q2 peru waɨkawamekɨ nematsinenimayatɨ  
\q2 tawarita 'ahetsɨa nepunuani.   
\q1
\v 8 Yatewimekɨ xeikɨa, ne'uyeha'aka,  
\q2 nepɨkamatsixeiyamɨkɨkai,  
\q1 peru yuheyemekɨ nematsinaki'erietɨ  
\q2 nepɨmatsitinenimayata  
\qr ―Yawé mɨpaɨ kanaineni, Matsiwikweitsitɨwame―.   
\b  
\q1
\v 9 »Kepauka Nuhexi 'amuyeikakai hepaɨ nepaine,  
\q2 kepauka nemɨyuhɨritɨa kename haa  
\q2 hatsuaku kwie kakayunitɨanikekai.  
\q1 Hikɨ mɨpaɨ nekatiniyuhɨritɨaka tawariri nepɨkamatsiyeheka,  
\q2 meta tawariri nepɨkamatsitatieni.   
\q1
\v 10 Tsepa hɨrite muyupataxɨa,  
\q2 meta tsepa hɨrite 'etsimɨtɨtɨ mɨtiwatayuatɨka,  
\q1 hatsuaku nematsinaki'erietɨ nepukatihayewa,  
\q2 meta netɨratu kayuwatɨ 'amuyeikanikɨ mɨ'ayumieme nepɨkatananaimani,  
\q2 —Yawé mɨpaɨ kanaineni, mɨmatsinenimaya—.   
\b  
\q1
\v 11 »Neuxei 'ekɨ, kiekari pemuyuhiwerie,  
\q2 pemɨmariutsie meta pemɨkanɨtɨarie.  
\q1 Yuawitɨ tsiɨraɨyemekɨ nepumatsitakeni,  
\q2 meta tetexi yuawimekɨ mukutuxie hekɨ 'atenari nepɨkatsutɨani.   
\q1
\v 12 Tetexi mɨxetakɨ 'atetsariya nepatiwewiexɨani,  
\q2 tetexi mɨxawawatɨkɨ 'a'itupari nepɨtiwewieni,  
\q2 meta tetexi witsimɨ'anenekɨ 'akuraru nepawewietɨyani.   
\q1
\v 13 Yawé 'aniwema yunaime kaniwata'ɨxatsitɨamɨkɨ,  
\q2 yemekɨ 'aixɨa 'anemekɨ mepɨtiteni.   
\q1
\v 14 Mɨtiheitseriekɨ pepɨtseiriyarieni,  
\q2 waɨriyarika pepɨkati'aitɨarieka,  
\q2 meta nitixaɨtɨ pepɨkarayemakaka,  
\q1 pepɨkamaka,  
\q2 meta hatsuaku pepɨkatimani.   
\q1
\v 15 Xɨka xewitɨ matsimiemɨkɨni,  
\q2 ne nepɨkatiyurieneni,  
\q1 kemɨ'ane mumatsitamieni  
\q2 'ahɨxie kanikawemɨkɨ.   
\b  
\q1
\v 16 »Neuxei, ne tepɨakɨ tiwewiwame nekaniunetɨani,  
\q2 tɨɨ 'anutataiyatɨ mɨti'uximaya,  
\q2 tepɨa tiyumemiwame mɨtiwewiwa xexuitɨ kemɨtiyuruwametetɨni.  
\q1 Neta nekaninetɨani tiyuka'uname  
\q2 muwaruka'unanikɨ.   
\q1
\v 17 Tsepa tepɨa matsimemiwame 'ahetsiemieme mutawewiya yapɨkatiyurieni,  
\q2 kemɨ'ane mɨmatsixanetani mɨkɨ tenieyatsie pepuwiere.  
\q1 'Ikɨ kanihɨkɨtɨni te'uximayatamete memɨte'ukuhayewiyarie,  
\q2 tita mɨtiheitserie nehetsie mɨyetɨa  
\qr ―Yawé mɨpaɨ kanaineni―.   
\c 55  
\s1 Memeuhariku kememɨte'inierie  
\q1
\v 1 »Xekenakɨni haa mayema  
\q2 yunaitɨ kemɨ'ane xemeuhariku.  
\q1 Xekenakɨni xeketenananaiyu meta xeketenakwaiyu  
\q2 kemɨ'ane tumini xemɨka'umana.  
\q1 Xekenakɨni, winu xekeneunanai meta retsi  
\q2 xekateyutuatɨ.   
\q1
\v 2 ¿Titayari tumini xetexɨtɨa paa kahɨkɨtɨmetsie,  
\q2 meta yu'iwarika tita mɨkatihuxaiyatsie?  
\q1 'Aixɨa xekeneteneu'eni, xekatenitikwaikuni tita 'aixɨa mɨti'ane,  
\q2 meta 'aixɨa xekateniku'eriwakuni witsira'aneme xetekwatɨ.   
\q1
\v 3 Kayuwatɨ xekeneneu'eni, nehetsɨa xekeneu'axɨa,  
\q2 xekeneneu'eni, 'axekaniu'uwakuni.  
\q1 Xehamatɨa tɨratu nepɨwewieni yuheyemekɨ mieme,  
\q2 Rawiri nemɨnaki'eriekɨ.   
\q1
\v 4 Ne nepenukake teɨteri wahetsiemieme munierixɨ mɨhɨkɨtɨnikɨ,  
\q2 wa'ukiyari mɨmariwe hepaɨ.   
\q1
\v 5 Mɨpaɨ pepɨtiyurieni hipame nuiwarite pekaniwata'inimɨkɨ,  
\q2 pemɨkawamatekai,  
\q1 meta nuiwarite memɨkamatsimatekai  
\q2 'ahepa mepɨtinautsa,  
\q1 pamɨpariyutsitsɨ Yawé 'akakaɨyari,  
\q2 Mɨpatsie 'Ixaheri hetsiemieme,  
\q2 waɨkawa 'aixɨa petixeiyariekame mɨmatsi'ayeitɨa».   
\b  
\q1
\v 6 Yawé xekeneutiwawa mexi yuwaɨriya xemikaxeiyakɨ,  
\q2 xekeneutahɨawi mexi 'ahurawa 'uyeika.   
\q1
\v 7 'Axatiyuruwame yuhuye ke'uku'eirieni,  
\q2 meta 'axamɨtiyuriene 'axatiku'eriwatɨ ketiuhayewa.  
\q1 Yawé hetsɨa kenuani, takakaɨyari hetsɨa,  
\q2 mɨkɨ puyuwaɨriya mɨreuyehɨwirienikɨ,  
\q2 nenimayatsikaya hetsiena pɨtinake.   
\q1
\v 8 «Karikɨ xeme kexemɨteku'eriwa ne mɨpaɨ nepɨkatiku'eriwa,  
\q1 kexemɨte'u'uwa ne mɨpaɨ nepɨkatiuyeika  
\qr ―Yawé mɨpaɨ kanaineni―.   
\q1
\v 9 Nehuye meta kenemɨtiku'eriwa  
\q2 matsi 'apeutitetewa keyuri xehuye meta kexemɨteku'eriwa,  
\q2 matsi waɨkawa peutitewa keyuri muyuawitsie kemeutitewa.   
\q1
\v 10 Wiyeri meta 'ɨwi muyuawitsie  
\q2 kemɨrakaneika,  
\q1 kwitɨwa pɨka'anutinunuwa kwiepa kakahatuawetɨ,  
\q2 mɨtiyɨratɨakakɨ,  
\q1 kemɨ'ane muka'etsa 'imɨari mexeiyanikɨ  
\q2 meta paa mexeiyanikɨ kemɨ'ane mɨtikwa'a,   
\q1
\v 11 mɨpaɨta pɨ'ane neniuki neteta mayeneika:  
\q2 Nehetsɨa pɨkanuani 'atsikatiyuriwetɨ,  
\q1 matsi yapɨtiyurieni meri kemɨnetinake,  
\q2 pɨraye'atɨani kenemɨtiku'eriwa.   
\q1
\v 12 Xeme xepayekɨne xeyutemamawietɨ  
\q2 meta xepanuwitɨkieni yuhuyeta kayuwatɨ.  
\q1 Xe'uhukaku, hɨri 'etsimɨtɨtɨ meta 'amɨtɨtɨ  
\q2 mepɨtihiwa karima meyutemamawietɨ,  
\q2 meta mepɨtetapini yunaitɨ kɨyexi yeuta miemete.   
\q1
\v 13 'Ɨtsi muxuyatɨka hetsiemieme huku mɨxexeurawi pɨtiwawere,  
\q2 kieká hetsiemieme tsikwai kanitixuawerimɨkɨ.  
\q1 'Ana Yawé 'aixɨa pɨtitahɨawarieni,  
\q2 mɨkɨ 'inɨarieya payani yuheyemekɨ».   
\c 56  
\s1 Wikweitsitɨarika hipame wahetsiemieme  
\p
\v 1 Yawé mɨpaɨ kanaineni:  
\q1 «Tita mɨtiheitserie xeketenexeiyani,  
\q2 heitseriemekɨ yaxeketeneu'uwaniri,  
\q1 newikweitsitɨarika 'ari kaninuaximeni,  
\q2 mɨtiheitserie nehetsɨa mieme matsiɨkɨtɨ kanayeimɨkɨ.   
\q1
\v 2 'Aixɨa ke'itɨarieka kemɨ'ane mɨpaɨ mɨtiuyeika,  
\q2 kemɨ'ane yu'iyarikɨ meye'atɨa,  
\q1 kemɨ'ane 'uxipiya tukari ma'eriwa kapatsiekame ka'ayeitɨatɨ,  
\q2 kemɨ'ane mɨyɨ'ɨwiya 'axamɨkatiyurienenikɨ».   
\b  
\q1
\v 3 'Ateewa kiekame yɨkɨmana  
\q2 Yawé hetsie mɨtiwiyanikɨ muyuyetua mɨpaɨ pɨka'utaineni:  
\q2 «Yawé yuteɨterima watsata pɨnetsi'anuyeweiya».  
\q1 Meta ti'aitame ti'uximayatsiriwame mɨkaneɨke mɨpaɨ pɨka'utaineni:  
\q2 «Kɨye muwaki xeikɨa nepɨhɨkɨ».   
\p
\v 4 Karikɨ Yawé mɨpaɨ kanaineni:  
\q1 «Teɨteri te'aitame te'uximayatsiriwamete memɨkaneneɨke  
\q2 xawati 'uxipiya tukariyari mema'eriwa,  
\q1 yameketeyurieka kemɨnetinake,  
\q2 netɨratutsie meketewiyani,   
\q1
\v 5 ne yanepɨtiyurieni kememɨtetetewa mema'utsienikɨ  
\q2 netukita meta nekiekaritsie,  
\q2 mɨpaɨ matsi 'aixɨa pɨ'ane tɨɨri 'ukitsi 'ukari keyuri mewarexeiyatɨ.  
\q1 Meta nepɨwatiterɨwa yuheyemekɨ miemekɨ  
\q2 mɨkɨ hatsuaku pɨkahakayeitɨarieni.   
\q1
\v 6 'Ateewa kiekatari Yawé hetsɨa memu'axɨa  
\q2 memɨte'i'uximayatsiriekakɨ,  
\q1 Yawé memɨnaki'eriekakɨ,  
\q2 meta memeyexeiyanikɨ,  
\q1 yunaitɨ mɨkɨ 'uxipiya tukari mema'eriwa kapatsiekame meka'ayeitɨatɨ,  
\q2 meta netɨratutsie yamemɨtekahu,   
\q1
\v 7 nehɨri mɨpatsietsie nekaniwaranutiwitɨmɨkɨ,  
\q2 nenenewieri kiiyarita temawierika waɨkawa nepɨwapitɨani.  
\q1 Nepitanaki'erieni mawari taiyariyari meta hipame mawarite  
\q2 memitimawani nemawari taiyametsie,  
\q1 nekiitsɨ mɨpaɨ katinitewakamɨkɨ  
\q2 nenewieri kiyari yunaitɨ teɨteri wahetsiemieme».   
\b  
\q1
\v 8 Yawé mɨpaɨ kanaineni naimekɨmɨyɨwe,  
\q2 kemɨ'ane muwakuxexeɨriwa 'ixaheritsixi memeutaweiyariexɨa:  
\q1 «Neteɨterima nepɨwakuxeɨrieni hipame teɨteri meyunɨkame,  
\q2 meta 'akuxi hipame nemuwarukuxeɨri».   
\s1 Kakaɨyari kemɨtiwaxaneta 'axateyuruwamete  
\q1
\v 9 Yeutari meta teyukwa'amete 'ɨtsita miemete,  
\q2 xeyunaitɨ xekenakɨni xeketeniwarutikwa'i.   
\q1
\v 10 Yunaitɨ 'ixaheritsie memɨtetahɨ mepɨkaheuneniere,  
\q2 nixewitɨ mɨkɨ pɨkatimate.  
\q1 Yunaitɨ mɨkɨ tsɨikɨri memɨkaniuwawe mepɨhɨkɨ,  
\q2 memɨka'utihe'ewa.  
\q1 Mepuhe xeikɨa meteheinɨtɨ,  
\q2 mukutsuni puwanake.   
\q1
\v 11 Tsɨikɨri kwinie memɨteyukwaiwawie mepɨhɨkɨ,  
\q2 hatsuaku mepɨkahuxaiwawe.  
\q1 Muxatsi wahɨwemete mekanihɨkɨtɨni 'atsimekateheitimaitɨkɨkatɨ,  
\q2 yuxexuitɨ kemɨtiwanake xeikɨa mekaniu'uwani.  
\q1 Nitixaɨtɨ mekateha'eriwatɨ,  
\q2 yu'iwarikakɨ xeikɨa mepuyumexɨitɨa.   
\q1
\v 12 «Xekenakɨni, winu tepanukuwauni,  
\q2 winukɨ tepɨtitarɨweni  
\q2 —yunaitɨ mɨpaɨ mepɨte'uhiwa—.  
\q1 'Uxa'ata yaxeikɨa hikɨ hepaɨ tepɨtiyɨni,  
\q2 peru matsi waɨkawa».   
\b  
\c 57  
\q1
\v 1 Heitseriemekɨ 'amuyeika kanimɨmɨkɨ, xewitɨ hetsiena mieme pɨkayu'iyaritɨa,  
\q2 te'a'uximayatsiriwamete yamemɨtekahu mekanitakukuweni xewitɨ 'atsipɨkaretimamateke,  
\q2 heitseriemekɨ memu'uwa mekanitakukuweni 'axamɨti'anekɨ memɨkatekwinenikɨ.   
\q1
\v 2 Kemɨ'ane huye mɨheitserie 'utɨa memuhu kayuwatɨ mehexeiyatɨ mepɨtakukuwe,  
\q2 'aixɨa 'iyari mepuka'uxipiwe mɨki 'itarieyatsie.   
\b  
\q1
\v 3 «Xeme, 'ukaratsi mutiyukewaiya niwemama,  
\q2 'uki 'ukaratsi tuminikɨ muyumayɨinɨa mukumaɨwa niwemama,  
\q2 'ahurawa xekenakɨni.   
\q1
\v 4 ¿Kemɨ'ane xeme xepɨtehayuriya?  
\q2 ¿Kemɨ'ane hepaɨtsita xepu'uxiwa'a  
\q2 xe'ikuneniwiyatɨ?  
\q1 ¿Xeme xekatehɨkɨ 'axaxemɨte'u'iyari,  
\q2 te'itawamete nuiwariyari xekatehɨkɨ?   
\q1
\v 5 Tuaxatsata, meta kɨyexi mɨ'e'etɨtɨa,  
\q2 ketita xemɨtehiwe'eriekɨ xepɨkayupirenutɨa,  
\q1 'aki'utɨa meta 'ai mukatataritsie,  
\q2 tɨɨri mepɨwamawatɨwe.   
\q1
\v 6 Tetexi ha'ute 'aki'utɨa mieme  
\q2 pemɨtiukuhayewiyarie pɨrayani,  
\q2 yurikɨ, mɨkɨ 'ahetsiemieme pɨrayani.  
\q1 Mɨkɨ wahetsie hatseiti peputiyeuri,  
\q2 hatsi mawariyari pepɨyetua.  
\q2 Mɨkɨ naime mɨyapemɨtiuyurikɨ, ¿'atsinekatitayɨni?   
\q1
\v 7 Hɨri 'a'utewimetsie manutimɨtsɨtsie,  
\q2 mana paitɨ pepuyuka'utatɨa,  
\q1 mana paitɨ pekananutiyani  
\q2 pemɨtitimawakɨ.   
\q1
\v 8 'A'itupari warita meta muka'utɨkatsie  
\q2 pekatina'utɨani memɨkakaɨyarixi wa'ɨkiyakɨ.  
\q1 Pekaneniuku'eirieni, pekaniyutikemaripieni,  
\q2 'a'utá pemikawitsie pekananutiyani,  
\q1 tɨratu pekaniuwewieni teɨteri wahamatɨa  
\q2 kemɨ'ane pemeuhiwe'eriekai hamatɨana pemɨkahunikɨ,  
\q2 meta pepixei maweme.   
\q1
\v 9 Muruki hetsɨa pepanɨtɨa, huriwa hatseitiyari pepeihaniri,  
\q2 witsimu'ɨatɨka 'ahetsiemieme peputimɨiriyaxɨ.  
\q1 'Ateewa pepɨwarenɨ'a 'anɨ'arima,  
\q2 meta mɨki teukiyata pepuwareukanɨ'a.   
\q1
\v 10 Waɨkawa pekuyeikatɨ peputi'uxixɨ,  
\q2 peru mɨpaɨ pepɨka'utayɨ: “'Ena xeikɨa nepɨye'ani”.  
\q1 Pepuyɨwekaxɨa tɨrɨkariya waɨkawa pepukaxei,  
\q2 'ayumieme pepɨka'u'amɨ.   
\b  
\q1
\v 11 »¿Kemɨ'ane pɨmatsi'utimariu,  
\q2 kemɨ'ane marika pɨmatsi'upitɨa, titayari penetiu'itai?  
\q1 Pepɨkanetsihaye'eri,  
\q2 nitixaɨtɨ pepɨkanerayeitɨa.  
\q1 ¿Xɨari pepɨkanetsimakaxe,  
\q2 mɨixa 'atsinemɨka'utayɨkɨ?   
\q1
\v 12 Ne nepɨmatsitaxaneta 'aixɨa kepemɨtiyuriene peti'uximayatɨ,  
\q2 nitixaɨtɨ pɨkarayani 'ahetsiemieme.   
\q1
\v 13 Kepauka pemutahiwani parewiya pehawawatɨ,  
\q2 'akakaɨyarixi mekematsi'utawikweitsitɨani kemɨ'ane yemekɨ pemɨwaranayexei.  
\q1 Mɨkɨ yunaime 'eka kaniwaranu'enitsitɨamɨkɨ,  
\q2 xeihɨtsieriyarikɨ mekanikumawerikuni.  
\q1 Peru kemɨ'ane nehetsie muyu'awieta  
\q2 kwie pɨyetuiriyarieni hetsiena mieme mɨhɨkɨtɨnikɨ  
\q2 meta yukwie kanayeitɨamɨkɨ nehɨrɨ mɨpatsie».   
\s1 Kememɨtenɨtɨarieni  
\p
\v 14 Mɨpaɨ pɨtitaniukieni:  
\q1 «Xekeneutiwewi, xekeneutiwewi, huye xekeneukuha'arita.  
\q2 Xeketenanutaxɨriexɨa neteɨterima wahuyeta mɨtiu'utɨka».   
\q1
\v 15 Mɨpaɨ mainekɨ 'amutewi meta mumariwe,  
\q2 yuheyemekɨ 'amuyeika, mɨpatsie mɨtitewa:  
\q1 «Ne meutitewatsie nekanikiekametɨni mɨpatsietsie,  
\q2 Peru yaxeikɨata yu'iyaritsie muyuhiwerie meta tixaɨtɨ mɨkarayuyeitɨa hamatɨa nepuyeika,  
\q1 nemɨwatɨrɨkariyanikɨ yu'iyaritsie memɨwerarani  
\q2 kemɨ'ane yu'iyaritsie memɨyuhiwerie nepɨwatɨrɨkariya.   
\q1
\v 16 Yuheheyemekɨ nepɨkamatsixanetani,  
\q2 meta yuheyemekɨ nepɨkaha'aka,  
\q1 xɨka mɨpaɨ 'anenike nehɨxie yunaitɨ  
\q2 memɨte'u'uwa nemuwarutiwewi mekaniukwiwaweni.   
\q1
\v 17 Neteɨterima memɨteyukahiwe'eriekɨ nepuyeha'a,  
\q2 'axamemɨteyuriekaikɨ,  
\q1 ne'uyeha'aka nepɨwaru'uximatɨa,  
\q2 nepuwaruku'eiri,  
\q1 peru matsi mɨkɨ mepenukuwei  
\q2 huye 'axamɨ'anene.   
\q1
\v 18 Wahuye nepɨxeiya, peru ne 'aixɨa meteheu'eriekame nekaniwarayeitɨamɨkɨ,  
\q2 'aixɨa 'anemekɨ nepuwaranuwitɨni, yemekɨ nepuwanɨtɨani.  
\q1 Meta memutitsuana wahetsiemieme,   
\q2
\v 19 mɨpaɨ mete'ukwikame nekaniwarayeitɨamɨkɨ:  
\q1 Kayuwatɨ mepɨpitɨarieni 'ateewa memu'uwa,  
\q2 meta 'ahurawa memu'uwa.  
\q2 Ne 'aixɨa meteheu'eriekame nekaniwarayeitɨamɨkɨ ―Yawé mɨpaɨ kanaineni―,   
\q1
\v 20 peru 'axateyuruwamete haramara muyuane hepaɨ mekani'aneneni,  
\q2 kayuwatɨ mutamare mɨkayɨwe,  
\q2 hamewarieya haxu mɨ'atɨwa meta tɨniriya.   
\q1
\v 21 'Axateyuruwamete kayuwatɨ memu'uwani mepɨkayɨwawe ―nekakaɨyari mɨpaɨ kanaineni―.   
\c 58  
\s1 Hakiya yuri mɨhɨkɨ  
\q1
\v 1 »Keneutahiwa karima, pepɨka'utimamaweni.  
\q2 Kwi keneutahiwa kuxineta hepaɨ.  
\q1 Neteɨterima keniwarutaxaneta memɨnetsi'aye'uniekɨ,  
\q2 'axamemɨte'uyurikɨ, Kakuwu nuiwarimama.   
\q1
\v 2 Tukarikɨ mekaneniwautɨweni,  
\q2 nehuye mepɨmaiku,  
\q1 wa'atɨtɨ nuiwari  
\q2 heitserie memu'u'uwa mepɨtehɨkɨ,  
\q1 wa'atɨtɨ ne'inɨari niukiyari  
\q2 mepɨkate'uku'eiri.  
\q1 Mepɨnetsiwawirie heitseriemekɨ yanemɨtiyurienikɨ wahetsiemieme,  
\q2 puwanake nehepa 'ahurawa memakɨne,   
\q1
\v 3 meta mɨpaɨ xepɨnete'anutahɨawe:  
\q2 “¿Titayari teteyuhakie, panatsi 'ekɨ yapera'eriwa?  
\q2 ¿Titayari teteyuhiwerieka, panatsi 'ekɨ petatsixeiya?”  
\b  
\q1 »Peru kepauka xeme xemuyuhakie,  
\q2 xepuyuharerutatɨwe xeikɨa meta yuhetsɨa miemete kwinimieme xepɨtewa'uximayatsitɨa.   
\q1
\v 4 Xeme xeikɨa xepuyuhakie xeyutikwinike meta xeyutitienike,  
\q2 xeyutihutsunike.  
\q1 Xɨka xenakeni Kakaɨyari mɨxeta'eiyakɨ,  
\q2 xekeneyuhakieka, peru hikɨ xemɨyɨa hepaɨ hawaikɨ.   
\q1
\v 5 Mɨkɨ hakiya ne nemenayexei xeitukari xeikɨa pɨkamieme para tewi mɨtiuka'eniwanikɨ yuwaiyaritsie,  
\q2 manakatutsirekɨ xeikɨa haka hatɨa mieme hepaɨ,  
\q1 hiwerika kamixayari manakatɨnikɨ  
\q2 meta naxi muyukawirienikɨ.  
\q1 Xeme mɨkɨ hakiya xepɨte'uterɨwa,  
\q2 meta Yawé tukari minake.   
\b  
\q1
\v 6 »Hakiya nemanayexei,  
\q2 nemuwaxɨnakɨ pɨ'ayumieme kemɨkatiheitserietsie tepɨakɨ memɨhɨatɨka,  
\q2 yuku kwitaxiyari nemɨxɨnakɨ,  
\q1 kemɨ'ane waɨriyarika memɨte'aitɨarie nemɨwaxɨnakɨ,  
\q2 meta tinaimekɨ memɨtehɨatɨka nemɨwaxɨnakɨ.   
\q1
\v 7 Hakiya kani'ayumiemetɨni meuhakamɨkɨ hamatɨa pemɨtikwanikɨ,  
\q2 meta 'aixɨa pemɨtiwakiitɨanikɨ memɨka'ukii,  
\q1 mɨkarekakemari pemɨtikemaritɨanikɨ,  
\q2 meta kemɨ'ane 'ahepaɨ memɨ'anene hupemɨkawaraxɨrɨwanikɨ.   
\q1
\v 8 Xɨka mɨpaɨ petikamieni,  
\q2 'ahekɨariya panatineni tau 'ɨrɨya hepaɨ 'anetɨ,  
\q2 'ana yapauka 'aixɨa pekatinika'erimɨkɨ,  
\q1 tita mɨtiheitserie 'ahuye kananutayepimɨkɨ,  
\q2 meta Yawé xawatɨriyaya kamenanukuweiyamɨkɨ.   
\q1
\v 9 Pepitahɨawe, Yawé pɨmatsita'eiya,  
\q2 parewiya pepɨtawauni, mɨkɨ mɨpaɨ pɨtayɨni: “'Ena nekaniuweni”.  
\b  
\q1 »Xɨka yuku mahete pehehɨani,  
\q2 meta xanetsika metatsiere 'axaniuki,   
\q1
\v 10 xɨka memeuhakakwiku pewaparewieka,  
\q2 meta kemɨ'ane tiuka'eniwatɨ mɨreuyehɨwa xɨka petikumikwani,  
\q1 'ana yɨwipa 'ahekɨariya kanitaimɨkɨ,  
\q2 'atɨkari tuka hepaɨ 'anetɨ kanayeimɨkɨ.   
\q1
\v 11 Yawé yuheyemekɨ kamenikuwitɨnemɨkɨ,  
\q2 pɨmatsihuxaitɨaka kwie makuwakitsie,  
\q2 meta 'a'umeyarite kanititɨrɨkariyamɨkɨ.  
\q1 Haraweri 'aixɨa mɨtihatuiyarie pekanayeimɨkɨ,  
\q2 haixa pekanayeimɨkɨ mɨka'ukawauke.   
\q1
\v 12 'Ateɨterima kiekari meripaitɨ mieme mu'u'uni 'aixɨa mepɨtiyurieni,  
\q2 tenari meripaitɨ mieme mepanukuketɨani,  
\q1 “kurarute mu'u'uni 'aixɨa mɨtiyuruwa” pepɨtitewaka,  
\q2 meta “huye mɨtikɨnetɨne 'aixɨa yuruwame”.   
\b  
\q1
\v 13 »Xɨka xawati tukariyari kapatsiekame pe'ayeitɨatɨ petiuhayewa,  
\q2 meta pekayuharerutaneni netukari mɨpatsietsie,  
\q1 xɨka xawati “tukari witsimɨ'ane” petiuterɨwani,  
\q2 meta xɨka Yawé tukarieya mɨpatsie, “mɨmariwe” petiuterɨwani,  
\q1 xɨka kapatsiekame pe'ayeitɨatɨ petiuhayewa,  
\q2 meta xɨka pe'eyexeiyani pekayuharerutatɨ,  
\q2 meta niuki tixaɨtɨ mɨkatiyunaki'eriekɨ peka'utaniutɨ,   
\q1
\v 14 hikɨ 'ana Yawé hetsie temawierika pekanikaxeiyamɨkɨ,  
\q2 hɨritsie pe'uyeikame kawayutsie pe'anakaime nepɨmatsi'ayeitɨani,  
\q1 meta peyutemawiekame nepɨmatsi'ayeitɨani  
\q2 'apaapa Kakuwu kwie nemɨyetuiritsie».  
\qr Yawé yɨkɨmana mɨpaɨ kanaineni.   
\c 59  
\s1 'Axakemɨtiuyurienikɨ, hekɨatsika meta wikweitsitɨarika  
\q1
\v 1 Yawé tɨrɨkariyaya  
\q2 'etsipɨkatewi mɨratawikweitsitɨanikɨ,  
\q2 meta mɨkaheu'ena pɨkahɨkɨ.   
\q1
\v 2 'Axaxemɨte'uyuri kanihɨkɨtɨni  
\q2 xekakaɨyari hetsɨa 'ateewa mɨxeti'uitɨa.  
\q1 Mɨkɨ 'axamɨti'ane katiniyurieneni  
\q2 nierikaya meukunama mɨkaxe'eniekakɨ.   
\q1
\v 3 Xeme yumamatetsie xepeuxuxure,  
\q2 meta yu'itɨwametetsie 'axamɨti'anekɨ xepɨteheuwetɨka.  
\q1 Xeteni 'itarika pɨtikuxata,  
\q2 meta xeneni 'axa'anemekɨ pɨtikuxata.   
\q1
\v 4 Nixewitɨ pɨkahahiwa tita mɨtiheitserie rawawatɨ,  
\q2 nixewitɨ yuri mɨrainekɨ pɨkarataxaneta.  
\q1 'Itarikatsie xepɨtewiya,  
\q2 yunaitɨ xepɨteyu'itaiyatɨwe.  
\q1 'Axamɨti'anekɨ xepɨtihukata  
\q2 'axamɨtiuka'iyari xepɨtiniweya xeikɨa.   
\q1
\v 5 Kuterixi watawári xepɨtsiniya  
\q2 meta tukatsi wawiniyari xepɨwewie.  
\q1 Kemɨ'ane mɨkɨ tawári mutakwani pɨmɨni,  
\q2 xɨka xewitɨ mɨkɨ tawári 'utare, kuu kanayenemɨkɨ.   
\q1
\v 6 Yu'itsari xemiwewie xemenakatɨni pɨkayɨwe,  
\q2 tita xemɨtewewiekɨ xemeuyukunani xepɨkayɨwawe.  
\q1 Wawewiya, 'axatiyurɨwame wewiyaya xeikɨa katinihɨkɨtɨni,  
\q2 wamamate 'axamɨti'ane xeikɨa katininetɨaka.   
\q1
\v 7 Wa'ɨkate kaniyumexɨitɨaka 'axamɨtiyurienikɨ hepaɨtsita,  
\q2 mepuyumexɨitɨa 'atsimɨkatiuka'iyari xuririyaya memɨtayeurienikɨ.  
\q1 'Axa'aneme xeikɨa 'iyari mekaniwewieka,  
\q2 yuhuyeta mekateniu'unani meta ti'u'unime mekatenikuhayeikawani.   
\q1
\v 8 Kayuwatɨ muyeikanikɨ mɨ'ayumieme huyeyari mepɨkamate,  
\q2 'aixɨa ti'anetɨ wahuyeta katiniumaweni,  
\q1 Huye tutunime mekaniwewietɨweni,  
\q2 kemɨ'ane mɨkɨ 'utɨa mumie kayuwatɨ muyeikani pɨkamate.   
\b  
\q1
\v 9 'Ayumieme tita 'aixɨa mɨti'ane tahetsɨa 'ateewa puyeika,  
\q2 meta tita mɨtiheitserie temɨkaheuta'axetsie puyeika.  
\q1 Hekɨariya tepɨtakwewiekai, peru naitɨ yɨriya xeikɨa pɨhɨkɨ,  
\q2 hekɨaripa te'u'uwatɨtɨ, yɨriya 'a'ayetsuikame tsata tepu'uwa.   
\q1
\v 10 Memɨkaheuneniere wahepaɨ 'ixumeritsie tekumetɨwetɨ tekaniuhuni,  
\q2 ta'itsɨkɨ xeikɨa teteheutsetɨwetɨ tekaniu'uwani memɨka'uhɨxi wahepaɨ.  
\q1 Tsepa tuka tepekaxɨrɨwe mɨyɨwini hepaɨ,  
\q2 tsepanetɨ 'aixɨa temɨteheu'erie, mɨkite wahepaɨ tepɨ'anene.   
\q1
\v 11 Teyunaitɨ tame hutseri wahepaɨ teputiyuane,  
\q2 kukuruxi memeutuxa wahepaɨ teputiyuane.  
\q1 Mɨtiheitserie tepɨtetakwewiekai, peru pɨkanua,  
\q2 mɨtatsitixɨna 'akuxi 'ateewa 'apuyeika.   
\b  
\q1
\v 12 'Ekɨ pepɨtimate waɨkawamekɨ temɨtehayuye'uniekɨ,  
\q2 tita 'axatemɨte'uyuri pɨtatsixaneta.  
\q1 Temɨtehayuye'unie tahamatɨa 'apuyeika,  
\q2 'axatemɨte'uyuri tepɨmate.   
\q1
\v 13 Temɨkaheu'enana tepɨhɨkɨ, Yawé tepɨka'anu'eni.  
\q2 Takakaɨyari tepuwarixiwiyaxɨ.  
\q1 Teɨteri tepuwananaima meta tepɨwakwamana,  
\q2 'itarikakɨ tepɨtekuxata ta'iyaritsie mayeneikakɨ.   
\q1
\v 14 Mɨpaɨ te'anetɨ 'aixɨa mɨti'ane tepɨkuwarixiwiya,  
\q2 meta tita mɨtiheitserie 'ateewa puyeika,  
\q1 teɨteri memayukuxexeɨriwatsie tita yuri mɨraine mepekahɨpa,  
\q2 heitserie yatepɨkateyurie.   
\q1
\v 15 Yuri mɨraine hawaikɨ pɨkahematsiɨkɨ,  
\q2 kemɨ'ane 'axamɨti'ane memuku'e'eiriwa tinaime yupiinite mepɨtekunawaiyarɨwa.  
\b  
\q1 Yawé pixei matsi pɨka'inakixɨ  
\q2 tita mɨtiheitserie mumawekɨ.   
\q1
\v 16 Kanixeiyani, kanihɨxiyaka  
\q2 mumawekɨ wahetsiemieme haniutɨ.  
\q1 'Ayumieme yɨkɨmana kanayenemɨkɨ muwatawikweitsitɨanikɨ,  
\q2 mɨtiheitserie hetsɨanamieme kaniwatuikakamɨkɨ.   
\q1
\v 17 Tita mɨtiheitserie yuhetsie nunuwame hepaɨ panutikeni,  
\q2 meta yumu'utsie kananuyukanani kuya xupureruya tiyuwikweitsitɨwamekɨ,  
\q1 mɨtiwarakapitɨanikɨ kamixayari panakatɨni,  
\q2 meta yu'ɨtetsarika matayarikɨ puyuta'eima.   
\q1
\v 18 Yapɨtiwapitɨani kememɨte'uyuri,  
\q2 'ateewa haramara tetsita kiekatari yapɨwayurieni:  
\q1 waɨkawa ha'atɨ memeye'unie wahepaɨtsita,  
\q2 meta pɨtiwarakapitɨani.   
\b  
\q1
\v 19 Tau makayuyuipike hepa kiekatari Yawé kemɨtitewakɨ mepɨtimakani,  
\q2 meta tau manatineikatsie kiekatari mumariwe mepeu'enieka.  
\q1 Karikɨ kaninuamɨkɨ haa tɨrɨkaɨyetɨ muwayeneika hepaɨ,  
\q2 Yawé hɨtsierieyakɨ muwayenexɨa.   
\b  
\q1
\v 20 «Tiyuwikweitsitɨwame Tsiyuni kaninuamɨkɨ,  
\q2 yunaime Kakuwu hetsɨa miemete wahetsɨa kaninuamɨkɨ  
\q2 'axamete'u'iyaritɨ mekete'uhayewa.  
\qr ―Yawé mɨpaɨ kanaineni―.   
\b  
\q1
\v 21 Yawé mɨpaɨ kanaineni:  
\q2 «'Ikɨ netɨratu kanihɨkɨtɨni xehamatɨa nemiwewie:  
\q1 Ne'iyari xehetsie mɨyeka,  
\q2 meta neniuki nemɨmatsi'upitɨa pemekaterɨwakɨ 'ape'uyuatɨ,  
\q1 hatsuaku pɨkamatsiku'eirieni,  
\q2 meta 'aniwema wahetsie meta 'anuiwarima wahetsie,  
\q2 hikɨtɨtɨ meta yuheyemekɨ  
\qr ―Yawé mɨpaɨ kanaineni―.   
\c 60  
\s1 Xawatɨriya Tsiyuni mieme  
\q1
\v 1 »Kenanukukexi, kenexawatɨni, 'ahekɨariya kaninuaniri.  
\q2 Yawé xawatɨriyaya 'ahetsie kaniutitataweni.   
\q1
\v 2 Neuxei, kwie yɨriya kananukanaka,  
\q2 teɨteri wahetsie yɨriya 'amayetsuye kanixuaweni.  
\q1 Peru Yawé hekɨariyaya ximeri mieme 'ahetsie kanitaimɨkɨ,  
\q2 xawatɨriyaya 'ahetsie matsiɨkɨtɨ payani.   
\q1
\v 3 Nuiwarite mepuwitɨkieximeni 'axawatɨriya mexeiyatɨ,  
\q2 meta te'aitamete, 'ahekɨariya ximeri mieme mexeiyatɨ.   
\b  
\q1
\v 4 »Teikɨ kenenieri, kenanieretɨye'a:  
\q2 yunaitɨ mepuyuxeɨrie meta 'ahetsɨa mepɨ'axe.  
\q1 'Aniwema 'ateewa mepaneika,  
\q2 'aniwema 'ukari mepɨ'atɨariwa me'ɨtɨkietɨ.   
\q1
\v 5 Mɨpaɨ petiniereme waɨkawa pepuyukatemawieni,  
\q2 'a'iyari puyuaneni, temawierikakɨ,  
\q1 mɨraye'atɨka mekamani'atɨiriekuni haramaratsie mieme,  
\q2 'ahetsɨa katini'atɨariemɨkɨ nuiwarite tiwapiini mɨraye'atɨka.   
\q1
\v 6 'Ahetsɨa kameyutsixi mewaruhapatɨ yuwaɨkawatɨ mepɨ'axɨani,  
\q2 Mariyani meta 'Epa kiekatari.  
\q1 Tsawa kiekatari yunaitɨ mekani'axɨakuni,  
\q2 huru me'ɨtɨtɨ meta 'ɨkwa witsimu'ɨa,  
\q2 meta Yawé nɨawarieya mekuxatatɨ.   
\q1
\v 7 Yunaitɨ Tseraxi muxatsimama 'ahetsɨa mepuyukuxeɨrieni,  
\q2 meta Newayuti hetsɨa miemete muxatsi 'ukitsi mepɨmeteta'uximayatsirieni,  
\q1 mawari witsimu'ɨa hepaɨ nemawari taiyametsie mepanutikɨne,  
\q2 Ne witsitiyuxexeiyame nepayeitɨani netuki mɨmariwe.   
\b  
\q1
\v 8 »¿Kemɨ'ane mepɨhɨkɨ hai hepaɨ memanuyekɨka,  
\q2 meta kukuruxi memeutuxa wahepaɨ yu'ituatsie memekɨka?   
\q1
\v 9 'Ateewa kiekatari haramara tetsita, mepɨnetsitakwewie,  
\q2 kanuwa 'amupapa Taritsi mieme mexɨakate kani'axɨamɨkɨ,  
\q1 'ateewa 'aniwema waratɨme,  
\q2 meta wahuru wapɨrata hatɨtɨ,  
\q1 Yawé memɨyetuirienikɨ 'akakaɨyari,  
\q2 Mɨpatsie 'Ixaheri hetsiemieme,  
\q2 mɨkɨ pemariweme pɨmatsi'ayeitɨa.   
\b  
\q1
\v 10 »Tewanarixi 'akuraru mepanukuhana,  
\q2 meta tewa'aitɨwamete mepɨmateta'uximayatsirieni.  
\q1 Tsepa neha'atɨ nemɨmatiukwinitɨakai,  
\q2 kemɨnetinakekɨ nepɨmatsinenimayaka.   
\q1
\v 11 'Akitenie yapɨreuyepietɨkani,  
\q2 tukarikɨ meta tɨkarikɨ pɨkareunarɨmiketɨkani,  
\q1 'ahetsɨa pɨti'atɨarieni nuiwarite tiwapiinite waɨkawa muraye'atɨka,  
\q2 meta 'ahɨxie xuruku mehewetɨkaitɨ mepuku'uni tewa'aitɨwamete mema'iwarie.   
\q1
\v 12 Kemɨ'ane nuiwari mɨkameti'uximayatsirie, pɨkumawere,  
\q2 naitɨ pɨka'unarieni.   
\b  
\q1
\v 13 »Riwanu kemɨtimariwekai mɨpaɨ pepɨyɨni,  
\q2 huku 'amutɨtɨ, kwetsi kɨyeyari, meta tsiiná pɨ'atɨarieni,  
\q1 witsipemɨrakuyurienikɨ netuki manuwe.  
\q2 'Aixɨa nepiyurieni hakewa ne'ɨkate meyuwetɨka.   
\q1
\v 14 'Ahɨxie mepɨkahɨxima'uni  
\q2 kemɨ'ane waɨriyarika memɨxete'aitɨakai waniwema,  
\q1 yunaitɨ kemɨ'ane memɨmatsixani'erie  
\q2 'a'ɨkatɨa mepɨtihɨxima'uni,  
\q1 “Yawé Kiekarieya” mepɨmateterɨwa,  
\q2 “Tsiyuni Mɨpatsie 'Ixaheri hetsiemieme”.   
\b  
\q1
\v 15 »Tsepa pemuku'eiriwakai meta pemutixani'eriwakai,  
\q2 tsepa xewitɨ 'ahuye 'utɨma mɨka'uyeyeikakai,  
\q1 yanepɨtiyurieni 'ahetsie yuheyemekɨ pemuyuta'ɨrenikɨ  
\q2 meta temawierika yamɨreuyuhanenikɨ.   
\q1
\v 16 Nuiwarite waretsikɨ pepɨtikwaka,  
\q2 te'aitamete memɨtehexeiyakɨ pepɨtsitsitɨarieka.  
\q1 Hikɨ 'ana mɨpaɨ pepɨretimani kename, ne Yawé, 'awikweitsitɨwame nehɨkɨ,  
\q2 kename ne, nemɨtɨrɨkaɨye Kakuwu hetsiemieme, nemumatsiwikweitsitɨwame nehɨkɨ.   
\q1
\v 17 Wurunitse hetsiemieme huru nepɨmatsi'atɨirieni,  
\q2 meta tepɨa hetsiemieme pɨrata nepɨmatsi'atɨirieni.  
\q1 Kɨyexi hetsiemieme Wurunitse nepɨmatsi'atɨirieni,  
\q2 meta tetexi hetsiemieme, tepɨa nepɨmatsi'atɨirieni.  
\q1 Yanepɨtiyurieni kayuwatɨ pemexeiyanikɨ,  
\q2 meta tita mɨtiheitserie mɨmatsikuyuitɨwanikɨ.   
\q1
\v 18 'Akwietsie nanaimarika pɨkamariwani,  
\q2 meta pepɨkaka'unarieni, metatsiere 'akwie manuye'atɨka pɨka'anuye'unarietɨyani,  
\q1 matsi pɨta 'akurarute “Wikweitsitɨarika” pepɨtiterɨwa,  
\q2 meta 'a'ituparite “Nɨawari” pepɨtiterɨwa.   
\q1
\v 19 Tau pɨkahɨkɨtɨniri tukarikɨ mɨmatsihekɨariwiyani,  
\q2 meta metsa yuhekɨariyakɨ pɨkamatsihekɨariwiyani,  
\q1 Yawé pɨta 'ahekɨariya yuheyemekɨ mieme kanihɨkɨtɨkamɨkɨ,  
\q2 'akakaɨyari pɨmatsixawatɨriyani.   
\q1
\v 20 'Atau hatsuaku pɨka'akayune,  
\q2 meta 'ametseri hatsuaku pɨkatɨni,  
\q1 Yawé kanihɨkɨtɨkamɨkɨ 'ahekɨariya yuheyemekɨ mieme,  
\q2 meta hiwerika tukariyari kaneutiparimɨkɨ.   
\q1
\v 21 Hikɨ 'ana yunaitɨ 'ateɨterima heitserie mepu'uwani,  
\q2 meta yukwietsie mepu'uwani yuheyemekɨ.  
\q1 'Iteɨri nemikake mɨyɨra xepɨhɨkɨtɨni,  
\q2 newewiya 'aixɨa muyɨ kɨmana nemɨmariwe.   
\q1
\v 22 Waɨkawa mɨwerani xeimiriyarikɨ pɨtaxiɨni,  
\q2 'etsimutewi nuiwari tɨrɨkaɨyetɨ payani.  
\q1 Ne Yawé nekanihɨkɨtɨni,  
\q2 kepauka tukari maye'ani yanekatiniyurimɨkɨ, nepɨkatihayewa».   
\c 61  
\s1 Kepauka Yawé 'aixɨa mɨtiyurieni  
\q1
\v 1 Yawé naimekɨmɨyɨwe 'iyarieya nehetsie kaniyekani,  
\q2 mɨpaɨ mɨneranayexeikɨ  
\q2 niuki 'aixɨa manɨyɨne nemuwakuxaxatɨwanikɨ tixaɨtɨ memɨkateheuxeiya.  
\q1 Pɨnetsiheyenɨ'a yu'iyaritsie memɨte'ukakukuine 'aixɨa meteheu'eriekame nemɨwarayeitɨanikɨ,  
\q2 'ateewa memehapanie nemɨwakuxaxatɨwanikɨ,  
\q2 meta kemɨ'ane memanutaxɨriya nemɨwaranayexɨnakɨ,   
\q1
\v 2 Yawé parewiyaya tukariyari nemɨkuxatanikɨ kemɨraye'anikɨ  
\q2 meta takakaɨyari kepauka mɨtiwarakapitɨani tukariyari,  
\q1 kemɨ'ane memuyuhiwerie nemɨwanɨtɨanikɨ,   
\q2
\v 3 Tsiyunitari memɨte'uka'eniwa nemɨwatɨrɨkariyanikɨ.  
\q1 Pɨnetsiheyenɨ'a kuruna nemɨxe'anutiketsirienikɨ  
\q2 naxiri pɨkahɨkɨtɨni,  
\q1 temawierika hatseitiyari nemɨxekawirienikɨ  
\q2 nutuixiyari pɨkahɨkɨtɨni,  
\q1 kamixa 'ixɨararipa mieme nemɨxe'anakatɨtɨanikɨ  
\q2 'iyari mɨkayuwaɨriyari pɨkahɨkɨtɨni.  
\q1 Tuaxa tita mɨtiheitserie mɨrexeiya xepɨteterɨwarieni,  
\q2 Yawé 'iteɨrieya, kɨmana witsitixeiyarietɨ mayuyeitɨanikɨ.   
\q1
\v 4 Meripaitɨ mɨtiuka'unarie 'aixɨa xepɨtetiyurieni,  
\q2 meripaitɨ mieme kii mu'u'uni xepanuku'uitɨani,  
\q1 kiekari mu'u'uni 'aixɨa xepɨtiyurieni,  
\q2 meta meripaitɨ kiekatari wakii 'unimeyari mɨti'u'uni.   
\q1
\v 5 Hipatɨ teɨteri xemɨkawamate xemuxatsima  
\q2 mepɨwahɨtɨweni,  
\q1 xekwietsie meta xekaxie haraweriyaritsie mepɨteta'uximayata  
\q2 teɨteri 'ateewa kiekatari.   
\q1
\v 6 Peru xeme «Yawé mawari wewiwametemama» xepɨteterɨwarieni,  
\q2 mɨpaɨ mepɨxetekɨhɨaweni «takakaɨyari te'uximayatsiriwamete».  
\q1 Nuiwarite waɨkawa piinitɨarika kememɨtehexeiyakɨ xepɨtekwaka,  
\q2 wapiinite mɨraye'atɨka xetehexeiyatɨ xemuyuti'ɨre.   
\b  
\q1
\v 7 Mɨwatewiyaritɨnikekai,  
\q2 neteɨterima mepɨtekumikiwani waɨkawa 'imikieri kememɨteheuyehɨwa,  
\q1 memɨnanaimariekanikeyu,  
\q2 mepuyutemamawieka yukwiepa me'u'uwatɨ wakwie mayanikekaitsie,  
\q1 mɨpaɨ me'anekaku yukwietsie hutame hetsie timiemekɨ mepɨtekuhayewiyarieni,  
\q2 meta watemawierika yuheyemekɨ mieme payani.   
\b  
\q1
\v 8 «Ne Yawé, tita mɨtiheitserie nepɨtinaki'erie,  
\q2 peru nepi'uxiwe'erie 'inawari meta 'axamɨti'ane.  
\q1 'Aixɨa nemɨtiuka'iyarikɨ wa'iwarika nepɨtiwamini,  
\q2 meta wahamatɨa tɨratu yuheyemekɨ mieme nepɨwewieni.   
\q1
\v 9 Xiɨyarimama mepetimatiwa nuiwarite watsata,  
\q2 meta waniwema, teɨteri watsata.  
\q1 Kemɨ'ane memɨwaxeiya, mepɨwaretimani  
\q2 kename mɨkɨ nuiwari Yawé 'aixɨa mɨwayurie mehɨkɨ».   
\b  
\q1
\v 10 Yawé hetsiemieme nepɨnetemawie yemekɨ waɨkawa,  
\q2 nekakaɨyari hetsie temawierika nepexeiya.  
\q1 Mɨkɨ wikweitsitɨarika kamixayari mɨnetsi'anakatɨtɨakɨ  
\q2 meta tita mɨtiheitserie matayari pɨnetsiwakuketɨa.  
\q1 Neneɨkeme hepaɨ nekani'aneni witsimɨrekemari,  
\q2 yatɨni wikiwame hepaɨ nekatinekukani.   
\q1
\v 11 Kwie kemɨtiyɨrariyawe,  
\q2 meta haraweri 'etsiya kemɨtitinenetɨwa,  
\q1 mɨpaɨ Yawé naimekɨmɨyɨwe katinitinetɨamɨkɨ  
\q2 tita mɨtiheitserie meta nɨawari yunaime nuiwarite wahɨxie.   
\c 62  
\s1 Hekwamekɨ Tsiyuni kemɨtiterɨwarieni  
\q1
\v 1 Tsiyuni nemɨnaki'eriekɨ kayuwatɨ nepɨka'umaka,  
\q2 Kerutsareme nemɨnaki'eriekɨ nepɨkati'uxe,  
\q1 kepauka hetsiena tita mɨtiheitserie mutitataweni tau 'ɨrɨya hepaɨ,  
\q2 meta wikweitsitɨarikaya 'utsi kɨxeme mɨta'a hepaɨ.   
\q1
\v 2 Nuiwarite kwiepa memɨtama tita mɨtiheitserie 'ahetsɨa mieme mepɨxeiya,  
\q2 meta yunaitɨ te'aitamete kepemɨtimariwe,  
\q1 hekwamekɨ pekanitaterɨwariemɨkɨ,  
\q2 Yawé pɨmatsitaterɨwa.   
\q1
\v 3 Yawé mamayatsie kuruna hepaɨ pepɨ'aneni pemariwetɨ,  
\q2 ti'aitame haremaya hepaɨ pepɨ'aneni 'akakaɨyari mamayatsie.   
\q1
\v 4 «'Eiriwakame» pepɨkatiterɨwarieniri,  
\q2 meta 'akwie «Makumawe» pɨkatiterɨwarieni,  
\q1 matsi «Netemawierika» pepɨtiterɨwarieni,  
\q2 'akwie «Ne'ɨya» pɨtitewaka,  
\q1 Yawé 'ahetsiemieme puyutemawieka,  
\q2 meta 'akwie pɨrekakɨnani.   
\q1
\v 5 Temaikɨ 'uka mutiuwitɨkɨ hepaɨ,  
\q2 mɨpaɨ kemɨ'ane mɨmatsi'anukakitɨani pumatiwitɨni,  
\q1 neneɨkeme mitiwitɨni xeiyatɨ muyutemawie hepaɨ,  
\q2 mɨpaɨta 'akakaɨyari pɨtiyutemawieka 'ahetsiemieme.   
\b  
\q1
\v 6 Kerutsareme, 'akurarutsie tehɨwemete nepɨwaru'uitɨa  
\q2 hatsuaku mepɨkatehayewa, tukarikɨ meta tɨkarikɨ yamepɨtehayeneniereni.  
\q1 Xeme, Yawé xemahɨawe,  
\q2 xepɨka'uxipieka,   
\q1
\v 7 meta yukakaɨyari xepɨka'uxipitɨaka,  
\q2 Kerutsareme 'aixɨa yurieyuke,  
\q2 nɨawari hayeitɨarieyuke kwiepa memɨtama wahetsiemieme.   
\b  
\q1
\v 8 Yawé mɨpaɨ katiniuyɨhɨritɨani,  
\q2 yumamá yutserieta miemekɨ meta yɨtɨrɨkariyakɨ:  
\q1 «Hatsuaku tawariri memɨmetsi'aye'unie nepɨkawamini  
\q2 'a'iku memɨtikwanikɨ,  
\q1 meta kaxie winuyari mɨhekwa pemɨtiuta'uximayataxɨ hetsiemieme mepɨka'anu'ieni 'ateewa kiekatari,  
\q2 kɨmana 'ekɨ pemɨtiuta'uximayataxɨ.   
\q1
\v 9 Yawé menɨawatɨ mepitikwani yu'iku  
\q2 kemɨ'ane memika'e,  
\q1 netuki takwayaritsie winu mepanu'ieni kemɨ'ane  
\q2 kaxie harawerita memɨte'uta'uximayataxɨ».   
\b  
\q1
\v 10 Kitenietetsie xekeneutahakeni, xekeneutahakeni.  
\q2 Huye xekeneukuha'arita teɨteri wahetsiemieme.  
\q1 Huye 'a'atayeume xekeneutawewi.  
\q2 Tetexi naime huyeta metetɨka xekenexɨri.  
\q2 Patera xekeneuyuitɨwani teɨteri hipatɨ memixeiyanikɨ.   
\b  
\q1
\v 11 Mɨpaɨ 'aneme Yawé niuki kaniyetuaka  
\q2 kwie manu'axe paitɨ mɨye'anikɨ:  
\q1 «Tsiyuni niweya 'uka mɨpaɨ xeketeneutahɨawi:  
\q2 “Mana kanamieni Metsiwikweitsitɨwame.  
\q1 Yu'imikieri katinapika,  
\q2 Tita mɨra'iwaxɨ hamatɨana kaniumieni”».   
\q1
\v 12 «Teɨteri memɨpatsie» mepɨtetetewaka,  
\q2 «Yawé muwarutawikweitsitɨa».  
\q1 «Kiekari pemɨnaki'eriwa» 'ekɨta pepɨtitewaka,  
\q2 «Kiekari hatsuaku mɨkaku'eiriwa».   
\c 63  
\s1 Yawé mɨyɨkɨhɨani tukariyari meta kepauka Kakaɨyari 'aixɨa mɨwayurieni  
\q1
\v 1 ¿Kemɨ'ane pɨyɨane 'Erumi makamie,  
\q2 meta Wutsira makamie, 'ixuriki yɨtsikimaɨyeme 'anakatɨtɨ?  
\q1 ¿Kemɨ'ane pɨyɨane mɨkɨ witsimɨrekemari,  
\q2 yutɨrɨkarima mumie?  
\b  
\q1 «Ne nekaniyɨaneni, heitseriemekɨ nemɨtikuxata,  
\q2 tɨrɨkariya nemexeiya nemɨratawikweitsitɨanikɨ».   
\b  
\q1
\v 2 ¿Titayari 'a'iwite tixeta,  
\q2 kaxie matiketsinarɨwa te'uximayatamete wahepaɨ?   
\b  
\q1
\v 3 «Ne kaxie nexaɨtame nekaniutiketsini,  
\q2 hipatɨ teɨteri mepɨkanetsi'uparewi.  
\q1 Nekanitiketsini nehaxɨakɨ,  
\q2 nekaniwarutipɨna neha'atɨ.  
\q1 Waxuriya ne'ixuriki kaniuwirieni,  
\q2 naime nekamixa nekaniutawirieni.   
\q1
\v 4 'Ariri kepauka nemɨnekɨhɨani yanepɨtimate.  
\q2 Newikweitsitɨarika wiyari paye'ari.   
\q1
\v 5 Neuxei, peru pumawekai kemɨ'ane mɨnetsiparewieni,  
\q2 nepɨhɨxiya xewitɨ mɨkanetsiparewimɨkɨkɨ.  
\q1 Netɨrɨkariya katiniuyurieni nemɨrayu'iwaxɨ,  
\q2 nehaxɨatɨtɨ kaneniuparewieni.   
\q1
\v 6 Neha'atɨ teɨteri kwiepa memɨtama nepɨwarutiketsi,  
\q2 nepɨwarutitarɨwaitɨa nehaxɨa tekɨxiyarikɨ,  
\q2 waxuriya kwiepa 'uhaneme nepayeitɨa».   
\s1 Nɨawari meta nenewieri  
\q1
\v 7 Yawé naki'eriyaya mɨmariwe nepaye'erieni,  
\q2 meta kemɨtiuyuri 'aixɨa pɨ'ane minɨawanikɨ,  
\q1 naime kemɨtiuyuri tahetsiemieme,  
\q2 kemɨtiuyukanenimaya meta naki'eriyaya mɨmariwekɨ.  
\q1 Huu, pɨmɨire 'aixɨa 'anemekɨ kemɨtiuyuri  
\q2 'Ixaheri nuiwarimama wahetsiemieme.   
\q1
\v 8 Mɨpaɨ nepaine: «Yurikɨ neteɨterima mepɨhɨkɨ,  
\q2 neniwema hatsuaku memɨkanete'itaiya».  
\q1 Mɨpaɨ pɨratɨa wawikweitsitɨwame   
\q2
\v 9 naime kememɨte'uka'eniwakaikɨ.  
\q1 Mɨkɨtɨtɨ puwarutawikweitsitɨa,  
\q2 xeime pɨkaheyenɨ'a meta nixeime niuki tuayame.  
\q1 Yunaki'eriyakɨ meta yunenimayatsikakɨ kaniwarutawikweitsitɨani,  
\q2 kaniwaranukutɨkɨ, kaniwaretɨkɨ yumamatetsie  
\q2 meripaitɨ hepaɨ.   
\q1
\v 10 Peru mɨkɨ mepɨkahenu'eni,  
\q2 meta 'iyarieya mɨpatsie mepu'iyarimɨtɨa.  
\q1 'Ayumieme waraye'unietɨ patɨa,  
\q2 mɨkɨtɨtɨ pɨwarutakwi.   
\b  
\q1
\v 11 Teɨterimama meripaitɨ mieme mepaye'eri,  
\q2 Muitsexi muyeikakaitsie:  
\q1 ¿Hakewari haramaratsie muwaranawitɨ,  
\q2 muxatsi wahɨweme muxatsi mɨtiwaruwitɨkɨ hepaɨ?  
\q1 ¿Hakewari yu'iyari mɨpatsie  
\q2 watsata mɨ'atɨa,   
\q1
\v 12 yamɨtiuyuri yumamá mariwemekɨ  
\q2 Muitsexi tserieta mumienikɨ,  
\q1 kemɨ'ane haa manutayepi mana muyanikɨ,  
\q2 yuheyemekɨ matiwatɨ mayanikɨ?   
\q1
\v 13 ¿Hakewari haramaratsie muwaranawitɨ,  
\q2 makumawetsie yeikame kawayutsie manaka hepaɨ,  
\q2 witsi'anekɨa muwarawitɨ memɨkahekaxɨri?   
\q1
\v 14 Yawé 'iyarieya puwaruka'uxipitɨa  
\q2 tewaxi makuweritsie memɨtekwatɨwe wahepaɨ.  
\q1 Mɨpaɨ pepɨtiwaruwitɨ 'ateɨterima,  
\q2 waɨkawa pemariwetɨ pemayanikɨ.   
\b  
\q1
\v 15 Kenakanieri muyuawitsie paitɨ,  
\q2 keneutanierixɨa 'akiekari mɨpatsietsie meta witsimɨtiyuxexeiyatsie paitɨ.  
\q1 ¿Hakewari 'atɨrɨkariya meta 'a'ɨtetsarika?  
\q2 pepɨtatsikweririe mɨmɨirekɨ kepemutiyukanenimaya, witsikepemɨtiuka'iyari.   
\q1
\v 16 Peru 'ekɨ tapaapa pepɨhɨkɨ,  
\q2 tsepa 'Apɨrahami mɨkatatsimate  
\q2 meta tsepa 'Ixaheri mɨkatatsimaiwe,  
\q1 'ekɨ, Yawé, tapaapa pepɨhɨkɨ,  
\q2 «Tatsiwikweitsitɨwame» yuheyemekɨ pepɨtitewa.   
\q1
\v 17 ¿Titayari Yawé, petareuyexɨrɨwa 'ahuyeta,  
\q2 meta titayari ta'iyari petitseiriya  
\q2 temɨkametsimakaxenikɨ?  
\q1 Kenenua te'a'uximayatsiriwamete pemɨwanaki'eriekɨ,  
\q2 'anuiwarite 'ahetsɨa miemete yuheyemekɨ memɨhɨkɨ.   
\q1
\v 18 'Ateɨterima yatewimekɨ 'atuki mepexeiyakai,  
\q2 peru hikɨ memɨtatsi'aye'unie mepitiketsixɨa.   
\q1
\v 19 Wa'atɨtɨ hatsuaku pepɨkatatiuta'aitɨa tepɨ'ane,  
\q2 wa'atɨtɨ hatsuaku kepemɨtitewa temɨkate'uterɨwarieni hepaɨ.   
\b  
\c 64  
\q1
\v 1 Mɨpaɨ tepɨteha'eriwakaku muyuawi xɨka pewakayepienike muwa pemakanenikɨ,  
\q2 Hɨrite 'ahɨxie putiyɨyɨakawe,   
\q1
\v 2 tai kɨyexi kemɨtikutaiya hepaɨ,  
\q2 meta haa kemɨtikwaniyawe.  
\q1 Mɨpaɨ kepemɨtitewakɨ pepɨtiwaxeitsitɨani memɨmetsi'aye'unie watsata,  
\q2 'ahɨxie meti'utɨ nuiwarite meputiyɨyɨakawawe.   
\q1
\v 3 Kepauka pemanakatɨa mariwemekɨ pepɨtiuyuri mɨpaɨ tekateha'eriwakaku,  
\q2 'ahɨxie hɨrite putiyɨyɨakaxɨ.   
\q1
\v 4 Xewitɨ tawarita, meripaitɨtɨ  
\q2 mɨpaɨ pɨkati'enawe,  
\q1 meta xewitɨ mɨpaɨ pɨkatinieriwe,  
\q2 xeime Kakaɨyari 'ahepaɨ tiyurieneme pɨkaxeiyawe  
\q2 kemɨ'ane hetsiena memɨtewiya wahetsiemieme 'aixɨa tiyurieneme.   
\q1
\v 5 Pewaranunakeke pepayeyeika, memuyutemamawie  
\q2 heitseriemekɨ yamemɨtekahu meta 'ahuye mema'eriwa.  
\q1 Peru pepuyeha'arɨwe xɨka tekaheu'enanaka  
\q2 xɨka 'ahuye te'uku'eirieni.  
\q2 ¿Kehepaɨ tetetawikweni?   
\q1
\v 6 Teyunaitɨ teɨteri temɨka'itiyatɨka tepɨhɨkɨ,  
\q2 naitɨ heitseriemekɨ ketemɨteyurie  
\q2 'ixurikite mɨtɨtɨnini hepaɨ pɨ'ane.  
\q1 Teyunaitɨ tepɨtiwauke kɨye xawari hepaɨ,  
\q2 titakɨ 'axatemɨte'uyuri 'eka hepaɨ pɨtatsi'u'enitsitɨaxime.   
\q1
\v 7 Nixewitɨ pɨkamatsihahɨawe,  
\q2 nixewitɨ pɨkayɨtɨrɨkariya 'ahetsie mɨtiwiyanikɨ.  
\q1 Metsɨ pekataniwarixiwiyani  
\q2 pekataniyetuani pɨta 'axamɨti'ane mɨtatsikuyuitɨanikɨ.   
\b  
\q1
\v 8 Peru tsepa mɨyatɨtɨ, Yawé, 'ekɨ ta'ukiyari pepɨhɨkɨ,  
\q2 tame haxu tepɨhɨkɨ, 'ekɨta 'iwewame.  
\q2 Teyunaitɨ tame 'awewiya tepɨhɨkɨ.   
\q1
\v 9 Waɨkawa pepɨkaha'aka, Yawé,  
\q2 pepɨkaheye'eriwaniri yuheyemekɨ 'axaketemɨte'uyuri.  
\q1 Nepɨmatsiwawirie, mɨpaɨ ketinemaika,  
\q2 kename tame 'ateɨterima tehɨkɨ.   
\q1
\v 10 'Akiekarite mɨpatsietɨka puka'unariexɨa,  
\q2 metatsiere Tsiyuni makumawe pɨta kanayani,  
\q2 Kerutsareme yuxaɨta kanekumaka.   
\q1
\v 11 Tatuki mɨpatsie meta mɨmariwe,  
\q2 hakewa tapaapama memɨmatsihenɨawakai,  
\q2 tai kanitaxɨtsitɨani.  
\q1 'U'unitɨ katiniyuhayewa  
\q2 naitɨ tita waɨkawa temɨteheuyehɨakai.   
\q1
\v 12 'Ikɨ mɨya mɨtiɨyɨkɨ, Yawé, ¿'atsipekatiyurieni?  
\q2 ¿Kayuwatɨ petiumaka meta petatikwinitɨatɨ ka'inɨarimekɨ xeikɨa?   
\c 65  
\s1 Ke'aixɨa mɨtiyurieni meta kemɨtiwatawikweitsitɨani  
\q1
\v 1 «Kemɨ'ane memɨkanetsiku'iwawakai wahetsɨa pɨta nepunehekɨataxɨ,  
\q2 kemɨ'ane memɨkanetsikuwautuwekai wahetsɨa yanepɨtiutanaki'eri memɨnetsitaxeiyakɨ.  
\q1 'Iya nuiwari memɨkanetsihahɨawekai,  
\q2 mɨpaɨ nepɨtitahɨawixɨ: “'Ena nepuwe”.   
\q1
\v 2 Tukarikɨ nemamá nepaɨtatsera  
\q2 'iya teɨteri memɨkanetsi'enie wahetsɨa,  
\q1 'axamɨ'ane huyeyari 'utɨma memuhu,  
\q2 kememɨteku'eriwa xeikɨa yameteyurietɨ.   
\q1
\v 3 Mɨkɨ teɨteri mepɨhɨkɨ nehɨxie  
\q2 memɨnetsihaxɨatɨa tukarikɨ,  
\q1 harawerita mawari mekaniwewietɨweni  
\q2 meta 'ɨkwa witsimu'ɨa mekanitaiyatɨweni mawari taiyametetsie,   
\q1
\v 4 mɨkite wateukiyapa putayeixa  
\q2 meta yuxaɨtame tɨkarikɨ maku'awietsie pɨkatariyarɨwa kakutɨ,  
\q1 tuixu waiyari pukwa'a,  
\q2 meta yuxarita wai mɨka'itiya puka'eetsa,   
\q1
\v 5 mɨpaɨta kaniutaineni: “Teewa xekeneu'uwani.  
\q2 'Ahurawa nehetsɨa xepɨkahakɨkani.  
\q1 Ne yemekɨ nekanipatsieka xehetsiemieme”.  
\q1 'Ikɨ naitɨ pɨkanetinake kɨtsi nemɨ'ɨkweni hepaɨ,  
\q2 tai yamɨtita'a tukarikɨ kanihɨkɨtɨni.   
\b  
\q1
\v 6 »Nehɨxie yakatinaka'utsieni:  
\q2 Ne kayuwatɨ nepɨkatiyerɨni.  
\q1 Yanepɨtiwarakapitɨani,  
\q2 mekatenikwinikuni yuwaiyaritsie,   
\q1
\v 7 xeme 'axakexemɨte'uyuri hetsiemieme meta  
\q2 xepaapama kememɨte'uyuri  
\qr ―Yawé mɨpaɨ kanaineni―.  
\q1 Mɨkɨta 'ɨkwa witsimu'ɨa mekaniutitaiya hɨritsie,  
\q2 meta hɨri 'amanutitɨtɨtsie 'axamepɨnete'utama,  
\q1 nekatiniwakwinitɨamɨkɨ wawaiyaritsie  
\q2 meripaitɨ 'axamemɨte'uyurikɨ».   
\p
\v 8 Yawé mɨpaɨ kanaineni:  
\q1 «Kepauka xewitɨ kaxie takari witsi'aneneme mɨtaxeiya,  
\q2 mɨpaɨ putaine: “Nemarima 'aixɨa,  
\q2 'akuxi kanayemaneni hayari”.  
\q1 Mɨpaɨta yaxeikɨa nepɨtiyurieni nete'uximayatsiriwamete nemɨwanaki'eriekɨ:  
\q2 Yunaime nepɨkawaka'una.   
\q1
\v 9 Kakuwu hetsie nuiwari nepuwarayenetɨani,  
\q2 meta Kura hetsie nepuwarayenetɨani kemɨ'ane 'ikɨ hɨrite wapiini mayani.  
\q1 Kemɨ'ane nemuwaranayexeiya tiwapiini payani,  
\q2 mana mepɨtiteni nete'uximayatsiriwamete.   
\q1
\v 10 Neteɨterima kemɨ'ane memɨnetsikuwautɨwe,  
\q2 Tsaruni makuweritsie wamuxatsima mepu'uwani,  
\q2 'Akuhuxi mayeweritsie, wawakaitsixi mepɨye'uwani.   
\b  
\q1
\v 11 »Peru xeme Yawé xemuku'e'eiriwa  
\q2 meta nehɨri mɨpatsie xematɨmai,  
\q1 kakaɨyarixi waɨkawa mɨrexeiyanikɨ meta 'aixɨa pemɨtiumienikɨ memɨ'ayumiemete  
\q2 wahetsiemieme mexa xemukuha'arita meta winu nɨkame xemukatu'a,   
\q1
\v 12 'Ixiparakɨ xemukwi'iwakɨ nepɨxeyetuani,  
\q2 yunaitɨ xeme xepakatutsitaxɨani xemanutixitekiexɨanikɨ,  
\q1 Nexe'utahɨaweku xemɨkanetsi'uta'eikɨ,  
\q2 kepauka nemɨxe'utahɨawixɨ xepɨkanetsi'u'eni.  
\q1 Matsi 'axaxepɨte'uyuri pɨta nehɨxie  
\q2 tita mɨkanetinake xepɨte'anukuwei».   
\p
\v 13 'Ayumieme, mɨpaɨ kanaineni Yawé naimekɨmɨyɨwe:  
\q1 «Nete'uximayatsiriwamete mepɨtekwaka,  
\q2 peru xeme xepɨhaakakwini,  
\q1 nete'uximayatsiriwamete mepɨhareka,  
\q2 peru xeme xepɨharikwini,  
\q1 nete'uximayatsiriwamete mepuyutemamawieka,  
\q2 peru xeme xepuyutetewiyani.   
\q1
\v 14 Nete'uximayatsiriwamete meputikwikani  
\q2 yu'iyarikɨ meyutemamawietɨ,  
\q1 peru xeme xeputihiwani  
\q2 yu'iyaritsie xete'uka'eniwatɨ,  
\q2 xeputitsuanani yu'iyaritsie xete'uka'eniwatɨ.   
\q1
\v 15 Nemɨwaranayexei wahetsie pɨtinake kexemɨtetewa  
\q2 'axaxemɨ'itɨarikakɨ.  
\q1 Yawé naimekɨmɨyɨwe pɨxekwini,  
\q2 peru te'uximayatamete yuhetsɨa miemete yɨkɨ pɨtiwatiterɨwa.   
\q1
\v 16 Tsepa kemɨ'ane xewitɨ 'aixɨa mɨ'itɨariekakɨ mɨkɨ kwieyaritsie xɨka tiutawauni,  
\q2 yapɨtiyurieni Kakaɨyari yuri mɨhɨkɨ hetsiemieme,  
\q1 meta tsepa kemɨ'ane 'ikɨ kwietsie yamɨtiyɨhɨritɨani,  
\q2 yapɨtiyurieni Kakaɨyari yuri mɨhɨkɨ hetsiemieme,  
\q1 'Uximatɨarika meripaitɨ mieme mepatɨmairi,  
\q2 hikɨ nepɨka'iku'eriwari.   
\s1 Muyuawi hekwatɨ meta kwie hekwatɨ  
\q1
\v 17 »Kayuwatɨ xekeneu'enana, 'ari nekaninetɨaximeni  
\q2 muyuawi hekwame meta kwie hekwame.  
\q1 Tawariri pɨkatitaxatsieni meripaitɨ timieme,  
\q2 meta pɨkaha'eriwani.   
\q1
\v 18 Matsi xekeneyutemamawieka, yuheyemekɨ xekeneyutemamawieka,  
\q2 tita nemɨtinetɨaximekɨ:  
\q1 Nepinetɨaxime xeime Kerutsareme yutemawiekame,  
\q2 kiekari temawierika waɨkawa hexeiyakame.   
\q1
\v 19 Nepuyutemawieka Kerutsareme hetsiemieme  
\q2 meta nepuyutemawieka neteɨterima wahetsiemieme,  
\q1 tawarita mana pɨka'enierieni  
\q2 tsuari hiwariyari meta kukuiniya hiwariyari.   
\b  
\q1
\v 20 »Hatsuakuri mana tɨɨri kwitɨwa metakukuwetɨ  
\q2 mepɨkatixuawere,  
\q2 meta 'ukirawetsixi kwitɨwa mepɨkatakukuweni.  
\q1 Kemɨ'ane mɨmɨni xeitsienituyari hexeiyatɨ  
\q2 temaikɨ hepaɨ 'anetɨ pɨyɨaneni,  
\q1 peru kemɨ'ane mana mɨka'utineni  
\q2 'axamɨ'itɨarieka hepaɨ 'anetɨ payeitɨarieni.   
\q1
\v 21 Kii mepɨtiwewieni, muwa mepayetetɨkani,  
\q2 kaxie mepɨka'eni meta takarieya mepɨtikwani.   
\q1
\v 22 'Ari kii mepɨkatiwewieni hipatɨ pɨta muwa memeutayaxekɨ,  
\q2 meta kaxie xepɨkaka'eni hipatɨ pɨta memitikwanikɨ.  
\q1 Matsi neteɨterima watukaritsie  
\q2 kɨye tukarieya kemɨ'ane mɨpaɨ kani'anemɨkɨ,  
\q1 nemɨwaranayexeiya kememɨteyurieni  
\q2 mepɨtekaxeiya mepɨteha'inɨata.   
\q1
\v 23 'Ari yakɨ xeikɨa mepɨkateta'uximayata,  
\q2 meta tɨɨri mepɨkawarayexeiya 'axamemɨ'itɨarienikɨ,  
\q1 mɨkɨ metatsiere waxiɨyarima  
\q2 'ɨimari Yawé 'aixɨa miyurie mekanakɨnikuni.   
\q1
\v 24 'Akuxi mekanetsitahɨawiwekaku,  
\q2 ne nepuwata'eiya,  
\q1 'akuxi meputiniukani  
\q2 peru ne 'ari newa'enieyu.   
\q1
\v 25 Maye muxa hamatɨa yunaitɨ mepɨtetikwani makutsiɨraɨyetsie,  
\q2 maye 'ɨxa pɨtikwani tuuru hepaɨ,  
\q2 meta kuu 'ikwaiya tumuanari pɨhɨkɨtɨni.  
\q1 Naitsarie nehɨri mɨpatsietsie  
\q2 tiyukwinitɨwatɨ kaniumawekamɨkɨ meta tiuyuka'unatɨ»,  
\qr Yawé kanaineni.   
\c 66  
\s1 Ke'aixɨa mɨtiyɨni meta ketemɨteta'ikwewani  
\p
\v 1 Yawé mɨpaɨ kanaineni:  
\q1 «Muyuawi ne'uweni kanihɨkɨtɨni,  
\q2 kwie meta, hetsiena nemɨnewetɨka kanihɨkɨtɨni.  
\q1 Kii xemɨnetsi'utawewirieni pɨkayɨwe.  
\q2 Tixaɨtɨ kiiyari xepɨkanete'uxatɨawawe.   
\q1
\v 2 Netɨrɨkariya katiniuyurieni naime 'ikɨ mɨtiutawewi:  
\q2 mɨpaɨ tiɨyɨku 'ayumieme katiniuneni  
\qr ―Yawé mɨpaɨ kanaineni―.  
\b  
\q1 »Ne nepuwaxeiya tixaɨtɨ memɨkateheuxeiya meta yu'iyaritsie memɨte'uka'eniwa,  
\q2 kemɨ'ane neniuki memayemakaxe.   
\q1
\v 3 Peru kemɨ'ane tuurutsixi memɨwamawatɨwe  
\q2 mɨkɨ teɨteri memɨwatakukuya wahepaɨ mepɨ'anene,  
\q1 kemɨ'ane muxatsi memɨwamawatɨwe  
\q2 mɨkɨ tsɨikɨri wakɨipi memanutimura wahepaɨ mepɨ'anene,  
\q1 kemɨ'ane hatsi mawariyari mɨwewie  
\q2 mɨkɨ tuixuri waxuriya memɨyetuaya wahepaɨ mepɨ'ane,  
\q1 meta kemɨ'aneta 'ɨkwa witsimu'ɨa mukutaiya  
\q2 mɨkɨ memɨkakakaɨyarixi memuwarayexeiya wahepaɨ kani'aneni.  
\q1 Mɨkɨ yuxaɨta yuhuye mepanayexeiyaxɨa,  
\q2 meta mepuyutemawieritɨa mɨxani'eriwakɨ.   
\q1
\v 4 'Ayumieme ne 'uximatɨarika nekananayexeiyamɨkɨ wahetsiemieme  
\q2 tita waɨkawa memɨtemakaxe nekatiniwaranunɨ'airiemɨkɨ.  
\q1 Nixewitɨ mɨkanetsi'uta'eikɨ kepauka nemɨwarahɨawekaitsie,  
\q2 kepauka nemutaniu, nixewitɨ pɨka'u'enaxɨ.  
\q1 Matsi, 'axamepɨte'uyuri nehɨxie  
\q2 tita mɨkanetinake mepɨte'anayexei».   
\b  
\q1
\v 5 Yawé niukieya xekeneu'eni,  
\q2 xeme niukieya xemayemakaxe:  
\q1 «Mɨpaɨ xe'iwama mekaniutiyuaneni memɨxexani'erie  
\q2 meta memɨxehayeweweiya kenemɨtitewakɨ xemɨnetsikuxatakɨ:  
\q1 “Yawé mariwetɨ kehayeitɨarieni,  
\q2 temawierika xehetsie temɨxeiyakɨ”.  
\q2 Peru mɨkɨ pɨta mepɨtewiyatsitɨarieni.   
\q1
\v 6 Hiwari pa'eniɨriɨkɨ kiekaritsie,  
\q2 tukita payeneika hiwari:  
\q1 Yawé hiwarieya kanihɨkɨtɨni  
\q2 memeye'unie yakatiniwarakapitɨamɨkɨ tita wahetsie mɨtimieme.   
\b  
\q1
\v 7 »Meripaitɨ ka'itakwiniwekaku 'akuxi  
\q2 Kerutsareme nunutsi kanayexeiya,  
\q1 'akuxi ka'aye'awekaku matiniwenitsie,  
\q2 'ukitɨme kaniutiniweni.   
\q1
\v 8 ¿Kemɨ'ane 'ari mɨpaɨ pɨtiu'enaxɨ?  
\q2 ¿Kemɨ'ane hepaɨna 'aneme puxei?  
\q1 ¿Tiyɨwe xewitɨ nuiwari mɨtinuiwa xeitukaritsie?  
\q2 ¿Xeikiekariyari mutinuiwa tiyɨwe xeitukaritsie?  
\q1 Matsi, Tsiyuni yutɨɨriyama kaniwarayexeiya  
\q2 'akuxi ka'itakwiniwetɨ waɨkawa.   
\q1
\v 9 Xɨka ne niweyametsie nereuyepieni,  
\q2 nepipitɨani nunutsi mɨtinuiwakɨ  
\qr ―Yawé mɨpaɨ kanaineni―.  
\q1 Nepɨkareunani niweyametsie,  
\q2 karikɨ ne nemɨhɨkɨkɨ memɨtiniweyanikɨ yanemɨtiwakupitɨwa  
\qr ―'akakaɨyari mɨpaɨ kanaineni―.   
\q1
\v 10 Matsi Kerutsareme hamatɨa xekeneyutemamawieka,  
\q2 kemɨ'ane yunaitɨ xeminaki'erie,  
\q1 hamatɨana xekeneutitsukwakani temawierikakɨ,  
\q2 yunaitɨ kemɨ'ane xemutitsuanakai hamatɨana.   
\q1
\v 11 Karikɨ xeme xekanititsitsitɨariekuni meta xekanitihuxaitɨariekuni,  
\q2 nɨtɨarika xekanikaxeiyakuni tsitsitsie,  
\q1 xepɨtihuxani,  
\q2 xepuyutemamawieka tsitsi 'amɨnenetsie».   
\p
\v 12 Karikɨ Yawé mɨpaɨ kanaineni:  
\q1 «Mɨkɨ kayuwatɨ waɨkawa nepɨpitɨani haa tɨrɨkaɨyetɨ muhane hepaɨ,  
\q2 meta kwiepa memɨtama tiwapiini nepɨtipitɨani haa manatiyeuriweni hepaɨ.  
\q1 Xeme xepɨtsitsitɨarieka, xepa'ɨiyaka,  
\q2 tunutetsie xepukuheni.   
\q1
\v 13 Niwekame yuniwe kemɨtinɨtɨwa hepaɨ,  
\q2 mɨpaɨ ne nepɨtixenɨtɨani,  
\q2 Kerutsaremetsie xekaninɨtɨariekuni».   
\b  
\q1
\v 14 Kepauka xeme mɨpaɨ xemɨteneniere,  
\q2 yu'iyaritsie xepuyutemamawieka,  
\q2 hikɨ mɨkɨ waiyarieya pɨtaxutuni tupiriya hepaɨ,  
\q1 Yawé matsiɨkɨme payeitɨani  
\q2 yutɨrɨkariya te'i'uximayatsiriwamete watsata,  
\q2 meta yuhaxɨa kemɨ'ane memeye'unie watsata.   
\q1
\v 15 Yawé 'ukanamieniri tai hetsie yewetɨ.  
\q2 Kaxetateya kuyaxa mieme haikɨri mɨtɨrɨkawi pɨhɨkɨ.  
\q1 Yuhaxɨa pɨyetuani,  
\q2 tai nerɨkwariyarikɨ puyutahaxɨatɨani.   
\q1
\v 16 Taikɨ meta 'ixiparakɨ  
\q2 Yawé teɨteri yunaime puwataxaneta.  
\q2 Yawé tɨrɨkariyayatsie yumɨiretɨ mepɨkwini.   
\p
\v 17 «Wahamatɨa mekanikwikuni kemɨ'ane mepatsiekame memayuyeitɨa meta kemɨ'ane memuyu'itie memeutahaxɨanikɨ harawerita, xeime manuyeka me'uweiyatɨ, meta kemɨ'ane tuixu waiyarieya memɨkwa'a, naikatsi meta hipame mɨtixani'eriwa ―Yawé mɨpaɨ kanaineni―.   
\p
\v 18 »Ne, mɨkɨ 'axamemɨteyuriekɨ meta 'axamemɨteku'eriwakɨ, nepɨwaxeɨrimɨkɨ yunaime teɨteri kwiepa memɨtama, nuiwarite meta yɨkɨ 'anenemekɨ niuki memutiniuka mekani'axɨakuni mekanenixeiyakuni kenemɨtimariwe.   
\p
\v 19 »'Inɨari nekaniwawewiriemɨkɨ, hipatɨ memɨyuhayewa nuiwarite kwiepa memɨtama wahetsɨa nepɨwaranunɨ'ani: Taritsi kiekariyaritsie, Puri, Riria (mana kiekatari kwinie mepɨteheutamɨiwawekai), Tuwari meta Kɨretsiya, meta haramara tetsita meteewatsie hakewa memɨkanetsihetamariwawe meta kenemɨtimariwe memɨka'ixeiyawawe. Mɨkɨ mekanenitaxatakuni kenemɨtimariwe nuiwarite watsata.  
\v 20 Meta naitsarie xe'iwama nuiwarite watsata memutetɨka nehɨri mɨpatsietsie Kerutsareme xepuwa'atɨani, mawari hepaɨ Yawé hetsiemieme, kawayutsixi, kaxetate yukukuyamete, kaxetate titɨkɨmete, muratsixi meta kameyutsixi wahetsie me'utekame xepɨwa'atɨani ―Yawé mɨpaɨ kanaineni—. 'Ixaheritsixi wahepaɨ, watsute 'aixɨa 'anenemeta, hatsi mawariyari Yawé tukita memɨte'atɨwa hepaɨ xekateniwa'atɨakuni.  
\v 21 Mɨkɨ wahetsieta hipame nepuwaranayexeiya, mawari wewiwamete memakɨnekɨ meta rewitsixi ―Yawé mɨpaɨ kanaineni―.   
\b  
\p
\v 22 »Kemɨreutere ne'ixeiyakaku muyuawi meta kwie mɨhekwa neminetɨani, mɨpaɨta xenuiwarima meta kememɨtetetewa mepɨteheutere ―Yawé mɨpaɨ kanaineni―.  
\v 23 Xeimetseriyari 'anukayeikakaku meta xawati xeitsemana miemetsie, yunaitɨ kwiepa memɨtama mepɨ'axɨani nehɨxie memɨkatunuma'unikɨ ―Yawé mɨpaɨ kanaineni―.  
\v 24 Hikɨ kepauka memuwayekɨnetsie mepɨwaxeiya wakaxarite kemɨ'ane memɨnetsi'utami.  
\q1 »Kwitsi pɨkamɨni muwakwa'a,  
\q2 meta tai pɨkatɨni muwatixɨtsitɨwa:  
\q2 memɨxani'eriwa mepakɨne yunaitɨ kwiepa memɨtama wahɨxie».   