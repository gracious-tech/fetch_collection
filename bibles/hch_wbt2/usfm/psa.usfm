\id PSA  
\h Nɨawari 
\toc1 Kakaɨyari nɨawariyari 
\toc2 Nɨawari 
\toc3 Nɨa 
\mt1 Kakaɨyari nɨawariyari  
\c 1  
\ms1 XAPA 1  
\mr Nɨawari 1-41  
\q1
\v 1 'Aixɨa kani'itɨarieka tewi  
\q2 kemɨ'ane 'axamemɨte'u'iyari wa'ɨxatsi mɨka'enie,  
\q2 meta 'axamemɨteyurie wahuyeta mɨka'umie  
\q2 meta 'axamemɨteniniuki wahamatɨa mɨkayuxewiriya,   
\q1
\v 2 matsi Yawé 'aitsikayatsie pɨta muyutemawieritɨa,  
\q2 miku'eriwa tukarikɨ meta tɨkarikɨ.   
\q1
\v 3 Mɨkɨ kɨye hepaɨ kani'aneni  
\q2 hatetsita muka'iteɨtsie hepaɨ  
\q1 kepauka tukarieya maye'axe kaniukaxuxuawereni  
\q2 xawariyari hatsuaku pɨkatiyɨnare.  
\q2 Naimekɨ kemɨtiyuriene 'aixɨa pɨtikuyɨne.   
\b  
\q1
\v 4 Peru, 'axamemɨte'u'iyari  
\q2 xatsi 'eka miku'enitsitɨane hepaɨ mekani'aneneni.   
\q1
\v 5 'Ayumieme kepauka 'axateyuruwamete memetahɨawarieni mepanutaxɨriyani,  
\q2 meta 'aixɨa memɨtekakɨ memayuxeɨrie mana 'axamemɨteyurie mepɨkahepitɨarieni.   
\b  
\q1
\v 6 Yawé 'aixɨa memɨte'u'iyari wahuye kani'ɨwiyani,  
\q2 'axamemɨteyurie matsi wahuye kanitatɨmaiyariemɨkɨ.   
\c 2  
\q1
\v 1 ¿Titayari nuiwarite mete'uyuti'ɨre,  
\q2 meta teɨteri tixaɨtɨ mɨkatiyunaki'erie xeikɨa meteku'eriwa?   
\q1
\v 2 Te'aitamete mepeye'unie,  
\q2 'itsɨkate Yawé mepɨkaha'eriwa  
\q2 meta kemɨ'ane manayexeiyarie hepaɨtsita.   
\q1
\v 3 Mɨpaɨ mekaniutiyuaneni: «Tepɨa kaunariyari tepɨtitekixɨani.  
\q2 Yuku hetsɨana mieme tepuku'eirieni».   
\b  
\q1
\v 4 Muyuawitsie ti'aitame kaniutanaweni,  
\q2 Yawé kaniwa'atseni wananaimatɨ.   
\q1
\v 5 Yuhaxɨakɨ pɨwarayehɨtɨwa,  
\q2 Ha'atɨ pɨwarutate'a mɨpaɨ 'utaitɨ:   
\q1
\v 6 «Ti'aitame nekananukakeni  
\q2 Tsiyuni nehɨri mɨpatsie hetsie».   
\b  
\q1
\v 7 Ne Yawé 'aitsikaya nepɨtaxata:  
\q2 «'Ekɨ pepɨneniwe», pɨnerahɨawe,  
\q2 «Hikɨri nekamaniutinuiwitɨani.   
\q1
\v 8 Kenetineutawawiri,  
\q2 nepɨmatiyetuirieni, nuiwarite nepɨmatsiyetuirieni,  
\q2 'ahetsiemieme pɨrayani naitɨ kwie manuye'atɨka.   
\q1
\v 9 Mana pekatinita'aitamɨkɨ tepɨa 'itsɨyari pe'akwetɨ,  
\q2 pekaniwatitaramɨkɨ haxu xariteyari hepaɨ».   
\b  
\q1
\v 10 Xeme te'aitamete, xekenayeneniereni,  
\q2 xekeneyuwaɨriyani xemɨte'ɨkitɨariekakɨ, kwiepa xemɨ'itsɨkate.   
\q1
\v 11 Yawé xekenayexeiyani xeheyemakatɨ,  
\q2 xeyutemamawietɨ xekenenɨawani.   
\q1
\v 12 Yaxeketenekahuni, kapa 'uyeha'anikɨ  
\q2 kapa xe'ukwinikɨ huyeta,  
\q2 mɨkɨ yapauka kaniuyeha'arɨweni.  
\b  
\q1 'Aixɨa meke'itɨarieka kemɨ'ane memɨyu'awieta hetsɨana.   
\c 3  
\d Rawiri nɨawarieya, kepauka muyuta'unaxɨ yuniwe hepaɨtsita 'Awitsaruni.  
\q1
\v 1 Yawé, mepɨyɨmɨire memɨnetsi'aye'unie,  
\q2 mepuyuwaɨkawa nehɨxie memu'uwe,   
\q1
\v 2 meteyumɨireta mɨpaɨ memutiyuane:  
\q2 «Kakaɨyari pɨka'itawikweitsitɨani».   
\b  
\q1
\v 3 Matsi 'ekɨ, Yawé, pepɨnetsiheutinama kuya kɨmana muyukunarɨma pehɨkɨtɨtɨ,  
\q2 'ekɨ pepɨnexawatɨriya,  
\q2 'ekɨ nemu'u pepanukunieritɨa.   
\q1
\v 4 Yawé neputahiwiwa kenemuyuane,  
\q2 yɨhɨri mɨpatsie hetsie paitɨ pɨnetsiheta'eiya.   
\b  
\q1
\v 5 Ne nepukahupu, nepeukukutsu nepanutaneniereta,  
\q2 Yawé mɨnetsi'ɨwiyakɨ.   
\q1
\v 6 Mepɨkanetsi 'utimariuta kuyaxi memɨyuwaɨkakawa  
\q2 memɨnetsi 'uweiya tsepa hakewa.   
\b  
\q1
\v 7 Yawé, xeiya.  
\q2 Keneneutawikweitsitɨa, nekakaɨyari.  
\q1 Wa'auritapa keniwareutiwaxɨa memɨnetsi'aye'unie.  
\q2 'Axamemɨte'u'iyari watamete kenewaye'unaxɨa.   
\b  
\q1
\v 8 Yawé, wikweitsitɨarika pɨti'apiini,  
\q2 'aixɨa ketineuyuri 'ateɨterima wahetsɨa.   
\c 4  
\d Teyuitɨwamete wa'ukiyari. 'Ikɨ kanaritekɨ ke'utakwikarieni. Rawiri nɨawarieya.  
\q1
\v 1 Keneneuta'eiya kenemerahɨawe,  
\q2 'ekɨ nekakaɨyari nehetsie nunuwame pemɨhɨkɨkɨ.  
\q1 Kepauka nemɨ'uximatɨarie 'ekɨ pepɨnetsinɨtɨa,  
\q2 Nenenewieri keneu'eni kenemaine keneneutinenimayata.   
\b  
\q1
\v 2 Xemeta 'ukirawetsixi xemamariwaweme xemuyu'erie,  
\q2 ¿kepaukake xepɨtehayewa 'axaxeteyurietɨ 'aixɨa xemɨteyuriekakɨ nehetsiemieme?  
\q1 ¿Kepaukake xepɨtehayewa memɨkayuri kakaɨyarixi  
\q2 xewarayexeiyatɨ?   
\b  
\q1
\v 3 Mɨpaɨ xeketenemaika, Yawé kemɨ'ane 'aixɨa mɨtiyuriene kaninaki'erieka.  
\q2 Yawé kaneni'enieka kepauka nemehɨawe.   
\b  
\q1
\v 4 Kepauka xemɨha'a 'axaxepɨkateyurieka,  
\q2 xemuhenitsie xekeneyu'iyaritɨaka 'axaxemɨte'uyurikɨ  
\q2 yu'iyaritsie xekeneyumaika.   
\q1
\v 5 'Aixɨa mɨ'ane mawari xekeneyetuaka  
\q2 Yawé hetsie yuri xete'erietɨ.   
\b  
\q1
\v 6 Yuwaɨkawatɨ mɨpaɨ mekaniutiyuaneni:  
\q2 «¿Kemɨ'ane 'aixɨa mɨti'ane pɨtatiuxeitsitɨawe?»  
\q1 Yawé, pe'atemawietɨ ketaneuxeiya  
\q2 matsiɨkɨme kene'ayeitɨa tahetsie.   
\b  
\q1
\v 7 'Ekɨ ne'iyari temawierieka pepupitɨa 'anuyuhayewame,  
\q2 tɨriku, winu memeuxeiya wareuyeta katiniyutemawieka.   
\b  
\q1
\v 8 Neka'uximatɨarietɨ nekaniukahupuni nekaniukakukutsuni,  
\q2 'ekɨtsɨ xeikɨa Yawé, 'aixɨa 'iyari pekanenayenieritɨaka.   
\c 5  
\d Teyuitɨwamete wa'ukiyari. 'Ikɨ pirikɨxakɨ ke'utakwikarieni. Rawiri nɨawarieya.  
\q1
\v 1 Yawé, neniuki keneu'eni,  
\q2 kenemɨtiutatsuaka.   
\q1
\v 2 Kenemaine, neti'aitɨwame meta nekakaɨyari kenene'enieka,  
\q2 'ekɨ xeikɨa nepɨmatsiwawirie.   
\q1
\v 3 Yawé, ximeri paitɨ pepɨnetsi'enie,  
\q2 ximeri paitɨ nepɨmatiwawirie,  
\q2 kepauka pepɨnetsita'eiya nepɨta'ikwewa.   
\b  
\q1
\v 4 'Ekɨ Kakaɨyari pepɨkahɨkɨ 'axamɨti'anekɨ muyutemawie,  
\q2 'ahamatɨa mepɨkayɨwawe memuyuxewiriyani 'axamemɨte'u'iyari.   
\q1
\v 5 'Ahɨxie memɨti'uni mepɨkayɨwawe mamariwawemete memɨyu'erie,  
\q2 pekaniwaxani'erieka 'axamemɨteyurie.   
\q1
\v 6 Memɨte'itawa pepɨwaka'una  
\q2 Yawé, pepɨwa'uxie teyukwamanamete meta memɨteyumemiwa.   
\b  
\q1
\v 7 Peru ne, nepɨyɨwe 'akiita  
\q2 nemeutahani 'anaki'eriya mɨmariwekɨ,  
\q1 'atuki mɨpatsieta nepɨyɨwe  
\q2 nemɨkatunumakeni.   
\b  
\q1
\v 8 Yawé, yuwaɨkawatɨ memɨnetsi'aye'uniekɨ,  
\q2 'aixɨa mɨti'anetsie keneneuwitɨximeni,  
\q2 'ahuyeta keneneparewieka.   
\b  
\q1
\v 9 Kememutiyuane yurikɨ mepɨkatekuxata,  
\q2 yutaɨta 'axati'aneme mepɨtehexeiya,  
\q1 wateta mɨki teukiyapa pɨhɨkɨ reutenitɨ,  
\q2 yunenikɨ mepɨteyu'itaiya.   
\b  
\q1
\v 10 Keniwaranutaxɨri, Kakaɨyari,  
\q2 kememɨteyukɨhɨawekɨ mɨkɨkɨ mekeheyukaxɨrieni.  
\q1 Pepɨkawanaki'erieka yuwaɨkawa memuwarukwikɨ,  
\q2 mematsi'aye'unietɨ memakɨkɨ.   
\b  
\q1
\v 11 Peru 'ahetsɨa memuyu'awieta mekeyutemamawieka,  
\q2 meke'utikwikani kwikari 'aixɨa manuyɨtɨka.  
\q1 Waɨkawa keniwa'ɨwiyani memuyuwaɨriya,  
\q2 yunaitɨ memɨmatsinaki'erie.   
\q1
\v 12 'Ekɨ Yawé 'aixɨa pepɨwayurie yamemɨtekahu,  
\q2 kuya muyukunarɨma pehɨkɨtɨtɨ pepɨwareutinama mɨpaɨ mɨmatinakekɨ.   
\c 6  
\d Teyuitɨwamete wa'ukiyari. 'Ikɨ kanari 'atahaikatɨ mawɨtsie ke'utakwikarieni. Rawiri nɨawarieya.  
\q1
\v 1 Yawé, pepɨkanetsi'utate'ani peha'atɨ,  
\q2 pepɨkanetikwinitɨaka 'ahaxɨakɨ.   
\q1
\v 2 Yawé kenenenenimayaka nepɨmɨximeri,  
\q2 Yawé 'aixɨa kenetineuka'eritɨa netaɨta nepeuhaɨtɨ.   
\q1
\v 3 Ne'iyari waɨkawa pɨyumuina,  
\q2 ¿kepaukake tamɨ Yawé pepɨnetsiparewieni?   
\b  
\q1
\v 4 Yawé, kenenua tukari keneneupitɨa,  
\q2 keneneutawikweitsitɨa 'anaki'eriyakɨ.   
\q1
\v 5 Mɨkitɨ pɨkayɨwe mɨmatsihaye'erienikɨ,  
\q2 'ukateukieme, ¿kemɨ'ane pɨmatsitanɨawa?   
\b  
\q1
\v 6 Tsuarikɨ nepu'uxeri tɨkarikɨ,  
\q2 ne'itari ne'ukaikɨ pɨyuyuna,  
\q2 ne'utá ne'ukaikɨ nepɨhawiya.   
\q1
\v 7 Nehɨxite pɨkaheuniereri netiukakukuinetɨ,  
\q2 pukwixime memɨnetsi'aye'unie ya'ane mewiwiekaku.   
\b  
\q1
\v 8 Nehamatɨa xepɨka'u'uwani yunaitɨ 'axaxemɨte'u'iyari,  
\q2 Yawé nehiwerika kaniu'enieni.   
\q1
\v 9 Yawé pu'enaxɨ kenemɨtitawawiri,  
\q2 Nenenewieri Yawé pu'eni.   
\q1
\v 10 Yunaitɨ memɨnetsi'aye'unie mekaniyutitetewiyakuni meta mekani'iyɨriekuni,  
\q2 kwitɨwa mepuyuta'una meyutetewiyatɨ.   
\c 7  
\d Rawiri yuhiwerietɨ Yawé kemɨtiutahɨawixɨ Kutsi Wenikamini tewiyari hepaɨtsita.  
\q1
\v 1 Keneneutawikweitsitɨa, Yawé nekakaɨyari, 'ahetsɨa nemɨneti'awiwietakɨ.  
\q2 Nehetsie keneutanua yunaime memɨnetsi'uweiya wahepaɨtsita.   
\q1
\v 2 Xɨka mɨpaɨ pekatiuyurieni, mekanenitakwaikuni mayetsi wahepaɨ,  
\q2 mekanenitatsanakuni, xewitu nehetsie pɨkatanuani.   
\b  
\q1
\v 3 Yawé nekakaɨyari, ¿kekuta netiuyuri?,  
\q2 ¿ketitakɨ 'axanetiuyuri?   
\q1
\v 4 Xɨka nehamiku 'axane'uyurieni,  
\q2 xɨka netikuhɨwirieni kemɨ'ane mɨnetikwinitɨa,   
\q1
\v 5 kamɨtsɨ mɨnetsi'aye'unie kenetsi'anukuweiya kenetsi'anuku'axe,  
\q2 kwiepa kenetsi'ukahɨani  
\q2 meta tsepari tixaɨtɨ mɨkanerayeitɨa.   
\b  
\q1
\v 6 Yawé, keneuyeha'a,  
\q2 memɨnetsi'aye'unie kememɨteha'a wahepaɨtsita.  
\q1 Kakaɨyari, 'aixɨa ketineuyuri kenenaye'eri.   
\q1
\v 7 'A'aurie teɨteri mekeyukuxeɨrieni,  
\q2 pemɨtita'aitakɨ mɨkɨ watsata 'ameutitewatsie.   
\q1
\v 8 'Ekɨ, Yawé, teɨteri wa'itsɨkame pepɨhɨkɨ.  
\b  
\q1 Nehetsieta yaketineuyuri heitseriemekɨ kenemɨtiuyeikakɨ,  
\q2 yakenetinakapitɨa kenemɨtiuyurikɨ.   
\q1
\v 9 Kakaɨyari heitserie pemexeiya, 'ekɨ pemɨtimate wa'iyari kemɨtiku'eriwa,  
\q2 ketineukumaweriya 'axateyuruwamete ke'axamemɨteyurie  
\q2 keneparewieka heitserie mexeiya.   
\b  
\q1
\v 10 Kakaɨyari nehetsie nunuwame pekanihɨkɨtɨni,  
\q2 'aixɨa memɨteyukɨhɨawe pekaniwawikweitsitɨaka.   
\q1
\v 11 Kakaɨyari 'itsɨkame 'aixɨa mɨtiuka'iyari kanihɨkɨtɨni,  
\q2 Kakaɨyari kaniwahekani 'axamemɨteyurie tukarikɨ.   
\q1
\v 12 Xɨka 'axamɨtiuka'iyari katiuhayewa,  
\q2 Kakaɨyari yu'ixipara kanikuha'aritɨamɨkɨ meta yutupi,   
\q1
\v 13 'ari mɨɨya kaniukuha'aritɨani,  
\q2 meta 'ɨrɨ tai mexeiya kaniukuha'arita.   
\b  
\q1
\v 14 Xekeneuxeiya 'axamɨtiuka'iyari:  
\q2 'Axamɨti'anekɨ kanitihukatamɨkɨ, 'itarika kanitiniwemɨkɨ.   
\q1
\v 15 'Aheukatewame kaniuti'ine,  
\q2 muwata kaneukawemɨkɨ.   
\q1
\v 16 Ke'axamɨtiyuriene yɨkɨmana katiniyukwinitɨamɨkɨ,  
\q2 mu'uyatsie kanikawemɨkɨ kemɨtiukananaima.   
\b  
\q1
\v 17 Yawé nepɨnɨawani 'aixɨa mɨtiuka'iyarikɨ.  
\q2 Yawé 'amutewi nepɨtemawieritɨani kwikarikɨ.   
\c 8  
\d Teyuitɨwamete wa'ukiyari. Kemanɨyɨne «Kaxie mɨpɨnarie» hepaɨ mɨpaɨ ketiukwikarieni. Rawiri nɨawarieya.  
\q1
\v 1 Yawé, tati'aitɨwame,  
\q2 pemɨmariwe naitsarie kwiepa.  
\q2 Muyuawi heima pemɨxawatɨriwie.   
\b  
\q1
\v 2 Memɨmetsi'aye'unie wahepaɨtsita  
\q2 pepɨtiuyuri wateta muwayenenikɨ memetsinɨawanikɨ  
\q1 tɨɨri 'etsimemutɨtɨ meta memɨtsitsewe,  
\q2 memɨmatsi'aye'unie meta memayu'eririya kayuwatɨ pemɨwapitɨanikɨ.   
\b  
\q1
\v 3 Kepauka muyuawi nemɨxeiya,  
\q2 'amamakɨ pemitawewi,  
\q1 metsa meta xurawetsixi mana pemɨwaruyeyatsaxɨ,   
\q1
\v 4 mɨpaɨ nepɨtineku'iwawiya:  
\q2 «¿Tewi tita tihɨkɨ, pemiku'eriwanikɨ?  
\q2 ¿Teɨteri tita metehɨkɨ, pemɨwa'eniekakɨ?»   
\q1
\v 5 'Etsiwatɨkaku 'ahepaɨ 'aneme peputawewi,  
\q2 pepenutikurunatɨa 'aixɨa mɨti'anekɨ:   
\q1
\v 6 mɨti'aitanikɨ pepipitɨa naime tita pemɨtiutawewitsie,  
\q2 naime pepɨtiyetuiri mɨtiwata'aitɨanikɨ,   
\q1
\v 7 muxatsi, tuurutsixi kwietsanamete,  
\q2 yunaime yeutari,   
\q1
\v 8 memɨte'awɨwawe, ketsɨte  
\q2 meta yunaime memɨtekuyuatɨka haramaratsie memɨteye'uwa.   
\b  
\q1
\v 9 Yawé, tati'aitɨwame,  
\q2 pepɨmariwe naitsarie kwiepa.   
\c 9  
\d Teyuitɨwamete wa'ukiyari. «Nunutsi kemɨtiumɨ» kemanɨyɨne mɨpaɨ ketiukwikarieni. Rawiri nɨawarieya.  
\q1
\v 1 Yawé, ne'iyarikɨ nepɨmatsitanɨawa,  
\q2 mariwemekɨ kepemɨtiyuriene naime netikuxatatɨ.   
\q1
\v 2 Nepɨnetemawieka 'ahetsie netiwiyatɨ,  
\q2 kwikari 'ahetsiemieme nekwikatɨ, 'aku 'Apemutewi.   
\b  
\q1
\v 3 Memɨnetsi'aye'unie mepukununuwa,  
\q2 mepekaxɨrɨwe meta mepɨtakukuwe 'ahɨxie.   
\q1
\v 4 'Ekɨ heitserie pemɨnetsi'upitɨakɨ, nehetsie pepunua,  
\q2 'ekɨ 'itsɨkame 'aixɨa pemɨtikuyuruwa, 'a'uwenitsie pepaka.   
\q1
\v 5 Kakaɨyari memɨkamate, pepɨwarutati, 'axamemɨte'u'iyari pepɨwaruka'unaxɨ,  
\q2 pepɨwarukumaweriyaxɨ yuheyemekɨ xewitɨ mɨkawara'eriwanikɨ.   
\q1
\v 6 'Uximatɨarika kaheu'akamekɨ memɨtatsi'aye'unie pepɨwarupitɨa,  
\q2 wakiekari pepuka'unaxɨ,  
\q2 xewitɨ pɨkawara'eriwari.   
\b  
\q1
\v 7 Yawé matsi yuheyemekɨ katini'aitametɨni,  
\q2 'aixɨa mɨtiyurienikɨ yu'uwenitsie kanakani.   
\q1
\v 8 Kwiepa memɨtama kaniwataxanetamɨkɨ kemɨtiheitseriekɨ,  
\q2 teɨteri katiniwata'aitɨamɨkɨ 'aixɨa 'anemekɨ.   
\q1
\v 9 Yawé, memɨnanaimarie waparewiwame kanihɨkɨtɨni,  
\q2 wahetsie nunuwame kanihɨkɨtɨni kepauka memɨte'uka'eniwa.   
\b  
\q1
\v 10 'Ahetsie yuri mepɨte'erie kemɨ'ane memɨmatsimate,  
\q2 'ekɨ, Yawé, pemɨkawaruku'e'eiriwakɨ kemɨ'ane memɨmatsikuwautɨwe.   
\b  
\q1
\v 11 Yawé kwikarikɨ xekenetemawieritɨaka, Tsiyuni hetsie ti'aitame,  
\q2 kemɨtiuyuri nuiwarite watsata xeketenekuxatani.   
\q1
\v 12 Wahetsie mɨkarahɨiwa wahetsie nunuwame kaniwara'eriwani,  
\q2 memɨ'uximatɨarie memehɨawe yapauka kaniwa'enieka.   
\b  
\q1
\v 13 Yawé, kenenenenimayaka,  
\q2 keneneuxeiya kememɨnete'uximatɨa memɨnetsiheka.  
\q1 Mɨki teukiyapa kenenatihani,   
\q2
\v 14 Kerutsareme kitenieyaritsie  
\q2 'akwikarikɨ nepɨmatsikuxatani, 'awikweitsitɨarikatsie nemɨnetemawiekɨ.   
\b  
\q1
\v 15 Kakaɨyari memɨkamate  
\q2 putsu memutiwewita mekaneukaxɨrieni,  
\q1 wa'ɨkate kaniutseixɨani  
\q2 winiyari yɨkɨmana memuti'awietakaitsie.   
\b  
\q1
\v 16 Yawé kanimatiwani 'aixɨa mɨtiuka'iyarikɨ,  
\q2 'axamɨtiuka'iyari yuwiniyaritsie kaniyukahɨpani.   
\b  
\q1
\v 17 Mɨki teukiyata mekaneukaxɨrɨweni 'axamemɨte'u'iyari,  
\q2 meta yunaitɨ Kakaɨyari mematɨtɨmaiya.   
\q1
\v 18 Perutsɨ kemɨ'ane mɨreuyehɨwa pɨkahatɨmaiyarieni yuheyemekɨ,  
\q2 tita mɨtitakwewie tixaɨtɨ mɨkarexeiya pepɨtiyetuirieni.   
\b  
\q1
\v 19 Yawé, yaketineuyuri.  
\q2 Tewi mɨrayu'iwanikɨ pepɨka'ipitɨaka,  
\q2 nuiwarite 'ahɨxie memɨti'unikɨ yaketineuyuri.   
\q1
\v 20 Yawé, marika keniwarupitɨa,  
\q2 kename tixaɨtɨ mekatehɨkɨ teɨteri mɨpaɨ meketehetimani.   
\c 10  
\q1
\v 1 ¿Yawé, titayari 'ateewa paitɨ petiuyeika?  
\q2 ¿Titayari kepauka temɨte'uka'eniwatsie petiu'ati'awiwieta?   
\q1
\v 2 Kwinimieme tiha'atɨ tiyumiekame mɨkayɨhɨawe kaniuweiyani,  
\q2 peru hatsuaku yuwiniyaritsie kaniyuhɨamɨkɨ.   
\q1
\v 3 'Axatiyuruwame tita mɨtihiwe'erie mariweme pɨrayeitɨwa,  
\q2 naime mɨtihiwe'erie hepaɨtsita 'aixɨa putaine Yawé xani'erietɨ.   
\q1
\v 4 'Axatiyuruwame teikɨ peneniere 'uyuta'ɨretɨ,  
\q2 'etsiwatɨma Kakaɨyari pɨkaku'eriwa.   
\q1
\v 5 Naitɨ 'uximayatsikayatsie 'aixɨa pɨtikuyɨne,  
\q2 peutiteewa meta peteewa hetsiena mieme 'a'aitsika metimanikɨ,  
\q2 pɨwananaima kemɨ'ane mɨwaraye'unie.   
\q1
\v 6 Mɨpaɨ katiniyukɨhɨaweni: «Nitixaɨtɨ pɨkanerekahɨani.  
\q2 Yanetinetemawietɨ 'anepuyeikani. Hatsuaku 'uximatɨarika nepɨkahekaxeiya».   
\q1
\v 7 'Axaniuki tetana kanihɨneni,  
\q2 'itarika meta tierika,  
\q2 yunenitɨa katini'awietani 'axamɨti'ane meta nanaimarika.   
\q1
\v 8 Kaniutihupani kiekari 'etsimɨyeyeutsie,  
\q2 kaniuyuti'awiwietani mɨwakwinikɨ hipame,  
\q2 kaniwatakukuyani 'atsimemɨkateyurie 'atsimemɨkayɨa.   
\q1
\v 9 Maye hepaɨ terɨta payehupu  
\q2 mɨkayɨhɨawe hupietɨ 'iwiyake,  
\q2 heimana 'uweme yuwiniyaritsie kanihanimɨkɨ.   
\q1
\v 10 Waɨkawa mɨtɨrɨkaɨyekɨ  
\q2 'imierimama kwiepa menatixɨrɨweni.   
\q1
\v 11 Mɨpaɨ kaniutaineni yuxaɨta: «Kakaɨyari pɨkawara'eriwa teɨteri.  
\q2 Yuhɨxie kaneuyukunaka, tixaɨtɨ pɨkatixeiya».   
\b  
\q1
\v 12 Xeiya, Yawé.  
\q2 Kakaɨyari, ketaneuparewi.  
\q2 Memɨkayuhɨawawe pepɨkawaratɨtɨmaiyani.   
\q1
\v 13 'Axapɨmatikumamateke 'axatiyuruwame.  
\q2 Mɨpaɨ pɨtiku'eriwa kename 'atsipeka'iyurieni.   
\q1
\v 14 'Ekɨ pepɨniere ketemɨte'uximatɨarie meta ketemɨtenanaimarie, 'ekɨ pepɨkaratɨmaiya  
\q2 'aixɨa pepɨtiyurieni mɨkɨ hepaɨtsita.  
\q1 Mɨyamemɨte'anuyehu matsi 'ahetsie mekaneuwaɨreni,  
\q2 'ekɨ pepɨhɨkɨ nutuite waparewiwame.   
\q1
\v 15 'Axamɨtiuka'iyari tɨrɨkariyaya keneunawairi meta Kakaɨyari mɨka'ayexeiya.  
\q2 Ke'axamemɨteyurie yaketiniwarakapitɨa,  
\q2 meta keniwarukumaweriya yunaime.   
\b  
\q1
\v 16 Yawé ti'aitame kanihɨkɨtɨni yuheyemekɨ,  
\q2 matsi 'iya memɨkametsimate mepeuyehɨiyani yukwietsie.   
\b  
\q1
\v 17 'Ekɨ, Yawé, haweri memɨyɨa wanenewieri pepɨ'enie,  
\q2 pepɨwatɨrɨkariya meta kememɨmatewawirie pepɨraye'atɨwa.   
\q1
\v 18 'Ekɨ nutuite meta memɨte'uka'eniwa wahetsie pepɨnua,  
\q2 tewi kwiekɨ mɨwewiya,  
\q2 'axamɨti'ane mɨkati'enenikɨri.   
\c 11  
\d Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya.  
\q1
\v 1 Yawé hetsie nepɨne'awieta.  
\q2 ¿Titayari mɨpaɨ xenetehahɨawe:  
\q2 «Keneuyuta'una 'ɨtsita, wikixi wahepaɨ»?   
\q1
\v 2 Xekeniwaruxeiya kehepaɨ yutupi memɨtehawɨwɨtɨwa 'axateyuruwamete:  
\q2 yutupi kaunariyaritsie mekanika'uitɨwani 'ɨrɨ,  
\q2 'aixɨa memɨte'u'iyari mewatamɨnike  
\q2 'awie paitɨ metitetɨ.   
\q1
\v 3 Xɨka tsutɨmeyari 'uka'unarieni,  
\q2 ¿tewi 'aixɨa mɨtiuka'iyari ketiuyuriwe?   
\b  
\q1
\v 4 Yawé yutuki muyepatsieta kanayekani,  
\q2 muyuawitsie Yawé yu'uweni kanexeiyani,  
\q1 kayuwatɨ xeikɨa tewi kwikanitaxeiyani,  
\q2 kanixeiyani kemɨtiyuriene.   
\q1
\v 5 Yawé kaniwaxeiyani kememɨteyurie 'aixɨa memɨte'u'iyari meta 'axateyuruwamete,  
\q2 kaniwa'uxiwe'erieka kemɨ'ane memɨteyukananaima.   
\q1
\v 6 'Axamemɨte'u'iyari wahetsie tɨɨ wiyeriyari kananɨ'amɨkɨ  
\q2 meta tai kanikawiwimɨkɨ,  
\q2 'eka kwinimieme tixɨkatɨ kaniku'ekamɨkɨ, mɨkɨ wa'iwarika kanayeimɨkɨ.   
\b  
\q1
\v 7 'Aixɨa katiniuka'iyarini Yawé, 'aixɨa mɨti'ane katininaki'erieka,  
\q2 'ayumieme heitserie memexeiya mepixeiya kemɨraka'erie.   
\c 12  
\d Teyuitɨwamete wa'ukiyari. Kanari 'atahaikatɨ mawɨkɨ ke'utakwikarieni. Rawiri nɨawarieya.  
\q1
\v 1 Yawé ketaneutawikweitsitɨa, teɨteri 'aixɨa memɨtekahu mepumaweri,  
\q2 mepumaweri 'ena kwiepa teɨteri heitseriemekɨ memu'uwa.   
\q1
\v 2 Meteyu'itaiyatɨwetɨ xeikɨa 'amekaniu'uwani yunaitɨ,  
\q2 'aixɨa mete'uxaxatatɨtɨ kwitɨwata 'axamekaniutiyuaneni.   
\b  
\q1
\v 3 Yawé, 'ekɨ mɨkɨ teɨteri pepɨwareuyehɨani  
\q2 memɨte'itawa meta memɨteyukananaima,   
\q1
\v 4 mɨpaɨ memutiyuane: «Taniukikɨ tekatenayu'iwakuni,  
\q2 tanenikɨ xeikɨa tekaneuta'ɨka.  
\q2 Nixewitɨ tame pɨkatatsikema».   
\b  
\q1
\v 5 Yawé mɨpaɨ kanaineni: «Hikɨ nekananukukemɨkɨ,  
\q2 memɨ'uximatɨarie nekaniwatawikweitsitɨamɨkɨ,  
\q1 tixaɨtɨ mɨkarexeiya mɨnanaimariekɨ,  
\q2 mɨreuyehɨwa mɨtiuka'eniwakɨ».   
\b  
\q1
\v 6 Yawé niukieya kani'itiyaka,  
\q2 pɨrata 'aixɨa mɨ'itɨarie hepaɨ pɨ'ane,  
\q2 tepɨa 'aixɨa mɨwati'itɨariwatsie 'atahutamexɨa kanikwaxiyarieka.   
\b  
\q1
\v 7 Yawé, 'ekɨ pepɨtatsi'ɨwiyani  
\q2 'ekɨ yuheyemekɨ tahetsie pepɨnuaka 'ikɨ teɨteri mɨyamemɨtatsiyuriekɨ,   
\q1
\v 8 tsepa 'axamemɨte'u'iyari kwiepa meyuwaɨkatɨ memɨxuawe,  
\q2 tsepa 'axamɨti'ane waɨkawa mɨtitamɨirirɨme.   
\c 13  
\d Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya.  
\q1
\v 1 Yawé, ¿kepaukake pepɨnetsihaye'erieni?  
\q2 ¿Kepaukake pepɨnetsi'anu'enieni?   
\q1
\v 2 ¿Kepaukake nepɨka'uximatɨarieka  
\q2 meta ne'iyari pɨkanetsi'ukukuineni?  
\q1 ¿Kepaukake mɨnetsi'aye'unie pɨtihayewa neti'aitɨatɨ?   
\b  
\q1
\v 3 Yawé nekakaɨyari,  
\q2 keneneuxeiya keneneuta'eiya,  
\q2 keneneupitɨa neheuniereme kenenayeitɨa.  
\q1 Mɨpaɨ netukari nepɨkaheuyehɨani,   
\q2
\v 4 mɨpaɨ 'ana mɨnetsi'aye'unie: «Nepe'iwaxɨ», pɨkatayɨni,  
\q2 pɨkayutemawiekari mɨkanetsi'atihɨanikɨ.   
\b  
\q1
\v 5 Ne 'anaki'eriya mɨmariwetsie nepɨtiwiya,  
\q2 ne'iyari puyutemawie 'awikweitsitɨarikakɨ.   
\q1
\v 6 Nepikwika nɨawari Yawé hetsiemieme.  
\q2 Yawé nehetsiemieme 'aixɨa pɨtiuka'iyari.   
\c 14  
\r (Nɨa 14:1-7 – Nɨa 53:1-6)  
\d Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya.  
\q1
\v 1 'Atsimɨkatimate yu'iyaritsie mɨpaɨ kaniutaineni:  
\q2 «Kakaɨyari pumawe».  
\q1 Mɨkɨ mepɨtipɨnirɨme, xani'eriwamekɨ yameteyurietɨ.  
\q2 Xewitɨtɨma pɨka'uyeika 'aixɨa tiyurienetɨ.   
\b  
\q1
\v 2 Muyuawitsie paitɨ Yawé teɨteri kaniwataxeiyani,  
\q2 pɨtaniere xewitɨ 'aku kapuyeika  
\q2 timaiwetɨ Kakaɨyari kuwaunetɨ.   
\q1
\v 3 Yunaitɨ mepeuyexɨri,  
\q2 nixewitɨ pɨkayuhayewaxɨ.  
\q1 Xewitɨ tɨma 'apɨka'uyeika 'aixɨa tiyurienetɨ,  
\q2 nixewitɨ pɨka'uyeikatɨma.   
\b  
\q1
\v 4 ¿Kamɨtsɨ 'atsimekatemate yunaitɨ 'axamemɨteyurie,  
\q2 neteɨterima memɨwakwa'a paa memɨhɨkɨtɨni hepaɨ?  
\q2 Hatsuaku Yawé mepɨkahahɨaweni.   
\q1
\v 5 Mana mekaniwamariutani xeikɨa,  
\q2 peru Kakaɨyari heitserie memexeiya kaniwaparewieka.   
\b  
\q1
\v 6 Xeme tixaɨtɨ memɨkatehexeiya kememɨteyukɨhɨawe xemɨtewakwatsirie,  
\q2 peru Yawé wahetsie kaninuaka.   
\b  
\q1
\v 7 Kakaɨyari mɨpaɨ mɨtina'eriwanike  
\q2 Kerutsareme hetsiemieme wikweitsitɨarika mɨnanɨ'ani.  
\q1 Kepauka Yawé yuteɨterima mɨwatawikweitsitɨani,  
\q2 'ana 'ixaheritsixi yunaitɨ mekaniyukatemamawiekuni.   
\c 15  
\d Rawiri nɨawarieya.  
\q1
\v 1 Yawé, ¿kemɨ'ane 'atukita payeyerɨwe?  
\q2 ¿Kemɨ'ane 'ahɨri mɨpatsietsie puyutakiitɨawe?   
\q1
\v 2 Hetsiena mɨkarahɨiwa xeikɨa kaniyɨweni,  
\q2 'aixɨa mɨtiyuriene  
\q2 yu'iyarikɨ yurikɨ mɨtikuxata,   
\q1
\v 3 yuniukikɨ hipame mɨkawarekaxɨrɨwa,  
\q2 yu'aurie kiekame 'axamɨkatikuxaxatɨwa,  
\q2 yuhepaɨtewi 'axamɨkayurie,   
\q1
\v 4 kemɨ'ane Kakaɨyari muwa'uxie mɨkawanaki'erie,  
\q2 peru mɨwanaki'erie Yawé memayemakaxe,  
\q1 mɨraye'atɨwa kemɨtayɨni  
\q2 tsepa tiuka'eniwatɨ,   
\q1
\v 5 kemɨ'ane tumini mɨtiyuniniɨtɨwa mɨrana'iwakɨ kayɨanetɨ,  
\q2 kemɨ'ane mɨka'inake tumini mɨtanaki'erienikɨ 'aixɨa mɨtiuka'iyari mɨnanaimanikɨ.  
\b  
\q1 Kemɨ'ane 'ipaɨ mɨtiuyeika yuheyemekɨ 'apuweni kawatayuitɨariwatɨ.   
\c 16  
\d Rawiri kwikarieya.  
\q1
\v 1 Kakaɨyari kenene'ɨwiyani, 'ahetsie xeikɨa nemɨne'awietakɨ.   
\b  
\q1
\v 2 Ne Yawé mɨpaɨ nepɨmarahɨawe: «'Ekɨ pepɨnekakaɨyari.  
\q2 Nexaɨta nepɨkayɨwe, 'ahetsie xeikɨa netiwiyatɨ 'aixɨa ti'aneme nepɨrexeiya».   
\q1
\v 3 Kwiepa miemete memɨpatsie,  
\q2 memɨmamariwawe wahetsie nepɨnetemawie.   
\q1
\v 4 Peru kemɨ'ane kakaɨyarixi memuwarayexeiyani  
\q2 waɨkawa mepɨtekwineni.  
\q1 Ne hatsuaku newarayexeiyatɨ nepɨka'ayani wakakaɨyarixi meta mawari nepɨkawawewirieni,  
\q2 meta kememɨtetetewa nepɨkawakuxatani.   
\b  
\q1
\v 5 'Ekɨ, Yawé, ne'ikwai pekanihɨkɨtɨni meta tita nemɨti'ie,  
\q2 'ekɨ yapekatinimaika kemɨnetiyurieni netukari hepaɨtsita.   
\q1
\v 6 Witsimɨraku'anetsie nepɨnehayewaxɨ yarainekaku,  
\q2 'imikieri witsiti'anetɨ nehetsie pɨtiunakixɨ.   
\b  
\q1
\v 7 Yawé hepaɨtsita 'aixɨa nepaineni mɨneti'ɨkitɨakɨ,  
\q2 tɨkarikɨ pɨnetsihayehɨtɨwa ne'eriwametsie.   
\q1
\v 8 Ne Yawé neheyemekɨ yanepɨranuyeyetsa,  
\q2 mɨkɨ netserieta 'utiwekaku, xewitɨ pɨkanetsi'atihɨani.   
\b  
\q1
\v 9 'Ayumieme ne'iyaritsie nepuyutemawie,  
\q2 netaɨta naitɨ nepuyutemawie,  
\q2 'ayumieme ne'iyarikɨ yuri neti'erietɨ 'anepuyeika.   
\q1
\v 10 'Ekɨ pepɨkanetsiku'eirieni mɨkite wateukiyapa,  
\q2 'ekɨ pepɨkanetsipitɨani nemɨtapɨnekɨ 'aparewiwame yanemɨtikamie.   
\q1
\v 11 Pepɨnetsi'uxeitsitɨa huye tukari nemexeiyanikɨ,  
\q2 waɨkawa pepɨnetsihetemawieritɨani kepauka 'ahɨxie nemeta'ani,  
\q2 'atserieta meta yuheyemekɨ yanepɨreyutemawieka.   
\c 17  
\d Rawiri nenewierieya.  
\q1
\v 1 Yawé, heitseriekamekɨ kenemetiwawirie keneu'eni,  
\q2 nehiwari keneu'eni keneneuparewi,  
\q1 nenenewieri kwi keneu'eni,  
\q2 ne neti'itawatɨ nepɨka'utaine.   
\q1
\v 2 Nehetsie nunuwame kenehɨkɨtɨni 'ekɨ,  
\q2 'ekɨ pemɨtimatekɨ tita mɨtiheitserie.   
\b  
\q1
\v 3 'Ekɨ ne'iyari pepɨmate,  
\q2 'ekɨ tɨkarikɨ pepɨnetsixeiya,  
\q1 tsiparatsɨ keneneuta'inɨata,  
\q2 nehetsie 'axamɨ'ane pepɨkakaxeiya.  
\b  
\q1 Ne 'axanepɨkatayɨni   
\q2
\v 4 hipatɨ teɨteri kememɨte'uniuka wahepaɨ,  
\q2 netsɨ 'aniuki nekanaye'atɨaka.  
\q1 Teɨteri memɨteyukananaima wahuye nepɨka'uweiya   
\q2
\v 5 ne nepɨkawa'ɨke nepɨne'ɨwiya,  
\q2 'ahuye 'etsimatayeyeu 'utɨma nepumie nekahekawautsetɨ.   
\b  
\q1
\v 6 Kakaɨyari 'aku, 'ekɨ xeikɨa nepɨmatsihahiwiwa, 'ekɨ pemɨnetsiku'eiyakɨ,  
\q2 'ahurawa keneneu'eni pemi'enienikɨ nenenewieri.   
\q1
\v 7 'Ekɨ, 'atɨrɨkariyakɨ pemɨwawikweitsitɨawe,  
\q2 kemɨ'ane memuyu'unarɨme memɨwaraye'unie mewaruweiyakaku,  
\q2 'inɨari yakenetineuxeitsitɨa waɨkawa kepemɨti'akanaki'erie.   
\q1
\v 8 Kenene'ɨwiyani 'ahɨxi hixɨapa mɨyeka pemɨti'ɨwiya hepaɨ,  
\q2 kenene'awietani, wakana yu'anatɨa yuniwema mɨtiwa'ɨwiya hepaɨ,   
\q1
\v 9 kenene'awietani 'axateyuruwamete memɨnetsimietɨwekɨ,  
\q2 memɨnetsi'aye'unie newarita mematetɨkakɨ.   
\q1
\v 10 Yu'iyaritsie xeikɨa mepɨteheunama,  
\q2 'axamekatenikuxatani hipame mewa'iwakutɨ xeikɨa.   
\q1
\v 11 'Ahurawa xeikɨa mekanenita'ɨwiyani kenemɨtiyuriene,  
\q2 mekanenihupieka menetsimiekutɨ.   
\q1
\v 12 Mayetsi memɨtehupa hepaɨ mekani'aneneni,  
\q2 mayetsi yuwai memɨtetahupie hepaɨ.   
\b  
\q1
\v 13 Hikɨmɨ, Yawé, 'ekɨta wahɨxie keneukexi.  
\q2 Keniwara'iwa.  
\q2 'A'ixiparakɨ keneneutawikweitsitɨa 'axateyuruwamete memɨnetsi'uweiyakɨ.   
\q1
\v 14 Yawé, 'atɨrɨkariyakɨ keneneutawikweitsitɨa 'ikɨ teɨteri memɨkwiwawe mepɨnetsi'uweiya,  
\q2 yutukari memumikie 'ena kwiepa pɨmieme xeikɨa.  
\b  
\q1 Kwinie mɨraye'atɨkakɨ xeikɨa pepɨwarutihɨniyaxɨ,  
\q2 waniwema waɨkawa metehexeiyatɨ mepakɨ,  
\q2 wanuiwarima wahetsiemieme paitɨ pɨranayuhayewaxɨ.   
\q1
\v 15 Peru ne matsi heitseriekamekɨ 'ahɨxie nepumatsihexeiya.  
\q2 'Ahɨxie kepauka nemanutaniere nematsihexeiyatsie mɨkɨkɨri ne'iyari 'aixɨa peyɨni.   
\c 18  
\r (Nɨa 18:Tít.-50 – 2 Tsam 22:1-51)  
\d Teyuitɨwamete wa'ukiyari. Rawiri kwikarieya, Tsahuri heye'uniekaku meta yunaitɨ memeye'uniekai me'ikuweiyatɨwekaku. Yawé Rawiri kemɨtiutawikweitsitɨa. 'Ana mɨpaɨ kaniutayɨni:  
\q1
\v 1 Yawé, yuheyemekɨ nepɨmatsinaki'erie, 'ekɨ pepɨnetɨrɨkariya.   
\b  
\q1
\v 2 Yawé 'ai hepaɨ kani'aneni, mɨnetsikunama, mɨnetsiwikweitsitɨa,  
\q2 nekakaɨyari kanihɨkɨtɨni, 'ai 'amutitɨtɨ taɨta mɨnetsi'awieta.  
\q1 Nehetsie kaninunuwametɨni, tɨrɨkaɨyemekɨ mɨnetsiwikweitsitɨa,  
\q2 mɨkɨ 'ateewa paitɨ pɨnetsi'awieta.   
\q1
\v 3 Yawé nepahɨawe, meuyewetse mɨnɨawariekakɨ,  
\q2 memɨnetsi'aye'unie wahetsɨa pɨnetsihayeha.   
\b  
\q1
\v 4 Mɨki winiyariyaritsie nepunexei nehɨatɨ,  
\q2 haa kwinimieme mɨtiwakuxikɨriwatsie mekaneneukahɨpani.   
\q1
\v 5 Kaunarikɨ kaneniutahɨani nemɨkateukienikɨ,  
\q2 mɨki winiyariyaritsie nekaniunexeiya.   
\q1
\v 6 Ne'uximatɨarietɨ Yawé nekaniutahɨawe,  
\q2 nekakaɨyari nekaniutahiwieni,  
\q1 mɨkɨ yutukita paitɨ kaneniu'enieni,  
\q2 nehiwari nakatana paitɨ katiniunake.   
\b  
\q1
\v 7 Kwie naitɨ kaniutayuani kaniuta'une,  
\q2 kaniwatayuaxɨani hɨri tsutɨmeyarite,  
\q2 Kakaɨyari haxɨayakɨ kanewatayuaxɨani.   
\q1
\v 8 Tsuritana kɨtsi kanewakaneikakaitɨni,  
\q2 tetanata tai watixɨtsitɨwatɨ,  
\q2 tɨɨ xawawatɨme kaniwayenenetɨwakaitɨni.   
\b  
\q1
\v 9 Muyuawi hanutayepieka niwakayani,  
\q2 hai yɨyɨwimetsie 'akiekatɨ.   
\q1
\v 10 Xeime yuteɨtametsie 'akaitɨ, muyuawitsie xuruku kaniutawewieni  
\q2 'eka 'anayatsie 'akaitɨ kaneyani.   
\q1
\v 11 Yɨwita kaneuyuka'awieta,  
\q2 hai yɨyɨwimetsata hakɨkɨ  
\q2 naitɨ nanukanakaitɨni.   
\q1
\v 12 Kwinimieme mɨtixawatɨkaikɨ hai niukaxɨrieni,  
\q2 tee meta tɨɨ tatɨkaitɨ.   
\b  
\q1
\v 13 Muyuawitsie, tee meta tɨɨ tatɨkaitɨ kaxɨrɨwekaku,  
\q2 Yawé niukieya kanayu'eniɨriɨkɨre tɨranari hepaɨ,  
\q2 'Amutewi niukieya waɨkawa kanayu'eniɨriɨkɨre.   
\q1
\v 14 Yu'ɨrɨkɨ kaniwarutamɨni, mimierɨkari mɨmamariwawe,  
\q2 memɨnetsi'aye'unie kaniwarutaweiya, kaniwarutinautsitɨani.   
\q1
\v 15 Yawé, pemɨtiuyutatikɨ,  
\q2 'ahaxɨa 'iiyarikɨ,  
\q1 haramara mayema kananatihekɨare,  
\q2 kanahekɨare kwie tsutɨmeyari mituikatɨka.   
\b  
\q1
\v 16 Yumamá 'ameutitewatsie paitɨ kanakatsera,  
\q2 nemamatsie kanikawiere kanenewatihana haramara meukatewatsie.   
\q1
\v 17 Kaneniuxɨna mɨnetsi'aye'unie mɨtɨrɨkaɨye hetsɨa,  
\q2 meta memɨnetsixani'eriekai wahetsɨa,  
\q2 matsi mɨkɨ mepɨtɨrɨkawikai ne kenemɨkatitɨrɨkaɨye.   
\q1
\v 18 Kepauka nemekawe mekaneniutamieni,  
\q2 matsi Yawé netsiparewiwame kanayani.   
\q1
\v 19 'Amakuyewatsie kaneni'atɨani,  
\q2 kaneniutawikweitsitɨani netsinaki'erietɨ.   
\b  
\q1
\v 20 Yawé kanetinakapitɨani heitseriekamekɨ kenemɨtiyuriene,  
\q2 yakanetiniuta'iwitsitɨani nemamakɨ 'axanemɨkatiuyurikɨ.   
\q1
\v 21 Yawé huyeyatsie xeikɨa nemumiekɨ,  
\q2 hawaikɨ 'axanemɨkareyurienekɨ  
\q2 nekakaɨyari nemɨkaku'eiriwekɨ.   
\q1
\v 22 Titakɨ mɨneranutahɨani naime nepɨtimate,  
\q2 'aitsikaya nepɨkahatɨtɨmaiya.   
\q1
\v 23 Hamatɨana 'aixɨa nepɨtiuyeika  
\q2 nepɨkanewaɨriya 'axanemɨtiyurienenikɨ.   
\q1
\v 24 Yawé kanetiniyetuirieni heitseriekamekɨ kenemɨtiuyeika,  
\q2 nemamakɨ ke'axanemɨkatiyuriene.   
\b  
\q1
\v 25 'Ekɨ 'aixɨa pepɨtiuka'iyari kemɨ'ane 'aixɨa mɨtiuka'iyari hamatɨa,  
\q2 'aixɨa 'anemekɨ pepɨwanenimaya kemɨ'ane 'aixɨa memɨte'u'uwa,   
\q1
\v 26 kayuwatɨ pepuyeika kemɨ'ane kayuwatɨ muyeika hamatɨa,  
\q2 peru kemɨ'ane mutiuyukananaima hamatɨa petimaiwetɨ pepuyeika.   
\q1
\v 27 Kemɨ'ane tixaɨtɨ memɨkate'ayuyeitɨa pepɨwapitɨa memɨte'ayu'iwanikɨ,  
\q2 peru kemɨ'ane memɨte'uyukatawe'erie tixaɨtɨ pepɨkatiwarayeitɨwa.   
\q1
\v 28 Yawé, 'ekɨ nekɨxeme takame pepɨnetsihayewirie,  
\q2 'ekɨ nekakaɨyari, neyɨriya pepɨhekɨariwiya.   
\q1
\v 29 'Ekɨ penetsiparewiekaku hipame kuyaxi nepɨwatakwini,  
\q2 nekakaɨyari, hamatɨa kiekari kuraruyarita nemeukahani nepɨyɨwe.   
\b  
\q1
\v 30 Kakaɨyari huyeya pɨheitserie,  
\q2 Yawé niukieya kani'itiyaka.  
\q2 Kakaɨyari kuya tepɨaya kanihɨkɨtɨni kemɨ'ane mana memuyu'awieta wahetsiemieme.   
\q1
\v 31 ¿Kemɨ'ane Kakaɨyari pɨhɨkɨ, Yawé xeikɨa kanihɨkɨtɨni?  
\q2 ¿Kemɨ'ane tete pɨhɨkɨ, takakaɨyari xeikɨa kanihɨkɨtɨni?   
\q1
\v 32 Mɨkɨ netɨrɨkariya kanayeikani  
\q2 nehuye mɨheitseritɨa,   
\q1
\v 33 ne'ɨkate maxa 'ɨkateya kanayeitɨwani,  
\q2 meta kepauka 'ateewa nemakakanitsie pɨkanetsipitɨa nemanakawenikɨ,   
\q1
\v 34 pɨneti'ɨkitɨa nemeyutamiewenikɨ,  
\q2 nemamate pɨtɨrɨrikaya purunitse tupiyari nemahapananikɨ.   
\q1
\v 35 'Ekɨ 'atepɨakɨ pepɨnetsiwikweitsitɨa,  
\q2 'atseriekɨ pepɨnetsiwiya,  
\q2 'aixɨa pemɨtiuka'iyarikɨ neputawikwewe.   
\q1
\v 36 Huyeta 'aixɨa pɨtiyurie xeiya nemumienikɨ,  
\q2 nemɨkahetiketamɨrikenikɨ.   
\b  
\q1
\v 37 Nepɨwaranukuwei memɨnetsi'aye'unie, nepɨwaranuku'axixɨ,  
\q2 ne nepɨkahewake yunaime newarakumaweriyakake.   
\q1
\v 38 Nepɨwaretipɨnaxɨ. Tawari mepɨkahanuku'ui.  
\q2 Nehetɨa mekanekaxɨrieni.   
\q1
\v 39 'Ekɨ tɨrɨkariya pepɨnetsi'upitɨa nemɨnetamienikɨ,  
\q2 nehetɨa 'axamemɨte'u'iyari pekaniwati'uitɨani.   
\q1
\v 40 Memɨnetsi'aye'unie memɨkaxɨrienikɨ yapekatiniuyurieni,  
\q2 neta mɨpaɨ nekatiniwareuyehɨani memɨnetsi'uxiekai.   
\q1
\v 41 Parewiya mepuku'iwawakai, xewitɨ mɨwatawikweitsitɨanikɨ pɨka'utine.  
\q2 Yawé meputahiwi, matsi mɨkɨ pɨkawaruta'ei.   
\q1
\v 42 Nepɨwarutitɨxixɨ. Tumuanari hepaɨ mepɨteyuxexeiyakai 'eka mei'enitsitɨwa.  
\q2 Nepɨwarutiketsi haxu hepaɨ huyeta mɨtika.   
\b  
\q1
\v 43 Memɨnetsi 'uximatɨakai wahetsɨa pepɨnetsi 'ɨxɨnaxɨ,  
\q2 hikɨ matsi hipame nuiwarite wayeta pepɨnetsikake,  
\q2 hikɨ mepɨnetsi'ayexeiya teɨteri nemɨkawamatekai.   
\q1
\v 44 Yapauka menetsi'enietɨ, mepuyuyetuayakai nehetsɨa,  
\q2 teewatari mepɨyɨa, mɨyatɨtɨ nehɨxie mepanakatutsire.   
\q1
\v 45 Mɨkɨ nemɨkawamate meputimamawe,  
\q2 me'utiyɨyɨakatɨ mepɨwayekɨka memuwayu'awietata.   
\q1
\v 46 Yawé kaniuyeikani. 'Aixɨa keramamatiwani ne'ai.  
\q2 Kenɨawarieka nekakaɨyari netsiwikweitsitɨwame.   
\q1
\v 47 Kakaɨyari nehetsiemieme mɨtiwarakapitɨwa memɨnetsi'aye'unie pɨhɨkɨ,  
\q2 nuiwarite nehetɨa muwaku'uitɨwa.   
\b  
\q1
\v 48 'Ekɨ pepɨnetsiwikweitsitɨa memɨnetsi'aye'unie wahetsɨa,  
\q2 memɨnetsi'aye'unie waheima pepɨnetsikake,  
\q2 pepɨnetsiwikweitsitɨa teɨteri 'axamemɨte'u'iyari wahetsɨa.   
\q1
\v 49 Yawé, 'ayumieme ne 'aixɨa nepaine 'ahepaɨtsita nuiwarite watsata  
\q2 meta nɨawari 'ahetsiemieme neputikwika kepemɨtitewakɨ.   
\b  
\q1
\v 50 Yawé mɨrayu'iwanikɨ pipitɨa ti'aitame menukake,  
\q2 menayexei Rawiri meta nuiwarimama  
\q2 pɨkawahayewa yuheyemekɨ wanaki'erietɨ.   
\c 19  
\d Teyuitɨwamete wa'ukiyari hetsiemieme. Rawiri nɨawarieya.  
\q1
\v 1 Muyuawi taheima muyema hetsie pɨmatsiɨkɨ Kakaɨyari kemɨtimariwe,  
\q2 mɨkɨkɨ pɨtihekɨata yumamakɨ kemɨtiutawewi.   
\q1
\v 2 Tukari xeime tukari yapɨtikuxaxatɨwa kemɨtiɨyɨ,  
\q2 tɨkari xeime tɨkari yapɨrahɨawe.   
\q1
\v 3 Tsepa memɨkatexatawawe,  
\q2 tsepa waniuki mɨkayu'eniɨriɨkɨ,   
\q1
\v 4 naitsarie kwiepa kaniwaku'eiyani,  
\q2 waniuki kwie manu'axe kaniye'axeni.  
\b  
\q1 Kakaɨyari muyuawitsie tau  
\q2 kiiya kaniukawewieni.   
\q1
\v 5 Mɨkɨ yukiita kaniwayeyeikani neneɨkeme hepaɨ tiyutemawietɨ,  
\q2 waukawa yutemawietɨ yeikame hepaɨ, kaneyeikani yuhuyeta.   
\q1
\v 6 Muyuawi panakuyeika xeitaparitsie  
\q2 'umietɨta xeitaparitsie pɨta kaneukayuyuipikeni,  
\q2 yunaime waxɨriwiyatɨ xeime kahayewatɨ.   
\b  
\q1
\v 7 Yawé tɨratuya 'aixɨa kani'aneni:  
\q2 hekwame tukari katiniyupitɨwani.  
\q1 Yawé 'aitsikaya hetsie yuri mɨti'erie 'aixɨa kaniyurieka:  
\q2 'atsimɨkatimate timaiweme kanayeitɨwani.   
\q1
\v 8 Yawé kemɨti'aita kaniheitserietɨni:  
\q2 'iyari kanitemawieritɨaweni.  
\q1 Yawé niukieya kanihekɨaka:  
\q2 hɨxite hauneniereme kanayeitɨwani.   
\q1
\v 9 Yawé xɨka temakaxeni 'aixɨa kani'aneni:  
\q2 yuheyemekɨ kani'ayumiemetɨni.  
\q1 Yawé kemɨranutahɨani kaniyuritɨni:  
\q2 naitɨ kemɨtiyuyuruwa kaniheitserietɨni.   
\q1
\v 10 Matsi huru reuyeta pɨtiyunaki'erinɨa,  
\q2 huru 'aixɨa mɨ'ane reuyeta,  
\q1 matsi xiete reuyeta pɨrakaka,  
\q2 xiete yuxɨrɨkatsie muhane hepaɨ.   
\q1
\v 11 Kɨmana tewi 'ahetsɨa mieme kanaye'eritɨariwani,  
\q2 Kemɨ'ane memeye'atɨwa waɨkawa 'imikieri pepɨtiwakupitɨwa.   
\b  
\q1
\v 12 Xewitɨ 'apɨka'uyeika timaitɨ kename 'axatiyuriene.  
\q2 Kenetineuyehɨwirieka titakɨ 'atsinemɨkatinemate.   
\q1
\v 13 Keneneuxɨna 'axanemɨtiyurienekɨ nemɨtiyukatawe'eriekɨ,  
\q2 pepɨkanetsipitɨaka mɨkɨ 'axamɨti'ane mɨnetsikuyuitɨwanikɨ.  
\q1 Mɨpaɨ nehetsie pɨkarahɨiwani  
\q2 meta nepɨka'imɨiriyani 'axamɨti'ane.   
\b  
\q1
\v 14 'Ekɨ kenenaki'erieka,  
\q2 neniuki meta kenemɨtiku'eriwa,  
\q2 Yawé, ne'ai meta pemɨnetsiwikweitsitɨwame.   
\c 20  
\d Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya.  
\q1
\v 1 Yawé, kemetsi'uta'eiya kepauka pemɨ'a'uximatɨa,  
\q2 Kakuwu Kakaɨyarieya kemetsi'ɨwiyani.   
\q1
\v 2 Kemetsi'uparewieni yutukita 'ayekaitɨ,  
\q2 Tsiyunitsie paitɨtɨ kemetsi'uparewieni.   
\q1
\v 3 'Amawarika naime keha'eriwani,  
\q2 mawari taiyariyari kemetsinaki'eririeka.   
\b  
\q1
\v 4 'A'iyarikɨ tita pemɨreuyehɨwa kemetiyetuirieni,  
\q2 kepemɨtiku'eriwa kepemɨtiyurimɨkɨ yaketiuyɨni.   
\q1
\v 5 Tame tepuyutemamawieka kepauka pemɨrayu'iwa,  
\q2 takakaɨyari hetsiemieme  
\q2 tapatera teikɨ tenetseraxɨakuni.  
\q1 Yawé naime kemetiyetuirieni tita pemɨrewawiriwa.   
\b  
\q1
\v 6 Hikɨ mɨpaɨ nepɨtimate Yawé ti'aitame menayexei pɨtawikweitsitɨani,  
\q2 pita'eiya muyuawi mɨpatsietsie paitɨ  
\q2 yutɨrɨkariyakɨ memamariwaweme pɨwara'iwa.   
\q1
\v 7 Mɨkɨ yukaxetate kuyaxa miemetsie mekaneuwawaɨreni,  
\q2 'iyata yukawayutsixi 'amemɨpapa wahetsie mekaneuwawaɨreni,  
\q1 peru tameta  
\q2 takakaɨyari Yawé hetsie tekaneuwawaɨreni.   
\q1
\v 8 Mɨkɨ mekana'iwarɨwani meta mekanatixɨrɨweni,  
\q2 peru tame tepanuku'uwe, 'atepɨti'u.   
\b  
\q1
\v 9 Yawé, keneupitɨa ti'aitame mɨrayu'iwakɨ.  
\q2 Kepauka temetsitahɨawe ketaneku'eiyani.   
\c 21  
\d Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya.  
\q1
\v 1 Ti'aitame puyutemawie 'atɨrɨkariyakɨ, Yawé.  
\q2 Waɨkawamekɨ puyutemawie pemiparewiekɨ mɨrayu'iwakɨ.   
\q1
\v 2 Pepeye'atɨiri tita yu'iyarikɨ mɨreuyehɨakai,  
\q2 pepɨkatitikweriri tita mɨra'iwawakai.   
\q1
\v 3 Pepenukunakixɨ 'aixɨa pe'iyurietɨ waɨkawamekɨ,  
\q2 kuruna pepenaketsiri huru 'aixɨa mɨ'anekɨ wewiyakame.   
\q1
\v 4 Tukari pɨmetsi'utawawiri, 'ekɨ pepiyetuiri:  
\q2 tukari waɨkawame meta 'atiteriweme.   
\q1
\v 5 Pemiparewikɨ waɨkawa tɨrɨkaɨyetɨ payeitɨarie,  
\q2 waɨkawa mariweme pepayeitɨa.   
\q1
\v 6 Hetsiena mieme haixa kemɨtiuneika mɨpaɨ 'aixɨa pepiyurie,  
\q2 pemiteɨtakɨ waɨkawa puyutemawie.   
\b  
\q1
\v 7 Ti'aitame Yawé hetsie kaneuwaɨreni,  
\q2 'Amutewi naki'eriyayatsie,  
\q2 'ayumieme hatsuaku pɨka'atiweni.   
\q1
\v 8 'Atɨrɨkariyakɨ kemɨ'ane memɨmetsi'aye'unie yunaime pepɨwatiwiya,  
\q2 'atseriekɨ pekaniwa'aximɨkɨ kemɨ'ane memɨmetsi'uxie.   
\q1
\v 9 Yawé, kepauka 'ekɨ pemuyuhekɨata,  
\q2 huxunu mɨtaka hepaɨ me'anekame pekaniwarayeitɨamɨkɨ.  
\b  
\q1 Yuhaxɨakɨ Yawé kaniwareuyehɨamɨkɨ,  
\q2 tai kaniwatixɨtsitɨamɨkɨ.   
\q1
\v 10 Yunaime 'ena kwiepa waniwema pepɨwarakuyeitɨani,  
\q2 yunaime nuiwarite watsata 'ena memu'uwa.   
\q1
\v 11 Tsepa memiwautɨwe kehepaɨ memɨmetekwinitɨanikɨ  
\q2 tsepa memuyukapiniriwa 'ahepaɨtsita,  
\q2 mɨkɨ yamepɨkateyurieni.   
\q1
\v 12 Peru kepauka 'ekɨ pemɨwata'unieni 'atupikɨ  
\q2 mɨkɨ mekanitanautsaxɨakuni.   
\b  
\q1
\v 13 Yawé, 'atɨrɨkariya keneuhekɨata,  
\q2 tameta nɨawari 'ahetsiemieme tepɨtikwika, waɨkawamekɨ pemɨre'a'iwakɨ.   
\c 22  
\d Teyuitɨwamete wa'ukiyari. Kemanɨyɨne «Maxa 'uka muxei kahekɨarirɨmekaku» mɨpaɨ ketiukwikarieni. Rawiri nɨawarieya.  
\q1
\v 1 Nekakaɨyari 'aku, nekakaɨyari 'aku,  
\q2 ¿titayari penetiuku'eiri?  
\q1 Teewa pepuwe kepenetiuwikweitsitɨani,  
\q2 'ateewa paitɨ neniuki, mɨkaha'eniɨriɨkɨtsie neputatsuaka.   
\q1
\v 2 Nekakaɨyari, tukarikɨ nemetsihahiwiwa 'ekɨta pepɨkanetsiheku'eiya,  
\q2 tɨkarikɨta yaxeikɨa nemetikɨhɨawetɨ nepɨka'uxipie.   
\b  
\q1
\v 3 'Ekɨ matsi pepɨpatsie, 'ekɨ pepɨti'aitame,  
\q2 'ekɨ 'ixaheritsixi pepɨwakwikari.   
\q1
\v 4 Ta'ukiyarima 'ahetsie mepɨtewiyakai,  
\q2 'ahetsie yuri mepɨte'eriekai, 'ekɨta pepɨwaruxɨnaxɨ,   
\q1
\v 5 mepɨmetsi'utahiwi, 'ekɨta pepɨwarutawikweitsitɨa,  
\q2 'ahetsie mepɨte'uwiyaxɨ, 'ekɨta pepɨkawarexɨri.   
\b  
\q1
\v 6 Ne matsi nepɨkatewi, kwitsi nepɨhɨkɨ,  
\q2 teɨteri waɨkawa mepɨnetsiyuriya,  
\q2 yunaitɨ teɨteri mepɨnetsixani'erie.   
\q1
\v 7 Yunaitɨ memɨnetsixeiya, meputinawe,  
\q2 mepɨnetsi'utate'a, yumu'u me'utitsiketɨ:   
\q1
\v 8 «'Ikɨ Yawé hetsie yuri katini'erieka,  
\q2 kamɨtsɨ Yawé ke'itawikweitsitɨani.  
\q1 Metsɨ mɨkɨ hetsie xeikɨa kaniyukɨhɨaweni,  
\q2 mɨkɨ matsi ke'ixɨna».   
\b  
\q1
\v 9 Matsi 'ekɨ nemaama hetsie pepɨnetsiyenuiwitɨa,  
\q2 nemaama hetsie pepɨnetsi'ukute,  
\q2 'ahetsie neyɨkɨhɨaweme pepɨnetsi 'ayeitɨa.   
\q1
\v 10 Nekatinuiwawekaku 'akuxi  
\q2 'ekɨ pepɨnetsi'ɨwiyakai,  
\q1 nemaama hetsie neyekaiku paitɨ,  
\q2 'ekɨ pepɨnekakaɨyari.   
\q1
\v 11 Hawaikɨ, pepɨkanetsi'uku'e'eiriwani,  
\q2 karikɨ 'uximatɨarika 'ahurawa kaniuyeikani,  
\q2 xewitɨ pumawe mɨnetsiparewienikɨ.   
\b  
\q1
\v 12 Memɨnetsi'aye'unie yuwaɨkawatɨ ne'aurie mepa'utɨka,  
\q2 mekaniti'uka metɨrɨkawitɨ turutsixi Watsani kiekatari wahepaɨ.   
\q1
\v 13 Nehetsiemieme meputikwaxawa,  
\q2 mayetsi memuyuti haxɨatɨwa hepaɨ wai metatsanake.   
\q1
\v 14 Haa hepaɨ netukari pɨtayeuriwe,  
\q2 ne 'umete naitɨ pɨxɨxɨni.  
\q1 Ne 'iyari xɨrɨka hepaɨ 'anetɨ patɨa,  
\q2 netaɨta witsɨanitɨ puhane.   
\q1
\v 15 Netɨrɨkariya haxu hepaɨ puwa,  
\q2 neneni pukuwewerike.  
\q2 Mɨkite watsata pepɨnetsi'ukateukixɨ.   
\q1
\v 16 Tsɨikɨri tixaɨtɨ memɨte'anukuweiya hepaɨ mepɨnetsi'anutinama,  
\q2 'axateyuruwamete mekaneniuweiyani,  
\q2 nemamatetsie mekaneneukeixɨani meta ne'ɨkatetsie.   
\q1
\v 17 Naime ne'umete nemuti'inɨata nepɨyɨwe,  
\q2 teɨteri mekani'axeni menetsixeiyake  
\q2 wa'iyari 'aixɨa mɨ'anekɨ.   
\q1
\v 18 Ne'ixurikite mepɨyutahuritɨa  
\q2 meta mekaniyuta'iwa ne'ixɨrikikɨ.   
\b  
\q1
\v 19 Yawé, peru 'ekɨ 'ateewa pepɨkaheyeikani,  
\q2 pemɨnetɨrɨkariyakɨ, kwitɨwa kenaye'a pemɨnetsiparewienikɨ.   
\q1
\v 20 Netukari keneutawikweitsitɨa 'ixiparakɨ ne'umierienikɨ,  
\q2 netukari witsimɨ'ane, tsɨikɨri memɨtɨrɨkawi wahetsɨa.   
\q1
\v 21 Mayetsi wateta kenenewayehani,  
\q2 tuurutsixi menetsi'utsikɨpakɨ keneneutawikweitsitɨa.   
\q1
\v 22 Ne'iwama nepɨtiwataxatɨani kepemɨtiuka'iyari,  
\q2 'ahetsɨa miemete memayuxeɨrie watsata ne'uwetɨ nepɨmetsitanɨawa.   
\q1
\v 23 Yawé xekenenɨawani kemɨ'ane xemeyemakaxe.  
\q2 Mariweme xekenayeitɨaka, Kakuwu niwemama.  
\q2 Xekenayexeiyani, 'ixaheri nuiwarimama.   
\q1
\v 24 Mɨkɨ mɨkatiuyukaxani'eriekɨ meta tixaɨtɨ mɨkarexeiya  
\q2 kemɨtiuka'eniwa mɨka'ixeiya xeikɨa,  
\q1 hɨxiena pɨkayuti'awiwieta,  
\q2 matsi kani'enieka, kepauka mɨkɨ maniuka.   
\b  
\q1
\v 25 'Ekɨ yapepɨnetikuyuitɨwa kenemɨtiukwika yuwaɨkawame wahɨxie,  
\q2 kemɨ'ane memɨmetsi'ayemakaxe wahetsie, nepeye'atɨani kenemutayɨ.   
\q1
\v 26 Tixaɨtɨ memɨkateheuxeiya mepɨtekwani, mɨkɨ mepɨtihuxani,  
\q2 Yawé mepɨtanɨawa kemɨ'ane memikuwautɨwe,  
\q2 wa'iyari ke'ayeyurini yuheyemekɨ.   
\q1
\v 27 Yawé mekanaye'erikuni, hetsɨana mekani'axɨakuni  
\q2 yunaitɨ kwie manuye'atɨkatsie paitɨ memɨtama,  
\q2 hɨxiena mekanikatunuma'uikuni  
\q2 yunaitɨ kwiepa memɨtama wanuiwarima.   
\q1
\v 28 Karikɨ Yawé katini'aitametɨni,  
\q2 yunaime nuiwarite katiniwa'aitɨaka.   
\b  
\q1
\v 29 Yunaitɨ kwiepa waɨkawa memɨtehexeiya mekaniyutitemamawikuni meta hɨxiena mekanikahɨxima'uikuni,  
\q2 hɨxiena mekanikatunuma'uikuni yunaitɨ memukwi,  
\q2 yunaitɨ tukari memɨyupitɨani memɨkayɨwawe.   
\q1
\v 30 Teɨteri 'imatɨrieka miemete mekaneyexeiyakakuni,  
\q2 kemɨ'ane memu'uwani 'uxa'atɨni warie Tati'aitɨwame mekanikuxaxatɨariwakuni.   
\q1
\v 31 Teɨteri memɨkatinunuiwawe 'akuxi  
\q2 mepɨtetaxatɨarieni Kakaɨyari heitseriekamekɨ kemɨtiuyuri.   
\c 23  
\d Rawiri nɨawarieya.  
\q1
\v 1 Yawé netsihɨweme kanihɨkɨtɨni, tixaɨtɨ nepɨkareuyehɨwa,   
\q2
\v 2 makutsiɨraɨyetsie kaneniuka'uxipitɨwani.  
\q1 Haa kayuwatɨ mɨtimatsie kaneni'atɨwani,   
\q2
\v 3 tawarita pɨnetsitɨrɨkariya hekwamekɨ.  
\q1 Huye mɨheitserie 'utɨa kaneniuwitɨximeni  
\q2 mɨpaɨ mɨkɨ 'aixɨa mɨtikɨhɨawarɨwanikɨ.   
\b  
\q1
\v 4 Mɨpaɨ tsepa kweriwa'anekɨa nemumie,  
\q2 'uyɨwikaku tixaɨtɨ nepɨkareumakaxe,  
\q2 'ekɨ nehamatɨa pemuyeikakɨ,  
\q1 muxatsi wahɨweme 'itsɨya pemakwe'ekɨ 'ahetsie nepeuwaɨre.   
\b  
\q1
\v 5 'Ekɨ 'ixɨarari pepɨnetsiwewirie  
\q2 memɨnetsi'aye'unie wahɨxie.  
\q1 Witsimu'ɨa nemu'utsie pepɨnetsi'ukawiri,  
\q2 netekɨxi 'anakayeuriweme pepayeitɨa.   
\b  
\q1
\v 6 'Aixɨa kepemɨtiuka'iyari meta 'anaki'eriya  
\q2 nehexeiyatɨ nepuyeikani,  
\q1 kepaɨmexɨa tukari pemɨnetsipitɨaka,  
\q2 meta Yawé kiitana yuheyemekɨ nepayekani.   
\c 24  
\d Rawiri nɨawarieya.  
\q1
\v 1 Yawé kwie naitɨ pɨtipiinieya meta hetsiena naitɨ mɨtixuawe,  
\q2 kwie naitɨ kemɨnena, meta keyupaɨmetɨ mana memɨte'u'uwa,   
\q1
\v 2 mɨkɨ haramara heima kwie 'unetɨaka,  
\q2 haa panuyetuaxɨa.   
\b  
\q1
\v 3 ¿Kemɨ'ane Yawé hɨrieyaritsie panutiyeiwe?  
\q2 ¿Kemɨ'ane tukieya muyepatsieta pautahawe?   
\q1
\v 4 Kemɨ'ane 'aixɨa mɨtiyuriene meta yu'iyaritsie mɨ'itiya,  
\q2 kemɨ'ane kakaɨyarixi tixaɨtɨ memɨkateyunaki'erie mɨkawarayexeiya  
\q2 meta mɨkatiyɨhɨritɨa ti'itawatɨ.   
\b  
\q1
\v 5 Kemɨ'ane mɨpaɨ mɨ'ane Yawé 'aixɨa kaniyurieka,  
\q2 Kakaɨyari 'iwikweitsitɨwame hetsiena mieme heitseriemekɨ yakatiniyuriemɨkɨ.   
\q1
\v 6 Mɨpaɨ kani'aneni nuiwari kemɨ'ane mɨmetsi'ayexeiya,  
\q2 kemɨ'ane memɨmetsikuwaɨtɨwe, Kakuwu Kakaɨyarieya.   
\b  
\q1
\v 7 Kitenie xekeneyuyepiexɨa,  
\q2 'itupari meripaitɨ xemumiemete xekeneyuyepiexɨa,  
\q2 Ti'aitame witsimɨ'ane kaneutahamɨkɨ.   
\b  
\q1
\v 8 ¿Kemɨ'ane mɨkɨ Ti'aitame witsimɨ'ane pɨhɨkɨ?  
\q2 Yawé, mɨtɨrɨkaɨye meta mɨrayu'iwa,  
\q2 Yawé, kwinimieme mɨreuyutamiewe.   
\b  
\q1
\v 9 Kitenie xeketeneuyepiexɨa,  
\q2 'itupari meripaitɨ xemumiemete xekeneyuyepiexɨa,  
\q2 Ti'aitame witsimɨ'ane kaneutahamɨkɨ.   
\b  
\q1
\v 10 ¿Kemɨ'ane mɨkɨ Ti'aitame witsimɨ'ane pɨhɨkɨ?  
\q2 Yawé Naimekɨmɨtɨrɨkaɨye kanihɨkɨtɨni,  
\q2 mɨkɨ Ti'aitame witsimɨ'ane kanihɨkɨtɨni.   
\c 25  
\d Rawiri nɨawarieya.  
\q1
\v 1 'Ekɨ, Yawé, ne'iyari nepɨmetsiyetuirie,   
\q2
\v 2 nekakaɨyari, 'ahetsie yuri nepɨti'erie,  
\q1 pepɨkanetsipitɨaka nemɨnanaimariekakɨ,  
\q2 memɨnetsi'aye'unie pepɨkawapitɨaka memɨnetsiyuriyanikɨ.   
\q1
\v 3 Kemɨ'ane 'ahetsɨa mɨreutakwewie  
\q2 hatsuaku pɨkatiyutewinɨani,  
\q1 kemɨ'ane hipame memuwakwamana  
\q2 mɨkɨ mepuyutitetewiya.   
\b  
\q1
\v 4 Yawé, 'ahuye nemaikame kenenayeitɨa,  
\q2 'ahuye kemɨreuyune keneneuxeitsitɨa.   
\q1
\v 5 Yuri pemainekɨ keneneuwitɨximeni meta peneti'ɨkitɨatɨ.  
\q2 'Ekɨ nekakaɨyari pepɨhɨkɨ meta netsiwikweitsitɨwame,  
\q2 tukarikɨ 'ahetsie timieme nepɨtitakwewie.   
\q1
\v 6 Yawé, kenaye'eri kewitsipemɨtiuka'iyari, waɨkawa kepemɨti'akanaki'erie,  
\q2 yuheyemekɨ kepemɨnetixeitsitɨa,   
\q1
\v 7 'axakenemɨtiuyuri kenatɨmaiya  
\q2 'aitsika nemeutitsanaxɨakɨ temaikɨyari.  
\q1 Kenenaye'eri kepemɨti'akanaki'eriekɨ,  
\q2 'ekɨ Yawé 'aixɨa pemɨtiuka'iyarikɨ.   
\b  
\q1
\v 8 Yawé 'aixɨa pɨtiuka'iyari meta kemɨtiheitseriekɨ pɨtiyuriene,  
\q2 'Ayumieme 'axateyuruwamete huye pɨwaxeitsitɨa.   
\q1
\v 9 Mɨkɨ tixaɨtɨ memɨkate'ayuyeitɨa 'aixɨa 'anemekɨ kaniwaruwitɨximeni,  
\q2 meta yuhuye kaniwa'ɨkitɨaka.   
\q1
\v 10 Naitɨ Yawé huyeya kaninaki'eriyatɨni meta kaniyuritɨni,  
\q2 kemɨ'ane 'aitsika memaye'atɨwa meta tɨratuya.   
\q1
\v 11 'Aixɨa pemɨtikɨhɨawarɨwanikɨ Yawé,  
\q2 Kenetineuyehɨwiri waɨkawa 'axakenemɨtiuyurikɨ.   
\q1
\v 12 ¿Kemɨ'ane tewi Yawé payemakaxe?  
\q2 Mɨkɨ huyeta 'aixɨa 'anemekɨ kaniyewitɨkiemɨkɨ.   
\q1
\v 13 'Aixɨa 'anemekɨ kaniuyeikamɨkɨ,  
\q2 wanuiwarimata kwie mekaniyetuiriyariekuni.   
\q1
\v 14 Yawé puwanaki'erie kemɨ'ane memeyexeiya,  
\q2 meta yutɨratu kaniwahekɨatsitɨiyani.   
\q1
\v 15 Ne Yawé xeikɨa nepayexeiya,  
\q2 mɨkɨ xeikɨa winiyaritsie mɨnetsi'uxɨna mɨyɨwekɨ.   
\b  
\q1
\v 16 Nehepa kenatanieri keneneuxeiya, kenenenenimayaka  
\q2 nexaɨtame nepuyeika, 'uximatɨarika nehexeiyatɨ.   
\q1
\v 17 Ne'iyaritsie 'uximatɨarika puyumɨiriya,  
\q2 mɨyanemɨtiuka'eniwakɨ keneneɨxɨna.   
\q1
\v 18 Ne'uximatɨarika keneuxeiya meta kenemɨ'uximaya,  
\q2 'axakenemɨtiuyuri naime kenanuyeitɨa.   
\q1
\v 19 Neuxei memɨnetsi'aye'unie mepuyuwaɨkawari,  
\q2 'uxiwe'erika mepexeiya nehetsie 'axamenetsiyurikutɨ.   
\q1
\v 20 Kenene'ɨwiyani nemɨkakumemieriwanikɨ, keneneutawikweitsitɨa,  
\q2 pepɨkanetsipitɨaka nemɨtinetewinɨakakɨ,  
\q2 'ahetsɨa nekaniyu'awietani.   
\q1
\v 21 Nehetsie nunuwame kenehɨkɨtɨni, 'aixɨa nemɨtiuka'iyarikɨ meta heitserie nemuyeikakɨ,  
\q2 'ahepaɨtsita nemeuta'ikwewakɨ.   
\b  
\q1
\v 22 Kakaɨyari, 'ixaheritsixi keniwarɨxɨna naimekɨ kememɨte'uka'eniwakɨ.   
\c 26  
\d Rawiri nɨawarieya.  
\q1
\v 1 Yawé, heitseriemekɨ ketineuyuri nehetsiemieme,  
\q2 ne 'aixɨa nepɨtiuyeika,  
\q2 Yawé, 'ahetsie nepɨtiwiya nekahekawaɨtsetɨ.   
\q1
\v 2 Yawé, keneneutixeiyaxɨa keneneuta'inɨata,  
\q2 netaɨta keneneu'iti meta ne'iyaritsie.   
\b  
\q1
\v 3 Waɨkawamekɨ kepemɨtiyukanaki'erie yanepɨre'eriwa,  
\q2 meta yuri pemainetsie xeikɨa nepuyeika.   
\q1
\v 4 Ne memɨte'itawa nepɨkawatemawie,  
\q2 meta kwamanarikakɨ memɨtekuxata wahamatɨa nepɨka'uyeika,   
\q1
\v 5 'axamemɨte'u'iyari wahamatɨa nemuyeikani nepɨxani'erie,  
\q2 'aixɨa memɨkate'u'iyari wahamatɨa nepɨkayuxewi.   
\b  
\q1
\v 6 Neheu'itiyatɨkaitɨ meta nehetsie karahɨiwakaku,  
\q2 Yawé, 'amawari taiyame warita nepayeika,   
\q1
\v 7 karima 'anɨawari ne'utakwitɨ,  
\q2 meta naime mamariwawemekɨ kepemɨtiyuriene.   
\q1
\v 8 Yawé, ne 'atuki waɨkawa nepɨnaki'erie,  
\q2 hakewa mematsiɨkɨ witsikepemɨ'anekɨ.   
\b  
\q1
\v 9 Kepauka nemɨmɨni,  
\q2 'axateyuruwamete meta teyumiekate wahamatɨa pepɨkanetsi'inɨatani,   
\q1
\v 10 teɨteri tumini memumana  
\q2 'itarikakɨ me'e'iwaka wahamatɨa.   
\q1
\v 11 Ne matsi 'aixɨa nepɨtiuyeika nehetsie pɨkarahɨiwa,  
\q2 keneneɨxɨna kenenenenimayaka.   
\b  
\q1
\v 12 'Ena kwiepa 'anepuwe,  
\q2 meta yumɨiretɨ meyuxeɨriekaku Yawé hetsiemieme 'aixɨa nekanitayɨmɨkɨ.   
\c 27  
\d Rawiri nɨawarieya.  
\q1
\v 1 Yawé nehekɨariwiwame kanihɨkɨtɨni meta netsiwikweitsitɨwame,  
\q2 ¿kemɨ'ane nepumakaxeni?  
\q1 Yawé netukari mɨ'ɨwiya kanihɨkɨtɨni,  
\q2 ¿kemɨ'ane 'aku pɨnetsi'utimariutawe?   
\q1
\v 2 Kepauka 'axateyuruwamete nehepa memahu  
\q2 menetsika'unake,  
\q1 kepauka memɨnetsi'aye'unie neneɨkixiwima memɨnetsimietɨwe,  
\q2 mɨkɨ pɨta mekanetiwitseweni mekanekaxɨrɨweni.   
\q1
\v 3 Tsepa kuyaxi memɨnetsi'anutina,  
\q2 ne'iyari pɨkatimani,  
\q1 tsepa nehetsiemieme kuyaxa matɨa,  
\q2 nematsi nepɨrawiyani.   
\b  
\q1
\v 4 Xeime xeikɨa Yawé nepɨtiwawirie,  
\q2 ne mɨkɨ xeikɨa nepuweiya:  
\q1 Yawé kiita nemayekanikɨ  
\q2 naime tukarikɨ kenemɨreutere ne'ayeyuritɨ  
\q1 nemixeiyanikɨ witsikemɨ'ane Yawé  
\q2 meta tukitana nemɨhekwariyarienikɨ.   
\q1
\v 5 Metsɨ kepauka 'uximatɨarika tukariyari maye'ani  
\q2 mɨkɨ kaneni'awietakamɨkɨ yukiita,  
\q1 tukieya nehetsie kaninuakamɨkɨ,  
\q2 'ateewa kanenakakemɨkɨ, 'ai heima paitɨ.   
\q1
\v 6 Nerayu'iwame kanenayeitɨamɨkɨ  
\q2 memɨnetsi'aye'unie ne'aurie memahane wahɨxie,  
\q1 tukitana kwikari nekanitimawiriemɨkɨ  
\q2 meta nɨawari Yawé hetsiemieme nekanitikwikamɨkɨ.   
\b  
\q1
\v 7 Nehiwari keneu'eni, Yawé, kepauka nemetsihahɨawe,  
\q2 keneneutinenimayata keneneuta'eiya.   
\q1
\v 8 Ne'iyari mɨpaɨ kanetinahɨaweni: «Nierikaya keneutiwawa».  
\q2 Neta, Yawé, 'anierika nekaniwauneni.   
\q1
\v 9 Pepɨkayu'awietaneni nehetsiemieme,  
\q2 'ikɨ ti'a'uximayatsiriwame pepɨkahehɨpani pe'ihekatɨ,  
\q2 'ekɨ netsiparewiwame pekanihɨkɨtɨni,  
\q1 nexaɨtame pepɨkanetsikuhayeikawani meta pepɨkanetsi'uku'e'eiriwani,  
\q2 Kakaɨyari netsiwikweitsitɨwame.   
\b  
\q1
\v 10 Tsepanetɨ nepaapa meta nemaama memɨnete'uku'eiri,  
\q2 Yawé pɨnetsitituni.   
\b  
\q1
\v 11 Yawé, 'ahuyeta keneneuwitɨximeni,  
\q2 huye mɨheitserie 'utɨma keneneuwitɨximeni,  
\q2 hipatɨ memɨnetsihupiekɨ.   
\q1
\v 12 Pepɨkanetsiyetuayani memɨnetsi'aye'unie nehetsie memɨye'axɨanikɨ,  
\q2 nehepaɨtsita menetsi'itatɨ mekananuku'uni  
\q2 menetsinanaimakutɨ xeikɨa mekanenanutate'ani.   
\b  
\q1
\v 13 Perutsɨ xeimekɨ yanepɨtimate:  
\q2 Yawé naki'eriyaya 'akuxi nepɨxeiyani  
\q2 'ena kwiepa memu'uwa wahamatɨa.   
\b  
\q1
\v 14 Yawé kenetakwewieka,  
\q2 kene'awaɨriyani, tɨrɨkariya kenexeiyani,  
\q2 Yawé kenetakwewieka.   
\c 28  
\d Rawiri nɨawarieya.  
\q1
\v 1 Yawé, ne nepɨmatsihahɨawe, 'ekɨ nehetsie nunuwame pepɨhɨkɨ,  
\q2 pemɨka'enani hepaɨ pepɨkayɨaneni,  
\q1 xɨka pekanetsi'uta'eiya,  
\q2 kanihekɨaka nekanimɨmɨkɨ.   
\q1
\v 2 Nehiwari kenanu'eni  
\q2 kepauka 'ahetsɨa nemɨye'axetsie parewiya neheuyehɨatɨ,  
\q2 kepauka Waɨkawa Muyepatsietsie nemamate nemeutatsetseratsie.   
\q1
\v 3 Pepɨkanetsihehanani 'axamemɨte'u'iyari wahamatɨa,  
\q2 'axateyuruwamete wahamatɨa,  
\q1 'aixɨa memutekuxata yuhepaɨ teɨteri wahamatɨa,  
\q2 peru yu'iyaritsie 'axamɨti'ane metexeɨrietɨ.   
\q1
\v 4 Yaketiniwarupitɨa kememɨte'uyuri,  
\q2 'axakememɨteyuriekaikɨ.  
\q1 Kememɨte'u'uximayataxɨ mɨpaɨ ketiniwarupitɨa,  
\q2 tita mɨtiwahetsiemieme.   
\q1
\v 5 Yawé, kemɨtiuyuri mɨpaɨ memɨkateku'eriwakɨ,  
\q2 meta tita mɨtiutawewi yutɨrɨkariyakɨ memɨkatematekɨ,  
\q1 mɨkɨ kaniwaka'unamɨkɨ,  
\q2 tawarita hatsuaku pɨkawaranuku'uitɨani.   
\b  
\q1
\v 6 Yawé witsiketikuxaxatsiwani,  
\q2 nehiwari mu'enikɨ waɨkawa ne'iwawiriekaku.   
\q1
\v 7 Yawé netɨrɨkariya kanihɨkɨtɨni meta nehetsie nunuwame,  
\q2 ne'iyari hetsiena katiniwiyani,  
\q2 mɨkɨ kaneniparewieka.  
\q1 Ne'iyari kaniutitsukwakani temawierikakɨ,  
\q2 ne'utakwitɨ pamɨpariyutsi nekanipitɨamɨkɨ.   
\b  
\q1
\v 8 Yawé yuteɨterima muwatɨrɨkariya kanihɨkɨtɨni,  
\q2 meta kemɨ'ane pemenayexei pekaniwikweitsitɨaka.   
\q1
\v 9 'Ateɨterima keniwarutawikweitsitɨa, 'aixɨa keniwayurieka 'ahetsɨa miemete,  
\q2 keniwaruwitɨximeni yuheyemekɨ muxatsi wahɨweme hepaɨ.   
\c 29  
\d Rawiri nɨawarieya.  
\q1
\v 1 'Aixɨa xeketenahɨaweni Yawé, muyuawitsie xemɨte'i'uximayatsirie,  
\q2 'aixɨa xeketenahɨaweni Yawé witsikemɨ'ane, kemɨtitɨrɨkaɨye.   
\q1
\v 2 'Aixɨa xeketenahɨaweni Yawé witsikemɨ'ane mɨkɨ xeikɨa 'aixɨa mɨtikɨhɨawaruwanikɨ,  
\q2 Yawé hɨxie xekenekahɨxima'uti tukitana mariweme xe'ayeitɨatɨ.   
\b  
\q1
\v 3 Yawé hiwarieya haa heima kaniuyeikani,  
\q2 Kakaɨyari witsimɨ'ane tɨranarieya kanayuaneni,  
\q2 Yawé, haa heima waɨkawa 'uyuanekaku kaniuyeikani.   
\q1
\v 4 Yawé hiwarieya kanayuaneni tɨrɨkaɨyetɨ,  
\q2 Yawé hiwarieya kanayuaneni mariwetɨ.   
\q1
\v 5 Yawé hiwarieya kariuxa kanititarani,  
\q2 Yawé kariuxa Riwanu mieme kanititarani,   
\q1
\v 6 Riwanu hɨriyari tsikeru hepaɨ katiniutsunatsitɨwani,  
\q2 Heximuni hɨriyari tuuru mɨkamaxiu hepaɨ katiniutsunatsitɨwani.   
\q1
\v 7 Yawé hiwarieya tai kanitanenetsitɨwani,   
\q2
\v 8 Yawé hiwarieya makumawe kaniutayuitɨwani,  
\q2 Yawé makumawetsie Karetsi kaniutayuitɨwani.   
\q1
\v 9 Yawé hiwarieya tuaxa kanitikatseni  
\q2 meta hɨri metsekame kanikuhayeikawani,  
\q2 tukitana yunaitɨ mɨpaɨ mekateniuhiwani: «'Aixɨa kani'aneni».   
\b  
\q1
\v 10 Yawé, wiyeritsie yu'uweni kanexeiyani,  
\q2 Yawé yuheyemekɨ katini'aitani.   
\q1
\v 11 Yawé yuteɨterima tɨrɨkariya kaniwapitɨaka,  
\q2 Yawé yuteɨterima 'aixɨa kaniwayurieka kayuwatɨ wapitɨatɨ.   
\c 30  
\d Kwikari yukie mieme. Rawiri nɨawarieya.  
\q1
\v 1 Yawé, 'aixɨa nepaineni 'ahetsiemieme, pemɨnetsi'anukuketɨakɨ,  
\q2 memɨnetsi'aye'unie pemɨkawarupitɨakɨ memɨnetsi'atsenikɨ.   
\q1
\v 2 Yawé nekakaɨyari, parewiya nemetsi'utawawiri  
\q2 'ekɨta 'aixɨa nereu'eriekame pepɨnetsi'ayeitɨa.   
\q1
\v 3 Yawé, 'ekɨ teukiyapa pepɨnetsihatiha,  
\q2 tawarita pepɨnetsi'anutanieritɨa mɨkite watsata.   
\b  
\q1
\v 4 Yawé xekenenɨawani, xeme 'aixɨa xemɨte'u'uwa hetsiena mieme,  
\q2 kemɨtipatsie xekenenɨawani.   
\q1
\v 5 Haxɨaya 'etsiwa xeikɨa katineutetereni,  
\q2 peru yuhemekɨ pɨtiuyukanaki'erie.  
\q1 Xɨka tɨkarikɨ tsuari xuaweni,  
\q2 ximerita temawierika puxuaweni.   
\b  
\q1
\v 6 Kepauka 'aixɨa nemɨtinemaikai, mɨpaɨ neniutayɨni:  
\q2 «Hatsuaku nepɨkahatihɨiyani».   
\q1
\v 7 Yawé, 'ekɨ 'aixɨa pemɨtiuka'iyarikɨ,  
\q2 'ateewa paitɨ pepɨnetsi'uti'awietaxɨ,  
\q1 hikɨta pepuyuti'awietaxɨ,  
\q2 neta nehɨxiyatɨ nepuyuhayewaxɨ.   
\b  
\q1
\v 8 Yawé, 'aixɨa pemɨtiuka'iyari, 'ekɨ nemetsihahiwiwa,  
\q2 'ekɨ yemekɨ waɨkawa nemetsiwawirie.   
\q1
\v 9 ¿Tita pera'iwa xɨka ne ne'umɨni,  
\q2 ne xɨka ne'ukateukieni?  
\q1 ¿Kamɨtsɨ tumuanari metitanɨawa,  
\q2 yatɨni 'aniuki yuri maine tikuxataneni?   
\q1
\v 10 Neuxei, Yawé, kenenenenimayaka,  
\q2 'Ekɨ kenehɨkɨtɨni netsiparewiwame, Yawé.   
\b  
\q1
\v 11 Nehiwerika matsi neiya pepayeitɨa,  
\q2 hiwerika kamixayari pepɨnetsi'anutihɨniri,  
\q2 'ixɨararipa miemekɨ pepɨnetsi'utikemaritɨa,   
\q1
\v 12 nemetsitanɨawakɨ, 'ahetsiemieme 'aixɨa nemainenikɨ,  
\q2 ne kayuwatɨ nemɨka'umakakɨ.  
\b  
\q1 Yawé nekakaɨyari, ne yuheyemekɨ pamɨpariyutsi nepɨmatsipitɨaka.   
\c 31  
\r (Nɨa 31:1-4 – Nɨa 71:1-3)  
\d Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya.  
\q1
\v 1 Yawé, 'ahetsɨa nepiwaune yu'awiwietame,  
\q2 pepɨkanetsipitɨaka nemɨtiyutewinɨakakɨ,  
\q2 heitserie pemexeiyakɨ, keneneuxɨna.   
\q1
\v 2 Kwi yemekɨ keneneu'eni,  
\q2 yapauka penetsiparewienike kene'axeni.  
\q1 'Ekɨ neterɨ 'amuyeyewa kenehɨkɨtɨni,  
\q2 netɨrɨkariya netsiwikweitsitɨwame kenehɨkɨtɨni.   
\q1
\v 3 Keneneuwitɨximeni, 'ekɨtsɨ nehetsie nunuwame pekanihɨkɨtɨni meta pemɨnetsikurarutɨiya,  
\q2 keneneuwitɨximeni mɨkɨkɨ 'ahepaɨtsita 'aixɨa mɨraniuwanikɨ.   
\q1
\v 4 Keneneɨxɨna memɨnetsi'aye'unie mepɨnetsi'uwiniyaxɨ,  
\q2 'ekɨ nehetsie nunuwame pemɨhɨkɨkɨ.   
\q1
\v 5 'Amamatsie ne'iyari nepɨyetua,  
\q2 Yawé, keneneutawikweitsitɨa, yuri Kakaɨyari.   
\b  
\q1
\v 6 Nepɨwaxani'erie kakaɨyarixi memɨwarayexeiya,  
\q2 ne 'aku, 'ahetsie nepɨtiwiya, Yawé.   
\q1
\v 7 Nepɨnetemawie yemekɨ 'anaki'eriyatsie,  
\q2 'ekɨ ne'uximatɨarika pemuxeikɨ  
\q2 meta ne'iyari 'uximatɨarikaya pemɨmatekɨ.   
\q1
\v 8 Pepɨkanetsiyetua mɨnetsi'aye'unie hetsɨa,  
\q2 matsi pɨta xaɨtsie pepɨnetsi'atɨa 'a'akuyeukaku.   
\b  
\q1
\v 9 Yawé, kenenenenimayaka, nepɨ'uximatɨarie,  
\q2 nehɨxite pɨtixɨxime kukuiniyakɨ,  
\q2 meta ne'iyari, metatsiere newaiyari.   
\q1
\v 10 Tukarikɨ yanepɨtiuka'eniwa,  
\q2 wiiyari panuyekɨka tsuarikɨ xeikɨa,  
\q1 nutuixiya netɨrɨkariya pɨtixɨtɨaxime,  
\q2 ne'umeyari pɨtiweranaxime.   
\q1
\v 11 Memɨnetsi'aye'unie wahetsiemieme mɨyane'anekaku,  
\q2 'atsieriwame nekanihɨkɨtɨni ne'aurie memutetɨka wahetsiemieme,  
\q1 Nehamikuma mekanenimakaka,  
\q2 kepauka kiekaritsie nemɨyeyeika mekanitananautsani.   
\q1
\v 12 Mekanenatɨmaiya, nemumɨni hepaɨ,  
\q2 xari mutatarixɨ hepaɨ nekani'aneni.   
\q1
\v 13 Yuwaɨkawatɨ 'axamekatenikuxatani nehetsiemieme:  
\q2 «Nekanimaka naitsarie».  
\q1 'Axeikɨa metiyaxeka kememɨnetemienikɨ mekateniutaxata,  
\q2 mekanenimiekuni mekaniutiyuaneni.   
\b  
\q1
\v 14 Yawé, netsietɨ 'ahetsie nekatiniwiyani,  
\q2 mɨpaɨ nekaniutaineni: «'Ekɨ pepɨnekakaɨyari».   
\q1
\v 15 Naitɨ netukari 'ahetsie katini'aneni,  
\q2 memɨnetsi'aye'unie meta memɨnetsi'uweiya wahetsɨa keneneuxɨna.   
\q1
\v 16 Meti'uximayatsiriwame hetsie keyuhekɨare ke'aixɨa pemɨtiuka'iyari,  
\q2 waɨkawa pemɨtiuyukanaki'eriekɨ, keneneutawikweitsitɨa.   
\q1
\v 17 Yawé, pepɨkawapitɨaka memɨnetsitewinɨanikɨ,  
\q2 'ekɨ nemetsihahiwiwakɨ pemɨnetsiparewienikɨ.  
\q1 Mɨkɨ pɨta mekete'uyutewinɨani 'axateyuruwamete,  
\q2 teukiyapa keniwareukaxɨri.   
\q1
\v 18 Memɨte'itawa wateni kayuwatɨ keneupitɨa,  
\q2 'aixɨa memɨte'u'iyari wahepaɨtsita memeuniukakɨ  
\q2 meyutemamawietɨ, 'axame'utiyuatɨ.   
\b  
\q1
\v 19 Pɨmariwe ke'aixɨa pemɨtiuka'iyari,  
\q2 witsipepɨtiwaxeiya kemɨ'ane memɨmatsi'ayemakaxe,  
\q1 teɨteri wahɨxie 'aixɨa pepɨwayurie  
\q2 kemɨ'ane 'ahetsɨa memuyu'awieta.   
\q1
\v 20 'Ahɨxie me'u'uwakaku pepɨwa'ɨwiya  
\q2 teɨteri 'axamemɨwayuriekɨ,  
\q1 'Akiita pe'ayekaitɨ pepɨwa'ɨwiya  
\q2 'axamemutiyuane wahepaɨtsita.   
\q1
\v 21 'Aixɨa ke'itɨarieka Yawé,  
\q2 nehetsiemieme yunaki'eriya mɨmariwe mɨyetuakɨ  
\q2 kepauka kiekari 'anutinamiekaku nemuyeikakaitsie.   
\q1
\v 22 Kepauka nemɨhɨxiyakaitsie mɨpaɨ neputayɨ:  
\q2 «'Ari 'ahɨxie ne'uyeikatɨ nepɨwayehɨiya».  
\q1 Peru pepɨnetsi'u'eni 'ekɨ kenemetiwawiriekai  
\q2 kepauka parewiya nemetsi'utawawiri.   
\b  
\q1
\v 23 Yawé xekenenaki'erieka, yunaitɨ xemei'enie,  
\q2 mɨkɨ kaniwa'ɨwiyani kemɨ'ane 'aixɨa mɨtiwamate,  
\q2 kemɨ'aneta memuyuti'ɨre tita mɨtiwahetsiemieme yakatiniwarakapitɨwani.   
\q1
\v 24 Xekeneyuwaɨriyani, xekeneyukuha'aritɨa xemɨyɨwawenikɨ,  
\q2 yunaitɨ kemɨ'ane Yawé hetsiemieme xemɨtetakwewie.   
\c 32  
\d Rawiri nɨawarieya. Wa'ɨkitsika.  
\q1
\v 1 Keyutemawieka kemɨ'ane  
\q2 'inɨari niukiyari heutitsanaxɨaka mɨreuyehɨwiyarie,  
\q2 kemɨ'ane 'axatiuyurieka mu'itiya.   
\q1
\v 2 Keyutemawieka 'iya  
\q2 kemɨ'ane Yawé 'atsimɨkarehɨawe kename 'axatiyuriene  
\q2 meta 'iyarieyatsie kwamanarika mumawe.   
\q1
\v 3 Kepauka kayuwatɨ nemɨtiuya,  
\q2 ne'umeyari kaniutixɨni  
\q2 nemutatsuakakaikɨ tukarikɨ.   
\q1
\v 4 Waɨkawa nekaheutɨrɨkaɨyetɨ nekanayani  
\q2 taxarita xɨrikɨ ketemɨtetiweranare hepaɨ,  
\q1 tukarikɨ tɨkarikɨ pemɨnetikwinitɨakaikɨ.   
\b  
\q1
\v 5 Peru nekaniuyutahekɨata 'ahɨxie ke'axanemɨtiuyuri,  
\q2 ke'axanemɨtiuyuri nepɨkamatiuti'awitsiri.  
\q1 Mɨpaɨ nekatiniuyuhɨawe: «Nepitaxatɨani Yawé ke'axanemɨtiuyuri»,  
\q2 'ekɨta pekanetineuyehɨwirieni naime ke'axanemɨtiuyuri.   
\b  
\q1
\v 6 'Ayumieme 'ahetsiemieme 'aixɨa memɨteyurie mepɨmatsihahɨawe,  
\q2 kepauka memu'uximatɨarie,  
\q1 tsepa haa 'amuparixɨ  
\q2 mɨkɨ wahetsɨa pɨkaheuti'ani.   
\q1
\v 7 'Ekɨ nehetsie nunuwame pepɨhɨkɨ,  
\q2 'ekɨ netsi'ɨwiyame pepɨhɨkɨ kepauka nemɨyekweriwa'itɨariene,  
\q2 'ana kwikari pekanenipitɨamɨkɨ kenemɨrayu'iwaxɨ hetsiemieme.   
\b  
\q1
\v 8 Yawé mɨpaɨ kanaineni:  
\q1 «Ne petimaikame nekamenayeitɨamɨkɨ,  
\q2 huye ke'aneme pemuweiyani ne nekamenixeiyatsitɨamɨkɨ,  
\q2 ne nekamenita'ɨxatsitɨamɨkɨ, meta nekamenita'ɨwiyamɨkɨ.   
\q1
\v 9 Muratsixi meta kawayutsixi wahepaɨ pepɨka'aneni,  
\q2 memɨkatemaiwawe,  
\q1 kepauka pemimaxiutatsie pirenuya 'utakekame xeikɨa kaniyɨweni,  
\q2 'ahurawa pemehanakɨ».   
\b  
\q1
\v 10 'Axateyuruwamete wa'uximatɨarika tiwaɨkawatɨ pɨtiwatakwewie,  
\q2 peru Yawé hetsie memɨtewiya  
\q2 pɨwaranukanama yunaki'eriyakɨ.   
\b  
\q1
\v 11 Xekeneyutemamawieka xeme xehetsie mɨkarahɨiwa,  
\q2 xekeneyutemamawieka Yawé hetsie,  
\q1 xekeneutikwikani xeme xeyunaitɨ  
\q2 xe'iyari mɨ'itiyatɨka.   
\c 33  
\q1
\v 1 Yawé xekenenɨawani yutemawierima xeme xehetsie mɨkarahɨiwa,  
\q2 'aixɨa memɨtekahu kaniwahetsiemiemetɨni Yawé hetsiemieme memutikwikanikɨ.   
\q1
\v 2 Yawé xekenenɨawani kanari hayuanekaku,  
\q2 xekeneutikwikani xaweri hayuanekaku.   
\q1
\v 3 Kwikari hekwame hɨxiena xekeneutakwika,  
\q2 xeketeneyuitɨaka xeyutemamawietɨ,  
\q2 meta temawierika hiwariyari xekenewewieka.   
\b  
\q1
\v 4 Yawé niukieya kaniheitserieka  
\q2 'aixɨa katini'aneneni naime tita mɨtiutiwewi.   
\q1
\v 5 Yawé 'aixɨa mɨti'ane meta mɨtiheitserie katininaki'erieka,  
\q2 naki'eriyaya kwiepa kanakɨnɨka.   
\b  
\q1
\v 6 Yawé niukieyakɨ muyuawi kaniuneni,  
\q2 'iiyayakɨ xurawetsixi mekaniutixuawere.   
\q1
\v 7 Mɨkɨ haramaratsie haa panatihanɨwe xarita,  
\q2 meta xariteta haramara 'ameukatewa kanikuxexeɨriwani.   
\q1
\v 8 Yunaitɨ kwiepa xemɨtama Yawé xekenayemakaka,  
\q2 yunaitɨ teɨteri mana kiekatari xekenayexeiyani,   
\q1
\v 9 mɨkɨ 'utaniuku, naitɨ pɨtiune,  
\q2 mɨkɨ tiuta'aitaku, naitɨ 'aixɨa pɨtiuyɨ.   
\q1
\v 10 Nuiwarite kwiepa memɨtama kememɨteyuriku Yawé pɨkawapitɨa memeye'atɨanikɨ,  
\q2 ke'axamemɨteyuriku teɨteri pɨkawapitɨa.   
\q1
\v 11 Peru Yawé kemɨtiyurimɨkɨ, yapɨtikɨyɨne yuheyemekɨ,  
\q2 kemɨtiku'eriwa peye'atɨwa.   
\b  
\q1
\v 12 'Iya nuiwari keyutemawieka Kakaɨyarieya Yawé mɨhɨkɨkɨ,  
\q2 yuteɨterima mɨwaranayexei hetsiena mieme memɨhɨkɨtɨnikɨ.   
\q1
\v 13 Yawé muyuawitsie paitɨ pɨtaniere,  
\q2 pɨwaxeiya yunaime teɨteri,   
\q1
\v 14 mɨkɨ pɨwataxeiya yu'uwenitsie paitɨ 'akaitɨ,  
\q2 yunaime teɨteri kwiepa memɨtama.   
\q1
\v 15 Mɨkɨ pɨhɨkɨ yunaime 'iyari mɨwarutiwewiri,  
\q2 kememɨteyurie naime pɨtimate.   
\q1
\v 16 Ti'aitame pɨkayutawikweitsitɨwa tsepanetɨ kuyaxi yuwaɨkawame mɨwarexeiya,  
\q2 meta tiyumemiwame kwinimieme mɨtiyɨwe waɨkawa mɨtɨrɨkaɨyekɨ pɨkatawikweni.   
\q1
\v 17 Tixaɨtɨ pɨkatihɨkɨ kawayutsixi wahetsie teyukwitɨwetɨ temɨte'ayu'iwakɨ,  
\q2 tsepa waɨkawa mɨtɨrɨkaɨye pɨkatiyuwikweitsitɨwa.   
\q1
\v 18 Matsi Yawé pɨwa'ɨwiya memeyemakaxe,  
\q2 naki'eriyayatsie memɨtewiya,   
\q1
\v 19 kepauka memɨkwi'iwarɨmeni wahetsie kaninuaka,  
\q2 kepauka haakaxa mayeikatsie, pɨkawapitɨa memɨkwinikɨ.   
\b  
\q1
\v 20 Yemekɨ 'aixɨa 'iyari Yawé hetsie tetewiyatɨ tepɨtetakwewie,  
\q2 mɨkɨ tatsiparewiwame pɨhɨkɨ meta tahetsie nunuwame.   
\q1
\v 21 Ta'iyari puyutemawie hetsiena mieme,  
\q2 mɨpatsietsie temɨtewiyakɨ.   
\q1
\v 22 Yawé, 'anaki'eriya mɨmariwe, tahamatɨa yaketiuyeikani,  
\q2 yemekɨ ketemɨte'itakwewie 'ahetsiemieme.   
\c 34  
\d Rawiri nɨawarieya, kepauka mɨtiu'ita mɨka'uka'iyarini hepaɨ 'anetɨ hayuyeitɨaka 'Awimereki hɨxie, wayehɨiyaka kemɨretɨa.  
\q1
\v 1 Yawé hepaɨtsita 'aixɨa neputaineni yuheyemekɨ,  
\q2 netenikɨ yanepɨtinɨawani.   
\q1
\v 2 Ne'iyari Yawé pɨnɨawa,  
\q2 nitixaɨtɨ memɨkate'ayuyeitɨa me'enaname meyutemawietɨ mepakɨne.   
\q1
\v 3 Mariweme Yawé xekenayeitɨwani nehamatɨa,  
\q2 teyuxewitɨ tepinɨawani kemɨtimariwe.   
\b  
\q1
\v 4 Yawé nekaniutiwauni, mɨkɨta pɨnetsi'uta'ei,  
\q2 waɨkawa nemakaku naime pɨnetiunawairi.   
\q1
\v 5 Yunaitɨ memehɨawe mekaniyutemamawieka mehekɨariwietɨ,  
\q2 hatsuaku me'ayukatewiwiyatɨ mepɨkahakɨka.   
\q1
\v 6 Ne tixaɨtɨ nekatihɨkɨtɨtɨ Yawé nekaniutahɨawe, mɨkɨ kaneniu'enieni,  
\q2 kaneniɨxɨna naime kenemɨtiuka'eniwakai.   
\q1
\v 7 Yawé niuki tuayameya tihɨweme kaneyenɨ'awani memeyexeiya mɨwa'ɨwiyanikɨ,  
\q2 wa'aurie kaniuyeikani waparewienike.   
\b  
\q1
\v 8 Xeketeneuta'inɨata, xeketenetimati Yawé 'aixɨa kemɨtiuka'iyari,  
\q2 xekeneyutemamawieka kemɨ'ane hetsiena xemuyu'awieta.   
\q1
\v 9 Yawé xekenemakaka, xeme hetsɨana miemete xemɨpatsie,  
\q2 neuxei yunaitɨ memeyemakaxe tixaɨtɨ pɨkatiwareuyehɨwa.   
\q1
\v 10 Mayetsi tɨɨrixi mepɨtiweranare meta mepeuhaakakwiku,  
\q2 peru kemɨ'ane Yawé memukuwautɨwe tixaɨtɨ pɨkatiwareuyehɨwa.   
\b  
\q1
\v 11 Xekenakɨni tɨɨri, xekeneneu'eni,  
\q2 Yawé kehepaɨ mɨrayemakaxenikɨ nepɨtixeta'ɨkitɨani.   
\q1
\v 12 Kemɨ'ane tukari meuyehuwa,  
\q2 kemɨ'ane tukari witsi'anemetsie meuyeimɨkɨ,   
\q1
\v 13 yuneni ke'upirenutɨani 'axamɨti'ane mɨkatikuxatanikɨ  
\q2 meta yutenietsie ke'uwiere 'itarika mɨkatikuxatanikɨ,   
\q1
\v 14 'axatiyurienetɨ ketiuhayewa, 'aixɨa pɨta ketiyurieneni,  
\q2 kayuwatɨ muyeikanikɨ keyumexɨitɨaka, mɨpaɨ xeikɨa ketiuyeikani.   
\q1
\v 15 Yawé 'aixɨa memɨteyurie kaniwaxeiyani,  
\q2 wanenewieri yapauka kani'enieka,   
\q1
\v 16 'axamemɨteyurie Yawé pɨwaraye'unie,  
\q2 kwiepa mɨwarakuyeitɨanikɨ.   
\b  
\q1
\v 17 Wahetsie mɨkarahɨiwa Yawé mekanahɨaweni, mɨkɨta kaniwa'enieka,  
\q2 kememɨte'uximatɨarie naimekɨ kaniwaparewieka.   
\q1
\v 18 Kemɨ'ane yu'iyaritsie memɨte'uka'eniwa Yawé wa'aurie 'ahurawa kaniutiweni,  
\q2 kemɨ'ane yu'iyaritsie memuyutsaipɨna kaniwarutawikweitsitɨwani.   
\b  
\q1
\v 19 Hetsiena mɨkarahɨiwa 'uximatɨarikaya pɨmɨire,  
\q2 Yawé matsi naimekɨ kaniwaparewieka,   
\q1
\v 20 'umeteya naime pɨ'ɨwiya,  
\q2 nixeimetɨma pɨka'akamuriyarieni.   
\b  
\q1
\v 21 'Axamɨti'ane 'axateyuruwamete pɨwaka'una,  
\q2 wahetsie mɨkarahɨiwa memɨwaraye'unie mekananutaxɨriyakuni.   
\q1
\v 22 Yawé te'i'uximayatsiriwamete wahetsie kaninuaka,  
\q2 mepɨka'anutaxɨriyani hetsiena memɨtewiya.   
\c 35  
\d Rawiri nɨawarieya.  
\q1
\v 1 Yawé, nepumieriene, nehetsie keneutanua,  
\q2 keniwarutakuya kemɨ'ane memɨnetsimietɨwe.   
\q1
\v 2 Tepɨa kamixayari kenanakatɨtɨ meta tepɨa 'amɨyewa  
\q2 kene'akuha'aritɨaka nehetsɨa kenenua pemɨnetsiparewienikɨ.   
\q1
\v 3 'Apitsika keneutikwe'i meta 'ahatsa,  
\q2 memɨnetsi'uweiya wahɨxie keneukexi.  
\q1 Mɨpaɨ keneutayɨki:  
\q2 «Ne 'awikweitsitɨwame nepɨhɨkɨ».   
\b  
\q1
\v 4 Meke'uhɨxiyani meke'uyutitetewiya  
\q2 kemɨ'ane memɨnetsimieku,  
\q1 meke'ukunuaxɨani meyutetewiyatɨ  
\q2 'axamemɨnetsiyuriku.   
\q1
\v 5 'Ɨxa hepaɨ mekehe'enitsitɨarieni,  
\q2 niuki tuayame Yawé hetsɨa mieme wakwinekaku,   
\q1
\v 6 wahuyeta ke'uyɨwini meta ke'uharuanini,  
\q2 niuki tuayame Yawé hetsɨa mieme waruweiyakaku.   
\q1
\v 7 Nitixaɨtɨ wahetsiemieme nekarayexeiyakaku memɨnetsi'uwiniyaxɨkɨ,  
\q2 nitixaɨtɨ wahetsiemieme nekarayexeiyakaku nehetsiemieme meputi'inixɨ,   
\q1
\v 8 haweri me'anenetɨ 'uxa'atɨniwarie meke'akɨne,  
\q2 yuwiniyarita mekeheukaxɨrieni,  
\q2 putsu memitawewita.   
\b  
\q1
\v 9 Mɨpaɨ ne'iyari pɨtiyutemawieka Yawé hetsie,  
\q2 puyutemawieka mutawikweitsitɨariekɨ,   
\q1
\v 10 'ana mɨpaɨ yemekɨ nepɨtayɨni:  
\q2 «Xewitɨ pumawe 'ahepaɨ 'anetɨ Yawé.  
\q1 'Ekɨ pepɨwawikweitsitɨa haweri memɨyɨa memɨtɨrɨkawi wahetsɨa,  
\q2 haweri memɨ'anene meta tixaɨtɨ memɨkateheuxeiya pepɨwawikweitsitɨa  
\q2 memɨtewa'uximayatsitɨa wahetsɨa».   
\b  
\q1
\v 11 Mete'itawatɨ menetsitaxanetake mepɨ'axe,  
\q2 menetsita'iwawiyake tita 'atsinemɨkatimatekɨ.   
\q1
\v 12 Ne newanenimayakaku 'axa'anemekɨ mepɨnete'akapitɨwa,  
\q2 mɨkɨkɨ pɨnetsihekukukuine ne'iyaritsie,   
\q1
\v 13 metsɨ kepauka mɨkɨ memɨtekukuyeni  
\q2 ne hiwerika kamixayari nepanakatɨkɨkai,  
\q2 nenutuixietɨ nepayeikakai nepɨnetihakiwakai.  
\b  
\q1 Ne matsi nepɨnenenewiekai ne pɨta nemɨtikuyenikɨ.   
\b  
\q1
\v 14 Ne hiwerika kamixayari nepanakatɨkɨkai,  
\q2 nehamiku hetsiemieme hepaɨ, yatɨni ne'iwa hetsiemieme hepaɨ.  
\q1 Nenutuixietɨ nepakatutsitakai,  
\q2 nemaama hetsiemieme nemutatsuakani hepaɨ ne'anetɨ.   
\q1
\v 15 Peru kepauka ne nemekawe, mɨkɨ mepuyukatemamawi,  
\q2 mepuyukuxeɨri nehepaɨtsita metekuxatatɨ.  
\q1 Teɨteri ne nemɨkawamatekai,  
\q2 mekaneniuyeheka nehepaɨtsita meniukixietɨ mekatehayewatɨ mekanakɨne.   
\q1
\v 16 Waɨkawa mepɨnetsimariutakai, mepɨnetsinanaimakai,  
\q2 nehepaɨtsita yutamete meputixikautekekai.   
\b  
\q1
\v 17 Ti'aitame, ¿kepaukake 'ikɨ 'aixɨa pepɨtiyurieni?  
\q1 Netukari keneutawikweitsitɨa, netukari muyuxewi,  
\q2 mayetsi mepɨnetsitakwaixime.   
\q1
\v 18 Ne pamɨpariyutsi nepɨmetsipitɨani yumɨireme wahɨxie,  
\q2 yuwaɨkawame wahɨxie nepɨmetsitanɨawa.   
\b  
\q1
\v 19 Pepɨkawapitɨaka memɨnetsiyuriyanikɨ,  
\q2 memɨnetsi'aye'unie meteyukwamanatɨ.  
\q1 Memɨnetsinanaimaka pepɨkawapitɨaka  
\q2 'atsinekawayurienekaku.   
\q1
\v 20 'Aixɨa metekuxatatɨ mepɨka'u'uwa,  
\q2 matsi 'itarika mepɨwewie  
\q2 'ikɨ kwieyaritsie 'aixɨa memɨte'u'uwa wahepaɨtsita.   
\q1
\v 21 Karima meputinawe, meta mɨpaɨ meputiyuane:  
\q2 «Neuxeitsɨkuta yaranuyetɨa».   
\b  
\q1
\v 22 Yawé, 'ekɨ naime 'ikɨ pepɨtixeiya,  
\q2 matsi pepɨkaranukanaka.  
\q2 Ti'aitame, pepɨkanetsi'uku'e'eiriwani.   
\q1
\v 23 Kenanutanieri, kenanukukexi nekakaɨyari.  
\q2 Nehetsiemieme 'aixɨa ketineuyuri Ti'aitame, nehetsie keneutanua.   
\q1
\v 24 Nehetsiemieme 'aixɨa ketineuyuri heitserie kepemɨrexeiya, Yawé nekakaɨyari,  
\q2 memɨnetsinanaimaka pepɨkawapitɨaka.   
\q1
\v 25 Pepɨkawapitɨaka mɨpaɨ memɨteku'eriwanikɨ:  
\q2 «Mɨpaɨ tepɨteheixeiyakukai».  
\q1 Mɨpaɨta memɨtiyuani pepɨkawapitɨaka:  
\q2 «Tepenukaxɨ yemekɨ 'ayeniereme».   
\b  
\q1
\v 26 Meke'uyutitetewiya meta meke'u'iyɨrieni  
\q2 yunaitɨ kemɨ'ane memuyutemamawie nemekawekɨ,  
\q1 meke'utixani'eriwa mekeheutewiyarieka  
\q2 yunaitɨ kemɨ'ane tixaɨtɨ memɨkanete'erie.   
\q1
\v 27 Peru meke'utihiwa temawierikakɨ  
\q2 kemɨ'ane memɨnetsiparewie,  
\q1 meta mɨpaɨ yuheyemekɨ meke'utiyuaneni: «Yawé 'aixɨa ketikuxaxatsiwani,  
\q2 'iparewiwame 'aixɨa mɨtiuyeika minakekɨ».   
\b  
\q1
\v 28 Ne ke'aixɨa pemɨtiuka'iyari nepukuxataneni,  
\q2 tukari mɨyehane 'ahetsiemieme kwikari nepukwikani.   
\c 36  
\d Teyuitɨwamete wa'ukiyari. Rawiri kwikarieya, Yawé parewiwameya.  
\q1
\v 1 'Axatiyuruwame mɨpaɨ kanaineni:  
\q2 «Kakaɨyari neka'ayexeiyatɨ ne'iyaritsie paitɨ yanepɨ'ane».  
\q1 Kemɨtixeiya Kakaɨyari  
\q2 pɨkamakaxe.   
\q1
\v 2 Mɨpaɨ pɨtiku'eriwa kename 'aixɨa tiuka'iyari  
\q2 'axamɨti'ane pɨkaxani'erie.   
\q1
\v 3 Yakɨ xeikɨa pɨtikuxata pɨtiyukananaima,  
\q2 'aixɨa mɨti'ane kaneuyehɨani  
\q2 meta 'aixɨa mɨtiyurienenikɨ.   
\q1
\v 4 Yu'utatsie kakaitɨ 'axamɨtiyurienikɨ xeikɨa pɨtiku'eriwa,  
\q2 'axamɨ'ane huyeyari pɨkataunie,  
\q2 'axamɨti'ane pɨkatiku'eiriwe.   
\b  
\q1
\v 5 Yawé, 'anaki'eriya muyuawitsie paitɨ pɨye'axe,  
\q2 kepemɨkatiyupata haitsie paitɨ pɨye'axe.   
\q1
\v 6 Kemɨtiheitserie 'ahetsɨa mieme hɨri 'amutɨtɨ hepaɨ pɨ'ane,  
\q2 ke'aixɨa pemɨtiyuriene haramara mɨmariwe 'emeukatewa hepaɨ pɨ'ane.  
\b  
\q1 Yawé, 'ekɨ pepɨwa'ɨwiya teɨteri meta yeuta memɨte'u'uwa,   
\q2
\v 7 witsipɨ'ane 'anaki'eriya mɨmariwe, Kakaɨyari.  
\q1 Yunaitɨ teɨteri mepikaxexeiya memuyu'awietanikɨ  
\q2 'a'anate 'etɨriyayatɨa.   
\q1
\v 8 'Akie meputihuxarɨwe naitɨ mɨtixuawekɨ,  
\q2 'ahaa 'aixɨa ma'ane muwanake pepɨwaharitɨa.   
\q1
\v 9 'Ahetsie tukari mɨtiwiekɨ,  
\q2 'Ahekɨariyapa te'u'uwatɨ hekɨariya temuxeiya tepɨyɨwawe.   
\b  
\q1
\v 10 Kenewanaki'erieka kemɨ'ane memɨmetsimate,  
\q2 heitserie memexeiya wahetsiemieme 'aixɨa ketineyurieneni.   
\q1
\v 11 Kwinimieme mɨtiyutamariwekata pɨkanetsitaketsinani,  
\q2 Kakaɨyari mɨka'ayexeiya 'axamɨkanetsiyurienikɨ pepɨka'ipitɨaka.   
\b  
\q1
\v 12 Xekeniwaruxeiya kememɨtehekaxɨrɨwe 'axateyuruwamete:  
\q2 Kepauka memekaxɨrɨwe kwiepa, tawarita memanuku'uni mepɨkayɨwawe.   
\c 37  
\d Rawiri nɨawarieya.  
\q1
\v 1 Pepɨka'a'iyaritɨaka Kakayari memɨka'ayexeiya kememɨteyuriekɨ,  
\q2 meta pepɨkatihiwe'erieka tita memɨtehexeiya heitseriemekɨ yamemɨkatekahu,   
\q1
\v 2 yapauka mɨtiyɨnarekɨ tupiriya hepaɨ,  
\q2 yapauka mepɨtiwauke 'ɨxa mɨtsitsiɨrawi hepaɨ.   
\b  
\q1
\v 3 'Ekɨ Yawé hetsie ketinewiyani, 'aixɨa ketineyurieneni,  
\q2 kwiepa keneuyeikani meta 'aixɨa ketinekamieni.   
\q1
\v 4 Yawé 'anaki'eriya keneyetuiri,  
\q2 mɨkɨ pɨmetiyetuirieni tita pemɨreuyehɨwa 'a'iyarikɨ.   
\b  
\q1
\v 5 Yawé 'ahuye kenehɨritɨaka,  
\q2 hetsiena ketinewiyani, mɨkɨta yapɨtiyurieni 'ahetsiemieme.   
\q1
\v 6 Mɨpaɨ kepauka pemɨtaxanetsieni 'aixɨa mɨti'ane 'ahetsie pɨhekɨariwieximeni,  
\q2 keheitserie pemɨrexeiya pɨhekɨaka tuka hepaɨ.   
\b  
\q1
\v 7 Kayuwatɨ pekaniukixietɨ keneuyeikani Yawé hɨxie,  
\q2 petiuka'eniwatɨ hetsienamieme ketinetakwewieka,  
\q1 Pepɨka'ahɨaweni hipatɨ kememɨte'ukaxexeiya wahetsiemieme,  
\q2 kememɨteku'eriwa 'axamemɨteyurie wahepaɨ.   
\b  
\q1
\v 8 Ketineuhayewa peha'atɨ, keneuku'eiri haxɨa,  
\q2 pepɨka'utaweranareni, mɨkɨ 'axamɨ'anetsie katiniyu'iniwani.   
\q1
\v 9 Karikɨ Kakaɨyari memɨka'ayexeiya mekanakumaweriyariekuni,  
\q2 matsi kemɨ'ane Yawé hetsiemieme memɨtetakwewie, kwie mekaniyetuiriyariekuni.   
\b  
\q1
\v 10 'Apɨkareutereri 'axateyuruwamete memɨka'u'uwanikɨ,  
\q2 tsepa 'aheyemekɨ pemɨwarutiwau pepɨkawataxeiya.   
\q1
\v 11 Peru kemɨ'ane kayuwatɨ memu'uwa kwie mekanimikiekuni,  
\q2 yu'iyarikɨ 'aixɨa mekateniu'uwakuni.   
\b  
\q1
\v 12 'Axateyuruwamete 'aixɨa memɨte'u'uwa mepɨwaheka,  
\q2 yutamete mekaniutixikautekeni wahetsiemieme.   
\q1
\v 13 Matsi Yawé kaniutanaweni 'axateyuruwamete wahetsiemieme,  
\q2 timaitɨ watukari maye'aximekɨ.   
\b  
\q1
\v 14 'Axateyuruwamete yu'ixipara mekanewatihapanani, yutupi mekanahapanani,  
\q2 tixaɨtɨ mɨkarexeiya meta mɨreuyehɨwa memɨwaratixɨrienikɨ,  
\q2 'aixɨa memɨte'u'uwa memɨwakwinikɨ.   
\q1
\v 15 Wa'ixiparatɨtɨ wa'iyaritsie kaniuyekemɨkɨ,  
\q2 watupi kanitimurixɨamɨkɨ.   
\b  
\q1
\v 16 'Aixɨa pɨ'ane kemɨ'ane 'aixɨa mɨtiuka'iyari 'etsiwa xeikɨa rexeiyatɨ,  
\q2 keyuri 'axateyuruwamete waɨkawa kememɨtehexeiya,   
\q1
\v 17 matsi Kakaɨyari memɨka'ayexeiya watɨrɨkariya kaneutiparitɨariemɨkɨ,  
\q2 peru Yawé heitserie memexeiya kaniwaparewimɨkɨ.   
\b  
\q1
\v 18 Yawé 'aixɨa memɨte'u'uwa watukari kani'ɨwiyani,  
\q2 tita memɨteyetuiriyarieni pɨtiwahetsiemiemetɨni yuheyemekɨ.   
\q1
\v 19 Kepauka 'uximatɨarika tukariyari maye'ani mepɨtekaxeiya,  
\q2 haakaxa tukariyaritsie waɨkawa mepɨtehexeiyani.   
\b  
\q1
\v 20 'Axateyuruwamete, Yawé memaye'unie,  
\q2 mekanikumawerikuni kepauka memeuyehɨiyani.  
\q1 Mekanikumawerikuni tuturi yeuta mieme hepaɨ,  
\q2 kɨtsi kemɨtitaparike mɨpaɨ mekaniyɨkuni.   
\b  
\q1
\v 21 'Axamemɨte'u'iyari mekaniyuniɨrɨweni, peru mepɨkateyutuarita,  
\q2 matsi heitserie memexeiya mepɨteyumikwa 'aixɨa 'anemekɨ.   
\q1
\v 22 Yawé 'aixɨa mɨwayurie, kwie mekaniyetuiriyariekuni,  
\q2 peru kemɨ'ane mɨkɨ 'axamɨwayurie mekanikumaweriyariekuni.   
\b  
\q1
\v 23 Yawé tewi kaniheitseritɨaka 'aixɨa 'anemekɨ mumienikɨ,  
\q2 kepauka minake kemɨtiuyeikanikɨ,   
\q1
\v 24 tsepa metiwitsei pɨkahekaweni,  
\q2 Yawé yumamakɨ miwiyakɨ.   
\b  
\q1
\v 25 Ne temaikɨ nepatɨa, hikɨri nepu'ukiratsi,  
\q2 peru hatsuaku heitserie memexeiya haweri mɨraku'ane nepɨkawaxeiyawe,  
\q2 meta waniwema paa hawaikɨ mepɨkahewauka.   
\q1
\v 26 Yuheyemekɨ meyutemamawietɨ 'aixɨa 'anemekɨ mepɨtewaniɨtɨa,  
\q2 waniwema wahekɨ 'aixɨa mepɨ'itɨarie hipatɨ.   
\b  
\q1
\v 27 'Axapetiyurienetɨ ketineuhayewa, 'aixɨa pɨta ketineyurieneni,  
\q2 'ana yuheyemekɨ mana pepuyeikani hakewa pemekani.   
\q1
\v 28 Karikɨ Yawé 'aixɨa mɨti'ane katininaki'erieka,  
\q2 meta pɨkawanutuita kemɨ'ane yu'iyarikɨ meminaki'erie.  
\b  
\q1 Yawé kaniwa'ɨwiyakamɨkɨ yuhemekɨ,  
\q2 peru 'axateyuruwamete wanuiwari kaniwarakumaweriyamɨkɨ.   
\q1
\v 29 Heitserie memexeiya kwie mepɨyetuiriyarieni,  
\q2 yuheyemekɨ mana mepu'uwani.   
\b  
\q1
\v 30 Heitserie mexeiya kemɨtimaiwe pɨtikuxata,  
\q2 niukieya tita mɨtihetserie puweiya.   
\q1
\v 31 Kakaɨyari 'aitsikaya 'iyarieyatsie kaniyekani,  
\q2 hatsuaku mepɨkahekaxɨrɨwe.   
\b  
\q1
\v 32 'Axamemɨte'u'iyari 'aixɨa memɨte'u'iyari,  
\q2 mekaniwakuhupiwani mewakwikutɨ.   
\q1
\v 33 Peru Yawé pɨkawapitɨani yamemɨwayurienikɨ,  
\q2 meta yapɨkaretanaki'erieni memanutaxɨriyanitsie.   
\b  
\q1
\v 34 Peru 'ekɨ, Yawé hetsie timieme ketinetakwewieka,  
\q2 meta yaketineuyeikani kemɨtinake,  
\q2 mɨkɨ kamenetemawieritɨamɨkɨ kwie pemɨyetuiriyarienikɨ.  
\q1 Kepauka 'axateyuruwamete memɨka'unarieni,  
\q2 'ekɨ pekaniwaxeiyamɨkɨ.   
\b  
\q1
\v 35 Ne nepixei 'axatiyuruwame mariweme,  
\q2 kariuxa hepaɨ ranukaime.   
\q1
\v 36 Matsi kaniukumawere,  
\q2 nemitiwau nepɨka'itaxeiri.   
\b  
\q1
\v 37 Kwi keniwaruxeiyata 'aixɨa memɨtekahu:  
\q2 tukari 'upamie kayuwatɨ memɨkuwautɨwe wahetsiemieme.   
\q1
\v 38 Peru yunaitɨ 'axateyuruwamete mekanikumaweriyariekuni,  
\q2 tukari 'umamie 'axateyuruwamete wahetsiemieme memeuyehɨiyani tukariyari kanihɨkɨtɨni.   
\b  
\q1
\v 39 Heitserie memexeiya wawikweitsitɨarika Yawé hetsie kanayeneikani,  
\q2 mɨkɨ mɨwatɨrɨkariya kanihɨkɨtɨni kepauka memɨte'uka'eniwatsie.   
\q1
\v 40 Yawé kaniwaparewieka meta kaniwaxɨnani,  
\q2 'axateyuruwamete wahetsie kaniwaxɨnani meta kaniwawikweitsitɨaka,  
\q2 mɨkɨ hetsie mekaneuwawaɨreni.   
\c 38  
\d Rawiri nɨawarieya, mawari hetsiemieme.  
\q1
\v 1 Yawé, kepauka pemɨha'a pepɨkanetsi 'utate'ani,  
\q2 peha'atɨ pepɨkanetikwinitɨaka.   
\q1
\v 2 'A'ɨrɨ nehetsie kaniuye'uniri,  
\q2 nehetsie 'atɨrɨkariya kaniukaweni.   
\q1
\v 3 Naitɨ newaiyari pɨtikuye pemɨha'akɨ nehepaɨtsita  
\q2 hawaikɨ tɨma newaiyaritsie 'aixɨa nepɨkareu'erie,  
\q1 waɨkawamekɨ 'axanemɨtiuyurikɨ,  
\q2 ne'umete mɨyapɨtiuka'eniwa.   
\q1
\v 4 Nepɨka'ikemari 'axamɨti'ane,  
\q2 mɨkɨ 'ika kwinimieme pɨrahete.   
\b  
\q1
\v 5 Nemɨka'uka'iyarikɨ  
\q2 nehaiya kaniyepɨnirɨmeni 'axakaniukɨ'ɨareni.   
\q1
\v 6 Nepu'uxeri, waɨkawamekɨ nepɨnemuina,  
\q2 tukarikɨ nenutuixietɨ nepuyeika.   
\q1
\v 7 Netaɨta nepɨta'a hɨiyakɨ,  
\q2 naitɨ newaiyaritsie tɨma 'aixɨa nepɨkareu'erie.   
\q1
\v 8 Nepɨwerani, nemehɨiyani hepaɨ nepɨreu'erie,  
\q2 ne'iyari puta'aiwa tiuka'eniwatɨ.   
\b  
\q1
\v 9 Ti'aitame, nepɨmetsiyetuirie yemekɨ tita nemɨreuyehɨwa,  
\q2 'ekɨ 'ahepaɨtsita pɨkati'awietɨ.   
\q1
\v 10 Kwinimieme pɨtiɨtɨrarɨka ne'iyari,  
\q2 nepɨkaheutɨrɨkaɨyeri,  
\q2 'ari nepɨkaniereri.   
\q1
\v 11 Nehamikuma meta memɨnetsimate nehaiya mekanimakaxeni,  
\q2 ne'iwama 'ateewa xeikɨa mekaniu'uwani.   
\q1
\v 12 Winiyari mekaniuwɨwɨtɨwani memɨnetsimieku,  
\q2 kemɨ'ane 'axa'anekɨa memɨnetsihɨaku mepɨkatehayewa yameteku'eriwatɨ,  
\q2 tukarikɨ nehetsiemieme xeikɨa mepɨtekuxata.   
\b  
\q1
\v 13 Peru ne mɨkaheu'ena nepaneyeitɨwa, nepɨkawa'enie,  
\q2 nekaniuweme nepaneyeitɨwa, 'atsinepɨkatiwaku'eiya.   
\q1
\v 14 Memɨkaheu'enana wahepaɨ nepɨ'ane  
\q2 meta memɨyɨkɨhɨani memɨkayɨwawe wahepaɨ.   
\q1
\v 15 Yawé, ne nepɨmetsitakwewie,  
\q2 'ekɨ neti'aitɨwame, nekakaɨyari, 'ekɨ pepɨyɨaneni nehetsiemieme pemɨwata'eiya.   
\q1
\v 16 Nepɨmetsiwawirie xeikɨa mepɨkanetsinanaimaka,  
\q2 memamariwaweme mepɨka'ayuyeitɨaka kepauka nemekawenitsie.   
\b  
\q1
\v 17 'Ari nekanimɨximeni,  
\q2 kukuiniya pɨkanetsihayewa 'etsiwatɨma.   
\q1
\v 18 Ke'axanemɨtiuyuri nepɨnetahekɨata,  
\q2 'axamɨti'ane pɨnetsi'iyarimɨtsitɨa.   
\q1
\v 19 Mepɨyumɨire 'itarikakɨ memɨnetsi'aye'unie,  
\q2 yamepɨte'ane memɨnetsi'aye'unie nitixaɨtɨ karanierekaku.   
\q1
\v 20 'Aixɨa nemɨtiyurienekɨ, 'axa'anemekɨ mepɨnete'akapitɨwa,  
\q2 'aixɨa mɨti'anekɨ xeikɨa nemɨnewaɨriyakɨ, 'ayumieme mepɨnetsi'aye'unie.   
\b  
\q1
\v 21 Yawé, pepɨkanetsi'uku'e'eiriwani,  
\q2 nekakaɨyari, nexaɨtame pepɨkanetsikuhayeikawani.   
\q1
\v 22 Neti'aitɨwame netsiwikweitsitɨwame,  
\q2 yapauka keneneuparewi.   
\c 39  
\d Teyuitɨwamete wa'ukiyari. Kerutuni hetsiemieme. Rawiri nɨawarieya.  
\q1
\v 1 Ne mɨpaɨ nepɨtiu'eri:  
\q1 «Teɨteri 'axateyuruwamete wahɨxie nemuyeikakɨ  
\q2 nepɨne'ɨwiyani kenemɨtiuyeika,  
\q2 nepɨtinewieka kapa 'axane'utayɨnikɨ,  
\q2 matsi netenie nepuwieka».   
\q1
\v 2 Hikɨ kayuwatɨ mana nepuyeikakai, nepɨka'utaniu.  
\q2 'Aixɨa mɨti'ane meta nepɨkatikuxatakai.  
\q1 Matsi ne'uximatɨarika kanitimiekaitɨni,   
\q2
\v 3 ne'iyari pɨtakai netawitsie.  
\q1 Mɨyanetiku'eriwakaku, matsi tai kaniutani  
\q2 'ayumieme mɨpaɨ nekaniutayɨni:   
\b  
\q1
\v 4 «Yawé, keneneutaxatɨa 'ena kwiepa netukari kereutere,  
\q2 kepaɨmexɨa xeikɨa nepuyeikani,  
\q2 keneneutaxatɨa netukari ke'emɨkatiteriwe.   
\q1
\v 5 Netukari pɨkawaɨkawa pemɨnetsi'upitɨa,  
\q2 'akɨmana, kepaɨmeme wiyari nemuyurieni tixaɨtɨ pɨkatihɨkɨ.  
\q1 Xeihɨtsiyari xeikɨa pɨhɨkɨ tewi mɨmɨwe.   
\q2
\v 6 Tewi tukarieya 'etɨriya hepaɨ xeikɨa kani'aneni meuyewautse.  
\q1 Yakɨ xeikɨa pɨyɨaneni piinitɨarika xɨka tixeɨrieka,  
\q2 'atsipɨkatimatsiɨkɨ kemɨ'ane mɨranupiini.   
\b  
\q1
\v 7 »Hikɨta, Ti'aitame, ¿titari netitakwewieka?  
\q2 'Ahetsietimieme xeikɨa nepɨtitakwewie.   
\q1
\v 8 'Axanemɨtiuyurikɨ keneneutawikweitsitɨa.  
\q2 Pepɨkawapitɨaka 'atsimemɨkatemate memɨnetsiyuriyanikɨ.   
\b  
\q1
\v 9 »Kayuwatɨ nepuyeika, netenie nepuwie,  
\q2 'ekɨ pemɨhɨkɨkɨ pɨta mɨyapemɨtiyurie.   
\q1
\v 10 'Ariri pepɨkanetsitiwayani,  
\q2 'a'iwaɨyɨ pɨnetsikumemiwatɨma.   
\q1
\v 11 'Ekɨ teɨteri pepɨtiwaruka'enitsitɨwa,  
\q2 pepɨwatiwaya ke'axamemɨteyurie,  
\q1 kwitsi tikɨmeme hepaɨ, pepɨreuyehɨpa tita memɨtehiwe'erie.  
\q2 Xeihɨtsiyari xeikɨa kanihɨkɨtɨni tewi mɨmɨwe.   
\b  
\q1
\v 12 »Yawé, nenenewieri keneu'eni,  
\q2 nehiwari keneu'eni,  
\q2 ne'utatsuakakaku 'anakata pepɨkaheuyukanarɨmani.  
\q1 'Ahɨxie ne pemɨkanetsimate nepɨhɨkɨ,  
\q2 yeikame nekanihɨkɨtɨni, netutsima wahepaɨ.   
\q1
\v 13 Pepɨkaha'aka, nenetemawiekame kenenayeitɨa  
\q2 mexi nekamɨwe meta 'ena ne'uyeika».   
\c 40  
\r (Nɨa 40:13-17 – Nɨa 70:1-5)  
\d Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya.  
\q1
\v 1 Yawé netakwewietɨ nekanayani nekawaɨripietɨ,  
\q2 mɨkɨ pɨnetsi'uxei, nehiwari kaniu'enieni.   
\q1
\v 2 Mɨkɨ teukiyata kanenatihana,  
\q2 haxuta paitɨ meta yeuta paitɨ nemɨkawamarietsie,  
\q1 tetetsie kanenakeni,  
\q2 kwiepa 'aixɨa 'anekɨa kaneniukayeni.   
\q1
\v 3 Kwikari hekwame kaneniupitɨani nemitakwikanikɨ,  
\q2 nɨawari 'aixɨa haineme takakaɨyari hetsiemieme.  
\q1 Mɨpaɨ mete'uneniereka yumɨiretɨ mekaniutimamani,  
\q2 Yawé hetsie metewiyatɨ mekanakɨne.   
\b  
\q1
\v 4 'Aixɨa pɨ'itɨarie tewi Yawé hetsie mɨtiwiya,  
\q2 memɨkayuri kakaɨyarixi  
\q2 memɨwarayexeiya wahetsɨa parewiya mɨkaha'iwawa.   
\q1
\v 5 Yawé nekakaɨyari, pɨwaɨkawa  
\q2 mamariwaweme kepemɨtiuyuri.  
\q1 Pɨkayɨwe temiti'inɨata  
\q2 ke'aixɨa pemɨtiuka'iyari tahetsiemieme.  
\q1 Xɨka ne'itaxata,  
\q2 pɨwaɨkawa matsi kenemɨkarayexatawe.   
\b  
\q1
\v 6 'Ekɨ pɨkametsinake tinaitɨ mawari,  
\q2 'ekɨ matsi neheu'ename pepɨnetsi'ayeitɨa,  
\q1 'ekɨ pepɨkahe'iwawa mawari taiyarikayari  
\q2 meta mawarika 'axamɨtiuyuri hetsiemieme.   
\q1
\v 7 'Ayumieme mɨpaɨ neputayɨ: «Ne 'ena pepɨnetsihexeiya,  
\q2 niuki xapatsie kemaine nehetsiemieme.   
\q1
\v 8 Nekakaɨyari, pɨnetsinake kemɨmetinake mɨpaɨ nemɨtiyurienenikɨ,  
\q2 'a'inɨari niukiyari ne'iyaritsie nepexeiya».   
\b  
\q1
\v 9 Yuwaɨkawatɨ meyuxeɨriekaku,  
\q2 nepɨtiutahekɨataxɨ heitserie kemɨmetinake.  
\q1 Yawé, 'ekɨ pepɨtimate, neteni  
\q2 yuheyemekɨ nemɨka'anutanamakɨ.   
\q1
\v 10 Keheitserie mɨmetinake nepɨka'i'awieta ne'iyaritsie,  
\q2 matsi nepikuxatane ke'aixɨa pemɨtikamie meta kepemɨratawikwetsitɨani.  
\q1 Yumɨiretɨ meyuxeɨriekaku nepɨka'enukanama,  
\q2 'anaki'eriya mɨmariwe meta tita yurikɨ mɨraine.   
\q1
\v 11 Yawé, kenenenenimayaka,  
\q2 'anaki'eriyakɨ kenene'awietani meta yuri pemainekɨ.   
\q1
\v 12 Waɨkawa 'axamɨti'anene pɨneranutinama,  
\q2 pɨtimɨire nemɨtiuti'inɨata nepɨkayɨwe.  
\q1 Pɨnetsi'anuku'axixɨ ke'axanemɨtiuyuri,  
\q2 'ari nepɨkaheuniere.  
\q1 Nekɨpate reuyeta kanipaɨmeni,  
\q2 ne'iyari kaneuyuyehɨpani.   
\b  
\q1
\v 13 Yawé, xeiya kenaye'a pemɨnetsixɨnakɨ.  
\q2 Yawé, kwitɨwa kenaye'a keneneuparewi.   
\q1
\v 14 Mekeheuyuyexɨrieni meke'uyutitetewiya,  
\q2 yunaitɨ kemɨ'ane memɨnetsimieku,  
\q1 mekeheuyuta'unaxɨani me'a'iwarieme,  
\q2 yunaitɨ kehate memɨtekuwautɨwe 'axamenetsiyurikutɨ,   
\q1
\v 15 kememɨte'a'iwarieni memɨnetsinanaima  
\q2 meneniereme meke'utimamani.   
\q1
\v 16 Kemɨ'ane memɨmetsikuwaɨtɨwe  
\q2 meke'uyukatemamawieni 'ahetsie,  
\q1 kemɨ'ane 'awikweitsitɨarika memɨnaki'erie, mɨpaɨ yuheyemekɨ meke'utiyuaneni:  
\q2 «Pɨmariwe yemekɨ Yawé».   
\b  
\q1
\v 17 Neta, tixaɨtɨ nemɨkarexeiya meta nereuyehɨatɨ,  
\q2 Ti'aitame kenetsi'uxeiya.  
\b  
\q1 'Ekɨ netsiwikweitsitɨwame pepɨhɨkɨ, netsixɨname,  
\q2 'apepɨkareutewini, nekakaɨyari 'aku.   
\c 41  
\d Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya.  
\q1
\v 1 'Aixɨa pɨ'itɨarie kemɨ'ane memɨwerarani 'aixɨa mɨtiwaxeiya,  
\q2 Yawé hetsiena kanitanuamɨkɨ kepauka 'uximatɨarika hetsiena mɨye'ani.   
\q1
\v 2 Yawé hetsiena kanitanuamɨkɨ, tukari kanipitɨamɨkɨ,  
\q2 yutemawiekame kanayeitɨamɨkɨ xeime kwieyaritsie  
\q2 meta memeye'unie yɨkɨ memiyurieni pɨkawapitɨani.   
\q1
\v 3 Kepauka mɨtitakwine, Yawé kanitatɨrɨkariyamɨkɨ,  
\q2 'aixɨa reu'eriekame kanayeitɨamɨkɨ.   
\b  
\q1
\v 4 Ne mɨpaɨ neputaine:  
\q1 «Yawé, keneneutinenimayata,  
\q2 'aixɨa keneneuyuri, 'ahepaɨtsita 'axanepɨtiuyuri».   
\q1
\v 5 Memɨnetsi'aye'unie 'axa'anekɨa memɨnetsiheukahɨpa, mɨpaɨ meputiyuane nehetsiemieme:  
\q2 «¿Kepaukari pɨmɨni?  
\q2 ¿Kepaukari tepitatɨmaiya?»   
\q1
\v 6 Kepauka memɨnetsi'uyexeiyatɨkɨka heitseriemekɨ mepɨka'uta'axe,  
\q2 'uwata memɨyekɨne 'axamenetekuxatatɨ mepakɨka.   
\b  
\q1
\v 7 Memɨnetsi'aye'unie meyukuxeɨrieme nehetsiemieme mepɨte'utixaxata,  
\q2 nehetsie mepɨte'ahɨpa. Mɨpaɨ mekaniutiyuaneni:   
\q1
\v 8 «Mɨkɨ yu'utatsie 'akaitɨ hatsuakuri pɨka'anukukeni,  
\q2 'axamɨti'ane hetsiena kanikahani».   
\q1
\v 9 Nehamiku 'ɨaritɨ yemekɨ hetsiena nemɨtiwiyakai  
\q2 kwi nehamatɨa mɨrakwaiwekai,  
\q2 nehepaɨtsitari kaneuniukani.   
\b  
\q1
\v 10 Yawé, 'ekɨ matsi, keneneutinenimayata,  
\q2 kenenanukuketɨa  
\q2 neta nemɨnekɨhɨanikɨ.   
\q1
\v 11 'Ana mɨpaɨ nepɨretimani nemɨmetsinaki'atsitɨakɨ:  
\q2 xɨka mɨnetsi'aye'unie kanetsi'a'iwa.   
\q1
\v 12 'Aixɨa nemɨtiuyeikakɨ pepɨnetsituikani,  
\q2 'ahɨxie yuheyemekɨ ne'uyeikame pepɨnetsi'ayeitɨani.   
\b  
\q1
\v 13 'Aixɨa ketikuxaxatsiwani Yawé, 'Ixaheri Kakaɨyarieya,  
\q2 tsepanetɨ xeitsienituyari wiyari manuyekɨka yaxeikɨa ketikuxaxatsiwani.   
\qc 'Aixɨa pɨ'ane meta 'aixɨa pɨ'ane.  
\c 42  
\s1 XAPA 2  
\r Nɨawari 42-72  
\d Teyuitɨwamete wa'ukiyari. Kure niwemama wa'ɨkitsika.  
\q1
\v 1 Maxa yeutanaka heuharimɨtɨ haa kemɨtikuwaune,  
\q2 neta mɨpaɨ nepɨmetikuwaune Kakaɨyari.   
\q1
\v 2 Nepeuharimɨkɨ Kakaɨyari hetsie timiemekɨ, Kakaɨyari mayeyuri hetsie.  
\q2 ¿Kepauka Kakaɨyari hɨxie nepɨtakeni?   
\q1
\v 3 Tukarikɨ tɨkarikɨ tsuarikɨ xeikɨa nepayeniere,  
\q2 mɨpaɨ neranutahɨawarɨwatɨ tsepa kepauka:  
\q2 «¿Hakewa tamɨ 'akakaɨyari?»   
\b  
\q1
\v 4 Mɨpaɨ neti'erieme nepɨtikuhayeikawa ne'utatsuatɨ:  
\q2 Ne nepayeyeikakai yumɨireme wahamatɨa,  
\q2 nepɨwarewitɨkɨkai Kakaɨyari tukita.  
\q1 Temawierika hiwariyari meta pamɨpariyutsi  
\q2 'ixɨarariyari tepatinenetɨwakai.   
\b  
\q1
\v 5 ¿Titayari yɨkɨ netinekɨhɨaweni?  
\q2 ¿Titayari netine'uximatɨaka?  
\q1 Kakaɨyari hetsɨa timieme matsi nepɨtitakwewieka  
\q2 meta nepinɨawani.  
\q2 Mɨkɨ pɨnetsiwikweitsitɨwame meta pɨnekakaɨyari.   
\q1
\v 6 Hikɨ yemekɨ nepɨtiuka'eniwa,  
\q2 nekakaɨyari, 'ayumieme nemetsiku'eriwa  
\q1 Kurutani kwieyaritsie paitɨ,  
\q2 Heximuni hɨriyaritsie meutitewatsie paitɨtɨ,  
\q2 Mitsaxi hɨriyaritsie paitɨ.   
\q1
\v 7 Xeime terɨtsie puwa'eiya  
\q2 haa manukaxɨrɨwe kwinimieme mutainetsie,  
\q1 naitɨ 'ahamewari  
\q2 nehetsie pɨkaxɨrɨwe.   
\b  
\q1
\v 8 'Ikɨ nenewieri pɨhɨkɨ Kakaɨyari tukari mɨnetsi'upitɨa hetsiemieme:  
\q2 tukarikɨ Yawé yunaki'eriya kenetsiheyenɨ'airiwani,  
\q2 tɨkarikɨta kwikarieya nepuku'eriwani.   
\q1
\v 9 Nekakaɨyari mɨpaɨ nekatinahɨaweni, Ne'ai:  
\q2 «¿Titayari peneratɨmai?  
\q1 ¿Titayari nenehiwerietɨ 'ena netiuyeikani  
\q2 nenanaimarietɨ memɨnetsi'aye'unie wahetsiemieme?»   
\q1
\v 10 Mɨki ne'umeyarita paitɨ kaniuhakeni  
\q2 menetsinanaimakaku memɨnetsi'aye'unie,  
\q1 mɨpaɨ neranutahɨawarɨwatɨ nehɨxie tsepa kepauka:  
\q2 «¿Hakewa tamɨ 'akakaɨyari?»   
\b  
\q1
\v 11 ¿Titayari yɨkɨ netinekɨhɨaweni?  
\q2 ¿Titayari netine'uximatɨaka?  
\q1 Kakaɨyari hetsɨa timieme matsi nepɨtitakwewieka,  
\q2 meta nepinɨawani.  
\q2 Mɨkɨ netsiwikweitsitɨwame kanihɨkɨtɨni meta nekakaɨyari.   
\c 43  
\q1
\v 1 Kakaɨyari, 'aixɨa ketineuyuri nehetsie.  
\q2 Nehetsie keneutanua 'ikɨ nuiwari wahɨxie yuri memɨkate'erie,  
\q2 keneneutawikweitsitɨa teɨteri memɨte'itawa watsata meta 'axamemɨte'u'iyari.   
\q1
\v 2 'Ekɨ pepɨnekakaɨyari meta nehetsie nunuwame pepɨhɨkɨ:  
\q2 ¿Titayari pekanera'eriwa?  
\q1 ¿Titayari netinehiwerieka?  
\q2 ¿Titayari netiuka'eniwani memɨnetsi'aye'unie wahetsiemieme?   
\q1
\v 3 'Ahekɨariya kenanɨ'a meta tita yuri pemɨraine,  
\q2 mɨkɨ 'ahɨri mɨpatsietsie paitɨ kenetsi'uye'atɨani,  
\q2 mekenetsihewitɨni hakewa paitɨ pemeyeika.   
\q1
\v 4 Hikɨ nekaninuamɨkɨ 'ahetsiemieme mawari taiyametsie,  
\q2 Kakaɨyari hetsɨa temawierika mayeneikakɨ,  
\q1 Kakaɨyari, muwa nekakaɨyari 'aku  
\q2 kanarikɨ nekamenitanɨawamɨkɨ.   
\b  
\q1
\v 5 ¿Titayari yɨkɨ netinekɨhɨaweni?  
\q2 ¿Titayari netine'uximatɨaka?  
\q1 Matsi Kakaɨyari hetsie nepɨtiwiyani,  
\q2 meta nepinɨawani.  
\q2 Mɨkɨ pɨnetsiwikweitsitɨwame meta pɨnekakaɨyari.   
\c 44  
\d Teyuitɨwamete wa'ukiyari. Kure niwemama wa'ɨkitsika.  
\q1
\v 1 Kakaɨyari, tepɨte'u'eni 'ahetsie timieme,  
\q2 tapaapama mepɨtate'utaxatɨa  
\q1 mamariwaweme kepemɨtiuyuri memu'uwakaitsie,  
\q2 'iya tukaritsie meripaitɨ:   
\q1
\v 2 'Atɨrɨkariyakɨ hipame nuiwarite pepɨwarutawei,  
\q2 mana pɨta pepɨwa'atɨa tapaapama,  
\q1 'iya teɨteri pepɨwarakumaweriyaxɨ,  
\q2 tapaapama pepɨwaruparewi.   
\q1
\v 3 Wa'ixipara pɨkatiuyuri kwie mema'iwaxɨ,  
\q2 yukɨmana mepɨkate'uyuri memɨte'ayu'iwaxɨ:  
\q1 matsi 'atɨrɨkariya pɨtiuyuri, 'amamá 'atserieta mieme pɨtiuyuri,  
\q2 'anierika xawatɨriyaya pɨtiuyuri, 'ekɨ pemɨwanaki'eriekaikɨ.   
\b  
\q1
\v 4 'Ekɨ xeikɨa ti'aitame nehetsiemieme pepɨhɨkɨ meta nekakaɨyari.  
\q2 Kakuwu mɨrayu'iwakɨ pepiparewi.   
\q1
\v 5 'Ekɨ petatsiparewiekaku memɨtatsi'aye'unie tepɨwara'iwaxɨ,  
\q2 kepemɨtitewa hekɨ tepɨwarutipɨnaxɨ memɨtatsi'aye'uniekai.   
\q1
\v 6 Ne netupi hetsie nepɨkaheuwaɨre,  
\q2 ne'ixipara nemɨrayu'iwakɨ pɨkanetsi'uparewiwe,   
\q1
\v 7 'ekɨ matsi petatsiparewiekaku memɨtatsi'aye'unie tepɨwara'iwa,  
\q2 memɨtatsi'aye'unie meyutetewiyame pepɨwarayeitɨwa.   
\q1
\v 8 Taheyemekɨ tepɨtatemamawieka Kakaɨyari hetsie.  
\q2 Yuheyemekɨ tepinɨawani.   
\b  
\q1
\v 9 Peru hikɨ pepɨtatsihexɨri teyutetewiyame pepɨtatsi'ayeitɨa,  
\q2 pepɨkatatsiparewieri temuyukwitɨwetsie.   
\q1
\v 10 Mɨtatsi 'aye'unie hɨxie tema'iwarienikɨ yapepɨtiuyuri,  
\q2 mepɨtatsi 'ayewei memɨtatsi 'aye'unie mepɨtate'unawatsiri.   
\q1
\v 11 Muxatsi temɨhɨkɨtɨni hepaɨ  
\q2 pepɨtatsiyetua temɨtikwaiyanikɨ,  
\q2 mekataneutaxɨriexɨani naitsarie kwiepa.   
\q1
\v 12 'Ateɨterima pekaniwarutuani ka'ɨrimekɨ,  
\q2 tixaɨtɨ pepɨkaranɨ'ɨi pewarutuaka.   
\b  
\q1
\v 13 Ta'aurie kiekatari wahɨxie tetewiwekame pepɨtatsi'ayeitɨa,  
\q2 nanaimariwamete 'atsieriwamete tekanihɨkɨtɨni.   
\q1
\v 14 Kwiepa memɨtama wananaitɨwamete tekanihɨkɨtɨni,  
\q2 yunaitɨ teɨteri memu'uwa mekatani'atseni tame.   
\q1
\v 15 'Etsiwatɨma nepɨkahayewarie nekananaimarietɨ,  
\q2 waɨkawari nepaunetewiya,   
\q1
\v 16 waɨkawa memɨnetsinanaimakɨ menetsi'utahiwiwatɨ,  
\q2 mɨnetsi'aye'unie ya'aneme wiwiekaku muyuwaɨriya mɨraka'una.   
\b  
\q1
\v 17 Mɨya tepɨte'anuyehu hikɨ,  
\q2 hatsuaku tekametsihatɨmaiyakutɨtɨ  
\q2 meta 'atɨratu teka'uku'eiriekutɨtɨ.   
\q1
\v 18 Tepɨkametsiku'eiriewawe,  
\q2 'ahuye meta tepɨkaku'eiriewawe.   
\q1
\v 19 Matsi 'ekɨ yawixi memayu'eriyaya waterɨta pepɨtatsiheukaxɨri,  
\q2 waɨkawa mayeyɨwitsie pepɨtatsiheutaxɨri.   
\b  
\q1
\v 20 Xɨka tehetɨmaiyake takakaɨyari,  
\q2 xɨka yatɨni hipame kakaɨyarixi wahɨxie te'ukatunuma'unike,   
\q1
\v 21 ¿tamɨ Kakaɨyari karetimanikeyu,  
\q2 mɨkɨ naime mɨtimate tita temɨte'awieta tahetsie?   
\q1
\v 22 'Ahetsie temɨtewiyakɨ, tepɨtakwikwiwa yuheyemekɨ,  
\q2 muxatsi memɨkwaiya wahepaɨ tepɨte'anuyehu memehapawa mehekwi'iwake.   
\b  
\q1
\v 23 Ti'aitame, 'ari kenanutanieri. ¿Titayari petikutsu?  
\q2 Kenanukukexi. Pepɨkatatsihexɨrɨwani 'aheyemekɨ.   
\q1
\v 24 ¿Titayari tahepa pekatinierimɨkɨ?  
\q2 ¿Titayari 'atsipekaraine tete'uka'eniwakaku meta tenanaimariekaku?   
\q1
\v 25 Tepa'iwarie kwiepa paitɨ tepɨtihe,  
\q2 tawaiyari kwiepa paitɨ patixɨrɨwe.   
\q1
\v 26 Kenanukukexi, kenaye'a ketaneuparewi,  
\q2 'anaki'eriyakɨ taheima keneutanua.   
\c 45  
\d Teyuitɨwamete wa'ukiyari. «Tuturi» yuariyaya keneuweiyani. Kure niwemama wa'ɨkitsika. Neɨkiyapa mieme.  
\q1
\v 1 Ne'iyaritsie peyeyuane kwikari hekwatɨ,  
\q2 ne'ikuxatakaku kemanuyɨne ti'aitame hɨxie,  
\q2 'utɨwame witsimɨtiu'utɨwa hepaɨ kani'aneni neneni.   
\b  
\q1
\v 2 'Ekɨ tewi witsipemɨti'axexeiya pekanihɨkɨtɨni,  
\q2 witsipekatiniuxaxatani,  
\q2 Kakaɨyari 'aixɨa pɨmatsiyurie yuheyemekɨ.   
\q1
\v 3 Witsi'aneme mariwemekɨ,  
\q2 yu'ixipara kanakawieka, 'iya mɨrayu'iwa.   
\q1
\v 4 Mariwemekɨ, kananutiyeixani rayu'iwake  
\q2 tita yuri mɨraine hetsiemieme kaniyumieneni,  
\q2 meta tixaɨtɨ mɨkarayuyeitɨa meta tita mɨtiheitseriekɨ,  
\q2 mariweme ketiyurieneni 'atɨrɨkariya.   
\q1
\v 5 'A'ɨrɨ kwinimieme mɨranuyemɨtsɨ ti'aitame memaye'unie  
\q2 wa'iyaritsie keheu'uni,  
\q2 meta nuiwarite 'ahetɨa meke'ukaxɨrieni.   
\b  
\q1
\v 6 Kakaɨyari, 'a'uweni yuheyemekɨ 'apuwe,  
\q2 'a'itsɨ pemɨti'aitame hetsiemieme, mɨkɨ 'itsɨ 'aixɨa mɨti'anekɨ mɨti'aita kanihɨkɨtɨni.   
\q1
\v 7 'Ekɨ 'aixɨa mɨti'ane pepɨtinaki'erie, 'axamɨti'aneta pepɨti'uxiwe'erie,  
\q2 'ayumieme Kakaɨyari pɨmetsi'anayexei 'ekɨ, 'a'iwama pɨkawaranayexei,  
\q2 'akakaɨyari temawierika hatseitiyari pɨmetsi'ukawiri.   
\q1
\v 8 Mixaxi 'ɨakariyari, 'aruhe meta kanera,  
\q2 mɨpaɨ pu'ɨatɨka 'akemarite,  
\q1 paratsiyu witsimɨtiuye'anetsie 'umetekɨ tiwaku'utɨkaimeta pe'ayekaiku,  
\q2 pɨmetsitemawieritɨa kanari yuariyaya.   
\q1
\v 9 'Ukari te'aitamete waniwema witsimemɨ'anene memɨmetsiparewie watsata mekaniye'uwani,  
\q2 'atserietata 'uka ti'aitame kanakani  
\q2 huru 'Upixi miemekɨ 'utixawatɨretɨ.   
\b  
\q1
\v 10 Keneu'ena, 'uka yemekɨ keneu'a'ɨwiya:  
\q2 'Akiekari kenatɨmaiya meta 'a'iwama.   
\q1
\v 11 Ti'aitame witsikepemɨti'ɨimari kamenihiwe'erieka,  
\q2 mɨkɨ meti'aitɨwame kanihɨkɨtɨni, hɨxiena kenanakatutsita.   
\q1
\v 12 'Ukari Tiru kiekatari mekani'axɨakuni 'imikieri mete'upitɨ,  
\q2 teɨteri mana kiekatari memɨxikutsixi 'aixɨa mepɨmetexeiyani.   
\q1
\v 13 'Uka witsimɨti'ɨimari 'aixɨa katiniyuxexeiyani,  
\q2 yukiita wayemietɨ hurukɨ 'utixawatɨretɨ 'iwieya reuxuiyakaku.   
\q1
\v 14 Kemari ranakapitɨ 'aixɨa mɨti'anenekɨ reuxuiyatɨ  
\q2 kanewitɨwani ti'aitame hɨxie,  
\q2 'ɨtɨmanata 'ɨimarixi me'eweiyatɨ.   
\q1
\v 15 Temawierikakɨ mekanewitɨwani  
\q2 ti'aitame paratsiyuta paitɨ.   
\b  
\q1
\v 16 'Aniwemata yupaapama wa'uwenitsie mekanayaxikuni,  
\q2 memanuyetei pekaniwarayeitɨamɨkɨ naitsarie kwiepa.   
\q1
\v 17 Pemukahatɨmaiyarienikɨ yanepɨtiyurieni  
\q2 yuheyemekɨ,  
\q1 'ayumieme nuiwarite mepɨmetsitanɨawa,  
\q2 yuheyemekɨ yuheyemekɨ.   
\c 46  
\d Teyuitɨwamete wa'ukiyari. Kure niwemama wakwikari 'etsi'uyuatɨ mutakwika.  
\q1
\v 1 Kakaɨyari tahetsie nunuwame kanihɨkɨtɨni, hetsiena temɨta'awieta,  
\q2 yuheyemekɨ tatsiparewiwame kepauka temu'uximatɨarie.   
\q1
\v 2 'Ayumieme tepɨkaheumamaka,  
\q2 tsepa kwiepa kemɨtiyɨane  
\q2 tsepa yemurite haramara hixɨapa mɨtiukayunixɨa,   
\q1
\v 3 tsepa hamewarieya kwinimieme mɨtiutatɨrarɨka,  
\q2 ha'akaku hɨxiena tsepa hɨrite mutiyuane.   
\b  
\q1
\v 4 Haa mana kaniuyehaneni Kakaɨyari kiekarieya mɨtemawieritɨa,  
\q2 'Amutewi kie makupatsietsie.   
\q1
\v 5 Mana Kakaɨyari kaniukani, kiekari hatsuaku pɨkahatiweni,  
\q2 kepauka mukahekɨkɨaretsie Kakaɨyari kaniwaparewiekamɨkɨ.   
\q1
\v 6 Nuiwari mukumane mekanimamaka, te'aitamete mekaniuyɨyɨakatɨkani,  
\q2 kepauka Kakaɨyari mutaniuka, kwie kanita'unikeni.   
\b  
\q1
\v 7 Yawé, Naimekɨmɨtɨrɨkaɨye tahamatɨa kaniuyeikani,  
\q2 hetsiena temɨta'awieta Kakuwu Kakaɨyarieya kanihɨkɨtɨni.   
\b  
\q1
\v 8 Xekenakɨni xekeneuxeiya Yawé mamariwaweme pɨtiyuriene,  
\q2 mɨkɨ kwiepa makumawenikɨ pɨtiuyuri.   
\q1
\v 9 Kuyaxa kaneutipariya naitsarie kwiepa.  
\q1 Tupi kaniutimura, pitsika 'amɨtɨtɨ kaniutimura,  
\q2 kaxetate kuyaxa mieme taipa kaneuxɨrieni.   
\q1
\v 10 «Kayuwatɨ xeketeneteni, mɨpaɨ xeketenetimati ne Kakaɨyari nemɨhɨkɨkɨ.  
\q2 Ne 'aixɨa nekatinitahɨawariemɨkɨ nuiwarite watsata.  
\q2 Ne nemariwetɨ nekanayeitɨariemɨkɨ kwiepa».   
\b  
\q1
\v 11 Yawé Naimekɨmɨtɨrɨkaɨye tahamatɨa kaniuyeikani,  
\q2 hetsɨana temɨta'awieta Kakuwu Kakaɨyarieya kanihɨkɨtɨni.   
\c 47  
\d Teyuitɨwamete wa'ukiyari. Kure niwemama wakwikari.  
\q1
\v 1 Yunaitɨ teɨteri xeketeneutapineni,  
\q2 Kakaɨyari xekeneutahiwiwani temawierikakɨ.   
\q1
\v 2 Yemekɨ pɨtɨrɨkaɨye Yawé 'Amutewi,  
\q2 pɨmariwe ti'aitame 'ena kwiepa naitsarie.   
\q1
\v 3 Pɨtatsi'uhɨritɨa nuiwarite temɨwakuyuitɨanikɨ,  
\q2 yunaime teɨteri pɨtatsi'uxatɨa,   
\q1
\v 4 'imikieri tahetsiemieme pɨranayexei  
\q2 Kakuwu muyuta'ɨrixɨ kɨmana pɨhɨkɨ, kemɨ'ane waɨkawa mɨnaki'eriekai.   
\b  
\q1
\v 5 Kakaɨyari Yawé yu'uwenitsie kanayerɨni,  
\q2 temawierika hiwariyaritsata meta kuxineta yuariyaya.   
\q1
\v 6 Kakaɨyari xekenenɨawani, xekenekwikani hetsiena mieme,  
\q2 xekeneutikwikani nɨawari tati'aitɨwame hetsiemieme.   
\b  
\q1
\v 7 Kakaɨyari kanihɨkɨtɨni ti'aitame 'ena kwiepa naitsarie,  
\q2 'ayumieme, nɨawari xekeneutikwikani mariwemekɨ.   
\q1
\v 8 Kakaɨyari katini'aitani, naime nuiwarite kwiepa memɨtama wahetsiemieme,  
\q2 yu'uweni mɨpatsietsie 'akaitɨ.   
\q1
\v 9 Teɨteri wa'ukiyarima mekaniyukuxexeɨriwani,  
\q2 'Apɨrahami Kakaɨyarieya teɨterimama wahetsɨa me'itahɨaweke,   
\q1
\v 10 mɨkɨtsɨ Kakaɨyari katinipiinieyatɨni naitsarie kiekari mukumane kwiepa.  
\q2 Mɨkɨ mariwemekɨ 'aixɨa katinikuxaxatsiwamɨkɨ.   
\c 48  
\d Nɨawari. Kure niwemama wakwikari.  
\q1
\v 1 Yawé pɨmariwe, minɨawani yemekɨ 'aixɨa pɨ'ane  
\q2 takakaɨyari kiekarienatsie.  
\q1 Hɨrieya mɨpatsietsie,  
\v 2 hɨri witsimɨ'ane,  
\q2 naitsarie kwiepa watemawierika pɨhɨkɨ.  
\q1 Tsiyuni hɨriyari, tayeta katini'aneni,  
\q2 Ti'aitame mɨmariwe kiekarieya kanihɨkɨtɨni.   
\q1
\v 3 Tsiyuni muwe tuxiyu 'amutewita,  
\q2 Kakaɨyari kaniyuhekɨata tiyu'awiwietame 'aixɨa mɨ'ane kemɨtihɨkɨ.   
\b  
\q1
\v 4 Te'aitamete mekaniyukuxeɨrieni mekaniyutinɨni,  
\q2 yunaitɨ mɨkɨ kiekari me'unietɨ mekanewakɨne,   
\q1
\v 5 peru kepauka memixei kayuwatɨ mekateniu'uni,  
\q2 waɨkawa memamatɨ mekaneutayeixɨani.   
\q1
\v 6 Mana waɨkawa memamatɨ mekanakɨne,  
\q2 meta 'ukaratsi mɨtiniwerɨmeni hepaɨ 'anetɨ wahetsie katininuani.   
\q1
\v 7 'Eka kwinimieme mɨtitɨrɨkaɨyekɨ,  
\q2 kanuwate 'amɨpapa Taritsi mieme peputimuraxɨa.   
\b  
\q1
\v 8 Yemekɨ kehepaɨ temɨte'u'enanakai  
\q2 hikɨ tepunenierixɨ,  
\q1 Yawé Naimekɨmɨtɨrɨkaɨye kiekarienatsie,  
\q2 meta takakaɨyari kiekarienatsie:  
\q2 Mɨkɨ hatsuaku pɨkaheitiparitɨani.   
\b  
\q1
\v 9 'Atukita paitɨ, neuxei Kakaɨyari,  
\q2 'anaki'eriya tepuku'eriwa.   
\q1
\v 10 'Anɨawari, neuxei Kakaɨyari, meta kepemɨtitewa hepaɨ pɨ'ane,  
\q2 kwie manu'axe paitɨ kaniuyeikani,  
\q2 'amamá tserieta miemetsie tita mɨtiheitserie katinihɨneni.   
\q1
\v 11 'Ekɨ 'aixɨa pemɨtiyurienekɨ  
\q2 hɨri Tsiyuni kaniyutemawieka,  
\q2 meta Kura kiekariyaritsie mamanetɨka kaniyutemamawieka.   
\b  
\q1
\v 12 Tsiyuni 'aurie xekenahuni,  
\q2 waritana xekenakɨni  
\q2 meta xekeneuti'inɨata tuxiyuya,   
\q1
\v 13 kuraruyari 'aixɨa yemekɨ xeketeneuxeiya,  
\q2 xekeneutixeiyaxɨa hakewa memeyuti'awiwieta,  
\q2 mɨpaɨ 'uxa'atɨni warie xemɨtewakuxaxatɨwanikɨ yuniwema meta yuteukarima.   
\q1
\v 14 'Ikɨ Kakaɨyari takakaɨyari yuheyemekɨ kanihɨkɨtɨni.  
\q2 Mɨkɨ yuheyemekɨ kataniuwitɨximemɨkɨ.   
\c 49  
\d Teyuitɨwamete wa'ukiyari. Kure niwemama wakwikari.  
\q1
\v 1 'Ikɨ xeketeneu'eni, yunaitɨ teɨteri:  
\q2 xekeneu'enana, kwiepa xemɨtama naitsarie,   
\q1
\v 2 yunaitɨ xemɨwerarani meta yunaitɨ waɨkawa xemɨmamariwawe,  
\q2 yunaitɨ xikutsixi meta tixaɨtɨ xemɨkateheuxeiya.   
\q1
\v 3 Nepɨtikuxatani timaiwemekɨ,  
\q2 ne'iyari timaitɨ pɨtikuxatani.   
\q1
\v 4 Temaiwawemete waniuki kwi 'ahurawa nepɨ'enieni,  
\q2 netiyuitɨatɨ kanarikɨ nepɨxetaxatɨani niuki mɨ'awie.   
\b  
\q1
\v 5 ¿Titayari nereumaka kepauka 'uximatɨarika nehetsie munuani?  
\q2 ¿Titayari nereumaka kepauka memɨnetsi'aye'unie memɨnetsinanaimatsie?   
\q1
\v 6 Pukaheuyewetse xikutsixi nemuwamakaxenikɨ yupiinitsie memɨtewiya  
\q2 meta yupiinitekɨ memuyutimariwekata.   
\q1
\v 7 Nixewitɨ xeime mutawikweitsitɨani pɨkayɨwe,  
\q2 meta pɨkayɨwe Kakaɨyari mɨtiupitɨani xeime tukarieyakɨ.   
\q1
\v 8 Xeime tukarieya mutawikweitsitɨani katinaye'aka,  
\q2 pumawe ka'inɨaritɨ kemɨraye'axe.   
\q1
\v 9 Xewitɨtɨma yapɨkatiuyeika,  
\q2 hatsuaku kamɨwetɨ.   
\q1
\v 10 Meyunaitɨ yaxeikɨa mepɨtetakukuwe,  
\q2 memɨtemaiwawe meta memɨkatemaiwawe yaxeikɨa mepɨtakukuwe,  
\q2 wapiinitɨarika hipatɨ wapiini pɨrayeika.   
\q1
\v 11 Tsepa kwie memeuxeiyakai yuhepaɨ titetewakame,  
\q2 teukiyapa wakii yuheyemekɨ pɨhɨkɨtɨni,  
\q2 wakie pɨhɨkɨtɨni yuheyemekɨ.   
\b  
\q1
\v 12 Tsepa xiku xewitɨ mayuyeitɨa, peru mɨkɨ 'apɨkareutere,  
\q2 yeutari wahepaɨ mepɨtakukuwe.   
\b  
\q1
\v 13 Mɨpaɨ kani'aneni yuhetsie memɨtewiya wahuye,  
\q2 mɨpaɨ mekateneutiparikuni 'iya memuyuti'ɨre.   
\q1
\v 14 Muxatsi wahepaɨ, mekane'ariyani teukiyapa,  
\q2 muwa kaniware'arieni mɨki.  
\q1 Wakaxari kwieta paitɨ kanetipɨnimɨkɨ,  
\q2 wakii witsimɨ'anene mati'utsie 'ahetewakaku.  
\q1 'Uxa'arieka ximeri teɨteri heitserie memexeiya mekateniwata'aitɨakuni.   
\q1
\v 15 Peru Kakaɨyari kanenitawikweitsitɨamɨkɨ teukiyapa  
\q2 yuhamatɨa kanenanuwitɨmɨkɨ.   
\b  
\q1
\v 16 Pepɨkamaka xewitɨ xɨka xiku hayuyeitɨani  
\q2 meta xɨka yukii witsi'aneme 'utawewieni,   
\q1
\v 17 mɨkɨ kepauka mɨmɨni tixaɨtɨ pɨkaranupini,  
\q2 hamatɨana pɨkatiyehu piiniteya.   
\q1
\v 18 Tsepa 'a'uyeikatɨ kename 'aixɨa tiuyeika maine,  
\q2 tsepa teɨteri 'aixɨa memɨtehehɨawe xiku matɨakɨ,   
\q1
\v 19 yaxeikɨa kanimɨmɨkɨ yupaapama wahepaɨ,  
\q2 tawariri hekɨariya pɨkaxeiya.   
\b  
\q1
\v 20 Tsepa xiku xewitɨ mayuyeitɨa, peru mɨkɨ 'apɨkareutere,  
\q2 yeutari wahepaɨ mepɨtakukuwe xeikɨa.   
\c 50  
\d 'Atsahapi nɨawarieya.  
\q1
\v 1 Yawé kananiukani, kakaɨyarixi mɨwakakaɨyari:  
\q2 teɨteri kaniwa'inieka tau manatineika metsutɨme tau makayuyuipiketsie paitɨ meye'atɨkaime.   
\q1
\v 2 Kakaɨyari kaniutimerɨkani Tsiyuni paitɨ,  
\q2 kiekari witsimɨ'ane meta 'aixɨa mɨ'anetsie.   
\q1
\v 3 Takakaɨyari 'ukanamieni, peru kayuwatɨ hexeiyatɨ 'upɨkahamie,  
\q2 tai kananuyekani hɨxiena naime tititaiyatɨ,  
\q2 waritana katiniutatɨrarɨkani.   
\q1
\v 4 Yawé muyuawi meta kwie kaniwa'inieka,  
\q2 memɨnenierekɨ yuteɨterima mɨwataxanetatsie:   
\q1
\v 5 «Memɨpatsie xekeniwarukuxeɨri,  
\q2 nehamatɨa tɨratu memuwewi mawarikɨ».   
\q1
\v 6 Muyuawi 'aixɨa mɨti'ane katinihekɨatani kayuhekɨakamekɨ:  
\q2 Kakaɨyari kani'itsɨkametɨni 'aixɨa tiuka'iyaritɨ.   
\b  
\q1
\v 7 «Xekeneu'enana, neteɨterima, nepɨtitaxata,  
\q2 'Ixaheri, nepɨmetsitahekɨata:  
\q2 Ne nepɨ'akakaɨyari, ne xeikɨa Kakaɨyari nepɨhɨkɨ.   
\q1
\v 8 Ne nepɨkamatsihate'a mawarika pemɨwewiekɨ  
\q2 meta mawari taiyariyari, mɨkɨ yapemɨnetiutimawiriwakɨ.   
\q1
\v 9 Ne nepɨkawareuyehɨwari tsikerutsixi 'akuraruta miemete,  
\q2 meta tsipuri 'ukitsi 'akie miemete,   
\q1
\v 10 yeutari mekateninepiinitɨni,  
\q2 metatsiere xeimiriyari hɨriyaritetsie tewaxi yeuta memu'uwa.   
\q1
\v 11 Memɨte'awɨwawe nepɨwamate,  
\q2 yunaitɨ yeuta memɨte'u'uwa nepiini mepɨtehɨkɨ.   
\q1
\v 12 Xɨka ne neheuhaakamɨkɨni, nepɨkametitaxatɨani,  
\q2 metsɨ kwie naitɨ katininepiinitɨni, meta tita mɨrexeiya.   
\q1
\v 13 ¿Kamɨtsɨ ne tuurutsixi wawaiyari netikwa'a,  
\q2 yatɨni tsipuri 'ukitsi waxuriya neti'ie?   
\q1
\v 14 Kakaɨyari kenexatɨaka kepemɨti'awaɨriyakɨ,  
\q2 'Amutewi hetsɨa kepemɨti'ahɨritɨa ketinaye'atɨa.   
\q1
\v 15 Keneneutahɨawi kepauka 'uximatɨarika pemexeiya,  
\q2 ne nepɨmetsixɨna, 'ekɨta 'aixɨa pepɨnetitahɨawe».   
\b  
\q1
\v 16 Peru Kakaɨyari 'axatiyuruwame mɨpaɨ katinahɨaweni:  
\q1 «'Ekɨ heitserie pepɨkahexeiya ne'aitsika pemukuxatanikɨ,  
\q2 yatɨni netɨratu pemɨkuxatanikɨ.   
\q1
\v 17 Kenemɨti'aita, pepɨxani'erie,  
\q2 neniuki, pepehɨpa.   
\q1
\v 18 Xɨka tinawayame pe'uxeiya, pepitinɨnɨwe,  
\q2 hipame wa'ɨitama memɨwakumaɨwa wahamatɨa pepuyeika.   
\q1
\v 19 'Axamɨti'anekɨ, 'aneni pepɨtatua,  
\q2 'aneni puyuwaɨriya mɨtiu'irɨmanikɨ.   
\q1
\v 20 Pepɨ'iyamate 'a'iwa hetsiemieme pemɨtikuxatanikɨ,  
\q2 matsi pepi'uximatɨa yemekɨ 'a'iwa.   
\q1
\v 21 Mɨpaɨ pekatiniyurieneni, neta 'atsinepɨkahaine,  
\q2 ¿xɨari mɨpaɨ pepɨtiku'eriwa kename ne 'ahepaɨ ne'ane?  
\q1 Peru hikɨ ne nekamenitatiemɨkɨ,  
\q2 'ahɨxie nemetsi'anutaxeiyatɨ nepɨmetsitaxaneta.   
\b  
\q1
\v 22 »Xeme Kakaɨyari xematɨmai,  
\q2 xekeneutimaixɨa kenemaine,  
\q1 xɨkate mɨpaɨ xeka'ɨyɨni, ne nekanixetitsanamɨkɨ,  
\q2 nixewitɨ tɨma pɨkaxetawikweitsitɨani.   
\q1
\v 23 Kemɨ'ane pamɨpariyutsi mɨnetsipitɨa, 'aixɨa mɨnerahɨawe,  
\q2 kemɨ'ane yuhuye 'ɨwiyatɨ mumie, newikweitsitɨarika nekanipitɨamɨkɨ».   
\c 51  
\d Rawiri nɨawarieya, kepauka tixaxatame Natani meikuxei Rawiri Wetitsawe hamatɨa 'axamete'uyurieku.  
\q1
\v 1 Kakaɨyari, kenenenenimayaka,  
\q2 mɨmariwekɨ 'anaki'eriya,  
\q1 mɨwaɨkawakɨ kepemɨtiuyukanenimaya,  
\q2 ke'axanemɨtiuyuri kenetinanuyeitɨiri.   
\q1
\v 2 Keneneutahauxina naime 'axamɨti'anekɨ  
\q2 kenanuyeitɨa nexurikime.   
\b  
\q1
\v 3 Ke'axanemɨtiuyuri nepɨtimate,  
\q2 mɨpaɨ xeikɨa nepɨtiku'eriwa.   
\q1
\v 4 'Ahepaɨtsita 'axanepɨtiuyuri, 'ahepaɨtsita xeikɨa,  
\q2 'ahɨxie 'axanepɨtiuyuri,  
\q1 'ayumieme 'ekɨ heitserie pepexeiya,  
\q2 ke'aixɨa pemɨtiyuriene, 'aixɨa pɨ'ane.   
\q1
\v 5 Ne mɨpaɨ nepɨtimate nemutinuiwaxɨtsietɨtɨ 'axanepɨtiuka'iyari,  
\q2 'axanetiyuruwametɨtɨ nemaama hetsie nepɨyenuiwaxɨ.   
\q1
\v 6 Ne mɨpaɨ nepɨtimate 'ekɨ tita yuri mɨraine pepɨnaki'erie,  
\q2 'ekɨ ha'awiekamekɨ pepɨnetiuta'ɨkitɨa nemɨtimaiwenikɨ.   
\b  
\q1
\v 7 'Aixɨa keneneuyuri hitsupu xawarikɨ penetsikuwayatɨ, 'aixɨa ne'anetɨ nekanayeimɨkɨ,  
\q2 keneneuhauxina, witsinetituxatɨ nekanayeimɨkɨ 'ɨwi kemɨkatituxa.   
\q1
\v 8 Keneneupitɨa temawierika,  
\q2 temawierika keneupitɨa 'ikɨ 'umete pemika'unaxɨ.   
\q1
\v 9 'Ahɨxie tita 'axanemɨtiuyuri kenatɨmaiya  
\q2 meta naime 'axamɨti'ane kenanuyeitɨa.   
\q1
\v 10 Kakaɨyari, nehetsie keneunetɨa 'iyari mɨ'itiya,  
\q2 'iyari nehetsie mɨyeka keneuhekwatɨa.   
\q1
\v 11 Pepɨkanetsikupatani 'ahetsɨa nemuyeikanikɨ,  
\q2 'a'iyari mɨtiyupata pepɨkanetsikunawairiwani.   
\q1
\v 12 'Awikweitsitɨarika temawierikayari tawarita keneneupitɨa,  
\q2 'iyari yatikamietɨ kenetsikuyuitɨwani.   
\q1
\v 13 Mɨpaɨ ne'anetɨ 'axateyuruwamete 'ahuye nepɨwaxeitsitɨaka,  
\q2 'axateyuruwamete 'ahetsɨa mepɨ'axɨani.   
\b  
\q1
\v 14 Nekakaɨyari, netsiwikweitsitɨwame,  
\q2 keneneutawikweitsitɨa xuriya nemɨtayeurikɨ,  
\q2 'ana ne nepɨmetsinɨawani 'aixɨa pemɨtiyurienekɨ.   
\q1
\v 15 Neti'aitɨwame, neteni keneupitɨa,  
\q2 nemɨmetsinɨawanikɨ.   
\q1
\v 16 Mawari 'ekɨ pɨkametsinake  
\q2 meta mawari taiyariyari,  
\q2 xɨka metsinakenike ne nepɨmetsixatɨakakeyu.   
\q1
\v 17 Mawari mɨmetsinake  
\q2 'iyari muyuhiwerie pɨhɨkɨ,  
\q1 'ekɨ Kakaɨyari, pepɨka'ixani'erie  
\q2 'iyari mɨtiuka'eniwa meta 'axamɨti'ane mɨtiuhayewaxɨ.   
\b  
\q1
\v 18 Kemɨmetinake, Tsiyuni 'aixɨa mɨtiukaxexeiyanikɨ yaketineuyuri,  
\q2 Kerutsareme tetsariyaya kuraruyari keneutawewi.   
\q1
\v 19 Hikɨ 'ana mawari 'aixɨa mɨ'anene pɨmetsinakire,  
\q2 naitɨ mawari taiyariyari,  
\q2 meta 'amawari taiyametsie mepɨtimawarieni tsikerutsixi.   
\c 52  
\d Teyuitɨwame wa'ukiyari. Kwikari Rawiri 'ɨkitsikaya, kepauka Ruheki 'Erumi tewiyari, Tsahuri mɨpaɨ mɨtiutaxatɨa: «Rawiri 'Akimereki kie kaneyani».  
\q1
\v 1 ¿Titayari 'axamɨti'anetsie pereu'ayetuika, tewi pemɨtɨrɨkaɨye?  
\q2 Kakaɨyari naki'eriyaya yuheyemekɨ yakatineuyuhaneni.   
\q1
\v 2 'Aneni, nawaxa mataxikauni hepaɨ pɨ'ane,  
\q2 pɨtiyuka'unamɨkɨ meta 'itarika pɨwewie.   
\q1
\v 3 'Aixɨa mɨti'ane pepɨkatinaki'erie, matsi 'axamɨti'ane waɨkawa pepɨnaki'erie,  
\q2 tita yuri mɨraine pepɨkanaki'erie, matsi 'itarika pepɨnaki'erie.   
\b  
\q1
\v 4 Kwinimieme ti'itawame neni pepexeiya,  
\q2 Kwinimieme pɨmetinake 'aniukikɨ hipame pemɨwaratixɨrɨwanikɨ.   
\q1
\v 5 Peru neuxei Kakaɨyari pɨmetsika'una yuheyemekɨ,  
\q2 'akiita pɨmetsiwayehɨani,  
\q2 'ena kwiepa pɨmetsi'akumaweriya hipatɨ memanu'uwatsie.   
\b  
\q1
\v 6 Heitserie memexeiya mɨkɨ mepɨtexeiya, 'ana mepɨtimamani,  
\q2 'ana mɨpaɨ mepɨtiyuani me'inanaimatɨ:   
\q1
\v 7 «'Ena tewi xekanixeiyani  
\q2 Kakaɨyari hetsɨa mɨkaye'a mɨkɨ hetsiena mɨtanuanikɨ,  
\q1 matsi pɨta yupiinitɨarikatsie mɨtiwiyakai,  
\q2 'axatiyurienetɨ 'amuyeikakai».   
\b  
\q1
\v 8 Peru neuxei ne huriwa mɨtsiɨraɨye hepaɨ nekani'aneni,  
\q2 Kakaɨyari kie muxutu,  
\q1 Kakaɨyari naki'eriyayatsie nekatiniwiyani  
\q2 yuheyemekɨ yareuyuhanemekɨ.   
\b  
\q1
\v 9 Naime tukaritsie ne nekameninɨawakamɨkɨ 'a'uximayatsikakɨ,  
\q2 ne 'ahetsie nepɨtiwiyani 'ahetsie memɨtewiya wahɨxie,  
\q2 'ekɨtsɨ 'aixɨa pekatiniuka'iyarini.   
\c 53  
\r (Nɨa 53:1-6 – Nɨa 14:1-7)  
\d Teyuitɨwamete wa'ukiyari. 'Ikɨ kwikari kanayukwikani hewayenutuixietɨ. Kwikari Rawiri 'ɨkitsikaya.  
\q1
\v 1 Kemɨ'ane 'atsimɨkatimate mɨpaɨ kanaineni yu'iyaritsie:  
\q2 «Kakaɨyari kaniumaweni».  
\q1 'Axamemɨteyurie mepɨhɨkɨ, naitɨ kememɨteyurie mɨxani'eriwa xeikɨa pɨtihɨkɨ,  
\q2 nixewitɨ tɨma 'aixɨa pɨkatiyuriene.   
\b  
\q1
\v 2 Kakaɨyari muyuawitsie paitɨ teɨteri kaniwataxeiyani,  
\q2 'iwaunetɨ xeime  
\q2 timaiweme meta Kakaɨyari kuwauneme.   
\q1
\v 3 Peru yunaitɨ mepeuyexɨri  
\q2 'axamepɨte'uyuri yunaitɨ,  
\q1 Xewitɨ tɨma 'apɨka'uyeika 'aixɨa tiyurienetɨ,  
\q2 pumawe nixewitɨ.   
\b  
\q1
\v 4 ¿Kamɨtsɨ 'atsimekatemate 'axamemɨteyurie,  
\q2 kemɨ'ane neteɨterima memɨwakwa'a paa hepaɨ?  
\q2 Hatsuaku Kakaɨyari mepɨkahahɨawe.   
\q1
\v 5 Mekaniwamariutani xeikɨa,  
\q2 kepauka mɨkaheuyewetse memɨmamakakɨ.  
\q1 Kemɨ'ane memɨmetsi'aye'uniekai wa'umete Kakaɨyari kaniutaxɨrieni,  
\q2 'ekɨ pekaniwatewiyatsitɨamɨkɨ, Kakaɨyari mɨwarayexɨrikɨ xeikɨa.   
\b  
\q1
\v 6 Kakaɨyari mɨpaɨ mɨnainenike Tsiyuni tiyuwikweitsitɨwame  
\q2 mɨnanɨ'anike 'ixaheritsixi mɨwatawikweitsitɨanikɨ.  
\q1 Kepauka Kakaɨyari yuteɨterima mɨwarakunuitɨanitsie,  
\q2 Kakuwu kaniyutemawiekamɨkɨ: 'ixaheritsixi meta yunaitɨ mekaniyutemamawiekakuni.   
\c 54  
\d Teyuitɨwate wa'ukiyari. Kanarikɨ ke'utanɨawarieni. Kwikari Rawiri 'ɨkitsikaya, kepauka Tsipi kiekatari Tsahuri mɨpaɨ memɨte'utahɨawixɨ: «Rawiri kaniyu'awietani tahamatɨa».  
\q1
\v 1 Kakaɨyari, keneneutawikweitsitɨa pemɨtɨrɨkaɨyekɨ,  
\q2 nehetsie keneutanua 'ekɨ pemɨyɨwekɨ.   
\q1
\v 2 Kakaɨyari, nenenewieri keneu'eni,  
\q2 kenemutaine keneneu'eni.   
\q1
\v 3 Neuxei, teɨteri nemɨkawamate mekanenimietɨweni,  
\q2 mekanenimiekuni mɨkɨ memɨteyukananaima,  
\q2 mɨkɨ teɨteri 'ekɨ Kakaɨyari mepɨkametsinaki'eriku.   
\b  
\q1
\v 4 Peru Kakaɨyari netsiparewiwame kanihɨkɨtɨni,  
\q2 ti'aitame mɨnetsi'ayeyuritɨa kanihɨkɨtɨni,   
\q1
\v 5 mɨkɨ 'axamɨti'ane memɨnetsi'aye'unie wahetsie pɨta katininakimɨkɨ.  
\q2 Yawé, ke'aixɨa pemɨtikamiekɨ keniwaruka'una.   
\b  
\q1
\v 6 Kenemɨtiyuwaɨriya mawari nepɨmetsiwewirieni,  
\q2 meta nepɨmetsitanɨawa, Yawé ke'aixɨa pemɨtiuka'iyari,   
\q1
\v 7 'ekɨtsɨ pekaneniuxɨna naimekɨ kenemɨti'uximatɨariekai,  
\q2 ne nekaniuniere memɨnetsi'aye'unie kememɨte'a'iwarie.   
\c 55  
\d Teyuitɨwamete wa'ukiyari. Rawiri 'ɨkitsikaya. 'Ikɨ kanaritekɨ ke'utakwikarieni.  
\q1
\v 1 Kakaɨyari, nenenewieri keneu'eni,  
\q2 kenemɨmetiwawirie pepɨkayuti'awiwietani.   
\q1
\v 2 Kenenanu'eni meta keneneuta'eiya,  
\q2 'uximatɨarika nepexeiya. Kwinimieme pɨnetsiyurie,   
\q1
\v 3 mɨnetsi'aye'unie tierikaya  
\q2 meta Kakaɨyari memɨka'ayexeiya kememɨte'uyukananaima,  
\q1 mɨkɨ netiuka'eniwame mepɨnetsi'ayeitɨwa  
\q2 meta kepauka memuyeha'arɨwe mepɨnetsi'anutate'a.   
\b  
\q1
\v 4 Ne'iyari putimamawe netaɨta paitɨ,  
\q2 waɨkawa pɨtɨrarɨka nemɨmɨximeni hepaɨ.   
\q1
\v 5 Nepuyɨyɨaka marikakɨ,  
\q2 nepɨmariutsie yemekɨ.   
\q1
\v 6 Kukuru 'anateya xɨka nehexeiyanike,  
\q2 nepanuwienikeyu hakewa nemeka'uxipieni.   
\q1
\v 7 'Ateewa paitɨ nepeyeiwe:  
\q2 makumawetsie neheyeikatɨ nepayeiwe.   
\b  
\q1
\v 8 Xeiya nepewiwe hakewa nemeneti'awiwietatsie,  
\q2 'eka netsihe'enitsitɨanikɨ  
\q2 'eka kwinimieme mɨtitɨrɨkaɨye.   
\b  
\q1
\v 9 Ti'aitame, keniwaruka'una, mekayu'eniekame keniwarayeitɨa.  
\q2 Kiekaritsie nanaimarika 'imieri xeikɨa nepɨxeiya,   
\q1
\v 10 tukarikɨ meta tɨkarikɨ yukuraru 'utɨa mekanikɨnetɨweni,  
\q2 mɨkɨ kuraruta 'axamɨti'ane xeikɨa kanixuaweni.   
\q1
\v 11 Mana 'axamɨti'ane tiyu'uname xeikɨa kanixuaweni,  
\q2 mana kaye 'utɨma 'itarika nanaimarika yakatinixuaweni.   
\b  
\q1
\v 12 Xɨka mɨnetsi'aye'unie netsi'anutatiexɨani,  
\q2 ne nepinewiwe,  
\q1 xɨka mɨnetsi'aye'unie netsinanaimaka,  
\q2 ne nepɨneti'awietawe.   
\q1
\v 13 Peru 'ekɨ pepɨyɨane, tewi nehepaɨ pemɨ'ane,  
\q2 ne'iwa, yemekɨ nehamiku,   
\q1
\v 14 'ahamatɨa nemuyeikakai 'aixɨa 'iyari,  
\q2 tanaitɨ Kakaɨyari tukita temeta'axekai.   
\b  
\q1
\v 15 Memɨnetsi'aye'unie wahetsie mɨɨya ke'aye'ani 'atsimekateha'eriwakaku.  
\q2 Me'ayenenieretɨ teukiyapa mekeheukaxɨrieni,  
\q2 wahetsietsɨ 'axamɨti'ane kaniyekani.   
\b  
\q1
\v 16 Peru ne Kakaɨyari nekanitahɨawimɨkɨ,  
\q2 mɨkɨta Yawé kanenitawikweitsitɨamɨkɨ.   
\q1
\v 17 Ximeri, taikai meta tɨkarikɨ  
\q2 nekanehɨaweni ne'uximatɨarietɨ, mɨkɨta kaneni'enieka.   
\q1
\v 18 Tsepa yuwaɨkawatɨ memɨnetsimietɨwe,  
\q2 mɨkɨ netukari kaniutawikweitsitɨwani,  
\q2 kuyaxa nehepaɨtsita mieme wewiyakaku.   
\q1
\v 19 Kakaɨyari, mɨti'aitame yuheyemekɨ,  
\q2 kaneni'enimɨkɨ mɨkɨ kaniwanutuixitɨamɨkɨ.  
\q1 Mɨkɨ teɨteri hatsuaku mepɨkayupata,  
\q2 Kakaɨyari mepɨkamakaxe.   
\q1
\v 20 Yumamate teikɨ mepetsetsera yuhamikuma wahepaɨtsita,  
\q2 peru mepɨkatehaye'atɨwa kememɨteyutipiniri.   
\q1
\v 21 Yuteta witsimepɨte'eniuriɨkɨ wiya witsima'ane hepaɨ,  
\q2 peru yu'iyaritsie 'imieri xeikɨa mepuku'eriwa.  
\q1 Waniuki witsipɨ'ane hatseiti hepaɨ,  
\q2 peru 'ixipara mataxikakauni mepɨhɨkɨ.   
\b  
\q1
\v 22 Yawé ketineyetuiri kepemɨranuyemie,  
\q2 mɨkɨ kamenituikakamɨkɨ,  
\q1 mɨkɨ pɨka'ipitɨani heitserie mexeiya matiwautsenikɨ,  
\q2 yumuinatɨ yuheyemekɨ mɨkayukuhayeikawanikɨ.   
\q1
\v 23 'Ekɨ matsi Kakaɨyari, memɨkametsi'ayexeiya pepɨwaratixɨrieni  
\q2 teukiyapa pepɨwareukaxɨrieni,  
\q1 teɨteri xuriya memɨtayeuri memɨte'itawa,  
\q2 mɨkɨ yutukari hixɨapa tɨma mepɨka'utinexɨani.  
\q1 Ne matsi, 'ahetsie nepɨtiwiya.   
\c 56  
\d Teyuitɨwamete wa'ukiyari. Kwikarieya xekeneuweiyani «Tuaxatsie kukuru 'ateewa muyeka». Rawiri 'ikɨ nɨawari meka'utɨa, kepauka piritsiteutsixi pɨretsu memeyeitɨa Kahati kiekariyaritsie.  
\q1
\v 1 Kenenenenimayaka, xɨa'ui Kakaɨyari,  
\q2 teɨteri mepuxuawe menetsi'uweiyatɨ.  
\q1 Tukarikɨ mepɨnetsimietɨwe memɨnetsi'aye'unie,   
\q2
\v 2 tukarikɨ mekaneniuweiyani menetsimiekutɨ,  
\q2 mekaniyumɨireni meyuti'ɨretɨ memɨnetsimietɨwe.   
\b  
\q1
\v 3 Kepauka nemeuma,  
\q2 'ahetsie xeikɨa nepɨtiwiya.   
\q1
\v 4 Kakaɨyari hetsie nepɨtiwiya, niukieya nepɨnɨawa,  
\q2 Kakaɨyari hetsie nepɨtiwiya, nepɨkaheuma.  
\q2 Ketitayari kuta tewi netimakaka 'atsimɨkanetsi'uyuriwe.   
\b  
\q1
\v 5 Tukarikɨ neniuki mekanititunani,  
\q2 kememɨnetenanaimani xeikɨa, mɨpaɨ mekateniku'eriwani.   
\q1
\v 6 Mekanenihupieka xeikɨa,  
\q2 kwi mekaniyɨaka menetsimiekutɨ  
\q2 kwi xeikɨa mekanenixeiyani kenemɨtiyuriene.   
\q1
\v 7 Nekakaɨyari, 'ahaxɨakɨ mɨkɨ teɨteri keniwarunanaima.  
\q2 Nitɨma memuyuta'una pepɨkawapitɨaka.   
\b  
\q1
\v 8 'Ekɨ pepi'inɨata kenemɨtiyuku'unane,  
\q2 puteyutsie ne'ukai pepɨkatua.  
\q2 ¿Kamɨtsɨ pekareye'utɨa?   
\q1
\v 9 Kepauka ne parewiya nemɨmetsitawawirieni,  
\q2 memɨnetsi'aye'unie mekanitanautsaxɨakuni.  
\q1 Ne mɨpaɨ nekatinimaika: Kakaɨyari nehamatɨa puyeika.   
\q1
\v 10 Kakaɨyari hetsie nepɨtiwiya, niukieya nepɨnɨawa,  
\q2 Yawé hetsie nepɨtiwiya, niukieyatsie nepɨnetemawie,   
\q1
\v 11 Kakaɨyari hetsie nepɨtiwiya, ne nepɨkaheuma.  
\q2 ¿Ketitarikuta tewi netimakaka 'atsimɨkatiuyuriwe?   
\b  
\q1
\v 12 Kakaɨyari, ne 'ahetsiemieme nepɨnetipiniri,  
\q2 ne kenemɨtiyutemawie nepumatitimawirieni.   
\q1
\v 13 'Ekɨ Kakaɨyari, nemekawautsetsie pepɨnetsi'ɨxɨnaxɨ,  
\q2 teukiyapa pepɨnetsi'ayeha,  
\q1 yuheyemekɨ 'ahɨxie nemɨmienikɨ  
\q2 tukarikɨ hekɨariyatsie.   
\c 57  
\r (Nɨa 57:7-11 – Nɨa 108:1-5)  
\d Teyuitɨwamete wa'ukiyari. Yuariyaya xekeneuweiyani «Pepɨkawaka'unani». Rawiri 'utɨarikaya, kepauka Rawiri terɨta mayekatei 'uyu'unarɨmetɨ Tsahuri makatɨ.  
\q1
\v 1 Xɨa'ui Kakaɨyari, kenenenenimayaka,  
\q2 keneneutinenimayata, ne 'ahetsie nepɨtiwiya.  
\q1 'A'anate 'etɨriyayatɨa nepɨneti'awieta,  
\q2 naitɨ 'uximatɨarika ranuyeyayuke nepuwayeyani.   
\b  
\q1
\v 2 Kakaɨyari 'Amutewi nekanahiwiwani,  
\q2 Kakaɨyari kemɨ'ane mɨnetsiparewie.   
\q1
\v 3 Muyuawitsie paitɨ 'akawetɨ kaneniutawikweitsitɨwani,  
\q2 kemɨ'ane memɨnetsi'uweiya menetsimienike kaniwatate'ani.  
\q2 Kakaɨyari yunaki'eriya meta tita yuri mɨraine kanenanɨ'airiemɨkɨ.   
\b  
\q1
\v 4 'Ɨrawetsixi teyukwa'amete wahixɨapa nekaniuweni,  
\q2 teɨteri me'ayu'eririyatɨ ne'aurie mekanawetɨkani.  
\q1 Watamete 'ɨrɨ meta pitsika kanihɨkɨtɨni.  
\q2 Waneni, 'ixipara mataxikauni kanihɨkɨtɨni.   
\b  
\q1
\v 5 Peru 'ekɨ, Kakaɨyari, muyuawi reuyeta peputewi,  
\q2 'axawatɨriya kwie naime kehekɨariwiyani.   
\b  
\q1
\v 6 Winiyari nehuyeta mekaniuwieni,  
\q2 'ana nekanewaɨriyatɨ nepatɨa.  
\q1 Nehuyeta mekanewatixawarita,  
\q2 peru mɨkɨ pɨta muwa mepeukaxɨri.   
\b  
\q1
\v 7 Kakaɨyari, ne'iyari pɨheitserie,  
\q2 ne'iyari puyuwaɨriya.  
\q2 Nɨawari 'ahetsiemieme nepɨtikwika.   
\q1
\v 8 Ne 'iyari, kenanutanieri.  
\q2 Kanari meta xaweri xekenanutanenieri.  
\q2 Hekwame tukari tepanutahɨtɨani.   
\b  
\q1
\v 9 Ti'aitame, nepɨmetsinɨawani teɨteri watsata,  
\q2 nɨawari 'ahetsiemieme nepɨtikwika nuiwarite wahɨxie.   
\q1
\v 10 'Anaki'eriya mɨmariwe muyuawitsie paitɨ mɨye'axekɨ,  
\q2 Yuri kepemɨtarahɨawe haitsie paitɨ pɨye'axe.   
\b  
\q1
\v 11 'Ekɨ, Kakaɨyari, muyuawi reuyeta peputewi,  
\q2 'axawatɨriya kwie naime kehekɨariwiyani.   
\c 58  
\d Teyuitɨwamete wa'ukiyari. Kwikarieya xekeneuweiyani «Pepɨkawaka'unani». Rawiri 'utɨarikaya.  
\q1
\v 1 ¿Kamɨtsɨ xeme 'itsɨkate, 'aixɨa 'anemekɨ xete'aita,  
\q2 yemekɨ xetewaheitseritɨa kepauka teɨteri xemɨxanetɨarie?   
\q1
\v 2 Matsi pɨta wa'atɨ, yu'iyaritsie kemɨkatiheitserie xeteku'eriwa,  
\q2 meta xenanaimarika mɨkɨ kwieyaritsie kanihekɨaka.   
\q1
\v 3 'Axateyuruwamete 'amɨtitinuiwatsie 'axameteyurietɨ mekanakɨkani,  
\q2 kemɨ'ane memɨte'itawa yumaamama wahetsie paitɨ meyetetɨ mekaneuyexɨrɨweni.   
\q1
\v 4 Kuuterixi mɨyakame kememɨtehexeiya hepaɨ 'aneme mepexeiya,  
\q2 kuu 'amumu'uyewa hepaɨ kaheu'enatɨ mayuyeitɨwa   
\q1
\v 5 ka'i'enimɨtɨ timaiweme yuitɨarikaya,  
\q2 tsepa kepauka mɨti'uximaya waɨkawa tiwareutayuitɨiriewetɨ kuuterixi.   
\b  
\q1
\v 6 Kakaɨyari, keniwaranaye'uniri watamete,  
\q2 Yawé, mɨkɨ mayetsi watamete 'amɨtɨtɨ keniwaranatihapaniri.   
\q1
\v 7 'Amamatetsie haa hepaɨ meke'ukakunetɨkɨne,  
\q2 kepauka yutupi memahapani wa'ɨrɨ kehakamurixɨani.   
\q1
\v 8 Kɨrɨpu 'aɨrikaya mɨkareutetere hepaɨ meke'ɨyɨni  
\q2 nunutsi mɨkitɨ mutinuiwaxɨ hekɨariya mɨka'uxei hepaɨ.   
\q1
\v 9 'Atsimekatemaitɨ, xuya hepaɨ meke'anutatani,  
\q2 'eka keware'enitsitɨani, tsepa memɨyuyuri yatɨni memɨwawaki.   
\b  
\q1
\v 10 Heitserie mexeiya puyukatemawieni kepauka mɨniere petiwarakapitɨwakaku,  
\q2 Kakaɨyari mɨka'ayexeiya xuriyayatsie yewetɨ.   
\q1
\v 11 Hikɨ teɨteri mɨpaɨ mepɨtiyuani:  
\q2 «Puyuri heitserie memu'uwa mepɨte'akapitɨariwa yu'iwarikakɨ,  
\q2 puyuri xewitɨ Kakaɨyaritɨtɨ 'apuyeika kwiepa heitserie tiyurienetɨ».   
\c 59  
\d Teyuitɨwamete wa'ukiyari. Kwikarieya xekeneuweiyani «Pepɨka'ika'unani». Rawiri 'utɨarikaya, kepauka Tsahuri mɨtiuta'ai Rawiri kiiya mɨhɨriekakɨ meta mɨmierienikɨ.  
\q1
\v 1 Xɨa'ui, Kakaɨyari, keneneutawikweitsitɨa memɨnetsi'aye'unie wahetsɨa,  
\q2 nehetsie kenenuaka nemɨmierienekɨ.   
\q1
\v 2 'Axateyuruwamete wahetsɨa keneneutawikweitsitɨa,  
\q2 meta memɨteyumemiwa wahetsɨa.   
\b  
\q1
\v 3 Keniwaruxeiya kememɨnetehupietɨwe.  
\q2 Yawé, teɨteri 'axamete'u'iyaritɨ mekanenimiekuni  
\q2 tsepa ne 'axanekatiyuriene.   
\q1
\v 4 Mekaniyumexɨitɨaka me'aye'axɨanike  
\q2 tsepa ne 'axanekawayuriene.  
\b  
\q1 Xeiya kenaye'a keneneuparewi.  
\q2 Keneneuxeiya hikɨ kenemɨ'ane.   
\q1
\v 5 'Ekɨ, Yawé, Kakaɨyari pepɨhɨkɨ Naimekɨmɨtɨrɨkaɨye.  
\q2 'Ixaheri Kakaɨyarieya pepɨhɨkɨ.  
\q1 Xeiya kenanukukeka keniwaru'uximatɨa yunaime nuiwarite,  
\q2 pepɨkawanenimayaka mɨkɨ memɨteyukananaima.   
\b  
\q1
\v 6 Tɨkarikɨ mekani'axeni,  
\q2 tsɨikɨri wahepaɨ mete'uyuhaxɨatɨwatɨ  
\q2 kiekari warita mekaneuhupatɨkani.   
\q1
\v 7 Mekanatakwaimuxatɨkani yutenie,  
\q2 'ixipara yuteta mekanatinenetɨwani,  
\q2 mɨpaɨ me'utiyuatɨ: «Kemɨ'ane kuta pɨtatsi'enie».   
\q1
\v 8 'Ekɨ matsi, Yawé, xɨa'ui pepaine wahetsiemieme,  
\q2 pepanawe nuiwarite wahetsiemieme.   
\q1
\v 9 'Ekɨ, netɨrɨkariya pekanihɨkɨtɨni, 'ahetsɨa nepeutaniere,  
\q2 'ekɨtsɨ, Kakaɨyari, nehetsie nunuwame pekanihɨkɨtɨni.   
\q1
\v 10 'Ekɨ Kakaɨyari pekanihɨkɨtɨni pemɨnetsinaki'erie,  
\q2 pe'anuyekaitɨ pekaniyemieni  
\q2 nehɨxie pemɨwareka'unakɨ memɨnetsi'aye'unie.   
\q1
\v 11 Peru pepɨkawarekukukuyani,  
\q2 neteɨterima memɨkatehatɨtɨmaiyanikɨ.  
\q1 Keniwaranutarɨwaitɨaxɨa kepemɨtitɨrɨkaɨye, haweri keniwaruyuri.  
\q2 Tati'aitɨwame, 'ekɨ tahetsie nunuwame pekanihɨkɨtɨni.   
\q1
\v 12 Yutetakɨ 'axamemutiyuanekɨ,  
\q2 yuniukikɨ 'axamemɨteyuriekɨ,  
\q2 kememɨteyutimariwekata winiyaritsie meke'ukaxɨrieni.  
\q1 Memɨteyukakwatsekɨ 'itarikakɨ memutiniukakɨ,   
\q2
\v 13 keniwarutixɨtsitɨa 'ahaxɨakɨ,  
\q2 yemekɨ keniwarutixɨtsitɨa memɨka'u'uwanikɨ.  
\q1 'Ana yumɨiretɨ mɨpaɨ mepɨtehetimani kename 'aku 'ixaheritsixi wahetsie Kakaɨyari ti'aita,  
\q2 metatsiere kwie manu'axe paitɨ.   
\b  
\q1
\v 14 Mɨkɨtsɨ tɨkarikɨ mekani'axeni,  
\q2 tsɨikɨri wahepaɨ mete'uyuhaxɨatɨwatɨ  
\q2 kiekari warita mekaneuhupatɨkani.   
\q1
\v 15 Mana mekaniu'uwani tsepa hakewa 'ikwai meheuwautɨkaitɨ,  
\q2 xɨka mekahuxaka mekaniutitsuanani.   
\q1
\v 16 Ne matsi 'atɨrɨkariya nepɨnɨawani,  
\q2 ximerita 'anaki'eriya nepɨnɨawani,  
\q1 'ekɨ nehetsie nunuwame pemɨhɨkɨkɨ,  
\q2 kepauka nemu'uximatɨarie 'ahetsɨa nepɨneti'awiwieta.   
\b  
\q1
\v 17 'Ekɨ netɨrɨkariya pekanihɨkɨtɨni, nɨawari nepɨtikwika 'ahetsiemieme,  
\q2 'ekɨtsɨ, Kakaɨyari, nehetsie nunuwame pekanihɨkɨtɨni.  
\q2 'Ekɨ Kakaɨyari pekanihɨkɨtɨni pemɨnetsinaki'erie.   
\c 60  
\r (Nɨa 60:5-12 – Nɨa 108:6-13)  
\d Teyuitɨwamete wa'ukiyari. Yuariyaya xekeneuweiyani «Tuturi tɨratuyari». Rawiri 'ɨkitɨarikaya, kepauka 'arameutsixi muwarutakwi Metsuputamiya yeta kiekatari meta Tsiriya hixɨapa kiekatari, meta kepauka Kuhawi makunua tawarita tamamata heimana huta miriyari (12.000) 'erumitsixi muwarukwi mayeweri Maye'unaya mɨrayetewatsie.  
\q1
\v 1 Neuxei, Kakaɨyari, 'ekɨ pepɨtatsihexɨri  
\q2 'ekɨ pepɨtatsi'utatsanaxɨ,  
\q1 pepɨtatsi'uyehekaxɨ,  
\q2 hikɨ 'aixɨa ketaneuyuri.   
\q1
\v 2 Kwie pekaniutayuitɨani,  
\q2 pekanitatsiniya,  
\q1 'aixɨa keneuyuri mukatataritsie,  
\q2 karikɨ kaneuku'unikeni.   
\q1
\v 3 Waɨkawa temɨta'inɨatsienikɨ pepɨtatsi'upitɨa,  
\q2 winu pepɨtatsi'u'itɨa mɨtawaiya.   
\b  
\q1
\v 4 'Ahetsie memɨtewiya 'inɨari keniwaruwewiri  
\q2 memɨyuta'unakɨ temɨmɨmete wahɨxie.   
\q1
\v 5 'Atseriekɨ ketaneutawikweitsitɨa, ketaneta'eiya  
\q2 'ateɨterima pemɨwanaki'erie memɨtawikwenikɨ.   
\b  
\q1
\v 6 Kakaɨyari mɨpaɨ kanaineni yutukita:  
\q2 «Tsikeni nepɨtixiteni nerane'iwatɨ,  
\q2 meta mayeweri Tsukuti nepuwati'inɨatsirieni wakwie.   
\q1
\v 7 Karaha nehetsɨa mieme kanihɨkɨtɨni, Manatsexi nehetsɨa mieme kanihɨkɨtɨni,  
\q2 'Epɨrahini kuya menaketsa kanihɨkɨtɨni nemu'utsie nunuwame,  
\q2 Kura meta ne'itsɨ kanihɨkɨtɨni.   
\q1
\v 8 Muhawi hetsie nekaniukamaimawani,  
\q2 'Erumi hetsie nekakai nekaneutaxɨrɨwani,  
\q2 Piritsiteu kwieyari hetsie nekanahiwani tetehayu'iwaka».   
\b  
\q1
\v 9 ¿Kemɨ'ane pɨnetsi'anuwitɨni kiekari mahɨrietsie?  
\q2 ¿Kemɨ'ane 'Erumi huyeyari pɨnetsixeitsitɨani?   
\q1
\v 10 'Ekɨ pekanihɨkɨtɨni, Kakaɨyari, kemɨ'ane mɨtatsi'uku'eiri,  
\q2 Kakaɨyari, tawariri takuyaxima wahamatɨa pepɨka'ayeyeika.   
\q1
\v 11 Ketaneuparewi memɨtatsi'aye'unie wahepaɨtsita,  
\q2 neuxei tixaɨtɨ pɨkatiyunaki'erie tewi parewiyaya.   
\q1
\v 12 Kakaɨyari tatsiparewiekaku tepɨtehayu'iwa,  
\q2 mɨkɨ memɨtatsi'aye'unie pɨwatiketsini.   
\c 61  
\d Teyuitɨwamete wa'ukiyari. Kanaritsie xekeneutikwikani. Rawiri nɨawarieya.  
\q1
\v 1 Kakaɨyari, nehiwari keneu'eni  
\q2 nenenewieri kene'enieka.   
\b  
\q1
\v 2 Kwie manu'axe paitɨ ne nepɨmetsihahɨawe,  
\q2 ne'iyaritsɨ kanimɨximeni,  
\q2 'ai heima kenenetuamie muwa nemekuwikwenikɨ.   
\q1
\v 3 'Ekɨ netsi'awiwietame pepɨhɨkɨ,  
\q2 pemɨnetsitɨrɨkariya memɨnetsi'aye'unie wahetsiemieme.   
\b  
\q1
\v 4 Nepeiyehɨwa 'akie nemukanikɨ yuheyemekɨ  
\q2 nemɨne'awietanikɨ 'a'anatetɨa.   
\b  
\q1
\v 5 'Ekɨ, Kakaɨyari, kenemɨtinehɨritɨa pepu'eni  
\q2 kemɨ'ane memɨmetsi'ayexeiya kepemɨtiwamikwa neta pepɨnetiyetuiri.   
\b  
\q1
\v 6 Kwiepa ti'aitame waɨkawa tukari wiyari keneupitɨa,  
\q2 tukari kaxɨweme keneupitɨa.   
\q1
\v 7 Keti'aitani 'ahɨxie yuheyemekɨ,  
\q2 'anaki'eriya meta 'aniuki yuri maine ke'i'ɨwiyani.   
\q1
\v 8 Mɨpaɨ nepɨtiukwikani 'ahetsiemieme  
\q2 meta nepeye'atɨani kenemutayɨ tukari mɨyehane.   
\c 62  
\d Teyuitɨwamete wa'ukiyari. Kerutuni hetsiemieme. Rawiri nɨawarieya.  
\q1
\v 1 Kakaɨyari hetsie xeikɨa ne'iyari puka'uxipiwe,  
\q2 mɨkɨ hetsɨa xeikɨa newikweitsitɨarika payeneika.   
\q1
\v 2 Mɨkɨ xeikɨa ne'ai 'amautitewa pɨhɨkɨ netsiwikweitsitɨwame,  
\q2 mɨkɨ nehetsie nunuwame pɨhɨkɨ.  
\q2 Hatsuaku nepɨkahatiweni.   
\b  
\q1
\v 3 ¿Kepaukake xeme xeyunaitɨ xepɨtehayewa  
\q2 xe'imietɨwetɨ xeime tewi xemetihɨanikɨ?  
\q1 'Ixumeri matiwexime hepaɨ kani'aneni,  
\q2 kuraru mɨta'unirɨme hepaɨ.   
\q1
\v 4 Hakewa meka huyeripana xeikɨa  
\q2 mana mepiweiyaku.  
\q1 'Itarikatsie temawierika mepexeiya:  
\q2 'aixɨa mepɨtehatahɨawe yutenikɨ,  
\q2 yu'iyarikɨ 'axametehaku'eriyatɨ.   
\b  
\q1
\v 5 Kakaɨyari hetsie xeikɨa ne'iyari puka'uxipiwe,  
\q2 mɨkɨ xeikɨa nepɨtakwewie.   
\q1
\v 6 Mɨkɨ xeikɨa ne'ai 'amautitewa pɨhɨkɨ netsiwikwetsitɨwame,  
\q2 mɨkɨ nehetsie nunuwame pɨhɨkɨ  
\q2 hatsuaku nepɨkahatiweni.   
\q1
\v 7 Kakaɨyari netsiwikweitsitɨwame pɨhɨkɨ witsine'aneme pɨnetsi'ayeitɨa,  
\q2 'ai 'amautitewa nehetsie nunuwame kanihɨkɨtɨni,  
\q2 hakewa nemeneti'awieta Kakaɨyari hetsɨa katini'aneni.   
\q1
\v 8 Hetsiena yuheyemekɨ xeketenewiyani, teɨteri hetsɨana miemete,  
\q2 'a'iyaritsie ketineuyepiri kepauka hɨxiena pemuwe.  
\q2 Kakaɨyari tahetsie nunuwame kanihɨkɨtɨni.   
\b  
\q1
\v 9 Mɨkɨ teɨteri 'eka hepaɨ mekani'aneni, kemɨ'ane tixaɨtɨ memɨkatehayuyeitɨa,  
\q2 teɨteri memamariwaweme memayuyeitɨa 'itarika mepɨhɨkɨ,  
\q1 yunaime mɨkɨ xɨka waranuyewieni,  
\q2 yunaitɨ mɨkɨ mepɨkahahete.   
\b  
\q1
\v 10 'Axamɨti'anetsie xepɨkatewiyani  
\q2 witsixepɨkateku'eriwani yu'inawarikɨ,  
\q1 tsepa xepiinite mɨtiutimɨirixɨ,  
\q2 mɨkɨ hetsie yu'iyari xepɨkatewiyatsitɨaka.   
\b  
\q1
\v 11 Kakaɨyari yurikɨ pɨraxaxata,  
\q2 ne hutakɨa nepi'eni:  
\q1 'Ekɨ, Kakaɨyari, pepɨtɨrɨkaɨye,   
\q2
\v 12 'ekɨ, Tati'aitɨwame, pepɨti'akanaki'erie waɨkawa,  
\q1 'ekɨ yuxexuime yunaime  
\q2 yapepɨtiwarakapitɨwa kememɨte'uyurikɨ.   
\c 63  
\d Rawiri nɨawarieya, kepauka makumawetsie muyeikakai Kura kwieyaritsie.  
\q1
\v 1 Kakaɨyari, 'ekɨ pepɨnekakaɨyari,  
\q2 ne yemekɨ nepɨmetsiwaune.  
\q1 Ne 'iyari 'akɨmana peuharimɨkɨ,  
\q2 yemekɨ nemetsiheuyehɨwa,  
\q2 kwie mɨwaki haa meuyehɨwa hepaɨ.   
\b  
\q1
\v 2 'Atukita nemetsihaxeiyawe  
\q2 'atɨrɨkariya meta kepemɨtimariwe nepuxei.   
\q1
\v 3 'Anaki'eriya 'aixɨa matsi pɨ'ane keyuri tukari,  
\q2 'Ayumieme ne nepɨmetsinɨawani.   
\q1
\v 4 'Aixɨa nepaineni 'ahepaɨtsita mexi'akuxi ne'uyeika,  
\q2 nepɨmetsihahɨaweni teikɨ nehemetɨ.   
\b  
\q1
\v 5 Ne'iyari 'aixɨa pɨtika'erieni  
\q2 'ixɨararipa waɨkawa mɨratikwaiwa hepaɨ,  
\q1 waɨkawa yemekɨ nenetemawietɨ,  
\q2 nepɨmetsinɨawani.   
\b  
\q1
\v 6 Ne'utatsie ne'ukaitɨ nepɨmetsiha'eriwa,  
\q2 nepɨmetsiku'eriwa tɨkarikɨ.   
\q1
\v 7 'A'anate 'etɨriyayatɨa nepɨkwikani,  
\q2 'ekɨtsɨ netsiparewiwame pekanihɨkɨtɨni.   
\q1
\v 8 Ne'iyari yuheyemekɨ 'ahetsie pɨtiwiya,  
\q2 'amamá 'atserieta mieme pɨnetsikuhana.   
\b  
\q1
\v 9 Kemɨ'ane memɨnetsimieku mepɨka'unarieni,  
\q2 kwieta meukatewatsie mepɨkayune.   
\q1
\v 10 'Ixiparakɨ mepɨkwi'iwa  
\q2 yawixi memayu'eririya mepɨwatikwani.   
\b  
\q1
\v 11 Ti'aitame Kakaɨyari hetsiemieme puyutemawieka,  
\q2 yunaitɨ kemɨ'ane Kakaɨyari memahɨawe mepitanɨawa,  
\q2 peru memɨte'itawa kayuwatɨ mepɨpitɨarieni.   
\c 64  
\d Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya.  
\q1
\v 1 Kakaɨyari, neniuki keneu'eni nekukuiniya hepaɨtsita nemaniuka,  
\q2 kenene'ɨwiyani memɨnetsi'aye'unie nemɨkawamakaxenikɨ.   
\q1
\v 2 Keneneuti'awieta mɨkɨ Kakaɨyari memɨka'ayexeiya memɨnetsi'uweiyakɨ,  
\q2 mɨkɨ 'axamemɨte'u'iyari wahɨxie.   
\q1
\v 3 Yuneni mepɨmɨwa 'ixipara hepaɨ,  
\q2 meputiniuka niuki 'axa'anɨyɨnemekɨ 'ɨrɨkɨ memɨte'utamɨmɨni hepaɨ.   
\q1
\v 4 Mehupatɨri, hetsiena mɨkatiuhɨiwa meputamɨmɨ,  
\q2 meka'imariyatɨ 'atsimekatehehɨawetɨ.   
\b  
\q1
\v 5 Kakaɨyari memɨka'ayexeiya yunaitɨ yemekɨ kememɨtexata mepɨyuwaɨritɨa,  
\q2 mepi'inɨata kehepaɨ winiyari memɨtewieni,  
\q2 'akuxi matsi mɨpaɨ mekaniutiyuaneni: «¿Kemɨ'ane 'aku pixeiya?»   
\q1
\v 6 Tita mɨkatiheitserie mepɨteku'eriwa, mɨpaɨ meputiyuane:  
\q2 «Yemekɨ 'aixɨa tepɨteku'eriwa».  
\q1 Yemekɨ pɨkayumatiwanɨa  
\q2 teɨteri wa'iyaritɨarika.   
\b  
\q1
\v 7 Peru Kakaɨyari wa'ɨrɨkɨ pɨwatimɨni,  
\q2 'atsimekateha'eriwatɨ mepatixɨrieni mete'uka'eniwatɨ.   
\q1
\v 8 Yunenikɨ haweri 'anekɨa mepuyutixɨrieni,  
\q2 kehate memɨwaxeiya mepɨwata'atse.   
\b  
\q1
\v 9 Yunaitɨ teɨteri mepɨtimamani:  
\q2 Kakaɨyari kemɨtiuyuri pɨtaxatsieni  
\q2 'uximayatsikaya mepuku'eriwani.   
\q1
\v 10 Heitserie memexeiya Yawé hetsie mekeyutemamawieka,  
\q2 hetsiena hakewa memeyu'awietani meke'utiwauni,  
\q2 yunaitɨ 'iyari heitseriemekɨ memexeiya meke'inɨawani.   
\c 65  
\d Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya. Kwikari.  
\q1
\v 1 'Ekɨ, Kakaɨyari 'aku Tsiyuni mieme,  
\q2 Nɨawari pɨ'ahetsiemieme.  
\q1 'Ekɨ matsi peuyewetse ketemɨteyɨhɨritɨa temɨmete'aye'atɨiriwani,   
\q2
\v 2 'ekɨtsɨ nenewieri pekani'enieka.  
\q1 Yunaitɨ teɨteri 'ahetsɨa mepɨye'axe,   
\q2
\v 3 'axamemɨte'u'iyarikɨ.  
\q1 'Axaketemɨteyurie mɨkɨ pɨtatsihatixɨrɨwa,  
\q2 'ekɨ matsi pepɨtareuyehɨwirie.   
\q1
\v 4 'Aixɨa ke'itɨarieka 'iya kemɨ'ane 'ekɨ pemanayexei,  
\q2 'iya kemɨ'ane 'ahetsɨa pemɨ'atɨa 'atakwa mukanikɨ.  
\q1 'Akie timieme 'aixɨa mɨti'anekɨ tekehuxaka,  
\q2 kepemɨtatiumi 'atuki mɨpatsieta timiemekɨ.   
\b  
\q1
\v 5 'Ekɨ, Kakaɨyari 'aku tatsiwikweitsitɨwame,  
\q2 pepɨtatsiku'eiya mariwemekɨ heitseriemekɨ,  
\q1 'ekɨ pepɨtakwewiya naitsarie kwie manu'axe paitɨ  
\q2 meta haramara manu'axe paitɨ.   
\q1
\v 6 'Ekɨ, 'atɨrɨkariyakɨ, hɨri peputiwewi,  
\q2 kepemɨtitɨrɨkaɨye pepɨtiuyuri.   
\q1
\v 7 'Ekɨ matsi haramara ha'akaku pepinɨtɨa,  
\q2 hamewarieya kemɨtiuyuanekai,  
\q2 meta teɨteri wahiwari.   
\q1
\v 8 Yunaitɨ naitsarie kwiepa memɨtama  
\q2 mepɨmama mariwemekɨ kepemɨtiyuriene,  
\q1 tau manatineika meta makayuyuipike  
\q2 'ekɨ kwikari witsi'anɨyɨneme pepɨwapitɨa.   
\b  
\q1
\v 9 'Ekɨ peti'ɨwiyatɨ kwiepa pepɨtiweriya,  
\q2 waɨkawamekɨ pepɨtiweriya.  
\q1 Kakaɨyari 'akiteyatsie haa pɨhɨpɨne,  
\q2 tɨriku teɨteri memexeiyanikɨ.  
\q2 Mɨpaɨ kwie 'aixɨa pekaniyurieka.   
\q1
\v 10 Xuruku hakɨ pepɨhatuiya, haxu pepɨtipeniya pepekuweririta,  
\q2 kwie pepɨyumenariya wiyerikɨ  
\q2 meta tita mɨtitineika 'aixɨa pepɨtiyurie.   
\q1
\v 11 'Ekɨ xeiwitari xeitaxari pepikemaritɨa waɨkawa petixuaweritɨatɨ,  
\q2 kaxetate pɨtihɨpɨrike waɨkawa mɨtixuawekɨ.   
\q1
\v 12 'Ɨxa pɨtsitsiɨrawi makuwakitsie mieme,  
\q2 yemurite temawierika kamixateyari panakatɨkɨ.   
\q1
\v 13 Mukuweweritsie tewaxi kiekari hepaɨ mepɨteyuxexeiya,  
\q2 mayeweweritsie tɨriku pɨhɨkɨa,  
\q2 meputikwika meputihiwa temawierikakɨ.   
\c 66  
\d Teyuitɨwamete wa'ukiyari. Kwikari. Nɨawari.  
\q1
\v 1 Kakaɨyari xekenehiwieka yutemawierima,  
\q2 yunaitɨ teɨteri kwiepa xemɨtama.   
\q1
\v 2 Nɨawari hetsiena mieme xekeneutikwikani,  
\q2 Kakaɨyari witsikemɨ'ane kwikari xekenepitɨaka.   
\q1
\v 3 Kakaɨyari mɨpaɨ xeketeneutahɨawi:  
\q2 «Yemekɨ pɨmamariwawe 'a'uximayatsika.  
\q1 Pɨmariwe 'atɨrɨkariya  
\q2 memɨmetsi'aye'unie 'ahɨxie memamatɨ mepuyuyetua.   
\q1
\v 4 Yunaitɨ kwiepa memɨtama 'ahɨxie mepukahɨxima'uwe,  
\q2 memetsitanɨawake,  
\q2 kwikari 'ahetsiemieme mepɨtikwika».   
\b  
\q1
\v 5 Xekenakɨni xeketeneuxeiya Kakaɨyari kemɨtiyurieni,  
\q2 tahetsiemieme mariweme kemɨtiuyuri,   
\q1
\v 6 Haramara 'akuwakime kanayeitɨani,  
\q2 teɨteri me'uhutɨ mana mekaniukɨne.  
\q2 Tepɨyutemamawieka hetsiena.   
\q1
\v 7 Yutɨrɨkariyakɨ pɨti'aita yuheyemekɨ,  
\q2 naitsarie nuiwarite puwaxeiya.  
\q2 'Axamemɨte'u'iyari hetsiena mepɨkate'uhɨpani.   
\b  
\q1
\v 8 Yunaitɨ teɨteri, 'aixɨa xeketenekɨhɨaweni takakaɨyari,  
\q2 kwikari hetsiena mieme 'eniɨriɨkɨme xekenayeitɨa.   
\q1
\v 9 Mɨkɨ tatukari kani'ɨwiyani,  
\q2 pɨtatsi'ɨwiya temɨkahekaxɨrɨwenikɨ.   
\b  
\q1
\v 10 Kakaɨyari 'aku, 'ekɨ pepɨtatsi'uta'inɨataxɨ,  
\q2 tepɨa pɨrata hepaɨ 'aixɨa pepɨtatsi'utiyuri.   
\q1
\v 11 Winiyaritsie pepɨtatsi'ukaxɨri,  
\q2 takwatsapaɨ 'ika raheteme pepɨtatsi'utitɨtɨa.   
\q1
\v 12 Kawayutsixi taheima mepuyekɨ, tamu'ute meputitaraxɨ,  
\q2 taipa tepuyekɨ meta hapa,  
\q2 matsi 'imatɨrieka 'aixɨa 'anemekɨ tepupitɨarie.   
\q1
\v 13 'Atukita nepeutahani mawari taiyariyari nepɨmatsipitɨani  
\q2 meta kenemutayɨ nepɨraye'atɨani,   
\q1
\v 14 netenikɨ kenematiutahɨawixɨ  
\q2 meta kenemutayɨ netiuka'eniwatɨ.   
\q1
\v 15 Mawari taiyariyari nepɨmetsiwewirieni tewaxi memɨwaiyatɨkakɨ,  
\q2 muxatsi 'ukitsi wamawari kɨtsiyari wahamatɨa,  
\q2 tuurutsixi nepɨmetsitimawirieni meta tsipuri 'ukitsi.   
\b  
\q1
\v 16 Xeme xekenakɨni, Kakaɨyari xemɨmakaxe,  
\q2 xekeneu'enana, nepɨtixetaxatɨani  
\q2 mɨkɨ kemɨtiuyuri naime nehetsiemieme.   
\q1
\v 17 Netenikɨ nekanitahiwieni,  
\q2 nenenikɨ nekanitanɨawa.   
\q1
\v 18 Xɨka ne'iyaritsie 'axamɨti'ane neranukananike,  
\q2 Ti'aitame pɨkanetsi'enienikekai,   
\q1
\v 19 peru neuxei Kakaɨyari kaneniu'enieni,  
\q2 yakatiniuyurieni kenemɨtitahɨawixɨ netiuka'eniwatɨ.   
\q1
\v 20 'Aixɨa ke'itɨarieka Kakaɨyari,  
\q2 nenenewieri manu'enikɨ  
\q2 yunaki'eriya mɨkanetsi'utikweririkɨ.   
\c 67  
\d Teyuitɨwamete wa'ukiyari. Kanaritsie xekeneutikwikani. Nɨawari. Kwikari.  
\q1
\v 1 Kakaɨyari ketatsinenimayaka meta 'aixɨa ketatsiyurieka.  
\q2 Kakaɨyari tahetsie matsiɨkɨme ke'ayuyeitɨaka,   
\q1
\v 2 'ena kwiepa huyeya mɨxeiyariekakɨ,  
\q2 meta yunaitɨ nuiwarite meke'imaika wikweitsitɨarikaya.   
\b  
\q1
\v 3 Kakaɨyari 'aku, teɨteri mekemetsitemawieritɨaka,  
\q2 yunaitɨ teɨteri kwiepa memɨtama mekemetsinɨawani.   
\b  
\q1
\v 4 Xekeneyutemamawieka nuiwarite meta xekeneutikwikani yutemawierima,  
\q2 'ekɨ wahetsɨa pemɨti'aitakɨ heitseriemekɨ,  
\q2 nuiwarite kwiepa memɨtama pepɨwaruwitɨxime.   
\b  
\q1
\v 5 Kakaɨyari 'aku, teɨteri mekemetsitemawieritɨaka,  
\q2 yunaitɨ teɨteri kwiepa memɨtama mekemetsinɨawani.   
\b  
\q1
\v 6 Hikɨ kwie yu'ikwaxi pɨtixuawitɨani,  
\q2 Kakaɨyari 'aixɨa pɨtiyurieka, mɨtakakaɨyari.   
\q1
\v 7 Kakaɨyari 'aixɨa pɨtatsiyurieni,  
\q2 mepitimakani yunaitɨ naitsarie kwiepa memɨtama.   
\c 68  
\d Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya. Kwikari.  
\q1
\v 1 Kakaɨyari 'akeneutakexi,  
\q2 memɨmetsi'aye'unie mekeheutaweiyariexɨani,  
\q2 meke'uyuta'una kemɨ'ane memi'uxie.   
\q1
\v 2 Yunaitɨ meke'ukumawere,  
\q2 kɨtsi 'ekatsie mɨtiupaparike hepaɨ,  
\q1 Kakaɨyari memɨka'ayexeiya Kakaɨyari hɨxie meke'ukumawere,  
\q2 xɨrɨka taipa kemɨtiutakwanike hepaɨ.   
\q1
\v 3 Matsi heitserie memexeiya mekeyutemamawieka pɨta,  
\q2 Kakaɨyari hɨxie meke'utikwikani yemekɨ.   
\b  
\q1
\v 4 Kakaɨyari xekenenɨawani, kemɨtiuka'iyari nɨawariyari,  
\q2 xekenehiwieka kemɨ'ane haiwitɨritsie 'akaitɨ mukuyeika,  
\q1 hɨxiena xekeneyutemamawieka.  
\q2 Yawé katinitewaka.   
\q1
\v 5 Nutuite wa'ukiyari, wiuraxi wahetsie nunuwame  
\q2 Kakaɨyari kanihɨkɨtɨni yutuki mupatsieta 'ayekaitɨ.   
\q1
\v 6 Kakaɨyari kii puwaxatɨa kemɨ'ane memexɨriya  
\q2 meta pɨwaxɨna kemɨ'ane memehapanie,  
\q2 kemɨ'ane memɨtehayuye'unie makuwakitsie mepuyuhayewa.   
\b  
\q1
\v 7 Kakaɨyari 'aku, kepauka pemayetɨa 'ateɨterima wahɨxie,  
\q2 kepauka makumawetsie pemɨwarayewitɨtɨya,   
\q1
\v 8 kwie kaniutayuani,  
\q2 meta muyuawitsie waɨkawa wiyeri kanakaneni,  
\q1 Kakaɨyari hɨxie, Tsinahi mieme Kakaɨyari.  
\q2 Kakaɨyari hɨxie, 'ixaheritsixi wakakaɨyari.   
\q1
\v 9 Kakaɨyari 'aku, 'ekɨ waɨkawa wiyeri pepeyenɨ'a,  
\q2 'aixɨa pepiyuri kwie tahetsiemieme.   
\q1
\v 10 'Atɨɨriyama kwiepa mepɨtamarixɨ,  
\q2 Kakaɨyari 'aku, petiu'akanaki'erietɨ 'aixɨa pepɨtiuyuri tixaɨtɨ mɨkarexeiya hetsiemieme.   
\b  
\q1
\v 11 Tati'aitɨwame yuniuki kaniyetuani,  
\q2 yumɨiretɨ hikɨ 'ukari mepikuxata:   
\q1
\v 12 «Mekaniuyu'unarɨmeni te'aitamete meta wakuyaxima,  
\q2 kiita memɨteheku'eiri,  
\q2 'ukarawetsixi piinite mekateniyutapitɨwani:   
\q1
\v 13 kukuru 'anateya pɨrata mɨkawiriyarietɨka,  
\q2 'anɨteya huru mɨxawawatɨ pɨhɨkɨ.  
\q2 'Ekɨ pepeuku muxatsi watsata».   
\q1
\v 14 Kepauka Naimekɨmɨtɨrɨkaɨye te'aitamete kwiepa  
\q2 memɨtama mɨwarutawei,  
\q1 'ɨwi hepaɨ mepɨteyuxexeyakai  
\q2 kemɨtika'unike hepaɨ Tsarimuni hɨriyaritsie.   
\b  
\q1
\v 15 Watsani hɨriyari, hɨri mɨmamariwawe,  
\q2 Watsani hɨriyari, hɨri kwinimieme mutɨtɨ:   
\q1
\v 16 ¿Titayari hɨri kwinimieme mɨtɨtɨ kwi mete'ixexeiya me'ɨtetsatɨ,  
\q2 mɨkɨ hɨri Kakaɨyari minake mana muyeikanikɨ,  
\q2 hakewa Yawé yuheyemekɨ meyeikani?   
\q1
\v 17 Kaxetate kuyaxa mieme Kakaɨyari tipiinieya  
\q2 xeimiriyaritsixi mekaniyu'inɨatani,  
\q1 Tsinahi paitɨ yeyaka Ti'aitame wahamatɨa kaninuani  
\q2 yutukita meutahanikɨ.   
\q1
\v 18 Yawé Kakaɨyari, kepauka 'ekɨ pemanutitɨa taheima,  
\q2 pepɨwarewitɨ memanutaxɨriya,  
\q1 waɨkawa 'imikieri pepɨrepi teɨteri memɨmeteyetuiri,  
\q2 metatsiere memayu'eririya tiwapiini,  
\q2 mana wahamatɨa pemeyutakiitɨanikɨ.   
\b  
\q1
\v 19 'Aixɨa ketikuxaxatsiwani Tati'aitɨwame, takakaɨyari meta tatsiwikweitsitɨwame,  
\q2 tukari manukayeika ta'ikakɨ pɨtatsiparewie.   
\q1
\v 20 Takakaɨyari, Kakaɨyari tiyuwikweitsitɨwame pɨhɨkɨ,  
\q2 Yawé Tati'aitɨwame pɨkatatsipitɨa temɨkwinikɨ.   
\b  
\q1
\v 21 Kakaɨyari kemɨ'ane memaye'unie mɨkɨ wamu'u pɨtipɨna,  
\q2 wakɨpate witsimɨ'anene 'axameteyurietɨ memu'uwa.   
\q1
\v 22 Ti'aitame mɨpaɨ kanaineni:  
\q2 «Watsani nekanixe'akunuitɨamɨkɨ,  
\q2 haramara meukatewatsie nepɨxehatiwitɨni,   
\q1
\v 23 memɨxe'aye'unie waxuriya xe'ɨkatetsie  
\q2 ke'utiwiriere,  
\q1 mɨkɨta tsɨikɨri me'itsename  
\q2 yuhetsie timieme memɨtehexeiyanikɨ».   
\q1
\v 24 Tukita mepuyuhekɨa  
\q2 xuruku me'utɨ memetsi'ayexeiyatɨ tati'aitɨwame.   
\q1
\v 25 Kwikamete mepanuyetei,  
\q2 wa'ɨtɨma teyuitɨwamete,  
\q2 wahamatɨa 'ukari memɨte'utikatse.   
\q1
\v 26 'Aixɨa xeketenehekɨatani Kakaɨyari xeɨripa,  
\q2 Yawé xekenenɨawani, 'Ixaheri nuiwarimama.   
\q1
\v 27 Kaniwaruwitɨximeni temaikɨ nuiwari Wenikamini,  
\q2 wa'utɨmata yumɨiretɨ te'aitamete Kura nuiwariyaritsie miemete  
\q2 metatsiere te'aitamete Tsawuruni meta Nepɨtahari kiekatari.   
\b  
\q1
\v 28 Kakaɨyari 'aku, 'atɨrɨkariya kenanakanɨ'a,  
\q2 Kakaɨyari 'aku, keneuhekɨata 'atɨrɨkariya,  
\q2 tahetsiemieme 'aixɨa pemɨtiuyurikɨ.   
\q1
\v 29 'Atuki Kerutsareme muwekɨ  
\q2 te'aitamete mepɨmetemini 'aixɨa mɨti'ane.   
\q1
\v 30 Keneutati'a mɨkɨ tupiriyatsata muwe mariwetɨ 'axati'anetɨ,  
\q2 mɨkɨ memayu'eririya tuurutsixi  
\q2 nuiwarite watsata tsikerutsixi wahepaɨ memɨteyuxexeiya.  
\q1 Yaketineuyuri pɨrata tepɨayari mɨmetsiyetuirienikɨ 'utatsuatɨ,  
\q2 nuiwarite keniwarutaweiya 'axamemɨte'u'iyari.   
\q1
\v 31 'Ekipitu pɨwaranɨ'ani yuhetsɨa miemete,  
\q2 Kutsi Kakaɨyari hetsɨa punuani mɨkɨ ti'aitɨwame mayanikɨ.   
\b  
\q1
\v 32 Kwiepa te'aitamete 'aku, Kakaɨyari xekeneutakwikani,  
\q2 nɨawari ti'aitame hetsiemieme xekeneutikwikani,   
\q1
\v 33 kemɨ'ane haiwitɨritsie 'akaitɨ mukuyeika,  
\q2 muyuawi meripaitɨ mieme hetsie,  
\q1 niukieya mɨ'enieriekakɨ yamɨtiyuriene,  
\q2 niukieya mutatɨrarɨka.   
\q1
\v 34 Xekenemaika Kakaɨyari tɨrɨkariyaya,  
\q2 katini'aitani 'ixaheritsixi wahetsie,  
\q2 tɨrɨkariyaya meutitewatsie kanixuaweni.   
\q1
\v 35 Kakaɨyari 'aku, 'atukita pepɨmariwe,  
\q2 'ixaheritsixi wakakaɨyari tɨrɨkari pɨtiyupitɨwa, yuteɨterima tɨrɨkariya pɨwapitɨa.  
\b  
\q1 Kakaɨyari 'aixɨa ketikuxaxatsiwani.   
\c 69  
\d Teyuitɨwamete wa'ukiyari. «Tuturi» kwikariyari xekeneuweiyani. Rawiri nɨawarieya.  
\q1
\v 1 Nekakaɨyari, keneneutawikweitsitɨa,  
\q2 nekɨipitɨa paitɨri haa puku'axe.   
\q1
\v 2 Nepɨkayunirɨme putsu meukatewata,  
\q2 titatsie nerakeni pumawe.  
\q1 'Amutiyewatsie hixɨapa nepuyewie,  
\q2 haa muhane pɨnetsi'uhautsitɨaxime.   
\q1
\v 3 Nepu'uxeri parewiya neha'iwawatɨ,  
\q2 nekɨipitsie nepanatiwakiri.  
\q1 Nehɨxite pu'u'uxeri,  
\q2 Kakaɨyari parewiyaya netakwewietɨ.   
\q1
\v 4 Nekɨpate kemɨpaɨme reuyeta  
\q2 mepɨyupaɨme memɨnetsixani'erie yakɨxeikɨa,  
\q1 mepuyumɨire memɨnetsi'aye'unie 'itarikakɨ  
\q2 memɨnetsimieku.  
\q2 ¿Titakuta netiyetuani nemɨkatiunawa?   
\q1
\v 5 Kakaɨyari 'aku, 'ekɨ pepɨtimate nemɨkayukɨhɨawekɨ,  
\q2 ke'axanemɨtiuyuri nemɨtiuti'awieta nepɨkayɨwe.   
\q1
\v 6 Yawé Tati'aitɨwame, Naimekɨmɨtɨrɨkaɨye,  
\q2 mepɨkatewinɨarieka ne 'axanemɨtiuyurikɨ  
\q2 memɨmetsitakwewie,  
\q1 'Ixaheri Kakaɨyarieya 'aku,  
\q2 mepɨkaha'iwarieka nehetsiemieme  
\q2 kemɨ'ane memɨmetsikuwautɨwe.   
\q1
\v 7 'Ahetsiemieme nepɨtiuka'eniwa ne'utatieriwatɨ,  
\q2 nehɨxie nepayenɨtsa tewiyarikɨ.   
\q1
\v 8 Ne'iwama wahetsiemieme nemɨkamatiwani hepaɨ nekani'aneneni,  
\q2 'ateewa kiekame nekanihɨkɨtɨni nemaama niwemama wahetsiemieme.   
\q1
\v 9 'Akii nemukweriekɨ netaɨta nepɨtaxɨtsitɨariexime,  
\q2 nehetsie xeikɨa katininakeni  
\q2 memɨmetsi'aye'unie watierika.   
\q1
\v 10 Kepauka nemutatsuakatsie meta kepauka nemɨnehakietsie,  
\q2 nekatininewiekamɨkɨ kememɨnetehahɨaweni,   
\q1
\v 11 kepauka hiwerika kamixayari nemanakatɨkɨtsie,  
\q2 'atsieriwame nekanihɨkɨtɨni.   
\q1
\v 12 Kitenie memutayaxike nehepaɨtsita niuki mekanixɨatɨaka,  
\q2 memɨtarɨwe 'axa'anemekɨ mekaneniutakwikani.   
\q1
\v 13 Peru Yawé, neuxei nepumetiwawirie  
\q2 hikɨ 'ekɨ mɨpaɨ mumetinakekɨ.  
\q1 Kakaɨyari 'aku, 'anaki'eriya mɨmariwekɨ, keneneuta'eiya,  
\q2 'aixɨa pemɨtikamiekɨ, keneneutawikweitsitɨa.   
\q1
\v 14 Kenenewatihani muyehaxuyatsie,  
\q2 nemɨkayunekɨ pepɨkanetsipitɨaka.  
\q1 Keneneɨxɨna memɨnetsixani'erie wahetsie,  
\q2 hata 'ameukatewatsie.   
\q1
\v 15 Pepɨkanetsipitɨaka haa mɨnetsihehautsitɨwanikɨ,  
\q2 muwatixawa 'emeukatewa mɨnetsiheukakwa'anikɨ pepɨkanetsipitɨaka,  
\q2 meta teukiya neheima muwiwikenikɨ.   
\q1
\v 16 Yawé, keneneta'eiya 'aixɨa pemɨtiuka'iyari naki'eriya pemexeiyakɨ,  
\q2 yemekɨ pemɨti'akanenimayakɨ, nehetsɨa kenenua.   
\q1
\v 17 'Ikɨ meti'uximayatsiriwame pexeiyatɨ pepɨkatikuhayeikawani,  
\q2 yapauka keneneta'eiya, nepɨtiuka'eniwa.   
\q1
\v 18 'Ahurawa kenayaka, keneneutawikweitsitɨa,  
\q2 keneneɨxɨna memɨnetsi'aye'unie watsata.   
\q1
\v 19 'Ekɨ pepɨtimate kememɨnete'ute'a,  
\q2 nenetewiyame mepɨnetsi'ayeitɨwa,  
\q2 pepɨtimate kemɨ'ane memɨnetsi'aye'unie.   
\q1
\v 20 Watierika ne'iyari kaniutatsana,  
\q2 nehetsiemiemeri xɨari pɨkayɨwe 'aixɨa mɨtiyɨni.  
\q1 Nenimayatsika neputiwau, nepɨka'ikaxei,  
\q2 nɨtɨarika neputiwau, nepɨka'itaxei.   
\q1
\v 21 Ne'ikwaitsie matsiwi mepɨkaye,  
\q2 neheuharimɨkɨkaku matsina mepɨnetsi'uharitɨa.   
\q1
\v 22 Wawiniyari kehayani wa'ixɨarari,  
\q2 memɨte'ukaxexeiya wawiniyari kehayani.   
\q1
\v 23 Wahɨxite ke'utiture, memɨkaheunenierenikɨ,  
\q2 watɨrɨkariya ke'uxɨni yuheyemekɨ.   
\q1
\v 24 'Ahaxɨa wahetsie keneukawiwi,  
\q2 'ahaxɨa kewaranuku'axe.   
\q1
\v 25 Makumawe ke'ayani memakutei,  
\q2 waxamaru ke'uxaxawani.   
\q1
\v 26 Yemetsɨ kemɨ'ane pemɨ'uximatɨani kaniuweiyarieka,  
\q2 kemɨ'ane pemɨtikwinitɨani kaninanaimarieka mɨtiuka'eniwakɨ.   
\q1
\v 27 'Axakemɨtiyuriene keneutinɨitɨa waɨkawa 'axamɨti'ane,  
\q2 'awikweitsitɨarikatsie pepɨkawaraye'uitɨaka.   
\q1
\v 28 Meke'ayeyeitɨarieni tukari xapayaritsie,  
\q2 heitserie memexeiya wahamatɨa mepɨka'aye'uka.   
\q1
\v 29 Kakaɨyari 'aku, ne tixaɨtɨ nemɨkarexeiya meta nemɨtiuka'eniwa,  
\q2 'awikweitsitɨarika nehetsie kenuaka.   
\q1
\v 30 Kwikarikɨ nepinɨawani Kakaɨyari kemɨtitewa,  
\q2 pamɨpariyutsikɨ 'aixɨa nepɨrehɨaweni.   
\q1
\v 31 Mɨkɨ mawari matsi Yawé pinakire  
\q2 keyuri tuuru yatɨni tsikeru  
\q2 ha'awatɨ meta 'anuketatɨ.   
\q1
\v 32 Tixaɨtɨ memɨkatehexeiya mɨkɨ metexeiyame mepuyutemamawieka,  
\q2 xeme xekeneyuwaɨriyani, Kakaɨyari xemukuwautɨwe.   
\q1
\v 33 Karikɨ Yawé kaniwa'enieka kemɨ'ane memɨteheuyehɨwa,  
\q2 meta yuteɨterima memehapanie pɨkawarexɨrɨwa.   
\q1
\v 34 Meke'inɨawani muyuawi meta kwie,  
\q2 haramara meta yunaitɨ mana memɨteye'uwa,   
\q1
\v 35 Kakaɨyari Tsiyuni kanitawikweitsitɨamɨkɨ,  
\q2 meta Kura kiekariyari kananukuketɨamɨkɨ.  
\q1 Mana mekanikumarikuni teɨterimama  
\q2 kwie wahetsiemieme kanayeimɨkɨ.   
\q1
\v 36 Wahetsiemieme katinayeimɨkɨ te'uximayatame waniwema,  
\q2 Ti'aitame memɨnaki'erie mana mekanitiyaxikuni.   
\c 70  
\r (Nɨa 70:1-5 – Nɨa 40:13-17)  
\d Teyuitɨwamete wa'ukiyari. Rawiri 'iwaurikaya.  
\q1
\v 1 Kakaɨyari 'aku, xeiya keneneutawikweitsitɨa,  
\q2 Yawé, xeiya keneyumexɨitɨatɨ keneneuparewi.   
\q1
\v 2 Kemɨ'ane memɨnetsimieku  
\q2 mekeheuyuyexɨrieni meha'iwarieme.  
\q1 Mekeyutewiyatsitɨani mekete'uhayewa 'atsimekateyurieme,  
\q2 yunaitɨ kemɨ'ane memɨnetsika'unaku.   
\q1
\v 3 Yu'utɨma mekehekɨne, meyutetewiyatɨ,  
\q2 yunaitɨ kemɨ'ane haweri memɨnetsiyurie.   
\q1
\v 4 Matsi kemɨ'ane memɨmetsikuwautɨwe  
\q2 'ahetsie mekeyutemawieka, yemekɨ,  
\q1 kemɨ'ane 'awikweitsitɨarika memɨnaki'erie mɨpaɨ meke'utiyuaneni:  
\q2 «Kakaɨyari kanimariweni».   
\b  
\q1
\v 5 Ne tixaɨtɨ nepɨkarexeiya yemekɨ nepɨreuyehɨwa,  
\q2 Kakaɨyari 'aku, xeiya kenaye'a.  
\q1 'Ekɨ netsiparewiwame pepɨhɨkɨ, netsixɨname,  
\q2 Yawé, 'apepɨkareutewini.   
\c 71  
\r (Nɨa 71:1-3 – Nɨa 31:1-4)  
\q1
\v 1 Yawé, ne 'ahetsɨa nepɨne'awieta,  
\q2 nemɨtewinɨarieka pepɨkanetsipitɨaka.   
\q1
\v 2 Heitserie pemɨtiyurienekɨ, nehetsie keneutanua keneneɨxɨna,  
\q2 keneneu'eni, keneneutawikweitsitɨa.   
\q1
\v 3 'Ekɨ kenehɨkɨtɨni neterɨ muwa nemuyuti'awiwieta,  
\q2 muwa xeikɨa yuheyemekɨ nemeta'axeni kenehɨkɨtɨni,  
\q1 ketineuta'aita nemɨtawikweitsitɨarienikɨ,  
\q2 'ekɨ 'ai nehetsie nunuwame pemɨhɨkɨkɨ.   
\q1
\v 4 Nekakaɨyari, keneneɨxɨna, 'axateyuruwamete memɨnetsiwiyakɨ,  
\q2 'axateyuruwamete meta memɨteyukananaima watɨrɨkariyatsie.   
\b  
\q1
\v 5 Yawé, 'ekɨ Ti'aitame, nepɨmetsitakwewie,  
\q2 temaikɨyari paitɨtɨ 'ahetsie nepɨtiwiya.   
\q1
\v 6 'Ahetsie xeikɨa nepɨtiwiya nemutinuiwaxɨtsie paitɨtɨ,  
\q2 'ukaratsitsie pepɨnetsiyenuiwitɨa.  
\q2 Yuheyemekɨ nepɨmetsinɨawani.   
\q1
\v 7 Yuwaɨkawame wahepaɨtsita, 'inɨari nepɨhɨkɨ,  
\q2 matsi 'ekɨ nehetsie nunuwame pepɨhɨkɨ pemɨkawatayuane.   
\q1
\v 8 Ne nepɨmetsinɨawa yemekɨ waɨkawa,  
\q2 tukarikɨ kepemɨtimariwekɨ nepɨtikuxata.   
\b  
\q1
\v 9 Kepauka 'ukiratsi nemayani pepɨkanetsihehɨpani,  
\q2 kepauka nemɨkayɨweni pepɨkanetsi'uku'e'eiriwani.   
\q1
\v 10 Metsɨ memɨnetsi'aye'unie nehepaɨtsita mieme mekatenikuxatani,  
\q2 kemɨ'ane memɨnetsihupie mekanenikuxatani.   
\q1
\v 11 Mɨpaɨ mekaniutiyuaneni: «Kakaɨyari kaniku'eirieni.  
\q2 Xekenanukuweiya xekenewiya, xewitɨ hetsiena pɨkahetanuani».   
\q1
\v 12 Nekakaɨyari, pepɨkanetsi'uku'e'eiriwani,  
\q2 Nekakaɨyari, xeiya kenaye'a pemɨnetsiparewienikɨ.   
\q1
\v 13 Nehetsie memɨte'ahɨpa tixaɨtɨ mekatehɨkɨtɨtɨ meke'ukwini,  
\q2 keniwarutewiyatsitɨa  
\q2 kemɨ'ane memɨnetsi'atihɨanikɨ memukuwaɨtɨwe.   
\b  
\q1
\v 14 Netsietɨ nemenitakwewieka,  
\q2 matsi waɨkawa nemeninɨawani waɨkawa nekaniyutemawieka.   
\q1
\v 15 Tukarikɨ nepikuxatani  
\q2 ke'aixɨa pemɨtiyuriene meta 'awikweitsitɨarika,  
\q2 tsepanetɨ yemekɨ naime nemɨtitaxata nemɨkayɨwe.   
\q1
\v 16 Yawé Ti'aitame, nepitaxata 'a'uximayatsika mɨmamariwawe,  
\q2 nepaye'erieni heitserie kepemɨtiyuriene,  
\q2 heitserie xeikɨa kepemɨtiyuriene.   
\q1
\v 17 Kakaɨyari 'aku, 'ekɨ pepɨnetiuti'ɨkitɨa temaikɨyari paitɨ,  
\q2 hikɨ 'akuxi nepikuxata mariweme kepemɨtiyuriene.   
\q1
\v 18 Kepauka 'ukiratsi nemayani,  
\q2 kepauka nemumutuxakari,  
\q2 Kakaɨyari 'aku, pepɨkanetsi'uku'e'eiriwani,  
\q1 'umemahu 'atɨrɨkariya newataxatɨayuke,  
\q2 memɨkatinunuiwawawe 'akuxi  
\q1 kepemɨtiuyuri newataxatɨayuke.   
\b  
\q1
\v 19 Kakaɨyari 'aku, 'ekɨ mariweme pepɨtiuyuri,  
\q2 heitserie kepemɨtiyuriene meutitewatsie pɨye'axe.  
\q2 ¿Kakaɨyari 'aku, kemɨ'ane 'aku 'ahepaɨ pɨtiuka'iyari?   
\q1
\v 20 Waɨwaka 'uximatɨarikatsie pepɨnetsi'atiwitɨxime,  
\q2 matsi tawarita tukari pepɨnetsipitɨani,  
\q1 kwieta meukatewatsie paitɨ  
\q2 tawarita muwa pepɨnetsi'atihana.   
\q1
\v 21 Tawarita waɨkawa netɨrɨkaɨyeme pepɨnetsi'ayeitɨani  
\q2 'ana pepɨnetsinɨtɨani.   
\b  
\q1
\v 22 Nekakaɨyari, ke'aixɨa pemɨtikamiekɨ,  
\q2 nepɨmetsinɨawani kanaritsie,  
\q1 nepɨmetsinɨawani, 'ixaheritsixi wakakaɨyari mɨpatsie,  
\q2 xawerikɨ nepɨmetsinɨawani.   
\q1
\v 23 Kepauka nɨawari 'ahetsiemieme nemɨtikwika  
\q2 neputahiwani neyutemawietɨ,  
\q2 'ekɨtsɨ netukari pekaniutawikweitsitɨani.   
\q1
\v 24 Tukarikɨ yaxeikɨa nepɨtikuxatani  
\q2 keheitserie pemɨtiyuriene,  
\q1 karikɨ kemɨ'aneri memɨnetsika'unakukai  
\q2 mekaniutewiyatsitɨarieni mekaneuyuyexɨrieni.   
\c 72  
\d Tsarumuni nɨawarieya.  
\q1
\v 1 Kakaɨyari 'aku, heitserie hexeiyame kenayeitɨa 'ikɨ ti'aitame,  
\q2 meta heitserie kepemɨrexeiya ti'aitame nu'aya mɨpaɨ ketineupitɨa.   
\q1
\v 2 Mɨkɨ 'ateɨterima pɨwataheitseritɨani  
\q2 meta heitserie mehexeiyame pɨwarayeitɨani tixaɨtɨ memɨkateheuxeiya 'ahetsɨa miemete.   
\q1
\v 3 Hɨrite 'aixɨa pɨtiwayatsa 'ateɨterima,  
\q2 hɨri 'amanutitɨtɨ heitserie pɨwapitɨani.   
\q1
\v 4 Ti'aitame tixaɨtɨ memɨkateheuxeiya heitserie pɨwapitɨani  
\q2 meta yemekɨ memɨteheuyehɨwa pɨwatawikweitsitɨani,  
\q2 mɨkɨ pɨwatipɨna 'axamemɨte'u'iyari.   
\b  
\q1
\v 5 Ti'aitame ke'uyeikani keti'aitametɨni xeimiriyari nuiwariyaritsie,  
\q2 tau hepaɨ meta metsa.   
\q1
\v 6 'Etsaripa kemɨtiukawiwiye hepaɨ ke'aneni,  
\q2 wiyeri kwie mɨtiuhawiya hepaɨ ke'aneni.   
\q1
\v 7 'Uyeikakaku mɨtiheitserie keranayuhayewani,  
\q2 waɨkawa ketixuaweni tita memɨteheuyehɨwa,  
\q2 kepaukake metsa makayune.   
\b  
\q1
\v 8 Ti'aitame keti'aitani huta haramarayari tsata  
\q2 haa 'Epɨrata manuyeka 'atsita kwie hakewa meu'axe.   
\q1
\v 9 Hɨxiena meke'utihɨxima'uni makumawetsie nuiwarite memɨtitei,  
\q2 tumuanari meke'utikwani memeye'unie   
\q1
\v 10 Taritsi kwieyaritsie te'aitamete meketeyutuaka  
\q2 meta haramara tetsita 'anutaɨye  
\q1 te'aitamete mekete'i'atɨiriwani  
\q2 Tsawani meta Tsewa kiekatari.   
\q1
\v 11 Yunaitɨ te'aitamete hɨxiena meke'ukahɨxima'uni,  
\q2 yunaitɨ nuiwarite mekete'i'uximayatsirieka.   
\b  
\q1
\v 12 Mɨkɨ piparewieni kemɨ'ane parewiya ma'iwawani,  
\q2 meta tixaɨtɨ mɨkarexeiya pɨparewieni mɨkarekaparewiwame.   
\q1
\v 13 Pɨwatinenimayata tixaɨtɨ memɨkate'ayeitɨarie meta tixaɨtɨ memɨkatehexeiya,  
\q2 haweri memɨ'anene watukari pɨtawikweitsitɨani.   
\q1
\v 14 Pɨwaxɨna kememɨtenanaimarie,  
\q2 mɨtimatekɨ watukari meuyewetsekɨ.   
\b  
\q1
\v 15 Ti'aitame ke'uyeikani.  
\q2 Huru keyetuiriyarieni Tsawa mieme.  
\q1 Ketiyunenewitɨni hetsiena mieme yuheyemekɨ,  
\q2 'aixɨa ke'itɨarieka naime tukaritsie.   
\q1
\v 16 Naime kwieyaritsie tɨriku kexuaweni,  
\q2 hɨritsie paitɨ ke'uwetuarɨkani tɨriku.  
\q1 Riwanu hepaɨ 'uriyari ke'utipaɨmere,  
\q2 manukuyari tupiriya 'ɨtsita mieme hepaɨ ke'utipaɨmere.   
\b  
\q1
\v 17 Kekuxaxatsiwani yuheyemekɨ,  
\q2 tau hepaɨ kereutere ku'eriwatɨ.  
\q1 Hetsiena mieme nuiwarite 'aixɨa mekeyuyurieka,  
\q2 yunaitɨ mɨkɨ 'aixɨa mekete'ikɨhɨaweni.   
\b  
\q1
\v 18 Yawé Kakaɨyari 'aixɨa ketikɨhɨawarɨwani,  
\q2 'Ixaheri Kakaɨyarieya,  
\q2 muyuxewi xeikɨa mariweme mɨtiyuriene.   
\q1
\v 19 'Aixɨa keraniuwani hetsiena mieme yuheyemekɨ,  
\q2 kemɨtimariwe ke'utahekɨatsieni naitsarie.   
\b  
\qc 'Aixɨa pɨ'ane, 'aixɨa pɨ'ane.  
\b  
\q1
\v 20 Rawiri nenewierieya 'Itsahi nu'aya 'enapu'axe.   
\c 73  
\s1 XAPA 3  
\r Nɨawari 73-89  
\d 'Atsahapi nɨawarieya.  
\q1
\v 1 Yurikɨ, Kakaɨyari 'aixɨa pɨtiuka'iyari 'Ixaheri hetsɨa,  
\q2 'iyari 'aixɨa mɨ'anene memexeiya wahetsɨa.   
\q1
\v 2 Ne nekanatiwenitɨma,  
\q2 'etsiwatɨkaku nekanekaxikiuna.   
\q1
\v 3 Nepɨwarekahekatɨya newaruxeiyaka  
\q2 'axateyuruwamete mete'ukaxexeiyakaku.   
\b  
\q1
\v 4 Mɨkɨ nitixaɨtɨkɨ mepɨkate'ukakukuine,  
\q2 'aixɨa mepɨteheu'erie.   
\q1
\v 5 Hipatɨtɨma 'axamepɨkatewakumamateke,  
\q2 hipame wahepaɨ mepɨkate'uka'eniwa.   
\q1
\v 6 Kememɨteyuti'ɨre kuka memakatɨtɨkani hepaɨ mepɨteyuxexeiya  
\q2 kememɨtewananaima 'ixurikikɨ kememɨte'anuyuku'eima hepaɨ mepɨ'anene.   
\q1
\v 7 'Axamɨti'anekɨ mepɨhɨpɨne,  
\q2 matsi paitɨ mepɨmatsiɨkɨ ke'axamemɨteyuriku.   
\q1
\v 8 Mepɨteyukatawe'erie, 'ayehutamekɨ meputiniuka,  
\q2 meha'atɨ mepɨteyu'aitɨwa meta mepɨteyute'a.   
\q1
\v 9 Yuniukikɨ muyuawi hepaɨtsita 'axamepɨtiyuane,  
\q2 yuniukikɨ kwiepa mepɨte'aita.   
\q1
\v 10 'Ayumieme wahetsɨa mepeta'axe teɨteri,  
\q2 yuri mepɨtewa'eririe kememutiyuane.   
\q1
\v 11 'Atsita mɨpaɨ mekaniutiyuani: «¿Kekuta Kakaɨyari retimani?  
\q2 ¿Kamɨtsɨ 'Amutewi timaiwe?»   
\b  
\q1
\v 12 Mɨpaɨ mekani'aneni Kakaɨyari memɨka'ayexeiya,  
\q2 tixaɨtɨkɨ mekateyu'iyaritɨatɨ, matsi waɨkawa metehexeiyatɨ mepakɨka.   
\b  
\q1
\v 13 Yurikɨ, ¿tita tiyunaki'erie  
\q2 ne'iyari 'itiyakame nemayeitɨakakɨ,  
\q2 meta nemamate 'atsimɨkatiyuruwanikɨ,   
\q1
\v 14 tukarikɨ netiweiwatɨ,  
\q2 meta ximeri netiuka'enitsitɨariwatɨ?   
\b  
\q1
\v 15 Xɨka mɨpaɨ ne'utayɨnike: «Wahepaɨ nepɨtiuniukani»,  
\q2 'anuiwarima nepuwakwamanakekai.   
\q1
\v 16 Kepauka nemɨtimaimɨkɨkai naime,  
\q2 'ika nepukaxei neka'iwerime,   
\q1
\v 17 Kakaɨyari tukieyata neheutahakake,  
\q2 muwa nepɨretima 'axateyuruwamete hakewa memeyehu:   
\q1
\v 18 Yurikɨ, 'ekɨ huye mɨxikiunitsie pepɨwara'uitɨa,  
\q2 pepɨwaranataima memukumawerekɨ.   
\q1
\v 19 Yapauka mepeuyehɨiyani,  
\q2 yemekɨ memariutsietɨ.   
\q1
\v 20 Xewitɨ tiheinɨtɨ manutaniere hepaɨ,  
\q2 mɨpaɨ, kepauka Ti'aitame pemanukukeni,  
\q2 mɨkɨ pepuwaratɨmaiyatsitɨani ke'axamemɨteyumate.   
\b  
\q1
\v 21 Ne'iyari puyuhiweriekai  
\q2 nepɨkanewaɨriyakai,   
\q1
\v 22 'atsinekatimaitɨ.  
\q2 Yeutanaka hepaɨ nepuyɨ 'ahepaɨtsita.   
\q1
\v 23 Ne matsi yuheyemekɨ 'ahamatɨa nepuyeika,  
\q2 'ekɨtsɨ 'atseriekɨ pekaneniwiyani.   
\q1
\v 24 'A'ɨxatsikɨ pepɨnetsi'uwitɨxime,  
\q2 'arike matsi witsi'aneme pepɨnetsi'ayeitɨani.   
\q1
\v 25 ¿Kemɨ'ane 'aku muyuawitsie nepexeiya metsɨ 'ekɨ xeikɨa?  
\q2 Xɨka 'ahamatɨa ne'uyeikani, kwiepa timiemeri nepɨkareuyehɨwa.   
\q1
\v 26 Tsepa newaiyari mɨtimɨxime meta ne'iyari,  
\q2 matsi Kakaɨyari ne'iyari pɨtseiriyani,  
\q2 mɨkɨ nehetsiemieme xeikɨa kanihɨkɨtɨni yuheyemekɨ.   
\b  
\q1
\v 27 Mepɨkwini kemɨ'ane memɨmetsi'uku'eiri,  
\q2 'ekɨ pepɨwaka'una 'ahetsie memɨkatewiya.   
\q1
\v 28 Matsi 'aixɨa pɨ'ane Kakaɨyari hamatɨa nemuyeikani 'ahurawa.  
\q2 Yawé Ti'aitame nehetsie nunuwame  
\q2 nepayeitɨa, naime wewiyaya nemɨtikuxatanikɨ.   
\c 74  
\d 'Atsahapi kwikarieya.  
\q1
\v 1 Kakaɨyari 'aku, ¿titayari  
\q2 petatiuku'eiri yuheyemekɨ?  
\q1 ¿Titayari waɨkawa petiuyeha'a  
\q2 'amuxatsima wahepaɨtsita?   
\q1
\v 2 Keniwaraye'eri teɨteri  
\q2 pemɨwaranayexei meripaitɨ,  
\q1 nuiwari pemuwarɨxɨnaxɨ  
\q2 'ahetsɨa memumiemetetɨnikɨ.  
\q1 Kenaye'eri 'ikɨ Tsiyuni hɨriyari,  
\q2 hikɨ pemanukatsie.   
\q1
\v 3 Kenaye'a yuheyemekɨ mɨti'u'uni hepa,  
\q2 tuki naime kaniuka'una mɨtatsi'aye'unie.   
\q1
\v 4 Memɨmetsi'aye'unie 'axeɨripa mekaniuyuhaxɨatɨatɨkɨkani,  
\q2 patera mekanika'uitɨwani kename metehayu'iwa.   
\q1
\v 5 Kɨ'ewemete wahepaɨ yeuta mekateniyuxexeiyani,  
\q2 hatsakɨ kɨyexi mehawiteketɨ.   
\q1
\v 6 Hatsakɨ meta titsunamekɨ  
\q2 mekanitimuraxɨani kɨyexite ti'utɨarietɨkaime.   
\q1
\v 7 'Atuki mekaniutataiya,  
\q2 pemuwayeka kapatsiekame mekanayeitɨani.   
\q1
\v 8 Yu'iyaritsie mɨpaɨ mekaniutiyuani: «Naxi tekaneyeitɨakuni».  
\q2 Tinaime mekateniutitaiya hakewa makupatsietɨkateitsie mana kwiepa.   
\q1
\v 9 Tepɨka'ixeiyari tapatera 'ateewa 'uyewiekame,  
\q2 Kakaɨyari niukameyari pumawe,  
\q1 'etsiwa tɨma tepɨkatemate  
\q2 kemɨreutere mɨpaɨ tiyɨanetɨ.   
\b  
\q1
\v 10 Kakaɨyari 'aku, ¿Kepaukake mepɨtehayewa memɨtatsi'aye'unie metatsinanaimatɨ?  
\q2 ¿Yuheyemekɨ 'axame'utiyuatɨ 'ahepaɨtsita?   
\q1
\v 11 ¿Titayari kayuwatɨ petiuma pemɨkayɨweni hepaɨ?  
\q2 ¿Titayari 'atapa perawie?   
\b  
\q1
\v 12 Kakaɨyari 'aku, 'ekɨ neti'aitɨwame pepɨhɨkɨ meripaitɨtɨ,  
\q2 'ena kwiepa 'ekɨ wikweitsitɨarika pepexeiya.   
\q1
\v 13 'Ekɨ haramara pepukumanaxɨa 'atɨrɨkariyakɨ,  
\q2 haramaratsie memɨteye'uwa memɨmamariwawe wamu'ute peputitaraxɨ.   
\q1
\v 14 'Ekɨ Rewiyatahini mu'uya peputataraxɨ,  
\q2 pepɨwarumi makumawetsie memɨte'u'uwa.   
\q1
\v 15 'Ekɨ pepɨtiuyuri haixa pemanetɨaxɨa meta hatɨa,  
\q2 haa manuyehapane waɨkawa pepikawatsiɨxaxɨ.   
\q1
\v 16 Pɨti'apiini tukari, meta tɨkari,  
\q2 'ekɨ metsa mana pepuyeye meta tau,   
\q1
\v 17 kwie hakewa meuye'atɨkani 'ekɨ pepi'inɨaritɨa,  
\q2 witarita meta xexerixa pepayeitɨwa.   
\b  
\q1
\v 18 Yawé, kena'eriwani mɨmetsi'aye'unie payu'ɨre,  
\q2 teɨteri yuri memɨkate'erie 'ahetsiemieme 'axamepaitɨka.   
\q1
\v 19 Memayu'eririya wahetsiemieme  
\q2 'akukuru mɨtakwaiyanikɨ pepɨka'iyetuayani,  
\q1 pepɨkawaratɨtɨmaiyani, hikɨ nihatsuaku,  
\q2 tixaɨtɨ memɨkatehexeiya watukari.   
\q1
\v 20 Kena'eriwani 'atɨratu,  
\q2 naitsarie 'ikɨ kwieyaritsie  
\q2 nanaimarika xeikɨa kanixuaweni.   
\q1
\v 21 Haweri mɨranuyemie pepɨkapitɨaka mɨnanaimarieka,  
\q2 kemetsinɨawani kemɨ'ane mɨreuyehɨwa meta tixaɨtɨ mɨkarexeiya.   
\b  
\q1
\v 22 Kakaɨyari 'aku, xeiya tahetsie keneutanua,  
\q2 kena'eriwani tukarikɨ 'axakememutiyuane 'ahepaɨtsita memɨka'u'iyari.   
\q1
\v 23 Keneu'eni memɨmetsi'aye'unie wahiwari,  
\q2 kememutiyuane mekatehayewatɨ.   
\c 75  
\d Teyuitɨwamete wa'ukiyari. Yuariyaya xekeneuweiyani «Pepɨka'ika'unani». 'Atsahapi nɨawarieya. Kwikari.  
\q1
\v 1 Kakaɨyari 'aku, pamɨpariyutsi tepɨmetsipitɨa,  
\q2 'aixɨa 'anemekɨ tepɨmetsihahɨawe,  
\q2 yunaitɨ naitsarie 'a'uximayatsika mɨmamariwawe mepukuxata.   
\b  
\q1
\v 2 'Ekɨ mɨpaɨ pepaine: «Kepauka ne yanemɨra'eriwani,  
\q2 'aixɨa mɨ'anekɨ nepɨwaranutaxɨrieni.   
\q1
\v 3 Kepauka kwie mutayuane  
\q2 meta teɨterimama yunaitɨ,  
\q2 ne nekanihɨkɨtɨni 'aixɨa nemikuyuruwa».   
\b  
\q1
\v 4 «Xepɨka'uyuti'ɨreni», mɨpaɨ nekatiniwarahɨaweni memuyuti'ɨre.  
\q2 «Temaiwawemete xepɨka'ayuyeitɨaka», Kakaɨyari memɨka'ayexeiya nekatiniwarahɨaweni.   
\q1
\v 5 «Temaiwawemete xepɨkayu'erieka muyuawitsie miemekɨ,  
\q2 xepɨka'utiniukani witsi'anemekɨ».   
\b  
\q1
\v 6 Tewi mariwetɨ mayeitɨariwanikɨ tau manatineika pɨkamieme,  
\q2 meta makayuyuipiketsie tatsutua,   
\q1
\v 7 matsi Kakaɨyari pɨhɨkɨ 'itsɨkame:  
\q2 hipame pɨwahiweritɨa, hipameta 'aixɨa pɨwayurie.   
\q1
\v 8 Yawé mamayatsie tekɨxi kanaweni winu mukwaimuxa,  
\q2 haxɨaya kanihɨkɨni 'uyematɨ meta tiyutsata tinɨtɨ,  
\q1 kepauka mɨkɨ mitiyeurieni,  
\q2 yunaitɨ kwiepa memɨtama Kakaɨyari memɨka'ayexeiya  
\q2 mekaniti'ikuni kepaukake memiyexɨni.   
\q1
\v 9 Ne 'ikɨ hepaɨtsita nepɨtikuxatani yuheyemekɨ,  
\q2 nepinɨawani Kakuwu Kakaɨyarieya.   
\q1
\v 10 Kwinimieme memɨteyuti'ɨre Kakaɨyari meka'ayexeiyatɨ pekaniwarakumaweriyamɨkɨ,  
\q2 meta heitserie memexeiya watɨrɨkariya hetsiemieme 'aixɨa nekanitayɨmɨkɨ.   
\c 76  
\d Teyuitɨwamete wa'ukiyari. Kanaritsie xekeneutikwikani. 'Atsahapi nɨawarieya. Kwikari.  
\q1
\v 1 Kakaɨyari pɨmatiwa Kura kwieyaritsie,  
\q2 'Ixaheri kwieyaritsie mariwemekɨ pumatiwa.   
\q1
\v 2 Tsareme mɨrakutewatsie tukieya puwe,  
\q2 Tsiyuni pɨkiekariena.   
\q1
\v 3 Mana pitimuraxɨ 'ɨrɨ 'aixɨa mɨ'anene,  
\q2 kuya kɨmana muyukunarɨma, 'ixiparate, naime kuyaxa timieme.   
\b  
\q1
\v 4 Witsipepɨ'ane,  
\q2 'ekɨ matsi pepɨmariwe keyuri hɨri yuheyemekɨ mieme.   
\q1
\v 5 Memɨtehayu'iwa hikɨ mepatixɨriwa,  
\q2 teukiyapa mepeukaxɨriwa.  
\q1 Nixewitɨ mɨkɨ teɨteri yukukuyamete  
\q2 yumamate pɨka'anukuhapani mɨwaparewienikɨ.   
\q1
\v 6 Kakuwu Kakaɨyarieya, kepauka 'ekɨ pemɨwarutiti,  
\q2 kawayutsixi meta memanatei meputimama mepɨkayɨwawekai memɨyekɨnekɨ.   
\q1
\v 7 'Ekɨ, yuheyemekɨ xeikɨa pepɨmakaxiwani.  
\q2 ¿Kemɨ'ane 'aku pɨmetsiha'iwa  
\q2 kepauka 'ekɨ pemɨyeha'ani?   
\q1
\v 8 Muyuawitsie paitɨ pepihekɨataxɨ heitserie kepemɨti'uximaya,  
\q2 kwie, matɨ, kayuwatɨ pɨtimakai.   
\q1
\v 9 Kakaɨyari 'aku, kepauka 'ekɨ pemayetɨa heitserie petiyurienike,  
\q2 tixaɨtɨ memɨkatehexeiya kwiepa memɨtama wahetsiemieme pewatawikweitsitɨanike.   
\q1
\v 10 Tewi haxɨaya nɨawari 'ahetsiemieme payeika,  
\q2 Kemɨ'ane memuyukuhayewa meteka'eniexɨame 'ixɨarari mekameniwewiriekuni.   
\q1
\v 11 Yawé yukakaɨyari hetsɨa yaxeketeneuyuhɨritɨa, meta xeketenaye'atɨwani,  
\q2 yunaitɨ kwie wa'aurie mukumanetsie  
\q2 mekete'iyetuiriwani Kakaɨyari mɨmakaxiwa,   
\q1
\v 12 kuwexinaruritsixi watɨrɨkariya mɨwakunawairiwa,  
\q2 kemɨ'ane kwiepa te'aitamete memayemakaxe.   
\c 77  
\d Teyuitɨwamete wa'ukiyari. Kerutuni hetsiemieme. 'Atsahapi nɨawarieya.  
\q1
\v 1 Kakaɨyari nepahɨawe ne'iwawirietɨ yemekɨ,  
\q2 Kakaɨyari nepahɨawe mɨnetsi'eniekɨ.   
\q1
\v 2 Kepauka nemu'uximatɨarie, ti'aitame neputiwawa,  
\q2 tɨkarikɨ neka'uxetɨ teikɨ nepememe,  
\q2 peru 'akuxi nepɨkanɨtɨariewe ne'iyaritsie.   
\q1
\v 3 Kakaɨyari nepa'eriwa, matsi neputatsuaka,  
\q2 hetsiena nepɨnekɨhɨawe, yemekɨ nepeɨmɨmɨkɨ.   
\q1
\v 4 Pepɨkanetsipitɨa nemɨkutsuni,  
\q2 kwinimieme nepɨti'uximatɨarie nepɨkaniuwe.   
\q1
\v 5 Nepɨraye'eriwa meripaitɨ timieme,  
\q2 meripaitɨ wiyaritsie kemɨtiuyɨ.   
\q1
\v 6 Nepa'eriwa kepauka ne'iyari muyutemawiekai.  
\q2 Hikɨ matsita 'ipaɨ nepɨtiyɨkɨhɨawe:   
\q1
\v 7 «¿Tarexɨrienitsɨkamɨ ti'aitame yuheyemekɨ?  
\q2 ¿Tawaritsɨkamɨ ke'aixɨa mɨtiuka'iyari mɨpaɨ katiyɨni?   
\q1
\v 8 ¿Kamɨtsɨ naitɨ tiuyɨ naki'eriyaya mɨkaxɨwekai,  
\q2 meta naimekɨ kemɨtarahɨawekai yuheyemekɨ?   
\q1
\v 9 ¿Ratɨmai Kakaɨyari ke'aixɨa mɨtiuka'iyarikai,  
\q2 yuhaxɨakɨri katareunenimaya?»   
\b  
\q1
\v 10 Mɨpaɨ nepɨti'eriwa: «'Ikɨ yemekɨ pɨnetsihekukukuine:  
\q2 'Amutewi yɨtɨrɨkariyakɨ pɨkatatsiparewie».   
\q1
\v 11 Nepiku'eriwa pɨta Yawé kemɨtiuyuri,  
\q2 nepe'eriwa mariweme kemɨtiuyuri meripaitɨ.   
\q1
\v 12 Nepɨnekɨhɨaweni mariweme kemɨtiuyuri,  
\q2 nepikuxatani yutɨrɨkariyakɨ kemɨtiuyuri.   
\b  
\q1
\v 13 Kakaɨyari 'aku, naitɨ 'ahuye pɨpatsie kepemɨtiyurienekɨ,  
\q2 kakaɨyaritɨtɨta xewitɨ pumawe hepaɨna timariwetɨ.   
\q1
\v 14 'Ekɨ Kakaɨyari pepɨhɨkɨ mariweme pemɨtiyuriwe,  
\q2 'atɨrɨkariya pemɨhekɨata teɨteri wahetsie.   
\q1
\v 15 'Atɨrɨkariyakɨ 'ateɨterima pepuwarɨxɨnaxɨ,  
\q2 Kakuwu nuiwarimama meta Kutse.   
\b  
\q1
\v 16 Kakaɨyari 'aku, haa pɨmetsi'utimaka,  
\q2 haa mepɨmetsi'uxei hikɨ hamewari mepuwewi,  
\q2 mɨkɨ meta haramara 'ameukatewa putima.   
\q1
\v 17 Haiwitɨri wiyeri pukaxɨri,  
\q2 muyuawi tɨranarikɨ putayua,  
\q2 muyuawi merɨkariyakɨ putatsanixɨ.   
\q1
\v 18 Petayua 'ayuariya haikɨri 'amɨpatsie,  
\q2 'amerɨkariya kwie puhekɨariyaxɨ,  
\q2 kwie putayua yuariyakɨ.   
\q1
\v 19 Haramaratsie 'ahuye pepanuwewi,  
\q2 haa waɨkawa 'apametsie pepɨtɨa,  
\q2 peru 'aketate pɨka'uhekɨarixɨ.   
\q1
\v 20 Muitsexi 'Aruni wahekɨ,  
\q2 'ateɨterima pepɨwarewitɨ muxatsi wahepaɨ.   
\c 78  
\d 'Atsahapi 'ɨkitɨarikaya.  
\q1
\v 1 Neteɨterima, ne'ɨkitɨarika xekene'enieka,  
\q2 kenemaine xekene'enanaka.   
\q1
\v 2 Ne 'ɨxatsikɨ nepɨtitaxata,  
\q2 meta meripaitɨ timieme tita 'atsimɨkatimatsiɨkɨkai,   
\q1
\v 3 tita temɨte'u'eni meta tita temɨtemate,  
\q2 tapaapama memɨtate'utaxatɨa.   
\q1
\v 4 Tanuiwari tepɨkawati'awitsirieni,  
\q2 'umemahu tepɨtewataxatɨani.  
\q1 Yawé tɨrɨkariyaya meta mamariwaweme kemɨtiuyuri  
\q2 meta witsiti'aneme kemɨtiuyuri.   
\q1
\v 5 Mɨkɨ 'aitsika putaxa Kakuwu hetsiemieme,  
\q2 'aitsika putahekɨataxɨ 'Ixaheri hetsiemieme,  
\q1 tatutsima pɨtiwaruta'aitɨa  
\q2 yunuiwarima memɨtewata'ɨkitɨanikɨ,   
\q1
\v 6 memimaikakɨ nuiwarite 'umemahu  
\q2 meta waniwema memɨtinunuiwa,  
\q2 mɨkɨta yuniwema memɨtewati'ɨkitɨanikɨ.   
\q1
\v 7 'Ana mɨpaɨ Kakaɨyari hetsie metewiyatɨ memakɨnekɨ  
\q2 meta kemɨtiuyuri memɨkahatɨtɨmaiyanikɨ,  
\q2 matsi memeye'atɨwanikɨ 'aitsikateya.   
\q1
\v 8 Mɨpaɨ yututsima wahepaɨ memɨka'anenikɨ:  
\q2 mɨkɨ nuiwari memɨkayukɨhɨawekai,  
\q1 memɨka'u'iyarikai,  
\q2 mɨkɨ yu'iyarikɨ Kakaɨyari hetsie memɨkatewiyakai.   
\q1
\v 9 'Epɨrahini nuiwarimama, yu'ɨrɨ me'utɨtɨ  
\q2 mepuyuta'unaxɨ kepauka memuyutakwitsie.   
\b  
\q1
\v 10 Mɨkɨ Kakaɨyari wahamatɨa tɨratu kemɨtiuwewiekai mepɨkaheye'atɨa,  
\q2 matsi pɨta mepiku'eiri 'aitsikateya.   
\q1
\v 11 Mepetɨmai kemɨtiuyuri,  
\q2 mariweme wahɨxie kemɨtiuwewi,   
\q1
\v 12 wapaapama wahɨxie mariweme kemɨtiuyuri,  
\q2 'Ekipitutsie Tsuhani kwieyaritsie.   
\q1
\v 13 Haramara hixɨapa puhuyetaxɨ mana memukɨnekɨ,  
\q2 haa pɨti'ukai 'ixumeri hepaɨ peutiheitseriekai.   
\q1
\v 14 Tukarikɨ haiwitɨri puwaruwitɨximekai,  
\q2 tɨkarikɨta taikɨ pɨwahekɨariwiyakai.   
\q1
\v 15 Makumawetsie 'ai hixɨapa puxite,  
\q2 pɨwaruharitɨa haa kwinimieme tiuhaneme,   
\q1
\v 16 'aitsie haa panetɨa haa 'aki'utɨma mieme hepaɨ,  
\q2 haa panetɨa hatɨa mieme hepaɨ.   
\b  
\q1
\v 17 Peru tawarita hepaɨtsitana 'axamepɨte'uyuri,  
\q2 makumawetsie Kakaɨyari 'Amutewi mepaye'uniekai.   
\q1
\v 18 Naimekɨ Kakaɨyari meputa'inɨataxɨ,  
\q2 'ikwai mepitawawiri tita memɨteheukwaikukai.   
\q1
\v 19 Niuki mepɨxɨatɨakai Kakaɨyari hepaɨtsita, matsi 'akuxi mɨpaɨ meputiyua:  
\q2 «¿Kakaɨyari kamɨtsɨ tiyɨwe mexa makumawetsie mutakeni tatiminike?   
\q1
\v 20 Kepauka tete muwatsie,  
\q2 haa kwinie panetɨya tɨrɨkaɨyetɨ,  
\q1 perutsɨ ¿'ikwai tatiumiwe tsiere?,  
\q2 ¿yuteɨterima wai tsɨkamɨ tiwarumiwe?»   
\q1
\v 21 Yawé kepauka mɨkɨ mɨtiu'eni, waɨkawa kaniuyeha'ani,  
\q2 puyeha'a Kakuwu hepaɨtsita,  
\q2 puyeha'a 'Ixaheri hepaɨtsita.   
\q1
\v 22 Kakaɨyari hetsie memɨkate'uwikɨ,  
\q2 yuri memɨkate'eriekaikɨ kename mɨkɨ watawikweitsitɨani.   
\q1
\v 23 Meutitewatsie paitɨ haiwitɨri mɨpaɨ katiniuta'aitɨani,  
\q2 hikɨ muyuawitsie katineuyepiere.   
\q1
\v 24 Manana mɨkawiyekɨ yatiniuyurieni memɨtekwanikɨ,  
\q2 hatsi muyuawitsie mieme kaniwarumini.   
\q1
\v 25 Yunaitɨ mɨkɨ niukituayamete wa'ikwai mekaniutikwani,  
\q2 Kakaɨyari 'ikwai kaniwareyenɨ'airieni kaniwarutihuxaitɨani.   
\q1
\v 26 Kakaɨyari 'eka tɨrɨkaɨyeme kaniuyuitɨani tau manatineikatsie,  
\q2 yutɨrɨkariyakɨ 'eka tatsutɨa mieme kanewatihana.   
\q1
\v 27 'Eka tumuanari kemɨtiukawiwiwa, mɨpaɨ wai katiniukawiwieni,  
\q2 wikixi haiwitɨriyari kaniwa'atɨirieni, xiekari hepaɨ mepɨteyuxexeiyakai.   
\q1
\v 28 Mematitekai wahixɨapa kaniwarukaxɨrieni  
\q2 meta waxamaru 'aurie.   
\q1
\v 29 Meteniukwani wa'iyaritsie katineuyeyani,  
\q2 Kakaɨyari katiniwaraye'atɨirieni kememutiyua.   
\q1
\v 30 Peru waheiwe'erika 'apɨkareuterixɨ:  
\q2 'ikwai yuteta 'akuxi mepayeyekai,   
\q1
\v 31 kepauka Kakaɨyari haxɨaya wahetsie munua:  
\q2 'ukitsi waɨkawa memɨtɨrɨkawi kaniwarukwini,  
\q2 temari 'ixaheritsixi 'aixɨa memɨ'anene kaniwarukwini.   
\b  
\q1
\v 32 Mɨyamete'anuyekɨnekatɨtɨ,  
\q2 yaxeikɨa 'axamekateniyuriekaitɨni  
\q2 yuri mekapɨte'uta'eri mariweme kemɨtiyurienekai.   
\q1
\v 33 'Ayumieme, Kakaɨyari watukari  
\q2 'etsitewime kanayeitɨani xei'itukariyari hepaɨ,  
\q2 watukari waɨkawa mematimariutsiwatsie kanitixɨrɨweni.   
\q1
\v 34 Kepauka Kakaɨyari muwaku'uximatɨwakai, mɨkɨta 'anake mekanitiwawakaitɨni,  
\q2 meyuwaɨriyatɨ tawarita mekani'axekaitɨni hetsɨana.   
\q1
\v 35 Mekanaye'eriwakaitɨni kename Kakaɨyari wa'ai hɨkɨ,  
\q2 kename Kakaɨyari 'Amutewi wawikweitsitɨwame hɨkɨ.   
\q1
\v 36 Peru 'arike yutetakɨ mekanikwamanakaitɨni,  
\q2 yunenikɨ mekani'itakaitɨni.   
\q1
\v 37 Yu'iyarikɨ Kakaɨyari mepɨka'ayexeiyakai,  
\q2 yamepɨkatekakɨ tɨratuya kemainekai.   
\q1
\v 38 Hikɨ mɨkɨ puwarutinenimayataxɨ, wakwewietɨ,  
\q2 pɨtiwareuyehɨwiri 'axakememɨte'uyuri,  
\q2 pɨkawaruka'unaxɨ.  
\q1 Mɨixa pɨka'uyeha'a pɨyunɨtɨakai,  
\q2 pɨtinewakai kemɨtiyɨanekai pɨkaha'akai.   
\q1
\v 39 Paye'eri kename tixaɨtɨ mekatehɨkɨtɨkai mekwiwawekai,  
\q2 'etsiwa xeikɨa yamɨreutetere 'eka hepaɨ tawarita pɨkanuani.   
\b  
\q1
\v 40 Mɨixa me'eye'unietɨ mepakɨ makumawetsie  
\q2 mepinutuitaxɨ yemekɨ makuwakitsie.   
\q1
\v 41 Kakaɨyari yamepɨte'inɨatatɨwekai,  
\q2 Mɨpatsie 'Ixaheri hetsiemieme mepɨhaxɨatɨakai.   
\q1
\v 42 Mepɨkaheye'eri kemɨtitɨrɨkaɨyekai,  
\q2 kemɨtiwaruwitɨ me'uximatɨariekaku,   
\q1
\v 43 'Ekipitu mariwemekɨ kemɨtiuyuri,  
\q2 meta kemɨtiuyuri yutɨrɨkariyakɨ Tsuhani kwieyaritsie,   
\q1
\v 44 kepauka haa 'Ekipitu mieme xuriya mayeitɨa  
\q2 mepɨkayɨwawekai memɨtihareni 'aki'utɨma,   
\q1
\v 45 kepauka nakatarixi mɨwarenɨ'a memɨwatikenikɨ,  
\q2 meta temutsi memɨwaka'unakɨ,   
\q1
\v 46 kepauka 'utsikari wawaxata mɨwarenɨ'a,  
\q2 'utsikari memuyuwaɨkawa wa'etsita memɨte'ukaxɨ,   
\q1
\v 47 kepauka tee wakaxie nanari mutituaxixɨ  
\q2 meta xapa 'iteɨriyari 'ɨwi mitiwatsiɨxaxɨ,   
\q1
\v 48 kepauka tee tewaxi mɨwarukwi,  
\q2 meta muxatsi mimierɨkarikɨ,   
\q1
\v 49 kepauka wahetsɨa yuhaxɨa meutahɨa,  
\q2 ha'atɨ, kawanenimayatɨ, waraye'unietɨ:  
\q2 kuyaxi niuki tuayamete teyu'unamete pɨwarenɨ'a.   
\q1
\v 50 Yuhaxɨa kaniutatuani,  
\q2 pɨkawarutawikweitsitɨa mɨkitsata,  
\q2 matsi pɨwayetua kwiniya tsata.   
\q1
\v 51 Tɨɨri yunaime pɨwarukwi mexɨakate 'Ekipitutsie,  
\q2 matɨari miemete Kami memakutekaitsie.   
\q1
\v 52 Yuteɨterima pɨware'ari muxatsi wahepaɨ,  
\q2 makumawetsie pɨwarewitɨ, muxatsi wahepaɨ,   
\q1
\v 53 tiwa'ɨkitɨatɨ hetsiena memɨtewiyanikɨ memɨkaheumamakakɨ.  
\q2 Peru memɨwaraye'uniekai haramarakɨ kaniwaranukanani.   
\b  
\q1
\v 54 Yuteɨterima kwie mɨpatsietsie kaniwa'atɨani,  
\q2 'ikɨ hɨri yutseriekɨ me'iwaxɨ.   
\q1
\v 55 'Ixaheritsixi wahetsiemieme nuiwarite kaniwarayeweiya,  
\q2 mɨkɨ kwie yuteɨterima kaniwayetuirieni,  
\q2 memɨwayetekaitsieta 'ixaheritsixi kaniwareutayatsa.   
\b  
\q1
\v 56 Peru mɨkɨ Kakaɨyari mekaniuta'inɨata:  
\q2 Mɨmariwe me'aye'unietɨ mekanakɨne  
\q2 'aitsikateya mepɨka'anu'eni.   
\q1
\v 57 Heitserie mepɨka'u'uwakai 'axamepɨte'u'iyarikai,  
\q2 yupaapama wahepaɨ,  
\q2 'axamepɨte'u'iyarikai watupi mututuni hepaɨ mepɨ'anenekai.   
\q1
\v 58 Mekaniyehaxɨatɨani tukite 'etsimupepe memutiwewikɨ,  
\q2 mamakɨ wewiyakate memuwarayexeiyakaikɨ.   
\q1
\v 59 Kakaɨyari retimaika waɨkawa kaniuyeha'ani,  
\q2 mɨkɨkɨ 'ixaheritsixi kaniwaruku'eirieni.   
\q1
\v 60 Tuki Tsiru muwekai kaniuku'eirieni,  
\q2 tukieya manuwekai 'ena kwiepa,   
\q1
\v 61 memɨwaraye'unie kaniwarupitɨani tɨrɨkariyaya witsimɨ'ane memanukwenikɨ.   
\q1
\v 62 Kwinimieme pɨtiuyeha'a yuteuterima wahetsiemieme,  
\q2 hipame 'ixiparakɨ memɨwakwinikɨ kaniwarupitɨani.   
\q1
\v 63 Temari taikɨ mekaniukwi'iwa,  
\q2 kwikari 'ukari mematiwikiwa wahetsiemieme pukumawerixɨ,   
\q1
\v 64 mawari wewiwamete 'ixiparakɨ mepukwi'iwaxɨ,  
\q2 wiuraxi mepɨka'uyɨwekaxɨa wahetsiemieme memuyuhiwerieka.   
\b  
\q1
\v 65 Hikɨ 'ana Ti'aitame kananutaniere,  
\q2 tiheinɨtɨ xewitɨ manutaniere hepaɨ,  
\q1 yumemiwame winukɨ kwinimieme mɨtiuhiwa hepaɨ.   
\q1
\v 66 Memɨwaraye'uniekai mema'iwarienikɨ yakatiniuyurieni,  
\q2 memɨyutitetewiyakɨ yuheyemekɨ yakatiniuyurieni.   
\q1
\v 67 Kutse niwemama kaniwarexɨrieni,  
\q2 'Epɨrahini xiɨyarimama pɨkawaranayexei,   
\q1
\v 68 matsi pɨta, Kura nuiwarimama pɨwaranayexei,  
\q2 meta Tsiyuni hɨriyari mɨnaki'erie.   
\q1
\v 69 Yutuki kaniutawewieni, heutitewame muyuawi hepaɨ,  
\q2 kwie hepaɨ, ke'aixɨa miyuri yuheyemekɨ.   
\q1
\v 70 Rawiri tiyu'uximayatsiriwame kananayexeiya,  
\q2 muxatsi mɨwahɨwemetɨkai,   
\q1
\v 71 kaninawairieni muxatsi wa'arɨwame mɨhɨkɨtɨkai,  
\q2 Kakuwu hɨwemeya mayanikɨ meta teɨterimama,  
\q2 'ixaheritsixi wahɨweme hetsɨana miemete.   
\q1
\v 72 Rawiri yu'iyarikɨ kaniwarutahɨni,  
\q2 timaiwetɨ kaniwaku'arienekaitɨni.   
\c 79  
\d 'Atsahapi nɨawarieya.  
\q1
\v 1 Kakaɨyari 'aku, teɨteri memɨka'ahetsɨa miemete mepɨtatsi'unawairi tita pemɨtatiyetuiriekai,  
\q2 'atuki mɨpatsie kapatsiekame mepayeitɨa,  
\q2 Kerutsareme 'unime mepayeitɨa.   
\q1
\v 2 'Ateɨterima wakaxari  
\q2 wirɨkɨxi wa'ikwai mepɨwarayeitɨa,  
\q1 yamemɨtekahu wawaiyari  
\q2 yeutari wa'ikwai katinayani.   
\q1
\v 3 Naitsarie Kerutsaremetsie xuriya meputayeuri,  
\q2 haa memutayeurieni hepaɨ,  
\q2 meta mɨkite muwakateuku kaniumaweni.   
\q1
\v 4 Ta'aurie kiekatari tahetsiemieme niuki mekaniwewieka,  
\q2 tame tekanihɨkɨtɨni 'atsieriwamete ta'aurie memahane wahetsiemieme.   
\b  
\q1
\v 5 ¿Yawé, kepaukake tamɨ?  
\q2 ¿Kamɨtsɨ 'aheyemekɨ petiha'aka?  
\q2 ¿'Ahaxɨa kamɨtsɨ tai hepaɨ tiutataweni?   
\q1
\v 6 Keniwaruyeheka 'iya nuiwarite memɨkametsimatekɨ,  
\q2 te'aitamete memɨkametsihahɨawekɨ.   
\q1
\v 7 Neuxei Kakuwu kaniutakwaiyani,  
\q2 meta mɨkɨ kwieyari 'unime mekanayeitɨani.   
\q1
\v 8 Meripaitɨ ke'axatemɨte'uyuri kenatɨmaiya,  
\q2 yapauka ketaneutinenimayata,  
\q2 neuxei tame tekaniyumuinani.   
\b  
\q1
\v 9 Xɨa'ui Kakaɨyari, tatsiwikweitsitɨwame,  
\q2 mariweme pemɨtiyuriwe kepemɨtitewakɨ, ketaneuparewi,  
\q2 'aixɨa pemɨtiuka'iyarikɨ, ketaneɨxɨna 'axatemɨte'uyurikɨ ketatineuyehɨwiri.   
\b  
\q1
\v 10 Neuxei nuiwarite mɨpaɨ mekanitiyuakuni:  
\q2 «¿Tamɨri hakewa wakakaɨyari?»  
\q1 Ketaneuxeiyatsitɨa, teɨteri 'ahetsɨa memɨkamiemete  
\q2 wahɨxie yaketiniwarakapitɨa, 'ateɨterima waxuriya memutayeurikɨ mɨpaɨ keniwaruyuri 'ekɨta.   
\q1
\v 11 'Ahetsɨa paitɨ keheye'ani  
\q2 memehapanie watsuari,  
\q1 'atɨrɨkariyakɨ  
\q2 memɨkwi'iwa keniwarutawikweitsitɨa.   
\b  
\q1
\v 12 Ti'aitame, ta'aurie kiekatari  
\q2 'atahutamexɨa ketiniwarakapitɨa  
\q2 'axamemutiyuakɨ 'ahepaɨtsita.   
\q1
\v 13 Tameta, 'ateɨterima meta 'amuxatsima 'akuraruta miemete,  
\q2 tepɨmetsinɨawani yuheyemekɨ,  
\q1 nuiwarite memanuyekɨka nuiwarite memanuyekɨka  
\q2 kwikari 'ahetsiemieme teputikwikani.   
\c 80  
\d Teyuitɨwamete wa'ukiyari. Yuariyaya xekeneuweiyani «Tuturi tɨratuyari». 'Atsahapi nɨawarieya.  
\q1
\v 1 'Ixaheri hɨweme,  
\q2 'ekɨ kutse pemuwitɨxime muxatsi wahepaɨ,  
\q2 'ekɨ metsiteɨtamete watsata pe'atikaitɨ,  
\q2 ketaneu'eni.  
\q1 Keneuxawatɨxɨa  
\v 2 'Epɨrahini hɨxie,  
\q2 Wenikamini meta Manatsexi wahɨxie.  
\q2 Keneuhekɨata 'atɨrɨkariya, kenenua ketaneutawikweitsitɨa.   
\b  
\q1
\v 3 Xɨa'ui, Kakaɨyari, 'aixɨa ketaneuyuri,  
\q2 'aixɨa ketatineuxeiya,  
\q2 ketaneutawikweitsitɨa.   
\q1
\v 4 ¿Kepaukake tamɨ pepɨtihayewa peha'atɨ Yawé Kakaɨyari  
\q2 Naimekɨmɨtɨrɨkaɨye, 'ateɨterima wanenewieri hepaɨtsita?   
\q1
\v 5 'Ikwai petatsiminike hiwerika pepɨtatsi'upitɨa temiti'ienikɨ,  
\q2 memɨte'iekai wahetsiemieme, waɨkawa wa'ukai pepɨwayetuirie memiti'ienikɨ.   
\q1
\v 6 Ta'aurie kiekatari memɨtatsi'atsenikɨ  
\q2 yapepɨtatsi'uyuri,  
\q1 memɨtatsi'aye'unie mepɨtatsiyuriya.   
\b  
\q1
\v 7 Kakaɨyari Naimekɨmɨtɨrɨkaɨye 'aixɨa ketaneuyuri,  
\q2 'aixɨa ketatineuxeiya,  
\q2 ketaneutawikweitsitɨa.   
\b  
\q1
\v 8 'Ekipitu paitɨ xeime kaxie pepeyetui,  
\q2 memɨka'ateɨterima pewarutaweiyaka, mana pepikaye.   
\q1
\v 9 Kwiepa 'aixɨa pemɨrakuyuritsie,  
\q2 mana kanananataxɨani hikɨ kwiepa waɨkawa kaniutaxiɨni.   
\q1
\v 10 'Etɨriyaya hɨritetsie paitɨ pepuye'atɨatɨya,  
\q2 kɨtsimeyari yunaime kariuxa 'amutɨtɨ pɨwara'iwakai.   
\q1
\v 11 Xawarieya haramaratsie paitɨ kaneuta'axɨani,  
\q2 muwatiyɨraxɨa 'Eupɨrata paitɨ kaneuta'ani.   
\b  
\q1
\v 12 ¿Titayari kuraruya petiuka'unaxɨ?  
\q2 Yunaitɨ mana memuyekɨka 'iteɨrieya kaxie mekanika'inɨweni.   
\q1
\v 13 Tuixuri yeutari mekanikumaweriyarɨmeni,  
\q2 yeutari mekanikwaka.   
\q1
\v 14 Xɨa'ui Kakaɨyari, Naimekɨmɨtɨrɨkaɨye tahetsɨa kenenua.  
\q2 Muyuawitsie paitɨ kenakanieri  
\q2 'ikɨ kaxie kene'ɨwiyani.   
\q1
\v 15 'Atseriekɨ nanari pemukaye kanihɨhɨtɨni.  
\q2 Mɨkɨ hekwamekɨ matiyɨraxɨ 'ahetsiemieme pɨhɨkɨ.   
\b  
\q1
\v 16 'Akaxie nanayari kaniuka'unarieni, taikɨ kaniutataiyarieni,  
\q2 'atierikakɨ 'ateɨterima mepɨte'uka'eniwa.   
\q1
\v 17 Keneuparewi tewi pemanayexei,  
\q2 'aniwe 'ahetsiemieme pemitaweriyaxɨ.   
\q1
\v 18 Tame tepɨkametsiku'eirieni,  
\q2 ketananutanieritɨa, 'ana tepɨmetsihahɨaweni.   
\b  
\q1
\v 19 Yawé Kakaɨyari Naimekɨmɨtɨrɨkaɨye, 'aixɨa ketaneuyuri,  
\q2 'aixɨa ketatineuxeiya,  
\q2 ketaneutawikweitsitɨa.   
\c 81  
\d Teyuitɨwamete wa'ukiyari. Yuariyaya xekeneuweiyani «Kaxie mɨpɨnarie» hepaɨ mɨpaɨ ketiukwikarieni. 'Atsahapi nɨawarieya.  
\q1
\v 1 Xeyutemamawietɨ Kakaɨyari xekenekwikani, mɨtatsitɨrɨkariya,  
\q2 Kakuwu Kakaɨyarieya xekenehiwieka xeyutemamawietɨ.   
\q1
\v 2 Nɨawari hetsiena mieme xekeneyuitɨaka.  
\q2 'Ari tepu 'etsimɨpe xekeneutahutsunani,  
\q2 xaweri meta kanari witsimutaine.   
\b  
\q1
\v 3 Muxa 'uki 'awaya xekeneutahɨtsi metseri manatiwenitsie,  
\q2 meta metsa mɨxikɨraɨyenitsie, ta'ixɨarari tukariyaritsie.   
\q1
\v 4 'Ikɨ 'aitsika kanihɨkɨtɨni 'ixaheritsixi wahetsiemieme,  
\q2 Kakuwu Kakaɨyarieya 'aitsikaya kanihɨkɨtɨni.   
\q1
\v 5 Tɨratu Kutse hamatɨa kaniuwewieni,  
\q2 kepauka memayekɨ 'Ekipitu kwieyaritsie.  
\b  
\q1 Niuki nemɨka'i'enie nekaniu'enieni:   
\q1
\v 6 «'Ika nekamaniunawairieni pemetɨkɨkai,  
\q2 kiriwa mahete 'ari pekaniunawaiyarieni.   
\q1
\v 7 Pe'uximatɨarietɨ pemɨnetsi'utahɨawixɨ, nekameniɨxɨna,  
\q2 nene'awietatɨ hai mɨmariwetsie nekameniuta'eiya,  
\q2 Meriwa hayaritsie nekameniuta'inɨata.   
\b  
\q1
\v 8 »Neteɨterima kenemɨtixe'ayehɨtɨwa xekeneneu'eni,  
\q2 xɨa'ui 'ixaheritsixi, xɨka xeikɨa xenetsi'u'enienike.   
\q1
\v 9 Teewatanaka kakaɨyaritɨme xeime pepɨkahayexeiyani,  
\q2 xeime kakaɨyaritɨme yɨkɨ 'aneme hɨxie pepɨkahekatunumaweni.   
\q1
\v 10 Ne nepɨhɨkɨ Yawé 'akakaɨyari,  
\q2 'Ekipitu nemɨmetsi'ayewitɨ.  
\q2 Kenakwaxaka, ne 'ateta nekatinitahɨniyamɨkɨ.   
\b  
\q1
\v 11 »Neuxei peru neteɨterima mepɨkanetsi'u'eni,  
\q2 'ixaheritsixi yamepɨkatekakɨ kenemainekai.   
\q1
\v 12 'Ayumieme nepɨwaruku'eiri wa'iyari mɨtsetse'ikaikɨ,  
\q2 kemɨtiwanake memɨyɨakaikɨ.   
\b  
\q1
\v 13 »Xɨka neteɨterima xeikɨa menetsi'u'enienike,  
\q2 xɨka 'ixaheritsixi nehuyeta me'uhunike,   
\q1
\v 14 yapauka ne memɨwaraye'unie nekaniwara'iwake,  
\q2 meta nekaninuanike memɨwaraye'unie wahetsɨa netɨrɨkariyakɨ.   
\q1
\v 15 Kemɨ'ane Yawé memɨxani'erie hɨxiena mepuyuyetuawawekai,  
\q2 meta yuheyemekɨ mekatenikwinitɨarienikekaitɨni.   
\q1
\v 16 'Ekɨta tɨriku 'aixɨa mɨ'anekɨ pekatinimikienikekaitɨni,  
\q2 meta xiete 'aitsie miemekɨ».   
\c 82  
\d 'Atsahapi nɨawarieya.  
\q1
\v 1 Kakaɨyari puwa'ɨxatsitɨa muyuawitsie mieme tikuxatatɨ,  
\q2 pɨwaxaneta kakaɨyarixi wahixɨapa 'uwetɨ kemɨtiwaranutaxɨrienikɨ:   
\b  
\q1
\v 2 «¿Kepaukari tamɨ xepɨtehayewa 'axaxeteyurietɨ,  
\q2 kepauka 'aixɨa xepɨtiyuani Kakaɨyari memɨka'ayexeiya wahetsiemieme?   
\q1
\v 3 Nutui hetsie xekenenuaka kemɨranuyemie, meta kemɨ'ane yuhetsie mɨtanuanikɨ mɨkayɨwe,  
\q2 tixaɨtɨ mɨkarexeiya meta mɨti'uximayatsitɨarie wahetsiemieme 'aixɨa xeketeneyurieka.   
\q1
\v 4 Mɨkayɨhɨawe meta hawerimɨ'ane xekenewawikweitsitɨaka,  
\q2 Kakaɨyari memɨka'ayexeiya metewa'aitɨakaku xekeniwarɨxɨna.   
\b  
\q1
\v 5 »Mɨkɨ 'atsimepɨkatemate, mɨkɨ mepɨkaheti'enatɨkɨka.  
\q2 Yɨwipa mepu'uwa,  
\q2 mɨkɨ putayuane kwie tsutɨa naitɨ.   
\b  
\q1
\v 6 »Ne mɨpaɨ nepɨtixekɨhɨawe: “Xeme xepɨmamariwawe,  
\q2 yunaitɨ xeme 'Amutewi xepɨniwemama”.   
\q1
\v 7 Peru xekanikwikuni tewi mɨmɨwe hepaɨ,  
\q2 xekanatixɨrikuni hipatɨ te'aitamete wahepaɨ».   
\b  
\q1
\v 8 Kenanukukexi, Kakaɨyari 'aku, kwiepa tita mɨtiheitserie yaketineuyuri,  
\q2 nuiwarite yunaitɨ memɨte'apiinimakɨ.   
\c 83  
\d Kwikari. 'Atsahapi nɨawarieya.  
\q1
\v 1 Kakaɨyari 'aku, kayuwatɨ pepɨka'umaka,  
\q2 Kakaɨyari 'aku, pemɨkaheu'ena pepɨkahɨkɨtɨni 'atsipekatiyurimɨtɨ.   
\q1
\v 2 Keniwaruxeiya memɨmetsi'aye'unie kememɨteyukwiku,  
\q2 memɨmetsixani'erie mepɨmetsi'iwaku.   
\q1
\v 3 Metemaiwawetɨ 'ateɨterima wahepaɨtsita mepɨtekuxata,  
\q2 'axamewayurienike pemɨwanaki'erie.   
\q1
\v 4 Mɨpaɨ mekaniutiyuaneni: «Hikɨmɨtɨka, wanuiwari tepauyehɨani.  
\q2 'Ixaheri manɨyɨne pɨkaku'eriwaniri».   
\b  
\q1
\v 5 Yunaitɨ mekaniyutaxewireni,  
\q2 tɨratu mekaniuwewieni 'ahepaɨtsita miemeyari metekuxatatɨ:   
\q1
\v 6 'Erumi teɨterimama memukutetɨka meta 'Itsimaheri,  
\q2 Muhawi kiekatari meta Hakaxi teɨterimama,   
\q1
\v 7 Kewari, 'Amuni meta 'Amareki wateɨterima,  
\q2 Piritsiteu kwieyari hetsie kiekatari meta Tiru kiekatari.   
\q1
\v 8 Meta 'Atsiriya kaniwarɨnɨni,  
\q2 Ruti nuiwarimama kaniwaparewieka.   
\b  
\q1
\v 9 Mariyani kepemɨwaruyuri mɨpaɨta mɨkɨ keniwaruyuri,  
\q2 kepemɨwaruyuri Tsitsara meta Kawini, Kitsuni 'akiyari manuyekatsie,   
\q1
\v 10 mɨkɨ 'Eniruxi mɨrakutwatsie memukwi  
\q2 kwiepa memuyuhayewaxɨ kwitarai hepaɨ.   
\q1
\v 11 'Urewi meta Tsewi kepemɨwaruyuri  
\q2 mɨpaɨta keniwaruyuri memanuyetei mana memɨtama,  
\q1 memanuyetei te'aitamete yaxeikɨa keniwaruyuri  
\q2 kepemɨwaruyuri hepaɨ Tsewa meta Tsarimuna,   
\q1
\v 12 Mɨpaɨ memaitɨkatei: «Tapiini tepayeitɨani  
\q2 Kakaɨyari kwieya mu'ɨxaya».   
\b  
\q1
\v 13 Nekakaɨyari, 'ɨtsi haikɨritsie hepaɨ ketiniwaruxikɨriwitsitɨa,  
\q2 xatsi 'eka mei'enitsitɨwa hepaɨ.   
\q1
\v 14 Tai kɨyexite kemɨtitixɨxɨtsitɨwa  
\q2 meta tai hɨri kemɨtititaiya hepaɨ,   
\q1
\v 15 mɨpaɨ ketiniwaranukuweiya pewamariutatɨ,  
\q2 waɨkawa keniwarutimariuta 'a'ekakɨ.   
\q1
\v 16 Yawé, keniwarutewiyatsitɨa,  
\q2 memɨmetsitiwaunikɨ.   
\b  
\q1
\v 17 Yuheyemekɨ meke'utewiyatsitɨarieni,  
\q2 meke'ukwini tixaɨtɨ mekatehayuyeitɨatɨ.   
\q1
\v 18 Meketehetimani 'ekɨ Yawé pemɨhɨkɨkɨ,  
\q2 mɨpaɨ pemɨtitewa,  
\q1 mɨpaɨ meketemaika 'ekɨ xeikɨa 'Amutewi pemɨhɨkɨkɨ  
\q2 'ena kwiepa naitsarie.   
\c 84  
\d Teyuitɨwamete wa'ukiyari. Yuariyaya xekeneuweiyani «Kaxie mɨpɨnarie» hepaɨ ketiukwikarieni. Kure niwemama wanɨawari.  
\q1
\v 1 Yawé Naimekɨmɨtɨrɨkaɨye,  
\q2 'akiekarite witsipɨ'anene.   
\q1
\v 2 Nepeiyehɨwa ne'iyarikɨ Yawé takwana,  
\q2 'ariri mana neheuyeimɨtɨ nekanimɨximeni.  
\q1 Nekanikwikani Kakaɨyari tukari mɨtiyupitɨwa  
\q2 ne'iyarikɨ meta naime newaiyarikɨ.   
\b  
\q1
\v 3 Yawé Naimekɨmɨtɨrɨkaɨye, neti'aitɨwame meta nekakaɨyari pemɨhɨkɨ,  
\q2 wikitɨtɨ 'amawari taiyame 'aurie yukii putaxexeiya,  
\q1 metatsiere wiki 'itsitame muwa yu'itua putawewiwa,  
\q2 muwa mɨti'itsinienikɨ.   
\b  
\q1
\v 4 'Aixɨa ke'itɨarieka kemɨ'ane 'akiita mɨkiekame,  
\q2 yuheyemekɨtsɨ kameninɨawani.   
\q1
\v 5 'Aixɨa ke'itɨarieka kemɨ'ane 'ahetsɨa tɨrɨkariya mukaxexeiya,  
\q2 'ahuyeta xeikɨa mumienikɨ muyukɨhɨawe.   
\q1
\v 6 Kepauka 'ukaitsata muyeyani  
\q2 haixatsata kanayeitɨwani,  
\q1 meta wiyeri ximeri mieme  
\q2 katiniutiwaweriyani mayeweritsie.   
\q1
\v 7 Metsɨ 'ateewa kɨkamete mekaniuhuni, matsi waɨkawa tɨrɨkariya mekanipitɨarieka,  
\q2 Tsiyuni mekaniye'axeni Kakaɨyari hɨxie, kakaɨyarixi muwakakaɨyari hetsɨa.   
\b  
\q1
\v 8 Yawé, Kakaɨyari Naimekɨmɨtɨrɨkaɨye, nenenewieri keneu'eni,  
\q2 keneneu'eni, Kakuwu Kakaɨyarieya.   
\q1
\v 9 Kakaɨyari 'aku, tepɨa tahetsie nunuwame,  
\q2 pemanayexei keneuxeiya 'aixɨa 'anemekɨ.   
\b  
\q1
\v 10 'Aixɨa pɨ'ane 'atakwa nemukanikɨ xeitukari,  
\q2 pɨkaheuyewetse xeimiriyari takwa nemeyeikani,  
\q1 pɨnetsinake Kakaɨyari kiiya kitenie nemɨ'ɨwiyani,  
\q2 'aixɨa pɨka'ane Kakaɨyari memɨka'ayexeiya wahetsɨa nemukani.   
\b  
\q1
\v 11 Yawé tau hepaɨ kani'aneni meta tepɨa tahetsie nunuwame,  
\q2 Kakaɨyari tahetsiemieme witsipɨtikuxata.  
\q1 Yawé kaniwareu'enieka heitseriemekɨ memu'uwa  
\q2 wahetsie karahɨpatɨ.   
\b  
\q1
\v 12 Yawé Naimekɨmɨtɨrɨkaɨye,  
\q2 'aixɨa meke'itɨarieka 'ahetsie memɨtewiya.   
\c 85  
\d Teyuitɨwamete wa'ukiyari. Kure niwemama wanɨawari.  
\q1
\v 1 Yawé, 'aixɨa pepɨtiuka'iyari 'ikɨ kwie mɨti'apiini hepaɨtsita  
\q2 Kakuwu pemuhekwariyaxɨkɨ,   
\q1
\v 2 Pepɨtiwareuyehɨwiri 'ateɨterima 'axamemɨte'uyurikɨ,  
\q2 pepɨrayukatua naime 'axamemɨte'uyurikɨ,   
\q1
\v 3 pepukahaxɨapi,  
\q2 pepɨtiuhayewaxɨ 'ahaxɨa pe'utaiyaka.   
\b  
\q1
\v 4 Tawarita matsi 'aixɨa ketaneuyuri, Kakaɨyari tatsiwikweitsitɨwame,  
\q2 ketineuhayewa 'axakepemɨtatiku'eriya.   
\q1
\v 5 ¿Kamɨtsɨ petiha'aka 'aheyemekɨ tahepaɨtsita?  
\q2 ¿Peha'atɨ 'aheyemekɨ perayani?   
\q1
\v 6 ¿Tawarita tukari hekwame pekatatiyetuirieni,  
\q2 'ateɨterima 'ahetsiemieme memɨyutemawiekakɨ?   
\q1
\v 7 Yawé, ketaneuxeitsitɨa 'anaki'eriya mɨkaxɨwe,  
\q2 ketaneyetuiri 'awikweitsitɨarika.   
\b  
\q1
\v 8 Nepi'enieni Yawé Kakaɨyari kemaine:  
\q2 mɨkɨ yuteɨterima kayuwatɨ memexeiyanikɨ pɨwapitɨani wahetsiemieme meta kemɨ'ane hetsiena mieme 'aixɨa memɨtekahu,  
\q2 tawarita 'atsimemɨkatemate wahepaɨ mepɨkayɨaka.   
\q1
\v 9 'Ahurawa puyeika watawikweitsitɨanike kemɨ'ane memimakaxe,  
\q2 kemɨtimariwe mɨmatsiɨkɨnikɨ 'ena kwiepa.   
\b  
\q1
\v 10 Naki'eriya meta tita yuri mɨraine puyukaxeiya,  
\q2 kayuwatɨ mɨ'ayumie meta mɨtiheitserie hamatɨa mepuyuti'itseni.   
\q1
\v 11 'Ena kwiepa pɨtineni tita mɨtiyuri,  
\q2 muyuawitsieta 'aixɨa mɨti'ane puyuhekɨare.   
\q1
\v 12 Yawé 'aixɨa pɨtatsiyurieni,  
\q2 takwie 'ikwaxi waɨkawa pɨtitixuaweriya.   
\q1
\v 13 Tita mɨtiheitserie hɨxiena panuyeyerɨni  
\q2 mɨkɨ pɨwatahuyetɨani.   
\c 86  
\d Rawiri nenewierieya.  
\q1
\v 1 Yawé, keneneu'eni keneneuta'eiya,  
\q2 haweri nepɨ'ane waɨkawa nepɨreuyehɨwa.   
\q1
\v 2 Netukari kene'ɨwiyani, heitseriemekɨ yanemɨtikamiekɨ 'ahetsiemieme.  
\q2 'Ekɨ pepɨnekakaɨyari, 'ahetsie nepɨtiwiya,  
\q2 kenewikweitsitɨaka ti'a'uximayatsiriwame.   
\q1
\v 3 Ti'aitame, kenenenenimayaka,  
\q2 'ekɨ xeikɨa nekamenahiwiwani tukarikɨ.   
\q1
\v 4 Ti'a'uximayatsiriwame 'iyarieya 'aixɨa keneuyuri,  
\q2 karikɨ ti'aitame, 'ekɨ xeikɨa ne'iyari nekameniyetuirieka.   
\b  
\q1
\v 5 Ti'aitame, 'ekɨ 'aixɨa pekatiniuka'iyarini meta pekanetineuyehɨwiriemɨkɨ,  
\q2 pɨmariwe 'anaki'eriya kemɨ'ane memɨmetsihahɨawe wahetsɨa.   
\q1
\v 6 Yawé, nenenewieri keneu'eni,  
\q2 ne'iwaurika kenanu'eni.   
\q1
\v 7 Kepauka nemɨ'uximatɨarieka 'ana nekamenahɨaweni,  
\q2 'ekɨ pemɨnetsiku'eiyakɨ.   
\b  
\q1
\v 8 Yawé, tawarita xewitɨ pumawe kakaɨyarixi watsata 'ahepaɨ tiuka'iyaritɨ,  
\q2 pumawe wewiyaya pemɨtiutiwewi hepaɨ ti'anenetɨ.   
\q1
\v 9 Yunaime nuiwarite pemɨwarutiwewi  
\q2 mepɨ'axɨani, 'ahɨxie mepɨkatunuma'uni, Ti'aitame,  
\q2 'ahetsiemieme 'aixɨa mepɨtiyuani.   
\q1
\v 10 'Ekɨ pemɨmariwekɨ meta mariwemekɨ pemɨtiyurienekɨ,  
\q2 'ekɨ xeikɨa pepɨkakaɨyari.   
\b  
\q1
\v 11 Yawé, 'ahuyeta nemumienikɨ kenetine'ɨkitɨaka  
\q2 nemumienikɨ 'aixɨa netikamietɨ.  
\q1 Ne'iyaritsie 'aixɨa netinekɨhɨaweme kenenayeitɨa  
\q2 nemɨmetsimakaxenikɨ.   
\q1
\v 12 Neti'aitɨwame nekakaɨyari, ne'iyarikɨ nepɨmetsinɨawani,  
\q2 yuheyemekɨ 'aixɨa nepɨmerahɨaweni.   
\q1
\v 13 Mɨmariwekɨ 'anaki'eriya nehetsiemieme,  
\q2 pepɨnetsi'utawikweitsitɨa mɨki teukiyata neheukaweximekaku.   
\b  
\q1
\v 14 Kakaɨyari 'aku, teɨteri meyɨwaweme meyuxatatɨ mepɨnetsimietɨwe,  
\q2 yuwaɨkawatɨ meyɨnɨtɨ teyumiekate mekanenimiekuni.  
\q2 Teɨteri peka'uyeikame me'erietɨ mekaniyɨaka.   
\q1
\v 15 'Ekɨ peru, Ti'aitame, Kakaɨyari pepɨtiuyukakwewimɨkɨ petiuyukanenimayatɨ,  
\q2 pepɨkahayu'eriya, waɨkawa peti'akanaki'erietɨ meta yuri pehaitɨ.   
\q1
\v 16 Kenenua nehetsɨa, kenenenenimayaka,  
\q2 keneneutatɨrɨkariya ne ti'a'uximayatsiriwame.  
\q2 Ne 'aniwe 'aixɨa nemɨtiuka'iyari keneneutawikweitsitɨa.   
\q1
\v 17 'Inɨari keneneuwewiri kepemɨnetinaki'eriekɨ,  
\q2 memɨnetsi'aye'unie memixeiyakɨ memɨyutitetewiyakɨ,  
\q2 'ekɨtsɨ Yawé, pemɨnetsi'uparewikɨ meta pemɨnetsi'unɨtɨakɨ.   
\c 87  
\d Kure niwemama wanɨawari. Kwikariyari.  
\q1
\v 1 Kakaɨyari kiekarieya tsutɨmeyari  
\q2 hɨri mɨpatsietsie katini'aneni.   
\q1
\v 2 Yawé Tsiyuni 'itupariyarite memeutahaketsie kaninaki'erieka,  
\q2 Kakuwu kiekariteya kemɨkatinaki'erie.   
\q1
\v 3 'Ahetsiemieme, Kakaɨyari kiekarieya,  
\q2 witsi'anemekɨ katinikuxaxatsiwani:   
\q1
\v 4 «Kemɨ'ane memɨnetsimate  
\q2 nekaniwa'inɨatani Xahawi meta Wawiruniya,  
\q1 metatsiere Piritsiteutsixi wakie, meta Tiru, metatsiere Kutsi.  
\q2 Mɨpaɨ katinikuxaxatsiwani: “'Ikɨ Tsiyuni kaniutinuiwa”».   
\b  
\q1
\v 5 Yurikɨ, Tsiyunitsie mɨpaɨ pɨtitaniukieni:  
\q2 «'Ikɨ meta 'iya mana mekaniutinunuiwa.  
\q2 Mɨkɨ 'Amutewitɨtɨ kanikamani».   
\q1
\v 6 Yawé teɨteri mɨpaɨ katiniwa'utɨamɨkɨ:  
\q2 «'Ikɨ Tsiyunitsie kaniutinuiwa».   
\q1
\v 7 Mexi 'akuxi me'utikwika meta meteneitɨwe, mɨpaɨ meputiyuane:  
\q2 «'Ahetsie naitɨ pɨtihekɨa kenemɨtiunuiwaxɨ».   
\c 88  
\d Teyuitɨwamete wa'ukiyari. Hemani 'ɨkitsikaya 'etsirahi tewiyari. Tikwikame kwikariyari. Kure niwemama wanɨawari.  
\q1
\v 1 Yawé, Kakaɨyari netsiwikweitsitɨwame,  
\q2 tukarikɨ tɨkarikɨ nekanahiwani 'ahɨxie.   
\q1
\v 2 'Ahetsɨa paitɨ nenenewieri keheuye'ani,  
\q2 kenemɨmatiwawirie kenene'enieka.   
\b  
\q1
\v 3 Nepɨhɨne 'uximatɨarikakɨ  
\q2 'ari netukari mɨki teukiyapa kaneukaniereni.   
\q1
\v 4 'Ari nekani'inɨatsieka putsuta memeukaxɨriwa wahamatɨa,  
\q2 kuya mɨkatɨrɨkaɨye nekanihɨkɨtɨni.   
\q1
\v 5 'Ari yateewa nekaniutekieka, mɨkite watsata,  
\q2 mɨki hepaɨ nepɨtinexexeiya kwieta matika hepaɨ,  
\q1 'iya kemɨ'ane 'ari pemɨkawara'eriwa,  
\q2 memanakaxɨri 'amamatsie.   
\b  
\q1
\v 6 Putsu meukatewatsie pekaneneukahɨani,  
\q2 waɨkawa muyemariwetsie meukatewatsie.   
\q1
\v 7 'Ahaxɨa kemɨrahete nehetsie pukawe,  
\q2 pekanenehana 'ahamewarikɨ.   
\q1
\v 8 Pekaneniunawairieni yunaime nehamikuma  
\q2 meta mɨkɨ wahɨxie nexani'eriwame pepɨnetsi'ayeitɨa.  
\q1 Nekananutahɨiyaka meta nemuyuxɨna nepɨkayɨwe,   
\q2
\v 9 nehɨxite pɨkaheuneniere hiwerikakɨ.  
\b  
\q1 Yawé, ne tukarikɨ nemetsihahɨawe,  
\q2 'ahepa nekaneutamemeni.   
\q1
\v 10 ¿Kamɨtsɨ mɨkite watsata mariweme pemɨtiuyurieni petiyɨwe?  
\q2 ¿Kamɨtsɨ mɨkite me'anuku'ume pamɨpariyutsi memetsi'upitɨani tiyɨwe?   
\q1
\v 11 ¿Kamɨtsɨ mɨkite watsata 'anaki'eriya rekuxaxatsiwa,  
\q2 meta ke'aixɨa pemɨtikamie meukatewatsie?   
\q1
\v 12 ¿Kamɨtsɨ yɨwipa timatiwa mariweme kepemɨtiyuriene,  
\q2 yatɨni heitserie kepemɨrexeiya kwie matɨmaiyarietsie?   
\b  
\q1
\v 13 Yawé, ne waɨkawamekɨ nepɨmetsiwawirie keneneuparewi,  
\q2 ximeri nepɨmetsi'utiwawa neyunenewietɨ.   
\q1
\v 14 ¿Yawé, titayari peneti'uxiwe'erie?  
\q2 ¿Titayari pekanetixeiyamɨkɨ?   
\b  
\q1
\v 15 Ne nepɨtiuka'eniwa temaikɨyari paitɨtɨ,  
\q2 heiwa 'ari nepɨkukweriwayɨne.  
\q1 Pekaneneyenɨ'airieni yemekɨ waɨkawa 'uximatɨarika  
\q2 'ari tawarita nekapɨyɨwe.   
\q1
\v 16 'Ahaxɨa yemekɨ nehetsie kaniukawiwieni,  
\q2 'a'iwaɨyɨ kanenitaxɨtɨaximeni.   
\q1
\v 17 Haramara hepaɨ ne'aurie mepɨhɨne tukarikɨ,  
\q2 mekaneniukurarutɨiya yemekɨ.   
\q1
\v 18 Pekaneniunawairieni nehamikuma meta waɨkawa nemɨwanaki'erie,  
\q2 hikɨ yɨriya hamatɨa xeikɨa tekaniyunaki'erieka.   
\c 89  
\d 'Etani 'ɨkitsikaya 'etsirahi tewiyari.  
\q1
\v 1 Yawé 'aku, yuheyeme nepikwikani  
\q2 'anaki'eriya mɨmariwe,  
\q1 yuheyemekɨ nepikuxatani ke'aixɨa pemɨtikamie.   
\q1
\v 2 Mɨpaɨ nepaineni 'anaki'eriya heitserie 'amuyeikakɨ,  
\q2 yapehaitɨ ke'aixɨa pemɨtikamie muyuawi yamɨtiuyema hetsie.   
\b  
\q1
\v 3 Mɨpaɨ peputayɨ: «Ne tɨratu nepuwewi nemenayexei hamatɨa,  
\q2 Rawiri mɨpaɨ yurikɨ nepɨtiutahɨawixɨ neti'uximayatsiriwame:   
\q1
\v 4 “'Anuiwari yunaitɨ te'aitamete nepɨwarayeitɨani,  
\q2 meta yanepaine 'a'uweni 'amuwenikɨ yuheyemekɨ”».   
\b  
\q1
\v 5 Yawé, mariweme kepemɨtiyuriene muyuawi peyexeiya,  
\q2 meta ke'aixɨa pemɨtikamie memɨpatsie mepeyexeiya.   
\q1
\v 6 ¿Kemɨ'ane muyuawitsie Yawé hepaɨ pɨ'ane?  
\q2 ¿Kemɨ'ane muyuawitsie 'uyeikatɨ Yawé hepaɨ pɨ'ane?   
\q1
\v 7 Kakaɨyari waɨkawa pumakaxiwa memɨpatsie memayuxeɨrietsie,  
\q2 pɨmariwe yemekɨ 'amemu'uwa 'auriena wahetsiemieme.   
\q1
\v 8 Xewitɨ 'ahepaɨ 'anetɨ pumawe Yawé Kakaɨyari Naimekɨpemɨtɨrɨkaɨye,  
\q2 tɨrɨkariya pemexeiya meta 'aixɨa pemɨtikamie.   
\b  
\q1
\v 9 'Ekɨ pepɨti'aita hamewari mɨtɨrɨkaɨyetsie,  
\q2 'ekɨ kayuwatɨ pepipitɨa hamewari muyuane.   
\q1
\v 10 Xahawi peputapɨnaxɨ mɨki hepaɨ,  
\q2 'atɨrɨkariyakɨ pepɨwareutaxɨriexɨa memɨmetsi'aye'unie.   
\q1
\v 11 'Ahetsie pɨmieme muyuawi, meta pɨti'apiini kwie,  
\q2 'ekɨ kwie peputawewi meta naitɨ hetsiena mɨtixuawe.   
\q1
\v 12 'Ekɨ tayeta meta tatsutɨa peputiwewi,  
\q2 Tawuxi meta Heximuni hɨriyarite mepɨmetsikwika yutemawierima.   
\q1
\v 13 'Amamatekɨ mariweme pemɨtiuyurieni pepɨyɨwe,  
\q2 pepɨtɨrɨkaɨye pepɨrayu'iwa yemekɨ.   
\b  
\q1
\v 14 'Aixɨa mɨti'ane meta tita mɨtiheitserie mɨkɨ 'a'uweni pɨtsutɨmeyari,  
\q2 meta 'aniukamete mepɨhɨkɨ naki'eriya meta yuri mɨraine.   
\q1
\v 15 'Aixɨa meke'itɨarieka memɨmetsihahiwiwa temawierikakɨ, Yawé,  
\q2 meta 'ahekɨariyatsie memuhu,   
\q1
\v 16 kemɨ'ane tukarikɨ 'ahetsiemieme memuyutemamawie  
\q2 meta memetsi'ayexeiyatɨ heitserie pemexeiyakɨ.   
\q1
\v 17 'Ekɨtsɨ watɨrɨkariya witsipemɨ'ane pekanihɨkɨtɨni wahetsiemieme,  
\q2 mɨpaɨ mɨmatinakekɨ waɨkawa tɨrɨkariya pepɨtatsipitɨa.   
\q1
\v 18 Yawé, 'ekɨ tepɨa tahetsie nunuwame pepɨhɨkɨ,  
\q2 'ekɨ, 'Ixaheri hetsie pemɨpatsie, petati'aitɨwame pepɨhɨkɨ.   
\b  
\q1
\v 19 Heiwa 'ekɨ 'ateɨterima pepɨtiwarutaxatɨa heinɨtsi hepaɨ 'anemekɨ,  
\q2 mɨpaɨ pepɨtiwarutahɨawixɨ 'ateɨterima yamemɨtekahu:  
\q1 «Ne nekaniparewieka xeime waɨkawa meuyutamiewe,  
\q2 xeime tewi 'aixɨa nemɨtixeiya hetsiena mieme 'aixɨa nepaine.   
\q1
\v 20 Rawiri nekaniutaxeiya, neti'uximayatsiriwame,  
\q2 nekanikawirieni ne'atseiti mɨpatsiekɨ.   
\q1
\v 21 Nemamá yuheyemekɨ pituikani,  
\q2 netɨrɨkariya pitatɨrɨkariya.   
\q1
\v 22 Meye'unie pɨkahe'iwani meta pɨkatita'aitɨani mɨtiyukutuayanikɨ,  
\q2 xewitɨ tɨma 'axamɨtiuka'iyari pɨkatita'aitɨani.   
\q1
\v 23 Kemɨ'ane memitamieni ne nepuwatipɨna,  
\q2 kemɨ'ane memitixani'erieni ne nepuwaka'una.   
\q1
\v 24 Nenaki'eriya ke'aixɨa mɨtikamie hamatɨana puyeikani,  
\q2 tɨrɨkariyaya nehetsiemiemekɨ 'aixɨa pɨraniuwani.   
\q1
\v 25 Ne tɨrɨkariya nekanipitɨamɨkɨ haramaratsie mɨti'aitanikɨ,  
\q2 meta haa muyehapanetsie mɨtiwa'aitɨakakɨ.   
\q1
\v 26 Mɨkɨ mɨpaɨ kanetinitahɨawimɨkɨ: “'Ekɨ ne'ukiyari pekanihɨkɨtɨni,  
\q2 nekakaɨyari, ne'ai netsiwikweitsitɨwame”.   
\q1
\v 27 Ne neniwe matɨari mieme heitserie nekanipitɨamɨkɨ,  
\q2 mexɨakame kanayeimɨkɨ te'aitamete kwiepa memɨtama wahetsie.   
\q1
\v 28 Nenaki'eriya hetsiena mieme yaxeikɨa kani'anekamɨkɨ,  
\q2 tɨratu ketemɨtehexeiya mɨkɨmatɨa yaxeikɨa kani'anekamɨkɨ.   
\q1
\v 29 Nuiwarimama memɨteta'aitakɨ 'aixɨa nekaniwayurimɨkɨ meta 'uwenieya  
\q2 yuheyemekɨ, mexi 'akuxi muyuawi 'a'uyemaka.   
\b  
\q1
\v 30 »Peru xɨka niwemama ne'aitsika me'uku'eirieni  
\q2 meta kenemaine mɨpaɨ xɨka mekate'u'uwani,   
\q1
\v 31 xɨka me'iku'eirieni ne'aitsika  
\q2 meta xɨka mekaheitixeiyaxɨani kenemɨtiu'ai,   
\q1
\v 32 kɨyekɨ nekatiniwakwinitɨamɨkɨ 'axamemɨte'uyurikɨ  
\q2 meta nekaniwatiwamɨkɨ yamemɨkatekakɨkɨ.   
\q1
\v 33 Tsepa yamemɨkatekakɨ, nepɨkawahayewa newanaki'erietɨ,  
\q2 meta kenemɨtiwarutahɨawixɨ pɨkareuyeweka.   
\q1
\v 34 Netɨratu 'axanepɨkayurieni,  
\q2 kenemutayɨ nepɨkahetɨmaiya.   
\q1
\v 35 Xeimieme xeikɨa yanepaine nemɨpatsiekɨ,  
\q2 meta Rawiri nepɨkati'itaiya:   
\q1
\v 36 Nuiwarimama yuheyeme nepɨwa'ɨwiyani,  
\q2 'uwenieya 'apuweni tau hepaɨ pɨreutere nehɨxie.   
\q1
\v 37 Metsa hepaɨ, 'aixɨa mɨtiuka'iyari mɨtaniere muyuawitsie,  
\q2 mɨpaɨ 'apuweni yuheyemekɨ».   
\b  
\q1
\v 38 Peru neuxei 'ekɨ pepeihɨa, pemenayexei pepɨka'utanaki'eri,  
\q2 pepuyeha'a hamatɨana waɨkawamekɨ.   
\q1
\v 39 Pepihayewaxɨ 'atɨratu meti'uximayatsiriwame hamatɨa,  
\q2 kwiepa pepihaxime kurunaya.   
\q1
\v 40 Kuraruya naime pepa'unatɨya,  
\q2 yeuta puyuhayewaxɨ kiiya 'amɨpapa.   
\q1
\v 41 Yunaitɨ mana memuyekɨka mepɨte'inawatsirie,  
\q2 'auriena kiekatari mepiyuriya.   
\q1
\v 42 'Aixɨa pepaine memeye'unie watɨrɨkariya hepaɨtsita,  
\q2 temawierikakɨ pepɨwarutihɨniyaxɨ memeye'unie.   
\q1
\v 43 'Ixiparaya pepatatamɨraxɨ,  
\q2 meta pepɨka'iparewi muyumienekaitsie.   
\q1
\v 44 Mɨmariwekai mana pepɨti'atɨiri  
\q2 'uwenieya kwiepa pe'atihɨaka.   
\q1
\v 45 Temaikɨtɨme kwitɨwa 'ukiratsi pepayeitɨa,  
\q2 pepitewiyatsitɨa.   
\b  
\q1
\v 46 Yawé, ¿kepaukake pepɨtihayewa peyu'awietanetɨ?  
\q2 ¿Tai hepaɨ tiutatawetɨ 'ahaxɨa yuheyemekɨ?   
\q1
\v 47 Mɨpaɨ ketinemaika netukari 'apɨkatiteriwe.  
\q2 'Imatɨrieka, ¿titayari memukwiwawe petiwarutiwewi?   
\q1
\v 48 ¿Kemɨ'ane 'apuyeika kamɨnike,  
\q2 yatɨni yɨwetɨ muwatiyanikɨ teukiyapa?   
\q1
\v 49 Tati'aitɨwame, ¿hakewari 'anaki'eriya meripai mieme,  
\q2 Rawiri kepemɨtiutahɨawixɨ yapetikamietɨ?   
\q1
\v 50 Tati'aitɨwame, kenaye'eri te'a'uximayatsiriwamete kememɨtenanaimarie,  
\q2 meta ne'iyaritsie hipame teɨteri watierika kenemɨrexeiya.   
\q1
\v 51 Yawé, memɨmetsi'aye'unie mepɨtatsinanaima,  
\q2 kemɨtiumie 'axamepɨte'ikɨhɨawe pemenayexei.   
\b  
\q1
\v 52 'Aixɨa ke'itɨarieka Yawé yuheyemekɨ.   
\qc 'Aixɨa pɨ'ane, 'aixɨa pɨ'ane.  
\c 90  
\s1 XAPA 4  
\r Nɨawari 90-106  
\d Muitsexi nenewierieya, Kakaɨyari nɨ'arieya.  
\q1
\v 1 Ti'aitame, 'ekɨ tatsi'awiwietame pepɨhɨkɨ  
\q2 tsepa tanuiwari memanuyekɨka.   
\q1
\v 2 Hɨri katinunuiwawekaku  
\q2 meta kwie pekatawewiwekaku,  
\q1 meripaitɨtɨ  
\q2 metatsiere 'uxa'a warietɨni,  
\q2 'ekɨ Kakaɨyari pepɨhɨkɨ.   
\b  
\q1
\v 3 'Ekɨ yapepɨtiyuriene teɨteri tumuanari memakɨkanikɨ,  
\q2 kepauka mɨpaɨ pemutaine: «Xemɨkwiwawe, tumuanari xeke'akɨne».   
\q1
\v 4 Xeimiriyari xɨka 'anuyeyani, 'ahetsiemieme, xeitukari hepaɨ pepɨtixeiya,  
\q2 tɨkarikɨ yapaɨmexɨa hurayari maye'axeni hepaɨ pepɨtixeiya.   
\q1
\v 5 Pepɨwarakumaweriya teɨteri. Heinɨtsika hepaɨ mepɨ'ane.  
\q2 Ximeri mepɨtinunuiwa, tupiriya hepaɨ   
\q1
\v 6 ximeri witsi'anetɨ yɨratɨ mɨtineika  
\q2 taikaita 'ari pɨyɨna pɨwaki.   
\b  
\q1
\v 7 'Ahaxɨa yurikɨ pɨtatsikwa'a,  
\q2 pemɨha'akɨ pepɨtatsimariuta.   
\q1
\v 8 'Ahɨxie tita 'axatemɨte'uyuri pepɨtixeiya,  
\q2 'ahekɨaripa pɨti'ane 'axatemɨte'uyuri ketemɨte'anukanama.   
\q1
\v 9 'Ahaxɨakɨ tatukari peyeika naitɨ,  
\q2 xei'itukariyari pɨreutetere tawiyari ketemɨteheutetere.   
\q1
\v 10 Hipatɨ haika tewiyari heimana tamamata wiyari mepɨtihipite,  
\q2 heiwa tepanuti'axe nauka tewiyari wiyari,  
\q2 xɨka tɨrɨkariya 'akuxi tehexeiyani.  
\q1 'Apɨpaɨme mɨkɨ wiyari, mɨyatɨtɨ,  
\q2 waɨkawa 'uximayatsika pɨtiuyɨne meta 'uximatɨarika:  
\q2 yapauka kananuyekɨkani, tameta wahamatɨa tekaniuhuni.   
\b  
\q1
\v 11 ¿Kemɨ'ane 'ahaxɨa mɨtɨrɨkaɨye petimaiwe?  
\q2 'Ahaxɨa pɨmariwe ketemɨteheumama temetsimakaxetɨ.   
\q1
\v 12 Ketatineuta'ɨkitɨa tatukari 'aixɨa 'anemekɨ temɨ'inɨatanikɨ,  
\q2 ta'iyari mɨtimaiwenikɨ.   
\b  
\q1
\v 13 Yawé, ¿kepauka tahetsɨa pepɨnuani?  
\q2 Keniwanenimayaka mate'uximayatsiriwamete.   
\q1
\v 14 'Anaki'eriyakɨ ketanehɨniyani ximeri,  
\q2 kepaɨmexɨa tukari temu'uwani teputikwikani teyutemamawietɨ.   
\q1
\v 15 Kepaɨmexɨa wiyari temɨte'uka'eniwakai petatsihiweritɨatɨ,  
\q2 mɨkɨ tukari hikɨ temawierika pɨta kenayeitɨa.   
\q1
\v 16 Yaketatineuxeiyatsitɨa 'a'uximayatsikakɨ,  
\q2 witsikepemɨ'anekɨ tanuiwarite wahetsiemieme.   
\b  
\q1
\v 17 Tati'aitɨwame takakaɨyari  
\q2 ketatsiparewieka.  
\q1 'Aixɨa kenaineni ta'uximayatsika hetsiemieme,  
\q2 huu, 'aixɨa kenaineni ta'uximayatsika hetsiemieme.   
\c 91  
\q1
\v 1 Kemɨ'ane 'Amutewi hetɨa muyu'awieta  
\q2 'akaniuyeikamɨkɨ Naimekɨmɨtɨrɨkaɨye 'i'etɨriwiyakaku.   
\q1
\v 2 Yawé ne mɨpaɨ nepɨrahɨawe:  
\q2 «'Ekɨ 'ahetsɨa nemɨne'awieta pepɨhɨkɨ, 'ahetsie nemɨtiwiya,  
\q2 Kakaɨyari kemɨ'ane yuri nemɨti'eririe netsiparewiekaku».   
\b  
\q1
\v 3 Mɨkɨ xeikɨa metsi'uxɨna pɨyɨwe tiyumemiwame winiyarieyatsie  
\q2 meta kwiniya mɨtiyumemiwatsie,   
\q1
\v 4 metsɨ yu'anakɨ kamenanukanakamɨkɨ  
\q2 meta 'anateyatɨa muyuti'awieta pɨyɨwe.  
\q2 Yuri kemaine, mɨkɨ 'ahetsie nunuwame payani.   
\q1
\v 5 Tɨkari mumariwetsie pepɨkaheumaka,  
\q2 meta 'ɨrɨkɨ tukarikɨ mɨtimɨiyanekɨ,   
\q1
\v 6 meta kwiniya 'etɨriyapa mɨtatsihupienekɨ  
\q2 meta tukarikɨ mɨɨya mɨwaka'unakɨ.   
\q1
\v 7 Tsepa xeimiriyari 'a'utata mukaxɨri,  
\q2 meta tamamata miriyari 'atserieta,  
\q2 peru 'ekɨ pepɨka'atiweni.   
\q1
\v 8 Yurikɨ pekaninierimɨkɨ,  
\q2 pekaniwaxeiyamɨkɨ Kakaɨyari memɨka'ayexeiya kepauka memɨte'akapitɨarieni.   
\b  
\q1
\v 9 Metsɨari Yawé hetsɨa pekaniyu'awietani,  
\q2 meta 'ahetsie nunuwame 'Amutewi kanihɨkɨtɨni,   
\q1
\v 10 nitixaɨtɨ 'uximatɨarika 'ahetsie pɨkatinuani,  
\q2 nitixaɨtɨ kwiniya 'akie pɨkatinuani.   
\q1
\v 11 Mɨkɨtsɨ yuniuki tuayamete kaniwatanɨ'amɨkɨ  
\q2 naime 'ahuyeta memetsi'ɨwiyanikɨ.   
\q1
\v 12 Mɨkɨ yumamatekɨ mekamenanukuhanikuni,  
\q2 pemɨkahekawautsenikɨ tetetsie.   
\q1
\v 13 Mayetsi watsata pepuyeikani,  
\q2 'ɨrawetsixi meta kuuterixi pepɨwatiketsini.   
\b  
\q1
\v 14 «Ne nepixɨna, mɨkɨ nehamatɨa muyeikakɨ,  
\q2 hetsiena nepunuaka, kenemɨtitewa mɨnetsimatekɨ.   
\q1
\v 15 Mɨkɨ pɨnetsitahɨawe, neta nepita'eiya,  
\q2 hamatɨana nepuyeikani kepauka 'uximatɨarika mexeiyani,  
\q2 nekanixɨnamɨkɨ 'aixɨa nekatinitahɨawimɨkɨ.   
\q1
\v 16 Waɨkawa wiyari nepipitɨani,  
\q2 newikweitsitɨarikatsie nepitemawieritɨani».   
\c 92  
\d Nɨawari xawatikɨ kwikarɨwame 'uxipiya tukaritsie.  
\q1
\v 1 Yawé, 'aixɨa pɨ'ane pamɨpariyutsi mɨmatsipitɨaka  
\q2 meta nɨawari mexeiyani 'ahetsiemieme, 'Amutewi 'aku,   
\q1
\v 2 meta 'anaki'eriya mɨmariwe mukuxatani ximeri,  
\q2 metatsiere ke'aixɨa pemɨtikamie tɨkarikɨ,   
\q1
\v 3 kanarite meta xaweri hayuanekaku,  
\q2 haripa hayuanekaku ketiutikwikatɨreni.   
\b  
\q1
\v 4 Yawé, 'ekɨ temawierikakɨ pepɨnetsihɨniya mariweme pemɨtiyurienekɨ,  
\q2 'ayumieme 'aixɨa nepaineni 'atɨrɨkariya 'uximayatsikaya hetsiemieme.   
\q1
\v 5 Yawé 'aku, waɨkawa pɨmamariwawe 'awewiya,  
\q2 meta pɨkayumatiwanɨa kepemɨtiku'eriwa.   
\q1
\v 6 Yuri memɨkate'erie 'atsimepɨkatemate,  
\q2 'atsimemɨkatemate mepɨkaheitimaitɨkɨka,   
\q1
\v 7 Kakaɨyari memɨka'ayexeiya tsepa memɨyɨra tupiriya hepaɨ,  
\q2 meta tsepa memutixutui,  
\q1 yuheyemekɨ mekaneuyehɨiyakuni.   
\q2
\v 8 Yawé, 'ekɨ xeikɨa yuheyemekɨ 'aixɨa pekatinahɨawarɨwamɨkɨ.   
\b  
\q1
\v 9 Yawé, yurikɨ mematsi'aye'unie,  
\q2 yurikɨ hekɨakamekɨ mekanikwikuni,  
\q1 metaxɨrietɨkaitɨ naitsarie  
\q2 mekanakɨnikuni 'axateyuruwamete.   
\b  
\q1
\v 10 Tuuru yeutanaka tɨrɨkariyaya pepɨnetsi'upitɨa,  
\q2 pepɨnetsi'ukawiri witsimu'ɨa 'aixɨa mɨ'anekɨ.   
\q1
\v 11 Nehɨxie memɨkaxɨrienikɨ memɨnetsi'aye'unie yapepɨtiuyuri,  
\q2 meta ne'enatɨ kepauka memɨkwi'iwarɨmenitsie.   
\b  
\q1
\v 12 Takɨ hepaɨ mepɨte'uxutuwe 'aixɨa memɨte'u'iyari,  
\q2 kariuxa Riwanu mieme hepaɨ mepɨte'uwawere.   
\q1
\v 13 Yawé kie me'etsietɨ,  
\q2 takakaɨyari takwana mepuxutu.   
\q1
\v 14 Tsepa memu'ukirawetsixi, meputixuxuawereni,  
\q2 yuheyemekɨ metɨrɨkawitɨ metsitsiɨrawitɨ.   
\q1
\v 15 Meke'ihekɨatani: «Yawé heitserie kanexeiyani,  
\q2 mɨkɨ ne'ai kanihɨkɨtɨni, hetsiena 'axamɨti'ane pɨtiumawe».   
\c 93  
\q1
\v 1 Yawé katini'aitani, witsi'aneme 'anakatɨtɨ,  
\q2 Yawé mariwemekɨ pɨyutikemaritɨa  
\q2 yɨtɨrɨkariya panakatɨ.  
\q1 'Aixɨa 'aneme kwie putawewi,  
\q2 hatsuaku pɨkakuyuitɨarieni.   
\q1
\v 2 Matɨari paitɨ 'uwenieya puyukake,  
\q2 meta 'ekɨ matɨari paitɨ yuheyemekɨ pepuyeika.   
\b  
\q1
\v 3 Yawé, kepauka waɨkawa haa muwayeneikatɨka  
\q2 waɨkawa 'utatɨrarɨkatɨ,  
\q2 kaniuyuaneni hamewarieya.   
\q1
\v 4 Peru Yawé, muyuawitsie pɨmariwe:  
\q2 waɨkawa tɨrɨkaɨyetɨ haa kemuyuane reuyeta,  
\q2 meta haramara hamewarieya kemɨkatitɨrɨkaɨye.   
\b  
\q1
\v 5 Yawé, 'aitsikaya hetsie temɨtewiyani 'aixɨa pɨ'ane,  
\q2 kiiya mɨpatsiekɨ 'aixɨa pɨ'itɨarie yuheyemekɨ.   
\c 94  
\q1
\v 1 Yawé, Kakaɨyari 'ekɨ tahetsiemieme pemɨtiwarakapitɨwa,  
\q2 Kakaɨyari tahetsiemieme pemɨtiwarakapitɨwa, pematsiɨkɨme kene'ayeitɨa.   
\q1
\v 2 Kenanukukexi, 'itsɨkame 'ikɨ kwieyaritsie pemɨti'aita,  
\q2 yaketiniwarakapitɨa kwinimieme memɨteyuti'ɨre.   
\q1
\v 3 Yawé, ¿kepaukake mepɨtehayewa  
\q2 Kakaɨyari memɨka'ayexeiya meyutemamawietɨ kememɨteyuriekɨ?   
\b  
\q1
\v 4 Yunaitɨ mɨkɨ 'axateyuruwamete mekanihɨkɨtɨni,  
\q2 niuki peraixi, meteyukatawe'erietɨ xeikɨa mekaniutiniukani.   
\q1
\v 5 Yawé, 'ateɨterima mepɨtiketsinarɨwa,  
\q2 waɨriyarika mepɨte'aitɨarie pemɨwaranayexei.   
\q1
\v 6 Wiuraxi mepɨwakuya, meta teewatari,  
\q2 metatsiere nutuite.   
\q1
\v 7 Mɨpaɨ me'utiyuatɨ: «Yawé pɨkaniere,  
\q2 Kakuwu Kakaɨyarieya 'atsipɨkatimate».   
\b  
\q1
\v 8 'Ikɨ xekeneuti'eniexɨa, teɨteri 'atsixemɨkatemate,  
\q2 ¿'atsixemɨkatemate kepaukari xepeiti'enietɨkɨne?   
\q1
\v 9 ¿Kamɨtsɨ kati'ena kemɨ'ane nakate mɨtatsihawewiriexɨa,  
\q2 meta kamɨtsɨ katiniere kemɨ'ane tahɨxite mutiwewi?   
\q1
\v 10 ¿Kamɨtsɨ kataranayewaxɨani kemɨ'ane nuiwarite mɨwaranayewaya  
\q2 meta kemɨ'ane 'ena kwiepa mɨ'ɨxatsita?   
\q1
\v 11 Yawé, teɨteri kememɨteyɨkɨhɨawe kaniwamaika,  
\q2 mɨpaɨ katinimaika kename tixaɨtɨ mekatehɨkɨ.   
\b  
\q1
\v 12 Yawé, keyutemawieka kemɨ'ane 'ekɨ pemanayewaya,  
\q2 kemɨ'ane 'ekɨ pemɨti'ɨkitɨa 'a'aitsikatsie,   
\q1
\v 13 minewienikɨ kayuwatɨ 'uximatɨarika tukariyari,  
\q2 mexi 'akuxi Kakaɨyari mɨka'ayexeiya putsuya wewiyaneni.   
\q1
\v 14 Yawé yuteɨterima pɨkawaku'eirieni,  
\q2 mɨwaranayexei pɨkawanutuita.   
\q1
\v 15 Xanetsika tita mɨtiheitserietsie katinitaxatamɨkɨ,  
\q2 kemɨ'ane 'iyari heitseriekame memexeiyani mɨkɨ mepenukuweiya.   
\b  
\q1
\v 16 Xewitɨ pɨkanetsi'uparewi kepauka Kakaɨyari memɨka'ayexeiya memɨnetsi'utamitsie.  
\q2 Nixewitɨ nehetsie nuatɨ 'axateyuruwamete pɨkawaraye'uniekai.   
\q1
\v 17 Xɨka Yawé kanetsi'uparewienike,  
\q2 yapauka nemɨme kayuwatɨ nepɨtihunikekai.   
\q1
\v 18 Yemekɨ 'aixɨa nekatixatawetɨ: «Nepekaharuarɨka»,  
\q2 Yawé, 'anaki'eriya 'upayeikakairi netsiparewienike.   
\q1
\v 19 Kepauka nehetsie 'iyaritɨarika waɨkawa mɨtixɨawekai,  
\q2 'anɨtɨarika ne'iyari pɨhɨniyakai temawierikakɨ.   
\b  
\q1
\v 20 'Ekɨ te'aitamete 'axamemɨte'u'iyari pepɨkawahamiku,  
\q2 'axa'anemekɨ memɨte'aita,   
\q1
\v 21 'aixɨa memɨte'u'iyari wahetsiemieme niuki 'axa'aneme memɨwewie,  
\q2 meta memuwakuya 'atsimemɨkate'u'iyari.   
\q1
\v 22 Yawé matsi nehetsie nunuwame pɨhɨkɨ,  
\q2 Nekakaɨyari kanihɨkɨtɨni, 'ai nemɨne'awitatsie.   
\q1
\v 23 Mɨkɨ 'axaxemɨte'uyurikɨ pɨtixe'akapitɨani  
\q2 meta 'axaxemɨteyuriekɨ pɨxeka'una,  
\q2 Yawé takakaɨyari pɨxekwini.   
\c 95  
\q1
\v 1 Xekenakɨni, Yawé tepɨtanɨawa teyutemamawietɨ,  
\q2 kwi tepehɨaweni 'ai tatsiwikweitsitɨwame.   
\q1
\v 2 Hɨxiena tepɨye'axeni pamɨpariyutsi te'ipitɨatɨ,  
\q2 kwi tepehɨaweni kwikarikɨ.   
\b  
\q1
\v 3 Yawé Kakaɨyari mɨmariwe mɨhɨkɨkɨ,  
\q2 Ti'aitame mɨmariwe kakaɨyarixi wahetsiemieme.   
\q1
\v 4 Mamayatsie pɨti'ane kwieta meukatewa,  
\q2 pɨtipiinieya hɨrite 'amanutitɨtɨ.   
\q1
\v 5 Haramara pɨtipiinieya, mitawewikɨ,  
\q2 yumamakɨ kwie putawewi.   
\b  
\q1
\v 6 Xekenakɨni, hɨxiena tepakatutsitaxɨani,  
\q2 tepɨtitunuma'uni  
\q2 Yawé hɨxie mɨtatsi'utawewi.   
\q1
\v 7 Mɨkɨ takakaɨyari mɨhɨkɨkɨ,  
\q2 tameta teɨterimama,  
\q2 muxatsimama tekanihɨkɨtɨni mɨtatsihɨ yukuraruta.  
\b  
\q1 Xɨka xeme hikɨ niukieya xe'u'enieni,   
\q2
\v 8 yu'iyari xepɨkatseiriyani, Meriwa mɨrakutewatsie kememuyɨ  
\q2 'iya tukaritsie hepaɨ, makumawetsie Matsaha xemu'uwakaitsie,   
\q1
\v 9 kepauka xepaapama memɨnetsi'uta'inɨataxɨ,  
\q2 menetsikwamanakutɨ,  
\q2 wahɨxie yanetiyurienekakutɨtɨ.   
\q1
\v 10 Huta tewiyari wiyari nepɨha'akai  
\q2 mɨkɨ nuiwari hetsiemieme,  
\q1 mɨpaɨ nekaniutayɨni: «Mɨkɨ teɨteri xeime pɨta huye mepuweiya,  
\q2 nehuye mepɨkamate».   
\q1
\v 11 Hikɨ neha'atɨ, mɨpaɨ neputayɨ:  
\q2 «Hatsuaku nehetsɨa mepɨkaye'axɨani hakewa nemɨwareka'uxipitɨanikekaitsie».   
\c 96  
\r (Nɨa 96:1-13 – 1Kem 16:23-33)  
\q1
\v 1 Yawé hetsiemieme xekeneutakwika kwikari hekwame,  
\q2 Yawé hetsiemieme xekenekwikani, teɨteri yunaitɨ kwiepa xemɨtama.   
\q1
\v 2 Yawé hetsiemieme xekenekwikani, xekenenɨawani,  
\q2 xekenekuxatani tukarikɨ kemɨrayu'iwa.   
\q1
\v 3 Nuiwarite watsata xekenekuxatani witsikemɨ'ane,  
\q2 meta mariwemekɨ kemɨtiyuriene xekenekuxatani yunaime teɨteri watsata.   
\b  
\q1
\v 4 Kanimariweni Yawé, hetsiena pɨtinakeni witsimɨtikɨhɨawarɨwanikɨ,  
\q2 matsi waɨkawa makaxiwatɨ keyuri hipatɨ kakaɨyarixi.   
\q1
\v 5 Yunaitɨ nuiwarite wakakaɨyarixi tixaɨtɨ mepɨkatehɨkɨ,  
\q2 matsi Yawé muyuawi kaniutawewieni.   
\q1
\v 6 Xawatɨriyaya meta kemɨtimariwe niukametemama mekanihɨkɨtɨni,  
\q2 witsipɨtiuye'ane meta tɨrɨkariya kanixuaweni tukieya mɨpatsieta.   
\b  
\q1
\v 7 Yawé xeketeneyetuiri, yunaitɨ teɨteri,  
\q2 Yawé yaxeketeneutahɨawi witsikemɨ'ane meta kemɨtitɨrɨkaɨye.   
\q1
\v 8 Yawé yaxeketeneutahɨawi witsikemɨ'ane mɨmariwekɨ hetsiena mɨtinakenikɨ,  
\q2 xeketenemawirieka meta takwana xekeneutahakeni.   
\q1
\v 9 Yawé hɨxie xekenetitunuma'uweni tukieya mɨmariweta,  
\q2 yunaitɨ kwiepa xemɨtama xekenayemakaxeni.   
\b  
\q1
\v 10 Nuiwarite mɨpaɨ meke'utiyuaneni:  
\q2 «Yawé pɨti'aitame».  
\q1 Mɨkɨ kwie putawewi,  
\q2 hatsuaku pɨkakuyuitɨarieni.  
\q2 Mɨkɨ teɨteri wahetsie pɨti'aita heitseriemekɨ.   
\q1
\v 11 Muyuawi meta kwie xekeneyutemamawieka.  
\q2 Haramara ke'utayuaneni meta yunaitɨ mana memɨteye'uwa.   
\q1
\v 12 Naitɨ mɨraka'etsitɨre mukumane xeyutemamawietɨ xekeneutikwikani, meta yunaitɨ mana memɨtexuawe.  
\q2 Naitsarie kɨyexite hɨritsie meke'utikwikani.   
\q1
\v 13 Yawé hɨxie xekeneutikwikani, 'ukanamieniri.  
\q2 'Ukanamieniri kwiepa 'aixɨa tiyurienike.  
\q1 Kwiepa memɨtama kaniwataxanetamɨkɨ kemɨtiheitseriekɨ,  
\q2 meta teɨteri wahetsie yuri mainekɨ.   
\c 97  
\q1
\v 1 Yawé pɨti'aitame.  
\q2 Kwie keyutemawieka.  
\q2 Xekeneyutemamawieka kwie haramaratsie xemɨyetei.   
\b  
\q1
\v 2 Haiwitɨri 'anenetɨ yɨyɨwitɨ 'auriena kanatetɨkani,  
\q2 heitserie katinikuxatani yu'uwenitsie 'akaitɨ.   
\q1
\v 3 Tai hɨxiena 'anuyekaitɨ kaniumieni,  
\q2 memeye'unie mɨwatitaiya.   
\q1
\v 4 Mimierikayakɨ kwiepa kanakuhekɨkɨareni,  
\q2 'ixeiyatɨ kwie kaniwatayuaneni.   
\q1
\v 5 Yawé hɨxie, kwie naime mukutsiyari,  
\q2 hɨrite pɨtixɨrɨwe katira hepaɨ.   
\q1
\v 6 Muyuawi pikuxata heitserie kemɨrexeiya,  
\q2 yunaitɨ teɨteri mepixeiya kemɨtimariwe.   
\b  
\q1
\v 7 Meke'utewiyatsitɨarieni yunaitɨ kakaɨyarixi memɨwarayexeiya,  
\q2 kemɨ'ane memɨyuti'ɨre memɨkakakaɨyarixi wahekɨ.  
\q2 Yunaitɨ kakaɨyarixi hɨxiena xekeneukahɨxima'uti.   
\q1
\v 8 Yawé, heitserie kepemɨtiyurienekɨ,  
\q2 Tsiyuni mɨkɨ pɨti'enie mɨkɨkɨ puyutemawie,  
\q2 meta Kura kiekariyarite puyutemamawie.   
\q1
\v 9 'Ekɨ Yawé 'Apemutewi pemɨhɨkɨkɨ,  
\q2 kwiepa naitsarie pemɨti'aita.  
\q2 'Ekɨ matsi memɨkakakaɨyarixi wayeta yemekɨ pepɨkawe.   
\b  
\q1
\v 10 Yawé pɨwanaki'erie kemɨ'ane 'axamɨti'ane memɨxani'erie,  
\q2 'aixɨa memɨteyurie mɨkɨ watukari pɨ'ɨwiya,  
\q2 kepauka Kakaɨyari memɨka'ayexeiya memuwa'uximatɨa wahetsie kaninuaka.   
\q1
\v 11 Heitserie memexeiya hekɨariya wahetsie pɨ'axe,  
\q2 meta temawierika pɨ'axe kemɨ'ane yu'iyaritsie 'aixɨa memɨteyɨkɨhɨawe wahetsie.   
\q1
\v 12 Xekeneyutemamawieka Yawé hetsie, xeme teɨteri heitserie xemexeiya,  
\q2 meta 'aixɨa xekenaitɨkani hetsiena mieme kemɨtipatsie.   
\c 98  
\d Nɨawari.  
\q1
\v 1 Xekenekwikani Yawé hetsiemieme kwikari hekwame,  
\q2 mariweme mɨtiuyurikɨ.  
\q1 Yɨtɨrɨkariyakɨ, yumamá patsiekamekɨ,  
\q2 mɨwara'iwaxɨkɨ memeye'unie.   
\q1
\v 2 Yawé pitihekɨata kemɨrayu'iwaxɨkɨ,  
\q2 pɨtiwahekɨatɨa heitserie kemɨrexeiya nuiwarite wahɨxie.   
\q1
\v 3 Paye'eri naki'eriya kemɨrexeiya meta ke'aixɨa mɨtikamie,  
\q2 'ixaheritsixi teɨteriyari wahetsiemieme,  
\q1 yunaitɨ teɨteri kwiepa memɨtama yamepɨtemate  
\q2 takakaɨyari wikweitsitɨarikaya hetsiemieme.   
\b  
\q1
\v 4 Kwi xekenahɨaweni Yawé xeyutemamawietɨ,  
\q2 yunaitɨ kwiepa xemɨtama.  
\q2 Xekeneutikwikani xeyutemamawietɨ kwikari meta nɨawari.   
\q1
\v 5 Xekeneutikwikani nɨawari Yawé hetsiemieme haripa hayuanekaku,  
\q2 kanarikɨ meta kwikari witsihanɨyɨtɨkaime.   
\q1
\v 6 Kwi xekenahɨaweni Yawé xeyutemamawietɨ, Ti'aitame,  
\q2 pirikɨxa hayuanekaku meta kuxineta.   
\b  
\q1
\v 7 Haramara ke'utatɨrarɨkani meta yunaitɨ mana memɨteye'uwa,  
\q2 meta kwie, meta mana memɨtama.   
\q1
\v 8 'Aki haa 'amupapa muyehapane mekete'utahutsunani,  
\q2 meta hɨrite meke'utikwikani meyutemamawietɨ.   
\q1
\v 9 Yawé hɨxie xekeneutikwikani,  
\q2 'ukanamieniri kwiepa 'aixɨa tiyurienike.  
\q1 Kwiepa memɨtama wahetsie 'aixɨa katiniyurimɨkɨ,  
\q2 teɨteri wahetsie 'aixɨa 'anemekɨ katinita'aitamɨkɨ.   
\c 99  
\q1
\v 1 Yawé ti'aitame kanihɨkɨtɨni:  
\q2 nuiwarite meke'utiyɨyɨakani.  
\q1 Mɨkɨ yuteɨtamete watsata yu'uweni kaniukeka:  
\q2 kwie ke'utayuaneni.   
\q1
\v 2 Yawé kanimariweni Tsiyuni hetsie,  
\q2 meta kanimariweni yunaime teɨteri waheima.   
\q1
\v 3 'Aixɨa keraniuwani hetsiena mieme mɨmariwekɨ makaxiwatɨ:  
\q2 mɨkɨ kanipatsieka.   
\b  
\q1
\v 4 Ti'aitame pemɨtɨrɨkaɨye, 'aixɨa mɨti'ane pemɨtinaki'erie:  
\q2 'ekɨ mɨtiheitserie pepɨtiukaye  
\q2 meta Kakuwu hetsie 'aixɨa pepɨtiyuriene heitseriemekɨ.   
\b  
\q1
\v 5 Yawé hetsiemieme witsixekenaitɨkani mɨtakakaɨyari:  
\q2 hetɨana xekenetihɨxima'uweni:  
\q2 mɨkɨ kanipatsieka.   
\b  
\q1
\v 6 Muitsexi 'Aruni hamatɨa, mawari wewiwamete wahamatɨa mepaye'ukai,  
\q2 meta Tsamuheri, kemɨ'ane memehɨawekai wahamatɨa.  
\q1 Yawé meputahɨawixɨ, mɨkɨta pɨwaruta'ei,   
\q2
\v 7 haiwitɨritsie 'amuwekaitsie paitɨ kaniwarutahɨawe.  
\q1 Mekaneye'atɨani 'aitsikateya,  
\q2 'inɨari niukiyari mɨwayetuiritsie.   
\b  
\q1
\v 8 Yawé meta takakaɨyari, 'ekɨ pepɨwaruta'ei,  
\q2 'ekɨ wahetsiemieme Kakaɨyari petiwareuyehɨwirietɨ pepatɨa,  
\q2 meta kepauka pemɨwaru'uximatɨa 'axamete'uyurieku.   
\b  
\q1
\v 9 Yawé hetsiemieme witsixekenaitɨkani mɨtakakaɨyari:  
\q2 xekenayexeiyani tukitana:  
\q2 Kanipatsieka Yawé takakaɨyari.   
\c 100  
\d Pamɨpariyutsi nɨawariyari.  
\q1
\v 1 Kwixekenahɨaweni Yawé xeyutemamawietɨ, teɨteri kwiepa xemɨtama,   
\q2
\v 2 Yawé xekenayexeiyani yutemawierima.  
\q1 Hɨxiena xekeneti'uweni  
\q2 karima xe'utikwitɨ.   
\q1
\v 3 Yawé xekenemaika Kakaɨyari mɨhɨkɨkɨ,  
\q2 mɨkɨ pɨtatsi'utawewi, hetsɨana tepɨmiemete.  
\q2 Tepɨteɨterimama, tame muxatsimama tepɨhɨkɨ kuraruyata miemete.   
\b  
\q1
\v 4 Kiteniena xekeneutahaxɨa pamɨpariyutsi xe'ipitɨatɨ,  
\q2 xekeneu'axɨa takwana nɨawari hetsiena mieme xe'utikwitɨ,  
\q2 pamɨpariyutsi xekenepitɨaka, 'aixɨa xekenaitɨkani hetsiena mieme.   
\q1
\v 5 Yawé 'aixɨa katiniuka'iyarini meta naki'eriyaya hawaikɨ pɨkaheu'axe,  
\q2 'aixɨa katinikamieni yuheyemekɨ.   
\c 101  
\d Rawiri nɨawarieya.  
\q1
\v 1 Naki'eriya nepɨtakwika meta tita mɨtiheitserie:  
\q2 Yawé, nɨawari 'ahetsiemieme nepɨtikwika.   
\q1
\v 2 'Aixɨa netiyurienetɨ nepumienikeyu huye 'aixɨa mɨ'ane 'utɨma:  
\q2 ¿Kepauka pepɨnetsiha'iwatamie?  
\q1 Nekie 'anepukanikeyu  
\q2 'aixɨa netinekɨhɨawetɨ ne'iyaritsie.   
\q1
\v 3 Ne nepɨkayuta'iyaritɨani yanemɨtiyurienikɨ  
\q2 tixaɨtɨ 'axamɨti'ane hepaɨtsita mieme.  
\b  
\q1 Teɨteri kemɨtiheitserie yamemɨkateyurie nepɨwaxani'erie,  
\q2 naime nepɨtixani'erie kememɨteyurie.   
\q1
\v 4 Nehetsie naime nekatinehɨamɨkɨ 'axamɨti'ane,  
\q2 nehetsie munuani 'axamɨti'ane pɨkayɨweni.   
\b  
\q1
\v 5 Kemɨ'ane 'awie yu'iwa hepaɨtsita 'axamɨtayɨni,  
\q2 yuheyemekɨ ne kayuwatɨ nepipitɨani,  
\q1 kemɨ'ane mariweme mayuyeitɨwa meta timaiweme  
\q2 nepɨkayɨwe nemɨtinewiriekakɨ.   
\b  
\q1
\v 6 Kwi nepɨwaxeiyani 'iya kwiepa memɨtama 'aixɨa memɨte'u'uwa,  
\q2 nehamatɨa memu'uwanikɨ,  
\q1 nehetsiemieme xeikɨa mepɨte'uximayaka,  
\q2 kemɨ'ane wahetsie mɨkarahɨiwa.   
\b  
\q1
\v 7 Xewitɨ tɨma nekiita pɨka'ayekani,  
\q2 kemɨ'ane meteyukananaimatɨ 'amemu'uwa,  
\q1 meta pɨkayɨweni nehɨxie muyeikani  
\q2 xewitɨ 'itarikakɨ tikuxatatɨ.   
\b  
\q1
\v 8 Xeitukari manukayeikani nepɨkawapitɨaka 'amemu'uwani  
\q2 yunaime Kakaɨyari memɨka'ayexeiya kwiepa memɨtama,  
\q1 Yawé kiekarieyatsie nepɨwarayeweiya  
\q2 yunaime 'axateyuruwamete.   
\c 102  
\d Mɨtiuka'eniwa nenewierieya kanihɨkɨtɨni, mɨximetɨ, yutatuatɨ yuhiwerietɨ Yawé kemɨtiutahɨawixɨ.  
\q1
\v 1 Yawé, keneu'eni nenenewieri,  
\q2 'ahetsɨa keye'ani ne'iwaurika hiwariyari.   
\q1
\v 2 Neuxei kwerietɨ keneneuxeiya  
\q2 kepauka nemɨtiuka'eniwa.  
\q1 Kwi keneneu'eni,  
\q2 yapauka keneneuta'eiya kepauka nemetsihahɨawe.   
\b  
\q1
\v 3 Karikɨ kɨtsi hepaɨ netukari kanitiparikeni,  
\q2 ne'umete kanenikukwaxiyani tɨɨ hepaɨ.   
\q1
\v 4 Ne'iyari pɨkayɨweri meta 'iteɨri hepaɨ pɨtawaxime,  
\q2 metatsiere nepɨkareukwaimɨkɨ.   
\q1
\v 5 Waɨkawa karima nemuta'aiwakɨ  
\q2 kaniyɨweni ne'umete muti'inɨata.   
\q1
\v 6 Nekaneunutuixieka nɨpe yuxaɨta makumawetsie muyeika hepaɨ nekatiniyumaika,  
\q2 mikɨri hepaɨ nekatiniyumaika kiekari mu'uni tsata muyeika.   
\q1
\v 7 Nemeukuni nepɨkayɨweri,  
\q2 wiki yuxaɨta kii heima makaka hepaɨ nepɨtiyumate.   
\q1
\v 8 Tsepa kepauka memɨnetsi'aye'unie yuniukikɨ mepɨnetekwinitɨa,  
\q2 meta mekaneniutaterɨwani paitɨ kepauka 'axamemɨtiyuani.   
\q1
\v 9 Naxi xeikɨa kanine'ikwaitɨni,  
\q2 nemɨti'ie hamatɨa ne'ukai nekananuye'eni.   
\q1
\v 10 Pe'uyeha'aka waɨkawa,  
\q2 pepɨnetsi'anukuketɨa 'ariketa 'ateewa pepɨnetsiheukahɨani.   
\q1
\v 11 Netukari 'etɨri mɨyukupata hepaɨ pɨ'ane,  
\q2 tupiriya hepaɨ nepɨtayɨnarirɨme.   
\b  
\q1
\v 12 Yawé, 'ekɨ 'aheyemekɨ pekatini'aitani,  
\q2 yuheyemekɨ 'ekɨ 'apekatiniteriweni yunaime nuiwarite watsata.   
\q1
\v 13 Pekananukukemɨkɨ meta Tsiyuni pekanitinenimayatamɨkɨ,  
\q2 'ari mɨkɨ tukari kanaye'aniri pemitinenimayatatsie.  
\q2 Mɨkɨ tukari kemɨtiu'inɨaritsie kanaye'ani.   
\q1
\v 14 'Ahetsɨa miemete mate'uximayatsiriwamete mekanixɨamayaka kemɨtiuta'unekai,  
\q2 'unimeyari mexeiyatɨ mepinaki'erie.   
\b  
\q1
\v 15 Yawé mekanimakaxekakuni nuiwarite kwiepa memɨtama,  
\q2 te'aitamete kwiepa memɨte'aita yunaitɨ mekanimaikakuni kemɨtimariwe.   
\q1
\v 16 Karikɨ Yawé Tsiyuni tawarita kanihekwatɨamɨkɨ,  
\q2 meta kemɨtitɨrɨkaɨye matsiɨkɨtɨ kanayeimɨkɨ.   
\q1
\v 17 Memɨyuhiwerie wanenewieri pe'enietɨ pekanayeimɨkɨ,  
\q2 kememɨmetewawirieka tsiepɨre pepɨraye'atɨwani.   
\q1
\v 18 'Ikɨ keraka'utɨarieni 'iya memɨtinunuiwa wahetsiemieme,  
\q2 meta kiekari memɨnetɨarieni Yawé 'aixɨa meketehahɨaweni.   
\q1
\v 19 Yawé kanakaniere yutuki mɨmariweta 'ayekaitɨ,  
\q2 kwiepa naitsarie kanakuniere muyuawitsiepaitɨtɨ,   
\q1
\v 20 'ateewa memehapanie watsuari 'enienike  
\q2 meta mɨwaxɨnakɨ 'ari memɨkwi'iwarɨme,   
\q1
\v 21 meta Tsiyunitsie Yawé mukuxaxatsiwanikɨ  
\q2 meta Kerutsaremetsie mɨnɨawariekakɨ,   
\q1
\v 22 kepauka yunaitɨ teɨteri meta te'aitamete  
\q2 memɨyukuxexeɨriwa Yawé metahɨaweke.   
\b  
\q1
\v 23 'Ane'umiekaku Kakaɨyari netɨrɨkariya kaniutixɨtɨani,  
\q2 netukari 'etsikaniutipaɨmeriya.   
\q2
\v 24 'Ayumieme mɨpaɨ nekaniutayɨni:  
\q1 «Nekakaɨyari, pepɨkanetsihewitɨkɨni, netukari hixɨapa,  
\q2 'ekɨ 'aheyeme pepuyeika.   
\q1
\v 25 Tsɨtuapai 'ekɨ kwie pekaniunetɨani,  
\q2 meta muyuawi kani'awewiyatɨni.   
\q1
\v 26 Mɨkɨ mekaneuyewekuni, 'ekɨ peru 'apepuyeika.  
\q2 Naitɨ mɨkɨ katinitixɨmɨkɨ 'ixuriki hepaɨ.  
\q1 Meta kemari hepaɨ pepipataxɨani,  
\q2 huma pepeitawiwieni.   
\q1
\v 27 'Ekɨ peru yaxeikɨa mɨkɨ pepɨhɨkɨtɨni,  
\q2 meta 'atukari hawaikɨ pɨkaheu'axe.   
\q1
\v 28 Mate'uximayatsiriwamete waniwema 'amepu'uwani,  
\q2 meta wanuiwarima 'amepu'uwani 'ahɨxie».   
\c 103  
\d Rawiri nɨawarieya.  
\q1
\v 1 Ne'iyarikɨ Yawé nepɨnɨawani,  
\q2 ke'inɨawani naitɨ newaiyari patsietɨ kemɨtitewakɨ.   
\q1
\v 2 Ne'iyarikɨ Yawé nepɨnɨawani,  
\q2 meta nepɨkaratɨtɨmaiyani 'aixɨa kemɨtiyuparewiwakɨ.   
\q1
\v 3 Mɨkɨ pɨmereuyehɨwirie naime 'axakepemɨtiuyuri  
\q2 meta kepemɨtiuka'eniwa naime 'aixɨa kameniyurieka,   
\q1
\v 4 mɨkɨ pitawikweitsitɨwa 'atukari mɨkite watsata  
\q2 meta metsinaki'erietɨ payeika meta metsinenimayatɨ,   
\q1
\v 5 mɨkɨ waɨkawa pɨmetsiparewie pe'uyeikakaku tita pemɨreuyehɨwa  
\q2 meta kwixɨ hepaɨ pɨmetsihekwariya metsitɨrɨkariyatɨ.   
\b  
\q1
\v 6 Yawé kemɨtiheitserie yapɨtiyuriene  
\q2 meta memɨnanaimarie wahetsie kaninuaka.   
\q1
\v 7 Muitsexi yuhuye kaniuxeitsitɨani,  
\q2 'ixaheritsixi kaniwarutahekɨatɨani yu'uximayatsika.   
\b  
\q1
\v 8 Yawé 'aixɨa katiniuka'iyarini meta katiniyukanenimayaka,  
\q2 yapauka pɨka'uyeha'arɨwe meta waɨkawa naki'eriya pexeiya.   
\q1
\v 9 Yapɨkatarate'a tukarikɨ  
\q2 meta yuheyeme tatsihekatɨ pɨkahayeika.   
\q1
\v 10 Ke'axatemɨte'uyuri mɨpaɨ yeme pɨkatatsiyuriene  
\q2 meta mɨpaɨ pɨkatarakapitɨwa ke'axatemɨte'uyuri.   
\q1
\v 11 Kanimariweni naki'eriyaya kemɨ'ane memeyemakaxe wahetsiemieme,  
\q2 taheima kemeutitewa hepaɨ.   
\q1
\v 12 Tita ke'axatemɨte'uyuri mɨkɨ 'ateewa katinewiwieni,  
\q2 kemeteewa tau manatineikatsie 'atsita makayuyuipiketsie hepaɨ.   
\q1
\v 13 Yawé waɨkawa pɨwanenimaya kemɨ'ane memeyemakaxe wahetsiemieme,  
\q2 nuariekame yuniwema wahetsiemieme kemɨtiuka'iyari hepaɨ.   
\q1
\v 14 Ketemɨte'u'iyari mɨkɨ katanimaika,  
\q2 katinimaika tame haxu temɨhɨkɨkɨ.   
\b  
\q1
\v 15 Tewi tupiriya hepaɨ kani'aneni,  
\q2 tukarieya pɨtixutuwe tuturi 'ɨtsita mieme hepaɨ:   
\q1
\v 16 kepauka mɨ'ekawarieni,  
\q2 pukumamawere huyerieyatɨma pɨkayukuhekɨkɨare.   
\q1
\v 17 Peru Yawé naki'eriyaya hawaikɨ pɨkaheu'axe,  
\q2 yuheyemekɨ pɨtiwiya kemɨ'ane memeyemakaxe wahetsie,  
\q1 waniwema meta mɨkɨ waniwema wahetsie 'aixɨa mɨti'ane puxuawe,   
\q2
\v 18 kemɨ'ane tɨratuya memaye'atɨa wahetsie  
\q1 meta meme'eriwa 'aitsikaya  
\q2 mɨpaɨ memɨteyuriekakɨ.   
\b  
\q1
\v 19 Yawé muyuawitsie yu'uweni kaniukakeni,  
\q2 kemɨti'aita yakatiniyɨaneni yunaime wahetsie.   
\b  
\q1
\v 20 Yawé xekenenɨawani, xeme niukieya tuayametemama,  
\q2 xemɨtɨrɨkawi niukieya xemaye'atɨa  
\q2 meta kemɨti'aita yaxemɨtekahu.   
\q1
\v 21 Yunaitɨ kuyaximama, Yawé xekenenɨawani,  
\q2 te'i'uximayatsiriwamete kemɨtinake yaxemɨtekahu.   
\q1
\v 22 Yawé xekenenɨawani, yunaitɨ keyupaɨmeme mɨxe'utawewi  
\q2 naitsarie mɨra'aita xemɨtama.  
\b  
\q1 Ne'iyarikɨ Yawé nepɨnɨawani.   
\c 104  
\q1
\v 1 Ne'iyarikɨ Yawé nepɨnɨawani.  
\b  
\q1 Yawé nekakaɨyari, 'ekɨ pepɨmariwe,  
\q2 witsi'aneme pepanakatɨ ti'aitame kamixaya.   
\q1
\v 2 Xawatɨmekɨ pekaneuyukunaka 'ixuriki tuxamekɨ hepaɨ,  
\q2 muyuawi peputaweraxɨ 'ixuriki hepaɨ.   
\q1
\v 3 Haiwitɨritsie 'akii 'amɨpapa peputiwewi  
\q2 meta hai 'akaxeta kuyaxa mieme pepayeitɨwa.  
\q2 'Ekɨ pekananutiyeixani 'eka 'anateyatsie.   
\q1
\v 4 'Eka 'aniuki tuayamete pepɨwarayeitɨwa,  
\q2 meta mimierika mepɨmate'uximayatsirie.   
\b  
\q1
\v 5 'Ekɨ kwie pekaniukamani tsutɨmeyaritsie,  
\q2 hikɨ mana hatsuaku pɨkahewatayuani,   
\q1
\v 6 haramarakɨ pepitikemaritɨa,  
\q2 meta haa hɨritsie puyuhayewaxɨ.   
\q1
\v 7 Peru 'ekɨ pewarutatieku haa mepekɨ,  
\q2 'aniuki yuariyaya me'u'enieka meputinautsaxɨ.   
\q1
\v 8 Hɨritsie mekanitiyune,  
\q2 mayeweweritsie kaniu'axɨani,  
\q2 hakewa 'ekɨ pemɨwaretanɨ'a.   
\q1
\v 9 Hakewa memeuye'atɨkani pepɨwaru'inɨaritɨa memɨka'anuyekɨkanikɨ,  
\q2 tawarita hatsuaku kwie naime mepɨka'anukanani.   
\b  
\q1
\v 10 'Ekɨ pekatiniyurieneni haixa  
\q2 haa muhapanenikɨ hɨritsie mayeweweritsie,  
\q2 meta yeuta muxuawenikɨ.   
\q1
\v 11 Mɨkɨtsie yunaitɨ yeutari meputihareweni,  
\q2 muwa puxuri yeutari witsimekatenihareka.   
\q1
\v 12 Taheima memu'uwa wikixi mekaniyu'ituatɨaka haa 'aurie  
\q2 meta mekaniutikwikani kɨyexi xawaritsata.   
\q1
\v 13 Taheima 'akie paitɨtɨ hɨrite pepɨhatuiya,  
\q2 kwie 'a'uximayatsikakɨ 'aixɨa pɨreu'erie.   
\q1
\v 14 Tupiriya pepɨyɨratɨa tewaxi wahetsiemieme,  
\q2 meta 'iteɨrite teɨteri memika'etsa  
\q2 kwiepa timieme yu'ikwai memɨtehexeiyanikɨ:   
\q1
\v 15 kaxie winuyari 'iyari mɨtemawieritɨawe,  
\q2 hatseiti meta yuhɨxie mieme mayemerɨkaɨyenikɨ,  
\q2 meta 'ikwai memayenenierenikɨ.   
\q1
\v 16 Yawé kɨyexiteya 'aixɨa katinehatuiyarieka,  
\q2 kariuxa kɨyeyari Riwanu paitɨ mika'e.   
\q1
\v 17 Mɨkɨtsie wikixi mepuyu'ituatɨa,  
\q2 huku 'amutɨtɨtsie kwaxuri 'amemɨnene mekaniyukitɨaka.   
\q1
\v 18 Hɨri 'amanutitɨtɨtsie tsipuri yeutari mekaniu'uwani,  
\q2 meta 'aita mekaneixeiyani yu'awiwietame haitsɨrixi.   
\b  
\q1
\v 19 'Ekɨ metsa pekaniutawewieni, mi'inɨatanikɨ xeimetseri hetsiemieme.  
\q2 Metatsiere tau, mɨtimate kepauka makayuyuipike.   
\q1
\v 20 'Ekɨ yɨriya pekani'atɨwani, kani'axeni,  
\q2 hikɨ mɨkɨ tɨkaritsie yutawima memɨteku'uwa yeutari mekanewayekɨkani.   
\q1
\v 21 Mayetsi mepuyutihaxɨatɨwa, yu'ikwai meha'iwawatɨ,  
\q2 Kakaɨyari mewawirietɨ wa'ikwai mɨwaminikɨ.   
\q1
\v 22 Peru kepauka tau manatineikatsie mekanitakɨkani mekayuhekɨatakutɨ,  
\q2 yuterɨta mekaneutahakeni.   
\q1
\v 23 Hikɨ teɨteri mekanayekɨkani yu'uximayatsika menɨnike,  
\q2 meteta'uximayatake kepaukake mɨkɨyɨre.   
\b  
\q1
\v 24 Yawé 'aku, pɨtimɨire tita pemɨtiutiwewi.  
\q2 Mɨkɨ tinaime pepɨtiutiwewi petimaiwetɨ.  
\q2 Kwiepa kemakuyewa mekanihɨneni pemɨtiwarutiwewi.   
\q1
\v 25 Mana haramara kaniyemaka, 'a'atayeutɨ hawaikɨ kaheu'atɨ,  
\q2 hetsiena memɨtexuawe meteyumɨiretɨ, 'amemɨtepapa meta 'etsimemɨtepepe,  
\q2 kememɨteyupaɨme pɨkayɨwe mɨwaruti'inɨata.   
\q1
\v 26 Mana kanuwate 'amɨpapa kaniye'uwani meta mana kanikuyuaneni Rewiyatahini mɨmariwe,  
\q2 'ekɨ pemitawewi hamatɨana pemɨwaikanenikɨ.   
\b  
\q1
\v 27 Mɨkɨ yunaitɨ mekanita'ikwewani 'ahetsie  
\q2 pemɨtiwaminikɨ kepauka memɨtekwa'a.   
\q1
\v 28 'Ekɨ pepɨtiwayetuirie, mɨkɨta mepuka'itsana,  
\q2 kepauka 'amamakɨ pemɨtiwamikwa, mɨkɨ waɨkawa metehexeiyatɨ mepakɨka.   
\q1
\v 29 Xɨka pewaruhayewa, meputimamawe,  
\q2 xɨka wa'iiya pewarunawairieni mepɨtakukuwe meta tumuanari mepakɨka.   
\q1
\v 30 Xɨka 'a'iiya pehanɨ'ani, tawarita mepɨtixuawere,  
\q2 meta mɨpaɨ kwie naitɨ puyuhekwatɨani.   
\b  
\q1
\v 31 Yawé kepemɨtimariwe yuheyemekɨ mɨpaɨ peke'aneni,  
\q2 Yawé keyutemawieritɨaka tita mɨtiutawewi hetsiemieme.   
\q1
\v 32 Mɨkɨ kwie kanixeiyani meta kanitayuitɨwani,  
\q2 hɨri kanikumaɨwani meta kɨtsi kaniwatinenetɨwani.   
\b  
\q1
\v 33 Yawé nenɨawatɨ nepayani kenemɨreutere,  
\q2 nekakaɨyari nɨawarieya neputikwikani mexi 'akuxi ne'ayeniereni.   
\q1
\v 34 Keyutemawieka kenemɨtiku'eriwakɨ,  
\q2 netsitɨ, nekaniyutemawieka Yawé hetsiemieme.   
\q1
\v 35 'Axateyuruwamete kwiepa meke'akumawere,  
\q2 tawariri mepɨka'u'uwani.  
\b  
\q1 Ne'iyarikɨ Yawé nepɨmetsinɨawani.  
\b  
\q1 Yawé kenɨawarieka.   
\c 105  
\r (Nɨa 105:1-15 – 1Kem 16:8-22)  
\q1
\v 1 Pamɨpariyutsi Yawé xekenepitɨaka, mɨkɨ xekenahɨaweni,  
\q2 yunaime nuiwarite wahetsɨa 'uximayatsikaya xekenehekɨatani.   
\q1
\v 2 Xekenekwikani, nɨawarieyakɨ xekeneyutemamawieka,  
\q2 naime mariweme kemɨtiuyuri mɨkɨ xeketenekuxatani.   
\q1
\v 3 Yemekɨ xekeneuyuti'ɨreni patsiekamekɨ kemɨtitewakɨ hetsiemieme,  
\q2 Yawé memɨkuwautɨwe wa'iyari keyutemamawieka.   
\q1
\v 4 'Ahurawa xekeneɨkɨni Yawé hetsɨa meta tɨrɨkariyaya hetsɨa,  
\q2 xepɨkatehayewani xe'ikuwaɨtɨwetɨ.   
\b  
\q1
\v 5 Xekenaye'eriwani mariwemekɨ kemɨtiuyuri,  
\q2 'inɨari kemɨtiuwewi, meta 'aitsika ke'aneneme mɨyetua.   
\q1
\v 6 Xeme, 'Apɨrahami xiɨyarimama, mɨkɨ Kakaɨyari ti'uximayatsiriwame.  
\q2 Xeme, Kakuwu niwemama, Kakaɨyari mɨxe'anayexei.   
\q1
\v 7 Mɨkɨ Yawé kanihɨkɨtɨni, tame takakaɨyari,  
\q2 'ena kwiepa naitsarie 'aitsikaya kanixuaweni.   
\b  
\q1
\v 8 Mɨkɨ yutɨratu yuheyemekɨ pa'eriwa,  
\q2 kemutayɨ yuniukikɨ xeimiriyari nuiwariyari wahetsiemieme.   
\q1
\v 9 Mɨkɨ kanihɨkɨtɨni tɨratu 'Apɨrahami hamatɨa muwewi,  
\q2 'Itsahaki hamatɨa kemɨtiuyuhɨritɨa.   
\q1
\v 10 Kakuwu yakatiniutahɨawe 'aitsika kaneyeitɨirieni,  
\q2 'Ixaheritsixi wahetsiemieme tɨratu yuheyeme mieme kanayeitɨani,   
\q1
\v 11 kepauka mɨpaɨ mutayɨ: «Kanani kwieyari nekameniyetuiriemɨkɨ,  
\q2 piinitɨarika 'ahetsie mɨtinakenikɨ».   
\b  
\q1
\v 12 Kepauka 'akuxi temɨkayumuirekai,  
\q2 teewanarixi tekanihɨkɨtɨkaitɨni yakɨ teyupaɨmetɨ mɨkɨ kwieyatsie,   
\q1
\v 13 ku'uwamete mekanihɨkɨtɨkaitɨni tsepa kemɨ'ane kwieyaritsie,  
\q2 meta tsepa kemɨ'ane te'aitamete wahetsɨa,   
\q1
\v 14 xeime pɨka'upitɨa waɨriyarika mɨtiwata'aitɨanikɨ,  
\q2 matsi wahetsiemieme te'aitamete kaniwarutatieni:   
\q1
\v 15 «Neteɨterima nemuwaranayexei xepɨkawa'uximatɨaka,  
\q2 Neniukamete xepɨkatewakwinitɨaka».   
\b  
\q1
\v 16 Kakaɨyari haakaxa kanayeitɨani mɨkɨ kwieyaritsie  
\q2 tɨriku kaneuyehɨani naime.   
\q1
\v 17 Peru mɨkɨ wahɨxie xeime kanenɨ'ani:  
\q2 Kutse titewakame, waɨriyarika ti'uximayatame hepaɨ kaniutuiyani.   
\q1
\v 18 'Ɨkateyatsie tepɨa mepeiwɨtɨiriexɨa,  
\q2 panutahɨiyakai yukɨipitɨa tepɨa patekakai.   
\q1
\v 19 Kepaukake maye'a kemutayɨ kemɨtiyɨnikekai,  
\q2 'ana Yawé niukieya matsiɨkɨtɨ patɨa kename yuritɨkai.   
\q1
\v 20 'Ana ti'aitame katiniuta'aita mɨxɨnarienikɨ,  
\q2 teɨteri mɨtiwa'aitɨakai kaniwayeyepieni.   
\q1
\v 21 Ti'aitame kaneyeitɨani yukie naime hepaɨtsita  
\q2 meta tita mɨrexeiyakai katinihɨritɨani,   
\q1
\v 22 kanipitɨani mana kemɨ'ane memɨmexɨakate mɨtiwati'ɨkitɨanikɨ,  
\q2 meta kemɨtimaiwekai 'ukirawetsixi mɨtiwakuxaxatɨwanikɨ.   
\b  
\q1
\v 23 Hikɨ 'Ixaheri 'Ekipitu paitɨ kaninuani,  
\q2 Kakuwu teewatanaka pɨhɨkɨtɨkai Kami kwieyatsie.   
\q1
\v 24 Yawé yapɨtiuyuri memɨtamɨirekɨ teɨterimama  
\q2 yumɨireme pɨwarayeitɨa, memeye'uniekai matsi mepɨkayumɨirekai,   
\q1
\v 25 'ayumieme mepɨwaruyehekaxɨ teɨterimama  
\q2 meta te'i'uximayatsiriwamete mewananaimatɨ mepakɨ.   
\q1
\v 26 Hikɨ kaniwarutanɨ'ani Muitsexi  
\q2 meta 'Aruni, mɨkɨ muwaranayexei,   
\q1
\v 27 mɨkɨ 'inɨari mepuwewi watsata,  
\q2 mariweme mepɨte'uyuri Kami kwieyaritsie.   
\q1
\v 28 Yɨriya wahetsɨa kanenɨ'ani, mɨkɨ kwieyaritsie kanakuyɨre,  
\q2 peru mɨkɨ niukieya mepɨka'u'eni.   
\q1
\v 29 Haa wahetsɨa mieme xuriya payeitɨa  
\q2 tsapari meta mekaniukwini.   
\q1
\v 30 Naitɨ 'Ekipitu kwieyaritsie temutsi mekaniutaweni,  
\q2 te'aitamete wakiita paitɨ mepuxuawekai.   
\q1
\v 31 Kepauka Kakaɨyari mutaniu, naitsarie mɨkɨ kwieyaritsie meputixuawerixɨ,  
\q2 nakatarixi meyumɨiretɨ meta xaipɨtsi memɨteyukewe.   
\q1
\v 32 Wiyeri tee wiyeriyari pɨta kanayeitɨani,  
\q2 meta mimierɨkari waɨkawa mɨkɨ kwieyaritsie kanenɨ'ani,   
\q1
\v 33 naime kaxie haraweriyari kaniumura meta piní haraweriyari,  
\q2 naitsarie mɨkɨ kwieyaritsie kɨyexi katiniumure.   
\q1
\v 34 Kakaɨyari kepauka yamutayɨ, mekaniu'axɨani 'utsikari,  
\q2 mekayu'inɨatsinɨatɨ.   
\q1
\v 35 Tinaime mekateniutikwani tupiriya yɨrariyari xawariyari mɨkɨ kwieyaritsie,  
\q2 'etsaripa 'ikwaxi naime mekateneukuxɨxɨani.   
\q1
\v 36 Kaniwarukwini yunaime tɨɨri mexɨakate mɨkɨ kwieyaritsie miemete,  
\q2 tɨɨri 'aixɨa memɨ'anene mekaniukwini.   
\q1
\v 37 'Ixaheritsixi kaniwarayewitɨni huru me'utɨkɨme meta pɨrata,  
\q2 yunaitɨ mɨkɨ xiɨyari xewitɨ tɨma pɨkahekawe.   
\b  
\q1
\v 38 'Ekipitutari mepuyukatemamawi kepauka memayekɨ,  
\q2 memɨwamakaxekaikɨ 'ixaheritsixi.   
\q1
\v 39 Yawé haiwitɨrikɨ kaniwa'etɨriwiyakaitɨni,  
\q2 meta taikɨ yɨwikɨta kaniwahekɨariwiyakaitɨni.   
\q1
\v 40 Kepauka 'ikwai memuta'iwau, mɨkɨ xɨ'aurixi kaniwareyenɨ'airieni,  
\q2 'ikwai muyuawitsie miemekɨ kaniwarutihuxaitɨani.   
\q1
\v 41 'Ai kaneuyepieni, 'ana haa kananeni  
\q2 makumawetsie kaniuhanekaitɨni hatɨa hepaɨ.   
\b  
\q1
\v 42 Kakaɨyari yutɨratu mɨpatsie pɨkahatɨmai,  
\q2 'Apɨrahami mɨti'uximayatsiriwame hamatɨa miwewi.   
\q1
\v 43 Yuteɨterima kaniwarayewitɨni, muwaranayexei,  
\q2 waɨkawa temawierimakamekɨ meta temawierima me'utihiwame.   
\q1
\v 44 Kaniwayetuirieni nuiwarite wakwietɨkai,  
\q2 tita mana teɨteri memɨte'uka'etsakai wapiini pɨratɨa,   
\q1
\v 45 para yukakaɨyari 'aitsikaya memayexeiyanikɨ  
\q2 meta mɨpaɨ memɨte'u'uwanikɨ kemaitɨka.  
\b  
\q1 Yawé kenɨawarieka.   
\c 106  
\r (Nɨa 106:1, 47-48 – 1Kem 16:34-36)  
\q1
\v 1 Yawé kenɨawarieka.  
\b  
\q1 Pamɨpariyutsi xekenepitɨaka Yawé,  
\q2 mɨkɨ 'aixɨa mɨtiuka'iyarikɨ,  
\q2 naki'eriyaya mɨwaɨkawa hawaikɨ pɨkaheu'axe.   
\q1
\v 2 Xewitɨ pɨkayɨwe yemekɨ mikuxatanikɨ Yawé mariweme kemɨtiuyuri,  
\q2 yatɨni pɨkayɨwe minɨawanikɨ yemekɨ kemɨreuyewetse.   
\q1
\v 3 'Aixɨa meke'itɨarieka heitserie 'aixɨa memɨteyurie  
\q2 meta yuheyemekɨ kemɨtinake memɨteyurie.   
\q1
\v 4 Yawé, kenenaye'eri, kepauka pemɨwatinenimayata 'ateɨterima,  
\q2 kenaye'a kepauka tukari pemaye'atɨani wikweitsitɨarika pemɨtixuawitɨani.   
\q1
\v 5 Keneneupitɨa 'ateɨterima wahamatɨa nemuyeikani 'aixɨa 'iyari pemɨwapitɨanitsie,  
\q2 keneneupitɨa 'ateɨterima memuyutemamawiekatsie neta nemɨnetemawiekakɨ,  
\q2 meta nemɨmetsinɨawanikɨ pemɨwaranayexei wahamatɨa.   
\b  
\q1
\v 6 'Axatepɨte'uyuri, yaxeikɨa tapaapama wahepaɨ,  
\q2 'axatepɨte'uyuri meta 'axamɨti'ane waɨkawa tepɨte'uyuri.   
\q1
\v 7 Kepauka tapaapama 'Ekipitu memɨtitekatsie,  
\q2 mariwemekɨ kepemɨtiuyuri hetsiena yuri mepɨkate'uta'eri,  
\q1 ke'aixɨa pemɨtiuka'iyari 'aheyemekɨ mɨpaɨ mepɨkatehetima  
\q2 meta Haramara Mɨxeta tetsita mepuyeha'a.   
\q1
\v 8 Peru Kakaɨyari pɨwarutawikweitsitɨa, yuhetsiemieme mariweme mayuyeitɨanikɨ,  
\q2 yutɨrɨkariya matsiɨkɨme mayeitɨanikɨ.   
\q1
\v 9 Haramara Mɨxeta kaniutatieni, hikɨ mɨkɨ kanakawani,  
\q2 mana haramara 'amatiyewatsie kaniwaruwitɨtɨyani  
\q2 makumawetsie memɨkɨne hepaɨ.   
\q1
\v 10 Kaniwarutawikweitsitɨani memɨwaraye'unie wahepaɨtsita,  
\q2 kemɨ'ane memɨwaxani'eriekai wahepaɨtsita.   
\q1
\v 11 Memɨwaraye'uniekai haa waheima kaniuyeurieni,  
\q2 mɨkɨ xewitɨ tɨma pɨka'utawikwei.   
\q1
\v 12 Hikɨ 'ana tapaapama niukitsie yuri mepɨte'uta'eri  
\q2 meta nɨawari hetsienamieme meputakwikaxɨ.   
\b  
\q1
\v 13 Peru yapauka mekatenatɨmaiya kemɨtiuyuri  
\q2 meta meta'ikwewatɨ mepɨka'akɨ kemɨtiwarahɨawekai.   
\q1
\v 14 Makumawetsie kemɨtiwanake meteyurietɨ mepu'uwakai,  
\q2 yemekɨ makumawetsie me'u'uwatɨ Kakaɨyari mekaniuta'inɨata.   
\q1
\v 15 Mɨkɨta tita memɨte'itawawiri katiniwayetuirieni,  
\q2 peru kwiniyata kaniwarenɨ'airieni tiyumemiwame.   
\b  
\q1
\v 16 Makumawetsie metitetɨ Muitsexi mekaniutiniukimatɨkɨne  
\q2 meta 'Aruni, mɨpatsiekai Yawé hetsiemieme.   
\q1
\v 17 Kwie kanewatiyepiere hikɨ 'ana Ratani kaneukakwani,  
\q2 meta kaniwareukateuku 'Awirani memaweiyakai.   
\q1
\v 18 Mɨkɨ mɨyamemɨyupaɨmekai tai kaniwarutixɨtsitɨani,  
\q2 mekaniutitani 'axateyuruwamete.   
\q1
\v 19 Huré hɨriyaritɨa me'u'axɨaka tsikeru mekaniutawewieni,  
\q2 kakaɨyari wewiyakame hɨxie mekaniukatunuma'uni.   
\q1
\v 20 Kakaɨyari waɨkawa watemawieritɨakaku mepiku'eiri,  
\q2 tuuru pɨta 'ɨkiyaya mepanukuwei tupiriya mukwa'a.   
\q1
\v 21 Kakaɨyari mekanatɨmaiya muwarutawikweitsitɨa  
\q2 meta waɨkawa mamariwaweme mɨtiuyuri 'Ekipitu kwieyaritsie:   
\q1
\v 22 mariweme katiniuyurieni Kami kwieyaritsie  
\q2 metatsiere Haramara Mɨxeta tetsita.   
\q1
\v 23 Kakaɨyari mɨpaɨ putayɨ kename wakwinikekai  
\q2 peru mɨpaɨ pɨkatiuyuri Muitsexi hetsiemieme menayexei,  
\q1 hɨxiena kaniukeni huyetana  
\q2 meta pɨka'ipitɨa ha'atɨ mɨwaka'unakɨ.   
\b  
\q1
\v 24 Kwie witsimɨ'ane mepɨka'utanaki'eri,  
\q2 Kakaɨyari kemɨtiwakɨhɨawekai yuri mepɨkate'ita'eriri.   
\q1
\v 25 Yu'ixuriki xamaruyarita me'ayetetɨkaitɨ 'axamekateniutixatatɨkɨne  
\q2 meta Yawé mepɨka'anu'eni.   
\q1
\v 26 'Ayumieme, mɨkɨ mɨpaɨ putayɨ wahepaɨtsita,  
\q2 makumawetsie kename wakwinikekai,   
\q1
\v 27 waniwemata hipame nuiwarite watsata wakaxɨrienikekai  
\q2 meta naitsarie kwiepa wataxɨriexɨanikekai.   
\q1
\v 28 Mekaniyuyetuani kakaɨyari Wahari-Pehuxi hetsɨa  
\q2 meta kakaɨyarixi memɨka'ayeneniere wamawarika mepɨte'utikwai.   
\q1
\v 29 Mɨkɨkɨ Yawé mepuyehaxɨatɨa 'axameteyurietɨ,  
\q2 hikɨ wahetsie kaninuani kwiniya.   
\q1
\v 30 Peru Pinexi wahetsiemieme 'aixɨa pɨtiuyuri,  
\q2 'ana kwiniya paunua wahetsɨa pɨkaye'a.   
\q1
\v 31 Mɨkɨ kemɨtiuyuri 'aixɨa mɨtiuka'iyari payeitɨarie  
\q2 yuheyemekɨ, hikɨ 'enamɨtiyehane 'aixɨa ketikuxaxatsiwani.   
\q1
\v 32 Haa manakaxɨrɨwe Meriwa 'aurie Yawé mekaniuyehaxɨatɨani,  
\q2 mɨkɨ mɨyamemɨte'uyurikɨ Muitsexi hetsie pɨrahui.   
\q1
\v 33 Waɨkawa me'ihaxɨatɨakaku mɨkɨ kaniutaniuni,  
\q2 kahayu'eriwatɨ kemutainekai.   
\q1
\v 34 Mepɨkawaruka'unaxɨ hipame teɨteri  
\q2 Yawé mɨwaruta'aitakai memɨwakwinikɨ,   
\q1
\v 35 matsi 'axateyuruwamete mekaniwarutinɨni  
\q2 wayeiyari mehayexeiyatɨ mekanakɨne.   
\q1
\v 36 Mepɨwarayexeiyakai wakakaɨyarixi,  
\q2 hikɨ mɨkɨ wawiniyari kanayani.   
\q1
\v 37 Yuniwema 'ukitsi meta 'ukari mekaniwamawakaitɨni  
\q2 mɨkɨ kakaɨyarixi 'axamemɨ'anene wahetsiemieme.   
\q1
\v 38 Mekaniwarukwini 'atsimemɨkateyuriekame,  
\q2 yuniwema 'ukitsi meta 'ukari.  
\q1 Kepauka kakaɨyarixi Kanani miemete memɨwarutimawiri,  
\q2 mɨkɨ waxuriyakɨ mɨkɨ kwie 'axa'itɨarietɨ patɨa.   
\q1
\v 39 Mɨkɨ mɨyamɨti'ane meka'itiyakame pɨwarayeitɨa,  
\q2 meta mɨkɨkɨ mepuyutsewixima.   
\b  
\q1
\v 40 Yawé waɨkawa puyeha'a yuteɨterima wahetsiemieme,  
\q2 hetsɨana memɨmiemetetɨkai waxani'erietɨ patɨa.   
\q1
\v 41 'Ayumieme kaniwayetuani nuiwarite 'axateyuruwamete wahetsɨa,  
\q2 hikɨ waɨriyarika metewa'aitɨatɨ mepakɨ memɨwaraye'uniekai.   
\q1
\v 42 Memɨwaraye'uniekai mepɨtewaruta'uximayatsitɨa,  
\q2 kemɨtiwanake mepɨtewaruta'aitɨa.   
\q1
\v 43 Mɨixa Kakaɨyari wahetsie putanua,  
\q2 peru mɨkɨ, memɨ'iyamakaikɨ 'axameteyurietɨ,  
\q2 yaxeikɨa 'axameteyurietɨ mepakɨ.   
\b  
\q1
\v 44 Kepauka Kakaɨyari mɨwaruxei meyuhiweriekame,  
\q2 meta kepauka mi'eni wa'aiwari hiwariyari,   
\q1
\v 45 yutɨratu paye'eri wahamatɨa miwewi,  
\q2 naki'eriyaya mɨmariwekɨ kaniwarutinenimayata.   
\q1
\v 46 Yakatiniuyurieni memɨwaraye'unie wahetsiemieme,  
\q2 mɨkɨta memuwatinenimayatakɨ.   
\b  
\q1
\v 47 Yawé, ketaneutawikweitsitɨa, takakaɨyari pemɨhɨkɨ,  
\q2 tawarita ketaneukuxeɨri takwieyaritsie,  
\q1 pamɨpariyutsi temɨmetsipitɨakakɨ pepatsietɨ kepemɨtitewa,  
\q2 meta teyutemamawietɨ temɨmetsinɨawanikɨ.   
\b  
\q1
\v 48 Yawé 'aixɨa kerahɨawarɨwani, 'Ixaheri Kakaɨyarieya,  
\q2 yuheyemekɨ meta kaheu'akamekɨ.  
\q1 Yunaitɨ teɨteri mɨpaɨ meke'utiyuani: «Mɨpaɨ ketiɨyɨni».  
\b  
\q1 Yawé kenɨawarieka.   
\c 107  
\s1 XAPA 5  
\r Nɨawari 107-150  
\q1
\v 1 Yawé pamɨpariyutsi xekenepitɨaka, karikɨ mɨkɨ 'aixɨa katiniuka'iyarini,  
\q2 naki'eriyaya yuheyemekɨ katiniteriweni.   
\q1
\v 2 Mɨpaɨ meke'utiyuaneni Yawé mɨwarutawikweitsitɨa,  
\q2 mɨwaruxɨnaxɨ mɨwaraye'unie tiwa'aitɨakaku,   
\q1
\v 3 Naitsarie kwiepa wara'iniexɨaka mɨwarukuxeɨri,  
\q2 tayeta meta tatsutɨa miemete, tatserieta meta ta'utata miemete.   
\b  
\q1
\v 4 Memeuyexɨriekai makumawetsie meu'uwatɨ,  
\q2 huye kiekaritsie haneme mekahexeiyatɨ mekahemaririetɨ.   
\q1
\v 5 Meheuharikutɨ meta meheuhakakwikutɨ,  
\q2 mepɨkwiximekai.   
\q1
\v 6 Yawé mekaniutahiwieni me'utitsuatɨ mete'uka'eniwatɨ,  
\q2 hikɨ mɨkɨ mete'uka'eniwakaku kaniwaruxɨna.   
\q1
\v 7 Huye mɨheitserie 'utɨma kaniwarewitɨni,  
\q2 'atsita kiekaritsie kaniwaye'atɨani.   
\b  
\q1
\v 8 Yawé naki'eriyaya mɨmariwekɨ, pamɨpariyutsi xekenepitɨaka,  
\q2 mariweme mɨtiuyurikɨ teɨteri wahetsiemieme.   
\q1
\v 9 Kemɨ'ane meuharimɨkɨ mɨkɨ pɨharitɨa,  
\q2 meta kemɨ'ane meuhakamɨkɨ 'aixɨa mɨti'anekɨ pitahuxaitɨa.   
\b  
\q1
\v 10 Meyuhiwerietɨ mehɨatɨkaitɨ,  
\q2 'amepu'uwakai waɨkawa makɨyɨwitsie.   
\q1
\v 11 Kakaɨyari niukieya memɨka'u'enikɨ,  
\q2 'Amutewi kemɨtiwa'ɨxatsitɨakai yamemɨkatekakɨkɨ.   
\q1
\v 12 'Uximayatsika mahete kaniwarupitɨani,  
\q2 mepekaxɨrɨwekai, xewitɨ pumawekai mɨwaparewienikɨ.   
\q1
\v 13 Meyuhiwerietɨ Yawé mekaniutahiwieni,  
\q2 hikɨ mɨkɨ kememɨte'uka'eniwakai pɨwarutawikweitsitɨa.   
\q1
\v 14 Yemekɨ yɨriyatsata kaniwarayehapani  
\q2 meta kaniwaruxɨna memɨhɨatɨkatei kaneutekixɨani.   
\b  
\q1
\v 15 Yawé naki'eriyaya mɨmariwekɨ, pamɨpariyutsi xekenepituaka,  
\q2 mariweme mɨtiyurienekɨ teɨteri wahetsiemieme.   
\q1
\v 16 Wurunitse 'itupariyari putitaraxɨ,  
\q2 meta tepɨa kɨyeyari 'etsipepetɨ kaneutanexɨani.   
\b  
\q1
\v 17 Mepɨte'ukwinitɨarie memɨka'anu'enanakɨ,  
\q2 mepu'uximatɨarie 'axamemɨte'uyurikɨ.   
\q1
\v 18 Naitɨ 'ikwaite pɨkawanakekai me'ixeiyatɨ meputihewakai,  
\q2 'etsiwatɨkaku mekaniukwikaitɨni.   
\q1
\v 19 Meyuhiwerietɨ Yawé mekaniutahiwieni,  
\q2 hikɨ mɨkɨ kememɨte'uka'eniwakaikɨ pɨwarutawikweitsitɨa.   
\q1
\v 20 Yuniuki kanenɨ'ani 'aixɨa meteheu'eriekame mɨwarayeitɨanikɨ,  
\q2 mɨkɨ mɨpaɨ katiniwarutawikweitsitɨani teukiyapa.   
\b  
\q1
\v 21 Yawé naki'eriyaya mɨmariwekɨ, pamɨpariyutsi xekenepitɨaka,  
\q2 mariweme mɨtiyurienekɨ teɨteri wahetsiemieme.   
\q1
\v 22 Mawari meke'iyetuirieka pamɨpariyutsi me'ipitɨatɨ,  
\q2 'uximayatsikaya mekekuxatani me'utihiwatɨ temawierikakɨ.   
\b  
\q1
\v 23 Haramaratsie mepɨkɨnetɨwekai yukanuwate 'amɨpapatsie,  
\q2 meyukuharerutatɨwetɨ haramaratsie 'ateewapai mepeta'axekai.   
\q1
\v 24 Mana haramara meukatewatsie,  
\q2 Yawé 'uximayatsikaya mekaniuxeiya meta mariweme kemɨtiuyuri.   
\q1
\v 25 Kepauka Kakaɨyari mutaniu, 'eka tɨrɨkaɨyetɨ kaniukuyani,  
\q2 'ana 'apapatɨ kaniwakɨkakaitɨni hamewari,   
\q1
\v 26 muyuawitsie ye'axetɨ meta meukatewatsie heukakɨkatɨ.  
\q2 Kweriwa 'anekɨa, mɨkɨ mekaneuyuyexɨrieni.   
\q1
\v 27 Memɨtarɨweka hepaɨ mepekaxɨrɨwekai, mepɨtakeitsarietɨkɨkakai,  
\q2 tixaɨtɨ mepɨkateyunaki'eriekai, tsepa memɨtemaiwawe memɨyɨakai.   
\q1
\v 28 Waɨkawa meyuhiwerietɨ Yawé mekaniutahiwieni me'utitsuatɨ,  
\q2 hikɨ mɨkɨ kememɨte'uka'eniwakaikɨ kaniwarutawikweitsitɨani.   
\q1
\v 29 'Eka mɨtɨrɨkaɨye kaniupata wiyeri 'etsimupepekɨ:  
\q2 hamewari 'amɨnene kayuwatɨ kaniutamare.   
\q1
\v 30 'Ana kayuwatɨ mutamarixɨtsie mekaniyukatemamawieni.  
\q2 Meta 'ana Kakaɨyari kaniwarewitɨni hakewa memeɨkɨnekai.   
\b  
\q1
\v 31 Yawé naki'eriyaya mɨmariwekɨ, pamɨpariyutsi xekenepitɨaka,  
\q2 mariweme mɨtiyurienekɨ teɨteri wahetsiemieme.   
\q1
\v 32 Yunaitɨ teɨterimama meyuxeɨrietɨ mariweme mekehayeitɨaka.  
\q2 'Ukirawetsixi 'itsɨkate 'aixɨa meke'utiyuaneni hetsiena mieme.   
\b  
\q1
\v 33 Haa 'amɨpapa muyehapane makumawe Kakaɨyari payeitɨa,  
\q2 haixa mukunenieretsie muwakitsie payeitɨa,   
\q1
\v 34 kwie 'aixɨa mɨtiu'anekai kwie muxiekariya payeitɨa,  
\q2 mana kiekatari 'axamemɨte'uyurikɨ.   
\q1
\v 35 Makumawetsie haa waɨkawa xuaweme payeitɨa,  
\q2 kwie mɨwakitsie haixa xuaweme payeitɨa,   
\q1
\v 36 mana memɨkiekakɨ pɨwa'atɨa memɨyehakakwitɨwe,  
\q2 hikɨ mɨkɨ mana kiekari mekaniukamani.   
\q1
\v 37 Mekaniuka'eni, kaxie haraweriyari mekaniutiwewieni,  
\q2 waɨkawa mekateniukaxeiya.   
\q1
\v 38 Kakaɨyari 'aixɨa kaniwaruyurieni, hikɨ mɨkɨ mekaniyutimɨire,  
\q2 meta yaxeikɨa watewama kaniwarutimɨiriya.   
\b  
\q1
\v 39 Kepauka mɨkɨ 'etsimemɨyupaɨmeni,  
\q2 waɨriyarika mete'uximayatsitɨarietɨ 'axamɨti'anekɨ meta hiwerikakɨ.   
\q1
\v 40 Kakaɨyari 'uximatɨarika pɨwakupitɨwa memamariwaweme memayuyeitɨwa,  
\q2 meta kaniwarenɨ'awani makumawetsie yeuta.   
\q1
\v 41 Peru tixaɨtɨ memɨkateheuxeiya 'aixɨa 'anekɨa kaniwa'atɨwani,  
\q2 meta watɨɨriyama tewaxi wahepaɨ katiniwamɨiriyani.   
\q1
\v 42 Kepauka 'aixɨa memɨte'u'iyari mɨpaɨ memɨteneniere mepuyukatemamawieni,  
\q2 peru yunaitɨ 'axamemɨte'u'iyari kayuwatɨ mepɨtamare.   
\b  
\q1
\v 43 Kemɨ'ane mɨtimaiwe, mɨpaɨ timaitɨ kehayani  
\q2 meta 'aixɨa kereitimani Yawé naki'eriyaya mɨmariwe.   
\c 108  
\r (Nɨa 108:1-5, 6-13 – Nɨa 57:7-11, Nɨa 60:5-12)  
\d Kwikari. Rawiri nɨawarieya.  
\q1
\v 1 Kakaɨyari, ne'iyari pɨheitserie,  
\q2 ne'iyari 'aixɨa pɨ'ane, nɨawari 'ahetsiemieme nepɨtikwika.   
\q1
\v 2 Xekenanutanenieri haripa meta xaweri.  
\q2 Hekwame tukari nekananutanieritɨamɨkɨ.   
\q1
\v 3 Yawé, nepɨmetsinɨawani hipame teɨteri watsata,  
\q2 'anɨawari neputikwikani hipame nuiwarite watsata.   
\q1
\v 4 'Anaki'eriyatsɨ kanimariweni muyuawi kana'iwani,  
\q2 muyuawitsie paitɨ kaniye'axeni 'aniuki yuri maine.   
\q1
\v 5 Neuxei Kakaɨyari, 'ekɨ muyuawi pekana'iwani,  
\q2 meta 'axawatɨriya naime kwie kananukanaka.   
\q1
\v 6 Ketaneuxɨna 'atɨrɨkariyakɨ, ketaneuta'eiya  
\q2 'ateɨterima pemɨwanaki'erie memɨtawikwenikɨ.   
\b  
\q1
\v 7 Kakaɨyari mɨpaɨ putayɨ yutukita:  
\q2 «Nerayu'iwakamekɨ Tsikeni nepɨtixitexɨani,  
\q2 meta mayeweri Tsukuti nepɨti'inɨata.   
\q1
\v 8 Karaha meta Manatsexi, nehetsɨa mekanimiemetɨni,  
\q2 'Epɨrahini kuya menaketsa kanihɨkɨtɨni nemu'utsie nunuwame, Kura meta ne'itsɨ kanihɨkɨtɨni.   
\q1
\v 9 Muhawi hetsie nekaniukamaimawani,  
\q2 'Erumi hetsie nekakai nekaneutaxɨrɨwani,  
\q2 Piritsiteu kwieyari hetsie nepetahiwa neyutemawietɨ».   
\b  
\q1
\v 10 ¿Kemɨ'ane kiekari mukurarutɨarietsie pɨnetsi'anuwitɨni?  
\q2 ¿Kemɨ'ane 'Erumi huyeyari pɨnetsixeiyatsitɨani?   
\q1
\v 11 'Ekɨ pekanihɨkɨtɨni, Kakaɨyari, kemɨ'ane pemɨtatsi'uku'eiri.  
\q2 Neuxei Kakaɨyari, takuyaxima pepɨkawaparewieri.   
\q1
\v 12 Ketaneuparewi mɨtatsi'aye'unie hepaɨtsita,  
\q2 tewi parewiyaya tixaɨtɨ pɨkatiyunaki'erie.   
\q1
\v 13 Kakaɨyari tatsiparewiekaku tepɨtehayu'iwa,  
\q2 mɨkɨ memɨtatsi'aye'unie pɨwatiketsini.   
\c 109  
\d Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya.  
\q1
\v 1 Kakaɨyari, ne nepɨmetsinɨawa,  
\q2 kayuwatɨ pepɨka'umaka.   
\q1
\v 2 Neuxei teɨteri memɨkametsimate memɨte'itawa  
\q2 nehetsie mepɨtehahɨa menetsi'itatɨ,  
\q2 waniuki mɨtiyukwamanakɨ 'axamepɨnetekuxata,   
\q1
\v 3 yemekɨ kwinimieme meneteheuhekatɨ mepɨnetsixaneta,  
\q2 peru yakɨ xeikɨa mepɨtekuxata.   
\q1
\v 4 Newanaki'eriekakutɨtɨ 'axamepɨnetekuxata,  
\q2 peru ne mɨkɨ nepɨwayetua neyunenewietɨ 'ahetsɨa.   
\q1
\v 5 Tsepa ne 'aixɨa nemɨtiuka'iyari wahetsiemieme mɨkɨ 'axa'anemekɨ mepɨnete'akapitɨwa,  
\q2 menetsinaki'eriekakeme, mepɨnetsixani'erie pɨta.   
\b  
\q1
\v 6 Xeime 'axamɨtiuka'iyari keneutanɨ'a hetsiena mɨrahɨanikɨ,  
\q2 tserietana kehayerɨni mitaxaneta.   
\q1
\v 7 Hetsiena kerahɨiyani kepauka mɨtaxanetsieni,  
\q2 meta 'itarikayatɨtɨ hetsiena kerahɨani.   
\q1
\v 8 Tukarieya yapauka keneunawairi,  
\q2 meta xewitɨ pɨta 'uximayatsikayatsie ke'uyehani.   
\q1
\v 9 Tɨɨriyamama nutuite meke'akɨne,  
\q2 'ɨyaya wiuratɨtɨ ke'uyuhayewa.   
\q1
\v 10 Tɨɨriyamama meheu'uwatɨ xeikɨa meke'akɨne meta meteku'iwautɨwetɨ,  
\q2 teteɨxɨmete meke'akɨne kii mu'u'unita.   
\q1
\v 11 Memɨte'iniɨtɨakai piiniteya yupiinite meketehayeitɨani,  
\q2 teɨteri teewatari tipiiniteya mekete'unawani.   
\q1
\v 12 Mɨkɨ nutuite xewitɨ pɨkawanenimayaka,  
\q2 meta pɨkawanaki'erieka.   
\q1
\v 13 Mɨkɨ nuiwariyari ke'ukumawere,  
\q2 meta nuiwari hekwatɨ 'umamietsie ke'umaweniri.   
\q1
\v 14 Yawé, kena'eriwani paapaya ke'axamɨtiuyuri,  
\q2 meta maamaya kemɨtiuyuri.   
\q1
\v 15 Yawé yaketiwaxeiyani,  
\q2 meta mematɨmaiyarienikɨ 'ena kwiepa yaketiuyurieni.   
\b  
\q1
\v 16 'Aixɨa tiyurienetɨ mɨratɨmaikɨ,  
\q2 tixaɨtɨ memɨkatehexeiya, memɨteheuyehɨwa meta yu'iyaritsie memu'uximatɨarie,  
\q2 pɨwarutawei meta pɨwarukwi.   
\q1
\v 17 Pinakekai xeime 'axamuyurienikɨ,  
\q2 hikɨ 'axamɨ'itɨarienikɨ hetsiena ketiunake.  
\q1 Mɨka'inakekaikɨ xeime 'aixɨa muyurienikɨ,  
\q2 'aixɨa mɨ'itɨarienikɨ hetsiena mieme keheteewani.   
\q1
\v 18 'Axamutayɨkɨ kaniyuta'eima  
\q2 yukamixa manakatɨni hepaɨ,  
\q1 mɨkɨ waiyarieyatsie ke'anuyeneni haa hepaɨ,  
\q2 'umeteya hetsie paitɨ keheye'ani hatseiti hepaɨ.   
\q1
\v 19 Mɨkɨ 'axamɨti'ane ke'ita'eima 'ixuriki hepaɨ.  
\q2 Karima ke'itahɨani hɨiyame hepaɨ.   
\q1
\v 20 Yawé mɨpaɨ ketiwarakapitɨani kemɨ'ane memɨnetsixaneta,  
\q2 kemɨ'ane memɨnetsi'ita meta 'axamemɨnetekuxata.   
\b  
\q1
\v 21 Yawé neti'aitɨwame 'aixɨa pemɨtiuka'iyari, 'ekɨ 'ahetsiemiemekɨ  
\q2 'aixɨa kenetinexeiyani,  
\q2 keneneuparewi 'anaki'eriya mɨmariwekɨ meta 'aixɨa pemɨtiuka'iyarikɨ.   
\q1
\v 22 Ne tixaɨtɨ nepɨkarexeiya, nepɨreuyehɨwa,  
\q2 ne'iyari yemekɨ pu'uximatɨarie pɨtiuka'eniwa.   
\q1
\v 23 'Anɨari nepɨtaparirɨme 'etɨri yɨwikɨta mieme hepaɨ  
\q2 kɨpi hepaɨ nepɨ'ane 'anateya mɨtsatsani 'ekakɨ.   
\q1
\v 24 Haakakɨ nepɨkakewe ne'ɨkate pɨwerarani,  
\q2 ne'umete kaniyuhekɨkɨaka newaiyaritsie.   
\q1
\v 25 Teɨteri kepauka memɨnetsikuxexeiya mepɨnetsinanaima,  
\q2 menetsikuxexeiyatɨ, yumu'u meputitsike.   
\b  
\q1
\v 26 Yawé, nekakaɨyari, keneneuparewi,  
\q2 'anaki'eriya mɨmariwekɨ, keneneutawikweitsitɨa.   
\q1
\v 27 Mɨpaɨ meketehetimani  
\q2 'ikɨ 'ekɨ pɨta pemɨnetsiyurienekɨ, Yawé.   
\q1
\v 28 Tsepa mɨkɨ 'axamemɨnetsi'uyuri.  
\q2 'Ekɨ matsi 'aixɨa keneneuyuri.  
\q1 Tsepa memaye'axɨa nehetsɨa, 'ekɨ matsi pepɨwatewiyatsitɨani,  
\q2 neta ti'a'uximayatsiriwame nepɨnetemawieka.   
\q1
\v 29 Nehetsie memɨtehahɨpa meke'utewiyatsitɨarieni waɨkawa,  
\q2 meke'uyutitetewiya yemekɨ.   
\b  
\q1
\v 30 Ne matsi Yawé, pamɨpariyutsi nekamenipitɨakamɨkɨ,  
\q2 nekameninɨawakamɨkɨ yumɨireme watsata.   
\q1
\v 31 Mɨkɨ haweri memɨyɨa mɨwawikweitsitɨwame,  
\q2 hetsiena waɨkawa rahɨiwakaku mierieximekaku.   
\c 110  
\d Rawiri nɨawarieya.  
\q1
\v 1 Yawé mɨpaɨ katiniutahɨawe Neti'aitɨwame:  
\q2 «Netserieta kenayexi  
\q1 ne nekaniwaka'unamɨkɨ memɨmetsi'aye'unie,  
\q2 'ahɨxie nekaniwa'atɨamɨkɨ».   
\b  
\q1
\v 2 Yawé kemetsi'uparewieni pemɨtita'aitakɨ naitsarie  
\q2 Kerutsareme pe'ukaitɨ.  
\q2 Mana 'ekɨ ketine'aitani memɨmetsi'aye'unie wahixɨata.   
\q1
\v 3 'Akuyaxima mepuyuwaɨriyani  
\q2 tukaritsie kepauka xemuyutakwini,  
\q2 hɨrite mɨpatsietɨkatsie me'u'uwatɨ.  
\q1 Tau 'ɨrɨya manatinexɨanitsie,  
\q2 kepauka 'ahetsie mɨtinake hekwamekɨ pɨmatsitɨrɨkariya.   
\b  
\q1
\v 4 Yawé yaputayɨ kename yatikayani  
\q2 mɨkɨ pɨkatihayewa pɨkatipata:  
\q1 «'Ekɨ mawari wewiwame pekanihɨkɨtɨni yuheyemekɨ mieme,  
\q2 Merikitsereki hepaɨ».   
\b  
\q1
\v 5 Tati'aitɨwame 'atserieta kanakani,  
\q2 te'aitamete kaniwatipɨnamɨkɨ kepauka mɨyeha'ani tukariyaritsie.   
\q1
\v 6 Nuiwarite yakatiniwarakapitɨamɨkɨ, mɨkite kaniwakuxeɨrimɨkɨ,  
\q2 mu'ute kanitipɨnamɨkɨ naitsarie kwiepa.   
\b  
\q1
\v 7 Huyeta 'umietɨ tati'aitɨwame 'akitsie kanitiharimɨkɨ,  
\q2 hikɨ mɨpaɨ tawarita kanitatɨrɨkaxɨamɨkɨ.   
\c 111  
\q1
\v 1 Yawé kenɨawarieka.  
\b  
\q1 Yawé nepɨnɨawani naimekɨ ne'iyarikɨ meyumɨireme watsata,  
\q2 heitserie memu'uwa meyuxeɨriekaku wahamatɨa.   
\b  
\q1
\v 2 Yawé 'uximayatsikaya kanimamariwaweni  
\q2 meta waɨkawa mepuyutemamawie kemɨ'ane mɨkɨkɨ memɨteyɨ'ɨkitɨa.   
\q1
\v 3 Witsipɨ'anene pɨmamariwawe 'uximayatsikaya,  
\q2 kemɨtiheitserie yapɨtiyuriene yuheyemekɨ.   
\q1
\v 4 Yawé, mariwemekɨ yapɨtiuyuri temiku'eriwanikɨ.  
\q2 Yawé, 'aixɨa pɨtiuka'iyari pɨtiyukanenimaya.   
\q1
\v 5 Kemɨ'ane memeyemakaxe pɨtiwamikwa,  
\q2 yutɨratu kemɨtiuwewi yakatine'eriwani.   
\q1
\v 6 Yuteɨterima yutɨrɨkariya kaniwaruxeiyatsitɨani,  
\q2 tiwayetuirieka hipame nuiwarite tiwapiinite.   
\q1
\v 7 'Uximayatsikateya 'aixɨa pɨ'anene, kemɨtiheitserie pɨtiyuriene,  
\q2 naitɨ 'aitsikaya yuri putiyuane, 'aixɨa pɨ'ane hetsiena temɨtewiyanikɨ,   
\q1
\v 8 mɨkɨtsɨ yuheyemekɨ kani'ayumiemetɨni,  
\q2 yuri mainetsie katiniwiyani meta mɨheitserietsie.   
\q1
\v 9 Kakaɨyari yuteɨterima kaniwaruxɨna,  
\q2 hikɨ yutɨratu mɨpaɨ katiniuwewieni yuheyemekɨ mieme.  
\q2 Mɨkɨ mɨpatsie meta mɨtɨrɨkaɨye katinitewaka.   
\b  
\q1
\v 10 Xɨka xewitɨ timaiwetɨ heuyeimɨkɨni ke'itsutɨani Yawé 'ayemakatɨ,  
\q2 kemɨ'ane 'aitsika memaye'atɨa mekanimatsiɨkɨni, heitseriemekɨ yamekateniyurieka.  
\q2 Peuyewetse Kakaɨyari temɨnɨawani yuheyemekɨ.   
\c 112  
\q1
\v 1 Yawé kenɨawarieka.  
\b  
\q1 'Aixɨa kani'itɨarieka kemɨ'ane Yawé mayemakaxe  
\q2 meta kaniyutemawieka 'aitsikaya 'aye'atɨatɨ.   
\q1
\v 2 Heitseriemekɨ yamemɨtekahu waniwema 'ena kwiepa mekatenita'aitakuni,  
\q2 meta 'aixɨa mekani'itɨariekakuni.   
\q1
\v 3 Yukie waɨkawa piinite mepɨtehexeiyani,  
\q2 meta yuheyemekɨ 'aixɨa mepɨteyurieka.   
\q1
\v 4 'Aixɨa memɨte'u'iyari mekanihekɨariwiyarieka yɨwipa.  
\q2 Kakaɨyari 'aixɨa pɨtiuka'iyari, pɨtiyukanenimaya meta heitserie pɨtiyuriene.   
\q1
\v 5 'Aixɨa pɨ'itɨarie kemɨ'ane mɨtiyuniniɨtɨwa piinite 'aixɨa 'anemekɨ,  
\q2 meta 'aixɨa 'anemekɨ yupiinitsie mɨti'uximaya.   
\q1
\v 6 'Aixɨa mɨtiuka'iyari yuheyemekɨ pukuxaxatsiwani,  
\q2 hatsuakutɨma 'axamɨti'ane pɨkare'iwa.   
\q1
\v 7 Pɨkatimani kepauka niuki 'axa'aneme mɨtaxatɨarieni,  
\q2 'iyarieya heitserie 'aixɨa pɨtiyɨkɨhɨaweni Yawé hetsie yuri ti'erietɨ.   
\q1
\v 8 'Iyarieya pɨxewini, pɨkaheumaka,  
\q2 'ariketa memeye'unie puwaxeiya me'atixɨriekame.   
\q1
\v 9 Tixaɨtɨ memɨkatehexeiya pɨtiwamikwa tita mɨrexeiya,  
\q2 ke'aixɨa mɨtiyuriene yuheyemekɨ katiniyurieneni,  
\q2 kemɨtiyurieneni 'aixɨa 'anemekɨ pɨmatiwani.   
\b  
\q1
\v 10 'Axamɨtiuka'iyari mɨkɨ pɨtixeiya, hikɨ pɨyeha'ani,  
\q2 yutame 'utaxikauteketɨ 'atsipɨyɨni.  
\q2 'Axateyuruwamete kememɨteku'eriwa mɨkɨ yapɨkatikɨyɨne.   
\c 113  
\q1
\v 1 Yawé kenɨawarieka.  
\b  
\q1 Yawé te'uximayatsiriwamete,  
\q2 xekenenɨawani Yawé Kakaɨyari.   
\q1
\v 2 Yawé hepaɨtsita 'aixɨa keraniuwani,  
\q2 hikɨ mɨtiyehane meta yuheyemekɨ.   
\q1
\v 3 Yawé kenɨawarieka,  
\q2 tau 'amɨranatinenitsie meta kepaukake makayune.   
\b  
\q1
\v 4 Yawé naitsarie nuiwarite wahetsie katini'aitani,  
\q2 muyuawitsie katini'aitani.   
\q1
\v 5 Xewitɨ Yawé takakaɨyari hepaɨ pɨka'ane,  
\q2 'uweni hexeiyatɨ muyuawitsie   
\q2
\v 6 mɨkɨ mana paitɨ muyuawi meta kwie pɨtaxeiya tixaɨtɨ karayuyeitɨatɨ.   
\b  
\q1
\v 7 Mɨkɨ tixaɨtɨ mɨkarexeiya tumuanaripa kanatihanani,  
\q2 meta xatsi matiwiwiwatsie patihana mɨreuyehɨwa,   
\q1
\v 8 te'aitamete memɨmamariwawe wa'aurie kaniwarayayatsani,  
\q2 teɨterimama tewa'aitɨwamete wa'aurie.   
\q1
\v 9 'Uka mɨkaniwewe, yukii mexeiyanikɨ kanipitɨaka  
\q2 meta tɨɨri mɨwarayexeiyakɨ.  
\b  
\q1 Yawé kenɨawarieka.   
\c 114  
\q1
\v 1 Kepauka 'Ixaheri, Kakuwu xiɨyarimama,  
\q2 memayekɨ 'Ekipitu kwieyaritsie, hipame teɨteri wakie,   
\q1
\v 2 Kura Kakaɨyari tukieya kanayani,  
\q2 'Ixaheri kwieyari mɨra'aita patɨa.   
\b  
\q1
\v 3 Haramara 'ixaheritsixi waruxeiyaka huye kananuwewieni memanukɨnekɨ,  
\q2 metatsiere hatuxame Kurutani ka'uhanetɨ kanayani.   
\q1
\v 4 Hɨrite 'amɨtɨtɨ muxatsi 'ukitsi wahepaɨ mepɨte'utsunaxɨa  
\q2 metatsiere yemurite 'etsimɨpepe.   
\q1
\v 5 ¿Haramara, kemetiuyuri, titayari peranutayepierixɨ?  
\q2 ¿'Ekɨta Kurutani, titayari perewake pe'uhanetɨ?   
\q2
\v 6 Xemeta hɨrite 'amɨtɨtɨ meta yemurite 'etsixemɨpepe,  
\q2 ¿titayari muxatsi 'ukitsi wahepaɨ xete'utsunaxɨa?   
\b  
\q1
\v 7 Neuxei kwie, Yawé hɨxie keneuyɨyɨakani,  
\q2 Kakuwu Kakaɨyarieya hɨxie.   
\q1
\v 8 Mɨkɨ 'aitsie haa kananetɨani,  
\q2 meta tete mayetse'itsie haixa kananetɨaxɨani.   
\c 115  
\r (Nɨa 115:4-11 – Nɨa 135:15-20)  
\q1
\v 1 Yawé, 'aixɨa pɨ'ane 'ekɨ pemɨnɨawarieka,  
\q2 'anaki'eriyakɨ meta yuri pemɨtikuxatakɨ,  
\q2 tame matsi heitserie tepɨkahexeiya.   
\b  
\q1
\v 2 Hipatɨ teɨteri mɨpaɨ meputiyuaneni, metatsinanaimatɨ:  
\q2 «¿Hakewa 'aku xekakaɨyari?»   
\q1
\v 3 Takakaɨyari muyuawitsie kaniuyeikani,  
\q2 mɨkɨ yakatiniyurieneni kemɨtinake.   
\q1
\v 4 Peru mɨkɨ nuiwarite memɨwarayexeiya kakaɨyarixi huru meta pɨrata mekanihɨkɨtɨni,  
\q2 teɨteri wawewiya.   
\q1
\v 5 Meputeni, peru mepɨkaniuwawe,  
\q2 mepuhɨxi, peru mepukaheuneniere,   
\q1
\v 6 mepunaka, peru mepɨkaheu'enana,  
\q2 meputsuri, peru mepɨkateheu'ɨkwe,   
\q1
\v 7 mepumama, peru mepɨkatemayɨawawe,  
\q2 mepɨ'ɨka, peru mepɨka'ɨkɨniwawe,  
\q2 mepɨkɨipi peru mepɨkayɨwawe memɨtehata'eiyakɨ.   
\q1
\v 8 Kemɨ'ane memɨwatiwewiwa, mɨkɨ wahepaɨ mepɨ'anene,  
\q2 metatsiere yunaitɨ yuri memɨte'erie wahetsie.   
\b  
\q1
\v 9 Matsi 'ixaheritsixi, Yawé hetsie yuri xeketene'erieka,  
\q2 mɨkɨ kanixeparewiwametɨni meta xehetsie nunuwame kanihɨkɨtɨni.   
\q1
\v 10 'Aruni xiɨyarimama, Yawé hetsie yuri xeketene'erieka,  
\q2 mɨkɨ kanixeparewiwametɨni meta xehetsie nunuwame kanihɨkɨtɨni.   
\q1
\v 11 Kemɨ'ane Yawé xemayemakaxe, mɨkɨ hetsie yuri xeketene'erieka,  
\q2 mɨkɨ kanixeparewiwametɨni meta xehetsie nunuwame kanihɨkɨtɨni.   
\b  
\q1
\v 12 Yawé pɨkatatsi'atɨmaiya meta 'aixɨa kataniyurieka:  
\q2 'ixaheritsixi 'aixɨa kaniwayurieka,  
\q2 meta 'Aruni xiɨyarimama 'aixɨa kaniwayurieka,   
\q2
\v 13 'aixɨa kaniwayurieka kemɨ'ane Yawé memayemakaxe,  
\q2 'aixɨa kaniwayurieka 'amemɨtɨtɨ meta 'etsimemɨtɨtɨ.   
\b  
\q1
\v 14 Yawé kewamɨiriyani xetɨɨriyama  
\q2 meta xeniwema watɨɨriyama.   
\q1
\v 15 Yawé hetsɨa timieme 'aixɨa mɨti'ane wahetsie ketinakeni,  
\q2 muyuawi mutawewi meta kwie.   
\b  
\q1
\v 16 Muyuawi Yawé katinipiinieyatɨni,  
\q2 peru teɨteri kwie kaniwayetuirieni.   
\q1
\v 17 Memukwiri mepɨkayɨwawe Yawé memɨnɨawani,  
\q2 memukateukiekɨri.   
\q1
\v 18 Tame tekanihɨkɨtɨni Yawé temɨnɨawa  
\q2 hikɨ meta yuheyemekɨ.  
\b  
\q1 Yawé kenɨawarieka.   
\c 116  
\q1
\v 1 Ne Yawé nepɨnaki'erie  
\q2 mɨkɨ mɨnetsi'eniekɨ waɨkawamekɨ nehehɨawekaku.   
\q1
\v 2 Mɨkɨ nenenewieri mɨ'eniekɨ,  
\q2 yuheyemekɨ yanepɨrehɨawe.   
\b  
\q1
\v 3 Mɨki yuwiniyarikɨ pɨnetsihɨakai,  
\q2 'uximatɨarika pɨnetsi'umi tɨma,  
\q2 'anari waɨkawa nepɨtiuka'eniexɨa.   
\q1
\v 4 Hikɨ 'ana Yawé waɨkawamekɨ mɨpaɨ nekatiniutahɨawe:  
\q2 «Yawé, waɨkawamekɨ nepɨmetsiwawirie, netukari keneutawikweitsitɨa».   
\b  
\q1
\v 5 Yawé pɨtiyukanenimaya heitserie pɨtiyuriene,  
\q2 takakaɨyari naimekɨ witsipɨtiuka'iyari.   
\q1
\v 6 Teɨteri yuhetsie memɨkaheutanuawawe Yawé wahetsie kaninuaka,  
\q2 ne nepɨkayɨwekairi mɨkɨ pɨnetsi'utawikweitsitɨa.   
\b  
\q1
\v 7 Ne'iyari, kayuwatɨ kenexeiyaniri,  
\q2 'ahetsiemieme Yawé 'aixɨa katiniuka'iyarini.   
\b  
\q1
\v 8 'Ekɨ pepɨnetsi'utawikweitsitɨa nemɨximekaku,  
\q2 ne'ukai pepa'itiexɨa,  
\q2 nemekawautsenikɨ pepɨkanetsipitɨa.   
\q1
\v 9 'Ayumieme yuheyemekɨ Yawé hɨxie nepuyeikani,  
\q2 mexixi 'ena kwiepa mɨranu'uwatɨka ne'uyeika.   
\q1
\v 10 Tsepa mɨpaɨ nemɨmatikɨhɨawe: «Waɨkawa nepɨtiuka'eniwa ne'iyaritsie»,  
\q2 peru Kakaɨyari hetsie yuri nepɨti'erie.   
\q1
\v 11 Mɨpaɨ neputayɨ newaɨripietɨ:  
\q2 «Yunaitɨ memɨte'itawa mepɨhɨkɨ».   
\b  
\q1
\v 12 Nepɨkayɨwe kenemɨrekapitɨani Yawé,  
\q2 waɨkawa 'aixɨa mɨti'ane mɨnetiupitɨakɨ.   
\q1
\v 13 Nepɨyɨwe xeikɨa pamɨpariyutsi nemɨmetsipitɨaka 'awikweitsitɨarikakɨ,  
\q2 meta nemetsinuawatɨ neyunenewietɨ Yawé.   
\q1
\v 14 Metatsiere neraye'atɨatɨ xeikɨa Yawé kenemɨrahɨawe  
\q2 yunaime teɨterimama wahɨxie.   
\b  
\q1
\v 15 Yawé puyukahiwerɨwa kepauka  
\q2 hetsiena yamemɨtekahu memɨtakukuwe.   
\q1
\v 16 Yawé, ne ti'a'uximayatsiriwame nepɨhɨkɨ,  
\q2 nemaamata ti'a'uximayatsiriwame pɨhɨkɨtɨkai.  
\q2 Kepauka tepɨa kaunariyarikɨ nemɨhɨakai, 'ekɨ pepeitekixɨa.   
\b  
\q1
\v 17 Kenemɨtiyutemawie mawariyari nepɨmetsiwewirieni  
\q2 meta nepɨmetsikuxatani Yawé.   
\q1
\v 18 Yawé nepɨraye'atɨirieni kenemutayɨ,  
\q2 yunaime teɨterimama wahɨxie,   
\q1
\v 19 Yawé kiita hɨxie takwa,  
\q2 Kerutsareme 'ahixɨapa.  
\b  
\q1 Yawé kenɨawarieka.   
\c 117  
\q1
\v 1 Nuiwarite yunaitɨ kwiepa xemɨtama, Yawé 'aixɨa xeketenahɨaweni.  
\q2 Yunaitɨ teɨteri kwikari hetsiena mieme xekeneutikwikani.   
\q1
\v 2 Naki'eriyaya kanimariweni tahetsiemieme.  
\q2 Yawé yuheyemekɨ 'aixɨa pɨtikamie.  
\b  
\q1 Yawé kenɨawarieka.   
\c 118  
\q1
\v 1 Yawé pamɨpariyutsi xekenepitɨaka, mɨkɨ 'aixɨa katiniuka'iyarini,  
\q2 kemɨtiuyukanaki'erie yuheyemekɨ kataninaki'erieka.   
\b  
\q1
\v 2 'Ixaheritsixi mɨpaɨ meke'utiyuaneni:  
\q2 «Kakaɨyari pɨkatihayewa tatsinaki'erietɨ yuheyemekɨ».   
\q1
\v 3 'Aruni xiɨyarimama mɨpaɨ meke'utiyuaneni:  
\q2 «Kakaɨyari pɨkatihayewa tatsinaki'erietɨ yuheyemekɨ».   
\q1
\v 4 Mɨpaɨ meke'utiyuaneni kemɨ'ane Yawé memayemakaxe:  
\q2 «Kakaɨyari pɨkatihayewa tatsinaki'erietɨ yuheyemekɨ».   
\b  
\q1
\v 5 Waɨkawa netiuka'eniwatɨ Yawé nekaniutahɨawe,  
\q2 hikɨ mɨkɨ kaneniuta'eiya 'aixɨa kaneniuyurieni nemɨkatiuka'eniwanikɨ.   
\q1
\v 6 Yawé nehamatɨa kaniuyeikani, ne nepɨkaheuma,  
\q2 ¿xewitɨ tewi 'atsimɨnetsi'uyurieni pɨkayɨwe?   
\q1
\v 7 Yawé nehamatɨa kaniuyeikani, mɨkɨ netsiparewiwame kanihɨkɨtɨni,  
\q2 tsiparatsɨ nekaniwaxeiyamɨkɨ kwiepa mekuheime memɨnetsi'aye'unie.   
\b  
\q1
\v 8 Matsi 'aixɨa pɨ'ane Yawé hetsie muyu'awietanikɨ,  
\q2 pɨkaheuyewetse tewi hetsie mɨtiwiyani.   
\q1
\v 9 Matsi 'aixɨa pɨ'ane Yawé hetsie muyu'awietani,  
\q2 'aixɨa pɨka'ane teɨteri memɨmamariwawe wahetsie mɨtiwiyani.   
\b  
\q1
\v 10 Yunaitɨ nuiwarite menetsi'aye'unietɨ mekanaketɨkɨne,  
\q2 peru Yawé netsi'uparewieku nekaniwara'iwa.   
\q1
\v 11 Naitsarie nuiwarite mekaneniuhupieni,  
\q2 peru Yawé netsi'uparewieku nekaniwara'iwa.   
\q1
\v 12 Xietexi wahepaɨ nehetsie mepɨteheukayexɨa,  
\q2 peru meputitai kɨximɨari mɨtitatawe hepaɨ.  
\q2 Yawé netsi'uparewieku nekaniwara'iwa.   
\b  
\q1
\v 13 Menetsinanaimatɨ mepɨnetsihetaimaxɨ nemekawenikɨ,  
\q2 peru Yawé kaneniuparewieni.   
\q1
\v 14 Yawé netɨrɨkariya kanihɨkɨtɨni meta nekwikari,  
\q2 mɨkɨ netsiwikweitsitɨwame kanihɨkɨtɨni.   
\b  
\q1
\v 15 Heitseriemekɨ memu'uwa wakiita  
\q2 puxuawe hiwarika temawierikayari metehayu'iwaka:  
\q1 «Yawé yutɨrɨkariyakɨ mariweme pɨtiyuriene,   
\q2
\v 16 Yawé tɨrɨkariyaya pɨnɨawarie.  
\q2 Yawé yutɨrɨkariyakɨ mariweme pɨtiyuriene».   
\b  
\q1
\v 17 Hawaikɨ nepɨkamɨni, nepayeniereni  
\q2 Yawé mariwemekɨ kemɨtiyuriene nemikuxatanikɨ.   
\q1
\v 18 Yawé pɨnetsi'ukuwaxɨa tiyukukuinemekɨ,  
\q2 peru nemɨmɨnikɨ pɨkanetsiyetua.   
\b  
\q1
\v 19 Xekeneteneuyepiri kitenie hakewa memeutahaketsie 'aixɨa 'anemekɨ memu'uwa,  
\q2 ne nemeutahanikɨ pamɨpariyutsi Yawé nemɨpitɨanikɨ.   
\q1
\v 20 Mɨkɨ Yawé kitenieya kanihɨkɨtɨni,  
\q2 muwa mekaneutahakeni teɨteri heitserie memexeiya.   
\q1
\v 21 Pemɨnetsi'uta'eikɨ pamɨpariyutsi nepɨmetsipitɨani,  
\q2 'ekɨ netsiwikweitsitɨwame pemɨhɨkɨkɨ.   
\b  
\q1
\v 22 Kii wewiwamete tete memutixani'eri,  
\q2 matsi mɨkɨ tete 'itsikina mieme kanayani.   
\q1
\v 23 Mɨkɨkɨ tepɨhɨxiya mariwemekɨ,  
\q2 Yawé pɨta matsi katiniuyurieni.   
\q1
\v 24 'Ikɨ tukaritsie Yawé mɨpaɨ katiniuyurieni,  
\q2 'aixɨa tepɨteku'eriwani tepuyutemamawieka hetsiena mieme.   
\b  
\q1
\v 25 Yawé, wikweitsitɨarika ketaneupitɨa,  
\q2 Yawé, temɨtehayu'iwakɨ ketaneupitɨa.   
\q1
\v 26 'Aixɨa ke'itɨarieka kemɨ'ane 'umamie Yawé hetsɨa mieme hɨkɨtɨtɨ.  
\q2 Yawé kiita paitɨ 'aixɨa tepɨte'ikɨhɨawe.   
\q1
\v 27 Yawé kanikakaɨyaritɨni meta katanihekɨariwiyani,  
\q2 hikɨmɨ tepɨwatinɨni Kakaɨyari teɨterimama tuturi tepanupini  
\q2 mawari taiyame 'awayatsie paitɨ tepikɨwɨtɨani.   
\b  
\q1
\v 28 'Ekɨ pepɨnekakaɨyari, 'ayumieme pamɨpariyutsi nepɨmetsipitɨa,  
\q2 'ekɨ pepɨnekakaɨyari, 'ayumieme nepɨmetsinɨawa.   
\b  
\q1
\v 29 Yawé pamɨpariyutsi xekenepitɨaka, mɨkɨ 'aixɨa katiniuka'iyarini,  
\q2 mɨkɨ yuheyemekɨ kataninaki'erieka.   
\c 119  
\q1
\v 1 'Aixɨa mekani'itɨarieka kemɨ'ane huye 'aixɨa mɨ'ane 'utɨa memuhu,  
\q2 Yawé 'aitsikaya kemaine mɨpaɨ memɨte'u'uwa.   
\q1
\v 2 'Aixɨa mekani'itɨarieka kemɨ'ane 'a'inɨari niukiyari memu'uta  
\q2 meta yu'iyarikɨ memikuwautɨwe.   
\q1
\v 3 Hatsuakutɨma 'axamepɨkateheyurie,  
\q2 matsi pɨta Kakaɨyari huyeya mepuweiya.   
\q1
\v 4 'Ekɨ 'aitsika pekaniyetuani,  
\q2 heitseriemekɨ maye'atɨariwanikɨ.   
\q1
\v 5 Waɨkawamekɨ nepɨnewaɨriya nehuye 'aixɨa nemuyurienikɨ,  
\q2 nemeye'atɨanikɨ 'a'aitsika.   
\q1
\v 6 Hatsuaku nepɨkatewiyatsitɨarieni  
\q2 kepauka naime 'a'aitsika nemaye'atɨaka.   
\q1
\v 7 Ne ne'iyarikɨ nepɨmetsitanɨawa,  
\q2 kepauka nemeitimani ke'aixɨa pemɨti'aitakɨ.   
\q1
\v 8 'A'inɨari niukiyari nepaye'atɨani,  
\q2 pepɨkanetsi'uku'e'eiriwani naimekɨ.   
\b  
\q1
\v 9 ¿Kehepaɨ 'anetɨ temaikɨ pɨ'itiyaka?  
\q2 Yatikamietɨ 'aniuki kemaine.   
\q1
\v 10 Ne naime ne'iyarikɨ nepɨmetsikuwaɨne,  
\q2 pepɨkanetsipitɨaka 'a'aitsika nemuku'e'eiriwanikɨ.   
\q1
\v 11 Ne'iyaritsie 'aniuki nepu'uta  
\q2 kapa 'ahetsiemieme 'axanetiuyurienikɨ.   
\q1
\v 12 Yawé, 'aixɨa pemɨrayurieni pepɨhɨkɨ.  
\q2 Keneneuta'ɨkitɨa 'a'aitsika nemetimanikɨ.   
\q1
\v 13 Ne naime 'a'aitsika  
\q2 yanekatinikuxatani pemɨtatsi'uta'ɨkitɨa.   
\q1
\v 14 Waɨkawamekɨ nepɨnetemawie 'aniuki kemaine mɨpaɨ netiuyeikatɨ  
\q2 keyuri waɨkawa nerexeiyatɨ.   
\q1
\v 15 'A'aitsika nepuku'eriwa,  
\q2 meta 'ahuye'utɨa xeikɨa nepɨne'ɨwiya.   
\q1
\v 16 'A'aitsikatsie temawierika nepukaxexeiya,  
\q2 hatsuaku nepɨkahetɨmaiya 'aniuki.   
\b  
\q1
\v 17 Ne ti'a'uximayatsiriwame 'aixɨa kenetinexeiyani,  
\q2 mɨpaɨ nemɨtiuyeikanikɨ meta 'aniukitsie yanemɨtikamienikɨ.   
\q1
\v 18 Neheuniereme kenenayeitɨa, nemixeiyakɨ  
\q2 'a'ɨkitsikate mɨmamariwawe.   
\q1
\v 19 Ne kuyeikame nekanihɨkɨtɨni 'ena kwiepa,  
\q2 'a'aitsika pepɨkanetsi'awitsirieka.   
\q1
\v 20 Mɨixa nekɨipitsie pɨrekaka,  
\q2 ke'aixɨa pemɨti'aita neheumaimɨtɨ.   
\q1
\v 21 'Ekɨ pepɨwarutate'a memuyuti'ɨre,  
\q2 'axameke'itɨarieka kemɨ'ane yamemɨkatekahu 'a'aitsikatsie.   
\q1
\v 22 'Ekɨ pepɨkawapitɨaka hipatɨ memɨnetsiyuriyani,  
\q2 ne matsi 'a'aitsikatsie yanemɨtikamiekɨ.   
\q1
\v 23 Kemɨ'ane tɨrɨkariya memexeiya nehetsiemieme mepɨtekuxata kememɨnetsiyurienikɨ,  
\q2 peru matsi ne ti'a'uximayatsiriwame 'a'aitsika xeikɨa nepuku'eriwa.   
\q1
\v 24 'A'aitsika pɨnetsitemawieritɨa,  
\q2 meta mɨkɨ netsi'ɨxatsitɨwamete mepɨhɨkɨ.   
\b  
\q1
\v 25 Kwiepa nekanitihɨximaweni,  
\q2 tukari keneneupitɨa 'aniukitsie kepemaine.   
\q1
\v 26 Kepauka nemɨmetsi'utaxatɨa kenemɨtiyurienikɨ, 'ekɨ pepɨnetsi'uta'ei.  
\q2 'A'aitsika keneneuti'ɨkitɨa.   
\q1
\v 27 Keneneupitɨa 'a'aitsika hepaɨtsita nemɨtimaikakɨ,  
\q2 mariwemekɨ kepemɨtiuyuri nemuku'eriwanikɨ.   
\q1
\v 28 Hiwerikakɨ ne'iyari pɨtaxɨxime:  
\q2 ne'iyari ketinemikwani 'aniuki kemainekɨ.   
\q1
\v 29 Pepɨkanetsipitɨaka huye mututuni nemanukuweweiyanikɨ,  
\q2 'aniuki kemaine netimaikame kenenayeitɨaka.   
\q1
\v 30 Nepɨnewaɨriya huye mɨheitserie nemuweiyanikɨ,  
\q2 meta 'a'aitsika nepanayexei nemiweiyanikɨ.   
\q1
\v 31 Yawé, ne 'a'aitsikatsie nepɨtiwiya,  
\q2 pepɨkanetsipitɨaka nemɨtewiyatsitɨarienikɨ.   
\q1
\v 32 'A'aitsika huyeyari 'utɨma nekaniunautsarɨmeni,  
\q2 'ekɨtsɨ waɨkawa nemɨnekɨhɨawenikɨ pekaneniupitɨani.   
\b  
\q1
\v 33 Yawé, kenetineuti'ɨkitɨa 'a'aitsika nemuweiyanikɨ,  
\q2 hikɨ ne yanekatinikayeimɨkɨ kemaine kenemɨreutere ne'uyeikatɨ.   
\q1
\v 34 Nemɨtimaiwenikɨ keneneupitɨa 'a'aitsikatsie yanemɨtiyurienikɨ,  
\q2 naime ne'iyarikɨ nekaneye'atɨakamɨkɨ.   
\q1
\v 35 'A'aitsika huyeyari 'utɨma keneneuwitɨximeni,  
\q2 mɨkɨtsie temawierika nepukaxexeiya.   
\q1
\v 36 Ne'iyari 'a'aitsikatsie yɨkɨhɨaweme kenayeitɨa,  
\q2 matsi tumini 'iwarikayarikɨ 'axamɨ'anetsie pɨkayɨhɨaweni.   
\q1
\v 37 Nitixaɨtɨ mɨkatihɨkɨ hetsie nenekɨ'ɨwiyame pepɨkanetsihayeitɨaka,  
\q2 matsi tukari keneneupitɨa 'aniukitsie kepemaine.   
\q1
\v 38 'Aniuki kenaye'atɨa 'ikɨ ti'a'uximayatsiriwame hetsie,  
\q2 kepemɨtiyuriene memɨmetsihayemakaxe wahetsie.   
\q1
\v 39 'Uximatɨarika tewiweme kenemɨrexeiya, mɨkɨ hepaɨtsita keneneɨxɨna,  
\q2 'ekɨ matsi 'itsɨkame 'aixɨa pemɨtiuka'iyari pepɨhɨkɨ.   
\q1
\v 40 Ne 'a'aitsika niukiyari nepɨnaki'erie.  
\q2 Tukari keneneupitɨa heitseriemekɨ 'ekɨ kepemɨtiyupitɨwa.   
\b  
\q1
\v 41 Yawé, 'anaki'eriya mɨmariwe kenenanɨ'airi  
\q2 meta wikweitsitɨarika 'ahetsɨa miemekɨ kepemutayɨ.   
\q1
\v 42 'Ana nepɨyɨweni nemɨwaruta'eiya 'axamemɨnetekɨhɨawe,  
\q2 ne 'aniukitsie nemɨtiwiyakɨ.   
\q1
\v 43 Yuri netikuxatame xeikɨa kenenayeitɨaka,  
\q2 'a'aitsika hetsie xeikɨa nekanita'ikwewani.   
\q1
\v 44 Yuheyemekɨ  
\q2 'a'aitsikatsie heitseriemekɨ yanepɨtikamieni.   
\q1
\v 45 'Aixɨa 'anemekɨ nepukuyeikani 'atsinekatiku'eriwatɨ,  
\q2 ne 'a'aitsika nemuweiyakɨ.   
\q1
\v 46 Ne te'aitamete nepɨtiwataxatɨani 'a'aitsika hepaɨtsita,  
\q2 hawaikɨ nepɨkanetitewiya,   
\q1
\v 47 matsi 'a'aitsika nemɨnaki'eriekɨ,  
\q2 meta mɨkɨkɨ ne nekaniyutemawieka.   
\q1
\v 48 Ne 'a'aitsika nekaninaki'erieka,  
\q2 mɨkɨkɨ nekaniyutemawieka,  
\q2 'a'aitsika nemuku'eriwani pɨnetsinake.   
\b  
\q1
\v 49 Kena'eriwani 'ikɨ ti'a'uximayatsiriwame ke'aneme niuki pemiyetuiri,  
\q2 mɨkɨ niukikɨ neta'ikwewame pemɨnetsi'ayeitɨa.   
\q1
\v 50 'Ikɨ netsinɨtɨwame kanihɨkɨtɨni kepauka nemɨtiuka'eniwa:  
\q2 'aniukitsie kepemaine tukari kanenipitɨaka.   
\q1
\v 51 Memɨyuti'ɨre kwinimieme 'axamepɨnetekɨhɨawe,  
\q2 ne peru 'a'aitsika nepɨka'uku'e'eiriwa.   
\q1
\v 52 Yawé, ne 'a'aitsika nepa'eriwa meripaitɨ mieme,  
\q2 mɨkɨtsie nɨtɨarika nepukaxexeiya.   
\q1
\v 53 'Axateyuruwamete wahepaɨtsita nepɨha'a,  
\q2 'a'aitsika memuku'eirikɨ.   
\q1
\v 54 'A'aitsika nekwikari pɨhɨkɨ,  
\q2 'ena yapaɨmexɨa nemanuyeikatsie.   
\q1
\v 55 Yawé, yɨwikɨta nepɨmetsihahɨawe kepemɨtitewakɨ,  
\q2 nepɨnewaɨriya 'a'ɨkitsika nemaye'atɨanikɨ.   
\q1
\v 56 Ne 'a'aitsika memaye'atɨwanikɨ  
\q2 nehɨritɨarika kanihɨkɨtɨni.   
\b  
\q1
\v 57 Yawé, 'ekɨ tita nemɨrexeiya pekanihɨkɨtɨni.  
\q2 'Aniuki kemaine nepeye'atɨani, mɨpaɨ nepaine.   
\q1
\v 58 Ne'iyarikɨ yemekɨ yanepɨtikamienikeyu kemɨmetinake,  
\q2 keneneutinenimayata kepemutayɨ.   
\q1
\v 59 'Ari netukari nepeutimaixɨa,  
\q2 mɨpaɨ nepɨtinewaɨriya nemeye'atɨanikɨ 'a'aitsika.   
\q1
\v 60 Nepɨnemexɨitɨa, xeiya nepɨrayeitɨwa  
\q2 'a'aitsika nemaye'atɨanikɨ.   
\q1
\v 61 Tsepanetɨ 'axamemɨte'u'iyari memɨnetsiwiniyaku,  
\q2 ne matsi 'a'aitsika nepɨkahatɨtɨmaiya.   
\q1
\v 62 Tɨkari hixɨapa nepanukukeka pamɨpariyutsi nemetsipitɨanike,  
\q2 'a'aitsika heitseriemekɨ mɨtikuxatakɨ.   
\q1
\v 63 Kemɨ'ane memɨmetsihayemakaxe nekaniwahamikutɨni,  
\q2 meta 'a'aitsikatsie yamemɨtekahu.   
\q1
\v 64 Yawé, 'a'aitsika keneneuti'ɨkitɨa,  
\q2 kwiepa waɨkawa puxuawe 'anaki'eriya mɨmariwe.   
\b  
\q1
\v 65 Yawé, ti'a'uximayatsiriwame 'aixɨa ketinexeiyani,  
\q2 'aniuki kemainekɨ.   
\q1
\v 66 Kenenepitɨaka nemɨtimaiwenikɨ meta nemeitimaitɨyeikanikɨ,  
\q2 ne 'a'aitsikatsie yuri nekatini'erieka.   
\q1
\v 67 Meripaitɨ mexixi nekatikwiniwekai, 'ateewa nepuyeikakai,  
\q2 peru hikɨ 'aniukitsie yanepɨtikamie.   
\q1
\v 68 'Ekɨ 'aixɨa pepɨtiuka'iyari, meta 'aixɨa pepɨtiyuriene,  
\q2 'a'aitsikate keneneuti'ɨkitɨa.   
\q1
\v 69 Tsepanetɨ memuyuti'ɨre nehetsiemieme 'axakememutiyuane,  
\q2 ne nepeye'atɨwa 'a'aitsika yemekɨ ne'iyarikɨ.   
\q1
\v 70 Mɨkɨ mepɨka'u'iyari yemekɨ,  
\q2 peru ne nepuyutemawie 'a'aitsikakɨ.   
\q1
\v 71 'Aixɨa pɨ'ane pemɨnetiukwinitɨa,  
\q2 'a'aitsika mɨkɨkɨ nepetima.   
\q1
\v 72 'A'ɨkitsika matsi waɨkawa pɨraye'axe nehetsiemieme,  
\q2 keyuri pɨrata meta huru tuminiyari waɨkawatɨ.   
\b  
\q1
\v 73 'Atɨrɨkariyakɨ pepɨnetsi'utawewi, kenemɨ'aneni yapepɨnetiuwewi.  
\q2 Nemeitimaitɨyeikanikɨ keneneupitɨa 'a'aitsika nemɨmaikakɨ.   
\q1
\v 74 Kemɨ'ane memɨmetsihayemakaxe kepauka memɨnetsixeiya mekaniyutemamawieka,  
\q2 'aniukitsie yuri nemɨti'eriekɨ neta'ikwewatɨ.   
\q1
\v 75 Yawé, ne nepɨtimate 'a'aitsika 'aixɨa pɨ'ane,  
\q2 meta pɨheitserie kepemɨnetikuwaya.   
\q1
\v 76 'Anaki'eriya mɨmariwe kehɨkɨtɨni mɨnetsinɨtɨani,  
\q2 'ikɨ ti'a'uximayatsiriwame kepemɨtiutahɨawixɨ.   
\q1
\v 77 'Anenimayatsika kenuani tukari kenetsi'upitɨani,  
\q2 'a'aitsikatsie nemuyutemawiekɨ.   
\q1
\v 78 Memuyuti'ɨre meke'utewiyatsitɨarieni yakɨ xeikɨa memɨnetsiniukimakɨ,  
\q2 ne matsi, 'a'aitsika nepuku'eriwani.   
\q1
\v 79 Kemɨ'ane memɨmetsi'ayemakaxe mekenetsi'utinɨni,  
\q2 kemɨ'ane 'a'aitsika memɨmate.   
\q1
\v 80 Ne'iyari heitseriemekɨ keyukɨhɨaweni 'a'aitsikatsie,  
\q2 ne nemɨkatewiyatsitɨarienikɨ hatsuaku.   
\b  
\q1
\v 81 'Awikweitsitɨarika netakwewietɨ netukari pɨtixɨxime.  
\q2 'Aniuki kemaine mɨpaɨ nekatinita'ikwewani.   
\q1
\v 82 Kepemutayɨkɨ neta'ikwewatɨ nepɨkaheuniereri,  
\q2 meta mɨpaɨ nekaniutaineni: «¿Kepaukari pepunuani penetsinɨtɨanike?»   
\q1
\v 83 Nawi kɨxauriyari hepaɨ nepɨtiyuxexeiya kɨtsikɨ mɨyɨxaɨye,  
\q2 peru 'a'aitsika kemaine nepɨkahatɨmaiya.   
\q1
\v 84 ¿Kepaɨmexɨa 'akuxi 'ikɨ ti'a'uximayatsiriwame 'apuyeikani?  
\q2 ¿Kepauka memɨnetsi'aye'unie pepɨtiwarakapitɨani?   
\q1
\v 85 Putsu mekaniutiwewieni memuyuti'ɨre muwa nemeukawenikɨ,  
\q2 'a'aitsika kemaine mɨpaɨ memɨkatekahu.   
\q1
\v 86 Naitɨ 'a'aitsika yuri paine,  
\q2 keneneuparewi 'atsinekatiyurienekaku, memɨnetsi'uweiyakɨ menetsi'itatɨ.   
\q1
\v 87 'Etsiwatɨkaku kwiepa mepɨnetsi'ukumaweriyaxɨ nemɨka'uyeikanikɨ,  
\q2 peru ne 'a'aitsika nepɨka'uku'e'eiriwa.   
\q1
\v 88 'Anaki'eriya mɨmariwekɨ tukari keneneupitɨa,  
\q2 hikɨ 'ana 'a'aitsika nepaye'atɨani.   
\b  
\q1
\v 89 Yawé, 'aniuki yuheyemekɨ pɨ'ayumieme,  
\q2 meta muyuawitsie 'aniuki pɨ'enierie.   
\q1
\v 90 'Ekɨ 'aheyemekɨ yapepɨtikamie,  
\q2 kepauka kwie pemutawewi, heitseriemekɨ 'aixɨa pɨyɨ.   
\q1
\v 91 Hikɨ naitɨ pɨtixuawe, kepemɨtiu'aitaxɨ,  
\q2 yunaitɨ mematsi'enietɨ yamekateniyurieka.   
\q1
\v 92 Xɨka 'a'aitsika kanetsitemawieritɨakake,  
\q2 hiwerikakɨri nekaniumɨnike.   
\q1
\v 93 'A'aitsika hatsuaku nepɨkahatɨmaiya,  
\q2 mɨkɨkɨ tukari pemɨnetsi'upitɨakɨ.   
\q1
\v 94 'Ahetsɨa nepɨmieme, keneneutawikweitsitɨa,  
\q2 meta 'a'aitsika nemukuwaunekɨ neheye'atɨanike.   
\q1
\v 95 'Axateyuruwamete mepɨnetsihupietɨwe menetsimienike,  
\q2 peru ne tawarita 'a'aitsikakɨ nepɨtɨrɨkariyarieni.   
\q1
\v 96 Mɨpaɨ nepɨretima tita mɨtiheitserie 'apu'axe,  
\q2 peru 'a'aitsikate hawaikɨ pɨkahau'atɨka.   
\b  
\q1
\v 97 Yemekɨ ne waɨkawa 'a'ɨkitsika nepɨnaki'erie.  
\q2 Tukarikɨ mɨkɨ xeikɨa nepuku'eriwa.   
\q1
\v 98 'A'aitsikate waɨkawa netimaiweme pɨnetsi'ayeitɨa keyuri memɨnetsi'aye'unie,  
\q2 matsi mɨkɨ yuheyemekɨ nehetsiemieme mɨhɨkɨkɨ.   
\q1
\v 99 Matsi waɨkawa nepɨtimaiwe nete'ɨkitɨwamete nepɨwara'iwa,  
\q2 'a'aitsika xeikɨa nemuku'eriwakɨ.   
\q1
\v 100 Ne matsi waɨkawa nepɨtiuyemate keyuri 'ukirawetsixi,  
\q2 'a'aitsika kemaine mɨpaɨ nemɨtikamiekɨ.   
\q1
\v 101 Ne huye 'axamɨ'anene nepɨka'uweiya,  
\q2 'aniuki nemaye'atɨwanikɨ.   
\q1
\v 102 'A'ɨkitsika nepɨka'uku'e'eiriwa,  
\q2 'ekɨ mɨpaɨ pemɨneti'ɨkitɨakɨ.   
\q1
\v 103 'Aniuki nenenitsie witsipɨrakaka.  
\q2 Waɨkawa matsi pakaka keyuri xiete kemɨrakaka neteta.   
\q1
\v 104 'A'aitsikatsie netimaiwetɨ nepatɨa,  
\q2 'ayumieme naime mɨti'itawa huyeyari nepɨxani'erie.   
\b  
\q1
\v 105 'Aniuki ne'ɨkatsie kɨxeme kanihɨkɨtɨni,  
\q2 nehuyeta mɨhekɨariwie.   
\q1
\v 106 Ne tɨratu nepuwewi nekɨmana, meta yanepɨra'eriwa:  
\q2 kename 'a'aitsikatsie yanetikayani.   
\q1
\v 107 Yawé, pɨtimɨireri kenemɨtiuka'eniwa,  
\q2 tukari keneneupitɨa 'aniuki kemainekɨ.   
\q1
\v 108 Yawé, kenenaki'erieka 'ikɨ temawierika mawariyari neteta mayeneika,  
\q2 'a'aitsika keneneuti'ɨkitɨa.   
\q1
\v 109 Netukari kaunari 'etsimɨpe hepaɨ pɨ'ane,  
\q2 peru 'a'aitsika nepɨkahatɨtɨmaiya.   
\q1
\v 110 'Axamemɨte'u'iyari mepɨnetsiwiniyatɨwe,  
\q2 peru ne 'a'aitsikate nepɨka'uku'e'eiriwa.   
\q1
\v 111 'A'aitsika nehetsiemieme pɨhɨkɨ yuheyemekɨ,  
\q2 mɨkɨ ne'iyari mepɨtemawieritɨa.   
\q1
\v 112 Nepɨnewaɨriya ne'iyarikɨ 'a'aitsika nemaye'atɨakakɨ,  
\q2 yuheyemekɨ meta kepaɨmexɨa nemɨyurieni.   
\b  
\q1
\v 113 Memɨkate'aye'atɨa nepɨwaxani'erie,  
\q2 peru 'a'ɨkitsika nepɨnaki'erie.   
\q1
\v 114 'Ekɨ netsi'awiwietame pepɨhɨkɨ meta kɨmana nemuyukunarɨma pepɨhɨkɨ,  
\q2 'aniuki kemaine mɨpaɨ nekatinita'ikwewani.   
\q1
\v 115 Xekeneutayeixɨa, 'axaxemɨte'u'iyari,  
\q2 ne Kakaɨyari 'aitsikaya nepaye'atɨani.   
\q1
\v 116 Kepemutayɨ keneneparewieka, mɨpaɨ nepɨtiwikweka,  
\q2 'ahetsie kenemɨtitakwewie pepɨka'ikupatani.   
\q1
\v 117 Nehetsie kenenuaka, ne mɨpaɨ netiwikwetɨ,  
\q2 yuheyemekɨ 'ana 'a'aitsikatsie yanepɨtikamieni.   
\q1
\v 118 'Ekɨ pepɨkawanaki'erie kemɨ'ane 'a'aitsika memuku'eiri,  
\q2 'iyaritɨarika kwamanarika memuwewiekɨ xeikɨa.   
\q1
\v 119 Kwiepa memɨtama memɨkametsihetimaiwawe xatsi hepaɨ pekatiniwaxeiyani,  
\q2 ne 'ayumieme 'a'aitsika nepɨnaki'erie.   
\q1
\v 120 Marikakɨ 'ahɨxie nepɨyɨyɨaka,  
\q2 yaxeikɨata 'a'aitsika ne'ayemakatɨ.   
\b  
\q1
\v 121 Ne heitseriemekɨ yanekatinikamieni kehepaɨ 'aixɨa mɨ'ane,  
\q2 pepɨkanetsi'eirieka memɨnetsi'aye'unie memɨnetsi'axekɨ.   
\q1
\v 122 'Ikɨ ti'a'uximayatsiriwame 'aixɨa mɨtikanikɨ yaketineuyuri,  
\q2 memuyuti'ɨre mepɨkanetsi'uximatɨaka.   
\q1
\v 123 Nemetsitakwewietɨ pemɨnetsitawikweitsitɨanikɨ nepɨkaheuniere,  
\q2 neta'ikwewatɨ pemeye'atɨanikɨ ke'aixɨa pemɨti'aitakɨ.   
\q1
\v 124 Ti'a'uximayatsiriwame hetsie yaketineuyuri waɨkawa kepemɨtiuyukanaki'eriekɨ,  
\q2 'a'aitsika keneneuti'ɨkitɨa.   
\q1
\v 125 Ne ti'a'uximayatsiriwame nepɨhɨkɨ: nemɨreutamaiwenikɨ keneneupitɨa,  
\q2 'ana 'a'aitsika nekanetimaimɨkɨ.   
\q1
\v 126 Yawé, 'ari tukari paye'a yapemɨtiyurienikɨ,  
\q2 matsi 'a'aitsika nixewitɨ pɨka'aye'atɨa.   
\q1
\v 127 Nitixaɨtɨ 'ena kwiepa timieme nepɨkatinaki'erie, matsi 'a'aitsika xeikɨa nepɨnaki'erie,  
\q2 huru kenemɨkatinaki'erie, huru 'aixɨa mɨ'itɨarie reuyeta.   
\q1
\v 128 'Ayumieme 'a'aitsikate nepuku'eriwa  
\q2 peru kwamanarika nepɨtixani'erie.   
\b  
\q1
\v 129 Naitɨ 'a'aitsikate pɨmamariwawe,  
\q2 'ayumieme naime nepaye'atɨa.   
\q1
\v 130 Kepauka 'aniuki mukuxaxatsiwa mɨkɨ katanihekɨariwiyani,  
\q2 meta 'atsimɨkatimate kaneitimaitɨyeikani.   
\q1
\v 131 Waɨkawa nehauharimɨtɨ nepikuwaune,  
\q2 neteni nepanutayepiwa nehanatiwakitɨ,  
\q2 yemekɨ nemeimaimɨkɨkɨ 'a'aitsika.   
\q1
\v 132 Kenenaye'eri, keneneutinenimayata  
\q2 yaxeikɨa kepemɨtiwanenimaya memɨmetsinaki'erie.   
\q1
\v 133 Keneneuwitɨximeni kepemutayɨ 'aniukikɨ,  
\q2 pepɨkanetsipitɨaka 'axamɨti'ane mɨnetikuyuitɨwanikɨ.   
\q1
\v 134 Keneneɨxɨna teɨteri kememɨnetenanaimakɨ,  
\q2 karikɨ ne nepeye'atɨani 'a'aitsika.   
\q1
\v 135 Nehetsie pematsiɨkɨtɨ kene'ayeitɨa ke'aixɨa pemɨtiuka'iyari,  
\q2 'a'aitsika keneneuti'ɨkitɨa.   
\q1
\v 136 Haa hepaɨ ne'ukai pɨtiuhapane,  
\q2 'a'aitsika mɨka'aye'atɨariwakɨ.   
\b  
\q1
\v 137 'Ekɨ Yawé, heitseriemekɨ pepɨti'uximaya,  
\q2 meta 'a'aitsikate pɨheitserietɨka.   
\q1
\v 138 'A'aitsikate 'aixɨa pɨ'anene kepemɨtiuta'aitaxɨ,  
\q2 'aixɨa pɨ'ane hetsiena temɨtewiyanikɨ.   
\q1
\v 139 Ne'ɨtetsatɨ nepɨha'a,  
\q2 memɨnetsi'aye'unie 'aniuki memɨka'eniekɨ.   
\q1
\v 140 Kepemutayɨ 'aniukikɨ puta'inɨatsie waɨkawa,  
\q2 'ayumieme ne nepinaki'erie.   
\q1
\v 141 Tsepa ne nitixaɨtɨ nemɨkatihɨkɨ meta nemɨxani'eriwa,  
\q2 peru ne 'a'aitsika nepɨkahatɨtɨmaiya.   
\q1
\v 142 Heitseriemekɨ kepemɨtiyuriene 'aixɨa peti'aitatɨ yuheyemekɨ,  
\q2 'a'aitsika yuri kanaineni.   
\q1
\v 143 'Uximatɨarika meta hiwerika nepexeiya,  
\q2 peru 'a'aitsika pɨnetsitemawieritɨa.   
\q1
\v 144 'A'aitsikate yuheyemekɨ heitseriemekɨ pɨtikuxata,  
\q2 nereutamaiwetɨ nemuyeikanikɨ keneneupitɨa.   
\b  
\q1
\v 145 Yemekɨ naime ne'iyarikɨ nekamenahɨaweni, Yawé,  
\q2 keneneuta'eiya, 'ana 'a'aitsika nepaye'atɨani.   
\q1
\v 146 Nepɨmetsihahiwiwa: «Keneneutawikweitsitɨa».  
\q2 'A'aitsikate nepaye'atɨani.   
\q1
\v 147 Ximeri paitɨ nepanukukeka nemetsitawawirienike parewiya,  
\q2 ne 'aniukitsie nepaɨwaɨre neta'ikwewatɨ.   
\q1
\v 148 Tɨkarikɨ nepɨkatikukutsu,  
\q2 'aniuki neku'eriwatɨ kepemutayɨ.   
\q1
\v 149 'Anaki'eriya mɨmariwekɨ neniuki keneu'eni,  
\q2 Yawé, kepemɨti'aitakɨ tukari keneneupitɨa.   
\q1
\v 150 Memɨnetsi'aye'unie 'axamemɨte'u'iyari 'ahurawa mekaniu'uwaniri,  
\q2 peru 'a'aitsika hepaɨtsita 'ateewa mekaniu'uwani.   
\q1
\v 151 Yawé, 'ekɨta 'ahurawa pekaniuyeikani,  
\q2 meta naitɨ 'a'aitsikate kemutiyuane kaniyuritɨni.   
\q1
\v 152 Mɨixa nepuyurieri 'a'aitsika nematetɨ,  
\q2 peminetɨa yuheyemekɨ mɨ'ayumiemetɨnikɨ.   
\b  
\q1
\v 153 Keneneuxeiya kenemɨtiuka'eniwa, keneneutawikweitsitɨa,  
\q2 ne matsi 'a'aitsika kemaine nepɨkahatɨmaiyawe.   
\q1
\v 154 Nehetsie keneutanua, keneneutawikweitsitɨa,  
\q2 kepemutayɨkɨ tukari kenenepitɨaka.   
\q1
\v 155 'Axateyuruwamete wahetsiemieme 'apeteewa wikweitsitɨarika,  
\q2 mɨkɨ 'a'aitsika memɨkakuwautɨwekɨ.   
\q1
\v 156 Yawé, waɨkawamekɨ pepɨtiyukanenimaya,  
\q2 tukari keneneupitɨa kepemɨti'aitakɨ.   
\q1
\v 157 Memɨnetsi'aye'unie mepɨyumɨire meta memɨnetsi'uweiya,  
\q2 peru ne 'a'aitsikate nepɨka'uku'e'eiriwa.   
\q1
\v 158 Kepauka memɨteyukwamana nemɨwakuxexeiya nepekahayamɨkatɨyeika,  
\q2 'aniuki memɨkahaye'atɨakɨ.   
\q1
\v 159 Yawé, neuxei keneneuxeiya 'a'aitsikate waɨkawa kenemɨtinaki'erie,  
\q2 waɨkawa kepemɨtiyukanaki'eriekɨ, tukari keneneupitɨa.   
\q1
\v 160 Naitɨ 'aniuki heitseriemekɨ yurikɨ pɨtikuxata xeikɨa,  
\q2 kepemɨti'aita yuheyemekɨ kani'ayumiemetɨni.   
\b  
\q1
\v 161 Yakɨ xeikɨa mepɨnetsi'uweiya teɨteri memamariwawetɨ,  
\q2 matsi 'aniuki xeikɨa nepayemakaxe.   
\q1
\v 162 Ne nepɨnetemawie 'aniukikɨ kepemutayɨ,  
\q2 tewi waɨkawa mɨtiukaxei kemɨtiyutemawie hepaɨ.   
\q1
\v 163 Yemekɨ nepixani'erie naime 'itarika,  
\q2 matsi waɨkawa 'a'aitsika nepɨnaki'erie.   
\q1
\v 164 Xeitukaritsie 'atahutamexɨa nepɨmetsinɨawani,  
\q2 ke'aixɨa pemɨti'aitakɨ.   
\q1
\v 165 Kemɨ'ane 'a'aitsika memɨnaki'erie yemekɨ 'aixɨa 'iyari mekaniu'uwani,  
\q2 nitixaɨtɨtsie mepɨkatehekaxɨrɨwe.   
\q1
\v 166 Yawé, ne 'awikweitsitɨarika nepɨtakwewie  
\q2 meta yanepɨtiyuriene 'a'aitsikate kemaine.   
\q1
\v 167 Naime ne'iyarikɨ 'a'aitsikate nepaye'atɨa.  
\q2 Waɨkawa nepeinaki'erie.   
\q1
\v 168 'A'aitsikate nepeu'enie,  
\q2 'ekɨ naime nehuye pemɨmatekɨ.   
\b  
\q1
\v 169 Nehiwerika hiwariyari pekehe'enieni,  
\q2 Yawé, nereutamaiweme kenenayeitɨa, 'aniuki kemainekɨ.   
\q1
\v 170 Waɨkawa kenemɨmetiwawirie pekenetsihe'enieni,  
\q2 keneneuxɨna, kepemutayɨkɨ.   
\q1
\v 171 Ne nemetsinɨawatɨ nepɨkatihayewani,  
\q2 'ekɨtsɨ 'a'aitsikate pekaneni'ɨkitɨaka.   
\q1
\v 172 'Aniuki 'aixɨa manɨyɨne nepitakwika,  
\q2 naitɨ 'a'aitsikate heitseriemekɨ mɨtikuxatakɨ.   
\q1
\v 173 'Atɨrɨkariyakɨ keneneuparewi,  
\q2 ne 'a'aitsikate nemanayexeikɨ.   
\q1
\v 174 Yawé, ne 'awikweitsitɨarika yemekɨ nepeuyehɨwa.  
\q2 'A'aitsikate pɨnetemawierika.   
\q1
\v 175 Tukari 'akuxi keneneupitɨa nemetsinɨawatɨ 'anemuyeikanikɨ,  
\q2 kepemɨti'aita kenetsi'uparewieni.   
\q1
\v 176 Muxa meuyewe hepaɨ nekaniuyɨni,  
\q2 kenaye'a ti'a'uximayatsiriwame kenawaumie,  
\q2 'a'aitsikate nemɨkahatɨmaiyawekɨ.   
\c 120  
\d Ku'uwamete wakwikari.  
\q1
\v 1 Kepauka nemɨtiuka'eniwa Yawé nepahɨawe,  
\q2 mɨkɨta pɨnetsiku'eiya.   
\q1
\v 2 Yawé, keneneutawikweitsitɨa memɨte'itawa menetsi'uweiyakaku  
\q2 meta 'iya kwinimieme memɨteheuta'itawawe.   
\b  
\q1
\v 3 Xeme xemɨte'itawa,  
\q2 Kakaɨyari 'uxa'atɨni  
\q2 waɨkawa xehetsie pɨrahɨani.   
\q1
\v 4 Kuyaxi wa'ɨrɨ kwinimieme mɨranuyemɨtsɨkɨ,  
\q2 tɨɨ waɨkawa tatɨkaimekɨ.   
\b  
\q1
\v 5 Xɨa'ui ne, 'ateewa nemuyeika Metseki kwieyaritsie,  
\q2 'ena nemuka Tseraxi 'ixuriki kiiyari mati'u.   
\q1
\v 6 Mɨixari 'ena nepuka  
\q2 kayuwatɨ memu'uwani mɨkawanake wahetsɨa.   
\q1
\v 7 Ne kaneninakeni kayuwatɨ heitseriemekɨ nemuyeikanikɨ,  
\q2 peru xɨka kayuwatɨ kehepaɨ temɨte'u'uwanikɨ netikuxatani,  
\q2 mɨkɨta kuyaxa pɨta mepukuxatani.   
\c 121  
\d Ku'uwamete wakwikari.  
\q1
\v 1 Hɨrite 'amutɨtɨ kwi nepautixeiya,  
\q2 nepɨneku'iwawiya: ¿Keraneni netsiparewiwame?   
\q1
\v 2 Netsiparewiwame Yawé kanihɨkɨtɨni,  
\q2 kwie meta muyuawi mɨtiutiwewi.   
\b  
\q1
\v 3 Pɨkametsipitɨani pemekawautsenikɨ,  
\q2 kemɨ'ane mɨmetsi'ɨwiya pɨkakutsu.   
\q1
\v 4 Hatsuaku pɨkaheukukutsu nipɨkaheukuni,  
\q2 kemɨ'ane 'ixaheritsixi muwa'ɨwiya.   
\b  
\q1
\v 5 Yawé kanihɨkɨtɨni mɨmetsi'ɨwiya,  
\q2 Yawé kameni'etɨriwiyani 'ahetsie kaninuaka.   
\q1
\v 6 Tukarikɨ tau pɨkametikwinitɨani,  
\q2 meta yaxeikɨa metsa yɨwikɨta.   
\b  
\q1
\v 7 Yawé 'ahetsie kaninuakamɨkɨ,  
\q2 'atukari kani'ɨwiyakamɨkɨ naime 'axamɨti'ane hepaɨtsita.   
\q1
\v 8 Yawé 'akie pɨmetsi'ɨwiyani meta 'ahuyeta,  
\q2 hikɨtɨtɨ meta yuheyemekɨ.   
\c 122  
\d Ku'uwamete wakwikari. Rawiri nɨawarieya.  
\q1
\v 1 Ne nepuyukatemawiwa kepauka mɨpaɨ nemɨrahɨawarɨwa:  
\q2 «Hikɨmɨ Yawé tukieyata tepuhu».   
\q1
\v 2 Kerutsareme, 'ari tekaniu'axɨani  
\q2 'ena 'akitenie tekaniuti'uka.   
\b  
\q1
\v 3 Kerutsareme, kiekari 'aixɨa 'anemekɨ mɨwewiya  
\q2 mana yunaitɨ memuyukuxexeɨriwanikɨ.   
\q1
\v 4 Mana nuiwarite mekani'axeni,  
\q2 nuiwarite Yawé hetsɨa miemete,  
\q1 Yawé 'aixɨa metetahɨaweke 'aixɨa kemɨtiuka'iyari wahetsiemieme,  
\q2 kehepaɨ 'aneme 'Ixaheri 'aitsika mɨyetuiriyariekai.   
\b  
\q1
\v 5 Mana kanihɨkɨtɨni 'aixɨa mɨtikɨyɨne 'ixaheritsixi wahetsiemieme,  
\q2 Rawiri nuiwarimama waparatsiyu mana kaniuweni.   
\b  
\q1
\v 6 Kerutsareme hetsiemieme tepuyunenewieka kayuwatɨ mexeiyanikɨ:  
\q2 «'Aixɨa 'anemekɨ memu'uwanikɨ kemɨ'ane memɨmetsinaki'erie.   
\q1
\v 7 Kerutsareme kuraruyarita memɨye'uwa kayuwatɨ mekehexeiyani,  
\q2 meta 'aparatsiyuta 'aixɨa me'itɨarietɨ».   
\q1
\v 8 Hikɨta, ne'iwama meta nehamikuma wahetsiemieme mɨpaɨ nepaine:  
\q2 «'Aixɨa 'anemekɨ meke'u'uwani».   
\q1
\v 9 Kerutsareme, 'ahetsɨa muwekɨ Yawé takakaɨyari tukieya  
\q2 nepɨtikuwauni 'aixɨa mɨti'ane 'ahetsiemieme.   
\c 123  
\d Ku'uwamete wakwikari.  
\q1
\v 1 Ne 'ahetsɨa xeikɨa nepautiniere,  
\q2 muyuawitsie 'a'uweni 'apuwe, mana xeikɨa nepeuti'ikwewa.   
\q1
\v 2 Waɨriyarika te'uximayatamete kememɨteta'ikwewa  
\q2 yukutsiyari niukieyakɨ yumamakɨ warahɨawekaku,  
\q1 meta 'ukaratsi waɨriyarika ti'uximayatame kemɨtita'ikwewa,  
\q2 mɨti'uximayatsirie 'ɨyaya niukieya yumamakɨ hehɨawekaku,  
\q1 mɨpaɨta tame tepɨteta'ikwewa Yawé takakaɨyari hetsie,  
\q2 kepaukake mɨkɨ mɨtatsitinenimayata.   
\b  
\q1
\v 3 Yawé ketaneutinenimayata, ketaneutinenimayata,  
\q2 'ari tepu'u'uxe ketemɨtenanaimarie.   
\q1
\v 4 Mɨixari tepɨte'uka'eniwa teyuriyarietɨ,  
\q2 'ari mɨixamexɨa mepɨtatsi'utiti memuyutimariwekata,  
\q2 meta waɨkawamexɨari mepɨtatsi'unanaima memɨyuti'ɨre.   
\c 124  
\d Ku'uwamete wakwikari. Rawiri nɨawarieya.  
\q1
\v 1 'Ayumieme hikɨ 'ixaheritsixi yaxeikɨa xekeneutiyuaneni:  
\q2 —Xɨka Yawé tahetsie ka'utanuanike,   
\q1
\v 2 keteyɨakake xɨka Yawé tahetsie ka'utanuanike  
\q2 kepauka yunaitɨ kwiepa memɨtama metatsi'aye'unietɨ memakɨtsie,   
\q1
\v 3 teyunaime te'ayeneniereme mepɨtatsi'anukaxɨxɨanikekai  
\q2 kepauka memuyeha'atsie tahepaɨtsita,   
\q1
\v 4 haa tahetsie muwayeneni hepaɨ tepɨyɨnikekai,  
\q2 temehauxɨani hepaɨ tepɨyɨnikekai,   
\q2
\v 5 haa mɨtɨrɨkaɨye hepaɨ teyunaime mepɨtatsiheuyehɨanikekai.   
\b  
\q1
\v 6 Yawé hepaɨtsita 'aixɨa keraniuwani, mɨkɨ mɨkawarupitɨakɨ  
\q2 yutametekɨ memɨtatsititsanakɨ.   
\q1
\v 7 Wikixi wahepaɨ, tekateniyutawikweitsitɨani,  
\q2 tixɨ'erɨwame winiyarieyatsie,  
\q1 winiyari kaniutatsane,  
\q2 hikɨ tame takaniuyuta'una.   
\q1
\v 8 Yawé tatsiparewiwame kanihɨkɨtɨni,  
\q2 muyuawi mutawewi meta kwie.   
\c 125  
\d Ku'uwamete wakwikari.  
\q1
\v 1 Yawé hetsie kemɨ'ane yuri memɨte'erie  
\q2 hɨri Tsiyuni hepaɨ mekani'aneni,  
\q1 hatsuaku tɨma mɨkakuyuitɨarieni,  
\q2 yuheyemekɨ 'amuka.   
\q1
\v 2 Kerutsareme yemurite 'auriena matetɨka kemɨreinatɨka,  
\q2 mɨpaɨta Yawé yuteɨterima katiniwareukunaka,  
\q2 hikɨtɨtɨ meta yuheyemekɨ.   
\b  
\q1
\v 3 'Axateyuruwamete mepɨkateta'aita  
\q2 Kakaɨyari teɨterimama wahetsie,  
\q1 heitseriemekɨ memu'uwa hatsuaku  
\q2 'axamemɨkateheyuriekakɨ.   
\b  
\q1
\v 4 Yawé, 'aixɨa keniwayurieka 'aixɨa memɨte'u'iyari,  
\q2 kemɨ'ane 'iyari mɨheitserie memexeiya.   
\q1
\v 5 Peru kemɨ'ane huye mututuni 'utɨa memuhu,  
\q2 Yawé, keniwaranuyexɨri, 'axateyuruwamete wahamatɨa.  
\b  
\q1 'Ixaheri kwieyaritsie kayuwatɨ ke'umaka.   
\c 126  
\d Ku'uwamete wakwikari.  
\q1
\v 1 Kepauka Yawé, memehapaniekai mɨwarupitɨa, Tsiyuni memɨ'axɨanikɨ,  
\q2 temɨteheinɨka hepaɨ tepɨtenenierekai.   
\q1
\v 2 'Ana temawierika tehexeiyatɨ tepakɨ,  
\q2 meta tepɨkatehayewakai te'utikwitɨ.  
\q1 Hipatɨ nuiwarite mɨpaɨ mekaniutiyuanekaitɨni:  
\q2 «Yawé mariwemekɨ wahetsiemieme pɨtiyuriene».   
\q1
\v 3 Huu, Yawé tahetsiemieme mariwemekɨ pɨtiyuriene,  
\q2 hikɨ mɨkɨkɨ waɨkawa tepuyutemamawie.   
\b  
\q1
\v 4 Yawé, hikɨ keniwa'atɨa ta'iwama memehapanie  
\q2 haa 'akitsie kepemɨtiwayenenetɨwa makuwakitsie hepaɨ.   
\q1
\v 5 Kemɨ'ane yu'ukaikɨ memuka'etsa,  
\q2 temawierikakɨ mepɨka'itsana.   
\q1
\v 6 Kemɨ'ane 'utatsuatɨ 'imɨari mɨ'iwiene,  
\q2 yutemawietɨ pɨka'itsana.   
\c 127  
\d Ku'uwamete wakwikari. Tsarumuni nɨawarieya.  
\q1
\v 1 Xɨka Yawé kii ka'utawewieni,  
\q2 yakɨ xeikɨa 'iwewiwamete mekateniyu'uxitɨaka.  
\q1 Xɨka Yawé xeime kiekari ka'ɨwiyani,  
\q2 tɨkarikɨ tehɨwemete yakɨ xeikɨa mekaniyɨaka.   
\q1
\v 2 Yakɨ xeikɨa ximeri paitɨ xekananuku'uweni,  
\q2 meta yakɨ xeikɨa 'arike xekaniukahipiteni,  
\q1 meta yakɨ xeikɨa kwinimieme xekateni'uximayaka 'ikwai xemɨte'ukaxexeiyanikɨ.  
\q2 Karikɨ Kakaɨyari kutsi kaniwapitɨaka pɨta kemɨ'ane mɨwanaki'erie.   
\b  
\q1
\v 3 Tɨɨri 'imikieri mekanihɨkɨtɨni Yawé hetsɨa miemete,  
\q2 tɨɨri tahetsie memɨyekɨka ta'iwarika witsimɨ'ane mekanihɨkɨtɨni.   
\q1
\v 4 Kepauka temaikɨ tɨɨri mɨwarayexeiya  
\q2 yumemiwame 'ɨrɨ kemɨra'ɨ hepaɨ kani'aneni.   
\q1
\v 5 'Aixɨa xepɨ'itɨarie kemɨ'ane 'ɨrɨ 'uitɨwameta xemihɨniya  
\q2 mɨkɨ 'ɨrɨ 'aixɨa mɨ'anenekɨ.  
\q1 Mɨkɨkɨ hatsuaku mepɨkatewiyatsitɨarieni memɨwaraye'unie wahɨxie  
\q2 kepauka memɨtaxanetsieni yemekɨ 'itsɨkate wahɨxie.   
\c 128  
\d Ku'uwamete wakwikari.  
\q1
\v 1 'Aixɨa mepɨ'itɨarie kemɨ'ane Yawé memayemakaxe,  
\q2 kehate huyetana memuhu.   
\q1
\v 2 Peti'uximayatɨ tita pemɨtiukaxexeiyani, mɨkɨkɨ pepɨti'amikwani,  
\q2 'aixɨa 'iyari xepu'uwani meta xepɨte'ukaxexeiyani.   
\q1
\v 3 'A'ɨya 'akie pukani,  
\q2 kaxie nanari witsimɨtixuawe hepaɨ pɨ'aneni,  
\q1 'amexatsie 'aniwema meputiteni,  
\q2 witsimepɨteyuxexeiyani huriwu yɨrameyari hepaɨ.   
\q1
\v 4 Mɨkɨ pɨhɨkɨ tewi 'aixɨa kemu'itɨarieni  
\q2 kemɨ'ane Yawé mayemakaxe.   
\b  
\q1
\v 5 Yawé 'aixɨa kemetsiyurieka Tsiyuni paitɨ,  
\q2 meta peke'uniere Kerutsaremetsie ke'aixɨa mɨtiyɨaneni  
\q2 kepaɨmexɨa tukari pemɨyurieni.   
\q1
\v 6 'Aniwema waniwema pemɨwaxeiyakɨ peke'uyeikani.  
\b  
\q1 'Ixaheri kwieyaritsie kayuwatɨ ke'umaka.   
\c 129  
\d Ku'uwamete wakwikari.  
\q1
\v 1 Hikɨta 'ixaheritsixi mɨpaɨ meke'utiyuani:  
\q2 —Yumɨiretɨ mepɨnetsi'uhiweritɨa temaikɨyaritsie paitɨtɨ,   
\q1
\v 2 yumɨiretɨ mepɨnetsi'uhiweritɨa temaikɨyaritsie paitɨtɨ,  
\q2 peru yemekɨ mepɨkanetsiha'iwawe.   
\q1
\v 3 Newaritsie hararu mepukahatɨkɨ,  
\q2 xuruku meputiwewi heukatetewame.   
\q1
\v 4 Peru Yawé, heitseriemekɨ yamɨtikamie,  
\q2 kaneniuxɨna 'axateyuruwamete menetsihɨakaku.   
\b  
\q1
\v 5 Mekeha'iwarieni meke'utewiyatsitɨarieni  
\q2 yunaitɨ kemɨ'ane Kerutsareme memaye'unie.   
\q1
\v 6 Tupiriya kii heima mieme hepaɨ meke'ɨyɨni,  
\q2 kataweriwetɨ mɨtiwauke,   
\q1
\v 7 tixitekeme tixaɨtɨ pɨkati'axe  
\q2 meta 'ihuruwame tixaɨtɨ pɨkati'axe.   
\q1
\v 8 Wa'aurie memuyekɨka xewitɨ tɨma mɨpaɨ pɨkatiwarahɨaweni:  
\q2 «Yawé xeme 'aixɨa kexeyurieka,  
\q2 Yawé tepɨwawirie 'aixɨa mɨxeyuriekakɨ».   
\c 130  
\d Ku'uwamete wakwikari.  
\q1
\v 1 Yawé, ne yemekɨ 'ekɨ karima nepɨmetsihahɨawe  
\q2 waɨkawa netiuka'eniwatɨ kwie 'ameukatewatsie.   
\q1
\v 2 Ti'aitame, neniuki keneu'eni.  
\q2 Yemekɨ heitseriemekɨ keneneu'eni waɨkawamekɨ kenemetiwawirie.   
\b  
\q1
\v 3 'Ekɨ Yawé, xɨka naime ke'axatemɨte'uyurikɨ pekatatsixeiriekake,  
\q2 Yawé, ¿kamɨtsɨ kemɨ'ane hetsie pɨkatiuhɨiyawe?   
\q1
\v 4 Peru 'ekɨ pepɨtareuyehɨwiriwa,  
\q2 'ayumieme peuyewetse temɨmetsi'ayemakaxenikɨ.   
\b  
\q1
\v 5 Ne Yawé nepɨtakwewie, ne'iyarikɨ naimekɨ nekanitakwewieka,  
\q2 niukieya kemaine mɨpaɨ nepɨtita'ikwewa.   
\q1
\v 6 Ne'iyarikɨ naimekɨ Yawé nepɨtakwewie,  
\q2 matsi waɨkawa tehɨwemete kememɨkateta'ikwewa ximeri mayanikɨ.  
\b  
\q1 Tehɨwemete ximeri kememɨtetakwewie hepaɨ,   
\q2
\v 7 xemeta mɨpaɨ, 'ixaheritsixi, Yawé xeketenetakwewieka.  
\q1 Hetsiena waɨkawa naki'eriya muxuawekɨ,  
\q2 meta mɨkɨ yurikɨ tatsixɨname mɨhɨkɨkɨ.   
\q1
\v 8 Mɨkɨ 'ixaheritsixi kaniwaxɨnamɨkɨ  
\q2 naime ke'axamemɨte'uyuri hepaɨtsita.   
\c 131  
\d Ku'uwamete wakwikari. Rawiri nɨawarieya.  
\q1
\v 1 Yawé, ne'iyari mariwetɨ pɨkahayuyeitɨwa,  
\q2 meta nehɨxite tiyukatawe'eriekamekɨ pɨkataneniere,  
\q1 meta nepɨkatikuwaune nemɨmariwenikɨ,  
\q2 metatsiere mariweme nemɨtiyurienikɨ nepɨka'ikuwaune kenemɨkatiyɨwe.   
\b  
\q1
\v 2 Matsi pɨta:  
\q2 kayuwatɨ nepɨyupitɨa.  
\q1 Nunutsi hepaɨ nepɨ'ane yumaamatsie meukuka 'utsitsitɨarieka.  
\q2 Ne'iyari nunutsi xike mutsitsitɨarie hepaɨ pɨ'ane.   
\b  
\q1
\v 3 'Ixaheri, Yawé hetsie keneta'ikwewani  
\q2 hikɨ meta yuheyemekɨ.   
\c 132  
\r (Nɨa 132:8-10 – 2Kem 6:41-42)  
\d Ku'uwamete wakwikari.  
\q1
\v 1 Yawé, Rawiri kena'eriwani  
\q2 meta kemɨtiuka'eniwa.   
\q1
\v 2 Kena'eriwani kemɨtiuyuhɨritɨa Yawé hetsɨa,  
\q2 Kakuwu hetsie Mɨtɨrɨkaɨye kemɨtiutahɨawixɨ:   
\q1
\v 3 «Ne nekie nepɨkatayerɨni,  
\q2 meta 'etsiwatɨma ne'utatsie nepɨkaka'uxipieni,   
\q1
\v 4 meta nepɨkaheukuni,  
\q2 'etsiwatɨma nepɨka'anukɨpe,   
\q1
\v 5 xɨka neka'itaxeiyaweni 'akuxi Yawé hakewa  
\q2 tukieya nemetawewieni Mɨtɨrɨkaɨye Kakuwu meyexeiya».   
\b  
\q1
\v 6 'Epɨrata tɨratu kakuniyari teputamari,  
\q2 hikɨ tepeitaxei Yakaxi kwieyaritsie:   
\q1
\v 7 «Hikɨmɨ tekanihuni tukitana paitɨ,  
\q2 hɨxiena tepekatunuma'uni».   
\b  
\q1
\v 8 Yawé, kenanukukexi 'atukita kenenua pemuwaka'uxipienitsie,  
\q2 'ekɨ meta 'atɨratu kakuniyari mɨtɨrɨkaɨye.   
\q1
\v 9 Mawari wewiwamete 'aixɨa meke'uyukuyurieni kemɨreuyewetse.  
\q2 'Ahetsie memɨtewiya mekemetsinɨawani meyutemamawietɨ.   
\q1
\v 10 Rawiri ti'a'uximayatsiriwame pemɨnaki'eriekɨ,  
\q2 pepɨka'iku'e'eiriwani pemenayexei.   
\b  
\q1
\v 11 Yawé Rawiri mɨpaɨ katiniuhɨritɨani  
\q2 mɨkɨ yapɨtikayani pɨka'ipata:  
\q1 «Xeime 'anuiwaritɨme  
\q2 'a'uwenitsie nekanayemɨkɨ.   
\q1
\v 12 Xɨka 'aniwema netɨratu mehaye'atɨani  
\q2 meta ne'aitsikate nemɨwata'ɨkitɨani,  
\q1 hikɨ mɨkɨ waniwema  
\q2 'a'uwenitsie mepayaxe yuheyemekɨ».   
\b  
\q1
\v 13 Yawé, Kerutsareme panayexei,  
\q2 mana yukie mayeitɨanikɨ pinakixɨ, mɨpaɨ putayɨ:   
\q1
\v 14 «'Ena netuki nepɨtakeni yuheyemekɨ,  
\q2 'ena ne'ukaitɨ nepɨtita'aita, mɨpaɨ mɨnetinakekɨ.   
\q1
\v 15 'Aixɨa nepɨtiyurieka 'ikwai 'ikɨ kiekaritsie timieme,  
\q2 meta tixaɨtɨ memɨkatehexeiya 'ikwai nepɨwamikwani.   
\q1
\v 16 Mawari wewiwamete wikweitsitɨarikakɨ nekaniwatikemaritɨamɨkɨ,  
\q2 meta hetsiena memɨtewiya mekanitanɨawakuni meyutemamawietɨ.   
\b  
\q1
\v 17 »Hikɨ tawarita Rawiri tɨrɨkariya nepɨpitɨani,  
\q2 meta nemenayexei kɨxemeya nepɨtaiya.   
\q1
\v 18 Memeye'unie tewiyarika nepɨwapitɨani,  
\q2 peru mɨkɨ matsi kurunaya mariwetɨ payani 'utimerɨkatɨ».   
\c 133  
\d Ku'uwamete wakwikari. Rawiri nɨawarieya.  
\q1
\v 1 Yemekɨ 'aixɨa pɨ'ane meta witsipɨ'ane  
\q2 xɨka 'iwamarixi 'aixɨa 'iyari meyuxeiyatɨ yunaitɨ me'u'uwani.   
\q1
\v 2 Mɨpaɨ xɨkati'aneni witsipɨti'ane, hatseiti mawari  
\q2 wewiwamete wahetsiemieme mɨ'ukweni hepaɨ,  
\q1 witsimɨtiukuke 'Aruni mɨxiyayatsie,  
\q2 wamu'utsie 'akaneikatɨ wakemari manukanenieretsie paitɨ mukaneika.   
\q1
\v 3 Witsipɨ'ane haɨtsi hepaɨ Heximuni hɨriyaritsie mɨkaxɨrɨwe  
\q2 hayari Kerutsareme kiekariyaritsie makayeneika.  
\q1 Hakewa 'aixɨa 'anemekɨ memuyuxeiya,  
\q2 Yawé 'aixɨa kaniwayurieka meta tukari mɨkaxɨwe kaniwapitɨaka.   
\c 134  
\d Kɨkamete wakwikari Kerutsareme memeutikɨka.  
\q1
\v 1 Yawé hetsiemieme 'aixɨa xekenaitɨkani xeme yunaitɨ te'i'uximayatsiriwamete,  
\q2 yɨwikɨta Yawé tukieyata xemeyexeiya.   
\q1
\v 2 Yumamate tukita xekeneutatseraxɨa meta  
\q2 Yawé hetsiemieme 'aixɨa xekenaitɨkani.   
\q1
\v 3 Yawé Tsiyuni paitɨ 'ukaitɨ, muyuawi meta kwie mutawewi,  
\q2 'aixɨa kexeyurieka.   
\c 135  
\r (Nɨa 135:15-20 – Nɨa 115:4-11)  
\q1
\v 1 Yawé kenɨawarieka.  
\b  
\q1 Yawé xekenenɨawani.  
\q2 Yawé te'uximayatsiriwamete, xekenenɨawani.   
\q1
\v 2 Xeme Yawé tukita yaxemɨteye'uwa,  
\q2 meta takakaɨyari tukieya takwayaritsie.   
\b  
\q1
\v 3 Yawé xekenenɨawani, karikɨ mɨkɨ 'aixɨa katiniuka'iyarini,  
\q2 nɨawari hetsiena mieme xekeneutikwikani, mɨpaɨ katininakeni.   
\q1
\v 4 Yawé Kakuwu panayexei yuhetsiemieme mayeitɨanikɨ,  
\q2 'ixaheritsixi teɨterimama memakɨnekɨ.   
\q1
\v 5 Ne mɨpaɨ nepɨtimate Yawé, tati'aitɨwame,  
\q2 matsi pumariwe keyuri hipatɨ kakaɨyarixi.   
\q1
\v 6 Yawé naime yapɨtiyuriene kemɨtinake,  
\q2 taheima muyuawitsie meta 'ena kwiepa,  
\q2 haramaratsie meta naitsarie meukatetewatsie.   
\q1
\v 7 Kwie manu'axetsie paitɨ haiwitɨri panuku'enitsitɨwa,  
\q2 mimierikari peyenɨ'awa wiyeritsata  
\q2 metatsiere 'eka pewatiyepiwa muye'ɨnetsie.   
\b  
\q1
\v 8 'Ekipitutari waniwema mexɨakate kaniwarukwini,  
\q2 teɨteri waniwema meta tewaxi waniwema.   
\q1
\v 9 'Ekipitu kwieyaritsie,  
\q2 Kakaɨyari 'inɨari mamariwaweme kanenɨ'ani  
\q2 Parahuni hetsie meta yunaime te'i'uximayatsiriwamete wahetsie.   
\q1
\v 10 Yumɨireme nuiwarite kaniwarukwini,  
\q2 te'aitamete metɨrɨkawime kaniwarukwini.   
\q1
\v 11 Tsikuni, 'amuxeutsixi tiwa'aitɨwame,  
\q2 ti'aitame 'Uhuki Watsani kwieyaritsie,  
\q2 meta yunaime te'aitamete Kanani memɨtamakai.   
\q1
\v 12 Mɨkɨ wakwie kaniyetuani,  
\q2 'ixaheritsixi wakwie mayanikɨ yuheyemekɨ.   
\b  
\q1
\v 13 Yawé, 'ekɨ yuheyemekɨ 'apekaniuyeikani,  
\q2 'aheyemekɨ 'aheyemekɨ 'apepuweni.   
\q1
\v 14 Yurikɨ Yawé yuteɨterima wahetsie kanitanuamɨkɨ,  
\q2 meta te'i'uximayatsiriwamete kaniwatinenimayatamɨkɨ.   
\b  
\q1
\v 15 Nuiwarite wakakaɨyarixima huru pɨrata mekanihɨkɨtɨni,  
\q2 tewi wewiyaya mepɨhɨkɨ.   
\q1
\v 16 Meputeni, peru mepɨkaniuwawe,  
\q2 mepɨhɨxi, peru mepɨkaheuneniere,   
\q1
\v 17 mepunaka, peru mepɨkaheu'enana,  
\q2 nitɨma 'eka mepɨkahexeiya yuteta.   
\q1
\v 18 Kemɨ'ane memɨwatiwewiwa, mɨkɨ wahepaɨ mepɨ'anene,  
\q2 meta yunaitɨ kemɨ'ane wahetsie yuri memɨte'erie.   
\b  
\q1
\v 19 'Ixaheritsixi, Yawé hetsie 'aixɨa xekenaitɨkani,  
\q2 'Aruni xiɨyarimama, Yawé hetsie 'aixɨa xekenaitɨkani,   
\q1
\v 20 Rewi nuiwarimama, Yawé hetsie 'aixɨa xekenaitɨkani,  
\q2 kemɨ'ane xemeyemakaxe, Yawé hetsie 'aixɨa xekenaitɨkani.   
\q1
\v 21 Tsiyuni paitɨ Yawé 'aixɨa xeketenahɨaweni,  
\q2 Kerutsaremetsie mɨkie.  
\b  
\q1 Yawé kenɨawarieka.   
\c 136  
\q1
\v 1 Yawé pamɨpariyutsi xekenepitɨaka, karikɨ mɨkɨ 'aixɨa katiniuka'iyarini,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 2 Pamɨpariyutsi xekenepitɨaka Kakaɨyari mumariwe kakaɨyarixi kememɨka'anene,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 3 Pamɨpariyutsi xekenepitɨaka te'aitamete Tiwa'aitɨwame,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 4 Mɨkɨ xeikɨa mariweme mɨtiwewiwe,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 5 Timaiwetɨ muyuawi mutawewi,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 6 Kemɨ'ane kwie mutaweraxɨ haramara hetsie,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 7 Kemɨ'ane muyuawitsie memeukatei muwarunetɨa memɨhekɨariwie,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 8 Tau munetɨa mɨhekɨariwiekakɨ tukarikɨ,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 9 Metsa meta xurawetsixi, tɨkarikɨ memɨhekɨariwiekakɨ,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 10 Kemɨ'ane 'ekipitutari waniwema mexɨakate mɨwarukwi,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 11 'Ixaheritsixi 'Ekipitu muwarayewitɨ,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 12 Yumamá mɨtɨrɨkaɨye tatseratɨ,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 13 Kemɨ'ane Haramara Mɨxeta manutayepi,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 14 Hixɨapa muwaruwitɨtɨya 'ixaheritsixi,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 15 Parahuni meta kuyaximama Haramara Mɨxeta hetsie mɨwarukayunitɨa,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 16 Kemɨ'ane makumawetsie yuteɨterima muwaruyewitɨtɨya,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 17 Memamariwaweme te'aitamete mɨwaruka'unaxɨ,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 18 Te'aitamete memɨte'ayu'iwa mɨwarukwi,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 19 Tsikuni, 'amuxeutsixi tiwa'aitɨwame mumi,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 20 Ti'aitame 'Uhuki Watsani kiekame mumi,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 21 Mɨkɨ wakwie yuteɨterima kaniwayetuirieni,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 22 Mɨkɨ 'ixaheritsixi te'i'uximayatsiriwamete mɨtiwarutapitɨa,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 23 Hatsuaku mɨkatatsihatɨtɨmaiya, tsepa haweri temu'itɨarie,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 24 Memɨtatsi'aye'unie wahetsɨa mɨtatsiwikweitsitɨa,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 25 Yunaime memɨte'ayeneniere mɨtiwamikwa,  
\qr \it mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\q1
\v 26 Kakaɨyari muyuawitsie makawe pamɨpariyutsi xekenepitɨaka.  
\qr \it Mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ\it*.   
\c 137  
\q1
\v 1 Wawiruniya hatetsitayaritsie tepetiyaxikekai,  
\q2 'ana Kerutsareme teha'eriwatɨ tepetitsuanakai.   
\q1
\v 2 Mɨkɨ Kiekaritsie hapuri kɨyeyari meti'utsie  
\q2 mana takanarite tepeɨkɨwɨwɨtɨwakai.   
\q1
\v 3 Mana kiekatari memɨtatsi'upɨretsutaxɨ,  
\q2 mepɨtatsihe'aitɨakai kwikari temetikwikakɨ,  
\q1 tate'uximayatsitɨwamete xekeneyutemamawieka mepɨtatehekɨhɨawekai,  
\q2 mɨpaɨ mepɨtatehetihɨawekai: «Xekeneutakwika tahetsiemieme xeime kwikari Kerutsareme mieme».   
\b  
\q1
\v 4 Tame tepɨkayɨwawe kwikari Yawé hetsiemieme  
\q2 temutikwikani xeime kwieyaritsie paitɨ.   
\q1
\v 5 Kerutsareme, Kerutsareme,  
\q2 xɨka ne 'uxa'atɨni nemetsihatɨmaiyake,  
\q2 nemamá netserie mieme ke'utawani.   
\q1
\v 6 Xɨka nekametsiha'eriwatɨ nehayani,  
\q2 netemawierikakɨ xɨka nemetsihatɨmaiya,  
\q2 neneni ke'anatixitekieni.   
\b  
\q1
\v 7 Yawé, 'erumitsixi keniwara'eriwani,  
\q2 kepauka Kerutsareme muka'unixɨ.  
\q1 Mɨpaɨ mepɨte'uhiwakai: «Naime, naime  
\q2 xekeneuka'una tsutɨmeyari 'ɨarime».   
\b  
\q1
\v 8 'Ekɨta Wawiruniya niweya, 'uxa'atɨni pekanika'unariemɨkɨ,  
\q2 'aixɨa ke'itɨarieka kemɨ'aneta 'ekɨ  
\q2 mɨmetsika'una kepemɨtatsi'uyuri tame.   
\q1
\v 9 'Aixɨa ke'itɨarieka kemɨ'ane tɨɨri muwatiwiya  
\q2 meta 'aitsie muwatitetsewani.   
\c 138  
\d Rawiri nɨawarieya.  
\q1
\v 1 Yawé, ne ne'iyarikɨ nepɨmetsinɨawani,  
\q2 meta nepɨkwikani nɨawari 'ahetsiemieme kakaɨyarixi wahɨxie.   
\q1
\v 2 'Atuki mɨwayepatsie hepa neheutanieretɨ nepɨkatunumakeni,  
\q2 'anaki'eriya mɨmariwekɨ meta 'aixɨa pemɨtikamiekɨ nepɨmetsitanɨawa.  
\q1 Naime pemɨtiutawewitsie matsiɨkɨme pemayeitɨakɨ  
\q2 kepemɨtimariwe meta 'aniuki pemaye'atɨakɨ.   
\q1
\v 3 Pepɨnetsi'uta'ei kepauka nemɨmetsihahɨawekai,  
\q2 tawarita pepɨnetsi'utɨrɨkariyaxɨ.   
\b  
\q1
\v 4 Neuxei Yawé, yunaitɨ te'aitamete kwiepa memɨtama  
\q2 'aniuki me'enieme mepɨmetsitanɨawa.   
\q1
\v 5 Temawierika mepexeiyani me'utikwitɨ 'ahuye memarietɨ,  
\q2 Yawé, 'atɨrɨkariya mɨmariwekɨ.   
\b  
\q1
\v 6 Yawé muyuawitsie kaniuyeikani,  
\q2 meta puwaxeiya tixaɨtɨ memɨkateyu'erie,  
\q2 'iyata memɨyuti'ɨre 'ateewa kaniwaxeiyani.   
\q1
\v 7 Tsepanetɨ ne waɨkawa 'uximatɨarikatsie nemuyetɨa,  
\q2 'ekɨ tukari pepɨnetsipitɨani,  
\q1 memɨnetsi'aye'unie memɨha'atsie 'amamá pepeutatsera,  
\q2 'atɨrɨkariyakɨ pepɨnetsitawikweitsitɨani.   
\q1
\v 8 Yawé pɨraye'atɨani kemɨti'erieni nehetsiemieme.  
\q1 Yawé, 'anaki'eriya mɨmariwe pɨkayupata yuheyemekɨ,  
\q2 'ekɨ pepɨnetsi'utawewi pepɨkanetsi'uku'e'eiriwani.   
\c 139  
\d Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya.  
\q1
\v 1 Yawé, 'ekɨ pepɨnetsixeiya,  
\q2 'ekɨ pepɨnetsimate.   
\q1
\v 2 Pepɨtimate kepauka 'anemayeixa meta kepauka nemanukukeka,  
\q2 Tsepa kemeteewa kenemɨtiyɨkɨhɨawe pepɨtimate.   
\q1
\v 3 Pepɨtimate kepauka nemukuyeika meta kepauka nemu'uxipie,  
\q2 naime pepɨtimate nitixaɨtɨ pepɨkatitɨmaiya.   
\q1
\v 4 Neniuki 'akuxi neteta kawayenewekaku  
\q2 'ekɨ Yawé matsi, pekatinimaikari naime kenemɨtayɨni.   
\q1
\v 5 'Ekɨ naitsarie pepɨnetsi'ɨwiya,  
\q2 'amamakɨ pepɨnetsi'anukanama.   
\q1
\v 6 Kepemɨtimaiwe pɨmariwe yemekɨ,  
\q2 ne nepɨkayɨwe nemeitimaitɨyani.   
\b  
\q1
\v 7 'A'iyari hɨxie nemuyuti'awieta xaɨtsie nepɨkayɨwe.  
\q2 Nemuyuta'una xaɨtsie 'ahɨxie nemɨka'uyeikanikɨ nepɨkayɨwe.   
\q1
\v 8 Muyuawitsie xɨka ne'anutiyanike,  
\q2 mana pepeyeika 'ekɨ,  
\q1 xɨka meukatewatsie neheukamieni,  
\q2 muwatatsiere pepeyeika.   
\q1
\v 9 Xɨka neheyani tau manatineikatsie,  
\q2 yatɨni haramara manu'axetsie,   
\q1
\v 10 muwapaitɨta 'atɨrɨkariya pɨnetsihekuwitɨneni,  
\q2 meta nepayeniereni 'atɨrɨkariyakɨ.   
\b  
\q1
\v 11 Xɨka mɨpaɨ ne'utayɨni: «Yɨriya kenetsi'anukanani,  
\q2 hekɨariya nehetsiemieme yɨriya xeikɨa kehayani»,   
\q1
\v 12 'ahetsiemieme yɨriya pɨkayɨriya,  
\q2 tɨkarikɨ 'ahetsiemieme tukarikɨ hepaɨ pɨ'ane.  
\q2 'Ahetsiemieme yɨriya meta hekɨariya yaxeikɨa pɨ'anene.   
\b  
\q1
\v 13 'Ekɨ pepɨtiutawewi naime netaɨta timieme,  
\q2 nemaama hetsie pepɨnetsi'ayenuiwitɨa.   
\q1
\v 14 Kepemɨnetiutawewi mariwemekɨ pɨti'ane 'ayumieme nepɨmetsinɨawa.  
\q2 'A'uximayatsika pɨnetsihɨxiyatsitɨa,  
\q2 'ikɨ naime hepaɨtsita mɨpaɨ nepɨtimate.   
\q1
\v 15 Ne'umete pɨwawerekai 'ekɨ pe'ixeiyakaku  
\q2 kepauka 'awie nemɨwewiyakaitsie  
\q1 kwieta meukatewatsie,  
\q2 nemuwipariekaitsie.   
\q1
\v 16 Pepɨnetsixeiyakai kepauka tewi hepaɨ nemɨyɨximekai:  
\q2 'ana naitɨri 'axapatsie pɨraka'ukai nehetsie timieme,  
\q1 netukari kemɨreuterekekai paka'ukairi,  
\q2 'akuxi xeitukari tɨma neka'uyeikakaku.   
\b  
\q1
\v 17 Kakaɨyari, kepemɨtiku'eriwa nehetsiemieme witsipɨ'anene.  
\q2 Naitɨ mɨkɨ yɨnɨtɨ yemekɨ pɨwaɨkawa.   
\q1
\v 18 Xɨka ne'iti'inɨatake,  
\q2 xiekari kemɨpaɨme matsi mɨkɨ pɨwaɨkawa.  
\q1 Xɨka ne'iti'inɨata ne'i'inɨatatɨ nepeukuwe,  
\q2 kepauka nemayɨhɨtɨani ne'aurie 'akuxi 'ekɨ pepukani.   
\b  
\q1
\v 19 Kakaɨyari, xɨka 'axateyuruwamete pewarukwinike 'aixɨa pɨ'anenikeyu.  
\q2 Teɨteri memɨteyumemiwa nehamatɨa memɨka'u'uwanikɨ yapetiuyurienike,   
\q1
\v 20 mɨkɨ 'ahetsiemieme 'axamemutiyuane  
\q2 'itarikakɨ 'ahetsie memɨtehahɨpa.   
\q1
\v 21 Yawé, ne nepɨwaxani'erie kemɨ'ane memɨmetsixani'erie,  
\q2 meta nepɨkawareuxeiyamɨkɨ kemɨ'ane memɨkametsinaki'erie.   
\q1
\v 22 Ne yuheyemekɨ nepɨwareuheka,  
\q2 memɨmetsi'aye'unie neta nepɨwaraye'unie.   
\b  
\q1
\v 23 Kakaɨyari, ne'iyari keneuxeiya,  
\q2 keneneuta'inɨata kenemɨtiyɨkɨhɨawe.   
\q1
\v 24 Keneneuxeiya xɨka huye 'axamɨ'ane 'utɨma ne'umieni,  
\q2 matsi pɨta keneneuwitɨximeni tukari mɨkaxɨwe huyeyari 'utɨma.   
\c 140  
\d Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya.  
\q1
\v 1 Neuxei Yawé, 'axateyuruwamete watsata keneneutawikweitsitɨa,  
\q2 kenene'ɨwiyani memɨteyukananaima wahepaɨtsita,   
\q1
\v 2 memɨyu'iyaritɨa xeikɨa hipame ke'axamemɨwayurieni  
\q2 meta tsepa kepauka kwi memayukwiwawe.   
\q1
\v 3 Yuneni kuu nenieya hepaɨ xeikɨa mepimɨwa,  
\q2 kuu 'uayeya mɨmɨya mepexeiya yutenitsie.   
\b  
\q1
\v 4 Yawé, kenene'ɨwiyani 'axateyuruwamete wahepaɨtsita,  
\q2 kenene'ɨwiyani memɨteyumemiwa wahepaɨtsita,  
\q2 mɨkɨ memɨnetsihatihɨaximekɨ xeikɨa.   
\q1
\v 5 Mɨkɨ memɨyuti'ɨre winiyari mepɨnetsi'uketsiri,  
\q2 kaunari nehɨxie mepɨtiye,  
\q2 nemekawenikɨ nehɨxie mepɨte'u'una.   
\b  
\q1
\v 6 Ne mɨpaɨ Yawé nepɨrahɨawe: «'Ekɨ pepɨnekakaɨyari.  
\q2 Yawé, keneneu'eni kenemetiwawirie waɨkawa».   
\q1
\v 7 Yawé Ti'aitame, netsiwikweitsitɨwame pemɨtɨrɨkaɨye,  
\q2 kepauka nemɨmierienenitsie pemɨnetsiparewie:   
\q1
\v 8 Yawé, pepɨkawapitɨaka 'axateyuruwamete memɨtehayu'iwanikɨ,  
\q2 pepɨkawapitɨaka kememɨteku'eriwa mɨpaɨ memɨteyurienikɨ,  
\q2 kapa me'uyuti'ɨrenikɨ.   
\b  
\q1
\v 9 Memɨnetsi'uweiya wahetsie pɨta kenanunɨ'a  
\q2 'axamɨti'ane nehetsiemieme memeiyenɨ'akai.   
\q1
\v 10 Tɨɨ wiyeriyari ke'ukaxɨrieni wahetsie,  
\q2 taipa mekeheukaxɨriyani,  
\q2 meta putsu meukatetewata, para hatsuaku tawarita memɨkawatikɨkanikɨ.   
\q1
\v 11 Meke'ukumawere 'ena kwiepa  
\q2 teɨteri memɨte'itawa,  
\q1 'uximatɨarikakɨ mete'uka'eniwatɨ meke'ukwini  
\q2 yunaitɨ teɨteri memɨteyukananaima.   
\b  
\q1
\v 12 Ne mɨpaɨ nepɨtimate Yawé teɨteri 'aixɨa memɨte'u'uwa meta tixaɨtɨ memɨkatehexeiya puwaparewie,  
\q2 meta wahetsie punua heitserie kememɨtehexeiya.   
\q1
\v 13 Yurikɨ 'aixɨa memɨte'u'uwa mepɨmetsinɨawani  
\q2 meta 'ahɨxie mekaniu'uwakuni.   
\c 141  
\d Rawiri nɨawarieya.  
\q1
\v 1 Yawé, 'ekɨ nepɨmetsihahɨawe, yapauka kenenanu'eni.  
\q2 Kepauka nemɨmetsihahɨawe keneneuta'eiya kenemɨmetiwawirie.   
\q1
\v 2 'Ahetsɨa paitɨ kehenuani nenenewieri  
\q2 'ɨkwa mawariyari hepaɨ,  
\q1 teikɨ nememe'ekɨ  
\q2 mawari taikai mieme hepaɨ.   
\b  
\q1
\v 3 Yawé, netenitsie tihɨweme keneutaketsa, pepɨkanetsipitɨaka 'axanemɨtikuxatanikɨ.   
\q1
\v 4 Pepɨkanetsipitɨaka 'axanemɨtiyukɨhɨawenikɨ,  
\q2 meta pepɨkanetsipitɨaka kapa 'axanetiuyurienikɨ,  
\q1 pepɨkanetsipitɨaka 'ixɨararipa nemuyeikanikɨ  
\q2 'axateyuruwamete wahamatɨa.   
\b  
\q1
\v 5 'Aixɨa mɨti'ane kenetsiku'imaiyani,  
\q2 naki'eriya kenetsi'utate'ani,  
\q1 witsimu'ɨa 'axateyuruwamete wapiini  
\q2 nemu'utsie pɨkayuhayewani,  
\q1 nemuyunenewiekɨ wahepaɨtsita  
\q2 ke'axamemɨteyuriekɨ.   
\q1
\v 6 Kepauka xe'itsɨkate 'aitsie memakaxɨriyani,  
\q2 'ana mɨpaɨ xepɨtehetimani kename ne yurikɨ nehainekai.   
\q1
\v 7 Mɨpaɨ xepɨtiyuani: «Kwie kemɨtitawiwiwe,  
\q2 kepauka hararu hetsiena muye'inetɨyeikatsie,  
\q1 mɨpaɨta ta'umete pɨtiutaxɨri  
\q2 teukiyapa tetsita».   
\b  
\q1
\v 8 Yawé Ti'aitame, 'ahetsie ne nepɨtiwiya,  
\q2 'ahetsɨa ne nepɨne'awieta, pepɨkanetsipitɨaka nemɨmierienikɨ.   
\q1
\v 9 Winiyari nehɨxie muwɨwɨtɨariwakɨ kenene'ɨwiyani,  
\q2 'axateyuruwamete menetsiwiniyatɨwekaku.   
\q1
\v 10 'Axateyuruwamete yuwiniyaritsietɨtɨ meke'uyewɨre,  
\q2 neta newikweitsitɨarietɨ neke'ayani.   
\c 142  
\d Rawiri 'ɨkitsikaya. Kepauka terɨta mayekatetsiemieme. Nenewieri.  
\q1
\v 1 Karima ne'utahiwatɨ, Yawé parewiya nepɨwawirie,  
\q2 karima ne'utahiwatɨ, Yawé nepɨwawirie mɨnetsinenimayakakɨ.   
\q1
\v 2 Mɨkɨ xeikɨa nepɨtihekɨatɨa kenemɨtiuta'aiwa,  
\q2 nepɨtikuxaxatɨwa kenemɨtiuka'eniwa.   
\b  
\q1
\v 3 Kepauka nemɨkayɨwenitsie,  
\q2 'ekɨ matsi huye pepɨnetsixeitsitɨa.  
\q1 Huye nemiweiya 'utɨma  
\q2 hipatɨ winiyari nehetsiemieme mepuwɨwɨtɨwa.   
\q1
\v 4 Tsiparatsɨ keneneuxeiya:  
\q2 nixewitɨ parewiya pɨkanetsiyetuirie.  
\q1 Nepɨkaheixeiya hakewa nemeyuti'awieta,  
\q2 xewitɨ pumawe nehepaɨtsita yu'iyaritɨatɨ.   
\b  
\q1
\v 5 Yawé, 'ekɨ parewiya nepɨmetsiwawirie,  
\q2 'ekɨ ne mɨpaɨ nepɨmerahɨawe: «'Ekɨ hakewa nemeyu'awieta pepɨhɨkɨ,  
\q2 'ena kwiepa tixaɨtɨ nepɨkarexeiya, 'ekɨ xeikɨa nepɨmetsihexeiya».   
\q1
\v 6 Kenemɨmetiwawirie keneneu'eni,  
\q2 ne hikɨ nekaniweranini,  
\q1 keneneutawikweitsitɨa memɨnetsi'uweiya wahepaɨtsita,  
\q2 mɨkɨ matsi waɨkawa memɨtɨrɨkawikɨ.   
\q1
\v 7 Nepanutahɨiya keneniwayexɨna,  
\q2 nemetsinɨawatɨ nemayanikɨ.  
\q1 'Ana teɨteri 'aixɨa memɨte'u'uwa ne'aurie mekani'axɨakuni  
\q2 menenieretɨ 'aixɨa pemɨnetsi'uyurikɨ.   
\c 143  
\d Rawiri nɨawarieya.  
\q1
\v 1 Yawé, nenewieri keneu'eni,  
\q2 kenemɨmetiwawirie keneneuta'eiya.  
\q1 'Aixɨa pemɨtikamiekɨ meta kemɨtiheitseriekɨ pemuyeikakɨ,  
\q2 keneneuta'eiya.   
\q1
\v 2 'Ekɨ meti'uximayatsiriwame pepɨka'utakwekwewiwani pemita'iwawiyakɨ,  
\q2 'ahɨxie xewitɨ mɨkayɨwekɨ mɨpaɨ mutayɨnikɨ ne 'atsinepɨkatiyuruwame.   
\b  
\q1
\v 3 Mepɨnetsimieku memɨnetsi'aye'unie:  
\q2 kwiepa mepɨnetsi 'ɨhɨa nehɨxima.  
\q1 Yɨwita nemuyeikanikɨri waɨriyarika mepɨnetsipitɨa,  
\q2 meripaitɨ memukwi wahepaɨ.   
\q1
\v 4 Kenemɨtinewaɨriyakai pumaweri netɨrɨkariya,  
\q2 ne'iyariri pɨka'uyuane nepɨka'i'enie.   
\q1
\v 5 Nepɨtiku'eriwa meripaitɨ kemɨtiɨyɨ:  
\q2 mariweme kepemɨtiuyuri nepuku'eriwa,  
\q2 mɨpaɨ nepɨtimate kepemɨtiuyuri 'amamakɨ.   
\q1
\v 6 Nemamatekɨ 'ahepa nepeutame'e,  
\q2 waɨkawa nemɨmetsiheuyehɨwakɨ, kwie muwaki haa kemɨreuyehɨwa hepaɨ.   
\b  
\q1
\v 7 Yawé, yapauka keneneuta'eiya,  
\q2 'ari netukari pɨtixɨxime.  
\q1 Pepɨkanetsiwarixiwiyani,  
\q2 xɨka mɨpaɨ pe'aneni, mɨwatixawata memeukakɨka wahepaɨ nekaniyɨmɨkɨ.   
\q1
\v 8 Ximeri mukatataretsie 'anaki'eriyakɨ kenenaye'eritɨwani,  
\q2 'ahetsie yuri nemɨti'eriekɨ.  
\q1 Huye keneneuxeitsitɨa ke'aneme nemuweiyani,  
\q2 'ekɨ xeikɨa ne'iyari nemɨmetsiyetuiriekɨ.   
\q1
\v 9 Yawé, memɨnetsi'aye'unie wahepaɨtsita keneneɨxɨna,  
\q2 'ahetsie xeikɨa nemikuwaunekɨ nemɨyu'awietani.   
\q1
\v 10 Kemɨmetinake kenetineuta'ɨkitɨa mɨpaɨ nemɨtiyurienenikɨ,  
\q2 'ekɨ nekakaɨyari pemɨhɨkɨkɨ.  
\q1 'A'iyari 'aixɨa mɨ'ane kenetsi'uwitɨximeni  
\q2 'uwerikaku hetsiena temetiketamɨre 'umawekaku.   
\b  
\q1
\v 11 Yawé, 'ekɨ Kakaɨyari 'aixɨa pemɨtiuka'iyarikɨ, tukari keneneupitɨa,  
\q2 heitseriemekɨ pemɨti'uximaya, nemɨtsaipɨnekɨ keneneɨxɨna.   
\q1
\v 12 Pemɨtiyukanaki'eriekɨ memɨnetsi'aye'unie keniwarukumaweriya,  
\q2 yunaime memɨnetsi'aye'unie keniwarukuya,  
\q2 ne ti'a'uximayatsiriwame nemɨhɨkɨkɨ.   
\c 144  
\d Rawiri nɨawarieya.  
\q1
\v 1 Yawé 'aixɨa ke'itɨarieka, ne'ai mɨhɨkɨkɨ,  
\q2 pɨneti'ɨkitɨa kuyaxa timiemekɨ,  
\q2 nemamate pukuha'aritɨwa nemeuyutamiewenikɨ.   
\q1
\v 2 Mɨkɨ nekakaɨyari kanihɨkɨtɨni mɨtiyukanaki'erie, nehetsie nunuwame,  
\q2 mɨmariwe hetsiena nemɨne'awieta, netsixɨname,  
\q1 kɨmana nemɨyukunarɨma kanihɨkɨtɨni.  
\q2 Mɨkɨ mɨnetsipitɨa kanihɨkɨtɨni neteɨterima nemɨtiwa'aitɨakakɨ.   
\b  
\q1
\v 3 Yawé, ¿tita tihɨkɨ tewi pemi'ɨwiyanikɨ?  
\q2 ¿Tita teɨteri metehɨkɨ pemɨwaku'eriwanikɨ?   
\q1
\v 4 Teyunaitɨ teɨteri xeimieme muka'ietɨyani hepaɨ tepɨ'anene,  
\q2 tatukari 'etɨri hepaɨ pɨ'ane yapauka mukumamawere.   
\b  
\q1
\v 5 Yawé, muyuawi taheima muyema kenanutayepieka, muwa kenakayaka,  
\q2 hɨrite keneumayɨaxɨa, yaketineuyuri kɨtsi muwatinexɨanikɨ.   
\q1
\v 6 'Amimierɨkari keneukaxɨri keniwareutaxɨriexɨa,  
\q2 'a'ɨrɨkɨ ketineutamɨ'i, meta keniwarutaweiya memɨtatsi'aye'unie.   
\q1
\v 7 Muyuawitsie paitɨ 'atɨrɨkariya kenenanakanɨ'airi  
\q2 hikɨ keneneutawikweitsitɨa hapa nekayunirɨmekaku,  
\q2 nehetsie keneutanua teɨteri nemɨkawamate memɨnetsi'uweiyakɨ.   
\q1
\v 8 Kepauka memutiniuka, 'itarika mepɨkuxata,  
\q2 yumamá yutserieta mieme mepanukuhapana, yakɨ xeikɨa metekuxatatɨ.   
\b  
\q1
\v 9 Kakaɨyari, xeime hekwame kwikari nepɨtakwika 'ahetsiemieme,  
\q2 nɨawari 'ahetsiemieme nepɨtikwika kanari tamamata mawɨtsie.   
\q1
\v 10 'Ekɨ te'aitamete memɨte'ayu'iwanikɨ pepɨwapitɨa,  
\q2 Rawiri ti'a'uximayatsiriwame pepɨ'ɨwiya 'ixipara mɨka'imienikɨ.   
\q1
\v 11 Kenenewikweitsitɨaka,  
\q2 hipatɨ teɨteri memɨnetsi'uweiyakɨ nehetsie keneutanua.  
\q1 Kepauka memutiniuka, 'itarikakɨ mepɨtekuxata,  
\q2 yumamá mepanukuhapana, yakɨ xeikɨa metekuxatatɨ.   
\b  
\q1
\v 12 Taniwema, kepauka temari memakɨne,  
\q2 meke'utiwawere kɨyexi waɨkawa mɨ'etɨriwiwawe hepaɨ,  
\q1 taniwema 'ukari 'ixumeri kii mutuikatɨka hepaɨ meke'aneneni  
\q2 witsimɨreukuwewiyatɨka paratsiyu witsimɨtiyuxexeiyanikɨ.   
\q1
\v 13 Yaketineuyuri ta'iku temakayayatsatsie ketineutihɨniya  
\q2 'ikwai waɨkawa ketiutimɨire.  
\q1 Tamuxatsima miriyarite keniwarayeitɨa,  
\q2 'atsita mekayu'inɨatsinɨakame keniwarayeitɨa takwieyaritsie.   
\q1
\v 14 Tatuurutsixi kwietsanamete raheteme memɨtekemakakɨ keniwarupitɨa,  
\q2 takiekaritsie 'aixɨa reukukurarutɨariekame kenayeitɨa,  
\q2 meta 'aiwari hiwariyari ke'umaweni takaye'utɨma.   
\b  
\q1
\v 15 Kemɨ'ane kiekari mɨpaɨ mɨrexeiya 'aixɨa ke'itɨarieka.  
\q2 'Aixɨa mepɨ'itɨarie kemɨ'ane kiekari Yawé yukakaɨyaritɨme memayexeiya.   
\c 145  
\d Rawiri nɨawarieya.  
\q1
\v 1 Nekakaɨyari meta neti'aitɨwame, nepɨmetsinɨawani,  
\q2 'aixɨa nepaineni yuheyemekɨ 'ahetsiemieme.   
\q1
\v 2 Tukarikɨ 'aixɨa nepaineni 'ahepaɨtsita,  
\q2 yuheyemekɨ nepɨmetsinɨawani.   
\b  
\q1
\v 3 Yawé kanimariweni, meta kaneuyeweka teminɨawani,  
\q2 kemɨtimariwe pɨkayumainɨa.   
\q1
\v 4 Yuxexuitɨ tanuiwariyari mepe'eriwani 'a'uximayatsika,  
\q2 mepikuxatani mariwemekɨ kepemɨtiuyuri.   
\q1
\v 5 Pepukuxaxatsiwani kepemɨtimariwe kepemɨti'aita,  
\q2 neta nepiku'eriwani mariwemekɨ kepemɨtiuyuri.   
\q1
\v 6 Mɨpaɨ putikuniuwani 'atɨrɨkariya kemɨtiyɨwe,  
\q2 ne matsi 'a'uximayatsika mɨmariwe nepukuxatani.   
\q1
\v 7 Pepukuxaxatsiwani waɨkawa kepemɨtiyukanaki'erie,  
\q2 temawierikakɨ te'utihiwatɨ tepɨmetsitakwika pemɨrayu'iwakɨ.   
\b  
\q1
\v 8 Yawé 'aixɨa pɨtiuka'iyari pɨtiyukanenimaya,  
\q2 pɨkahayu'eriya matsi waɨkawa pɨtiyukanaki'erie.   
\q1
\v 9 Yawé 'aixɨa pɨtiuka'iyari,  
\q2 mɨkɨ kaniwanenimayaka yunaime mɨtiwarutiwewi.   
\q1
\v 10 Yawé, yunaime pemɨtiwarutiwewi mekemetsinɨawani,  
\q2 'ateɨterima yamemɨtekahu 'aixɨa mekehaitɨkani 'ahetsiemieme.   
\q1
\v 11 Meketekuxatani witsikepemɨti'aita,  
\q2 meta mariwemekɨ kepemɨtiuyuri,   
\q1
\v 12 yunaitɨ kwiepa memɨtama memeitimanikɨ mariweme kepemɨtiuyuri  
\q2 meta witsipe'anetɨ kepemɨtimariwe metatsiere 'aixɨa 'anemekɨ kepemɨti'aita.   
\q1
\v 13 Kepemɨti'aitani yuheyemekɨ hawaikɨ pɨkaheu'aka,  
\q2 'ekɨ pepɨti'aitani naime wiyaritsie.  
\b  
\q1 Yawé yuniuki paye'atɨa,  
\q2 meta 'aixɨa pɨtiuka'iyari naime yu'uximayatsikatsie.   
\q1
\v 14 Yawé mematixɨrie kaniwaranuku'uitɨwani  
\q2 meta memu'uximatɨarie kaniwatɨrɨkariyani.   
\q1
\v 15 Meteyunaitɨ mepɨmetsixeiya xeikɨa,  
\q2 meta'ikwewatɨ pemɨtiwaminikɨ.   
\q1
\v 16 Peyuwaɨriyatɨ 'amamá pepanutayepiwa pepɨwahuxaitɨa,  
\q2 yunaime memɨte'u'uwa.   
\b  
\q1
\v 17 Yawé heitserie pɨti'uximaya kemɨtayɨni pɨraye'atɨwa  
\q2 meta naime yapɨtiyuriene yunaki'eriyakɨ.   
\q1
\v 18 Kemɨ'ane Yawé memahɨawe 'ahurawa wa'aurie kaniuyeikani,  
\q2 kemɨ'ane yurikɨ yemekɨ memehɨawe.   
\q1
\v 19 Pɨraye'atɨwa kememɨtehehɨawe meteheuyehɨatɨ memeyemakaxe,  
\q2 wahiwari 'aiwariyari 'enietɨ yapɨtikamie meta puwawikweitsitɨa.   
\q1
\v 20 Yawé kemɨ'ane meminaki'erie mɨkɨ yunaime pɨwa'ɨwiya,  
\q2 peru 'axamemɨte'u'iyari yunaime puwareuyehɨani.   
\b  
\q1
\v 21 Yawé yuheyemekɨ nepɨmetsinɨawani.  
\q2 Yunaitɨ kwiepa memɨtama mepɨmetsinɨawani,  
\q2 hikɨ meta yuheyemekɨ.   
\c 146  
\q1
\v 1 Yawé kenɨawarieka.  
\q2 Ne'iyari, Yawé kenenɨawani.   
\q1
\v 2 Ne Yawé nepɨnɨawani kenemɨreutere,  
\q2 mexixi ne'ayeniere, nɨawari Kakaɨyari hetsiemieme neputikwikani.   
\b  
\q1
\v 3 Teɨteri memɨtɨrɨkawi wahetsie xepɨkatewiyani,  
\q2 mɨkɨta mepɨkwiwawe xeikɨa, mepɨkayuwawe memɨxetawikweitsitɨanikɨ.   
\q1
\v 4 Kepauka mɨmɨni tumuanari kanayeimɨkɨ xeikɨa,  
\q2 'ana kemɨtiku'eriwakai naitɨ katineuyewemɨkɨ.   
\b  
\q1
\v 5 'Aixɨa kani'itɨarieka kemɨ'ane Kakuwu kakaɨyarieya miparewie,  
\q2 meta kemɨ'ane Yawé mɨtakwewie yukakaɨyari,   
\q1
\v 6 muyuawi meta kwie mɨtiutiwewi,  
\q2 haramara meta yunaitɨ titamexi mana memɨteye'uwa,  
\q2 mɨkɨ matsi yurikɨ xeikɨa katinikuxatani.   
\q1
\v 7 Yawé memɨnanaimarie wahetsie 'aixɨa katiniyurieka,  
\q2 memɨyehakakwitɨwe katiniwamikwani  
\q2 meta memanutaxɨriwa kaniwaranayexɨnani.   
\q1
\v 8 Yawé memɨkahauneniere kaniwaranutanieritɨwani,  
\q2 Yawé mematixɨri kaniwaranuku'uitɨwani,  
\q2 Yawé kaniwanaki'erieka 'aixɨa memɨte'u'uwa.   
\q1
\v 9 Yawé ku'uwamete kaniwa'ɨwiyani,  
\q2 nutuite meta wiuraxi kaniwaparewieka,  
\q2 peru 'axateyuruwamete kememɨteku'eriwa kananutunani.   
\b  
\q1
\v 10 Kerutsareme 'aku, Yawé keti'aitani yuheyemekɨ.  
\q2 'Akakaɨyari keti'aitani yuheyemekɨ.  
\b  
\q1 Yawé kenɨawarieka.   
\c 147  
\q1
\v 1 Yawé kenɨawarieka.  
\b  
\q1 Yemekɨ 'aixɨa pɨ'ane takakaɨyari hetsiemieme nɨawari temɨkwikani,  
\q2 'aixɨa pɨ'ane meta mɨkɨ heitserie pexeiya teminɨawanikɨ.   
\b  
\q1
\v 2 Yawé Kerutsareme panukuketɨa,  
\q2 memehapanie 'ixaheritsixi puwakuxexeɨriwa,   
\q1
\v 3 memɨyuhiwerie 'aixɨa meteheu'eriekame puwarayeitɨwa  
\q2 memawitekietɨkatsie puwaranaku'eima.   
\b  
\q1
\v 4 Puwa'inɨata xurawetsixi kememɨyupaɨme  
\q2 mɨkɨ yunaime puwaterɨwa yuxexuime.   
\q1
\v 5 Tati'aitɨwame pɨmariwe, meta tɨrɨkariyaya pɨmɨire,  
\q2 kemɨtimaiwe hawaikɨ pɨkaheu'axe,   
\q1
\v 6 Yawé puwaranuku'uitɨwa tixaɨtɨ memɨkateheuxeiya,  
\q2 matsi pɨta 'axateyuruwamete puwaratixɨrɨwa.   
\b  
\q1
\v 7 Xekenenɨawani Yawé pamɨpariyutsi xe'ipitɨatɨ,  
\q2 xekeneukakanariwiwani kanarikɨ Kakaɨyari nɨawarieya xe'utikwitɨ.   
\q1
\v 8 Mɨkɨ hai kanikuyuitɨwani,  
\q2 kwiepa wiyeri kaneyenɨ'awani  
\q2 meta hɨritsie 'ɨxa pɨweriya.   
\q1
\v 9 Tewaxi mɨkɨ pɨtiwamikwa  
\q2 meta kwatsari tɨɨrixi puwawaweriya pɨtiwamikwa me'utitsuanakaku.   
\b  
\q1
\v 10 Yawé pɨkayutemawie kawayu tɨrɨkariyayakɨ,  
\q2 meta tewi kemɨranautsawekɨ,   
\q1
\v 11 matsi kaninaki'aka kemɨ'ane memeyemakaxe wahetsiemieme,  
\q2 kemɨ'ane naki'eriyayatsie memɨtewiya.   
\b  
\q1
\v 12 Kerutsaremetari, Yawé hepaɨtsita 'aixɨa xekeneutiyuaneni,  
\q2 yukakaɨyari xekenenɨawani.   
\q1
\v 13 Kerutsareme 'itupariyarita meukukeka kanitɨrɨkariyani mɨtse'inikɨ  
\q2 meta 'aixɨa kaniwayurieka mana kiekatari.   
\q1
\v 14 Mɨpaɨ pɨtixepitɨa 'aixɨa xemɨtexeiyariekakɨ  
\q2 meta 'ikwai 'aixɨa mɨ'ane kanixemikwani.   
\b  
\q1
\v 15 Yuniuki kwiepa peyenɨ'awa,  
\q2 naitsarie pɨtakɨka niukieya yumexɨitɨatɨ.   
\q1
\v 16 'Ɨwi pɨkawiwiwa mata mutuxa hepaɨ,  
\q2 haɨtsi wiyeri naxi hepaɨ pɨkawiwiwa.   
\q1
\v 17 Tee pɨkaxɨrɨwa tetexi 'etsimɨpepe hepaɨ,  
\q2 xewitɨ pɨkayɨwe minewieni haɨtɨriyaya.   
\q1
\v 18 Matsi yuniuki kanenɨ'awani mitiparitɨanikɨ,  
\q2 mɨkɨ 'eka punenetɨwa mitiparitsitɨanikɨ, meta haa muwayenexɨanikɨ.   
\b  
\q1
\v 19 Yuniuki 'ixaheritsixi pɨwahekɨatɨa,  
\q2 meta yu'aitsikate yɨ'ɨkitɨarika puwarupitɨa.   
\q1
\v 20 Mɨpaɨ xeime tawarita nuiwari pɨkayuriwe,  
\q2 'atsimepɨkatehetimaiwawe mɨkɨ 'aitsikaya hepaɨtsita.  
\b  
\q1 Yawé kenɨawarieka.   
\c 148  
\q1
\v 1 Yawé kenɨawarieka.  
\b  
\q1 Muyuawitsie paitɨ Yawé xekenenɨawani,  
\q2 meutitewatsie xekenenɨawani.   
\q1
\v 2 Niuki tuayametemama yunaitɨ, xekenenɨawani,  
\q2 kuyaximama yunaitɨ, xekenenɨawani.   
\q1
\v 3 Tau meta metsa, meke'inɨawani,  
\q2 xurawetsixi xemutimerɨkare, xekenenɨawani.   
\q1
\v 4 Xemeta muyuawi 'amautitewa, xekenenɨawani,  
\q2 xemetatsiere haa muyuawitsie xemuyema.   
\q1
\v 5 Yawé kemɨtimariwe, 'aixɨa ketikuxaxatsiwani,  
\q2 mɨkɨ yatiuta'aitaku naitɨ katiniutawewiyani.   
\q1
\v 6 Naitɨ yapɨtiuyɨ yuheyemekɨ,  
\q2 'aitsika punetɨa mɨkakuyuitɨariwanikɨ.   
\b  
\q1
\v 7 Yawé xekenenɨawani kwiepa,  
\q2 haramara 'amaukatewatsie kiekatari,   
\q1
\v 8 tee meta merɨkariya, 'ɨwi meta haiwitɨri,  
\q2 'eka mɨtɨrɨkaɨye meye'atɨwa 'aitsikaya,   
\q1
\v 9 yemurite meta 'amanutitɨtɨ hɨri,  
\q2 kariuxa meta 'ikwaxi mɨtikayaxike naitɨ,   
\q1
\v 10 tewaxi meta yeutari,  
\q2 memɨtekɨwɨtɨwe meta kuuterixi,   
\q1
\v 11 yunaitɨ nuiwarite meta kwiepa te'aitamete,  
\q2 mexɨakate meta kwiepa kuwexinaruritsixi,   
\q1
\v 12 temari meta 'ɨimarixi,  
\q2 'ukirawetsixi meta tɨɨri.   
\b  
\q1
\v 13 Yawé xekenenɨawani,  
\q2 mɨkɨ xeikɨa mɨmariwekɨ,  
\q1 kemɨtimariwe kwie pa'iwa meta muyuawi.   
\q2
\v 14 Mɨkɨ yuteɨterima kaniwatɨrɨkariyani.  
\b  
\q1 Mɨkɨ xeikɨa mekenɨawani yunaitɨ hetsiena memɨtewiya,  
\q2 'ixaheritsixi, 'ahurawa teɨterimama.  
\b  
\q1 Yawé kenɨawarieka.   
\c 149  
\q1
\v 1 Yawé kenɨawarieka.  
\b  
\q1 Kwikari hekwame xekenekwikani Yawé hetsiemieme,  
\q2 teɨterimama hetsiena memɨtewiya wahamatɨa xekenenɨawani.   
\b  
\q1
\v 2 'Ixaheritsixi mekeyutemamawieka mɨwarutawewi hetsiemieme,  
\q2 Kerutsaremetari xekeneyutemamawieka xeti'aitɨwame hetsiemieme.   
\q1
\v 3 Meke'inɨawani mete'ukaketsinatɨ,  
\q2 kwikari meke'utikwikani xawerimakame meta tepu 'etsimupekɨ.   
\q1
\v 4 Yawé muyutemawiekɨ yuteɨterima wahetsiemieme,  
\q2 tixaɨtɨ memɨkatehayuyeitɨa memɨtehayu'iwanikɨ puwapitɨa.   
\q1
\v 5 Hetsiena xemɨtewiya xekeneyutemamawieka mɨkɨ xepitɨakaku xemɨtehayu'iwaxɨkɨ,  
\q2 tsepa yu'utatsie xemuhe xekeneutihiwani xeyutemamawietɨ.   
\b  
\q1
\v 6 Kakaɨyari nɨawarieya 'ateta kehayeneikani,  
\q2 'ixipara pekehakweka naitsata hautixikakaunime,   
\q1
\v 7 para yunaitɨ nuiwarite memɨtehakapitɨarienikɨ ke'axamemɨteyuriekɨ  
\q2 meta kiekarite mɨtiwaka'enitsitɨanikɨ,   
\q1
\v 8 para te'aitamete memɨtihɨiyanikɨ,  
\q2 tepɨa kaunariyari mɨtse'ikɨ hayehutamekɨ,   
\q1
\v 9 para maye'atɨarienikɨ wahetsie kemɨraka'utsie kememɨte'anuyekɨnekɨ.  
\q2 'Ikɨkɨ mɨpaɨ mepɨteyutemamawieka teɨterimama.  
\b  
\q1 Yawé kenɨawarieka.   
\c 150  
\q1
\v 1 Yawé kenɨawarieka.  
\b  
\q1 Kakaɨyari xekenenɨawani tukitana,  
\q2 xekenenɨawani muyuawitsie mɨtɨrɨkaɨyekɨ.   
\q1
\v 2 Xekenenɨawani mariweme mɨtiyurienekɨ,  
\q2 xekenenɨawani mɨmariwekɨ.   
\q1
\v 3 Xekenenɨawani kuxineta yuarikayayakɨ,  
\q2 xekenenɨawani kanaritsie meta xaweritekɨ.   
\q1
\v 4 Xekenenɨawani xete'ukaketsinatɨ meta tepu 'etsimupepekɨ,  
\q2 xekenenɨawani pirikɨxakɨ meta kanaritsie mawɨkɨ.   
\q1
\v 5 Xekenenɨawani tepɨa mutatiraurukakɨ,  
\q2 xekenenɨawani 'amɨtiuyuatɨkakɨ.   
\b  
\q1
\v 6 Yawé xekenenɨawani yunaitɨ xemɨtehayeneniere.  
\b  
\q1 Yawé kenɨawarieka.   