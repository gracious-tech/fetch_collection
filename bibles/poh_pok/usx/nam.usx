<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="NAM" style="id">NAMPOK.SFK. 19-02-2,008. Adelina Quej. Pocomchi. Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">NAHUM</para>
  <para style="toc3">Nah</para>
  <para style="toc2">Nah</para>
  <para style="toc1">NAHUM</para>
  <para style="mt2">RE' I RUHUUJ I NAHUM</para>
  <para style="mt1">NAHUM</para>
  <chapter number="1" style="c" />
  <para style="s">Re' i Dios ruuk' rujosq'iil xuq'aj wach i xkian i aj Nínive</para>
  <para style="p">
    <verse number="1" style="v" />Chupaam i huuj wili xutz'ihb'aaj i Nahúm aj Elcos chib'ih i xk'uhtjik reh parusaq wiriik, ruum i Dios. Re' noq xq'orarik reh chib'ih i ti' k'axik naakik'ulum i aj Nínive.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' i QaJaaw Dios iraaj chi xa re' reh naa runimjiik,</para>
  <para style="q">i ruq'aj wach keh i xa re' i yiib' wach na'ojb'al inki a'n</para>
  <para style="q">Eh i ruyeew i rujosq'iil chikinaah awach i ki-ixowanik wach.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i QaJaaw Dios ma' jumehq'iil ta inchalik rujosq'iil, xa re' la' wilik rajaawriik.</para>
  <para style="q">Eh ruyeew taqe chutojariik i kimahk i aj mahk,</para>
  <para style="q">eh imb'ehik chinaah taqe i kaq suut teew,</para>
  <para style="q">je' wo' chinaah taqe i suutz'.</para>
  <para style="q">
    <verse number="4" style="v" />Re' reh i ruq'il i palaw, i ruchiqsaj,</para>
  <para style="q">eh i ruchiqsaj chu'nchel i nim ha'.</para>
  <para style="q">Eh rukansaj i ch'ahn ar Basán, je' wo' tik wilik chuwach i yuuq' Carmelo.</para>
  <para style="q">Eh ruchiqsaj taqe i uhtz'ub' ar Líbano.</para>
  <para style="q">
    <verse number="5" style="v" />Eh chuwach i Dios</para>
  <para style="q">xa kib'arb'otiik chik ruum kiyo'jiik taqe najt kinaah yuuq',</para>
  <para style="q">taqe i rub'ohl yuuq'.</para>
  <para style="q">Eh kik'uyu'jik i wach ak'al ruum, eh kib'oqibik, je' wo' chu'nchel i wilkeeb' chupaam.</para>
  <para style="q">
    <verse number="6" style="v" />Eh ¿awach neenkuywik reh i rujosq'iil i Dios?</para>
  <para style="q">¿Awach i neeruko'leej riib' chuwach?</para>
  <para style="q">ruum re' reh je' rukab' i q'aaq' noq ruyeew i rujosq'iil,</para>
  <para style="q">eh kipaxik taqe ab'aj chuwach.</para>
  <para style="q">
    <verse number="7" style="v" />Re' i QaJaaw Dios xiik' naah rotob'il,</para>
  <para style="q">ruum i ruyeew rukowiil kik'ux taqe i ti' wilkeeb',</para>
  <para style="q">eh i ruko'leej taqe i awach i kiye'em kik'ux ruuk'.</para>
  <para style="q">
    <verse number="8" style="v" />Eh noq naa taqe ruye'em panti' k'axik</para>
  <para style="q">i ma' kinimanik ta reh je' naa narumuq'aam kinaah ruuk' ha'.</para>
  <para style="q">Eh je' naa pa runimaal q'equm naa kikahniik taqe i ki-ixowanik awach.</para>
  <para style="q">
    <verse number="9" style="v" />Eh raaj taq i hat aj Nínive</para>
  <para style="q">¿Chib'ih reet noq inakapaaj taq i ma' holohik taj chi riij i QaJaaw Dios?</para>
  <para style="q">Re' reh naa rusacham taq awach, xa ruuk' i junriim, ma' kota naa ruk'ihpechem.</para>
  <para style="q">
    <verse number="10" style="v" />Re' taq i hat je' taq akab' i k'iix wilkeeb' pantaq ab'iix, ruuk' taq i na a'n,</para>
  <para style="q">eh je' wo' taq akab' taqe i xohk'reel, ruum taq i na a'n re' re',</para>
  <para style="q">naa taq ak'atariik je' rukab' noq ink'ahtik i chiq sohk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Eh chaxilak taq i hat</para>
  <para style="q">wilik inyej-anik wach i yiib' wach na'ojb'al chi riij i QaJaaw Dios,</para>
  <para style="q">re' jinaj chi aj taq chi' yiib' wach i runa'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' i QaJaaw Dios je' wili i xuq'or keh i aj Israel:</para>
  <para style="q">Atoob' ta xiik' naah kik'ihaal i aj Asiria nee kichalik taq cha naah,</para>
  <para style="q">re' hin naa nusacham kiwach.</para>
  <para style="q">Re' hin xatnuyeew taq panti' k'axik,</para>
  <para style="q">xa re' la' ma' naa ta chik taq kaat nuye'em panti' k'axik.</para>
  <para style="q">
    <verse number="13" style="v" />Re' hin naa wesam taq cha naah i ahl laj ihq,</para>
  <para style="q">eh naa nuchejem taq awach ruum b'ak'ooj taq awach ruuk' taq i na a'n, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Eh re' i hat kireey i aj Nínive,</para>
  <para style="q">i ruq'or Dios chi ma' jino'q aawiih aamaam naa rokiik chi reyil chajilow.</para>
  <para style="q">Eh naa nusacham kiwach pankipaat taq i aatiyoox haab'imaj chee' taqe korjinaq wii',</para>
  <para style="q">eh ar naa aamuhqiik i hat ruum ayiib' wach aana'ojb'al, inki.</para>
  <para style="q">
    <verse number="15" style="v" />Chab'iraj taq, xk'uloq chik chinaah taqe yuuq' i k'ahchi' cho chuq'orariik rib'iral</para>
  <para style="q">i suq rib'irjiik re' inq'orik rib'iral i suq kiil k'uxliis.</para>
  <para style="q">Re' taq i hat aj Judá, xponik chik i q'iij chi naa taq a'nam aninq'iij.</para>
  <para style="q">Eh ma' jaruuj chik q'iij naa kichopom taq anaah i yiib' wach kina'ojb'al,</para>
  <para style="q">ruum re' keh xsacharik chik kiwach.</para>
  <chapter number="2" style="c" />
  <para style="s">Re' aj Nínive xq'orarik chi naa rusachariik kiwach</para>
  <para style="q">
    <verse number="1" style="v" />Re' taq i hat aj Nínive k'ulik chik i rub'an</para>
  <para style="q">iloq cha naah i sachal taq awach, chakoj taq i aj q'atool chupaam taq ab'eeh.</para>
  <para style="q">Chab'ak' taq nah atuuq i q'aslaj ch'ihch',</para>
  <para style="q">cha yejaa' taq awiib' reh i q'aq'inik.</para>
  <para style="q">
    <verse number="2" style="v" />Re' i QaJaaw Dios naa wo' chik ruye'em kiloq'il i aj Israel,</para>
  <para style="q">re' taqe i riih rumaam i Jacob.</para>
  <para style="q">Eh naa wo' chik kehchaam i xq'ucharik keh,</para>
  <para style="q">naa wo' chik rukanaam taqe chi je' rukab' i pampeet,</para>
  <para style="q">naa wo' chik ruwachiniik i kitik.</para>
  <para style="q">
    <verse number="3" style="v" />Re' taqe i soldado okik keh chi q'aq'inik taq cha naah,</para>
  <para style="q">xa kaq chik i kipulato ch'ihch', je' wo' kiso',</para>
  <para style="q">xa kiyejaam chik kiib' reh i q'aq'inik.</para>
  <para style="q">Eh re' i kikawayu xankaaj chik ojik chi q'aq'inik,</para>
  <para style="q">re' taqe i kikareta xa nqop chik ruq'aq'al, reh ojik chi q'aq'inik.</para>
  <para style="q">
    <verse number="4" style="v" />Re' taqe i kikareta xak'ul chik kiooj pantaq b'eeh,</para>
  <para style="q">xa teheeh chik kiwach, xak'ul chik kiooj pantaq k'aayb'al,</para>
  <para style="q">xa je' chik kikab' i saqumb'al qoplik ruq'aq'al,</para>
  <para style="q">eh xa je' chik rukab' i ruch'aab' i kahoq inki a'n</para>
  <para style="q">
    <verse number="5" style="v" />Eh re' reey ar Nínive, xuyuq'eej taqe i ru soldado</para>
  <para style="q">xak'ul chik inkiq'oj kiib' ruum rutehkiil kiwach,</para>
  <para style="q">eh re' taqe aj ixowaal ruuk' i qamaam chee'</para>
  <para style="q">ch'ihch' ju' xkik'er i koq i ru puertahiil i tz'aq.</para>
  <para style="q">
    <verse number="6" style="v" />Eh kitehiwanik i koq taqe i puerta wilkeeb' chi' ha'.</para>
  <para style="q">Eh re' paat wilik wii' i reey ch'alojik wach ak'al.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' i rehk'een i reey, eh taqe ixoq kikamanik ruuk'</para>
  <para style="q">xichoparik kuum i aj ixowaal, xasuq chik kioq'ik,</para>
  <para style="q">xa je' chik kioq'ik paloma,</para>
  <para style="q">xankituy chik i koq i chi' kik'ux.</para>
  <para style="q">
    <verse number="8" style="v" />Re' i tinamit Nínive je' rukab' noq i nelik chee</para>
  <para style="q">ha' noq inhop chaloq i molb'al reh,</para>
  <para style="q">Atoob' ta naq q'oraroq keh chi tipaa' taq ti sutinoq taq kiuchjoq,</para>
  <para style="q">xama' jino'q wo' chik keh i naa rusutiniik.</para>
  <para style="q">
    <verse number="9" style="v" />Eh naa wo' rukuxiik kelq'aam i plata, i oro.</para>
  <para style="q">Re' taqe i aj Nínive xti yohb'aal wach kib'ehomal,</para>
  <para style="q">xa k'axb'al chik wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Xa re' la' naa kikahniik chi ma' xta chik wilik keh,</para>
  <para style="q">xan tz'irik chik kiwach.</para>
  <para style="q">Eh xanaa chik kib'arb'otik ruum kiyo'jiik, xanaa chik rukarkotiik i pankaa'.</para>
  <para style="q">Eh xama' xta chik kikowiil,</para>
  <para style="q">xasaq moq'ik chik naakiponiik.</para>
  <para style="q">
    <verse number="11" style="v" />Eh ¿Chib'ih jariik i xkik'ul i aj Nínive?</para>
  <para style="q">Re' i je' naq kikowiil i kaq b'ahlam,</para>
  <para style="q">je' naq kikab' ixoq kaq b'ahlam,</para>
  <para style="q">i kiye'aab' i kok' rak'uun b'ahlam ma' xta naq inkiyohleej wach,</para>
  <para style="q">eh ma' awach ta naq inyohb'isanik keh.</para>
  <para style="q">
    <verse number="12" style="v" />Re' taqe i aj Nínive q'e' naq kow inki a'n kiib',</para>
  <para style="q">xa awach naq inkikansaj,</para>
  <para style="q">je' rukab' i rub'an i kaq b'ahlam,</para>
  <para style="q">ruuk' josq'iil i ruchop i rutiib', i ruyeew reh ixoq kaq b'ahlam,</para>
  <para style="q">je' wo' keh i kok' rak'uun, i runujisaj chi chikop taqe i ruye'aab'.</para>
  <para style="q">
    <verse number="13" style="v" />Re' i QaJaaw Dios nim rajaawriik je' wili xuq'or:</para>
  <para style="q">Re' hin ma' nuk'ax ta wach i inki a'n i aj Nínive,</para>
  <para style="q">naa nuk'atam i kikareta naa reliik rusib'eel.</para>
  <para style="q">Eh naa nusacham kiwach i kow kiib'.</para>
  <para style="q">Eh naa nusacham kiwach i kielq'anik taq chib'ih aweh.</para>
  <para style="q">Naa rukahniik chi ma' xta chik taq awaj taqareel, inki.</para>
  <chapter number="3" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' taq i hat aj Nínive q'e' taq ti' i naa ak'ulum ruum hat taq kansan aawas achaaq',</para>
  <para style="q">hat taq aj chukul q'orik,</para>
  <para style="q">ma' jaruuj taq inakanaa' rub'aan i leq'</para>
  <para style="q">
    <verse number="2" style="v" />Eh chalik inki a'n</para>
  <para style="q">taq cha naah i ki-ixowanik taq awach.</para>
  <para style="q">Re' keh k'ahchi' cho kiye'em chi tz'uhuum i kikawayu</para>
  <para style="q">reh i chalik chi jumehq'iil xa kajiim chik chaloq i kikareta.</para>
  <para style="q">
    <verse number="3" style="v" />Eh ma' k'isiin i wilkeeb' rij kawáyu naa kokiik chi q'aq'inik.</para>
  <para style="q">Xa saq repik chik i reeh i ju' kich'ihch'.</para>
  <para style="q">Eh naakihopib'iik i tinamit,</para>
  <para style="q">eh xa aha' naa rukahniik</para>
  <para style="q">chi tuch'lik i kiti'jolal i kamnaq pantaq b'eeh,</para>
  <para style="q">naakitoxk'iim i kooq chikinaah.</para>
  <para style="q">
    <verse number="4" style="v" />Re' taqe i aj Nínive, je' re' i naakik'ulum</para>
  <para style="q">ruum xiik' naah yib'kiil wach i kina'ojb'al.</para>
  <para style="q">Eh je' taqe k'oyoom laj ixoq,</para>
  <para style="q">ruum chi xa holohik chik inki a'n kiib' inkijot' i tinamit.</para>
  <para style="q">Eh je' kikab' i xti manlik aj war,</para>
  <para style="q">ruuk' i re' inkijot' taqe i tinamit korehtaal i rehchaaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' i QaJaaw Dios nim rajaawriik, je' wili i xuq'or:</para>
  <para style="q">Re' taq i hat aj Nínive,</para>
  <para style="q">naa kaat nukanaam chi t'usulkaat</para>
  <para style="q">Eh naa nuk'uhtaam taq ak'ixb'ilaal</para>
  <para style="q">chikiwach i nimaq tinamit.</para>
  <para style="q">
    <verse number="6" style="v" />Eh naa taq kaat nutolem pan chuh laj ch'uwa', naa nuk'uhtaam taq ak'ixb'ilaal,</para>
  <para style="q">naa taq kaat nukanaam chi xa kise'lb'aal i tinamit.</para>
  <para style="q">
    <verse number="7" style="v" />Eh chu'nchel i naa kilwiik taq aweh</para>
  <para style="q">naakeliik taq chawach je' wili i naa kiq'orom:</para>
  <para style="q">Xsacharik kiwach i aj Nínive.</para>
  <para style="q">¿Mi ko wilik neenketelinik kiwach?</para>
  <para style="q">¿Mi ko wilik neen ye'wik rusuqkiil kik'ux? inko'q taqe.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taq i hat aj Nínive</para>
  <para style="q">¿Mi q'e' taq kow awiib' re' chuwach i tinamit Tebas?</para>
  <para style="q">re' kotimaj riij ruum i nim ha' Nilo,</para>
  <para style="q">eh inkamanik reh chi je' rukab' i tz'aq ko'lb'al riib'.</para>
  <para style="q">
    <verse number="9" style="v" />Eh re' naq i tinamit Etiopía, re' i Egipto inko'linik reh,</para>
  <para style="q">xkiyeew cho kik'ux chi ruko'ljiik.</para>
  <para style="q">Eh xto'arik wo' ruum i tinamit Fut, je' wo' i tinamit Lidia.</para>
  <para style="q">
    <verse number="10" style="v" />Xa re' la' re' taqe i aj Tebas, xa xi k'amarik wo' reje pan tokoom tinamit.</para>
  <para style="q">Eh re' taqe i kiha'lak'uun xpuch'arik i kinaah xilak taq b'eeh,</para>
  <para style="q">re' taqe i aj ixowaal xkiq'ijej riij taqe i k'amal b'eeh</para>
  <para style="q">i lb'al reh awach aj uuk' naa rukahniik chi mosojik.</para>
  <para style="q">Re' taqe nimaq kiwach chi kixilak i aj Tebas xb'ak'arik kiwach chi karena.</para>
  <para style="q">
    <verse number="11" style="v" />Je' re' i naa ak'ulum taq i hat aj Nínive,</para>
  <para style="q">xa je' taq chik hat xohk'reel noq naa taq asik'im aha' taq naa akeb'aam awiib',</para>
  <para style="q">chikiwach i ki-ixowanik taq awach.</para>
  <para style="q">
    <verse number="12" style="v" />Eh chu'nchel i paat inako'leej taq wii' awiib',</para>
  <para style="q">xanoq wo' naa kich'a'lojik wach ak'al.</para>
  <para style="q">Je' rukab' noq inch'a'lojik i wach i higo, noq intz'a'jik i koq k'isinoq,</para>
  <para style="q">eh ink'uxarik i koq.</para>
  <para style="q">
    <verse number="13" style="v" />Re' taq aa soldado</para>
  <para style="q">naakikahnik chi je' taqe ixoq, ruum naa kiyo'jiik.</para>
  <para style="q">Naa rukahniik chi tehlik i ookb'al reh taq aatinamiit,</para>
  <para style="q">ruum naa ruk'ahtiik taq aapuerta, eh ar naa kokiik</para>
  <para style="q">i ki-ixowanik taq awach.</para>
  <para style="q">
    <verse number="14" style="v" />Re' taq i hat atoob' ta chamol taq ahaa',</para>
  <para style="q">reh chi wilik taq ahaa' noq nee kichalik taq chi apletojik.</para>
  <para style="q">Atoob' ta cha yejaa' taq i xaan yejeenb'al taq apaat, inako'leej taq wii' awiib',</para>
  <para style="q">xama' naa ta wo' taq ako'leem awiib'.</para>
  <para style="q">
    <verse number="15" style="v" />Eh ruuk' q'aaq', ruuk' ch'ihch' k'ulq'as naa rusachariik taq awach.</para>
  <para style="q">Naa taq rub'aan aweh je' rukab' noq insacharik kiwach i tik kuum i nimaq chili'l.</para>
  <para style="q">Atoob' ta je' taq ak'ihaal i ma' k'isa nimaq chili'l,</para>
  <para style="q">xanaa wo' taq kisacham awach i aj ixowaal</para>
  <para style="q">
    <verse number="16" style="v" />Eh yohb'aal chik wach kik'ihaal i aj k'aay kik'ulik taq panatinamiit,</para>
  <para style="q">ma' xata je' kik'ihaal i ch'umiil i wilkeeb' pan taxaaj.</para>
  <para style="q">Re' taqe nimaq chili'l inkijal i kiij, eh kirupinik reje.</para>
  <para style="q">
    <verse number="17" style="v" />Re' taqe i k'amal taq ab'eeh,</para>
  <para style="q">taqe i kitijiniik reh taqe aa soldado</para>
  <para style="q">kikahnik chi xa je' kikab',</para>
  <para style="q">i ruk'ihaal nimaq chili'l inkipab'aa' kiib' wataq tz'aq paruq'ijil jab'.</para>
  <para style="q">Eh noq i rureq ruq'ijil si'q'jil aha'</para>
  <para style="q">ta wo' kiooj ma' nilarik ta chik kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Re' taq i hat kireey i aj Asiria</para>
  <para style="q">ma' xta chik naa kianam i ki-ilwik taq reh aatinamiit,</para>
  <para style="q">xa je' chik suq kiwiriik naa kikahniik.</para>
  <para style="q">Eh re' taqe i aa soldado naakimolom chi elik,</para>
  <para style="q">chi ju' taq yuuq' pantaq raax chee',</para>
  <para style="q">ma' awach ta chik i naa rumolwiik kiwach.</para>
  <para style="q">
    <verse number="19" style="v" />Re' taq i hat aj Nínive, ma' xta chik riq'omal i ti' k'axik taq naa ak'ulum.</para>
  <para style="q">Eh chu'nchel i tinamit naakipohq'aam paam i kiq'ab' ruum i rusuqkiil kik'ux</para>
  <para style="q">na'kib'iraj rib'iral i chi xkisach taq awach,</para>
  <para style="q">Ruum q'e' taq ti' i naa ak'ulum.</para>
</usx>