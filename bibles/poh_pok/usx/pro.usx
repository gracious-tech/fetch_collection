<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="PRO" style="id">PROPOK.SFK 02-05-2,008 Adelina Quej Xoy. Pokomchi. Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">PROVERBIOS</para>
  <para style="toc3">Prov</para>
  <para style="toc2">Prov</para>
  <para style="toc1">PROVERBIOS</para>
  <para style="mt2">RE' I RUHUUJ I PROVERBIOS</para>
  <para style="mt1">PROVERBIOS</para>
  <chapter number="1" style="c" />
  <para style="s">Re' ruk'am chaloq taqe i holohik laj na'ojb'al q'orooj chaloq</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe i na'ojb'al wili ruq'orom chaloq i Salomón xwihik cho chi reyil Israel, rak'uun reey David.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Xutz'ihb'aaj, reh chi naa rureqariik chi riij i nimaq kiwach na'ojb'al.</para>
  <para style="q">Eh chi naa rutijiik iib', chi naa runaab'jiik i holohaq laj na'ojb'al,</para>
  <para style="q">
    <verse number="3" style="v" />chi naa rutijiik iib', naa ruwihiik na'ojb'al.</para>
  <para style="q">Eh chi naa ruwihiik rukorkiil wach k'uxliis, chi re' korik naa rub'aan,</para>
  <para style="q">
    <verse number="4" style="v" />reh chi naa ruwihiik kina'ojb'al i ma' xta kina'ojb'al.</para>
  <para style="q">Reh chi re' taqe k'ijolaq, xa re' chik i holohik neenkikapaaj rub'aan.</para>
  <para style="q">
    <verse number="5" style="v" />Eh noq naa rib'iram taqe i na'ojb'al wili</para>
  <para style="q">i wilik runa'ojb'al, naa rureqem ruman i runa'ojb'al.</para>
  <para style="q">Eh reht'al chik i naa rub'anam.</para>
  <para style="q">
    <verse number="6" style="v" />Reh chi neerureq chi riij inkiq'or i wilik kina'ojb'al.</para>
  <para style="q">Eh nee rureq chi riij aha' wilik i ma' inki a'n ta ruch'ob'ariik rub'ehel.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' raa' ri'sil i na'ojb'al re' i ruyohljiik i QaJaaw Dios.</para>
  <para style="q">Re' taqe i yiib' wach kina'ojb'al inkixowaaj wach</para>
  <para style="q">i holohik laj na'ojb'al, i tijinik imb'aan.</para>
  <para style="s">Re' K'uhb'alinik chi naa rub'aan i holohik laj na'ojb'al</para>
  <para style="q">
    <verse number="8" style="v" />Hat wak'uun noq wilkaat, chab'iraj i naa nuq'orom</para>
  <para style="q">aweh, chak'am naah aatijiik i rub'an aawajaaw.</para>
  <para style="q">Eh maaq'eb' chi riij ak'ux aak'uhb'aaljiik i rub'an aatuut.</para>
  <para style="q">
    <verse number="9" style="v" />Ruum re' taqe re' xiik' naah loq'il cha weh, je' naa jino'q aakorona reh wach anaah,</para>
  <para style="q">je' naa aakarena chawalaq.</para>
  <para style="q">
    <verse number="10" style="v" />Hat wak'uun noq wilkaat, wila' xatkaaj kijot'om taqe i aj mahk</para>
  <para style="q">maayeew q'ab' keh.</para>
  <para style="q">
    <verse number="11" style="v" />Eh xkiq'or-oq aweh chi je' wili:</para>
  <para style="q">Taq chiqiij qaq'at chaloq i xa awach pa' ineenik'ik pamb'eeh, neenqakansaj</para>
  <para style="q">atoob' ta wilik ma' chih ru mahk.</para>
  <para style="q">
    <verse number="12" style="v" />Neenqik'saj i qak'aah chikinaah, neenqab'iq' taqe chi manlik kiwach,</para>
  <para style="q">je' rukab' noq i rub'iq' i kamnaq i chaamlaj jul.</para>
  <para style="q">
    <verse number="13" style="v" />Chi je' re', neenqaq'uch i chib'ih keh, eh ma' k'isiin ta nee qoh b'ehoomrik.</para>
  <para style="q">Korehtaal neenujik i qapaat ruum i chib'ih qeh.</para>
  <para style="q">
    <verse number="14" style="v" />Taq chiqiij, cha a'n rusuqkiil inqa'an rusuqkiil i hoj.</para>
  <para style="q">Eh chamol wach i atumiin quuk', inko'q taqe aweh.</para>
  <para style="q">
    <verse number="15" style="v" />Re' hat wak'uun noq wilkaat maak'ulaa' ojik chikiij.</para>
  <para style="q">Chawesaj la' awiib' chuwach i kiyiib' wach b'eeh.</para>
  <para style="q">
    <verse number="16" style="v" />Ruum re' keh xankinik'eej chik kiq'iij chub'anariik i yiib' wach na'ojb'al.</para>
  <para style="q">Eh je' wo' chukanteesjiik i kas kichaaq'.</para>
  <para style="q">
    <verse number="17" style="v" />Re' i q'atooj inki a'n xama' xta inokik wii', chawil i tz'ikin wila' xrilow i xirob'</para>
  <para style="q">xama' nee ta wo' chik inqajik ar.</para>
  <para style="q">
    <verse number="18" style="v" />Eh ruuk' taqe inki a'n re' re', xa re' keh inkikansaj kiib'.</para>
  <para style="q">Eh inkiyeew panyohb'aal i kik'achariik.</para>
  <para style="q">
    <verse number="19" style="v" />Je' re' inkik'ul noq inooj kuxoq taqe i k'axal wach b'ehomal.</para>
  <para style="q">Ruum i re', inkiyeew kiib' pankimik.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Re' taqe i holohik laj na'ojb'al kow k'ahchi' ruq'orariik</para>
  <para style="q">rib'iral chupaam taqe i nim b'eeh, eh xilak taq b'eeh.</para>
  <para style="q">
    <verse number="21" style="v" />Eh k'ahchi' ruq'orariik chupaam taqe ye'aab' inkimol wii' kiib' i tinamit.</para>
  <para style="q">K'ahchi' ruq'orariik chupaam taqe i ookb'al reh i tinamit.</para>
  <para style="q">
    <verse number="22" style="v" />Eh ¿kojaruuj taq inakanaa' rub'aan taqe na'ojb'al xama' xta ruk'am chaloq? Eh</para>
  <para style="q">¿Mi nee taq inareq rusuqkiil ak'ux ruuk' i rukaqse'ljiik i korik taq i na a'n?</para>
  <para style="q">¿Mi juneliik ma' naa ta ruponiik taq panaq'awach re' i holohik laj na'ojb'al?</para>
  <para style="q">
    <verse number="23" style="v" />Chab'iraj taq aak'uhb'aaljiik i nub'an,</para>
  <para style="q">chi je' re' nee taq i nuyeew aweh i holohik laj na'ojb'al.</para>
  <para style="q">Eh nee taq i nuyeew aweh chi naab'jik taqe i ruq'or i nuk'uhb'aal.</para>
  <para style="q">
    <verse number="24" style="v" />Eh noq xnusik' naq taq chaawach chi naa taq kinanimam re' taq i hat ma' xawaaj ta taq.</para>
  <para style="q">Noq xatwaaj naq taq kaat nutoob'eem ma' xak'ulaa' ta wo' taq.</para>
  <para style="q">
    <verse number="25" style="v" />Ma' xponik ta la' taq panaq'awach aq'ilariik xnub'an.</para>
  <para style="q">Ma' xawaaj ta taq ak'ulum aak'uhb'aaljiik xnub'an.</para>
  <para style="q">
    <verse number="26" style="v" />Re' hin ilook' insuuqb'ik nuk'ux, re' na' chaloq i ti' k'axik taq cha naah</para>
  <para style="q">Eh naa taq kaat nuse'laam noq xatib'arb'otik taq chik ruum ayo'jiik</para>
  <para style="q">
    <verse number="27" style="v" />Eh na' ponoq i ruq'ijil noq naa ruchaliik taq cha naah, i yo'jiik,</para>
  <para style="q">i k'axkiil, i ruti'kiil k'uxliis, i ruti'kiil ánima</para>
  <para style="q">chi je' nk'u'loq jino'q teew jab',</para>
  <para style="q">re' ruuk' rusach wach chu'nchel i xa chib'ih jariik.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Ko ar aj naq chik re' naa taq apahqaam i wotob'il.</para>
  <para style="q">Eh re' hin ma' naa ta chik taq kaat nutob'eem,</para>
  <para style="q">naa naq chik taq kinasik'im ma' naa ta chik ruye'em riib',</para>
  <para style="q">
    <verse number="29" style="v" />ruum re' taq i hat, ma' xponik ta taq panaq'awach i holohik laj na'ojb'al.</para>
  <para style="q">Eh ma' xayohleej ta taq nuwach i hin, hin Dios,</para>
  <para style="q">
    <verse number="30" style="v" />ni xata xawaaj taq animam aak'uhb'aaljiik xnub'an,</para>
  <para style="q">ma' xponik ta taq panaq'awach aq'ilariik xnub'an.</para>
  <para style="q">
    <verse number="31" style="v" />Re' taq i hat naa taq ak'ulum i ti' k'axik</para>
  <para style="q">ruum taq ayiib' wach na'ojb'al,</para>
  <para style="q">ruum xa a'n taq ana'ojb'al awutkeel awiib'</para>
  <para style="q">
    <verse number="32" style="v" />Re' taqe ma' xta kina'ojb'al, ruum chi xkiq'eb'</para>
  <para style="q">kiib' naa ruchaliik i kimik chikinaah.</para>
  <para style="q">Re' taqe yiib' wach na'ojb'al, re' re' naa ruq'eb'wiik keh.</para>
  <para style="q">
    <verse number="33" style="v" />Raaj awach inib'irinik reh i nuq'or i hin, naa ruk'achariik pansuqkiil k'uxliis.</para>
  <para style="q">Eh ma' xta jino'q yohb'aal neenchalik chinaah.</para>
  <chapter number="2" style="c" />
  <para style="s">Re' i q'e' looq' i ruk'am chaloq i holohik laj na'ojb'al</para>
  <para style="q">
    <verse number="1" style="v" />Hat wak'uun noq wilkaat cha nimaj taqe nuq'oral,</para>
  <para style="q">eh chamol panawánima taqe i nuk'uhb'aal.</para>
  <para style="q">
    <verse number="2" style="v" />Chayeew axikin chi rib'iirjiik i holohik laj na'ojb'al.</para>
  <para style="q">Eh cha teh awánima, reh chi neen wihik ana'ojb'al.</para>
  <para style="q">
    <verse number="3" style="v" />Kow cha pahqaaj ana'ojb'al,</para>
  <para style="q">je' wo' hoq i holohik chi b'anarik.</para>
  <para style="q">
    <verse number="4" style="v" />Eh cha chop ak'ux chusik'ariik, je'-oq insik'arik plata,</para>
  <para style="q">je'-oq insik'arik i xa chib'ih jariik q'e' k'ih tz'aaq cha a'n.</para>
  <para style="q">
    <verse number="5" style="v" />Chi je' re', neenareq chi riij i ruyohljiik i QaJaaw Dios.</para>
  <para style="q">Eh neenareq chi riij i na'ojb'al iraaj i Dios,</para>
  <para style="q">
    <verse number="6" style="v" />ruum xa re' wo' i QaJaaw Dios inye'wik i holohik laj na'ojb'al,</para>
  <para style="q">je' wo' taqe i holohik laj kapeew, i ruq'or ruuk' chii'.</para>
  <para style="q">
    <verse number="7" style="v" />Re' QaJaaw Dios irutoob'eej, i ruko'leej taqe i korik wach i kik'achariik.</para>
  <para style="q">Eh ma' xta k'isinoq ruch'uwa'iil wach i kánima.</para>
  <para style="q">
    <verse number="8" style="v" />Eh i rucha'jeej taqe i korik wach kik'ux pan kik'achariik.</para>
  <para style="q">Eh i ruko'leej taqe i wilik i kisantohiil.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hat naa anab'eem i korik, i rub'ehel.</para>
  <para style="q">Eh naa achopom ak'ux chub'aan chu'nchel i holohik chi b'anarik.</para>
  <para style="q">
    <verse number="10" style="v" />Re' hat naa ruwihiik panawánima i holohik laj na'ojb'al,</para>
  <para style="q">eh neena a'n rusuqkiil i holohik chi naab'jik.</para>
  <para style="q">
    <verse number="11" style="v" />Re' holohik laj k'uhb'aal,</para>
  <para style="q">eh re' holohik laj na'ojb'al naa ruko'liniik aweh chi eliik.</para>
  <para style="q">
    <verse number="12" style="v" />Re' taqe re' naa resaniik aweh chupaam i yiib' wach b'eeh.</para>
  <para style="q">Eh je' wo' pan kiq'ab' i yiib' wach kiq'orik.</para>
  <para style="q">
    <verse number="13" style="v" />Re' taqe re' ineesanik aweh pan kiq'ab' i kiq'eb'wik reh i holohik laj b'eeh.</para>
  <para style="q">Eh kiooj chupaam i yiib' wach b'eeh.</para>
  <para style="q">
    <verse number="14" style="v" />Eh je' wo' pan kiq'ab' i xasuq chik kik'ux chub'aan i jot'ooj,</para>
  <para style="q">xankich'ikaa' chik kik'ux chub'aan i yiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="15" style="v" />Eh re' ma' holohik ta laj b'eeh xkik'am,</para>
  <para style="q">eh xkiq'eb' i holohik laj b'eeh.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Re' hat re' holohik laj na'ojb'al neenko'linik aweh pan q'ab' k'oyoom laj ixoq,</para>
  <para style="q">ma' aweht'al ta wach, holohik laj q'orik tiruq'unej wii'.</para>
  <para style="q">
    <verse number="17" style="v" />Eh xuq'eb' chaloq i peet rub'ahiil noq koxq'un chaloq,</para>
  <para style="q">xsahchik paruk'ux taqe ruq'orom cho ree Dios chi naa rub'anam.</para>
  <para style="q">
    <verse number="18" style="v" />Eh wila' xak'ulaa' reh ojik k'achareel parupaat,</para>
  <para style="q">re' i rub'eeh i kimik k'ahchi' ak'amam.</para>
  <para style="q">
    <verse number="19" style="v" />Re' taqe i kitahqinik reh ixoq re' re' ma' naa ta chik kikorjik.</para>
  <para style="q">Eh ma' naa ta chik kireqem i korik laj b'eeh reh i holohik laj k'acharik.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Eh re' hat, re' holohik b'eeh chak'am naah.</para>
  <para style="q">Eh cha tijej aweh i kina'ojb'al taqe i korik wach kik'ux,</para>
  <para style="q">
    <verse number="21" style="v" />ruum re' taqe korik wach kik'ux i ma' xta ruch'uwa'iil wach i kánima.</para>
  <para style="q">Eh naa kik'achariik chi juneliik chupaam i ye'aab'.</para>
  <para style="q">
    <verse number="22" style="v" />Eh re' taqe i yiib' wach kina'ojb'al ruch'ihil taqe ma' kinimanik taj</para>
  <para style="q">ma' naa ta kik'ulariik cho chupaam i ye'aab' re' re'.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' ruq'orariik chi naa runimjiik i holohik laj na'ojb'al</para>
  <para style="q">
    <verse number="1" style="v" />Hat wak'uun noq wilkaat, ma' nsahchik panak'ux i ti nutijej wii'.</para>
  <para style="q">Chamol la' panawánima taqe i nuk'uhb'aal.</para>
  <para style="q">
    <verse number="2" style="v" />Chi je' re' k'ih laj q'iij, k'ih laj haab'</para>
  <para style="q">nee ti k'acharik, eh suq nee ti wihik.</para>
  <para style="q">
    <verse number="3" style="v" />Maacanaa' rub'aan i ketelinik wachiis.</para>
  <para style="q">Je' wo' hoq i rub'aan i korik, wilik-oq la' awuuk' chi juneliik,</para>
  <para style="q">je'-oq aakarena chawalaq, cha tz'ihb'aaj panawánima.</para>
  <para style="q">
    <verse number="4" style="v" />Chi je' re' holohik neetib'anik.</para>
  <para style="q">Neemponik chuwach i Dios, nee wo' imponik chikiwach taqe i tinamit.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Ruuk' i QaJaaw Dios chayeew ak'ux,</para>
  <para style="q">maayeew ak'ux chinaah aana'ojb'al i hat cha wib'il awiib'.</para>
  <para style="q">
    <verse number="6" style="v" />Chapahqaaj i rotob'il i QaJaaw Dios ruuk' chu'nchel naa a'nam,</para>
  <para style="q">re' reh neetiruk'am chupaam i holohik laj b'eeh.</para>
  <para style="q">
    <verse number="7" style="v" />Maacapaaj chi wilik ana'ojb'al cha wib'il awiib'.</para>
  <para style="q">Chayohleej la' i QaJaaw Dios, cha kanaa' rub'aan i yiib' wach na'ojb'al,</para>
  <para style="q">
    <verse number="8" style="v" />ruum re' re' naa ruye'wiik rukowiil chu'nchel aati'jolal,</para>
  <para style="q">je' wo' taqe ab'aqil.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Chak'ax i QaJaaw Dios ruuk' taqe i chib'ih aweh,</para>
  <para style="q">je' wo' ruuk' chu'nchel i peet wach atik.</para>
  <para style="q">
    <verse number="10" style="v" />Chi je' re' korehtaal imb'ulinik ye'aab' reh i wach atik.</para>
  <para style="q">Eh korehtaal imb'ulinik ye'aab' reh i riis i wach aa-uuva.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Hat wak'uun noq wilkaat maawixowaaj aak'uhb'aaljiik i rub'an i QaJaaw Dios,</para>
  <para style="q">eh maayoj ak'ux wila' kow xat ruq'il,</para>
  <para style="q">
    <verse number="12" style="v" />ruum re' QaJaaw Dios kow i ruq'il awach i q'e' ruk'ax.</para>
  <para style="q">Je' rukab' i rub'an ajaab'ees, kow i ruq'il i awach i q'e' raaj wach paruk'ux i reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Atoob' reh awach i rureq i holohik laj na'ojb'al.</para>
  <para style="q">Eh i rureq chi riij i chu'nchel.</para>
  <para style="q">
    <verse number="14" style="v" />Ruum re' taqe re' xiik' naah k'ihaal tz'aaq chuwach i plata.</para>
  <para style="q">Eh re' ruk'am chaloq taqe re' ma' xata je' k'ihaal tz'aaq i xti manlik oro.</para>
  <para style="q">
    <verse number="15" style="v" />Re' i holohik laj na'ojb'al xiik' naah k'ihaal tz'aaq chuwach taqe i holohaq ab'aj.</para>
  <para style="q">Ma' xata je' holwochiil taqe i xa chib'ih jariik i q'e' ink'axarik wach.</para>
  <para style="q">
    <verse number="16" style="v" />Eh ruuk' rureqariik i na'ojb'al inchalik inajt rooq k'acharik,</para>
  <para style="q">i b'ehomal, je' wo' hoq i loq'il.</para>
  <para style="q">
    <verse number="17" style="v" />Eh xiik' naah chihojal,</para>
  <para style="q">pansuqkiil k'uxliis, eh pan holohik laj k'acharik ink'amwik.</para>
  <para style="q">
    <verse number="18" style="v" />Re' holohik laj na'ojb'al k'acharik i ruk'am choo chi keh i kinimanik reh.</para>
  <para style="q">Atoob' keh awach taqe inki a'n ruk'amariik naah.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Re' QaJaaw Dios, ruuk' runa'ojb'al,</para>
  <para style="q">eh ruuk' i ruholohik laj kapeew xuyejaa' i taxaaj, i wach ak'al.</para>
  <para style="q">
    <verse number="20" style="v" />Eh ruuk' i runa'ojb'al xuyeew pareh taqe i palaw,</para>
  <para style="q">xuyeew pan taxaaj i suutz' reh chi ruyeew chaloq i jab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Hat wak'uun noq wilkaat maakanaa' rub'aan i holohik chi b'anarik,</para>
  <para style="q">maakanaa' chik rib'iirjiik i k'uhb'aal, i aq'ilariik,</para>
  <para style="q">
    <verse number="22" style="v" />ruum re' re' naa ruye'wiik ak'achariik.</para>
  <para style="q">Eh je' naa naa kaat ruxoyem ruuk' jino'q i karena.</para>
  <para style="q">
    <verse number="23" style="v" />Chi je' re' ch'iklik ak'ux noq nee ti wihik panak'achariik,</para>
  <para style="q">eh ma' xta neetiq'ehb'ik wii'.</para>
  <para style="q">
    <verse number="24" style="v" />Eh noq nee ti okik chi hi'lik ma' xta neetiyo'jik wii'.</para>
  <para style="q">Eh noq nee tiyohkik suq laj wirik neena a'n.</para>
  <para style="q">
    <verse number="25" style="v" />Ma' nee ta tiyo'jik ruum taqe i yohb'aal neenk'u'loq.</para>
  <para style="q">Eh ni xa taa neetiyo'jik noq neensacharik kiwach i yiib' wach kina'ojb'al,</para>
  <para style="q">
    <verse number="26" style="v" />ruum re' i QaJaaw Dios naa ruye'wiik rukowiil ak'ux.</para>
  <para style="q">Eh ma' naa ta ruye'em q'ab' chi naa aq'ehb'iik pan k'axik.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Re' hat wila' xkipahqaaj otob'il aweh</para>
  <para style="q">maaq'or chi ma' nee ta na a'n wila' nee wo' na a'n rub'aan.</para>
  <para style="q">
    <verse number="28" style="v" />Aha' wilik otob'il</para>
  <para style="q">nee ruyeew riib' chi neena a'n yu'naak</para>
  <para style="q">maakanaa' reh eqal</para>
  <para style="q">
    <verse number="29" style="v" />Maa kapaaj rujot'ariik aawas achaaq'</para>
  <para style="q">ruum awuuk'-oq tii hat ch'iklik ruk'ux chi naa atoob'eem</para>
  <para style="q">
    <verse number="30" style="v" />Maasik' i peleto ruuk' i xa awach</para>
  <para style="q">wila' ma' awach i k'ahchi' rujot'wiik aweh.</para>
  <para style="q">
    <verse number="31" style="v" />Maawixowaaj wach i yiib' wach i runa'ojb'al.</para>
  <para style="q">Eh maa a'n aweh i ma' holohik taj i rub'an,</para>
  <para style="q">
    <verse number="32" style="v" />ruum re' i QaJaaw Dios ma' imponik ta chuwach i yiib' wach na'ojb'al.</para>
  <para style="q">Eh re' i korik wach kik'ux, ra'j imponik chuwach re'.</para>
  <para style="q">
    <verse number="33" style="v" />Re' QaJaaw Dios ma' rutoob'eej ta parupaat i yiib' wach runa'ojb'al.</para>
  <para style="q">Eh re' korik wach ruk'ux, ra'j i rutoob'eej parupaat re'.</para>
  <para style="q">
    <verse number="34" style="v" />Re' QaJaaw Dios naa ruse'laam taqe i kikaqse'lanik reh i korik.</para>
  <para style="q">Eh naa taqe rutoob'eem i xama' nimaq ta kiwach.</para>
  <para style="q">
    <verse number="35" style="v" />Re' i wilik kina'ojb'al naa ruye'ariik kiloq'il.</para>
  <para style="q">Eh re' taqe i yiib' wach kina'ojb'al naa rehtesjiik i runimaal kiwach.</para>
  <chapter number="4" style="c" />
  <para style="s">Re' k'uhb'alinik chi naa ruk'amariik i holohik laj b'eeh</para>
  <para style="q">
    <verse number="1" style="v" />Hat taq ak'uunb'ees, ixq'uunb'ees cha nimaj taq aak'uhb'aaljiik i rub'an aawajaaw.</para>
  <para style="q">Xti chab'iraj taq, reh chi holohik taq neetib'anik.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin holohik taq aatijiik xnub'an,</para>
  <para style="q">maayeew taq chi re' chi ma' re' i xatnutijej taq wii'.</para>
  <para style="q">
    <verse number="3" style="v" />Re' hin, hin wo' chaloq rak'uun i wajaaw,</para>
  <para style="q">eh re' nutuut q'e' xiruk'ax, ruum xa hin wo' jinaj chuwach.</para>
  <para style="q">
    <verse number="4" style="v" />Re' wajaaw je' wili i xuq'or weh:</para>
  <para style="q">Chamol taqe panawánima i tinuk'uhb'alej wii',</para>
  <para style="q">cha a'n taqe i nuq'or aweh, reh chi nee ti k'acharik.</para>
  <para style="q">
    <verse number="5" style="v" />Chak'am naah i holohik laj na'ojb'al, holohik tib'anoq.</para>
  <para style="q">Mansahchik panak'ux taqe i nuq'or aweh ruuk' nuchii'.</para>
  <para style="q">
    <verse number="6" style="v" />Chak'ax i holohik laj na'ojb'al maaq'eb' chi riij ak'ux,</para>
  <para style="q">ruum re' re' naa ruko'liniik aweh.</para>
  <para style="q">
    <verse number="7" style="v" />Eh chuwach chu'nchel i naa a'nam,</para>
  <para style="q">peet i holohik laj na'ojb'al naa ak'amam naah, ruum i ruk'ul chi naa ruwihiik ana'ojb'al.</para>
  <para style="q">
    <verse number="8" style="v" />Chak'ax, reh chi nee ruyeew runimaal awach</para>
  <para style="q">maakanaa' chik rub'aan reh chi nee ruyeew aloq'il.</para>
  <para style="q">
    <verse number="9" style="v" />Eh naa ruye'em chaaweh i rotob'il chi jinaj loq'laj kooch,</para>
  <para style="q">jinaj holohik laj corona cha weh, inki weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Hat wak'uun noq wilkaat chab'iraj aak'uhb'aaljiik i nub'an,</para>
  <para style="q">chamol panawánima, reh chi k'ih laj haab' nee ti k'acharik.</para>
  <para style="q">
    <verse number="11" style="v" />Re' hin neetinuk'am chupaam i holohik laj na'ojb'al,</para>
  <para style="q">eh nee tinuk'am chupaam i holohik laj b'eeh.</para>
  <para style="q">
    <verse number="12" style="v" />Re' i ma' xta naa ruq'ilwiik aweh chupaam,</para>
  <para style="q">atoob' ta kow nee tiooj, ma' xta neenq'atwik panab'eeh.</para>
  <para style="q">
    <verse number="13" style="v" />Xti chayeew panak'ux aak'uhb'aaljiik, maakanaa' rub'aan.</para>
  <para style="q">Cha a'n la' i ruq'or, ruum re' re' inye'wik ak'achariik.</para>
  <para style="q">
    <verse number="14" style="v" />Mat'ooj inche chikiij taqe i yiib' wach kina'ojb'al,</para>
  <para style="q">maatijej aweh i yiib' wach inki a'n</para>
  <para style="q">
    <verse number="15" style="v" />Maatahqeej taqe chub'anariik i yiib' wach na'ojb'al.</para>
  <para style="q">Re' la' i holohik cha a'n i hat,</para>
  <para style="q">
    <verse number="16" style="v" />ruum re' keh ma' nsuuqb'ik ta kik'ux wila' ma' nkian i yiib' wach.</para>
  <para style="q">Eh inkikuy kiwiriik chub'anariik ti' k'axik ree kas kichaaq'.</para>
  <para style="q">
    <verse number="17" style="v" />Ruuk' i yiib' wach inki a'n</para>
  <para style="q">ruuk' i leq' inki a'n inkireq tz'aaq kiwa' kihaa'.</para>
  <para style="q">
    <verse number="18" style="v" />Eh re' i kik'achariik i korik wach kik'ux,</para>
  <para style="q">xa je' chik rukab' noq ink'u'loq i rusaqumaal i q'iij, korehtaal insaquumb'ik chi korik.</para>
  <para style="q">
    <verse number="19" style="v" />Raaj i kik'achariik i yiib' wach kina'ojb'al keh,</para>
  <para style="q">xa je' chik rukab' i q'equm, ni xata naq inkikoj rehtaal chib'ih kiq'ehb'ik wii'.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Hat wak'uun noq wilkaat, chak'am naah taqe aak'uhb'aaljiik i nub'an ruuk' nuchii'.</para>
  <para style="q">Chayeew axikin reh taqe i nuq'or aweh.</para>
  <para style="q">
    <verse number="21" style="v" />Manooj sahchoq chawach,</para>
  <para style="q">chamol la' taqe panawánima chi manlik,</para>
  <para style="q">
    <verse number="22" style="v" />ruum awach i molwik reh inye'arik ruk'achariik,</para>
  <para style="q">eh re' re' inye'wik rukowiil chu'nchel i kiti'jolal.</para>
  <para style="q">
    <verse number="23" style="v" />Re' peet naa a'nam re' chi naa acha'jeem awiib',</para>
  <para style="q">manokik i ma' holohik taj panawánima, ruum re' re' inye'wik k'acharik.</para>
  <para style="q">
    <verse number="24" style="v" />Maaq'or aha' wilik i ma' korik taj,</para>
  <para style="q">eh mat chukwik q'orik.</para>
  <para style="q">
    <verse number="25" style="v" />Re' holohik chawil reje,</para>
  <para style="q">hiy chawach korehtaal i na a'n rusuqkiil i k'ahchi' asik'im.</para>
  <para style="q">
    <verse number="26" style="v" />Eh xti chakoj rehtaal aha' k'ahchi' awojiik,</para>
  <para style="q">korik-oq aweh i k'ahchi' kaat reh chi ma' xta neetikalojik wii'.</para>
  <para style="q">
    <verse number="27" style="v" />Maacanaa' i holohik laj b'eeh,</para>
  <para style="q">eh mat'ooj chub'anariik taqe i yiib' wach na'ojb'al.</para>
  <chapter number="5" style="c" />
  <para style="s">Re' q'ilooj chi ma' naa ta rub'aan i ch'uwa' wach chi b'anarik</para>
  <para style="q">
    <verse number="1" style="v" />Hat wak'uun noq wilkaat chak'am naah i nu holohik laj na'ojb'al i hin.</para>
  <para style="q">Eh chayeew axikin chi rib'iirjiik taqe i nuna'ojb'al,</para>
  <para style="q">
    <verse number="2" style="v" />reh chi neenareq chi riij chib'ih i neena a'n.</para>
  <para style="q">Eh neenakapaaj riij chib'ih i neenaq'or.</para>
  <para style="q">
    <verse number="3" style="v" />Re' k'oyoom laj ixoq xasuq chik inq'orik, xa je' chik ki'iil riis kaab',</para>
  <para style="q">re' ruq'oral xa ch'ub'ik chik xa je' chik ch'ub' kiil aseite.</para>
  <para style="q">
    <verse number="4" style="v" />Eh noq inooj kuxoq, xa je' chik rukab' i riis ch'ahn xiik' naah k'ahiil.</para>
  <para style="q">Je' ti'kiil i ruyok' i ch'ihch' k'ul q'as i rub'an.</para>
  <para style="q">
    <verse number="5" style="v" />Re' rutahqaljiik i k'oyoom laj ixoq pankimik ink'amwik,</para>
  <para style="q">eh re' re' ink'amwik reje nah kamnaq noq inooj kuxoq.</para>
  <para style="q">
    <verse number="6" style="v" />Re' reh ma' xta raaj reh i rub'eeh i holohik laj k'acharik.</para>
  <para style="q">Eh ma' rukoj ta rehtaal chi ma' holohik taj i k'ahchi' rojiik wii'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Hat wak'uun noq wilkaat, xti chab'iraj i nuq'or aweh,</para>
  <para style="q">maaq'eb' chi riij ak'ux aatijiik i nub'an.</para>
  <para style="q">
    <verse number="8" style="v" />Maayeew q'ab' chi nee tirujot' i k'oyoom laj ixoq,</para>
  <para style="q">ni xata naq neenakapaaj ojik chi riij parupaat,</para>
  <para style="q">
    <verse number="9" style="v" />reh chi ma' nee ta nayeew aaloq'il reh tokoom,</para>
  <para style="q">eh ma' nee ta nayeew awansil, keh i ma' keht'al ta rukorkiil,</para>
  <para style="q">
    <verse number="10" style="v" />reh chi ma' tokoom ta neemb'anik rusuqkiil</para>
  <para style="q">inareq ruuk' awansil, inareq ruuk' aakamaj.</para>
  <para style="q">
    <verse number="11" style="v" />Eh wila' ma' xatnimanik naa awoq'iim,</para>
  <para style="q">noq naa awik'raam chi q'uun q'uun naa rojiik rujot'om riib' aati'jolal.</para>
  <para style="q">
    <verse number="12" style="v" />Kore' naq chik naa aq'orom chi je' wili:</para>
  <para style="q">Chib'ih inche reet noq ma' xnunimaj i nutiijiik xb'aan.</para>
  <para style="q">Chib'ih inche reet noq ma' xponik</para>
  <para style="q">ta panaq' nuwach taqe i nuq'ilariik xb'aan.</para>
  <para style="q">
    <verse number="13" style="v" />Ma' xwaaj ta' nche b'iram i xkiq'or taqe i xitijinik weh.</para>
  <para style="q">Eh ma' xwaaj ta' nche nuk'amam naah i xinkitijej wii'.</para>
  <para style="q">
    <verse number="14" style="v" />Eh ma' k'isiin ta ti'kiil</para>
  <para style="q">wilkiin chi kixilak chu'nchel i tinamit, tiko'q naq chik.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Chach'ikaa' ak'ux ruuk' awehk'een wilik panapaat.</para>
  <para style="q">Re' reh je' rukab' i ahaa' inik'sanik chiq chi'iil.</para>
  <para style="q">
    <verse number="16" style="v" />Xa ruuk' wo' reh naa ruwihiik aha' lak'uun.</para>
  <para style="q">Re' hat ma' xata aha' naa aq'eb'em aha' lak'uun</para>
  <para style="q">je' rukab' noq inchihkik i ha' pantaq b'eeh.</para>
  <para style="q">
    <verse number="17" style="v" />Re' aha'lak'uun aweh taqe chi manlik,</para>
  <para style="q">ma' ruyeew ta riib' chi nee nayeew taqe chi re' chi ma' re' ruuk' jino'q i tokoom.</para>
  <para style="q">
    <verse number="18" style="v" />Re' taqe aha'lak'uun ruuk' awehk'een xa a'n wii' kaxáro pan awak'uniil q'e' taqe looq'.</para>
  <para style="q">Ruum aj re' cha a'n rusuqkiil i k'acharik ruuk'.</para>
  <para style="q">
    <verse number="19" style="v" />Looq'-oq aweh awehk'een, ruum q'e' holohik,</para>
  <para style="q">cha k'ax, ruum xa eliik i ruyeew rusuqkiil ak'ux.</para>
  <para style="q">Eh xa eliik ti ruk'ax chi manlik.</para>
  <para style="q">
    <verse number="20" style="v" />Hat wak'uun noq wilkaat: ¿Chib'ih reet noq inayoj aak'achariik xa ruum i k'oyoom laj ixoq?</para>
  <para style="q">¿Chih kamaj aweh chi neenaq'ahcheej i tokoom ixoq?</para>
  <para style="q">
    <verse number="21" style="v" />Re' QaJaaw Dios reht'al nik' wach i runa'ojb'al i winaq.</para>
  <para style="q">Eh k'ahchi' rilom chib'ih taqe jariik i rub'an, i ruq'or.</para>
  <para style="q">
    <verse number="22" style="v" />Re' yiib' wach runa'ojb'al re' taqe i ma' holohik taj i rub'an, inye'wik reh pan k'axik.</para>
  <para style="q">Re' taqe ru mahk intukinik wach reh i ruk'achariik,</para>
  <para style="q">
    <verse number="23" style="v" />ruum chi ma' xunimaj taj i rutijiik, naa ruk'amam riib' pankimik.</para>
  <para style="q">Eh ruum chi xub'an iraaj i reh, xuq'eb' riib'.</para>
  <chapter number="6" style="c" />
  <para style="s">Re' q'ilooj chi ma' toob' taj chi neenko'ljik riij i tokoom pan q'atb'al q'orik</para>
  <para style="q">
    <verse number="1" style="v" />Hat wak'uun noq wilkaat,</para>
  <para style="q">wila' xooj ayeew aq'oral chi riij jino'q nenooj rub'an ruk'aas,</para>
  <para style="q">
    <verse number="2" style="v" />ruum chi xponik ayeew aq'oral xa re' hat nenooj asik' ak'axkiil.</para>
  <para style="q">Eh xa ruum taqe i neenaq'or nee tiooj qehb'oq pantz'ilom.</para>
  <para style="q">
    <verse number="3" style="v" />Hat wak'uun noq wilkaat, wila' xatq'ehb'ik ruuk' i re'.</para>
  <para style="q">Hiy cha yejaa' ruuk' awamigo, chaloch' awiib' chuwach,</para>
  <para style="q">reh chi ma' nee ta tikiyeew chutojariik i k'aas re' re'.</para>
  <para style="q">
    <verse number="4" style="v" />Chayejaa' chi jumehq'iil,</para>
  <para style="q">maawuy-eej nik'-oq najtiil, matokik chi wirik.</para>
  <para style="q">
    <verse number="5" style="v" />Chawesaj awiib' chupaam je' rukab' noq i nelik i keej chuwach inpuhb'anik reh.</para>
  <para style="q">Je' rukab' noq i nelik i tz'ikin chuwach i xirob'.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' hat, i q'e' hat sikiil chakoj rehtaal i rub'an i sinik,</para>
  <para style="q">cha tijej aweh i rub'an.</para>
  <para style="q">
    <verse number="7" style="v" />Re' reh ma' awach ta ntaaq'anik</para>
  <para style="q">reh ma' awach ta nq'orik reh chib'ih i naa rub'anam.</para>
  <para style="q">
    <verse number="8" style="v" />Xa paruk'ux la' inchalik chi rumol wach i ruwa' pan siq'jil,</para>
  <para style="q">re' noq kiwachinik taqe i tik.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hat i q'e' hat sikiil manlik i wirik xa a'n</para>
  <para style="q">Chawik'raaj awiib' wukteen</para>
  <para style="q">
    <verse number="10" style="v" />Wila' re' hat ma' xakanaa' i wirik, wi xat okik chi hi'lik,</para>
  <para style="q">wi xaq'ahcheej aaq'ab' chi ak'ux,</para>
  <para style="q">
    <verse number="11" style="v" />ma' k'isa neb'a'il i naa ruchaliik cha naah,</para>
  <para style="q">ma' naa ta chik akuyum ransil noq naa kaat ruchopom.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' i yiib' wach runa'ojb'al, ma' holohik ta imb'anik,</para>
  <para style="q">xa re' taqe i chukuj q'orik i rub'an.</para>
  <para style="q">
    <verse number="13" style="v" />Re' reh xa rumutz'muteej chik inaq'wach, xa rujuk' chik i rooq,</para>
  <para style="q">i ruk'uhtaaj reje ruuk' i ju' q'ab' i ma' holohik taj.</para>
  <para style="q">
    <verse number="14" style="v" />Eh ma' holohik taj i wilik paránima,</para>
  <para style="q">xa re' i yiib' wach i rukapaaj rub'aan, xa re' sik'ij peleto iraaj.</para>
  <para style="q">
    <verse number="15" style="v" />Ruum i re' chi jumehq'iil naa ruchaliik i ti' k'axik chinaah.</para>
  <para style="q">Xa re' yu' naa rukahniik chi ma' xta chik kamaj. Eh ma' xata chik riq'omal naa rajwaam.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Eh waqiib', eh imponik wuquub' taqe yiib' wach na'ojb'al</para>
  <para style="q">ma' imponik ta chuwach i QaJaaw Dios, re' taqe wili:</para>
  <para style="q">
    <verse number="17" style="v" />Re' niimb'isanik wachiis, re' taqe chukuj q'orik,</para>
  <para style="q">re' taqe i kikanteesjik i ma' xta kimahk.</para>
  <para style="q">
    <verse number="18" style="v" />Re' taqe i ma' holohik taj inkapeb'jik cho rub'aan pan ánima,</para>
  <para style="q">eh re' ye'ej k'uxliis chub'anariik i yiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="19" style="v" />Re' ojik chuq'orariik i ma' korik ta wo' hoq,</para>
  <para style="q">re' tikij peleto kuuk' taqe hermano.</para>
  <para style="s">Re' ti' i ruk'am chaloq i ch'uwa'risanik wach kaxáro</para>
  <para style="q">
    <verse number="20" style="v" />Hat wak'uun noq wilkaat chamol taqe panawánima aak'uhb'aaljiik,</para>
  <para style="q">aatijiik inki a'n atuut aawajaaw.</para>
  <para style="q">
    <verse number="21" style="v" />Eliik-oq wilik taqe panawánima,</para>
  <para style="q">eliik-oq taqe ab'ak'am chawalaq.</para>
  <para style="q">
    <verse number="22" style="v" />Re' taqe re' naa ruk'amwiik ab'eeh,</para>
  <para style="q">re' taqe re' naa ruko'liniik aweh panawiriik,</para>
  <para style="q">re' taqe re' naa rukojwiik ana'ojb'al noq ma' wirik ta na a'n.</para>
  <para style="q">
    <verse number="23" style="v" />Re' taqe k'uhb'aal, re' taqe atijiik imb'aan je' rukab' i saqumb'al insihq'inik.</para>
  <para style="q">Eh re' taqe aq'ilariik, taqe aak'uhb'aaljiik imb'aan,</para>
  <para style="q">re' re' ink'amwik aweh chupaam i holohik laj k'acharik.</para>
  <para style="q">
    <verse number="24" style="v" />Eh naa kaat ruko'leem pan q'ab' k'oyoom laj ixoq,</para>
  <para style="q">yiib' wach i runa'ojb'al, xa holohik chik inq'orik i rub'an riib'.</para>
  <para style="q">
    <verse number="25" style="v" />Maruyot' inche ak'ux i ruholwochiil</para>
  <para style="q">eh maak'ax inche wach, ruum xa holohik chik inilwik</para>
  <para style="q">
    <verse number="26" style="v" />Re' k'oyoom laj ixoq reh, manlik reh i junriim chi wi'k.</para>
  <para style="q">Eh re' ixoq inch'aqwik wach kaxáro intohq'ik ruyojom i ruk'achariik i winaq.</para>
  <para style="q">
    <verse number="27" style="v" />Awach i xujil i koq i q'aaq' chi' ruk'ux</para>
  <para style="q">nee wo' ink'ahtik i ruso'.</para>
  <para style="q">
    <verse number="28" style="v" />Awach i xb'ehik chinaah inaq'wach</para>
  <para style="q">q'aaq' chi ma' xta ruxijab' nee wo' ink'ahtik i rooq.</para>
  <para style="q">
    <verse number="29" style="v" />Je' wo' re' nee ruk'ul, awach i neeruq'uch i rehk'een i ras ruchaaq',</para>
  <para style="q">ma' jaruuj neenelik korik.</para>
  <para style="q">
    <verse number="30" style="v" />Re' ajileq' ma' ajwaal ta wach</para>
  <para style="q">atoob' ta ruum i runuhmiik xub'an i leq'.</para>
  <para style="q">
    <verse number="31" style="v" />Eh wila' xkan chi i leq' wuquub' chik</para>
  <para style="q">chi je' k'ihaal i xrelq'aaj i nee ruyeew chi jilow.</para>
  <para style="q">Atoob' ta nee ruyeew chi jilow chu'nchel i chib'ih reh.</para>
  <para style="q">
    <verse number="32" style="v" />Re' i q'uchul rehk'een i ras ruchaaq,</para>
  <para style="q">ma' xta runa'ojb'al. Awach imb'anik reh</para>
  <para style="q">i je' re' xa re' reh k'ahchi' ruye'em riib' panti' k'axik.</para>
  <para style="q">
    <verse number="33" style="v" />Re' reh naa rub'aan ti' k'axik reh,</para>
  <para style="q">naa ruk'uhtjiik ruk'ixb'ilaal.</para>
  <para style="q">Eh ma' jaruuj naa rik'iik pank'uxliis i rub'an,</para>
  <para style="q">
    <verse number="34" style="v" />ruum re' winaq xuq'uch i rehk'een yohb'aal wach i ruk'aah,</para>
  <para style="q">ma' naa ta rukuyariik ru mahk ruum, korehtaal inq'ajarik wach reh i xub'an.</para>
  <para style="q">
    <verse number="35" style="v" />Eh nee ta ruq'unej wach i winaq re' re', xama' nee ta wo' chik i ruk'ulaa'.</para>
  <para style="q">Atoob' ta naq neensijiik ruk'ihaal-oq chib'ih reh.</para>
  <chapter number="7" style="c" />
  <para style="s">Re' ruyiib' wach na'ojb'al ixoq i ruch'uwa'risaj wach irukaxaro</para>
  <para style="q">
    <verse number="1" style="v" />Hat wak'uun noq wilkaat cha nimaj taqe i nuq'oral,</para>
  <para style="q">chamol taqe panawánima i nuk'uhb'aal.</para>
  <para style="q">
    <verse number="2" style="v" />Chamol taqe i nuk'uhb'aal, je' wo' taqe i ti nutijej wii',</para>
  <para style="q">je' kik'axarik rutiyoxil naq'awach cha a'n.</para>
  <para style="q">Reh chi nee ti k'acharik.</para>
  <para style="q">
    <verse number="3" style="v" />Chakoj taqe ju' taq aq'ab',</para>
  <para style="q">cha tz'ihb'aaj taqe panawánima.</para>
  <para style="q">
    <verse number="4" style="v" />Chak'ax i holohik laj na'ojb'al chi je' jino'q awanaab',</para>
  <para style="q">cha k'ax i na'ojb'al chi je' jino'q awach aweh.</para>
  <para style="q">
    <verse number="5" style="v" />Ruum re' taqe re' naa ruko'liniik aweh chi ma' nee ta ti mahkunik ruuk' i</para>
  <para style="q">k'oyoom laj ixoq ma' aweht'al ta wach, ch'ub'ik laj q'orik tiruq'unej wii'.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Pan jinaj q'iij i hin tz'eht i nub'an reje</para>
  <para style="q">paru ventana hiil i nupaat.</para>
  <para style="q">
    <verse number="7" style="v" />Eh wilik taqe i k'ijool komeem taqe ik'ik inki a'n</para>
  <para style="q">Eh chi kixilak i re',</para>
  <para style="q">jinaj i komajaa' chih runa'ojb'al.</para>
  <para style="q">
    <verse number="8" style="v" />Eh xwilow noq xponik chi tz'ukaal i b'eeh</para>
  <para style="q">xooj chi korik pan q'ab' b'eeh inooj ruuk' rupaat k'oyoom laj ixoq.</para>
  <para style="q">
    <verse number="9" style="v" />Eh noq xokik i q'iij,</para>
  <para style="q">k'ahchi' chik rokiik i q'equm.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Xelik chaloq jinaj ixoq chuk'ulariik i k'ijool.</para>
  <para style="q">Re' i k'oyoom laj ixoq re' re' xaruyejaam chik riib', xa rutiq'aa' chik riib'.</para>
  <para style="q">
    <verse number="11" style="v" />Re' ruuk' ixoq xama' holohik ta imb'anik ma' xta ruk'ixiik,</para>
  <para style="q">eh xama' nwihik ta wo' parupaat.</para>
  <para style="q">
    <verse number="12" style="v" />Re' ruuk' i xa pantaq b'eeh, xa pantaq k'aayb'al wilik,</para>
  <para style="q">pantaq rutz'ukaal b'eeh inwihik, i ruy-eej aawach i nee ruchop chi peet.</para>
  <para style="q">
    <verse number="13" style="v" />Re' ixoq re' re', xelik chaloq xuq'ahcheej i k'ijool, eh xutz'ub' i koq i wach</para>
  <para style="q">je' wili xuq'or reh:</para>
  <para style="q">
    <verse number="14" style="v" />Re' hin nuq'orom chi naa nuye'em i nu k'atoj mayiij</para>
  <para style="q">reh i rusuqkiil k'uxliis yu'naak xnuyeew chik.</para>
  <para style="q">
    <verse number="15" style="v" />Ruum aj re', xinelik chaloq chak'ulariik,</para>
  <para style="q">re' hin xa nwotow naq chik rilariik awach,</para>
  <para style="q">eh kore' yu'naak xat nureq.</para>
  <para style="q">
    <verse number="16" style="v" />Xnuyejaa' chik wach inuch'aht,</para>
  <para style="q">xnuhe' chik i holohik laj chamaar chuwach re' ruuk' i lino ar inchalik Egipto.</para>
  <para style="q">
    <verse number="17" style="v" />Eh xnukoj chik ink'ohnik laj iq'oom chuwach re' ruuk'</para>
  <para style="q">i mirra, re' ruuk' i canela.</para>
  <para style="q">
    <verse number="18" style="v" />Kim taq tiyook wuuk' wach nuch'aht,</para>
  <para style="q">qa a'n rusuqkiil i q'o'rinik qiib' ar korehtaal insaq'ik.</para>
  <para style="q">
    <verse number="19" style="v" />Matcapeb'ik, ruum re' i nub'ahiil ma' xta pampaat,</para>
  <para style="q">ojinaq pan rub'iyájo eh najt xooj rub'an.</para>
  <para style="q">
    <verse number="20" style="v" />Re' reh xuk'am reje jinaj k'isa bolso chi tumiin,</para>
  <para style="q">kore' i q'iij ruq'orom naa ruk'uliik chaloq pampaat inki reh i k'ijool.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Eh toq' toq' xub'an reh i k'ijool</para>
  <para style="q">ruuk' taqe ruq'oral xuq'unej wach korehtaal xnimjik reh.</para>
  <para style="q">
    <verse number="22" style="v" />Re' k'ijool xooj wo' chi riij ixoq.</para>
  <para style="q">Je' rukab' noq ink'amarik reje i b'ooyax pan kantesb'al,</para>
  <para style="q">je' rukab' noq inooj q'ehb'oq i keej pan xirob'.</para>
  <para style="q">
    <verse number="23" style="v" />Xanaah re', xa je' chik flecha inokik ruuk' ránima,</para>
  <para style="q">je' rukab' i rub'an i tz'ikin xa nooj rumin riib' pan xirob'.</para>
  <para style="q">Ma' reht'al taj chi re' re' naa rukansaniik reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Hat wak'uun noq wilkaat,</para>
  <para style="q">re' hat xti chayeew axikin chi rib'iirjiik taqe i nuk'uhb'aal.</para>
  <para style="q">
    <verse number="25" style="v" />Maayeew taqe reje akapeb'aal chinaah iixoq re' re', manimaj reh i ruq'or aweh,</para>
  <para style="q">reh chi ma' nee ta naq'eb' awiib',</para>
  <para style="q">
    <verse number="26" style="v" />ruum re' ixoq re' re', ma' k'isiin taqe i ruye'em panti' k'axik.</para>
  <para style="q">Eh wilik wo' naq taqe i kow kiib' xuk'am taqe pankimik.</para>
  <para style="q">
    <verse number="27" style="v" />Je' re' noq awach xtahqinik reje ree ixoq re' re' parupaat,</para>
  <para style="q">re' i rub'eeh i kimik k'ahchi' ruk'amam.</para>
  <chapter number="8" style="c" />
  <para style="s">Re' ruq'orariik chib'ih i ruk'am chaloq i holohik laj na'ojb'al</para>
  <para style="q">
    <verse number="1" style="v" />Re' holohik laj na'ojb'al kow k'ahchi' ruq'orariik.</para>
  <para style="q">Re' holohik chi naab'jik kow wo' k'ahchi' ruq'orariik.</para>
  <para style="q">
    <verse number="2" style="v" />Eh k'ahchi' ruq'orariik rib'iral chinaah taqe i nimaq taq yuuq',</para>
  <para style="q">je' wo' hoq i ruk'ul taqe wii' riib' i b'eeh.</para>
  <para style="q">
    <verse number="3" style="v" />Eh i nib'irjik wo' rib'iral pantaq ookb'al,</para>
  <para style="q">je' wo' chi chii' taqe i ru puertahiil i tinamit.</para>
  <para style="q">
    <verse number="4" style="v" />Eh re' i wilik runa'ojb'al je' wili i xuq'or:</para>
  <para style="q">Hat taq tinamit, aweh taq i hat i nuq'or taqe q'orik wili.</para>
  <para style="q">
    <verse number="5" style="v" />Re' taq i hat k'ijolaq ma' xta taq ana'ojb'al, kow taq aanaah.</para>
  <para style="q">Wih-oq taq ana'ojb'al, chareq taq chi riij i naa a'nam.</para>
  <para style="q">
    <verse number="6" style="v" />Kinab'iraj taq, ruum re' taqe naa nuq'orom q'e' looq'.</para>
  <para style="q">Eh re' taqe i korik naa nuq'orom.</para>
  <para style="q">
    <verse number="7" style="v" />Re' taqe naa nuq'orom, re' i korik,</para>
  <para style="q">ruum re' hin ma' nuk'ax ta wach i chukuj q'orik.</para>
  <para style="q">
    <verse number="8" style="v" />Chu'nchel taqe nuq'or,</para>
  <para style="q">re' i rukorkiil ma' xta k'isinoq i ma' re' ta rukorkiil chi xilak.</para>
  <para style="q">
    <verse number="9" style="v" />Re' taqe nuq'oral xti korik chi reh awach i rureq chi riij.</para>
  <para style="q">Eh q'e' chihooj chi keh i wilik kina'ojb'al.</para>
  <para style="q">
    <verse number="10" style="v" />Chanimaj taq i ti nutijej wii'.</para>
  <para style="q">Eh cha sik' taq i holohik chi naab'jik,</para>
  <para style="q">ruum re' taqe re' k'ih tz'aaq chuwach i plata,</para>
  <para style="q">chuwach i manlik oro,</para>
  <para style="q">
    <verse number="11" style="v" />ruum re' i holohik laj na'ojb'al xiik' naah k'ihaal tz'aaq</para>
  <para style="q">chuwach i holohaq ab'aj, re' ruuk' inokik chi karena.</para>
  <para style="q">Eh ma' xata je' rukab' i xa chib'ih jariik ink'axarik wach.</para>
  <para style="q">
    <verse number="12" style="v" />Re' hin i nunimaj i holohik laj na'ojb'al, ruum inureq chi riij.</para>
  <para style="q">Eh ruuk' re' inureq taqe i holohaq chi naab'jik.</para>
  <para style="q">
    <verse number="13" style="v" />Re' ruyohljiik i QaJaaw Dios re' rukanab'jiik rub'aan i yiib' wach na'ojb'al.</para>
  <para style="q">Re' hin nukanaam rub'aan i niimb'isanik wachiis,</para>
  <para style="q">je' wo' chukuj q'orik ruch'ihil i ma' holohik ta laj b'eeh.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hin kink'uhtanik reh i holohik chi b'anarik.</para>
  <para style="q">Eh re' hin kink'uhtanik reh i holohik chi naab'jik, eh wilik wajaawriik chub'aan.</para>
  <para style="q">
    <verse number="15" style="v" />Xa wuum i hin inkikoj i kik'uhb'aal taqe reey,</para>
  <para style="q">eh inki a'n i q'ataj q'orik taqe i wilkeeb' chi ajaab'esil.</para>
  <para style="q">
    <verse number="16" style="v" />Xa wuum i hin inki a'n i taaq'anik i ajaab'ees.</para>
  <para style="q">Je' wo' taqe ajaab'ees kiq'atwik q'orik chikinaah i tinamit.</para>
  <para style="q">
    <verse number="17" style="v" />Re' hin i nuk'ax taqe awach i kik'axwik weh,</para>
  <para style="q">eh awach taqe i kisik'wik weh chi noq kinkireq wo' hoq.</para>
  <para style="q">
    <verse number="18" style="v" />Re' hin i nuyeew kib'ehomal, i nuyeew kiloq'il,</para>
  <para style="q">eh re' b'ehomal re' re' ma' naa ta rik'iik wach, je' wo' hoq i rub'ehel chi b'anarik.</para>
  <para style="q">
    <verse number="19" style="v" />Re' i nuyeew i hin xiik' naah chihojal chuwach i manlik oro xa ch'ub'ik chik wach.</para>
  <para style="q">Re' i nuq'or xiik' naah chihojal chuwach i manlik plata.</para>
  <para style="q">
    <verse number="20" style="v" />Re' hin chupaam i korik laj b'eeh ojik i nub'an.</para>
  <para style="q">Eh chupaam rub'eeh i holohik chi b'anarik ojik i nub'an,</para>
  <para style="q">
    <verse number="21" style="v" />reh chi re' taqe i kik'axwik weh naa nuye'em kiye'aab'.</para>
  <para style="q">Eh naa nuye'em keh chu'nchel i ajwaal wach chi keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Re' QaJaaw Dios xanoq wo' hin rutz'uhkrisam chaloq,</para>
  <para style="q">noq komajaa' chih i rutz'uhkrisaj chaloq ruuk' i rukamaj.</para>
  <para style="q">
    <verse number="23" style="v" />Xa noq wo' hin ruyejaam chaloq noq komajaa' chih i wilik,</para>
  <para style="q">re' noq komajaa' i rutz'uhkrisaj chaloq i wach ak'al.</para>
  <para style="q">
    <verse number="24" style="v" />Eh xa hin wo' chik ruyejaam noq komajaa' chih taqe i palaw.</para>
  <para style="q">Re' noq komajaa' kitz'uhkrik, komajaa' kiwihik taqe raasb'al ha'.</para>
  <para style="q">
    <verse number="25" style="v" />Re' noq komajaa' i ruyejaa' taqe i yuuq' noq komajaa' i ruyejaa' taqe i ye'aab',</para>
  <para style="q">re' hin xa hin wo' chik ruyejaam chaloq i QaJaaw Dios.</para>
  <para style="q">
    <verse number="26" style="v" />Noq komajaa' i ruyejaa' chaloq i ak'al i QaJaaw Dios je' wo' taqe i ye'aab',</para>
  <para style="q">eh noq komajaa' i ruyejaa' chaloq i rupoqil i wach ak'al.</para>
  <para style="q">
    <verse number="27" style="v" />Eh noq xuyejaa' i taxaaj chinaah i runimaal ha'</para>
  <para style="q">ar wo' wilkiin i hin ruuk' i reh.</para>
  <para style="q">
    <verse number="28" style="v" />Noq xuyeew taqe suutz' pan taxaaj,</para>
  <para style="q">eh noq xuyeew taqe palaw paruye'aab',</para>
  <para style="q">
    <verse number="29" style="v" />re' noq xuq'or reh i ruha'iil i palaw</para>
  <para style="q">chi ma' naa ta chik reliik reje chi chii'.</para>
  <para style="q">Eh noq xukoj taqe ch'ikaab' reh i wach ak'al.</para>
  <para style="q">
    <verse number="30" style="v" />Ar wo' wilkiin i koq i hin ruuk' i QaJaaw Dios,</para>
  <para style="q">eh eliik i nuyeew i koq rusuqkiil ruk'ux.</para>
  <para style="q">Eh xa eliik se'eel i koq nuwach ruuk'.</para>
  <para style="q">
    <verse number="31" style="v" />Re' hin xa se'eel chik nuwach chupaam</para>
  <para style="q">i wach ak'al noq kore' k'ahchi' ruyejaam.</para>
  <para style="q">Eh xasuq chik nuk'ux kuuk' i tinamit noq</para>
  <para style="q">kore' k'ahchi' rutz'uhkrisam inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Hat wak'uun noq wilkaat, yu'naak chab'iraj</para>
  <para style="q">i naa nuq'orom aweh, chak'am naah i nub'an i hin.</para>
  <para style="q">Chi je' re', neen wihik rusuqkiil ak'ux.</para>
  <para style="q">
    <verse number="33" style="v" />Chanimaj atijiik i nub'an,</para>
  <para style="q">maawixowaaj wach i holohik laj na'ojb'al.</para>
  <para style="q">
    <verse number="34" style="v" />Atoob' reh inib'irinik reh taqe i nuq'or.</para>
  <para style="q">Eh xaraaj chik rureqem chi riij,</para>
  <para style="q">rajlaal q'iij k'ahchi' cho kirusik'im ruuk' nupaat,</para>
  <para style="q">
    <verse number="35" style="v" />ruum awach inreqwik weh i hin i rureq i suq laj k'acharik.</para>
  <para style="q">Eh i rureq wo' i holohik laj na'ojb'al iraaj i QaJaaw Dios.</para>
  <para style="q">
    <verse number="36" style="v" />Eh awach i xq'eb'wik weh, i ruyeew panyohb'aal i ruk'achariik,</para>
  <para style="q">awach inixowanik nuwach, re' kimik naa ruchaliik chinaah.</para>
  <chapter number="9" style="c" />
  <para style="s">Re' i holohik runa'ojb'al, eh re' i yiib' wach runa'ojb'al</para>
  <para style="q">
    <verse number="1" style="v" />Re' holohik runa'ojb'al xuyejaa' i rupaat,</para>
  <para style="q">eh xuxoyej ruuk' wuquub' chi ruch'itil.</para>
  <para style="q">
    <verse number="2" style="v" />Eh xukansaj taqe i ruchikoop reh i ninq'ijinik,</para>
  <para style="q">xusik' wach i riis uuva xuyeew wach rumexa.</para>
  <para style="q">
    <verse number="3" style="v" />Eh xutaq'aaj taqe reje i raj pooh ixoq</para>
  <para style="q">chinaah i ye'aab' najt naah wilik pan tinamit. Ar xkik'er reje kichii'.</para>
  <para style="q">
    <verse number="4" style="v" />Je' wili i xkiq'or: Kim taq k'ijolaq, i komajaa' taq inareq chi riij i na a'n,</para>
  <para style="q">je' wo' taq i hat i ma' xta taq ana'ojb'al.</para>
  <para style="q">
    <verse number="5" style="v" />K'oloq taq ak'ux aweh i nukaxlanwi'k</para>
  <para style="q">k'oloq taq awuk'ej aweh i sik'oj wach riis uuva xnuyejaa'.</para>
  <para style="q">
    <verse number="6" style="v" />Chareq taq ana'ojb'al, reh chi neenareq taq i suq laj k'acharik.</para>
  <para style="q">Eh reh chi nee taq inareq chi riij i holohik chi naab'jik.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Wila' xaq'il taqe i ma' holohik ta kib'anik,</para>
  <para style="q">wila' xaq'il taqe i yiib' wach kina'ojb'al,</para>
  <para style="q">xa re' ab'ajariik neenkian, xaruti'kiil ak'ux ineenkiyeew.</para>
  <para style="q">
    <verse number="8" style="v" />Maaq'il i ma' holohik tamb'anik, reh chi ma' nee ta rixowaaj awach.</para>
  <para style="q">Re' la' holohik runa'ojb'al chaq'il, re' reh neetiruk'ax.</para>
  <para style="q">
    <verse number="9" style="v" />Chaq'il i holohik runa'ojb'al reh chi neerureq ruman i runa'ojb'al.</para>
  <para style="q">Chatijej i korik wach ruk'ux reh chi neerureq ruman i rukorkiil wach ruk'ux.</para>
  <para style="q">
    <verse number="10" style="v" />Re' raa' ri'sil i holohik laj na'ojb'al re' i ruyohljiik i QaJaaw Dios.</para>
  <para style="q">Eh re' i holohik chi naab'jik inkan xa ruum i runaab'jiik wach i Dios wilik ruSantohiil.</para>
  <para style="q">
    <verse number="11" style="v" />Eh xa ruum i holohik laj na'ojb'al najt naa ak'achariik,</para>
  <para style="q">naa rutiqariik naah jarub'-oq haab' aak'achariik.</para>
  <para style="q">
    <verse number="12" style="v" />Wila' holohik ana'ojb'al, re' wo' hat naa ab'aniik rusuqkiil.</para>
  <para style="q">Eh wila' yiib' wach ana'ojb'al, re' wo' hat naa atojwiik wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' ixoq ma' nimanik taj, xa re' i tukkinik wachiis i rub'an</para>
  <para style="q">ma' xta runa'ojb'al.</para>
  <para style="q">
    <verse number="14" style="v" />Eh i rutzunaa' riib' paruxiila chi chii' taqe i ru puertahiil i rupaat,</para>
  <para style="q">wilik chupaam i ye'aab' najt naah, wilik chupaam i tinamit.</para>
  <para style="q">
    <verse number="15" style="v" />Ar i ruyuq'eej taqe reje i ki-ik'ik pamb'eeh,</para>
  <para style="q">re' taqe i chupaam wo' naq i holohik b'eeh ojik inki a'n</para>
  <para style="q">
    <verse number="16" style="v" />Je' wili i ruq'or reje keh: Kim taq i hat i komajaa' taq inareq chi riij i na a'n.</para>
  <para style="q">Je' wo' taq i hat i ma' xta taq ana'ojb'al.</para>
  <para style="q">
    <verse number="17" style="v" />Qelq'aaj qiib', ruum re' ha' xa elq'amaj, q'e' suq chi uuk'jik.</para>
  <para style="q">Eh re' kaxlanwi'k ink'uxarik chi q'eeqmaal q'e' suq chi k'uxarik, inki.</para>
  <para style="q">
    <verse number="18" style="v" />Xanaah re', re' taqe re' ma' nkikoj ta rehtaal chi re' i kiyuq'ub'jiik imb'aan</para>
  <para style="q">ti' k'axik i ruk'am choo keh. Eh pankimik kik'amariik ruum.</para>
  <chapter number="10" style="c" />
  <para style="s">Re' korik wach ruk'ux eh re' yiib' wach runa'ojb'al</para>
  <para style="q">
    <verse number="1" style="v" />Re' reey Salomón je' wili xuq'or:</para>
  <para style="b" />
  <para style="q">Re' ak'uunb'ees holohik i runa'ojb'al i ruyeew rusuqkiil ruk'ux i rutuut rajaaw.</para>
  <para style="q">Eh re' ak'uunb'ees ma' xta runa'ojb'al i ruyeew ruti'kiil kik'ux i rutuut rajaaw.</para>
  <para style="q">
    <verse number="2" style="v" />Re' b'ehomal inkan ruuk' i leq' xama' nee ta wo' imb'aan rusuqkiil.</para>
  <para style="q">Eh re' i rukorkiil wach k'uxliis, ineesanik pankimik.</para>
  <para style="q">
    <verse number="3" style="v" />Re' QaJaaw Dios ma' ruyeew ta chukuyariik ruwa' ruhaa' i korik wach ruk'ux.</para>
  <para style="q">Eh i ruyeew chukuyariik i ruwa' ruhaa' i yiib' wach runa'ojb'al.</para>
  <para style="q">
    <verse number="4" style="v" />Awach i ma' ruchop ta ruk'ux chi kamanik, neb'a'il i ruk'am cho chinaah.</para>
  <para style="q">Awach i ruchop ruk'ux chi kamanik, b'ehomal i ruk'am cho chinaah.</para>
  <para style="q">
    <verse number="5" style="v" />Awach i rujach i wach i rutik pan siq'jil, wilik runa'ojb'al.</para>
  <para style="q">Awach inokik chi wirik paruq'ijil jach, i ruk'uhtaaj ruk'ixb'ilaal.</para>
  <para style="q">
    <verse number="6" style="v" />Re' korik wach ruk'ux intoob'jik chi manlik ruum i Dios.</para>
  <para style="q">Eh re' yiib' wach runa'ojb'al reh sachooj i rub'an ruuk' chii'.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' i korik wach ruk'ux, ma' jaruuj naa rusahchiik pank'uxliis.</para>
  <para style="q">Eh re' i yiib' wach runa'ojb'al jumehq'iil naa rusahchiik pank'uxliis.</para>
  <para style="q">
    <verse number="8" style="v" />Re' holohik runa'ojb'al chu'nchel ruk'ux i runimaj taqe k'uhb'aal.</para>
  <para style="q">Eh re' i ma' nimanik ta reh, ruuk' i chii' naa ruq'eb'em riib'.</para>
  <para style="q">
    <verse number="9" style="v" />Awach i holohik imb'anik ma' xta neenyo'jik wii'.</para>
  <para style="q">Awach i ma' holohik ta imb'anik ti' naa rojiik ruk'ulum.</para>
  <para style="q">
    <verse number="10" style="v" />Awach i ruk'ax wach i ma' holohik taj, ti' k'axik i naa ruchaliik chinaah.</para>
  <para style="q">Awach i xa reh reh i ruq'or ma' holohik taj i naa ruk'ulum.</para>
  <para style="q">
    <verse number="11" style="v" />Re' i ruq'oral i korik wach ruk'ux holohik laj k'acharik i ruk'am chaloq.</para>
  <para style="q">Eh re' yiib' wach runa'ojb'al reh sachooj i rub'an ruuk' i ruq'oral.</para>
  <para style="q">
    <verse number="12" style="v" />Awach i wilik ixowaal ruuk' xa re' i tikij peleto i rub'an.</para>
  <para style="q">Awach i wilik k'axooj ruuk' neerukuy i ma' holohik taj neemb'aan reh.</para>
  <para style="q">
    <verse number="13" style="v" />Re' ruq'oral i wilik runa'ojb'al holohik laj ruk'am chaloq.</para>
  <para style="q">Eh re' i ma' xta runa'ojb'al koruman chi naa ruye'ariik chi tz'uhuum.</para>
  <para style="q">
    <verse number="14" style="v" />Re' wilik kina'ojb'al i holohik inkik'am chaloq.</para>
  <para style="q">Re' taqe i ma' kinimanik taj ti' k'axik inkik'am chaloq.</para>
  <para style="q">
    <verse number="15" style="v" />Re' inye'wik rukowiil ruk'ux i b'ehoom, re' i rub'ehomal,</para>
  <para style="q">re' inye'wik ruti'kiil ruk'ux i neb'aa', re' i runeb'a'il.</para>
  <para style="q">
    <verse number="16" style="v" />Re' rukooch i korik wach ruk'ux re' i k'acharik.</para>
  <para style="q">Eh re' i rub'an i yiib' wach runa'ojb'al reh, xa re' mahk i ruk'am chaloq.</para>
  <para style="q">
    <verse number="17" style="v" />Awach i ruk'am naah i ruq'ilariik, chupaam i holohik laj k'acharik ojik i rub'an.</para>
  <para style="q">Awach i ma' ruk'am ta naah i ruq'ilariik, panti' k'axik ojik i rub'an.</para>
  <para style="q">
    <verse number="18" style="v" />Awach irixowaaj wach i ras ruchaaq' aj chuk'ul q'orik.</para>
  <para style="q">Awach i xa nooj chi tz'aqaj wach k'utaaj, kow i naah.</para>
  <para style="q">
    <verse number="19" style="v" />Awach i xa nwolwotik chi q'orik i ruq'eb' riib' ruuk' i ruq'oral.</para>
  <para style="q">Awach i xa rupaj i q'orik i rub'an, wilik runa'ojb'al.</para>
  <para style="q">
    <verse number="20" style="v" />Eh re' i ruq'or i ju' raaq' i korik wach ruk'ux, je' k'ihaal tz'aaq i manlik plata.</para>
  <para style="q">Eh re' i rukapaaj i yiib' wach runa'ojb'al, ma' xta tz'aaq.</para>
  <para style="q">
    <verse number="21" style="v" />Re' korik wach ruk'ux ma' k'isiin taqe i rutijej.</para>
  <para style="q">Eh re' taqe i kow i kinaah inchalik i kimik chikinaah, ruum ma' xta kina'ojb'al.</para>
  <para style="q">
    <verse number="22" style="v" />Re' rotob'il i QaJaaw Dios jinaj b'ehomal i ruk'am chaloq,</para>
  <para style="q">ma' xta ti' i ruk'am chaloq.</para>
  <para style="q">
    <verse number="23" style="v" />Re' i ma' nimanik taj xasuq chik ruk'ux chub'aan i ma' holohik taj.</para>
  <para style="q">Re' wilik runa'ojb'al, insuuqb'ik ruk'ux ruuk' i holohik laj na'ojb'al.</para>
  <para style="q">
    <verse number="24" style="v" />Re' yiib' wach runa'ojb'al aha' wilik i q'e' inyo'jik ruum re' re' inchalik chinaah.</para>
  <para style="q">Eh re' korik wach ruk'ux inye'arik reh aha' wilik iraaj.</para>
  <para style="q">
    <verse number="25" style="v" />Re' yiib' wach runa'ojb'al xa re' yu' insahchik wach, xa je' nik'ik kowlaj teew.</para>
  <para style="q">Re' i korik wach ruk'ux reh ma' jaruuj naa rusahchiik wach.</para>
  <para style="q">
    <verse number="26" style="v" />Re' móso ma' raaj ta kamanik ruti'kiil naah i rupatroon i ruyeew,</para>
  <para style="q">je' naa ch'amlaj lamúnix i ruyeew panchii', eh je' naa sib' i ruyeew panaq'wach.</para>
  <para style="q">
    <verse number="27" style="v" />Awach i ruyohleej i QaJaaw Dios intiqarik rooq i ruk'achariik.</para>
  <para style="q">Eh re' taqe i yiib' wach kina'ojb'al naa rutoqariik rooq i kik'achariik.</para>
  <para style="q">
    <verse number="28" style="v" />Re' taqe korik wach kik'ux xasuq i kik'achariik naa kojiik wii'.</para>
  <para style="q">Eh re' taqe i yiib' wach kina'ojb'al naa rojiik sahchoq kiwach.</para>
  <para style="q">
    <verse number="29" style="v" />Re' QaJaaw Dios i ruko'leej taqe i kib'anik reh i holohik chi b'anarik.</para>
  <para style="q">Eh i rusach kiwach i kib'anik reh i yiib' wach chi b'anarik.</para>
  <para style="q">
    <verse number="30" style="v" />Re' korik wach ruk'ux ma' jaruuj naa rojiik chi riij ruuk' i rub'an.</para>
  <para style="q">Re' i yiib' wach runa'ojb'al, xama' naa ta wo' ruwihiik chupaam i ye'aab'.</para>
  <para style="q">
    <verse number="31" style="v" />Re' korik wach ruk'ux holohik laj na'ojb'al taqe ruq'or.</para>
  <para style="q">Eh re' i yiib' wach runa'ojb'al ma' holohik ta nq'orik, naa ruyok'iik i raaq'.</para>
  <para style="q">
    <verse number="32" style="v" />Eh re' korik wach ruk'ux xa looq' inq'orik.</para>
  <para style="q">Re' i yiib' wach runa'ojb'al, xama' toob' laj q'orik taqe i nelik cho panchii'.</para>
  <chapter number="11" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' QaJaaw Dios suq ruk'ux ruuk' i manlik impajwik,</para>
  <para style="q">eh ma' imponik ta chuwach i ma' manlik ta npajwik.</para>
  <para style="q">
    <verse number="2" style="v" />Re' i niimb'isanik wachiis xa k'ixb'ilaal i ruk'am chaloq.</para>
  <para style="q">Re' taqe i ma' nimaq ta kiwach kuuk' i keh wilik i holohik laj na'ojb'al.</para>
  <para style="q">
    <verse number="3" style="v" />Re' korik wach kik'ux re' korik inki a'n ink'amwik kib'eeh.</para>
  <para style="q">Re' i ma' korik taj inki a'n re' wo' re' naa rusachwiik kiwach.</para>
  <para style="q">
    <verse number="4" style="v" />Re' b'ehomal xama' xta naa rukamaniik wii' na' chureq i ruq'ijil i q'ataj q'orik.</para>
  <para style="q">Re' i korik ra'j inko'linik chuwach re' i kimik.</para>
  <para style="q">
    <verse number="5" style="v" />Re' i korik wach ruk'ux, re' korik i rub'an ink'amwik rub'eeh.</para>
  <para style="q">Eh re' yiib' wach runa'ojb'al, re' yiib' wach i rub'an inq'eb'wik reh.</para>
  <para style="q">
    <verse number="6" style="v" />Re' i korik wach kik'ux, re' i korik naa ruko'liniik keh.</para>
  <para style="q">Re' yiib' wach kina'ojb'al, naa kikahniik pankimahk.</para>
  <para style="q">
    <verse number="7" style="v" />Eh noq inkimik i yiib' wach runa'ojb'al insahchik wach i ch'iklik naq reje wii' ruk'ux,</para>
  <para style="q">je' wo' taqe aha' wilik i rukapaaj.</para>
  <para style="q">
    <verse number="8" style="v" />Re' QaJaaw Dios i resaj panti' k'axik i korik wach ruk'ux,</para>
  <para style="q">re' chik i yiib' wach runa'ojb'al i ruyeew panti' k'axik chi jilow.</para>
  <para style="q">
    <verse number="9" style="v" />Re' yiib' wach runa'ojb'al ruuk' i chii' i rujot' taqe i ras ruchaaq.</para>
  <para style="q">Eh re' korik wach kik'ux inkiko'leej kiib', ruum wilik kina'ojb'al.</para>
  <para style="q">
    <verse number="10" style="v" />Re' korik wach kik'ux ruum i holohik inki a'n insuuqb'ik kik'ux i tinamit.</para>
  <para style="q">Eh noq kikimik i yiib' wach kina'ojb'al insuuqb'ik kikux tinamit.</para>
  <para style="q">
    <verse number="11" style="v" />Ruum i otob'il inki a'n i korik wach kik'ux, ink'ihaaxb'ik i tinamit.</para>
  <para style="q">Eh re' i yiib' wach kina'ojb'al, ruuk' i kiq'oral inkisach wach i tinamit.</para>
  <para style="q">
    <verse number="12" style="v" />Re' i ma' xta runa'ojb'al ma' holohik ta nq'orik chi riij i ras ruchaaq.</para>
  <para style="q">Re' i wilik runa'ojb'al ma' xta ruq'or chi riij i tokoom.</para>
  <para style="q">
    <verse number="13" style="v" />Re' i xa nooj chi k'utaaj, i ruk'utjaaj chu'nchel taqe i rib'iraj.</para>
  <para style="q">Eh re' korik wach ruk'ux, ma' resaj ta ruk'utjiik taqe i rib'iraj.</para>
  <para style="q">
    <verse number="14" style="v" />Wila' ma' holohik i runa'ojb'al i aj taaq'oom, ma' jaruuj neenkorjik i tinamit.</para>
  <para style="q">Re' tinamit neenkorjik wila' wilkeeb' k'ih-oq i kojol na'ojb'al.</para>
  <para style="q">
    <verse number="15" style="v" />Awach i ma' nee ta rumin riib'</para>
  <para style="q">chi rutojariik i ruk'aas i tokoom, ma' xta nee ruk'ul.</para>
  <para style="q">
    <verse number="16" style="v" />Re' ixoq holohik i runa'ojb'al inye'arik ruloq'il.</para>
  <para style="q">Re' winaq kow riib' i rureq i b'ehomal.</para>
  <para style="q">
    <verse number="17" style="v" />Awach i wilik ketelinik wachiis ruuk', holohik i naa ruchaliik chinaah.</para>
  <para style="q">Eh awach i xa re' josq'iil i rub'an, ti' k'axik i ruk'am cho chinaah.</para>
  <para style="q">
    <verse number="18" style="v" />Re' yiib' wach runa'ojb'al ma' holohik taj i rutojb'aal naa ruk'ulum.</para>
  <para style="q">Awach i re' i korik i rub'an holohik i rutojb'aal naa ruk'ulum.</para>
  <para style="q">
    <verse number="19" style="v" />Re' rub'anariik i korik pan holohik k'acharik ink'amwik.</para>
  <para style="q">Re' rub'anariik i yiib' wach na'ojb'al pankimik ink'amwik.</para>
  <para style="q">
    <verse number="20" style="v" />Re' QaJaaw Dios ma' imponik ta panaq'wach taqe i ma' holohik taj wilik cho pan kánima.</para>
  <para style="q">Eh awach taqe i re' korik inki a'n ra'j imponik chuwach re'.</para>
  <para style="q">
    <verse number="21" style="v" />Re' i yiib' wach runa'ojb'al, ma' naa ta rik'iik chi riij i tojb'al ru mahk.</para>
  <para style="q">Re' taqe korik wach kik'ux naakiko'leem kiib' chi kiih chi kimaam.</para>
  <para style="q">
    <verse number="22" style="v" />Re' ixoq q'e' holohik, eh ma' xta k'isinoq runa'ojb'al,</para>
  <para style="q">xa je' rukab' i kotkot laj ch'ihch' oro inokik chi ju' i ahq.</para>
  <para style="q">
    <verse number="23" style="v" />Eh re' i korik wach kik'ux xa re' i holohik inkikapaaj rub'aan.</para>
  <para style="q">Eh re' inki a'n i yiib' wach kina'ojb'al, xajosq'iil i ruk'am chaloq.</para>
  <para style="q">
    <verse number="24" style="v" />Awach inkisiij chib'ih reh i kas kichaaq' k'ih chik i jilow inkik'ul.</para>
  <para style="q">Awach taqe i q'e' pixp xa kikahnik wo' chi neb'aa' taqe.</para>
  <para style="q">
    <verse number="25" style="v" />Awach i xa atoob', holohik naa rojiik wii'.</para>
  <para style="q">Awach insihinik, naa wo' ruk'ulum jilow.</para>
  <para style="q">
    <verse number="26" style="v" />Re' tinamit ma' holohik ta kiq'orik chi riij, awach i xa rumol i koq i wach i rutrigo.</para>
  <para style="q">Eh holohik kiq'orik chi riij awach i ruk'ayej i wach i rutrigo.</para>
  <para style="q">
    <verse number="27" style="v" />Awach i re' i holohik i rub'an, suq rilariik imb'aan.</para>
  <para style="q">Awach i re' i ma' holohik taj i rub'an, ma' holohik ta naa rojiik kuxoq wii'.</para>
  <para style="q">
    <verse number="28" style="v" />Awach i chinaah i rub'ehomal i ruch'ikaa' ruk'ux, xa je' inq'ehb'ik chiq xaq chee'.</para>
  <para style="q">Eh re' taqe korik wach kik'ux, xa eliik taqe je' rax wach xaq chee'.</para>
  <para style="q">
    <verse number="29" style="v" />Awach i ruq'eb' i rupaat, ma' xta chik naa ruwihiik reh.</para>
  <para style="q">Re' i ma' nimanik taj, naa rukahniik chi rumoso i wilik runa'ojb'al.</para>
  <para style="q">
    <verse number="30" style="v" />Re' i rub'an i korik wach ruk'ux, je' rukab' i chee' inye'wik k'acharik.</para>
  <para style="q">Eh awach i rusik' chaloq i ras ruchaaq', wilik runa'ojb'al.</para>
  <para style="q">
    <verse number="31" style="v" />Wila' nik'ik chi ti' k'axik ayu' wach ak'al i korik wach ruk'ux,</para>
  <para style="q">ra'j naa chik re' i yiib' wach runa'ojb'al, ma' neenye'arik chutojariik i ru mahk.</para>
  <chapter number="12" style="c" />
  <para style="q">
    <verse number="1" style="v" />Awach i ruk'am naah rutijiik imb'aan imponik chuwach i holohik laj na'ojb'al.</para>
  <para style="q">Awach i rixowaaj i ruq'ilariik imb'aan, ma' xta runa'ojb'al.</para>
  <para style="q">
    <verse number="2" style="v" />Re' i holohik runa'ojb'al i ruk'ul i rotob'il i QaJaaw Dios.</para>
  <para style="q">Eh re' ma' holohik ta imb'anik i ruyeew chutojariik i ru mahk.</para>
  <para style="q">
    <verse number="3" style="v" />Ma' awach taj i nee rureq rukowiil ruk'ux ruuk' i yiib' wach na'ojb'al.</para>
  <para style="q">Eh re' i korik wach kik'ux ma' xta naa ruyojiik wii' kik'ux.</para>
  <para style="q">
    <verse number="4" style="v" />Re' i ehk'eenb'ees holohik i runa'ojb'al, jinaj corona chi reh i rub'ahiil.</para>
  <para style="q">Eh re' i ehk'eenb'ees yiib' wach i runa'ojb'al irik'saj chi ti' i rub'ahiil.</para>
  <para style="q">
    <verse number="5" style="v" />Re' taqe i korik wach kik'ux xa re' i holohik inkikapaaj.</para>
  <para style="q">Re' taqe i yiib' wach kina'ojb'al, xa re' i yiib' wach inkikapaaj.</para>
  <para style="q">
    <verse number="6" style="v" />Re' i kiq'oral i yiib' wach kina'ojb'al kaansanik i ruk'am chaloq.</para>
  <para style="q">Eh re' kiq'oral i korik wach kik'ux ko'lemb'al iib' i ruk'am chaloq.</para>
  <para style="q">
    <verse number="7" style="v" />Re' QaJaaw Dios naa rusachwiik kiwach i yiib' wach i kina'ojb'al.</para>
  <para style="q">Eh re' aawach keh pankipaat, i korik wach kik'ux ma' xta naa rub'aniik keh.</para>
  <para style="q">
    <verse number="8" style="v" />Re' winaq inye'arik runimaal wach wila' holohik runa'ojb'al.</para>
  <para style="q">Eh re' taqe i yiib' wach wilik cho paránima ma' ajwaal ta wach.</para>
  <para style="q">
    <verse number="9" style="v" />Ma' xta reet chi xa k'isiin wach jino'q,</para>
  <para style="q">eh wilik i neen ye'wik ruwa' ruhaa',</para>
  <para style="q">chuwach chi nee runimb'isaj riib' jino'q,</para>
  <para style="q">eh ma' awach ta neen ye'wik ruwa' ruhaa'.</para>
  <para style="q">
    <verse number="10" style="v" />Re' korik wach ruk'ux i ruyeew ruwa' ruhaa' taqe ruchikoop.</para>
  <para style="q">Eh re' yiib' wach runa'ojb'al xa re' i josq'iil wilik cho paránima.</para>
  <para style="q">
    <verse number="11" style="v" />Awach i rukamaneej wach i ruye'aab' i rub'an ruwa' ruhaa'.</para>
  <para style="q">Re' i ma' xta runa'ojb'al xa re' i ma' xta ruk'am chaloq i rukapaaj.</para>
  <para style="q">
    <verse number="12" style="v" />Re' yiib' wach kina'ojb'al re' inkik'ax wach rub'aan ink'amwik keh panti' k'axik.</para>
  <para style="q">Eh re' korik wach kik'ux inwachinik inki a'n</para>
  <para style="q">
    <verse number="13" style="v" />Re' i yiib' wach runa'ojb'al xaruyeew riib' pan k'axik ruum i chukuj q'orik i rub'an.</para>
  <para style="q">Eh re' korik wach ruk'ux i nelik korik ruuk' taqe rub'an.</para>
  <para style="q">
    <verse number="14" style="v" />Re' ju'jun naa rub'anam rusuqkiil i ruk'am chaloq taqe i ruq'or.</para>
  <para style="q">Eh naa ruk'ulum i rutojb'aal chi riij taqe i rub'an.</para>
  <para style="q">
    <verse number="15" style="v" />Re' ma' nimanik taj i rukapaaj chi re' i rub'an ma' xta reet.</para>
  <para style="q">Eh re' wilik runa'ojb'al i ruk'am naah i ruk'uhb'aljiik imb'aan.</para>
  <para style="q">
    <verse number="16" style="v" />Re' i ma' nimanik taj ruk'uhtaaj i rujosq'iil.</para>
  <para style="q">Re' wilik runa'ojb'al, inik'ik paruk'ux i ma' holohik taj imb'aan reh.</para>
  <para style="q">
    <verse number="17" style="v" />Awach i korik inq'orik re' wo' nee ruq'or i rilow.</para>
  <para style="q">Eh re' i ma' korik ta nq'orik xa rutz'aq wach i ruq'or.</para>
  <para style="q">
    <verse number="18" style="v" />Wilik taqe i q'e' ti' kiq'ojwik ruuk' i kiq'oral.</para>
  <para style="q">Eh re' i wilik kina'ojb'al ruuk' i kiq'oral, inkiq'omaaj i ti' re' re'.</para>
  <para style="q">
    <verse number="19" style="v" />Awach inq'orik reh i korik, naa ruwihiik ruk'achariik chi juneliik.</para>
  <para style="q">Eh re' inchukwik q'orik xama' najt ta naa ruk'achariik.</para>
  <para style="q">
    <verse number="20" style="v" />Re' yiib' wach kina'ojb'al xa re' i jot'ooj inkiyejaa' wach.</para>
  <para style="q">Eh re' taqe i re' i holohik inkiyejaa' wach rub'aan, suq kiil k'uxliis ruk'am chaloq.</para>
  <para style="q">
    <verse number="21" style="v" />Re' korik wach ruk'ux ma' xta jino'q i ti' k'axik naa ruk'ulum.</para>
  <para style="q">Eh re' yiib' wach runa'ojb'al, ma' k'isa ti' k'axik naa ruchaliik chinaah.</para>
  <para style="q">
    <verse number="22" style="v" />Re' QaJaaw Dios, ma' raaj ta kiwach i chukul q'orik.</para>
  <para style="q">Eh re' taqe i re' i korik inki a'n ra'j xti q'e' imponik chuwach re'.</para>
  <para style="q">
    <verse number="23" style="v" />Re' i wilik runa'ojb'al ma' resaj ta ruk'utjiik taqe reht'al.</para>
  <para style="q">Eh re' taqe i ma' kinimanik taj inkesaj ruk'utjiik i kiyiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="24" style="v" />Re' i ruyeew ruk'ux chi kamanik neenkojarik chi ilil kamanik.</para>
  <para style="q">Eh re' i ma' raaj ta kamanik kow naa rutaq'ab'jiik.</para>
  <para style="q">
    <verse number="25" style="v" />Re' ti' k'axik inchalik inye'wik ruti'kiil ruk'ux i winaq.</para>
  <para style="q">Eh re' holohik laj q'orik inye'wik rusuqkiil ruk'ux.</para>
  <para style="q">
    <verse number="26" style="v" />Re' korik wach ruk'ux, pan holohik b'eeh i ruk'am i ras ruchaaq'.</para>
  <para style="q">Eh re' i yiib' wach kina'ojb'al, chupaam i ma'</para>
  <para style="q">holohik ta laj b'eeh inkik'am i kas kichaaq'.</para>
  <para style="q">
    <verse number="27" style="v" />Re' i puhb'an chikop i ruk'ay xama' xta wo' chikop rujoxej.</para>
  <para style="q">Eh re' i ma' ruk'ay taj, i rub'an reh i chikop, eh i rub'an rusuqkiil.</para>
  <para style="q">
    <verse number="28" style="v" />Re' rub'anariik i holohik pan holohik laj k'acharik ink'amwik.</para>
  <para style="q">Eh re' rub'anariik i yiib' wach pankimik ink'amwik.</para>
  <chapter number="13" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' ak'uunb'ees wilik runa'ojb'al, i runimaj i ruk'uhb'aal i rajaaw.</para>
  <para style="q">Eh re' ma' nib'irinik taj, ma' runimaj taj i ruq'ilariik imb'aan.</para>
  <para style="q">
    <verse number="2" style="v" />Re' ju'jun naa rub'anam rusuqkiil i ruk'am chaloq taqe i ruq'or.</para>
  <para style="q">Re' taqe aj ixowaal xa re' i ti' k'axik inki a'n reh i kas kichaaq'.</para>
  <para style="q">
    <verse number="3" style="v" />Awach i xa rupaj i q'orik i rub'an, re' wo' reh i ruk'ax riib'.</para>
  <para style="q">Awach i xanwolwotik chi q'orik, xa re' wo' reh i rujot' riib'.</para>
  <para style="q">
    <verse number="4" style="v" />Awach i ma' nkamanik taj, ma' rureq ta tz'aaq i ajwaal wach chi reh.</para>
  <para style="q">Awach inkamanik, i nelik korik.</para>
  <para style="q">
    <verse number="5" style="v" />Re' korik wach ruk'ux, ma' imponik ta chuwach i chukuj q'orik.</para>
  <para style="q">Eh re' yiib' wach runa'ojb'al xa k'ixb'ilaal imb'anik.</para>
  <para style="q">
    <verse number="6" style="v" />Re' i ma' xta ru mahk re' korik i rub'an inko'linik reh.</para>
  <para style="q">Eh re' aj mahk, re' i yiib' wach i rub'an naa rusachwiik wach.</para>
  <para style="q">
    <verse number="7" style="v" />Wilik taqe i b'ehoom inki a'n kiib', eh xama' xta wo' wilik keh.</para>
  <para style="q">Eh wilik i neb'aa' inki a'n kiib', re' re' wilik kib'ehomal.</para>
  <para style="q">
    <verse number="8" style="v" />Re' b'ehoom panyohb'aal wilik, eh re' wo' rutumiin neeneesanik reh pankimik.</para>
  <para style="q">Re' neb'aa' xama' nee ta wo' inq'orarik rukanteesjiik.</para>
  <para style="q">
    <verse number="9" style="v" />Re' korik wach kik'ux xan saqumanik chik inki a'n</para>
  <para style="q">Eh re' i yiib' wach kina'ojb'al, xa chuhpik chik reh i kisaqumaal.</para>
  <para style="q">
    <verse number="10" style="v" />Re' niimb'isanik wachiis, peleto i ruk'am chaloq.</para>
  <para style="q">Re' taqe i xama' nimaq ta kiwach wilik kina'ojb'al.</para>
  <para style="q">
    <verse number="11" style="v" />Re' b'ehomal inkan ruuk' i leq', insahchik wach.</para>
  <para style="q">Awach i rumol wach rub'ehomal chiq'uun, ruuk' rukamaj, naa rutiqiik naah reh.</para>
  <para style="q">
    <verse number="12" style="v" />Eh noq ma' nelik ta wach inqakapaaj, i rutiib'isaj qak'ux.</para>
  <para style="q">Eh noq i nelik wach inqakapaaj, qohkahnik chi je' rukab' i chee' inye'wik k'acharik.</para>
  <para style="q">
    <verse number="13" style="v" />Awach i ma' runimaj taj i ruq'or i k'uhb'aal, naa ruye'ariik panti' k'axik.</para>
  <para style="q">Eh awach i runimaj i ruq'or i k'uhb'aal, naa ruye'ariik jilow reh.</para>
  <para style="q">
    <verse number="14" style="v" />Re' tijinik i rub'an i wilik runa'ojb'al, k'acharik i ruk'am chaloq,</para>
  <para style="q">eh ineesanik pankimik.</para>
  <para style="q">
    <verse number="15" style="v" />Re' holohik laj na'ojb'al, k'axaj iib' i ruk'am chaloq.</para>
  <para style="q">Re' taqe i aj ixowaal naa rusahchiik kiwach.</para>
  <para style="q">
    <verse number="16" style="v" />Awach i wilik runa'ojb'al, re' i holohik laj na'ojb'al i rub'an.</para>
  <para style="q">Re' i ma' nimanik taj i resaj ruk'utjiik i ruyiib' wach na'ojb'al i rub'an.</para>
  <para style="q">
    <verse number="17" style="v" />Re' aj taqareel yiib' wach i runa'ojb'al, ti' k'axik i ruk'am chaloq.</para>
  <para style="q">Eh re' i taqareel korik wach ruk'ux, i rujoot'isaj wach i k'axkiil.</para>
  <para style="q">
    <verse number="18" style="v" />Awach i ma' runimaj taj i ruk'uhb'aljiik, neb'a'il, k'ixb'ilaal i naa ruchaliik chinaah.</para>
  <para style="q">Eh awach i runimaj i ruq'ilariik, naa ruye'ariik runimaal wach chi manlik.</para>
  <para style="q">
    <verse number="19" style="v" />Noq inooj eloq wach inkapeb'jik, rusuqkiil k'uxliis i ruyeew.</para>
  <para style="q">Re' taqe i ma' kinimanik taj, ma' nkikanaa' taj i yiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="20" style="v" />Awach i xutahqeej taqe i holohik kina'ojb'al, naa ruwihiik runa'ojb'al.</para>
  <para style="q">Eh awach xutahqeej taqe i ma' kinimanik taj, naa ruq'eb'em riib'.</para>
  <para style="q">
    <verse number="21" style="v" />Re' taqe aj mahk ti' k'axik i naa ruchaliik chikinaah.</para>
  <para style="q">Eh re' taqe korik wach kik'ux, naakik'ulum jilow i holohik inki a'n</para>
  <para style="q">
    <verse number="22" style="v" />Re' holohik runa'ojb'al i rukanaa' kikooch taqe i riih rumaam.</para>
  <para style="q">Eh re' rub'ehomal rumolom wach i aj mahk, naa rukahniik chi reh i korik wach ruk'ux.</para>
  <para style="q">
    <verse number="23" style="v" />Re' kiye'aab' inkikamaneej wach i neb'aa', i ruyeew i wi'k ha' chi manlik.</para>
  <para style="q">Xa re' la', ma' k'isiin inq'ehb'ik noq ma' imb'aan taj i rub'ehel.</para>
  <para style="q">
    <verse number="24" style="v" />Awach i ma' rutijej ta taqe i rak'uun rixq'uun, ma' ruk'ax ta taqe.</para>
  <para style="q">Eh awach i rutijej taqe i rak'uun rixq'uun, i ruk'ax taqe.</para>
  <para style="q">
    <verse number="25" style="v" />Re' korik wach ruk'ux i manlojik i ruwa' ruhaa'.</para>
  <para style="q">Eh re' yiib' wach runa'ojb'al ma' manlojik taj i ruwa' ruhaa'.</para>
  <chapter number="14" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' ixoq wilik runa'ojb'al i ruyejaa' taqe paam i rupaat.</para>
  <para style="q">Eh re' ixoq ma' nimanik taj, i rusach wach i chib'ih reh parupaat.</para>
  <para style="q">
    <verse number="2" style="v" />Re' holohik runa'ojb'al, i ruyohleej i QaJaaw Dios.</para>
  <para style="q">Re' i yiib' wach runa'ojb'al i rixowaaj wach i QaJaaw Dios.</para>
  <para style="q">
    <verse number="3" style="v" />Re' ma' nimanik taj q'e' i runimb'isaj riib' ruuk' i ruq'oral.</para>
  <para style="q">Eh re' taqe wilik kina'ojb'al, re' i kiq'oral inko'linik keh.</para>
  <para style="q">
    <verse number="4" style="v" />Noq ma' kikamanik taj i b'ooyax, ma' xtaj i trigo i molarik.</para>
  <para style="q">Eh noq kikamanik i b'ooyax, wilik i trigo i molarik.</para>
  <para style="q">
    <verse number="5" style="v" />Awach i korik inq'orik, re' i xrilow, nee ruq'or.</para>
  <para style="q">Eh re' ma' korik ta nq'orik xa rutz'aq wach taqe ruq'or.</para>
  <para style="q">
    <verse number="6" style="v" />Re' i runimb'isaj riib' noq i rusik' runa'ojb'al, xama' xureq ta wo' hoq.</para>
  <para style="q">Eh re' i wilik runa'ojb'al ma' k'axik taj noq i rureq chi riij.</para>
  <para style="q">
    <verse number="7" style="v" />Chawesaj awiib' ruuk' i ma' nimanik taj,</para>
  <para style="q">ruum re' reh xama' nee ta wo' i rukoj ana'ojb'al ruuk' i ruq'oral.</para>
  <para style="q">
    <verse number="8" style="v" />Re' wilik runa'ojb'al, re' re' ink'uhtanik reh nik' wach i ruk'achariik.</para>
  <para style="q">Eh re' ma' nimanik taj xa rujot' riib' ruuk' i ruyiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="9" style="v" />Re' taqe i ma' kinimanik taj xama' xta nkaaj reh i mahk inki a'n</para>
  <para style="q">Eh re' taqe i korik wach kik'ux, holohik inkikapaaj rub'aan.</para>
  <para style="q">
    <verse number="10" style="v" />Re' ju'jun reht'al chib'ih jariik i ti' cho paránima,</para>
  <para style="q">eh ma' nee ta rub'an chi nee ruyeew rusuqkiil ruk'ux i tokoom.</para>
  <para style="q">
    <verse number="11" style="v" />Re' chib'ih keh i yiib' wach kina'ojb'al, naa rusahchiik wach.</para>
  <para style="q">Re' i chib'ih keh i korik wach kik'ux ma' xta naa rub'aniik reh.</para>
  <para style="q">
    <verse number="12" style="v" />Wilik i b'eeh i ruk'am i winaq pan holohik inooj noq i rilow,</para>
  <para style="q">xa re' la' pankimik ink'amarik noq inooj kuxoq.</para>
  <para style="q">
    <verse number="13" style="v" />Ruum ar, re' i se'eel insutinik chi ruti'kiil k'uxliis.</para>
  <para style="q">Eh re' rusuqkiil k'uxliis insutinik chi oq'ik.</para>
  <para style="q">
    <verse number="14" style="v" />Re' i ma' xta runa'ojb'al ch'iklik ruk'ux ruuk' taqe i yiib' wach i rub'an.</para>
  <para style="q">Eh re' i korik wach ruk'ux ruuk' i holohik i rub'an ch'iklik ruk'ux.</para>
  <para style="q">
    <verse number="15" style="v" />Re' ma' xta runa'ojb'al xa chu'nchel i runimaj inq'orarik reh.</para>
  <para style="q">Eh re' wilik runa'ojb'al, korukoj rehtaal chib'ih rub'an.</para>
  <para style="q">
    <verse number="16" style="v" />Re' wilik runa'ojb'al, inyo'jik chub'aan yiib' wach.</para>
  <para style="q">Re' i ma' xta runa'ojb'al, ma' inyo'jik taj, chub'aan i yiib' wach.</para>
  <para style="q">
    <verse number="17" style="v" />Awach i jumehq'iil inchalik ruk'aah ma' kota rukapaaj riij i rub'an.</para>
  <para style="q">Re' i ma' holohik ta runa'ojb'al ma' ajwaal ta wach.</para>
  <para style="q">
    <verse number="18" style="v" />Re' i ma' xta kina'ojb'al re' i yiib' wach na'ojb'al naa kianam.</para>
  <para style="q">Eh re' taqe i holohik kib'anik naa ruwihiik kina'ojb'al.</para>
  <para style="q">
    <verse number="19" style="v" />Re' taqe i yiib' wach kina'ojb'al naakixuk'aam</para>
  <para style="q">kiib' chikiwach i holohik kina'ojb'al.</para>
  <para style="q">Eh naa naq kaajwaam okik kuuk' i korik wach kik'ux.</para>
  <para style="q">
    <verse number="20" style="v" />Re' neb'aa' aha' naq wilik taqe i ramigo kisutinik chi ixowan wach.</para>
  <para style="q">Eh re' i b'ehoom ma' k'isiin taqe i ramigo.</para>
  <para style="q">
    <verse number="21" style="v" />Awach intohq'ik rixowaam wach i ramigo mahk i rub'an.</para>
  <para style="q">Eh atoob' reh awach inketelinik wach i neb'aa'.</para>
  <para style="q">
    <verse number="22" style="v" />Eh i re' taqe i yiib' wach kib'anik inkiq'eb' i holohik b'eeh.</para>
  <para style="q">Eh re' taqe i holohik kib'anik, naa ruketeljiik kiwach, re' rukorkiil naa rub'aan kuuk'.</para>
  <para style="q">
    <verse number="23" style="v" />Chu'nchel i kamanik wilik i ruk'am chaloq.</para>
  <para style="q">Eh re' xa nwolwotik chi q'orik, xama' xta ruk'am chaloq.</para>
  <para style="q">
    <verse number="24" style="v" />Re' i wilik kina'ojb'al, jinaj corona chi keh i kina'ojb'al.</para>
  <para style="q">Eh re' i ma' kinimanik taj, jinaj corona chi keh i kiyiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="25" style="v" />Re' korik inq'orik neeruko'leej pankimik i tokoom.</para>
  <para style="q">Eh re' i ma' korik ta nq'orik nee ruyeew pankimik i tokoom.</para>
  <para style="q">
    <verse number="26" style="v" />Awach i ruyohleej i QaJaaw Dios, ch'iklik ruk'ux ruuk' i runimaniik,</para>
  <para style="q">eh ch'iklik wo' kik'ux taqe i rak'uun rixq'uun.</para>
  <para style="q">
    <verse number="27" style="v" />Re' ruyohljiik i QaJaaw Dios, k'acharik i ruk'am chaloq.</para>
  <para style="q">Re' re' imb'anik eesanik pan q'ab' ink'amwik chaloq i kimik.</para>
  <para style="q">
    <verse number="28" style="v" />Re' reey noq nim i tinamit ruchopom naah, re' i re' inye'wik runimaal wach.</para>
  <para style="q">Eh noq ma' nim taj i tinamit ruchopom naah ajaab'ees, re' i re' inyojwik ruk'ux.</para>
  <para style="q">
    <verse number="29" style="v" />Awach i wilik q'unil ruuk' i ruk'uhtaaj chi wilik runa'ojb'al.</para>
  <para style="q">Awach i ma' xta q'unil ruuk', i ruk'uhtaaj chi xa re' i ma' holohik taj wilik paránima.</para>
  <para style="q">
    <verse number="30" style="v" />Awach i xa atoob' wach ránima, suq chu'nchel i ruti'jolal.</para>
  <para style="q">Eh re' ixowaal, imponik wach b'aaq i ti' i rub'an.</para>
  <para style="q">
    <verse number="31" style="v" />Eh re' i rub'an i ti' k'axik reh i neb'aa',</para>
  <para style="q">i ruyeew ruti'kiil ruk'ux i xyej-anik reh i neb'aa'.</para>
  <para style="q">Eh re' inketelinik wach i neb'aa', i ruyeew runimaal wach i xyej-anik cho reh.</para>
  <para style="q">
    <verse number="32" style="v" />Re' i yiib' wach runa'ojb'al, re' re' i naa ruye'wiik reh pan k'axik.</para>
  <para style="q">Eh re' i korik wach ruk'ux, re' rukorkiil wach ruk'ux naa ruko'liniik reh.</para>
  <para style="q">
    <verse number="33" style="v" />Re' wilik runa'ojb'al, re' wo' holohik laj na'ojb'al wilik cho paránima.</para>
  <para style="q">Re' i ma' kinimanik taj, ma' keht'al ta wach i holohik laj na'ojb'al.</para>
  <para style="q">
    <verse number="34" style="v" />Re' i holohik chi b'anarik inye'wik runimaal wach tinamit.</para>
  <para style="q">Eh re' rub'anariik i mahk, xa k'ixb'ilaal i ruk'am cho chi reh.</para>
  <para style="q">
    <verse number="35" style="v" />Re' i aj kamanoom wilik runa'ojb'al, i rukoj riib' panotob'il ruuk' i reey.</para>
  <para style="q">Re' i aj kamanoom ma' xta runa'ojb'al, i rukoj riib' pank'aah ruuk' i reey.</para>
  <chapter number="15" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' i chaq'wik ruuk' i q'unil, i rujoot'isaj wach i k'aah.</para>
  <para style="q">Re' chaq'wik ruuk' i kowlaj q'orik, i rujosaj wach i k'aah.</para>
  <para style="q">
    <verse number="2" style="v" />Re' q'orik i nelik cho ju' kaaq' i wilik kina'ojb'al, holohik i ruk'am chaloq.</para>
  <para style="q">Eh re' i kiq'oral i ma' kinimanik taj, yiib' wach i ruk'am chaloq.</para>
  <para style="q">
    <verse number="3" style="v" />Re' QaJaaw Dios wilik xa aha' yuuq',</para>
  <para style="q">i rilow inki a'n i holohik kina'ojb'al, eh i yiib' wach kina'ojb'al.</para>
  <para style="q">
    <verse number="4" style="v" />Awach i holohik laj q'orik i nelik cho ju' raaq', je' rukab' i chee' inye'wik k'acharik.</para>
  <para style="q">Eh re' i re' yiib' wach q'orik i nelik cho ju' raaq' i rujot' i ránima.</para>
  <para style="q">
    <verse number="5" style="v" />Re' i ma' nimanik taj, ma' ruk'am ta naah i ruq'ilariik imb'aan ruum i rajaaw.</para>
  <para style="q">Eh re' i wilik runa'ojb'al i ruk'am naah i ruq'ilariik imb'aan.</para>
  <para style="q">
    <verse number="6" style="v" />Re' korik wach ruk'ux wilik chib'ih reh parupaat.</para>
  <para style="q">Eh re' i yiib' wach runa'ojb'al, xama' rub'an ta wo' rusuqkiil aha' wilik i rusik'.</para>
  <para style="q">
    <verse number="7" style="v" />Re' wilik kina'ojb'al, k'uhb'aal inki a'n ruuk' i kiq'oral.</para>
  <para style="q">Re' i ma' kinimanik taj, re' i yiib' wach inki a'n</para>
  <para style="q">
    <verse number="8" style="v" />Re' QaJaaw Dios ma' imponik ta chuwach i kimayiij i yiib' wach kina'ojb'al.</para>
  <para style="q">Re' taqe i kitiij i korik wach kik'ux, ra'j imponik chuwach re'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' i QaJaaw Dios ma' imponik ta chuwach inki a'n i yiib' wach kina'ojb'al.</para>
  <para style="q">Awach i re' i holohik i rub'an re' re', imponik chuwach.</para>
  <para style="q">
    <verse number="10" style="v" />Awach i rukanaa' i holohik laj b'eeh, kow ink'uhb'aljik.</para>
  <para style="q">Eh awach i xrixowaaj i ruk'uhb'aljiik imb'aan, naa rukimiik.</para>
  <para style="q">
    <verse number="11" style="v" />Wila' reht'al i QaJaaw Dios nik' wach i kimik, je' wo' hoq aha' kiooj kamnaq.</para>
  <para style="q">Ra'j naa chik ma' reht'al re' chib'ih i wilik cho paránima i winaq.</para>
  <para style="q">
    <verse number="12" style="v" />Re' ma' nimanik taj, i rixowaaj wach inq'ilwik reh,</para>
  <para style="q">ma' raaj ta ruch'ihleem taqe i holohik kina'ojb'al.</para>
  <para style="q">
    <verse number="13" style="v" />Awach i suq i ránima se'eel wach.</para>
  <para style="q">Awach i ti' i ránima intz'irik wach.</para>
  <para style="q">
    <verse number="14" style="v" />Re' wilik runa'ojb'al, re' holohik laj na'ojb'al i rusik'.</para>
  <para style="q">Eh re' taqe i ma' kinimanik taj xa re' yiib' wach na'ojb'al inki a'n</para>
  <para style="q">
    <verse number="15" style="v" />Awach i xa eliik ti' ruk'ux, xa chu'nchel i q'iij ma' holohik ta chi reh.</para>
  <para style="q">Awach i suq ruk'ux, xa eliik ninq'iij chi reh.</para>
  <para style="q">
    <verse number="16" style="v" />Ma' xta reet chi ma' xta neen wihik reh jino'q,</para>
  <para style="q">xa re' la', mi ruyohleej i Dios,</para>
  <para style="q">chuwach chi neen wihik rub'ehomal jino'q, eh xa eliik-oq ti' i ruk'ux.</para>
  <para style="q">
    <verse number="17" style="v" />Ma' xta q'orik reh atoob' ta xa i chaaj i neen</para>
  <para style="q">k'uxarik, xa re' la', mi wilik i k'axaj iib'.</para>
  <para style="q">Eh xama' xta rutiq chi q'ina' laj</para>
  <para style="q">tiwik wakax i neen k'uxarik, wila' wilik peleto.</para>
  <para style="q">
    <verse number="18" style="v" />Awach i xiik' naah josq'iil, xa re' i tikij peleto iraaj.</para>
  <para style="q">Eh awach i wilik q'unil ruuk' i rujoot'isaj wach i peleto.</para>
  <para style="q">
    <verse number="19" style="v" />Re' i sikiil laj winaq, je' naa pan k'iix ik'ik i rub'an paruk'achariik.</para>
  <para style="q">Eh re' korik wach ruk'ux xasuq ik'ik i rub'an paruk'achariik, ma' xta nq'ilwik reh.</para>
  <para style="q">
    <verse number="20" style="v" />Re' ak'uunb'ees wilik runa'ojb'al, i ruyeew rusuqkiil ruk'ux i rutuut rajaaw.</para>
  <para style="q">Eh re' ak'uunb'ees ma' xta runa'ojb'al i rixowaaj wach i rutuut rajaaw.</para>
  <para style="q">
    <verse number="21" style="v" />Re' i ma' xta runa'ojb'al, xasuq chik ruk'ux chub'aan i ruyiib' wach na'ojb'al.</para>
  <para style="q">Eh re' i wilik runa'ojb'al, i ruyejaa' i ruk'achariik chi rib'il riib'.</para>
  <para style="q">
    <verse number="22" style="v" />Awach i ma' rupahqaaj ta runa'ojb'al ma' i nelik ta korik taqe i rub'an.</para>
  <para style="q">Eh wila' raaj chi naa reliik korik, koruman chi naa rukojariik runa'ojb'al.</para>
  <para style="q">
    <verse number="23" style="v" />Ma' k'isiin ta loq'il noq inqak'ul inqapahqaaj.</para>
  <para style="q">Eh xti q'e' wo' chik looq' noq inqak'ul, noq xa nqaaj chik wach</para>
  <para style="q">
    <verse number="24" style="v" />Re' i wilik runa'ojb'al, je' naa taxaaj ojik i rub'an paruk'achariik,</para>
  <para style="q">reh chi neeruko'leej riib' chuwach i kimik.</para>
  <para style="q">
    <verse number="25" style="v" />Re' QaJaaw Dios i rusach wach i chib'ih reh i nim wach i rub'an riib'.</para>
  <para style="q">Eh i rucha'jeej i chib'ih reh ixoq kamnaq rub'ahiil.</para>
  <para style="q">
    <verse number="26" style="v" />Re' QaJaaw Dios ma' imponik ta chuwach inkiyejaa' wach i yiib' wach kina'ojb'al.</para>
  <para style="q">Re' inkiq'or taqe i saq wach kánima ra'j imponik chuwach re'.</para>
  <para style="q">
    <verse number="27" style="v" />Awach i ruk'ax wach i b'ehomal, naa rusahchiik wach i chib'ih reh.</para>
  <para style="q">Eh awach i ma' ruk'ax ta wach ileq', ma' xta naa ruk'ulum.</para>
  <para style="q">
    <verse number="28" style="v" />Re' korik wach ruk'ux, korukapaaj riij i chaq'wik i rub'an.</para>
  <para style="q">Eh re' i yiib' wach runa'ojb'al, xama' toob' laj q'orik i resaj reje panchii'.</para>
  <para style="q">
    <verse number="29" style="v" />Re' QaJaaw Dios najt wilik kuuk' taqe i yiib' wach kina'ojb'al.</para>
  <para style="q">Re' taqe i korik wach kik'ux, iniib'irjik i kitiij.</para>
  <para style="q">
    <verse number="30" style="v" />Eh noq holohik qatz'ehtjiik imb'aan i ruyeew rusuqkiil qak'ux.</para>
  <para style="q">Eh noq holohik kiq'orik chiqiij i ruyeew rukowiil qak'ux.</para>
  <para style="q">
    <verse number="31" style="v" />Awach i runimaj i ruq'ilariik imb'aan, naa ruye'ariik ruk'achariik.</para>
  <para style="q">Eh naa rokiik chi kixilak taqe i wilik kina'ojb'al.</para>
  <para style="q">
    <verse number="32" style="v" />Awach i ma' imponik ta panaq'wach i ruq'ilariik imb'aan, ma' ruk'ax ta riib'.</para>
  <para style="q">Awach i runimaj i ruq'ilariik imb'aan, holohik i runa'ojb'al.</para>
  <para style="q">
    <verse number="33" style="v" />Re' i ruyohljiik i Dios ink'uhtanik i holohik laj na'ojb'al.</para>
  <para style="q">Awach iraaj chi naa ruye'ariik runimaal wach, peet naa ruloch'om riib'.</para>
  <chapter number="16" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' winaq wilik taqe i ruyejaa' cho wach rub'aan paránima.</para>
  <para style="q">Xa re' la', re' QaJaaw Dios q'oreel chinaah mi neenooj eloq wach oon ma' nee taj.</para>
  <para style="q">
    <verse number="2" style="v" />Re' winaq xa chu'nchel ma' xta reet i rub'an noq i rukapaaj, xa re' la'</para>
  <para style="q">re' QaJaaw ineht'alinik reh chib'ih i rukapaaj cho paránima.</para>
  <para style="q">
    <verse number="3" style="v" />Cha woqxa'neej pan q'ab' i QaJaaw Dios chu'nchel i naa a'nam.</para>
  <para style="q">Chi je' re', neenooj eloq wach taqe inayejaa' wach.</para>
  <para style="q">
    <verse number="4" style="v" />Re' QaJaaw Dios wilik iraaj chi riij noq xuyejaa' chu'nchel i xa chib'ih jariik.</para>
  <para style="q">Eh re' yiib' wach runa'ojb'al, rumolom naa re' wo' reh i ruq'ijil i ti' k'axik.</para>
  <para style="q">
    <verse number="5" style="v" />Re' QaJaaw Dios ma' imponik ta chuwach taqe i nimaq kiwach inki a'n kiib'.</para>
  <para style="q">Xa nik' ma' ruyeew taqe panti' k'axik.</para>
  <para style="q">
    <verse number="6" style="v" />Xa ruuk' i ketelinik wachiis, xa ruum i korik naa rukuyariik i mahk.</para>
  <para style="q">Eh xa ruum i ruyohljiik i Dios i resaj riib' i ju'jun chuwach i yiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="7" style="v" />Noq holohik i kina'ojb'al i winaq, imponik chuwach i QaJaaw Dios.</para>
  <para style="q">Eh ruum i re' i ruk'am taqe ruuk' panotob'il i nixowanik wach i reh.</para>
  <para style="q">
    <verse number="8" style="v" />Ma' xta reet chi xa k'isiin i chib'ih aweh, xa re' la' wi parub'ehel xareq.</para>
  <para style="q">Xa ma' xta neerutiq chi k'ih i chib'ih aweh, wila' ma' parub'ehel xareq.</para>
  <para style="q">
    <verse number="9" style="v" />Re' winaq i ruyejaa' wach chib'ih taqe naa rub'anam, xa re' la',</para>
  <para style="q">koruman chi re' Dios naa ruk'amwiik rub'eeh.</para>
  <para style="q">
    <verse number="10" style="v" />Re' reey parub'ihnaal Dios inq'orik,</para>
  <para style="q">ruum i re' ma' awach taj i nee ruyeew chutojariik i ru mahk wila' ma' chih wo' ru mahk.</para>
  <para style="q">
    <verse number="11" style="v" />Re' i pajooj manlik imb'aan ruuk' taqe i tokoom chik pajb'al imponik chuwach i Dios,</para>
  <para style="q">ruum re' wo' reh xkananik taqe pajb'al.</para>
  <para style="q">
    <verse number="12" style="v" />Re' taqe reey ma' nkaaj taj chi neenb'aan i yiib' wach na'ojb'al,</para>
  <para style="q">ruum noq wilkeeb' pan kiye'aab' ma' ye'ooj ta q'ab'</para>
  <para style="q">keh chi naa rub'aan i yiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="13" style="v" />Re' taqe reey inkik'ax,</para>
  <para style="q">eh suq rilariik inki a'n awach i korik kiq'orik, eh rub'ehel inkiq'or.</para>
  <para style="q">
    <verse number="14" style="v" />Re' rujosq'iil i reey kimik i ruk'am chaloq.</para>
  <para style="q">Eh re' wilik runa'ojb'al i rujoot'isaj wach i rujosq'iil i reey.</para>
  <para style="q">
    <verse number="15" style="v" />Noq suq ruk'ux i reey k'acharik i ruk'am chaloq.</para>
  <para style="q">Eh re' i holohik i rub'an, je' naa rukab'</para>
  <para style="q">i suutz' ink'amwik cho reh i jab'.</para>
  <para style="q">
    <verse number="16" style="v" />Q'e' chihooj chi neen wihik runa'ojb'al jino'q,</para>
  <para style="q">ma' xata je' k'ihaal tz'aaq i manlik oro.</para>
  <para style="q">Eh re' i holohik chi naab'jik ma' xata je' k'ihaal tz'aaq i plata.</para>
  <para style="q">
    <verse number="17" style="v" />Re' taqe i korik wach kik'ux inkikanaa' rub'aan i yiib' wach na'ojb'al.</para>
  <para style="q">Eh wila' inkik'raaj kiib' ruuk' i kina'ojb'al, k'ahchi' kicha'jeem kiib'.</para>
  <para style="q">
    <verse number="18" style="v" />Awach i q'e' i runimb'isaj riib' ma' jaruuj naa reliik korik ruuk' i rub'an,</para>
  <para style="q">ruum chi xa re' i kaqwachiil wilik paránima naa ruq'eb'em riib'.</para>
  <para style="q">
    <verse number="19" style="v" />Re' q'e' chihooj chi nee ruk'isiimb'isaj riib' jino'q kuuk' taqe i neb'aa',</para>
  <para style="q">chuwach chi neen b'ehomrik chi kixilak i nimaq kiwach.</para>
  <para style="q">
    <verse number="20" style="v" />Awach i runimaj i ruq'oral i QaJaaw Dios holohik naa rojiik wii'.</para>
  <para style="q">Atoob' reh awach i ruyeew ruk'ux ruuk' i QaJaaw.</para>
  <para style="q">
    <verse number="21" style="v" />Awach i rukapaaj riij i rub'an, wilik runa'ojb'al inq'orarik reh.</para>
  <para style="q">Eh re' taqe chaq'laam laj q'orik, inkojwik na'ojb'al.</para>
  <para style="q">
    <verse number="22" style="v" />Re' holohik laj na'ojb'al, holohik laj k'acharik ruk'am chaloq.</para>
  <para style="q">Re' i kitijiik i ma' kinimanik taj, xama' xta ruk'am chaloq.</para>
  <para style="q">
    <verse number="23" style="v" />Awach i wilik runa'ojb'al chukapeb'jiik chib'ih i rub'an, re' re' inchol q'orik.</para>
  <para style="q">Eh re' taqe i ruq'oral inkojwik na'ojb'al.</para>
  <para style="q">
    <verse number="24" style="v" />Awach i xasuq inq'orik, re' i ruq'oral xa je' chik ki'iil riis kaab',</para>
  <para style="q">eh i rujoot'isaj wach i ánima, i ruyeew ruman rukowiil i k'uxliis.</para>
  <para style="q">
    <verse number="25" style="v" />Wilik i b'eeh xa pan holohik chik ink'amwik noq ink'utinik,</para>
  <para style="q">xanaah re', noq inooj kuxoq pankimik ink'amwik.</para>
  <para style="q">
    <verse number="26" style="v" />Re' kamanoom, re' i runuhmiik iminwik reh pankamanik, eh</para>
  <para style="q">ruum i re' inkamanik.</para>
  <para style="q">
    <verse number="27" style="v" />Re' i yiib' wach runa'ojb'al xa re' i yiib' wach i ruyejaa' wach rub'anariik.</para>
  <para style="q">Eh re' i ruq'oral i nelik reje panchii', xa je' chik rukab' i xaq q'aaq'.</para>
  <para style="q">
    <verse number="28" style="v" />Re' i yiib' wach runa'ojb'al xa re' i tikij peleto iraaj.</para>
  <para style="q">Re' i tz'aqal wach k'utaaj i rukoj pank'aah taqe i kamigo naq kiib'.</para>
  <para style="q">
    <verse number="29" style="v" />Re' i yiib' wach runa'ojb'al xa rujot' taqe i ramigo,</para>
  <para style="q">eh i ruk'am taqe chupaam i ma' holohik ta laj b'eeh.</para>
  <para style="q">
    <verse number="30" style="v" />Eh xa rumutz'muteej chik inaq'wach chukapeb'jiik riij i yiib' wach na'ojb'al.</para>
  <para style="q">Eh xa rutiiw chik i xaq chii' noq rub'anam chik i yiib' wach re' re'.</para>
  <para style="q">
    <verse number="31" style="v" />Noq insaaqb'ik i rismaal naah jino'q, je' naa jinaj corona q'e' looq' chi reh.</para>
  <para style="q">Eh re' i re' ink'uhtanik reh chi holohik i runa'ojb'al.</para>
  <para style="q">
    <verse number="32" style="v" />Q'e' chihooj chi wilik q'unil ruuk' jino'q, chuwach chi xakow neerub'an riib'.</para>
  <para style="q">Eh xiik' naah chihojal chi nee ruloch' riib' jino'q</para>
  <para style="q">chuwach chi nee rutoq'aa' q'uchuuj tinamit.</para>
  <para style="q">
    <verse number="33" style="v" />Re' winaq i rusik' chi riij nik' wach noq naa rureqem rutumiin,</para>
  <para style="q">xa re' la', re' i QaJaaw Dios q'oreel chinaah.</para>
  <chapter number="17" style="c" />
  <para style="q">
    <verse number="1" style="v" />Ma' xta q'orik reh atoob' ta xa chiqwi'k i neen k'uxarik, xa re' la', mi suq i k'acharik.</para>
  <para style="q">Xa ma' xta neerutiq chi nujinaq i suq atoob' pampaat wila' xa re' peleto imb'aan.</para>
  <para style="q">
    <verse number="2" style="v" />Re' i móso wilik runa'ojb'al, i ruq'at wach i rak'uun i rupatroon.</para>
  <para style="q">Eh inehtrik i kooch, je' rukab' inye'arik keh ak'uunb'ees kinimanik.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i oro re' i plata ruuk' q'aaq' inehteesjik i ruch'uwa'iil wach.</para>
  <para style="q">Eh re' taqe i wilik cho pan ánima, re' i QaJaaw Dios ineesanik i ruch'uwa'iil wach.</para>
  <para style="q">
    <verse number="4" style="v" />Re' i yiib' wach runa'ojb'al, re' i aj chukul q'orik,</para>
  <para style="q">q'e' imponik chikiwach taqe i yiib' wach q'orik imb'aan.</para>
  <para style="q">
    <verse number="5" style="v" />Awach ixkaqse'lanik reh i neb'aa', re' ixtz'uhkrisanik reh i rukaqse'laaj.</para>
  <para style="q">Eh awach insuuqb'ik ruk'ux chi riij i ti' i ruk'ul i neb'aa',</para>
  <para style="q">naa ruye'ariik chutojariik i ru mahk.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taqe i mama' winaq, je' corona chi keh i kiih kimaam.</para>
  <para style="q">Eh re' inye'wik runimaal kiwach ak'uunb'ees ixq'uunb'ees, re' taqe i kituut kajaaw.</para>
  <para style="q">
    <verse number="7" style="v" />Wila' ma' suq i rub'an reh i ma' holohik ta laj q'orik, i ma' nimanik taj,</para>
  <para style="q">ra'j naa chik re' i k'amal b'eeh suq neerub'an reh i chukuj q'orik.</para>
  <para style="q">
    <verse number="8" style="v" />Awach i ruq'uch i tumiin ruuk' i xa chib'ih jariik i rub'an,</para>
  <para style="q">i rukapaaj chi nee nelik korik ruuk' taqe i rub'an xa aha' pa' neenooj.</para>
  <para style="q">
    <verse number="9" style="v" />Awach i rukuy imb'aan reh, pansuqkiil ink'amwik.</para>
  <para style="q">Eh awach i ma' rukuy taj imb'aan reh, panixowaal ink'amwik.</para>
  <para style="q">
    <verse number="10" style="v" />Re' wilik runa'ojb'al xajuriim inq'ilarik.</para>
  <para style="q">Eh re' ma' xta runa'ojb'al ma' nee ta nimanik ruuk' jino'q siento chi tz'uhuum.</para>
  <para style="q">
    <verse number="11" style="v" />Re' ma' nimanik taj, xa re' i sik'ij peleto iraaj.</para>
  <para style="q">Xa re' la', jinaj i aj taqareel naa rutaq'ab'jiik cho ruuk' xiik' naah josq'iil.</para>
  <para style="q">
    <verse number="12" style="v" />Ma' q'e' ta yohb'aal chi neen k'ulariik i ixoq oso kore' xq'ucharik i rak'uun,</para>
  <para style="q">chuwach chi neenk'ularik i ma' nimanik taj chi k'ahchi' rub'anam i yiib' wach.</para>
  <para style="q">
    <verse number="13" style="v" />Awach imb'aan otob'il reh, eh ma' holohik ta ruq'aj wii' wach,</para>
  <para style="q">juneliik naa ruwihiik i ti' k'axik parupaat.</para>
  <para style="q">
    <verse number="14" style="v" />Noq intohq'ik i peleto xa je' chik rukab' noq inteh cho rooq i nim ha'.</para>
  <para style="q">Ruum aj re', ma' xta reet chi neenkahnik rub'aan noq komajaa' inuhtik wach.</para>
  <para style="q">
    <verse number="15" style="v" />Re' ruq'orariik chi ma' xta ru mahk i wilik ru mahk.</para>
  <para style="q">Eh re' i rukojariik ru mahk i ma' xta ru mahk,</para>
  <para style="q">re' i kiib' re' re', ma' imponik ta chuwach i QaJaaw Dios.</para>
  <para style="q">
    <verse number="16" style="v" />Re' ma' nimanik taj, xama' xta neerutiq reh chi nee ruloq' ruuk' tumiin i runa'ojb'al,</para>
  <para style="q">ruum xama' nee ta wo' rureq chi riij</para>
  <para style="q">
    <verse number="17" style="v" />Re' jino'q amígo juneliik nee qohrutoob'eej noq ti' qak'ux.</para>
  <para style="q">Inkamanik qeh chi je' qas, oon qachaaq'.</para>
  <para style="q">
    <verse number="18" style="v" />Re' ma' xta runa'ojb'al inooj okoq chi riij i ramigo pan q'atb'al q'orik,</para>
  <para style="q">eh wach naah chik i reh inkahnik i mahk re' re'.</para>
  <para style="q">
    <verse number="19" style="v" />Awach i yiib' wach runa'ojb'al imponik chuwach i peleto.</para>
  <para style="q">Eh awach i q'e' runimb'isaj riib' ruuk' i ruq'oral, xa re' reh i rujot'om riib'.</para>
  <para style="q">
    <verse number="20" style="v" />Awach i re' i yiib' wach i wilik paránima, ma' jaruuj naa rureqem i holohik.</para>
  <para style="q">Eh awach i re' i ma' toob' laj q'orik i nelik</para>
  <para style="q">cho ju' raaq' naa rojiik q'ehb'oq panti' k'axik.</para>
  <para style="q">
    <verse number="21" style="v" />Noq re' ak'uunb'ees ma' nimanik taj,</para>
  <para style="q">eh noq re' ak'uunb'ees ma' xta runa'ojb'al jinaj ti'kiil k'uxliis chi reh ajaab'ees.</para>
  <para style="q">
    <verse number="22" style="v" />Noq suq suq i ránima jino'q, je' naa jinaj iq'oom</para>
  <para style="q">chi reh. Eh noq ti' i ránima jino'q,</para>
  <para style="q">ruum i re' ink'isiimb'ik ruk'ux.</para>
  <para style="q">
    <verse number="23" style="v" />Re' q'atal q'orik yiib' wach runa'ojb'al i</para>
  <para style="q">ruk'ul i tumiin chi qeqmaal ruuk' i ruyejaa' wach.</para>
  <para style="q">Ruuk' i re', i ruyoj wach i korik.</para>
  <para style="q">
    <verse number="24" style="v" />Re' ma' xta reet runa'ojb'al,</para>
  <para style="q">iraaj i reh chi naa rureqem runa'ojb'al.</para>
  <para style="q">Eh re' ma' nimanik taj,</para>
  <para style="q">xama' reht'al ta wo' hoq chib'ih naa rojiik kuxoq wii'.</para>
  <para style="q">
    <verse number="25" style="v" />Re' ak'uunb'ees ma' nimanik taj, xa kik'aah,</para>
  <para style="q">xaruti'kiil kik'ux i rutuut rajaaw i ruyeew.</para>
  <para style="q">
    <verse number="26" style="v" />Ma' ruk'ul taj chi neenehteesjik rumulta i ma' xta ru mahk.</para>
  <para style="q">Eh ni xata ruk'ul chi neenye'arik chi tz'uhuum i holohik runa'ojb'al.</para>
  <para style="q">
    <verse number="27" style="v" />Awach i ma' xa tanwolwotik chi q'orik wilik runa'ojb'al.</para>
  <para style="q">Awach ma' teheeh ta wach re' re', wilik runa'ojb'al.</para>
  <para style="q">
    <verse number="28" style="v" />Re' ma' nimanik taj, noq i rutz'ap i chii',</para>
  <para style="q">eh ma' nchoqik ta chik, inq'ahxik nare' wo' reh chi wilik runa'ojb'al.</para>
  <chapter number="18" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' i ruq'eb'em riib', xa re' i k'axb'al riib' i reh i rusik'.</para>
  <para style="q">Eh ma' runimaj taj i ruk'uhb'aljiik.</para>
  <para style="q">
    <verse number="2" style="v" />Re' i ma' nimanik taj, ma' raaj ta rutijem i korik.</para>
  <para style="q">Xa re' la' i rub'aan i yiib' wach wilik cho paránima.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i rub'anariik i yiib' wach na'ojb'al, xa q'eb'ej iib' i ruk'am chaloq.</para>
  <para style="q">Eh re' i niimb'isanik wachiis xa k'ixb'ilaal i ruk'am chaloq.</para>
  <para style="q">
    <verse number="4" style="v" />Re' ruq'oral i winaq, je' rukab' i chaamlaj ha',</para>
  <para style="q">je' rukab' i nim ha' kow rooq, ruum nujinaq chi na'ojb'al.</para>
  <para style="q">
    <verse number="5" style="v" />Ma' ruyee ta riib' chi neenq'orarik chi ma' xta ru mahk i yiib' wach runa'ojb'al.</para>
  <para style="q">Eh chi neenkojarik ru mahk i ma' xta ru mahk.</para>
  <para style="q">
    <verse number="6" style="v" />Re' ma' nimanik taj, xa ruum i chii' i rumin riib' pan peleto.</para>
  <para style="q">Eh ruuk' ruq'oral i ruyeew riib' chi q'ojarik.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' i ma' nimanik taj, re' ruq'oral inq'eb'wik reh.</para>
  <para style="q">Ruum taqe i ruq'oral je' naa rujihk'aaj i ralaq chi k'ahaam.</para>
  <para style="q">
    <verse number="8" style="v" />Re' ruq'oral i xa tz'aqal wach k'utaaj yiib' wach i ruk'am chaloq.</para>
  <para style="q">Eh imponik wach b'aaq i ruti'kiil i rub'an.</para>
  <para style="q">
    <verse number="9" style="v" />Awach i rusikileej wach i rukamaj,</para>
  <para style="q">eliik kiwach ruuk' i aj sachool</para>
  <para style="q">
    <verse number="10" style="v" />Re' i rub'ihnaal i QaJaaw Dios, je' rukab' inajt naah tz'aq,</para>
  <para style="q">eh ar inooj kiko'leej kiib' i korik wach kik'ux.</para>
  <para style="q">
    <verse number="11" style="v" />Re' b'ehoom reh i rukapaaj chi re' i rub'ehomal,</para>
  <para style="q">je' rukab' i tinamit kotimaj riij chi najt naah tz'aq ko'lemb'al reh.</para>
  <para style="q">
    <verse number="12" style="v" />Awach i q'e' nim wach i rub'an riib', ma' naa ta reliik korik.</para>
  <para style="q">Eh awach i xama' nim ta wach i rub'an riib', naa reliik korik.</para>
  <para style="q">
    <verse number="13" style="v" />Awach i xa ruchaq'weej lom i q'orik noq komajaa' irib'iraj rukorkiil,</para>
  <para style="q">xiik' naah yib'kiil wach i rub'an, eh k'ixb'ilaal chi reh.</para>
  <para style="q">
    <verse number="14" style="v" />Noq yowaab' jino'q, neerukuy ransil wila' xuchop ruk'ux.</para>
  <para style="q">Raaj wi xyoj ruk'ux chi jumpech, ma' awach ta chik neenuksanik reh.</para>
  <para style="q">
    <verse number="15" style="v" />Re' taqe i wilik kina'ojb'al, eh holohik i wilik cho pan kánima,</para>
  <para style="q">inkireq wo' hoq i na'ojb'al inkisik'.</para>
  <para style="q">
    <verse number="16" style="v" />Eh noq wilik i rusiij i winaq, xa chu'nchel neenk'ulwik reh,</para>
  <para style="q">eh nee wo' nooj okoq kuuk' i nimaq wach kina'ojb'al.</para>
  <para style="q">
    <verse number="17" style="v" />Re' imponik chi peet pan q'atb'al q'orik, i ruq'or chi ma' xta ru mahk.</para>
  <para style="q">Eh noq imponik awach uuk' wilik rupeleto, re' reh inq'orik reh chi wilik ru mahk.</para>
  <para style="q">
    <verse number="18" style="v" />Re' i QaJaaw Dios ineesanik reh i peleto,</para>
  <para style="q">i rukoj taqe panotob'il peleto inki a'n chikiwach.</para>
  <para style="q">
    <verse number="19" style="v" />Awach i hermano inq'ehtjik, je' naa jino'q tinamit kotimaj riij chi tz'aq,</para>
  <para style="q">ruum re' i peleto inki a'n taqe i hermano, je' rukab' i tz'ilom imb'aan wii' tz'ahpik.</para>
  <para style="q">
    <verse number="20" style="v" />Re' ju'jun naa rub'anam rusuqkiil wila' holohik taqe i ruq'or.</para>
  <para style="q">Eh naa wo' ruk'ulum jilow wila' ma' holohik taqe i ruq'or.</para>
  <para style="q">
    <verse number="21" style="v" />Awach i holohik i ruq'or ruuk' i ju' raaq', k'acharik i ruk'am cho chinaah.</para>
  <para style="q">Awach i yiib' wach i ruq'or ruuk' i ju' raaq', kimik i ruk'am cho chinaah.</para>
  <para style="q">
    <verse number="22" style="v" />Noq i rureq rehk'een i winaq, ma' k'isiin ta loq'il.</para>
  <para style="q">Ruuk' i re', i ruk'ul nimlaj rotob'il i QaJaaw Dios.</para>
  <para style="q">
    <verse number="23" style="v" />Re' neb'aa' noq i rutoq'aa' q'orik ko rupahqaaj rukuyb'al.</para>
  <para style="q">Eh re' i b'ehoom reh, pank'aah inchaq'wik.</para>
  <para style="q">
    <verse number="24" style="v" />Wilik taqe i amígo jumehq'iil inyoj kik'ux.</para>
  <para style="q">Eh wilik taqe i amígo xti q'e' neetikik'ax chuwach jino'q aawas oon achaaq'.</para>
  <chapter number="19" style="c" />
  <para style="q">
    <verse number="1" style="v" />Ma' xta riq'or reh chi xa neb'aa' jino'q, xa re' la', mi korik wach ruk'ux.</para>
  <para style="q">Chuwach i ma' nimanik taj, eh xa tz'aqal wach mahk.</para>
  <para style="q">
    <verse number="2" style="v" />Awach i ma' xta runa'ojb'al, ma' holohik ta chi reh.</para>
  <para style="q">Eh re' tehwachiil inq'eb'wik pamahk.</para>
  <para style="q">
    <verse number="3" style="v" />Ruum i yiib' wach na'ojb'al i rub'an i winaq, i ruq'eb' i holohik b'eeh.</para>
  <para style="q">Eh noq inooj kuxoq panaah chik i QaJaaw Dios i rukoj.</para>
  <para style="q">
    <verse number="4" style="v" />Re' b'ehoom laj winaq, ma' k'isiin taqe i ramigo.</para>
  <para style="q">Eh re' neb'aa' reh aha' naq wilik taqe i ramigo inq'eb'arik kuum.</para>
  <para style="q">
    <verse number="5" style="v" />Awach i ma' re' tee korik i ruq'or, korehtaal inye'arik chutojariik i ru mahk.</para>
  <para style="q">Re' chukul q'orik ma' jaruuj naa reliik korik.</para>
  <para style="q">
    <verse number="6" style="v" />Awach i ma' pixp taj, eh xa q'e' insihinik,</para>
  <para style="q">chu'nchel insik'wik reh, eh inkik'am chi amigohiil.</para>
  <para style="q">
    <verse number="7" style="v" />Re' neb'aa' ni xata re' taqe ras oon ruchaaq' inaajwanik wach.</para>
  <para style="q">Ra'j naa chik re' taqe i ramigo ma' neenq'eb'wik reh.</para>
  <para style="q">Eh noq i rupahqaaj chik naa rutoob'jiik ma' awach ta chik taaj reh.</para>
  <para style="q">
    <verse number="8" style="v" />Awach i rutijej riib', eh i rub'an paruk'achariik i rutijej</para>
  <para style="q">i ruk'ax riib', eh i nelik korik i rub'an.</para>
  <para style="q">
    <verse number="9" style="v" />Awach i ma' re' taj i korik i ruq'or, naa ruye'ariik chutojariik i ru mahk.</para>
  <para style="q">Eh re' chukul q'orik kimik i ruk'am cho chinaah.</para>
  <para style="q">
    <verse number="10" style="v" />Re' ma' nimanik taj ma' ruk'ul taj chi suq neen wihik,</para>
  <para style="q">ni xata neeruyee riib' chi re' i xa móso</para>
  <para style="q">neenkahnik chi taaq'anik chikinaah i k'amal b'eeh.</para>
  <para style="q">
    <verse number="11" style="v" />Awach i wilik runa'ojb'al ma' jumehq'iil ta nchalik ruk'aah.</para>
  <para style="q">Re' i naa ruye'wiik runimaal wach re' chi naa rukuyum ransil i naa rub'aan reh.</para>
  <para style="q">
    <verse number="12" style="v" />Noq inchalik ruk'aah i reey, xa je' chik rukab' i kaq b'ahlam.</para>
  <para style="q">Eh re' otob'il i rub'an i reey, je' rukab' noq</para>
  <para style="q">inqajik chaloq i mus jab' chinaah i kok' ch'ahn.</para>
  <para style="q">
    <verse number="13" style="v" />Re' ak'uunb'ees ma' nimanik taj, xaruti'kiil ruk'ux i rajaaw i ruyeew.</para>
  <para style="q">Re' ixoq xa re' i k'aah i rub'an, je' rukab' i kojweel cho nah paat ma' jaruuj i rumay.</para>
  <para style="q">
    <verse number="14" style="v" />Re' i kooch inkiyeew i tuutb'ees i ajaab'ees, xa paat, eh xa b'ehomal.</para>
  <para style="q">Eh re' i ehk'eenb'ees wilik runa'ojb'al, re' i QaJaaw Dios inye'wik cho reh.</para>
  <para style="q">
    <verse number="15" style="v" />Re' sikilal inchalik jinaj suq laj wirik ruum.</para>
  <para style="q">Eh re' sikiil laj winaq, naa rukuyum ruwa' ruhaa'.</para>
  <para style="q">
    <verse number="16" style="v" />Awach i rub'an i ruq'or i k'uhb'aal, i ruko'leej riij i ruk'achariik.</para>
  <para style="q">Awach i ma' imponik ta panaq'wach</para>
  <para style="q">i rub'eeh i QaJaaw Dios, kimik i naa ruchaliik chinaah.</para>
  <para style="q">
    <verse number="17" style="v" />Awach i ruyeew rukemeel i neb'aa', je' naa re' i QaJaaw Dios i ruyeew rukemeel.</para>
  <para style="q">Eh re' i QaJaaw Dios naa ruye'wiik jilow reh i otob'il i rub'an.</para>
  <para style="q">
    <verse number="18" style="v" />Chatijej aawak'uun awixq'uun noq koruyee riib' chi neenatijej,</para>
  <para style="q">xa re' la', maakansaj wo' chik ruuk' i rutijiik naa a'nam.</para>
  <para style="q">
    <verse number="19" style="v" />Awach i q'e' josq', naa ruk'ulum i rutojb'aal.</para>
  <para style="q">Eh wila' ehteesjik chutojariik i ru mahk, xa ruman nee nuhtik wach i ruk'aah.</para>
  <para style="q">
    <verse number="20" style="v" />Chak'am naah aak'uhb'aaljiik,</para>
  <para style="q">eh cha nimaj aatijiik imb'aan chi je' re' neenooj areq ana'ojb'al chi manlik.</para>
  <para style="q">
    <verse number="21" style="v" />Re' winaq xama' k'isiin naq i ruyejaa' wach rub'aan.</para>
  <para style="q">Xa re' la' xa re' wo' inooj eloq wach i ruyeew q'ab' i QaJaaw Dios chi naa rub'anam.</para>
  <para style="q">
    <verse number="22" style="v" />Awach i ruk'ax wach i b'ehomal, re' re' inq'eb'wik reh pan k'axik.</para>
  <para style="q">Ruum aj re', ma' xta reet chi xa neb'aa' jino'q chuwach i aj chukul q'orik.</para>
  <para style="q">
    <verse number="23" style="v" />Re' ruyohljiik QaJaaw Dios, pan holohik laj k'acharik ink'amwik.</para>
  <para style="q">Noq ma' xta k'axik chinaah jino'q,</para>
  <para style="q">xasuq i k'acharik i rub'an.</para>
  <para style="q">
    <verse number="24" style="v" />Re' i winaq xiik' naah sikilal,</para>
  <para style="q">atoob' ta wo' naq tuqlik chuwach i ruwa',</para>
  <para style="q">ni xata ruk'uxariik iraaj rub'anam.</para>
  <para style="q">
    <verse number="25" style="v" />Wila' xye'arik chutojariik i ru mahk i ma' xta runa'ojb'al</para>
  <para style="q">nee rukoj rehtaal chi ma' holohik taj i rub'an.</para>
  <para style="q">Eh re' wilik runa'ojb'al reh neerutijej ruuk' i ruq'ilariik neemb'aan.</para>
  <para style="q">
    <verse number="26" style="v" />Awach i relq'aaj chib'ih reh i rajaaw, eh iresaj reje i rutuut pampaat,</para>
  <para style="q">re' re' k'ixb'ilaal imb'anik ma' ruk'ul ta naq chi naa rub'anam i je' re'.</para>
  <para style="q">
    <verse number="27" style="v" />Hat wak'uun noq wilkaat, maayeew chi re' chi ma' re' aq'ilariik.</para>
  <para style="q">Chak'am la' naah aak'uhb'aaljiik ruum re' re' inye'wik ana'ojb'al.</para>
  <para style="q">
    <verse number="28" style="v" />Re' i ma' re' taj i korik i ruq'or, xa rukaqse'laaj i korik.</para>
  <para style="q">Eh re' yiib' wach runa'ojb'al, xa re' i yiib' wach q'orik i nelik cho pan chi'.</para>
  <para style="q">
    <verse number="29" style="v" />Re' i ti' k'axik korjinaq chik cho chi keh i yiib' wach kib'anik.</para>
  <para style="q">Eh re' i ma' kinimanik taj, kow naakiye'ariik chi tz'uhuum.</para>
  <chapter number="20" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' inuk'inik reh i k'ahlaj ha' ma' xta runa'ojb'al inxohk'rik i ruyoj i rukapeb'aal,</para>
  <para style="q">eh ma' reht'al ta chik i rub'an.</para>
  <para style="q">
    <verse number="2" style="v" />Re' reey noq inchalik ruk'aah, je' rukab' i kaq b'ahlam.</para>
  <para style="q">Eh awach inye'wik ruk'aah i reey, i ruyeew panyohb'aal i ruk'achariik.</para>
  <para style="q">
    <verse number="3" style="v" />Re' inye'wik runimaal wach i winaq, re' chi ma' awach taj ineeruwech'uj.</para>
  <para style="q">Re' taqe i ma' kinimanik taj, xa re' wech'inik kiib' inki a'n</para>
  <para style="q">
    <verse number="4" style="v" />Noq ruq'ijil ab'iixik, re' i sikiil laj winaq ma' rub'an taj i b'anaj arado.</para>
  <para style="q">Xa re' la', noq i rureq ruq'ijil i jach,</para>
  <para style="q">i rusik' naq i wach i rutik, eh xama' xta wo' i rumol.</para>
  <para style="q">
    <verse number="5" style="v" />Re' holohik laj na'ojb'al atoob' ta je' chamiil</para>
  <para style="q">chaamlaj ha' wilik cho wii' paránima jino'q.</para>
  <para style="q">Eh re' i wilik runa'ojb'al xa nee wo' rureq chi riij.</para>
  <para style="q">
    <verse number="6" style="v" />Wilik inkiq'or chi xa q'e' atoob' wach kik'ux,</para>
  <para style="q">xa re' la', ma' jino'q wo' keh i atoob' wach ruk'ux.</para>
  <para style="q">
    <verse number="7" style="v" />Re' i korik wach ruk'ux paruk'achariik,</para>
  <para style="q">holohik i kik'achariik taqe i rak'uun rixq'uun naa ruwihiik.</para>
  <para style="q">
    <verse number="8" style="v" />Re' i reey noq intzuhnik paruye'aab' chi q'ataj q'orik</para>
  <para style="q">xa neerutz'ehtaaj panaq'wach i ju'jun, noq nee rureq chi riij i wilik ru mahk.</para>
  <para style="q">
    <verse number="9" style="v" />Ruum aj re' ma' awach nee nq'orik reh chi je' wili:</para>
  <para style="q">Re' hin xa eliik saq wach i wánima, ma' xta numahk, inko'q.</para>
  <para style="q">
    <verse number="10" style="v" />Re' QaJaaw Dios ma' imponik ta chuwach chi ma' manlik taj i pajooj imb'aan ruuk' pexu,</para>
  <para style="q">oon ruuk' chik jino'q pajb'al.</para>
  <para style="q">
    <verse number="11" style="v" />Re' i k'ijool, re' i chib'ih taqe jariik i rub'an ink'uhtanik reh</para>
  <para style="q">mi holohik i runa'ojb'al, oon ma' chih taj.</para>
  <para style="q">
    <verse number="12" style="v" />Re' qaxikin reh chi naa qib'iriniik, re' naq'qawach reh chi naa qilwiik,</para>
  <para style="q">re' i QaJaaw Dios xyej-anik reh.</para>
  <para style="q">
    <verse number="13" style="v" />Matokik chi wirik reh chi ma' nee ta tineb'a'rik.</para>
  <para style="q">Eliik-oq la' na'lik aweh chub'aan akamaj, reh chi neen wihik awa' ahaa'.</para>
  <para style="q">
    <verse number="14" style="v" />Awach inloq'wik je' wili ruq'or: Re' wili ma' holohik taj, inki.</para>
  <para style="q">Xanaah re' noq i rub'an reje i loq' i reh xa runimb'isaj chik riib' ruuk'.</para>
  <para style="q">
    <verse number="15" style="v" />Awach i wilik runa'ojb'al ruuk' taqe ruq'or, xiik' naah k'ihaal tz'aaq chuwach oro,</para>
  <para style="q">chuwach i q'e' k'ih taq tz'aaq.</para>
  <para style="q">
    <verse number="16" style="v" />Awach i ma' xta runa'ojb'al inooj i ruyeew i ruq'oral chi riij i aj k'aas,</para>
  <para style="q">eh wila' ma' xutoj i ruk'ul chi neenq'ucharik i ruso'.</para>
  <para style="q">
    <verse number="17" style="v" />Re' chukul q'orik xa runujisaj chik riib' ruuk' taqe i rureq ruuk' i jot'ooj.</para>
  <para style="q">Eh noq inooj kuxoq, xa je' ak'al i ruk'ux.</para>
  <para style="q">
    <verse number="18" style="v" />Re' taqe imb'aan, ruuk' holohik laj na'ojb'al, inkorjik wach.</para>
  <para style="q">Eh ruuk' wo' holohik laj na'ojb'al, inkorjik wach noq imb'aan i q'aq'inik.</para>
  <para style="q">
    <verse number="19" style="v" />Re' i xanooj chi molooj wach k'utaaj ma' xtaj i rumol paránima, chu'nchel i ruq'or.</para>
  <para style="q">Re' hat maa a'n jinaj wach ak'ux ruuk' i molol wach k'utaaj.</para>
  <para style="q">
    <verse number="20" style="v" />Awach i rub'aj i rutuut rajaaw, re' re' kimik i ruk'am cho chinaah,</para>
  <para style="q">eh naa ruye'ariik pa runimaal q'equm.</para>
  <para style="q">
    <verse number="21" style="v" />Aha' wilik taqe i xa chib'ih jariik, i ma' k'axik ta noq inkan pampeet,</para>
  <para style="q">ni xata ruyeew suq kiil k'uxliis noq inooj kuxoq.</para>
  <para style="q">
    <verse number="22" style="v" />Maaq'aj wach i ma' holohik taj imb'aan aweh.</para>
  <para style="q">Chawuy-eej la' chi re' i QaJaaw Dios neenko'linik aweh chupaam.</para>
  <para style="q">
    <verse number="23" style="v" />Re' i QaJaaw Dios ma' imponik ta chuwach taqe i pajb'al kielq'anik,</para>
  <para style="q">je' wo' taqe i pexu kielq'anik.</para>
  <para style="q">
    <verse number="24" style="v" />Re' winaq re' i QaJaaw Dios ink'amwik rub'eeh paruk'achariik.</para>
  <para style="q">Eh re' reh ma' reht'al taj chib'ih i naa rojiik kuxoq wii'.</para>
  <para style="q">
    <verse number="25" style="v" />Re' winaq yohb'aal chi reh wila' xa pan jumehq'iil</para>
  <para style="q">xuq'or reh i QaJaaw Dios chi naa runimam.</para>
  <para style="q">Eh mo'-oq wo' xub'an i xuq'or k'axik chi reh.</para>
  <para style="q">
    <verse number="26" style="v" />Re' i reey wilik runa'ojb'al i resaj</para>
  <para style="q">taqe reje yiib' wach kina'ojb'al.</para>
  <para style="q">Eh je' naa rik'saj kotkot laj ch'ihch' chikinaah.</para>
  <para style="q">
    <verse number="27" style="v" />Re' ránjel rut'iosil i winaq ye'ooj reh ruum i Dios</para>
  <para style="q">jinaj saqum, i rusihq'eej chu'nchel i wilik cho paránima.</para>
  <para style="q">
    <verse number="28" style="v" />Re' i reey ma' awach ta neenesanik</para>
  <para style="q">reh paruye'aab', wila' wilik k'axooj ruuk',</para>
  <para style="q">eh wila' re' i korik i rub'an.</para>
  <para style="q">
    <verse number="29" style="v" />Re' i runimaal kiwach i k'ijolaq, re' i kaansil.</para>
  <para style="q">Eh re' i runimaal kiwach i mama' winaq, re' i rusaqiil i rismaal kinaah.</para>
  <para style="q">
    <verse number="30" style="v" />Ruuk' q'ojooj, ruuk' hopooj, iniq'oomjik i yiib' wach runa'ojb'al.</para>
  <para style="q">Ruuk' taqe i ti' ruk'ul, i rureq chi riij taqe i korik.</para>
  <chapter number="21" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' runa'ojb'al i reey,</para>
  <para style="q">je' rukab' i rooq ha' pan q'ab' i QaJaaw Dios.</para>
  <para style="q">Re' reh ink'amwik rub'eeh ruuk' chu'nchel i rub'an.</para>
  <para style="q">
    <verse number="2" style="v" />Re' winaq xa chu'nchel ma' xta reet i rub'an noq i rukapaaj.</para>
  <para style="q">Xa re' la', re' i QaJaaw Dios ineht'alinik reh chib'ih i wilik cho pan ánima.</para>
  <para style="q">
    <verse number="3" style="v" />Re' rub'aan i korik, i rub'ehel, imponik chuwach i QaJaaw Dios,</para>
  <para style="q">ma' je' ta rukab' i xa k'atoj mayiij.</para>
  <para style="q">
    <verse number="4" style="v" />Re' i niimb'isanik wachiis, i k'ul b'anaj wachiis</para>
  <para style="q">inki a'n i yiib' wach kina'ojb'al mahk chi b'anarik.</para>
  <para style="q">
    <verse number="5" style="v" />Re' taqe inkorjik wach chi kapeb'imaj riij chi korik, wilik i ruk'am chaloq.</para>
  <para style="q">Eh re' taqe i xa pan ajiim b'eeh imb'aan, xa nooj sahchoq wach.</para>
  <para style="q">
    <verse number="6" style="v" />Re' i b'ehomal i molarik wach ruuk' jot'ooj,</para>
  <para style="q">xama' xta nokik wii', xa ye'b'al k'isinoq</para>
  <para style="q">rusuqkiil kik'ux i xa re' i kikimiik inkisik'.</para>
  <para style="q">
    <verse number="7" style="v" />Re' i yiib' wach kina'ojb'al ruum i ti' k'axik</para>
  <para style="q">inki a'n reh i tokoom, naa rusahchiik kiwach.</para>
  <para style="q">Ruum chi ma' xkik'am ta naah i korik.</para>
  <para style="q">
    <verse number="8" style="v" />Re' i yiib' wach imb'anik, xama' xta kamaj i rub'an, ma' xta ruk'am chaloq.</para>
  <para style="q">Eh re' taqe i rub'an i korik wach ruk'ux, saq kiwach.</para>
  <para style="q">
    <verse number="9" style="v" />Ma' xta reet chi xa pan lahtz' paam paat neenpatinik i winaq.</para>
  <para style="q">Eh xama' xta nkih chi chupaam i nimlaj paat</para>
  <para style="q">neenpatinik ruuk' jino'q ixoq xiik' naah josq'iil.</para>
  <para style="q">
    <verse number="10" style="v" />Re' yiib' wach runa'ojb'al xa re' i ma' holohik taj i rukapaaj rub'aan.</para>
  <para style="q">Ma' ruketelaaj ta kiwach i ras ruchaaq'.</para>
  <para style="q">
    <verse number="11" style="v" />Noq inye'arik chutojariik i ru mahk i yiib' wach imb'anik, kore' i rureq runa'ojb'al.</para>
  <para style="q">Eh re' wilik runa'ojb'al reh, xa ruuk' i junriim chi q'ilooj neenimanik.</para>
  <para style="q">
    <verse number="12" style="v" />Re' i Dios korik wach ruk'ux, i rukanaa' chi ma'</para>
  <para style="q">xta rak'uun rixq'uun i yiib' wach runa'ojb'al.</para>
  <para style="q">Eh i rusach kiwach i yiib' wach kib'anik.</para>
  <para style="q">
    <verse number="13" style="v" />Awach i ma' i rutoob'eej i neb'aa' noq i rupahqaaj rutoob'jiik,</para>
  <para style="q">ma' naa ta wo' rutoob'jiik i reh noq naa rupahqaam rutoob'jiik.</para>
  <para style="q">
    <verse number="14" style="v" />Re' jino'q i winaq atoob' ta yohb'aal wach i ruk'aah,</para>
  <para style="q">eh wila' xsiijik chib'ih reh, ruuk' i re', neenik'ik i ruk'aah.</para>
  <para style="q">
    <verse number="15" style="v" />Noq imb'aan i rub'ehel insuuqb'ik ruk'ux i korik wach ruk'ux.</para>
  <para style="q">Eh re' taqe ma' holohik ta kib'anik, naa rusahchiik kiwach.</para>
  <para style="q">
    <verse number="16" style="v" />Awach i ma' ruk'am ta naah i holohik laj na'ojb'al,</para>
  <para style="q">pankimik naa rojiik.</para>
  <para style="q">
    <verse number="17" style="v" />Awach i rukut riib' chi ruuk'jiik i k'ahlaj ha' inxohk'risanik,</para>
  <para style="q">eh i rukoj taqe ink'ohnik laj iq'oom re' re' naa ruye'em riib' paneb'a'il.</para>
  <para style="q">
    <verse number="18" style="v" />Re' i ma' korik ta wach ruk'ux, i yiib' wach runa'ojb'al,</para>
  <para style="q">naa ruwihiik panti' k'axik chi jilow i korik wach ruk'ux.</para>
  <para style="q">
    <verse number="19" style="v" />Ma' xta reet chi xa pan i chiq yuuq' neenk'acharik winaq,</para>
  <para style="q">chuwach chi neenk'acharik ruuk' jino'q ixoq</para>
  <para style="q">xa re' k'aah i rub'an, xama' holohik ta imb'anik.</para>
  <para style="q">
    <verse number="20" style="v" />Re' wilik runa'ojb'al, wilik rub'ehomal,</para>
  <para style="q">wilik ru ink'ohnik laj iq'oom parupaat.</para>
  <para style="q">Eh re' i ma' nimanik taj, i rusach wach i chib'ih reh.</para>
  <para style="q">
    <verse number="21" style="v" />Awach i rusik' i korik, eh inketelinik wachiis</para>
  <para style="q">nee rureq i holohik laj k'acharik, nee wo' inye'arik runimaal wach.</para>
  <para style="q">
    <verse number="22" style="v" />Re' i wilik runa'ojb'al nee ruchop naah i kitinamiit i kow kiib',</para>
  <para style="q">neeruq'at wach i kajaawriik inkiko'leej naq wii' kiib'.</para>
  <para style="q">
    <verse number="23" style="v" />Awach i korukapaaj riij taqe ruq'or,</para>
  <para style="q">ma' jaruuj nee ruyeew riib' pan k'axik.</para>
  <para style="q">
    <verse number="24" style="v" />Re' i yiib' wach i runa'ojb'al, xama' holohik ta imb'anik, xa nim wach i rub'an riib'.</para>
  <para style="q">Eh xa teheeh wach, i rukaqse'laaj taqe i ras ruchaaq'.</para>
  <para style="q">
    <verse number="25" style="v" />Re' i sikil laj winaq wilik naq i rootwaaj.</para>
  <para style="q">Xa re' la', xanaa wo' rukimiik reje chi ma' naa ta rureqem, ruum ma' raaj ta kamanik.</para>
  <para style="q">
    <verse number="26" style="v" />Re' reh xa chu'nchel naq q'iij irootwaaj.</para>
  <para style="q">Eh re' korik wach ruk'ux, xa wilik wo' chib'ih reh ma' rupixpuuj ta wach q'e' insihinik.</para>
  <para style="q">
    <verse number="27" style="v" />Re' QaJaaw Dios ma' imponik ta chuwach i kimayiij i yiib' wach kina'ojb'al,</para>
  <para style="q">ruum i ma' holohik taj inkaaj chi riij.</para>
  <para style="q">
    <verse number="28" style="v" />Re' i ma' re' taj i korik i ruq'or, naa rusahchiik wach.</para>
  <para style="q">Eh awach irib'iraj chi korik inq'orarik, re' re' neenchol ruchaq'weesjiik.</para>
  <para style="q">
    <verse number="29" style="v" />Re' yiib' wach runa'ojb'al xasuq chik wilik i rub'an riib'.</para>
  <para style="q">Eh re' korik wach ruk'ux, korik reh chi holohik i runa'ojb'al.</para>
  <para style="q">
    <verse number="30" style="v" />Chuwach i QaJaaw Dios ma' xta jino'q na'ojb'al nim wach,</para>
  <para style="q">ni xata jino'q holohik laj kapeew.</para>
  <para style="q">
    <verse number="31" style="v" />Re' winaq i ruyejaa' i rukawayu reh i q'aq'inik,</para>
  <para style="q">re' QaJaaw Dios i ruyeew i rajaawriik chi nee nelik korik ruuk' i q'aq'inik.</para>
  <chapter number="22" style="c" />
  <para style="q">
    <verse number="1" style="v" />Awach i holohik rib'iral, xiik' naah k'ihaal tz'aaq chuwach i b'ehomal.</para>
  <para style="q">Eh wila' holohik inq'orarik chi riij, xiik' naah k'ihaal tz'aaq chuwach i oro, i plata.</para>
  <para style="q">
    <verse number="2" style="v" />Re' i neb'aa', i b'ehoom xa jinaj kiwach,</para>
  <para style="q">re' i QaJaaw Dios xyej-anik keh kikab'cheel.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i wilik runa'ojb'al i rukoj rehtaal aha' wilik i yohb'aal, i rukotej riij.</para>
  <para style="q">Eh re' i ma' xta runa'ojb'al, ma' rukoj ta rehtaal, ko q'ehb'inaq chik ar noq irik'raaj.</para>
  <para style="q">
    <verse number="4" style="v" />Re' i loch'oj iib', re' i ruyohljiik i QaJaaw Dios, b'ehomal, runimaal wachiis,</para>
  <para style="q">eh suq laj k'acharik i ruk'am chaloq.</para>
  <para style="q">
    <verse number="5" style="v" />Re' yiib' wach runa'ojb'al xama' k'isiin i k'axik inq'atwik parub'eeh.</para>
  <para style="q">Eh re' i ruyohleej i ruk'achariik ma' ruyeew ta q'ab' chi nq'ehb'ik ar.</para>
  <para style="q">
    <verse number="6" style="v" />Chatijej i ha'lak'un paruk'isinal, eh noq neenrijb'ik</para>
  <para style="q">ma' nee ta nsahchik paruk'ux.</para>
  <para style="q">
    <verse number="7" style="v" />Re' b'ehoom intaaq'anik chinaah i neb'aa'.</para>
  <para style="q">Re' inye'wik i kemeel intaaq'anik chinaah i aj kemeel.</para>
  <para style="q">
    <verse number="8" style="v" />Awach i re' i yiib' wach i rutik, ti' k'axik i naa rujacham.</para>
  <para style="q">Eh re' i QaJaaw Dios naa rusachwiik wach ruuk' i rujosq'iil.</para>
  <para style="q">
    <verse number="9" style="v" />Awach i wilik i ketelinik wachiis ruuk',</para>
  <para style="q">eh i runej i ruwa' i ma' xta wilik reh naa ruk'ulum i rotob'il i Dios.</para>
  <para style="q">
    <verse number="10" style="v" />Chawisaj reje i ma' holohik ta imb'anik,</para>
  <para style="q">chi je' re' neemahyik i choqinik iib', i peleto, i b'ajooj.</para>
  <para style="q">
    <verse number="11" style="v" />Re' reey imponik chuwach i rub'an i korik wach ruk'ux.</para>
  <para style="q">Eh i ruk'am panotob'il awach i xa holohik inq'orik.</para>
  <para style="q">
    <verse number="12" style="v" />Re' QaJaaw Dios i rucha'jeej chi korik i wilik runa'ojb'al.</para>
  <para style="q">Eh ma' runimaj taj i ruq'or i aj chukul q'orik.</para>
  <para style="q">
    <verse number="13" style="v" />Re' i sikiil laj winaq xa chib'ih i rutz'aq wach,</para>
  <para style="q">i ruq'or chi naa ruk'uxariik ruum i kaq b'ahlam pamb'eeh.</para>
  <para style="q">
    <verse number="14" style="v" />Re' ruq'oral ixoq i ruch'uwa' risaj wach irukaxaro, je' rukab' i chaam laj jul.</para>
  <para style="q">Re' inooj q'ehb'oq wii' noq inye'arik panti' k'axik ruum i QaJaaw Dios.</para>
  <para style="q">
    <verse number="15" style="v" />Re' i ma' holohik taj imb'aan, re' ruuk' i kina'ojb'al i k'ijolaq,</para>
  <para style="q">eh ruuk' i tz'uhuum neenb'aan keh neenkikanaa' rub'aan.</para>
  <para style="q">
    <verse number="16" style="v" />Awach i ruq'uch i chib'ih reh i neb'aa', re' iraaj chi nee nb'ehoomrik.</para>
  <para style="q">Eh awach i rusiij chib'ih reh i b'ehoom, naa rune'b'aa'riik na' ponoq kuxoq.</para>
  <para style="s">Re' lajeeb' ru ka'winaq chi k'uhb'aal xkiq'or taqe i wilik kina'ojb'al</para>
  <para style="q">
    <verse number="17" style="v" />Chab'iraj chi korik i k'uhb'aal inki a'n i wilik kina'ojb'al.</para>
  <para style="q">Eh xti cha kapaaj riij aatijiik i nub'an i hin,</para>
  <para style="q">
    <verse number="18" style="v" />ruum re' taqe re' xiik' naah chihojal cha weh chi neenamol panawánima.</para>
  <para style="q">Reh chi neena a'n ruq'orariik nik' neenawaaj ruq'orariik.</para>
  <para style="q">
    <verse number="19" style="v" />Yu'naak i nuyeew aweh chi naab'jik taqe wili,</para>
  <para style="q">reh chi nee nayeew ak'ux ruuk' i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Re' hin xnutz'ihb'aaj aweh i lajeeb' ru ka'winaq chi q'orik,</para>
  <para style="q">re' taqe i holohik laj k'uhb'aal, i holohik chi tiijik,</para>
  <para style="q">
    <verse number="21" style="v" />reh i ruk'uhtjiik aweh chi neenareq chi riij i korik,</para>
  <para style="q">reh wo' chi neena a'n ruq'orariik chi korik noq neenpahqaljik aweh.</para>
  <para style="q">
    <verse number="22" style="v" />Maaq'uch i chib'ih reh i neb'aa', mo'-oq xa re' inawil chi xa neb'aa' tii.</para>
  <para style="q">Eh maaq'uch chib'ih reh pan q'atb'al q'orik i ma' xta neeruko'leej wii' riib',</para>
  <para style="q">
    <verse number="23" style="v" />ruum re' i QaJaaw Dios naa ruko'liniik keh.</para>
  <para style="q">Eh awach i naa ruq'uchwiik i chib'ih keh naa ruq'uchariik i chib'ih wilik kee keh.</para>
  <para style="q">
    <verse number="24" style="v" />Maak'am taqe chi awamigo, eh ni xata nee nawuhch'ihleej taqe i q'e' josq',</para>
  <para style="q">je' wo' taqe i ma' holohik ta kib'anik,</para>
  <para style="q">
    <verse number="25" style="v" />reh chi ma' nee ta natijej aweh inki a'n ruum wi xatijej aweh,</para>
  <para style="q">je' naa neenajihk'aaj awiib' ruuk' laso.</para>
  <para style="q">
    <verse number="26" style="v" />Manooj aq'or pan q'atb'al q'orik</para>
  <para style="q">chi neenatoj i ruk'aas i wilik ruk'aas,</para>
  <para style="q">
    <verse number="27" style="v" />ruum wila' ma' chih awuuk' i naa atojom wii' i k'aas re' re',</para>
  <para style="q">noq neenooj kuxoq neenkiq'uch ach'aht tiwirik wii'.</para>
  <para style="q">
    <verse number="28" style="v" />Maajil taqe i rehtalil i k'ula't</para>
  <para style="q">kitikim kahnoq aamaam awati't.</para>
  <para style="q">
    <verse number="29" style="v" />Awach i rub'an chi korik i rukamaj,</para>
  <para style="q">pankikamaj taqe i reey naa ruwihiik,</para>
  <para style="q">ma' re' ta parukamaj jino'q i xama' xta rajaawriik.</para>
  <chapter number="23" style="c" />
  <para style="q">
    <verse number="1" style="v" />Noq neetiruyuq'eej ruuk' chi wi'k jino'q i nim wach,</para>
  <para style="q">chakoj rehtaal chi korik awach uuk' wilkaat.</para>
  <para style="q">
    <verse number="2" style="v" />Atoob' ta yohb'aal wach aanuhmiik</para>
  <para style="q">matokik lom chi wi'k.</para>
  <para style="q">
    <verse number="3" style="v" />Maak'ax wach i suq atoob' i ruk'ux,</para>
  <para style="q">ruum aajot'ariik-oq iraaj ruuk' i nee ruyeew aweh.</para>
  <para style="q">
    <verse number="4" style="v" />Mo'-oq xa re' inaq'or panak'ux chi naa aab'ehoomriik,</para>
  <para style="q">cha kanaa' rukapeb'jiik i re'.</para>
  <para style="q">
    <verse number="5" style="v" />Wila' xakoj rehtaal chi korik,</para>
  <para style="q">neenanab'eej chi re' i b'ehomal xama' xta nokik wii'.</para>
  <para style="q">Xa jumehq'iil inik'ik, xa impoq' reje ruxiik', je' rukab' noq inxik'inik reje i xihk.</para>
  <para style="q">
    <verse number="6" style="v" />Maatzunaa' awiib' chi wi'k nah rumexa i yohb'aal wach pixpiil.</para>
  <para style="q">Eh maak'ax wach i suq atoob' i ruk'ux,</para>
  <para style="q">
    <verse number="7" style="v" />ruum re' reh xa neerutiib'isaj ak'ux,</para>
  <para style="q">neetiruyuq'eej ruuk' chi wi'k, xa re' la',</para>
  <para style="q">ma' korik ta wo' reh i rub'an, nee wo' chik i rupixuj aweh ruka'peech.</para>
  <para style="q">
    <verse number="8" style="v" />Eh nee-oq wo' chik inaxab'ej ruka'peech i neenak'ux.</para>
  <para style="q">Chi je' re' xa nee nayeew chi re' chi ma' re' i holohaq laj q'orik xaq'o'reej wii'.</para>
  <para style="q">
    <verse number="9" style="v" />Maak'uhb'alej i ma' nimanik taj,</para>
  <para style="q">ruum xa neeruse'laaj taqe i holohaq laj q'orik neenaq'or reh.</para>
  <para style="q">
    <verse number="10" style="v" />Maajil i rehtalil i k'ula't kojooj cho najtir q'iij.</para>
  <para style="q">Eh maaq'uuch wo' hoq i kak'aal taqe i ma' xta kituut kajaaw,</para>
  <para style="q">
    <verse number="11" style="v" />ruum re' keh wilik jinaj ko'len keh q'e' nim rajaawriik.</para>
  <para style="q">Eh re' reh naa rub'aniik ti' k'axik aweh chi ko'lb'al keh.</para>
  <para style="q">
    <verse number="12" style="v" />Chamol panawánima aatijiik imb'aan.</para>
  <para style="q">Eh chayeew axikin chi rib'iirjiik holohik laj na'ojb'al.</para>
  <para style="q">
    <verse number="13" style="v" />Maacanaa' rutijiik i k'ijool, atoob' ta nee nayeew jarpech-oq chi tz'uhuum</para>
  <para style="q">ma' ruum tee re' neenkimik.</para>
  <para style="q">
    <verse number="14" style="v" />Nee la' nako'leej chuwach</para>
  <para style="q">i kimik wila' xatijej.</para>
  <para style="q">
    <verse number="15" style="v" />Hat wak'uun noq wilkaat, wila' xareq ana'ojb'al chi manlik,</para>
  <para style="q">re' hin ma' k'isiin ta naa rusuuqb'iik nuk'ux.</para>
  <para style="q">
    <verse number="16" style="v" />Eh ma' k'isiin wo' naa rusuuqb'iik nuk'ux noq naa kaat b'iram</para>
  <para style="q">chi k'ahchi' aq'oriik nik' wach i ruk'ul chi naa aq'oriik.</para>
  <para style="q">
    <verse number="17" style="v" />Maawixowaaj kiwach taqe aj mahk,</para>
  <para style="q">eliik la' chayohleej wach i QaJaaw Dios.</para>
  <para style="q">
    <verse number="18" style="v" />Wila' je' re' i xa a'n holohik naa awojiik kuxoq wii'.</para>
  <para style="q">Eh re' i ch'iklik wii' ak'ux, ma' jaruuj naa rusahchiik wach.</para>
  <para style="q">
    <verse number="19" style="v" />Hat wak'uun noq wilkaat, chab'iraj i nuq'or aweh, eh cha tijej awiib',</para>
  <para style="q">eh re' i holohik b'eeh chak'am.</para>
  <para style="q">
    <verse number="20" style="v" />Maamol awiib' kuuk' taqe i kixohk'rik,</para>
  <para style="q">je' wo' kuuk' taqe i xa kitusik,</para>
  <para style="q">
    <verse number="21" style="v" />ruum re' taqe i kixohk'rik, taqe i xa kitusik,</para>
  <para style="q">ma' xta chik i wilik keh noq inooj kuxoq,</para>
  <para style="q">kineb'aa'rik. Eh ni xata chik inkiloq' kiso' chub'aan.</para>
  <para style="q">
    <verse number="22" style="v" />Chab'iraj aak'uhb'aaljiik i rub'an aawajaaw i xtz'uhkrisanik chaaweh.</para>
  <para style="q">Eh maa wixowaaj wach atuut noq neenrijb'ik.</para>
  <para style="q">
    <verse number="23" style="v" />Chawehchaaj i korik, je' wo' i holohik laj na'ojb'al,</para>
  <para style="q">je' wo' i tijinik, ruch'ihil i holohik laj kapeew, mankiq'uch chik aweh.</para>
  <para style="q">
    <verse number="24" style="v" />Re' korik wach ruk'ux, eh wilik runa'ojb'al,</para>
  <para style="q">rub'ehel chi eliik suq ruk'ux i rajaaw, eh wilik runimaal wach.</para>
  <para style="q">
    <verse number="25" style="v" />Re' i holohik laj na'ojb'al cha a'n,</para>
  <para style="q">reh chi neensuuqb'ik kik'ux atuut awajaaw.</para>
  <para style="q">
    <verse number="26" style="v" />Hat wak'uun noq wilkaat, chayeew weh awánima,</para>
  <para style="q">eh chak'am naah i nub'an i hin.</para>
  <para style="q">
    <verse number="27" style="v" />Ruum re' i k'oyoom laj ixoq, eh re' ixoq ma' eht'alimaj ta wach,</para>
  <para style="q">xa je' rukab' i jul chaam, lahtz' paam.</para>
  <para style="q">
    <verse number="28" style="v" />Re' ixoq re' re' k'ahchi' chi sachooj, je' rukab' i ajileq',</para>
  <para style="q">ma' k'isiin taqe i winaq i ruq'eb' pamahk.</para>
  <para style="q">
    <verse number="29" style="v" />¿Awach i panti' k'axik wilik? ¿Awach i ruk'er chii'?</para>
  <para style="q">¿Awach i xa eliik peleto i rub'an, eh xa eliik oq'ik i rub'an?</para>
  <para style="q">¿Awach i ti' wilik chi xama' xta rub'ehel? ¿Awach i xa re' i ma' holohik taj i ruk'ul?</para>
  <para style="q">
    <verse number="30" style="v" />Re' ma' i rukanaa' ta ruuk'jiik i k'ahlaj ha' inxohk'risanik,</para>
  <para style="q">eh xa reh reh chik wach i k'ahlaj ha' i ruk'ej.</para>
  <para style="q">
    <verse number="31" style="v" />Maak'ax wach i k'ahlaj ha', noq neenkit'urej pan kulk</para>
  <para style="q">xa kaq chik wach, xasaqum chik paam,</para>
  <para style="q">eh xa ch'ub'ik chik noq inooj qohoq.</para>
  <para style="q">
    <verse number="32" style="v" />Xanaah re', re' ruuk'jiik i re',</para>
  <para style="q">je' rukab' i rutiiw i aaq' ti' k'axik i ruk'am chaloq noq inooj kuxoq.</para>
  <para style="q">
    <verse number="33" style="v" />Ruum i re', xa chib'ih jariik ineenawil wach,</para>
  <para style="q">eh xa chib'ih jariik i ma' holohik taj neenaq'or.</para>
  <para style="q">
    <verse number="34" style="v" />Eh noq hat xohk'reel, je' naa chinaah jino'q i palaw,</para>
  <para style="q">oon chi ju' jino'q i qamaan chee' wilkaat noq neenawik'raaj.</para>
  <para style="q">
    <verse number="35" style="v" />Eh je' wili i neenaq'or: Xinkiq'oj,</para>
  <para style="q">xinkiyeew chi tz'uhuum, ni xata xwik'raaj noq xkian weh.</para>
  <para style="q">Noq neen k'ulik nuk'ux nee wo' chik inooj nusik' i nuhaa', tiko'q.</para>
  <chapter number="24" style="c" />
  <para style="q">
    <verse number="1" style="v" />Maawixowaaj kiwach i yiib' wach kina'ojb'al.</para>
  <para style="q">Eh maamol awiib' chi kixilak,</para>
  <para style="q">
    <verse number="2" style="v" />ruum re' keh xa re' i yiib' wach inkikapaaj rub'aan.</para>
  <para style="q">Eh xa chi riij i ma' holohik taj kiq'orik.</para>
  <para style="q">
    <verse number="3" style="v" />Re' jino'q i paat na'ojb'al iraaj noq inch'ikib'jik i raa',</para>
  <para style="q">eh na'ojb'al wo' raaj i rujohteesjiik johtoq.</para>
  <para style="q">
    <verse number="4" style="v" />Eh na'ojb'al raaj noq neenujik kipaam taqe i ru tahsaal paam i paat,</para>
  <para style="q">reh noq neen wihik i xa holohaq chik chi chib'ih jariik ar.</para>
  <para style="q">
    <verse number="5" style="v" />Re' winaq wilik runa'ojb'al, k'ih tz'aaq chuwach i kow riib'.</para>
  <para style="q">Re' i na'ojb'al k'ih tz'aaq chuwach i kowiil.</para>
  <para style="q">
    <verse number="6" style="v" />Noq imb'aan i q'aq'inik yej-amaj wach chi korik,</para>
  <para style="q">koruman chi wilik taqe i naakikojwiik na'ojb'al.</para>
  <para style="q">
    <verse number="7" style="v" />Re' i ma' nimanik taj, ma' rureq ta chik chi riij</para>
  <para style="q">i ruq'or noq inooj pa'lojoq pan q'atb'al q'orik,</para>
  <para style="q">ruum xama' xta wo' runa'ojb'al.</para>
  <para style="q">
    <verse number="8" style="v" />Awach i xa re' i jot'ooj i rukapaaj rub'aan,</para>
  <para style="q">i nelik rib'iral chi ma' holohik ta imb'anik.</para>
  <para style="q">
    <verse number="9" style="v" />Re' i ma' nimanik taj, xa re' i rub'aan i mahk wilik paruk'ux.</para>
  <para style="q">Eh ma' awach taj neenkuywik reh i runa'ojb'al i ma' holohik ta imb'anik.</para>
  <para style="q">
    <verse number="10" style="v" />Wila' xyoj ak'ux noq neenchalik i ti' k'axik cha naah,</para>
  <para style="q">ma' kow ta ak'ux.</para>
  <para style="q">
    <verse number="11" style="v" />Chako'leej taqe i q'atooj chik i q'orik chikinaah chi naa kikanteesjiik.</para>
  <para style="q">Chako'leej taqe i ojik inki a'n paruyohb'alil kimik,</para>
  <para style="q">
    <verse number="12" style="v" />atoob' ta neenaq'or i korik chi ma' aweht'al taj i xk'ularik.</para>
  <para style="q">Eh re' i naab'inik reh awánima reht'al mi korik inaq'or,</para>
  <para style="q">ruum re' reh nilwik aweh chib'ih i k'ahchi' kaat,</para>
  <para style="q">eh re' reh naa ruye'wiik jilow reh i ju'jun chib'ih i xub'an i xuq'or.</para>
  <para style="q">
    <verse number="13" style="v" />Hat wak'uun noq wilkaat, noq inawuk'ej i riis kaab' inawik'raaj ruki'iil.</para>
  <para style="q">Eh xasuq suq chik noq inik'ik qohoq pan awalaq.</para>
  <para style="q">
    <verse number="14" style="v" />Je' re' ki'iil noq naa a'nam rusuqkiil i holohik laj na'ojb'al, i holohik laj kapeew.</para>
  <para style="q">Eh wila' xareq chi riij taqe re' holohik naa awojiik wii'.</para>
  <para style="q">Eh re' ch'iklik reje wii' ak'ux, ma' jaruuj naa rusahchiik wach.</para>
  <para style="q">
    <verse number="15" style="v" />Maayejaa' wach i yiib' wach na'ojb'al chi jot'b'al reh i korik wach ruk'ux.</para>
  <para style="q">Eh maatukej wach i ruk'achariik parupaat.</para>
  <para style="q">
    <verse number="16" style="v" />Re' korik wach ruk'ux atoob' ta q'ehb'oq</para>
  <para style="q">wuquub'-oq pech panti' k'axik xa nee wo' rukuy ransil.</para>
  <para style="q">Eh re' i yiib' wach kina'ojb'al naa kikahniik panti' k'axik chi jumpech.</para>
  <para style="q">
    <verse number="17" style="v" />Mansuuqb'ik ak'ux noq nee ruk'ul i ti' k'axik,</para>
  <para style="q">eh noq neeruq'eb' riib' inixowanik awach,</para>
  <para style="q">
    <verse number="18" style="v" />ruum re' QaJaaw Dios ma' imponik ta chuwach i je' re'.</para>
  <para style="q">Eh chanaah-oq chik i hat nee ruyeew chee ti' k'axik.</para>
  <para style="q">
    <verse number="19" style="v" />Maa wuch'ihleej taqe i yiib' wach kina'ojb'al.</para>
  <para style="q">Eh maawixowaaj kiwach i ma' holohik ta kib'anik,</para>
  <para style="q">
    <verse number="20" style="v" />ruum re' i yiib' wach runa'ojb'al ma' holohik ta naa rojiik kuxoq wii'.</para>
  <para style="q">Eh naa rusahchiik wach, je' rukab' noq inooj chuhpoq i saqumb'al.</para>
  <para style="q">
    <verse number="21" style="v" />Hat wak'uun noq wilkaat, chayohleej i QaJaaw Dios je' wo' hoq i reey.</para>
  <para style="q">Eh maamol awiib' kuuk' i aj ixowaal,</para>
  <para style="q">
    <verse number="22" style="v" />ruum re' keh xanik' neensacharik kiwach.</para>
  <para style="q">Eh ma' awach ta neht'alinik reh</para>
  <para style="q">nik' wach i ti' k'axik naa ruye'ariik</para>
  <para style="q">cho chikinaah ruum i Dios, ruum i reey.</para>
  <para style="s">Re' wo' chik taqe wili xkiq'or i wilik kina'ojb'al</para>
  <para style="q">
    <verse number="23" style="v" />Re' taqe wilik kina'ojb'al je' wili i xkiq'or:</para>
  <para style="b" />
  <para style="q">Ma' ruyee ta riib' chi awach ineenpahqaljik i ti' k'axik chinaah pan q'atb'al q'orik.</para>
  <para style="q">
    <verse number="24" style="v" />Eh re' i ruq'or chi ma' xta ru mahk i wilik</para>
  <para style="q">ru mahk, ma' holohik ta kiq'orik i tinamit chi riij.</para>
  <para style="q">Eh ma' mponik ta chikiwach i nimaq tinamit.</para>
  <para style="q">
    <verse number="25" style="v" />Eh re' inye'wik chutojariik i ru mahk i aj mahk, ma' xta reet naa reliik.</para>
  <para style="q">Eh holohik inaakipahqaam i tinamit chi riij.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Awach i holohik ruchaq'weesjiik i rub'an inq'orarik reh,</para>
  <para style="q">je' naa jino'q tz'ub'uuj i ruyeew pan wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Cha a'n pee taqe ayak pantaq b'eeh,</para>
  <para style="q">cha a'n pee taqe akamaj panab'iix,</para>
  <para style="q">kora'j neenach'ik'aa' re' aak'achariik panapaat.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Maakoj ru mahk aawas achaaq' chi ma' xta rub'ehel.</para>
  <para style="q">Eh maatz'aq wach i q'orik chi riij.</para>
  <para style="q">
    <verse number="29" style="v" />Maaq'aj wach i ma' holohik taj imb'aan aweh.</para>
  <para style="q">Maa a'n jilow reh i yiib' wach i rub'an aweh i tokoom.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Re' hin xinik'ik parab'iix i sikil laj winaq,</para>
  <para style="q">xinik'ik wo' hoq aha' rutikim wii' ru-uuva i ma' xta runa'ojb'al.</para>
  <para style="q">
    <verse number="31" style="v" />Re' i xwilow ar, re' chi ma' k'isa k'iix i xpoq' paruye'aab'.</para>
  <para style="q">Eh re' i koraal ab'aj wilik naq chi riij i ruye'aab',</para>
  <para style="q">xtub'lujik chik wach ak'al.</para>
  <para style="q">
    <verse number="32" style="v" />Eh noq xwilow chi je' re' xnumol panukapeb'aal,</para>
  <para style="q">eh xnutijej i na'ojb'al wili:</para>
  <para style="q">
    <verse number="33" style="v" />Noq re' hat nee ti okik chi wirik neenatoq'aa' tahka'y,</para>
  <para style="q">neena q'ahcheej aaq'ab' chi' ak'ux nee ti okik chi' hi'lik.</para>
  <para style="q">
    <verse number="34" style="v" />Re' neb'a'il yohb'aal wach noq neenchalik cha naah, ma' nee ta chik inakuy,</para>
  <para style="q">je' rukab' i yiib' wach runa'ojb'al wilik rupuhb' pan q'ab'.</para>
  <chapter number="25" style="c" />
  <para style="s">Re' taqe wili re' ruuk' i holohik laj na'ojb'al i xuq'or i Salomón</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe wili re' wo' ruuk' i ruq'orom i reey Salomón. Re' i xkitz'ihb'aaj taqe i xi kamanik ruuk' i Ezequías, xwihik chi reyil Judá.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Noq wilik i molarik pan ánima ye'b'al ruloq'il i QaJaaw Dios.</para>
  <para style="q">Eh ye'b'al kiloq'il i reey wila' xelik wach.</para>
  <para style="q">
    <verse number="3" style="v" />Nik' najtiil wilik i taxaaj, eh nik' chamiil paam i wach ak'al</para>
  <para style="q">je' wo' re' chamiil paam kina'ojb'al taqe i reey, ma' awach ta neenq'atwik wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Wila' xawesaj i ch'uwa' chuwach i plata,</para>
  <para style="q">wilik neen kamanik wii' reh i aj ch'eyool, neeruyejaa' jino'q i holohik kulk chi reh.</para>
  <para style="q">
    <verse number="5" style="v" />Wila' xawesaj i yiib' wach runa'ojb'al parukamaj i reey,</para>
  <para style="q">re' i reey re' chik i rub'ehel neerub'an.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Maniimb'isaj i koq awiib' chuwach i reey.</para>
  <para style="q">Eh maamin awiib' pan kiye'aab' taqe i nimaq kiwach,</para>
  <para style="q">
    <verse number="7" style="v" />ruum ma' xta reet chi konee tikiq'o'reej chaloq noq nee tiooj,</para>
  <para style="q">chuwach chi neenak'uhtaaj ak'ixb'ilaal</para>
  <para style="q">chikiwach taqe i k'amal b'eeh.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Wila' chib'ih imb'aan aweh,</para>
  <para style="q">manooj lom ajal pan q'atb'al q'orik,</para>
  <para style="q">ruum mo'-oq chik neenareq chi riij chib'ih</para>
  <para style="q">i neena a'n noq ruk'uhtaam chik ak'ixb'ilaal aawas achaaq'.</para>
  <para style="q">
    <verse number="9" style="v" />Ma' xta reet chi neenako'leej awiib' chupaam amahk neenkikoj,</para>
  <para style="q">xa re' la' maaq'or i koq i rub'an chi q'eeqmaal i tokoom,</para>
  <para style="q">
    <verse number="10" style="v" />ruum awach-oq ib'irinik aweh, neeruk'uhtaaj ak'ixb'ilaal.</para>
  <para style="q">Eh re' yiib' wach nee ruq'or chawiij, ma' xata chik riq'omal i nee raaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' k'uhb'aal imb'aan paruorahiil, je' rukab' jino'q i mansano oro,</para>
  <para style="q">eh plata korjinaq wii' i ye'aab' reh.</para>
  <para style="q">
    <verse number="12" style="v" />Awach i runimaj i holohik laj k'uhb'aal imb'aan reh, je' jino'q lopq'aaq',</para>
  <para style="q">je' jino'q koyaar chi reh re' ruuk' manlik oro.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' taqareel korik wach ruk'ux, chi reh intaaq'anik reje reh,</para>
  <para style="q">je' rukab' noq i rujoot'isaj cho wach i tz'a'laj q'iij i mus jab'.</para>
  <para style="q">Eh i ruyeew rukowiil ruk'ux i rupatroon.</para>
  <para style="q">
    <verse number="14" style="v" />Awach i ruq'or chi wilik i naa ruye'em, eh xama' ruyeew ta wo' hoq,</para>
  <para style="q">xa je' rukab' i suutz', i teew ma' xta jab' i ruk'am chaloq.</para>
  <para style="q">
    <verse number="15" style="v" />Re' q'unil i rujoot'isaj wach i k'aah,</para>
  <para style="q">eh re' taqe i atoob' laj q'orik i rujoot'isaj wach i choqik.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Wila' xawaaj ayob'eem aweh i riis kaab',</para>
  <para style="q">maawik'saj naah ruk'uxariik,</para>
  <para style="q">ruum nee-oq wo' chik inaxab'ej cho ruka'peech.</para>
  <para style="q">
    <verse number="17" style="v" />Eh wila' ti ponik chi rula'jiik awamigo</para>
  <para style="q">mat'ooj ruuk' chi xa kok' xilak, ruum nee-oq inq'uhtik aweh.</para>
  <para style="q">Eh nee-oq intohq'ik rixowaam awach.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Awach i rutz'aq wach i q'orik chi riij i ras ruchaaq',</para>
  <para style="q">je' rukab' i tuhyb'al kalawux, je' rukab' i ch'ihch',</para>
  <para style="q">je' rukab' i flecha k'ul i q'as ju'.</para>
  <para style="q">
    <verse number="19" style="v" />Awach i panti' wilik, eh i ruch'ikaa' ruk'ux chinaah i yiib' wach na'ojb'al.</para>
  <para style="q">Re' re' je' naa toqeel jino'q i rooq, eh je' naa rub'an ruwa' chinaah i reeh hopeel.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Awach i rub'an rutz'uuy ruuk' i ti' ruk'ux,</para>
  <para style="q">i rub'an je' rukab' noq inkojarik i minagre chuwach i q'aah,</para>
  <para style="q">eh je' rukab' i rub'an i rut'usaa' riib' noq k'ahchi' i k'uxik.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Wila' i nixowanik awach inuhmik chayeew ruwa'.</para>
  <para style="q">Eh wila' chiqiij chii' chayeew ruhaa'.</para>
  <para style="q">
    <verse number="22" style="v" />Wila' je' re' i xa a'n reh, ma' k'isiin ta</para>
  <para style="q">neenchalik rukaaqb'iik i wach ruum i ruk'ixiik,</para>
  <para style="q">eh re' i QaJaaw Dios neen ye'wik jilow aweh i hat.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Re' i teew inchalik pantz'eet ree q'iij i ruk'am chaloq i jab'.</para>
  <para style="q">Eh ruum i yiib' wach q'orik inchalik ruyojiik i wachiis ruum i k'aah.</para>
  <para style="q">
    <verse number="24" style="v" />Ma' xta reet chi xa pan lahtz' paam paat neenpatinik i winaq,</para>
  <para style="q">chuwach chi pan nimlaj paat neenpatinik ruuk' jino'q ixoq xiik' naah josq'iil.</para>
  <para style="q">
    <verse number="25" style="v" />Re' taqe i holohaq q'orik kichalik chi najt yuuq'</para>
  <para style="q">je' rukab' i ha' injoot'isanik wach i chiq chi'iil.</para>
  <para style="q">
    <verse number="26" style="v" />Re' i ma' xta ru mahk inyo'jik chuwach i yiib' wach runa'ojb'al,</para>
  <para style="q">je' rukab' i kowlaj rooq ha', xa ch'uwa' chik wach.</para>
  <para style="q">
    <verse number="27" style="v" />Maawik'saj naah ruyoob'jiik i riis kaab'.</para>
  <para style="q">Eh maasik' runimaal awach cha wib'il awiib'.</para>
  <para style="q">
    <verse number="28" style="v" />Re' i winaq xa teheeh wach ruuk' i rub'an,</para>
  <para style="q">ma' xta ko'len reh, xa je' rukab' jino'q i tinamit q'ehb'inaq i tz'aq kotimaj wii' riij.</para>
  <chapter number="26" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' ha' chaaj ma' ruk'ul ta chi nchalik pan siq'jil, je' wo' i jab' pan jachb'al q'iij.</para>
  <para style="q">Je' wo' re' i ma' nimanik taj, ma' ruk'ul ta wo' chi neenye'arik ruloq'il.</para>
  <para style="q">
    <verse number="2" style="v" />Re' ma' holohik ta laj q'orik, ma' xta nokik wii'</para>
  <para style="q">xa je' rukab' i rupinik i rub'an i tz'unun,</para>
  <para style="q">k'ul inooj, xa je' rukab' i rub'an i tz'ikin siq'jil b'ih.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i kawáyu ruuk' tz'uhuum intiijik, eh re' i b'uurux</para>
  <para style="q">ink'amarik rub'eeh ruuk' i b'ak'b'al ju'.</para>
  <para style="q">Eh re' i ma' nimanik taj ruuk' q'ab' chee' intiijik.</para>
  <para style="q">
    <verse number="4" style="v" />Re' hat maak'ulaa' naah i ruq'or i ma' nimanik taj,</para>
  <para style="q">reh chi ma' nee ta ti kahnik chi je' rukab' i reh.</para>
  <para style="q">
    <verse number="5" style="v" />Ticholoq ruchaq'weesjiik i ma' nimanik taj,</para>
  <para style="q">reh chi neerureq chi riij chi ma' xta runa'ojb'al.</para>
  <para style="q">
    <verse number="6" style="v" />Awach i rutaq'aaj reje rutaqariik chi riij i ma' nimanik taj,</para>
  <para style="q">xa rusik' ruk'axkiil, je' naa ruyok' i rooq chi rib'il riib'.</para>
  <para style="q">
    <verse number="7" style="v" />Re' jino'q i siik taqe i rutuuq xama' nee ta wo' imb'ehik, ma' xta neenokik wii'.</para>
  <para style="q">Je' re' i ruq'oral i ma' nimanik taj xama' xta nokik wii'.</para>
  <para style="q">
    <verse number="8" style="v" />Re' ruye'ariik runimaal wach i ma' nimanik taj,</para>
  <para style="q">xa k'ixb'ilaal, xa je' rukab' noq inkutarik reje ab'aj ruuk' uuleh.</para>
  <para style="q">
    <verse number="9" style="v" />Re' jino'q i xohk'reel ma' riik'raaj taj noq intoq'arik ruum i k'iix.</para>
  <para style="q">Je' wo' re' i ruq'or i ma' nimanik taj xama' rureq ta wo' chi riij.</para>
  <para style="q">
    <verse number="10" style="v" />Re' impeletohinik ruuk' flecha, i rub'aan keh chu'nchel i ki-ik'ik chuwach,</para>
  <para style="q">eh re' re' inye'wik rukamaj i ma' nimanik taj.</para>
  <para style="q">
    <verse number="11" style="v" />Re' i ma' nimanik taj, noq inooj wo' chik rub'an i ruyiib' wach na'ojb'al.</para>
  <para style="q">I rub'an reh je' rukab'rub'an i tz'i' noq i ruk'ux wo' chik ruka'peech i ruxab'iik</para>
  <para style="q">
    <verse number="12" style="v" />Saqb'ih i ma' nimanik taj chuwach</para>
  <para style="q">i wilik runa'ojb'al i rub'an riib' wila' ma' nimanik.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' sikil laj winaq, xa chib'ih i rutz'aq wach,</para>
  <para style="q">i ruq'or chi naa ruk'uxariik ruum i kaq b'ahlam pamb'eeh.</para>
  <para style="q">
    <verse number="14" style="v" />Re' puerta reh xa chinaah i ch'ilaab' reh i rusutej riib',</para>
  <para style="q">je' wo' re' i sikil laj winaq reh xa wach ruch'aht i rusutej riib'.</para>
  <para style="q">
    <verse number="15" style="v" />Re' xiik' naah sikilal atoob' ta wo' naq tuqlik i ruwa' chuwach,</para>
  <para style="q">ni xata ruk'uxariik iraaj ruum i sikilal.</para>
  <para style="q">
    <verse number="16" style="v" />Re' sikiil i rukapaaj i chi q'e' wilik runa'ojb'al chikiwach</para>
  <para style="q">i wuquub'-oq chi winaq i kichol kojooj na'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Awach i rumin riib' ruuk' i rupeleto i tokoom,</para>
  <para style="q">je' naa k'ahchi' ruchopom kab'chel i xikin i josq'laj tz'i'.</para>
  <para style="q">
    <verse number="18" style="v" />Re' yohb'aal wach josq'iil, xa je' chik ahqaal</para>
  <para style="q">i rukutib'eej taqe i flecha kanteesb'al qoplik ruq'aq'al.</para>
  <para style="q">
    <verse number="19" style="v" />Je' wo' re' i rub'an awach i rujot' i ramigo,</para>
  <para style="q">eh noq inooj kuxoq xa sa'al wo' naq weh, inki tii chik.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Re' q'aaq' noq ma' xta chik rusi'il, inchuhpik.</para>
  <para style="q">Eh re' i peleto imahyik noq imahyik i tz'aqaj wach q'orik.</para>
  <para style="q">
    <verse number="21" style="v" />Re' aaq'ut re' inkahnik chinaah wach q'aaq', eh re' i sii' re' inqopwik reh i q'aaq'.</para>
  <para style="q">Eh re' i peleto re' i josq'iil inuhtisanik wach.</para>
  <para style="q">
    <verse number="22" style="v" />Re' i tz'aqal wach k'utaaj xasuq chik reh aha' wilik taqe i ruq'or,</para>
  <para style="q">eh imponik kopan ránima.</para>
  <para style="q">
    <verse number="23" style="v" />Eh chi reh i holohik laj q'orik i yiib' wach runa'ojb'al, i rutz'ap naah,</para>
  <para style="q">je' rukab' noq tz'aparik riij aak'al xun noq iniq'oomjik riij.</para>
  <para style="q">
    <verse number="24" style="v" />Awach imb'anik ixowaal, holohik tii chik inq'orik i rub'an riib'.</para>
  <para style="q">Xanaah re', k'ahchi' ruyejaam cho wach i jot'ooj paránima.</para>
  <para style="q">
    <verse number="25" style="v" />Re' re' manimaj reh atoob' ta xasuq chik neetiruq'o'reej,</para>
  <para style="q">ruum re' reh nujinaq chaloq i yiib' wach parukapeb'aal.</para>
  <para style="q">
    <verse number="26" style="v" />Atoob' ta naq inche nee rukeb'aa' ixowaal i rub'an,</para>
  <para style="q">re' i ruyiib' wach na'ojb'al i xanaa wo' reliik wach saqum chikiwach chu'nchel.</para>
  <para style="q">
    <verse number="27" style="v" />Re' ink'otwik reh i chaamlaj jul, xa re' wo' reh inq'ehb'ik chupaam.</para>
  <para style="q">Eh re' i rutolej i nimlaj ab'aj xa re' wo' reh inch'eyarik paam ruum.</para>
  <para style="q">
    <verse number="28" style="v" />Re' i chukul q'orik ma' raaj ta wach i korik.</para>
  <para style="q">Eh re' i yiib' wach inq'orik inq'eb'wik panti' k'axik.</para>
  <chapter number="27" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' hat maa ch'ikaa' ak'ux chinaah i q'iij iqal,</para>
  <para style="q">ruum ma' aweht'al taj chib'ih i k'axik nee ruk'am chaloq.</para>
  <para style="q">
    <verse number="2" style="v" />Ma' xta reet chi tokoom neen ye'wik runimaal awach,</para>
  <para style="q">chuwach chi nee nayeew runimaal awach i hat cha wib'il awiib'.</para>
  <para style="q">
    <verse number="3" style="v" />Korik noq re' ab'aj, re' i saniib' ma' nkuyjik ta kahliil.</para>
  <para style="q">Eh re' i rujosq'iil i ma' nimanik taj, xti ma' nkuyjik ta wo' chik.</para>
  <para style="q">
    <verse number="4" style="v" />Re' kaqrik ma' holohik taj, je' wo' moloj k'aah, re' taqe re' inyojwik k'uxliis.</para>
  <para style="q">Eh re' i kaqwachiil xti ma' nkuyjik ta wo' chik.</para>
  <para style="q">
    <verse number="5" style="v" />Ma' xta reet chi panaq'wach neenaq'il jino'q,</para>
  <para style="q">chuwach chi nak'ax tii chik neena a'n awiib',</para>
  <para style="q">
    <verse number="6" style="v" />ruum ma' xta reet amígo chi pan korik neerub'an i q'ilooj.</para>
  <para style="q">Ma' je' ta rukab' i aj ixowaal, ink'axwik tii chik i rub'an riib'.</para>
  <para style="q">
    <verse number="7" style="v" />Awach i nujinaq, ni xata re' chik i riis kaab' nee raaj ruyob'em.</para>
  <para style="q">Eh re' i ma' k'isiin ta nuhmik atoob' ta</para>
  <para style="q">nik' k'ahiil i neeruk'ux, xa ki' wo' neerik'raaj.</para>
  <para style="q">
    <verse number="8" style="v" />Awach i ruq'eb' kahnoq i ruye'aab' aasjinaq wii',</para>
  <para style="q">i ruk'ul reh je' rukab' i ruk'ul i tz'ikin najt ruuk' i rusuuq' rupinik i rub'an ponoq.</para>
  <para style="q">
    <verse number="9" style="v" />Re' aseite, re' ink'ohnik laj iq'oom q'e' suq i rub'an,</para>
  <para style="q">reh i ánima koruman chi naa rukojom i na'ojb'al jino'q i atoob' laj amígo.</para>
  <para style="q">
    <verse number="10" style="v" />Re' hat, maa q'eb' taqe awamigo, je' wo' taqe ramigo aawajaaw.</para>
  <para style="q">Eh manooj ak'utjaaj aak'axkiil parupaat aawas,</para>
  <para style="q">ruum ma' xta reet chi neenaq'or reh jino'q aka'jaah,</para>
  <para style="q">chuwach chi neenaq'or reh aawas xanajt awuuk'.</para>
  <para style="q">
    <verse number="11" style="v" />Hat wak'uun noq wilkaat, wilik-oq ana'ojb'al, reh chi nee nasuuqb'isaj nuk'ux.</para>
  <para style="q">Eh nee kinchol kichaq'weesjiik i kib'ajwik weh.</para>
  <para style="q">
    <verse number="12" style="v" />Re' i wilik runa'ojb'al i rukoj rehtaal i yohb'aal, i rukotej riij.</para>
  <para style="q">Eh re' i ma' xta runa'ojb'al, ma' rukoj ta rehtaal, inq'ehb'ik chupaam.</para>
  <para style="q">
    <verse number="13" style="v" />Re' i ma' xta runa'ojb'al inooj ruyeew i ruq'oral chi riij i aj k'aas,</para>
  <para style="q">eh wila' ma' xutoj i ruk'ul chi neenq'ucharik reh i ruso'.</para>
  <para style="q">
    <verse number="14" style="v" />Awach i ruk'er reje chii ko wahq'eq chuye'ariik rusuqkiil ruk'ux i ramigo.</para>
  <para style="q">Re' i ramigo ruum rub'ajariik imb'aan noq nee ruq'or.</para>
  <para style="q">
    <verse number="15" style="v" />Re' jino'q iixoq xiik' naah josq'iil,</para>
  <para style="q">je' rukab' jino'q i kojweel nah paat xa t'uruj cho riib' paruq'ijil jab'.</para>
  <para style="q">
    <verse number="16" style="v" />Re' re' ma' awach ta neenpaab'anik reh i rujosq'iil,</para>
  <para style="q">je' rukab' i teew, je' rukab' aseite ma' nee ta rub'an chi neenchoparik paam.</para>
  <para style="q">
    <verse number="17" style="v" />Re' ch'ihch' ruuk' wo' ch'ihch' injuk'arik,</para>
  <para style="q">je' wo' re' i winaq ruch winaq wo' naa rukojwiik runa'ojb'al.</para>
  <para style="q">
    <verse number="18" style="v" />Awach incha'jinik reh i higo i ruk'ux wo' reh i ruwachuj.</para>
  <para style="q">Awach i runimaj chi korik i rupatroon nee wo' nk'axarik ruum i rupatroon.</para>
  <para style="q">
    <verse number="19" style="v" />Re' winaq noq i rilow i wach panha' i runab'eej nik' wach inka'yik,</para>
  <para style="q">je' wo' re' noq i naab'jik ruum i tokoom chib'ih wilik cho paránima i ju'jun.</para>
  <para style="q">
    <verse number="20" style="v" />Re' kimik, re' i rujuleel kamnaq xama' jaruuj wo' neenujik.</para>
  <para style="q">Je' wo' re' i ruk'ul i winaq ruuk' taqe i ruk'ax wach,</para>
  <para style="q">xama' jaruuj wo' inch'iklojik ruk'ux.</para>
  <para style="q">
    <verse number="21" style="v" />Re' oro, i plata ruuk' q'aaq' inehteesjik i ruch'uwa'il wach.</para>
  <para style="q">Eh re' i winaq, ink'utinik i runa'ojb'al noq inye'arik runimaal wach.</para>
  <para style="q">
    <verse number="22" style="v" />Re' i ma' nimanik taj nik' ta naq wach i ma' k'isa ti' k'axik neena a'n</para>
  <para style="q">reh xama' nee ta wo' rukanaa' rub'aan i ruyiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="23" style="v" />Re' hat chawilow chi korik taqe atentzuun,</para>
  <para style="q">k'oloq panak'ux chu'nchel i aachikoop.</para>
  <para style="q">
    <verse number="24" style="v" />Eh chakoj rehtaal chi ni xata re' taqe b'ehomal,</para>
  <para style="q">ni xata re' i corona naa ruwihiik chi juneliik.</para>
  <para style="q">
    <verse number="25" style="v" />Noq re' ch'ahn impoq' chaloq ink'ihik johtoq,</para>
  <para style="q">eh insik'arik wa taq yuuq' chi kiwa' i chikop.</para>
  <para style="q">
    <verse number="26" style="v" />Re' kiij aatentzuun, neenakem chi aso'.</para>
  <para style="q">Eh re' i tz'aaq aa imas kaprax neen kamanik aweh chi loq'b'al awak'aal.</para>
  <para style="q">
    <verse number="27" style="v" />Re' taqe ixoq kaprax neen kiyeew alécha,</para>
  <para style="q">reh chi neenak'uxlaaj awiib' i hat, je' wo' taqe awach aweh.</para>
  <para style="q">Eh ruuk' re' neenak'uxlaaj taqe awaj kamanoom.</para>
  <chapter number="28" style="c" />
  <para style="s">Re' q'orik chi riij i k'ihwach chi na'ojb'al</para>
  <para style="p">
    <verse number="1" style="v" />Re' yiib' wach runa'ojb'al i rumol chi elik atoob' ta ma' awach najiminik reh.</para>
  <para style="b" />
  <para style="q">Eh re' i korik wach ruk'ux ma'yo'jiktaj je' rukab' i kaq b'ahlam.</para>
  <para style="q">
    <verse number="2" style="v" />Eh noq ma' k'isiin chik i ti' k'axik chupaam i tinamit inkihaaxb'ik ajaab'ees chinaah.</para>
  <para style="q">Eh re' ajaab'ees wilik runa'ojb'al inchol ruk'amariik rub'eeh i tinamit.</para>
  <para style="q">
    <verse number="3" style="v" />Re' yiib' wach runa'ojb'al i relq'aaj i chib'ih reh i neb'aa',</para>
  <para style="q">je' rukab' i kowlaj jab' i rusachib'eej kiwach i tik.</para>
  <para style="q">
    <verse number="4" style="v" />Awach inkikanaa' runimjiik i k'uhb'aal, inkiyeew ruloq'il i yiib' wach runa'ojb'al.</para>
  <para style="q">Eh awach inkinimaj i k'uhb'aal ma' nkian ta jinaj wach kik'ux ruuk'.</para>
  <para style="q">
    <verse number="5" style="v" />Re' taqe yiib' wach kina'ojb'al ma' nkireq ta chi riij i korik.</para>
  <para style="q">Eh re' taqe kisik'wik reh i rotob'il i QaJaaw Dios, inkireq chi riij chu'nchel.</para>
  <para style="q">
    <verse number="6" style="v" />Ma' xta reet chi xa neb'aa' tii jino'q, xa re' la' korik-oq wach ruk'ux.</para>
  <para style="q">Xa ma' xta nkih chi b'ehoom jino'q wila' xa re' ileq' iraaj.</para>
  <para style="q">
    <verse number="7" style="v" />Awach i runimaj i ruk'uhb'aal i QaJaaw Dios, jinaj ak'uunb'ees wilik runa'ojb'al.</para>
  <para style="q">Eh awach i xa chi kixilak i xakitusik inwihik, i ruk'uhtaaj ruk'ixb'ilaal i rajaaw.</para>
  <para style="q">
    <verse number="8" style="v" />Awach i rumol wach i rub'ehomal ruuk' i tojb'al riij i rutumiin,</para>
  <para style="q">re' i rub'ehomal, reh inketelinik kiwach i neb'aa' naa rukanaam.</para>
  <para style="q">
    <verse number="9" style="v" />Awach i ma' raaj ta rib'iram i ruk'uhb'aal i QaJaaw Dios,</para>
  <para style="q">ma' naa ta wo' rib'iirjiik rutiij i reh.</para>
  <para style="q">
    <verse number="10" style="v" />Awach ink'amwik keh i chupaam i yiib' wach b'eeh i holohik kina'ojb'al,</para>
  <para style="q">re' wo' reh naa ruq'eb'em riib'.</para>
  <para style="q">Re' i korik wach kik'ux keh, holohik naa kojiik wii'.</para>
  <para style="q">
    <verse number="11" style="v" />Re' b'ehoom, xa wilik chik runa'ojb'al i rub'an riib'.</para>
  <para style="q">Eh re' i neb'aa' reh korik chi wilik runa'ojb'al i rusik' chi riij mi re' i rub'an.</para>
  <para style="q">
    <verse number="12" style="v" />Noq kielik korik ruuk' inki a'n i korik wach kik'ux inwihik i nimlaj ninq'iij.</para>
  <para style="q">Eh noq kielik korik taqe i yiib' wach kina'ojb'al inkikeb'aa' kiib' i tinamit.</para>
  <para style="q">
    <verse number="13" style="v" />Awach i rukeb'aa' ru mahk, ma' nata reliik korik.</para>
  <para style="q">Eh awach i rupahqaaj kuyb'al ru mahk, eh i rukanaa'</para>
  <para style="q">chu'nchel, re' reh naa rukuyariik i ru mahk.</para>
  <para style="q">
    <verse number="14" style="v" />Atoob' reh awach i eliik i ruyohleej i QaJaaw Dios.</para>
  <para style="q">Eh awach i q'e' kow i naah naa rojiik q'ehb'oq panti' k'axik.</para>
  <para style="q">
    <verse number="15" style="v" />Re' yiib' wach runa'ojb'al xa je' chik josq'laj kaq b'ahlam.</para>
  <para style="q">Eh xa je' chik josq'laj oso noq inokik chi ajaab'ees chinaah i tinamit xa neb'aa' tii.</para>
  <para style="q">
    <verse number="16" style="v" />Re' ajaab'ees ma' xta runa'ojb'al inuhtik wach i ti' k'axik ruum.</para>
  <para style="q">Eh re' i ma' k'axal ta wach b'ehomal naa runajtb'iik rooq i ruk'achariik.</para>
  <para style="q">
    <verse number="17" style="v" />Awach i rukansaj i ras ruchaaq' ma' naa ta ruko'leem riib' korehtaal inooj kimoq.</para>
  <para style="q">Eh ma' awach ta naa ruko'liniik reh</para>
  <para style="q">
    <verse number="18" style="v" />Re' i korik wach ruk'ux naa ruko'ljiik.</para>
  <para style="q">Eh re' i ma' holohik ta imb'anik naa rojiik q'ehb'oq panti' k'axik.</para>
  <para style="q">
    <verse number="19" style="v" />Awach i rutik paam i ruye'aab' i rub'an ruwa' ruhaa' chi korik.</para>
  <para style="q">Eh awach i xa re' b'ehik iraaj chi kixilak i sub'ul q'iij,</para>
  <para style="q">runimaal neb'a'il i naa ruchaliik chinaah.</para>
  <para style="q">
    <verse number="20" style="v" />Awach i korik wach ruk'ux naa ruye'ariik runimaal wach.</para>
  <para style="q">Eh awach i xa re' b'ehomal i ruk'ax wach naa ruye'ariik chutojariik i ru mahk.</para>
  <para style="q">
    <verse number="21" style="v" />Ma' toob' taj chi wilik i tokoom rilariik neenb'aan,</para>
  <para style="q">ruum xa ruuk' i junk'uux chi wi'k neeruq'eb' riib' jino'q.</para>
  <para style="q">
    <verse number="22" style="v" />Re' k'axal wach b'ehomal xa ruchop chik ruk'ux chi naa rub'ehomb'riik lom.</para>
  <para style="q">Eh ma' reht'al tee reh chi neb'a'il i naa ruchaliik chinaah.</para>
  <para style="q">
    <verse number="23" style="v" />Eh noq inooj kuxoq re' inkiyeew runimaal wach i pan korik i rub'an i q'ilooj,</para>
  <para style="q">chuwach i xa re' i ch'ool i rub'an.</para>
  <para style="q">
    <verse number="24" style="v" />Awach i relq'aaj chib'ih reh i rutuut rajaaw, eh ruwech'uj riij chi ma' xta ru mahk,</para>
  <para style="q">eliik kiwach ruuk' i yohb'aal wach ru mahk.</para>
  <para style="q">
    <verse number="25" style="v" />Re' i ruk'ax wach b'ehomal xa peleto rutik.</para>
  <para style="q">Eh awach i ruyeew ruk'ux ruuk' i QaJaaw Dios i nelik korik ruuk' i rub'an.</para>
  <para style="q">
    <verse number="26" style="v" />Awach i ruyeew ruk'ux chinaah taqe i rukapaaj, re' re' ma' nimanik taj.</para>
  <para style="q">Eh awach i wilik runa'ojb'al, naa ruko'leem riib' chi korik.</para>
  <para style="q">
    <verse number="27" style="v" />Awach irutoob'eej i neb'aa' naa ruwihiik chib'ih reh chi manlik.</para>
  <para style="q">Eh awach i ma' rutoob'eej taj i neb'aa' ma' k'isiin i ti' naa ruchaliik chinaah.</para>
  <para style="q">
    <verse number="28" style="v" />Eh noq kielik korik i yiib' wach kina'ojb'al,</para>
  <para style="q">inkikeb'aa' kiib' i korik wach kik'ux.</para>
  <para style="q">Eh noq kiooj q'ehb'oq i yiib' wach kina'ojb'al</para>
  <para style="q">inkimol wo' chik kiib' i korik wach kik'ux.</para>
  <chapter number="29" style="c" />
  <para style="q">
    <verse number="1" style="v" />Awach i rukoowb'isaj i naah noq inq'ilarik, jumehq'iil naa rojiik sahchoq wach.</para>
  <para style="q">Ma' xata chik riq'omal i naa rajwaam.</para>
  <para style="q">
    <verse number="2" style="v" />Noq wilkeeb' chi taaq'anik i korik wach kik'ux, insuuqb'ik kik'ux i tinamit.</para>
  <para style="q">Eh noq wilkeeb' chi taaq'anik i yiib' wach kina'ojb'al, intiib'ik kik'ux i tinamit.</para>
  <para style="q">
    <verse number="3" style="v" />Re' ak'uunb'ees wilik runa'ojb'al, i ruyeew rusuqkiil ruk'ux i rajaaw.</para>
  <para style="q">Eh re' i xa re' i wihik kuuk'k'oyoom laj ixoq iraaj, naa rusacham wach i chib'ih reh.</para>
  <para style="q">
    <verse number="4" style="v" />Re' reey re' i rub'ehel i rub'an, i ruyejaa' i rutinamiit.</para>
  <para style="q">Eh re' i reey xa re' i tooj i rupahqaaj, i ruyeew panti' i rutinamiit.</para>
  <para style="q">
    <verse number="5" style="v" />Awach q'e' ruyeew runimaal wach i ramigo xti korik</para>
  <para style="q">noq xa je' naa xirob' i k'ahchi' rukojom parub'eeh.</para>
  <para style="q">
    <verse number="6" style="v" />Re' xirob' i rukoj parub'eeh i yiib' wach runa'ojb'al re' taqe i ru mahk.</para>
  <para style="q">Eh re' korik wach ruk'ux naa ruk'achariik pansuqkiil.</para>
  <para style="q">
    <verse number="7" style="v" />Re' i korik wach ruk'ux i rutoob'eej i neb'aa' ruuk' i ruk'axkiil.</para>
  <para style="q">Eh re' i yiib' wach runa'ojb'al ma' xta raaj reh i neb'aa'.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taqe tuken wachiis inkuhtisaj wach i ruk'aah i tinamit.</para>
  <para style="q">Eh re' taqe i wilik kina'ojb'al kichol rujot'eesjiik wach i k'aah.</para>
  <para style="q">
    <verse number="9" style="v" />Re' i wilik runa'ojb'al i rutik'aa' peleto ruuk' i ma' nimanik taj,</para>
  <para style="q">ruk'uhtaaj ruk'ixb'ilaal.</para>
  <para style="q">
    <verse number="10" style="v" />Re' taqe i kansan kas kichaaq' inkixow wach i holohik kina'ojb'al.</para>
  <para style="q">Eh re' taqe i korik wach kik'ux inkisik' rusuqkiil kik'ux.</para>
  <para style="q">
    <verse number="11" style="v" />Re' i ma' nimanik taj, xa re' josq'iil i rub'an.</para>
  <para style="q">Eh re' i wilik runa'ojb'al reh, i rub'an ruq'ilariik riib'.</para>
  <para style="q">
    <verse number="12" style="v" />Re' i wilik chi ajaab'ees i runimaj taqe i chukuj q'orik,</para>
  <para style="q">chu'nchel i kikamanik ruuk' kikahnik chi yiib' wach i kina'ojb'al.</para>
  <para style="q">
    <verse number="13" style="v" />Re' neb'aa' ruch'ihil imb'anik ti' k'axik reh jinaj kiwach,</para>
  <para style="q">ruum re' wo' i QaJaaw Dios inye'wik rusaqumaal inaq'kiwach kikab'cheel.</para>
  <para style="q">
    <verse number="14" style="v" />Re' i reey parub'ehel intaaq'anik chikinaah taqe neb'aa'</para>
  <para style="q">naa ruwihiik chi taaq'anik chi juneliik.</para>
  <para style="q">
    <verse number="15" style="v" />Re' ak'uunb'ees ruuk' tz'uhuum naa ruq'ilariik.</para>
  <para style="q">Eh re' ak'uunb'ees ma' ntiijik taj, i ruk'uhtaaj ruk'ixb'ilaal i rutuut.</para>
  <para style="q">
    <verse number="16" style="v" />Noq k'ih chik i yiib' wach kina'ojb'al, inuhtik wach i mahk.</para>
  <para style="q">Eh, re' i korik wach kik'ux naakilom chi ma' naa ta keliik korik taqe re'.</para>
  <para style="q">
    <verse number="17" style="v" />Chatijej aawak'uun reh chi nee ruyeew rusuqkiil ak'ux,</para>
  <para style="q">eh neemponik chawach taqe i neerub'an.</para>
  <para style="q">
    <verse number="18" style="v" />Noq ma' re' tee Dios ink'amwik rub'eeh i tinamit ma' suq taj i ruk'achariik.</para>
  <para style="q">Eh re' tinamit inimanik reh i ruk'uhb'aal i Dios suq naa ruwihiik.</para>
  <para style="q">
    <verse number="19" style="v" />Re' i móso minooj pankamanik, ma' xata ruuk' q'orik naa rutijiik,</para>
  <para style="q">ruum nee wo' naq irib'iraj, xa re' la' ma' nee ta wo' rub'an.</para>
  <para style="q">
    <verse number="20" style="v" />Saqb'ih i ma' nimanik taj chuwach</para>
  <para style="q">jino'q i xa teheeh wach chi q'orik.</para>
  <para style="q">
    <verse number="21" style="v" />Awach i ma' rutijej ta paruk'isinal i rumoso xaruloq'om,</para>
  <para style="q">ma' naa ta chik rukuyum i naa rub'aan reh na' ohoq kuxoq.</para>
  <para style="q">
    <verse number="22" style="v" />Awach i ma' k'isiin ta josq'iil, eh xa teheeh wach, xa re' tikij peleto iraaj.</para>
  <para style="q">Re' re' ma' k'isiin taqe i mahk i ruq'eb' wii' riib'.</para>
  <para style="q">
    <verse number="23" style="v" />Awach i nim wach i rub'an riib' inehteesjik i runimaal wach.</para>
  <para style="q">Eh awach i ma' nim ta wach i rub'an riib' inye'arik runimaal wach.</para>
  <para style="q">
    <verse number="24" style="v" />Awach inokik haa' chi i leq' ruuk' i ajileq', xa re' reh rixowaaj riib',</para>
  <para style="q">ruum atoob' ta naq kow neenpahqaljik reh xama' ruq'or ta wo' hoq.</para>
  <para style="q">
    <verse number="25" style="v" />Re' ruyohljiik i xa winaq, xa je' jinaj xirob'.</para>
  <para style="q">Eh awach i ruyeew ruk'ux ruuk' i QaJaaw Dios, re' wo' reh neenko'linik reh.</para>
  <para style="q">
    <verse number="26" style="v" />Ma' k'isiin taqe i re' i rotob'il i wilik chi ajaab'ees inkisik', xanaah re',</para>
  <para style="q">xa re' wo' QaJaaw Dios inq'atwik i q'orik chikinaah i tinamit.</para>
  <para style="q">
    <verse number="27" style="v" />Re' i korik wach kik'ux ma' imponik ta chikiwach i yiib' wach kina'ojb'al.</para>
  <para style="q">Eh re' i yiib' wach kina'ojb'al ma' mponik ta chikiwach i korik wach kik'ux.</para>
  <chapter number="30" style="c" />
  <para style="s">Re' taqe xuq'or i Agur</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe xuq'or i Agur, rak'uun i Jaqué, eh Masa b'ih i rutuut. Re' Agur xuq'oreej i Itiel ruch'ihil i Ucal, je' wili xuq'or keh:</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' hin xti korik chi xiik' naah numemil, ni xata naq wilik nuna'ojb'al,</para>
  <para style="q">je' rukab' i kina'ojb'al i winaq.</para>
  <para style="q">
    <verse number="3" style="v" />Re' hin ma' nutijem ta nuna'ojb'al,</para>
  <para style="q">ni xata naq weht'al nik' wach noq wilik, i wilik rusantohiil.</para>
  <para style="q">
    <verse number="4" style="v" />¿Awach i xponik pan taxaaj xqajik wo' chik chaloq?</para>
  <para style="q">¿Awach i neerub'an rupa'ab'jiik i teew xa ruuk' q'ab'?</para>
  <para style="q">¿Awach i neerub'an rub'urariik naah i palaw xa ruuk' i rub'urb'aal?</para>
  <para style="q">¿Awach xye'wik paruye'aab' i wach ak'al?</para>
  <para style="q">Wila' aweht'al cha q'or weh chih b'ih, eh chih b'ih i rak'uun.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' QaJaaw Dios i ruko'leej taqe inkiyeew kik'ux ruuk'.</para>
  <para style="q">Eh chu'nchel ruq'oral saq wach.</para>
  <para style="q">
    <verse number="6" style="v" />Eh maatiq naah taqe i ruq'oral reh chi ma' nee ta tiruq'il chi kow,</para>
  <para style="q">eh ma' nee ta ti kahnik chi chukul q'orik chuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />QaJaaw Dios, re' hin xakiib' i nupahqaaj aweh,</para>
  <para style="q">inwaaj chi nee nayeew weh noq komajaa' kinkimik, re' taqe wili:</para>
  <para style="q">
    <verse number="8" style="v" />Re' chi chawesaj i chi nuwach ma' korik taj i chukuj q'orik.</para>
  <para style="q">Eh chi maayeew weh i b'ehomal, ni xata re' neb'a'il,</para>
  <para style="q">xa re' la', chayeew weh i nuwa' nuhaa' rajlaal i q'iij,</para>
  <para style="q">
    <verse number="9" style="v" />ruum wi xqohxanik i chib'ih weh, nee-oq i nuq'or chi ma' weht'al ta wach.</para>
  <para style="q">Eh mi ma' chih wilik weh nee-oq inutoq'aa' i leq',</para>
  <para style="q">chi je' re' neenuyeew chi b'ajarik i loq'laj ab'ihnaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Maakoj i koq ru mahk chuwach i rupatroon i minooj pankowlaj kamanik,</para>
  <para style="q">ruum neerupahqaaj i ti' k'axik cha naah, eh nee wo' nak'ul.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Wilik taqe i ma' holohik ta k'isinoq</para>
  <para style="q">kiq'orik chi riij i kituut kajaaw.</para>
  <para style="q">
    <verse number="12" style="v" />Wilik taqe i xasaq chik wach i kánima inki a'n kiib',</para>
  <para style="q">xanaah re' xakomajaa' ta wo' inkesaj i ruch'uwa'iil wach i kánima.</para>
  <para style="q">
    <verse number="13" style="v" />Wilik taqe i nimaq kiwach inki a'n kiib'.</para>
  <para style="q">Eh ma' imponik ta panaq'kiwach i kas kichaaq'.</para>
  <para style="q">
    <verse number="14" style="v" />Wilik taqe i xa je' chik q'aslaj ch'ihch' i rukaa' keeh,</para>
  <para style="q">xa je' chik q'as ju' ch'ihch' i wach keeh,</para>
  <para style="q">ruum inkaaj kisacham wach i chib'ih keh i neb'aa' wilkeeb' panqatinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Re' keh je' kikab' i chikop intz'ub'inik kik' ki'ib' i rixq'uun wilik,</para>
  <para style="q">xa chaloq i xa chib'ih jariik inkiq'or,</para>
  <para style="q">je' kikab' i kijib' chi xa chib'ih jariik ma' jaruuj kinuujik.</para>
  <para style="q">
    <verse number="16" style="v" />Re' taqe wili: Re' i kijuleel kamnaq,</para>
  <para style="q">re' iixoq ma' nwihik ta ruha'lak'uun,</para>
  <para style="q">re' i chiqiij laj ak'al ma' manlooj ta reh i ha',</para>
  <para style="q">re' q'aaq' i ma' i manlojik ta reh i ruk'at.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Awach i ma' suq ta rilariik i rajaaw i rub'an, eh noq rijib' chik i rutuut,</para>
  <para style="q">ma' imponik ta panaq'wach.</para>
  <para style="q">Re' re' i ruk'ul naq chi neenehteesjik inaq'wach ruum i nimaq taq tz'ok,</para>
  <para style="q">oon chi neen k'uxarik ruum i xihk.</para>
  <para style="q">
    <verse number="18" style="v" />Re' hin kijib' wach i na'ojb'al insahchik nuk'ux inki a'n</para>
  <para style="q">eh ma' nureq ta chi riij.</para>
  <para style="q">
    <verse number="19" style="v" />Re' taqe wili: Re' chi nik' wach noq inrupinik i xihk pan taxaaj,</para>
  <para style="q">re' chi nik' wach noq imb'ehik i aaq' panab'aj,</para>
  <para style="q">re' chi nik' wach noq imb'ehik i barco chinaah i palaw,</para>
  <para style="q">re' chi nik' wach noq inokrik i winaq chi riij iixoq.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Re' k'oyoom laj ixoq</para>
  <para style="q">noq rub'anam chik i mahk xa ruyejaa' chik riib',</para>
  <para style="q">eh xti ruq'or i korik chi ma' xtaj i yiib' wach xub'an.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Kijib' b'uhr wach i tinamit xti ma' nkuyjik taj i kina'ojb'al,</para>
  <para style="q">inkiyeew panyohb'aal i tinamit.</para>
  <para style="q">
    <verse number="22" style="v" />Re' taqe wili: Re' noq inkahnik chi reey i xa minooj pankowlaj kamanik,</para>
  <para style="q">re' noq inqohxanik i ruwa' ruhaa' i xa meem tii wach.</para>
  <para style="q">
    <verse number="23" style="v" />Re' chi rureq rub'ahiil iixoq ma' ajwaal ta wach,</para>
  <para style="q">re' chi re' ixoq xa aj poh noq inkahnik chi jilow i rupatroon ixoq.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Kijib' b'uhr kiwach taqe kok' chikop wilkeeb' wach ak'al</para>
  <para style="q">q'e' wilik kina'ojb'al chikiwach i tinamit wilik kina'ojb'al.</para>
  <para style="q">
    <verse number="25" style="v" />Re' taqe wili: Re' taqe i sinik xiik' naah kik'ihaal</para>
  <para style="q">atoob' ta ma' chih kaansil, inkimol wach i kiwa' pan siq'jil.</para>
  <para style="q">
    <verse number="26" style="v" />Re' taqe i k'ih laj imul inki a'n ruyejeb'jiik i kisuuq'</para>
  <para style="q">chupaam taqe i ruhopil ab'aj.</para>
  <para style="q">
    <verse number="27" style="v" />Re' taqe i nimaq chili'l atoob' ta ma' xta kireey,</para>
  <para style="q">xa tuslik la' chik kiwach noq kirupinik reje pan taxaaj.</para>
  <para style="q">
    <verse number="28" style="v" />Re' taqe i tohlook ma' re' ta nkiwii' chi q'e' kok' taq, i rub'an chi nchoparik kipaam,</para>
  <para style="q">eh kiokik chupaam i kiye'aab' taqe i reey.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Kijib' taqe i q'e' kow kiib',</para>
  <para style="q">ti yo'joq kuum noq kib'ehik.</para>
  <para style="q">
    <verse number="30" style="v" />Re' taqe wili: Re' i kaq b'ahlam xa re' wo' reh</para>
  <para style="q">yohb'aal wach josq'iil chuwach taqe i chikop,</para>
  <para style="q">eh ma' rumol ta chi elik.</para>
  <para style="q">
    <verse number="31" style="v" />Re' imas kixlaan xakow chik i rub'an riib', re' imas kaprax,</para>
  <para style="q">eh re' i reey inooj chi peet b'eeh chuwach taqe i ru soldado.</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Wila' xa pamemil aye'em runimaal awach,</para>
  <para style="q">wila' wilik i ma' holohik taj ayejaam wach</para>
  <para style="q">xti cha kapaaj riij chi korik.</para>
  <para style="q">
    <verse number="33" style="v" />Eh wila' re' hat xapuq' paam i lecha nee wo' inawesaj i mantekilla.</para>
  <para style="q">Eh wila' xaq'oj aaju' nee nelik cho rukik'eel.</para>
  <para style="q">Eh wila' awach i xutik ruk'aah nee namin awiib' pan peleto, ruuk' inki.</para>
  <chapter number="31" style="c" />
  <para style="s">Re' xuq'or i Lemuel</para>
  <para style="p">
    <verse number="1" style="v" />Re' Lemuel xwihik cho chi reyil ar Masa, xuq'or nik' wach ruq'ilariik xb'aan ruum i rutuut je' wili xuq'or weh:</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Hat wak'uun, xatruyeew cho weh i Dios,</para>
  <para style="q">re' hin ma' xta chik tokoom inwaaj nuq'orom aweh.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' chi maayeew chi re' chi ma' re' awansil kuuk' i k'oyoom laj ixoq,</para>
  <para style="q">ruum re' taqe re' inq'eb'wik keh i reey.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Chakoj rehtaal i hat Lemuel chi re' taqe reey,</para>
  <para style="q">re' taqe i wilkeeb' chi taaq'anik,</para>
  <para style="q">ma' ruk'ul taj chi neenkuk'ej keh i k'ahlaj ha',</para>
  <para style="q">
    <verse number="5" style="v" />ruum wi xkuk'ej keh ma' nee ta chik inki a'n i ruq'or i k'uhb'aal.</para>
  <para style="q">Eh neenkian ti' k'axik keh i xati' wo' kik'ux.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taqe k'ahlaj ha' xa re' taqe i ti' wilkeeb'</para>
  <para style="q">i xa nyot'ik chik i kik'ux kiuk'inik reh.</para>
  <para style="q">
    <verse number="7" style="v" />Re' taqe re' inkuk'ej taqe k'ahlaj ha',</para>
  <para style="q">re' nkaaj i keh chi neensahchik pankik'ux i kineb'a'il, i kik'axkiil.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Kow tiq'oroq chikiij i ma' kichol ta q'orik,</para>
  <para style="q">chako'leej taqe i ma' nee ta nkian ruko'ljiik kiib'</para>
  <para style="q">
    <verse number="9" style="v" />Kow tiq'oroq chikiij, re' i rub'ehel cha a'n kuuk' i neb'aa',</para>
  <para style="q">je' wo' kuuk' i xama' nimaq ta kiwach, inki.</para>
  <para style="s">Re' ruye'ariik ruloq'il iixoq wilik runa'ojb'al</para>
  <para style="q">
    <verse number="10" style="v" />Re' jino'q iixoq holohik runa'ojb'al k'axik chi reqarik</para>
  <para style="q">xiik' naah k'ihaal tz'aaq chuwach i holohaq perla karena.</para>
  <para style="q">
    <verse number="11" style="v" />Re' rub'ahiil ch'iklik ruk'ux ruuk',</para>
  <para style="q">eh nee ruyeew reh i rub'ahiil chu'nchel chib'ih iraaj.</para>
  <para style="q">
    <verse number="12" style="v" />Eh chu'nchel q'iij i ruk'achariik i ruch'ikaa' ruk'ux</para>
  <para style="q">i rub'ahiil ruuk' taqe chib'ih iraaj.</para>
  <para style="q">
    <verse number="13" style="v" />Re' i ehk'eenb'ees re' re', inooj chusik'ariik i lana, i lino,</para>
  <para style="q">eh xa runik'eej chik ru q'iij noq inokik chukemariik.</para>
  <para style="q">
    <verse number="14" style="v" />Re' reh i rub'an je' rukab' i rub'an i barco b'ehlan ihq</para>
  <para style="q">kochinajt i ruk'am chaloq taqe i ajwaal wach chi reh.</para>
  <para style="q">
    <verse number="15" style="v" />Eh noq xakomajaa' wo' insaq'ik</para>
  <para style="q">i ruket lom taqe i rak'uun rixq'uun,</para>
  <para style="q">taqe i raj pooh ixoq.</para>
  <para style="q">
    <verse number="16" style="v" />Re' reh inooj chi rilariik junseht-oq i ye'aab'</para>
  <para style="q">i ruloq' ruuk' i rutumiin, eh i rutik i uuva chupaam.</para>
  <para style="q">
    <verse number="17" style="v" />Eh wilik rukowiil chi korik,</para>
  <para style="q">ma' ruk'ay taj noq inokik chi kamanik.</para>
  <para style="q">
    <verse number="18" style="v" />Eh rilow mi ma' xta reet ojik i rub'an i ruyak</para>
  <para style="q">eh injohtik aq'ab' chi kamanik, i ruqop rusaqumb'aal chub'aan.</para>
  <para style="q">
    <verse number="19" style="v" />Ruuk' wo' q'ab' i reh i ruq'in i runooq'</para>
  <para style="q">eh i rukem wach.</para>
  <para style="q">
    <verse number="20" style="v" />Re' i ehk'eenb'ees re' re' ma' pixp taj i rutoob'eej taqe</para>
  <para style="q">neb'aa' je' wo' taqe i ma' xta ilil keh.</para>
  <para style="q">
    <verse number="21" style="v" />Re' reh ma' ruyohleej ta taqe i rak'uun rixq'uun noq inchalik i ruq'ijil jab'</para>
  <para style="q">ruum k'ih tah i kiso' rukojom chi kunchelaal.</para>
  <para style="q">
    <verse number="22" style="v" />Eh xa re' reh inkemwik taqe i ruchamaar,</para>
  <para style="q">xiik' naah k'ihaal tz'aaq taqe ruso' rukoj.</para>
  <para style="q">
    <verse number="23" style="v" />Re' i rub'ahiil xanoq wo' naab'jik wach chupaam i tinamit.</para>
  <para style="q">Eh inwihik chi kixilak i nimaq kiwach wilkeeb' chupaam i tinamit.</para>
  <para style="q">
    <verse number="24" style="v" />Re' ehk'eenb'ees re' re' i ruyejaa' i kiso' i tinamit,</para>
  <para style="q">i b'ak'b'al pamis, i ruk'ayej keh i aj yakool.</para>
  <para style="q">
    <verse number="25" style="v" />Re' reh xti wilik ruloq'il, wilik rukowiil,</para>
  <para style="q">ma' nqajik ta kapeew chi riij taqe q'iij naa rojiik wii'.</para>
  <para style="q">
    <verse number="26" style="v" />Eh ruuk' taqe i holohik laj na'ojb'al inq'orik</para>
  <para style="q">eh ruk'uhtaaj i chaq'lamiil.</para>
  <para style="q">
    <verse number="27" style="v" />Eh rilom wo' hoq chib'ih taqe i ajwaal wach parupaat.</para>
  <para style="q">Eh ma' xtaj i ruk'ux chi ma' ta ruk'ax kilem.</para>
  <para style="q">
    <verse number="28" style="v" />Eh inye'arik ruloq'il kuum taqe i rak'uun rixq'uun,</para>
  <para style="q">je' wo' ruum i rub'ahiil je' wili inkiq'or:</para>
  <para style="q">
    <verse number="29" style="v" />Wilik wo' taqe ixoq q'e' holohik i kina'ojb'al, xa re' la' re',</para>
  <para style="q">hat xaq'at kiwach ruuk' i ruholwochiil aana'ojb'al, inki taqe reh.</para>
  <para style="q">
    <verse number="30" style="v" />Re' otob'il imb'aan xa neetirujot', re' ruholwochiil ixoq xanik'ik wach.</para>
  <para style="q">Eh re' ixoq i ruyohleej i Dios, i ruk'ul chi naa ruye'ariik ruloq'il.</para>
  <para style="q">
    <verse number="31" style="v" />Chayeew taq ruloq'il chikiwach chu'nchel i tinamit.</para>
  <para style="q">Eh chayeew wo' taq ruloq'il chu'nchel i rub'an.</para>
</usx>