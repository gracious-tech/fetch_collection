<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="HOS" style="id">OSEPOK.SFK 15-05-2,006. Adelina Quej. Pokomchi Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">OSEAS</para>
  <para style="toc3">Hos</para>
  <para style="toc2">Hos</para>
  <para style="toc1">OSEAS</para>
  <para style="mt2">RE' I RUHUUJ I OSEAS</para>
  <para style="mt1">OSEAS</para>
  <chapter number="1" style="c" />
  <para style="s">Re' i rehk'een, eh re' taqe i rak'uun rixq'uun i Oseas</para>
  <para style="p">
    <verse number="1" style="v" />Re' i tz'ihb'amaj chupaam i huuj wili, re' i xuq'or i QaJaaw Dios, reh i Oseas rak'uun i Beeri, noq xi wihik chi reyil Judá i Uzías, i Jotam, i Acaz, i Ezequías. Re' noq xwihik chi reyil Israel i Jeroboam rak'uun i Joás.</para>
  <para style="p">
    <verse number="2" style="v" />Eh noq xutoq'aa' q'orik i QaJaaw Dios ruuk' i Oseas, je' wili i xuq'or:</para>
  <para style="b" />
  <para style="q">Re' taqe i aj Israel je' pan k'oyomal wilkeeb',</para>
  <para style="q">ruum xkikanaa' nunimjiik.</para>
  <para style="q">Ruum aj re', re' hat Oseas chak'am chi awehk'een jino'q i k'oyoom laj ixoq,</para>
  <para style="q">eh naa ruwihiik taqe awak'uun ruuk',</para>
  <para style="q">naa kikahniik chi rak'uun k'oyoom laj ixoq taqe, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" />Eh re' i Oseas xuk'am wo' chi rehk'een jinaj i k'oyoom laj ixoq Gomer rub'ihnaal, rixq'uun i Diblaim, eh x-aasjik jinaj i rak'uun ruuk'. <verse number="4" style="v" />Eh re' i QaJaaw Dios je' wili i xuq'or reh i Oseas:</para>
  <para style="b" />
  <para style="q">Re' hat Jezreel i rub'ihnaal i k'isa k'un chakoj,</para>
  <para style="q">ruum re' hin ilook' i nuyeew chi tojariik i kimahk</para>
  <para style="q">taqe i riih rumaam Jehú, re' i wihinaq chi reyil.</para>
  <para style="q">Eh ruum taqe ikaansanik xub'an ar i Jezreel,</para>
  <para style="q">re' hin naawisam chi taaq'anik ar Israel, inki.</para>
  <para style="q">
    <verse number="5" style="v" />Eh chupaam taqe i q'iij re' re', wach k'ixkaab' Jezreel naawisam</para>
  <para style="q">i kajaawriik taqe i soldado kichalik Israel, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" />Re' i Gomer x-aasjik wo' chik ruha'lak'uun, k'isaxq'un chik, re' i QaJaaw Dios je' wili i xuq'or reh i Oseas:</para>
  <para style="b" />
  <para style="q">Re' hat Lo-ruhama i rub'ihnaal chakoj i k'isa xq'un,</para>
  <para style="q">ruum re' b'ihnaal re' re' iraaj ruq'orom</para>
  <para style="q">chi re' i hin ma' naa ta nuketelaam kiwach i aj Israel,</para>
  <para style="q">ma' naa ta nukuyum i kimahk.</para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" />Eh re' taqe i aj Judá keh konaa nuketelaam kiwach, eh re' hin i kaJaaw i ki Dios naa nuko'liniik keh. Xa re' la' ma' ruuk' ta q'aq'inik, ni xata ruuk' flecha, ni xata ruuk' i q'aslaj ch'ihch', ni xata ruuk' taqe aj q'aq'ineel kichalik rij kawáyu.</para>
  <para style="p">
    <verse number="8" style="v" />Eh noq re' Gomer xuq'uch reh i ch'uuch' i k'isa rixq'uun, x-aasjik wo' chik jinaj i k'isa rak'uun. <verse number="9" style="v" />Re' i QaJaaw je' wili i xuq'or reh i Oseas:</para>
  <para style="b" />
  <para style="q">Lo-ami i rub'ihnaal i k'isa k'un chakoj,</para>
  <para style="q">ruum re' b'ihnaal re' re' iraaj ruq'orom, re' taq i hat ma' hat ta taq chik nutinamiit,</para>
  <para style="q">re' hin ma' hin ta wo' chik taq aaDios, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Xa re' la', re' taqe i aj Israel naa kik'ihaaxb'iik,</para>
  <para style="q">naakiponiik chi je' kik'ihaal i saniib' chi chii' i palaw,</para>
  <para style="q">ma' naa ta rukuyjiik kajaljiik.</para>
  <para style="q">Eh ma' naa ta chik ruq'orariik keh ruum i Dios chi ma' hat ta taq nutinamiit.</para>
  <para style="q">Je' la' wili i naa ruq'orariik keh:</para>
  <para style="q">Re' taq i hat, hat taq nutinamiit i hat, hin k'achlik Dios, inko'q.</para>
  <para style="q">
    <verse number="11" style="v" />Eh naa wo' chik kimolom kiib' i aj Judá kuuk' i aj Israel,</para>
  <para style="q">naakipab'aam jinaj k'amal kib'eeh.</para>
  <para style="q">Ruum naa wo' chik kehteesjiik cho pantaq tokoom tinamit,</para>
  <para style="q">ruum re' taqe q'iij re' re' xiik' naah nimaal wach ar Jezreel.</para>
  <chapter number="2" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' Dios je' wili i xuq'or: Re' taq i hat naa taq aq'orom keh awuch</para>
  <para style="q">aj Israel chi nutinamiit chik taqe, chi re' taqe ixoq nu ketelaam chik kiwach, inki.</para>
  <para style="s">Re' i je' k'oyomal ixki a'n i aj Israel</para>
  <para style="q">
    <verse number="2" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Chaq'il taq i je' atuut noq wilik</para>
  <para style="q">chi chukanaa' i yiib' wach na'ojb'al.</para>
  <para style="q">Eh re' reh ma' je' ta chik wehk'een noq wilik,</para>
  <para style="q">ma' hin ta chik rub'ahiil noq wilkiin.</para>
  <para style="q">Eh chi maa rub'an chik i je' k'oyomal,</para>
  <para style="q">eh maa ruk'ax chik reje wach tokoom winaq.</para>
  <para style="q">
    <verse number="3" style="v" />Eh wila' ma' xukanaa' rub'aan taqe re',</para>
  <para style="q">re' hin naa nukanaam chi ma' xta chik i wilik reh,</para>
  <para style="q">eh chi t'uslik, naa nukanaam chi je' rukab' noq xutoq'aa' cho k'acharik. Eh</para>
  <para style="q">naa nukanaam chi je' rukab' i chiq yuuq',</para>
  <para style="q">naa rukimiik ruum i ruchiqkaal chii'.</para>
  <para style="q">
    <verse number="4" style="v" />Eh ma' naa ta nuketelaam kiwach taqe i rak'uun rixq'uun,</para>
  <para style="q">ruum re' reh xuk'am taqe pan je' k'oyomal.</para>
  <para style="q">
    <verse number="5" style="v" />Re' i je' kituut noq wilik,</para>
  <para style="q">xuq'eb' i ruloq'il noq xuq'or chi je' wili:</para>
  <para style="q">Naa wojiik chi kisik'ariik i winaq kik'axwik weh</para>
  <para style="q">i kiye'wik nuwa' nuhaa', nu holohaq itz'ihy re' ruuk' i riij chikop,</para>
  <para style="q">re' kiye'wik weh i xela itz'ihy,</para>
  <para style="q">re' kiye'wik waseite.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Ruum aj re', re' hin je' k'iix i naa nukojom chi tz'apb'al paam i rub'eeh,</para>
  <para style="q">je' naa nukojom kotimaj koraal chi riij,</para>
  <para style="q">reh chi ma' nee ta rureq i rub'eeh.</para>
  <para style="q">
    <verse number="7" style="v" />Re' reh naa wo' naq chik rusik'im taqe i winaq ink'axwik reh,</para>
  <para style="q">eh ma' naa ta chik rureqem,</para>
  <para style="q">ruum i re' je' wili i naa ruq'orom:</para>
  <para style="q">Re' hin naa wo' chik wojiik ruuk' i peet nub'ahiil noq wilik,</para>
  <para style="q">ruum ruuk' i reh ma' xta naq reet wilkiin,</para>
  <para style="q">ma' je' ta rukab' i yu'naak, inko'q, chi wiij.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Xa re' la' re' reh,</para>
  <para style="q">ma' xukoj ta rehtaal chi re' wo'</para>
  <para style="q">naq i hin xin ye'wik reh i rutrigo, i ruvino, i raseite,</para>
  <para style="q">eh chi re' hin xin k'ihaaxb'isanik reh i ru oro, i ru plata</para>
  <para style="q">i ruyeew chi rumayiij chuwach i tiyoox Baal.</para>
  <para style="q">
    <verse number="9" style="v" />Eh re' i hin paruq'ijil i rumolariik i wach taqe i rutik i</para>
  <para style="q">ma' naa ta chik nuye'em reh i wach i trigo, i vino.</para>
  <para style="q">Eh naa wo' chik nuq'uchum reh i itz'ihy re' ruuk' riij chikop,</para>
  <para style="q">je' wo' i xela itz'ihy nuye'em naq reh chi rub'urb'aal.</para>
  <para style="q">
    <verse number="10" style="v" />Eh re' hin panaq'kiwach i je' winaq i q'e' k'axwik reh naa nuq'uchum i chib'ih reh,</para>
  <para style="q">naa nukanaam chi t'uslik,</para>
  <para style="q">ma' jino'q naa ruko'liniik reh panuq'ab'.</para>
  <para style="q">
    <verse number="11" style="v" />Eh ma' naa ta chik nuye'em q'ab'</para>
  <para style="q">chi naa rub'anam i ru ninq'iij inye'wik rusuqkiil ruk'ux,</para>
  <para style="q">je' wo' taqe i runinq'ijiik i ak' poh, i hi'limb'al q'iij.</para>
  <para style="q">Je' wo' chu'nchel i ru ninq'iij.</para>
  <para style="q">
    <verse number="12" style="v" />Re' hin naa nusacham kiwach i ru-uuva,</para>
  <para style="q">i ruhigo, re' i je' wili i ruq'or chikiij:</para>
  <para style="q">Re' taqe wili xkiyeew weh i je' i winaq q'e' kik'axwik weh, inki.</para>
  <para style="q">Eh re' i hin naa nukanaam chi xa je' chik ch'ahn taqe i rutik,</para>
  <para style="q">naa ruk'uxariik kuum taqe i josq'laj chikop.</para>
  <para style="q">
    <verse number="13" style="v" />Re' hin naa nuye'em chutojariik i ru mahk i je' ehk'eenb'ees re' re',</para>
  <para style="q">ruum taqe i k'ataj i insensia xub'an chikiwach i Baal.</para>
  <para style="q">Re' noq i rukoj lopq'aaq',</para>
  <para style="q">i karena chutahqaljiik taqe i je' ruwinaqiil q'e' k'axwik reh.</para>
  <para style="q">Eh re' hin xiruq'eb' chi riij ruk'ux, inki i QaJaaw Dios.</para>
  <para style="s">Re' i QaJaaw Dios xuketelaaj wo' chik wach i rutinamiit Israel</para>
  <para style="q">
    <verse number="14" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' hin naa nuk'amam reje panchiq yuuq' Sinaí i je' ehk'eenb'ees re' re', ar</para>
  <para style="q">naa nuq'orom reh chi q'e' naa nu k'axam.</para>
  <para style="q">
    <verse number="15" style="v" />Eh naa wo' chik nuye'em q'ab' chi naa ruwachiniik taqe i ru-uuva,</para>
  <para style="q">naa nuye'em chi ruye'aab' i wach k'ixkaab' Acor rub'ihnaal,</para>
  <para style="q">reh chi nee wo' chik i rureq i rusuqkiil ruk'ux.</para>
  <para style="q">Eh ar neerub'an chi je' rukab' i nimanik xub'an cho pampeet,</para>
  <para style="q">noq xwesaj chaloq Egipto.</para>
  <para style="q">
    <verse number="16" style="v" />Ma' naa ta chik ruq'orom chi je' wili: Hat dios Baal ma' ko'q ta chik weh.</para>
  <para style="q">Je' la' wili i naa nuq'orom weh:</para>
  <para style="q">Re' hat, i hat manlik nub'ahiil noq wilkaat, inko'q weh, inki Dios.</para>
  <para style="q">
    <verse number="17" style="v" />Eh ma' naa ta chik nuye'em q'ab' chi naa ruq'orom i kib'ihnaal taqe i xa tiyoox Baal.</para>
  <para style="q">Ma' naa ta chik ruq'orom rib'iral chi jumpech taqe re'.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Chupaam taqe q'iij re' re' wilik i naa nuyejaam wach kuuk' i josq'laj chikop,</para>
  <para style="q">kuuk' i chikop kirupinik pan taxaaj, kuuk' taqe aaq',</para>
  <para style="q">reh chi ma' xta naa kuuchjiik i aj Israel.</para>
  <para style="q">Eh ma' naa ta chik nuye'em q'ab' chi naa rub'aan i q'aq'inik, ikaansanik ruuk' flecha,</para>
  <para style="q">ruuk' i q'aslaj ch'ihch', reh chi nee kik'acharik pansuqkiil k'uxliis.</para>
  <para style="q">
    <verse number="19" style="v" />Re' taq i hat aj Israel je' nanaakaat taq nuk'amam wuuk' chi wehk'een chi jumpech,</para>
  <para style="q">ruum q'e' taq ti nuk'ax, naa awihiik taq wuuk' panotob'il,</para>
  <para style="q">pansuqkiil k'uxliis, naa taq nuketelaam awach.</para>
  <para style="q">
    <verse number="20" style="v" />Re' hin naa kaat taq nuk'amam chi manlik wehk'een,</para>
  <para style="q">parukorkiil wach k'uxliis,</para>
  <para style="q">eh naa taq anab'eem chi hin taq aaWaJaaw.</para>
  <para style="q">
    <verse number="21" style="v" />Re' hin xti korik taq i nuq'or aweh chi chupaam taqe ponoq i q'iij re' re'</para>
  <para style="q">kopan taxaaj naa nuye'em chaloq i wotob'il,</para>
  <para style="q">naa nuqaasam chaloq jab' chinaah i wach ak'al.</para>
  <para style="q">
    <verse number="22" style="v" />Eh chinaah i wach ak'al naa chik rub'anam wach i trigo,</para>
  <para style="q">riis i uuva, aseite.</para>
  <para style="q">Re' taq i hat je' wili taq i naa aq'orom:</para>
  <para style="q">Jezreel, tiko'q taq.</para>
  <para style="q">
    <verse number="23" style="v" />Eh naa taq kaat nuye'em chupaam i ye'aab' re' re' chi hat taq nutinamiit,</para>
  <para style="q">naa nuketelaam wach i Lo-ruhama.</para>
  <para style="q">Eh re' i Lo-ami je' wili i naa nuq'orom reh:</para>
  <para style="q">Re' hat, hat chik nutinamiit, kinko'q reh</para>
  <para style="q">re' reh naa kiin ruq'orom chi hin ruDios.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' Oseas xukuy ru mahk i k'oyoom laj ixoq, rujalwaach chi re' Dios xukuy kimahk i aj Israel</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or weh: Yu'naak cha k'ax wo' chik ixoq re' re', atoob' ta wilik pan k'oyomal ruuk' i tokoom winaq. Re' hin i Dios je' wo' re' kik'axariik i aj Israel i nub'an. Atoob' ta inkiloq'ej taqe i tiyoox, atoob' ta inkik'ux i kaxlanwi'k mayijimaj chikiwach i tiyoox, inki. <verse number="2" style="v" />Eh re' hin ho'lajuuj chi tumiin re' ruuk' i plata xnutoj chi riij i wehk'een, eh wuquub' nimaq chakach chi sebada i xnuyeew chi riij xnuk'am wo' chik chi wehk'een. <verse number="3" style="v" />Eh je' wili i xnuq'or reh: Re' hat najt naa akahniik chi wehk'een, ma' awach ta chik i tokoom winaq naa atahqeem reje, je' wo' hoq i hin ma' awach ta wo' chik tokoom ixoq naa nuq'oreem, kinki reh.</para>
  <para style="p">
    <verse number="4" style="v" />Re' re' k'uhtb'al reh chikiwach i aj Israel chi najt naa kikahniik chi ma' xta kireey, chi ma' xta k'amal kib'eeh. Eh chi ma' xta chik i kimayiij, ma' naa ta chik kiloq'em i tiyoox ab'aj. Ma' naa ta chik ruwihiik i k'amal b'eeh aj tiij, ma' naa ta chik ruwihiik tiyoox. <verse number="5" style="v" />Eh chi riij i re', re' taqe i aj Israel naa wo' chik kisik'im i kaJaaw i ki Dios, je' wo' hoq i kireey naa ruwihiik re' ruuk' i riih rumaam i reey David. Re' keh naa ruponiik i q'iij noq ruuk' yo'jik naa kiloch'om kiib' chuwach i QaJaaw Dios, naa wo' chik kisik'im i rotob'il.</para>
  <chapter number="4" style="c" />
  <para style="s">Re' i QaJaaw Dios xuq'or keh i aj Israel chi ma' k'isiin i mahk i xkian</para>
  <para style="q">
    <verse number="1" style="v" />Hat taq aj Israel chab'iraj taq i ruq'or i QaJaaw Dios.</para>
  <para style="q">Re' reh xchalik ruk'aah, je' wili i xuq'or:</para>
  <para style="q">Re' taqe i tinamit wili ma' jino'q i korik wach ruk'ux,</para>
  <para style="q">ma' xta ketelinik wachiis kuuk'.</para>
  <para style="q">Eh ma' awach ta inye'wik wajaawriik chi re' hin, i Dios.</para>
  <para style="q">
    <verse number="2" style="v" />Eh xa re' i ma' holohik taj, xa re' i chukuj q'orik, xa re' i leq',</para>
  <para style="q">xa re' i ch'uwarisanik wach kikaxaro inki a'n</para>
  <para style="q">Eh xa re' rub'anariik i ti' k'axik, xa re' ikaansanik inki a'n rajlaal i q'iij.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i wach ak'al panti' wilik,</para>
  <para style="q">re' taqe i k'achareel chuwach ma' xta chik kikowiil.</para>
  <para style="q">Eh re' taqe josq'laj chikop,</para>
  <para style="q">taqe i chikop kirupinik pan taxaaj,</para>
  <para style="q">taqe i kar wilkeeb' pan palaw, k'ahchi' kikimiik, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' taq i hat k'amal b'eeh aj tiij ma' xaq'il ta taq i tinamit wili,</para>
  <para style="q">ma' xakoj ta taq kina'ojb'al, ruum eliik taq wach tib'anik kuuk'.</para>
  <para style="q">Re' i nuk'aah wach anaah taq i hat naa wik'sam.</para>
  <para style="q">
    <verse number="5" style="v" />Re' taq i hat xanik' neenuyeew taq i ti' k'axik cha naah pan q'ij,</para>
  <para style="q">oon chaq'ab' awuch'ihil ijalal naq nuq'oral i hin.</para>
  <para style="q">Eh naa nusacham taq wach aatinamiit Israel.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taqe i nutinamiit naa nusach kiwach,</para>
  <para style="q">ruum i kimahk, ruum ma' xakoj ta taq kina'ojb'al.</para>
  <para style="q">Re' taq i hat ruum chi xaq'eb' taq chi riij ak'ux i nuk'uhb'aal,</para>
  <para style="q">re' hin, naa taq kaat wisam chi k'amal kib'eeh aj tiij.</para>
  <para style="q">Je' wo' taq aawiih aamaam ma' naa ta nukojom taqe chi k'amal kib'eeh aj tiij.</para>
  <para style="q">
    <verse number="7" style="v" />Eh nik' wach i k'ihaaxb'ik taq i na a'n</para>
  <para style="q">je' wo' re' i k'ihaaxb'ik i rub'an taq amahk.</para>
  <para style="q">Je' re' noq re' hin naa nusutem taq i runimaal awach chi k'uhtb'al taq ak'ixb'ilaal.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taq i hat xasuq taq chik aweh noq inki a'n i mahk i nutinamiit,</para>
  <para style="q">ruum re' i kimayiij inak'uxlaaj taq wii' awiib'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hin chi je' taqe i tinamit,</para>
  <para style="q">chi je' taqe k'amal kib'eeh aj tiij naa nuye'em taqe chutojariik i kimahk,</para>
  <para style="q">ruum i kiyiib' wach na'ojb'al inki a'n</para>
  <para style="q">
    <verse number="10" style="v" />Eh naa wo' naq kianam kiwa',</para>
  <para style="q">xama' naa ta wo' kinujiik, eh naa wo' naq kiwiriik ruuk' i kixooq,</para>
  <para style="q">eh xama' naa ta wo' ruwihiik kak'uun kixq'uun, inki Dios.</para>
  <para style="s">Re' i loq'inik tiyoox xkian i aj Israel</para>
  <para style="q">
    <verse number="11" style="v" />Re' i nutinamiit k'ahchi' rusahchiik i kina'ojb'al</para>
  <para style="q">ruum i ruuk'jiik i k'ahlaj ha' inxohk'risanik, eh ruum i je' k'oyomal inki a'n</para>
  <para style="q">
    <verse number="12" style="v" />Eh inkipahqaaj kina'ojb'al reh i tiyoox re' ruuk' i chee',</para>
  <para style="q">eh xama' kich'aq'weesjik ta wo' ruum.</para>
  <para style="q">Eh xsahchik kina'ojb'al ruum i je' k'oyomal inki a'n</para>
  <para style="q">xin kiq'eb' chi riij kik'ux i hin, hin k'achlik Dios.</para>
  <para style="q">
    <verse number="13" style="v" />Re' keh kiooj nah taq yuuq'</para>
  <para style="q">chuk'atariik i kimayiij,</para>
  <para style="q">chuk'atariik i insensia wataq yuuq' k'ixkaab',</para>
  <para style="q">je' chi muuj taqe i tz'inuj, chi muuj taqe tuhq,</para>
  <para style="q">chi ri'sil i rumuuj i saq chee' álamo rub'ihnaal.</para>
  <para style="q">Eh inkik'uhtaaj reh i kak'uun kixq'uun, i loq'inik tiyoox.</para>
  <para style="q">Re' i kixq'uun nakiwihiik pan k'oyomal,</para>
  <para style="q">re' taqe i kil-iib' na kich'uwa'risam wach i kikaxaro.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hin ma' naa ta nuye'em taqe chutojariik</para>
  <para style="q">i kimahk taq awixq'uun chi riij i k'oyomal nakianam.</para>
  <para style="q">Ma' naa ta nuye'em taqe chi tojariik i kimahk</para>
  <para style="q">taq awil-iib' chi riij i ch'uwa'risanik wach</para>
  <para style="q">kikaxaro nakianam.</para>
  <para style="q">Eh hat wo' taq xatk'amwik kib'eeh</para>
  <para style="q">chi xkiyeew i kimayiij chuwach i tiyoox,</para>
  <para style="q">je' aj re' noq i ruq'eb' riib' i tinamit ma' xta runa'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Re' taqe i aj Israel atoob' ta wilkeeb' pan k'oyomal.</para>
  <para style="q">Re' taq i hat aj Judá ma' a'n taq aweh i k'oyomal re' re',</para>
  <para style="q">mat'ooj taq chikiij kiooj Gilgal, i kijohtik Bet-aven.</para>
  <para style="q">Eh maaq'or taq i nub'ihnaal chi xama' xta rub'ehel.</para>
  <para style="q">
    <verse number="16" style="v" />Re' taq i hat aj Israel,</para>
  <para style="q">je' taq akab' i simaroon laj</para>
  <para style="q">q'ahxoq wakax xina q'eb' taq, chi riij ak'ux.</para>
  <para style="q">¿Mi konawaaj taq re' chi nee taq tinuchajeej chi je' taq hat kok' rak'uun tentzun?</para>
  <para style="q">
    <verse number="17" style="v" />Re' taqe i aj Efraín, aj looq'en tiyoox taqe,</para>
  <para style="q">cha kanaa' taq kian peet inkaaj rub'aan.</para>
  <para style="q">
    <verse number="18" style="v" />Re' keh xa re' i xohk'rik, xa re' i k'oyomal,</para>
  <para style="q">xa re' taqe i k'ixb'ilaal laj na'ojb'al inki a'n</para>
  <para style="q">re' i holohik laj na'ojb'al xkiq'eb' chi riij kik'ux.</para>
  <para style="q">
    <verse number="19" style="v" />Eh xa je' kikutarik reje ruum kowlaj teew naa rub'aan keh</para>
  <para style="q">eh naakik'uhtaam kik'ixb'ilaal, ruum irulooq'jiik taqe i tiyoox, inki i QaJaaw Dios.</para>
  <chapter number="5" style="c" />
  <para style="s">Re' i QaJaaw Dios xuyeew taqe panti' k'axik i aj Israel ruum i kimahk</para>
  <para style="q">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' taq i hat k'amal b'eeh aj tiij, re' taq i hat aj Israel,</para>
  <para style="q">re' taq i hat raj kamanoom i reey, chab'iraj taq: Cha naah taq</para>
  <para style="q">i hat naa nuq'atam i q'orik,</para>
  <para style="q">ruum i xakoj taq kixirob'aal i wilkeeb' Mizpa,</para>
  <para style="q">xaq'at taq pan kib'eeh naah yuuq' Tabor.</para>
  <para style="q">
    <verse number="2" style="v" />Eh je' naa chaam laj jul i xak'ot taq reh</para>
  <para style="q">chi xkiq'eb' kiib' i wilkeeb' wach k'ixkaab' Sitim,</para>
  <para style="q">ruum aj re' naa kaat nuye'em chutojariik taq amahk.</para>
  <para style="q">
    <verse number="3" style="v" />Re' hin weht'al i kina'ojb'al,</para>
  <para style="q">chu'nchel i aj Israel.</para>
  <para style="q">Je' wo' taqe i aj Efraín xkian i je' k'oyomal,</para>
  <para style="q">eh xuch'uwa'risaj kiwach chu'nchel i aj Israel.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh ruum i kiyiib' wach na'ojb'al ma' kinkinimaj ta chik.</para>
  <para style="q">Re' chik kow i rumin riib' chikiwach i je' k'oyomal,</para>
  <para style="q">eh ma' kiyeew ta chik wajaawriik i hin, hin k'achlik Dios.</para>
  <para style="q">
    <verse number="5" style="v" />Re' taqe i aj Israel ruum chi q'e' inkinimb'isaj</para>
  <para style="q">kiib' ink'utinik chi wilkeeb' pankimahk.</para>
  <para style="q">Eh re' taqe i aj Efraín, re' i kimahk naa ruq'eb'wiik keh,</para>
  <para style="q">eh naa wo' kiq'ehb'iik pamahk i aj Judá keh.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taqe i aj Israel naa naq chik kik'amam chaloq i kiwakax,</para>
  <para style="q">i kitentzuun chi kimayiij chi nusik'ariik.</para>
  <para style="q">Xa ma' naa ta wo' chik kiin kireqem, ruum xnukanaa' chik taqe.</para>
  <para style="q">
    <verse number="7" style="v" />Re' keh ma' korik ta wach kik'ux wuuk'.</para>
  <para style="q">Re' i kak'uun kixq'uun tokoom chik inkikoj chi kajaaw,</para>
  <para style="q">ruum i re' xa chi jumehq'iil naa nusacham kiwach i keh,</para>
  <para style="q">je' wo' hoq i kitik, inki i Dios.</para>
  <para style="s">Re' i ti' k'axik xye'arik chikinaah i aj Israel chikinaah i aj Judá</para>
  <para style="q">
    <verse number="8" style="v" />Chaxulej taq i tuun ar Gabaa rehtalil i q'aq'inik.</para>
  <para style="q">Eh chaxulej taq i tuun ar Ramá.</para>
  <para style="q">Chaq'or taq ar Bet-aven chi wilik yohb'aal, je' wo' ar Benjamín.</para>
  <para style="q">
    <verse number="9" style="v" />Re' taqe i aj Efraín xti korik chi naa kikahniik</para>
  <para style="q">chi ma' xta wilik keh paruq'ijil i ti' k'axik.</para>
  <para style="q">Eh chu'nchel i aj Israel naa kinab'eem chi korik chi je' re' i naa ruk'ulariik.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' taqe i k'amal kib'eeh aj Judá</para>
  <para style="q">je' kikab' taqe i kijilwik paam taqe i k'ula't,</para>
  <para style="q">re' hin naa nuye'em i nujosq'iil chikinaah.</para>
  <para style="q">
    <verse number="11" style="v" />Re' taqe i aj Efrín k'achi' kik'iik chi ti' k'axik,</para>
  <para style="q">xi kahnik chi ma' xta chik i wilik keh</para>
  <para style="q">ruum re' chik taqe i tiyoox xkinimaj.</para>
  <para style="q">
    <verse number="12" style="v" />Re' hin naa nusacham kiwach i aj Efraín,</para>
  <para style="q">i aj Judá, je' rukab' i rub'an i mooh noq i rumohrisaj taqe i xa chib'ih jariik.</para>
  <para style="q">
    <verse number="13" style="v" />Eh noq naakilom taqe i aj Efraín,</para>
  <para style="q">taqe i aj Judá, chi xiik' naah ti' kiil wilkeeb'.</para>
  <para style="q">Re' taqe i aj Efraín naa kojiik ruuk' i runimaal wach reey ar Asiria,</para>
  <para style="q">reh naq chi naa kik'aachjiik,</para>
  <para style="q">xa re' la' xama' naa ta wo' kik'achjik.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hin ruum nujosq'iil naa nuye'em taqe panti' k'axik i aj Efraín,</para>
  <para style="q">je' wo' taqe i aj Judá.</para>
  <para style="q">Je' rukab' i rub'an i kaq b'ahlam noq i ruxereb'eej i rutiib',</para>
  <para style="q">ma' awach ta naa ruko'liniik keh panuq'ab'.</para>
  <para style="q">
    <verse number="15" style="v" />Re' hin naa nukanaam taqe chi kutkeel,</para>
  <para style="q">korehtaal inkiyot' i kik'ux chi riij,</para>
  <para style="q">i kimahk, eh naa wo' chik kinkinimam.</para>
  <para style="q">Eh naa kiin kisik'im noq wilkeeb' pan ti'kiil k'uxliis, inki i Dios.</para>
  <chapter number="6" style="c" />
  <para style="s">Re' taqe i aj Israel xkiq'or chi naa wo' chik kinimam i Dios</para>
  <para style="q">
    <verse number="1" style="v" />Re' i tinamit je' wili i xkiq'or: Qoh sutinoq wo' chik ruuk' i QaJaaw Dios.</para>
  <para style="q">Atoob' ta xoj ruyeew panti' k'axik,</para>
  <para style="q">naa wo' chik kooj risam chupaam.</para>
  <para style="q">Atoob' ta xoj ruyeew panti' naa wo' chik kooj ruk'achrisam.</para>
  <para style="q">
    <verse number="2" style="v" />Re' reh xa ruuk' wo' chik i ki'ib' ixib' q'iij naa ruye'em qak'achariik.</para>
  <para style="q">Reh chi naa qak'achariik chuwach i reh.</para>
  <para style="q">
    <verse number="3" style="v" />Eh qachop taq qak'ux chunimjiik i QaJaaw Dios.</para>
  <para style="q">Re' reh korik chi nee qoh rutoob'eem,</para>
  <para style="q">je' rukab' noq i nelik chaloq i rusaq'umaal i q'iij.</para>
  <para style="q">Eh je' rukab' noq i ruyeew chaloq i peet jab',</para>
  <para style="q">je' wo' jab' koq'uun noq i rut'aqsaj i tik, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' i QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">¿Chib'ih taq inawaaj chi neenub'an awuuk' i hat</para>
  <para style="q">taq aj Efraín, je' wo' taq i hat aj Judá?</para>
  <para style="q">Re' i nuk'axariik taq i na a'n xa je'</para>
  <para style="q">rukab' noq inik'ik i suutz',</para>
  <para style="q">je' rukab' i mus jab' pantaq wahq'eq jumehq'iil insahchik wach.</para>
  <para style="q">
    <verse number="5" style="v" />Re' hin xnutaq'aaj taqe ijalal nuq'oral,</para>
  <para style="q">chuq'orariik taq aweh i ti' k'axik naa nuye'em taq cha naah.</para>
  <para style="q">Eh nuq'or ruuk' nuchii' chi naa taq kaat nuye'em pankimik,</para>
  <para style="q">re' i nuq'oral, je' rukab' i rub'an i saqum.</para>
  <para style="q">
    <verse number="6" style="v" />Re' i nupahqaaj taq aweh i hin, re' chi kinak'ax taq chu'nchel ak'ux,</para>
  <para style="q">chi kinakoj taq chi hin aaDios.</para>
  <para style="q">Re' taqe i xa chib'ih jariik chi mayiijal ma' inwaaj ta chik, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Eh je' wili i xuq'or:</para>
  <para style="q">Re' taqe i nutinamiit wili, ma' korik ta wach kik'ux wuuk',</para>
  <para style="q">xkiq'etwachej i nuk'uhb'aal, je' rukab' i xub'an i Adán pampeet.</para>
  <para style="q">
    <verse number="8" style="v" />Chupaam i tinamiit Galaad, ma' k'isiin i yiib' wach na'ojb'al imb'aan,</para>
  <para style="q">xa re' ikaansanik kas kichaaq' inki a'n</para>
  <para style="q">
    <verse number="9" style="v" />Re' taqe i k'amal kib'eeh aj tiij je' kikab' i juntuhb' chi ajileq'</para>
  <para style="q">ruum inooj kikeb'aa' kiib' chi' taq b'eeh inooj Siquem,</para>
  <para style="q">ar inkiq'at i tinamit, inki a'n ti' k'axik reh, inkikansaj.</para>
  <para style="q">
    <verse number="10" style="v" />Eh re' taqe i aj Israel, inwilow chi q'e' yiib' wach kib'anik.</para>
  <para style="q">Re' taqe i aj Efraín xkimin kiib' chub'aan i je' k'oyomal,</para>
  <para style="q">eh re' taqe i aj Israel xkich'uwa'risaj kiib' ruuk' i re'.</para>
  <para style="q">
    <verse number="11" style="v" />Eh re' taq i hat aj Judá nuyejaam chik wach q'iij chi naa taq kaat nuye'em panti' k'axik.</para>
  <para style="q">Re' noq naa wo' chik wisam taqe chaloq panti' k'axik i nutinamiit Israel, inki.</para>
  <chapter number="7" style="c" />
  <para style="s">Re' kiyiib' wach na'ojb'al i aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Noq xwaaj naq taqe wisam panti' k'axik i aj Israel,</para>
  <para style="q">re' taqe i aj Efraín xa chayeew chik i mahk inki a'n</para>
  <para style="q">je' wo' taqe i aj Samaria.</para>
  <para style="q">Eh xa re' i chukuj q'orik,</para>
  <para style="q">xa re' i leq' inkaaj pantaq paat, pantaq b'eeh.</para>
  <para style="q">
    <verse number="2" style="v" />Re' keh ma' nkikapaaj taj chi re' hin k'ahchi' wilom</para>
  <para style="q">i ma' holohik ta laj na'ojb'al inki a'n</para>
  <para style="q">Xanaah re' k'ahchi' wilom chi k'ahchi'rik'iik chikinaah i kimahk inki a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' keh ruuk' i kiyiib' wach na'ojb'al,</para>
  <para style="q">ruuk' i chukuj q'orik inki a'n inkiyeew rusuqkiil ruk'ux i reey,</para>
  <para style="q">je' wo' taqe i k'amal kib'eeh.</para>
  <para style="q">
    <verse number="4" style="v" />Eh re' taqe re'</para>
  <para style="q">xa re' i ch'uwarisanik wach kikaxaro inkaaj.</para>
  <para style="q">Eh je' kikab' i horna qoplik ruq'aq'al,</para>
  <para style="q">ma' nluk'ariik taj noq inyuq'arik paam i ruq'oril kaxlanwi'k,</para>
  <para style="q">korehtaal inkojarik ch'amb'esb'al reh.</para>
  <para style="q">
    <verse number="5" style="v" />Eh noq i runinq'iijeej i ruhab'ul i reey,</para>
  <para style="q">re' taqe i k'amal b'eeh inkixohk'risaj i reey.</para>
  <para style="q">Eh ruum i re', re' i reey inokik chub'anariik</para>
  <para style="q">i re' ma' re' chi kixilak i yiib' wach kina'ojb'al.</para>
  <para style="q">
    <verse number="6" style="v" />Re' keh xan qop chik i kánima chub'anariik i yiib' wach na'ojb'al,</para>
  <para style="q">xa je' chik rukab' i horna ma' inkanab'jik ta ruluk'ariik i ruq'aq'al.</para>
  <para style="q">Eh atoob' ta woroq inkojwik ruq'aq'al,</para>
  <para style="q">xa koqoplik wo' chi junwaar.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' taqe re' xa je' chik kiqop horna,</para>
  <para style="q">inkikansaj taqe i wilkeeb' chi ajaab'esil,</para>
  <para style="q">xkiq'eb' kiib' chu'nchel i kireey.</para>
  <para style="q">Ma' jino'q chik inkipahqaaj kikuyb'al weh.</para>
  <para style="q">
    <verse number="8" style="v" />Eh re' taqe i aj Efraín xkian jinaj wach kina'ojb'al kuuk' i tokoom tinamit.</para>
  <para style="q">Re' taqe i aj Efraín je' kikab' i kaxlanwi'k ma' xsuutjik taj, xa juntar xchaq'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' keh xehteesjik i kajaawriik kuum i tokoom tinamit,</para>
  <para style="q">xa re' la' ma' nkikoj ta rehtaal.</para>
  <para style="q">Eh saq chik i rismaal kinaah,</para>
  <para style="q">xama' nkikoj ta wo' rehtaal i k'ahchi' kik'ulum.</para>
  <para style="q">
    <verse number="10" style="v" />Re' taqe i aj Israel q'e' nimaq kiwach inki a'n kiib',</para>
  <para style="q">ruum i re' k'ahchi' kik'ulum i ti' k'axik.</para>
  <para style="q">Eh ni xata ruum taqe re', kinkaaj wo' chik kinkinimam,</para>
  <para style="q">ni xata kinkaaj kisik'im hin, hin ki Dios.</para>
  <para style="q">
    <verse number="11" style="v" />Re' taqe i aj Efraín ma' xta kina'ojb'al,</para>
  <para style="q">xa je' kikab' i paloma ma' xta runa'ojb'al,</para>
  <para style="q">ruum xooj kipahqaaj kitoob'jiik keh i aj Egipto, keh i aj Asiria.</para>
  <para style="q">
    <verse number="12" style="v" />Eh noq naa kojiik ar, re' hin naa nuq'atam pankib'eeh,</para>
  <para style="q">naa nuchopom taqe, je' rukab' noq kichoparik pan xirob' i tz'ikin.</para>
  <para style="q">Eh naa taqe nuye'em chutojariik i kimahk,</para>
  <para style="q">ruum i kiyiib' wach na'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' keh q'e' ti' i naakik'ulum</para>
  <para style="q">ruum xkiq'eb' chi riij kik'ux nunimjiik.</para>
  <para style="q">Eh naa ruchaliik i ti' k'axik chikinaah, ruum xinkiq'et wachej.</para>
  <para style="q">Re' hin xwaaj naq taqe nuko'leem,</para>
  <para style="q">xa re' la' inkichuk i q'orik chi wiij.</para>
  <para style="q">
    <verse number="14" style="v" />Eh ma' chu'nchel ta kik'ux xinkiq'oreej noq ti' wilkeeb' pankiyokaab'.</para>
  <para style="q">Eh noq xkik'er kichii' chupahqaljiik i ki trigo,</para>
  <para style="q">chupahqaljiik i riis uuva inkuk'ej xinkiq'et wachej la'.</para>
  <para style="q">
    <verse number="15" style="v" />Re' hin xnutijej wo' naq taqe,</para>
  <para style="q">eh xnuyeew wo' naq rukowiil kik'ux.</para>
  <para style="q">Xa re' la' re' keh re' chik i ma' holohik taj i xkikapaaj chi wiij.</para>
  <para style="q">
    <verse number="16" style="v" />Eh re' chik taqe i tiyoox xkinimaj,</para>
  <para style="q">xa je' kikab' i flecha ma' tz'eht tankutwik.</para>
  <para style="q">Eh ruum chi ma' kinimanik taj naa kikanteesjiik</para>
  <para style="q">ruuk' q'aslaj ch'ihch' taqe k'amal b'eeh</para>
  <para style="q">ruum i re' naakikaqse'ljiik kuum</para>
  <para style="q">i aj Egipto, inki i Dios.</para>
  <chapter number="8" style="c" />
  <para style="s">Re' taqe aj Israel xiye'arik panti' k'axik ruum i loq'inik tiyoox</para>
  <para style="q">
    <verse number="1" style="v" />Re' QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Chaxulej taq i tuun ruum re' taqe i aj q'aq'ineel</para>
  <para style="q">xa je' chik kik'uloq xihk chinaah i nutinamiit.</para>
  <para style="q">Ruum re' keh xkiq'eb' chi riij kik'ux ixqayejaa' wach kuuk',</para>
  <para style="q">eh xkiq'etwachej i nuk'uhb'aal.</para>
  <para style="q">
    <verse number="2" style="v" />Eh noq ti' chik wilkeeb' i aj Israel je' wili i naa kiq'orom weh:</para>
  <para style="q">Re' hoj inqanimaj chi re' hat i qaDios, inko'q taqe.</para>
  <para style="q">
    <verse number="3" style="v" />Re' taqe i aj Israel ruum chi xkiq'eb' chi riij kik'ux i holohik laj na'ojb'al,</para>
  <para style="q">korehtaal imb'aan keh kuum taqe i aj ixowaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' keh xankikoj i koq taqe i kireey chi ma' hin ta kinsik'wik wach,</para>
  <para style="q">eh xan kikoj i koq taqe i k'amal kib'eeh chi ma' weht'al.</para>
  <para style="q">Eh xkiyejaa' kitiyoox ruuk' oro, ruuk' plata,</para>
  <para style="q">ruum i re' naa nusacham kiwach.</para>
  <para style="q">
    <verse number="5" style="v" />Re' taqe i aj Samaria ti' i nunaah i rub'an i ki imas wakax tiyoox.</para>
  <para style="q">Eh ma' k'isiin taj i nujosq'iil xchalik chikinaah.</para>
  <para style="q">Eh ¿Kojaruuj inkimay i ch'uwa' wach na'ojb'al re' re'?</para>
  <para style="q">
    <verse number="6" style="v" />Re' i ki imas wakax tiyoox</para>
  <para style="q">xa ruyej-aniik aj Israel re' ruuk' inchol ch'eyel ch'ihch'.</para>
  <para style="q">Eh naa ruxerib'iik noq naa rusachariik</para>
  <para style="q">kiwach i kitiyoox taqe i aj Samaria.</para>
  <para style="q">
    <verse number="7" style="v" />Re' keh xa je' teew inkitik, eh xa je' kaq suut teew i naakijacham.</para>
  <para style="q">Re' i ki trigo ma' naa ta chik rub'anam paam,</para>
  <para style="q">eh wila' xub'an paam re' chik</para>
  <para style="q">taqe i tokoom tinamit naa kib'aniik rusuqkiil.</para>
  <para style="q">
    <verse number="8" style="v" />Eh naa rusachariik kiwach i aj Israel,</para>
  <para style="q">eh xama' xta chik naa kokiik wii'</para>
  <para style="q">chikiwach i tokoom tinamit.</para>
  <para style="q">
    <verse number="9" style="v" />Re' taqe i aj Efraín je' kikab'</para>
  <para style="q">i b'uurux ma' kinimanik taj.</para>
  <para style="q">Ruum xooj kitoj i aj Asiria chi naa kiko'ljiik.</para>
  <para style="q">
    <verse number="10" style="v" />Atoob' ta naq neen kikemelej k'ih-oq toob'en keh pantaq tinamit,</para>
  <para style="q">re' hin naa numolom kiwach atoob' ta naa taqe</para>
  <para style="q">nuye'em panti' k'axik chuwach i ma' k'ih ta laj q'iij,</para>
  <para style="q">pan kiq'ab' i reey, pan kiq'ab' taqe i k'amal b'eeh.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' taqe i aj Efraín ma' k'isiin taqe i artaal inkiyejaa'</para>
  <para style="q">k'atb'al kimayiij re' i xa kojb'al kimahk inkamanik wii' keh.</para>
  <para style="q">
    <verse number="12" style="v" />Eh re' hin xnutz'ibaaj wo' naq keh i nuk'uhb'aal,</para>
  <para style="q">xa re' la' re' keh xama' xkiyeew ta wo' rajaawriik.</para>
  <para style="q">
    <verse number="13" style="v" />Re' keh inkik'at taqe i chikop</para>
  <para style="q">chi kimayiij chi nuwach, eh inkik'ux i rutib'kaal.</para>
  <para style="q">Eh re' hin i Dios ma' ponik ta chi nuwach inki a'n re' re'.</para>
  <para style="q">Re' hin ink'ulik cho panuk'ux i yiib' wach inki a'n</para>
  <para style="q">naa taqe nuye'em chutojariik i kimahk,</para>
  <para style="q">naa wo' chik kisutiniik reje Egipto.</para>
  <para style="q">
    <verse number="14" style="v" />Re' taqe i aj Israel xsahchik pankik'ux</para>
  <para style="q">chi re' hin xin tz'uhkrisanik keh,</para>
  <para style="q">re' chik ruyejeb'jiik i rupaat kitiyoox xkian.</para>
  <para style="q">Eh re' taqe i aj Judá re' chik i nimaq taq tinamit xkiyejaa' ko'lb'al kiib'.</para>
  <para style="q">Re' hin naa nuk'atam i nimaq paat je' wo' hoq i tinamit xkiyejaa', inki i Dios.</para>
  <chapter number="9" style="c" />
  <para style="s">Re' Oseas xuq'or chi naa ruchaliik i ti' k'axik chikinaah i aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Re' Oseas je' wili i xuq'or:</para>
  <para style="q">Re' taq i hat wuch aj Israel, mat pisk'anik taq panawooq ruum i rusuqkiil taq ak'ux,</para>
  <para style="q">je' rukab' inki a'n i tokoom tinamit.</para>
  <para style="q">Re' taq i hat xkitoj taq aweh je' k'oyomal taq xa a'n ruum xakanaa' taq aaDios,</para>
  <para style="q">xakapaaj taq i chi ruum i re' naa ruwachiniik taq atik.</para>
  <para style="q">
    <verse number="2" style="v" />Naa la' ruponiik i q'iij chi ma' naa ta chik ruwachiniik i trigo, i uuva,</para>
  <para style="q">ma' naa ta chik ruwihiik taq awa' ahaa'.</para>
  <para style="q">
    <verse number="3" style="v" />Re' taq i hat aj Efraín, ma' naa ta chik taq awihiik ayu' parutinamiit i QaJaaw Dios.</para>
  <para style="q">Naa la' wo' chik asutiniik taq reje Egipto, eh Asiria,</para>
  <para style="q">ar taq naa ak'uxum i ch'uwa' wach.</para>
  <para style="q">
    <verse number="4" style="v" />Eh ar ma' naa ta chik taq aye'em i riis uuva chi mayiij,</para>
  <para style="q">i ak'atoj mayiij chuwach i QaJaaw Dios,</para>
  <para style="q">re' taq awa' naa ak'uxum reh ti'kiil k'uxliis.</para>
  <para style="q">Eh chu'nchel taq i naa ak'uxwiik reh i re', naa ruch'uwa'risam taq awach.</para>
  <para style="q">Eh ma' naa ta taq aye'em chi mayiij chuwach i QaJaaw Dios.</para>
  <para style="q">
    <verse number="5" style="v" />Eh wila' je' re'</para>
  <para style="q">¿Chib'ih taq i naa a'nam na' chureq i ruq'ijil</para>
  <para style="q">i ninq'iij ye'b'al ruloq'il i QaJaaw Dios?</para>
  <para style="q">
    <verse number="6" style="v" />Re' taq i hat naa aweliik reje ayu' ruum i ti' k'axik,</para>
  <para style="q">naa taq kimolom reje awach i aj Egipto,</para>
  <para style="q">je' naa naa kaat taq kimuq'aam ar Menfis.</para>
  <para style="q">Re' taqe i chib'ih aweh re' ruuk' i plata</para>
  <para style="q">naa ruq'uuxriik kiwach,</para>
  <para style="q">naa ruchaamb'iik i ch'ahn, i k'iix chupaam taq aa ye'aab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Eh xponik chik i ruq'ijil chi naa taq ak'ulum i ti' k'axik,</para>
  <para style="q">eh chi naa taq atojom riij taq amahk,</para>
  <para style="q">je' rukab' i ruk'ul taq cha weh.</para>
  <para style="q">Eh je' taq wili inaq'or: Re' i jalal ruq'oral i Dios re' re'</para>
  <para style="q">q'e' min min ruuk' taqe i ruq'or, je' cho ahqaal, tiki taq,</para>
  <para style="q">ruum q'e' taq i yiib' wach ana'ojb'al,</para>
  <para style="q">ma' k'isiin taq ti ixowanik.</para>
  <para style="q">
    <verse number="8" style="v" />Re' hin xirupab'aa' i Dios chi jalal ruq'oral taq chaxilak, i hat taq aj Efraín,</para>
  <para style="q">eh re' taq i hat inaq'at taq panub'eeh.</para>
  <para style="q">Eh noq kinwihik chupaam i rupaat i QaJaaw Dios,</para>
  <para style="q">ma' k'isiin taq i nawixow nuwach.</para>
  <para style="q">
    <verse number="9" style="v" />Re' taq i hat ma' k'isiin i yiib' wach na'ojb'al taq i na a'n,</para>
  <para style="q">je' rukab' i xb'aan Gabaa.</para>
  <para style="q">Re' i QaJaaw Dios naa ruk'uliik paruk'ux taq ayiib' wach na'ojb'al,</para>
  <para style="q">eh naa taq kaat ruye'em chutojariik taq amahk, inki i Oseas.</para>
  <para style="s">Re' taqe i aj Israel naakik'ulum i ti' k'axik ruum i kimahk inki a'n</para>
  <para style="q">
    <verse number="10" style="v" />Re' i QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Noq xnusik' cho kiwach i aj Israel xsuuqb'ik nuk'ux,</para>
  <para style="q">je' rukab' noq insuuqb'ik ruk'ux inreqwik reh i uuva panchiq yuuq'.</para>
  <para style="q">Re' i kimaam kati't xsuuqb'ik wo' cho nuk'ux kuuk',</para>
  <para style="q">je' kikab' i peet wach i higo, re' chik i tiyoox Baal-peor</para>
  <para style="q">xkiloq'ej, xin kiq'eb' i hin, xkik'uhtaaj kik'ixb'ilaal.</para>
  <para style="q">Eh xkich'uwa'risaj kiib' je' kikab' inkiloq'ej.</para>
  <para style="q">
    <verse number="11" style="v" />Re' i runimaal kiwach i aj Efraín naa rusahchiik wach</para>
  <para style="q">xa je' inrupinik reje tz'ikin.</para>
  <para style="q">Re' kehk'een,</para>
  <para style="q">ma' naa ta chik kikahniik wach k'achariik,</para>
  <para style="q">eh ma' naa ta chik raasjiik kak'uun kixq'uun.</para>
  <para style="q">
    <verse number="12" style="v" />Eh atoob' ta neenkik'isaj kak'uun kixq'uun,</para>
  <para style="q">re' hin naawisam chikiwach, ma' jino'q chik i naa nukanaam.</para>
  <para style="q">Eh q'e' ti' i naakik'ulum, ruum naa nukanaam taqe chi kutkeel, inki.</para>
  <para style="q">
    <verse number="13" style="v" />Re' i Oseas je' wili i xuq'or:</para>
  <para style="q">Re' hin xwilow taqe i aj Efraín je' kikab' i aj Tiro chi q'e' naq suq wilkeeb',</para>
  <para style="q">xa re' la' re' taqe i aj Efraín pankimik k'ahchi' kikanaam taqe i kak'uun kixq'uun.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />QaJaaw Dios, re' hat cha a'n kuuk' inakapaaj.</para>
  <para style="q">Chakanaa' taqe ixoq chi ma' nee ta chik ki ak'unaniik',</para>
  <para style="q">eh chi ma' nee ta chik kich'uch'isanik, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' taqe i aj Efraín Gilgal i xkian kiyiib' wach na'ojb'al,</para>
  <para style="q">xchalik nujosq'iil kuuk'.</para>
  <para style="q">Eh ruum i kiyiib' wach na'ojb'al, ma' naa ta chik nukojom taqe panupaat.</para>
  <para style="q">Eh ma' naa ta chik nuk'axam taqe, ruum re' taqe i k'amal kib'eeh</para>
  <para style="q">ma' kinkinimaj ta chik.</para>
  <para style="q">
    <verse number="16" style="v" />Re' taqe i aj Efraín q'e' ti' naa kiwihiik,</para>
  <para style="q">je' kikab' i chee' chiqinaq chik i raa',</para>
  <para style="q">ma' wachinik ta chik.</para>
  <para style="q">Re' keh naa wo' naq ruwihiik kak'uun kixq'uun,</para>
  <para style="q">eh re' hin naa nusachwiik kiwach, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Re' i tinamit wili ma' xkinimaj taj inq'orarik keh ruum i nuDios,</para>
  <para style="q">ruum aj re' naakiq'eb'ariik ruum,</para>
  <para style="q">re' keh xanaa chik kojiik chi b'ehik naah taq tinamit, inki i Oseas.</para>
  <chapter number="10" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' taqe i aj Israel je' naq</para>
  <para style="q">kiholwochiil i ruche'el i uuva q'e' wachinik.</para>
  <para style="q">Nik' wach noq xk'ihaaxb'ik i chib'ih keh,</para>
  <para style="q">je' wo' re' noq ink'ihaaxb'ik i kiartaal inkiyejaa'.</para>
  <para style="q">Eh noq xa holohik chik i kitik i nelik,</para>
  <para style="q">ma' k'isiin i tiyoox xkiyejaa' ruuk' holohaq ab'aj.</para>
  <para style="q">
    <verse number="2" style="v" />Re' taqe i aj Israel xak'ul inki a'n kiwach,</para>
  <para style="q">ruum aj re' naa kitojom riij i kimahk.</para>
  <para style="q">Re' i QaJaaw Dios naa ruyojwiik i kiartaal,</para>
  <para style="q">eh naa rusacham kiwach taqe i kitiyoox.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh re' i tinamit wili, je' wili naa kiq'orom:</para>
  <para style="q">Yu'naak aj re' ma' xta chik qareey,</para>
  <para style="q">ruum ma' xqayohleej ta wach i Dios.</para>
  <para style="q">Eh ¿Wilik ta wo' naq qareey mi nee ta wo' naq qohrutoob'eej?</para>
  <para style="q">
    <verse number="4" style="v" />Eh xa kichoqik chi q'orik, inkiq'or i korik chi wilik i naa kianam,</para>
  <para style="q">xama' inki a'n ta wo' hoq.</para>
  <para style="q">Eh re' i q'ataj q'orik inki a'n xakaansanik i ruk'am chaloq,</para>
  <para style="q">xa je' rukab' i ch'ahn inkansanik reh i tik, inko'q taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' taqe i aj Samaria xakib'arb'otik chik,</para>
  <para style="q">xasuq chik kioq'ik,</para>
  <para style="q">noq xkib'iraj chi naa rusahchiik wach imas wakax tiyoox wilik Bet-aven.</para>
  <para style="q">Ruum i re' q'e' ti' kik'ux taqe i tinamit, taqe k'amal kib'eeh aj tiij,</para>
  <para style="q">re' i runimaal kiwach naa rojiik sahchoq wach.</para>
  <para style="q">
    <verse number="6" style="v" />Eh re' i ki imas wakax tiyoox,</para>
  <para style="q">naa ruk'amariik reje Asiria naa ruye'ariik chi rukooch i runimaal wach reey.</para>
  <para style="q">Ruuk' i re' naakik'ixiik i aj Efraín.</para>
  <para style="q">Eh re' aj Israel naa wo' kik'ixiik ruum i kitiyoox.</para>
  <para style="q">
    <verse number="7" style="v" />Re' taqe i aj Samaria naa rehtesjiik i rajaawriik,</para>
  <para style="q">i kireey naa rukahniik chi xa je' chik rukab' i ma' ahl ta laj sohk' k'ul inooj naa ha'.</para>
  <para style="q">
    <verse number="8" style="v" />Eh naakiyojib'iik i rupaat i kitiyoox chinaah taqe i yuuq',</para>
  <para style="q">re' kimahkunik wii' i aj Israel chulooq'jiik i tiyoox.</para>
  <para style="q">Eh chinaah taqe i kiartaal naa rupoq'iik i k'iix taqe i yiib' wach ch'ahn,</para>
  <para style="q">je' wili naa kiq'orom i tinamit reh taqe i nimaq taq yuuq':</para>
  <para style="q">Tiq'ehb'oq cho chi qanaah, chatz'ap qanaah, inko'q taqe, inki Oseas.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' taqe i aj Israel xama' kikanaam ta wo' i mahk</para>
  <para style="q">chi nuwach kitoq'aam cho Gabaa,</para>
  <para style="q">ruum aj re' na' b'anroq i q'aq'inik naa</para>
  <para style="q">rusachariik kiwach i aj Gabaa yiib' wach kina'ojb'al.</para>
  <para style="q">
    <verse number="10" style="v" />Re' hin naa nuye'em taqe i chutojariik i kimahk i tinamit re' re',</para>
  <para style="q">xanik' pa' nwaaj i hin.</para>
  <para style="q">Eh noq naa nuye'em taqe panti' k'axik i hin</para>
  <para style="q">naa wo' ruchaliik b'anoq keh kuum i tokoom tinamit.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' taqe i aj Efraín inki a'n reh i tinamit</para>
  <para style="q">je' rukab' i rub'an i b'ooyax noq i ruyeq' paam i trigo reh i rupotz'ariik.</para>
  <para style="q">Ruum aj re', re' hin xnuyeew ahl laj ihq chikinaah.</para>
  <para style="q">Re' i aj Judá je' naa nukojom taqe chi b'anaj arado,</para>
  <para style="q">eh re' taqe i riih rumaam i Jacob je' naa</para>
  <para style="q">naa nukojom taqe chi rulak'ariik wach aak'al.</para>
  <para style="q">
    <verse number="12" style="v" />Re' korik taq cha tik, re' i k'axooj taq neenajach</para>
  <para style="q">ruum re' i rutik ju'jun re' wo' re' naa rujacham,</para>
  <para style="q">cha yejaa' taq awiib' je' rukab' noq inab'ixjik wach aak'al reh i tik.</para>
  <para style="q">Ruum ruq'ijil chik i rusik'ariik i QaJaaw Dios,</para>
  <para style="q">korehtaal i ruyeew chi manlik i ko'lemb'al taq awiib'.</para>
  <para style="q">
    <verse number="13" style="v" />Re' taq i hat re' i yiib' wach na'ojb'al taq i xatik</para>
  <para style="q">re' i ti' k'axik taq k'ahchi' ajacham</para>
  <para style="q">re' chik xak'am taq naah taqe i chukuj q'orik.</para>
  <para style="q">Eh ruum chi xayeew taq ak'ux chikinaah taqe i kareta reh q'aq'inik,</para>
  <para style="q">je' wo' chikinaah taqe i soldado.</para>
  <para style="q">
    <verse number="14" style="v" />Eh naa ruwihiik tukinik iib' taq chaxilak,</para>
  <para style="q">naa rusacham kiwach chu'nchel inako'leej naq taq wii' awiib',</para>
  <para style="q">je' rukab' noq xusach wach i tinamit Bet-arbel</para>
  <para style="q">i reey Salma rub'ihnaal re' noq xub'an i q'aq'inik,</para>
  <para style="q">noq xukansaj taqe i tuutb'ees taqe i kak'uun kixq'uun.</para>
  <para style="q">
    <verse number="15" style="v" />Re' taq i hat aj Israel i wilkaat taq ar Bet-el je' re' taq i naa ak'ulum</para>
  <para style="q">ruum taq ayiib' wach ana'ojb'al,</para>
  <para style="q">eh re' taq aareey xa chi jumehq'iil naa rusachariik wach,</para>
  <para style="q">xa je' rukab' noq inchalik rusaq'iik, inki i QaJaaw Dios.</para>
  <chapter number="11" style="c" />
  <para style="s">Re' Dios i ruk'ax taqe i rutinamiit atoob' ta ma' kinimanik ta chuwach</para>
  <para style="q">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Noq xkitoq'aa' cho nimanik i aj Israel xnuk'ax taqe.</para>
  <para style="q">Eh xnukoj taqe chi wak'uun wixq'uun xwesaj taqe chaloq i Egipto.</para>
  <para style="q">
    <verse number="2" style="v" />Eh noq q'e' naq nuk'ax taqe, xkesaj iloq kiib' chi wiij.</para>
  <para style="q">Eh chikiwach chik i ma' re' ta taqe i dios inkik'at i kimayiij,</para>
  <para style="q">inkik'at i insensia chikiwach taqe i tiyoox.</para>
  <para style="q">
    <verse number="3" style="v" />Atoob' ta je' re' inki a'n re' hin xnuk'am kib'eeh i aj Efraín eh xnuchop chi kiq'ab',</para>
  <para style="q">eh xnuk'uhtaaj cho keh i nimanik.</para>
  <para style="q">Re' keh xama' xkireq ta wo' chi riij chi re' hin xincha'jinik cho keh.</para>
  <para style="q">
    <verse number="4" style="v" />Re' hin ruuk' q'unil,</para>
  <para style="q">ruuk' k'axooj xnuk'am taqe cho wuuk',</para>
  <para style="q">eh xwisaj i ahl laj ihq wilik naq chikinaah,</para>
  <para style="q">xnuyeew wo' kiwa' kihaa' parub'ehel.</para>
  <para style="q">
    <verse number="5" style="v" />Xa re' la' re' keh ma' xinkaaj ta chik kiin kinimam,</para>
  <para style="q">ruum i re', re' chik taqe i aj Asiria naa rub'aniik i kowlaj taaq'anik chikinaah,</para>
  <para style="q">je' rukab' i xkik'ul chaloq Egipto.</para>
  <para style="q">
    <verse number="6" style="v" />Eh naa rub'aan ikaansanik ruuk' i q'aslaj ch'ihch' pan kitinamiit,</para>
  <para style="q">eh naa rusachariik kiwach aha' naq inkiko'leej kiib',</para>
  <para style="q">ruum xa chi kutkeel inkiyejaa' wach chib'ih inki a'n</para>
  <para style="q">
    <verse number="7" style="v" />Re' i nutinamiit xama' kinkaaj ta wo' kinimam yu'naak,</para>
  <para style="q">inkik'er wo' naq kichii' chi re' hin i Dios,</para>
  <para style="q">xa re' la' ma' jino'q inye'wik runimaal nuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />¿Chib'ih reet noq nee taq tinukanaa' i hat aj Efraín?</para>
  <para style="q">¿Chib'ih reet noq nee taq tinukanaa' pan kiq'ab'</para>
  <para style="q">i ki-ixowanik taq awach i hat taq aj Israel?</para>
  <para style="q">¿Mi ruk'ul re' chi nee taq i nusach awach i hat,</para>
  <para style="q">je' rukab' noq xnusach kiwach i aj Adma, i aj Zeeboim?</para>
  <para style="q">Re' wánima xan yot'ik chik, ruum i nuketelaaj taq awach.</para>
  <para style="q">
    <verse number="9" style="v" />Eh ma' naa ta nuye'em i nujosq'iil taq cha naah,</para>
  <para style="q">ma' naa ta nusacham taq awach hat aj Efraín,</para>
  <para style="q">ruum re' hin, hin Dios ma' hin ta xa winaq.</para>
  <para style="q">Re' hin i Dios wilik nu Sahtohiil wilkiin taq panaxilak,</para>
  <para style="q">ma' xin chalik ta chi rusachariik taq awach.</para>
  <para style="q">
    <verse number="10" style="v" />Re' hin naa nuk'erem nuchii' je' rukab' i rub'an i kaq b'ahlam</para>
  <para style="q">chi kiyohb'eesjiik i ki-ixowanik wach i nutinamiit.</para>
  <para style="q">Eh re' keh xakib'arb'otik chik</para>
  <para style="q">ruum i kiyo'jiik noq naa kichaliik chi korkiil i rookb'aal q'iij,</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' keh naakeliik chaloq Egipto chi jumehq'iil</para>
  <para style="q">je' kirupinik chaloq i tz'ikin.</para>
  <para style="q">Eh je' kirupinik chaloq paloma noq naakeliik chaloq Asiria.</para>
  <para style="q">Re' hin naa wo' chik nuye'em taqe chi patinik pan kiye'aab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Eh re' taqe i aj Efraín xa re' i chukuj q'orik inki a'n chi nuwach.</para>
  <para style="q">Eh re' taqe i aj Israel xa re' i nujot'ariik inki a'n</para>
  <para style="q">Re' taqe i aj Judá xin kiq'eb' chi riij kik'ux i hin,</para>
  <para style="q">re' chik taqe i xa tiyoox xkini imaj, inki i Dios.</para>
  <chapter number="12" style="c" />
  <para style="s">Re' i yiib' wach na'ojb'al xkian i rutinamiit i Dios</para>
  <para style="q">
    <verse number="1" style="v" />Re' taqe i aj Efraín re' teew inchalik</para>
  <para style="q">pareelb'aal q'iij inye'wik kikowiil rajlaal i q'iij.</para>
  <para style="q">Eh inkitiq naah i chukuj q'orik,</para>
  <para style="q">i ti' k'axik inki a'n reh i kas kichaaq,</para>
  <para style="q">wilik inkiyejaa' wach kuuk' i aj Asiria,</para>
  <para style="q">eh inkisiij reje ink'ohnik laj aseite</para>
  <para style="q">keh i aj Egipto, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' i QaJaaw Dios xchalik</para>
  <para style="q">ruk'aah chikinaah i aj Judá,</para>
  <para style="q">naa ruye'em taqe chutojariik</para>
  <para style="q">i kimahk i riih rumaam Jacob,</para>
  <para style="q">eh naa rutojom keh re' q'oreel</para>
  <para style="q">chib'ih xkian i xkiq'or.</para>
  <para style="q">
    <verse number="3" style="v" />Eh noq x-aasjik i Jacob,</para>
  <para style="q">ruchopom i ralaq rooq i ras Esaú noq x-aasjik.</para>
  <para style="q">Eh noq xwinaaqb'ik i Jacob xupaj</para>
  <para style="q">ransil ruuk' i ruánjel i Dios.</para>
  <para style="q">
    <verse number="4" style="v" />Eh xupaj ransil ruuk' i ánjel,</para>
  <para style="q">eh xuq'at wach i ransil i ánjel,</para>
  <para style="q">xupahqaaj reh i Dios ruuk' oq'ik chi naa rukuxeesjiik.</para>
  <para style="q">Ar Bet-el xuk'uhtaaj riib' i Dios chuwach,</para>
  <para style="q">xkuxeesjik wo' hoq, reh chi xooj rukuxisaj i hoj.</para>
  <para style="q">
    <verse number="5" style="v" />Re' i QaJaaw nim rajaawriik xkuxisanik</para>
  <para style="q">reh i Jacob QaJaaw Dios i rub'ihnaal.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taq i hat, hat taq riih rumaam i Jacob cha nimaj wo' taq chik aaDios,</para>
  <para style="q">re' i holohik laj na'ojb'al taq cha a'n,</para>
  <para style="q">eh chayeew taq ak'ux ruuk' aaDios.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' taqe i aj Canaán ma' manlik ta kipajwik ruuk' i kipex ruum q'e' suq keh i leq'.</para>
  <para style="q">
    <verse number="8" style="v" />Eh re' taqe i aj Efraín je' wili inkiq'or:</para>
  <para style="q">Re' hoj xoj b'ehomrik ruum xqareq ruraxiil qaq'iij.</para>
  <para style="q">Ma' awach ta neen q'orik qeh chi ma' holohik taj inqa a'n,</para>
  <para style="q">ma' nee ta nq'orarik chi ruuk' i leq' xqareq tz'aaq' i chib'ih qeh, inki taqe.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hin i Dios, hin xineesanik taq cha weh Egipto,</para>
  <para style="q">eh naa wo' chik taq kaat nuye'em chi patinik chupaam taqe itz'ihy naah paat.</para>
  <para style="q">Je' rukab' noq</para>
  <para style="q">i na a'n taq chaloq aninq'iij.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Eh re' hin xin sik'wik cho kiwach taqe ijalal nuq'oral nutaq'aaj taq cho chaxilak,</para>
  <para style="q">eh ma' k'isiin taqe i xnuk'uhtaaj keh pan kisaq wiriik.</para>
  <para style="q">Eh kuum keh xinq'orik panjalwaach q'orik.</para>
  <para style="q">
    <verse number="11" style="v" />Eh ar Galaad ma' k'isiin taqe i tiyoox,</para>
  <para style="q">xa re' la' ma' re' ta wo' taqe i Dios.</para>
  <para style="q">Eh ar Gilgal inkik'at chi kimayiij taqe imas wakax,</para>
  <para style="q">re' taqe i ki altaar xa je' juntuhb' chi ab'aj chupaam taqe i tik mu'uun, inki i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' i Jacob i xikin taq cho aamaam</para>
  <para style="q">xumol chi elik chupaam i ye'aab' Aram ar xooj chusik'ariik i rehk'een.</para>
  <para style="q">Eh ar xkamanik chi cha'jinik tentzun.</para>
  <para style="q">
    <verse number="13" style="v" />Re' QaJaaw Dios, ruuk' jinaj i jalal ruq'oral xrisaj taqe chaloq i aj Israel ar Egipto.</para>
  <para style="q">Eh ruuk' wo' hoq i jalal ruq'oral xucha'jeej taqe i aj Israel.</para>
  <para style="q">
    <verse number="14" style="v" />Re' taqe i aj Efraín ma' k'isiin taj i rujosq'iil i Dios xkuksaj chaloq.</para>
  <para style="q">Re' i QaJaaw Dios naa ruye'em chutojariik taqe ikaansanik kianam,</para>
  <para style="q">naa kitojom wach i kiyiib' wach na'ojb'al kianam.</para>
  <chapter number="13" style="c" />
  <para style="s">Re' QaJaaw Dios xusach kiwach i aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Eh noq kiq'orik naq i aj Efraín kiyo'jik naq taqe aj Israel,</para>
  <para style="q">eh inkiyeew naq rajaawriik, xa re' la' taqe i aj Efraín xsacharik kiwach,</para>
  <para style="q">ruum re' chik i tiyoox Baal xkinimaj.</para>
  <para style="q">
    <verse number="2" style="v" />Re' taqe i aj Efraín xama' xkikanaa' ta wo' rub'aan i mahk</para>
  <para style="q">xa konkiyej-aa' wo' kitiyoox chi plata,</para>
  <para style="q">re' inkik'ax wach taqe i ye'jan reh, eh je' wili inkiq'or:</para>
  <para style="q">Chak'at taq i mayiij chikiwach, inki taqe.</para>
  <para style="q">Eh inkitz'ub' taqe i tiyoox je' kiwii' k'isa imas wakax.</para>
  <para style="q">
    <verse number="3" style="v" />Je' re' noq ilook' insacharik kiwach</para>
  <para style="q">xa je' ki-ik'ik suutz' pantaq wahq'eq, je' kikab' i mus jab' parusaq'iik,</para>
  <para style="q">jumehq'iil insahchik wach.</para>
  <para style="q">Eh je' kikab' i ma' ahl ta laj sohk', ink'amarik reje ruum i teew,</para>
  <para style="q">xa je' kikab' i sib' i nelik chaloq pan ehteesb'al reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' hin taq aaDios noq xat wihik taq cho Egipto,</para>
  <para style="q">eh ma' awach ta chik taq i xakoj chi aaDios, xa re' wo'</para>
  <para style="q">hin taq awaj ko'loom.</para>
  <para style="q">
    <verse number="5" style="v" />Eh re' hin xincha'jinik taq aweh chupaam i ye'aab' chiq yuuq'</para>
  <para style="q">ma' xta i nelik chupaam.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Noq wilkaat taq chik chupaam i holohik</para>
  <para style="q">ye'aab' suq taq chik awa' ahaa'</para>
  <para style="q">xa nimb'isaj taq awiib' xsahchik taq panak'ux i nunimjiik.</para>
  <para style="q">
    <verse number="7" style="v" />Re' hin naa taq nusacham awach,</para>
  <para style="q">je' rukab' i rub'an i kaq b'ahlam noq i ruchop i rutiib'.</para>
  <para style="q">Eh je' rukab' i rub'an i qamaam b'ahlam noq i ruchop i rutiib' chii' b'eeh.</para>
  <para style="q">
    <verse number="8" style="v" />Re' hin naa ruchaliik nujosq'iil,</para>
  <para style="q">je' rukab' i rujosq'iil ixoq oso xq'ucharik i rak'uun.</para>
  <para style="q">Ar naa nub'anam taq aweh, je' rukab' noq i ruk'ux i rutiib' i kaq b'ahlam.</para>
  <para style="q">Naa nusacham taq awach je' rukab' i rub'an</para>
  <para style="q">reh i rutiib' i josq'laj chikop wilik pantaq ch'ahn.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hin naa nusacham taq awach i hat taq aj Israel,</para>
  <para style="q">eh ma' awach ta naa ruko'liniik taq aweh.</para>
  <para style="q">
    <verse number="10" style="v" />Eh ¿Aha' wilik taq aareey apahqaam taq weh,</para>
  <para style="q">i kiko'linik naq taq aweh panatinamiit?</para>
  <para style="q">¿Aha' wilik taqe i q'atal q'orik xiye'arik taq aweh</para>
  <para style="q">noq xapahqaaj taq aareey ruch'ihil taq i k'amal ab'eeh?</para>
  <para style="q">
    <verse number="11" style="v" />Re' hin ruuk' josq'iil xnuyeew taq aweh aareey</para>
  <para style="q">eh ruuk' wo' chik nujosq'iil xwesaj taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Eh re' taqe i kimahk i aj Efraín</para>
  <para style="q">wilik panuk'ux, re' taqe i kiyiib' wach na'ojb'al</para>
  <para style="q">ma' naa ta reliik panuk'ux.</para>
  <para style="q">
    <verse number="13" style="v" />Re' ti' k'axik chalik reh chikinaah, je' rukab' i ruti'kiil ixoq noq ink'ulik ruk'ux.</para>
  <para style="q">Eh je' kikab' xa aasjik chik reh,</para>
  <para style="q">ma' nasjik ta wo' chi korik,</para>
  <para style="q">ma' xta runa'ojb'al, ni xata ruyeew riib' chi korik reh chi neenasjiik.</para>
  <para style="q">
    <verse number="14" style="v" />¿Mi neerub'an re' chi nee taqe inuko'leej ruuk' inki a'n?</para>
  <para style="q">¿Mi neerub'an re' chi nee taqe inuko'leej chuwach i rutojariik taqe amahk?</para>
  <para style="q">Re' i rajaawriik i kimik nuye'em chik chikinaah.</para>
  <para style="q">Ma' naa ta chik nuketelaam kiwach.</para>
  <para style="q">
    <verse number="15" style="v" />Atoob' ta naq nee kik'ihaaxb'iik,</para>
  <para style="q">je' rukab' noq intoxlinik i chee', nee inwihik chib'ih keh.</para>
  <para style="q">Re' hin naa nuye'em i kowlaj teew inchalik panchiq yuuq',</para>
  <para style="q">sachb'al wach i chib'ih keh.</para>
  <para style="q">Naa ruchiqiik i raasb'al kihaa'</para>
  <para style="q">naa relq'jiik kib'ehomal kuum ixowan kiwach.</para>
  <para style="q">
    <verse number="16" style="v" />Eh naa nuye'em taqe panti' k'axik i aj Samaria,</para>
  <para style="q">ruum xin kiq'eb' chi riij kik'ux.</para>
  <para style="q">Eh naa kikanteesjiik ruuk' q'aslaj ch'ihch',</para>
  <para style="q">naakiq'ojariik wataq ab'aj i kiha'lak'uun.</para>
  <para style="q">Re' taqe i yowaab' ixoq naakipoch'ariik, inki i Dios.</para>
  <chapter number="14" style="c" />
  <para style="s">Re' Oseas xupahqaaj otob'il keh i aj Israel chi kinimaj wo' chik i Dios</para>
  <para style="q">
    <verse number="1" style="v" />Re' Oseas je' wili i xuq'or:</para>
  <para style="q">Hat taq aj Israel cha sik' wo' taq chik aaDios,</para>
  <para style="q">ruum xaq'eb' taq awiib', ruum taq amahk.</para>
  <para style="q">
    <verse number="2" style="v" />Chapahqaaj wo' taq chik kuyb'al amahk reh, je' taq wili i cha q'or:</para>
  <para style="q">QaJaaw Dios cha kuy ta tii qamahk</para>
  <para style="q">ruuk' i yiib' wach na'ojb'al inqa a'n.</para>
  <para style="q">Eh chak'ul ta tii qeh panotob'il i qatiij,</para>
  <para style="q">je' wo' hoq aloq'oonjiik inqa a'n</para>
  <para style="q">
    <verse number="3" style="v" />Qohako'leej i hat ruum re' taqe i aj Asiria ma' nkian ta qako'ljiik.</para>
  <para style="q">Eh ma' nee ta wo' inqako'leej qiib' chi nee qohooj chi q'aq'inik rij kawáyu,</para>
  <para style="q">eh ma' nee ta chik inqakoj chi qadios taqe i tiyoox xa hoj qohyej-aanik keh,</para>
  <para style="q">ruum xa re' wo' hat tiketelinik kiwach i ma' xta kituut kajaaw, tiko'q taq, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' hin naa wesam i q'etwachiil pankanima i aj Israel.</para>
  <para style="q">Eh naa wo' chik nuketelaam kiwach naa wesam i nujosq'iil chikinaah.</para>
  <para style="q">
    <verse number="5" style="v" />Re' hin naa nukamaniik, chi je'</para>
  <para style="q">hin i jab' chi keh i aj Israel.</para>
  <para style="q">Re' keh naa kikahniik chi je'</para>
  <para style="q">rukab' noq ink'er i saq uhtz'ub',</para>
  <para style="q">naa rukowjiik kik'ux je' rukab'</para>
  <para style="q">noq i ruk'am raa' i chee'</para>
  <para style="q">chakaltee' ar Líbano.</para>
  <para style="q">
    <verse number="6" style="v" />Eh re' keh naa kik'ihaaxb'iik</para>
  <para style="q">je' rukab' noq ink'ihaaxb'ik</para>
  <para style="q">i q'ab' chee', je' holwochiil i q'ab' i chee' olivo.</para>
  <para style="q">Eh re' i kik'ohnkiil,</para>
  <para style="q">je' kik'ohnkiil i chee'</para>
  <para style="q">chakaltee' ar Líbano.</para>
  <para style="q">
    <verse number="7" style="v" />Re' taqe i aj Israel, re' wo' chik</para>
  <para style="q">i hin naa nucha'jiniik keh.</para>
  <para style="q">Eh naa kik'ihaaxb'iik,</para>
  <para style="q">je' rukab' i trigo,</para>
  <para style="q">je' rukab' noq kiwachinik</para>
  <para style="q">i uuva, naa reliik kib'iral,</para>
  <para style="q">je' rukab' i riis uuva i nelik ar Líbano.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taqe i aj Efraín je' wili i naa kiq'orom:</para>
  <para style="q">¿Mi koneenqakoj chi qadios re' i tiyoox? inko'q taqe.</para>
  <para style="q">Je' wili i naa nuq'orom keh:</para>
  <para style="q">Re' hin naa nucha'jiniik taq aweh,</para>
  <para style="q">naa nuye'em taq aweh chib'ih</para>
  <para style="q">taq inawaaj i hat, hat taq nutinamiit.</para>
  <para style="q">Re' hin, je' hin jinaj chee'</para>
  <para style="q">xa eliik rax wach reh chi naa kiwachiniik,</para>
  <para style="q">kinko'q keh, inki i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Wila' wilik jino'q i wilik runa'ojb'al taq chaxilak</para>
  <para style="q">chureq chi riij taqe i k'uhb'aal wili.</para>
  <para style="q">Re' i rub'eeh i QaJaaw Dios korik wach,</para>
  <para style="q">eh re' re' inkik'am i korik wach kik'ux.</para>
  <para style="q">Eh re' taqe i yiib' wach kina'ojb'al</para>
  <para style="q">ma' nkik'am taj ruum i re' inkiq'eb' kiib'.</para>
</usx>