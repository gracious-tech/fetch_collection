<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="1CH" style="id">1CHPOK.SFK 24-01-2,008. Adeliana Quej. Pocomchi. Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">1 CRONICAS</para>
  <para style="toc3">1 Cron</para>
  <para style="toc2">1 Cron</para>
  <para style="toc1">1 CRONICAS</para>
  <para style="mt2">RE' I PEET RUHUUJ I CRONICAS</para>
  <para style="mt1">1 CRONICAS</para>
  <chapter number="1" style="c" />
  <para style="s">Re' taqe wili i riih rumaam Adán xponik ko ruuk' i Noé</para>
  <para style="p">
    <verse number="1" style="v" />Re' Adán rajaaw i Set, re' Set rajaaw i Enós. <verse number="2" style="v" />Re' Enós rajaaw i Cainán, re' i Cainán rajaaw i Mahalaleel rajaaw Jared. <verse number="3" style="v" />Re' Jared rajaaw i Enoc, re' Enoc rajaaw i Matusalén, re' Matusalén rajaaw i Lamec, re' Lameac rajaaw i Noé.</para>
  <para style="s">Re' taqe wili i rak'uun, eh riih rumaam Noé</para>
  <para style="r">(<ref loc="GEN 10:1-32">Gen 10.1-32</ref>)</para>
  <para style="p">
    <verse number="4" style="v" />Re' Noé je' wili i kib'ihnaal i rak'uun: Sem, Cam, Jafet.</para>
  <para style="p">
    <verse number="5" style="v" />Re' Jafet je' wili i kib'ihnaal i rak'uun: Gomer, Magog, Madai, Javán, Tubal, Mesec, Tiras. <verse number="6" style="v" />Re' Gomer je' wili i kib'ihnaal i rak'uun: Askenaz, Rifat, Togarma. <verse number="7" style="v" />Re' Javán je' wili kib'ihnaal i rak'uun: Elisa, Tarsis, Quitim, Dodanim.</para>
  <para style="p">
    <verse number="8" style="v" />Re' Cam je' wili i kib'ihnaal i rak'uun: Cus, Mizraim, Fut, Canaán. <verse number="9" style="v" />Re' Cus je' wili i kib'ihnaal i rak'uun: Seba, Havila, Sabta, Raama, Sabteca. Re' i Raama je' wili kib'ihnaal i rak'uun: Seba, Dedán. <verse number="10" style="v" />Re' Cus rajaaw i Nimrod re' i peet xwihik rajaawriik chupaam i ye'aab' re' re'. <verse number="11" style="v" />Re' i Mizraim, rumaam rati't taqe aj Ludim, taqe i aj Anamim, taqe aj Lehabim, taqe i aj Naftuhim. <verse number="12" style="v" />Je' wo' taqe i aj Patrusim, taqe i aj Casluhim. Re' i Patrusim, i Casluhim re' taqe re' i kimaam kati't aj filisteo, je' wo' taqe i aj Caftoreos. <verse number="13" style="v" />Re' i Canaán re' i rajaaw i Sidón i peet rak'uun, eh re' i Het. <verse number="14" style="v" />Re' i Canaán rumaam rati't taqe i aj jebuseo, taqe i aj amorreo, taqe i aj gergeseo. <verse number="15" style="v" />Je' wo' taqe i aj heveo, taqe i aj araceo, <verse number="16" style="v" />taqe i aj arvadeo, taqe i aj zemareo, taqe i aj hamateo.</para>
  <para style="p">
    <verse number="17" style="v" />Re' taqe i rak'uun i Sem, je' wili kib'ihnaal: Elam, Asur, Arfaxad, Lud, Aram. Re' taqe rak'uun i Aram je' wili i kib'ihnaal: Uz, Hul, Geter, Masec. <verse number="18" style="v" />Re' Arfaxad rajaaw i Sela. Re' i Sela rajaaw i Heber. <verse number="19" style="v" />Re' Heber kiib' i rak'uun xwihik, re' peet rak'uun Peleg i rub'ihnaal ruum chupaam i ruq'ijil i reh xkich'aqib'eej kiib' i k'achareel wach ak'al. Re' rak'uun jinaj chik i Joctán. <verse number="20" style="v" />Re' Joctán rajaaw i Almodad, i Selef, i Hazar-mavet i Jera, <verse number="21" style="v" />i Adoram, i Uzal, i Dicla, <verse number="22" style="v" />i Ebal, i Abimael, i Seba, <verse number="23" style="v" />i Ofir, i Havila, i Jobab, chu'nchel i re' rak'uun i Joctán.</para>
  <para style="s">Re' taqe i riih rumaam Sem</para>
  <para style="r">(<ref loc="GEN 11:10-26">Gen 11.10-26</ref>)</para>
  <para style="p">
    <verse number="24" style="v" />Re' Sem rajaaw i Arfaxad, re' Arfaxad rajaaw i Sela. <verse number="25" style="v" />Eh re' Sela rajaaw i Heber, re' i Heber rajaaw i Peleg, re' i rajaaw i Reu. <verse number="26" style="v" />Re' Reu rajaaw i Serug, re' Serug rajaaw i Nacor, re' i rajaaw i Taré. <verse number="27" style="v" />Re' Taré rajaaw i Abram, eh Abraham wo' inkiq'or reh.</para>
  <para style="s">Re' taqe i riih rumaam Ismael i Cetura</para>
  <para style="r">(<ref loc="GEN 25:1-6">Gen 25.1-6</ref>,<ref loc="GEN 25:12-18">12-18</ref>)</para>
  <para style="p">
    <verse number="28" style="v" />Re' Abraham, Isaac, Ismael kib'ihnaal i rak'uun. <verse number="29" style="v" />Re' Abraham je' wili kib'ihnaal i riih rumaam: Nebaiot i peet rak'uun, Ismael, re' Cedar Adbeel, Mibsam. <verse number="30" style="v" />Mismá, Duma, Maasa, Hadad, Tema. <verse number="31" style="v" />Re' Jetur, Nofis, i Cedema chu'nchel i re' rak'uun taqe i Ismael.</para>
  <para style="p">
    <verse number="32" style="v" />Re' i Cetura rukab'ruxoqil i Abraham, je' wili kib'ihnaal i rak'uun: Zimram, Jocsán, Medán, Madián, Isbac, Súa. Re' i Jocsán Seba, Dedán kib'ihnaal i rak'uun. <verse number="33" style="v" />Re' Madián je' wili i kib'ihnaal i rak'uun, Efa, Efer, Hanoc, Abida, Elda. Chu'nchel i re' riih rumaam i Cetura.</para>
  <para style="s">Re' taqe i riih rumaam Esaú</para>
  <para style="r">(<ref loc="GEN 36:1-43">Gen 36.1-43</ref>)</para>
  <para style="p">
    <verse number="34" style="v" />Re' Abraham rajaaw Isaac. Re' Isaac kajaaw Esaú, i Israel, Jacob wo' inkiq'or reh. <verse number="35" style="v" />Re' Esaú je' wili kib'ihnaal i rak'uun: Elifaz, Reuel, Jeús, Jaalam, Coré. <verse number="36" style="v" />Re' i Elifaz je' wili i kib'ihnaal i rak'uun: Temán, Omar, Zefo, Gatam, Cenaz, eh re' i Amalec re' i xwihik ruuk' i Timna rukab'ruxoqil. <verse number="37" style="v" />Re' Reuel je' wili i kib'ihnaal i rak'uun: Nahat, Zera, Sama, Mizá.</para>
  <para style="p">
    <verse number="38" style="v" />Re' Seir je' wili kib'ihnaal i rak'uun: Lotán, Sobal, Zibeón, Aná, Disón, Ezer, Disán. <verse number="39" style="v" />Re' Lotán je' wili kib'ihnaal i rak'uun: Hori, Homam. Re' i Timna ranaab' i Lotán. <verse number="40" style="v" />Re' Sobal je' wili kib'ihnaal i rak'uun: Alván, Manahat, Ebal, Sefo, Onam. Re' taqe rak'uun i Zibeón, re' Aja, re' Aná. <verse number="41" style="v" />Re' Aná rajaaw i Disón. Re' Disón je' wili kib'ihnaal i rak'uun: Amram, Esbán, Itrán, Querán. <verse number="42" style="v" />Re' Ezer je' wili kib'ihnaal i rak'uun: Bilhán, Zaaván, Jaacán. Re' taqe rak'uun i Disán, re' Uz, re' i Arán.</para>
  <para style="p">
    <verse number="43" style="v" />Re' i reey xi wihik chi taaq'anik Edom noq komajaa' chih kireey i aj Israel, je' wili kib'ihnaal: Re' peet re' Bela rak'uun i Beor aj pan tinamit Dinaba. <verse number="44" style="v" />Noq xkimik reje i Bela re' chik i Jobab rak'uun i Zera xkahnik chi reyil chi jilow, aj pan tinamit Bosra. <verse number="45" style="v" />Noq xkimik reje i Jobab, re' chik i Husam xkahnik chi reyil chi jilow, aj panruyuq'ul i Temán. <verse number="46" style="v" />Noq xkimik reje i Husam re' chik i Hadad rak'uun i Bedad xkahnik chi reyil chi jilow. Re' Hadad re' i xb'anik keh i aj Madián chupaam i ye'aab' Moab aj pan tinamit Avit. <verse number="47" style="v" />Noq xkimik reje i Hadad re' chik i Samla xkahnik chi reyil chi jilow aj pan tinamit Masreca. <verse number="48" style="v" />Noq xkimik reje i Samla re' chik i Saúl xkahnik chi reyil chi jilow aj pan tinamit Rehobot wilik chi chii' i nim ha' Éufrates. <verse number="49" style="v" />Noq xkimik reje i Saúl, re' chik i Baal-hanán i rak'uun i Acbor xkahnik chi reyil chi jilow. <verse number="50" style="v" />Noq xkimik reje i Baal-hanán re' chik i Hadad xkahnik chi reyil chi jilow, aj pan tinamit Poi. Re' i rehk'een i Hadad Mehetabel i rub'ihnaal rixq'uun i Matred, eh riih i Mezaab.</para>
  <para style="p">
    <verse number="51" style="v" />Noq xkimik reje i Hadad re' taqe i k'amal kib'eeh i aj Edom je' wili i kib'ihnaal: Timna, Alva, Jetet. <verse number="52" style="v" />Re' Aholibama, Ela, Pinón, <verse number="53" style="v" />Cenaz, Temán, Mibzar, <verse number="54" style="v" />Magdiel, Iram. Chu'nchel i re' xi wihik chi k'amal kib'eeh i aj Edom.</para>
  <chapter number="2" style="c" />
  <para style="s">Re' taqe i rak'uun i Israel (Jacob wo' inkiq'or reh)</para>
  <para style="r">(<ref loc="GEN 35:22-26">Gen 35.22-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Re' Israel je' wili i kib'ihnaal i rak'uun: Rubén, Simeón, Leví, Judá, Isacar, Zabulón. <verse number="2" style="v" />Dan, José, Benjamín, Neftalí, Gad, Aser.</para>
  <para style="s">Re' taqe i rak'uun, eh re' taqe i riih rumaam Judá</para>
  <para style="p">
    <verse number="3" style="v" />Re' Judá je' wili kib'ihnaal i rak'uun: Er, Onán, Sela. Re' i kituut ixib' chi rak'uun wili, re' Súa aj cananeo. Re' Er i peet rak'uun i Judá q'e' yiib' wach i runa'ojb'al xub'an chuwach i QaJaaw Dios, ruum i re' xkanteesjik ruum i Dios. <verse number="4" style="v" />Re' i Tamar i ril-iib' naq i Judá re' re' rutuut i Fares, i Zera. Je' re' noq re' Judá ho'oob' chi kiib' i rak'uun xwihik.</para>
  <para style="p">
    <verse number="5" style="v" />Re' Fares je' wili kib'ihnaal i rak'uun: Hezrón, Hamul. <verse number="6" style="v" />Re' Zera je' wili kib'ihnaal i rak'uun: Zimri, Etán, Hemán, Calcol, Dara, ho'oob' taqe chi kiib'.</para>
  <para style="p">
    <verse number="7" style="v" />Re' Carmi, Acán b'ih i rak'uun, re' i xk'amwik chee ti' k'axik chikinaah i aj Israel ruum i xuk'am chee reh taqe i ruq'orom i Dios chi naa rusahchiik kiwach.</para>
  <para style="p">
    <verse number="8" style="v" />Re' Etán Azarías b'ih i rak'uun.</para>
  <para style="p">
    <verse number="9" style="v" />Re' Hezrón je' wili kib'ihnaal i rak'uun: Jerameel, Ram, Quelubai. <verse number="10" style="v" />Re' Ram rajaaw i Aminadab, eh re' i Aminadab rajaaw i Naasón. Re' k'amal kib'eeh taqe rak'uun i Judá. <verse number="11" style="v" />Re' Naasón rajaaw Salmón, re' Salmón rajaaw Booz. <verse number="12" style="v" />Re' Booz rajaaw Obed, re' Obed rajaaw Isaí. <verse number="13" style="v" />Re' peet rak'uun i Isaí re' Eliab, re' rukab' re' Abinadab, re' roox, re' i Simea. <verse number="14" style="v" />Re' rukaaj re' Natanael, re' roo' re' Radai. <verse number="15" style="v" />Re' ruwaaq', re' i Ozem, re' ruwuuq', re' David. <verse number="16" style="v" />Re' Sarvia, i Abigail kanaab' i wuq'uub' chi rak'uun i Isaí. Re' i Sarvia ixib' i rak'uun xwihik je' wili kib'ihnaal: Abisai, Joab, Asael. <verse number="17" style="v" />Re' Abigail jinaj i rak'uun xwihik Amasa i rub'ihnaal, re' i Jeter i rajaaw aj Ismaelita.</para>
  <para style="p">
    <verse number="18" style="v" />Eh re' Caleb rak'uun i Hezrón xwihik rak'uun ruuk' i rehk'een Azuba, Jeriot rub'ihnaal. Re' taqe rak'uun i reh je' wili kib'ihnaal: Jéser, Sobab, Ardón. <verse number="19" style="v" />Eh noq xkimik reje i Azuba re' Caleb xub'an kaxáro ruuk' i Efrata, xwihik jinaj i rak'uun ruuk' Hur i rub'ihnaal. <verse number="20" style="v" />Re' Hur rajaaw Uri, eh re' Uri rajaaw Bezaleel.</para>
  <para style="p">
    <verse number="21" style="v" />Eh oxk'ahl haab' i wilik reh Hezrón noq xub'an kaxáro ruuk' i rixq'uun i Maquir, re' rajaaw Galaad, jinaj i rak'uun xwihik ruuk' Segub. <verse number="22" style="v" />Re' Segub rajaaw i Jair, re' i xwihik chi taaq'anik chinaah ixib' ru ka'winaq seht chi tinamit wilik ar Galaad. <verse number="23" style="v" />Xa re' la' re' Gesur, ruch'ihil i Aram xkichop naah i oxk'ahl seht chi rutinamiit i Jair, xkichop naah i tinamit Kenat ruch'ihil taqe i kok' ye'aab' wilkeeb' wii' patineel. Eh chu'nchel i re', re' ruuk' taqe i riih rumaam i Maquir rajaaw i Galaad.</para>
  <para style="p">
    <verse number="24" style="v" />Re' Hezrón xkimik ar Caleb wilik paruyuq'ul i Efrata. Noq kamnaq chik Hezrón xwihik jinaj i rak'uun i Abías, Asur i rub'ihnaal, re' Asur rajaaw i Tecoa.</para>
  <para style="p">
    <verse number="25" style="v" />Re' Jerameel i peet rak'uun i Hezrón je' wili kib'ihnaal i rak'uun: Rama i b'ih i peet rak'uun, Buna, Orén, Ozem, Ahías. <verse number="26" style="v" />Re' Jerameel xwihik wo' chik jinaj i rehk'een Atara i rub'ihnaal, re' i rutuut i Onam.</para>
  <para style="p">
    <verse number="27" style="v" />Eh re' Ram i peet rak'uun i Jerameel je' wili i kib'ihnaal i rak'uun: Maaz, Jamín, Eker. <verse number="28" style="v" />Re' Onam je' wili i kib'ihnaal i rak'uun: Samai, Jada. Re' Samai je' wili kib'ihnaal i rak'uun: Nadab, Abisur. <verse number="29" style="v" />Re' i Abisur, Abihail rub'ihnaal i rehk'een. Re' rutuut i Ahbán, ruch'ihil i Molid. <verse number="30" style="v" />Re' Nadab je' wili kib'ihnaal i rak'uun: Seled, Apaim. Re' Seled xkimik reje chi ma' xwihik ta ruha'lak'uun. <verse number="31" style="v" />Re' Apaim rajaaw i Isi, re' Isi rajaaw i Sesán, re' Sesán rajaaw i Ahlai.</para>
  <para style="p">
    <verse number="32" style="v" />Re' Jada ruchaaq' i Samai je' wili kib'ihnaal i rak'uun: Jeter, Jonatán. Re' Jeter xkimik reje chi ma' xwihik ta ruha'lak'uun. <verse number="33" style="v" />Re' Jonatán je' wili kib'ihnaal i rak'uun: Pelet, Zaza, Re' taqe re' i riih rumaam Jerameel.</para>
  <para style="p">
    <verse number="34" style="v" />Re' Sesán ma' xwihik ta jino'q rak'uun xarixq'uun i xi wihik, jinaj i rumoso ruloq'om xwihik re' ruuk' aj Egipto Jarha i rub'ihnaal. <verse number="35" style="v" />Re' Sesán xuyeew jinaj i rixq'uun chi rehk'een i Jarha i rumoso xwihik jinaj rak'uun ruuk' Atai i rub'ihnaal. <verse number="36" style="v" />Re' Atai rajaaw i Natán. Re' Natán rajaaw i Zabad. <verse number="37" style="v" />Re' Zabad rajaaw i Eflal. Re' Eflal rajaaw i Obed. <verse number="38" style="v" />Re' Obed rajaaw i Jehú. Re' Jehú rajaaw i Azarías. <verse number="39" style="v" />Re' Azarías rajaaw i Heles. Re' Heles rajaaw i Elasa. <verse number="40" style="v" />Re' Elasa rajaaw i Sismai. Re' Sismai rajaaw i Salum. <verse number="41" style="v" />Re' Salum rajaaw i Jecamías. Re' Jecamías rajaaw i Elisama.</para>
  <para style="p">
    <verse number="42" style="v" />Re' Caleb i ruchaaq' i Jerameel je' wili kib'ihnaal i rak'uun: Re' peet rak'uun Mesa rajaaw i Zif. Re' rukab' rak'uun Maresá rajaaw i Hebrón. <verse number="43" style="v" />Re' i Hebrón je' wili kib'ihnaal i rak'uun: Coré, Tapúa, Requem, Sema. <verse number="44" style="v" />Re' Sema rajaaw i Raham, re' rajaaw i Jorcoam. Re' Requem rajaaw i Samai. <verse number="45" style="v" />Re' Samai Maón rub'ihnaal i rak'uun. Re' Maón rajaaw Bet-sur.</para>
  <para style="p">
    <verse number="46" style="v" />Re' Efa i xwihik chi rukab'ruxoqil i Caleb ixib' i rak'uun xwihik je' wili kib'ihnaal: Harán, Mosa, Gazez. Re' Harán i rajaaw i Gazez jinaj chik.</para>
  <para style="p">
    <verse number="47" style="v" />Re' Jahdai, je' wili kib'ihnaal i rak'uun: Regem, Jotam, Gesam, Pelet, Efa, Saaf.</para>
  <para style="p">
    <verse number="48" style="v" />Re' Maaca i xwihik chiruxoqil i Caleb kiib' i rak'uun xwihik je' wili kib'ihnaal: Seber, Tirhana. <verse number="49" style="v" />Re' Maaca, re' wo' re' i rutuut i Saaf, re' rajaaw i Madmana, rutuut wo' Seba rajaaw i Macbena, rutuut wo' Gibea. Eh re' Caleb xwihik wo' jinaj rixq'uun Acsa i rub'ihnaal.</para>
  <para style="p">
    <verse number="50" style="v" />Re' taqe i riih rumaam i Caleb re' taqe wili:</para>
  <para style="p">Re' taqe rak'uun i Hur i peet rak'uun i xwihik ruuk' i Efrata, je' wili kib'ihnaal: Sobal, re' rajaaw i Quiriat-jearim. <verse number="51" style="v" />Re' Salma re' rajaaw i Belén, re' Haref rajaaw i Bet-gader. <verse number="52" style="v" />Re' taqe i rak'uun i Sabal i rajaaw Quiriat-jearim, je' wili i kib'ihnaal: Haroe kimaam kati't yejaal reh i tinamit Manahetita. <verse number="53" style="v" />Re' Sobal re' wo' taqe i kimaam kati't i aj Quiriat-jearim. Re' taqe aj Itritas, re' taqe i aj Futitas, re' taqe i aj Sumatitas, re' taqe i aj Mistraítas. Re' taqe i re' i kimaam kati't i Zoratitas, je' wo' taqe estaolitas.</para>
  <para style="p">
    <verse number="54" style="v" />Re' i Salma i kimaam kati't i aj Belén, taqe aj Netofatitas, taqe Atrot-bet-joab, eh je' wo' yejaal reh i tinamit Manahetitas, je' wo' taqe i aj Zoraitas. <verse number="55" style="v" />Eh re' wo' Salma kimaam kati't taqe i aj tz'ihb' wilkeeb' ar Jabes. Re' taqe i aj Tirateo, taqe i aj Simeateo, taqe i aj Sucateo. Re' taqe re' i aj kenita re' ruuk' taqe i riih rumaam i Hamat rajaaw i Recab.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' taqe i rak'uun i reey David</para>
  <para style="r">(<ref loc="2SA 3:1-5">2 Sam 3.1-5</ref>; <ref loc="2SA 5:13-16">5.13-16</ref>; <ref loc="1CH 14:3-7">1 Cron 14.3-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe wili i rak'uun i David xi aasjik ar Hebrón, re' peet rak'uun Amnón i rub'ihnaal, re' rutuut Ahinoam i rub'ihnaal aj Jezreel. Re' rukab' rak'uun Daniel i rub'ihnaal, re' rutuut Abigail i rub'ihnaal aj Carmel. <verse number="2" style="v" />Re' roox rak'uun Absalón i rub'ihnaal, re' rutuut Maaca i rub'ihnaal rixq'uun i Talmai kireey i aj Gesur. Re' rukaaj rak'uun Adonías i rub'ihnaal, re' rutuut Haguit i rub'ihnaal. <verse number="3" style="v" />Re' roo' rak'uun Sefatías i rub'ihnaal, re' rutuut Abital rub'ihnaal. Re' ruwaaq rak'uun Itream rub'ihnaal, re' rutuut Egla rub'ihnaal re' rehk'een jinaj chik i David. <verse number="4" style="v" />Re' taqe i waq'iib' chi rak'uun i David re' re' ar xi-aasjik Hebrón. Re' i xwihik wii' chi reyil i David chuwach i wuquub' haab' ruuk' waq'iib' poh. Chi riij i re', re' David oxlaj ru ka'winaq haab' xwihik chi reyil Jerusaleem. <verse number="5" style="v" />Re' reey David kijib' chik i rak'uun xi-aasjik Jerusaleem, je' wili kib'ihnaal: Simea, Sobab, Natán, Salomón. Re' kituut kikajcheel i re', re' i Betsabé rixq'uun i Amiel. <verse number="6" style="v" />Re' David kob'elejeeb' chik i rak'uun xi wihik, je' wili kib'ihnaal: Ibhar, Elisama, Elifelet, <verse number="7" style="v" />re' Noga, Nefeg, Jofía, <verse number="8" style="v" />Elisama, Eliada, Elifelet, <verse number="9" style="v" />eh chu'nchel i re' rak'uun taqe David, jinaj i kanaab' Tamar i rub'ihnaal. Eh ma' xi okik ta haa' i rak'uun xi wihik kuuk' iruxoqil tokoom.</para>
  <para style="s">Re' taqe i rak'uun i riih rumaam Salomón</para>
  <para style="p">
    <verse number="10" style="v" />Re' taqe i wili i rak'uun i riih rumaam Salomón. Re' Salomón rajaaw i Roboam. Re' Roboam rajaaw i Abías. Re' Abías rajaaw i Asa. Eh re' Asa rajaaw i Josafat. <verse number="11" style="v" />Re' Josafat rajaaw i Joram. Re' Joram rajaaw i Ocozías. Re' Ocozías rajaaw i Joás. <verse number="12" style="v" />Re' Joás rajaaw i Amasías. Re' Amasías rajaaw i Azarías. Re' Azarías rajaaw i Jotam. <verse number="13" style="v" />Re' Jotam rajaaw i Acaz. Re' Acaz rajaaw i Ezequías. Re' Ezequías rajaaw i Manasés. <verse number="14" style="v" />Re' Manasés rajaaw i Amón. Re' Amón rajaaw i Josías. <verse number="15" style="v" />Re' Josías re' taqe wili i rak'uun: Re' peet rak'uun Johanán rub'ihnaal, re' rukab' rak'uun Joacim i rub'ihnaal. Re' roox rak'uun Sedequías rub'ihnaal. Re' rukaaj rak'uun Salum i rub'ihnaal. <verse number="16" style="v" />Eh re' i Joacim kiib' i rak'uun xwihik je' wili kib'ihnaal: Jeconías, Sedequías.</para>
  <para style="p">
    <verse number="17" style="v" />Re' Jeconías je' wili kib'ihnaal i rak'uun: Asir, Salatiel. <verse number="18" style="v" />Malquiram, Pedaías, Senazar, Jecamías, Hosama, Nedabías.</para>
  <para style="p">
    <verse number="19" style="v" />Re' Pedaías je' wili kib'ihnaal i rak'uun: Zorobabel, Simei. Re' Zorobabel je' wili kib'ihnaal i rak'uun: Mesulam, Hananías, eh jinaj i kanaab' Selomit rub'ihnaal. <verse number="20" style="v" />Re' i Zorobabel ho'oob' chik i rak'uun xwihik je' wili kib'ihnaal: Hasuba, Ohel, Berequías, Hasadías, Jusab-hesed.</para>
  <para style="p">
    <verse number="21" style="v" />Re' Hananías kiib' i rak'uun xwihik je' wili kib'ihnaal: Pelatías, Jesaías. Re' Jesaías rajaaw i Refaías. Re' Refaías rajaaw i Arnán. Re' Arnán rajaaw i Abdías. Re' Abdías rajaaw i Secanías. <verse number="22" style="v" />Re' Secanías waqiib' i rak'uun xwihik je' wili kib'ihnaal: Semaías, Hatús, Igal, Barías, Nearías, Sefat.</para>
  <para style="p">
    <verse number="23" style="v" />Re' Nearías ixib' i rak'uun xwihik je' wili kib'ihnaal: Elioenai, Ezequías, Azricam.</para>
  <para style="p">
    <verse number="24" style="v" />Re' Elioenai wuquub' i rak'uun xwihik je' wili kib'ihnaal: Hodavías, Eliasib, Pelaías, Acub, Johanán, Dalaías, Anani.</para>
  <chapter number="4" style="c" />
  <para style="s">Re' taqe i rak'uun, eh re' taqe i riih rumaam i Judá</para>
  <para style="p">
    <verse number="1" style="v" />Re' Judá je' wili kib'ihnaal i rak'uun: Fares, Hezrón, Carmi, Hur Sobal, <verse number="2" style="v" />Re' Reaía i rak'uun i Sobal re' re' rajaaw i Jahat. Re' Jahat rajaaw i Ahumai, ruch'ihil i Lahad re' taqe re' kimaam kati't i aj Zoratitas.</para>
  <para style="p">
    <verse number="3" style="v" />Re' Etam je' wili kib'ihnaal i rak'uun: Jezreel Isma, Ibdas, eh jinaj i kanaab' Naze-lelponi rub'ihnaal.</para>
  <para style="p">
    <verse number="4" style="v" />Re' Penuel rajaaw i Gedor, re' Ezer rajaaw i Husa, re' taqe re' rak'uun i Hur, peet rak'uun i Efrata. Eh re' Hur kimaam kati't i aj Belén.</para>
  <para style="p">
    <verse number="5" style="v" />Re' Asur i rajaaw Tecoa, kiib' iruxoqil xwihik, je' wili kib'ihnaal: Hela, Naara. <verse number="6" style="v" />Eh re' Asur re' re' kijib' i rak'uun xwihik ruuk' i Naara, je' wili kib'ihnaal: Ahuzam, Hefer, Temeni, Ahastari. <verse number="7" style="v" />Eh re' taqe rak'uun ruuk' i Ela je' wili kib'ihnaal: Zeret, Jezoar, Etnán.</para>
  <para style="p">
    <verse number="8" style="v" />Re' Cos rajaaw i Anub rajaaw wo' hoq i Zobeba. Re' taqe re' rumaam rati't Aharhel, re' rak'uun i Harum.</para>
  <para style="p">
    <verse number="9" style="v" />Re' Jabes jinaj winaq wilik rib'iral chi kow riib' chikiwach taqe i ras, eh ruchaaq. Re' rutuut Jabes i rub'ihnaal xukoj ruum q'e' xik'ik chi ti' noq x-aasjik i rak'uun re' re'. <verse number="10" style="v" />Eh re' Jabes xub'an rutiij chuwach i qaDios i hoj, hoj aj Israel je' wili xuq'or: QaJaaw Dios kinakuxisaj tii chayeew weh i nimlaj ye'aab'. Neeta tii ti wihik wuuk' reh chi ma' xta neekiruchej i ti' k'axik neenchalik chi nunaah, inki. Eh xye'arik wo' reh ruum i Dios i xupahqaaj.</para>
  <para style="p">
    <verse number="11" style="v" />Re' Quelub i ras i Súa rajaaw i Mehir. Eh re' Mehir rajaaw i Estón. <verse number="12" style="v" />Re' Estón rajaaw i Bet-rafa, rajaaw wo' i Paseah, je' wo' hoq i Tehina. Re' i Tehina, re' i xtooq'anik reh i tinamit i Nahas. Re' taqe wili i wilkeeb' ar Reca.</para>
  <para style="p">
    <verse number="13" style="v" />Re' Cenaz je' wili i kib'ihnaal i rak'uun, Otoniel. Seraías. Re' i Otoniel je' wili i kib'ihnaal i rak'uun: <verse number="14" style="v" />Hatat, Meonotai. Re' Meonotai rajaaw i Ofra. Eh re' Seraías rajaaw i Joab. Re' Joab kimaam kati't taqe i patim wach k'ixkaab' Carisim, ruum re' keh kichol kamanik chi korik.</para>
  <para style="p">
    <verse number="15" style="v" />Re' taqe rak'uun i Caleb i rak'uun i Jefone, je' wili kib'ihnaal: Iru, Ela, eh Naam. Eh re' i Ela rajaaw i Cenaz.</para>
  <para style="p">
    <verse number="16" style="v" />Re' Jehalelel, je' wili kib'ihnaal i rak'uun: Zif, Zifa, Tirías, Asarel.</para>
  <para style="p">
    <verse number="17" style="v" />Re' Esdras je' wili kib'ihnaal i rak'uun: Jeter, Mered, Efer, Jalón. Re' Mered xub'an kaxáro ruuk' i rixq'uun i kireey i aj Egipto xwihik rak'uun ruuk' je' wili kib'ihnaal: Jeter Mered, Eter Jalón, eh re' María Samai, Isba. Re' Isba rajaaw i Estemoa. <verse number="18" style="v" />Re' Mered xwihik jinaj rehk'een aj Judá xwihik rak'uun ruuk', Jered i rub'ihnaal, rajaaw i Gedor, re' i jinaj Heber, rajaaw i Soco, eh re' jinaj chik Jecutiel i rub'ihnaal, rajaaw i Zanoa. Re' taqe wili i rak'uun Bitia rixq'uun i kireey i aj Egipto re' xub'an kaxáro ruuk' i Mered.</para>
  <para style="p">
    <verse number="19" style="v" />Re' rehk'een i Hodías ranaab' i Naham, jinaj keh i rak'uun ruuk' ixoq re' re' rajaaw i Keila, aj garmita, eh jinaj chik i rak'uun rajaaw i Estemoa aj Maacateo.</para>
  <para style="p">
    <verse number="20" style="v" />Re' i Simón je' wili i kib'ihnaal i rak'uun: Amnón, Rina, Ben-hanán, Tilón. Re' Isi, je' wili kib'ihnaal i rak'uun: Zohet, Benzohet.</para>
  <para style="p">
    <verse number="21" style="v" />Re' Sela i rak'uun i Judá je' wili i kib'ihnaal i rak'uun: Re' Er i rajaaw i Leca, re' Laada, i rajaaw i Maresá, re' taqe i kikamanik ruuk' itz'ihy lino ar Bet-asbea. <verse number="22" style="v" />Re' Jocim re' taqe i winaq xi patinik chupaam i tinamit Cozeba, re' Joás, re' Saraf, re' i k'amal kib'eeh i aj Moab, xooj kian kaxáro kuuk' ixoq aj Lehem je' rukab' i kitz'ihb'aam kahnoq i aj najtir q'iij. <verse number="23" style="v" />Re' taqe re' i aj yej-an xa chib'ih jariij ruuk' saq ak'al chupaam i tinamit Netaim, eh Gedera. Eh ruuk' i reey kikamanik.</para>
  <para style="s">Re' taqe rak'uun, eh taqe i riih rumaam i Semeón</para>
  <para style="p">
    <verse number="24" style="v" />Re' Simeón je' wili kib'ihnaal i rak'uun: Nemuel, Jamín, Jarib, Zera, Saúl. <verse number="25" style="v" />Re' Saúl rajaaw i Salum. Re' Salum rajaaw i Mibsam. Re' Mibsam rajaaw i Mismá. <verse number="26" style="v" />Re' Mismá, Hamuel rub'ihnaal i rak'uun. Re' Zacuur Simei rub'ihnaal i rak'uun. <verse number="27" style="v" />Re' Simei waqlaj i rak'uun xwihik, eh waqiib' i rixq'uun re' taqe i ras i ruchaaq i Simei, xa re' la' ma' k'ih ta taqe i kak'uun kixq'uun i xwihik. Ruum aj re' ma' q'e' ta xi k'ihaaxb'ik i riih rumaam i Semeón. Ma' xponik ta chi je' k'ihaal i riih rumaam i Judá.</para>
  <para style="p">
    <verse number="28" style="v" />Re' taqe i rak'uun rixq'uun i Simeón ar xi patinik Beerseba Molada, eh Hazar-sual. <verse number="29" style="v" />Eh chupaam taqe i tinamit Bilha i Ezem Tolad. <verse number="30" style="v" />Betuel, Horma, Siclag. <verse number="31" style="v" />Bet-marcabot Hazar-susim, Bet-birai, Saaraim. Re' taqe re' i kitinamiit korehtaal xokik chi reyil i David. <verse number="32" style="v" />Eh ho'oob' wo' chik i kitinamiit chi riij taqe re', je' wili kib'ihnaal: Etam, Aín, Rimón, Toquén, Asán. <verse number="33" style="v" />Eh chupaam chu'nchel i kok' ye'aab' wilkeeb' wii' chi kijunsuut i tinamit re' re' korehtaal xponik Baal. Eh chupaam taqe ye'aab' re' re' xi patinik taqe i kiih kimaam.</para>
  <para style="p">
    <verse number="34" style="v" />Je' wili kib'ihnaal: Mesobab, Jamlec, Josías rak'uun Amasías. <verse number="35" style="v" />Joel, Jehú, rak'uun i Josibías. Re' i Josibías rak'uun i Seraías. Re' Seraías rak'uun i Asiel. <verse number="36" style="v" />Elioenai, Jaacoba, Jesohaía, Asaías, Adiel, Jesimiel, Benaía. <verse number="37" style="v" />Ziza, re' Ziza rak'uun i Sifi. Re' Sifi rak'uun Alón. Re' Alón rak'uun chee Jedaías. Re' Jedaías rak'uun i Simri. Re' Simri rak'uun i Semaías. <verse number="38" style="v" />Re' taqe xq'orarik kib'ihnaal wili, re' taqe re' xi kahnik chi k'amal kib'eeh taqe i ju'jun ch'uq chi xak'uuk' kiib'. Eh ma' k'isiin ta xi k'ihaaxb'ik i awach keh. <verse number="39" style="v" />Ruum aj re' xiooj k'oloq chi korkiil ireelb'aali q'iij kopanookb'al reh i Gerar, xkisik' i ye'aab' aha' xkireq wii' ruwa' i kitentzuun. <verse number="40" style="v" />Eh xponik kireq i runimaal ye'aab' q'e' holohik, eh q'e' wo' holohik i ch'ahn chupaam ruwa' i kichikoop. Eh ar suq xi wihik ma' awach ta xtz'a'inik keh ruum re' taqe i riih rumaam i Cam xi wihik cho ar pampeet. <verse number="41" style="v" />Eh re' taqe i tz'ihb'amaj kib'ihnaal re' re' xi ponik chupaam i ye'aab' re' re' noq wilik chi reyil ar Judá i Ezequías. Noq xi ponik xkisach wach i patim taqe ar, xkiyojib'eej i kipaat. Re' chik i keh xi okik chi patinik ar chi kijilow. Eh ar xi kahnik chi patinik chi jumpech, ruum ar xkireq ruwa' i kichikoop. <verse number="42" style="v" />Eh hoob' siento taqe i re' ruuk' i riih rumaam i Simeón xiooj chinaah i yuuq' Seir. Re' taqe i xk'amwik reje kib'eeh je' wili i kib'ihnaal: Pelatías, Nearías, Repaías, Uziel rak'uun Isi. <verse number="43" style="v" />Noq xi ponik ar xkuxik xkisacham wach taqe i kiqox i aj Amalec. Eh ar xi kahnik chi k'acharik chi jumpech.</para>
  <chapter number="5" style="c" />
  <para style="s">Re' taqe rak'uun, eh taqe i riih rumaam i Rubén</para>
  <para style="p">
    <verse number="1" style="v" />Re' Rubén i peet rak'uun i Israel, ruum chi xumin riib' ruuk' i rukab'ruxoqil i rajaaw ma' xuk'ul taj i rukooch naa naq ruye'ariik reh ruum chi peet ak'un ma' xye'arik ta chik reh. Re' chik i rak'uun i Israel José i rub'ihnaal xk'ulwik reh i rukooch naq i Rubén. Eh ma' xkiyeew ta chik rajaawriik chi peet ak'uunb'ees. <verse number="2" style="v" />Re' José xk'ulwik reh i rukooch i peet ak'un xa re' la' re' taqe i riih rumaam i Judá xwihik kajaawriik chikinaah i kuch tinamitaal. Eh chi kixilak wo' keh xelik chaloq jinaj i aj taq'oom chikinaah. <verse number="3" style="v" />Re' Rubén i peet rak'uun i Israel je' wili kib'ihnaal i rak'uun: Hanoc, Hezrón, Falú, Carmi.</para>
  <para style="p">
    <verse number="4" style="v" />Re' Joel, Semaías i rub'ihnaal i rak'uun. Re' Semaías Gog rub'ihnaal i rak'uun. Re' Gog Simei i rub'ihnaal i rak'uun. <verse number="5" style="v" />Re' Simei Micaía i rub'ihnaal i rak'uun. Re' Micaía Reaía rub'ihnaal i rak'uun. Re' Reaía Baal rub'ihnaal i rak'uun. <verse number="6" style="v" />Re' i Baal Beera rub'ihnaal i rak'uun, re' i xk'amarik reje ruum i Tiglat-pileser kireey i aj Asiria. Re' Beera, re' naq i k'amal kib'eeh i riih rumaam i Rubén. <verse number="7" style="v" />Re' taqe i ruchaaq' i Beera xtz'ihb'jik i kib'ihnaal nik' kik'ihaal taqe i kak'uun kixq'uun. Re' taqe i k'amal kib'eeh je' wili i kib'ihnaal Jeiel i Zacarías. <verse number="8" style="v" />Bela rak'uun i Azaz. Re' Azaz rak'uun i Sema. Re' Sema rak'uun i Joel. Re' taqe re' xi wihik ar Aroer, ko xi ponik Nebo, eh Baal-meón. <verse number="9" style="v" />Eh xi wihik wo' hoq chi korkiil reje ireelb'aalq'iij, ar xtohq'ik reje chi chii' i ye'aab' chiq yuuq' korehtaal xi ponik chi chii' i nim ha' Éufrates, ruum xiik' naah k'ihaal i kichikoop wilik paruyuq'ul i Galaad.</para>
  <para style="p">
    <verse number="10" style="v" />Eh noq xwihik i Saúl chi reyil chikinaah i riih rumaam i Rubén xkian i q'aq'inik kuuk' i aj agarenos, eh xkian reh. Je' re' noq re' chik i keh xkiyejaa' ki-itz'ihy naah paat, chi korkiil reje ireelb'aalq'iij reh i Galaad.</para>
  <para style="s">Re' taqe i rak'uun, eh taqe i riih rumaam i Gad</para>
  <para style="p">
    <verse number="11" style="v" />Eh re' taqe i riih rumaam i Gad ar xi patinik chi kik'ulwaach reje xi wihik wii' i riih rumaam i Rubén. Ar paruyuq'ul i Basán, ko xi ponik Salca. <verse number="12" style="v" />Re' i Joel xti xwihik rajaawriik chi peet ar Basán, chi riij i reh re' Safán, chi riij i reh, re' Jaanai, chi riij i reh re' i Safat.</para>
  <para style="p">
    <verse number="13" style="v" />Eh re' taqe i junch'uq chik chi riih rumaam je' wili kib'ihnaal k'amal kib'eeh: Micael, Mesulam, Seba, Jorai, Jacán, Zía, Heber, wuquub' chi kiib'.</para>
  <para style="p">
    <verse number="14" style="v" />Re' taqe i wili rak'uun i riih i Abihail rak'uun i Huri. Re' Huri rak'uun i Jaroa. Re' Jaroa rak'uun i Galaad. Re' Galaad rak'uun i Micael. Re' Micael rak'uun i Jesisai. Re' Jesisai rak'uun i Jahdo. Re' Jahdo rak'uun i Buz. <verse number="15" style="v" />Eh re' i Ahí rak'uun i Abdiel. Re' Abdiel rak'uun i Guni. Re' Ahí xwihik chi k'amal kib'eeh taqe re'. <verse number="16" style="v" />Chu'nchel i re' ar xi k'acharik paruyuq'ul i Galaad, eh Basán, je' wo' chupaam taqe i kok' ye'aab', je' wo' chupaam i ye'aab' Sarón, re' wilik wii' i holohaq ch'ahn. <verse number="17" style="v" />Eh chu'nchel i re' xi ajaljik chi ch'uhqaal noq xwihik i Jotam chi kireey i aj Judá. Eh noq xwihik i Jeroboam chi kireey i aj Israel.</para>
  <para style="s">Re' i k'utaaj chikiij taqe i ka'ch'uq ruuk' ruyej-aal</para>
  <para style="p">
    <verse number="18" style="v" />Re' taqe i junch'uq chi riih rumaam Rubén, ruch'ihil i Gad, ruch'ihil i yejaal ch'uq chi riih rumaam i Manasés. Re' keh kowlaj soldado taqe chi q'aq'inik, wilik kinimaq pulato ch'ihch', wilik kiq'aslaj ch'ihch', eh wilik kiflecha, tijimaj taqe chi korik reh i q'aq'inik. Eh kijib' roxk'ahl miil ruuk' wuquub' siento ruuk' oxk'ahl chi kiib', kichol q'aq'inik chi korik. <verse number="19" style="v" />Re' taqe re' xkian i q'aq'inik kuuk' i aj agareno, je' wo' kuuk' i kiih kimaam i Jetur, Nifis, eh Nadab. <verse number="20" style="v" />Re' keh re' Dios xtoob'inik keh ruum xkiyeew kik'ux ruuk', eh xkipahqaaj i rotob'il noq k'ahchi' keeb' chi q'aq'inik. Eh re' taqe i aj agarenos, ruch'ihil taqe i k'ahchi' naq rutoob'iniik keh xkiq'asaj kiib' pan kiq'ab'. Ruum re' Dios xtoob'inik keh. <verse number="21" style="v" />Eh xkiq'uch i kichikoop i nixowanik kiwach, lajeeb' roxk'ahl miil i kicameyo, kiib' siento ruuk' lajeeb' roxk'ahl miil kitentzuun, eh kiib' siento miil i kib'uruux. Eh xkichop reje i jinaj siento miil i tinamit. <verse number="22" style="v" />Eh ma' k'isiin i aj ixowaal xkikansaj i riih rumaam i Rubén i Gad, ruum re' i Dios xtoob'inik keh chi xi elik korik ruuk' i q'aq'inik. Ar xi patinik chupaam taqe ye'aab' re' re' korehtaal chik xi k'amarik reje pan tokoom tinamit.</para>
  <para style="p">
    <verse number="23" style="v" />Eh re' taqe i yejaal i ch'uq reh i riih rumaam i Manasés, ma' k'isiin ta noq xik'ihaaxb'ik. Eh ar xi patinik Basán, eh ar Baal-hermón, Senir, eh ko xi ponik chupaam i ye'aab' Hermón. <verse number="24" style="v" />Eh re' taqe i ju'jun ch'uq je' wili kib'ihnaal ink'amwik kib'eeh: Efer, Isi, Eliel, Azriel, Jeremías. Hodavías, Jandiel. Re' taqe winaq wili kow kiib' chi q'aq'inik eht'alimaj kiwach, eh k'amal kib'eeh taqe i awach keh. <verse number="25" style="v" />Xa re' la' re' keh xkiq'eb' chi riij kik'ux i Dios xkinimaj chaloq i qamaam kati't i hoj, hoj aj Israel. Re' chik taqe i tiyoox xtohq'ik kiloq'em, re' ki dios i tokoom tinamit. Re' taqe i tiyoox xresaj reje chikiwach i aj Israel noq xi okik chupaam i ye'aab'. <verse number="26" style="v" />Je' aj re' noq re' i QaJaaw Dios xuyeew paruk'ux i Pul inkiq'or reh re' wo' hoq i Tiglat-pileser i kireey i aj Asiria chi naa rojiik chi q'aq'inik kuuk' i riih rumaam i Rubén, kuuk' i riih rumaam i Gad, je' wo' kuuk' i yejaal i ch'uq i riih rumaam i Manasés. Eh xuk'am taqe reje chupaam taqe i tinamit Halah, Habor, Hara, re' wilik wii' i nim ha' Gozán, eh ar xi kahnik chi jumpech.</para>
  <chapter number="6" style="c" />
  <para style="s">Re' taqe rak'uun, eh taqe i riih rumaam i Leví</para>
  <para style="p">
    <verse number="1" style="v" />Re' Leví je' wili kib'ihnaal i rak'uun: Gersón, Coat, Merari. <verse number="2" style="v" />Re' Coat je' wili kib'ihnaal i rak'uun: Amram, Izhar, Hebrón, Uziel. <verse number="3" style="v" />Re' Amram je' wili kib'ihnaal i rak'uun: Aarón, Moisés, re' i María i rixq'uun. Re' Aarón je' wili kib'ihnaal i rak'uun: Nadab, Abiú, Eleazar, Itamar. <verse number="4" style="v" />Eh re' Eleazar rajaaw i Finees. Re' Finees rajaaw i Abisúa. <verse number="5" style="v" />Re' Abisúa rajaaw i Buqui. Re' Buqui rajaaw i Uzi. <verse number="6" style="v" />Re' Uzi rajaaw i Zeraías. Re' Zeraías rajaaw i Meraiot. <verse number="7" style="v" />Re' Meraiot rajaaw i Amarías. Re' Amarías rajaaw i Ahitob. <verse number="8" style="v" />Re' Ahitob rajaaw Sadoc. Re' Sadoc rajaaw Ahimaas. <verse number="9" style="v" />Re' Ahimaas rajaaw i Azarías. Re' Azarías rajaaw i Johanán. <verse number="10" style="v" />Re' Johanán rajaaw i Azarías, re' xkamanik chi k'amal kib'eeh aj tiij chupaam i rupaat i Dios xuyejaa' i reey Salomón ar Jerusaleem. <verse number="11" style="v" />Re' Azarías rajaaw i Amarías. Re' Amarías rajaaw Ahitob. <verse number="12" style="v" />Re' Ahitob rajaaw i Sadoc. Re' Sadoc rajaaw i Salum. <verse number="13" style="v" />Re' Salum rajaaw Hilcías. Re' Hilcías rajaaw i Azarías. <verse number="14" style="v" />Re' Azarías rajaaw i Seraías. Re' Seraías rajaaw i Josadac. <verse number="15" style="v" />Eh re' Josadac xchoparik noq re' i QaJaaw Dios xukanaa' taqe i aj Judá, i aj Jerusaleem pan q'ab' i reey Nabucodonosor reh chi xuk'am taqe reje pan tokoom tinamit.</para>
  <para style="s">Re' taqe rak'uun, eh taqe i riih rumaam i Leví</para>
  <para style="p">
    <verse number="16" style="v" />Re' Leví je' wili kib'ihnaal i rak'uun: Gersón, Coat, Merari. <verse number="17" style="v" />Re' Gersón je' wili kib'ihnaal i rak'uun: Libni, Simei. <verse number="18" style="v" />Re' Coat je' wili kib'ihnaal i rak'uun: Amram, Izhar, Hebrón, Uziel. <verse number="19" style="v" />Re' Merari je' wili kib'ihnaal i rak'uun: Mahli, Musi. Re' taqe wili i riih rumaam i Leví xi wihik cho kuuk' i rak'uun. <verse number="20" style="v" />Re' Gersón, Libni rub'ihnaal i rak'uun. Re' Libni Johat i rub'ihnaal i rak'uun. Re' i Johat Zima i rub'ihnaal i rak'uun. <verse number="21" style="v" />Re' Zima Joa i rub'ihnaal i rak'uun. Re' Joa, Iddo rub'ihnaal i rak'uun. Re' Iddo Zera rub'ihnaal i rak'uun. Re' Zera Jeatrai.</para>
  <para style="p">
    <verse number="22" style="v" />Re' Coat, re' Aminadab rub'ihnaal i rak'uun. Re' Aminadab Coré rub'ihnaal i rak'uun. Re' Coré Asir rub'ihnaal i rak'uun. <verse number="23" style="v" />Re' Asir Elcana rub'ihnaal i rak'uun. Re' Elcana Ebiasaf rub'ihnaal i rak'uun. Re' Ebiasaf Asir rub'ihnaal i rak'uun. <verse number="24" style="v" />Re' Asir Tahat rub'ihnaal i rak'uun. Re' Tahat Uriel rub'ihnaal i rak'uun. Re' Uriel Uzías rub'ihnaal i rak'uun. Re' Uzías Saúl rub'ihnaal i rak'uun. <verse number="25" style="v" />Re' Elcana je' wili kib'ihnaal i rak'uun: Amasai, Ahimot. <verse number="26" style="v" />Re' Ahimot Elcana rub'ihnaal i rak'uun, re' Elcana Zofai rub'ihnaal i rak'uun. Re' Sofai, Nahat rub'ihnaal i rak'uun. <verse number="27" style="v" />Re' Nahat Eliab rub'ihnaal i rak'uun. Re' Eliab Jeroham rub'ihnaal i rak'uun. Re' Jeroham Elcana rub'ihnaal i rak'uun. <verse number="28" style="v" />Re' Samuel je' wili rub'ihnaal i peet rak'uun: Vasni, re' rukab', eh Abías i rub'ihnaal.</para>
  <para style="p">
    <verse number="29" style="v" />Re' Merari, Mahli rub'ihnaal i rak'uun. Re' Mahli Libni rub'ihnaal i rak'uun. Re' Libni Simei rub'ihnaal i rak'uun. Re' Simei Uza rub'ihnaal i rak'uun. <verse number="30" style="v" />Re' Uza Simea rub'ihnaal i rak'uun. Re' Simea Haguía rub'ihnaal i rak'uun. Re' Haguía Asaías rub'ihnaal i rak'uun.</para>
  <para style="s">Re' i kib'ihnaal i xupab'aa' taqe chi tz'uuy parupaat i Dios i David</para>
  <para style="p">
    <verse number="31" style="v" />Re' taqe winaq wili xupab'aa' i reey David reh chi xitz'uyinik chupaam i rusanto laj itz'ihy naah paat i Dios, noq xkiyeew ar i ruloq'laj kaxa molik wii' i k'uhb'aal. <verse number="32" style="v" />Xankijal kiib' chi tz'uuy ar chupaam i santo laj itz'ihy naah paat molb'al iib'. Je' re' i xkian korehtaal chik xuyejaa' i rupaat i Dios i Salomón ar Jerusaleem. Re' keh xkian i kikamaj je' rukab' i xq'orarik keh.</para>
  <para style="p">
    <verse number="33" style="v" />Re' taqe wili kitz'uyinik ruch'ihil taqe i kak'uun, haa' taqe i riih rumaam i Coat je' wili kib'ihnaal: Re' i Hemán i aj tz'uuy rak'uun i Joel, re' Joel rak'uun i Samuel. <verse number="34" style="v" />Re' Samuel rak'uun i Elcana. Re' Elcana rak'uun Jeroham. Re' Jeroham rak'uun i Eliel. Re' Eliel rak'uun i Toa. <verse number="35" style="v" />Re' Toa rak'uun i Zuf. Re' i Zuf rak'uun i Elcana. Re' Elcana rak'uun i Mahat. Re' Mahat rak'uun i Amasai. <verse number="36" style="v" />Re' Amasai rak'uun i Elcana. Re' Elcana rak'uun i Joel. Re' Joel rak'uun i Azarías. Re' Azarías rak'uun i Sofonías. <verse number="37" style="v" />Re' Sofonías rak'uun i Tahat. Re' Tahat rak'uun i Asir. Re' Asir rak'uun i Ebiasaf. Re' Ebiasaf rak'uun i Coré, re' Coré rak'uun i Izhar, <verse number="38" style="v" />Re' Izhar rak'uun i Coat. Re' Coat rak'uun i Leví, re' Leví rak'uun i Israel.</para>
  <para style="p">
    <verse number="39" style="v" />Eh parusak'aaj i Hemán i rupab'aa' i koq riib' Asaf ma' tokoom ta ruuk', rak'uun i Berequías, rak'uun i Simea. <verse number="40" style="v" />Re' Simea rak'uun i Micael. Re' Micael rak'uun i Baasías. Re' Baasías rak'uun i Malquías. <verse number="41" style="v" />Re' Malquías rak'uun i Etni. Re' Etni rak'uun i Zera. Re' Zera rak'uun i Adaía. <verse number="42" style="v" />Re' Adaía rak'uun i Etán. Re' Etná rak'uun i Zima. Re' Zima rak'uun i Simei. <verse number="43" style="v" />Re' Simei rak'uun i Jahat. Re' Jahat rak'uun i Gersón. Re' Gersón rak'uun i Leví.</para>
  <para style="p">
    <verse number="44" style="v" />Eh parutz'eet i Hemán inkipab'aa' i koq kiib' taqe i ma' tokoom ta ruuk' re' taqe i riih rumaam i Merari, je' wili kib'ihnaal: Re' Etán rak'uun i Quisi. Re' Cis i rak'uun i Abdi. Re' Abdi rak'uun i Maluc. <verse number="45" style="v" />Re' Maluc rak'uun i Hasabías. Re' Hasabías rak'uun i Amasías. Re' Amasías rak'uun i Hilcías. <verse number="46" style="v" />Re' Hilcías rak'uun i Amsi. Re' Amsi rak'uun i Bani. Re' Bani rak'uun i Semer. <verse number="47" style="v" />Re' Semer rak'uun i Mahli. Re' Mahli rak'uun i Musi. Re' Musi rak'uun i Merari. Re' Merari rak'uun i Leví.</para>
  <para style="p">
    <verse number="48" style="v" />Eh re' taqe junch'uq ma' tokoom ta ruuk' i riih rumaam taqe i Leví xipa'ab'jik chub'anariik chu'nchel i kamanik imb'aanchupaam i itz'ihy naah paat.</para>
  <para style="p">
    <verse number="49" style="v" />Eh re' Aarón ruch'ihil taqe rak'uun riih rumaam kik'atwik reh i insensia. Eh re' wo' keh kik'atwik reh i mayiij chinaah i artaal, re' wo' hoq inkik'at wii' i mayiij. Eh re' wo' keh kib'anik kamanik chupaam i santo laj ye'aab'. Eh re' keh kiq'asaniik reh i mayiij inkiyeew i aj Israel chi pahqb'al kuyb'al kimahk chuwach i QaJaaw Dios. Eh xkian wo' chu'nchel i xq'orarik reh i Moisés ruum i QaJaaw Dios.</para>
  <para style="s">Re' taqe rak'uun, eh taqe i riih rumaam i Aarón</para>
  <para style="p">
    <verse number="50" style="v" />Re' taqe i rak'uun i riih rumaam i Aarón, je' wili i kib'ihnaal: Re' Eleazar, rak'uun i Aarón. Re' Finees rak'uun i Eleazar. Re' Abisúa rak'uun i Finees. <verse number="51" style="v" />Re' Buqui rak'uun i Abisúa. Re' Uzi rak'uun i Buqui. Re' Zeraías rak'uun i Uzi. <verse number="52" style="v" />Re' Meraiot rak'uun i Zeraías. Re' Amarías rak'uun i Meraiot. Re' Ahitob rak'uun i Amarías. <verse number="53" style="v" />Re' Sadoc rak'uun i Ahitob. Re' Ahimaas rak'uun i Sadoc.</para>
  <para style="s">Re' taqe i ye'aab' xi wihik wii' i riih rumaam i Leví</para>
  <para style="r">(<ref loc="JOS 21:1-42">Jos 21.1-42</ref>)</para>
  <para style="p">
    <verse number="54" style="v" />Re' taqe wili ye'aab' xye'arik keh i rak'uun i riih rumaam i Aarón noq xsik'arik chi riij aha' wili i ye'aab' xye'arik keh. Re' taqe riih rumaam i Coat. <verse number="55" style="v" />Xye'arik keh i tinamit Hebrón wilik paruyuq'ul i Judá, je' wo' kok' ye'aab' wilkeeb' chi junsuut. <verse number="56" style="v" />Re' i tinamit ruch'ihil i kok' ye'aab' xye'arik reh i Caleb i rak'uun i Jefone. <verse number="57" style="v" />Eh re' taqe i riih rumaam i Aarón, xye'arik wo' keh i tinamit re' Hebrón, re' inkamanik chi ko'lb'al iib' je' wo' taqe i kok' ye'aab' Libna, Jatir, Estemoa. <verse number="58" style="v" />Xye'arik wo' keh i tinamit Hilén, je' wo' taqe i kok' ye'aab', je' wo' hoq i tinamit Debir je' wo' taqe i kok' ye'aab' wili chi kijunsuut. <verse number="59" style="v" />Re' i tinamit Asán, je' wo' hoq i tinamit Bet-semes je' wo' i kok' ye'aab' wilkeeb' chi kijunsuut. <verse number="60" style="v" />Eh xq'ahteesjik keh i ye'aab' kuum taqe i riih rumaam Benjamín, re' taqe i tinamit wili: Geba, Alemet, Anatot, eh je' wo' taqe i kok' ye'aab' wilik chi kijunsuut. Re' taqe i riih rumaam i Aarón oxlaj seht chi tinamit i xye'arik keh.</para>
  <para style="p">
    <verse number="61" style="v" />Eh re' taqe jar ch'uq chik chi riih rumaam i Coat lajeeb' seht chi tinamit i xye'arik keh kuum i yejaal ch'uq chi riih rumaam i Manasés. <verse number="62" style="v" />Re' taqe i riih rumaam i Gersón, oxlaj seht chi tinamit ixye'arik keh i kuum i riih rumaam i Isacar, kuum i riih rumaam i Aser, kuum i riih rumaam i Neftalí, eh kuum i riih rumaam i Manasés. <verse number="63" style="v" />Re' taqe i riih rumaam i Merari re' q'oreel jar ch'uq chi kiib' kab'laj seht chi tinamit i ye'arik keh kuum i riih rumaam i Rubén, kuum i riih rumaam i Gad, kuum i riih rumaam i Zabulón.</para>
  <para style="p">
    <verse number="64" style="v" />Eh re' taqe i aj Israel xkiq'asaj taqe i tinamit re' re' je' wo' taqe i kok' ye'aab' wilik chi kijunsuut keh taqe i riih rumaam i Leví. <verse number="65" style="v" />Re' taqe i junch'uq chi riih rumaam i Judá, re' taqe junch'uq chi riih rumaam Simeón, taqe i junch'uq chi riih rumaam Benjamín, re' taqe tinamit xq'orarik kib'ihnaal xkiyeew reh taqe i riih rumaam i Leví, re' i xsik'arik wach chi keh.</para>
  <para style="p">
    <verse number="66" style="v" />Eh wilik taqe i re' ruuk' i riih rumaam i Leví, ye'arik keh i ye'aab' wilik paruyuq'ul i kitinamiit taqe i riih rumaam i Efraín. <verse number="67" style="v" />Eh xye'arik wo' keh i tinamit Siquem inko'ljik wii' iib' wilik chinaah i yuuq' wilkeeb' wii' i riih rumaam i Efraín, xye'arik wo' keh i kok' ye'aab', je' wo' hoq i tinamit Gezer. <verse number="68" style="v" />Je' wo' hoq i tinamit Jocmeam, je' wo' hoq i tinamit Bet-horón, je' wo' taqe i kok' ye'aab' wilkeeb' chi kijunsuut. <verse number="69" style="v" />Xye'arik wo' keh i tinamit Ajalón, je' wo' tinamit Gat-rimón, je' wo' taqe i kok' ye'aab' wilkeeb' chi kijunsuut. <verse number="70" style="v" />Eh re' i yejaal i ch'uq reh i riih rumaam i Manasés i tinamit Aner, je' wo' tinamit Bileam je' wo' taqe i kok' ye'aab' wilkeeb' chi kijunsuut xkiyeew reh i riih rumaam i Coat komajaa' naq inkireq kiye'aab'.</para>
  <para style="p">
    <verse number="71" style="v" />Re' taqe i yejaal i ch'uq i riih rumaam i Manasés xkiyeew reh taqe i riih rumaam i Gersón i tinamit Golán wilik paruyuq'ul i Basán, je' wo' hoq i tinamit Astarot, je' wo' taqe i kok' ye'aab' wilkeeb' chi kijunsuut. <verse number="72" style="v" />Eh re' taqe i riih rumaam i Isacar xkiyeew wo' keh taqe re' i tinamit Cedes, je' wo' hoq i tinamit Daberat, je' wo' taqe i kok' ye'aab' wilkeeb' chi kijunsuut. <verse number="73" style="v" />Xye'arik wo' keh i tinamit Ramot, je' wo' tinamit Anem, je' wo' taqe i kok' ye'aab' wilkeeb' chi kijunsuut. <verse number="74" style="v" />Eh re' junch'uq chi riih rumaam i Aser xkiyeew wo' reh taqe re' i tinamit Mesal, je' wo' hoq i tinamit Abdón, je' wo' taqe kok' ye'aab' wilkeeb' chi kijunsuut. <verse number="75" style="v" />Xkiyeew wo' hoq i tinamit Hucoc, je' wo' hoq i tinamit Rehob, je' wo' taqe i kok' ye'aab' wilkeeb' chi kijunsuut. <verse number="76" style="v" />Re' taqe i riih rumaam i Neftalí xkiyeew wo' keh taqe re' i tinamit Cedes wilik paruyuq'ul i Galilea, je' wo' hoq i tinamit Hamón, je' wo' hoq i tinamit Quiriataim, je' wo' taqe i kok' ye'aab' wilkeeb' chi kijunsuut.</para>
  <para style="p">
    <verse number="77" style="v" />Eh re' taqe i riih rumaam i Zabulón, re' tinamit Rimón, je' wo' tinamit Tabor, je' wo' taqe i kok' ye'aab' wilkeeb' chi kijunsuut xkiyeew reh taqe i riih rumaam i Merari. <verse number="78" style="v" />Eh re' taqe i riih rumaam i Rubén xkiyeew i ye'aab' i wilik reje chi juntar i nim ha' Jordán i wilik reje chuwach i tinamit Jericó, pareelb'aal reje reh i q'iij wilik wii' i nim ha' Jordán, je' wo' hoq i ye'aab' i Beser, wilik reje panchiq yuuq', re' taqe ye'aab' Jaza. <verse number="79" style="v" />Eh xye'arik wo' keh i tinamit Cademot, je' wo' tinamit Mefáat, je' wo' taqe i kok' ye'aab' wilkeeb' chi kijunsuut. <verse number="80" style="v" />Re' taqe i riih rumaam i Gad xkiyeew wo' reh taqe re' i tinamit Ramot wilik paruyuq'ul i Galaad, je' wo' tinamit Mahanaim, je' wo' taqe i kok' ye'aab' wilkeeb' chi kijunsuut. <verse number="81" style="v" />Je' wo' tinamit Hesbón, i tinamit Jazer, je' wo' taqe i kok' ye'aab' wilkeeb' chi kijunsuut.</para>
  <chapter number="7" style="c" />
  <para style="s">Re' taqe rak'uun, eh taqe i riih rumaam i Isacar</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe i kijib' chi rak'uun i Isacar je' wili i kib'ihnaal: Tola, Fúa, Jasub Simrón.</para>
  <para style="p">
    <verse number="2" style="v" />Re' Tola je' wili i kib'ihnaal taqe i rak'uun: Uzi, Refaías Jeriel, Jahmai, Jibsam, Semuel. Eh re' taqe i re' xi kahnik chi k'amal kib'eeh taqe i ju'jun ch'uq chi riih rumaam i Tola. Re' taqe re' kow kiib' chi q'aq'inik, eh xi ponik kiib' ru ka'winaq miil ruuk' waqiib' siento noq xwihik chi reyil i David.</para>
  <para style="p">
    <verse number="3" style="v" />Re' i Uzi, Israhías rub'ihnaal i rak'uun. Eh re' Israhías je' wili kib'ihnaal i kijib' chi rak'uun: Micael, Obadías, Joel, Isías, xmanlojik ho'oob' taqe i k'amal b'eeh ruuk' i reh. <verse number="4" style="v" />Re' keh ma' k'isiin taqe i kixoqil ruum aj re' ma' k'isiin ta xik'ihaaxb'ik i kak'uun kixq'uun, i kiih kimaam, korehtaal xponik waqlaj ru ka'winaq miil chi soldado chi kixilak, kow kiib' chi q'aq'inik.</para>
  <para style="p">
    <verse number="5" style="v" />Eh noq xi ajaljik chu'nchel i riih rumaam i Isacar xi ponik kajwinaq miil ruuk' wuquub' miil chi soldado taqe kow kiib' chi q'aq'inik.</para>
  <para style="s">Re' taqe rak'uun, eh taqe i riih rumaam Benjamín</para>
  <para style="p">
    <verse number="6" style="v" />Re' taqe ixib' chi rak'uun i Benjamín je' wili kib'ihnaal: Bela, Bequer, Jediael. <verse number="7" style="v" />Eh re' taqe i ho'oob' chi rak'uun i Bela je' wili kib'ihnaal: Ezbón, Uzi, Uziel, Jerimot, Iri. Eh re' taqe i ho'oob' re' re' xi k'amwik kib'eeh i riih rumaam i Bela. Ma' k'isiin ta xi k'ihaaxb'ik noq xi ajaljik xi ponik kiib' ru ka'winaq miil ruuk' kajlaj ru ka'winaq chi soldado kow kiib' chi q'aq'inik.</para>
  <para style="p">
    <verse number="8" style="v" />Re' Bequer je' wili kib'ihnaal i rak'uun: Zemira, Joás, Eliezer, Elioenai, Omri, Jerimot, Abías, Anatot, Alamet. <verse number="9" style="v" />Re' taqe re' i k'amal kib'eeh i ruk'ihaal chi riih rumaam i Bequer, juninaq miil ruuk' kiib' siento chi kiib' kow kiib' chi q'aq'inik.</para>
  <para style="p">
    <verse number="10" style="v" />Re' Jediael, Bilhán rub'ihnaal i rak'uun: Re' Bilhán je' wili kib'ihnaal i rak'uun: Jeús, Benjamín, Aod, Quenaana, Zetán, Tarsis, Ahisahar. <verse number="11" style="v" />Re' taqe re' k'amal b'eeh taqe chi kixilak i ju'jun ch'uq chi riih rumaam Jediael, kow kiib' reh ojik chi q'aq'inik. Eh wuqlaj miil ruuk' kiib' siento chi kiib' chu'nchel.</para>
  <para style="p">
    <verse number="12" style="v" />Re' Hir je' wili kib'ihnaal i rak'uun: Supim, Hupim. Re' i Aher, Husim rub'ihnaal i rak'uun.</para>
  <para style="s">Re' taqe rak'uun, eh re' taqe riih rumaam i Neftalí</para>
  <para style="p">
    <verse number="13" style="v" />Re' Neftalí je' wili kib'ihnaal i rak'uun: Jahzeel, Guni, Salum. Re' taqe re' i riih rumaam i Bilha.</para>
  <para style="s">Re' taqe rak'uun, eh i riih rumaam i Manasés</para>
  <para style="p">
    <verse number="14" style="v" />Re' Manasés kiib' i rak'uun xwihik ruuk' i rukab' rixolqil aj Siria je' wili kib'ihnaal: Asriel, Maquir. Re' i Maquir rajaaw i Galaad. <verse number="15" style="v" />Eh re' Maquir xub'an kaxáro ruuk' i Maaca ma' tokoom ta ruuk' Hupim, i Supim. Eh re' ranaab' i Maquir Maaca i rub'ihnaal. Re' chaq'b'ees rak'uun i Maquir Zelofehad rub'ihnaal, eh re' reh xarixq'uun taqe i xi wihik ma' jino'q rak'uun.</para>
  <para style="p">
    <verse number="16" style="v" />Re' Maaca i rehk'een i Maquir kiib' i rak'uun xwihik. Re' peet rak'uun Peres i rub'ihnaal, re' i chaaq'b'ees rak'uun Seres rub'ihnaal. Eh re' i Seres je' wili kib'ihnaal i rak'uun: Ulam, Requem. <verse number="17" style="v" />Re' i Ulam Bedán rub'ihnaal i rak'uun, chu'nchel re' riih rumaam taqe i Galaad. Eh riih taqe i Maquir. Re' Maquir rak'uun i Manasés.</para>
  <para style="p">
    <verse number="18" style="v" />Re' Galaad xwihik jinaj i ranaab' Hamolequet rub'ihnaal ixib' i rak'uun xwihik je' wili kib'ihnaal: Isod, Abiezer, Mahala.</para>
  <para style="p">
    <verse number="19" style="v" />Re' Semida je' wili kib'ihnaal i rak'uun: Ahián, Siquem, Likhi, Aniam.</para>
  <para style="s">Re' taqe rak'uun, eh re' taqe i riih rumaam Efraín</para>
  <para style="p">
    <verse number="20" style="v" />Re' taqe i rak'uun i riih rumaam Efraín re' i rak'uun i Efraín Sutela i b'ih. Re' Sutela, Bered i b'ih i rak'uun. Re' Bered, Tahat i b'ih i rak'uun. Re' Tahat, Elada i b'ih i rak'uun. Re' Elada, Tahat i b'ih i rak'uun. <verse number="21" style="v" />Re' Tahat re' re' Zabad i b'ih i rak'uun. Re' Zabad Sutela wo' chik i b'ih i rak'uun. Eh kiib' chik i rak'uun i Efraín, je' wili kib'ihnaal: Ezer, Elad. Re' taqe kiib' re' re' xi kanteesjik noq k'ahchi' naq kelq'aam taqe i ruchikoop i Gat wilkeeb' chupaam i ye'aab' re' re'. <verse number="22" style="v" />Re' Efraín k'ih q'iij xtib'ik ruk'ux chi riij i kikimiik i rak'uun. Kox k'ulik chik ye'aroq rusuqkiil ruk'ux kuum taqe i ma' tokoom ta ruuk'. <verse number="23" style="v" />Chi riij i re' xukanaa' wo' chik wach k'acharik i rehk'een i Efraín. Eh noq Xasjiik i rak'uun Bería i rub'ihnaal xukoj ruum ma' k'isiin i ti' kiil k'uxliis parupaat.</para>
  <para style="p">
    <verse number="24" style="v" />Eh re' i rixq'uun i Efraín Seera i b'ih. Eh re' reh xtooq'anik reh i kiib' chi tinamit Bet-horón, jinaj wilik taxaaj, jinaj wilik panyuuq', eh re' wo' reh xtooq'anik reh i tinamit Uzen-seera.</para>
  <para style="p">
    <verse number="25" style="v" />Re' i Bería je' wili kib'ihnaal i rak'uun, i riih rumaam Refa. Re' Refa Resef i b'ih i rak'uun. Re' Resef Telah i b'ih i rak'uun. Re' Telah Tahán i b'ih i rak'uun. <verse number="26" style="v" />Re' i Tahán Laadán i b'ih i rak'uun. Re' Laadán Amiud i b'ih i rak'uun. Re' Amiud Elisama i b'ih i rak'uun. <verse number="27" style="v" />Re' Elisama Nun i b'ih i rak'uun. Re' Nun Josué i b'ih i rak'uun.</para>
  <para style="p">
    <verse number="28" style="v" />Re' taqe i tinamit xi wihik wii' re' taqe wilik Bet-el, wilik reje parelb'aal q'iij. Naarán wilik reje parookb'aal q'iij Gezer, Siquem xponik ko Gaza. Re' taqe i tinamit re' re' haa' taqe i kok' ye'aab' wilkeeb' chi kijunsuut. <verse number="29" style="v" />Re' taqe i riih rumaam i Manasés ar xi wihik chupaam i tinamit Bet-seán, Taanac, Meguido, Dor, je' wo' taqe i kok' ye'aab' wilkeeb' chi junsuut i ju'jun chi tinamit re' re', chupaam wo' taqe i ye'aab' re' re' xi wihik i riih rumaam i José rak'uun i Israel.</para>
  <para style="s">Re' taqe rak'uun, eh taqe i riih rumaam i Aser</para>
  <para style="p">
    <verse number="30" style="v" />Re' Aser kijib' i rak'uun je' wili kib'ihnaal: Imna, Isúa, Isúi, Bería, eh jinaj i kanaab' Sera rub'ihnaal.</para>
  <para style="p">
    <verse number="31" style="v" />Re' Bería je' wili kib'ihnaal i rak'uun: Heber, Malquiel, rajaaw i Birzavit. <verse number="32" style="v" />Re' Heber je' wili kib'ihnaal i rak'uun i Jaflet, Somer, Hotam, jinaj i kanaab' Súa rub'ihnaal.</para>
  <para style="p">
    <verse number="33" style="v" />Re' Jaflet je' wili i kib'ihnaal i rak'uun: Pasac, Bimhal, Asvat.</para>
  <para style="p">
    <verse number="34" style="v" />Re' Semer je' wili kib'ihnaal i rak'uun Ahí, Rohga, Jehúba, Aram.</para>
  <para style="p">
    <verse number="35" style="v" />Re' Helem ruchaaq' i Semer je' wili kib'ihnaal i rak'uun: Zofa, Imna, Seles, Amal. <verse number="36" style="v" />Re' Zofa je' wili kib'ihnaal i rak'uun: Súa, Harnefer, Súal, Beri, Imra. <verse number="37" style="v" />Eh Beser, Hod, Sama, Silsa, Itrán, Beera.</para>
  <para style="p">
    <verse number="38" style="v" />Re' Jeter je' wili kib'ihnaal i rak'uun: Jefone, Pispa, Ara.</para>
  <para style="p">
    <verse number="39" style="v" />Re' Ula je' wili kib'ihnaal i rak'uun: Ara, wo' chik, Haniel, Rezia.</para>
  <para style="p">
    <verse number="40" style="v" />Chu'nchel i re' riih rumaam i Aser. Re' taqe i xi kahnik chi k'amal kib'eeh ju'junch'uq chi xak'uuk' kiib'. Q'e' kow kiib' chi q'aq'inik, eh chu'nchel re' waq'iib' ru ka'winaq miil chi winaq taqe.</para>
  <chapter number="8" style="c" />
  <para style="s">Re' taqe rak'uun, eh re' taqe i riih rumaam i Benjamín</para>
  <para style="p">
    <verse number="1" style="v" />Re' Benjamín Bela i b'ih i peet rak'uun, re' rukab' rak'uun Asbel i b'ih, re' roox rak'uun Ahara i b'ih. <verse number="2" style="v" />Eh re' rukaaj rak'uun Noha i b'ih, re' roo' rak'uun Rafa i b'ih. <verse number="3" style="v" />Eh re' Bela je' wili kib'ihnaal i rak'uun: Adar, Gera, Abiud. <verse number="4" style="v" />Eh Abisúa, Naamán, Ahoa, <verse number="5" style="v" />Gera, Sefufán, Hiram.</para>
  <para style="p">
    <verse number="6" style="v" />Re' taqe rak'uun i xi k'amwik rub'eeh i ju'jun ch'uq chi riih rumaam i Benjamín. Re' taqe i xi wihik ar Geba, Xa re' la' xi k'amarik reje ko Manahat. <verse number="7" style="v" />Eh re' Aod je' wili kib'ihnaal i rak'uun: Naamán, Ahías, Gera. Re' Gera rajaaw i Uza, ruch'ihil i Ahiud. Re' i Gera xk'amwik reje keh Manahat.</para>
  <para style="p">
    <verse number="8" style="v" />Re' Saharaim, xuch'aq riib' ruuk' i kiib' chi rehk'een, Husim i b'ih jinaj, eh Baara i b'ih i jinaj. Eh koxwihik wo' chik rak'uun ar Moab. <verse number="9" style="v" />Eh re' taqe i rak'uun xwihik ruuk' i rehk'een jinaj chik Hodes i rub'ihnaal, je' wili kib'ihnaal: Jobab, Sibia, Mesa, Malcam, <verse number="10" style="v" />Eh Jeúz, Saquías, Mirma. Re' taqe i rak'uun wili xi k'amwik b'eeh chi kixilak i ju'jun ch'uq chi riih rumaam i Benjamín.</para>
  <para style="p">
    <verse number="11" style="v" />Re' Saharaim wihik wo' kiib' i rak'uun ruuk' i Husim, je' wili kib'ihnaal: Abitob, Elpaal. <verse number="12" style="v" />Re' i Elpaal je' wili kib'ihnaal i rak'uun: Heber, Misam, Semed, re' i xtooq'anik reh i tinamit Ono, Lod, ruch'ihil taqe i kok' ye'aab' wilik chi kijunsuut. <verse number="13" style="v" />Re' i Bería, i Sema xi k'amwik b'eeh chi kixilak i ju'jun ch'uq chi riih rumaam i Benjamín wilkeeb' Ajalón. Eh re' keh xi esanik keh i tinamit wilkeeb' chupaam i ye'aab' Gat.</para>
  <para style="p">
    <verse number="14" style="v" />Re' Bería je' wili kib'ihnaal i rak'uun: Ahío, Sasac, Jeremot. <verse number="15" style="v" />Zebadías, Arad, Ader, <verse number="16" style="v" />Micael, Ispa, Joha.</para>
  <para style="p">
    <verse number="17" style="v" />Re' i Elpaal je' wili kib'ihnaal i rak'uun: Zebadías, Mesulam, Hizqui, Heber, <verse number="18" style="v" />Ismerai, Jezlías, Jobab.</para>
  <para style="p">
    <verse number="19" style="v" />Re' Semei je' wili kib'ihnaal i rak'uun: Jaquim, Zicri, Zabdi, <verse number="20" style="v" />Elianai, Ziletai, Eliel, <verse number="21" style="v" />Adaías, Beraías, Simrat.</para>
  <para style="p">
    <verse number="22" style="v" />Re' Sasac je' wili kib'ihnaal i rak'uun: Ispán, Heber, Eliel. <verse number="23" style="v" />Eh Abdón, Zicri, Hanán, <verse number="24" style="v" />Hananías, Elam, Anatotías, <verse number="25" style="v" />Ifdaías, Peniel.</para>
  <para style="p">
    <verse number="26" style="v" />Re' Jeroham je' wili kib'ihnaal i rak'uun: Samserai, Seharías, Atalías. <verse number="27" style="v" />Eh Jaresías, Elías, Zicri.</para>
  <para style="p">
    <verse number="28" style="v" />Re' taqe i re' xi k'amwik b'eeh chi kixilak i ju'jun ch'uq chi riih rumaam i Benjamín, xi wihik ar Jerusaleem.</para>
  <para style="p">
    <verse number="29" style="v" />Eh pan tinamit Gabaón xpatinik i Abigabaón Jehiel wo' inkiq'or reh. Eh re' rehk'een Maaca rub'ihnaal. <verse number="30" style="v" />Re' taqe i rak'uun je' wili kib'ihnaal: Abdón, Zur, Cis, Baal, Nadab. <verse number="31" style="v" />Eh Gedor, Ahío, Zeker, <verse number="32" style="v" />Miclot, re' reh i rajaaw i Simea. Re' taqe i re' xi patinik Jerusaleem chikiwach reje taqe i junch'uq chi ma' tokoom ta kuuk'.</para>
  <para style="s">Re' taqe rak'uun, eh taqe i riih rumaam i Saúl</para>
  <para style="p">
    <verse number="33" style="v" />Re' Ner rajaaw i Cis. Re' Cis rajaaw i Saúl. Re' Saúl rajaaw i Jonatán, i Malquisúa, i Abinadab, i Es-baal. <verse number="34" style="v" />Re' Jonatán rajaaw i Marib-baal. Re' i Merib-baal rajaaw i Micaía. <verse number="35" style="v" />Eh re' i Micaía je' wili kib'ihnaal i rak'uun: Pito, Melec, Terea, Acaz, <verse number="36" style="v" />Eh re' Acaz rajaaw i Joada. Re' Joada rajaaw i Alemet, i Azmavet, i Zimri. Re' i Zimri rajaaw i Mosa. <verse number="37" style="v" />Re' Mosa rajaaw i Bina. Re' Bina rajaaw i Rafa. Rafa rajaaw i Elasa. Re' Elasa rajaaw i Azel. <verse number="38" style="v" />Re' taqe i rak'uun i Azel waq'iib' taqe je' wili kib'ihnaal: Azricam, Bocru, Ismael, Seraías, Obadías, Hanán.</para>
  <para style="p">
    <verse number="39" style="v" />Eh re' Esec i ruchaaq' i Azel, xwihik ixib' i rak'uun, re' peet rak'uun Ulam rub'ihnaal, re' rukab' rak'uun Jehús rub'ihnaal, re' roox rak'uun Elifelet rub'ihnaal. <verse number="40" style="v" />Re' taqe rak'uun i Ulam kow kiib' chi q'aq'inik ruuk' flecha. Ma' k'isiin i kak'uun kixq'uun i kiih kimaam xwihik, jinaj siento ruuk' lajeeb' roxk'ahl chi kiib'.</para>
  <para style="p">Chu'nchel re' riih rumaam taqe i Benjamín.</para>
  <chapter number="9" style="c" />
  <para style="s">Re' taqe i xi elik cho Babilonia</para>
  <para style="r">(<ref loc="NEH 11:1-24">Neh 11.1-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Chu'nchel i aj Israel tz'ihb'amaj i kib'ihnaal chupaam i kihuuj taqe i xi wihik chi reyil Israel, tz'ihb'amaj i kib'ihnaal taqe i kak'uun kiih kimaam.</para>
  <para style="p">Eh chu'nchel i aj Judá xi k'amarik reje Babilonia, ruum xkikanaa' runimjiik i QaJaaw Dios. <verse number="2" style="v" />Re' taqe i aj Israel xi elik cho chi peet ar i xi okik wo' chik chupaam i kitinamiit re' taqe i aj Israel re' taqe i aj tiij, taqe aj Levíta, re' taqe i kikamanik chupaam i rupaat i Dios.</para>
  <para style="p">
    <verse number="3" style="v" />Eh pan tinamit Jerusaleem xi okik chi patinik taqe i riih rumaam i Judá, taqe i riih rumaam i Benjamín, taqe i riih rumaam i Efraín, taqe i riih rumaam i Manasés. <verse number="4" style="v" />Utai i k'amal kib'eeh i riih rumaam i Fares i rak'uun i Judá. Re' Utai rak'uun i Amiud. Re' Amiud rak'uun i Omri. Re' Omri rak'uun i Imri. Re' Imri rak'uun i Bani. Re' Bani re' ruuk' taqe i rak'uun i Fares, i rak'uun i Judá. <verse number="5" style="v" />Eh xi okik wo' chik chi patinik ar i Asaías k'amal kib'eeh i riih rumaam i Sela i rak'uun i Judá. <verse number="6" style="v" />Je' wo' hoq i Jeuel k'amal kib'eeh i taqe i riih rumaam i Zera rak'uun i Judá. Eh ach lajeeb' ma' wuquub' siento chi kiib' chu'nchel i riih rumaam i Judá.</para>
  <para style="p">
    <verse number="7" style="v" />Eh xi okik wo' chik chi patinik Jerusaleem. Re' taqe wili i riih rumaam i Benjamín: Salú, rak'uun i Mesulam. Re' Mesulam rak'uun i Hodavías. Re' Hodavías rak'uun i Asenuá. <verse number="8" style="v" />Re' Ibniaías rak'uun i Jeroham. Re' Ela rak'uun i Uzi. Re' Uzi rak'uun i Micri, re' Mesulam rak'uun i Sefatías rak'uun i Reuel. Re' Reuel rak'uun i Ibnías. <verse number="9" style="v" />B'elejeeb' siento ruuk' waqlaj roxk'ahl chi kiib' chu'nchel i riih rumaam i Benjamín, chu'nchel i re' k'amal b'eeh taqe chupaam i ju'junch'uq chi patineel.</para>
  <para style="p">
    <verse number="10" style="v" />Eh re' taqe wili i k'amal kib'eeh aj tiij xi okik chi patinik Jerusaleem: Jedaías, Joiarib, Jaquín. <verse number="11" style="v" />Re' Azarías rak'uun i Hilcías. Re' Hilcías rak'uun i Mesulam. Re' Mesulam rak'uun i Sadoc. Re' Sadoc rak'uun i Meraiot. Re' Meraiot rak'uun i Ahitob. Re' ink'amwik rub'eeh i kamanik imb'aan parupaat i Dios. <verse number="12" style="v" />Eh xwihik wo' ar i Adaía rak'uun i Jeroham. Re' Jeroham rak'uun i Pasur. Re' Pesur rak'uun i Malquías, i Masai i rak'uun i Adiel. Re' Adiel rak'uun i Jazera. Re' Jazera rak'uun i Mesulam. Re' Mesulam rak'uun i Mesilemit. Re' Mesilemit rak'uun i Imer. <verse number="13" style="v" />Eh re' taqe i k'amal kib'eeh aj tiij kik'amwik b'eeh chupaam i ju'jun ch'uq chi tinamit jinaj miil ruuk' wuq'uub' siento ruuk' oxk'ahl keht'al rub'anariik chi korik i kamanik chupaam i rupaat i Dios.</para>
  <para style="p">
    <verse number="14" style="v" />Eh re' taqe i riih rumaam i Leví, je' wili kib'ihnaal: Semaías, rak'uun i Hasub. Re' Hasub rak'uun i Azricam. Re' Azricam, rak'uun i Hasabías. Re' Hasabías re' ruuk' taqe i riih rumaam i Merari. <verse number="15" style="v" />Eh xi wihik wo' ar i Bakbakar, Heres i Galal, i Matanías, rak'uun i Micaías. Re' Micaías rak'uun i Zicri, re' Zicri rak'uun i Asaf. <verse number="16" style="v" />Eh xwihik wo' ar i Obadías rak'uun i Semaías. Re' i Semaías rak'uun i Galal. Re' Galal rak'uun i Jedutún. Xwihik wo' ar i Berequías rak'uun i Asa. Re' Asa rak'uun i Elcana. Re' taqe re' xi patinik chupaam i kok' ye'aab' i aj Netofatitas.</para>
  <para style="p">
    <verse number="17" style="v" />Eh re' taqe i kicha'jinik reh i rokb'aal i rupaat i Dios je' wili kib'ihnaal: Salum, Acub, Talimón, Ahimán, re' kichaaq'. Re' Salum i k'amal kib'eeh. <verse number="18" style="v" />Eh xi kahnik chi rucha'jaljiik chi jumpech i ookb'al re' re' i kiokik wii' taqe i reey i wilkeeb' reje parelb'aal q'iij. Re' taqe keh kicha'jinik reh i ookb'al reh i kiye'aab' taqe i riih rumaam i Leví. <verse number="19" style="v" />Re' i Salum ruch'ihil taqe i ma' tokoom ta ruuk' i xicha'jinik reh i ookb'al reh i rupaat i Dios, je' rukab' noq xkicha'jeej chee ookb'al reh i santo laj itz'ihy naah paat i kimaam kati't. Eh re' i Salum rak'uun i Coré. Re' Coré rak'uun Ebiasaf. Re' Ebiasaf rak'uun i Coré jinaj chik. <verse number="20" style="v" />Eh pampeet chaloq re' i rak'uun i Eleazar xwihik chi k'amal kib'eeh re' i QaJaaw Dios xwihik ruuk'. <verse number="21" style="v" />Re' i Zacarías rak'uun Meselemías incha'jinik reh i rookb'aal i santo laj itz'ihy naah paat molb'al iib'. <verse number="22" style="v" />Re' taqe i xicha'jinik reh i ookb'al sik'ooj cho kiwach kiib' siento ruuk' kab'laj chi kiib' noq xi ajaljik chi kixilak awach keh patim taqe wii'. Eh re' reey David, re' Samuel jalal ruq'oral i Dios xpaab'anik keh. <verse number="23" style="v" />Je' re' noq re' taqe re' xan kijal kiib' ruuk' i kak'uun chi rucha'jaljiik i ookb'al reh i rusanto laj itz'ihy naah paat i QaJaaw Dios. <verse number="24" style="v" />Eh re' taqe i cha'jen reh taqe i ookb'al re' re'. Wilik i xi wihik parelb'aal reje i q'iij i xi wihik parookb'aal reje i q'iij, wilik i xi wihik pantz'eet reh i rookb'aal i q'iij, wilik i xi wihik pansak'aaj reh i rookb'aal i q'iij. <verse number="25" style="v" />Eh re' taqe i wilkeeb' cho chupaam i kikok' ye'aab' rajlaal ruwuuq' q'iij kichalik chi to'ooj chi rucha'jaljiik taqe i ookb'al. <verse number="26" style="v" />Xa re' la' re' taqe i kijib' chi winaq kik'amwik b'eeh eliik wilkeeb' chucha'jaljiik taqe i ookb'al. Eh re' wo' keh kicha'jinik i kok' paat i molol keeb' wii' taqe i k'ih taq tz'aq inkamanik parupaat i Dios. <verse number="27" style="v" />Re' keh ki-ik'ik aq'ab' chi junsuut i rupaat i Dios, ruum re' keh kicha'jinik reh, eh re' keh kitehwik reh pantaq wahq'eq.</para>
  <para style="p">
    <verse number="28" style="v" />Eh wilik wo' keh taqe re' i kicha'jinik reh taqe i xa chib'ih jariik inkamanik chupaam i rupaat i Dios. Re' keh kiesanik cho reh, kimolwik i koq reh, eh tiklik kajlaam. <verse number="29" style="v" />Eh wilik wo' keh i kicha'jinik reh taqe i xa chib'ih jariik inkamanik chupaam i santo laj ye'aab'. Eh i kicha'jeej wo' hoq i arina, i riis uuva, i aseite, i insensia, ink'ohnik laj iq'oom <verse number="30" style="v" />Eh wilik taqe i kak'uun i k'amal kib'eeh aj tiij kiyej-anik reh ink'ohnik laj iq'oom inkamanik chupaam i rupaat i Dios. <verse number="31" style="v" />Eh jinaj i re' ruuk' taqe i riih rumaam i Leví Matatías rub'ihnaal peet rak'uun i Salum re' reh inilwik reh taqe ink'iljik wach pan xartiin inye'arik chi mayiij. <verse number="32" style="v" />Wilik taqe i rak'uun i Coat, i kak'uun taqe i ma' tokoom ta ruuk' kiyej-anik reh i kab'laj chi kaxlanwi'k inkiyeew nah mexa chupaam i santo laj ye'aab' chupaam taqe i ju'jun chi hi'limb'al q'iij. <verse number="33" style="v" />Eh wilik wo' taqe i aj tz'uuy i re' ruuk' i riih rumaam i Leví i k'amal kib'eeh i ju'jun ch'uq chi tinamit. Re' taqe re' chupaam i kok' paat wilik chucheel i rupaat i Dios xi patinik ruum chi q'iij chi aq'ab' kikamanik ar.</para>
  <para style="p">
    <verse number="34" style="v" />Re' k'amal b'eeh reh taqe i ju'jun ch'uq chi tinamit aj Levíta nik' pa' k'ihaal i kak'uun kixq'uun. Re' taqe re' i k'amal b'eeh xi wihik ar Jerusaleem.</para>
  <para style="s">Re' taqe rak'uun, eh taqe i riih rumaam i Saúl</para>
  <para style="p">
    <verse number="35" style="v" />Re' Jediel ar xpatinik pan tinamit Gabaón, rajaaw i Gabaón. Re' rehk'een i Jehiel Maaca i rub'ihnaal. <verse number="36" style="v" />Re' Jehiel je' wili kib'ihnaal i rak'uun: Abdón i peet rak'uun, eh Zur, Cis, Baal, Ner, Nadab. <verse number="37" style="v" />Eh Gedor, Ahío, Zacarías, Miclot. <verse number="38" style="v" />Re' Miclot rajaaw i Simeam. Re' keh xi patinik wo' Jerusaleem i xi patinik wii' taqe i ras i ruchaaq'.</para>
  <para style="p">
    <verse number="39" style="v" />Re' Ner rajaaw i Cis. Re' Cis rajaaw i Saúl. Re' Saúl rajaaw i Jonatán. Malquisúa, re' Abinadab, re' Es-baal <verse number="40" style="v" />Re' Jonatán Merib-baal rub'ihnaal i rak'uun. Eh re' Merib-baal rajaaw i Micaía. <verse number="41" style="v" />Re' i Micaía je' wili kib'ihnaal i rak'uun: Pitón, Melec, Tarea, Acaz. <verse number="42" style="v" />Re' Acaz rajaaw i Jera. Re' Jera rajaaw i Alemet, Azmavet, Zimri. Re' Zimri rajaaw i Mosa. <verse number="43" style="v" />Re' Mosa rajaaw i Bina, re' rak'uun i Bina Refaías rub'ihnaal, eh re' rak'uun i Refaías Elasa. Re' rak'uun i Elasa Azel rub'ihnaal. <verse number="44" style="v" />Re' Azel waq'iib' i rak'uun xwihik je' wili kib'ihnaal: Azricam, Bocru, Ismael, Searías, Obadías, Hanán.</para>
  <chapter number="10" style="c" />
  <para style="s">Re' i rukimiik i reey Saúl, ruch'ihil taqe rak'uun</para>
  <para style="r">(<ref loc="1SA 31:1-13">1 Sam 31.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe i aj filisteo xkian i q'aq'inik kuuk' i aj Israel. Eh xkimol chi elik i aj Israel chikiwach, ma' k'isiin i xkikansaj chinaah i yuuq' wilik Gilboa. <verse number="2" style="v" />Eh re' taqe i aj filisteo xkajimaj reje i Saúl ruch'ihil taqe i rak'uun korehtaal xkikansaj i Jonatán, Abinadab, i Malquisúa rak'uun taqe i reey Saúl. <verse number="3" style="v" />Chi riij i re' kow xkitoq'aa' q'aq'inik chi rukanteesjiik i Saúl, korehtaal xkireq ruuk' kiflecha. <verse number="4" style="v" />Eh noq ti' chik wilik i Saúl je' wili i xuq'or reh ink'amwik reh ch'ihch' ko'lb'al riib': Chawesaj chaa q'aslaj ch'ihch' kinakansaj chi jumpech. Re' hin ma' inwaaj taj chi nee kinki kaq se'laaj i ma' keht'al ta wach i Dios noq nee kinki kansaj, inki. Xa re' la' re' i winaq ma' xraaj ta rub'aan ruum ma' k'isiin inyo'jik. Eh re' Saúl xuchop chee q'as ju' ch'ihch' xumin riib' chi ju'. <verse number="5" style="v" />Eh noq xrilow ink'amwik reh i ru nimlaj pulato ch'ihch' chi re' Saúl kamnaq chik xumin wo' riib' chi ju' ruq'as ju' ch'ihch' i reh, eh xkimik. <verse number="6" style="v" />Je' aj re' noq xkimik i reey Saúl ruch'ihil ixib' chi rak'uun, eh chu'nchel i awach reh parupaat junkimiik taqe ruuk'. <verse number="7" style="v" />Eh noq xkib'iraj chu'nchel i aj Israel patim taqe wach k'ixkaab' i xkimol chi elik, chi xkanteesjik i reey Saúl ruch'ihil taqe rak'uun, xkiq'eb' chaloq taqe i kitinamiit, re' chik taqe i aj filisteo xiooj chi patinik ar.</para>
  <para style="p">
    <verse number="8" style="v" />Eh noq xi ponik chi junwaar taqe i aj filisteo chi q'uchariik i chib'ih keh i kamnaq, xponik kireq chi tuch'lik i ruti'jolal i Saúl ruch'ihil i kiti'jolal i rak'uun chinaah i yuuq' wilik Gilboa. <verse number="9" style="v" />Eh xkesaj i ruso' reh q'aq'inik chi riij i Saúl xkik'am reje i naah ruch'ihil taqe i rutz'a'amb'aal. Eh xkitaq'aaj ruq'orariik chupaam i chu'nchel i kitinamiit i aj filisteo chi xkimik chik i Saúl. Eh xkitaq'aaj wo' ruq'orariik chupaam i rupaat i kitz'aqoj tiyoox. <verse number="10" style="v" />Chi riij i re' xkiyeew ruq'aslaj ch'ihch' chupaam i rupaat taqe i kitiyoox. Eh xkit'uyaa' i naah chupaam i rupaat i kitiyoox Dagón rub'ihnaal.</para>
  <para style="p">
    <verse number="11" style="v" />Noq xkib'iraj rib'iral i aj Jabes, taqe i aj Galaad chib'ih jariik i xkian i aj filisteo reh i Saúl. <verse number="12" style="v" />Xkimol kiib' chu'nchel i winaq aj Jabes. Re' taqe i kow kiib' chi q'aq'inik xiooj reje xponik kik'am i ruti'jolal i Saúl je' wo' kiti'jolal ixib' chi rak'uun, xkik'am reje Jabes. Eh ar xkimuq'aa' chi ri'sil i juniwal i chee' tz'inuj, ruum i re' wuquub' q'iij ma' xkian ta kiwa' kihaa'.</para>
  <para style="p">
    <verse number="13" style="v" />Je' aj re' noq xkimik i reey Saúl ruum ma' xunimaj taj i QaJaaw Dios, xuq'ehtaaj i ruq'oral, eh xupahqaaj runa'ojb'al ruuk' jinaj ixoq aj q'iij. <verse number="14" style="v" />Ma' re' ta ruuk' i QaJaaw Dios xupahqaaj runa'ojb'al. Ruum i re' xuyeew q'ab' i Dios chi xkanteesjik. Eh re' chik i David i rak'uun i Isaí xupab'aa' chi reyil ar Israel.</para>
  <chapter number="11" style="c" />
  <para style="s">Re' David xkipab'aa' chi reey ar Israel</para>
  <para style="r">(<ref loc="2SA 5:1-5">2 Sam 5.1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe i aj Israel xkimol reje kiib' chi kunchelaal xiooj Hebrón chi q'orob'jiik i David, je' wili xkiq'or reh: Re' hoj quuk' q'iib' awuuk'. <verse number="2" style="v" />Eh jank'alnaak noq kore' i Saúl wilik chi reyil chi qanaah xa re' wo' hat ti k'amwik reje kib'eeh qaj q'aq'ineel. Re' wo' chik i hat ti' k'amwik cho keh. Re' i aaWaJaaw aaDios je' wo' wili i ruq'orom aweh: Re' hat naa ak'amwiik kib'eeh i nutinamiit, re' hat naa akahniik chi reyil chinaah, inki.</para>
  <para style="p">
    <verse number="3" style="v" />Eh je' aj re' noq chu'nchel i k'amal kib'eeh i aj Israel xiooj ruuk' i David ar Hebrón. Eh re' reh wilik i xuyejaa' wach kuuk' chuwach i Dios. Re' keh xkijalk'iij aseite wach naah i xkipab'aa' chi kireey, je' rukab' xq'orarik keh ruum i QaJaaw Dios ruuk' chii' i Samuel.</para>
  <para style="s">Re' reey David xuchop naah i ye'aab' Sión kolemb'al iib' i korjinaq chi korik</para>
  <para style="r">(<ref loc="2SA 5:6-10">2 Sam 5.6-10</ref>)</para>
  <para style="p">
    <verse number="4" style="v" />Re' David ruch'ihil taqe chu'nchel i aj Israel xooj pan tinamit Jerusaleem, Jebús wo' inkiq'or reh. Eh wilik taqe i aj jebuseo wilkeeb' chi patinik chupaam i ye'aab' re' re'. <verse number="5" style="v" />Eh re' taqe i aj jebuseo je' wili xkiq'or reh i reey David: Re' hat ma' naa ta wokiik ayu', inki taqe reh. Xa re' la' re' i David xa xichop wo' naah i ye'aab' Sión, korjinaq chi korik ko'lemb'al riib' re' rutinamiit i David. <verse number="6" style="v" />Re' reey David je' wili i ruq'orom pampeet: Awach i neenokik chi peet chub'anariik keh aj jebuseo, neenukoj chi k'amal b'eeh, inki. Eh re' Joab rak'uun i Sarvia xokik chi peet, eh xpa'ab'jik wo' chi k'amal b'eeh. <verse number="7" style="v" />Eh re' David xokik chi wihik chupaam i ye'aab' ko'lemb'al iib' korjinaq chi korik ruum aj re' rutinamiit i David i rub'ihnaal xkikoj. <verse number="8" style="v" />Re' reey David xuyejaa' wo' chik i tinamit re' re', ar xutoq'aa' reje Milo xponik ruuk' i tz'aq kotimaj wii' riij i tinamit. Eh re' i yejaal re' chik i Joab xyej-anik reh. <verse number="9" style="v" />Eh re' i reey David xak'ahchi' rutiqiik naah i rajaawriik ruum re' i QaJaaw Dios wilik ruuk' chi rutoob'jiik.</para>
  <para style="s">Re' i ma' holohik taj xkian i ru soldado i David</para>
  <para style="r">(<ref loc="2SA 23:8-39">2 Sam 23.8-39</ref>)</para>
  <para style="p">
    <verse number="10" style="v" />Re' taqe i wili i k'amal kib'eeh taqe i ru soldado i David q'e' kow kiib' chi q'aq'inik, re' taqe i xitowik reh noq xwihik chi reyil, eh kuch'ihil taqe chu'nchel i aj Israel noq xkipab'aa' chi reey je' wo' rukab' i xuq'or i QaJaaw Dios keh i aj Israel.</para>
  <para style="p">
    <verse number="11" style="v" />Re' taqe wili i kib'ihnaal i ru soldado i David q'e' kow kiib': Re' Jasobeam rak'uun i Hacmoni, wilik rajaawriik chikinaah i lajeeb' ru ka'winaq chi soldado Eh re' i Jasobeam ruuk' i ruq'aslaj ch'ihch' xukansaj ixib' siento chi winaq. <verse number="12" style="v" />Re' rukab' re' i Eleazar rak'uun Dodo. Re' reh re' ruuk' taqe i awach re' i Ahod. Re' Eleazar re' i jinaj keh ixib' chi k'amal b'eeh kow kiib' chi q'aq'inik. <verse number="13" style="v" />Re' Eleazar xwihik ruuk' i David noq xub'an i q'aq'inik kuuk' i aj filisteo ar Pas-damim, re' noq xkimol chi elik i aj Israel. Eh ar naq wilik i junseht chi ye'aab' tikooj sebada chupaam. <verse number="14" style="v" />Eh re' i Eleazar ruch'ihil taqe i ru soldado kipab'aa' kiib' chi q'aq'inik chi yejaal i tik re' re', eh ar kian reh taqe i aj filisteo, xi elik korik ruum xitoob'jik ruum i Dios.</para>
  <para style="p">
    <verse number="15" style="v" />Pan jinaj q'iij ixib' keh i lajeeb' ru ka'winaq k'amal kib'eeh soldado xiooj i wilik wii' i nimlaj ab'aj wilik ma' najt ta ruuk' i paat ab'aj wilik ar Adulam. Eh re' taqe i aj filisteo ar kiyejaam ki-itz'ihy naah paat wach k'ixkaab' Refaim. <verse number="16" style="v" />Eh noq re' reey David ar wilik chupaam i ye'aab' ko'lb'al iib' wilik taqe i aj filisteo xi okik chupaam i tinamit Belén. <verse number="17" style="v" />Re' David xchalik ruchiqiik chii' je' wili xuq'or: Awach ta naq jino'q neenk'amwik cho nuhaa' chupaam i jul ha' wilik panookb'al reh i tinamit Belén, inki. <verse number="18" style="v" />Re' taqe ixib' chi winaq kow kiib' xponik kimin kiib' chupaam i ye'aab' wilkeeb' wii' i aj filisteo. Eh xkilik i ha' chupaam i jul ha' wilik panookb'al reh i Belén xkik'am cho reh i David. Xa re' la' re' David xama' xuk'ej ta wo' hoq xujalk'iij wach ak'al chi jilow rumayiij chuwach i QaJaaw Dios. <verse number="19" style="v" />Eh je' wili xuq'or: Re' ta naq i Dios neentoob'inik weh chi ma' nee tan wuk'ej i ha' wili ruum wixwuk'ej je' naa re' i kikik'eel i winaq wili i neen wuk'ej, ruum re' keh xkiyeew kiib' pankimik noq xponik kik'am i ha' wili, inki. Re' David xama' xuk'ej ta wo' hoq i ha'. Re' taqe wili xkian ixib' chi soldado kow kiib'.</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' i Abisai ruchaaq' i Joab i k'amal kib'eeh i lajeeb' ru ka'winaq kow kiib', eh xukansaj taqe ixib' siento chi soldado, ruuk' i ruq'as ju' ch'ihch'. Ruuk' i re' xelik rib'iral chi wilik rajaawriik xureq chi je' kikab' ixib' chi soldado kow kiib'. <verse number="21" style="v" />Re' i Abisai naab'imaj wach chi kixilak i lajeeb' ru ka'winaq, eh xkahnik chi k'amal kib'eeh, xa re' la' re' rajaawriik ma' xureq ta chi je' rukab' i kajaawriik ixib' q'e' kow kiib'.</para>
  <para style="p">
    <verse number="22" style="v" />Eh re' Benaía rak'uun i Joida inchalik ar Cabseel, eht'alimaj wach, ma' k'isiin i nimaq wach na'ojb'al xub'an. Re' i reh xkansanik keh i kiib' chi rak'uun i Ariel aj Moab. Eh pan jinaj q'iij noq k'ahchi' chi qajik i saq suutz', re' Benaía xqajik chupaam jinaj i jul ar xukansaj jinaj i kaq b'ahlam. <verse number="23" style="v" />Eh xukansaj wo' hoq jinaj i qaman winaq aj Egipto kiib' b'ara ruuk' yejaal i b'ara runajtiil i rooq wihik ruq'as ju' ch'ihch' pan q'ab' je' ruwii' i chee' reh keem. Re' i Benaías xuchop jinaj i chee' xtohq'ik ruk'ulb'ilem korehtaal xuq'uch reh i ruq'as ju' ch'ihch'. Eh ruuk' i q'as ju' ch'ihch' re' re' xukansaj i aj Egipto. <verse number="24" style="v" />Eh ruuk' taqe i xub'an re' re' i Benaía rak'uun i Joiada xwihik i rajaawriik chi kixilak taqe i lajeeb' ru ka'winaq chi kow kiib'. <verse number="25" style="v" />Eh xye'arik rajaawriik chi kixilak i lajeeb' ru ka'winaq chi soldado, xa re' la' ma' xureq ta chi je' rukab' i ixib' chi kiib' wilik kajaawriik. Re' reey David xukoj i Benaía chi k'amal kib'eeh i soldado incha'jinik ree reh.</para>
  <para style="p">
    <verse number="26" style="v" />Re' taqe i soldado q'e' kow kiib' je' wili i kib'ihnaal: Asael ruchaaq i Joab, Elhanan rak'uun i Dodo aj Belén. <verse number="27" style="v" />Re' i Samot aj ar Harod Heles aj ar Pelón. <verse number="28" style="v" />Re' Ira, rak'uun Ikes aj ar Tecoa, Abiazer aj ar Anatot. <verse number="29" style="v" />Re' Sibecai aj ar Husat, Ilai aj ar Ahod. <verse number="30" style="v" />Re' Maharai, Heleb rak'uun i Baana aj ar Netofa. <verse number="31" style="v" />Re' Itai rak'uun i Ribai aj ar Gabaa. Re' ruuk' taqe i riih rumaam i Benjamín. Re' i Benaía aj ar Piratón. <verse number="32" style="v" />Re' Hurai inchalik chi rooq i nim ha' wilik Gaza, re' Abiel aj ar Arabá. <verse number="33" style="v" />Re' Azmavet, aj ar Behurim, re' Eliaba, aj ar Saalbón. <verse number="34" style="v" />Re' taqe rak'uun i Hasem, aj ar gizonita, re' Jonatán rak'uun i Sage aj ar Arar. <verse number="35" style="v" />Re' Ahíam, rak'uun i Sakar, aj ar Arar, re' Elifal rak'uun i Ur. <verse number="36" style="v" />Re' Hefer, aj ar Meker, re' Ahías aj pan tinamit Pelón. <verse number="37" style="v" />Re' Hezro aj ar Carmel, re' Naarai rak'uun i Ezbai. <verse number="38" style="v" />Re' Joel ruchaaq' i Natán, re' Mibhar rak'uun i Hagrai. <verse number="39" style="v" />Re' Selec aj ar Amón, re' Naharai aj ar Beerot. Re' i Naharai re' re' ink'amwik reh i ch'ihch' inkamanik reh panq'aq'inik, rak'uun i Sarvia. <verse number="40" style="v" />Re' Ira, Gareb aj ar Itra taqe, <verse number="41" style="v" />Re' Urías, heteo, Zabad rak'uun i Ahlai. <verse number="42" style="v" />Re' Adina rak'uun i Siza re' ruuk' taqe i riih rumaam i Rubén. Eh re' Adina ink'amwik kib'eeh taqe i riih rumaam i Rubén. Eh k'amal wo' kib'eeh i lajeeb' ru ka'winaq chi soldado <verse number="43" style="v" />Re' Hanán rak'uun i Maaca, Josafat aj ar Mitán. <verse number="44" style="v" />Re' Uzías aj ar Astarot, re' Sama, re' Jehiel rak'uun taqe i Hotán aj ar Aroer. <verse number="45" style="v" />Re' Jediael rak'uun i Simri, Joha ruchaaq' i Tizita. <verse number="46" style="v" />Re' Eliel, aj ar Mahan, re' Jerebai, re' Josavía rak'uun taqe Elnaam, re' Itma aj ar Moab. <verse number="47" style="v" />Re' Eliel, re' Obed, eh re' Jaasiel aj ar Mesoba taqe.</para>
  <chapter number="12" style="c" />
  <para style="s">Re' taqe i xkian jinaj kiwach ruuk' i David</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe wili i winaq xi chalik ruuk' i David chupaam i ye'aab' Siclag noq korukeb'aam riib' ar chuwach i Saúl rak'uun i Cis. Re' taqe i winaq wili kow kiib', re' taqe i xtoob'inik reh chi q'aq'inik. <verse number="2" style="v" />Re' taqe re' wilik kuuk' taqe i kutb'al reh i flecha. Eh inkikut wo' ab'aj ruuk' tolo'x, kikutwik ruuk' rusak'aaj kiq'ab' je' wo' ruuk' rutz'eet kiq'ab'.</para>
  <para style="p">Re' taqe re' ma' tokoom ta taqe ruuk' i Saúl, re' ruuk' taqe i riih rumaam i Benjamín je' wili kib'ihnaal: <verse number="3" style="v" />Re' Ahiezer i peet k'amal kib'eeh, re' rukab' re' Joás rak'uun taqe i Semaa aj Gabaa taqe. Re' taqe wili i soldado re' Jeziel, re' Pelet rak'uun taqe i Azmavet, re' Beraca re' Jehú, aj Anatot taqe. <verse number="4" style="v" />Re' Ismaías aj Gabaón kow riib' chi kixilak i lajeeb' ru ka'winaq k'amal kib'eeh i soldado. Chi riij i re', re' Jeremías, Jahaziel, Johanán, Jozabad aj Gedera. <verse number="5" style="v" />Re' Eluzai, Jerimot, Bealías, Semarías, Sefatías aj harufita. <verse number="6" style="v" />Re' Elcana, Isías, Azareel, Joezer, Jasobeam, re' ruuk' taqe i riih rumaam i Coré. <verse number="7" style="v" />Re' Joela, re' i Zebadías, re' taqe i rak'uun i Jeroham aj Gedor taqe.</para>
  <para style="p">
    <verse number="8" style="v" />Eh wilik taqe i riih rumaam i Gad xkian jinaj wach kik'ux ruuk' i reey David noq wilik cho chupaam i paat ko'lemb'al iib' wilik panchiq yuuq'. Eh re' taqe winaq wili kow kiib' chi q'aq'inik. Eh wilik pan kiq'ab' taqe i ko'lemb'al kiib' nimaq pulato ch'ihch', taqe i kiq'as ju' ch'ihch'. Eh xa josq' chik i kiwach xa je' chik wach kaq b'ahlam, xti kichol elik je' rukab' noq kielik i keej pantaq ch'ahn. <verse number="9" style="v" />Re' taqe re' je' wili kib'ihnaal: Re' peet Ezer, re' rukab', Obadías, re' roox Eleab. <verse number="10" style="v" />Re' rukaaj Mismaná, re' roo' Jeremías, <verse number="11" style="v" />Re' ruwaaq, Atai, re' ruwuuq' Eliel. <verse number="12" style="v" />Re' ruwahxaaq Johanán, re' rub'eleej Elzabad. <verse number="13" style="v" />Re' ru lajeeb' Jeremías, re' rujunlaaj Macbani, <verse number="14" style="v" />Re' taqe wili ink'amwik kib'eeh taqe i ki soldado i riih rumaam i Gad. Re' ma' q'e' ta kow riib' xa jinaj siento chi soldado i ruk'am rub'eeh. Eh re' xti kow riib' jinaj miil chi soldado i ruk'am rub'eeh. <verse number="15" style="v" />Re' taqe re' xiq'atwik wach i nim ha' Jordán paruq'ijil jab' noq elik i rub'an i ha' chupaam i peet poh reh i haab' re' re'. Eh xkikaaj taqe chu'nchel i wilkeeb' wach k'ixkaab', chi je' wilkeeb' reje pareelb'aal q'iij, chi je' wilkeeb' reje parookb'aal q'iij.</para>
  <para style="p">
    <verse number="16" style="v" />Eh wili taqe i riih rumaam Benjamín, taqe i riih rumaam i Judá ki a'n jinaj wach kik'ux ruuk' i David wilik chupaam i ye'aab' ko'lemb'al iib'. <verse number="17" style="v" />Eh re' reey David xelik cho chi kik'ulariik je' wili xuq'or keh:</para>
  <para style="p">Wila' suq kiil k'uxliis i nak'am taq cho weh, wila' hat taq to'ool weh xat chalik, neenuk'ulaa' chi neen qa'an jinaj wach qak'ux taq awuuk'. Eh wila' xa re' taq inawaaj chi nee taq kinaq'asaj pan kiq'ab' i ki-ixowanik nuwach, atoob' ta ma' xta numahk. Re' ta naq i Dios inkinimaj chaloq taqe aamaam awati't neen ye'wik taq aweh chutojariik taq amahk, inki.</para>
  <para style="p">
    <verse number="18" style="v" />Re' Amasai i k'amal kib'eeh i lajeeb' ru ka'winaq chi soldado wilik ruuk' i Santolaj Uxlab'al je' wili i xuq'or:</para>
  <para style="b" />
  <para style="q">Re' hoj wilkooj awuuk', hoj aweh David hat rak'uun i Isaí.</para>
  <para style="q">Suuqb'oq ak'ux, suq kiil k'uxliis wih-oq awuuk' i hat</para>
  <para style="q">suuqb'oq wo' kik'ux i kitoob'inik aweh,</para>
  <para style="q">ruum re' aaDios xtoob'inik aweh, inki.</para>
  <para style="b" />
  <para style="p">Eh re' reey David xuk'ul wo' taqe ruuk', xukoj taqe chi kixilak i k'amal kib'eeh soldado.</para>
  <para style="p">
    <verse number="19" style="v" />Eh wilik taqe i riih rumaam i Manasés xiooj kikoj kiib' pan jinaj wach k'uxliis ruuk' i reey David, noq k'uch'ihil taqe i aj filisteo xooj chi q'aq'inik ruuk' i ru soldado i Saúl, xama' xkitob'eej ta wo' hoq i David ruum re' i ki soldado i aj filisteo ma' nkaaj ta ojik haa' chi q'aq'inik chi riij. Ruum xkikapaaj i keh chinee-oq inkiq'asaj kiib' chi kixilak i ru soldado i Saúl. <verse number="20" style="v" />Eh noq ojik i rub'an i reey David ar Siclag, re' taqe i riih rumaam i Manasés xi okik haa' ruuk' je' wili kib'ihnaal: Adnas, Jozabad, Jediael, Micael, Jozabad jinaj chik Eliú, Ziletai re' taqe re' k'amal kib'eeh i nimlaj ch'uq chi ki soldado i riih rumaam i Manasés. <verse number="21" style="v" />Re' taqe re' xitoob'inik reh i reey David chi q'aq'inik kuuk' taqe i kiokik chi i leq' chupaam i ye'aab' re' re'. Ruum chu'nchel i xtoob'inik reh re' re', kow kiib' re' keh xi kojarik chi k'amal kib'eeh taqe i soldado. <verse number="22" style="v" />Eh eqal eqal imponik i to'ool reh i reey David korehtaal xi ponik chi k'ih laj soldado, eh korik wo' hoq chi xi ponik chi ruk'ihaal soldado.</para>
  <para style="p">
    <verse number="23" style="v" />Je' wili kik'ihaal taqe i wilik kitz'a'amb'aal taqe i k'amal kib'eeh taqe i kow kiib' chi q'aq'inik xkian jinaj wach kik'ux ruuk' i David ar Hebrón reh chi xkipab'aa' i David chi reey chi jilow i reey Saúl, je' rukab' i ruq'orom i QaJaaw Dios. <verse number="24" style="v" />Re' taqe i riih rumaam i Judá waqiib' miil ruuk' waxiqiib' siento chi winaq kow kiib' chi q'aq'inik kiyohq'eem kinimlaj pulato ch'ihch', eh kiyohq'eem kiq'as ju' ch'ihch'. <verse number="25" style="v" />Eh re' taqe i riih rumaam i Semeón wuquub' miil ruuk' jinaj siento chi winaq taqe kow kiib', wilik kitz'amb'aal, eh kiyejaam kiib' chi q'aq'inik. <verse number="26" style="v" />Eh re' taqe i riih rumaam Leví kijib' miil ruuk' waq'iib' siento chi winaq taqe. <verse number="27" style="v" />Eh re' taqe i riih rumaam i Aarón ixib' miil ruuk' wuquub' siento chi winaq taqe. Re' Joiada i k'amal kib'eeh. <verse number="28" style="v" />Eh re' Sadoc i komanlik ak'un kow riib' chi q'aq'inik kiib' ru ka'winaq chi winaq i ruch'ihil re' taqe i k'amwik kib'eeh i awach reh i rajaaw. <verse number="29" style="v" />Eh re' taqe i riih rumaam i Benjamín ma' tokoom ta wo' taqe ruuk' i Saúl ixib' miil chi winaq taqe. Chupaam i q'iij re' re' kochiriij naq i Saúl wilkeeb'. <verse number="30" style="v" />Eh re' taqe i riih rumaam Efraín juninaq miil ruuk' waxiqiib' siento chi winaq taqe i kow kiib' chi q'aq'inik, eh wilik kib'iral chi wilik kajaawriik chi kixilak i awach keh. <verse number="31" style="v" />Eh re' i xi elik cho chi kixilak taqe i yejaal i ch'uq reh i riih rumaam i Manasés waxaqlaj miil chi winaq taqe. Re' keh xsik'arik kiwach chi xooj kipab'aa' i David chi reey. <verse number="32" style="v" />Eh re' taqe i riih rumaam i Isacar kiib' siento chi winaq k'amal kib'eeh. Re' ruuk' taqe i wilik kina'ojb'al keht'al chib'ih i naa ki a'nam i kuch aj Israel. Aha' wilik inkiq'or i keh re' wo' inki a'n i kuch kitinamitaal. <verse number="33" style="v" />Eh re' taqe i riih rumaam i Zabulón lajeeb' roxk'ahl miil chi winaq taqe kiyejaam kiib' kow kiib' chi q'aq'inik, wilik kitz'amb'aal chi korik. Eh ma' rub'an ta kiib' kik'ux noq kiooj chi q'aq'inik. <verse number="34" style="v" />Eh re' taqe i riih rumaam Efraín jinaj miil chi kajaaw soldado, kuch'ihil taqe i wuqlaj ru ka'winaq miil chi soldado wilik kinimaq pulato ch'ihch', wilik kiq'as ju' ch'ihch'. <verse number="35" style="v" />Eh re' taqe i riih rumaam i Dan kiyejaam kiib' chi q'aq'inik waxiqiib' ru ka'winaq miil ruuk' waqiib' siento chi winaq taqe. <verse number="36" style="v" />Eh re' taqe i riih rumaam i Aser ka'winaq miil chi winaq kiyejaam kiib' chi q'aq'inik. <verse number="37" style="v" />Eh chi juntar i nim ha' Jordán xi chalik jinaj siento miil ruuk' juninaq miil chi winaq re' taqe i riih rumaam i Rubén i riih rumaam i Gad, eh haa' taqe i yejaal ch'uq reh i riih rumaam i Manasés, eh k'ih b'uhr wach i tz'a'amb'al reh q'aq'inik wilik kuuk'.</para>
  <para style="p">
    <verse number="38" style="v" />Chu'nchel i winaq wili kiyejaam kiib' chi q'aq'inik kitusum kiib', eh chu'nchel i kik'ux noq xiooj Hebrón chupa'ab'jiik i David chi reyil chikinaah i aj Israel. Eh xkian jinaj wach kik'ux chu'nchel i aj Israel chupa'ab'jiik i David chi reyil. <verse number="39" style="v" />Eh chu'nchel i re' ixib' q'iij xi wihik ar ruuk' i David, ar xkian kiwa' kihaa' ruum re' taqe i kuch tinamitaal xiyej-anik kiwa' kihaa'. <verse number="40" style="v" />Eh je' wo' taqe i tinamit ma' najt ta wilik ar, je' wo' taqe i riih rumaam i Isacar, taqe i riih rumaam i Zabulón, taqe i riih rumaam i Efraín xkik'am chaloq i kiwa' kihaa', chikiij taqe b'uurux, taqe cameyo, taqe b'ooyax, taqe i tentzun, taqe imas wakax. Eh xkik'am wo' chaloq arina, i ma' kow ta laj kaxlanwi'k higo korjinaq wii', chiqiij laj uuva, raax uuva k'ih i xkik'am chaloq ruum jinaj runimaal suq kiil k'uxliis ar Israel.</para>
  <chapter number="13" style="c" />
  <para style="s">Re' reey David xuyejaa' wach chi naa ruk'amam reje Jerusaleem i loq'laj kaxa molik wii' i k'uhb'aal</para>
  <para style="p">
    <verse number="1" style="v" />Re' reey David xupahqaaj keh k'amal kib'eeh i jinaj miil chi soldado, je' wo' keh i k'amal kib'eeh i jinaj siento chi soldado, je' wo' keh i kajaaw i soldado. <verse number="2" style="v" />Eh je' wili i xuq'or keh i aj Israel kimolom kiib' ar: Wila' ruk'ul ak'ux taq i hat, wila' je' re' i xraaj i QaJaaw Dios chi neenqataq'aaj kik'amariik taqe i quch tinamitaal wilkeeb' chupaam chu'nchel i qatinamiit Israel. Eh nee wo' inqataq'aaj kik'amariik i k'amal kib'eeh aj tiij re' ruuk' taqe i aj Levíta wilkeeb' pan kitinamiit, pan kiye'aab' reh chi neenchalik kimol kiib' quuk' ayu'. <verse number="3" style="v" />Reh chi neenqak'am chaloq i hoj i loq'laj ru kaxa i QaJaaw Dios ruum nik' najtiil xub'an chi reyil i Saúl sahchinaq panqak'ux chi jumpech, inki.</para>
  <para style="p">
    <verse number="4" style="v" />Eh chu'nchel i tinamit kimolom kiib' ar xuk'ul kik'ux i xuq'or, eh xkiq'or chi ma' xta reet chi neenb'aan.</para>
  <para style="s">Re' David xraaj naq ruk'amam chaloq i loq'laj kaxa</para>
  <para style="r">(<ref loc="2SA 6:1-11">2 Sam 6.1-11</ref>)</para>
  <para style="p">
    <verse number="5" style="v" />Eh re' i reey David xumol kiwach chu'nchel i aj Israel xutoq'aa' reje pan tinamit Sihor wilik pank'ula't reh i Egipto, eh xponik panookb'al reh i Hamat. Reh chi xkesaj chee ru kaxa i QaJaaw Dios wilik ar Quiriat-jearim xkik'am cho Jerusaleem. <verse number="6" style="v" />Eh re' David ruch'ihil taqe chu'nchel i aj Israel xiooj Quiriat-jearim Baala wo' inkiq'or reh wilik paruyuq'ul i Judá re' chi xkesaj cho ar i ruloq'laj kaxa i QaJaaw Dios wilik chi kixilak taqe i k'achaach wilik kixiik' re' wo' hoq inq'orarik wii' i rub'ihnaal. <verse number="7" style="v" />Chi riij i re' xkesaj chaloq parupaat i Abinadab i loq'laj ru kaxa i QaJaaw Dios xkiyeew cho chupaam i jinaj ak' laj kareta. Eh re' Uza ruch'ihil i Ahío kib'esanik ree kareta. <verse number="8" style="v" />Re' David ruch'ihil chu'nchel i aj Israel xakipisk'anik chik pankooq ruum rusuqkiil kik'ux chuwach i Dios, k'ahchi' keeb' chi tz'uuy, k'ahchi' kiq'ojem i arpa, kik'ahaam wach q'ooj, kisetesaq q'ooj intz'ilininik, kipulato q'ooj, i kituun. <verse number="9" style="v" />Eh noq xi ponik chupaam i ye'aab' i resaj wii' riij i rutrigo i Quidón xkitoxk'iij i kooq i b'oyax kiqerinik ree kareta, eh re' Uza xuchohpaaj i ruloq'laj kaxa i QaJaaw Dios reh chi ma' xq'ehb'ik taj. <verse number="10" style="v" />Eh re' i QaJaaw Dios ma' k'isiin ta xchalik rujosq'iil chinaah i Uza ruum xuchop reje i loq'laj kaxa, ruum i re' xa re' yu' xukansaj i Uza.</para>
  <para style="p">
    <verse number="11" style="v" />Re' David ma' xponik ta chuwach i xub'an i QaJaaw Dios chi xukansaj i Uza. Ruum aj re', re' ye'aab' re' re' Pérez-uza i rub'ihnaal, eh je' re' rub'ihnaal xkahnik chi jumpech. <verse number="12" style="v" />Eh re' David chupaam q'iij re' re' ma' k'isiin ta xchalik ruyo'jiik chuwach i Dios, je' wili i xuq'or: Re' hin ma' ruk'ul ta chi neenuk'am reje i ruloq'laj kaxa i QaJaaw Dios, inki. <verse number="13" style="v" />Eh ma' xkik'am ta chaloq i loq'laj kaxa Jerusaleem parutinamiit i David. Ar la' xutaq'aaj rukanab'jiik chupaam i rupaat i Obed-edom patim pan tinamit Gat. <verse number="14" style="v" />Eh re' i ruloq'laj kaxa i QaJaaw Dios ixib' poh xkahnik chupaam i rupaat i Obed-edom. Re' QaJaaw Dios xukuxisaj i Obed-edom, je' wo' chu'nchel i chib'ih wilik reh.</para>
  <chapter number="14" style="c" />
  <para style="s">Re' Hiram xutaq'aaj reje i raj taqareel ruuk' i reey David</para>
  <para style="r">(<ref loc="2SA 5:11-12">2 Sam 5.11-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Re' Hiram i kireey i aj Tiro xutaq'aaj taqe reje i raj taqareel ruuk' i reey David. Eh wilik taqe tz'aqool, taqe i aj sehk xutaq'aaj reje, wilik taqe i chee' chakaltee' xutaq'aaj, reh chi naa kiyejaam rupaat i reey David. <verse number="2" style="v" />Re' David xureq chi riij chi re' Dios xpaab'anik reh chi reyil chikinaah i Israel. Eh xureq wo' chi riij chi re' Dios xtoob'inik reh chi xelik korik i ruk'axariik i rutinamiit Israel xub'an.</para>
  <para style="s">Re' taqe i rak'uun i David xi-aasjik Jerusaleem</para>
  <para style="r">(<ref loc="2SA 5:13-16">2 Sam 5.13-16</ref>; <ref loc="1CH 3:5-9">1 Cron 3.5-9</ref>)</para>
  <para style="p">
    <verse number="3" style="v" />Re' reey David k'ih taqe iruxoqil xuk'am ar Jerusaleem, eh k'ih taqe i rak'uun, rixq'uun xwihik kuuk'. <verse number="4" style="v" />Re' taqe i rak'uun xi-aasjik Jerusaleem je' wili kib'ihnaal: Samúa, Sobab, Natán, Salomón. <verse number="5" style="v" />Eh Ibhar, Elisúa, Elpelet, <verse number="6" style="v" />Noga, Nefeg, Jafía, <verse number="7" style="v" />Eh Elisama, Beeliada, Elifelet.</para>
  <para style="s">Re' reey David xub'an keh i aj filisteo</para>
  <para style="r">(<ref loc="2SA 5:17-25">2 Sam 5.17-25</ref>)</para>
  <para style="p">
    <verse number="8" style="v" />Eh noq xkib'iraj i aj filisteo chi re' i David xpa'ab'jik chi reyil chikinaah chu'nchel i aj Israel, xkimol cho kiib' xi chalik chi q'aq'inik ruuk'. Eh noq xrib'iraj i David chi je' re' xooj taqe ruk'ulb'ilej. <verse number="9" style="v" />Eh re' taqe i aj filisteo xkijil cho kiib', ar xi kahnik wach k'ixkaab' Refaim. <verse number="10" style="v" />Eh re' reey David xupahqaaj ree Dios parutiij je' wili xuq'or:</para>
  <para style="p">Jaaw, ¿Mi ruk'ul chi nee kinooj chi kik'ulb'ejiik taqe i aj filisteo? ¿Mi nee taqe naaq'asaj panuq'ab'? inki.</para>
  <para style="p">Re' QaJaaw Dios je' wili i xuq'or:</para>
  <para style="p">Neerub'an chi nee tiooj chi kik'ulb'ejiik, re' hin naa nuq'asam taqe panaq'ab', i nuchjik.</para>
  <para style="p">
    <verse number="11" style="v" />Eh re' reey David ruch'ihil taqe i ru soldado xiooj chupaam i ye'aab' Baal-perazim, ar xkian reh taqe i aj filisteo. Eh re' David je' wili i xuq'or: Re' QaJaaw Dios xusach kiwach i ki-ixowanik qawach, je' naa elal ha' xik'ik k'amwoq keh, inki. Re' ye'aab' re' re' Baal-perazim i rub'ihnaal xkikoj. <verse number="12" style="v" />Eh re' taqe i aj filisteo xkimol chi elik xkiq'eb' kahnoq ar taqe i kitiyoox, eh re' David xutaq'aaj kik'atariik.</para>
  <para style="p">
    <verse number="13" style="v" />Re' taqe i aj filisteo kimol wo' chik kiib' wach k'ixkaab' Refaim. <verse number="14" style="v" />Eh re' reey David xupahqaaj wo' chik ree Dios Parutiij, re' QaJaaw Dios je' wili i xuq'or: Neerub'an chi nee taq inooj ak'ulb'ilej taqe, xa re' la' ma' nee ta ti okik taq chikiwach cha sutej taq kiij ar taq neenak'ulb'ilej taqe i wilkeeb' wii' i chee' balsamo. <verse number="15" style="v" />Eh noq neenab'iraj i choqik chi ju' taqe i chee' balsamo, nee tiooj chi kik'ulb'ejiik ruum re' hin naa wojiik chi peet chawach re' hin naa nuye'em q'ab' chi nee taq a'nam keh i ki soldado i aj filisteo, inki.</para>
  <para style="p">
    <verse number="16" style="v" />Eh re' reey David xub'an wo' hoq i xq'orarik reh ruum i re' xkian reh taqe i kisolado i aj filisteo. Ar xkitoq'aa' reje pan tinamit Gabaón, eh ko xi ponik pan tinamit Gezer. <verse number="17" style="v" />Re' taqe i xub'an re' re' i David xelik rib'iral xa aha' yuuq'. Eh re' QaJaaw Dios xuyeew q'ab' chi chu'nchel i nimaq tinamit xiyo'jik ruum i reey David.</para>
  <chapter number="15" style="c" />
  <para style="s">Re' reey David xuk'am chaloq i ruloq'laj kaxa i QaJaaw Dios Jerusaleem</para>
  <para style="r">(<ref loc="2SA 6:12-23">2 Sam 6.12-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Re' reey David xuyejaa' i rupaat Jerusaleem re' rutinamiit i David. Eh xuyejaa' wo' hoq i ye'aab' re' xuyejaa' wii' jinaj itz'ihy naah paat ye'aab' reh i ruloq'laj kaxa i QaJaaw Dios. <verse number="2" style="v" />Re' David je' wili xuq'or: Re' i ruloq'laj kaxa i QaJaaw Dios ma' awach taj i tokoom naa ruk'amwiik cho reh. Xa re' wo' taqe i aj Levíta naakik'amwiik cho reh ruum xa re' wo' keh sik'ooj kiwach ruum i QaJaaw Dios chuk'amariik. Eh chi eliik naa kiwihik parukamaj i Dios, inki.</para>
  <para style="p">
    <verse number="3" style="v" />Eh re' reey David xumol kiwach chu'nchel i aj Israel ar Jerusaleem, reh chi xi okik haa' chuk'amariik chaloq i loq'laj ru kaxa i QaJaaw Dios chupaam i ye'aab' xuyejaa' i David. <verse number="4" style="v" />Eh re' David xumol wo' kiwach i riih rumaam i Aarón, je' wo' taqe i riih rumaam i Leví, je' wili kik'ihaal. <verse number="5" style="v" />Re' taqe i riih rumaam i Coat xi ponik jinaj siento ruuk' juninaq chi winaq xa kuuk' kiib'. Eh re' i Uriel i k'amal kib'eeh. <verse number="6" style="v" />Eh re' taqe i riih rumaam i Merari xi ponik kiib' siento ruuk' juninaq chi winaq xa kuuk' kiib'. Eh re' i Asaías i k'amal kib'eeh. <verse number="7" style="v" />Eh re' taqe i riih rumaam i Gersón xi ponik jinaj siento ruuk' lajeeb' ru ka'winaq chi winaq xa kuuk' kiib'. Eh re' i Joel k'amal kib'eeh. <verse number="8" style="v" />Eh re' taqe i riih rumaam i Elizafán, xi ponik kiib' siento chi winaq xa kuuk' kiib'. Eh re' i Semaías i k'amal kib'eeh. <verse number="9" style="v" />Eh re' taqe i riih rumaam i Hebrón xi ponik kajwinaq chi winaq xa kuuk' kiib'. Eh re' i Eliel k'amal kib'eeh. <verse number="10" style="v" />Eh re' taqe i re' ruuk' i riih rumaam i Uziel xi ponik jinaj siento ruuk' kab'laj chi winaq xa kuuk' kiib'. Eh re' i Aminadab k'amal kib'eeh.</para>
  <para style="p">
    <verse number="11" style="v" />Chi riij i re', re' David xutaq'aaj kik'amariik taqe i kajaaw i k'amal kib'eeh aj tiij aj Levíta je' wili kib'ihnaal Sadoc, Abiatar. Eh je' wo' taqe i k'amal kib'eeh aj tiij Uriel, Asaías, Joel, Semaías Eliel, Aminadab. <verse number="12" style="v" />Je' wili xuq'or keh: Re' taq i hat, i hat taq k'amal kib'eeh taqe i riih rumaam Leví cha santoheej awiib' taq i hat, je' wo' chu'nchel i awach aweh, reh chi nee taq i na a'n cho ruk'amariik i loq'laj ru kaxa i QaJaaw i qaDios i hoj, hoj aj Israel. Reh chi neen wihik chupaam i ye'aab' xnuyejaa'. <verse number="13" style="v" />Ruum chi ma' re' ta taq i hat i xat k'amwik cho reh i ru kaxa i QaJaaw Dios pampeet. Re' QaJaaw Dios wilik taqe i xukansaj, ruum chi ma' xqapahqaaj ta reh nik' wach rub'aan naa qa'nam, inki.</para>
  <para style="p">
    <verse number="14" style="v" />Je' aj re' noq re' taqe i k'amal kib'eeh aj tiij aj Levíta xkisantoheej kiib' reh chi xkian cho ruk'amariik i ruloq'laj kaxa i QaJaaw re' i qaDios i hoj aj Israel. <verse number="15" style="v" />Eh re' taqe i riih rumaam i Leví xkik'am wo' chaloq i ruloq'laj kaxa i QaJaaw Dios xkitehlaaj cho naah kitileb' ruuk' i chee' tehlb'al reh je' rukab' i ruq'orom i Dios ruuk' chii' i Moisés.</para>
  <para style="p">
    <verse number="16" style="v" />Eh re' i reey i David je' wili i xuq'or keh i k'amal kib'eeh i aj Levíta, chi naa rusik'im wach taqe i aj tz'uuy chi kixilak reh chi naa kianam kitz'uuy chi suq kik'ux ruuk' i kiarpa, ruuk' kikok' k'ahaam wach q'ooj, ruuk' i setesaq q'ooj kitzilininik. <verse number="17" style="v" />Re' taqe i aj Levíta je' wili i kib'ihnaal i xkisik' wach: Hemán rak'uun i Joel, Asaf rak'uun i Berequías, ma' tokoom ta wo' ruuk' i Hemán riih rumaam i Merari. Eh xkisik' wo' wach i Etán rak'uun i Cusaías. <verse number="18" style="v" />Eh wilik taqe i ma' tokoom ta kuuk' chi xi okik haa' chub'aan i kamanik ma' q'e' ta nim wach, je' wili kib'ihnaal: Zacarías, Jaaziel, Semiramot, Jehiel, Uni, Eliab, Benaía, Maasías, Matatías, Elifelehu, Micnías. Eh kisik' wo' wach taqe i kicha'jinik reh i ookb'al, je' wili kib'ihnaal: Obed-edom, Jeiel.</para>
  <para style="p">
    <verse number="19" style="v" />Eh re' taqe i aj tz'uuy Hemán, Asaf, i Etán re' keh ye'ooj chikinaah chi naa kiq'ojem taqe i pulato q'ooj intz'ilininik re' ruuk' taqe i q'an ch'ihch'. <verse number="20" style="v" />Eh re' taqe i kik'amwik rub'eeh ruuk' i ruq'ojiik i kikok' k'ahaam wach q'ooj, re' Zacarías, Aziel, Semiramot, Jehiel, Uni, Eliab, Maasías, Benaía. <verse number="21" style="v" />Eh re' taqe ink'ulb'ilinik keh chi tz'uuy ruuk' i ruq'ojiik i kiarpa re' i Matatías, Elifelehu, Micnías, Obed-edom, Jeiel, Azazías. <verse number="22" style="v" />Re' Quenanías, i k'amal kib'eeh taqe i aj Levíta kitz'uyinik ruuk' i kiq'ooj, ruum re' reh inchol q'ooj, eh inchol tz'uuy chi korik. <verse number="23" style="v" />Eh re' Berequías, ruch'ihil i Elcana kicha'jinik reh i ruloq'laj kaxa i QaJaaw Dios. <verse number="24" style="v" />Eh re' taqe i kixulinik reh i tuun i kiooj chi peet b'eeh chuwach i ruloq'laj kaxa i QaJaaw Dios, re' taqe i k'amal kib'eeh aj tiij je' wili kib'ihnaal: Sebanías, Josafat, Natanael, Amasai, Zacarías, Benaía, Eliezer. Eh re' Ebed-edom, Jehías cha'jen reh i ruloq'laj kaxa i QaJaaw Dios.</para>
  <para style="p">
    <verse number="25" style="v" />Eh re' David ruch'ihil taqe i k'amal kib'eeh i aj Israel ruch'ihil taqe i k'amal kib'eeh i ju'jun nimaq ch'uq chi soldado, xiooj chi suq kik'ux parupaat i Obed-edóm chi rehtesjiik i ruloq'laj kaxa i QaJaaw Dios. <verse number="26" style="v" />Eh noq xkilow i aj Levíta chi xitoob'jiik ruum i Dios chuk'amariik chaloq i loq'laj kaxa, wuquub' i k'ijool wakax, eh wuquub' i imas tentzun xkiq'asaj chi kimayiij. <verse number="27" style="v" />Re' reey David saq i ruso' rukojom, re' ruuk' i holohik itz'ihy lino, rukojom wo' ruso' xama' nim ta rooq, je' wo' taqe i aj Levíta kitehlanik reh i loq'laj kaxa. Eh je' wo' hoq i Quinanías i k'amwik kib'eeh i aj tz'uuy. <verse number="28" style="v" />Eh chu'nchel i aj Israel xi k'amwik cho reh i ruloq'laj kaxa i QaJaaw Dios molik wii' i k'uhb'aal, xasuq chik kik'ux xkixulej paam taqe i ruk'aa' kaprax, taqe i tuun, xkiq'ojej taqe i pulato q'ooj, xkiq'ojej taqe i kok' k'ahaam wach q'ooj je' wo' taqe i kiarpa. <verse number="29" style="v" />Eh noq re' i ruloq'laj kaxa i QaJaaw Dios molik wii' i ruk'uhb'aal xponik Jerusaleem re' rutinamiit i David. Re' Mical i rixq'uun i Saúl xrilow cho pan ventana chi re' reey David xampisk'anik chik parooq ruum i rusuqkiil ruk'ux, eh ma' k'isiin ta xchalik ruk'aa' chinaah.</para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Eh re' i loq'laj ru kaxa i QaJaaw Dios ar xkiyeew chupaam i itz'ihy naah paat xuyejaa' i reey David. Eh kik'at taqe i chikop chi kimayiij chuwach i QaJaaw Dios, xkiq'asaj wo' hoq i kimayiij k'amb'al kiib' panotob'il ruuk' i QaJaaw Dios. <verse number="2" style="v" />Eh noq xukohlaaj i David ruq'ahteesjiik i k'atoj chikop chi mayiij, je' wo' taqe i mayiij k'amb'al kiib' panotob'il ruuk' i QaJaaw Dios, xukuxisaj taqe i tinamit parub'ihnaal i QaJaaw Dios. <verse number="3" style="v" />Eh chu'nchel i tinamit chi nimaq chi kok' taq xuyeew ju'jun ki suq laj kaxlanwi'k, eh xuyeew wo' ju'jun kikaxlanwi'k korjinaq ruuk' i chiq uuva, eh xuyeew wo' ju'jun t'ohr kib'ahoj tiib'.</para>
  <para style="p">
    <verse number="4" style="v" />Eh re' David wilik taqe i aj Levíta xupab'aa' chi xkian i rukamaj i QaJaaw Dios chuwach i loq'laj ru kaxa i QaJaaw. Reh chi xkian i pahqanik, i loq'inik, i t'iosinik, chuwach i QaJaaw i qaDios i hoj, hoj aj Israel. <verse number="5" style="v" />Re' taqe i aj Levíta xusik' wach, je' wili kib'ihnaal: Re' peet Asaf, re' rukab' Zacarías, re' Matatías, re' Eliab, re' Benaía, re' Obed-edom, re' i Jeiel jinaj chik, wilik taqe kiq'ooj, wilik kok' kiq'ooj k'ahaam wach, wilik kiarpa. Eh re' i Asaf inq'ojinik reh i pulato q'ooj. <verse number="6" style="v" />Eh re' taqe i k'amal kib'eeh aj tiij Benaía, Jahaziel kixulinik reh taqe i tuun chuwach i ruloq'laj kaxa i QaJaaw Dios molik wii' i ruk'uhb'aal.</para>
  <para style="s">Re' tz'uuy xub'an i reey David t'iosb'al reh i rotob'il i Dios</para>
  <para style="r">(<ref loc="PSA 96:1-13">Sal 96.1-13</ref>; <ref loc="PSA 105:1-15">105.1-15</ref>; <ref loc="PSA 106:47-48">106.47-48</ref>)</para>
  <para style="p">
    <verse number="7" style="v" />Chupaam i q'iij re' re' kore' peet xuq'or i David reh i Asaf, je' wo' keh taqe i ruch'ihil chi naa kit'iosem i rotob'il i QaJaaw Dios ruuk' taqe i tz'uuy wili:</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Chat'iosej taq reh i QaJaaw Dios i rotob'il</para>
  <para style="q">cha q'or taq rib'iral rub'ihnaal.</para>
  <para style="q">Eh chayeew taq keh chi naab'jik chu'nchel i tinamit taqe rub'anam chaloq.</para>
  <para style="q">
    <verse number="9" style="v" />Cha a'n taq atz'uuy ye'b'al ruloq'il,</para>
  <para style="q">chawesaj taq i ruq'orkiil i nimaq wach na'ojb'al rub'anam chaloq.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Chayeew taq ruloq'il i rusantolaj b'ihnaal.</para>
  <para style="q">Eh chawuncheelaal taq i hat i ti sik'wik taq reh i QaJaaw Dios</para>
  <para style="q">suuqb'oq taq ak'ux.</para>
  <para style="q">
    <verse number="11" style="v" />Chasik' taq i rajaawriik i QaJaaw Dios,</para>
  <para style="q">juneliik taq cha pahqaaj i rotob'il.</para>
  <para style="q">
    <verse number="12" style="v" />Mansahchik taq panak'ux i nimaq wach na'ojb'al,</para>
  <para style="q">taqe i nimaq wach ma' ilooj taj rub'anam. K'oloq taq panak'ux i q'ataj q'orik i rub'an.</para>
  <para style="q">
    <verse number="13" style="v" />Re' taq i hat, i hat taq riih rumaam i Israel</para>
  <para style="q">i raj kamanoom i Dios. Hat taq riih rumaam</para>
  <para style="q">i Jacob i rusik'im taq chawach i QaJaaw Dios.</para>
  <para style="q">
    <verse number="14" style="v" />Chanab'eej taq chi re' reh i QaJaaw i qaDios.</para>
  <para style="q">Re' wo' reh wilik chi taaq'anik chinaah chu'nchel i wach ak'al.</para>
  <para style="q">
    <verse number="15" style="v" />Re' reh wilik paruk'ux chi juneliik i ruq'orom chaloq chi naa rub'anam.</para>
  <para style="q">Xajarub' pa' ch'iht i k'acharik neenik'ik xama' jaruuj wo' neenik'ik paruk'ux.</para>
  <para style="q">
    <verse number="16" style="v" />Re' wo' hoq i ruq'orom cho reh</para>
  <para style="q">pampeet i Abraham, chi naa rub'anam ruuk'.</para>
  <para style="q">Je' wo' hoq noq xuq'or chee xti korik</para>
  <para style="q">chi riij i xub'an cho ruuk' i Isaac.</para>
  <para style="q">
    <verse number="17" style="v" />Eh xuyejaa' wach ruuk' i Jacob,</para>
  <para style="q">xuyeew rajaawriik chi je' jinaj k'uhb'aal,</para>
  <para style="q">xuyejaa' wach kuuk' i aj Israel chi naa kianam chi juneliik.</para>
  <para style="q">
    <verse number="18" style="v" />Re' noq xuq'or cho keh chi je' wili:</para>
  <para style="q">Re' hin naa taq nuye'em aweh chi akooch i ye'aab' Canaán,</para>
  <para style="q">naa taq awehchaam chi jumpech, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Je' re' i xq'orarik keh atoob' ta ma' q'e' ta k'ih taqe,</para>
  <para style="q">xa je' taqe aj patal ponoq chupaam i ye'aab' re' re'.</para>
  <para style="q">
    <verse number="20" style="v" />Eh xata wo' jarub' i tinamit ki-ik'ik wii'</para>
  <para style="q">chi je' pankok' tinamit, chi je' panimaq tinamit.</para>
  <para style="q">
    <verse number="21" style="v" />Re' Dios ma' xuyeew ta q'ab' chi awach ta xb'anik ti' k'axik keh</para>
  <para style="q">xuq'il la' taqe i reey je' wili xuq'or keh:</para>
  <para style="q">
    <verse number="22" style="v" />Ma'an taq ti' k'axik keh i wak'uun wixq'uun nusik'im cho kiwach.</para>
  <para style="q">Eh ma' chih wo' awuchej taqe ijalal nuq'oral, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Eh chawunchelaal taq i hat i wilkaat taq</para>
  <para style="q">ayu' wach ak'al cha tz'uyej taq wach i QaJaaw Dios.</para>
  <para style="q">Eh rajlaal i q'iij taq cha q'or rib'iral chi re' reh aj ko'loom.</para>
  <para style="q">
    <verse number="24" style="v" />Chaq'or wo' taq rib'iral ruloq'il keh chu'nchel i tinamit,</para>
  <para style="q">Je' wo' hoq i nimaq kiwach ma' ilooj taj i rub'an.</para>
  <para style="q">
    <verse number="25" style="v" />Re' QaJaaw Dios xiik' naah nimaal wach,</para>
  <para style="q">ruum aj re' i ruk'ul chi naaqaye'em ruloq'il.</para>
  <para style="q">Eh xa re' wo' reh nim rajaawriik chikiwach taqe i tiyoox.</para>
  <para style="q">
    <verse number="26" style="v" />Re' i ki dios i tokoom tinamit xa tiyoox taqe, ma' xta kajaawriik.</para>
  <para style="q">Raaj i qaDios i hoj re' reh xyej-anik reh i taxaaj.</para>
  <para style="q">
    <verse number="27" style="v" />Ma' k'isiin ta saqumaal chii' wach i QaJaaw Dios.</para>
  <para style="q">Eh xiik' naah nimaal i rajaawriik, je' wo' hoq</para>
  <para style="q">i ruloq'il ink'ularik chupaam i rusantolaj paat.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Eh chawunchelaal taq i hat tinamit wilkaat taq ayu' wach ak'al,</para>
  <para style="q">chayeew taq rajaawriik, ruloq'il i QaJaaw Dios.</para>
  <para style="q">
    <verse number="29" style="v" />Chayeew taq ruloq'il i QaJaaw Dios</para>
  <para style="q">ruum xa re' wo' reh i ruk'ul chi naa taq aloq'em.</para>
  <para style="q">Eh chaxuk'aa' taq awiib' chuwach</para>
  <para style="q">chak'am taq chaloq aamayiij chupaam i ru santo laj paat.</para>
  <para style="q">
    <verse number="30" style="v" />Chu'nchel ta naq i tinamit neekiyohlinik reh,</para>
  <para style="q">ruum re' reh xye'wik reh panruye'aab' i wach ak'al</para>
  <para style="q">reh chi ma' awach ta neenk'uyu'sanik reh.</para>
  <para style="q">
    <verse number="31" style="v" />Neeta naq insuuqb'ik ruk'ux i taxaaj,</para>
  <para style="q">je' wo' wach ak'al. Eh cha q'or taq keh chu'nchel</para>
  <para style="q">i tinamit chi re' i QaJaaw Dios xti manlik reey.</para>
  <para style="q">
    <verse number="32" style="v" />Neeta naq ink'uyu'jik i palaw,</para>
  <para style="q">je' wo' i wilkeeb' chupaam.</para>
  <para style="q">Eh nee ta naq insuuqb'ik ruk'ux i wach ak'al,</para>
  <para style="q">je' wo' taqe i wilkeeb' chupaam.</para>
  <para style="q">
    <verse number="33" style="v" />Neeta naq insuuqb'ik kik'ux chuwach</para>
  <para style="q">i QaJaaw Dios taqe i chee' wilkeeb' pantaq ch'ahn,</para>
  <para style="q">ruum re' reh xchalik chi q'ataj q'orik chinaah i wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" />Chat'iosej taq reh i Dios, ruum re' reh q'e' atoob'</para>
  <para style="q">juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="35" style="v" />Eh je' taq wili i cha q'or reh:</para>
  <para style="q">QaJaaw Dios qoh ako'leej tii ruum xa re' wo' hat ti ko'linik qeh.</para>
  <para style="q">Neeta tii qoh awesaj chi kixilak i tokoom tinamit.</para>
  <para style="q">Reh chi neenqaq'or rib'iral asantolaj b'ihnaal,</para>
  <para style="q">reh chi suq qak'ux noq neetiqaloq'eej.</para>
  <para style="q">
    <verse number="36" style="v" />Neeta naq inye'arik ruloq'il i qaDios i hoj, hoj aj Israel,</para>
  <para style="q">je' ta naq re' i neenb'aan reh chi juneliik, inki David.</para>
  <para style="b" />
  <para style="p">Eh je' ta naq re' inki taqe chu'nchel i tinamit, eh xkiloq'ej i QaJaaw Dios.</para>
  <para style="s">Re' taqe i aj Levíta xi kahnik chi rilariik i loq'laj kaxa</para>
  <para style="p">
    <verse number="37" style="v" />Eh re' reey David xukanaa' i Asaf, ruch'ihil taqe i ma' tokoom ta ruuk' aha' wilik wii' i loq'laj kaxa molik wii' i ruk'uhb'aal i QaJaaw. Reh chi xkian i kamanik rajlaal q'iij re' i ajwaal wach chi b'anarik. <verse number="38" style="v" />Eh xukanaa' wo' ar i Abed-edom ruch'ihil taqe i waxiqiib' ru ka'winaq chi winaq ma' tokoom ta ruuk'. Eh re' Obed-edom, rak'uun i Jedutún, ruch'ihil i Hosa xi kahnik chi kamanik panookb'al. <verse number="39" style="v" />Eh re' i Sadoc ruch'ihil taqe i ruch aj tiij xipa'ab'jik chuk'amariik rub'eeh i loq'inik i chupaam i rusanto laj itz'ihy naah paat i QaJaaw Dios ar Gabaón chinaah inajt naah ye'aab'. <verse number="40" style="v" />Reh chi re' taqe i keh xik'atwik reh i mayiij rajlaal wahq'eq, rajlaal xq'eq chinaah i artaal chuwach i QaJaaw Dios. Reh chi xkian nik' wach i tz'ihb'amaj rehtaliil chupaam i ruk'uhb'aal i QaJaaw Dios, je' rukab' i xuq'or keh i aj Israel. <verse number="41" style="v" />Eh xkahnik wo' kuuk' i Hemán, ruch'ihil i Jedutún chi kitoob'jiik i xsik'arik kiwach ruuk' irulooq'jiiki QaJaaw Dios ruum re' reh juneliik wilik ketelinik wachiis ruuk'. <verse number="42" style="v" />Eh re' i Hemán, re' i Jehutún kixulinik reh taqe tuun, re' wo' keh kiq'ojinik reh i pulato q'ooj, eh inkik'ulb'ilej taqe inkik'er kichii' chi tz'uuyjik wach i QaJaaw Dios. Re' taqe i rak'uun i Jedutún kikamanik panookb'al.</para>
  <para style="p">
    <verse number="43" style="v" />Chi riij i re', chu'nchel i tinamit xi sutinik reje pankipaat. Eh re' reey David xsutinik wo' reje parupaat, reh chi xponik rukuxisaj taqe i awach reh.</para>
  <chapter number="17" style="c" />
  <para style="s">Re' i QaJaaw Dios wilik i xuyejaa' wach ruuk' i reey David</para>
  <para style="r">(<ref loc="2SA 7:1-29">2 Sam 7.1-29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Noq re' reey David wilik chik chupaam i paat i rub'an wii' taaq'anik je' wili i xuq'or reh i Natán jalal ruq'oral i Dios:</para>
  <para style="p">Chakoj rehtaal re' hin wilkiin chupaam jinaj i paat korjinaq ruuk' i chee' chakaltee', eh re' i ruloq'laj kaxa i QaJaaw xa chupaam i itz'ihy naah paat wilik, inki.</para>
  <para style="p">
    <verse number="2" style="v" />Eh re' Natán je' wili i xuq'or:</para>
  <para style="p">Re' hat cha a'n taqe chu'nchel inawaaj rub'aan, ruum re' Dios wilik awuuk' chatoob'jiik, inki.</para>
  <para style="p">
    <verse number="3" style="v" />Eh xa chupaam wo' aq'ab' re' re' q'orob'jik chee Natán ruum i Dios je' wili xq'orarik reh: <verse number="4" style="v" />Hiy ruuk' i David i waj kamanoom cha q'or reh re' QaJaaw Dios je' wili i ruq'or: Re' hat David ma' re' tee hat naa ayej-aniik reh i nupaat naa nuwihiik wii'. <verse number="5" style="v" />Re' hin xti korik i nuq'or chi ma' jank'al ta kimpatinik chupaam jino'q i paat, i wesam taqe chaloq i nutinamiit Israel, ar Egipto, eh xink'uloq ayu' yu'naak. Re' hin xa pan itz'ihy kinaah paat wo' kinwihik. <verse number="6" style="v" />Re' hin nik' najtiil xwuch'ihleej taqe chaloq i nutinamiit Israel. Re' taqe i xnukoj chi taaq'anik chikinaah i aj Israel ma' nik' ta xnuq'or keh chi naa kiyejaam jino'q nupaat chee' chakaltee' naa rukorjiik wii'. <verse number="7" style="v" />Je' re' noq cha q'or reh i waj kamanoom David chi re' hin i Dios nim wajaawriik je' wili i nuq'or reh: Re' hin xat wesaj cho chi cha'jinik tentzun, reh chi xat nupab'aa' chi reyil chinaah i nutinamiit Israel. <verse number="8" style="v" />Re' hin xintoob'inik aweh xa aha' pa' xat ponik. Eh xnuq'asaj taqe panaq'ab' i ki-ixowanik awach. Xnuyeew awajaawriik je' rukab' i kajaawriik i winaq, xti wilik kajaawriik wilkeeb' wach ak'al. <verse number="9" style="v" />Eh xnuyeew wo' kiye'aab' i nutinamiit Israel reh chi ar naakipatiniik chupaam i kiye'aab' chi suq kik'ux. Reh wo' hoq chi ma' awach ta neenjot'wik keh, eh ma' awach ta neenquchwik i chib'ih keh, je' rukab' imb'aan keh pampeet. <verse number="10" style="v" />Xa re' wo' noq xnupab'aa' taqe chaloq i q'atal q'orik chikinaah i nutinamiit Israel xtohq'ik cho ti' k'axik keh. Eh re' hat yu'naak naa kaat nuhi'lisam, ma' naa ta chik kaat kijot'om i ki-ixowanik awach, i nuq'or wo' aweh i hin, hin Dios chi naa nuye'em awak'uun, awixq'uun. <verse number="11" style="v" />Eh noq naa ruponiik i q'iij noq naa akimiik reje naa rojiik taqe areqem aamaam awati't. Re' hin jinaj keh awak'uun naa nukojom chajilow, chi reyil. <verse number="12" style="v" />Eh re' reh naa ruyej-aniik i nupaat. Eh re' hin naa nukojwiik reh chi reyil chi juneliik. <verse number="13" style="v" />Re' hin naa nukahniik chi hin raJaaw, eh re' reh naa rukahniik chi wak'uun. Re' hin ma' naa ta nukanaam ruketeljiik wach, je' rukab' noq xnukanaa' ruketeljiik kiwach i xwihik cho chi reyil peet chawach i hat. <verse number="14" style="v" />Re' hin naa nuye'em rajaawriik chinaah i nutinamiit naa wo' nuye'em rajaawriik chi juneliik chi reyil. Eh naa ruwihiik jino'q awiih aamaam naa rokiik chi reyil, tiko'q reh, inki i Dios.</para>
  <para style="p">
    <verse number="15" style="v" />Eh re' Natán jalal ruq'oral i Dios xooj wo' ruuk' i David xooj ruq'or reh chu'nchel i xq'orarik reh, je' wo' hoq i xk'uhtjik reh.</para>
  <para style="p">
    <verse number="16" style="v" />Noq xrib'iraj i David chi je' re' xokik i koq chupaam i itz'ihy naah paat chi tiij chuwach i QaJaaw Dios je' wili xuq'or: ¿Chib'ih nub'anam i hin chib'ih kianam i wak'uun wixq'uun chi xayeew weh awotob'il wili? <verse number="17" style="v" />QaJaaw Dios re' hat ma' xata re' wili xaq'or la' wo' hoq chi re' taqe i wiih numaam i hin, hin awaj kamanoom naa kiwihiik chi reyil chi juneliik. QaJaaw Dios chawach i hat hin jinaj winaq wilik rajaawriik. <verse number="18" style="v" />¿Chib'ih chik jariik i nupahqaaj chi riij i nuloq'il xayeew? Re' hat aweht'al chik nik' wach i nuna'ojb'al i hin, hin awaj kamanoom. <verse number="19" style="v" />QaJaaw Dios ruum chi q'e' kinak'ax panawánima hin awaj kamanoom xa a'n wuuk' i runimaal wach na'ojb'al wili. Reh chi naa ruk'utiniik taqe i runimaal awajaawriik. <verse number="20" style="v" />QaJaaw Dios ma' xta chik jino'q Dios chi je' rukab' i hat, eh ma' awach ta neemb'anik i na a'n je' wo' rukab' i qib'iram cho rib'iral. <verse number="21" style="v" />Eh ma' jino'q i tinamit wach ak'al chi je' rukab' aatinamiit Israel. QaJaaw Dios re' hat xat ko'linik cho keh reh chi xakoj taqe chi aatinamiit. Re' hat xa a'n taq i nimaq wach ma' ilooj taj i nimaq wach sahchb'al k'uxliis re' noq xawesaj taqe i tokoom tinamiit pan kiye'aab' aatinamiit. Eh xawesaj taqe cho ar Egipto. <verse number="22" style="v" />Re' hat xasik' kiwach i aj Israel, reh chi xi kahnik chi aatinamiit taqe chi juneliik. Eh chi re' hat xat kahnik chi ki Dios.</para>
  <para style="p">
    <verse number="23" style="v" />QaJaaw Dios nee ta tii na a'n cho chi juneliik i xaq'or weh, i hin, hin awaj kamanoom. Neeta naq inwihik kajaawriik taqe i wiih numaam chi reyil je' rukab' i xaq'or weh. <verse number="24" style="v" />Neeta naq inye'arik runimaal wach ab'ihnaal chi juneliik. Eh nee ta naq inq'orarik rib'iral chi re' hat i Dios nim awajaawriik qaDios i hoj, hoj aj Israel. Neeta naq i nacha'jeej taqe chi juneliik i wiih numaam chi reyil, i hin, hin awaj kamanoom. <verse number="25" style="v" />QaJaaw Dios re' hat xayeew weh chi naab'jik chi naa nuwihiik chi reyil. Eh chi re' taqe i wiih numaam naa akojom chi reyil chi juneliik. Je' aj re' noq re' hin, hin awaj kamanoom k'ahchi' kiin chi tiij chawach. <verse number="26" style="v" />Re' hat Jaaw, hat Dios aq'orom rib'iral chi naa aye'em weh aawotob'il, i hin, hin awaj kamanoom. <verse number="27" style="v" />QaJaaw Dios i nupahqaaj aweh chi chakuxisaj taqe chi juneliik i wiih numaam i hin, hin awaj kamanoom ruum xaq'or chi naa ruwihiik kajaawriik chi juneliik chawach. Ruum aq'orom chi naa kiin akuxisam hin, eh je' wo' taqe i wiih numaam, inki David.</para>
  <chapter number="18" style="c" />
  <para style="s">Re' q'aq'inik xub'an i reey David</para>
  <para style="r">(<ref loc="2SA 8:1-14">2 Sam 8.1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Eh koq'uun chik re' David xub'an wo' chik i q'aq'inik kuuk' i aj filisteo. Eh xusach wach i kajaawriik, xuq'uch keh i tinamit Gat, je' wo' hoq i kok' ye'aab' wilik chi junsuut. <verse number="2" style="v" />Eh xub'an wo' keh i aj Moab xi kahnik chi ri'sil i rajaawriik, eh xkitoj chik riij reh i kiye'aab'.</para>
  <para style="p">
    <verse number="3" style="v" />Re' David xub'an wo' reh i Hadad-ezer kireey i aj Soba re' wilik ar Hamat. Re' noq ojik naq i rub'an Hada-ezer chi ruchopariik naah i ye'aab' wilik wii' i nim ha' Éufrates. <verse number="4" style="v" />Re' David xuchop taqe i jinaj miil chi kareta reh q'aq'inik, je' wo' taqe i wuq'uub' miil chi soldado wilkeeb' rij kawáyu, je' wo' taqe i juninaq miil chi soldado ojik inki a'n chi kooq. Eh xutoqib'eej kooq i kawáyu, xa re' chik i kawáyu kiqerinik reh i jinaj siento chi kareta xukanaa'.</para>
  <para style="p">
    <verse number="5" style="v" />Re' taqe i aj Siria wilkeeb' Damasco xi chalik chi rutoob'jiik i Hadad-ezer kireey i aj Soba, Xa re' la', re' David xub'an keh i aj Siria xukansaj taqe i kiib' ru ka'winaq miil. <verse number="6" style="v" />Re' David xukoj taqe i ru soldado chi kicha'jaljiik i aj Siria wilkeeb' Damasco. Re' taqe i aj Siria xi kahnik chi ri'sil i rajaawriik i David, eh inkitoj chik riij i kiye'aab'. Eh xa aha' inooj i David chi q'aq'inik inye'arik q'ab' reh ruum i Dios chi rub'aan keh.</para>
  <para style="p">
    <verse number="7" style="v" />Re' David xuk'am cho Jerusaleem i kinimaq pulato ch'ihch' oro xuq'uch chaloq, re' inkiko'leej wii' kiib' i ru soldado Hadad-ezer. <verse number="8" style="v" />Eh re' taqe tinamit Tibhat, Cun, re' i xi wihik chi ri'sil i rajaawriik i reey Hadad-ezer. Re' reey David ma' k'isiin taqe i q'an ch'ihch' xuk'am chaloq ar. Ruuk' taqe re' xuyejaa' i ye'aab' haa' i reey Salomón, je' wo' taqe i rooq paat, je' wo' taqe i kikamanik chupaam i rupaat i Dios.</para>
  <para style="p">
    <verse number="9" style="v" />Noq xrib'iraj rib'iral i Toi reey ar Hamat chi re' David xkuxik rub'anam reh i ru soldado i Hadad-ezer kireey i aj Soba. <verse number="10" style="v" />Re' i reey Toi xutaq'aaj i Adoram i rak'uun ruuk' i reey David reh chi xooj ruyeew rusuqkiil ruk'ux ruuk' i q'unil xuq'or reh chi ma' xta reet i xub'an. Re' Toi xutaq'aaj reje i chi rukooch i David re' ruuk' taqe i xa chib'ihjariik oro, plata, q'an ch'ihch' korjinaq wii', ruum chi xub'an keh i ru soldado i Hada-ezer, ruum re' reh k'ih pech wo' xub'an i q'aq'inik ruuk'. <verse number="11" style="v" />Re' reey David xuq'asaj chuwach i QaJaaw Dios taqe i kooch xye'arik reh ruch'ihil i plata i oro xuq'uch chaloq noq xub'an i q'aq'inik kuuk' i aj Edóm, i aj Moab, i aj Amón, i aj filisteo, i aj Amalec.</para>
  <para style="p">
    <verse number="12" style="v" />Eh je' wo' hoq i Abisai rak'uun i Sarvia xukansaj taqe i waxaqlaj miil chi aj Edóm wach k'ixkaab' i wilik wii' i aatz'aam. <verse number="13" style="v" />Eh re' reey xukoj taqe i ru soldado pan tinamit Edóm. Eh chu'nchel i aj Edom xi kahnik chi ri'sil i rajaawriik i David. Xa aha' inooj i David chi q'aq'inik inye'arik q'ab' reh ruum i Dios chi rub'an keh.</para>
  <para style="s">Re' i xi kamanik ruuk' i reey David</para>
  <para style="r">(<ref loc="2SA 8:15-18">2 Sam 8.15-18</ref>; <ref loc="2SA 20:23-26">20.23-26</ref>)</para>
  <para style="p">
    <verse number="14" style="v" />Re' David xwihik chi reyil chikinaah chu'nchel i aj Israel, eh xub'an i taaq'anik parub'ehel, parukorkiil chikinaah chu'nchel i tinamit. <verse number="15" style="v" />Re' xwihik chi k'amal kib'eeh i soldado re' i Joab rak'uun i Saravia. Re' xwihik chi raj tz'ihb' i reey, re' i Josafat rak'uun i Ahilud. <verse number="16" style="v" />Re' taqe xi wihik chi k'amal kib'eeh i aj tiij re' Sadoc, rak'uun i Ahitob, re' Ahimelec rak'uun i Abiatar, eh re' i Savsa i xwihik chi aj tz'ihb' <verse number="17" style="v" />Re' i Benaía, rak'uun i Joiada xwihik chi k'amal b'eeh chi kixilak i aj Cereteo, taqe i Peleteo. Eh re' taqe i rak'uun i David xi wihik chi nimaq wach k'amal b'eeh chi kixilak.</para>
  <chapter number="19" style="c" />
  <para style="s">Re' reey David xub'an keh i aj Siria je' wo' i aj Amón</para>
  <para style="r">(<ref loc="2SA 10:1-19">2 Sam 10.1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Koq'uun chik xkimik reje i Nahas kireey i aj Amón, eh re' chik i Hanún i rak'uun xokik chi reyil chi jilow. <verse number="2" style="v" />Re' reey David je' wili i xuq'or: Re' hin naa nuwihiik panotob'il ruuk' i Hanún je' rukab' noq xinwihik panotob'il ruuk' i Nahas, i rajaaw, inki. Je' aj re' noq xutaq'aaj taqe reje i raj taqareel i David ruuk' Hanún, re' ruye'ariik i rusuqkiil ruk'ux ruum koxkimik i rajaaw. Eh noq xi ponik i aj taqareel chupaam i kitinamiit i aj Amón. <verse number="3" style="v" />Re' taqe k'amal kib'eeh i aj Amón, je' wili i xkiq'or reh i Hanún: ¿Mi nanimaj i hat chi re' reey David xutaq'aaj chaloq taqe i aj taqareel chuye'ariik rusuqkiil ak'ux, chi ruye'ariik runimaal wach i kamnaq awajaaw? Noq inqaq'or i hoj chi xa ilool xakojol taqe rehtaal nik' wach noq wilik i qatinamiit, inki taqe.</para>
  <para style="p">
    <verse number="4" style="v" />Noq xrib'iraj i Hanún chi je' re', xuchop taqe i raj taqareel i David xutaq'aaj rujoyariik i kusinchii', eh xkiyok' panyejaal i kiso', xponik kopankaa' johtoq. Chi riij i re' xutaq'aaj taqe reje. <verse number="5" style="v" />Eh noq xunab'eej i reey David chi je' re' i xkik'ul i raj taqareel xutaq'aaj kik'ulariik, ruum ma' k'isiin ta xchalik kik'ixiik. Eh xutaq'aaj ruq'orariik keh chi kikahnoq pee Jericó korehtaal ink'ihik i kusinchii' kora'j neekisutinik cho re', inki.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' taqe i aj Amón xkireq chi riij chi xkikanaa' kiib' panixowaal ruuk' i reey David ruum aj re', re' Hanún ruch'ihil taqe aj Amón xkitaq'aaj i waqiib' siento ruuk' oxk'ahl kintaal chi plata tojb'al keh i kareta. Eh tojb'al keh i soldado wilkeeb' riij kawáyu reh chi xiooj chi q'aq'inik ruuk' i David. Re' taqe re' ar kichalik Mesopotamia, Siria, Maaca, i Soba. <verse number="7" style="v" />Ruuk' i plata re' re' xkitoj taqe i kab'laj ru ka'winaq miil chi kareta reh q'aq'inik, eh xkitoj wo' hoq i kireey i aj Maaca, je' wo' taqe i ru soldado. Re' taqe i re' xponik kiyejaa' i itz'ihy naah paat chi k'ulwaach i tinamit Medeba. Eh re' taqe i aj Amón keh xkimol cho kiib' xi elik cho pan kitinamiit xiooj chi q'aq'inik.</para>
  <para style="p">
    <verse number="8" style="v" />Eh noq xunab'eej i David chi je' re' xutaq'aaj i Joab ruch'ihil chu'nchel i ru soldado kow kiib' chi q'aq'inik. <verse number="9" style="v" />Re' taqe i ki soldado i aj Amón xooj kimol kiib' panookb'al reh i kitinamiit xkiyejaa' kiib' chi q'aq'inik. Eh re' taqe i reey kuch'ihil noq xi chalik chi q'aq'inik pan tokoom ye'aab' xkiyeew reje kiib'. <verse number="10" style="v" />Eh noq xukoj rehtaal i Joab chi naa kichaliik chuwach, eh wilik taqe q'aq'ineel naa kichaliik chi riij xusik' kiwach chi kixilak i aj Israel i soldado xti kow kiib', reh chi xutaq'aaj taqe chi q'aq'inik kuuk' i aj Siria. <verse number="11" style="v" />Eh re' Joab xikoj i ruchaaq' Abisai rub'ihnaal chi k'amal kib'eeh i kiqox i soldado reh chi xooj kik'ulb'ilej taqe i aj Amón. <verse number="12" style="v" />Je' wili xuq'or reh i ruchaaq': Wila' xtohq'ik kiq'atam nuwach i aj Siria, neetichalik chi nutoob'jiik i hat. Eh wila' xtohq'ik kiq'atam awach i aj Amón i hat, re' hin nee kinooj cha toob'jiik. <verse number="13" style="v" />Kow-oq ak'ux qachop qak'ux chi ko'ljiik i qatinamiit Israel, re' wo' i rutinamiit i QaJaaw Dios. Eh nee ta naq i rub'an chee QaJaaw Dios aha' wilik i ruk'ul chuwach i reh, inki.</para>
  <para style="p">
    <verse number="14" style="v" />Je' re' noq re' Joab xooj reje chuwach chi kik'ulb'ejiik i ki soldado i aj Siria, xa re' la' re' keh xkimol chi elik chuwach. <verse number="15" style="v" />Eh noq xkilow i ki soldado i aj Amón chi xkimol chi elik i ki soldado i aj Siria chuwach i Joab xkimol wo' chi elik i keh chuwach i Abisai, xooj kikeb'aa' kiib' pan kitinamiit. Eh re' Joab xsutinik wo' chik cho Jerusaleem.</para>
  <para style="p">
    <verse number="16" style="v" />Eh noq xkilow i ru soldado i aj Siria chi xb'aan keh ruum i ki soldado i aj Israel xkitaq'aaj ruk'amariik i aj Siria wilkeeb' chi juntar nim ha' Éufrates. Eh re' i Sofac k'amal kib'eeh i ki soldado, eh re' wo' hoq i Hada-ezer i k'amal kib'eeh. <verse number="17" style="v" />Noq xrib'iraj rib'iral i reey David chi je' re' xumol kiwach chu'nchel i ki soldado i aj Israel xiooj xi q'ahxik reje chi juntar i nim ha' Jordán xkiyejaa' kiib' chi q'aq'inik. Re' David xuq'or keh chi xiooj chi kik'ulb'ejiik taqe i ki soldado i aj Siria. <verse number="18" style="v" />Eh re' i ki soldado i aj Siria xkimol chi elik chikiwach i ki soldado i aj Israel. Eh re' David xkikansaj i ka'winaq miil chi soldado re' ruuk' taqe i xa chi kooq kiooj, eh xkikansaj wo' wuquub' miil i wilkeeb' pan kareta. Eh xkikansaj wo' i Sofac re' k'amal kib'eeh i ki soldado i aj Siria. <verse number="19" style="v" />Eh noq xkilow taqe i reey i k'ahchi' naq kitowiik reh i Hadad-ezer chi xb'aan keh ruum i ki soldado i aj Israel, xkik'am kiib' panotob'il kuuk' i ki soldado i aj Israel. Eh kiyeew kiib' chi ri'sil i rajaawriik i reey David. Re' i ki soldado i aj Siria ma' xkaaj ta chik kitob'eem i aj Amón.</para>
  <chapter number="20" style="c" />
  <para style="s">Re' i reey David xuchop naah i tinamit Rabá</para>
  <para style="r">(<ref loc="2SA 12:26-31">2 Sam 12.26-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Chupaam i haab' jinaj chik paruq'ijil i siq'jil noq kiooj i reey chi q'aq'inik, re' Joab i xuk'am taqe reje i ru soldado chi q'aq'inik, eh xusach wach i kitinamiit i aj Amón. Eh xooj kikotej riij i tinamit Rabá, eh xusach kiwach. Xa re' la' re' reey David xkahnik Jerusaleem. <verse number="2" style="v" />Eh noq re' David xponik Rabá xkiq'uch reh i ru corona i kireey i aj Rabá, wach naah chik i David xkikoj. Re' corona re' re' oro wilik wo' hoq i holohaq ab'aj chuwach ixib' aroba naa rahliil. Re' David ma' k'isiin taqe i xa chib'ih jariik k'ih taq tz'aaq xresaj chaloq chupaam tinamit re' re'. <verse number="3" style="v" />Re' David xresaj taqe chaloq chu'nchel i tinamit koxikahnik ar xukoj taqe chi taraj chee', chi k'otooj paam ak'al ruuk' ch'ihch', chi ch'irij sii' ruuk' ikej. Eh je' wo' re' i xub'an keh chu'nchel i aj Amón. Chi riij i re', re' David ruch'ihil chu'nchel i ru soldado xi sutinik wo' chik cho Jerusaleem.</para>
  <para style="s">Re' taqe raj q'aq'ineel i David xkikansaj i nimaq kooq winaq</para>
  <para style="r">(<ref loc="2SA 21:18-22">2 Sam 21.18-22</ref>)</para>
  <para style="p">
    <verse number="4" style="v" />Chi riij i re', re' taqe i aj Israel xiooj wo' chik chi q'aq'inik kuuk' i aj filisteo ar Gezer. Re' Sibecai aj pan tinamit Husa xukansaj i Sipai re' ruuk' i kiih taqe i nimaq winaq. <verse number="5" style="v" />Eh xiooj wo' chik chi q'aq'inik kuuk' i aj filisteo. Re' i Elhanán rak'uun i Jair xukansaj i Lahmi ruchaaq' i Goliat aj geteo, xiik' wo' naq naah nimaal rooq. Re' i ruche'el i ruq'as ju' ch'ihch' je' nimaal i ruche'el i nimlaj keem.</para>
  <para style="p">
    <verse number="6" style="v" />Eh xwihik wo' chik i jinaj i q'aq'inik ar Gat, ar xwihik jinaj winaq nim rooq waqtaq i ju'q'ab' chi ju'juntar, eh waqtaq i naah rooq chi ju'juntar kijib' ru ka'winaq chu'nchel. Eh re' reh re' ruuk' i kiih taqe i nimaq winaq. <verse number="7" style="v" />Re' winaq re' re' xub'aj taqe i aj Israel, ruum aj re' xkanteesjik ruum i Jonatán rak'uun i Simea, ruchaaq' i David. <verse number="8" style="v" />Re' taqe nimaq kooq winaq wili aj Gat taqe re' ruuk' riih rumaam i Rafa i nim rooq winaq. Re' winaq re' re' xkanteesjik ruum i David, eh ruum taqe i ru soldado.</para>
  <chapter number="21" style="c" />
  <para style="s">Re' reey David xrik'saj i ajlanik chikinaah i aj Israel</para>
  <para style="r">(<ref loc="2SA 24:1-25">2 Sam 24.1-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Re' aj yahm xraaj chi xchalik i ti' k'axik chikinaah i aj Israel, ruum aj re' xuyeew paruk'ux i reey David chi xrik'saj i ajlanik chikinaah i aj Israel. <verse number="2" style="v" />Re' David je' wili i xuq'or reh i Joab, eh keh i k'amal kib'eeh tinamit:</para>
  <para style="p">Re' taq i hat hiy taq chawik'saj i ajlanik chikinaah i aj Israel ar taq neenatoq'aa' reje Beerseba korehtaal taq ti ponik Dan. Eh nee taq ink'ulik aq'or weh, reh chi neenunab'eej jarub' chi tinamit i wilkeeb' ar, inki.</para>
  <para style="p">
    <verse number="3" style="v" />Eh re' Joab je' wili i xuq'or:</para>
  <para style="p">Re' ta naq i QaJaaw Dios neenk'ihaax b'isanik ree rutinamiit Israel jino'q chik chi je' k'ihaal i wilkeeb' yu'naak. ¿Mi ma' chi ri'sil re' i awajaawriik wilkeeb' chu'nchel i aj Israel? ¿Chib'ih reet noq q'e' suq ak'ux chi kajaljiik yu'naak? ¿Chib'ih reet noq naa taqe aye'em pamahk i aj Israel? inki.</para>
  <para style="p">
    <verse number="4" style="v" />Eh re' reey David kow xumin chupaam i Joab chi xooj rik'saj i ajlanik, xooj rub'ehuj paam i kitinamiit i ju'jun ch'uq chi aj Israel, eh xsutinik wo' chik cho Jerusaleem xk'ulik ruq'or reh i David jarub' chi kiib'. <verse number="5" style="v" />Re' qate i xponik rutz'ihb'aaj ajlaamb'al keh xi ponik jinaj miyón ruuk' jinaj siento miil chi winaq wilik kiq'aslaj ch'ihch' kuuk'. Eh chi kixilak i aj Judá xi ajaljik kijib' siento miil ruuk' lajeeb' ru kajwinaq wilik kiq'aslaj ch'ihch' kuuk'. <verse number="6" style="v" />Xa re' la' re' Joab ma' xrajlaaj ta taqe haa' i junch'uq chi riih rumaam i Leví, je' wo' taqe i riih rumaam i Rubén ruum re' Joab ma' xuk'ul ta ruk'ux i xuq'or i reey David.</para>
  <para style="p">
    <verse number="7" style="v" />Eh ma' xponik ta wo' chuwach i Dios i xub'an David ruum i re' xuyeew chee ti' k'axik chikinaah i aj Israel. <verse number="8" style="v" />Eh re' reey David xub'an rutiij je' wili i xuq'or reh i Dios:</para>
  <para style="p">Jaaw re' hin nimlaj mahk i xnub'an chawach cha kuy chasach ti weh i numahk i hin, hin awaj kamanoom. Ruum pan tehwachiil xnub'an i wili, inki.</para>
  <para style="p">
    <verse number="9" style="v" />Re' QaJaaw Dios xuq'oreej i Gad jalal ruq'oral re' inkojwik runa'ojb'al i David je' wili xuq'or reh: <verse number="10" style="v" />Hiy ruuk' i David cha q'or reh chi je' wili re' hin i nuq'or: Ixib' wach i ti' k'axik i nuyeew chuwach, eh neerub'an chi nee rusik' wach reh ixib' re' re' iraaj chi neenuyeew, tiko'q reh, inki.</para>
  <para style="p">
    <verse number="11" style="v" />Eh re' Gad xponik wo' ruq'or reh i David aha' wilik i xuq'or i Dios. <verse number="12" style="v" />Je' wili i xuq'or reh: Re' hat cha sik' wach i ti' k'axik inawaaj ¿Mi re' ixib' haab' chi wi'jaleel? oon re' chi neenkian aweh chuwach ixib' poh i ki-ixowanik awach, oon re' chi nee ruyeew chee kaq yab'ilaal chuwach ixib' q'iij. Re' noq re' i ruánjel i QaJaaw naa rukansam chu'nchel i tinamit chupaam i ye'aab' Israel. Chaq'or weh aha' wilik inawaaj reh chi nee nuq'or i hin reh i Dios xtaaq'anik cho weh, inki i Gad.</para>
  <para style="p">
    <verse number="13" style="v" />Eh re' David je' wili i xuq'or:</para>
  <para style="p">Re' hin q'e' ti' nuk'ux i rub'an i ti' k'axik wilkiin wii'. Ma' xta reet chi re' i QaJaaw Dios neemb'anik ti' k'axik weh ruum re' reh q'e' nim i ruk'axb'al chuwach chi re' i ki-ixowanik nuwach nee kib'anik ti' k'axik weh, inki.</para>
  <para style="p">
    <verse number="14" style="v" />Je' aj re' noq re' i QaJaaw Dios xutaq'aaj chaloq i kaq yab'ilaal chikinaah i aj Israel, eh xikimik i lajeeb' ru kajwinaq miil. <verse number="15" style="v" />Eh re' QaJaaw Dios xutaq'aaj wo' chaloq jinaj i ruánjel chi rusachariik wach i Jerusaleem. Noq k'ahchi' chik rusacham wach i tinamit re' re', je' wili i xuq'or reh i ruánjel: Maa sach chik kiwach manlik ikaansanik xa a'n inki. Re' ánjel re' re' ar naq wilik i resaj wii' riij i rutrigo i Ornán aj jebuseo. <verse number="16" style="v" />Eh noq tz'ehtanik johtoq i David xrilow wach i ruánjel i QaJaaw chi pa'lik panteew panyejaal i taxaaj ruuk' i wach ak'al ruchopom i ruq'aslaj ch'ihch' resam parupaat ruq'eb'aam reje chinaah i Jerusaleem. Re' i David, ruch'ihil taqe i k'amal kib'eeh i aj Israel xkixuk'aa' kiib' korehtaal xkireq i wach ak'al ruuk' i yejal kiwach, eh kikojom chikiij i kiq'as wach so' ruum ruti'kiil kik'ux. <verse number="17" style="v" />Re' i David je' wili xuq'or reh i Dios:</para>
  <para style="p">Re' hin xin taaq'anik kajaljiik i tinamit, re' hin ximahkunik, re' hin ximb'anik i ma' holohik taj. Re' taqe atentzuun wili ma' xta kimahk. Re' hin i nupahqaaj aweh chi, chi nunaah i hin, eh chikinaah taqe i awach weh chayeew chee ti' k'axik wili maayeew chikinaah aatinamiit, inki.</para>
  <para style="p">
    <verse number="18" style="v" />Eh re' i ruánjel i QaJaaw Dios xuq'or reh i Gad chi naa ruq'orom reh i David chi naa ruyejaam jino'q i artaal loq'oomb'al ree Dios chupaam i ye'aab' i resaj wii' riij i rutrigo i Ornán i aj jebuseo. <verse number="19" style="v" />Re' David xooj wo' rub'an parub'ihnaal i QaJaaw Dios i xq'orarik reh ruum i Gad. <verse number="20" style="v" />Eh re' i Ornán k'ahchi' resam riij i rutrigo noq xrilow reje wach i ánjel, eh re' taqe i kijib' chi rak'uun xooj kikeb'aa' kiib'. <verse number="21" style="v" />Noq xrilow i Ornán chi xk'uloq i David xelik cho chupaam i ye'aab' i resaj wii' riij i rutrigo xelik cho chi k'ulariik i David xuxuk'aa' riib' chuwach korehtaal xureq wach ak'al ruuk' i yejal wach. <verse number="22" style="v" />Re' David je' wili i xuq'or reh i Ornán:</para>
  <para style="p">Re' hin inwaaj chi neenak'ayej weh aaye'aab', nee wo' nutoj tz'aaq aweh chi korik reh chi neenuyejaa' jino'q i artaal ar loq'oomb'al reh i QaJaaw Dios. Reh chi nee nelik i ti' k'axik, reh chi nee nelik i runimaal yab'ilaal chinaah i tinamit, inki.</para>
  <para style="p">
    <verse number="23" style="v" />Re' Ornán je' wili xuq'or reh i David:</para>
  <para style="p">Ma' xta reet qajaaw reey chak'am taqe imponik chawach, wili taqe i kiib' chi b'ooyax neerub'an chi nee taqe nak'at chi amayiij re' taqe i chee' inkamanik chi ehteesb'al riij i trigo neenkamanik aweh chi sii'. Eh nee wo' nuyeew i trigo nee nayeew chi mayiij, inki.</para>
  <para style="p">
    <verse number="24" style="v" />Eh re' reey David je' wili xuq'or reh i Ornán:</para>
  <para style="p">Rint'ioos aweh, xa re' la' re' hin naa nutojom aweh i tz'aaq chi manlik i nupahqaaj aweh. Re' hin ma' ruk'ul taj chi nee nuq'uch i chib'ih aweh, eh chi nee nuk'at chi numayiij chuwach i Dios i xa chi siih neenye'arik weh, inki.</para>
  <para style="p">
    <verse number="25" style="v" />Je' re' noq re' David xuloq' wo' reh i Ornán i ye'aab' i resaj wii' riij i rutrigo, eh waqiib' siento chi tumiin re' ruuk' i oro xutoj reh. <verse number="26" style="v" />Eh re' David ar xuyejaa' jinaj i artaal tusuj ab'aj loq'oomb'al ree QaJaaw, chinaah i re' xuk'at i mayiij xuq'asaj wo' hoq i mayiij k'amb'al iib' panotob'il ruuk' i Dios.</para>
  <para style="p">Eh re' i QaJaaw Dios xrib'iraj wo' hoq i xupahqaaj, eh xuqasaj chee q'aaq' pan taxaaj chinaah i artaal. <verse number="27" style="v" />Eh re' i QaJaaw Dios xuq'or reh i ánjel chi chumol parupaat i ruq'aslaj ch'ihch'.</para>
  <para style="p">
    <verse number="28" style="v" />Re' David noq xrilow chi x-ib'irjik chee rutiij xub'an chupaam i ye'aab' i resaj wii' riij i rutrigo i Ornán aj jebuseo xuq'asaj i rumayiij ar. <verse number="29" style="v" />Ruum re' itz'ihy naah paat ruyejaam chee Moisés chupaam i ye'aab' chiq yuuq ruch'ihil i artaal ink'atarik wii' i mayiij ko ar naq wilik chaloq chinaah i yuuq wilik Gabaón. <verse number="30" style="v" />Re' David ma' xooj ta ko ar chub'aan i rutiij chuwach i QaJaaw Dios ruum xyo'jik ruum i ruq'aslaj ch'ihch' i ruánjel i QaJaaw xukapaaj chi naa chik rokiik chi kansanik.</para>
  <chapter number="22" style="c" />
  <para style="s">Re' reey David xumol wach i naa rukamaniik chi korb'eesb'al reh i rupaat i Dios</para>
  <para style="p">
    <verse number="1" style="v" />Re' David je' wili xuq'or: Ayu' naa rukorjiik i rupaat i QaJaaw Dios, eh ayu' wo' naa rukorjiik i artaal naa kik'atam wii' i kimayiij i quch aj Israel, inki.</para>
  <para style="p">
    <verse number="2" style="v" />Chi riij i re', re' David xutaq'aaj rumolariik kiwach taqe i tokoom tinamit patim Israel. Wilik taqe i xupab'aa' chi sehkanik wach ab'aj xkamanik chi yejemb'al reh i rupaat i QaJaaw Dios. <verse number="3" style="v" />Eh xutaq'aaj wo' ruyejeb'jiik i ma' k'isa kalawux, je' wo' taqe ch'ihch' xkamanik chi chopb'al riib' i puerta reh i ookb'al. Eh ma' k'isiin wo' hoq i q'an ch'ihch' xkiyejaa' ma' pajooj ta rahliil. <verse number="4" style="v" />Eh re' taqe i aj Sidón, i aj Tiro ma' k'isiin i holohaq chee chakaltee' xkik'am cho reh i David.</para>
  <para style="p">
    <verse number="5" style="v" />Re' David je' wili xuq'or: Re' rupaat i Dios naa rukorjiik chi nim chi q'e' holohik, eh chi naa kiye'em ruloq'il chu'nchel i tinamit wach ak'al. Re' wak'uun Salomón ko k'isa k'un majaa' ta chih ruhab'ul, re' hin naa numolwiik kahnoq wach chib'ih i naa rukamaniik, inki. Je' aj re' noq re' David xuyejaa' kahnoq wach chu'nchel noq komajaa' inkimik.</para>
  <para style="p">
    <verse number="6" style="v" />Chi riij i re' xutaq'aaj ruk'amariik i Salomón i rak'uun xuq'or reh chi re' reh naa ruyej-aniik reh i rupaat i QaJaaw i ki Dios i ruch aj Israel. <verse number="7" style="v" />Eh je' wili xuq'or reh i rak'uun: Wak'uun, re' hin xnukapaaj naq chi re' hin naa nuyej-aniik reh i rupaat i QaJaaw i qaDios. <verse number="8" style="v" />Xa re' la', re' QaJaaw Dios je' wili i ruq'orom weh: Re' hat ma' k'isiin ikaansanik a'nam, eh ma' k'isiin i q'aq'inik a'nam, ruum aj re' ma' naa ta nuye'em q'ab' aweh chi re' hat naa ayej-aniik reh i nupaat. <verse number="9" style="v" />Xa re' la' jinaj awak'uun naa ruwihiik q'unil ruuk. Eh re' hin naa nuye'em q'ab' chi re' taqe i nixowanik wach chinaah i wach ak'al naakik'amaam chi k'acharik pansuqkiil. Ruum aj re' Salomón<note caller="+" style="f"><char style="fr" closed="false">22.9 </char><char style="ft" closed="false">Re' b'ihnaal Salomón pan Hebreo i raaj ruq'orom wihik pansuqkiil k'uxliis</char></note> i naa rubíhnaam, naa ruwihiik chi reyil i reh ma' naa ta chik ruwihiik q'aq'inik Israel. <verse number="10" style="v" />Re' awak'uun re' re' naa ruyej-aniik reh i nupaat, re' reh naa rukahniik chi wak'uun, eh re' hin naa nukahniik chi raJaaw. Eh re' hin naa nuye'em rajaawriik chi naa rukahniik chi reyil chi juneliik chikinaah i aj Israel, inki weh i Dios. <verse number="11" style="v" />Eh re' hat wak'uun re' ta naq i QaJaaw Dios neen wihik awuuk', nee ta naq ti elik korik ruuk' chib'ih i neena a'n. Eh nee ta wo' naq inayejaa' i rupaat i QaJaaw Dios je' rukab' i ruq'orom chaloq chi naa a'nam. <verse number="12" style="v" />Re' ta naq i QaJaaw Dios neen ye'wik ana'ojb'al, neenk'uhtanik aweh chi nee na a'n aha' wilik taqe i ruq'or i ruk'uhb'aal, noq nee tirukoj chi reyil chikinaah i aj Israel. <verse number="13" style="v" />Chu'nchel i neena a'n nee nelik korik chawach wila' xa a'n taqe i ruq'or i k'uhb'aal ye'ooj reh i Moisés xq'orarik keh i aj Israel wila' xa a'n i ruq'or aweh i QaJaaw Dios. Chachop ak'ux chub'aan mat yo'jik maa rub'an kiib' ak'ux. <verse number="14" style="v" />Re' hin xnuchop nuk'ux chi rumolariik wach taqe i naa rukamaniik chi yejemb'al reh i rupaat i Dios. Xnumol wach i waqiib' ru kajwinaq miil kintaal i oro, eh waqiib' siento ruuk' oxk'ahl miil i kintaal i plata. Eh xnumol wach i ruk'ihaal i q'an ch'ihch' je' wo' hoq i xach'ihch' ma' pajooj ta rahliil, eh xnumol wo' wach taqe chee', taqe ab'aj, eh re' hat naa atiqim naah. <verse number="15" style="v" />Eh re' hat ma' k'isiin taqe i awaj kamanoom, wilik taqe i sehkan wach ab'aj, wilik taqe i aj tz'aqool, wilik taqe i aj sehk. Eh xiik' naah kik'ihaal i kichol i xa reh reh wach chi kamanik. <verse number="16" style="v" />Eh wilik chik i oro, i plata, i q'an ch'ihch', i xach'ihch', ma' pajooj ta k'ihaal, neerub'an chi nee tiokik chi kamanik. Re' ta naq i QaJaaw Dios neentoob'inik aweh chub'anariik, inki David.</para>
  <para style="p">
    <verse number="17" style="v" />Re' David xuq'or keh i k'amal kib'eeh i aj Israel chi naa kitob'eem i Salomón i rak'uun. <verse number="18" style="v" />Eh je' wili xuq'or keh: Re' taq i aaWaJaaw aaDios wilik taq awuuk', ruye'em taq aweh i rusuqkiil k'uxliis, xa aha' yuuq. Re' reh xye'wik chi ri'sil i wajaawriik chu'nchel i tinamit wilkeeb' pan qa ye'aab'. Re' qa ye'aab' chi ri'sil rajaawriik i QaJaaw Dios wilik, eh chi ri'sil taq awajaawriik i hat, hat taq rutinamiit. <verse number="19" style="v" />Yu'naak taq i hat cha chop taq ak'ux chi rusik'ariik taq aaWaJaaw aaDios. Je' re' noq cha chop taq ak'ux chi rutinamiit i rupaat i Dios reh chi neen q'ahxik cho ayu' i kaxa molik wii' i ruk'uhb'aal i QaJaaw Dios. Eh nee wo' inq'ahxik cho parupaat i Dios taqe i kulk taqe xa chib'ih jariik inkamanik ar, inki i David.</para>
  <chapter number="23" style="c" />
  <para style="s">Re' kik'ihaal i riih rumaam i Leví, re' i kikamaj xkian</para>
  <para style="p">
    <verse number="1" style="v" />Ruum chi q'e' chik rijib' i David xupab'aa' i Salomón i rak'uun chi reyil chikinaah i aj Israel chi jilow. <verse number="2" style="v" />Eh xumol kiwach chu'nchel i k'amal kib'eeh i aj Israel, je' wo' taqe i k'amal kib'eeh i aj tiij re' ruuk' taqe i aj Levíta. <verse number="3" style="v" />Eh xkajlaaj taqe i riih rumaam Leví i wilik keh i lajeeb' ru ka'winaq haab' je' wo' taqe ik'inaq lajeeb' ru ka'winaq haab'. Noq kajlaam chik taqe i re' xi ponik waxaqlaj ru ka'winaq miil chi winaq. <verse number="4" style="v" />Eh re' reey David xuq'or chi chi kixilak re' naakeliik i kijib' ru ka'winaq miil chi winaq naa kiyej-aniik reh i rupaat i QaJaaw Dios. Eh chi waqiib' miil chi winaq i naa kokiik chi k'amal kib'eeh, eh chi q'ataj q'orik. <verse number="5" style="v" />Eh xuq'or wo' chi waqiib' miil i naakikamaniik panookb'al. Eh re' chik taqe i waqiib' miil naa kokiik chulooq'jiik i QaJaaw Dios ruuk' taqe i q'ooj, rutaq'aam ruyejeb'jiik i reey David.</para>
  <para style="p">
    <verse number="6" style="v" />Re' David chi ch'uhqaal taqe xuyeew re' q'oreel nik' k'ihaal taqe i riih rumaam xwihik i Leví. Eh ixib' i rak'uun xi wihik je' wili kib'ihnaal: Gersón, Coat, Merari.</para>
  <para style="p">
    <verse number="7" style="v" />Re' taqe rak'uun i Gersón je' wili kib'ihnaal: Laadán, Simei. <verse number="8" style="v" />Re' Laadán ixib' i rak'uun xi wihik: Jehiel, i rub'ihnaal i aasb'ees, re' rukab' Zetam, re' roox Joel. <verse number="9" style="v" />Re' Simei ixib' i rak'uun xi wihik, je' wili kib'ihnaal: Selomit, Haziel, Harán. Re' taqe re' i k'amal kib'eeh taqe i riih rumaam Laadán. <verse number="10" style="v" />Eh re' Simei kijib' i rak'uun xi wihik je' wili kib'ihnaal: Jahat, Zina, Jeús, Bería. <verse number="11" style="v" />Re' Jahat re' aasb'ees, re' rukab' re' i Zina. Re' Jeús ruch'ihil i Bería xama' k'ih taj i kiha'lak'uun xwihik xi ajaljik chi xa jinaj taqe chi patineel.</para>
  <para style="p">
    <verse number="12" style="v" />Re' Coat kijib' i rak'uun xi wihik je' wili kib'ihnaal: Amram, Izhar, Hebrón, Uziel. <verse number="13" style="v" />Re' Amram je' wili kib'ihnaal i rak'uun: Aarón, Moisés. Re' Aarón, taqe i riih rumaam sik'arik kiwach ruum i Dios chi k'amal kib'eeh i aj tiij chi re' keh xib'anik reh i santo laj kamanik. Eh chuk'atariik i insensia je' wo' hoq i mayiij, eh chi kamanik chuwach i QaJaaw Dios, chupahqaljiik reh i QaJaaw Dios chi xukuxisaj chee tinamit. <verse number="14" style="v" />Re' taqe i rak'uun i Moisés i raj kamanoom i Dios xi ajaljik haa' chi kixilak i riih rumaam i Leví. <verse number="15" style="v" />Re' i Moisés je' wili kib'ihnaal i rak'uun: Gersón, Eliezer. <verse number="16" style="v" />Eh re' Gersón Sebuel i rub'ihnaal i peet rak'uun, re' xwihik chi k'amal b'eeh. <verse number="17" style="v" />Eh re' i Eliezer Rehabías rub'ihnaal i rak'uun, eh re' xwihik chi k'amal b'eeh. Re' Eliezer ma' xwihik ta chik rak'uun rixq'uun. Re' Rehabias reh k'ih taqe i rak'uun rixq'uun xi wihik. <verse number="18" style="v" />Re' Izhar Selomit rub'ihnaal i peet rak'uun, re' xi wihik chi k'amal b'eeh. <verse number="19" style="v" />Eh re' Hebrón je' wili kib'ihnaal i rak'uun. Re' peet, Jerías, re' rukab', Amarías, re' roox Jahaziel, re' rukaaj Jecamán. <verse number="20" style="v" />Re' Uziel kiib' taqe i rak'uun je' wili kib'ihnaal, re' peet Macaía, re' rukab' Isías.</para>
  <para style="p">
    <verse number="21" style="v" />Re' Merari je' wili kib'ihnaal i rak'uun, Mahli, Musi. Eh re' Mahli je' wili kib'ihnaal i rak'uun: Eleazar, Cis. <verse number="22" style="v" />Re' Eleazar xkimik reje chi ma' xwihik ta jino'q rak'uun, xarixq'uun taqe i xi wihik, re' xkian kaxáro kuuk' taqe i rak'uun i Cis ma' tokoom ta kuuk'. <verse number="23" style="v" />Eh re' Musi ixib' i rak'uun xwihik je' wili kib'ihnaal: Mahli, Edar, Jeremot.</para>
  <para style="p">
    <verse number="24" style="v" />Re' taqe i rak'uun i riih rumaam Leví, nik' k'ihaal i kak'uun pankipaat i xiajlajiik. Re' taqe re' i k'amal b'eeh chi kixilak. Re' taqe re' i wilik keh i juninaq haab', eh ik'inaq taqe juninaq haab'. Chu'nchel i re' xi kamanik chupaam i rupaat i Dios.</para>
  <para style="p">
    <verse number="25" style="v" />Re' reey David je' wo' wili i ruq'orom: Re' qaDios i hoj, hoj aj Israel xoj ruyeew chi wihik pansuqkiil k'uxliis. Eh ayu' wo' Jerusaleem naa ruwihiik ruye'aab' chi juneliik. <verse number="26" style="v" />Chi je' re', re' taqe i aj Levíta, ma' ruman ta chik chi k'ul naa kojiik kuum itz'ihy naah paat inlooq'jik wii' i QaJaaw Dios, je' wo' taqe i xa chib'ih jariik inkamanik chupaam i rulooq'jiik i Dios.</para>
  <para style="p">
    <verse number="27" style="v" />Eh re' xuq'or i David noq xukohlaaj i rukamaj xb'aan wo' hoq, xi ajaljik wo' taqe chu'nchel i riih rumaam Leví wilik keh i juninaq haab', je' wo' taqe ik'inaq juninaq haab'. <verse number="28" style="v" />Re' taqe re' xi kahnik chi' ri'sil i kajaawriik i riih rumaam Aarón chi kito'arik chub'anariik i kamanik chupaam i rupaat i Dios. Eh i wilik i xi kamanik chi muuj i rupaat i Dios, wilik i xi kamanik chi rusaqb'eesjiik kiwach i xa chi b'ihjarik wilik kisantohiil. Eh xkian chu'nchel i kamanik chupaam i rupaat i Dios. <verse number="29" style="v" />Re' wo' keh i xi ilwik reh i kaxlanwi'k inye'arik nah mexa, inye'arik chi mayiij, je' wo' hoq i kaxlanwi'k ma' inkojarik ta ch'amb'eesb'al reh, je' wo' hoq i suq laj kaxlanwi'k. Re' wo' keh xi ilwik reh i mayiij ink'iljik wach pan xartiin, je' wo' hoq i pajb'al reh i mayiij xye'arik parupaat i Dios. <verse number="30" style="v" />Eh rajlaal wahq'eq, rajlaal xq'eq kiwihik chupaam i rupaat i Dios chi loq'inik, chi t'iosinik chuwach i Dios. <verse number="31" style="v" />Re' wo' keh kik'atwik chikop chuwach i QaJaaw Dios pantaq hi'limb'al q'iij, inye'arik noq i ninq'ijik i ak' poh, je' wo' hoq inye'arik chupaam taqe i nimaq wach ninq'iij tokoom chik. Re' q'oreel jarub' chi kiib', eh chib'ih i kamanik xkian rajlaal i q'iij chuwach i QaJaaw Dios, inki. <verse number="32" style="v" />Re' taqe riih rumaam Leví re' re', re' wo' keh xi-ilwik reh i santo laj itz'ihy naah paat molb'al iib', je' wo' hoq i santo laj itz'ihy naah paat i Dios. Eh noq xkian i kamanik chupaam i rupaat i Dios chi ri'sil i kajaawriik taqe i riih rumaam Aarón.</para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Re' taqe i riih rumaam Aarón xiye'arik ch'uhqaal reh i kamanik. Eh re' i Aarón kijib' i rak'uun xwihik, je' wili kib'ihnaal: Nadab, Abiú, Eleazar, Itamar. <verse number="2" style="v" />Eh ruum chi re' i Nadab i Abiú, xikimik reje chi peet chuwach i kajaaw chi ma' xwihik ta kak'uun. Eh re' Eleazar i Itamar xi okik chi kamanik chi k'amal kib'eeh aj tiij.</para>
  <para style="p">
    <verse number="3" style="v" />Re' David xto'arik ruum i Sadoc re' taqe i riih rumaam Eleazar xto'arik wo' ruum i Ahimelec re' i riih rumaam Itamar, chi kiye'ariik chi ch'uhqaal taqe i riih rumaam Leví, reh chi xkian i rukamaj i Dios. <verse number="4" style="v" />Ruum chi k'ih taqe i winaq wilik kajaawriik chi kixilak i riih rumaam Eleazar chuwach i riih rumaam Itamar, waqlaj ch'uq xi elik. Eh ju'jun k'amal kib'eeh xkojarik i riih rumaam i Eleazar. Eh waxiqiib' ch'uq xi elik i riih rumaam Itamar. Eh ju'jun k'amal kib'eeh xkojarik. <verse number="5" style="v" />Eh koxkisik' chi riij i kamanik i lb'al reh nik' naa kokiik chi kamanik i ju'jun. Ruum chi kixilak taqe i riih rumaam Eleazar, je' wo' chi kixilak taqe i riih rumaam Itamar wilik i xi okik chi kamanik parupaat i Dios, eh wilik taqe i xi okik chi aj tiij. <verse number="6" style="v" />Re' Semaías rak'uun i Natanael re' ruuk' taqe i aj Levíta re' intz'ihb'anik i kib'ihnaal chuwach i reey, je' wo' chikiwach i kitowik reh, je' wili kib'ihnaal: Sadoc re' i k'amal kib'eeh aj tiij, re' Ahimelec rak'uun i Abiatar. Eh re' taqe i kajaaw i k'amal kib'eeh aj tiij, re' taqe i aj Levíta. Eh peet xsik'arik chi riij nik' naa kokiik chi kamanik i riih rumaam Eleazar rukab' xsik'arik chi riij nik' naa kokiik chi kamanik i riih rumaam Itamar.</para>
  <para style="p">
    <verse number="7" style="v" />Eh noq kisik'im chik chi riij, re' i peet i kahnik chinaah chi xokik chi kamanik re' i Joiarib, re' rukab' re' i Jedaías. <verse number="8" style="v" />Re' roox, re' i Harim, re' rukaaj re' i Seorim. <verse number="9" style="v" />Re' roo' re' i Malquías, re' ruwaaq, re' i Mijamín. <verse number="10" style="v" />Re' ruwuuq re' i Cos, re' ruwaxaaq, re' i Abías. <verse number="11" style="v" />Re' rub'elejeeb' re' i Jesúa, re' ru lajeeb' re' i Sacanías. <verse number="12" style="v" />Re' rujunlaaj re' i Eliasib, re' rukab'laaj re' i Jaquim. <verse number="13" style="v" />Re' i roxlaj re' i Hupa, re' rukajlaal re' i Jesebeab. <verse number="14" style="v" />Re' i ruho'lajuuj re' i Bilga, re' ruwaqlaaj re' i Imer. <verse number="15" style="v" />Re' i ruwuqlaaj re' i Hezir, re' ruwaqlaaj re' i Afses. <verse number="16" style="v" />Re' i rub'elejlaj re' i Petaías, re' i rujuninaq re' i Hezequiel. <verse number="17" style="v" />Re' i rujinaj ru ka'winaq re' i Jaquín, re' rukab' ru ka'winaq re' i Gamul. <verse number="18" style="v" />Re' i roox ru ka'winaq re' i Delaía, re' i rukaaj ru ka'winaq re' i Maazías.</para>
  <para style="p">
    <verse number="19" style="v" />Je' re' noq xi kahnik pankikamaj i ju'jun reh chi xi okik chi kamanik parupaat i Dios. Je' rukab' i ruq'orom chee Aarón i xikin cho kimaam, re' i xq'orarik cho reh ruum i QaJaaw i qaDios i hoj, i hoj aj Israel.</para>
  <para style="p">
    <verse number="20" style="v" />Re' taqe i wili junch'uq chik chi riih rumaam Leví: Re' i Sabael re' ruuk' taqe i riih rumaam Amram, re' i Jehedías, re' ruuk' taqe riih rumaam i Subael. <verse number="21" style="v" />Re' taqe i juntz'uhb' chi ruch'ihil i Rehabías re' k'amal kib'eeh re' i Isías, i peet rak'uun. <verse number="22" style="v" />Re' juntzuhb', chi ruch'ihil i Izharitas, re' i haa' Selomot, re' haa' Jahat i rak'uun. <verse number="23" style="v" />Re' taqe i riih rumaam chee Hebrón, je' wili i kib'ihnaal: Re' peet, re' Jerías, re' rukab' re' Amarías, re' roox re' i Jahaziel, re' rukaaj re' Jecamán. <verse number="24" style="v" />Haa' wo' hoq i Micaía rak'uun i Uziel, je' wo' hoq i Samir rak'uun i Micaía. <verse number="25" style="v" />Eh re' i rak'uun i Isías, i ruchaaq' i Micaía, re' i Zacarías. <verse number="26" style="v" />Re' taqe i rak'uun i Merari, re' i Mahli, re' i Musi, re' taqe i rak'uun i Jaazías, re' i Beno. <verse number="27" style="v" />Eh re' taqe i riih rumaam i Merari ruuk' i Jaazías je' wili i kib'ihnaal Beno, Soham, Zacuur, Ibri. <verse number="28" style="v" />Eh re' riih rumaam ruuk' i Mahli re' Eleazar, re' reh ma' xwihik ta rak'uun. <verse number="29" style="v" />Re' taqe i riih rumaam ruuk' i Cis, eh chi kixilak i re' wilik i rak'uun Jerameel. <verse number="30" style="v" />Re' Musi je' wili kib'ihnaal: Mahli, Edar, re' Jerimot.</para>
  <para style="p">Re' taqe re' i riih rumaam Leví, re' q'oreel nik' kik'ihaal i kak'uun i kiih kimaam i ju'jun ch'uq chi ajaab'ees. <verse number="31" style="v" />Eh re' chib'ih i naa kianam xkisik' wo' chi riij chuwach i reey David chuwach i Sadoc, i Ahimelec, chuwach i kajaaw taqe i k'amal kib'eeh aj tiij, eh re' taqe i aj Levíta. Nik' wach i xkian kuuk' taqe i aasb'ees ak'un, je' wo' re' i xkian kuuk' taqe i chaq'b'ees ak'un xkian wo' kuuk', je' rukab' i xkian kuuk' taqe i riih rumaam Aarón.</para>
  <chapter number="25" style="c" />
  <para style="s">Re' taqe i aj q'ojineel, i aj tz'uyineel xsik'arik kiwach</para>
  <para style="p">
    <verse number="1" style="v" />Re' reey David, re' taqe i k'amal kib'eeh i aj Israel, xkisik' wach taqe i rak'uun i Asaf, taqe i rak'uun i Hemán, taqe rak'uun i Jehutun, taqe i kiq'orik rib'iral chib'ih ink'uhtjik cho chikiwach ruum i Dios. Eh noq xkiq'or rib'iral k'ahchi' kiq'ojem i kiarpa, i kikok' k'ahaam wach q'ooj, eh kipulato q'ooj.</para>
  <para style="p">
    <verse number="2" style="v" />Eh re' Asaf, je' wili kib'ihnaal i rak'uun: Zacuur, José, Netanías, Asarela. Re' ink'amwik kib'eeh re' Asaf, re' inq'orwik rib'iral i chib'ih ink'uhtjik chikiwach ruum i Dios, je' rukab' intaq'ab'jik wii' ruum i reey David.</para>
  <para style="p">
    <verse number="3" style="v" />Re' Jedutún, je' wili i kib'ihnaal i rak'uun: Gedalías, Zeri, Jesaías, Hasabías, Matatías, Simei, waqiib' chi kiib', re' Jedutún ink'amwik kib'eeh. Eh noq xkiq'or rib'iral ink'uhtjik chikiwach ruum i Dios i k'ahchi' kiq'ojem i kiarpa chi loq'oomb'al reh i Dios.</para>
  <para style="p">
    <verse number="4" style="v" />Re' i Hemán, je' wili i kib'ihnaal i rak'uun: Buquías, Matanías, Uziel, Sebuel, Jeremot, Hananías, Hananías, Hanani, Eliata, Gidalti, Romanti-ezer, Josbecasa, Maloti, Hotir, Mahaziot. <verse number="5" style="v" />Chu'nchel i re' rak'uun i Hemán, re' i xi kamanik chuwach i reey David chi jalal ruq'oral i Dios. Re' Hemán kajlaj i rak'uun ixib' rixq'uun xye'arik reh ruum i QaJaaw Dios ye'b'al ruloq'il. <verse number="6" style="v" />Eh chu'nchel i re', re' Asaf, re' Jedutún, re' Hemán i kajaaw xk'amwik kib'eeh chi rulooq'jiik i QaJaaw Dios parupaat, ruuk' pulato q'ooj, ruuk' i kok' arpa, ruuk' i kok' k'ahaam wach q'ooj, xkian wo' hoq i xq'orarik keh ruum i reey David. <verse number="7" style="v" />Eh kiib' siento ruuk' waxiqiib' ro'k'ahl chi kiib' chu'nchel i xi okik haa' chi tz'uuy, eh chi q'ojinik, chi loq'oomb'al reh i Dios. Tijimaj taqe chi korik, eh kik'uliil kiib'.</para>
  <para style="p">
    <verse number="8" style="v" />Eh koxkisik' chi riij i lb'al reh nik' naa kokiik chi kamanik i ju'jun chi je' taqe mama' winaq, chi je' taqe kok'ijool, chi je' taqe k'amal b'eeh chi kamanik, chi je' taqe kore' k'ahchi' kitijem kiib'.</para>
  <para style="p">
    <verse number="9" style="v" />Noq kisik' chi riij, re' peet xkahnik chinaah chi xokik chi kamanik: Re' i José, i rak'uun i Asaf, Re' rukab', re' i Gedalías ruch'ihil taqe rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk' kab'laj chi kiib'. <verse number="10" style="v" />Re' i roox, re' Zacuur, ruch'ihil taqe rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk', kab'laj chi kiib'. <verse number="11" style="v" />Re' rukaaj, re' Izri, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk', kab'laj chi kiib'. <verse number="12" style="v" />Re' roo', re' Netanías, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk', kab'laj chi kiib'. <verse number="13" style="v" />Re' ruwaaq, re' i Buquías, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk' kab'laj chi kiib'. <verse number="14" style="v" />Re' ruwuuq, re' i Jesarela, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk', kab'laj chi kiib'. <verse number="15" style="v" />Re' ruwahxaaq, re' i Jesahías, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk', kab'laj chi kiib'. <verse number="16" style="v" />Re' rub'eleej, re' i Matanías ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk', kab'laj chi kiib'. <verse number="17" style="v" />Re' rub'eleej, re' i Simei, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk', kab'laj chi kiib'. <verse number="18" style="v" />Re' rujunlaaj re' i Azareel, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk' kab'laj chi kiib'. <verse number="19" style="v" />Re' rukab'laaj re' i Hasabías, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk' kab'laj chi kiib'. <verse number="20" style="v" />Re' roxlaaj re' i Subael, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk' kab'laj chi kiib'. <verse number="21" style="v" />Re' xkajlaaj re' i Matatías, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk' kab'laj chi kiib' chu'nchel. <verse number="22" style="v" />Re' ruho'lajuuj, re' i Jeremot, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk', kab'laj chi kiib'. <verse number="23" style="v" />Re' ruwaqlaaj, re' i Hananías, ruch'ihil taqe i rak'uun, ruch'ihil taqe ma' tokoom ta ruuk' kab'laj chi kiib'. <verse number="24" style="v" />Re' ruwuqlaaj, re' i Josbecasa, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk', kab'laj chi kiib' chu'nchel. <verse number="25" style="v" />Re' ruwaxaqlaaj, re' i Hananías, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk' kab'laj chi kiib'. <verse number="26" style="v" />Re' rub'elejlaj, re' i Maloti, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk' kab'laj chi kiib'. <verse number="27" style="v" />Re' rujuninaq, re' i Eliata, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk', kab'laj chi kiib'. <verse number="28" style="v" />Re' rujinaj ru ka'winaq, re' i Hotir, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk' kab'laj chi kiib'. <verse number="29" style="v" />Re' i rukab' ru ka'winaq, re' i Gidalti, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk' kab'laj chi kiib'. <verse number="30" style="v" />Re' roox ru ka'winaq, re' i Mahaziot, ruch'ihil taqe i rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk', kab'laj chi kiib'. <verse number="31" style="v" />Re' i rukaj ru ka'winaq, re' i Romanti-ezer, ruch'ihil taqe rak'uun, ruch'ihil taqe i ma' tokoom ta ruuk', kab'laj chi kiib'.</para>
  <chapter number="26" style="c" />
  <para style="s">Re' noq xiye'arik pankikamaj i xi kamanik panookb'al reh i rupaat i Dios</para>
  <para style="p">
    <verse number="1" style="v" />Xich'aqarik wo' taqe i xi okik chi kamanik panookb'al reh i rupaat i Dios.</para>
  <para style="p">Re' Meselamías rak'uun i Coré, eh re' Coré rak'uun i Asaf. <verse number="2" style="v" />Eh re' i Meselamías je' wili kib'ihnaal i rak'uun: Re' peet rak'uun, re' i Zacarías, re' rukab', re' i Jediael, re' i roox re' i Zebadías, re' rukaaj re' i Jatniel. <verse number="3" style="v" />Re' i roo', re' i Elam, re' i ruwaaq re' i Johanán, re' ruwuuq, re' i Elioenai.</para>
  <para style="p">
    <verse number="4" style="v" />Re' i Obed-edom, je' wili kib'ihnaal i rak'uun. Re' peet rak'uun re' i Semaías, re' rukab' re' i Jozabad, re' i roox re' i Joa, re' i rukaaj re' Sakar, re' i roo' re' i Natanael. <verse number="5" style="v" />Re' ruwaaq, re' i Amiel, re' i ruwuuq, re' i Isacar, re' ruwahxaaq, re' i Peultai. Re' Obed-edom kuxesjik cho ruum i Dios ruum aj re' k'ih i rak'uun xwihik. <verse number="6" style="v" />Eh re' i Semaías rak'uun wo' i Obed-edom xi wihik wo' taqe rak'uun, re' chik i keh xi k'amwik kib'eeh i awach keh ruum kow kik'ux, eh kow kiib'. <verse number="7" style="v" />Eh re' i Semaías je' wili kib'ihnaal i rak'uun: Otni, Rafael, Obed, Elzabad, Eliú, Samaquías, eh q'e' kow kik'ux. <verse number="8" style="v" />Chu'nchel i re' riih rumaam taqe i Obed-edom. Eh kiib' ru kajwinaq chi kiib' taqe rak'uun ruch'ihil taqe i ma' tokoom ta ruuk', kow kik'ux chub'aan i kikamaj. <verse number="9" style="v" />Eh re' i Meselemías, ruuk' taqe i rak'uun ruch'ihil taqe i ma' tokoom ta ruuk' waxaqlaj chi kiib' chu'nchel kow kiib'.</para>
  <para style="p">
    <verse number="10" style="v" />Eh re' i Hosa, riih rumaam Merari xwihik taqe rak'uun jinaj i rak'uun Simri rub'ihnaal. Re' reh xkahnik chi k'amal kib'eeh i ma' tokoom ta ruuk' i rajaaw, re' reh xkanab'jik chi k'amal b'eeh ruum i rajaaw atoob' ta ma' re' reh i peet ak'un. <verse number="11" style="v" />Re' rukab' rak'uun i Hosa re' i Hilcías, re' roox re' i Tebalías, re' rukaaj, re' i Zacarías, ruch'ihil taqe i ma' tokoom ta ruuk' i Hosa oxlaj chi kiib' chu'nchel.</para>
  <para style="p">
    <verse number="12" style="v" />Je' wili kiye'ariik pankamanik xib'aan taqe i xi kamanik chupaam i ookb'al reh i rupaat i Dios. Re' i keh je' wo' taqe i k'amal kib'eeh, je' wo' taqe i xa kamanoom, je' wo' i kuch'ihil re' taqe i xi kamanik chupaam i rupaat i QaJaaw Dios. <verse number="13" style="v" />Eh xkisik' chi riij awach i naa kikahniik chi kamanik chupaam i ju'jun chi ookb'al. Je' re' xkian kuuk' i wilik chik kihab'ul chi korik, je' wo' re' i xkian kuuk' i ko k'ijool, re' q'oreel nik' kik'ihaal pankipaat.</para>
  <para style="p">
    <verse number="14" style="v" />Eh chinaah i Selemías xkahnik chi re' reh naa ru cha'jinik reh, i chii' i ookb'al wilik reje parelb'aal q'iij. Eh re' i Zacarías i rak'uun wilik runa'ojb'al, inkojwik na'ojb'al, chinaah i reh i xkahnik chi re' reh naa rucha'jiniik i chii' i ookb'al wilik reje pantz'eet reh i rookb'aal q'iij. <verse number="15" style="v" />Re' Obed-edom xkahnik chi cha'jinik chi chii' i ookb'al wilik reje pansak'aaj reh i rokb'aal i q'iij. Eh re' taqe i rak'uun xi kahnik, chi rucha'jaljiik i molarik wii' i xa chib'ih jariik inkamanik parupaat i Dios. <verse number="16" style="v" />Eh re' Supim ruch'ihil i Hosa xi kahnik chi cha'jinik chi chii' i ookb'al wach johtik Salequet wilik reje parookb'aal q'iij. Eh eht'alimaj nik' naakokiik chi kamanik i ju'jun. <verse number="17" style="v" />Eh waq taq chi aj Levíta i kiokik chi cha'jinik chi chii' i ookb'al wilik reje parelb'aal q'iij. Eh kajkaj i chi chii' i ookb'al wilik reje pansak'aaj reh i rookb'aal q'iij, eh kajkaj chi chii' i ookb'al wilik pantz'eet reh i rookb'aal q'iij. Eh ka'kab' i aj cha'joom inokik reh i ju'jun i molarik wii' taqe i xa chib'ih jariik. <verse number="18" style="v" />Eh chupaam i ye'aab' i molarik wii' taqe i xa chib'ih jariik inkamanik parupaat i Dios kijib' i aj cha'joom inokik ar, eh pamb'eeh, chupaam i koq i ye'aab' ki'ib' i aj cha'joom inokik. <verse number="19" style="v" />Je' aj re' noq xich'aqarik chi kamanik taqe i aj cha'jen taqe reh i ookb'al, re' taqe i riih rumaam Coré, i Merari.</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' i Ahías re' ruuk' taqe riih rumaam Leví incha'jinik reh i molarik wii' taqe k'ih taq tz'aaq xa chib'ih jariik inkamanik chupaam i rupaat i Dios, je' wo' hoq i xa chib'ih jariik. <verse number="21" style="v" />Re' taqe i rak'uun i Laadán re' keh k'amal kib'eeh i ju'junch'uq chi patineel. Eh Laadán rak'uun i Gersón. Eh re' Gersón rumaam rati't chaloq taqe i rak'uun Jehieli. <verse number="22" style="v" />Eh re' Jehieli, Zetam b'ih i rak'uun, eh Joel i b'ih i jinaj. Re' keh xicha'jinik reh xa chib'ih jariik wilkeeb' parupaat i Dios.</para>
  <para style="p">
    <verse number="23" style="v" />Eh xkiyeew wo' rukamaj taqe i riih rumaam i Amram, je' wo' taqe i riih rumaam i Izhar, je' wo' taqe i riih rumaam i Hebrón, je' wo' taqe i riih rumaam i Uziel. <verse number="24" style="v" />Re' Sebuel rak'uun i Gersón, eh riih i Moisés ink'amwik b'eeh chi rucha'jaljiik taqe xa chib'ih jariik i k'ih taq tz'aaq. <verse number="25" style="v" />Re' Eliezer ruchaaq' i Gersón je' wili kib'ihnaal i ma' tokoom ta ruuk'. Re' rak'uun i Eliezer, re' i Jesaías, re' rak'uun i Jesaías re' i Joram, re' rak'uun i Joram, re' i Zicri, re' rak'uun i Zicri, re' i Selomit. <verse number="26" style="v" />Eh re' Selomit ruch'ihil taqe i ruchaaq' xicha'jinik reh taqe i ye'aab' reh i xa chib'ih jariik q'e' looq'. Re' taqe i kiq'asam reh i QaJaaw Dios i reey David, taqe i k'amal kib'eeh i ju'jun chi patineel, taqe i k'amal kib'eeh i nimlaj ch'uq chi soldado, taqe i nimaq kiwach rajaaw soldado. <verse number="27" style="v" />Re' taqe i xkiq'asaj re' re' panq'aq'inik xkiq'uch chaloq. Xkiq'asaj reh chi xkamanik chi yejemb'al reh i rupaat i Dios. <verse number="28" style="v" />Eh wilik wo' ar i xuq'asaj parukamaj i Dios i Samuel i jalal ruq'oral, i Saúl, rak'uun i Cis i Abner, rak'uun i Ner, i Joab, rak'uun i Saravia. Chu'nchel i xa chib'ih jariik xkiq'asaj re' re', re' Selomit, ruch'ihil taqe i ruchaaq' xcha'jinik reh.</para>
  <para style="p">
    <verse number="29" style="v" />Eh chi kixilak taqe i riih rumaam i Izhar, re' Quenanías, re' taqe i rak'uun i xi kahnik chi k'amal kib'eeh i tinamit Israel, eh re' keh kib'anik i q'ataj q'orik.</para>
  <para style="p">
    <verse number="30" style="v" />Eh chi kixilak i riih rumaam Hebrón Hasabías, ruch'ihil taqe i ma' tokoom ta ruuk' xi kahnik chi k'amal kib'eeh i aj Israel wilkeeb' parelb'aal reje i q'iij, chi juntar i nim ha' Jordán. Re' taqe i k'amal b'eeh re' re' q'e' kow kiib' xi kamanik parukamaj i Dios, eh parukamaj i reey. Eh re' taqe re' jinaj miil ruuk' wuquub' siento chi kiib'. <verse number="31" style="v" />Eh chi kixilak i riih rumaam Hebrón, re' Jerías, i k'amal kib'eeh, re' q'oreel nik' kik'ihaal i xtz'ihb'jik kib'ihnaal chi kich'uhqaal. Eh noq ka'winaq chik haab' rokiik chi reyil i David ar Israel, xi okik chi rajaljiik jarub' i tz'ihb'amaj kib'ihnaal. Eh xkikoj rehtaal chi k'ih taqe i winaq q'e' kow kiib' wilkeeb' chi kixilak i aj Jazer wilik Galaad. <verse number="32" style="v" />Re' David xusik' kiwach i kiib' miil ruuk' wuquub' siento chi winaq kow kiib'. Eh re' keh xi kahnik chi k'amal kib'eeh i ju'jun chi patineel xkikoj taqe chi k'amal kib'eeh taqe i riih rumaam Rubén, taqe i riih rumaam Galaad, chi k'amal kib'eeh taqe i yejaal ch'uq chi riih rumaam i Manasés. Re' taqe re' xi kamanik chuwach i Dios, eh xi kamanik wo' chuwach i reey David.</para>
  <chapter number="27" style="c" />
  <para style="s">Re' noq xi okik chi kamanik ruuk' i reey David i kajaaw i soldado, eh re' taqe i ma' re' ta soldado</para>
  <para style="p">
    <verse number="1" style="v" />Chupaam i ju'jun poh reh i haab' kijib' ru ka'winaq miil chi winaq kikamanik chi ki soldado i aj Israel. Eh chi kixilak i re' kiokik haa' i k'amal kib'eeh i ju'jun ch'uq chi aj patineel, je' wo' taqe i k'amal kib'eeh i soldado, je' wo' taqe nimaq wach kikamaj ruuk' i reey David. Eh re' q'oreel i poh kikamanik wii' i ju'jun ch'uq, eh je' wili kib'ihnaal ink'amwik kib'eeh:</para>
  <para style="p">
    <verse number="2" style="v" />Re' peet ch'uq xi okik chi kamanik, kijib' ru ka'winaq miil taqe chi winaq, re' i xkahnik chi k'amal kib'eeh re' i Josobeam rak'uun i Zabdiel <verse number="3" style="v" />Eh re' taqe i riih rumaam i Fares i xkahnik chi k'amal kib'eeh taqe i kajaaw soldado xi okik chi k'amanik chuwach i peet poh.</para>
  <para style="p">
    <verse number="4" style="v" />Eh re' rukab' ch'uq xi okik chi kamanik chuwach i rukab' poh, kijib' ru ka'winaq miil chi winaq taqe, re' xkahnik chi k'amal kib'eeh re' i Dodai riih rumaam i Ahod, eh re' ruk'ab' k'amal b'eeh re' i Miclot.</para>
  <para style="p">
    <verse number="5" style="v" />Eh re' i roox ch'uq xi okik chi kamanik chuwach i roox poh, re' xkahnik chi k'amal kib'eeh re' Benaía rak'uun i Jocadá kajaaw i k'amal kib'eeh i aj tiij. <verse number="6" style="v" />Eh re' i Benaía kow riib' chi kixilak i lajeeb' ru ka'winaq chi soldado, re' reh i k'amal kib'eeh, i junch'uq re' re' wilik i Amisabad re' i rak'uun.</para>
  <para style="p">
    <verse number="7" style="v" />Eh re' i rukaaj ch'uq xi okik chi kamanik parukaaj poh, kijib' ru ka'winaq miil chi winaq taqe, re' xkahnik chi k'amal kib'eeh, re' i Asael ruchaaq i Joab, chi riij i re', re' chik i Zebadías i rak'uun xkahnik chi k'amal b'eeh.</para>
  <para style="p">
    <verse number="8" style="v" />Eh re' i roo' ch'uq i xi okik chi kamanik paroo' poh, kijib' ru ka'winaq miil chi winaq taqe, re' xkahnik chi k'amal kib'eeh, re' i Samhut aj Izraita.</para>
  <para style="p">
    <verse number="9" style="v" />Eh re' i ruwaaq ch'uq xi okik chi kamanik paruwaaq poh, kijib' ru ka'winaq miil chi winaq taqe, re' i xkahnik chi k'amal kib'eeh, re' Ira, rak'uun i Ikes aj pan tinamit Tacoa.</para>
  <para style="p">
    <verse number="10" style="v" />Re' i ruwuuq ch'uq xi okik chi kamanik paruwuuq poh, kijib' ru ka'winaq miil chi winaq taqe, re' i xkahnik chi k'amal kib'eeh, re' i Heles aj ar Pelón. Eh re' taqe i riih rumaam Efraín.</para>
  <para style="p">
    <verse number="11" style="v" />Re' ruwahxaaq ch'uq xi okik chi kamanik paruwahxaaq poh, kijib' ru ka'winaq miil chi winaq taqe, re' xkahnik chi k'amal kib'eeh re' Sibecai aj Husá, re' i riih rumaam Zérah.</para>
  <para style="p">
    <verse number="12" style="v" />Re' rub'eleej ch'uq xi okik chi kamanik parub'elejeeb' poh, kijib' ru ka'winaq miil chi winaq taqe, re' i xkahnik chi k'amal kib'eeh, re' i Abiezer aj Anatot, re' taqe i riih rumaam i Benjamín.</para>
  <para style="p">
    <verse number="13" style="v" />Re' ru lajeeb' ch'uq xi okik chi kamanik parulajeeb' poh, kijib' ru ka'winaq chi winaq taqe re' xkahnik chi k'amal kib'eeh, re' i Maharai i aj Netofa re' ruuk' taqe i riih rumaam i Zérah.</para>
  <para style="p">
    <verse number="14" style="v" />Re' i rujunlaaj ch'uq xiokkik chi kamanik parujunlaaj poh, kijib' ru ka'winaq miil chi winaq taqe, re' xkahnik chi k'amal kib'eeh re' i Benaías aj Piratón, re' taqe i riih rumaam i Efraín.</para>
  <para style="p">
    <verse number="15" style="v" />Re' rukab'laaj ch'uq xi okik chi kamanik parukab'laaj poh, kijib' ru ka'winaq miil chi winaq taqe, re' i xkahnik chi k'amal kib'eeh re' i Heldai aj Netofa, re' i riih rumaam i Otoniel.</para>
  <para style="p">
    <verse number="16" style="v" />Re' i xi okik chi k'amal kib'eeh i kab'laj ch'uq chi riih rumaam i Israel je' wili i kib'ihnaal: Re' taqe i riih rumaam i Rubén re' i Eliezer rak'uun i Zicri. Re' taqe i riih rumaam i Semeón, re' i Sefatías rak'uun i Maaca xkahnik chi k'amal kib'eeh. <verse number="17" style="v" />Re' taqe i riih rumaam i Leví re' xkahnik chi k'amal kib'eeh i re' i Hasabías rak'uun i Kemuel. Eh re' taqe i riih rumaam i Aarón, re' i Sadoc xkahnik chi k'amal kib'eeh. <verse number="18" style="v" />Re' taqe i riih rumaam i Judá, re' i xkahnik chi k'amal kib'eeh, re' Eliú ras i David. Re' taqe i riih rumaam i Isacar, re' Omri rak'uun i Micael i xkahnik chi k'amal kib'eeh. <verse number="19" style="v" />Re' taqe i riih rumaam i Zabulón, re' i xkahnik chi k'amal kib'eeh, re' i Ismaías, rak'uun i Abdías. Eh re' taqe i riih rumaam i Neftalí, re' Jerimot, rak'uun i Azriel i xkahnik chi k'amal kib'eeh. <verse number="20" style="v" />Re' taqe i riih rumaam i Efraín, re' i Oseas rak'uun i Azazías i xkahnik chi k'amal kib'eeh. Eh re' taqe yejaal i reh i riih rumaam i Manasés, re' i Joel rak'uun i Pedaías i xkahnik chi k'amal kib'eeh. <verse number="21" style="v" />Eh re' i yejaal chik reh i riih rumaam i Manasés wilkeeb' Galaad, re' xkahnik chi k'amal kib'eeh, re' i Iddo rak'uun i Zacarías. Eh re' taqe i riih rumaam i Benjamín, re' xkahnik chi k'amal kib'eeh, re' Jaasiel rak'uun i Abner. <verse number="22" style="v" />Re' taqe i riih rumaam i Dan, re' i xkahnik chi k'amal kib'eeh re' i Azareel rak'uun i Jeroham. Re' taqe wili xi kahnik chi k'amal kib'eeh i kab'laj ch'uq chi riih rumaam i Israel.</para>
  <para style="p">
    <verse number="23" style="v" />Re' reey David ma' xrik'saj taj i ajlanik chikinaah i komajaa' kiponik juninaq haab'. Ruum re' i QaJaaw Dios ruq'orom chi naa ruk'ihaaxb'isam, taqe i aj Israel korehtaal kiponik chi je' kik'ihaal i ch'umiil wilkeeb' pan taxaaj. <verse number="24" style="v" />Re' Joab xutoq'aa' wo' naq rub'aan i tz'ihb' reh i kajaljiik xa re' la' ma' xukohlaaj ta rub'aan ruum chi xutoq'aa' naq ajlanik, xchalik i ti' k'axik chikinaah i aj Israel. Ruum aj re' ma' xtz'ihb'jik ta rehtalil chi manlik, jarub' chi kiib' i aj Israel i rutz'ihb'aaj wii' rehtaliil i reey David.</para>
  <para style="p">
    <verse number="25" style="v" />Re' i Azmavet rak'uun i Adiel incha'jinik reh i k'ih taq tz'aaq wilik reh i reey. Eh re' i Jonatán rak'uun i Uzías incha'jinik reh i k'ih taq tz'aaq wilkeeb' pantaq ab'iix, pantaq nimaq tinamit, pantaq kok' tinamit, je' wo' taqe i paat najt kinaah i kiko'leej wii' kiib'. <verse number="26" style="v" />Eh re' Ezri i rak'uun i Quelub xkahnik chi k'amal kib'eeh taqe i kiab'ixinik wach ak'al. <verse number="27" style="v" />Eh re' Simei i aj Romat xkahnik chi k'amal kib'eeh taqe i kitikwik reh i uuva. Eh re' Zabdi aj Sefam, xkahnik chi k'amal kib'eeh i kimolwik reh i riis uuva panye'aab' reh. <verse number="28" style="v" />Eh re' i Baal-hanán aj Gedera, xkahnik chi k'amal kib'eeh i kikamanik wach taqe chee' olivo, i chee' higo, re' taqe i wilkeeb' wach k'ixkaab' Sefela. Eh re' Joás xkahnik chi k'amal kib'eeh i kimolwik reh i aseite. <verse number="29" style="v" />Eh re' i Sitrai aj Sarón xkahnik chi k'amal kib'eeh i kicha'jinik reh taqe i Safat i rak'uun i Adlai xkahnik chi k'amal kib'eeh i kicha'jinik reh taqe chikop wilkeeb' wach k'ixkaab'. <verse number="30" style="v" />Eh re' i Obil, re' taqe i riih rumaam i Ismael, xkahnik chi k'amal kib'eeh taqe i kicha'jinik reh taqe i cameyo. Eh re' i Jehedías aj Meronat, incha'jinik taqe i b'uurux. <verse number="31" style="v" />Eh re' i Jaziz, re' aj agareno xkahnik chi k'amal kib'eeh taqe i kicha'jinik reh taqe i tentzun. Re' taqe chu'nchel i wili xi kahnik chi k'amal kib'eeh taqe i xi ilwik reh chu'nchel i chib'ih xwihik reh i reey David.</para>
  <para style="p">
    <verse number="32" style="v" />Eh re' Jonatán rikaan i David re' reh kojol na'ojb'al, eh tijimaj chi korik holohik runa'ojb'al. Eh re' i Jehiel i rak'uun i Hacmoni inilwik keh i rak'uun i reey David. <verse number="33" style="v" />Eh re' Ahitofel intoob'inik reh i reey chukapeb'jiik riij chib'ih taqe i rub'an. Re' i Husai i aj arquita, xti atoob'laj ramigo i reey. <verse number="34" style="v" />Eh koq'uun chik re' i Joiada rak'uun i Benaía, re' Abiatar xi okik chi jilow Ahitofel. Re' Joab wilik chi k'amal kib'eeh taqe i ru soldado i reey David.</para>
  <chapter number="28" style="c" />
  <para style="s">Re' reey David xuq'or chi re' Salomón naa rokiik chi jilow</para>
  <para style="p">
    <verse number="1" style="v" />Re' reey David xumol kiwach ar Jerusaleem i wilik kajaawriik, taqe ink'amwik kib'eeh i ju'jun ch'uq chi aj Israel. Je' wo' taqe i k'amal kib'eeh kikamanik ruuk' i reey, je' wo' i k'amal kib'eeh i ju'jun ch'uq chi soldado Eh xumol kiwach i k'amal kib'eeh i ki-ilwik reh i rak'aal, chu'nchel i chib'ih i wilik reh i reey, je' wo' hoq i ki-ilwik keh i rak'uun, rixq'uun, xumol kiwach i nimaq kiwach, je' wo' chu'nchel i soldado kow kiib'.</para>
  <para style="p">
    <verse number="2" style="v" />Eh re' reey David xpa'lojik johtoq, je' wili xuq'or: Chab'iraj taq i naa nuq'orom was nuchaaq', hat taq nutinamiit. Re' hin wilik naq panuk'ux chi naa nuyejaam jino'q i paat naa ruwihiik wii' chi juneliik i kaxa molik wii' i ruk'uhb'aal i QaJaaw Dios. Re' naq i ye'aab' re' re' naa ruwihiik wii' i QaJaaw Dios. Re' hin nuyejaam naq chik wach chi re' hin naa nuyej-aniik reh. <verse number="3" style="v" />Xa re' la' re' Dios je' wili i xuq'or weh: Ma' re' tee hat naa ayej-aniik i nupaat ruum re' hat, hat aj q'aq'ineel ma' k'isiin ikaansanik a'nam, inki. <verse number="4" style="v" />Xa re' la' re' i QaJaaw i qaDios i hoj aj Israel xusik' cho nuwach chi kixilak i awach weh reh chi xirukoj chi juneliik chi reyil ayu' Israel. Eh xusik' cho wach i Judá reh chi kixilak i riih rumaam xelik chaloq i naa kikahniik chi taaq'anik Israel. Eh chi kixilak i riih rumaam i Judá xusik' cho kiwach i re', xusik' cho nuwach chi xirukoj chi reey chinaah i Israel. <verse number="5" style="v" />Eh re' i QaJaaw Dios k'ih taqe wak'uun xuyeew weh. Eh chi kixilak i re' xusik' wach i Salomón, reh chi re' chik i reh naa rokiik chi reyil chikinaah i aj Israel rutinamiit i Dios. <verse number="6" style="v" />Re' QaJaaw Dios je' wili xuq'or weh: Re' i Salomón awak'uun naa ruyej-aniik reh i nupaat, je' wo' hoq i ye'aab' wilik chi junsuut. Eh re' reh naa rukahniik chi wak'uun, eh re' hin naa nukahniik chi ruDios. <verse number="7" style="v" />Re' hin naa nuye'em paruye'aab' chi reyil chi juneliik, wila' ma' xukanaa' rub'aan taqe i ruq'or i nuk'uhb'aal, wila' xuchop ruk'ux chub'aan je' rukab' i k'ahchi' yu'naak, inki weh.</para>
  <para style="p">
    <verse number="8" style="v" />Eh re' taq i hat was nuchaaq' chuwach i QaJaaw Dios, eh chikiwach chu'nchel quch aj Israel kimolom kiib' ayu', rutinamiit i Dios, chu'nchel nuk'ux i nuq'or taq aweh chi cha a'n taq chu'nchel i ruk'uhb'aal i Dios xuq'or qeh. Reh chi nee taq inako'leej riij i ye'aab' wili, eh reh chi neenkahnik taq aweh, reh chi nee taq inakanaa' keh taqe i awiih aamaam naa kiwihiik koq'uun.</para>
  <para style="p">
    <verse number="9" style="v" />Eh re' hat Salomón i hat wak'uun cha nimaj aaDios, i nuDios i hin, hin awajaaw. Cha a'n i rukamaj chu'nchel ak'ux parukorkiil. Re' i QaJaaw Dios reht'al chib'ih jariik i wilik paránima i ju'jun, eh reht'al i runa'ojb'al i ju'jun. Wila' xasik' i QaJaaw Dios re' reh neentoob'inik aweh. Eh wila' xaq'eb' chi riij ak'ux i hat nee wo' ti ruq'eb' chi riij ruk'ux i reh chi jumpech. <verse number="10" style="v" />Eh wilik-oq panak'ux chi re' i QaJaaw Dios sik' wik awach chi re' hat naa ayej-aniik reh i rupaat i rusantolaj ye'aab'. Je' re' noq chakowej ak'ux, okeen chi kamanik, inki i reey David.</para>
  <para style="p">
    <verse number="11" style="v" />Eh re' reey David xuq'asaj reh i Salomón re' i rak'uun i tz'ihb'amaj wii' rehtaliil nik' wach ruwii' i rupaat i Dios, naa rub'anam, je' wo' rehtaliil taqe i paat molb'al reh taqe xa chib'ih jariik, je' wo' taqe i ruxiik' inajt kinaah paat, kok' paat. Eh je' wo' rehtaliil i ye'aab' xti wilik rusantohiil. <verse number="12" style="v" />Eh xuq'asaj wo' rehtalil nik' nimaal i kamanik xukapaaj rub'aan, re' taqe i ye'aab' wilkeeb' chi junsuut i rupaat i Dios, je' wo' taqe i kok' tasooj paam paat, naa ruwihiik chi junsuut. Eh xuyeew wo' reh i rehtaliil i molarik wii' taqe i xa chib'ih jariik, je' wo' hoq kimolarik wii' i mayiij wilik rusantohiil. <verse number="13" style="v" />Xuq'asaj wo' reh i Salomón i rehtaliil nik' wach i kamanik naa kianam parupaat i Dios i ju'jun chi k'amal kib'eeh aj tiij re' taqe i riih rumaam i Leví. Eh nik' wach rilariik naa kianam i xa chib'ih jariik inkamanik parupaat i Dios.</para>
  <para style="p">
    <verse number="14" style="v" />Eh k'ih i oro i plata xuyeew reh re' chi naa rukorjiik ruuk' oro, ruuk' plata chu'nchel i xa chib'ih jariik naa rukamaniik, parukamaj i Dios. <verse number="15" style="v" />Eh xuq'asaj wo' i oro i plata yejemb'al reh taqe i ye'aab' kantela, je' wo' taqe i ye'aab' saqumb'al. Re' q'oreel nik' k'ihaal i oro, i plata naa rukorjiik wii' i ju'jun, je' wo' re' k'ihaal i xuq'asaj. <verse number="16" style="v" />Eh xuq'asaj wo' reh i oro, i plata yejemb'al reh taqe i mexa inye'arik wii' i kaxlanwi'k inye'arik chi mayiij re' q'oreel nik' k'ihaal i naa rukorjiik wii' i ju'jun je' wo' re' k'ihaal i xuq'asaj. <verse number="17" style="v" />Eh xuq'asaj wo' reh i xti manlik oro, i plata yejemb'al reh i chopb'al mayiij, je' wo' taqe i nimaq kulk, je' wo' taqe i xaro, je' wo' hoq i yejemb'al taqe reh i kulk uuk'b'al ha'. Re' q'oreel nik' k'ihaal inkorjik wii' i ju'jun, je' wo' re' k'ihaal i oro i plata, i tokoom chik ch'ihch' xuq'asaj. <verse number="18" style="v" />Eh xuq'asaj wo' reh i xti manlik oro yejemb'al reh i artaal k'atb'al insensia. Eh xuq'asaj wo' hoq i oro i yejemb'al reh i kareta, je' wo' yejemb'al keh i kiib' chi je' kiwii' ánjel, ruuk' i kixiik' kib'urum naah i kaxa molik wii' i ruk'uhb'aal i QaJaaw Dios.</para>
  <para style="p">
    <verse number="19" style="v" />Re' David je' wili i xuq'or reh i Salomón i rak'uun: Chu'nchel i wili re' i QaJaaw Dios xk'uhtanik weh. Re' hin xnutz'ihb'aaj rehtaliil reh chi nuq'asaj aweh xti nik' wach rub'aan naa a'nam i rupaat i QaJaaw Dios.</para>
  <para style="p">
    <verse number="20" style="v" />Re' David je' wili i xuq'or reh i Salomón: chakowb'isaj ak'ux, okeen chub'anariik i kamanik. Matyo'jik marub'an kiib' ak'ux, ruum re' i nuDios i hin naa ruwihiik awuuk'. Eh re' reh ma' jaruuj naa kaat rukanaam cha wutkeel korehtaal i naa kohlaaj ruyejeb'jiik chu'nchel i rupaat i QaJaaw Dios. <verse number="21" style="v" />Re' taqe i ju'jun ch'uq chi aj tiij re' ruuk' taqe i riih rumaam Leví chayeew rukowiil kik'ux chub'aan chu'nchel i kamanik chupaam i rupaat i QaJaaw Dios. Eh chu'nchel i winaq kitijem kiib' chi kamanik naa kokiik haa' chato'ariik xa chi siih. Je' wo' taqe i k'amal b'eeh, je' wo' taqe chu'nchel i tinamit, naa wo' kianam chu'nchel i naa aq'orom i hat, inki.</para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Eh chi riij i re' je' wili i xuq'or i David keh i tinamit kimolom kiib': Xa re' wo' hoq i wak'uun Salomón xsik'arik wach ruum i QaJaaw Dios. Atoob' ta komajaa' k'ih i ruhab'ul nim wach i kamanik naa rub'anam. Ruum ma' re' ta rupaat jino'q i reey naa ruyejaam rupaat la' i QaJaaw Dios i naa ruyej-aam. <verse number="2" style="v" />Re' hin xnuchop nuk'ux chi molariik wach taqe naa rukamaniik reh i rupaat i nuDios. Xnumol wach i oro reh i naa rukorjiik ruuk' oro, i plata reh i naa rukorjiik ruuk' plata, i q'an ch'ihch' reh i naa rukorjiik ruuk' q'an ch'ihch', i xach'ihch' reh i naa rukorjiik ruuk' i xach'ihch'. Eh numol wo' wach i chee' reh i naa rukorjiik ruuk' chee', je' wo' hoq i holohaq ab'aj ónice, je' wo' taqe i ab'aj k'ih tz'aaq, i q'eq ab'aj, taqe ab'aj xa reh reh wach kika'yik, taqe i holohoaq ab'aj marmol. <verse number="3" style="v" />Atoob' ta xnumol kiwach chu'nchel wili chi yejemb'al reh i rupaat i Dios. Re' hin ruum chi q'e' i nuk'ax i rupaat i Dios naa nuq'asam i oro, i plata weh naq i hin chi yejemb'al reh i rupaat i Dios. <verse number="4" style="v" />Re' hin naa nuq'asam i kiib' miil ruuk' kiib' siento kintaal i manlik oro. Eh hoob' miil ruuk' oxk'ahl kintaal i manlik plata, esamaj i ruch'uwa'iil wach. Re' taqe re' naa rokiik i koq chib'urb'al wach i rutz'aqiil taqe i paat. <verse number="5" style="v" />Eh re' oro, re' i plata naa rukamaniik keh i naakiyej-aniik reh i xa chib'ihjariik ruuk' oro, ruuk' plata. Eh raaj taq i hat, ¿Mi ma' k'ulik taq panak'ux chi naa taq aye'em amayiij yejemb'al reh i rupaat i Dios? inki i David.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' taqe i k'amal kib'eeh i ju'jun ch'uq chi patineel, taqe k'amal kib'eeh i ju'jun ch'uq chi aj Israel, taqe i k'amal kib'eeh i nimaq ch'uq chi soldado, taqe i k'amal kib'eeh i ki-ilwik reh i chib'ih i wilik reh i reey xkiyeew wo' kimayiij nik' k'ihaal i xchalik pankik'ux. <verse number="7" style="v" />Eh ixib' miil ruuk' waxiqiib' siento kintaal ruuk' lajeeb' roxk'ahl kintaal i oro xkiyeew chi yejemb'al reh i rupaat i Dios, eh lajeeb' miil i tumiin oro, eh i wuquub' miil kintaal ruuk' kiib' siento ruuk' oxk'ahl kintaal i plata, eh oxlaj miil kintaal ruuk' kiib' siento kintaal i q'an ch'ihch'. Eh kab'laj ru kajwinaq miil ruuk' waqiib' siento kintaal i xach'ihch'. <verse number="8" style="v" />Eh je' wo' taqe i wilik i holohaq ab'aj kuuk' xkiq'asaj chi yejemb'al reh i rupaat i Dios, eh kiq'asaj reh i Jehiel re' rak'uun i Gersón, re' i molwik reh i tumiin, reh i rupaat i Dios. <verse number="9" style="v" />Re' taqe tinamit ma' k'isiin ta xsuuqb'ik kik'ux ruum xkiyeew reh i QaJaaw nik' k'ihaal i xchalik pankik'ux.</para>
  <para style="p">
    <verse number="10" style="v" />Eh je' wo' i reey David ma' k'isiin ta xsuuqb'ik ruk'ux xuloq'ej i QaJaaw Dios chikiwach i tinamit kimolom kiib' ar, je' wili xuq'or: Neeta naq inye'arik aloq'il chi juneliik i hat QaJaaw Dios nim awajaawriik. Hat ruDios chee Israel re' qamaam qati't i hoj. <verse number="11" style="v" />QaJaaw Dios re' hat aweh i ajaawriik, i loq'il, i loq'inik. Eh i ruk'ul chi naa ruye'ariik runimaal awach, aloq'il, ruum chu'nchel i xa chib'ih jariik aweh taqe. Chi je' wilkeeb' pan taxaaj, chi je' wilkeeb' wach ak'al. Eh wilik runimaal awajaawriik. Xa re' wo' hat wilik runimaal awach chikiwach chu'nchel. <verse number="12" style="v" />Eh re' wo' hat ti ye'wik reh i b'ehomal, i loq'il. Re' hat, hat q'oreel chinaah chib'ih wilik. Eh re' kowiil i awajaawriik panaq'ab' wilik, hat wo' ti ye'wik i runimaal wachiis, je' wo' hoq i awajaawriik. <verse number="13" style="v" />Ruum aj re', re' hoj QaJaaw qaDios inqayeew runimaal wach, ruloq'il asantolaj b'ihnaal. <verse number="14" style="v" />¿Mi wilik wajaawriik i hin? ¿Mi wilik rajaawriik i nutinamiit chi qayeew taqe aweh chu'nchel i wili? Xti korik wo' hoq chi re' hoj ma' xta wilik qeh, re' i xqayeew aweh re' wo' hat xat ye'wik qeh. <verse number="15" style="v" />Re' hoj xa je' hoj tokoom tinamit chawach ruum xa ik'ik inqa a'n chinaah i wach ak'al wili, je' rukab' noq xi-ik'ik i qamaam qati't. Re' qak'achariik, ayu' wach ak'al xa re' yu' inooj kuxoq wach xa je' nik'ik jinaj muuj. <verse number="16" style="v" />Loq'laj QaJaaw qaDios, re' wo' hat xat ye'wik cho qeh chu'nchel i xqamol wach wili yejemb'al reh aapaat naa rulooq'jiik wii' asantolaj b'ihnaal. <verse number="17" style="v" />WaJaaw nuDios re' hin weht'al chi re' hat aweht'al i wilik cho paránima i ju'jun, eh chimponik chawach i rukorkiil wach k'uxliis. Ruum aj re', re' hin ruuk' i rukorkiil wach nuk'ux i nuq'asaj aweh chu'nchel i wili. Re' hin xnukoj rehtaal chi re' aatinamiit kimolom kiib' ayu' q'e' suq kik'ux noq xkiyeew aweh i kimayiij. <verse number="18" style="v" />QaJaaw Dios ruDios chee i Abraham, i Isaac, i Jacob re' taqe i qamaam qati't. Chatoob'eej aatinamiit reh chi juneliik neen wihik pankanima ruye'ariik i kimayiij, je' rukab' i xkian yu'naak. Eh chi neen kiyeew i kánima awuuk'. <verse number="19" style="v" />QaJaaw Dios i nupahqaaj aweh chi chayeew cho rukorkiil wach ruk'ux i wak'uun Salomón reh chi neerub'an taqe i ruq'or aak'uhb'aal, je' wo' hoq i neenataq'aaj wii'. Reh chi neerub'an ruye'jeb'jiik aapaat re' i xnuchop nuk'ux chumolariik wach i naa rukorjiik wii', inki David.</para>
  <para style="p">
    <verse number="20" style="v" />Chi riij i re', re' David je' wili i xuq'or keh i tinamit kimolom kiib' ar: Yu'naak chayeew taq ruloq'il i QaJaaw Dios, inki. Eh chu'nchel i tinamit xkiloq'ej i Dios re' ki Dios chee kimaam kati't. Eh kixuk'aa' kiib' chuwach i Dios, je' wo' chuwach i reey David.</para>
  <para style="p">
    <verse number="21" style="v" />Eh chi junwaar chik xkiyeew i kimayiij xkik'at chi kimayiij jinaj miil i kok' imas wakax, jinaj miil imas tentzun jinaj miil i kok' tentzun. Eh xkiq'asaj wo' chi kimayiij i riis uuva, xiik' naah k'ihaal i mayiij xkiq'asaj pankib'ihnaal chu'nchel i aj Israel. <verse number="22" style="v" />Eh xkian kiwa' kihaa' chi suq kik'ux chuwach i QaJaaw Dios. Eh re' i Salomón i rak'uun i David xkipab'aa' wo' chik ruka'peech chi reey chinaah i rutinamiit, chuwach i Dios xkijalk'iij i aseite wach naah reh i rupa'ab'jiik chi reey. Eh xkipab'aa' i Sadoc chi k'amal kib'eeh i aj tiij. <verse number="23" style="v" />Je' aj re' noq re' Salomón xokik chi reyil chinaah i rutinamiit i Dios chi jilow i David i rajaaw, chu'nchel i xub'an xelik korik chuwach, eh chu'nchel i aj Israel xnimanik reh i taqe i xuq'or. <verse number="24" style="v" />Eh chu'nchel i wilik kajaawriik, je' wo' taqe i kow kiib' chi q'aq'inik, eh chu'nchel i rak'uun i reey David xkiyeew ruloq'il i reey Salomón. <verse number="25" style="v" />Eh re' i QaJaaw Dios xuyeew runimaal wach i reey Salomón chikiwach chu'nchel i aj Israel. Xuyeew ruloq'il i Salomón chi reey, eh ma' jino'q i reey Israel i xwihik cho chi peet chuwach i reey i Salomón xuyeew ruloq'il chi je' rukab' noq xuyeew ruloq'il i reh.</para>
  <para style="s">Re' i reyil xub'an, re' i rukimiik i reey David</para>
  <para style="r">(<ref loc="1KI 2:10-12">1 Rey 2.10-12</ref>)</para>
  <para style="p">
    <verse number="26" style="v" />Re' David rak'uun i Isaí xwihik chi reyil chinaah chu'nchel i tinamit Israel. <verse number="27" style="v" />Ka'winaq haab' xwihik chi reyil chinaah i tinamit Israel wuquub' haab' xwihik chi reyil ar Hebrón, eh oxlaj ru ka'winaq haab' xwihik chi reyil Jerusaleem. <verse number="28" style="v" />Eh xtirijib' chik chi korik noq xkimik reje i David k'ih laj haab' xk'acharik, xti wihik ruloq'il, rub'ehomal. Eh re' chik i Salomón i rak'uun xkahnik chi jilow chi reyil Israel.</para>
  <para style="p">
    <verse number="29" style="v" />Eh chu'nchel i xub'an i reey David noq xutoq'aa' chee rukamaj korehtaal xukohlaaj rutz'ihb'jiik rehtaliil i Samuel jalal ruq'oral i Dios rutz'ihb'aam wo' rehtaliil i Natán jalal ruq'oral i Dios, je' wo' hoq i Gad jalal ruq'oral i Dios. <verse number="30" style="v" />Eh tz'ihb'amaj wo' rehtaliil chib'ih taqe xub'an noq xwihik chi reyil, je' wo' hoq i rajaawriik. Eh tz'ihb'amaj wo' rehtaliil taqe xuk'ul i reh, je' wo' taqe i xk'ularik Israel, je' wo' hoq i xkik'ul taqe i tokoom tinamit.</para>
</usx>