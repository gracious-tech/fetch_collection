<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="ZEP" style="id">ZEPPOK.SFK 16-05-2,006 Adelina Quej xoy. Pocomchi. Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">SOFONIAS</para>
  <para style="toc3">Sof</para>
  <para style="toc2">Sof</para>
  <para style="toc1">SOFONIAS</para>
  <para style="mt2">RE' I RUHUUJ I SOFONIAS</para>
  <para style="mt1">SOFONIAS</para>
  <chapter number="1" style="c" />
  <para style="s">Naa ruponiik i ruq'ijil noq naa ruye'em i rujosq'iil i QaJaaw Dios</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Sofonías: Noq xwihik chi reyil Judá i Josías rak'uun i Amón. Eh re' i Sofonías rak'uun i Cusi, re' Cusi rak'uun i Gedalías, re' i Gedalías rak'uun i Amarías, re' i Amarías rak'uun i Ezequías.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' i QaJaaw Dios je' wili xuq'or: Re' hin naa nusacham kiwach chu'nchel i</para>
  <para style="q">xa chib'ih jariik wilkeeb' wach ak'al.</para>
  <para style="q">
    <verse number="3" style="v" />Eh naa nusacham kiwach</para>
  <para style="q">i tinamit, taqe i chikop,</para>
  <para style="q">taqe tz'ikin kirupinik pan taxaaj,</para>
  <para style="q">taqe i kar wilkeeb' pam palaw.</para>
  <para style="q">Eh naa wo' nusacham kiwach</para>
  <para style="q">i yiib' wach kina'ojb'al, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh je' wo' chik wili i xuq'or:</para>
  <para style="q">Re' hin naa nuye'em taqe panti' k'axik i aj Judá,</para>
  <para style="q">je' wo' taqe i aj Jerusaleem.</para>
  <para style="q">Naa wo' nusacham kiwach i ruqox i kitiyoox Baal.</para>
  <para style="q">Naa wo' nusacham kiwach taqe</para>
  <para style="q">i k'amal kib'eeh aj tiij kikamanik chikiwach taqe re'.</para>
  <para style="q">
    <verse number="5" style="v" />Eh naa nusacham kiwach taqe i kijohtik</para>
  <para style="q">chinaah i kipaat chulooq'jiik i q'iij, i poh, taqe ch'umiil.</para>
  <para style="q">Re' keh inkixuk'aa' kiib' chupahqaljiik</para>
  <para style="q">i rotob'il i kitiyoox Milcom, eh inkiq'or wo' i nub'ihnaal i hin.</para>
  <para style="q">
    <verse number="6" style="v" />Eh naa nusacham kiwach taqe inkikanaa' nunimjiik,</para>
  <para style="q">taqe i ma' nkikapaaj ta nusik'ariik</para>
  <para style="q">ni xata chik inkipahqaaj kina'ojb'al weh, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' taq i hat matchoqik taq chik, chayohleej taq wach i QaJaaw Dios,</para>
  <para style="q">ruum re' reh xailook' chik i ruyeew chaloq i ti' k'axik.</para>
  <para style="q">Re' reh je' jinaj mayiij i naa ruye'em noq naa rukansam taq aatinamiit</para>
  <para style="q">i ki-ixowinik taq awach.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Noq naa nuq'asam panti' k'axik i nutinamiit,</para>
  <para style="q">naa nuye'em taqe chutojariik i kimahk i k'amal kib'eeh.</para>
  <para style="q">Eh naa nusacham kiwach i rak'uun rixq'uun i kireey,</para>
  <para style="q">je' wo' taqe inkikoj itz'ihy inkikoj i ma' kinimanik ta weh.</para>
  <para style="q">
    <verse number="9" style="v" />Eh naa nuye'em taqe i pan</para>
  <para style="q">ti' k'axik taqe aj war,</para>
  <para style="q">je' wo' taqe inkinujisaj chi xa chib'ih jariik i rupaat i ki dios</para>
  <para style="q">ruuk' taqe i xankelq'aaj chaloq, ruuk' chukuj q'orik, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' i Dios je' wili xuq'or:</para>
  <para style="q">Chupaam taqe i q'iij re' re' kow naakik'erem</para>
  <para style="q">kichii' chi chii' puerta ink'ayjik wii' kar.</para>
  <para style="q">Eh naa rib'irjiik chaloq i wilik wii' i rukab' ookb'al,</para>
  <para style="q">chi xa kichoqik chik noq naa kik'uliik iloq naah taq yuuq' i nixowanik kiwach.</para>
  <para style="q">
    <verse number="11" style="v" />Naa taq ak'erem aachii' chi oq'ik i hat i wilkaat taq ma' najt ta ruuk' i ye'aab' Mactes,</para>
  <para style="q">ruum naa kikanteesjiik taqe i aj k'aay wilkeeb' taq chaxilak,</para>
  <para style="q">je' wo' chu'nchel i kich'aqwik wach tumiin.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Eh chupaam taqe i q'iij re' re',</para>
  <para style="q">re' hin je' na naa nuqopom nuq'aaq'</para>
  <para style="q">chi kisik'ariik yiib' wach kina'ojb'al ar Jerusaleem.</para>
  <para style="q">Eh naa taqe nuye'em chutojariik i kimahk,</para>
  <para style="q">re' keh xa ch'iklik chik kik'ux, je' rukab' noq intuqlujik i vino, je' wili inkiq'or:</para>
  <para style="q">Re' Dios xama' xta wo' i neerub'an qeh, inki taqe.</para>
  <para style="q">
    <verse number="13" style="v" />Xanaah re' naa ruq'uchariik i chib'ih keh,</para>
  <para style="q">naa wo' ruyojariik i kipaat.</para>
  <para style="q">Eh re' i kipaat naa kiyejaam xama' naa ta wo' kipatinik chupaam,</para>
  <para style="q">re' i ki uuva naa kitikim xama' naa ta wo' kuk'em keh i riis, inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />K'ahchi' chik ruponiik i q'iij chi re' i QaJaaw Dios naa ruye'em</para>
  <para style="q">taqe panti' k'axik i yiib' wach kina'ojb'al.</para>
  <para style="q">Eh xiik' naa ti' kiil i naakik'ulum chupaam i q'iij re' re',</para>
  <para style="q">nik' ta naq kowiil i winaq xanaa wo' roq'iim ruum i naakik'ulum</para>
  <para style="q">
    <verse number="15" style="v" />Chupaam taqe q'iij re' re', re' i QaJaaw Dios</para>
  <para style="q">naa ruk'uhtaam i rujosq'iil chikinaah taqe re'.</para>
  <para style="q">Eh jinaj ti'kiil k'uxliis, jinaj yot'oj ánima,</para>
  <para style="q">jinaj tukinik wachiis, ruum i rusachariik kiwach,</para>
  <para style="q">naa ruq'equumriik paam i taxaaj, ruum i q'eq suutz',</para>
  <para style="q">naa ruq'equumriik wach i q'iij.</para>
  <para style="q">
    <verse number="16" style="v" />Eh naakixulem chaloq i kituun i naa kichaliik chi q'aq'inik,</para>
  <para style="q">chikinaah taqe i tinamit kotimaj kiij chi tz'aq,</para>
  <para style="q">eh wilik kinajt naah tz'aq ko'lemb'al kiib'.</para>
  <para style="q">
    <verse number="17" style="v" />Eh naa nuye'em taqe panti' k'axik i aj Judá, i aj Jerusaleem,</para>
  <para style="q">naa kikahniik chi je' taqe mutz'wach,</para>
  <para style="q">xak'ul chik naa kojiik chusik'ariik aha' naa kiko'leem kiib',</para>
  <para style="q">ruum i kimahk chi nuwach, naa ruchihkiik pampooq i kikik'eel,</para>
  <para style="q">eh re' i kiti'jolal naa rukahniik chi xa tz'aq tz'aq chik,</para>
  <para style="q">xa je' chik rusaa' wakax, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Eh chupaam i q'iij re' re' ni xata naq re' i ki plata, i ki oro</para>
  <para style="q">naa ruko'liniik keh chuwach i rujosq'iil i QaJaaw Dios.</para>
  <para style="q">Ruuk' i rujosq'iil jumehq'iil naa rusacham kiwach</para>
  <para style="q">chu'nchel i k'achareel wach ak'al,</para>
  <para style="q">je' rukab' i rub'an i xaq q'aaq'</para>
  <para style="q">noq i ruk'at chu'nchel i xa chib'ih jariik.</para>
  <chapter number="2" style="c" />
  <para style="q">
    <verse number="1" style="v" />Chamol taq awiib', cha kapaaj taq riij chib'ih taq i naa a'nam i hat taq</para>
  <para style="q">tinamit ma' ti' k'ixik ta taq k'isinoq chub'anariik i yiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="2" style="v" />Re' taq i hat i komajaa' imponik i q'iij chi naa taq ak'ulum i ti' k'axik.</para>
  <para style="q">Eh re' i q'iij xa je' i nik'ik i rutuus i ixiim panteew.</para>
  <para style="q">Je' re' noq konee rub'an chi nee taq inakapaaj riij chib'ih taq i naa a'nam</para>
  <para style="q">ruum komajaa' i ruyeew i rujosq'iil taq cha naah.</para>
  <para style="q">
    <verse number="3" style="v" />Re' taq i hat i xa atoob' taq wach ak'ux</para>
  <para style="q">wilkaat taq wach ak'al,</para>
  <para style="q">konee rub'an chi nee taq inasik' i Dios</para>
  <para style="q">i tib'anik taq reh i ruq'or i ruk'uhb'aal.</para>
  <para style="q">Eh cha sik' taq i ruk'ul chi b'anarik, konee oon naq tiko'ljik</para>
  <para style="q">taq chuwach i runimaal rujosq'iil i Dios naa ruye'em chupaam taqe i q'iij re' re'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' tinamit Gaza ma' xta chik i naa rukahniik chupaam,</para>
  <para style="q">re' taqe i aj Ascalón q'e' naa rutib'iik kik'ux.</para>
  <para style="q">Re' taqe i aj Asdod pan q'iij naa ruq'uchariik i chib'ih keh,</para>
  <para style="q">re' taqe i aj Ecrón naa rusachariik kiwach.</para>
  <para style="q">
    <verse number="5" style="v" />Re' taq i hat aj Creta i wilkaat taq chi chii' i palaw q'e' taq ti' i naa ak'ulum.</para>
  <para style="q">Re' i QaJaaw Dios ruq'orom chi naa ruye'em i ti' taq cha naah:</para>
  <para style="q">Re' taq i hat aj Canaán i wilkaat taq pankiyuq'ul i aj filisteo,</para>
  <para style="q">naa taq nusacham awach.</para>
  <para style="q">Ma' jino'q chik i k'achareel naa rukahniik taq panatinamiit.</para>
  <para style="q">
    <verse number="6" style="v" />Re' i ye'aab' chi chii' i palaw, naa rupimb'iik i ch'ahn chuwach,</para>
  <para style="q">Eh ar naa kianam kiwa' tentzun,</para>
  <para style="q">eh naa rukahniik chi kikoraal i tentzuun, inki i Dios.</para>
  <para style="q">
    <verse number="7" style="v" />Eh nik' chik k'ihaal i ruqox i tinamit Judá,</para>
  <para style="q">naa kikahniik re' chik i keh</para>
  <para style="q">naa kehchaniik reh i kiye'aab' i aj Ascalón, ar naa kiwihiik.</para>
  <para style="q">Eh pantaq chaq'ab' ar naakiwiriik chupaam i kiye'aab' i aj Ascalón,</para>
  <para style="q">re' i kaJaaw i ki Dios naa rutoob'iniik keh,</para>
  <para style="q">noq naa wo' chik ruketeljiik kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' hin xb'iraj noq re' taqe i aj Moab,</para>
  <para style="q">taqe i aj Amón xkib'aj i nutinamiit.</para>
  <para style="q">Eh xkesaj i rajaawriik i nutinamiit, xkehchaaj i ruye'aab'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hin i k'achlik Dios</para>
  <para style="q">nim wajaawriik hin ki Dios i aj Israel.</para>
  <para style="q">Re' hin i nuq'or chi naa rusahchiik kiwach i aj Moab</para>
  <para style="q">je' rukab' i xkik'ul i aj Sodoma,</para>
  <para style="q">naa rusahchiik kiwach i aj Amón je' rukab' i xkik'ul i aj Gomorra.</para>
  <para style="q">Eh k'iix chik i naa rupoq'iik cho pan kiye'aab',</para>
  <para style="q">xa aatz'aam ab'aj chik i naa ruwihiik ar,</para>
  <para style="q">ma' xta chik i naa ruwihiik ar.</para>
  <para style="q">Eh re' i nutinamiit naakiko'ljiik re' chik i keh</para>
  <para style="q">naa kehchaniik reh i chib'ih keh, inki i Dios.</para>
  <para style="q">
    <verse number="10" style="v" />Eh chu'nchel i ti' k'axik re' re' naa ruchaliik chikinaah i aj Moab,</para>
  <para style="q">i aj Amón, ruum q'e' nim kiwach inki a'n kiib', eh inkib'aj,</para>
  <para style="q">rutinamiit i Dios nim rajaawriik.</para>
  <para style="q">
    <verse number="11" style="v" />Re' taqe i re' q'e' ti i naa rub'aan keh ruum i QaJaaw Dios</para>
  <para style="q">ruum naa rusachariik wach chu'nchel i kitiyoox.</para>
  <para style="q">Eh xa re' chik i k'achlik Dios naa kiloq'em taqe i tinamit xa aha' yuuq',</para>
  <para style="q">je' wo' wilkeeb' chaloq panlahtz'.</para>
  <para style="q">
    <verse number="12" style="v" />Je' wo' taq i hat aj Etiopía, naa wo' ruye'em q'ab' i QaJaaw Dios</para>
  <para style="q">chi naa taq akanteesjiik ruuk' i q'aslaj ch'ihch'.</para>
  <para style="q">
    <verse number="13" style="v" />Re' i QaJaaw Dios naa taqe ruye'em chutojariik i kimahk i aj Asiria,</para>
  <para style="q">re' i wilkeeb' reje pantz'eet reh i rookb'aal q'iij.</para>
  <para style="q">Naa rusacham kiwach i aj Nínive,</para>
  <para style="q">naa rukahniik chi xa je' chik chiq yuuq' i kiye'aab'.</para>
  <para style="q">
    <verse number="14" style="v" />Re' naa ruyojib'iik i kipaat re' ruuk' i chakaltee' kiyejaa' wii',</para>
  <para style="q">naa rukahniik chi kiye'aab' tentzuun,</para>
  <para style="q">chi kiye'aab' josq'laj chikop.</para>
  <para style="q">Eh re' naq i wilkeeb' wii' taqe i ajaab'ees</para>
  <para style="q">yu'naak chikop chik i naa kiwihiik ar,</para>
  <para style="q">re' taqe i nimaq taq tz'ok, taqe i tuhkur</para>
  <para style="q">naa kiyejaam kisuuq' chinaah taqe i rib'ojal i kipaat.</para>
  <para style="q">Eh ar naakitz'uyiniik chaloq taqe i kok' tz'ikin.</para>
  <para style="q">
    <verse number="15" style="v" />Re' i tinamit re' re',</para>
  <para style="q">ch'iklik wo' naq kik'ux ruuk' inki a'n</para>
  <para style="q">q'e' nim kiwach inki a'n kiib',</para>
  <para style="q">naa ruponiik i q'iij noq naa rukahniik chi ntz'irik kiwach.</para>
  <para style="q">Eh re' i kiye'aab' naa rukahniik chi kiye'aab' josq'laj chikop,</para>
  <para style="q">eh awach naakik'iik ilwoq reh i kitinamiit naakikaqse'laam</para>
  <para style="q">naakipohq'aam paam i kiq'ab'.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' i mahk xkian i aj Jerusaleem, eh re' i ruketeljiik kiwach xb'aan</para>
  <para style="q">
    <verse number="1" style="v" />Q'e' ti' i naakik'ulum i aj Jerusaleem ma' kinimanik taj,</para>
  <para style="q">yiib' wach kina'ojb'al, ye'el panti' k'axik i kas kichaaq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Ma' nkib'iram taj i kiq'ilariik,</para>
  <para style="q">ma' xkiyeew ta kik'ux ruuk' i QaJaaw,</para>
  <para style="q">ni xata xkipahqaaj i rotob'il.</para>
  <para style="q">
    <verse number="3" style="v" />Re' taqe i k'amal kib'eeh, xa je' chik taqe josq'laj kaq b'ahlam.</para>
  <para style="q">Eh re' taqe i q'atal q'orik</para>
  <para style="q">xa je' chik taqe i josq'laj xojb' i kichop i kitiib' chaq'ab',</para>
  <para style="q">ma' xta chik jino'q i rub'aqil inkikanaa' reh chi junwaar.</para>
  <para style="q">
    <verse number="4" style="v" />Re' taqe i jalal ruq'oral i chi kixilak,</para>
  <para style="q">ma' tiklik ta kib'anik, xa aj jot'ool taqe.</para>
  <para style="q">Re' taqe i k'amal b'eeh aj tiij inkich'uwarisaj paam i rupaat i Dios,</para>
  <para style="q">eh inkiyoj wach i ruk'uhb'aal.</para>
  <para style="q">
    <verse number="5" style="v" />Re' i Dios xa re' holohik i rub'an kuuk' i tinamit re' re'.</para>
  <para style="q">Eh ma' rukanaam ta rub'aan i rub'ehel,</para>
  <para style="q">eqal eqal la' pantaq wahq'eq i ruk'uhtaaj i rotob'il.</para>
  <para style="q">Eh re' taqe i yiib' wach kina'ojb'al</para>
  <para style="q">keh xa k'ixb'ilaal kib'anik.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' hin ma' k'isiin i nimaq tinamit xnusach kiwach,</para>
  <para style="q">eh xnusach kiwach inajt kinaah tz'aq wilik chi kijunsuut.</para>
  <para style="q">Eh xan tz'irik chik paam i kib'eeh, ma' jino'q chik i k'achareel ki-ik'ik ar,</para>
  <para style="q">eh ma' jino'q chik chi patineel i xkahnik chupaam.</para>
  <para style="q">
    <verse number="7" style="v" />Eh je' wili i xnukapaaj:</para>
  <para style="q">Noq neenkilow i re' i aj Jerusaleem nee kinkiyohleej,</para>
  <para style="q">neenkaaj chi nee taqe i nuk'uhb'alej.</para>
  <para style="q">Chi je' re' ma' nee ta nsahchik wach i kiye'aab'</para>
  <para style="q">ruuk' ti' k'axik naa nuye'em chikinaah, kinki.</para>
  <para style="q">Eh re' i keh xa reh reh chik i yiib' wach na'ojb'al inki a'n</para>
  <para style="q">
    <verse number="8" style="v" />Ruum aj re' chawuy-eej pee taq i hat naa ruponiik i q'iij</para>
  <para style="q">noq naa nutehem wach taq amahk</para>
  <para style="q">reh i ruq'atariik i q'orik taq cha naah.</para>
  <para style="q">Re' hin Dios kinq'orik reh chi je' wili:</para>
  <para style="q">Naa numolom kiwach i nimaq taq tinamit,</para>
  <para style="q">je' wo' taqe i reey, reh chi naawik'sam i nujosq'iil chikinaah,</para>
  <para style="q">xa je' chik inqop q'aaq', noq naa nuye'em chikinaah.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Noq naa nub'anam i re' pan jinaj ponoq q'iij,</para>
  <para style="q">naa nuye'em q'ab' keh i tinamit chi holohik chik naa kiq'oriik,</para>
  <para style="q">reh chi re' chik hin nee kinkiloq'ej,</para>
  <para style="q">reh chi neenkahnik chi xa jinaj chik wach kik'ux chi nunimjiik.</para>
  <para style="q">
    <verse number="10" style="v" />Re' i nutinamiit tukimaj</para>
  <para style="q">kiwach wilkeeb' i ar i Etiopía,</para>
  <para style="q">chi juntar taqe i nim ha' naa wo' chik kichaliik chi nulooq'jiik,</para>
  <para style="q">eh naa kik'amam chaloq i kimayiij chi nuwach.</para>
  <para style="q">
    <verse number="11" style="v" />Hat taq nutinamiit, chupaam ponoq taqe i q'iij re' re',</para>
  <para style="q">ma' naa ta chik taq ak'ixiik ruum taq amahk xa a'n chi nuwach,</para>
  <para style="q">ruum re' taqe i xiik' naah kajaawriik,</para>
  <para style="q">eh xa nim chik kiwach inki a'n kiib',</para>
  <para style="q">naawisam iloq taq chaxilak.</para>
  <para style="q">Eh ma' jaruuj chik naakik'uhtaam</para>
  <para style="q">i runimaal kiwach chupaam i nuSantolaj ye'aab'.</para>
  <para style="q">
    <verse number="12" style="v" />Re' hin xama' nimaq ta tii wach kajaawriik,</para>
  <para style="q">xa neb'aa' ti taqe i naa nukanaam taq chaxilak,</para>
  <para style="q">eh wuuk' i hin naakiye'em kik'ux.</para>
  <para style="q">
    <verse number="13" style="v" />Re' i kiqox i tinamit Israel, ma' xta chik i yiib' wach na'ojb'al naa kianam,</para>
  <para style="q">eh ma' naa ta chik kichukwiik q'orik</para>
  <para style="q">ma' xta chik tz'aqaj wach k'utaaj naa reliik cho pan kichii'.</para>
  <para style="q">Naa kik'uxlaam kiib' chi korik,</para>
  <para style="q">ma' awach ta chik naa ruyohb'isaniik keh</para>
  <para style="q">noq naakihi'liik, inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' taq i hat aj Sión ti tz'uyinoq taq.</para>
  <para style="q">Je' wo' taq i hat aj Israel titz'uyinoq taq ruum i rusuqkiil taq ak'ux</para>
  <para style="q">eh re' taq i hat aj Jerusaleem suuqb'oq taq ak'ux chi korik</para>
  <para style="q">
    <verse number="15" style="v" />Re' i QaJaaw Dios xrisaj chik i ti' k'axik taq cha naah,</para>
  <para style="q">xresaj taqe reje i ki-ixowinik taq awach.</para>
  <para style="q">Eh re' chik i QaJaaw naa rukahniik taq chi aaReey,</para>
  <para style="q">ma' xta chik taq neetiyo'jik wii', ruum ma' xta chik i ti' k'axik taq cha naah.</para>
  <para style="q">
    <verse number="16" style="v" />Eh chupaam taqe ponoq i q'iij re' re', je' wili i naa ruq'oriik keh, i aj Jerusaleem:</para>
  <para style="q">Matyo'jik taq i hat wilkaat taq ar Sión,</para>
  <para style="q">ma' rub'an taq kiib' ak'ux kiuchjoq.</para>
  <para style="q">
    <verse number="17" style="v" />Re' chik aaWaJaaw aaDios naa ruwihiik taq awuuk',</para>
  <para style="q">eh wilik rajaawriik taq chako'ljiik.</para>
  <para style="q">Eh naa rusuuqb'iik ruk'ux taq chawiij,</para>
  <para style="q">ruuk' i runimaal i ruk'axb'al naa ruye'em taq aweh i ak' laj k'acharik,</para>
  <para style="q">naa taq atz'uyem wach ruum i rusuqkiil taq ak'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' hin naa taq kaat wesam chupaam i ti' k'axik, je' jinaj ninq'iij taq cha weh,</para>
  <para style="q">eh naa taq kaat wesam pan k'ixb'ilaal.</para>
  <para style="q">
    <verse number="19" style="v" />Chupaam i q'iij re' re',</para>
  <para style="q">re' hin naa nuye'em taqe chutojariik i kimahk i kib'anik taq ti' k'axik aweh.</para>
  <para style="q">Eh re' taq i hat naa taq kaat nuko'leem ruum</para>
  <para style="q">je' taq akab' i tentzun ti' wilkeeb',</para>
  <para style="q">re' taq ak'ixb'ilaal naa nusutem chi tz'uuy,</para>
  <para style="q">eh naa nukanaam chi holohik taq awib'iral chi junsuut i wach ak'al.</para>
  <para style="q">
    <verse number="20" style="v" />Eh chupaam taqe i q'iij re' re',</para>
  <para style="q">naa nuketelaam taq awach</para>
  <para style="q">naa numolom taq awach,</para>
  <para style="q">naa taq kaat nuye'em chupaam aa ye'aab',</para>
  <para style="q">eh naa nuye'em runimaal taq awach,</para>
  <para style="q">chi kixilak chu'nchel i tinamit wilkeeb' chi junsuut i wach ak'al, inki QaJaaw Dios.</para>
</usx>