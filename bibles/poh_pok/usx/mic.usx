<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="MIC" style="id">MIKPOK.SFK 15-05-2,006 Adelina Quej. Pokomchi. Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">MIQUEAS</para>
  <para style="toc3">Miq</para>
  <para style="toc2">Miq</para>
  <para style="toc1">MIQUEAS</para>
  <para style="mt2">RE' I RUHUUJ I MIQUEAS</para>
  <para style="mt1">MIQUEAS</para>
  <chapter number="1" style="c" />
  <para style="s">Re' iruq'orariik chi naa ruye'ariik i ti' k'axik chikinaah i aj Samaria</para>
  <para style="p">
    <verse number="1" style="v" />Re' i ruk'uhb'aal i Dios wili xq'orarik reh i Miqueas aj Moreset. Eh parusaq wiriik xk'uhtjik reh chib'ih i naakik'ulum i aj Samaria, i aj Jerusaleem, re' noq xi wihik cho chi reyil Judá i Jotam, i Acaz, i Ezequías.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Eh re' Miqueas je' wili i xuq'or:</para>
  <para style="q">Chab'iraj taq i hat chawunchelaal i wilkaat taq chupaam i ye'aab' wili,</para>
  <para style="q">Chakoj taq rehtaal chi re' i QaJaaw Dios,</para>
  <para style="q">ko chupaam i rusantolaj paat</para>
  <para style="q">naa ruq'orom chaloq chi wilik taq amahk.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i QaJaaw Dios ko paruye'aab' naa reliik chaloq naah taq yuuq' naa ruk'uliik iloq noq</para>
  <para style="q">naa ruye'em i ti' k'axik taq cha naah.</para>
  <para style="q">
    <verse number="4" style="v" />Re' noq naa rub'anam taqe re',</para>
  <para style="q">je' na naa ruhaab'iik taqe i yuuq' k'ixkaab' chuwach,</para>
  <para style="q">xa je' chik rukab' i nelik chaloq</para>
  <para style="q">i kowlaj rooq ha' i nelik chaloq wataq yuuq'.</para>
  <para style="q">
    <verse number="5" style="v" />Ruum taqe kimahk ruum ma' nkinimaj taj i Dios,</para>
  <para style="q">taqe i riih rumaam i Jacob.</para>
  <para style="q">¿Awach aj uum ma' kin nimanik taj i aj Israel?</para>
  <para style="q">¿Mi ma' kuum re' i aj Samaria?</para>
  <para style="q">¿Awach aj uum inkinloq'ej i tiyoox i aj Judá</para>
  <para style="q">mi ma' kuum re' i aj Jerusaleem?</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Eh re' Dios je' wili xuq'or: Re' hin</para>
  <para style="q">naa nusacham wach i chib'ih keh</para>
  <para style="q">i aj Samaria. Re' i kiye'aab' xa tikb'al chik uuva naa rukahniik wii'</para>
  <para style="q">eh re' tz'aq kotimaj wii' riij naa rukutariik wach ak'al.</para>
  <para style="q">
    <verse number="7" style="v" />Eh naakixereb'iik taqe i kitiyoox,</para>
  <para style="q">naakik'ahtiik taqe i inki a'n wii' i loq'inik ruch'ihil taqe i kimayiij ar,</para>
  <para style="q">ruum re' taqe i re' ruuk' kitumiin</para>
  <para style="q">i k'oyoom laj ixoq korjinaq taqe,</para>
  <para style="q">naa wo' chik nukanaam chi je' kitumiin k'oyoom laj ixoq, inki.</para>
  <para style="q">
    <verse number="8" style="v" />Re' i Miqueas je' wili xuq'or:</para>
  <para style="q">Eh ruum taqe naa ruk'ulariik,</para>
  <para style="q">naa wesam i nuxijab' noq naa nub'eeh,</para>
  <para style="q">naawisam i nuso' chi wiij.</para>
  <para style="q">Eh naa nuk'erem nuchii' chi oq'ik,</para>
  <para style="q">je' rukab' noq i ruk'er chii' i xojb', oon i tuhkur.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hin naa rutib'iik nuk'ux ruum i kiyiib' wach</para>
  <para style="q">na'ojb'al i aj Samaria je' rukab' i yok'eel.</para>
  <para style="q">Eh xponik chi kixilak i aj Judá, inki a'n</para>
  <para style="q">xponik kuuk' i aj Jerusaleem, re' taqe i nutinamiit.</para>
  <para style="q">
    <verse number="10" style="v" />Eh ma' naa ta taq aq'orom</para>
  <para style="q">rib'iral ar Gat, ma' naa ta taq awoq'iim,</para>
  <para style="q">xanaa la' taq atolem awiib' panak'al ar Bet-le-afra.</para>
  <para style="q">
    <verse number="11" style="v" />Re' taq i hat aj Safir, naa taq ruk'uhtjiik ak'ixb'ilaal,</para>
  <para style="q">t'usulkaat taq noq naa ak'amariik reje pan tokoom tinamit.</para>
  <para style="q">Eh re' taq i hat aj Zaanán ma' naa ta chik taq aweliik reje pana ye'aab'.</para>
  <para style="q">Eh re' taq i hat aj Bet-sel naa taq awoq'iim</para>
  <para style="q">ruum ma' awach ta naa rutoob'iniik taq aweh.</para>
  <para style="q">
    <verse number="12" style="v" />Re' taqe i aj Marot, ma' k'isa ti' k'axik i naakik'ulum,</para>
  <para style="q">xanaa naq chik kaajwaam elik chupaam,</para>
  <para style="q">xama' naa ta wo' keliik, ruum re' i QaJaaw Dios</para>
  <para style="q">naruye'wiik chikinaah.</para>
  <para style="q">Eh korehtaal naa ruponiik Jerusaleem.</para>
  <para style="q">
    <verse number="13" style="v" />Re' taq i hat aj Laquis chach'ilaa' taq aakareta chikiij i kawáyu,</para>
  <para style="q">reh i runik'ib'jiik elik chuwach i ti' k'axik.</para>
  <para style="q">Ruum re' taq i hat xat k'amwik kib'eeh</para>
  <para style="q">i aj Jerusaleem chub'anariik i yiib' wach na'ojb'al,</para>
  <para style="q">je' wo' noq xkikanaa' runimjiik i Dios i aj Israel.</para>
  <para style="q">
    <verse number="14" style="v" />Re' taq i hat cha kanaa' taq chi jumpech i ye'aab' Moreset-gat,</para>
  <para style="q">re' tinamit Aczib naa rukahniik chi je' jinaj xirob' chi keh i kireey i aj Israel.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' taq i hat aj Maresá wilik chik i chopol naah taq aaye'aab'</para>
  <para style="q">naa nu taq'aam reje, eh re' taqe i k'amal taq ab'eeh sik'ooj kiwach i hat taq aj Israel,</para>
  <para style="q">naa rojiik kikeb'aam kiib' paruhopil ab'aj wilik ar Adulam.</para>
  <para style="q">
    <verse number="16" style="v" />Re' taq i hat aj Sión chajohyaaj taq i rismaal aanaah</para>
  <para style="q">naa rukahniik chi je' rukab' i wach naah i k'ux</para>
  <para style="q">rehtaliil chi ti' taq ak'ux chikiij aatinamiit q'e' taqe inak'ax.</para>
  <para style="q">Ruum re' taq i hat naa taq ak'amariik reje pan tokoom tinamit, inki.</para>
  <chapter number="2" style="c" />
  <para style="s">Re' ti' k'axik naakik'ulum i kib'anik ti' k'axik keh i neb'aa'</para>
  <para style="q">
    <verse number="1" style="v" />Q'e' ti' i naakik'ulum i xa re' i yiib' wach na'ojb'al inkiyejaa' wach,</para>
  <para style="q">pan kiyokaab'.</para>
  <para style="q">Eh noq imponik i q'iij inki a'n wo' hoq,</para>
  <para style="q">ruum inkiq'or chi wilik kajaawriik.</para>
  <para style="q">
    <verse number="2" style="v" />Eh inkik'ax wach aak'al, i paat</para>
  <para style="q">tokoom ehchan reh, korehtaal inkiq'uch.</para>
  <para style="q">Eh chi je' ajaab'ees, chi je' ak'uunb'ees</para>
  <para style="q">inkelq'aaj i chib'ih reh.</para>
  <para style="q">
    <verse number="3" style="v" />Ruum aj re', re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' hin wilik i ti' k'axik nuyejaam wach taq cha weh</para>
  <para style="q">ma' naa ta rik'iik taq chawiij.</para>
  <para style="q">Eh ma' naa ta chik taq animb'isam awach,</para>
  <para style="q">ruum chupaam taqe i q'iij re' re' jinaj runimaal ti' k'axik naa ruchaliik taq cha naah.</para>
  <para style="q">
    <verse number="4" style="v" />Eh je' wili i naa kiq'orom taq chawiij</para>
  <para style="q">i ki-ixowinik taq awach:</para>
  <para style="q">Yu'naak q'e' ti' i k'ahchi' kik'ulum,</para>
  <para style="q">ruum xq'ucharik wo' chik keh i xkiq'uch i keh,</para>
  <para style="q">tokoom chik ehchan reh.</para>
  <para style="q">Eh ma' jino'q chik naa ruyej-anik</para>
  <para style="q">reh i ye'aab' xkehchaaj naq</para>
  <para style="q">xkich'aq wo' chik chikiwach</para>
  <para style="q">taqe i xiq'uchwik reh, inko'q taqe.</para>
  <para style="q">
    <verse number="5" style="v" />Ruum aj re', re' taq i hat ma' naa ta taq</para>
  <para style="q">awehtriik haa' chi kixilak i rutinamiit i QaJaaw Dios,</para>
  <para style="q">noq naa wo' chik ruch'aqariik keh i kiye'aab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' i tinamit je' wili ix kiq'or: Maa q'or qeh</para>
  <para style="q">taqe i q'orik i ruq'or i jalal ruq'oral i Dios,</para>
  <para style="q">ruum re' i Dios ma' nee ta ruk'ul cho qeh</para>
  <para style="q">i k'ixb'ilaal laj na'ojb'al inqa a'n,</para>
  <para style="q">
    <verse number="7" style="v" />¿Minakapaaj re' hat chi nee qoh ruq'eb'</para>
  <para style="q">chi riij ruk'ux i hoj, hoj aj Israel?</para>
  <para style="q">¿Mi neerub'an re' i je' re' i Dios</para>
  <para style="q">intoob'inik qeh i hoj rutinamiit?</para>
  <para style="q">¿Mi ma' nee taqe rutoob'eej re'</para>
  <para style="q">i korik wach kik'ux noq inaq'or i hat? inki taqe.</para>
  <para style="q">
    <verse number="8" style="v" />Eh re' i QaJaaw Dios je' wili i xuq'or keh:</para>
  <para style="q">Re' taq i hat xawixowaaj taq wach i nutinamiit,</para>
  <para style="q">inaq'uch taq i kiso' k'ih taq tz'aaq</para>
  <para style="q">i kisutinik cho panq'aq'inik,</para>
  <para style="q">inakapaaj taq chi ako'leem taq chik awiib'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' ixoq chi xilak i nutinamiit</para>
  <para style="q">inawesaj taq reje pankipaat,</para>
  <para style="q">aha' suq naq wilkeeb' wii', re' i kikok' ha'lak'uun</para>
  <para style="q">inakanaa' taq chi ma' xta ilil keh.</para>
  <para style="q">Eh ma' nayeew ta taq q'ab' chi kinkiloq'ej.</para>
  <para style="q">
    <verse number="10" style="v" />Re' taq i hat eleen taq reje chupaam i ye'aab' wili,</para>
  <para style="q">ruum ayu' ma' naa ta taq ahi'liik chuk'ulariik i ti' k'axik,</para>
  <para style="q">ruum yohb'aal wach i yiib' wach na'ojb'al imb'aan</para>
  <para style="q">ruum i re' naa rusachariik wach.</para>
  <para style="q">
    <verse number="11" style="v" />Wila' xk'uloq jino'q i chukul q'orik nee ruq'or</para>
  <para style="q">chi je' wili: chi hoj wach i vino,</para>
  <para style="q">i k'ahlaj ha' naa ruwihiik, inko'q ra'j re' re'</para>
  <para style="q">manlik aj k'uhb'alineel chi keh i tinamit, inki Dios.</para>
  <para style="q">
    <verse number="12" style="v" />Eh je' wo' chik wili i xuq'or: Re' hin naa wo' chik</para>
  <para style="q">numolom kiwach i Israel nik' chik k'ihaal</para>
  <para style="q">i xi kahnik, je' rukab' noq i molarik kiwach</para>
  <para style="q">i tentzun ar Bosra. Eh naa wo' chik nuye'em taqe</para>
  <para style="q">chupaam i ye'aab' nuye'em keh pampeet,</para>
  <para style="q">eh korehtaal wo' chik kik'ihaaxb'iik ar inki.</para>
  <para style="q">
    <verse number="13" style="v" />Eh re' i QaJaaw Dios naa rutehwiik reje kib'eeh,</para>
  <para style="q">eh re' keh naakitahqeem reje,</para>
  <para style="q">korehtaal kielik reje chi kixilak i tinamit i nixowanik kiwach.</para>
  <para style="q">Eh re' i kireey i QaJaaw naa ruk'amwiik reje kib'eeh chi kunchelaal.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' iruq'orariiki kimahk i k'amal kib'eeh i tinamit Israel</para>
  <para style="q">
    <verse number="1" style="v" />Re' i Miqueas je' wili i xuq'or:</para>
  <para style="q">Re' taq i hat i ti k'amwik kib'eeh i aj Israel, chab'iraj taq i naa nuq'orom aweh</para>
  <para style="q">¿Mi ma' ruk'ul naq taq cha weh re' chi re' chik nee taq i na a'n i rub'ehel?</para>
  <para style="q">
    <verse number="2" style="v" />Eh re' taq i hat inawixowaaj taq wach i holohik, re' i yiib' wach taq inak'ax wach.</para>
  <para style="q">Je' nanaach'ol taq i rutz'uhmal i kiij i nutinamiit,</para>
  <para style="q">eh je' inakanaa' taq wach saqum i kib'aqil ruum i ti' k'axik taq i na a'n keh.</para>
  <para style="q">
    <verse number="3" style="v" />Eh je' nanaak'ux taq</para>
  <para style="q">chi k'achlik kiwach i nutinamiit,</para>
  <para style="q">je' nanaach'ol taq i kitz'uhmal, je' nanaapaxej taq i kib'aqil.</para>
  <para style="q">Eh i na a'n taq keh je' rukab' i na a'n taq reh i tiwik inchaq'teesjik pan xun.</para>
  <para style="q">
    <verse number="4" style="v" />Eh pan jinaj ponoq q'iij nanaq chik aq'oreem taq i QaJaaw Dios,</para>
  <para style="q">re' reh ma' naa ta taq chik kaat rib'iram.</para>
  <para style="q">Ma' naa ta chik ruk'uhtaam i rotob'il taq cha naah,</para>
  <para style="q">ruum xiik' naah yib'kiil wach taq amahk.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' QaJaaw Dios je' wili i ruq'or:</para>
  <para style="q">Re' ink'amwik keh pamahk i nutinamiit re' i jalal nuq'oral inki a'n kiib'.</para>
  <para style="q">Re' keh inkiq'or rib'iral i rusuqkiil k'uxliis reh inye'wik kiwa',</para>
  <para style="q">eh re' ma' ye'wik ta kiwa' inkiq'or reh</para>
  <para style="q">chi naa ruchaliik i q'aq'inik chikinaah.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taq i hat ma' xta chik i naa nuk'uhtaam taq aweh</para>
  <para style="q">panasaq wiriik, chi riij taqe i naa ruk'ulariik.</para>
  <para style="q">Eh ma' xta chik taq i naa awilom,</para>
  <para style="q">naa ruq'equumriik paam taq aana'ojb'al,</para>
  <para style="q">je' rukab' noq inq'equumbrik i q'iij, inki.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' naq taqe i aj q'iij, taqe jalal nuq'oral inki a'n kiib'</para>
  <para style="q">naakik'uhtaam kik'ixb'ilaal,</para>
  <para style="q">xama' xta chik i naa kiq'orom,</para>
  <para style="q">noq naakilom chi ma' naa ta chik kichaq'weesjiik ruum i Dios.</para>
  <para style="q">
    <verse number="8" style="v" />Eh re' hin, hin nujinaq ruuk' i ruxlab'al i QaJaaw Dios,</para>
  <para style="q">i ruyeew nukowiil, i ruk'uhtaaj weh i korik,</para>
  <para style="q">reh chi neenuq'or keh panaq' kiwach i aj Israel</para>
  <para style="q">re' taqe i riih rumaam i Jacob chi korik chi ma' nkinimaj ta chik i QaJaaw Dios,</para>
  <para style="q">chi ma' k'isiin i mahk inki a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Chab'iraj i naa nuq'orom taq i hat k'amal kib'eeh i aj Israel,</para>
  <para style="q">je' wo' taq i hat i nimaq taq wach ana'ojb'al.</para>
  <para style="q">Re' taq i hat ma' holohik ta taq inawilow taqe i holohik,</para>
  <para style="q">re' i holohik re' taq i re' i naasutej chi ma' holohik taj.</para>
  <para style="q">
    <verse number="10" style="v" />Inayeew taq runimaal wach i Sión ruuk' ikaansanik taq i na a'n.</para>
  <para style="q">Eh re' i Jerusaleem ruuk' taqe i yiib' wach na'ojb'al taq i nayeew runimaal wach.</para>
  <para style="q">
    <verse number="11" style="v" />Eh re' taqe i q'atal q'orik inkik'ul i tumiin chi riij i chukuj q'orik.</para>
  <para style="q">Re' taqe i k'amal kib'eeh aj tiij koruuk' tumiin inki a'n i k'uhb'alinik.</para>
  <para style="q">Eh re' taqe i jalal ruq'oral i Dios inki a'n kiib' koruuk' tumiin inkiq'or</para>
  <para style="q">i k'uhb'aal, eh inkiq'or chi reh i Dios inki a'n je' wili inkiq'or:</para>
  <para style="q">Re' i QaJaaw Dios wilik quuk'</para>
  <para style="q">ma' xtaj i yiib' wach neenchalik chi qanaah, inki taqe.</para>
  <para style="q">
    <verse number="12" style="v" />Eh awuum taq i hat i Jerusaleem,</para>
  <para style="q">i tinamit wilik chinaah i yuuq' Sión</para>
  <para style="q">naa rukahniik chi ma' xta chik i wilik chupaam xa je' chik jino'q ab'iixb'al,</para>
  <para style="q">naakich'alojiik i wilkeeb' chupaam.</para>
  <para style="q">Eh re' yuuq' wilik wii' i rupaat i QaJaaw Dios</para>
  <para style="q">naa rupoq'iik chaloq i yiib' kiwach ch'ahn chinaah.</para>
  <chapter number="4" style="c" />
  <para style="s">Re' i QaJaaw Dios xuq'or chi naa wo' chik ruye'em keh i suq laj k'acharik i rutinamiit</para>
  <para style="r">(<ref loc="ISA 2:1-4">Isa 2.1-4</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />Eh naa ruponiik i q'iij chi re' xti manlik</para>
  <para style="q">i rupaat i QaJaaw Dios wilik chinaah i yuuq',</para>
  <para style="q">re' re' q'e' naa ruwihiik runimaal wach chikiwach chu'nchel i yuuq' najt kinaah,</para>
  <para style="q">eh ma' k'isiin i tinamit wilkeeb' sut i wach ak'al naa kojiik chi rilariik.</para>
  <para style="q">
    <verse number="2" style="v" />Eh re' i tinamit, je' wili i naa kiq'orom: Kim taq qojohtoq chinaah i yuuq'</para>
  <para style="q">i wilik wii' i rupaat i QaJaaw</para>
  <para style="q">re' i ruDios i Jacob, reh chi nee ruk'uhtaaj qeh i rub'eeh,</para>
  <para style="q">eh naaqak'am naah i nee ruq'or qeh, inko'q taqe.</para>
  <para style="q">Ruum ar Sión</para>
  <para style="q">naa reliik chaloq i ruk'uhb'aal i Dios,</para>
  <para style="q">eh Jerusaleem naa reliik chaloq i ruq'oral.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i QaJaaw Dios naa ruq'atwiik i q'orik chikinaah i tinamit,</para>
  <para style="q">eh naa ruq'ilim taqe i nimaq tinamit kow kiib',</para>
  <para style="q">i wilkeeb' chi najt yuuq'. Eh re' kich'ihch' k'ul q'as</para>
  <para style="q">naakisutem chi reh arado,</para>
  <para style="q">re' i kich'ihch' q'as ju' macheet chik naakisutem wii'.</para>
  <para style="q">Eh ma' jino'q chik i tinamit naakikansam kiib' ruuk' ch'ihch',</para>
  <para style="q">ma' naa ta chik kitijiik reh i q'aq'inik.</para>
  <para style="q">
    <verse number="4" style="v" />Re' i ju'jun chi patineel naa kik'achariik</para>
  <para style="q">pansuqkiil k'uxliis naa ruwihiik kitik re' ruuk' i uuva, re' ruuk' i higo.</para>
  <para style="q">Eh ma' awach ta chik naa ruyohb'isaniik keh,</para>
  <para style="q">ruum je' re' i xuq'or i QaJaaw Dios nim rajaawriik.</para>
  <para style="q">
    <verse number="5" style="v" />Atoob' ta re' taqe i tokoom tinamit</para>
  <para style="q">re' taqe i kitiyoox neenkinimaj,</para>
  <para style="q">Eh re' hoj xama' naa ta wo' qakanaam</para>
  <para style="q">runimjiik i k'achlik Dios re' i QaJaaw.</para>
  <para style="s">Re' i QaJaaw Dios xuq'or chi naa wo' chik ruko'leem i rutinamiit</para>
  <para style="q">
    <verse number="6" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' hin naa ruponiik i q'iij noq naa numolom kiwach i nutinamiit,</para>
  <para style="q">re' taqe i xnuq'eb' naq taqe chi riij nuk'ux,</para>
  <para style="q">i xnutukej kiwach, eh xnutib'isaj kik'ux.</para>
  <para style="q">
    <verse number="7" style="v" />Re' i xkitukej kiib' re' re'</para>
  <para style="q">je' rukab' noq inkitukej kiib' taqe i tentzun,</para>
  <para style="q">naa numolom kiwach, naa nukanaam taqe chi jinaj tinamit wilik kajaawriik.</para>
  <para style="q">Eh re' i Dios nim rajaawriik naa nuwihiik chi reyil</para>
  <para style="q">chikinaah chi juneliik chinaah i yuuq' Sión.</para>
  <para style="q">
    <verse number="8" style="v" />Re' i hat i Jerusaleem, hat naa acha'jiniik keh,</para>
  <para style="q">naa aye'em rukowiil kik'ux i wilkeeb' nah yuuq' Sión</para>
  <para style="q">je' rukab' i rub'an reh i rutentzuun i aj cha'jen tentzun.</para>
  <para style="q">Re' hat naa akahniik chi chopen naah taqe i tinamit,</para>
  <para style="q">eh naa wo' chik ruwihiik runimaal wach je' rukab' i pampeet.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Eh yu'naak ¿Chib'ih reet noq inak'er taq aachii',</para>
  <para style="q">je' rukab' ixoq noq ink'ulik ruk'ux?</para>
  <para style="q">¿Mi ruum re' chi xsacharik kiwach taqe aareey?</para>
  <para style="q">¿Mi ruum re' chi xsacharik kiwach taqe i kikojwik taq ana'ojb'al?</para>
  <para style="q">
    <verse number="10" style="v" />Ti oq'oq taq, cha k'er taq aachii' i wilkaat taq Sión,</para>
  <para style="q">je' rukab' noq inoq'ik ixoq noq ink'ulik ruk'ux.</para>
  <para style="q">Cha yot' taq ak'ux ruum naa taq awehteesjiik reje pana tinamit,</para>
  <para style="q">naa taq awojiik chi patinik panab'iix,</para>
  <para style="q">korehtaal taq ti ponik Babilonia.</para>
  <para style="q">Eh re' hin naa nuko'liik taq aweh,</para>
  <para style="q">naa wesaniik taq aweh pan kiq'ab' i ki-ixowanik taq awach.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Yu'naak ma' k'isiin i tinamit xkimol kiib' chi naa taq kaat kipletoheem,</para>
  <para style="q">je' wili inkiq'or: Yu'naak naa qasacham kiwach taqe i aj Jerusaleem</para>
  <para style="q">ma' xta chik i neenkahnik, inki taqe.</para>
  <para style="q">
    <verse number="12" style="v" />Re' i tinamit re' re' ma' keht'al taj chib'ih i nukapaaj i hin,</para>
  <para style="q">chib'ih i nuyejaam wach, ma' keht'al taj chi re' hin naa numolwiik kiwach reh</para>
  <para style="q">kiye'ariik panti' k'axik naa nub'anam keh</para>
  <para style="q">je' rukab' noq imb'ak'arik paam i trigo reh i rupotz'ariik.</para>
  <para style="q">
    <verse number="13" style="v" />Eh re' taq i hat aj Sión cha yejaa' taq awiib', ruum re' hin naa taq nuye'em akowiil,</para>
  <para style="q">naa taq nuye'em awansil chi je' jino'q imas wakax,</para>
  <para style="q">je' naa nanukojom taq aawuk'aa' chi ch'ihch'</para>
  <para style="q">je' naa nukojom taq awixk'aq chi q'an ch'ihch',</para>
  <para style="q">reh chi ma' k'isiin i tinamit taq naa asacham kiwach.</para>
  <para style="q">Eh naa taq aq'uchum i chib'ih keh, weh hin taq chik naa aye'em, inki i Dios.</para>
  <chapter number="5" style="c" />
  <para style="s">Re' i naa rukahniik chi reyil chinaah i tinamit Israel Belén naa reliik chaloq</para>
  <para style="q">
    <verse number="1" style="v" />Re' taq i hat aj Jerusaleem cha yejaa' taq ko'lb'al awiib'</para>
  <para style="q">ruum xkikotej taq chik riij aatinamiit.</para>
  <para style="q">Re' keh ruuk' karote naakiq'ojom</para>
  <para style="q">noq naakiye'em panti' k'axik ink'amwik qab'eeh i hoj aj Israel.</para>
  <para style="q">
    <verse number="2" style="v" />Eh re' i hat tinamit Belén Efrata</para>
  <para style="q">ma' re' ta nkiwii' chi q'e' hat k'isiin chikiwach</para>
  <para style="q">i tinamit wilkeeb' paruyuq'ul i Judá,</para>
  <para style="q">awuuk' la' hat naa reliik chaloq jinaj i k'amal b'eeh</para>
  <para style="q">naa rucha'jiniik reh i nutinamiit Israel,</para>
  <para style="q">re' i xa wilik wo' chaloq najtir q'iij.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i QaJaaw Dios naa pee</para>
  <para style="q">rukanaam chi naakik'ulum i ti' k'axik</para>
  <para style="q">i rutinamiit kore' naa risam i ti' k'axik,</para>
  <para style="q">noq naa rasjiik jinaj i k'ahchi' ruyub'jiik,</para>
  <para style="q">re' naa rokiik chi reyil. Eh naa rumolom kiwach kuuk'</para>
  <para style="q">i kuch aj Israel i konaakikahniik chi k'achalkeeb'.</para>
  <para style="q">
    <verse number="4" style="v" />Eh re' i reey re' re' naa rokiik chi cha'jen keh i rutinamiit</para>
  <para style="q">ruuk' i runimaal i rajaawriik i ruDios.</para>
  <para style="q">Eh ruuk' i runimaal wach i rub'ihnaal</para>
  <para style="q">pansuqkiil k'uxliis chik naa kik'achariik i rutinamiit,</para>
  <para style="q">ruum re' reh naa ruye'em chee rajaawriik chi junsuut i wach ak'al.</para>
  <para style="q">
    <verse number="5" style="v" />Eh re' reh naa ruye'em suq kiil qak'ux i hoj,</para>
  <para style="q">naakooj ruko'leem pan kiq'ab' i aj Asiria</para>
  <para style="q">noq naa kichopom naah i paat imb'aan wii' i q'ataj q'orik.</para>
  <para style="q">Eh re' hoj wuquub' i aj cha'joom naa qataq'aam chi kik'ulb'ejiik,</para>
  <para style="q">eh waxiqiib' i winaq nimaq wach kina'ojb'al naa qataq'aam reje.</para>
  <para style="q">
    <verse number="6" style="v" />Eh re' taqe i winaq re' re', naa kojiik chi kik'ulb'ejiik i aj Asiria</para>
  <para style="q">noq ruuk' q'aslaj ch'ihch', naa kia'nam reh i aj Nimrob.</para>
  <para style="q">Naa koj kiko'leem pan kiq'ab' i aj Asiria</para>
  <para style="q">naa kokiik cho chi qapletohjik paruk'ula'tiil i qatinamiit,</para>
  <para style="q">reh chi naa kichopom naah i qa ye'aab'.</para>
  <para style="q">
    <verse number="7" style="v" />Re' taqe i aj Israel ma' naa ta kikanteesjiik,</para>
  <para style="q">je' mus jab' chi keh i tinamit</para>
  <para style="q">je' rukab' i jab' noq i rut'aqsaj chaloq i tik mu'uun</para>
  <para style="q">i rutaq'aaj chaloq i QaJaaw Dios.</para>
  <para style="q">Re' taqe i ma' kuye-eej taj inkaaj i winaq,</para>
  <para style="q">re' kuye-eej iraaj i QaJaaw Dios.</para>
  <para style="q">
    <verse number="8" style="v" />Eh re' taqe i aj Israel ma'</para>
  <para style="q">naa ta kikanteesjiik naa kikahniik chi,</para>
  <para style="q">q'e' kow kiib' chi kixilak i tinamit.</para>
  <para style="q">Eh je' kikab' i josq' laj kaq b'ahlam chi kixilak</para>
  <para style="q">i johsq' laj chikop wilkeeb' pantaq ch'ahn,</para>
  <para style="q">eh ma' jino'q i naa ruko'leem riib'</para>
  <para style="q">pan kiq'ab' i aj Israel, je' rukab' i rub'an</para>
  <para style="q">i kaq b'ahlam noq i ruk'uxib'eej</para>
  <para style="q">taqe i tentzun ma' jino'q chik i rukanaa'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' taq i hat aj Israel naa taq aq'atam</para>
  <para style="q">kiwach i ki-ixowanik taq awach,</para>
  <para style="q">eh naa taq rukuxiik asacham kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Eh re' i QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' hin naa ruponiik i q'iij noq naa nuye'em</para>
  <para style="q">q'ab' chi naa kikanteesjiik taqe aakawayu,</para>
  <para style="q">eh chi naa rusachariik kiwach i aakareta reh q'aq'inik.</para>
  <para style="q">
    <verse number="11" style="v" />Eh naa nusacham wach taq aatinamiit,</para>
  <para style="q">eh chi naa kiyojib'eem taq animaq taq paat i naa ko'leej naq taq wii' awiib'.</para>
  <para style="q">
    <verse number="12" style="v" />Naa wo' nusacham kiwach taqe i aj war,</para>
  <para style="q">je' wo' taqe aj q'iij wilkeeb' taq chaxilak.</para>
  <para style="q">
    <verse number="13" style="v" />Naa wo' nusacham kiwach</para>
  <para style="q">i tiyoox holohaq ab'aj korjinaq wii',</para>
  <para style="q">reh chi ma' nee ta chik taq inaloq'ej chi jumpech taq</para>
  <para style="q">atiyoox xa hat taq titz'awik reh.</para>
  <para style="q">
    <verse number="14" style="v" />Naa wo' rusahchiik kiwach</para>
  <para style="q">taqe i tiyoox Asera rub'ihnaal</para>
  <para style="q">je' wo' chu'nchel i tinamit wilkeeb' wii'.</para>
  <para style="q">
    <verse number="15" style="v" />Re' hin ruum i nujosq'iil</para>
  <para style="q">naa nuye'em taqe chutojariik i kimahk</para>
  <para style="q">i ju'junseht chi tinamit ma' xkaaj</para>
  <para style="q">ta kinimam i nuk'uhb'aal, inki Dios.</para>
  <chapter number="6" style="c" />
  <para style="s">Re' i ti' k'axik xchalik chikinaah i aj Israel ruum i kiyiib' wach na'ojb'al</para>
  <para style="q">
    <verse number="1" style="v" />Eh re' taq i hat aj Israel chab'iraj taq i ruq'or i QaJaaw Dios chi je' wili:</para>
  <para style="q">chayuq'eej taq awuuk' taqe i yuuq', cha q'or taq chi korik chi</para>
  <para style="q">wilik taq amahk, ponoq chinaah taqe yuuq' taq aq'oral.</para>
  <para style="q">
    <verse number="2" style="v" />Chab'iraj taq i hat yuuq' k'ixkaab'</para>
  <para style="q">chi re' i hin Dios k'ahchi' nujosq'iil kuuk' i nutinamiit Israel</para>
  <para style="q">naa nuq'atam q'orik chikinaah ruum i kimahk inki.</para>
  <para style="q">
    <verse number="3" style="v" />Eh je' wo' chik wili i xuq'or i QaJaaw Dios:</para>
  <para style="q">hat taq nutinamiit ¿Chib'ih i ma' holohik taj xub'an taq aweh,</para>
  <para style="q">eh chib'ih taq xat nuch'itaaj wii'? Inwaaj taq chi neenaq'or weh.</para>
  <para style="q">
    <verse number="4" style="v" />Re' hin ma' xta xinq'ehb'ik taq wii' chawach,</para>
  <para style="q">re' hin xineesanik taq cha weh panti' k'axik Egipto.</para>
  <para style="q">Re' noq xnutaq'aaj taq reje chawehteesjiik i Moisés</para>
  <para style="q">i Aarón, i María, reh chi xkik'am taq cha b'eeh.</para>
  <para style="q">
    <verse number="5" style="v" />Re' taq i hat nutinamiit k'oloq taq panak'ux</para>
  <para style="q">chib'ih xat rutaqchi'ij taq cho wii' i Balac, kireey i aj Moab.</para>
  <para style="q">Eh chib'ih xat ruchaq'weej wii' i Balaam rak'uun i Beor,</para>
  <para style="q">eh chib'ih taq i xak'ul noq xat ik'ik taq ar Sitim, eh Gilgal.</para>
  <para style="q">Re' hin xintoob'inik taq aweh,</para>
  <para style="q">ruum aj re' ma' xta taq xak'ul, inki Dios.</para>
  <para style="s">Re' i rupahqaaj i Dios chi naa ruye'ariik reh</para>
  <para style="q">
    <verse number="6" style="v" />¿Chib'ih jariik i ruk'ul chi naaqaye'em reh i QaJaaw Dios,</para>
  <para style="q">nik' wach rulooq'jiik naa qa'nam?</para>
  <para style="q">¿Mi re' chi neenuyeew i k'atoj mayiij chuwach,</para>
  <para style="q">oon re' chi nee nuk'am reje chi numayiij</para>
  <para style="q">i peet rak'uun i nuwakax jinaj haab' i wilik reh?</para>
  <para style="q">
    <verse number="7" style="v" />¿Mi neensuuqb'ik ruk'ux re' i QaJaaw noq</para>
  <para style="q">neenuyeew chi numayiij i ruk'ihaal q'ina' laj imas tentzun?</para>
  <para style="q">Eh ¿Mi neensuuqb'ik ruk'ux re' chi neenuyeew</para>
  <para style="q">chi numayiij chuwach i xata wo' jarub' lemeta chi aseite?</para>
  <para style="q">¿Mi neerukuy re' i numahk chi neenuyeew</para>
  <para style="q">chi numayiij chuwach i peet wak'uun?</para>
  <para style="q">
    <verse number="8" style="v" />Re' i QaJaaw Dios ma' re' ta taqe re' iraaj,</para>
  <para style="q">re' i rupahqaaj aweh i QaJaaw Dios i hat re' taqe i wili:</para>
  <para style="q">Re' chi naa a'nam taqe i ruk'ul chi b'anarik,</para>
  <para style="q">eh chi naa ruwihiik i ketelinik wachiis awuuk',</para>
  <para style="q">re' chi naa aloch'om awiib' chi runimjiik aaDios.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' i QaJaaw Dios k'achi' taq kaat ruq'oreem</para>
  <para style="q">panatinamiit, wilik runa'ojb'al awach</para>
  <para style="q">inyohlinik reh aab'ihnaal. Eh chakoj taq rehtaal</para>
  <para style="q">awach inaakiye'ariik chutojariik i kimahk,</para>
  <para style="q">eh awach naa ruye'wiik keh chutojariik i kimahk.</para>
  <para style="q">
    <verse number="10" style="v" />Re' i yiib' wach runa'ojb'al ma' k'isiin</para>
  <para style="q">i rub'ehomal wilik xa ruuk' i leq' rureqem tz'aaq,</para>
  <para style="q">eh re' i rupexu ma' manlik ta impajwik, re' taqe re' ma' imponik ta chi nuwach i hin.</para>
  <para style="q">
    <verse number="11" style="v" />Eh ¿Nik' wach noq neenukuy ru mahk inelq'anik ruuk' i rupexu i rukoj chi pajb'al,</para>
  <para style="q">eh ma' manlik ta impajwik?</para>
  <para style="q">
    <verse number="12" style="v" />Re' taqe i b'ehomaq wilkeeb' chupaam i tinamit wili inkelq'aaj chib'ih reh i neb'aa',</para>
  <para style="q">eh xa re' i chukuj q'orik inkaaj,</para>
  <para style="q">xa re' i rujot'ariik i kitinamiit inki a'n</para>
  <para style="q">
    <verse number="13" style="v" />Re' hin naa taq kaat nuye'em chutojariik taq amahk,</para>
  <para style="q">eh naa taq nusacham awach ruum taq amahk i na a'n.</para>
  <para style="q">
    <verse number="14" style="v" />Naa wo' naq taq a'nam awa' ahaa'</para>
  <para style="q">xama' naa ta wo' taq anujiik, xama' naa ta wo' taq amayam i kuyuj wi'k.</para>
  <para style="q">Eh naa wo' naq taq amolom chib'ih aweh</para>
  <para style="q">xama' naa ta wo' taq akolom riij, eh wila' xakol taq riij,</para>
  <para style="q">aj q'aq'ineel naa kisachwik wach.</para>
  <para style="q">
    <verse number="15" style="v" />Eh naa wo' naq taq atikim chib'ih aweh</para>
  <para style="q">xama' naa ta wo' kiwachiniik,</para>
  <para style="q">naa wo' naq taq ake'em wach i aseituna xama' xta wo' taq aseite naa awisam.</para>
  <para style="q">Eh naa wo' naq taq ayeq'em paam i uuva xama' xta wo' taq i riis naa awuk'em.</para>
  <para style="q">
    <verse number="16" style="v" />Ruum xak'am taq naah i ruk'uhb'aal,</para>
  <para style="q">eh aha' wilik i rub'an i reey Omri rub'ihnaal,</para>
  <para style="q">je' wo' hoq i rub'an i reey Acab,</para>
  <para style="q">xa a'n taq aweh inki a'n i keh.</para>
  <para style="q">Re' hin naa nub'anam ti' k'axik taq aweh,</para>
  <para style="q">naa taq ak'uhtaam ak'ixb'ilaal taq i hat i aj Jerusaleem,</para>
  <para style="q">ruum ma' xinanimaj ta taq, inki i Dios.</para>
  <chapter number="7" style="c" />
  <para style="s">Re' i yiib' wach na'ojb'al xkian i aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin q'e' ketel nuwach, ruum je' rukab' i winaq i rusik' i wach i rutik paruq'ijil,</para>
  <para style="q">ma' xta chik wach noq xponik,</para>
  <para style="q">rusik' naq chik i wach i ru-uuva sik'ooj chik noq xponik.</para>
  <para style="q">Eh re' naq i peet wach i rutik xraaj ruk'uxum</para>
  <para style="q">xama' xureq ta wo' hoq</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin je' re' i k'ahchi' nuk'ulum, ruum ma' xta ketelinik wachiis wach ak'al</para>
  <para style="q">ruum ma' jino'q chik i korik wach ruk'ux.</para>
  <para style="q">Xak'ul inkikansaj kiib' chikiwach,</para>
  <para style="q">k'ul inkikoj xirob' pankib'eeh.</para>
  <para style="q">
    <verse number="3" style="v" />Eh inkik'uhtaaj i yiib' wach na'ojb'al,</para>
  <para style="q">re' taqe ajaab'ees inkaaj chi wilik i naa ruye'ariik keh chi riij inki a'n</para>
  <para style="q">Eh re' taqe i q'atal q'orik inkik'ul i tumiin chi riij i chukuj q'orik.</para>
  <para style="q">Re' taqe wilik kajaawriik, inki a'n i chib'ih inkaaj i keh,</para>
  <para style="q">eh inkiq'or chi re' re' i korik.</para>
  <para style="q">
    <verse number="4" style="v" />Re' i chihooj runa'ojb'al chi kixilak je' rukab' i k'iix.</para>
  <para style="q">Eh re' i korik wach kik'ux je' rukab' i koraal k'iix,</para>
  <para style="q">eh ponik reh q'iij chi naa kiye'ariik panti' k'axik,</para>
  <para style="q">re' i naa kiq'orom rib'iral aj cha'joom.</para>
  <para style="q">Ar aj re' ma' naa ta chik kireqem chi riij chib'ih i naa kianam.</para>
  <para style="q">
    <verse number="5" style="v" />Eh ma' nimaj i ruq'or awamigo.</para>
  <para style="q">Eh ma' naa ta ach'ikaam ak'ux kuuk' i k'amal b'eeh,</para>
  <para style="q">eh atoob' ta ruuk' awehk'een neena a'n</para>
  <para style="q">ak'utaaj chawik'raaj awiib' ruuk' i naa aq'orom.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taqe ak'uunb'ees naakixowaam wach i kajaaw,</para>
  <para style="q">re' taqe ixq'uunb'ees ma' naa ta chik kinimam i kituut.</para>
  <para style="q">Eh re' taqe i ilib'jeel naakixowaam wach i rutuut</para>
  <para style="q">i kib'ahiil, re' i naa rixowaniik kiwach i ju'jun,</para>
  <para style="q">re' taqe i awach keh pankipaat.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' hin naawuy-eem i rotob'il i QaJaaw Dios,</para>
  <para style="q">ruuk' i reh naa nuch'ikaam i nuk'ux, ruum weht'al chi re' reh</para>
  <para style="q">naa ruko'liniik weh, eh naa kiin rib'iram.</para>
  <para style="s">Re' i QaJaaw Dios xuketelaaj wo' chik kiwach i aj Israel</para>
  <para style="q">
    <verse number="8" style="v" />Re' taq i hat i ti ixowinik taq qawach,</para>
  <para style="q">ma' nsuuqb'ik taq ak'ux ruuk' i k'ahchi' qak'ulum.</para>
  <para style="q">Atoob' ta xqaq'eb' q'iib', naa wo' chik qik'raam q'iib'.</para>
  <para style="q">Atoob' ta panq'equm wilkooj naa wo' chik kooj rusihq'eem, i QaJaaw Dios.</para>
  <para style="q">
    <verse number="9" style="v" />Eh korik chi xoj mahkunik chuwach i QaJaaw Dios,</para>
  <para style="q">ruum aj re' xanaa chik qakuyum i rujosq'iil,</para>
  <para style="q">korehtaal i ruq'at i q'orik chi qanaah re' rub'ehel naa rub'anam quuk'.</para>
  <para style="q">Eh naakooj risam panq'equm,</para>
  <para style="q">ar naa qilom chi re' reh re' i rikorkiil i rub'an quuk'.</para>
  <para style="q">
    <verse number="10" style="v" />Re' i ki-ixowinik qawach naakilom i keh,</para>
  <para style="q">ruum i re' naa ruchaliik kik'ixiik, re' i kiq'orik qeh chi je' wili:</para>
  <para style="q">¿Aha' wilik i ki Dios inkiq'or? inki taqe.</para>
  <para style="q">Eh naakilom chi naa rehtesjiik i kajaawriik,</para>
  <para style="q">naa rub'aan keh je' rukab' noq</para>
  <para style="q">inye'q'arik paam i ch'uwa' pantaq b'eeh.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' taq i hat i aj Jerusaleem naa ruponiik</para>
  <para style="q">i q'iij chi naa wo' chik ruyejeb'jiik i tz'aq chi riij taq aatinamiit,</para>
  <para style="q">eh naa wo' chik ruk'ihaaxb'iik taq aa ye'aab'.</para>
  <para style="q">
    <verse number="12" style="v" />Eh chupaam taqe i q'iij re' re',</para>
  <para style="q">wilik taqe i re' ruuk' taq aatinamiit naa kichaliik Asiria, naa kichaliik Egipto,</para>
  <para style="q">naa kichaliik chi chii' i nim haa' Nilo, naa kichaliik chi chii' i ha' Éufrates.</para>
  <para style="q">Eh wilik naa kichaliik chi chii' taqe palaw, naa kichaliik chinaah taqe i yuuq'.</para>
  <para style="q">
    <verse number="13" style="v" />Re' i aj Israel xkahnik chi ma' xta chik i</para>
  <para style="q">wilik chupaam i kitinamiit, ruum i kimahk xkian.</para>
  <para style="q">Re' re' i xuk'am chaloq i kiyiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="14" style="v" />QaJaaw Dios chawil tii aatinamiit, ruuk' awajaawriik,</para>
  <para style="q">je' rukab' i rub'an cha'jen tentzun</para>
  <para style="q">i ruyeew taqe i rutentzuun wilik wii' i ch'ahn inkik'ux.</para>
  <para style="q">Eh chayeew wo' chik taqe aatinamiit chupaam i ye'aab' Basán,</para>
  <para style="q">chupaam i ye'aab' Galaad.</para>
  <para style="q">Chayeew wo' chik keh i suq laj wihik,</para>
  <para style="q">je' rukab' noq xi wihik cho ar pampeet.</para>
  <para style="q">
    <verse number="15" style="v" />Chak'uhtaaj tii chikiwach i ma' ilooj taj</para>
  <para style="q">je' rukab' i xak'uhtaaj chikiwach i qamaam qati't,</para>
  <para style="q">noq xawesaj taqe chaloq Egipto.</para>
  <para style="q">
    <verse number="16" style="v" />Eh noq neenkilow taqe i wilkeeb' pan</para>
  <para style="q">taq nimaq tinamit chi je' re', neenchalik kik'ixiik.</para>
  <para style="q">Eh neenkikahyeej i ju' kiq'ab', nee kikahnik meem,</para>
  <para style="q">eh neenkahnik chi tz'aplik i kixikin</para>
  <para style="q">
    <verse number="17" style="v" />Eh nee kikahnik chi xa je' chik rukab'</para>
  <para style="q">taqe i aaq' noq inkitolej kiib' pampooq,</para>
  <para style="q">oon je' kikab' taqe i xa chib'ih chik chopkaal noq xakib'arb'otik chik</para>
  <para style="q">ruum kiyo'jiik noq nee tikisik',</para>
  <para style="q">ruum xa re' wo' hat, hat qaDios.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />¿Mi wilik chik jino'q Dios chi je' rukab' i hat?</para>
  <para style="q">ma' xtaj, ruum re' hat insahchik panak'ux</para>
  <para style="q">chi ma' xat kinimaj taj i ruqox aatinamiit wili.</para>
  <para style="q">Eh i nakuy kimahk, eh xti korik noq inak'uhtaaj qeh aak'axb'al</para>
  <para style="q">ma' juneliik ta i nayeew aajosq'iil chi qanaah.</para>
  <para style="q">
    <verse number="19" style="v" />QaJaaw Dios, chaketelaaj wo' chik qawach,</para>
  <para style="q">sahchoq panak'ux i qayiib' wach na'ojb'al.</para>
  <para style="q">Eh chawesaj reje chi qawach chi jumpech taqe i qamahk,</para>
  <para style="q">chakut qohoq ko paruchamiil i palaw.</para>
  <para style="q">
    <verse number="20" style="v" />QaJaaw Dios, eliik chayeew qeh awotob'il,</para>
  <para style="q">i ketelinik wachiis,</para>
  <para style="q">je' rukab' aq'orom cho keh</para>
  <para style="q">i qamaam qati't najtir q'iij, re' i Abraham, i Jacob.</para>
</usx>