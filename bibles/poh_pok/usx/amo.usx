<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="AMO" style="id">AMOPOK.SFK 15-05-2,006 Adelina Quej Xoy. Pokomchi Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">AMÓS</para>
  <para style="toc3">Amo</para>
  <para style="toc2">Amo</para>
  <para style="toc1">AMOS</para>
  <para style="mt2">RE' I RUHUUJ I AMÓS</para>
  <para style="mt1">AMÓS</para>
  <chapter number="1" style="c" />
  <para style="s">Re' ti' k'axik xiye'arik wii' taqe i tinamit wilkeeb' chi junsuut Israel</para>
  <para style="p">
    <verse number="1" style="v" />Re' Amós i xwihik chi cha'jen tentzuun chupaam i ye'aab' Tecoa, je' wili i k'uhb'aal xuk'ul ruuk' i QaJaaw Dios, chikiij i aj Israel. Re' noq pan kiib' haab' i rub'an i yihk, re' noq xwihik chi reyil Judá i Uzías, re' noq xwihik chi reyil Israel i Jeroboam rak'uun i Joás. <verse number="2" style="v" />Re' QaJaaw Dios ruuk' k'aah xuq'or chi je' wili:</para>
  <para style="b" />
  <para style="q">Chinaah i yuuq' Sión wilik Jerusaleem:</para>
  <para style="q">Re' taqe i chee' k'ahaam naakichiqiik,</para>
  <para style="q">eh naakichiqiik i k'im wilkeeb' chuwach i yuuq' Carmelo.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' QaJaaw Dios je' wili xuq'or: Re' taqe i aj Damasco ma' k'isiin i mahk xkian,</para>
  <para style="q">ruum i re' naa nuye'em taqe chutojariik i kimahk.</para>
  <para style="q">Eh xkian i ti' k'axik reh i tinamiit Galaad</para>
  <para style="q">je' rukab' noq inq'ojarik paam i trigo chi ch'ihch' xkian reh.</para>
  <para style="q">
    <verse number="4" style="v" />Ruum aj re', re' hin naa nukojom ruq'aq'al</para>
  <para style="q">i rupaat i reey Hazael, eh naa ruk'ahtiik i paat</para>
  <para style="q">i rub'an wii' taaq'anik i reey Ben-hadad.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' hin naa nuq'eb'em taqe i ru puertahiil i tinamit Damasco,</para>
  <para style="q">naa nusacham kiwach, i aj wach k'ixkaab' Avén.</para>
  <para style="q">Eh re' i wilik chi taaq'anik Bet-edén naa nusacham wach.</para>
  <para style="q">Re' taqe i aj Siria naa kik'amariik reje pankowlaj kamanik pan tinamit Qir, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' taqe i aj Gaza ma' k'isiin i mahk xkian,</para>
  <para style="q">ruum aj re' naa nuye'em taqe chutojariik i kimahk.</para>
  <para style="q">Re' keh xkik'ayej reje pankowlaj kamanik</para>
  <para style="q">i nutinamiit pan tinamit Edom.</para>
  <para style="q">
    <verse number="7" style="v" />Ruum aj re', re' hin naa nukojom ruq'aq'al i tz'aq kotimaj wii' riij i tinamit Gaza,</para>
  <para style="q">naa ruk'ahtiik taqe i paat imb'aan wii' i taaq'anik.</para>
  <para style="q">
    <verse number="8" style="v" />Eh naa wo' nusacham kiwach i aj Asdod.</para>
  <para style="q">Je' wo' taqe i wilkeeb' chi taaq'anik chinaah i tinamit Ascalón,</para>
  <para style="q">eh naa wo' nusacham kiwach tinamit Ecrón,</para>
  <para style="q">je' wo' chu'nchel i aj filisteo, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' taqe i aj Tiro ma' k'isiin i mahk xkian,</para>
  <para style="q">ruum aj re', re' hin naa nuye'em taqe chi tojariik</para>
  <para style="q">i kimahk. Ruum xkiq'asaj pankowlaj kamanik</para>
  <para style="q">i nutinamiit ar Edom, ma' xkik'am ta kiib'</para>
  <para style="q">pansuqkiil chi xa kas kichaaq' kiib'</para>
  <para style="q">je' naq rukab' i kiyejaam wach.</para>
  <para style="q">
    <verse number="10" style="v" />Ruum aj re', re' hin naa nukojom ruq'aq'al i tz'aq</para>
  <para style="q">kotimaj wii' riij i tinamit Tiro, eh naa ruk'ahtiik</para>
  <para style="q">taqe i paat imb'aan wii' taaq'anik, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' taqe i aj Edom ma' k'isiin i mahk xkian,</para>
  <para style="q">ruum aj re' naa nuye'em taqe chutojariik i kimahk.</para>
  <para style="q">Re' keh yohb'aal wach i kijosq'iil,</para>
  <para style="q">ruuk' q'aslaj ch'ihch' xkikansaj i kas kichaaq'</para>
  <para style="q">aj Israel ma' xkiketelaaj ta wach.</para>
  <para style="q">
    <verse number="12" style="v" />Ruum aj re', re' hin naa nu kojom ruq'aq'al</para>
  <para style="q">i tinamit Temán, eh naa wo' ruk'ahtiik</para>
  <para style="q">taqe i paat imb'aan wii' i taaq'anik, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' taqe i aj Amón</para>
  <para style="q">ma' k'isiin i mahk xkian,</para>
  <para style="q">ruum aj re' naa nuye'em taqe chutojariik i kimahk.</para>
  <para style="q">Re' keh xkiyeew runimaal wach i kitinamiit</para>
  <para style="q">xkixih chi q'aslaj ch'ihch' i kipaam</para>
  <para style="q">taqe i yowaab' ixoq wilkeeb' ar Galaad.</para>
  <para style="q">
    <verse number="14" style="v" />Ruum aj re', re' hin naa nukojom ruq'aq'al i tz'aq kotimaj wii' riij i tinamit Rabá.</para>
  <para style="q">Eh naa ruk'ahtiik taqe i paat imb'aan wii' taaq'anik.</para>
  <para style="q">Xa je' chik ink'uloq kaq suut teew noq</para>
  <para style="q">naa nutaq'aam chaloq i aj q'aq'ineel taq cha naah.</para>
  <para style="q">
    <verse number="15" style="v" />Eh re' i kireey</para>
  <para style="q">re' taqe i nimaq wach kikamaj ruuk',</para>
  <para style="q">naa kik'amariik reje pankowlaj kamanik, inki i Dios.</para>
  <chapter number="2" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' taqe i aj Moab</para>
  <para style="q">ma' k'isiin mahk xkian,</para>
  <para style="q">ruum aj re' naa nuye'em taqe chutojariik i kimahk.</para>
  <para style="q">Re' keh xkik'at xkikanaa' chi xa chaaj chik i rub'aqil i wilik naq chi reey ar Edom.</para>
  <para style="q">
    <verse number="2" style="v" />Ruum i re' naa nukojom ruq'aq'al i tinamit Moab,</para>
  <para style="q">eh naa ruk'ahtiik taqe i paat imb'aan wii' i taaq'anik ar Queriot.</para>
  <para style="q">Re' taqe i aj q'aq'ineel k'erlik kichii', eh naakixulem i tuun</para>
  <para style="q">noq naa rukuxiik kikansam taqe i aj Moab.</para>
  <para style="q">
    <verse number="3" style="v" />Eh naa wesam i wilik chi reyil chikinaah,</para>
  <para style="q">eh junkanteesjiik naa nub'anam ruuk' taqe i k'amal b'eeh</para>
  <para style="q">inki i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' taqe i aj Judá ma' k'isiin mahk xkian</para>
  <para style="q">ruum aj re' naa nuye'em taqe chutojariik i kimahk.</para>
  <para style="q">Re' keh ma' xponik ta panaq' kiwach i nutijiniik.</para>
  <para style="q">Eh ma' xkik'am ta naah i nuk'uhb'aal,</para>
  <para style="q">re' chik taqe i tiyoox xkiloq'ej</para>
  <para style="q">re' ixkiloq'ej chaloq i kimaam kati't.</para>
  <para style="q">
    <verse number="5" style="v" />Ruum aj re', re' hin naa nukojom ruq'aq'al i tinamit Judá,</para>
  <para style="q">eh naa nuk'atam taqe i paat imb'aan wii' taaq'anik ar Jerusaleem, inki.</para>
  <para style="s">Re' QaJaaw Dios xuq'or chi naa ruye'em taqe chutojariik i kimahk i aj Israel</para>
  <para style="q">
    <verse number="6" style="v" />Re' QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' taqe i aj Israel ma' k'isiin i mahk xkian</para>
  <para style="q">ruum aj re' naa nuye'em taqe chutojariik i kimahk.</para>
  <para style="q">Re' keh inkik'ayej reje ruuk' tumiin i ma' xta kimahk,</para>
  <para style="q">eh xa ruuk' i junk'uhl chi xijab'</para>
  <para style="q">inkik'ayej i neb'aa'.</para>
  <para style="q">
    <verse number="7" style="v" />Eh ma' mponik ta panaq'kiwach</para>
  <para style="q">inkiye'q' panak'al taqe i neb'aa',</para>
  <para style="q">ma' korik ta wach kik'ux kuuk' i ma' nimaq ta kiwach,</para>
  <para style="q">eh re' irixooq i ajaab'ees irixoqb'eej wo' chik ak'uunb'ees.</para>
  <para style="q">Ruuk' taqe i inki a'n re' re' inkesaj i wajaawriik.</para>
  <para style="q">
    <verse number="8" style="v" />Ma' k'isiin itz'ihy inkimol wach re' inkahnik kuuk' xa chi riij k'aas,</para>
  <para style="q">kiokik haa' chi wi'k noq kilooqjiik taqe i tiyoox.</para>
  <para style="q">Eh ruuk' i tumiin inkesaj reh i xama' xta wo' kimahk</para>
  <para style="q">inkiloq' i k'ah laj ha' inkuk'ej chupaam i rupaat i kitiyoox.</para>
  <para style="q">
    <verse number="9" style="v" />Eh ma' nk'ulik ta chik pankik'ux</para>
  <para style="q">noq xwesaj taqe reje pan kiye'aab' i aj amorreo,</para>
  <para style="q">eh xnusach kiwach, atoob' ta chi xanimaq chik kooq,</para>
  <para style="q">je' ninqaal kooq chee' chakaltee', eh kowlaj winaq taqe je' kikab' i tz'inuj.</para>
  <para style="q">
    <verse number="10" style="v" />Eh re' taq i hat aj Israel, re' hin xineesanik taq chaaweh Egipto,</para>
  <para style="q">ka'winaq haab' xat nub'esaj taq chaloq chupaam i ye'aab' chiq yuuq',</para>
  <para style="q">reh chi xnuyeew taq aweh i kiye'aab' i aj amorreo.</para>
  <para style="q">
    <verse number="11" style="v" />Re' hin korik taq i nuq'or aweh</para>
  <para style="q">chi chaxilak taq i hat wilik i xnukoj chi jalal nuq'oral.</para>
  <para style="q">Eh xnusik' kiwach i k'ijolaq</para>
  <para style="q">chi xi kahnik panukamaj chi ma' yok'ooj taj i rismaal kinaah, inki i QaJaaw Dios.</para>
  <para style="q">
    <verse number="12" style="v" />Eh re' taq i hat xamin taqe i k'ijool re' re'</para>
  <para style="q">chi ruuk'jiik i k'ah laj ha' inxohk'risanik,</para>
  <para style="q">eh ma' xayeew ta taq q'ab' keh</para>
  <para style="q">i jalal nuq'oral chi xkiq'or rib'iral i nub'ihnaal.</para>
  <para style="q">
    <verse number="13" style="v" />Ruum taq i xa a'n re' re' naa nuye'em</para>
  <para style="q">taq i ti' k'axik cha naah,</para>
  <para style="q">naa taq aqahb'aniik ruum i ruti'kiil</para>
  <para style="q">je' rukab' i choqik i rub'an i kareta</para>
  <para style="q">noq ahl i trigo rihqaam.</para>
  <para style="q">
    <verse number="14" style="v" />Eh re' neerumol chi elik xama' naa ta wo' ruko'leem riib',</para>
  <para style="q">eh re' i kow riib' naa rukahniik chi ma' xta raansil.</para>
  <para style="q">Eh re' i kow riib' xama' naa ta wo' ruko'leem riib' chuwach i ti'.</para>
  <para style="q">
    <verse number="15" style="v" />Eh ni xata re' inchol peleto ruuk' i flecha naa ruko'leem riib',</para>
  <para style="q">ni xata re' i kow inajiminik, eh ni xata re' inarumolom chi elik</para>
  <para style="q">chi riij i kawayú naa ruko'leem riib'.</para>
  <para style="q">
    <verse number="16" style="v" />Chupaam taqe i q'iij re' re', re' i soldado q'e' kow riib' chi q'aq'inik</para>
  <para style="q">naa ruq'eb'em kahnoq i ruch'ihch' reh q'aq'inik noq naa rumolom chi elik,</para>
  <para style="q">inki i Dios.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' i xuq'or i jalal ruq'oral i Dios</para>
  <para style="p">
    <verse number="1" style="v" />Hat taq aj Israel chab'iraj taq i ruq'or chawiij i QaJaaw Dios chawunchelaal i xat risaj taq chaloq Egipto je' wili i xuq'or:</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Eh xa re' wo' naq taq i hat xnusik' taq chaawach Chi kixilak i tinamit wach ak'al.</para>
  <para style="q">Ruum aj re' naa taq kaat nuye'em chutojariik amahk</para>
  <para style="q">ruum i ma' k'isa yiib' wach na'ojb'al taq i na a'n, inki.</para>
  <para style="q">
    <verse number="3" style="v" />¿Mi neerub'an chi neenkuhch'ileej kiib' i ki'ib' chi</para>
  <para style="q">ma' nkaaj ta kiwach?</para>
  <para style="q">
    <verse number="4" style="v" />Eh ¿Mi neeruk'er chii' kaq b'ahlam</para>
  <para style="q">panch'ahn noq komajaa' i ruchop i rutiib'?</para>
  <para style="q">Eh ¿Mi neeruk'er chii' i rak'uun kaq b'ahlam parujuul</para>
  <para style="q">noq komajaa' i ruchop i rutiib'?</para>
  <para style="q">
    <verse number="5" style="v" />Eh ¿Mi neenchoparik jino'q i tz'ikin</para>
  <para style="q">wach ak'al rupinik i rub'an wila' ma' xkojarik i xirob'?</para>
  <para style="q">Eh ¿Mi neenq'orik i xirob'aal mi ma' chih i xuchop?</para>
  <para style="q">
    <verse number="6" style="v" />Eh ¿Mi ma' neekiyo'jik re' i</para>
  <para style="q">tinamit wila' inxuuljik i tuun pan jino'q tinamit?</para>
  <para style="q">Eh ¿Mi wilik i ti' k'axik neenchalik chinaah i tinamit</para>
  <para style="q">wila' ma' re' i Dios neen ye'wik reh?</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' i QaJaaw Dios ma' xtaj i ti' k'axik i ruyeew chaloq</para>
  <para style="q">chi ma' ta nee ruyeew chi naab'jik keh taqe i jalal ruq'oral.</para>
  <para style="q">
    <verse number="8" style="v" />Eh wixq'orik i kaq b'ahlam</para>
  <para style="q">¿Mi ma' neekiyo'jik re' tinamit?</para>
  <para style="q">eh wila' xuq'or i QaJaaw Dios chi naa ruq'orariik rib'iral,</para>
  <para style="q">¿Mi neerub'an re' chi ma' nee ta q'orarik rib'iral?</para>
  <para style="s">Re' rusachariik kiwach i aj Samaria</para>
  <para style="q">
    <verse number="9" style="v" />Re' taq i hat je' wili i naa taq aq'orom</para>
  <para style="q">chupaam taqe paat imb'aan wii' taaq'anik ar Asdod,</para>
  <para style="q">eh chupaam taqe i paat imb'aan wii' taaq'anik ar Egipto:</para>
  <para style="q">Chamol taq awiib' chinaah i yuuq' Samaria,</para>
  <para style="q">nee taq inawilow i tukinik wachiis,</para>
  <para style="q">taqe i yiib' wach na'ojb'al k'achi' keeb' ar, tiko'q taq keh.</para>
  <para style="q">
    <verse number="10" style="v" />Re' QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' keh ma' inki a'n taj i korik inkimol wach pankipaat inki a'n wii' i taaq'anik</para>
  <para style="q">inkiq'uch reh i kas kichaaq' pank'aah, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Eh je' wili i ruq'or i QaJaaw Dios:</para>
  <para style="q">Re' taqe i ki-ixowanik taq awach k'ul naa kichaliik</para>
  <para style="q">naakich'ahaam i paat i nako'leej taq wii' awiib',</para>
  <para style="q">eh naa kelq'aam i chib'ih taq aweh wilik chupaam taq aapaat.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' i QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' cha'jen tentzun neeruq'uch i rutentzuun</para>
  <para style="q">panchii' i kaq b'ahlam</para>
  <para style="q">xa re' la' xa re' wo' ki'ib' chi rooq, i ruqox i xikin neeruq'uch.</para>
  <para style="q">Je' wo' re' taq hat aj Israel,</para>
  <para style="q">xakiib' ixib' wo' taq i naa ako'leem awiib' ar Samaria.</para>
  <para style="q">Yu'naak kosuq taq hi'lik aweh chinaah</para>
  <para style="q">taqe i holohaq ch'aht ar Damasco, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' QaJaaw Dios nim rajaawriik je' wili i xuq'or:</para>
  <para style="q">Re' taq i hat cha q'or taq rib'iral i ti' k'axik</para>
  <para style="q">naakik'ulum taqe i riih rumaam i Jacob.</para>
  <para style="q">
    <verse number="14" style="v" />Eh re' hin naa nuye'em taqe chutojariik i kimahk i aj Israel</para>
  <para style="q">ruum i yiib' wach na'ojb'al inki a'n</para>
  <para style="q">Eh naa nuyojom kiartaal ar Bet-el,</para>
  <para style="q">eh re' i kuk'aa' i artaal naakiyok'ariik naa kiq'ehb'iik wach ak'al.</para>
  <para style="q">
    <verse number="15" style="v" />Eh naa nusacham wach i kipaat kiwihik wii' pan siq'jil,</para>
  <para style="q">i kipaat kiwihiik wii' pan q'ilej.</para>
  <para style="q">Eh naa nusacham wach i kipaat marfil korjinaq wii',</para>
  <para style="q">je' wo' i kipaat inki a'n wii' i taaq'anik,</para>
  <para style="q">inki i QaJaaw Dios.</para>
  <chapter number="4" style="c" />
  <para style="q">
    <verse number="1" style="v" />Chab'iraj taq i hat ixoq aj Samaria,</para>
  <para style="q">je' taq akab' ixoq wakax wilkeeb' Basán inaq'uch taq i chib'ih keh i neb'aa',</para>
  <para style="q">i nayeew taq panti' k'axik i ma' xta wilik keh.</para>
  <para style="q">Eh inataq'aaj taq ab'ahiil chuk'amariik i k'ah laj ha',</para>
  <para style="q">reh chi naawuk'ej taq.</para>
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw Dios xuq'or i korik ruuk' i rusantohiil, je' wili xuq'or:</para>
  <para style="q">Eh je' naa ruuk' i lok lok laj ch'ihch' naa taq kaat nuk'amam reje</para>
  <para style="q">je' rukab' noq inehteesjik i kar panha' ruuk' i k'isa lok lok laj ch'ihch'.</para>
  <para style="q">Je' wo' re' i naa nub'anam keh taq awak'uun awixq'uun.</para>
  <para style="q">
    <verse number="3" style="v" />Eh naa kehteesjiik reje chupaam i</para>
  <para style="q">paat inki a'n wii' taaq'anik naakimolom chi elik,</para>
  <para style="q">ar naa kikutum reje kiib' chinaah i yuuq' Hermón, inki.</para>
  <para style="q">
    <verse number="4" style="v" />Hiy taq ar Bet-el, eh Gilgal cha a'n taq i mahk,</para>
  <para style="q">cha a'n taq aq'et wachiil, hiy taq chak'at mayiij eqal eqal</para>
  <para style="q">chikiwach i tiyoox pantaq wahq'eq,</para>
  <para style="q">chak'am taq reje i ru lajeeb' sentabohiil i jinaj ketzal chi roox q'iij.</para>
  <para style="q">
    <verse number="5" style="v" />Hiy taq chayeew chi amayiij i kaxlanwi'k</para>
  <para style="q">kojooj ch'amb'esb'al reh</para>
  <para style="q">eh cha q'or rib'iral xa aha' yuuq'</para>
  <para style="q">nik' nimaal taq amayiij xayeew,</para>
  <para style="q">ruum je' taq re' imponik chawach i hat</para>
  <para style="q">taq aj Israel, inki i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' hin xat nuyeew taq chi kuyariik</para>
  <para style="q">awa' ahaa' chupaam taq aatinamiit,</para>
  <para style="q">eh xnuyeew wo' i wi'jaleel chupaam taqe i kok' tinamit.</para>
  <para style="q">Eh re' taq i hat ni xata ruum i re'</para>
  <para style="q">xat chalik wo' chik taq wuuk', inki i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Eh ma' xnuyeew ta chik i jab' chuwach ixib' poh,</para>
  <para style="q">re' noq komajaa' taq inasik' i wach atik.</para>
  <para style="q">Wilik i tinamit xnuyeew wii' i jab', eh wilik i tinamit ma' xnuyeew ta wii' i jab'.</para>
  <para style="q">Wilik xub'an wii' i jab',</para>
  <para style="q">eh wilik i xi chiqik ruum ma' xub'an ta chik i jab'.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taqe i tinamit xak'ul chik kiooj</para>
  <para style="q">pantaq tokoom tinamit chi rusik'ariik kihaa',</para>
  <para style="q">ruum i kichiqchi'iil.</para>
  <para style="q">Eh re' taq i hat ni xata ruum taqe re'</para>
  <para style="q">xat sutinik wo' chik taq wuuk', inki i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Eh xnuyeew wo' itz'a' laj teew taq cha naah,</para>
  <para style="q">ruum i re' xi chiqik taq atik wilkeeb' taq panakoraal, xnuchiqsaj wo' taq aa-uuva.</para>
  <para style="q">Eh re' taqe i nimaq chili'l xkik'ux taq i xaq aa-higo je' wo' hoq i xaq taq aa-olivo.</para>
  <para style="q">Eh re' taq i hat ni xata ruum taqe re' xat sutinik wo' chik taq cho wuuk', inki i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Eh je' wili i xuq'or:</para>
  <para style="q">Re' hin xnuyeew taq cha naah i ti' k'axik</para>
  <para style="q">je' rukab' i xnuyeew chikinaah i aj Egipto.</para>
  <para style="q">Xnukansaj taq awak'uun panq'aq'inik,</para>
  <para style="q">eh chi xq'ucharik i kikawayu reh q'aq'inik kuum i aj ixowaal.</para>
  <para style="q">Eh xkik'raaj ruchuhkiil taqe i kamnaq chupaam i kiye'aab'.</para>
  <para style="q">Eh re' taq i hat ni xata ruum taqe re' xintohq'ik wo' chik taq animam,</para>
  <para style="q">inki i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' hin wilik wo' naq i xnusach kiwach</para>
  <para style="q">taq chaxilak ruuk' i ti' k'axik,</para>
  <para style="q">je' rukab' noq xnusach kiwach i tinamit Sodoma, i Gomorra.</para>
  <para style="q">Re' taq i hat xa je' chik rukab' noq inehteesjik iloq i ju'sii' wach q'aaq'</para>
  <para style="q">noq xako'leej taq awiib'.</para>
  <para style="q">Eh ni xata ruum taqe re'</para>
  <para style="q">xat sutinik wo' chik taq wuuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' hin naa taq kaat nuye'em</para>
  <para style="q">chutojariik riij taq ayiib' wach na'ojb'al i na a'n re' taq i hat, hat taq aj Israel,</para>
  <para style="q">cha yejaa' taq awiib' chi nuk'ulariik,</para>
  <para style="q">ruum re' hin naa nuq'atwiik i q'orik taq cha naah, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' i QaJaaw wili xyej-anik reh taqe inajt kinaah yuuq',</para>
  <para style="q">re' reh xtz'uhkrisanik cho reh i teew,</para>
  <para style="q">re' reh inye'wik chi naab'jik reh i winaq</para>
  <para style="q">chib'ih jariik i naa rub'anam.</para>
  <para style="q">Eh re' reh insutinik reh chi q'equm i saqum,</para>
  <para style="q">eh re' reh xa aha' wilik chinaah chu'nchel i wach ak'al.</para>
  <para style="q">Re' Dios nim rajaawriik,</para>
  <chapter number="5" style="c" />
  <para style="s">Re' Dios xq'orik chi riij i yot'oj k'uxliis</para>
  <para style="q">
    <verse number="1" style="v" />Re' taq i hat aj Israel chab'iraj taq i ruti'kiil ak'ux naa nuq'orom aweh panutz'uuy,</para>
  <para style="q">re' naa nuq'orom taq chawiij chi je' wili:</para>
  <para style="q">
    <verse number="2" style="v" />Re' taq i hat aj Israel</para>
  <para style="q">xaq'eb' taq i rusaqiil awach, ma' naa ta chik taq awuktiik.</para>
  <para style="q">Xa q'eb' taq awiib' chupaam taq aa ye'aab',</para>
  <para style="q">ma' awach ta chik i nuksanik taq cha weh.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i QaJaaw Dios je' wili i xuq'or keh i aj Israel:</para>
  <para style="q">Eh noq re' tinamiit nee rutaq'aaj reje chi q'aq'inik jino'q miil i ru soldado</para>
  <para style="q">ach jinaj siento i naakisutiniik chaloq.</para>
  <para style="q">Eh re' i nee rutaq'aaj jino'q siento i ru soldado</para>
  <para style="q">ach lajeeb' i naakisutiniik chaloq, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh je' wo' chik wili i xuq'or i QaJaaw Dios keh i aj Israel:</para>
  <para style="q">Kinasik' taq i hin nee taq inwihik ak'achariik.</para>
  <para style="q">
    <verse number="5" style="v" />Mat'ooj taq Bet-el, eh Gilgal.</para>
  <para style="q">Eh mat'ooj taq Beerseba, ruum re' taqe i aj Gilgal</para>
  <para style="q">naa kik'amariik reje pankowlaj kamanik</para>
  <para style="q">pan tokoom tinamit ma' naa ta rik'iik wach,</para>
  <para style="q">eh re' taqe i aj Bet-el naa rusachariik kiwach, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Kinasik' taq i hin nee taq inwihik ak'achariik,</para>
  <para style="q">eh wila' ma' xinasik' taq naa nutaq'aam taq cha naah i ti' k'axik,</para>
  <para style="q">i hat taq aj Israel chi je' jinaj runimaal q'aaq'.</para>
  <para style="q">Eh ma' awach ta jino'q i aj Bet-el naa rub'anam ruchupariik, inki Dios.</para>
  <para style="q">
    <verse number="7" style="v" />Xiik' naah ti'kiil i naa taq ak'ulum i hat</para>
  <para style="q">ruum xasutej taq chi yiib' wach i korik,</para>
  <para style="q">eh inawesaj taq i rajaawriik i ma' xta reet chi b'anarik.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Chasik' taq i QaJaaw Dios xyej-anik keh taqe i ch'umiil,</para>
  <para style="q">insutinik reh i q'equm chi saqum,</para>
  <para style="q">insutinik reh chi saqum i q'equm.</para>
  <para style="q">Re' ineesanik cho reh i jab' chinaah i palaw,</para>
  <para style="q">eh i ruyeew chaloq chinaah chu'nchel i wach ak'al,</para>
  <para style="q">re' i Dios nim rajaawriik rub'ihnaal.</para>
  <para style="q">
    <verse number="9" style="v" />Re' reh ineesanik i runimaal kiwach taqe i nimaq kiwach.</para>
  <para style="q">Eh xusach kiwach i paat inako'leej naq taq wii' awiib' i hat taq aj Israel.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' taq i hat ti' taq i naa ak'ulum ruum i nawixowaaj taq wach inko'linik riij i korik.</para>
  <para style="q">Eh ma' nawaaj ta taq wach inq'orik reh i korik noq imb'aan i q'ataj q'orik</para>
  <para style="q">
    <verse number="11" style="v" />Eh ruum chi ma' xponik ta taq panaq'awach taqe i neb'aa'</para>
  <para style="q">k'ih taq i tojb'al riij i ki trigo xapahqaaj.</para>
  <para style="q">Ruum aj re' ma' naa ta taq aak'achariik chupaam</para>
  <para style="q">taqe i paat i ab'aj korjinaq wii'.</para>
  <para style="q">Eh ma' nee ta wo' taq inawuk'ej aweh i riis i ki uuva.</para>
  <para style="q">
    <verse number="12" style="v" />Re' hin weht'al chu'nchel i yiib' wach na'ojb'al taq i na a'n,</para>
  <para style="q">je' wo' taq amahk ma' xata pajooj taq i na a'n.</para>
  <para style="q">Eh i nak'am taq i chib'ih keh i neb'aa' ruuk' ileq',</para>
  <para style="q">eh noq tiooj taq pa'lojoq pan q'atb'al q'orik</para>
  <para style="q">inatoj taq reh chi ma' nelik ta korik i neb'aa'.</para>
  <para style="q">
    <verse number="13" style="v" />Eh re' i wilik runa'ojb'al ma' teheeh ta wach chi q'orik,</para>
  <para style="q">ruum yu'naak ma' b'aan ta chik i q'ataj q'orik parub'ehel.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' taq i hat re' i holohik laj na'ojb'al cha sik'</para>
  <para style="q">reh chi nee wihik taq ak'achariik,</para>
  <para style="q">eh korik taq i neenaq'or,</para>
  <para style="q">re' i QaJaaw Dios nim rajaawriik neen wihik taq awuuk'.</para>
  <para style="q">
    <verse number="15" style="v" />Eh cha kanaa' taq i yiib' wach na'ojb'al,</para>
  <para style="q">re' taq chik i holohik cha a'n.</para>
  <para style="q">Eh cha a'n taq i q'ataj q'orik parub'ehel konee oon naq i ruketelaaj taq awach i Dios</para>
  <para style="q">nim rajaawriik i hat taq cho ruqox i aj Israel.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Re' i QaJaaw Dios nim rajaawriik je' wili i xuq'or:</para>
  <para style="q">Chu'nchel i naa kiwihiik pank'ayb'al</para>
  <para style="q">pantaq b'eeh naa koq'iim ruum i ti' k'axik.</para>
  <para style="q">Eh naakiyuq'eem kuuk' i xa panab'iix kikamanik,</para>
  <para style="q">taqe i nimaq wach kikamaj</para>
  <para style="q">reh chi junokiik taqe chi oq'ik.</para>
  <para style="q">
    <verse number="17" style="v" />Eh chupaam chu'nchel i ye'aab' tikooj wii' uuva</para>
  <para style="q">naa wo' ruwihiik i ma' k'isa oq'ik ruum</para>
  <para style="q">re' hin naa nuye'em i nujosq'iil ar, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Q'e' taq ti' i naa ak'ulum i xanawaaj taq chik chi nee ruyeew i rujosq'iil i QaJaaw Dios.</para>
  <para style="q">¿Mi nawaaj taq re' chi neemponik chi jumehq'iil i q'iij re' re'?</para>
  <para style="q">eh re' i q'iij re' re', runimaal q'equm taq cha weh ma' re' ta saqum.</para>
  <para style="q">
    <verse number="19" style="v" />Ruum na' chub'an i re'</para>
  <para style="q">je' rukab' noq imb'aan elik chuwach i kaq b'ahlam</para>
  <para style="q">eh inooj k'ularoq i josq'laj oso. Eh je' rukab' noq</para>
  <para style="q">insutinik cho parupaat jino'q i winaq</para>
  <para style="q">i ruyeew i koq i q'ab' wach tz'aq</para>
  <para style="q">eh inti'arik cho ruum i aaq'.</para>
  <para style="q">
    <verse number="20" style="v" />Korik noq na' chuyeew chaloq</para>
  <para style="q">i rujosq'iil i QaJaaw Dios</para>
  <para style="q">je' runimaal q'equm ma' saqum ta k'isinoq.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Re' QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' hin ma' mponik ta chi nuwach i moloj iib',</para>
  <para style="q">ninq'iij, i loq'inik taq i na a'n, i ruyoj nuk'ux.</para>
  <para style="q">
    <verse number="22" style="v" />Re' hin ma' nee ta taq i nuk'ul aweh ak'atoj mayiij,</para>
  <para style="q">inaq'wach taq atik, i</para>
  <para style="q">rak'uun taq awaakaax q'e' q'ina' nee nak'am</para>
  <para style="q">taq cho chi nuwach</para>
  <para style="q">reh chi nee wo' chik i nak'am taq awiib' panotob'il wuuk'.</para>
  <para style="q">
    <verse number="23" style="v" />Je' re' noq maa a'n taq chik chi nuwach atz'uuy taq i na a'n</para>
  <para style="q">Ma' waaj ta chik b'iram i q'ooj i na a'n taq ruuk' aawarpa</para>
  <para style="q">
    <verse number="24" style="v" />Re' la' taq i korik cha a'n, ruch'ihil i holohik chi b'anarik.</para>
  <para style="q">Eh je'-oq rooq ha', je'-oq k'achlik ha' ma' jaruuj inchiqik.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Hat taq aj Israel mi xayeew taq cho amayiij</para>
  <para style="q">¿Mi xak'am taq chaloq re' amayiij chi nuwach</para>
  <para style="q">noq xat b'ehik taq chaloq panchiq yuuq'</para>
  <para style="q">chuwach i ka'winaq haab'?</para>
  <para style="q">
    <verse number="26" style="v" />Re' la' taq i hat xawihqaaj taq chaloq i rupaat aatiyoox Moloc,</para>
  <para style="q">je' wo' taq aatiyoox Quiiún,</para>
  <para style="q">je' wo' i ch'umiil xayejaa' taq chi rehtalil taq aatiyoox,</para>
  <para style="q">re' wo' taqe re' xayeew taq kiloq'il.</para>
  <para style="q">
    <verse number="27" style="v" />Ruum i re'</para>
  <para style="q">naa nuye'em q'ab' chi naa taq ak'amariik reje pankowlaj kamanik</para>
  <para style="q">ko chi junch'aq i tinamit Damasco, inki i Dios,</para>
  <para style="q">nim rajaawriik.</para>
  <chapter number="6" style="c" />
  <para style="s">Re' ruq'orariik i rusachariik kiwach i aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Re' taqe suq wilkeeb' ar Sión,</para>
  <para style="q">re' taqe i ch'iklik kik'ux chinaah i yuuq'</para>
  <para style="q">Samaria q'e' ti' i naakik'ulum.</para>
  <para style="q">Re' taqe i ki'ib' chi tinamit re' re' q'e' nimaq</para>
  <para style="q">kiwach chi kixilak i tinamit wilkeeb' ar,</para>
  <para style="q">eh ar inkisik' rukowiil kik'ux i aj Israel</para>
  <para style="q">
    <verse number="2" style="v" />Hiy taq ar Calne chawil taq chaloq.</para>
  <para style="q">Eh kore' taq nee tiooj ar Hamat,</para>
  <para style="q">nee taq tiqajik qohoq Gat i wilkeeb' wii' i aj filisteo.</para>
  <para style="q">¿Mi q'e' taq hat chihooj re' hat chikiwach taqe re'?</para>
  <para style="q">¿Mi q'e' chihooj re' taq aatinamiit i hat chikiwach i tinamit re' re'?</para>
  <para style="q">
    <verse number="3" style="v" />Re' taq i hat ma' nawaaj ta naq chi neemponik i q'iij reh i ti' k'axik,</para>
  <para style="q">xa re' la' chalik taq chik i rub'an cha naah i ti' k'axik.</para>
  <para style="q">
    <verse number="4" style="v" />Re' taq i hat xasuq taq chik hi'lik aweh</para>
  <para style="q">chuwach ach'aht marfil korjinaq wii'.</para>
  <para style="q">Eh i nak'ux taq i rak'uun aatentzuun,</para>
  <para style="q">i rak'uun aa-wakax q'e' q'ina' inawesaj taq cho pankoraal.</para>
  <para style="q">
    <verse number="5" style="v" />Re' taq i hat inaxulej taq aa-suub' xama' inkan ta wo' chi riij taq i naxulej,</para>
  <para style="q">eh inayejaa' taq i xa reh reh wach chi q'ooj</para>
  <para style="q">inawaaj naq taq a'nam aweh i xub'an i reey David.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taq i hat i naawuk'ej i riis uuva panimaq kulk</para>
  <para style="q">eh re' taqe i q'e' k'ih tz'aaq inkohnik laj iq'oom taq inakoj,</para>
  <para style="q">ma' xta taq inawaaj reh chi k'ahchi' runeb'a'riik taq aatinamiit</para>
  <para style="q">
    <verse number="7" style="v" />Re' taq i hat peet naa ak'amariik reje pan</para>
  <para style="q">kowlaj kamanik pan tokoom tinamiit,</para>
  <para style="q">naa rusahchiik wach taq aninq'iij i na a'n</para>
  <para style="q">re' inareq naq taq wii' i rusuqkiil ak'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' i QaJaaw Dios nim rajaawriik xuq'or i xti korik chi je' wili:</para>
  <para style="q">Re' hin ma' imponik ta chi nuwach chi nkinimb'isaj kiib' i riih rumaam i Jacob.</para>
  <para style="q">Eh ma' imponik ta chi nuwach taqe i paat imb'aan wii' i q'ataj q'orik,</para>
  <para style="q">ruum aj re' naa nuq'asam i kitinamiit pan kiq'ab' i aj ixowaal,</para>
  <para style="q">je' wo' chu'nchel i wilkeeb' ar, inki.</para>
  <para style="q">
    <verse number="9" style="v" />Je' re' noq atoob' ta nee kikahnik lajeeb'-oq chi winaq,</para>
  <para style="q">pampaat xanaa wo' rukuxiik kikimiik.</para>
  <para style="q">
    <verse number="10" style="v" />Eh noq naa rokiik pampaat jino'q i awach reh i kamnaq</para>
  <para style="q">chi rehtesjiik i ruti'jolal ree ruk'atariik,</para>
  <para style="q">je' wili i naa ruq'orom i koq reh pampaat i xkahnik chi k'achlik:</para>
  <para style="q">¿Mi ko wilik chik jino'q i xkahnik awuuk' chi k'achlik? inko'q.</para>
  <para style="q">Ma' awach ta chik ach wo' re' hin, Inko'q chaloq</para>
  <para style="q">Ma' chih chik aq'or ruum nee-oq inaq'or i b'ih i QaJaaw Dios, inuchjoq.</para>
  <para style="q">
    <verse number="11" style="v" />Ruum re' i QaJaaw Dios ruq'orom</para>
  <para style="q">chi naa rusacham kiwach chu'nchel</para>
  <para style="q">chi je' nimaq paat chi je' kok' paat.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />¿Mi nee nkian re' i kawáyu johtik chuwach taqe i saqrehp ab'aj?</para>
  <para style="q">¿Mi neemb'aan re' i b'anaj arado nah i palaw?</para>
  <para style="q">Wila' ma' neemb'aan i je' re'</para>
  <para style="q">¿Chib'ih reet noq xasutej taq chi reh kaansanik i holohik laj na'ojb'al?</para>
  <para style="q">¿Chib'ih reet noq xasutej taq chi ma' holohik taj i korik?</para>
  <para style="q">
    <verse number="13" style="v" />Re' taq i hat insuuqb'ik taq ak'ux</para>
  <para style="q">ruuk' i xama' xta ruk'am chaloq, je' taq wili inaq'or:</para>
  <para style="q">Re' hoj xachiqib'il qiib' xqareq i qajaawriik, tiki taq.</para>
  <para style="q">
    <verse number="14" style="v" />Re' i QaJaaw Dios nim rajaawriik je' wilik i xuq'or:</para>
  <para style="q">Re' taq i hat aj Israel, naa nuk'amam taq cho cha naah</para>
  <para style="q">jino'q i tinamit chi naa taq rusacham awach,</para>
  <para style="q">ar naa rutoq'aam reje Hamat pantz'eet reh i rookb'aal q'iij,</para>
  <para style="q">eh naa ruponiik chi chii' i rooq ha' Arabá pansak'aaj reh i rokb'aal q'iij, inki.</para>
  <chapter number="7" style="c" />
  <para style="s">Re' ixib' chi ti' k'axik xk'uhtjik reh i Amós parusaq wirik</para>
  <para style="p">
    <verse number="1" style="v" />Re' Amós je' wilik xuq'or: Re' hin i xuk'uhtaaj weh i QaJaaw Dios panusaq wiriik chi k'ahchi' rutz'uhkrisam i ma' k'isa nimaq chili'l. Reh chi naa kik'uxum i wach chu'nchel i tik, re' i nelik koq'uun, re' noq elinaq chik inye'arik ree i reey. <verse number="2" style="v" />Eh noq re' taqe nimaq chili'l xkitz'ap wach i tik, je' wili i xnuq'or reh i QaJaaw Dios: Jaaw cha kuy qamahk i hoj, hoj aj Israel, hoj riih rumaam i Jacob maayeew tii chi qanaah i ti' k'axik re' re' ruum ma' nee ta nqa a'n ruko'ljiik qiib', ruum xama' hoj ta wo' tii k'ih. <verse number="3" style="v" />Eh re' i QaJaaw Dios xujal wach i rukapeb'aal, je' wili i xuq'or: Ma' naa ta nuye'em qohoq i ti' k'axik re' re', inki.</para>
  <para style="p">
    <verse number="4" style="v" />Eh re' i QaJaaw Dios xuk'uhtaaj wo' chik weh panusaq wiriik chi xuqasaj chaloq i q'aaq' pan taxaaj yohb'aal wach i qopik i rub'an reh tojb'al kimahk i tinamit. Eh ruum i rutz'a'iil xchiqik chik i palaw, je' wo' taqe i yuuq' k'ixkaab'. <verse number="5" style="v" />Eh re' i hin je' wili i xnuq'or: Jaaw cha kuy maayeew tii cho chi qanaah i ti' k'axik re' re' i hoj, hoj riih rumaam i Jacob ruum ma' nee ta qako'leej qiib' chuwach, ruum xama' hoj ta wo' tii k'ih, kinki. <verse number="6" style="v" />Eh re' i QaJaaw Dios xujal wach i rukapeb'aal je' wili xuq'or: Re' hin ma' naa ta nuye'em i ti' k'axik re' re', inki.</para>
  <para style="p">
    <verse number="7" style="v" />Re' i QaJaaw Dios je' wo' chik wili i xuk'uhtaaj weh panusaq wiriik: Re' QaJaaw pa'lik i koq chuwach i tz'aq pab'amaj chi korik ruuk' plomo eh ruyohq'eem wo' chik jinaj i plomo b'amb'al tz'aq. <verse number="8" style="v" />Eh re' i QaJaaw Dios xupahqaaj b'ila' weh chi je' wili:</para>
  <para style="p">Amós ¿chib'ih jariik i k'ahchi' awilom wach? inki.</para>
  <para style="p">Re' hin je' wili xnuq'or reh:</para>
  <para style="p">Jinaj i plomo b'amb'al tz'aq ayohq'eem, kinki reh.</para>
  <para style="p">Je' wili i xuq'or weh i reh:</para>
  <para style="p">Ruuk' aj i plomo wili naa nupajam i nutinamiit Israel, ruum re' hin ma' naa ta chik nukuyum kimahk nik'-oq najtiil, inki. <verse number="9" style="v" />Re' taqe i ye'aab' kiloq'inik wii' i riih rumaam i Isaac naa rusachariik kiwach, eh re' taqe i paat kiloq'inik wii' i riih rumaam i Israel naakiyojib'iik. Eh naa nusacham wach ruuk' q'aslaj ch'ihch' i Jeroboam, haa' taqe i rak'uun rixq'uun.</para>
  <para style="p">
    <verse number="10" style="v" />Re' i Amasías k'amal kib'eeh aj tiij ar Bet-el je' wili i xutaq'aaj ruq'orariik reh i Jeroboam kireey i aj Israel: Re' Amós i ruyeq' panak'al awajaawriik, ma' k'isiin i ruq'or keh i tinamit chawiij. Re' taqe i tinamit ma' nkikuy ta chik i ruq'or. <verse number="11" style="v" />Ruum re' reh je' wili i ruq'or: Re' i Jeroboam naa rukanteesjiik ruuk' q'aslaj ch'ihch', eh chu'nchel i tinamit Israel naa kik'amariik reje pankowlaj kamanik pan tokoom tinamit, inki. <verse number="12" style="v" />Eh re' Amasías je' wili i xuq'or reh i Amós:</para>
  <para style="p">Re' hat inaq'or chi wilik ink'uhtjik aweh, eleen reje ayu' reh chi ma' nee ta tikimik hiy ar Judá ar neena a'n awa' ahaa', eh neenaq'or i ruq'oral i Dios. <verse number="13" style="v" />Ayu' Bet-el matchalik chik chuq'orariik i ruq'oral i Dios, ruum re' i ye'aab' wili re' inloq'inik wii' i reey, eh re' i wilik wii' i ru nimlaj paat, inki.</para>
  <para style="p">
    <verse number="14" style="v" />Eh re' Amós je' wili i xuq'or reh Amasías:</para>
  <para style="p">Re' hin ma' hin ta jalal ruq'oral i Dios, ma' re' ta wo' re' nukamaj. Xa ruuk' la' tii nuk'isatz'aaq inkiyeew chi riij i cha'jinik tentzun inwik'saj wii' i q'iij, eh xa ruuk' i sik'ij higo i nub'an pantaq ch'ahn. <verse number="15" style="v" />Xa re' la' re' i QaJaaw Dios x-esanik cho weh chi cha'jinik tentzun je' wili i xuq'or weh: Yu'naak hiy cha q'or keh i nutinamiit Israel chi ma' holohik ta kib'anik, inki.</para>
  <para style="p">
    <verse number="16" style="v" />Eh re' hat inab'iraj i ruq'oral i QaJaaw Dios, inaq'or chi ma' naa ta nuq'orom keh i aj Israel chib'ih naa rub'anam i Dios kuuk'. Eh ma' nawaaj taj chi wilik i naa nuq'orom chikiij i riih rumaam i Isaac, inki. <verse number="17" style="v" />Ruum aj re' je' wili i xuq'or i QaJaaw Dios chawiij: Re' awehk'een naa rub'anam i k'oyomal pan tinamit, eh re' taqe awak'uun awixq'uun naa kikanteesjiik ruuk' q'aslaj ch'ihch', re' awak'aal naa ruch'aqib'iik keh i tokoom. Eh re' hat ar naa akimiik chi kixilak i ch'uwa' kiwach, re' taqe i aj Israel naa kik'amariik reje pan tokoom tinamit, inki.</para>
  <chapter number="8" style="c" />
  <para style="s">Re' jinaj chakach chi wach tik mu'uun xa q'an chik xk'uhtjik reh i Amós</para>
  <para style="p">
    <verse number="1" style="v" />Eh re' i QaJaaw Dios jinaj chik chakach i wach i tik mu'uun xiik' naah q'aniil xuk'uhtaaj weh panusaq wiriik. <verse number="2" style="v" />Eh re' Dios xupahqaaj weh chi je' wili: Amós ¿chib'ih jariik i k'ahchi' awilom wach? inki.</para>
  <para style="p">Re' hin jinaj chakach i wach i tik mu'uun xiik' naah q'aniil k'ahchi' wilom wach, kinki reh.</para>
  <para style="p">Re' taqe aj Israel je' kiq'aniil taqe i wach i tik re' re', xa ilook' chik i nuyeew taqe chutojariik i kimahk, inki.</para>
  <para style="p">
    <verse number="3" style="v" />Eh re' taqe i tz'uuy imb'aan chupaam i paat imb'aan wii' i q'ataj q'orik naa rusutiniik chi oq'ik. Eh ma' k'isiin taqe i naa kikanteesjiik ar, re' i kiti'jolal naa rukutariik cho rij paat chi ma' eht'alimaj, inki.</para>
  <para style="s">Xa ilook' chik inchalik i ti' k'axik chikinaah i aj Israel</para>
  <para style="p">
    <verse number="4" style="v" />Chab'iraj taq i naa nuq'orom i hat i ti minwik taq keh panti' k'axik i xama' nimaq ta kiwach, eh inaq'uch taq i chib'ih keh i neb'aa'. <verse number="5" style="v" />Re' taq i hat je' taq wili inaq'or: ¿Kojaruuj chik i ninq'iij reh i ak' poh? ¿Kojaruuj chik i ninq'iij reh i hi'limb'al q'iij reh chi neenqak'ayej i qatrigo taqe naq'wach i qatik chi k'ih neen qayeew wii' nee nqak'isiimb'isaj i qapajb'aal, eh ma' manlik taj i qapexu neenqa a'n? <verse number="6" style="v" />Eh naa qakanaam chi ma' xta chik chib'ih keh i neb'aa', korehtaal inkik'ayej kiib' quuk' tojb'al reh i kik'aas atoob' ta xa junk'uhl chi xijab' i kik'aas. Eh k'ih naa qak'ayem wii' keh i ruyib'kiil wach i trigo, tiki taq.</para>
  <para style="p">
    <verse number="7" style="v" />Re' QaJaaw Dios ruq'orom i xti korik, je' wili i xuq'or: Re' hin ma' jaruuj naa rusahchiik panuk'ux chi xkinimb'isaj kiwach i riih rumaam i Jacob, je' wo' hoq i xkian, inki. <verse number="8" style="v" />¿Mi ma' k'uyu'jik re' i wach ak'al ruum i xkian re' re'?</para>
  <para style="q">¿Mi ma' nee kioq'ik re' i tinamit ruuk' i ti' k'axik naakik'ulum?</para>
  <para style="q">Eh chu'nchel i wach ak'al naa ruqajiik naa rujohtiik</para>
  <para style="q">je' rukab' i rub'an i rub'ohl i nim ha' Nilo wilik ar Egipto.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Chupaam taqe i q'iij re' re' naa nuq'equm b'risam wach i q'iij manlik kab'lajora,</para>
  <para style="q">eh manlik parusaqumaal wach i q'iij naa ruq'equumriik chu'nchel i wach ak'al.</para>
  <para style="q">
    <verse number="10" style="v" />Re' taq aa-ninq'iij naa nusutem chi ruti'kiil k'uxliis,</para>
  <para style="q">re' aa-tz'uuy naa nusutem chi oq'ik, je' rukab' noq inooq'jik i kamnaq.</para>
  <para style="q">Eh naa taq akojom aq'eq' so', eh chi naa taq ajoyom i rismaal aanaah,</para>
  <para style="q">naa taq awoq'iim, je' rukab' noq inoq'ik ixoq xkimik i rak'uun</para>
  <para style="q">xa jinaj chuwach.</para>
  <para style="q">Chu'nchel naa rusutiniik chi ruti'kiil k'uxliis, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">K'ulik iloq reh i q'iij chi re' hin naa nutaq'aam</para>
  <para style="q">i wi'jaleel chinaah chu'nchel i tinamiit wach ak'al.</para>
  <para style="q">Xa re' la' ma' re' ta wi'jaleel reh wi'k ha',</para>
  <para style="q">wi'jaleel la' reh i rib'irjiik i nuq'oral.</para>
  <para style="q">
    <verse number="12" style="v" />Re' keh xak'ul chik naa kojiik pansak'aaj reh i rookb'aal q'iij,</para>
  <para style="q">eh pareelb'aal i q'iij,</para>
  <para style="q">nah taq palaw chi rusik'ariik i nuq'oral naa naq chik kaajwaam rib'irjiik</para>
  <para style="q">xa re' la' xama' naa ta wo' chik kireqem.</para>
  <para style="q">
    <verse number="13" style="v" />Re' taqe i holohaq xq'un,</para>
  <para style="q">taqe i kowlaj k'ijool naakiq'ehb'iik wach ak'al</para>
  <para style="q">ruum i ruchiqkaal kichii' reh i rib'irjiik i nuq'oral.</para>
  <para style="q">
    <verse number="14" style="v" />Eh re' taqe i kiq'orik i korik parub'ihnaal i tiyoox wilik Samaria.</para>
  <para style="q">Re' taqe i kiq'orik parub'ihnaal i tiyoox wilik Dan,</para>
  <para style="q">taqe i kiq'orik pankib'ihnaal i kitiyoox i aj Beerseba,</para>
  <para style="q">naa rusachariik kiwach, inki.</para>
  <chapter number="9" style="c" />
  <para style="s">Ma' wach ta jino'q i neeruko'leej riib' chuwach i ti' k'axik i nee ruyeew i Dios</para>
  <para style="p">
    <verse number="1" style="v" />Re' Amós je' wili i xuq'or: Re' hin xwilow wach i QaJaaw Dios chi pa'lik i koq wach artaal je' wili i xuq'or weh:</para>
  <para style="b" />
  <para style="q">Chak'uyu'saj chi kow i paat kinlooq'jik wii'</para>
  <para style="q">korehtaal inxereb'ik chikinaah chu'nchel i tinamit.</para>
  <para style="q">Eh awach i ma' naa ta rukimiik ruum i re',</para>
  <para style="q">ruuk' i q'aslaj ch'ihch' naa rukimiik,</para>
  <para style="q">reh chi ma' jino'q i naa ruko'leem riib'.</para>
  <para style="q">
    <verse number="2" style="v" />Eh atoob' ta naq nee nkikeb'aa' kiib' pan chaam laj jul</para>
  <para style="q">naa wo' nureqem taqe ar,</para>
  <para style="q">atoob' ta naq neenooj kikeb'aa' kiib' kopan taxaaj</para>
  <para style="q">naa wo' nureqem taqe ar.</para>
  <para style="q">
    <verse number="3" style="v" />Atoob' ta naq neenooj kikeb'aa' kiib' chinaah inajt naah yuuq' Carmelo</para>
  <para style="q">naa wo' i nureqem taqe ar,</para>
  <para style="q">atoob' ta naq neenooj kikeb'aa' kiib' ko paruchamiil i palaw</para>
  <para style="q">neenutaq'aaj reje i josq'laj chikop reh chi nee kik'uxarik ar.</para>
  <para style="q">
    <verse number="4" style="v" />Atoob' ta nee kik'amarik reje pan tokoom tinamit,</para>
  <para style="q">wilik taqe i naa nutaq'aam reje, reh chi nee kikanteesjik ruuk' q'aslaj ch'ihch'.</para>
  <para style="q">Eh naa taqe nuye'em panti' k'axik ma' re' ta otob'il i naa nub'anam keh, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh re' i QaJaaw Dios nim rajaawriik,</para>
  <para style="q">noq inq'orik ink'uyu'jik i wach ak'al,</para>
  <para style="q">kioq'ik chu'nchel i k'achareel wilkeeb' chinaah.</para>
  <para style="q">Re' i wach ak'al naa ruqajiik, naa rujohtiik,</para>
  <para style="q">je' rukab' i rub'an i rub'ohl i nim ha' Nilo ar Egipto.</para>
  <para style="q">
    <verse number="6" style="v" />Re' i QaJaaw Dios xuyejaa' i ruye'aab' pan taxaaj,</para>
  <para style="q">eh xuyejaa' i taxaaj chi taklik cho chinaah i wach ak'al.</para>
  <para style="q">Eh re' reh ineesanik chaloq i jab' chinaah i palaw,</para>
  <para style="q">ruuk' i re' i rut'aqsaj chu'nchel i wach ak'al,</para>
  <para style="q">QaJaaw Dios i rub'ihnaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' i QaJaaw Dios je' wili i xuq'or keh i aj Israel:</para>
  <para style="q">Chi wee hin eliik taq awach kuuk' i aj Etiopía,</para>
  <para style="q">nik' wach noq xat wesaj taq chaloq i hat Egipto,</para>
  <para style="q">je' wo' re' noq xwesaj taqe cho Creta i aj filisteo,</para>
  <para style="q">je' wo' re' noq xwesaj taqe cho Qir i aj arameo, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Eh je' wo' chik wili i xuq'or:</para>
  <para style="q">Re' hin inwilow chu'nchel i mahk inki a'n i tinamit,</para>
  <para style="q">ruum aj re', naa nusacham kiwach chinaah i wach ak'al.</para>
  <para style="q">Xa re' la' ma' naa ta rukuxiik nusacham kiwach</para>
  <para style="q">taqe i riih rumaam i Jacob.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hin naa nuye'em q'ab' chi naa rub'aan</para>
  <para style="q">ti' k'axik keh i aj Israel kuum i tokoom tinamit,</para>
  <para style="q">je' rukab' imb'aan reh i trigo noq inkichahchuuj wach</para>
  <para style="q">chupaam i tz'irb'al wach,</para>
  <para style="q">eh ma' jino'q inaq'wach inq'ehb'ik wach ak'al.</para>
  <para style="q">
    <verse number="10" style="v" />Re' taqe i nutinamiit kib'anik reh i mahk, ruuk' q'aslaj ch'ihch' naa kikimiik:</para>
  <para style="q">Re' taqe i kiq'orik reh chi je' wili:</para>
  <para style="q">Ma' jaruuj nee qoh k'ulik rureq i ti' k'axik ayu' inki taqe, inki.</para>
  <para style="s">Re' Dios xuq'or chi naa wo' chik ruko'leem i tinamit Israel</para>
  <para style="p">
    <verse number="11" style="v" />Re' i QaJaaw Dios je' wili i xuq'or: Re' hin naa nukojom chi reyil i riih rumaam i reey David Naa nub'anam kuuk' aj Israel je' rukab' noq inyejeb'jik wo' chik i paat yojinaq naq. Naa wo' chik wuksam, naa wo' chik ruwihiik runimaal wach je' rukab' i pampeet. <verse number="12" style="v" />Re' chi re' taqe i kiqox i aj Edom, eh chu'nchel i tinamit wihinaq taqe chi nutinamiit naa wo' chik kehchaam i ye'aab' Israel, inki. Re' wili naa rojiik eloq wach ruum re' i QaJaaw Dios xq'orik.</para>
  <para style="p">
    <verse number="13" style="v" />Eh je' wili i xuq'or: Naa ruponiik i q'iij noq re' taqe i tik naa kiwachiniik chi korik, xakomajaa' wo' inkikohlaaj rumolariik i wach i naa wo' chik kokiik chi iwik. Eh xakomajaa' wo' inkikohlaaj ruyitz'ariik i uuva naa wo' chik kokiik chi iwik. Re' taqe i uuva wataq yuuq' k'ixkaab', ma' k'isiin i riis naa ruwihiik xa je' chik rooq ha'. <verse number="14" style="v" />Eh re' hin naa wo' chik wesam taqe chaloq i nutinamiit Israel pan tokoom tinamit, naa wo' chik kiyejaam taqe i tinamit yojinaq, ar wo' chik naakipatiniik. Eh naa kitikim ki uuva naa kuk'em i riis, eh naa kitikim chib'ih keh pan kikoraal naa wo' kik'uxum i wach. <verse number="15" style="v" />Re' hin naa wo' chik nuye'em taqe pan kiye'aab' re' i nuye'em cho keh najtir. Eh ma' awach ta chik naa resaniik keh chupaam i kiye'aab' xnuyeew, inki i QaJaaw Dios.</para>
</usx>