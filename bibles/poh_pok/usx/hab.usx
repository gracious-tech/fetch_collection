<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="HAB" style="id">HABPOK.SFK 19-02-2,008. Adelina Quej Xoy. Pocomchi. Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">HABACUC</para>
  <para style="toc3">Hab</para>
  <para style="toc2">Hab</para>
  <para style="toc1">HABACUC</para>
  <para style="mt2">RE' I RUHUUJ I HABACUC</para>
  <para style="mt1">HABACUC</para>
  <chapter number="1" style="c" />
  <para style="s">Re' i Habacuc xupahqaaj ree Dios chi naa ruko'ljiik chuwach i ti' k'axik</para>
  <para style="p">
    <verse number="1" style="v" />Re' wili xk'uhtjik reh parusaq wiriik i Habacuc, ruum i QaJaaw Dios. <verse number="2" style="v" />Re' Habacuc je' wili i xuq'or:</para>
  <para style="q">QaJaaw Dios, ¿Ko jarpech chik naanuk'erem nuchii'</para>
  <para style="q">chi naakooj atoob'eem, eh xama' kinab'iraj ta wo' hoq?</para>
  <para style="q">Eh ¿ko jarpech chik naanupahqaam aweh chi nee qoh ako'leej?</para>
  <para style="q">
    <verse number="3" style="v" />¿Chib'ih reet noq xayeew q'ab' chi k'achi'</para>
  <para style="q">wilom i ti' k'axik, ruch'ihil i yiib' wach wili?</para>
  <para style="q">¿Chib'ih reet noq wilik ikaansanik iib',</para>
  <para style="q">wilik i josq'iil, wilik i peleto, wilik i wech'inik iib' chi qaxilak?</para>
  <para style="q">
    <verse number="4" style="v" />Re' k'uhb'aal ma' nkiyeew ta chik rajaawriik i q'atal q'orik.</para>
  <para style="q">Re' i yiib' wach kina'ojb'al inki a'n i ti' k'axik reh i korik wach kik'ux,</para>
  <para style="q">eh xama' kiye'ariik ta wo'</para>
  <para style="q">chutojariik i kimahk, inki.</para>
  <para style="q">
    <verse number="5" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh:</para>
  <para style="q">Chawilow reje i nimaq tinamit cha junsuut,</para>
  <para style="q">ma' k'isiin i sahchb'al k'uxliis naa nub'anam kuuk', naa ayo'jiik ruum.</para>
  <para style="q">Tokoom ta nee nq'orik reh chi naa nub'anam taqe i re' ma' nee ta naq inanimaj.</para>
  <para style="q">
    <verse number="6" style="v" />Re' hin naa nutaq'aam taqe reje i aj Caldeo,</para>
  <para style="q">ma' k'isiin ta kijosq'iil, yiib' wach kib'anik.</para>
  <para style="q">Eh kichopom kik'ux chi ojik chi junsuut i wach ak'al</para>
  <para style="q">reh i ruchopariik kinaah taqe i ye'aab' tokoom ehchan reh.</para>
  <para style="q">
    <verse number="7" style="v" />Re' keh q'e' kow kiib', ti yo'joq kuum.</para>
  <para style="q">Eh ma' kiyeew ta rajaawriik i k'uhb'aal,</para>
  <para style="q">xa re' inkiyeew rajaawriik inki a'n i keh.</para>
  <para style="q">
    <verse number="8" style="v" />Eh re' i kikawayu kow ki ajiminik,</para>
  <para style="q">ma' xata je' kiajiminik i nimaq taq b'ahlam,</para>
  <para style="q">eh yohb'aal wach kijosq'iil, ma' xata je' kijosq'iil i xohjb'.</para>
  <para style="q">Eh xiik' naah kik'ihaal i kijohtik chikiij i kikawayu,</para>
  <para style="q">xa pan jumehq'iil kiooj chi peleto chikinaah i tinamit,</para>
  <para style="q">je' rukab' noq inrupinik i xihk.</para>
  <para style="q">
    <verse number="9" style="v" />Eh naa kisacham wach chib'ih inaakirem</para>
  <para style="q">pan kib'eeh, eh naa rik'iik kiyohb'isam i tinamit.</para>
  <para style="q">Re' i tinamit naa kichopom naah,</para>
  <para style="q">ma' xata je' k'ihaal i saniib' tub'lik chichii' i palaw.</para>
  <para style="q">
    <verse number="10" style="v" />Naakikaqse'laam panaq' kiwach taqe i reey,</para>
  <para style="q">taqe nimaq wach kina'ojb'al.</para>
  <para style="q">Eh ma' naa ta ruponiik panaq' kiwach inkiko'leej wii' kiib' i tinamit.</para>
  <para style="q">Eh naakik'otom aak'al kookb'aal, korehtaal inkichop naah i tinamit.</para>
  <para style="q">
    <verse number="11" style="v" />Eh je' i nik'ik i kaq suut teew noq naa kisacham wach taq aatinamiit,</para>
  <para style="q">eh naakikapaam chi ruuk' i rajaawriik i kitiyoox naa kianam i re', inki i Dios.</para>
  <para style="s">Re' i Habacuc kow xupahqaaj chi tob'joq ruum i Dios</para>
  <para style="q">
    <verse number="12" style="v" />Re' i Habacuc je' wili xuq'or:</para>
  <para style="q">QaJaaw Dios wilik i aSantohiil, ma' naa ta kimiik,</para>
  <para style="q">¿Mi ma' wilkaat chaloq re' hat noq komajaa' chii wilik?</para>
  <para style="q">Re' hat, hat waj ko'loom maayeew q'ab' chinee qoh kimik,</para>
  <para style="q">eh re' hat xat ye'wik q'ab' keh i aj Caldeo chi naa kianam qeh, tojb'al riij i qamahk.</para>
  <para style="q">
    <verse number="13" style="v" />Re' hat saq wach awánima, ma' ponik ta chawach i yiib' wach na'ojb'al.</para>
  <para style="q">Eh ¿Chib'ih reet noq neen nawil i ti' k'axik neenkian qeh i yiib' wach kina'ojb'al,</para>
  <para style="q">eh chi xama' xta neena a'n chiriij?</para>
  <para style="q">Re' keh inkisach wach i korik wach kik'ux,</para>
  <para style="q">ma' je' ta kikab' i keh.</para>
  <para style="q">
    <verse number="14" style="v" />Eh ¿Chib'ih reet noq qoh akanaa' chi qutkeel chi je' qakab' taqe i kar panha',</para>
  <para style="q">chi je' qakab' taqe i chikop kijukem kiib' noq kib'ehik, ma' xta ilil keh?</para>
  <para style="q">
    <verse number="15" style="v" />Re' taqe i aj Caldeo ko ma' k'isiin i tinamit naa kichopom naah,</para>
  <para style="q">ma' k'isiin naa rusuuqb'iik kik'ux,</para>
  <para style="q">je' rukab' noq insuuqb'ik ruk'ux i aj kar noq i ruchop i kar ruuk' ya'l,</para>
  <para style="q">ruuk' lok lok naah ch'ihch'.</para>
  <para style="q">
    <verse number="16" style="v" />Re' i karineel i ruyeew ruloq'il i ru ya'l,</para>
  <para style="q">i ruk'isa lok lok naah ch'ihch' b'amb'al rukaar,</para>
  <para style="q">i ruk'at rumayiij chikinaah, t'iosb'al reh chi ruuk' i re'</para>
  <para style="q">i rub'an ruwa' ruhaa' chi korik, eh suq i ruk'ux.</para>
  <para style="q">
    <verse number="17" style="v" />¿Mi je' re' i naa kianam re' i aj Caldeo?</para>
  <para style="q">¿mi xa eliik je' inchoparik kar re' i tinamit naa kianam reh</para>
  <para style="q">i kikanteesjiik? ¿mi ma' naa kiketelaam wach re'?</para>
  <chapter number="2" style="c" />
  <para style="s">Re' i QaJaaw Dios xuchaq'weej i Habacuc</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin je' wili i xnuq'or:</para>
  <para style="q">Re' hin xa eliik naawuy-eem chi na'lik weh,</para>
  <para style="q">chi je' jino'q aj cha'joom chinaah i paat inkiko'leej wii' kiib' i tinamit.</para>
  <para style="q">Eh naa wilom chib'ih pa' nee kiruchaq'weej</para>
  <para style="q">wii' i QaJaaw Dios, ruuk' i xnupahqaaj reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Eh re' i QaJaaw Dios je' wili xuq'or weh:</para>
  <para style="q">Chatz'ihb'aaj chuwach i tz'ilom ab'aj i naanuk'uhtaam i aweh panasaq wiriik.</para>
  <para style="q">Eh holohik rutz'ihb'jiik cha a'n reh chi neenkireq chiriij i nee ki-ilwik wach.</para>
  <para style="q">
    <verse number="3" style="v" />Xa re' la' re' i naanuk'uhtaam aweh,</para>
  <para style="q">ma' naa ta pee ruk'ulariik chi jumehq'iil,</para>
  <para style="q">konaa pee awuy-eem nik'-oq najtiil,</para>
  <para style="q">xa re' la' ma' naa tarik'iikwach,</para>
  <para style="q">korehtaal ink'ularik noq naaruponiik i ruq'ijiil.</para>
  <para style="q">
    <verse number="4" style="v" />Re' hat re' naa atz'ihb'aam re' chi re' taqe</para>
  <para style="q">i q'e' nimaq kiwach inki a'n kiib' naa kojiik chi re' chi ma' re'.</para>
  <para style="q">Re' i korik wach kik'ux ruum chi kiye'em kik'ux</para>
  <para style="q">chunimjiik i Dios naa kireqem i juneliik k'acharik, inki.</para>
  <para style="s">Re' i ti' k'axik naa ruchaliik chikinaah taqe i yiib' wach kina'ojb'al</para>
  <para style="q">
    <verse number="5" style="v" />Re' taqe i aj Caldeo je' kikab' i xohk'reel,</para>
  <para style="q">xa re' jot'ooj inki a'n q'e' nimaq kiwach inki a'n kiib' ma' nelik ta korik inki a'n</para>
  <para style="q">Eh xama' manlojik ta wo' keh inkiq'uch reh i tinamit,</para>
  <para style="q">je' kikab' i nimlaj rujuul kamnaq xa uy-inik i rub'an,</para>
  <para style="q">je' kikab' i kimik xama' nhi'lik ta chi jumpech.</para>
  <para style="q">Ruum aj re' xata wo' jarub' i tinamit inkichop naah.</para>
  <para style="q">
    <verse number="6" style="v" />Xa re' la' naaruponiik i q'iij noq naakikaqse'ljiik</para>
  <para style="q">kuum i tinamit,</para>
  <para style="q">je' wili i naa kiq'orom reh pankitz'uuy:</para>
  <para style="q">Re' taq i hat aj Caldeo xat b'ehomrik taq ruuk'</para>
  <para style="q">i ma' re' ta wo' taq aweh q'e' taq ti' i naa ak'ulum.</para>
  <para style="q">¿Kojaruuj i namay taq rumolariik wach</para>
  <para style="q">ab'ehomal ruuk' i xa naq'uch taq chaloq? inko'q taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' taq i hat aj Caldeo chi ma' aweht'al taq</para>
  <para style="q">naa kojiik k'oloq taq cha naah i xa q'uch taq chib'ih keh.</para>
  <para style="q">Eh naa taq ab'arb'otiik ruum ayo'jiik</para>
  <para style="q">naa wo' chik kiq'uchum taq aweh</para>
  <para style="q">i aq'uchum taq cho keh taq i hat.</para>
  <para style="q">
    <verse number="8" style="v" />Ruum k'ih seht chi tinamit xa q'uch taq chib'ih keh taq i hat,</para>
  <para style="q">naakimolom cho kiib' i keh</para>
  <para style="q">chi q'uchariik chu'nchel i chib'ih taq aweh i hat.</para>
  <para style="q">Eh naa taq kaat kiye'em chutojariik</para>
  <para style="q">chu'nchel taq amahk,</para>
  <para style="q">ikaansanik xa a'n taq chupaam taqe i tinamit xa a'n taq wii' ileq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Eh q'e' taq ti' i naa ak'ulum,</para>
  <para style="q">ruum i naa nujisaj taq apaat ruuk' i xa inawelq'aaj taq keh i tinamit.</para>
  <para style="q">Eh xakapaaj taq i hat chi ruuk' i re' taq naa ako'leem awiib' chuwach i ti' k'axik</para>
  <para style="q">
    <verse number="10" style="v" />Ruuk' taq i xa a'n re' re' xak'uhtaaj taq kik'ixb'ilaal</para>
  <para style="q">awach taq aweh wilkeeb' panapaat.</para>
  <para style="q">Eh ruum chi xasach taq wach i hat i ma'</para>
  <para style="q">k'isa tinamit naa wo' rusachariik taq awach i hat.</para>
  <para style="q">
    <verse number="11" style="v" />Eh wita kiq'orik taqe ab'aj ch'ikaab' reh i paat,</para>
  <para style="q">eh wita kiq'orik taqe i ruche'el i paat</para>
  <para style="q">nee wo' naq inkiq'or i keh chi wilik taq amahk, inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' taq i hat q'e' taq ti' i naa ak'ulum</para>
  <para style="q">ruum i na a'n taq ikaansanik, ileq',</para>
  <para style="q">eh ruuk' i re' inayejaa' taq aatinamiit chi korik.</para>
  <para style="q">
    <verse number="13" style="v" />Re' i QaJaaw Dios nim rajaawriik je' wili i xuq'or:</para>
  <para style="q">Re' hin naanusacham wach ruuk' q'aaq' i chib'ih keh i yiib' wach kina'ojb'al,</para>
  <para style="q">re' i xkiq'uhtisaj cho wii' kiib', xama' xta naa rokiik wii', inki.</para>
  <para style="q">
    <verse number="14" style="v" />Eh naaruponiik i q'iij noq naaruq'orariik i ruq'oral i Dios,</para>
  <para style="q">naarunujiik chinaah i wach ak'al,</para>
  <para style="q">je' rukab' noq i nujik i palaw ruuk' i nim ha'.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Eh re' taq i hat inaxohk'riisaj taq i aka'jaah ak'ula't q'e' ti' i naa ak'ulum,</para>
  <para style="q">xa xilakeej taq i k'ah laj ha' xayeew taq keh chi uuk'jik,</para>
  <para style="q">reh chi xkik'uhtaaj kik'ixb'ilaal.</para>
  <para style="q">
    <verse number="16" style="v" />Eh naa wo' kesam i runimaal taq awach i hat, naa wo' kik'uhtaam taq ak'ixb'ilaal,</para>
  <para style="q">ruum re' i QaJaaw Dios naa ruye'em i ti' k'axik taq cha naah,</para>
  <para style="q">je' naa k'ah laj ha' i naa ruye'em taq aweh chi uuk'jik.</para>
  <para style="q">Naa reh teesjiik taq i runimaal awach.</para>
  <para style="q">
    <verse number="17" style="v" />Re' i yiib' wach na'ojb'al xa a'n taq Líbano naarusutiniik cho cha naah taq i hat,</para>
  <para style="q">i kikantesjiik taq i kichikoop taq xa a'n.</para>
  <para style="q">Re' taqe i re' naa taq atojom wach,</para>
  <para style="q">naa ruchaliik i ti' k'axik taq cha naah ruum ikaansanik taq a'nam,</para>
  <para style="q">ruum taqe i yiib' wach taq xa a'n chupaam i tinamit</para>
  <para style="q">noq xa a'n taq chaloq i leq' chupaam taqe i ju'jun chi tinamit.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />¿Chib'ih kamaj i tiyoox i xa hat taq titz'aqwik reh?</para>
  <para style="q">¿Mi wilik rajaawriik re' taq aadios</para>
  <para style="q">xa haab'isamaj xama' kiq'orik ta wo' hoq?</para>
  <para style="q">Re' taqe re' xa pan chukuj q'orik kik'amwik.</para>
  <para style="q">¿Nik' wach noq inayeew taq ak'ux chikinaah i xa winaq kitz'aqwik reh?</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />¿Chib'ih reet noq inaq'or taq reh i tiyoox chee'</para>
  <para style="q">chi naarik'raam riib', eh naq'or taq reh i tiyoox ab'aj chi naa rupahiik johtoq?</para>
  <para style="q">Re' re' xama' nee ta wo' kiq'orik ruum xama' k'achalkeeb' ta wo' hoq,</para>
  <para style="q">atoob' ta naq iq'omamaj kiwach chi oro, chi plata.</para>
  <para style="q">
    <verse number="20" style="v" />Eh re' i k'achlik Dios reh wilik chupaam i ruSantolaj paat,</para>
  <para style="q">Eh xanoq wo' intz'aplojik kichii' chuwach chu'nchel i wilkeeb' wach ak'al.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' i rutiij xub'an i Habacuc</para>
  <para style="p">
    <verse number="1" style="v" />Re' wili i rutiij xub'an i Habacuc jalal ruq'oral i Dios:</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />QaJaaw Dios noq xb'iraj rib'iral nik' nimaal taqe i</para>
  <para style="q">a'nam chaloq xanoq wo' xnuyohleej awach.</para>
  <para style="q">Re' hin i nupahqaaj otob'il aweh chi cha a'n</para>
  <para style="q">tii quuk' i hoj yu'naak taqe i a'nam chaloq re' re'.</para>
  <para style="q">Chaketelaaj tii qawach atoob' ta k'achi' aajosq'iil chi qanaah.</para>
  <para style="q">
    <verse number="3" style="v" />Re' hin xwilow panusaq wiriik chi chalik i rub'an i</para>
  <para style="q">QaJaaw Dios wilik ruSantohiil chupaam i ye'aab'</para>
  <para style="q">Temán, chalik i rub'an chinaah i yuuq', Parán.</para>
  <para style="b" />
  <para style="q">Eh re' i ruloq'il xk'utinik pan taxaaj,</para>
  <para style="q">je' wo' chinaah i wach ak'al.</para>
  <para style="q">
    <verse number="4" style="v" />Eh sutimaj riij chi saqum,</para>
  <para style="q">xa wilik chik i ruch'aab' i saqum i nelik chaloq chupaam kab'chel i q'ab'.</para>
  <para style="q">Re' taqe re' ink'uhtanik reh chi wilik rajaawriik.</para>
  <para style="q">
    <verse number="5" style="v" />Xa re' la' noq komajaa' ink'uloq i QaJaaw peet xik'ik i runimaal yab'ilaal.</para>
  <para style="q">Eh noq ik'inaq chik i QaJaaw Dios jinaj chik inchel i runimaal kaq tz'a' xik'ik.</para>
  <para style="q">
    <verse number="6" style="v" />Eh re' i QaJaaw Dios i rupab'aa' riib' chi rilariik reje i wach ak'al,</para>
  <para style="q">re' i nimaq tinamit, inchalik kib'arb'otiik chuwach.</para>
  <para style="q">Re' taqe i rax chee' kitoqib'ik chuwach.</para>
  <para style="q">Eh re' taqe i yuuq', jumehq'iil i rusach kiwach.</para>
  <para style="q">Raaj i ruk'uhb'aal i Dios reh xa wilik wo' chi juneliik.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' hin xwilow noq xkik'ul i ti' k'axik taqe i wilkeeb' ar Cusan.</para>
  <para style="q">Eh xwilow noq xakib'arb'otik chik</para>
  <para style="q">ruum kiyo'jiik taqe i aj Madián.</para>
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios ¿Mi k'ahchi' re' aajosq'iil chinaah taqe i nim ha'?</para>
  <para style="q">¿Mi k'ahchi' re' aajosq'iil chinaah taqe i palaw noq xapab'aa'?</para>
  <para style="q">Re' hat xa a'n taqe i re',</para>
  <para style="q">reh chi xi ik'ik aatinamiit panha' chiriij i kikawayu,</para>
  <para style="q">chupaam i kikareta, reh chi ma' xta xi uchjik.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' hat je' naa ruuk' flecha xako'leej taqe.</para>
  <para style="q">Eh aq'orom wo' chaloq i korik chi naa ako'leem aatinamiit xako'leej wo' taqe,</para>
  <para style="b" />
  <para style="q">xa teh wo' kiik'b'aal panyejaal taqe i nim ha'.</para>
  <para style="q">
    <verse number="10" style="v" />Eh kiyo'jik chawach taqe i yuuq',</para>
  <para style="q">re' hat ti ye'wik chaloq i runimaal jab',</para>
  <para style="q">ruuk' i re' xnujik i ha' wach ak'al.</para>
  <para style="q">Re' i palaw xan telelinik chik ruum rujosq'iil,</para>
  <para style="q">i nelik reje i rub'ohl.</para>
  <para style="q">
    <verse number="11" style="v" />Eh xwilow chi wilik b'ila' chik panaq'ab' i flecha,</para>
  <para style="q">je' wo' i ch'ihch' k'ulq'as xa saqrepik chik i reeh.</para>
  <para style="q">Re' i q'iij, i poh xama' kik'uyu'jik ta chik pan kiye'aab' noq xkilow awach.</para>
  <para style="q">
    <verse number="12" style="v" />Re' hat xayeew aajosq'iil chinaah chu'nchel i wach ak'al,</para>
  <para style="q">eh xa yeq'eeb'eej panawooq taqe i tinamit ruum aajosq'iil.</para>
  <para style="q">
    <verse number="13" style="v" />Re' hat xat chalik chi kiko'ljiik aatinamiit,</para>
  <para style="q">chi ruko'ljiik i reey asik'im wach,</para>
  <para style="q">ruum i re' xasach kiwach i k'amal kib'eeh i yiib' wach kina'ojb'al,</para>
  <para style="q">je' rukab' noq insacharik wach jino'q i paat inyojib'ik haa' i ch'ikaab' reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Eh xayeew q'ab' chi xa ruuk' i flecha xi kanteesjik taqe</para>
  <para style="q">i k'amal kib'eeh i soldado.</para>
  <para style="q">Re' taqe i wilkeeb' chiriij taqe i kawáyu xkikut kiib' chinaah taqe i tinamit</para>
  <para style="q">ma' awach ta inko'linik keh, re' inkaaj i keh</para>
  <para style="q">chi naa kisacham wach chi ma' eht'alimaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Re' i hat xayeew q'ab' chi xkiq'at wach i palaw aatinamiit,</para>
  <para style="q">chiriij taqe i kawáyu, atoob' ta</para>
  <para style="q">xayohb'aal wo' naq chik wach i ha', je' wo' i rupuuh.</para>
  <para style="q">
    <verse number="16" style="v" />Eh noq xwilow panusaq wiriik taqe re' xinyo'jik,</para>
  <para style="q">xama' kinchol ta chik q'orik, xa kib'arb'otiik chik i pan waa'</para>
  <para style="q">xama' xta naq chik k'isinoq nukowiil.</para>
  <para style="q">Atoob' ta je' re' i k'ahchi' nuk'ulum,</para>
  <para style="q">kok'ahchi' wuy-eem ruuk' q'unil chi re' i QaJaaw Dios</para>
  <para style="q">naa taqe ruye'em panti' k'axik i ki-ixowinik qawach.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Eh re' hin ma' k'isiin ta naa rusuuqb'iik nuk'ux ruuk' i QaJaaw Dios,</para>
  <para style="q">atoob' ta ma' neenixmak'inik i higo, atoob' ta ma' nee tan wachinik i uuva,</para>
  <para style="q">atoob' ta ma' neenwachinik i olivo,</para>
  <para style="q">atoob' ta ma' xta chik taqe i tentzun, i wakax pankoraal.</para>
  <para style="q">Re' hin xama' naa ta wo' rutib'iik nuk'ux.</para>
  <para style="q">
    <verse number="18" style="v" />Ma' k'isiin la' naa rusuuqb'iik nuk'ux ruuk' i QaJaaw Dios,</para>
  <para style="q">naa rusuuqb'iik nuk'ux ruuk' ruum re' reh waj ko'loom.</para>
  <para style="q">
    <verse number="19" style="v" />Eh re' i QaJaaw Dios inye'wik rukowiil nuk'ux,</para>
  <para style="q">re' reh inye'wik rukowiil taqe i wach nuch'ehk,</para>
  <para style="q">reh chi kow kimb'ehik, je' kowiil imb'ehik i keej,</para>
  <para style="b" />
  <para style="q">Eh kiruyeew chupaam i ye'aab' aha' ma' xta neenuk'ul.</para>
</usx>