<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="JHN" style="id">JHNPOK.SFK 30-03-2,007. ADELINA QUEJ. POKOMCHI. Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">JUAN</para>
  <para style="toc3">Juan</para>
  <para style="toc2">Juan</para>
  <para style="toc1">JUAN</para>
  <para style="mt2">RE' I AK' K'UHB'AAL REH I SAN JUAN</para>
  <para style="mt1">SAN JUAN</para>
  <chapter number="1" style="c" />
  <para style="s">Re' ruq'oral i Dios xkorjik chi winaq</para>
  <para style="q">
    <verse number="1" style="v" />Noq xtz'uhkrik chaloq i wach ak'al,</para>
  <para style="q">xa wilik wo' chik chaloq i Atoob'laj Q'orik.</para>
  <para style="q">Eh xa wilik wo' cho ruuk' i Dios pampeet, eh Dios wo' hoq.</para>
  <para style="q">
    <verse number="2" style="v" />Re' reh xa wilik wo' chik cho ruuk' i Dios pampeet.</para>
  <para style="q">
    <verse number="3" style="v" />Re' reh xye'arik chi yejeb'jik ruum i Dios chu'nchel i chib'ih jariik i wilik.</para>
  <para style="q">Eh ma' xtaj i chib'ih jariik wilik chi ma' ta ruum i reh xkorjik.</para>
  <para style="q">
    <verse number="4" style="v" />Eh re' wo' reh inye'wik juneliik k'acharik.</para>
  <para style="q">Eh re' k'acharik wili insihq'inik reh i kánima chi winaq chi ixoq.</para>
  <para style="q">
    <verse number="5" style="v" />Re' Saqum re' re' insihq'inik chupaam taqe i q'equm,</para>
  <para style="q">re' taqe i q'equm ma' inki a'n ta ruchupariik.</para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" />Eh xwihik wo' chaloq jinaj i winaq, Juan rub'ihnaal, re' i xpa'ab'jik cho ruum i Dios, <verse number="7" style="v" />chi re' reh naa ruq'oriik rukorkiil i Saqum. Reh naq, chi chu'nchel naakinimaniik reh i naa ruq'orom. <verse number="8" style="v" />Re' Juan ma' re' tee reh i Saqum xa xpa'ab'jik la' cho ruum i Dios chuq'orariik rukorkiil i Saqum.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Eh re' i korik Saqum re' re' k'ulik i rub'an ayu' wach ak'al,</para>
  <para style="q">re' insihq'inik reh i kánima chi winaq chi ixoq.</para>
  <para style="q">
    <verse number="10" style="v" />Re' Atoob'laj Q'orik wilik chik ayu' wach ak'al.</para>
  <para style="q">Atoob' ta reh wo' reh xyej-anik i wach ak'al,</para>
  <para style="q">re' i tinamit xama' xkiyeew ta wo' rajaawriik.</para>
  <para style="q">
    <verse number="11" style="v" />Re' reh, re' naq taqe i rutinamiit xchalik ruko'leej xa re' la',</para>
  <para style="q">re' i rutinamiit xama' xkik'ul ta wo' hoq.</para>
  <para style="q">
    <verse number="12" style="v" />Eh re' taqe i xik'ulwik reh, i xinimanik reh,</para>
  <para style="q">xuyeew q'ab' keh chi xukoj taqe</para>
  <para style="q">chi rak'uun rixq'uun i Ajaab'ees Dios.</para>
  <para style="q">
    <verse number="13" style="v" />Re' keh rak'uun rixq'uun i Dios chik taqe,</para>
  <para style="q">ma' ruum ta chi aasjinaq taqe ruuk' i kituut kajaaw,</para>
  <para style="q">ruum la' chi re' Dios xraaj chi</para>
  <para style="q">rak'uun rixq'uun taqe.</para>
  <para style="q">
    <verse number="14" style="v" />Re' i Atoob'laj Q'orik xuyejaa' riib' chi winaq,</para>
  <para style="q">xk'acharik chi qaxilak, xiik' naah i k'axooj ruuk', korik wach ruk'ux.</para>
  <para style="q">Re' hoj xqilow i ruloq'il, re' i ruloq'il i raJaaw,</para>
  <para style="q">ruum xa re' wo' reh jinaj chi Ak'uunb'ees.</para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" />Re' i Juan i ruq'orom wo' cho rib'iral i re', noq xuq'or chi je' wili: Re' aj i wili xnuq'or taq cho rib'iral aweh chi jinaj i k'ulik iloq reh chi wiij i hin q'e' nim rajaawriik chi nuwach i hin, ruum xa wilik wo' chaloq noq komajaa' kin-aasjik i hin, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Re' i xuq'or cho rib'iral re' re',</para>
  <para style="q">xa ruum i ruk'axb'al i reh ma' pajooj taj i rotob'il i Dios inqak'ul i hoj.</para>
  <para style="q">
    <verse number="17" style="v" />Re' k'uhb'aal i xuyeew i Dios pampeet, xa re' i Moisés xq'orik cho reh.</para>
  <para style="q">Eh re' k'axooj, i korik xuyeew i Dios, re' i Jesucristo xk'ulik esanoq wach.</para>
  <para style="q">
    <verse number="18" style="v" />Ma' awach ta ilwinaq wach Ajaab'ees Dios xa re' wo' i Rak'uun, xwihik parusak'aaj q'ab'.</para>
  <para style="q">Re' reh xye'wik qeh chi naab'jik wach Ajaab'ees Dios.</para>
  <para style="s">Re' i Juan aj qasan ha' xuq'or rib'iral i ruk'uliik i Jesucristo</para>
  <para style="r">(<ref loc="MAT 3:11-12">Mat 3.11-12</ref>; <ref loc="MRK 1:7-8">Mar 1.7-8</ref>; <ref loc="LUK 3:15-17">Luc 3.15-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" />Re' taqe i aj judío, i wilkeeb' Jerusaleem, wilik i k'amal kib'eeh aj tiij, taqe intowik keh i k'amal kib'eeh aj tiij xkitaq'aaj reje chupahqaljiik reh i Juan aj qasan ha' chi je' wili:</para>
  <para style="p">¿Awach i hat inki taqe reh?</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' reh je' wili chaq'wik xub'an:</para>
  <para style="p">Xti korik chi ma' re' tee hin i Cristo, inki.</para>
  <para style="p">
    <verse number="21" style="v" />Eh ¿awach aj wo' re' hat?</para>
  <para style="p">Re' ¿oon i hat i Elías? inki taqe reh.</para>
  <para style="p">Ma' re' tee hin, inki.</para>
  <para style="p">¿Re' oon i hat jalal ruq'oral i Dios naa rutaq'aam chaloq i ruq'or? inki taqe.</para>
  <para style="p">Ma' re' tee hin, inki Juan.</para>
  <para style="p">
    <verse number="22" style="v" />Eh je' wili i xkiq'or reh:</para>
  <para style="p">Xti ¿awach aj wo' re' hat? Re' hoj inqaaj qanab'eem, ruum naa qaq'orom ponoq keh i xitaq'anik cho qeh. ¿Awach i hat noq inaq'or awiib'? inki taqe reh.</para>
  <para style="p">
    <verse number="23" style="v" />Re' Juan je' wili i xuq'or:</para>
  <para style="p">Re' hin i q'orik i k'erik cho chii' panchiq yuuq', chuq'orariik chi je' wili: Chayejaa' taq awánima chuk'ulariik i QaJaaw, cha yejaa' taq i rub'eeh je' rukab' noq inyejeb'jik rub'eeh i wilik chi ajaab'esil je' rukab' i xutz'ihb'aaj i Isaías inki.</para>
  <para style="p">
    <verse number="24" style="v" />Eh re' taqe i xitaq'ab'jik reje kuum i aj fariseo, xkiq'o'reej i Juan, <verse number="25" style="v" />xkipahqaaj reh chi je' wili:</para>
  <para style="p">Wila' ma' re' i hat i Cristo, i Elías, i Jalal ruq'oral i Dios, ¿chib'aaj reet noq i na a'n re' i qasanik ha'? inki taqe reh.</para>
  <para style="p">
    <verse number="26" style="v" />Re' Juan je' wili i xuq'or:</para>
  <para style="p">Korik re' hin i nub'an i qasanik ha' xa re' la' xa ruuk' ha'. Eh chaxilak taq i hat jinaj i wilik xa re' la', ma' aweht'al ta taq wach, <verse number="27" style="v" />re' i k'ulik iloq reh chi wiij. Re' hin ni xata naq i ruk'ul chi hin chejel reh i q'ab' i ruxijab' chi rooq, inki.</para>
  <para style="p">
    <verse number="28" style="v" />Chu'nchel i wili ar xk'ularik chupaam i ye'aab' Betania, wilik parelb'aal q'iij ree nim ha' Jordán, re' xub'an wii' qasanik ha' i Juan.</para>
  <para style="s">Re' i Jesús i Rak'uun i Dios, je' rukab' i k'isa rak'uun tentzun</para>
  <para style="p">
    <verse number="29" style="v" />Eh chi junwaar chik, re' i Juan aj qasan ha' xrilow chi xooj k'oloq ruuk' i Jesús, je' wili xuq'or: Re' wili i Rak'uun i Dios, je' k'isa rak'uun tentzun, re' reh ineesanik reh i kimahk i tinamit. <verse number="30" style="v" />Re' aj i reh i xnuq'or cho rib'iral noq xnuq'or chi je' wili: Chi wiij i hin jinaj i k'ulik iloq reh q'e' nim rajaawriik chi nuwach i hin, ruum xa wilik wo' chaloq noq komajaa' kin-aasjik i hin, inki. <verse number="31" style="v" />Eh re' hin ma' weht'al ta wo' naq wach i reh. Xa re' la', xnutoq'aa' chaloq i qasanik ha' ruuk' ha', re' inwaaj i hin chi neenkinab'eej i aj Israel awach i reh, inki. <verse number="32" style="v" />Re' Juan aj qasan ha' xuq'or wo' i korik noq xuq'or cho chi je' wili: Re' hin xti xwilow noq xqajik cho pan taxaaj i Santolaj Uxlab'al, xk'ulik qohoq chinaah i Jesús chi je' ruwii' paloma. <verse number="33" style="v" />Re' hin ma' weht'al ta wo' naq awach i reh. Eh re' Dios xpaab'anik weh chi qasanik ha', je' wili i xuq'or weh: Awach aj chinaah naa awilom chi naa ruk'uliik ruye'em riib' i Santolaj Uxlab'al, re' reh imb'anik i qasanik ha' ruuk' i Santolaj Uxlab'al, inki. <verse number="34" style="v" />Re' hin xti xwilow chik wach, naa nuq'orom rib'iral chi re' reh Rak'uun i Dios, inki.</para>
  <para style="s">Re' taqe i peet raj tahqaneel i Jesús</para>
  <para style="p">
    <verse number="35" style="v" />Eh chi junwaar, wilik wo' chik ar i Juan aj qasan ha', kiib' taqe i raj tahqaneel ruch'ihil. <verse number="36" style="v" />Eh noq xrilow i Juan chi ik'ik i rub'an i Jesús, je' wili xuq'or: Chawilow taq re' wili i Rak'uun i Dios, je' k'isa rak'uun tentzun inki. <verse number="37" style="v" />Noq xkib'iraj chi je' re' i ki'ib' chi raj tahqaneel i Juan, xkitahqeej reje i Jesús. <verse number="38" style="v" />Re' Jesús xtz'ehtanik reje chi riij. Eh noq xrilow chi tahqalimaj kuum i re', xupahqaaj keh chi je' wili:</para>
  <para style="p">¿Chib'ih taq inasik' i hat? inki.</para>
  <para style="p">Re' keh je' wili i xkiq'or:</para>
  <para style="p">Aj Tijineel, ¿aha' wilik apatal? inki taqe reh.</para>
  <para style="p">
    <verse number="39" style="v" />Eh re' i Jesús je' wili i xuq'or:</para>
  <para style="p">Taq taq chawilow, inki.</para>
  <para style="p">Eh xiooj wo' chi rilariik aha' wilik rupatal. Eh ar xi okik q'iij ruum je' naa chik kijib'ora ruqajiik i q'iij xi ponik ar. <verse number="40" style="v" />Re' i jinaj keh i ki'ib' i xi ib'irinik reh i xuq'or i Juan, re' i xi tahqinik reje reh i Jesús, re' i Andres, ruchaaq' i Simón eh Pedro i rukab' b'ih. <verse number="41" style="v" />Re' peet xub'an i Andres chi junwaar, re' chi xooj chusik'ariik i ras, Simón. Noq xureq, je' wili xuq'or reh:</para>
  <para style="p">Re' hoj xqareq chik i Cristo, inki. (Re' Cristo iraaj ruq'orom Sik'ooj cho wach.)</para>
  <para style="p">
    <verse number="42" style="v" />Eh re' Andres xuk'am reje i Simón ruuk' i Jesús, noq xrilow wach i Simón, je' wili i xuq'or reh:</para>
  <para style="p">Re' hat i Simón, i rak'uun i Jonás, eh Cefas chik i naa ab'ihnaam, inki. (Cefas iraaj ruq'orom Pedro.)</para>
  <para style="s">Re' Jesús xuyuq'eej chi riij i Felipe ruch'ihil i Natanael</para>
  <para style="p">
    <verse number="43" style="v" />Eh chi junwaar i Jesús xooj Galilea. Ar xureq i jinaj i winaq, Felipe rub'ihnaal, je' wili i xuq'or:</para>
  <para style="p">Taq chi wiij, inki reh.</para>
  <para style="p">
    <verse number="44" style="v" />Re' Felipe re' re' aj Betsaida, re' i rutinamiit i Andres ruch'ihil i Pedro. <verse number="45" style="v" />Re' Felipe xureq, Natanael, je' wili i xuq'or reh:</para>
  <para style="p">Re' hoj xqareq chik rutz'ihb'aam chaloq i Moisés i paruhujil i k'uhb'aal, re' wo' i kitz'ihb'aam chaloq i jalal ruq'oral i Dios. Re' i Jesús, aj Nazaret, rak'uun i José, inki.</para>
  <para style="p">
    <verse number="46" style="v" />Re' Natanael je' wili xuq'or:</para>
  <para style="p">¿Mi nee nelik cho k'isinoq re' i ma' xta reet Nazaret? inki.</para>
  <para style="p">Re' Felipe je' wili xuq'or:</para>
  <para style="p">Kim, taq chawilow, reh chi nee nawil chi korik i nuq'or, inki.</para>
  <para style="p">
    <verse number="47" style="v" />Re' i Jesús noq xrilow chi xponik i Natanael, je' wili xuq'or reh:</para>
  <para style="p">Wulu' xk'u'loq i winaq aj Israel, manlik aj nimaneel, ma' xta jot'ooj ruuk', inki.</para>
  <para style="p">
    <verse number="48" style="v" />Re' i Natanael, je' wili xuq'or:</para>
  <para style="p">¿Nik' wach noq xanab'eej nuwach? inki.</para>
  <para style="p">Re' Jesús je' wili xuq'or:</para>
  <para style="p">Re' hin xanoq wo' nunab'eem awach noq komajaa' tiruyuq'eej chaloq i Felipe, noq wilkaat chi ri'sil i ruche'el i higo, inki.</para>
  <para style="p">
    <verse number="49" style="v" />Eh re' i Natanael, je' wili xuq'or reh i Jesús:</para>
  <para style="p">Aj Tijineel, re' hat xti korik chi hat Rak'uun i Dios Eh hat kiReey i aj Israel inki.</para>
  <para style="p">
    <verse number="50" style="v" />Re' i Jesús je' wili xuq'or:</para>
  <para style="p">¿Mi xa ruum chi xnuq'or aweh chi xnunab'eej awach chi ri'sil i higo inanimaj chi je' re'? Ma' xata re' i re' ko ma' k'isiin la' i na'ojb'al naa nuk'uhtaam chawach, i nuchjik.</para>
  <para style="p">
    <verse number="51" style="v" />Eh re' Jesús je' wili i xuq'or:</para>
  <para style="p">Re' hin xti korik i nuq'or taq aweh chi naa taq awilom chi tehlik i chii' i taxaaj, chi re' taqe i ruánjel i Dios naakiqajiik naakijohtiik i naa nuwihiik wii' i hin, Ak'uunb'ees nuwii' winaq, inki.</para>
  <chapter number="2" style="c" />
  <para style="s">Re' i kaxáro xb'aan pan tinamit Caná wilik paruyuq'ul i Galilea</para>
  <para style="p">
    <verse number="1" style="v" />Eh ixib'-oq chik q'iij rub'aan taqe re', xb'aan jinaj i kaxáro pan tinamit Caná wilik paruyuq'ul i Galilea, eh wilik ar i rutuut i Jesús. <verse number="2" style="v" />Re' Jesús ruch'ihil taqe i raj tahqaneel xiyuq'ub'jik haa' chuninq'ijiik i kaxáro. <verse number="3" style="v" />Eh re' i rutuut i Jesús, je' wili i xuq'or:</para>
  <para style="p">Wak'uun, xk'uhlik i riis ki uuva.</para>
  <para style="p">¿Ma' nee ta naa rub'an chi neenatoob'eej taqe? inki.</para>
  <para style="p">
    <verse number="4" style="v" />Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Tuut, ¿chib'ih reet noq inaq'or weh chi je' re'? Re' hin komajaa' ta imponik i ru orahiil chi naa nub'anam i nukamaj, inki.</para>
  <para style="p">
    <verse number="5" style="v" />Eh re' i rutuut i Jesús je' wili i xuq'or keh i puhk inki a'n:</para>
  <para style="p">Re' taq cha a'n chu'nchel i nee taq ruq'or aweh i Jesús, inki.</para>
  <para style="p">
    <verse number="6" style="v" />Eh ar wilkeeb' i waqiib' chi nimaq ikom, ab'aj kiyej-aal, ye'aab' kihaa' i aj judío tz'ajb'al kiib' niimb'al reh i k'uhb'aal. Re' taqe nimaq taq ikom re' re', je' naa ox ox ikom chi ha' paam i ju'jun. <verse number="7" style="v" />Re' Jesús je' wili i xuq'or keh i puhk inki a'n:</para>
  <para style="p">Chanujisaj taq chi ha' taqe ikom wili, inki.</para>
  <para style="p">Re' keh xkinujisaj wo' chi korik taqe ikom. <verse number="8" style="v" />Eh re' i Jesús xusutej chi riis uuva i ha', eh je' wili i xuq'or keh:</para>
  <para style="p">Chalik taq reje i ha' re' re'. Chak'am taq reje reh inilwik reh i ninq'iij, inki.</para>
  <para style="p">Re' taqe i aj puhk xkik'am wo' reje. <verse number="9" style="v" />Eh re' inilwik reh i ninq'iij xunik'eej i ha' xsutinik chi riis uuva, eh ma' reht'al taj aha' xchalik. Xa re' wo' taqe i aj puhk kieht'alinik reh aha' xponik kilik. Eh re' inilwik reh i ninq'iij xutaq'aaj ruk'amariik i b'ahiilb'ees, <verse number="10" style="v" />je' wili i xuq'or reh:</para>
  <para style="p">Chu'nchel i winaq peet inkuk'ej i sik'oj wach riis uuva. Eh noq re' taqe i ulaa' k'ih chik i kuk'em, kora'j inkuk'ej re' i riis uuva ma' sik'ooj ta wach. Eh re' hat xamol peet i riis uuva sik'ooj wach, kore' pantz'apaab' wach reh i ninq'iij naa ruk'jiik, inki.</para>
  <para style="p">
    <verse number="11" style="v" />Eh re' xub'an re' re' i Jesús ar pan tinamit Caná wilik ar Galilea. Re' re' i peet ma' ilooj taj xuk'uhtaaj ruuk' i re' xuk'uhtaaj i ruloq'il. Eh re' taqe i raj tahqaneel xkichop kik'ux chunimjiik i reh.</para>
  <para style="p">
    <verse number="12" style="v" />Chi riij i re', re' Jesús xooj pan tinamit Capernaum ruch'ihil i rutuut, ruch'ihil taqe i ruchaaq', ruch'ihil taqe i raj tahqaneel. Ar xwihik chuwach i ki'ib' ixib' q'iij.</para>
  <para style="s">Re' Jesús xresaj taqe chaloq i aj k'aay parupaat i QaJaaw</para>
  <para style="r">(<ref loc="MAT 21:12-13">Mat 21.12-13</ref>; <ref loc="MRK 11:15-18">Mar 11.15-18</ref>; <ref loc="LUK 19:45-46">Luc 19.45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />Re' Jesús xooj Jerusaleem ruum xailook' chik i runinq'ijiik i elik chaloq Egipto. <verse number="14" style="v" />Eh noq xokik i koq i Jesús parupaat i QaJaaw, xureq taqe ar i k'ayen b'ooyax, i k'ayen tentzun, i k'ayen paloma. Eh tzunulkeeb' wo' nah kiméxa taqe i kich'aqwik wach tumiin. <verse number="15" style="v" />Re' i Jesús, xub'arkiij wach, rutz'uhuum. Ruuk' i re', xresaj taqe chaloq parupaat QaJaaw chu'nchel i aj k'aay kuch'ihil i kitentzuun, i kib'ooyax. Eh xutilej wach ak'al i kitumiin i kich'aqwik wach tumiin, xuk'ahwaaj reje wulu' i kiméxa. <verse number="16" style="v" />Eh je' wili i xuq'or keh i k'ayen paloma:</para>
  <para style="p">Chawesaj taq reje ayu' chu'nchel i wili. Maayejaa' taq chi k'aayb'al i rupaat i waJaaw inki.</para>
  <para style="p">
    <verse number="17" style="v" />Eh re' taqe i raj tahqaneel i Jesús, xk'ulik cho pankik'ux i tz'ihb'amaj cho pan santo laj huuj chi je' wili:</para>
  <para style="p">WaJaaw nuDios, re' hin q'e' nuk'ax aapaat, inki. <verse number="18" style="v" />Eh re' taqe i aj judío je' wili i xkiq'or reh i Jesús:</para>
  <para style="p">¿Chib'ih jino'q i ma' ilooj taj neenak'uhtaaj qeh, reh chi neenqanimaj chi wilik awajaawriik chub'aan taqe re'? inki taqe.</para>
  <para style="p">
    <verse number="19" style="v" />Re' Jesús je' wili i xuq'or keh:</para>
  <para style="p">Chayoj aj taq re' hat i rupaat i QaJaaw wili. Eh re' hin xa chuwach ixib' q'iij nee wo' chik inwuksaj, inki.</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' taqe i aj judío, je' wili xkiq'or reh:</para>
  <para style="p">Re' rupaat i QaJaaw wili, waqiib' roxk'ahl haab' xkorjik wii'. Eh ¿nik' wach noq inaq'or i hat chi xa chuwach ixib' q'iij neenaawuksaj? inki taqe.</para>
  <para style="p">
    <verse number="21" style="v" />Noq xq'orik chi riij i rupaat QaJaaw i Jesús, xak'ahchi' rujalwachem ruuk' i ruti'jolal i reh. <verse number="22" style="v" />Eh noq xwuktik wo' chik chaloq i chi k'achlik wach, re' taqe i raj tahqaneel xk'ulik cho pankik'ux i ruq'orom i Jesús. Eh xkinimaj chi chi riij i reh inq'orik i tz'ihb'amaj cho pan santo laj huuj. Eh xkinimaj wo' hoq i ruq'orom i Jesús.</para>
  <para style="s">Re' Jesús reht'al i ránima chu'nchel i tinamit</para>
  <para style="p">
    <verse number="23" style="v" />Noq wilik Jerusaleem i Jesús chupaam i runinq'ijiik i elik chaloq Egipto, ma' k'isiin i tinamit xkinimaj i Jesús, ruum xuk'uhtaaj keh i ma' ilooj taj ma' ha' ta chi je'. <verse number="24" style="v" />Re' Jesús ma' ruum tee re' xuch'ikaa' ruk'ux kuuk', ruum reht'al i kánima chi kunchelaal taqe re'. <verse number="25" style="v" />Eh ma' ruman taj chi awach ta xq'orik reh nik' wach noq wilkeeb' i tinamit, ruum re' reh reht'al chib'ih i wilik cho paránima i ju'jun.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' noq xuq'oreej i Jesús i Nicodemo</para>
  <para style="p">
    <verse number="1" style="v" />Jinaj i winaq, Nicodemo rub'ihnaal, wihinaq chaloq aj fariseo, k'amal kib'eeh i aj judío. <verse number="2" style="v" />Eh re' reh xooj ruuk' i Jesús chaq'ab', je' wili xuq'or reh:</para>
  <para style="p">Aj Tijineel, re' hoj qeht'al chi re' Dios xtaaq'anik chaaweh chi k'uhb'alinik, ruum ma' jino'q neemb'anik reh taqe i ma' ilooj taj i na a'n i hat wila' ma' chih i Dios ruuk', inki.</para>
  <para style="p">
    <verse number="3" style="v" />Eh re' i Jesús je' wili i xuq'or:</para>
  <para style="p">Re' hin xti korik i nuq'or aweh chi awach i ma' x-aasjik ruka'peech, ma' jaruuj naa rilom wach i runimaal i rajaawriik i Dios, inki.</para>
  <para style="p">
    <verse number="4" style="v" />Eh re' i Nicodemo je' wili i xuq'or reh i Jesús:</para>
  <para style="p">¿Nik' wach noq nee wo' chik inaasjik ruka'peech i winaq noq rijib' chik? ¿Nee oon i rub'an re' chi nee wo' chik inokik ruuk' i rutuut, eh nee wo' chik inaasjik ruka'peech? inki.</para>
  <para style="p">
    <verse number="5" style="v" />Re' Jesús je' wili i xuq'or reh:</para>
  <para style="p">Re' hin xti korik i nuq'or aweh chi awach i ma' x-aasjik ruuk' ha', ruuk' i Santolaj Uxlab'al, ma' jaruuj naa rokiik pa runimaal rajaawriik i Dios. <verse number="6" style="v" />Re' inaasjik ruuk' irutuutrajaaw, xa ruti'jolal wo' riib'. Eh re' inaasjik ruuk' i Santolaj Uxlab'al, Uxlab'al wo' hoq. <verse number="7" style="v" />Mansahchik ak'ux ruuk' i nuq'or aweh wili chi ajwaal wach chi chu'nchel naa kaasjiik ruka'peech. <verse number="8" style="v" />Re' teew xa aha' inik'ik hupinoq. Eh nab'iraj wo' naq i choqik i rub'an, xa re' la' ma' aweht'al taj aha' nooj, aha' inchalik eh ma' nawil ta wo' wach. Je' wo' re' i ki-aasjik ruuk' i Santolaj Uxlab'al ma' nilarik ta wo' wach, inki Jesús.</para>
  <para style="p">
    <verse number="9" style="v" />Eh re' i Nicodemo je' wili i xuq'or reh i Jesús:</para>
  <para style="p">¿Nik' wach noq wilik i re'? inki.</para>
  <para style="p">
    <verse number="10" style="v" />Re' Jesús je' wili xuq'or:</para>
  <para style="p">Re' hat, hat kaj tijoom i aj Israel, eh ¿nik' wach noq ma' nareq ta chi riij taqe i nuq'or wili? <verse number="11" style="v" />Re' hin xti korik i nuq'or aweh chi re' hoj re' inqaq'or i qeht'al, eh hoj wo' q'orol rib'iral i qilom chaloq. Xa re' la', re' taq i hat ma' nanimaj ta wo' taq inqaq'or taq aweh. <verse number="12" style="v" />Eh wila' ma' nanimaj taq weh noq kinq'orik chi riij i xa na'ojb'al wach ak'al, ¿nik' wach noq nee taq inanimaj weh wila' xinq'orik chi riij i na'ojb'al reh pan taxaaj? <verse number="13" style="v" />Chakoj taq rehtaal chi ma' awach ta jino'q johtinaq pan taxaaj xa re' wo' hin Ak'uunb'ees Dios nuwii' winaq, xinqajik cho pan taxaaj. <verse number="14" style="v" />Eh nik' wach noq xujosaj i aaq' q'an ch'ihch' ruyej-aal chi ju' chee' i Moisés panchiq yuuq', je' wo' re' hin, Ak'uunb'ees nuwii' winaq ajwaal wach chi naa nujohteesjiik chi ju' i chee', <verse number="15" style="v" />reh chi chu'nchel i naakinimaniik weh, naakehchaam i juneliik k'acharik, inki Jesús.</para>
  <para style="s">Re' ruk'axariik i tinamit wach ak'al xub'an chaloq i Dios</para>
  <para style="p">
    <verse number="16" style="v" />Re' Dios ma' k'isiin ta xuk'ax i tinamit wach ak'al. Ruum, xiruyeew chee hin chi kaj Ko'loom i hin Rak'uun jinaj chi wib'il wiib' chuwach, reh chi chu'nchel i naakinimaniik weh, ma' naa ta rusahchiik kiwach, naa la' ruwihiik kik'achariik chi juneliik. <verse number="17" style="v" />Re' Dios ma' xirutaq'aaj ta chaloq i hin Ak'uunb'ees ayu' wach ak'al chuye'ariik pantojb'al mahk i tinamit, xirutaq'aaj la' chaloq chi kikolob'jiik. <verse number="18" style="v" />Je' re' noq, awach i nimanik weh i hin Ak'uunb'ees Dios, ma' xta tojb'al mahk chinaah. Eh awach i ma' nimanik ta weh, ye'ooj chik i tojb'al mahk chinaah, ruum ma' kirunimaj taj i hin jinaj chi Ak'uunb'ees Dios. <verse number="19" style="v" />Eh ruum taqe yiib' wach inki a'n wilik chik i tojb'al mahk chikinaah. Ruum noq xk'ulik i Saqum ayu' wach ak'al, re' chik i q'equm q'e' xkaaj wach chuwach i Saqum, ruum yiib' wach i kina'ojb'al. <verse number="20" style="v" />Chu'nchel i kib'anik reh yiib' wach na'ojb'al inkixowaaj wach i Saqum ma' nkijil ta i koq kiib' ruuk' i Saqum, re' inkaaj chi ma' nelik ta wach Saqum i kiyiib' wach na'ojb'al. <verse number="21" style="v" />Eh re' taqe i k'ahchi' keeb' i korik, inkijil i koq kiib' ruuk' i Saqum, reh chi neenk'utinik chi chu'nchel i kian, re' aha' wilik iraaj i Dios, inki Jesús.</para>
  <para style="s">Re' Juan aj qasan ha' xq'orik chi riij i Jesús</para>
  <para style="p">
    <verse number="22" style="v" />Chi riij i re', re' Jesús ruch'ihil taqe i raj tahqaneel noq xiooj paruyuq'ul i Judea. Eh noq ruch'ihil taqe i raj tahqaneel ar i Jesús, najt xub'an i qasanik ha'. <verse number="23" style="v" />Eh chupaam taqe i q'iij re' re', re' Juan xub'an i qasanik ha' ar Enón, ma' najt ta ruuk' i Salim, ruum ma' k'isiin i raasb'al ha' ar, Eh re' i tinamit kiooj k'oloq ruuk' i Juan i ruqasaj kihaa'. <verse number="24" style="v" />Re' qasanik ha' wili re' xub'an i Juan noq komajaa' inkojarik pantz'ilom.</para>
  <para style="p">
    <verse number="25" style="v" />Eh wilik taqe i raj tahqaneel i Juan xkiwech'uj kiib' ruuk' jinaj i aj judío chi riij i saqb'isanik wachiis imb'aan niimb'al reh i k'uhb'aal. <verse number="26" style="v" />Eh xiooj k'oloq ruuk' i Juan je' wili i xkiq'or reh:</para>
  <para style="p">Qaj Tijineel, re' winaq xwihik cha wuuk' chi juntar i nim ha' Jordán, re' i xaq'or cho reh chib'ih rub'anam, k'ahchi' chi qasanik ha', eh chu'nchel i tinamit k'ahchi' kojiik chi riij, inki taqe.</para>
  <para style="p">
    <verse number="27" style="v" />Re' Juan je' wili i xuq'or keh:</para>
  <para style="p">Re' i winaq ma' xtaj i neerub'an wila' ma' re' Dios pan taxaaj inye'wik cho rajaawriik. <verse number="28" style="v" />Re' taq i hat xab'iraj taq ruuk' axikin noq xnuq'or chi ma' re' tee hin i Cristo, eh chi xa xinpa'ab'jik chaloq reh chi hin peet b'eeh chuwach chuq'orariik rib'iral i reh. <verse number="29" style="v" />Eh noq imb'aan kaxáro, re' ehk'eenb'ees, re' i b'ahiilb'ees inehchanik reh. Re' i ramigo i b'ahiilb'ees insuuqb'ik ruk'ux noq irib'iraj chi q'orik i rub'an i b'ahiilb'ees. Je' wo' re' i rusuqkiil nuk'ux i hin yu'naak, ruum xmanlojik chik wach. <verse number="30" style="v" />Re' Cristo, inchol chi neenjohtik i rajaawriik, eh re' hin, neenqajik i wajaawriik, inki Juan.</para>
  <para style="s">Re' Cristo pan taxaaj xchalik</para>
  <para style="p">
    <verse number="31" style="v" />Re' i xchalik pan taxaaj xiik' naah rajaawriik, eh wilik wo' rajaawriik chinaah chu'nchel i chib'ih jariik i wilik. Eh re' i aj wach ak'al, xa aj wach ak'al wo' hoq, chi riij wo' i wilkeeb' wach ak'al inq'orik. <verse number="32" style="v" />Eh re' i aj pan taxaaj inq'orik chi riij taqe i rilom, i rib'iram chaloq. Xa re' la', ma' awach ta nimanik reh taqe i ruq'or. <verse number="33" style="v" />Raaj awach i nimanik reh i ruq'oral, ruuk' i re' i rureq chi riij chi re' Dios xti korik i ruq'or. <verse number="34" style="v" />Re' taaq'amaj cho ruum i Dios, re' wo' taqe i ruq'oral i Dios i ruq'or, ruum re' Dios ma' pajooj taj i Ruxlab'al i ruyeew chinaah. <verse number="35" style="v" />Re' Ajaab'ees Dios i ruk'ax i Rak'uun, xuyeew rajaawriik chinaah taqe i xa chib'ih jariik wilik.</para>
  <para style="p">
    <verse number="36" style="v" />Eh awach i nimanik reh Ak'uunb'ees, wilik i ruk'achariik chi juneliik. Eh awach i ma' nimanik ta reh i Ak'uunb'ees, ma' xta ruk'achariik chi juneliik naa la' ruye'ariik pantojb'al mahk ruum i Dios.</para>
  <chapter number="4" style="c" />
  <para style="s">Re' noq xq'orob'jik ruum i Jesús ixoq aj Samaria</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe i aj fariseo xkinab'eej chi re' Jesús ma' k'isiin chik i raj tahqaneel, chi k'ih i tinamit i ruqasaj kihaa' chuwach i ruqasaj kihaa' i Juan. <verse number="2" style="v" />Xanaah re' ma' re' ta wo' Jesús imb'anik i qasanik ha', xa re' taqe i raj tahqaneel kib'anik. <verse number="3" style="v" />Noq xunab'eej i Jesús chi je' re' i k'ahchi' kiq'orom taqe re', xelik reje i Judea, xooj wo' chik Galilea. <verse number="4" style="v" />Eh noq xsutinik reje ar i Jesús, ajwaal wach chi xik'ik ponoq Samaria. <verse number="5" style="v" />Re' Jesús, xponik pan tinamit Sikar, wilik paruyuq'ul i Samaria, ma' najt ta ruuk' i rak'aal naq i Jacob, re' i xuyeew reh i rak'uun, José rub'ihnaal. <verse number="6" style="v" />Eh ar wilik jinaj i ha', rujul haa' i Jacob inkiq'or reh. Eh re' Jesús, xponik ar je' naa k'isiin ma' kab'lajora i q'iij, q'uhtinaq ruum i b'ehik, xutzunaa' i koq riib' chi chii' i jul ha' re' re'.</para>
  <para style="p">
    <verse number="7" style="v" />Eh jinaj ixoq aj Samaria xk'u'loq chi k'amaj ha' chupaam i jul ha' re' re'. Eh re' i Jesús je' wili i xuq'or reh:</para>
  <para style="p">Chasiij k'isinoq nuhaa', inki. <verse number="8" style="v" />Eh re' taqe i raj tahqaneel i Jesús ma' wilkeeb' ta ar, ruum xiooj chi loq'oj wi'k pan tinamit.</para>
  <para style="p">
    <verse number="9" style="v" />Ruum chi ma' nkiq'o'reej ta kiib' i aj judío kuuk' i aj Samaria, je' wili xuq'or reh i Jesús:</para>
  <para style="p">Re' hat, hat aj judío ¿nik' wach noq inapahqaaj ahaa' weh? Re' hin, hin aj Samaria, inki.</para>
  <para style="p">
    <verse number="10" style="v" />Re' Jesús je' wili xuq'or reh:</para>
  <para style="p">Neeta naq inanab'eej i kooch i ruyeew i Dios, nee ta nanaab'eej awach i hin i k'ahchi' nupahqaam nuhaa' aweh, re' hat nee naq inapahqaaj ahaa' weh, eh re' hin neen naq i nuyeew aweh i ha' inye'wik k'acharik, inki.</para>
  <para style="p">
    <verse number="11" style="v" />Re' ixoq je' wili i xuq'or reh i Jesús:</para>
  <para style="p">Jaaw, ni xata wilik ehteesb'al reh i ha' awuuk', re' jul ha' wili q'e' chaam paam. ¿Aha' nee nak'am i ha' inye'wik k'acharik inaq'or weh? <verse number="12" style="v" />¿Mi xiik' chik naah awajaawriik re' hat chuwach i xikin cho qamaam Jacob, re' xkananik qeh i jul ha' wili re' i xuk'ik cho wii' i reh, taqe i rak'uun rixq'uun, re' wo' i xiuk'ik wii' taqe i ruchikoop? inki.</para>
  <para style="p">
    <verse number="13" style="v" />Re' Jesús je' wili ruchaq'weesjiik ixoq xub'an:</para>
  <para style="p">Chu'nchel i kiuk'inik reh i jul ha' wili naa wo' chik ruchiqiik kichii'. <verse number="14" style="v" />Re' i naa ruk'iniik reh i ha' naa nuye'em i hin, ma' naa ta chik ruchiqiik chii' chi jumpech. Re' ha' re' re', je' naa rukab' jino'q i raasb'al ha' paránima, eh re' re' naa ruye'wiik reh i juneliik k'acharik, inki.</para>
  <para style="p">
    <verse number="15" style="v" />Re' ixoq je' wili xuq'or:</para>
  <para style="p">Jaaw, cha kuy chayeew weh chi uuk'jik i k'achlik ha' inaq'or, reh chi ma' nee ta chik inchiqik nuchii', eh ma' nee ta chik kinchalik chi k'amaj ha' ayu', inki.</para>
  <para style="p">
    <verse number="16" style="v" />Re' Jesús je' wili i xuq'or reh ixoq:</para>
  <para style="p">Hiy chak'am ab'ahiil, eh nee wo' chik ti sutinik chaayu', inki.</para>
  <para style="p">
    <verse number="17" style="v" />Re' hin ma' xta nub'ahiil, inki ixoq.</para>
  <para style="p">Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Korik i xaq'or chi ma' xta b'ahiil. <verse number="18" style="v" />Ruum ho'oob' i winaq ik'inaq awuuk', eh ma' jino'q keh i xapab'alej. Eh re' winaq wilik awuuk' yu'naak, ma' hat ta wo' kaxáro ruuk', xti korik i xaq'or, i nuchjik.</para>
  <para style="p">
    <verse number="19" style="v" />Eh re' ixoq je' wili i xuq'or reh i Jesús:</para>
  <para style="p">Jaaw, re' hin xnureq chik chi riij chi hat ta b'ila' jalal ruq'oral i Dios. <verse number="20" style="v" />Re' taqe i qamaam qati't aj ayu' Samaria chinaah i yuuq' wili xkiloq'ej chaloq i Dios. Eh re' taq i hat, i hat taq aj judío, inaq'or taq chi Jerusaleem naa rulooq'jiik i Dios, inki.</para>
  <para style="p">
    <verse number="21" style="v" />Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Ixoq, cha nimaj chi k'isiin ma' rureq i q'iij chi ma' koruman ta chik chi nee taq ti chalik chinaah i yuuq' wili, eh chi nee taq tiooj Jerusaleem chulooq'jiik i Ajaab'ees Dios. <verse number="22" style="v" />Re' taq i hat, i hat taq aj ayu' Samaria, ma' aweht'al ta taq awach inaloq'ej. Eh re' hoj, i hoj aj judío, qeht'al awach inqaloq'ej, ruum re' ko'lemb'al iib' chi qaxilak i hoj inchalik. <verse number="23" style="v" />Eh xureq chik i ruq'ijil, eh yu'naak i ru orahiil, chi re' taqe i korik laj aj loq'ineel reh Ajaab'ees Dios naa kiloq'em chi korik eh panuxlab'al naa kianam, ruum je' re' iraaj Ajaab'ees Dios chi naa kianam awach i naakiloq'iniik reh. <verse number="24" style="v" />Re' Dios xa Uxlab'al wo' hoq. Ruum aj re', awach i naakiloq'iniik reh, ajwaal wach chi naa kiloq'em chi korik eh pan Uxlab'al naa kianam, inki Jesús.</para>
  <para style="p">
    <verse number="25" style="v" />Eh re' ixoq, je' wili i xuq'or reh i Jesús:</para>
  <para style="p">Re' hin weht'al chi naa ruk'uliik iloq i q'orooj cho rib'iral, re' i Cristo. Eh na' k'oloq, re' reh naa ruch'ob'wiik rub'ehel qeh taqe re', inki.</para>
  <para style="p">
    <verse number="26" style="v" />Re' Jesús je' wili i xuq'or reh ixoq:</para>
  <para style="p">Re' i k'ulik chaloq reh inaq'or re' re', re' i hin, i k'utaaj i nub'an awuuk', inki.</para>
  <para style="p">
    <verse number="27" style="v" />Eh manlik xiooj k'oloq i raj tahqaneel i Jesús. Eh noq xkilow i Jesús chi k'utaaj i rub'an ruuk' ixoq, xsahchik kik'ux. Xa re' la' ma' xkipahqaaj ta ree Jesús chib'ih iraaj ixoq ruuk', eh chib'ih i k'ahchi' kik'utjaam ruuk'. <verse number="28" style="v" />Eh re' ixoq xukanaa' kahnoq i rikoom chi chii' i jul ha', xooj-lom pan tinamit chuq'orariik keh i tinamit chi je' wili:</para>
  <para style="p">
    <verse number="29" style="v" />Taq taq chawilow jinaj i winaq wilik wulu'. Re' reh xuq'or weh chu'nchel chib'ih jariik i nub'anam, re' ta b'ila' i Cristo naa ruk'uliik iloq inkiq'or, inki.</para>
  <para style="p">
    <verse number="30" style="v" />Noq xkib'iraj chi je' re' i tinamit, xiooj-lom aha' wilik wii' i Jesús.</para>
  <para style="p">
    <verse number="31" style="v" />Eh je' wili i xq'orarik reh i Jesús kuum i raj tahqaneel:</para>
  <para style="p">Qaj Tijineel, cha kuy chak'ux k'isinoq awa', inki taqe reh.</para>
  <para style="p">
    <verse number="32" style="v" />Eh re' reh je' wili i xuq'or:</para>
  <para style="p">Re' hin wilik i nuwa' k'ahchi' nuk'uxlaam wii' wiib' xa re' la', re' taq i hat ma' aweht'al ta taq chib'ih jariik, inki.</para>
  <para style="p">
    <verse number="33" style="v" />Re' taqe i raj tahqaneel k'ul xkipahqaaj chikiwach chi je' wili:</para>
  <para style="p">¿Chib'ih reet noq i ruq'or i je' re'? ¿Xk'amarik la' naa cho ruwa'? inki taqe.</para>
  <para style="p">
    <verse number="34" style="v" />Eh re' Jesús je' wili xuq'or:</para>
  <para style="p">Re' i nuwa' i nuq'or taq aweh i hin, re' i rub'anariik iraaj i xtaaq'anik cho weh, reh chi naa nukohlaam wach i rukamaj. <verse number="35" style="v" />Re' taq i hat je' taq wili inaq'or: Kopan kijib' poh inqa a'n i jach, tiki taq, je' wo' re' taq inakapaaj yu'naak. Eh re' hin i nuq'or taq aweh chi chakoj taq reje rehtaal taqe i je' tik xiq'anb'ik chik i ruq'ijil chik i kijacharik. <verse number="36" style="v" />Re' imb'anik i jach i ruk'ul i rutojb'aal, re' wach i je' tik i rumol reh i juneliik k'acharik. Chi je' xtikwik reh, chi je' xjachwik reh, pan kiib'al neensuuqb'ik kik'ux. <verse number="37" style="v" />Eh re' q'orik i ruq'or chi je' wili xti korik: Jinaj intikwik reh, eh tokoom chik injachwik reh, inki. <verse number="38" style="v" />Re' hin xat nutaq'aaj taq reje i hat chu jacharik i wach i ma' akamaneem ta taq wach. Tokoom xib'anik kamanik, eh re' taq chik i hat k'ahchi' ab'aniik rusuqkiil, inki Jesús.</para>
  <para style="p">
    <verse number="39" style="v" />Eh ma' k'isiin i wilkeeb' pan tinamit wilik paruyuq'ul i Samaria, xinimanik reh i Jesús ruum i xuq'or ixoq noq xuq'or keh i korik chi je' wili: Re' reh xuq'or weh chu'nchel chib'ih jariik i nub'anam, inki. <verse number="40" style="v" />Eh noq xi ponik taqe i aj paruyuq'ul i Samaria chi chii' jul ha' i wilik wii' i Jesús, xkipahqaaj otob'il reh chi naa rukahniik kuuk' pan kitinamiit, eh kiib' wo' q'iij xkahnik kuuk' ar. <verse number="41" style="v" />Noq xkib'iraj i tinamit i xuq'or i Jesús, ma' k'isiin i xinimanik reh, <verse number="42" style="v" />eh je' wili i xkiq'or reh ixoq:</para>
  <para style="p">Yu'naak xqanimaj chik i Jesús i hoj, ma' xata ruum i xaq'or qeh i hat, ruum la' chi re' hoj xqib'iraj ruuk' qaxikin taqe i xuq'or i reh. Ruuk' i re', xqanab'eej chi re' reh aj Ko'len keh i tinamit wach ak'al, inki taqe.</para>
  <para style="s">Re' Jesús xuk'achrisaj i rak'uun jinaj i winaq raj kamanoom i reey</para>
  <para style="p">
    <verse number="43" style="v" />Noq xik'ik i kiib' q'iij, re' Jesús xelik wo' chik reje Samaria, xooj Galilea. <verse number="44" style="v" />Re' wo' reh xq'orik chi jino'q i jalal ruq'oral i Dios ma' inye'arik ta ruloq'il parutinamiit. <verse number="45" style="v" />Noq xponik ar Galilea, xk'ularik cho chi korik kuum taqe i aj ar, ruum re' Jesús poninaq wo' Jerusaleem chi rik'teesjiik i runinq'ijiik i elik chaloq Egipto, eh kilom wo' chaloq chu'nchel i ma' ilooj taj rub'anam cho ar.</para>
  <para style="p">
    <verse number="46" style="v" />Eh re' Jesús xsutinik wo' chik reje ar Caná wilik paruyuq'ul i Galilea, re' i xusutej wii' chi riis uuva i jot'ik. Eh wilik Capernaum jinaj i winaq nim wach rukamaj ruuk' i reey, yowaab' jinaj i rak'uun. <verse number="47" style="v" />Eh noq xrib'iraj rib'iral chi re' Jesús xelik chaloq Judea eh xooj Galilea, xooj ruuk' i Jesús. Eh xupahqaaj otob'il reh i Jesús chi naa rojiik parupaat, chuk'achreesjiik i rak'uun xakimik chik reh. <verse number="48" style="v" />Eh re' Jesús je' wili xuq'or:</para>
  <para style="p">Re' taq i hat ma' jaruuj taq nee kinanimaj wila' ma' xnuk'uhtaaj taq chawach taqe i ma' ilooj taj q'e' nimaq kiwach, inki.</para>
  <para style="p">
    <verse number="49" style="v" />Re' winaq raj kamanoom i reey je' wili i xuq'or:</para>
  <para style="p">Jaaw taq tii chi wiij chi jumehq'iil, chak'achrisaj chee i wak'uun komajaa' naq inkimik yu'naak, inki.</para>
  <para style="p">
    <verse number="50" style="v" />Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Hiy ti sutinoq reje panapaat. Re' awak'uun xk'achjik chik i nuchjik.</para>
  <para style="p">Eh re' winaq xunimaj i xq'orarik reh, xooj wo' hoq. <verse number="51" style="v" />Eh noq sutinik i rub'an reje parupaat i winaq, xi chalik rumoso chuk'ulariik, je' wili i xkiq'or reh:</para>
  <para style="p">Jaaw, re' awak'uun xk'achjik chik inki taqe reh.</para>
  <para style="p">
    <verse number="52" style="v" />Eh xupahqaaj keh nik' xtohq'ik riik'raam i rak'uun chi xtohq'ik rub'anam saqb'ih. Re' taqe rumoso je' wili i xkiq'or:</para>
  <para style="p">Eew jinajora ruqajiik i q'iij xik'ik i kaq tz'a' chi riij, inki taqe.</para>
  <para style="p">
    <verse number="53" style="v" />Re' rajaaw i aak'un xukoj rehtaal chi chupaam i ora re' re' xq'orarik reh ruum i Jesús chi xk'achjik chik i rak'uun. Eh re' reh xunimaj i Jesús, je' wo' taqe i awach reh parupaat. <verse number="54" style="v" />Re' wili i rukab' i ma' ilooj taj nim wach xuk'uhtaaj i Jesús ar Galilea noq xelik chaloq Judea.</para>
  <chapter number="5" style="c" />
  <para style="s">Re' Jesús xuk'achrisaj jinaj i winaq siik ar Betesda</para>
  <para style="p">
    <verse number="1" style="v" />Eh komajaa'-oq wo' najtir imb'aan taqe re', re' Jesús xooj wo' chik Jerusaleem chi rik'tesjiik jinaj i ninq'iij xkik'saj i aj judío.</para>
  <para style="p">
    <verse number="2" style="v" />Eh ar Jerusaleem, ma' najt ta ruuk' i puerta kiokik wii' tentzun, wilik jinaj i molb'al ha', Betesda rub'ihnaal pan hebreo, ho'oob' i rookb'aal <verse number="3" style="v" />Eh ma' k'isiin i yowaab' yokolkeeb' ar wilik taqe i moywach wilik taqe i ma' manlik ta wach kooq, wilik taqe i siik. Re' keh wilkeeb' i koq ar chi ruyub'jiik chi naa ruk'uyu'jiik i ha'. <verse number="4" style="v" />Ruum re' ánjel najt xilak noq ink'ulik qohoq chi ruk'uyu'teesjiik paam i mama' jul ha' re' re', reh chi awach i peet neerumin riib' chupaam i ha' noq k'uyu'jik i rub'an, neenk'achjik ruuk' i ruyab'ilaal xa chib'ih pa' jariik i ti' imb'anik reh. <verse number="5" style="v" />Eh chi kixilak yowaab' re' re', wilik jinaj i winaq waxaqlaj ru ka'winaq haab' ruchaliik ruyab'ilaal. <verse number="6" style="v" />Noq xrilow i Jesús chi yoklik ar i winaq re' re', eh xureq chi riij chi najtir inokik pan yab'ilaal, xupahqaaj reh chi je' wili:</para>
  <para style="p">¿Mi nawaaj chi nee tik'aachjik ruuk' ayab'ilaal? inki reh.</para>
  <para style="p">
    <verse number="7" style="v" />Eh re' yowaab' je' wili xuq'or:</para>
  <para style="p">Jaaw, xti q'e' la' naq inwaaj naq'or, xa re' la', ma' wach ta i minwik qohoq weh panha' noq k'uyu'jik i rub'an. Eh jarpech naq i numin wiib' i hin, tokoom chik inkimin qohoq kiib' chi peet, inki.</para>
  <para style="p">
    <verse number="8" style="v" />Re' Jesús je' wili i xuq'or reh i yowaab':</para>
  <para style="p">Wukteen johtoq, hiy panapaat, chak'am reje ach'aht, inki.</para>
  <para style="p">
    <verse number="9" style="v" />Eh re' winaq xa chupaam wo' jumehq' re' re' xk'achjik, xutoq'aa' reje b'ehik xuk'am reje i ruch'aht. Eh ruum chi pan hi'limb'al q'iij xub'an i re'.</para>
  <para style="p">
    <verse number="10" style="v" />Re' taqe i k'amal kib'eeh i aj judío je' wili i xkiq'or reh i winaq xk'achreesjik:</para>
  <para style="p">Yu'naak i hi'limb'al q'iij. Mahk chuwach i k'uhb'aal chi atehlaam ach'aht, inki taqe reh.</para>
  <para style="p">
    <verse number="11" style="v" />Re' winaq, je' wili i xuq'or:</para>
  <para style="p">Re' hin, re' winaq xk'achrisanik weh xq'orik weh chi naa nuk'amam reje i nuch'aht eh xnuk'am wo' reje, inki.</para>
  <para style="p">
    <verse number="12" style="v" />Re' keh xkipahqaaj reh i winaq chi je' wili:</para>
  <para style="p">¿Awach i winaq xq'orik aweh chi tib'ehoq eh chak'am reje ach'aht? inki taqe.</para>
  <para style="p">
    <verse number="13" style="v" />Xanaah re', re' winaq re' re' ma' xunab'eej ta wach awach xk'achrisanik reh, ruum re' Jesús jumehq'iil xsahchik chi kixilak i ruk'ihaal tinamit wilkeeb' i koq ar. <verse number="14" style="v" />Chi riij i re', re' Jesús xureq i winaq parupaat i Dios, je' wili i xuq'or reh:</para>
  <para style="p">Yu'naak xatk'achjik chik, mat mahkunik chik reh chi ma' nee ta nchalik cha naah jino'q i ti' k'axik q'e' chik nim wach, inki.</para>
  <para style="p">
    <verse number="15" style="v" />Eh re' i winaq re' re' jumehq'iil xooj chuq'orariik keh i k'amal kib'eeh i aj judío chi re' i Jesús xk'achrisanik reh. <verse number="16" style="v" />Re' taqe i k'amal kib'eeh i aj judío ruum i re' xkixowaaj wach i Jesús, ruum pan hi'limb'al q'iij xub'an taqe i k'achrisanik. <verse number="17" style="v" />Eh re' Jesús je' wili xuq'or keh:</para>
  <para style="p">Re' waJaaw ma' inhi'lik ta chi kamanik, je' wo' hin, inki.</para>
  <para style="p">
    <verse number="18" style="v" />Eh ruum i re', re' taqe i k'amal kib'eeh i aj judío tix kaaj naq kikansam i Jesús, ma' xata ruum chi rub'an i k'aachrisanik pan i hi'limb'al q'iij, ruum la' wo' hoq chi rupaj riib' ruuk' i Dios, eh chi xuq'or chi re' Dios i raJaaw.</para>
  <para style="s">Re' i rajaawriik i Rak'uun i Dios</para>
  <para style="p">
    <verse number="19" style="v" />Re' Jesús je' wili i xuq'or keh:</para>
  <para style="p">Re' hin xti korik taq i nuq'or aweh chi re' hin, i Rak'uun i Dios, ma' xtaj ineenub'an chi wib'il wiib' xa re' la' wo' nub'an i rub'an i waJaaw. Eh chu'nchel i rub'an i waJaaw, re' wo' chik i re' i nub'an i hin, Ak'uunb'ees Dios. <verse number="20" style="v" />Eh re' i waJaaw kiruk'ax i hin Ak'uunb'ees, eh i ruk'uhtaaj weh chu'nchel i rub'an i reh. Re' reh ko ma' k'isiin i nimaq kiwach ma' ilooj taj chuwach i k'achrisanik xnub'an re' re' naa ruk'uhtaam weh, eh re' taq i hat naa taq rusahchiik ak'ux ruum. <verse number="21" style="v" />Nik' wach noq i ruyeew kik'achariik kamnaq i waJaaw, je' wo' re' i nub'an i hin Ak'uunb'ees i nuyeew wo' kik'achariik awach inwaaj nuye'em kik'achariik. <verse number="22" style="v" />Eh re' i waJaaw, ma' awach taj i ruq'at i q'orik chinaah. Re' la' i hin, i hin Rak'uun, ruye'em wajaawriik chi q'ataj q'orik, <verse number="23" style="v" />reh chi naa ruye'ariik nuloq'il i hin, Ak'uunb'ees, je' rukab' noq inye'arik i ruloq'il Ajaab'ees. Awach i ma' ruyeew ta nuloq'il i hin, ma' ruyeew ta wo' ruloq'il i waJaaw xtaaq'anik cho weh.</para>
  <para style="p">
    <verse number="24" style="v" />Re' hin xti korik taq i nuq'or aweh chi awach i nib'irinik reh i nuq'oral, eh i runimaj awach i xtaaq'anik cho weh, wilik ruk'achariik chi juneliik. Eh ma' naa ta rojiik pantojb'al mahk, ruum ik'inaq chik chi riij i kimik, k'acharik chik i xye'arik reh. <verse number="25" style="v" />Re' hin xti korik i nuq'or taq aweh chi naa ruponiik i q'iij, eh yu'naak i ru orahiil, chi re' taqe i kamnaq naa kib'iram i nuq'oral i hin, Ak'uunb'ees Dios. Eh awach taqe i naa ki-ib'iriniik reh i nuq'oral, naa ruwihiik kik'achariik. <verse number="26" style="v" />Eh re' waJaaw wilik ruk'achariik chi rib'il riib'. Je' wo' re' i hin Ak'uunb'ees i ruyeew wo' wajaawriik chi wilik nuk'achariik chi wib'il wiib'. <verse number="27" style="v" />Eh ruye'em wo' wajaawriik chi q'ataj q'orik i hin Ak'uunb'ees nuwii' winaq ruum hin wo' Rak'uun i reh. <verse number="28" style="v" />Je' re' noq, mansahchik taq ak'ux ruuk' taqe re', ruum naa ruponiik i q'iij chi chu'nchel i kamnaq naa kib'iram i nuq'oral. <verse number="29" style="v" />Eh re' taqe i xib'anik reh i holohik naakik'aach cho ruka'peech chuk'ulariik i juneliik k'acharik. Eh re' taqe i xib'anik reh yiib' wach naakik'aach cho ruka'peech chuk'ulariik i tojb'al mahk, inki Jesús.</para>
  <para style="s">Re' k'uhtb'al reh chi korik chi wilik rajaawriik i Jesús</para>
  <para style="p">
    <verse number="30" style="v" />Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Re' hin ma' xtaj ineenub'an xa chi wib'il wiib'. Re' hin i nub'an i q'ataj q'orik nik' wach i ruq'orom weh i waJaaw. Ma' re' taj inwaaj i hin re' la' nub'an iraaj i waJaaw xtaaq'anik cho weh. <verse number="31" style="v" />Xata re' hin neenuq'or wiib' chi korik wach nuk'ux, ma' xta naq neenokik wii', ma' nee ta naq inimjik. <verse number="32" style="v" />Jinaj la' chik ixq'orik chi wiij i hin chi rub'ehel i k'ahchi' kiin. Eh re' hin weht'al chi re' i re' neenk'uhtanik reh chi korik taqe i k'ahchi' nuq'orom. <verse number="33" style="v" />Re' taq i hat pan jinaj cho q'iij xataq'aaj taq rupahqaljiik ree Juan aj qasan ha' mi re' reh i Cristo. Eh i xuq'or cho chi wiij i reh, re' re' xti korik. <verse number="34" style="v" />Xa re' la', re' hin ma' re' ta jino'q winaq inq'orik i korik chi wiij. Re' wili i nuq'or taq aweh re' inwaaj i hin chi nee taq inasik' i ko'lb'al awiib'. <verse number="35" style="v" />Re' Juan aj qasan ha' xa je' jino'q saqumb'al insihq'inik noq xwihik chaloq. Eh re' taq i hat xama' najt ta wo' taq xa a'n rusuqkiil i Saqum xuq'or rib'iral. <verse number="36" style="v" />Xa re' la', jinaj wo' chik i q'e' nim wach chuwach i xuq'or chaloq i Juan ink'uhtanik reh chi korik wach nuk'ux. Re' taqe i nub'an, re' xuq'or weh i waJaaw, re' aj i re' ink'uhtanik reh chi korik chi re' i waJaaw xtaaq'anik cho weh. <verse number="37" style="v" />Eh re' waJaaw xtaaq'anik cho weh ruk'uhtaaj wo' hoq chi korik wach nuk'ux, ma' re' ta nkiwii' chi ma' jank'al ta taq inab'iraj nik' wach inq'orik, eh ni xata jank'al taq inawil wach. <verse number="38" style="v" />Eh ni xata re' i ruk'uhb'aal amolom taq panawánima, ruum ma' kinanimaj ta taq i hin, hin Rak'uun, i xirutaq'aaj chaayu' wach ak'al. <verse number="39" style="v" />Re' taq i hat cha tijej taq riij chi korik i ruq'oral i Dios tz'ihb'amaj pan santo laj huuj ruum ar taq neenareq i juneliik k'acharik. Eh re' wo' santo laj huuj inq'orik i korik chi wiij i hin. <verse number="40" style="v" />Eh re' taq i hat, xama' nawaaj ta wo' taq kinanimam. Ruum i re', ma' naa ta taq areqem i juneliik k'acharik.</para>
  <para style="p">
    <verse number="41" style="v" />Re' hin xama' xta nokik wii' chi weh i runimaal wachiis inkiyeew i xa winaq. <verse number="42" style="v" />Eh je' wo' re' hin weht'al taq ana'ojb'al, weht'al chi ma' nak'ax ta taq i Dios. <verse number="43" style="v" />Re' hin re' waJaaw xtaaq'anik cho weh, eh re' taq i hat xama' kinanimaj ta wo' taq. Raaj nee ta nk'u'loq jino'q xa runa'ojb'al riib', re' naq taq neenanimaj. <verse number="44" style="v" />Re' taq i hat xama' jaruuj wo' taq naa animaniik, ruum xa re' taq i hat k'ul i nayeew runimaal awach. Eh ma' inasik' ta taq i runimaal wachiis i ruyeew i jinaj chi Dios. <verse number="45" style="v" />Eh maakapaaj inche taq i hat chi re' hin naa nuq'oriik i koq reh i waJaaw chi wilik taq amahk. Re' inq'orik i koq chi wilik taq amahk, re' i Moisés i ch'iklik taq wii' ak'ux yu'naak. <verse number="46" style="v" />Eh wi ta nanimaj taq i hat i xuq'or i Moisés, nee wo' naq taq kinanimaj i hin, ruum re' i reh chi wiij wo' hin xq'orik chaloq. <verse number="47" style="v" />Raaj wi ma' nanimaj taq i rutz'ihb'aam chaloq i Moisés, ¿nik' wach noq nee taq inanimaj i nuq'or taq aweh i hin? inki i Jesús.</para>
  <chapter number="6" style="c" />
  <para style="s">Re' Jesús xuket i ho'oob' miil chi tinamit</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14.13-21</ref>; <ref loc="MRK 6:30-44">Mar 6.30-44</ref>; <ref loc="LUK 9:10-17">Luc 9.10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Eh chi riij i re', re' Jesús xooj chi juntar i k'isa palaw wilik Galilea, re' wo' i k'isa palaw wilik Tiberias. <verse number="2" style="v" />Re' Jesús, ma' k'isiin i tinamit xtahqinik reje reh, ruum xkilow i ma' ilooj taj xub'an kuuk' i kik'achreesjiik i yowaab'. <verse number="3" style="v" />Eh re' Jesús xjohtik chinaah jinaj i yuuq' ar xutzunaa' cho riib' ruch'ihil taqe i raj tahqaneel. <verse number="4" style="v" />Eh chupaam i q'iij re' re', xailook' chik i runinq'ijiik i elik chaloq Egipto. <verse number="5" style="v" />Eh noq xrilow i Jesús chi ma' k'isiin i tinamit intahqinik reh, je' wili xuq'or reh i Felipe:</para>
  <para style="p">¿Aha' naq neenooj qaloq' kikaxlanwi'k i tinamit wili, reh chi neenkian kiwa'? inki.</para>
  <para style="p">
    <verse number="6" style="v" />Re' Jesús je' re' i xuq'or, xa i lb'al reh chib'ih i nee ruq'or i Felipe, ruum re' Jesús ruyejaam chik wach i naa rub'anam. <verse number="7" style="v" />Re' Felipe je' wili i xuq'or:</para>
  <para style="p">Wilik ta kiib'-oq siento chi tumiin quuk', ni xata naq neemanlojik chi loq'b'al kaxlanwi'k, reh chi neenqayeew k'isinoq keh i, inki.</para>
  <para style="p">
    <verse number="8" style="v" />Eh jinaj keh i raj tahqaneel i Jesús, Andres rub'ihnaal, ruchaaq' i Simón Pedro i rukab' b'ih, je' wili i xuq'or reh i Jesús:</para>
  <para style="p">
    <verse number="9" style="v" />Ayu' wilik jinaj ak'un wilik ruuk' ho'oob' chi kaxlanwi'k re' ruuk' sebada, eh kiib' wo' kok' kar wilik ruuk'. Xa re' la' xama' nee ta wo' i manlojik chi ketb'al keh i ruk'ihaal tinamit wili, inki.</para>
  <para style="p">
    <verse number="10" style="v" />Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Chaq'or taq keh i tinamit chi kitzunaa' qohoq kiib', inki.</para>
  <para style="p">Eh, ma' k'isiin i kok' ch'ahn wilik ar chinaah taqe re' xkitzunaa' kiib', eh wilkeeb' naa ho'oob'-oq miil chi winaq. <verse number="11" style="v" />Eh re' i Jesús xuchop chaloq i ho'oob' chi kaxlanwi'k, xut'iosej ree Dios, eh xupuhkaaj keh i ruk'ihaal tinamit tzunulkeeb' wach ak'al. Eh xupuhkaaj wo' keh i kiib' chi kok' kar, xuyeew keh xanik' pa' k'ihaal i xkaaj kik'uxum. <verse number="12" style="v" />Eh noq kianam chik kiwa' chi korik, re' Jesús je' wili i xuq'or keh i raj tahqaneel:</para>
  <para style="p">Chamol taq i ruqox kaxlanwi'k, reh chi ma' xtaj ineenq'ehb'ik, inki.</para>
  <para style="p">
    <verse number="13" style="v" />Eh re' taqe i raj tahqaneel xkimol wo' chu'nchel i ruqox i kaxlanwi'k. Eh re' i ho'oob' chi kaxlanwi'k re' ruuk' i sebada, kab'laj chakach chi nujinaq i xuqohxaaj. <verse number="14" style="v" />Eh noq xkilow i ruk'ihaal tinamit i nimaq wach ma' ilooj taj xub'an i Jesús, je' wili xkiq'or:</para>
  <para style="p">Xti korik chi re' i wili i jalal ruq'oral i Dios q'orooj chaloq chi naa ruk'uliik iloq, inki taqe.</para>
  <para style="p">
    <verse number="15" style="v" />Eh re' i tinamit re' re' xkaaj naq kiminim chi kireey i Jesús. Eh noq xunab'eej chi je' re' i Jesús, xooj wo' chik johtoq kochinaah i yuuq', reh chi rutkeel xooj wih-oq ar.</para>
  <para style="s">Re' Jesús xb'ehik chi rooq chinaah i palaw</para>
  <para style="r">(<ref loc="MAT 14:22-27">Mat 14.22-27</ref>; <ref loc="MRK 6:45-52">Mar 6.45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" />Eh noq xokik i q'iij, re' taqe i raj tahqaneel i Jesús xiqajik chaloq chi chii' i k'isa palaw. <verse number="17" style="v" />Eh noq xokik chik i q'equm majaa' ta nooj k'oloq kuuk' i Jesús. Re' taqe i raj tahqaneel, xi okik reje pan barco, xi-ik'ik reje chinaah i k'isa palaw, xi ponik Capernaum. <verse number="18" style="v" />Noq ik'ik chik inki a'n chinaah i palaw, yohb'aal wach i rub'ohl i xwuktik ruum i kowlaj teew. <verse number="19" style="v" />Noq wilik chik rukab' léwa i b'ehik kianam reje pan barco nah palaw, xkilow chi b'ehik i rub'an reje chi rooq i Jesús chinaah i palaw. Eh re' reh rujilim i koq riib' ruuk' i barco, re' taqe i raj tahqaneel, xiyo'jik ruum. <verse number="20" style="v" />Re' i Jesús je' wili i xuq'or keh:</para>
  <para style="p">Matyo'jik taq re' hin i Jesús, inki.</para>
  <para style="p">
    <verse number="21" style="v" />Eh xkib'iraj chi je' re' xasuq suq chik kik'ux noq xkik'ul cho kuuk' i Jesús pan barco. Eh ach jumehq' xib'ehik reje, xi ponik chupaam i ye'aab' ojik inki a'n wii'.</para>
  <para style="s">Re' taqe tinamit xiooj chusik'ariik i Jesús</para>
  <para style="p">
    <verse number="22" style="v" />Eh re' i tinamit xi kahnik cho chi juntar i k'isa palaw, ko chi junwaar xk'ulik pankik'ux chi xa re' wo' i jinaj chi barco wilik ar, eh chi xa kutkeel i raj tahqaneel i Jesús xi okik reje chupaam i barco re' re'. Eh chi ma' xokik ta reje haa' i Jesús chikiij. <verse number="23" style="v" />Eh wilik taqe i barco xi chalik Tiberias xi ponik ma' naj ta ruuk' i ye'aab' xkik'ux wii' i kaxlanwi'k, re' noq rut'iosem chik ree Dios i Jesús noq xupuhkaaj keh i tinamit. <verse number="24" style="v" />Noq xkilow i tinamit chi ma' ha' ta xkireq i Jesús, ni xata re' taqe i raj tahqaneel xkireq ar, xijohtik reje chupaam taqe barco xiooj chi sik'ooj ko Capernaum.</para>
  <para style="s">Re' Jesús xuq'or chi re' reh i kaxlanwi'k inye'wik juneliik k'acharik</para>
  <para style="p">
    <verse number="25" style="v" />Eh re' tinamit, noq xponik kireq i Jesús chi juntar i k'isa palaw, je' wili i xkiq'or reh:</para>
  <para style="p">Aj Tijineel, ¿nik' wach noq xat chalik ayu'? inki taqe reh.</para>
  <para style="p">
    <verse number="26" style="v" />Re' Jesús je' wili i xuq'or ke:</para>
  <para style="p">Re' hin xti korik taq i nuq'or aweh chi kinasik' taq xa ruum chi xatnujik taq noq xnupuhkaaj i ho'oob' chi kaxlanwi'k, ma' ruum ta chi xareq taq chi riij taqe i ma' ilooj taj xnuk'uhtaaj taq chawach. <verse number="27" style="v" />Mo'-oq xa chi riij taq awa' xa k'uhlik reh tikamanoq. Chakamaneej la' taq riij awa' naa ruwihiik chi juneliik, re' i naa taq ruye'wiik aweh i juneliik k'acharik. Eh re' inanuye'em taq aweh i hin Ak'uunb'ees nuwii' winaq, ruum re' i waJaaw xuq'or chi re' hin naa nuye'wiik reh, inki.</para>
  <para style="p">
    <verse number="28" style="v" />Eh re' i tinamit, xkipahqaaj reh i Jesús chi je' wili:</para>
  <para style="p">¿Chib'aaj jariik re' naaqa'nam, reh chi neenqa a'n i kamanik imponik chuwach i Dios? inki taqe.</para>
  <para style="p">
    <verse number="29" style="v" />Re' Jesús je' wili i xuq'or keh:</para>
  <para style="p">Re' iraaj i Dios chi naa taq a'nam, re' chi naa taq kinanimam i hin, i xirutaq'aaj cho wach ak'al, inki.</para>
  <para style="p">
    <verse number="30" style="v" />Re' tinamit xkipahqaaj wo' chik reh i Jesús chi je' wili:</para>
  <para style="p">¿Chib'ih jariik taqe i ma' ilooj taj neenak'uhtaaj chi qawach, reh chi neetiqanimaj? Eh ¿aha' wilik taqe akamaj naa a'nam? <verse number="31" style="v" />Re' taqe qamaam qati't i hoj xkik'ux chaloq i maná pan chik yuuq', je' rukab' i tz'ihb'amaj pan santo laj huuj chi je' wili: Re' kaxlanwi'k xkik'ux pan taxaaj inchalik inki.</para>
  <para style="p">
    <verse number="32" style="v" />Re' Jesús je' wili i xuq'or keh:</para>
  <para style="p">Re' hin xti korik taq i nuq'or aweh chi ma' re' taj i Moisés xye'wik keh i kaxlanwi'k xchalik pan taxaaj. Eh re' wo' waJaaw inye'wik taq chaaweh i hat i xti korik laj kaxlanwi'k inchalik pan taxaaj. <verse number="33" style="v" />Ruum re' i kaxlanwi'k i ruyeew i Dios, re' i xqajik cho pan taxaaj, re' xchalik chuye'ariik kik'achariik i tinamit wach ak'al, inki Jesús.</para>
  <para style="p">
    <verse number="34" style="v" />Eh re' i tinamit je' wili i xkiq'or reh i Jesús:</para>
  <para style="p">Jaaw, chayeew tii qeh i kaxlanwi'k re' re' chi juneliik, inki taqe.</para>
  <para style="p">
    <verse number="35" style="v" />Eh re' Jesús je' wili xuq'or keh:</para>
  <para style="p">Re' hin i kaxlanwi'k inye'wik juneliik k'acharik. Eh awach inchalik wuuk', ma' naa ta chik runuhmiik chi jumpech. Eh awach i naa runimaniik weh, ma' naa ta chik ruchiqiik chii' chi jumpech. <verse number="36" style="v" />Re' hin nuq'orom taq chik aweh chi ro'q ta k'ahchi' wo' naq taq awilom nuwach, xama' kinanimaj ta wo' taq. <verse number="37" style="v" />Chu'nchel i ruye'em weh i waJaaw kichalik wuuk'. Eh awach i kichalik wuuk', ma' jaruuj taqe neenukaaj reje wulu'. <verse number="38" style="v" />Re' hin ma' xinqajik ta chaloq pan taxaaj chub'anariik ayu' wach ak'al inwaaj i hin xin chalik la' chub'anariik iraaj i waJaaw xtaaq'anik cho weh. <verse number="39" style="v" />Re' iraaj i waJaaw xtaaq'anik cho weh, re' chi ma' naa ta nuq'eb'em jino'q taqe i ruye'em weh. Re' la' iraaj chi naa wo' chik wuksam taqe chaloq chi k'achlik kiwach chuk'ulariik i juneliik k'acharik pantz'apaab' poo wach reh i q'iij. <verse number="40" style="v" />Re' raaj i waJaaw, re' chi chu'nchel i naa kilwiik weh i hin, Ak'uunb'ees Dios, eh naakinimaniik weh, naa ruwihiik kik'achariik chi juneliik. Eh re' hin naawuksaniik cho keh chi k'achlik kiwach pantz'apaab' poo wach reh i q'iij, inki Jesús.</para>
  <para style="p">
    <verse number="41" style="v" />Eh re' taqe i k'amal kib'eeh i aj judío xtohq'ik kich'olem i Jesús, ruum xti xuq'or i korik chi re' reh i kaxlanwi'k xqajik cho pan taxaaj. <verse number="42" style="v" />Eh je' wili i xkiq'or:</para>
  <para style="p">¿Mi ma' re' re' i wili i Jesús, i rak'uun i José? Re' hoj qeht'al wach i rutuut rajaaw. Eh ¿chib'ih reet noq i ruq'or yu'naak chi pan taxaaj xqajik chaloq? inki taqe.</para>
  <para style="p">
    <verse number="43" style="v" />Xrib'iraj chi je' re' i Jesús, je' wili i xuq'or keh:</para>
  <para style="p">Chakanaa' taq nuch'oljiik. <verse number="44" style="v" />Ma' jino'q i neenchalik wuuk' wila' ma' re' i waJaaw xtaaq'anik cho weh neenk'amwik cho reh. Eh re' hin naa wo' chik wuksam chaloq chi k'achlik wach pantz'apaab' poo wach reh i q'iij. <verse number="45" style="v" />Eh chupaam taqe huuj kitz'ihb'aam chaloq i jalal ruq'oral i Dios i ruq'or chi re' Dios naa rutijem chu'nchel i tinamit. Awach i ki-ib'irinik reh i waJaaw, eh inkitijej kiib' ruuk' i reh, nee kichalik wuuk' i hin. <verse number="46" style="v" />Ma' awach ta ilwinaq wach i waJaaw, re' Dios, re' ilwinaq wach i waJaaw xa re' wo' hin, i xinqajik cho ruuk' pan taxaaj. <verse number="47" style="v" />Je' re' noq, re' hin xti korik i nuq'or taq aweh chi awach i ruyeew ruk'ux chi nunimjiik, wilik i ruk'achariik chi juneliik. <verse number="48" style="v" />Re' hin i kaxlanwi'k inye'wik k'acharik. <verse number="49" style="v" />Re' taq aamaam awati't i hat xkik'ux wo' naq keh i maná panchiq yuuq', xa re' la', xa xikimik wo' reje. <verse number="50" style="v" />Re' i kaxlanwi'k i nuq'or taq aweh hin, re' inqajik cho pan taxaaj, eh awach i neeruk'ux reh, ma' jaruuj naa rukimiik. <verse number="51" style="v" />Re' hin, i k'achlik kaxlanwi'k, xinqajik cho pan taxaaj, awach neenk'uxwik reh, naa ruwihiik ruk'achariik chi juneliik. Re' i kaxlanwi'k naa nuye'em chi k'uxarik, re' i nuti'jolal naa nuq'asam panti' k'axik, reh chi naa ruwihiik kik'achariik i tinamit wach ak'al, inki.</para>
  <para style="p">
    <verse number="52" style="v" />Eh re' taqe i k'amal kib'eeh i aj judío, k'ul xkipech'uj chikiwach, chi je' wili:</para>
  <para style="p">¿Nik' wach noq nee ruyeew qeh chi k'uxarik i ruti'jolal i ruq'or? inki taqe.</para>
  <para style="p">
    <verse number="53" style="v" />Eh re' i Jesús je' wili i xuq'or keh:</para>
  <para style="p">Re' hin xti korik taq i nuq'or aweh chi wila' ma' xak'ux taq aweh i nuti'jolal, wila' ma' xawuk'ej taq aweh i nukik'eel i hin Ak'uunb'ees nuwii' winaq, ma' naa ta taq ruwihiik ak'achariik. <verse number="54" style="v" />Raaj awach i naa ruk'uxum reh i nuti'jolal i hin eh neeruk'ej reh i nukik'eel, wilik ruk'achariik chi juneliik. Eh re' hin naawuksaniik cho reh chi k'achlik wach pantz'apaab' poo wach reh i q'iij, <verse number="55" style="v" />ruum re' i nuti'jolal i xti korik laj kaxlanwi'k, eh re' i nukik'eel i xti korik laj ha' inuuk'jik. <verse number="56" style="v" />Awach i ruk'ux reh i nuti'jolal eh i ruk'ej reh i nukik'eel, wilik pan jinaj wach k'uxliis wuuk' eh je' wo' hin wilkiin wo' ruuk' pan jinaj wach k'uxliis. <verse number="57" style="v" />Re' i waJaaw xtaaq'anik cho weh wilik ruk'achariik, eh ruum wo' reh wilik nuk'achariik i hin. Awach i ruk'uxlaaj riib' ruuk' i nuti'jolal, naa ruwihiik ruk'achariik wuum i hin. <verse number="58" style="v" />Re' hin i kaxlanwi'k xinqajik cho pan taxaaj ma' je' ta rukab' i maná xkik'ux chaloq taq aamaam awati't. Re' keh, xkik'ux wo' naq keh, xa re' la' xikimik wo' reje. Eh awach ink'uxwik reh i kaxlanwi'k i nuq'or taq aweh i hin, naa ruk'achariik chi juneliik, inki.</para>
  <para style="p">
    <verse number="59" style="v" />Re' Jesús ar xub'an taqe i k'uhb'alinik wili Capernaum chupaam i paat kimolom wii' kiib' aj Israel.</para>
  <para style="s">Re' q'orik chi riij i juneliik k'acharik</para>
  <para style="p">
    <verse number="60" style="v" />Eh noq xuq'or taqe re' i Jesús, ma' k'isiin i kitahqinik reh je' wili i xkiq'or: Ma' k'isiin ta k'ayewal wach i ruq'or, ma' awach ta wo' neemb'anik reh, inki taqe.</para>
  <para style="p">
    <verse number="61" style="v" />Eh noq xunab'eej i Jesús chi k'ahchi' kiwech'um riij taqe i ruq'or, xupahqaaj keh chi je' wili:</para>
  <para style="p">¿Mi ma' suq taq i rub'an aweh re' taqe i nuq'or? <verse number="62" style="v" />Eh chib'ih naq taq i neenaq'or nee ta taq kinawilow i hin, Ak'uunb'ees nuwii' winaq, chi johtik wo' chik i nub'an pan taxaaj ¿aha' xinwihik cho wii' pampeet? <verse number="63" style="v" />Chakoj taq rehtaal chi re' i uxlab'al inye'wik k'acharik, eh re' i xa ti'jolal xama' xta rutiq wach. Eh re' taqe i xnuq'or taq aweh i hin uxlab'al, eh inye'wik k'acharik. <verse number="64" style="v" />Xa re' la', ko wilik wo' taq chaxilak i hat i ma' kinimanik ta reh, inki.</para>
  <para style="p">Re' Jesús xa reht'al wo' chik awach i ma' kinimanik ta reh. Eh awach naa ruk'ayiniik reh chi ma' eht'alimaj.</para>
  <para style="p">
    <verse number="65" style="v" />Eh re' Jesús je' wili i xuq'or:</para>
  <para style="p">Ruum aj re', re' hin nuq'orom taq chik aweh chi ma' awach ta jino'q neenchalik wuuk' i hin wila' ma' re' i waJaaw xk'amwik cho reh, inki.</para>
  <para style="p">
    <verse number="66" style="v" />Eh chupaam i junk'aam re' re', ma' k'isiin i kitahqinik ree Jesús xyoj kik'ux ruum i xkib'iraj, ma' kota chik xkitahqeej i Jesús. <verse number="67" style="v" />Noq xrilow chi je' re' i Jesús, xupahqaaj keh i kab'laj chi raj tahqaneel chi je' wili:</para>
  <para style="p">¿Je' nche nawaaj wo' taq ojik haa' i hat? inki keh.</para>
  <para style="p">
    <verse number="68" style="v" />Eh re' i Simón Pedro i rukab' b'ih, je' wili i chaq'wik xub'an:</para>
  <para style="p">Jaaw, awach ta wo' naa chik chaj-iij neqoh-ooj, ruum xa re' wo' hat ti q'orik rib'iral i juneliik k'acharik <verse number="69" style="v" />Re' hoj qanimam eh qeht'al chik chi re' hat, hat Santolaj Rak'uun i Dios, inki.</para>
  <para style="p">
    <verse number="70" style="v" />Re' Jesús je' wili xuq'or:</para>
  <para style="p">Re' taq i hat kab'laj chawiib' re' wo' naq i hin xin sik'wik taq chaawach. Xa re' la' jinaj i wilik taq chaxilak je' runa'ojb'al aj Yahm i runa'ojb'al, inki.</para>
  <para style="p">
    <verse number="71" style="v" />Eh chi riij i Judas Iscariote xq'orik, re' i rak'uun i winaq, Simón rub'ihnaal. Je' re' i xuq'or i Jesús, ruum reht'al chi re' Judas naa ruk'ayiniik reh chi ma' eht'alimaj, re' wo' naq ruuk' taqe i kab'laj chi raj tahqaneel.</para>
  <chapter number="7" style="c" />
  <para style="s">Re' Jesús ma' nimjik ta kuum taqe i ruchaaq'</para>
  <para style="p">
    <verse number="1" style="v" />Chi riij i re', re' Jesús xub'ehuj paam i ruyuq'ul i Galilea. Ma' xraaj ta chik wihik i Judea, ruum re' taqe i k'amal kib'eeh i aj judío ar, xkaaj naq kikansam. <verse number="2" style="v" />Eh ach-oq ilook' i ninq'iij inkik'saj rajlaal haab' taqe i aj Israel, re' noq inkiyejaa' i kok' perpat. <verse number="3" style="v" />Re' Jesús je' wili i xq'orarik reh kuum i ruchaaq':</para>
  <para style="p">Re' hat eleen reje ayu', hiy i Judea, reh chi neenkilow taqe awaj tahqaneel wilkeeb' ar taqe ma' ilooj taj i na a'n. <verse number="4" style="v" />Awach iraaj chi nee nelik rib'iral taqe rub'an, ma' panke'lik ta neerub'an. Je' re' noq, wila' re' hat i na a'n rub'aan panke'lik taqe re', inchol wo' a'nam chikiwach i tinamit, inki taqe.</para>
  <para style="p">
    <verse number="5" style="v" />Re' Jesús ni xata re' taqe ruchaaq' kinimanik reh. <verse number="6" style="v" />Eh je' wili i xq'orarik keh ruum i Jesús:</para>
  <para style="p">Re' hin, komajaa' imponik i ru orahiil chi naa wojiik paruyuq'ul i Judea. Eh cha weh taq i hat, xa aha' wilikora i chihooj chi nee taq tiooj ar. <verse number="7" style="v" />Re' taq i hat ma' nkixowaaj ta taq awach i tinamit wach ak'al re' hin ra'j inkixowaaj nuwach re', ruum xti nuteh wach keh chi ma' holohik taj inki a'n <verse number="8" style="v" />Re' taq i hat neerub'an chi nee taq tiooj chi ninq'ijinik. Re' hin komajaa' ta naa wojiik, ruum majaa' ta imponik i ru orahiil chi naa wojiik ar, inki keh.</para>
  <para style="p">
    <verse number="9" style="v" />Eh noq ruq'orom chik taqe re' i Jesús, ko xkahnik wo' ar Galilea.</para>
  <para style="s">Re' noq xooj i Jesús chuninq'ijiik i kok' perpat</para>
  <para style="p">
    <verse number="10" style="v" />Eh noq ojinaq chik taqe chi ninq'ijinik i ruchaaq' i Jesús, xooj wo' reh chi ninq'ijinik. Xa re' la', panke'lik xooj, re' xraaj chi ma' x-ilarik ta kuum i tinamit. <verse number="11" style="v" />Re' taqe i k'amal kib'eeh i aj judío kisik' i Jesús pan ninq'ijinik, je' wili i xkiq'or:</para>
  <para style="p">¿Aha' inche wilik i winaq re' re'? inki taqe.</para>
  <para style="p">
    <verse number="12" style="v" />Re' i tinamit xkiwech'uj kiib' chi riij i Jesús. Wilik kiq'orik reh chi q'e' holohik i rub'an. Eh wilik kiq'orik reh chi ma' holohik taj i rub'an, ruum k'ahchi' rujot'om tinamit inki taqe. <verse number="13" style="v" />Xa re' la', ma' xta xkiq'or chi riij i Jesús chikiwach i tinamit, ruum kiyo'jik taqe kuum i k'amal kib'eeh i aj judío.</para>
  <para style="p">
    <verse number="14" style="v" />Eh noq xponik yejaal i ninq'iij, re' Jesús xokik i koq chupaam i rupaat i Dios, eh ar xuk'uhb'alej taqe i tinamit. <verse number="15" style="v" />Re' taqe i aj judío xsahchik kik'ux ruum i k'uhb'alinik i xub'an, je' wili i xkiq'or:</para>
  <para style="p">¿Nik' wach noq reht'al taqe i na'ojb'al re' re' i winaq wili? Xanaah re', ma' ha' ta rutijem riib', inki taqe.</para>
  <para style="p">
    <verse number="16" style="v" />Eh re' Jesús je' wili i xuq'or:</para>
  <para style="p">Re' taq aak'uhb'aaljiik i nub'an ma' xata panuk'ux inchalik re' la' i waJaaw xtaaq'anik cho weh inye'wik cho nuna'ojb'al chub'aan. <verse number="17" style="v" />Awach iraaj rub'anam iraaj i Dios nee rureq chi riij, mi ruuk' i Dios inchalik i k'uhb'alinik i nub'an, oon xa panuk'ux inchalik i k'uhb'alinik i nub'an. <verse number="18" style="v" />Awach i xa paruk'ux inchalik i k'uhb'alinik i rub'an, xa re' reh raaj chi neenye'arik ruloq'il. Raaj awach i re' i ruloq'il i xtaaq'anik cho reh iraaj rusik'im, re' reh, re' i korik i ruq'or, eh ma' xtaj i yiib' wach i rub'an. <verse number="19" style="v" />¿Mi ma' xuq'or wo' naq taq chaaweh re' i najtir k'uhb'aal i Moisés? Xa re' la', ma' jino'q wo' taq aweh i hat runimaj. Eh ¿chib'ih reet noq kinawaaj taq kinakansam i hin? inki.</para>
  <para style="p">
    <verse number="20" style="v" />Re' tinamit je' wili i xkiq'or reh:</para>
  <para style="p">Re' hat ma' tob'laj uxlab'al i wilik awuuk', ruum inakapaaj chi naa akanteesjiik inki taqe.</para>
  <para style="p">
    <verse number="21" style="v" />Re' Jesús je' wili xuq'or keh:</para>
  <para style="p">Chawunchelaal taq i hat xa ruum i jinaj chi ma' ilooj taj xnub'an pan hi'limb'al q'iij xsahchik taq ak'ux. <verse number="22" style="v" />Eh xuq'or wo' taq aweh i Moisés chi naa taq apoch'om naah kik'achab' i kok' ak'un. (Atoob' ta ma' re' ta wo' Moisés xtiik'anik cho reh re' la' wo' taq aamaam awati't i hat xitik'anik cho reh) eh atoob' ta pan hilimb'al q'iij i na a'n taq keh i kok' ak'un i na'ojb'al re' re'. <verse number="23" style="v" />Eh wila' re' taq i hat inapoch' taq naah i kik'achab' i kok' ak'un pan hi'limb'al q'iij, eh ma' ti mahkunik ta taq chuwach i najtir k'uhb'aal ¿chib'ih reet noq inchalik taq ak'aah chi nunaah i hin, xa ruum chi xnuk'achrisaj i winaq pan hi'limb'al q'iij? <verse number="24" style="v" />Maaq'at taq q'orik chinaah i ju'jun ree rukojariik ru mahk xa ruum i runa'ojb'al taq inawilow xti ko wilik la' ru mahk noq naa taq aq'atam i q'orik chinaah, inki.</para>
  <para style="s">Re' Jesús xuq'or aha' chalinaq</para>
  <para style="p">
    <verse number="25" style="v" />Wilik taqe i patim ar Jerusaleem je' wili i xkiq'or:</para>
  <para style="p">¿Mi ma' re' re' i winaq wili i kitukik chusik'ariik reh i rukanteesjiik? <verse number="26" style="v" />Xanaah re', re' re' wo' naq k'uhb'alinik i rub'an chikiwach i tinamit, eh ma' xta wo' inkiq'or reh. Noq iraaj ti xkinimaj taqe k'amal qab'eeh chi re' i reh i Cristo. <verse number="27" style="v" />Re' hoj ma' nqanimaj taj chi re' reh i Cristo, ruum qeht'al aha' inchalik. Raaj na' k'oloq i Cristo, ma' awach ta naa runab'iniik reh aha' naa ruchaliik, inki taqe.</para>
  <para style="p">
    <verse number="28" style="v" />Eh re' i Jesús noq xub'an k'uhb'alinik i parupaat i Dios, kow xuq'or chi je' wili:</para>
  <para style="p">Re' taq i hat inaq'or taq chi aweht'al taq nuwach, aweht'al taq aha' kinchalik. Xa re' la' ma' xata nuna'ojb'al wiib' noq xin chalik. Jinaj la' i xtaaq'anik cho weh, re' i korik wach ruk'ux, re' i ma' aweht'al ta taq wach i hat. <verse number="29" style="v" />Re' hin ra'j weht'al wach re', ruum ruuk' xinelik chaloq, eh re' reh xtaaq'anik cho weh, inki.</para>
  <para style="p">
    <verse number="30" style="v" />Eh ruum i re' xkaaj naq kichopom Jesús. Xa re' la', ma' awach taj ixukowej ruk'ux chi ruchopariik, ruum komajaa' ta wo' imponik i ora reh i ruchopariik. <verse number="31" style="v" />Eh ma' k'isiin i xinimanik reh i Jesús, je' wili i xkiq'or:</para>
  <para style="p">Re' hoj inqanimaj chi re' i winaq wili re' i Cristo, ruum nee ta chik ink'u'loq jino'q, xiik' ta'j chik inche naah ninqaal wach i ma' ilooj taj neerub'an chuwach rub'an i reh, inki taqe.</para>
  <para style="s">Re' taqe aj fariseo xkitaq'aaj ruchopariik i Jesús</para>
  <para style="p">
    <verse number="32" style="v" />Eh noq xkib'iraj i aj fariseo, inkiq'or i tinamit chi riij i Jesús, xkian jinaj wach kik'ux kuuk' i kajaaw i k'amal kib'eeh aj tiij chi wilik taqe i kicha'jinik reh i rupaat i Dios xkitaq'aaj chuchopariik i Jesús. <verse number="33" style="v" />Eh re' i Jesús je' wili i xuq'or:</para>
  <para style="p">Re' hin xama' q'e' ta chik najt naa nuwihiik taq awuuk'. Chi riij i re', naa wo' chik wojiik ruuk' awach xtaaq'anik cho weh. <verse number="34" style="v" />Eh re' taq i hat naa naq taq chik kin asik'im, eh ma' naa ta taq chik kiin areqem, ruum ma' naa ta taq a'nam i ponik aha' naa nuwihiik wii' i hin, inki.</para>
  <para style="p">
    <verse number="35" style="v" />Eh re' taqe i aj judío, je' wili i xkiq'or chikiwach:</para>
  <para style="p">¿Aha' naa rojiik i winaq wili noq i ruq'or chi ma' nee ta nqareq? Nee ta'j inche nooj kuuk' i aj judío wilkeeb' pantaq tokoom tinamit. Eh nee ta'j inche nooj chi kitijiik i ma' re' ta taqe aj judío. <verse number="36" style="v" />Eh ¿chib'ih iraaj ruq'orom qeh ruuk' i xuq'or chi je' wili? Naa naq taq chik kin asik'im eh ma' naa ta taq chik kin areqem, ruum ma' naa ta taq a'nam i ponik ar i hat inaa nuwihiik wii' i hin, inki' nchel, inki taqe.</para>
  <para style="s">Re' i k'achlik rooq ha'</para>
  <para style="p">
    <verse number="37" style="v" />Eh pantz'apaab' wach q'iij reh i runimaal wach i ninq'iij, re' Jesús xupab'aa' johtoq riib', kow xuq'or chi je' wili:</para>
  <para style="p">Awach i chiqiij chii', chaloq rub'an ruhaa' wuuk', <verse number="38" style="v" />je' rukab' i ruq'or i tz'ihb'amaj pan santo laj huuj, re' i ruq'or i Dios chi je' wili: Re' taqe i kinimanik weh, naa reliik cho pan kánima i k'achlik rooq ha', inki, inki Jesús.</para>
  <para style="p">
    <verse number="39" style="v" />Ruuk' i xuq'or re' re' i Jesús, xuch'ob' rub'ehel chi re' taqe i naakinimaniik reh, naakik'ulum i Santolaj Uxlab'al. Chupaam i q'iij re' re' komajaa' inqajik chaloq i Santolaj Uxlab'al, ruum komajaa' wo' chik injohtik i reh paruloq'laj ye'aab' pan taxaaj.</para>
  <para style="s">Re' i tinamit xkiwech'uj kiib' chikiwach chib'ih rub'anam i Jesús</para>
  <para style="p">
    <verse number="40" style="v" />Eh noq xkib'iraj i tinamit i xuq'or i Jesús, wilik i aj Judío xiq'orik reh chi je' wili:</para>
  <para style="p">Re' winaq wili xti korik chi re' reh i k'ulik iloq reh inkiq'or chujalariik i ruq'oral i Dios, inki taqe. <verse number="41" style="v" />Eh wilik i xiq'orik reh chi je' wili: Re' winaq wili re' i Cristo, inki taqe. Eh wilik i xiq'orik reh chi je' wili: Ma' re' taj, ruum re' i Cristo ma' nee ta rub'an chi paruyuq'ul i Galilea neenchalik. <verse number="42" style="v" />Re' i tz'ihb'amaj pan santo laj huuj i ruq'or chi re' i naa rub'anam chi Cristo, re' ruuk' taqe i riih rumaam i reey David, eh chi ar naa ruchaliik pan tinamit Belén, re' wo' i rutinamiit i David, inki taqe. <verse number="43" style="v" />Je' re' noq, re' taqe tinamit k'ul xyoj kik'ux chikiwach, ruum ma' nkireq ta chi riij chib'ih rub'anam i Jesús. <verse number="44" style="v" />Wilik wo' taqe i xkaaj naq kik'amam prexo i Jesús xa re' la', ma' awach ta wo' ixukowej ruk'ux chuchopariik.</para>
  <para style="s">Re' taqe q'atal q'orik ma' xkinimaj taj i Jesús</para>
  <para style="p">
    <verse number="45" style="v" />Re' taqe i cha'jen reh i rupaat i Dios, xiooj naq chopwoq reh i Jesús, xi sutinik wo' chik chaloq kuuk' i aj fariseo, kuuk' i kajaaw i k'amal kib'eeh aj tiij, xpahqaljik keh chi je' wili:</para>
  <para style="p">¿Chib'ih reet noq ma' xak'am taq chaloq i winaq re' re'? ki uchjik.</para>
  <para style="p">
    <verse number="46" style="v" />Eh re' keh je' wili i xkiq'or:</para>
  <para style="p">Ma' xqak'am ta chaloq, ruum ma' jank'al q'iij inqib'iraj jino'q i winaq chi je' rukab' inq'orik i reh, inki taqe.</para>
  <para style="p">
    <verse number="47" style="v" />Re' taqe aj fariseo je' wili i xkiq'or:</para>
  <para style="p">¿Mi xayeew wo' taq awiib' chi jot'arik re' hat? <verse number="48" style="v" />¿Mi ma' nakoj taq rehtaal re' chi ma' jino'q keh i k'amal qab'eeh, eh ma' jino'q qee hoj i k'ahchi' runimaniik reh i winaq re' re'? <verse number="49" style="v" />Raaj i tinamit wili, i ma' keht'al taj chib'ih ruq'or i najtir k'uhb'aal, k'ahchi' kinimam. Ruuk' i re' k'ahchi' kiq'eb'em kiib' inki taqe.</para>
  <para style="p">
    <verse number="50" style="v" />Eh re' Nicodemo, k'amal kib'eeh i aj fariseo, re' i poninaq cho ruuk' i Jesús junriim chaq'ab', je' wili i xuq'or keh:</para>
  <para style="p">
    <verse number="51" style="v" />Re' k'uhb'aal ye'ooj qeh i ruq'or chi ma' ruk'ul taj chi awach i neenqakoj ru mahk, wila' komajaa' inqib'iraj chi korik chib'ih i mahk rub'anam, inki.</para>
  <para style="p">
    <verse number="52" style="v" />Re' keh je' wili i chaq'wik xkian:</para>
  <para style="p">¿Mi hat wo' aj Galilea re' hat, ruum ti okik chi riij? Chatijej riij i tz'ihb'amaj pan santo laj huuj. Ar neenareq chi riij chi ma' jino'q i jalal ruq'oral i Dios elinaq cho Galilea, inki taqe reh.</para>
  <para style="p">
    <verse number="53" style="v" />Chi riij i re', xiooj pankipaat chi kiju'junaal.</para>
  <chapter number="8" style="c" />
  <para style="s">Re' ixoq xkan cho chub'anariik i k'oyomal</para>
  <para style="p">
    <verse number="1" style="v" />Eh re' Jesús reh xooj chinaah i yuuq', olivo. <verse number="2" style="v" />Eh wahq'eq chi junwaar, xsutinik wo' chik chaloq i parupaat i Dios. Eh ma' k'isiin i tinamit xkimol kiib' ruuk', xutzunaa' riib', chi kik'uhlb'aaljiik. <verse number="3" style="v" />Eh re' taqe i kik'uhtanik ree najtir k'uhb'aal, taqe i aj fariseo xkireq chaloq jinaj ixoq pan k'oyomal chi ch'uwa'risanik wach rukaxaro, xkipab'aa' i koq chuwach i Jesús pankiyejaal. <verse number="4" style="v" />Eh je' wili i xkiq'or i koq reh i Jesús:</para>
  <para style="p">Aj Tijineel, re' ixoq wili xti xqareq chaloq pan k'oyomal chi ch'uwa'risanik wach i rukaxaro <verse number="5" style="v" />Eh re' k'uhb'aal ye'ooj reh i Moisés i ruq'or qeh chi naa qakansam chi ab'aj ixoq imb'anik reh i k'oyomal je' wili. Raaj i hat, ¿chib'ih inaq'or chi riij? inki taqe reh.</para>
  <para style="p">
    <verse number="6" style="v" />Re' taqe i re', je' re' i xkiq'or ree Jesús xa pajb'al reh. Ruuk' naq i re', naa kireqem ru mahk pankik'ux, re' Jesús xuk'utzaa' qohoq riib', xtohq'ik rutz'ihb'aam wach aak'al ruuk' i ju' q'ab'. <verse number="7" style="v" />Eh ruum chi xa toq' toq' chik inkipech'uj i koq reh i Jesús, re' reh xupab'aa' johtoq riib', je' wili i xuq'or keh:</para>
  <para style="p">Awach taq aweh i hat i ma' xta k'isinoq ru mahk re' reh i ruk'ul chi peet neerukut chi ab'aj ixoq wili, inki.</para>
  <para style="p">
    <verse number="8" style="v" />Chi riij i re', re' Jesús xuk'utzaa' wo' chik qohoq riib', xutoq'aa' wo' chik rutz'ihb'aam wach aak'al ruuk' i ju' q'ab'. <verse number="9" style="v" />Eh noq xkib'iraj chi je' re' i xi k'amwik cho reh ixoq xk'ik' raaj chi wilik kimahk, chi kiju'junaal xkitoq'aa' reje elik ar. Re' i peet xiooj, re' taqe i rijib' taq winaq, eh korehtaal xiooj chi kunchelaal. Eh ach re' i Jesús, ruch'ihil ixoq xi kahnik panyejaal i tinamit. <verse number="10" style="v" />Xpa'lojik wo' chik johtoq i Jesús, xupahqaaj reh ixoq chi je' wili:</para>
  <para style="p">¿Aha' xiooj taqe i k'ahchi' kiq'orik chi wilik amahk? Ma' awach ta xb'anik ti' k'axik aweh maje', inki reh.</para>
  <para style="p">
    <verse number="11" style="v" />Re' ixoq je' wili i xuq'or:</para>
  <para style="p">Ma' jino'q keh Jaaw inki.</para>
  <para style="p">Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Ni xata re' i hin neekinye'wik aweh panti' k'axik. Xa re' la', mat mahkunik chik hiy panapaat, inki.</para>
  <para style="s">Re' Jesús xuq'or chi re' reh i kisaqumaal i tinamit wach ak'al</para>
  <para style="p">
    <verse number="12" style="v" />Re' Jesús je' wili xuq'or keh i tinamit:</para>
  <para style="p">Re' hin i kisaqumaal i tinamit wach ak'al. Awach i kirutahqeej ma' naa ta chik rub'eeh panq'equm, naa la' ruwihiik chupaam saqum inye'wik k'acharik, nki.</para>
  <para style="p">
    <verse number="13" style="v" />Eh re' taqe i aj fariseo je' wili i xkiq'or ree Jesús:</para>
  <para style="p">Re' inaq'or re' re', xa aq'oral i hat cha wib'il awiib'. Re' inaq'or, ma' korik taj, inki taqe.</para>
  <para style="p">
    <verse number="14" style="v" />Re' Jesús je' wili i xuq'or ke:</para>
  <para style="p">Re' taqe nuq'or korik, atoob' ta xa nuq'oral hin chi wib'il wiib' ruuk' taqe nuq'or. Re' hin weht'al aha' xin chalik, eh aha' kinooj, re' taq i hat, ma' aweht'al ta taq. <verse number="15" style="v" />Re' taq i hat inakoj taq ru mahk i ju'jun je' rukab' taq inchalik panak'ux i hat. Eh re' hin, ma' awach taj i nukoj ru mahk. <verse number="16" style="v" />Eh wi awach i xnuq'at i q'orik chinaah i hin, re' korik naa nub'anam, ruum ma' wutkeel ta nuq'at i q'orik, wuch'ihil la' i waJaaw, i xtaaq'anik cho weh. <verse number="17" style="v" />Eh chupaam i k'uhb'aal ye'ooj taq aweh i hat, tz'ihb'amaj chi wila' wilik kiib'-oq chi winaq xi ilwik reh i chib'ih i xb'aan, eliik wach i xkiq'or, re' re' korik. <verse number="18" style="v" />Wila' je' re' i ruq'or, je' wo' hin re' hin i jinaj inq'orik i korik chi wiij chi wib'il wiib'. Eh re' i rukab' inq'orik reh i korik chi wiij, re' i waJaaw xtaaq'anik cho weh, inki.</para>
  <para style="p">
    <verse number="19" style="v" />Re' taqe i aj fariseo je' wili i kiq'or reh i Jesús:</para>
  <para style="p">¿Aha' wilik aaWaJaaw? inki taqe.</para>
  <para style="p">Re' Jesús je' wili xuq'or:</para>
  <para style="p">Re' taq i hat ma' aweht'al ta taq nuwach i hin, je' wo' hoq i waJaaw. Wi ta aweht'al taq nuwach i hin, aweht'al wo' naq taq wach i waJaaw, inki.</para>
  <para style="p">
    <verse number="20" style="v" />Re' Jesús xuq'or taqe wili noq xub'an i k'uhb'alinik parupaat Dios, re' i wilkeeb' wii' kaxoon i molarik wii' i lemóxna. Xa re' la', ma' jino'q wo' xchopwik ree Jesús, ruum komajaa' naq i rureq i ru orahiil ree ruchopariik.</para>
  <para style="s">Aha' naa wojiik i hin, ma' nee ta taq i na a'n i ponik ar i hat, inki Jesús</para>
  <para style="p">
    <verse number="21" style="v" />Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Re' hin naa wo' chik wojiik. Eh re' taq i hat naa naq chik kin taq asik'im. Xa re' la', xa panamahk wo' taq naa akimiik, ruum ma' naa ta taq a'nam i ponik naa nuwihiik wii' i hin, inki.</para>
  <para style="p">
    <verse number="22" style="v" />Re' taqe i k'amal kib'eeh i aj judío je' wili i xkiq'or:</para>
  <para style="p">Noq iraaj k'ahchi' rukapaam chi naa rukansam riib', ruum nee re' i ruq'or chi ma' nee ta nqa a'n i ponik i hoj aha' naa ruwihiik wii' i reh, inki taqe.</para>
  <para style="p">
    <verse number="23" style="v" />Re' Jesús je' wili xuq'or:</para>
  <para style="p">Re' taq i hat, hat taq aj wach ak'al, eh re' hin, hin aj pan taxaaj. Re' taq i hat, xa hat taq reh i wach ak'al eh re' hin, ma' hin ta reh i wach ak'al. <verse number="24" style="v" />Ruum aj re', xnuq'or taq aweh chi naa taq akimiik panamahk. Xti korik wo' chi naa taq akimiik panamahk, wila' ma' xanimaj taq chi re' hin, hin aj pan taxaaj, ki uchjik.</para>
  <para style="p">
    <verse number="25" style="v" />Eh xkipahqaaj reh i Jesús chi je' wili:</para>
  <para style="p">¿Xti awach aj wo' re' i hat? inki taqe.</para>
  <para style="p">Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Re' hin nuq'orom taq chik chaaweh pampeet awach i hin. <verse number="26" style="v" />Re' hin ko wilik naq taq i naa nuq'orom chawiij, koruk'ul naq chi nee taq inuq'at i q'orik cha naah. Xa re' la', ma' naa ta nub'anam, ruum re' xtaaq'anik cho weh korik wach ruk'ux, eh aha' wilik i ruq'orom weh, xa re' wo' naa nuq'orom keh i tinamit, inki.</para>
  <para style="p">
    <verse number="27" style="v" />Re' keh xama' xkireq ta wo' chi riij chi re' Jesús chi riij i Ajaab'ees Dios k'ahchi' chi q'orik.</para>
  <para style="p">
    <verse number="28" style="v" />Ruum i re' je' wili i xuq'or i Jesús:</para>
  <para style="p">Noq naa taq kiin ajosam wach kuruus i hin, Ak'uunb'ees nuwii' winaq, kora'j taq naa anab'eem re' chi korik chi re' hin, hin aj pan taxaaj. Eh chi ma' xtaj i nub'an chi xa nuna'ojb'al wiib', re' la' i nuq'or i ruk'uhtaam cho weh i waJaaw, <verse number="29" style="v" />Re' waJaaw xtaaq'anik cho weh xa wilik wo' wuuk'. Ma' hin ta rukanaam chi wutkeel, ruum eliik k'ahchi' kiin chub'anariik imponik chuwach i reh, inki Jesús.</para>
  <para style="p">
    <verse number="30" style="v" />Eh noq xuq'or taqe re' i Jesús, ma' k'isiin i tinamit xinimanik reh.</para>
  <para style="s">Re' i korik naa resaniik taq aweh pan q'ab' inchopwik taq anaah</para>
  <para style="p">
    <verse number="31" style="v" />Re' Jesús je' wili i xuq'or keh i aj judío xinimanik reh:</para>
  <para style="p">Wila' ma' xakanaa' taq chik runimjiik i nuq'oral, naa taq akahniik chi manlik waj tahqaneel. <verse number="32" style="v" />Eh naa taq anab'eem i korik, re' i korik naa taq resaniik chaaweh pan q'ab' inchopwik taq anaah, inki.</para>
  <para style="p">
    <verse number="33" style="v" />Eh re' keh je' wili i xkiq'or:</para>
  <para style="p">Re' hoj, hoj cho riih rumaam i Abraham ma' awach ta inchopwik qanaah. Eh ¿chib'ih reet noq inaq'or chi re' korik naa resaniik cho qeh pan q'ab' inchopwik qanaah? inki taqe.</para>
  <para style="p">
    <verse number="34" style="v" />Chalik i Jesús je' wili i xuq'or keh:</para>
  <para style="p">Re' hin xti korik taq i nuq'or aweh chi chu'nchel i kib'anik reh i mahk, re' wo' mahk inchopwik kinaah. <verse number="35" style="v" />Re' xa chi mosojik chopooj naah ma' nee ta nkahnik pampaat chi jumpech. Re' i ak'uunb'ees reh naa rukahniik chi jumpech parupaat i rajaaw. <verse number="36" style="v" />Wila' re' hin, Ak'uunb'ees Dios nee kinesanik taq chaaweh pan q'ab' inchopwik taq anaah, xti korik chi nee taq ti elik cho pan q'ab' chi jumpech. <verse number="37" style="v" />Korik re' hin weht'al chi re' taq i hat, hat taq cho riih rumaam i Abraham. Xa re' la', kinawaaj taq kinakansam, ruum ma' nanimaj ta taq i nuq'oral. <verse number="38" style="v" />Re' hin, re' i nuq'or i ruk'uhtaam cho weh i waJaaw. Eh re' taq i hat, re' taq i na a'n i ruq'orom taq aweh awajaaw, ki uchjik ruum i Jesús.</para>
  <para style="p">
    <verse number="39" style="v" />Re' taqe i aj judío je' wili xkiq'or:</para>
  <para style="p">Re' hoj re' i Abraham i xikin cho qamaam inki taqe.</para>
  <para style="p">Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Wi ta korik chi hat taq riih rumaam i Abraham, re' naq taq i na a'n i hat i rub'anam chaloq i reh. <verse number="40" style="v" />Raaj i wili, ro'q ta nuq'orom wo' naq taq chaaweh i korik re' i ruk'uhtaam cho weh i Dios, re' taq i hat xa kinawaaj wo' taq kinakansam. Re' Abraham ma' nik' ta xub'an cho reh i je' re'. <verse number="41" style="v" />Re' taq i hat, re' taq i na a'n inki a'n taq awajaaw, ki uchjik.</para>
  <para style="p">Re' keh je' wili i xkiq'or:</para>
  <para style="p">Re' hoj ma' xata hoj molooj pamb'eeh xa jinaj la' i QaJaaw, xa re' wo' jinaj chi Dios inki taqe.</para>
  <para style="p">
    <verse number="42" style="v" />Eh re' Jesús je' wili i xuq'or:</para>
  <para style="p">Wi ta korik chi re' Dios taq aaWaJaaw, kinak'ax naq taq, ruum re' hin ruuk' i Dios xin chalik, eh ayu' wilkiin taq awuuk' wach ak'al. Re' hin ma' xata nuna'ojb'al wiib' noq xin chalik, re' Dios xtaaq'anik cho weh. <verse number="43" style="v" />Eh ¿chib'ih reet noq ma' nareq taq chi riij i nuk'uhb'aal noq inaq'or taq i hat? Xa ruum chi ma' nawaaj ta taq ab'iram i nuq'or taq aweh. <verse number="44" style="v" />Re' taq awajaaw i hat re' i aj Yahm re' taq i reh inehchanik aweh, eh re' taq i na a'n iraaj i reh. Eh re' aj Yahm, xa aj kaansoom wo' chaloq pampeet. Ma' jank'al ta rub'an i korik, ma' ruq'or taj i korik. Eh noq i rub'an chukuj q'orik, xa re' reh ruq'or riib', ruum re' reh chukul q'orik, re' reh i rajaaw i chukuj q'orik. <verse number="45" style="v" />Eh re' hin ma' kinanimaj ta taq, ruum re' i korik i nuq'or taq aweh. <verse number="46" style="v" />¿Awach taq aweh i hat i neenreqwik numahk? Eh wila' re' i korik i nuq'or, ¿chib'ih reet noq ma' nanimaj taq weh? <verse number="47" style="v" />Eh awach i rak'uun rixq'uun i Dios, irib'iraj taqe i ruq'oral i Dios. Re' taq i hat ma' nawaaj ta taq ab'iram ruq'oral i Dios, ruum ma' hat ta wo' taq rak'uun rixq'uun i reh, inki.</para>
  <para style="s">Re' i Cristo xa wilik wo' chaloq noq komajaa' inaasjik i Abraham</para>
  <para style="p">
    <verse number="48" style="v" />Eh re' taqe k'amal kib'eeh i aj judío je' wili i xkiq'or reh i Jesús:</para>
  <para style="p">Ruuk' taqe naq'or re' re' xti rub'ehel chi nqaq'or aweh chi hat aj Samaria chi wilik i ma' tob'laj uxlab'al awuuk', inki taqe reh.</para>
  <para style="p">
    <verse number="49" style="v" />Re' Jesús je' wili i xuq'or keh:</para>
  <para style="p">Re' hin ma' xta jino'q ma' tob'laj uxlab'al wuuk'. Re' la' waJaaw k'ahchi' nuye'em ruloq'il, eh re' taq i hat ma' nayeew ta taq nuloq'il i hin. <verse number="50" style="v" />Re' hin ma' k'ahchi' ta nuq'orom chi naa taq aye'em nuloq'il, ro'q ta jinaj wo' naq iraaj chi naa ruye'ariik nuloq'il, re' i nq'atwik q'orik. <verse number="51" style="v" />Re' hin xti korik taq i nuq'or aweh chi awach i runimaj i nuq'oral, ma' jaruuj naa rukimiik, inki.</para>
  <para style="p">
    <verse number="52" style="v" />Re' taqe i aj judío je' wili i xkiq'or reh i Jesús:</para>
  <para style="p">Yu'naak xqareq chik chi riij chi wilik i ma' tob'laj uxlab'al awuuk'. Re' hoj qeht'al chi re' i Abraham kamnaq chaloq, je' wo' taqe i xijalwik cho ruq'oral i Dios. Eh re' hat, ¿chib'ih reet noq inaq'or chi ma' naa ta rukimiik awach i naa runimaniik reh aq'oral? <verse number="53" style="v" />¿Xiik' oon chik naah re' awajaawriik i hat chuwach i xikin cho qamaam, Abraham? Re' reh kamnaq chaloq, je' wo' taqe i xijalwik cho ruq'oral i Dios. Raaj i hat, ¿chib'ih chik awajaawriik noq inakapaaj? inki taqe reh.</para>
  <para style="p">
    <verse number="54" style="v" />Re' i Jesús je' wili i xuq'or keh:</para>
  <para style="p">Wila' xa re' hin i nuyeew runimaal nuwach chi wib'il wiib', xama' xta neenokik wii' re' la' waJaaw inye'wik runimaal nuwach, re' wo' inaq'or taq chi aaDios i hat. <verse number="55" style="v" />Xa re' la' ma' aweht'al ta wo' taq wach. Re' hin weht'al wach. Eh nee ta nuq'or taq aweh chi ma' weht'al ta wach, hin naq chukul q'orik je' akab' taq i hat. Re' hin korik chi weht'al wach, eh i nunimaj wo' i ruq'oral. <verse number="56" style="v" />Eh re' i Abraham, re' taq i xikin cho aamaam i hat, xsuuqb'ik ruk'ux, noq xrib'iraj cho rib'iral i ruq'ijil i nuk'uliik ayu' wach ak'al. Eh noq xk'uhtjik cho reh, xsuuqb'ik ruk'ux, inki Jesús.</para>
  <para style="p">
    <verse number="57" style="v" />Re' taqe i aj judío je' wili i xkiq'or reh i Jesús:</para>
  <para style="p">Re' hat komajaa' ta lajeeb' roxk'ahl haab' ahab'ul. Eh ¿nik' wach noq inaq'or chi xanab'eej wach i Abraham? inki taqe.</para>
  <para style="p">
    <verse number="58" style="v" />Re' Jesús je' wili i xuq'or keh:</para>
  <para style="p">Re' hin xti korik taq i nuq'or aweh chi re' hin xa wilkiin wo' chaloq noq komajaa' inaasjik i Abraham, inki.</para>
  <para style="p">
    <verse number="59" style="v" />Noq xkib'iraj chi je' re' i k'amal kib'eeh i aj judío, xkichop chaloq ab'aj kanteesb'al naq reh i Jesús. Eh re' reh ma' kota chik xuk'uhtaaj riib' keh xelik reje chupaam i rupaat i Dios xik'ik reje pankiyejaal.</para>
  <chapter number="9" style="c" />
  <para style="s">Re' Jesús xuteh inaq'wach jinaj i winaq moywach chi raasb'al</para>
  <para style="p">
    <verse number="1" style="v" />Eh noq ojik i rub'an i Jesús, xrilow wach jinaj i winaq moywach chaloq chi raasb'al. <verse number="2" style="v" />Eh re' taqe i raj tahqaneel xkipahqaaj reh chi je' wili:</para>
  <para style="p">Qaj Tijineel, ¿Awach i wilik ru mahk chi x-aasjik chi moywach i winaq wili ru mahk i reh, oon kimahk irutuutrajaaw? inki taqe.</para>
  <para style="p">
    <verse number="3" style="v" />Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Ma' ruum taj i ru mahk i reh, ni xata ruum i kimahk i rutuut rajaaw x-aasjik chi je' re', re' la' raaj i Dios chi ruuk' i winaq wili naa ruk'utiniik i naa rub'anam. <verse number="4" style="v" />Yu'naak ko je' pan q'iij wilkooj, ajwaal wach chi naa qa'nam i rukamaj i xtaaq'anik cho weh, ruum je' naa okik reh i aq'ab', eh ar ma' nee ta chik i ruyeew riib' chi awach neemb'anik reh i kamanik re' re'. <verse number="5" style="v" />Noq ko wilkiin i hin ayu' wach ak'al, hin ruSaqumaal i tinamit noq wilkiin, inki.</para>
  <para style="p">
    <verse number="6" style="v" />Eh noq ruq'orom chik taqe re' i Jesús, xuchuhb'aaj qohoq wach aak'al, ruuk' i re' xuyejaa' k'isiin i ch'uwa', eh xuyulej chi riij kab'chel inaq'wach i winaq moywach <verse number="7" style="v" />Eh je' wili i xuq'or reh: hiy chatz'aj i naq'awach panjul haa', Siloe, i nuchjik. (Siloe iraaj ruq'orom Taaq'amaj.)</para>
  <para style="p">Eh re' winaq xooj wo' chutz'ajariik inaq'wach, intz'ehtanik chik noq xsutinik chaloq. <verse number="8" style="v" />Re' taqe i ruka'jaah i moywach naq, taqe i ilwinaq cho wach chi pahqanik lemóxna, je' wili i xkiq'or chikiwach:</para>
  <para style="p">¿Mi ma' re' re' i winaq wili i rutzunaa' riib' xa aha' chi pahqanik rulemóxna? inki taqe.</para>
  <para style="p">
    <verse number="9" style="v" />Wilik kiq'orik reh: Re' i reh, inki taqe. Eh wilik kiq'orik reh: Ma' re' tee reh, ro'q ta re' i reh noq ink'utinik, inki taqe, re' winaq moywach naq re' hin, inki.</para>
  <para style="p">
    <verse number="10" style="v" />Xkib'iraj chi je' re', je' wili i xkiq'or reh:</para>
  <para style="p">¿Nik' wach noq xteh naq'awach? inki taqe.</para>
  <para style="p">
    <verse number="11" style="v" />Re' i winaq je' wili i xuq'or:</para>
  <para style="p">Re' i winaq, Jesús rub'ihnaal, xuyejaa' i ch'uwa', xuyulej chi riij kab'chel inaq'nuwach, hiy chatz'aj i naq'awach panjul ha', Siloe, inki weh. Eh xooj wo' nutz'aj i naq'nuwach, eh xinilwik, inki.</para>
  <para style="p">
    <verse number="12" style="v" />Eh aha' wilik i winaq re' re' ¿yu'naak? inki taqe reh.</para>
  <para style="p">Re' re' ra'j xti ma' weht'al ta re' aha' wilik, inki moywach naq.</para>
  <para style="s">Re' taqe i aj fariseo xkipahqaaj reh i winaq nik' wach noq xteh inaq'wach</para>
  <para style="p">
    <verse number="13" style="v" />Re' i moywach naq xk'amarik reje chikiwach aj fariseo, <verse number="14" style="v" />ruum re' Jesús pan hi'limb'al q'iij xuyejaa' i ch'uwa' xuteh wii' inaq'wach i winaq moywach <verse number="15" style="v" />Re' taqe i aj fariseo xkipahqaaj reh chi je' wili:</para>
  <para style="p">¿Nik' wach noq xuteh i naq'awach i winaq re' re'? inki taqe. Re' reh je' wili i xuq'or: Xuyulej i ch'uwa' chi riij inaq'nuwach kab'chel. Eh re' hin xponik nutz'aj i naq'nuwach ruum aj re', yu'naak kinilwik chik, inki.</para>
  <para style="p">
    <verse number="16" style="v" />Eh wilik taqe i aj fariseo je' wili xkiq'or:</para>
  <para style="p">Re' winaq wili ma' ruuk' taj i Dios inchalik, ruum i rub'an i kamanik pan hi'limb'al q'iij, inki taqe.</para>
  <para style="p">Wilik i xiq'orik reh chi je' wili:</para>
  <para style="p">Eh ¿nik' naq wach noq neeruk'uhtaaj taqe i nimaq wach ma' ilooj taj wili, aj mahk taj? inki taqe, ma' xkian ta jinaj wach kik'ux. <verse number="17" style="v" />Eh je' wo' chik wili i xkiq'or reh:</para>
  <para style="p">Wila' korik chi xuteh i naq'awach i winaq re' re', ¿awach i reh noq inakapaaj i hat? inki taqe reh.</para>
  <para style="p">Chi wee hin jalal ruq'oral i Dios, inki noq chaq'wik.</para>
  <para style="p">
    <verse number="18" style="v" />Eh re' taqe i aj judío ma' xkinimaj taj chi re' winaq re' re' moywach cho chi raasb'al, eh chi chupaam taqe q'iij re' re' inilwik chik, korehtaal xkitaq'aaj ruk'amariik i rutuut rajaaw. <verse number="19" style="v" />Eh xkipahqaaj reh i rutuut rajaaw chi je' wili:</para>
  <para style="p">¿Mi awak'uun taq i winaq wili? Re' hoj inqaaj taq chi neenaq'or qeh mi xti korik chi moywach noq x-aasjik. Eh yu'naak, ¿nik' wach noq inilwik chik? inki taqe.</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' i rutuut rajaaw je' wili i chaq'wik xkian:</para>
  <para style="p">Hoo', korik chi qak'uun, eh korik chi moywach noq aasjinaq chaloq. <verse number="21" style="v" />Eh re' hoj ma' qeht'al taj nik' wach noq inilwik chik yu'naak. Eh ma' qeht'al taj awach xtehwik ree naq'wach, cha pahqaaj taq ree reh. Re' reh wilik chik ruhab'ul, nee taq i ruq'or aweh nik' wach noq xteh inaq'wach, inki taqe.</para>
  <para style="p">
    <verse number="22" style="v" />Je' re' xkiq'or i rutuut rajaaw ruum i kiyo'jiik, ruum re' taqe i k'amal kib'eeh i aj judío kianam chik jinaj wach kik'ux chi naa kesam cho chi riij i paat inkiloq'ej wii' i Dios, awach nee nq'orik reh chi re' Jesús re' i Cristo. <verse number="23" style="v" />Ruum aj re', je' wili xkiq'or i rutuut rajaaw: Chapahqaaj taq re' reh wilik chik ruhab'ul, inki taqe.</para>
  <para style="p">
    <verse number="24" style="v" />Re' taqe i aj judío xkiyuq'eej wo' chik kuuk' i winaq moywach naq, je' wili i xkiq'or reh:</para>
  <para style="p">Xti cha q'or qeh i korik parub'ihnaal i Dios mi korik chi re' winaq re' re' xtehwik i naq'awach. Re' hoj ma' nqanimaj taj, ruum qeht'al chi re' reh aj mahk, inki taqe.</para>
  <para style="p">
    <verse number="25" style="v" />Re' reh je' wili i xuq'or:</para>
  <para style="p">Re' re' ra'j ma' weht'al ta re' hin mi aj mahk i winaq re' re'. Xa re' weht'al i hin, chi hin naq moywach eh yu'naak kinilwik chik ruum, inki.</para>
  <para style="p">
    <verse number="26" style="v" />Eh xkipahqaaj wo' chik reh chi je' wili:</para>
  <para style="p">¿Chib'ih i xub'an aweh? ¿Nik' wach noq xuteh i naq'awach? inki taqe reh.</para>
  <para style="p">
    <verse number="27" style="v" />Re' reh je' wili i xuq'or:</para>
  <para style="p">Re' hin xnuq'or taq chik aweh, eh ma' nanimaj ta taq weh. ¿Chib'ih reet noq inawaaj wo' taq chik chi naa nuq'orom aweh? ¿Mi nawaaj wo' taq re' hat chi naa taq akahniik chi raaj tahqaneel? inki.</para>
  <para style="p">
    <verse number="28" style="v" />Xkib'iraj chi je' re' i xq'orarik keh, xkib'aj, je' wili i xkiq'or reh:</para>
  <para style="p">Re' hat, hat raj tahqaneel i winaq re' re'. Eh re' hoj, hoj raj tahqaneel i Moisés wihinaq chaloq. <verse number="29" style="v" />Re' hoj qeht'al chi re' Dios ruq'o'reem chaloq i Moisés. Eh re' winaq inaq'or i hat, xata qeht'al aha' elinaq chaloq, inki taqe reh.</para>
  <para style="p">
    <verse number="30" style="v" />Re' moywach naq je' wili i xuq'or:</para>
  <para style="p">Q'e' taq kinokik meem i na a'n, ruum inaq'or taq chi ma' aweht'al ta taq aha' elinaq chaloq i winaq re' re'. Eh re' hin, xuteh inaq'nuwach. <verse number="31" style="v" />Eh qeht'al chi re' Dios ma' rib'iraj ta taqe i aj mahk xa re' wo' rib'iraj taqe i kiloq'inik reh, eh inki a'n iraaj i reh. <verse number="32" style="v" />Eh je' wo' chik, ma' jank'al q'iij i nib'irjik rib'iral chi wilik ta jino'q intehwik reh inaq'wach jino'q i moywach cho chi raasb'al. <verse number="33" style="v" />Eh wi ta ma' ruuk' i Dios inchalik, ma' xta naq ineenchol rub'aan, inki keh.</para>
  <para style="p">
    <verse number="34" style="v" />Eh je' wili i xkiq'or reh i moywach naq:</para>
  <para style="p">Re' hat pamahk hat aasjinaq ¿Nik' wach noq inakapaaj chi naakooj atijem? inki taqe.</para>
  <para style="p">Eh xkesaj cho chi riij i paat inkiloq'ej wii' Dios.</para>
  <para style="s">Re' taqe i moywach panuxlab'al</para>
  <para style="p">
    <verse number="35" style="v" />Re' Jesús xrib'iraj chi re' moywach naq xehteesjik cho chi riij i paat inlooq'jik wii' i Dios. Eh noq xuk'ul pamb'eeh, xupahqaaj reh chi je' wili:</para>
  <para style="p">¿Mi nanimaj i hat i Ak'uunb'ees Dios? inki.</para>
  <para style="p">
    <verse number="36" style="v" />Re' reh je' wili xuq'or:</para>
  <para style="p">Jaaw, re' hin inwaaj chi neenaq'or weh awach i re', reh chi neenunimaj, inki.</para>
  <para style="p">
    <verse number="37" style="v" />Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Re' hat awilom chik wach hin i k'utaaj i nub'an awuuk', inki reh.</para>
  <para style="p">
    <verse number="38" style="v" />Eh re' i moywach naq, xuxuk'aa' riib' chuwach i Jesús, wila' re' i hat, Jaaw, tinunimaj chu'nchel nuk'ux, inki reh.</para>
  <para style="p">
    <verse number="39" style="v" />Eh re' Jesús je' wili xuq'or:</para>
  <para style="p">Re' hin xin chalik wach ak'al chuq'atariik i q'orik reh chi re' taqe i moywach naa rutehiik inaq' kiwach, chi re' taqe i tehlik naq inaq'kiwach, naa kikahniik chi moywach, inki.</para>
  <para style="p">
    <verse number="40" style="v" />Eh noq xkib'iraj chi je' re' i aj fariseo wilkeeb' i koq ruuk' i Jesús, xkipahqaaj reh chi je' wili:</para>
  <para style="p">Raaj i hoj, ¿hoj aj wo' naa moywach noq inaq'or re'? inki taqe reh.</para>
  <para style="p">
    <verse number="41" style="v" />Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Wi ta hat taq moywach ma' xta naq taq amahk. Ruum la' chi naq'or taq chi tehlik i naq'awach, naa rukahniik cha naah taq amahk, ki uchjik ruum i Jesús.</para>
  <chapter number="10" style="c" />
  <para style="s">Re' i aj cha'joom, eh re' taqe rutentzuun</para>
  <para style="p">
    <verse number="1" style="v" />Re' Jesús je' wili i xuq'or keh: Re' hin xti korik taq i nuq'or aweh: Awach i ma' re' ta chi chii' i ru puertahiil i kikoraal i tentzun inokik, tokoom chik inooj johtoq, re' re' ajileq' eh aj kaansoom. <verse number="2" style="v" />Eh re' i manlik aj cha'jen tentzun reh, xti chi chii' i puerta inokik i koq. <verse number="3" style="v" />Eh re' aj cha'joom i ruteh i puerta. Eh inokik i koq, i ruyuq'eej taqe i rutentzuun ruuk' i kib'ihnaal, eh re' keh inkib'iraj wo' i ruq'oral. Eh i resaj taqe chaloq chi riij i koraal i rutentzuun. <verse number="4" style="v" />Eh resam-oq chik taqe chaloq chu'nchel i rutentzuun, inooj chi peet b'eeh chikiwach. Re' taqe rutentzuun inkitahqeej wo' hoq, ruum keht'al wach i ruq'oral. <verse number="5" style="v" />Re' taqe i rutentzuun ma' nkitahqeej ta i ma' keht'al ta wach kielik chuwach, ruum ma' keht'al taj nik' wach kiq'orik taqe i ma' keht'al ta wach, inki Jesús. <verse number="6" style="v" />Re' Jesús xuq'or keh i jalwaach q'orik wili, xa re' la' re' keh xama' xkireq ta wo' chi riij chib'ih i xraaj ruq'orom keh ruuk' i re'.</para>
  <para style="s">Re' i Jesús xuq'or chi re' reh i Atoob'laj aj Cha'joom</para>
  <para style="p">
    <verse number="7" style="v" />Eh je' wo' chik wili i xq'orarik keh ruum i Jesús:</para>
  <para style="p">Re' hin xti korik taq i nuq'or aweh chi re' hin i Puerta i kiokik wii' taqe i tentzun. <verse number="8" style="v" />Eh chu'nchel i k'ulinaq chi peet b'eeh chi nuwach i hin, ajileq', aj kaansoom taqe, eh ma' xinimjik ta wo' kuum taqe i tentzun. <verse number="9" style="v" />Re' hin i Puerta. Awach inokik wuum i hin, re' re' naa ruko'ljiik, eh naa rukahniik chi je' rukab' i tentzun i nelik inokik pan koraal, eh i rureq ruwa'. <verse number="10" style="v" />Re' i ajileq', xa re' i leq', xa re' ikaansanik, xa re' sachooj xchalik rub'an. Raaj i hin, xin chalik chuye'ariik taq aweh i k'acharik, reh chi naa taq ruwihiik aak'achariik chi juneliik.</para>
  <para style="p">
    <verse number="11" style="v" />Re' hin i Atoob'laj aj Cha'joom. Re' i atoob'laj aj cha'joom i ruyeew riib' pankimik chi riij taqe rutentzuun. <verse number="12" style="v" />Eh re' aj cha'joom xa re' i rutojb'aal i ruk'ax, noq i rilow chi nk'u'loq i xojb' i rukanaa' taqe kahnoq i tentzun, i rumol chi elik, ruum ma' re' ta wo' i reh i manlik cha'joom, eh ma' re' ta wo' reh taqe i tentzun. Eh re' xojb', i ruchop taqe i tentzun, k'ul i rutukej kiwach. <verse number="13" style="v" />Re' i winaq re' re' i rumol chi elik, ruum re' reh xa re' wo' i rutojb'aal iraaj, eh re' taqe i tentzun ma' xta raaj reh.</para>
  <para style="p">
    <verse number="14" style="v" />Re' hin i Atoob'laj aj Cha'joom. Weht'al kiwach nutentzuun, eh re' taqe i wee hin keht'al wo' nuwach, <verse number="15" style="v" />je' rukab' noq reht'al nuwach i waJaaw i hin, je' wo' re' noq weht'al wach i reh. Je' re' noq, re' hin i nuyeew wiib' pankimik chikiij taqe i nutentzuun. <verse number="16" style="v" />Eh wilik taqe i nutentzuun ma' re' ta ruuk' i wilkeeb' ayu' pan koraal. Re' keh naa wo' nuk'amam taqe cho ayu', naa kib'iram i nuq'oral, xa jinaj chik kiwach naa rukahniik, eh xa jinaj chik chi aj cha'joom i naa rucha'jiniik keh. <verse number="17" style="v" />Re' waJaaw kiruk'ax, ruum i nuyeew wiib' pankimik, reh chi naa wo' chik nuk'ulum i nuk'achariik. <verse number="18" style="v" />Ma' tokoom taj naa rukansaniik weh xanaa la' nuye'em wiib' chi kimik. Ruum re' hin wilik wajaawriik chuye'ariik wiib' chi kimik, eh wilik wajaawriik chuk'ulariik wo' chik i nuk'achariik. Re' i wili xuq'or cho weh i waJaaw, inki Jesús.</para>
  <para style="p">
    <verse number="19" style="v" />Eh noq xkib'iraj i q'orik wili taqe i k'amal kib'eeh i aj judío, xyoj wo' chik kik'ux chikiwach. <verse number="20" style="v" />Eh wilik taqe i xkiq'or chi je' wili:</para>
  <para style="p">¿Chib'ih reet noq inkinimaj i ruq'or i winaq re' re'? Re' reh wilik i ma' tob'laj uxlab'al ruuk', eh ahqaal inki taqe.</para>
  <para style="p">
    <verse number="21" style="v" />Wilik xiq'orik reh chi je' wili:</para>
  <para style="p">Ma' awach taj i wilik ma' tob'laj uxlab'al ruuk' nee nq'orik chi je' rukab' i reh. Re' ma' tob'laj uxlab'al ma' nee ta ruteh inaq'kiwach taqe i moywach inki taqe.</para>
  <para style="s">Re' taqe i k'amal kib'eeh i aj judío xkixowaaj wach i Jesús</para>
  <para style="p">
    <verse number="22" style="v" />Ar Jerusaleem paruq'ijil jab', k'ahchi' kik'sam i ninq'iij, re' i ruhab'ul i rusulariik i rupaat i Dios. <verse number="23" style="v" />Eh re' Jesús b'ehik i rub'an ar chi muuj i rupaat i Dios, re' i Muuj Salomón rub'ihnaal. <verse number="24" style="v" />Eh xkisutej riij i Jesús, eh xkipahqaaj reh chi je' wili:</para>
  <para style="p">¿Xti ko jaruuj aj wo' nateh wach qeh chib'ih a'nam? Wila' re' i hat i Cristo, xti cha q'or qeh yu'naak chi jumpech, inki taqe.</para>
  <para style="p">
    <verse number="25" style="v" />Eh re' Jesús je' wili i chaq'wik xub'an:</para>
  <para style="p">Re' hin nuq'orom taq chik aweh awach i hin, eh ma' nanimaj ta taq weh. Re' taqe i ma' ilooj taj i nub'an ruuk' i rajaawriik i waJaaw ink'uhtanik reh chi korik awach i hin. <verse number="26" style="v" />Eh re' taq i hat ma' nanimaj ta taq, ruum ma' hat ta wo' taq haa' chi kixilak taqe i nutentzuun. <verse number="27" style="v" />Re' taqe i nutentzuun i hin inkinab'eej i nuq'oral, eh re' hin weht'al wo' kiwach, eh kinkitahqeej wo' hoq. <verse number="28" style="v" />Eh re' wo' hin kinye'wik keh i juneliik k'acharik. Eh ma' jaruuj naa rusahchiik kiwach, eh ma' awach ta neenq'uchwik keh panuq'ab'. <verse number="29" style="v" />Re' waJaaw xye'wik weh taqe nutentzuun xiik' naah i rajaawriik chikiwach chu'nchel chib'ih i wilik. Eh ma' awach ta neenq'uchwik keh pan q'ab' i waJaaw. <verse number="30" style="v" />Re' i waJaaw, eh re' hin, xa jinaj qawach, inki Jesús.</para>
  <para style="p">
    <verse number="31" style="v" />Xkib'iraj chi je' re' taqe i k'amal kib'eeh i aj judío, xkichop taqe chaloq ab'aj kantesb'al naq reh i Jesús. <verse number="32" style="v" />Je' wili i xq'orarik keh ruum i Jesús:</para>
  <para style="p">Ruuk' i rajaawriik i waJaaw, ma' k'isiin otob'il xnub'an taq chawach. ¿Aha' wilik ximahkunik wii' ruuk' taqe re', ruum kinawaaj taq kinakansam chi ab'aj? inki.</para>
  <para style="p">
    <verse number="33" style="v" />Re' taqe i k'amal kib'eeh i aj judío je' wili i xkiq'or reh:</para>
  <para style="p">Re' hoj ma' ruum taj i holohik laj na'ojb'al i na a'n tiqaaj kaat qakansam chi ab'aj, ruum la' chi naq'ehtaaj i Dios ruuk' taqe aq'oral. Xanaah re', xa hat wo' winaq, eh inakoj inchaa wiib' chi Dios, inki taqe.</para>
  <para style="p">
    <verse number="34" style="v" />Eh je' wili i xq'orarik keh ruum i Jesús:</para>
  <para style="p">Chupaam i k'uhb'aal ye'ooj taq chaaweh i hat tz'ihb'amaj, chi re' Dios awach i kinimanik reh ruq'or chi dios taqe, inki. <verse number="35" style="v" />Wila' tz'ihb'amaj cho pan santo laj huuj chi re' Dios xukoj taqe cho chi dios awach taqe aj eh xuq'or i ruk'uhb'aal, ma' nee ta ruyee riib' chi neen q'orarik chi ma' korik taj. <verse number="36" style="v" />Eh re' hin, re' wo' Dios xsik'wik cho nuwach, eh xirutaq'aaj chaayu' wach ak'al. Eh ¿nik' taq wach noq inaq'or i hat chi xnuq'ehtaaj i Dios, ruum chi xnuq'or wiib' chi hin Rak'uun i reh? <verse number="37" style="v" />Wila' ma' k'ahchi' kiin taqe i rukamaj i waJaaw, i ruk'ul chi ma' nee ta taq kinanimaj. <verse number="38" style="v" />Eh wi xnub'an i rukamaj i waJaaw, ro'q ta ma' nee taq kinanimaj i hin, cha nimaj taq aha' wilik i neenub'an. Reh chi nee taq inanab'eej chi re' i waJaaw wilik wuuk' i hin, eh re' hin wilkiin ruuk' i waJaaw, ki uchjik ruum i Jesús.</para>
  <para style="p">
    <verse number="39" style="v" />Eh xkaaj wo' naq chik kichopom i Jesús xa re' la', re' reh ma' xuyeew ta wo' riib' keh.</para>
  <para style="p">
    <verse number="40" style="v" />Chi riij i re', re' Jesús xooj wo' chik parelb'aal q'iij ree nim ha' Jordán. Ar xwihik chupaam i ye'aab' re' xub'an cho wii' qasanik ha' i Juan pampeet. <verse number="41" style="v" />Eh ma' k'isiin i xiooj ilwoq reh i Jesús, je' wili xkiq'or:</para>
  <para style="p">Re' Juan aj qasan ha' ma' xta jino'q ma' ilooj taj xuk'uhtaaj xa re' la', re' i xuq'or chi riij i winaq wili xti korik, inki taqe.</para>
  <para style="p">
    <verse number="42" style="v" />Eh ma' k'isiin i xinimanik reh i Jesús chupaam i ye'aab' re' re'.</para>
  <chapter number="11" style="c" />
  <para style="s">Re' i rukimiik i Lázaro</para>
  <para style="p">
    <verse number="1" style="v" />Eh jinaj i winaq xwihik q'e' yowaab', Lázaro i rub'ihnaal. Ar Betania xi patinik ruch'ihil taqe i kiib' chi ranaab', María b'ih i jinaj, Marta b'ih i jinaj. <verse number="2" style="v" />Re' i María re' re' i xb'uch'wik reh i rooq i QaJaaw Jesús chupaam ink'ohnik laj iq'oom eh ruuk' wo' chik i rismaal i naah xuchiqsaj i rooq i Jesús. <verse number="3" style="v" />Eh re' taqe i ranaab' i Lázaro xkitaq'aaj i taqareel, xponik ruq'or reh i Jesús chi je' wili:</para>
  <para style="p">Jaaw, re' i q'e' nak'ax xqajik chi yab'ilaal, inki.</para>
  <para style="p">
    <verse number="4" style="v" />Noq xrib'iraj chi je' re' i Jesús, je' wili i xuq'or:</para>
  <para style="p">Re' yab'ilaal re' re' ma' kantesb'al ta reh, k'uhtb'al la' reh chi naa ruye'ariik ruloq'il Ajaab'ees Dios, eh chi naa ruye'ariik nuloq'il i hin, Ak'uunb'ees Dios, inki.</para>
  <para style="p">
    <verse number="5" style="v" />Re' Jesús ma' re' ta nkiwii' chi q'e' i ruk'ax i Marta i María, je' wo' hoq i Lázaro, <verse number="6" style="v" />noq xq'orarik reh chi xqajik chi yab'ilaal i Lázaro, kokiib' chik q'iij xkahnik chupaam i ye'aab' wilik wii'. <verse number="7" style="v" />Chi riij i re', re' Jesús je' wili i xuq'or keh i raj tahqaneel:</para>
  <para style="p">Taq wo' taq chik Judea, inki.</para>
  <para style="p">
    <verse number="8" style="v" />Re' taqe aj tahqaneel je' wili i xkiq'or reh:</para>
  <para style="p">Qaj Tijineel, komajaa' ta najtir xatkaaj naq kikansam chi ab'aj ar taqe i aj judío, eh inawaaj wo' chik ojik ar, inki taqe.</para>
  <para style="p">
    <verse number="9" style="v" />Eh je' wili i xq'orarik keh ruum i Jesús:</para>
  <para style="p">Re' i jinaj q'iij, kab'laj ora i wilik reh. Eh awach i pan q'iij imb'ehik, ma' nee ta rutoxk'iij i rooq, ruum i rilow i saqum wilik chinaah i wach ak'al wili. <verse number="10" style="v" />Eh raaj wila' panq'equm aq'ab' imb'ehik jino'q, re' re' ra'j neerutoxk'iij re' rooq, ruum ma' xta saqum insihq'inik reh, inki.</para>
  <para style="p">
    <verse number="11" style="v" />Chi riij i re', je' wo' chik wili i xuq'or keh:</para>
  <para style="p">Re' qamigo, Lázaro rub'ihnaal, xqajik chi wirik, eh re' hin naa rojiik wuksam, inki.</para>
  <para style="p">
    <verse number="12" style="v" />Re' taqe raj tahqaneel je' wili i xkiq'or reh:</para>
  <para style="p">Jaaw, wila' xqajik i ruwiriik, re' re' rehtalil chi naa ruk'achjiik, inki taqe.</para>
  <para style="p">
    <verse number="13" style="v" />Xanaah re', re' i xuq'or i Jesús re' chi xkimik chik i Lázaro. Eh noq xkikapaaj taqe i raj tahqaneel chi re' wirik xuq'or, xa wirik chi je' wili. <verse number="14" style="v" />Re' i Jesús xuq'or keh i korik, je' wili i xuq'or:</para>
  <para style="p">Re' Lázaro korik chi xkimik chik. <verse number="15" style="v" />Eh re' hin q'e' insuuqb'ik nuk'ux chi ma' wilkiin ta ar noq xkimik, eh ma' xta reet taq cha weh i hat, chi je' re' neenkowjik taq ak'ux, taq taq qilow, inki.</para>
  <para style="p">
    <verse number="16" style="v" />Eh re' i Tomas, re' i Laach inkiq'or reh, je' wili i xuq'or keh i ruch aj tahqaneel:</para>
  <para style="p">Wila' naa rojiik i reh, taq taq haa' i hoj, hoj-oq junkimiik ruuk' ar, inki.</para>
  <para style="s">Re' Jesús i nuksanik cho keh i kamnaq, re' wo' reh inye'wik k'acharik</para>
  <para style="p">
    <verse number="17" style="v" />Eh noq xponik i Jesús Betania, xq'orarik reh chi kijib' chik q'iij rumuhqiik i Lázaro. <verse number="18" style="v" />Re' Betania ma' najt ta ruuk' i Jerusaleem wilik xa je' naa k'isiin ma' jinaj léwa ruuk'. <verse number="19" style="v" />Eh noq xkimik i kixib'aal i Marta ruch'ihil i María, ma' k'isiin i aj Judío xi ponik chuye'ariik rusuqkiil kik'ux ruum chi xkimik chik i kixib'aal. <verse number="20" style="v" />Noq xrib'iraj i Marta chi k'isiin ma' nooj k'oloq i Jesús, xooj ruk'ul pamb'eeh eh re' María reh xkahnik cho pampaat. <verse number="21" style="v" />Noq xrilow wach i Jesús i Marta, je' wili i xuq'or reh:</para>
  <para style="p">Jaaw, wilkaat ta ayu', ma' xkimik ta naq i nuxib'aal. <verse number="22" style="v" />Xa re' la', re' hin weht'al chi re' Dios nee wo' ruyeew chaaweh yu'naak chu'nchel i neenapahqaaj reh, inki.</para>
  <para style="p">
    <verse number="23" style="v" />Re' axib'aal naa wo' chik ruk'aach ruka'peech, i nuchjik ruum i Jesús.</para>
  <para style="p">
    <verse number="24" style="v" />Korik, Jaaw chi naa wo' chik ruk'aach chaloq, xa re' la' kore' noq naa wo' chik kik'achariik chaloq taqe i kamnaq pantz'apaab' wach ree q'iij, inki i Marta.</para>
  <para style="p">
    <verse number="25" style="v" />Eh re' Jesús je' wili i xuq'or:</para>
  <para style="p">Re' hin i kinuksanik cho keh i kamnaq, re' hin kinye'wik kik'achariik. Eh awach i nimanik weh, ro'q ta kimoq, naa wo' chik ruk'aach cho ruka'peech. <verse number="26" style="v" />Eh chu'nchel i ko k'achalkeeb' kinimanik weh, ma' kimik ta naa kianam chi jumpech. ¿Mi nanimaj i wili i hat? i nuchjik i Marta.</para>
  <para style="p">
    <verse number="27" style="v" />Hoo', Jaaw re' hin i nunimaj chi re' hat i Cristo, i Rak'uun i Dios, re' i q'orooj chaawib'iral chi naa ak'uliik ayu' wach ak'al, inki Marta ree Jesús.</para>
  <para style="s">Re' Jesús xoq'ik i koq chi chii' i xmuhqik wii' i Lázaro</para>
  <para style="p">
    <verse number="28" style="v" />Ruq'orom-oq chik i wili i Marta, xooj chuk'amariik i ruchaaq', María rub'ihnaal xujask'uuj i koq pan xikin chi je' wili:</para>
  <para style="p">Re' i aj Tijineel wilik chik ayu', xutaq'aaj chak'amariik, inki reh.</para>
  <para style="p">
    <verse number="29" style="v" />Noq xrib'iraj i María i xq'orarik reh, jumehq'iil xwuktik reje, xooj chi rilariik i Jesús. <verse number="30" style="v" />Re' Jesús xakomajaa' wo' nokik pank'isa tinamit xa ko ar wo' wilik chupaam i ye'aab' aha' xponik k'ularoq wii' ruum i Marta. <verse number="31" style="v" />Eh re' taqe i aj judío wilkeeb' i koq pampaat ruuk' i María chuye'ariik rusuqkiil ruk'ux, noq xkilow chi xelik chaloq rajimam riib' i María, xi elik wo' cho haa' chi riij.</para>
  <para style="p">Re' keh xkikapaaj chi ar xooj chi oq'ik aha' xmuhqik wii' i Lázaro.</para>
  <para style="p">
    <verse number="32" style="v" />Noq xooj k'oloq i María aha' wilik wii' i Jesús, xuxuk'aa' i koq riib' ri'si rooq, je' wili i xuq'or reh:</para>
  <para style="p">Jaaw, wi ta wilkaat ayu', re' nuxib'aal ma' xkimik ta naq, inki.</para>
  <para style="p">
    <verse number="33" style="v" />Eh noq xrilow i Jesús chi oq'ik i rub'an i María, je' wo' taqe i aj judío xi chalik chi riij, ma' k'isiin ta xchalik rutib'iik ruk'ux, xa nyot'ik chik i ránima xchalik. <verse number="34" style="v" />Eh xupahqaaj keh chi je' wili:</para>
  <para style="p">¿Aha' taq xamuq'aa'? inki.</para>
  <para style="p">Wulu' xqamuq'aa':</para>
  <para style="p">Jaaw taq qilow, inki taqe.</para>
  <para style="p">
    <verse number="35" style="v" />Eh re' Jesús xoq'ik. <verse number="36" style="v" />Re' taqe i aj judío, je' wili i xkiq'or:</para>
  <para style="p">Chawilow taq ma' k'isiin ta ti'kiil i rik'raaj inki taqe.</para>
  <para style="p">
    <verse number="37" style="v" />Eh wilik taqe i je' wili xkiq'or:</para>
  <para style="p">Wila' re' i winaq wili xtehwik inaq'wach i moywach naq, wilik taa yu' noq ko yowaab' i Lázaro, xuk'achrisaj naq, ma' xkimik ta naq, inki taqe.</para>
  <para style="s">Re' noq xwuktik wo' chik chaloq i Lázaro chi k'achlik wach</para>
  <para style="p">
    <verse number="38" style="v" />Re' Jesús ma' k'isiin ta xtib'ik ruk'ux, xujil i koq riib' chi chii' i rujuleel i Lázaro. Re' jul re' re' panab'aj k'otooj i koq, eh tz'apooj i koq chii' chi tz'ilom ab'aj. <verse number="39" style="v" />Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Chawesaj taq iloq ab'aj chi chii' i jul, inki.</para>
  <para style="p">Eh re' Marta, i ranaab' i kamnaq, je' wili xuq'or:</para>
  <para style="p">Jaaw, wilik naa chik ruxlaab' ruum kijib' chik q'iij rukimiik inki.</para>
  <para style="p">
    <verse number="40" style="v" />Eh re' i Jesús je' wili i xuq'or reh:</para>
  <para style="p">Ma' xnuq'or ta naa aweh chi wila' xanimaj i nee nawil, wach i ruloq'il i Dios, inki.</para>
  <para style="p">
    <verse number="41" style="v" />Eh xkesaj wo' iloq ab'aj chi chii' i jul. Eh re' Jesús xtz'ehtanik johtoq pan taxaaj, je' wili xuq'or parutiij:</para>
  <para style="p">WaJaaw, inut'iosej aweh, ruum xinab'iraj chaloq. <verse number="42" style="v" />Re' hin weht'al chi xa kinab'iraj wo' chaloq chi juneliik. Xa re' la', re' wili i nuq'or aweh k'axb'al keh i tinamit wilkeeb' ayu', reh chi neenkinimaj chi re' hat xat-taaq'anik cho weh ayu' wach ak'al, inki.</para>
  <para style="p">
    <verse number="43" style="v" />Eh ruq'orom-oq chik taqe re' i Jesús, kow xuk'er chii', je' wili i xuq'or:</para>
  <para style="p">Lázaro, eleen cho chupaam i jul muqulkaat wii' inki.</para>
  <para style="p">
    <verse number="44" style="v" />Eh re' i kamnaq xelik wo' cho panjul chi b'ak'lik wach chi itz'ihy, b'otlik i wach chi itz'ihy. Xrilow chi je' re' i Jesús, je' wili i xuq'or keh:</para>
  <para style="p">Chachej taq wach chayeew taq q'ab' reh chi neenb'ehik reje, inki.</para>
  <para style="s">Re' i ruyejeb'jiik wach i ruchopariik i Jesús</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26.1-5</ref>; <ref loc="MRK 14:1-2">Mar 14.1-2</ref>; <ref loc="LUK 22:1-2">Luc 22.1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" />Eh ruum i ma' ilooj taj re' re' xub'an i Jesús, ma' k'isiin i aj judío xinimanik reh, re' taqe i xi tahqinik cho reh i María, i xi ilwik reh i xub'an i Jesús. <verse number="46" style="v" />Xa re' la', wilik chi kixilak i aj judío re' re' i xiooj kuuk' i aj fariseo, xponik kik'utjaaj keh i ma' ilooj taj xub'an i Jesús. <verse number="47" style="v" />Eh re' taqe i aj fariseo, taqe i kajaaw i k'amal kib'eeh aj tiij, xkimol kiib' kuuk' i q'atal q'orik, eh je' wili i xkiq'or:</para>
  <para style="p">¿Chib'ih taq i naaqa'nam? Re' winaq re' re' ma' k'isiin i nimaq wach ma' ilooj taj k'ahchi' ruk'uhtaam. <verse number="48" style="v" />Wila' xa xqakanaa' chi je' re', chu'nchel i naakinimaniik reh, eh re' taqe i aj Roma nee kichalik chusachariik wach i rupaat i qaDios, je' wo' i qatinamiit, inki taqe.</para>
  <para style="p">
    <verse number="49" style="v" />Eh jinaj keh i wilkeeb' ar, Caifas rub'ihnaal, kajaaw i k'amal kib'eeh aj tiij chupaam i haab' re' re', je' wili xuq'or:</para>
  <para style="p">Re' taq i hat ma' xta taq aweht'al <verse number="50" style="v" />Mi ma' nakoj taq rehtaal re' chi ma' xta reet chi xa jinaj i winaq neenkimik chikiij i tinamit chuwach chi neensacharik wach i qatinamiit, inki.</para>
  <para style="p">
    <verse number="51" style="v" />Eh re' Caifas ma' xata paruk'ux xchalik i xuq'or. Ruum la' chi re' reh i wilik chi kajaaw i k'amal kib'eeh aj tiij chupaam i haab' re' re', re' Dios xq'orik cho paruk'ux chi xuq'or chi re' Jesús naa rukimiik chikiij i tinamit i aj judío. <verse number="52" style="v" />Eh ma' xata chikiij i tinamit re' re', ruum la' wo' rukimiik i reh naa rumoliik cho kiwach chu'nchel i rak'uun rixq'uun i Dios kitukem kiib' xa aha' yuuq'. <verse number="53" style="v" />Je' re' noq, re' taqe i q'atal q'orik xa chupaam i q'iij re' re' xkiyejaa' wach chi naa kikansam i Jesús.</para>
  <para style="p">
    <verse number="54" style="v" />Ruum i re', ma' nb'ehik ta chik chi wachiil i Jesús chi kixilak i aj judío, xelik la' reje ar i Judea. Ar chik xooj pan tinamit, Efraín, re' wili ma' najt ta panchiq yuuq'. Ar xwihik ruch'ihil taqe i raj tahqaneel.</para>
  <para style="p">
    <verse number="55" style="v" />Eh xa ilook'-oq chik i runinq'ijiik i elik chaloq Egipto. Ma' k'isiin i xi elik chaloq pantaq kok' tinamit, xiooj Jerusaleem, tz'ajal kiib' niimb'al reh i najtir k'uhb'aal. <verse number="56" style="v" />Eh noq wilkeeb' chik parupaat i Dios, xtohq'ik kisik'im i Jesús k'ul xkipahqaaj chikiwach chi je' wili:</para>
  <para style="p">¿Chib'ih taq inaq'or i hat mi nee ta wo' inchalik ayu' paninq'iij? inki taqe.</para>
  <para style="p">
    <verse number="57" style="v" />Eh re' taqe i aj fariseo, taqe i kajaaw i k'amal kib'eeh aj tiij, kesam ruq'orkiil chi wila' awach i naab'inik reh aha' wilik i Jesús, inchol ruq'orom qeh, reh chi neenqataq'aaj ruchopariik, inki taqe.</para>
  <chapter number="12" style="c" />
  <para style="s">Jinaj ixoq xb'uch' wik reh i rooq i Jesús chupaam ink'ohnik laj iq'oom</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat 26.6-13</ref>; <ref loc="MRK 14:3-9">Mar 14.3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Eh xa pan waqiib'-oq chik q'iij intohq'ik i runinq'ijiik i elik chaloq Egipto, re' Jesús xooj pan tinamit Betania, re' i xpatinik wii' i Lázaro, re' i ruksam wo' chik chaloq chi k'achlik wach. <verse number="2" style="v" />Eh ar xkiyejaa' ruwa' i Jesús ree xq'eq. Eh re' i Marta xpuhkanik cho kiwa'. Re' Lázaro wilik i koq haa' nah mexa chi wi'k ruuk' i Jesús. <verse number="3" style="v" />Eh re' i María xuk'am chaloq i jinaj lemeta ink'ohnik laj iq'oom nardo ruyej-aal q'e' k'ih tz'aaq, xub'uch' i rooq i Jesús, eh xuchiqsaj wo' chik ruuk' i rismaal i naah. Re' iq'oom xupuhkaaj riib' i ruk'ohonkiil chupaam i paat re' re'. <verse number="4" style="v" />Eh xrilow chi je' re' i Judas Iscariote, re' jinaj keh i raj tahqaneel i Jesús, re' i xk'ayinik reh chi ma' eht'alimaj, je' wili i xuq'or:</para>
  <para style="p">
    <verse number="5" style="v" />¿Chib'ih reet noq ma' xk'ayjik ink'ohnik laj iq'oom wili chi ixib' siento chi tumiin? Eh re' tumiin re' re' nee naq inye'arik keh i neb'aa', inki.</para>
  <para style="p">
    <verse number="6" style="v" />Re' Judas je' wili xuq'or, ma' ruum ta chi ruketelaaj kiwach i neb'aa', ruum la' chi aj jileq'. Eh ruum chi ruuk' i reh wilik i koxtaal molb'al tumiin, i relq'aaj ruuk' i tumiin inkimol chupaam. <verse number="7" style="v" />Re' i Jesús je' wili xuq'or:</para>
  <para style="p">Chakanaa' chi je' re'. Re' ixoq wili xub'uch' i wooq paniq'oom, yejemb'al reh i nuti'jolal reh i numuhqiik. <verse number="8" style="v" />Re' taqe neb'aa' juneliik naa kiwihiik taq chaxilak, eh re' hin, ma' juneliik ta naa nuwihiik taq chaxilak, inki Jesús.</para>
  <para style="s">Xkaaj naq kikansam i Lázaro</para>
  <para style="p">
    <verse number="9" style="v" />Eh ma' k'isiin i aj judío xkib'iraj rib'iral chi re' Jesús wilik pan tinamit Betania, eh xiooj ar chi rilariik. Eh ma' xata chi rilariik i Jesús xiooj chi rilariik la' wo' hoq i Lázaro, re' i ruksam wo' chik chaloq i Jesús chi k'achlik wach. <verse number="10" style="v" />Eh re' taqe i kajaaw i k'amal kib'eeh aj tiij xkaaj naq kikansam i Lázaro, <verse number="11" style="v" />ruum ruuk' i ruwuktiik chaloq i reh chi k'achlik wach, ma' k'isiin i kuch aj judío xi elik chi nimanik chi kixilak, re' chik i Jesús xkinimaj.</para>
  <para style="s">Re' noq xokik i Jesús pan tinamit Jerusaleem</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21.1-11</ref>; <ref loc="MRK 11:1-11">Mar 11.1-11</ref>; <ref loc="LUK 19:28-40">Luc 19.28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" />Eh chi junwaar, ma' k'isiin i tinamit xiooj chi rikteesjiik i runinq'ijiik elik chaloq Egipto noq xkib'iraj chi ponik i rub'an i Jesús Jerusaleem. <verse number="13" style="v" />Kiyohq'eem kixaq ipak', noq xi elik cho chi kulariik i Jesús k'ereer kichii' chuq'orariik chi je' wili:</para>
  <para style="p">Ye'aroq runimaal wach i xk'u'loq parub'ihnaal i QaJaaw Dios re' i naa rukahniik chi qa Reey i hoj, hoj aj Israel, inki taqe.</para>
  <para style="p">
    <verse number="14" style="v" />Eh re' Jesús ihqamaj ruum i jinaj k'isa b'uurux noq xooj k'oloq ar. Ruuk' i re' xooj eloq wach i tz'ihb'amaj chupaam i santo laj huuj chi je' wili:</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Matyo'jik taq i hat, aj pan tinamit Sión</para>
  <para style="q">Chawilow taq aaReey,</para>
  <para style="q">ihqamaj ruum jinaj i k'isa b'uurux noq xk'u'loq, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" />Eh noq xb'aan taqe re', re' taqe raj tahqaneel i Jesús ma' xkireq ta pee chi riij. Eh noq xye'arik ruloq'il i Jesús, kora'j xk'ulik cho pankik'ux re' chi re' i xuk'ul i Jesús, re' wo' hoq i tz'ihb'amaj cho chi riij pan santo laj huuj. <verse number="17" style="v" />Re' i tinamit i xi ilwik reh noq re' Jesús xruksaj chaloq i Lázaro chi k'achlik wach i muqlik naq wii', xkik'utjaaj i ma' ilooj taj xub'an re' i xkilow. <verse number="18" style="v" />Ruum aj re', re' i tinamit xi elik cho chuk'ulariik i Jesús pamb'eeh, ruum kib'iram chik rib'iral i nim wach i ma' ilooj taj ruk'uhtaam chaloq. <verse number="19" style="v" />Eh re' taqe i aj fariseo je' wili i kiq'or chikiwach:</para>
  <para style="p">Chawilow aj taq re', chu'nchel i tinamit intahqinik reh. Re' hoj xama' xta chik inkih i k'ahchi'kooj, inki taqe.</para>
  <para style="s">Wilik taqe i aj griego xisik'wik reh i Jesús</para>
  <para style="p">
    <verse number="20" style="v" />Eh chi kixilak i tinamit xiooj Jerusaleem chi loq'inik chupaam i runinq'ijiik i elik chaloq Egipto, wilik taqe ju'jun i aj griego. <verse number="21" style="v" />Eh xkijil i koq kiib' ruuk' i Felipe, aj Betsaida wilik ar i Galilea je' wili i xkiq'or reh:</para>
  <para style="p">Jaaw, cha kuy cha k'uhtaaj tii qeh i Jesús inqaaj qanab'eem wach, inki taqe.</para>
  <para style="p">
    <verse number="22" style="v" />Eh re' i Felipe, xooj ruq'or reh i Andres, eh kikab'cheel xooj kiq'or reh i Jesús i xq'orarik reh. <verse number="23" style="v" />Eh re' Jesús je' wili i xuq'or keh:</para>
  <para style="p">Yu'naak xponik chik i ru orahiil chi re' hin, Ak'uunb'ees nuwii' winaq, naa ruye'ariik nuloq'il. <verse number="24" style="v" />Re' hin xti korik taq i nuq'or aweh, wila' ma' xq'ahik inaq'wach i trigo noq neen tikarik ma' nee ta ink'ihaaxb'ik. Raaj wila' q'ahik inaq'wach noq neentik neenpoq' i ralaas k'ih chik i neeruwachuj. <verse number="25" style="v" />Awach iraaj ruko'leem riij i ruk'achariik ayu', naa ruq'eb'em i juneliik k'acharik. Eh awach i ma' ruko'leej ta riij i ruk'achariik ayu', naa rehchaam i juneliik k'acharik. <verse number="26" style="v" />Eh awach imb'anik reh i nukamaj kirutahqeej. Eh aha' naa nuwihiik i hin, ar wo' naa ruwihiik i waj kamanoom. Eh re' imb'aniik reh nukamaj naa ruye'ariik ruloq'il ruum i waJaaw, inki Jesús.</para>
  <para style="s">Re' Jesús xuq'or rib'iral i rukimiik</para>
  <para style="p">
    <verse number="27" style="v" />Eh je' wili i xuq'or:</para>
  <para style="p">Yu'naak yohb'aal wach ti'kiil i wánima. ¿Chib'ih i naa nuq'orom? ¿Mi neerub'an chi neenuq'or reh i waJaaw, chi nee kiruko'leej? Ma' chih taj, ruum re' re' xchalik nuk'ul inki. <verse number="28" style="v" />Xa je' la' wili i xuq'or: Jaaw, chayeew i runimaal aaloq'il, inki.</para>
  <para style="p">Eh x-ib'irjik jinaj i q'orik xb'aan cho pan taxaaj chi je' wili: Nuye'em chik runimaal i nuloq'il xa re' la', naa wo' chik nuye'em runimaal i nuloq'il, inki. <verse number="29" style="v" />Eh noq xkib'iraj i re' i tinamit wilkeeb' ar, kahoq ixq'orik chaloq, inki taqe. Eh wilik xiq'orik reh chi je' wili:</para>
  <para style="p">Re' naa ruuk' jino'q i ánjel xq'o'rinik cho reh, inki taqe.</para>
  <para style="p">
    <verse number="30" style="v" />Xrib'iraj chi je' re' i Jesús, je' wili i xuq'or keh:</para>
  <para style="p">Re' q'orik re' re' ma' wuum taj i hin x-ib'irjik awuum la' taq i hat x-ib'irjik. <verse number="31" style="v" />Eh yu'naak i ruq'ijil chi naa ruq'atariik i q'orik chikinaah i tinamit wach ak'al. Eh yu'naak i ru orahiil chi naa rehtesjiik i rajaawriik i aj yahm ayu' wach ak'al. <verse number="32" style="v" />Xa re' la', noq naa nujohteesjiik i hin wach kuruus, chu'nchel i tinamit naa nuk'amam cho wuuk', inki.</para>
  <para style="p">
    <verse number="33" style="v" />Eh ruuk' i xuq'or re' re', xuch'ob' rub'ehel nik' wach i kimik naa ruk'ulum. <verse number="34" style="v" />Re' i tinamit je' wili i xkiq'or:</para>
  <para style="p">Re' k'uhb'aal i ruyeew qeh chi naab'jik chi re' i Cristo naa ruk'achariik chi juneliik. Eh ¿nik' wach noq inaq'or i hat chi re' Ak'uunb'ees ruwii' winaq naa rujohteesjiik wach kuruus? ¿Awach Ak'uunb'ees ruwii' winaq inaq'or? inki taqe.</para>
  <para style="p">
    <verse number="35" style="v" />Re' Jesús je' wili i xuq'or keh:</para>
  <para style="p">Re' taq i hat ko naa ruwihiik taq chaxilak junk'aam-oq i Saqum. Eh tib'ehoq taq chupaam, ruum ko wilik taq chaxilak, reh chi ma' nee ta ink'u'loq taq cha naah chi ma' aweht'al i q'equm ruum awach i panq'equm imb'ehik ma' reht'al taj aha' inooj. <verse number="36" style="v" />Chanimaj taq i Saqum, ruum ko wilik taq chaxilak, reh chi nee taq ti k'acharik pan Saqum, inki Jesús.</para>
  <para style="p">Ruq'orom-oq chik taqe re', xelik reje ar, ma' kota chik xuk'uhtaaj riib' keh.</para>
  <para style="s">Re' taqe i aj judío ma' xkinimaj taj i Jesús</para>
  <para style="p">
    <verse number="37" style="v" />Ma' re' ta nkiwii' chi ma' k'isiin i nimaq kiwach ma' ilooj taj xuk'uhtaaj i Jesús chikiwach i aj judío, xama' xkinimaj ta wo' hoq. <verse number="38" style="v" />Ruum kuuk' i keh xooj eloq wach i rutz'ihb'aam chaloq chi je' wili i Isaías, jalal ruq'oral i Dios:</para>
  <para style="b" />
  <para style="q">Jaaw, ma' awach ta nimanik reh aak'uhb'aal inqaq'or.</para>
  <para style="q">Eh ma' awach taj inye'wik ruloq'il awajaawriik inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="39" style="v" />Re' taqe aj judío ma' xkinimaj taj i Jesús. Ruum kuuk' i keh xooj eloq wach i rutz'ihb'aam chaloq i Isaías chi je' wili:</para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" />Re' Dios xkowb'isanik reh i kinaah, eh xumutz' inaq'kiwach,</para>
  <para style="q">reh chi ma' nee ta inkireq chi riij i korik,</para>
  <para style="q">ni xata neki ilwik,</para>
  <para style="q">reh chi ma' nee ta inkiyot' i kik'ux,</para>
  <para style="q">re' hin ma' nee ta wo' nukuy i kimahk, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="41" style="v" />Re' Isaías je' re' i ruq'orom chaloq, ruum xk'uhtjik cho reh i ruloq'il i Jesús, eh chi riij wo' reh xq'orik chaloq. <verse number="42" style="v" />Atoob' ta ma' xkinimaj taj i Jesús i keh, wilik taqe i ajab'ees xinimanik reh. Xa re' la', ma' nkiq'or ta chuwach i tinamit, ruum kiyo'jik kuum taqe i aj fariseo, re' inkaaj chi ma' xi ehteesjik ta cho chi riij i paat inkiloq'ej wii' i Dios. <verse number="43" style="v" />Re' taqe i aj judío je' re' i xkian, ruum re' q'e' xponik chikiwach chi xye'arik kiloq'il kuum i winaq chuwach i ruloq'il i Dios.</para>
  <para style="s">Re' ruq'oral i Jesús naa ruq'atwiik i q'orik chinaah i tinamit</para>
  <para style="p">
    <verse number="44" style="v" />Re' Jesús kow xuq'or chi je' wili: Awach i nimanik wee hin, ma' xata re' hin kirunimaj i runimaj la' wo' haa' i waJaaw xtaaq'anik cho weh. <verse number="45" style="v" />Eh awach inilwik nuwach i hin, i rilow wo' wach i xtaaq'anik cho weh. <verse number="46" style="v" />Re' hin i Saqum. Xinchalik ayu' wach ak'al, reh chi awach i kinimanik weh, ma' naa ta kikahniik panq'equm. <verse number="47" style="v" />Awach inib'irinik reh i nuq'oral, eh ma' runimaj taj, ma' re' tee hin naa nuq'atwiik i q'orik chinaah, ruum re' hin ma' xin chalik ta wach ak'al chi kiye'ariik pantojb'al mahk i tinamit, xin chalik la' chi kiko'ljiik. <verse number="48" style="v" />Awach i ma' kimponik ta panaq'wach, ma' runimaj taj i nuq'oral, wilik chik awach i naa ruq'atwiik i q'orik chinaah. Re' i naa ruq'atwiik i q'orik chinaah pantz'apaab' taqe poo wach ree q'iij, re' taqe i nuq'oral, <verse number="49" style="v" />ruum re' hin ma' xata panuk'ux inchalik taqe nuq'or re' la' i waJaaw xtaaq'anik cho weh inq'orik weh taqe i nuq'or, taqe i nuk'uhtaaj. <verse number="50" style="v" />Eh re' hin weht'al chi re' i ruq'or weh i waJaaw, juneliik k'acharik i ruk'am chaloq, re' wo' re' i nuq'or i hin, inki Jesús.</para>
  <chapter number="13" style="c" />
  <para style="s">Re' Jesús xutz'aj ruuk' ha' i kooq i raj tahqaneel</para>
  <para style="p">
    <verse number="1" style="v" />Ach-oq i iqal i runinq'ijiik i elik chaloq Egipto, re' Jesús reht'al chik chi xponik i ru orahiil chi nareliik reje ayu' wach ak'al, eh chi naa wo' chik rojiik ruuk' i raJaaw pan taxaaj. Re' Jesús xa ruk'ax wo' taqe pampeet i kinimanik reh wach ak'al, eh xa je' wo' re' kik'axariik xub'an noq xooj kuxoq. <verse number="2" style="v" />Eh noq wi'k inki a'n ree xq'eq re' Judas, i rak'uun i Simón Iscariote, q'orooj chik paránima ruum i aj Yahm chi naa ruq'asam Jesús chi ma' eht'alimaj. <verse number="3" style="v" />Re' Jesús reht'al chi re' Dios xye'wik reh pan q'ab' chu'nchel i xa chib'ih jariik, eh reht'al wo' hoq chi ruuk' i Dios elinaq chaloq, eh chi ar wo' chik naa rojiik wih-oq. <verse number="4" style="v" />Eh noq wi'k inki a'n naah mexa ree xq'eq, re' Jesús xpa'lojik johtoq, xresaj i runim rooq so' xuk'am chaloq jinaj itz'ihy juxb'al oqis, xub'ak' panyejaal. <verse number="5" style="v" />Eh xuyeew i ha' chupaam jinaj i ye'aab' ha', eh xutoq'aa' rutz'ajam i kooq chi kiju'junaal i raj tahqaneel, eh xujux wo' chik i kooq ruuk' itz'ihy rub'ak'am panyejaal. <verse number="6" style="v" />Eh noq xutoq'aa' naq rutz'ajam i koq i rooq i Simón, Pedro i rukab' b'ih je' wili i xuq'or reh i Jesús:</para>
  <para style="p">Jaaw, ¿mi re' naa wo' atz'ajam taqe i wooq i hin? inki.</para>
  <para style="p">
    <verse number="7" style="v" />Re' Jesús je' wili ruchaq'weesjiik xub'an:</para>
  <para style="p">Yu'naak majaa' pee neenareq chi riij i k'ahchi' nub'anam, re' wili koq'uun naa areqem chi riij, i nuchjik.</para>
  <para style="p">
    <verse number="8" style="v" />Re' Pedro je' wili i xuq'or:</para>
  <para style="p">Re' hin ma' jaruuj neenuyeew aweh taqe wooq chi neenatz'aj, inki.</para>
  <para style="p">Re' Jesús je' wili xuq'or:</para>
  <para style="p">Wila' ma' xawaaj chi xnutz'aj aawooq, ma' naa ta awokiik paruman wuuk', inki reh.</para>
  <para style="p">
    <verse number="9" style="v" />Eh re' i Simón Pedro je' wili i xuq'or reh i Jesús:</para>
  <para style="p">Jaaw, wila' je' re', ma' nwaaj ta chi xa re' taqe wooq neenatz'aj inwaaj la' chi neenatz'aj haa' taqe nuq'ab' ruch'ihil i nunaah inki.</para>
  <para style="p">
    <verse number="10" style="v" />Eh re' i Jesús je' wili i xuq'or reh i Pedro:</para>
  <para style="p">Awach i koxub'an ritiin xa re' taqe rooq iraaj tz'ajarik, ruum saq chik wach chu'nchel. Re' taq i hat saq taq chik awach, atoob' ta ma' chawunchelaal ta taq saq awach, inki.</para>
  <para style="p">
    <verse number="11" style="v" />(Re' Jesús xuq'or keh i raj tahqaneel chi ma' chu'nchel ta saq kiwach, ruum reht'al i reh chi kixilak i keh wilik naa ruk'ayiniik reh chi ma' eht'alimaj.)</para>
  <para style="p">
    <verse number="12" style="v" />Eh noq xukohlaaj rutz'ajariik i kooq i raj tahqaneel, xukoj wo' chik i runim rooq so' xooj wo' chik tzuhnoq nah méxa, eh je' wili i xuq'or keh:</para>
  <para style="p">¿Mi nareq aj wo' taq chi riij xnub'an taq aweh? <verse number="13" style="v" />Re' taq i hat Qaj Tijineel QaJaaw tiki taq weh. Rub'ehel taq inaq'or weh chi je' re', ruum hin wo' hoq. <verse number="14" style="v" />Re' hin, ma' re' ta nkiwii' chi hin taq awaj Tijoom eh chi hin taq aaWaJaaw, xnutz'aj la' taq aawooq je' wo' re' inchol taq a'nam i hat, k'ul taq inchol atz'ajam aawooq chawach. <verse number="15" style="v" />Re' hin xnuk'uhtaaj taq chik chawach nik' wach taq i naa a'nam, reh chi nee taq i na a'n awee i hat nik' wach i xnub'an taq awee hat. <verse number="16" style="v" />Re' hin xti korik taq i nuq'or aweh chi ma' jino'q i xa móso q'e' nim wach chuwach i rupatroon, eh ma' awach ta wo' hoq i xa aj taqareel q'e' nim wach chuwach intaaq'anik cho reh. <verse number="17" style="v" />Eh wila' nareq taq chi riij taqe wili, eh xak'am taq naah rub'anariik, suq laj taq i naa awihiik.</para>
  <para style="p">
    <verse number="18" style="v" />Re' hin ma' chawiij ta taq i hat chawunchelaal k'ahchi' nuq'oriik, ruum re' hin weht'al kiwach taqe i nusik'im cho kiwach. Xa re' la' koruman chi naa rojiik eloq wach i ruq'or pan santo laj huuj chi re' i jinaj i rub'an ruwa' wuuk' xsutinik chi ixowan nuwach. <verse number="19" style="v" />Re' taqe wili noq taq k'ahchi' nuq'orom aweh yu'naak, reh chi noq neenk'ularik nee taq inanimaj chi re' hin, i hin aj pan taxaaj. <verse number="20" style="v" />Re' hin xti korik taq i nuq'or aweh chi awach ink'ulwik reh i nutaq'aaj reje i hin, re' wo' hin kiruk'ul ruuk', eh awach ink'ulwik wee hin, i ruk'ul wo' ruuk' awach i xtaaq'anik cho wee hin, inki Jesús.</para>
  <para style="s">Re' Jesús xuq'or chi re' i Judas naa ruk'ayiniik reh</para>
  <para style="r">(<ref loc="MAT 26:20-25">Mat 26.20-25</ref>; <ref loc="MRK 14:17-21">Mar 14.17-21</ref>; <ref loc="LUK 22:21-23">Luc 22.21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" />Eh noq ruq'orom chik taqe re' i Jesús, xchalik ruti'kiil i ránima, eh xti xuq'or i korik keh i raj tahqaneel chi je' wili:</para>
  <para style="p">Re' hin xti korik taq i nuq'or aweh chi jinaj taq i wilik chaxilak i hat naa ruk'ayiniik weh chi ma' eht'alimaj.</para>
  <para style="p">
    <verse number="22" style="v" />Re' taqe i raj tahqaneel k'ul xkitz'ehtaaj panaq'kiwach, ruum ma' keht'al taj awach i ruq'or i Jesús. <verse number="23" style="v" />Eh jinaj keh i raj tahqaneel i Jesús, re' i q'e' ruk'ax, wilik i koq chucheel nah mexa noq wi'k inki a'n ree xq'eq. <verse number="24" style="v" />Eh re' Simón, Pedro i rukab' b'ih, xa ruuk' q'ab' xub'an reje rehtalil reh i raj tahqaneel i Jesús wilik i koq ruuk' chi chupahqaaj reh i Jesús awach i ruq'or. <verse number="25" style="v" />Re' reh xujil i koq riib' ruuk' i Jesús, eh xupahqaaj reh chi je' wili:</para>
  <para style="p">Jaaw, ¿awach aj wo' naa ruk'ayiniik aweh inaq'or? inki.</para>
  <para style="p">
    <verse number="26" style="v" />Re' Jesús je' wili i chaq'wik xub'an:</para>
  <para style="p">Awach pa' aj eh neenuyeew tz'aqik laj kaxlanwi'k re' re' i nuq'or inki.</para>
  <para style="p">Eh xut'aqsaj i kaxlanwi'k, xuyeew reh i Judas, re' rak'uun jinaj i winaq, Simón i b'ih. <verse number="27" style="v" />Eh noq xuk'ul i kaxlanwi'k i Judas, jumehq'iil xokik i aj Yahm paránima. Eh je' wili i xq'orarik reh ruum i Jesús:</para>
  <para style="p">Chib'ih jariik i k'ahchi' akapaam, cha a'n chi jumehq'iil inki.</para>
  <para style="p">
    <verse number="28" style="v" />Eh ma' jino'q keh i wi'k inki a'n nah mexa xkireq chi riij chib'ih reet noq xq'orarik ree Judas chi je' re' ruum i Jesús. <verse number="29" style="v" />Ruum chi ruuk' i Judas wilik i koxtaal ree tumiin, wilik i raj tahqaneel xikapeb'inik reh chi re' Jesús chi xuq'or ree Judas chi naa ruloq'om i chib'ih jariik i naa rukamaniik keh ree ninq'iij. Eh chi naa rusihim chib'ih keh i neb'aa'. <verse number="30" style="v" />Eh noq xuk'ul i kaxlanwi'k i Judas, xelik reje ruuk' i Jesús. Eh chaq'ab' chik xelik reje ar.</para>
  <para style="s">Re' jinaj i ak' k'uhb'aal xuq'or i Jesús</para>
  <para style="p">
    <verse number="31" style="v" />Eh elinaq-oq chik reje ar i Judas, re' Jesús je' wili xuq'or:</para>
  <para style="p">Yu'naak xye'arik chik i nuloq'il i hin, Ak'uunb'ees nuwii' winaq, eh wuum hin xye'arik ruloq'il i Dios. <verse number="32" style="v" />Wila' wuum i hin inye'arik ruloq'il i Dios, naa wo' ruye'em nuloq'il i Dios i hin, Ak'uunb'ees Dios, eh re' wili naa rub'anam chi jumehq'iil. <verse number="33" style="v" />Hat taq kok' wak'uun, re' hin i ach ma' najt taq naa nuwihiik awuuk'. Eh nik' wach i xnuq'or keh i aj Judío je' wo' re' i nuq'or taq aweh i hat, naa naq taq chik kinasik'im ma' naa ta taq chik kiin areqem, ruum ma' naa ta pee taq a'nam i ponik aha' naa wojiik i hin. <verse number="34" style="v" />Re' hin i nuq'or taq aweh i jinaj i ak' k'uhb'aal wili, re' chi k'ul taq cha k'ax awiib' chawach. Nik' wach noq ti nuk'ax taq i hin, je' wo' re' inchol taq a'nam i hat k'ul taq cha k'ax awiib' chawach. <verse number="35" style="v" />Eh wila' k'ul taq xak'ax awiib' chawach, chu'nchel i tinamit naa kikojom rehtaal chi hat taq waj tahqaneel, inki Jesús.</para>
  <para style="s">Re' Pedro naa ruq'orom chi ma' reht'al ta nuwach, inki Jesús</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26.31-35</ref>; <ref loc="MRK 14:27-31">Mar 14.27-31</ref>; <ref loc="LUK 22:31-34">Luc 22.31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" />Eh re' Simón, Pedro i rukab' b'ih, xupahqaaj ree Jesús chi je' wili:</para>
  <para style="p">Jaaw, ¿aha' naa awojiik inaq'or? inki.</para>
  <para style="p">Re' Jesús je' wili xuq'or:</para>
  <para style="p">Re' hat ma' nee ta pee tiooj chi wiij yu'naak aha' naa wojiik wii' i hin koq'uun la' naa awojiik wih-oq wuuk' ar, inki.</para>
  <para style="p">
    <verse number="37" style="v" />Re' i Pedro je' wili i xuq'or ree Jesús:</para>
  <para style="p">Jaaw, ¿chib'ih reet noq ma' nee ta nub'an ojik chawiij yu'naak? Re' hin nuchopom nuk'ux chi neenuyeew wiib' chi kimik chawiij inki.</para>
  <para style="p">
    <verse number="38" style="v" />Re' Jesús je' wili i xuq'or reh:</para>
  <para style="p">Korik re' hat xaq'or chi naa aye'em awiib' pankimik chi wiij. Xa re' la' re' hin xti korik i nuq'or aweh chi chupaam aq'ab' yu'naak noq komajaa' inoq'ik imaas, ox pech naa aq'orom chi ma' aweht'al ta nuwach, inki.</para>
  <chapter number="14" style="c" />
  <para style="s">Re' Jesús xuq'or chi re' reh i b'eeh ink'amwik ruuk' Ajaab'ees Dios</para>
  <para style="p">
    <verse number="1" style="v" />Re' Jesús je' wili xuq'or:</para>
  <para style="p">Maatib'isaj taq awánima. Chanimaj taq i Dios, eh kinanimaj wo' taq i hin. <verse number="2" style="v" />Parupaat i waJaaw ma' k'isiin i ye'aab' wilik. Wi ta ma' je' re', ma' xnuq'or ta naq taq aweh chi naa rojiik nuyejaam jinaj taq aaye'aab'. <verse number="3" style="v" />Eh noq nuyejaam chik taq chaloq aaye'aab', naa wo' chik nuchaliik ruka'peech, naa taq kaat nuk'amam johtoq chi wiij. Reh chi aha' naa nuwihiik hin ar wo' taq naa awihiik i hat. <verse number="4" style="v" />Re' taq i hat aweht'al taq chik aha' kinooj, aweht'al taq i b'eeh, inki Jesús.</para>
  <para style="p">
    <verse number="5" style="v" />Re' Tomas je' wili i xuq'or reh:</para>
  <para style="p">Jaaw, re' hoj ma' qeht'al taj aha' naa awojiik Eh ¿nik' wach noq neenqanab'eej i b'eeh? inki.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' Jesús je' wili i xuq'or reh:</para>
  <para style="p">Re' hin i b'eeh, re' hin i korik, re' hin i k'acharik, xa wuum i hin naa rub'aan ponik ruuk' i waJaaw wilik pan taxaaj. <verse number="7" style="v" />Wila' aweht'al taq nuwach i hin, naa wo' taq anab'eem wach i waJaaw. Eh k'ahchi' wo' taq anab'eem wach yu'naak, ruum xawilow taq chik wach, inki.</para>
  <para style="p">
    <verse number="8" style="v" />Eh re' Felipe je' wili i xuq'or ree Jesús:</para>
  <para style="p">Jaaw, cha k'uhtaaj qeh aaWaJaaw ruuk' i re', neench'iklojik qak'ux, inki.</para>
  <para style="p">
    <verse number="9" style="v" />Eh re' Jesús je' wili xuq'or reh:</para>
  <para style="p">Felipe, re' hin najtir inutoq'aa' wihik taq chaxilak ¿Mi xakomajaa' inanab'eej nuwach re'? Awach inilwik nuwach i hin, i rilow wo' wach i waJaaw. ¿Chib'ih reet noq inapahqaaj weh chi naa nuk'uhtaam taq aweh i waJaaw? <verse number="10" style="v" />¿Mi ma' nanimaj re' hat chi re' hin wilik wuuk' i waJaaw, eh wilkiin wo' ruuk' i reh? Re' taqe i xa chib'ih jariik i nuq'or taq aweh i hat, ma' xata panuk'ux inchalik re' la' i waJaaw wilik wuuk' i rub'an chee rukamaj wuuk'. <verse number="11" style="v" />Re' taq i hat inchol taq animam chi re' hin wilkiin ruuk' i waJaaw, chi re' waJaaw wilik wuuk' i hin. Eh wi ma' xanimaj taq chi je' re', xa re' ta naq taqe i nub'an nee taq inanimaj.</para>
  <para style="p">
    <verse number="12" style="v" />Re' hin xti korik taq i nuq'or aweh chi awach i nimanik weh i hin, nee wo' rub'an i kamanik i nub'an i hin. Eh ma' xata re' re' neerub'an ko ma' k'isiin la' taqe i nimaq wach ma' ilooj taj neerub'an, ruum re' hin naa wo' chik wojiik ruuk' i waJaaw. <verse number="13" style="v" />Eh chu'nchel taq inawaaj apahqaam ree waJaaw panub'ihnaal, re' hin nee taq i nuyeew aweh, reh chi wuum i hin, Ak'uunb'ees Dios neenye'arik ruloq'il i waJaaw. <verse number="14" style="v" />Eh xa chib'ih pa' jariik taq i neenapahqaaj weh, nee taq i nuyeew aweh, inki Jesús.</para>
  <para style="s">Re' Jesús xuq'or chi naa rutaq'aam chaloq i Santolaj Uxlab'al</para>
  <para style="p">
    <verse number="15" style="v" />Wila' korik chi kinak'ax taq chamol taq panawánima i nuk'uhb'aal. <verse number="16" style="v" />Re' hin naa nupahqaam reh i waJaaw chi naa rutaq'aam chaloq jinaj chik i To'ool taq aweh, reh chi naa ruwihiik taq awuuk' chi juneliik, <verse number="17" style="v" />re' i Santolaj Uxlab'al ink'uhtanik reh i korik. Re' taqe i tinamit yiib' wach i kina'ojb'al ma' naa ta kik'ulum kuuk', ruum ma' nkilow ta wach ni xata keht'al wach. Eh re' taq i hat aweht'al taq chik wach, ruum wilik taq chaxilak eh naa ruwihiik taq panawánima chi juneliik.</para>
  <para style="p">
    <verse number="18" style="v" />Re' hin ma' naa ta taq kaat nukanaam chi jumpech naa la' wo' chik nusutiniik chaloq taq awuuk'. <verse number="19" style="v" />Eh re' i tinamit yiib' wach i kina'ojb'al ilook' inkimay rilariik nuwach. Eh re' taq i hat naa wo' chik taq awilom nuwach, naa taq aak'achariik chi juneliik, ruum re' hin naa nuk'achariik chi juneliik. <verse number="20" style="v" />Eh chupaam i q'iij re' re', re' taq i hat naa taq anab'eem chi re' hin wilkiin ruuk' i waJaaw pan jinaj wach k'uxliis, eh chi re' taq i hat wilkaat taq wuuk' i hin, je' wo' hin wilkiin wo' taq awuuk'. <verse number="21" style="v" />Awach i ruk'ul paránima taqe i nuk'uhb'aal, eh i runimaj re' re' korik chi kiruk'ax. Eh naa wo' ruk'axariik ruum i waJaaw awach ink'axwik wee hin. Eh naa wo' nuk'axam i hin, naa wo' nuk'uhtaam wiib' reh, inki.</para>
  <para style="p">
    <verse number="22" style="v" />Eh re' i Judas, ma' re' taj i Iscariote, xupahqaaj ree Jesús chi je' wili:</para>
  <para style="p">Jaaw, ¿chib'ih reet noq xa qeh i hoj naa ak'uhtaam awiib', eh ma' naa ta ak'uhtaam awiib' keh i tinamit? inki.</para>
  <para style="p">
    <verse number="23" style="v" />Re' Jesús je' wili xuq'or reh:</para>
  <para style="p">Awach i kiruk'ax, i rumol paránima i nuk'uhb'aal. Re' re' naa ruk'axariik ruum i waJaaw, eh re' hin, re' i waJaaw naa qachaliik chi patinik paránima. <verse number="24" style="v" />Eh awach i ma' kiruk'ax taj, ma' rumol ta paránima i nuk'uhb'aal. Re' i k'ahchi' nuq'orom taq aweh, ma' xata nuk'uhb'aal i hin chi wib'il wiib' ruk'uhb'aal la' waJaaw i xtaaq'anik cho weh.</para>
  <para style="p">
    <verse number="25" style="v" />Re' hin nuq'or taq aweh chu'nchel i wili, ruum ko wilkiin taq awuuk'. <verse number="26" style="v" />Eh re' i Santolaj Uxlab'al i ye'el rusuqkiil taq ak'ux naa rutaq'aam chaloq panub'ihnaal i waJaaw, naa wo' chik ruk'uhtaam taq aweh chu'nchel i re' reh chi naa ruk'uliik taq panak'ux chu'nchel i nuq'or taq aweh wili.</para>
  <para style="p">
    <verse number="27" style="v" />Re' hin naa taq nukanaam aweh i suq kiil k'uxliis. Naa taq nukanaam aweh i suq kiil k'uxliis, ma' je' ta rukab' i suq kiil k'uxliis i ruyeew i wach ak'al. Maatib'isaj taq ak'ux, mat yo'jik taq. <verse number="28" style="v" />Eh xab'iraj taq chik chi re' hin naa wo' chik wojiik ruuk' i waJaaw, chi naa wo' chik nuchaliik taq awuuk'. Wita korik chi kinak'ax taq, insuuqb'ik naq taq ak'ux noq xab'iraj taq chi naa wo' chik wojiik ruuk' i waJaaw, ruum re' reh q'e' wilik rajaawriik chi nuwach i hin. <verse number="29" style="v" />Re' hin, noq k'ahchi' nuq'orom taq aweh taqe i wili, reh chi naa taq animam na' k'ularoq. <verse number="30" style="v" />Re' hin ach ma' najt taq naa nuq'oriik awuuk', ruum xk'ulik chik iloq intaaq'anik chikinaah i tinamit yiib' wach i kina'ojb'al, ro'q ta ma' xta rajaawriik chi nunaah i hin. <verse number="31" style="v" />Re' taqe re' naa ruk'ulariik reh chi chu'nchel i tinamit naakeht'aliim i chi korik chi nuk'ax i waJaaw, eh chi xa re' wo' nub'an i ruq'or cho weh i reh.</para>
  <para style="p">Yu'naak taq taq, qoh eloq reje ayu' inki Jesús</para>
  <chapter number="15" style="c" />
  <para style="s">Re' Jesús xuq'or chi re' reh i je' ruche'el i xti korik laj uuva</para>
  <para style="p">
    <verse number="1" style="v" />Re' Jesús je' wili xuq'or: Re' hin i je' ruche'el i xti korik laj uuva. Eh re' waJaaw i meswik wach. <verse number="2" style="v" />Eh re' i je' q'ab' i ruche'el i uva ma' kiwachinik taj, re' reh naa ruyok'wiik iloq reh. Eh wila' kiwachinik, i ruyok' taqe iloq i chiqiij chi kixilak, re' raaj i reh chi kiwachiniik chi korik. <verse number="3" style="v" />Re' taq i hat yu'naak saq taq chik wach awánima ruum i nuk'uhb'aal xnuq'or taq aweh. <verse number="4" style="v" />Re' taq i hat tiwih-oq taq wuuk', je' wo' hin nee i kinwihik taq awuuk'. Re' q'ab' i ruche'el i uuva noq ma' ruchopom ta i koq riib' ruuk' i runimaal, ma' nee ta inwachinik. Je' wo' re' taq i hat ma' jaruuj wo' taq nee tiwachinik wila' ma' wilkaat taq wuuk'.</para>
  <para style="p">
    <verse number="5" style="v" />Re' hin i je' ruche'el i uuva, eh re' taq i hat je' taq hat q'ab' noq wilkaat. Awach i wilik wuuk' i hin, wilkiin wo' ruuk' i reh, re' re' ma' k'isiin ta naa ruwachiniik. Eh wila' ma' wilkiin taq awuuk', ma' xta taq i neena a'n rub'aan. <verse number="6" style="v" />Awach i xukanaa' i wihik wuuk' naa rehtesjiik reje wuuk'. Naa ruk'ulum reh i je' rukab' i ruk'ul i q'ab' chee' ma' wachinik taj inyok'arik, inkutarik reje wulu', eh inchiqik inkutarik wach q'aaq'. <verse number="7" style="v" />Wila' re' taq i hat wilkaat taq wuuk', wila' xachop taq ak'ux chub'anariik taqe i nuk'uhtaaj taq aweh, nee taq inye'arik aweh xa chib'ih pa' jariik i nee taq inapahqaaj panatiij. <verse number="8" style="v" />Re' waJaaw inye'arik ruloq'il noq re' taq i hat tiwachinik taq chi korik chi je' re', naa taq akahniik chi hat manlik waj tahqaneel. <verse number="9" style="v" />Re' hin q'e' taq ti nuk'ax i hat, je' rukab' nuk'axariik i rub'an i waJaaw i hin. Eh eliik taq wih-oq awuuk' i k'axooj re' re', je' rukab' taq ak'axariik i nub'an i hin. <verse number="10" style="v" />Je' re' noq, wila' nanimaj taq chi korik taqe i nuk'uhb'aal, ma' naa ta nukanaam taq ak'axariik. Je' rukab' i nub'an i hin, i nunimaj chi korik i ruk'uhb'aal i waJaaw, eh re' reh ma' rukanaam ta nuk'axariik.</para>
  <para style="p">
    <verse number="11" style="v" />Re' hin i nuq'or taq aweh taqe wili, reh chi neen wihik taq awuuk' i suq kiil k'uxliis i nuyeew i hin, eh neemanlojik wach i rusuqkiil taq ak'ux.</para>
  <para style="p">
    <verse number="12" style="v" />Re' wili i nuk'uhb'aal i nuq'or taq aweh: K'ul taq cha k'ax awiib' chawach, je' rukab' taq ak'axariik i nub'an i hin. <verse number="13" style="v" />Re' i k'axaj iib' q'e' nim wach neen wihik ruuk' jino'q, re' chi nee ruyeew riib' chi kimik chikiij taqe i ramigo. <verse number="14" style="v" />Re' taq i hat, nee taq ti kahnik chi hat taq wamigo, wila' xa a'n taq i nuq'or taq aweh i hin. <verse number="15" style="v" />Re' taq i hat, ma' nee ta chik taq tinukoj chi xa hat numoso, ruum re' i xa móso ma' reht'al taj chib'ih i rub'an i rupatroon naa la' taq kaat nukojom chi wamigo, ruum xnuyeew taq chik aweh chi naab'jik chu'nchel i ruq'orom cho weh i waJaaw. <verse number="16" style="v" />Ma' re' ta taq i hat xatsik'wik cho nuwach i hin, re' la' hin xin sik'wik taq chaawach i hat. Eh xat nutaq'aaj taq reje chi naa taq ak'uhtaam chi tiwachinik taq. Reh chi re' waJaaw nee taq i ruyeew chaaweh chib'ih jariik i nee taq inapahqaaj reh panub'ihnaal i hin. <verse number="17" style="v" />Re' taqe wili i nuq'or taq aweh chi k'ul taq naa ak'axam awiib' chawach, inki Jesús.</para>
  <para style="s">Re' i tinamit inkixow wach i Jesús</para>
  <para style="p">
    <verse number="18" style="v" />Re' Jesús je' wili i xuq'or: Wila' xkixowaaj taq awach i hat taqe i tinamit, chanab'eej taq chi peet i hin xkixowaaj nuwach. <verse number="19" style="v" />Eh eliik ta taq wach kuuk' i yiib' wach kina'ojb'al, tikik'ax naq taq. Raaj i wili, re' hin xnusik' taq chaawach chi kixilak i tinamit re' re'. Ruum aj re' inkixowaaj taq awach i hat, ruum ma' eliik ta taq wach ana'ojb'al kuuk' i keh. <verse number="20" style="v" />K'oloq taq panak'ux i nuq'orom taq chaaweh chi ma' jino'q i xa móso neeruq'at wach i rupatroon. Je' re' noq, wila' kianam k'axik wee hin, naa wo' kianam k'axik taq aweh i hat. Eh wila' kinimam i nuk'uhb'aal i hin, naa wo' kinimam i nuk'uhb'aal taq naa aq'orom i hat. <verse number="21" style="v" />Chu'nchel i wili naa taq kianam aweh ruum i nunimjiik, ruum ma' keht'al ta wach awach i xtaaq'anik cho weh i hin.</para>
  <para style="p">
    <verse number="22" style="v" />Re' i tinamit ma' xta naq mahk neenkahnik chikinaah wi ta ma' xin chalik chuq'orariik keh i ko'lemb'al iib'. Eh yu'naak ma' nee ta chik inkuyarik i kimahk ruum xkib'iraj chik. <verse number="23" style="v" />Awach inkixowaaj nuwach i hin, iraaj ruq'orom chi nkixowaaj wo' wach i waJaaw. <verse number="24" style="v" />Eh ma' xta naq i mahk neenkahnik wi ta ma' xnub'an cho chi kixilak i ma' ilooj taj ma' awach ta imb'anik reh. Eh re' keh atoob' ta xkilow wo' naq taqe i xnub'an, xa konkixowaaj wo' nuwach i hin, je' wo' i waJaaw. <verse number="25" style="v" />Eh ruuk' wili k'ahchi' rojiik eloq wach kuuk' i tz'ihb'amaj cho chupaam i k'uhb'aal inkinimaj i keh, re' i ruq'or chi wiij chi je' wili: Naakixowaam wach chi xama' xta rub'ehel, inki.</para>
  <para style="p">
    <verse number="26" style="v" />Eh na' k'oloq i Santolaj Uxlab'al ye'el taq rusuqkiil ak'ux ink'uhtanik reh i korik, to'ool taq aweh, re' i naa nutaq'aam chaloq i hin parub'ihnaal i waJaaw, re' reh naa ruq'oriik i korik chi wiij i hin. <verse number="27" style="v" />Je' wo' taq i hat naa taq aq'orom i korik chi wiij, ruum xanoq wo' pampeet xatoq'aa' taq cho wihik wuuk'.</para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Re' hin i nuq'or taq aweh taqe wili, reh chi ma' nee ta taq inyoj ak'ux chi nunimjiik. <verse number="2" style="v" />Re' taq i hat naa taq kaat kesam chaloq chupaam taqe i paat inlooq'jik wii' i Dios. Eh naa ruponiik i q'iij chi xa awach taq naakikansaniik aweh, naakikapaam chi rukamaj i Dios inki a'n <verse number="3" style="v" />Je' re' i naa kianam, ruum ma' keht'al ta wach i waJaaw, eh ma' keht'al ta wo' nuwach hin. <verse number="4" style="v" />Re' taqe i wili i nuq'or taq aweh, reh chi na' ponoq i junk'aam chi naa taq ak'ulum, naa taq ruk'uliik cho panak'ux chi nuq'orom taq chik aweh.</para>
  <para style="s">Re' i rukamaj i Santolaj Uxlab'al</para>
  <para style="p">Re' taqe wili ma' noq ta xnuq'or taq chaaweh pampeet, ruum xa kosuq pee cho wihik weh taq awuuk'. <verse number="5" style="v" />Eh yu'naak xa ojik chik weh ruuk' awach i xtaaq'anik cho weh ayu' wach ak'al, eh ma' jino'q taq aweh i hat impahqanik weh aha' naa wojiik. <verse number="6" style="v" />Q'e' la' chik inche xtib'ik taq ak'ux noq xnuq'or taq aweh chi naa wo' chik wojiik ruka'peech. <verse number="7" style="v" />Re' hin xti korik taq i nuq'or aweh chi q'e' chihooj taq cha weh chi naa wo' chik wojiik, ruum wila' ma' xinooj, re' i Ye'el taq rusuqkiil ak'ux, i Santolaj Uxlab'al, ma' nee ta nqajik chaloq reh i wihik taq awuuk'. Eh wila' xinooj i hin, naa nutaq'aam taq chaaweh. <verse number="8" style="v" />Eh na' k'oloq i Ye'el taq rusuqkiil ak'ux re' re', naa ruk'uhtaam keh i tinamit nik' wach noq wilik i mahk, nik' wach noq wilik i korik, eh nik' wach noq wilik i q'ataj q'orik naa rub'anam i Dios. <verse number="9" style="v" />Naa wo' ruk'uhtjiik keh nik' wach noq wilik i mahk, ruum ma' kinkinimaj taj i hin. <verse number="10" style="v" />Naa ruk'uhtjiik keh i korik, ruum re' hin naa wo' chik wojiik ruuk' i waJaaw, eh re' taq i hat ma' naa ta pee taq chik awilom nuwach. <verse number="11" style="v" />Naa ruk'uhtjiik keh nik' wach i q'ataj q'orik naa rub'aan, ruum q'atooj chik i q'orik chinaah intaaq'anik chikinaah i tinamit yiib' wach i kina'ojb'al.</para>
  <para style="p">
    <verse number="12" style="v" />Re' hin ko ma' k'isiin naq inwaaj nuq'orom taq aweh xa re' la', ma' nee ta pee taq inareq chi riij chu'nchel yu'naak. <verse number="13" style="v" />Eh na' k'oloq i Santolaj Uxlab'al ink'uhtanik reh i korik, re' reh naa ruk'amwiik taq ab'eeh chureqariik chi riij chu'nchel i korik, ruum re' reh ma' naa ta ruq'oriik xa chi rib'il riib'. Re' la' naa ruq'orom chu'nchel i naa rib'iram chaloq, eh naa wo' ruye'em taq aweh chi naab'jik chib'ih taqe jariik i naa ruk'ulariik na' chub'an. <verse number="14" style="v" />Re' reh naa ruye'wiik nuloq'il i hin, ruum aha' wilik i naa nuq'orom cho ree hin, re' chik i reh naa ruye'wiik taq aweh chi naab'jik i hat. <verse number="15" style="v" />Chu'nchel i wilik reh i waJaaw, wee hin wo' hoq. Ruum aj re' i nuq'or chi re' i Santolaj Uxlab'al, aha' wilik i naa ruk'ulum wuuk' i hin, naa ruye'em taq aweh chi naab'jik i hat, inki Jesús.</para>
  <para style="s">Re' ruti'kiil k'uxliis naa rusutiniik chi rusuqkiil k'uxliis</para>
  <para style="p">
    <verse number="16" style="v" />Re' taq i hat, ilook' taq inamay nuwach. Xa re' la', naa wo' chik taq awilom nuwach, ruum naa wo' chik wojiik ruuk' i waJaaw, inki, i Jesús.</para>
  <para style="p">
    <verse number="17" style="v" />Eh wilik taqe i raj tahqaneel k'ul xkiq'or chikiwach chi je' wili:</para>
  <para style="p">¿Chib'ih iraaj ruq'orom qeh ruuk' i ruq'or re' taq i hat, xailook' taq chik inamay nuwach junk'aam-oq, eh naa wo' chik taq awilom nuwach, eh naa wo' chik wojiik ruuk' i waJaaw, inki qeh?</para>
  <para style="p">
    <verse number="18" style="v" />¿Chib'ih iraaj ruq'orom i ach ilook' i ruq'or?</para>
  <para style="p">Re' hoj ma' nqareq ta chi riij chib'ih chaj-iij k'ahchi' chi q'orik, inki taqe.</para>
  <para style="p">
    <verse number="19" style="v" />Re' QaJaaw Jesús xukoj rehtaal chi wilik naq inkaaj kipahqaam reh, je' wili i xuq'or keh:</para>
  <para style="p">Re' hin nuq'orom taq chik aweh chi xailook' taq chik inamay nuwach junk'aam-oq, eh naa wo' chik taq awilom nuwach. ¿Mi re' taqe re' wili k'ahchi' taq apahqaam chawach i hat? <verse number="20" style="v" />Re' hin xti korik taq i nuq'or aweh chi naa taq awoq'iim ruum i ruti'kiil taq ak'ux. Eh noq naa taq rutib'iik ak'ux i hat, re' taqe i tinamit naa rusuqb'iik kik'ux Re' taq i hat naa taq rutib'iik ak'ux xa re' la', re' taq i ruti'kiil ak'ux naa rusutiniik chi rusuqkiil k'uxliis. <verse number="21" style="v" />Chakoj taq rehtaal, noq re' ixoq ach k'isiin ma' nk'ulik ruk'ux, inqajik kapeew, ruum xponik chik i ora reh i ruti'kiil. Eh noq aasjinaq chik i ruha'lak'uun, insahchik paruk'ux i ruti'kiil ruum i rusuqkiil ruk'ux chi riij i k'isa ruha'lak'uun x-aasjik wach q'iij saqum. <verse number="22" style="v" />Re' taq i hat yu'naak ti' taq ak'ux. Eh re' hin naa wo' chik wilom taq awach, ruum i re' naa rusuqb'iik taq awánima. Re' suq kiil k'uxliis re' re', ma' jino'q taq neenesanik reh panawánima. <verse number="23" style="v" />Eh chupaam taqe q'iij re' re' ma' xta taq chik i naa apahqaam weh. Eh xti korik taq i nuq'or aweh chi re' waJaaw nee ruyeew taq aweh chu'nchel i naa taq apahqaam ree reh panub'ihnaal i hin. <verse number="24" style="v" />Yu'naak komajaa' taq chih inapahqaaj reh panub'ihnaal. Chapahqaaj taq reh, nee taq inak'ul. Chi je' re', nee taq i manlojik wach i rusuqkiil taq ak'ux, inki Jesús.</para>
  <para style="s">Re' i Jesucristo i ruq'at wach i rajaawriik i wach ak'al</para>
  <para style="p">
    <verse number="25" style="v" />Re' taqe wili kopan jalwaach q'orik taq i nuq'or aweh yu'naak. Xa re' la', naa ruponiik i q'iij chi ma' re' ta chik panjalwaach q'orik taq naa kaat nuq'o'reem xti naa la' nuch'ob'om rub'ehel taq aweh nik' wach noq wilik i waJaaw. <verse number="26" style="v" />Eh chupaam taqe q'iij re' re', naa taq apahqaam reh panub'ihnaal ma' ruman ta chik chi re' hin nee kinpahqanik reh i waJaaw, reh chi nee ruyeew taq chaaweh, <verse number="27" style="v" />ruum re' i waJaaw ti ruk'ax taq. Ruum kinak'ax taq i hin, eh ruum chi xanimaj taq chi re' hin ruuk' i Dios xin chalik. <verse number="28" style="v" />Re' hin xinelik cho ruuk' i waJaaw, reh chi xin chalik ayu' wach ak'al. Eh yu'naak naa wo' chik weliik reje ayu', naa wo' chik wojiik ruuk' i waJaaw, inki Jesús.</para>
  <para style="p">
    <verse number="29" style="v" />Eh re' taqe i raj tahqaneel, je' wili xkiq'or:</para>
  <para style="p">Yu'naak kora'j xuch'ob' rub'ehel qeh re' i k'ahchi' aq'orom ma' re' ta chik panjalwaach q'orik xuq'or qeh. <verse number="30" style="v" />Yu'naak i hoj, xqakoj chik rehtaal chi re' hat aweht'al i xa chib'ih jariik, ma' kota ruman chi awach neenpahqanik aweh. Ruum aj re', inqanimaj chi ruuk' i Dios xat chalik, inki taqe.</para>
  <para style="p">
    <verse number="31" style="v" />Re' Jesús je' wili i xuq'or:</para>
  <para style="p">¿Mi xti nanimaj taq re' chi ruuk' i waJaaw xin chalik? <verse number="32" style="v" />Yu'naak xponik chik i ruq'ijil, eh yu'naak naa taq apuhkaam awiib' ruum taq ayo'jiik, naa taq asik'im ab'eeh cha ju'junaal, naa taq kiin akanaam chi wutkeel. Xa re' la', ma' wutkeel ta wo' naa nukahniik, wuch'ihil la' i waJaaw. <verse number="33" style="v" />Re' hin xnuq'or taq aweh taqe i wili, reh chi nee taq ti wihik pansuqkiil k'uxliis wuuk'. Ayu' wach ak'al, naa taq ak'ulum i ti' k'axik. Xa re' la', maayoj taq ak'ux, ruum re' hin nuq'atam chik wach i rajaawriik i wach ak'al wili, inki Jesús.</para>
  <chapter number="17" style="c" />
  <para style="s">Re' Jesús xub'an rutiij chikiij i raj tahqaneel</para>
  <para style="p">
    <verse number="1" style="v" />Ruq'orom-oq chik taqe re' i Jesús, xtz'ehtanik johtoq pan taxaaj, je' wili i xuq'or parutiij:</para>
  <para style="p">WaJaaw, yu'naak xponik chik i q'iij. Chayeew cho nuloq'il i hin, i hin Awak'uun, reh chi nee wo' i nuyeew aloq'il i hat, <verse number="2" style="v" />ruum aye'em wajaawriik chikinaah chu'nchel i tinamit, reh chi naa nuye'em keh i juneliik k'acharik awach taqe i xayeew weh. <verse number="3" style="v" />Re' taqe wili inye'wik i juneliik k'acharik: Re' chi naa kinab'eem awach i hat, chi hat i jinaj chi Dios, korik wach ak'ux, eh chi neenkinab'eej nuwach i hin, chi re' hin i Jesucristo, i xinataq'aaj chaloq.</para>
  <para style="p">
    <verse number="4" style="v" />Re' i hin nuk'uhtaam chik aloq'il ayu' wach ak'al, ruum nukohlaam chik rub'aan i xaq'or cho weh chi naa nub'anam. <verse number="5" style="v" />Yu'naak aj re', waJaaw, inwaaj wo' chik chi nee nayeew weh i nuloq'il ar awuuk', je' rukab' i nuloq'il wilik pampeet noq komajaa' inatz'uhkrisaj chaloq i wach ak'al.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' taqe i xasik' cho kiwach chi kixilak i tinamit i xayeew taqe weh, xnuyeew chik keh chi naab'jik awach i hat. Re' taqe re', aweh naq taqe, eh xayeew taqe weh, yu'naak xkinimaj chik aq'oral. <verse number="7" style="v" />Eh keht'al chik chi chu'nchel i xayeew weh, awuuk' wo' hat inchalik, <verse number="8" style="v" />ruum xnuq'or chik keh aak'uhb'aal aye'em wee hin, re' keh xkinimaj chik. Eh xkikoj wo' chik rehtaal chi re' hin xti korik chi awuuk' kinchalik xkinimaj chi re' hat xat-taaq'anik cho weh.</para>
  <para style="p">
    <verse number="9" style="v" />Re' hin ma' i nupahqaaj ta aweh chi neenatoob'eej taqe i yiib' wach i kina'ojb'al. Chikiij la' taqe i xayeew weh i nupahqaaj otob'il aweh, ruum aweh wo' taqe. <verse number="10" style="v" />Chu'nchel i weh i hin, aweh wo' i hat, eh re' taqe aweh i hat, wee hin wo' hin. Eh re' i nuloq'il, kuuk' i keh ink'utinik.</para>
  <para style="p">
    <verse number="11" style="v" />Re' hin ma' naa ta chik nuwihiik ayu' wach ak'al. Eh re' keh naa kikahniik wach ak'al, re' hin naa wojiik awuuk'. WaJaaw, wilik aSantohiil chacha'jeej taqe ruuk' i awajaawriik taqe aye'em weh, reh chi xa jinaj chik kiwach je' rukab' i hoj awuuk' i hat xa jinaj qawach. <verse number="12" style="v" />Eh nik' najtiil xnub'an kuuk' i hin ayu' wach ak'al taqe aye'em weh, xnucha'jeej taqe ruuk' i runimaal awajaawriik. Ma' awach ta chik jino'q i xq'ehb'ik. Xa re' wo' i jinaj xuq'eb' riib' pampeet, reh chi ruuk' i reh xooj eloq wach i tz'ihb'amaj chaloq pan santo laj huuj.</para>
  <para style="p">
    <verse number="13" style="v" />Eh yu'naak xa ojik chik weh awuuk'. Re' taqe wili nuq'or noq ko wilkiin wach ak'al, reh chi re' taqe i aye'em weh neenkireq chi manlik i suq kiil k'uxliis i nuyeew i hin. <verse number="14" style="v" />Re' hin xnuq'or chik keh aq'oral. Xa re' la' inixowjik kiwach kuum i tinamit, ruum re' keh ma' je' ta kikab' taqe re', eh ni xata re' hin je' nukab' taqe i tinamit re' re'. <verse number="15" style="v" />Ma' k'ahchi' ta nupahqaam aweh chi nee taqe nawesaj wach ak'al. K'ahchi' la' nupahqaam aweh chi chako'leej taqe chuwach i aj Yahm. <verse number="16" style="v" />Re' keh ma' je' ta kikab' i tinamit re' re' eh ni xata re' hin je' nukab' taqe i re'. <verse number="17" style="v" />Chayeew cho kisantohiil ruuk' aq'oral, ruum re' aq'oral korik. <verse number="18" style="v" />Eh nik' wach noq xinataq'aaj chaloq i hin chi taqarik ayu' wach ak'al je' wo' re' noq i nutaq'aaj taqe keh chi taqarik chi kixilak i tinamit. <verse number="19" style="v" />Eh kuum i keh, inusantoheej wiib' i hin, reh chi re' keh neen ki santoheej kiib ruuk' i korik.</para>
  <para style="p">
    <verse number="20" style="v" />Ma' xata chikiij taqe aye'em weh i nupahqaaj awotob'il. Inupahqaaj la' wo' chikiij i naakinimaniik weh koq'uun noq naa kib'iram aq'oral naa kiq'orom i keh. <verse number="21" style="v" />Reh chi, chi kunchelaal nee kiwihik pan jinaj wach k'uxliis, je' rukab' noq wilkaat i hat wuuk' i hin wilkooj pan jinaj wach k'uxliis. Reh chi neenkinimaj i tinamit chi re' hat xataaq'anik cho weh. <verse number="22" style="v" />Re' hin xnuyeew chik keh i loq'il je' rukab' i xayeew weh i hat, reh chi xa jinaj chik wach kik'ux, je' rukab' noq wilkiin i hin awuuk' i hat xa jinaj wach qak'ux. <verse number="23" style="v" />Reh chi neekinwihik i hin kuuk' i keh, eh wilkaat wo' wuuk' i hat, reh chi neenkian jinaj wach kik'ux chi manlik. Reh chi neenkikoj rehtaal i tinamit chi re' hat xataaq'anik cho weh, eh chi q'e' taqe nak'ax i aye'em weh, je' rukab' i nuk'axariik i hin i na a'n.</para>
  <para style="p">
    <verse number="24" style="v" />WaJaaw, re' hat xat ye'wik taqe weh. Ruum aj re', inwaaj i hin chi naa kiwihiik ar aha' naa nuwihiik wii' i hin, reh chi neenkilow wach i nuloq'il, re' i loq'il aye'em weh i hat, ruum re' hat xa kinak'ax wo' chaloq pampeet noq komajaa' inatz'uhkrisaj i wach ak'al. <verse number="25" style="v" />WaJaaw, korik wach ak'ux, re' i tinamit ma' keht'al taa wach. Re' hin ra'j weht'al awach re'. Eh re' taqe i xayeew weh keht'al chik chi re' hat xataaq'anik cho weh ayu' wach ak'al. <verse number="26" style="v" />Eh nuye'em keh chi naab'jik awach i hat. Ma' naa ta nukanaam rub'aan, reh chi neen wihik kuuk' i k'axooj je' rukab' i nuk'axariik i na a'n i hat, reh chi nee kinwihik kuuk' i keh, inki Jesús parutiij.</para>
  <chapter number="18" style="c" />
  <para style="s">Re' i ruchopariik i Jesús</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26.47-56</ref>; <ref loc="MRK 14:43-50">Mar 14.43-50</ref>; <ref loc="LUK 22:47-53">Luc 22.47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Eh noq xukohlaaj i rutiij i Jesús, xelik reje ar ruch'ihil taqe i raj tahqaneel. Xiq'ahxik reje chi juntar i nimlaj rooq ha', Cedrón rub'ihnaal, re' wilik wii' i junseht chi tik chee'. Ar xokik i koq i Jesús ruch'ihil taqe i raj tahqaneel. <verse number="2" style="v" />Eh re' Judas, re' i k'ahchi' ruk'ayiniik reh i Jesús chi ma' eht'alimaj, reht'al i ye'aab' re' re', ruum re' Jesús k'ih pech rumolom kiwach i raj tahqaneel ar. <verse number="3" style="v" />Re' Judas xooj k'oloq ar, ruch'ihil taqe i ruk'ihaal soldado, ruch'ihil taqe i kicha'jinik reh i rupaat i Dios xitaq'ab'jik reje kuum i k'amal kib'eeh aj tiij, kuum i aj fariseo. Wilik taqe i yoq'ooq' kich'ihch', yoq'ooq' kisaqumb'aal, i yoq'ooq' kiq'aaq' ju' taq chee'. <verse number="4" style="v" />Eh re' Jesús reht'al chik chu'nchel chib'ih i naa ruk'ulum. Ruum aj re', xelik chaloq, xupahqaaj keh chi je' wili:</para>
  <para style="p">¿Awach taq inasik'? inki.</para>
  <para style="p">
    <verse number="5" style="v" />Re' keh je' wili i xkiq'or:</para>
  <para style="p">Re' Jesús aj Nazaret inqasik', inki taqe.</para>
  <para style="p">Re' i Jesús je' wili xuq'or: Re' hin ayu' wilkiin, inki.</para>
  <para style="p">Eh re' Judas, i k'ahchi' ruk'ayiniik reh wilik wo' i koq chi kixilak. <verse number="6" style="v" />Eh noq xq'orarik keh ruum i Jesús chi je' wili: Re' hin, inki, xik'awlojik reje wach ak'al. <verse number="7" style="v" />Eh xpahqaljik wo' chik keh ruum i Jesús chi je' wili:</para>
  <para style="p">¿Awach taq inasik'? ki uchjik.</para>
  <para style="p">Re' keh je' wili i xkiq'or:</para>
  <para style="p">Re' i Jesús aj Nazaret inqasik', inki taqe.</para>
  <para style="p">
    <verse number="8" style="v" />Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Re' hin xnuq'or taq chik aweh. Wila' re' i hin taq kinasik', cha kanaa' taq chi nee kiooj taqe i wuch'ihil, inki.</para>
  <para style="p">
    <verse number="9" style="v" />Re' i wili xb'aan, reh chi xooj eloq wach i xuq'or cho parutiij i Jesús chi je' wili: WaJaaw, aha' wilik taqe i xayeew weh, ma' awach ta chik jino'q i xuq'eb' riib', inki. <verse number="10" style="v" />Eh xrilow chi xchoparik i Jesús i Simón Pedro i rukab' b'ih, xuqerej chaloq i ruch'ihch' parupaat, xuyok' i rusak'aaj xikin i jinaj winaq, Malco rub'ihnaal, re' ruuk' taqe i rumoso i kajaaw i k'amal kib'eeh aj tiij. <verse number="11" style="v" />Eh re' i Jesús je' wili i xuq'or ree Pedro:</para>
  <para style="p">Chamol ach'ihch' parupaat. Wila' re' i waJaaw xye' wik q'ab' chi naa nuk'ulum i ti' k'axik wili, re' i je' k'ahlaj ha' i naawuk'em, xanaa wo' nuk'ulum inki.</para>
  <para style="s">Re' Jesús xk'amarik reje chuwach i Anas</para>
  <para style="r">(<ref loc="MAT 26:57-58">Mat 26.57-58</ref>; <ref loc="MRK 14:53-54">Mar 14.53-54</ref>; <ref loc="LUK 22:54">Luc 22.54</ref>)</para>
  <para style="p">
    <verse number="12" style="v" />Eh re' taqe i ruk'ihaal soldado, kuch'ihil i k'amal kib'eeh, kuch'ihil taqe i aj judío kicha'jinik reh i rupaat i Dios, xkichop i Jesús, xkib'ak' wach kab'chel i q'ab'. <verse number="13" style="v" />Eh peet xkik'am reje parupaat i Anas, ruum re' reh rajaaw i rehk'een i Caifas, re' i wilik chi kajaaw taqe i k'amal kib'eeh aj tiij chupaam i haab' re' re'. <verse number="14" style="v" />Re' Caifas re' re', re' wo' xq'orik cho keh i k'amal kib'eeh i aj judío chi ma' xta reet chi xa jinaj chi winaq neenkimik chikiij i tinamit.</para>
  <para style="s">Re' Pedro xuq'or chi ma' reht'al ta wach i Jesús</para>
  <para style="r">(<ref loc="MAT 26:69-70">Mat 26.69-70</ref>; <ref loc="MRK 14:66-68">Mar 14.66-68</ref>; <ref loc="LUK 22:55-57">Luc 22.55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" />Re' i Simón Pedro, ruch'ihil i jinaj chik i ruch aj tahqaneel, xam taqe reje chi riij i Jesús. Re' i raj tahqaneel jinaj chik i Jesús, eht'alimaj wach ar. Ruum i re', xokik i koq haa' chi riij i Jesús i parupaat i kajaaw i k'amal kib'eeh aj tiij. <verse number="16" style="v" />Eh re' Pedro reh ko chi riij i puerta xkahnik. Ruum chi re' i raj tahqaneel i Jesús, eht'alimaj wach ruum i kajaaw taqe i k'amal kib'eeh aj tiij, xuq'or reh ixoq incha'jinik chi chii' puerta chi chukoj i koq i Pedro chi chii' i paat. <verse number="17" style="v" />Eh re' ixoq incha'jinik reh i chi chii' puerta xupahqaaj reh i Pedro chi je' wili:</para>
  <para style="p">¿Mi ma' re' hat i jinaj keh i raj tahqaneel i winaq re' re'? inki.</para>
  <para style="p">Re' Pedro je' wili i xuq'or:</para>
  <para style="p">Ma' chih taj, ma' hin taj, inki.</para>
  <para style="p">
    <verse number="18" style="v" />Eh ruum chi ma' k'isiin i k'uxik, re' taqe i rumoso i kajaaw i k'amal kib'eeh aj tiij, kuch'ihil taqe i kicha'jinik reh i rupaat i QaJaaw Dios kiluk'um kiq'aaq' ar, q'axnik inki a'n i koq. Eh re' Pedro q'axnik wo' i rub'an i koq chi kixilak.</para>
  <para style="s">Re' i kajaaw taqe i k'amal kib'eeh aj tiij xupech'uj i Jesús</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mat 26.59-66</ref>; <ref loc="MRK 14:55-64">Mar 14.55-64</ref>; <ref loc="LUK 22:66-71">Luc 22.66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" />Eh re' i kajaaw i k'amal kib'eeh aj tiij xupahqaaj ree Jesús nik' wach noq wilkeeb' i raj tahqaneel, eh chib'ih jariik i tijinik ruk'uhtaaj keh. <verse number="20" style="v" />Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Re' hin xinq'orik chaloq chikiwach i tinamit. Eh k'ih pech xnub'an tijinik chupaam taqe paat inlooq'jik wii' Dios, je' wo' chupaam i rupaat i Dios, re' inkimol wii' kiib' taqe i aj judío. Eh ma' xtaj i xnuq'or chi q'eeqmaal. <verse number="21" style="v" />Eh ¿chib'ih reet noq wee hin inapahqaaj? Chapahqaaj taq keh i xi ib'irinik cho weh. Re' keh neekiq'orik taq aweh chib'ih jariik nutijem taqe wii', eh keht'al chib'ih jariik i nuq'orom, inki.</para>
  <para style="p">
    <verse number="22" style="v" />Eh noq xuq'or i je' re' i Jesús, jinaj keh incha'jinik reh i rupaat i Dios xsak'wik i koq i panaq'wach i Jesús, je' wili i xuq'or reh:</para>
  <para style="p">¿Chib'ih reet noq je' re' ruchaq'weesjiik i kajaaw k'amal kib'eeh aj tiij xa a'n? inki reh.</para>
  <para style="p">
    <verse number="23" style="v" />Eh je' wili ruchaq'weesjiik xb'aan ruum i Jesús:</para>
  <para style="p">Wila' wilik i ma' holohik taj i nuq'or, cha q'or weh chib'ih jariik. Eh wila' ma' xta reet taqe i nuq'or, ¿chib'ih reet noq kinasak'? inki.</para>
  <para style="p">
    <verse number="24" style="v" />Re' Anas b'ak'lik wach i Jesús noq xutaq'aaj reje ruuk' i Caifas, re' i kajaaw i k'amal kib'eeh aj tiij.</para>
  <para style="s">Re' Pedro xuq'or wo' chik chi ma' reht'al ta wach i Jesús</para>
  <para style="r">(<ref loc="MAT 26:71-75">Mat 26.71-75</ref>; <ref loc="MRK 14:69-72">Mar 14.69-72</ref>; <ref loc="LUK 22:58-62">Luc 22.58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" />Eh re' Pedro xa ko q'axnik wo' rub'an chi q'aaq' xkipahqaaj wo' chik reh chi je' wili:</para>
  <para style="p">¿Mi ma' re' hat i jinaj keh i raj tahqaneel i winaq re' re'? i nuchjik.</para>
  <para style="p">Re' Pedro xuchuk i q'orik, ma' chih taj ma' hin taj, inki.</para>
  <para style="p">
    <verse number="26" style="v" />Eh jinaj keh i rumoso i kajaaw i k'amal kib'eeh aj tiij, re' ma' tokoom ta ruuk' i xyok'arik i xikin ruum i Pedro, xupahqaaj reh i Pedro chi je' wili:</para>
  <para style="p">¿Mi ma' xwilow chaawach re' i hat ruuk' i winaq re' re' noq wilik cho chupaam taqe i tik chee'? inki reh.</para>
  <para style="p">
    <verse number="27" style="v" />Eh re' Pedro xuq'or wo' chik chi ma' reht'al ta wach i Jesús. Eh chupaam i jumehq' re' re' xoq'ik imaas.</para>
  <para style="s">Re' Jesús xq'ahteesjik pan q'ab' i Pilato</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat 27.1-2</ref>,<ref loc="MAT 27:11-31">11-31</ref>; <ref loc="MRK 15:1-20">Mar 15.1-20</ref>; <ref loc="LUK 23:1-5">Luc 23.1-5</ref>,<ref loc="LUK 23:13-25">13-25</ref>)</para>
  <para style="p">
    <verse number="28" style="v" />Eh parusaq'iik xkesaj reje i Jesús parupaat i Caifas, xkik'am reje pan q'atb'al q'orik chuwach Pilato, aj Roma. Re' taqe i aj judío ma' xi okik ta i koq ar. Re' inkaaj i chi ma' xkich'uwa'risaj ta kiib', re' nkaaj chi xkik'ux keh i wi'k ree xq'eq reh i runinq'ijiik i elik chaloq Egipto. <verse number="29" style="v" />Eh re' Pilato xelik cho chi riij i paat chupahqaljiik keh i k'amal kib'eeh i aj judío chi je' wili:</para>
  <para style="p">¿Chib'ih jariik i ru mahk i winaq wili inakoj taq? ki uchjik.</para>
  <para style="p">
    <verse number="30" style="v" />Re' keh je' wili i chaq'wik xkian:</para>
  <para style="p">Wi ta ma' chih ru mahk, ma' xqaq'asaj ta naq panaq'ab', inki taqe.</para>
  <para style="p">
    <verse number="31" style="v" />Eh re' i Pilato je' wili i xuq'or:</para>
  <para style="p">Wila' je' re', chak'am taq reje chaq'at taq i q'orik chinaah i hat je' rukab' i ruq'or i najtir k'uhb'aal, inki.</para>
  <para style="p">Re' keh je' wili i xkiq'or:</para>
  <para style="p">Re' hoj, ma' ye'ooj ta q'ab' qeh chi neenqakansaj jino'q i winaq, inki taqe.</para>
  <para style="p">
    <verse number="32" style="v" />Je' aj re' noq xooj eloq wach i ruq'orom chaloq i Jesús, noq xuch'ob' cho rub'ehel nik' wach noq naa rukanteesjiik.</para>
  <para style="p">
    <verse number="33" style="v" />Eh re' Pilato xokik chik i koq chupaam i paat i rub'an wii' i q'ataj q'orik eh xuyuq'eej i Jesús, xupahqaaj reh chi je' wili:</para>
  <para style="p">¿Mi korik chi re' hat i kireey i aj judío? inki reh.</para>
  <para style="p">
    <verse number="34" style="v" />Eh je' wili xq'orarik reh ruum i Jesús:</para>
  <para style="p">¿Mi xa panak'ux i hat inchalik noq k'ahchi' apahqaam weh, oon wilik k'ahchi' kiq'oriik aweh chi re' i hin? inki.</para>
  <para style="p">
    <verse number="35" style="v" />Re' Pilato je' wili i xuq'or reh i Jesús:</para>
  <para style="p">Hin ta' nchi aj judío i hin. Re' taqe aatinamiit, re' taqe i kajaaw i k'amal kib'eeh aj tiij, xiq'asanik aweh panuq'ab'. Eh xti ¿chib'aaj wo' jariik amahk xa a'n? inki.</para>
  <para style="p">
    <verse number="36" style="v" />Eh re' Jesús je' wili i xuq'or:</para>
  <para style="p">Re' i runimaal i wajaawriik i hin ma' re' ta reh ayu' wach ak'al. Wi ta reh ayu' wach ak'al, re' i tinamit nee naq inki a'n i peleto chi nuko'ljiik, reh chi ma' nee ta naq kinkiq'asaj pan kiq'ab' taqe i k'amal kib'eeh i aj judío, inki.</para>
  <para style="p">
    <verse number="37" style="v" />Eh re' i Pilato xupahqaaj wo' chik reh i Jesús chi je' wili:</para>
  <para style="p">¿Ra'j wo' naa re' hat i kiReey i aj judío? inki.</para>
  <para style="p">Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Korik chi re' hin i Reey je' rukab' i xaq'or. Re' hin xinqajik chaloq, xink'ulik aasjoq ayu' wach ak'al, reh chi naa nuq'orom i korik, eh chu'nchel inki a'n i korik, inkib'iraj i nuq'or, inki.</para>
  <para style="p">
    <verse number="38" style="v" />Eh re' Pilato je' wili i xuq'or reh i Jesús:</para>
  <para style="p">¿Chib'ih jariik i korik inaq'or? inki.</para>
  <para style="p">Eh chi riij i re', re' i Pilato, xelik wo' chik chaloq rij paat chi kiq'orob'jiik taqe i aj judío je' wili i xuq'or keh:</para>
  <para style="p">Re' i winaq xak'am taq cho chi nuwach, ma' xta ru mahk xnureq. <verse number="39" style="v" />Re' taq i hat, hat taq okrinaq chi nwoq'taaj jino'q i prexo rajlaal haab' noq imb'aan i runinq'ijiik i elik chaloq Egipto. Raaj i yu'naak, ¿mi nawaaj taq chi re' i rukoj riib' taq chi aaReey i hat taq aj judío neenwoq'taaj reje? ki uchjik.</para>
  <para style="p">
    <verse number="40" style="v" />Eh chi kunchelaal kow xkiq'or chi je' wili:</para>
  <para style="p">Re' re' ma' nqaaj ta chi neenawoq'taaj. Re' la' i Barrabás chawoq'taaj qeh inki taqe.</para>
  <para style="p">Xanaah re' i Barrabás ruum i leq' wilik pantz'ilom.</para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Eh noq xrib'iraj chi je' re' i Pilato, xutaq'aaj rutz'uhumjiik i Jesús. <verse number="2" style="v" />Re' taqe i soldado xkijitz' jinaj i corona k'iix, xkikoj wach naah i Jesús, eh xkikoj chi riij jinaj itz'ihy q'eqjutik ru kaqiil. <verse number="3" style="v" />Eh je' wili i xkiq'or reh:</para>
  <para style="p">Atoob' reh i kireey i aj judío maje' inki taqe reh.</para>
  <para style="p">Eh k'ih pech xkisak' i koq i panaq'wach.</para>
  <para style="p">
    <verse number="4" style="v" />Re' i Pilato xelik wo' chik cho rij paat je' wili i xuq'or keh i aj judío:</para>
  <para style="p">Chawilow taq re' winaq wili xnuk'am wo' chik taq cho chawach, reh chi nee taq inawil chi ma' xta ru mahk xnureq, inki.</para>
  <para style="p">
    <verse number="5" style="v" />Xelik cho ar i Jesús, wilik chik i k'ix corona wach naah, eh wilik chi riij itz'ihy q'eqjutik ru kaqiil. Eh je' wili i xq'orarik keh ruum i Pilato:</para>
  <para style="p">Re' re' taq chawach i winaq xak'am taq cho weh inki.</para>
  <para style="p">
    <verse number="6" style="v" />Eh noq xkilow wach i Jesús taqe i kajaaw k'amal kib'eeh aj tiij, taqe i kicha'jinik reh i rupaat i Dios, je' wili i xkiq'or:</para>
  <para style="p">Chakoj wach kuruus, Chakoj wach kuruus inki taqe.</para>
  <para style="p">Re' Pilato je' wili i xuq'or:</para>
  <para style="p">Chak'am taq reje, chayeew taq wach kuruus i hat, ruum re' hin ma' xta ru mahk xnureq, inki.</para>
  <para style="p">
    <verse number="7" style="v" />Re' taqe i aj judío je' wili i ruchaq'weesjiik xkian:</para>
  <para style="p">Re' hoj wilik jinaj i k'uhb'aal inqanimaj, i ruq'or chi re' winaq wili i ruk'ul chi naa rukanteesjiik, ruum xukoj riib' chi Rak'uun i Dios, inki.</para>
  <para style="p">
    <verse number="8" style="v" />Noq xrib'iraj chi je' re' i Pilato, xokik ruman i ruyo'jiik. <verse number="9" style="v" />Eh xuk'am wo' chik i koq i Jesús.</para>
  <para style="p">Chupaam i paat intaaq'anik wii' xupahqaaj reh ar chi je' wili:</para>
  <para style="p">¿Aha' aj wo' ti chalik i hat? inki reh.</para>
  <para style="p">Re' Jesús ma' jino'q chi q'orik xchaq'wik. <verse number="10" style="v" />Re' i Pilato je' wili i xuq'or reh i Jesús:</para>
  <para style="p">¿Chib'ih reet noq ma' kinachaq'weej taj? ¿Mi ma' aweht'al re' hat chi wilik wajaawriik reh aakojariik wach kuruus, eh wilik wo' wajaawriik reh awoq'tesjiik reje? inki.</para>
  <para style="p">
    <verse number="11" style="v" />Re' Jesús je' wili ruchaq'weesjiik xub'an:</para>
  <para style="p">Ma' xta naq k'isinoq awajaawriik chi nunaah ma' ta ruye'em cha wajaawriik i Dios. Ruum aj re', awach i xq'asanik weh panaq'ab', xiik' naah i ru mahk i reh chawach i hat, inki.</para>
  <para style="p">
    <verse number="12" style="v" />Eh chupaam i jumehq' re' re', re' Pilato xraaj naq roq'taam i Jesús. Eh re' taqe i aj judío kow xkiq'or chi je' wili:</para>
  <para style="p">Wila' xawoq'taaj reje i winaq re' re', neetikahnik chi ma' hat ta chik ramigo i ajaab'ees aj Roma, ruum awach i rukoj riib' chi reey inkahnik chi raj ixowaal i ajaab'ees aj Roma inki taqe.</para>
  <para style="p">
    <verse number="13" style="v" />Eh noq xrib'iraj chi je' re' i Pilato, xuq'or chi naa rehtesjiik cho ar i Jesús, eh jumehq'iil wo' chik xutzunaa' riib' i reh aha' i rub'an wii' i q'ataj q'orik, Tusuj ab'aj rub'ihnaal, eh pan hebreo Gabata. <verse number="14" style="v" />Eh je' naa kab'lajora i q'iij, noq ach je' ne'eel neenb'aan okik chupaam i runinq'ijiik i elik chaloq Egipto, re' Pilato je' wili i xuq'or keh i aj judío:</para>
  <para style="p">Re' re' taq aareey, inki keh.</para>
  <para style="p">
    <verse number="15" style="v" />Eh re' keh kow xkiq'or chi je' wili:</para>
  <para style="p">Chakansaj la'. Chakoj wach kuruus inki taqe.</para>
  <para style="p">Re' Pilato je' wili i xuq'or keh:</para>
  <para style="p">¿Mi ruk'ul taq cha weh re' chi neenukoj wach kuruus taq aareey? inki.</para>
  <para style="p">Re' keh je' wili i xuq'or:</para>
  <para style="p">Re' hoj ma' xta chik jino'q qareey tokoom, xa re' wo' hoq ajaab'ees aj Roma inki taqe.</para>
  <para style="p">
    <verse number="16" style="v" />Xrib'iraj chi je' re' i Pilato, xuq'asaj pan kiq'ab' i Jesús, reh chi re' naq i keh naakikojwiik wach kuruus. Eh re' keh xkik'am wo' reje i Jesús.</para>
  <para style="s">Re' noq xkojarik wach kuruus i Jesús</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat 27.32-44</ref>; <ref loc="MRK 15:21-32">Mar 15.21-32</ref>; <ref loc="LUK 23:26-43">Luc 23.26-43</ref>)</para>
  <para style="p">
    <verse number="17" style="v" />Eh re' Jesús rutehlaam chik i rukuruus noq xelik reje ar. Xooj chupaam i Ye'aab' ruB'aqil Naah Camnaq rub'ihnaal, (eh Gólgota rub'ihnaal pan hebreo) <verse number="18" style="v" />Eh chupaam i ye'aab' re' re' xkikoj wach kuruus i Jesús. Xkikoj wo' wach kuruus i ki'ib' chi winaq, ju'jun pantaq rucheel. <verse number="19" style="v" />Eh re' i Pilato xutaq'aaj rukojariik jinaj i ehtalil wach kuruus chinaah johtoq i Jesús je' wili i ruq'or i tz'ihb'amaj chuwach: Re' wili Jesús aj Nazaret i kireey i aj Judío, inki. <verse number="20" style="v" />Ma' k'isiin i aj judío xi ilwik wach chib'ih ruq'or i ehtalil re' re', ruum re' ye'aab' xkikoj wii' wach kuruus i Jesús ma' najt ta ruuk' i tinamit wilik. Re' i ehtalil re' re' tz'ihb'amaj pan hebreo, pan griego, pan latin. <verse number="21" style="v" />Xkilow chi je' re' i kajaaw i k'amal kib'eeh aj tiij, xkiq'or reh i Pilato chi je' wili:</para>
  <para style="p">Maatz'ihb'aaj ar chi kireey i aj Judío: Chatz'ihb'aaj la' ar chi rukoj riib' chi kireey i aj Judío, inki taqe.</para>
  <para style="p">
    <verse number="22" style="v" />Eh re' Pilato je' wili i xuq'or:</para>
  <para style="p">Aha' wilik i xnutz'ihb'aaj, xnutz'ihb'aaj chik. Ma' nee ta chik i rub'an chi neenuyoj wach, inki.</para>
  <para style="p">
    <verse number="23" style="v" />Eh noq kikojom chik wach kuruus i Jesús taqe i soldado, xkik'am chaloq i kijib' chi ruso' xkich'aq chikiwach ju'jun keh i xkik'am i soldado. Eh xkik'am wo' chaloq i rub'urb'aal Jesús, ma' xta b'ojb'al reh, xa jinaj rukemariik, xelik cho chi ralaq xponik ko chi rooq, <verse number="24" style="v" />re' taqe i soldado je' wili xkiq'or chikiwach:</para>
  <para style="p">Manqaxih i rub'urb'aal qaq'ijej pee riij awach pa' eh neenkahnik, inki taqe.</para>
  <para style="b" />
  <para style="q">Je' aj re' noq xooj eloq wach i tz'ihb'amaj chaloq pan santo laj huuj chi je' wili:</para>
  <para style="q">Xkich'aq chikiwach i nuso', xkiq'ijej riij i nub'urb'aal, inki.</para>
  <para style="b" />
  <para style="p">Je' re' i xkian taqe i soldado. <verse number="25" style="v" />Eh re' i María i rutuut i Jesús wilik i koq ruuk' i rukuruus. Eh wilik i koq ar ixoq ruchaaq' i rutuut i Jesús. Wilik i koq ar i María, re' i rehk'een i Cleofas. Eh wilik i koq ar i María aj Magdala. <verse number="26" style="v" />Eh noq xrilow i Jesús chi wilik i koq ar i rutuut, eh chi wilik i koq ruuk' i rutuut i raj tahqaneel q'e' ruk'ax, je' wili i xuq'or reh i rutuut:</para>
  <para style="p">Tuut, yu'naak re' re' i naa rukahniik chi awak'uun, inki reh.</para>
  <para style="p">
    <verse number="27" style="v" />Eh jumehq'iil xuq'or reh i raj tahqaneel q'e' ruk'ax chi je' wili:</para>
  <para style="p">Re' re' i naa rukahniik chi atuut, inki reh.</para>
  <para style="p">Re' i raj tahqaneel re' re' chi jumehq'iil xuk'am reje parupaat i rutuut i Jesús.</para>
  <para style="p">
    <verse number="28" style="v" />Eh chi riij i re', ruum chi reht'al chik i Jesús chi chu'nchel xooj eloq wach, eh chi xooj eloq wach i ruq'or i tz'ihb'amaj cho pan santo laj huuj, je' wili xuq'or noq wilik wach kuruus:</para>
  <para style="p">Chiqiij nuchii', inki.</para>
  <para style="p">
    <verse number="29" style="v" />Eh jinaj i nimlaj xaro wilik ar, nujinaq chi ch'amlaj vino. Xkik'am chaloq i jinaj i potz potz paam yoob'en ha', xkimuhaa' chupaam i vino re' re', xkib'ak' chi ju' jinaj i q'ab' chee', xkiyeew johtoq chi chii' i Jesús. <verse number="30" style="v" />Eh noq ruyob'em chik i ch'amlaj vino i Jesús, je' wili xuq'or:</para>
  <para style="p">Yu'naak xooj chik eloq wach chu'nchel, inki.</para>
  <para style="p">Eh chi riij i re', xuq'oyaa' chaloq i naah eh xkimik.</para>
  <para style="s">Jinaj i soldado xhopwik reh chi q'as ju' ch'ihch' i jojol i Jesús</para>
  <para style="p">
    <verse number="31" style="v" />Eh ruum chi ach je' ne'eel neenb'aan okik chupaam i hi'limb'al q'iij re' imb'aan wii' i runinq'ijiik i elik chaloq Egipto. Re' taqe i k'amal kib'eeh i aj judío ma' xkaaj taj chi xi kahnik wach kuruus ixib' re' re', ruum chi looq' keh i hi'limb'al q'iij. Ruum aj re', xkiq'or reh i Pilato chi chutaq'aaj rutoqariik i kituuq wilkeeb' wach kuruus, reh chi naa rehtesjiik cho ar i kiti'jolal. <verse number="32" style="v" />Re' Pilato xutaq'aaj wo' taqe reje i soldado. Re' keh peet xkitoq kab'chel i rutuuq i winaq jinaj chi riij i re', xkitoq wo' chik kab'chel i rutuuq i jinaj, re' taqe i xikojarik wach kuruus pantaq rucheel i Jesús. <verse number="33" style="v" />Eh noq xkijil i koq kiib' ruuk' i Jesús, noq xkilow kamnaq chik. Ruum i re', ma' xkitoq ta chik kab'chel i rutuuq. <verse number="34" style="v" />Ma' re' ta nkiwii' chi kamnaq chik i Jesús, jinaj la' i soldado xhopwik reh i panjojol ruuk' q'as ju' ch'ihch'. Eh jumehq'iil xelik chaloq i kik' ruch'ihil ha'. <verse number="35" style="v" />Re' ink'utjanik reh taqe wili, re' i jinaj i xti x-ilwik cho reh, eh xti korik i xuq'or. Eh reht'al chi korik i xuq'or, reh chi nee wo' taq inanimaj i hat. <verse number="36" style="v" />Re' taqe wili xb'aan, reh chi xooj eloq wach i tz'ihb'amaj chaloq pan santo laj huuj, re' i ruq'or chi je' wili: Ma' naa ta kitoqom jino'q i rub'aqil, inki. <verse number="37" style="v" />Eh wilik wo' chik i ruq'or wii' chi je' wili pan santo laj huuj: Re' i xkihopib'eej i ruti'jolal, naakilom i koq i panaq'wach, inki.</para>
  <para style="s">Re' i rumuhqiik i Jesús</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27.57-61</ref>; <ref loc="MRK 15:42-47">Mar 15.42-47</ref>; <ref loc="LUK 23:50-56">Luc 23.50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" />Eh chi riij i re' jinaj i winaq, José rub'ihnaal, aj Arimatea, raj tahqaneel i Jesús xponik rupahqaaj reh i Pilato chi nee ruk'am i ruti'jolal i Jesús, xa re' la' chi q'eeqmaal xub'an, ruum inyo'jik chikiwach i k'amal kib'eeh i aj judío. Re' i Pilato xuyeew wo' q'ab'. Eh re' José xuqasaj wach kuruus i ruti'jolal i Jesús, xuk'am reje. <verse number="39" style="v" />Eh re' i Nicodemo, re' i poninaq cho q'o'rinoq reh i Jesús pan jinaj chaq'ab', xponik wo' haa' i reh. Xuk'am reje i k'isiin ma' jinaj kintaal chi ink'ohnik laj iq'oom mirra, ink'ohnik laj chee' ruyej-aal. <verse number="40" style="v" />Eh re' José ruch'ihil i Nicodemo xkik'am reje i ruti'jolal i Jesús. Xkib'ot reje pan itz'ihy xkimuhaa' chupaam ink'ohnik laj iq'oom re' re', ruum je' re' i okrinaq taqe wii' i aj judío noq inkimuq'aa' i kikamnaaq. <verse number="41" style="v" />Eh aha' xkojarik wii' wach kuruus i Jesús ma' najt ta ar wilik i junseht chi tik chee'. Eh chupaam i tik chee' re' re', ko xk'otarik i koq jinaj i jul muq'umb'al kamnaq komajaa' ta awach imuhqik chupaam. <verse number="42" style="v" />Eh chupaam i jul re' re', xkimuq'aa' i ruti'jolal i Jesús, ruum re' i jul re' re' xama' najt ta ar wilik, ruum chi xa k'isiin chik ma' kiokik chupaam i q'iij kihi'lik wii' i aj judío.</para>
  <chapter number="20" style="c" />
  <para style="s">Re' i ruwuktiik chaloq i Jesús chi k'achlik wach</para>
  <para style="r">(<ref loc="MAT 28:1-10">Mat 28.1-10</ref>; <ref loc="MRK 16:1-8">Mar 16.1-8</ref>; <ref loc="LUK 24:1-12">Luc 24.1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Eh eew-oq chik inik'ik i hi'limb'al q'iij, xti ko q'equm wach ak'al, re' i María aj Magdala xooj aha' xmuhqik wii' i Jesús. Eh noq xponik ar, xrilow chi esamaj chik eloq i ab'aj tz'aplik naq i koq wii' i chii' i jul. <verse number="2" style="v" />Eh xrilow chi je' re', xooj rajimam riib' ruuk' i Simón Pedro i rukab' b'ih, re' i wilik wii' i raj tahqaneel i Jesús q'e' ruk'ax je' wili i xuq'or ponoq keh:</para>
  <para style="p">Xkesaj reje panjul i ruti'jolal i QaJaaw Jesús ma' qeht'al taj aha' xkiyeew, inki.</para>
  <para style="p">
    <verse number="3" style="v" />Xrib'iraj chi je' re' i Pedro ruch'ihil i ruch aj tahqaneel jinaj chik, kikab'cheel xiooj chi chii' i jul. <verse number="4" style="v" />Eh kikab'cheel xiooj kajimam kiib' xa re' la', re' jinaj q'e' kow x-ajiminik chuwach i Pedro, peet xponik chi chii' i jul. <verse number="5" style="v" />Xa re' la' ma' xokik ta i koq xa chi chii' i jul xtz'ehtanik i koq. Eh i rilow ach wo' re' itz'ihy b'otlik naq wii' i Jesús wilik ar. <verse number="6" style="v" />Eh chi riij i xponik chi peet, xponik wo' chik i Simón Pedro. Re' reh xokik i koq ko chupaam i jul, eh xa re' wo' taqe itz'ihy xureq ar. <verse number="7" style="v" />Eh xrilow wo' wach itz'ihy xb'ak'arik wii' naah i Jesús noq xmuhqik, b'usuuj wach pareh ye'ooj reje, ma' chi kixilak tee itz'ihy xb'otarik wii' i ruti'jolal i Jesús wilik. <verse number="8" style="v" />Chi riij i re', ko ra'j xokik i koq panjul re' i aj tahqaneel xponik chi peet. Eh noq xrilow chib'ih jariik i xk'ularik, xunimaj chi re' Jesús xwuktik chaloq chi k'achlik wach, <verse number="9" style="v" />ruum re' keh xakomajaa' ta wo' nkireq chi riij i ruq'or pan santo laj huuj chi re' Jesús ajwaal wach chi naa wo' chik rukteesjiik chaloq chi k'achlik wach. <verse number="10" style="v" />Eh xi chalik wo' chik pankipaat i ki'ib' chi raj tahqaneel i Jesús.</para>
  <para style="s">Re' Jesús xuk'uhtaaj wo' chik riib' reh i María aj Magdala</para>
  <para style="r">(<ref loc="MRK 16:9-11">Mar 16.9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" />Eh re' María reh xkahnik kahnoq chi chii' i jul, suq inoq'ik. Eh noq suq inoq'ik, xuk'utzaa' i koq riib' chutz'ehtjiik paam i jul xmuhqik wii' i Jesús. <verse number="12" style="v" />Eh ki'ib' i ánjel saq saq i kiso' xrilow i koq wach, ar tzunulkeeb' aha' naq xmuhqik wii' i Jesús jinaj i wilik i xwihik wii' i naah, eh jinaj i wilik i xwihik wii' i rooq. <verse number="13" style="v" />Re' taqe i ánjel je' wili xkiq'or reh i María:</para>
  <para style="p">Tuut, ¿chib'ih reet noq oq'ik i na a'n? inki taqe.</para>
  <para style="p">Re' hin oq'ik i nub'an, ruum xkik'am i ruti'jolal i waJaaw Jesús, eh ma' weht'al taj aha' xkiyeew, inki.</para>
  <para style="p">
    <verse number="14" style="v" />Eh xa re' wo' xuq'or i re' i María, xusutej wo' chik chee wach, xrilow wilik chik ar i Jesús, xa re' la' ma' xunab'eej ta wach chi re' reh i wilik ar. <verse number="15" style="v" />Re' Jesús je' wili i xuq'or reh:</para>
  <para style="p">Tuut, ¿chib'ih reet oq'ik i na a'n? ¿Awach inasik'? inki.</para>
  <para style="p">Re' María xukapaaj chi re' incha'jinik reh i tik chee' xq'o'rinik reh, je' wili i xuq'or reh:</para>
  <para style="p">Jaaw, wila' re' hat xatk'amwik reh i ruti'jolal i waJaaw Jesús, cha q'or weh aha' xayeew, reh chi neenooj nusik' i hin, inki.</para>
  <para style="p">
    <verse number="16" style="v" />Xrib'iraj i Jesús chi je' re', je' wili i xuq'or reh:</para>
  <para style="p">María inki.</para>
  <para style="p">Re' María xunab'eej wach i Jesús, je' wili i xuq'or reh pan kiq'oral aj hebreo:</para>
  <para style="p">Rabuni inki reh. (Iraaj ruq'orom Aj Tijineel.)</para>
  <para style="p">
    <verse number="17" style="v" />Re' i Jesús je' wili i xuq'or reh i María:</para>
  <para style="p">Chakanaa' pee nutz'a'jiik, ruum re' hin komajaa' chik kinjohtik ruuk' i waJaaw. Hiy la' cha q'or keh i nuchaaq' noq wilkeeb' chi re' hin naa wo' chik wojiik ruuk' i waJaaw eh aaWaJaaw wo' taq i hat, nuDios i hin aaDios wo' taq i hat, inki.</para>
  <para style="p">
    <verse number="18" style="v" />Eh re' i María aj Magdala xooj wo' hoq xponik wo' ruk'utjaaj keh iraaj tahqaneel i Jesús chi xrilow chik wach i QaJaaw Jesús. Eh xuk'utjaaj wo' keh i xq'orarik reh ruum i Jesús.</para>
  <para style="s">Re' Jesús xuk'uhtaaj wo' chik riib' keh i raj tahqaneel</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28.16-20</ref>; <ref loc="MRK 16:14-18">Mar 16.14-18</ref>; <ref loc="LUK 24:36-49">Luc 24.36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" />Eh chupaam i aq'ab' re' re', noq eew chik inik'ik i hi'limb'al q'iij, re' taqe i raj tahqaneel i Jesús xkimol kiib' pan jinaj paat, xkitz'ap taqe ru puertahiil ruum i kiyo'jiik chikiwach i k'amal kib'eeh i aj judío. Re' i Jesús xokik i koq ar xupab'aa' riib' pan kixilak i raj tahqaneel, je' wili xuq'or keh:</para>
  <para style="p">Re' suq kiil k'uxliis wih-oq taq awuuk', inki keh.</para>
  <para style="p">
    <verse number="20" style="v" />Noq ruq'orom chik i je' re' i Jesús, xuk'uhtaaj keh i raj tahqaneel kab'chel i q'ab' je' wo' i panjojol xhoparik. Eh re' keh, ma' k'isiin ta xsuuqb'ik kik'ux noq xkilow wach i Jesús. <verse number="21" style="v" />Eh je' wili i xuq'or keh i raj tahqaneel:</para>
  <para style="p">Re' i suq kiil k'uxliis wih-oq taq awuuk' Eh nik' wach noq xirutaq'aaj cho ayu' i waJaaw i hin, je' wo' chik re' noq tinutaq'aaj taq reje i hat, inki.</para>
  <para style="p">
    <verse number="22" style="v" />Eh re' Jesús xuhupej i ruxlab'al chikinaah, je' wili xuq'or keh:</para>
  <para style="p">Chak'ul taq i Santolaj Uxlab'al. <verse number="23" style="v" />Awach i naa taq akuyum i kimahk i hat, naa wo' rukuyariik i kimahk ruum i Dios. Eh awach i ma' naa ta taq akuyum i kimahk i hat, ma' naa ta wo' rukuyariik i kimahk, inki Jesús.</para>
  <para style="s">Re' Tomas ma' runimaj ta naq chi xk'aach wo' chik chaloq i QaJaaw Jesús</para>
  <para style="p">
    <verse number="24" style="v" />Re' i Tomas, i Laach inkiq'or reh, jinaj keh i kab'laj chi raj tahqaneel i Jesús, ma' xta chi kixilak i raj tahqaneel noq xponik ruk'uhtaaj riib' i Jesús chikiwach. <verse number="25" style="v" />Re' taqe i raj tahqaneel i Jesús junch'uq je' wili i xkiq'or reh i Tomas:</para>
  <para style="p">Re' hoj xqilow wo' chik wach i QaJaaw Jesús, inki taqe.</para>
  <para style="p">Eh re' i Tomas je' wili i xuq'or:</para>
  <para style="p">Wila' ma' xwilow i rehtalil i kalawux chupaam taqe q'ab', wila' ma' xnumin i ju' nuq'ab' paruhopil i kalawux, wila' ma' xnumin i ju' nuq'ab' paruhopil i jojol, ma' jaruuj taq neenunimaj aweh, inki.</para>
  <para style="p">
    <verse number="26" style="v" />Eh paruwahxaaq q'iij xkimol wo' chik kiib' i raj tahqaneel i Jesús chupaam jinaj i paat, re' chik haa' Tomas chi kixilak. Eh xkitz'ap taqe i puerta. Eh re' i QaJaaw Jesús xa chi nawaal xokik i koq ar, xooj rupab'aa' riib' chi kixilak i raj tahqaneel, je' wili xuq'or keh:</para>
  <para style="p">Re' i suq kiil k'uxliis wih-oq taq awuuk' inki.</para>
  <para style="p">
    <verse number="27" style="v" />Eh re' i Jesús je' wili i xuq'or reh i Tomas:</para>
  <para style="p">Chawilow kab'chel i nuq'ab', chamin i ju' aq'ab' paruhopil i kalawux, chamin i ju' aq'ab' chupaam i ruhopil i nujojol. Chanimaj chi xink'aach wo' chik chaloq, hat-oq aj nimaneel, i nuchjik.</para>
  <para style="p">
    <verse number="28" style="v" />Eh xrib'iraj i Tomas chi je' re', je' wili i xuq'or reh i Jesús:</para>
  <para style="p">Hat waJaaw, hat nuDios inki.</para>
  <para style="p">
    <verse number="29" style="v" />Eh je' wili i xq'orarik reh ruum i Jesús:</para>
  <para style="p">Tomas, re' hat ko xawilow nuwach ruum aj re', xanimaj. Atoob' keh i kinkinimaj chi ma' k'ahchi' ta kilom nuwach inki.</para>
  <para style="s">Re' i rub'ehel noq xtz'ihb'jik chaloq paam i huuj wili</para>
  <para style="p">
    <verse number="30" style="v" />Ma' xata re' taqe i ma' ilooj taj wili xub'an i Jesús. Ko ma' k'isiin la' taqe i nimaq wach ma' ilooj taj xuk'uhtaaj chikiwach i raj tahqaneel ma' tz'ihb'amaj ta chupaam i huuj wili. <verse number="31" style="v" />Re' taqe wili tz'ihb'amaj, reh chi nee taq i naanimaj i hat chi re' Jesús re' i Cristo, i Rak'uun i Dios, reh wo' chi wi xanimaj taq, nee taq inareq i juneliik k'acharik, inki Jesús.</para>
  <chapter number="21" style="c" />
  <para style="s">Re' Jesús xuk'uhtaaj riib' keh i wuquub' chi raj tahqaneel</para>
  <para style="p">
    <verse number="1" style="v" />Chi riij taqe re', xuk'uhtaaj wo' chik riib' i Jesús keh i raj tahqaneel chi chii' i k'isa palaw, Tiberias. Eh je' wili noq xuk'uhtaaj riib': <verse number="2" style="v" />Jinaj kimolom wii' kiib' i raj tahqaneel i Jesús, re' i Simón Pedro i rukab' b'ih, re' Tomas i Laach inkiq'or reh re' i Natanael aj Caná wilik ar Galilea re' taqe i kiib' chi rak'uun i Zebedeo, kiib' chik i raj tahqaneel wilkeeb' i koq ar. <verse number="3" style="v" />Eh re' Simón Pedro, je' wili i xuq'or:</para>
  <para style="p">Re' hin naa wojiik aj kar, inki.</para>
  <para style="p">Re' keh je' wili xkiq'or:</para>
  <para style="p">Re' hoj naaqojiik chawiij, inki taqe.</para>
  <para style="p">Eh xijohtik reje pan i jinaj i barco xa re' la', chupaam aq'ab' re' re' ma' jino'q i kar xkesaj.</para>
  <para style="p">
    <verse number="4" style="v" />Eh noq xchalik i rusaq'iik, re' Jesús xooj k'oloq chi chii' i k'isa palaw wilkeeb' wii' i raj tahqaneel xa re' la', re' keh ma' xkinab'eej ta wach chi re' i reh. <verse number="5" style="v" />Re' Jesús xupahqaaj keh chi je' wili:</para>
  <para style="p">Wak'uun, ¿mi xachop taq kiib' ixib'-oq i kar? inki.</para>
  <para style="p">Ma' jino'q i kar axqachop, inki taqe.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' Jesús je' wili i xuq'or keh:</para>
  <para style="p">Chakut taq qohoq aya'l parusak'aaj i barco ar nee taq inachop i kar, inki.</para>
  <para style="p">Re' keh xkikut wo' qohoq i kiya'l, eh ma' nkikuy ta chik cho rehtesjiik i kiya'l ruum i rahliil i ma' k'isa kar. <verse number="7" style="v" />Re' i raj tahqaneel i Jesús, i q'e' i ruk'ax, je' wili i xuq'or reh i Simón Pedro:</para>
  <para style="p">Re' wili re' i QaJaaw Jesús inki.</para>
  <para style="p">Noq xrib'iraj chi je' re' i Simón Pedro, jumehq'iil xukoj ruka'taah i ruso', ruum resam naq chi riij, eh xukut cho riib'panha' reh chi xelik chaloq pan palaw. <verse number="8" style="v" />Eh re' taqe i ruch aj tahqaneel i Pedro junch'uq xi ponik chi chii' i k'isa palaw, chi pan barco wilkeeb'. Re' keh xa kiqerem chik i kiya'l, ruum nujinaq chi kar. Eh xa je' naa jinaj siento b'ara i koq chi chii' i palaw xi elik chaloq.</para>
  <para style="p">
    <verse number="9" style="v" />Eh noq xi k'ulik qajoq pan barco chi chiq yuuq', xkireq ar chi luk'lik i q'aaq', eh jinaj i kar, jinaj i kaxlanwi'k k'ahchi' rub'ahariik chinaah. <verse number="10" style="v" />Je' wili i xq'orarik keh ruum i Jesús:</para>
  <para style="p">Chak'am taq chaloq kiib' ixib'-oq i kar re' ruuk' i kore' taq xawesaj, ki uchjik.</para>
  <para style="p">
    <verse number="11" style="v" />Eh re' i Simón Pedro xjohtik pan barco. Xuqasaj chaloq i ya'l nujinaq chi nimaq taq kar xuqerej reje chi chiq yuuq' jinaj siento ruuk' oxlaj roxk'ahl chi kar i wilkeeb' chupaam. Eh re' ya'l xama' xk'upib'ik ta wo' hoq ruum i rahliil. <verse number="12" style="v" />Eh je' wili i xq'orarik keh ruum i Jesús:</para>
  <para style="p">K'oloq taq a a'n awa' reh awahq'eeq, ki uchjik.</para>
  <para style="p">Re' taqe i raj tahqaneel ma' jino'q keh i xupahqaaj ree reh chi awach i reh, ruum xa keht'al wo' hoq chi re' reh i QaJaaw Jesús. <verse number="13" style="v" />Chalik i Jesús xujil i koq riib' kuuk' i raj tahqaneel. Xuchop chaloq i kaxlanwi'k, xuch'aq keh, eh xuch'aq wo' keh i kar. <verse number="14" style="v" />Ruuk' i wili, oxpech xuk'uhtaaj riib' i Jesús keh i raj tahqaneel noq wuktinaq chik chaloq chi k'achlik wach.</para>
  <para style="s">Re' Jesús xq'orik ruuk' i Simón Pedro i rukab' b'ih</para>
  <para style="p">
    <verse number="15" style="v" />Noq kikohlaam chik kiwa', xupahqaaj i Jesús chi je' wili reh i Simón Pedro:</para>
  <para style="p">Simón, rak'uun i Jonás, ¿mi q'e' kinak'ax chikiwach taqe wili? inki.</para>
  <para style="p">Re' reh je' wili i xuq'or:</para>
  <para style="p">Jaaw, re' hat aweht'al chi q'e' ti nuk'ax, inki.</para>
  <para style="p">Re' i Jesús je' wili i xuq'or:</para>
  <para style="p">Chacha'jeej taqe weh re' i je' taqe nukok' tentzuun, i nuchjik.</para>
  <para style="p">
    <verse number="16" style="v" />Re' Jesús xupahqaaj wo' chik reh i Simón chi je' wili:</para>
  <para style="p">Simón, rak'uun i Jonás, ¿mi q'e' kinak'ax? inki.</para>
  <para style="p">Re' reh je' wili i xuq'or:</para>
  <para style="p">Jaaw, re' hat aweht'al chi q'e' ti nuk'ax, inki.</para>
  <para style="p">Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Chacha'jeej taqe weh re' i je' taqe nutentzuun i nuchjik.</para>
  <para style="p">
    <verse number="17" style="v" />Re' Jesús xupahqaaj roxpeech reh i Simón chi je' wili:</para>
  <para style="p">Simón, rak'uun i Jonás, ¿mi q'e' kinak'ax? inki.</para>
  <para style="p">Re' Pedro tib'ik ruk'ux, ruum roxpeech chik xpahqaljik reh, je' wili xuq'or:</para>
  <para style="p">Jaaw, re' hat aweht'al chu'nchel. Eh aweht'al chi q'e' ti nuk'ax, inki.</para>
  <para style="p">Re' Jesús je' wili i xuq'or:</para>
  <para style="p">Chacha'jeej taqe weh re' i je' taqe nutentzuun, i nuchjik. <verse number="18" style="v" />Re' hin xti korik i nuq'or aweh: Noq ko hat ak'un, inakoj aso' chawiij cha wib'il awiib', eh tiooj xa aha' pa' inawaaj ojik. Eh na' tirijb'oq, naa atehem kab'chel atileb', tokoom chik naa rukojwiik aso' chawiij, eh naa kaat ruk'amam reje aha' ma' naa ta naq awaajwaam ojik i hat, i nuchjik ruum i Jesús.</para>
  <para style="p">
    <verse number="19" style="v" />Eh re' i Jesús ruuk' taqe re', xuch'ob' rub'ehel nik' wach i kimik naa ruk'ulum i Pedro, eh chi ruuk' i rukimiik naa ruye'em ruloq'il i Dios. Eh je' wo' chik wili i xuq'or i Jesús reh i Pedro:</para>
  <para style="p">Taq chi wiij, inki reh.</para>
  <para style="s">Re' i raj tahqaneel i Jesús q'e' ruk'ax</para>
  <para style="p">
    <verse number="20" style="v" />Eh noq xtz'ehtanik reje chi riij i Pedro, xrilow chi xam cho chikiij i raj tahqaneel i Jesús q'e' ruk'ax, re' i xwihik cho chucheel i noq xub'an i tz'apaab' wach wi'k ree xq'eq, re' i xpahqanik reh i Jesús chi je' wili: Jaaw, ¿awach aj wo' naa ruk'ayiniik aweh inaq'or? inki. <verse number="21" style="v" />Eh noq xrilow reje wach i aj tahqaneel re' re' i Pedro, je' wili i xuq'or reh Jesús:</para>
  <para style="p">Jaaw, raaj i wulu', ¿chib'ih i naa rojiik kuxoq wii'? inki.</para>
  <para style="p">
    <verse number="22" style="v" />Re' Jesús je' wili i xuq'or reh i Pedro:</para>
  <para style="p">Wila' nwaaj i hin chi ko k'achlik i reh noq naa wo' chik nuk'uliik ruka'peech, re' hat ma' xta nawaaj reh. Taq la' chi wiij i hat, i nuchjik.</para>
  <para style="p">
    <verse number="23" style="v" />Ruum i re', xelik ruq'orariik chi kixilak i hermano chi re' i raj tahqaneel i Jesús q'e' ruk'ax ma' naa ta rukimiik. Xanaah re' i Jesús ma' xuq'or ta chi ma' naa ta rukimiik, xa je' la' wili i xuq'or: Wila' nwaaj i hin chi ko k'achlik i reh noq naa wo' chik nuk'uliik ruka'peech, re' hat ma' xta nawaaj reh, inki reh.</para>
  <para style="p">
    <verse number="24" style="v" />Re' wo' i aj tahqaneel re' re' i q'e' ruk'ax, xq'orik rukorkiil taqe wili, eh re' wo' reh xtz'ihb'anik reh chupaam i huuj wili. Eh re' reh reht'al chi re' i xti korik xuq'or.</para>
  <para style="p">
    <verse number="25" style="v" />Eh ma' xata re' taqe wili xub'an i Jesús. Ko ma' k'isiin la' i xub'an chi riij taqe i wili nee ta ntz'ihb'jik chi ju'junaal, noq i nukapaaj i hin, ma' nee ta naq i manlojik chu'nchel i wach ak'al chi ye'aab' reh taqe i huuj nee naq intz'ihb'jik wii', je' ta naq re'.</para>
</usx>