<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="1JN" style="id">1JNPOK.SFK 01-06-2,007. ADELINA QUEJ POKOMCHI Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">1 JUAN</para>
  <para style="toc3">1 Juan</para>
  <para style="toc2">1 Juan</para>
  <para style="toc1">1 JUAN</para>
  <para style="mt2">RE' I PEET RUHUUJ I SAN JUAN</para>
  <para style="mt1">1 JUAN</para>
  <chapter number="1" style="c" />
  <para style="s">Re' ruq'oral i Dios inye'wik k'acharik</para>
  <para style="p">
    <verse number="1" style="v" />Chupaam i huuj wili inqach'ob' taq reje rub'ehel aweh i Q'orik inye'wik k'acharik. Re' i xa wilik wo' chaloq noq komajaa' intz'uhreesjiik i wach ak'al. Re' hoj xqanab'eej wach, xqilow wach ruuk' naq'qawach. Xqatz'a'j ruuk' qaq'ab', xqib'iraj i ruQ'oral inye'wik juneliik k'acharik. <verse number="2" style="v" />Re' reh ruuk' naq Ajaab'ees Dios wilik cho pampeet. Raaj i yu'naak, xk'ulik chik ruk'uhtaaj riib' qeh, eh xqanab'eej wach. Re' hoj xa aha' inqaq'or rib'iral, inqaq'or wo' rib'iral taq aweh i hat i juneliik k'acharik wili. <verse number="3" style="v" />Re' hoj inqaq'or rib'iral taq aweh aha' wilik i qilom, qib'iram chaloq reh chi jinaj wach qak'ux taq awuuk', je' rukab' noq wilkooj i hoj pan jinaj wach k'uxliis ruuk' Ajaab'ees Dios je' wo' ruuk' i Rak'uun, re' i Jesucristo. <verse number="4" style="v" />Re' taqe wili inqatz'ihb'aaj taq reje aweh, reh chi neemanlojik wach i rusuqkiil qak'ux taq awuuk'.</para>
  <para style="s">Re' Dios i Saqum</para>
  <para style="p">
    <verse number="5" style="v" />Re' wili i k'uhb'aal xuk'uhtaaj qeh i Jesucristo, eh re' wo' re' inqaq'or rib'iral taq aweh i hat: Chi re' Dios i Saqum, eh ruuk' i reh ma' xta k'isinoq i q'equm.</para>
  <para style="p">
    <verse number="6" style="v" />Eh wila' re' hoj inqaq'or chi wilkooj pan jinaj wach k'uxliis ruuk' i Dios, eh pan q'equm-oq wo' k'acharik inqa a'n, xachukuj q'orik i k'ahchi'kooj, ma' inqak'am ta naah i korik <verse number="7" style="v" />Raaj wila' k'acharik inqa a'n pan saqum je' rukab' i Dios Saqum noq wilik, eh k'ul wilkooj pan jinaj wach k'uxliis chi qawach, re' rukik'eel i Jesucristo, i Ak'uunb'ees Dios, intz'ajwik i loq reh chu'nchel i qamahk.</para>
  <para style="p">
    <verse number="8" style="v" />Eh wila' inqaq'or chi ma' xta k'isinoq qamahk, xa re' hoj k'ahchi' qajot'om qiib', chi je' re' ma' xtaj i korik quuk'. <verse number="9" style="v" />Eh wila' inqapahqaaj kuyb'al qamahk reh i Dios, re' reh korik wach ruk'ux chi rukuyariik i taqe qamahk, eh nee risaj i loq chu'nchel i qayeb'ee wach na'ojb'al wilik pan qánima. <verse number="10" style="v" />Wila' inqaq'or chi ma' xta mahk qa'nam chaloq, k'ahchi' qachukum chii' i Dios, eh xakomajaa' ta wo' inqanimaj i ruq'oral.</para>
  <chapter number="2" style="c" />
  <para style="s">Re' Jesucristo inq'orik i koq chiqiij chuwach Ajaab'ees Dios</para>
  <para style="p">
    <verse number="1" style="v" />Hat taq kok' wak'uun wixq'uun noq wilkaat, inutz'ihb'aaj taq reje aweh wili, reh chi ma' xta taq neetimahkunik wii'. Eh wila' awach taq aweh i xmahkunik, wilik jinaj i nee nq'orik i koq chiqiij chuwach Ajaab'ees Dios, re' Jesucristo, i korik wach ruk'ux. <verse number="2" style="v" />Re' wo' i Jesucristo xuyeew riib' pankimik chi jilow mayiij chutojariik riij taqe i qamahk. Eh ma' xata re' taqe qamahk i hoj, xutoj la' wo' riij taqe kimahk chu'nchel i tinamit wach ak'al.</para>
  <para style="p">
    <verse number="3" style="v" />Je' re' noq, wila' inqanimaj taqe i ruk'uhb'aal i Dios, iraaj ruq'orom chi qeht'al chik wach i reh chi korik. <verse number="4" style="v" />Eh awach inq'orik reh chi reht'al wach i Dios, eh mo'-oq wo' runimaj taqe ruk'uhb'aal, re' re' xachukuj q'orik i rub'an, ma' xtaj i korik ruuk'. <verse number="5" style="v" />Eh awach i nimanik reh i ruq'oral i Dios, korik chi ruk'ax chi manlik. Eh ruum i runimjiik i ruq'oral i Dios, inqanab'eej chi wilkooj pan jinaj wach k'uxliis ruuk'. <verse number="6" style="v" />Eh awach inq'orik reh chi wilik pan jinaj wach k'uxliis ruuk' i Dios, inchol ruk'achariik, je' rukab' noq xk'ulik k'acharoq i Jesucristo.</para>
  <para style="s">Re' ak' k'uhb'aal</para>
  <para style="p">
    <verse number="7" style="v" />Hat taq nuhermano, re' hin ma' ko ta ak' i k'uhb'aal k'ahchi' nutz'ihb'aam taq reje aweh. Xa re' la' wo' k'uhtamaj taq chaaweh pampeet. Eh re' najtir k'uhb'aal wili xa re' wo' i ruq'oral i Dios ab'iram taq chaloq. <verse number="8" style="v" />Xa re' la', re' i k'ahchi' nutz'ihb'aam taq reje aweh, je' naa ko ak' k'uhb'aal, ruum re' wili i xti korik, re' i xk'ulik ruk'uhtaaj i Jesucristo. Eh je' wo' chik re' i naa ak'uhtaam taq i hat, ruum re' q'equm k'ahchi' chik rik'iik, re' chik i manlik saqum k'ahchi' chi sihq'inik.</para>
  <para style="p">
    <verse number="9" style="v" />Awach i ruq'or chi wilik pan saqum, eh ko rixowaaj-oq wach i ras ruchaaq', re' re' xa kopan q'equm wo' wilik. <verse number="10" style="v" />Eh awach i korik chi ruk'ax i ras ruchaaq', pan saqum chik wilik, eh ma' awach ta chik ineeruq'eb' pamahk. <verse number="11" style="v" />Raaj awach i rixowaaj wach i ras ruchaaq', xa kopan q'equm wo' k'acharik i rub'an ma' reht'al taj aha' k'ahchi' rojiik, ruum tz'apooj inaq'wach ruum i q'equm.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Hat taq kok' ak'uunb'ees ixq'uunb'ees inutz'ihb'aaj taq reje aweh i wili,</para>
  <para style="q">ruum re' Dios xukuy taq chik amahk parub'ihnaal i Jesucristo.</para>
  <para style="q">
    <verse number="13" style="v" />Inutz'ihb'aaj taq aweh i wili i hat taq ajaab'ees,</para>
  <para style="q">ruum xanab'eej taq chik wach i xa wilik wo' chaloq pampeet.</para>
  <para style="q">Inutz'ihb'aaj taq reje aweh i wili i hat taq k'ijolaq,</para>
  <para style="q">ruum xaq'at taq chik wach i aj Yahm.</para>
  <para style="q">Inutz'ihb'aaj taq aweh i wili i hat taq kok' ak'un,</para>
  <para style="q">ruum xanab'eej taq chik wach i ajaab'ees Dios.</para>
  <para style="q">
    <verse number="14" style="v" />Inutz'ihb'aaj taq reje aweh i wili i hat taq ajaab'ees,</para>
  <para style="q">ruum xanab'eej taq chik wach i xa wilik wo' chaloq pampeet.</para>
  <para style="q">Inutz'ihb'aaj taq reje aweh i wili i hat taq k'ijolaq,</para>
  <para style="q">ruum kow taq chik ak'ux, eh ak'ulum taq chik i ruq'oral i Dios,</para>
  <para style="q">xaq'at taq chik wach i aj Yahm.</para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" />Maak'ax taq wach i wach ak'al, ni xata re' i yiib' wach na'ojb'al imb'aan wach ak'al. Awach imponik chuwach taqe re', ma' xtaj i ruk'axb'al Ajaab'ees Dios ruuk', <verse number="16" style="v" />ruum chu'nchel i yiib' wach na'ojb'al ma' ruuk' taj i Ajaab'ees Dios inchalik. Re' rotoowjiik i re' ma' re', re' rotoowjiik i ruk'ax wach inaq'qawach, re' niimb'isanik wachiis ruuk' b'ehomal, xa wach ak'al na'ojb'al. <verse number="17" style="v" />Re' i wach ak'al, re' taqe i yiib' wach na'ojb'al imb'aan chupaam naa rusahchiik kiwach. Eh awach imb'anik reh iraaj i Dios, naaruwihiik ruk'achariik chi juneliik.</para>
  <para style="s">Re' korik eh re' chukuj q'orik</para>
  <para style="p">
    <verse number="18" style="v" />Hat taq kok' wak'uun wixq'uun noq wilkaat, yu'naak xa pantz'apaab' chik wach reh taqe q'iij wilkooj. Re' taq i hat ab'iram taq cho rib'iral chi jinaj inaarukojom riib' chi Cristo k'ulik i loq reh. Eh yu'naak, ma' k'isiin chik i wilkeeb' taq chaxilak inkikoj kiib' chi Cristo. <verse number="19" style="v" />Re' taqe re' chi qaxilak wo' elinaq taqe reje, xa re' la' ma' quch aj nimaneel ta wo' taqe chi korik. Wi ta xkiyeew kik'ux chi nimanik, ma' xi elik ta naq chik chi qaxilak. Ruuk' i kina'ojb'al inki a'n ink'utinik chi ma' re' ta quch aj nimaneel taqe.</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' taq i hat, re' Jesucristo xye'wik taq chaaweh i Santolaj Uxlab'al. Ruum i re', chawunchelaal taq i hat aweht'al taq chik i xti korik. <verse number="21" style="v" />Re' hin inutz'ihb'aaj taq reje aweh wili, ma' ruum ta chi ma' aweht'al ta taq i korik, ruum la' chi xaweht'aliij taq chik. Eh aweht'al taq i hat chi re' korik ma' jino'q chukuj q'orik nee nelik reje ruuk'. <verse number="22" style="v" />¿Awach i aj chukul q'orik re' re'? Re' inq'orik reh chi re' Jesús ma' re' taj i Cristo, i q'orooj cho rib'iral chi naruk'uliik, re' aj i re' i rukoj riib' chi Cristo. Ni xata re' Ajaab'ees, ni xata re' Ak'uunb'ees i runimaj. <verse number="23" style="v" />Awach i ma' rukoj taj i Ak'uunb'ees Dios, ma' rukoj taj i Ajaab'ees Dios. Eh awach inq'orik i korik chiriij Ak'uunb'ees Dios, wilik ruuk' i Ajaab'ees Dios.</para>
  <para style="p">
    <verse number="24" style="v" />Ruum aj re', re' taq i hat, inchol taq amolom panawánima i k'uhb'aal ab'iram taq cho pampeet. Wila' xamol taq panawánima i k'uhb'aal re' re', nee taq ti wihik ruuk' i Ak'uunb'ees, je' wo' ruuk' i Ajaab'ees Dios. <verse number="25" style="v" />Eh re' i Jesucristo xanoq wo' ruq'orom cho pampeet chi naa ruye'em qeh i juneliik k'acharik.</para>
  <para style="p">
    <verse number="26" style="v" />Re' hin inutz'ihb'aaj taq reje aweh wili, reh chinee taq inaweht'aliij awach taqe inkaaj taq aajot'ariik. <verse number="27" style="v" />Re' taq i hat wilik taq chik panawánima i Santolaj Uxlab'al, re' i ruye'em taq aweh i Jesucristo. Ruuk' i re', ma' kota chik ruman chi awach neentijinik taq aweh, ruum re' wo' i Santolaj Uxlab'al ink'uhtanik taq aweh i holohik, i korik, ma' re' ta chukuj q'orik. Maacanaa' taq chik i wihik ruuk' i Jesucristo, je' rukab' i xatrutijej taq wii'.</para>
  <para style="p">
    <verse number="28" style="v" />Hat taq kok' wak'uun wixq'uun noq wilkaat, yu'naak maakanaa' taq chik i wihik ruuk' i Jesucristo, reh chi ch'iklik qak'ux taq awuuk' pankomonil na' k'oloq ruka'peech, eh chi ma' naa ta qak'ixiik na' qoh-ohoq pa'lojoq chuwach. <verse number="29" style="v" />Aweht'al taq chik i hat chi re' i Jesucristo xti korik wach ruk'ux. Inchol wo' taq anab'eem chi re' taqe kib'anik reh i korik, aasjinaq taqe ruka'peech ruuk' i Dios.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' taqe i rak'uun rixq'uun i Dios</para>
  <para style="p">
    <verse number="1" style="v" />Chakoj taq rehtaal chi re' i Ajaab'ees Dios ma' k'isiin ta xoj ruk'ax, ruum xojrukoj chi hoj rak'uun rixq'uun. Eh xti korik chi hoj rak'uun rixq'uun, ruum i re', ma' qohponik ta panaq'kiwach i tinamit, eh ni xata re' Ajaab'ees Dios imponik panaq'kiwach. <verse number="2" style="v" />Hat taq nuloq'laj hermano, yu'naak hoj chik rak'uun rixq'uun i Dios. Xa re' la', komajaa' ink'uhtjik qeh nik' wach qawii' na' chub'an. Kore' na' k'oloq ruka'peech i Jesucristo naa qanab'eem chi je' qawii' i reh, ruum naa qilom wach xti nik' wach ruwii' i reh. <verse number="3" style="v" />Eh awach i ch'iklik ruk'ux chi naa rilom wach i Jesucristo, k'ahchi' rusaqb'isam wach i ránima, je' rukab' i reh saq wach i ránima.</para>
  <para style="p">
    <verse number="4" style="v" />Eh awach imb'anik reh i mahk, k'ahchi' ruja'wachem i ruk'uhb'aal i Dios, ruum re' rub'anariik i mahk ruja'wachjiik i k'uhb'aal. <verse number="5" style="v" />Re' taq i hat aweht'al taq chik chi re' Jesucristo xk'ulik wach ak'al chukuyariik taqe qamahk, eh re' reh ma' xta mahk xub'an chaloq. <verse number="6" style="v" />Eh awach i wilik ruuk' i Jesucristo, ma' pamahk ta chik k'acharik i rub'an. Eh awach i k'acharik i rub'an pamahk, ma' runimaj taj i Jesucristo, ni xata reht'al wach. <verse number="7" style="v" />Hat taq kok' wak'uun wixq'uun noq wilkaat, maayeew taq awiib' chi jot'arik: Ruum awach imb'anik reh i korik, korik wo' wach ruk'ux, je' rukab' i Jesucristo korik wach ruk'ux. <verse number="8" style="v" />Eh awach imb'anik reh i mahk, re' aj Yahm inehchanik reh, ruum re' aj Yahm xanoq wo' pampeet xmahkunik chaloq. Ruum i re', xk'ulik i Rak'uun i Dios chusachariik wach i rukamaj i aj Yahm.</para>
  <para style="p">
    <verse number="9" style="v" />Eh awach i aasjinaq ruka'peech ruuk' i Dios ma' nee ta chik i rub'an i mahk, ruum ak' chik i ruk'achariik ye'ooj reh ruum i Dios. Eh re' reh ma' nee ta chik i ruyee riib' chi neerub'an i mahk, ruum aasjinaq chik ruka'peech ruuk' i Dios. <verse number="10" style="v" />Eh ink'utinik wo' hoq awach taqe rak'uun rixq'uun i Dios, eh awach taqe i ehchalimaj ruum i aj yahm: Awach i ma' re' taj i rukorkiil i rub'an, eh ma' ruk'ax taj i ras ruchaaq', ma' re' ta rak'uun rixq'uun i Dios.</para>
  <para style="p">
    <verse number="11" style="v" />Re' k'uhb'aal ab'iram taq cho pampeet i ruq'or qeh chi k'ul naa qak'axam qiib' chi qawach. <verse number="12" style="v" />Ma' naa ta qa'nam qeh je' rukab' i xub'an chaloq i Caín. Re' reh ehchalimaj ruum i aj Yahm ruum aj re', xukansaj i ruchaaq'. ¿Chihreet noq xub'an i je' re'? Je' re' xub'an, ruum yiib' wach i runa'ojb'al, eh re' ruchaaq' holohik i runa'ojb'al.</para>
  <para style="p">
    <verse number="13" style="v" />Hat taq nuhermano, mansahchik taq ak'ux wila' xkixowaaj taq awach i tinamit yiib' wach i kina'ojb'al. <verse number="14" style="v" />Eh wila' inqak'ax taqe i qas qachaaq', re' re' ink'uhtanik reh chi hoj chik elinaq cho pankimik, eh wilik chik qak'achariik chi juneliik. Awach i ma' xtaj i k'axooj ruuk', kopan kimik wilik. <verse number="15" style="v" />Eh awach i rixowaaj wach i ras ruchaaq', aj kansan ras ruchaaq'. Eh re' taq i hat aweht'al taq chik chi ma' jino'q i kansan ras ruchaaq' neen wihik ruk'achariik chi juneliik. <verse number="16" style="v" />Eh re' korik laj k'axooj naaqa'nam i hoj, re' Jesucristo xk'uhtanik qeh noq xuyeew riib' pankimik quum. Je' wo' re' i hoj inchol qaye'em qiib' pankimik chikiij taqe i qahermano. <verse number="17" style="v" />Eh awach i wilik rub'ehomal ayu' wach ak'al, eh i rilow chi ma' xta wilik reh i ras ruchaaq', eh mo'q i runej chib'ih i wilik reh, re' re' ma' xtaj i ruk'axb'al i Dios paránima. <verse number="18" style="v" />Hat taq kok' wak'uun noq wilkaat, re' k'axooj naaqa'nam, ma' xata naqaq'orom rib'iral xti qak'uhtaaj la' chi korik ruuk' chib'ih neen qa a'n chib'ih neenqaq'or.</para>
  <para style="p">
    <verse number="19" style="v" />Ruuk' i k'axooj inqa a'n, inqeht'aliij chi re' Dios, i korik wach ruk'ux, inehchanik qeh. Eh xa ruuk' chik i reh ch'iklik qak'ux. <verse number="20" style="v" />Eh noq inqik'raaj pan qánima chi xqa a'n i mahk, qapahqaaj kuyb'al qamahk ree Dios, ruum re' reh xiik' naah nimaal i rajaawriik chuwach i qánima, eh chu'nchel reht'al. <verse number="21" style="v" />Hat taq nuhermano, wila' inqik'raaj pan qánima chi ma' xta mahk inqa a'n, ch'iklik qak'ux ruuk' i Dios. <verse number="22" style="v" />Eh re' reh nee ruyeew qeh chu'nchel chib'ih jariik i neenqapahqaaj reh, ruum inqanimaj taqe i ruk'uhb'aal, eh ruum wo' chi k'ahchi' qa'nam imponik chuwach i reh. <verse number="23" style="v" />Re' i ruk'uhb'aal i Dios i ruq'or qeh chi naaqanimam i Rak'uun, re' i Jesucristo. Eh i ruq'or wo' qeh chi k'ul naa qak'axam qiib' chi qawach je' rukab' i ruq'orom cho qeh i reh. <verse number="24" style="v" />Re' taqe kinimanik reh taqe i ruk'uhb'aal i Dios, k'acharik inki a'n parub'ihnaal i reh, eh re' wo' Dios wilik kuuk'. Eh re' hoj, xa ruum i Santolaj Uxlab'al ruye'em qeh i Dios, inqanab'eej chi re' reh xa eliik wilik quuk'.</para>
  <chapter number="4" style="c" />
  <para style="s">Re' Ruxlab'al i Dios eh re' ruxlab'al i rukoj riib' chi re' reh i Cristo</para>
  <para style="p">
    <verse number="1" style="v" />Hat taq nuhermano, ma' chu'nchel ta taq naa animam i kiq'orik chi re' i Ruxlab'al i Dios wilik kuuk'. Peet la' taq chawilow mi korik chi Ruxlab'al i Dios wilik kuuk', ruum ma' k'isiin chukul q'orik k'ahchi' kuktiik chaloq, re' tii chik i ruk'uhb'aal i Dios inkiq'or inki a'n kiib'. <verse number="2" style="v" />Ruuk' i wili nee taq inanab'eej awach i wilik i Ruxlab'al i Dios ruuk': Re' inq'orik rukorkiil chi re' Jesucristo xk'ulik chi ruwii' winaq ayu' wach ak'al, re' re' Ruxlab'al i Dios wilik ruuk'. <verse number="3" style="v" />Eh awach inq'orik reh chi re' Jesucristo ma' xk'ulik ta chi ruwii' winaq ayu' wach ak'al, ma' re' taj Ruxlab'al i Dios wilik ruuk', re' la' i ruxlab'al i rukoj riib' chi Cristo wilik ruuk'. Re' taq i hat ab'iram taq chik chi naa ruk'uliik i loq, eh yu'naak wilik chik chi junsuut i wach ak'al.</para>
  <para style="p">
    <verse number="4" style="v" />Hat taq kok' wak'uun noq wilkaat, yu'naak re' chik i Dios inehchanik taq aweh. Eh ma' xta taq xatkuchej taqe inkikoj kiib' chi Cristo re' re', ruum re' inehchanik taq aweh xiik' naah nimaal i rajaawriik chuwach inehchanik keh i tinamit yiib' wach kina'ojb'al. <verse number="5" style="v" />Re' taqe chukul q'orik re' re' yiib' wach i kina'ojb'al. Ruum aj re', xa re' wo' yiib' wach na'ojb'al inkiq'or rib'iral, eh kinimjik wo' kuum i yiib' wach kina'ojb'al. <verse number="6" style="v" />Eh re' hoj, re' chik i Dios inehchanik qeh. Awach ineht'alinik wach i Dios, i runimaj inqaq'or. Eh re' i ma' re' taj i Dios inehchanik reh, ma' runimaj taj inqaq'or. Je' aj re' noq inqanab'eej awach aj uuk' wilik i korik laj Uxlab'al, eh awach aj uuk' wilik i ma' tob'laj uxlab'al aj jot'ool.</para>
  <para style="s">Re' i Dios aj K'axool</para>
  <para style="p">
    <verse number="7" style="v" />Hat taq nuloq'laj hermano, k'ul taq qak'ax qiib' chi qawach, ruum re' k'axooj ruuk' i Dios inchalik. Awach ink'axwik, aasjinaq chik ruka'peech ruuk' i Dios, eh reht'al wach i Dios. <verse number="8" style="v" />Awach i ma' xtaj i k'axooj ruuk' ma' reht'al ta wach i Dios, ruum re' Dios reh aj K'axool. <verse number="9" style="v" />Re' qak'axariik xub'an i Dios ti xk'utinik noq xutaq'aaj cho wach ak'al i jinaj chi Rak'uun. Re' xraaj i reh chi parub'ihnaal i Rak'uun naaruwihiik qak'achariik chi juneliik. <verse number="10" style="v" />Je' wili noq wilik i qak'axariik xub'an i Dios: Ma' re' tee hoj xoj k'axwik reh chi peet. Re' la' reh xk'axwik qeh chi peet, ruum xutaq'aaj chaloq i Rak'uun, reh chi xuyeew riib' chi jilow mayiij reh chi xkuyarik chu'nchel i qamahk.</para>
  <para style="p">
    <verse number="11" style="v" />Hat taq nuloq'laj hermano, wila' je' re' qak'axariik xub'an i Dios, je' wo' chik re' i qa a'n i hoj: k'ul qak'ax qiib' chi qawach. <verse number="12" style="v" />Korik, re' Dios ma' jino'q ilwinaq wach chi jumpech. Xa re' la', wi k'ul inqak'ax qiib' chi qawach, ar ink'utinik chi re' Dios wilik quuk', eh re' qak'axariik xub'an i manlojik wach pan qánima. <verse number="13" style="v" />Re' Dios ruye'em qeh i ruSantolaj Uxlab'al. Ruuk' i re', inqanab'eej chi k'acharik inqa a'n parub'ihnaal i Dios. Inqanab'eej wo' hoq chi re' reh xa eliik wilik quuk'. <verse number="14" style="v" />Re' hoj xqilow wach ruuk' naq'qawach i Ak'uunb'ees Dios. Ruum aj re', inqaq'or rib'iral chi xtaq'ab'jik chaloq ruum i Ajaab'ees Dios chi kiko'ljiik i tinamit wach ak'al. <verse number="15" style="v" />Awach inq'orik rib'iral chi re' Jesucristo Rak'uun i Dios, re' i Dios wilik ruuk' eh re' reh ruuk' wo' Dios wilik. <verse number="16" style="v" />Re' hoj xqareq chik chiriij, eh xqanimaj chi re' Dios q'e' qohruk'ax. Re' Dios aj K'axool. Je' re' noq awach ink'axwik wilik i Dios ruuk', eh re' reh ruuk' wo' Dios wilik. <verse number="17" style="v" />Ruuk' taqe wili i manlojik wach quuk' i xti korik laj k'axooj, reh chi ma' xta naaqayo'jiik wii' na' chureq ruq'ijil i q'ataj q'orik, ruum korik chik wach qak'ux je' rukab' i rukorkiil wach ruk'ux i Jesucristo. <verse number="18" style="v" />Je' re' noq, awach i wilik k'axooj ruuk', ma' xta chik naaruyo'jiik wii', ruum re' i korik laj k'axooj i resaj i yo'jik. Re' yo'jik panti' k'axik ink'amwik. Ruum aj re', awach i konyo'jik, ma' xtaj i korik laj k'axooj ruuk'.</para>
  <para style="p">
    <verse number="19" style="v" />Re' hoj inqak'ax i Dios, ruum re' reh k'axwik qeh chi peet. <verse number="20" style="v" />¿Awach i ruq'or chi ruk'ax i Dios, eh i rixowaaj wach i ras ruchaaq', re' reh xa aj chukul q'orik. Wila' ma' ruk'ax i ras ruchaaq' k'ahchi' rilom wach, nik' wach noq neeruk'ax i Dios ma' k'ahchi' ta rilom wach? <verse number="21" style="v" />Re' Jesucristo je' wili i k'uhb'aal ruq'orom qeh: Awach i korik chi ruk'ax i Dios, inchol wo' ruk'axam i ras ruchaaq', inki.</para>
  <chapter number="5" style="c" />
  <para style="s">Xa ruum i nimanik qoh elik korik</para>
  <para style="p">
    <verse number="1" style="v" />Awach i nimanik reh chi re' i Jesús i Cristo q'orooj cho rib'iral chi naruk'uliik, re' re' aasjinaq ruka'peech ruuk' Dios. Eh awach ink'axwik reh jino'q i ajaab'ees, i ruk'ax wo' taqe rak'uun rixq'uun i ajaab'ees re' re'. <verse number="2" style="v" />Eh noq inqak'ax chik i Dios, eh inqanimaj i ruq'or i ruk'uhb'aal, ruuk' re' inqanab'eej chi k'ahchi' qak'axam taqe i rak'uun rixq'uun i Dios. <verse number="3" style="v" />Re' i ruk'axariik i Dios re' wo' hoq i runimjiik i ruq'or taqe ruk'uhb'aal. Eh re' taqe ruq'or i ruk'uhb'aal ma' k'axik ta runimjiik, <verse number="4" style="v" />ruum re' i aasjinaq chik ruuk' i Dios ma' xta chik nee nuuchjik ruum i mahk ayu' wach ak'al. Eh xa ruum chi nqayeew qak'ux chi nimanik, ma' xta nee qoh ruchej i yiib' wach na'ojb'al. <verse number="5" style="v" />Xa re' wo' hoq i nimanik reh chi re' Jesucristo Rak'uun i Dios, ma' xta nee nuuchjik ruum i yiib' wach na'ojb'al imb'aan wach ak'al.</para>
  <para style="s">Re' ruq'orariik i korik chiriij i Rak'uun i Dios</para>
  <para style="p">
    <verse number="6" style="v" />Re' rehtalil noq xk'ulik i Jesucristo wach ak'al re' ha' noq xqajik ruhaa', eh je' wo' kik' noq xkimik wach kuruus. Ma' xata ha' chi je' wili ruch'ihil la' kik' i ha'. Re' Santolaj Uxlab'al inq'orik i korik chiriij taqe wili, ruum xa re' wo' Santolaj Uxlab'al i korik. <verse number="7" style="v" />Ixib' i wilkeeb' pan taxaaj kiq'orik rub'ehel i wili: Re' Ajaab'ees Dios, re' ruQ'oral i Dios, eh re' i Santolaj Uxlab'al. Eh xa jinaj wach inkiq'or taqe ixib' wili. <verse number="8" style="v" />Eh ixib' wo' hoq i kiq'orik rub'ehel ayu' wach ak'al: Re' Santolaj Uxlab'al, re' ha', eh re' i kik'. Eh xa jinaj wach inkiq'or taqe ixib' wili. <verse number="9" style="v" />Wila' inqanimaj inkiq'or taqe i xa winaq, ra'j naa chik re' i ruq'or rukorkiil i Dios ma' neenqanimaj, ruum re' re' xiik' naah loq'il chuwach inkiq'or taqe i xa winaq ruum re' Dios i ruq'or qeh i korik chiriij i Rak'uun. <verse number="10" style="v" />Eh awach i nimanik reh i Rak'uun i Dios, wilik chik paránima i korik re' re'. Eh awach i ma' runimaj taj i Dios, i rukoj chi chukul q'orik i Dios, ruum ma' runimaj taj i korik i ruq'orom chee reh chiriij i Rak'uun. <verse number="11" style="v" />Re' wili i korik ruq'orom chee Dios: Re' chi ruye'em qeh i juneliik k'acharik, eh re' i juneliik k'acharik wili xa ruuk' i Rak'uun i Dios inkan. <verse number="12" style="v" />Eh awach i ruk'ulum paránima i Rak'uun i Dios, ye'ooj reh i juneliik k'acharik. Raaj i ma' ruk'ulum ta paránima i Rak'uun i Dios, ma' ye'ooj ta reh i juneliik k'acharik.</para>
  <para style="p">
    <verse number="13" style="v" />Re' hin inutz'ihb'aaj taq reje aweh i huuj wili i tinimanik taq reh i Rak'uun i Dios, reh chinee taq inanab'eej chi wilik taq aak'achariik chi juneliik.</para>
  <para style="p">
    <verse number="14" style="v" />Re' hoj ch'iklik qak'ux ruuk' i Dios, ruum chib'ih jariik i neenqapahqaaj reh pan qatiij ruuk' rub'ehel je' rukab' iraaj i reh, qeht'al chi nee qoh rib'iraj. <verse number="15" style="v" />Wila' qeht'al chi rib'iraj i qatiij, qeht'al wo' hoq chi neeruyee qeh aha' wilik i neenqapahqaaj reh.</para>
  <para style="p">
    <verse number="16" style="v" />Eh awach i xrilow i ruch hermano chi xub'an i mahk ma' k'amwik ta pankimik, inchol rub'anam rutiij chiriij, reh chi neenye'arik ruk'achariik ruum i Dios. Xa re' la' wi ma' re' ruuk' i mahk ink'amwik pankimik xub'an. Eh awach imb'anik reh i mahk ink'amwik pankimik, ra'j ma' nee ta nuq'or re' chi neenb'aan tiij chiriij. <verse number="17" style="v" />Chu'nchel i yiib' wach na'ojb'al mahk chi b'anarik, xa re' la' wilik i mahk ma' ink'amwik ta pankimik.</para>
  <para style="p">
    <verse number="18" style="v" />Re' hoj qeht'al chi re' taqe i rak'uun rixq'uun i Dios ma' nkian ta chik i keh i mahk, ruum re' chik i Rak'uun i Dios incha'jinik keh, eh ma' xta chik ki uchjik ruum i ruwinqilal i aj Yahm. <verse number="19" style="v" />Re' hoj qeht'al chi re' i Dios inehchanik qeh. Eh re' i kib'anik reh i mahk sut i wach ak'al, re' i aj Yahm wilik rajaawriik chikinaah. <verse number="20" style="v" />Eh qeht'al wo' chi xk'ulik i Rak'uun i Dios ayu' wach ak'al chuye'ariik qana'ojb'al, reh chi chanab'eej wach i korik laj Dios. Eh wilkooj chik ruuk' i korik laj Dios, ruuk' i Rak'uun, re' i Jesucristo. Re' wili i korik laj Dios, eh re' reh inye'wik i juneliik k'acharik.</para>
  <para style="p">
    <verse number="21" style="v" />Hat taq kok' wak'uun wixq'uun noq wilkaat, maayeew taq chik kajaawriik i xatz'aqoj tiyoox. Je' ta wo' naq re'.</para>
</usx>