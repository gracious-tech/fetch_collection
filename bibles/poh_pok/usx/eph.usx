<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="EPH" style="id">EPHPOK.SFK 18-05-2,007 ADELINA QUEJ POKOMCHI. Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">EFESIOS</para>
  <para style="toc3">Efe</para>
  <para style="toc2">Efe</para>
  <para style="toc1">EFESIOS</para>
  <para style="mt2">RE' I RUHUUJ I EFESIOS</para>
  <para style="mt1">EFESIOS</para>
  <chapter number="1" style="c" />
  <para style="s">Taaq'anik rusuqkiil k'uxliis</para>
  <para style="p">
    <verse number="1" style="v" />Re' hin i Pablo, hin raj tahqaneel i Jesucristo, ruum je' re' i xraaj i Dios wuuk'. Inutz'ihb'aaj reje huuj wili ye'b'al taq rusuqkiil ak'ux taq i hat wilik taq santohiil korik taq wach ak'ux chunimjiik i Jesucristo i wilkaat taq Éfeso. <verse number="2" style="v" />Re' ta naq Ajaab'ees Dios, i QaJaaw Jesucristo neen kiyeew taq cho panawánima i kotob'il, i suq kiil k'uxliis.</para>
  <para style="s">Parub'ihnaal i Jesucristo inqak'ul panuxlab'al i rotob'il i Dios</para>
  <para style="q">
    <verse number="3" style="v" />Hermano, qayeew taq ruloq'il i Dios, re' raJaaw i QaJaaw Jesucristo.</para>
  <para style="q">Ruum re' Dios parub'ihnaal i Jesucristo i ruyeew cho qeh chu'nchel i rotob'il</para>
  <para style="q">panuxlab'al kopan taxaaj.</para>
  <para style="q">
    <verse number="4" style="v" />Re' Dios noq komajaa' i rutz'uhkrisaj i wach ak'al,</para>
  <para style="q">xanoq wo' xusik' cho qawach parub'ihnaal i</para>
  <para style="q">Jesucristo reh chi naa qak'achariik pan santohiil,</para>
  <para style="q">eh chi ma' xta qamahk.</para>
  <para style="q">
    <verse number="5" style="v" />Eh ruuk' ruk'axb'al xraaj chi parub'ihnaal i Jesucristo</para>
  <para style="q">xojrukoj chi hoj rak'uun rixq'uun.</para>
  <para style="q">Re' Dios paruk'ux xchalik chi je' re' otob'il xub'an quuk'.</para>
  <para style="q">
    <verse number="6" style="v" />Reh chi neenqayeew ruloq'il i Dios chi</para>
  <para style="q">eliik ruum i loq'laj rotob'il xub'an quuk'.</para>
  <para style="q">Reh wo' chi xoj ruk'ul ruuk' parub'ihnaal i loq'laj Rak'uun.</para>
  <para style="q">
    <verse number="7" style="v" />Ruuk' i runimaal i ruk'axb'al i Dios,</para>
  <para style="q">xojruko'leej ruuk' i rukik'eel xuchihkaaj i Rak'uun noq xkimik,</para>
  <para style="q">reh chi xukuy chu'nchel i qamahk.</para>
  <para style="q">
    <verse number="8" style="v" />Re' Dios xuyeew qeh chu'nchel i holohik laj na'ojb'al,</para>
  <para style="q">je' wo' hoq i rureqariik chi riij i rub'ehel.</para>
  <para style="q">
    <verse number="9" style="v" />Eh re' Dios xuyeew wo' qeh chi naab'jik i xchalik paruk'ux i reh,</para>
  <para style="q">re' i ma' eht'alimaj ta naq i ruyejaam cho wach i</para>
  <para style="q">chi narojiik eloq wach re' i ruq'orom chaloq najtir.</para>
  <para style="q">
    <verse number="10" style="v" />Eh naa rojiik eloq wach manlik paruq'ijil.</para>
  <para style="q">Re' Dios naa rumolom kiwach i rutz'uhkrisam chaloq,</para>
  <para style="q">chi je' wilkeeb' pan taxaaj</para>
  <para style="q">chi je' wilkeeb' wach ak'al</para>
  <para style="q">naa ruye'em taqe chi ri'sil i rajaawriik i Jesucristo.</para>
  <para style="q">
    <verse number="11" style="v" />Re' i hoj xanoq wo' xusik' cho qawach i Dios,</para>
  <para style="q">chi xoj rukoj chi rak'uun rixq'uun parub'ihnaal i Jesucristo.</para>
  <para style="q">Eh xuyeew qeh i qakooch xuyejaa' cho wach pampeet i Dios,</para>
  <para style="q">re' imb'anik reh chu'nchel i chib'ih jariik, je' rukab' iraaj i reh.</para>
  <para style="q">
    <verse number="12" style="v" />Re' Dios xusik' cho qawach, re' xraaj i reh</para>
  <para style="q">chi peet i hoj xqayeew qak'ux chunimjiik i Jesucristo.</para>
  <para style="q">Eh re' wo' xraaj chi xqak'uhtaaj i runimaal i rotob'il xuyeew cho qeh.</para>
  <para style="q">
    <verse number="13" style="v" />Eh je' wo' re' taq i xa a'n i hat, i ma' hat ta taq aj judío.</para>
  <para style="q">Noq xab'iraj taq i korik, re' i ak' k'uhb'aal</para>
  <para style="q">ko'lb'al taq awiib', xanimaj taq i Jesucristo.</para>
  <para style="q">Eh re' Dios xatrukanaa' taq chi hat rak'uun rixq'uun,</para>
  <para style="q">xukoj taq awehtalil ruuk' i Santolaj Uxlab'al ruq'orom cho rib'iral.</para>
  <para style="q">
    <verse number="14" style="v" />Re' Santolaj Uxlab'al xa raa' ri'sil peet i qakooch naa ruye'em qeh i Dios</para>
  <para style="q">noq naa rumanaam wach i qako'ljiik i hoj rak'uun rixq'uun,</para>
  <para style="q">reh chi naaqaye'em runimaal wach i ruloq'il.</para>
  <para style="s">Re' Pablo xupahqaaj ree Dios chi chuyeew cho kina'ojb'al i aj nimaneel</para>
  <para style="p">
    <verse number="15" style="v" />Ruum i wili hermano, noq xb'iraj taq awib'iral chi aye'em taq ak'ux chunimjiik i QaJaaw Jesucristo, chi nayeew taq ak'ux chi kik'axariik taqe rak'uun rixq'uun i Dios, <verse number="16" style="v" />ma' nukanaa' ta chik rut'iosjiik ree Dios taq chawiij. Eh xa eliik chik taq tik'ulik panuk'ux noq i nub'an nutiij. <verse number="17" style="v" />Re' hin i nupahqaaj panutiij reh i loq'laj Ajaab'ees Dios, i RaJaaw i QaJaaw Jesucristo, chi chuyeew taq ana'ojb'al chupaam taq animaniik, eh chi chuyeew taq ana'ojb'al chureqariik chi riij iraaj i reh. <verse number="18" style="v" />Eh i nupahqaaj ree Dios chi chusaquumb'isaj paam taq akapeb'aal, reh chi nee taq inaweht'aliij chib'ih reet noq xusik' taq chaawach i Dios, chib'ih taq k'ahchi' awuy-eem, eh chi nee taq inaweht'aliij chi ma' k'isiin ta loq'il i kikooch naa ruye'em i santo laj rutinamiit. <verse number="19" style="v" />Eh reh wo' chi nee taq inaweht'aliij chi re' Dios xiik' naah nimaal rajaawriik i ruyeew qeh i hoj i qohnimanik reh. Re' wo' rajaawriik wili xuk'uhtaaj qeh, <verse number="20" style="v" />noq xruksaj wo' chik chaloq i Jesucristo chi k'achlik wach, eh xutzunaa' parusak'aaj q'ab' ar pan taxaaj. <verse number="21" style="v" />Eh re' Jesucristo xuyeew rajaawriik chikinaah chu'nchel i xa reh reh wach kajaawriik chi taaq'anik, chi je' wilkeeb' pan taxaaj, chi je' wilkeeb'wach ak'al. Eh naa wo' ruwihiik rajaawriik chupaam i junch'iht chik chi k'acharik. <verse number="22" style="v" />Eh chu'nchel i xa chib'ih jariik wilik xuq'asaj pan q'ab' i Jesucristo, re' wo' reh xupab'aa' chi k'amal kib'eeh taqe komoon aj nimaneel. <verse number="23" style="v" />Re' taqe jilow rooq q'ab' i Jesucristo, re' kimananik wach i ruloq'il, re' inye'wik reh, ineht'alinik reh chu'nchel chib'ih jariik i wilik.</para>
  <chapter number="2" style="c" />
  <para style="s">Xa ruum i ruk'axb'al i Dios qoh ruko'leej</para>
  <para style="p">
    <verse number="1" style="v" />Re' taq i hat hermano, xuyeew taq aak'achariik i Jesucristo noq hat naq taq cho kamnaq chupaam taq mahk. <verse number="2" style="v" />I na a'n naq taq chaaweh i yiib' wach na'ojb'al wach ak'al. Eh re' naq taq i na a'n imponik chuwach i ma' tob'laj uxlab'al intaaq'anik cho panteew. Re' iminwik keh chub'aan i yiib' wach na'ojb'al i ma' kinimanik ta ree Dios. <verse number="3" style="v" />Chi qunchelaal i hoj, je' wo' naq re' inqa a'n cho najtir. Xa re' naq i ruk'ax wach i qati'jolal inqa a'n. Eh re' naq inqa a'n inqak'ax wach, inqakapaaj i hoj, eh xti ruk'ul wo' naq chi naa ruye'em chi qanaah i rujosq'iil i Dios, eliik naq wach i naa qak'ulum kuuk' i aj mahk. <verse number="4" style="v" />Raaj i Dios reh xiik' naah i rotob'il, xuketelaaj qawach, eh xti q'e' xojruk'ax, <verse number="5" style="v" />Eh noq ko hoj naq cho kamnaq chupaam i qamahk, re' Dios xuyeew qak'achariik je' rukab' i xub'an ruuk' i Jesucristo. Eh je' wo' re' xub'an i Dios taq awuuk' i hat xa ruum i rotob'il xatruko'leej taq. <verse number="6" style="v" />Re' Dios, hoj junwukteesjiik xub'an cho ruuk' i Jesucristo noq xruksaj wo' chik chaloq chi k'achlik wach. Ruuk' i re' xuyeew qa ye'aab' pan taxaaj ruuk' i Jesucristo. <verse number="7" style="v" />Je' wili i xub'an k'uhtb'al reh chupaam i q'iij chalik reh chi xiik' naah i qak'axariik i rub'an. Eh chi xoj ruk'ax ruuk' i qako'ljiik xk'ulik rub'an i Jesucristo. <verse number="8" style="v" />Re' taq i hat, xa ruum chi xanimaj taq i Jesucristo, xatruko'leej taq i Dios ruuk' i runimaal rotob'il. Re' ko'lemb'al iib' wili ma' xata cha wib'il taq awiib' xareq xa ruum la' rotob'il i Dios xusiij taq chaaweh. <verse number="9" style="v" />Eh ma' ruum ta chi wilik ta taq i holohik laj na'ojb'al xa a'n, ruum i re', ma' ruk'ul taj chi awach i nee runimb'isaj riib', <verse number="10" style="v" />ruum re' Dios xyej-anik cho qeh, re' xraaj i reh chi parub'ihnaal i Jesucristo, xuyeew qeh i ak'laj k'acharik. Reh chi naa qa'nam i holohik laj na'ojb'al, je' rukab' i ruyejaam cho wach i reh pampeet.</para>
  <para style="s">Xa ruum i Jesucristo xqak'am qiib' pansuqkiil k'uxliis chi qawach</para>
  <para style="p">
    <verse number="11" style="v" />Re' taq i hat, i ma' hat ta taq aj judío, k'oloq taq panak'ux chi re' taqe aj judío, re' impoch'arik naah i kik'achab' kojb'al kehtalil chi aj judío taqe, re' taq i hat inkiq'or taq aweh chi ma' poch'ooj ta taq naah ak'achab'. <verse number="12" style="v" />Eh noq xub'an chaloq, ma' hat ta naq taq raj nimaneel i Jesucristo. Ma' jinaj ta naq taq awach kuuk' i tinamit Israel. Ma' aweh ta naq taq i ak' k'uhb'aal ruq'orom cho rib'iral i Dios. Ma' xta naq ch'iklik taq reje wii' ak'ux, ma' xta naq taq aaDios. <verse number="13" style="v" />Raaj yu'naak, hat taq chik haa' chunimjiik i Dios xa ruum i rukik'eel i Jesucristo xuchihkaaj. Re' taq i hat najtir najt naq taq wilkaat ruuk' i Dios, yu'naak ruuk' chik taq wilkaat i koq.</para>
  <para style="p">
    <verse number="14" style="v" />Re' i Jesucristo xk'ulik kojwoq qeh pansuqkiil k'uxliis, i hoj naq ka'ch'uq chi tinamit noq wilkooj, chi je' aj Judío, chi je' ma' re' ta aj Judío. Re' reh xk'ulik esanoq ree ixowaal, inq'atwik naq chi qawach. <verse number="15" style="v" />Re' Cristo xk'ulik sachwoq wach i kowlaj taaq'anik naq i rub'an i najtir k'uhb'aal. Eh re' i hoj ka'ch'uq chi tinamit i ma' nqaaj ta naq qawach, xoj ru aak'b'isaj, xub'an chi xa jinaj chik qawach, xoj ruyeew pansuqkiil k'uxliis. <verse number="16" style="v" />Eh ruum i ti'laj kimik xuk'ul i Jesucristo wach kuruus, xusach wach ixowanik qiib' inqa a'n naq chi qawach i hoj ka'ch'uq chi tinamit. Eh xojrukoj ruuk' i Dios panotob'il, xojrukanaa' chi xa jinaj chik qawach. <verse number="17" style="v" />Re' Jesucristo xk'ulik ruq'or i ko'lemb'al iib', re' inye'wik suq laj k'uxliis aweh taq i hat, i ma' hat ta taq aj judío, i ma' nanimaj ta naq taq i Dios, eh qeh hoj, i hoj aj judío, i qohnimanik naq ree Dios noq inqaq'or. <verse number="18" style="v" />Eh xa ruum i Jesucristo neenqa a'n okik panotob'il ruuk' Ajaab'ees Dios chi je' i hoj, chi je' taq i hat, re' jinaj chi Santolaj Uxlab'al neentoob'inik qeh chub'aan.</para>
  <para style="p">
    <verse number="19" style="v" />Ruum aj re', re' taq i hat ma' hat ta chik taq tokoom tinamit, ma' hat ta taq chik aj patal. Yu'naak xa jinaj chik wach taq ak'axariik i rub'an i Dios kuuk' i rutinamiit, hat taq chik rak'uun rixq'uun i Dios. <verse number="20" style="v" />Re' taq i hat, je' taq akab' i paat ch'iklik chi korik chinaah i raa', ruum i nayeew taq ak'ux chunimjiik i xkik'uhtaaj chaloq taqe aj tahqaneel, taqe jalal ruq'oral i Dios. Eh re' i je' ab'aj kojooj chi rukowiil raa' i paat, re' i Jesucristo. <verse number="21" style="v" />Noq wilkooj ruuk' i Cristo je' qakab' i paat holohik i korjik i rub'an johtoq, noq xa jinaj chik wach qak'ux chunimjiik i Jesucristo. Korehtaal neenqareq chi je' hoj rupaat QaJaaw. <verse number="22" style="v" />Je' wo' re' taq i hat, noq kow taq chik ak'ux chawunchelaal korehtaal taq ti kahnik chi hat taq rupaat i k'achlik Dios, re' impatinik wii' pan Uxlab'al.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' Pablo xpa'ab'jik ruum i Dios chi q'orol ree ak' k'uhb'aal kuuk' i ma' re' ta taqe aj judío</para>
  <para style="p">
    <verse number="1" style="v" />Re' hin i Pablo, wilkiin pantz'ilom, ruum i ruq'orariik taq aweh i ruk'uhb'aal i Cristo i ma' hat ta taq aj judío. <verse number="2" style="v" />Yu'naak inchol taq anab'eem chi re' Dios ruuk' i rotob'il xirupab'aa' chub'aan i kamanik wili reh toob'al taq aweh. <verse number="3" style="v" />Re' Dios xuk'uhtaaj cho weh i ruyejaam cho wach, re' i ma' eht'alimaj ta naq chaloq, re' nuq'orom reje k'isiin rib'iral taq aweh panhuuj. <verse number="4" style="v" />Eh noq nee taq inawil wach i huuj wili, nee taq inakoj rehtaal chi re' hin korik chi weht'al i ma' eht'alimaj ta naq xk'ulik rub'an i Jesucristo. <verse number="5" style="v" />Eh ma' awach ta aj eh xye'arik chi naab'jik najtir cho q'iij. Raaj yu'naak, re' Dios ruuk' i ruSantolaj Uxlab'al xuyeew chi naab'jik keh i santo laj jalal ruq'oral, je' wo' qee hoj, i hoj raj tahqaneel i Jesucristo. <verse number="6" style="v" />Re' chi re' taq i hat i ma' hat ta taq aj judío eliik wach i qakooch naa qak'ulum taq awuuk' i hoj aj judío. Eh naa wo' taq awehtriik haa' parub'ihnaal i Jesucristo i ruq'orom cho rib'iral i Dios, re' i ruq'or i ak' k'uhb'aal. <verse number="7" style="v" />Eh re' hin xirupab'aa' chaloq i Dios ruuk' i runimaal i rotob'il chi q'orariik rib'iral i ak' k'uhb'aal ruum i re' k'ahchi' nuq'orom yu'naak.</para>
  <para style="p">
    <verse number="8" style="v" />Re' hin xama' xta naq wajaawriik chikiwach i xama' nim ta wach kajaawriik chi kixilak rak'uun rixq'uun i Dios. Eh re' Dios xuyeew weh chi q'orariik taq aweh i ma' hat ta taq aj judío i ak' k'uhb'aal ma' ha' ta chi je' xk'ulik ruyeew i Jesucristo ruuk' i runimaal i rotob'il. <verse number="9" style="v" />Eh re' Dios, i xtz'uhkrisanik cho reh chu'nchel i xa chib'ih jariik, xuq'or weh chi chu'nchel aj eh naa nuq'orom i ruyejaam cho wach, re' i ma' eht'alimaj ta naq i rutohq'iik chaloq i k'acharik. <verse number="10" style="v" />Re' Dios je' re' i xub'an, reh chi kuuk' chik taqe aj nimaneel, neenkilow yu'naak taqe wilik cho kajaawriik chi taaq'anik pan taxaaj chi re' Dios xiik' naah i runa'ojb'al, eh xanik' wach ruk'uhtjiik xub'an chaloq. <verse number="11" style="v" />Re' Dios xub'an i wili je' rukab' i ruyejaam cho wach pampeet reh juneliik, eh korehtaal xooj eloq wach ruuk' i xk'ulik rub'an i QaJaaw Jesucristo. <verse number="12" style="v" />Eh yu'naak ch'iklik qak'ux chi nee chik inqa a'n okik panotob'il ruuk' i Dios ruum k'ahchi' chik qaye'em qak'ux chunimjiik i Jesucristo. <verse number="13" style="v" />Ruum aj re', i nupahqaaj taq otob'il aweh chi marub'an taq ki'ib' ak'ux chi nimanik ruum i ti' k'axik k'ahchi' nuk'ulum taq chawiij. Ruum re' wili, naa rukamaniik chi toob'al taq aweh.</para>
  <para style="s">Xiik' naah qohruk'ax i Jesucristo</para>
  <para style="p">
    <verse number="14" style="v" />Ruum aj re', inuxuk'aa' wiib' chi tiij, reh i rupahqaljiik ree Ajaab'ees Dios, re' i raJaaw i QaJaaw Jesucristo, chi nee taq tutoob'eej. <verse number="15" style="v" />Re' i kaJaaw chu'nchel i aj nimaneel, chi je' wilkeeb' pan taxaaj chi je' wilkeeb' wach ak'al. <verse number="16" style="v" />Eh i nupahqaaj wo' reh i Ajaab'ees Dios chi chuyeew taq cho panawánima i loq'laj runimaal i ruk'axb'al, eh chi chuyeew taq rukowiil ak'ux ruuk' i ruSantolaj Uxlab'al. <verse number="17" style="v" />Re' ta naq i Jesucristo neenpatinik taq panawánima ruuk' i nimanik k'ahchi' taq kaat. Eh noq kow taq chik ak'ux, eh wilik taq chik i k'axooj panawánima chi korik, <verse number="18" style="v" />nee taq inareq chi riij kuuk' chu'nchel i aj nimaneel chi re' qak'axariik i rub'an i Jesucristo, ma' pajooj taj i runimaal wach, i runimaal rooq, i ruchamiil paam, runajtiil naah. <verse number="19" style="v" />Re' hin, i nupahqaaj reh i Dios chi nee ta naq inaweht'aliij taq chi re' i k'axooj i rub'an i Jesucristo, xti xiik' wo' chik naah nimaal ruloq'il chuwach inqeht'aliij i hoj. Eh chi je' re', neen wihik taq panawánima chi manlik i rotob'il i Dios.</para>
  <para style="p">
    <verse number="20" style="v" />Re' i wilik rajaawriik chuye'ariik qeh chi xiik' naah inqapahqaaj reh oon xa neenqakapaaj cho panqak'ux rupahqaljiik. Eh xiik' naah i rotob'il nee ruyeew qeh ruuk' i rajaawriik inkahnik pan qánima. <verse number="21" style="v" />Re' ta naq i Dios qayeew ruloq'il i hoj i qohnimanik chik reh i Jesucristo. Eh nee ta wo' naq inkiyeew ruloq'il i Dios i jar ch'iht chik chi k'achareel i naakik'iik. Je' ta wo' naq re'.</para>
  <chapter number="4" style="c" />
  <para style="s">Xa jinaj chik qawach ruum i qatoob'jiik i rub'an i Santolaj Uxlab'al</para>
  <para style="p">
    <verse number="1" style="v" />Re' hin wilkiin pantz'ilom ruum i ruq'orariik i ruk'uhb'aal i QaJaaw Jesucristo, i nupahqaaj taq reje otob'il aweh chi ti k'acharoq taq parukorkiil je' rukab' i xraaj taq awuuk' i Dios noq xusik' taq chaawach. <verse number="2" style="v" />Eh xa tiloch'ik tik'upik-oq taq atoob'-oq wach taq ak'ux wilik-oq i q'unil taq awuuk', k'ul taq cha kuy amahk chawach ruuk' k'axooj. <verse number="3" style="v" />Chachop taq ak'ux chi wihik pan jinaj wach k'uxliis, chi wihik pansuqkiil k'uxliis ruuk' taq atoob'jiik i rub'an i Santolaj Uxlab'al. <verse number="4" style="v" />Xa jinaj chi nimanik, jinaj chi Uxlab'al. Je' rukab' noq xusik' taq chaa wach i Dios xa jinaj chi ko'lb'al iib' ch'iklik taq reje wii' ak'ux. <verse number="5" style="v" />Jinaj i QaJaaw, jinaj chi ye'ej k'uxliis chi nimanik, jinaj chi qasanik ha' qak'ulum. <verse number="6" style="v" />Xa jinaj i Dios re' reh i QaJaaw wilik cho chi qanaah chi qunchelaal. Eh re' reh q'oreel chinaah chu'nchel i chib'ih jariik wilik.</para>
  <para style="p">
    <verse number="7" style="v" />Eh chi qaju'junaal, reh reh wach i qakooch xqak'ul, re' q'oreel chib'ih kamanikaal i xuyeew qeh i Jesucristo. <verse number="8" style="v" />Ruum panhuuj reh i Salmo je' wili ruq'or:</para>
  <para style="b" />
  <para style="q">Jaaw re' hat xat johtik pana ye'aab'</para>
  <para style="q">eh wilik taqe i panti' k'axik wilkeeb'</para>
  <para style="q">xak'am taqe johtoq chawiij.</para>
  <para style="q">Eh xayeew kikooch taqe aatinamiit, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" />Eh ¿chib'ih iraaj ruq'orom i re', chi xjohtik wo' chik pan taxaaj? Re' re' iraaj ruq'orom chi ar wo' xqajik choo pampeet noq xk'ulik ayu' wach ak'al. <verse number="10" style="v" />Eh re' xqajik chaloq, re' wo' chik i reh xjohtik kochinaah i taxaaj, reh chi nee ruyeew i rotob'il chikinaah i wilkeeb' pan taxaaj, i wilkeeb' wach ak'al. <verse number="11" style="v" />Eh re' wo' i Jesucristo xpaab'anik keh aj tahqaneel, wilik taqe xupab'aa' chi jalal ruq'oral i Dios, wilik taqe xupab'aa' chi q'orol rib'iral i ak' k'uhb'aal, wilik taqe xupab'aa' chi k'amal b'eeh, eh chi aj tijoom. <verse number="12" style="v" />Je' re' xub'an reh chi re' taqe i raj kamanoom neenkian i rukamaj. Ruuk' i re', neenkian ruye'ariik i rukowiil kik'ux taqe aj nimaneel re' taqe jilow rooq q'ab' i Jesucristo. <verse number="13" style="v" />Eh korehtaal i rub'an jinaj wach qak'ux chi nimanik, reh chi neenqeht'aliij aha' wilik iraaj i Rak'uun i Dios. Ruuk' i re', neenkowjik qak'ux, korehtaal inqareq rukorkiil wach ak'ux chi manlik je' rukab' i Jesucristo korik wach ruk'ux.</para>
  <para style="p">
    <verse number="14" style="v" />Chi je' re' ma' je' ta chik runa'ojb'al ha'lak'un i qana'ojb'al, ma' xata eeh neenqaq'or keh chukul q'orik ruuk' i xa chib'ih jariik chi tokoom k'uhb'aal neenkiq'or qeh. Eh ma' nee ta chik inqayee qiib' chi jot'arik keh taqe i xa chukul q'orik. <verse number="15" style="v" />Re' la' i korik naa qaq'orom ruuk' k'axooj keh i qas qachaaq'. Eh k'ahchi'-oq qareqem rukorkiil wach qak'ux je' rukab' i rukorkiil wach ruk'ux i Jesucristo, re' i k'amal qab'eeh i hoj, hoj raj nimaneel. <verse number="16" style="v" />Eh re' wo' Jesucristo i molwik kiwach i aj nimaneel, re' taqe i jilow rooq q'ab' i reh. Eh i ruyeew taqe pan jinaj wach k'uxliis, pansuqkiil k'uxliis. Noq kikamanik chik chi korik i ju'jun chi aj nimaneel, ma' xta chik reet i nimanik neenkian chi kunchelaal, nee chik inki a'n i k'axooj chi korik.</para>
  <para style="s">Re' i ak' k'acharik i ruyeew i Jesucristo</para>
  <para style="p">
    <verse number="17" style="v" />Re' wili i nuq'or taq reje aweh, eh i nupahqaaj taq otob'il aweh parub'ihnaal i QaJaaw chi maa a'n taq chik awee hat je' rukab' inki a'n i ma' kinimanik ta ree Dios. Re' keh re' inki a'n i kisahchel laj kapeew. <verse number="18" style="v" />Eh q'equm paam i kikapeb'aal. Re' keh ma' k'ahchi' ta kianam rusuqkiil i k'acharik i ruyeew i Dios, ruum ma' xta kina'ojb'al, eh ruum chi q'e' inki kowb'isaj i kánima. <verse number="19" style="v" />Re' keh ma' xta chik inkaaj reh i k'ixik. Xa re' chik inkiyeew chikiwach rub'aan inkootwaaj i keh. Eh ma' kihi'lik ta chik chub'aan chu'nchel i ch'uwa' wach na'ojb'al. <verse number="20" style="v" />Raaj taq i hat i k'ahchi' taq chik animam i Jesucristo, ma' xk'uhtjik ta taq chaaweh chi naa taq a'nam taqe re'. <verse number="21" style="v" />Eh wila' xti korik chi xab'iraj taq rib'iral i Jesucristo, xk'uhtjik taq chaaweh chi manlik chi xa ruuk' wo' reh wilik i korik. <verse number="22" style="v" />Eh chaq'eb' taq chi riij ak'ux ayiib' wach na'ojb'al i naa a'n taq cho najtir. Maa a'n taq chik aweh i je' rukab' i na a'n naq taq chaloq, ruum re' taqe ruk'axariik wach i yiib' wach na'ojb'al injot'wik taq aweh. <verse number="23" style="v" />Eh inchol taq ajalam wach ana'ojb'al, taq akapeb'aal. <verse number="24" style="v" />Re' la' chik i ak' na'ojb'al taq cha a'n, re' i rutz'uhkrisam chaloq i Dios. Eh ti k'acharoq taq chi saq taq wach ana'ojb'al, chi korik taq chik wach ak'ux, pan santohiil.</para>
  <para style="p">
    <verse number="25" style="v" />Je' re' noq maat chukwik taq chik q'orik, korik la' taq naa aq'oriik kuuk' aawas achaaq', ruum chi qunchelaal xa jinaj chik qawach chi nimanik, eh hoj jilow rooq q'ab' i Jesucristo.</para>
  <para style="p">
    <verse number="26" style="v" />Nik'-oq xchalik taq ak'aah chawach, mat ik'ik taq q'iij chi k'ahinik taq awiib'. Mayeew taq q'ab' ree k'aah chi nee taq tiruyeew pamahk. <verse number="27" style="v" />Mayeew taq q'ab' reh i aj Yahm chi nee taq tirujot'.</para>
  <para style="p">
    <verse number="28" style="v" />Awach-oq taq aweh i ko rub'an i leq', chukanaa' rub'aan. Ruuk' la' ransil chusik' rutumiin chi je' re' wilik i neerusiij keh i neb'aa' ruuk' i rukamaj neerub'an parukorkiil. <verse number="29" style="v" />Maaq'or taq chik aweh i hat i yiib' wach q'orik xa re' la' chik i holohik chi q'orarik taq naa aq'orom. Reh chi ma' nee ta taq inayoj kik'ux i nee ki-ib'irinik taq aweh nee la' i nayeew taq rukowiil kik'ux. <verse number="30" style="v" />Eh maayeew taq ruti'kiil ruk'ux i Santolaj Uxlab'al, re' i xkojarik taq wii' awehtalil. Eh re' reh naa ruk'uhtaniik reh chi hat taq chik rak'uun rixq'uun i Dios na' ponoq i ruq'ijil noq naa rumanaam wach taq aako'ljiik.</para>
  <para style="p">
    <verse number="31" style="v" />Eh chawisaj taq iloq panawánima i k'ahinik iib', kaqwachinik iib', k'atzk'otik, choqinik iib', b'ajaj-iib'. Eh je' wo' taqe i xa chib'ih jariik chi yiib' wach na'ojb'al. <verse number="32" style="v" />Xa atoob'-oq la' taq wach ak'ux, k'ul taq chaketelaaj awach. Eh k'ul taq cha kuy amahk chawach, je' rukab' noq xukuy taq chaamahk i Dios i hat parub'ihnaal i Jesucristo.</para>
  <chapter number="5" style="c" />
  <para style="s">I ruk'ul chi holohik naa kik'achariik taqe rak'uun rixq'uun i Dios</para>
  <para style="p">
    <verse number="1" style="v" />Re' taq i hat, i hat taq chik rak'uun rixq'uun i Dios, q'e' taq hat ruk'axam, cha tijej taq awiib' ruuk' i reh. <verse number="2" style="v" />Eh cha k'ax taq awiib', je' rukab' i qak'axariik xub'an i Jesucristo, noq xuq'asaj riib' pankimik quum i hoj, xuq'asaj riib' chi jinaj mayiij, q'e' ink'ohnik imponik chuwach i Dios.</para>
  <para style="p">
    <verse number="3" style="v" />Eh ma' ruk'ul taj chi nee taq inak'utjaaj aweh k'oyomal, i xa chib'ih chik jariik chi ch'uwa' wach na'ojb'al, ni xata re' ruk'axariik wach i tokoom aj eh ruum hat taq chik santo laj aj nimaneel. <verse number="4" style="v" />Maaq'or taq aweh i k'ixb'ilaal chi q'orarik. Mo'-oq awach taq aweh i xa teheeh wach chuq'orariik i memil laj q'orik. Eh mo'-oq awach taq aweh inq'orik yiib' wach sa'al, re' la' t'iosinik taq naa a'nam. <verse number="5" style="v" />Aweht'al taq i hat chi re' k'oyoom, chi re' b'anal reh i ch'uwa' wach na'ojb'al, oon k'axal wach b'ehomal, re' taqe re' eliik wach ruuk' i loq'inik tiyoox ma' jaruuj naa rokiik pa runimaal rajaawriik i Jesucristo pa runimaal rajaawriik i Dios.</para>
  <para style="p">
    <verse number="6" style="v" />Maayeew taq chik awiib' chi jot'arik keh i xama' xta rutiq wach inkiq'or, eh ruum taqe yiib' wach na'ojb'al re' re', naa ruye'em chaloq i rujosq'iil i Dios chikinaah i ma' kinimanik ta ree reh. <verse number="7" style="v" />Ma a'n taq chik aweh re' hat i yiib' wach na'ojb'al inki a'n i keh. <verse number="8" style="v" />Re' taq i hat najtir, panq'equm naq taq k'acharik i na a'n. Raaj i yu'naak, pan saqum taq chik k'acharik i na a'n ruuk' i qajaaw. Chak'uhtaaj taq re' chi hat taq chik rak'uun rixq'uun i saqum, <verse number="9" style="v" />ruum noq wilik chik i Santolaj Uxlab'al pan ánima, re' otob'il, re' holohik, re' i korik laj k'acharik i ruyeew. <verse number="10" style="v" />Ruum aj re', cha chop taq ak'ux chub'anariik imponik chuwach i QaJaaw Jesucristo. <verse number="11" style="v" />Matokik taq haa' chub'anariik taqe xama' xta kamaj inki a'n i wilkeeb' chi k'acharik panq'equm. Chaq'or la' taq rukorkiil keh chi ma' toob' taj inki a'n <verse number="12" style="v" />K'ixb'ilaal nare' chi q'orarik aha' wilik inki a'n chi q'eeqmaal taqe ma' re' ta aj nimaneel re' re'. <verse number="13" style="v" />Eh noq inooj naab'joq taqe inki a'n chi q'eeqmaal, ruum i rureqariik i saqum inkireq chi riij chi ma' toob' taj inki a'n <verse number="14" style="v" />ruum aj re', tz'ihb'amaj chi je' wili:</para>
  <para style="b" />
  <para style="q">Re' hat, i je' suq awiriik, na'lojoq aweh.</para>
  <para style="q">Eh re' hat i je' hat kamnaq, wukteen chaloq chi kixilak i kamnaq.</para>
  <para style="q">Re' Cristo neensihq'inik aweh, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" />Ruum aj re', chawik'raaj taq awiib' i hat. Mo'q xa hat taq min min chub'anariik taq ayiib' wach na'ojb'al, wilik-oq la' taq ana'ojb'al. <verse number="16" style="v" />Re' la' taq cha a'n i ruk'ul chi b'anarik, ruum re' taqe q'iij wilkooj wii', k'axik i k'acharik. <verse number="17" style="v" />Mo'q xa teheeh taq awach chub'aan i re' ma' re'. Chachop la' taq ak'ux chureqariik chi riij iraaj i QaJaaw Jesucristo chi nee taq i na a'n. <verse number="18" style="v" />Ma a'n wo' taq aweh i xohk'rik, ruum re' re' i ruyoj i na'ojb'al. Re' la' i Santolaj Uxlab'al wih-oq taq panawánima chi manlik. <verse number="19" style="v" />Chak'utjaaj la' taq chawach i rotob'il i wilik pan Salmo. Cha a'n taq atz'uuy. Eh titz'uyinoq taq chi chu'nchel awánima chi ye'b'al ruloq'il i QaJaaw Jesucristo. <verse number="20" style="v" />Eliik wo' taq chat'iosej ree Ajaab'ees Dios parub'ihnaal i QaJaaw Jesucristo chu'nchel i ruyeew chaaweh.</para>
  <para style="s">K'ul taq cha nimaj awiib' chawach</para>
  <para style="p">
    <verse number="21" style="v" />Re' taq i hat, k'ul taq naa animam awiib' chawach, reh chi nee taq inayohleej i Jesucristo.</para>
  <para style="p">
    <verse number="22" style="v" />Re' taq i hat ehk'eenb'ees, tinimanoq taq chikiwach ab'ahiil je' rukab' runimjiik i QaJaaw taq i na a'n, <verse number="23" style="v" />ruum re' b'ahiilb'ees k'amal rub'eeh i ehk'eenb'ees, je' rukab' i Jesucristo re' reh k'amal kib'eeh aj nimaneel. Eh re' wo' reh inko'linik keh, eh jilow taqe rooq q'ab' noq wilkeeb'. <verse number="24" style="v" />Eh nik' wach noq kinimanik taqe aj nimaneel chuwach i Jesucristo, je' wo' re' noq naakinimaniik taqe ehk'eenb'ees chuwach i kib'ahiil ruuk' chu'nchel i ruk'ul chi b'anarik.</para>
  <para style="p">
    <verse number="25" style="v" />Je' wo' re' taq i cha a'n i hat b'ahiilb'ees cha k'ax taq awehk'een je' rukab' i xub'an i Jesucristo xuk'ax taqe aj nimaneel, eh xuyeew riib' chi kimik chikiij. <verse number="26" style="v" />Re' wili i xub'an i kuuk' i aj nimaneel, re' xraaj i reh chi xuyeew keh i santo laj k'acharik, eh xutz'aj wach i kánima ruuk' i ruq'oral i Dios je' wo' ruuk' ha'. <verse number="27" style="v" />Re' xraaj Jesucristo chi neeruk'ul taqe ruuk' aj nimaneel chi wilik kiloq'il, chi ma' xta k'isinoq ruch'uwa'iil wach i kánima, eh ma' xta k'isinoq kimahk, korik la' wach kik'ux, wilik kisantohiil. <verse number="28" style="v" />Je' wo' hoq i b'ahiilb'ees inchol ruk'axam i rehk'een, ruum awach i ruk'ax i rehk'een, iraaj ruq'orom chi re' wo' reh ruk'ax riib', <verse number="29" style="v" />ruum ma' awach ta jino'q neerixowaaj wach i ruti'jolal chi rib'il riib' i ruk'ax la' i ruk'uxlaaj chi korik, je' rukab' i rub'an i Jesucristo kuuk' i aj nimaneel, i ruk'ax taqe, <verse number="30" style="v" />ruum jilow rooq q'ab' taqe noq wilkeeb'. Eh re' hoj i qohnimanik reh, hoj wo' jilow rooq q'ab' i Jesucristo noq wilkooj. <verse number="31" style="v" />Ruum aj re', re' winaq naa reliik nah q'ab' i rutuut rajaaw, ruuk' chik i rehk'een naa ruk'ulaam wach i ruk'achariik pankaxarohiil. Re' taqe i ki'ib' re' re', xa jinaj chik taqe. <verse number="32" style="v" />Re' ma' eht'alimaj ta naq wili, xiik' naah loq'il. Eh re' k'ahchi' nuq'orom taq awee hin chi riij i Jesucristo inq'orik, chikiij taqe i aj nimaneel. <verse number="33" style="v" />Je' re' noq re' taq i hat b'ahiilb'ees, cha k'ax taq awehk'een cha ju' junaal je' rukab' noq inak'ax taq awiib' i hat. Eh re' ju'jun chi ehk'eenb'ees, inchol wo' runimam i rub'ahiil.</para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hat taq ak'uunb'ees ixq'uunb'ees cha nimaj taq atuut awajaaw je' rukab' iraaj i QaJaaw, ruum re' re' i ruk'ul chi b'anarik. <verse number="2" style="v" />Ruum re' peet k'uhb'aal, inq'orik rib'iral chi wilik i naa ruye'ariik qeh, je' wili ruq'or: Chak'ax taq atuut awajaaw, <verse number="3" style="v" />reh chi suq taq nee ti wihik, eh chi nee najtb'ik rooq taq aak'achariik ayu' wach ak'al, inki.</para>
  <para style="p">
    <verse number="4" style="v" />Eh re' taq i hat tuutb'ees ajaab'ees, maa kaqrisaj taq awak'uun awixq'uun chi ma' xta rub'ehel. Chak'isaj la' taq parukorkiil chak'uhb'alej taqe parub'ihnaal i QaJaaw Jesucristo.</para>
  <para style="p">
    <verse number="5" style="v" />Je' wo' taq i hat kamanoom, tinimanoq taq chikiwach apatroon ayu' wach ak'al. Cha a'n taq i kikamaj parukorkiil ruuk' loch'ik chu'nchel taq ak'ux. Je'-oq rukamaj i Cristo taq i na a'n. <verse number="6" style="v" />Mo'-oq xa re' taq neena a'n i kikamaj noq k'ahchi' taq kaat kicha'jeem, xa reh chi suq kik'ux taq awuuk'. Ruum chi hat taq raj kamanoom i Jesucristo cha a'n taq i kikamaj chu'nchel taq awánima, eh nee taq i na a'n iraaj i Dios. <verse number="7" style="v" />Cha a'n taq i kikamaj apatroon chu'nchel taq ak'ux je'-oq rukamaj i QaJaaw Jesucristo i k'ahchi' taq kaat. <verse number="8" style="v" />Ruum aweht'al taq chik chi re' QaJaaw naa ruye'wiik jilow i holohik taq naa a'nam cha ju'junaal, atoob' ta wilik taq apatroon, atoob' ta ma' chih taq apatroon.</para>
  <para style="p">
    <verse number="9" style="v" />Eh je' wo' taq i hat patroon, holohik-oq taq ana'ojb'al kuuk' amoso, je' rukab' noq kinimanik taq chawach i keh. Ma' xta chik ti' k'axik taq naa a'nam keh. Ruum xa jinaj i QaJaaw wilik cho pan taxaaj taq inanimaj kuuk', re' reh ma' awach taj i tokoom rilariik i rub'an.</para>
  <para style="s">Re' ko'lemb'al qiib i ruyeew i Dios panuxlab'al</para>
  <para style="p">
    <verse number="10" style="v" />Eh yu'naak hermano, i nuq'or taq aweh chi chasik' taq rukowiil ak'ux ruuk' i runimaal rajaawriik i QaJaaw Jesucristo. <verse number="11" style="v" />Eh chakoj taq chi ko'lemb'al awiib' chu'nchel i runimaal rajaawriik i Dios ruye'em taq aweh. Chi je' re', ma' nee ta ruyoj taq ak'ux i aj Yahm nik' nee raaj taq aajot'ariik, <verse number="12" style="v" />ruum re' hoj ma' kuuk' ta taqe quch ti'jolal k'ahchi'kooj chi peleto. Kuuk' la' taqe i k'ih b'uhr kiwach chi ma' tob'laj uxlab'al wilkeeb' cho panteew k'ahchi'kooj chi peleto. Re' taqe re' kitaaq'anik, wilik kajaawriik, eh kichopom naah i tinamit wach ak'al panq'equm kiye'em ruum i mahk. <verse number="13" style="v" />Ruum aj re', chu'nchel i rajaawriik i Dios ruye'em taq chaaweh kamanoq taq aweh chi ko'lb'al taq awiib'. Ruuk' i re', nee taq inakuy ransil i ti' k'axik nik' neenchalik taq cha naah, noq areqem taq chik rukowiil ak'ux.</para>
  <para style="p">
    <verse number="14" style="v" />Eh kow-oq taq ak'ux, xti cha yejaa' taq awiib' ruuk' i korik laj ruq'oral i Dios. Eh re' korik laj k'acharik taq neena a'n neenko'linik taq aweh chuwach i aj yahm. <verse number="15" style="v" />Xa eliik-oq wo' taq ayejaam awiib', reh chi nee taq tiooj chuq'orariik i ak' k'uhb'aal inye'wik qeh pansuqkiil k'uxliis. <verse number="16" style="v" />Eh re' ta naq i ruye'ariik taq ak'ux chi nimanik i nee taq inakoj chi jilow apulato ch'ihch'. Reh chi ma' xta taq neetiruchej i je' ch'aab' qoplik ruq'aq'al i rukoj chi jot'b'al i aj yahm. <verse number="17" style="v" />Re' ko'lemb'al iib', kamanoq taq aweh chi jilow ach'ihch' puneet. Eh re' ruq'oral i Dios i ruyeew taq aweh i Santolaj Uxlab'al, kamanoq taq aweh chi jilow taq ach'ihch' k'ul q'as. <verse number="18" style="v" />Eh maakanaa' taq rub'aan aatiij, cha pahqaaj taq reh i Dios chib'ih taq inawaaj, ruuk' i rajaawriik i Santolaj Uxlab'al. Xa eliik-oq na'lik taq aweh, reh chi ma' nee tanyoj taq ak'ux. Eh cha a'n taq atiij chikiij chu'nchel santo laj aj nimaneel. <verse number="19" style="v" />Cha a'n wo' taq chaatiij chi wiij i hin, reh chi re' Dios nee ruyeew nuq'oral, eh ma' nee ta kinyo'jik chuq'orariik, i ma' eht'alimaj ta naq cho chi riij i ak' k'uhb'aal. <verse number="20" style="v" />Eh re' hin xinpa'ab'jik chuq'orariik rib'iral. Eh ruum i re' hin kiye'em pantz'ilom yu'naak, cha a'n taq chaloq atiij chi wiij, reh chi ma' nee ta kinyo'jik chuch'ob'ariik rub'ehel.</para>
  <para style="s">Ye'ej suq kiil k'uxliis xkuxik wii' wach rutz'ihb'jiik i huuj wili</para>
  <para style="p">
    <verse number="21" style="v" />Eh reh chi nee taq inaweht'aliij i hat nik' wach noq wilkiin ayu', eh chib'ih i k'ahchi' nub'anam, re' loq'laj hermano Tíquico, i korik wach ruk'ux chi to'ooj parukamaj i QaJaaw, neen q'orik ponoq taq aweh. <verse number="22" style="v" />Ruum i wili, xnutaq'aaj taq reje awuuk' i Tíquico, reh chi neeruk'utjaaj taq ponoq aweh nik' wach noq wilkooj, ruuk' i re' nee ruyeew ponoq rukowiil taq ak'ux chi nimanik.</para>
  <para style="p">
    <verse number="23" style="v" />Re' ta naq i Ajaab'ees Dios, re' ta naq i QaJaaw Jesucristo neen ye'wik taq panawánima i suq kiil k'uxliis, i k'axaj iib', i ye'ej k'uxliis chi nimanik. <verse number="24" style="v" />Eh chuyeew ta naq chee rotob'il i Dios chi qanaah i qoh k'axwik reh i QaJaaw Jesucristo ruuk' jinaj ruk'axariik ma' sahchik ta wach reh. Je' ta wo' naq re'.</para>
</usx>