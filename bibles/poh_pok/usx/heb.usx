<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="HEB" style="id">HEBPOK.SFK 31-05-2,007 ADELINA QUEJ POKOMCHI Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">HEBREOS</para>
  <para style="toc3">Heb</para>
  <para style="toc2">Heb</para>
  <para style="toc1">HEBREOS</para>
  <para style="mt2">RE' I RUHUUJ I HEBREOS</para>
  <para style="mt1">HEBREOS</para>
  <chapter number="1" style="c" />
  <para style="s">Re' Dios re' chik i Rak'uun xupab'aa' cho chi qaq'orob'jiik i hoj</para>
  <para style="p">
    <verse number="1" style="v" />Re' Dios xata wo' jarpech, xanik' wach kiq'orob'jiik xub'an taqe chaloq i qamaam qati't najtir q'iij ruuk' kichii' taqe i jalal ruq'oral. <verse number="2" style="v" />Eh chupaam i tz'apaab' wach reh taqe q'iij wili, re' chik i Rak'uun xutaq'aaj chaloq chi qaq'orob'jiik i hoj. Re' Dios xutz'uhkrisaj i wach ak'al xa ruum i Rak'uun, eh xukanaa' chi ehchan reh chu'nchel chib'ih jariik i wilik. <verse number="3" style="v" />Re' i Rak'uun wili rusaqumaal i ruloq'il i Dios. Re' reh ink'uhtanik reh nik' wach ruwii' i Dios. Eh re' Rak'uun ruuk' i rajaawriik i ruq'oral i ruyeew taqe paruye'aab' chu'nchel i xa chib'ih jariik. Eh noq rukuyum rusacham chik chu'nchel i qamahk, xooj tzuhnoq parusak'aaj q'ab' Ajaab'ees Dios chupaam i loq'laj ye'aab' pan taxaaj. <verse number="4" style="v" />Re' Rak'uun i Dios nim wach i rajaawriik chuwach i kajaawriik taqe ánjel, ruum re' reh xuk'ul chi rukooch jinaj i rub'ihnaal, xiik' naah nimaal wach chuwach i keh i ánjel.</para>
  <para style="s">Re' Rak'uun i Dios nim Rajaawriik chikiwach taqe i ángel</para>
  <para style="p">
    <verse number="5" style="v" />Re' Dios ma' jank'al ta i ruq'or reh jino'q ánjel chi je' wili:</para>
  <para style="b" />
  <para style="q">Re' hat, hat Wak'uun, re' hin xin ye'wik</para>
  <para style="q">aak'achariik yu'naak ma' inki ta reh.</para>
  <para style="q">Ma' jank'al ta wo' ruq'or reh jino'q i ánjel chi je' wili:</para>
  <para style="q">Re' hin, hin aaWaJaaw,</para>
  <para style="q">eh re' hat, hat Wak'uun, ma' inki ta reh.</para>
  <para style="q">
    <verse number="6" style="v" />Eh noq xutaq'aaj chaloq i Rak'uun i Dios</para>
  <para style="q">ayu' wach ak'al, wilik i ruq'or wii' i Dios</para>
  <para style="q">pan santo laj huuj chi je' wili:</para>
  <para style="q">Chu'nchel i ánjel naakiloq'iniik reh i Wak'uun, inki.</para>
  <para style="q">
    <verse number="7" style="v" />Re' Dios ruq'orom wo' cho chikiij ánjel chi je' wili:</para>
  <para style="q">Re' hat inakoj taqe chi awaj taqareel i kowlaj teew,</para>
  <para style="q">eh inakoj taqe chi awaj kamanoom i xaq q'aaq', inki.</para>
  <para style="q">
    <verse number="8" style="v" />Eh re' chik i xuq'or i Dios chi riij i Ak'uunb'ees je' wili:</para>
  <para style="q">Re' runimaal awajaawriik i hat, hat Dios,</para>
  <para style="q">juneliik naa awihiik chi taaq'anik.</para>
  <para style="q">Eh parukorkiil na a'nam i taaq'anik re' re'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hat, re' i rub'ehel xponik chawach,</para>
  <para style="q">eh xawixowaaj wach i yiib' wach na'ojb'al.</para>
  <para style="q">Ruum aj re' xnusik' chaawach i hin, hin aaDios.</para>
  <para style="q">Eh xiik' naah i suq kiil k'uxliis xnuyeew</para>
  <para style="q">awee hat chuwach i xnuyeew keh awuch'ihil, inki.</para>
  <para style="q">
    <verse number="10" style="v" />Re' Dios xuq'or wo' chik reh Ak'uunb'ees chi je' wili:</para>
  <para style="q">Jaaw, re' hat xatch'iikanik cho reh paruye'aab'</para>
  <para style="q">i wach ak'al pampeet.</para>
  <para style="q">Eh re' wo' hat xatyej-anik reh i taxaaj.</para>
  <para style="q">
    <verse number="11" style="v" />Re' taqe re', xanaa wo' rusahchiik kiwach,</para>
  <para style="q">xa je' rukab' noq insahchik wach i q'aah itz'ihy.</para>
  <para style="q">Eh re' hat, xa wilkaat wo' chi juneliik.</para>
  <para style="q">
    <verse number="12" style="v" />Re' hat xa je' imb'usarik wach itz'ihy na a'nam keh.</para>
  <para style="q">Eh xa je' injalarik itz'ihy na' chajal kiwach,</para>
  <para style="q">re' hat xa re' wo' awach.</para>
  <para style="q">Re' aak'achariik xama' k'uhlik ta wo' reh, inki i Dios.</para>
  <para style="q">
    <verse number="13" style="v" />Re' i Dios ma' jank'al ta xuq'or reh jino'q i ánjel chi je' wili:</para>
  <para style="q">Kim, ti tzuun panusak'aaj chupaam i nuloq'laj ye'aab',</para>
  <para style="q">korehtaal i nuyeew taqe ri'si aawooq i ki-ixowanik awach, ma' nki ta reh.</para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" />Ruum chu'nchel i ánjel xa uxlab'al wo' taqe chub'aan i rukamaj i Dios. Re' Dios i rutaq'aaj taqe chaloq i ánjel re' re' chi kitoob'jiik i naa kik'ulwiik reh chi kikooch i ko'lemb'al iib'.</para>
  <chapter number="2" style="c" />
  <para style="s">Manqayeew chi re' chi ma' re' i ko'lemb'al qiib'</para>
  <para style="p">
    <verse number="1" style="v" />Ruum i wili, inchol qaye'em qak'ux chunimjiik i k'uhb'aal qib'iram chaloq, reh chi ma' nee ta nqakanaa' i rub'eeh i Dios. <verse number="2" style="v" />Eh wila' re' taqe k'uhb'aal xk'ulik kiq'or taqe ánjel xye'arik rajaawriik. Eh awach taqe i ximahkunik chuwach, eh ma' xkinimaj taj, xiye'arik chutojariik i kimahk je' rukab' i ruk'ul chi keh. <verse number="3" style="v" />¿Nik' chik wach noq neenqako'leej qiib' hoj chuwach i tojb'al mahk wila' xqayeew chi re' chi ma' re' jinaj ko'lemb'al iib' xiik' naah loq'il? ruum re' chik i QaJaaw Jesucristo xtooq'anik cho ruq'orariik rib'iral. Chi riij i re', xkiq'or rukorkiil qeh awach xi ib'irinik cho reh pampeet. <verse number="4" style="v" />Re' Dios xuk'uhtaaj i rajaawriik i k'uhb'aal keh i xi ib'irinik reh ruuk' taqe i ma' ilooj taj, ruuk' i ma' k'isa sahchb'al k'uxliis, ruuk' i xa chib'ih jariik xuk'uhtaaj, eh ruuk' i ruye'ariik qeh i Santolaj Uxlab'al xub'an, je' rukab' iraaj i reh.</para>
  <para style="s">Re' Jesucristo inye'wik reh i ko'lemb'al iib'</para>
  <para style="p">
    <verse number="5" style="v" />Re' Dios ma' re' ta taqe ánjel xupab'aa' chi naa ruwihiik kajaawriik chi taaq'anik chupaam i junch'iht chik chi k'acharik chalik reh, re' i k'ahchi' qaq'orom. <verse number="6" style="v" />Eh tz'ihb'amaj wo' pan santo laj huuj chi q'orooj choo chi je' wili:</para>
  <para style="b" />
  <para style="q">Loq'laj qaDios, ¿chib'ih rajaawriik i winaq xa sahchik wach reh chi naaketelaaj wach?</para>
  <para style="q">¿Chib'ih reet noq ink'ulik cho panak'ux, eh ti' nawik'raaj?</para>
  <para style="q">
    <verse number="7" style="v" />Xa ma' najt taj xaqasaj wach i rajaawriik i winaq chuwach i kajaawriik i ánjel,</para>
  <para style="q">chi riij i re' xayeew wo' chik ruloq'il, xayeew runimaal wach.</para>
  <para style="q">
    <verse number="8" style="v" />Xayeew rajaawriik chikinaah chu'nchel i xayejaa' ruuk' aq'ab',</para>
  <para style="q">chu'nchel xayeew chi ri'sil i rajaawriik, inki.</para>
  <para style="b" />
  <para style="p">Re' Dios i xuq'or chi chu'nchel xuyeew chi ri'sil i rajaawriik i winaq, ma' xta chik i xukanaa' chi ma' ta xuyeew chi ri'sil i rajaawriik. Xa re' la', komajaa' ta nqilow chi chu'nchel ta chik xuyeew chi ri'sil i rajaawriik. <verse number="9" style="v" />Eh re' hoj xqeht'aliij chi re' Jesucristo xama' najt taj xqahteesjik i rajaawriik ruum i Dios chuwach i kajaawriik i ánjel. Eh xa ruum i rotob'il, xuyeew pan kimik i Jesucristo kuum i tinamit, eh xye'arik wo' chik ruloq'il, runimaal wach ruum i ti'laj kimik xuk'ul.</para>
  <para style="p">
    <verse number="10" style="v" />Re' Dios i ehchan reh chu'nchel i chib'ih jariik wilik. Eh re' wo' reh xtz'uhkrisanik, reh chi chu'nchel i rak'uun rixq'uun naakehtriik i ruloq'il pan taxaaj. Ruum aj re', re' Dios, ruum i ti' k'axik xukuy i Jesucristo, xukanaa' chi manlik kaj Ko'loom, i rak'uun rixq'uun. <verse number="11" style="v" />Ruum re' inye'wik i santohiil, eh re' taqe i kik'ulwik reh i santohiil xa jinaj chik kiwach. Ruum aj re', rub'ehel chi ma' nee ta nk'ixik chi nee taqe rukoj chi ruhermano i kik'ulwik reh i santo laj k'acharik re' re'. <verse number="12" style="v" />Eh tz'ihb'amaj wo' pan santo laj huuj chi je' wili i q'orooj chi riij i QaJaaw Jesucristo:</para>
  <para style="b" />
  <para style="q">QaJaaw Dios, re' hin naa nuq'orom awib'iral keh was nuchaaq',</para>
  <para style="q">eh naa nutz'uyem awach chi kixilak awak'uun awixq'uun, inki.</para>
  <para style="q">
    <verse number="13" style="v" />Q'orooj wo' chi riij chi je' wili:</para>
  <para style="q">Re' hin naawuy-eem i rotob'il i Dios, inki.</para>
  <para style="q">Eh wilik wo' chik i ruq'or wii' chi je' wili:</para>
  <para style="q">Re' hin ayu' wilkiin kuuk' wak'uun xuyeew weh i QaJaaw Dios, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" />Re' hoj xa jinaj wach qati'jolal, i qakik'eel, je' wo' re' i Jesucristo reh xkorjik chi je' qawii' i hoj noq xk'ulik wih-oq ayu' wach ak'al. Re' xraaj i reh chi ruuk' i rukimiik xusach wach i rajaawriik i aj Yahm, re' imb'anik kaansanik. <verse number="15" style="v" />Je' wili i xub'an i Jesucristo noq xuyeew kiko'lb'aal chu'nchel i xa eliik naq je' pankowlaj kamanik wilkeeb' ruum i kiyo'jiik chuwach i kimik. <verse number="16" style="v" />Xti korik chi re' Jesucristo ma' re' ta taqe ánjel xk'ulik rutoob'eej re' la' taqe riih rumaam i Abraham xk'ulik rutoob'eej. <verse number="17" style="v" />Ruum i re', re' Jesucristo koruman chi xuyejaa' riib' chi je' ruwii' taqe i ruhermano, reh chi xkahnik chi k'amal kib'eeh aj tiij i aj keteloom wachiis, korik wach ruk'ux chi kamanik chuwach i Dios, eh chi xuyeew kuyb'al kimahk i tinamit ruuk' i ti'laj kimik xuk'ul. <verse number="18" style="v" />Eh ruum chi re' Jesucristo xpajarik chaloq, ruuk' i ti' k'axik xuk'ul, yu'naak i rub'an chik kitoob'jiik taqe inchalik i pajarik chikinaah.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' Jesús xiik' naah nimaal rajaawriik chuwach i rajaawriik i Moisés</para>
  <para style="p">
    <verse number="1" style="v" />Re' taq i hat hermano wilik taq asantohiil xat ruyuq'eej taq i Dios pan taxaaj, xti cha kapaaj taq riij i xk'ulik ruk'uhtaaj i Jesucristo. Re' reh raj tahqaneel i Dios, eh rajaaw k'amal b'eeh aj tiij xk'ulik chi k'amal qab'eeh chi nimanik. <verse number="2" style="v" />Re' reh xpa'ab'jik cho ruum i Dios chub'aan i kamanik wili, xub'an chi korik, je' rukab' noq xnimanik chaloq i Moisés xub'an i rukamaj i Dios chi korik. <verse number="3" style="v" />Eh re' Jesucristo reh xti ruk'ul chi xiik' naah i ruloq'il inye'arik chuwach i ruloq'il i Moisés, je' rukab' noq wilik jino'q i aj yej-an paat re' reh inye'arik runimaal wach, ma' re' taj i paat i ruyejaa'. <verse number="4" style="v" />Qeht'al noq re' ju'jun chi paat wilik inyej-anik reh. Eh chu'nchel i xa chib'ih jariik wilik, re' i Dios xyej-anik cho reh. <verse number="5" style="v" />Eh re' Moisés reh xa jinaj aj kamanoom, xub'an chi korik i rukamaj i Dios chi kixilak i rak'uun rixq'uun i Dios. Reh chi xuq'or rib'iral keh i aj Israel chi jariik i xub'an i Dios koq'uun. <verse number="6" style="v" />Eh re' Jesucristo reh, Rak'uun i Dios, xub'an i kamanik chi korik chi kixilak i rak'uun rixq'uun i Dios. Re' taqe ak'uunb'ees ixq'uunb'ees wili re' hoj, wila' ma' xyoj qak'ux, eh wila' xa eliik suq qak'ux chi ruyub'jiik i k'ahchi' reje quy-eem.</para>
  <para style="s">Re' na' kihi'loq i rutinamiit i Dios</para>
  <para style="p">
    <verse number="7" style="v" />Eh tz'ihb'amaj wo' chaloq chi je' wili i ruq'orom i Santolaj Uxlab'al:</para>
  <para style="b" />
  <para style="q">Wila' xab'iraj taq i ruq'oral i Dios yu'naak,</para>
  <para style="q">
    <verse number="8" style="v" />maakoowb'isaj taq awánima.</para>
  <para style="q">Ma a'n taq aweh i xkian taq aamaam awati't xkiq'etwachej kiib' chuwach i Dios,</para>
  <para style="q">eh xkaaj naq kipajam i chupaam i ye'aab' chiq yuuq'.</para>
  <para style="q">
    <verse number="9" style="v" />Chupaam i ye'aab' re' re' xinkaaj naq kipajam taq aamaam awati't,</para>
  <para style="q">atoob' ta xkilow wo' naq i ma' ilooj taj xnub'an cho kuuk' chuwach i ka'winaq haab'.</para>
  <para style="q">
    <verse number="10" style="v" />Ruum i re', ma' k'isiin ta noq xchalik nujosq'iil chikinaah, eh xnuq'or chi je' wili:</para>
  <para style="q">Re' keh xama' jaruuj ta wo' xkiyeew kik'ux wuuk',</para>
  <para style="q">eh ma' xkaaj ta kinimam i nuk'uhb'aal.</para>
  <para style="q">
    <verse number="11" style="v" />Ruum aj re' ruuk' i nujosq'iil</para>
  <para style="q">ti xnuq'or i korik chi ma' jaruuj naa kokiik</para>
  <para style="q">chupaam i nuye'aab' naa rub'aan wii' hi'lik, inki i Dios.</para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" />Eh re' taq i hat hermano, mo'-oq awach taq aweh ineerukowb'isaj i ránima, eh ma' nee ta nimanik, ruum-oq chik inche re' nee rukanaa' i k'achlik Dios. <verse number="13" style="v" />Rajlaal la' q'iij taq chayeew rukowiil ak'ux chawach, je' rukab' i ruq'or pan santo laj huuj chi ko ruyee riib' yu'naak, reh chi ma' awach ta taq aweh ineenjot'arik ruum i mahk, eh neeruq'etwachej riib' chuwach i Dios. <verse number="14" style="v" />Ruum wila' nqaaj chi nee qoh ehtrik i ruloq'il i Jesucristo, ajwaal wach chi naaqaye'em qak'ux chi nimanik, je' rukab' noq xqatoq'aa' cho pampeet, chi je' re' naa qak'ulum i k'ahchi' quy-eem. <verse number="15" style="v" />Eh i ruq'or wo' pan santo laj huuj chi je' wili:</para>
  <para style="b" />
  <para style="q">Wila' xab'iraj taq i ruq'oral i Dios yu'naak, maa kowb'isaj taq awánima.</para>
  <para style="q">Maa q'etwachej taq i Dios je' rukab' i xkian taq aamaam awati't, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" />Eh ¿awach aj wo' taqe re' i xi ib'irinik reh i ruq'oral i Dios, eh xkiq'etwachej kiib' chuwach? ¿Mi ma' re' taq re' aamaam awati't xi ehteesjik cho paruyuq'ul i Egipto ruum i Moisés? <verse number="17" style="v" />Eh ¿awach taqe aj uuk' xwihik cho ruk'aah i Dios chuwach i ka'winaq haab'? ¿Mi ma' kuuk' taqe re' i aamaam awati't ximahkunik chaloq re' xkahnik tuuch' i kiti'jolal chupaam i ye'aab' chiq yuuq'? <verse number="18" style="v" />Eh ¿awach taqe aj chaj-iij xuq'or i korik i Dios chi ma' jaruuj taqe naa ruk'ulum ruuk' chi hi'lik? ¿Mi ma' keh re' i ma' xkaaj ta runimjiik i ruk'uhb'aal? <verse number="19" style="v" />Eh xti korik wo' hoq chi ma' xkian taj ookik chi hi'lik chupaam i ye'aab' q'orooj cho keh ruum i Dios, ruum ma' xkinimaj taj i ruk'uhb'aal.</para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ruum aj re', yu'naak noq kok'ahchi' ruq'orom qeh i Dios chi koruyee riib' chi nee qoh okik chi hi'lik ruuk' i reh, inchol qik'raam qiib', ruum koq'uun chik wilik-oq inche taq aweh i hat i ma' nee ta chik i rub'an okik. <verse number="2" style="v" />Re' hoj xq'orarik wo' cho qeh i k'uhb'aal ree ko'lemb'al iib', je' rukab' noq xq'orarik cho kekeh najtir. Eh re' keh ma' xta xkamanik wii' keh i k'uhb'aal, ruum ma' xkian ta jinaj wach kik'ux, kuuk' i xinimanik reh i k'uhb'aal. <verse number="3" style="v" />Re' hoj, i qanimam chik i k'uhb'aal, naaqokiik chi hi'lik ruuk' i Dios je' rukab' i xuq'or. Eh re' Dios je' wili i xuq'or chikiij i ma' xinimanik taj re' re':</para>
  <para style="q">Ruuk' i nujosq'iil</para>
  <para style="q">tix nuq'or i korik chi ma' naa ta kokiik chi hi'lik wuuk' inki.</para>
  <para style="q">Atoob' ta rukohlaam wo' naq chik wach i rukamaj</para>
  <para style="q">xa re' wo' rutz'uhkrisam chaloq i wach ak'al, <verse number="4" style="v" />ruum wilik i ruq'or wii' pan santo laj huuj chi je' wili chi riij i ruwuuq q'iij:</para>
  <para style="q">Re' Dios xhi'lik paruwuuq q'iij noq rukohlaam chik wach chu'nchel i rukamaj, inki.</para>
  <para style="m">
    <verse number="5" style="v" />Eh wilik wo' chik i ruq'or wii' pan santo laj huuj chi je' wili i xruq'or i Dios:</para>
  <para style="q">Ma' naa ta kokiik chi hi'lik wuuk', inki.</para>
  <para style="m">
    <verse number="6" style="v" />Xa re' la', ko wilik iraaj chi neekiokik chi hi'lik ruuk' i Dios, ruum re' taqe i xi ib'irinik cho reh pampeet i ak' k'uhb'aal ree ko'lemb'al iib' ma' xkian taj okik chi hi'lik ruuk' i Dios, ruum ma' xkinimaj taj i ruk'uhb'aal. <verse number="7" style="v" />Ruum i re', re' Dios ko jinaj chik q'iij xuq'at i reh jinaj chik i ak' yuuq'inik. Eh yu'naak xojruq'o'reej chik, re' i xutz'ihb'aaj chaloq i reey David chi je' wili:</para>
  <para style="b" />
  <para style="q">Wila' xab'iraj taq ruq'oral i Dios yu'naak,</para>
  <para style="q">maa kowb'isaj taq awánima, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" />Wi ta reh juneliik i hi'lik xye'arik cho keh i aj Israel ruum i Josué ar Canaán, re' Dios ma' xq'orik ta naq chik cho chi riij jinaj i q'iij chi ko naaqokiik ruuk' chi hi'lik. <verse number="9" style="v" />Je' re' noq ko jinaj chik i loq'laj hi'lik yej-amaj wach chi keh i rak'uun rixq'uun i Dios, <verse number="10" style="v" />ruum awach inokik chi hi'lik ruuk' i Dios, inhi'lik ruuk' i rukamaj, je' rukab' noq xhi'lik i Dios noq rukohlaam chik i rukamaj. <verse number="11" style="v" />Je' re' noq re' hoj, inchol qachopom qak'ux chi okik chi hi'lik ruuk' i Dios, reh chi ma' awach ta qeh i neerub'an reh je' rukab' i xkian i ma' xinimanik ta cho reh i Dios.</para>
  <para style="p">
    <verse number="12" style="v" />Re' ruq'oral i Dios k'achlik, wilik rajaawriik, ma' xata je' rukab' ruyok' ch'ihch' k'ul q'as imponik kopan ánima, eh reht'al chib'ih jariik inkapeepjik cho pank'uxliis. Eh reht'al nik' wach i ruwii' i winaq. Eh i ruteh wach i ke'lik cho pan ánima ruch'ihil i xa nkapeewjik cho pank'uxliis. <verse number="13" style="v" />Re' Dios ma' xta jino'q i chib'ih jariik rutz'uhkrisam chaloq nee rukeb'aa' riib' chuwach. Chu'nchel i inqaq'or inqa a'n reht'al i reh, eh chuwach i reh narojiik qatusum wach na' chub'an.</para>
  <para style="p">
    <verse number="14" style="v" />Re' Jesucristo, i Rak'uun i Dios, jinaj raJaaw K'amal b'eeh aj Tiij chi qeh i hoj, okinaq chik i koq pan taxaaj ruuk' i Dios chi qatoob'jiik. Ruum aj re', qachop taq qak'ux chi nimanik, <verse number="15" style="v" />ruum re' i Jesucristo, i raJaaw K'amal b'eeh aj Tiij, neeruketelaaj qawach nik' neenchalik ruk'isinal qak'ux, ruum re' reh xuk'ul wo' cho reh i pajarik je' rukab' inqak'ul i hoj yu'naak. Xa re' la', re' reh ma' nik' ta xmahkunik cho k'isinoq. <verse number="16" style="v" />Je' re' noq, inchol chi ma' xta qayo'jiik noq neenqapahqaaj qakuyb'al chuwach i Dios aj K'axool, reh chi neeruketelaaj qawach, eh nee wo' qohrutoob'eej noq k'axik wilkooj.</para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Re' taqe i kajaaw k'amal kib'eeh aj tiij ko nsik'arik cho kiwach chi kixilak i aj judío, reh chi kiq'orik johtoq ruuk' i Dios chikiij i tinamit. Reh i kitoob'jiik chuq'ahteesjiik i kilemoxna, i k'atoj chikop chi kimayiij chi chi riij taqe kimahk. <verse number="2" style="v" />Eh ruum chi reht'al reh i k'amal kib'eeh aj tiij nik' wach noq inchalik i k'isinal k'uxliis, ruketelaaj kiwach i xama' keht'al taj inki a'n je' wo' taqe i awach inkikanaa' runimjiik i Dios. <verse number="3" style="v" />Eh ruum chi nk'isiinb'ik ruk'ux i k'amal b'eeh aj tiij, koruman chi ruk'at i rumayiij chuwach i Dios chi riij taqe ru mahk i reh, je' wo' chik re' noq i ruq'asaj i kimayiij i tinamit chi riij taqe kimahk. <verse number="4" style="v" />Ma' awach taj i xa nee rukoj riib' chi kajaaw k'amal kib'eeh aj tiij. Kore' la' Dios insik'wik wach, je' rukab' noq xusik' cho wach i Aarón chi k'amal kib'eeh aj tiij najtir q'iij.</para>
  <para style="p">
    <verse number="5" style="v" />Je' wo' re' i Jesucristo reh ma' xata xukoj riib' chi raJaaw K'amal b'eeh aj tiij. Re' la' Dios xye'wik reh i loq'laj kamanik re' re', ruum re' wo' reh xq'orik cho reh pampeet chi je' wili:</para>
  <para style="b" />
  <para style="q">Re' hat, hat wak'uun, eh re' hin</para>
  <para style="q">xin ye'wik awajaawriik yu'naak, inki.</para>
  <para style="q">
    <verse number="6" style="v" />Eh wilik wo' i xuq'or wii' pan santo laj huuj chi je' wili i xuq'or reh i Rak'uun.</para>
  <para style="q">Re' hat, naa akahniik chi hat kajaaw K'amal kib'eeh aj tiij chi juneliik,</para>
  <para style="q">je' rukab' noq xwihik chaloq i Melquisedec, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" />Noq xk'acharik i Jesucristo ayu' wach ak'al, k'ih pech xub'an rutiij, xuk'er chii' chi kow. Suq suq inoq'ik chupahqaljiik i rotob'il i Dios, re' i wilik wo' naq rajaawriik chuko'ljiik chuwach i ti'laj kimik xuk'ul. Eh x-ib'irjik wo' hoq i rutiij ruum xnimanik chuwach i Dios. <verse number="8" style="v" />Re' Jesucristo, ma' re' ta nkiwii' chi re' reh Ak'uunb'ees Dios, ruuk' taqe ti' k'axik xuk'ul, xutijej chi korik nik' wach runimjiik i Dios. <verse number="9" style="v" />Eh noq rutijem chik riib' chi korik nik' wach i nimanik, ruuk' taqe ti' k'axik xuk'ul, xkahnik chi re' chik i reh aj Ko'len keh chi juneliik chu'nchel i kinimanik reh. <verse number="10" style="v" />Eh re' Dios xupab'aa' i Jesucristo chi raJaaw K'amal b'eeh aj tiij je' rukab' noq xwihik chaloq i Melquisedec.</para>
  <para style="s">Re' runimjiik i Dios yohb'aal chi kanab'jik</para>
  <para style="p">
    <verse number="11" style="v" />Ko wilik naq inqaaj qaq'orom taq reje aweh chi riij taqe i na'ojb'al wili. Xa re' la' chik imb'anik reh k'axik chik ruch'ob'ariik rub'ehel taq aweh, ruum q'e' taq q'uun inareq chi riij. <verse number="12" style="v" />Re' taq i hat, hat naq chik taq aj tijoom, ruum najtir taq inatoq'aa' nimanik. Raaj i wili, ko nawaaj wo' taq chik chi neench'ob'arik rub'ehel taq aweh i ruq'oral i Dios, i xama' k'ayeew ta wo' naq wach. Xanaah re', k'ahchi' wo' chik ruk'isimb'iik taq ak'ux chi nimanik. Xa ko je' wo' taq hat ha'lak'un, i ch'uuch' iraaj chi jilow ruwa'. <verse number="13" style="v" />Eh awach taqe i ko je' ch'uuch' inkiwab'eej, xa ko je' taqe ha'lak'un ma' nkireq ta chi riij nik' wach i korik laj k'acharik naa kianam chupaam i nimanik. <verse number="14" style="v" />Eh re' taqe i kow chik kik'ux chi nimanik, je' naa wi'k chik inye'arik chi k'uxumb'al keh, ruum keht'al chik wach i korik, eh okrinaq chik taqe chureqariik chi riij aha' wilik i holohik, aha' wilik i ma' holohik taj.</para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Eh ma' ta naq xa re' i k'uhtamaj qeh chi riij i Jesucristo neenqatijej riij. Taq la' chi qawach chureqariik chi riij i korik. Manqatijej chik riij nik' wach noq inqayot' qak'ux chi riij i qamahk, nik' wach noq inqakanaa' i yiib' wach na'ojb'al, re' naq ink'amwik qeh pankimik, eh nik' wach noq xoj nimanik, <verse number="2" style="v" />nik' wach i tijinik chi riij i qasanik ha', nik' wach i ruye'ariik i qaq'ab' wach kinaah i aj nimaneel, nik' wach i kiwuktiik cho ruka'peech i kamnaq, nik' wach i kiye'ariik pantojb'al mahk i ma' xkaaj ta runimjiik i Dios. <verse number="3" style="v" />Re' taqe re' naaqa'nam, wila' koxuyeew q'ab' qeh i Dios.</para>
  <para style="p">
    <verse number="4" style="v" />Awach taqe i xkik'ul i rusaqumaal i kina'ojb'al, xkian rusuqkiil i kooch xuyeew i Dios. Eh xiehtrik haa' i ruk'ulariik i Santolaj Uxlab'al. <verse number="5" style="v" />Eh xkian wo' rusuqkiil i chihooj laj ru ak' k'uhb'aal i Dios, je' wo' rib'irjiik i runimaal rajaawriik i Dios naa rub'anam chupaam i k'acharik chalik reh. <verse number="6" style="v" />Wila' xiq'ehb'ik wo' chik pamahk, ma' nkaaj ta chik chi nq'uunjik kiwach chi nee wo' chik inkinimaj i Dios, ruum re' keh je' naa k'ahchi' wo' chik kiye'em wach kuruus ruka'peech i Jesucristo, i Rak'uun i Dios. Eh k'ahchi' kik'uhtaam ruk'ixb'ilaal. <verse number="7" style="v" />Eh re' inkiyeew kik'ux chi nimanik je' kikab' ak'al inqajik i jab' chinaah, eh i rub'an i wach i tik chuwach, iraaj ruq'orom chi nkik'ul i rotob'il i Dios i awach i kitikwik reh. <verse number="8" style="v" />Eh re' inkikanaa' wo' chik i nimanik je' kikab' aak'al xa re' i wiraal k'iix oon xa chib'ih chik jariik chi yiib' wach ch'ahn impoq' chuwach, xama' xta inokik wii'. Re' taqe je' re' kina'ojb'al ilook' kiye'ariik panti' k'axik ruum i Dios, eh naakik'atariik.</para>
  <para style="s">Re' k'ahchi' quy-eem inye'wik rukowiil qak'ux chi nimanik</para>
  <para style="p">
    <verse number="9" style="v" />Hat taq loq'laj hermano, atoob' ta je' wili i xqaq'or taq reje aweh, re' hoj qeht'al chi k'ahchi' taq ak'ulum i rotob'il i Dios, ruum k'ahchi' taq chik areqem i ko'lemb'al reh taq awánima. <verse number="10" style="v" />Re' Dios korik wach ruk'ux. Ma' jaruuj neensahchik paruk'ux i holohik laj na'ojb'al taq a'nam chaloq, je' wo' hoq i kik'axariik taq a'nam ruuk' i kitoob'jiik taqe i santo laj aj nimaneel, eh xakok'ahchi' wo' taq kaat yu'naak. <verse number="11" style="v" />Eh re' hoj nqaaj chi nik' wach noq i nayeew taq ak'ux chi toob'inik yu'naak, je' ta naq re' taq i neena a'n cha ju'junaal korehtaal taq akimiik. Chi je' re', nee taq inak'ul i k'ahchi' taq awuy-eem. <verse number="12" style="v" />Ma' k'ay taq wach i nimanik. Chatijej la' taq awiib' kuuk' i xkiyeew cho kik'ux chi nimanik, eh xkikuy cho ransil i ti' k'axik, eh k'ahchi' kik'ulum i kikooch q'orooj cho rib'iral keh ruum i Dios.</para>
  <para style="p">
    <verse number="13" style="v" />Noq xuq'or cho rib'iral i Dios i xuyeew cho reh i Abraham, xuq'or i xti korik chi rib'il riib', ma' xuq'or taj i xti korik parub'ihnaal i tokoom ruum xa re' wo' reh nim wach. <verse number="14" style="v" />Eh xuq'or cho reh i Abraham chi je' wili: Xti korik re' hin ma' xata k'isiin i wotob'il naa nuye'em cho cha naah. Eh naa nuk'ihaaxb'isam taqe i awiih aamaam, inki. <verse number="15" style="v" />Re' Abraham najt xukuy ruyub'jiik i xq'orarik cho rib'iral reh pampeet ruum i Dios eh korehtaal wo' xuk'ul. <verse number="16" style="v" />Eh inkiq'or i xti korik parub'ihnaal jino'q i winaq nim wach chikiwach i keh. Eh noq ruk'ulum chik kik'ux i xkiyejaa' wach ruuk' i xti korik xkiq'or, inkikanaa' ruwech'jiik riij chi jumpech. <verse number="17" style="v" />Re' Dios xuk'uhtaaj keh i naa kik'ulwiik reh i kooch ruq'orom cho rib'iral chi re' reh chu'nchel ruk'ux chuye'ariik i ruq'orom cho rib'iral pampeet. Eh ma' xujal ta chik wach i xti korik ruq'orom chaloq pampeet. <verse number="18" style="v" />Eh ki'ib' chi na'ojb'al ink'uhtanik qeh chi re' Dios ma' ruchuk taj i q'orik re' taqe i wili: Re' chi ruq'or i xti korik, re' chi ruyeew i ruq'orom cho rib'iral qeh. Ruuk' i re' inqak'ul rusuqkiil qak'ux i qasik'im chik i ko'lb'al qiib' ruuk' i Dios, inqayeew qak'ux chi ruyub'jiik i ch'iklik reje wii' qak'ux. <verse number="19" style="v" />Re' i xye'wik rukowiil qak'ux, eh ma' k'ul ta chik inooj i qakapeew je' rukab' i barco kojooj toob'al reh ma' k'ul ta inooj. Eh k'ahchi' quy-eem i xkojwik i koq qeh ko chi juntar tasb'al paam i wilik cho wii' Dios. <verse number="20" style="v" />Eh re' wo' i xokik wii' Jesucristo najtir reh i rutehariik qab'eeh. Je' re' noq xkahnik i Jesucristo chi raJaaw K'amal b'eeh aj Tiij chi juneliik, je' rukab' noq xwihik chaloq i Melquisedec.</para>
  <chapter number="7" style="c" />
  <para style="s">Re' Jesucristo raJaaw i K'amal b'eeh aj tiij je' rukab' noq xwihik chaloq i Melquisedec</para>
  <para style="p">
    <verse number="1" style="v" />Re' Melquisedec xwihik chi reyil ar Salem, k'amal b'eeh aj tiij parukamaj i Dios nim rajaawriik. Eh xponik ruk'ul i Abraham, xukuxisaj noq xsutinik chaloq chi q'aq'inik, noq xponik rusach kiwach taqe reey. <verse number="2" style="v" />Eh re' Abraham noq xsutinik chaloq chi q'aq'inik chu'nchel i ju'jun xresaj iloq ruuk' i lajtaq xuyeew reh Melquisedec. Re' b'ihnaal Melquisedec peet iraaj ruq'orom reey korik wach ruk'ux. Eh re' chi xwihik chi reyil ar Salem, iraaj ruq'orom chi ye'el suq kiil k'uxliis. <verse number="3" style="v" />Re' Melquisedec, ma' xta rehtalil awach i rutuut rajaaw, awach i rumaam rati't, jank'al inaasjik, eh nik' wach noq xkimik. Eh ruuk' taqe re', re' Melquisedec ink'utinik chi rujalwaach i Rak'uun i Dios, i wilik chi k'amal b'eeh aj tiij chi juneliik.</para>
  <para style="p">
    <verse number="4" style="v" />Chakoj taq rehtaal re', chi re' Melquisedec xiik' naah nimaal rajaawriik noq xwihik chaloq, ruum xye'arik cho reh ruum Abraham i ju'jun i xresaj iloq ruuk' i lajtaq chi xa chib'ih jariik xuq'uch cho keh i reey. <verse number="5" style="v" />Eh re' najtir k'uhb'aal i ruq'or chi re' taqe k'amal b'eeh aj tiij, riih rumaam i Leví taqe, xti rub'ehel chi nkiq'or reh i kuch aj Israel chi kiyeew i ju'jun inkesaj iloq ruuk' i lajtaq chi xa chib'ih jariik i wilik keh. Je' re' inki a'n atoob' ta kuuk' wo' naq kiib' eh riih rumaam i Abraham wo' naq taqe aj Israel. <verse number="6" style="v" />Eh re' Melquisedec reh, atoob' ta ma' re' ruuk' i riih rumaam i Leví, xuq'or reh i Abraham chi chuyeew i ju'jun i resaj iloq ruuk' i lajtaq i xponik ruq'uch. Eh re' Melquisedec xukuxisaj i Abraham, re' i k'ulwinaq cho reh i ruq'orom cho rib'iral i Dios. <verse number="7" style="v" />Eh re' wili qeht'al chi manlik chi awach imb'anik i kuxisanik, re' reh nim rajaawriik chuwach i rukuxisaj. <verse number="8" style="v" />Eh chupaam i k'acharik wili, re' i kipahqanik reh i lajtaq inehteesjik iloq ruuk' i ju'junsiento xa winaq taqe, xakimik keh. Raaj i Melquisedec reh, je' cho xa ko k'achlik wo' hoq noq tz'ihb'amaj rehtalil. <verse number="9" style="v" />Eh re' taqe riih rumaam i Leví, k'amal rub'eeh aj tiij taqe i kik'ulwik reh yu'naak i ju'jun inehteesjik iloq ruuk' i lajtaq chi xa chib'ih jariik, je' wo' naa xkitoj haa' i keh noq xutoj chee Abraham reh i Melquisedec, <verse number="10" style="v" />ruum noq xooj i Melquisedec chuk'ulariik i Abraham, re' Abraham xa ruk'amam wo' chik cho chi raasb'al chi naa kiwihiik riih rumaam, atoob' ta xakomajaa' wo' naq chih rib'iral i kaasjiik.</para>
  <para style="p">
    <verse number="11" style="v" />Re' taqe i k'amal b'eeh aj tiij, re' ruuk' taqe riih rumaam i Leví, xkiq'or wo' chaloq i najtir k'uhb'aal keh i aj Israel. Eh xti korik taj chi xkuyarik i mahk i ruuk' i xkiq'or, ma' koruman ta naq chik chi xpa'ab'jik cho jino'q i k'amal b'eeh aj tiij i ma' re' ta ruuk' i riih rumaam i Aarón, re' la' ruuk' chaloq i Melquisedec. <verse number="12" style="v" />Ruum re' noq injaljik kiwach taqe i k'amal b'eeh aj tiij, koruman wo' chi njaljik wach ruwii' i k'uhb'aal. <verse number="13" style="v" />Eh pan santo laj huuj i ruq'or chi re' QaJaaw Jesucristo chupaam i k'isa junch'uq keh i tinamit Israel xelik chaloq. Eh ma' jino'q keh wihinaq chaloq chi k'amal b'eeh aj tiij, <verse number="14" style="v" />ruum eht'alimaj chi re' QaJaaw Jesucristo ar xelik chaloq chupaam i k'isa tinamit Judá. Eh re' Moisés ma' xuq'or taj chi wilik ta taqe i k'amal b'eeh aj tiij naakeliik cho chupaam i k'isa tinamit re' re'.</para>
  <para style="p">
    <verse number="15" style="v" />Eh re' i Jesucristo ra'j wo' xti xk'utinik re' chi re' reh jinaj ak' K'amal b'eeh aj tiij xpa'ab'jik chi je' rukab' i Melquisedec noq xwihik chaloq. <verse number="16" style="v" />Re' i Jesucristo reh ma' xpa'ab'jik ta cho chi k'amal b'eeh aj tiij chi je' rukab' i ruq'or i xa ruk'uhb'aal winaq. Xpa'ab'jik la' chaloq, ruum wilik rajaawriik, eh wilik ruk'achariik chi juneliik. <verse number="17" style="v" />Ruum i re', xuq'or chee Ajaab'ees Dios chi riij i Jesucristo chi je' wili:</para>
  <para style="b" />
  <para style="q">Re' hat i naa akahniik chi raJaaw K'amal b'eeh aj tiij chi juneliik</para>
  <para style="q">je' rukab' noq xwihik chaloq i Melquisedec, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" />Je' re' noq, re' i k'uhb'aal ye'ooj cho pampeet xkahnik chi ma' xta chik rukamaj, ruum ma' xta rajaawriik, eh ma' xta wo' xutiq wach. <verse number="19" style="v" />Re' najtir k'uhb'aal ma' xumanaa' ta wach i ko'lemb'al iib'. Eh yu'naak wilik chik chi jilow i jinaj re' ch'iklik wii' qak'ux xiik' naah chihojal chuwach i ruyeew i k'uhb'aal, re' re' ink'amwik qeh panotob'il ruuk' i Dios.</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' Dios xuq'or i xti korik chi xkahnik chi k'amal b'eeh aj tiij i Jesucristo. <verse number="21" style="v" />Eh noq xipa'ab'jik taqe i k'amal b'eeh aj tiij ma' xq'orarik taj i xti korik chikiij. Raaj noq xpa'ab'jik i QaJaaw Jesucristo reh,</para>
  <para style="b" />
  <para style="q">xq'orarik i xti korik chi riij,</para>
  <para style="q">ruum pan santo laj huuj i ruq'or chi je' wili</para>
  <para style="q">i xq'orarik reh ruum i Dios:</para>
  <para style="q">Re' hat, xat nukanaa' chi hat k'amal b'eeh</para>
  <para style="q">aj tiij chi juneliik, je' rukab' noq xwihik chaloq i Melquisedec, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" />Eh yu'naak re' chik i Jesucristo inye'wik rajaawriik i ak' k'uhb'aal, xiik' chik naah chihojal chuwach i ruye'em cho pampeet. <verse number="23" style="v" />Re' taqe k'amal b'eeh aj tiij ik'inaq taqe cho najtir xiik' naah kik'ihaal xi ponik. Ma' kahnik ta nkian chi jumpech, ruum re' kimik intoqwik reje rooq i kik'achariik. <verse number="24" style="v" />Raaj i Jesucristo reh, ruum chi ma' naa ta chik rukimiik chi jumpech, ma' awach ta chik neenokik chi rajaaw k'amal b'eeh aj tiij chi jilow. <verse number="25" style="v" />Ruum i re', neerub'an kiko'ljiik chi jumpech awach taqe i k'ahchi' kisik'im i Dios parub'ihnaal i reh. Re' reh neerub'an rupahqaljiik i koq i rotob'il i Dios chikiij taqe aj nimaneel, ruum wilik ruk'achariik chi juneliik.</para>
  <para style="p">
    <verse number="26" style="v" />Re' i Jesucristo i xti manlik raJaaw K'amal b'eeh aj tiij chi qeh. Re' reh santo, ma' xta ru mahk. Eh ma' xta ruch'uwa'iil wach, ma' xub'an ta reh i yiib' wach na'ojb'al. Eh xiik' naah i runimaal wach xye'arik ar pan taxaaj. <verse number="27" style="v" />Re' Jesucristo reh, xa junriim xuq'asaj riib' chi jilow mayiij chi riij i qamahk, ma' xub'an ta reh je' rukab' i xkian taqe kajaaw i k'amal kib'eeh aj tiij junch'uq. Re' keh eqal eqal inkikansaj i k'atoj chikop chi kimayiij. Peet inkiq'asaj chi riij kimahk i keh. Eh rukab' inkiq'asaj i mayiij i chi riij kimahk tinamit. <verse number="28" style="v" />Eh re' najtir k'uhb'aal i rupab'aa' chi rajaaw k'amal b'eeh aj tiij taqe winaq ma' korik ta wach kik'ux. Eh koq'uun chik, chi riij i najtir k'uhb'aal, jinaj i xti korik xuq'or i Dios, re' chi xupab'aa' i Rak'uun chi raJaaw K'amal b'eeh aj tiij, korik wach ruk'ux chi juneliik.</para>
  <chapter number="8" style="c" />
  <para style="s">Re' Jesucristo xk'ulik ye' woq qeh i ak' k'uhb'aal</para>
  <para style="p">
    <verse number="1" style="v" />Re' i xti ajwaal wach k'ahchi' qaq'orom re' wili: Chi re' raJaaw K'amal b'eeh aj tiij chi qee hoj xiik' naah loq'il, ruum tzunlik cho parusak'aaj q'ab' Ajaab'ees Dios, wilik cho wii' paruye'aab' ar pan taxaaj. <verse number="2" style="v" />Eh re' reh, kamanik i rub'an chi k'amal b'eeh aj tiij chupaam i korik laj santo laj ye'aab', re' ruyejaam i QaJaaw Dios ma' re' ta xa winaq xyej-anik reh. <verse number="3" style="v" />Re' taqe k'amal b'eeh aj tiij kipa'ab'jik chuq'ahteesjiik i mayiij chuwach i Dios, eh inkiq'asaj wo' k'atoj chikop. Je' wo' re' i xub'an i Jesucristo reh xuq'asaj wo' riib' chi jilow mayiij chuwach i Dios. <verse number="4" style="v" />Wi ta xkahnik ayu' wach ak'al i Jesucristo, ma' re' ta naq i reh wilik chi k'amal b'eeh aj tiij, ruum ayu' xawilkeeb' wo' taqe i k'amal b'eeh aj tiij i kiq'asaniik reh i mayiij chuwach Dios, je' rukab' i ruq'or i najtir k'uhb'aal. <verse number="5" style="v" />Eh re' i xkian i k'amal b'eeh aj tiij re' re', xa rehtalil peet, xa je' jino'q naach chuwach i xti korik laj loq'oomb'al ree Dios wilik cho pan taxaaj. Ruum re' Moisés, noq ach k'isiin ma' ruyejaa' i paat itz'ihy naah, xq'orarik reh ruum i Dios chi je' wili: Cha a'n ruyejeb'jiik i paat chi korik nik' wach ruwii' i xnuk'uhtaaj chaaweh nah yuuq', Sinaí, i nuchjik. <verse number="6" style="v" />Raaj i raJaaw K'amal b'eeh aj tiij chi qee hoj, xiik' chik naah chihojal rulooq'jiik i Dios i rub'an. Eh ruum ruuk' i ak' k'uhb'aal, xojrukoj panotob'il ruuk' i Dios. Eh re' i xuk'ul cho ruk'ux re' re', xti wilik rajaawriik chuwach i k'uhb'aal ruq'orom cho pampeet.</para>
  <para style="p">
    <verse number="7" style="v" />Wi ta manlik wach i rukamaj xub'an chaloq i peet k'uhb'aal i xuk'ul cho ruk'ux rub'aan i Dios, ma' koruman ta naq chik chi xye'arik chaloq i ak' k'uhb'aal chi jilow. <verse number="8" style="v" />Eh re' Dios xrilow chi ma' korik ta wach kik'ux i tinamiit, tz'ihb'amaj rehtalil chi je' wili i ruq'orom i QaJaaw chikiij:</para>
  <para style="b" />
  <para style="q">Naa ruponiik i q'iij noq jinaj i ak' k'uhb'aal</para>
  <para style="q">naa nuyejaam wach kuuk' aj Israel, i aj Judá.</para>
  <para style="q">
    <verse number="9" style="v" />Ma' je' ta rukab' i xnuyejaa' cho wach kuuk'</para>
  <para style="q">i kimaam kati't, noq ruuk' wajaawriik xnuchop</para>
  <para style="q">cho chi kiq'ab' noq wesaj taqe chaloq ar Egipto.</para>
  <para style="q">Eh ruum chi ma' xkinimaj taj i k'uhb'aal xnuyejaa' cho wach kuuk',</para>
  <para style="q">xnukanaa' taqe chi kutkeel, inki i Dios.</para>
  <para style="q">
    <verse number="10" style="v" />Eh je' wo' chik wili i xuq'or: Re' i ak' k'uhb'aal naa nuyejaam wach kuuk' i aj Israel</para>
  <para style="q">re' chi naa ruponiik i q'iij chi</para>
  <para style="q">naa nuye'em taqe i nuk'uhb'aal pankikapeb'aal,</para>
  <para style="q">eh naa nutz'ihb'aam pan kánima.</para>
  <para style="q">Eh re' chik i hin naa nukahniik chi ki Dios,</para>
  <para style="q">re' keh naakikahiik chi nutinamiit taqe.</para>
  <para style="q">
    <verse number="11" style="v" />Eh ma' kota chik ruman chi</para>
  <para style="q">chi awach naa rutijem i rutinamiit, oon ma' tokoom ta ruuk' oon ruka'jaah chi je' wili:</para>
  <para style="q">Chanab'eej wach i QaJaaw ma' inko'q ta chik,</para>
  <para style="q">keh ruum chu'nchel naakinab'iniik nuwach chi nimaq chi kok' taq.</para>
  <para style="q">
    <verse number="12" style="v" />Re' hin naa nukuyum chu'nchel i kiyiib' wach na'ojb'al,</para>
  <para style="q">eh ma' naa ta chik ruk'uliik cho panak'ux</para>
  <para style="q">chi jumpech i kimahk, inki chaloq i QaJaaw Dios.</para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" />Noq xuq'or cho rib'iral i Dios i jinaj chik ak' k'uhb'aal, iraaj ruq'orom chi re' k'uhb'aal ruyejaam cho wach pampeet xik'ik chik wach. Eh re' i xik'ik chik wach ach k'isiin ma' nsahchik wach.</para>
  <chapter number="9" style="c" />
  <para style="s">Re' paat inlooq'jik wii' i Dios ayu' wach ak'al rujalwaach inlooq'jik wii' ar pan taxaaj</para>
  <para style="p">
    <verse number="1" style="v" />Re' peet k'uhb'aal i ruq'or wo' naq chi tuslik wach i rulooq'jiik i Dios naa rub'aan. Xa re' la' xa chupaam i jinaj itz'ihy naah paat inlooq'jik ayu' wach ak'al. <verse number="2" style="v" />Re' santo laj itz'ihy naah paat inlooq'jik wii' Dios je' wili ruyejeb'jiik b'anooj: Re' peet tasb'al paam wilik i koq panookb'al, Loq'laj Ye'aab' rub'ihnaal. Ar xi wihik i ye'aab' kantela, ruch'ihil i mexa ye'aab' kaxlanwi'k re' inq'ahteesjik chi mayiij. <verse number="3" style="v" />Eh re' i rukab' tasb'al paam i itz'ihy naah paat re' re', ar wilik chaloq i Ye'aab' Xiik' naah Loq'il rub'ihnaal. <verse number="4" style="v" />Ar wo' wilik jinaj i artaal re' ruuk' oro k'atb'al insensia. Ar wilik i loq'laj kaxoon k'ul b'uruuj wach chi oro, je' chi riij, je' chupaam, molb'al reh i peet k'uhb'aal, ar molooj jinaj i xaro re' ruuk' i oro, re' i molik wii' i maná. Eh ar molooj i rukarote i Aarón, i xpoq' cho rutoxl. Eh ar molooj i ki'ib' chi tz'ilom ab'aj re' i tz'ihb'amaj wii' i ru lajeeb' k'uhb'aal i Dios. <verse number="5" style="v" />Chinaah i tz'apb'al naah i loq'laj kaxoon re' re' yej-amaj i je' kiwii' ánjel, rehtalil chi ar wilik i ruloq'il i Dios. Ruuk' i kixiik' inkimujej qohoq i tz'apb'al naah i kaxoon. Xa re' la' yu'naak, manlik pee ruuk' i xqach'ob' rub'ehel chi riij taqe re'.</para>
  <para style="p">
    <verse number="6" style="v" />Chu'nchel-oq chik korjinaq wach aha' naa kianam wii' rulooq'jiik i Dios. Eh re' taqe k'amal b'eeh aj tiij eqal eqal kiokik chub'aan i kikamaj reerulooq'jiiki Dios chupaam i peet tasb'al paam i paat itz'ihy naah. <verse number="7" style="v" />Eh parukab' tasb'al paam i paat re' re', xa re' wo' kajaaw i k'amal b'eeh aj tiij inokik ar, junriim chupaam i haab'. Eh ar ruk'am i koq i rukik'eel wakax, chi rumayiij chi riij ru mahk i reh, eh chi riij i kimahk tinamit inki a'n chi ma' keht'al. <verse number="8" style="v" />Ruuk' i wili i ruyeew qeh chi naab'jik i Santolaj Uxlab'al chi re' peet tasb'al paam i paat noq kore' k'ahchi' cho rukamaniik chi loq'oomb'al ree Dios, re' b'eeh inokik i koq chupaam i Ye'aab' Xiik' naah Loq'il komajaa' ta naq inteharik. <verse number="9" style="v" />Chu'nchel i b'anooj chaloq re' re' xa k'uhtb'al reh chi qawach i hoj yu'naak, ruum re' taqe i mayiij, eh re' taqe mayijimaj chikop inkiq'asaj chuwach i Dios, ma' xub'an ta ruyejeb'jiik i kikapeew awach i je' re' rulooq'jiik i Dios xkian chaloq. <verse number="10" style="v" />Re' taqe re' xa chi riij wi'k ha' inq'orik, i rutz'ajariik kiib', reh chi saq wach i kiti'jolal. Re' taqe i ruq'or i k'uhb'aal re' re' chi koruman chi naa rub'aan i xa reh wach ti'jolal. Eh xa ar xponik i rajaawriik noq xujal cho wach i Dios taqe na'ojb'al re' re'.</para>
  <para style="p">
    <verse number="11" style="v" />Eh re' Jesucristo noq wilik chik ayu' wach ak'al, re' chik i reh i raJaaw K'amal b'eeh aj tiij chinaah i rotob'il i Dios naa ruye'em qeh chi juneliik. Re' Ye'aab' inkamanik cho wii' chi k'amal b'eeh aj tiij xiik' naah loq'il, ma' re' ta kiyej-aniik winaq, ma' re' ta wo' ayu' wach ak'al wilik. <verse number="12" style="v" />Eh noq xokik i koq i Jesucristo chupaam i ye'aab' xiik' naah loq'il ma' re' ta chik rukik'eel kaprax, rukik'eel k'isa imas wakax i xuyeew chi mayiij. Re' la' rukik'eel i reh xuyeew chi jilow mayiij, eh xa junriim xokik i koq, xkahnik ar chi jumpech, xuyeew qako'lb'aal chi juneliik. <verse number="13" style="v" />Eh wila' re' kikik'eel taqe imas wakax, kikik'eel kaprax, eh re' ruchajil i q'ahxoq wakax inkihrjik chikinaah inkich'uwarisaj kiib' ruuk' i mahk, xwihik kajaawriik chusaqb'eesjiik wach i ti'jolal. <verse number="14" style="v" />Ra'j naa chik re' i rukik'eel i Jesucristo ma' chih rajaawriik. Re' i Santolaj Ruxlab'al wilik chi juneliik xtoob'inik reh noq xuq'asaj riib' chi jilow mayiij chuwach i Dios, chi ma' xta k'isinoq ru mahk. Eh re' reh ineesanik iloq reh i yeb'ee wach wilik panqakapeb'aal, reh chi re' chik i k'achlik Dios neenqakamaneej wach.</para>
  <para style="p">
    <verse number="15" style="v" />Ruum aj re', re' Jesucristo xoj rukoj panotob'il ruuk' i Dios ruuk' i ak' k'uhb'aal. Eh ruuk' i ti'laj kimik xuk'ul i Jesucristo, neenkuyarik i kimahk i xinimanik cho reh i peet k'uhb'aal, reh chi neen kik'ul i kikooch reh juneliik i sik'ooj cho kiwach ruum i Dios, re' i kooch ruq'orom cho rib'iral keh. <verse number="16" style="v" />Je' wo' re', i ruhujil jino'q i xa chib'ih jariik neenye'arik chi kooch, kore' neen kamanik reh i huuj re' re' i aj kooch wi xkimik i xyej-anik reh. <verse number="17" style="v" />Re' jino'q ruhujil i xa chib'ih jariik komajaa' ta chi neenkamanik wii' noq ko k'achlik i xyej-anik reh. Kore' neenkamanik reh wila' xkimik reje i xyej-anik reh. <verse number="18" style="v" />Re' peet k'uhb'aal ko ruuk' wo' rukik'eel chikop inye'arik cho chi mayiij xub'an i rukamaj. <verse number="19" style="v" />Eh re' Moisés noq rukohlaam chik ruch'ob'ariik rub'ehel taqe i k'uhb'aal keh chu'nchel i tinamit xuchop chaloq i kaq lana i q'ab' chee' hisopo. Ruuk' taqe re' xukihraaj rukik'eel k'isa imas wakax i rukik'eel tentzun xilakimaj ruuk' ha' chinaah i huuj tz'ihb'amaj wii' taqe i k'uhb'aal, eh je' wo' chikinaah i tinamit. <verse number="20" style="v" />Eh je' wili i xuq'or keh i tinamit: Re' i kik' wili inye'wik rajaawriik taqe i k'uhb'aal ruyejaam cho wach i Dios chi xuyeew taq chaaweh, inki. <verse number="21" style="v" />Eh re' Moisés xukihraaj wo' i kik' chupaam i paat itz'ihy naah inlooq'jik wii' i Dios, je' wo' chikinaah i xa chib'ih jariik kikamanik ar. <verse number="22" style="v" />Je' rukab' i ruq'or chupaam i najtir k'uhb'aal, koruman chi ruuk' i kik' naa rusaqb'eesjiik kiwach inkojarik reh i loq'inik. Eh ma' jaruuj neenkuyarik taqe mahk wi ma' xchihkiljik i kik'.</para>
  <para style="s">Re' ti'laj kimik xuk'ul i Jesucristo ineesanik reh i qamahk</para>
  <para style="p">
    <verse number="23" style="v" />Eh koruman chi ruuk' taqe mayiij re' re' insaqb'eesjik cho kiwach i xa chib'ih jariik xa rehtalil pee i xti korik wilik cho pan taxaaj. Eh re' taqe i xa chib'ih jariik wilkeeb' cho pan taxaaj, koruman wo' chi keh i mayiij q'e' chihooj chuwach i xye'arik cho pampeet, <verse number="24" style="v" />ruum re' i Jesucristo reh ma' xokik ta i koq chupaam jino'q paat loq'oomb'al reh i Dios i xa kiyej-aniik winaq, xa rehtalil i xti korik laj Ye'aab' Xiik' naah Loq'il. Pan taxaaj la' xokik i koq chupahqaljiik i koq i rotob'il i Dios chiqiij i hoj. <verse number="25" style="v" />Eh ma' k'ih pech ta xokik i koq chuq'ahteesjiik riib' chi jilow mayiij, ma' je' ta rukab' inki a'n i kajaaw i k'amal b'eeh aj tiij rajlaal haab'. Eh re' keh tokoom aj kik'eel inkiq'asaj chi mayiij chupaam i Ye'aab' Xiik' naah Loq'il. <verse number="26" style="v" />Wi ta k'ih pech xuq'asaj riib' i Jesucristo chi jilow mayiij, k'ih pech naq kamnaq chaloq i rutz'uhkriik chee wach ak'al. Raaj i wili ma' je' ta re' i xub'an i reh yu'naak pantz'apaab' taqe wach ree q'iij: Re' Jesucristo xa junriim xk'ulik ayu' wach ak'al, eh reh juneliik noq xuq'asaj riib' chi mayiij chi rehtesjiik i mahk. <verse number="27" style="v" />Eh je' rukab' i kanamaj chikinaah i tinamit ayu' wach ak'al, xa junriim kikimik. Eh chi riij i re', re' chik i q'ataj q'orik naa rub'anam i Dios. <verse number="28" style="v" />Je' wo' re' i xb'aan reh i Jesucristo reh, xa junriim xq'ahteesjik chi jilow mayiij reh i rehtesjiik i kimahk i ruk'ihaal tinamit. Chi riij i re', noq naa wo' chik rusutiniik cho ruka'peech, ma' re' ta chik esan reh i mahk, chi kiko'ljiik chi kik'amariik la' chik taqe i k'ahchi' kuy-iniik reh naa ruk'uliik.</para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Re' najtir k'uhb'aal xa je' rukab' naach chuwach i rotob'il i Dios xuyeew koq'uun. Eh majaa' ta re', i re' i xti korik q'orooj cho rib'iral. Ruum aj re', re' k'uhb'aal re' re' ma' xub'an ruyejeb'jiik i kina'ojb'al i kiokik chi loq'inik chuwach i Dios ruuk' i kik'atoj mayiij xa re' wo' ruuk' inkiyeew rajlaal haab'. <verse number="2" style="v" />Wi ta korik chi re' k'uhb'aal xub'an cho rusaqb'eesjiik wach i kánima ruuk' i kimahk, ma' inkik'raaj ta naq chik cho pan kánima chi ko aj mahk taqe. Eh ruuk' i re' xkimay naq cho ruye'ariik i kimayiij. <verse number="3" style="v" />Eh ruuk' la' chik inche mayijinik chikop inki a'n wili, inkib'iraj rib'iral rajlaal haab' chi xa ko aj mahk wo' taqe, <verse number="4" style="v" />ruum re' kikik'eel taqe imas wakax, i kikik'eel taqe imas kaprax ma' xkian cho rusachariik wach taqe mahk.</para>
  <para style="p">
    <verse number="5" style="v" />Ruum aj re', noq xqajik cho wach ak'al i Jesucristo, xuq'or ree Ajaab'ees Dios chi je' wili:</para>
  <para style="b" />
  <para style="q">Re' hat Jaaw, ma' imponik ta chawach i mayiij,</para>
  <para style="q">i k'atoj chikop chi mayiij,</para>
  <para style="q">xayejaa' la' nuti'jolal, reh chi neen kamanik chi jilow mayiij.</para>
  <para style="q">
    <verse number="6" style="v" />Xq'uhtik ak'ux reh i ruk'ohonkiil i mayijimaj chikop,</para>
  <para style="q">je' wo' taqe i xa chib'ih chik jariik chi mayiij chi sachb'al wach i mahk.</para>
  <para style="q">
    <verse number="7" style="v" />Re' hin je' wo' chik wili i xnuq'or:</para>
  <para style="q">WaJaaw nuDios, ayu' wilkiin chub'anariik je' rukab' i ruq'or</para>
  <para style="q">i tz'ihb'amaj cho chi wiij pan santo laj huuj, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" />Re' peet i xuq'or Jesucristo re' chi re' Dios ma' raaj ta chik i ruk'ohonkiil i mayijimaj chikop, je' wo' taqe i xa chib'ih chik jariik chi mayiij. Re' i ruq'or i najtir k'uhb'aal chi naakiye'ariik. <verse number="9" style="v" />Eh je' wo' chik wili i xuq'or i Jesucristo: Re' hin wilkiin chub'anariik inawaaj i hat, inki. Re' reh xk'ulik risaj i rajaawriik i mayijinik chikop tohq'inaq cho najtir, eh jinaj chik ak' mayiij xuyeew chi jilow. <verse number="10" style="v" />Re' Dios xojrukanaa' chi ma' xta chik qamahk, ruum re' Jesucristo xub'an iraaj i Dios, xuyeew i ruti'jolal pankimik chi jilow mayiij, eh xa junriim xuyeew riib' chi mayiij reh juneliik.</para>
  <para style="p">
    <verse number="11" style="v" />Chu'nchel i k'amal b'eeh aj tiij eqal eqal taqe chi loq'inik. Eh wilik pech noq xama' nkijal ta wo' wach i mayiij xa k'ahchi' keeb' chuye'ariik, re' taqe mayiij re' re', xama' jaruuj wo' xkian cho rehtesjiik mahk. <verse number="12" style="v" />Raaj i Jesucristo reh xa jinaj chi mayiij i xuyeew chi tojb'al riij taqe mahk, eh reh juneliik i xub'an re' re'. Eh chi riij i re', xooj tzuhnoq parusak'aaj q'ab' Ajaab'ees Dios ar pan taxaaj. <verse number="13" style="v" />Ar uy-inik i rub'an yu'naak korehtaal i rureq ruq'ijil noq naa ruye'em i Dios ri'si rooq taqe ki-ixowanik wach, <verse number="14" style="v" />ruum re' Jesucristo reh, xa ruuk' i jinaj chi mayiij xuyeew, xukanaa' chi ma' xta chik kimahk taqe i wilik kisantohiil.</para>
  <para style="p">
    <verse number="15" style="v" />Eh re' Santolaj Uxlab'al i ruq'or wo' qeh i korik chi riij i re', noq xuq'or cho chi je' wili:</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Re' taqe wili naa nuyejaam wach kuuk'</para>
  <para style="q">i aj Israel chupaam taqe i q'iij chalik reh,</para>
  <para style="q">inki QaJaaw Dios:</para>
  <para style="q">Naa nuye'em i nuk'uhb'aal pan kánima,</para>
  <para style="q">eh naa nutz'ihb'aam pan kikapeb'aal.</para>
  <para style="q">
    <verse number="17" style="v" />Eh re' hin ma' naa ta chik ruk'uliik panuk'ux</para>
  <para style="q">chi jumpech taqe kimahk,</para>
  <para style="q">je' wo' hoq i kiyiib' wach na'ojb'al, inki.</para>
  <para style="q">
    <verse number="18" style="v" />Je' re' noq, wi kuyuuj, wi sachooj</para>
  <para style="q">chik wach chu'nchel mahk,</para>
  <para style="q">ma' kota chik ruman chi neenye'arik</para>
  <para style="q">taqe mayiij chi riij i mahk.</para>
  <para style="s">Inchol qokiik ruuk' i Dios panotob'il</para>
  <para style="p">
    <verse number="19" style="v" />Je' re' noq re' hoj hermano, yu'naak nee chik inqa a'n okik chupaam Ye'aab' xti wilik rusantohiil chi ma' xta k'isinoq qayo'jiik xa ruum i loq'laj rukik'eel i Jesucristo. <verse number="20" style="v" />Eh nee wo' inqa a'n i koq okik chupaam i b'eeh ko ak'. Re' b'eeh xk'ulik ruteh i Jesucristo ruuk' i ti' k'axik xuk'ul chu ti' jolal wach kuruus, re' noq xih itz'ihy tasb'al paam i ruPaat i Dios. <verse number="21" style="v" />Re' wo' Jesucristo i nim wach K'amal b'eeh aj tiij chi qee hoj, i hoj chik rak'uun rixq'uun i Dios. <verse number="22" style="v" />Ruum aj re', inchol qajilim i koq qiib' ruuk' i Dios chi korik wach qak'ux, eh chi qaye'em qak'ux. Eh nee ta naq inqik'raaj chi ma' xta chik qamahk, ruum rusaqb'isam chik wach i qánima i Jesucristo. Eh je' naa rutz'ajam wach i qati'jolal ruuk' i saq wach ha'. <verse number="23" style="v" />Je' re' noq, kow-oq qak'ux chi nimanik. Maa rub'an kiib' qak'ux chi ruyub'jiik i ch'iklik reje wii' qak'ux, ruum re' Dios reh korik inq'orik, nee wo' ruyeew qeh aha' wilik i ruq'orom cho rib'iral. <verse number="24" style="v" />Inchol wo' qasik'im chi riij nik' wach ruto'ariik qiib' naa qa'nam chi qawach, reh chi neenqak'ax qiib', eh je' wo' rub'anariik i otob'il chi qawach. <verse number="25" style="v" />Eh manqakanaa' taq i rumolariik qiib' chulooq'jiik i Dios, manqatijej qeh inki a'n i ma' nkaaj ta chik kimolom kiib'. K'ul la' qayeew rukowiil qak'ux chi qawach. Eh xti ajwaal wach chi qee hoj i re' yu'naak, ruum ach k'isiin ma' ink'uloq ruka'peech i QaJaaw Jesucristo.</para>
  <para style="s">Re' rukojariik runa'ojb'al i xa paruk'ux inchalik chi rub'an i mahk</para>
  <para style="p">
    <verse number="26" style="v" />Eh wila' xama' xqakanaa' wo' rub'aan i mahk, eh xa pan qak'ux-oq chik neenchalik noq neen qa a'n qeht'al wo' naq chik i xti korik, ma' xta chik jino'q tokoom mayiij i neenye'arik chi kuyb'al reh taqe mahk re' re'. <verse number="27" style="v" />Xa re' la' chik naaquy-eem i q'ataj q'orik naa ruchaliik chi qanaah xiik' naah yohb'alil wach, re' i q'aaq' xiik' naah ti'kiil i ruk'at naakiye'ariik wii' ki-ixowanik wach i Dios. <verse number="28" style="v" />Je' re' imb'aan ruuk' awach i ma' i runimaj taj i ruq'or i najtir k'uhb'aal: Ma' inketeeljik ta wach inkanteesjik, wila' wilik ki'ib' oon ixib'-oq ineekiq'orik i korik chi xmahkunik. <verse number="29" style="v" />¿Mi ma' nakapaaj taq re' hat chi xiik' naah ti'kiil i tojb'al kimahk naakik'ulum i ki-ixowanik wach i Rak'uun i Dios, eh inkich'uwa'reej wach i rukik'eel, re' ineesanik reh i qamahk, re' inye'wik rajaawriik i ak' k'uhb'aal, eh inkib'aj i Ruxlab'al i Dios ink'axwik keh? <verse number="30" style="v" />Re' hoj qeht'al chi je' wili i ruq'orom chaloq i QaJaaw Dios: Re' hin naa nuq'ajwiik wach ree ju'jun chib'ih jariik xub'an, inki. Eh xuq'or wo' i QaJaaw Dios chi je' wili: Re' wo' hin naa nuq'atwiik q'orik chikinaah i nutinamiit, inki. <verse number="31" style="v" />Je' re' noq yohb'aal wach ti'kiil i naa ruk'ulum awach inq'ehb'ik wo' chik pamahk chuwach i k'achlik Dios.</para>
  <para style="p">
    <verse number="32" style="v" />Xa re' la', mansahchik taq panak'ux i xak'ul taq chaloq, noq ko xak'ul taq panawánima i rusaqumaal i Jesucristo. Re' taq i hat, jinaj i runimaal pajarik taq xak'ul, eh ma' xub'an ta taq ki'ib' ak'ux xakuy la' taq ransil. <verse number="33" style="v" />Wilik taq chaxilak i xib'ajarik eh xb'aan ti' k'axik keh chuwach tinamit chi k'uhtb'al kik'ixb'ilaal. Eh wilik wo' taqe i xa xi okik haa' chuk'ulariik i ti' k'axik ye'b'al rukowiil kik'ux i je' re' ti' k'axik xkik'ul chaloq. <verse number="34" style="v" />Xti korik noq re' taq i hat xaketelaaj taq kiwach taq awuch aj nimaneel i xiye'arik pantz'ilom. Eh noq xkiq'uch i chib'ih taq aweh, xama' ti' ta wo' taq xawiik'raaj, ruum aweht'al taq chi xiik' naah chihojal i jilow taq naa ruye'ariik aweh pan taxaaj, re' i ma' jaruuj chik naa rusahchiik wach. <verse number="35" style="v" />Je' re' noq, maaq'eb' taq chi riij ak'ux runimjiik i QaJaaw Dios, ruum re' re' xiik' naah chihojal i jilow taq naa ak'ulum. <verse number="36" style="v" />Re' taq i hat ajwaal wach chi wilik-oq rukowiil taq ak'ux chuk'ulariik ti' k'axik, reh chi nee taq i na a'n iraaj i Dios. Chi je' re' nee taq inak'ul i ruq'orom cho rib'iral i Dios,</para>
  <para style="q">
    <verse number="37" style="v" />ruum pan santo laj huuj i ruq'or chi je' wili:</para>
  <para style="q">Re' chalik reh xa k'isiin chik ma' nk'u'loq.</para>
  <para style="q">Re' reh ma' naa ta ruchamam cho riib'.</para>
  <para style="q">
    <verse number="38" style="v" />Re' i korik wach ruk'ux ruum chi ruye'em</para>
  <para style="q">ruk'ux chunimjiik i Dios naa rureqem i juneliik k'acharik.</para>
  <para style="q">Raaj wi xukanaa' wo' chik i nunimjiik,</para>
  <para style="q">naa ruchaliik nuk'aah chinaah, inki Dios.</para>
  <para style="m">
    <verse number="39" style="v" />Eh re' hoj ma' je' ta qakab' taqe inkikanaa' wo' chik runimjiik i Dios, pantojb'al mahk ojik inki a'n Je' la' qakab' taqe nkireq i ko'lb'al ree kánima, ruum inkiyeew kik'ux chi nimanik.</para>
  <chapter number="11" style="c" />
  <para style="s">Re' ye'ej k'uxliis chi nimanik</para>
  <para style="p">
    <verse number="1" style="v" />Re' ye'ej k'uxliis chi nimanik re' chi ch'iklik qak'ux chi naa qak'ulum i k'ahchi' quy-eem. Re' chi atoob' ta ma' qilow wach qeht'al chi naaqak'ulum. <verse number="2" style="v" />Re' taqe qamaam qati't xa ruum wo' chi xkiyeew cho kik'ux chi nimanik, xelik kib'iral chi holohik xib'anik.</para>
  <para style="p">
    <verse number="3" style="v" />Eh re' hoj xa ruum chi nqayeew qak'ux chi nimanik, inqeht'aliij chi xa ruuk' i ruq'oral i Dios, xuyejaa' chu'nchel i xa chib'ih jariik i wilik. Eh re' inqilow kiwach, xikorb'eesjik ruuk' i ma' nilarik ta naq kiwach.</para>
  <para style="p">
    <verse number="4" style="v" />Re' Abel xa ruum chi xnimanik, xiik' naah chihojal i rumayiij xuyeew chuwach i xuyeew i Caín. Eh ruum i re', xuq'or i Dios chi re' Abel korik wach ruk'ux, xuk'ul reh i rumayiij, atoob' ta kamnaq chik, i je' naa ko k'achlik yu'naak, ruum kok'ahchi' qib'iram rib'iral chi xnimanik.</para>
  <para style="p">
    <verse number="5" style="v" />Eh re' Enoc xa ruum wo' chi xnimanik, xk'amarik johtoq pan taxaaj chi k'achlik wach ruum i Dios, ma' ha' ta chik xkan, ma' xunik'eej ta reh i kimik. Eh pan santo laj huuj i ruq'or chi noq komajaa' ta ink'amarik johtoq, xub'an imponik chuwach i Dios. <verse number="6" style="v" />Eh wila' ma' qaye'em qak'ux ma' nee ta qa a'n imponik chuwach i Dios, ruum awach i ruyeew ruk'ux, koruman chi naa runimam chi k'achlik i Dios. Eh chi nee runimaj chi awach kisik'wik ree Dios, i ruyeew jilow keh.</para>
  <para style="p">
    <verse number="7" style="v" />Eh re' Noé ruum chi xnimanik, xunimaj noq xq'orarik reh ruum i Dios chi chalik reh i ti' k'axik, atoob' ta komajaa' wo' naq ink'ularik. Eh xuyejaa' i kanowa paat ko'lb'al riib' i reh, ruch'ihil taqe i awach reh parupaat. Ruum chi xuyeew ruk'ux, xuyeew taqe panti' k'axik i tinamit, eh xureq rukorkiil wach ruk'ux inkan ruuk' i nimanik.</para>
  <para style="p">
    <verse number="8" style="v" />Re' i Abraham, ruum wo' chi xnimanik, xunimaj noq xq'orarik reh ruum i Dios chi eloq reje paruyuq'ul. Xelik wo' reje, xooj chupaam i ye'aab' i xye'arik reh chi rukooch. Xa re' la' ma' reht'al taj aha' inooj. <verse number="9" style="v" />Eh xa ruum wo' chi xnimanik i Abraham, xpatinik chi xa je' aj patal chupaam i ye'aab' q'orooj cho rib'iral reh ruum i Dios. Re' Abraham, xa re' ruuk' itz'ihy naah paat xpatinik wii'. Eh je' wo' re' ixpatinik cho wii' i Isaac, i Jacob, re' i xk'ulwik reh i ruq'orom cho rib'iral i Dios. <verse number="10" style="v" />Ruum re' Abraham k'ahchi' naq ruy-eem chi naa ruye'ariik reh jinaj i nimlaj tinamit ch'iklik nah tz'aq. Eh re' i aj na'ojb'al i xkorb'isanik reh i tinamit re' re', re' i Dios.</para>
  <para style="p">
    <verse number="11" style="v" />Xa ruum chi xnimanik i Abraham re' i Sara, xwihik jinaj k'isa rak'uun atoob' ta ma' ak'unoom ixoq ta naq, eh k'ih chik i ruhab'ul. Re' Abraham xtoob'jik ruum i Dios chi ko xwihik jinaj i k'isa rak'uun, ruum xunimaj chi re' Dios naa rub'anam i q'orooj cho rib'iral reh pampeet. <verse number="12" style="v" />Re' Abraham, atoob' ta xa k'isiin chik ma' nkimik, ko xiik' naah kik'ihaal i riih rumaam xwihik je' kik'ihaal i ch'umiil wilkeeb' pan taxaaj, eh je' kik'ihaal i saniib' wilkeeb' chi' palaw ma' kuyuuj ta kajaljiik.</para>
  <para style="p">
    <verse number="13" style="v" />Eh chi kunchelaal i re' xa xikimik wo' reje chi ma' xkik'ul taj i ruq'orom cho rib'iral i Dios. Xa re' la', re' keh xkinimaj i Dios, atoob' ta xa je' chi najt xkilow reje wach i q'orooj cho rib'iral keh. Eh xkireq chi riij chi xa je' taqe aj patal noq xi wihik ayu' wach ak'al, xa ik'al b'eeh taqe. <verse number="14" style="v" />Eh re' taqe i kiq'orik reh chi xa ik'al b'eeh taqe, xti nkan chi riij chi ko naa ruye'ariik keh jinaj chik i kiye'aab'. <verse number="15" style="v" />Eh wi ta xkikapaaj chi naa wo' chik kisutiniik reje chupaam i ye'aab' elinaq taqe cho wii', ko xuyee naq riib' chi xi sutinik wo' chik reje ar. <verse number="16" style="v" />Jinaj la' ye'aab' xiik' naah chihojal xkaaj kireqem, re' i ye'aab' pan taxaaj. Ruum aj re', re' Dios ma' jaruuj neenk'ixik chi neeruq'or keh chi re' reh i ki Dios, ruum jinaj i nimlaj tinamit ruyejaam cho keh pan taxaaj.</para>
  <para style="p">
    <verse number="17" style="v" />Xa ruum chi xnimanik i Abraham, xuq'asaj naq chi jilow mayiij i k'isa rak'uun, Isaac rub'ihnaal xa jinaj wo' chi riib' chuwach, noq xnik'ib'jik ruum i Dios. Atoob' ta re' wo' naq i Dios xq'orik cho reh chi naa ruye'ariik reh i rak'uun re' re'. <verse number="18" style="v" />Re' noq xq'orarik cho reh chi je' wili: Ruum i Isaac naa kik'ihaaxb'iik awiih aamaam, i nuchjik. <verse number="19" style="v" />Re' Abraham reht'al chi wilik rajaawriik i Dios chi kiwukteesjiik cho ruka'peech taqe kamnaq. Ruum aj re', ma' xye'arik ta wo' q'ab' reh chi xukansaj i k'isa rak'uun. Re' re', xa jinaj rujalwaach i xuk'uhtaaj chaloq i Dios.</para>
  <para style="p">
    <verse number="20" style="v" />Re' i Isaac reh xa ruum wo' chi xnimanik xuq'or keh i kiib' chi rak'uun re' i Jacob, ruch'ihil i Esaú chi naakik'ulum i rotob'il i Dios koq'uun.</para>
  <para style="p">
    <verse number="21" style="v" />Re' Jacob reh xa ruum wo' chi xnimanik, noq ach k'isiin ma' nkimik, xupahqaaj i rotob'il i Dios chikinaah rak'uun rixq'uun i José. Eh re' Jacob ko xutoob'eej riib' chinaah i rukarote noq xutoq'aa' ruloq'em i Dios.</para>
  <para style="p">
    <verse number="22" style="v" />Re' José, ruum chi xnimanik, noq ach k'isiin ma' nkimik, xuq'or keh i aj Israel chi naakeliik cho Egipto. Eh xukanaa' ruq'orariik keh chi naa kik'amam reje haa' rub'aqil i reh noq naakeliik reje ar.</para>
  <para style="p">
    <verse number="23" style="v" />Xa ruum chi xinimanik rutuut rajaaw i Moisés, ma' xkiyohleej taj i xutaq'aaj ruq'orariik i reey chi naa kikanteesjiik i kok' ak'un k'ahchi' kaasjiik. Re' keh noq x-aasjik i k'isa kak'uun ixib' poh xkikeb'aa', ruum xkilow chi q'e' holohik. <verse number="24" style="v" />Eh xa ruum wo' chi xnimanik Moisés, noq xureq ruwinaqiil, ma' xraaj ta rukojom riib' chi rak'uun i rixq'uun i kireey aj Egipto. <verse number="25" style="v" />Re' la' rukuyariik i ti' k'axik xraaj ruk'ulum haa' i Moisés ruch'ihil taqe rutinamiit i Dios ma' xraaj ta rub'anariik i yiib' wach na'ojb'al xa junk'aam inye'wik suq kiil k'uxliis. <verse number="26" style="v" />Re' i Moisés ma' xraaj ta rub'anam rusuqkiil i rub'ehomal i tinamit Egipto, xraaj la' ruk'ulum reh i ixowaal je' rukab' i xuk'ul i Jesucristo sikooj cho wach. Ruum re' i Moisés xuch'ikaa reje ruk'ux chinaah i rukooch xye'arik koq'uun ruum i Dios. <verse number="27" style="v" />Xa ruum chi xnimanik i Moisés, ma' xyo'jik ta ruum i rujosq'iil i reey noq xelik cho Egipto. Eh ma' xyoj ta ruk'ux chi riij i xukapaaj rub'aan. Xa je' la' chik k'ahchi' rilom wach i Dios xub'an riib', re' i ma' ilooj ta wach. <verse number="28" style="v" />Xa ruum wo' chi xnimanik i Moisés, xub'an i runinq'ijiik i elik chaloq Egipto. Eh xuq'or keh chi kikihraaj i rukik'eel tentzun chuwach i ru puertahiil i kipaat, reh chi ma' xikanteesjik ta jino'q i peet kak'uun i aj Israel ruum i ánjel imb'anik kaansanik.</para>
  <para style="p">
    <verse number="29" style="v" />Re' taqe i aj Israel, xa ruum chi xinimanik xa je' panchiq ak'al ki-ik'ik noq xkiq'at wach chi kooq i kaq palaw. Eh re' taqe aj Egipto xkaaj wo' naq kiq'atam wach i kaq palaw i keh eh jihq'ik chik xponik kian ar.</para>
  <para style="p">
    <verse number="30" style="v" />Re' taqe aj Israel, ruum chi xinimanik, wuquub' q'iij xkisutej riij i tinamit Jericó, eh xq'ehb'ik i tz'aq sutimaj wii' riij i tinamit re' re'. <verse number="31" style="v" />Eh re' Rahab, i k'oyoom laj ixoq, xa ruum wo' chi xnimanik, ma' xkimik ta haa' chi kixilak i ma' xinimanik ta ree Dios, ruum re' reh xuyeew kipatal panotob'il taqe aj Israel xi ponik tahal ye'aab'.</para>
  <para style="p">
    <verse number="32" style="v" />Re' hin, xti ko ma' k'isiin naq inwaaj nuq'orom taq reje aweh. Xa re' la', ma' nee ta manlojik wee q'iij chi neenuq'or nik' wach noq xinimanik taqe winaq je' wili i kib'ihnaal: Gedeón, Barac, Sansón, Jefté, David, Samuel, je' wo' chi riij i kinimanik taqe aj jalal ruq'oral i Dios. <verse number="33" style="v" />Chi kuncheel i re', xa ruum chi xinimanik, xkian cho ruq'uchariik i nimaq taq tinamit. Xkian wo' chaloq i holohik laj na'ojb'al noq xi wihik chi taaq'anik. Xkik'ul wo' hoq i q'orooj cho rib'iral keh ruum i Dios. Xkian wo' cho rutz'apariik i kichii' taqe i kaq b'ahlam. <verse number="34" style="v" />Eh noq xikutarik pa runimaal q'aaq' ma' xik'ahtik ta wo' hoq, xkiko'leej kiib' noq xikanteesjik naq chi q'aslaj ch'ihch'. Xye'arik cho kaansil noq xa nkik'ay naq chik. Eh xwihik cho kajawriik chi q'aq'inik xkian rukanteesjiik i aj q'aq'ineel. <verse number="35" style="v" />Eh wilik taqe ixoq xinimanik, eh q'ahtesjik wo' chik keh kikamnaaq chi k'achlik kiwach. Wilik wo' taqe i ruuk' ti' k'axik xikanteesjik ma' xkaaj ta chi xiko'ljik, re' nkaaj i keh chi na' kiwuktoq chaloq chi k'achlik kiwach, nakireqem jinaj i loq'laj k'acharik. <verse number="36" style="v" />Wilik wo' taqe i xk'uhtjik cho kik'ixb'ilaal. Wilik i xiq'ojib'ik. Wilik i xb'ak'arik cho kooq kiq'ab'. Eh wilik i xiye'arik cho pantz'ilom. <verse number="37" style="v" />Eh wilik i xikutarik chi ab'aj. Wilik i xtararik pankiyejaal ruuk' xera ch'ihch'. Wilik i xikanteesjik chi q'aslaj ch'ihch'. Wilik i k'ul xiooj, xa rutz'uhmal riij tentzun riij kaprax inkikoj chi kiso'. Xa neb'aa' tii taqe, xa eliik ti' kik'ux, eh imb'aan ti' k'axik keh. <verse number="38" style="v" />Re' taqe i xinimanik re' re', ma' ruk'ul ta naq chi xi patinik wach ak'al. Xanaah re', xa aha' ta chik yuuq' ma' xiooj i k'oq chi patinik pantaq chiq yuuq', ju' taq yuuq', pantaq paat ab'aj, eh pantaq ruhopil ak'al.</para>
  <para style="p">
    <verse number="39" style="v" />Eh xama' jino'q wo' keh xik'ulwik cho reh i q'orooj cho rib'iral keh ruum i Dios. Ma' xkik'ul taj, atoob' ta xi elik wo' naq cho korik chuwach i Dios ruuk' i kinimanik. <verse number="40" style="v" />Je' re' xub'an i Dios, ruum wilik cho paruk'ux chi ko naa ruye'em qeh haa' i hoj i jinaj qakooch xiik' naah chihojal, eh xa ruum wo' chi ko hoj haa' i hoj kuuk' i keh, naakik'ulum i ma' xkik'ul ta chaloq pampeet.</para>
  <chapter number="12" style="c" />
  <para style="s">Re' taq qakoj rehtaal nik' wach xub'an chaloq i Jesucristo</para>
  <para style="p">
    <verse number="1" style="v" />Ruum aj re', re' hoj sutimaj qiij kuum i taqe i ruk'ihaal i xik'uhtanik chaloq nik' wach i ye'ej k'uxliis chi nimanik. Ruum aj re' inchol qakanaam rub'aan chu'nchel i mahk injot'wik qeh. Qachop la' qak'ux chi ojik chi qawach ruuk' q'unil je' rukab' i rub'an i aj pajal ajiim. <verse number="2" style="v" />Qayeew taq johtoq inaq'qawach ruuk' i Jesucristo re' inye'wik reh i qanimaniik, eh i rumanaa' wach. Eh ma' xta xraaj reh i ti' i k'ixb'ilaal laj kimik xuk'ul wach kuruus, ruum reht'al i reh, chi naa ruwihiik jinaj runimaal rusuqkiil ruk'ux. Eh xooj tzuhnoq parusak'aaj q'ab' i Dios paruye'aab' ar pan taxaaj.</para>
  <para style="p">
    <verse number="3" style="v" />Je' re' noq re' taq i hat, cha kapaaj taq riij, i xk'ulik ruk'uhtaaj i Jesucristo. Re' reh xukuy i ti' k'axik i ruwech'jiik xb'aan kuum taqe aj mahk, je' wo' chik re' taq i cha a'n i hat chak'uy taq ransil. Matq'uhtik taq, maayoj taq ak'ux chi nimanik, <verse number="4" style="v" />ruum re' taq i hat komajaa' ta awach taq aweh i xuk'ul i ti'laj kimik chuko'ljiik taq awiib' chuwach i mahk. <verse number="5" style="v" />¿Mi xsahchik tii lanik taq panak'ux re' aak'uhb'aaljiik rub'anam chaloq i Dios i hat taq chik rukojom chi rak'uun rixq'uun? Pan santo laj huuj je' wili ruq'or:</para>
  <para style="b" />
  <para style="q">Hat wak'uun noq wilkaat maawixowaaj aak'uhb'aaljiik i rub'an i QaJaaw,</para>
  <para style="q">eh maayoj ak'ux wila' kow xat ruq'il,</para>
  <para style="q">
    <verse number="6" style="v" />ruum re' QaJaaw Dios kow i ruq'il awach i q'e' i ruk'ax,</para>
  <para style="q">eh i rik'saj wo' taqe chi ti' awach taqe i rukoj chi rak'uun rixq'uun, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" />Je' re' noq re' taq i hat hermano, cha kuy taq ruk'ulariik i ti' k'axik. Eh ruuk' i re' nee taq tirukoj chi hat taq manlik rak'uun rixq'uun i Dios. Chakoj taq rehtaal chi ma' jino'q ak'uunb'ees ixq'uunb'ees ma' neentijik ruum i rutuut rajaaw. <verse number="8" style="v" />Raaj wila' ma' xatrutijej taq i Dios i hat je' rukab' rutijiik i rub'an chu'nchel i rak'uun rixq'uun, iraaj ruq'orom chi ma' hat ta taq manlik rak'uun rixq'uun xa je' taq hat moloj ha'lak'un inq'orik wii'. <verse number="9" style="v" />Qakoj taq rehtaal imb'aan cho qeh noq ko hoj kok' taq: Re' taqe qatuut ajaaw yu' wach ak'al qoh kitijej chaloq. Eh qohloch'ik wo' chi kinimjiik. ¿Mi ma' rub'ehel wo' naq re' chi nee qoh loch'ik chuwach i QaJaaw Dios wilik cho pan taxaaj reh chi neenqareq i juneliik k'acharik? <verse number="10" style="v" />Re' taqe qatuut qajaaw ayu' wach ak'al qoh kitijej chupaam i qak'achariik i xa ajlamaj haab', re' q'oreel nik' wach i ruk'ul chi qeh. Raaj i Dios reh qoh rutijej reh jinaj k'axb'al qeh chi korik, reh chi qoh eh haa' i rusantohiil i reh. <verse number="11" style="v" />Xti korik noq inqak'ul i qatijiik ma' suq ta rub'an qeh ti' inqik'raaj. Raaj wila' xqareq chi riij chihreet i qatijiik inqak'ul re' re', inqareq i suq laj k'uxliis koq'uun chi jilow qakooch xti ruk'ul chi qeh.</para>
  <para style="s">Yohb'aal chi ma' nee ta najawjik rib'irjiik i ruq'oral i Dios</para>
  <para style="p">
    <verse number="12" style="v" />Je' re' noq, cha chop wo' chik taq ak'ux chi nimanik, je' rukab' noq i nayeew taq rukowiil aawooq aq'ab' noq xa q'uhtinaq chik. <verse number="13" style="v" />Eh cha sik' wo' taq i korik laj b'eeh, reh chi re' taq aawooq re' i korik nee ruk'am je' naa neenk'achjik.</para>
  <para style="p">
    <verse number="14" style="v" />Chachop taq ak'ux chi wihik pansuqkiil k'uxliis chu'nchel aj uuk'. Eh ti k'acharoq taq pan santohiil, ruum awach i ma' chih santohiil ruuk', ma' jaruuj ta naa rilom wach i QaJaaw Dios. <verse number="15" style="v" />Ma' wach taq aayoj ruk'ux, reh chi ma' awach ta taq jino'q aweh i ma' nee ta ruk'ul i rotob'il i Dios. Mo'-oq je' taq akab' i k'ahlaj raa' ch'ahn i nik' sanik chi ti', eh i rukansaj i tinamit. <verse number="16" style="v" />Mo'-oq awach taq chaxilak i neenk'acharik pan k'oyomal, oon ma' nee ta imponik panaq'wach i q'e' looq', je' rukab' i xub'an i Esaú: Re' reh xa ruum i junriim chi wi'k, xuk'ayej i rukooch xye'arik reh chi riij chi peet ak'un. <verse number="17" style="v" />Eh aweht'al taq i hat chi re' Esaú xraaj naq chik ruk'ulum koq'uun i rotob'il i rajaaw, ma' xk'ulub'jik ta chik reh. Eh atoob' ta yohb'aal wo' naq chik wach oq'ik xub'an chi riij, ma' xkorjik ta chik wach i xuk'ul pampeet.</para>
  <para style="p">
    <verse number="18" style="v" />Re' taq i hat ma' re' ta ruuk' i nimlaj yuuq' inilarik wach xajil taq i koq awiib' je' rukab' ixkijil i koq wii' kiib i aj Israel najtir: Re' nimlaj yuuq' re' re' k'ahtik i rub'an pan xaq q'aaq', panq'equm wilik, eh yohb'aal wach i kaq suut teew chuwach. <verse number="19" style="v" />Eh re' taqe i aj Israel ma' xkib'iraj taj noq xuuljik chaloq i tuun, ni xata xkib'iraj i q'orik xub'an chaloq i Dios. Eh awach taqe i xi ib'irinik reh i xuq'or i Dios, xkipahqaaj otob'il ree Dios chi chumay cho kiq'orob'jiik, <verse number="20" style="v" />ruum xkib'iraj chi ma' nee ta nkian runimjiik i ruq'or i k'uhb'aal xuq'or chaloq i Dios chi je' wili: Wila' x-ilarik chi awach i b'ehik i rub'an chuwach i yuuq' wili, atoob' ta jino'q chikop inchol rukanteesjiik chi ab'aj oon ruuk' q'as ju' ch'ihch', inki. <verse number="21" style="v" />Xti yohb'aal wo' chik wach i xkilow johtoq wach naah yuuq' taqe aj Israel. Je' nare' wo' wili i xuq'or i Moisés reh: Xa kinb'arb'otik chik i hin ruum nuyo'jiik, inki.</para>
  <para style="p">
    <verse number="22" style="v" />Raaj taq i hat, paraa' i nimlaj yuuq' Sión xajil taq i koq awiib', eh chupaam i ru nimlaj tinamiit i k'achlik Dios. Eh xatjiilb'ik taq i koq ruuk' i ak' Jerusaleem wilik cho pan taxaaj, re' i wilkeeb' cho wii' i ruk'ihaal chi ánjel. <verse number="23" style="v" />Eh xamol taq chik awiib' kuuk' taqe i peet cho rak'uun rixq'uun i Dios, re' i tz'ihb'amaj i kib'ihnaal pan taxaaj. Eh xajil taq i koq awiib' i ruuk' i Dios Q'atal Q'orik chikinaah chu'nchel i wilkeeb' wach ak'al. Je' wo' chikinaah i kánjel kit'iosil i atoob' wach kik'ux, re' i korik wach i kik'ux. <verse number="24" style="v" />Eh xajil taq i koq awiib' ruuk' i Jesucristo, re' xk'amwik cho reh i ak' k'uhb'aal, eh re' i loq'laj rukik'eel xtz'ajwik iloq reh i qamahk. Ma' je' ta rukab' i rub'an i rukik'eel i Abel chihkamaj chaloq.</para>
  <para style="p">
    <verse number="25" style="v" />Eh xti chawik'raaj taq awiib' i hat maawixowaaj taq wach i Jesucristo i xq'o'rinik cho qeh, ruum re' taqe i xi-ixowanik reh i Dios noq xuk'uhb'alej taqe ayu' wach ak'al, ma' xkiko'leej ta kiib' chuwach i ti' k'axik. Eh ra'j naa chik re' hoj neenqako'leej qiib' wila' ma' xqib'iraj k'ahchi' ruk'uhb'aliniik cho qeh kopan taxaaj. <verse number="26" style="v" />Eh najtir q'iij, xa ruum i ransil i ruq'oral i Dios xuk'u'yisaj ak'al. Eh yu'naak je' wo' chik wili i ruq'or i Dios: Pan junriim ma' xata chik re' i wach ak'al naa nuk'uyu'sam naa la' nuk'uyu'sam haa' i taxaaj, inki. <verse number="27" style="v" />Noq xuq'or i Dios chi je' wili: Ko junriim chik naa nuk'uyu'sam, inki, ar inkan chi riij chi naa risam pan kiye'aab' nik' nimaal i rutz'uhkrisam chaloq, re' i ruk'ul chi neerisaj pan kiye'aab' ach wo' re' naa rukanaam pan kiye'aab' taqe i ma' naa ta ruk'uyu'jiik. <verse number="28" style="v" />Re' runimaal rajaawriik i Dios i ruyeew qeh ma' nee ta rub'an chi nee nelik paruye'aab'. Eh qat'iosej taq ree Dios i naa rub'anam quuk' wili. Eh qaloq'ej taq i Dios chu'nchel qak'ux. Eh qohloch'ik-oq chuwach i Dios chi loq'oomb'al reh je' rukab' imponik chuwach i reh, <verse number="29" style="v" />ruum re' i qaDios reh je' rukab' i xaq q'aaq' chu'nchel i ruchaajrisaj.</para>
  <chapter number="13" style="c" />
  <para style="s">Re' naa qa'nam aha' wilik imponik chuwach i Dios</para>
  <para style="p">
    <verse number="1" style="v" />Je' re' noq maakanaa' taq chik i korik laj k'axooj chawach. <verse number="2" style="v" />Eh chayeew taq kipatal aawulaa', ruum najtir cho q'iij wilik taqe i xkiyeew rupatal i kulaa', eh ma' keht'al taj chi ánjel xkik'ul pankipaat.</para>
  <para style="p">
    <verse number="3" style="v" />K'oloq taq panak'ux kula'jiik i ye'ooj taqe prexo. Je'-oq hat taq haa' chi prexohjik kuuk' cha a'n taq awiib'. Chatoob'eej taqe i k'ahchi' rub'aan ti' k'axik keh, ruum je'-oq wo' chik re' taq ineenak'ul i hat.</para>
  <para style="p">
    <verse number="4" style="v" />Chayeew taq ruloq'il akaxarohiil je' rukab' i ruq'or i k'uhb'aal. Maa ch'uwa'reej taq wach. Ruum re' Dios naa ruq'atwiik i q'orik chikinaah awach inkich'uwa' risaj wach i kikaxarohiil, je' wo' taqe i ch'aqal wach kaxáro.</para>
  <para style="p">
    <verse number="5" style="v" />Maak'ax taq wach i tumiin. Ch'iklik-oq la' taq ak'ux ruuk' chib'ih jariik i wilik taq aweh, ruum re' Dios je' wili i xuq'or: Re' hin ma' jaruuj naa nukanaam atoob'jiik. Eh ma' naa ta wo' kaat nuq'eb'em cha wutkeel, inki. <verse number="6" style="v" />Je' re' noq re' hoj nee chik inqaq'or chi chu'nchel qak'ux chi je' wili:</para>
  <para style="b" />
  <para style="q">Re' hin re' QaJaaw Dios intoob'inik weh,</para>
  <para style="q">ruum aj re' ma' kinyo'jik ta ruum chib'ih jariik i neerub'an weh i xa winaq, qoh ko'q.</para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" />K'oloq taq panak'ux i xi k'amwik taq chaa b'eeh, re' i xiq'orik taq cha weh i ruq'oral i Dios. Chakoj taq rehtaal nik' wach noq xkikohlaaj i kik'achariik, re' keh ma' xyoj ta kik'ux chi nimanik. Je' wo' re' inchol taq a'nam i hat.</para>
  <para style="p">
    <verse number="8" style="v" />Re' Jesucristo reh xama' jaljinaq ta wo' wach i rajaawriik, nik' wach cho najtir q'iij, xa je' wo' re' yu'naak, xa je' wo' re' chi juneliik. <verse number="9" style="v" />Re' taq i hat, maayeew taq awiib' chi jot'arik ruuk' i xa chib'ih chik jariik chi nimanik netikitijej taq wii' ma' xta la' reet chi ruuk' i rotob'il i Dios neenqak'ul rukowiil i qánima chuwach chi neenqatijej qeh i na'ojb'al xa chi riij wi'k ha' inq'orik, ruum re' taqe i xib'anik cho reh i na'ojb'al re' re', xama' xta xutiq cho wach keh.</para>
  <para style="p">
    <verse number="10" style="v" />Re' hoj wilik jinaj i qamayiij xye'arik chiqiij ma' jaruuj neerub'an chi neenkik'ux je' rukab' noq inkik'ux chaloq i mayijimaj chikop taqe i k'amal kib'eeh aj tiij najtir chupaam itz'ihy naah paat. <verse number="11" style="v" />Ruum re' i kikik'eel taqe i chikop re' re', inye'arik chi mayiij chi riij i mahk re' kajaaw i k'amal kib'eeh aj tiij ink'amwik i koq chupaam i Ye'aab' Xiik' naah Loq'il. Eh re' i kiti'jolal i taqe chikop re' re' ko najt ruuk' i tinamit ink'atarik reje. <verse number="12" style="v" />Je' wo' re' i xb'aan reh i Jesucristo. Ko najt ruuk' i tinamit Jerusaleem xponik xkikansaj, reh chi ruuk' i ruloq'laj kik'eel xuchihkaaj, xukanaa' chi wilik kisantohiil taqe rak'uun rixq'uun. <verse number="13" style="v" />Eh re' hoj, inchol wo' qak'ulum qeh i ti' k'axik xuk'ul i Jesucristo. Je'-oq rukab' noq xkesaj reje ko najt ruuk' i tinamit Jerusaleem neenkian qee hoj, <verse number="14" style="v" />ruum ayu' wach ak'al ma' jino'q i tinamit nee qoh wihik chupaam chi juneliik. Re' la' k'ahchi' quy-eem jinaj tinamit naa ruye'ariik qeh pan taxaaj. <verse number="15" style="v" />Je' aj re' noq inchol qaye'em ruloq'il i Dios chi eliik parub'ihnaal i Jesucristo. Re' loq'inik wili jilow qamayiij chuwach i Dios, qaloq'ej taq ruuk' qachii' <verse number="16" style="v" />Re' taq i hat, mansahchik taq panak'ux i rub'aan otob'il chawach. Eh k'ul taq chawunej awiib' i chib'ih i wilik taq aweh, ruum re' taqe wili imponik chuwach i Dios, eh je' jilow qamayiij chuwach.</para>
  <para style="p">
    <verse number="17" style="v" />Tinimanoq taq chikiwach i kik'amwik taq ab'eeh. Eh cha a'n taq i neenkiq'or taq aweh, ruum re' keh ma' kihi'lik ta taq chak'uhb'aljiik, ruum keht'al chi naakiq'asam ponoq chuwach i Dios. Chachop taq ak'ux chi kitoob'jiik, reh chi neensuuqb'ik kik'ux chub'aan. Ruum re' kikamaj neentoob'inik taq aweh.</para>
  <para style="p">
    <verse number="18" style="v" />Hermano, inqapahqaaj taq aweh chi cha a'n taq chaa tiij chiqiij, ruum re' hoj ma' xta reet inqakapaaj. Ruum re' hoj inqaaj qa'nam chu'nchel i ma' xta reet chi b'anarik. <verse number="19" style="v" />Inupahqaaj taq reje otob'il aweh chi cha a'n taq chaatiij chi wiij i hin, reh chi nee ruyeew q'ab' weh i Dios chi nee wo' chik kinooj chi jumehq'iil taq chaawuuk'.</para>
  <para style="s">Rupahqaljiik i rotob'il i Dios, ye'ej suq kiil k'uxliis xkuxik wii' wach rutz'ihb'jiik i huuj wili</para>
  <para style="p">
    <verse number="20" style="v" />Re' Dios inye'wik suq kiil k'uxliis. Re' reh i x-uksanik cho reh i Jesucristo chi k'achlik wach, re' i nim wach laj aj cha'joom, eh ruuk' i loq'laj rukik'eel xuchihkaaj xuyeew rajaawriik i ak' k'uhb'aal ruyejaam cho wach i Dios. <verse number="21" style="v" />Re' ta naq i Dios neenmananik wach taq ana'ojb'al ruuk' chu'nchel i holohik chi b'anarik, reh chi nee taq i na a'n imponik chuwach i reh. Eh chub'an ta naq cho quuk' parub'ihnaal i Jesucristo iraaj i reh paruk'ux. Re' i Jesucristo qayeew runimaal ruloq'il chi juneliik Je' ta wo' naq re'.</para>
  <para style="p">
    <verse number="22" style="v" />Hermano, i nupahqaaj taq reje otob'il aweh chi cha kuy taq rilariik chib'ih ruq'or i ma' k'ih ta laj q'orik xnutz'ihb'aaj taq reje chi q'ilb'al taq aweh. <verse number="23" style="v" />Chanab'eej taq chi re' qahermano Timoteo xteharik chik cho pantz'ilom. Wila' xk'u'loq ayu' chi jumehq'iil, naa nuk'amam reje chi wiij na' kinohoq taq cha wilariik.</para>
  <para style="p">
    <verse number="24" style="v" />Chayeew taq rusuqkiil kik'ux chu'nchel i kik'amwik taq ab'eeh, eh je' wo' chu'nchel i santo laj rutinamiit i Dios. Re' taqe hermano aj Italia, i wilkeeb' ayu', xkitaq'aaj wo' taq reje rusuqkiil ak'ux i keh.</para>
  <para style="p">
    <verse number="25" style="v" />Re' ta naq i rotob'il i Dios chuyeew taq cho cha naah chawunchelaal. Je' ta wo' naq re'.</para>
</usx>