<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="NUM" style="id">NUMPOK.SFK 26-09-2,007. Adelina Quej X. Pocomchi. Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">NUMEROS</para>
  <para style="toc3">Num</para>
  <para style="toc2">Num</para>
  <para style="toc1">NUMEROS</para>
  <para style="mt2">RE' I RUKAAJ RUHUUJ I MOISES</para>
  <para style="mt1">NUMEROS</para>
  <chapter number="1" style="c" />
  <para style="s">Re' i kitz'ihb'jiik taqe i aj Israel ar Sinaí</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios xuq'oreej i Moisés chinaah i chiq yuuq' Sinaí chupaam i santo laj itz'ihy naah paat molb'al iib', chupaam i k'amb'al rub'eeh i rukab' poh reh i rukab' haab' keliik chee i aj Israel pan tinamit Egipto, je' wili i xuq'or reh: <verse number="2" style="v" />Re' hat awuch'ihil i Aarón naa taq awik'sam jinaj i tz'ihb' chikinaah i tinamit Israel, chi kich'uhqaal taq naa a'nam, eh chupaam i ju'jun chi paat taq naa atz'ihb'aam i kib'ihnaal i ju'jun chi winaq nab'al reh jarub' chi kiib'. <verse number="3" style="v" />Re' taqe i aj juninaq haab', je' wo' taqe ik'inaq juninaq haab' re' taqe i manlik chik chi nee kiooj panq'aq'inik akab'cheel taq ruuk' i Aarón naa apech'em je' rukab' imb'aan pankuartel. <verse number="4" style="v" />Eh jinaj i k'amal kib'eeh naa taq apab'aam i wilkeeb' chupaam i ju'jun ch'uq chi tinamit. <verse number="5" style="v" />Re' i k'amal kib'eeh naakitowiik taq aweh chupaam i ju'jun ch'uq chi tinamit, je' wili i kib'ihnaal:</para>
  <para style="p">Re' taqe riih rumaam Rubén. Re' i Elisur rak'uun i Sedeur naa ruk'atwiik kib'eeh.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' taqe i riih rumaam Simeón. Re' Selumiel rak'uun i Zurisadai i naa ruk'atwiik kib'eeh.</para>
  <para style="p">
    <verse number="7" style="v" />Eh re' taqe i riih rumaam i Judá. Re' i Naasón rak'uun i Aminadab naa ruk'amwiik kib'eeh.</para>
  <para style="p">
    <verse number="8" style="v" />Eh re' taqe i riih rumaam Isacar, re' Natanael rak'uun i Zuar, naa ruk'amwiik kib'eeh.</para>
  <para style="p">
    <verse number="9" style="v" />Eh re' taqe i riih rumaam i Zabulón, reh Eliab, rak'uun i Helón naa ruk'amwiik kib'eeh.</para>
  <para style="p">
    <verse number="10" style="v" />Eh re' taqe i riih rumaam i José, re' i Elisama rak'uun Amiud naa ruk'amwiik kib'eeh. Eh re' taqe i riih rumaam i Efraín, re' i Gamaliel rak'uun Pedasur naa ruk'amwiik kib'eeh. Eh re' wo' re' naa ruk'amwiik kib'eeh i riih rumaam Manasés.</para>
  <para style="p">
    <verse number="11" style="v" />Eh re' taqe i riih rumaam i Benjamín, re' i Abidán rak'uun i Gedioni, naa ruk'amwiik kib'eeh.</para>
  <para style="p">
    <verse number="12" style="v" />Eh re' taqe i riih rumaam Dan, re' i Ahiezer rak'uun i Amisadai naa ruk'amwiik kib'eeh.</para>
  <para style="p">
    <verse number="13" style="v" />Eh re' taqe i riih rumaam Aser, re' Pagiel rak'uun i Ocrán naa ruk'amwiik kib'eeh.</para>
  <para style="p">
    <verse number="14" style="v" />Eh re' taqe riih rumaam i Gad re' Eliasaf rak'uun i Deuel naa rukahniik chi k'amal kib'eeh.</para>
  <para style="p">
    <verse number="15" style="v" />Eh re' taqe riih rumaam Neftalí re' i Ahira rak'uun i Enán naa ruk'amwiik kib'eeh.</para>
  <para style="p">
    <verse number="16" style="v" />Re' taqe i wili kib'ihnaal i xsik'arik i kiwach i chi k'amal kib'eeh chupaam i kitinamiit i ju'jun ch'uq chi aj Israel reh chi kiju'junaal xkik'am chee kitinamiit.</para>
  <para style="p">
    <verse number="17" style="v" />Eh re' i Moisés, ruch'ihil i Aarón xkitaq'aaj ruk'amariik taqe i winaq xipa'ab'jik chi k'amal b'eeh, re' xq'orarik i kib'ihnaal. <verse number="18" style="v" />Eh xkimol wach chu'nchel i tinamit chupaam i k'amb'al rub'eeh i rukab' poh. Eh chi ch'uhqaal xkiyeew re' q'oreel awach i kituut kajaaw, eh xi ajaljik, xi tz'ihb'jik i kib'ihnaal taqe i aj juninaq haab', je' wo' taqe i ik'inaq juninaq haab'. <verse number="19" style="v" />Eh re' i Moisés xrajlaaj wo' taqe chinaah i chiq yuuq' Sinaí xub'an wo' hoq i xq'orarik reh ruum i QaJaaw Dios.</para>
  <para style="p">
    <verse number="20" style="v" />Re' chi kixilak i riih rumaam Rubén, re' peet cho rak'uun i Israel, xi ajaljik pankipaat. Eh xtz'ihb'jik i kib'ihnaal chi kiju'junaal taqe i winaq wilik keh i juninaq haab', je' wo' taqe ik'inaq juninaq haab', re' taqe i manlik chik chi nakojiik panq'aq'inik. <verse number="21" style="v" />Re' i tz'ihb'jik i kib'ihnaal re' re' xi ponik waq'iib' roxk'ahl miil ruuk' hoob' siento chi winaq.</para>
  <para style="p">
    <verse number="22" style="v" />Eh chi kixilak i riih rumaam Semeón xi ponik tz'ihb'joq pankipaat ruuk' i kituut kajaaw chu'nchel i winaq wilik keh juninaq haab', je' wo' taqe ik'inaq juninaq haab'. Re' taqe i manlik nakojiik panq'aq'inik. <verse number="23" style="v" />Re' taqe i xtz'ihb'jik i kib'ihnaal re' re' xi ponik b'elejlaj roxk'ahl miil ruuk' ixib' Siento chi winaq manlik nakojiik panq'aq'inik.</para>
  <para style="p">
    <verse number="24" style="v" />Eh chi kixilak i riih rumaam i Gad, xi ponik wo' tz'ihb'joq pankipaat ruuk' i kituut kajaaw, chu'nchel winaq wilik keh juninaq haab', je' wo' taqe ik'inaq juninaq haab'. <verse number="25" style="v" />Re' taqe i xtz'ihb'jik i kib'ihnaal re' re' xi ponik hoob'roxk'ahl miil ruuk' waqiib' siento, ruuk' lajeeb' roxk'ahl chi winaq manlik chik chi nakojiik panq'aq'inik.</para>
  <para style="p">
    <verse number="26" style="v" />Eh chi kixilak i riih rumaam Judá xi ponik tz'ihb'joq pankipaat ruuk' i kituut kajaaw chu'nchel i wilik keh juninaq haab', je' wo' taqe ik'inaq juninaq haab'. <verse number="27" style="v" />Re' taqe i tz'ihb'jik i kib'ihnaal re' re' xi ponik kajlaj rukajwinaq miil ruuk' waqiib' siento chi winaq manlik nakojiik panq'aq'inik.</para>
  <para style="p">
    <verse number="28" style="v" />Eh chi kixilak i riih rumaam Isacar xi ponik tz'ihb'joq pankipaat ruuk' i kituut kajaaw chu'nchel i winaq wilik keh i juninaq haab', je' wo' taqe ik'inaq juninaq haab'. <verse number="29" style="v" />Re' taqe i xi ponik tz'ihb'joq i kib'ihnaal re' re' xi ponik kajlaj roxk'ahl miil ruuk' kijib' siento chi winaq manlik naa kojiik panq'aq'inik.</para>
  <para style="p">
    <verse number="30" style="v" />Eh chi kixilak i riih rumaam Zabulón xi ponik tz'ihb'joq pankipaat ruuk' i kituut kajaaw chu'nchel i winaq wilik keh i juninaq haab', je' wo' taqe ik'inaq juninaq haab'. <verse number="31" style="v" />Re' taqe i xtz'ihb'jik i kib'ihnaal re' re' xi ponik wuqlaj roxk'ahl miil ruuk' kijib' siento chi winaq manlik chik chi nakojiik panq'aq'inik.</para>
  <para style="p">
    <verse number="32" style="v" />Eh kitz'ihb'aaj wo' hoq chi kixilak i riih rumaam i José, je' wo' chi kixilak riih rumaam Efraín xi ponik ka'winaq miil ruuk' hoob' siento chi winaq i manlik chik naa kojiik panq'aq'inik. <verse number="33" style="v" />Re' taqe i xi ponik tz'ihb'joq i xi ajaljik chi kixilak i riih rumaam Efraín, xi ponik ka'winaq miil ruuk' hoob' siento chi winaq. <verse number="34" style="v" />Eh chi kixilak i riih rumaam Manasés xi ponik tz'ihb'joq i xi ajaljik chupaam i kipaat ruuk' i kituut kajaaw taqe i winaq wilik keh i juninaq haab', je' wo' taqe ik'inaq juninaq haab'. <verse number="35" style="v" />Eh re' taqe i tz'ihb'jik i kib'ihnaal xi ponik kab'laj ru ka'winaq miil ruuk' kiib' siento chi winaq i manlik naa kojiik panq'aq'inik.</para>
  <para style="p">
    <verse number="36" style="v" />Eh chi kixilak i riih rumaam Benjamín xi ponik tz'ihb'joq pankipaat, ruuk' i kituut kajaaw chu'nchel i winaq wilik keh i juninaq haab', je' wo' taqe ik'inaq juninaq haab'. <verse number="37" style="v" />Re' taqe i xi tz'ihb'jik i kib'ihnaal re' re' xi ponik ho'lajuuj ru ka'winaq miil ruuk' kijib' siento, chi winaq i manlik chik chi naa kojiik panq'aq'inik.</para>
  <para style="p">
    <verse number="38" style="v" />Eh chi kixilak i riih rumaam i Dan xi ponik tz'ihb'joq pankipaat ruuk' i kituut kajaaw chu'nchel i winaq wilik keh i juninaq haab', je' wo' taqe ik'inaq juninaq haab'. <verse number="39" style="v" />Eh re' taqe i tz'ihb'jik i kib'ihnaal re' re' xi ponik kiib' ru kajwinaq miil ruuk' wuquub' siento chi winaq i manlik naa kojiik panq'aq'inik.</para>
  <para style="p">
    <verse number="40" style="v" />Eh chi kixilak i riih rumaam Aser xi ponik tz'ihb'joq pankipaat ruuk' i kituut kajaaw, chu'nchel i winaq wilik keh i juninaq haab', je' wo' taqe ik'inaq juninaq haab'. Re' taqe i manlik chi nee kiooj panq'aq'inik. <verse number="41" style="v" />Re' taqe i tz'ihb'jik i kib'ihnaal re' re' xi ponik jinaj roxk'ahl miil ruuk' hoob' siento chi winaq.</para>
  <para style="p">
    <verse number="42" style="v" />Eh chi kixilak i riih rumaam Neftalí xi ponik tz'ihb'joq i kib'ihnaal ruuk' i kituut kajaaw pankipaat chu'nchel i winaq wilik keh i juninaq haab', je' wo' taqe ik'inaq juninaq haab'. Re' taqe i manlik chi nakojiik panq'aq'inik. <verse number="43" style="v" />Re' tz'ihb'jik i kib'ihnaal re' re' xi ponik oxlaj roxk'ahl miil ruuk' kijib' siento chi winaq.</para>
  <para style="p">
    <verse number="44" style="v" />Re' taqe i winaq wili xi ajaljik ruum i Moisés ruch'ihil i Aarón kuch'ihil taqe i kab'laj chi k'amal b'eeh, ju'jun k'amal kib'eeh i ju'jun ch'uq chi riih rumaam i Israel. <verse number="45" style="v" />Eh chu'nchel i winaq xi ponik tz'ihb'joq i kib'ihnaal chi kixilak i aj Israel re' wilik keh i juninaq haab', je' wo' taqe ik'inaq juninaq haab' manlik naa kojiik panq'aq'inik. <verse number="46" style="v" />Xiponik waqiib' siento miil ruuk' ixib' miil ruuk' hoob' siento ruuk' lajeeb' roxk'ahl chi manlik.</para>
  <para style="s">Re' i kipa'ab'jik taqe i aj Levíta</para>
  <para style="p">
    <verse number="47" style="v" />Eh re' taqe i aj Levíta keh ma' xtz'ihb'jik taj i kib'ihnaal chi kixilak i kuch aj Israel jun ch'uq. <verse number="48" style="v" />Ruum re' i QaJaaw Dios je' wili i xuq'or cho reh i Moisés pampeet: <verse number="49" style="v" />Noq naa atz'ihb'aam, noq naa awajlaam taqe i aj Israel ma' naa ta kojom haa' taqe i, riih rumaam Leví. <verse number="50" style="v" />Re' taqe i aj Levíta naa apab'aam chub'anariik i kamanik chupaam i santo laj itz'ihy naah paat moloj wii' k'uhb'aal. Eh re' keh naa kilwiik reh, naakik'amwiik reje reh chu'nchel inkamanik parukamaj i Dios. Eh noq naa rujaljiik ruye'aab' i santo laj itz'ihy naah paat i Dios re' wo' keh naakik'amwiik reje reh. Eh chi junsuut i santo laj itz'ihy naah paat naa kiyejaam reje ki-itz'ihy naah paat i keh. <verse number="51" style="v" />Eh noq neenjalarik ruye'aab' i santo laj itz'ihy naah paat molooj wii' i k'uhb'aal re' wo' taqe i aj Levíta naakiyojwiik reje reh. Eh re' wo' chik i keh naakiyej-aniik reh aha' naa rukorjiik. Eh wila' awach i tokoom tz'a'inik reh i santo laj itz'ihy naah paat xa chupaam i jumehq' re' re' naa rukanteesjiik. <verse number="52" style="v" />Eh re' taqe i riih rumaam Israel naa kiyejaam i ki-itz'ihy naah paat chi kich'uhqaal je' rukab' inki a'n i soldado, eh kuch'ihil taqe i ki soldado, eh ruuk' i koq i kipaat naakijosam ju' chee' i itz'ihy kehtalil. <verse number="53" style="v" />Eh re' taqe i aj Levíta keh chi junsuut i santo laj itz'ihy naah paat moloj wii' i k'uhb'aal naa kiwihiik. Re' keh naa kicha'jiniik reh, reh chi ma' nee ta nchalik rujosq'iil i Dios chikinaah i aj Israel, inki.</para>
  <para style="p">
    <verse number="54" style="v" />Eh re' taqe i aj Israel xkian wo' chu'nchel i aha' wilik i xuq'or i QaJaaw Dios, reh i Moisés.</para>
  <chapter number="2" style="c" />
  <para style="s">Re' i QaJaaw Dios xuq'or chi ch'uhqaal naa kiwihiik i aj Israel</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés, i Aarón: <verse number="2" style="v" />Re' taqe i aj Israel naakiyejaam i ki-itz'ihy naah paat chi junsuut i santo laj itz'ihy naah paat molb'al iib', xa re' la' najt k'isinoq naakijilim reje. Eh chi kich'uhqaal nakijosam taxaaj itz'ihy k'uhtb'al reh awach chee kituut kajaaw.</para>
  <para style="p">
    <verse number="3" style="v" />Re' taqe i riih rumaam i Judá ar panreelb'aal i q'iij naa kiyejaam i ki-itz'ihy naah paat. Eh naakijosam taxaaj itz'ihy kehtalil, eh re' i Naasón rak'uun i Aminadab naa ruk'amwiik kib'eeh i ki soldado. <verse number="4" style="v" />Eh re' i xi tz'ihb'jik xi ponik kajlaj ru kajwinaq miil ruuk' waqiib' siento chi soldado. <verse number="5" style="v" />Eh chi kicheel i re' naa kiyejaam i ki-itz'ihy naah paat taqe i riih rumaam i Isacar, re' Natanael rak'uun i Zuar, naa ruk'amwiik kib'eeh i ki soldado. <verse number="6" style="v" />Eh re' i xi tz'ihb'jik xi ponik kajlaj roxk'ahl miil ruuk' kijib' siento chi soldado. <verse number="7" style="v" />Eh chi kicheel i riih rumaam i Isacar naa kiyejaam i ki-itz'ihy naah paat i riih rumaam Zabulón rak'uun i Eliab rak'uun i Helón naa ruk'amwiik kib'eeh i ki soldado. <verse number="8" style="v" />Eh re' i xi tz'ihb'jik xi ponik wuqlajroxk'ahl miil ruuk' kijib' siento chi soldado. <verse number="9" style="v" />Eh chi kixilak i riih rumaam Judá ox ch'uq chi tinamit i naakimolom kiib' naakimanlojiik jinaj siento miil ruuk' waqiib' ro'k'ahl miil ruuk' kijib' siento chi soldado. Re' taqe re' naa kojiik chi peet b'eeh chikiwach i aj Israel.</para>
  <para style="p">
    <verse number="10" style="v" />Eh re' taqe i riih ruum i Rubén pansak'aaj reh i rookb'aal q'iij naakiyejaam i ki-itz'ihy naah paat. Eh nakijosam taxaaj i itz'ihy kehtalil, eh re' Elisur rak'uun i Sedeur naa ruk'amwiik kib'eeh i ki soldado. <verse number="11" style="v" />Eh re' i xi tz'ihb'jik xi ponik waqiib' roxk'ahl miil ruuk' hoob' siento chi soldado <verse number="12" style="v" />Chucheel i riih rumaam i Rubén naa kiyejaam i ki-itz'ihy naah paat i riih rumaam i Simeón. Eh re' i Selumiel rak'uun Zurisadai naa ruk'amwiik kib'eeh i ki soldado. <verse number="13" style="v" />Eh re' i xi tz'ihb'jik i xi ponik b'elejlaj roxk'ahl miil ruuk' ixib' siento chi soldado <verse number="14" style="v" />Eh chi kicheel wo' i koq i re' xkiyejaa' i ki-itz'ihy naah paat taqe i riih rumaam i Gad, eh re' i Eliasaf rak'uun i Reuel xk'amwik kib'eeh i ki soldado. <verse number="15" style="v" />Eh re' i xi tz'ihb'jik xi ponik hoob' roxk'ahl miil ruuk' i waqiib' siento ruuk' lajeeb' roxk'ahl chi soldado <verse number="16" style="v" />Eh chi kixilak i riih rumaam i Rubén oxch'uq chi tinamiit i naakimolom kiib', naakiponiik jinaj siento miil ruuk' junlaj roxk'ahl miil ruuk' kijib' siento ruuk' lajeeb' roxk'ahl chi soldado, re' taqe re' nakojiik chi peet b'eeh reh i ruka'chuuq.</para>
  <para style="p">
    <verse number="17" style="v" />Chi riij taqe re' xam taqe reje b'eeh i aj Levíta panyejaal kajch'uq chi tinamit naa kik'amam reje i santo laj itz'ihy naah paat molb'al iib'. Eh tuslik kiwach noq naa kojiik, eh reh reh wach itz'ihy kehtalil, naa kik'amam reje.</para>
  <para style="p">
    <verse number="18" style="v" />Eh re' taqe i riih rumaam Efraín panookb'al q'iij reje naa kiyejaam i ki-itz'ihy naah paat, ar naakijosam taxaaj i itz'ihy kehtalil, eh re' Elisama rak'uun i Amiud i k'amal kib'eeh i ki soldado. <verse number="19" style="v" />Eh re' i xi tz'ihb'jik chi kixilak xi ponik ka'winaq miil ruuk' hoob' siento chi soldado <verse number="20" style="v" />Eh chi kicheel i riih rumaam Efraín naa kiyejaam i ki-itz'ihy naah paat taqe i riih rumaam Manasés. Eh re' i Gamaliel rak'uun i Pedasur, i k'amal kib'eeh i ki soldado. <verse number="21" style="v" />Re' taqe i xi tz'ihb'jik xi ponik kab'laj ru ka'winaq miil ruuk' kiib' siento chi soldado re' i Gamaliel xk'amwik kib'eeh. <verse number="22" style="v" />Eh chi kicheel wo' i riih rumaam i Manasés naa kiyejaam i ki-itz'ihy naah paat i riih rumaam Benjamín. Eh re' i Abidán rak'uun i Gedioni i k'amal kib'eeh i ki soldado. <verse number="23" style="v" />Eh re' i xitzi'hb'jik xi ponik ho'lajuuj ru ka'winaq miil ruuk' kijib' siento chi soldado <verse number="24" style="v" />Eh chi kixilak i riih rumaam Efraín naakimolom kiib' ox ch'uq chi tinamit naakimanlojiik jinaj siento miil ruuk' waxiqiib' miil ruuk' jinaj siento chi soldado chi kunchelaal re' i naa kojiik chi peet b'eeh reh paroox ch'uq.</para>
  <para style="p">
    <verse number="25" style="v" />Eh re' taqe i riih rumaam i Dan pantz'eet reh i rookb'aal i q'iij naa kiyejaam ki-itz'ihy naah paat, ar naakijosam taxaaj i itz'ihy kehtalil, eh re' Ahiezer rak'uun i Amisadai i k'amal kib'eeh i ki soldado. <verse number="26" style="v" />Eh re' i xi tz'ihb'jik xi ponik kiib' rukaj k'ahl miil ruuk' wuquub' siento chi soldado <verse number="27" style="v" />Eh chi kicheel wo' i riih rumaam i Dan, naa kiyejaam i ki-itz'ihy naah paat i riih ruum i Aser. Eh re' i Pagiel rak'uun i Ocrán i k'amal kib'eeh i ki soldado. <verse number="28" style="v" />Eh re' i xi tz'ihb'jik xi ponik jinaj roxk'ahl miil ruuk' hoob' siento chi soldado <verse number="29" style="v" />Eh chi kicheel wo' i riih rumaam i Dan naa kiyejaam i ki-itz'ihy naah paat taqe i riih rumaam Neftalí. Eh re' i Ahira rak'uun i Enán i k'amal kib'eeh i ki soldado. <verse number="30" style="v" />Eh re' i xi tz'ihb'jik xi ponik oxlaj roxk'ahl miil ruuk' kijib' siento chi soldado <verse number="31" style="v" />Eh re' taqe i riih rumaam i Dan xi tz'ihb'jik xi ponik jinaj siento miil ruuk' wuqlaj roxk'ahl miil ruuk' waqiib' siento chi soldado Re' naa kojiik chi xam b'eeh, chi riij i kitz'ihy kehtalil.</para>
  <para style="p">
    <verse number="32" style="v" />Eh chu'nchel i aj Israel xi tz'ihb'jik xi ponik waqiib' siento miil ruuk' ixib' miil ruuk' hoob' siento ruuk' lajeeb' roxk'ahl chi soldado <verse number="33" style="v" />Xa re' la' nik' wach i xuq'or i QaJaaw Dios reh i Moisés chi ma' naa ta rajaljiik haa' taqe i aj Levíta ma' xi ajaljik ta wo' taqe haa'.</para>
  <para style="p">
    <verse number="34" style="v" />Re' taqe i aj Israel xkian wo' chu'nchel i xuq'or i QaJaaw Dios reh i Moisés, chi kich'uhqaal wo' hoq xkiyejaa' i ki-itz'ihy naah paat, eh kijosaj wo' taxaaj i itz'ihy kehtalil. Eh xkib'esaj wo' reje chi kich'uhqaal i kitinamiit kuch'ihil taqe awach keh.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' i ruk'ul chi naa kianam i aj Levíta</para>
  <para style="p">
    <verse number="1" style="v" />Eh chupaam i q'iij noq xq'orob'jik i Moisés ruum i QaJaaw Dios chinaah i yuuq' Sinaí wilik taqe rak'uun i Aarón, je' wo' hoq i Moisés. <verse number="2" style="v" />Re' i Aarón je' wili i kib'ihnaal taqe i rak'uun. Nadab b'ih i aasb'ees, eh Abiú, Eliazar, Itamar. <verse number="3" style="v" />Eh kikajcheel xipa'ab'jik xikuxeesjik ruuk' aseite reh chi xi kahnik chi k'amal kib'eeh aj tiij. <verse number="4" style="v" />Xa re' la' re' Nadab re' Abiú xikimik ruum tokoom inaq'wach q'aaq' i xkikoj chi k'atb'al kimayiij chuwach i QaJaaw Dios chupaam i ye'aab' chiq yuuq Sinaí. Eh ruum chi ma' xta kak'uun, xa re' chik i Eliazar Itamar xi kahnik chi kamanik chi k'amal kib'eeh aj tiij. Eh re' i Aarón i kajaaw ink'amwik kib'eeh.</para>
  <para style="p">
    <verse number="5" style="v" />Eh re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="6" style="v" />Re' hat cha taq'aaj kik'amariik i aj Levíta reh chi nee kipa'ab'jik chi k'amal kib'eeh aj tiij, eh neenkitow i Aarón re' i kajaaw k'amal kib'eeh aj tiij. <verse number="7" style="v" />Eh naa kitowom i Aarón noq naa rub'anam i kamanik kuuk' chu'nchel i aj Israel panookb'al reh i nuSanto laj itz'ihy naah paat molb'al iib'. Eh naa wo' kitowiik chub'aan i kamanik chupaam i rusanto laj itz'ihy naah paat i Dios. <verse number="8" style="v" />Eh re' keh naa kicha'jiniik reh i chu'nchel i kikamanik chupaam i nuSanto laj itz'ihy naah paat molb'al iib'. Eh naa wo' kitowiik chub'aan i kamanik naa rub'aan kuuk' chu'nchel i aj Israel chupaam i santo laj ye'aab'. <verse number="9" style="v" />Eh naa aq'asam taqe i aj Levíta reh i Aarón ruch'ihil taqe i rak'uun, reh chi naa kitowom chub'anariik i kamanik kuuk' i aj Israel. <verse number="10" style="v" />Eh re' hat naa apab'aam i Aarón ruch'ihil taqe i rak'uun chi k'amal kib'eeh aj tiij. Ruum wila' awach i xub'an i rukamaj i k'amal kib'eeh aj tiij chi ma' pab'amaj taj naa rukanteesjiik.</para>
  <para style="s">Re' i QaJaaw Dios xuq'or chi re' taqe i aj Levíta re' reh inehchanik keh</para>
  <para style="p">
    <verse number="11" style="v" />Re' i QaJaaw Dios je' wili xuq'or reh i Moisés: <verse number="12" style="v" />Re' hin xnusik' kiwach i aj Levíta chi kixilak i aj Israel chi jilow i peet kak'uun i aj Israel, ruum aj re', re' hin kinehchanik keh i aj Levíta. <verse number="13" style="v" />Re' taqe i aj Levíta re' hin kinehchanik keh, ruum re' taqe i ki-aasjik chi peet re' hin kinehchanik keh xaruchaliik chi je' re' noq kuxik taqe nukansam i peet kak'uun i aj Egipto. Eh xnuko'leej kiij chi weh taqe i peet kak'uun i aj Israel. Eh chi peet kak'uun i tinamit, eh chi peet kak'uun i chikop re' hin kinehchanik keh, hin Dios inki.</para>
  <para style="s">Re' i kajaljiik i aj Levíta</para>
  <para style="p">
    <verse number="14" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés chupaam i chiq yuuq' Sinaí: <verse number="15" style="v" />Re' hat chawik'saj jinaj i tz'ihb' chikinaah i aj Levíta ajlaamb'al keh jarub' chi kiib' pankipaat, eh chi kich'uhqaal. Eh naa awajlaam taqe i kok' kak'uun wilik jinaj poh keh, eh ik'inaq taqe jinaj poh, inki. <verse number="16" style="v" />Eh re' i Moisés xik'saj wo' hoq i tz'ihb' ajlaamb'al keh i aj Levíta je' rukab' i xq'orarik reh ruum i QaJaaw Dios.</para>
  <para style="p">
    <verse number="17" style="v" />Re' taqe i rak'uun i Leví je' wili i kib'ihnaal: Gersón, i Coat, i Merari.</para>
  <para style="p">
    <verse number="18" style="v" />Eh re' taqe rak'uun i Gersón je' wili kib'ihnaal: Libni, Simei.</para>
  <para style="p">
    <verse number="19" style="v" />Eh re' taqe i rak'uun i Coat je' wili i kib'ihnaal: Amram, Izahar, Hebrón, Uziel.</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' taqe rak'uun i Merari je' wili i kib'ihnaal: Mahli, Musi, re' taqe i riih rumaam Leví chi kich'uhqaal ruuk' i kituut kajaaw pankipaat.</para>
  <para style="p">
    <verse number="21" style="v" />Eh re' Gersón rumaam rati't taqe chaloq i riih rumaam Libni je' wo' taqe i riih rumaam Simei. <verse number="22" style="v" />Chu'nchel i winaq xi tz'ihb'jik, ruuk' i kituut kajaaw pankipaat xi okik haa' i kok' kak'uun kore' jinaj poh wilik keh xi ponik wuquub' miil ruuk' hoob' siento chikuncheel. <verse number="23" style="v" />Eh re' taqe i riih rumaam i Gersón panookb'al reh i q'iij naa kiyejaam reje i ki-itz'ihy naah paat chi riij reje i santo laj itz'ihy naah paat. <verse number="24" style="v" />Eh re' taqe i riih rumaam i Gersón, re' i Eliasaf rak'uun i Lael k'amal kib'eeh. <verse number="25" style="v" />Eh re' taqe i riih rumaam Gersón kicha'jinik reh i santo laj itz'ihy naah paat molb'al iib', je' wo' hoq i tz'uhuum b'urb'al naah taqe i chib'ih jariik. Eh je' wo' hoq i itz'ihy wilik i koq chii' tz'ahp panookb'al reh i santo laj itz'ihy naah paat molb'al iib'. <verse number="26" style="v" />Eh re' wo' keh naa kicha'jiniik reh i itz'ihy kojooj chi chii' i paat, je' wo' hoq i itz'ihy wilik panookb'al reh i chii' i wilik chi junsuut i santo laj itz'ihy naah paat. Re' wo' keh naa kichajinik reh i artaal, je' wo' taqe i k'ahaam, inkamanik ar.</para>
  <para style="p">
    <verse number="27" style="v" />Eh re' i Coat re' chaloq i rumaam rati't, Amram, i Ishar, i Hebrón, je' wo' hoq i Uziel. <verse number="28" style="v" />Eh chu'nchel winaq xi tz'ihb'jik ruuk' i kituut kajaaw, eh xi okik haa' taqe i kok' ak'un kore' jinaj poh i wilik keh xi ponik waxiqiib' miil ruuk' waqiib' siento. Eh re' taqe i re' kicha'jinik reh i santo laj ye'aab'. <verse number="29" style="v" />Eh re' taqe i riih rumaam i Coat chucheel i santo laj itz'ihy naah paat pansak'aaj reh i rookb'aal i q'iij naa kiyejaam i ki-itz'ihy naah paat. <verse number="30" style="v" />Eh re' taqe i k'ih ch'uq re' re', re' i Elizafán rak'uun i Uziel k'amal kib'eeh. <verse number="31" style="v" />Eh re' keh naa kicha'jiniik reh i loq'laj kaxa moloj wii' i k'uhb'aal, i mexa, i ye'aab' kantela, i artaal, chu'nchel i xa chib'ih jariik kuxisamaj i kikamanik chupaam i rukamaj i Dios, i itz'ihy tasb'al.</para>
  <para style="p">
    <verse number="32" style="v" />Eh re' i xti manlik k'amal kib'eeh i aj Levíta re' Eleazar, re' rak'uun i Aarón k'amal kib'eeh aj tiij. Re' k'amal kib'eeh re' re' incha'jinik keh, i kicha'jinik reh i santo laj itz'ihy naah paat.</para>
  <para style="p">
    <verse number="33" style="v" />Eh re' taqe i riih rumaam i Merari, re' Mahlita, re' i Musita. <verse number="34" style="v" />Eh chu'nchel i winaq i xi tz'ihb'jik, xi okik haa' i kok' ak'un jinaj poh i wilik keh xi ponik waqiib' miil ruuk' kiib' siento. <verse number="35" style="v" />Eh re' i k'amal kib'eeh taqe i re', re' Zuriel rak'uun i Abihail, eh parucheel i santo laj itz'ihy naah paat pantz'eet reh i rookb'aal i q'iij naa kiyejaam i ki-itz'ihy naah paat. <verse number="36" style="v" />Eh re' taqe i riih rumaam i Merari naa kicha'jiniik reh taqe i rutz'ilomaal i santo laj itz'ihy naah paat, taqe ruche'el, taqe i ch'iklik wii' taqe i rooq, taqe i kulk, je' wo' chu'nchel i xa chib'ih jariik inkamanik ar. <verse number="37" style="v" />Eh re' wo' keh naa kicha'jiniik reh i chee' koralimaj wii' riij i paat, taqe i ch'iklik wii' taqe i kok' chee' tikooj panak'al, taqe i k'ahaam b'ak'lik wii' i santo laj itz'ihy naah paat.</para>
  <para style="p">
    <verse number="38" style="v" />Eh re' i Moisés, i Aarón i taqe i rak'uun i Aarón chuwach i santo laj itz'ihy naah paat molb'al iib', parelb'aal q'iij reje naa kiyejaam i ki-itz'ihy naah paat. Eh re' keh naa kicha'jiniik reh i santo laj ye'aab' pankib'ihnaal i aj Israel. Eh awach i xub'an i rukamaj i k'amal kib'eeh i aj tiij chi ma' pab'amaj taj i ruk'ul chi naa rukanteesjiik.</para>
  <para style="p">
    <verse number="39" style="v" />Eh noq re' i Moisés, i Aarón xkik'saj i tz'ihb' xi ponik kiib' ru ka'winaq miil chu'nchel i winaq xi ajaljik haa' taqe kok' ak'un jinaj poh i wilik keh.</para>
  <para style="s">Re' i rutojariik kiij taqe i peet ak'un</para>
  <para style="p">
    <verse number="40" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés:</para>
  <para style="p">Re' hat cha tz'ihb'aaj i kib'ihnaal chu'nchel i peet kak'uun i aj Israel, eh naa taqe akojom haa' i kok' ak'un kore' jinaj poh i wilik keh. <verse number="41" style="v" />Eh re' taqe i aj Levíta nee nakanaa' taqe chi weh chi jilow taqe i peet kak'uun i aj Israel. Eh re' i kichikoop i aj Levíta nee nakanaa' taqe chi weh chi jilow i peet rak'uun i kichikoop i aj Israel. Re' wili re' hin i Dios kinq'orik reh, inki.</para>
  <para style="p">
    <verse number="42" style="v" />Eh re' i Moisés xutz'ihb'aaj wo' kib'ihnaal chu'nchel i peet kak'uun i aj Israel, je' rukab' i xq'orarik reh ruum i QaJaaw Dios. <verse number="43" style="v" />Eh chu'nchel i peet kak'uun i aj Israel xi tz'ihb'jik xi okik haa' taqe i kok' ak'un kore' wilik keh i jinaj poh xi ponik kiib' ru ka'winaq miil ruuk' kiib' siento ruuk' oxlaj rukaj winaq.</para>
  <para style="p">
    <verse number="44" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="45" style="v" />Eh re' taqe i aj Levíta naa taqe akanaam chi weh jilow taqe i peet kak'uun i aj Israel. Eh re' i kichikoop i aj Levíta naa taqe akanaam chi weh chi jilow i peet rak'uun kichikoop taqe i aj Israel. Xti korik chi hin kinehchanik keh i aj Levíta i hin, hin Dios. <verse number="46" style="v" />Xa re' la' re' taqe i peet kak'uun i aj Israel xiik' naah kik'ihaal chikiwach i aj Levíta. Re' taqe i kiib' siento ruuk' oxlaj ru kajwinaq chi aj Israel xik'ik chinaah i aj Levíta koruman chi naa rutojariik i kolb'al kiib'. <verse number="47" style="v" />Eh re' hat koruman chi naa apahqaam i ho'oob' chi tumiin re' ruuk' i plata je' rukab' i rupajariik i tumiin imb'aan parupaat i QaJaaw chi tojb'al riij i ju'jun chi winaq re' re'. <verse number="48" style="v" />Eh naa aye'em i tumiin re' re' reh i Aarón, eh keh i rak'uun chi tojb'al kiij aj Israel, inki i QaJaaw Dios.</para>
  <para style="p">
    <verse number="49" style="v" />Eh re' Moisés xumol wo' hoq i tumiin kuuk' i aj Israel tojb'al riij i ko'lemb'al keh i peet kak'uun i aj Israel nik' k'ihaal i ki-ik'ik chikinaah i aj Levíta. <verse number="50" style="v" />Re' i Moisés xuk'ul kuuk' i aj Israel jinaj miil ruuk' ixib' siento ruuk' hoob' ru kajwinaq chi tumiin re' ruuk' i plata, je' rukab' rupajariik i tumiin imb'aan parupaat i Dios. <verse number="51" style="v" />Eh re' i Moisés xuq'asaj i tumiin re' re' reh i Aarón, keh i rak'uun, je' wo' rukab' i xq'orarik reh ruum i Dios.</para>
  <chapter number="4" style="c" />
  <para style="s">Re' i kikamaj naa kianam i aj Levíta</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wo' chik wili i xuq'or reh i Moisés, i Aarón: <verse number="2" style="v" />Re' hat naa atz'ihb'aam naa awajlaam pankipaat kuuk' i kituut kajaaw chu'nchel i riih rumaam i Coat re' ruuk' taqe i aj Levíta. <verse number="3" style="v" />Naa rukuxiik taqe awajlaam i winaq wilik keh i lajeeb' ru ka'winaq haab', eh komponik lajeeb' roxk'aahl haab' i wilik keh. Eh re' taqe i nee ruk'ul chi naakikamaniik chupaam i santo laj itz'ihy naah paat molb'al iib'.</para>
  <para style="p">
    <verse number="4" style="v" />Re' kamanik naa kianam taqe i riih rumaam i Coat chupaam i santo laj itz'ihy naah paat molb'al iib', q'e' looq', re' taqe wili: <verse number="5" style="v" />Noq naakijalam kiye'aab' i aj Israel, re' i Aarón, re' taqe i rak'uun naakesaniik reh i itz'ihy tasb'al wilik panookb'al reh itz'ihy naah paat, eh naa kikojom chib'urb'al naah i loq'laj kaxa moloj wii' i k'uhb'aal. <verse number="6" style="v" />Eh chinaah i itz'ihy re' re' naa kikojom jinaj i ch'ub'ik wach tz'uhuum. Eh chinaah i re' naa kikojom jinaj i itz'ihy raxmuqik inka'yik, xa junsahl chuwii'. Eh naa kikojom i chee' k'amb'al reh iloq laj kaxa. <verse number="7" style="v" />Eh naa kihe'em wach itz'ihy rax muqik inka'yik chinaah i mexa, eh chinaah i re' naakiye'em taqe i pulato, taqe i nimaq cucharo, taqe i kulk, taqe i xaro ye'aab' reh i riis uuva inye'arik chi mayiij. Eh naakiye'em chinaah i kaxlanwi'k chi juneliik. <verse number="8" style="v" />Eh chinaah chu'nchel i re' naa kitz'apam naah chi kaq itz'ihy, eh naa wo' chik kitz'apam naah ruuk' i ch'ub'ik wach tz'uhuum. Eh naa kikojom i chee' tehlb'al reh. <verse number="9" style="v" />Eh naa kik'amam chaloq itz'ihy rax muqik inka'yik naakib'urum chinaah i ye'aab' kantela, taqe i saqumb'al, taqe i lach' kinaah ch'ihch', taqe i kok' pulato, taqe i kulk inkamanik chi ye'aab' aseite reh i saqumb'al. <verse number="10" style="v" />Eh chu'nchel i re' naakib'urum chupaam jinaj i ch'ub'ik wach tz'uhuum, eh naa kikojom ruche'el k'amb'al reje reh.</para>
  <para style="p">
    <verse number="11" style="v" />Eh naa kib'urum itz'ihy rax muqik inka'yik chinaah i artaal oro. Naakib'urum chupaam taqe i ch'ub'ik wach tz'uhuum, eh naa kikojom ruche'el k'amb'al reje reh. <verse number="12" style="v" />Eh naakimolom wach i kulk, je' wo' chu'nchel i chib'ih jariik inkamanik parusanto laj itz'ihy naah paat i Dios. Eh naakib'otom chupaam itz'ihy rax muqik inka'yik, naakib'otom chupaam i ch'ub'ik wach tz'uhuum, naa kikojom ruche'el k'amb'al reje reh. <verse number="13" style="v" />Eh re' i artaal naakijuxum i q'ina', i chaaj chinaah. Chi riij i re' naakitz'apam naah ruuk' itz'ihy rax muqik inka'yik. <verse number="14" style="v" />Eh naakiye'em chinaah i artaal chu'nchel inkamanik reh loq'inik. Re' taqe i ye'aab' naah wach q'aaq, taqe i lach' ch'ihch', taqe i likb'al, taqe i nimaq kulk. Eh chu'nchel i re' naakitz'apam naah ruuk' i ch'ub'ik wach tz'uhuum, eh naa kikojom ruche'el k'amb'al reje reh. <verse number="15" style="v" />Eh noq re' i Aarón, eh taqe i rak'uun kib'otom chik wach chu'nchel i q'e' looq' kikamanik wii', noq kiyejaam chik kiib' reh i ruk'amariik, re' taqe i riih rumaam i Coat naakik'amwiik reje reh chu'nchel i re'. Xa re' la' ma' naa ta kitz'a'am ruuk' kiqab' taqe i wilik ruloq'il reh chi ma' nee ta kikimik. Eh chu'nchel i kikamanik chupaam i santo laj itz'ihy naah paat molb'al iib', naa kik'amam reje. <verse number="16" style="v" />Eh re' i Eliazar i rak'uun i Aarón i k'amal kib'eeh aj tiij naa rucha'jiniik reh i aseite inkamanik reh saqumb'al, i insensia q'e' ink'ohnik, i chi naq'wach inkiyeew chi kimayiij elik. Eh re' wo' reh naa rucha'jiniik reh aseite inkamanik chi kuxesb'al, je' wo' hoq itz'ihy naah paat, chu'nchel i wilik chupaam, taqe i kikamanik chupaam, inki QaJaaw Dios.</para>
  <para style="p">
    <verse number="17" style="v" />Eh re' i QaJaaw Dios je' wili i xuq'or reh i Moisés, i Aarón: <verse number="18" style="v" />Re' taq i hat ma' naa ta taq aye'em q'ab' chi naa rusahchiik kiwach taqe i riih rumaam i Coat chi kixilak i aj Levíta. <verse number="19" style="v" />Eh reh chi ma' nee ta inkitz'aj i wilik kiloq'il, eh chi ma' nee ta kikimik je' taq wili i naa a'nam: Re' hat Moisés awuch'ihil i Aarón awuch'ihil taqe rak'uun naa taq awokiik chupaam i santo laj ye'aab', re' taq i hat naa aq'oriik keh i riih rumaam i Coat chib'ih i naa kianam, chib'ih i naa kik'amam reje. <verse number="20" style="v" />Chi je' re', re' keh ma' nee ta nkijil i koq kiib' chi rilariik taqe i wilik kiloq'il, eh ma' nee ta wo' kikimik, inki i Dios.</para>
  <para style="p">
    <verse number="21" style="v" />Eh re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="22" style="v" />Re' hat naa awik'sam i tz'ihb' pankipaat chi kich'uhqaal ruuk' i kituut kajaaw taqe i riih rumaam Gersón. <verse number="23" style="v" />Naa rukuxiik awajlaam taqe i winaq wilik keh i lajeeb' ru ka'winaq haab', eh koneen ponik lajeeb' roxk'ahl haab'. Re' taqe i nee ruk'ul chi neenkian i kamanik chi k'amal b'eeh aj tiij chupaam i santo laj itz'ihy naah paat molb'al iib'.</para>
  <para style="p">
    <verse number="24" style="v" />Eh re' i kamanik naa kianam taqe i riih rumaam i Gersón re' taqe wili: <verse number="25" style="v" />Naa kik'amam reje i santo laj itz'ihy naah paat molb'al iib', ruch'ihil itz'ihy tasb'al, ruch'ihil imb'urarik wii' naah i xa chib'ih jariik, ruch'ihil i ch'ub'ik wach tz'uhuum b'urb'al naah taqe i naa ruk'amariik reje, ruch'ihil itz'ihy wilik chi tasb'al panookb'al reh i santo laj itz'ihy naah paat molb'al iib'. <verse number="26" style="v" />Eh re' wo' keh naakik'amwiik reje reh taqe itz'ihy tasb'al reje chi' paat, je' wo' hoq itz'ihy wilik panookb'al reh i chi' paat, re' sutimaj wii' riij itz'ihy naah paat, i artaal, taqe i k'ahaam imb'ak'arik wii' taqe itz'ihy je' wo' i chu'nchel inkamanik taq aweh reh nukamaj panupaat. <verse number="27" style="v" />Eh re' hat naa akojwiik keh pankikamaj taqe i riih rumaam i Gersón, eh re' i Aarón, re' taqe i rak'uun naa ruch'ob'wiik rub'ehel keh naa rucha'jiniik keh ruuk' chu'nchel i naa kianam, eh chib'ih i naa kik'amam reje. <verse number="28" style="v" />Re' taqe wili i kamanik naa kianam i riih rumaam i Gersón chupaam i santo laj itz'ihy naah paat molb'al iib'. Eh re' i naa rukahniik chi k'amal kib'eeh re' Itamar rak'uun i Aarón k'amal kib'eeh aj tiij.</para>
  <para style="p">
    <verse number="29" style="v" />Eh naa wo' atz'ihb'aam, taqe pankipaat ruuk' i kituut kajaaw chu'nchel i riih rumaam i Merari. <verse number="30" style="v" />Eh naa rukuxiik taqe awajlaam i winaq wilik keh i lajeeb' ru ka'winaq haab', eh komponik lajeeb' roxk'ahl haab'. Re' taqe i ruk'ul chi nee kikamanik chupaam i santo laj itz'ihy naah paat molb'al iib'. <verse number="31" style="v" />Re' i kikamaj naa kianam, re' i ruk'amariik taqe reje i rutz'ilomaal i santo laj itz'ihy naah paat molb'al iib', ruch'ihil taqe i ruq'e'liik i santo laj itz'ihy naah paat, ruch'ihil taqe i rooq, ruch'ihil taqe i ch'ikaab' reh. <verse number="32" style="v" />Eh re' wo' keh naakik'amwiik reje taqe i chee' kotimaj wii' riij i chii' i paat i molarik wii' iib', i ch'iklik wii', taqe i k'ahaam inkamanik chi b'ak'b'al, taqe i kok' chee' kib'ak'ariik wii' naa wo' kik'amam reje chu'nchel i naa rukamaniik taq aweh. Eh re' hat naa aach'ob'wik rub'ehel keh chi kiju'junaal chib'ih i naa kik'amam reje. <verse number="33" style="v" />Re' taqe i wili i kamanik naa kianam i riih rumaam i Merari chupaam i santo laj itz'ihy naah paat molb'al iib'. Eh re' i naa rukahniik chi k'amal kib'eeh, re' Itamar i rak'uun i Aarón i k'amal kib'eeh aj tiij, inki Dios.</para>
  <para style="p">
    <verse number="34" style="v" />Eh re' Moisés, re' i Aarón ruch'ihil taqe i k'amal kib'eeh i tinamit, xkik'saj i tz'ihb' chikinaah chi kiju'junaal pankipaat ruuk' i kituut kajaaw taqe riih rumaam i Coat <verse number="35" style="v" />Eh xkajlaaj wo' taqe i winaq wilik keh i lajeeb' ru ka'winaq haab', eh ko xi ponik lajeeb' roxk'ahl haab'. Re' taqe i ruk'ul chi naakokiik chi kamanik chupaam i santo laj itz'ihy naah paat molb'al iib'. <verse number="36" style="v" />Eh chu'nchel i winaq xkajlaaj xi ponik kiib' miil ruuk' wuquub' siento ruuk' lajeeb' roxk'ahl chu'nchel. <verse number="37" style="v" />Je' re' k'ihaal xi ponik taqe i riih rumaam i Coat. Re' taqe i ruk'ul chi naakokiik chi kamanik chupaam i santo laj itz'ihy naah paat molb'al iib'. Je' k'ihaal i xkitz'ihb'aaj i xkajlaaj i Moisés ruch'ihil i Aarón, je' wo' rukab' xq'orarik reh i Moisés ruum i QaJaaw Dios.</para>
  <para style="p">
    <verse number="38" style="v" />Eh xkajlaaj wo' taqe i riih rumaam i Gersón chi kich'uhqaal ruuk' i kituut kajaaw pankipaat. <verse number="39" style="v" />Re' taqe i wilik keh i lajeeb' ru ka'winaq haab', eh ko xi ponik lajeeb' roxk'ahl haab'. Re' i ruk'ul chi naakokiik chi kamanik chupaam i santo laj itz'ihy naah paat molb'al iib'. <verse number="40" style="v" />Eh re' i xi tz'ihb'jik re' re' xi ponik kiib' miil ruuk' waqiib' siento ruuk' lajeeb' ru ka'winaq chu'nchel. <verse number="41" style="v" />Je' re' kik'ihaal i riih rumaam i Gersón xi ajaljik re' taqe i ruk'ul chi naakokiik chi kamanik chupaam i santo laj itz'ihy naah paat molb'al iib'. Eh re' i Moisés, i Aarón xi ajlanik reh je' rukab' i xuq'or i QaJaaw Dios.</para>
  <para style="p">
    <verse number="42" style="v" />Eh re' taqe i riih rumaam i Merari i xi tz'ihb'jik chi kich'uhqaal ruuk' i kituut kajaaw pankipaat. <verse number="43" style="v" />Eh re' taqe i wilik keh i lajeeb' ru ka'winaq haab' ko xi ponik lajeeb' roxk'ahl haab'. Re' taqe i ruk'ul chi naakokiik chi kamanik chupaam i santo laj itz'ihy naah paat molb'al iib'. <verse number="44" style="v" />Re' xitz'ihbjik xi ponik ixib' miil ruuk' kiib' siento chu'nchel. <verse number="45" style="v" />Je' re' kik'ihaal xi ponik chu'nchel i riih rumaam i Merari. Re' taqe i ruk'ul chi naakokiik chi kamanik chupaam i santo laj itz'ihy naah paat. Re' wo' hoq i Moisés, re' i Aarón xitz'ihb'anik keh, je' rukab' i xuq'or i QaJaaw Dios reh i Moisés.</para>
  <para style="p">
    <verse number="46" style="v" />Eh re' i Moisés, re' i Aarón, k'uch'ihil i k'amal b'eeh chi kixilak i aj Israel, kuxik kitz'ihb'aam chi ch'uhqaal ruuk' i kituut kajaaw pankipaat taqe i aj Levíta. <verse number="47" style="v" />Re' taqe i wilik keh i lajeeb' ru ka'winaq haab', ko xi ponik lajeeb' roxk'ahl haab' re' taqe i ruk'ul chi neekiokik chub'aan i kamanik chupaam i santo laj itz'ihy naah paat molb'al iib'. <verse number="48" style="v" />Eh re' taqe i xi tz'ihb'jik re' re' xi ponik waxiqiib' miil ruuk' hoob' siento ruuk' kajwinaq chu'nchel. <verse number="49" style="v" />Re' tz'ihb' wili xb'aan wo' hoq je' rukab' i ruq'orom i QaJaaw Dios reh i Moisés. Eh chi kiju'junaal wo' xq'orarik keh chib'ih i naa kianam, eh chib'ih jariik i naa kik'amam reje, je' rukab' i ruq'or i QaJaaw Dios reh i Moisés.</para>
  <chapter number="5" style="c" />
  <para style="s">Re' kehteesjiik pankeh i ch'uwa' kiwach</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili xuq'or reh Moisés: <verse number="2" style="v" />Re' hat cha q'or keh i aj Israel chi kesaj cho chupaam i kiye'aab' taqe i wilik i rax q'aah chikiij, taqe i nelik i ruha'iil i kik'achab', taqe inkich'uwa'risaj kiib' ruuk' i rutz'a'jiik i kamnaq. <verse number="3" style="v" />Naakesam cho chupaam i kiye'aab' wilik wii' i ki-itz'ihy naah paat chi winaq chi ixoq. Chi je' re' ma' nee ta inch'uwa'rik paam i kiye'aab', re' i kinwihik wii' hin chi kixilak, inki Dios.</para>
  <para style="p">
    <verse number="4" style="v" />Eh re' taqe i aj Israel xkian wo' hoq i xq'orarik reh i Moisés ruum i Dios, xkesaj wo' cho chupaam i kiye'aab' chu'nchel taqe i wilik ruch'uwa'iil kiwach.</para>
  <para style="s">Re' k'uhb'aal chi riij jino'q i mahk, eh jino'q i ma' holohik taj imb'aan</para>
  <para style="p">
    <verse number="5" style="v" />Re' i QaJaaw Dios je' wili xuq'or reh Moisés: <verse number="6" style="v" />Re' hat cha q'or keh i aj Israel noq re' jino'q i winaq, oon jino'q ixoq ma' korik ta wach ruk'ux ruuk' i QaJaaw Dios, i rub'an jino'q i ma' holohik ta chi b'anarik reh jino'q i tokoom iraaj ruq'orom chi ruq'eb' riib' pamahk, <verse number="7" style="v" />xa re' la' koruman chi rupahqaam kuyb'al ru mahk reh i Dios, je' wo' reh i ras ruch'aaq' chi riij i mahk xub'an. Eh naa ruye'em jilow chib'ih xmahkunik wii' kojuninaq chik naa rik'sam naah i siento naa ruye'em reh chi jilow awach i xujot'. <verse number="8" style="v" />Eh wila' kamnaq chik i xujot', eh wi ma' awach chik i k'achlik reh, ma' awach ta chik neenk'ulwik reh i jilow i xmahkunik wii'. Re' naa ruye'em chi jilow i xmahkunik wii' nee ruk'am cho reh i QaJaaw, eh nee ruk'ul i k'amal kib'eeh aj tiij naa ruq'asam chi rumayiij imas tentzun i k'amal kib'eeh aj tiij pahqb'al rukuyb'al kimahk i xb'anik jot'ooj.</para>
  <para style="p">
    <verse number="9" style="v" />Eh chu'nchel i mayiij naa kiq'asam reh i Dios i aj Israel naa kiq'asam reh i k'amal kib'eeh aj tiij, eh naa wo' rukahniik reh. <verse number="10" style="v" />Eh chu'nchel i xa chib'ih jariik i neenq'ahteesjik reh i QaJaaw Dios i naa ruk'amariik reje reh i k'amal kib'eeh aj tiij, reh wo' hoq i k'amal kib'eeh aj tiij naa rukahniik, inki.</para>
  <para style="s">Re' k'uhb'aal inkahnik chinaah imb'anik i q'aab'</para>
  <para style="p">
    <verse number="11" style="v" />Re' i QaJaaw Dios je' wili xuq'or reh Moisés: <verse number="12" style="v" />Re' hat cha q'or keh i aj Israel taqe q'orik wili, qaq'or chi wilik jino'q ixoq k'ahchi' ruk'atam rooq i rub'ahiil ruuk' tokoom winaq, <verse number="13" style="v" />xub'an-oq i k'oyomal ruuk' i tokoom winaq chi ma' reht'al i rub'ahiil. Atoob' ta neeruch'uwarisaj riib' ruuk' i k'oyomal. Eh wila' ma' xkan chi riij chi korik chi je' re' i k'ahchi' rub'anam, xanaa wo' rukahniik panq'equm wila' ma' xkan chi k'ahchi' chi k'oyomal. <verse number="14" style="v" />Eh wila' je' re', re' rub'ahiil neentohq'ik ruq'ab'um i rehk'een. Eh re' i b'ahiilb'ees wilik naapech neerukapaaj chi re' i rehk'een k'ahchi' ruch'uwa'risam wach i rukaxaro chi xama' xta wo' k'ahchi' rub'anam. <verse number="15" style="v" />Re' winaq re' re' koruman chi naa ruk'amam i rehk'een chuwach i k'amal kib'eeh aj tiij naa ruk'amam reje haa' chi rumayiij chi riij i rehk'een ik'inaq kijib' libra chi ke'emaj cabada. Xa re' la' ma' naa ta rukojom aseite ruuk', eh ma' naa ta wo' rukojom insensia ruuk', ruum re' mayiij re' re' naab'al reh mi xub'an i mahk i rehk'een, oon ma' xub'an taj.</para>
  <para style="p">
    <verse number="16" style="v" />Eh re' k'amal kib'eeh aj tiij naa ruq'orom reh i ehk'eenb'ees chi naa rujilim i koq riib' reh chi naa ruq'asam i koq chuwach i QaJaaw. <verse number="17" style="v" />Eh re' i k'amal kib'eeh aj tiij naa ruchopom cho k'isinoq i ha' kuxisamaj chupaam ak'al kulk, eh naa ruye'em chupaam i ha' re' re' k'isinoq i pooq wilik chupaam i santo laj itz'ihy naah paat. <verse number="18" style="v" />Re' i k'amal kib'eeh aj tiij naa rupab'aam i koq chuwach i QaJaaw Dios ehk'eenb'ees re' re', eh naa resam i b'urb'al wach i naah, eh naa ruye'em pan q'ab' xye'arik chi mayiij chi riij i q'aab' imb'aan reh. Eh re' i k'amal kib'eeh aj tiij naa ruchopom pan kulk i k'ah laj ha' re' ink'amwik chaloq i ti' k'axik. <verse number="19" style="v" />Eh re' i k'amal kib'eeh aj tiij naa ruq'orom reh i ehk'eenb'ees chi chuq'or i xti korik, naa rupahqaam chi je' wili: Mi ma' k'ahchi' ak'atam rooq ab'ahiil, mi ma' xat wirik ruuk' i jino'q tokoom winaq ma' xta neenak'ul noq neenawuk'ej i ha' wili ink'amwik chee ti' k'axik. <verse number="20" style="v" />Eh wila' korik chi xak'at rooq ab'ahiil, wila' korik chi xwirik awuuk' jino'q i tokoom winaq, eh xach'uwa'reej awiib' ruuk' taqe i yiib' wach na'ojb'al re' re'. <verse number="21" style="v" />Re' i k'amal kib'eeh aj tiij, je' wili i naa ruq'orom reh i ehk'eenb'ees re' re': Re' hat naa rusipjiik apaam, naa roq'taam riib' i nah atuuq, ma' naa ta chik aawak'unaniik. Re' i QaJaaw Dios naa ruye'wiik chee ti' k'axik cha naah re' re'. <verse number="22" style="v" />Re' taqe i tojb'al mahk wili naa ruchaliik cha naah noq naa awuk'em i k'ahlaj ha' wili ink'amwik cho reh i ti' k'axik inko'q. Eh re' ixoq je' wili i naa ruq'orom: I ruk'ul chi je' re' i naa nuk'ulum, inko'q wixub'an i mahk.</para>
  <para style="p">
    <verse number="23" style="v" />Eh re' i k'amal kib'eeh aj tiij naa rutz'ihb'aam panhuuj i ti' k'axik wili, eh naa wo' chik rutz'ajam iloq ruuk' i k'ahlaj ha'. <verse number="24" style="v" />Chi riij i re' naa ruye'em reh chi uuk'jik reh chi neenk'aahb'ik cho chupaam. <verse number="25" style="v" />Re' i k'amal kib'eeh aj tiij naa ruk'ulum pan q'ab' ixoq i mayiij xuyeew chi riij i q'aab' xb'aan reh naa ruq'asam pan q'ab' i QaJaaw Dios, chi riij i re' naa ruq'asam wach artaal. <verse number="26" style="v" />Eh re' i k'amal kib'eeh aj tiij naa ruchopom chaloq i ke'emaj mayiij xq'ahteesjik reh chi riij ixoq naa ruk'atam wach artaal.</para>
  <para style="p">Eh naa ruye'em reh chi uuk'jik i k'ahlaj ha' ixoq. <verse number="27" style="v" />Wila' korik chi xuk'at rooq i rub'ahiil ruuk' tokoom winaq, re' ha' re' re' ink'amwik cho ti' k'axik, naa ruk'ahb'iik cho chupaam, eh naa rusipjiik, i paam, naa roq'taam riib' i nah rutuuq, ma' naa ta chik ruwihiik ruha'lak'uun. Eh re' ixoq re' re' naa ruk'ulum i ti' k'axik chi kixilak i rutinamiit. <verse number="28" style="v" />Eh wila' re' ixoq re' re' ma' xuch'uwa'reej ta wach i rukaxarohiil, eh ma' xta wo' jino'q i mahk xub'an konee wo' inwihik ruha'lak'uun.</para>
  <para style="p">
    <verse number="29" style="v" />Re' taqe wili i k'uhb'aal inkahnik chinaah ixoq inq'aab'jik, oon neeruk'at rooq i rub'ahiil ruuk' tokoom winaq. <verse number="30" style="v" />Re' wo' wili i k'uhb'aal inkahnik chinaah i b'ahiilb'ees ruq'ab'aj i rehk'een. Ruum i re', re' b'ahiilb'ees koruman chi naa ruk'amam chee rehk'een chuwach i QaJaaw Dios. Eh re' i k'amal kib'eeh aj tiij naa rub'anam ruuk' ixoq nik' wach i ruq'or i k'uhb'aal wili. <verse number="31" style="v" />Eh wila' re' ixoq i ruk'at rooq i rub'ahiil re' wo' reh naa rutojwiik riij i ru mahk, eh re' i rub'ahiil neenkahnik chi ma' xta ru mahk, inki i QaJaaw Dios.</para>
  <chapter number="6" style="c" />
  <para style="s">Re' i k'uhb'aal naa rukahniik chikinaah i naa kiq'asam kiib' chi je' Nazareo</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili xuq'or reh i Moisés: <verse number="2" style="v" />Re' hat cha q'or keh i aj Israel taqe i q'orik wili: Wila' re' jino'q i winaq, oon jino'q ixoq iraaj ruq'asam riib' chi kamanik reh i Dios chi je' jino'q Nazareo. <verse number="3" style="v" />Re' reh ma' nee ta rub'an chi nee ruk'ej reh i vino, taqe k'ahlaj ha', je' wo' hoq i ch'amlaj ha', eh ni xata re' riis i uuva neeruk'ej, ni xata naa ruk'uxum reh i uuva kore' xsik'arik, ni xata re' i najtir insik'arik. <verse number="4" style="v" />Eh nik' najtiil naa rub'anam chi je' Nazareo ma' naa ta ruk'uxum reh taqe i xa chib'ih jariik inkorjik ruuk' uuva ni xata re' i riij, ni xata re' naq' naa ruk'uxum. <verse number="5" style="v" />Eh ma' naa ta wo' ruyok'om i rismaal i naah, naa la' rukanaam chi naa ruk'ihiik. Konaa chik ruponiik i q'iij nik' najtiil xuq'at noq xkahnik chi je' Nazareo, noq xuq'asaj riib' reh i QaJaaw Dios, korehtaal i rub'an i xuq'or. <verse number="6" style="v" />Eh nik' najtiil naa ruwihiik chi je' re', ma' naa ta rujilim i koq riib' ruuk' jino'q i kamnaq. <verse number="7" style="v" />Atoob' ta re' rajaaw oon rutuut, oon re' i jino'q i ras winaq oon jino'q ranaab' neenkimik ma' ruk'ul ta chi nee rutz'a'j i koq, reh chi ma' nee ta ruch'uwa'reej riib'. Ruum re' reh ruq'asam riib' reh i Dios, korehtaal i rub'an aha' wilik i xuq'or. <verse number="8" style="v" />Eh nik' najtiil naa rub'anam chi je' Nazareo iraaj ruq'orom chi ruq'asam riib' reh i Dios.</para>
  <para style="p">
    <verse number="9" style="v" />Eh wila' xkimik jino'q ma' najta chucheel i je' Nazareo ch'uwa'rik-oq wach i riis maal i naah xk'ihik noq xuq'asaj riib' reh i QaJaaw Dios paruwuuq q'iij naa rujoyom i rismaal naah, chupaam wo' i ruq'ijil i saqb'eesb'al riib'. <verse number="10" style="v" />Eh chupaam i ruwahxaaq q'iij naa ruk'amam reje reh i k'amal kib'eeh aj tiij i kiib' chi kok' paloma, oon kib'-oq chi kok' mukur panookb'al reh i santo laj itz'ihy naah paat molb'al iib'. <verse number="11" style="v" />Re' i k'amal kib'eeh aj tiij jinaj keh i kok' chikop re' re' naa ruq'asam chi mayiij chi riij i mahk. Eh re' jinaj naa ruk'atam chi mayiij pahqb'al kuyb'al ru mahk i xuch'uwa'risaj riib' ruum i rutz'a'jiik i kamnaq, chupaam i junk'aam re' re' naa wo' chik rusaaqb'iik wach i rismaal i naah. <verse number="12" style="v" />Kore' chik naa rutoq'aam ruq'asam riib' chuwach i QaJaaw Dios. Eh aha' wilik i xub'an cho pampeet ruum re' i rismaal i naah ruq'asam reh i QaJaaw Dios xch'uwa'rik chik wach. Eh naa ruk'amam reje jinaj i tentzun jinaj haab' i wilik reh, reh chi naa ruq'asam chi mayiij chi riij i ru mahk.</para>
  <para style="p">
    <verse number="13" style="v" />Eh noq neenkuxik wach i junch'iht chi q'asanik iib' reh i Dios chi je' Nazareo naa rojiik panookb'al reh i santo laj itz'ihy naah paat molb'al iib'. <verse number="14" style="v" />Eh naa ruq'asam chi rumayiij jinaj tentzun jinaj haab' wilik reh, eh jinaj ixoq tentzun jinaj haab' i wilik reh manlik wach kiti'jolal. Eh naa ruq'asam chi rumayiij jinaj imas tentzun manlik wach ruti'jolal k'amb'al riib' panotob'il ruuk' i Dios. <verse number="15" style="v" />Eh naa wo' ruq'asam jinaj chakach chi kaxlanwi'k ma' kojooj ta ch'amb'esb'al reh korjinaq ruuk' i holohik arina, xilakimaj ruuk' aseite. Je' wo' hoq i suq laj kaxlanwi'k ma' kojooj ta ch'amb'esb'al reh xilakimaj ruuk' aseite, ruch'ihil i rumayiij xa chi naq'wach ruch'ihil i riis uuva. <verse number="16" style="v" />Re' i k'amal kib'eeh aj tiij naa ruq'asaniik reh chuwach i QaJaaw Dios chi mayiij chi riij i mahk, eh naa wo' ruq'asam i k'atoj mayiij. <verse number="17" style="v" />Eh re' imas tentzun naa ruq'asam chi mayiij k'amb'al iib' panotob'il ruuk' i Dios junye'ariik ruuk' i jinaj chakach chi kaxlanwi'k ma' kojooj ta ch'amb'esb'al reh. Eh naa wo' ruq'asam i mayiij xa chi naq'wach, je' wo' hoq i riis uuva. <verse number="18" style="v" />Eh re' naa rub'anam chi je' Nazareo naa rujohyam i rismaal i naah panookb'al reh i santo laj itz'ihy naah paat molb'al iib', eh naa ruchopom chaloq i rismaal i naah, ruq'asam naq reh i QaJaaw naa rukutum wach q'aaq' naa ruqopiik chi ri'sil i mayiij k'amal iib' panotob'il ruuk' i Dios. <verse number="19" style="v" />Eh re' i k'amal kib'eeh aj tiij naa ruk'amam chaloq i raa' tileb' imas tentzun noq chaq'inaq chik, eh naa ruk'amam cho jino'q i kaxlanwi'k ma' kojooj ta ch'amb'esb'al reh wilik pank'isa chakach, ruch'ihil i suq laj kaxlanwi'k ma' kojooj ta ch'amb'esb'al reh naa ruye'em pan q'ab' i je' Nazareo noq rujoyom chik i rismaal naah. <verse number="20" style="v" />Re' i k'amal kib'eeh aj tiij xub'an i ninq'iij xuq'asaj i mayiij chuwach i QaJaaw Dios, re' i rutib'kaal chi' ruk'ux i chikop, ruch'ihil i raa' tileb'. Eh re' i mayiij re' re' wilik rusantohiil naa rukahniik chi reh i k'amal kib'eeh aj tiij. Eh re' i je' Nazareo neerub'an chi nee ruk'ej i riis uuva.</para>
  <para style="p">
    <verse number="21" style="v" />Re' i k'uhb'aal wili inkahnik chinaah i naa ruq'asam riib' chi je' Nazareo. Re' taqe i wili mayiij naa ruq'asam ma' xta chik jino'q mayiij neenpahqaljik reh chi ma' nee ta rukuy ruye'ariik. Xa re' la' inchol rub'anam aha' wilik i ruq'orom noq naa rukuxiik wach nik' najtiil xub'an chi je' Nazareo, inki i QaJaaw Dios.</para>
  <para style="s">Re' i kuxisanik naa kianam i k'amal kib'eeh aj tiij</para>
  <para style="p">
    <verse number="22" style="v" />Re' i QaJaaw Dios je' wili xuq'or reh i Moisés: <verse number="23" style="v" />Re' hat cha q'or reh i Aarón, ruch'ihil taqe i rak'uun, noq naa kikuxisam taqe i aj Israel je' wili naa kiq'orom:</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Re' ta naq i Dios neentoob'inik, neencha'jinik taq aweh.</para>
  <para style="q">
    <verse number="25" style="v" />Eh suq ta naq taq awilariik neerub'an i QaJaaw Dios,</para>
  <para style="q">eh nee ta naq i ruketelaaj taq awach.</para>
  <para style="q">
    <verse number="26" style="v" />Re' ta naq i QaJaaw Dios neenilwik taq aweh,</para>
  <para style="q">neen ye'wik ataq weh i suq kiil k'uxliis, inko'q taqe.</para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" />Chi je' re', re' taqe i k'amal kib'eeh aj tiij panub'ihnaal naa kikuxisam taqe i aj Israel. Eh re' hin naa wo' nukuxisam taqe, inki i QaJaaw Dios.</para>
  <chapter number="7" style="c" />
  <para style="s">Re' i mayiij xye'arik noq xq'ahteesjik pan q'ab' i Dios i santo laj itz'ihy naah paat</para>
  <para style="p">
    <verse number="1" style="v" />Eh noq xukohlaaj rukorb'eesjiik i santo laj itz'ihy naah paat i Moisés xukuxisaj ruuk' aseite, xukuxisaj wo' taqe chu'nchel i wilkeeb' chupaam. Eh xukuxisaj wo' ruuk' i aseite i artaal, ruch'ihil taqe i kulk inkamanik ar. <verse number="2" style="v" />Eh re' taqe i k'amal kib'eeh i ju'jun ch'uq chi aj Israel, re' taqe i xitowik haa' chi tz'ihb' noq xb'aan i ajlanik xponik kiq'asaj i kimayiij chuwach i QaJaaw Dios. <verse number="3" style="v" />Re' kimayiij xkiq'asaj waqiib' chi kareta tz'aplik naah, eh kab'laj i b'ooyax, ju'jun chi kareta i xkiq'asaj i kiib' chi k'amal b'eeh. Eh ju'jun i b'ooyax xkiq'asaj chi kiju'junaal, ar xkiq'asaj chi kimayiij chuwach i santo laj itz'ihy naah paat.</para>
  <para style="p">
    <verse number="4" style="v" />Chi riij i re', re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="5" style="v" />Chak'ul keh taqe i kareta taqe b'ooyax reh chi neen kamanik chi k'amb'al reje reh i ruche'el i santo laj itz'ihy naah paat molb'al iib'. Eh nee nach'aq chikinaah i aj Levíta, re' q'oreel chib'ih i ihq naa kik'amam reje, inki.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' i Moisés xuk'ul wo' taqe i kareta, taqe i b'ooyax, eh xuch'aq keh i aj Levíta. <verse number="7" style="v" />Re' i Moisés kiib' i kareta, kijib' i b'ooyax xuyeew keh i riih rumaam Gersón. Re' i ajwaal wach chi keh reh i kikamaj. <verse number="8" style="v" />Eh kijib' wo' i kareta, eh waxiqiib' i b'ooyax xuyeew keh i riih rumaam Merari re' i ajwaal wach chi keh reh i kikamaj. Eh re' intaaq'anik keh, re' i Tamar rak'uun i Aarón i k'amal kib'eeh aj tiij. <verse number="9" style="v" />Eh re' taqe i riih rumaam Coat ma' xye'arik ta kikareta, je' wo' kib'ooyax chi k'amb'al kihq xa nah kitileb' xkik'am reje ruum wilik rusantohiil i kik'amooj.</para>
  <para style="p">
    <verse number="10" style="v" />Eh re' taqe i k'amal kib'eeh i ju'jun ch'uq chi aj Israel noq xkuxeesjik i artaal ruuk' aseite xkik'am reje i kimayiij xponik kiyeew chinaah i artaal. <verse number="11" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: Re' ju'jun chi q'iij, ju'jun chi k'amal kib'eeh i ju'jun ch'uq chi aj Israel naa ruchaliik chuye'ariik i rumayiij kuxesb'al reh i artaal, inki.</para>
  <para style="p">
    <verse number="12" style="v" />Pan peet q'iij re' i Naasón rak'uun i Aminadab xuq'asaj i rumayiij re' k'amal kib'eeh i jun ch'uq chi tinamit riih rumaam Judá. <verse number="13" style="v" />Re' i mayiij xuq'asaj jinaj i nimlaj pulato re' ruuk' i plata ik'inaq ixib' libra rahliil. Eh jinaj i nimlaj kulk re' ruuk' i plata achk'isiin ma' kiib' libra rahliil, je' rukab' i pajooj imb'aan chupaam i santo laj itz'ihy naah paat. Eh kab'chel i re' nujinaq chi holohik laj arina xilakimaj ruuk' aseite reh mayiij. <verse number="14" style="v" />Eh xuq'asaj wo' chi rumayiij jinaj cucharo oro kijib' onse rahliil nujinaq chi insensia. <verse number="15" style="v" />Xuq'asaj wo' hoq chi k'atoj mayiij jinaj i k'isa imas wakax, jinaj imas tentzun, eh jinaj i tentzun jinaj haab' i wilik reh. <verse number="16" style="v" />Eh xuq'asaj wo' hoq i jinaj imas kaprax pahqb'al kuyb'al mahk. <verse number="17" style="v" />Eh pantz'apaab' wach xuq'asaj i mayiij k'amb'al iib' panotob'il ruuk' i Dios kiib' i b'ooyax ho'oob' imas tentzun, ho'oob' imas kaprax, eh ho'oob' i tentzun ju'jun haab' i wilik ke. Re' taqe wili i mayiij xuq'asaj i Naasón rak'uun i Aminadab.</para>
  <para style="p">
    <verse number="18" style="v" />Eh parukab' q'iij re' i Natanael rak'uun i Zuar xuq'asaj i rumayiij re' k'amal kib'eeh i ju'jun ch'uq chi tinamit riih rumaam Isacar. <verse number="19" style="v" />Re' i xuq'asaj chi rumayiij jinaj i nimlaj pulato re' ruuk' i plata ik'inaq ixib' libra rahlil, eh jinaj i nimlaj kulk re' ruuk' i plata k'isiin ma' kiib' libra i rahlil, je' rukab' i pajooj imb'aan chupaam i santo laj itz'ihy naah paat. Eh kab'chel i re' nujinaq chi holohik laj arina reh mayiij xilakimaj ruuk' aseite. <verse number="20" style="v" />Eh xuq'asaj chi rumayiij jinaj i nimlaj cucharo re' ruuk' i oro kijib' onse rahliil nujinaq chi insensia. <verse number="21" style="v" />Xuq'asaj chi k'atoj mayiij i jinaj i k'isa imas wakax, jinaj imas tentzun, eh jinaj i tentzun jinaj haab' i wilik reh. <verse number="22" style="v" />Eh xuq'asaj wo' i jinaj imas kaprax pahqb'al kuyb'al mahk. <verse number="23" style="v" />Eh pantz'apaab' wach xuq'asaj i mayiij k'amb'al iib' panotob'il ruuk' i Dios kiib' i b'ooyax, ho'oob' imas tentzun, eh ho'oob' imas kaprax, ho'oob' tentzun ju'jun haab' i wilik keh. Re' taqe i wili mayiij xuq'asaj i Natanael rak'uun i Zuar.</para>
  <para style="p">
    <verse number="24" style="v" />Eh paroox q'iij re' i Eliab rak'uun i Helón xuq'asaj i rumayiij re' i k'amal kib'eeh i jun ch'uq chi riih rumaam Zabulón. <verse number="25" style="v" />Re' xuq'asaj chi rumayiij jinaj i nimlaj pulato re' ruuk' i plata ik'inaq ixib' libra rahlil. Eh jinaj i nimlaj kulk re' ruuk' i plata k'isiin ma' kiib' libra rahliil je' rukab' i pajooj imb'aan pan santo laj itz'ihy naah paat. Eh kab'chel i re' nujinaq chi holohik arina reh mayiij xilakimaj ruuk' aseite. <verse number="26" style="v" />Eh xuq'asaj wo' chi mayiij jinaj i nimlaj cucharo re' ruuk' i oro kijib' libra rahliil nujinaq chi insensia. <verse number="27" style="v" />Eh xuq'asaj wo' chi k'atoj mayiij i jinaj i k'isa imas wakax, jinaj imas tentzun, eh jinaj i tentzun jinaj haab' i wilik reh. <verse number="28" style="v" />Eh xuq'asaj wo' jinaj imas kaprax chi mayiij pahqb'al kuyb'al mahk. <verse number="29" style="v" />Eh pantz'apaab' wach xuq'asaj i mayiij i k'amb'al iib' panotob'il ruuk' i QaJaaw Dios kiib' i b'ooyax, ho'oob' imas tentzun, eh ho'oob' imas kaprax, ho'oob' tentzun ju'jun haab' i wilik keh. Re' taqe wili i xuq'asaj chi rumayiij i Eliab rak'uun i Helón.</para>
  <para style="p">
    <verse number="30" style="v" />Eh parukaaj q'iij re' i Elisur rak'uun i Sedeur xuq'asaj i rumayiij re' i k'amal kib'eeh i jun ch'uq chi riih rumaam Rubén. <verse number="31" style="v" />Re' xuq'asaj chi rumayiij jinaj i nimlaj pulato re' ruuk' i plata ik'inaq ixib' libra rahlil, jinaj i nimlaj kulk re' ruuk' i plata k'isiin ma' kiib' libra rahlil, je' rukab' i pajooj imb'aan pan santo laj itz'ihy naah paat. Eh kab'chel i re' nujinaq chi holohik laj arina reh mayiij xilakimaj ruuk' aseite. <verse number="32" style="v" />Eh xuq'asaj chi rumayiij jinaj i nimlaj cucharo re' ruuk' i oro kijib' libra i rahliil nujinaq chi insensia. <verse number="33" style="v" />Eh xuq'asaj chi k'atoj mayiij jinaj i k'isa imas wakax, jinaj imas tentzun, eh jinaj i tentzun jinaj haab' i wilik reh. <verse number="34" style="v" />Eh xuq'asaj wo' hoq i jinaj imas kaprax chi mayiij pahqb'al kuyb'al mahk. <verse number="35" style="v" />Eh pantz'apaab' wach xuq'asaj i mayiij i k'amal iib' panotob'il ruuk' i QaJaaw Dios, kiib' i b'ooyax, ho'oob' imas tentzun, ho'oob' imas kaprax, ho'oob' tentzun, ju'jun haab' i wilik keh. Re' taqe i wili xuq'asaj chi rumayiij i Elisur rak'uun i Sedeur.</para>
  <para style="p">
    <verse number="36" style="v" />Eh paroo' q'iij re' i Selumiel rak'uun i Zurisadai xuq'asaj i rumayiij re' i k'amal kib'eeh i junch'uq chi riih rumaam i Simeón. <verse number="37" style="v" />Re' i xuq'asaj chi rumayiij jinaj i nimlaj pulato re' ruuk' i plata, ik'inaq ixib' libra rahlil, jinaj i nimlaj kulk re' ruuk' i plata k'isiin ma' kiib' libra rahlil, je' rukab' i pajooj imb'aan pan santo laj itz'ihy naah paat. Eh kab'chel i re' nujinaq taqe chi holohik laj arina reh i mayiij xilakimaj ruuk' aseite. <verse number="38" style="v" />Eh xuq'asaj wo' chi rumayiij i jinaj i nimlaj cucharo re' ruuk' i oro kijib' libra rahliil nujinaq chi insensia. <verse number="39" style="v" />Eh xuq'asaj wo' chi k'atoj mayiij jinaj i k'isa imas wakax, jinaj imas tentzun, eh jinaj i tentzun jinaj i haab' wilik reh. <verse number="40" style="v" />Eh xuq'asaj wo' hoq jinaj imas kaprax chi mayiij pahqb'al kuyb'al mahk. <verse number="41" style="v" />Eh xuq'asaj i mayiij k'amb'al iib' panotob'il ruuk' i QaJaaw Dios kiib' i b'ooyax, ho'oob' imas tentzun, ho'oob' imas kaprax, ho'oob' tentzun, ju'jun haab' i wilik keh. Re' taqe wili xuq'asaj chi rumayiij i Selumiel rak'uun i Zurisadai.</para>
  <para style="p">
    <verse number="42" style="v" />Paruwaaq q'iij re' Eliasaf rak'uun i Deuel xuq'asaj i rumayiij, re' i k'amal kib'eeh i junch'uq chi riih rumaam Gad. <verse number="43" style="v" />Re' xuq'asaj chi rumayiij jinaj i nimlaj pulato re' ruuk' i plata ik'inaq ixib' libra rahlil, jinaj i nimlaj kulk re' ruuk' i plata k'isiin ma' kiib' libra rahlil, je' rukab' i pajooj imb'aan chupaam i rusanto laj itz'ihy naah paat i QaJaaw Dios. Eh kab'chel i re' nujinaq chi holohik laj arina reh mayiij xilakimaj ruuk' aseite. <verse number="44" style="v" />Eh xuq'asaj wo' chi rumayiij jinaj i nimlaj cucharo re' ruuk' i oro kijib' libra rahliil nujinaq chi insensia. <verse number="45" style="v" />Eh xuq'asaj wo' chi rumayiij jinaj i k'isa imas wakax, jinaj imas tentzun, eh jinaj i tentzun jinaj haab' i wilik reh. <verse number="46" style="v" />Eh xuq'asaj wo' hoq jinaj imas kaprax chi mayiij pahqb'al kuyb'al chi riij i mahk. <verse number="47" style="v" />Eh xuq'asaj i mayiij k'amal iib' panotob'il ruuk' i QaJaaw Dios, kiib' i b'ooyax, ho'oob' imas tentzun, ho'oob' imas kaprax, ho'oob' tentzun, ju'jun haab' i wilik keh. Re' taqe wili xuq'asaj chi rumayiij i Eliasaf rak'uun i Deuel.</para>
  <para style="p">
    <verse number="48" style="v" />Eh paruwuuq q'iij, re' i Eliasama rak'uun i Amiud xuq'asaj i rumayiij re' i k'amal kib'eeh i jun ch'uq chi riih rumaam Efraín. <verse number="49" style="v" />Re' i xuq'asaj chi rumayiij jinaj i nimlaj pulato re' ruuk' i plata ik'inaq ixib' libra rahliil, jinaj i nimlaj kulk re' ruuk' i plata k'isiin ma' kiib' libra rahliil, je' rukab' i pajooj imb'aan chupaam i santo laj itz'ihy naah paat. Eh kab'chel i re' nujinaq chi holohik arina reh mayiij xilakimaj ruuk' aseite. <verse number="50" style="v" />Eh xuq'asaj chi rumayiij jinaj i nimlaj cucharo re' ruuk' i oro kijib' onse rahliil, nujinaq chi insensia. <verse number="51" style="v" />Xuq'asaj wo' chi k'atoj mayiij i k'isa imas wakax, jinaj imas tentzun, jinaj tentzun, jinaj haab' i wilik reh. <verse number="52" style="v" />Eh xuq'asaj wo' hoq jinaj imas kaprax chi mayiij pahqb'al kuyb'al mahk. <verse number="53" style="v" />Eh xuq'asaj i mayiij k'amb'al iib' panotob'il ruuk' i QaJaaw Dios, kiib' i b'ooyax, ho'oob' imas tentzun, ho'oob' imas kaprax, ho'oob' tentzun, ju'jun haab' i wilik keh. Re' taqe i re' xuq'asaj chi rumayiij i Elisama rak'uun i Amiud.</para>
  <para style="p">
    <verse number="54" style="v" />Eh paruwaxaaq q'iij re' i Gamaliel rak'uun i Pedasur xuq'asaj i rumayiij re' i k'amal kib'eeh i junch'uq chi riih rumaam Manasés. <verse number="55" style="v" />Re' xuq'asaj chi rumayiij, jinaj i nimlaj pulato re' ruuk' i plata ik'inaq ixib' libra rahliil, jinaj i nimlaj kulk re' ruuk' i plata k'isiin ma' kiib' libra rahliil, je' rukab' i pajooj imb'aan chupaam santo laj itz'ihy naah paat. Eh kab'chel i re' nujinaq chi holohik arina reh mayiij xilakimaj ruuk' aseite reh mayiij. <verse number="56" style="v" />Eh xuq'asaj wo' chi rumayiij jinaj i nimlaj cucharo re' ruuk' i oro kijib' onse rahliil, nujinaq chi insensia. <verse number="57" style="v" />Eh xuq'asaj wo' chi k'atoj mayiij jinaj i k'isa imas wakax, jinaj imas tentzun, eh jinaj i tentzun jinaj haab' i wilik reh. <verse number="58" style="v" />Eh xuq'asaj jinaj imas kaprax chi mayiij pahqb'al kuyb'al mahk. <verse number="59" style="v" />Eh xuq'asaj i mayiij k'amb'al iib' panotob'il ruuk' i QaJaaw Dios, kiib' i b'ooyax, ho'oob' imas tentzun, ho'oob' imas kaprax ho'oob' tentzun, ju'jun haab' i wilik keh. Re' taqe wili i xuyeew chi rumayiij i Gamaliel rak'uun i Pedasur.</para>
  <para style="p">
    <verse number="60" style="v" />Eh parub'eleej q'iij re' i Abidán rak'uun i Gedioni xuq'asaj i rumayiij re' i k'amal kib'eeh i jun ch'uq chi riih rumaam Benjamín. <verse number="61" style="v" />Re' i xuq'asaj chi rumayiij jinaj i nimlaj pulato re' ruuk' i plata ik'inaq ixib' libra rahliil, jinaj i nimlaj kulk re' ruuk' i plata k'isiin ma' kiib' libra rahliil, je' rukab' i pajooj imb'aan chupaam santo laj itz'ihy naah paat. Eh kab'chel i re' nujinaq chi holohik arina reh mayiij xilakimaj ruuk' aseite. <verse number="62" style="v" />Eh xuq'asaj chi rumayiij jinaj i nimlaj cucharo re' ruuk' i oro kijib' onse rahliil nujinaq chi insensia. <verse number="63" style="v" />Eh xuq'asaj wo' chi k'atoj mayiij jinaj k'isa imas wakax, jinaj imas tentzun, jinaj tentzun jinaj haab' i wilik reh. <verse number="64" style="v" />Eh xuq'asaj i jinaj imas kaprax chi mayiij pahqb'al kuyb'al mahk. <verse number="65" style="v" />Eh xuq'asaj i mayiij k'amb'al iib' panotob'il ruuk' i QaJaaw Dios, kiib' i b'ooyax, ho'oob' imas tentzun, ho'oob' imas kaprax, ho'oob' tentzun, ju'jun haab' i wilik keh. Re' taqe wili xuq'asaj chi rumayiij i Abidán rak'uun i Gedioni.</para>
  <para style="p">
    <verse number="66" style="v" />Eh parulajeeb' q'iij re' i Ahiezer rak'uun i Amisadai xuq'asaj i rumayiij, re' k'amal kib'eeh i jun ch'uq chi riih rumaam Dan. <verse number="67" style="v" />Re' xuq'asaj chi rumayiij jinaj i nimlaj pulato re' ruuk' i plata ik'inaq ixib' libra rahliil jinaj i nimlaj kulk re' ruuk' i plata k'isiin ma' kiib' libra rahliil, je' rukab' i pajooj imb'aan chupaam i santo laj itz'ihy naah paat. Eh kab'chel i re' nujinaq taqe chi holohik arina reh mayiij xilakimaj ruuk' aseite. <verse number="68" style="v" />Eh xuq'asaj wo' chi rumayiij jinaj i nimlaj cucharo re' ruuk' i oro kijib' onse rahliil nujinaq chi insensia. <verse number="69" style="v" />Eh xuq'asaj wo' chi k'atoj mayiij jinaj i k'isa imas wakax, jinaj imas tentzun, eh jinaj tentzun jinaj haab' wilik reh. <verse number="70" style="v" />Eh xuq'asaj wo' hoq jinaj imas kaprax chi mayiij pahqb'al kuyb'al i mahk. <verse number="71" style="v" />Eh xuq'asaj i mayiij k'amb'al iib' panotob'il ruuk' i Dios, kiib' i b'ooyax, ho'oob' imas tentzun, ho'oob' imas kaprax, ho'oob' tentzun, ju'jun haab' i wilik keh. Re' taqe wili xuyeew chi rumayiij i Ahiezer rak'uun i Amisadai.</para>
  <para style="p">
    <verse number="72" style="v" />Eh pan rujunlaaj q'iij re' i Pagiel rak'uun Ocrán xuq'asaj i rumayiij, re' i k'amal kib'eeh i jun ch'uq chi riih rumaam Aser. <verse number="73" style="v" />Re' xuq'asaj chi rumayiij jinaj i nimlaj pulato. Re' ruuk' i plata ik'inaq ixib' libra rahliil, jinaj i nimlaj kulk re' ruuk' i plata k'isiin ma' kiib' libra rahliil, je' rukab' i pajooj imb'aan chupaam i Santo laj itz'ihy naah paat. Eh kab'chel i re' nujinaq chi holohik arina reh mayiij xilakimaj ruuk' aseite. <verse number="74" style="v" />Eh xuq'asaj chi rumayiij jinaj i nimlaj cucharo re' ruuk' i oro kijib' onse rahliil nujinaq chi insensia. <verse number="75" style="v" />Eh xuq'asaj wo' chi k'atoj mayiij jinaj imas wakax, jinaj imas tentzun, eh jinaj tentzun jinaj haab' i wilik reh. <verse number="76" style="v" />Eh xuq'asaj wo' hoq jinaj imas kaprax chi mayiij pahqb'al kuyb'al mahk. <verse number="77" style="v" />Eh xuq'asaj chi mayiij k'amb'al iib' panotob'il ruuk' i Dios kiib' i b'ooyax, ho'oob' imas tentzun, ho'oob' imas kaprax, eh ho'oob' tentzun, ju'jun haab' i wilik keh. Re' taqe wili i xuq'asaj chi rumayiij i Pagiel rak'uun Ocrán.</para>
  <para style="p">
    <verse number="78" style="v" />Eh parukab'laaj q'iij re' i Ahira rak'uun i Enán xuq'asaj i rumayiij, re' i k'amal kib'eeh i junch'uq chi riih rumaam Neftalí. <verse number="79" style="v" />Re' xuyeew chi rumayiij jinaj i nimlaj pulato re' ruuk' i plata ik'inaq ixib' libra rahliil, jinaj i nimlaj kulk re' ruuk' i plata k'isiin ma' kiib' libra rahliil, je' rukab' i pajooj imb'aan chupaam i santo laj itz'ihy naah paat. Eh kab'chel i re' nujinaq chi holohik laj arina reh i mayiij xilakimaj ruuk' aseite. <verse number="80" style="v" />Eh xuq'asaj wo' chi rumayiij jinaj i nimlaj cucharo re' ruuk' i oro kijib' onse rahliil nujinaq chi insensia. <verse number="81" style="v" />Eh xuq'asaj chi k'atoj mayiij jinaj imas wakax, jinaj imas tentzun, jinaj tentzun jinaj haab' i wilik reh. <verse number="82" style="v" />Eh xuq'asaj wo' hoq jinaj imas kaprax chi mayiij pahqb'al kuyb'al mahk. <verse number="83" style="v" />Eh xuq'asaj i mayiij k'amb'al iib' panotob'il ruuk' i QaJaaw Dios, kiib' i b'ooyax, ho'oob' imas tentzun, ho'oob' imas kaprax, ho'oob' tentzun, ju'jun haab' i wilik keh. Re' taqe wili xuq'asaj chi rumayiij i Ahira rak'uun i Enán.</para>
  <para style="p">
    <verse number="84" style="v" />Je' wili k'ihaal i mayiij xkiq'asaj k'amal kib'eeh i aj Israel kab'laj ch'uq noq kuxesjik ruuk' aseite i artaal, noq xq'ahtesjik pan q'ab' i QaJaaw Dios, kab'laj i nimaq pulato re' ruuk' i plata. Kab'laj i nimaq kulk re' ruuk' i plata, kab'laj i nimaq cucharo re' ruuk' i oro. <verse number="85" style="v" />Eh re' nimaq pulato re' ruuk' i plata ik'inaq ixib' libra rahliil i ju'jun. Eh re' i nimaq kulk plata k'isiin ma' kiib' libra rahliil i ju'jun. Re' chu'nchel i korjinaq ruuk' plata ik'inaq lajeeb' roxk'ahl libra rahliil, je' rukab' i pajooj imb'aan chupaam i santo laj itz'ihy naah paat. <verse number="86" style="v" />Eh kiq'asaj i kab'laj i nimaq cucharo re' ruuk' i oro, nujinaq chi insensia kijib' onse rahliil i ju'jun, je' rukab' i pajooj imb'aan chupaam i santo laj itz'ihy naah paat, chu'nchel i nimaq cucharo oro ixib' libra rahliil.</para>
  <para style="p">
    <verse number="87" style="v" />Eh re' chikop xkiq'asaj chi k'atoj mayiij kab'laj imas wakax kab'laj imas tentzun, kab'laj tentzun ju'jun haab' i wilik keh ruch'ihil i holohik arina. Eh kab'laj imas kaprax pahqb'al kuyb'al mahk. <verse number="88" style="v" />Re' i chikop xkiyeew chi mayiij k'amb'al iib' panotob'il ruuk' i QaJaaw Dios je' wili i kik'ihaal kijib' ru ka'winaq i b'ooyax, oxk'ahl imas tentzun, oxk'ahl imas kaprax, oxk'ahl i tentzun ju'jun haab' i wilik keh. Re' wili i kimayiij xkiq'asaj noq kuxesjik ruuk' aseite i artaal noq xye'arik pan q'ab' i QaJaaw Dios.</para>
  <para style="p">
    <verse number="89" style="v" />Eh noq re' i Moisés xokik chupaam i santo laj itz'ihy naah paat molb'al iib', chi q'orob'jiik i QaJaaw Dios, eh xrib'iraj chi xq'orob'jik cho ruum i QaJaaw Dios, pankiyejaal i kiib' chi k'achaach wilik kixiik' wilkeeb' chinaah i tz'apb'al naah i loq'laj kaxa i molarik wii' i ruk'uhb'aal i Dios.</para>
  <chapter number="8" style="c" />
  <para style="s">Re' i ruq'orariik nik' naa ruqopiik taqe i saqumb'al</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili xuq'or reh i Moisés: <verse number="2" style="v" />Re' hat cha q'or reh i Aarón kajaaw i k'amal kib'eeh aj tiij noq naa rutusum wach wuquub' chi saqumb'al ar naakisihq'iniik reje chuwach i ye'aab' kantela wuquub' i naah, inki. <verse number="3" style="v" />Eh re' i Aarón xub'an wo' hoq i xuq'or QaJaaw Dios reh i Moisés xutus wo' kiwach i saqumb'al reh chi ar sihqinik reje chuwach i ye'aab' kantela. <verse number="4" style="v" />Re' i ye'aab' kantela re' re', oro korjinaq wii' ch'eyooj wach chi korik ruuk' tuhyb'al kalawux xelik johtoq ko chi raa' xponik ko chi ju' tz'apaab' wach ruhtz'ub'aal, xuye'jaa' wo' chi korik je' rukab' i xq'orarik reh i Moisés ruum i QaJaaw Dios.</para>
  <para style="s">Re' noq xikuxeesjik taqe i aj Levíta</para>
  <para style="p">
    <verse number="5" style="v" />Re' i QaJaaw Dios je' wili xuq'or reh Moisés: <verse number="6" style="v" />Re' hat cha sik' kiwach i aj Levíta chi kixilak i aj Israel nee nasaqb'isaj kiwach. <verse number="7" style="v" />Je' wili i naa a'nam chi saqb'eesb'al kiwach naa achihkaam wach kinaah i ha' inkamanik chi saqb'eesb'al wachiis. Eh naa aq'orom keh chi naa kijoyom chu'nchel i kismaal jun pa'lik. Naa wo' kitz'ajam i kiso' reh chi nee kikahnik chi saq kiwach. <verse number="8" style="v" />Eh chi riij i re' naa kiq'asam chi kimayiij jinaj i k'isa imas wakax. Eh k'isiin i holohik laj arina xilakimaj ruuk' aseite, eh jinaj wo' chik i k'ijol wakax naakiq'aasam chi mayiij pahqb'al kuyb'al mahk. <verse number="9" style="v" />Eh re' naa aq'orom keh i aj Levíta chi naakijilim i koq kiib' chi chii' i santo laj itz'ihy naah paat molb'al iib'. Eh nee wo' namol kiwach i chu'nchel i aj Israel. <verse number="10" style="v" />Eh noq kimolom chik kiib' chi nuwach i aj Levíta chu'nchel i aj Israel naakiye'em i kiq'ab' chikinaah i aj Levíta. <verse number="11" style="v" />Eh re' i Aarón naa ruq'asam, chi nuwach i hin, hin ki Dios taqe i aj Levíta chi jilow kimayiij taqe i aj Israel reh chi naa kianam i nukamaj. <verse number="12" style="v" />Re' taqe i aj Levíta naakiye'em i kiq'ab' wach kinaah taqe i kiib' chi k'ijol wakax, jinaj i naa kiq'asam chi mayiij chi nuwach reh pahqb'al kuyb'al mahk. Eh jinaj i naa kiq'asam chi k'atoj mayiij chi riij i kimahk i aj Levíta. <verse number="13" style="v" />Eh naa aq'asam taqe i aj Levíta chuwach i Aarón, eh chikiwach i rak'uun. Eh noq wilkeeb' chik ar naa kiq'asam chi mayiij chi nuwach i hin, hin Dios. <verse number="14" style="v" />Chi je' re' naa taqe awesam chi kixilak i aj Israel taqe aj Levíta reh chi nee kikahnik chi weh taqe. <verse number="15" style="v" />Eh chi riij i re', re' taqe i aj Levíta naa rojiik kianam i kikamaj chupaam i santo laj itz'ihy naah paat molb'al iib'. Re' hat inchol asaqb'isam kiwach, eh naa taqe aq'asam chi nuwach chi jinaj nim wach mayiij. <verse number="16" style="v" />Re' taqe i aj Levíta xnusik' cho kiwach chi kixilak i aj Israel reh chi naa kianam i nukamaj. Re' hin xnuk'ul chi jilow taqe i peet kak'uun, chu'nchel i aj Israel. <verse number="17" style="v" />Ruum chu'nchel i peet kak'uun i aj Israel, je' wo' i peet kak'uun i kichikoop, xa re' wo' noq xi kahnik chi weh noq xnukansaj taqe chaloq chu'nchel i peet kak'uun i aj Egipto, i peet rak'uun i kichikoop. Ar xnuko'leej kiij chi weh taqe chu'nchel i peet kak'uun i aj Israel. <verse number="18" style="v" />Je' re' noq yu'naak xnusik' kiwach i aj Levíta chi weh taqe chi kijilow i peet kak'uun i aj Israel. <verse number="19" style="v" />Re' hin xnusik' kiwach i aj Levíta chi kixilak i aj Israel xnukoj taqe chi to'ool reh i Aarón, chi to'ool keh i rak'uun reh chi naa kianam i nukamaj chupaam i santo laj itz'ihy naah paat molb'al iib'. Re' chi neenkireq kuyb'al kimahk wuuk' chu'nchel i aj Israel. Reh chi ma' xtaj i ti' k'axik neen kik'ul, neenkijil i koq kiib' ruuk' i santo laj itz'ihy naah paat inki i Dios.</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' i Moisés, re' i Aarón, eh chu'nchel i aj Israel, xkian wo' kuuk' i aj Levíta i xuq'or i QaJaaw Dios reh i Moisés. <verse number="21" style="v" />Eh re' taqe i aj Levíta xkisaqb'isaj wo' kiib' xkitz'aj wo' hoq i kiso'. Eh re' i Aarón xq'asanik keh chi nimaq wach mayiij chuwach i QaJaaw Dios. Eh xuq'asaj wo' hoq i mayiij chikiij saqb'eesb'al kiwach. <verse number="22" style="v" />Eh chi riij taqe re' i aj Levíta xooj wo' kian i rukamaj i Dios chupaam i santo laj itz'ihy naah paat molb'al iib', eh re' i Aarón xk'amwik kib'eeh ruch'ihil taqe i rak'uun. Eh nik' wach i xuq'or Dios reh i Moisés chikiij i aj Levíta je' wo' re' i xb'aan kuuk'.</para>
  <para style="s">Re' ruq'orariik nik' najtiil naa kianam i rukamaj i Dios i aj Levíta</para>
  <para style="p">
    <verse number="23" style="v" />Re' i QaJaaw Dios je' wili xuq'or reh i Moisés: <verse number="24" style="v" />Re' taqe i aj Levíta noq naakitik'aam i nukamaj chupaam i santo laj itz'ihy naah paat molb'al iib' wilik keh i hoob' ru ka'winaq haab'. <verse number="25" style="v" />Eh noq naakiponiik lajeeb' roxk'ahl haab' naa wo' chik kikanaam rub'aan i nukamaj ma' jaruuj chik naa kianam chi jumpech. <verse number="26" style="v" />Eh nee wo' rub'an chi neenkitow i kuch aj Levíta ruuk' i xa chib'ih i kamanik imb'aan chupaam i santo laj itz'ihy naah paat molb'al iib'. Xa re' la' ma' naa ta chik kianam i kamanik je' rukab' inki a'n cho pampeet. Re' hat je' re' ruyejeb'jiik i kikamaj i aj Levíta naa a'nam, inki weh i Dios.</para>
  <chapter number="9" style="c" />
  <para style="s">Re' runinq'ijiik i elik chaloq Egipto</para>
  <para style="p">
    <verse number="1" style="v" />Chupaam i peet poh reh i rukab' haab' keliik chaloq i aj Israel pan tinamit Egipto, re' i QaJaaw Dios je' wili xuq'or reh i Moisés chupaam i ye'aab' chiq yuuq' Sinaí: <verse number="2" style="v" />Re' taqe i aj Israel koruman chi naa kik'sam i ninq'iij ruum keliik chaloq Egipto chupaam i q'iij nuq'orom chaloq. <verse number="3" style="v" />Iraaj ruq'orom chi naakik'sam chupaam i ruxq'eqiil i kajlaj rub'eeh i poh wili. Eh naa kianam chu'nchel nik' wach i rub'aan i nuq'orom keh, eh je' wo' rukab' i tz'ihb'amaj rehtaliil chupaam i nuk'uhb'aal, inki.</para>
  <para style="p">
    <verse number="4" style="v" />Je' re' noq re' i Moisés xuq'or keh i aj Israel chi naa kininq'ijeem i keliik chaloq Egipto. <verse number="5" style="v" />Eh re' taqe i aj Israel xkininq'ijeej wo' hoq i keliik chaloq Egipto paruxq'eqiil reh i kajlaj rub'eeh i poh re' re' chupaam i ye'aab' chiq yuuq' Sinaí. Xkian wo' chu'nchel i xuq'or QaJaaw Dios reh i Moisés.</para>
  <para style="p">
    <verse number="6" style="v" />Eh chupaam i q'iij re' re' kiib' ixib' taqe i winaq ma' xkian taj i ninq'iij re' re' ruum ch'uwa' kiwach ruum i rutz'a'jiik i kamnaq. Eh ruum chi ma' xkian tee ninq'iij re' re' xa chupaam wo' q'iij re' re' xiooj ruuk' i Moisés, eh ruuk' i Aarón. <verse number="7" style="v" />Je' wili xkiq'or:</para>
  <para style="p">Re' hoj korik chi ch'uwa' qawach, ruum i rutz'a'jiik i kamnaq. Eh ¿Chib'ih reet noq xa ruum i re' ma' xye'arik ta q'ab' qeh chi xqaq'asaj i qamayiij chi kixilak i aj Israel chupaam i ninq'iij ruum i keliik cho Egipto? inki taqe.</para>
  <para style="p">
    <verse number="8" style="v" />Eh re' i Moisés je' wili i xuq'or keh:</para>
  <para style="p">Kinawuy-eej pee taq, amb'iraj peet reh i QaJaaw Dios chib'ih pa' nee ruq'or weh taq chawiij, inki.</para>
  <para style="p">
    <verse number="9" style="v" />Eh re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: Re' hat cha q'or keh i aj Israel, <verse number="10" style="v" />chi chu'nchel i kak'uun, kiih kimaam i aj Israel ma' xkian taj i ninq'iij xb'aan ruum i keliik cho Egipto ruum i ruch'uwa'iil kiwach ruum i rutz'a'jiik i kamnaq, oon chi wilkeeb' poo panb'iyajo chi najt yuuq koruman chi naa kianam. <verse number="11" style="v" />Xa re' la' ko paruxq'eqiil reh i kajlaj rub'eeh i rukab' poh reh i rukab' haab' naakininq'ijeem. Eh chi naakik'uxum k'ahlaj rax i chaaj, ruuk' i kaxlanwi'k ma' kojooj ta ch'amb'eesb'al reh. <verse number="12" style="v" />Eh ma' xtaj i rutib'kaal i mayijimaj chikop naakikanaam chi kochi junwaar ta neenkik'ux, eh ma' naa ta wo' kitoqom jino'q i rub'aqil i chikop re' re'. Eh naa wo' kianam i ninq'iij ruum ikeliik cho Egipto je' rukab' rub'aan i nuq'orom keh. <verse number="13" style="v" />Eh awach i xaraaj chi ma' xub'an taj i ninq'iij re' re', eh ma' xta wo' naq ruch'uwa'iil wach, eh ma' xta wo' ponoq panb'iyajo. Re' re' i ruk'ul chi naa rehtesjiik reje chi kixilak i ruch aj Israel, eh naa rutojom i ru mahk. Ruum chi ma' xuq'asaj taj i rumayiij paruq'ijil chi nuwach i hin, hin Dios.</para>
  <para style="p">
    <verse number="14" style="v" />Eh re' taqe i tokoom tinamit wilkeeb' taq chaxilak nee wo' rub'an chi neenkininqijeej ikeliik cho Egipto i aj Israel ye'b'al nuloq'il i hin. Xa re' la' koruman chi naa rub'anam nik' wach i rub'aan i ninq'iij nuq'orom. Eh naa rub'aan chu'nchel, je' chi keh i tokoom tinamit, je' wo' taq cha weh i hat i aj Israel, inki.</para>
  <para style="s">Re' i santo laj itz'ihy naah paat xuyeew cho riib' i suutz' chinaah</para>
  <para style="r">(<ref loc="EXO 40:34-38">Ex 40.34-38</ref>)</para>
  <para style="p">
    <verse number="15" style="v" />Chupaam i q'iij noq xkorjik i santo laj itz'ihy naah paat re' i moloj wii' i k'uhb'aal, pan q'iij suutz' i ruyeew cho riib' chinaah korehtaal inokik i q'iij. Eh chaq'ab' q'aaq' i ruyeew cho riib' chinaah i paat re' re' korehtaal insaq'ik. <verse number="16" style="v" />Eh rajlaal i q'iij i ruyeew cho riib' i suutz' chinaah i santo laj itz'ihy naah paat. Eh chaq'ab' q'aaq' i ruyeew cho riib' chinaah. <verse number="17" style="v" />Eh noq re' suutz' i nelik cho chinaah i santo laj itz'ihy naah paat re' taqe i aj Israel inkuksaj chaloq, eh inkuksaj cho chu'nchel i kiye'aab', eh inkichop wo' chik cho kib'eeh. Eh aha' imponik pahoq i suutz' ar inkiyejaa' ki-itz'ihy naah paat i aj i Israel. <verse number="18" style="v" />Eh noq inq'orarik keh ruum i QaJaaw Dios i aj Israel chi naa kichopom cho kib'eeh kichalik wo' hoq, eh noq i nq'orarik keh chi naa kikahnik ar, kikahnik wo' ar nik' najtiil i rub'an i suutz' chinaah i santo laj itz'ihy naah paat. <verse number="19" style="v" />Eh noq re' i suutz' najt i rub'an chinaah i santo laj itz'ihy naah paat. Re' taqe i aj Israel ma' kielik ta wo' cho ar, xkian wo' hoq je' rukab' i xuq'or i Dios. <verse number="20" style="v" />Eh noq re' suutz' xama' k'ih ta laj q'iij i rub'an chinaah i santo laj itz'ihy naah paat. Noq inq'orarik keh ruum i QaJaaw Dios chi naa kichopom chee kib'eeh kichalik wo' hoq, eh noq i nq'orarik keh chi konaakikahniik ar, kikahnik wo' hoq. <verse number="21" style="v" />Wilik pech noq xa jinaj aq'ab' i rub'an i suutz' chinaah i santo laj itz'ihy naah paat, eh parusaq'iik i nelik wo' chik. Eh re' taqe i aj Israel inkichop wo' chik cho kib'eeh. Nik' wach inki a'n pan q'iij je' wo' re' inki a'n chaq'ab' noq i nelik chee suutz' inkichop cho kib'eeh. <verse number="22" style="v" />Eh wilik pech noq re' suutz' inwihik kiib'-oq q'iij, jino'q poh, oon jino'q haab' chinaah i santo laj itz'ihy naah paat, xama' i kichop ta wo' chaloq i kib'eeh. Eh noq i nelik i suutz' jumehq'iil inkichop chee kib'eeh. <verse number="23" style="v" />Eh noq i ruq'or i QaJaaw Dios keh i aj Israel chi konaa kikahniik ko kikahnik wo' hoq. Eh noq inq'orarik keh chi naa kichopom chee kib'eeh kielik wo' chaloq. Eh xkian wo' hoq nik' wach i xuq'or QaJaaw Dios reh i Moisés.</para>
  <chapter number="10" style="c" />
  <para style="s">Re' ruq'orariik chi xkorjik i kiib' chi tuun re' ruuk' i plata</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="2" style="v" />Re' hat cha yejaa' kiib' chi tuun re' ruuk' i plata neenach'ey wach ruuk' tuyb'al kalawux. Reh chi neen kamanik aweh molb'al kiwach i tinamit, eh noq neenkijal kiye'aab'. <verse number="3" style="v" />Eh noq neenxuuljik reje kab'chel i tuun chu'nchel i aj Israel neenkimol kiib' chawach panookb'al reh i santo laj itz'ihy naah paat molb'al iib'. <verse number="4" style="v" />Eh wila' xa jinaj chi tuun i neenxuuljik xa re' taqe i k'amal kib'eeh i ju'jun ch'uq chi aj Israel neenkimol kiib' chawach. <verse number="5" style="v" />Eh noq neenxuuljik i tuun ruch'ihil i kowlaj silk' re' taqe i kiyejaam i ki-itz'ihy naah paat chi korkiil reje ireelb'aalq'iij neenkiyejaa' kiib' chi ojik. <verse number="6" style="v" />Eh parukab' i ruxuljiik i tuun, re' taqe i kiyejaam ki-itz'ihy naah paat pansak'aaj reh i rookb'aal i q'iij neenkiyejaa' kiib' chi ojik. Eh noq neenxuuljik i tuun ruuk' i kowlaj silk' re' i rehtaliil elik reje. <verse number="7" style="v" />Eh noq naakimolom kiib' i tinamit ma' q'e' ta q'as naah noq naruxuljiik i tuun. <verse number="8" style="v" />Eh re' i naakixulem i tuun xa re' taqe i k'amal kib'eeh aj tiij, re' taqe i rak'uun i Aarón. Re' i k'uhb'aal wili aweh taq i hat chi juneliik, eh keh wo' taqe kahnoq awiih aamaam.</para>
  <para style="p">
    <verse number="9" style="v" />Eh re' wo' taqe i tuun wili naa taq axulem ruuk' kowlaj silk' noq naa taq awojiik chi q'aq'inik pan tokoom tinamit kuuk' i aj ixowaal, oon noq neekik'uloq taq panatinamiit i aj ixowaal. Eh re' hin, hin taq aaDios naa taq ak'uliik cho panuk'ux, eh naa taq kaat nuko'leem pan kiq'ab' i aj ixowaal. <verse number="10" style="v" />Eh nee wo' inxuuljik taqe i tuun wili noq suq taq ak'ux, re' noq nee taq i na a'n i aninq'iij, noq nee taq i naa ninq'ijeej i ak' poh noq nee taq inaq'asaj ak'atoj mayiij. Eh noq nee taq i naaq'asaj amayiij k'amb'al taq awiib' panotob'il wuuk' i hin. Re' hin nee taq tik'ulik panuk'ux, hin taq aaWaJaaw aaDios, inki.</para>
  <para style="s">Re' najt laj b'ehik xkian i aj Israel noq xi elik chaloq Sinaí</para>
  <para style="p">
    <verse number="11" style="v" />Chupaam i juninaq rub'eeh i rukab' poh reh i rukab' haab' kitik'aam cho b'ehik re' i suutz' xelik chinaah i santo laj itz'ihy naah paat moloj wii' i k'uhb'aal. <verse number="12" style="v" />Eh re' taqe i aj Israel xi elik cho chupaam i chiq yuuq' wilik Sinaí. Eh re' i suutz' ink'amwik kib'eeh ar chik xooj pa'lojoq chupaam i ye'aab' chiq yuuq' wilik Parán. <verse number="13" style="v" />Nik' wach i xq'orarik cho reh i Moisés ruum i QaJaaw Dios je' wo' re' chalik xkian. <verse number="14" style="v" />Eh re' peet ch'uq xi chalik chi peet b'eeh re' taqe i riih rumaam i Judá peet chikiwach i kitz'ihy kehtalil. Eh re' i Naasón i rak'uun i Aminadab ink'amwik kib'eeh. <verse number="15" style="v" />Eh chi riij taqe re' xam taqe chaloq i rukab' ch'uq, re' taqe i riih rumaam Isacar. Re' Natanael rak'uun i Zuar ink'amwik kib'eeh. <verse number="16" style="v" />Eh chi riij i re' xam taqe chaloq i roox ch'uq re' taqe i riih rumaam Zabulón, re' Eliab rak'uun i Helón ink'amwik kib'eeh.</para>
  <para style="p">
    <verse number="17" style="v" />Eh chi riij i re' xam taqe chaloq i Gersón ruch'ihil i riih rumaam i Merari xkiyoj i santo laj itz'ihy naah paat xkik'am chaloq.</para>
  <para style="p">
    <verse number="18" style="v" />Eh chi riij taqe re' xam chaloq i jun ch'uq re' taqe riih rumaam Rubén, peet chikiwach i kitz'ihy kehtalil. Re' Elisur rak'uun i Sedeur ink'amwik kib'eeh. <verse number="19" style="v" />Eh chi riij taqe re' xam taqe chaloq i junch'uq, re' taqe riih rumaam Simeón, re' Selumiel rak'uun i Zurisadai ink'amwik kib'eeh. <verse number="20" style="v" />Eh chi riij taqe re' xam chaloq i junch'uq, re' taqe i riih rumaam i Gad, re' Eliasaf, rak'uun i Reuel ink'amwik kib'eeh. <verse number="21" style="v" />Eh chi riij taqe i re' xam chaloq i junch'uq, re' taqe i riih rumaam i Coat. Re' taqe i kik'amwik reh chu'nchel i wilik kiloq'il i kikamanik parukamaj i Dios. Re' keh korjinaq chik i santo laj itz'ihy naah paat noq kiponik.</para>
  <para style="p">
    <verse number="22" style="v" />Eh chi riij taqe re' xam chaloq i junch'uq, re' taqe i riih rumaam Efraín peet chikiwach i kitz'ihy kehtalil. Eh re' i Elisama rak'uun i Amiud ink'amwik kib'eeh. <verse number="23" style="v" />Eh chi riij taqe i re' xam chaloq i junch'uq, re' taqe i riih rumaam i Manasés, eh re' i Gamaliel i rak'uun i Pedasur ink'amwik kib'eeh. <verse number="24" style="v" />Eh chi riij taqe i re' xam chaloq i junch'uq, re' taqe i riih rumaam Benjamín, eh re' Abidán rak'uun i Gedioni ink'amwik kib'eeh.</para>
  <para style="p">
    <verse number="25" style="v" />Eh chi riij taqe i k'ih ch'uq re' re' xam b'eeh xi kahnik i junch'uq, chi riih rumaam Dan peet chikiwach i ki-itz'ihy kehtalil, eh re' i Ahiezer rak'uun i Amisadai ink'amwik kib'eeh. <verse number="26" style="v" />Eh chi riij taqe re' xam chaloq i junch'uq, re' taqe i riih rumaam Aser, eh re' Pagiel rak'uun i Ocrán ink'amwik kib'eeh. <verse number="27" style="v" />Eh chi riij taqe i re' xam chaloq i junch'uq, re' taqe i riih rumaam i Neftalí, eh re' i Ahira rak'uun i Enán ink'amwik kib'eeh.</para>
  <para style="p">
    <verse number="28" style="v" />Je' aj wili rutusariik kiib' inki a'n chi ch'uhqaal chu'nchel i aj Israel noq inkichop cho i kib'eeh.</para>
  <para style="s">Re' i Moisés xuq'or reh i rub'aluk chi naa ruch'ihljiik ruum</para>
  <para style="p">
    <verse number="29" style="v" />Eh pan jinaj q'iij re' i Moisés xuq'oreej i rub'aluk, re' i Hobab rak'uun i Reuel aj Madián:</para>
  <para style="p">Re' hoj naaqojiik chupaam i tinamit ruq'orom i QaJaaw chi naa ruye'em qeh. Eh re' hat neerub'an chi nee tiooj chiqij suq nee ti wihik quuk', ruum re' i QaJaaw Dios naakooj rutob'eem, inki.</para>
  <para style="p">
    <verse number="30" style="v" />Eh re' Hobab je' wili ruchaq' wesjiik xub'an:</para>
  <para style="p">Re' hin ma' ruk'ul ta chi nee kinooj taq chawiij naa la' nusutiniik reje panuyuq'ul re' wilkeeb' cho wii' taqe awach weh, inki.</para>
  <para style="p">
    <verse number="31" style="v" />Eh re' i Moisés je' wili ruchaq'weesjiik xub'an:</para>
  <para style="p">Maaqoh akanaa' tii re' hat awehtaal aha' nee ruk'ul chi nee qohi'lik chupaam i ye'aab' chiq yuuq', neetikamanik qeh chi k'uhtan qab'eeh. <verse number="32" style="v" />Wila' xat'ooj chiqiij nee tiqunej i naa ruye'em qeh i QaJaaw Dios ruuk' i rotob'il, inki.</para>
  <para style="p">
    <verse number="33" style="v" />Eh re' taqe i aj Israel xi elik cho chinaah i yuuq' Sinaí ruye'aab' i QaJaaw Dios. Eh ixib' q'iij xib'ehik chaloq peet chikiwach i looq' laj kaxa molik wii' i k'uhb'aal, k'ahchi' keeb' chusik'ariik i ye'aab' aha' naakihi'liik wii'. <verse number="34" style="v" />Eh xa re' wo' noq inkichop cho kib'eeh pan q'iij re' junsahl chi suutz' i rutaq'aaj chee QaJaaw xanoq wo' ruyeew cho riib' chikinaah. <verse number="35" style="v" />Eh noq intohq'ik cho kib'esam i loq'laj kaxa molik wii' i k'uhb'aal, re' i Moisés je' wili ruq'or:</para>
  <para style="b" />
  <para style="q">QaJaaw Dios qoh atoob'eej</para>
  <para style="q">chatukej kiwach i ki-ixowanik awach,</para>
  <para style="q">eh noq neenkilow awajaawriik nee ta naq inkimol chi elik, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" />Eh noq inkiyeew chi hi'lik i loq'laj kaxa, re' i Moisés je' wili i ruq'or:</para>
  <para style="b" />
  <para style="q">QaJaaw Dios nee ta naq ti chalik wih-oq chi kixilak</para>
  <para style="q">i aj Israel wili, inki.</para>
  <chapter number="11" style="c" />
  <para style="s">Re' i QaJaaw Dios xutaq'aaj taqe chaloq i k'oot chi kitiib' i aj Israel</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe i aj Israel kiwech'uj i Dios ruum i wilkeeb' pan k'axkiil. Eh noq xrib'iraj i QaJaaw Dios chi je' re' xchalik rujosq'iil, ruum i re' xutaq'aaj chee q'aaq' chikinaah xq'op ruq'aq'al i chi junsuut i kiye'aab' wilkeeb' wii'. <verse number="2" style="v" />Eh noq xkilow chi je' re' i tinamit xkipahqaaj kitoob'jiik reh i Moisés. Eh re' i Moisés xupahqaaj i rotob'il i Dios, eh re' i q'aaq' jumehq'iil chuhpik. <verse number="3" style="v" />Ruum aj re', re' i ye'aab' re' re' Tabera i rub'ihnaal xkahnik ruum re' i QaJaaw Dios ar xuqop cho ruq'aq'al i kiye'aab'.</para>
  <para style="p">
    <verse number="4" style="v" />Eh chi kixilak i aj Israel wilik taqe i tokoom tinamit xi chalik, xa re' suq laj wi'k inkikapaaj. Eh re' taqe i aj Israel xkian jinaj wach kikapeew kuuk' xkitoq'aa' wo' chik oq'ik i keh, je' wili xkiq'or: Awach ta naq neen ye'wik qatiib', inki taqe. <verse number="5" style="v" />Re' hoj ink'ulik cho panqak'ux chi xa chi siih inqak'ux chaloq i suq laj kar ar Egipto je' wo' noq inqak'ux taqe i pepino, taqe melon, taqe puerro, taqe sib'olix, taqe i aanxux. <verse number="6" style="v" />Eh raaj i yu'naak ayu' xakimik chik qeh ruum i qawa' qahaa' xti xa re' wo' chik i maná k'achi' qak'uxum, inki taqe.</para>
  <para style="p">
    <verse number="7" style="v" />Re' i maná q'an tolotaq naq'wach je' naq'wach kulanto je' ruq'olil chee'. <verse number="8" style="v" />Re' taqe i aj Israel imponik kimol i maná, eh inkike'j wach kaa' eh wilik pech noq xan kipuch' naah. Eh i re' inkichaq'saj pan ch'ihch' xun, eh inkiyejaa' chi kaxlanwi'k. Re' rusuqkiil xa je' chik suq kiil ak' laj aseite. <verse number="9" style="v" />Eh pantaq chaq'ab' noq i nqajik chee musjab' chinaah i ye'aab' wilik wii' i ki-itz'ihy naah paat inqajik wo' cho haa' i maná.</para>
  <para style="p">
    <verse number="10" style="v" />Re' i Moisés xrib'iraj chi oq'ik inki a'n i aj Israel kuch'ihil taqe awach keh chi chii' i ki-itz'ihy naah paat. Eh re' i QaJaaw Dios ma' k'isiin taj i ruk'aah chikinaah, je' wo' hoq i Moisés ma' suq ta wo' xub'an reh. <verse number="11" style="v" />Ruum i re' je' wili i xuq'or reh i QaJaaw Dios:</para>
  <para style="p">¿Chib'ih reet noq i na a'n ti' k'axik weh i hin, hin awaj kamanoom? ¿Chib'ih jariik i numahk chawach chi xayeew i ihq chi nunaah reh i kik'amariik reje i tinamit wili? <verse number="12" style="v" />¿Hin ta nche kituut kajaaw, noq inaq'or weh chi naa nuk'amam taqe reje chi je' kiq'ahchjik reje kok' ha'lak'un koch'uch' kipaam noq naa nuk'amam taqe reje chupaam i ye'aab' aq'orom i xti korik chi naa aye'em keh i kimaam kati't? <verse number="13" style="v" />Re' hin ma' aha' ta naa nuk'amam cho kitiib' i ruk'ihaal tinamit wili, ruuk' oq'ik k'ahchi' kipahqaam kitiib' weh reh chi naakik'uxum. <verse number="14" style="v" />Re' hin ma' nee ta nub'an reje kik'amariik chi wutkeel ruum jinaj ahl laj ihq chi weh. <verse number="15" style="v" />Wila' ma' naa awesam chi nunaah i ihq wili inwaaj i hin chi nee nawesaj i nuk'achariik wila' korik chi kinak'ax, chi je' re' ma' nee ta chik kinik'ik chi ti' k'axik, inki i Moisés.</para>
  <para style="p">
    <verse number="16" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh:</para>
  <para style="p">Chasik' kiwach i aj Israel i lajeeb' ru kajwinaq chi mama' winaq re' ruuk' taqe i k'amal b'eeh. Re' i aweht'al i hat chi kichol taaq'anik chinaah i tinamit nee nak'am taqe cho awuuk' ar chupaam i santo laj itz'ihy naah paat molb'al iib' neekinkuy-eej chi awuch'ihil taqe. <verse number="17" style="v" />Re' hin naa nuqajiik cho chaq'orob'jiik i hat naa nuye'em keh i uxlab'al je' rukab' i xnuyeew aweh i hat chi je' re' naa kaat kito'om chuk'amariik kib'eeh i tinamit reh chi ma' awutkeel ta chik nee nak'am taqe reje. <verse number="18" style="v" />Eh neenaq'or keh i tinamit chi kisantoheej kiib'. Re' hin naa nuye'em kitiib'. Ruum re' hin xb'iraj chik koq'iim je' wili inkiq'or: Awach ta naq neen ye'wik qatiib', xti suq wo' naq wilkooj cho ar Egipto, inki taqe. Eh re' hin naa nuye'em kitiib' reh chi naa kik'uxum. <verse number="19" style="v" />Re' wili ma' xata jinaj q'iij naa nuye'em kitiib', ma' xata kiib' q'iij, ma' xata hoob' q'iij, ma' xata lajeeb' q'iij, ma' xata juninaq q'iij. <verse number="20" style="v" />Naa la' nuye'em taqe chuk'uxariik i tiwik chuwach i jinaj poh korehtaal kinujik korehtaal i nelik cho pan kiju'. Ruum ma' ximponik ta panaq' kiwach i hin, eh wilkiin wo' naq chi kixilak xkimol chi oq'ik je' wili inkiq'or: Chib'ih inche reet noq xoj elik cho Egipto suq wo' naq wilkooj ar, inki taqe, inki Dios.</para>
  <para style="p">
    <verse number="21" style="v" />Eh re' i Moisés je' wili ruchaq' wesjiik xub'an:</para>
  <para style="p">Re' taqe i tinamit xi chalik chi wiij chi kooq waq'iib' siento miil taqe chu'nchel. Eh inaq'or i hat chi naa aye'em qeh chi k'uxarik i tiwik chuwach i jinaj poh. <verse number="22" style="v" />¿Eh aha' neenkan i ma' k'isa tentzun, i ma' k'isa wakax, reh chi neekikanteesjik, eh chi neenmanlojik chi kitiib' chuwach i jinaj poh? Neeta naq inye'arik chi kitiib' chu'nchel i kar wilkeeb' taqe chupaam i palaw xama' nee ta wo' naq i manlojik keh, inki.</para>
  <para style="p">
    <verse number="23" style="v" />Eh re' QaJaaw Dios je' wili i ruchaq'weesjiik i Moisés xub'an:</para>
  <para style="p">¿Mi nakapaaj re' hat chi ma' xta wajaawriik chub'aan i nuq'or wili? Yu'naak naa awilom i mi nee nub'an, oon ma' nee ta nub'an, inki.</para>
  <para style="p">
    <verse number="24" style="v" />Re' i Moisés xelik chaloq xuq'or keh i tinamit i xq'orarik reh ruum i QaJaaw Dios, xumol kiwach i lajeeb' ru kajwinaq chi k'amal b'eeh chi kixilak i aj Israel. Eh xutus taqe chi junsuut i santo laj itz'ihy naah paat. <verse number="25" style="v" />Re' i QaJaaw Dios xqajik cho pan suutz' xk'ulik rub'an ruk'utaaj ruuk' i Moisés, eh xuyeew keh i uxlab'al i lajeeb' ru kajwinaq chi k'amal b'eeh, je' rukab' i uxlab'al wilik ruuk' i Moisés. Eh noq xkik'ul i uxlab'al re' re' xiq'orik chi je' kiq'orik jalal ruq'oral i Dios. Xa re' la' ma' kota chik xkian chi jumpech.</para>
  <para style="p">
    <verse number="26" style="v" />Eh kiib' taqe i winaq jinaj Eldad i b'ih, eh jinaj i Medad re' ruuk' taqe i lajeeb' ru kajwinaq ma' xiooj taj chupaam i santo laj itz'ihy naah paat xi kahnik chupaam i ki-itz'ihy naah paat i keh, eh ar xkik'ul i uxlab'al re' re'. Eh xiq'orik chi je' kiq'orik i jalal ruq'oral i Dios chupaam i kiye'aab'. <verse number="27" style="v" />Eh jinaj i k'ijool xooj rajimam riib' ruuk' i Moisés, je' wili i xuq'or reh:</para>
  <para style="p">Re' i Eldad, i Medad k'ahchi' kiq'oriik chi je' kiq'orik jalal ruq'oral i Dios chupaam i ki-itz'ihy naah paat, inki.</para>
  <para style="p">
    <verse number="28" style="v" />Eh re' i Josué rak'uun i Nun, re' i paruk'ijolal xtohq'ik cho ruto'om i Moisés, je' wili xuq'or:</para>
  <para style="p">Wajaaw Moisés chaq'il taqe chub'aan reh chi ma' nee ta chik kiq'orik chi je' re', inki.</para>
  <para style="p">
    <verse number="29" style="v" />Re' i Moisés je' wili i chaq'wik xub'an:</para>
  <para style="p">¿Minakapaaj re' hat chi ti' inwik'raaj chi je' re' i k'achi' keeb'? Re' hin q'e' naq neensuuqb'ik nuk'ux chi nee ta ruyeew i Ruxlab'al QaJaaw chikinaah chu'nchel i aj Israel, chu'nchel naq nee kikahnik chi jalal ruq'oral i Dios taqe, inki.</para>
  <para style="p">
    <verse number="30" style="v" />Eh re' i Moisés ruch'ihil taqe i winaq i k'amal kib'eeh i aj Israel xi sutinik wo' chik chaloq chupaam i ki-itz'ihy naah paat.</para>
  <para style="s">Re' i QaJaaw Dios xutaq'aaj taqe chaloq i tz'ikin re' ruuk' taqe i k'oot</para>
  <para style="p">
    <verse number="31" style="v" />Re' i QaJaaw Dios xuyeew chaloq i kowlaj teew chi korkiil reje i palaw, eh xuk'am chaloq i ruk'ihaal k'oot, xakirupik chik xi k'ulik qajoq chinaah taqe i ki-itz'ihy naah paat i aj Israel. Eh je' naa jinaj q'iij chi b'ehik i ye'aab' xkitz'ap naah chi junsuut i kiye'aab', eh je' naa jinaj b'ara rupimiil chinaah i wach ak'al i xi wihik wii'. <verse number="32" style="v" />Eh re' taqe i aj Israel xkimol chupaam i q'iij re' re', eh ki-ik'ik aq'ab', eh xakok'ahchi' wo' kimolom chi junwaar. Re' taqe i ma' q'e' ta k'ih xkimol lajeeb' tuhb' chi k'oot xkimol, eh tohq'ik kichiqsam wach chi junsuut i ki-itz'ihy naah paat. <verse number="33" style="v" />Eh re' taqe i aj Israel xa kore' wo' naq xtohq'ik i koq kik'uxum i k'oot re' re', noq xuyeew chee rujosq'iil i QaJaaw Dios chikinaah. Jinaj iyiib' wach yab'ilaal xutaq'aaj cho chikinaah, eh ma' k'isiin i xikimik. <verse number="34" style="v" />Ruum aj re', re' ye'aab' re' re' Kibrot-hataava i rub'ihnaal xkikoj ruum ar ximuhq'ik nik' k'ihaal i xikimik, re' taqe i xa re' suq laj wi'k inkikapaaj.</para>
  <para style="p">
    <verse number="35" style="v" />Eh noq re' taqe i aj Israel xi elik reje chupaam i ye'aab' Kibrot-hataava, ar chik xiooj chupaam i ye'aab' Hazerot, ar xi hi'lik.</para>
  <chapter number="12" style="c" />
  <para style="s">Re' i María, i Aarón ma' holohik ta xiq'orik chi riij i Moisés</para>
  <para style="p">
    <verse number="1" style="v" />Re' María, i Aarón ma' holohik ta xiq'orik chi riij i Moisés ruum chi xuk'am chi rehk'een ixoq aj kusita tokoom tinamit. <verse number="2" style="v" />Eh je' wili xkiq'or: ¿Mi xa ruuk' re' i Moisés inq'orik QaJaaw Dios? ¿Mi ma' quuk' re' i hoj xq'orik? inki taqe. Eh re' i QaJaaw xrib'iraj i xkiq'or.</para>
  <para style="p">
    <verse number="3" style="v" />Eh re' i Moisés xa re' wo' reh xti q'e' inlochi'k chikiwach chu'nchel i winaq wilkeeb' wach ak'al. <verse number="4" style="v" />Eh re' i QaJaaw Dios je' wili xuq'or reh i Moisés, reh i Aarón, reh i María: Re' taq i hat aawoxcheel hiy taq chupaam i santo laj itz'ihy naah paat molb'al iib', inki.</para>
  <para style="p">Eh xiooj wo' koxcheel. <verse number="5" style="v" />Eh re' i QaJaaw Dios xqajik cho chupaam i junsahl chi suutz' xk'ulik ruyeew riib' chi chii' i santo laj itz'ihy naah paat. Eh chi jumehq'iil xuyuq'eej ruuk' i Aarón, i María. <verse number="6" style="v" />Eh je' wili i xuq'or keh: Chab'iraj taq chi korik i naa nuq'orom aweh: Noq neen wihik jino'q i jalal nuq'oral taq chaxilak re' hin xaparusaq wiriik neeril nuwach, oon xa paruwiriik neenuq'o'reej. <verse number="7" style="v" />Eh ruuk' i waj kamanoom Moisés ma' je' ta re' i nub'an, ruum xa re' wo' reh korik wach ruk'ux wuuk' chikiwach chu'nchel i waj kamanoom. <verse number="8" style="v" />Re' reh xnub'an nuk'utaaj ruuk' chi korik ma' re' ta panjalwaach q'orik kinq'orik ruuk' manlik wach i q'orik i nuq'or reh, hoj k'ulwach ruuk' noq i nub'an nuk'utaaj ruuk'. Eh ¿Nik' wach noq ma' xat yo'jik ta taq noq xa a'n taq i ma' holohik ta laj q'orik chi riij? inki.</para>
  <para style="p">
    <verse number="9" style="v" />Re' i QaJaaw Dios ma' k'isiin ta xchalik i rujosq'iil chikinaah noq xelik reje kuuk'. <verse number="10" style="v" />Eh xelik reje i junsahl chi suutz' chi chii' i santo laj itz'ihy naah paat, eh chupaam i jumehq' re' re' xsutinik chi rax q'aah i riij i María, saqreq'ik chik wach chu'nchel i ruti'jolal. Eh noq re' i Aarón i xrilow i María xikoj retaal chi tolin chik rax q'aah i riij. <verse number="11" style="v" />Re' Aarón je' wili i xuq'or reh i Moisés: Chakuy jaaw maa qohayeew tii chi tojariik i qamahk xqa'an, ruum re' i mahk wili xa qamemil xqa'an wii'. <verse number="12" style="v" />Mayeew q'ab' chi neensalooj taqe iloq i ruti'jolal je' rukab' noq insalooj iloq i ruti'jolal i k'isa ha'lak'un kamnaq noq inasjik ruuk' i rutuut, inki.</para>
  <para style="p">
    <verse number="13" style="v" />Eh re' i Moisés xub'an rutiij chuwach i Dios je' wili xuq'or: QaJaaw Dios cha a'n tii otob'il chak'achrisaj qeh i María, inki.</para>
  <para style="p">
    <verse number="14" style="v" />Eh re' i QaJaaw Dios je' wili xuq'or reh i Moisés: Wita neenchuhb'jik i panaq'wach ruum i rajaaw nee naq inchalik ruk'ixiik, nee naq i rukeb'aa' riib' wuquub'-oq q'iij. Ruum aj re' yu'naak koruman chi naa awesam taq reje chaxilak wuq'uub'-oq q'iij, eh chi riij i re' kore' chik neensutinik chaloq, inki.</para>
  <para style="p">
    <verse number="15" style="v" />Eh noq xkesaj reje i María chi kixilak chuwach i wuquub' q'iij ma' xkichop ta reje i kib'eeh i aj Israel. <verse number="16" style="v" />Xa re' wo' noq xsutinik chee i María chi kixilak xkichop cho kib'eeh ar xi elik chaloq Hazerot ar chik chupaam i ye'aab' chiq yuuq' wilik Parán xikulik hi'loq.</para>
  <chapter number="13" style="c" />
  <para style="s">Re' taqe i kab'laj xitaq'ab'jik chi rilariik nik' wach wilik i ye'aab' Canaán</para>
  <para style="r">(<ref loc="DEU 1:19-33">Deut 1.19-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili xuq'or reh i Moisés: <verse number="2" style="v" />Re' hat cha taq'aaj taqe kab'laj-oq i winaq wilik kajaawriik, re' taqe k'amal kib'eeh i ju'jun ch'uq chi aj Israel, chi rilariik nik' wach noq wilik i ye'aab' Canaán, re' i naa nuye'em keh i aj Israel.</para>
  <para style="p">
    <verse number="3" style="v" />Eh nik' wach i xq'orarik reh ruum i QaJaaw Dios i Moisés je' wo' re' xub'an, xutaq'aaj wo' taqe chee ilool noq wilik chupaam i ye'aab' chiq yuuq' Parán. Eh re' wo' taqe i wilik kajaawriik chi k'amal kib'eeh i ju'jun ch'uq chi aj Israel, xutaq'aaj. <verse number="4" style="v" />Je' wili i kib'ihnaal. Chi kixilak junch'uq chi riih rumaam Rubén re' i Samúa rak'uun i Zacuur. <verse number="5" style="v" />Chi kixilak i junch'uq chi riih rumaam Simeón, re' i Safat rak'uun i Horí. <verse number="6" style="v" />Chi kixilak i junch'uq chi riih rumaam Judá re' i Caleb rak'uun i Jefone. <verse number="7" style="v" />Chi kixilak i junch'uq chi riih rumaam Isacar re' Igal i rak'uun i José. <verse number="8" style="v" />Chi kixilak i junch'uq chi riih rumaam Efraín re' Oseas rak'uun i Nun. <verse number="9" style="v" />Chi kixilak i junch'uq chi riih rumaam Benjamín re' i Palti rak'uun i Rafú. <verse number="10" style="v" />Chi kixilak i junch'uq chi riih rumaam i Zabulón re' Gadiel rak'uun i Sodi. <verse number="11" style="v" />Chi kixilak i junch'uq chi riih rumaam i Manasés re' ruuk' riih rumaam i José, re' i Gadi rak'uun i Susi. <verse number="12" style="v" />Chi kixilak i junch'uq chi riih rumaam Dan re' Amiel rak'uun i Gemali. <verse number="13" style="v" />Chi kixilak i junch'uq chi riih rumaam i Aser re' Setur rak'uun i Micael. <verse number="14" style="v" />Chi kixilak i junch'uq chi riih rumaam Neftalí re' Nahbi rak'uun i Vapsi. <verse number="15" style="v" />Chi kixilak i junch'uq chi riih rumaam i Gad, re' Geuel rak'uun i Maqui.</para>
  <para style="p">
    <verse number="16" style="v" />Re' taqe re' kib'ihnaal i winaq xutaq'aaj taqe chaloq i Moisés chi rilariik nik' wach noq wilik i ye'aab' Canaán. Eh re' i Moisés xujal wach i b'ih i Oseas rak'uun i Nun, Josué chik i b'ih xukoj.</para>
  <para style="p">
    <verse number="17" style="v" />Eh noq xutaq'aaj taqe chaloq i winaq re' re' i Moisés chi rilariik nik' wach noq wilik i ye'aab' Canaán, je' wili i xuq'or keh:</para>
  <para style="p">Hiy taq chupaam i ye'aab' Neguev, johteen taq chupaam i raxchee'. <verse number="18" style="v" />Eh xti nee taq inawilow cho chi korik nik' wach noq wilik i tinamit re' re'. Eh nee taq inawilow i wilkeeb' ar mi kow kiib', oon ma' kow ta kiib', mi k'ih taqe, oon ma' k'ih ta taqe. <verse number="19" style="v" />Eh nee taq i naa wilow cho chi korik i ye'aab' mi wilik i tinamit chupaam, oon ma' xtaj, mi rax paam ak'al, oon ma' rax ta paam. Eh nee wo' taq i naa wilow taqe i tinamit wilkeeb' chupaam nik' wach i kipaat, mi re' ruuk' xa itz'ihy naah paat, oon re' ruuk' i tz'aq riij. <verse number="20" style="v" />Eh nee taq inawilow mirub'an i tik chuwach i ye'aab', oon ma' rub'an taj, mi wilik chee' chuwach, oon ma' xtaj. Re' taq i hat mat yo'jik taq chak'am taq cho k'isinoq weh i wach i tik i nelik ar, inki.</para>
  <para style="p">Eh noq xi k'ulik taqe i ilool chupaam i ye'aab' re' re' manlik k'achi' reliik i peet wach i uuva. <verse number="21" style="v" />Eh re' taqe i winaq xiooj chi rilariik i ye'aab' ar xkitoq'aa' reje rilariik chupaam i ye'aab' chiq yuuq' wilik ar Zin, xi ponik Rehob, xponik wo' kilow i panookb'al reh i Hamat. <verse number="22" style="v" />Ar xijohtik Neguev, korehtaal xi ponik chupaam i tinamit Hebrón. Eh ar patim i winaq Ahimán, je' wo' Sesai, je' wo' Talmai, re' taqe ruuk' riih rumaam Anac. Eh wuquub' chik haab' rukorjiik i tinamit Hebrón noq xkorjik i tinamit Zoán wilik ar Egipto. <verse number="23" style="v" />Eh xi ponik chupaam i raasb'al ha' Escol rub'ihnaal ar xkich'uq i jun kuht chi uuva, wilik wo' hoq i wach granado xkisik' reje, ruch'ihil i wach higo, xkitehlaaj reje rij chee' pankib'al. <verse number="24" style="v" />Re' i ye'aab' re' re' Escol i rub'ihnaal xkikoj ruum ar xkich'uq reje i junkuht chi wach uuva i aj Israel.</para>
  <para style="p">
    <verse number="25" style="v" />Eh noq re' taqe winaq re' re' xkikohlaaj reje rilariik i ye'aab' Canaán chuwach i ka'winaq q'iij xi sutinik wo' chik reje. <verse number="26" style="v" />Xiponik chupaam i ye'aab' Cades panchiq yuuq' Parán. Eh ar xponik kireq i Moisés ruch'ihil i Aarón, kuch'ihil taqe i aj Israel. Eh xtohq'ik kik'utjaam keh taqe i re', i xk'ulik kilow. Eh xkik'uhtaaj wo' keh i wach i tik i nelik chupaam i ye'aab' re' re'. <verse number="27" style="v" />Eh je' wili xkiq'or reh i Moisés:</para>
  <para style="p">Re' hoj xponik wo' qilow nik' wach noq wilik i ye'aab' xoj ataq'aaj reje wii'. Xti korik wo' hoq chixiik'naah chihojal, re' nelik wii' i suq atoob'. Re' taqe i wili i wach i tik i nelik ar. <verse number="28" style="v" />Eh re' taqe i tinamit patim ar kow kiib', re' kipaat re' ruuk' i tz'aq riij. Eh xqilow wo' kiwach i nimaq kooq winaq re' taqe ruuk' i riih rumaam i Anac. <verse number="29" style="v" />Eh chupaam i ye'aab' Neguev patim taqe i aj Amalec, Chupaam taqe i rax chee' patim taqe i aj heteo, eh re' taqe i aj jebuseo, je' wo' taqe i aj amorreo, eh chi korkiil reje i palaw, chi chii' i nim ha' Jordán patim taqe i aj cananeo.</para>
  <para style="p">
    <verse number="30" style="v" />Eh re' i Caleb xuq'or keh i tinamit chi kimay peet i q'orik ruuk' i Moisés je' wili i xuq'or:</para>
  <para style="p">Re' hin i nuq'or chi nee qohooj chi peleto kuuk', re' chik i hoj nee qoh chopwik naah i ye'aab' re' re', re' hoj neen qa'an rub'aan, inki.</para>
  <para style="p">
    <verse number="31" style="v" />Eh re' taqe i winaq xi ponik haa' je' wili xkiq'or:</para>
  <para style="p">Ma' chih taj ma' nee ta ruyeew riib' ruum re' hoj ma' nee ta inqakuy i peleto kuuk' i tinamit re' re'. Ruum re' keh q'e' kow kiib' chi qawach i hoj, inki taqe.</para>
  <para style="p">
    <verse number="32" style="v" />Eh re' taqe i winaq re' re' xkiq'or keh taqe i aj Israel chi re' ye'aab' xk'ulik kilow ma' holohik taj, je' wili i xkiq'or:</para>
  <para style="p">Re' ye'aab' xponik qilow yiib' wach noq wilik, i rukansaj taqe i rutinamiit. Eh chu'nchel i winaq patim ar xiik' naah ninqaal kooq. <verse number="33" style="v" />Eh xqilow wo' kiwach taqe i q'e' nimaq kooq, re' taqe i riih rumaam Anac. Eh noq wilkooj chi kicheel xama' qoh k'utinik ta wo' hoq xa je' hoj kok' q'eq chili'l noq inqik'raaj qiib', inki taqe.</para>
  <chapter number="14" style="c" />
  <para style="s">Re' taqe i aj Israel ma' holohik ta xiq'orik chi riij i Dios</para>
  <para style="p">
    <verse number="1" style="v" />Eh chu'nchel i aj Israel ki-ik'ik aq'ab' chi k'erik kichii' chi oq'ik. <verse number="2" style="v" />Eh ma' holohik ta xiq'orik chi riij i Moisés, chi riij i Aarón, je' wili i xkiq'or: Xti korik wo' hoq chi ma' xta naq reet chi xoj kimik cho ar Egipto, ma' xta wo' naq reet chi nee qoh kimik ayu' chupaam i chiq yuuq' wili. <verse number="3" style="v" />¿Chib'ih reet noq qoh ruk'amam reje i QaJaaw Dios chupaam i ye'aab' re' re' xa reh chi nee qoh kimik panq'aq'inik, xa reh chi neen kichop naah i qehk'een i qak'uun qixq'uun taqe i aj ixowaal? Xti ruk'ul wo' naq chik chi nee qoh sutinik reje Egipto, inki taqe. <verse number="4" style="v" />Eh kiq'or chikiwach chi je' wili: Qapab'aa' jino'q i k'amal b'eeh reh chi nee wo' chik qoh sutinik reje Egipto, inki taqe.</para>
  <para style="p">
    <verse number="5" style="v" />Re' i Moisés, ruch'ihil i Aarón xtib'ik kik'ux xkik'utzaa' qohoq kiib' korehtaal xkireq wach ak'al ruuk' i yejal kiwach chikiwach chu'nchel i aj Israel kimolom kiib' ar. <verse number="6" style="v" />Eh re' i Josué, ruch'ihil i Caleb re' taqe ruuk' i xi ponik ilwoq reh i ye'aab' Canaán nik' wach noq wilik, xtib'ik kik'ux xkixih i kiso' chikiij. <verse number="7" style="v" />Eh je' wili xkiq'or reh chu'nchel i aj Israel:</para>
  <para style="p">Re' ye'aab' xponik qilowxiik'naah holwochiil. <verse number="8" style="v" />Wila' xojrutoob'eej i QaJaaw Dios nee qoh ruk'am reje chupaam i ye'aab' re' re' neeruq'asaj qeh. Re' ye'aab' re' re' xti nujinaq chi suq atoob'. <verse number="9" style="v" />Xa re' la' re' taq i hat maa q'etwachej taq i QaJaaw Dios, eh matyo'jik taq kuum i tinamit wilkeeb' ar. Xa ma' xta tz'aaq noq naa qa'nam keh xa je' ink'uxarik i kaxlanwi'k, ruum re' keh ma' awach ta naa rutoob'inik keh. Eh re' hoj nakooj rutob'eem i QaJaaw nim rajaawriik. Je' re' noq matyo'jik taq kuum, inki taqe.</para>
  <para style="p">
    <verse number="10" style="v" />Eh re' taqe i aj Israel xkaaj naq kikutum chi ab'aj taqe i winaq re' re'. Eh re' i ruloq'il i QaJaaw Dios xuk'uhtaaj cho riib' chikiwach chupaam i santo laj itz'ihy naah paat molb'al iib'. <verse number="11" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés:</para>
  <para style="p">¿Kojaruuj inkimay i ma' holohik ta laj q'orik chi wiij i tinamit re' re'? Re' keh xama' inkinimaj ta wo' hoq chi wilik wajaawriik atoob' ta xkilow wo' naq taqe i ma' ilooj taj xnub'an chikiwach. <verse number="12" style="v" />Re' hin naa nusacham kiwach ruuk' i kaq yab'ilaal reh chi ma' nee ta kiokik, ma' nee ta nkehchaaj i ye'aab' re' re'. Eh re' hat naa nuk'ihaaxb'isam awiih aamaam naakiponiik chi ruk'ihaal tinamit q'e' kow kiib' chikiwach i keh, inki.</para>
  <para style="p">
    <verse number="13" style="v" />Re' i Moisés je' wili i ruchaq'weesjiik i QaJaaw Dios xub'an:</para>
  <para style="p">Re' hat Jaaw ruuk' awajaawriik xawesaj taqe chaloq i tinamit wili ar Egipto. Eh noq neenkinab'eej taqe i aj Egipto chi nee nakansaj taqe, <verse number="14" style="v" />neenkik'utjaaj reje keh taqe i tinamit wilkeeb' Canaán. Re' keh keht'al wo' hoq chi wilkaat chi kixilak aatinamiit, eh chi re' hat inak'uhtaaj awiib' keh. Eh chi nayeew chee suutz' chikinaah. Eh chi ruuk' i junsahl chi suutz' i nak'am kib'eeh pan q'iij, eh pan chaq'ab' ruuk' i junsahl chi q'aaq' i nak'am kib'eeh. <verse number="15" style="v" />Eh wila' xakansaj taqe i tinamit wili xa ruuk' junk'aam. Re' taqe tinamit kib'iram rib'iral chi wilik awajaawriik je' wili i naa kiq'orom: <verse number="16" style="v" />Re' Dios ma' xub'an ta kikojariik i aj Israel chupaam i ye'aab' ruq'orom naq i xti korik chi naa ruye'em keh, ruum aj re' xukansaj taqe chupaam i ye'aab' chiq yuuq', inko'q taqe. <verse number="17" style="v" />Ruum aj re', QaJaaw Dios, neerub'an chi neenak'uhtaaj chaloq i runimaal awajaawriik, je' rukab' aq'orom chi naa a'nam. <verse number="18" style="v" />Aq'orom chi ma' nchalik ta josq'iil chi jumehq'iil, chi ma' k'isiin i ketelinik wachiis awuuk', chi nakuy kimahk i yiib' wach kina'ojb'al, xa re' la' xanaa wo' taqe aye'em chutojariik i kimahk i aj mahk. Eh chi re' i tuutb'ees ajaab'ees i nayeew taqe chutojariik kimahk i keh, je' wo' i kak'uun kixq'uun kiih kimaam. <verse number="19" style="v" />Ruum chi re' hat xiik'naah i ketelinik wachiis awuuk' cha kuy kimahk i tinamit wili ruuk' i kiyiib' wach na'ojb'al ruum xa a'n wo' chee q'unil kuuk' noq xawesaj taqe cho Egipto, eh korehtaal xi k'uloq chupaam i ye'aab' wili, inki.</para>
  <para style="s">Re' QaJaaw Dios xuyeew taqe chutojariik i kimahk i aj Israel</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' i QaJaaw Dios je' wili ruchaq'weesjiik i Moisés xub'an:</para>
  <para style="p">Ma' xta reet neenukuy kimahk, je' rukab' xapahqaaj weh. <verse number="21" style="v" />Xa re' la' xti korik wo' hoq chi re' hin k'achalkiin, eh re' nuloq'il nujinaq chinaah chu'nchel i wach ak'al. <verse number="22" style="v" />Xa re' la' re' xi-ilwik reh i nuloq'il i xi-ilwik reh taqe i ma' ilooj taj xnub'an chikiwach i aj Egipto, je' wo' taqe i xnub'an chikiwach chupaam i ye'aab' chiq yuuq'. Re' taqe i xata wo' jarub' pech xinkaaj kinkipajam eh ma' xkib'iraj taj i nuq'oral. <verse number="23" style="v" />Ma' jino'q keh naa kianam okik chupaam i ye'aab' nuq'orom rib'iral chi naa nuye'em keh i kimaam kati't. Ma' jino'q keh ma' inkiyeew ta wajaawriik naakokiik ar. <verse number="24" style="v" />Xa re' la' wo' hoq i waj kamanoom Caleb re' reh tokoom i runa'ojb'al chikiwach i junch'uq re' re', eh kirunimaj chi korik ruum i re' naa nuye'em q'ab' reh chi naa rokiik chupaam i ye'aab' xponik rilow. Eh ar wo' naakipatiniik chi jumpech taqe riih rumaam. <verse number="25" style="v" />Ruum chi wilik taqe i aj amalec, aj Canaán panab'eeh wach k'ixkaab'. Re' taq i hat ti sutinoq wo' taq chik iqal chupaam i ye'aab' chiq yuuq' ar taq naa awojiik k'oloq chi chii' i kaq palaw, ki uchjik ruum i Dios.</para>
  <para style="p">
    <verse number="26" style="v" />Eh chi riij i re', re' i QaJaaw Dios je' wili xuq'or reh i Moisés, ruch'ihil i Aarón:</para>
  <para style="p">
    <verse number="27" style="v" />Eh ¿Konik' chik najtiil naa nukuyum i ma' holohik ta laj q'orik inki a'n chi wiij taqe i awuch aj Israel yiib' wach i kina'ojb'al? Re' hin xata wo' jarpech b'iram chi ma' holohik ta kiq'orik chi wiij. <verse number="28" style="v" />Je' re' noq re' taq i hat cha q'or taq keh chi re' hin i k'achlik Dios, hin kinq'orik chi naa nuye'em chikinaah aha' wilik i ma' holohik taj inki kapaaj. <verse number="29" style="v" />Xti korik i nuq'or chi chupaam i ye'aab' chiq yuuq' wili naa kikimiik taqe i k'ijolaq ma' holohik ta kiq'orik chi wiij, re' taqe i wilik juninaq haab' keh je' wo' taqe ik'inaq juninaq haab' ayu' naa rukahniik chi kutlik i kiti'jolal. <verse number="30" style="v" />Ma' jino'q taq aweh i naa rub'anam okik chupaam i ye'aab' nuq'orom naq taq aweh chi xti korik chi ar naq taq naa apatiniik. Xa re' wo' hoq Caleb rak'uun i Jefone, ruch'ihil i Josué rak'uun i Nun, nakianam okik ar. <verse number="31" style="v" />Eh re' taq i xaq'or i hat chi naa ruchopariik kinaah kuum i nixowanik kiwach re' kak'uun kixq'uun i keh naa nuye'em q'ab' chi naa kokiik chupaam i ye'aab' ma' xponik ta taq panaq'awach i hat, re' keh naa kib'aniik rusuqkiil. <verse number="32" style="v" />Re' taq ati'jolal i hat naa rukahniik chi kutulkeeb' chupaam i chiq yuuq' wili. <verse number="33" style="v" />Re' taq awak'uun awixq'uun ka'winaq haab' naakib'ehik chupaam i chiq yuuq' wili. Xa chi kib'il kiib' naa kik'amam kib'eeh, eh je' re' i ti' naakik'ulum ruum taq ayiib' wach na'ojb'al i hat. Eh chawunchelaal taq i hat korehtaal inkahnik chi kutlik taq ati'jolal chupaam i chiq yuuq' wili. <verse number="34" style="v" />Eh re' taq i hat i xponik taq awilow i ye'aab' chuwach i ka'winaq q'iij ka'winaq haab' wo' taq naa atojom taq amahk iraaj ruq'orom chi ju'jun haab' chi riij i ju'jun chi q'iij. Chi je' re' naa taq anab'eem chi ma' holohik taj i chukuj q'orik taq xa a'n <verse number="35" style="v" />Re' hin i Dios, i nuq'or i korik chi je' re' i naa nub'anam keh i tinamit wili xkian jinaj wach kik'ux chi ma' ximponik ta panaq' kiwach. Ruum i re' ayu' naakikimiik chupaam i ye'aab' wili chiq yuuq, inki Dios.</para>
  <para style="s">Re' kikimiik taqe i lajeeb' xi ponik ilwoq reh nik' wach noq wilik i ye'aab' Canaán</para>
  <para style="p">
    <verse number="36" style="v" />Re' taqe i winaq xutaq'aaj chaloq i Moisés chi rilariik nik' wach noq wilik i ye'aab' re' taqe i xi ponik chuq'orariik keh i aj Israel chi ma' holohik taj i ye'aab'. Eh ruum i re' chu'nchel i aj Israel ma' holohik ta xiq'orik chi riij i ye'aab' re' re'. <verse number="37" style="v" />Eh re' taqe i lajeeb' chi winaq re' re' ma' korik taj i xponik kiq'or chi riij i ye'aab' xk'ulik kilow xye'arik chee kaq yab'ilaal chikinaah ruum i Dios. Eh ruum i re' xikimik. <verse number="38" style="v" />Xa kiib' chik i kik'uliil noq xi k'ulik ilil ye'aab' xi kahnik chi k'achalkeeb', re' i Caleb rak'uun i Jefone, ruch'ihil i Josué rak'uun i Nun.</para>
  <para style="s">Re' i aj Israel xb'aan keh chupaam i ye'aab' Horma</para>
  <para style="r">(<ref loc="DEU 1:41-46">Deut 1.41-46</ref>)</para>
  <para style="p">
    <verse number="39" style="v" />Eh noq xuk'uhtjaaj i Moisés keh i aj Israel aha' wilik i xub'an Dios, chi kunchelaal xchalik rutib'iik kik'ux. <verse number="40" style="v" />Eh kowahq'eq chi junwaar xijohtik naah yuuq' pantaq rax chee', je' wili i xkiq'or:</para>
  <para style="p">Re' hoj ayu' chik wilkooj ma' xta reet chi nee qoh ooj chupaam i ye'aab' xuq'or i QaJaaw Dios chi naa ruye'em qeh. Xti korik wo' hoq chi xoj mahkunik chuwach, inki taqe.</para>
  <para style="p">
    <verse number="41" style="v" />Eh je' wili i xq'orarik keh ruum i Moisés:</para>
  <para style="p">¿Chib'ih reet noq ma' xanimaj ta taq aha' wilik taqe i xuq'or i QaJaaw? Ruum i re' ma' naa ta taq aweliik korik. <verse number="42" style="v" />Maa chop taq reje ak'ux chi ojik chawach ruum i wixatooj taq nee taq inki a'n chaaweh i ki-ixowanik taq awach ruum re' Dios ma' xta taq awuuk' cha toob'jiik. <verse number="43" style="v" />Re' taqe i aj amalec, taqe i aj Canaán k'ahchi' taq kaat kuy-eem reh i rub'anariik taq aweh. Re' taq i hat ruum chi xaq'eb' taq chi riij ak'ux i QaJaaw Dios re' reh ma' naa ta wo' ruwihiik taq awuuk' chatoob'jiik, inki.</para>
  <para style="p">
    <verse number="44" style="v" />Eh re' taqe i aj Israel xiooj chikiwach xijohtik chinaah inajt naah yuuq' pantaq rax chee', xa re' la' ma' xooj ta chikiij i Moisés. Je' wo' hoq i loq'laj kaxa moloj wii' i k'uhb'aal ma' xi elik ta taqe chupaam i itz'ihy naah paat. <verse number="45" style="v" />Eh noq wilkeeb' chik ar i aj Israel xiqajik chaloq i aj amalec kuch'ihil i aj Canaán chub'anariik keh chupaam i ye'aab' Horma.</para>
  <chapter number="15" style="c" />
  <para style="s">Re' k'uhb'aal chi riij nik' wach ruye'ariik taqe i mayiij</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="2" style="v" />Re' hat cha q'or keh i aj Israel taqe i q'orik wili. Noq naakokiik chupaam i ye'aab' naa nuye'em keh chi naa kik'achariik ar. <verse number="3" style="v" />Koruman chi naakiq'aasam chi kik'atoj mayiij jino'q imas wakax, jino'q i tentzuun ye'b'al nuloq'il, reh chi neemponik chi nuwach chi nk'ohnik laj mayiij. Re' i re' naakiq'aasam chi riij chi xooj eloq wach i nuq'orom, oon xa pankik'ux neenchalik, oon neenkiq'asaj chupaam jino'q i nim wach ninq'iij. <verse number="4" style="v" />Eh awach i nee ruk'am chee rumayiij chi nuwach koruman chi naa ruqasam haa' chi kimayiij ik'inaq kijib' libra chi holohik arina, xilakimaj ruuk' i jinaj nimlaj lemeta chi aseite. <verse number="5" style="v" />Eh re' k'atoj mayiij re' re' naa wo' kiq'asam haa' ju'jun i nimlaj lemeta chi riis uuva chi ruk'uliil i ju'jun chi chikop. <verse number="6" style="v" />Eh wila' imas tentzun xkiq'asaj koruman chi naakiq'aasam chiruk'uliil i k'isiin ma' b'elejeeb' libra chi holohik laj arina xilakimaj ruuk' ik'inaq jinaj nimlaj lemeta chi aseite. <verse number="7" style="v" />Eh naa wo' kiq'asam chi kimayiij ik'inaq jinaj nimlaj lemeta chi riis uuva reh chi naa ruponiik chi nk'ohnik laj mayiij chi nuwach. <verse number="8" style="v" />Eh wila' k'isa imas wakax i naa kik'atam chi kimayiij k'amb'al iib' panotob'il, oon reh k'amb'al kiib' panotob'il wuuk' i hin, hin Dios, oon mayiij chi riij chi xooj eloq wach i q'orooj cho rib'iral. <verse number="9" style="v" />Koruman chi naa kiq'asam chiruk'uliil i k'isa imas wakax re' re' ik'inaq oxlaj libra chi holohik laj arina xilakimaj ruuk' i kiib' nimaq lemeta chi aseite. <verse number="10" style="v" />Eh koruman wo' hoq chi naa kiq'asam haa' i kiib' nimaq lemeta chi riis uuva reh chi naa ruponiik chi nk'ohnik laj mayiij chi nuwach i hin. <verse number="11" style="v" />Eh naa wo' kiq'asam haa' taqe i re' noq naakiq'aasam chi kimayiij jino'q imas wakax, eh jino'q imas tentzun, oon jino'q i k'isa tentzun, oon jino'q i k'isa kaprax. <verse number="12" style="v" />Je' taq re' i naa a'nam kuuk' i ju'jun chi chikop naa taq aq'asam chi amayiij kojarub' pa' neemponik taq i naa aq'asam. <verse number="13" style="v" />Eh chawunchelaal taq i hat aj Israel koruman chi je' re' taq i naa a'nam xa jarpech pa' naa taq aq'asam i chikop chi k'atoj mayiij, ink'ohnik imponik chi nuwach i hin.</para>
  <para style="p">
    <verse number="14" style="v" />Eh re' taqe i tokoom tinamit xa ik'ik keh, oon patim taq chaxilak wila' xkaaj kiq'asam i chikop chi k'atoj mayiij ink'ohnik imponik chi nuwach i hin, nik' wach ruq'ahteesjik naa taq a'nam amayiij i hat, je' wo' re' i naa kia'nam i keh. <verse number="15" style="v" />Re' i k'uhb'aal chi riij i mayiij wili aweh taq i hat keh wo' taqe i aj tokoom tinamit xa ik'ik keh, oon patim taq chaxilak. Eh keh taqe i tuutb'ees ajaab'ees, keh wo' hoq i kiih kimaam naa kiwihiik koq'uun. <verse number="16" style="v" />Re' i k'uhb'aal wili naa animam taq i hat, je' wo' taqe i tokoom tinamit, tiko'q keh, inki Dios.</para>
  <para style="p">
    <verse number="17" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="18" style="v" />Re' hat cha q'or keh i aj Israel taqe i q'orik wili: Noq okinaq chik taqe chupaam i ye'aab' aha' naa nuk'amam taqe reje wii'. <verse number="19" style="v" />Noq naa rutohq'iik kianam rusuqkiil i wach i kitik kimu'uun nareliik chupaam i ye'aab' re' re', koruman chi naa kiq'aasam i kimayiij chi nuwach i hin. <verse number="20" style="v" />Nik' wach noq inkiq'asaj chi kimayiij i peet wach i kitik, naa wo' kiq'asam chi mayiij chi nuwach i peet kaxlanwi'k inki yejaa' ruuk' peet wach i ki trigo. <verse number="21" style="v" />Eh re' kaxlanwi'k juneliik naakiq'aasam chi mayiij i keh, je' wo' taqe i kiih kimaam naa kiwihiik koq'uun.</para>
  <para style="p">
    <verse number="22" style="v" />Eh wila' re' keh xa chi ma' keht'al xkikanaa' rub'anariik jino'q keh i xnuq'or, re' i k'uhb'aal xnuq'or reh i Moisés chi naa kianam. <verse number="23" style="v" />Eh wila' xa ruchaliik wo' chaloq chi ma' inki a'n ta rub'aan xa re' wo' noq xnuyeew reh i Moisés k'uhb'aal wili, eh xaxikuloq wo' ayu' yu'naak chi ma' inki a'n ta chu'nchel i ruq'or. <verse number="24" style="v" />Eh wila' xa chi ma' keht'al xkian i mahk re' i tinamit koruman chi naakiq'aasam jinaj i k'isa imas wakax chi k'atoj mayiij ink'ohnik imponik chi nuwach i hin, naa wo' kiq'aasam chi mayiij i xa chi naq'wach ruch'ihil i riis uuva, je' rukab' i ruq'or i k'uhb'aal. Eh naa wo' kiq'aasam jinaj imas kaprax chi riij i mahk. <verse number="25" style="v" />Eh chi riij i re', re' k'amal b'eeh aj tiij naa ruq'aasam i mayiij pahqb'al kuyb'al kimahk chu'nchel i tinamit Israel. Re' hin naa wo' nukuyum kimahk ruum kiq'aasam chik i kimayiij chi riij i mahk, xa chi ma' keht'al xkian. <verse number="26" style="v" />Korik noq re' hin naa nukuyum i kimahk chu'nchel i aj Israel, je' wo' taqe i tokoom tinamit patim chi kixilak, ruum xa chi ma' keht'al i xkian i mahk re' re'.</para>
  <para style="p">
    <verse number="27" style="v" />Eh wila' xa jinaj xb'anik i mahk chi ma' reht'al, ixoq kaprax jinaj haab' i wilik reh naa ruq'aasam chi rumayiij chi riij i ru mahk. <verse number="28" style="v" />Re' i k'amal kib'eeh aj tiij naa ruq'aasam i mayijimaj chikop chuwach i QaJaaw Dios chi riij i awach xb'anik reh i mahk chi ma' reht'al. Eh noq ruq'asam chik i chikop chi mayiij naa rukuyariik i ru mahk. <verse number="29" style="v" />Re' i mayiij wili koruman chi naa kiye'em i aj Israel, je' wo' i tokoom tinamit patim chi kixilak, wila' xa chi ma' keht'al ma' xkian taj i ruq'or i k'uhb'aal chi riij i ruye'ariik i mayiij.</para>
  <para style="p">
    <verse number="30" style="v" />Eh wila' re' jino'q i xaraaj chi ma' xub'an taj i ruq'or i k'uhb'aal re' re', eh ma' xponik ta k'isinoq chi nuwach i xub'an. Re' reh naa rehtesjiik chi kixilak i aj Israel, atoob' ta aj Israel, atoob' ta tokoom tinamit. <verse number="31" style="v" />Re' reh ruum chi ma' xponik ta k'isinoq panaq'wach i nuq'oral ma' xub'an taj i ruq'or i nuk'uhb'aal ruum i re' naa rehtesjiik reje chi kixilak i tinamit, tiko'q keh, inki Dios.</para>
  <para style="s">Re' tojb'al ru mahk awach inkamanik pan hi'limb'al q'iij</para>
  <para style="p">
    <verse number="32" style="v" />Eh noq re' taqe i aj Israel b'ehik inki a'n cho chupaam i ye'aab', jinaj i winaq xkireq chi si'wik i rub'an chupaam i hi'limb'al q'iij. <verse number="33" style="v" />Eh re' keh xkik'am reje chuwach i Moisés, chuwach i Aarón, chikiwach i ruk'ihaal tinamit. <verse number="34" style="v" />Ar xkiyeew pantz'ilom i winaq, ruum komajaa' ta naq i naab'jik chib'ih i naa rub'aan ruuk'. <verse number="35" style="v" />Eh re' i QaJaaw Dios je' wili i xuq'or reh i Moisés, re' winaq re' re' i ruk'ul chi naa rukanteesjiik najt reje ruuk' i itz'ihy naah paat wilkaat taq wii' chu'nchel i tinamit naakik'utwiik reh chi ab'aj, inki. <verse number="36" style="v" />Eh xkesaj cho chupaam i ye'aab' wilkeeb' wii' i aj Israel xkikutib'eej chi ab'aj i winaq re' re' korehtaal xkikansaj, je' rukab' i xq'orarik reh i Moisés, ruum i QaJaaw Dios.</para>
  <para style="s">Re' i rusinchii' i rooq i kiso' i aj Israel</para>
  <para style="p">
    <verse number="37" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="38" style="v" />Re' hat cha q'or keh i aj Israel chi re' keh, eh chi re' taqe i kiih kimaam naa kiwihiik na' chub'an koruman chi naa kikojom rusinchii' i rooq i kiso', eh chi xilak i re' naa kikojom i tolotaq rax muq'ik laj nooq'. <verse number="39" style="v" />Eh noq naakilom wach i rusinchii' i kiso' naa ruk'uliik cho pankik'ux chu'nchel i nuk'uhb'aal nuq'orom keh, eh naa kianam rub'aan. Eh ma' naa ta chik kianam i kiyiib' wach kapeew i keh, eh inkootwaaj rub'aan, ruum i re' ma' korik ta chik wach kik'ux wuuk'. <verse number="40" style="v" />Chi je' re' naa ruk'uliik pankik'ux naa kianam chu'nchel i nuk'uhb'aal nuq'orom keh reh chi naa ruwihiik kisantohiil, eh re' hin naa nukahniik chi ki Dios. <verse number="41" style="v" />Re' hin kaJaaw i ki Dios xineesanik cho keh pan tinamit Egipto re' inwaaj i hin chi naa nukahniik chi hin manlik ki Dios, tiko'q keh, inki Dios.</para>
  <chapter number="16" style="c" />
  <para style="s">Re' i Coré, re' Datán, re' Abiram, xkiq'ehtaaj kiib' chuwach i Dios</para>
  <para style="p">
    <verse number="1" style="v" />Jinaj i winaq aj Levíta riih rumaam Coat, re' Coré rak'uun Izhar. Eh ixib' chik taqe i winaq ruch'ihil re' ruuk' taqe i junch'uq chi riih rumaam i Rubén, je' wili i kib'ihnaal: Datán, Abiram, rak'uun taqe i Eliab, eh re' On rak'uun i Pelet. <verse number="2" style="v" />Re' keh kiib' siento ruuk' lajeeb' roxk'ahl chi winaq taqe chi aj Israel. Re' taqe i winaq re' re' wilik kajaawriik chi kixilak i tinamit kojol taqe na'ojb'al holohik wo' naq kib'iral. <verse number="3" style="v" />Chu'nchel i re' xkimol kiib', xkichoqej i Moisés ruch'ihil i Aarón je' wili xkiq'or:</para>
  <para style="p">Re' hoj xoj q'uhtik taq chik aweh i hat, chu'nchel i tinamit wilik kisantohiil, eh re' i QaJaaw Dios wilik quuk' i hoj chi qunchelaal. Eh ¿Chib'ih reet noq konawaaj taq taaq'anik chi qanaah i hoj, hoj rutinamiit i Dios? inki taqe.</para>
  <para style="p">
    <verse number="4" style="v" />Eh noq xrib'iraj chi je' re' i Moisés xuk'utzaa' qohoq riib' korehtaal xureq wach ak'al ruuk' i yejal wach. <verse number="5" style="v" />Eh je' wili i xuq'or reh i Coré, je' wo' keh taqe i ruch'ihil:</para>
  <para style="p">Xa iqal wahq'eq naa ruk'uhtaam qeh i QaJaaw Dios awach i rusik'im kiwach, eh awach i rukuxisam taqe, re' re' naa ruye'em q'ab' chi naa kijilim i koq kiib' chuq'ahteesjiik i mayiij. <verse number="6" style="v" />Re' hat Coré, je' wo' taqe awuch'ihil cha a'n taq i naa nuq'orom aweh chak'am taq chaloq i sansario. <verse number="7" style="v" />Eh i iqal i nayeew i nah wach q'aaq' chupaam, eh naa taq aye'em insensia chinaah, naa taq ak'atam chuwach i QaJaaw. Awach pa' taq aweh i neerusik' wach i reh re' wo' re' rukuxisam chaloq. Re' taq i hat aj Levíta manlik i ma' holohik ta laj na'ojb'al taq xa a'n inki.</para>
  <para style="p">
    <verse number="8" style="v" />Eh re' Moisés je' wili i xuq'or reh i Coré:</para>
  <para style="p">Kinab'iraj taq i hat aj Levíta. <verse number="9" style="v" />¿Mi ma' manlik taq aweh re' chi xusik' taq chawach i qaDios chi kixilak i aj Israel reh chi naa taq a'nam i kamanik chuwach? Re' reh xusik' taq awach chi naa taq a'nam i rukamaj chupaam i ru-itz'ihy naah paat, reh chi naa taq a'nam i kamanik kuuk' i tinamit. <verse number="10" style="v" />Re' wo' i Dios xpaab'anik aweh i hat, je' wo' taqe chu'nchel awuch aj Levíta chi naa taq a'nam i rukamaj. Xa re' la' re' taq i hat inawaaj taq aq'uchum i kikamaj i k'amal kib'eeh aj tiij. <verse number="11" style="v" />Re' hat Coré je' wo' chu'nchel awuch'ihil, re' i QaJaaw Dios ma' holohik ta taq ti q'orik chi riij, re' taq i reh xaq'etwachej. Re' taj i Aarón ma' holohik ta taq ti q'orik chi riij ma' xta naq q'orik reh, inki.</para>
  <para style="p">
    <verse number="12" style="v" />Eh chi riij i re', re' i Moisés xutaq'aaj ruk'amariik i Datán, ruch'ihil i Abiram, rak'uun taqe i Eliab, xa re' la' re' keh ma' xkaaj ta chalik, je' wili xkiq'or:</para>
  <para style="p">Re' hoj ma' qaaj ta ojik. <verse number="13" style="v" />¿Mi ma' manlik aweh re' i xa a'n qeh chi xoj awesaj cho Egipto re' yohb'aal wii' wach i suq atoob', eh xoj ak'am cho chupaam i ye'aab' wili re' naaqakimiik wii' ruum i rukuyariik i k'uxumb'al qeh? Xanaah re' xa konawaaj wo' chi naa akahniik chi taaq'anik chi qanaah. <verse number="14" style="v" />Re' hat ma' re' ta chupaam jino'q i ye'aab' i nelik wii' i suq atoob' xoj ak'am chaloq. Eh ma' nayeew ta qaye'aab', ni xata xayeew qa uuva. Re' hat qoh awaaj ak'amam reje chi je' hoj moywach. Re' hoj ma' jaruuj nee qoh ooj chawiij, inki taqe.</para>
  <para style="p">
    <verse number="15" style="v" />Eh re' i Moisés ma' k'isiin xchalik ruk'aah, Je' wili i xuq'or reh i QaJaaw Dios:</para>
  <para style="p">Maak'ul keh i kimayiij, re' hin ma' nuq'uchum ta jino'q ki b'uurux, eh ma' awach ta jino'q keh i nub'anam ti k'axik keh, inki.</para>
  <para style="p">
    <verse number="16" style="v" />Eh chi riij i re', re' i Moisés je' wili i xuq'or reh i Coré:</para>
  <para style="p">Re' hat, i haa' taqe i awuch'ihil iqal taq tiooj chuwach i QaJaaw Dios, eh re' Aarón naa wo' ruwihiik taq awuuk' ar. <verse number="17" style="v" />Cha ju'junaal taq naa ak'amam reje asansario naa taq aye'em i insensia chupaam. Re' hat ruch'ihil i Aarón jinaj taq naa aye'em wii' asansario chuwach i QaJaaw, ruuk' kisansario i kiib' siento ruuk' lajeeb' roxk'ahl chi winaq, inki.</para>
  <para style="p">
    <verse number="18" style="v" />Eh xkik'am wo' reje i kisansario chi kiju'junaal xkiyeew i naah wach q'aaq' chupaam, je' wo' hoq i insensia, xooj kipab'aa' kiib' panookb'al reh i santo laj itz'ihy naah paat molb'al iib' kuch'ihil Moisés, kuch'ihil i Aarón. <verse number="19" style="v" />Re' Coré rumolom wo' chik kiwach chu'nchel i tinamit re' re' panookb'al reh i santo laj itz'ihy naah paat molb'al iib', chi ixob'al wach i Moisés, ruch'ihil i Aarón. Eh re' i QaJaaw Dios xuk'uhtaaj chee ruloq'il chikiwach chu'nchel i tinamit. <verse number="20" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés, i Aarón.</para>
  <para style="p">
    <verse number="21" style="v" />Re' taq i hat eleen taq chi kixilak i tinamit re' re', ruum re' hin xa chi jumehq'iil naa nusacham kiwach, inki.</para>
  <para style="p">
    <verse number="22" style="v" />Eh re' i Moisés, ruch'ihil i Aarón xkik'utzaa' qohoq kiib' korehtaal xkireq wach ak'al ruuk' i yejal kiwach, je' wili xkiq'or:</para>
  <para style="p">QaJaaw Dios i re' hat ti ye'wik kik'achariik chu'nchel i tinamit, ¿Mi naa asacham kiwach chu'nchel re' i tinamit ruum aajosq'iil xa ruum i ru mahk i jinaj chi winaq? inki taqe.</para>
  <para style="p">
    <verse number="23" style="v" />Eh re' QaJaaw Dios je' wili i xuq'or reh i Moisés.</para>
  <para style="p">
    <verse number="24" style="v" />Re' hat cha q'or keh chu'nchel i aj Israel chi kieloq reje ruuk' i itz'ihy naah paat wilkeeb' wii' i Coré, Datán, i Abiram.</para>
  <para style="p">
    <verse number="25" style="v" />Re' i Moisés xooj wo' hoq aha' wilkeeb' wii' i Datán, i Abiram xtahqaljik reje kuum i taqe i k'amal b'eeh chi kixilak i aj Israel. <verse number="26" style="v" />Re' i Moisés je' wili i xuq'or keh i aj Israel:</para>
  <para style="p">Eleen taq reje ruuk' i ki-itz'ihy naah paat i winaq re' re' yiib' wach i kina'ojb'al, eh maa tz'a'j taq i chib'ih keh reh chi ma' nee ta taq tikimik haa' i hat ruum i kimahk i keh, inki.</para>
  <para style="p">
    <verse number="27" style="v" />Eh re' taqe i aj Israel xi elik wo' chaloq aha' wilik wii' i Coré, i Datán, Abiram. Eh re' Datán, ruch'ihil i Abiram kipab'aa' cho kiib' chi chii' i ki-itz'ihy naah paat kuch'ihil i kehk'een, kuch'ihil taqe i kak'uun kixq'uun. <verse number="28" style="v" />Re' i Moisés je' wo' chik wili i xuq'or keh.</para>
  <para style="p">Ruuk' taqe wili naa nuk'uhtaam taq chawach chi re' Dios wilik rajaawriik intaaq'anik weh ruuk' chu'nchel i nub'an ma' xata panuk'ux i hin inchalik. <verse number="29" style="v" />Wila' re' taqe i winaq wili xikimik reje parub'ehel je' rukab' noq kikimik taqe reje i tinamit ar neenk'utinik chi ma' re' tee Dios intaaq'anik weh ruuk' taqe i nub'an. <verse number="30" style="v" />Eh raaj wila' re' i QaJaaw Dios xub'an chaloq ma' jank'al ta nilarik, wixuteh i chii' ak'al, eh nee kib'iq'arik qohoq ruum aak'al chi k'achlik kiwach i winaq wili k'uch'ihil i chu'nchel i chib'ih keh. Ruuk' i re' neenanab'eej taq i hat chi re' taqe i winaq wili xkiq'etwachej i Dios, inki.</para>
  <para style="p">
    <verse number="31" style="v" />Eh xa re' wach xukohlaaj ruq'orariik i Moisés taqe re' intehiwanik i chii' ak'al chi ki'sil taqe winaq re' re'. <verse number="32" style="v" />Eh xib'iq'arik qohoq i Coré je' wo' chu'nchel i xkimol kiib' ruuk', xb'iq'arik wo' qohoq chu'nchel i awach keh, je' wo' chu'nchel i chib'ih keh. <verse number="33" style="v" />K'achlik wo' kiwach noq xib'iq'arik qohoq paruchamiil i jul, kuch'ihil chu'nchel i chib'ih keh. Chi riij i re' xtz'ahpik wo' chik i chii' aak'al, je' re' noq sacharik kiwach chi kixilak i aj Israel. <verse number="34" style="v" />Eh ruum chi xkik'er kichii' i xsacharik kiwach re' re', re' taqe i aj Israel wilkeeb' chi kijunsuut, xkimol chi elik, je' wili xkiq'or: Qoh eloq taq ruum nee-oq wo' qoh rub'iq' ak'al i hoj, inki taqe. <verse number="35" style="v" />Re' i QaJaaw Dios xutaq'aaj wo' chaloq jinaj q'aaq' sachb'al kiwach i kiib' siento ruuk' lajeeb' roxk'ahl chi winaq i xik'atwik reh i insensia.</para>
  <para style="p">
    <verse number="36" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="37" style="v" />Re' hat cha q'or reh i Eliazar rak'uun i Aarón k'amal kib'eeh aj tiij chi chesaj chaloq i sansario chi xilak i q'aaq' chukut reje ko wulu' i naah wach q'aaq' wilik chupaam, ruum re' taqe i sansario wilik kisantohiil. <verse number="38" style="v" />Ruum re' i kisansario taqe winaq re' re' i xikimik ruum i mahk xkian, xkahnik chi kuxisamaj i kisansario ruum xkamanik k'atb'al insensia chi nuwach. Eh re' i sansario chayub' taq wach i ruch'ihch'aal reh chi neen kamanik chib'urb'al wach i artaal rehtalil chikiwach i aj Israel chi ma' toob' taj i xkian i winaq re' re'.</para>
  <para style="p">
    <verse number="39" style="v" />Eh re' i Eliazar i k'amal kib'eeh aj tiij xponik wo' resaj taqe i sansario re' ruuk' i q'an ch'ihch', xkikanaa' ar i winaq kuxik kikimiik. Eh xuq'or wo' hoq chi kiyub' wach i ruch'ihch'aal i sansario reh chi xkib'ur chuwach i artaal. <verse number="40" style="v" />Re' wili xkahnik chi rehtalil chikiwach i aj Israel chi xa re' wo' taqe i rak'uun i Aarón i ruk'ul chi naa kojiik chi k'atoj insensia chuwach i QaJaaw Dios. Ruum wila' awach chik jino'q i tokoom xooj chuk'atariik i insensia chuwach i QaJaaw Dios nee ruk'ul reh je' rukab' i xuk'ul i Coré, je' wo' rukab' i xkik'ul i ruch'ihil. Eh xub'an wo' chu'nchel i Eliazar i xq'orarik reh ruum i Moisés.</para>
  <para style="p">
    <verse number="41" style="v" />Eh chi junwaar chik, chu'nchel i aj Israel xkitoq'aa' kichoqem i Moisés ruch'ihil i Aarón je' wili i xkiq'or reh:</para>
  <para style="p">Re' taq i hat k'ahchi' taq akansam i rutinamiit i QaJaaw Dios, inki taqe.</para>
  <para style="p">
    <verse number="42" style="v" />Re' keh chi kunchelaal xkikotej riij i Moisés ruch'ihil i Aarón reh i kichooqjiik, re' keh xi ilwik reje i wilik wii' santo laj itz'ihy naah paat molb'al iib'. Eh xa chupaam i jumehq' re' re' muhqik naah chi suutz' itz'ihy naah paat molb'al iib', xqajik chee ruloq'il i QaJaaw Dios. <verse number="43" style="v" />Eh re' i Moisés, i Aarón xooj kipab'aa' kiib' panookb'al reh i santo laj itz'ihy naah paat molb'al iib'. <verse number="44" style="v" />Re' QaJaaw Dios i je' wili i xuq'or reh i Moisés:</para>
  <para style="p">
    <verse number="45" style="v" />Re' taq i hat eleen taq chi kixilak i tinamit re' re' ruum re' hin xa chi jumehq'iil naa nusacham kiwach, inki.</para>
  <para style="p">Eh noq xkib'iraj chi je' re' i Moisés, ruch'ihil i Aarón xkik'utzaa' qohoq kiib' korehtaal xkireq wach ak'al ruuk' i yejal kiwach. <verse number="46" style="v" />Eh re' i Moisés je' wili i xuq'or reh i Aarón:</para>
  <para style="p">Re' hat chak'am reje asansario, chaham nah wach q'aaq' chupaam re' ruuk' i wilik wach artaal, chayeew insensia chupaam, eh nee tiooj i wilkeeb' wii' i tinamit, neenapahqaaj ree Dios chi neenkuyarik kimahk, ruum re' i rujosq'iil i QaJaaw x-uhtik chik wach, re' kaq yab'ilaal chalik chik chikinaah, inki.</para>
  <para style="p">
    <verse number="47" style="v" />Eh re' i Aarón xub'an wo' hoq i xq'orarik reh ruum i Moisés xooj wo' rajimam riib' aha' kimolom kiib' i tinamit. Eh re' kaq yab'ilaal xutaq'aaj chee i QaJaaw Dios k'ahchi' chik rukansam i tinamit. Re' Aarón xuyeew wo' insensia chupaam i rusansario xupahqaaj ree i Dios chi chukuy i kimahk i tinamit re' re'. <verse number="48" style="v" />Eh jumehq'iil xuyeew riib' pankiyejaal i kamnaq chik taqe kuuk' i kok'achalkeeb', eh re' i kaq yab'ilaal jumehq'iil xpa'lojik. <verse number="49" style="v" />Xa re' la' ruum i yab'ilaal re' re' kamnaq chik taqe i kajlaj miil ruuk' wuquub' siento chi tinamit, eh ma' xi ajaljik ta haa' taqe i xikimik ruum i mahk xub'an i Coré. <verse number="50" style="v" />Eh noq ik'inaq chik chi jumpech i kaq yab'ilaal, re' Aarón xooj wo' chik aha' wilik wii' i santo laj itz'ihy naah paat molb'al iib', xooj wo' chik rureq i Moisés.</para>
  <chapter number="17" style="c" />
  <para style="s">Re' i rukarote i Aarón toxlinik</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="2" style="v" />Re' hat cha q'or keh i ju'jun ch'uq chi aj Israel chi kik'am cho ju'jun-oq kikarote i k'amal kib'eeh. Eh kab'laj chi karote i neenkik'am chaloq. Eh re' hat neenatz'ihb'aaj i kib'ihnaal chi kiju'junaal chuwach i kikarote. <verse number="3" style="v" />Re' i rukarote ink'amwik kib'eeh i junch'uq chi riih rumaam Leví, re' i rub'ihnaal i Aarón neenatz'ihb'aaj chuwach. Ruum koruman chi naa kik'amam cho ju'jun-oq kikarote i k'amal kib'eeh i ju'jun ch'uq chi aj Israel. <verse number="4" style="v" />Re' taqe kab'laj chi karote re' re' naa rojiik aye'em chupaam i santo laj itz'ihy naah paat molb'al iib', chuwach i loq'laj kaxa molik wii' i k'uhb'aal re' inqak'ul wii' qiib' taq awuuk'. <verse number="5" style="v" />Re' hin naa nuye'em q'ab' chi neentoxliniik i rukarote i winaq nusik'im wach. Chi je' re' ma' nee ta chik taq tikichoqej i aj Israel, inki.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' i Moisés xuq'or wo' keh i aj Israel i xq'orarik reh. Eh re' kab'laj ch'uq chi aj Israel xkik'am wo' chaloq ju'jun i kikarote i ju'jun chi k'amal kib'eeh xponik kab'laj chi karote, chi kixilak i re' wilik i rukarote i Aarón. <verse number="7" style="v" />Eh re' i Moisés xponik ruyeew i kab'laj chi karote re' re' chuwach i QaJaaw chupaam i santo laj itz'ihy naah paat molik wii' k'uhb'aal. <verse number="8" style="v" />Eh chi junwaar i Moisés xokik wo' chik i koq chupaam i santo laj itz'ihy naah paat xponik rureq chi re' i rukarote i Aarón, re' i xuyeew parub'ihnaal i junch'uq chi riih rumaam Leví, xpoq' rutoxl ixmak'inik, q'an laj almendro i xuwachuj. <verse number="9" style="v" />Re' i Moisés xresaj cho chuwach i QaJaaw Dios kab'laj chi karote xuk'uhtaaj keh chu'nchel i aj Israel, eh xkimol, xkik'am wo' chik chi kiju'junaal i kikarote, i xi k'amwik cho reh. <verse number="10" style="v" />Re' i QaJaaw Dios, je' wili i xuq'or reh i Moisés: Re' hat cha kanaa' i rukarote i Aarón chuwach i loq'laj kaxa i moloj wii' i k'uhb'aal k'uhtb'al reh chikiwach i aj Israel kiq'etwachinik weh. Je' re' naa a'nam reh chi neenkikanaa' i choqik chi wiij, reh chi ma' nee ta kikimik, inki.</para>
  <para style="p">
    <verse number="11" style="v" />Eh re' i Moisés xub'an wo' chu'nchel i xq'orarik reh ruum i QaJaaw Dios. <verse number="12" style="v" />Eh re' taqe i aj Israel je' wili i xkiq'or reh i Moisés: Re' hoj, hoj q'ehb'eel naaqakimiik chi qunchelaal. <verse number="13" style="v" />Ruum chu'nchel inkijil i koq kiib' ruuk' i rusanto laj itz'ihy naah paat molb'al iib' i QaJaaw Dios kikimik. ¿Mi naa rukuxiik qakimiik re' hoj? inki taqe.</para>
  <chapter number="18" style="c" />
  <para style="s">Re' i kikamaj k'amal kib'eeh aj tiij, je' wo' taqe i junch'uq chi aj Levíta</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios, je' wili i xuq'or reh i Aarón: Wila' awach ch'uwarisanik paam i nuSanto laj itz'ihy naah paat, wach anaah i hat, wach kinaah awak'uun, wach kinaah i riih rumaam i Leví naa rukahniik i mahk. Eh wila' xa a'n taq i mahk ruuk' taq akamaj hat taq k'amal kib'eeh aj tiij wach anaah taq i hat, eh wach kinaah taq awak'uun naa rukahniik. <verse number="2" style="v" />Eh neerub'an chi neenaq'or keh taqe i re' ruuk' i junch'uq chi riih rumaam i Leví re' ruuk' awach keh chi nee tikitow i hat, ruch'ihil taqe i awak'uun noq nee taq i na a'n i kamanik chuwach i santo laj itz'ihy naah paat i molarik wii' i k'uhb'aal. <verse number="3" style="v" />Re' taqe re' neerub'an chi nee tikitow, chub'anariik i kamanik chupaam i itz'ihy naah paat. Xa re' la' ma' naa ta kijilim i koq kiib' kuuk' chu'nchel i wilik kisantohiil kikamanik ar, je' wo' ruuk' i artaal. Ruum wixkijil i koq kiib' nee kikimiik i keh, je' wo' taq i hat. <verse number="4" style="v" />Re' keh neerub'an chi nee tikitow chi rub'anariik i kamanik chupaam i santo laj itz'ihy naah paat molb'al iib', xa re' la' ma' jino'q chik i tokoom nerujil i koq riib' taq awuuk'. <verse number="5" style="v" />Eh xa re' wo' hat Aarón, re' taqe i awak'uun naa kib'aniik i kamanik chupaam i nuSanto laj itz'ihy naah paat, je' wo' wach artaal. Chi je' re' ma' nee ta chik inchalik nujosq'iil chikinaah chu'nchel i aj Israel. <verse number="6" style="v" />Re' hin xnusik' kiwach taqe, re' taqe i ma' tokoom ta taq awuuk' i riih rumaam i Leví reh chi nuyeew taq aweh i hat reh chi nee taq tikitob'eej chub'anariik i nukamaj chupaam i nuSanto laj itz'ihy naah paat molb'al iib'. <verse number="7" style="v" />Xa re' wo' hat, re' taqe i awak'uun naa taq akamaniik chi hat taq k'amal kib'eeh aj tiij chuwach i artaal, je' wo' hoq i nukamaj imb'aan i koq kochi juntar i itz'ihy tasb'al, xa re' wo' taq i hat naa ab'aniik reh. Re' hin nuye'em taq q'ab' aweh chi naa taq akamaniik chi hat taq k'amal kib'eeh aj tiij. Eh wila' awach i tokoom xumin i koq riib' chub'aan taqe i kamanik re' re' i ruk'ul chi naa rukanteesjiik, inki.</para>
  <para style="p">
    <verse number="8" style="v" />Re' i QaJaaw Dios, je' wili i xuq'or reh i Aarón, re' hin naa nuye'em panaq'ab' rilariik chu'nchel i mayiij. Eh chu'nchel i mayiij q'e' looq' naakiqasam weh i aj Israel, re' hin naa nuye'em aweh i hat, je' wo' keh awak'uun. Re' wili naa nukanaam chi jinaj k'uhb'aal reh juneliik. <verse number="9" style="v" />Re' taqe i mayiij naa ruk'ahtiik wilik rusantohiil naa nuye'em aweh, je' wo' hoq i peet wach i tik, je' wo' hoq i mayiij tojb'al riij mahk, je' wo' hoq i mayiij pahqb'al kuyb'al mahk noq neenq'ehtjik jino'q i k'uhb'aal, je' re' noq chu'nchel i re' naa rukahniik aweh, eh keh awak'uun. <verse number="10" style="v" />Eh re' taq i hat k'amal b'eeh aj tiij re' taqe i mayiij re' re' naa ak'uxlaam taq wii' awiib'. Xa re' la' chupaam jino'q i ye'aab' santo taq naa ak'uxum ruum wilik kisantohiil.</para>
  <para style="p">
    <verse number="11" style="v" />Eh naa wo' nuye'em aweh chu'nchel i mayiij naa kiq'asam i aj Israel, naa rukahniik cha weh i hat, eh chi keh taqe awak'uun awixq'uun neerub'an chi neenkik'ux keh chu'nchel i wilkeeb' pana paat xa re' la' mi ma' xta ruch'uwa'iil kiwach. Re' wili naa rukahniik chi jinaj k'uhb'aal reh juneliik. <verse number="12" style="v" />Eh naa wo' nuye'em aweh chu'nchel i peet wach i kitik naa kiq'asam chi kimayiij i aj Israel, je' wo' taqe i riis ki uuva, taqe i holohik aseite, taqe i peet wach i ki trigo naa kik'amam chaloq. <verse number="13" style="v" />Chu'nchel i peet wach i kitik naakiq'aasam weh chi kimayiij naa wo' nuye'em aweh. Eh nee wo' rub'an chi neenkik'ux keh chu'nchel i wilkeeb' panapaat, xa re' la' mi ma' chih ruch'uwa'iil kiwach. <verse number="14" style="v" />Je' re' noq naa nuye'em aweh chu'nchel i mayiij naa kiq'asam weh i aj Israel.</para>
  <para style="p">
    <verse number="15" style="v" />Eh naa wo' nuye'em aweh i peet kak'uun i aj Israel, ruch'ihil i peet rak'uun i kichikoop naa kiq'asam weh chi kimayiij. Xa re' la' re' peet kak'uun i winaq ch'uwa' kiwach koruman chi naa kitojom riij, je' wo' hoq i peet kak'uun i chikop ma' kik'uxarik taj. <verse number="16" style="v" />Eh noq naa kitojom riij jinaj poh raasjiik ho'oob' chi tumiin naa kitojom wii' riij re' i rahlil, je' wo' rukab' pajooj imb'aan chupaam i nuSanto laj itz'ihy naah paat. <verse number="17" style="v" />Xa re' la' ma' naa ta ye'em q'ab' chi naa rutojiik riij i peet rak'uun i wakax, i peet rak'uun tentzun, i peet rak'uun i kaprax. Ruum re' taqe i chikop re' re' kanamaj chi weh taqe. Re' hat naa akansam taqe, eh re' kikik'eel naa achihkaam chinaah i artaal. Eh re' i kixeb'ohiil naa ak'atam chi nk'ohnik laj mayiij chi nuwach. <verse number="18" style="v" />Eh re' i kitib'kaal i chikop, i rutib'kaal i chi' kik'ux, i rusak'aaj kituuq naa kiq'asam chi nuwach chi mayiij naa nuye'em aweh. <verse number="19" style="v" />Eh chu'nchel i mayiij naa kiq'asam weh i aj Israel, naa nuye'em aweh i hat, keh awak'uun awixq'uun, keh awiih aamaam. Re' wili ma' naa ta rujaliik wach naa rukahniik chi k'uhb'aal chi juneliik cha weh i hat, chi keh awiih aamaam naa kiwihiik kahnoq chawiij, inki.</para>
  <para style="p">
    <verse number="20" style="v" />Re' QaJaaw Dios, je' wili i xuq'or reh i Aarón: Re' hat ma' naa ta ruwihiik awak'aal, oon chib'ih aweh Israel, chi je' rukab' taqe i aj Israel wilik chib'ih keh. Xa re' la' wo' hin naa nuwihiik chi akooch ayu' Israel. <verse number="21" style="v" />Eh re' taqe i riih rumaam i Leví naa nuye'em chi kikooch i jinaj naa reliik ruuk' i lajeeb' chib'ih wilik keh i aj Israel chi tojb'al riij i kamanik naa kianam chupaam i santo laj itz'ihy naah paat molb'al iib'. <verse number="22" style="v" />Re' taqe i aj Israel ma' naa ta chik kijilim i koq kiib' ruuk' i santo laj itz'ihy naah paat molb'al iib'. Eh wila' xkijil i koq kiib' mahk i neenkian ruum i re' neenchalik i kimik chikinaah. <verse number="23" style="v" />Xa re' wo' taqe i aj Levíta naa kib'aniik i kamanik chupaam i santo laj itz'ihy naah paat molb'al iib'. Eh wila' awach i xuch'uwa'reej paam i wach kinaah i aj Levíta naa rukahniik. Re' wili naa rukahniik chi jinaj k'uhb'aal chi keh i tuutb'ees ajaab'ees, chi keh i kiih kimaam. Eh re' taqe i aj Levíta ma' naa ta ruwihiik kak'aal ayu' Israel. <verse number="24" style="v" />Re' hin naa nuye'em keh chi kikooch i jinaj naa reliik ruuk' i lajeeb' i wach i kitik naakiq'aasam chi kimayiij i aj Israel chi nuwach. Ruum aj re' xnuq'or chi ma' naa ta ruwihiik kiye'aab' ayu' Israel, inki.</para>
  <para style="p">
    <verse number="25" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="26" style="v" />Re' hat cha q'or keh i aj Levíta chi noq naakik'ulum reh taqe i aj Israel i ju'jun naa reliik chinaah i lajeeb' i wach i kitik. Re' i naakik'ulum re' re' naa wo' chik kesam i keh i lajeeb' chinaah i jinaj siento reh chi naakiq'aasam chi kimayiij chi nuwach i hin, inki <verse number="27" style="v" />Eh re' i kimayiij re' re' naa nuk'ulum i hin je' rukab' noq i nuk'ul i kimayiij taqe i aj Israel noq inkiq'asaj i wach i kitik, eh noq inkiq'asaj i riis i ki uuva. <verse number="28" style="v" />Eh re' taqe i aj Levíta noq naakik'ulum kuuk' i aj Israel i ju'jun naa reliik ruuk' i lajeeb' naa wo' chik kiq'asam weh hin i keh i lajeeb' naa kesam ruuk' i jinaj siento, eh naakiye'em reh i Aarón k'amal kib'eeh aj tiij. <verse number="29" style="v" />Eh aha' wilik i naakik'ulum inchol kikanaam k'isinoq chi weh i q'e' holohik. Re' re' i naa kiq'asam weh i hin.</para>
  <para style="p">
    <verse number="30" style="v" />Eh nee wo' naq'or keh i aj Levíta noq kiq'asam chik i xti holohik naa nuk'ulum keh i kimayiij je' rukab' noq i nuk'ul i kimayiij i aj Israel re' peet wach i kitik re' i riis i ki uuva, re' i peet wach i ki trigo. <verse number="31" style="v" />Eh re' taqe i aj Levíta neerub'an chi xa aha' neenkik'ux i keh kuch'ihil taqe i kak'uun kixq'uun ruum re' re' kitojb'aal chi riij i kamanik naa kianam chupaam i santo laj itz'ihy naah paat molb'al iib'. <verse number="32" style="v" />Eh wila' re' taqe aj Levíta xkiq'asaj wee hin i xti holohik ma' xta kimahk, eh ma' nee ta nkich'uwa'reej wach i kisantolaj mayiij i aj Israel. Ruum wixkich'uwa'reej wach naa ruchaliik i kimik chikinaah, tiko'q keh, inki Dios.</para>
  <chapter number="19" style="c" />
  <para style="s">Re' k'uhb'aal chi riij nik' wach noq naakisaqb'isam kiib' taqe i ch'uwa' kiwach</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés, i Aarón: <verse number="2" style="v" />Re' hin jinaj i k'uhb'aal naa nukanaam keh i aj Israel re' wili: Chaq'or taq keh i aj Israel chi kik'am cho jino'q i kaq riij q'ahxoq wakax manlik wach i ruti'jolal. Eh ma' kojooj ta perper wach chee' rij naah reh kamanik. <verse number="3" style="v" />Eh re' taq i hat nee taq inaq'asaj reh i Eliazar k'amal kib'eeh aj tiij. Re' reh naa resam reje i q'ahxoq wakax re' re' chi riij taqe i itz'ihy naah paat wilkeeb' wii', eh naa ruq'orom chi naa ruyok'ariik i ralaq chuwach. <verse number="4" style="v" />Eh re' i Eliazar i k'amal kib'eeh aj tiij naa ruchopom cho k'isinoq i kik' ruuk' i ju' q'ab', wuquub' pech naa rukihraam i kik' chinaah i santo laj itz'ihy naah paat molb'al iib'. <verse number="5" style="v" />Eh chi riij i re' naa ruk'ahtiik i q'ahxoq wakax chuwach i Eliazar k'amal kib'eeh aj tiij. Eh naa wo' ruk'atariik i rutz'uhumal riij, i rutib'kaal, i rukik'eel, je' wo' hoq i rusaa'. <verse number="6" style="v" />Eh re' i k'amal kib'eeh aj tiij re' re' naa ruchopom chaloq i juntoq chi chee' chakaltee', i q'ab' i chee' hisopo, i junsahl i kaq itz'ihy naa rukutum chupaam i q'aaq' naa ruk'ahtiik wii' i q'ahxoq wakax. <verse number="7" style="v" />Eh re' Eliazar i k'amal kib'eeh aj tiij naa rutz'ajam taqe ruso', naa rub'anam ritiin junpa'liik. Kora'j naa rokiik re' chupaam i itz'ihy naah paat wilkeeb' wii'. Xa re' la' konaa wo' rukahniik chi ch'uwa' wach korehtaal inokik i q'iij. <verse number="8" style="v" />Eh awach naa ruk'atwiik reh i q'ahxoq wakax naa rukahniik chi ch'uwa' wach naa rutz'ajam taqe ruso', naa rub'anam ritiin jumpa'liik, eh konaa wo' rukahniik chi ch'uwa' wach korehtaal inokik i q'iij. <verse number="9" style="v" />Re' i winaq ma' xta ruch'uwa'iil wach naa rumolwiik reh i ruchajil i q'ahxoq wakax, naa rojiik ruye'em chupaam i ye'aab' saq wach kochiriij taqe reje i itz'ihy naah paat wilkeeb' wii'. Re' i chaaj re' re', naa rukamaniik keh i aj Israel, reh chi naa kikojom ruuk' i haa' inkamanik chi saqb'eesb'al iib' chi riij i mahk. <verse number="10" style="v" />Re' i winaq naa rumolwiik reh i ruchajil i q'ahxoq wakax naa rutz'ajam i ruso', eh naa rukahniik chi ch'uwa' wach korehtaal inokik i q'iij. Re' i k'uhb'aal wili naa a'nam taq i hat, i hat taq aj Israel koruman wo' chi naa kianam i tokoom tinamit wilkeeb' taq chaxilak.</para>
  <para style="p">
    <verse number="11" style="v" />Eh xa awach pa' neentz'a'inik reh i ruti'jolal jino'q i kamnaq, wuquub' q'iij naa rukahniik chi ch'uwa' wach. <verse number="12" style="v" />Eh re' winaq re' re' koruman chi paroox q'iij naa rusaqb'isam riib' ruuk' i haa' re' re', chi je' re' naa rukahniik chi saq wach paruwuuq q'iij. Eh wila' ma' xusaqb'isaj riib' paroox q'iij ma' naa ta rukahniik chi saq wach paruwuuq q'iij. <verse number="13" style="v" />Eh xa awach pa' neentz'a'inik reh i ruti'jolal i kamnaq, wila' ma' xusaqb'isaj riib' re' reh naa ruch'uwa'reem paam i nuSanto laj itz'ihy naah paat i hin i ruum i re' koruman chi naa rehtesjiik reje chi kixilak i aj Israel. Ruum chi ma' xkihrjik ta chinaah i ha' insaqb'isanik wachiis, naa rukahniik chi ch'uwa' wach.</para>
  <para style="p">
    <verse number="14" style="v" />Eh re' i wili i k'uhb'aal naa nukanaam chikinaah i wilkeeb' chupaam taqe i itz'ihy naah paat, wila' awach i xkimik chupaam taqe i itz'ihy naah paat, chu'nchel i naa kiwihiik ar, eh chu'nchel i naa kokiik ar, wuquub' q'iij naa kikahniik chi ch'uwa' kiwach ruum i re'. <verse number="15" style="v" />Eh re' taqe kulk, chu'nchel i xa chib'ih jariik inkamanik ar ma' tz'apooj ta kinaah naa wo' kikahniik chi ch'uwa' kiwach.</para>
  <para style="p">
    <verse number="16" style="v" />Eh pantaq ye'aab' xa aha' wila' awach xtz'a'inik reh ruti'jolal i kamnaq xaxkanteesjik oon xaparub'ehel xkimik, oon xutz'a'j i koq jino'q i rub'aqil i kamnaq, oon rujuleel kamnaq. Re' reh wuquub' q'iij naa rukahniik chi ch'uwa' wach.</para>
  <para style="p">
    <verse number="17" style="v" />Re' saq b'eesb'al wach i xuch'uwa'reej riib' naa ruchopariik cho k'isinoq i ruchajil i q'ahxoq wakax kaq riij re' ink'atarik chi riij i mahk. Re' chaaj re' re' naa ruxilaakjiik ruuk' i k'achlik haa' naa ruye'ariik chupaam jino'q i kulk. <verse number="18" style="v" />Eh re' i winaq ma' xta ruch'uwa'iil wach nee ruchop i q'ab' chee' hisopo naa rumuhaam chupaam i haa' re' re', naa rukihraam chinaah awach i xuch'uwa'reej riib' ruuk' i rutz'a'jiik i ruti'jolal i xaxkanteesjik, oon xaparub'ehel xkimik, oon xutz'a'j jino'q i b'aaq, oon jino'q i rujuleel i kamnaq. Eh naa wo' rukihraam chinaah i itz'ihy naah paat, eh chikinaah i tinamit ar, je' wo' chikinaah i xa chib'ih jariik i kikamanik ar. <verse number="19" style="v" />Eh re' winaq ma' xta ruch'uwa'iil wach naa wo' rukihraam i ha' re' re' paroox q'iij, paruwuuq q'iij chinaah i ch'uwa' wach. Eh paruwuuq q'iij naa rukahniik chi saq wach, eh naa rutz'ajam i ruso', naa rub'anam ritiin jun pa'lik, xa re' la' konaa wo' rukahniik chi ch'uwa' wach korehtaal inokik i q'iij. <verse number="20" style="v" />Eh awach i ma' xusaqb'isaj riib' xkahnik chi ch'uwa' wach, koruman chi naa rehtesjiik reje chi kixilak i aj Israel. Iraaj ruq'orom chi nee ruch'uwa'risaj paam i rusantolaj ye'aab' i QaJaaw Dios. Eh ruum chi ma' xkihrjik tee ha' insaqb'isanik wach chinaah naa rukahniik chi ch'uwa' wach chi jumpech. <verse number="21" style="v" />Re' i nuk'uhb'aal wili naa rukahniik chi juneliik. Awach i naa rukihraniik i ha' saqb'eesb'al wachiis chinaah i tokoom koruman chi naa rutz'ajam i ruso'. Eh awach i neentz'a'inik reh i ha' saqb'eesb'al wachiis naa rukahniik chi ch'uwa' wach korehtaal inokik i q'iij. <verse number="22" style="v" />Eh chu'nchel i xa chib'ih jariik naa rutz'a'am i ch'uwa' wach, re' taqe re' naa wo' kikahniik chi ch'uwa' kiwach. Eh wila' re' ch'uwa' wach xutz'a'j jino'q i winaq, re' re' naa wo' rukahniik chi ch'uwa' wach, tiko'q keh, inki Dios.</para>
  <chapter number="20" style="c" />
  <para style="s">Re' noq xelik chee ha' pansaq rehp ab'aj</para>
  <para style="p">
    <verse number="1" style="v" />Chupaam i peet poh reeh i haab', re' taqe i aj Israel xi ponik chupaam i ye'aab' chiq yuuq' Zin. Eh ar xi kahnik chupaam i tinamit Cades, eh ar xkimik i María, ar wo' xkimuq'aa'.</para>
  <para style="p">
    <verse number="2" style="v" />Eh ruum chi ma' xkireq ta kihaa' i aj Israel chupaam i ye'aab' re' re' xchalik kijosq'iil chinaah i Moisés, ruch'ihil i Aarón. <verse number="3" style="v" />Je' wili xkiq'or i tinamit reh i Moisés:</para>
  <para style="p">Ma' xta naq reet chi xoj kimik ta haa' kuuk' i tinamit xukansaj i QaJaaw Dios. <verse number="4" style="v" />¿Chib'ih reet noq xoj ak'am taq chaloq i hoj, hoj rutinamiit i QaJaaw Dios chupaam i chiq yuuq' wili? ¿Mi naawaaj taq re' hat chi naaqakimiik chi qunchelaal i hoj, ruch'ihil taqe i qachikoop? <verse number="5" style="v" />¿Chib'ih reet noq xoj awesaj taq cho Egipto, eh ayu' taq chik xoj ak'am chaloq chupaam i ye'aab' wili ma' xta kamaj? Ayu' ma' xta i neenqatik qeh, ma' rub'an taj i higo, i uuva, i granado. Eh ni xata naq ha' i wilik chi neenquk'ej, inki taqe.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' i Moisés ruch'ihil i Aarón xi elik reje chikiwach i tinamit xiooj panookb'al reh i santo laj itz'ihy naah paat molb'al iib', xkik'utzaa' qohoq kiib' korehtaal xkireq wach ak'al ruuk' i yejal kiwach. Eh re' i ruloq'il i Dios xuk'uhtaaj riib' chikiwach. <verse number="7" style="v" />Re' i QaJaaw Dios, je' wili i xuq'or reh i Moisés:</para>
  <para style="p">
    <verse number="8" style="v" />Re' hat cha chop i karote, eh awuch'ihil i Aarón noq neenamol kiwach i tinamit. Eh chikiwach i keh nee taq inaq'or reh i saq rehp ab'aj chi nee ruyeew chaloq i ha' nee taq inawilow chi nee nelik chaloq i ma' k'isa, ha' eh neenkian kihaa' chu'nchel i tinamit, je' wo' i kichikoop, inki.</para>
  <para style="p">
    <verse number="9" style="v" />Eh re' i Moisés xuchop wo' hoq i karote wilik chuwach i QaJaaw je' rukab' i xq'orarik reh. <verse number="10" style="v" />Re' i Moisés, i Aarón xkimol wach i tinamit chuwach i saq rehp ab'aj, re' i Moisés je' wili i xuq'or keh:</para>
  <para style="p">Chab'iraj taq i hat i xaq'etwachej taq i Dios: ¿Mi rik'ul re' chi re' hoj naaqesam chee ha' chupaam i saq rehp ab'aj wili reh chi nee taq inqayeew aweh chi uuk'jik?</para>
  <para style="p">
    <verse number="11" style="v" />Eh noq xukohlaaj ruq'orariik i re' i Moisés xuksaj johtoq i karote, eh ka'pech xuq'oj i koq wach i saq rehp ab'aj ruuk' i karote. Eh yohb'aal wach i ha' xelik cho chupaam, eh re' taqe i aj Israel ruch'ihil i kichikoop xkian kihaa'. <verse number="12" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés, i Aarón:</para>
  <para style="p">Ruum chi ma' xanimaj ta taq i xnuq'or aweh, eh ma' xayeew ta taq nuloq'il chikiwach i aj Israel. Re' hin ma' naa ta nuye'em q'ab' chi nataq akojom i koq i tinamit wili chupaam i ye'aab' nuq'orom rib'iral chi naa nuye'em keh, inki.</para>
  <para style="p">
    <verse number="13" style="v" />Re' taqe wili xk'ularik chupaam i ye'aab' xelik wii' i ha' ar Meriba re' i xkichoqej wii' i QaJaaw taqe i aj Israel. Eh re' reh ruuk' taqe i xub'an ar xuk'uhtaaj chikiwach chi wilik i rusantohiil.</para>
  <para style="s">Re' Edom ma' xuyeew ta q'ab' chi xik'ik paruye'aab' taqe i aj Israel</para>
  <para style="p">
    <verse number="14" style="v" />Noq ko wilkeeb' ar Cades, re' i Moisés wilik taqe i raj taqareel xutaq'aaj reje ruuk' i kireey i aj Edom, je' wili i xkiq'or ponoq reh: Re' hoj i hoj aj Israel quuk' qiib' taq awuuk' i hat xoj taq'ab'jik chaloq chuq'orariik aweh, re' hat aweht'al wo' hoq chib'ih i ti' k'axik xoj ik'ik wii'. <verse number="15" style="v" />Re' taqe i qamaam qati't najtir xiooj chi patinik ar Egipto najt xi k'acharik ar, eh xi ik'tesjik chi ti' k'axik kuum i aj Egipto, eh je' wo' chik re' i xkian qeh hoj. <verse number="16" style="v" />Ruum i re' xqapahqaaj otob'il reh QaJaaw Dios chi naakooj resam cho ar, xub'iraj wo' hoq i xqapahqaaj reh ruuk' oq'ik, xutaq'aaj chaloq jinaj i ánjel xoj resaj wo' cho ar Egipto yu'naak ar chik wilkooj chupaam i tinamit Cades, pank'ula't cho ruuk' aaye'aab'. <verse number="17" style="v" />Ruum aj re' xoj chalik chupahqaljiik aweh otob'il reh chi nee nayeew q'ab' qeh chi nee qoh ik'ik paruyuq'ul aatinamiit. Re' hoj ma' nee ta qoh ik'ik chupaam i ye'aab' wilkeeb' wii' i tik mu'uun re' i tikooj wii' taqe i uuva. Eh ma' nee ta wo' i nquk'eej qeh i ha' wilkeeb' chupaam taqe ajul haa'. Eh re' i korik b'eeh neenqak'am ma' nee tan qajal i qab'eeh korehtaal inqaq'at wach i ruyuq'ul aatinamiit, inki taqe.</para>
  <para style="p">
    <verse number="18" style="v" />Eh re' i kireey i aj Edom je' wili i xuq'or:</para>
  <para style="p">Re' hin ma' nee ta nuyeew q'ab' chi nee taq ti ik'ik paruyuq'ul i nutinamiit. Eh wila' xamin taq chawiib' chi ik'ik, netaq tiooj nuq'at wuch'ihil taqe i nu soldado, inki.</para>
  <para style="p">
    <verse number="19" style="v" />Eh re' taqe aj taqareel je' wili i xkiq'or reh:</para>
  <para style="p">Chakuy chayeew ti q'ab' qeh re' hoj re' korik b'eeh neenqak'am, eh wila' re' hoj, oon wila' re' taqe i qachikoop xkuk'ej keh i ha' wilkeeb' chupaam taqe ajul haa' nee wo' inqatoj aweh, re' inqaaj re' chi nee nayeew q'ab' qeh chi nee qoh ik'ik chi qooq, inki taqe.</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' i kireey i aj Edom je' wili i xuq'or: Re' hin.</para>
  <para style="p">Xnuq'or taq chik aweh chi ma' nee ta taq ti ik'ik, inki.</para>
  <para style="p">Eh xuk'am taqe reje i ru soldado wilik kikanteesb'aal kuuk' xooj chi kiq'atariik i aj Israel. <verse number="21" style="v" />Eh re' Edom ma' xuyeew ta q'ab' chi xik'ik chupaam i ruyuq'ul i rutinamiit. Eh kilow chi je' re' i aj Israel tokoom chik i b'eeh xkik'am reje.</para>
  <para style="s">Re' noq xkimik i Aarón</para>
  <para style="p">
    <verse number="22" style="v" />Eh chu'nchel i tinamit xi elik pan tinamit Cades ar xiooj reje chi korkiil i yuuq' Hor. <verse number="23" style="v" />Eh ar pank'ula't reje reh i ruyuq'ul i rutinamiit i Edom, je' wili i xuq'or i QaJaaw Dios reh i Moisés, i Aarón: <verse number="24" style="v" />Re' i Aarón naa rukimiik ma' naa ta nuye'em q'ab' chi naa rukojom i koq taqe i aj Israel wili chupaam i ye'aab' nuq'orom rib'iral chi naa nuye'em keh ruum akab'cheel taq ma' xanimaj ta taq i nuk'uhb'aal aha' xelik cho wii' i ha' ar Meriba. <verse number="25" style="v" />Re' hat Moisés chak'am johtoq i Aarón ruch'ihil i rak'uun Eleazar chinaah i yuuq' Hor. <verse number="26" style="v" />Eh ar neenawesaj i ruso' chi riij re' xukoj noq xkahnik chi k'amal kib'eeh aj tiij, chi riij chik i Eleazar i rak'uun nee nakoj. Re' Aarón ar naa rukimiik chaloq.</para>
  <para style="p">
    <verse number="27" style="v" />Eh re' i Moisés xub'an wo' hoq nik' wach i xq'orarik reh ruum i QaJaaw Dios. Eh chikiwach i ruk'ihaal tinamit xijohtik johtoq chinaah i yuuq' Hor. <verse number="28" style="v" />Eh re' Moisés ar xresaj chi riij i ruso' i Aarón re' xukoj noq xkahnik chi k'amal kib'eeh aj tiij, eh chi riij chik i Eleazar xukoj re' i rak'uun i Aarón. Eh chinaah i yuuq' Hor xkimik i Aarón. Re' i Moisés ruch'ihil i Eleazar xiqajik cho ar. <verse number="29" style="v" />Eh noq xkib'iraj i aj Israel chi xkimik i Aarón i k'amal kib'eeh aj tiij, ma' k'isiin ta xtib'ik kik'ux, lajeeb' ru ka'winaq q'iij xkoq'ej.</para>
  <chapter number="21" style="c" />
  <para style="s">Re' taqe i aj Israel xkisach wach i tinamit ki-ik'ik wii'</para>
  <para style="p">
    <verse number="1" style="v" />Re' i kireey i aj Canaán i wilik chupaam i tinamit Arad wilik Neguev noq xrib'iraj chi ik'ik inki a'n chupaam i b'eeh Atarim taqe i aj Israel. Re' reey re' re' ruch'ihil taqe i aj Canaán Arad xiooj chi kipeletojiik taqe i aj Israel, eh wilik taqe i xkik'am prexo. <verse number="2" style="v" />Eh re' taqe i aj Israel, je' wili i xkiq'or reh i QaJaaw Dios: Wila' re' hat xoj atoob'eej chi neenqachop naah i tinamit re' re', re' hoj inqaq'or aweh chi neenqasach wach kitinamiit, inki taqe. <verse number="3" style="v" />Re' i QaJaaw Dios xuyeew wo' keh i aj Israel i xkipahqaaj, xutoob'eej wo' taqe reh chi xkisach wach taqe i aj Canaán, je' wo' kitinamiit. Je' re' noq re' ye'aab' re' re' Horma i rub'ihnaal xkikoj.</para>
  <para style="s">Re' aaq' q'an ch'ihch' korjinaq wii'</para>
  <para style="p">
    <verse number="4" style="v" />Re' taqe i aj Israel xi elik reje chinaah i yuuq' Hor ar xkik'am reje chi korkiil i kaq palaw, konajt xponik kikotej reh chi ma' xi-ik'ik ta chupaam i ruyuq'ul i Edom. Eh re' taqe i aj Israel chalik ruyojiik kik'ux wach b'eeh. <verse number="5" style="v" />Eh ma' holohik taj xiq'orik chi riij i Dios, je' wili i xkiq'or reh i Moisés:</para>
  <para style="p">¿Chib'ih reet noq xoj awesaj chaloq Egipto? ¿Mi xoj ak'am cho chupaam i chiq yuuq' wili reh chi ayu' naaqakimiik? Ayu' ma' xta qawa', qahaa', xoj q'uhtik chik reh i k'uxumb'al wili ruum xama' qoh runujisaj ta wo' hoq, inki taqe.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' i QaJaaw Dios xutaq'aaj chaloq i ma' k'isa aaq' chi kixilak i aj Israel xi k'uxarik ruum, eh ma' k'isiin i xikimik. <verse number="7" style="v" />Eh re' taqe i aj Israel xiooj ruuk' i Moisés je' wili i xkiq'or reh:</para>
  <para style="p">Re' hoj xoj mahkunik ruum ma' holohik ta xoj q'orik chi riij i Dios, je' wo' chawiij i hat. Chakuy cha pahqaaj ree Dios chi neeresaj chi qaxilak i ma' k'isa aaq', inki taqe.</para>
  <para style="p">Eh re' i Moisés xupahqaaj wo' reh i QaJaaw Dios chi chukuy kimahk i aj Israel. <verse number="8" style="v" />Eh re' i QaJaaw Dios je' wili i xuq'or reh i Moisés:</para>
  <para style="p">Re' hat cha yejaa' jino'q i aaq' re' ruuk' i q'an ch'ihch', eh nee nayeew chi ju' jino'q i chee'. Eh noq neenti'arik jino'q i xa awach ruum i aaq' nee rutz'ehtaaj johtoq i aaq' wilik ju' chee' reh chi ma' neetankimik, inki.</para>
  <para style="p">
    <verse number="9" style="v" />Re' i Moisés xuyejaa' wo' hoq jinaj i aaq' re' ruuk' i q'an ch'ihch'. Xuyeew wo' chi ju' i chee'. Eh noq inti'arik jino'q i xa awach rutz'ehtaaj johtoq i aaq' wilik ju' chee', eh ma' inkimik ta wo' hoq.</para>
  <para style="p">
    <verse number="10" style="v" />Eh re' taqe i aj Israel xiooj chikiwach ruuk' i kib'eeh ar chik xooj kiyejaa' ki-itz'ihy naah paat chupaam i ye'aab' Obot. <verse number="11" style="v" />Noq xi elik chaloq ar, xooj kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Ije-abarim, chupaam i chiq yuuq' wilik reje parelb'aal q'iij reh i ruyuq'ul i tinamit Moab. <verse number="12" style="v" />Eh noq xi elik chaloq ar wach k'ixkaab' Zered chik xponik kiyejaa' i ki-itz'ihy naah paat. <verse number="13" style="v" />Eh noq xi elik chaloq ar, xooj kiyejaa' i ki-itz'ihy naah paat chi juntar i nim ha' Arnón, i nelik chaloq chupaam i ye'aab' chiq yuuq', eh rupuhkaaj reje riib' chupaam i kiye'aab' i aj amorreo. Eh re' i nim ha' Arnón re' re' inkamanik chi q'atb'al paam i kiye'aab' i aj Moab ruuk' i kiye'aab' i aj amorreo. <verse number="14" style="v" />Re' q'aq'inik wili xub'an i Dios tz'ihb'amaj rehtalil panhuuj, re' i ruq'or chi je' wili:</para>
  <para style="b" />
  <para style="q">Re' QaJaaw Dios xuk'uhtaaj i rajaawriik</para>
  <para style="q">noq xojrik'saj cho chupaam i kaq palaw,</para>
  <para style="q">eh noq xoj ik'ik cho chi chii'</para>
  <para style="q">taqe i rooq i nim ha' Arnón.</para>
  <para style="q">
    <verse number="15" style="v" />Eh xoj ik'ik wo' chi chii' i raasb'al ha'</para>
  <para style="q">i rupuhkaaj reje riib' paruyuq'ul i Ar,</para>
  <para style="q">imponik kopan k'ula't reh i ruyuq'ul i Moab, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" />Eh noq xi elik reje ar xooj kiyejaa' i ki-itz'ihy naah paat chi chii' i jul ha' Beer. Eh ar re' i QaJaaw Dios, je' wili i xuq'or reh i Moisés: Chamol kiwach i aj Israel, re' hin naa nuye'em kihaa', inki. <verse number="17" style="v" />Chupaam i q'iij re' re' xkian kitz'uuy i aj Israel je' wili i xkiq'or:</para>
  <para style="b" />
  <para style="q">Hat jul ha' chayeew cho qahaa' re' hoj</para>
  <para style="q">neenqayeew aloq'il ruuk' qatz'uuy.</para>
  <para style="q">
    <verse number="18" style="v" />Re' i jul ha' re' re', re' taqe i k'amal b'eeh</para>
  <para style="q">re' taqe i wilik kajaawriik xik'otwik reh ruuk' i kikarote, inki taqe chi tz'uuy.</para>
  <para style="q">Eh noq xi elik chupaam i chiq yuuq' re' re' i aj Israel ko ar chik</para>
  <para style="q">xooj kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Matana. <verse number="19" style="v" />Eh noq xi elik reje ar ko Nahaliel chik xooj kiyejaa' i ki-itz'ihy naah paat, noq xi elik reje ar ko Bamot chik xooj kiyejaa' i ki-itz'ihy naah paat. <verse number="20" style="v" />Eh noq xi elik reje ar i aj Israel, ar chik xooj kiyejaa' i ki-itz'ihy naah paat wach k'ixkaab' wilik paruyuq'ul i Moab. Eh ki-ik'ik chinaah i yuuq' Pisga, re' ink'utinik reje wii' i ye'aab' chiq yuuq'.</para>
  <para style="s">Re' taqe i aj Israel xkiq'at wach i rajaawriik i reey Sehón</para>
  <para style="r">(<ref loc="DEU 2:26-37">Deut 2.26-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" />Re' taqe i aj Israel wilik taqe i taqareel xkitaq'aaj reje ruuk' i Sehón kireey i aj amorreo, je' wili xkiq'or reh: <verse number="22" style="v" />Re' hoj xchalik qapahqaaj otob'il aweh re' chi nee ta ti nayeew q'ab' qeh chi nee qoh ik'ik chupaam i aye'aab', re' hoj ma' nee ta qoh ik'ik wilkeeb' wii' atik, taqe tikooj wii' i uuva, eh ma' nee ta wo' quk'ej qeh i ahaa' chupaam taqe ajul haa'. Chi korik b'eeh neenqak'am noq neenqaq'at wach aaye'aab', inki taqe.</para>
  <para style="p">
    <verse number="23" style="v" />Eh re' i reey Sehón ma' xuyeew ta q'ab' chi xi-ik'ik chupaam i ruye'aab'. Xumol kiwach i rutinamiit xiooj chi kik'ulariik taqe i aj Israel chupaam i ye'aab' chiq yuuq'. Eh noq xi ponik i aj Israel chupaam i ye'aab' Jahaza xtohq'ik kipletoheem. <verse number="24" style="v" />Xa re' la' re' taqe i aj Israel xkiko'leej kiib' chi korik xb'aan reh i reey ruch'ihil taqe i rutinamiit. Eh xkichop naah i ruye'aab' ar xutoqaa' reje Arnón kox ponik chi chii' i nim ha' Joboc, koxponik pank'ula't reh i ruyuq'ul i kitinamiit i aj Amón, re' i kotimaj riij chi tz'aq. <verse number="25" style="v" />Je' re' noq re' taqe i aj Israel xkichop naah chu'nchel i kitinamiit i aj amorreo. Eh re' taqe i wilkeeb' chupaam i tinamit Hesbón xi kahnik wo' chi patinik ar. <verse number="26" style="v" />Re' Hesbón re' i rutinamiit i Sehón, re' i kireey i aj amorreo. Re' Sehón rub'anam chaloq i q'aq'inik ruuk' i peet kireey i aj Moab ruq'uchum cho reh i ye'aab' re' re' komponik chi chii' i Arnón. <verse number="27" style="v" />Ruum aj re' inkiq'or pan kitz'uuy i aj tz'uuy chi je' wili:</para>
  <para style="b" />
  <para style="q">Kim taq Hesbón cha yejaa' wo' taq chik i tinamit re' re'</para>
  <para style="q">ruum re' i rutinamiit i reey Sehón.</para>
  <para style="q">
    <verse number="28" style="v" />Xqop jinaj i q'aaq' Hesbón,</para>
  <para style="q">re' rutinamiit i reey Sehón</para>
  <para style="q">xkuxik ruk'atam i ye'aab' Ar rub'ihnaal wilik paruyuq'ul i Moab.</para>
  <para style="q">Eh xkuxik wo' rusacham wach i wilkeeb'</para>
  <para style="q">chinaah taqe i yuuq' koxponik chi chii' i nim ha' Arnón.</para>
  <para style="q">
    <verse number="29" style="v" />Q'e' ti' i xak'ul i hat tinamit Moab,</para>
  <para style="q">xsacharik awach i hat naq rutinamiit i tiyoox Quemos i rub'ihnaal.</para>
  <para style="q">Re' atiyoox re' re' xuyeew q'ab'</para>
  <para style="q">chi re' taqe i b'ahiilb'ees xkimol chi elik,</para>
  <para style="q">eh chi re' taqe i ehk'eenb'ees</para>
  <para style="q">xkahnik pan q'ab' i reey Sehón.</para>
  <para style="q">
    <verse number="30" style="v" />Xsacharik wach i rajaawriik i tinamit Hesbón,</para>
  <para style="q">je' wo' hoq i Dibón,</para>
  <para style="q">je' wo' hoq i Nofa, chu'nchel i re' xsahchik kiwach.</para>
  <para style="q">Re' sachooj xub'an i q'aaq' xponik ko ar Medeba, inki taqe panki tz'uuy.</para>
  <para style="s">Re' taqe i aj Israel xkiq'at wach i rajaawriik i Og kireey i aj Basán</para>
  <para style="r">(<ref loc="DEU 3:1-11">Deut 3.1-11</ref>)</para>
  <para style="p">
    <verse number="31" style="v" />Je' re' noq re' taqe i aj Israel xkichop naah i kitinamiit i aj amorreo. <verse number="32" style="v" />Eh re' Moisés wilik taqe i winaq xutaq'aaj reje chi rilariik nik' wach noq wilik i tinamit Jezer. Eh re' taqe i aj Israel xkichop naah i tinamit Jezer, je' wo' taqe i kok' ye'aab' wilik chi junsuut, xkikaaj wo' reje taqe i aj amorreo wilkeeb' ar. <verse number="33" style="v" />Chi riij i re', re' taqe i aj Israel xkichop reje i b'eeh inooj ar Basán. Eh re' Og kireey i aj Basán ruch'ihil taqe i ru soldado xiooj chi kipletohjiik i aj Israel chupaam i ye'aab' Edrei. <verse number="34" style="v" />Eh re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: Re' hat mat yo'jik ruum i reey, re' hin naa nuq'asam panaq'ab' i reh je' wo' chu'nchel i rutinamiit, je' wo' hoq i rak'aal. Naa a'nam ruuk' je' rukab' i xa a'n ruuk' i Sehón kireey i aj amorreo re' taqe i patim chupaam i tinamit Hesbón, inki.</para>
  <para style="p">
    <verse number="35" style="v" />Je' aj re' noq re' taqe i aj Israel xkikansaj i Og, je' wo' taqe i rak'uun, xk'uxik wo' kikansam i ru soldado chi k'achalkeeb'. Eh re' chik i keh xichopwik naah i ruye'aab'.</para>
  <chapter number="22" style="c" />
  <para style="s">Re' reey Balac xutaq'aaj ruk'amariik i Balaam</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe i aj Israel xiooj wo' chik chikiwach ar chik xooj kiyejaa' ki-itz'ihy naah paat wach k'ixkaab' Moab, chucheel i nim ha' Jordán chuwach reje i tinamit Jericó.</para>
  <para style="p">
    <verse number="2" style="v" />Eh noq xrilow i Balac rak'uun i Zipor i kireey i aj Moab chi re' taqe i aj Israel xkian reh taqe i aj amorreo xchalik ruyo'jiik. <verse number="3" style="v" />Eh ma' k'isiin wo' xchalik kiyo'jiik taqe i aj Moab ruum yohb'aal wach kik'ihaal i aj Israel. <verse number="4" style="v" />Re' taqe i aj Moab, je' wili xkiq'or keh taqe i mama' winaq re' taqe i k'amal b'eeh chi kixilak i aj Madián:</para>
  <para style="p">Re' taqe i tinamit Israel wilik naa kianam qeh, naa kisacham wach i qatinamiit, je' rukab' noq i rusach wach i k'im jino'q i b'ooyax, inki taqe. <verse number="5" style="v" />Eh re' reey Balac rak'uun i Zipor xutaq'aaj ruk'amariik i Balaam rak'uun i Beor, ar wilik chupaam i ye'aab' Pator wilik chi chii' i nim ha' Éufrates wilik chupaam i kiye'aab'. Re' Balac je' wili xuq'or reje keh i raj taqareel: Re' taq i hat je' taq wili i neenaq'or reh i Balaam: Ruk'ihaal tinamit xi elik chaloq Egipto xkinujisaj chik paam i nutinamiit ayu' chik taqe patim chi nuwach. <verse number="6" style="v" />Chaloq wuuk' ayu' reh chi nee rupahqaaj i ma' holohik ta chikinaah i tinamit wili, q'e' kow kiib' chi qawach i hoj, nee oon naq inche nub'an keh, eh nee oon naq inche i nub'an reje kehteesjiik panutinamiit. Ruum re' hin weht'al chi re' reh noq i rupahqaaj i holohik inye'arik reh, eh noq i rupahqaaj i ma' holohik taj inye'arik reh, tiko'q taq ponoq reh, inki.</para>
  <para style="p">
    <verse number="7" style="v" />Eh re' taqe k'amal kib'eeh i aj Moab kuch'ihil taqe i k'amal kib'eeh i aj Madián xiooj wo' hoq chi q'orob'jiik i Balaam, eh xkik'am reje i tumiin tojb'al reh i naa ruchaliik rub'anam, xkiq'or wo' reh i Balaam i xuq'or reje i reey Balac. <verse number="8" style="v" />Eh je' wili i xq'orarik keh ruum i Balaam:</para>
  <para style="p">Re' taq i hat tikaan pee taq jino'q aq'ab' ayu', ko'qal taq inab'iraj weh ab'eeh chib'ih pa' i nee ruq'or weh i QaJaaw Dios, inki.</para>
  <para style="p">Eh re' taqe i aj taqareel xi kahnik wo' cho ruuk' i Balaam. <verse number="9" style="v" />Chupaam aq'ab' re' re' xk'ulik q'orob'joq i Balaam ruum i Dios xpahqaljik reh chi je' wili:</para>
  <para style="p">¿Awach taqe i winaq wilkeeb' awuuk'? inki.</para>
  <para style="p">
    <verse number="10" style="v" />Re' i Balaam je' wili ruchaq'weesjiik i Dios xub'an:</para>
  <para style="p">Re' Balac rak'uun i Zipor kireey i aj Moab xtaaq'anik cho keh wuuk' je' wili xutaq'aaj cho ruq'orariik: <verse number="11" style="v" />Re' taqe i aj Israel xi elik cho Egipto xkinujisaj chik paam i nutinamiit. Ruum aj re' inwaaj chi nee ti chalik wuuk', k'oloq apahqaaj i ma' holohik taj chikinaah, chi je' re' nee oon naq i nub'an keh, eh nee oon naq inwesaj taqe reje panutinamiit, inki chaloq.</para>
  <para style="p">
    <verse number="12" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Balaam:</para>
  <para style="p">Ma' nee ta tiooj, eh ma' nee ta wo' rub'an chi nee naapahq'aaj i ma' holohik taj chikinaah i aj Israel ruum re' hin nuk'uxisam taqe, inki.</para>
  <para style="p">
    <verse number="13" style="v" />Re' Balaam noq xwuktik chi junwaar, je' wili i xuq'or keh i aj taqareel:</para>
  <para style="p">Re' taq i hat ti sutinoq taq reje panatinamiit re' hin xuq'or weh i QaJaaw Dios chi ma' ruyee ta riib' chi nee taq kinooj chawiij, inki.</para>
  <para style="p">
    <verse number="14" style="v" />Re' taqe i aj taqareel re' re' xi sutinik wo' chik cho ruuk' i Balac je' wili xkiq'or reh:</para>
  <para style="p">Re' Balaam ma' xraaj ta chalik chiqiij, inki taqe.</para>
  <para style="p">
    <verse number="15" style="v" />Eh re' i Balac wilik wo' chik taqe i k'amal b'eeh xutaq'aaj taqe reje q'e' chik nimaq kiwach chuwach i xutaq'aaj taqe reje pampeet. <verse number="16" style="v" />Re' taqe i k'amal b'eeh re' re' xiooj wo' chik chi q'orob'jiik i Balaam, je' wili i xkiq'or reh:</para>
  <para style="p">Re' i Balac je' wili i xuq'or cho chawiij: Mansahchik ti paruk'ux chi neenchalik wuuk', inki <verse number="17" style="v" />Re' hin neenuyeew runimaal wach, eh neenub'an chu'nchel i nee ruq'or weh. Re' hin inwaaj chi neen k'ulik ru pahq'aaj i ma' holohik taj chinaah taqe i aj Israel wili, inki chaloq, inki taqe.</para>
  <para style="p">
    <verse number="18" style="v" />Re' Balaam je' wili i xuq'or keh aj taqareel:</para>
  <para style="p">Re' Balac atoob' ta naq nee ruyeew weh chu'nchel i oro i plata nujinaq chupaam i rupaat i rub'an wii' taaq'anik ma' jaruuj neenuq'at wach i xuq'or weh i nuDios, ni xata naq neenub'an jino'q i nim wach na'ojb'al, oon k'isiin wach na'ojb'al. <verse number="19" style="v" />Xa re' la' tikaan wo' pee taq jino'q aq'ab' ayu' i iqal taq neenuq'or aweh chib'ih pa' jariik i nee ruq'or weh i QaJaaw Dios, inki.</para>
  <para style="p">
    <verse number="20" style="v" />Re' Balaam xk'ulik ula'joq ruum i Dios chaq'ab' je' wili i xq'orarik reh:</para>
  <para style="p">Wila' re' wo' chik i hat xat chalik kiyuq'eej taqe i winaq wilkeeb' awuuk' neerub'an chi nee tiooj chikiij, xa re' la' neena a'n i neenuq'or aweh i hin, inki.</para>
  <para style="s">Re' Balaam xq'atarik parub'eeh ruum i ruánjel i QaJaaw Dios</para>
  <para style="p">
    <verse number="21" style="v" />Re' i Balaam xwuktik chi junwaar xukoj rij i rub'uuruux xjohtik chaloq chi riij xchalik chikiij taqe i k'amal kib'eeh i aj Moab.</para>
  <para style="p">
    <verse number="22" style="v" />Re' Balaam chalik chi riij ixoq b'uurux ruch'ihil taqe i kiib' chi rumoso. Eh re' i QaJaaw Dios xchalik ruk'ah chinaah i Balaam ruum xchalik wo' chikiij. Ruum i re' xuyeew riib' i ánjel parub'eeh reh chi ma' xik'ik taj. <verse number="23" style="v" />Eh re' ixoq b'uurux iqlik wii' i Balaam xrilow chi re' i ruánjel i QaJaaw rutz'apam paam i b'eeh, wilik ruq'aslaj ch'ihch' pan q'ab', re' b'uurux xelik reje pamb'eeh tokoom chik xuk'am reje. Eh noq xrilow chi je' re' i Balaam xtohq'ik ruq'ojom ixoq b'uurux reh chi xuk'am wo' naq chik i korik b'eeh. <verse number="24" style="v" />Eh chi riij i re', re' i ánjel xchalik rupab'aa' riib' panlahtz' aha' i k'ultar tikooj wii' uuva, k'ultar wo' wilik i tz'aq ab'aj chi chii' i b'eeh. <verse number="25" style="v" />Eh noq re' ixoq b'uurux xrilow chi wilik wo' chik pamb'eeh i ruánjel i QaJaaw xuyok'aa' i koq riib' wach tz'aq ar xuch'ey i koq i rutuuq i Balaam. Eh re' i Balaam xuq'oj wo' chik ixoq b'uurux. <verse number="26" style="v" />Eh re' i ruánjel i QaJaaw xchalik wo' chik chi peet b'eeh xupab'aa' riib' aha' i k'isiin wii' wach i b'eeh aha' i ma' xub'an ta chik chi xukotej riij ni xata parusak'aaj ni xata parutz'eet. <verse number="27" style="v" />Eh noq re' ixoq b'uurux xrilow wach i ruánjel i QaJaaw Dios xupach'aa' riib' wach ak'al. Eh noq xrilow chi je' re' i Balaam xkaqrik xuq'ojib'eej ruuk' q'ab' chee' ixoq b'uurux. <verse number="28" style="v" />Eh chupaam i jumehq' re' re', re' i QaJaaw Dios xuyeew q'ab' reh ixoq b'uurux chi xq'orik. Eh re' b'uurux, je' wili i xuq'or reh i Balaam:</para>
  <para style="p">¿Chib'ih jariik i ti' xnub'an aweh? ruuk' i wili oxpech chik axinaq'oj, inki.</para>
  <para style="p">
    <verse number="29" style="v" />Re' Balaam je' wili i ruch'aq' wesjiik ixoq b'uurux xub'an: Re' hat xa nujot'ariik i na a'n wilik ta jino'q i nuq'as laj kuchilo wuuk' yu'naak naq neetinukansaj, inki reh.</para>
  <para style="p">
    <verse number="30" style="v" />Eh re' ixoq b'uurux je' wili ruchaq'weesjiik i Balaam xub'an:</para>
  <para style="p">Jank'al kinokik awuuk' xa chi wiij wo' tib'ehik, eh re' hin ma' jank'al ta nub'an aweh i k'ahchi' nub'anam aweh yu'naak, inki. Eh re' Balaam je' wili chaq'wik xub'an:</para>
  <para style="p">Korik chi ma' jank'al ta na a'n weh chi je' wili, inki.</para>
  <para style="p">
    <verse number="31" style="v" />Eh re' i QaJaaw Dios xuyeew q'ab' reh i Balaam chi xrilow wach i ánjel chi ruq'atam paam i b'eeh, ruyohq'eem jinaj i ruq'as laj ch'ihch'. Eh noq xrilow chi je' re' i Balaam xuk'utzaa' qohoq riib' korehtaal xureq wach ak'al ruuk' i yejal wach. <verse number="32" style="v" />Xa re' la' xpahqaljik reh ruum i ánjel chi je' wili:</para>
  <para style="p">¿Chib'ih reet noq oxpech xaq'oj aa ixoq b'uurux? Chanab'eej noq re' hin xin chalik chi rutz'apariik ab'eeh ruum ma' holohik taj inooj a'an. <verse number="33" style="v" />Re' ixoq b'uurux oxpech xrilow nuwach noq wilkiin pamb'eeh, eh oxpech xujal rub'eeh, eh wita ma' xujal rub'eeh xat nukansaj naq chik i hat, eh re' reh ma' xnukansaj ta naq.</para>
  <para style="p">
    <verse number="34" style="v" />Eh re' Balaam je' wili ruchaq'weesjiik i ruánjel i QaJaaw xub'an:</para>
  <para style="p">Re' hin korik chi ximahkunik ruum ma' weht'al ta naq chi re' hat titz'apwik paam i nub'eeh. Wila' ma' ruk'ul ak'ux chi naawojiik nee wo' chik kin sutinik reje, inki.</para>
  <para style="p">
    <verse number="35" style="v" />Eh re' i ruánjel i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="p">Neerub'an chi nee taq tiooj chikiij taqe i winaq re' re', xa re' la' xa re' wo' neena a'n i neenuq'or aweh i hin, inki.</para>
  <para style="p">Eh re' Balaam xchalik wo' chikiij taqe i aj taqareel re' re'.</para>
  <para style="p">
    <verse number="36" style="v" />Eh noq xunab'eej i reey Balac chi xk'ulik chik iloq i Balaam xooj chi k'ulariik chupaam i tinamit wilik paruyuq'ul i Moab wilik ma' najt ta chi chii' i nim ha' Arnón, wilik reje pank'ula't reh i ye'aab'. <verse number="37" style="v" />Je' wili i xuq'or i reey Balac reh i Balaam:</para>
  <para style="p">Re' hin ka'pech xnutaq'aaj ak'amariik. ¿Chib'ih reet noq ma' nawaaj ta naq chalik? ¿Mi xakapaaj re' hat chi ma' nee ta nub'an ruye'ariik runimaal awach? inki.</para>
  <para style="p">
    <verse number="38" style="v" />Eh re' i Balaam je' wili ruchaq'weesjiik xub'an:</para>
  <para style="p">Yu'naak ayu' chik wilkiin awuuk' xin chalik cha wilariik, xa re' la' ma' xta wajaawriik chi nee tinuq'o'reej chi wib'il wiib'. Re' hin xa re' wo' neenuq'or aweh i nee ruq'or weh i Dios, inki.</para>
  <para style="p">
    <verse number="39" style="v" />Chi riij i re', re' i Balaam xooj chi riij i reey Balac ar Quiriat-huzot. <verse number="40" style="v" />Re' Balac ar xutaq'aaj kikanteesjiik taqe ixoq wakax, taqe i tentzun, reh chi xkik'am reje reh i Balaam chi naa ruk'uxum i reh, eh je' wo' taqe k'amal kib'eeh i aj Moab.</para>
  <para style="p">
    <verse number="41" style="v" />Eh chi junwaar chik re' Balac xuk'am reje i Balaam xujosaj chinaah i yuuq' Bamot-baal, ar xrilow chaloq aha' kiyejaam ki-itz'ihy naah paat chu'nchel i aj Israel.</para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Eh re' i Balaam je' wili i xuq'or reh i Balac:</para>
  <para style="p">Re' hat ayu' naa ayejaam weh i wuquub' chi artaal, eh nee nak'am cho weh i wuquub' chi imas wakax, eh wuquub' chi imas tentzun, inki.</para>
  <para style="p">
    <verse number="2" style="v" />Eh re' Balac xub'an wo' hoq i xq'orarik reh ruum i Balaam. Eh pankib'al xkik'at i ju'jun chi imas wakax i ju'jun chi imas tentzun chinaah i ju'jun chi artaal.</para>
  <para style="p">
    <verse number="3" style="v" />Eh re' i Balaam je' wili i xuq'or reh i reey Balac:</para>
  <para style="p">Re' hat tikaan pee kahnoq ruuk' i mayiij, re' hin naa wojiik chi rilariik, xk'ulik-oq chi wula'jiik i QaJaaw Dios. Eh xa chib'ih pa' jariik i nee ruyeew weh chi naab'jik neenuq'or aweh, inki.</para>
  <para style="p">Eh xooj chinaah jinaj i yuuq' ma' xta ch'ahn chuwach. <verse number="4" style="v" />Eh re' i QaJaaw Dios ar xk'ulik rula'eej i Balaam, re' i Balaam je' wili xuq'or:</para>
  <para style="p">Re' hin wuquub' i artaal xnuyeew chi korb'eesjik. Eh chikinaah i ju'jun i artaal ju'jun imas wakax, eh ju'jun imas tentzun xnuk'at chi mayiij, inki.</para>
  <para style="p">
    <verse number="5" style="v" />Re' i QaJaaw Dios xuq'or reh i Balaam i naa ruq'orom, je' wili xuq'or:</para>
  <para style="p">Hiy wo' chik aha' wilik chaloq i Balac eh cha q'or reh i xnuq'or aweh, inki.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' Balaam sutinik wo' reje eh xponik rureq i reey Balac chi pa'lik i koq ruuk' i mayiij k'ahchi' ruk'ahtiik ruch'ihil taqe ar i k'amal kib'eeh i aj Moab. <verse number="7" style="v" />Re' Balaam je' wili i xuq'or parutz'uuy.</para>
  <para style="b" />
  <para style="q">Re' i Balac kireey i aj Moab ko ar Aram xutaq'aaj nuk'amariik</para>
  <para style="q">xinik'ik cho chinaah taqe i yuuq' wilkeeb'</para>
  <para style="q">chi korkiil reje i reelb'aal q'iij, je' wili i xuq'or:</para>
  <para style="q">Kim k'oloq apahqaaj i ma' holohik taj chikinaah i aj Israel,</para>
  <para style="q">re' taqe i riih rumaam i Jacob, inki weh.</para>
  <para style="q">
    <verse number="8" style="v" />Eh ¿Nik' wach nupahqaam i hin</para>
  <para style="q">i ma' holohik taj chikinaah taqe i rukuxisam i Dios?</para>
  <para style="q">¿Nik' wach nuq'eb'em i hin i ma' xiq'eb'arik ta ruum i Dios?</para>
  <para style="q">
    <verse number="9" style="v" />Ruum re' hin kochinaah i yuuq' wilik wii'</para>
  <para style="q">taqe nimaq ab'aj inwilow reje.</para>
  <para style="q">Eh kochinaah taqe inajt kinaah yuuq'</para>
  <para style="q">wili inwilow reje i tinamit Israel</para>
  <para style="q">chi sik'ooj kiwach, ma' je' ta kikab' i tokoom i tinamit.</para>
  <para style="q">
    <verse number="10" style="v" />Re' taqe i riih rumaam i Jacob</para>
  <para style="q">ma' awach ta neenkuywik kajaljiik, je' kik'ihaal saniib'.</para>
  <para style="q">Re' hin q'e' naq inwaaj chi nee</para>
  <para style="q">kinkimik chi je' rukab' noq kikimik</para>
  <para style="q">taqe i korik wach kik'ux, inki Balaam.</para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" />Eh re' i reey Balac, je' wili i xuq'or reh i Balaam:</para>
  <para style="p">¿Chib'ih jariik i k'ahchi' kaat? Re' hin xat nuk'am chaa yu' reh chi naa apahqaam i ma' holohik taj chikinaah i aj Israel, ki-ixowanik nuwach. Eh re' hat holohik chik inchel i k'ahchi' apahqaam chikinaah, inki.</para>
  <para style="p">
    <verse number="12" style="v" />Re' i Balaam je' wili ruchaq'weesjiik xub'an:</para>
  <para style="p">Re' hin xnuq'or aweh chi xa re' wo' naa nuq'orom aweh i naa ruq'orom weh i QaJaaw Dios, inki.</para>
  <para style="p">
    <verse number="13" style="v" />Eh re' reey Balac je' wo' chik wili i xuq'or reh i Balaam:</para>
  <para style="p">Re' hat taq chi wiij pan jino'q chik tokoom ye'aab' aha' xa re' i chi junsuut i ki-itz'ihy naah paat i aj Israel ink'utinik. Ma' nee ta nawil kiwach chi korik, ar neenapahqaaj i ma' holohik taj chikinaah, inki.</para>
  <para style="p">
    <verse number="14" style="v" />Eh re' i Balac xuk'am wo' reje i Balaam chupaam i ye'aab' Zofim wilik chinaah i yuuq' Pisga, eh ar xuyejaa' i wuquub' chi artaal, chinaah i ju'jun chi artaal re' re' xuk'at i ju'jun chi kok' imas wakax, eh ju'jun imas tentzun. <verse number="15" style="v" />Eh noq wilkeeb' ar, re' Balaam je' wili i xuq'or reh i reey Balac:</para>
  <para style="p">Re' hat tikaan pee kahnoq ruuk' i mayiij, eh re' hin naa rojiik nuqoreem i QaJaaw Dios, inki.</para>
  <para style="p">
    <verse number="16" style="v" />Eh re' i QaJaaw Dios xk'ulik wo' chik chi q'orob'jiik i Balaam xuq'or wo' reh i naa ruq'orom. Eh je' wili i xuq'or reh:</para>
  <para style="p">Re' hat ti sutinoq wo' chik reje aha' wilik wii' i Balac, re' wo' chik neenaq'or reh i xnuq'or aweh pampeet, inkih.</para>
  <para style="p">
    <verse number="17" style="v" />Re' Balaam xsutinik wo' reje ruuk' i reey Balac xponik rureq chi pa'lik i koq ruuk' i mayiij k'ahchi' ruk'ahtiik, eh ruch'ihil taqe i k'amal kib'eeh i aj Moab. Eh re' i Balac xupahqaaj reh i Balaam chi je' wili:</para>
  <para style="p">¿Chib'ih xuq'or i QaJaaw? inki.</para>
  <para style="p">
    <verse number="18" style="v" />Eh re' i Balaam je' wo' chik wili i xuq'or parutz'uuy:</para>
  <para style="b" />
  <para style="q">Re' hat reey Balac rak'uun i Zipor</para>
  <para style="q">chab'iraj chi korik i naa nuq'orom aweh.</para>
  <para style="q">
    <verse number="19" style="v" />Re' i QaJaaw Dios ma' re' taj jino'q winaq chi neenchukwik q'orik,</para>
  <para style="q">eh chi neerujal wach i rukapeb'aal.</para>
  <para style="q">Aha' wilik i ruq'or inooj eloq wach.</para>
  <para style="q">Eh noq i ruq'or chi wilik i naa rub'anam i rub'an wo' hoq.</para>
  <para style="q">
    <verse number="20" style="v" />Re' hin xuq'or weh i Dios chi naa nukuxisam i tinamit Israel.</para>
  <para style="q">Eh re' hin ma' nee ta rub'an chi nee nujal wach i xuq'or weh.</para>
  <para style="q">
    <verse number="21" style="v" />Eh ma' xtaj i jot'ooj k'ahchi' keeb' i aj Israel</para>
  <para style="q">re' taqe i riih rumaam i Jacob.</para>
  <para style="q">Re' i kaJaaw ki Dios wilik kuuk' chi juneliik,</para>
  <para style="q">eh inkiloq'ej chi kireey.</para>
  <para style="q">
    <verse number="22" style="v" />Re' wo' hoq i ki Dios x-esanik cho keh pan tinamit Egipto.</para>
  <para style="q">Eh xuyeew kikowiil, je' kowiil imas wakax wilik pan raxchee'.</para>
  <para style="q">
    <verse number="23" style="v" />Eh ma' awach taj i ma' holohik ta nee nq'orik chikiij,</para>
  <para style="q">ma' jino'q i aj q'iij ma' holohik ta nee nq'orik chikiij i aj Israel.</para>
  <para style="q">Je' la' wili i ruk'ul chi neen q'orariik chikiij:</para>
  <para style="q">Chakoj taq rehtaal chi re' Dios ma' k'isiin ta xukuxisaj</para>
  <para style="q">i tinamit Israel, inko'q taqe.</para>
  <para style="q">
    <verse number="24" style="v" />Re' taqe i aj Israel yohb'aal wach i kijosq'iil,</para>
  <para style="q">eh ma' naa ta kihi'lik korehtaal inkisach wach i nixowanik kiwach.</para>
  <para style="q">Eh je' rukab' i rub'an i kaq b'ahlam</para>
  <para style="q">noq i ruchop i rutiib' korehtaal i rutz'ap wach,</para>
  <para style="q">eh i ruk'ej haa' i kik', inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" />Eh re' i reey Balac je' wili xuq'or reh i Balaam:</para>
  <para style="p">Ruum chi ma' xuyeew ta riib' chi xapahqaaj i ma' holohik taj chikinaah i aj Israel, maa pahqaaj wo' i holohik chikinaah, inki.</para>
  <para style="p">
    <verse number="26" style="v" />Re' Balaam je' wili ruchaq'weesjiik xub'an:</para>
  <para style="p">Re' hin nuq'orom aweh chi xa re' wo' naa nub'anam i naa ruq'orom weh i QaJaaw Dios, inki.</para>
  <para style="p">
    <verse number="27" style="v" />Eh re' reey Balac je' wili ruchaq'weesjiik xub'an:</para>
  <para style="p">Re' hin i nuq'or aweh chi nee tiooj chi wiij pan jino'q chik ye'aab', ma' nee ta oon naq inchenyoj ruk'ux i Dios chi ar nee napahqaaj i ma' holohik taj chikinaah i aj Israel, inki.</para>
  <para style="p">
    <verse number="28" style="v" />Je' re' noq re' i Balac xuk'am reje i Balaam kochinaah i yuuq' Peor, re' ink'utinik cho wii' chu'nchel i chiq yuuq'. <verse number="29" style="v" />Eh ar re' i Balaam, je' wili i xuq'or reh i Balac:</para>
  <para style="p">Yu'naak i hat cha yejaa' weh ayu' wuquub'-oq i artaal, eh nee nak'am chaloq i wuquub' chi kok' imas wakax, eh wuquub' imas tentzun, inki.</para>
  <para style="p">
    <verse number="30" style="v" />Re' reey Balac xub'an wo' hoq i xq'orarik reh ruum i Balaam. Eh chinaah i ju'jun chi artaal xuk'at chi mayiij i ju'jun imas wakax, eh ju'jun imas tentzun.</para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Re' Balaam reht'al chi re' i QaJaaw Dios iraaj chi naa rukuxisam taqe i aj Israel, ma' xoj ta chik ruk'ul ruuk' i Dios chib'ih i naa ruq'orom, je' rukab' i xub'an pampeet, paruka'peech. Xusutej la' riib', xtz'ehtanik reje chupaam i ye'aab' chiq yuuq'. <verse number="2" style="v" />Eh xrilow reje wach i ki-itz'ihy naah paat i aj Israel, chi ch'uhqaal wilkeeb'. Re' i Ruxlab'al i Dios xchalik chinaah i Balaam. <verse number="3" style="v" />Je' re' noq xuq'or taqe q'orik wili parutz'uuy:</para>
  <para style="b" />
  <para style="q">Re' hin i Balaam, hin rak'uun i Beor,</para>
  <para style="q">je' naq tz'aplik i naq'nuwach, wilik i xk'uhtjik weh.</para>
  <para style="q">
    <verse number="4" style="v" />Eh xb'iraj i ruq'oral i Dios,</para>
  <para style="q">wilik wo' xuk'uhtaaj weh panusaq wiriik ruuk' i runimaal i rajaawriik.</para>
  <para style="q">Re' hin xnuloch' wiib' chuwach i QaJaaw,</para>
  <para style="q">eh xuk'uhtaaj weh i korik.</para>
  <para style="q">
    <verse number="5" style="v" />Yohb'aal wach holwochiil taq aapaat itz'ihy naah,</para>
  <para style="q">eh yohb'aal wach holwochiil i ye'aab' wilkaat taq wii' i hat taq aj Israel.</para>
  <para style="q">
    <verse number="6" style="v" />Eh xakilok'ik taq chik aapaat,</para>
  <para style="q">xa je' chik inloh k'ik reje xaq ipak'.</para>
  <para style="q">Eh xa je' chik inlohk'ik reje tik, chi chii' i rooq ha',</para>
  <para style="q">xa je' chik inlohk'ik reje ink'ohnik laj chee',</para>
  <para style="q">eh xa je' chik inlohk'ik reje chakaltee' chi chii' i ha'.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' taq i hat eliik taq naa ruwihiik ahaa',</para>
  <para style="q">eh ruuk' i re' naa taq akojom ruha'iil atik.</para>
  <para style="q">Re' taq aareey yohb'aal wach i rajaawriik,</para>
  <para style="q">naa ruq'atam wach i rajaawriik i reey Agag,</para>
  <para style="q">eh naa ruye'ariik runimaal wach i rajaawriik.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taq aaDios x-esanik chaaweh Egipto,</para>
  <para style="q">xuyeew taq aakowiil chi je' kowiil imas wakax wilik pan raxchee'.</para>
  <para style="q">Ruum aj re' naa taq asacham kiwach i nimaq tinamit ki-ixowanik taq awach,</para>
  <para style="q">naa taq atoqib'eem i kib'aqil.</para>
  <para style="q">Eh naa taq aakutib'eem ruuk' taq aaflecha.</para>
  <para style="q">
    <verse number="9" style="v" />Noq ti okik taq chi hi'lik i hat aj Israel,</para>
  <para style="q">je' rukab' noq inokik chi hi'lik i kaq b'ahlam ma' awach ta neenuksanik i koq reh.</para>
  <para style="q">Re' ta naq i holohik chinaah awach impahqanik i holohik taq cha naah,</para>
  <para style="q">eh re' ta naq i ma' holohik taj</para>
  <para style="q">i chinaah awach impahqanik</para>
  <para style="q">ma' holohik taj taq cha naah, inki, i Balaam.</para>
  <para style="s">Re' i Balaam xuq'or rib'iral chib'ih i naa ruk'ulariik</para>
  <para style="p">
    <verse number="10" style="v" />Eh re' i reey Balac xchalik ruk'aah chinaah i Balaam, xupoq'potej paam i q'ab' je' wili xuq'or reh:</para>
  <para style="p">Re' hin xnutaq'aaj ak'amariik reh chi naa apahqaam i ma' holohik ta chikinaah i ki-ixowanik nuwach. Eh re' hat, oxpech chik xapahqaaj i holohik chikinaah. <verse number="11" style="v" />Ruum aj re' i ruk'ul chi neetisutinik reje panapaat. Re' hin nuq'orom naq chi q'e' naa nuye'em runimaal awach, xa re' la' re' Dios ma' xuyeew ta q'ab' chi xak'ul i runimaal awach, inki.</para>
  <para style="p">
    <verse number="12" style="v" />Eh re' i Balaam je' wili i chaq'wik xub'an:</para>
  <para style="p">¿Mi ma' je' wili re' i xnuq'or keh i awaj taqareel xataq'aaj taqe chi nuk'amariik? <verse number="13" style="v" />Chi atoob' ta naq nee ruyeew weh chu'nchel i oro i plata wilik parupaat. Re' hin xama' naa ta wo' nuq'atam wach i nee ruq'or weh i QaJaaw, eh chi ma' jino'q i holohik, eh ma' jino'q i yiib' wach neenub'an xa chi wib'il wiib'. Eh xnuq'or chi aha' wilik i naa ruq'orom weh i QaJaaw xa re' wo' naa nuq'orom. <verse number="14" style="v" />Ma' xta reet, re' hin naa nusutiniik reje panutinamiit, xa re' kopeet naa nuq'orom chib'ih i naa rub'anam, na'chub'an i tinamit Israel ruuk' aatinamiit i hat.</para>
  <para style="p">
    <verse number="15" style="v" />Re' Balaam xuq'or taqe i q'orik wili parutz'uuy:</para>
  <para style="b" />
  <para style="q">Re' hin i Balaam hin rak'uun i Beor,</para>
  <para style="q">re' hin je' naq tz'aplik i naq'nuwach.</para>
  <para style="q">
    <verse number="16" style="v" />Eh xb'iraj i ruq'oral i Dios,</para>
  <para style="q">eh wilik xuk'uhtaaj weh panusaq wiriik</para>
  <para style="q">ruuk' i runimaal i rajaawriik.</para>
  <para style="q">Re' hin xnuloch' wiib' chuwach i QaJaaw, eh xuk'uhtaaj weh i korik.</para>
  <para style="q">
    <verse number="17" style="v" />Re' hin xwilow panusaq wiriik</para>
  <para style="q">chib'ih i naa rub'aan kuuk' i aj Israel,</para>
  <para style="q">taqe i riih rumaam i Jacob,</para>
  <para style="q">naa ruponiik i q'iij noq chi kixilak</para>
  <para style="q">naa reliik chaloq i jinaj i reey kow naa rutaaq'aniik,</para>
  <para style="q">je' rukab' i rusaqumaal i ch'umiil.</para>
  <para style="q">Eh re' reh naa rusacham wach i tinamit Moab,</para>
  <para style="q">eh je' wo' taqe i riih rumaam i Set.</para>
  <para style="q">
    <verse number="18" style="v" />Re' taqe i aj Israel naa kichopom naah i tinamit Edom,</para>
  <para style="q">eh je' wo' i tinamit Seir re' i nixowanik kiwach,</para>
  <para style="q">eh xti naa ruwihiik kajaawriik.</para>
  <para style="q">
    <verse number="19" style="v" />Jinaj i xti nim rajaawriik naa ruwihiik, re' ruuk' i riih rumaam i Jacob.</para>
  <para style="q">Re' re' i naa rusachwiik wach i tinamit</para>
  <para style="q">nik' nimaal i konaakikahniik chi k'achalkeeb', inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" />Eh chi riij i re' xrilow wach i tinamit Amalec, je' wili i xuq'or parutz'uuy:</para>
  <para style="b" />
  <para style="q">Re' Amalec xti xiik' wo' naq naah nimaal i rajaawriik chi kixilak i tinamit,</para>
  <para style="q">xa re' la' xanaa wo' rusahchiik wach chi jumpech, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" />Eh re' Balaam noq xrilow wach i tinamit i Ceneo je' wili i xuq'or parutz'uuy:</para>
  <para style="b" />
  <para style="q">Re' i aj Ceneo xti xiik' wo' naq naah kikowiil</para>
  <para style="q">xkiyejaa' wo' naq i kiye'aab' chupaam taqe i paat ab'aj.</para>
  <para style="q">
    <verse number="22" style="v" />Xa re' la' noq naa kichaliik i aj Asiria</para>
  <para style="q">naa ruq'atariik wach i kajaawriik naa kik'amariik</para>
  <para style="q">reje pan tokoom tinamit, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" />Eh je' wo' chik wili i xuq'or parutz'uuy i Balaam:</para>
  <para style="b" />
  <para style="q">Noq naa rub'anam i QaJaaw Dios taqe re' q'eq ti' i naakik'ulum,</para>
  <para style="q">ma' jino'q chik i naa kikahniik chi k'achalkeeb'.</para>
  <para style="q">
    <verse number="24" style="v" />Eh wilik i naa kichaliik pan barco chupaam i chiq yuuq' Quitim.</para>
  <para style="q">Naa kisacham wach i aj Asiria.</para>
  <para style="q">Eh naa rusachariik kiwach i aj Heber.</para>
  <para style="q">Eh re' taqe i aj Quitim naa wo' rusachariik kiwach noq naa rojiik kuxoq, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" />Eh chi riij taqe re', re' Balaam xichop reje i rub'eeh xsutinik wo' chik reje parutinamiit. Eh re' reey Balac xooj wo' reje parupaat.</para>
  <chapter number="25" style="c" />
  <para style="s">Re' taqe i aj Israel xkiloq'ej i xatz'aqoj tiyoox</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe i aj Israel noq xi okik chi wihik ar Sitim re' taqe i winaq xkitoq'aa' k'oyomal kuuk' taqe ixoq aj Moab. <verse number="2" style="v" />Re' taqe ixoq re' re' inkiyuq'eej taqe aj Israel chuk'uxariik i mayiij inkiyeew chuwach i tiyoox Baal-peor. Eh inkixuk'aa' kiib' chuwach i tiyoox re' re'. <verse number="3" style="v" />Je' re' noq xkikanaa' kiib' chi xik'amarik reje chi looq'jiik i tiyoox Baal-peor. Ruum i re', re' QaJaaw ma' k'isiin ta xchalik rujosq'iil chikinaah i aj Israel. <verse number="4" style="v" />Eh re' i QaJaaw Dios, je' wili i xuq'or reh i Moisés:</para>
  <para style="p">Re' hat chamol kiwach chu'nchel i winaq k'amal kib'eeh i aj Israel, neenajihk'aaj chi kalaq parusaqumaal i q'iij chi nuwach reh chi neenik'ik i nujosq'iil chikinaah i aj Israel, inki.</para>
  <para style="p">
    <verse number="5" style="v" />Re' i Moisés xuq'or wo' keh i q'atal q'orik chikinaah i ju'jun ch'uq chi aj Israel chi naa kikansam taqe awach i xi k'amarik reje chi looq'jiik i tiyoox Baal-peor.</para>
  <para style="p">
    <verse number="6" style="v" />Eh jinaj i winaq aj Israel xuk'am reje chi riij parupaat jinaj ixoq aj Madián. Chuwach i Moisés, eh chikiwach wo' chu'nchel i aj Israel kimolom kiib' noq oq'ik inki a'n panookb'al reh i santo laj itz'ihy naah paat molb'al iib'. <verse number="7" style="v" />Eh re' Finees i rak'uun i Eleazar, eh riih i Aarón kajaaw i aj tiij noq xrilow chib'ih i xub'an i winaq xelik reje chi kixilak i aj Israel kimolom kiib' ar xooj ruchop i ruq'as laj ch'ihch'. <verse number="8" style="v" />Eh xutahqeej reje i winaq aj Israel aha' wilik i ru-itz'ihy naah paat. Eh ar xusach wach i winaq xrik'saj i ruq'aslaj ch'ihch' chupaam, eh je' wo' re' i xub'an reh ixoq. Ruuk' i re' xhi'lik wach i kaq yab'ilaal k'achi' rukansanik keh i aj Israel. <verse number="9" style="v" />Xa re' la' kamnaq wo' chik taqe i kijib' ru ka'winaq miil chi aj Israel ruum i kaq yab'ilaal.</para>
  <para style="p">
    <verse number="10" style="v" />Re' i QaJaaw Dios je' wili xuq'or reh: i Moisés.</para>
  <para style="p">
    <verse number="11" style="v" />Ruuk' i xub'an i Finees rak'uun i Eleazar re' i rak'uun i Aarón xujot'isaj wach i nujosq'iil chikinaah i aj Israel, ruum re' reh raaj chi xa re' hin nee kinaloq'ej, je' rukab' i nukapaaj i hin ruum aj re' majaa' i nusach kiwach chu'nchel i aj Israel. <verse number="12" style="v" />Je' re' noq cha q'or reh i Finees chi re' hin kinq'orik chi neerub'an chi nee ruk'am riib' panotob'il wuuk'. <verse number="13" style="v" />Re' hin naa nuye'em q'ab' reh chi naa rukahniik chi k'amal kib'eeh aj tiij. Eh naa kikahniik chi k'amal kib'eeh aj tiij taqe i riih rumaam, ruum re' reh iraaj chi xa re' hin naa nulooq'jiik. Ruum chi xuyeew i k'atoj mayiij chikiij i aj Israel, inki.</para>
  <para style="p">
    <verse number="14" style="v" />Eh re' i aj Israel xkanteesjik ruch'ihil ixoq aj Madián, Zimri i rub'ihnaal, rak'uun Salu re' i k'amal kib'eeh taqe i riih rumaam i Simeón. <verse number="15" style="v" />Eh re' ixoq aj Madián xkanteesjik Cozbi rub'ihnaal, rixq'uun i Zur k'amal kib'eeh i junch'uq chi aj Madián.</para>
  <para style="p">
    <verse number="16" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh Moisés:</para>
  <para style="p">
    <verse number="17" style="v" />Re' taq i hat aj Israel, hiy taq chi q'aq'inik kuuk' i aj Madián korehtaal taq i na a'n keh. <verse number="18" style="v" />Ruum re' keh xkian taq aweh, ruuk' jot'ooj taq xat kimin chi rulooq'jiik i kitiyoox Baal-peor rub'ihnaal. Re' wo' keh kik'amwik b'eeh ruuk' i ma' holohik taj xub'an ixoq Cozbi re' rixq'uun i k'amal kib'eeh i junch'uq chi aj Madián. Re' ixoq xkanteesjik ruuk' q'aslaj ch'ihch', noq xnutaq'aaj chaloq i runimaal yab'ilaal ruum xaloq'ej taq tiyoox re' re', inki.</para>
  <chapter number="26" style="c" />
  <para style="s">Re' kajaljiik ruka'peech i aj Israel</para>
  <para style="p">
    <verse number="1" style="v" />Noq kamnaq chik taqe i ruk'ihaal chi aj Israel ruum i runimaal yab'ilaal, re' QaJaaw Dios, je' wili i xuq'or reh i Moisés, i Eleazar rak'uun i Aarón kajaaw i k'amal kib'eeh aj tiij: <verse number="2" style="v" />Re' taq i hat naa taq awik'sam i tz'ihb' ajlaamb'al keh i aj Israel, pankipaat ruuk' i kituut kajaaw, re' taqe i manlik juninaq haab', je' wo' taqe ik'inaq juninaq haab', re' taqe i manlik nee kiooj panq'aq'inik, inki.</para>
  <para style="p">
    <verse number="3" style="v" />Eh re' i Moisés, i Eleazar re' i k'amal kib'eeh aj tiij xkiq'o'reej taqe i aj Israel wach k'ixkaab' Moab chi chii' i nim ha' Jordán chuwach reje i Jericó, je' wili i xuq'or: <verse number="4" style="v" />Re' taq i hat naa awajlaam taqe i winaq wilik keh i juninaq haab' je' wo' taqe ik'inaq juninaq haab', je' rukab' i xuq'or i Dios reh i Moisés, inki taqe.</para>
  <para style="p">Re' taqe i xi ajaljik re' taqe i xi ehteesjik cho Egipto.</para>
  <para style="p">
    <verse number="5" style="v" />Re' i Rubén i peet rak'uun i Israel re' taqe wili i junch'uq chi riih rumaam: Re' taqe riih rumaam Enoc, re' taqe i riih rumaam i Falú. <verse number="6" style="v" />Re' taqe riih rumaam i Hezrón, re' taqe i riih rumaam Carmi. <verse number="7" style="v" />Eh noq xik'ik i tz'ihb' chikinaah taqe i riih rumaam i Rubén xi ponik ka'winaq miil ruuk' ixib' miil ruuk' wuquub' siento ruuk' lajeeb' ru ka'winaq chi kiib'.</para>
  <para style="p">
    <verse number="8" style="v" />Eh re' i riih rumaam i Falú re' Eliab. <verse number="9" style="v" />Re' riih rumaam i Eliab re' Nemuel, re' Datán, eh re' i Abiram. Eh re' i Datán, re' i Abiram xitaqchi'inik keh i aj Israel noq xtohq'ik kiq'etwachem i Moisés, i Aarón. Re' i aj Israel re' re' xkian jinaj wach kik'ux ruuk' i Coré noq xtohq'ik kiwech'um riij chib'ih i rub'an i Dios. <verse number="10" style="v" />Eh re' ak'al xtar, eh xib'iq'arik qohoq kiib' chi winaq re' re', je' wo' hoq i Coré, je' wo' taqe xkian jinaj wach kik'ux kuuk'. Eh re' i xi k'atarik ruum i q'aaq' kiib' siento ruuk' lajeeb' roxk'ahl chi kiib', re' xk'ularik wili kojb'al kina'ojb'al i ruk'ihaal. <verse number="11" style="v" />Eh re' taqe i riih rumaam i Coré ma' xkuxik ta kikimiik.</para>
  <para style="p">
    <verse number="12" style="v" />Re' taqe junch'uq chi riih rumaam i Simeón re' taqe wili: Re' taqe i riih rumaam i Nemuel i riih rumaam Jemin, re' taqe riih rumaam i Jaquín. <verse number="13" style="v" />Re' taqe riih rumaam i Zera, re' taqe riih rumaam i Saúl. <verse number="14" style="v" />Eh noq xik'ik i tz'ihb' chikinaah i riih rumaam i Simeón xi ponik kiib' ru ka'winaq miil ruuk' kiib' siento.</para>
  <para style="p">
    <verse number="15" style="v" />Eh re' taqe junch'uq chi riih rumaam i Gad re' taqe wili: Re' taqe i riih rumaam Zefón, re' riih rumaam i Hagui, eh re' i riih rumaam i Suni. <verse number="16" style="v" />Re' taqe i riih rumaam i Ozni, eh re' taqe riih rumaam i Eri. <verse number="17" style="v" />Re' taqe i riih rumaam i Arod, re' taqe i riih rumaam i Areli. <verse number="18" style="v" />Eh noq xik'ik i tz'ihb' chikinaah i riih rumaam Gad xi ponik ka'winaq miil ruuk' hoob' siento chi kunchelaal.</para>
  <para style="p">
    <verse number="19" style="v" />Eh re' taqe i riih rumaam i Judá re' i Er, re' Onán xikimik chupaam i tinamit Canaán. <verse number="20" style="v" />Je' re' noq re' taqe i junch'uq chi riih rumaam i Judá re' taqe wili: Re' riih rumaam i Sela, re' i riih rumaam i Fares, re' riih rumaam i Zera. <verse number="21" style="v" />Eh re' taqe i riih rumaam i Fares, re' i riih rumaam i Hezrón, re' i riih rumaam i Hamul. <verse number="22" style="v" />Eh noq xik'ik i tz'ihb' chikinaah i junch'uq chi riih rumaam i Judá xi ponik waqlaj ru kajwinaq miil ruuk' hoob' siento.</para>
  <para style="p">
    <verse number="23" style="v" />Eh re' taqe i junch'uq chi riih rumaam i Isacar re' taqe wili: Re' riih rumaam i Tola, re' i riih rumaam Fúa. <verse number="24" style="v" />Eh re' riih rumaam i Jasub, re' riih rumaam Simrón. <verse number="25" style="v" />Eh noq xik'ik kajaljiik i riih rumaam i Isacar xi ponik kijib' ru kajwinaq miil ruuk' ixib' siento.</para>
  <para style="p">
    <verse number="26" style="v" />Re' taqe i junch'uq chi riih rumaam i Zabulón, re' taqe wili: Re' riih rumaam i Sered, re' i riih rumaam i Elón, eh re' riih rumaam i Jahleel. <verse number="27" style="v" />Eh noq xik'ik i kajaljiik i riih rumaam i Zabulón xi ponik oxk'ahl miil ruuk' hoob' siento.</para>
  <para style="p">
    <verse number="28" style="v" />Eh re' taqe i junch'uq chi riih rumaam i José re' i junch'uq chi tinamit Manasés, eh re' junch'uq chi tinamit Efraim. <verse number="29" style="v" />Re' junch'uq chi riih rumaam i Manasés re' taqe wili: Re' taqe i riih rumaam i Maquir, re' taqe i riih rumaam Galaad. <verse number="30" style="v" />Re' i junch'uq chi riih rumaam i Galaad re' taqe i wili: Re' taqe i riih rumaam i Jezer, re' taqe i riih rumaam i Helec. <verse number="31" style="v" />Eh re' taqe i riih rumaam i Asriel, re' taqe i riih rumaam i Siquem. <verse number="32" style="v" />Eh re' taqe i riih rumaam i Semida, re' taqe i riih rumaam i Hefer. <verse number="33" style="v" />Eh re' i Zelofehad i rak'uun i Hefer ma' xwihik ta rak'uun xarixq'uun taqe i xwihik, je' wili i kib'ihnaal: Re' Maala, re' Noa, re' Hogla, re' Milcá, re' i Tirsa. <verse number="34" style="v" />Eh noq xik'ik i tz'ihb' chikinaah junch'uq chi riih rumaam i Manasés xi ponik kab'laj roxk'ahl miil ruuk' wuquub' Siento.</para>
  <para style="p">
    <verse number="35" style="v" />Re' junch'uq chi riih rumaam i Efraín, re' taqe wili: Re' taqe i riih rumaam i Sutela, re' taqe i riih rumaam i Bequer, re' taqe i riih rumaam i Tahán. <verse number="36" style="v" />Re' taqe junch'uq chi riih rumaam i Sutela, re' taqe i wili: Re' taqe riih rumaam i Erán. <verse number="37" style="v" />Eh noq xik'ik i tz'ihb' chikinaah taqe i riih rumaam i Efraín xi ponik kab'laj ru ka'winaq miil ruuk' hoob' siento. Re' taqe i riih rumaam i José wilkeeb' pankipaat.</para>
  <para style="p">
    <verse number="38" style="v" />Eh re' i junch'uq chi riih rumaam i Benjamín re' taqe wili: Re' taqe i riih rumaam i Bela, re' taqe i riih rumaam i Asbel, re' taqe i riih rumaam i Ahiram. <verse number="39" style="v" />Re' taqe i riih rumaam i Sufam, re' taqe i riih rumaam i Hufam. <verse number="40" style="v" />Re' taqe i riih rumaam i Bela, re' Ard, re' Naamán, re' taqe i kiih kimaam taqe re'. <verse number="41" style="v" />Eh noq xik'ik i tz'ihb' chikinaah taqe i riih rumaam i Benjamín xi ponik hoob' roxk'ahl miil ruuk' waq'iib' siento.</para>
  <para style="p">
    <verse number="42" style="v" />Re' i junch'uq chi riih rumaam i Dan, re' taqe wili: Re' taqe i riih rumaam i Suham, re' taqe re' i riih rumaam i Dan. <verse number="43" style="v" />Eh noq xik'ik i tz'ihb' chikinaah taqe i riih rumaam i Dan xi ponik kijib' ru kajwinaq miil ruuk' kijib' siento.</para>
  <para style="p">
    <verse number="44" style="v" />Eh re' junch'uq chi riih rumaam i Aser re' taqe wili: Re' taqe i riih rumaam i Imna, re' taqe i riih rumaam Isúi, re' taqe i riih rumaam i Bería. <verse number="45" style="v" />Re' taqe i riih rumaam i Bería re' taqe i wili: re' taqe i riih rumaam i Heber, re' taqe i riih rumaam i Malquiel. <verse number="46" style="v" />Eh re' Aser xwihik jinaj rixq'uun Sera i rub'ihnaal. <verse number="47" style="v" />Eh noq xik'ik i tz'ihb' chikinaah taqe i riih rumaam i Aser xi ponik oxlaj roxk'ahl miil ruuk' kijib' siento.</para>
  <para style="p">
    <verse number="48" style="v" />Re' i junch'uq chi riih rumaam i Neftalí, re' taqe wili: Re' taqe i riih rumaam i Jahzeel, re' taqe i riih rumaam Guni. <verse number="49" style="v" />Eh re' taqe i riih rumaam i Jezer, re' taqe i riih rumaam i Silem. <verse number="50" style="v" />Eh noq xik'ik i tz'ihb' chikinaah taqe i riih rumaam i Neftalí xi ponik hoob' roxk'ahl miil ruuk' kijib' siento.</para>
  <para style="p">
    <verse number="51" style="v" />Eh noq xik'ik i tz'ihb' chikinaah chu'nchel i winaq aj Israel wilik keh juninaq haab', eh ik'inaq juninaq haab', xi ponik waqiib' siento miil ruuk' jinaj miil, ruuk' wuquub' siento ruuk' lajeeb' ru ka'winaq.</para>
  <para style="s">Re' ruq'orariik nik' wach ruch'aqariik ak'al xkian</para>
  <para style="p">
    <verse number="52" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="53" style="v" />Keh taqe i tinamit wili naa ruch'aqiik ak'al re' q'oreel jarub' i xtz'ihb'jik kib'ihnaal. <verse number="54" style="v" />Wila' k'ih chi kiib', chi kich'uhqaal, nim i kiye'aab' naa ruye'ariik. Eh wila' ma' k'ih chi kiib' chi kich'uhqaal, ma' q'e' ta wo' nim i kiye'aab' naa ruye'ariik. Je' re' noq chi kich'uhqaal naa ruch'aqariik kiye'aab' re' q'oreel nik' wach i kajaljiik xb'aan. <verse number="55" style="v" />Eh re' ye'aab' konaa rusik'ariik chi riij noq naa ruchaqariik, eh aha' wilik i naa rukahniik reh i ju'jun ch'uq, re' wo' re' naa ruk'ulum. Re' q'oreel awach chaloq i kimaam kati't. <verse number="56" style="v" />Aha' pa' wilik i neenkahnik keh noq neensik'arik chi riij re' q'oreel mi k'ih chi kiib' nim neenye'arik keh, eh wila' ma' k'ih chi kiib' ma' nim taj i neenye'arik keh.</para>
  <para style="s">Re' tz'ihb' xb'aan i ajlaamb'al keh taqe i riih rumaam i Leví</para>
  <para style="p">
    <verse number="57" style="v" />Eh re' taqe i junch'uq chi aj Levíta xi tz'ihb'jik re' taqe wili: Re' taqe i riih rumaam i Gersón, re' taqe i riih rumaam i Coat, eh re' taqe i riih rumaam i Merari. <verse number="58" style="v" />Re' taqe riih rumaam i Libni, re' taqe i riih rumaam i Hebrón, re' riih rumaam i Mahli, re' taqe i riih rumaam i Musi, re' taqe riih rumaam i Coré, chu'nchel i re' riih rumaam Leví.</para>
  <para style="p">Re' i Coat rajaaw i Amram. <verse number="59" style="v" />Eh re' Amram xub'an kaxáro ruuk' i Jocabed, re' i rixq'uun i Leví x-aasjik noq ko wilik cho Egipto. Eh re' Amram xwihik rak'uun rixq'uun ruuk' i Jocabed je' wili kib'ihnaal: Aarón, Moisés, eh María. <verse number="60" style="v" />Eh re' taqe i rak'uun xwihik i Aarón je' wili i kib'ihnaal: Nadad, Abiú, Eleazar, Itamar. <verse number="61" style="v" />Re' Nadad, ruch'ihil Abiú xikimik ruum noq tokoom inaq'wach q'aaq' xkik'at wii' i mayiij chuwach i QaJaaw Dios. <verse number="62" style="v" />Eh noq xik'ik i tz'ihb' chikinaah chu'nchel i riih rumaam i Leví xkitoq'aa' johtoq i ajlanik ruuk' i ju'jun poh i wilik keh, xkikoj haa' i nimaq winaq, xi ponik ixib' ru ka'winaq miil. Re' taqe re' ma' xajaljik ta haa' chi kixilak i kuch aj Israel, ruum ma' xye'arik ta kiye'aab'.</para>
  <para style="p">
    <verse number="63" style="v" />Re' taqe i xrajlaaj i Moisés, ruch'ihil i Eleazar k'amal kib'eeh aj tiij noq xkajlaaj chu'nchel i aj Israel wach k'ixkaab' Moab re' i wilik chi chii' i nim ha' Jordán. Re' ye'aab' re' re' ar wilik chi k'ulwaach i tinamit Jericó. <verse number="64" style="v" />Eh re' taqe i re' ma' jino'q keh i xi ajaljik ruum i Moisés ruum i Aarón chupaam i ye'aab' chiq yuuq' ar Sinaí noq xkian i tz'ihb' ar. <verse number="65" style="v" />Ruum i re', re' i QaJaaw Dios ruq'orom chik keh chi naa rukuxiik kikimiik chupaam i ye'aab' chiq yuuq'. Eh xuq'or chi ach wo' re' Caleb, rak'uun i Jefone ruch'ihil i Josué rak'uun i Nun naa kikahniik chi k'achalkeeb'.</para>
  <chapter number="27" style="c" />
  <para style="s">Re' kikooch xkipahqaaj i rixq'uun i Zelofehad</para>
  <para style="p">
    <verse number="1" style="v" />Chi kixilak junch'uq chi riih rumaam i Manasés ho'oob' ixoq xi wihik rixq'uun taqe i Zelofehad je' wili i kib'ihnaal: Maala, Noa, Hogla, Milcá, Tirsa. Re' i Zelofehad rak'uun i Hefer, re' Hofer rak'uun i Galaad, re' Galaad rak'uun i Maquir, re' i Maquir rak'uun i Manasés, re' i Manasés rak'uun i José. <verse number="2" style="v" />Re' taqe i ho'oob' chi ixoq re' re' xiooj panookb'al reh i santo laj itz'ihy naah paat molb'al iib'. Ar xooj kiq'oreej i Moisés ruch'ihil i Eleazar k'amal kib'eeh aj tiij chikiwach i k'amal b'eeh, eh chikiwach i kimolom kiib' ar, je' wili xkiq'or: <verse number="3" style="v" />Re' i qajaaw i hoj xkimik chupaam i ye'aab' chiq yuuq', xa re' la' ma' re' ta naq haa' ruuk' i junch'uq i wilkeeb' chi riij i Coré i xkiwech'uj riij i xub'an i Dios. Re' reh ruum i ru mahk xkimik, eh ma' jino'q i rak'uun xwihik. <verse number="4" style="v" />Ma' ruk'ul taj chi neensahchik wach i rub'ihnaal i qajaaw chi xilak i rutinamiit xa ruum chi ma' xwihik ta jino'q rak'uun. Re' hoj, hoj rixq'uun i ruk'ul chi nee taq i nayeew k'isinoq qeh ak'al re' ruuk' kak'aal taqe i ruchaaq' i qajaaw, inki taqe.</para>
  <para style="p">
    <verse number="5" style="v" />Eh re' i Moisés xuq'or reh i QaJaaw Dios i xkipahqaaj i ho'oob' chi ixoq re' re'. <verse number="6" style="v" />Re' i QaJaaw Dios je' wili chaq'wik xub'an: <verse number="7" style="v" />Re' taqe i ho'oob' chi rixq'uun i Zelofehad rub'ehel chi keh inkiq'or. Re' hat i ruk'ul chi naa aye'em k'isinoq keh re' ruuk' i kak'aal taqe ruchaaq' i kajaaw, aha' naq wilik ak'al naa ruye'ariik reh i kajaaw kekeh nee nayeew. <verse number="8" style="v" />Eh cha q'or keh chu'nchel i aj Israel chi awach i winaq xkimik reje chi ma' xwihik ta jino'q rak'uun xarixq'uun i xwihik re' i rak'aal naq i reh i ruk'ul chi keh i rixq'uun naa ruye'ariik. <verse number="9" style="v" />Eh wila' ma' xwihik jino'q rixq'uun i ruk'ul chi reh i ras oon ruchaaq' naa ruye'ariik i rak'aal naq i reh. <verse number="10" style="v" />Eh wila' ma' chih i ras, oon ruchaaq' re' i rak'aal naq i reh i ruk'ul chi reh i ras, oon ruchaaq' i rajaaw naa rukahniik. <verse number="11" style="v" />Eh wila' ma' chih ras, oon ruchaaq' i rajaaw i ruk'ul chi reh jino'q i ma' tokoom ta ruuk'naa ruye'em i rak'aal naq i reh. Re' k'uhb'aal wili i ruk'ul chi naa kianam chi juneliik i aj Israel je' rukab' i xnuq'or reh i Moisés i hin, inki.</para>
  <para style="s">Re' Josué xpa'ab'jik chi k'amal b'eeh chi jilow i Moisés</para>
  <para style="p">
    <verse number="12" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés:</para>
  <para style="p">Re' hat johteen johtoq chinaah i yuuq' Abarim nee nawil reje i ye'aab' xnuyeew keh i aj Israel. <verse number="13" style="v" />Eh noq akohlaam chik rilariik chu'nchel neetikimik neenooj areq taqe aamaam awati't, je' rukab' noq xkimik i Aarón aawas, <verse number="14" style="v" />ruum akab'cheel taq ma' xanimaj ta taq i nuq'oral chupaam i ye'aab' chiq yuuq' Zin. Noq re' i tinamit xintohq'ik kiwech'um, re' taq i hat ma' xayeew ta taq nuloq'il chikiwach, noq xkipahqaaj kihaa' weh, inki. Re' xuq'or wili re' xk'ularik noq xelik i ha' chupaam i saq rep ab'aj, wilik chupaam i ye'aab' Cades wilik chupaam i ye'aab' chiq yuuq' Zin.</para>
  <para style="p">
    <verse number="15" style="v" />Re' i Moisés je' wili i xuq'or reh i QaJaaw Dios:</para>
  <para style="p">
    <verse number="16" style="v" />QaJaaw Dios re' hat ti ye'wik i k'acharik i ruk'ul chi nee nakoj jino'q i winaq chi nujilow reh chi neenkahnik chi k'amal kib'eeh i tinamit wili. <verse number="17" style="v" />Reh chi re' winaq re' re' neenk'amwik kib'eeh xa aha' pa' nee kiooj i k'oq, chi je' re' ma' nee ta kikahnik aatinamiit chi je' kikab' i tentzun ma' xta cha'jen keh, inki.</para>
  <para style="p">
    <verse number="18" style="v" />Eh re' i QaJaaw Dios je' wili i chaq'weesjik i Moisés xub'an:</para>
  <para style="p">Re' Josué i rak'uun i Nun wilik ruuk' i Wuxlab'al chapab'aa' chayeew aq'ab' chinaah. <verse number="19" style="v" />Chi riij i re' nee nak'am reje chuwach i Eleazar k'amal kib'eeh aj tiij, neenapab'aa' chuwach, je' wo' chikiwach i chu'nchel i tinamit Israel. Eh re' hat nee nayeew i kamanik chinaah. <verse number="20" style="v" />Nee nayeew reh awajaawriik i hat reh chi chu'nchel i aj Israel neenkinimaj taqe i nee ruq'or. <verse number="21" style="v" />Eh re' Josué naa rojiik pa'lojoq chuwach Eleazar k'amal kib'eeh aj tiij. Eh re' Eleazar nee rukoj i reh i chi' ruk'ux Urim rub'ihnaal noq neerupahqaaj weh chib'ih i naa rub'anam. Eh re' chik i Josué naa ruq'oriik keh i aj Israel chu'nchel i naa kianam, inki.</para>
  <para style="p">
    <verse number="22" style="v" />Eh re' i Moisés xub'an wo' hoq i xq'orarik reh ruum i QaJaaw Dios, xuk'am wo' reje i Josué chuwach i Eleazar k'amal kib'eeh aj tiij, je' wo' chikiwach chu'nchel i aj Israel. <verse number="23" style="v" />Eh xuyeew wo' q'ab' wach naah i Josué xupab'aa' chi k'amal b'eeh je' wo' rukab' i xq'orarik reh ruum i QaJaaw Dios.</para>
  <chapter number="28" style="c" />
  <para style="s">Re' i kimayiij xkiyeew rajlaal q'iij</para>
  <para style="r">(<ref loc="EXO 29:38-46">Ex 29.38-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="2" style="v" />Re' hat cha q'or keh i aj Israel chi juneliik neen kiyeew paruq'ijil i kik'atoj mayiij, je' wo' hoq chi kimayiij i kaxlanwi'k. Re' taqe ink'ohnik laj mayiij re' re' imponik chi nuwach i hin.</para>
  <para style="p">
    <verse number="3" style="v" />Eh je' wili i neenaq'or keh: Re' taqe wili i k'atoj mayiij naa aq'asam taq reh i QaJaaw Dios chi juneliik, rajlaal q'iij taq naa aq'asam kiib' chi imas tentzun ju'jun haab' i wilik keh, eh manlik wach i kiti'jolal. <verse number="4" style="v" />Jinaj keh imas tentzun naa taq aq'asam wahq'eq, eh jinaj i naa taq aq'asam xq'eq. <verse number="5" style="v" />Eh naa taq aq'asam chi mayiij ruch'ihil i tentzun ik'inaq waxiqiib' libra chi holohik laj arina xilakimaj ruuk' i jinaj nimlaj lemeta chi aseite oliva. <verse number="6" style="v" />Eh re' wo' hoq i mayiij wili ink'atarik chi juneliik chinaah i yuuq' Sinaí. Re' i q'e' ink'ohnik laj mayiij q'e' imponik chuwach i QaJaaw Dios. <verse number="7" style="v" />Eh chi ruk'u'liil i ju'jun chi k'atoj tentzun naa wo' taq aq'asam chi amayiij jinaj nimlaj lemeta chi riis uuva. Re' riis i uuva re' re' naa ruchihkjiik chupaam i santo laj ye'aab' ye'b'al ruloq'il i QaJaaw. <verse number="8" style="v" />Eh re' tentzun naa taq aq'asam chi mayiij xq'eq naa taq aq'asam chiruk'uliil i holohik laj arina ruch'ihil i riis uuva je' wo' k'ihaal i naa taq aq'asam chi ruk'u'liil ak'atoj mayiij naa taq aq'asam wahq'eq. Re' taqe i mayiij re' re' q'e' ink'ohnik imponik chuwach i Dios, tiko'q keh inki.</para>
  <para style="s">Re' mayiij xkiyeew chupaam i hi'limb'al q'iij</para>
  <para style="p">
    <verse number="9" style="v" />Eh re' i mayiij taq naa aq'asam chupaam taqe i hi'limb'al q'iij kiib' chi imas tentzun aj ju'jun haab' manlik wach i kiti'jolal. Eh naa taq aq'asam i k'isiin ma' b'elejeeb' libra chi holohik laj arina xilakimaj ruuk' aseite, eh riis uuva. <verse number="10" style="v" />Re' taqe i k'atoj mayiij wili naa taq aq'asam chupaam taqe i hi'limb'al q'iij naa wo' aq'asam taq chi ruk'u'liil i holohik arina, eh riis uuva naa taq aq'asam rajlaal i q'iij.</para>
  <para style="p">
    <verse number="11" style="v" />Eh pank'amb'al rub'eeh i ju'jun chi poh kiib' i kok' imas wakax taq naa aq'asam chi k'atoj mayiij chuwach i QaJaaw Dios. Jinaj imas tentzun, eh wuquub' i tentzun ju'jun haab' i wilik keh, eh manlik wach i kiti'jolal. <verse number="12" style="v" />Eh re' ju'jun chi imas wakax naa taq aye'em chi ruk'u'liil i waqiib' libra chi holohik arina xilakimaj ruuk' aseite. Eh re' ju'jun chi imas tentzun, naa taq aq'asam chi ruk'u'liil kijib' libra chi arina, xilakimaj ruuk' aseite. <verse number="13" style="v" />Eh re' i ju'jun chi kok' imas tentzun naa taq aq'asam chi ruk'u'liil i ki'ib' libra chi holohik laj arina, xilakimaj ruuk' aseite. Re' taqe i k'atoj mayiij wili q'e' k'ohnik imponik chuwach i QaJaaw Dios ye'b'al ruloq'il. <verse number="14" style="v" />Re' i ju'jun chi imas wakax ruk'u'liil ka'kab' nimaq lemeta chi riis uuva. Eh re' ju'jun chi imas tentzun ruk'u'liil i wilik rukab' nimaq lemeta chi riis uuva. Eh re' ju'jun chi tentzun ruk'uliil i jinaj nimlaj lemeta chi riis uuva. Re' taqe i wili i k'atoj mayiij naa taq aq'asam i ju'jun chi poh reh i haab'. <verse number="15" style="v" />Eh chi riij taqe i k'atoj mayiij taq naa aq'asam rajlaal i q'iij ruch'ihil i riis uuva, ko jinaj taq chik imas kaprax naa taq aq'asam chuwach i QaJaaw Dios pahqb'al kuyb'al taq amahk.</para>
  <para style="s">Re' kimayiij inkiq'asaj i aj Israel chupaam i runinq'ijiik i elik chaloq Egipto</para>
  <para style="r">(<ref loc="LEV 23:1-44">Lev 23.1-44</ref>)</para>
  <para style="p">
    <verse number="16" style="v" />Chupaam i kajlaj rub'eeh i peet poh reh i haab' naa taq aninq'ijeem aweliik chaloq Egipto ye'b'al ruloq'il i QaJaaw Dios. <verse number="17" style="v" />Eh chupaam i ho'lajuuj rub'eeh i poh re' re' naa taq a'nam i nim wach ninq'iij. Eh wuquub' q'iij taq naa ak'uxum i kaxlanwi'k ma' kojooj ta ch'amb'esb'al reh. <verse number="18" style="v" />Eh chupaam i peet q'iij naa taq a'nam jinaj i santo laj moloj iib'. Eh ma' jino'q taq aweh i naa rukamaniik. <verse number="19" style="v" />Eh kiib' i kok' imas wakax jinaj imas tentzun, wuquub' tentzun ju'jun haab' i wilik keh, manlik wach kiti'jolal naa taq aq'asam chi k'atoj mayiij chi nuwach i hin. <verse number="20" style="v" />Eh naa wo' taq aq'asam chi amayiij i holohik laj arina xilakimaj ruuk' aseite. Ik'inaq oxlaj libra chi ruk'u'liil i ju'jun chi kok' imas wakax. Eh k'isiin ma' b'elejeeb' libra arina taq i naa aq'asam chi ruk'u'liil imas tentzun. <verse number="21" style="v" />Eh re' i ju'jun chi tentzun naa wo' taq aq'asam chi ruk'u'liil ik'inaq kijib' libra chi holohik laj arina xilakimaj ruuk' aseite. <verse number="22" style="v" />Eh koruman wo' hoq chi naa taq aq'asam chi amayiij i jinaj i kaprax k'amb'al taq awiib' panotob'il wuuk' i hin. <verse number="23" style="v" />Re' taqe i mayiij wili naa taq aq'asam noq aq'asam taq chik i k'atoj mayiij pantaq wahq'eq re' inq'ahtesjik chi juneliik. <verse number="24" style="v" />Re' taqe i k'atoj mayiij re' re' wuquub' q'iij taq naa aq'asam noq k'ahchi' i ninq'iij. Re' taqe i k'atoj mayiij wili naa taq aq'asam chi ye'b'al nuloq'il ink'ohnik laj mayiij q'e' imponik chi nuwach i hin. Eh naa wo' taq aq'asam i k'atoj mayiij rajlaal i q'iij, je' wo' hoq i riis uuva. <verse number="25" style="v" />Eh paruwuuq q'iij reh i ninq'iij naa wo' taq a'nam i santo laj moloj iib' ye'b'al nuloq'il i hin, eh ma' jino'q taq aweh i naa rukamaniik.</para>
  <para style="p">
    <verse number="26" style="v" />Eh noq naa taq aninq'ijeem i peet wach taq atik amu'uun, noq naa taq aq'asam chi amayiij chi nuwach i hin, naa taq a'nam i santo laj moloj iib' ye'b'al nuloq'il. Eh chupaam i q'iij re' re' ma' jino'q taq aweh i naa rukamaniik. <verse number="27" style="v" />Eh naa taq aq'asam chi nk'ohnik amayiij chi nuwach i hin i kiib' chi kok' imas wakax, eh jinaj imas tentzun, eh wuquub' chi tentzun, ju'jun haab' i wilik keh. <verse number="28" style="v" />Eh chi ruk'u'liil i ju'jun chi imas wakax naa taq aq'asam ik'inaq oxlaj libra chi holohik laj arina xilakimaj ruuk' aseite. Eh chi ruk'u'liil imas tentzun naa taq aq'asam i k'isiin ma' b'elejeeb' libra chi arina, xilakimaj ruuk' aseite. <verse number="29" style="v" />Eh chi ruk'u'liil i ju'jun chi imas tentzun naa taq aq'asam ik'inaq kijib' libra chi arina xilakimaj ruuk' aseite. <verse number="30" style="v" />Eh koruman wo' hoq chi naa taq aq'asam chi ak'atoj mayiij jinaj i kaprax pahqb'al taq kuyb'al amahk. <verse number="31" style="v" />Re' k'atoj mayiij wili noq naa taq aq'asam naa wo' taq aq'asam chi ruk'u'liil i arina ruch'ihil i riis uuva. Eh naa wo' taq aq'asam i k'atoj mayiij rajlaal q'iij. Eh re' taqe i chikop naa aq'asam manlik wach i kiti'jolal.</para>
  <chapter number="29" style="c" />
  <para style="s">Re' runinq'ijiik i ruhuupjiik paam i tuun</para>
  <para style="p">
    <verse number="1" style="v" />Re' taq i hat chupaam i k'amb'al rub'eeh i ruwuuq poh naa taq a'nam i santo laj moloj iib', ma' jino'q taq aweh i naa rukamaniik. Eh naa taq aq'orom rib'iral i q'iij re' re' ruuk' i ruhuupjiik paam i tuun. <verse number="2" style="v" />Re' ink'ohnik laj k'atoj mayiij taq naa aq'asam, re' imponik chi nuwach i hin, jinaj i k'isa imas wakax, jinaj imas tentzun. Eh wuquub' i tentzun ju'jun haab' i wilik keh, manlik wach i kiti'jolal. <verse number="3" style="v" />Re' i k'isa imas wakax i naa taq aq'asam chi ruk'u'liil ik'inaq oxlaj libra chi holohik laj arina xilakimaj ruuk' aseite. Eh re' imas tentzun naa taq aq'asam chi ruk'u'liil i k'isiin ma' b'elejeeb' libra chi arina xilakimaj ruuk' aseite. <verse number="4" style="v" />Eh re' ju'jun chi kok' imas tentzun naa taq aq'asam chi ruk'u'liil ik'inaq kijib' libra chi holohik laj arina xilakimaj ruuk' aseite. <verse number="5" style="v" />Eh koruman wo' hoq chi naa taq aq'asam chi k'atoj mayiij jinaj kaprax pahqb'al kuyb'al taq amahk. <verse number="6" style="v" />Eh noq aq'asam taq chik ak'atoj mayiij naa taq aye'em rajlaal poh, je' wo' hoq i amayiij naa taq aye'em rajlaal q'iij ruch'ihil taq i wach atik ruch'ihil i riis uuva, je' rukab' i xnuq'or i hin. Re' taqe ink'ohnik laj mayiij wili q'e' imponik chi nuwach i hin.</para>
  <para style="p">
    <verse number="7" style="v" />Eh chupaam i lajeeb' i rub'eeh ruwuuq poh naa taq a'nam i santo laj moloj iib' ye'b'al nuloq'il i hin. Eh chupaam q'iij re' re' naa taq a'nam i tiij chi ma' a'nam ta taq awa', eh ma' jino'q taq aweh i naa rukamaniik. <verse number="8" style="v" />Re' taqe i chikop naa taq aq'asam chi nk'ohnik laj k'atoj mayiij chi nuwach, re' taqe wili: Jinaj i k'isa imas wakax, jinaj imas tentzun eh wuquub' tentzun ju'jun haab' i wilik keh, manlik wach i kiti'jolal. <verse number="9" style="v" />Eh naa wo' taq aq'asam chi amayiij i ik'inaq oxlaj libra chi holohik laj arina xilakimaj ruuk' aseite Chi k'u'liil imas wakax. Eh chi k'u'liil imas tentzun naa taq aq'asam i k'isiin ma' b'elejeeb' libra chi arina. <verse number="10" style="v" />Eh chi ruk'u'liil i ju'jun chi tentzun naa taq aq'asam ik'inaq kijib' libra chi arina xilakimaj ruuk' aseite. <verse number="11" style="v" />Eh naa taq aq'asam chi k'atoj mayiij jinaj imas kaprax chi tojb'al riij taq amahk. Eh naa wo' taq aq'asam i mayiij pahqb'al kuyb'al taq amahk. Eh naa wo' aq'asam taq i k'atoj mayiij rajlaal i q'iij ruch'ihil arina, ruch'ihil i riis uuva.</para>
  <para style="p">
    <verse number="12" style="v" />Eh chupaam i ho'lajuuj rub'eeh i ruwuuq poh naa taq a'nam i santo laj moloj iib'. Chupaam i q'iij re' re' ma' jino'q taq aweh i naa rukamaniik, wuquub' q'iij taq naa a'nam i ninq'iij ye'b'al nuloq'il i hin, hin Dios. <verse number="13" style="v" />Pampeet q'iij naa taq aq'asam chi nk'ohnik laj k'atoj mayiij chi nuwach i oxlaj chi kok' imas wakax. Eh kiib' imas tentzun, eh kajlaj i tentzun ju'jun haab' i wilik keh manlik wach i kiti'jolal. <verse number="14" style="v" />Eh naa taq aq'asam chi ruk'u'liil i ju'jun chi imas wakax, waqiib' libra chi holohik laj arina xilakimaj ruuk' aseite. Eh chi ruk'u'liil i ju'jun chi imas tentzun naa taq aq'asam i kijib' libra chi arina xilakimaj ruuk' aseite. <verse number="15" style="v" />Eh chi ruk'u'liil i ju'jun chi kok' tentzun naa taq aq'asam kiib' libra chi holohik laj arina xilakimaj ruuk' aseite. <verse number="16" style="v" />Koruman wo' hoq chi naa taq aye'em chi amayiij i kaprax chi pahqb'al kuyb'al taq amahk noq aye'em taq chik eqal eqal ak'atoj mayiij ruch'ihil i holohik arina ruch'ihil i riis uuva.</para>
  <para style="p">
    <verse number="17" style="v" />Eh parukab' q'iij naa taq aq'asam chi ak'atoj mayiij i kab'laj chi kok' imas wakax, eh kiib' imas tentzun. Eh kajlaj i tentzun ju'jun haab' i wilik keh, manlik wach i kiti'jolal. <verse number="18" style="v" />Eh nik' k'ihaal kok' imas wakax, imas tentzun, i kok' tentzun taq naa aaq'asam, je' wo' re' k'ihaal i holohik laj arina, i riis uuva taq naa aq'asam chi kik'u'liil, je' rukab' i ruq'or i nuk'uhb'aal. <verse number="19" style="v" />Eh koruman wo' hoq chi naa taq aq'asam chi amayiij jinaj i kaprax chi pahqb'al kuyb'al taq amahk, noq aq'asam taq chik eqal eqal ak'atoj mayiij ruch'ihil i holohik arina, ruch'ihil i riis taq aa-uuva.</para>
  <para style="p">
    <verse number="20" style="v" />Eh paroox q'iij naa taq aq'asam chi ak'atoj mayiij i junlaj kok' imas wakax, eh kiib' imas tentzun. Eh kajlaj i tentzun ju'jun haab' i wilik keh manlik wach i kiti'jolal. <verse number="21" style="v" />Eh nik' pa' k'ihaal i kok' imas wakax naa taq aq'asam nik' pa' k'ihaal imas tentzun, eh nik' pa' k'ihaal kok' tentzun, je' wo' re' k'ihaal i holohik laj arina, i riis uuva naa taq aq'asam chi kik'u'liil. Je' rukab' i ruq'or i nuk'uhb'aal. <verse number="22" style="v" />Eh koruman chi naa taq aq'asam chi amayiij jinaj i imas kaprax chi pahqb'al kuyb'al taq amahk, noq aq'asam taq chik eqal eqal ak'atoj mayiij ruch'ihil i holohik arina ruch'ihil i riis uuva.</para>
  <para style="p">
    <verse number="23" style="v" />Eh chupaam i rukaaj q'iij naa taq aq'asam chi ak'atoj mayiij i lajeeb' chi kok' imas wakax, eh kiib' imas tentzun, eh kajlaj tentzun i ju'jun haab' i wilik keh manlik wach i kiti'jolal. <verse number="24" style="v" />Eh nik' pa' k'ihaal i kok' imas wakax taq naa aq'asam, nik' pa' k'ihaal imas tentzun. Eh nik' pa' k'ihaal i kok' tentzun, je' wo' re' k'ihaal i holohik laj arina, je' wo' re' k'ihaal i riis uuva naa taq aq'asam chi kik'u'liil, je' rukab' i ruq'or i nuk'uhb'aal. <verse number="25" style="v" />Eh naa wo' taq aq'asam chi amayiij jinaj imas kaprax chi pahqb'al kuyb'al taq amahk, noq aq'asam taq chik eqal eqal ak'atoj mayiij ruch'ihil i holohik laj arina ruch'ihil i riis uuva.</para>
  <para style="p">
    <verse number="26" style="v" />Eh paroo' q'iij naa taq aq'asam chi ak'atoj mayiij i b'elejeeb' chi kok' imas wakax, eh kiib' imas tentzun, eh kajlaj i tentzun ju'jun haab' i wilik keh manlik wach i kiti'jolal. <verse number="27" style="v" />Eh nik' pa' k'ihaal i kok' imas wakax taq naa aq'asam, nik' pa' kihaal imas tentzun, nik' pa' k'ihaal i kok' tentzun je' wo' re' k'ihaal i holohik laj arina, i riis uuva naa taq aq'asam chi kik'u'liil, je' rukab' i ruq'or i nuk'uhb'aal. <verse number="28" style="v" />Eh naa wo' taq aq'asam chi amayiij jinaj imas kaprax chi pahqb'al kuyb'al taq amahk, noq aq'asam taq chik eqal eqal ak'atoj mayiij ruch'ihil i holohik laj arina, ruch'ihil i riis uuva.</para>
  <para style="p">
    <verse number="29" style="v" />Eh paruwaaq q'iij naa taq aq'asam chi ak'atoj mayiij i waxiqiib' chi kok' imas wakax, eh kiib' imas tentzun. Eh kajlaj i tentzun, ju'jun haab' wilik keh manlik wach i kiti'jolal. <verse number="30" style="v" />Re' q'oreel nik' pa' k'ihaal i kok' imas wakax taq naa aq'asam, eh nik' pa' k'ihaal imas tentzun. Eh nik' pa' k'ihaal imas tentzun, je' wo' re' k'ihaal i holohik laj arina, je' wo' re' k'ihaal i riis uuva naa taq aq'asam chi kik'u'liil. Je' rukab' i ruq'or i nuk'uhb'aal. <verse number="31" style="v" />Eh naa wo' taq aq'asam chi amayiij jinaj imas kaprax chi pahqb'al kuyb'al taq amahk, noq aq'asam taq chi eqal eqal ak'atoj mayiij, ruch'ihil i holohik laj arina, ruch'ihil i riis uuva.</para>
  <para style="p">
    <verse number="32" style="v" />Eh chupaam i ruwuuq q'iij naa taq aq'asam chi ak'atoj mayiij i wuquub' chi kok' imas wakax, eh kiib' imas tentzun. Eh kajlaj i tentzun ju'jun haab' i wilik keh manlik wach i kiti'jolal. <verse number="33" style="v" />Eh nik' pa' k'ihaal i kok' imas wakax taq naa aq'asam, nik' pa' k'ihaal imas tentzun, nik' pa' k'ihaal i kok' tentzun, je' wo' re' k'ihaal i holohik laj arina, i riis uuva naa taq aq'asam chi kik'u'liil. Je' rukab' i ruq'or i nuk'uhb'aal. <verse number="34" style="v" />Eh naa wo' taq aq'asam chi amayiij jinaj i kaprax chi pahqb'al kuyb'al taq amahk, noq aq'asam taq chik eqal eqal ak'atoj mayiij ruch'ihil i holohik arina, ruch'ihil i riis uuva.</para>
  <para style="p">
    <verse number="35" style="v" />Eh paruwahxaaq q'iij naa wo' chik taq a'nam i santo laj moloj iib' ye'b'al nuloq'il i hin, hin Dios. Eh chupaam i q'iij re' re' ma' jino'q taq aweh i naa rukamaniik. <verse number="36" style="v" />Eh naa taq aq'asam chi ak'atoj mayiij jinaj i k'isa imas wakax, jinaj imas tentzun, eh wuquub' tentzun ju'jun haab' i wilik keh, manlik wach i kiti'jolal. Re' taqe i re' ink'ohnik laj mayiij imponik chi nuwach i hin, hin Dios. <verse number="37" style="v" />Eh nik' pa' k'ihaal kok' imas wakax, taq naa aq'asam, nik' pa' k'ihaal imas tentzun, nik' pa' k'ihaal i kok' tentzun, je' wo' re' k'ihaal i holohik laj arina, riis uuva, naa taq aq'asam chi kik'u'liil. Je' rukab' i ruq'or i nuk'uhb'aal. <verse number="38" style="v" />Eh naa wo' taq aq'asam chi amayiij jinaj i kaprax chi pahqb'al kuyb'al taq amahk, noq aq'asam taq chik eqal eqal ak'atoj mayiij ruch'ihil i holohik laj arina, ruch'ihil i riis uuva.</para>
  <para style="p">
    <verse number="39" style="v" />Re' taqe i k'atoj mayiij naa taq aq'asam weh i hin chupaam i ninq'iij q'e' looq'. Eh naa wo' aye'em taq chi amayiij aq'orom taq, re' noq aye'em taq chik amayiij xa panak'ux taq naa ruchaliik, oon re' ruuk' holohik laj arina, oon i riis uuva, oon re' mayiij k'amb'al taq awiib' panotob'il wuuk', inki.</para>
  <para style="p">
    <verse number="40" style="v" />Eh re' Moisés xuq'or wo' keh i aj Israel chu'nchel i xq'orarik reh ruum i QaJaaw Dios.</para>
  <chapter number="30" style="c" />
  <para style="s">Re' ruq'orariik chi wilik i naa rub'aan</para>
  <para style="p">
    <verse number="1" style="v" />Re' i Moisés xuq'oreej taqe i ju'jun chi k'amal kib'eeh i ju'jun ch'uq chi aj Israel, je' wili i xuq'or keh: Re' QaJaaw Dios je' wili xuq'or: <verse number="2" style="v" />Wila' awach i xuq'or i xti korik reh i Dios chi wilik i naa rub'anam, chi wilik i naa ruye'em ma' naa ta rukahniik chi je' re' koruman chi naa rub'anam aha' wilik i xuq'or.</para>
  <para style="p">
    <verse number="3" style="v" />Wila' re' jino'q i k'isa q'ahxoq ko patim nahq'ab' i tuut rajaaw xuq'or i xti korik reh i Dios chi wilik i naa rub'anam chi wilik i naa ruye'em. <verse number="4" style="v" />Koruman chi naa ruye'em aha' wilik i xuq'or chi naa ruye'em, eh chi naa rub'anam aha' wilik i xuq'or wila' reht'al i rajaaw, wila' ma' xq'ilarik chub'aan. <verse number="5" style="v" />Eh raaj wila' re' rajaaw xunab'eej chi wilik i naa rub'anam, chi wilik i naa ruye'em i rixq'uun, eh wila' xuq'il chub'aan, neenkuyarik ru mahk ruum i Dios chi ma' nee ta rub'an aha' wilik i xuq'or.</para>
  <para style="p">
    <verse number="6" style="v" />Eh wila' re' q'ahxoq re' re' xub'an kaxáro noq ruq'orom chik i xti korik reh i Dios chi wilik i naa rub'anam, chi wilik i naa ruye'em, <verse number="7" style="v" />wila' xunab'eej i rub'ahiil, eh ma' xuq'il ta chi riij. Re' q'ahxoq re' re' koruman chi naa rub'anam aha' wilik i xuq'or chi naa rub'anam, chi naa ruye'em. <verse number="8" style="v" />Eh raaj wila' xq'ilarik ruum i rub'ahiil neerub'an chi ma' nee ta rub'an aha' wilik i xuq'or chi ma' nee ta ruyeew aha' wilik i xuq'or chi naa ruye'em, neenkuyarik ru mahk ruum i Dios.</para>
  <para style="p">
    <verse number="9" style="v" />Eh raaj wila' ch'aq kaxáro ixoq, oon kamnaq i rub'ahiil xq'orik i xti korik chi wilik i naa rub'anam, koruman chi naa rub'anam.</para>
  <para style="p">
    <verse number="10" style="v" />Eh wila' re' jino'q ixoq parupaat i rub'ahiil wilik noq xuq'or i xti korik reh i Dios chi wilik i naa rub'anam, chi wilik i naa ruye'em. <verse number="11" style="v" />Eh noq neerunab'eej i rub'ahiil, wila' ma' xq'ilarik chub'aan. Re' ixoq re' re' koruman chi naa rub'anam aha' wilik i xuq'or chi naa rub'anam, eh chi naa ruye'em. <verse number="12" style="v" />Eh raaj wila' q'ilarik ruum i rub'ahiil neerub'an chi ma' nee ta rub'an i xuq'or chi naa rub'anam, eh chi ma' nee ta ruyeew i xuq'or chi naa ruye'em, eh neenkuyarik ru mahk ruum i Dios.</para>
  <para style="p">
    <verse number="13" style="v" />Je' re' noq re' ixoq re' rub'ahiil naa ruq'oriik mineerub'an, oon ma' nee ta rub'an aha' wilik xuq'or i xti korik chi naa rub'anam, oon chi naa ruye'em. <verse number="14" style="v" />Eh noq neerunab'eej i rub'ahiil, eh wila' xik'ik kiib' ixib'-oq q'iij chi ma' xta xuq'or reh. Ar naa ruk'utiniik chi k'ahchi' ruye'em q'ab' chi naa rub'anam ixoq aha' wilik xuq'or i xti korik chi naa rub'anam, eh chi naa ruye'em. <verse number="15" style="v" />Eh wila' wilik chik q'iij rib'iram noq xuq'il i rehk'een chi riij i naa rub'anam i naa ruye'em. Re' b'ahiilb'ees re' re' wach naah i reh naa ruk'ahniik i ru mahk i rehk'een, inki.</para>
  <para style="p">
    <verse number="16" style="v" />Re' i taqe k'uhb'aal wili xuq'or i QaJaaw Dios reh i Moisés chi keh i b'ahiilb'ees chi keh i ehk'eenb'ees, chi keh ajaab'ees, chi keh kixq'uun ko wilik kuuk' pankipaat.</para>
  <chapter number="31" style="c" />
  <para style="s">Re' noq xkiq'aj wach i aj Israel i xb'aan keh kuum i aj Madián</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili xuq'or reh i Moisés: <verse number="2" style="v" />Re' hat chaq'aj wach keh i aj Madián aha' wilik i xkian reh taqe awuch aj Israel, chi riij i re' kora'j naa akimiik reje re' i hat, inki.</para>
  <para style="p">
    <verse number="3" style="v" />Eh re' i Moisés je' wili i xuq'or keh i aj Israel:</para>
  <para style="p">Re' taq i hat cha chop taq atz'a'aamb'aal hiy taq chi q'aq'inik kuuk' i aj Madián parub'ihnaal i QaJaaw Dios chaq'aj taq wach keh i xkian taq aweh. <verse number="4" style="v" />Eh ju'jun miil i naa awesam kuuk' i ju'jun ch'uq chi aj Israel reh chi nee kiooj chi q'aq'inik kuuk', inki.</para>
  <para style="p">
    <verse number="5" style="v" />Je' re' noq ju'jun miil wo' xelik kuuk' i ju'jun ch'uq chi aj Israel kab'laj miil chu'nchel i xiooj chi q'aq'inik. <verse number="6" style="v" />Re' i Moisés ju'jun miil i xresaj ruuk' i ju'jun ch'uq chi aj Israel xutaq'aaj panq'aq'inik, haa' i Finees rak'uun i Eleazar k'amal kib'eeh aj tiij, eh xuk'am reje taqe i kulk wilik chupaam i santo laj ye'aab' xuyohq'eej reje i tuun reh chi naa ruhuupem paam noq naa rutohq'iik i q'aq'inik. <verse number="7" style="v" />Eh i xkian wo' q'aq'inik kuuk' i aj Madián xkikansaj chu'nchel i winaq, je' rukab' i xuq'or i QaJaaw Dios reh i Moisés. <verse number="8" style="v" />Eh xkikansaj wo' haa' i ho'oob' chi kireey i aj Madián, je' wili kib'ihnaal: Evi, Requem, Zur, Hur, Reba. Eh xkikansaj wo' haa' i Balaam rak'uun i Beor. <verse number="9" style="v" />Re' taqe i aj Israel xkik'am chi prexohjik taqe ixoq aj Madián, haa' i kiha'lak'uun kok' taq. Eh xq'ucharik keh chu'nchel i kichikoop, eh xq'ucharik wo' keh i xa chib'ih jariik k'ih taq tz'aaq' chi keh. <verse number="10" style="v" />Eh xk'atarik taqe i kitinamiit i ki-itz'ihy naah paat i aj Madián, je' wo' taqe i patineel wilik chi kijunsuut. <verse number="11" style="v" />Eh chu'nchel i xq'ucharik keh chi je' kiristianu' chi je' taqe kichikoop. <verse number="12" style="v" />Eh xkik'am reje i chuwach i Moisés, chuwach i Eleazar k'amal kib'eeh aj tiij, eh chikiwach taqe i aj Israel wilkeeb' wach k'ixkaab' Moab re' wilik chi chii' i nim ha' Jordán re' ye'aab' wilik chi k'ulwaach i tinamit Jericó.</para>
  <para style="p">
    <verse number="13" style="v" />Eh re' i Moisés, i Eleazar k'amal kib'eeh aj tiij kuch'ihil taqe chu'nchel i k'amal kib'eeh i aj Israel jumehq'iil xi elik cho chi riij i ki-itz'ihy naah paat chi kik'ulariik taqe i q'aq'ineel. <verse number="14" style="v" />Eh re' i Moisés ma' k'isiin ta noq xchalik ruk'aah chikinaah i ink'amwik kib'eeh i ju'jun miil chi soldado, je' wo' chikinaah ink'amwik kib'eeh i ju'jun siento chi soldado <verse number="15" style="v" />Je' wili i xuq'or keh:</para>
  <para style="p">¿Chib'ih reet noq ma' xkuxik taq akansam taqe ixoq? <verse number="16" style="v" />Re' taqe ixoq re' re' xitaqchi'jik ruum i Balaam. Re' keh xk'amwik keh i aj Israel chi ximahkunik chuwach i QaJaaw Dios, xkimin chulooq'jiik taqe i tiyoox Baal-peor. Ruum i re' xutaq'aaj chaloq i runimaal yab'ilaal i Dios chikinaah i rutinamiit. <verse number="17" style="v" />Je' re' noq yu'naak inchol taq akansam chu'nchel i kok' ak'un je' wo' taqe ixoq keht'al chik q'orinik winaq. <verse number="18" style="v" />Eh re' taqe i kok' q'ahxoq ma' keht'al ta q'orinik winaq ma' nee ta taq inakansaj neerub'an chi nee kikahnik taq awuuk'. <verse number="19" style="v" />Eh chawunchelaal taq i hat xponik a'an ikaansanik, je' wo' taq i hat xatz'a'j taq i kamnaq, je' wo' taqe ixoq xak'am taq chaloq tikaan pee taq chi riij i itz'ihy naah paat. Chuwach i wuquub' q'iij. Eh koruman chi naa taq asaqb'isam awiib' chuwach ixib' q'iij chuwach i ruwuuq q'iij. <verse number="20" style="v" />Eh naa wo' taq asaqb'isam kiwach chu'nchel itz'ihy, je' wo' taqe i xa chib'ih jariik korjinaq ruuk' tz'uhuum, i korjinaq ruuk' rismaal riij kaprax, i korjinaq ruuk' chee', inki Moisés.</para>
  <para style="p">
    <verse number="21" style="v" />Re' i Eleazar i k'amal kib'eeh aj tiij, je' wili i xuq'or keh i xi sutinik cho panq'aq'inik:</para>
  <para style="p">Re' wili i k'uhb'aal xuq'or i QaJaaw Dios reh i Moisés: <verse number="22" style="v" />Re' taqe i chib'ihjariik re' ruuk' i oro, re' ruuk' plata, re' ruuk' i q'an ch'ihch', re' ruuk' rax ch'ihch', re' ruuk' i loch'ik laj ch'ihch', re' ruuk' plomo. <verse number="23" style="v" />Je' re' noq chu'nchel i xa chib'ih jariik ch'ihch' korjinaq wii' neerukuy ransil i q'aaq' ruuk' i re' neensaqb'esjik wach. Eh chi riij i re' neentz'ajarik kiwach ruuk' i ha' inkamanik chi saqb'eesb'al wachiis. Eh re' taqe i xa chib'ihjariik ma' inkikuy ta ransil i q'aaq' xa ruuk' ha' naa rusaqb'esjiik kiwach. <verse number="24" style="v" />Eh chupaam i ruwuuq q'iij nee taq inatz'aj aso' nee taq ti kahnik chi saq chik taq awach. Chi riij i re' kora'j taq nee ti okik re' chupaam taqe i itz'ihy naah paat, inki. <verse number="25" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="26" style="v" />Re' hat, awuch'ihil i Eleazar i k'amal kib'eeh aj tiij kuch'ihil taqe i k'amal kib'eeh ju'jun ch'uq chi aj Israel, nee taq i nawajlaaj chu'nchel i xak'am taq chaloq chi je' kiristianu', chi je' chikop i xaq'uch taq cho keh i aj Madián. <verse number="27" style="v" />Re' taqe i re' kiib' taq neenawesaj yejaal taq i nee nach'aq chikinaah i xi ponik q'aq'ineel, eh yejaal taq i nee nach'aq chikinaah i junch'uq chi aj Israel. <verse number="28" style="v" />Eh re' taqe i soldado wilik i naa kiq'asam chi kimayiij chi nuwach i hin re' ruuk' i naakik'ulum, ju'jun i naakesam ruuk' i ho'oob' taq siento chi je' kiristianu', chi je' taqe b'oyax, chi je' taqe b'uurux, chi je' taqe tentzun. <verse number="29" style="v" />Re' hat naa aq'asam reh i Eleazar i k'amal kib'eeh aj tiij, eh naa ruq'asam weh i hin ruum re' taqe re' wee hin, hin Dios. <verse number="30" style="v" />Re' i naa aye'em keh i aj Israel wilik, wo' naa kiq'asam weh chi kimayiij, ju'jun i naakesam ruuk' i lajeeb' roxk'ahl, chi je' taqe tinamit, chi je' taqe b'oyax, chi je' taqe b'uurux, chi je' taqe tentzun. Eh naa aq'asam keh i aj Levíta i k'amal kib'eeh aj tiij re' kib'anik i nukamaj chupaam i nuSanto laj itz'ihy naah paat.</para>
  <para style="p">
    <verse number="31" style="v" />Eh re' i Moisés ruch'ihil i Eleazar i k'amal kib'eeh aj tiij xkian wo' hoq aha' wilik i xuq'or i QaJaaw Dios reh i Moisés. <verse number="32" style="v" />Re' taqe i soldado noq xponik kian i q'aq'inik je' wili k'ihaal i xkiq'uch chaloq waqiib' siento miil ruuk' ho'lajuuj ru kajwinaq miil chi tentzun. <verse number="33" style="v" />Eh kab'laj ru kajwinaq miil chi b'oyax. <verse number="34" style="v" />Eh jinaj ru kajwinaq miil chi b'uurux. <verse number="35" style="v" />Eh kab'laj ru ka'winaq miil taqe i q'ahxoq ma' keht'al ta q'orinik winaq. <verse number="36" style="v" />Re' taqe i xi ponik panq'aq'inik yejaal i xkahnik keh ixib' siento ruuk' wuqlaj ru ka'winaq miil ruuk' hoob' siento chi tentzun chu'nchel. <verse number="37" style="v" />Eh re' xkiyeew reh i QaJaaw Dios waqiib' siento ruuk' ho'lajuuj ru kajwinaq chi tentzun. <verse number="38" style="v" />Eh re' i b'oyax xkahnik keh waqlaj ru kajwinaq miil chu'nchel. Eh re' i xkiyeew reh i QaJaaw Dios kab'laj rukaj winaq. <verse number="39" style="v" />Eh re' b'uurux xkahnik keh i soldado lajeeb' ru ka'winaq miil ruuk' hoob' siento. Eh re' i xkiyeew reh i QaJaaw Dios jinaj rukaj winaq. <verse number="40" style="v" />Eh re' taqe i q'ahxoq xkahnik kuuk' waqlaj miil, eh re' xkiyeew reh i QaJaaw Dios kab'laj ru ka'winaq. <verse number="41" style="v" />Eh re' i Moisés xuq'asaj wo' reh i Eleazar i k'amal b'eeh aj tiij aha' wilik i xkiyeew chi kimayiij chuwach i QaJaaw taqe i soldado, je' rukab' i xuq'or i QaJaaw Dios reh i Moisés.</para>
  <para style="p">
    <verse number="42" style="v" />Eh re' yejaal chik i xresaj iloq i Moisés ruuk' xkahnik keh i xi ponik panq'aq'inik, re' i xkahnik keh i aj Israel. <verse number="43" style="v" />Re' xkahnik keh, xti manlik yejaal, ixib' siento miil ruuk' wuqlaj ru ka'winaq miil ruuk' ho'oob' siento chi tentzun. <verse number="44" style="v" />Eh waqlaj ru ka'winaq miil i b'oyax. <verse number="45" style="v" />Eh lajeeb' ru ka'winaq miil ruuk' hoob' siento, i b'uurux. <verse number="46" style="v" />Eh waqlaj miil taqe i q'ahxoq. <verse number="47" style="v" />Eh re' yejaal re' re' xkahnik keh i aj Israel, re' i Moisés ju'jun i xesaj iloq ruuk' i ju'jun chi lajeeb' roxk'ahl je' re' i xub'an kuuk' i kiristianu', eh je' wo' kuuk' i chikop xuq'asaj keh i aj Levíta re' kikamanik parusanto laj itz'ihy naah paat i QaJaaw Dios, je' rukab' i xuq'or i QaJaaw Dios reh i Moisés.</para>
  <para style="p">
    <verse number="48" style="v" />Eh re' taqe i ju'jun ink'amwik kib'eeh i ju'jun miil i xi ponik q'aq'ineel, je' wo' taqe i ju'jun ink'amwik kib'eeh i ju'jun siento chi soldado xiooj ruuk' i Moisés. <verse number="49" style="v" />Eh je' wili i xkiq'or reh: Re' hoj, i hoj awaj kamanoom xqajlaaj chik i qa soldado chi qa ju'junaal, eh ma' jino'q i xikimik chaloq. <verse number="50" style="v" />Eh wili taqe i xa chib'ih jariik, oro korjinaq wii' chi ju'junaal re' taqe i reh ralaq q'ab'iis, eh kotokaq ch'ihch' lopq'aaq', ka'xikin. Eh wilik xa chib'ih chik jariik, re' taqe re' xchalik qaq'asaj reh i QaJaaw Dios, tojb'al riij chi xooj ruko'leej, inki taqe.</para>
  <para style="p">
    <verse number="51" style="v" />Eh re' i Moisés ruch'ihil i Eleazar i k'amal kib'eeh aj tiij xkik'ul aha' wilik taqe i xkiq'uch chaloq re' re' oro taqe korjinaq wii'. <verse number="52" style="v" />Re' taqe i oro korjinaq wii' xkiq'asaj i k'amal kib'eeh i ju'jun miil, ju'jun siento chi soldado, ik'inaq kijib' kintaal rahliil. <verse number="53" style="v" />Eh chi kiju'junaal taqe i soldado xkik'am chaloq aha' wilik i xkiq'uch cho keh i aj ixowaal. <verse number="54" style="v" />Eh re' i Moisés, i Eleazar i k'amal kib'eeh aj tiij xkik'ul taqe i oro korjinaq wii' xkik'am chaloq i k'amal kib'eeh i soldado. Eh xkik'am reje chupaam i rusanto laj itz'ihy naah paat molb'al iib', reh chi ma' naa ta rusahchiik paruk'ux taqe i aj Israel.</para>
  <chapter number="32" style="c" />
  <para style="s">Re' riih rumaam i Rubén, i riih rumaam i Gad xi okik chi patinik chi chii' i nim ha' Jordán</para>
  <para style="r">(<ref loc="DEU 3:12-22">Deut 3.12-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe i jun ch'uq chi riih rumaam i Rubén, ruch'ihil i riih rumaam i Gad, yohb'aal wach k'ihaal i kichikoop. Eh noq i xkilow chi re' ye'aab' Jezer ruch'ihil i ye'aab' Galaad q'e' holohik chi k'ihteesb'al chikop. <verse number="2" style="v" />Xiooj ruuk' i Moisés, ruuk' i Eleazar, eh kuuk' taqe i k'amal kib'eeh i tinamit, je' wili i xkiq'or ponoq keh:</para>
  <para style="p">
    <verse number="3" style="v" />Chakoj taq rehtaal taqe i ye'aab' Atarot, i Dibón, i Jazer, nimra Hesbón, i Eleale, i Sebam, Nebo, eh Beón. <verse number="4" style="v" />Re' taqe i ye'aab' re' re' xuchop naah i QaJaaw Dios chi qeh i hoj, hoj aj Israel. Eh q'e' taqe holohik chi k'ihteesb'al i chikop. Re' hoj, hoj amoso wilik qachikoop. <verse number="5" style="v" />Wila' neena a'n otob'il chayeew qeh i hoj taqe i ye'aab' re' re', maayeew q'ab' chi nee qoh ik'ik chi juntar i nim ha' Jordán, inki taqe.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' i Moisés, je' wili kichaq'weesjiik xub'an:</para>
  <para style="p">¿Mi nawaaj taq kahnik re' hat ayu', eh re' taqe i awuch tinamitaal naa kojiik panq'aq'inik? <verse number="7" style="v" />¿Chib'ih reet noq inawaaj taq ayojom kik'ux awuch aj Israel reh chi ma' nee ta kiooj wih-oq chupaam i ye'aab' naa ruye'ariik keh ruum i QaJaaw Dios? <verse number="8" style="v" />Re' taq i hat inawaaj wo' chik a'nam taq aweh je' rukab' i xkian taq aamaam awati't chupaam i ye'aab' Cades-barnea noq xnutaq'aaj taqe chaloq chi rilariik nik' wach noq wilik i ye'aab' re' re'. <verse number="9" style="v" />Re' keh xi ponik paraasb'al ha' Escol, chi rilariik nik' wach noq wilik i ye'aab'. Eh chi riij i re' xkiyoj ruk'ux taqe i k'uch aj Israel reh chi ma' xi ponik ta chupaam i ye'aab' naa naq ruye'ariik keh ruum i QaJaaw Dios. <verse number="10" style="v" />Ruum i xkian re' re' ma' k'isiin ta noq xchalik rujosq'iil i QaJaaw Dios, chikinaah. Eh xuq'or i xti korik, je' wili i xuq'or: <verse number="11" style="v" />Re' taqe i winaq wilik keh i juninaq haab' je' wo' taqe ik'inaq juninaq haab' ma' naa ta kokiik chupaam i holohik ye'aab', ruum ma' xkian taj i xnuq'or keh. Re' ye'aab' xnuq'or i xti korik reh i Abraham, reh i Isaac, reh i Jacob, chi naa nuye'em keh. <verse number="12" style="v" />Xa re' la' wo' hoq i Caleb rak'uun i Jefone naa rokiik ar, ruch'ihil i kanezeo, ruch'ihil i Josué rak'uun i Num xinkinimaj, inki. <verse number="13" style="v" />Eh chupaam taqe i q'iij re' re' ma' k'isiin ta chalik rujosq'iil i QaJaaw Dios chikinaah i aj Israel. Ruum i re' ka'winaq haab' xuyeew taqe chi b'ehiik chupaam i ye'aab' chiq yuuq' korehtaal xkuxik kikimiik nik' nimaal xkiq'etwachej i Dios ruuk' i kiyiib' wach na'ojb'al. <verse number="14" style="v" />Eh yu'naak taq i hat, i hat taq cho kiih kimaam i xib'anik cho reh taqe i yiib' wach na'ojb'al re' re' inawaaj wo' chik taq awuksam cho wach i rujosq'iil i QaJaaw Dios chikinaah taq awuch aj Israel. <verse number="15" style="v" />Wila' ma' nawaaj taq animam i QaJaaw Dios re' reh konee wo' chik qoh rukanaa' nik'-oq najtiil chupaam i ye'aab' chiq yuuq'. Eh amahk taq i hat wila' xkuxik kikimiik i qatinamiit Israel, inki.</para>
  <para style="p">
    <verse number="16" style="v" />Eh re' taqe i riih rumaam i Rubén, taqe i riih rumaam i Gad je' wili xkiq'or reh i Moisés:</para>
  <para style="p">Re' hoj xa re' inqaaj chi chupaam i ye'aab' wili naa q'ayejaam i kiye'aab' i qehk'een, i qak'uun qixq'uun, eh kikoraal i qachikoop. <verse number="17" style="v" />Eh re' hoj winaq nee wo' qachop qatz'a'amb'aal reh q'aq'inik nee qoh ooj chi peet b'eeh chikiwach i quch aj Israel korehtaal inqakoj taqe chupaam i kiye'aab' naa kiwihiik wii'. Eh re' qehk'een, taqe i qaha'lak'uun nee kikahnik chupaam i ye'aab' wili, reh chi neenkiko'leej kiib' chikiwach i wilkeeb' chupaam i ye'aab' re' re'. <verse number="18" style="v" />Eh re' hoj ma' nee ta qoh sutinik cho chupaam i qaye'aab' wili, wila' komajaa' inkichop naah i kiye'aab' i quch aj Israel. <verse number="19" style="v" />Wila' xayeew qeh i ye'aab' wili, wilik reje pareelb'aal q'iij reh i nim ha' Jordán. Re' hoj ma' nee ta chik inqapahqaaj qaye'aab' chi juntar i nim ha' Jordán re' naa kiwihiik wii' i keh, inki taqe.</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' i Moisés je' wili kichaq' wesjiik xub'an:</para>
  <para style="p">Wila' korik taq inaq'or, wila' nee taq inachop reje atz'a'aamb'aal reh q'aq'inik je' rukab' i xuq'or i QaJaaw Dios. <verse number="21" style="v" />Eh wila' chawunchelaal taq i hat naa achopom taq atz'a'aamb'aal noq nee taq i naq'at wach i nim ha' Jordán je' rukab' i ruq'or i QaJaaw Dios. Korehtaal taq i nakaaj reje ar taqe i aj ixowaal. <verse number="22" style="v" />Eh noq kehchaam chik i ye'aab' re' re' taqe awuch aj Israel. Eh noq a'nam taq chik i ruq'orom i QaJaaw Dios, eh atoob'eem wo' chik taqe i awuch aj Israel nee wo' chik ti sutinik chaloq. Eh re' i QaJaaw Dios nee ruyeew taq aweh i ye'aab' wili. <verse number="23" style="v" />Eh wila' ma' xa a'n taq i je' re' nee taq ti mahkunik chuwach i QaJaaw Dios. Eh re' taq i hat naa taq atojom wach amahk re' re'. <verse number="24" style="v" />Neerub'an chi nee taq inayejaa' i kiye'aab' awehk'een, taqe i aha'lak'uun, nee wo' rub'an chi nee taq inayejaa' i rukoraal aachikoop. Cha a'n taq i xapahqaaj taq ruuk' aachii'.</para>
  <para style="p">
    <verse number="25" style="v" />Eh re' taqe riih rumaam i Gad, taqe i riih rumaam i Rubén je' wili i xkiq'or reh i Moisés:</para>
  <para style="p">Re' hoj, i hoj amoso naaqanam aha' wilik i xaq'or. <verse number="26" style="v" />Re' taqe i qehk'een, taqe i qaha'lak'uun, ruch'ihil taqe i qachikoop naa kikahniik ayu' chupaam taqe i tinamit wilkeeb' Galaad. <verse number="27" style="v" />Eh re' hoj, i hoj amoso neenqachop qatz'a'amb'aal nee qohooj chi peet b'eeh chi q'aq'inik, neen qa'an je' rukab' i xuq'or i QaJaaw, je' rukab' i xaq'or qeh i hat, inki taqe.</para>
  <para style="p">
    <verse number="28" style="v" />Chi riij i re', re' i Moisés xuq'oreej i Eleazar re' k'amal kib'eeh aj tiij, ruch'ihil i Josué rak'uun i Nun, ruch'ihil taqe i ju'jun chi k'amal kib'eeh i ju'jun ch'uq chi aj Israel, je' wili i xuq'or keh:</para>
  <para style="p">
    <verse number="29" style="v" />Wila' re' taqe i riih rumaam i Gad, taqe i riih rumaam Rubén, awuch'ihil taq noq nee taq inaq'at wach i nim ha' Jordán, kichopom kitz'a'amb'aal reh ojik chi q'aq'inik, je' rukab' i xuq'or i QaJaaw Dios.</para>
  <para style="p">Eh nee taq tikitow korehtaal i nawehchaaj i ye'aab' re' re' taq i hat, kora'j taq nee nayeew chi kiye'aab' re' i tinamit Galaad. <verse number="30" style="v" />Eh wila' ma' xiooj chi q'aq'inik taq chi awuch'ihil ar Canaán taq nee nayeew kiye'aab' re' wo' taq i naa ak'ulum wii' aaye'aab' i hat, inki.</para>
  <para style="p">
    <verse number="31" style="v" />Re' taqe i junch'uq chi riih rumaam Gad, ruch'ihil i junch'uq chi riih rumaam i Rubén, je' wili i chaq'wik xkian:</para>
  <para style="p">Re' hoj, hoj amoso neen qa'an aha' wilik i xuq'or i QaJaaw. <verse number="32" style="v" />Re' hoj naaqojiik chi q'aq'inik Canaán reh chi neen qa'an i xuq'or i QaJaaw Dios. Chi je' re' neenqehchaaj i ye'aab' wilik chi korkiil reje ireelb'aalq'iij reh i nim ha' Jordán, inki taqe.</para>
  <para style="p">
    <verse number="33" style="v" />Eh re' i Moisés xuch'aq keh i riih rumaam Gad, i riih rumaam Rubén, ruch'ihil i yejaal i ch'uq i riih rumaam Manasés rak'uun i José, i rutinamiit i ye'aab' wilik chi junsuut ruchopom naah i Sehón kireey i aj amorreo, je' wo' hoq i rutinamiit i ye'aab' wilik chi junsuut ruchopom naah i Og kireey i aj Basán. <verse number="34" style="v" />Re' taqe i junch'uq chi riih rumaam Gad xkiyejaa' wo' chik i tinamit je' wili kib'ihnaal: Dibón, Atarot, Aroer. <verse number="35" style="v" />Atarot-sofán, Jazer, Jogbeha. <verse number="36" style="v" />Bet-nimra, Bet-arán, xkikoj ko'lb'al reh taqe i tinamit re' re'. Eh xkiyejaa' wo' hoq rikoraal i kitentzuun. <verse number="37" style="v" />Eh re' taqe i junch'uq chi riih rumaam i Rubén, xkiyejaa' wo' chik i tinamit, je' wili i kib'ihnaal: Hesbón, Eleale, Quiriataim, <verse number="38" style="v" />Nebo, Baal-meón, Sibma, eh wilik i kijal waach i rub'ihnaal i tinamit i xkiyejaa', rukapeech.</para>
  <para style="p">
    <verse number="39" style="v" />Eh re' taqe i junch'uq chi riih rumaam i Maquir re' rak'uun Manasés xkichop naah i ye'aab' Galaad xkikoj reje taqe i aj amorreo wilkeeb' naq ar. <verse number="40" style="v" />Eh re' i Moisés xuch'aq keh i riih rumaam i Maquir i ye'aab' Galaad. Re' keh xi okik chi patinik ar. <verse number="41" style="v" />Eh je' wo' hoq i Jair re' ruuk' i riih rumaam Manasés. Wilik taqe i ye'aab' xuchop naah re' patim naq taqe wii' i aj amorreo, Havot-jair i rub'ihnaal xukoj. <verse number="42" style="v" />Eh re' i Noba xuchop wo' naah i ye'aab' Kenat, je' wo' taqe i ye'aab' wilkeeb' wii' patineel wilik chi junsuut. Re' i ye'aab' re' re' Noba rub'ihnaal xukoj ruum je' re' i rub'ihnaal i winaq re' re'.</para>
  <chapter number="33" style="c" />
  <para style="s">Re' b'ehik xkian i aj Israel noq xi elik cho Egipto, eh xi k'uloq chii' nim ha' Jordán</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe i aj Israel je' wili noq xi elik cho Egipto, kihiil kihiil chaloq, eh chi kich'uhqaal xi chalik je' rukab' noq kib'ehik taqe i soldado. Re' i Moisés, re' i Aarón xk'amwik cho kib'eeh. <verse number="2" style="v" />Re' i Moisés xutz'ihb'aaj i keliik chaloq Egipto, eh tuslik rutz'ihb'aam taqe i b'ih i ye'aab' kihi'lik wii' je' rukab' i xq'orarik reh ruum i QaJaaw Dios. Eh je' wili i chalik xkian:</para>
  <para style="p">
    <verse number="3" style="v" />Noq xi elik cho Egipto i aj Israel q'e' kow kiib', ar xi elik cho chupaam i ye'aab' Ramasés chikiwach chu'nchel i aj Egipto, chupaam i ho'lajuuj rub'eeh i peet poh reh i haab' re' re', chi junwaar reh peet ninq'iij xk'isaj i aj Israel ruum i keliik cho Egipto. <verse number="4" style="v" />Eh noq xi elik chaloq manlik k'achi' kimuq'aam chu'nchel i peet kak'uun i aj Egipto re' i xi kanteesjik ruum i QaJaaw Dios ruuk' i re' xresaj i rajaawriik i kitiyoox i aj Egipto.</para>
  <para style="p">
    <verse number="5" style="v" />Re' taqe i aj Israel noq xi elik cho chupaam i ye'aab' Ramesés, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat Sucot.</para>
  <para style="p">
    <verse number="6" style="v" />Eh noq xi elik cho Sucot ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat, Etam wilik reje pank'ula't reh i ye'aab' chiq yuuq'.</para>
  <para style="p">
    <verse number="7" style="v" />Eh noq xi elik cho Etam xi chalik chupaam i ye'aab' Pi-hahirot wilik reje parelb'aal q'iij reh i Baal-zefón. Eh ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chuwach i ye'aab' Migdol.</para>
  <para style="p">
    <verse number="8" style="v" />Eh noq xi elik cho Pi-hahirot xi q'ahxik cho juntar palaw xi k'uloq chupaam i ye'aab' chiq yuuq'. Eh ixib' q'iij xib'ehik panchiq yuuq' wilik ar Etam, eh ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Mara.</para>
  <para style="p">
    <verse number="9" style="v" />Eh noq xi elik cho ar xi ponik chupaam i ye'aab' Elim re' wilik wii' i kab'laj raasb'al ha', eh re' wilik wii' i lajeeb' ru kajwinaq iwal chi kalaab', eh ar xkiyejaa' i ki-itz'ihy naah paat.</para>
  <para style="p">
    <verse number="10" style="v" />Eh noq xi elik cho Elim ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat, chi chii' i kaq palaw.</para>
  <para style="p">
    <verse number="11" style="v" />Eh noq xi elik cho chi chii' i kaq palaw ar chik xk'ulik kiyejaa' ki-itz'ihy naah paat chupaam i chiq yuuq' wilik Sin.</para>
  <para style="p">
    <verse number="12" style="v" />Eh noq xi elik cho pan chiq yuuq' Sin, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Dofca.</para>
  <para style="p">
    <verse number="13" style="v" />Eh noq xi elik cho Dofca, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Alús.</para>
  <para style="p">
    <verse number="14" style="v" />Eh noq xi elik cho Alús ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Refidim, re' i ma' inkireq ta wii' kihaa' i tinamit.</para>
  <para style="p">
    <verse number="15" style="v" />Eh noq xi elik cho Refidim, ar chik xk'ulik kiyejaa' ki-itz'ihy naah paat chupaam i ye'aab' chiq yuuq' wilik Sinaí.</para>
  <para style="p">
    <verse number="16" style="v" />Eh noq xi elik cho Sinaí ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Kibrot-hataava.</para>
  <para style="p">
    <verse number="17" style="v" />Eh noq xi elik cho Kibrot-hataava, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat Hazerot.</para>
  <para style="p">
    <verse number="18" style="v" />Eh noq xi elik cho Hazerot, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Ritma.</para>
  <para style="p">
    <verse number="19" style="v" />Eh noq xi elik cho Ritma, ar chik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Rimón-peres.</para>
  <para style="p">
    <verse number="20" style="v" />Eh noq xi elik cho Rimón-peres, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Libna.</para>
  <para style="p">
    <verse number="21" style="v" />Eh noq xi elik cho Libna, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Rissa.</para>
  <para style="p">
    <verse number="22" style="v" />Eh noq xi elik cho Rissa, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Ceelata.</para>
  <para style="p">
    <verse number="23" style="v" />Eh noq xi elik cho Ceelata, ar chik xk'ulik kiyejaa' ki-itz'ihy naah paat chinaah i yuuq' Sefer.</para>
  <para style="p">
    <verse number="24" style="v" />Eh noq xi elik cho chinaah i yuuq' Sefer, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Harada.</para>
  <para style="p">
    <verse number="25" style="v" />Eh noq xi elik cho Harada, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Macelot.</para>
  <para style="p">
    <verse number="26" style="v" />Eh noq xi elik cho Macetol, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Tahat.</para>
  <para style="p">
    <verse number="27" style="v" />Eh noq xi elik cho Tahat, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Tara.</para>
  <para style="p">
    <verse number="28" style="v" />Eh noq xi elik cho Tara, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Matca.</para>
  <para style="p">
    <verse number="29" style="v" />Eh noq xi elik cho Matca, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Hasmona.</para>
  <para style="p">
    <verse number="30" style="v" />Eh noq xi elik cho Hasmona, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Moserot.</para>
  <para style="p">
    <verse number="31" style="v" />Eh noq xi elik cho Moserot, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Bene-jaacán.</para>
  <para style="p">
    <verse number="32" style="v" />Eh noq xi elik cho Bene-jaacán, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Hor wilik Gidgad.</para>
  <para style="p">
    <verse number="33" style="v" />Eh noq xi elik cho Hor wilik Gidgad, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Jotbata.</para>
  <para style="p">
    <verse number="34" style="v" />Eh noq xi elik cho Jotbata, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Abrona.</para>
  <para style="p">
    <verse number="35" style="v" />Eh noq xi elik cho Abrona, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Ezión-geber.</para>
  <para style="p">
    <verse number="36" style="v" />Eh noq xi elik cho Ezión-geber, ar chik kiyejaa' i ki-itz'ihy naah paat chupaam i chiq yuuq' wilik Zin, re' Cades.</para>
  <para style="p">
    <verse number="37" style="v" />Eh noq xi elik cho Cades, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chinaah i yuuq' Hor wilik pank'ula't ruuk' i Edom. <verse number="38" style="v" />Eh noq wilkeeb' ar xq'orarik reh i Aarón kajaaw i k'amal kib'eeh aj tiij chi xjohtik chinaah i yuuq' Hor, eh ar xkimik chupaam i k'amb'al rub'eeh i roo' poh reh i ru ka'winaq haab' kielik chee aj Israel ar Egipto. <verse number="39" style="v" />Eh noq xkimik i Aarón chinaah i yuuq' Hor wilik reh i jinaj Siento ruuk' ixib' ru ka'winaq haab'.</para>
  <para style="p">
    <verse number="40" style="v" />Eh re' i kireey i aj Arad wilkeeb' ar Neguev chupaam i ye'aab' Canaán xrib'iraj rib'iral chi naakik'uliik iloq i aj Israel.</para>
  <para style="p">
    <verse number="41" style="v" />Eh re' taqe i aj Israel noq xi elik cho chinaah i yuuq Hor ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Zalmona.</para>
  <para style="p">
    <verse number="42" style="v" />Eh noq xi elik cho Zalmona, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Punón.</para>
  <para style="p">
    <verse number="43" style="v" />Eh noq xi elik cho Punón, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Obot.</para>
  <para style="p">
    <verse number="44" style="v" />Eh noq xi elik cho Obot, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Ije-abarim wilik pank'ula't reh i Moab.</para>
  <para style="p">
    <verse number="45" style="v" />Eh noq xi elik cho Ije-abarim, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i Dibón-gad.</para>
  <para style="p">
    <verse number="46" style="v" />Eh noq xi elik cho Dibón-gad, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chupaam i ye'aab' Almón-diblataim.</para>
  <para style="p">
    <verse number="47" style="v" />Eh noq xi elik cho Almón-diblataim, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat chinaah i yuuq' Abarim wilik reje parelb'aal q'iij reh i Nebo.</para>
  <para style="p">
    <verse number="48" style="v" />Eh noq xi elik cho chinaah i yuuq' Abarim, ar chik xk'ulik kiyejaa' i ki-itz'ihy naah paat wach k'ixkaab' Moab, chi chii' i nim ha' Jordán chuwach i tinamit Jericó. <verse number="49" style="v" />Eh re' i ki-itz'ihy naah paat xkiyejaa' chi chii' i nim ha' Jordán xponik ko chupaam i ye'aab' Bet-jesimot xponik wo' hoq ko Abel-sitim chuwach taqe i k'ixkaab' Moab.</para>
  <para style="s">Re' ruchopariik naah, re' ruch'aqariik i ye'aab' Canaán</para>
  <para style="p">
    <verse number="50" style="v" />Eh chuwach taqe i kixkaab' Moab chi chii' i nim haa' Jordán, chuwach i tinamit Jericó, re' i QaJaaw Dios xuq'oreej chaloq i Moisés, je' wili i xuq'or reh: <verse number="51" style="v" />Re' hat je' wili i cha q'or keh i aj Israel: Noq re' taq i hat neenaq'at wach i nim ha' Jordán noq nee taq ti okik chupaam i ye'aab' Canaán. <verse number="52" style="v" />Eh naa taq awesam taqe reje chu'nchel i tinamit wilkeeb' ar. Eh nee wo' taq i naa xereb'eej chu'nchel i kitiyoox ab'aj korjinaq wii', i kitiyoox haab'imaj ch'ihch'. Eh chayojib'eej wo' taqe i ye'aab' inki a'n wii' i loq'inik chinaah taqe i yuuq'. <verse number="53" style="v" />Chawesaj taq reje chu'nchel i wilkeeb' ar re' taq chik i hat nee ti okik chi patinik ar ruum re' ye'aab' re' re' nuye'em taq chik aweh i hat. <verse number="54" style="v" />Eh konee nasik' chi riij noq nee nach'aq keh i ju'jun chi aj Israel. Wila' k'ih chi kiib' nim wo' hoq i kiye'aab' nee nayeew, eh wila' ma' k'ih chi kiib' ma' nim ta wo' hoq i kiye'aab' nee nayeew. Re' i ju'jun ch'uq naa wo' kik'ulum aha' wilik i sik'ooj wach chi keh. <verse number="55" style="v" />Eh wila' ma' xawesaj taq reje chu'nchel i patineel wilkeeb' ar. Re' taqe i naa kikahniik ar naa taq kaat kijot'om je' rukab' noq tirujot' taq i ruxeer chee' panaq'awach, oon je' jino'q k'iix taq pan ati'jolal noq wilkaat taq chik chi patinik chupaam i ye'aab' re' re'. <verse number="56" style="v" />Eh re' hin naa nub'anam taq aweh i hat aha' naq wilik i naa nub'anam kekeh, inki.</para>
  <chapter number="34" style="c" />
  <para style="s">Re' i ruk'ula'tiil chi junsuut i ye'aab' Canaán</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili xuq'or reh i Moisés: <verse number="2" style="v" />Re' hat cha q'or keh i aj Israel chi je' wili: Re' taq i hat xailook' taq chik ti okik chupaam i ye'aab' Canaán, re' i ye'aab' naa rukahniik taq chi aweh. Eh ayu' imponik taqe i ruk'ula'tiil chi junsuut.</para>
  <para style="p">
    <verse number="3" style="v" />Pansak'aaj reh i rookb'aal q'iij, naa ruk'ula'teem reje i chiq yuuq wilik Zin paruyuq'ul i Edom. Eh naa rutoq'aam reje chi chii' i kamnaq palaw naa rojiik reje chi korik pantz'eet reh i rookb'aal i q'iij naa ruponiik reje parelb'aal i q'iij. <verse number="4" style="v" />Naa ruponiik kowach yuuq' Acrabim, naa rik'iik ponoq Zin naa ruponiik Cades-barnea. Eh chi riij i re' naa rik'iik Hasar-adar, eh naa ruponiik ko Asmón. <verse number="5" style="v" />Eh naa rik'iik reje Asmón, naa ruponiik chi chii' i nim ha' i nik'ik paruk'ula'tiil i ruyuq'ul i Egipto, ar naa rojiik kuxoq chi chii' i palaw Mediterráneo.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' i ruk'ula'tiil panookb'al reje i q'iij, ar naa ruponiik chi chii' i palaw Mediterráneo.</para>
  <para style="p">
    <verse number="7" style="v" />Eh re' ruk'ula'tiil pantz'eet reje reh i rookb'aal i q'iij, ar naa rutohq'iik reje chi chii' i palaw Mediterráneo, naa ruponiik chinaah i yuuq' Hor. <verse number="8" style="v" />Eh naa rik'iik ponoq chinaah i yuuq' Hor, eh naa ruponiik ko Hamat, naa ruponiik ko Zadad. <verse number="9" style="v" />Eh naa wo' chik rojiik i k'oq Zifrón, eh naa ruponiik Hazar-enán. Ar naa rojiik kuxoq i ruk'ula'tiil taq aye'aab' pantz'eet reje reh i rookb'aal q'iij.</para>
  <para style="p">
    <verse number="10" style="v" />Eh re' ruk'ula'tiil parelb'aal reje reh i q'iij, ar naa reliik reje Hazar-enán, naa rik'iik ponoq Safam. <verse number="11" style="v" />Eh naa rik'iik ponoq Sefam, naa wo' rik'iik ponoq Ribla re' i wilik reje parelb'aal q'iij reh i ye'aab' Aín rub'ihnaal chi riij i re', re' k'ula't naa ruqajiik qohoq parelb'aal q'iij reje reh i palaw kineret. <verse number="12" style="v" />Eh naa wo' rojiik i k'oq ko chi chii' i nim ha' Jordán ko ar naa rojiik kuxoq wach i nk'uxik wii' wach i kamnaq palaw.</para>
  <para style="p">Re' taqe i ye'aab' wili, naa ruk'ula'teem chi junsuut i Canaán, re' taq aye'aab' i hat, inki.</para>
  <para style="p">
    <verse number="13" style="v" />Re' i Moisés je' wili i xuq'or keh i aj Israel: Re' taqe i ye'aab' re' re' naa ruye'em taq aweh i QaJaaw Dios xa re' la' konaa taq asik'im chi riij aha' wilik i naa rehchaam i ju'jun ch'uq. Re' QaJaaw, xuq'or chi re' re' naa ruch'aqariik keh i b'elejeeb' ch'uq ruuk' yejaal i ch'uq chi aj Israel. <verse number="14" style="v" />Ruum re' i junch'uq chi riih rumaam Rubén, re' i junch'uq chi riih rumaam Gad, je' wo' hoq i yejaal i ch'uq reh i riih rumaam Manasés xkik'ul chik i kiye'aab' i keh. <verse number="15" style="v" />Re' taqe i ka'ch'uq ruuk' i yejaal i ch'uq re' re' xi kahnik chi chii' i nim ha' Jordán ar xkik'ul i kiye'aab', parelb'aal q'iij reje reh i nim ha' re' re'. Re' ye'aab' re' re' ar inkahnik chuwach i tinamit Jericó, inki.</para>
  <para style="p">
    <verse number="16" style="v" />Eh re' i QaJaaw Dios je' wo' chik wili i xuq'or reh i Moisés: <verse number="17" style="v" />Re' naakich'aqwiik i ye'aab' keh i aj Israel re' i Eleazar k'amal kib'eeh aj tiij, eh re' i Josué rak'uun Nun. <verse number="18" style="v" />Eh naa wo' kiyuq'eem chikiij i ju'jun i kik'amwik b'eeh chi kixilak i ju'jun ch'uq chi aj Israel reh chi nee kitowik haa' chuch'aqariik i ye'aab', <verse number="19" style="v" />Re' naakiyuq'ub'jiik haa' je' wili i kib'ihnaal:</para>
  <para style="p">Re' Caleb rak'uun i Jefone i k'amal b'eeh chi kixilak i junch'uq chi riih rumaam i Judá.</para>
  <para style="p">
    <verse number="20" style="v" />Re' Semuel rak'uun i Amiud i k'amal kib'eeh i junch'uq chi riih rumaam Simeón.</para>
  <para style="p">
    <verse number="21" style="v" />Re' Elidad rak'uun i Quislón i k'amal kib'eeh i junch'uq chi riih rumaam i Benjamín.</para>
  <para style="p">
    <verse number="22" style="v" />Re' i Buqui rak'uun i Jogli i k'amal kib'eeh i junch'uq chi riih rumaam Dan.</para>
  <para style="p">
    <verse number="23" style="v" />Re' i Haniel rak'uun i Efod i k'amal kib'eeh i junch'uq chi riih rumaam José, eh k'amal wo' kib'eeh i junch'uq chi riih rumaam i Manasés. <verse number="24" style="v" />Re' i Kemuel rak'uun i Siftan i k'amal kib'eeh i junch'uq chi riih rumaam i Efraín.</para>
  <para style="p">
    <verse number="25" style="v" />Re' i Elizafán rak'uun i Parnac i k'amal kib'eeh i junch'uq chi riih rumaam i Zabulón.</para>
  <para style="p">
    <verse number="26" style="v" />Re' i Paltiel rak'uun i Azán i k'amal kib'eeh i junch'uq chi riih rumaam Isacar.</para>
  <para style="p">
    <verse number="27" style="v" />Re' i Ahiud rak'uun i Selomi i k'amal kib'eeh i junch'uq chi riih rumaam Aser.</para>
  <para style="p">
    <verse number="28" style="v" />Re' i Pedael rak'uun i Amiud i k'amal kib'eeh i junch'uq chi riih rumaam Neftalí.</para>
  <para style="p">
    <verse number="29" style="v" />Re' aj taqe i winaq wili i xupab'aa' i QaJaaw Dios chi naa kich'aqam i ye'aab' Canaán keh i aj Israel.</para>
  <chapter number="35" style="c" />
  <para style="s">Re' taqe tinamit xye'arik keh i junch'uq chi riih rumaam i Leví</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés wach k'ixkaab' Moab chi chii' i nim ha' Jordán chuk'ulwaach i tinamit Jericó: <verse number="2" style="v" />Re' hat cha q'or keh i aj Israel chi kiyeew kitinamiit taqe i aj Levíta re' i naa ruye'eariik keh reh chi ar neekik'achariik. Eh re' ye'aab' chi junsuut i kitinamiit, neenye'arik keh chi ye'aab' kichikoop. <verse number="3" style="v" />Ruum re' taqe i aj Levíta koruman chi chupaam taqe i tinamit re' re' naakipatiniik. Eh re' i ye'aab' chi junsuut naa rukamaniik chi ye'aab' kiwakax, eh chu'nchel i kichikoop. <verse number="4" style="v" />Eh re' i naa kianam wii' kiwa' i kichikoop naakiye'em naa ruponiik hoob' siento b'ara chi junsuut i tz'aq sutimaj wii' riij i tinamit. <verse number="5" style="v" />Eh chi riij i tinamit parelb'aal reje i q'iij naakipajam jinaj miil b'ara eh pantz'eet reje reh i rookb'aal q'iij naakipajam i jinaj miil b'ara.</para>
  <para style="p">Eh parookb'aal reje i q'iij naakipajam i jinaj miil b'ara, eh pantz'eet reje reh i rookb'aal i q'iij naakipajam jinaj miil b'ara. Eh re' tinamit panyejaal naa rukahniik, eh naa rukahniik chi ye'aab' kichikoop i chi junsuut.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' i k'ihset chi tinamit naakiye'em reh taqe i aj Levíta waqiib' seht i naa rukahniik chi ke'emb'al iib'. Reh chi ar neenooj rusik' ko'lemb'al riib' awach i nee rukansaj jino'q i ras ruchaaq'. Eh ko ka'winaq seht chik i naakiye'em chi riij i re'. <verse number="7" style="v" />Eh chu'nchel i tinamit naakiye'em reh taqe i aj Levíta naa ruponiik waxiqiib' roxk'ahl haa' i ye'aab' kichikoop. <verse number="8" style="v" />Re' ye'aab' naakiye'em reh taqe i aj Levíta re' q'oreel nik' nimaal i ye'aab' xkik'ul i ju'jun ch'uq chi aj Israel awach taqe i nim xkik'ul nim wo' naakiye'em. Eh awach taqe i ma' nim ta xkik'ul ma' nim ta wo' hoq i naakiye'em reh taqe i aj Levíta inki.</para>
  <para style="s">Re' taqe i tinamit ke'emb'al iib'</para>
  <para style="r">(<ref loc="DEU 19:1-13">Deut 19.1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Moisés: <verse number="10" style="v" />Re' hat cha q'or keh i aj Israel taqe i q'orik wili: Noq hat taq chik ik'inaq chi juntar i nim ha' Jordán, noq wilkaat taq chik chupaam i ye'aab' Canaán, <verse number="11" style="v" />nee taq inasik' wach i ju'jun seht-oq i tinamit reh chi neen kamanik chi ke'emb'al iib'. Eh chi ar naa rojiik kikeb'aam kiib' taqe i ma' xata nkaaj chi neenkikansaj i kas kichaaq'. <verse number="12" style="v" />Eh chupaam taqe i tinamit re' re' neenkiko'leej kiib' chikiwach taqe awach keh i naa kikansam. Re' keh ma' naa ta kikanteesjiik korehtaal inq'atarik i q'orik chikinaah chikiwach taqe i aj Israel. <verse number="13" style="v" />Eh waqiib' seht keh i tinamit i naa taq aye'em keh i aj Levíta naa taq akanaam chi ke'emb'al iib'. <verse number="14" style="v" />Re' taqe tinamit ke'emb'al iib' re' re' ixib' i naa rukahniik chi juntar i nim ha' Jordán, eh ixib' i naa rukahniik Canaán. <verse number="15" style="v" />Re' taqe waq seht chi tinamit re' re' naa rukahniik chi ke'emb'al kiib' i aj Israel, je' wo' taqe i tokoom tinamit wilkeeb' taq chaxilak, oon xa ik'ik inki a'n taq chaxilak re' taqe i ma' xata nkaaj chi naa kikansam i kas kichaaq'.</para>
  <para style="p">
    <verse number="16" style="v" />Eh wila' awach i xukansaj i ras ruchaaq' ruuk' jino'q ch'ihch', re' re' aj kaansoom. Eh re' i aj kaansoom re' re' naa wo' rukanteesjiik i reh.</para>
  <para style="p">
    <verse number="17" style="v" />Eh wila' awach i xukansaj ruuk' ab'aj i ras ruchaaq', re' re' aj kaansoom. Eh re' i aj kaansoom re' re' naa wo' rukanteesjiik i reh.</para>
  <para style="p">
    <verse number="18" style="v" />Eh wila' awach i xukansaj ruuk' chee' i ras ruchaaq', re' re' aj kaansoom. Eh re' i aj kaansoom re' re' naa wo' rukanteesjiik i reh. <verse number="19" style="v" />Eh awach i naa rukanteesjiik re' i ma' tokoom ta ruuk' naa rukansaniik reh i aj kaansoom re' re', xa aha' pa' nee rureq.</para>
  <para style="p">
    <verse number="20" style="v" />Eh wila' awach i xumihnaaj jino'q i ras ruchaaq' xa ruum chi rixow wach, eh xukut-oq ruuk' jino'q xa chib'ih jariik, xaraaj chi neerub'an reh, <verse number="21" style="v" />oon ruum chi rixow wach nee ruyeew chi q'ab'iis korehtaal-oq xukansaj. Re' i aj kaansoom re' re' naa wo' rukanteesjiik, i reh re' i ma' tokoom ta ruuk' i naa rukansam naa rukansaniik ree reh, xa aha' pa' nee rureq.</para>
  <para style="p">
    <verse number="22" style="v" />Eh wila' awach i xumihnaaj i ras ruchaaq' xa chi ma' reht'al neerub'an, ma' ruum ta chi rixow wach, oon neerukut jino'q i xa chib'ih jariik chinaah ma' xata raaj chi neerub'an, <verse number="23" style="v" />oon xa chi ma' reht'al neerukut jino'q ab'aj chinaah, eh xkimik-oq ruum, eh mo'-oq i rixow wach, ma' xata raaj chi neerub'an ti' k'axik reh. <verse number="24" style="v" />Re' tinamit naa rukahniik chi jilow q'atal q'orik chinaah i naa rub'aniik reh ikaansanik ruuk' i raj ruq'ajam wach i rukimiik i awach reh, je' rukab' i ruq'or i k'uhb'aal wili. <verse number="25" style="v" />Re' taqe i tinamit naakiko'leem awach i xb'anik ikaansanik chuwach iraaj ruq'ajam wach i rukimiik i awach reh. Eh re' i naa rub'aniik ikaansanik naa wo' chik kitaq'aam reje chupaam i tinamit aha' xponik rukeb'aa' riib'. Eh ar naa ruwihiik korehtaal chik inkimik i kajaaw i k'amal kib'eeh aj tiij re' i kuxisamaj cho ruuk' i aseite.</para>
  <para style="p">
    <verse number="26" style="v" />Eh wila' xelik cho chupaam i tinamit ke'emb'al iib' i xb'anik ikaansanik. <verse number="27" style="v" />Eh wila' ma' ar chik wilik eh xkanteesjik-oq ruum awach reh i xukansaj ma' re' ta mahk i neerub'an. <verse number="28" style="v" />Eh awach i neemb'anik ikaansanik re' chik i reh neenkahnik chupaam i tinamit ke'emb'al iib'. Eh korehtaal chik inkimik i kajaaw i k'amal kib'eeh aj tiij kore' chik naa rusutiniik chupaam i rutinamiit i aj kaansoom re' re'.</para>
  <para style="p">
    <verse number="29" style="v" />Re' taqe i nuq'or taq aweh wili naa rukahniik chi jinaj k'uhb'aal cha weh taq i hat, chi keh taqe awiih aamaam, xa aha' pa' taq nee ti k'acharik, inki.</para>
  <para style="p">
    <verse number="30" style="v" />Awach i naa rukansam i ras ruch'aaq', neenq'atarik i q'orik chinaah reh i rukanteesjiik, wila' wilik k'ih-oq xiq'orik reh chi korik chi xub'an ikaansanik. Eh wila' xa jinaj ixq'orik chi xub'an ikaansanik ma' ruk'ul taj chi neenkanteesjik.</para>
  <para style="p">
    <verse number="31" style="v" />Eh ma' rub'an ta chi neentojarik ruuk' tumiin i reliik i aj kaansoom i q'atooj chik i q'orik chinaah reh i rukanteesjiik, koruman la' chi naa rukanteesjiik.</para>
  <para style="p">
    <verse number="32" style="v" />Eh wila' re' xukansaj i ras ruchaaq' xooj rukeb'aa' riib' chupaam i tinamit ke'emb'al iib', ma' nee ta rub'an chi neerutoj chi neensutinik cho chi jumehq'iil paru tinamiit, naa la' rukahniik ar korehtaal chik inkimik i kajaaw k'amal kib'eeh aj tiij.</para>
  <para style="p">
    <verse number="33" style="v" />Maa ch'uwa'reej taq wach ruuk' kaansanik i ye'aab' naa taq awihiik wii'. Ruum re' imb'anik ikaansanik i ruch'uwa'risaj paam i ye'aab'. Eh ma' nee ta i rub'an chi neerutoj riij i ko'lemb'al riib', naa la' rukanteesjiik chi riij ikaansanik xub'an.</para>
  <para style="p">
    <verse number="34" style="v" />Maa ch'uwa' risaj taq wach i ye'aab' naa taq aak'achariik wii' re' inaa nuwihiik wii' i hin, ruum re' hin i Dios naa wo' nuwihiik taq chaxilak i hat, hat taq aj Israel, inki.</para>
  <chapter number="36" style="c" />
  <para style="s">Re' wili i k'uhb'aal chi riij i ye'aab' xkehchaaj ixoq</para>
  <para style="p">
    <verse number="1" style="v" />Re' Galaad rak'uun i Maquir, re' Maquir i rak'uun i Manasés, re' i Manasés rak'uun José. Re' taqe i k'amal kib'eeh i kiih kimaam taqe re' xiooj chi q'orob'jiik i Moisés ruch'ihil i k'amal kib'eeh i aj Israel, <verse number="2" style="v" />je' wili i xkiq'or reh:</para>
  <para style="p">Re' QaJaaw Dios xuq'or aweh i hat Moisés chi konaa rusik'ariik chi riij noq naa ach'aqam qeh i ye'aab' aha' wilik i naa rukahniik qeh chi qach'uhqaal i hoj aj Israel. Eh xuq'or wo' aweh chi re' ruye'aab' naq Zelofehad i ma' tokoom ta quuk' naa ruye'ariik keh taqe i rixq'uun. <verse number="3" style="v" />Xa re' la' chik imb'anik reh wila' xkian kaxáro ruuk' i winaq aj pan tokoom ch'uq chi aj Israel, re' i ye'aab' neenkahnik keh, naa rukahniik chi ma' re' ta chik ruuk' i qa ye'aab' i hoj. Naa la' rukahniik chi re' ruuk' i kiye'aab' aha' nakianam kaxáro. Eh re' i qaye'aab' naaqehchaam i hoj ma' manlik ta chik wach neenkahnik. <verse number="4" style="v" />Eh noq naa ruponiik i haab' reh elik panti' k'axik ayu' Israel. Re' i kiye'aab' taqe i rixq'uun i Zelofehad naa rukahniik keh i jun ch'uq aha' i nakianam wii' kaxáro, ma' re' ta chik ruuk' ye'aab' reh i qach'uhqaal i hoj naa rukahniik inki taqe.</para>
  <para style="p">
    <verse number="5" style="v" />Re' Moisés xuq'or keh i aj Israel chib'ih jariik i xq'orarik reh ruum i QaJaaw Dios, je' wili i xuq'or:</para>
  <para style="p">Re' taqe i k'amal kib'eeh i ju'jun ch'uq chi riih rumaam i José rub'ehel chi je' re' inkiq'or. <verse number="6" style="v" />Re' i QaJaaw Dios xuq'or chi naa ruye'em q'ab' chi xa awach aj uuk' naa kianam kaxáro taqe i rixq'uun i Zelofehad, xa re' la' koruman chi re' wo' ruuk' i kitinamiit re' ruuk' i ruch'uhqaal i kajaaw. <verse number="7" style="v" />Eh re' i ye'aab' naakehchaam i ju'jun ch'uq chi aj Israel ma' nee ta rub'an chi neenkahnik keh i tokoom ch'uq. Chu'nchel i aj Israel inchol kik'axam i kiye'aab' chupaam i ruch'uhqaal i kitinamiit. <verse number="8" style="v" />Re' jino'q ixoq neerehchaaj i ruye'aab' inchol rub'anam kaxáro ruuk' i winaq, re' wo' ruuk' i ruch'uhqaal rutinamiit i rajaaw. Je' re' noq re' i ju'jun ch'uq chi aj Israel re' wo' chik i keh naa kehchaniik reh i ye'aab' keh chaloq i kimaam kati't. <verse number="9" style="v" />Ma' jino'q i kiye'aab' naakehchaam tokoom chik ch'uq naa rehchaniik reh. Re' ju'jun chuq chi aj Israel inchol ruk'axam i ruye'aab' aha' wilik wii' inki.</para>
  <para style="p">
    <verse number="10" style="v" />Nik' wach i xuq'or i Dios reh i Moisés je' wo' re' i xkian i rixq'uun i Zelofehad. <verse number="11" style="v" />Je' re' noq re' Maala, re' i Tirsa, re' Hogla, re' i Milcá re' i Noa, re' taqe i rixq'uun i Zelofehad kuuk' i rak'uun i kikaan xkian kaxáro. <verse number="12" style="v" />Xkian wo' kaxáro kuuk' i riih rumaam Manasés, kuuk' riih rumaam i José. Eh re' i kiye'aab' xkehchaaj xkahnik wo' hoq chi reh i ruch'uhqaal i rutinamiit i kajaaw.</para>
  <para style="p">
    <verse number="13" style="v" />Re' taqe i wili i xuq'or, i k'uhb'aal xukanaa' i QaJaaw Dios reh i Moisés, reh chi xuq'or keh i aj Israel ar wach k'ixkaab' Moab chi chii' i nim ha' Jordán chi k'ulwaach i tinamit Jericó.</para>
</usx>