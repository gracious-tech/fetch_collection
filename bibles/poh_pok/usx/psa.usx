<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="PSA" style="id">PSAPOK.SFK 24-04-2,008 Adelina Quej Xoy. Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">SALMOS</para>
  <para style="toc3">Sal</para>
  <para style="toc2">Sal</para>
  <para style="toc1">SALMOS</para>
  <para style="mt2">RE' I RUHUUJ I SALMOS</para>
  <para style="mt1">SALMOS</para>
  <chapter number="1" style="c" />
  <para style="s">Re' i xti korik laj suq kiil k'uxliis</para>
  <para style="q">
    <verse number="1" style="v" />Atoob' reh awach i ma' runimaj taj i kitaqchi' taqe i yiib' wach i kina'ojb'al,</para>
  <para style="q">ni xata ruk'am naah inki a'n taqe i aj mahk,</para>
  <para style="q">eh ma' ntzuhnik ta chi kixilak i kikaqse'lanik ree Dios.</para>
  <para style="q">
    <verse number="2" style="v" />Ruuk' la' i ruk'uhb'aal i QaJaaw Dios i ruyeew ruk'ux,</para>
  <para style="q">eh re' i re' i rutijej riij chi q'iij chi aq'ab'.</para>
  <para style="q">
    <verse number="3" style="v" />Eh re' imb'anik reh i re',</para>
  <para style="q">je' rukab' i chee' tikooj chi chii' jino'q i rooq ha'.</para>
  <para style="q">Manlik paruq'ijil inwachinik,</para>
  <para style="q">ma' jaruuj inchiqik i xaq.</para>
  <para style="q">Eh chu'nchel i rub'an i nelik korik chuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Raaj taqe i yiib' wach kina'ojb'al keh insahchik kiwach.</para>
  <para style="q">Xa je' kikab' i rutuus ixiim, jumehq'iil inkutarik reje wulu' ruum i teew.</para>
  <para style="q">
    <verse number="5" style="v" />Ruum aj re', re' taqe i yiib' wach kina'ojb'al</para>
  <para style="q">ma' naa ta kehtriik i ruk'axb'al i Dios na' b'anroq i q'ataj q'orik.</para>
  <para style="q">Eh ma' naa ta kiwihiik chi kixilak i korik wach kik'ux,</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />ruum re' taqe korik wach kik'ux re' QaJaaw Dios intoob'inik keh ruuk' inki a'n</para>
  <para style="q">Eh re' inki a'n taqe yiib' wach kina'ojb'al naa rojiik sahchoq wach.</para>
  <chapter number="2" style="c" />
  <para style="s">Re' taaq'anik naa rub'anam i Reey rusik'im wach i QaJaaw Dios</para>
  <para style="q">
    <verse number="1" style="v" />¿Chib'ih reet noq yohb'aal wach i kijosq'iil i tinamit?</para>
  <para style="q">¿Chib'ih reet noq inkiyejaa' wach rub'aan i xama' xta ruk'am chaloq?</para>
  <para style="q">
    <verse number="2" style="v" />Re' taqe i reey, taqe i aj taaq'oom wilkeeb' wach ak'al</para>
  <para style="q">inkija' wachej i QaJaaw Dios,</para>
  <para style="q">eh inkimol kiib' chub'anariik i re' ma' re' chi riij i rukuxisam, rusik'im cho wach.</para>
  <para style="q">
    <verse number="3" style="v" />Eh kow inkiq'or chi je' wili:</para>
  <para style="q">Qa a'n reh, qesaj i rajaawriik qoh rutaq'aaj wii', qesaj qiib' pan q'ab', inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Xanaah re' i QaJaaw Dios wilik chi Reyil pan taxaaj</para>
  <para style="q">xa ruse'laaj chaloq inkiq'or.</para>
  <para style="q">
    <verse number="5" style="v" />Re' reh xuyohb'isaj taqe, ruuk' ruk'aah</para>
  <para style="q">eh panaqaaw xuq'or keh chi je' wili:</para>
  <para style="q">
    <verse number="6" style="v" />Re' hin xin sik'wik wach i nuReey,</para>
  <para style="q">eh xnukoj chi Reyil chinaah i yuuq' Sión chupaam i nuSantolaj Ye'aab', inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' Reey paab'amaj, je' wili xuq'or:</para>
  <para style="q">Re' hin naa nuq'orom rib'iral i xuk'ul ruk'ux</para>
  <para style="q">i QaJaaw Dios, re' xq'orik weh chi je' wili:</para>
  <para style="q">Re' hat, hat wak'uun, eh re' hin xin ye'wik aak'achariik yu'naak.</para>
  <para style="q">
    <verse number="8" style="v" />Chapahqaaj weh i nimaq tinamit neenuyeew aweh chi akooch.</para>
  <para style="q">Nee nuq'asaj panaq'ab' chu'nchel i junsuut i wach ak'al.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hat je' naa karote ch'ihch' i naa ruwihiik</para>
  <para style="q">panaq'ab' noq naa awihiik chi taaq'anik chikinaah taqe i reey.</para>
  <para style="q">Eh je' kixerariik ak'al xun naa a'nam taqe, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' taq i hat wilkaat taq chi reyil, je' wo' taq i hat,</para>
  <para style="q">i hat taq aj taaq'oom, chareq taq chi riij taqe wili.</para>
  <para style="q">Chatijej taq chi korik i naa nuq'orom taq aweh.</para>
  <para style="q">
    <verse number="11" style="v" />Chayohleej taq wach i QaJaaw Dios.</para>
  <para style="q">Eh cha a'n taq i rukamaj chi suq suq taq ak'ux.</para>
  <para style="q">
    <verse number="12" style="v" />Chayeew taq ruloq'il i Ak'uunb'ees,</para>
  <para style="q">reh chi ma' nee ta nchalik ruk'aah,</para>
  <para style="q">eh ma' nee ta taq tikimik na'chub'an.</para>
  <para style="q">Chawik'raaj taq manqop wach i rujosq'iil taq cha naah.</para>
  <para style="b" />
  <para style="q">Atoob' keh i ruuk' Ak'uunb'ees inkiyeew i kik'ux.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' tiij xub'an i reey David pahqb'al reh i rotob'il i QaJaaw Dios</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, ma' k'isiin taqe i ki-ixowanik nuwach.</para>
  <para style="q">Eh ma' k'isiin taqe inkaaj kianam ti' k'axik weh.</para>
  <para style="q">
    <verse number="2" style="v" />Ma' k'isiin taqe i je' wili inkiq'or chi wiij:</para>
  <para style="q">Re' reh ma' jaruuj naa rukoljiik ruum i Dios, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Raaj i hat, waJaaw nuDios, re' hat ti ko'linik weh chi nujunsuut.</para>
  <para style="q">Re' hat ti ye'wik nuloq'il, re' hat ti ye'wik rukowiil nuk'ux.</para>
  <para style="q">
    <verse number="4" style="v" />Eh re' hin kow i nupahqaaj i rotob'il i QaJaaw Dios.</para>
  <para style="q">Eh re' reh kiruchaq'weej wo' chaloq parusantolaj Ye'aab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' hin kinyohkik, kinwirik,</para>
  <para style="q">kinwuktik wo' chik chi suq nuk'ux, ruum re' i QaJaaw Dios intoob'inik weh.</para>
  <para style="q">
    <verse number="6" style="v" />Je' re' noq, re' hin ma' nee ta kinkiyohb'isaj</para>
  <para style="q">atoob' ta wilik lajeeb'-oq miil neenkisutej wiij reh i nukanteesjiik.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Hat waJaaw nuDios, ti chaloq tii wuuk'. Kink'oloq ako'leej.</para>
  <para style="q">Re' hat je' naa neenasak' i panaq'kiwach i ki-ixowanik nuwach.</para>
  <para style="q">Eh je' naa neenapaxej i wachkehi yiib' wach kina'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />WaJaaw nuDios, re' hat ti ye'wik cho reh i ko'lemb'al iib'.</para>
  <para style="q">Je' re' noq qoh atoob'eej i hoj, hoj aatinamiit.</para>
  <chapter number="4" style="c" />
  <para style="s">Re' reey David xupahqaaj parutiij chi tob'joq ruum i Dios</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, waj ko'loom, kinachaq'weej tii chaloq noq neetinuq'o'reej,</para>
  <para style="q">ruum xa re' wo' hat ti esanik weh chupaam i ruti'kiil nuk'ux.</para>
  <para style="q">Je' re' noq, chaketelaaj nuwach, chab'iraj tii weh i nutiij.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Raaj taq i hat, nimaq wach ana'ojb'al i na a'n taq awiib'.</para>
  <para style="q">¿Kojaruuj taq inakanaa' rub'ajariik i nuloq'il?</para>
  <para style="q">Eh ¿Kojaruuj taq inakanaa' rusik'ariik i xama' xta</para>
  <para style="q">nokik wii', re' i xama' korik ta wo' hoq?</para>
  <para style="q">
    <verse number="3" style="v" />Eh re' taq i hat chanab'eej taq chi re' hin xusik' cho nuwach i Dios,</para>
  <para style="q">ruum korik wach nuk'ux. Eh kirib'iraj wo' noq i nupahqaaj i rotob'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Tiyo'joq taq cha kanaa' taq i mahk. Eh noq k'ahchi' taq kaat chi hi'lik wach ayokaab',</para>
  <para style="q">cha kapaaj taq riij nik' taq wach noq wilkaat.</para>
  <para style="q">
    <verse number="5" style="v" />Eh xti chaq'asaj taq awiib' chi korik laj mayiij reh i QaJaaw Dios,</para>
  <para style="q">eh chayeew taq ak'ux ruuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Eh ma' k'isiin i kiq'orik reh chi je' wili:</para>
  <para style="q">¿Awach naa ruye'wiik qeh i suq kiil k'uxliis?</para>
  <para style="q">waJaaw nuDios, suq tii qilariik cha a'n, inki taqe.</para>
  <para style="q">
    <verse number="7" style="v" />Re' hin weht'al chi re' hat ti ye'wik runimaal suq kiil i wánima,</para>
  <para style="q">ma' xata je' rukab' i rusuqkiil kik'ux i xa eliik wilik k'uxumb'al keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />WaJaaw nuDios, re' hin kinyohkik, eh kinwirik chi suq nuk'ux,</para>
  <para style="q">ruum re' hat ti ye'wik rukowiil nuk'ux panuk'achariik.</para>
  <chapter number="5" style="c" />
  <para style="s">Re' reey David xupahqaaj parutiij chi naa rutoob'jiik ruum i Dios</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, cha kuy chab'iraj tii weh i nutiij.</para>
  <para style="q">Chayeew tii weh i nupahqaaj ruuk' oq'ik.</para>
  <para style="q">
    <verse number="2" style="v" />Neeta tii nab'iraj i nupahqaaj aweh ruuk' nuchii',</para>
  <para style="q">ruum re' hat, hat nuReey, eh hat nuDios,</para>
  <para style="q">xa re' wo' hat tinuq'o'reej panutiij.</para>
  <para style="q">
    <verse number="3" style="v" />WaJaaw nuDios, re' hin kowahq'eq i nupahqaaj aweh panutiij chib'ih inwaaj,</para>
  <para style="q">eh kinab'iraj wo' hoq. Eh re' hin kinokik chi ruyub'jiik.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />NuDios, re' hat ma' nawaaj ta wach i yiib' wach na'ojb'al. Je' re' noq,</para>
  <para style="q">re' taqe i yiib' wach kib'anik ma' jaruuj naa aye'em kiye'aab' awuuk',</para>
  <para style="q">
    <verse number="5" style="v" />eh ni xata mponik chawach i nimaq kiwach inki a'n kiib'.</para>
  <para style="q">Ma' nawaaj ta kiwach i ma' holohik ta kib'anik.</para>
  <para style="q">
    <verse number="6" style="v" />Re' hat inasach kiwach i chukul q'orik.</para>
  <para style="q">Eh ma' nawaaj ta kiwach i ma' korik ta kiq'orik,</para>
  <para style="q">je' wo' taqe i kansan kas kichaaq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Eh re' hin, xa ruum chi ma' k'isiin ta xaketelaaj</para>
  <para style="q">nuwach naawokiik chupaam aSantolaj Paat.</para>
  <para style="q">Eh ar naa kaat nuloq'em ruuk' i ruyohljiik awach.</para>
  <para style="q">
    <verse number="8" style="v" />WaJaaw nuDios, chak'am nub'eeh ruuk' i korik,</para>
  <para style="q">reh chi ma' xta neekinkuchej i ki-ixowanik nuwach,</para>
  <para style="q">eh kinak'am chupaam i korik laj b'eeh.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' keh ma' korik ta kiq'orik, nujinaq chi yiib' wach na'ojb'al paam i kánima.</para>
  <para style="q">Eh re' q'orik i nelik cho pan kalaq</para>
  <para style="q">je' chuhkiil i kamnaq ma' tz'aplik ta naah i rujuleel,</para>
  <para style="q">eh aj chukul q'orik taqe.</para>
  <para style="q">
    <verse number="10" style="v" />QaJaaw Dios, chayeew taqe chutojariik i kimahk.</para>
  <para style="q">Eh maayeew q'ab' keh chi nee kielik korik.</para>
  <para style="q">Eh chaq'eb' taqe chi riij ak'ux ruum i kimahk,</para>
  <para style="q">ruum chi xatkiq'eb' wo' chi riij kik'ux i keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Eh re' taqe inkisik' ko'lemb'al kiib' awuuk' chayeew rusuqkiil kik'ux.</para>
  <para style="q">Juneliik kitz'uyinik,</para>
  <para style="q">ruum re' hat titoob'inik keh.</para>
  <para style="q">Re' kik'axwik aweh insuuqb'ik kik'ux awuum i hat.</para>
  <para style="q">
    <verse number="12" style="v" />WaJaaw nuDios, chatoob'eej tii i korik wach ruk'ux.</para>
  <para style="q">Eh je'-oq jino'q nimlaj pulato ch'ihch' chako'leej wii' ruuk' ak'axb'al.</para>
  <chapter number="6" style="c" />
  <para style="s">Re' reey David xupahqaaj i rotob'il i Dios noq wilik panti' k'axik</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, makinanaq noq k'ahchi' aajosq'iil,</para>
  <para style="q">makinayeew panti' k'axik ruum aajosq'iil.</para>
  <para style="q">
    <verse number="2" style="v" />Chaketelaaj la' tii nuwach,</para>
  <para style="q">ruum re' hin xama' xta chik rukowiil nuti'jolal,</para>
  <para style="q">xa nb'arb'otik chik ruum yab'ilaal. Jaaw, kinak'achrisaj tii weh.</para>
  <para style="q">
    <verse number="3" style="v" />Je' wo' hoq i wánima xiik' naah ti'kiil wilik. QaJaaw Dios,</para>
  <para style="q">¿Kojaruuj kinawesaj chupaam i wili?</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />QaJaaw Dios chaketelaaj tii nuwach, chako'leej i wánima,</para>
  <para style="q">eh chako'leej riij i nuk'achariik,</para>
  <para style="q">
    <verse number="5" style="v" />ruum re' i kamnaq, ma' nee ta chik tik'ulik paruk'ux.</para>
  <para style="q">Eh re' muqlik chik parujuul ma' nee ta chik i ruyeew aloq'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' hin xinq'uhtik chi oq'ik ruum rajlaal aq'ab'</para>
  <para style="q">k'ahchi' kiin chi ma' k'isa oq'ik.</para>
  <para style="q">Eh intz'aqik i nuch'itnah ruum i riis naq'nuwach.</para>
  <para style="q">
    <verse number="7" style="v" />Re' i ti' wilkiin wii' i ruq'equmrisaj paam i naq'nuwach.</para>
  <para style="q">Re' i ti' k'ahchi' nuk'ulum, kuum taqe i ki-ixowanik nuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' taq i hat, i tib'anik taq reh i yiib' wach na'ojb'al,</para>
  <para style="q">cha kanaa' taq nujot'ariik, ruum re' QaJaaw</para>
  <para style="q">xrib'iraj chik weh i nupahqaaj reh ruuk' oq'ik.</para>
  <para style="q">
    <verse number="9" style="v" />Re' QaJaaw Dios xrib'iraj chik i xnupahqaaj reh,</para>
  <para style="q">xuk'ul chik weh i nutiij.</para>
  <para style="q">
    <verse number="10" style="v" />Yu'naak taqe i ki-ixowanik nuwach yohb'aal wach i kiyo'jiik,</para>
  <para style="q">xa se'lb'al naa kikahniik wii'.</para>
  <para style="q">Eh ruum kik'ixiik naakimolom chi elik chi jumehq'iil.</para>
  <chapter number="7" style="c" />
  <para style="s">Re' reey David xupahqaaj parutiij chi re' Dios naa ruq'atwiik i q'orik</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, awuuk' i hat nuye'em nuk'ux.</para>
  <para style="q">Kinako'leej chikiwach chu'nchel i ki-ixowanik nuwach.</para>
  <para style="q">
    <verse number="2" style="v" />Ma' inwaaj tee hin chi neenkixereb'eej i nuti'jolal</para>
  <para style="q">je' rukab' i rub'an i kaq b'ahlam reh i rutiib'.</para>
  <para style="q">Ruum aj re', inwaaj chi nee kinako'leej i hat.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />WaJaaw nuDios, wila' ma' holohik i k'ahchi' kiin,</para>
  <para style="q">wila' ma' holohik i nuna'ojb'al,</para>
  <para style="q">
    <verse number="4" style="v" />eh xnub'an oon i ti' k'axik keh i wamigo.</para>
  <para style="q">Eh re' taqe i ki-ixowanik nuwach</para>
  <para style="q">ma' nik' ta xnub'an ti' k'axik keh chi ma' xta rub'ehel.</para>
  <para style="q">
    <verse number="5" style="v" />Eh wila' yiib' wach i nuna'ojb'al,</para>
  <para style="q">neerub'an chi nee kinkichop taqe i ki-ixowanik</para>
  <para style="q">nuwach nee kinkiqerej wach ak'al.</para>
  <para style="q">Eh neerub'an chi neenkiyeq' panak'al i runimaal nuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />WaJaaw nuDios, cha k'uhtaaj aajosq'iil keh</para>
  <para style="q">i yohb'aal wach i kijosq'iil chi nunaah.</para>
  <para style="q">Ruum re' hat i q'atal q'orik,</para>
  <para style="q">eh inwaaj chi neena a'n otob'il weh.</para>
  <para style="q">
    <verse number="7" style="v" />Chamol kiwach chu'nchel i tinamit.</para>
  <para style="q">Chak'uhtaaj i runimaal awajaawriik chikinaah.</para>
  <para style="q">
    <verse number="8" style="v" />WaJaaw nuDios, re' hat ti q'atwik q'orik chikinaah i tinamit.</para>
  <para style="q">Re' hat aweht'al chi re' hin korik wach nuk'ux,</para>
  <para style="q">k'oloq panak'ux chi ma' xta numahk.</para>
  <para style="q">
    <verse number="9" style="v" />Jaaw, re' hat korik wach ak'ux,</para>
  <para style="q">eh aweht'al chib'ih i wilik cho paránima,</para>
  <para style="q">parukapeb'aal i ju'jun. Eh chasach wach inki a'n i yiib' wach kina'ojb'al.</para>
  <para style="q">Eh re' i ma' xta ru mahk chawach, chatoob'eej.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' inko'linik wee hin re' Dios nim rajaawriik,</para>
  <para style="q">eh re' wo' inko'linik keh i korik wach i kánima.</para>
  <para style="q">
    <verse number="11" style="v" />Re' Dios parub'ehel inq'atwik q'orik.</para>
  <para style="q">Eh juneliik i ruq'at q'orik chikinaah i yiib' wach kina'ojb'al.</para>
  <para style="q">
    <verse number="12" style="v" />Wila' ma' xkiyot' i kik'ux chi riij i kimahk.</para>
  <para style="q">Re' Dios naa rujuk'um ruch'ihch', ruyejaam chik i ru flecha.</para>
  <para style="q">
    <verse number="13" style="v" />Re' Dios ruyejaam chik choo wach i rukanteesb'aal.</para>
  <para style="q">Eh ruuk' flecha qoplik ruq'aq'al k'ahchi' choo kitz'ehtjiik.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' i yiib' wach imb'anik, ti' wilik,</para>
  <para style="q">ruum xa re' yiib' wach na'ojb'al hamlik cho paránima.</para>
  <para style="q">Eh xa re' i chukuj q'orik i nelik choo panchii'.</para>
  <para style="q">
    <verse number="15" style="v" />Re' reh naa ruk'otom jino'q i chaamlaj jul,</para>
  <para style="q">eh chupaam i re' naa ruq'ehb'iik.</para>
  <para style="q">
    <verse number="16" style="v" />Re' yiib' wach na'ojb'al i rub'an,</para>
  <para style="q">ruch'ihil taqe ti' k'axik i rub'an keh i tokoom,</para>
  <para style="q">wach naah i reh naa rusutiniik.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Re' hin nuyeew ruloq'il i QaJaaw Dios</para>
  <para style="q">ruum parub'ehel inq'atwik q'orik.</para>
  <para style="q">Naa nutz'uyem wach i QaJaaw Dios wilik cho pan taxaaj.</para>
  <chapter number="8" style="c" />
  <para style="s">Re' ruloq'il i Dios, eh re' runimaal wach i winaq</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, xiik' naah loq'il aab'ihnaal chi junsuut i wach ak'al.</para>
  <para style="b" />
  <para style="q">Eh xayeew wo' aaloq'il chikinaah chu'nchel i wilkeeb' pan taxaaj.</para>
  <para style="q">
    <verse number="2" style="v" />Ruuk' i kitz'uuy i komanaan, eh ruuk' i kitz'uuy koch'uch' inki a'n</para>
  <para style="q">naa rutz'uyjiik nuwach,</para>
  <para style="q">reh chi neentz'ahpik kichii' i ki-ixowanik awach,</para>
  <para style="q">taqe inkaaj kianam i ti' k'axik aweh.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh noq inwilow johtoq i taxaaj xayejaa' cho ruuk' aq'ab',</para>
  <para style="q">je' wo' poh, ruch'ihil taqe ch'umiil xayejaa' chaloq,</para>
  <para style="q">
    <verse number="4" style="v" />je' wili nuq'or: ¿Chib'ih rajaawriik i winaq xasahchik wach reh chi naaketelaaj wach?</para>
  <para style="q">Eh, ¿Chib'ih reet noq ink'ulik cho panak'ux, eh ti' inawik'raaj?</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh xama' najt taj xaqasaj wach i rajaawriik i winaq chuwach i kajaawriik taqe ánjel.</para>
  <para style="q">Chi riij i re', xayeew wo' chik runimaal wach, xayeew ruloq'il.</para>
  <para style="q">
    <verse number="6" style="v" />Xayeew wo' rajaawriik chikinaah chu'nchel ayejaam taqe chaloq ruuk' aaq'ab'.</para>
  <para style="q">Eh re' hat chu'nchel xayeew chi ri'sil i rajaawriik,</para>
  <para style="q">
    <verse number="7" style="v" />re' taqe wili: tentzun, b'ooyax, chu'nchel taqe re',</para>
  <para style="q">je' wo' taqe xa chib'ih chopkaal wilkeeb' pantaq ch'ahn.</para>
  <para style="q">
    <verse number="8" style="v" />Je' wo' taqe i chikop kirupinik pan taxaaj, taqe i kar wilkeeb' chupaam i palaw,</para>
  <para style="q">eh chu'nchel i chikop wilkeeb' chupaam, xayeew chi ri'sil i rajaawriik i winaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />WaJaaw nuDios, ehchan qeh, xiik' naah</para>
  <para style="q">loq'il aab'ihnaal chi junsuut i wach ak'al.</para>
  <chapter number="9" style="c" />
  <para style="s">Re' reey David xut'iosej reh i Dios, ruum parub'ehel xub'an i q'ataj q'orik</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, naa kaat nuloq'em chu'nchel i wánima.</para>
  <para style="q">Eh naa nupuhkaam ruq'orariik taqe i xa a'n ruuk' i runimaal awajaawriik.</para>
  <para style="q">
    <verse number="2" style="v" />Awuum i hat naa nuk'erem nuchii' ruum rusuqkiil nuk'ux,</para>
  <para style="q">naa wo' nutz'uyiniik panab'ihnaal QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' taqe ki-ixowanik nuwach xi elik chikiij</para>
  <para style="q">awuum i hat, eh xasach kiwach.</para>
  <para style="q">
    <verse number="4" style="v" />Re' hat k'ahchi' kiin awuy-eem ruuk' i ruk'ul chi weh.</para>
  <para style="q">Eh xatzunaa' awiib' chupaam i loq'laj aye'aab' chuq'atariik q'orik parub'ehel.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' hat xatq'ilwik keh i ma' kinimanik taa weh.</para>
  <para style="q">Eh xasach kiwach i kib'anik reh</para>
  <para style="q">i yiib' wach na'ojb'al, xajux i kib'ihnaal chi jumpech.</para>
  <para style="q">
    <verse number="6" style="v" />Eh re' taqe i ki-ixowanik qawach,</para>
  <para style="q">re' hat xatsachwik kiwach.</para>
  <para style="q">Xasach wo' wach i kitinamiit,</para>
  <para style="q">ni xata chik naa ruq'orariik kib'iral.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' i QaJaaw Dios wilik rajaawriik chi juneliik,</para>
  <para style="q">eh xutzunaa' chik riib' paruloq'laj Ye'aab' chuq'atariik i q'orik.</para>
  <para style="q">
    <verse number="8" style="v" />Re' reh parub'ehel naa ruq'atam i q'orik chikinaah i tinamit,</para>
  <para style="q">je' wo' chikinaah i kok' tinamit.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' QaJaaw Dios inko'linik keh i neb'aa'.</para>
  <para style="q">Re' reh inko'linik keh nik' inchalik ti' k'axik chikinaah.</para>
  <para style="q">
    <verse number="10" style="v" />WaJaaw nuDios, nik' nimaal taqe i kinimanik aweh,</para>
  <para style="q">awuuk' i hat ch'iklik kik'ux, ruum re' hat</para>
  <para style="q">ma' jaruuj inakanaa' kitoob'jiik i kisik'wik aweh.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Chatz'uyej taq wach i QaJaaw Dios wilik chupaam i Ye'aab' Sión.</para>
  <para style="q">Chapuhkaaj taq ruq'orariik pantaq tinamit taqe i xub'an.</para>
  <para style="q">
    <verse number="12" style="v" />Re' QaJaaw Dios i ruketelaaj kiwach</para>
  <para style="q">i wilkeeb' panti' k'axik. Eh i ruyeew keh</para>
  <para style="q">inkipahqaaj reh. Eh i ruyeew taqe chutojariik</para>
  <para style="q">i kimahk i kib'anik ti' k'axik keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />WaJaaw nuDios, chaketelaaj tii nuwach,</para>
  <para style="q">kinawil, ruum ma' k'isiin ta nkitib'isaj nuk'ux i ki-ixowanik nuwach.</para>
  <para style="q">Eh kinako'leej chuwach i kimik.</para>
  <para style="q">
    <verse number="14" style="v" />Chi je' re', neenuq'or keh i aj Jerusaleem chi ruk'ul chi naa alooq'jiik.</para>
  <para style="q">Eh neenuq'or chi suq nuk'ux,</para>
  <para style="q">ruum hat xat ko'linik weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Re' taqe tinamit ma' kinimanik ta aweh, xkik'ot i chaamlaj jul,</para>
  <para style="q">xkiyejaa' i xirob', xa re' wo' keh xiq'ehb'ik chupaam.</para>
  <para style="q">
    <verse number="16" style="v" />Re' QaJaaw Dios xuk'uhtaaj i rukorkiil wach ruk'ux ruuk' i q'ataj q'orik xub'an.</para>
  <para style="q">Re' taqe i runimaal aj mahk xa nkikoj kixirob' chi kib'il kiib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Re' i yiib' wach kina'ojb'al, insahchik pankik'ux i Dios,</para>
  <para style="q">naa rusachariik kiwach, naakiye'ariik paruye'aab' kamnaq ruum i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Re' taqe k'axik wilkeeb' ma' naa ta rusahchiik paruk'ux i Dios.</para>
  <para style="q">Eh ma' naa ta wo' rusahchiik wach i ch'iklik reje wii' kik'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />WaJaaw nuDios, cha k'uhtaaj awajaawriik,</para>
  <para style="q">maayeew q'ab' chi neenkiq'at awach i xa winaq. Chaq'at la' q'orik chikinaah i tinamit.</para>
  <para style="q">
    <verse number="20" style="v" />WaJaaw nuDios, chayohb'isaj taqe,</para>
  <para style="q">reh chi neenkireq chi riij chi ma' xta kajaawriik, xa winaq taqe.</para>
  <chapter number="10" style="c" />
  <para style="s">Re' tiij xub'an i reey David ree rupahqaljiik i rotob'il i Dios</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, ¿Chib'ih reet noq najt wilkaat wuuk',</para>
  <para style="q">eh naakeb'aa' awiib' chi nuwach noq wilkiin panti' k'axik?</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' i yiib' wach runa'ojb'al, yohb'aal wach i rujosq'iil noq rujot' i neb'aa'.</para>
  <para style="q">Xa re' la', xa re' wo' reh naa ruq'ehb'iik chupaam i ruyejaam wach.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i yiib' wach runa'ojb'al, yohb'aal wach i rub'an riib' ruuk' i ruk'ax wach rub'aan.</para>
  <para style="q">Eh ruum i ruk'axariik wach i xa chib'ih jariik i rixowaaj wach i QaJaaw Dios.</para>
  <para style="q">
    <verse number="4" style="v" />Re' yiib' wach runa'ojb'al xa runimb'isaj chik riib'.</para>
  <para style="q">Ma' rukapaaj ta rusik'ariik i Dios, ma' xta Dios parukapeb'aal.</para>
  <para style="q">
    <verse number="5" style="v" />Eh xa re' i yiib' wach na'ojb'al i rub'an,</para>
  <para style="q">ma' runimaj taj chi re' hat tib'anik i q'ataj q'orik.</para>
  <para style="q">Eh chu'nchel i ma' naajwanik ta wach, i ruq'eb' taqe chi riij ruk'ux.</para>
  <para style="q">
    <verse number="6" style="v" />Eh i ruq'or paránima chi ma' jaruuj naa ruq'ehb'iik,</para>
  <para style="q">eh chi ma' jaruuj naa ruwihiik ruk'axkiil.</para>
  <para style="q">
    <verse number="7" style="v" />Re' reh xa re' i ma' tob'laj q'orik</para>
  <para style="q">i nelik cho panchii', chukuj q'orik, b'ajooj taqe.</para>
  <para style="q">Xa re' i ti'laj q'orik i ruq'or, ma' holohik ta k'isinoq inq'orik.</para>
  <para style="q">
    <verse number="8" style="v" />Xa rusik' chik ruye'aab', xa panke'lik i rukansaj</para>
  <para style="q">taqe i ma' xta kimahk patim taqe panab'iix.</para>
  <para style="q">Eh ma' ruketelaaj ta kiwach i ma' kichol ta ruko'ljiik kiib'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' reh i rub'an je' rukab' i rub'an i kaq b'ahlam,</para>
  <para style="q">i rukeb'aa' riib' chi ruchopariik awach iraaj ruchopom.</para>
  <para style="q">Eh noq ki-ik'ik chuwach, i rukut riib' chinaah inkahnik pan q'ab'.</para>
  <para style="q">
    <verse number="10" style="v" />Re' reh xa rupach'aa' chik riib' noq i rutik'aa' jot'ooj.</para>
  <para style="q">Eh ma' k'isiin taqe i ma' nkian ta ruko'ljiik kiib' kiq'ehb'ik pan q'ab'.</para>
  <para style="q">
    <verse number="11" style="v" />Eh i rukapaaj chi re' Dios sahchinaq taqe paruk'ux,</para>
  <para style="q">eh chi ma' rilom ta taqe ma' inki a'n ta ruko'ljiik kiib'.</para>
  <para style="q">
    <verse number="12" style="v" />WaJaaw nuDios,</para>
  <para style="q">chayeew aq'ab' chikinaah i ti' wilkeeb'. Mansahchik taqe panak'ux.</para>
  <para style="q">
    <verse number="13" style="v" />WaJaaw nuDios, ¿Chib'ih reet noq xa ti rukaqse'laaj i yiib' wach runa'ojb'al?</para>
  <para style="q">Irukapaaj i reh chi ma' jaruuj q'iij naa apahqaam reh chib'ih i xub'an.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' hat inawilow i rub'an,</para>
  <para style="q">re' hat nee ti ye'wik jilow reh.</para>
  <para style="q">Ruum xa re' wo' hat neetiko'linik keh i ma' nkian ta ruko'ljiik kiib',</para>
  <para style="q">je' wo' taqe i ma' xta kituut kajaaw.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Chawesaj i rajaawriik imb'anik reh i yiib' wach na'ojb'al.</para>
  <para style="q">Chayeew chutojariik i ru mahk, korehtaal i rutoj wach chu'nchel i rub'an.</para>
  <para style="q">
    <verse number="16" style="v" />Re' QaJaaw Dios, Reey chi juneliik,</para>
  <para style="q">re' i ma' kinimanik ta reh naa resam taqe reje chi kixilak i rutinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />WaJaaw nuDios, re' hat inab'iraj</para>
  <para style="q">i kitiij i ma' nimaq ta kiwach,</para>
  <para style="q">eh i nayeew keh inkipahqaaj aweh.</para>
  <para style="q">Eh nayeew rukowiil kik'ux.</para>
  <para style="q">
    <verse number="18" style="v" />Eh chatoob'eej taqe i ma' xta kituut kajaaw,</para>
  <para style="q">je' wo' taqe i k'ahchi' kik'teesjiik chi ti' k'axik,</para>
  <para style="q">reh chi re' yiib' wach runa'ojb'al nee rukanaa' i jot'ooj, ruum xa winaq wo' hoq.</para>
  <chapter number="11" style="c" />
  <para style="s">Re' reey xti xuyeew ruk'ux ruuk' i QaJaaw</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin re' i QaJaaw Dios inko'linik weh,</para>
  <para style="q">xama' xta nkih chi neenkiq'or weh:</para>
  <para style="q">Hiy chakeb'aa' awiib' ju' taq yuuq' je' akab' chikop inrupinik.</para>
  <para style="q">
    <verse number="2" style="v" />Re' taqe yiib' wach kina'ojb'al</para>
  <para style="q">xa nkikoj chik chaloq i q'as ju' kanteesb'al</para>
  <para style="q">chupaam i ruk'ahamil i kiflecha.</para>
  <para style="q">Eh xa panke'lik inkikansaj i korik wach kik'ux.</para>
  <para style="q">
    <verse number="3" style="v" />Eh na' ohoq sahchoq wach i raa' ri'sil i k'uhb'aal,</para>
  <para style="q">¿Chib'ih chik naa rub'anam i korik wach ruk'ux? inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Xanaah re', re' keh ma' nkikoj taj rehtaal chi re' Dios</para>
  <para style="q">xa wilik wo' chaloq parusantolaj ye'aab'.</para>
  <para style="q">Ar wilik chi taaq'anik pan taxaaj, eh i rilow chaloq chib'ih i rub'an i ju'jun.</para>
  <para style="q">
    <verse number="5" style="v" />Re' QaJaaw Dios i rucha'jeej i korik wach ruk'ux.</para>
  <para style="q">Eh re' imb'anik reh i yiib' wach na'ojb'al, imb'anik reh i ti' k'axik,</para>
  <para style="q">ma' raaj ta wach.</para>
  <para style="q">
    <verse number="6" style="v" />Eh naa ruye'em i ti' k'axik chikinaah i yiib' wach kina'ojb'al,</para>
  <para style="q">naakik'ahtiik ruuk' asufre. Eh naa ruye'em</para>
  <para style="q">i tz'a'laj teew k'atb'al keh chi tojb'al kimahk.</para>
  <para style="q">
    <verse number="7" style="v" />Re' QaJaaw Dios korik wach ruk'ux, imponik chuwach i korik.</para>
  <para style="q">Ruum aj re', re' korik wach ruk'ux naa rilom wach ruuk' naq'wach.</para>
  <chapter number="12" style="c" />
  <para style="s">Re' reey David xupahqaaj i rotob'il i Dios</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, qoh ako'leej, ruum ma' jino'q chik i korik wach rik'ux chi nimanik.</para>
  <para style="q">Eh ma' awach ta chik jino'q i korik inq'orik.</para>
  <para style="q">
    <verse number="2" style="v" />Xak'ul chik inkichuk i q'orik chikiwach, re' inkiq'or xak'ul inki a'n kiwach ruuk'.</para>
  <para style="q">Xa ma' xta rub'ehel kiq'orik.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />WaJaaw nuDios, chasach kiwach i xak'ul inki a'n kiwach,</para>
  <para style="q">re' taqe i nimaq kiwach inki a'n kiib',</para>
  <para style="q">
    <verse number="4" style="v" />re' taqe i kiq'orik reh chi je' wili: Re' hoj qohchol q'orik chi qib'il qiib',</para>
  <para style="q">ruuk' qachii' neenqako'leej qiib'. Eh ma' awach ta neenq'ilwik qeh, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' taqe ma' xta rukowiil kik'ux</para>
  <para style="q">k'ahchi' kik'teesjiik chi ti' k'axik.</para>
  <para style="q">Re' taqe i k'axik wilkeeb' inkik'er</para>
  <para style="q">kichii' chi oq'ik ruum aj re',</para>
  <para style="q">re' hin naa nutob'eem taqe</para>
  <para style="q">je' rukab' i ruk'ul chi keh, inki.</para>
  <para style="q">
    <verse number="6" style="v" />Re' ruq'oral i QaJaaw Dios xti korik, eh saq wach.</para>
  <para style="q">Je' rukab' i plata saq wach,</para>
  <para style="q">wuquub' pech saqb'isamaj wach pan q'aaq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />WaJaaw nuDios, re' hat neeticha'jinik qeh chi juneliik.</para>
  <para style="q">Eh nee qoh ako'leej chikiwach i tinamit yiib' wach i kina'ojb'al,</para>
  <para style="q">
    <verse number="8" style="v" />ruum re' keh xak'ul chik kiooj chi jot'ooj.</para>
  <para style="q">Eh chu'nchel i tinamit kiye'wik runimaal wach i kiyiib' wach na'ojb'al.</para>
  <chapter number="13" style="c" />
  <para style="s">Re' reey David xupahqaaj i rotob'il i Dios noq wilik panti' k'axik</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, ¿Ko jaruuj kink'ulik</para>
  <para style="q">cho panak'ux? ¿Mi xinsahchik panak'ux</para>
  <para style="q">chi jumpech re'? ¿Nik' chik najtiil</para>
  <para style="q">naa kaat wuy-eem chi nee kinatoob'eej?</para>
  <para style="q">
    <verse number="2" style="v" />¿Ko nik' chik najtiil naa rutib'iik</para>
  <para style="q">i wánima ruum i ti' k'axik k'ahchi' nuk'ulum?</para>
  <para style="q">¿Kojaruuj i numay chi ntz'irik nuwach eqal eqal?</para>
  <para style="q">Eh ¿kojaruuj kinako'leej pan q'ab' inixowanik nuwach?</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Wajaaw nuDios, kinawilow, kinab'iraj tii.</para>
  <para style="q">Chasaquumb'isaj paam i naq'nuwach, reh chi ma' nee ta nchalik i kimik chi nunaah.</para>
  <para style="q">
    <verse number="4" style="v" />Reh chi re' inixowanik nuwach, ma' nee ta ruq'or chi xub'an weh.</para>
  <para style="q">Reh chi ma' nee ta wo' insuuqb'ik kik'ux taqe i ruk'u'liil inixowanik nuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />WaJaaw nuDios, re' hin ch'iklik nuk'ux chi naa aketelaam cho nuwach.</para>
  <para style="q">Naa rusuuqb'iik i wánima, ruum re' hat naa ako'liniik weh.</para>
  <para style="q">
    <verse number="6" style="v" />Re' hin naa nutz'uyem awach, Jaaw,</para>
  <para style="q">ruum xayeew cho weh chi manlik aawotob'il.</para>
  <chapter number="14" style="c" />
  <para style="s">Re' i yiib' wach na'ojb'al inki a'n i ma' kinimanik ta ree Dios</para>
  <para style="q">
    <verse number="1" style="v" />Re' taqe i ma' kinimanik taj inkiq'or</para>
  <para style="q">chi ma' xta Dios.</para>
  <para style="q">Chi kunchelaal xkiq'eb' kiib', xa re' chik i yiib' wach inki a'n</para>
  <para style="q">Ma' awach ta jino'q i korik wach ruk'ux, jinaj ta naq reje.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw Dios kopan taxaaj</para>
  <para style="q">i rilow chaloq i tinamit</para>
  <para style="q">mi wilik jino'q chi kixilak i wilik</para>
  <para style="q">runa'ojb'al reh chi nee nimjik i reh.</para>
  <para style="q">
    <verse number="3" style="v" />Xa re' la' chi kunchelaal xiooj chupaam i yiib' wach b'eeh.</para>
  <para style="q">Xkiq'eb' kiib'.</para>
  <para style="q">Ma' awach ta' keh imb'anik reh i holohik laj na'ojb'al,</para>
  <para style="q">jinaj ta naq reje.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh ma' xta kina'ojb'al, ma' holohik ta kib'anik,</para>
  <para style="q">inkik'ux i nutinamiit, je' nk'uxarik kaxlanwi'k inki a'n</para>
  <para style="q">Eh ma' nkikapaaj ta kitiij, inki.</para>
  <para style="q">
    <verse number="5" style="v" />Re' keh naakib'arb'otiik ruum kiyo'jiik,</para>
  <para style="q">ruum re' QaJaaw Dios naa rutoob'iniik keh i korik wach kik'ux.</para>
  <para style="q">
    <verse number="6" style="v" />Re' keh inkikaqse'laaj, inki a'n i xama' nimaq ta kiwach,</para>
  <para style="q">xanaah re', re' QaJaaw Dios naa rutoob'iniik kee keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Ar Sión ta naq nee rutaq'aaj chaloq i Dios i ko'lemb'al kiib' i aj Israel.</para>
  <para style="q">Re' noq naa resam taqe chaloq pan tokoom tinamit,</para>
  <para style="q">nee naq insuuqb'ik kik'ux i aj Israel, re' taqe i riih rumaam i Jacob.</para>
  <chapter number="15" style="c" />
  <para style="s">Re' i naa rub'anam ookik chupaam i ru santo laj Ye'aab' i Dios</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, ¿Awach i neerub'an i okik pan asanto laj Paat?</para>
  <para style="q">¿Awach i neerub'an i wihik pan aSanto laj Ye'aab'?</para>
  <para style="q">
    <verse number="2" style="v" />Re' i ma' xta ruch'uwa'iil wach i ránima,</para>
  <para style="q">re' i holohik runa'ojb'al, eh i ruq'or i korik chu'nchel ruk'ux,</para>
  <para style="q">
    <verse number="3" style="v" />re' i ma' xtaj i yiib' wach i ruq'or chi riij i ras ruchaaq',</para>
  <para style="q">re' i ma' rujot' taj i ramigo,</para>
  <para style="q">ni xata rub'aj i ruka'jaah ruk'ula't,</para>
  <para style="q">
    <verse number="4" style="v" />re' i ma' najwaan ta wach imb'anik reh i mahk,</para>
  <para style="q">eh i ruyeew ruloq'il awach inye'wik ruloq'il i Dios,</para>
  <para style="q">re' imb'anik reh i ruq'or i ruk'uhb'aal i QaJaaw atoob' ta ti' neenik'ik ruum,</para>
  <para style="q">
    <verse number="5" style="v" />re' i ma' rupahqaaj ta tojb'al riij i rutumiin,</para>
  <para style="q">re' i ma' ruk'ul taj i tumiin chi jot'b'al reh i ma' xta ru mahk,</para>
  <para style="b" />
  <para style="q">eh re' imb'anik reh taqe re' ma' jaruuj naa ruq'ehb'iik pamahk.</para>
  <chapter number="16" style="c" />
  <para style="s">Re' i kooch xiik' naah chihojal</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, kinacha'jeej tii,</para>
  <para style="q">ruum xa awuuk' wo' hat inusik' ko'lb'al wiib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Aweh hat nuq'orom chi je' wili:</para>
  <para style="q">Xa re' wo' hat i waJaaw.</para>
  <para style="q">Eh ma' awach ta chik jino'q i q'e' atoob' wuuk' chi je' rukab' i hat, kinki.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' taqe korik wach kik'ux chunimjiik i Dios,</para>
  <para style="q">i wilik kisantohiil ayu' wach ak'al, re' re' kiye'wik rusuqkiil nuk'ux.</para>
  <para style="q">
    <verse number="4" style="v" />Eh q'e' ti' i naakik'ulum</para>
  <para style="q">taqe ikiloq'inik reh taqe i xa tiyoox.</para>
  <para style="q">Eh re' hin ma' jaruuj neenuyeew chi numayiij</para>
  <para style="q">i rukik'eel chikop chikiwach taqe i kitiyoox,</para>
  <para style="q">ni xata neenuyeew kiloq'il ruuk' nuchii'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />WaJaaw nuDios, re' hat ti ye'wik weh chib'ih jariik inwaaj.</para>
  <para style="q">Eh i nayeew weh chi manlik aawotob'il,</para>
  <para style="q">panaq'ab' wilik i nuk'achariik.</para>
  <para style="q">
    <verse number="6" style="v" />Q'e' holohik xinelik, ruum xiik' naah holwochiil i nuye'aab' xayeew,</para>
  <para style="q">eh xiik' naah chihojal i nukooch xayeew weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Eh re' hin naa nuloq'em i QaJaaw Dios, ruum re' reh ink'amwik nub'eeh.</para>
  <para style="q">Eh xti rukoj nuna'ojb'al atoob' ta pantaq chaq'ab' wilkiin.</para>
  <para style="q">
    <verse number="8" style="v" />Re' hin eliik k'ahchi' wilom wach i waJaaw ma' hin ta rukanaam,</para>
  <para style="q">xa eliik k'ahchi' kiin rutob'eem, reh chi ma' xta neenyojwik nuk'ux.</para>
  <para style="q">
    <verse number="9" style="v" />Ruum aj re', re' wánima, re' nuti'jolal, i nukapeb'aal xiik' naah suq kiil kik'ux.</para>
  <para style="q">Ruum xa ruuk' chik i Dios naa nuye'em nuk'ux.</para>
  <para style="q">
    <verse number="10" style="v" />Re' hat waJaaw ma' naa ta akanaam i nuti'jolal panjul, naa la' awuksam chaloq.</para>
  <para style="q">Eh ma' naa ta wo' aye'em q'ab' chi</para>
  <para style="q">naa ruq'ahiik panjul i ruti'jolal i Santolaj Awak'uun.</para>
  <para style="q">
    <verse number="11" style="v" />Re' hat naa ak'uhtaniik weh i rub'eeh i juneliik k'acharik.</para>
  <para style="q">Eh wilik jinaj i runimaal rusuqkiil nuk'ux,</para>
  <para style="q">ruum xa awuuk' wo' hat wilik i rusuqkiil k'uxliis reh juneliik.</para>
  <chapter number="17" style="c" />
  <para style="s">Re' reey David xupahqaaj parutiij chi naa rutoob'jiik ruum i Dios</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, chab'iraj tii weh i naa nupahqaam aweh ruuk' rub'ehel.</para>
  <para style="q">Xti kinab'iraj tii weh i panutiij,</para>
  <para style="q">ruum re' hin ma' awach tee nujot' ruuk' nuchii'.</para>
  <para style="q">
    <verse number="2" style="v" />Kinako'leej chikiwach i tinamit,</para>
  <para style="q">ruum re' hat aweht'al chi korik wach nuk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' hat aweht'al chik paam i wánima, kink'ulik aawula'eej chaq'ab'.</para>
  <para style="q">Eh xinanik'eej ruuk' i nunimaniik,</para>
  <para style="q">ma' xtaj i yiib' wach xareq pan wánima.</para>
  <para style="q">Eh ma' jino'q i yiib' wach q'orik i nelik panuchii'.</para>
  <para style="q">
    <verse number="4" style="v" />Ruum chi k'ahchi' nunimam aak'uhb'aal,</para>
  <para style="q">ma' nuk'am ta naah i yiib' wach na'ojb'al</para>
  <para style="q">inki a'n i kib'anik i ti' k'axik.</para>
  <para style="q">
    <verse number="5" style="v" />Re' hin k'ahchi' nuk'amam naah aab'eeh.</para>
  <para style="q">Eh ma' naa ta chik nukanaam chi jumpech.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />WaJaaw nuDios, re' hat k'ahchi' kaat nuq'o'reem panutiij,</para>
  <para style="q">ruum weht'al chi nee kinachaq'weej. Je' re' noq, chab'iraj tii i nuq'oral.</para>
  <para style="q">
    <verse number="7" style="v" />Chaketelaaj tii nuwach ruuk' i runimaal aak'axb'al,</para>
  <para style="q">ruum re' hat inako'leej taqe i awuuk' i hat inkisik' ko'lemb'al kiib',</para>
  <para style="q">inako'leej taqe chikiwach i aj ixowan keh.</para>
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios, kinako'leej tii, je'-oq kinko'ljik rutiyoxil i naq'awach cha a'n weh.</para>
  <para style="q">Eh je'-oq ruuk' aaxiik' kinamoh-eej,</para>
  <para style="q">
    <verse number="9" style="v" />Re' taqe i yiib' wach kina'ojb'al k'ahchi' kiin kik'sam chi ti' k'axik.</para>
  <para style="q">Re' taqe i ki-ixowanik nuwach xa nkaaj chik kinkikansam.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' taqe re' ma' xta ketelinik wachiis kuuk'.</para>
  <para style="q">Xa nimaq chik kiwach inki a'n kiib' ruuk' i kiq'oral.</para>
  <para style="q">
    <verse number="11" style="v" />Xak'ul chik kiooj chi nusik'ariik, xa kok' taq chik ma' kinkichop.</para>
  <para style="q">Eh k'ahchi' kisik'im chi riij nik' wach noq naa kianam weh.</para>
  <para style="q">
    <verse number="12" style="v" />Xa je' chik kikab' i kaq b'ahlam</para>
  <para style="q">noq kinkaaj kiinkichopom,</para>
  <para style="q">eh je' rukab' inki a'n i kok' rak'uun kaq b'ahlam noq inkuy-eej i kitiib' pan kijuul.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />WaJaaw nuDios, kinab'iraj tii,</para>
  <para style="q">cha a'n keh yiib' wach kina'ojb'al,</para>
  <para style="q">chawesaj i kajaawriik.</para>
  <para style="q">Kinako'leej pan kiq'ab' ruuk' awajaawriik.</para>
  <para style="q">
    <verse number="14" style="v" />WaJaaw nuDios, ruuk' awajaawriik kinako'leej</para>
  <para style="q">chikiwach taqe i xa reh ayu' wach ak'al inki a'n</para>
  <para style="q">Eh inkaaj chi nee kib'ehomrik</para>
  <para style="q">korehtaal inkinujisaj kiib',</para>
  <para style="q">je' chi kak'uun chi kixq'uun, chi kiih chi kimaam.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Raaj i hin, ruum chi korik wach nuk'ux,</para>
  <para style="q">naawilom awach ruuk' naq'nuwach.</para>
  <para style="q">Eh ma' k'isiin ta naa rusuuqb'iik nuk'ux</para>
  <para style="q">noq naawilom chi awuuk' chik wilkiin ar pan taxaaj.</para>
  <chapter number="18" style="c" />
  <para style="s">Re' reey David xutz'uyej wach i Dios ruum xko'ljik chuwach i aj ixowaal</para>
  <para style="r">(<ref loc="2SA 22:1-51">2 Sam 22.1-51</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, re' hin q'e' ti nuk'ax,</para>
  <para style="q">ruum re' hat ti ye'wik rukowiil nuk'ux.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hat titoob'inik ti ko'linik,</para>
  <para style="q">ti esanik weh panti' k'axik: Hat nuDios ye'el rukowiil nuk'ux</para>
  <para style="q">hat saq rehp ab'aj,</para>
  <para style="q">hat pulato ch'ihch' ko'lb'al iib' chi weh.</para>
  <para style="q">Hat najt naah paat ko'lemb'al iib' chi weh.</para>
  <para style="q">
    <verse number="3" style="v" />Ruum aj re', re' hat Jaaw, xti ruk'ul chi naa alooq'jiik.</para>
  <para style="q">Eh noq tinuq'o'reej, kinako'leej chikiwach i ki-ixowanik nuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' keh xa kikotik naq chik chi wiij ree nukanteesjiik.</para>
  <para style="q">Xchalik wo' naq nuyo'jiik, ruum i yohb'aal wach inkansanik.</para>
  <para style="q">
    <verse number="5" style="v" />Re' aj kansaneel xa rukotem naq chik wiij.</para>
  <para style="q">Xa ma' ha' ta naq chik inuko'leej wiib' chuwach i kimik.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Eh noq wilkiin pan i ti' k'axik,</para>
  <para style="q">xnuq'o'reej i QaJaaw Dios.</para>
  <para style="q">Re' reh xirib'iraj wo' chupaam i rusantolaj Ye'aab' re'</para>
  <para style="q">i xnupahqaaj reh xirib'iraj wo' hoq.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Eh re' QaJaaw Dios ruum i rujosq'iil,</para>
  <para style="q">je' naa jinaj kowlaj yihk i xuyeew chaloq.</para>
  <para style="q">Eh je' naa xuk'u'yisaj aak'al, je' naa xrisaj taqe paruye'aab' i yuuq' k'ixkaab'.</para>
  <para style="q">
    <verse number="8" style="v" />Re' reh je' naa xelik chaloq i sib' panju'. Je' naa xaq q'aaq'.</para>
  <para style="q">Eh je' naa naq'wach q'aaq' i xelik cho panchii',</para>
  <para style="q">sachb'al kiwach i yiib' wach kina'ojb'al.</para>
  <para style="q">
    <verse number="9" style="v" />Re' QaJaaw Dios xchalik chi nutoob'jiik je' naax teh chii' i taxaaj.</para>
  <para style="q">Je' naa q'eq suutz' i wilik ri'si rooq.</para>
  <para style="q">
    <verse number="10" style="v" />Re' reh je' naa chinaah i ruxiik' i ánjel xuyeew cho riib'.</para>
  <para style="q">Eh xqajik cho panteew chinaah i wach ak'al.</para>
  <para style="q">
    <verse number="11" style="v" />Eh je' wo' namuqlik chupaam i q'equm paam suutz',</para>
  <para style="q">re' ruuk' i q'eq suutz' jab' i ruk'am chaloq.</para>
  <para style="q">
    <verse number="12" style="v" />Ruum i rusaqumaal chii' wach, re' je' q'eq suutz' xusutej chi saqb'och.</para>
  <para style="q">Eh xusutej wo' chi je' naq'wach q'aaq' qoplik ruq'aq'al xuyeew chaloq.</para>
  <para style="q">
    <verse number="13" style="v" />Re' QaJaaw Dios wilik cho pan taxaaj xub'an chaloq i je' kahoq.</para>
  <para style="q">Eh xuyeew chaloq i je' saqb'och,</para>
  <para style="q">je' naq'wach q'aaq' qoplik ruq'aq'al.</para>
  <para style="q">
    <verse number="14" style="v" />Re' reh je' naa flecha, je' naa kahoq ixukut cho chikinaah i ki-ixowanik nuwach.</para>
  <para style="q">Eh ruum i re' xkitukej kiib'.</para>
  <para style="q">
    <verse number="15" style="v" />Re' i je' palaw wilik naq chi nujunsuut, je' naa xb'iq'arik qohoq ruum i ak'al,</para>
  <para style="q">xa tehlik chik wach aak'al xkahnik. Je' re' xkahnik,</para>
  <para style="q">ruum kow xq'orik chaloq i QaJaaw Dios ruum rujosq'iil,</para>
  <para style="q">eh xuhupej taqe chaloq.</para>
  <para style="q">
    <verse number="16" style="v" />Re' QaJaaw Dios kopan taxaaj xuyeew</para>
  <para style="q">chaloq i q'ab' chi nunaah ree nuko'ljiik,</para>
  <para style="q">paruchamiil palaw xink'ulik resaj.</para>
  <para style="q">
    <verse number="17" style="v" />Xiruko'leej pan q'ab' inixowanik nuwach, je' wo'</para>
  <para style="q">pan kiq'ab' chu'nchel i ki-ixowanik nuwach,</para>
  <para style="q">atoob' ta q'e' wo' naq kow kiib' chi nuwach i hin.</para>
  <para style="q">
    <verse number="18" style="v" />Eh noq wilkiin panti' k'axik,</para>
  <para style="q">xinkaaj naq kinkikansam.</para>
  <para style="q">Xa re' chik i QaJaaw Dios xko'linik weh.</para>
  <para style="q">
    <verse number="19" style="v" />Xiresaj panti' k'axik wilkiin naq wii'.</para>
  <para style="q">Eh xi ruko'leej, ruum q'e' kiruk'ax.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Re' QaJaaw Dios je' re' nuk'axariik xub'an,</para>
  <para style="q">ruum korik wach nuk'ux. Xuyeew jilow weh,</para>
  <para style="q">ruum i rilow chi ma' xta ruch'uwa'iil wach i wánima.</para>
  <para style="q">
    <verse number="21" style="v" />Ruum re' hin k'ahchi' nuk'amam chi korik i rub'eeh.</para>
  <para style="q">Eh ma' k'ahchi' ta nuq'eb'em wiib' pamahk chuwach.</para>
  <para style="q">
    <verse number="22" style="v" />Re' hin wilik pan wánima chu'nchel i ruk'uhb'aal i QaJaaw Dios.</para>
  <para style="q">Ma' nik' ta xnukanaa' rub'aan taqe i ruq'or.</para>
  <para style="q">
    <verse number="23" style="v" />Re' hin korik wach nuk'ux chuwach nukanaam</para>
  <para style="q">chik chu'nchel i yiib' wach chi b'anarik,</para>
  <para style="q">
    <verse number="24" style="v" />je' re' noq, re' QaJaaw Dios xuyeew jilow weh i rukorkiil wach nuk'ux,</para>
  <para style="q">ruum ma' xta ruch'uwa'iil wach i wánima chuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />WaJaaw nuDios, re' hat q'e' naaketelaaj wach imb'anik ketelenik wachiis.</para>
  <para style="q">Eh korik wach ak'ux ruuk' imb'anik reh i korik.</para>
  <para style="q">
    <verse number="26" style="v" />Re' hat inatob'eej i korik wach ruk'ux.</para>
  <para style="q">Eh i nayeew aajosq'iil chinaah i yiib' wach runa'ojb'al.</para>
  <para style="q">
    <verse number="27" style="v" />Re' hat inako'leej i tinamit k'ahchi' rub'aan ti' k'axik keh.</para>
  <para style="q">Eh inawesaj i kajaawriik i xa nimaq chik kiwach inki a'n kiib'.</para>
  <para style="q">
    <verse number="28" style="v" />WaJaaw nuDios, re' hat xayeew chik cho weh i manlik saqum.</para>
  <para style="q">Xinawesaj chik chaloq chupaam i q'equm.</para>
  <para style="q">
    <verse number="29" style="v" />Eh naa kiin atoob'eem, reh chi neenuq'at kiwach i ki-ixowanik nuwach.</para>
  <para style="q">Nik' ta naq wach i q'atb'al weh neenkikoj, neenub'an keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Re' rub'eeh i QaJaaw Dios xti korik,</para>
  <para style="q">re' i ruq'or rib'iral chi naa ruye'em qeh,</para>
  <para style="q">nee wo' ruyeew. Eh i ruko'leej taqe awach i kiye'em kik'ux ruuk'.</para>
  <para style="q">
    <verse number="31" style="v" />Je' re' noq, ma' jino'q chik Dios chi je' rukab' i qaDios,</para>
  <para style="q">ruum ma' xta chik jino'q Dios neenko'linik qeh je' rukab' i qako'ljiik i rub'an i reh.</para>
  <para style="q">
    <verse number="32" style="v" />Re' QaJaaw Dios inye'wik wajaawriik.</para>
  <para style="q">Eh re' reh ink'amwik weh chupaam i korik laj b'eeh.</para>
  <para style="q">
    <verse number="33" style="v" />Re' reh inye'wik nukowiil reh chi ma' xta neenuk'ul.</para>
  <para style="q">Xa atoob' ta neenub'an weh ajiim ju' taq yuuq'</para>
  <para style="q">je' rukab' i rub'an i keej, xama' xta wo' neenuk'ul.</para>
  <para style="q">
    <verse number="34" style="v" />Re' reh inye'wik nuna'ojb'al chi q'aq'inik.</para>
  <para style="q">Re' reh inye'wik waansil chi rukutariik</para>
  <para style="q">i flecha q'an ch'ihch' ruyej-aal.</para>
  <para style="q">
    <verse number="35" style="v" />WaJaaw nuDios, re' hat ticha'jinik ti ko'linik weh.</para>
  <para style="q">Eh ruuk' awajaawriik kinatoob'eej chaloq,</para>
  <para style="q">eh ruum aak'axb'al xinelik korik.</para>
  <para style="q">
    <verse number="36" style="v" />Re' hat kinatoob'eej, xti xateh i nub'eeh chi korik.</para>
  <para style="q">Eh ma' xta kinkalojik wii'.</para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" />Re' hin xtohq'ik taqe nusik'im i ki-ixowanik nuwach,</para>
  <para style="q">eh xnureq wo' taqe.</para>
  <para style="q">Eh ma' xnukanaa' ta chik taqe korehtaal xnub'an keh.</para>
  <para style="q">
    <verse number="38" style="v" />Noq xnub'an keh xiq'ehb'ik wach ak'al</para>
  <para style="q">ma' kota chik xi wuktik, eh ma' xkikuy ta k'isinoq waansil.</para>
  <para style="q">
    <verse number="39" style="v" />Re' hat xayeew wajaawriik chi naa nub'anam keh.</para>
  <para style="q">Eh xawesaj i kajaawriik i ki-ixowanik nuwach,</para>
  <para style="q">reh chi ma' xkikuy taj i waansil.</para>
  <para style="q">
    <verse number="40" style="v" />Re' hat xaq'asaj taqe panuq'ab' i ki-ixowanik nuwach,</para>
  <para style="q">korehtaal xnusach kiwach chi kunchelaal.</para>
  <para style="q">
    <verse number="41" style="v" />Noq xkipahqaaj naq kitoob'jiik, ma' awach ta xtoob'inik keh.</para>
  <para style="q">Eh noq xkipahqaaj naq kitoob'jiik reh i QaJaaw Dios,</para>
  <para style="q">xama' xiko'ljik ta wo' hoq.</para>
  <para style="q">
    <verse number="42" style="v" />Re' hin xnusach kiwach je' rukab'</para>
  <para style="q">noq insahchik wach i pooq panteew.</para>
  <para style="q">Eh xnuye'q'eb'eej taqe pan wooq</para>
  <para style="q">je' rukab' imb'aan reh i ch'uwa' pamb'eeh.</para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" />WaJaaw nuDios, re' hat xinako'leej pan kiq'ab' i tokoom tinamit ma' kinimanik taa weh.</para>
  <para style="q">Eh xinakoj chi ajaab'esil chikinaah i tinamit.</para>
  <para style="q">Eh xinkitob'eej i tinamit ma' weht'al ta naq kiwach.</para>
  <para style="q">
    <verse number="44" style="v" />Noq inkib'iraj i nuq'or keh, inkinimaj wo' hoq.</para>
  <para style="q">Re' taqe i tokoom tinamit xkaaj wo' hoq chi re' chik i hin xin taaq'anik keh.</para>
  <para style="q">
    <verse number="45" style="v" />Re' keh xk'isimb'ik kik'ux.</para>
  <para style="q">Eh xakib'arb'otik chik ruum kiyo'jiik,</para>
  <para style="q">noq xi elik chaloq aha' kikeb'aam wii' kiib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="46" style="v" />Xti k'achlik i QaJaaw Dios. Loq'imaj ta naq, ruum</para>
  <para style="q">jinaj paat ab'aj ko'lemb'al iib' chi weh.</para>
  <para style="q">Neeta naq inye'arik runimaal wach i nuDios waj Ko'loom.</para>
  <para style="q">
    <verse number="47" style="v" />Re' reh i Dios, re' inq'ajwik wach imb'aan weh.</para>
  <para style="q">Re' reh xkojwik weh chi ajaab'esil chikinaah i tinamit.</para>
  <para style="q">
    <verse number="48" style="v" />Re' reh inko'linik weh pan kiq'ab' i ki-ixowanik nuwach,</para>
  <para style="q">re' taqe i xti xkaaj naq kianam weh.</para>
  <para style="q">Re' wo' xko'linik weh pan q'ab' i winaq xti wilik rajaawriik chi kansanik.</para>
  <para style="b" />
  <para style="q">
    <verse number="49" style="v" />Ruum aj re', re' hin naa kaat nuloq'em chi kixilak taqe</para>
  <para style="q">i ma' re' ta aj Judío ruuk' i rutz'uuyjiik i runimaal awach.</para>
  <para style="q">
    <verse number="50" style="v" />Eh re' i reh xye'wik rajaawriik i ru reey chi ma' xta x-uuchjik.</para>
  <para style="q">Iruketelaaj wach, i rusik'im cho wach.</para>
  <para style="q">Eh i ruketelaaj wach i David chi juneliik, je' wo' taqe riih rumaam.</para>
  <chapter number="19" style="c" />
  <para style="s">Re' chu'nchel i ruyejaam chaloq i Dios ink'uhtanik reh i ruloq'il</para>
  <para style="q">
    <verse number="1" style="v" />Re' taxaaj, re' wilkeeb' chupaam ink'uhtanik reh chi xiik' naah i ruloq'il i Dios,</para>
  <para style="q">re' chu'nchel inilarik kiwach ink'uhtanik reh i rukamaj.</para>
  <para style="q">
    <verse number="2" style="v" />Re' re' kik'uhtanik reh chi q'iij chi aq'ab',</para>
  <para style="q">chi re' Dios nim rajaawriik, eh xti wilik runa'ojb'al.</para>
  <para style="q">
    <verse number="3" style="v" />Korik noq ma' re' ta ruuk' q'orik ma' kichoqik ta chuq'orariik i ruyejaam chaloq i Dios.</para>
  <para style="q">
    <verse number="4" style="v" />Eh kuum taqe kik'utinik re' re',</para>
  <para style="q">xooj rib'iral i ruq'oral i Dios chi junsuut i wach ak'al.</para>
  <para style="b" />
  <para style="q">Eh re' wo' Dios xye'wik paruye'aab' i q'iij.</para>
  <para style="q">
    <verse number="5" style="v" />Re' q'iij xasuq chik ruk'ux noq i rutoq'aa' cho b'ehik.</para>
  <para style="q">Xa je' chik rukab' i winaq koxub'an kaxáro.</para>
  <para style="q">Je' rukab' i aj ajiim i xa ruchop chik ruk'ux.</para>
  <para style="q">
    <verse number="6" style="v" />Re' q'iij i nelik chaloq raa' taxaaj,</para>
  <para style="q">eh i rub'ehuj paam chu'nchel i taxaaj korehtaal imponik chi juntar,</para>
  <para style="q">eh chu'nchel inik'ranik reh i rutz'a'iil.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' ruk'uhb'aal i QaJaaw Dios xti korik,</para>
  <para style="q">ruum i rujal wach i qánima.</para>
  <para style="q">Eh re' ruq'or i QaJaaw Dios korik,</para>
  <para style="q">ruum i ruyeew runa'ojb'al i ma' xta runa'ojb'al.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taqe k'uhb'alinik i rub'an i QaJaaw Dios korik wach,</para>
  <para style="q">i ruyeew suq kiil i qánima.</para>
  <para style="q">Re' ruk'uhb'aal xti saq wach,</para>
  <para style="q">eh i rusaquumb'isaj paam i qakapeb'aal.</para>
  <para style="q">
    <verse number="9" style="v" />Re' ruyohljiik i QaJaaw Dios saq wach,</para>
  <para style="q">eh ma' naa ta rusahchiik wach.</para>
  <para style="q">Re' i ruk'uhb'aal i QaJaaw Dios xti korik,</para>
  <para style="q">eh xti wilik rub'ehel.</para>
  <para style="q">
    <verse number="10" style="v" />Re' i ruk'uhb'aal xiik' naah k'ihaal tz'aaq</para>
  <para style="q">chuwach i manlik oro.</para>
  <para style="q">Eh xiik' naah ki'iil chuwach i riiskaab'</para>
  <para style="q">kore' k'ahchi' ruyitz'ariik chaloq</para>
  <para style="q">
    <verse number="11" style="v" />WaJaaw nuDios, re' aak'uhb'aal i rukoj wo' nuna'ojb'al i hin, hin awaj kamanoom.</para>
  <para style="q">Eh ruum i runimjiik aak'uhb'aal, naa aye'em jinaj i nukooch.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Wilik noq ma' nqakoj ta rehtaal noq inqa a'n i mahk.</para>
  <para style="q">Jaaw, wila' wilik i mahk i nub'an chi ma' weht'al, cha kuy numahk.</para>
  <para style="q">
    <verse number="13" style="v" />Chawesaj weh i niimb'isanik wachiis i hin, hin awaj kamanoom.</para>
  <para style="q">Chi je' re' neenkahnik chi ma' xta ruch'uwa'iil wach i wánima,</para>
  <para style="q">eh nee kinako'leej chuwach i runimaal mahk.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Neeta naq imponik chawach taqe nuq'oral, je' wo' chu'nchel i nukapaaj.</para>
  <para style="q">WaJaaw nuDios, xa re' wo' hat ti toob'inik weh, eh hat waj Ko'loom,</para>
  <para style="q">hat paat ab'aj ko'lemb'al iib' chi weh.</para>
  <chapter number="20" style="c" />
  <para style="s">Re' tiij chi riij chi naa rub'aan elik korik</para>
  <para style="q">
    <verse number="1" style="v" />Neeta naq irib'iraj aatiij i QaJaaw Dios noq wilkaat chupaam i ti' k'axik.</para>
  <para style="q">Re' ta wo' naq i ruDios i Jacob, neenko'linik aweh.</para>
  <para style="q">
    <verse number="2" style="v" />Re' ta naq i Dios wilik parusantolaj Ye'aab' Sión,</para>
  <para style="q">neentoob'inik aweh, eh neencha'jinik aweh.</para>
  <para style="q">
    <verse number="3" style="v" />Eh nee ta naq ink'ulik cho paruk'ux i Dios chu'nchel alemóxna aye'em.</para>
  <para style="q">Eh nee ta naq i ruk'ul aweh aamayiij inak'at wach artaal.</para>
  <para style="q">
    <verse number="4" style="v" />Neeta naq i ruyeew chaaweh aha' wilik inawaaj.</para>
  <para style="q">Eh nee ta naq inooj eloq wach chu'nchel ayejaam wach rub'aan.</para>
  <para style="q">
    <verse number="5" style="v" />Wila' xooj eloq wach, ma' k'isiin ta nee nqaniinq'ijeej aako'ljiik.</para>
  <para style="q">Neenqajosaj johtoq i rehtalil chuwach i QaJaaw Dios chi xat elik korik.</para>
  <para style="q">Eh nee ta wo' naq i ruyeew chaaweh i reh i xapahqaaj reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' hin xnunab'eej chi re' QaJaaw Dios i ruko'leej i reey rusik'im cho wach.</para>
  <para style="q">Eh kopan taxaaj naa rib'iram chaloq i Dios i naa rupahqaam i reey.</para>
  <para style="q">Eh ruuk' i rajaawriik naa ruko'leem chikiwach i aj ixowaal.</para>
  <para style="q">
    <verse number="7" style="v" />Wilik taqe i re' kikareta inkitz'e' wacheej chi ko'lb'al kiib'.</para>
  <para style="q">Eh wilik taqe i re' kikawayu inkitz'e'wacheej.</para>
  <para style="q">Eh re' hoj xa re' wo' QaJaaw Dios inqatz'e'wacheej chi ko'lb'al qiib'.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taqe re' naa ruyojiik kik'ux, naa rub'aan keh.</para>
  <para style="q">Eh re' hoj ma' xta naakooj kuchem, ma' jaruuj naa ruyojiik qak'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />WaJaaw nuDios, chako'leej tii chaloq i reey, reh chi nee nelik korik.</para>
  <para style="q">Eh nik' neetiqaq'oreej pan qatiij, nee ta tii qoh ab'iraj.</para>
  <chapter number="21" style="c" />
  <para style="s">Re' rutz'uuyjiik wach i Dios ruum i ko'linik xub'an</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, re' reey ma' k'isiin ta xsuuqb'ik ruk'ux, ruum xayeew i rajaawriik.</para>
  <para style="q">Eh suq ruk'ux ruum chi xako'leej pan kiq'ab' i aj ixowaal.</para>
  <para style="q">
    <verse number="2" style="v" />Xayeew wo' reh aha' wilik iraaj rub'anariik.</para>
  <para style="q">Eh xayeew wo' reh aha' wilik i xupahqaaj aweh parutiij.</para>
  <para style="q">
    <verse number="3" style="v" />Yohb'aal wach i rutoob'jiik xa a'n</para>
  <para style="q">xakoj rukoróna wach naah re' ruuk' i xti manlik oro.</para>
  <para style="q">
    <verse number="4" style="v" />Xupahqaaj ruk'achariik aweh, najt rooq i ruk'achariik xayeew.</para>
  <para style="q">Eh naa wo' aye'em reh i juneliik k'acharik.</para>
  <para style="q">
    <verse number="5" style="v" />Eh xayeew rajaawriik ruum xako'leej.</para>
  <para style="q">Xayeew ruloq'il, eh xayeew runimaal wach.</para>
  <para style="q">
    <verse number="6" style="v" />Wilkaat ruuk' chutoob'jiik chi juneliik.</para>
  <para style="q">Ruum aj re', ma' k'isiin ta nsuuqb'ik ruk'ux.</para>
  <para style="q">
    <verse number="7" style="v" />Je' re' noq, re' hat reey, ruuk' i QaJaaw Dios ch'iklik ak'ux.</para>
  <para style="q">Eh ruum chi naa ruketelaam wach i QaJaaw nim rajaawriik, ma' xta naa ak'ulum.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Eh re' hat naa aq'atam wach i kajaawriik taqe i ki-ixowanik awach.</para>
  <para style="q">Eh naa a'nam keh chu'nchel i ma' ki ajwanik ta awach.</para>
  <para style="q">
    <verse number="9" style="v" />Je' naa, naa aye'em taqe pan jino'q,</para>
  <para style="q">horna qoplik ruq'aq'al ruum aajosq'iil.</para>
  <para style="q">Eh ruum aajosq'iil naa taqe aye'em</para>
  <para style="q">pa runimaal q'aaq' chi tojb'al kimahk.</para>
  <para style="q">
    <verse number="10" style="v" />Re' hat reey, naa wo' asacham kiwach i kak'uun kixq'uun,</para>
  <para style="q">i kiih kimaam wilkeeb' chinaah i wach ak'al.</para>
  <para style="q">
    <verse number="11" style="v" />Atoob' ta naq inkaaj kianam aweh,</para>
  <para style="q">eh nik' ta naq wach ruyejeb'jiik wach</para>
  <para style="q">neenkian i naa kianam aweh,</para>
  <para style="q">xama' xta wo' neetikuchej.</para>
  <para style="q">
    <verse number="12" style="v" />Re' keh naa naq kimolom chi elik.</para>
  <para style="q">Xa re' la', xama' naa ta wo' chik kianam elik,</para>
  <para style="q">ruum re' hat ruuk' i flecha naa akansam taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />WaJaaw nuDios, cha k'uhtaaj awajaawriik.</para>
  <para style="q">Chi je' re', naaqaye'em runimaal awach,</para>
  <para style="q">eh naa wo' qatz'uyem awach chu'nchel qak'ux.</para>
  <chapter number="22" style="c" />
  <para style="s">Re' k'erej chi'is ruum i ruti'kiil k'uxliis, re' tz'uuy chi loq'oomb'al ree Dios</para>
  <para style="q">
    <verse number="1" style="v" />Hat nuDios, hat nuDios,</para>
  <para style="q">¿Chib'ih reet noq xi nakanaa' chi wutkeel?</para>
  <para style="q">¿Chib'ih reet noq ma' kinako'leej taj,</para>
  <para style="q">eh xama' nab'iraj ta wo' hoq i nupahqaaj aweh?</para>
  <para style="q">
    <verse number="2" style="v" />Hat nuDios, re' hin chi q'iij chi aq'ab' i nupahqaaj</para>
  <para style="q">aawotob'il, xama' kinab'iraj ta wo' hoq.</para>
  <para style="q">Eh xama' kinhi'lik ta wo' ruuk' i k'ahchi' nuk'ulum.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Xa re' la', re' hin weht'al noq wilik awajaawriik, hat Santo.</para>
  <para style="q">Eh inkiyeew aloq'il i tinamit Israel.</para>
  <para style="q">
    <verse number="4" style="v" />Re' taqe i qamaam qati't awuuk' i hat xkiyeew kik'ux.</para>
  <para style="q">Eh noq xkiyeew kik'ux awuuk', xako'leej wo' taqe.</para>
  <para style="q">
    <verse number="5" style="v" />Eh noq xkipahqaaj kitoob'jiik aweh, xawesaj wo' taqe panti' k'axik.</para>
  <para style="q">Xkiyeew kik'ux awuuk', eh re' hat ma' xak'uhtaaj ta kik'ixb'ilaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' taqe tinamit ma' kimponik ta panaq'kiwach chi hin winaq.</para>
  <para style="q">Xa je' chik hin k'isa haah noq kinkilow.</para>
  <para style="q">
    <verse number="7" style="v" />Eh chu'nchel i ki ilwik weh kinkikaqse'laaj, kinkehtz'aaj,</para>
  <para style="q">inkik'uyu'saj i kinaah, je' wili inkiq'or:</para>
  <para style="q">
    <verse number="8" style="v" />Re' reh i ruq'or chi ruye'em ruk'ux ruuk' i Dios, k'oloq aj ko'ljoq yu'naak re'.</para>
  <para style="q">I ruq'or chi q'e' ink'axarik, xti k'oloq aj ko'ljoq re', inki taqe chi wiij.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Xa re' la', re' hin weht'al chi xanoq</para>
  <para style="q">wo' xintohq'ik cho atoob'eem noq xin-aasjik cho ruuk' i nutuut,</para>
  <para style="q">eh je' wo' hoq nik' najtiil xiruch'uuch'isaj chaloq.</para>
  <para style="q">
    <verse number="10" style="v" />Xa re' wo' noq komajaa' kin-aasjik, xatkahnik chi cha'jen weh.</para>
  <para style="q">Eh noq ko hin cho rihqaam i nutuut, xa hat wo' cho nuDios i hat.</para>
  <para style="q">
    <verse number="11" style="v" />WaJaaw nuDios,</para>
  <para style="q">kinatoob'eej tii, ruum chalik reh i ti' k'axik chi nunaah</para>
  <para style="q">ma' awach ta jino'q intoob'inik weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' taqe i ki-ixowanik nuwach xa kikotik chik chi wiij,</para>
  <para style="q">xa je' chik taqe imas wakax. Xa je' chik kikab' josq'laj imas wakax kichalik Basán.</para>
  <para style="q">
    <verse number="13" style="v" />Re' keh xankaaj naq chik kianam weh.</para>
  <para style="q">Eh xa je' chik kikab' i kaq b'ahlam noq xankaaj chik k'uxuuj.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' nuti'jolal, ma' xta chik ransil,</para>
  <para style="q">xa je' chik rukab' i ha' chihkik i rub'an.</para>
  <para style="q">Eh re' taqe nub'aqil, xa roq'taam chik riib' noq inwik'raaj.</para>
  <para style="q">Eh re' wánima xa je' chik inhaab'ik kantela noq inwik'raaj.</para>
  <para style="q">
    <verse number="15" style="v" />Eh xa chiqiij chik paam i nuchii', xa je' chik joox laj xoht.</para>
  <para style="q">Re' waaq' ruchopom i panujah-aay.</para>
  <para style="q">Xayeew q'ab' chi naa nuk'ulum i ti'laj kimik, eh naa numuhqiik.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Re' taqe i chi yiib' wach kina'ojb'al kisutem chik wiij,</para>
  <para style="q">k'ahchi' kianam ti' k'axik weh xa je' chik taqe josq'laj tz'i'.</para>
  <para style="q">Eh xkihopib'eej i wooq ruch'ihil i nuq'ab'.</para>
  <para style="q">
    <verse number="17" style="v" />Ma' re' ta nkiwii' chi xa nk'utinik chik chaloq taqe i nub'aqil,</para>
  <para style="q">re' keh xasuq chik kik'ux noq kinkilow i koq.</para>
  <para style="q">
    <verse number="18" style="v" />Xkich'aqib'eej chikiwach taqe i nuso'.</para>
  <para style="q">Eh xkiq'ijej riij naab'al reh aha' wilik i naa rukahniik keh chi kiju'junaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Re' hat waJaaw nuDios, i ti ye'wik rukowiil nuk'ux,</para>
  <para style="q">makinakanaa' chi wutkeel, kinako'leej la' chi jumehq'iil.</para>
  <para style="q">
    <verse number="20" style="v" />Maayeew q'ab' chi nee kinkanteesjik ruuk' q'aslaj ch'ihch',</para>
  <para style="q">eh chi nee kinkikansaj taqe i je' josq'laj tz'i' re' re'.</para>
  <para style="q">
    <verse number="21" style="v" />Kinako'leej pan kiq'ab' taqe i yohb'aal wach kijosq'iil re' re',</para>
  <para style="q">xa je' chik kijosq'iil kaq b'ahlam, eh xa je' chik kijosq'iil imas wakax.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Chi je' re', neenuq'or keh i was nuchaaq' chi xiik' naah aawotob'il.</para>
  <para style="q">Eh neenuyeew runimaal awach chikiwach taqe inkimol kiib' chalooq'jiik.</para>
  <para style="q">
    <verse number="23" style="v" />Re' taq i hat inayohleej taq wach i QaJaaw Dios, chayeew taq ruloq'il.</para>
  <para style="q">Chayeew taq runimaal wach, i hat taq riih rumaam i Jacob.</para>
  <para style="q">Eh chawunchelaal taq i hat aj Israel chayohleej taq wach i Dios,</para>
  <para style="q">
    <verse number="24" style="v" />ruum re' reh i rutoob'eej taqe i wilkeeb' panti' k'axik.</para>
  <para style="q">Ma' rukanaa' ta chi je' re', ruum reht'al chi ti' k'ahchi' kik'iik wii'.</para>
  <para style="q">Nik' inkipahqaaj i rotob'il, i rutoob'eej wo' taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Re' hin naa nuye'em runimaal awach chi kixilak i ruk'ihaal inkimol kiib' chalooq'jiik.</para>
  <para style="q">Eh chikiwach i kiyohlinik awach, naa nuye'em i nuq'orom chi naa nuye'em aweh.</para>
  <para style="q">
    <verse number="26" style="v" />Re' taqe ma' xta wilik keh naa kianam kiwa' kihaa',</para>
  <para style="q">korehtaal kinujik. Re' naakisik'wiik reh i QaJaaw Dios,</para>
  <para style="q">naakiye'em ruloq'il, eh naa ruwihiik kik'achariik chi juneliik.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Re' tinamit chi junsuut i wach ak'al,</para>
  <para style="q">pantaq nimaq tinamit pantaq kok' tinamit,</para>
  <para style="q">naa ruk'uliik pankik'ux i QaJaaw Dios.</para>
  <para style="q">Eh naakisik'im, naakiye'em ruloq'il,</para>
  <para style="q">
    <verse number="28" style="v" />ruum re' QaJaaw Dios xti manlik reey.</para>
  <para style="q">Eh re' reh naa ruwihiik chi taaq'anik chikinaah chu'nchel i tinamit.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Eh naakixuk'aam kiib', eh naa kiloq'em i QaJaaw Dios chu'nchel i nimaq kiwach,</para>
  <para style="q">je' wo' taqe i xama' nimaq ta kiwach. Chu'nchel i re', xanaa wo' kikimiik reje,</para>
  <para style="q">ruum ma' re' tee keh kiye'wik i kik'achariik chi kib'il kiib'.</para>
  <para style="q">
    <verse number="30" style="v" />Re' taqe wiih numaam naa kiloq'em i QaJaaw Dios.</para>
  <para style="q">Eh naa kiq'orom rib'iral i rotob'il chu'nchel i kik'achariik.</para>
  <para style="q">
    <verse number="31" style="v" />Eh naa kiq'orom chi korik wach ruk'ux i QaJaaw Dios keh taqe i naa kaasjiik koq'uun.</para>
  <para style="q">Eh naa kiq'orom rib'iral taqe i xub'an.</para>
  <chapter number="23" style="c" />
  <para style="s">Re' noq xuq'or i reey David chi re' QaJaaw Dios incha'jinik reh</para>
  <para style="q">
    <verse number="1" style="v" />Re' QaJaaw Dios incha'jinik weh,</para>
  <para style="q">eh i ruyeew weh chu'nchel i ajwaal wach chi weh.</para>
  <para style="q">
    <verse number="2" style="v" />Eh i rub'an wuuk' je' rukab' i rub'an i cha'jen tentzun:</para>
  <para style="q">I ruk'am taqe i rutentzuun i wilik wii' i ch'ahn inkik'ux i ruyeew taqe chi hi'lik.</para>
  <para style="q">Eh i ruyeew kihaa' panha' ma' kow ta rooq.</para>
  <para style="q">
    <verse number="3" style="v" />Eh re' i QaJaaw Dios i ruyeew rukowiil i wánima.</para>
  <para style="q">Kiruk'am chupaam i korik laj b'eeh ruuk' i ruk'axb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Atoob' ta kinik'ik paruq'equmaal i ruyohb'alil i kimik,</para>
  <para style="q">re' hin ma' xta nuyohb'isaj wii' wiib',</para>
  <para style="q">ruum re' hat wilkaat wuuk' eh kina'koleej.</para>
  <para style="q">I na a'n wuuk', je' rukab' i rub'an i cha'jen tentzun</para>
  <para style="q">ruuk' taqe rukarote i ruko'leej taqe i rutentzuun.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh noq i nub'an nuwa' nah méxa, re' hat ticha'jinik weh chikiwach,</para>
  <para style="q">ki-ixowanik nuwach.</para>
  <para style="q">Re' hat i naa chihkaaj i ink'ohnik laj iq'oom wach nunaah.</para>
  <para style="q">Eh re' wánima xamb'ulik chik chi rusuqkiil k'uxliis,</para>
  <para style="q">je' rukab' noq imb'ulinik i kulk ye'aab' ha'.</para>
  <para style="q">
    <verse number="6" style="v" />WaJaaw nuDios, xti korik noq chi juneliik i nuk'achariik naa aye'em weh aawotob'il.</para>
  <para style="q">Naa aketelaam nuwach. Eh ma' xata ajlamaj q'iij naa nuwihiik panapaat.</para>
  <chapter number="24" style="c" />
  <para style="s">Re' i reey xti wilik ruloq'il</para>
  <para style="q">
    <verse number="1" style="v" />Chu'nchel i wach ak'al,</para>
  <para style="q">re' QaJaaw Dios inehchanik reh,</para>
  <para style="q">je' wo' chu'nchel i wilkeeb' chupaam,</para>
  <para style="q">je' wo' chu'nchel i k'achareel wilkeeb' chupaam.</para>
  <para style="q">
    <verse number="2" style="v" />Re' wo' QaJaaw Dios xyej-anik reh i wach ak'al,</para>
  <para style="q">chinaah taqe i palaw je' wo' chinaah taqe i nimaq rooq ha'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />¿Awach i naa rub'anam i johtik ruuk' i QaJaaw Dios?</para>
  <para style="q">¿Awach i naa ruwihiik parusantolaj ye'aab'?</para>
  <para style="q">
    <verse number="4" style="v" />Re' i ma' mahkunik ta ruuk' i q'ab',</para>
  <para style="q">saq wach i ránima, ma' rub'an ta reh i xama' xta ruk'am chaloq,</para>
  <para style="q">eh ma' awach taj i rujot' ruuk' i ruq'oral.</para>
  <para style="q">
    <verse number="5" style="v" />Ra'j re' re' naa ruk'ulum i rotob'il i QaJaaw Dios aj Ko'loom.</para>
  <para style="q">Naa ruye'ariik rukorkiil wach ruk'ux ruum.</para>
  <para style="q">
    <verse number="6" style="v" />Ra'j taqe ruuk' re' i wili kisik'wik reh i QaJaaw Dios,</para>
  <para style="q">inkaaj kilom wach i Dios, re' xuloq'ej chaloq i Jacob.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Titehoq taq i hat puerta wilkaat taq chi juneliik.</para>
  <para style="q">K'ul taq titehoq,</para>
  <para style="q">ruum naa rokiik i xti manlik Reey wilik ruloq'il.</para>
  <para style="q">
    <verse number="8" style="v" />Eh ¿Awach i xti manlik Reey wilik ruloq'il?</para>
  <para style="q">Re' i QaJaaw Dios xti kow riib', xti wilik rajaawriik,</para>
  <para style="q">eh i ruq'at kiwach taqe aj peleto.</para>
  <para style="q">
    <verse number="9" style="v" />Titehoq taq i hat puerta,</para>
  <para style="q">i wilkaat taq chi juneliik. K'ul taq titehoq,</para>
  <para style="q">ruum naa rokiik i xti manlik Reey wilik ruloq'il.</para>
  <para style="q">
    <verse number="10" style="v" />Eh ¿Awach i xti manlik Reey wilik ruloq'il?</para>
  <para style="q">Re' i QaJaaw Dios, i wilik rajaawriik chikinaah chu'nchel chib'ih i wilik.</para>
  <para style="q">Eh re' reh i Reey xti wilik ruloq'il.</para>
  <chapter number="25" style="c" />
  <para style="s">Re' reey David xupahqaaj i rotob'il i Dios parutiij</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, awuuk' i hat i nub'an nutiij.</para>
  <para style="q">
    <verse number="2" style="v" />Hat nuDios, awuuk' i hat i nuyeew i nuk'ux.</para>
  <para style="q">Ma' ta naq neenuk'uhtaaj nuk'ixb'ilaal.</para>
  <para style="q">Reh chi ma' nee ta kinkikaqse'laaj i ki-ixowanik nuwach.</para>
  <para style="q">
    <verse number="3" style="v" />Re' inkiyeew kik'ux awuuk', ma' jaruuj inaakik'uhtaam kik'ixb'ilaal.</para>
  <para style="q">Re' taqe i ma' kinimanik ta aweh, ra'j naakik'uhtaam kik'ixb'ilaal re'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />WaJaaw nuDios, cha k'uhtaaj weh chi korik aab'eeh.</para>
  <para style="q">Eh cha k'uhtaaj weh inawaaj chi neenub'an.</para>
  <para style="q">
    <verse number="5" style="v" />Chak'uhtaaj weh, eh chak'am nub'eeh chupaam i korik,</para>
  <para style="q">ruum xa re' wo' hat i nuDios waj Ko'loom.</para>
  <para style="q">Awuuk' i hat i nuyeew nuk'ux chi q'iij chi aq'ab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />WaJaaw nuDios, chayeew tii weh aak'axb'al.</para>
  <para style="q">Chaketelaaj nuwach, je' wo' rukab' i na a'n wuuk'.</para>
  <para style="q">
    <verse number="7" style="v" />Eh maank'ulik chik cho panak'ux taqe i numahk nub'anam,</para>
  <para style="q">je' wo' taqe i yiib' wach na'ojb'al nub'anam panuk'ijolal.</para>
  <para style="q">WaJaaw nuDios, maakinsahchik tii panak'ux,</para>
  <para style="q">chaketelaaj nuwach ruuk' aak'axb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' QaJaaw Dios q'e' atoob', korik wach ruk'ux.</para>
  <para style="q">Re' reh ink'uhtanik keh i aj mahk i korik laj b'eeh.</para>
  <para style="q">
    <verse number="9" style="v" />I ruk'am kib'eeh i xama' nimaq ta kiwach.</para>
  <para style="q">Irukoj kina'ojb'al reh chi neenkian i rub'ehel.</para>
  <para style="q">
    <verse number="10" style="v" />Re' i rub'eeh i QaJaaw Dios jinaj ketelenik wachiis, jinaj k'axooj,</para>
  <para style="q">korik chi keh i kinimanik reh i ruq'orom chi naa rub'anam,</para>
  <para style="q">eh kinimanik reh i ruk'uhb'aal.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />WaJaaw nuDios, re' hin i nupahqaaj aweh chi nee ta tii nakuy</para>
  <para style="q">i ruk'ihaal numahk, ruuk' aak'axb'al.</para>
  <para style="q">
    <verse number="12" style="v" />Awach i ruyeew ruloq'il i QaJaaw Dios,</para>
  <para style="q">re' wo' Dios naa ruk'uhtaniik reh i b'eeh naa ruk'amam.</para>
  <para style="q">
    <verse number="13" style="v" />Eh naa ruye'em reh suq laj k'acharik,</para>
  <para style="q">eh re' taqe riih rumaam naakehchaam i ye'aab' q'orooj cho rib'iral.</para>
  <para style="q">
    <verse number="14" style="v" />Re' QaJaaw Dios wilik pan jinaj wach k'uxliis kuuk' i kiye'wik ruloq'il,</para>
  <para style="q">eh i ruyeew keh chi naab'jik i ruyejaam cho wach chi naa rub'anam.</para>
  <para style="q">
    <verse number="15" style="v" />Re' hin juneliik ruuk' i QaJaaw Dios nuye'em nuk'ux,</para>
  <para style="q">ruum xa re' wo' reh neenko'linik weh chuwach ti' k'axik.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />QaJaaw Dios, kinawil tii. Chaketelaaj nuwach,</para>
  <para style="q">ruum ma' awach ta intoob'inik weh ruuk' i ruti'kiil nuk'ux.</para>
  <para style="q">
    <verse number="17" style="v" />Re' hin xa ruman i ruti'kiil i wánima i k'ahchi' rokiik.</para>
  <para style="q">Jaaw, kinawesaj tii chupaam i ti' k'axik wilkiin wii'.</para>
  <para style="q">
    <verse number="18" style="v" />Chawilow i rutz'irkiil nuwach, i ti' k'ahchi' nuk'ulum.</para>
  <para style="q">Chakuy ta tii chu'nchel i numahk nub'anam.</para>
  <para style="q">
    <verse number="19" style="v" />Jaaw, kinatoob'eej, ruum yohb'aal wach kik'ihaal taqe</para>
  <para style="q">i ki-ixowanik nuwach xa kinkaaj chik kinkikansam.</para>
  <para style="q">
    <verse number="20" style="v" />Chako'leej riij i nuk'achariik.</para>
  <para style="q">Maayeew q'ab' chi neenkik'uhtaaj nuk'ixb'ilaal,</para>
  <para style="q">ruum xa re' wo' hat ti ko'linik weh.</para>
  <para style="q">
    <verse number="21" style="v" />Ruum ta naq i rukorkiil wach nuk'ux,</para>
  <para style="q">eh chi ma' xta numahk, nee kinako'leej,</para>
  <para style="q">ruum xa awuuk' wo' hat i nuyeew nuk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Hat nuDios, i nupahqaaj otob'il aweh</para>
  <para style="q">chi chako'leej i tinamit Israel ruuk' i ti' k'axik wilik wii'.</para>
  <chapter number="26" style="c" />
  <para style="s">Re' reey David xuq'or reh i Dios chi re' reh korik wach ruk'ux</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, chaq'at i q'orik chi nunaah.</para>
  <para style="q">Eh re' hat nee ti q'orik chi ma' xta numahk,</para>
  <para style="q">ruum awuuk' i hat i nuyeew nuk'ux, chi juneliik.</para>
  <para style="q">
    <verse number="2" style="v" />WaJaaw nuDios, chawilow nik' wach i nuk'achariik chawach.</para>
  <para style="q">Chawilow mi korik wach i nukapeb'aal, mi korik wach i nuna'ojb'al,</para>
  <para style="q">
    <verse number="3" style="v" />Re' hin weht'al chi juneliik kinak'ax,</para>
  <para style="q">re' hin korik wach nuk'ux awuuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh ma' nub'an ta jinaj nuwach kuuk' i chukul q'orik,</para>
  <para style="q">ma' kinwihik ta chi kixilak i xak'ul inki a'n kiwach.</para>
  <para style="q">
    <verse number="5" style="v" />Eh ma' nwaaj ta wach i moloj iib' inki a'n i yiib' wach kina'ojb'al.</para>
  <para style="q">Eh ma' jank'al ta kinwihik chi kixilak i ma' holohik ta kib'anik.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />QaJaaw Dios, re' hin je' naa naa nutz'ajam i nuq'ab',</para>
  <para style="q">reh chi ma' xta numahk noq nee kinokik chuwach aa artaal,</para>
  <para style="q">
    <verse number="7" style="v" />reh chi naa nutz'uyem awach,</para>
  <para style="q">eh naa nuq'orom rib'iral taqe i na a'n xiik' naah loq'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />WaJaaw nuDios, re' hin q'e' nuk'ax i loq'laj apaat,</para>
  <para style="q">re' i ti wihik wii', re' i ye'aab' wilik wii' i runimaal aaloq'il.</para>
  <para style="q">
    <verse number="9" style="v" />Maayeew q'ab' chi nee kinkimik je' rukab' inkik'ul i aj mahk.</para>
  <para style="q">Eh maayeew q'ab' chi nee nuk'ul weh i ti' k'axik inkik'ul i aj kansan kas kichaaq'.</para>
  <para style="q">
    <verse number="10" style="v" />Re' keh xa re' wo' hoq i mahk inki a'n</para>
  <para style="q">xa re' wo' i leq' inki a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Eh re' hin weht'al chi ma' xta numahk chawach, kinako'leej, chaketelaaj nuwach.</para>
  <para style="q">
    <verse number="12" style="v" />Re' hin nuchopom nuk'ux ruuk' i QaJaaw,</para>
  <para style="q">Ruum aj re', naa nuye'em runimaal i ruloq'il chikiwach i rutinamiit inkimol kib'.</para>
  <chapter number="27" style="c" />
  <para style="s">Re' QaJaaw Dios i nusaquum, re' reh inko'linik weh</para>
  <para style="q">
    <verse number="1" style="v" />Re' QaJaaw Dios i nusaquum, re' reh i waj Ko'loom.</para>
  <para style="q">Re' reh inye'wik rukowiil nuk'ux panuk'achariik.</para>
  <para style="q">Ruum aj re',</para>
  <para style="q">ma' xta neekinyo'jik wii'.</para>
  <para style="q">
    <verse number="2" style="v" />Re' taqe i yiib' wach kina'ojb'al,</para>
  <para style="q">i ki-ixowanik nuwach,</para>
  <para style="q">noq xkimol naq kiib' chi nunaah chusachariik nuwach,</para>
  <para style="q">re' chik i keh xsacharik kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Atoob' ta neenkimol kiib' i ruk'ihaal soldado</para>
  <para style="q">chi nunaah chub'anariik weh, ma' nee ta kinyo'jik.</para>
  <para style="q">Atoob' ta neenkitik'aa' q'aq'inik wuuk',</para>
  <para style="q">re' hin xama' nee ta wo' inchalik nuyo'jiik.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' hin xa jinaj i nupahqaaj reh i QaJaaw Dios,</para>
  <para style="q">xa jinaj inwaaj chi naa nub'anam:</para>
  <para style="q">Re' chi nee kinwihik chupaam i rusantolaj Paat</para>
  <para style="q">chu'nchel i q'iij nik' chik najtiil i nuk'achariik,</para>
  <para style="q">reh chi ar neenuloq'ej,</para>
  <para style="q">eh neenub'an rusuqkiil i ruholwochiil chii' wach i reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh noq neenchalik i ti' k'axik chi nunaah, re' QaJaaw Dios neenko'linik weh.</para>
  <para style="q">Eh nee wo' kiruko'leej ar chupaam i rupaat.</para>
  <para style="q">Je' naa chinaah jino'q i paat ab'aj neekiruyeew noq neekiruko'leej.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' reh naa kiin rutoob'eem,</para>
  <para style="q">reh chi neenuq'at kiwach taqe i ki-ixowanik nuwach.</para>
  <para style="q">Chi je' re' neerub'an chi neenuk'at i numayiij chupaam i ruloq'laj paat i QaJaaw Dios.</para>
  <para style="q">Eh kow naa nutz'uyem wach ruum i rusuqkiil nuk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />WaJaaw nuDios, re' hat k'ahchi' kaat nuq'oreem.</para>
  <para style="q">Chayeew tii weh i nupahqaaj aweh. Chaketelaaj tiinuwach, kinab'iraj tii.</para>
  <para style="q">
    <verse number="8" style="v" />Re' hin xchalik pan wánima</para>
  <para style="q">chi naa kaat nusik'im.</para>
  <para style="q">Ruum aj re', yu'naak k'ahchi'</para>
  <para style="q">nusik'im i loq'laj awotob'il.</para>
  <para style="q">
    <verse number="9" style="v" />WaJaaw nuDios, chayeew tii weh aawotob'il.</para>
  <para style="b" />
  <para style="q">Maa kinachaq'weej ruuk' josq'iil.</para>
  <para style="q">Makinakanaa' wutkeel,</para>
  <para style="q">ruum xa re' wo' hat titoob'inik weh,</para>
  <para style="q">eh xa re' wo' hat, hat waj Ko'loom.</para>
  <para style="q">
    <verse number="10" style="v" />Atoob' ta nee kinkiq'eb' i nutuut wajaaw,</para>
  <para style="q">re' hin weht'al chi re' QaJaaw Dios neemolwik weh.</para>
  <para style="q">
    <verse number="11" style="v" />WaJaaw nuDios, cha k'uhtaaj tii weh aab'eeh.</para>
  <para style="q">Chak'am nub'eeh chupaam i korik,</para>
  <para style="q">reh chi ma' xta neekinkuchej i ki-ixowanik nuwach.</para>
  <para style="q">
    <verse number="12" style="v" />Maayeew q'ab' chi neenkian wuuk'</para>
  <para style="q">inkaaj kianam taqe i ki-ixowanik nuwach,</para>
  <para style="q">ruum re' keh xa chib'ih i q'orik inkitz'aq chi wiij, inkaaj kianam ti' k'axik weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Eh wi ta ma' nunimaj i hin</para>
  <para style="q">chi naa nuk'ulum i rotob'il i Dios</para>
  <para style="q">panuk'achariik ayu' wach ak'al, yojinaq naq chik nuk'ux.</para>
  <para style="q">
    <verse number="14" style="v" />Chachop ak'ux ruuk' i QaJaaw Dios.</para>
  <para style="q">Marub'an kiib' ak'ux, cha chop la' ak'ux chi korik,</para>
  <para style="q">ruum xa re' wo' reh i ruk'ul chi naa awuy-eem i rotob'il.</para>
  <chapter number="28" style="c" />
  <para style="s">Re' reey David x-ib'irjik i rutiij</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, hat waj ko'loom, hat paat ab'aj ko'lemb'al iib' chi weh.</para>
  <para style="q">Re' hat tinuq'o'reej, kinab'iraj tii.</para>
  <para style="q">Chayeew weh i nupahqaaj aweh,</para>
  <para style="q">reh chi ma' nee ta kinkimik je' rukab' noq kikimik i yiib' wach kina'ojb'al.</para>
  <para style="q">
    <verse number="2" style="v" />Chab'iraj cho weh</para>
  <para style="q">noq i nupahqaaj aawotob'il ruuk' oq'ik,</para>
  <para style="q">re' noq i nujosaj johtoq i nuq'ab' chawach</para>
  <para style="q">chupaam asantolaj ye'aab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Maa a'n ti' k'axik weh, je' rukab' inkik'ul i yiib' wach kina'ojb'al.</para>
  <para style="q">Maa a'n weh je' rukab' inkik'ul i ma' holohik ta kib'anik,</para>
  <para style="q">xa q'e' chik taqe atoob' inki a'n kiib'.</para>
  <para style="q">Xanaah re' i kánima nujinaq chi ma' tob'laj na'ojb'al.</para>
  <para style="q">
    <verse number="4" style="v" />Chayeew taqe chutojariik i kimahk,</para>
  <para style="q">re' q'oreel chib'ih jariik i yiib' wach na'ojb'al inki a'n</para>
  <para style="q">je' wo' chik re' i cha a'n kuuk' i hat.</para>
  <para style="q">Cha a'n jilow keh inki a'n</para>
  <para style="q">
    <verse number="5" style="v" />Ruum chi ma' xponik ta panaq'kiwach taqe rub'anam i QaJaaw Dios,</para>
  <para style="q">je' wo' taqe i ruyejaam chaloq, re' wo' reh naa rusachwiik kiwach,</para>
  <para style="q">eh ma' naa ta keliik korik.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Loq'imaj ta naq i QaJaaw Dios,</para>
  <para style="q">ruum xuyeew weh i xnupahqaaj reh.</para>
  <para style="q">
    <verse number="7" style="v" />Re' i QaJaaw inye'wik rukowiil nuk'ux, eh kiruko'leej.</para>
  <para style="q">Ruuk' i reh, i nuyeew i wánima, xirutoob'eej,</para>
  <para style="q">eh insuuqb'ik i wánima.</para>
  <para style="q">Ruum aj re', naa nutz'uyem wach chi loq'oomb'al reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' i QaJaaw Dios inye'wik rukowiil kik'ux i rutinamiit.</para>
  <para style="q">Re' reh inko'linik reh i rukuxisam, chaloq</para>
  <para style="q">
    <verse number="9" style="v" />WaJaaw nuDios, chako'leej aatinamiit, chakuxisaj taqe awak'uun awixq'uun.</para>
  <para style="q">Chacha'jeej taqe atentzuun, eh chayeew rukowiil kik'ux chi juneliik.</para>
  <chapter number="29" style="c" />
  <para style="s">Re' rajaawriik i QaJaaw Dios, eh re' i ransil i ruq'oral</para>
  <para style="q">
    <verse number="1" style="v" />Chaloq'ej taq i QaJaaw Dios i hat, hat taq ánjel wilkaat taq cho pan taxaaj.</para>
  <para style="q">Chayeew taq runimaal wach ruloq'il.</para>
  <para style="q">
    <verse number="2" style="v" />Chayeew taq ruloq'il i QaJaaw Dios, ruum xiik' naah loq'il i rub'ihnaal.</para>
  <para style="q">Chaloq'ej taq i QaJaaw Dios, ruum xiik' naah holwochiil, eh xti wilik rusantohiil.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' ruq'oral i QaJaaw Dios inib'irjik chinaah taqe ha'.</para>
  <para style="q">Xa nteleninik chik i ransil i ruq'oral.</para>
  <para style="q">Eh xa je' chik inq'orik kahoq chinaah i palaw.</para>
  <para style="q">
    <verse number="4" style="v" />Je' re' noq, re' ruq'oral i QaJaaw Dios xiik' naah i ransil</para>
  <para style="q">eh xti wilik rajaawriik.</para>
  <para style="q">
    <verse number="5" style="v" />Re' i ruq'oral i QaJaaw Dios i ruxereb'eej taqe chee' chakaltee',</para>
  <para style="q">Eh i ruxereb'eej taqe i nimaq taq chakaltee' wilkeeb' Líbano.</para>
  <para style="q">
    <verse number="6" style="v" />Ruuk' i ruq'oral i ruk'uyu'saj taqe yuuq' ar Líbano, je' wo' wilkeeb' ar Sirión.</para>
  <para style="q">Xa je' chik kipisk'anik kok' rak'uun wakax, xa je' chik kipisk'anik imas wakax.</para>
  <para style="q">
    <verse number="7" style="v" />Re' ransil i ruq'oral i QaJaaw Dios i rukut wo' taqe xaq q'aaq'.</para>
  <para style="q">
    <verse number="8" style="v" />Re' ransil i ruq'oral i QaJaaw Dios, i ruk'uyu'saj ye'aab' chiq yuuq'.</para>
  <para style="q">Eh i ruk'uyu'saj ruuk' i ruq'oral taqe chiq yuuq' wilkeeb' chupaam i ye'aab', Cades.</para>
  <para style="q">
    <verse number="9" style="v" />Re' i QaJaaw Dios ruuk' i ruq'oral i ruk'uyu'saj taqe i tz'inuj chee'.</para>
  <para style="q">Eh i rukanaa' chi ma' xta ruche'el wach taqe yuuq',</para>
  <para style="q">eh chupaam i rupaat, chu'nchel kiye'wik ruloq'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' i QaJaaw Dios intaaq'anik reh i kowlaj jab' noq i rub'an i elal ha'.</para>
  <para style="q">Re' reh i reey wilik rajaawriik chi taaq'anik chi juneliik.</para>
  <para style="q">
    <verse number="11" style="v" />Re' QaJaaw Dios inye'wik kajaawriik i rutinamiit.</para>
  <para style="q">Eh i ruyeew keh i rusuqkiil k'uxliis.</para>
  <chapter number="30" style="c" />
  <para style="s">Re' reey David xut'iosej ree Dios i rutoob'jiik xb'aan</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw nuDios, re' hin tinuloq'ej, ruum re' hat xat ko'linik weh,</para>
  <para style="q">eh ma' xayeew ta q'ab' chi xinkikaqse'laaj taqe i ki-ixowanik nuwach.</para>
  <para style="q">
    <verse number="2" style="v" />WaJaaw nuDios, noq xnupahqaaj aweh</para>
  <para style="q">chi naa kiin atoob'eem, xinak'aachrisaj wo' hoq.</para>
  <para style="q">
    <verse number="3" style="v" />WaJaaw nuDios, re' hat xat ko'linik weh.</para>
  <para style="q">Noq ximponik nah kimik.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Hat taq santo laj aj nimaneel, cha tz'uyej taq wach i QaJaaw Dios.</para>
  <para style="q">Chaloq'ej taq, ruum re' reh santo i rub'ihnaal.</para>
  <para style="q">
    <verse number="5" style="v" />Re' reh, xa junk'aam i ruyeew i rujosq'iil chi qanaah,</para>
  <para style="q">eh re' rotob'il chi juneliik i qak'achariik i ruyeew qeh.</para>
  <para style="q">Atoob' nee qoh oq'ik chaq'ab',</para>
  <para style="q">eh pan wahq'eq ruyeew wo' chik rusuqkiil qak'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' hin noq suq chik wilkiin, je' wili i xnuq'or:</para>
  <para style="q">Ma' xta chik i ti' naawilom wach, kinki.</para>
  <para style="q">
    <verse number="7" style="v" />Xanaah re' Jaaw weht'al wo' naq chi re' hat</para>
  <para style="q">ti ye'wik rukowiil nuk'ux.</para>
  <para style="q">Eh noq ma' nuyeew ta chik nuk'ux awuuk', ruum i re', xchalik nuyo'jiik.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />WaJaaw nuDios, re' hin tinuq'o'reej,</para>
  <para style="q">eh i nupahqaaj otob'il aweh. Je' wili nuq'or:</para>
  <para style="q">
    <verse number="9" style="v" />¿Chih chik neenutiq wach aweh chi hin chik kamnaq?</para>
  <para style="q">¿Chib'ih chik neenutiq wach aweh chi muqulkiin chik panjul?</para>
  <para style="q">¿Mi nee chik tiruloq'ej re' i nupoqil?</para>
  <para style="q">¿Mi konee ruq'or rib'iral re' chi xa re' wo' hat i korik?</para>
  <para style="q">
    <verse number="10" style="v" />WaJaaw nuDios, kinab'iraj tii,</para>
  <para style="q">chaketelaaj nuwach, eh kinatoob'eej tii.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' hin ma' nukoj ta chik i nuq'eq' so',</para>
  <para style="q">ruum re' hat xasutej chi rusuqkiil nuk'ux i ruti'kiil nuk'ux,</para>
  <para style="q">xa kinsoninik chik ruum i rusuqkiil nuk'ux.</para>
  <para style="q">
    <verse number="12" style="v" />Ruum aj re', QaJaaw Dios,</para>
  <para style="q">re' hin ma' jaruuj neentz'aplojik i nuuchii'.</para>
  <para style="q">Ma' naa ta nukanaam rutz'uuyjiik awach.</para>
  <para style="q">Eh juneliik naa nut'iosem awotob'il.</para>
  <chapter number="31" style="c" />
  <para style="s">Re' reey David xtiruyeew ruk'ux ruuk' i QaJaaw Dios</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, xa awuuk' wo' hat i nuyeew nuk'ux,</para>
  <para style="q">ruum i nayeew weh i nupahqaaj aweh.</para>
  <para style="q">Re' hat nee kinako'leej ruum korik wach ak'ux.</para>
  <para style="q">
    <verse number="2" style="v" />Je' re' noq, kinab'iraj tii,</para>
  <para style="q">kinako'leej chi jumehq'iil</para>
  <para style="q">hat paat ab'aj ko'lemb'al iib' chi weh,</para>
  <para style="q">ruum xa re' wo' hat manlik ko'len weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh hat paat ab'aj ko'lemb'al iib' chi weh i hin, ruum xa re' wo' hat ti ko'linik weh.</para>
  <para style="q">Ruum aj re' chak'am tii nub'eeh ruuk' aak'axb'al.</para>
  <para style="q">
    <verse number="4" style="v" />Re' taqe ki-ixowanik nuwach</para>
  <para style="q">kikojom nuxirob'aal,</para>
  <para style="q">kinawesaj ti chupaam,</para>
  <para style="q">ruum xa re' wo' hat nee ti ko'linik weh.</para>
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios, re' hin panaq'ab' i nuq'asaj</para>
  <para style="q">i wánjel nut'iosil. Eh inwaaj chi nee kinawesaj</para>
  <para style="q">pan k'axik, ruum xa re' wo' hat, i hat i korik laj Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' hin awuuk' i hat i nuyeew i nuk'ux.</para>
  <para style="q">Ruum aj re', ma' inwaaj ta kiwach i kiloq'inik</para>
  <para style="q">taqe i reh xa tiyoox, xama' xta kajaawriik.</para>
  <para style="q">
    <verse number="7" style="v" />QaJaaw Dios, ruuk' aak'axb'al i nayeew</para>
  <para style="q">rusuqkiil nuk'ux chi manlik.</para>
  <para style="q">Eh re' hat inawil i ruti'kiil nuk'ux.</para>
  <para style="q">Eh inawil chi xanyot'ik chik i wánima.</para>
  <para style="q">
    <verse number="8" style="v" />Weht'al i hin noq ma' xayeew ta q'ab'</para>
  <para style="q">chi xinkikansaj taqe i ki-ixowanik nuwach,</para>
  <para style="q">xayeew la' cho rukowiil nuk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />QaJaaw Dios, chaketelaaj tiinuwach</para>
  <para style="q">ruum re' hin panyohb'aal wilkiin,</para>
  <para style="q">re' naq'nuwach xak'ahchi' chi oq'ik ruum i ti' k'axik.</para>
  <para style="q">Re' wánima, eh re' nuti'jolal xama' xta chik kaansil inwik'raaj.</para>
  <para style="q">
    <verse number="10" style="v" />Re' taqe ti' k'axik k'ahchi' nuk'ulum</para>
  <para style="q">k'ahchi' rutoqom rooq i nuk'achariik.</para>
  <para style="q">Ruum taqe rutz'irkiil nuwach k'ahchi' ruk'uhliik i waansil.</para>
  <para style="q">Xa je' chik q'ojooj taqe nub'aqil noq inwik'raaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Eh re' taqe i ki-ixowanik nuwach, xa hin kib'ajb'al,</para>
  <para style="q">re' taqe nuka'jaah nuk'ula't xa hin kise'lb'aal.</para>
  <para style="q">Eh xa hin chik yohb'isaneel chi keh i kieht'alinik nuwach,</para>
  <para style="q">eh xa kajiim chik kielik chi nuwach pamb'eeh.</para>
  <para style="q">
    <verse number="12" style="v" />Re' taqe re' ma' kink'ulik ta chik</para>
  <para style="q">pankik'ux chi jumpech, xa je' chik</para>
  <para style="q">hin kamnaq chikiwach.</para>
  <para style="q">Eh xa je' chik hin ruxeer ak'al xaro chikiwach.</para>
  <para style="q">
    <verse number="13" style="v" />Re' hin imb'iraj taqe tinamit chi k'ahchi'</para>
  <para style="q">kijask'uum chikiwach chib'ih i naa kianam weh,</para>
  <para style="q">noq kinooj xa aha', panyohb'aal wilkiin.</para>
  <para style="q">Eh inkiyejaa' wach i nukanteesjiik.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Xa re' la', re' hin Jaaw, awuuk' i hat i nuyeew i nuk'ux,</para>
  <para style="q">ruum weht'al chi re' hat, hat nuDios.</para>
  <para style="q">
    <verse number="15" style="v" />Re' nuk'achariik panaq'ab' wilik,</para>
  <para style="q">kinako'leej pan kiq'ab' i ki-ixowanik nuwach,</para>
  <para style="q">re' i kib'anik ti' k'axik weh.</para>
  <para style="q">
    <verse number="16" style="v" />QaJaaw Dios, re' hin, hin awaj kamanoom</para>
  <para style="q">chayeew tii weh ak'axb'al.</para>
  <para style="q">Chaketelaaj nuwach, kinako'leej.</para>
  <para style="q">
    <verse number="17" style="v" />QaJaaw Dios, i nupahqaaj nutoob'jiik aweh</para>
  <para style="q">maa k'uhtaaj nuk'ixb'ilaal.</para>
  <para style="q">Re' la' taqe i yiib' wach kina'ojb'al cha k'uhtaaj kik'ixb'ilaal,</para>
  <para style="q">chakansaj taqe reh chi ma' nee ta chik kiq'orik.</para>
  <para style="q">
    <verse number="18" style="v" />Chatz'ap i kichii' i aj chukul q'orik,</para>
  <para style="q">ruum re' keh inkib'aj, inkixowaaj wach,</para>
  <para style="q">ma' imponik ta panaq'kiwach i korik wach ruk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />QaJaaw Dios, re' hat yohb'aal wach aawotob'il</para>
  <para style="q">i nayeew chikinaah i kiyohlinik aweh.</para>
  <para style="q">Eh inak'uhtaaj chikiwach i tinamit</para>
  <para style="q">chi korik chi nak'ax taqe inkiyeew kik'ux awuuk'.</para>
  <para style="q">
    <verse number="20" style="v" />Eh ruum chi wilkaat kuuk' chi kitoob'jiik</para>
  <para style="q">xako'leej taqe chuwach i kiyejaam</para>
  <para style="q">wach i yiib' wach kina'ojb'al.</para>
  <para style="q">Re' wo' hat naa ako'liniik keh</para>
  <para style="q">chikiwach imb'ajwik keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Neeta naq inye'arik ruloq'il i QaJaaw Dios.</para>
  <para style="q">Ruum ruuk' i ruk'axb'al xuyeew rukowiil nuk'ux</para>
  <para style="q">noq xub'an taqe i sahchb'al k'uxliis</para>
  <para style="q">wuuk' noq wilkiin panti' k'axik.</para>
  <para style="q">
    <verse number="22" style="v" />QaJaaw Dios noq wilkiin panti' k'axik,</para>
  <para style="q">xnukapaaj chi numemil chi ma' naa ta chik kiin atoob'eem.</para>
  <para style="q">Eh noq xnupahqaaj aweh chi naa kiin atob'eem</para>
  <para style="q">xinab'iraj wo' chaloq.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Re' taq i hat santo laj aj nimaneel cha k'ax taq i QaJaaw</para>
  <para style="q">ruum re' reh incha'jinik keh i korik wach kik'ux.</para>
  <para style="q">Eh re' taqe i nimaq kiwach i ruyeew taqe</para>
  <para style="q">chutojariik i kimahk nik' wach i ruk'ul chi keh.</para>
  <para style="q">
    <verse number="24" style="v" />Eh koowjoq taq ak'ux i hat, maa rub'an taq kiib' ak'ux,</para>
  <para style="q">ruum ruuk' i QaJaaw Dios taq aye'em awánima.</para>
  <chapter number="32" style="c" />
  <para style="s">Re' reey David xupahqaaj kuyb'al ru mahk, eh xkuyarik wo' ru mahk</para>
  <para style="q">
    <verse number="1" style="v" />Atoob' reh awach i kuyuuj, i sachooj chik chi jumpech</para>
  <para style="q">chu'nchel ru mahk,</para>
  <para style="q">
    <verse number="2" style="v" />Atoob' reh awach i ma' xta k'isinoq i yiib' wach na'ojb'al i rub'an.</para>
  <para style="q">Eh ma' xta k'isinoq ru mahk neenkan ruum i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh noq ma' nupahqaaj ta naq kuyb'al numahk i hin,</para>
  <para style="q">xama' nukuy ta naq chik taqe nuti'jolal ruum i ruti'kiil nuk'ux chu'nchel q'iij.</para>
  <para style="q">
    <verse number="4" style="v" />Ruum chi q'iij chi aq'ab' naq nayeew chi nunaah aq'ab' reh i rub'anariik weh i ti' k'axik,</para>
  <para style="q">nik' wach noq inchiqik i uhtz'ub' ruum i rutz'a'iil i q'iij,</para>
  <para style="q">xa je' chik re' i nuti'jolal noq inwik'raaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh noq xnupahqaaj kuyb'al numahk,</para>
  <para style="q">chu'nchel i numahk xnuq'or aweh.</para>
  <para style="q">Eh xchalik panuk'ux chi xnupahqaaj kuyb'al numahk aweh.</para>
  <para style="q">Re' hat QaJaaw Dios xakuy wo' numahk.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Ruum aj re', nik' ti' wilkeeb' taqe korik wach kik'ux,</para>
  <para style="q">i ruk'ul chi re' hat naa kaat kiq'o'reem kuuk',</para>
  <para style="q">chi je' re' atoob' ta xa je' chik ink'u'loq runimaal elel ha'</para>
  <para style="q">chikinaah taqe ti' k'axik ma' xta naa kuuchjiik ruum.</para>
  <para style="q">
    <verse number="7" style="v" />Re' hat naa ako'liniik weh,</para>
  <para style="q">naa kiin ako'leem chuwach i yohb'aal.</para>
  <para style="q">Eh naa nuk'erem nuchii', ruum naaweliik korik</para>
  <para style="q">ruuk' i ko'lemb'al wiib' naa aye'em weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' QaJaaw Dios je' wili i ruq'or: Re' hin k'ahchi' kaat wilom,</para>
  <para style="q">eh neenuk'uhtaaj aweh taqe i ruk'ul chi naa a'nam,</para>
  <para style="q">naa nukojom ana'ojb'al, eh nee nuk'uhtaaj aweh i b'eeh naa ak'amam.</para>
  <para style="q">
    <verse number="9" style="v" />Eh mo'-oq je' akab' ixoq kawáyu,</para>
  <para style="q">mo'-oq je' akab' imaas kawáyu.</para>
  <para style="q">Re' taqe re', ma' ki-ib'irinik taj,</para>
  <para style="q">konkojarik b'ak'b'al ree kiju' ko ruuk' i re'</para>
  <para style="q">kimek'arik kora'j nee kichalik re', inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' yiib' wach kina'ojb'al</para>
  <para style="q">naa ruchaliik i ti' k'axik chikinaah.</para>
  <para style="q">Eh re' taqe i ruuk' i QaJaaw kiye'em i kik'ux</para>
  <para style="q">xiik' naah i ruk'axb'al i ruyeew chikinaah.</para>
  <para style="q">
    <verse number="11" style="v" />Re' taq i hat i tib'anik taq reh i rub'ehel,</para>
  <para style="q">eh korik taq wach ana'ojb'al, suuqb'oq taq ak'ux</para>
  <para style="q">ruuk' i QaJaaw Dios cha tz'uyej taq wach.</para>
  <chapter number="33" style="c" />
  <para style="s">Re' rutz'uyjiik wach i QaJaaw Dios chi t'iosb'al reh i rotob'il</para>
  <para style="q">
    <verse number="1" style="v" />Re' taq i hat korik wach ak'ux,</para>
  <para style="q">suuqb'oq taq ak'ux ruuk' i QaJaaw Dios cha tz'uyej taq wach.</para>
  <para style="q">
    <verse number="2" style="v" />Chatz'uyej taq wach ruuk' arpa i QaJaaw Dios.</para>
  <para style="q">Chatz'uyej taq wach ruuk' chee' q'ooj wilik ruk'ahamil wach.</para>
  <para style="q">
    <verse number="3" style="v" />Chatz'uyej taq wach ruuk' ak' tz'uuy.</para>
  <para style="q">Chaq'ojej taq aq'ooj chi loq'oomb'al reh i QaJaaw Dios.</para>
  <para style="q">
    <verse number="4" style="v" />Ruum re' i ruq'oral i QaJaaw Dios xti korik,</para>
  <para style="q">re' chu'nchel i ruyejaam ink'uhtanik reh chi korik wach ruk'ux.</para>
  <para style="q">
    <verse number="5" style="v" />Re' QaJaaw Dios xtimponik chuwach i korik, ruch'ihil i rub'ehel.</para>
  <para style="q">Eh re' ruk'axb'al wilik chi junsuut i wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' i QaJaaw Dios xa ruuk' i ransil i ruq'oral xuyejaa' i taxaaj,</para>
  <para style="q">je' wo' chu'nchel chib'ih jariik i wilkeeb' chupaam.</para>
  <para style="q">
    <verse number="7" style="v" />Re' wo' reh i molwik kiwach taqe ha' i rumol kiwach pantaq chaamlaj jul,</para>
  <para style="q">eh i ruyejaa' taqe chii' palaw.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Chayohleej taq wach i QaJaaw Dios i hat i wilkaat taq wach ak'al.</para>
  <para style="q">Je' wo' taq i hat i k'acharik taq i na a'n chinaah i wach ak'al chayohleej taq i Dios.</para>
  <para style="q">
    <verse number="9" style="v" />Eh ruuk' wo' ransil i ruq'oral i Dios xkorjik chu'nchel i chib'ih jariik i wilik.</para>
  <para style="q">Noq xuq'or i reh chi naa rukorjiik xkorjik wo' hoq.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' QaJaaw Dios i rusach wach chi jumpech</para>
  <para style="q">inkiyejaa' wach rub'aan chu'nchel i ma' kinimanik ta reh.</para>
  <para style="q">
    <verse number="11" style="v" />Raaj i rukapaaj rub'aan i QaJaaw Dios reh,</para>
  <para style="q">eh i ruyejaa' cho wach paránima, ma' jaruuj naa rusahchiik wach.</para>
  <para style="q">
    <verse number="12" style="v" />Atoob' reh i tinamit i re' k'achlik Dios i rukoj chi ruDios,</para>
  <para style="q">re' wo' re' rusik'im cho wach chi rutinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' QaJaaw Dios kopan taxaaj i rilow chaloq i tinamit wach ak'al,</para>
  <para style="q">eh ko ar wo' rilow chaloq i kina'ojb'al.</para>
  <para style="q">
    <verse number="14" style="v" />Ko ar chupaam i ruye'aab' i rilow chaloq</para>
  <para style="q">nik' wach i kik'achariik i tinamit wach ak'al.</para>
  <para style="q">
    <verse number="15" style="v" />Re' wo' QaJaaw Dios xyej-anik reh i kánima,</para>
  <para style="q">ruum aj re', reht'al wo' chu'nchel chib'ih jariik i k'ahchi' keeb'.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Ma' jino'q i reey neenko'ljik xa ruum i ruk'ihaal soldado.</para>
  <para style="q">Eh re' kow i rub'an riib' ma' nee ta ruko'leej riib' xa ruum chi ma' k'isiin i ransil.</para>
  <para style="q">
    <verse number="17" style="v" />Atoob' ta ruuk' kawáyu neerutik'aa' q'aq'inik jino'q xama' nee ta wo' ruko'leej riib'.</para>
  <para style="q">Eh nik' ta naq kowiil neerub'an riib' xama' nee ta wo' ruko'leej riib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Raaj taqe i kiye'wik runimaal wach,</para>
  <para style="q">je' wo' taqe i kiye'em kik'ux ruuk' i QaJaaw Dios re' wo' reh incha'jinik keh.</para>
  <para style="q">
    <verse number="19" style="v" />Eh nee wo' inko'ljik i kánima ruum i qajaaw chuwach i kimik,</para>
  <para style="q">eh ma' nee ta ruyeew q'ab' chi nee kikimik ruum wi'jaleel.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Re' hoj ruuk' QaJaaw Dios qaye'em qak'ux,</para>
  <para style="q">ruum re' reh intoob'inik qeh, eh i ruko'leej i qánima.</para>
  <para style="q">
    <verse number="21" style="v" />Eh ma' k'isiin ta nsuuqb'ik i qánima ruuk' i QaJaaw Dios</para>
  <para style="q">ruum chi ch'iklik qak'ux ruuk' i rusantolaj b'ihnaal.</para>
  <para style="q">
    <verse number="22" style="v" />QaJaaw Dios, nee ta tiinaketelaaj qawach,</para>
  <para style="q">je' rukab' inqaaj chi neena a'n quuk'.</para>
  <chapter number="34" style="c" />
  <para style="s">Re' QaJaaw Dios i ruko'leej taqe i korik wach kik'ux</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin naa nuloq'em i QaJaaw Dios chi juneliik.</para>
  <para style="q">Eh xa eliik re' reh naa nuye'em ruloq'il ruuk' nuchii'.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin naa rusuqb'iik nuk'ux ruuk' i QaJaaw Dios.</para>
  <para style="q">Eh noq naa kib'iram i xama' nimaq ta kiwach naa rusuuqb'iik kik'ux.</para>
  <para style="q">
    <verse number="3" style="v" />Qaloq'ej taq i QaJaaw Dios awuuk',</para>
  <para style="q">jinaj-oq taq wach qak'ux chuye'ariik runimaal wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh noq xnupahqaaj i rotob'il i QaJaaw Dios xirib'iraj wo' hoq.</para>
  <para style="q">Eh xiresaj wo' chupaam chu'nchel i yohb'aal.</para>
  <para style="q">
    <verse number="5" style="v" />Awach inkipahqaaj i rotob'il i QaJaaw Dios insaqumb'eesjik paam i kikapeb'aal.</para>
  <para style="q">Eh ma' jaruuj neenk'uhtjik kik'ixb'ilaal.</para>
  <para style="q">
    <verse number="6" style="v" />Eh noq ti' wilkiin xnuq'o'reej i QaJaaw Dios xirib'iraj wo' hoq.</para>
  <para style="q">Re' reh xiresaj chupaam chu'nchel i ruti'kiil nuk'ux.</para>
  <para style="q">
    <verse number="7" style="v" />Re' i ruánjel i QaJaaw Dios wilik chi kijunsuut i kiyohlinik ree reh,</para>
  <para style="q">eh i ruko'leej taqe.</para>
  <para style="q">
    <verse number="8" style="v" />Chawilow taq, chakoj taq rehtaal chi re' QaJaaw Dios xiik' naah rotob'il.</para>
  <para style="q">Ruum aj re' q'e' atoob' reh awach i ruuk' i QaJaaw i ruyeew i ruk'ux.</para>
  <para style="q">
    <verse number="9" style="v" />Eh chayohleej taq i QaJaaw Dios</para>
  <para style="q">i hat santo laj raj nimaneel.</para>
  <para style="q">Ruum awach kiyohlinik wach</para>
  <para style="q">i reh inye'arik keh i ajwaal wach chi keh.</para>
  <para style="q">
    <verse number="10" style="v" />Re' taqe i ma' kikojwik ta ree Dios,</para>
  <para style="q">inkikuy kiwa'. Je' rukab' noq</para>
  <para style="q">inkikuy kiwa' i kaq b'ahlam</para>
  <para style="q">Eh re' taqe i kisik'wik reh i Dios</para>
  <para style="q">inye'arik keh chu'nchel i ajwaal wach chi keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Kim chab'iraj taq i hat, i wak'uun wixq'uun noq wilkaat.</para>
  <para style="q">Re' hin naa nuk'uhtaam taq aweh i ruyohljiik i QaJaaw Dios.</para>
  <para style="q">
    <verse number="12" style="v" />Eh wila' re' hat inawaaj chi najt rooq ak'achariik.</para>
  <para style="q">Eh inawaaj awilom wach i suq laj k'acharik,</para>
  <para style="q">
    <verse number="13" style="v" />inchol awik'raam awiib' chi manelik chee yiib' wach q'orik ju' aawaaq'.</para>
  <para style="q">Eh manelik chaloq i chukuj q'orik xaq aachii'.</para>
  <para style="q">
    <verse number="14" style="v" />Chakanaa' rub'aan i yiib' wach na'ojb'al, xa re' chik i holohik cha a'n.</para>
  <para style="q">Eh cha sik' i wihik pansuqkiil k'uxliis maakanaa' chik rub'aan.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Ruum re' taqe korik wach kik'ux re' QaJaaw Dios incha'jinik keh,</para>
  <para style="q">eh i nib'irjik i kitiij.</para>
  <para style="q">
    <verse number="16" style="v" />Eh re' taqe i yiib' wach kib'anik i ruyeew i rujosq'iil i Dios chikinaah.</para>
  <para style="q">Eh i rusach kiwach chinaah i wach ak'al</para>
  <para style="q">reh chi ma' awach ta chik naa ruq'oriik kib'iral.</para>
  <para style="q">
    <verse number="17" style="v" />Eh re' taqe korik wach kik'ux noq inkipahqaaj</para>
  <para style="q">i rotob'il i QaJaaw Dios ki-ib'irjik wo' hoq,</para>
  <para style="q">i resaj taqe chupaam chu'nchel i ruti'kiil kik'ux.</para>
  <para style="q">
    <verse number="18" style="v" />Re' QaJaaw Dios xa wilik</para>
  <para style="q">wo' kuuk' chi kitoob'jiik i ti' wilik i kánima.</para>
  <para style="q">Eh i ruko'leej taqe i xama' naa ta chik</para>
  <para style="q">keliik chupaam i ti' k'axik noq inkik'raaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Re' korik wach ruk'ux xiik' naah i ti' k'axik inchalik chinaah.</para>
  <para style="q">Xa re' la', re' wo' QaJaaw Dios ineesanik reh chupaam.</para>
  <para style="q">
    <verse number="20" style="v" />Re' wo' reh naa ruko'liniik reh</para>
  <para style="q">chi ma' jino'q i rub'aqil naakitoqom.</para>
  <para style="q">
    <verse number="21" style="v" />Re' yiib' wach runa'ojb'al re' wo' re' naa ruk'amwiik reh panti' k'axik.</para>
  <para style="q">Eh re' i ki-ixowanik wach i korik wach ruk'ux naa ruq'atariik i q'orik chikinaah.</para>
  <para style="q">
    <verse number="22" style="v" />Re' QaJaaw Dios inko'linik riij i kik'achariik taqe rumoso.</para>
  <para style="q">Eh ma' naa ta kiye'ariik pantojb'al mahk, ruuk' i reh inkiyeew kik'ux.</para>
  <chapter number="35" style="c" />
  <para style="s">Re' tiij xub'an i reey David pahqb'al reh i rotob'il i QaJaaw Dios</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, kinatoob'eej, chaq'at kiwach i ki-ixowanik nuwach.</para>
  <para style="q">Eh chak'ulb'ilej taqe i peleto inki a'n wuuk'.</para>
  <para style="q">
    <verse number="2" style="v" />Je'-oq pulato ch'ihch' ko'lemb'al iib' awajaawriik.</para>
  <para style="q">Eh je'-oq cha chop cha ch'ihch' reh chi nee kinako'leej.</para>
  <para style="q">
    <verse number="3" style="v" />Chayeew weh awajaawriik je'-oq jino'q q'aslaj ch'ihch',</para>
  <para style="q">reh chi nee kinako'leej pan kiq'ab' i ki-ixowanik nuwach.</para>
  <para style="q">Eh cha q'or chi re' hat naa ako'liniik weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Chi je' re', neenkimol chi elik</para>
  <para style="q">ruum kik'ixiik taqe inkaaj nukanteesjiik.</para>
  <para style="q">Eh nee wo' inkimol chi elik ruum kik'ixiik</para>
  <para style="q">taqe inkaaj kiyojom nuk'ux.</para>
  <para style="q">
    <verse number="5" style="v" />Neeta naq imb'aan keh ruum i ruánjel i QaJaaw Dios,</para>
  <para style="q">je' rukab' imb'aan reh i rutuus ixiim noq inkutarik reje wulu' ruum i teew.</para>
  <para style="q">
    <verse number="6" style="v" />Je' ta naq neenq'equmrik,</para>
  <para style="q">je' ta naq neenkalb'eesjik i kib'eeh ruum i ruánjel i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Ruum re' keh xkikoj nuxirob'aal, xkik'ot i chaamlaj jul</para>
  <para style="q">reh chi nee kinq'ehb'ik chupaam, xanaah re' xama' xta wo' numahk.</para>
  <para style="q">
    <verse number="8" style="v" />Eh nee ta naq insacharik kiwach chi ma' keht'al,</para>
  <para style="q">xirob' kiyejaam, re' ta naq i keh neekiqajik chupaam.</para>
  <para style="q">Eh re' ta naq i keh neekiq'ehb'ik chupaam i chaamlaj jul kik'otom.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Chi je' re', ma' k'isiin ta neensuuqb'ik nuk'ux i hin,</para>
  <para style="q">ruum neenwilow chi re' QaJaaw Dios neenko'linik weh.</para>
  <para style="q">
    <verse number="10" style="v" />Eh chu'nchel i wánima neenuq'or chi je' wili:</para>
  <para style="q">QaJaaw Dios ma' awach ta chi je' rukab' i hat</para>
  <para style="q">ruum re' taqe ti' wilkeeb' xako'leej taqe pan kiq'ab' i kow kiib'.</para>
  <para style="q">Xako'leej taqe i neb'aa' pan kiq'ab' inq'uchwik chib'ih keh, kinko'q.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Wilik taqe yiib' wach kina'ojb'al kitz'aqwik numahk, kinkipech'uj,</para>
  <para style="q">xanaah re' xama' xta wo' numahk.</para>
  <para style="q">
    <verse number="12" style="v" />Re' hin i nub'an otob'il keh re' chik i yiib' wach inki a'n weh chi jilow,</para>
  <para style="q">xa re' nkaaj chi inyoj nuk'ux.</para>
  <para style="q">
    <verse number="13" style="v" />Eh noq xkian i yaab'ilaal xnukoj i nuq'eq' so' ruum ti' nuk'ux chikiij.</para>
  <para style="q">Eh chu'nchel nuk'ux xnuk'ihpechej i nutiij chikiij chi ma' nub'anam ta nuwa' nuhaa'.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hin xtib'ik nuk'ux chikiij, je' taqe wamigo,</para>
  <para style="q">je' taqe was nuchaaq' xnub'an keh.</para>
  <para style="q">Nik' wach noq intib'ik nuk'ux chi riij i nutuut,</para>
  <para style="q">je' re' i xnub'an kekeh, ma' xnukanaa' ta wo' naq i tiij chikiij.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Eh noq xinq'ehb'ik panti' k'axik i hin,</para>
  <para style="q">re' keh junokiik taqe chi nukaqse'ljiik,</para>
  <para style="q">xa je' cho ma' weht'al kiwach xkian kiib'.</para>
  <para style="q">Eh xkimol kiib' ma' inkikanaa' ta rub'aan weh i ti' k'axik.</para>
  <para style="q">
    <verse number="16" style="v" />Xa ma' suq ta chik i nub'an kuum ruum xa kinkikaqse'laaj chik,</para>
  <para style="q">xa nkiqirich'eej chik naah ikehruum i kijosq'iil chi nunaah.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />QaJaaw Dios, ¿Ko nik' chik najtiil naa nuk'ulum i ti' wili?</para>
  <para style="q">Jaaw chako'leej tii wánima, chako'leej riij i nuk'achariik,</para>
  <para style="q">pan kiq'ab' i je' taqe josq'laj kaq b'ahlam re' re'</para>
  <para style="q">
    <verse number="18" style="v" />Chi je' re', neenuq'or rib'iral aawotob'il chikiwach</para>
  <para style="q">i ruk'ihaal tinamiit inkimol kiib'.</para>
  <para style="q">Eh neenuyeew aaloq'il xa aha' pantaq ruk'ihaal tinamit.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Reh chi ma' nee ta kielik korik i ki-ixowanik</para>
  <para style="q">nuwach chi xama' xtarub'ehel.</para>
  <para style="q">Eh ni xata re' naq' kiwach nee nkimutz'muteej</para>
  <para style="q">ruum i ma' nkaaj ta nuwach chi xama' xtarub'ehel.</para>
  <para style="q">
    <verse number="20" style="v" />Eh ma' nkisik' taj i wihik pansuqkiil k'uxliis.</para>
  <para style="q">Re' la' i yiib' wach inkiyejaa' wach chi jot'b'al keh</para>
  <para style="q">tinamit ma' xtaj i yiib' wach k'ahchi' keeb'.</para>
  <para style="q">
    <verse number="21" style="v" />Re' keh xa nkik'er chik kichii' chuq'orariik chi je' wili:</para>
  <para style="q">Atoob' tii re' hoj xti xqilow ruuk' naq'qawach</para>
  <para style="q">chib'ih i xub'an, inki taqe chi wiij.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />QaJaaw Dios, re' hat aweht'al chi ma' xta numahk.</para>
  <para style="q">Maacanaa' chi je' re' inki a'n weh.</para>
  <para style="q">Eh makinakanaa' chi wutkeel.</para>
  <para style="q">
    <verse number="23" style="v" />Wajaaw hat nuDios, kinab'iraj tii, okeen chi wiij.</para>
  <para style="q">Kinako'leej ruum re' hat aweht'al chi korik wach nuk'ux.</para>
  <para style="q">
    <verse number="24" style="v" />Eh chaq'at q'orik chi nunaah ruuk' irub'ehel</para>
  <para style="q">ruum re' hat korik wach ak'ux.</para>
  <para style="q">Reh chi ma' nee ta kinkikaqse'laaj taqe i ki-ixowanik nuwach.</para>
  <para style="q">
    <verse number="25" style="v" />Reh chi ma' nee ta nkiq'or chi je' wili:</para>
  <para style="q">Xti je' aj wo' naq re' inqaaj chi naa ruk'ulum re',</para>
  <para style="q">eh xti xqajot' chi manlik, ma' inko'q ta taqe.</para>
  <para style="q">
    <verse number="26" style="v" />Ma' k'isiin la' neenchalik kik'ixiik taqe</para>
  <para style="q">xasuq chik kik'ux noq k'ahchi' nuk'ulum i ti' k'axik.</para>
  <para style="q">Eh ma' k'isiin wo' neenchalik kik'ixiik</para>
  <para style="q">i xiik' naah i kajaawriik inki a'n kiib' chi nuwach i hin.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Eh re' inkaaj chi naaweliik korik nee ta naq kitz'uyinik</para>
  <para style="q">ruum rusuqkiil kik'ux, nee ta naq inkiq'or chi je' wili:</para>
  <para style="q">Re' QaJaaw Dios nim rajaawriik, q'e' imponik chuwach</para>
  <para style="q">chi suq naa ruwihiik i rumoso, inko'q ta naq taqe.</para>
  <para style="q">
    <verse number="28" style="v" />Re' hin QaJaaw Dios,</para>
  <para style="q">ruuk' nuchii' naa nuq'orom chi korik wach ak'ux.</para>
  <para style="q">Eh chu'nchel q'iij naa kaat nuloq'em.</para>
  <chapter number="36" style="c" />
  <para style="s">Re' yiib' wach na'ojb'al, eh re' i ruk'axb'al i Dios</para>
  <para style="q">
    <verse number="1" style="v" />Re' imb'anik reh i yiib' wach na'ojb'al, xa re' wo' re' wilik cho paránima,</para>
  <para style="q">ma' rukapaaj taj chi yohljik iraaj i Dios.</para>
  <para style="q">
    <verse number="2" style="v" />Re' reh iraaj chi naa ruye'ariik runimaal wach,</para>
  <para style="q">ma' rukoj ta rehtaal chi yiib' wach i rub'an i ma' rukapaaj ta rukanab'jiik i mahk.</para>
  <para style="q">
    <verse number="3" style="v" />Xa ma' holohik ta imb'anik, chukul q'orik,</para>
  <para style="q">xukanaa' taqe rub'aan i holohik chi b'anarik, xukanaa' wo' rub'aan otob'il.</para>
  <para style="q">
    <verse number="4" style="v" />Atoob' ta nah ruch'aht wilik, ar i ruyejaa' wach rub'aan i yiib' wach na'ojb'al.</para>
  <para style="q">Ar choplik chupaam i yiib' wach b'eeh,</para>
  <para style="q">ma' jaruuj ta rukanaa' rub'aan i ma' holohik taj.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Raaj aak'axb'al i hat QaJaaw Dios imponik kopan taxaaj.</para>
  <para style="q">Eh re' suq kiil k'uxliis i nayeew imponik ko aha' wilik cho wii' i suutz'.</para>
  <para style="q">
    <verse number="6" style="v" />Re' rukorkiil wach ana'ojb'al, ma' xata je' najtiil naah i nimaq taq yuuq'.</para>
  <para style="q">Eh re' taqe ruq'or aak'uhb'aal ma' xata je' chamiil paam i palaw.</para>
  <para style="q">Jaaw re' wo' hat ticha'jinik keh, i winaq je' wo' taqe chikop.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />QaJaaw Dios, yohb'aal inche wach i ak'axb'al.</para>
  <para style="q">Ruum xa awuuk' wo' hat inkisik' ko'lemb'al kiib'</para>
  <para style="q">taqe awak'uun awixq'uun, ruuk' aaxiik' i namoheej taqe.</para>
  <para style="q">
    <verse number="8" style="v" />Re' hat ti ye'wik cho keh chi manlik pan aloq'laj</para>
  <para style="q">aa ye'aab' chu'nchel i ajwaal wach chi keh.</para>
  <para style="q">Eh k'achlik rooq ha' i nayeew keh chi uuk'jik.</para>
  <para style="q">
    <verse number="9" style="v" />Ruum xa re' wo' hat ti ye'wik reh i k'acharik,</para>
  <para style="q">re' wo' hat tisaqumb'isanik paam i qakapeb'aal reh chi neenqareq i manlik saqum.</para>
  <para style="q">
    <verse number="10" style="v" />QaJaaw Dios, juneliik ta naq nee naketelaaj kiwach i kieht'alinik awach.</para>
  <para style="q">Eh re' i rub'ehel cha a'n kuuk' i korik wach kik'ux.</para>
  <para style="q">
    <verse number="11" style="v" />Eh maayeew q'ab' chi nee kinkiyeq' pankooq i nimaq kiwach.</para>
  <para style="q">Eh chi neenkian weh iraaj ma' raj b'anarik i yiib' wach kina'ojb'al.</para>
  <para style="q">
    <verse number="12" style="v" />Re' hin weht'al chi re' taqe yiib' wach kina'ojb'al naa rub'aan keh.</para>
  <para style="q">Naa rusachariik kiwach, eh ma' naa ta chik kiwuktiik chi jumpech.</para>
  <chapter number="37" style="c" />
  <para style="s">Re' ruye'ariik k'uxliis ruuk' i Dios</para>
  <para style="q">
    <verse number="1" style="v" />Manchalik aajosq'iil kuum i yiib' wach kina'ojb'al,</para>
  <para style="q">eh maawixowaaj kiwach i ma' holohik ta kib'anik.</para>
  <para style="q">
    <verse number="2" style="v" />Ruum re' keh je' kiyok'arik ch'ahn naa rub'aan.</para>
  <para style="q">Eh xa je' kichiqiik xaq ch'ahn na' ki-ohoq kuxoq.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' hat ruuk' i QaJaaw Dios cha chop ak'ux,</para>
  <para style="q">re' holohik cha a'n, korik-oq wach ak'ux,</para>
  <para style="q">chi je' re' suq naa aak'achariik chupaam i ye'aab' wilkaat wii'.</para>
  <para style="q">
    <verse number="4" style="v" />Eh cha k'ax i QaJaaw Dios chi korik,</para>
  <para style="q">re' reh nee ruyeew aweh taqe inapahqaaj reh chu'nchel awánima.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Chayeew pan q'ab' i QaJaaw Dios ak'achariik,</para>
  <para style="q">eh cha ch'ikaa' ak'ux ruuk', re' reh neentoob'inik aweh.</para>
  <para style="q">
    <verse number="6" style="v" />Re' reh nee rukanaa' chi xasaqum chik wach ana'ojb'al,</para>
  <para style="q">xa je' chik rukab' i rusaqumaal i q'iij noq imponik kab'lajora.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Maa k'er aachii' chuwach i QaJaaw Dios,</para>
  <para style="q">chawuy-eej chi q'uun i rotob'il.</para>
  <para style="q">Manchalik aajosq'iil ruuk' i nelik korik paruk'achariik,</para>
  <para style="q">je' wo' ruuk' inyej-anik wach i yiib' wach chi b'anarik.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Je' re' noq, cha kanaa' i josq'iil, ma' awach ak'ahej,</para>
  <para style="q">ruum re' taqe re' xa ruman i ti' k'axik i ruk'am chaloq.</para>
  <para style="q">
    <verse number="9" style="v" />Re' taqe i yiib' wach kina'ojb'al naa rusahchiik kiwach.</para>
  <para style="q">Eh re' taqe i kichopom kik'ux</para>
  <para style="q">ruuk' i QaJaaw Dios naakehchaam i ye'aab'</para>
  <para style="q">q'orooj cho rib'iral keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' taqe i yiib' wach kina'ojb'al ilook' insahchik kiwach,</para>
  <para style="q">atoob' ta nee naq chik inooj asik' pan kiye'aab'</para>
  <para style="q">ma' naa ta chik areqem taqe ar.</para>
  <para style="q">
    <verse number="11" style="v" />Raaj taqe i xa kiloch'ik naakehchaam i ye'aab'</para>
  <para style="q">q'orooj rib'iral keh.</para>
  <para style="q">Eh naa kianam i rusuqkiil i wihik pansuqkiil k'uxliis.</para>
  <para style="q">
    <verse number="12" style="v" />Re' i yiib' wach runa'ojb'al i ruyejaa'</para>
  <para style="q">wach chi naa rub'anam reh i korik wach ruk'ux,</para>
  <para style="q">eh xa ruqirich'eej chik naah i reeh chinaah.</para>
  <para style="q">
    <verse number="13" style="v" />Re' QaJaaw Dios ruse'laaj i yiib' wach runa'ojb'al,</para>
  <para style="q">ruum reht'al i reh chi ilook' inye'arik chutojariik i ru mahk.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' taqe i yiib' wach kina'ojb'al</para>
  <para style="q">inkesaj chaloq i kiq'aslaj ch'ihch',</para>
  <para style="q">je' wo' kiflecha kantesb'al keh i k'axik wilkeeb',</para>
  <para style="q">taqe i xama' nimaq ta kiwach ruch'ihil</para>
  <para style="q">taqe i korik wach kik'ux.</para>
  <para style="q">
    <verse number="15" style="v" />Xanaah re', xa re' wo' keh naa kikanteesjiik</para>
  <para style="q">ruuk' i kiq'aslaj ch'ihch'</para>
  <para style="q">eh re' kiflecha naa rutoqib'iik.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Re' taqe korik wach kik'ux xa kok' taq tii chib'ih keh wilik,</para>
  <para style="q">xa re' la' xiik' naah loq'il chuwach i kib'ehomal</para>
  <para style="q">i yiib' wach kina'ojb'al.</para>
  <para style="q">
    <verse number="17" style="v" />Ruum re' QaJaaw Dios naa ruye'em q'ab'</para>
  <para style="q">chi naa rub'aan keh i yiib' wach kina'ojb'al.</para>
  <para style="q">Eh re' taqe holohik kina'ojb'al naa rutoob'eem taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Re' QaJaaw Dios reht'al nik' najtiil naa kik'achariik</para>
  <para style="q">i korik wach kik'ux.</para>
  <para style="q">Eh re' kikooch naa ruye'ariik ma' naa ta rusahchiik wach.</para>
  <para style="q">
    <verse number="19" style="v" />Re' keh ma' naa ta kik'uhtaam</para>
  <para style="q">kik'ixb'ilaal na' chaloq i ti' k'axik.</para>
  <para style="q">Eh na' chaloq i wi'jaleel xanaa wo'</para>
  <para style="q">kianam kiwa' kihaa' chi manlik.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Eh re' taqe i yiib' wach kina'ojb'al</para>
  <para style="q">naakiqopiik je' rukab' i sohk'.</para>
  <para style="q">Eh re' taqe i ki-ixowanik wach</para>
  <para style="q">i QaJaaw Dios naa rusahchiik kiwach,</para>
  <para style="q">je' rukab' noq sahchik wach isib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Re' yiib' wach runa'ojb'al noq i rub'an</para>
  <para style="q">rukemeel ma' ruyeew ta chik jilow.</para>
  <para style="q">Raaj i korik wach ruk'ux reh i ruyeew jilow i rukemeel.</para>
  <para style="q">
    <verse number="22" style="v" />Re' taqe irutoob'eej i QaJaaw Dios,</para>
  <para style="q">naakehchaam i ye'aab' q'orooj cho rib'iral keh.</para>
  <para style="q">Raaj taqe i ma' imponik ta chuwach</para>
  <para style="q">i kina'ojb'al ma' naa ta kik'ulariik cho ar.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Re' QaJaaw Dios ink'amwik rub'eeh i korik wach ruk'ux.</para>
  <para style="q">Eh irutoob'eej chub'anariik imponik chuwach i reh.</para>
  <para style="q">
    <verse number="24" style="v" />Re' korik wach ruk'ux atoob' ta neenq'ehb'ik</para>
  <para style="q">panti' k'axik ma' q'ehb'ik ta naa rub'anam chi jumpech,</para>
  <para style="q">ruum re' QaJaaw Dios naa ruksaniik reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Re' hin xnub'an chaloq aak'uniil,</para>
  <para style="q">yu'naak xin rijb'ik chik ma' jank'al ta inwilow</para>
  <para style="q">i korik wach ruk'ux chi kanamaj ta ruum i Dios.</para>
  <para style="q">Eh ma' jank'al ta inwilow taqe i riih rumaam</para>
  <para style="q">chi pahqanik kiwa' chi' taq paat.</para>
  <para style="q">
    <verse number="26" style="v" />Juneliik la' wilik i ketelenik wachiis ruuk',</para>
  <para style="q">i ruyeew chi kemeel i chib'ih reh,</para>
  <para style="q">eh re' taqe riih rumaam kitoob'jiik ruum i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Chakanaa' rub'aan i yiib' wach na'ojb'al,</para>
  <para style="q">re' chik i holohik cha a'n, chi je' re' neen</para>
  <para style="q">wihik aak'achariik chi juneliik.</para>
  <para style="q">
    <verse number="28" style="v" />Re' QaJaaw Dios imponik chuwach i korik.</para>
  <para style="q">Eh re' taqe korik wach kik'ux ruuk' i reh ma' rukanaa' ta taqe.</para>
  <para style="q">Eh re' taqe yiib' wach kina'ojb'al i rusach kiwach</para>
  <para style="q">chi kiih chi kimaam.</para>
  <para style="q">
    <verse number="29" style="v" />Re' taqe korik wach kik'ux naakehchaam i ye'aab'</para>
  <para style="q">eh ar naa kik'achariik chi juneliik.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Re' korik wach ruk'ux wilik runa'ojb'al</para>
  <para style="q">ruuk' taqe chib'ih i ruq'or,</para>
  <para style="q">eh re' wo' taqe rub'ehel i ruq'or.</para>
  <para style="q">
    <verse number="31" style="v" />Ruum re' i ruk'uhb'aal i ruDios wilik cho paránima,</para>
  <para style="q">ruum i re' ma' xta nq'ehb'ik wii'.</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Re' yiib' wach runa'ojb'al xak'ahchi'</para>
  <para style="q">chutahariik i korik wach ruk'ux,</para>
  <para style="q">eh i rusik' chi riij nik' wach noq naa rukansam.</para>
  <para style="q">
    <verse number="33" style="v" />Xa re' la', re' QaJaaw Dios ma' naa ta ruye'em</para>
  <para style="q">q'ab' chi naa rub'anam reh i korik wach ruk'ux,</para>
  <para style="q">ma' naa ta wo' runimam na'kikoj ru mahk.</para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" />Re' hat chayeew ak'ux ruuk' i QaJaaw Dios.</para>
  <para style="q">Eh cha nimaj i ruk'uhb'aal,</para>
  <para style="q">re' reh naa ruye'em awajaawriik chi naa</para>
  <para style="q">awehchaam chi akooch i ye'aab'.</para>
  <para style="q">Eh naa awilom na' sacharoq kiwach i aj mahk.</para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" />Re' hin xwilow wo' naq i yiib' wach runa'ojb'al</para>
  <para style="q">chi xa holohik chik i rub'an riib',</para>
  <para style="q">xa je' naq chik rukab' i rax laj chee' chakaltee' wilik ar Líbano.</para>
  <para style="q">
    <verse number="36" style="v" />Xa re' la', chik imb'anik reh xa xooj wo' hoq,</para>
  <para style="q">xa xsacharik wo' wach,</para>
  <para style="q">xnusik' naq chik ma' aha' ta chik xwilow wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" />Chakoj rehtaal, i xa atoob', eh korik wach ruk'ux.</para>
  <para style="q">Re' reh naa rilom wach i suq laj wihik.</para>
  <para style="q">
    <verse number="38" style="v" />Re' taqe i yiib' wach kina'ojb'al i ma'</para>
  <para style="q">kinimanik taj naa rusahchiik kiwach.</para>
  <para style="q">Eh naa rusachariik kiwach kak'uun kixq'uun.</para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" />Re' taqe korik wach kik'ux re' QaJaaw Dios</para>
  <para style="q">inko'linik keh chupaam i ti' k'axik,</para>
  <para style="q">re' wo' reh inye'wik rukowiil kik'ux.</para>
  <para style="q">
    <verse number="40" style="v" />Re' QaJaaw Dios intoob'inik keh, reh chi ma' xta ki uchjik,</para>
  <para style="q">i ruko'leej taqe pan kiq'ab' i yiib' wach kina'ojb'al,</para>
  <para style="q">ruum ruuk' wo' reh xkisik' ko'lb'al kiib'.</para>
  <chapter number="38" style="c" />
  <para style="s">Re' tiij xub'an i reey David noq xuyot' i ruk'ux chi riij i ru mahk</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, ma' ta naq neekinaq'il ruuk' aajosq'iil.</para>
  <para style="q">Eh ma' ta naq nee kinayeew chutojariik i numahk ruuk' aajosq'iil.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin je' naa ruuk' flecha k'ahchi' a'nam ti' k'axik weh.</para>
  <para style="q">Je' naa xayeew cho chi nunaah i rahliil aaq'ab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Ruum taqe numahk xayeew aajosq'iil chi nunaah,</para>
  <para style="q">ruum aj re' chu'nchel i nuti'jolal xiik' naah ti'kiil wilik.</para>
  <para style="q">Eh re' taqe nub'aqil ma' suq ta wilkeeb'.</para>
  <para style="q">
    <verse number="4" style="v" />Re' taqe nuyiib' wach na'ojb'al xumol riib' chi nunaah,</para>
  <para style="q">xa je' chik rukab' ahl laj ihq xama' nukuy ta chik.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Ruum i rutehkiil nuwach xooj chi nimaal i ruti'kiil nuk'ux</para>
  <para style="q">je' rukab' noq inooj chi nimaal q'aah.</para>
  <para style="q">
    <verse number="6" style="v" />Re' hin xa kink'utzik chik chu'nchel q'iij</para>
  <para style="q">ma' xta rukowiil nuk'ux noq inwik'raaj.</para>
  <para style="q">
    <verse number="7" style="v" />Ruum re' hin xa eliik je' tz'a' wiij,</para>
  <para style="q">chu'nchel i nuti'jolal wilik ruyab'ilaal noq inwik'raaj.</para>
  <para style="q">
    <verse number="8" style="v" />Xa t'aqlik chik i nuti'jolal, xama' xta chik waansil inwik'raaj.</para>
  <para style="q">Eh inchalik woq'iim ruum i ruti'kiil i wánima.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />QaJaaw Dios, re' hat aweht'al chu'nchel</para>
  <para style="q">i k'ahchi' nukapaam rub'aan.</para>
  <para style="q">Eh pan saqum wilik chawach chu'nchel</para>
  <para style="q">i k'ahchi' nupahqaam aweh.</para>
  <para style="q">
    <verse number="10" style="v" />Re' wánima xa tenej chik riib' inwik'raaj.</para>
  <para style="q">Xa ma' xta chik waansil.</para>
  <para style="q">Eh re' naq'nuwach k'ahchi' rupohyiik paam inwik'raaj.</para>
  <para style="q">
    <verse number="11" style="v" />Re' taqe i naah wamigo ruch'ihil taqe i ma' tokoom ta wuuk'</para>
  <para style="q">ma' nkijil ta cho kiib' wuuk' ruum i nuti'kiil.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Eh re' taqe inkaaj nukanteesjiik je' naankikoj nuxo'reel.</para>
  <para style="q">Re' taqe inkaaj nujot'ariik ma' holohik ta kiq'orik chi wiij.</para>
  <para style="q">Chu'nchel q'iij inkiyejaa' wach chib'ih i naa kianam weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Xa re' la', re' hin xa je' ma' imb'iraj i nub'an wiib' chib'ih inkiq'or.</para>
  <para style="q">Eh xa je' hin meem i nub'an wiib' xama' xta wo' i xnuq'or keh.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hin xa je' nukab' jino'q i ma' rib'iraj ta q'orik chi jumpech.</para>
  <para style="q">Eh ma' nchol ta q'orik reh chi nee ta ruko'leej riib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />WaJaaw hat nuDios, inwuy-eej awotob'il,</para>
  <para style="q">re' hat naa aye'wiik weh i nupahqaaj aweh.</para>
  <para style="q">
    <verse number="16" style="v" />Eh xnuq'or chi ma' ta naq nee kinkikaqse'laaj,</para>
  <para style="q">ma' ta naq nee kinq'ehb'ik panti' k'axik,</para>
  <para style="q">reh chi ma' nee ta nsuuqb'ik kik'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Xti korik noq xa k'isiin chik ma' kinq'ehb'ik pamahk,</para>
  <para style="q">re' nuti'kiil ma' kirukanaa' ta jumehq'-oq.</para>
  <para style="q">
    <verse number="18" style="v" />Yu'naak naa nupahqaam kuyb'al numahk,</para>
  <para style="q">ruum q'e' ti' nuk'ux ruum taqe i nub'an.</para>
  <para style="q">
    <verse number="19" style="v" />Re' taqe i ki-ixowanik nuwach kow inki a'n kiib', xi k'ihaaxb'ik,</para>
  <para style="q">yohb'aal kiwach i ma' ki ajwanik ta nuwach chi xama' xta rub'ehel.</para>
  <para style="q">
    <verse number="20" style="v" />Re' otob'il i nub'an yiib' wach na'ojb'al inkitoj riij weh.</para>
  <para style="q">Eh q'e' inkixow nuwach ruum inkilow chi ma'</para>
  <para style="q">nukanaa' ta rub'aan i holohik laj na'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />WaJaaw, hat nuDios, makinakanaa' chi wutkeel.</para>
  <para style="q">Maa kinaq'eb' chi riij ak'ux.</para>
  <para style="q">
    <verse number="22" style="v" />QaJaaw Dios, hat waj ko'loom,</para>
  <para style="q">kinatoob'eej tii chi jumehq'iil.</para>
  <chapter number="39" style="c" />
  <para style="s">Re' noq xuq'or i reey David chi xama' najt ta rooq i k'acharik ayu' wach ak'al</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin xnuq'or naq chi naa wik'raam wiib' ruuk' i nuna'ojb'al,</para>
  <para style="q">chi ma' naa ta numahkuniik ruuk' i ju' waaq'.</para>
  <para style="q">Eh chi naa naq nutz'apam i nuchii' noq ko wilkeeb' ayu'</para>
  <para style="q">i yiib' wach kina'ojb'al.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin xa je' hin meem xnub'an, wiib' ma' xta nuq'or.</para>
  <para style="q">Ni xata naq chi riij i holohik xinq'orik.</para>
  <para style="q">Xa re' la', re' nuti'kiil xooj chunimaal.</para>
  <para style="q">
    <verse number="3" style="v" />Re' wánima xa nyot'ik chik,</para>
  <para style="q">eh noq kinokik chukapeb'jiik riij i k'achi' nuk'ulum,</para>
  <para style="q">xa je' chik inqop ruq'aq'al i wánima noq inwik'raaj,</para>
  <para style="q">ruum i re' kow xnuq'or chi je' wili:</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />QaJaaw Dios inwaaj chi nee nayeew weh</para>
  <para style="q">chi naab'jik chib'ih naa wojiik kuxoq wii'.</para>
  <para style="q">Eh nik' chik najtiil naa nuk'achariik ayu' wach ak'al.</para>
  <para style="q">
    <verse number="5" style="v" />Mi xama' najt ta rooq i nuk'achariik naa aye'em ayu' wach ak'al.</para>
  <para style="q">Korik re' nuk'achariik xama' xta tz'aaq chawach,</para>
  <para style="q">ruum re' k'acharik ayu' wach ak'al xa je' nik'ik junhuup chi teew.</para>
  <para style="q">
    <verse number="6" style="v" />Re' i k'achareel ayu' wach ak'al,</para>
  <para style="q">xa je' nik'ik muuj i ruk'achariik.</para>
  <para style="q">Xa ma' xta neerutiq reh chi nee rumol wach rub'ehomal,</para>
  <para style="q">ruum ma' reht'al taj awach aj eh naa rukahniik.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />QaJaaw Dios, yu'naak ma' awach ta chik i neenwuy-eej</para>
  <para style="q">chi nee kirutob'eej, ruum xa awuuk' wo' hat ch'iklik nuk'ux.</para>
  <para style="q">
    <verse number="8" style="v" />Je' re' noq, cha a'n otob'il kinako'leej chupaam taqe numahk,</para>
  <para style="q">maayeew q'ab' chi nee kinkikaqse'laaj taqe i ma' xta kina'ojb'al.</para>
  <para style="q">
    <verse number="9" style="v" />QaJaaw Dios, re' hin xa je' ma' kinchol q'orik xnub'an wiib',</para>
  <para style="q">xama' xta xnuq'or chi riij i xnuk'ul,</para>
  <para style="q">ruum re' hat aweht'al chib'ih i na a'n wuuk'.</para>
  <para style="q">
    <verse number="10" style="v" />Chakuy manlik i tojb'al numahk xayeew.</para>
  <para style="q">Re' hin xakimik chik weh noq inwik'raaj</para>
  <para style="q">ruum i ti' k'axik xayeew cho chi nunaah.</para>
  <para style="q">
    <verse number="11" style="v" />Re' hat i nayeew chutojariik i ru mahk</para>
  <para style="q">awach inawaaj akojom runa'ojb'al,</para>
  <para style="q">eh nayeew q'ab' chi nk'uxarik ruum</para>
  <para style="q">i rumohol taqe i q'e' looq' reh.</para>
  <para style="q">Je' re' noq, chu'nchel i k'achareel ayu' wach ak'al</para>
  <para style="q">xa je' ki-ik'ik junhuup chi teew.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />QaJaaw Dios chab'iraj tii weh i nutiij.</para>
  <para style="q">Chab'iraj i nuq'or aweh.</para>
  <para style="q">Maacanaa' chi je' re' i nupahqaaj aweh ruuk' oq'ik.</para>
  <para style="q">Ruum xa hin ik'al b'eeh ayu', je' rukab' noq xi ik'ik</para>
  <para style="q">chi k'acharik taqe i numaam wati't</para>
  <para style="q">
    <verse number="13" style="v" />QaJaaw Dios chayeew pee chik cho k'isinoq</para>
  <para style="q">rusuqkiil nuk'ux noq komajaa' kinkimik, kinki.</para>
  <chapter number="40" style="c" />
  <para style="s">Re' reey David xut'iosej reh i QaJaaw Dios parutz'uuy ruum xehteesjik panti' k'axik</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin ruuk' q'unil xwuy-eej i rotob'il i QaJaaw Dios, korehtaal xirib'iraj.</para>
  <para style="q">Eh xuyeew wo' weh i xnupahqaaj reh.</para>
  <para style="q">
    <verse number="2" style="v" />Xiresaj cho chupaam runimaal ruti'kiil k'uxliis</para>
  <para style="q">je' naa pan ch'uwa' xiresaj chaloq.</para>
  <para style="q">Eh je' naa chinaah ab'aj xuyeew i wooq</para>
  <para style="q">reh chi ma' nee ta chik kinsutinik chi wiij.</para>
  <para style="q">
    <verse number="3" style="v" />Eh xuyeew weh i QaJaaw Dios</para>
  <para style="q">chi tz'uuyjik jinaj i ak'laj tz'uuy loq'oomb'al reh.</para>
  <para style="q">Re' wili ma' k'isiin naa kilwiik reh, ruuk' i re' naakiyohleem,</para>
  <para style="q">eh naakiye'em kik'ux ruuk' i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Atoob' reh awach i ruyeew ruk'ux ruuk' i QaJaaw Dios,</para>
  <para style="q">ma' ruk'am ta naah inki a'n i yiib' wach kina'ojb'al.</para>
  <para style="q">Eh ni xata ruloq'ej taqe i tiyoox.</para>
  <para style="q">
    <verse number="5" style="v" />WaJaaw nuDios, ma' k'isiin i sahchb'al k'uxliis xa a'n quuk' ruuk' aawotob'il,</para>
  <para style="q">xa eliik qoh akapaaj.</para>
  <para style="q">Ma' awach ta chik jino'q neemb'anik i na a'n.</para>
  <para style="q">Re' hin inwaaj naq nutusum wach chi ju'junaal taqe i na a'n,</para>
  <para style="q">xa re' la' nee kinsahchik chuq'orariik.</para>
  <para style="q">
    <verse number="6" style="v" />Re' hat ma' imponik ta chawach i mayiij, je' wo' i limóxna.</para>
  <para style="q">Ma' nawaaj ta chi nk'atarik i chikop chi mayiij wach artaal.</para>
  <para style="q">Xateh la' nuxikin reh chi xnureq chi riij.</para>
  <para style="q">
    <verse number="7" style="v" />Re' hin je' wili i xnuq'or: QaJaaw Dios ayu' wilkiin chub'anariik,</para>
  <para style="q">je' rukab' i ruq'or i tz'ihb'amaj cho chi wiij pan santo laj huuj.</para>
  <para style="q">
    <verse number="8" style="v" />WaJaaw nuDios, re' hin imponik chi nuwach rub'anariik inawaaj i hat.</para>
  <para style="q">Eh re' aak'uhb'aal wilik pan wánima chi juneliik.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' hin xnuyeew chi naab'jik i rukorkiil wach ak'ux</para>
  <para style="q">keh ruk'ihaal chi awak'uun awixq'uun.</para>
  <para style="q">Re' hat aweht'al chi ma' nukanaam ta ruq'orariik rib'iral aaloq'il.</para>
  <para style="q">
    <verse number="10" style="v" />Ma' nukanaam ta ruq'orariik i rukorkiil wach ak'ux,</para>
  <para style="q">i nuq'or la' rib'iral chi q'e' hat atoob', eh chi hat aj Ko'loom.</para>
  <para style="q">Je' re' noq ma' jank'al ta nukeb'aa' chikiwach</para>
  <para style="q">i ruk'ihaal chi awak'uun awixq'uun i k'axooj i na a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />QaJaaw Dios, maakanaa' ruketeljiik nuwach,</para>
  <para style="q">nee ta la' naq kinako'leej chi juneliik ruuk' aak'axb'al, ruuk' i korik.</para>
  <para style="q">
    <verse number="12" style="v" />Re' hin yohb'aal wach i ti' k'axik k'ahchi' nuk'ulum.</para>
  <para style="q">K'ahchi' ruk'isimb'iik nuk'ux ruum taqe i numahk,</para>
  <para style="q">je' nche k'ahchi' inche rupohyiik</para>
  <para style="q">paam i naq'nuwach noq inwik'raaj.</para>
  <para style="q">Xti xiik' naah i numahk, ma' xata je' k'ihaal i rismaal i nunaah,</para>
  <para style="q">ma' xta chik rukowiil nuk'ux inwik'raaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />QaJaaw Dios, cha kuy kinako'leej tii.</para>
  <para style="q">Eh kinatoob'eej chi jumehq'iil.</para>
  <para style="q">
    <verse number="14" style="v" />Neeta naq kikahnik chi xase'lb'al</para>
  <para style="q">chik taqe inkaaj nukanteesjiik.</para>
  <para style="q">Neeta naq inkimol chi elik</para>
  <para style="q">ruum kik'ixiik taqe i xa re' i yiib' wach</para>
  <para style="q">na'ojb'al inkikapaaj chi wiij.</para>
  <para style="q">
    <verse number="15" style="v" />Neeta naq inkimol chi elik</para>
  <para style="q">ruum kik'ixiik taqe i kikaqse'lanik weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Eh chu'nchel i kisik'wik aweh</para>
  <para style="q">nee ta naq insuuqb'ik kik'ux.</para>
  <para style="q">Re' taqe ki ajwanik reh i ko'lemb'al iib' i nayeew i hat,</para>
  <para style="q">nee ta naq inkiq'or chi je' wili:</para>
  <para style="q">nim wach i QaJaaw Dios, inko'q ta naq taqe.</para>
  <para style="q">
    <verse number="17" style="v" />QaJaaw Dios, ro'q ta q'e' ketel nuwach,</para>
  <para style="q">atoob' ta q'e' ti' nuk'ux, re' hat naa kiin akapaam</para>
  <para style="q">ruum re' hat titoob'inik weh.</para>
  <para style="q">Eh nee kinawesaj chupaam i ti' k'axik i hat nuDios.</para>
  <chapter number="41" style="c" />
  <para style="s">Re' reey David xupahqaaj parutiij reh i Dios chi naa ruk'achreesjiik ruuk' i ti' wilik wii'</para>
  <para style="q">
    <verse number="1" style="v" />Atoob' reh awach intoob'inik reh i ma' kow ta ruk'ux i ti' wilik,</para>
  <para style="q">ruum re' i QaJaaw Dios naa ruko'liniik reh panti' k'axik.</para>
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw Dios naa rutoob'iniik reh,</para>
  <para style="q">naa ruye'ariik ruk'achariik, naa ruye'ariik i rusuqkiil ruk'ux.</para>
  <para style="q">Ma' naa ta ruye'em q'ab' i QaJaaw chi naa rub'aan reh kuum i aj ixowaal.</para>
  <para style="q">
    <verse number="3" style="v" />Re' QaJaaw Dios naa ruye'wiik rukowiil ruk'ux noq naa ruwihiik pan yokaab'.</para>
  <para style="q">Eh naa ruk'achreesjiik ruuk' i ruyab'ilaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' hin je' wili xnuq'or:</para>
  <para style="q">QaJaaw Dios, chaketelaaj nuwach,</para>
  <para style="q">atoob' ta ximahkunik chawach kina k'achrisaj ruuk' i nuti'kiil, kinki.</para>
  <para style="q">
    <verse number="5" style="v" />Eh re' taqe ki-ixowanik nuwach je' wili inkiq'or chi wiij:</para>
  <para style="q">¿Jaruuj inkimik? ¿Xti jaruuj insahchik wach i rub'ihnaal? inki taqe.</para>
  <para style="q">
    <verse number="6" style="v" />Noq kik'ulik chi wula'jiik, xakojol wehtaal kik'ulik.</para>
  <para style="q">Eh noq kielik reje wuuk'</para>
  <para style="q">xa re' chik inuk'utjiik inki a'n pamb'eeh.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' taqe i ki-ixowanik nuwach inkimol kiib' chi nub'ajariik,</para>
  <para style="q">inkikapaaj i keh chi ruum numahk k'ahchi' nuk'ulum i ti' k'axik.</para>
  <para style="q">
    <verse number="8" style="v" />Eh je' wili inkiq'or chi wiij:</para>
  <para style="q">Re' ruyab'ilaal re' aj yahm inye'wik chinaah.</para>
  <para style="q">Je' re' noq xqajik pan yokaab', ma' jaruuj chik naa ruktiik inki taqe.</para>
  <para style="q">
    <verse number="9" style="v" />Eh re' naq i naah wamigo i ch'iklik naq wii' nuk'ux,</para>
  <para style="q">re' i jinaj naq inqa a'n wii' qawa'</para>
  <para style="q">ruuk' xsutinik chi ixowan nuwach.</para>
  <para style="q">
    <verse number="10" style="v" />Eh re' hin QaJaaw Dios, aweh i hat i nupahqaaj</para>
  <para style="q">chi chaketelaaj nuwach kinak'achrisaj johtoq,</para>
  <para style="q">reh chi neenuyeew chutojariik i ru mahk.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Eh neenunab'eej chimponik chawach i nuna'ojb'al,</para>
  <para style="q">reh chi re' inixowanik nuwach ma' xta neekiruchej,</para>
  <para style="q">ma' nee ta ruq'at nuwach,</para>
  <para style="q">
    <verse number="12" style="v" />QaJaaw Dios, re' hat aweht'al chi ma' xtaj</para>
  <para style="q">i yiib' wach k'ahchi' kiin chawach,</para>
  <para style="q">re' hat naa atoob'iniik weh naa awihiik wuuk' chi juneliik.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Nee ta naq inye'arik ruloq'il chi juneliik i QaJaaw,</para>
  <para style="q">re' i qaDios i hoj, hoj aj Israel</para>
  <para style="q">je' ta wo' naq re'.</para>
  <chapter number="42" style="c" />
  <para style="s">Re' reey David xuq'or chi chiqiij chii' chusik'ariik i Dios</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, re' hin nuchop nuk'ux chasik'ariik,</para>
  <para style="q">je' rukab' i rub'an i keej noq chiqiij chii'</para>
  <para style="q">inooj chusik'ariik ruhaa' korehtaal i rureq.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin chiqiij nuchii' reh rusik'ariik i QaJaaw, re' k'achlik Dios.</para>
  <para style="q">Re' hin xa nwaaj chik ojik chalooq'jiik.</para>
  <para style="q">
    <verse number="3" style="v" />Re' hin chi q'iij chi aq'ab' oq'ik i nub'an,</para>
  <para style="q">ma' nukapaaj ta chik nuwa' nuhaa' ruum.</para>
  <para style="q">Eh rajlaal q'iij inkiq'or weh chi je' wili:</para>
  <para style="q">¿Aha' wilik aaDios inaq'or? inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh noq inyot'ik i wánima ruum taqe re',</para>
  <para style="q">xk'ulik cho panuk'ux noq xnuk'am cho kib'eeh i ruk'ihaal tinamit,</para>
  <para style="q">noq ojik inqa a'n panrupaat i Dios.</para>
  <para style="q">K'erik qachii' ruum rusuqkiil qak'ux, k'ahchi' qat'iosem ree Dios i rotob'il.</para>
  <para style="q">Jinaj runimaal ninq'iij chi qeh.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh xnuq'or chi je' wili:</para>
  <para style="q">¿Chib'ih reet noq q'e' intib'ik nuk'ux</para>
  <para style="q">eh chi ma' nelik ta pan wánima taqe re'?</para>
  <para style="q">Xanaah re' ch'iklik wo' naq nuk'ux ruuk' i nuDios,</para>
  <para style="q">ko nee ruyeew q'ab' chi neenuloq'ej,</para>
  <para style="q">eh chi nee kiruko'leej, kinki.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' hin k'ahchi' ruyojiik nuk'ux ruum i ti' k'axik.</para>
  <para style="q">Ruum aj re' eliik tinukapaaj noq wilkiin</para>
  <para style="q">inaasjik cho wii' i nim ha' Jordán,</para>
  <para style="q">pankiyuq'ul i aj hermonitas, eh chinaah i yuuq' Mizar.</para>
  <para style="q">
    <verse number="7" style="v" />Eh noq imb'iraj i elal ha'</para>
  <para style="q">xa nq'ajb'anik chik i rub'an xilak taq yuuq' eh xumuq'aa' nunaah.</para>
  <para style="q">Je' aj re' noq i rumuq'aa' nunaah i ti' k'axik.</para>
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios rajlaal q'iij ta naq nee nayeew weh aak'axb'al.</para>
  <para style="q">Eh re' hin pantaq chaq'ab' neenutz'uyej awach,</para>
  <para style="q">neenub'an nutiij chawach, ruum re' hat ehchan ree nuk'achariik.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' hin i nuq'or reh chi je' wili i nuDios,</para>
  <para style="q">re' i paat ab'aj ko'lemb'al-iib' chi weh:</para>
  <para style="q">¿Chib'ih reet noq xinsahchik panak'ux?</para>
  <para style="q">¿Chib'ih reet noq xa eliik ti' nuk'ux kuum i ki-ixowanik nuwach? kinki.</para>
  <para style="q">
    <verse number="10" style="v" />Eh re' taqe ki-ixowanik nuwach</para>
  <para style="q">komponik wach nub'aqil ruti'kiil kiq'orik.</para>
  <para style="q">Eh rajlaal q'iij inkiq'or chi je' wili:</para>
  <para style="q">¿Aha' wilik aaDios chib'ih reet noq ma' tirutob'eej? inki taqe weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Eh xuq'or wo' chik chi je' wili:</para>
  <para style="q">¿Chib'ih reet noq q'e' ntib'ik nuk'ux</para>
  <para style="q">eh chi ma' i nelik pan wánima taqe re'?</para>
  <para style="q">Re' hin ch'iklik wo' naq nuk'ux ruuk' i nuDios</para>
  <para style="q">konee ruyeew q'ab' chi nee nuloq'ej,</para>
  <para style="q">chi nee kiruko'leej, kinki.</para>
  <chapter number="43" style="c" />
  <para style="s">Re' reey David xupahqaaj ree Dios chi naa rehtesjiik chupaam i ti' k'axik</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, chaq'at i q'orik chi nunaah,</para>
  <para style="q">cha q'or chi ma' xta numahk.</para>
  <para style="q">Eh kinako'leej chikiwach i tinamit ma' kinimanik taj.</para>
  <para style="q">Kinako'leej chuwach i winaq aj jot'ool ma' holohik tamb'anik.</para>
  <para style="q">
    <verse number="2" style="v" />Ruum re' hat,</para>
  <para style="q">hat nuDios ye'el rukowiil nuk'ux.</para>
  <para style="q">¿Chib'ih reet noq xinsahchik panak'ux? Eh</para>
  <para style="q">¿chib'ih reet noq xa eliik ti' nuk'ux kuum i ki-ixowanik nuwach?</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />QaJaaw Dios, chayeew weh asaquumaal,</para>
  <para style="q">je' wo' i korik.</para>
  <para style="q">Re' re' neekik'amwik nub'eeh reh chi nee kinponik chupaam aapaat,</para>
  <para style="q">wilik pana santo laj ye'aab' Sión.</para>
  <para style="q">
    <verse number="4" style="v" />Eh noq neekimponik chuwach aa artaal QaJaaw Dios</para>
  <para style="q">ar neenutz'uyej awach ruuk' arpa.</para>
  <para style="q">Ruum re' hat, hat nuDios</para>
  <para style="q">ti ye'wik rusuqkiil nuk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh xnuq'or wo' chi je' wili:</para>
  <para style="q">¿Chib'ih reet noq q'e' intib'ik nuk'ux</para>
  <para style="q">eh chi xa re' chik taqe re' i nukapaaj?</para>
  <para style="q">Xanaah re' re' hin ch'iklik wo' naq nuk'ux ruuk'</para>
  <para style="q">i nuDios koneeruyeew q'ab' weh chi nee nuloq'ej,</para>
  <para style="q">eh chi nee kiruko'leej, kinki.</para>
  <chapter number="44" style="c" />
  <para style="s">Re' reey David xupahqaaj parutiij ree Dios chi naa ruko'leem i rutinamiit</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios,</para>
  <para style="q">re' hoj kik'utjaam cho qeh i qamaam qati't,</para>
  <para style="q">qib'iram cho ruuk' qaxikin nik' nimaal aawotob'il a'nam cho kuuk' najtir q'iij,</para>
  <para style="q">eh nik' wach kitoob'jiik xa a'n taqe.</para>
  <para style="q">
    <verse number="2" style="v" />Eh ruuk' b'ila' awajaawriik xawesaj taqe reje ar</para>
  <para style="q">kiloq'inik reh taqe i tiyoox, eh xayeew taqe panti' k'axik.</para>
  <para style="q">Re' b'ila' chik taqe i qamaam qati't xakoj chi patinik chupaam i ye'aab' re' re'.</para>
  <para style="q">
    <verse number="3" style="v" />Eh noq xi okik ar, ma' ruum ta kajaawriik,</para>
  <para style="q">ma' ruum ta chi wilik kiq'aslaj ch'ihch' xkiq'at wach taqe i aj ixowaal.</para>
  <para style="q">Ruum la' awajaawriik i hat,</para>
  <para style="q">xak'uhtaaj awotob'il keh ruum xaketelaaj kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />WaJaaw nuDios. Hat nureey. Qoh ako'leej wo' i hoj</para>
  <para style="q">ruum hoj wo' cho riih rumaam i Jacob.</para>
  <para style="q">
    <verse number="5" style="v" />Ruuk' wo' awajaawriik i hat naa qaq'atam kiwach i aj ixowaal i hoj,</para>
  <para style="q">ma' xta tz'aaq noq naa qa'nam keh ruum re' hat naa atoob'iniik qeh.</para>
  <para style="q">
    <verse number="6" style="v" />Re' hin ma' nutz'e'wacheej taj i nuflecha,</para>
  <para style="q">i nuq'as laj ch'ihch'.</para>
  <para style="q">
    <verse number="7" style="v" />Ruum re' hat naa ako'liniik qeh pan kiq'ab' i ki-ixowanik qawach.</para>
  <para style="q">Eh xakanaa' chi xase'lb'al taqe i ma' qohponik ta pan naq' kiwach.</para>
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios, re' hoj naaqaye'em runimaal awach chi juneliik,</para>
  <para style="q">eh ma' naa ta qakanaam rulooq'jiik aab'ihnaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Xa re' la' yu'naak, hoj akanaam chi qutkeel,</para>
  <para style="q">xak'uhtaaj qak'ixb'ilaal, ma' qoh atoob'eej taj</para>
  <para style="q">noq qoh-ooj chi kik'ulb'ejiik taqe i aj ixowaal.</para>
  <para style="q">
    <verse number="10" style="v" />Eh xayeew q'ab' chi xqamol chi eliik chikiwach</para>
  <para style="q">i ki-ixowanik qawach, eh xkelq'aaj</para>
  <para style="q">i chib'ih qeh i ma' qohponik ta panaq' kiwach.</para>
  <para style="q">
    <verse number="11" style="v" />Xoj aq'asaj pan kiq'ab',</para>
  <para style="q">je' rukab' i tentzun noq kik'amarik reje pan kantesb'al.</para>
  <para style="q">Eh chi xqapuhkaaj qiib' chi kixilak i ma' kinimanik taj.</para>
  <para style="q">
    <verse number="12" style="v" />Xa ma' k'ih ta xoj ak'ayej wii'</para>
  <para style="q">keh i ki-ixowanik qawach,</para>
  <para style="q">xanaah re' xama' xta wo' xak'ax ruuk' i re'.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Eh xak'uhtaaj qak'ixb'ilaal chikiwach</para>
  <para style="q">taqe i tokoom tinamit. Eh chi qoh kikaqse'laaj</para>
  <para style="q">qohkib'aj taqe i qaka'jaah qak'ulaa't.</para>
  <para style="q">
    <verse number="14" style="v" />Xayeew wo' q'ab' chi xojkahnik chi xa je'</para>
  <para style="q">hoj kik'o'naal taqe i tinamit kiloq'inik reh taqe i tiyoox.</para>
  <para style="q">Eh inkik'uyu'saj i kinaah chi qakaqse'liij.</para>
  <para style="q">
    <verse number="15" style="v" />Eh re' hin eqal eqal kink'ixik chikiwach,</para>
  <para style="q">i nuqasaj qohoq i nunaah xama' nwaaj ta chik wilom taqe.</para>
  <para style="q">
    <verse number="16" style="v" />Ma' k'isiin ta nchalik nuk'ixiik ruum i nub'ajariik,</para>
  <para style="q">ruum inkiq'or chi wiij i ki-ixowanik nuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Je' re' taqe i ti' k'axik k'ahchi' qak'ulum,</para>
  <para style="q">xa re' la' xama' xatsahchik ta wo' panqak'ux.</para>
  <para style="q">Eh xama' qakanaam ta wo' runimjiik aak'uhb'aal.</para>
  <para style="q">
    <verse number="18" style="v" />Re' hoj ma' nqakapaaj ta akanab'jiik.</para>
  <para style="q">Eh ma' k'ahchi' ta wo' qakanaam rub'aan</para>
  <para style="q">i xoj ak'uhb'alej cho wii'.</para>
  <para style="q">
    <verse number="19" style="v" />QaJaaw Dios, re' hat xat ye'wik q'ab'</para>
  <para style="q">chi xkian ti' k'axik qeh i ki-ixowanik qawach.</para>
  <para style="q">Xoj ponik paruq'equmaal i kimik.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Wi ta xatqaq'eb' chi riij qak'ux QaJaaw Dios,</para>
  <para style="q">wi ta xqaloq'ej taqe i tiyoox chajilob'aal,</para>
  <para style="q">
    <verse number="21" style="v" />jumehq'iil naq xanab'eej i hat.</para>
  <para style="q">Ruum re' hat aweht'al chu'nchel i wilik</para>
  <para style="q">cho panwánima ma' xtaj i panq'equm wilik chawach.</para>
  <para style="q">
    <verse number="22" style="v" />Eh ruum animjiik i hat eliik qohkaaj kikansam,</para>
  <para style="q">je' rukab' imb'aan keh i tentzun noq</para>
  <para style="q">kik'amarik reje pankanteesb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />QaJaaw Dios, qoh ab'iraj tii,</para>
  <para style="q">¿Chib'ih reet noq je' suq awiriik i na a'n awiib'?</para>
  <para style="q">cha kuy chayeew tii qeh inqapahqaaj aweh,</para>
  <para style="q">maaqoh aq'eb' chi riij ak'ux.</para>
  <para style="q">
    <verse number="24" style="v" />¿Chib'ih reet noq je' cho ma' qoh ab'iraj</para>
  <para style="q">i na a'n awiib' chi xoj sahchik panak'ux</para>
  <para style="q">Eh ma' naaketelaaj ta qawach</para>
  <para style="q">ruuk' i ti' k'axik k'ahchi' qak'ulum?</para>
  <para style="q">
    <verse number="25" style="v" />Re' hoj xama' qakuy ta chik raansil i ti' k'axik,</para>
  <para style="q">xa je' chik qeremaj wach ak'al i qati'jolal noq inqik'raaj.</para>
  <para style="q">
    <verse number="26" style="v" />QaJaaw Dios, maa qoh akanaa' chi qutkeel,</para>
  <para style="q">qoh atoob'eej la' qoh ako'leej chaketelaaj qawach.</para>
  <chapter number="45" style="c" />
  <para style="s">Re' rutz'uuyjiik chi naa rub'anam kaxáro i reey</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin nujinaq i wánima chi holohaq laj q'orik,</para>
  <para style="q">ruum aj re' naa nutz'uyem i wach i reey.</para>
  <para style="q">Re' ju' waaq' xaraaj chik q'orik,</para>
  <para style="q">je' rukab' i rutz'ihb'aal i winaq kow intz'ihb'anik.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Je' wili nuq'or ree reey panutz'uuy.</para>
  <para style="q">Xa re' wo' hat i xiik' naah aholwochiil</para>
  <para style="q">chikiwach taqe i winaq.</para>
  <para style="q">Eh q'e' holohik taqe q'orik i nelik chaloq panachii'.</para>
  <para style="q">Ruum aj re', re' QaJaaw Dios xatrukuxisaj chi juneliik.</para>
  <para style="q">
    <verse number="3" style="v" />Eh chayeew reje aq'as laj ch'ihch' nah atuuq,</para>
  <para style="q">i hat kowlaj winaq. Ruum re' re' naa ruye'wiik</para>
  <para style="q">runimaal awach, eh i naa ruye'wiik aloq'il.</para>
  <para style="q">
    <verse number="4" style="v" />Chayejaa' awiib' hiy chuko'ljiik riij i korik, i rub'ehel,</para>
  <para style="q">naa wo' atoob'eem taqe i xama' nimaq ta kiwach.</para>
  <para style="q">Eh ruuk' awajaawriik naa a'nam i peleto</para>
  <para style="q">korehtaal inaq'at kiwach i aj ixowaal.</para>
  <para style="q">
    <verse number="5" style="v" />Re' hat reey naa a'nam keh i ki-ixowanik awach,</para>
  <para style="q">korehtaal inik'ik chi juntar i kánima aq'as laj ch'ihch',</para>
  <para style="q">re' chik i hat naa akahniik chi taaq'anik chinaah i kitinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />QaJaaw Dios, re' awajaawriik naa ruwihiik</para>
  <para style="q">chi taaq'anik reh juneliik,</para>
  <para style="q">re' taaq'anik re' re' parukorkiil naa a'nam.</para>
  <para style="q">
    <verse number="7" style="v" />Re' hat re' i rub'ehel imponik chawach,</para>
  <para style="q">eh re' yiib' wach inawixowaaj wach.</para>
  <para style="q">Ruum aj re' xusik' chaawach aaDios.</para>
  <para style="q">Eh xiik' nah i rusuqkiil ak'ux xuyeew</para>
  <para style="q">chuwach i xuyeew keh awuch'ihil.</para>
  <para style="q">
    <verse number="8" style="v" />Re' aso' naa runujiik chi nk'ohnik laj i mirra,</para>
  <para style="q">ink'ohnik laj canela. Eh naa kitz'uyem awach</para>
  <para style="q">ruuk' k'ahaam wach q'ooj chupaam aapaat marfil ye'jamaj wii'.</para>
  <para style="q">
    <verse number="9" style="v" />Eh chupaam i paat naa awihiik wii' chi taaq'anik</para>
  <para style="q">ar naa kiwihiik taqe i kixq'uun i reey.</para>
  <para style="q">Eh panasak'aaj naa ruwihiik ixoq reey xoyimaj</para>
  <para style="q">ruuk' i oro, re' ruuk' inchalik pan i ye'aab' Ofir.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Chab'iraj i naa nuq'orom aweh</para>
  <para style="q">i hat rixq'uun i reey, chakoj rehtaal:</para>
  <para style="q">Re' hat maakapaaj chik taqe reje</para>
  <para style="q">awach aweh panapaat, je' wo' hoq aatinamiit.</para>
  <para style="q">
    <verse number="11" style="v" />Re' reey naa ruponiik chuwach aholwochiil.</para>
  <para style="q">Re' chik i reh naa rehchaniik aweh,</para>
  <para style="q">eh xa re' chik i reh naa animam.</para>
  <para style="q">
    <verse number="12" style="v" />Eh re' taqe holohaq xq'un aj Tiro,</para>
  <para style="q">naa ruchaliik kisihim chib'ih aweh.</para>
  <para style="q">Re' taqe i b'ehoom laj tinamit naa rusuuqb'iik</para>
  <para style="q">kik'ux chawiij, naakisik'im awotob'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Wili ixoq reey naa rub'anam kaxáro</para>
  <para style="q">ruuk' i reey yohb'aal wach holwochiil.</para>
  <para style="q">Xoyimaj chi oro i ruso', rixq'uun jinaj chik i reey.</para>
  <para style="q">
    <verse number="14" style="v" />Re' reh xoyimaj ch'ikooj paam i ruso',</para>
  <para style="q">noq naa ruk'amariik reje ruuk' i reey.</para>
  <para style="q">Eh tahqalimaj reje kuum i kok' q'ahxoq</para>
  <para style="q">ma' keht'al ta wach q'o'rinik winaq,</para>
  <para style="q">kuch'ihil taqe i ki ajwanik wach.</para>
  <para style="q">
    <verse number="15" style="v" />Eh noq xi k'amarik reje,</para>
  <para style="q">noq xi okik chupaam i holohik paat</para>
  <para style="q">wilik wii' reey yohb'aal wach suuqb'ik kik'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Re' hat qajaaw reey, re' chik taqe aawak'uun</para>
  <para style="q">naa akojom chi taaq'anik.</para>
  <para style="q">Eh naa wo' akojom taqe chi taaq'anik</para>
  <para style="q">chikinaah chu'nchel i tinamit.</para>
  <para style="q">
    <verse number="17" style="v" />Eh ruuk' i tz'uuy xnub'an wili naa ruye'ariik</para>
  <para style="q">runimaal wach kib'ihnaal jar ch'iht pa' chi</para>
  <para style="q">k'achareel inaakik'iik.</para>
  <para style="q">Reh chi re' taqe tinamit naakiye'em aloq'il chi juneliik.</para>
  <chapter number="46" style="c" />
  <para style="s">Re' QaJaaw Dios wilik quuk' chi qatoob'jiik nik' inchalik i ti' k'axik chi qanaah</para>
  <para style="q">
    <verse number="1" style="v" />Re' QaJaaw Dios inko'linik qeh, re' reh inye'wik rukowiil qak'ux.</para>
  <para style="q">Re' reh intoob'inik qeh noq wilkooj panti' k'axik.</para>
  <para style="q">
    <verse number="2" style="v" />Ruum aj re' ma' nee ta qohyo'jik,</para>
  <para style="q">atoob' ta nee nb'oqib'ik chu'nchel i wach ak'al,</para>
  <para style="q">atoob' ta nenooj qohoq taqe yuuq' paruchamiil i palaw.</para>
  <para style="q">
    <verse number="3" style="v" />Atoob' ta nee nelik i palaw, atoob' ta neenk'uyu'jik</para>
  <para style="q">taqe yuuq' k'ixkaab' ruum i rujosq'iil i palaw</para>
  <para style="q">xama' nee ta wo' qohyo'jik.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' QaJaaw Dios i ruyeew rusuqkiil ruk'ux</para>
  <para style="q">i rusantolaj tinamiit, ruuk' i jinaj rooq ha',</para>
  <para style="q">re' wilik wii' i rusantolaj ye'aab'.</para>
  <para style="q">
    <verse number="5" style="v" />Re' Dios naa ruwihiik pankiyejaal pan kixilak</para>
  <para style="q">i rutinamiit, i ma' xta naa ruyojiik wii' kik'ux.</para>
  <para style="q">Re' reh naa rutoob'iniik keh</para>
  <para style="q">korehtaal inkilow wach i saqum.</para>
  <para style="q">
    <verse number="6" style="v" />Re' tinamit yohb'aal wach i kijosq'iil, eh re' taqe ajaab'ees xakib'arb'otik chik.</para>
  <para style="q">Re' Dios xanik' nee ruq'or chi sacharoq wach i wach ak'al.</para>
  <para style="q">
    <verse number="7" style="v" />Re' QaJaaw Dios nim rajaawriik, wilik quuk' chi qatoob'jiik.</para>
  <para style="q">Re' wo' reh inko'linik qeh re' ruDios i Jacob.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Chab'iraj taq, chakoj taq rehtaal chib'ih jariik</para>
  <para style="q">i xub'an i Dios kuuk' i ki-ixowanik wach i rutinamiit.</para>
  <para style="q">
    <verse number="9" style="v" />Re' reh xupab'aa' i q'aq'inik chi junsuut i wach ak'al,</para>
  <para style="q">xuyeew q'ab' chi xereb'ik i kiflecha.</para>
  <para style="q">Xitoq taqe i kiq'aslaj ch'ihch', eh xuk'at taqe i kikareta reh q'aq'inik.</para>
  <para style="q">
    <verse number="10" style="v" />Re' QaJaaw Dios, je' wili ruq'or: Eh xmahyik</para>
  <para style="q">i q'aq'inik, chanab'eej taq chi re' hin, hin, Dios.</para>
  <para style="q">Eh chi wilik wajaawriik chikinaah taqe tinamit.</para>
  <para style="q">Je' wo' chinaah i rujunsuut i wach ak'al, inki.</para>
  <para style="q">
    <verse number="11" style="v" />Re' QaJaaw Dios nim rajaawriik wilik quuk'.</para>
  <para style="q">Re' reh inko'linik qeh chuwach i ti' k'axik, re' i ruDios i Jacob.</para>
  <chapter number="47" style="c" />
  <para style="s">Re' QaJaaw Dios xti manlik reey chikinaah i tinamitsut i wach ak'al</para>
  <para style="q">
    <verse number="1" style="v" />Chawunchelaal taq i hat tinamit chapoq'poteej taq paam aaq'ab',</para>
  <para style="q">cha k'er taq aachii' chuye'ariik ruloq'il i QaJaaw Dios.</para>
  <para style="q">
    <verse number="2" style="v" />Ruum re' QaJaaw Dios nim rajaawriik yohljik iraaj,</para>
  <para style="q">xti manlik reey chikinaah i tinamit sut i wach ak'al.</para>
  <para style="q">
    <verse number="3" style="v" />Eh xuq'asaj taqe panqaq'ab' chu'nchel i tinamit ki-ixowanik qawach,</para>
  <para style="q">eh xuyeew taqe chi ri'sil i qajaawriik.</para>
  <para style="q">
    <verse number="4" style="v" />Re' i QaJaaw Dios xsik'wik wach i ye'aab', naa ruye'em chi qakooch.</para>
  <para style="q">Re' i ye'aab' q'e' xponik chuwach i Jacob, re' i xk'axarik ruum i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Ruuk' i ruhuupjiik paam i tuun, ruuk' i rutz'uuyjiik wach i Dios</para>
  <para style="q">xi ponik chupaam i rusantolaj ye'aab' i QaJaaw Dios.</para>
  <para style="q">
    <verse number="6" style="v" />Chayeew taq ak'ux chutz'uuyjiik wach i QaJaaw Dios.</para>
  <para style="q">Chutz'uuyej taq wach ruum re' reh i qareey.</para>
  <para style="q">
    <verse number="7" style="v" />Chatz'uyej taq wach ruuk' ana'ojb'al i qaDios</para>
  <para style="q">ruum re' reh manlik reey chikinaah tinamitsut i wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' QaJaaw Dios reey chikinaah i tinamit.</para>
  <para style="q">Wilik chaloq parusantolaj ye'aab' chi taaq'anik.</para>
  <para style="q">
    <verse number="9" style="v" />Re' taqe nimaq wach kajaawriik chupaam tinamit inki a'n jinaj kiwach kuuk'</para>
  <para style="q">irutinamiiti QaJaaw Dios, re' ruDios chaloq i Abraham.</para>
  <para style="q">
    <verse number="10" style="v" />Re' i QaJaaw Dios inko'linik keh i tinamitsut i wach ak'al.</para>
  <para style="q">Eh re' reh inye'arik runimaal wach chikiwach chu'nchel.</para>
  <chapter number="48" style="c" />
  <para style="s">Re' ruholwochiil, re' ruloq'il i ye'aab' Sión</para>
  <para style="q">
    <verse number="1" style="v" />Re' QaJaaw Dios xiik' naah nimaal wach.</para>
  <para style="q">Xti ruk'ul chi naa rulooq'jiik chupaam i rutinamiit,</para>
  <para style="q">je' wo' chinaah i rusantolaj yuuq' Sión.</para>
  <para style="q">
    <verse number="2" style="v" />Re' yuuq' re' re' yohb'aal wach holwochiil i runajtiil naah,</para>
  <para style="q">ar wilik pansak'aaj ree rookb'aal q'iij.</para>
  <para style="q">Eh chu'nchel i tinamit ki ilwik reh insuuqb'ik kik'ux.</para>
  <para style="q">Re' wo' re' i rutinamiit i qareey nim rajaawriik.</para>
  <para style="q">
    <verse number="3" style="v" />Re' QaJaaw Dios ar wilik chupaam tinamit Jerusaleem,</para>
  <para style="q">re' reh inko'linik reh i rutinamiit re' re'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' taqe reey wilkeeb' chupaam i ju'jun chi tinamit,</para>
  <para style="q">xkimol cho kiib' chi peleto ruuk' i tinamit re' re'.</para>
  <para style="q">
    <verse number="5" style="v" />Xa re' la' noq xkilow wach i tinamit Jerusaleem</para>
  <para style="q">xsahchik kik'ux, xi kahnik meem, eh xkimol chi elik.</para>
  <para style="q">
    <verse number="6" style="v" />Eh xchalik kib'arb'otiik ruum kiyo'jiik,</para>
  <para style="q">xichoparik ruum jinaj ti' je' rukab' i ruti'kiil ixoq noq ink'ulik ruk'ux.</para>
  <para style="q">
    <verse number="7" style="v" />Je' rukab' i kowlaj teew inchalik pareelb'aal q'iij</para>
  <para style="q">xsachwik kiwach taqe i barco kichalik Tarsis.</para>
  <para style="q">
    <verse number="8" style="v" />Eh parutinamiit i QaJaaw Dios, nim rajaawriik,</para>
  <para style="q">qilom ruuk' naq'qawach,</para>
  <para style="q">je' rukab' i kik'utjaam cho qeh.</para>
  <para style="q">Chi re' Dios naa rukojom chi rutinamiit chi jumpech i Jerusaleem,</para>
  <para style="q">eh chi naa ruko'leem.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />QaJaaw Dios, noq wilkooj chupaam i santo laj aapaat,</para>
  <para style="q">ink'ulik cho panqak'ux chi re' hat q'e' naaketelaaj qawach.</para>
  <para style="q">
    <verse number="10" style="v" />QaJaaw Dios, chu'nchel i tinamit</para>
  <para style="q">sut i wach ak'al kiye'wik aloq'il.</para>
  <para style="q">Eh inkiyeew runimaal wach aab'ihnaal ruum parub'ehel i na a'n i taaq'anik.</para>
  <para style="q">
    <verse number="11" style="v" />Eh naa rusuuqb'iik kik'ux wilkeeb' chinaah i yuuq' Sión.</para>
  <para style="q">Naa wo' kipisk'anik pankooq ruum rusuqkiil kik'ux taqe i aj Judá</para>
  <para style="q">ruum rub'ehel i xayejaa' wach chi naa a'nam.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' taq i hat cha sutej taq riij i ye'aab' Sión,</para>
  <para style="q">chawajlaaj taq jarub' inajt naah tz'aq wilik reh.</para>
  <para style="q">
    <verse number="13" style="v" />Eh chakoj taq rehtaal i tz'aq kotimaj wii' riij,</para>
  <para style="q">je' wo' hoq i holohaq paat wilkeeb' chupaam.</para>
  <para style="q">Reh chi nee taq inak'utjaaj keh awiih aamaam.</para>
  <para style="q">
    <verse number="14" style="v" />Naa taq aq'orom rib'iral chi je' re' i xub'an i</para>
  <para style="q">QaJaaw Dios. Eh chi re' reh i qaDios, chi juneliik.</para>
  <para style="q">Re' wo' reh naa ruk'amwiik qab'eeh</para>
  <para style="q">chi juneliik atoob' ta hoj chik kamnaq.</para>
  <chapter number="49" style="c" />
  <para style="s">Ma' toob' taj i ye'ej k'uxliis chinaah i b'ehomal</para>
  <para style="q">
    <verse number="1" style="v" />Hat taq tinamit, wilkaat taq chi junsuut</para>
  <para style="q">i wach ak'al chab'iraj taq i naa nuq'orom.</para>
  <para style="q">
    <verse number="2" style="v" />Wilik taq awajaawriik, taq i hat ma' nimaq ta taq awach,</para>
  <para style="q">chi b'ehoom, chi neb'aa' chab'iraj taq.</para>
  <para style="q">
    <verse number="3" style="v" />Re' hin naa nuq'orom i nimaq kiwach na'ojb'al.</para>
  <para style="q">Eh naa nuq'orom i nimaq kiwach kapeew.</para>
  <para style="q">
    <verse number="4" style="v" />Eh naa nuq'orom taq aweh i na'ojb'al xiik' naah k'ayewal wach,</para>
  <para style="q">ruuk' i arpa naa nutz'uyiniik noq naa nuq'orom taq aweh.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />¿Chib'ih reet noq naa nuyo'jiik noq neenk'u'loq i ti' k'axik chi nunaah.</para>
  <para style="q">Eh je' wo' noq neenkian weh i ti' k'axik i aj ixowaal?</para>
  <para style="q">
    <verse number="6" style="v" />Re' keh inkiyeew kik'ux chinaah i kib'ehomal.</para>
  <para style="q">Eh q'e' inkinimb'isaj kiwach ruum ma' k'isiin i chib'ih keh.</para>
  <para style="q">
    <verse number="7" style="v" />Xa re' la' xama' awach ta wo' hoq i neeruko'leej riib' ruuk' i chib'ih reh</para>
  <para style="q">ruum ma' nee ta ruyeew riib' chi nee ruloq' i ruk'achariik ruuk' i Dios.</para>
  <para style="q">
    <verse number="8" style="v" />Ma' awach, taj i neerub'an ruloq'ariik chi nee ta inko'ljik riij i ruk'achariik</para>
  <para style="q">ruum ma' nee ta wo' inkuyjik tz'aaq.</para>
  <para style="q">
    <verse number="9" style="v" />Eh ma' awach taj i neerub'an ruloq'ariik i ruk'achariik</para>
  <para style="q">chi ma' ta neenkimik reje chi jumpech ayu' wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Eh ink'utinik chi chu'nchel i k'achareel kikimik reje.</para>
  <para style="q">Nik' wach noq inkimik i wilik runa'ojb'al</para>
  <para style="q">je' wo' re' noq inkimik i ma' xta runa'ojb'al,</para>
  <para style="q">re' kib'ehomal tokoom chik aj eh inkahnik.</para>
  <para style="q">
    <verse number="11" style="v" />Re' keh atoob' ta kikojom</para>
  <para style="q">pankib'ihnaal i ruhujil i kak'aal</para>
  <para style="q">xama' naa ta wo' rukahniik keh chi jumpech.</para>
  <para style="q">Ruum re' i jul naakimuhqiik wii'</para>
  <para style="q">naa rukahniik chi kiye'aab' chi jumpech.</para>
  <para style="q">
    <verse number="12" style="v" />Re' k'achareel ayu' wach ak'al ma' naa ta ruk'achariik ayu' chi juneliik,</para>
  <para style="q">xanaa wo' rukimiik reje, je' rukab' noq kikimik reje i chikop.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' taqe inkich'ikaa' kik'ux xa chi kib'il kiib',</para>
  <para style="q">je' wo' taqe inkiyeew kik'ux chinaah i kib'ehomal je' wili kiooj kuxoq wii'.</para>
  <para style="q">
    <verse number="14" style="v" />Eh naakik'ulum keh je' rukab' inkik'ul i tentzun noq kimuq'ub'jiik,</para>
  <para style="q">eh re' i korik wach kik'ux naa ruq'atwiik kiwach na' ponoq i q'iij.</para>
  <para style="q">Re' keh naa kikahniik chi ma' xta chik kajaawriik,</para>
  <para style="q">re' kijuul naa rukahniik chi kiye'aab' chi jumpech.</para>
  <para style="q">
    <verse number="15" style="v" />Raaj i hin re' QaJaaw Dios naa ruko'liniik reh i wánjel nut'iosil</para>
  <para style="q">ma' naa ta rukahniik chi muqlik chi jumpech, naa la' ruk'amam johtoq ruuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Re' hat mantib'ik ak'ux wila' awach i xb'ehoomrik,</para>
  <para style="q">eh wi xuyejaa' ruholohaq paat.</para>
  <para style="q">
    <verse number="17" style="v" />Ruum na'kimoq ma' naa ta ruk'amam reje i rub'ehomal.</para>
  <para style="q">Ni xata re' i runimaal wach naa ruk'amam reje chi riij.</para>
  <para style="q">
    <verse number="18" style="v" />Atoob' ta naq enche yohb'aal wach suq kiil ruk'ux</para>
  <para style="q">noq ko k'acharik i rub'an ayu' wach ak'al.</para>
  <para style="q">Atoob' ta naq ye'aroq runimaal wach kuum i tinamit,</para>
  <para style="q">
    <verse number="19" style="v" />Naa ruponiik i q'iij noq naa rukimiik.</para>
  <para style="q">Eh ma' naa ta chik rilom wach i saqum chi jumpech.</para>
  <para style="q">
    <verse number="20" style="v" />Re' ju'jun chi k'achareel ma' rureq ta chi riij.</para>
  <para style="q">Atoob' ta yohb'aal wach b'ehomal xanaa wo'</para>
  <para style="q">rukimiik reje, je' rukab' noq kikimik reje i chikop.</para>
  <chapter number="50" style="c" />
  <para style="s">Re' Dios parub'ehel i ruq'at q'orik chinaah i tinamit</para>
  <para style="q">
    <verse number="1" style="v" />Re' QaJaaw Dios nim rajaawriik, i ma' xta chik jino'q Dios chuwach.</para>
  <para style="q">Re' reh xuq'oreej xuyuq'eej taqe i tinamitsut i wach ak'al.</para>
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw Dios chupaam i ye'aab' Sión xuk'uhtaaj i ruloq'il,</para>
  <para style="q">je' wo' hoq i rusaqumaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh re' Dios ma' xata je' wili noq naa ruk'uliik,</para>
  <para style="q">peet la' cho chuwach i q'aaq' aj kansaneel.</para>
  <para style="q">Eh pa runimaal kaaq suut teew naa ruk'uliik iloq.</para>
  <para style="q">
    <verse number="4" style="v" />Re' QaJaaw Dios, naa ruq'oreem i wilkeeb' pan taxaaj,</para>
  <para style="q">i wilkeeb' wach ak'al, reh chi naa kilom noq naa ruq'atam i q'orik chinaah i rutinamiit.</para>
  <para style="q">
    <verse number="5" style="v" />Eh je' wili naa ruq'orom: Kimol kiib' taqe i nuSantolaj aj nimaneel.</para>
  <para style="q">Re' i kiq'orom chi naa kianam inwaaj noq xkik'at i kimayiij chi nuwach, inko'q.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taqe wilkeeb' pan taxaaj kiq'orik chi re' qaDios korik wach ruk'ux.</para>
  <para style="q">Eh chi parub'ehel inq'atwik q'orik.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Chab'iraj taq i hat aj Israel hat taq nutinamiit</para>
  <para style="q">re' hin naa nutehem wach taqe i ma' holohik</para>
  <para style="q">ta taq i na a'n. Re' hin, hin taq aaDios.</para>
  <para style="q">
    <verse number="8" style="v" />Re' hin ma' ruum ta chi ma' nayeew ta taq</para>
  <para style="q">amayiij k'ahchi' taq kaatnuq'ilim,</para>
  <para style="q">ruum re' taq i hat juneliik i nak'am taq chaloq ak'atoj mayiij.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hin ma' k'ahchi' ta nupahqaam</para>
  <para style="q">taq aweh aak'isa imas wakax,</para>
  <para style="q">ni xata re' i kok' imas kaprax wilkeeb' taq panakoraal.</para>
  <para style="q">
    <verse number="10" style="v" />Ma' k'ahchi' ta nupahqaam taq aweh,</para>
  <para style="q">ruum weh chu'nchel i chikop,</para>
  <para style="q">chi je' taqe josq'laj chikop wilkeeb' pantaq ch'ahn,</para>
  <para style="q">chi je' aachikoop taq i hat.</para>
  <para style="q">
    <verse number="11" style="v" />Wehin taqe i chikop kirupinik</para>
  <para style="q">pan taxaaj wilkeeb' paraxchee',</para>
  <para style="q">je' wo' chu'nchel i chikop</para>
  <para style="q">inkik'er kichii' pantaq ch'ahn.</para>
  <para style="q">
    <verse number="12" style="v" />Eh nee ta inchalik nunuhmiik ma' nee ta wo'</para>
  <para style="q">naq taq i nupahqaaj nuwa' aweh,</para>
  <para style="q">ruum weh chu'nchel i wach ak'al,</para>
  <para style="q">je' wo' i wilkeeb' chupaam.</para>
  <para style="q">
    <verse number="13" style="v" />¿Mi nuk'ux re' i kitib'kaal i kok' imas wakax,</para>
  <para style="q">eh mi nwuk'ej re' i kikik'eel i kok' imaas</para>
  <para style="q">kaprax noq inakapaaj taq i hat?</para>
  <para style="q">
    <verse number="14" style="v" />Re' i mayiij inwaaj i hin, re' chi naa taq kinaloq'em,</para>
  <para style="q">eh re' chi naa taq a'nam aq'orom taq</para>
  <para style="q">weh i hin i Dios nim wajaawriik.</para>
  <para style="q">
    <verse number="15" style="v" />Kinaq'oreej taq awuuk' nik' ti' taq wilkaat,</para>
  <para style="q">re' hin nee taq ti wesaj chupaam.</para>
  <para style="q">Eh re' taq i hat nee taq i nayeew nuloq'il, inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Eh re' Dios je' wili i ruq'or keh</para>
  <para style="q">i yiib' wach kina'ojb'al:</para>
  <para style="q">¿Chib'ih reet noq inaq'or taq i nuk'uhb'aal,</para>
  <para style="q">eh inaq'or taq rib'iral i xuk'ul nuk'ux?</para>
  <para style="q">
    <verse number="17" style="v" />Xa nah re' ma' ruk'ul ta taq ak'ux chi tinuq'il taq.</para>
  <para style="q">Eh ma' nayeew ta wo' taq rajaawriik i nuq'oral.</para>
  <para style="q">
    <verse number="18" style="v" />Re' chik inche taqe i ajileq' inak'ul awuuk' panotob'il.</para>
  <para style="q">Eh je' wo' taqe inkich'uwa'risaj wach i kikaxaro.</para>
  <para style="q">
    <verse number="19" style="v" />Re' taqe ma' holohik taj, re' taqe tz'aqaj wach q'orik,</para>
  <para style="q">ra'j xti ma' nim k'ayeew ta noq i nelik taq cho ju' aawaaq' re'.</para>
  <para style="q">
    <verse number="20" style="v" />Re' taq i hat inakoj taq kimahk taqe aahermano.</para>
  <para style="q">Eh ma' holohik taa taq ti q'orik</para>
  <para style="q">chikiij i jinaj taq atuut awajaaw kuuk'.</para>
  <para style="q">
    <verse number="21" style="v" />Eh re' hin majaa' chih i nuq'or chi riij taqe re',</para>
  <para style="q">inakapaaj naa taq i hat chi eliik wach nuna'ojb'al taq awuuk'.</para>
  <para style="q">Yu'naak naa taq kaatnuq'ilim,</para>
  <para style="q">naa taq nuq'orom aweh i k'ahchi' taq kaat re' re'.</para>
  <para style="q">
    <verse number="22" style="v" />Chab'iraj taq i nuq'or wili,</para>
  <para style="q">taq i hat i xinsahchik taq panak'ux,</para>
  <para style="q">ruum nee-oq taq tinuyeew panti' k'axik.</para>
  <para style="q">Eh mo'-oq awach taq chik neenko'linik aweh.</para>
  <para style="q">
    <verse number="23" style="v" />Eh awach re' i nulooq'jiik i ruyeew chi jilow rumayiij,</para>
  <para style="q">i ruyeew runimaal nuwach, eh i rub'an inwaaj,</para>
  <para style="q">re' hin naa nuko'liniik reh, inki Dios.</para>
  <chapter number="51" style="c" />
  <para style="s">Re' reey David xupahqaaj kuyb'al ru mahk ree Dios</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios ruuk' ak'axb'al</para>
  <para style="q">chaketelaaj tii nuwach.</para>
  <para style="q">Eh ruuk' i runimaal aawotob'il</para>
  <para style="q">chajux taqe i ruyib'kiil wach i nuna'ojb'al.</para>
  <para style="q">
    <verse number="2" style="v" />Chatz'aj iloq i ma' holohik taj i nub'an.</para>
  <para style="q">Xti chawesaj iloq taqe numahk.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Ruum re' hin xnukoj rehtaal chi ma' tinunimaj taj,</para>
  <para style="q">re' i numahk ma' jaruuj iraaj elik pan wánima.</para>
  <para style="q">
    <verse number="4" style="v" />QaJaaw Dios, re' hin xa re' i yiib' wach,</para>
  <para style="q">xa re' i mahk i nub'an chawach.</para>
  <para style="q">Eh xa re' chik i ma' imponik ta chawach i nub'an,</para>
  <para style="q">ruum i re' parub'ehel xaq'at i q'orik chi nunaah,</para>
  <para style="q">xti ruk'ul chi je' re' i xa a'n</para>
  <para style="q">
    <verse number="5" style="v" />Xti korik noq xa hin wo' aj mahk noq xintz'uhkrik chaloq.</para>
  <para style="q">Eh xa pamahk wo' hin cho aasjinaq ruuk' i nutuut.</para>
  <para style="q">
    <verse number="6" style="v" />Re' hat QaJaaw Dios xtimponik chawach i korik.</para>
  <para style="q">Eh xayeew weh chi naab'jik kopan wánima i holohik laj na'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Chatz'aj iloq i numahk ruuk' q'ab' chee' hisopo.</para>
  <para style="q">Chatz'aj iloq i numahk reh chi neenkahnik chi xasaq saq</para>
  <para style="q">chik i wánima, xa je' chik rukab' i saq laj suutz'.</para>
  <para style="q">
    <verse number="8" style="v" />Chayeew wo' chik rusuqkiil nuk'ux,</para>
  <para style="q">makinakanaa' chi ntz'irik nuwach.</para>
  <para style="q">Reh chi neenik'ik i nuti'kiil xinawik'saj wii'.</para>
  <para style="q">
    <verse number="9" style="v" />Chawesaj panaq'awach chu'nchel i numahk,</para>
  <para style="q">chajux chu'nchel i yiib' wach xnub'an.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />QaJaaw Dios, chasaqb'isaj wach i wánima.</para>
  <para style="q">Chajal wach i wánjel nut'iosil reh chi</para>
  <para style="q">neenub'an i korik chawach.</para>
  <para style="q">
    <verse number="11" style="v" />Maa kinaq'eb' tii chi riij ak'ux,</para>
  <para style="q">eh maawesaj pan wánima aSantolaj Uxlab'al.</para>
  <para style="q">
    <verse number="12" style="v" />Chayeew wo' chik weh i suq kiil k'uxliis</para>
  <para style="q">i ruyeew i ko'lemb'al iib'.</para>
  <para style="q">Eh chayeew rukowiil nuk'ux ruuk'</para>
  <para style="q">aSantolaj Uxlab'al q'e' atoob'.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Reh chi neenuk'uhtaaj keh aab'eeh</para>
  <para style="q">i ma' kinimanik taa weh,</para>
  <para style="q">reh chi nee wo' chik ti kinimaj taqe aj mahk.</para>
  <para style="q">
    <verse number="14" style="v" />QaJaaw Dios, aj ko'len weh, makinayeew</para>
  <para style="q">tii chi tojariik i numahk chi riij ikaansanik xnub'anam,</para>
  <para style="q">ruuk'tz'uuy neenuq'or chi korik wach ak'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />QaJaaw Dios, kinatoob'eej reh chi ma'</para>
  <para style="q">nim k'ayeew ta noq neenteh i nuchii' reh alooq'jiik.</para>
  <para style="q">
    <verse number="16" style="v" />Ruum re' hat ma' re' ta wo' mayiij inawaaj,</para>
  <para style="q">nee ta nuyeew aweh i k'atoj chikop chi numayiij</para>
  <para style="q">xama' nee ta wo' naq inawaaj.</para>
  <para style="q">
    <verse number="17" style="v" />Re' mayiij inawaaj i hat QaJaaw Dios</para>
  <para style="q">re' chi naa nuyot'om i wánima re' yot'oj k'uxliis chi riij mahk.</para>
  <para style="q">Ruum re' hat ma' nee ta naq'eb' awach</para>
  <para style="q">ineeruloch' riib' chawach.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Chaketelaaj ta tii wach i Sión.</para>
  <para style="q">Eh chayeew wo' chik q'ab' chi neen korjik</para>
  <para style="q">i tz'aq kotimaj wii' riij i tinamit Jerusaleem.</para>
  <para style="q">
    <verse number="19" style="v" />Eh neenak'ul i mayiij imponik chawach.</para>
  <para style="q">Eh nee wo' nak'ul taqe chikop chi neenk'atarik</para>
  <para style="q">chi mayiij chawach, eh neekik'atarik</para>
  <para style="q">i kok' imas wakax chinaah aa artaal.</para>
  <chapter number="52" style="c" />
  <para style="s">Xa ma' xta nkih chi runimb'isaj riib' i yiib' wach runa'ojb'al</para>
  <para style="q">
    <verse number="1" style="v" />Re' Dios aj keteloom wachiis chi juneliik. Raaj i hat i wilik awajaawriik i na a'n awiib'</para>
  <para style="q">¿Chib'ih reet noq i naa niimb'isaj awach ruuk' i rub'anariik ayiib' wach na'ojb'al?</para>
  <para style="q">
    <verse number="2" style="v" />Re' hat i yiib' wach ana'ojb'al,</para>
  <para style="q">xa re' chukuj q'orik i nelik cho panachii', re' aawaaq' je' rukab' i q'aslaj ch'ihch'.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i yiib' wach imponik chawach, chuwach i holohik.</para>
  <para style="q">Eh re' i chukuj q'orik imponik chawach, chuwach i korik.</para>
  <para style="q">
    <verse number="4" style="v" />Re' hat xa re' jot'ooj inawaaj ruuk' aawaaq',</para>
  <para style="q">q'e' imponik chawach taqe q'orik imb'anik sachooj.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' hat naa rusacham awach i Dios chi jumpech,</para>
  <para style="q">naa kaat ruchopom chaloq naa kaat resam cho chupaam aaye'aab'.</para>
  <para style="q">Eh naa rusacham wach aak'achariik.</para>
  <para style="q">
    <verse number="6" style="v" />Eh noq naakilom i korik wach kik'ux i naa ak'ulum, naa kiyo'jiik.</para>
  <para style="q">Naa kaat kikaqse'laam je' wili naa kiq'orom chawiij:</para>
  <para style="q">
    <verse number="7" style="v" />Chawilow taq i xuk'ul i ma' rusik' taj i ko'lemb'al riib' ruuk' i Dios,</para>
  <para style="q">re' i ruch'ikaa' i ruk'ux chinaah i ma' k'isa rub'ehomal.</para>
  <para style="q">Eh xa re' i yiib' wach i rub'an, inko'q taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Eh re' hin je' nukab' i chee' olivo rax wach i xaq,</para>
  <para style="q">ruum parupaat i QaJaaw Dios naa nuwihiik.</para>
  <para style="q">Eh juneliik naa nuye'em nuk'ux ruuk' i nuDios,</para>
  <para style="q">ruum i ruketelaaj nuwach.</para>
  <para style="q">
    <verse number="9" style="v" />QaJaaw Dios, re' hin juneliik naa nut'iosem aweh i xa a'n,</para>
  <para style="q">re' hin naawuy-eem awotob'il.</para>
  <para style="q">Ruum re' hat q'e' hat atoob' kuuk' i asantolaj aj nimaneel.</para>
  <chapter number="53" style="c" />
  <para style="s">Re' yiib' wach na'ojb'al inki a'n i ma' kinimanik ta ree Dios</para>
  <para style="q">
    <verse number="1" style="v" />Re' i ma' kinimanik taj,</para>
  <para style="q">inkiq'or chi ma' xta Dios.</para>
  <para style="q">Chi kunchelaal xkiq'eb' kiib', xa re' chik i yiib' wach na'ojb'al inki a'n</para>
  <para style="q">Ma' jino'q keh imb'anik i korik.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw Dios kopan taxaaj rilow chaloq</para>
  <para style="q">taqe i tinamit mi wilik jino'q</para>
  <para style="q">chi kixilak i wilik runa'ojb'al</para>
  <para style="q">reh chi neenimjik i reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Xa re' la' chi kunchelaal xkichop q'ab'</para>
  <para style="q">rub'anariik i yiib' wach na'ojb'al.</para>
  <para style="q">Ma' awach keh imb'anik reh i holohik laj na'ojb'al</para>
  <para style="q">ni xata naq jinaj keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' taqe ma' xta kina'ojb'al ma' holohik ta kib'anik,</para>
  <para style="q">k'ahchi' kik'uxum i nutinamiit je' nk'uxarik kaxlanwi'k inki a'n</para>
  <para style="q">Re' taqe re' ma' nkikapaaj ta kitiij inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' i rutinamiit i Dios naa rik'iik i kiyo'jiik.</para>
  <para style="q">Ruum re' Dios xa aha' naa rukanaam tzuub' i kib'aqil taqe inixowanik kiwach.</para>
  <para style="q">Eh naakik'uhtaam kik'ixb'ilaal,</para>
  <para style="q">ruum ma' naa ta kikojariik paruman ruum i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Ruuk' ta naq i QaJaaw Dios wilik cho Sión nee nelik chaloq</para>
  <para style="q">i ko'lemb'al kiib' i aj Israel re' taqe i riih rumaam i Jacob.</para>
  <para style="q">Re' noq re' Dios naa resam chaloq i rutinamiit pan tokoom tinamit,</para>
  <para style="q">nee naq insuuqb'ik kik'ux.</para>
  <chapter number="54" style="c" />
  <para style="s">Re' reey David xupahqaaj ree Dios chi naa ruko'ljiik pan kiq'ab' i aj ixowaal</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios panab'ihnaal ta naq neekinko'ljik.</para>
  <para style="q">Neeta tii kinako'leej ruuk' i runimaal awajaawriik.</para>
  <para style="q">
    <verse number="2" style="v" />Hat nuDios, chab'iraj tii i nutiij.</para>
  <para style="q">Eh chayeew tii weh i nupahqaaj aweh.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Ruum re' hin yohb'aal wach i kik'aah chi nunaah i tinamit i ki-ixowanik nuwach,</para>
  <para style="q">kinkaaj kiin kikansam.</para>
  <para style="q">Re' taqe re' ma' tikikapaaj ta k'isinoq i hat.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' hat neetiko'linik weh pan kiq'ab' taqe re', ruum re' hat, hat nuDios.</para>
  <para style="q">Re' hat naa ako'liniik riij i nuk'achariik.</para>
  <para style="q">
    <verse number="5" style="v" />Chasutej wach kinaah i inkiyejaa' wach i ki-ixowanik nuwach.</para>
  <para style="q">Chasach kiwach ruum re' hat parub'ehel inaq'at i Q'orik.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Eh re' hin, QaJaaw Dios xti panuk'ux neenchalik</para>
  <para style="q">chi neenuyeew i numayiij chawach, eh neenuloq'ej ab'ihnaal.</para>
  <para style="q">
    <verse number="7" style="v" />Ruum chi nee kinawesaj chupaam i chu'nchel ruti'kiil nuk'ux,</para>
  <para style="q">eh chi neenasach kiwach taqe i ki-ixowanik nuwach.</para>
  <chapter number="55" style="c" />
  <para style="s">Re' rutiij xub'an i reey David noq xq'ahteesjik naq pankimik ruum i ramigo</para>
  <para style="q">
    <verse number="1" style="v" />Hat nuDios, chab'iraj tii i nutiij,</para>
  <para style="q">maakanaa' chi je' re' i nupahqaaj aweh.</para>
  <para style="q">
    <verse number="2" style="v" />Kinab'iraj tii, chayeew weh aha' wilik inwaaj,</para>
  <para style="q">ruum noq k'ahchi' kiin chi nutiij xa nyot'ik chik i wánima.</para>
  <para style="q">
    <verse number="3" style="v" />Eh kiyo'jiik ruum</para>
  <para style="q">inkiq'or chi wiij i ki-ixowanik nuwach,</para>
  <para style="q">re' taqe i yiib' wach kina'ojb'al inkikoj numahk.</para>
  <para style="q">Eh yohb'aal wach i kik'aah, inkaaj kianam weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh re' wánima xa nyot'ik chik inwik'raaj,</para>
  <para style="q">ma' k'isiin ta nchalik nuyo'jiik noq imb'iraj rib'iral chi naa kinkikansam.</para>
  <para style="q">
    <verse number="5" style="v" />Re' hin kiyo'jik xa kinb'arb'otik chik.</para>
  <para style="q">Je' nchi xanaa chik nukimiik noq inwik'raaj.</para>
  <para style="q">
    <verse number="6" style="v" />Ruum aj re' i nuq'or chi je' wili: Wilik ta naq nuxiik' chi je' rukab' i paloma</para>
  <para style="q">nee naq kinrupinik reje nee naq kinooj hi'loq.</para>
  <para style="q">
    <verse number="7" style="v" />Eh jumehq'iil naq nee kinrupinik reje chi najt.</para>
  <para style="q">Eh nee naq kinooj chi patinik panchiq yuuq'.</para>
  <para style="q">
    <verse number="8" style="v" />Jumehq'iil naq neenukeb'aa' wiib' chikiwach i yohb'aal wach i kijosq'iil chi nunaah</para>
  <para style="q">xa je' chik rukab' i kaq suut teew jab', kinki.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />QaJaaw Dios, nee ta nasach kiwach ruuk' i kiq'oral.</para>
  <para style="q">Ruum re' hin xnukoj rehtaal chi xa re' i ti' k'axik xa re' i peleto inki a'n ree tinamit.</para>
  <para style="q">
    <verse number="10" style="v" />Re' keh chi q'iij chi aq'ab' kikotik chi riij i tz'aq kotimaj wii' riij i tinamit,</para>
  <para style="q">re' yiib' wach na'ojb'al inki a'n eh xa re' ikaansanik inkaaj.</para>
  <para style="q">
    <verse number="11" style="v" />Xa re' rub'anariik i ti' k'axik inkikapaaj, xa re' jot'ooj,</para>
  <para style="q">xa re' ileq' inki a'n pantaq ookb'al reh i tinamit.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' imb'anik weh</para>
  <para style="q">i ti' k'axik ma' re' ta jino'q inixowanik nuwach.</para>
  <para style="q">Wi ta re' jino'q inixowanik nuwach xnukuy naq,</para>
  <para style="q">oon xnukeb'aa' naq wiib' chuwach.</para>
  <para style="q">
    <verse number="13" style="v" />Re' la' hat k'ahchi' ab'aniik ti' k'axik weh i hat naq naah wamigo,</para>
  <para style="q">xanaah re' ma' hat ta naq tokoom wuuk'.</para>
  <para style="q">
    <verse number="14" style="v" />Xanaah re' noq xub'an xti suq inqaq'oreej qiib' awuuk'.</para>
  <para style="q">Eh quch'ihil qiib' xasuq chik inqa'an noq qohponik chulooq'jiik i Dios chupaam i rupaat.</para>
  <para style="q">
    <verse number="15" style="v" />Xa chi ma' keht'al ta naq neenk'uloq i kimik chikinaah i ki-ixowanik nuwach.</para>
  <para style="q">Neeta naq kimuhqik chi k'achilik kiwach,</para>
  <para style="q">ruum xa re' i ma' tob'laj na'ojb'al wilik pan kánima.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Eh re' hin, re' nuDios naa nuq'o'reem,</para>
  <para style="q">eh re' reh neenko'linik weh chupaam i ti' k'axik.</para>
  <para style="q">
    <verse number="17" style="v" />Re' hin naa nuq'o'reem i QaJaaw Dios ruuk' ooq'ik,</para>
  <para style="q">pan wahq'eq, kab'lajora i q'iij, chaq'ab'.</para>
  <para style="q">Eh re' reh naa kiin rib'iram.</para>
  <para style="q">
    <verse number="18" style="v" />Re' reh naa ruko'liniik weh panq'aq'inik,</para>
  <para style="q">chuwach i kimik,</para>
  <para style="q">atoob' ta naq yohb'aal wach kik'ihaal taqe i neenkaaj nukanteesjiik.</para>
  <para style="q">
    <verse number="19" style="v" />Re' QaJaaw Dios wilik rajaawriik chi taaq'anik, neerib'iraj i nutiij.</para>
  <para style="q">Eh naa resam i kajaawriik taqe i aj ixowaal,</para>
  <para style="q">ruum re' keh ma' nkijal ta wach i kina'ojb'al.</para>
  <para style="q">Ni xata nkiyohleej i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Eh aha' naq wilik i kamigo, inki a'n ti' k'axik reh.</para>
  <para style="q">Aha' naq wilik i k'axooj naa kianam noq inkiq'or xama' kian ta wo' hoq.</para>
  <para style="q">
    <verse number="21" style="v" />Eh xa ch'ub'ik chik i kiq'oral inki a'n kiib', xa je' chik ch'ub' kiil mantekilla.</para>
  <para style="q">Xanaah re' xa re' i q'aq'inik inkaaj.</para>
  <para style="q">Xa je' wo' naq chik ch'ub' kiil aseite i kiq'oral inki a'n kiib'.</para>
  <para style="q">Xanaah re' q'e' ti' kiq'orik, xa je' chik rukab' i ruyok' i q'aslaj ch'ihch'.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Chakanaa' pan q'ab' i QaJaaw Dios</para>
  <para style="q">chu'nchel i tiqaaj wii' kapeew re' reh neentoob'inik aweh.</para>
  <para style="q">Ruum re' i QaJaaw Dios ma' jaruuj neeruq'eb' i korik wach ruk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />QaJaaw Dios, re' taqe kaansoom,</para>
  <para style="q">taqe i chukul q'orik ma' naa ta kik'achariik yejaal-oq i kik'achariik.</para>
  <para style="q">Ruum re' hat naa aye'em q'ab' chi naakikimiik chi jumehq'iil.</para>
  <para style="q">Eh re' hin, awuuk' i hat i nuyeew nuk'ux.</para>
  <chapter number="56" style="c" />
  <para style="s">Re' reey David xuq'or parutiij ree Dios chi ruye'em i ruk'ux ruuk'</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, chaketelaaj tii nuwach,</para>
  <para style="q">ruum ma' k'isiin taqe i kib'anik ti' k'axik weh.</para>
  <para style="q">Eh chu'nchel i q'iij inkiq'at panub'eeh, inkaaj kianam weh.</para>
  <para style="q">
    <verse number="2" style="v" />Re' taqe ki-ixowanik nuwach,</para>
  <para style="q">chu'nchel q'iij k'ahchi' kiin</para>
  <para style="q">kisik'im reh i nukanteesjiik.</para>
  <para style="q">Eh yohb'aal kiwach i peleto</para>
  <para style="q">inki a'n wuuk'xiik'naah i kijosq'iil.</para>
  <para style="q">
    <verse number="3" style="v" />QaJaaw Dios, noq neenchalik nuyo'jiik kuum,</para>
  <para style="q">awuuk' i hat neenuyeew nuk'ux.</para>
  <para style="q">
    <verse number="4" style="v" />Re' hin awuuk' i hat nuye'em nuk'ux,</para>
  <para style="q">i nuyeew ruloq'il aq'oral. Ruum i re'</para>
  <para style="q">ma' nee ta kinyo'jik ruum i neenkian weh taqe i xa winaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' keh xa chu'nchel i q'iij inkitib'isaj nuk'ux ruuk' i kiq'oral,</para>
  <para style="q">xa re' inujot'ariik inkikapaaj rub'aan.</para>
  <para style="q">
    <verse number="6" style="v" />Eh inkimol kiib' xak'ul chik kiooj chi keb'anik kiib',</para>
  <para style="q">reh i nutahariik aha' kinik'ik,</para>
  <para style="q">re' inkaaj chi naa kinkikansam.</para>
  <para style="q">
    <verse number="7" style="v" />QaJaaw Dios, cha a'n jilow keh inki a'n weh.</para>
  <para style="q">Reh chi ma' nee ta nik'ik chikiij, chawesaj i kajaawriik ruuk' aajosq'iil.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' hat aweht'al jarpech hin elenaq chikiwach,</para>
  <para style="q">eh jarpech i oq'ik nub'anam kuum.</para>
  <para style="q">Eh weht'al chi atz'ihb'aam rehtalil chupaam asantolaj huuj.</para>
  <para style="q">
    <verse number="9" style="v" />QaJaaw Dios, nik' neenupahqaaj aawotob'il</para>
  <para style="q">nee kielik chikiij i ki-ixowanik nuwach.</para>
  <para style="q">Ruum re' hin weht'al chi re' hat naa atoob'iniik weh.</para>
  <para style="q">
    <verse number="10" style="v" />Re' hin ruuk' i Dios i nuyeew nuk'ux, eh i nuyeew ruloq'il i ruq'oral.</para>
  <para style="q">Xti korik chi nuyeew ruloq'il i ruq'oral.</para>
  <para style="q">
    <verse number="11" style="v" />Ruuk' i QaJaaw Dios i nuyeew nuk'ux,</para>
  <para style="q">ruum aj re' ma' nee ta kinyo'jik. Ni xata neekinyo'jik</para>
  <para style="q">ruum i neenkian weh taqe i xa winaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />QaJaaw Dios re' i nuq'orom chi naa nuye'em aweh,</para>
  <para style="q">naa nub'anam ruuk' alooq'jiik. Eh naa wo' nut'iosem aawotob'il.</para>
  <para style="q">
    <verse number="13" style="v" />Ruum re' hat xat ko'linik weh</para>
  <para style="q">chuwach i kimik, eh chi ma' xinq'ehb'ik taj.</para>
  <para style="q">Reh chi konaa nuk'achariik pan saqum,</para>
  <para style="q">eh chi konaa kaat nuq'o'reem panutiij.</para>
  <chapter number="57" style="c" />
  <para style="s">Re' reey David xupahqaaj parutiij chi naa rutoob'jiik ruum i Dios</para>
  <para style="r">(<ref loc="PSA 108:1-5">Sal 108.1-5</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />Chaketelaaj tii nuwach QaJaaw Dios,</para>
  <para style="q">chaketelaaj nuwach kinatoob'eej.</para>
  <para style="q">Ruum xa awuuk' wo' hat i nusik' ko'lemb'al wiib',</para>
  <para style="q">kinako'leej ruuk' awajaawriik ri'si-aaxiik' kinayeew</para>
  <para style="q">korehtaal inik'ik chi wiij i yohb'aal.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin i nupahqaaj i rotob'il</para>
  <para style="q">i nuDios wilik cho pan taxaaj,</para>
  <para style="q">ruum xa re' wo' reh intoob'inik weh.</para>
  <para style="q">
    <verse number="3" style="v" />Re' reh kopan taxaaj naa rutaq'aam chaloq</para>
  <para style="q">i ruk'axb'al, je' wo' hoq i korik,</para>
  <para style="q">reh chi naa kiiruk'oleem pan kiq'ab'</para>
  <para style="q">i ki-ixowanik nuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' hin ayu' wilkiin chi kixilak</para>
  <para style="q">i tinamit xiik' naah kijosq'iil.</para>
  <para style="q">Xa je' chik q'as ju' ch'ihch' i keeh,</para>
  <para style="q">xa je' chik flecha, eh re' kaaq' xa je' chik q'aslaj ch'ihch'.</para>
  <para style="q">Eh je' kijosq'iil i kaaq b'ahlam.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios, nee ta naq inak'uhtaaj awajaawriik pan taxaaj.</para>
  <para style="q">Eh nee ta naq inye'arik aloq'il chinaah chu'nchel wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' taqe ki-ixowanik nuwach i xkikoj i xirob' chi nujunsuut,</para>
  <para style="q">re' naq inkaaj chi xyoj nuk'ux.</para>
  <para style="q">Eh xkik'ot i chaamlaj jul panub'eeh,</para>
  <para style="q">xanaah re' xa re' wo' keh xiq'ehb'ik ar.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />QaJaaw Dios, re' hin nuye'em nuk'ux awuuk'.</para>
  <para style="q">Eh naa nutz'uyem awach chu'nchel nuk'ux.</para>
  <para style="q">
    <verse number="8" style="v" />Re' hin naa wik'raam wiib' noq naa rusaq'iik.</para>
  <para style="q">Eh chu'nchel nuk'ux naa nutz'uyem wach i nuDios</para>
  <para style="q">ruuk' taqe nuq'ooj, ruuk' i warpa.</para>
  <para style="q">
    <verse number="9" style="v" />Naa kaat nuloq'em chikiwach i tinamit QaJaaw Dios.</para>
  <para style="q">Eh naa nuye'em runimaal awach ruuk' i nutz'uuy chikiwach chu'nchel i tinamit.</para>
  <para style="q">
    <verse number="10" style="v" />Ruum re' ketelinik wachiis i na a'n imponik kopan taxaaj.</para>
  <para style="q">Eh re' rukorkiil wach ak'ux</para>
  <para style="q">imponik wilik cho wii' i suutz'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />QaJaaw Dios nee ta naq i inak'uhtaaj i runimaal awajaawriik pan taxaaj.</para>
  <para style="q">Eh nee ta naq inye'arik aloq'il chinaah chu'nchel i wach ak'al.</para>
  <chapter number="58" style="c" />
  <para style="s">Re' reey David xupahqaaj ree Dios chi chuyeew taqe chutojariik i kimahk i yiib' wach kina'ojb'al</para>
  <para style="q">
    <verse number="1" style="v" />Raaj taq i hat i wilik taq awajaawriik,</para>
  <para style="q">¿Mi parub'ehel taq inaq'at i q'orik?</para>
  <para style="q">¿Mi parub'ehel taq i nayeew chutojariik i ru mahk i ju'jun?</para>
  <para style="q">
    <verse number="2" style="v" />Ma' je' taj, re' taq i hat juneliik re' i ma' holohik ta taq i na a'n,</para>
  <para style="q">xa re' i tikij peleto taq inawaaj kuuk' i tinamit.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh chu'nchel i yiib' wach kina'ojb'al xanoq wo' kiq'eb' kiib' noq xitzuhkrik chaloq.</para>
  <para style="q">Eh xanoq wo' xkitoq'aa' cho chukuj q'orik noq aasjinaq taqe chaloq.</para>
  <para style="q">
    <verse number="4" style="v" />Eh je' rukab' i rukiih i aaq' i kiq'oral.</para>
  <para style="q">Eh ma' jaruuj ki-ib'irinik, xa je' tz'aplik i kixikin</para>
  <para style="q">je' kikab' i aaq' ma' nib'irinik taj tz'aplik i xikin.</para>
  <para style="q">
    <verse number="5" style="v" />Eh ma' nkib'iraj ta wo' hoq i rutz'uuy i aj tz'uyineel,</para>
  <para style="q">atoob' ta nchol wo' naq tz'uuy chi korik.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />QaJaaw Dios, chawisaj i kajaawriik taqe re',</para>
  <para style="q">chapaxib'eej chu'nchel ikehruum je' kijosq'iil i kaq b'ahlam.</para>
  <para style="q">
    <verse number="7" style="v" />Eh nee ta naq inasach kiwach,</para>
  <para style="q">je' rukab' noq inooj sahchoq wach i ha' i rutz'ir reje riib'.</para>
  <para style="q">Eh noq neenkikut reje i kiflecha nee ta naq intoqib'ik.</para>
  <para style="q">
    <verse number="8" style="v" />Neeta naq insahchik kiwach je' rukab' noq insahchik</para>
  <para style="q">wach i rupuril i ha'. Oon je' rukab' i ruk'ul i k'isa ha'lak'un</para>
  <para style="q">kamnaq noq inaasjik ma' rilow ta wach i saqum.</para>
  <para style="q">
    <verse number="9" style="v" />Eh nee ta naq insacharik kiwach chi jumehq'iil,</para>
  <para style="q">xa chi ma' keht'al, je' rukab' noq ink'atarik i k'iix.</para>
  <para style="q">Eh je' ta naq kichuq'arik reje rax ch'ahn panab'iix.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Eh re' taqe korik wach kik'ux naa rusuqb'iik kik'ux</para>
  <para style="q">na' kilow chi xq'ajarik wach keh inki a'n i yiib' wach kina'ojb'al.</para>
  <para style="q">Eh na' kilow chi wilkeeb' chik pan kikik'eel taqe re'.</para>
  <para style="q">
    <verse number="11" style="v" />Eh je' wili naa kiq'orom i tinamit:</para>
  <para style="q">Xti korik chi q'e' holohik i kitojb'aal inkik'ul i korik wach kik'ux.</para>
  <para style="q">Eh wilik jinaj i Dios inq'atwik q'orik chikinaah i tinamit, inko'q taqe.</para>
  <chapter number="59" style="c" />
  <para style="s">Re' reey David xupahqaaj parutiij ree Dios chi naa ruko'ljiik pan kiq'ab' i aj ixowaal</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, kinako'leej tii pan kiq'ab' i ki-ixowanik nuwach.</para>
  <para style="q">Eh kinako'leej pan kiq'ab' inkaaj kianam weh.</para>
  <para style="q">
    <verse number="2" style="v" />Eh kinako'leej pan kiq'ab' i ma' holohik ta kib'anik,</para>
  <para style="q">kinako'leej wo' pan kiq'ab' i kansan kas kichaaq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Kinako'leej chikiwach i yiib' wach kina'ojb'al wilik kajaawriik</para>
  <para style="q">inki a'n kiib' inkaaj kianam weh.</para>
  <para style="q">QaJaaw Dios re' hat aweht'al chi ma' ruum ta numahk inkaaj kianam weh.</para>
  <para style="q">
    <verse number="4" style="v" />Atoob' ta ma' xta numahk xankaaj chik nukanteesjiik.</para>
  <para style="q">QaJaaw Dios chawilow i ti' k'axik k'ahchi' nuk'ulum kinako'leej chi jumehq'iil.</para>
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios, nim awajaawriik, hat ki Dios i aj Israel.</para>
  <para style="q">Chakoj rehtaal inki a'n taqe i tinamit</para>
  <para style="q">ma' kinimanik taa weh, chayeew taqe</para>
  <para style="q">chutojariik i kimahk. Maaketelaaj kiwach</para>
  <para style="q">ruum ma' holohik ta kib'anik.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Eh rajlaal xq'eq inchalik,</para>
  <para style="q">kisutej riij i qatinamiit inkik'er kichii',</para>
  <para style="q">je' rukab' i rub'an i tz'i' noq inokik chi ti'ooj.</para>
  <para style="q">
    <verse number="7" style="v" />Xa npuhik chik i kichii' chuq'orariik</para>
  <para style="q">taqe i yiib' wach q'orik je' wili nkiq'or:</para>
  <para style="q">Ma' awach ta inib'irinik qeh nki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Eh re' hat QaJaaw Dios xan chalik ase'eel inki a'n</para>
  <para style="q">eh xama' nayeew ta wo' rajaawriik inki a'n taqe i ma' kinimanik taa aweh re' re'.</para>
  <para style="q">
    <verse number="9" style="v" />QaJaaw Dios, re' hat nee ti ko'linik weh chuwach, i kajaawriik i ki-ixowanik nuwach.</para>
  <para style="q">Ruum xa re' wo' hat nee ticha'jinik weh.</para>
  <para style="q">
    <verse number="10" style="v" />Re' QaJaaw Dios inketelinik nuwach re' reh naa rutoob'inik weh,</para>
  <para style="q">reh chi neenuq'at wach i kajaawriik i ki-ixowanik nuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />QaJaaw Dios, maakansaj peet taqe i re' xa chatukej la' kiwach.</para>
  <para style="q">Eh chawesaj i kajaawriik,</para>
  <para style="q">reh chi ma' nee ta nsahchik pankik'ux i nutinamiit i re' hat ti ko'linik qeh.</para>
  <para style="q">
    <verse number="12" style="v" />Ruum re' keh juneliik k'ahchi' kimahkunik ruuk' i kiq'oral.</para>
  <para style="q">Chayeew taqe panti' k'axik ruum q'e' inkinimb'isaj kiib', ruum i yiib' wach,</para>
  <para style="q">ruum taqe chukuj q'orik inki a'n</para>
  <para style="q">
    <verse number="13" style="v" />Eh chasach kiwach ruuk' aajosq'iil,</para>
  <para style="q">reh chi chu'nchel neenkikoj rehtaal</para>
  <para style="q">chi re' hat i Dios wilik awajaawriik chi taaq'anik chikinaah i aj Israel.</para>
  <para style="q">Je' wo' chikinaah chu'nchel i tinamit sut i wach ak'al.</para>
  <para style="q">
    <verse number="14" style="v" />Re' taqe ki-ixowanik nuwach rajlaal xq'eq</para>
  <para style="q">inkisuteej riij i qatinamiit, inkik'er kichii',</para>
  <para style="q">je' rukab' i rub'an i tz'i' noq i rutoq'aa' ti'ooj.</para>
  <para style="q">
    <verse number="15" style="v" />Re' keh kikotik chusik'ariik i k'uxumb'al keh.</para>
  <para style="q">Eh inkilow chi ma' nkireq taj inkitoq'aa' kik'erem kichii',</para>
  <para style="q">je' rukab' i rub'an i tz'i' i rutoq'aa' intz'uytz'utik.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />QaJaaw Dios, re' hin naa nutz'uyem awach ruum i awajaawriik,</para>
  <para style="q">naa nuye'em aloq'il pan wahq'eq ruum i naaketelaaj nuwach.</para>
  <para style="q">Ruum xa re' wo' hat titoob'inik weh, tiko'linik weh panti' k'axik.</para>
  <para style="q">
    <verse number="17" style="v" />Re' hin naa nutz'uyem awach</para>
  <para style="q">ruum re' hat ti ye'wik rukowiil nuk'ux,</para>
  <para style="q">hat ti ko'linik weh, hat i Dios tiketelinik nuwach.</para>
  <chapter number="60" style="c" />
  <para style="s">Re' reey David xupahqaaj i rotob'il i Dios noq xooj panq'aq'inik</para>
  <para style="r">(<ref loc="PSA 108:6-13">Sal 108.6-13</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, re' hat xoj akanaa' chi qutkeel ruum aajosq'iil.</para>
  <para style="q">Xoj akanaa' chi ma' xta chik qakowiil.</para>
  <para style="q">Inqapahqaaj aweh chi qoh atoob'eej,</para>
  <para style="q">eh chayeew wo' chik qakowiil.</para>
  <para style="q">
    <verse number="2" style="v" />Chi qeh i hoj je' naa xak'u'yisaj aak'al, je' naa xatarib'eej,</para>
  <para style="q">xa re' la' qoh atoob'eej wo' chik reh chi nee</para>
  <para style="q">wo' chik i rureq paruye'aab'.</para>
  <para style="q">
    <verse number="3" style="v" />Eh xayeew q'ab' chi xuk'ul i ti' k'axik aatinamiit,</para>
  <para style="q">je' naa xayeew qeh chi uuk'jik i k'ahlaj ha' inyojwik na'ojb'al.</para>
  <para style="q">
    <verse number="4" style="v" />Re' hat yu'naak xayeew jinaj kehtalil i kiye'wik aloq'il</para>
  <para style="q">ko'lemb'al kiib' chuwach i kikanteesb'aal i aj ixowaal.</para>
  <para style="q">
    <verse number="5" style="v" />Eh qoh ab'iraj tii, qoh ako'leej ruuk' awajaawriik,</para>
  <para style="q">chawesaj wo' taqe panti' k'axik awach taqe i q'e' nak'ax.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' QaJaaw Dios je' wili i xuq'or parusantolaj ye'aab':</para>
  <para style="q">Re' hin naa rusuuqb'iik nuk'ux noq</para>
  <para style="q">naa nuch'aqam i ye'aab' Siquem.</para>
  <para style="q">Eh naa nupajam i ye'aab' wach k'ixkaab' Sucot.</para>
  <para style="q">
    <verse number="7" style="v" />Re' i Galaad, i Manasés wee hin taqe.</para>
  <para style="q">Re' Efraín je' naa poyb'al wach nunaah.</para>
  <para style="q">Eh re' i Judá, je' naa nukarote noq wilik, rehtalil i wajaawriik.</para>
  <para style="q">
    <verse number="8" style="v" />Re' i Moab je' jino'q johm ye'aab' tz'ajb'al nuq'ab'.</para>
  <para style="q">Eh re' i Edom, naa nuyeq'em pan wooq.</para>
  <para style="q">Eh naa rusuuqb'iik nuk'ux noq naa nuq'atam</para>
  <para style="q">kiwach i taqe aj filisteo, inki i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />QaJaaw Dios, ¿Awach naa ruk'amwiik reje</para>
  <para style="q">weh chupaam i tinamit kow riib'?</para>
  <para style="q">¿Awach i naa ruk'amwiik reje weh Edom?</para>
  <para style="q">
    <verse number="10" style="v" />QaJaaw Dios, ¿Mi xti xoj aq'eb' chi jumpech re'?</para>
  <para style="q">¿Mi ma' nee wo' naq chik i rub'an chi re' hat</para>
  <para style="q">nee ti k'amwik reje qeh panq'aq'inik re'?</para>
  <para style="q">
    <verse number="11" style="v" />Jaaw, qoh ako'leej tii pan kiq'ab' i ki-ixowanik qawach.</para>
  <para style="q">Ruum re' ko'linik inki a'n i xa winaq xama' xta nokik wii'.</para>
  <para style="q">
    <verse number="12" style="v" />Re' QaJaaw Dios naa rutoob'iniik qeh</para>
  <para style="q">reh chi ma' xta nee qoh kuchej i ki-ixowanik qawach.</para>
  <para style="q">Eh re' wo' reh neenesanik i kajaawriik.</para>
  <chapter number="61" style="c" />
  <para style="s">Re' reey David xuch'ikaa' ruk'ux chi re' Dios naa ruko'liniik reh</para>
  <para style="q">
    <verse number="1" style="v" />WaJaaw, nuDios, chab'iraj tii i nuq'or aweh ruuk' oq'ik.</para>
  <para style="q">Eh chayeew weh i nupahqaaj aweh panutiij.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin tinuq'o'reej wuuk' chi junsuut i wach ak'al, ruum re' wánima q'e' ti' wilik.</para>
  <para style="q">Je'-oq chinaah ab'aj najt naah kinayeew reh chi nee nuko'leej wiib'.</para>
  <para style="q">
    <verse number="3" style="v" />Ruum xa re' wo' hat ti ko'linik weh, je' akab' i tz'aq najt naah ko'lb'al iib',</para>
  <para style="q">reh chi nee kinako'leej pan kiq'ab' i ki-ixowanik nuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' hin naa nuk'achariik chi juneliik chupaam asantolaj paat,</para>
  <para style="q">weht'al chi re' hat neetiko'linik weh, ri'si'-aaxiik' nee kinayeew.</para>
  <para style="q">
    <verse number="5" style="v" />WaJaaw, nuDios, re' hat xab'iraj chik i xnuq'or aweh,</para>
  <para style="q">ruum xayeew wo' wee hin i kooch je' rukab' i xayeew keh i kiye'wik aloq'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' hin i reey i nupahqaaj aweh chi najt ta naq rooq i nuk'achariik nee nayeew,</para>
  <para style="q">reh chi k'ih haab' nee kink'acharik.</para>
  <para style="q">
    <verse number="7" style="v" />Eh noq wilkiin chi reyil ruuk' ta naq aawotob'il neenub'an i taaq'anik.</para>
  <para style="q">Eh nee ta naq inaketelaaj nuwach, nee ta naq i nayeew rukorkiil wach nuk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Chi je' re' juneliik neenuloq'ej ab'ihnaal,</para>
  <para style="q">eh eqal eqal neenub'an i nuq'orom aweh chi naa nub'anam.</para>
  <chapter number="62" style="c" />
  <para style="s">Xa re' wo' ruuk' i QaJaaw Dios inkan i ko'lemb'al iib'</para>
  <para style="q">
    <verse number="1" style="v" />Xa re' wo' ruuk' i Dios inureq i rusuqkiil nuk'ux.</para>
  <para style="q">Eh re' wo' reh inye'wik i ko'lemb'al iib'.</para>
  <para style="q">
    <verse number="2" style="v" />Xa re' wo' reh intoob'inik weh, eh xa re' wo' reh inko'linik weh.</para>
  <para style="q">Ma' nee ta nuq'eb' wiib' ruum re' reh incha'jinik weh.</para>
  <para style="q">
    <verse number="3" style="v" />Eh ¿ko jaruuj taq inakanaa' nupeletohjiik i hat inawaaj taq aq'atam nuwach.</para>
  <para style="q">Re' taq i hat i nakapaaj taq chi je' nukab' jino'q i tz'aq xa q'ehb'ik chik reh.</para>
  <para style="q">Eh i nakapaaj taq chi je' nukab' i koraal xa q'ehb'ik chik reh wach ak'al?</para>
  <para style="q">
    <verse number="4" style="v" />Re' taq i hat xa re' i rehtesjiik i wajaawriik taq inakapaaj,</para>
  <para style="q">i nayeew taq ak'ux chi chukuj q'orik.</para>
  <para style="q">Eh xa chachii taq kinak'ax,</para>
  <para style="q">eh chupaam taq awánima ma' holohik taj inakapaaj chi wiij.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' hin xa ruuk' wo' QaJaaw Dios i nureq rusuqkiil nuk'ux.</para>
  <para style="q">Eh xa ruuk' wo' reh inuch'ikaa' nuk'ux.</para>
  <para style="q">
    <verse number="6" style="v" />Xa re' wo' reh intoob'inik, inko'linik weh</para>
  <para style="q">jinaj paat ab'aj ko'lb'al iib' chi weh</para>
  <para style="q">ma' nee ta nuq'eb' wiib' ruum re' reh incha'jinik weh.</para>
  <para style="q">
    <verse number="7" style="v" />Re' Dios inye'wik weh i ko'lemb'al wiib'. Eh re' reh</para>
  <para style="q">inye'wik weh i nuloq'il, re' wo' reh incha'jinik weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Hat taq nutinamiit juneliik taq chayeew ak'ux ruuk' i Dios.</para>
  <para style="q">Eh chu'nchel ak'ux cha a'n taq atiij chuwach</para>
  <para style="q">ruum xa re' wo' reh i Dios inko'linik qeh.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' taqe winaq xama' xta kiokik wii', chi je' taqe b'ehoom, chi je' taqe neb'aa'.</para>
  <para style="q">Neeta naq kipajarik pan jino'q pexu</para>
  <para style="q">eliik naq kiwach chi ma' ruk'aaj ahl taqe,</para>
  <para style="q">ahl naq k'isinoq inerupaj i teew chikiwach.</para>
  <para style="q">
    <verse number="10" style="v" />Mayeew taq ak'ux chinaah i peletohinik.</para>
  <para style="q">Eh mo'-oq xa ruuk' taq i leq' neenareq ab'ehomal.</para>
  <para style="q">Eh wila' xk'ihaaxb'ik taq i chib'ih aweh</para>
  <para style="q">maayeew taq ak'ux chinaah.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' Dios jinaj i Q'orik ruq'orom chaloq,</para>
  <para style="q">eh ma' xata junriim b'iram i hin chi</para>
  <para style="q">xa re' wo' reh nim rajaawriik.</para>
  <para style="q">
    <verse number="12" style="v" />QaJaaw Dios xa re' wo' hat tiketelinik wachiis,</para>
  <para style="q">ruum re' hat i nayeew kitojb'aal i ju'jun</para>
  <para style="q">re' q'oreel chib'ih xkian i xkiq'or.</para>
  <chapter number="63" style="c" />
  <para style="s">Xa re' wo' Dios inye'wik rusuqkiil ruk'ux i winaq</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, re' hin chu'nchel nuk'ux tinusik pantaq wahq'eq.</para>
  <para style="q">Je' rukab' noq iraaj ruhaa' chiqiij laj ak'al,</para>
  <para style="q">Eh inchiqik chii' i wánima reh asik'ariik i hat nuDios.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin inwaaj wo' chik wilom awajaawriik, aaloq'il</para>
  <para style="q">chupaam i loq'laj apaat je' rukab' i wilom chaloq noq xub'an.</para>
  <para style="q">
    <verse number="3" style="v" />Ruum re' ak'axb'al xiik' naah loq'il chuwach i k'acharik,</para>
  <para style="q">je' re' noq ruuk' nuchii' naa kaat nuloq'em.</para>
  <para style="q">
    <verse number="4" style="v" />Chi je' re' naa kaat nuloq'em panuk'achariik.</para>
  <para style="q">Eh naa nujosam i nuq'ab' noq naa nub'anam johtoq nutiij chawach.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Chi je' re' QaJaaw Dios naa ruch'iklojiik nuk'ux awuuk',</para>
  <para style="q">je' naa nunujisam wiib' ruuk' i suq laj wi'k ha'.</para>
  <para style="q">Eh ruum i rusuqkiil nuk'ux naa kaat nuloq'em ruuk' nuchii'.</para>
  <para style="q">
    <verse number="6" style="v" />Eh pantaq chaq'ab' noq hin chik yohkinaq,</para>
  <para style="q">ink'ulik cho panuk'ux aawotob'il, tinukapaaj wo' hoq.</para>
  <para style="q">
    <verse number="7" style="v" />Ruum xa re' wo' hat titoob'inik weh</para>
  <para style="q">i q'e' suq nuk'ux awuuk',</para>
  <para style="q">ri'si-aaxiik' k'ahchi' kiin ako'leem.</para>
  <para style="q">
    <verse number="8" style="v" />Re' hat tichopwik nunaah panuk'achariik,</para>
  <para style="q">eh ma' jaruuj nee kinakanaa' chi wutkeel.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Eh re' taqe inkaaj nukanteesjiik peet i keh</para>
  <para style="q">naa kikimiik, eh peet naakimuhqiik.</para>
  <para style="q">
    <verse number="10" style="v" />Re' keh naa kikanteesjiik ruuk' q'aslaj ch'ihch',</para>
  <para style="q">eh naakik'uxariik kuum i xojb'.</para>
  <para style="q">
    <verse number="11" style="v" />Eh re' hin i reey naa rusuuqb'iik nuk'ux ruuk' i Dios.</para>
  <para style="q">Naa wo' kiye'em ruloq'il i Dios</para>
  <para style="q">ruuk' kitz'uuy inkiq'or i korik parub'ihnaal.</para>
  <para style="q">Eh re' taqe i chukul q'orik, naa rutz'apariik i kichii'.</para>
  <chapter number="64" style="c" />
  <para style="s">Re' reey David xupahqaaj ree Dios chi naa ruko'ljiik pan kiq'ab' i aj ixowaal</para>
  <para style="q">
    <verse number="1" style="v" />Hat nuDios, chab'iraj tii weh i nutiij,</para>
  <para style="q">ruum ma' k'isiin i nuyohb'eesjiik inki a'n i aj ixowaal, kinako'leej tii pan kiq'ab'.</para>
  <para style="q">
    <verse number="2" style="v" />Kinako'leej chuwach k'achi' kiyejaam wach panke'lik i yiib' wach kina'ojb'al.</para>
  <para style="q">Kinako'leej chuwach inkikapaaj wach nunaah i ma' holohik ta kib'anik.</para>
  <para style="q">
    <verse number="3" style="v" />Xa q'as chik i ju' kaaq' chi q'orik, xa je' chik q'aslaj ch'ihch'.</para>
  <para style="q">Eh xiik' naah ti'kiil kiq'orik xa je' chik rukab' inqajik wii' i ju' i flecha.</para>
  <para style="q">
    <verse number="4" style="v" />Eh panke'lik, chi ma' eht'alimaj inkikut chaloq chi flecha taqe i ma' xta kimahk,</para>
  <para style="q">ma' kiyo'jik ta chub'aan.</para>
  <para style="q">
    <verse number="5" style="v" />Re' keh inki a'n i yiib' wach na'ojb'al.</para>
  <para style="q">Eh inkikoj ruxirob'aal taqe i ma' xta kimahk,</para>
  <para style="q">eh inkikapaaj chi ma' awach ta nilwik keh.</para>
  <para style="q">
    <verse number="6" style="v" />Eh inkikapaaj chi ma' awach ta naa runab'iniik reh i ma' holohik taj inki a'n</para>
  <para style="q">Korik ma' awach ta naa neenab'inik reh</para>
  <para style="q">xa re' la' re' i QaJaaw Dios reht'al inkikapaaj pan kánima.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' wo' QaJaaw Dios naa ruye'wiik keh panti' k'axik,</para>
  <para style="q">naakik'utariik chi flecha.</para>
  <para style="q">
    <verse number="8" style="v" />Re' keh xa ruuk' i kiq'oral naa kiq'ehb'iik,</para>
  <para style="q">eh nik' k'ihaal i naa rilwiik keh naakikaqse'ljiik kuum.</para>
  <para style="q">
    <verse number="9" style="v" />Eh re' i tinamit, q'e' naa kiyo'jiik,</para>
  <para style="q">naa kiq'orom rib'iral i rukamaj i Dios.</para>
  <para style="q">Eh naa kireqem chi riij taqe i nimaq wach na'ojb'al i rub'an.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' korik wach ruk'ux naa rusuuqb'iik ruk'ux ruuk' i Dios,</para>
  <para style="q">ruuk' i reh naa ruye'em ruk'ux.</para>
  <para style="q">Eh chu'nchel i holohik kib'anik naakiye'em ruloq'il i Dios.</para>
  <chapter number="65" style="c" />
  <para style="s">Xa re' wo' QaJaaw Dios i ruk'ul chi naaqaye'em ruloq'il</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, re' hat i ruk'ul chi naa qaye'em aloq'il ar Sión.</para>
  <para style="q">Eh chi naaqa'nam i qaq'orom aweh chi naaqa'nam.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hat inab'iraj i qatiij.</para>
  <para style="q">Eh chu'nchel i tinamit aweh i hat inkipahqaaj chib'ih inkaaj.</para>
  <para style="q">
    <verse number="3" style="v" />Wilik noq xa re' chik taqe i yiib' wach na'ojb'al inqa'an chawach.</para>
  <para style="q">Xa re' la', re' hat q'e' naakuy taqe qamahk.</para>
  <para style="q">
    <verse number="4" style="v" />Atoob' keh inasik' kiwach</para>
  <para style="q">reh chi naa kaat kiloq'em chupaam aapaat.</para>
  <para style="q">Eh nee ta naq insuuqb'ik qak'ux chi manlik</para>
  <para style="q">ruuk' i qatiij neenqa a'n chupaam asantolaj paat.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios, hat qaj ko'loom,</para>
  <para style="q">re' hat ruuk' nimaq wach na'ojb'al,</para>
  <para style="q">ruuk' korik i nayeew qeh inqapahqaaj aweh.</para>
  <para style="q">Chu'nchel i tinamit sut i wach ak'al awuuk' i hat inkich'ikaa' kik'ux,</para>
  <para style="q">je' wo' taqe i wilkeeb' kochi juntar i palaw.</para>
  <para style="q">
    <verse number="6" style="v" />Re' wo' hat xatyej-anik reh i yuuq',</para>
  <para style="q">eh aye'em taqe pan kiye'aab' ruuk' i runimaal awajaawriik.</para>
  <para style="q">
    <verse number="7" style="v" />Re' hat tipaab'anik reh i rub'ohl i palaw.</para>
  <para style="q">Eh re' hat tikojwik keh panotob'il</para>
  <para style="q">i tinamit noq inkitukej kiib'.</para>
  <para style="q">
    <verse number="8" style="v" />Ruum aj re', re' taqe i tinamit sut i wach ak'al nsahchik kik'ux</para>
  <para style="q">ruum taqe i nimaq wach sahchb'al k'uxliis i na a'n.</para>
  <para style="q">Eh awuum i hat inkik'er kichii' ruum rusuqkiil kik'ux chi q'iij chi aq'ab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' wo' hat tik'uxlanik reh i wach ak'al,</para>
  <para style="q">i nayeew i jab' chinaah.</para>
  <para style="q">Eh i nayeew taqe i rooq i ha' tz'aqtesb'al reh,</para>
  <para style="q">ruuk' i re' i naak'isaj taqe johtoq i tik, eh kiwachinik.</para>
  <para style="q">
    <verse number="10" style="v" />Re' hat i nat'aqsaj chaloq chi lohk'aal i tik,</para>
  <para style="q">i nayeew i ha' pantaq xilak.</para>
  <para style="q">Eh ruuk' i jab' i nayeew inakanaa' chi ma' kow ta chik i aak'al,</para>
  <para style="q">inakuxisaj i kiwach taqe tik.</para>
  <para style="q">
    <verse number="11" style="v" />Re' hat xti xayeew aawotob'il chinaah qatik chupaam i haab' wili.</para>
  <para style="q">Re' taqe aasuutz' ti xkiyeew chaloq i jab' chi manlik.</para>
  <para style="q">
    <verse number="12" style="v" />Eh inqajik cho chikinaah taqe ch'ahn wilkeeb'</para>
  <para style="q">panchiq yuuq' xa rax chik kiwach,</para>
  <para style="q">xayohb'aal chik wach kiholwochiil kik'utinik reje.</para>
  <para style="q">
    <verse number="13" style="v" />Ma' k'isiin taqe i chikop wi'k inki a'n chinaah.</para>
  <para style="q">Eh wataq k'ixkaab' nujinaq taqe chi tik,</para>
  <para style="q">eh re' taqe ehchan reh xa nkik'er chik kichii' chi tz'uuy.</para>
  <chapter number="66" style="c" />
  <para style="s">Re' rutz'uuyjiik wach i Dios ruum taqe i sahchb'al k'uxliis i rub'an</para>
  <para style="q">
    <verse number="1" style="v" />Re' taq i hat i wilkaat taq chi junsuut i wach ak'al,</para>
  <para style="q">chayeew taq ruloq'il i Dios chi suq taq ak'ux.</para>
  <para style="q">
    <verse number="2" style="v" />Eh cha a'n taq atz'uuy parub'ihnaal</para>
  <para style="q">i QaJaaw Dios ye'b'al runimaal wach.</para>
  <para style="q">
    <verse number="3" style="v" />Je' taq wili i cha q'or reh i QaJaaw Dios panatz'uuy:</para>
  <para style="q">Re' taqe ayejaam xiik' naah kiholwochiil.</para>
  <para style="q">Eh ruum i runimaal awajaawriik inkiloch' kiib'</para>
  <para style="q">chawach taqe i ki-ixowanik awach.</para>
  <para style="q">
    <verse number="4" style="v" />Eh re' i tinamitsut i wach ak'al tikiloq'ej.</para>
  <para style="q">Eh inki a'n kitz'uuy panab'ihnaal tiko'q taq reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Chab'iraj taq, chakoj taq rehtaal i rub'anam i Dios.</para>
  <para style="q">Chakoj taq rehtaal i sachb'al k'uxliis rub'anam</para>
  <para style="q">kuuk' i rutinamiit.</para>
  <para style="q">
    <verse number="6" style="v" />Re' reh xuchiqsaj i yejaal i kaq palaw,</para>
  <para style="q">je' wo' nim ha' Jordán noq ki-ik'ik ar i rutinamiit.</para>
  <para style="q">Ruum aj re' suuqb'oq qak'ux ruuk' i Dios.</para>
  <para style="q">
    <verse number="7" style="v" />Eh ruuk' i rajaawriik i rub'an i taaq'anik chi juneliik,</para>
  <para style="q">eh reht'al chib'ih inki a'n chu'nchel i tinamit.</para>
  <para style="q">Eh naa ruq'atam wach i kajaawriik i ma' kinimanik ta ree reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Hat taq tinamit chayeew taq ruloq'il i qaDios.</para>
  <para style="q">Chatz'uyej taq wach chi loq'oomb'al reh.</para>
  <para style="q">
    <verse number="9" style="v" />Ruum kok'ahchi' ruye'em cho qak'achariik,</para>
  <para style="q">eh ma' xuyeew ta q'ab' chi xsacharik taq awach.</para>
  <para style="q">
    <verse number="10" style="v" />QaJaaw Dios, re' hat xoj anik'eej ruuk' i qanimaniik.</para>
  <para style="q">Eh xojawik'saj pan xaq q'aaq', je' rukab' noq inik'tesjik wach q'aaq' i manlik plata.</para>
  <para style="q">
    <verse number="11" style="v" />Xojayeew pan jinaj k'axik,</para>
  <para style="q">je' naa jino'q ahl laj ihq xayeew chi qanaah.</para>
  <para style="q">
    <verse number="12" style="v" />Eh xayeew q'ab' chi xojkiyeq' panak'al i ki-ixowanik qawach,</para>
  <para style="q">eh xojik'ik pan xaq q'aaq', xojik'ik chupaam elal ha'.</para>
  <para style="q">Eh noq xooj kuxoq xojawisaj chupaam xoj ponik chupaam i ye'aab' xojhi'lik wii'.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' hin naawokiik chupaam aapaat chuk'atariik i numayiij.</para>
  <para style="q">Chi je' re' naa nub'anam i nuq'orom aweh.</para>
  <para style="q">
    <verse number="14" style="v" />Re' xnuq'or chaaweh chi naa nub'anam</para>
  <para style="q">noq xinwihik cho panti' k'axik.</para>
  <para style="q">
    <verse number="15" style="v" />Eh naa nuk'atam wach artaal chi numayiij taqe q'ina' laj chikop.</para>
  <para style="q">Naa nuye'em aweh taqe b'ooyax,</para>
  <para style="q">taqe imas tentzun, je' wo' taqe imas kaprax. Reh chi nk'ohnik neemponik chuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Kim taq chawunchelaal i hat i tiyohlinik ree Dios.</para>
  <para style="q">Eh chab'iraj taq, re' hin naa nuk'utjaam taq aweh i rub'anam wuuk' i Dios.</para>
  <para style="q">
    <verse number="17" style="v" />Eh ruuk' nuchii' xnuq'o'reej wuuk',</para>
  <para style="q">eh xnuyeew ruloq'il ruuk' i nutz'uuy.</para>
  <para style="q">
    <verse number="18" style="v" />Wi ta re' taqe i yiib' wach wilik pan wánima,</para>
  <para style="q">re' QaJaaw Dios ma' xirib'iraj ta naq.</para>
  <para style="q">
    <verse number="19" style="v" />Xirib'iraj la' i reh, xuyeew cho weh</para>
  <para style="q">taqe i xnupahqaaj reh panutiij.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Loq'imaj taa naq i QaJaaw Dios,</para>
  <para style="q">ruum xrib'iraj i nutiij,</para>
  <para style="q">eh ruum chi xuketelaaj nuwach.</para>
  <chapter number="67" style="c" />
  <para style="s">Re' reey David xuq'or chi chu'nchel i tinamit naa ruloq'iniik reh i Dios</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, chaketelaaj</para>
  <para style="q">ta tii qawach qoh atoob'eej.</para>
  <para style="q">Eh suq ta tii qilariik neena a'n.</para>
  <para style="q">
    <verse number="2" style="v" />Reh chi chu'nchel i tinamit wach ak'al</para>
  <para style="q">nee kinab'inik reh inawaaj i hat chi naa rub'aan,</para>
  <para style="q">eh chi xa re' wo' hat, i aj Ko'loom.</para>
  <para style="q">
    <verse number="3" style="v" />QaJaaw Dios, xti ruk'ul chi chu'nchel i tinamit neetikiloq'ej,</para>
  <para style="q">eh chi chu'nchel neekiye'wik runimaal awach.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh re' taqe aj panimaq tinamit neenkik'er kichii' ruum rusuqkiil kik'ux.</para>
  <para style="q">Ruum re' hat parub'ehel naa a'nam i taaq'anik chikinaah i tinamit,</para>
  <para style="q">eh re' hat naa ak'amwiik kib'eeh.</para>
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios, xti ruk'ul chi chu'nchel i tinamit neetikiloq'ej.</para>
  <para style="q">Eh chi chu'nchel i tinamit neekiye'wik runimaal awach.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Ruum re' qatik xti xiwachinik chi korik.</para>
  <para style="q">Qeht'al chi re' QaJaaw Dios xtoob'inik qeh.</para>
  <para style="q">
    <verse number="7" style="v" />Re' ta naq i QaJaaw Dios neentoob'iin qeh.</para>
  <para style="q">Eh chu'nchel ta naq i tinamit wilkeeb' sut i wach ak'al neekiye'wik ruloq'il.</para>
  <chapter number="68" style="c" />
  <para style="s">Re' tz'uuy xkian i aj Israel noq xkiq'at wach i aj ixowaal</para>
  <para style="q">
    <verse number="1" style="v" />Noq i ruk'uhtaaj i rajaawriik i Dios</para>
  <para style="q">chi naa rub'anam keh i ki-ixowanik wach,</para>
  <para style="q">re' keh inkitukej kiib'.</para>
  <para style="q">Eh inkimol chi elik chuwach ruum kiyo'jiik.</para>
  <para style="q">
    <verse number="2" style="v" />Eh naa rojiik sahchoq kiwach</para>
  <para style="q">je' rukab' noq inooj sahchoq wach i sib' panteew.</para>
  <para style="q">Re' taqe yiib' wach kina'ojb'al chuwach i Dios</para>
  <para style="q">naa rojiik sahchoq kiwach</para>
  <para style="q">je' rukab' noq inhaab'ik i kantela ruum i q'aaq'.</para>
  <para style="q">
    <verse number="3" style="v" />Eh re' taqe i korik wach kik'ux keh,</para>
  <para style="q">naa rusuuqb'iik kik'ux chuwach i Dios,</para>
  <para style="q">naakipisk'aniik pankooq.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' taq i hat cha tz'uyej taq wach i Dios.</para>
  <para style="q">Cha a'n taq atz'uuy parub'ihnaal,</para>
  <para style="q">chaloq'ej taq i wilik cho nah suutz'.</para>
  <para style="q">Eh suuqb'oq taq ak'ux ruuk' i QaJaaw.</para>
  <para style="q">Suuqb'oq taq ak'ux chuwach.</para>
  <para style="q">
    <verse number="5" style="v" />Re' QaJaaw Dios wilik pan rusantolaj ye'aab',</para>
  <para style="q">kajaaw taqe i ma' xta kituut kajaaw.</para>
  <para style="q">Eh toob'en keh taqe ixoq kamnaq kib'ahiil.</para>
  <para style="q">
    <verse number="6" style="v" />Re' QaJaaw Dios i ruyeew kipaat i ma' xta kipaat.</para>
  <para style="q">Eh i resaj taqe panti' k'axik i wilkeeb'</para>
  <para style="q">panti' k'axik, i ruyeew rusuqkiil kik'ux.</para>
  <para style="q">Eh re' taqe i ma' kinimanik taj,</para>
  <para style="q">naakikanab'jiik chupaam i ye'aab' chiq yuuq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />QaJaaw Dios, noq hat cho peet chikiwach</para>
  <para style="q">taqe aatinamiit chupaam taqe ye'aab' chiq yuuq',</para>
  <para style="q">
    <verse number="8" style="v" />re' ak'al xk'uyu'jik ruum awajaawriik.</para>
  <para style="q">Eh xub'an wo' chaloq i jab', re' i ye'aab' Sinaí xk'uyu'jik</para>
  <para style="q">ruum i runimaal awajaawriik i hat Dios,</para>
  <para style="q">re' i qaDios i hoj, hoj Israel.</para>
  <para style="q">
    <verse number="9" style="v" />QaJaaw Dios, re' hat xti xayeew chaloq</para>
  <para style="q">i jab' chi korik re' xawaaj i hat chi xayeew cho ransil,</para>
  <para style="q">eh xat'aqsaj taqe i ye'aab' chiq yuuq'.</para>
  <para style="q">
    <verse number="10" style="v" />Re' taqe aatinamiit xakoj taqe chi patinik ar.</para>
  <para style="q">QaJaaw Dios xa ruuk' aak'axb'al</para>
  <para style="q">xayeew keh i neb'aa' i ajwaal wach chi keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Eh xa ruuk' i ruq'oral i QaJaaw Dios xiyo'jik taqe i aj ixowaal.</para>
  <para style="q">Eh ma' k'isiin taqe ixoq xiq'orik rib'iral</para>
  <para style="q">chib'ih i xk'ularik je' wili xkiq'or:</para>
  <para style="q">
    <verse number="12" style="v" />Re' taqe reey, taqe i ki soldado</para>
  <para style="q">xkimol chi elik, inki taqe.</para>
  <para style="q">Eh re' taqe ixoq k'ahchi' kich'aqam</para>
  <para style="q">chikiwach pankipaat ixq'ucharik keh i aj ixowaal.</para>
  <para style="q">
    <verse number="13" style="v" />Re' taq i hat ma' re' ta nkiwii'</para>
  <para style="q">chi xakeb'aa' taq awiib' pampaat</para>
  <para style="q">xa tiq'aa' taq awiib' chi korik.</para>
  <para style="q">Je' taq akab' i paloma xa nworwotik chik i ruxiik',</para>
  <para style="q">xa je' chik rukab' i plata.</para>
  <para style="q">Eh re' riij xa je' chik rukab' i manlik oro.</para>
  <para style="q">
    <verse number="14" style="v" />Re' QaJaaw Dios ruuk' i rajaawriik</para>
  <para style="q">xukaaj taqe reje i reey ki-ixowanik wach i rutinamiit,</para>
  <para style="q">je' rukab' noq i ruyeew chaloq i suutz' chinaah i yuuq' Salmón.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Re' taqe yuuq' wilkeeb' chupaam i ye'aab' Basán,</para>
  <para style="q">xiik' naah najtiil kinaah q'e' holohaq.</para>
  <para style="q">
    <verse number="16" style="v" />Eh re' taq i hat i wilkaat taq chinaah i yuuq' najt naah</para>
  <para style="q">¿Chib'ih reet noq ma' suq ta taq rilariik</para>
  <para style="q">i na a'n i yuuq' xuyejaa' wii' i rupaat i QaJaaw Dios?</para>
  <para style="q">Xanaah re' ar naa ruwihiik i QaJaaw Dios chi juneliik.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Re' QaJaaw Dios xiik' naah i rajaawriik</para>
  <para style="q">yohb'aal wach k'ihaal i rukareta</para>
  <para style="q">reh i q'aq'inik ruch'ihil noq xelik</para>
  <para style="q">cho chupaam i ye'aab' Sinaí,</para>
  <para style="q">noq xchalik chupaam i ye'aab' Sión.</para>
  <para style="q">
    <verse number="18" style="v" />Jaaw re' hat xatjohtik chupaam aa ye'aab'.</para>
  <para style="q">Wilik taqe i panti' k'axik wilkeeb' xak'am taqe johtoq chawiij,</para>
  <para style="q">eh xkiyeew aloq'il taqe i winaq.</para>
  <para style="q">Wilik wo' taqe i ma' kinimanik</para>
  <para style="q">ta naq aweh xkiloch' kiib' chawach i hat.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Loq'imaj ta naq i QaJaaw Dios, re' i qaj Ko'loom.</para>
  <para style="q">Re' reh eqal eqal qohrutoob'eej ruuk' i qak'axkiil.</para>
  <para style="q">
    <verse number="20" style="v" />Re' QaJaaw Dios jinaj Dios aj ko'loom,</para>
  <para style="q">eh nee wo' qoh ruko'leej chuwach i kimik.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Re' QaJaaw Dios naa rusacham</para>
  <para style="q">kiwach taqe i ki-ixowanik wach,</para>
  <para style="q">naa rupaxem kinaah, reh i rusachariik</para>
  <para style="q">kiwach ruum ma' nkikanaa' ta rub'aan i mahk.</para>
  <para style="q">
    <verse number="22" style="v" />Re' QaJaaw je' wili xuq'or: Naa wo' chik</para>
  <para style="q">taq kaat wesam reje Basán,</para>
  <para style="q">naa wo' chik taq kaat wik'sam reje chupaam i palaw.</para>
  <para style="q">
    <verse number="23" style="v" />Re' hin naa nusacham,</para>
  <para style="q">kiwach i ki-ixowanik taq awach.</para>
  <para style="q">Eh naa taq awilom i kikik'eel</para>
  <para style="q">chi wilik taq cha junsuut,</para>
  <para style="q">eh re' taqe aatz'ii' naa rureqwiik reh, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />QaJaaw Dios, hat nuDios,</para>
  <para style="q">hat nureey, xk'utinik noq xakilok'ik chik aatinamiit</para>
  <para style="q">noq xkik'am i koq chupaam aapaat</para>
  <para style="q">i holohik laj kaxa molik wii' taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="25" style="v" />Re' taqe aj tz'uuy wilik taqe i peet b'eeh,</para>
  <para style="q">wilik taqe i xam b'eeh,</para>
  <para style="q">eh panyejaal wilkeeb' i kok' q'ahxoq</para>
  <para style="q">k'ahchi' kiq'ojem i kiq'ooj intzalajinik.</para>
  <para style="q">
    <verse number="26" style="v" />Hat taq tinamit aj Israel chawunchelaal</para>
  <para style="q">taq chayeew ruloq'il i QaJaaw Dios.</para>
  <para style="q">Chayeew wo' taq ruloq'il noq amolom taq awiib'.</para>
  <para style="q">
    <verse number="27" style="v" />Eh peet chikiwach taqe re' i aj Benjamín,</para>
  <para style="q">eh ma' k'isiin taqe k'amal kib'eeh aj Judá.</para>
  <para style="q">Re' wo' taqe haa' i ikik'amwik</para>
  <para style="q">kib'eeh i aj Zabulón,</para>
  <para style="q">je' wo' taqe i k'amal kib'eeh i aj Neftalí.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />WaJaaw nuDios, cha k'uhtaaj cho qeh awajaawriik,</para>
  <para style="q">cha a'n cho quuk' i a'nam cho quuk' noq xub'an.</para>
  <para style="q">
    <verse number="29" style="v" />Re' taqe reey wilkeeb' chi taaq'anik,</para>
  <para style="q">naa kik'amam chaloq i kimayiij</para>
  <para style="q">chawach chupaam aapaat ar Jerusaleem.</para>
  <para style="q">
    <verse number="30" style="v" />QaJaaw Dios chaq'il taqe i aj Egipto</para>
  <para style="q">kimolom kiib' yohb'aal wach i kijosq'iil,</para>
  <para style="q">je' taqe josq'laj chikop, je' taqe josq'laj wakax.</para>
  <para style="q">Chawesaj i kajaawriik,</para>
  <para style="q">korehtaal inkiq'asaj aweh i kib'ehomal.</para>
  <para style="q">Jaaw chatukej kiwach i tinamit</para>
  <para style="q">xa re' i Q'aq'inik imponik chikiwach.</para>
  <para style="q">
    <verse number="31" style="v" />Wilik taqe i k'amal kib'eeh i aj Egipto,</para>
  <para style="q">wilik taqe k'amal kib'eeh i aj Etiopía</para>
  <para style="q">naa ruchaliik kipahqaam kitoob'jiik aweh.</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Re' taq i hat i wilkaat taq chi taaq'anik</para>
  <para style="q">chikinaah i tinamit,</para>
  <para style="q">cha tz'uyej taq wach i QaJaaw Dios.</para>
  <para style="q">
    <verse number="33" style="v" />Re' wilik cho pan taxaaj, xa wilik wo' chaloq najtir q'iij.</para>
  <para style="q">Chab'iraj taq xti ko ar naa ruq'oriik</para>
  <para style="q">cho chi kow ruuk' i runimaal rajaawriik.</para>
  <para style="q">
    <verse number="34" style="v" />Chayeew taq rajaawriik i QaJaaw Dios,</para>
  <para style="q">re' wilik rajaawriik taq cha naah i hat, wuch aj Israel,</para>
  <para style="q">xiik' naah i rajaawriik imponik kopan taxaaj.</para>
  <para style="q">
    <verse number="35" style="v" />QaJaaw Dios re' hat sahchb'al</para>
  <para style="q">k'uxliis i na a'n pan asantolaj ye'aab'</para>
  <para style="q">ruum i nayeew rukowiil kik'ux aatinamiit Israel.</para>
  <para style="b" />
  <para style="q">Loq'imaj ta naq ab'ihnaal chi juneliik.</para>
  <chapter number="69" style="c" />
  <para style="s">Re' rutiij xub'an i reey David noq q'e' ti' ruk'ux kuum i aj ixowaal</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios kinako'leej chupaam i ti' k'axik,</para>
  <para style="q">ruum re' hin je' naa k'ahchi' nujutlujiik qohoq pantaq chaamlaj ha'.</para>
  <para style="q">
    <verse number="2" style="v" />Eh k'ahchi' nujutlujiik qohoq pan chaamlaj muuq,</para>
  <para style="q">xama' ha' ta chik i nureq ye'aab' ree wooq.</para>
  <para style="q">Eh yohb'aal wach chamiil i ha'</para>
  <para style="q">k'ahchi' kiin ruk'amam reje i rooq noq inwik'raaj.</para>
  <para style="q">
    <verse number="3" style="v" />Re' hin xinq'uhtik, chiqik wach i walaq chaq'orob'jiik.</para>
  <para style="q">Eh re' naq'nuwach ma' saqum ta chik inilwik,</para>
  <para style="q">k'ahchi' wuy-eem chi naa kiin atoob'eem i hat, hat nuDios.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' i ki-ixowanik nuwach inkaaj kisacham nuwach chi ma' xtarub'ehel,</para>
  <para style="q">yohb'aal wach kik'ihaal ma' xata je' kik'ihaal i rismaal nunaah.</para>
  <para style="q">Eh xakow chik inki a'n kiib', kow inkipahqaaj i jilow weh i ma' welq'aam ta wo' hoq.</para>
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios, re' hat aweht'al ruyib'kiil wach i nuna'ojb'al.</para>
  <para style="q">Eh chu'nchel i numahk pan saqum wilik chawach.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />QaJaaw Dios, nim awajaawriik,</para>
  <para style="q">ma' ta naq neenuk'uhtaaj kik'ixb'ilaal taqe i kiye'em kik'ux awuuk'.</para>
  <para style="q">Eh ma' ta naq neenuyoj kik'ux</para>
  <para style="q">inkichop kik'ux chasik'ariik i</para>
  <para style="q">hat QaJaaw Dios,</para>
  <para style="q">hat qaDios i hoj, hoj aj Israel.</para>
  <para style="q">
    <verse number="7" style="v" />Ruum animjiik k'ahchi' nuk'ulum i b'ajarik,</para>
  <para style="q">eh k'ahchi' nuk'uhtaam nuk'ixb'ilaal ruuk' inki a'n weh.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taqe i jinaj qatuut qajaaw kuuk'</para>
  <para style="q">xa je' chik ma' keht'al nuwach,</para>
  <para style="q">xa je' kinilarik tokoom tinamit inki a'n weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' hin q'e' nuk'ax aapaat, eh q'e' nyot'ik i wánima</para>
  <para style="q">i rub'an noq inki a'n i re' ma' re' ar.</para>
  <para style="q">Eh re' ab'ajariik inki a'n wach nunaah i hin inkahnik.</para>
  <para style="q">
    <verse number="10" style="v" />Noq i nub'an nutiij ruuk' oq'ik chi ma'</para>
  <para style="q">nub'anam ta nuwa' kinkikaqse'laaj.</para>
  <para style="q">
    <verse number="11" style="v" />Eh noq i nukoj chi wiij inuq'eq so' rehtalil i ruti'kiil nuk'ux</para>
  <para style="q">xa re' chik i re' inkik'utjaaj.</para>
  <para style="q">
    <verse number="12" style="v" />Re' taqe i kitzuhnik chii' puerta xa re' chik i hin wilkiin pan kichii'.</para>
  <para style="q">Eh re' taqe xohk'reel kinkib'aj pankitz'uuy.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Eh re' hin QaJaaw Dios, chawach i hat i nub'an nutiij,</para>
  <para style="q">kinatoob'eej tii cho ruuk' i runimaal ak'axb'al.</para>
  <para style="q">Chayeew weh i nupahqaaj aweh, juneliik kinatoob'eej</para>
  <para style="q">reh chi nee kinako'leej.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hin k'ahchi' nuk'ulum i ti' k'axik,</para>
  <para style="q">k'ahchi' nujutlujiik qohoq pan ch'uwa'.</para>
  <para style="q">Eh chupaam i chaamlaj ha' wilkiin,</para>
  <para style="q">Jaaw kinako'leej pan kiq'ab' i ki-ixowanik nuwach.</para>
  <para style="q">
    <verse number="15" style="v" />Maa yeew q'ab' chi nee kiruk'am reje i kowlaj rooq ha',</para>
  <para style="q">chi nee kinooj qohoq chupaam i chaamlaj ha'.</para>
  <para style="q">Eh chi naa rumuq'aam nunaah i chaamlaj jul.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />QaJaaw chayeew tii weh i nupahqaaj aweh, ruum re' hat q'e' hat atoob' hat aj k'axool.</para>
  <para style="q">Ruuk' ta naq i runimaal awotob'il nee naketelaaj nuwach.</para>
  <para style="q">
    <verse number="17" style="v" />QaJaaw Dios, re' hin, hin awaj kamanoom, makinakanaa' tii chi wutkeel.</para>
  <para style="q">Kinatoob'eej la' ruum xiik' naah yohb'aliil wilkiin wii'.</para>
  <para style="q">
    <verse number="18" style="v" />Neeta tii ti wihik wuuk' chi nutoob'jiik,</para>
  <para style="q">reh chi nee kinako'leej pan kiq'ab' i ki-ixowanik nuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Re' hat aweht'al i nub'ajariik, i nukaqse'ljiik, i ruk'uhjiik nuk'ixb'ilaal inki a'n</para>
  <para style="q">Eh aweht'al nik' k'ihaal i ki-ixowanik nuwach.</para>
  <para style="q">
    <verse number="20" style="v" />Re' nub'ajariik inki a'n xponik kopan wánima.</para>
  <para style="q">Xuyoj nuk'ux, ma' xta chik nukowiil inwik'raaj.</para>
  <para style="q">Eh xnusik' naq awach naa ruye'wiik rusuqkiil nuk'ux</para>
  <para style="q">xa re' la' ma' awach ta wo' xketeliin nuwach.</para>
  <para style="q">
    <verse number="21" style="v" />Eh xkixilakeej i k'uxb'al nuwa'</para>
  <para style="q">ruuk' iq'oom inkansanik,</para>
  <para style="q">eh noq xwaaj nuhaa' ch'amlaj ha' i xkiyeew weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Ruum aj re', re' taqe i ninq'ijinik inki a'n noq inkiket kiib'</para>
  <para style="q">nee ta naq insutinik chi q'eb'al keh panti' k'axik.</para>
  <para style="q">
    <verse number="23" style="v" />Eh nee ta naq inakanaa' taqe chi je' b'urlik naq' kiwach.</para>
  <para style="q">Eh nee ta naq inakanaa' taqe chi xamb'arb'otik chik i pankaa'.</para>
  <para style="q">
    <verse number="24" style="v" />Neeta naq i nayeew aajosq'iil chikinaah,</para>
  <para style="q">nee ta naq inasach kiwach.</para>
  <para style="q">
    <verse number="25" style="v" />Eh kahnoq chi ntz'irik paam i rupaat,</para>
  <para style="q">ma' ta naq chik jino'q neenkahnik chupaam i ruye'aab'.</para>
  <para style="q">
    <verse number="26" style="v" />Ruum re' keh xkixowaaj wach i xataq'aaj chaloq chi xtib'ik ruk'ux.</para>
  <para style="q">Eh xkikaqse'laaj i xataq'aaj chaloq chi xuk'ul i ti' k'axik.</para>
  <para style="q">
    <verse number="27" style="v" />QaJaaw Dios, cha a'n cho jilow keh</para>
  <para style="q">i ma' holohik taj inki a'n maakuy kimahk.</para>
  <para style="q">
    <verse number="28" style="v" />Chajux i kib'ihnaal chupaam i ruhujil i k'acharik.</para>
  <para style="q">Maakoj i kib'ihnaal i wilik wii' i kib'ihnaal korik wach kik'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Re' i hin Jaaw, hat nuDios, q'e' ti' wilkiin,</para>
  <para style="q">ti' nuk'ux chaketelaaj tii nuwach, kinawesaj chupaam, eh kinako'leej.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Re' hin naa nuye'em ruloq'il ruuk' nutz'uuy i rub'ihnaal i nuDios,</para>
  <para style="q">naa wo' nuye'em runimaal wach t'iosb'al reh i rotob'il.</para>
  <para style="q">
    <verse number="31" style="v" />Ruuk' i re' neench'iklojik ruk'ux i QaJaaw Dios chuwach chi neenuk'at i b'oyax,</para>
  <para style="q">chi nee nuk'at i q'ina' laj rak'uun wakax chi numayiij,</para>
  <para style="q">wilik taqe ruk'aa', eh wilik taqe rixk'aq.</para>
  <para style="q">
    <verse number="32" style="v" />Eh noq naakilom i naa rub'anam i Dios taqe i ti' kik'ux naa rusuqb'iik kik'ux.</para>
  <para style="q">Eh naa ruye'ariik ruman i rukowiil kik'ux taqe i kisik'wik reh i Dios.</para>
  <para style="q">
    <verse number="33" style="v" />Re' QaJaaw Dios i rib'iraj i kitiij taqe ti' wilkeeb'.</para>
  <para style="q">Eh ma' rukanaa' ta taqe chi kutkeel i rak'uun rixq'uun wilkeeb' chi prexohjik.</para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" />Neeta naq inye'arik ruloq'il i Dios ruum i taxaaj, ruum i wach ak'al, ruum i palaw,</para>
  <para style="q">kuum chu'nchel i wilkeeb' chupaam taqe re'.</para>
  <para style="q">
    <verse number="35" style="v" />Re' QaJaaw Dios naa ruko'leem i tinamit Sión.</para>
  <para style="q">Eh naa wo' chik ruyejaam i tinamiit i Judá,</para>
  <para style="q">ar wo' chik naakipatiniik, naa wo' chik kehchaam.</para>
  <para style="q">
    <verse number="36" style="v" />Eh chu'nchel i kiih kimaam taqe raj kamanoom i Dios naakehchaam i ye'aab' re' re'.</para>
  <para style="q">Chu'nchel i kik'axwik reh i Dios ar naakipatiniik.</para>
  <chapter number="70" style="c" />
  <para style="s">Re' reey David xupahqaaj ree Dios chi naa rehtesjiik chupaam i ti' k'axik</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, cha kuy kinako'leej tii,</para>
  <para style="q">kinatoob'eej chi jumehq'iil.</para>
  <para style="q">
    <verse number="2" style="v" />Neeta naq kikahnik chi xase'lb'al chik</para>
  <para style="q">taqe inkaaj nukanteesjiik.</para>
  <para style="q">Eh nee ta naq inkimol chi elik ruum kik'ixiik</para>
  <para style="q">taqe i xa re' i yiib' wach inkikapaaj chi wiij.</para>
  <para style="q">
    <verse number="3" style="v" />Neeta naq inkimol chi elik</para>
  <para style="q">ruum kik'ixiik taqe i kikaqse'lanik weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh chu'nchel i kisik'wik aweh nee ta naq insuuqb'ik kik'ux.</para>
  <para style="q">Re' taqe i ki ajwanik reh i ko'lemb'al iib',</para>
  <para style="q">nee ta naq inkiq'or chi je' wili:</para>
  <para style="q">Xiik' naah nimaal wach i QaJaaw Dios, inko'q ta naq taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios q'e' ketel nuwach, ti' nuk'ux kinatoob'eej tii,</para>
  <para style="q">xa re' wo' hat titoob'inik weh.</para>
  <para style="q">Eh xa re' wo' hat nee ti eesanik weh chupaam i ti' k'axik,</para>
  <para style="q">Jaaw kinatoob'eej tii chi jumehq'iil.</para>
  <chapter number="71" style="c" />
  <para style="s">Re' rutiij xub'an i reey David noq riji' winaq chik</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, xa awuuk' i hat inusik' ko'lemb'al wiib'.</para>
  <para style="q">Ma' ta naq neenuk'uhtaaj nuk'ixb'ilaal.</para>
  <para style="q">
    <verse number="2" style="v" />Eh kinatoob'eej, kinako'leej ruuk' i rukorkiil wach ak'ux,</para>
  <para style="q">eh kinawesaj chupaam i ti' k'axik.</para>
  <para style="q">
    <verse number="3" style="v" />Je'-oq akab' jino'q i saqrehp ab'aj ke'emb'al iib',</para>
  <para style="q">reh chi nee kinako'leej kinatoob'eej.</para>
  <para style="q">Eh kinako'leej tii</para>
  <para style="q">ruum xa re' wo' hat ti ko'linik weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />WaJaaw nuDios, kinako'leej pan kiq'ab' i yiib' wach kina'ojb'al,</para>
  <para style="q">pan kiq'ab' i kib'anik weh i re' ma' re', yohb'aal wach i kijosq'iil.</para>
  <para style="q">
    <verse number="5" style="v" />Re' hin i nupahqaaj otob'il aweh ruum xa awuuk' wo' hat inuch'ikaa' nuk'ux.</para>
  <para style="q">Eh re' wo' hat ticha'jinik weh noq ko hin cho ak'un.</para>
  <para style="q">
    <verse number="6" style="v" />Eh xa awuuk' wo' hat i nuyeew chee nuk'ux noq ko xintz'uhkrik cho ruuk' i nutuut.</para>
  <para style="q">Eh ruuk' awotob'il xin-aasjik</para>
  <para style="q">ruum aj re' naa nuye'em aloq'il chi juneliik.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Ma' k'isiin taqe insahchik kik'ux noq inkilow chi</para>
  <para style="q">re' hat ruuk' awajaawriik kinako'leej chupaam i ti' k'axik.</para>
  <para style="q">
    <verse number="8" style="v" />Je' re' noq re' hin chu'nchel q'iij i nuyeew aloq'il ruuk' nuchii',</para>
  <para style="q">eh i nuyeew runimaal awach.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hin weht'al chi ma' nee ta kinakanaa' chi wutkeel,</para>
  <para style="q">atoob' ta hin chik riji' winaq chi korik, atoob' ta ma' xta chik rukowiil i nuti'jolal.</para>
  <para style="q">
    <verse number="10" style="v" />Re' taqe ki-ixowanik weh xkian jinaj wach k'ik'ux.</para>
  <para style="q">Eh pankomonil k'ahchi' kiyejaam wach nukanteesjiik.</para>
  <para style="q">
    <verse number="11" style="v" />Je' wili inkiq'or chi wiij: Qasik' qachop taq,</para>
  <para style="q">ruum xkanab'jik chik ruum i ruDios,</para>
  <para style="q">ma' awach ta chik neenko'linik reh, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />QaJaaw Dios, makinakanaa' tii chi wutkeel,</para>
  <para style="q">kinatoob'eej la' chi jumehq'iil.</para>
  <para style="q">
    <verse number="13" style="v" />Neeta naq inkik'uhtaaj kik'ixb'ilaal,</para>
  <para style="q">nee ta naq insahchik kiwach inkaaj nukanteesjiik.</para>
  <para style="q">Eh nee ta naq kikahnik chi xa se'lb'al taqe i xa re' i ti' k'axik inki a'n weh.</para>
  <para style="q">
    <verse number="14" style="v" />Eh re' hin juneliik k'ahchi' wuy-eem aawotob'il,</para>
  <para style="q">eliik neenuyeew aloq'il.</para>
  <para style="q">
    <verse number="15" style="v" />Eh ruuk' nuchii' naa nuq'orom chi korik wach ak'ux,</para>
  <para style="q">juneliik naa nuq'orom rib'iral chi xa re' wo' hat ti ko'linik qeh.</para>
  <para style="q">Eh re' hin xata wo' jarpech hin ako'leem.</para>
  <para style="q">
    <verse number="16" style="v" />QaJaaw Dios, re' hin naa nuq'orom rib'iral taqe nimaq wach na'ojb'al aab'anam chaloq.</para>
  <para style="q">Eh naa wo' nuq'orom rib'iral chi xa re' wo' hat korik wach ak'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />WaJaaw, nuDios, re' hat</para>
  <para style="q">kopan wak'uniil xtohq'ik</para>
  <para style="q">cho ak'uhtaam weh i korik,</para>
  <para style="q">eh xink'u'loq ayu',</para>
  <para style="q">yu'naak chi kok'ahchi' nuq'orom</para>
  <para style="q">rib'iral taqe i na a'n ruuk' i runimaal awajaawriik.</para>
  <para style="q">
    <verse number="18" style="v" />WaJaaw, nuDios,</para>
  <para style="q">makinakanaa' chi wutkeel</para>
  <para style="q">atoob' ta hin chik riji' winaq, saq chik i rismaal nunaah.</para>
  <para style="q">Ruum re' hin ko nwaaj nuq'orom</para>
  <para style="q">rib'iral awajaawriik keh i wilkeeb' yu'naak</para>
  <para style="q">keh i naa kiwihiik na'chub'an.</para>
  <para style="q">
    <verse number="19" style="v" />NuDios, re' rukorkiil wach ak'ux xiik' naah nimaal wach.</para>
  <para style="b" />
  <para style="q">Ruum re' hat yohb'aal wach i na a'n ruuk' awajaawriik.</para>
  <para style="q">Eh ma' xta chik jino'q Dios chi je' rukab' i hat.</para>
  <para style="q">
    <verse number="20" style="v" />Atoob' ta xayeew q'ab'</para>
  <para style="q">chi xnuk'ul i ma' k'isa ti' k'axik.</para>
  <para style="q">Eh ma' k'isiin ta xtib'ik nuk'ux nee wo' chik i nayeew nukowiil</para>
  <para style="q">pan chaamlaj jul naa kiin awuksam chaloq.</para>
  <para style="q">
    <verse number="21" style="v" />Eh naa aye'em ruman i runimaal nuwach,</para>
  <para style="q">eh naa wo' chik aye'em rusuqkiil nuk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Re' hin naa nut'iosem aweh i na a'n.</para>
  <para style="q">Naa nutz'uyem awach ruuk' arpa, ruuk' k'ahaam wach q'ooj,</para>
  <para style="q">i hat nuDios, Santo chikinaah i qatinamiit Israel.</para>
  <para style="q">
    <verse number="23" style="v" />Eh xasuq chik nuk'ux</para>
  <para style="q">noq neenutz'uyej awach ruuk' nuchii'.</para>
  <para style="q">Chu'nchel wánima nee tinuloq'ej ruum re' hat xat ko'linik weh.</para>
  <para style="q">
    <verse number="24" style="v" />Eh juneliik naa nuq'orom</para>
  <para style="q">rib'iral chi re' hat korik wach ak'ux.</para>
  <para style="q">Aha' naq wilik taqe i xa re' i ti' k'axik inkaaj kianam weh</para>
  <para style="q">ma' k'isiin ta xkik'uhtaaj kik'ixb'ilaal.</para>
  <chapter number="72" style="c" />
  <para style="s">Re' reey David xub'an rutiij chi riij i rak'uun naa rokiik chi reyil</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, chayeew ta tii runa'ojb'al,</para>
  <para style="q">rukorkiil wach ruk'ux i wak'uun naa rokiik chi reyil.</para>
  <para style="q">
    <verse number="2" style="v" />Reh chi parub'ehel naa ruq'atam q'orik chikinaah aatinamiit.</para>
  <para style="q">Eh parub'ehel naa ruq'atam q'orik chikinaah ti' wilkeeb'.</para>
  <para style="q">
    <verse number="3" style="v" />Re' taqe ye'aab' parax yuuq' nee ta naq</para>
  <para style="q">ruyeew taqe pansuqkiil k'uxliis,</para>
  <para style="q">parurukorkiil wach k'uxliis i tinamit.</para>
  <para style="q">
    <verse number="4" style="v" />Re' naa rokiik chi reyil naa</para>
  <para style="q">rub'anam i q'ataj q'orik parub'ehel.</para>
  <para style="q">Eh naa ruko'leem taqe i ma' xta wilik keh,</para>
  <para style="q">eh naa rusacham kiwach imb'anik ti' k'axik keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh naakiyohleem awach nik' najtiil</para>
  <para style="q">naa rub'anam i rusaqumaal i q'iij,</para>
  <para style="q">i rusaqumaal i poh ayu' wach ak'al.</para>
  <para style="q">
    <verse number="6" style="v" />Eh nee ta naq i rujoot'isaj wach i ti' k'axik</para>
  <para style="q">je' rukab' rub'an i jab' noq i rut'aqsaj aak'al,</para>
  <para style="q">eh noq i rut'aqsaj taqe i ch'ahn.</para>
  <para style="q">
    <verse number="7" style="v" />Nik' najtiil naa rub'anam i taaq'anik</para>
  <para style="q">nee ta naq inwihik i suq kiil k'uxliis,</para>
  <para style="q">rukorkiil wach k'uxliis nik' najtiil</para>
  <para style="q">neerub'an i rusaqumaal i poh ayu' wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Neeta naq inwihik rajaawriik chinaah i palaw,</para>
  <para style="q">je' wo' chinaah i palaw jinaj chik,</para>
  <para style="q">je' wo' chinaah i nim ha' Éufrates,</para>
  <para style="q">je' wo' sut i wach ak'al.</para>
  <para style="q">
    <verse number="9" style="v" />Eh re' taqe wilkeeb' panchiq yuuq' inaakixowaniik wach,</para>
  <para style="q">nee ta naq inkiloch' kiib' chuwach</para>
  <para style="q">noq neenkiq'asaj kiib' reh.</para>
  <para style="q">
    <verse number="10" style="v" />Eh ma' k'isiin i rukooch naa ruk'uliik ye'aroq kuum i ruch reey,</para>
  <para style="q">naa kichaliik Tarsis, inaakichaliik chupaam</para>
  <para style="q">i ye'aab' sutimaj riij chi ha',</para>
  <para style="q">inaakichaliik Sabá, eh Seba.</para>
  <para style="q">
    <verse number="11" style="v" />Chu'nchel ta naq i reey neenkixuk'aa' kiib' chuwach.</para>
  <para style="q">Eh chu'nchel ta naq i tinamit neekik'ulwik reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' reh naa ruko'liniik reh i ti' wilik</para>
  <para style="q">re' i rupahqaaj chi naa rutoob'jiik.</para>
  <para style="q">Eh je' wo' hoq i ma' xta wilik reh,</para>
  <para style="q">ma' awach ta ntoob'inik reh.</para>
  <para style="q">
    <verse number="13" style="v" />Re' reh naa ruketelaam kiwach i xama' nimaq ta kiwach.</para>
  <para style="q">Eh naa ruko'leem riij i kik'achariik ti' wilkeeb'.</para>
  <para style="q">
    <verse number="14" style="v" />Naa wo' ruko'leem taqe chuwach i yiib' wach minooj taqe wii'.</para>
  <para style="q">Eh je' wo' chuwach taqe i ti' k'axik,</para>
  <para style="q">ruum q'e' k'ih tz'aaq i kik'achariik chi ree reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Najt ta naq neenk'acharik i naa rokiik chi reyil.</para>
  <para style="q">Neeta naq inye'arik reh i oro inchalik Sabá.</para>
  <para style="q">Pahqb'al ta naq i rotob'il i Dios chi riij i reh chi neenkuxesjik.</para>
  <para style="q">
    <verse number="16" style="v" />Neeta naq kiwachinik i trigo</para>
  <para style="q">panqatinamiit, nee ta naq kiwachinik i tik ju' taq yuuq'.</para>
  <para style="q">Je'-oq kik'ihaal i chee' wilkeeb' Líbano,</para>
  <para style="q">nee ta kik'ihaaxb'iik i tinamit</para>
  <para style="q">chi je' kik'ihaal taqe ch'ahn wilkeeb' wach ak'al.</para>
  <para style="q">
    <verse number="17" style="v" />Ma' ta naq neensahchik wach</para>
  <para style="q">i rub'ihnaal i naa rokiik chi reyil.</para>
  <para style="q">Holohik ta naq rib'iral chi juneliik</para>
  <para style="q">nik' najtiil naa ruwihiik i rusaqumaal i q'iij.</para>
  <para style="q">Eh chu'nchel ta naq i neen kik'ul</para>
  <para style="q">i rotob'il i Dios ruum i reh,</para>
  <para style="q">eh nee ta naq i inkiq'or chi atoob' reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Neeta naq inye'arik ruloq'il i QaJaaw,</para>
  <para style="q">re' i qaDios i hoj, hoj aj Israel,</para>
  <para style="q">ruum xa re' wo' reh imb'anik i nimaq wach na'ojb'al.</para>
  <para style="q">
    <verse number="19" style="v" />Eh nee ta naq inye'arik ruloq'il chi juneliik i loq'laj rub'ihnaal.</para>
  <para style="q">Neeta naq inwihik kuuk' i ruloq'il chu'nchel i tinamit.</para>
  <para style="q">Je' ta wo' naq re'.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Ayu' xukohlaaj wach i rutiij i reey David rak'uun i Isaí.</para>
  <chapter number="73" style="c" />
  <para style="s">Naa rureqem i ruq'ijil chi naa kitojom i kimahk i ma' holohik ta kib'anik</para>
  <para style="q">
    <verse number="1" style="v" />Xti korik noq re' qaDios xiik' naah rotob'il kuuk' i aj Israel</para>
  <para style="q">saq wach i kánima.</para>
  <para style="q">
    <verse number="2" style="v" />Eh re' hin, k'isiin ma' xinkalojik,</para>
  <para style="q">xwaaj naq nukanaam runimjiik i Dios.</para>
  <para style="q">
    <verse number="3" style="v" />Ruum nukaqwachej taqe inkinimb'isaj kiwach, eh noq xwilow chi kielik korik i</para>
  <para style="q">yiib' wach kina'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' keh ma' kimik tan kikapaaj kow taqe</para>
  <para style="q">ma' xta k'isinoq kiyab'ilaal.</para>
  <para style="q">
    <verse number="5" style="v" />Eh ma' inkik'ul ta keh i ruti'kiil k'uxliis je' rukab' ink'ularik,</para>
  <para style="q">ma' xta ti' inkik'ul je' rukab' inkik'ul i tokoom.</para>
  <para style="q">
    <verse number="6" style="v" />Re' niimb'isanik kiwach inki a'n inkikoj chi xoyb'al kiib'.</para>
  <para style="q">Eh re' i ti' k'axik inki a'n reh i tokoom inkikoj chi kiso'.</para>
  <para style="q">
    <verse number="7" style="v" />Re' keh xa nelik chik chaloq inaq'kiwach ruum kiq'ina'iil.</para>
  <para style="q">Eh xa re' i yiib' wach na'ojb'al inki a'n re' nujinaq cho pan kánima.</para>
  <para style="q">
    <verse number="8" style="v" />Ruuk' jot'ooj, ruuk' niimb'isanik wachiis, ruuk' yiib' wach Q'orik inki a'n</para>
  <para style="q">i ti' k'axik reh i kas kichaaq'.</para>
  <para style="q">
    <verse number="9" style="v" />Eh inkib'aj i Dios wilik cho pan taxaaj.</para>
  <para style="q">Eh re' inkiq'or imponik rib'iral chi junsuut i wach ak'al,</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Ruum aj re' inye'arik runimaal kiwach kuum i tinamit,</para>
  <para style="q">inkikapaaj i keh chi ma' xtaj i yiib' wach inki a'n</para>
  <para style="q">
    <verse number="11" style="v" />Eh je' wili inkiq'or: ¿Mi reht'al re' i Dios inki a'n?</para>
  <para style="q">¿Mi rukoj rehtaal re' i QaJaaw nim rajaawriik? inki taqe.</para>
  <para style="q">
    <verse number="12" style="v" />Re' taqe yiib' wach kina'ojb'al re' re'.</para>
  <para style="q">Ma' xta inq'ilwik keh noq inkimol wach i kib'ehomal.</para>
  <para style="q">
    <verse number="13" style="v" />Re' hin wilik pech i nukapaaj chi xama' xta nkih chi saq wach i wánima</para>
  <para style="q">oon chi nukanaam i yiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="14" style="v" />Ruum re' hin chu'nchel i q'iij inkitib'isaj nuk'ux.</para>
  <para style="q">Eh juneliik pantaq wahq'eq inki a'n ti' k'axik weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Xnub'an ta wee hin i je' rukab' inki a'n i yiib' wach kina'ojb'al re' re',</para>
  <para style="q">xnumin naq taqe panti' k'axik aawak'uun awixq'uun.</para>
  <para style="q">
    <verse number="16" style="v" />Re' hin xwaaj naq nureqem chi riij,</para>
  <para style="q">xa re' la' xama' xnureq ta wo' chi riij.</para>
  <para style="q">
    <verse number="17" style="v" />Kore' noq xi nokik pan aapaat,</para>
  <para style="q">kora'j xnureq chi riij re' aha' naa kojiik pa'lojoq i yiib' wach kina'ojb'al re' re'.</para>
  <para style="q">
    <verse number="18" style="v" />Xnureq chi riij chi panyohb'aal taqe aye'em,</para>
  <para style="q">k'ahchi' taqe aminim chupaam chi naa rojiik sahchoq kiwach.</para>
  <para style="q">
    <verse number="19" style="v" />Eh xa chi jumehq'iil naa rojiik sahchoq kiwach.</para>
  <para style="q">Ma' k'isiin ta naa ruchaliik kiyo'jiik, re' re' naa rub'aniik keh.</para>
  <para style="q">
    <verse number="20" style="v" />QaJaaw Dios nik' wach noq inwuktik chi jumehq'iil jino'q i wirik i rub'an.</para>
  <para style="q">Je' re' noq naa awuktiik i hat chub'aan keh</para>
  <para style="q">i yiib' wach kina'ojb'al, ruum ma' imponik ta chawach inki a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Eh noq xb'iraj chi je' re' naa a'nam keh,</para>
  <para style="q">xtib'ik nuk'ux i hin, xa nyot'ik chik i wánima.</para>
  <para style="q">
    <verse number="22" style="v" />Ruum re' hin ma' kinimanik ta naq chawach,</para>
  <para style="q">ma' nureq ta naq chi riij je' naq nukab' i kawáyu.</para>
  <para style="q">
    <verse number="23" style="v" />Atoob' ta je' re' nuna'ojb'al,</para>
  <para style="q">re' hin xa awuuk' wo' hat nuye'em nuk'ux.</para>
  <para style="q">Eh re' hat achopom chi rusak'aaj nuq'ab'.</para>
  <para style="q">
    <verse number="24" style="v" />Eh i nak'am nub'eeh ruuk' aak'uhb'aal,</para>
  <para style="q">eh na' ohoq kuxoq naa kiin ak'ulum</para>
  <para style="q">chaawuuk' chupaam i loq'laj taxaaj.</para>
  <para style="q">
    <verse number="25" style="v" />Re' hin xa awuuk' wo' hat i nuyeew nuk'ux,</para>
  <para style="q">ruum ma' awach ta chik jino'q neentoob'inik weh</para>
  <para style="q">chi je' rukab' i hat, ni xata taxaaj wilik,</para>
  <para style="q">ni xata wach ak'al wilik.</para>
  <para style="q">
    <verse number="26" style="v" />Re' nuti'jolal xama' xta chik rukowiil.</para>
  <para style="q">Xa re' la' weht'al chi re' Dios inko'linik weh,</para>
  <para style="q">eh re' reh inye'wik rukowiil i wánima chi juneliik.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Eh re' taqe inkikanaa' animjiik naa kikimiik,</para>
  <para style="q">eh naa asacham wach i ma' korik ta wach ruk'ux awuuk'.</para>
  <para style="q">
    <verse number="28" style="v" />Eh chi wee hin q'e' chihooj animjiik hat waJaaw nuDios.</para>
  <para style="q">Ruum xa re' wo' hat ti ko'linik weh, naa nuye'em nuk'ux awuuk'</para>
  <para style="q">reh chi naa nuq'orom rib'iral chu'nchel i na a'n.</para>
  <chapter number="74" style="c" />
  <para style="s">Re' reey David xupanqaaj ree Dios parutiij chi naa rehtesjiik panti' k'axik i rutinamiit</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, ¿Chib'ih reet noq xoj akanaa' chi qutkeel chi jumpech?</para>
  <para style="q">¿Chib'ih reet noq yohb'aal wach aajosq'iil chi qanaah i hoj, i hoj atentzuun noqwilkooj?</para>
  <para style="q">
    <verse number="2" style="v" />K'oloq cho panak'ux re' aatinamiit re' i xa wehchaaj cho pampeet.</para>
  <para style="q">Eh xawesaj cho panti' k'axik reh chi xakoj haa' chi junch'uq taqe chi aatinamiit.</para>
  <para style="q">Eh k'oloq panak'ux i ye'aab' Sión re' i ti wihik wii'.</para>
  <para style="q">
    <verse number="3" style="v" />Chawilow nik' wach noq xyojib'ik wach aatinamiit.</para>
  <para style="q">Re' aj ixowaal sachwik wach chu'nchel</para>
  <para style="q">chib'ih jariik wilik chupaam asantolaj ye'aab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' taqe i ki-ixowanik awach xi okik panapaat,</para>
  <para style="q">k'erlik kichii' chuq'orariik chi xi elik korik.</para>
  <para style="q">Eh kikojom chik rehtalil chi keh chik.</para>
  <para style="q">
    <verse number="5" style="v" />Eh xa je' chik rukab' noq kiokik chuyok'ariik i rax chee'</para>
  <para style="q">ruuk' ikej inki a'n reh i ookb'al chupaam aaye'aab'.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taqe i och'imaj wach chee' kojooj</para>
  <para style="q">reh i paat xkipaxej ruuk' ikej, je' wo' ruuk' tuhyb'al kalawux.</para>
  <para style="q">
    <verse number="7" style="v" />Eh xkikoj ruq'aq'al i asantolaj ye'aab'.</para>
  <para style="q">Xkian i re' ma' re' chupaam aapaat, eh xkikutib'eej wach ak'al.</para>
  <para style="q">
    <verse number="8" style="v" />Xkaaj naq kisacham wach chu'nchel i chib'ih qeh,</para>
  <para style="q">xkik'atib'eej chu'nchel i ye'aab' tiqaloq'ej wii', wilkeeb' chupaam i tinamit.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Ma' awach ta chik ink'uhtanik qeh jino'q i ehtalil,</para>
  <para style="q">ruum ma' jino'q chik i jalal ruq'oral i Dios.</para>
  <para style="q">Eh ma' jino'q imb'inik reh nik' chik najtiil naa qak'ulum i wili.</para>
  <para style="q">
    <verse number="10" style="v" />QaJaaw Dios, ¿Nik' chik najtiil naa qak'ulum i ti' k'axik pan q'ab' i aj ixowaal re' re'?</para>
  <para style="q">Eh ¿Kojaruuj i rukanaa' i ma' holohik ta laj q'orik chawiij i hat?</para>
  <para style="q">
    <verse number="11" style="v" />¿Chib'ih reet noq ma' nak'uhtaaj reh aajosq'iil?</para>
  <para style="q">¿Chib'ih reet noq xak'ahchi' akanaam chi je' re' i rub'an?</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />QaJaaw Dios, re' hat xa najtir wo' cho q'iij hat nureey.</para>
  <para style="q">Xa re' wo' hat, ti ko'linik pan kiq'ab' i aj ixowaal chi junsuut i wach ak'al.</para>
  <para style="q">
    <verse number="13" style="v" />Eh ruuk' awajaawriik xa chiqsaj i kaq palaw.</para>
  <para style="q">Eh ar taqe xamuq'aa' kinaah i je' taqe josq'laj nimaq chikop.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hat xakansaj i je' qamaan k'ap.</para>
  <para style="q">Eh re' ruti'jolal xayeew chi kiwa' i josq'laj chikop</para>
  <para style="q">wilkeeb' chupaam i ye'aab' chiq yuuq'.</para>
  <para style="q">
    <verse number="15" style="v" />Eh aha' ma' xta ha' ruuk' awajaawriik xpoq' chaloq i ha' xakow chik rooq.</para>
  <para style="q">Xa chiqsaj i nim ha' xi-ik'ik wii' i aj Israel.</para>
  <para style="q">
    <verse number="16" style="v" />Re' hat ti ye'wik reh i q'iij, je' wo' hoq i aq'ab'.</para>
  <para style="q">Eh re' hat ti ye'wik paruye'aab' i q'iij, je' wo' hoq i poh.</para>
  <para style="q">
    <verse number="17" style="v" />Re' hat xatyej-anik reh chu'nchel i wach ak'al,</para>
  <para style="q">re' wo' hat xatq'atwik cho riij i si'q'jil, je' wo' hoq iq'ilej.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Eh mansahchik panak'ux chi re' inixowanik awach ma' holohik ta inq'orik chawiij.</para>
  <para style="q">Je' wo' i tinamit yeb'ee wach i kina'ojb'al ma' holohik ta wo' kiq'orik chawiij.</para>
  <para style="q">
    <verse number="19" style="v" />Maa qohsahchik tii panak'ux i hoj ruum ma' kow ta qak'ux, xa je' qakab' i kok' mukur.</para>
  <para style="q">Eh maayeew q'ab' chi neenkian qeh i je' josq'laj chikop.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />K'oloq panak'ux aaq'orom cho qeh chi naa a'nam quuk'.</para>
  <para style="q">Ruum yohb'aal wach i ti' k'axik k'ahchi' ruk'ulariik panqatinamiit,</para>
  <para style="q">je' wo' hoqsut i wach ak'al.</para>
  <para style="q">
    <verse number="21" style="v" />Mayeew q'ab' chi neemanab'jik i ruti'kiil kik'ux aatinamiit, chako'leej la' taqe.</para>
  <para style="q">Je' wo' taqe i wilkeeb' paneb'a'il reh chi nee tikiloq'ej.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />QaJaaw Dios, chako'leej taqe ruuk' i k'ahchi' kik'ulum i kinimanik aweh.</para>
  <para style="q">Ruum re' taqe yiib' wach kina'ojb'al ma' kihi'lik ta chab'ajariik.</para>
  <para style="q">
    <verse number="23" style="v" />Eh maakanaa' chi je' re' i k'erej kichii' inki a'n ki-ixowanik awach.</para>
  <para style="q">Ruum re' keh k'ahchi' rojiik chi nimaal i k'ahchi' keeb'.</para>
  <chapter number="75" style="c" />
  <para style="s">Xa re' wo' Dios i xti korik laj q'atal q'orik</para>
  <para style="q">
    <verse number="1" style="v" />Inqat'iosej aweh QaJaaw Dios, inqat'iosej aweh,</para>
  <para style="q">ruum ma' najt ta wilkaat quuk' chi qatoob'jiik.</para>
  <para style="q">Inqaq'or rib'iral taqe i sachb'al k'uxliis i na a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw Dios je' wili ruq'or:</para>
  <para style="q">Noq naa ruponiik i q'iij chi nuwach i hin naa nuq'atam q'orik parub'ehel.</para>
  <para style="q">
    <verse number="3" style="v" />Atoob' ta neenk'uyu'jik i wach ak'al,</para>
  <para style="q">je' wo' taqe i patim chupaam ma' xta nee ruk'ul</para>
  <para style="q">ruum re' hin kinchopwik reh i raa' ri'sil, inki.</para>
  <para style="q">
    <verse number="4" style="v" />Eh re' taqe i q'e' inkinimb'isaj kiwach,</para>
  <para style="q">i yiib' wach kina'ojb'al je' wili i nuq'or keh:</para>
  <para style="q">Maa niimb'isaj taq chik awach.</para>
  <para style="q">
    <verse number="5" style="v" />Eh mo-oq xa wilik taq awajaawriik i na a'n awiib',</para>
  <para style="q">maa a'n taq chik i kowlaj q'orik chi nub'ajariik, inki i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Ruum chupaam chu'nchel i wach ak'al ma' awach taj</para>
  <para style="q">i neerub'an ruye'ariik rajaawriik i tinamit.</para>
  <para style="q">
    <verse number="7" style="v" />Re' la' QaJaaw Dios neenye'wik rajaawriik i tinamit,</para>
  <para style="q">oon neeresaj i rajaawriik. Ruum xa re' wo' reh q'atal q'orik.</para>
  <para style="q">
    <verse number="8" style="v" />Re' QaJaaw Dios je' naa ruyohq'eem jinaj</para>
  <para style="q">i kulk nujinaq wii' i rujosq'iil</para>
  <para style="q">je' naa vino xilakkimaj xiik' naah k'ahiil.</para>
  <para style="q">Eh noq naa ruchihkaam chaloq,</para>
  <para style="q">naa kuk'em keh tinamit yiib' wach</para>
  <para style="q">i kina'ojb'al wilkeeb' sut i wach ak'al,</para>
  <para style="q">ma' xta chik i naa kikanaam.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Eh re' hin xanaa wo' nuq'orom rib'iral,</para>
  <para style="q">naa nutz'uyem wach chi juneliik i ruDios i Jacob.</para>
  <para style="q">
    <verse number="10" style="v" />Ruum re' reh naa rusachwiik wach</para>
  <para style="q">i kajaawriik taqe i yiib' wach kina'ojb'al.</para>
  <para style="q">Eh re' korik wach ruk'ux naa ruye'em ruman i rajaawriik.</para>
  <chapter number="76" style="c" />
  <para style="s">Re' Dios i ruq'at kiwach chu'nchel i wilik kajaawriik</para>
  <para style="q">
    <verse number="1" style="v" />Re' QaJaaw Dios naab'imaj wach ar Judá.</para>
  <para style="q">Eh xiik' naah holwochiil i rub'ihnaal ar Israel.</para>
  <para style="q">
    <verse number="2" style="v" />Re' i rupaat i Dios inwihik wii',</para>
  <para style="q">ar wilik chinaah i yuuq' Sión ar Jerusaleem.</para>
  <para style="q">
    <verse number="3" style="v" />Eh ar ruuk' i rajaawriik xutoq i kiflecha,</para>
  <para style="q">i pulato ch'ihch', i kiq'aslaj ch'ihch' aj ixowaal re' inkikoj reh q'aq'inik.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />QaJaaw Dios xiik' naah aaloq'il awajaawriik,</para>
  <para style="q">ma' xata je' rukab' taqe rax chee' wilkeeb' chi juneliik.</para>
  <para style="q">
    <verse number="5" style="v" />Eh re' taqe i q'e' kow kiib' xq'ucharik i chib'ih keh.</para>
  <para style="q">Eh xqajik i kiwiriik atoob' ta q'e' wo' naq kow kiib',</para>
  <para style="q">ma' xta wo' i xkian noq xooj kuxoq.</para>
  <para style="q">
    <verse number="6" style="v" />QaJaaw, ruDios Jacob noq i inaq'or chi naa a'nam keh,</para>
  <para style="q">ni xata naq chik re' i kikareta, i kikawayu inkik'uyu'saj.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Eh xiik' naah yohb'alil awach.</para>
  <para style="q">Ma' awach ta jino'q ineerukuy i pa'lojik</para>
  <para style="q">chawach noq qopinaq aajosq'iil.</para>
  <para style="q">
    <verse number="8" style="v" />Kopan taxaaj i na a'n chaloq i q'ataj q'orik.</para>
  <para style="q">Eh re' taqe i wilkeeb' wach ak'al ma' k'isiin ta kiyo'jiik, eh kikahniik meem.</para>
  <para style="q">
    <verse number="9" style="v" />QaJaaw Dios, ¿kojaruuj aj wo' na a'n re' i q'ataj q'orik?</para>
  <para style="q">reh chi nee taqe nako'leej chu'nchel i k'ahchi' rub'aan ti' k'axik keh ayu' wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' rujosq'iil i winaq xama' xta wo' neetiruchej, insutinik la' chi loq'oomb'al aweh,</para>
  <para style="q">eh chi ye'b'al runimaal awach.</para>
  <para style="q">
    <verse number="11" style="v" />Chayeew taq reh aaDios aaq'orom taq chi naa aye'em reh.</para>
  <para style="q">Eh re' taq i hat i wilkaat taq chi junsuut i reh,</para>
  <para style="q">chak'am taq chaloq alemóxna chuwach, i yohljik iraaj wach.</para>
  <para style="q">
    <verse number="12" style="v" />Ruum re' reh ineesanik i kik'achariik taqe i k'amal b'eeh.</para>
  <para style="q">Eh chuwach i reh kiyo'jik taqe reey wilkeeb' wach ak'al.</para>
  <chapter number="77" style="c" />
  <para style="s">Re' rukapeb'jiik riij i nimaq wach na'ojb'al i rub'an i Dios</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin, re' nuDios inuq'o'reej</para>
  <para style="q">chi kow panutiij, reh chi kirib'iraj.</para>
  <para style="q">
    <verse number="2" style="v" />Eh noq intz'irik nuwach inusik' i QaJaaw,</para>
  <para style="q">xa eliik wo' naq i nujosaj i nuq'ab' chub'aan i nutiij pantaq chaq'ab'.</para>
  <para style="q">Xa re' la' xama' nureq ta wo' rusuqkiil i wánima.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Noq ink'ulik panuk'ux i nuDios inchalik woq'iim.</para>
  <para style="q">Eh noq i nukapaaj riij i rutz'irkiil nuwach inyoj wo' chik nuk'ux.</para>
  <para style="q">
    <verse number="4" style="v" />QaJaaw Dios, re' hat ma' naaqasaj ta naq chik, i nuwiriik.</para>
  <para style="q">Eh insahchik nuk'ux, xama' kinchol ta chik q'orik.</para>
  <para style="q">
    <verse number="5" style="v" />Re' hin ink'ulik cho panuk'ux nik' wach xinik'ik cho wii' chupaam taqe q'iij,</para>
  <para style="q">chupaam taqe haab' ik'inaq chaloq.</para>
  <para style="q">
    <verse number="6" style="v" />Eh ink'ulik wo' panuk'ux noq inutz'uyej awach pantaq chaq'ab'.</para>
  <para style="q">Eh i nukapaaj riij, i nupahqaaj panuk'ux chi je' wili:</para>
  <para style="q">
    <verse number="7" style="v" />¿Mi ma' naa chik rik'iik chi jumpech re' i ruk'aah i QaJaaw?</para>
  <para style="q">¿Mi ma' nee wo' chik i ruyeew qeh re' i rotob'il?</para>
  <para style="q">
    <verse number="8" style="v" />¿Xumay ta'j inchel i k'axooj chi jumpech?</para>
  <para style="q">¿Xsahchik ta'j inche paruk'ux i ruq'orom chaloq chi naa rub'anam quuk'?</para>
  <para style="q">
    <verse number="9" style="v" />¿Xsahchik ta'j inche paruk'ux i Dios i rotob'il?</para>
  <para style="q">¿Mi xti ma' nkuyjik chik re' i rujosq'iil</para>
  <para style="q">chi ma' neeruketelaaj qawach? kinki panuk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' xti ruti'kiil panuk'ux i hin,</para>
  <para style="q">re' chi nk'ulik panuk'ux chi re' qaDios nim rajaawriik,</para>
  <para style="q">ma' rub'an ta chik qatoob'jiik je' rukab'</para>
  <para style="q">i rub'an cho quuk' noq xub'an.</para>
  <para style="q">
    <verse number="11" style="v" />Re' hin naa ruk'uliik panuk'ux taqe</para>
  <para style="q">i sahchb'al k'uxliis rub'anam quuk' i QaJaaw najtir cho q'iij.</para>
  <para style="q">
    <verse number="12" style="v" />Eh naa nukapaam riij chu'nchel i rub'anam,</para>
  <para style="q">naa nuq'orom rib'iral chu'nchel i rub'an.</para>
  <para style="q">
    <verse number="13" style="v" />QaJaaw Dios, re' hat ma' xta chik jino'q i Dios nim rajaawriik</para>
  <para style="q">chawach ruum re' hat Santo ab'eeh.</para>
  <para style="q">
    <verse number="14" style="v" />Xa re' wo' hat i Dios i na a'n taqe sahchb'al k'uxliis.</para>
  <para style="q">Eh xayeew chi naab'jik awajaawriik keh i nimaq tinamit.</para>
  <para style="q">
    <verse number="15" style="v" />Ruuk' awajaawriik xako'leej taqe aatinamiit re' taqe rak'uun rixq'uun i Jacob,</para>
  <para style="q">ruch'ihil taqe i rak'uun rixq'uun i José.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />QaJaaw Dios, noq xrilow awajaawriik i palaw</para>
  <para style="q">xyo'jik awuum,</para>
  <para style="q">eh xti nk'uyu'jik taqe i ruha'iil xiik' naah kichamiil.</para>
  <para style="q">
    <verse number="17" style="v" />Re' taqe suutz' xkiyeew chaloq i ma' k'isa jab'.</para>
  <para style="q">Eh xa nteleninik chik i kahoq pan taxaaj,</para>
  <para style="q">xan saqumanik chik i ruch'aab'.</para>
  <para style="q">
    <verse number="18" style="v" />Eh x-ib'irjik noq xq'orik chaloq taqe kahoq chupaam i teew jab'.</para>
  <para style="q">Eh xusihq'eej i wach ak'al taqe ruch'aab',</para>
  <para style="q">xk'uyu'jik aak'al chi kow ruum iyihk.</para>
  <para style="q">
    <verse number="19" style="v" />Xateh i-ik'b'al panyejaal i palaw,</para>
  <para style="q">panyejaal taqe nim ha'.</para>
  <para style="q">Eh noq xa a'n chaloq taqe re', ma' awach ta x-ilwik aweh.</para>
  <para style="q">
    <verse number="20" style="v" />Re' hat xak'am cho kib'eeh aatinamiit chi je' kik'amarik cho tentzun.</para>
  <para style="q">Eh re' Moisés, re' i Aarón xakoj chaloq chi k'amal kib'eeh.</para>
  <chapter number="78" style="c" />
  <para style="s">Re' otob'il xub'an i Dios kuuk' i rutinamiit</para>
  <para style="q">
    <verse number="1" style="v" />Hat taq nutinamiit chakoj taq rehtaal i nuk'uhb'aal.</para>
  <para style="q">Eh chab'iraj taq i naa nuq'orom.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin nuch'ob'om rub'ehel taq aweh taqe b'anooj chaloq najtir q'iij,</para>
  <para style="q">re' taqe i ma' awach ta tehwenaq cho wach.</para>
  <para style="q">
    <verse number="3" style="v" />Aha' wilik taqe i qib'iram i qeht'al,</para>
  <para style="q">re' taqe i qamaam qati't xik'utjanik cho qeh.</para>
  <para style="q">
    <verse number="4" style="v" />Eh ma' naa ta qakeb'aam chikiwach i qak'uun qixq'uun</para>
  <para style="q">chikiwach taqe tinamit naa kiwihiik koq'uun.</para>
  <para style="q">Naa la' qaq'orom rib'iral keh i ruloq'il i rajaawiik,</para>
  <para style="q">i ma' ilooj taj i rub'an QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh xuq'or reh i Jacob chib'ih i naa rub'anam.</para>
  <para style="q">Eh xuyeew keh i k'uhb'aal i quch aj Israel.</para>
  <para style="q">Eh xuq'or cho keh i qamaam qati't</para>
  <para style="q">chi naa kik'uhtaam reh i kiih kimaam.</para>
  <para style="q">
    <verse number="6" style="v" />Reh chi naa kinab'eem taqe i naa kiwihiik koq'uun,</para>
  <para style="q">je' wo' taqe i kak'uun kixq'uun konaa raasjiik.</para>
  <para style="q">Eh re' keh naa wo' chik kik'utjaam reh i kak'uun kixq'uun.</para>
  <para style="q">
    <verse number="7" style="v" />Reh chi naakiye'em kik'ux ruuk' i Dios,</para>
  <para style="q">eh chi ma' naa ta rusahchiik pankik'ux taqe i rub'anam.</para>
  <para style="q">Eh chi naa kimolom i ruk'uhb'aal.</para>
  <para style="q">
    <verse number="8" style="v" />Reh chi ma' naa ta kikahniik</para>
  <para style="q">chi je' kikab' taqe i kimaam kati't,</para>
  <para style="q">ma' xinimanik taj, xa re' i xkaaj i keh xkian.</para>
  <para style="q">Eh ma' xkiyeew taj i kánima, ma' xkian taj i korik chuwach i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' taqe i rutinamiit i Efraín, re' i kiyejaam naq kiib' ruuk' kiflecha reh q'aq'inik,</para>
  <para style="q">xkimol chi elik noq xponik i ruq'ijil i q'aq'inik.</para>
  <para style="q">
    <verse number="10" style="v" />Ma' xkian taj i kiq'orom cho ree Dios.</para>
  <para style="q">Eh ni xata xkaaj kik'amam naah i ruk'uhb'aal.</para>
  <para style="q">
    <verse number="11" style="v" />Re' keh sahchik pankik'ux i rotob'il i Dios,</para>
  <para style="q">je' wo' taqe i ma' ilooj taj rub'anam cho chikiwach.</para>
  <para style="q">
    <verse number="12" style="v" />Re' QaJaaw Dios ma' k'isiin taj i ma' ilooj taj xub'an chaloq kuuk'</para>
  <para style="q">i qamaam qati't paruyuq'ul i Zoán wilik ar Egipto.</para>
  <para style="q">
    <verse number="13" style="v" />Xuch'aq panyejaal i palaw,</para>
  <para style="q">eh k'ul xumol riib' i ha' pantaq kicheel, panchiqiij rik'saj taqe aj Israel ar</para>
  <para style="q">
    <verse number="14" style="v" />Pan q'iij ruuk' rumuuj suutz' xub'esaj taqe chaloq.</para>
  <para style="q">Eh chaq'ab' ruuk' i rusaqumaal i q'aaq' xub'esaj taqe chaloq.</para>
  <para style="q">
    <verse number="15" style="v" />Eh chupaam i ye'aab' chiq yuuq' xuch'aq i saq rehp ab'aj, xelik chaloq i ha',</para>
  <para style="q">eh chi kunchelaal xkian kihaa' chi korik.</para>
  <para style="q">
    <verse number="16" style="v" />Re' QaJaaw Dios ma' k'isa ha' i xresaj chaloq pansaq rep ab'aj,</para>
  <para style="q">xa je' chik nimlaj raasb'al ha'.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Xa re' la' re' keh xama' xkikanaa' ta wo' rub'aan</para>
  <para style="q">i mahk chuwach i Dios wilik cho pan taxaaj.</para>
  <para style="q">Eh xkiq'etwachej chupaam i ye'aab' chiq yuuq'.</para>
  <para style="q">
    <verse number="18" style="v" />Xkaaj naq kipajam i QaJaaw Dios ar,</para>
  <para style="q">xkipahqaaj kiwa' reh, je' rukab' inkaaj i keh.</para>
  <para style="q">
    <verse number="19" style="v" />Ma' holohik ta xiq'orik chi riij i Dios je' wili xkiq'or:</para>
  <para style="q">¿Mi nee ruyeew qawa' re' Dios ayu' chupaam i ye'aab' chiq yuuq'?</para>
  <para style="q">
    <verse number="20" style="v" />Korik noq re' Dios xuch'aq i saq rehp ab'aj,</para>
  <para style="q">eh ar xelik chaloq i ha',</para>
  <para style="q">xa je' chik nim ha', xib'oq taqe ak'al ruum.</para>
  <para style="q">Xa re' la' ¿mi nee ta wo' ruyeew qakaxlanwi'k</para>
  <para style="q">qatiib' i hoj, hoj rutinamiit? inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Eh noq xrib'iraj i Dios, chi je' re' xkiq'or,</para>
  <para style="q">xa je' chik q'aaq' noq xqop i rujosq'iil chikinaah i aj Israel</para>
  <para style="q">re' taqe i rak'uun rixq'uun i Jacob.</para>
  <para style="q">
    <verse number="22" style="v" />Ruum re' keh ma' xkiyeew ta kik'ux ruuk' i Dios.</para>
  <para style="q">Eh ma' xkinimaj taj chi re' reh xko'linik cho keh.</para>
  <para style="q">
    <verse number="23" style="v" />Ma' re' ta nkiwii' chi je' re' xkian re' Dios</para>
  <para style="q">xutaq'aaj chaloq taqe suutz' xuteh chee chii' i taxaaj.</para>
  <para style="q">
    <verse number="24" style="v" />Yohb'aal wach i maná xujalk'iij cho chikinaah i rutinamiit,</para>
  <para style="q">pan taxaaj xchalik i xkik'ux.</para>
  <para style="q">
    <verse number="25" style="v" />Re' taqe i tinamit re' re', looq' laj kaxlanwi'k i xkik'ux korehtaal xinujik chi korik.</para>
  <para style="q">Re' Dios xtaaq'anik cho reh.</para>
  <para style="q">
    <verse number="26" style="v" />Re' Dios i xutaq'aaj chee teew pareelb'aal q'iij,</para>
  <para style="q">je' wo' pansak'aaj ree rookb'aal i q'iij reh chi xhupinik chinaah i wach ak'al.</para>
  <para style="q">
    <verse number="27" style="v" />Ruuk' i re' ma' k'isa chikop re' ruuk' i kirupinik xuqasaj cho chikinaah i rutinamiit.</para>
  <para style="q">Xa je' chik kik'ihaal saniib' chi chii' i palaw.</para>
  <para style="q">
    <verse number="28" style="v" />Eh ma' najt ta ruuk' i kiye'aab' xponik ruqasaj i ma' k'isa chikop re' re'.</para>
  <para style="q">Ar chi junsuut taqe i ki-itz'ihy naah paat.</para>
  <para style="q">
    <verse number="29" style="v" />Eh xkik'ux korehtaal xinujik chi korik.</para>
  <para style="q">Re' Dios xuyeew cho keh aha' wilik i xkaaj i keh.</para>
  <para style="q">
    <verse number="30" style="v" />Eh ni xata chi je' re' xik'ik i kinuhmiik,</para>
  <para style="q">xakok'ahchi' wo' naq keeb' chi wi'k,</para>
  <para style="q">
    <verse number="31" style="v" />noq xuyeew chaloq i rujosq'iil i Dios chikinaah,</para>
  <para style="q">xukansaj taqe i winaq q'e' kow kiib'.</para>
  <para style="q">Eh xukansaj wo' taqe i winaq nimaq wach kina'ojb'al chi kixilak i aj Israel.</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Eh noq xkilow taqe re', xama' xkikanaa' ta wo' mahk,</para>
  <para style="q">xama' xkiyeew ta wo' rajaawriik i ma' ilooj taj xub'an i Dios.</para>
  <para style="q">
    <verse number="33" style="v" />Ruum aj re', re' Dios wilik i xresaj kik'achariik chi jumehq'iil.</para>
  <para style="q">Eh k'ih laj haab' xrik'saj taqe chi ti' k'axik panye'aab' chiq yuuq'.</para>
  <para style="q">
    <verse number="34" style="v" />Eh noq re' Dios wilik i rukansaj, kora'j inkisik' re' reh,</para>
  <para style="q">ma' kihi'lik ta chik chupahqaljiik kuyb'al kimahk.</para>
  <para style="q">
    <verse number="35" style="v" />Kora'j ink'ulik cho pankik'ux re' i Dios wilik cho pan taxaaj,</para>
  <para style="q">chi re' reh inko'linik keh, eh ineesanik keh panti' k'axik.</para>
  <para style="q">
    <verse number="36" style="v" />Xa re' la' chik imb'anik keh ruuk' i kichii',</para>
  <para style="q">ruuk' i kaaq' inkichuk i q'orik ree Dios.</para>
  <para style="q">
    <verse number="37" style="v" />Re' keh xama' korik ta wo' wach i kánima chuwach i Dios.</para>
  <para style="q">Eh ni xata xkian i kiq'orom cho reh chi naa kianam.</para>
  <para style="q">
    <verse number="38" style="v" />Xa re' la' xuketelaaj wo' naq kiwach,</para>
  <para style="q">i rukuy wo' naq i kimahk,</para>
  <para style="q">ma' noq ta xusach kiwach.</para>
  <para style="q">K'ihpech xukanaa' chi je' re', ma' noq ta xresaj cho wach i rujosq'iil.</para>
  <para style="q">
    <verse number="39" style="v" />Eh xk'ulik paruk'ux chi xa tiwik wo' taqe.</para>
  <para style="q">Eh chi xa je' kikab' i teew xa ik'ik i rub'an ma' insutinik ta chik chaloq.</para>
  <para style="q">
    <verse number="40" style="v" />Ar chupaam i ye'aab' chiq yuuq', xata wo' jarpech xkiq'etwachej kiib' chuwach i Dios.</para>
  <para style="q">Eh xkiyeew ruti'kiil ruk'ux.</para>
  <para style="q">
    <verse number="41" style="v" />Xa re' la' re' taqe i aj Israel re' re',</para>
  <para style="q">k'ih pech xkipaj i ki Dios wilik ruSantohiil eh xkitz'iraa' wach.</para>
  <para style="q">
    <verse number="42" style="v" />Ma' xk'ulik ta pankik'ux chi pan jinaj cho q'iij ruuk' i</para>
  <para style="q">rajaawriik i xiko'ljik cho pan kiq'ab' taqe i aj ixowaal.</para>
  <para style="q">
    <verse number="43" style="v" />Re' noq xub'an i Dios taqe i ma' ilooj taj, taqe i sahchb'al k'uxliis,</para>
  <para style="q">ar chupaam i ye'aab' i Zoán, wilik ar Egipto.</para>
  <para style="q">
    <verse number="44" style="v" />Re' noq xusutej taqe chi kik' i rooq ha' ar Egipto,</para>
  <para style="q">eh ma' xub'an ta chik chi x-uuk'jik.</para>
  <para style="q">
    <verse number="45" style="v" />Xutaq'aaj cho chikinaah i ma' k'isa utz', ma' k'isa tuhtz'<note caller="+" style="f"><char style="fr" closed="false">78.45 </char><char style="ft" closed="false">Tuhtz' pan kiq'oral i aj chi'chooh re' Rooch.</char></note></para>
  <para style="q">k'uxarik chu'nchel i chib'ih keh, eh xsacharik wach.</para>
  <para style="q">
    <verse number="46" style="v" />Xuyeew chaloq i nimaq chili'l sachb'al i</para>
  <para style="q">wach i kitik re' i kikamaneem wach.</para>
  <para style="q">
    <verse number="47" style="v" />Eh re' taqe i ki higo, i wach i ki-uuva xusach cho wach ruuk' saqb'och,</para>
  <para style="q">ruuk' jot'ik laj chaaj.</para>
  <para style="q">
    <verse number="48" style="v" />Xikimik taqe i kiwakax taqe i kitentzuun ruum i saqb'och,</para>
  <para style="q">ruum i ruch'aab' kahoq.</para>
  <para style="q">
    <verse number="49" style="v" />Re' Dios yohb'aal wach noq xqop rujosq'iil.</para>
  <para style="q">Eh xrik'saj rujosq'iil chikinaah xutib'isaj kik'ux.</para>
  <para style="q">Xutaq'aaj taqe chaloq i ruánjel reh i rub'anariik keh i ti' k'axik.</para>
  <para style="q">
    <verse number="50" style="v" />Re' Dios ma' xta chik xq'ilojik wii' i rujosq'iil.</para>
  <para style="q">Ma' xuketelaaj ta chik kiwach,</para>
  <para style="q">xuq'asaj taqe pankimik.</para>
  <para style="q">
    <verse number="51" style="v" />Xukansaj chu'nchel i peet kak'uun i aj Egipto</para>
  <para style="q">xusach wach i peet wach i kitik kimolom chupaam taqe i ruye'aab' i Cam rub'ihnaal.</para>
  <para style="q">
    <verse number="52" style="v" />Eh xresaj cho ar taqe i rutinamiit,</para>
  <para style="q">je' kib'ehtesjik cho tentzun xub'an,</para>
  <para style="q">noq xrik'saj taqe cho chupaam i ye'aab' chiq yuuq'.</para>
  <para style="q">
    <verse number="53" style="v" />Eh xucha'jeej taqe chi korik wach b'eeh, reh chi ma' xiyo'jik taj.</para>
  <para style="q">Eh re' taqe i aj ixowaal xtahqinik cho keh xutz'ap kinaah chupaam i kaq palaw.</para>
  <para style="q">
    <verse number="54" style="v" />Xuk'am taqe chaloq i rutinamiit chupaam i santo laj ye'aab'.</para>
  <para style="q">Re' i ye'aab' xuko'leej riij ruuk' i rajaawriik.</para>
  <para style="q">
    <verse number="55" style="v" />Eh xukaaj taqe reje ar i ma' re' ta taqe aj nimaneel,</para>
  <para style="q">keh chik taqe i quch aj Israel xuch'aq i ye'aab' re' re'.</para>
  <para style="q">Reh chi, chi kich'uhqaal xi patinik ar.</para>
  <para style="b" />
  <para style="q">
    <verse number="56" style="v" />Xa re' la' re' keh xkipaj, xkiq'etwachej wo' chik i Dios wilik cho pan taxaaj.</para>
  <para style="q">Eh xama' xkian ta wo' hoq i ruq'or i ruk'uhb'aal.</para>
  <para style="q">
    <verse number="57" style="v" />Eh xkian wo' chik keh je' rukab' i xkian</para>
  <para style="q">i peet kituut kajaaw xkiq'eb' chi riij kik'ux i Dios.</para>
  <para style="q">Ma' korik ta wach kik'ux, xkijal kib'eeh, je' rukab' i flecha ma' korik ta inkutwik.</para>
  <para style="q">
    <verse number="58" style="v" />Ma' k'isiin ta xkiyeew rujosq'iil i Dios</para>
  <para style="q">noq xkiyejaa' kiartaal loq'oomb'al reh i tiyoox.</para>
  <para style="q">Eh ruuk' i re' xkiyoj ruk'ux.</para>
  <para style="q">
    <verse number="59" style="v" />Re' i Dios xchalik rujosq'iil.</para>
  <para style="q">Ruum i re' xuq'eb' taqe chi riij ruk'ux chi jumpech i quch aj Israel.</para>
  <para style="q">
    <verse number="60" style="v" />Xuq'eb' wo' chi riij ruk'ux i rupaat wilik ar Silo,</para>
  <para style="q">re' naq inlooq'jik wii' kuum taqe tinamit.</para>
  <para style="q">
    <verse number="61" style="v" />Xuyeew wo' q'ab' i Dios keh i aj ixowaal chi xq'ucharik keh i</para>
  <para style="q">quch aj Israel i loq'laj kaxa rehtalil i rajaawriik i ruloq'il i Dios.</para>
  <para style="q">
    <verse number="62" style="v" />Eh ruum i rujosq'iil xuq'asaj i rutinamiit pan kiq'ab' i aj ixowaal,</para>
  <para style="q">reh chi xikanteesjik ruuk' q'aslaj ch'ihch'.</para>
  <para style="q">
    <verse number="63" style="v" />Re' taqe i k'ijolaq xkuxik kikimiik panq'aq'inik.</para>
  <para style="q">Eh re' taqe q'ahxoq ma' xta chik ninq'iij xkian reh i kaxáro.</para>
  <para style="q">
    <verse number="64" style="v" />Eh re' taqe i k'amal b'eeh aj tiij xi kanteesjik ruuk' q'aslaj ch'ihch'.</para>
  <para style="q">Eh ma' xuyeew ta chik riib' chi xi ooq'jik kuum i kehk'een.</para>
  <para style="q">
    <verse number="65" style="v" />Eh re' i QaJaaw Dios xuko'leej wo' chik i rutinamiit,</para>
  <para style="q">je' naa kore' xrik'raaj riib' paruwiriik.</para>
  <para style="q">Je' rukab' noq i rik'raaj riib' i winaq uk'inik vino i rub'an.</para>
  <para style="q">
    <verse number="66" style="v" />Re' Dios xub'an keh nixowanik kiwach i rutinamiit, xukaaj taqe reje,</para>
  <para style="q">eh xuk'uhtaaj kik'ixb'ilaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="67" style="v" />Eh xuq'eb' chi riij ruk'ux i rak'uun rixq'uun i José,</para>
  <para style="q">ma' re' ta wo' hoq i tinamit Efraín xusik' wach.</para>
  <para style="q">
    <verse number="68" style="v" />Re' la' tinamit Judá xusik' wach,</para>
  <para style="q">re' wilik wii' i yuuq' Sión re' i q'e' ruk'ax.</para>
  <para style="q">
    <verse number="69" style="v" />Ar xuyejaa' i ruloq'laj paat kopan ak'al xresaj</para>
  <para style="q">johtoq najt najt naah q'e' holohik rub'aan,</para>
  <para style="q">ma' xta naa rub'aniik reh chi jumpech.</para>
  <para style="q">
    <verse number="70" style="v" />Eh xusik' wach i rumoso David,</para>
  <para style="q">re' i cha'jen naq tentzun.</para>
  <para style="q">
    <verse number="71" style="v" />Xresaj chi kicha'jaljiik i juntzuhb' chi tentzun,</para>
  <para style="q">reh chi naa rucha'jaljiik i rutinamiit.</para>
  <para style="q">Re' chik i reh xk'amwik kib'eeh i tinamit Israel.</para>
  <para style="q">
    <verse number="72" style="v" />Je' re' noq re' i David xcha'jinik reh i rutinamiit i Dios.</para>
  <para style="q">Eh xuk'am kib'eeh panotob'il, ruuk' rukorkiil wach ruk'ux.</para>
  <chapter number="79" style="c" />
  <para style="s">Re' ruti'kiil k'uxliis chi riij i rusahchiik wach i Jerusaleem</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, re' taqe ma' kinimanik taa weh xkichop naah aaye'aab'.</para>
  <para style="q">Xkich'uwa'reej paam aSantolaj paat.</para>
  <para style="q">Eh xkisach wach i tinamit Jerusaleem.</para>
  <para style="q">
    <verse number="2" style="v" />Eh re' i kiti'jolal taqe awaj kamanoom, taqe i santo laj awaj nimaneel,</para>
  <para style="q">xkiyeew chi rutiib' k'uch, chi rutiib' taqe josq'laj chikop.</para>
  <para style="q">
    <verse number="3" style="v" />Re' kikik'eel xa je' chik inchihkik ha' kuum chupaam chu'nchel i tinamit Jerusaleem,</para>
  <para style="q">eh ma' awach ta nmuuq'anik keh.</para>
  <para style="q">
    <verse number="4" style="v" />Ruum i re' q'e' hoj kib'ajb'al,</para>
  <para style="q">eh hoj kise'lb'aal taqe tinamit wilkeeb' chi junsuut i qatinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios ¿Xti kojaruuj i nik'ik aajosq'iil?</para>
  <para style="q">¿Mi xa eliik naa ruqopiik chaajosq'iil chi qanaah je' rukab' noq inqop i q'aaq'?</para>
  <para style="q">
    <verse number="6" style="v" />Chawik'saj la' aajosq'iil chikinaah i tinamit ma' kinimanik taa weh.</para>
  <para style="q">Je' wo' chikinaah taqe i aj taaq'oom ma' nkian ta kitiij chawach.</para>
  <para style="q">
    <verse number="7" style="v" />Ruum re' keh xkisach wach i Jacob.</para>
  <para style="q">Eh xkisach wo' wach i rutinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Chakuy, maa qohayeew chutojariik riij i kiyiib' wach</para>
  <para style="q">na'ojb'al kianam chaloq i qamaam qati't.</para>
  <para style="q">Chaketelaaj la' qawach chi jumehq'iil.</para>
  <para style="q">Ruum re' hoj ma' nqakuy ta chik i ti' k'axik wilkooj wii'.</para>
  <para style="q">
    <verse number="9" style="v" />QaJaaw aj ko'len qeh, qoh atoob'eej,</para>
  <para style="q">qoh awesaj chupaam i ti' k'axik,</para>
  <para style="q">cha kuy qamahk</para>
  <para style="q">reh chi neenqayeew i ruloq'il aab'ihnaal.</para>
  <para style="q">
    <verse number="10" style="v" />Reh chi ma' nee ta nkiq'or chi je' wili i ma' kinimanik taa weh:</para>
  <para style="q">¿Aha' wilik i ki Dios inkiq'or? ma' inko'q ta taqe.</para>
  <para style="q">Inqaaj la' qilom chi neenaq'aj wach keh i kikanteesjiik taqe awaj kamanoom xkian.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Chab'iraj i koq'iim i prexo wilkeeb' ruum i ti' k'axik.</para>
  <para style="q">Eh chako'leej taqe ruuk' awajaawriik taqe k'ahchi' ruq'orariik chi naa kikanteesjiik.</para>
  <para style="q">
    <verse number="12" style="v" />QaJaaw Dios, chayeew cho jilow wuquub'-oq pech keh i tinamit wilkeeb' chi qaka'jaah</para>
  <para style="q">ab'ajariik xkian, ma' nkiyeew ta k'isinoq aloq'il.</para>
  <para style="q">
    <verse number="13" style="v" />Eh re' hoj aatinamiit</para>
  <para style="q">i je' hoj aatentzuun noq wilkooj,</para>
  <para style="q">naaqat'iosem chi juneliik awotob'il,</para>
  <para style="q">eh naaqatz'uyem awach, chiqiih chi qamaam.</para>
  <chapter number="80" style="c" />
  <para style="s">Re' rupahqaljiik ree Dios chi kisutinoq wo' chik chaloq i aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, hat aj cha'jen qeh i hoj, hoj aj Israel,</para>
  <para style="q">je' incha'jaljik tentzun i na a'n i riih rumaam i José.</para>
  <para style="q">Eh ar wilkaat chi kixilak i k'achaach wilik kixiik',</para>
  <para style="q">cha k'uhtaaj i rusaqumaal aaloq'il</para>
  <para style="q">
    <verse number="2" style="v" />Je' wo' hoq junch'uq chi tinamit Efraín,</para>
  <para style="q">i tinamit Benjamín, i tinamit Manasés,</para>
  <para style="q">chawilow, chako'leej taqe ruuk' awajaawriik.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />QaJaaw Dios, qoh atoob'eej reh chi nee wo' chik</para>
  <para style="q">qohkahnik chi je' rukab' i pampeet.</para>
  <para style="q">Suq tii qilariik cha a'n, eh qoh ako'leej.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />QaJaaw Dios, nim awajaawriik,</para>
  <para style="q">¿xti kojaruuj i rumay aajosq'iil chi qanaah?</para>
  <para style="q">¿Mi xti ma' naa chik ab'iram re' i qatiij i hoj, hoj aatinamiit?</para>
  <para style="q">
    <verse number="5" style="v" />Xa re' chikoq'ik inqawab'eej ruum i ruti'kiil qak'ux i nayeew,</para>
  <para style="q">eh re' qahaa' re' suq suq laj oq'ik inqa'an.</para>
  <para style="q">
    <verse number="6" style="v" />Eh xoj akanaa' chi hoj kib'ajb'al i tinamit</para>
  <para style="q">wilkeeb' chi qaka'jaah. Eh xa hoj kikaqse'lb'aal</para>
  <para style="q">taqe i ki-ixowanik qawach.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />QaDios, nim awajaawriik, qoh atoob'eej, reh chi nee wo'</para>
  <para style="q">chik qohkahnik chi je' rukab' i pampeet.</para>
  <para style="q">Suq tii qilariik cha a'n, eh nee qoh ako'leej.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' hat je' nehtesjik cho uuva xa a'n chaloq aatinamiit Egipto.</para>
  <para style="q">Eh aha' xawesaj taqe reje i tokoom tinamit</para>
  <para style="q">re' chik i keh xatik taqe ar.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hat xames wach i ye'aab' re' re' chi kekeh,</para>
  <para style="q">eh yohb'aal wach noq xi k'ihaaxb'ik.</para>
  <para style="q">Xa je' chik rukab' noq i ruk'am raa' i uuva.</para>
  <para style="q">
    <verse number="10" style="v" />Eh noq xi k'ihaaxb'ik xa je' chik rukab' i rub'an i uuva,</para>
  <para style="q">rutz'ap naah taqe i ch'ahn i rumuuj.</para>
  <para style="q">Eh re' taqe q'ab' i rutz'ap naah taqe i nimaq chee'.</para>
  <para style="q">
    <verse number="11" style="v" />Eh re' taqe q'ab' xik'ihik reje,</para>
  <para style="q">je' naa xi ponik chinaah i palaw,</para>
  <para style="q">re' rutoxl je' naa xponik ko chi chii' i nim ha' Éufrates.</para>
  <para style="q">
    <verse number="12" style="v" />¿Chib'ih reet noq xa a'n reh aatinamiit</para>
  <para style="q">je' rukab' i ruk'ul i uuva noq inehteesjik i koraal chi riij,</para>
  <para style="q">eh inik'ik sik'aroq i wach kuum taqe i aj b'eeh?</para>
  <para style="q">
    <verse number="13" style="v" />Re' i ki-ixowanik wach aatinamiit je' kikab' i k'ichi'ahq,</para>
  <para style="q">je' kikab' i josq'laj chikop re' taqe re' insachwik kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Hat Dios nim awajaawriik, qoh atoob'eej cho</para>
  <para style="q">pan taxaaj ruuk' i chib'ih i k'ahchi' qak'ulum,</para>
  <para style="q">i hoj, i je' hoj uuva noq wilkooj.</para>
  <para style="q">
    <verse number="15" style="v" />Re' hoj je' naa qohtikarik uuva</para>
  <para style="q">xooj a a'n je' naa xak'isaj johtoq i rutoxl.</para>
  <para style="q">
    <verse number="16" style="v" />Re' hat, chasach kiwach ruuk'</para>
  <para style="q">awajaawriik i kich'uqwik reh,</para>
  <para style="q">i kik'atwik reh i je' taqe uuva re' re'.</para>
  <para style="q">
    <verse number="17" style="v" />Xa re' la' chatoob'eej i winaq asik'im cho wach,</para>
  <para style="q">re' i naa ruko'liniik qeh chi juneliik.</para>
  <para style="q">
    <verse number="18" style="v" />Chi je' re' ma' nee ta chik inqakanaa' qiib' chawiij,</para>
  <para style="q">chayeew qak'achariik,</para>
  <para style="q">xa re' chik i hat nee tiqaq'o'reej pan qatiij.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />QaJaaw Dios nim awajaawriik,</para>
  <para style="q">qoh akanaa' wo' chik chi je' rukab' i pampeet.</para>
  <para style="q">Suq tii qilariik cha a'n, eh nee qoh ako'leej.</para>
  <chapter number="81" style="c" />
  <para style="s">Re' rotob'il i Dios, eh re' i kiyiib' wach na'ojb'al i aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Chatz'uyej taq wach i Dios, ruuk' rusuqkiil k'uxliis, re' ye'el rukowiil qak'ux.</para>
  <para style="q">Chak'er taq aachii' chulooq'jiik i ruDios chee Jacob.</para>
  <para style="q">
    <verse number="2" style="v" />Chatz'uyej taq wach ruuk' setesaq q'ooj re' ruuk' i kitzalajinik,</para>
  <para style="q">ruuk' arpa, ruuk' taqe i k'ahaam wach q'ooj.</para>
  <para style="q">
    <verse number="3" style="v" />Chaxulej taq aatuun noq rub'anam i ak' poh,</para>
  <para style="q">je' wo' na'chub'an k'ul saqum i poh,</para>
  <para style="q">ruum re' re' jinaj i runimaal ninq'iij chi qeh i hoj.</para>
  <para style="q">
    <verse number="4" style="v" />Ruum re' re' i k'uhb'aal xuyeew i Dios reh i Jacob,</para>
  <para style="q">eh xuyeew wo' keh i quch aj Israel.</para>
  <para style="q">
    <verse number="5" style="v" />Re' wo' k'uhb'aal re' re' xq'orarik reh i José noq</para>
  <para style="q">ruuk' i runimaal i rajaawriik i Dios xi ehteesjik cho ar Egipto.</para>
  <para style="q">
    <verse number="6" style="v" />Eh xb'iraj jinaj i q'orik ma' jank'al ta nb'iraj, je' wili xuq'or:</para>
  <para style="q">yu'naak xwisaj chik i ahl laj ihq taq cha naah,</para>
  <para style="q">xat nuhi'lisaj taq chik ruuk' i kowlaj kamanik.</para>
  <para style="q">
    <verse number="7" style="v" />Eh noq ti' taq wilkaat xapahqaaj taq i atoob'jiik, eh xatnuko'leej wo' taq.</para>
  <para style="q">Kore' i rub'an cho wii' i kahoq xat b'iraj taq chaloq.</para>
  <para style="q">Eh xatnupaj taq i wilik wii' i ha' Meriba.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Chab'iraj taq i aq'ilariik naa nub'anam i hat taq nutinamiit Israel.</para>
  <para style="q">Atoob' wii' xinanimaj taq.</para>
  <para style="q">
    <verse number="9" style="v" />Ma' naa ta taq ruwihiik atiyoox,</para>
  <para style="q">eh ni xata naa taq aloq'em i ki dios i tokoom tinamit.</para>
  <para style="q">
    <verse number="10" style="v" />Ruum xa re' wo' hin taq aaWaJaaw aaDios</para>
  <para style="q">xineesanik taq cha weh Egipto.</para>
  <para style="q">Eh cha pahqaaj taq chib'ih taq inawaaj re' hin naa nuye'em taq aweh.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Xa re' la' re' nutinamiit Israel xama' xinkinimaj ta wo' hoq.</para>
  <para style="q">Eh xama' xkaaj ta wo' nuwach,</para>
  <para style="q">
    <verse number="12" style="v" />ruum i re' xnuyeew q'ab' chi xkian i xkaaj i keh.</para>
  <para style="q">Eh xi k'acharik nik' wach i xponik chikiwach i keh.</para>
  <para style="q">
    <verse number="13" style="v" />Wi ta xkib'iraj i xnuq'or keh i nutinamiit Israel,</para>
  <para style="q">xkik'am ta naah i nuk'uhb'aal.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hin xa chi jumehq'iil naq xnub'an keh inixowanik kiwach.</para>
  <para style="q">Eh xnuyeew naq taqe panti' k'axik, inki Dios.</para>
  <para style="q">
    <verse number="15" style="v" />Re' taqe i ki-ixowanik wach i QaJaaw Dios naakiloch'om kiib' chuwach.</para>
  <para style="q">Eh junelik naakiye'ariik chutojariik i kimahk.</para>
  <para style="q">
    <verse number="16" style="v" />Eh re' QaJaaw Dios nee naq i ruk'uxlaaj taqe ruuk' i chihooj laj trigo,</para>
  <para style="q">eh ruuk' i riis kaab' i nelik cho panab'aj.</para>
  <chapter number="82" style="c" />
  <para style="s">Re' Dios xuq'il i q'atal q'orik</para>
  <para style="q">
    <verse number="1" style="v" />Re' Dios xuq'oreej taqe i Q'atal q'orik noq kimolom kiib',</para>
  <para style="q">xuq'at i q'orik chikinaah, je' wili xuq'or keh:</para>
  <para style="q">
    <verse number="2" style="v" />¿Ko jaruuj taq i namay i q'ataj q'orik ma' re' ta parub'ehel?</para>
  <para style="q">¿Mi ma' naa taq akanaam kitoob'jiik re' i yiib' wach kina'ojb'al?</para>
  <para style="q">
    <verse number="3" style="v" />Chako'leej la' taq i ma' kow ta ruk'ux, i ma' xta rutuut rajaaw.</para>
  <para style="q">Eh parub'ehel taq chaq'at i q'orik chinaah i ti' ruk'ux, eh i ma' xta wilik reh.</para>
  <para style="q">
    <verse number="4" style="v" />Cha ko'leej taqe i ma' kow ta kik'ux,</para>
  <para style="q">je' wo' taqe i ma' xta wilik keh, pan kiq'ab' i yiib' wach kina'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' taq i hat ma' aweht'al ta taq,</para>
  <para style="q">ma' nareq ta taq chi riij, pam q'equm taq k'acharik i na a'n.</para>
  <para style="q">Xa kib'arb'otik chik i wilkeeb' wach ak'al taq awuum.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' hin, hat naq taq jilow dios noq xat xnukanaa'.</para>
  <para style="q">Eh hat naq taq manlik wak'uun noq nuq'or, i hin i Dios nim awajaawriik.</para>
  <para style="q">
    <verse number="7" style="v" />Eh naa taq akimiik je' rukab' noq inkimik xa awach.</para>
  <para style="q">Eh chi je' rukab' noq insacharik wach i q'atal q'orik xakow i rub'an riib', inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios, chaq'at i Q'orik chikinaah wilkeeb' wach ak'al,</para>
  <para style="q">ruum re' i hat i ehchan reh i chu'nchel i tinamit.</para>
  <chapter number="83" style="c" />
  <para style="s">Re' reey David xupahqaaj ree Dios chi chusach kiwach i aj ixowaal</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, maakanaa' chi je' re' i k'ahchi'kooj.</para>
  <para style="q">Maacanaa' chi ma' xtaj i naa a'nam.</para>
  <para style="q">
    <verse number="2" style="v" />Chawil taqe ma' nkaaj ta awach,</para>
  <para style="q">re' taqe i ma' kinimanik taa weh k'achi' keeb' chi tukinik wachiis.</para>
  <para style="q">
    <verse number="3" style="v" />Pan komonil xkiyejaa' wach i yiib' wach na'ojb'al, reh chi naa kia'nam reh aatinamiit.</para>
  <para style="q">Eh chi naa kia'nam reh taqe asik'im cho kiwach.</para>
  <para style="q">
    <verse number="4" style="v" />Inkaaj ruchaliik kisacham qawach pan qatinamiit,</para>
  <para style="q">reh chi ma' nee ta chik inq'orarik rib'iral i qatinamiit Israel.</para>
  <para style="q">
    <verse number="5" style="v" />Jinaj i xkiyejaa' wach chawiij i hat,</para>
  <para style="q">eh xkian jinaj wach kik'ux chi kunchelaal.</para>
  <para style="q">
    <verse number="6" style="v" />Kuuk' taqe i patim Edom, kuuk' i aj Ismael.</para>
  <para style="q">Eh kuuk' rak'uun rixq'uun i agar, kuuk' i aj Moab.</para>
  <para style="q">
    <verse number="7" style="v" />Eh kuuk' aj Gebal, kuuk' i aj Amón, kuuk' i aj Amalec,</para>
  <para style="q">kuuk' i aj filisteo, kuuk' aj Tiro.</para>
  <para style="q">
    <verse number="8" style="v" />Eh xkian wo' jinaj wach kik'ux kuuk' i aj Asiria.</para>
  <para style="q">Re' taqe re' xti q'e' taqe kow chi kixilak i rak'uun rixq'uun i Lot.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Chasach kiwach taqe re', je' rukab' i xa a'n keh i aj Madián, i</para>
  <para style="q">aj Sísara, aj i Jabín, re' i wilik wii' i nim ha' Cisón.</para>
  <para style="q">
    <verse number="10" style="v" />Xasach cho kiwach chupaam i ye'aab' Endor.</para>
  <para style="q">Ar xiq'ahik, chi ruraxiil ak'al.</para>
  <para style="q">
    <verse number="11" style="v" />Chasach kiwach i nimaq kiwach, je' rukab' i xa a'n keh i Oreb, i Zeeb.</para>
  <para style="q">Cha a'n kuuk' i k'amal kib'eeh, je' rukab' noq xasach wach i Zeba, i Zalmuna.</para>
  <para style="q">
    <verse number="12" style="v" />Re' hat xasach kiwach ruum je' wili xkiq'or:</para>
  <para style="q">Naa qehchaam i rutinamiit i Dios, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />WaJaaw nuDios, chasach kiwach,</para>
  <para style="q">xa je'-oq kik'amarik reje chiqiij laj xaq chee' ruum i kowlaj teew cha a'n keh.</para>
  <para style="q">
    <verse number="14" style="v" />Je' rukab' noq kichaajrik ruum q'aaq' i rax chee'.</para>
  <para style="q">Eh je' rukab' noq ink'ahtik ruum q'aaq' i kok' ch'ahn.</para>
  <para style="q">
    <verse number="15" style="v" />Chayeew i k'axik chikinaah ruuk' awajaawriik.</para>
  <para style="q">Eh chayohb'isaj taqe ruuk' aajosq'iil.</para>
  <para style="q">
    <verse number="16" style="v" />QaJaaw Dios, chayeew q'ab' chi neenkik'uhtaaj kik'ixb'ilaal,</para>
  <para style="q">reh chi nee tikisik'.</para>
  <para style="q">
    <verse number="17" style="v" />Ma' ta naq nee kielik korik ruuk' inkikapaaj.</para>
  <para style="q">Reh chi neenkik'uhtaaj kik'ixb'ilaal, eh nee kikimiik.</para>
  <para style="q">
    <verse number="18" style="v" />Reh chi nee nkinab'eej</para>
  <para style="q">chi xa re' wo' hat i Dios, xa re' wo' hat i nim</para>
  <para style="q">awajaawriik chinaah chu'nchel i wach ak'al.</para>
  <chapter number="84" style="c" />
  <para style="s">Re' rotoowjiik wihik chupaam i rupaat i Dios</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, nim awajaawriik</para>
  <para style="q">xiik' naah holwochiil aapaat.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin xa nwotow chik</para>
  <para style="q">wihik chupaam i aapaat QaJaaw Dios.</para>
  <para style="q">Eh chu'nchel nuk'ux, chu'nchel i wánima inutz'uyej awach</para>
  <para style="q">ruum re' hat i k'achlik Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />QaJaaw Dios nim awajaawriik, hat nureey, hat nuDios.</para>
  <para style="q">Re' taqe kok' tz'unun,</para>
  <para style="q">taqe i kok' si'q'jil inki req</para>
  <para style="q">naa re' wo' kiye'aab' chuwach taqe aa artaal,</para>
  <para style="q">eh ar inkiyejaa' kisuuq' ye'aab' kok' kak'uun.</para>
  <para style="q">
    <verse number="4" style="v" />Je' re' noq q'e' atoob' keh i eliik wilkeeb'</para>
  <para style="q">chupaam aapaat, ruum ma' kihi'lik ta chalooq'jiik.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh atoob' keh i awuuk' i hat inkireq rukowiil kik'ux.</para>
  <para style="q">Eh ma' kikanaa' ta rub'aan inawaaj i hat.</para>
  <para style="q">
    <verse number="6" style="v" />Eh noq ki-ik'ik chi ti', noq ki oq'ik inasutej chi rusuqkiil k'uxliis,</para>
  <para style="q">i nayeew aawotob'il chikinaah je' rukab' noq</para>
  <para style="q">i nujik i ye'aab' ha' noq i rub'an chee jab'.</para>
  <para style="q">
    <verse number="7" style="v" />Eh reh reh kireqem kikowiil reh ojik chikiwach.</para>
  <para style="q">Eh ar Sión naakilom awach i hat qaDios.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios, nim awajaawriik,</para>
  <para style="q">ruDios chee i Jacob, xti chab'iraj tii cho weh i nutiij.</para>
  <para style="q">
    <verse number="9" style="v" />QaJaaw Dios aj ko'len qeh,</para>
  <para style="q">chayeew tii aawotob'il chinaah i reey asik'im cho wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Eh q'e' chihooj chi weh chi nee kinwihik jino'q q'iij chupaam aapaat</para>
  <para style="q">chuwach chi nee kinwihik jino'q miil Q'iij xa aha'.</para>
  <para style="q">Eh q'e' chihooj chi weh chi nee nucha'eej i ookb'al reh aapaat i hat nuDios</para>
  <para style="q">chuwach chi nee kinwihik aha' imb'aan wii' i mahk.</para>
  <para style="q">
    <verse number="11" style="v" />Ruum re' QaJaaw Dios</para>
  <para style="q">insihq'inik reh i qana'ojb'al.</para>
  <para style="q">Eh qoh ruko'leej, qohruk'ax i ruyeew kiloq'il i ma' xta kiq'ehb'iik wii'.</para>
  <para style="q">Eh i ruyeew keh i chihooj chi keh.</para>
  <para style="q">
    <verse number="12" style="v" />QaJaaw Dios, nim awajaawriik.</para>
  <para style="q">Q'e' atoob' keh taqe i awuuk' i hat inkiyeew i kik'ux.</para>
  <chapter number="85" style="c" />
  <para style="s">Re' reey David xupahqaaj chi naa wo' chik kiko'ljiik ruka'peech</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, re' hat q'e' hat atoob' quuk' i hoj, hoj aatinamiit,</para>
  <para style="q">ruum xoj asutej wo' chik chaloq i hoj, hoj riih rumaam i Jacob.</para>
  <para style="q">
    <verse number="2" style="v" />Eh xakuy chu'nchel i kimahk aatinamiit,</para>
  <para style="q">je' wo' taqe i yiib' wach na'ojb'al inki a'n</para>
  <para style="q">
    <verse number="3" style="v" />Eh ma' xta chik cho aajosq'iil chikinaah,</para>
  <para style="q">sahchik panak'ux chi jumpech i ransil aajosq'iil.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />QaDios i aj ko'len qeh, je' re' i na a'n.</para>
  <para style="q">Chakuy qoh ako'leej yu'naak, maayeew chik aajosq'iil chi qanaah.</para>
  <para style="q">
    <verse number="5" style="v" />¿Mi ma' naa chik amayam re' aajosq'iil chi qanaah chi jumpech?</para>
  <para style="q">¿Mi konaa wo' aye'em cho re' aajosq'iil chikinaah</para>
  <para style="q">taqe qak'uun qixq'uun naa kiwihiik koq'uun?</para>
  <para style="q">
    <verse number="6" style="v" />¿Mi ma' naa chik aye'em qeh re' i suq laj k'acharik</para>
  <para style="q">reh chi neensuuqb'ik qak'ux awuuk' i hoj, hoj aatinamiit?</para>
  <para style="q">
    <verse number="7" style="v" />QaJaaw Dios, chaketelaaj tii qawach,</para>
  <para style="q">eh qoh ako'leej.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' hin naab'iram i naa ruq'orom i QaJaaw Dios.</para>
  <para style="q">Ruum naa ruq'orom chi naa ruwihiik</para>
  <para style="q">rusuqkiil kik'ux i rusantolaj tinamiit.</para>
  <para style="q">Reh chi ma' nee ta chik imb'aan i tehwachiil.</para>
  <para style="q">
    <verse number="9" style="v" />Xti korik noq re' QaJaaw Dios ma' najt ta wilik</para>
  <para style="q">chi kiko'ljiik i kiye'wik runimaal wach,</para>
  <para style="q">reh chi neen wihik ruloq'il chupaam i qa ye'aab' wilkooj wii'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' ketelinik wachiis, re' korik naa ruwihiik kuuk' i tinamit.</para>
  <para style="q">Eh naa ruwihiik i suq kiil k'uxliis, i rukorkiil wach k'uxliis.</para>
  <para style="q">
    <verse number="11" style="v" />Re' korik chi kixilak i tinamit wach ak'al naa rutihk'iik.</para>
  <para style="q">Eh re' wihik parukorkiil pan taxaaj naa ruchaliik.</para>
  <para style="q">
    <verse number="12" style="v" />Re' QaJaaw Dios naa ruye'em i rotob'il chi qanaah, eh</para>
  <para style="q">naa ruwachiniik i qatik pan qa ye'aab'.</para>
  <para style="q">
    <verse number="13" style="v" />Re' korik naa ruk'uhtaam qeh i QaJaaw.</para>
  <para style="q">Eh naa ruk'uhtaam qeh i wihik parukorkiil.</para>
  <chapter number="86" style="c" />
  <para style="s">Re' reey David xupahqaaj reh i jinaj chi Dios chi naa rutoob'jiik</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios chab'iraj tii i nupahqaaj aweh,</para>
  <para style="q">kinatoob'eej, ruum re' hin q'e' ntz'irik nuwach, eh q'e' ti' nuk'ux.</para>
  <para style="q">
    <verse number="2" style="v" />Kinako'leej i hat nuDios, ruum korik wach nuk'ux awuuk'.</para>
  <para style="q">Kinako'leej hin, hin amoso,</para>
  <para style="q">awuuk' i hat nuye'em nuk'ux.</para>
  <para style="q">
    <verse number="3" style="v" />QaJaaw Dios chaketelaaj tii nuwach</para>
  <para style="q">ruum re' hin juneliik nupahqaaj aawotob'il.</para>
  <para style="q">
    <verse number="4" style="v" />Jaaw chasuuqb'isaj i wánima hin, hin amoso,</para>
  <para style="q">eh xa chawach hat i nub'an nutiij.</para>
  <para style="q">
    <verse number="5" style="v" />Re' hin Jaaw weht'al chi q'e' hat atoob'.</para>
  <para style="q">Eh hat kuyuul mahk, i naaketelaaj kiwach inki a'n kitiij chawach.</para>
  <para style="q">
    <verse number="6" style="v" />QaJaaw Dios, chab'iraj tii i nutiij,</para>
  <para style="q">chayeew weh i nupahqaaj aweh.</para>
  <para style="q">
    <verse number="7" style="v" />Nik' ti' nuk'ux re' hat tinuq'o'reej,</para>
  <para style="q">ruum weht'al chi nayeew weh inupahqaaj aweh.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios, ma' xta chik jino'q dios chi je' rukab' i hat.</para>
  <para style="q">Eh ma' awach ta neemb'anik reh taqe i na a'n i hat.</para>
  <para style="q">
    <verse number="9" style="v" />QaJaaw Dios, chu'nchel i</para>
  <para style="q">nimaq tinamit ayejaam, naa kichaliik chalooq'jiik.</para>
  <para style="q">Eh naakiye'em runimaal wach aab'ihnaal.</para>
  <para style="q">
    <verse number="10" style="v" />Ruum xa re' wo' hat i jinaj chi Dios, xiik' naah nimaal awach,</para>
  <para style="q">eh i na a'n taqe i ma' ilooj taj.</para>
  <para style="q">
    <verse number="11" style="v" />QaJaaw Dios, cha k'uhtaaj weh aab'eeh,</para>
  <para style="q">reh chi neenub'an i korik.</para>
  <para style="q">Eh chayeew rukowiil i wánima,</para>
  <para style="q">reh chi neenuyeew runimaal wach aab'ihnaal.</para>
  <para style="q">
    <verse number="12" style="v" />Hat waJaaw nuDios, naa kaat nuloq'em chu'nchel i wánima,</para>
  <para style="q">eh juneliik naa nuye'em ruloq'il ab'ihnaal.</para>
  <para style="q">
    <verse number="13" style="v" />Eh ma' k'isiin ta xaketelaaj nuwach.</para>
  <para style="q">Ruum xinako'leej chuwach i kimik.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />QaJaaw re' taqe i ki-ixowanik nuwach yohb'aal wach i kijosq'iil.</para>
  <para style="q">Re' taqe i ma' tikikapaaj taj inkaaj nukanteesjiik.</para>
  <para style="q">
    <verse number="15" style="v" />Eh re' hat Jaaw, hat Dios, q'e' hat kuyuul.</para>
  <para style="q">Ma' jumehq'iil ta inchalik aajosq'iil,</para>
  <para style="q">xiik' la' naah i ketelinik wachiis awuuk', eh re' hat i korik.</para>
  <para style="q">
    <verse number="16" style="v" />Kinawilow tii chaketelaaj nuwach.</para>
  <para style="q">Chayeew rukowiil nuk'ux</para>
  <para style="q">hin, hin amoso, hin rak'uun chaloq amoso re' i nutuut.</para>
  <para style="q">
    <verse number="17" style="v" />Chak'uhtaaj weh chi korik aawotob'il,</para>
  <para style="q">eh noq neenkilow i ki-ixowanik nuwach neenchalik kik'ixiik.</para>
  <para style="q">QaJaaw Dios, weht'al noq re' hat titoob'inik</para>
  <para style="q">ti ye'wik rusuqkiil nuk'ux.</para>
  <chapter number="87" style="c" />
  <para style="s">Re' ruye'ariik ruloq'il i tinamit Sión</para>
  <para style="q">
    <verse number="1" style="v" />Re' raa' ri'sil i rutinamiit i Dios ar wilik chinaah i rusantolaj yuuq'.</para>
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw Dios ma' k'isiin ta ruk'ax i ye'aab' Sión</para>
  <para style="q">chuwach i ye'aab' wilkeeb' wii' taqe i rak'uun rixq'uun i Jacob.</para>
  <para style="q">
    <verse number="3" style="v" />Hat rutinamiit i Dios,</para>
  <para style="q">yohb'aal wach holwochiil i ruq'or aweh i Dios chi je' wili:</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' taqe i tinamit kieht'alinik nuwach,</para>
  <para style="q">wilik i naa nuq'orom i kib'ihnaal:</para>
  <para style="q">Re' Egipto, Babilonia, Filistea, Tiro, Etiopía</para>
  <para style="q">re' taqe re' awuuk' i hat xitz'uhkrik, je' hat kituut, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh re' taqe re' je' wili i naa kiq'orom:</para>
  <para style="q">Re' hoj, ayu' Sión xoj tz'uhk'rik</para>
  <para style="q">eh re' wo' Dios nim rajaawriik xsik'wik cho qawach, inkoq taqe.</para>
  <para style="q">
    <verse number="6" style="v" />Eh re' QaJaaw Dios rutz'ihb'aam i kib'ihnaal i tinamit,</para>
  <para style="q">re' taqe i ar xitz'uhkrik Sión re' i je' kituut noq wilik.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' taqe aj tz'uuy, taqe i aj q'ooj, je' wili i naa kiq'orom:</para>
  <para style="q">Re' wili xti manlik qatinamiit ruum ayu' xoj tz'uhk'rik, inko'q taqe.</para>
  <chapter number="88" style="c" />
  <para style="s">Re' wili rutiij jinaj i winaq q'e' ti' ruk'ux</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, hat waj ko'loom,</para>
  <para style="q">re' hin chi q'iij chi aq'ab' nupahqaaj nutoob'jiik aweh.</para>
  <para style="q">
    <verse number="2" style="v" />Chab'iraj tii weh i nutiij.</para>
  <para style="q">Chayeew weh aha' wilik i nupahqaaj aweh.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Ruum re' hin yohb'aal wach i ti' k'axik xumol riib' chi nunaah,</para>
  <para style="q">xanaa chik nukimiik noq inwik'raaj.</para>
  <para style="q">
    <verse number="4" style="v" />Xa je' chik nukab' taqe i kamnaq noq inwik'raaj,</para>
  <para style="q">ruum xama' xta chik rukowiil i nuti'jolal.</para>
  <para style="q">
    <verse number="5" style="v" />Je' naa xinkahnik chi tuch'ulkiin chi kixilak taqe i kamnaq,</para>
  <para style="q">je' nukab' taqe i kikimik ruuk' q'aslaj ch'ihch'</para>
  <para style="q">xi muhqik chik.</para>
  <para style="q">Eh ma' xako'leej ta taqe i hat, xsahchik taqe panak'ux.</para>
  <para style="q">
    <verse number="6" style="v" />Je' naa pan jinaj ruchamiil jul xinayeew,</para>
  <para style="q">xiik' naah q'equmaal paam.</para>
  <para style="q">
    <verse number="7" style="v" />Eh yohb'aal wach aajosq'iil chi nunaah.</para>
  <para style="q">Eh nimaq taq rub'ohl ha' i k'ahchi' rumuq'aniik nunaah.</para>
  <para style="q">
    <verse number="8" style="v" />Xayeew q'ab' chi xinkiq'eb' chi riij kik'ux taqe wamigo.</para>
  <para style="q">Eh ma' suq ta chik wilariik inki a'n</para>
  <para style="q">ruum ma' xinatob'eej taj, xama' ha' ta chik kinelik.</para>
  <para style="q">
    <verse number="9" style="v" />Eh ruum i ma' k'isa oq'ik i nub'an,</para>
  <para style="q">k'ahchi' rupohyiik paam i naq'nuwach.</para>
  <para style="q">Jaaw ruum aj re' chu'nchel q'iij tinuq'o'reej, i nujosaj i nuq'ab' chawach.</para>
  <para style="q">
    <verse number="10" style="v" />¿Mi ko neena a'n cho re' i nimaq wach ma' ilooj taj kuuk' taqe i kamnaq?</para>
  <para style="q">Eh ¿Mi ko neetikiloq'ej re' taqe kamnaq?</para>
  <para style="q">
    <verse number="11" style="v" />¿Mi koneeruyeew riib' re' chi neen q'orarik aak'axb'al,</para>
  <para style="q">ruch'ihil i rukorkiil wach ak'ux chupaam i ye'aab' muqulkeeb' wii' kamnaq?</para>
  <para style="q">
    <verse number="12" style="v" />Eh re' taqe i kamnaq, ma' nee ta chik inkireq chi riij i korik.</para>
  <para style="q">Eh ma' awach ta chik neenilwik reh i ma' ilooj taj i na a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />QaJaaw Dios re' hin rajlaal pantaq wahq'eq</para>
  <para style="q">i nupahqaaj aweh panutiij chi naa kiin atoob'eem.</para>
  <para style="q">
    <verse number="14" style="v" />Jaaw ¿Chib'ih reet noq xinaq'eb' chi riij ak'ux?</para>
  <para style="q">¿Chib'ih reet noq ma' kinab'iraj taj?</para>
  <para style="q">
    <verse number="15" style="v" />Re' hin kopan nuk'ijolal rutik'aam chaloq i ruti'kiil nuk'ux,</para>
  <para style="q">eh xink'u'loq ayu' yu'naak chi xa je' pankimik wilkiin awuum.</para>
  <para style="q">
    <verse number="16" style="v" />Yohb'aal wach aajosq'iil xayeew chi nunaah,</para>
  <para style="q">ma' nukuy ta chik k'isinoq ransil.</para>
  <para style="q">
    <verse number="17" style="v" />Re' aajosq'iil eliik i nayeew chi nunaah,</para>
  <para style="q">je' naa sutimaj wiij chi chaam laj ha'.</para>
  <para style="q">
    <verse number="18" style="v" />Eh xayeew q'ab' chi xinkiq'eb' chi riij kik'ux taqe</para>
  <para style="q">i wamigo, taqe wuch'ihil,</para>
  <para style="q">taqe weht'al kiwach xa panq'equm chik wilkiin.</para>
  <chapter number="89" style="c" />
  <para style="s">Re' xuyejaa' wach i Dios chi naa rub'anam ruuk' i David</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, re' hin juneliik naa nuq'orom</para>
  <para style="q">panutz'uuy chi q'e' hat aj keteloom wachiis.</para>
  <para style="q">Eh eliik naa nuq'orom chi korik wach ak'ux.</para>
  <para style="q">
    <verse number="2" style="v" />Eh naa nuq'orom rib'iral chi re' ketelinik wachiis</para>
  <para style="q">i na a'n ma' jaruuj naa rik'iik wach,</para>
  <para style="q">je' wo' rukorkiil wach ak'ux.</para>
  <para style="q">Je' rukab' noq wilik i taxaaj paruye'aab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh je' wili aq'orom:</para>
  <para style="q">Re' hin wilik i xnuyejaa' wach ruuk' i David</para>
  <para style="q">i numoso nusik'im wach je' wili i xnuq'or reh:</para>
  <para style="q">
    <verse number="4" style="v" />Re' chik taqe aawiih aamaam naa nukojom</para>
  <para style="q">chi reyil chajilob'aal na' ti eloq i hat</para>
  <para style="q">re' keh naa kikahniik chi reey chi juneliik, tiki.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios, chu'nchel i k'achareel wilkeeb'</para>
  <para style="q">pan taxaaj tikiloq'ej ruum i wilik kisantohiil.</para>
  <para style="q">Eh ruum taqe i ma' ilooj taj i na a'n.</para>
  <para style="q">
    <verse number="6" style="v" />Ruum re' hat QaJaaw Dios xiik' naah nimaal awajaawriik,</para>
  <para style="q">ma' xta chik jino'q dios wilik pan taxaaj chi je' ta rukab' i hat.</para>
  <para style="q">
    <verse number="7" style="v" />Ruum xa re' wo' hat nim awajaawriik,</para>
  <para style="q">eh xiik' naah yohb'alil awach.</para>
  <para style="q">Sutimaj awiij kuum i k'achareel wilkeeb' pan taxaaj,</para>
  <para style="q">xa re' wo' hat nim awach chi kixilak i keh.</para>
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios nim awajaawriik, ma' awach ta chik</para>
  <para style="q">jino'q chi je' rukab' i hat. Q'e' nim awajaawriik,</para>
  <para style="q">xa re' korik wilik awuuk'.</para>
  <para style="q">
    <verse number="9" style="v" />Wilik awajaawriik chuq'ilariik i palaw noq yohb'aal wach i rujosq'iil.</para>
  <para style="q">Eh noq yohb'aal wach i wuktik i rub'an i rub'ohl inapab'aa' wo' hoq.</para>
  <para style="q">
    <verse number="10" style="v" />Re' hat xa a'n reh i josq'laj chikop Rahab<note caller="+" style="f"><char style="fr" closed="false">89.10 </char><char style="ft" closed="false">Re' b'ih Rahab jinaj Qamaan chikop tiyo'joq ruum, ikiq'or taqe aj Judio chi wilik pan palaw.</char></note> xa je' chik kamnaq xakanaa'.</para>
  <para style="q">Xatukej kiwach ruuk' awajaawriik taqe i ki-ixowanik awach.</para>
  <para style="q">
    <verse number="11" style="v" />Re' taxaaj, i wach ak'al re' hat ti ehchanik keh.</para>
  <para style="q">Ruum re' wo' hat xatyej-anik reh i wach ak'al,</para>
  <para style="q">je' wo' i wilkeeb' chupaam.</para>
  <para style="q">
    <verse number="12" style="v" />Re' hat xatyej-anik reh i wilkeeb' pantz'eet ree rookb'aal i q'iij,</para>
  <para style="q">pansak'aaj ree rookb'aal i q'iij.</para>
  <para style="q">Eh re' yuuq' Tabor, i yuuq' Hermón inkiyeew aloq'il.</para>
  <para style="q">
    <verse number="13" style="v" />Re' hat xiik' naah awajaawriik,</para>
  <para style="q">eh kow awiib' ruum aj re' ti elik korik ruuk' i taqe i na a'n.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hat parub'ehel ti q'atwik q'orik chupaam aa ye'aab',</para>
  <para style="q">eh ruuk' rukorkiil wach ak'ux.</para>
  <para style="q">Eh juneliik re' k'axooj, eh re' korik wilik awuuk' i hat QaJaaw.</para>
  <para style="q">
    <verse number="15" style="v" />QaJaaw Dios, atoob' keh i tinamit</para>
  <para style="q">tikiloq'ej ruuk' rusuqkiil k'uxliis.</para>
  <para style="q">Eh k'acharik inki a'n chupaam i rusaqumaal</para>
  <para style="q">i na'ojb'al i nayeew i hat.</para>
  <para style="q">
    <verse number="16" style="v" />Eh panab'ihnaal i hat neen wihik rusuqkiil kik'ux chi junelik.</para>
  <para style="q">Eh neen kichop kik'ux ruum i rukorkiil wach ana'ojb'al i hat.</para>
  <para style="q">
    <verse number="17" style="v" />Ruum xti korik noq re' hat ti ye'wik kikowiil, kiloq'il.</para>
  <para style="q">Re' hat ti ye'wik ruman qeh i qajaawriik ruum je' re' inawaaj i hat.</para>
  <para style="q">
    <verse number="18" style="v" />QaJaaw Dios, re' hat ti ko'linik qeh,</para>
  <para style="q">eh hat qareey i hoj, hoj aj Israel.</para>
  <para style="q">Eh hat wo' santo chi qanaah.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Re' hat xaq'o'reej taqe aatinamiit</para>
  <para style="q">pan kisaq wiriik je' wili i xaq'or keh:</para>
  <para style="q">Re' hin xnusik' wach jinaj i kow riib' chi kixilak i nutinamiit,</para>
  <para style="q">xnuyeew runimaal wach, xnutoob'eej.</para>
  <para style="q">
    <verse number="20" style="v" />Eh nureq i David, chi numoso.</para>
  <para style="q">Eh xnuyeew i waseite wach naah noq xnupab'aa' chi reyil.</para>
  <para style="q">
    <verse number="21" style="v" />Re' reh ma' jaruuj naa nukanaam rutoob'jiik.</para>
  <para style="q">Juneliik naa nuye'em rukowiil ruk'ux ruuk' i wajaawriik.</para>
  <para style="q">
    <verse number="22" style="v" />Eh ma' xta naruuchjiik kuum i nixowanik wach.</para>
  <para style="q">Eh ma' nata ruq'atariik wach kuum i yiib' wach kina'ojb'al.</para>
  <para style="q">
    <verse number="23" style="v" />Re' hin naa nusacham kiwach i ki-ixowanik wach.</para>
  <para style="q">Eh naa nuye'em taqe panti' k'axik i ma' ki ajwanik taa wach.</para>
  <para style="q">
    <verse number="24" style="v" />Eh re' hin ma' nata nukanaam ruketeljiik wach,</para>
  <para style="q">je' wo' hoq i rutoob'jiik.</para>
  <para style="q">Naa nuye'em ruman i rajaawriik.</para>
  <para style="q">
    <verse number="25" style="v" />Naa nuye'em rajaawriik chinaah i palaw Mediterráneo,</para>
  <para style="q">eh imponik i wilik wii' i nim ha' Éufrates.</para>
  <para style="q">
    <verse number="26" style="v" />Eh je' wili naa ruq'orom weh: Re' hat i wajaaw, hat i nuDios,</para>
  <para style="q">hat paat ab'aj ko'lemb'al iib' chi weh, inkoq.</para>
  <para style="q">
    <verse number="27" style="v" />Eh naa nuye'em ruloq'il chi je' peet wak'uun.</para>
  <para style="q">Eh q'e' naa nuye'em i ruloq'il chuwach</para>
  <para style="q">i kiloq'il i reey wilkeeb' wach ak'al.</para>
  <para style="q">
    <verse number="28" style="v" />Ma' naa ta nukanaam ruketeljiik wach,</para>
  <para style="q">ni xata naa nujalam wach i nuq'orom reh chi naa nub'anam ruuk'.</para>
  <para style="q">
    <verse number="29" style="v" />Re' taqe riih rumaam naa kokiik chi reyil chi jilob'aal i reh,</para>
  <para style="q">je' re' naa rub'aan kuuk' korehtaal insahchik wach i taxaaj.</para>
  <para style="q">
    <verse number="30" style="v" />Eh wila' re' taqe i riih rumaam</para>
  <para style="q">ma' xkik'am naah i nuk'uhb'aal.</para>
  <para style="q">Eh wila' ma' xkian i korik inwaaj i hin,</para>
  <para style="q">
    <verse number="31" style="v" />eh wila' xkian i mahk chuwach i nuk'uhb'aal.</para>
  <para style="q">Eh wila' ma' xkaaj kianaam taqe i ruq'or i nuk'uhb'aal,</para>
  <para style="q">
    <verse number="32" style="v" />re' hin naa nuye'em taqe chutojariik i kimahk.</para>
  <para style="q">Je' naa ruuk' b'olob'ik chee' naa nub'anam ti' k'axik keh.</para>
  <para style="q">
    <verse number="33" style="v" />Eh re' David reh eliik naa nuketelaam wach,</para>
  <para style="q">ma' naa ta nuyojom wach i korik nuq'orom cho reh.</para>
  <para style="q">
    <verse number="34" style="v" />Ma' naa ta nuyojom wach i nuk'uhb'aal nuyejaam wach ruuk',</para>
  <para style="q">ni xata naa nujalam wach i nuq'orom cho reh.</para>
  <para style="q">
    <verse number="35" style="v" />Re' hin ruuk' i nuSantohiil nuq'orom cho reh i David,</para>
  <para style="q">chi ma' jaruuj neenuchuk i q'orik reh.</para>
  <para style="q">
    <verse number="36" style="v" />Xti korik chi re' taqe i riih rumaam</para>
  <para style="q">naa kokiik chi reyil chi juneliik,</para>
  <para style="q">korehtaal insahchik wach i q'iij.</para>
  <para style="q">
    <verse number="37" style="v" />Re' keh naa ruwihiik kajaawriik</para>
  <para style="q">chi reyil korehtaal insahchik wach i poh.</para>
  <para style="q">Je' wo' hoq i taxaaj, inki i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="38" style="v" />Je' wo' naq re' i xaq'or chaloq</para>
  <para style="q">xa re' la' xaq'eb' wo' chi riij ak'ux i reey asik'im cho wach,</para>
  <para style="q">xchalik aajosq'iil ruuk'.</para>
  <para style="q">
    <verse number="39" style="v" />Xayoj wach aq'orom cho reh amoso</para>
  <para style="q">chi naa a'nam cho ruuk'.</para>
  <para style="q">Je' naa xaq'uch i ru corona, je' naaxakut panak'al.</para>
  <para style="q">
    <verse number="40" style="v" />Eh xateheb'eej i tz'aq kotimaj wii' riij i rutinamiit</para>
  <para style="q">reh chi xusach kiwach.</para>
  <para style="q">
    <verse number="41" style="v" />Chu'nchel i ki-ik'ik ar inkelq'aaj i chib'ih keh i rutinamiit.</para>
  <para style="q">Eh kikaqse'ljik kuum kika'jaah.</para>
  <para style="q">
    <verse number="42" style="v" />Xayeew kikowiil inixowanik wach reh chi xb'aan keh.</para>
  <para style="q">Eh xasuq suq chik kik'ux chi xi elik korik</para>
  <para style="q">taqe aj ixowaal re' re'.</para>
  <para style="q">
    <verse number="43" style="v" />Ma' xatoob'eej ta cho panq'aq'inik</para>
  <para style="q">xawesaj i ruq'asiil i ruch'ihch'.</para>
  <para style="q">
    <verse number="44" style="v" />Xawesaj chi jumpech i ruloq'il,</para>
  <para style="q">i rajaawriik chi reyil.</para>
  <para style="q">
    <verse number="45" style="v" />Eh xatoq rooq i ruhab'ul,</para>
  <para style="q">eh xayeew q'ab' chi xuk'uhtaaj ruk'ixb'ilaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="46" style="v" />QaJaaw Dios, ¿Ko jaruuj i naaketelaaj cho nuwach?</para>
  <para style="q">¿Mi juneliik naa ruqopiik re' aajosq'iil chi nunaah chi je' nqop q'aaq'?</para>
  <para style="q">
    <verse number="47" style="v" />Jaaw, k'oloq panak'ux chi re' nuk'achariik xama' najt ta rooq.</para>
  <para style="q">Eh chu'nchel i tinamit xatz'uhkrisaj</para>
  <para style="q">xama' najt ta wo' rooq i kik'achariik.</para>
  <para style="q">
    <verse number="48" style="v" />¿Mi wilik jino'q ineenk'acharik chi ma' nee ta inkimik?</para>
  <para style="q">¿Mi wilik i neerukot riij chi ma' naa ta reliik reje wach ak'al?</para>
  <para style="b" />
  <para style="q">
    <verse number="49" style="v" />QaJaaw Dios, ¿Mi xakanaa' re' i ketelenik wachiis</para>
  <para style="q">i na a'n cho najtir, re' i xaq'or cho reh i David</para>
  <para style="q">ruuk' i rukorkiil wach ak'ux?</para>
  <para style="q">
    <verse number="50" style="v" />Jaaw, chakoj rehtaal chi re' taqe</para>
  <para style="q">amoso k'ahchi' kib'ajariik kuum i tinamit.</para>
  <para style="q">Eh re' hin ma' inik'ik panuk'ux i ruti'kiil inki a'n weh re' re'.</para>
  <para style="q">
    <verse number="51" style="v" />Re' taqe i ki-ixowanik awach,</para>
  <para style="q">je' re' rub'ajariik taqe amoso inki a'n</para>
  <para style="q">Je' wo' re' rub'ajariik i reey inki a'n</para>
  <para style="q">re' asik'im cho wach,</para>
  <para style="q">eh xa aha' inooj je' re' inki a'n reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="52" style="v" />Loq'imaj ta naq i QaJaaw Dios chi juneliik.</para>
  <para style="q">Je' ta wo' naq re'.</para>
  <chapter number="90" style="c" />
  <para style="s">Re' Dios k'achlik chi juneliik re' winaq xama' najt ta nk'acharik</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, xa re' wo' hat ti ko'linik qeh pampeet,</para>
  <para style="q">eh xakok'ahchi' wo' kooj ako'leem yu'naak.</para>
  <para style="q">
    <verse number="2" style="v" />Eh noq komajaa' i natz'uhkrisaj i yuuq' k'ixkaab',</para>
  <para style="q">i wach ak'al, taqe i k'achareel wilkeeb' chupaam,</para>
  <para style="q">xa hat wo' cho Dios, eh je' wo' chi juneliik.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' hat i naasutej wo' chik chi pooq i winaq.</para>
  <para style="q">Noq inaq'or chi naa wo' chik kisutiniik chi pooq, kisutinik wo' hoq.</para>
  <para style="q">
    <verse number="4" style="v" />Xti korik noq re' jinaj miil haab' chawee hat,</para>
  <para style="q">xa je' rukab' noq xik'ik i q'iij eew,</para>
  <para style="q">eh xa je' naa nik'ik kiib' ixib'-oq ora reh aq'ab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' ruk'achariik i winaq xa je' jino'q xohk'risanik</para>
  <para style="q">inasach wach chi jumehq'iil, je' naa nik'ik qeerjoq ruum i rooq ha'.</para>
  <para style="q">Xa je' rukab' i ch'ahn, ink'ihik pan wahq'eq.</para>
  <para style="q">
    <verse number="6" style="v" />Chawil i ch'ahn reh xasuq chik i k'ihik i rub'an pan wahq'eq,</para>
  <para style="q">eh paruxq'eqiil inb'ooyrik, eh inkimik chi jumpech.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Xti korik noq re' hat i nayeew aajosq'iil chi qanaah, inasach qawach.</para>
  <para style="q">Eh insahchik qana'ojb'al chi jumpech.</para>
  <para style="q">
    <verse number="8" style="v" />Ruum chu'nchel i qamahk i ruyib'kiil wach qana'ojb'al</para>
  <para style="q">pansaqum wilik chawach i hat.</para>
  <para style="q">
    <verse number="9" style="v" />Eh xti korik chi re' qak'achariik naa asacham wach ruum aajosq'iil,</para>
  <para style="q">eh jarub' haab' qak'achariik xa je' nik'ik junjiiq' chi uxlab'al.</para>
  <para style="q">
    <verse number="10" style="v" />Ruum re' hoj xalajeeb' wo' ru kajwinaq haab'</para>
  <para style="q">qoh k'acharik, eh re' taqe i xti q'e' kow, kajwinaq haab' kik'achariik.</para>
  <para style="q">Eh chi q'e' najt nee qoh k'acharik, xaruti'kiil k'uxliis,</para>
  <para style="q">xa kowlaj kamanik i ruk'am chaloq.</para>
  <para style="q">Eh re' i ju'jun chi haab' jumehq'iil inik'ik je' rukab' i qak'achariik.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Ma' jino'q ineht'alinik reh nik' wach i sachooj neena a'n ruuk' aajosq'iil.</para>
  <para style="q">Ma' jino'q ineht'alinik reh ko aha' neemponik i ransil aajosq'iil</para>
  <para style="q">
    <verse number="12" style="v" />Chayeew qeh chi naab'jik chi xama' najt ta rooq i qak'achariik,</para>
  <para style="q">reh chi neenqareq qana'ojb'al chub'anariik</para>
  <para style="q">i holohik imponik chawach i hat.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />QaJaaw Dios, ¿konik' chik najtiil naa aye'em</para>
  <para style="q">aajosq'iil chi qanaah?</para>
  <para style="q">Chaketelaaj wo' chik qawach i hoj, hoj amoso.</para>
  <para style="q">
    <verse number="14" style="v" />Chak'uhtaaj qeh chi jumehq'iil aawotob'il.</para>
  <para style="q">Chi je' re' ma' k'isiin ta suq kiil qak'ux</para>
  <para style="q">noq neenqatz'uyej awach nik' chik najtiil i qak'achariik.</para>
  <para style="q">
    <verse number="15" style="v" />Chayeew jarub'-oq haab' qeh i suq laj k'acharik</para>
  <para style="q">je' rukab' noq xqak'ul i k'ih laj haab' chi ti' k'axik.</para>
  <para style="q">
    <verse number="16" style="v" />Chayeew qeh chi naab'jik taqe aakamaj i hoj, hoj amoso.</para>
  <para style="q">Eh re' taqe i qiih qamaam neenkilow wach aaloq'il.</para>
  <para style="q">
    <verse number="17" style="v" />Re' ta naq i rotob'il i QaJaaw Dios nee ruyeew chi qanaah.</para>
  <para style="q">Xti re' ta naq i reh neentoob'inik qeh chi manlik ruuk' i qakamaj</para>
  <para style="q">reh chi nee qoh elik korik ruuk' i neenqa a'n.</para>
  <chapter number="91" style="c" />
  <para style="s">Re' QaJaaw Dios inko'linik qeh chuwach i ti' k'axik</para>
  <para style="q">
    <verse number="1" style="v" />Awach i k'acharik i rub'an chi ri'sil i rajaawriik i QaJaaw Dios</para>
  <para style="q">xiik' naah nimaal i rajaawriik, ma' xta nee ruk'ul.</para>
  <para style="q">
    <verse number="2" style="v" />Je' la' wili i ruq'or: QaJaaw Dios, re' hat ti ko'linik</para>
  <para style="q">weh, hat ticha'jinik weh, hat nuDios,</para>
  <para style="q">awuuk' i hat i nuyeew nuk'ux, inki.</para>
  <para style="q">
    <verse number="3" style="v" />Re' Dios neenko'linik aweh pan kiq'ab' inkaaj achopariik.</para>
  <para style="q">Eh tiruko'leej chuwach i yab'ilaal inkansanik.</para>
  <para style="q">
    <verse number="4" style="v" />Re' reh naa ruko'liniik aweh,</para>
  <para style="q">je' rukab' noq i ruko'leej i rak'uun i ati't kixlaan chi ri'sil ruxiik'.</para>
  <para style="q">Eh re' rukorkiil wach ruk'ux naa ruko'liniik aweh</para>
  <para style="q">chi je' jino'q pulato ch'ihch'.</para>
  <para style="q">
    <verse number="5" style="v" />Eh ma' naa ta ayo'jiik kuum taqe i kiyohb'isanik chaq'ab',</para>
  <para style="q">eh ni xata kuum taqe i ti' k'axik ink'uloq pan q'iij.</para>
  <para style="q">
    <verse number="6" style="v" />Ma' nee ta tiyo'jik kuum taqe i yab'ilaal inchalik chaq'ab',</para>
  <para style="q">ni xata re' taqe i ti' k'axik kib'anik sachooj pan q'iij.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Atoob' ta nee kikimiik jino'q miil panatz'eet,</para>
  <para style="q">eh lajeeb'-oq miil panasak'aaj,</para>
  <para style="q">re' hat ma' xta neenak'ul.</para>
  <para style="q">
    <verse number="8" style="v" />Xa naa la' awilom ruuk' naq'awach</para>
  <para style="q">noq naakiye'ariik chutojariik</para>
  <para style="q">i kimahk taqe i yiib' wach i kina'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' hat ma' xta naa ak'ulum,</para>
  <para style="q">ruum re' QaJaaw Dios nim rajaawriik xakoj chi awaj ko'loom.</para>
  <para style="q">Eh ruuk' i reh i nayeew ak'ux.</para>
  <para style="q">
    <verse number="10" style="v" />Ma' xta jino'q i ti' k'axik naa ruchaliik cha naah.</para>
  <para style="q">Eh ni xata naakitz'a'jiik ruum yab'ilaal i wilkeeb' panapaat.</para>
  <para style="q">
    <verse number="11" style="v" />Ruum re' QaJaaw Dios naa rutaq'aam taqe chaloq i ruánjel,</para>
  <para style="q">reh chi naa kaat kicha'jeem xa aha' pa' nee tiooj i k'oq.</para>
  <para style="q">
    <verse number="12" style="v" />Re' keh naa kaat kich'ihleem ruuk' kiq'ab',</para>
  <para style="q">reh chi ma' nee ta naq'oj awiib' wataq ab'aj.</para>
  <para style="q">
    <verse number="13" style="v" />Eh neetib'ehik chi kixilak kaq b'ahlam, chi kixilak i aaq',</para>
  <para style="q">chi kixilak i kak'uun i kaq b'ahlam,</para>
  <para style="q">chi kixilak i nimaq josq'laj chikop.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' QaJaaw Dios je' wili ruq'or:</para>
  <para style="q">Ruum chi q'e' kiruk'ax naa nuko'leem chikiwach taqe re'.</para>
  <para style="q">Eh naa nuye'em runimaal wach ruum reht'al chi re' hin i Dios.</para>
  <para style="q">
    <verse number="15" style="v" />Eh noq neerupahqaaj rutoob'jiik weh, nee wo' nutob'eej.</para>
  <para style="q">Re' hin naa wesaniik reh pan i ti' k'axik,</para>
  <para style="q">eh naa nuye'em ruloq'il.</para>
  <para style="q">
    <verse number="16" style="v" />Re' hin naa nuye'em k'ih-oq haab' reh i suq laj k'acharik,</para>
  <para style="q">eh naa wo' nuko'leem, inki.</para>
  <chapter number="92" style="c" />
  <para style="s">Re' rutz'uuyjiik wach i Dios ruum i rotob'il</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios nim awajaawriik, yohb'aal wach holwochiil alooq'jiik,</para>
  <para style="q">je' wo' hoq i rutzuyjiik wach aab'ihnaal.</para>
  <para style="q">
    <verse number="2" style="v" />Eh ruq'orariik rib'iral pan wahq'eq pan chaq'ab' i ketelinik wachiis i na a'n,</para>
  <para style="q">i rukorkiil wach ak'ux.</para>
  <para style="q">
    <verse number="3" style="v" />Ruuk' i k'ahaam wach q'ooj,</para>
  <para style="q">ruuk' arpa xama' q'e' ta kow inq'orik, eh ruuk' k'isa q'ooj k'ahaam wach.</para>
  <para style="q">
    <verse number="4" style="v" />QaJaaw Dios, re' hat xayeew rusuqkiil nuk'ux ruuk' taqe i xa a'n wuuk'.</para>
  <para style="q">Eh noq inwilow taqe akamaj i na a'n ma' k'isiin ta nsuuqb'ik nuk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios, yohb'aal wach nimaal wach taqe akamaj i na a'n,</para>
  <para style="q">eh yohb'aal wach chamiil paam taqe akapeb'aal.</para>
  <para style="q">
    <verse number="6" style="v" />Re' i ruchop ruk'ux chub'anariik i ruyiib' wach na'ojb'al,</para>
  <para style="q">ma' reht'al taj i wili, ni xata rureq chi riij.</para>
  <para style="q">
    <verse number="7" style="v" />Re' taqe i yiib' wach kina'ojb'al,</para>
  <para style="q">xa je' kikab' noq ink'ihik johtoq i yiib' wach ch'ahn.</para>
  <para style="q">Eh kielik korik ruuk' inki a'n xa re' la' naa wo' naa rusachariik kiwach.</para>
  <para style="q">
    <verse number="8" style="v" />Eh re' hat QaJaaw Dios, naa ruye'ariik runimaal awach chi juneliik.</para>
  <para style="q">
    <verse number="9" style="v" />Jaaw xti korik noq re' taqe</para>
  <para style="q">i ki-ixowanik awach naa rusachariik kiwach.</para>
  <para style="q">Eh chu'nchel i kib'anik reh i yiib' wach na'ojb'al naa rutuukjiik kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' hat xayeew ruman i waansil je' rukab' i ransil jino'q i kowlaj imas wakax.</para>
  <para style="q">Eh xachihkaaj ink'ohnik laj iq'oom wach nunaah.</para>
  <para style="q">
    <verse number="11" style="v" />Re' hin naawilom noq naa rub'aan keh taqe i ki-ixowaanik nuwach.</para>
  <para style="q">Eh naab'iram noq naakik'erem kichii' i yiib' wach kib'anik re' re'.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' i korik wach kik'ux naakixmak'iniik je' rukab' noq inixmak'inik i kalaab'.</para>
  <para style="q">Je' rukab' noq ink'ihik i chakaltee' ar Líbano.</para>
  <para style="q">
    <verse number="13" style="v" />Re' keh naa kiwihiik parupaat i Dios,</para>
  <para style="q">eh naakeliik korik je' naa ki ixmak'inik jino'q chee'</para>
  <para style="q">ma' najt ta ruuk' i rupaat i QaJaaw.</para>
  <para style="q">
    <verse number="14" style="v" />Re' keh atoob' ta pan kirijb'iil xanaa wo' kiwachiniik ruuk' i naa kianam,</para>
  <para style="q">xanaa wo' ruwihiik kikowiil.</para>
  <para style="q">
    <verse number="15" style="v" />Reh chi naa kiq'orom rib'iral chi re' QaJaaw Dios inko'linik qeh.</para>
  <para style="q">Eh chi korik wach ruk'ux, chi parub'ehel i rub'an chu'nchel.</para>
  <chapter number="93" style="c" />
  <para style="s">Re' QaJaaw Dios xiik' naah nimaal wach i rajaawriik</para>
  <para style="q">
    <verse number="1" style="v" />Re' QaJaaw Dios xti manlik reey,</para>
  <para style="q">xiik' naah nimaal wach, eh xti wilik rajaawriik chinaah chu'nchel i wilik.</para>
  <para style="q">Re' reh xye'wik paruye'aab' i wach ak'al, reh chi ma' awach ta neenk'uyu'sanik reh.</para>
  <para style="q">
    <verse number="2" style="v" />Noq xa a'n chaloq i re' xa hat wo' cho reey.</para>
  <para style="q">Ruum xa wilkaat wo' chaloq noq ko ma' jaa' chii wilik.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Jaaw, re' taqe nim ha'</para>
  <para style="q">yohb'aal wach i choqik inki a'n ruum i kijosq'iil.</para>
  <para style="q">Eh yohb'aal wach najtiil imponik i kib'ohl.</para>
  <para style="q">
    <verse number="4" style="v" />Re' hat Jaaw i wilkaat chaloq pan taxaaj,</para>
  <para style="q">inaq'at wach i kib'ohl taqe nim ha' re' re' ruuk' awajaawriik,</para>
  <para style="q">je' wo' hoq i kijosq'iil i palaw.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios, re' taqe i ruq'or aak'uhb'aal ma' jaljinaq ta wach.</para>
  <para style="q">Eh re' i santohiil naa rukamaniik</para>
  <para style="q">chi xoyb'al paam aapaat chi juneliik.</para>
  <chapter number="94" style="c" />
  <para style="s">Re' QaJaaw Dios naa ruq'atwiik q'orik chikinaah i tinamit</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, cha k'uhtaaj aajosqiil kuuk' i yiib' wach kib'anik</para>
  <para style="q">ruum xa re' wo' hat neetiq'ajwik wach keh inki a'n</para>
  <para style="q">
    <verse number="2" style="v" />Re' hat i q'atal q'orik, chayeew taqe chutojariik</para>
  <para style="q">i kimahk i nimaq kiwach inki a'n kiib'.</para>
  <para style="q">
    <verse number="3" style="v" />QaJaaw Dios, ¿xti kojaruuj inkimay elik korik i yiib' wach kina'ojb'al?</para>
  <para style="q">Eh ¿Xti kojaruuj i nelik i rusuqkiil kik'ux?</para>
  <para style="q">
    <verse number="4" style="v" />Eh ¿Xti ko jaruuj inkikanaa' ruq'orariik yiib' wach q'orik?</para>
  <para style="q">Eh ¿Xti ko jaruuj inkikanaa' runimb'eesjiik kiwach taqe i yiib' wach kina'ojb'al?</para>
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios, re' taqe re' kian ti' k'axik keh awak'uun awixq'uun,</para>
  <para style="q">inkiyeew ruti'kiil ruk'ux.</para>
  <para style="q">
    <verse number="6" style="v" />Eh inkikansaj taqe ixoq kamnaq kib'ahiil, taqe i ma' xata kituut qajaaw,</para>
  <para style="q">je' wo' taqe i tokoom tinamit wilkeeb' ar.</para>
  <para style="q">
    <verse number="7" style="v" />Je' wili inkiq'or: Re' ruDios chee Jacob ma' rilow taj</para>
  <para style="q">chib'ih jariik i k'ahchi'kooj, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' taq i hat i yiib' taq wach ana'ojb'al,</para>
  <para style="q">i na a'n inawaaj taq i hat, ma' nareq ta taq chi riij taq inaq'or.</para>
  <para style="q">
    <verse number="9" style="v" />¿Mi ma' nee taq tirib'iraj re' ixyej-anik reh taqe axikin?</para>
  <para style="q">¿Mi ma' nee taq tirilow re' ixyej-anik reh taqe i naq'awach?</para>
  <para style="q">
    <verse number="10" style="v" />¿Mi ma' nee taq tiruyeew chutojariik</para>
  <para style="q">taq amahk re' i Dios, inq'ilwik keh i nimaq tinamit?</para>
  <para style="q">¿Mi ma' neerunab'eej re' taq i na a'n, inkojwik qana'ojb'al?</para>
  <para style="q">
    <verse number="11" style="v" />Re' QaJaaw Dios reht'al chi re' taqe winaq</para>
  <para style="q">xa memil laj na'ojb'al inkikapaaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />QaJaaw Dios atoob' keh taqe inakoj kina'ojb'al i hat.</para>
  <para style="q">Eh inak'uhtaaj keh chib'ih taqe ruq'or aak'uhb'aal.</para>
  <para style="q">
    <verse number="13" style="v" />Reh chi xasuq wo' kik'ux noq neenk'u'loq i ti' k'axik chikinaah.</para>
  <para style="q">Eh re' taqe i yiib' wach kina'ojb'al,</para>
  <para style="q">k'ahchi' rukorjiik kiye'aab' naakikutariik wii'.</para>
  <para style="q">
    <verse number="14" style="v" />Eh re' QaJaaw Dios ma' jaruuj neeruq'eb' chi riij ruk'ux i rak'uun rixq'uun,</para>
  <para style="q">ni xata nee rukanaa' taqe chi kutkeel.</para>
  <para style="q">
    <verse number="15" style="v" />Eh re' taqe i q'atal q'orik parub'ehel chik naakiq'atam i q'orik.</para>
  <para style="q">Chu'nchel i korik wach kik'ux je' re' naa kianam.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />¿Awach naq i xchalik chi nuko'ljiik i hin pan kiq'ab'</para>
  <para style="q">taqe i yiib' wach kina'ojb'al i ma' holohik ta kib'anik?</para>
  <para style="q">
    <verse number="17" style="v" />Wita ma' xirutoob'eej i QaJaaw Dios xin kimik naq chik pan kiq'ab' i aj ixowaal,</para>
  <para style="q">ma' wilkiin ta naq chik yu'naak.</para>
  <para style="q">
    <verse number="18" style="v" />Eh nik' xnuq'or chi ma' naa ta chik nukuyum,</para>
  <para style="q">re' hat QaJaaw Dios xatoob'inik weh ruuk' aak'axb'al.</para>
  <para style="q">
    <verse number="19" style="v" />Nik' xantukik chik paam i nunaah</para>
  <para style="q">ruum taqe i nukapeew re' hat xat ye'wik rusuqkiil nuk'ux.</para>
  <para style="q">
    <verse number="20" style="v" />Re' hat maa k'am awiib' pansuqkiil kuuk' i q'atal q'orik yiib' wach i kina'ojb'al,</para>
  <para style="q">re' i ma' inki a'n taj i ruq'or i k'uhb'aal.</para>
  <para style="q">
    <verse number="21" style="v" />Eh inkimol kiib' chukojariik kimahk i korik wach kik'ux,</para>
  <para style="q">inkiq'at i q'orik reh chi naa kikanteesjiik.</para>
  <para style="q">
    <verse number="22" style="v" />Eh re' hin xa ruuk' wo' QaJaaw Dios inuko'leej wiib',</para>
  <para style="q">re' reh je' rukab' paat ab'aj ko'lemb'al iib' chi wee hin.</para>
  <para style="q">
    <verse number="23" style="v" />Re' QaJaaw Dios, naa rusacham kiwach</para>
  <para style="q">taqe i yiib' wach kina'ojb'al, ruum taqe i kimahk.</para>
  <para style="q">Eh re' wo' reh naa rusachwiik kiwach.</para>
  <chapter number="95" style="c" />
  <para style="s">Qatz'uyej wach i QaJaaw Dios chi suq qak'ux</para>
  <para style="q">
    <verse number="1" style="v" />Kim taq qaloq'ej taq i QaJaaw Dios, ruuk' rusuqkiil qak'ux.</para>
  <para style="q">Qatz'uyej taq wach i qaj ko'loom, i je' paat ab'aj ko'lb'al iib' chi qeh.</para>
  <para style="q">
    <verse number="2" style="v" />Qat'iosej reh i rotob'il i rub'an quuk',</para>
  <para style="q">eh qatz'uyej wach ye'b'al ruloq'il.</para>
  <para style="q">
    <verse number="3" style="v" />Ruum re' QaJaaw Dios xti manlik Reey,</para>
  <para style="q">eh re' reh xiik' naah nimaal wach chikiwach chu'nchel i xa tiyoox.</para>
  <para style="q">
    <verse number="4" style="v" />Eh pan q'ab' wilik taqe i ye'aab' pan chaamlaj jul wilkeeb'.</para>
  <para style="q">Eh re' wo' reh inehchanik reh taqe yuuq' xiik' naah najtiil kinaah.</para>
  <para style="q">
    <verse number="5" style="v" />Re' wo' reh inehchanik reh i palaw, je' wo' hoq ak'al ma' xta wii' ha'.</para>
  <para style="q">Ruum re' wo' reh xyej-anik keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Kim taq qaloq'ej, qaloch' qiib',</para>
  <para style="q">qaxuk'aa' qiib' chuwach i QaJaaw Dios, re' ixtz'uhkrisanik qeh.</para>
  <para style="q">
    <verse number="7" style="v" />Re' reh i qaDios,</para>
  <para style="q">eh re' hoj, hoj rutinamiit,</para>
  <para style="q">re' reh incha'jinik qeh i hoj, hoj rutentzuun noq wilkooj,</para>
  <para style="b" />
  <para style="q">wila' xab'iraj taq i ruq'oral i Dios yu'naak.</para>
  <para style="q">
    <verse number="8" style="v" />Maakoowb'isaj taq awánima, maa a'n taq aweh i xkian taq aamaam awati't ar Meriba.</para>
  <para style="q">Eh je' rukab' i xkian Masah, panchiq yuuq'.</para>
  <para style="q">
    <verse number="9" style="v" />Eh chupaam taqe q'iij re' re' xinkaaj naq kipajam aamaam awati't</para>
  <para style="q">atoob' ta xkilow wo' naq taqe i ma' ilooj taj xnub'an.</para>
  <para style="q">
    <verse number="10" style="v" />Eh ka'winaq haab' xinkaqrik kuuk' i tinamit re' re',</para>
  <para style="q">eh je' wili i xnuq'or chikiij: Re' taqe i tinamit wili kiq'eb'em kiib'.</para>
  <para style="q">Eh ma' nkinimaj taj i nuk'uhb'aal.</para>
  <para style="q">
    <verse number="11" style="v" />Ruum aj re' ruuk' nujosq'iil ti xnuq'or i korik</para>
  <para style="q">chi ma' jaruuj naa kokiik chupaam i nuye'aab' naa rub'aan wii' hi'lik, inki Dios.</para>
  <chapter number="96" style="c" />
  <para style="s">Re' ak'laj tz'uuy loq'oomb'al reh i QaJaaw Dios</para>
  <para style="r">(<ref loc="1CH 16:23-33">1 Cron 16.23-33</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />Chatz'uyej taq i ak' laj tz'uuy loq'oomb'al reh i QaJaaw Dios.</para>
  <para style="q">Chawunchelaal taq i hat aj wach ak'al cha tz'uyej taq wach i QaJaaw.</para>
  <para style="q">
    <verse number="2" style="v" />Chatz'uyej taq wach i QaJaaw Dios, chayeew taq runimaal wach.</para>
  <para style="q">Eh rajlaal q'iij taq cha q'or rib'iral chi xa re' wo' reh aj Ko'loom.</para>
  <para style="q">
    <verse number="3" style="v" />Chaq'or taq rib'iral i ruloq'il keh chu'nchel i tinamit,</para>
  <para style="q">je' wo' hoq i ma' ilooj taj i rub'an.</para>
  <para style="q">
    <verse number="4" style="v" />Ruum re' QaJaaw Dios xiik' naah nimaal wach, i ruk'ul chi naa qaye'em ruloq'il.</para>
  <para style="q">Eh xa re' wo' reh nim rajaawriik chikiwach taqe i tiyoox.</para>
  <para style="q">
    <verse number="5" style="v" />Re' ki dios taqe i tokoom tinamit, xatz'aqoj tiyoox taqe.</para>
  <para style="q">Eh re' i qaDios i hoj re' reh xyej-anik reh i taxaaj.</para>
  <para style="q">
    <verse number="6" style="v" />Ma' k'isiin ta saqumaal chii' wach. QaJaaw Dios, xiik' naah nimaal i rajaawriik,</para>
  <para style="q">i ruloq'il chupaam i rupaat.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Chawunchelaal taq i hat aj wach ak'al chayeew taq rajaawriik,</para>
  <para style="q">ruloq'il i QaJaaw Dios.</para>
  <para style="q">
    <verse number="8" style="v" />Chayeew taq ruloq'il i QaJaaw ruum xa re' wo' reh i ruk'ul chi naa taq aye'em ruloq'il.</para>
  <para style="q">Eh chak'am taq chaloq aamayiij chupaam i rupaat.</para>
  <para style="q">
    <verse number="9" style="v" />Chaloq'ej taq i QaJaaw Dios chupaam i ruye'aab' q'e' holohik.</para>
  <para style="q">Eh chu'nchel ta naq i tinamit neenyohlinik reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Chaq'or taq keh i tinamit chi re' QaJaaw Dios manlik Reey,</para>
  <para style="q">eh xuyeew paruye'aab' i wach ak'al, ma' awach ta neenk'uyu'sanik reh.</para>
  <para style="q">Eh parub'ehel naa ruq'atam i q'orik chikinaah i tinamit.</para>
  <para style="q">
    <verse number="11" style="v" />Neeta naq insuuqb'ik rik'ux i taxaaj, i wach ak'al.</para>
  <para style="q">Neeta naq ink'uyu'jik i palaw, i wilkeeb' chupaam ruum i rusuqkiil kik'ux.</para>
  <para style="q">
    <verse number="12" style="v" />Eh nee ta naq insuuqb'ik kik'ux i yuuq' k'ixkaab', taqe i wilkeeb' chuwach.</para>
  <para style="q">Neeta naq inkik'er kichii' ruum rusuqkiil</para>
  <para style="q">kik'ux taqe i chee' wilkeeb' pantaq ch'ahn.</para>
  <para style="q">
    <verse number="13" style="v" />Chu'nchel naa rusuuqb'iik kik'ux</para>
  <para style="q">chuwach i QaJaaw k'ulik iloq reh,</para>
  <para style="q">ruum parub'ehel naa ruq'atam i q'orik</para>
  <para style="q">chikinaah i tinamit ayu' wach ak'al.</para>
  <chapter number="97" style="c" />
  <para style="s">Re' QaJaaw Dios xti manlik Reey</para>
  <para style="q">
    <verse number="1" style="v" />Re' i QaJaaw Dios manlik Reey suuqb'oq taq ak'ux i hat wach ak'al,</para>
  <para style="q">je' wo' taq i hat i ye'aab' kotimaj taq awiij chi ha'.</para>
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw Dios kotimaj riij chi q'equm paam suutz',</para>
  <para style="q">parub'ehel i ruq'at i q'orik, i rub'an i taaq'anik.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i QaJaaw Dios je' naa q'aaq' peet chuwach,</para>
  <para style="q">ruuk' i re' i rusach kiwach i ki-ixowanik wach.</para>
  <para style="q">
    <verse number="4" style="v" />Eh re' rusaqumaal xan saqumanik chik i wach ak'al i rub'an.</para>
  <para style="q">Eh re' i wach ak'al ink'uyu'jik ruum.</para>
  <para style="q">
    <verse number="5" style="v" />Re' taqe yuuq' kihab'ik, xa je' chik kihab'ik kantela</para>
  <para style="q">chuwach i QaJaaw Dios ehchan reh chu'nchel i wach ak'al.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taxaaj ink'uhtanik i rukorkiil wach ruk'ux i QaJaaw Dios,</para>
  <para style="q">eh chu'nchel i tinamit ki-ilwik reh i ruloq'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Eh chu'nchel inkinimb'isaj kiwach ruuk' i kiloq'oonjiik i tiyoox</para>
  <para style="q">naa kikahniik pan k'ixb'ilaal.</para>
  <para style="q">Eh chu'nchel i kikojariik chi dios korehtaal inkiloch' kiib' chuwach i QaJaaw.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios, re' ye'aab' Sión,</para>
  <para style="q">re' tinamiit i Judá ma' k'isiin ta nsuuqb'ik kik'ux,</para>
  <para style="q">ruum parub'ehel inaq'at i q'orik.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hat Jaawxiik'naah nimaal awach,</para>
  <para style="q">xa re' wo' hat i xti nim awajaawriik chinaah i wach ak'al,</para>
  <para style="q">je' wo' chikiwach taqe i xa tiyoox.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' taq i hat i tik'axwik reh i QaJaaw Dios cha kanaa' taq i yiib' wach na'ojb'al.</para>
  <para style="q">Re' reh i ruko'leej riij i kik'achariik i rusantolaj aj nimaneel,</para>
  <para style="q">i ruko'leej pan kiq'ab' i yiib' wach kib'anik.</para>
  <para style="q">
    <verse number="11" style="v" />Eh i ruyeew i rusaqumaal i kina'ojb'al i korik wach kik'ux.</para>
  <para style="q">Iruyeew rusuqkiil kik'ux i korik kib'anik.</para>
  <para style="q">
    <verse number="12" style="v" />Re' taq i hat korik taq wach ak'ux chasuuqb'isaj taq awánima ruuk' i QaJaaw Dios,</para>
  <para style="q">chaloq'ej taq i rusantolaj b'ihnaal.</para>
  <chapter number="98" style="c" />
  <para style="s">Re' QaJaaw Dios xelik korik ruuk' i xub'an</para>
  <para style="q">
    <verse number="1" style="v" />Chatz'uyej taq i ak' laj tz'uuy</para>
  <para style="q">chi loq'oomb'al reh i QaJaaw Dios.</para>
  <para style="q">Ruum ma' k'isiin taqe i ma' ilooj taj xub'an,</para>
  <para style="q">eh ruuk' i santo laj rajaawriik xub'an keh i aj ixowaal.</para>
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw xuq'or rib'iral chi xelik korik,</para>
  <para style="q">eh xuk'uhtaaj i rukorkiil wach ruk'ux chikiwach chu'nchel i tinamit.</para>
  <para style="q">
    <verse number="3" style="v" />Re' QaJaaw Dios wilik cho paruk'ux i ruketeljiik kiwach,</para>
  <para style="q">i kitoob'jiik i aj Israel.</para>
  <para style="q">Eh chu'nchel i tinamit wach ak'al xi-ilwik reh</para>
  <para style="q">chi xuq'at kiwach i aj ixowaal i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Chawunchelaal taq i hat aj wach ak'al cha tz'uyej</para>
  <para style="q">taq wach i QaJaaw Dios chi suq taq ak'ux.</para>
  <para style="q">Chapoq'poteej taq paam aq'ab' chutz'uuyjiik wach i Dios.</para>
  <para style="q">
    <verse number="5" style="v" />Chatz'uyej taq wach i QaJaaw ruuk' arpa,</para>
  <para style="q">ruuk' taqe xa chib'ih chik q'ojil k'ahaam kiwach.</para>
  <para style="q">
    <verse number="6" style="v" />Chatz'uyej taq wach i QaJaaw Dios ruuk' i ruxuljiik i tuun, ruuk' i ch'ihch' kow inq'orik</para>
  <para style="q">ruum re' reh xti manlik Reey.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Naa ruk'uyu'jiik i palaw, je' wo' i wilkeeb' chupaam.</para>
  <para style="q">Naa ruk'uyu'jiik i wach ak'al, je' wo' k'achareel chupaam.</para>
  <para style="q">
    <verse number="8" style="v" />Naakiq'ojom kiib' kib'ohl i nim ha'.</para>
  <para style="q">Eh naa rusuuqb'iik kik'ux i yuuq'.</para>
  <para style="q">
    <verse number="9" style="v" />Chu'nchel i re' naa rusuqb'iik kik'ux</para>
  <para style="q">ruum re' QaJaaw naa ruchaliik</para>
  <para style="q">chi taaq'anik chinaah wach ak'al.</para>
  <para style="q">Eh parub'ehel naa ruq'atam q'orik chikinaah i tinamit.</para>
  <chapter number="99" style="c" />
  <para style="s">Re' QaJaaw Dios xti manlik reey nim rajaawriik</para>
  <para style="q">
    <verse number="1" style="v" />Re' QaJaaw Dios manlik Reey,</para>
  <para style="q">chi kixilak i k'achaach wilik kixiik'.</para>
  <para style="q">Re' tinamit, eh re' wach ak'al</para>
  <para style="q">xakib'arb'otik chik ruum kiyo'jiik chuwach.</para>
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw Dios xiik' naah nimaal wach ar Sión.</para>
  <para style="q">Eh xiik' naah i rajaawriik chikinaah chu'nchel i tinamit.</para>
  <para style="q">
    <verse number="3" style="v" />Neeta naq inye'arik ruloq'il rub'ihnaal,</para>
  <para style="q">ruum re' reh xiik' naah yohb'alil wach. Eh xti wilik rusantohiil.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' reey xiik' naah nimaal i rajaawriik</para>
  <para style="q">imponik chuwach i korik.</para>
  <para style="q">Eh xub'an cho ruuk' i Jacob i rub'ehel, i korik.</para>
  <para style="q">
    <verse number="5" style="v" />Chayeew taq ruloq'il i QaJaaw i qaDios</para>
  <para style="q">chaxuk'aa' taq awiib' ri'si rooq ri'si q'ab'.</para>
  <para style="q">Ruum re' reh xti wilik rusantohiil.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' Moisés, re' i Aarón xi kamanik chi kajaaw aj tiij chuwach i Dios.</para>
  <para style="q">Re' i Samuel xwihik chi kixilak i xiloq'inik reh i rub'ihnaal i Dios.</para>
  <para style="q">Eh noq xkipahqaaj i rotob'il i Dios xitoob'jik wo' hoq.</para>
  <para style="q">
    <verse number="7" style="v" />Eh chupaam i junrahp chi suutz' xiq'orob'jik cho ruum i QaJaaw Dios.</para>
  <para style="q">Eh xkian wo' i xq'orarik keh,</para>
  <para style="q">xkinimaj chu'nchel i ruk'uhb'aal.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios, xatoob'eej taqe noq xkipahqaaj awotob'il</para>
  <para style="q">xat kikoj chi ki Dios kuyuul mahk.</para>
  <para style="q">Eh xayeew taqe chutojariik i kimahk i yiib' wach kina'ojb'al.</para>
  <para style="q">
    <verse number="9" style="v" />Chaloq'ej taq i QaJaaw i qaDios,</para>
  <para style="q">chaxuk'aa' taq awiib' chulooq'jiik chupaam i rusantolaj ye'aab' Sión.</para>
  <para style="q">Ruum re' i QaJaaw Dios xti wilik rusantohiil.</para>
  <chapter number="100" style="c" />
  <para style="s">Re' ruq'orariik chi naa rut'iosjiik reh i QaJaaw Dios i rotob'il</para>
  <para style="q">
    <verse number="1" style="v" />Chawunchelaal taq i hat i wilkaat taq chi junsuut i wach ak'al,</para>
  <para style="q">cha tz'uyej taq wach i QaJaaw Dios chi suq suq taq ak'ux.</para>
  <para style="q">
    <verse number="2" style="v" />Cha a'n taq i rukamaj i QaJaaw Dios chi chu'nchel taq ak'ux.</para>
  <para style="q">Eh kim taq chaloq'ej taq ruuk' atz'uuy chi suq suq taq ak'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Chanab'eej taq chi re' QaJaaw re' reh i xti manlik Dios.</para>
  <para style="q">Eh re' reh tz'uhk'risanik qeh.</para>
  <para style="q">Ma' re' tee hoj xqatz'uhkrisaj qiib' chi qib'il qiib',</para>
  <para style="q">hoj rak'uun rixq'uun, hoj rutentzuun noq wilkooj.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh okeen taq i koq chi chii' i ru puertahiil</para>
  <para style="q">i rupaat i QaJaaw Dios chi t'ioosjik i rotob'il.</para>
  <para style="q">Chatz'uyej taq wach,</para>
  <para style="q">chayeew taq runimaal wach i rub'ihnaal.</para>
  <para style="q">
    <verse number="5" style="v" />Ruum re' i QaJaaw Dios xiik' naah i rotob'il,</para>
  <para style="q">eh juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">Eh korik wach ruk'ux chi juneliik.</para>
  <chapter number="101" style="c" />
  <para style="s">Re' reey David xuq'or reh i Dios chi naa rub'anam i korik</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, re' hin naa kaat nuloq'em ruuk' nutz'uuy.</para>
  <para style="q">Ruum re' hat korik wach ak'ux, eh hat aj keteloom wachiis.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin neenureq chi riij i wihik parukorkiil noq nee kinatoob'eej.</para>
  <para style="b" />
  <para style="q">Chi je' re' korik wach i nuk'ux noq neekinwihik</para>
  <para style="q">chi kixilak wilkeeb' panupaat.</para>
  <para style="q">
    <verse number="3" style="v" />Re' hin ma' nuk'ax ta wach</para>
  <para style="q">i yiib' wach imb'aan.</para>
  <para style="b" />
  <para style="q">Eh ma' imponik ta chi nuwach inki a'n inkiq'eb' kiib' chuwach i Dios,</para>
  <para style="q">re' taqe re' ma' jino'q nanuk'ulum cho wuuk'.</para>
  <para style="q">
    <verse number="4" style="v" />Re' hin ma' nee ta nukapaaj i ma' holohik taj.</para>
  <para style="q">Eh ma' xtaj i yiib' wach na'ojb'al inwaaj nub'anam.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Naa nuq'ilim taqe inkib'aj kas kichaaq'.</para>
  <para style="q">Re' hin ma' naa ta nukuyum kimahk</para>
  <para style="q">i xa q'et q'et taqe, eh inkinimb'isaj kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' hin naa nusik'im kiwach taqe i korik wach kik'ux</para>
  <para style="q">reh chi naa kiwihiik wuuk'.</para>
  <para style="q">Eh xa re' wo' hoq i korik wach ruk'ux paruk'achariik</para>
  <para style="q">naa rokiik chi kamanik wuuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Eh chupaam i nupaat</para>
  <para style="q">ma' jino'q i rub'an i leq'</para>
  <para style="q">ruuk' jot'ooj naa ruwihiik.</para>
  <para style="q">Ma' jino'q i chukul q'orik naa ruwihiik ar.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Eh rajlaal q'iij naa nusacham kiwach</para>
  <para style="q">taqe i yiib' wach kina'ojb'al wilkeeb' panqatinamiit.</para>
  <para style="q">Eh naawisam taqe reje chi kixilak i rutinamiit</para>
  <para style="q">i Dios.</para>
  <chapter number="102" style="c" />
  <para style="s">Re' rutiij jinaj i q'e' ti' ruk'ux</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios chab'iraj tii weh i nutiij.</para>
  <para style="q">Chayeew tii weh i nupahqaaj aweh.</para>
  <para style="q">
    <verse number="2" style="v" />Maa kinakanaa' chi wutkeel</para>
  <para style="q">noq wilkiin panti' k'axik kinab'iraj la'.</para>
  <para style="q">Eh kinatoob'eej chi jumehq'iil</para>
  <para style="q">nik' neenupahqaaj aawotob'il.</para>
  <para style="q">
    <verse number="3" style="v" />Ruum re' nuk'achariik k'ahchi' rusahchiik wach je' rukab' noq sahchik wach i sib'.</para>
  <para style="q">Eh re' taqe nub'aqil je' cho k'ahchi' ruk'ahtiik pan q'aaq' noq inwik'raaj.</para>
  <para style="q">
    <verse number="4" style="v" />Re' wánima xa nyot'ik chik</para>
  <para style="q">xa je' chik rukab' i ch'ahn noq inchiqik.</para>
  <para style="q">Eh ruum i re' xata chik i ruq'or nuk'ux i wi'k.</para>
  <para style="q">
    <verse number="5" style="v" />Eh xa nub'aqil chik ruum i ma' k'isa</para>
  <para style="q">oq'ik i nub'an ruum i ruti'kiil nuk'ux.</para>
  <para style="q">
    <verse number="6" style="v" />Je' nukab' i ooloch' wilik chupaam i ye'aab' chiq yuuq',</para>
  <para style="q">eh je' nukab' i tuhkur xa nokik meem.</para>
  <para style="q">
    <verse number="7" style="v" />Eh xama' jaruuj chik inqajik i nuwiriik,</para>
  <para style="q">xa je' chik nukab' jino'q i k'isa tz'ikin i ntz'irik wach nah paat.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taqe ki-ixowanik nuwach</para>
  <para style="q">ma' jaruuj inkikanaa' nub'ajariik,</para>
  <para style="q">ma' holohik ta kiq'orik chi wiij.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hin chaaj chik i nuk'ux chi jilow nuwa'.</para>
  <para style="q">Eh re' nuhaa' inwuk'ej inq'ehb'ik chaloq i riis naq'nuwach chupaam.</para>
  <para style="q">
    <verse number="10" style="v" />Ruum re' hat Jaaw xayeew aajosq'iil chi nunaah.</para>
  <para style="q">Eh pampeet xayeew wajaawriik, eh yu'naak xawesaj i wajaawriik.</para>
  <para style="q">
    <verse number="11" style="v" />Re' nuk'achariik k'ahchi' rusahchiik wach,</para>
  <para style="q">je' rukab' noq inik'ik jino'q i muuj, eh je' rukab' noq inchiqik i ch'ahn.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Eh re' hat QaJaaw Dios xa wilkaat wo' chi juneliik.</para>
  <para style="q">Eh xanaa wo' ak'uliik pankik'ux jar ch'iht chi k'achareel i naakik'iik.</para>
  <para style="q">
    <verse number="13" style="v" />QaJaaw Dios, qoh ab'iraj tii,</para>
  <para style="q">chaketelaaj wach i tinamit Sión ruum xponik chik i ruq'ijil.</para>
  <para style="q">Eh xponik chik i ru orahiil chi naa akuyum i kimahk.</para>
  <para style="q">
    <verse number="14" style="v" />Re' taqe awaj kamanoom ma' k'isiin ta inkiketelaaj wach</para>
  <para style="q">taqe ab'aj korjinaq wii' i kipaat, eh q'e' ti' inkik'raaj noq xiyojib'ik.</para>
  <para style="q">
    <verse number="15" style="v" />Eh chu'nchel i tinamit naakiyohliniik wach i QaJaaw Dios,</para>
  <para style="q">eh re' taqe reey wilkeeb' sut i wach ak'al naakiye'em ruloq'il.</para>
  <para style="q">
    <verse number="16" style="v" />Na' chuyejaa' wo' chik cho ruka'peech i tinamit Sión,</para>
  <para style="q">re' na' chuk'uhtaaj chee ruloq'il.</para>
  <para style="q">
    <verse number="17" style="v" />Re' noq naa rib'irjiik i kitiij i ti' kik'ux,</para>
  <para style="q">eh na' ye'aroq keh aha' wilik inkipahqaaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Re' taqe wili ajwaal wach chi naa rutz'ihb'jiik kahnoq rehtalil.</para>
  <para style="q">Reh chi neenkiloq'ej i QaJaaw Dios</para>
  <para style="q">chu'nchel i tinamit naa kiwihiik koq'uun</para>
  <para style="q">je' wo' hoq i komajaa' ki-aasjik.</para>
  <para style="q">
    <verse number="19" style="v" />Re' QaJaaw Dios xrilow chaloq</para>
  <para style="q">ko parusantolaj ye'aab' ar pan taxaaj i tinamit wach ak'al.</para>
  <para style="q">
    <verse number="20" style="v" />Reh chi xutoob'eej taqe i ye'ooj panti' k'axik.</para>
  <para style="q">Eh chuko'ljiik taqe i q'atooj chik q'orik</para>
  <para style="q">chikinaah chi naa kikanteesjiik.</para>
  <para style="q">
    <verse number="21" style="v" />Reh chi pan tinamit Sión,</para>
  <para style="q">eh Jerusaleem neen q'orarik rib'iral,</para>
  <para style="q">eh neenlooq'jik i rub'ihnaal i QaJaaw Dios.</para>
  <para style="q">
    <verse number="22" style="v" />Re' noq chu'nchel i tinamit naakimolom kiib'</para>
  <para style="q">chub'anariik aha' wilik iraaj i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Eh re' reh xresaj inukowiil noq komajaa' hin rijib'</para>
  <para style="q">xuqasaj rooq i nuk'achariik.</para>
  <para style="q">
    <verse number="24" style="v" />Re' hin je' wili i xnuq'or:</para>
  <para style="q">Jaaw hat nuDios maa kinakansa</para>
  <para style="q">noq kore' yejaal i nuk'achariik.</para>
  <para style="q">Ruum re' hat ma' xata ajlamaj haab' aak'achariik kinki reh.</para>
  <para style="q">
    <verse number="25" style="v" />Re' hat xat ye'wik reh pan kiye'aab'</para>
  <para style="q">chu'nchel i wach ak'al.</para>
  <para style="q">Eh re' wo' hat xatyej-anik reh i taxaaj.</para>
  <para style="q">
    <verse number="26" style="v" />Chu'nchel i re' naa rusahchiik kiwach,</para>
  <para style="q">eh re' hat naa awihiik chi juneliik.</para>
  <para style="q">Re' taqe re' naakiq'ahiik je' rukab' noq inq'ahik itz'ihy,</para>
  <para style="q">xa je' injalarik itz'ihy neena a'n na' chajal kiwach.</para>
  <para style="q">
    <verse number="27" style="v" />Re' hat xa re' wo' awach chi juneliik,</para>
  <para style="q">ruum ma' xata ajlamaj haab' aak'achariik.</para>
  <para style="q">
    <verse number="28" style="v" />Re' taqe i kiih kimaam awaj kamanoom</para>
  <para style="q">naa atoob'eem taqe chi juneliik.</para>
  <para style="q">Re' hat na awilwiik keh, re' hat naa awihiik kuuk'.</para>
  <chapter number="103" style="c" />
  <para style="s">Re' hin naa nuloq'em i QaJaaw Dios chu'nchel nuk'ux</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin naa nuloq'em i QaJaaw Dios chu'nchel i wánima.</para>
  <para style="q">Eh naa nuye'em ruloq'il i santo laj rub'ihnaal.</para>
  <para style="q">
    <verse number="2" style="v" />Naa nuye'em ruloq'il i QaJaaw Dios chu'nchel i wánima</para>
  <para style="q">ruum ma' jaruuj naa rusahchiik panuk'ux i rotob'il.</para>
  <para style="q">
    <verse number="3" style="v" />Re' reh inkuywik chu'nchel i numahk,</para>
  <para style="q">re' reh ink'aachrisanik weh ruuk' chu'nchel i nuti'kiil.</para>
  <para style="q">
    <verse number="4" style="v" />Re' reh inko'linik weh chuwach i kimik,</para>
  <para style="q">eh i ruyeew weh i rotob'il chi manlik, i ruketelaaj nuwach.</para>
  <para style="q">
    <verse number="5" style="v" />Re' reh inye'wik weh i suq atoob', reh chi kinkahnik</para>
  <para style="q">chi je' jino'q ak'un reh chi kinkahnik chi je' jino'q xihk ma' ahl ta ruti'jolal.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' QaJaaw Dios parub'ehel i ruq'at i q'orik</para>
  <para style="q">chikinaah i k'ahchi' rub'aan ti' k'axik keh.</para>
  <para style="q">
    <verse number="7" style="v" />Eh xuk'uhtaaj wo' reh i Moisés chib'ih jariik taqe xub'an,</para>
  <para style="q">xuk'uhtaaj i runimaal i rajaawriik keh i aj Israel.</para>
  <para style="q">
    <verse number="8" style="v" />Re' QaJaaw Dios xa atoob' wach ruk'ux, eh q'e' aj keteloom wachiis.</para>
  <para style="q">Re' reh ma' jumehq'iil ta nchalik rujosq'iil,</para>
  <para style="q">ruum xiik' naah i ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="9" style="v" />Ma' chu'nchel ta q'iij k'ahchi'kooj runaqam,</para>
  <para style="q">eh ma' ruyeew ta paruk'ux i rujosq'iil.</para>
  <para style="q">
    <verse number="10" style="v" />Ma' qohruyeew ta panti' k'axik je' naq rukab' i ruk'ul chi qeh, ruum q'e' hoj aj mahk.</para>
  <para style="q">Eh xiik' naah yib'kiil wach i qana'ojb'al.</para>
  <para style="q">
    <verse number="11" style="v" />Re' QaJaaw Dios xiik' naah i ruketeljiik kiwach i rub'an i kiyohlinik reh.</para>
  <para style="q">Ma' xata je' najtiil ruuk' i wach ak'al i taxaaj i ruketeljiik kiwach i rub'an.</para>
  <para style="q">
    <verse number="12" style="v" />Ruum re' qamahk xresaj reje chi qawach,</para>
  <para style="q">nik' najtiil wilik ruuk' ireelb'aalq'iij i rookb'aal q'iij</para>
  <para style="q">je' re' najtiil xukanaa' reje quuk' i qamahk.</para>
  <para style="q">
    <verse number="13" style="v" />Re' QaJaaw Dios ma' k'isiin ta</para>
  <para style="q">ruketelaaj kiwach i kiyohlinik reh,</para>
  <para style="q">je' rukab' noq i ruketelaaj wach</para>
  <para style="q">i rak'uun rixq'uun jino'q i aajaab'ees.</para>
  <para style="q">
    <verse number="14" style="v" />Ruum re' reh reht'al noq xa hoj wo' tii tiwik,</para>
  <para style="q">eh reht'al wo' hoq chi xa pooq i qayej-aal.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Re' ruk'achariik i winaq xa reh junk'aam,</para>
  <para style="q">xa je' rukab' i ch'ahn,</para>
  <para style="q">xa je' rukab' i uhtz'ub' ink'er cho pantaq ab'iix.</para>
  <para style="q">
    <verse number="16" style="v" />Eh inchalik i kowlaj teew chinaah, eh insahchik wach,</para>
  <para style="q">ma' awach ta chik i naab'inik reh chib'ih inooj kuxoq wii'.</para>
  <para style="q">
    <verse number="17" style="v" />Raaj i ketelinik wachiis i rub'an i QaJaaw Dios reh,</para>
  <para style="q">wilik chi juneliik chi keh taqe i kiyohlinik reh,</para>
  <para style="q">eh naa wo' rub'anam korik kuuk' i kiih kimaam.</para>
  <para style="q">
    <verse number="18" style="v" />Je' wo' re' i naa rub'anam kuuk'</para>
  <para style="q">taqe i kib'anik reh taqe i ruq'orom chaloq chi naa rub'aan.</para>
  <para style="q">Je' wo' kuuk' taqe i kinimanik reh taqe i ruq'or i ruk'uhb'aal.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Re' QaJaaw Dios ar wilik chi taaq'anik pan taxaaj.</para>
  <para style="q">Eh re' reh wilik rajaawriik chikinaah chu'nchel i xa chib'ih jariik.</para>
  <para style="q">
    <verse number="20" style="v" />Chayeew taq ruloq'il i QaJaaw Dios</para>
  <para style="q">i hat ánjel wilik taq akowiil.</para>
  <para style="q">Re' taq i hat i na a'n taq aha' wilik i ruq'or,</para>
  <para style="q">eh i nayeew taq ak'ux chunimjiik.</para>
  <para style="q">
    <verse number="21" style="v" />Chayeew taq ruloq'il i QaJaaw Dios</para>
  <para style="q">chawunchelaal taq i hat i ruye'em taq awajaawriik</para>
  <para style="q">chub'anariik taqe i rukamaj.</para>
  <para style="q">Re' i tib'anik taq reh iraaj i reh.</para>
  <para style="q">
    <verse number="22" style="v" />Eh chawunchelaal taq i hat i xatrutz'uhkrisaj taq,</para>
  <para style="q">i QaJaaw Dios chayeew taq ruloq'il</para>
  <para style="q">ko aha' pa' imponik i rajaawriik chi taaq'anik.</para>
  <para style="b" />
  <para style="q">Eh je' wo' hin naa wo' nuye'em ruloq'il i QaJaaw Dios</para>
  <para style="q">chu'nchel i wánima.</para>
  <chapter number="104" style="c" />
  <para style="s">Re' rulooq'jiik i Dios i xtz'uhkrisanik cho reh i xa chib'ih jariik</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios re' hin naa kaat nuloq'em chu'nchel i wánima.</para>
  <para style="b" />
  <para style="q">Jaaw, hat nuDios xiik' naah awajaawriik,</para>
  <para style="q">xiik' naah nimaal awach, xiik' naah aaloq'il.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hat xiik' naah saqumaal aachii' awach, re' hat xatyej-anik reh i taxaaj.</para>
  <para style="q">Xayeew chinaah i wach ak'al chi je' nimlaj itz'ihy.</para>
  <para style="q">
    <verse number="3" style="v" />Re' hat xayejaa' aa ye'aab' chinaah i ha' ar pan taxaaj.</para>
  <para style="q">Inakoj taqe chi je' aakareta b'ehtesb'al aweh i suutz'.</para>
  <para style="q">Eh tib'ehik wo' hoq chupaam i teew.</para>
  <para style="q">
    <verse number="4" style="v" />Re' hat inakoj taqe chi awaj taqareel kowlaj teew.</para>
  <para style="q">Eh inakoj taqe chi awaj kamanoom i xaq q'aaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh xach'ikaa' wo' chi korik i wach ak'al paruye'aab',</para>
  <para style="q">reh chi ma' awach ta neenk'uyu'sanik reh.</para>
  <para style="q">
    <verse number="6" style="v" />Re' palaw rub'urum naq naah i wach ak'al.</para>
  <para style="q">Eh re' ha' rub'urum naq naah taqe inajt kinaah yuuq'.</para>
  <para style="q">
    <verse number="7" style="v" />Eh noq xaq'or reh i ha', chi naa rumolom riib' xelik wo' chinaah i wach ak'al,</para>
  <para style="q">noq xrib'iraj aq'oral xa je' chik inq'orik kahoq.</para>
  <para style="q">
    <verse number="8" style="v" />Eh noq xawesaj chee ha' chinaah i nimaq yuuq' xumol riib' wach k'ixkaab'.</para>
  <para style="q">Eh xataq'aaj reje chupaam i ye'aab' aq'orom chi ar naa ruwihiik.</para>
  <para style="q">
    <verse number="9" style="v" />Aha' xaq'or reh chi naa ruwihiik xa ar wo' wilik, ma' xq'ahxik ta chik reje chi juntar,</para>
  <para style="q">reh chi ma' xutz'ap ta chik naah i wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' hat ti ye'wik reh i ha' inaasjik cho paraasb'al.</para>
  <para style="q">Eh re' hat ti ye'wik reh taqe nim ha' kiqajik cho nah taq yuuq'.</para>
  <para style="q">
    <verse number="11" style="v" />Eh re' taqe ha' re' re' inkuk'ej i josq'laj chikop.</para>
  <para style="q">Ruuk' ha' re' re' inkik'saj i kichiqchi'iil</para>
  <para style="q">i b'uurux wilkeeb' wa taq yuuq' k'ixkaab'.</para>
  <para style="q">
    <verse number="12" style="v" />Chi chii' i ha' re' re' inkiyejaa' kisuuq' i kok' tz'ikin kirupinik pan taxaaj.</para>
  <para style="q">Ar xasuq chik i ruq'or i tz'uuy inki a'n nah q'ab' chee'.</para>
  <para style="q">
    <verse number="13" style="v" />Re' hat ti ye'wik cho kihaa' i yuuq' k'ixkaab' ko ar panaye'aab' pan taxaaj.</para>
  <para style="q">Ruuk' i kowlaj jab' inajot'isaj i wach aak'al.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hat tik'isanik johtoq reh i ch'ahn inkik'ux i chikop.</para>
  <para style="q">Re' hat tik'isanik reh i rutik i winaq,</para>
  <para style="q">reh chi ruuk' i re' naa rub'anam ruwa' ruhaa'.</para>
  <para style="q">
    <verse number="15" style="v" />Re' wi'k ha' re' re' inye'wik ransil,</para>
  <para style="q">i nayeew reh i riis uuva chi ruk'ej.</para>
  <para style="q">Eh i nayeew reh aseite reh chi nsuuqb'ik ruk'ux.</para>
  <para style="q">
    <verse number="16" style="v" />Inayeew cho kihaa' taqe chee' ak'isam johtoq i hat,</para>
  <para style="q">je' wo' taqe i chee' chakaltee' wilkeeb' ar Líbano.</para>
  <para style="q">
    <verse number="17" style="v" />Eh chinaah taqe q'ab' i chee' re' re' inkiyejaa' kisuuq' kok' tz'ikin, eh</para>
  <para style="q">inkiyejaa' wo' kisuuq' ar taqe i nimaq saq ikih.</para>
  <para style="q">
    <verse number="18" style="v" />Re' taqe inajt kinaah yuuq' inkamanik chi kiye'aab' i keej re' ruuk' i kaqch'ul.</para>
  <para style="q">Eh pantaq ruhopil ab'aj inkiyejaa' kisuuq' taqe imul.</para>
  <para style="q">
    <verse number="19" style="v" />Eh re' hat QaJaaw Dios xayejaa' chee poh pajb'al reh i ju'jun chi q'iij.</para>
  <para style="q">Eh aweht'al nik' i rumay i sihq'inik i q'iij.</para>
  <para style="q">
    <verse number="20" style="v" />Eh noq re' hat i nayeew chee q'equm chinaah i wach ak'al inkahnik chi chaq'ab' chik,</para>
  <para style="q">eh kielik taqe chaloq i chikop pantaq ch'ahn.</para>
  <para style="q">
    <verse number="21" style="v" />Re' taqe kaq b'ahlam inkik'er kichii' chusik'ariik kitiib'</para>
  <para style="q">inkipahqaaj aweh i hat i kiwa'.</para>
  <para style="q">
    <verse number="22" style="v" />Eh noq i nelik chaloq i rusaqumaal i q'iij kiooj wo' chik,</para>
  <para style="q">eh inooj kiyok'aa' kiib' pankijuul.</para>
  <para style="q">
    <verse number="23" style="v" />Re' winaq noq insaq'ik inooj pan rukamaj.</para>
  <para style="q">Eh noq inokik i q'iij insutinik wo' chik cho parupaat.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />QaJaaw Dios yohb'aal inche wach taqe i xayejaa'.</para>
  <para style="q">Eh chu'nchel i re', xayejaa' ruuk' ana'ojb'al.</para>
  <para style="q">Aha' ta chik yuuq' ma' nilarik wach taqe i xa tz'uhk'risaj chaloq.</para>
  <para style="q">
    <verse number="25" style="v" />Hat xatyej-anik cho reh i palaw xiik' naah nimaal,</para>
  <para style="q">eh xiik' naah k'ihaal chikop wilkeeb' chupaam ar,</para>
  <para style="q">chi nimaq, chi kok' taq.</para>
  <para style="q">
    <verse number="26" style="v" />Eh chinaah palaw re' re' kib'ehik i barco.</para>
  <para style="q">Ar wilik i qamaan k'ap,</para>
  <para style="q">reh chi chupaam i palaw i rub'an ruk'o'niik.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Chu'nchel i chikop re' re',</para>
  <para style="q">inkuy-eej chi re' hat naa aye'wiik kiwa' paruorahiil.</para>
  <para style="q">
    <verse number="28" style="v" />Re' hat i nayeew keh, eh re' keh inkimol,</para>
  <para style="q">noq i nayeew keh i inkik'ux i suq atoob' korehtaal kinujik.</para>
  <para style="q">
    <verse number="29" style="v" />Wila' ma' xayeew chik cho kiwa' neenchalik kiyo'jiik.</para>
  <para style="q">Eh wila' xawesaj i kuxlaab' nee kikimiik,</para>
  <para style="q">nee wo' chik kisutinik chi pooq ak'al.</para>
  <para style="q">
    <verse number="30" style="v" />Eh noq i nayeew chee aawuxlaab'al wilik wo' chik i ki-aasjik,</para>
  <para style="q">eh i nujik wo' chik chi k'achareel wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" />Neeta naq inye'arik ruloq'il i QaJaaw Dios chi juneliik.</para>
  <para style="q">Eh suuqb'oq ta naq ruk'ux chi riij i rutz'uhkrisam chaloq.</para>
  <para style="q">
    <verse number="32" style="v" />Eh ink'uyu'jik i wach ak'al noq inilarik cho ruum i Dios.</para>
  <para style="q">Eh i nelik kisib'eel i yuuq' noq kitz'ajik ruum i Dios.</para>
  <para style="q">
    <verse number="33" style="v" />Re' hin juneliik naa nutz'uyem wach i QaJaaw Dios</para>
  <para style="q">nik' pa' chik najtiil i nuk'achariik ayu' wach ak'al.</para>
  <para style="q">
    <verse number="34" style="v" />Neeta naq imponik chuwach i QaJaaw Dios taqe i nukapaaj.</para>
  <para style="q">Re' hin ruuk' i reh inureq rusuqkiil nuk'ux.</para>
  <para style="q">
    <verse number="35" style="v" />Neeta naq insahchik kiwach chinaah i wach ak'al aj mahk.</para>
  <para style="q">Eh ma' ta naq chik neenilarik kiwach</para>
  <para style="q">i yiib' wach i kina'ojb'al.</para>
  <para style="b" />
  <para style="q">Re' hin naa nuloq'em i QaJaaw Dios chu'nchel i wánima.</para>
  <para style="q">Loq'imaj ta naq i QaJaaw.</para>
  <chapter number="105" style="c" />
  <para style="s">Re' ruk'axb'al i Dios xub'an cho kuuk' i aj Israel</para>
  <para style="r">(<ref loc="1CH 16:7-22">1 Cron 16.7-22</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />Chaloq'ej taq i QaJaaw Dios. Chaq'or taq rib'iral i loq'laj rub'ihnaal.</para>
  <para style="q">Eh chayeew taq keh chi naab'jik i tinamit taqe i rub'anam.</para>
  <para style="q">
    <verse number="2" style="v" />Cha a'n taq atz'uuy ye'b'al ruloq'il.</para>
  <para style="q">Chawesaj taq ruq'orkiil i nimaq wach na'ojb'al rub'anam.</para>
  <para style="q">
    <verse number="3" style="v" />Chayeew taq ruloq'il i rusantolaj b'ihnaal.</para>
  <para style="q">Eh chawunchelaal taq i hat i tisik'wik taq reh i QaJaaw Dios suuqb'oq taq ak'ux.</para>
  <para style="q">
    <verse number="4" style="v" />Chasik' taq i rajaawriik i QaJaaw Dios,</para>
  <para style="q">juneliik taq cha pahqaaj i rotob'il.</para>
  <para style="q">
    <verse number="5" style="v" />Mansahchik taq panak'ux i nimaq wach rukamaj</para>
  <para style="q">rub'anam, je' wo' taqe i ma' ilooj taj rub'anam.</para>
  <para style="q">K'oloq taq panak'ux i q'ataj Q'orik xub'an.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taq i hat, i hat taq riih rumaam</para>
  <para style="q">i Abraham re' rumoso chee Dios.</para>
  <para style="q">Hat taq rak'uun rixq'uun chaloq i Jacob i rusik'im cho wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' reh i QaJaaw, i qaDios.</para>
  <para style="q">Re' wo' reh wilik chi taaq'anik chinaah chu'nchel i wach ak'al.</para>
  <para style="q">
    <verse number="8" style="v" />Re' reh wilik paruk'ux chi juneliik i ruq'orom chaloq chi naa rub'anam ruuk' i tinamit.</para>
  <para style="q">Xa jarub' pa' ch'iht i k'acharik neenik'ik xama' naa ta wo' rik'iik paruk'ux.</para>
  <para style="q">
    <verse number="9" style="v" />Eh ma' nsahchik ta paruk'ux i ruyejaam cho wach ruuk' i Abraham.</para>
  <para style="q">Je' wo' xti korik xuq'or cho chi riij i Isaac.</para>
  <para style="q">
    <verse number="10" style="v" />Je' wo' xuyejaa' cho wach ruuk' i Jacob xukanaa' chi jinaj k'uhb'aal,</para>
  <para style="q">je' wo' i xuyejaa' cho wach ruuk' i Israel.</para>
  <para style="q">
    <verse number="11" style="v" />Re' noq xuq'or chi je' wili: Re' hin naa taq nuye'em aweh i ye'aab' Canaán</para>
  <para style="q">naa taq nuye'em aweh chi akooch, inki Dios.</para>
  <para style="q">
    <verse number="12" style="v" />Eh i xq'orarik keh, ma' re' ta nkiwii' chi xama' k'ih ta taqe,</para>
  <para style="q">xa je' taqe aj patal ponoq chupaam i ye'aab' re' re'.</para>
  <para style="q">
    <verse number="13" style="v" />Eh xata wo' jarub' chi tinamit ki-ik'ik wii', chi je' pankok' tinamit,</para>
  <para style="q">chi je' panimaq tinamit.</para>
  <para style="q">
    <verse number="14" style="v" />Re' Dios ma' xuyeew ta q'ab' chi awach ta xb'anik ti' k'axik keh,</para>
  <para style="q">xuq'il la' taqe i reey je' wili xuq'or keh:</para>
  <para style="q">
    <verse number="15" style="v" />Maa a'n taq ti' k'axik keh i nusik'im cho kiwach.</para>
  <para style="q">Ma' chih taq awuchej taqe i jalal nuq'oral, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Re' QaJaaw Dios xuyeew chaloq i wi'jaleel chikinaah i aj Israel.</para>
  <para style="q">Ma' xuyeew ta chik cho k'uxumb'al keh.</para>
  <para style="q">
    <verse number="17" style="v" />Eh xutaq'aaj reje Egipto i José chi peet,</para>
  <para style="q">re' xkik'ayej reje pankowlaj kamanik.</para>
  <para style="q">
    <verse number="18" style="v" />Re' reh xkib'ak' i rooq chi karena.</para>
  <para style="q">Eh xkian ti' k'axik reh pantz'ilom.</para>
  <para style="q">
    <verse number="19" style="v" />Eh korehtaal xooj eloq wach i ruq'orom rib'iral i José pampeet.</para>
  <para style="q">Re' ruq'oral i Dios xk'uhtanik reh chi korik i xuq'or chaloq.</para>
  <para style="q">
    <verse number="20" style="v" />Eh re' i wilik chi reyil chikinaah i</para>
  <para style="q">ma' k'isa tinamit xuq'or chi xkoq'taaj reje i José.</para>
  <para style="q">
    <verse number="21" style="v" />Eh re' reey xupab'aa' i José chi cha'jen reh i rupaat i rub'an wii' taaq'anik.</para>
  <para style="q">Eh xupab'aa' chi ajaab'esil chikinaah i tinamit.</para>
  <para style="q">
    <verse number="22" style="v" />Re' i José xwihik rajaawriik chikinaah i xi kamanik ruuk' i reey.</para>
  <para style="q">Eh chi xukoj kina'ojb'al i k'amal b'eeh, taqe i nimaq wach kikamaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Eh koq'uun chik xiooj Egipto taqe i aj Israel, re' taqe i rak'uun rixq'uun i Jacob.</para>
  <para style="q">Ar xi okik chi patinik chupaam i ye'aab' Cam rub'ihnaal.</para>
  <para style="q">
    <verse number="24" style="v" />Re' QaJaaw Dios xuk'ihaaxb'isaj i rutinamiit,</para>
  <para style="q">yohb'aal wach k'ihaal xi ponik, q'e' chik kow kiib' chikiwach i aj Egipto.</para>
  <para style="q">
    <verse number="25" style="v" />Je' re' noq xtohq'ik rixowjiik kiwach kuum aj Egipto.</para>
  <para style="q">Eh xuyeew q'ab' i Dios chi xb'aan ti' k'axik keh i rumoso ar.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Eh xrilow chi je' re' i Dios, xutaq'aaj reje Egipto i rumoso Moisés,</para>
  <para style="q">ruch'ihil i Aarón rusik'im cho kiwach.</para>
  <para style="q">
    <verse number="27" style="v" />Eh parub'ihnaal i Dios xkik'uhtaaj taqe i ma' ilooj taj ar Egipto.</para>
  <para style="q">Eh xkik'uhtaaj wo' nimaq wach sahchb'al k'uxliis ar Cam.</para>
  <para style="q">
    <verse number="28" style="v" />Eh re' Dios chi xuyeew i runimaal q'equm chikinaah i aj Egipto.</para>
  <para style="q">Xa re' la' re' keh xama' xkinimaj ta wo' hoq i xuq'or i Dios.</para>
  <para style="q">
    <verse number="29" style="v" />Eh xusutej wo' chi kik' taqe i nim ha'</para>
  <para style="q">xukansaj taqe kar wilkeeb' chupaam.</para>
  <para style="q">
    <verse number="30" style="v" />Xunujisaj chi tuhtz' paam chu'nchel i tinamit Egipto</para>
  <para style="q">xnujik chi tuhtz' paam i paat inwirik wii' i kireey.</para>
  <para style="q">
    <verse number="31" style="v" />Eh xa ruuk' i ruq'oral i Dios i xa sib' chik paam i nimaq utz',</para>
  <para style="q">i kok' utz' xkipuhkaaj kiib' chupaam i tinamit Egipto.</para>
  <para style="q">
    <verse number="32" style="v" />Xuyeew wo' i nimaq taq saq b'och chi jilow jab' chinaah i tinamit.</para>
  <para style="q">Eh xuyeew wo' i ma' k'isa xaq q'aaq'.</para>
  <para style="q">
    <verse number="33" style="v" />Ruuk' i taqe re' xsacharik wach i ki uuva, i ki higo,</para>
  <para style="q">i xitoqib'ik taqe i chee wilkeeb' chupaam ar Egipto.</para>
  <para style="q">
    <verse number="34" style="v" />Eh xa ruuk' ruq'oral i QaJaaw Dios</para>
  <para style="q">xnujik i nimaq taq chili'l chupaam i tinamit re' re', ma' xata ajlamaj taqe.</para>
  <para style="q">
    <verse number="35" style="v" />Re' taqe chikop re' re' kik'uxib'eej taqe ch'ahn,</para>
  <para style="q">je' wo' chu'nchel i kitik i nelik chinaah i wach ak'al.</para>
  <para style="q">
    <verse number="36" style="v" />Eh xukansaj wo' taqe chu'nchel i peet kak'uun i aj Egipto,</para>
  <para style="q">re' taqe i q'e' naq suq kik'ux chi riij.</para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" />Eh xresaj taqe chaloq Egipto i aj Israel,</para>
  <para style="q">xkik'am chaloq i ki oro, i ki plata.</para>
  <para style="q">Eh jar ch'uq chi kiib' ma' jino'q i yowaab' chi kixilak.</para>
  <para style="q">
    <verse number="38" style="v" />Eh re' taqe i aj Egipto xsuuqb'ik kik'ux noq xi elik chaloq i aj Israel,</para>
  <para style="q">ruum xiyo'jik ruum i xkik'ul.</para>
  <para style="q">
    <verse number="39" style="v" />Eh xuyeew chaloq i suutz' chikinaah muujb'al keh pan q'iij.</para>
  <para style="q">Eh chaq'ab' xuyeew chaloq i q'aaq' chikinaah sihq'b'al keh.</para>
  <para style="q">
    <verse number="40" style="v" />Eh noq xkipahqaaj kitiib', re' Dios xutaq'aaj chaloq k'oot reh chi xkik'ux.</para>
  <para style="q">Xutaq'aaj chaloq i kaxlanwi'k pan taxaaj, korehtaal xinujik.</para>
  <para style="q">
    <verse number="41" style="v" />Xutar wo' hoq i saqrehp ab'aj, eh xelik chaloq i ha',</para>
  <para style="q">xa je' chik nim ha' noq xb'ehik chupaam i ye'aab' chiq yuuq reh chi xkian kihaa'.</para>
  <para style="q">
    <verse number="42" style="v" />Je' re' xub'an i Dios,</para>
  <para style="q">ruum xk'ulik cho paruk'ux i q'e' looq' ruq'orom</para>
  <para style="q">cho reh i rumoso Abraham chi naa rub'anam ruuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" />Eh xresaj chaloq Egipto i rutinamiit rusik'im cho kiwach</para>
  <para style="q">ruuk' rusuqkiil k'uxliis xi elik chaloq.</para>
  <para style="q">
    <verse number="44" style="v" />Eh xuyeew keh i aj Israel i kiye'aab' i ma' kinimanik ta ree Dios,</para>
  <para style="q">re' chik i keh xib'anik rusuqkiil i kitik.</para>
  <para style="q">
    <verse number="45" style="v" />Reh naq chi naa kinimam i ruk'uhb'aal,</para>
  <para style="q">eh chi naa kik'amam naah i kitijiik i rub'an.</para>
  <para style="b" />
  <para style="q">Loq'imaj ta naq i QaJaaw Dios.</para>
  <chapter number="106" style="c" />
  <para style="s">Re' ruq'orariik chi re' taqe i aj Israel kok' xilak xkiq'etwachej i Dios</para>
  <para style="q">
    <verse number="1" style="v" />Loq'imaj ta naq i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">Chaloq'ej taq i QaJaaw Dios ruum re' reh q'e' atoob',</para>
  <para style="q">eh juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="2" style="v" />¿Awach i neerub'an ruq'orariik taqe i ma' ilooj taj xub'an i QaJaaw Dios?</para>
  <para style="q">¿Awach neerub'an rulooq'jiik je' rukab' i ruk'ul chi reh?</para>
  <para style="q">
    <verse number="3" style="v" />Atoob' keh inkitijej keh rub'aan i korik,</para>
  <para style="q">eh eliik inki a'n i rub'ehel.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />QaJaaw Dios nee ta tii kink'ulik cho panak'ux</para>
  <para style="q">i hin noq neena a'n otob'il keh aatinamiit.</para>
  <para style="q">Eh nee ta wo' tii kinako'leej haa' i hin.</para>
  <para style="q">
    <verse number="5" style="v" />Reh chi neenwilow i kik'axariik i na a'n taqe asik'im cho kiwach.</para>
  <para style="q">Reh chi nee kimb'anik haa' i rusuqkiil kik'ux</para>
  <para style="q">aaloq'il aatinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' hoj xoj mahkunik je' rukab' noq ximahkunik chaloq i qamaam qati't,</para>
  <para style="q">ma' k'isiin tee yiib' wach na'ojb'al inqa a'n.</para>
  <para style="q">
    <verse number="7" style="v" />Chawil taqe i qamaam qati't noq xi wihik cho Egipto,</para>
  <para style="q">ma' xkiyeew ta rajaawriik i taqe i ma' ilooj taj xa a'n.</para>
  <para style="q">Eh sahchik pankik'ux i kik'axariik xa a'n,</para>
  <para style="q">xkija'wachej kiib' chawach chi chii' kaq palaw.</para>
  <para style="q">
    <verse number="8" style="v" />Xa re' la' re' QaJaaw Dios xuko'leej taqe</para>
  <para style="q">k'uhtb'al reh i rajaawriik, ruuk' i ruk'axb'al.</para>
  <para style="q">
    <verse number="9" style="v" />Noq xuq'il i palaw jumehq'iil xuchiqsaj,</para>
  <para style="q">eh rik'saj taqe i aj Israel re' re' panyejaal i palaw chi xa je' panchiq yuuq'.</para>
  <para style="q">
    <verse number="10" style="v" />Je' re' kiko'ljiik xub'an pan kiq'ab' i nixowanik kiwach</para>
  <para style="q">xuko'leej wo' pan kiq'ab' i ma' najwaanta kiwach.</para>
  <para style="q">
    <verse number="11" style="v" />Eh ruuk' i palaw, xutz'ap kinaah i nixowanik kiwach,</para>
  <para style="q">ma' jino'q chik i xi kahnik.</para>
  <para style="q">
    <verse number="12" style="v" />Kora'j xkinimaj re' i aj Israel q'orooj cho rib'iral keh ruum i QaJaaw Dios,</para>
  <para style="q">eh kitz'uuyej wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Xa re' la' chi jumehq'iil xsahchik pankik'ux i xub'an Dios kuuk'.</para>
  <para style="q">Ma' xkuy-eej taj i ruyejaam naq wach chi keh.</para>
  <para style="q">
    <verse number="14" style="v" />Noq wilkeeb' cho chupaam i ye'aab' chiq yuuq,</para>
  <para style="q">noq ma' xta chik wilik keh xkipaj i Dios</para>
  <para style="q">ruuk' i rupahqaljiik reh chi ye'aroq keh chib'ih inkaaj.</para>
  <para style="q">
    <verse number="15" style="v" />Re' Dios xuyeew wo' keh i xkipahqaaj.</para>
  <para style="q">Xa re' la' jinaj wo' hoq i runimaal yaab'ilaal xuyeew chikinaah.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Chupaam i ye'aab' inkimol wii' kiib'</para>
  <para style="q">xkixow wach i Moisés ruch'ihil i Aarón</para>
  <para style="q">re' rusik'im cho wach i Dios.</para>
  <para style="q">
    <verse number="17" style="v" />Eh ruum i re' xutar chee ak'al i Dios</para>
  <para style="q">xub'iq' qohoq i winaq Datán rub'ihnaal.</para>
  <para style="q">Eh xub'iq' wo' qohoq i juntuhb' xihuch'ihlinik reh i Abiram.</para>
  <para style="q">
    <verse number="18" style="v" />Eh xqop jinaj i q'aaq' pan kiye'aab'.</para>
  <para style="q">Ruuk' i xaq q'aaq' re' re' xik'ahtik</para>
  <para style="q">chu'nchel i yiib' wach kina'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Chupaam i ye'aab' Horeb xkiyejaa'</para>
  <para style="q">jinaj i kitiyoox je' ruwii' k'isa imas wakax re' ruuk' i oro,</para>
  <para style="q">eh xkixuk'aa' kiib' chulooq'jiik.</para>
  <para style="q">
    <verse number="20" style="v" />Eh ma' re' ta chik i k'achlik Dios xkiloq'ej,</para>
  <para style="q">re' la' chik xkiloq'ej i tiyoox je' ruwii' b'ooyax ink'uxwik ch'ahn.</para>
  <para style="q">
    <verse number="21" style="v" />Re' keh xsahchik pankik'ux</para>
  <para style="q">i ki Dios xko'linik cho keh,</para>
  <para style="q">re' i xb'anik taqe i ma' ilooj taj kuuk' ar Egipto.</para>
  <para style="q">
    <verse number="22" style="v" />Re' wo' reh xb'anik taqe sachb'al</para>
  <para style="q">k'uxliis chupaam i ye'aab' Cam.</para>
  <para style="q">Eh xub'an kuuk' i ma' ilooj taj noq xi-ik'ik chupaam i kaq palaw.</para>
  <para style="q">
    <verse number="23" style="v" />Re' i Dios xraaj naq rusacham kiwach.</para>
  <para style="q">Xchalik i Moisés i rusik'im cho wach i Dios,</para>
  <para style="q">xupahqaaj chi marusach pee kiwach.</para>
  <para style="q">Xa je' chik re' noq xik'ik ruk'aah i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Re' taqe aj Israel ma' xkinimaj taj</para>
  <para style="q">i xq'orarik keh ruum i Dios.</para>
  <para style="q">Eh ma' xponik ta panaq'kiwach i ye'aab' q'e' holohik.</para>
  <para style="q">
    <verse number="25" style="v" />Ma' holohik ta xiq'orik chi riij i QaJaaw</para>
  <para style="q">chupaam i kitz'ihy naah paat,</para>
  <para style="q">eh ma' xkinimaj taj i ruq'oral.</para>
  <para style="q">
    <verse number="26" style="v" />Xrilow chi je' re' i QaJaaw Dios, kow xuq'or keh chi naa</para>
  <para style="q">kikimiik chupaam i ye'aab' chiq yuuq'.</para>
  <para style="q">
    <verse number="27" style="v" />Eh xuq'or chi naakikimiik i kiih kimaam.</para>
  <para style="q">Eh chi naa rutukem kiwach i tinamit i ma' kinimanik ta ree Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Eh chupaam i ye'aab' Peor xkiloq'ej i tiyoox Baal.</para>
  <para style="q">Eh xkik'ux keh i mayijimaj chikiwach i kamnaq tiyoox.</para>
  <para style="q">
    <verse number="29" style="v" />Ruum i kiyiib' wach na'ojb'al xkiqop wach i rujosq'iil i QaJaaw Dios,</para>
  <para style="q">eh xye'arik chikinaah i runimaal yab'ilaal.</para>
  <para style="q">
    <verse number="30" style="v" />Eh re' i Finees koxub'an chik reh i k'amal kib'eeh i yiib' wach kina'ojb'al,</para>
  <para style="q">kore' chik xikanab'jik ruum i runimaal yab'ilaal.</para>
  <para style="q">
    <verse number="31" style="v" />Re' QaJaaw Dios xrilow otob'il xub'an i Finees,</para>
  <para style="q">eh xuyeew cho runimaal wach chi riih chi rumaam.</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Eh xkiqop wo' chik wach i rujosq'iil i QaJaaw Dios ar Meriba re' i wilkeeb' wii' haa'.</para>
  <para style="q">Kuum i keh xuk'ul i ti' k'axik i Moisés ar.</para>
  <para style="q">
    <verse number="33" style="v" />Ma' k'isiin ta xkiyeew ruk'aah i Moisés</para>
  <para style="q">ruum i re' xsahchik ruk'ux xama' rureq ta chik chi riij chib'ih taqe ruq'or.</para>
  <para style="q">
    <verse number="34" style="v" />Re' taqe i aj Israel ma' xkisach ta wach i tinamit</para>
  <para style="q">xq'orarik keh ruum i QaJaaw Dios.</para>
  <para style="q">
    <verse number="35" style="v" />Xkian la' jinaj kiwach kuuk' taqe i kiloq'inik reh i tiyoox.</para>
  <para style="q">Eh xkitijej keh inki a'n i keh.</para>
  <para style="q">
    <verse number="36" style="v" />Eh ruum chi xkiloq'ej keh i</para>
  <para style="q">kitiyoox xsacharik kiwach.</para>
  <para style="q">
    <verse number="37" style="v" />Wilik i kak'uun kixq'uun xkiyeew chi kimayiij chikiwach i ma' tob'laj uxlab'al.</para>
  <para style="q">
    <verse number="38" style="v" />Re' taqe kak'uun kixq'uun xkikansaj i ma' xta kimahk.</para>
  <para style="q">Eh re' kikik'eel xkiyeew chi kimayiij</para>
  <para style="q">chuwach taqe i tiyoox inkiloq'ej i aj Canaán.</para>
  <para style="q">Ruuk' i xkian re' re' xkinih chu'nchel i wach ak'al.</para>
  <para style="q">
    <verse number="39" style="v" />Eh je' wo' keh xkinih wo' kiib'. Je' naa jinaj runimaal k'oyomal i xkian,</para>
  <para style="q">ruum xkiq'eb' i k'achlik Dios ruum i kiyiib' wach na'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" />Eh re' i QaJaaw Dios ma' k'isiin ta noq chalik rujosq'iil chikinaah i rutinamiit,</para>
  <para style="q">xuq'eb' taqe chi riij ruk'ux.</para>
  <para style="q">
    <verse number="41" style="v" />Xuq'eb' taqe pan kiq'ab' i kiloq'inik reh i tiyoox.</para>
  <para style="q">Eh xuyeew q'ab' chi xq'atarik kiwach kuum taqe i nixowanik kiwach.</para>
  <para style="q">
    <verse number="42" style="v" />Re' taqe aj Israel xq'atarik kiwach kuum i aj ixowaal.</para>
  <para style="q">Re' chik taqe i aj ixowaal xi kahnik chi taaq'anik chikinaah.</para>
  <para style="q">
    <verse number="43" style="v" />Re' Dios k'ih pech xuko'leej taqe,</para>
  <para style="q">eh re' keh ma' xkinimaj taj i xq'orarik keh.</para>
  <para style="q">Re' chik xkichop kik'ux chub'aan i kiyiib' wach na'ojb'al i keh.</para>
  <para style="q">
    <verse number="44" style="v" />Ma' re' ta nkiwii' chi je' re' i xkian, noq xrilow i Dios chi q'e' ti' wilkeeb',</para>
  <para style="q">eh noq xrib'iraj i koq'iim.</para>
  <para style="q">
    <verse number="45" style="v" />Re' reh xk'ulik cho paruk'ux i ruq'orom cho keh</para>
  <para style="q">chi naa rub'anam kuuk' xujal wach i rukapeew ruum xiik' naah i ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="46" style="v" />Eh xuch'ub'isaj i kánima taqe i nixowanik kiwach i rutinamiit.</para>
  <para style="q">Reh chi ma' xta chik xi uchjik i keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="47" style="v" />Jaaw hat qaDios, qoh ako'leej tii.</para>
  <para style="q">Qoh awisaj cho chi kixilak i tinamit yiib' wach i kina'ojb'al</para>
  <para style="q">reh chi neenqaloq'ej i santo laj ab'ihnaal.</para>
  <para style="q">Reh chi suq qak'ux noq neetiqaloq'eej.</para>
  <para style="b" />
  <para style="q">
    <verse number="48" style="v" />Qayeew ta naq ruloq'il i QaJaaw Dios chi juneliik,</para>
  <para style="q">re' qaDios i hoj, hoj aj Israel.</para>
  <para style="q">Je' ta naq re' inko'q ta naq taqe i tinamit chi kunchelaal. Loq'imaj ta naq i QaJaaw.</para>
  <chapter number="107" style="c" />
  <para style="s">Re' Dios i ruko'leej taqe rutinamiit chuwach i ti' k'axik</para>
  <para style="q">
    <verse number="1" style="v" />Chaloq'ej taq i QaJaaw Dios ruum re' reh xiik' naah i rotob'il.</para>
  <para style="q">Eh q'e' aj keteloom wachiis chi juneliik.</para>
  <para style="q">
    <verse number="2" style="v" />Eh nee ta naq inlooq'jik i QaJaaw kuum i xuko'leej taqe.</para>
  <para style="q">Re' taqe i xuko'leej pan kiq'ab' inixowanik kiwach.</para>
  <para style="q">
    <verse number="3" style="v" />Re' taqe i xumol cho kiwach chinaah i wach ak'al.</para>
  <para style="q">Chi je' parelb'aal q'iij, chi je' parookb'aal q'iij,</para>
  <para style="q">chi je' pantz'eet ree rookb'aal q'iij</para>
  <para style="q">chi je' pansak'aaj ree rookb'aal i q'iij xi chalik.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh xisahchik cho panchiq yuuq',</para>
  <para style="q">ma' nkireq ta naq chik i kib'eeh.</para>
  <para style="q">Eh ni xata naq inkireq jino'q i tinamit naakipatiniik.</para>
  <para style="q">
    <verse number="5" style="v" />Xkikuy cho kiwa' kihaa'.</para>
  <para style="q">Xa kimik naq chik keh.</para>
  <para style="q">
    <verse number="6" style="v" />Eh noq ti' kik'ux xkipahqaaj i rotob'il i QaJaaw Dios</para>
  <para style="q">xa re' chik i reh x-eesanik keh chupaam ti' k'axik.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' xub'esaj taqe chaloq chupaam i korik laj b'eeh,</para>
  <para style="q">reh chi xi chalik chupaam jinaj i tinamit xi patinik wii'.</para>
  <para style="q">
    <verse number="8" style="v" />Chaloq'ej taq i QaJaaw Dios,</para>
  <para style="q">ruum re' reh q'e' aj keteloom wachiis, eh i rub'an otob'il keh i tinamit.</para>
  <para style="q">
    <verse number="9" style="v" />Ruum re' reh i ruket taqe i kimik keh ruum kiwa'.</para>
  <para style="q">Eh irik'saj i kichiqchi'iil taqe i chiqiij kichii'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' keh panq'equm naq wilkeeb' xakimik naq chik keh ruum i ti' k'axik.</para>
  <para style="q">Je' naq b'ak'alkeeb' chi karena, je' naq pantz'ilom wilkeeb'.</para>
  <para style="q">
    <verse number="11" style="v" />Je' re' xkik'ul ruum xkiq'etwachej i QaJaaw Dios.</para>
  <para style="q">Eh ma' xponik ta chikiwach i kik'uhb'aljiik</para>
  <para style="q">xb'aan ruum i QaJaaw Dios wilik cho pan taxaaj.</para>
  <para style="q">
    <verse number="12" style="v" />Re' i QaJaaw Dios, xuyeew taqe chutojariik i kimahk pankowlaj kamanik.</para>
  <para style="q">Eh noq kiq'ehb'ik wach ak'al ma' awach ta chik imb'anik otob'il keh.</para>
  <para style="q">
    <verse number="13" style="v" />Eh noq ti' i kik'ux xkipahqaaj i rotob'il i QaJaaw Dios,</para>
  <para style="q">xa re' chik i reh x-eesanik keh chupaam.</para>
  <para style="q">
    <verse number="14" style="v" />Xresaj taqe chaloq chupaam i q'equm aha' xakimik naq chik keh,</para>
  <para style="q">eh xuchej kiwach.</para>
  <para style="q">
    <verse number="15" style="v" />Chaloq'ej taq i QaJaaw Dios ruum re' reh q'e' aj keteloom wachiis.</para>
  <para style="q">Eh i rub'an otob'il keh i tinamit.</para>
  <para style="q">
    <verse number="16" style="v" />Xuxereb'eej i puerta re' ruuk' i q'an ch'ihch'.</para>
  <para style="q">Xutoqib'eej i b'olob'aq ch'ihch' noq xuko'leej taqe i rutinamiit.</para>
  <para style="q">
    <verse number="17" style="v" />Re' keh xa yowaab' naq chik taqe,</para>
  <para style="q">xa ntz'irik naq chik kiwach ruum i kiyiib' wach na'ojb'al,</para>
  <para style="q">ruum i kimahk.</para>
  <para style="q">
    <verse number="18" style="v" />Eh xama' ruq'or ta naq chik kik'ux i wi'k.</para>
  <para style="q">Ruum i re' xi ponik nah kimik.</para>
  <para style="q">
    <verse number="19" style="v" />Eh noq ti' kik'ux xkipahqaaj i rotob'il i QaJaaw Dios,</para>
  <para style="q">xa re' chik i reh x-eesanik keh chupaam ti' k'axik.</para>
  <para style="q">
    <verse number="20" style="v" />Xa ruuk' i ruq'oral xuk'achrisaj taqe.</para>
  <para style="q">Eh xuko'leej taqe chuwach i kimik.</para>
  <para style="q">
    <verse number="21" style="v" />Je' re' noq chaloq'ej taq i QaJaaw Dios,</para>
  <para style="q">ruum re' reh aj keteloom wachiis, eh i rub'an otob'il keh i tinamit.</para>
  <para style="q">
    <verse number="22" style="v" />Chayeew taq amayiij chuwach i QaJaaw Dios, t'iosb'al reh i rotob'il.</para>
  <para style="q">Eh ruuk' suq kiil k'uxliis cha q'or taq rib'iral taqe i rub'anam chaloq re' re'.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Re' taqe yakool xa k'ahchi' keeb' chi b'ehik pan barco chinaah i palaw,</para>
  <para style="q">inkikoj rehtaal chi korik nik' wach noq wilkeeb' taqe ha'.</para>
  <para style="q">
    <verse number="24" style="v" />Eh noq inkilow i runimaal, i ruchamiil i palaw inkikoj rehtaal</para>
  <para style="q">chi re' i QaJaaw Dios xyej-anik reh ruuk' i runimaal i rajaawriik.</para>
  <para style="q">
    <verse number="25" style="v" />Ruum xa ruuk' i ruq'oral i QaJaaw Dios xwuktik chaloq i runimaal teew jab'.</para>
  <para style="q">Eh yohb'aal wach taqe i rub'ohl i palaw i ruksaj.</para>
  <para style="q">
    <verse number="26" style="v" />Eh re' ki barco xa nkutarik chik taxaaj, wilik pech noq inooj qohoq ri'si haa'.</para>
  <para style="q">Re' keh xakib'arb'otik chik ruum kiyo'jiik.</para>
  <para style="q">
    <verse number="27" style="v" />Eh xa kichelchotik chik kiq'ehb'ik xa je' chik taqe xohk'reel.</para>
  <para style="q">Xa ma' keht'al ta chik inki a'n</para>
  <para style="q">
    <verse number="28" style="v" />Eh noq ti' kik'ux xkipahqaaj i rotob'il i QaJaaw Dios,</para>
  <para style="q">xa re' chik i reh x-eesanik keh chupaam ti' k'axik.</para>
  <para style="q">
    <verse number="29" style="v" />Re' reh xusutej chi xa kok' musjab' i runimaal teew jab',</para>
  <para style="q">eh xupab'aa' taqe i rub'ohl i palaw.</para>
  <para style="q">
    <verse number="30" style="v" />Eh noq xkilow chi xipa'lojik taqe i rub'ohl i palaw xsuuqb'ik kik'ux.</para>
  <para style="q">Xik'amarik reje ruum i Dios ko aha' impa'lojik wii' i barco.</para>
  <para style="q">
    <verse number="31" style="v" />Chaloq'ej taq i QaJaaw Dios ruum re' reh q'e' aj keteloom wachiis.</para>
  <para style="q">Eh i rub'an otob'il keh i tinamit.</para>
  <para style="q">
    <verse number="32" style="v" />Chayeew taq runimaal wach i QaJaaw Dios noq naa taq amolom awiib'.</para>
  <para style="q">Chaloq'ej taq noq neenkimol kiib' taqe i nimaq wach kikamaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" />Re' QaJaaw Dios nim rajaawriik, ruum i ruchiqsaj taqe nim ha'.</para>
  <para style="q">Eh i ruchiqsaj wo' taqe i raasb'al ha'.</para>
  <para style="q">
    <verse number="34" style="v" />Eh i resaj iransil aak'al reh chi ma' nwachinik ta chik taqe i tik,</para>
  <para style="q">ruum q'e' yiib' wach i kina'ojb'al i k'achareel wach ak'al.</para>
  <para style="q">
    <verse number="35" style="v" />Re' QaJaaw Dios i rusutej chi nim ha' i ye'aab' chiq yuuq'.</para>
  <para style="q">Eh re' i chiqiij pam aak'al i rusutej chi raasb'al ha'.</para>
  <para style="q">
    <verse number="36" style="v" />Chupaam i ye'aab' re' re', i ruyeew taqe i ma' xta kiwa' kihaa'.</para>
  <para style="q">Eh ar inkiyejaa' kitinamiit kiwihik wii'.</para>
  <para style="q">
    <verse number="37" style="v" />Eh chupaam i ye'aab' re' re' inkitik chib'ih keh, inkitik ki uuva,</para>
  <para style="q">eh ma' k'isiin tanwachinik.</para>
  <para style="q">
    <verse number="38" style="v" />Kikuxeesjik ruum i QaJaaw Dios, ma' k'isiin ta ink'ihaaxb'ik taqe i kak'uun kixq'uun.</para>
  <para style="q">Eh ink'ihaaxb'ik taqe i kichikoop.</para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" />Noq imb'aan keh i ma' k'isa ti' k'axik</para>
  <para style="q">kuum i aj ixowaal insuhb'ik wo' chik rooq</para>
  <para style="q">i kik'ihaal, ruum wilik i kikimik.</para>
  <para style="q">
    <verse number="40" style="v" />Eh re' QaJaaw Dios i rub'an ti' k'axik keh</para>
  <para style="q">ma' raaj ta kiwach inixowanik kiwach i rutinamiit.</para>
  <para style="q">Eh re' taqe i k'amal kib'eeh xusach kik'ux, xama' nkireq ta chik kib'eeh.</para>
  <para style="q">
    <verse number="41" style="v" />Re' QaJaaw Dios i ruko'leej taqe i ti' wilkeeb'.</para>
  <para style="q">Eh i ruk'ihaaxb'isaj i kak'uun kixq'uun.</para>
  <para style="q">Je' rukab' noq kik'ihaaxb'iik taqe i tentzun.</para>
  <para style="q">
    <verse number="42" style="v" />Eh noq inkilow chi je' re' taqe i korik wach kik'ux, insuuqb'ik kik'ux.</para>
  <para style="q">Eh re' taqe yiib' wach kina'ojb'al intz'aplojik i kichii'.</para>
  <para style="q">
    <verse number="43" style="v" />Awach i wilik runa'ojb'al nee rukoj rehtaal taqe wili.</para>
  <para style="q">Eh nee rureq chi riij chi re' QaJaaw wilik ketelinik wachiis ruuk'.</para>
  <chapter number="108" style="c" />
  <para style="s">Re' hin nuchopom nuk'ux chulooq'jiik i Dios</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, re' hin nuye'em nuk'ux awuuk', naa nutz'uyem awach.</para>
  <para style="q">Re' re' i q'e' looq' chi wee hin.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin naawik'raam wiib' noq naa rusaq'iik,</para>
  <para style="q">naa nutz'uyem awach ruuk' i k'ahaam wach q'ooj, ruuk' i warpa.</para>
  <para style="q">
    <verse number="3" style="v" />Eh naa kaat nuloq'em chikiwach i tinamit QaJaaw Dios.</para>
  <para style="q">Eh naa nuye'em runimaal awach ruuk' i nutz'uuy chikiwach chu'nchel i tinamit.</para>
  <para style="q">
    <verse number="4" style="v" />Ruum re' ketelinik wachiis i na a'n, imponik kopan taxaaj.</para>
  <para style="q">Eh re' rukorkiil wach ak'ux, imponik kopan taxaaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios, nee ta naq nak'uhtaaj i runimaal awajaawriik ar pan taxaaj.</para>
  <para style="q">Eh nee ta wo' naq inye'arik aloq'il chinaah chu'nchel i wach ak'al.</para>
  <para style="q">
    <verse number="6" style="v" />QaJaaw Dios, qoh ab'iraj tii. Eh qoh ako'leej ruuk' awajaawriik,</para>
  <para style="q">chawisaj taqe cho panti' k'axik taqe i q'e' nak'ax.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' QaJaaw je' wili i ruq'or parusantolaj ye'aab':</para>
  <para style="q">Re' hin naa rusuuqb'iik nuk'ux noq naa nuch'aqam i ye'aab' Siquem,</para>
  <para style="q">noq naa nupajam i wach k'ixkaab' Sucot.</para>
  <para style="q">
    <verse number="8" style="v" />Re' ye'aab' Galaad, i Manasés, wehin taqe.</para>
  <para style="q">Re' ye'aab' Efraín je' naa nupuneet wach i nunaah.</para>
  <para style="q">Eh re' i ye'aab' Judá je' naa nukarote noq wilik.</para>
  <para style="q">
    <verse number="9" style="v" />Eh re' ye'aab' Moab je' jino'q johm ye'aab' tz'ajb'al q'ab'iis chi weh.</para>
  <para style="q">Re' ye'aab' Edom, naa nuyeq'em pan wooq,</para>
  <para style="q">naa rusuuqb'iik nuk'ux noq naa nuq'atam kiwach i aj filisteo, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />QaJaaw Dios ¿awach naa ruk'amwiik reje weh chupaam i tinamit kow riib'?</para>
  <para style="q">¿Awach naa ruk'amwiik reje weh ar Edom?</para>
  <para style="q">
    <verse number="11" style="v" />QaJaaw Dios ¿Mi xoj aq'eb' chi jumpech re'?</para>
  <para style="q">¿Mi ma' nee wo' naq chik i rub'an chi re' hat nee ti k'amwik reje qeh panq'aq'inik re'?</para>
  <para style="q">
    <verse number="12" style="v" />Eh qoh ako'leej pan kiq'ab' i ki-ixowanik qawach,</para>
  <para style="q">ruum re' i ko'linik inki a'n i xa winaq xama' xta nokik wii'.</para>
  <para style="q">
    <verse number="13" style="v" />Re' QaJaaw Dios naa rutoob'iniik qeh,</para>
  <para style="q">reh chi ma' xta nee qoh kuchej i ki-ixowanik qawach.</para>
  <chapter number="109" style="c" />
  <para style="s">Re' i rupahqaljiik chi naa ruq'atariik i q'orik chinaah i aj ixowaal</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, re' hin i nuyeew aloq'il,</para>
  <para style="q">chayeew tii weh i nupahqaaj aweh.</para>
  <para style="q">
    <verse number="2" style="v" />Re' taqe yiib' wach kina'ojb'al</para>
  <para style="q">ma' k'isiin i chukuj q'orik inki a'n chi wiij.</para>
  <para style="q">Eh re' inkiq'or chi wiij ma' korik ta wo' hoq.</para>
  <para style="q">
    <verse number="3" style="v" />Eh xa re' i nu bajariik inki a'n</para>
  <para style="q">xama' xta rub'ehel noq inki a'n i peleto wuuk'.</para>
  <para style="q">
    <verse number="4" style="v" />Re' i kik'axariik i nub'an peleto chik inkiq'aj wii' wach weh.</para>
  <para style="q">Eh re' hin xa tiij i nub'an chikiij.</para>
  <para style="q">
    <verse number="5" style="v" />Eh re' otob'il i nub'an keh, ti' k'axik chik inki a'n weh chi jilow.</para>
  <para style="q">Re' i kik'axarik i nub'an wixowjiik chik inki a'n chi riij.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Eh chinaah i aj ixowaal re' re',</para>
  <para style="q">nee ta naq inakoj jino'q i yiib' wach i runa'ojb'al chi q'ataj q'orik chinaah.</para>
  <para style="q">
    <verse number="7" style="v" />Noq nee ruq'at i q'orik chinaah nee ta naq i ruq'or chi wilik ru mahk.</para>
  <para style="q">Eh nee ta naq inye'arik chutojariik i ru mahk.</para>
  <para style="q">
    <verse number="8" style="v" />Ma' ta naq najt neenk'acharik,</para>
  <para style="q">tokoom ta chik neenchopwik naah taqe i chib'ih reh.</para>
  <para style="q">
    <verse number="9" style="v" />Eh nee ta naq i ruq'eb' kahnoq i rehk'een,</para>
  <para style="q">je' wo' taqe i rak'uun rixq'uun.</para>
  <para style="q">
    <verse number="10" style="v" />Neeta naq kiooj i rak'uun rixq'uun chi' taq paat chupahqaljiik chib'ih inkaaj.</para>
  <para style="q">Eh re' i kipaat nee ta naq inkahnik chi xan tz'irik chik paam.</para>
  <para style="q">
    <verse number="11" style="v" />Eh re' ta naq taqe i aj kemeel neekik'amwik i chib'ih reh.</para>
  <para style="q">Eh tokoom ta chik neemb'anik rusuqkiil i rukamaj.</para>
  <para style="q">
    <verse number="12" style="v" />Ma' ta naq awach chik neen ketelinik wach i reh,</para>
  <para style="q">je' wo' taqe i rak'uun rixq'uun naa ruq'eb'em kahnoq.</para>
  <para style="q">
    <verse number="13" style="v" />Neeta naq inkuxik reje kikimiik taqe i rak'uun rixq'uun.</para>
  <para style="q">Eh nee ta naq insahchik wach i kib'ihnaal chi jumpech.</para>
  <para style="q">
    <verse number="14" style="v" />Eh eliik ta naq wilik paruk'ux i QaJaaw Dios taqe mahk rub'anam chaloq i kajaaw.</para>
  <para style="q">Ma' ta neensahchik paruk'ux i QaJaaw i ru mahk kituut.</para>
  <para style="q">
    <verse number="15" style="v" />Wilik ta naq paruk'ux i QaJaaw Dios i yiib' wach inki a'n</para>
  <para style="q">Ma' ta naq chik neen q'orarik i kib'ihnaal chinaah i wach ak'al.</para>
  <para style="q">
    <verse number="16" style="v" />Re' aj ixowaal re' re' ma' nik' ta xuketelaaj</para>
  <para style="q">cho kiwach i k'axik wilkeeb'</para>
  <para style="q">ruch'ihil taqe xama' nimaq ta kiwach</para>
  <para style="q">inki a'n kiib', ruch'ihil taqe i ti' kik'ux.</para>
  <para style="q">Xub'an la' k'axik keh korehtaal xukansaj taqe.</para>
  <para style="q">
    <verse number="17" style="v" />Eh ruum chi xub'an i ti' k'axik keh</para>
  <para style="q">i ras ruch'aaq' i reh, naa wo' rub'aan ti' k'axik ree reh.</para>
  <para style="q">Eh ruum chi ma' xub'an taj i otob'il i reh,</para>
  <para style="q">ma' naa ta wo' rub'aan otob'il ree reh.</para>
  <para style="q">
    <verse number="18" style="v" />Re' ti' k'axik nee ruk'ul,</para>
  <para style="q">nee ta naq nkahnik chi je' ruso'.</para>
  <para style="q">Eh nee ta naq inokik chi je' ha' chi je' aseite chupaam i ruti'jolal, i rub'aqil.</para>
  <para style="q">
    <verse number="19" style="v" />Xa re' ta naq chik i ti' k'axik nee ruk'ul, nee ta naq inkahnik chi je' ruso',</para>
  <para style="q">eh nee ta naq inkahnik chi je' rusincho.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />QaJaaw Dios je' ta naq re' ruq'ajariik wach neena a'n keh i ki-ixowanik nuwach.</para>
  <para style="q">Je' wo' taqe i ma' holohik ta kiq'orik chi wiij.</para>
  <para style="q">
    <verse number="21" style="v" />Raaj i hat QaJaaw Dios,</para>
  <para style="q">ruum chi q'e' tik'axwik kinatoob'eej tii.</para>
  <para style="q">Eh kinako'leej panti' k'axik ruum q'e' hat aj keteloom wachiis.</para>
  <para style="q">
    <verse number="22" style="v" />Ruum re' hin q'e' ti' wilkiin, q'e' ntz'irik nuwach,</para>
  <para style="q">ma' k'isiin ta nyot'ik i wánima.</para>
  <para style="q">
    <verse number="23" style="v" />Re' nuk'achariik k'ahchi' rusahchiik wach, xa je' nik'ik q'equm.</para>
  <para style="q">Eh xa je' rukab' noq kik'amarik reje i chili'l ruum i teew.</para>
  <para style="q">
    <verse number="24" style="v" />Eh ruum chi ma' nub'an ta chik nuwa' nuhaa',</para>
  <para style="q">xakib'arb'otik chik i pan waa', eh xab'aaq chik.</para>
  <para style="q">
    <verse number="25" style="v" />Noq inkilow nuwach i tinamit,</para>
  <para style="q">hin kib'ajb'al inkik'uyu'saj i kinaah</para>
  <para style="q">kinki kaq se'laaj chii naa rub'anam i re', inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />WaJaaw hat nuDios, kinako'leej tii.</para>
  <para style="q">Chaketelaaj nuwach.</para>
  <para style="q">
    <verse number="27" style="v" />Reh chi re' taqe i ki-ixowanik nuwach neenkikoj rehtaal</para>
  <para style="q">chi ruuk' awajaawriik xa a'n taqe re'.</para>
  <para style="q">
    <verse number="28" style="v" />Re' hin weht'al chi re' hat naa atoob'iniik weh,</para>
  <para style="q">re' keh neenchalik kik'ixiik ruuk' inki a'n</para>
  <para style="q">Eh re' hin amoso neensuuqb'ik nuk'ux.</para>
  <para style="q">
    <verse number="29" style="v" />Neeta naq insahchik kik'ux i ki-ixowanik</para>
  <para style="q">nuwach. Eh nee ta naq inkik'uhtaaj kik'ixb'ilaal.</para>
  <para style="q">Neeta naq inkojarik chi je' kib'urb'aal.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Re' hin naa nut'iosem ruuk' nuchii' reh i Dios i rotob'il.</para>
  <para style="q">Eh naa nuloq'em, chi kixilak i ruk'ihaal tinamit.</para>
  <para style="q">
    <verse number="31" style="v" />Ruum re' reh imb'anik otob'il reh i ti' wilik,</para>
  <para style="q">eh re' wo' reh inko'linik reh pan kiq'ab' i kikojwik ru mahk.</para>
  <chapter number="110" style="c" />
  <para style="s">Re' QaJaaw Dios xuyeew rajaawriik i xti manlik reey</para>
  <para style="q">
    <verse number="1" style="v" />Re' QaJaaw Dios je' wili i xuq'or reh i waJaaw:</para>
  <para style="q">Re' hat ti tzuun panusak'aaj,</para>
  <para style="q">re' hin korehtaal i nuyeew taqe pana wooq</para>
  <para style="q">i ki-ixowanik awach inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw Dios ko ar Sión xuyeew cha wajaawriik</para>
  <para style="q">chi je' karote.</para>
  <para style="q">Reh chi re' chik i hat naa aa taaq'anik chikinaah i ki-ixowanik awach.</para>
  <para style="q">
    <verse number="3" style="v" />Eh re' aatinamiit xa pankik'ux naa ruchaliik</para>
  <para style="q">noq naa kiq'asam kiib' aweh chupaam asantolaj ye'aab'.</para>
  <para style="q">Eh naa ruwihiik akowiil chi je' jino'q ak'un,</para>
  <para style="q">je' rukab' noq inqajik chaloq i raab' suutz' pantaq wahq'eq.</para>
  <para style="q">
    <verse number="4" style="v" />Re' QaJaaw Dios xuq'or i xti korik chi je' wili reh i rak'uun:</para>
  <para style="q">Re' hat naa akahniik chi hat</para>
  <para style="q">kajaaw i k'amal kib'eeh aj tiij chi juneliik,</para>
  <para style="q">je' rukab' noq xwihik chaloq i Melquisedec, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' QaJaaw Dios naa ruwihiik panasak'aaj cha toob'jiik,</para>
  <para style="q">paruq'ijil i rujosq'iil, na' chusach kiwach i reey.</para>
  <para style="q">
    <verse number="6" style="v" />Re' reh naa ruq'atwiik i q'orik chikinaah tinamit,</para>
  <para style="q">eh i naa rukansam taqe. Eh naa rukahniik chi kutlik</para>
  <para style="q">i kiti'jolal chi junsuut i wach ak'al.</para>
  <para style="q">
    <verse number="7" style="v" />Re' reh naa naq ruq'uhtiik xa re' la' naa wo' chik ruk'uliik raansil ruum</para>
  <para style="q">naa ruk'em ruhaa' paraasb'al ha'.</para>
  <chapter number="111" style="c" />
  <para style="s">Re' ruye'ariik ruloq'il i QaJaaw Dios ruum otob'il xub'an</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin naa nuye'em ruloq'il i QaJaaw Dios chu'nchel i wánima</para>
  <para style="q">noq naa qamolom qiib' kuuk' chu'nchel i korik wach kik'ux.</para>
  <para style="q">
    <verse number="2" style="v" />Re' taqe i xub'an i QaJaaw Dios xiik' naah loq'il,</para>
  <para style="q">eh awach taqe imponik chikiwach inchol kitijem riij.</para>
  <para style="q">
    <verse number="3" style="v" />Re' taqe i xub'an xiik' naah holwochiil, eh q'e' looq'.</para>
  <para style="q">Re' rukorkiil wach ruk'ux ma' jaruuj naa rusahchiik wach.</para>
  <para style="q">
    <verse number="4" style="v" />Eh ma' jaruuj naa rusahchiik pank'uxliis taqe i ma' ilooj taj xub'an.</para>
  <para style="q">Re' QaJaaw Dios q'e' atoob', eh q'e' aj keteloom wachiis.</para>
  <para style="q">
    <verse number="5" style="v" />Ruum i ruyeew kiwa' kihaa' taqe i kiyohlinik reh.</para>
  <para style="q">Eh ma' insahchik ta paruk'ux i ruyejaam cho wach kuuk'.</para>
  <para style="q">
    <verse number="6" style="v" />Re' i rajaawriik xuk'uhtaaj keh i rutinamiit</para>
  <para style="q">noq xuyeew keh i ye'aab' kichopom naq naah i tinamit ma' re' ta taqe aj nimaneel.</para>
  <para style="q">
    <verse number="7" style="v" />Eh aha' wilik taqe i rub'an i reh, rub'ehel,</para>
  <para style="q">eh chu'nchel i ruq'or i ruk'uhb'aal korik wo' hoq.</para>
  <para style="q">
    <verse number="8" style="v" />Eh ma' naa ta ruyojiik wach i ruk'uhb'aal, naa la' ruwihiik chi juneliik.</para>
  <para style="q">Ruum re' re' rub'ehel, eh korik.</para>
  <para style="q">
    <verse number="9" style="v" />Re' QaJaaw Dios xresaj taqe chaloq panti' k'axik i rutinamiit,</para>
  <para style="q">eh xuyejaa' wach kuuk' i naa rub'anam.</para>
  <para style="q">Re' Dios Santo, xiik' naah yohb'alil wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Eh re' raa' ri'sil i na'ojb'al re' i ruyohljiik wach i Dios.</para>
  <para style="q">Ruum aj re', holohik kina'ojb'al awach inkik'am naah taqe i ruq'or i ruk'uhb'aal.</para>
  <para style="q">Ruuk' ta naq i re' neenye'arik ruloq'il chi juneliik i QaJaaw Dios.</para>
  <chapter number="112" style="c" />
  <para style="s">Re' i ruyohleej i Dios i nelik korik ruuk' taqe i rub'an</para>
  <para style="q">
    <verse number="1" style="v" />Atoob' reh awach i ruyohleej wach i QaJaaw Dios.</para>
  <para style="q">Eh i ruyeew ruk'ux chub'anariik taqe i ruq'or i ruk'uhb'aal.</para>
  <para style="q">
    <verse number="2" style="v" />Re' taqe i rak'uun rixq'uun i korik wach ruk'ux,</para>
  <para style="q">naa ruye'ariik kajawriik ayu' wach ak'al, eh naakikuxesjiik.</para>
  <para style="q">
    <verse number="3" style="v" />Re' korik wach ruk'ux naa ruwihiik chib'ih reh parupaat,</para>
  <para style="q">eh eliik naa rub'anam otob'il keh i tokoom.</para>
  <para style="q">
    <verse number="4" style="v" />Re' Dios i rusaquumb'isaj i runa'ojb'al</para>
  <para style="q">i korik wach rik'ux, q'e' atoob' keteloom wachiis.</para>
  <para style="q">
    <verse number="5" style="v" />Re' i holohik runa'ojb'al wilik ketelinik</para>
  <para style="q">wachiis ruuk', i ruyeew chi kemeel i chib'ih reh.</para>
  <para style="q">Eh parub'ehel i rub'an i ruyak.</para>
  <para style="q">
    <verse number="6" style="v" />Eh ma' jaruuj naa rojiik chik chi riij,</para>
  <para style="q">juneliik naa ruk'uliik pank'uxliis taqe i rub'an.</para>
  <para style="q">
    <verse number="7" style="v" />Eh ma' naa ta ruyo'jiik ruum i ma' holohik taj inq'orarik chi riij ruum</para>
  <para style="q">ruuk' i QaJaaw Dios ch'iklik ruk'ux.</para>
  <para style="q">
    <verse number="8" style="v" />Re' reh kow ruk'ux ma' inyo'jik taj</para>
  <para style="q">xaruse'laj taqe i ki-ixowanik wach.</para>
  <para style="q">
    <verse number="9" style="v" />Eh i runej taqe neb'aa' i chib'ih reh,</para>
  <para style="q">korik wach ruk'ux chi juneliik,</para>
  <para style="q">naa ruye'ariik ruloq'il i rajaawriik.</para>
  <para style="q">
    <verse number="10" style="v" />Eh noq naakilom chi je' re' i yiib' wach kina'ojb'al</para>
  <para style="q">naa ruchaliik kik'aah chinaah, naakiqirich'eem naah i keeh.</para>
  <para style="q">Eh re' i naa kianam i keh ma' naa ta keliik korik ruuk'.</para>
  <chapter number="113" style="c" />
  <para style="s">Re' ruye'ariik ruloq'il i QaJaaw Dios ruum i rotob'il</para>
  <para style="q">
    <verse number="1" style="v" />Loq'imaj ta naq i QaJaaw Dios. Re' taq i hat raj kamanoom,</para>
  <para style="q">chayeew taq ruloq'il i rub'ihnaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Eh nee ta naq inye'arik ruloq'il i rub'ihnaal i QaJaaw Dios,</para>
  <para style="q">je' yu'naak, je' chi juneliik.</para>
  <para style="q">
    <verse number="3" style="v" />Chu'nchel ta naq i tinamit neen ye'wik ruloq'il i QaJaaw,</para>
  <para style="q">chi je' wilkeeb' parelb'aal q'iij, chi je' wilkeeb' parookb'aal q'iij.</para>
  <para style="q">
    <verse number="4" style="v" />Re' QaJaaw Dios wilik rajaawriik chinaah chu'nchel i tinamit.</para>
  <para style="q">Eh xiik' naah i ruloq'il ar pan taxaaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' QaJaaw Dios wilik cho chi taaq'anik pan taxaaj,</para>
  <para style="q">ma' awach ta chik jino'q chi je' rukab' i reh.</para>
  <para style="q">
    <verse number="6" style="v" />Re' reh i ruloch' riib' chi rilariik i wach ak'al,</para>
  <para style="q">je' wo' chi rilariik i pan taxaaj.</para>
  <para style="q">
    <verse number="7" style="v" />Re' QaJaaw Dios i ruyeew runimaal kiwach i neb'aa',</para>
  <para style="q">eh irutoob'eej taqe i ma' xta wilik keh.</para>
  <para style="q">
    <verse number="8" style="v" />Reh chi rukoj taqe haa' chi kixilak i wilik kajaawriik,</para>
  <para style="q">je' wo' chi kixilak i rutinamiit wilik kajaawriik.</para>
  <para style="q">
    <verse number="9" style="v" />Eh re' ixoq ma' re' ta aj k'isoom i ruyeew rusuqkiil ruk'ux,</para>
  <para style="q">ruum i ruyeew taqe rak'uun rixq'uun.</para>
  <para style="b" />
  <para style="q">Loq'imaj ta naq i QaJaaw Dios.</para>
  <chapter number="114" style="c" />
  <para style="s">Re' ruq'orariik rib'iral i keliik chaloq i aj Israel ar Egipto</para>
  <para style="q">
    <verse number="1" style="v" />Eh noq xi elik chaloq i aj Israel re' taqe rak'uun rixq'uun i Jacob ar Egipto,</para>
  <para style="q">re' tokoom tinamit naq wilkeeb' cho wii'.</para>
  <para style="q">
    <verse number="2" style="v" />Re' i QaJaaw Dios xwihik rajaawriik chikinaah i aj Israel.</para>
  <para style="q">Eh pan tinamit Judá xkiyejaa' i rupaat.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh noq xi ponik i aj Israel chi chii' i palaw xchiqik.</para>
  <para style="q">Noq xi ponik chi chii' i nim ha' Jordán xpa'lojik i rooq.</para>
  <para style="q">
    <verse number="4" style="v" />Re' taqe yuuq' k'ixkaab' xa je' chik kipisk'anik imas tentzun,</para>
  <para style="q">je' kipisk'anik kok' tentzun.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Raaj i hat palaw ¿Chib'ih reet noq</para>
  <para style="q">xatchiqik noq xi-ik'ik i aj Israel?</para>
  <para style="q">Raaj i hat nim ha' Jordán ¿Chib'ih reet noq xatpah-ik?</para>
  <para style="q">
    <verse number="6" style="v" />Eh raaj taq i hat yuuq k'ixkaab', ¿Chib'ih reet noq</para>
  <para style="q">xa je' taq chik tipisk'anik imas tentzun,</para>
  <para style="q">eh je' taq tipisk'anik kok' tentzun?</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' QaJaaw, i ruDios i Jacob xiik' naah nimaal rajaawriik,</para>
  <para style="q">ruum aj re' ink'uyu'jik paruye'aab' chu'nchel i wach ak'al chuwach.</para>
  <para style="q">
    <verse number="8" style="v" />Re' i QaJaaw Dios xusutej chi raasb'al ha' i chiq yuuq'.</para>
  <para style="q">Eh xutz'uhkrisaj chaloq i nim ha' chupaam i saq rehp ab'aj.</para>
  <chapter number="115" style="c" />
  <para style="s">Re' i k'achlik Dios wilik rajaawriik, re' taqe i tiyoox ma' xta kajaawriik</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios,</para>
  <para style="q">re' la' hat naa ruye'ariik aloq'il ma' re' tee hoj.</para>
  <para style="q">Ruum xa re' wo' hat tiketelinik qawach, eh xa re' wo' hat i korik.</para>
  <para style="q">
    <verse number="2" style="v" />Eh ¿Chib'ih reet noq inkiq'or i tinamit chi je' wili?</para>
  <para style="q">¿Aha' wilik i ki Dios re'? inki taqe chiqiij.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Xanaah re', re' i qaDios i hoj pan taxaaj wilik,</para>
  <para style="q">chu'nchel i xraaj ruyejaam i reh xuyejaa' wo' chaloq.</para>
  <para style="q">
    <verse number="4" style="v" />Eh re' ki dios i tinamit re' re',</para>
  <para style="q">xa plata, xa oro kiyej-aal, eh xa kiyej-anik winaq.</para>
  <para style="q">
    <verse number="5" style="v" />Wilik kichii', xama' kiq'orik ta wo' hoq.</para>
  <para style="q">Wilik naq' kiwach, xama' ki-ilwik ta wo' hoq.</para>
  <para style="q">
    <verse number="6" style="v" />Wilik kixikin, xama' ki-ib'irinik ta wo' hoq.</para>
  <para style="q">Wilik kiju', xama' kiuhtz'inik ta wo' hoq.</para>
  <para style="q">
    <verse number="7" style="v" />Wilik kiq'ab', xama' kitz'a'inik ta wo' hoq. Wilik kooq,</para>
  <para style="q">xama' kib'ehik ta wo' hoq.</para>
  <para style="q">Eh ma' xta jino'q q'orik i nelik cho pan kalaq.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taqe i tiyoox re' re' ma' xta k'isinoq kajaawriik,</para>
  <para style="q">eliik wach kimemil ruuk' inyej-anik keh,</para>
  <para style="q">eh je' wo' taqe inimanik keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Hat taq aj Israel ruuk' i QaJaaw Dios chayeew taq ak'ux.</para>
  <para style="q">Ruum xa re' wo' reh intoob'inik inko'linik taq aweh.</para>
  <para style="q">
    <verse number="10" style="v" />Hat taq riih i Aarón i ruuk' i QaJaaw Dios taq chayeew ak'ux.</para>
  <para style="q">Ruum xa re' wo' reh intoob'inik, inko'linik taq aweh.</para>
  <para style="q">
    <verse number="11" style="v" />Re' taq i hat inayohleej taq wach i QaJaaw Dios. Inayeew taq ak'ux ruuk'.</para>
  <para style="q">Re' wo' reh intoob'inik, inko'linik taq aweh.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' QaJaaw Dios xojk'ulik cho paruk'ux,</para>
  <para style="q">naakooj rukuxisam i hoj, hoj aj Israel.</para>
  <para style="q">Eh naa wo' rukuxisam taqe i riih Aarón.</para>
  <para style="q">
    <verse number="13" style="v" />Eh re' QaJaaw Dios naa wo' rukuxisam taqe chaloq</para>
  <para style="q">chu'nchel i kiyohlinik reh chi nimaq chi kok' taq.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' QaJaaw Dios naa ruye'em taq cha naah i hat i rotob'il.</para>
  <para style="q">Eh naa wo' ruye'em i rotob'il chikinaah taq awak'uun awixq'uun.</para>
  <para style="q">
    <verse number="15" style="v" />Re' ta naq i QaJaaw Dios xyej-anik cho reh i taxaaj ruch'ihil i wach ak'al</para>
  <para style="q">neentoob'inik taq aweh i hat.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Re' i taxaaj ruye'aab' i QaJaaw Dios ruum ar wilik chaloq,</para>
  <para style="q">eh re' i wach ak'al xukanaa' chi kiye'aab' i tinamit.</para>
  <para style="q">
    <verse number="17" style="v" />Re' taqe kamnaq ma' nee ta chik inki a'n rulooq'jiik i QaJaaw Dios,</para>
  <para style="q">ruum ma' xta chik kuxlaab'.</para>
  <para style="q">
    <verse number="18" style="v" />Re' la' hoj i naa qaye'wiik ruloq'il i QaJaaw Dios,</para>
  <para style="q">je' yu'naak, je' chi juneliik.</para>
  <para style="b" />
  <para style="q">Loq'imaj ta naq i QaJaaw Dios.</para>
  <chapter number="116" style="c" />
  <para style="s">Re' tiij t'iosb'al reh i rotob'il i QaJaaw Dios</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin i nuk'ax i QaJaaw Dios</para>
  <para style="q">ruum xuyeew weh i xnupahqaaj reh panutiij.</para>
  <para style="q">
    <verse number="2" style="v" />Ruum chi xrib'iraj i nutiij. Re' hin juneliik i nuk'achariik naa nupahqaam,</para>
  <para style="q">reh chi naakiin rutoob'eem.</para>
  <para style="q">
    <verse number="3" style="v" />Re' hin rukotem naq chik wiij i kimik, eh xa ximponik chik chii' jul noq xwik'raaj.</para>
  <para style="q">Xa re' naq chik i yo'jik,</para>
  <para style="q">i ruti'kiil k'uxliis wilik chi nunaah.</para>
  <para style="q">
    <verse number="4" style="v" />Eh noq xwilow chi je' re' xnupahqaaj reh i QaJaaw Dios</para>
  <para style="q">chi chuko'leej riij i nuk'achariik.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' i QaJaaw Dios ruum chi korik wach ruk'ux, chi q'e' aj keteloom wachiis.</para>
  <para style="q">Eh q'e' atoob' xirutoob'eej wo' hoq.</para>
  <para style="q">
    <verse number="6" style="v" />Re' reh i ruko'leej taqe i ma' nimaq ta kiwach.</para>
  <para style="q">Chawil i hin noq xakimik naq chik weh xi ruko'leej wo' hoq.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Yu'naak aj re', naa wo' chik rusuuqb'iik i nuk'achariik</para>
  <para style="q">ruum re' QaJaaw Dios q'e' xiruk'ax.</para>
  <para style="q">
    <verse number="8" style="v" />Ruum re' reh xi ruko'leej chuwach i kimik,</para>
  <para style="q">eh xresaj weh ooq'ik</para>
  <para style="q">reh chi ma' xinq'ehb'ik taj.</para>
  <para style="q">
    <verse number="9" style="v" />Ruum aj re' naa nunimam</para>
  <para style="q">chi kixilak i k'achareel ayu' wach ak'al.</para>
  <para style="q">
    <verse number="10" style="v" />Eh noq xiik' naq naah ti'kiil nuk'ux,</para>
  <para style="q">xnunimaj chi re' QaJaaw Dios naa rutoob'iniik weh.</para>
  <para style="q">
    <verse number="11" style="v" />Eh noq xsahchik nuna'ojb'al xnuq'or</para>
  <para style="q">chi chu'nchel i winaq aj chukul q'orik taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />¿Nik' wach noq neenutoj riij</para>
  <para style="q">reh i QaJaaw Dios i rotob'il i rub'anam wuuk'?</para>
  <para style="q">
    <verse number="13" style="v" />Re' hin naa nuk'amam cho chi numayiij i riis uuva,</para>
  <para style="q">t'iosb'al reh i rotob'il xub'an wuuk'.</para>
  <para style="q">
    <verse number="14" style="v" />Eh naa nutojom reh i QaJaaw Dios i nuq'orom chi ree reh,</para>
  <para style="q">chikiwach taqe irutinamiitnaa nuye'em.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Re' QaJaaw Dios ti' riik'raaj i kikimiik</para>
  <para style="q">taqe i rusantolaj aj nimaneel.</para>
  <para style="q">
    <verse number="16" style="v" />QaJaaw Dios re' hin, hin awaj kamanoom.</para>
  <para style="q">Hin rak'uun i nutuut re' awaj kamanoom.</para>
  <para style="q">Re' hat xinawesaj chupaam i ti' k'axik naq wilkiin wii'.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Re' hin naa nuk'atam i numayiij chuwach i QaJaaw Dios,</para>
  <para style="q">t'iosb'al reh i rotob'il xub'an wuuk'.</para>
  <para style="q">
    <verse number="18" style="v" />Re' hin naa nutojom reh i QaJaaw Dios i nuq'orom chi ree reh,</para>
  <para style="q">eh chikiwach i rutinamiit naa nuye'em.</para>
  <para style="q">
    <verse number="19" style="v" />Re' wili ar Jerusaleem naa nuye'em chuwach rupaat i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">Loq'imaj ta naq QaJaaw Dios.</para>
  <chapter number="117" style="c" />
  <para style="s">Re' rutz'uuyjiik wach i QaJaaw Dios ruum q'e' aj keteloom wachiis</para>
  <para style="q">
    <verse number="1" style="v" />Chaloq'ej taq i QaJaaw Dios chawunchelaal i taq i hat i wilkaat taq panimaq tinamit,</para>
  <para style="q">i wilkaat taq pankok' tinamit chaloq'ej taq.</para>
  <para style="q">
    <verse number="2" style="v" />Ruum re' reh xiik' naah i ruketeljiik qawach xub'an.</para>
  <para style="q">Eh korik wach ruk'ux quuk' chi juneliik.</para>
  <para style="b" />
  <para style="q">Loq'imaj ta naq i QaJaaw Dios.</para>
  <chapter number="118" style="c" />
  <para style="s">Re' rut'iosjiik reh i Dios i ko'linik xub'an</para>
  <para style="q">
    <verse number="1" style="v" />Chaloq'ej taq i QaJaaw Dios ruum re' reh q'e' atoob'.</para>
  <para style="q">Eh juneliik i ruketelaaj qawach.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Eh nee ta naq inkiq'or aj Israel chi re' QaJaaw</para>
  <para style="q">chi juneliik i ruketelaaj qawach.</para>
  <para style="q">
    <verse number="3" style="v" />Neeta naq inkiq'or i riih i Aarón</para>
  <para style="q">chi juneliik i ruketelaaj qawach.</para>
  <para style="q">
    <verse number="4" style="v" />Nee ta naq inkiq'or i kiyohlinik reh i QaJaaw Dios</para>
  <para style="q">chi juneliik ruketelaaj qawach.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' hin noq ti' nuk'ux xnupahqaaj i rotob'il QaJaaw Dios.</para>
  <para style="q">Eh re' reh xirib'iraj, xiresaj chupaam i ruti'kiil nuk'ux.</para>
  <para style="q">
    <verse number="6" style="v" />Re' hin re' QaJaaw Dios intoob'inik weh,</para>
  <para style="q">ruum aj re' ma' kinyo'jik ta ruum chib'ih jariik i neerub'an weh i xa winaq.</para>
  <para style="q">
    <verse number="7" style="v" />Re' QaJaaw Dios wilik wuuk', re' reh naa rutoob'iniik weh.</para>
  <para style="q">Reh chi naa nub'anam keh i ki-ixowanik nuwach.</para>
  <para style="q">
    <verse number="8" style="v" />Xiik' naah chihojal chi ruuk' i QaJaaw Dios neenuyeew nuk'ux,</para>
  <para style="q">chuwach chi ruuk' winaq neenuyeew nuk'ux.</para>
  <para style="q">
    <verse number="9" style="v" />Xiik' naah chihojal chi ruuk' i QaJaaw Dios neenuyeew nuk'ux chuwach chi</para>
  <para style="q">neenuyeew nuk'ux ruuk' i winaq nim wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' hin chu'nchel naq i tinamit kikotej wiij chi naa kianam weh</para>
  <para style="q">Eh nusach kiwach ruuk' rajaawriik i QaJaaw Dios.</para>
  <para style="q">
    <verse number="11" style="v" />Eh k'ul xi okik chaloq reh i rub'anariik weh.</para>
  <para style="q">Eh re' hin nusach kiwach ruuk' i rajaawriik i QaJaaw Dios.</para>
  <para style="q">
    <verse number="12" style="v" />Eh xkimol cho kiib' chi nunaah</para>
  <para style="q">xa kiqop chik ruum kik'aah, je' rukab' noq inkimol cho kiib' i k'ohlox.</para>
  <para style="q">Eh jumehq'iil xnusach kiwach ruuk' i rajaawriik i QaJaaw Dios, xa je' kik'ahtik sohk'.</para>
  <para style="q">
    <verse number="13" style="v" />Re' keh xti kow naq xi okik wuuk' re' naq inkaaj chi xkian weh,</para>
  <para style="q">xa re' la', re' hin re' QaJaaw Dios xtoob'inik weh.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hin i nutz'uyej wach i QaJaaw Dios,</para>
  <para style="q">inye'wik rukowiil nuk'ux, re' inko'linik weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Eh pankipaat korik wach kik'ux</para>
  <para style="q">inkik'er kichii' chi tz'uuy je' wili inkiq'or:</para>
  <para style="q">Ruum i rajaawriik i QaJaaw Dios xoj elik korik.</para>
  <para style="q">
    <verse number="16" style="v" />Re' rajaawriik i QaJaaw Dios ma' ha' ta chi je'.</para>
  <para style="q">Ruum ruuk' i rajaawriik xqaq'at kiwach i ki-ixowanik qawach, inki taqe.</para>
  <para style="q">
    <verse number="17" style="v" />Re' hin komajaa' ta naa nukimiik, konaa nuk'achariik.</para>
  <para style="q">Konaa nuq'orom rib'iral i xub'an i QaJaaw Dios.</para>
  <para style="q">
    <verse number="18" style="v" />Korik noq re' i QaJaaw Dios, xiruyeew panti' k'axik,</para>
  <para style="q">xa re' la', ma' xinkikansaj taj.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Chateh taq weh i ru puertahiil i rupaat i QaJaaw Dios,</para>
  <para style="q">re' hin naawokiik ar chi loq'oonjiik i reh.</para>
  <para style="q">
    <verse number="20" style="v" />Re' wili i ru puertahiil i rupaat i QaJaaw Dios,</para>
  <para style="q">eh ar naa kokiik taqe i korik wach kik'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />QaJaaw Dios, re' hin naa kaat nuloq'em ruum xayeew weh i xnupahqaaj aweh,</para>
  <para style="q">eh xinako'leej.</para>
  <para style="q">
    <verse number="22" style="v" />Re' ab'aj ma' xponik ta panaq'kiwach i aj yej-an paat,</para>
  <para style="q">re' re' xkahnik chi rukowiil i rooq i paat.</para>
  <para style="q">
    <verse number="23" style="v" />Re' wili xub'an QaJaaw Dios,</para>
  <para style="q">xiik' naah nimaal wach chi qeh i hoj.</para>
  <para style="q">
    <verse number="24" style="v" />Eh chupaam taqe q'iij wili xub'an i re' i QaJaaw Dios.</para>
  <para style="q">Ruum aj re' q'e' suq qak'ux ma' ntz'irik ta qawach.</para>
  <para style="q">
    <verse number="25" style="v" />QaJaaw Dios cha kuy qoh ako'leej tii.</para>
  <para style="q">Jaaw cha kuy chayeew q'ab' qeh chi nee qoh elik korik.</para>
  <para style="q">
    <verse number="26" style="v" />Neeta naq inye'arik ruloq'il ik'ulik iloq reh parub'ihnaal i QaJaaw Dios.</para>
  <para style="q">Re' hoj inqayeew ruloq'il chupaam i rupaat i QaJaaw Dios.</para>
  <para style="q">
    <verse number="27" style="v" />Re' QaJaaw Dios, xk'uhtanik qeh i saqum.</para>
  <para style="q">Yu'naak chatik'aa' taq i ninq'iij chak'am taq reje amayiij,</para>
  <para style="q">hiy taq chayeew pantaq rutz'u'kaal i artaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />WaJaaw hat nuDios, re' hin juneliik naa kaat nuloq'em,</para>
  <para style="q">naa nuye'em runimaal awach.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Chaloq'ej taq i QaJaaw Dios, ruum re' reh q'e' atoob',</para>
  <para style="q">eh juneliik wilik ketelinik wachiis ruuk'.</para>
  <chapter number="119" style="c" />
  <para style="s">Re' ruye'ariik ruloq'il i ruk'uhb'aal i QaJaaw Dios</para>
  <para style="q">
    <verse number="1" style="v" />Atoob' keh i re' korik inki a'n pan kik'achariik.</para>
  <para style="q">Eh inkik'am naah i ruk'uhb'aal i QaJaaw Dios.</para>
  <para style="q">
    <verse number="2" style="v" />Atoob' keh inki a'n chu'nchel i ruq'or i ruk'uhb'aal.</para>
  <para style="q">Eh inkisik' chu'nchel i kánima.</para>
  <para style="q">
    <verse number="3" style="v" />Ma' nkian taj i yiib' wach na'ojb'al,</para>
  <para style="q">inkik'am la' i rub'eeh i QaJaaw Dios.</para>
  <para style="q">
    <verse number="4" style="v" />Re' hat QaJaaw Dios aq'orom</para>
  <para style="q">chi ajwaal wach chi naa rub'aan taqe i ruq'or aak'uhb'aal.</para>
  <para style="q">
    <verse number="5" style="v" />Re' hin holohik ta naq neekinb'anik</para>
  <para style="q">reh chi neenub'an i taqe ruq'or aak'uhb'aal.</para>
  <para style="q">
    <verse number="6" style="v" />Eh wila' xnub'an chu'nchel i ruq'or aak'uhb'aal</para>
  <para style="q">ma' xta neekink'ixik wii'.</para>
  <para style="q">
    <verse number="7" style="v" />Eh noq nureqem chik chi riij aak'uhb'aal,</para>
  <para style="q">naa kaat nuloq'em ruuk' i rukorkiil wach i wánima.</para>
  <para style="q">
    <verse number="8" style="v" />Re' hin neenub'an chu'nchel i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">Xa re' la' makinakanaa' chi wutkeel.</para>
  <para style="q">
    <verse number="9" style="v" />¿Nik' wach noq nee rureq i saq wach k'acharik i k'ijool?</para>
  <para style="q">Xa re' wo' chi neerub'an taqe i ruq'or aq'oral.</para>
  <para style="q">
    <verse number="10" style="v" />Eh re' hin chu'nchel nuk'ux xatnusik'</para>
  <para style="q">maayeew q'ab' chi neenukanaa' runimjiik taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="11" style="v" />Re' hin numolom pan wánima taqe aq'oral</para>
  <para style="q">reh chi ma' nee ta chik kimahkunik chawach.</para>
  <para style="q">
    <verse number="12" style="v" />QaJaaw Dios, re' hat xiik' naah aaloq'il.</para>
  <para style="q">Cha k'uhtaaj tii weh taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="13" style="v" />Re' hin naa nuq'orom rib'iral chu'nchel</para>
  <para style="q">aak'uhb'aal aq'orom chaloq.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hin insuuqb'ik nuk'ux chub'aan i ruq'or taqe aak'uhb'aal,</para>
  <para style="q">ma' xata je' rukab' i ruyeew chu'nchel i b'ehomal.</para>
  <para style="q">
    <verse number="15" style="v" />Eh naa nutijem riij chi korik aak'uhb'aal,</para>
  <para style="q">eh naa nuk'amam naah ruuk' animjiik.</para>
  <para style="q">
    <verse number="16" style="v" />Re' hin insuuqb'ik nuk'ux ruum taqe aak'uhb'aal</para>
  <para style="q">eh ma' jaruuj naa rusahchiik panuk'ux aq'oral.</para>
  <para style="q">
    <verse number="17" style="v" />Jaaw, chayeew pee nuk'achariik i hin, hin awaj kamanoom.</para>
  <para style="q">Reh chi neenub'an taqe i ruq'or aak'uhb'aal.</para>
  <para style="q">
    <verse number="18" style="v" />Eh cha teh inukapeb'aal reh chi neenureq chi riij</para>
  <para style="q">chi re' aak'uhb'aal xiik' naah loq'il.</para>
  <para style="q">
    <verse number="19" style="v" />Re' hin xa hin ik'al b'eeh ayu' wach ak'al, ruum aj re',</para>
  <para style="q">maakeb'aa' tii chi nuwach taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="20" style="v" />Re' hin chu'nchel q'iij inyot'ik i wánima chi rotoowjiik</para>
  <para style="q">rureqariik chi riij chi korik, aak'uhb'aal.</para>
  <para style="q">
    <verse number="21" style="v" />Re' hat xaq'il taqe inkinimb'isaj kiwach, re' taqe i kiq'eb'em kiib',</para>
  <para style="q">eh kikanaam runimjiik aak'uhb'aal.</para>
  <para style="q">
    <verse number="22" style="v" />Jaaw kinako'leej tii chuwach i kijosq'iil taqe i ki-ixowanik nuwach,</para>
  <para style="q">ruum re' hin i nunimaj taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="23" style="v" />Eh wilik taqe i nimaq wach kina'ojb'al inkaaj nujot'ariik.</para>
  <para style="q">Xa re' la', re' hin, i hin awaj kamanoom re' taqe aak'uhb'aal naa nutijem riij.</para>
  <para style="q">
    <verse number="24" style="v" />Re' hin q'e' nsuuqb'ik nuk'ux chi riij taqe aak'uhb'aal,</para>
  <para style="q">ruum re' taqe re' inkojwik nuna'ojb'al.</para>
  <para style="q">
    <verse number="25" style="v" />Q'e' ti' wilkiin, xanaa chik nukimiik noq i wik'raaj.</para>
  <para style="q">Jaaw kinako'leej tii, je' rukab' aaq'orom weh.</para>
  <para style="q">
    <verse number="26" style="v" />Eh nuq'or aweh nik' wach i nuna'ojb'al, eh re' hat xayeew weh i xnupahqaaj aweh.</para>
  <para style="q">Eh cha k'uhtaaj weh taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="27" style="v" />Chayeew nuna'ojb'al reh chi neenureq chi riij taqe aak'uhb'aal.</para>
  <para style="q">Reh chi nutijem riij taqe i xiik' naah loq'il inak'uhtaaj.</para>
  <para style="q">
    <verse number="28" style="v" />Re' hin xa re' chikoq'iki nub'an.</para>
  <para style="q">Chayeew rukowiil nuk'ux, je' rukab' aaq'orom weh.</para>
  <para style="q">
    <verse number="29" style="v" />Eh inwaaj chi neenawesaj chi nuwach taqe chukuj q'orik.</para>
  <para style="q">Chaketelaaj nuwach kinatijej ruuk' taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="30" style="v" />Re' hin xnusik' chik i korik laj b'eeh ruum aj re',</para>
  <para style="q">xa re' chik i ruq'or taqe aak'uhb'aal i nub'an.</para>
  <para style="q">
    <verse number="31" style="v" />QaJaaw Dios re' hin i nub'an taqe inaq'or.</para>
  <para style="q">Ruum ma' nwaaj taj chi neenak'uhtaaj nuk'ixb'ilaal.</para>
  <para style="q">
    <verse number="32" style="v" />Re' hin i nuyeew nuk'ux chub'aan taqe i ruq'or aak'uhb'aal,</para>
  <para style="q">ruum q'e' insuuqb'ik i wánima.</para>
  <para style="q">
    <verse number="33" style="v" />QaJaaw Dios cha k'uhtaaj weh i rukorkiil taqe aak'uhb'aal</para>
  <para style="q">reh chi nee nunimaj korehtaal i weliik ayu' wach ak'al.</para>
  <para style="q">
    <verse number="34" style="v" />Chayeew tii nuna'ojb'al reh chi nee nub'an</para>
  <para style="q">chu'nchel nuk'ux taqe i ruq'or aak'uhb'aal.</para>
  <para style="q">
    <verse number="35" style="v" />Chak'am nub'eeh ruuk' taqe aak'uhb'aal</para>
  <para style="q">ruum xa ruuk' wo' re' neenureq rusuqkiil nuk'ux.</para>
  <para style="q">
    <verse number="36" style="v" />Eh xa re' chik taqe aak'uhb'aal neenub'an.</para>
  <para style="q">Ma' nee ta nuyeew nuk'ux chinaah i b'ehomal.</para>
  <para style="q">
    <verse number="37" style="v" />Eh chawesaj i naq'nuwach chinaah i xama' xta ruk'am chaloq.</para>
  <para style="q">Chayeew la' rukowiil nuk'ux reh chi neenuk'am aab'eeh.</para>
  <para style="q">
    <verse number="38" style="v" />Chayeew wee hin, i hin awaj kamanoom</para>
  <para style="q">i aq'orom cho chi naa aye'em keh i kiyohlinik aweh.</para>
  <para style="q">
    <verse number="39" style="v" />Eh chawesaj chi nuwach i nub'ajariik inki a'n re' inchalik nuyo'jiik ruum.</para>
  <para style="q">Re' taqe i ruq'or aak'uhb'aal korik.</para>
  <para style="q">
    <verse number="40" style="v" />Re' hin xa nwotow chik rub'aan taqe i ruq'or aak'uhb'aal. Chayeew rukowiil nuk'ux,</para>
  <para style="q">ruum re' hat korik wach ak'ux.</para>
  <para style="q">
    <verse number="41" style="v" />QaJaaw Dios, chaketelaaj nuwach kinako'leej tii</para>
  <para style="q">je' rukab' aaq'orom cho weh.</para>
  <para style="q">
    <verse number="42" style="v" />Chi je' re' nee kinchol ruchaq'weesjiik imb'ajwik weh,</para>
  <para style="q">ruum re' hin nuch'ikaam nuk'ux ruuk' aq'oral.</para>
  <para style="q">
    <verse number="43" style="v" />Maayeew q'ab' chi neenukanaa' ruq'orariik i korik,</para>
  <para style="q">ruum re' hin chinaah taqe aak'uhb'aal nuye'em nuk'ux.</para>
  <para style="q">
    <verse number="44" style="v" />Re' hin inwaaj nub'anam panuk'achariik</para>
  <para style="q">chi juneliik taqe i ruq'or aak'uhb'aal.</para>
  <para style="q">
    <verse number="45" style="v" />Eh ma' xta neenq'ilwik weh,</para>
  <para style="q">ruum k'ahchi' nuk'amam naah taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="46" style="v" />Re' hin naa nuq'orom rib'iral aak'uhb'aal keh taqe i reey,</para>
  <para style="q">ma' nee ta kink'ixik chuq'orariik.</para>
  <para style="q">
    <verse number="47" style="v" />Eh re' hin q'e' nuk'ax taqe aak'uhb'aal,</para>
  <para style="q">eh q'e' suq nuk'ux chi riij.</para>
  <para style="q">
    <verse number="48" style="v" />Q'e' nuk'ax, eh inwootwaaj rub'anariik i ruq'or taqe aak'uhb'aal,</para>
  <para style="q">eh xa re' chik i re' i nukapaaj riij.</para>
  <para style="q">
    <verse number="49" style="v" />K'oloq panak'ux aaq'orom chaloq chi naa a'nam wuuk' i hin, i hin awaj kamanoom.</para>
  <para style="q">Reh chi neenwuy-eej.</para>
  <para style="q">
    <verse number="50" style="v" />Eh re' aq'orom cho weh chi naa a'nam wuuk' inye'wik rusuqkiil nuk'ux noq ti' nuk'ux.</para>
  <para style="q">Ruuk' i re' i nayeew rukowiil nuk'ux.</para>
  <para style="q">
    <verse number="51" style="v" />Re' taqe i nimaq kiwach inki a'n kiib' xak'ahchi' keeb' chi nub'ajariik.</para>
  <para style="q">Xa re' la', re' hin ma' nukanaam ta runimjiik aak'uhb'aal.</para>
  <para style="q">
    <verse number="52" style="v" />QaJaaw Dios, re' hin ink'ulik panuk'ux taqe aak'uhb'aal aq'orom cho najtir,</para>
  <para style="q">ruuk' taqe re' insuuqb'ik nuk'ux.</para>
  <para style="q">
    <verse number="53" style="v" />Ruum aj re', inchalik nuk'aah chikinaah i yiib' wach kina'ojb'al,</para>
  <para style="q">ruum inkiq'eb' chi riij kik'ux taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="54" style="v" />Re' hin inutz'uyej wach aak'uhb'aal noq wilkiin</para>
  <para style="q">chupaam i ye'aab' wili i xa ik'ik weh chupaam.</para>
  <para style="q">
    <verse number="55" style="v" />QaJaaw Dios re' hin tik'ulik panuk'ux pantaq chaq'ab', ruum aj re',</para>
  <para style="q">inwaaj numolom aak'uhb'aal.</para>
  <para style="q">
    <verse number="56" style="v" />Re' aawotob'il wili ruk'ul chi weh</para>
  <para style="q">ruum k'ahchi' nunimam taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="57" style="v" />QaJaaw Dios, xa re' wo' hat titoob'inik weh, ruum aj re',</para>
  <para style="q">naa nub'anam i ruq'or aq'oral.</para>
  <para style="q">
    <verse number="58" style="v" />Re' hin chu'nchel nuk'ux i nupahqaaj aawotob'il,</para>
  <para style="q">chaketelaaj tii nuwach, je' rukab' aaq'orom weh.</para>
  <para style="q">
    <verse number="59" style="v" />Eh xnukoj rehtaal chi ma' holohik taj i nuna'ojb'al,</para>
  <para style="q">ruum i re', xnunimaj wo' chik taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="60" style="v" />Atoob' naak ma' xnucham ta wiib',</para>
  <para style="q">jumehq'iil wo' chik xtohq'ik nub'anam i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="61" style="v" />Eh re' taqe i yiib' wach kina'ojb'al inkikotej wiij.</para>
  <para style="q">Xa re' la', re' hin ma' nsahchik ta panuk'ux aak'uhb'aal.</para>
  <para style="q">
    <verse number="62" style="v" />Eh yejal aq'ab' kinwuktik chi t'ioosjik aweh,</para>
  <para style="q">ruum re' aak'uhb'aal xti korik.</para>
  <para style="q">
    <verse number="63" style="v" />Re' hin i nub'an jinaj wach nuk'ux kuuk' i kiyohlinik aweh.</para>
  <para style="q">Eh inki a'n taqe i ruq'or aak'uhb'aal.</para>
  <para style="q">
    <verse number="64" style="v" />QaJaaw Dios re' ketelinik wachiis i na a'n ink'utinik chi junsuut i wach ak'al.</para>
  <para style="q">Ruum aj re' cha k'uhtaaj weh taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="65" style="v" />Jaaw re' hin, i hin awaj kamanoom eliik i na a'n otob'il weh,</para>
  <para style="q">je' rukab' aq'orom weh.</para>
  <para style="q">
    <verse number="66" style="v" />Eh chayeew tii nuna'ojb'al reh chi neenureq chi riij i holohik.</para>
  <para style="q">Ruum re' hin, ch'iklik nuk'ux ruuk' taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="67" style="v" />Korik, noq komajaa' inuk'ul i ti' k'axik</para>
  <para style="q">xa chib'ih naq jariik kinq'ehb'ik wii'.</para>
  <para style="q">Eh yu'naak i nunimaj chik aq'oral.</para>
  <para style="q">
    <verse number="68" style="v" />Re' hat q'e' hat atoob', xa re' holohik i na a'n.</para>
  <para style="q">Re' hin inwaaj chi nee nak'uhtaaj weh taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="69" style="v" />Re' taqe nimaq kiwach inki a'n kiib' inkitz'aq wach numahk.</para>
  <para style="q">Xa re' la' re' hin, chu'nchel nuk'ux k'ahchi' kiin i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="70" style="v" />Re' taqe re' tz'aplik i kikapeb'aal,</para>
  <para style="q">raaj i hin q'e' nsuuqb'ik nuk'ux ruuk' aak'uhb'aal.</para>
  <para style="q">
    <verse number="71" style="v" />Chi wee hin ma' xta reet chi xinayeew panti' k'axik.</para>
  <para style="q">Ruum chi je' re' neenureq chi riij taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="72" style="v" />Chi wee hin xiik' naah loq'il aak'uhb'aal xinatijej wii' chuwach</para>
  <para style="q">i ruk'ihaal oro, i ruk'ihaal plata.</para>
  <para style="q">
    <verse number="73" style="v" />Re' hat xatyej-anik weh, re' hat xat ye'wik nuk'achariik.</para>
  <para style="q">Ruum aj re', inwaaj chi nee nayeew nuna'ojb'al reh chi neenutijej taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="74" style="v" />Re' taqe i kiyohlinik aweh naa rusuuqb'iik kik'ux,</para>
  <para style="q">noq naakiinkilom chi ruuk' aq'oral inuch'ikaa' nuk'ux.</para>
  <para style="q">
    <verse number="75" style="v" />QaJaaw Dios, re' hin weht'al chi re' hat parub'ehel ti q'atwik q'orik.</para>
  <para style="q">Ruum aj re', rub'ehel noq kow xinaq'il.</para>
  <para style="q">
    <verse number="76" style="v" />Ruuk' i ruketeljiik nuwach xa a'n ma' k'isiin ta nsuuqb'ik nuk'ux.</para>
  <para style="q">Je' rukab' aq'orom cho weh chi naa a'nam wuuk', i hin awaj kamanoom.</para>
  <para style="q">
    <verse number="77" style="v" />Chak'uhtaaj tii weh aawotob'il reh chi konee kink'acharik.</para>
  <para style="q">Ruum re' taqe aak'uhb'aal inye'wik rusuqkiil nuk'ux.</para>
  <para style="q">
    <verse number="78" style="v" />Neeta naq inkik'uhtaaj kik'ixb'ilaal i nimaq kiwach.</para>
  <para style="q">Ruum re' keh xa nkitz'aq wach i numahk,</para>
  <para style="q">re' hin re' taqe aak'uhb'aal i nutijej riij.</para>
  <para style="q">
    <verse number="79" style="v" />Eh jinaj ta naq wach kik'ux wuuk' i kiyohlinik aweh,</para>
  <para style="q">ruum keht'al chib'ih ruq'or taqe aak'uhb'aal</para>
  <para style="q">
    <verse number="80" style="v" />Eh korik ta naq wach i wánima chunimjiik</para>
  <para style="q">taqe aak'uhb'aal reh chi ma' xta neekink'ixik wii'.</para>
  <para style="q">
    <verse number="81" style="v" />Re' hin xanwaaj chik chi naakiin ako'leem.</para>
  <para style="q">Ruum inuch'ikaam nuk'ux ruuk' aak'uhb'aal.</para>
  <para style="q">
    <verse number="82" style="v" />Re' hin xa kinook chik iil reh taqe aq'orom rib'iral weh,</para>
  <para style="q">je' wili i nuq'or: ¿Jaruuj i ruyeew rusuqkiil nuk'ux? kinki.</para>
  <para style="q">
    <verse number="83" style="v" />Atoob' ta hin chik riji' winaq xama' xta chik kinokik wii',</para>
  <para style="q">re' aak'uhb'aal ma' jaruuj insahchik panuk'ux.</para>
  <para style="q">
    <verse number="84" style="v" />Jaaw ¿Ko nik' chik najtiil naawuy-eem?</para>
  <para style="q">¿Ko jaruuj i nayeew taqe chutojariik i kimahk i ki-ixowanik nuwach?</para>
  <para style="q">
    <verse number="85" style="v" />Re' taqe i nimaq kiwach i ma' kinimanik ta reh aak'uhb'aal,</para>
  <para style="q">inkisik' chi riij i nukanteesjiik.</para>
  <para style="q">
    <verse number="86" style="v" />Jaaw kinatoob'eej tii ruum re' hin inkixowaaj nuwach chi ma' xta numahk.</para>
  <para style="q">Weht'al i hin chi re' taqe aak'uhb'aal korik i ruq'or.</para>
  <para style="q">
    <verse number="87" style="v" />Ach naq k'isiin ma' xinkesaj ayu' wach ak'al, xa re' la',</para>
  <para style="q">re' hin xama' xnukanaa' ta wo' runimjiik taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="88" style="v" />Chaketelaaj tii nuwach chayeew pee nuk'achariik.</para>
  <para style="q">Chi je' re' ko neenub'an taqe aak'uhb'aal aq'orom ruuk' aachii'.</para>
  <para style="q">
    <verse number="89" style="v" />QaJaaw Dios re' aq'oral wilik chi juneliik.</para>
  <para style="q">Eh ar choplik cho chi korik pan taxaaj.</para>
  <para style="q">
    <verse number="90" style="v" />Re' rukorkiil wach ak'ux wilik chi juneliik,</para>
  <para style="q">re' hat xat ye'wik reh paruye'aab' i wach ak'al, eh xkahnik paruye'aab'.</para>
  <para style="q">
    <verse number="91" style="v" />Chu'nchel i re' xa ko pan kiye'aab' wo' wilkeeb' yu'naak, je' rukab' i xaq'or keh.</para>
  <para style="q">Eh chu'nchel i re' awaj kamanoom taqe.</para>
  <para style="q">
    <verse number="92" style="v" />Wi ta ma' xuk'am cho rusuqkiil nuk'ux aak'uhb'aal,</para>
  <para style="q">xin kimik naq chik chupaam i ruti'kiil nuk'ux.</para>
  <para style="q">
    <verse number="93" style="v" />Re' hin ma' jaruuj neensahchik panuk'ux taqe aak'uhb'aal</para>
  <para style="q">ruum ruuk' taqe re' xayeew nuk'achariik.</para>
  <para style="q">
    <verse number="94" style="v" />Jaaw kinako'leej tii ruum re' hat ti ehchanik weh.</para>
  <para style="q">Eh k'ahchi' nub'anam i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="95" style="v" />Re' i yiib' wach kina'ojb'al xa kuy-eem chik nik' naakiin kikansam.</para>
  <para style="q">Eh re' hin, re' aak'uhb'aal wilik panuk'ux.</para>
  <para style="q">
    <verse number="96" style="v" />Eh chu'nchel i xa chib'ih jariik insahchik kiwach.</para>
  <para style="q">Eh re' taqe aak'uhb'aal i hat ma' jaruuj naa rusahchiik kiwach.</para>
  <para style="q">
    <verse number="97" style="v" />Re' hin ma' k'isiin ta nuk'ax aak'uhb'aal,</para>
  <para style="q">chu'nchel i q'iij inutijeej riij.</para>
  <para style="q">
    <verse number="98" style="v" />Re' taqe aak'uhb'aal xuyeew nuna'ojb'al chi korik.</para>
  <para style="q">Ruum aj re', q'e' chik wilik nuna'ojb'al chikiwach i ki-ixowanik nuwach.</para>
  <para style="q">
    <verse number="99" style="v" />Eh q'e' chik wilik nuna'ojb'al chikiwach i kitijiniik weh</para>
  <para style="q">ruum xa re' chik taqe aak'uhb'aal i nutijej riij.</para>
  <para style="q">
    <verse number="100" style="v" />Eh q'e' wilik nuna'ojb'al chikiwach i mama' winaq.</para>
  <para style="q">Ruum re' hin, i nunimaj i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="101" style="v" />Re' hin xnuq'eb' chi riij nuk'ux chu'nchel i yiib' wach b'eeh,</para>
  <para style="q">reh chi naa nub'anam i ruq'or aq'oral.</para>
  <para style="q">
    <verse number="102" style="v" />Eh ma' nukanaa' ta runimjiik taqe aak'uhb'aal</para>
  <para style="q">ruum re' hat xatk'uhtanik weh.</para>
  <para style="q">
    <verse number="103" style="v" />Re' aq'oral, ma' k'isiin ta suq kiil i ruq'or.</para>
  <para style="q">Ma' xata je' ki'iil i riis kaab' chi wee hin.</para>
  <para style="q">
    <verse number="104" style="v" />Re' hin re' taqe aak'uhb'aal xkojwik nuna'ojb'al,</para>
  <para style="q">ruum aj re', q'e' inwixow wach chu'nchel i yiib' wach chi b'anarik.</para>
  <para style="q">
    <verse number="105" style="v" />Eh jinaj saqum chi weh aq'oral</para>
  <para style="q">ruum re' i re' ink'uhtanik weh chib'ih i naa nub'anam.</para>
  <para style="q">
    <verse number="106" style="v" />Re' hin xnuq'or i korik chi naa nub'anam i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">Eh koruman chi naa nub'anam.</para>
  <para style="q">
    <verse number="107" style="v" />QaJaaw Dios, re' hin q'e' ti' i nuk'ux.</para>
  <para style="q">Chakuy chayeew tii nuk'achariik je' rukab' aaq'orom weh.</para>
  <para style="q">
    <verse number="108" style="v" />QaJaaw Dios, chak'ul tii weh i numayiij i nuq'or aweh ruuk' nuchii'.</para>
  <para style="q">Eh cha k'uhtaaj weh chi korik taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="109" style="v" />Korik re' hin xa eliik wilkiin paruyohb'alil i kimik, xa re' la' re' hin,</para>
  <para style="q">ma' sahchik ta panuk'ux aak'uhb'aal.</para>
  <para style="q">
    <verse number="110" style="v" />Re' i yiib' wach kina'ojb'al xa nkisik' chik chi riij nukanteesjiik.</para>
  <para style="q">Eh re' hin ma' nukanaa' ta taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="111" style="v" />Re' aak'uhb'aal xnuk'ul chi je' jinaj nukooch reh juneliik,</para>
  <para style="q">ruum re' i re' inye'wik rusuqkiil i wánima.</para>
  <para style="q">
    <verse number="112" style="v" />Re' hin chu'nchel i wánima naa nub'anam i ruq'or taqe aak'uhb'aal,</para>
  <para style="q">korehtaal i weliik ayu' wach ak'al.</para>
  <para style="q">
    <verse number="113" style="v" />Eh ma' imponik ta chi nuwach taqe i xak'ul inki a'n kiwach.</para>
  <para style="q">Eh re' aak'uhb'aal q'e' nuk'ax.</para>
  <para style="q">
    <verse number="114" style="v" />Re' hat titoob'inik weh, re' hat ti ko'linik weh,</para>
  <para style="q">eh ruuk' aq'oral nuch'ikaam i nuk'ux.</para>
  <para style="q">
    <verse number="115" style="v" />Re' taq i hat yiib' taq wach ana'ojb'al cha kanaa' taq nujot'ariik</para>
  <para style="q">ruum re' hin inwaaj nub'anam i ruq'or taqe i ruk'uhb'aal i nuDios.</para>
  <para style="q">
    <verse number="116" style="v" />QaJaaw Dios chayeew nukowiil je' rukab' aaq'orom weh, reh chi konee kik'acharik.</para>
  <para style="q">Eh ma' ta naq neenooj chi re' chi ma' re' i ch'iklik wii' nuk'ux.</para>
  <para style="q">
    <verse number="117" style="v" />Kinatoob'eej reh chi nee nuko'leej wiib',</para>
  <para style="q">chi je' re' neenub'an i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="118" style="v" />Re' hat ma' imponik ta chawach inkikanaa' taqe aak'uhb'aal.</para>
  <para style="q">Ruum re' keh ma' xta kamaj i kikapeb'aal.</para>
  <para style="q">
    <verse number="119" style="v" />Re' hat inasach kiwach i yiib' wach kina'ojb'al ruum xa je' taqe sohk' chawach,</para>
  <para style="q">ruum aj re', re' hin q'e' nuk'ax taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="120" style="v" />Re' hin xa kinb'arb'otik chik ruum nuyo'jiik chawach,</para>
  <para style="q">ruum ma' k'isiin ta kinyo'jik ruum i q'ataj q'orik i na a'n.</para>
  <para style="q">
    <verse number="121" style="v" />Eh juneliik re' i korik, re' i rub'ehel i nub'an,</para>
  <para style="q">maa kinakanaa' pan kiq'ab' taqe i ki-ixowanik nuwach.</para>
  <para style="q">
    <verse number="122" style="v" />Kinatoob'eej tii, reh chi ma' xta neenuk'ul i hin, hin awaj kamanoom.</para>
  <para style="q">Eh maayeew q'ab' chi neenkian ti' k'axik weh i nimaq kiwach.</para>
  <para style="q">
    <verse number="123" style="v" />Re' hin xakinokik chik iil chi naa kiin ako'leem.</para>
  <para style="q">Eh chi naa kiin awesam chupaam i ti' k'axik, je' rukab' aq'orom weh.</para>
  <para style="q">
    <verse number="124" style="v" />Chaketelaaj nuwach i hin, hin awaj kamanoom,</para>
  <para style="q">cha k'uhtaaj weh chi korik taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="125" style="v" />Re' hin, hin awaj kamanoom chayeew nuna'ojb'aal,</para>
  <para style="q">ruum re' hin inwaaj nureqem chi riij i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="126" style="v" />QaJaaw Dios, ruq'ijil chik chi naa ak'uhtaam aajosq'iil,</para>
  <para style="q">ruum ma' nkinimaj ta chik aak'uhb'aal.</para>
  <para style="q">
    <verse number="127" style="v" />Ruum aj re', re' hin q'e' nuk'ax taqe aak'uhb'aal,</para>
  <para style="q">ruum xiik' naah loq'il chuwach i manlik oro.</para>
  <para style="q">
    <verse number="128" style="v" />Re' hin xnukoj rehtaal taqe aak'uhb'aal</para>
  <para style="q">chi xa re' wo' re' i korik chikiwach taqe i xa chib'ih jariik.</para>
  <para style="q">Ruum aj re', xnuq'eb' chi riij nuk'ux</para>
  <para style="q">chu'nchel i ma' korik ta laj na'ojb'al.</para>
  <para style="q">
    <verse number="129" style="v" />Re' taqe aak'uhb'aal chi wee hin xiik' naah holwochiil,</para>
  <para style="q">ruum aj re', i nuyeew nuk'ux chunimjiik.</para>
  <para style="q">
    <verse number="130" style="v" />Eh ruuk' i ruch'ob'ariik rub'ehel aq'oral i na a'n inasihq'eej kina'ojb'al,</para>
  <para style="q">eh inatijej taqe i ma' xta kina'ojb'al.</para>
  <para style="q">
    <verse number="131" style="v" />Re' hin xank'ahb'ik chik i nuchii',</para>
  <para style="q">ruum xa nwotow chik rureqariik chi riij taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="132" style="v" />QaJaaw Dios, kinatoob'eej tii, chaketelaaj nuwach,</para>
  <para style="q">je' rukab' noq inaketelaaj kiwach i kik'axwik aweh.</para>
  <para style="q">
    <verse number="133" style="v" />Chak'am nub'eeh ruuk' aq'oral,</para>
  <para style="q">maayeew q'ab' chi nee ruq'at nuwach i yiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="134" style="v" />Kinako'leej chupaam i ti' k'axik inki a'n weh i aj ixowaal,</para>
  <para style="q">ruum re' hin inwaaj nub'anam i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="135" style="v" />Jaaw suq tii wilariik cha a'n i hin, hin awaj kamanoom.</para>
  <para style="q">Eh cha k'uhtaaj weh chi korik taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="136" style="v" />Re' hin ma' k'isiin oq'ik i nub'an,</para>
  <para style="q">ruum ma' imponik ta panaq'kiwach aak'uhb'aal.</para>
  <para style="q">
    <verse number="137" style="v" />QaJaaw Dios, re' hat korik wach ak'ux,</para>
  <para style="q">je' wo' hoq aak'uhb'aal korik wo' hoq.</para>
  <para style="q">
    <verse number="138" style="v" />Eh chu'nchel i ruq'or taqe aak'uhb'aal</para>
  <para style="q">manlik wach, eh korik.</para>
  <para style="q">
    <verse number="139" style="v" />Re' hin inchalik nuk'aah chikinaah taqe i ki-ixowanik nuwach,</para>
  <para style="q">ruum xsahchik pankik'ux taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="140" style="v" />Re' hin, i hin awaj kamanoom weht'al chi re' aq'oral saq wach</para>
  <para style="q">ruum aj re' q'e' nuk'ax.</para>
  <para style="q">
    <verse number="141" style="v" />Re' hin ma' re' ta nkiwii' chi xama' xta wajaawriik,</para>
  <para style="q">eh chi ixowaal nuwach, ma' jaruuj insahchik panuk'ux taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="142" style="v" />Re' rukorkiil wach ak'ux wilik chi juneliik,</para>
  <para style="q">re' aak'uhb'aal xti korik.</para>
  <para style="q">
    <verse number="143" style="v" />Re' hin ma' k'isiin taj i ti' inuk'ul, xa nyot'ik chik i wánima i rub'an,</para>
  <para style="q">xa re' chik taqe aak'uhb'aal inye'wik rusuqkiil nuk'ux.</para>
  <para style="q">
    <verse number="144" style="v" />Re' taqe aak'uhb'aal juneliik korik i ruq'or,</para>
  <para style="q">chayeew la' nuna'ojb'al, reh chi nee nuk'achareej i ruq'or.</para>
  <para style="q">
    <verse number="145" style="v" />QaJaaw Dios, chu'nchel nuk'ux i nupahqaaj awotob'il.</para>
  <para style="q">Kinab'iraj tii, reh chi neenub'an i ruq'or taqe ak'uhb'aal.</para>
  <para style="q">
    <verse number="146" style="v" />Re' hat tinuq'o'reej kinatoob'eej tii reh chi neenub'an</para>
  <para style="q">i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="147" style="v" />Re' hin xakomajaa' wo' insaq'ik noq i nupahqaaj awotob'il.</para>
  <para style="q">Ruum ch'iklik nuk'ux ruuk' aq'orom weh.</para>
  <para style="q">
    <verse number="148" style="v" />Eh noq inwik'raaj wiib' panuwiriik chaq'ab'</para>
  <para style="q">intohq'ik nutijem riij i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="149" style="v" />QaJaaw Dios, chab'iraj i nuq'oral chaketelaaj tii nuwach.</para>
  <para style="q">Chayeew nuk'achariik ruuk' i rukorkiil wach ak'ux.</para>
  <para style="q">
    <verse number="150" style="v" />Re' taqe i ki-ixowanik nuwach xa re' i yiib' wach inki a'n</para>
  <para style="q">Eh ma' nkaaj ta runimjiik aak'uhb'aal.</para>
  <para style="q">
    <verse number="151" style="v" />QaJaaw Dios re' hat ma' najt ta wilkaat quuk'.</para>
  <para style="q">Eh chu'nchel taqe aak'uhb'aal korik.</para>
  <para style="q">
    <verse number="152" style="v" />Re' hin xa najtir wo' intohq'ik cho nureqem chi riij i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">Eh weht'al chi re' hat xatyej-anik reh, eh reh juneliik.</para>
  <para style="q">
    <verse number="153" style="v" />Jaaw chawil i ti' k'axik k'ahchi' wik'iik wii' kinawesaj chupaam.</para>
  <para style="q">Ruum re' hin, ma' sahchik ta panuk'ux taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="154" style="v" />Kinako'leej, kinawesaj chupaam i wilkiin wii'.</para>
  <para style="q">Chayeew nuk'achariik, je' rukab' aaq'orom weh.</para>
  <para style="q">
    <verse number="155" style="v" />Eh re' taqe yiib' wach kina'ojb'al xama' jaruuj ta wo' naa ako'leem taqe,</para>
  <para style="q">ruum ma' inkinimaj taj i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="156" style="v" />QaJaaw Dios re' hat q'e' hat aj keteloom wachiis,</para>
  <para style="q">Neeta tii nayeew nuk'achariik ruuk' i rukorkiil wach ak'ux.</para>
  <para style="q">
    <verse number="157" style="v" />Re' hin ma' k'isiin i kib'anik ti' k'axik weh re' taqe i ki-ixowanik nuwach.</para>
  <para style="q">Eh xama' nukanaam ta wo' rub'aan i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="158" style="v" />Re' hin xinq'uhtik chi kilariik i yiib' wach kina'ojb'al,</para>
  <para style="q">ruum ma' inkinimaj ta taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="159" style="v" />QaJaaw Dios, re' hat aweht'al chi q'e' i nuk'ax aak'uhb'aal.</para>
  <para style="q">Eh nee ta tii nayeew nuk'achariik, ruum q'e' hat aj keteloom wachiis.</para>
  <para style="q">
    <verse number="160" style="v" />Chu'nchel aq'oral tz'ihb'amaj pan santo laj huuj xti manlik wach,</para>
  <para style="q">xti korik, naa ruwihiik chi juneliik.</para>
  <para style="q">
    <verse number="161" style="v" />Re' taqe i wilik kina'ojb'al k'ahchi' kianam ti' k'axik weh chi xama' xta numahk.</para>
  <para style="q">Eh re' hin inuyohleej wach aq'oral.</para>
  <para style="q">
    <verse number="162" style="v" />Re' hin nsuuqb'ik nuk'ux ruuk' aq'oral,</para>
  <para style="q">je' rukab' noq insuuqb'ik ruk'ux jino'q i ruk'ul k'ih hoq rukooch.</para>
  <para style="q">
    <verse number="163" style="v" />Re' hin q'e' nuk'ax aak'uhb'aal,</para>
  <para style="q">ma' imponik ta chi nuwach taqe i chukuj q'orik.</para>
  <para style="q">
    <verse number="164" style="v" />Re' hin wuquub' pech tinuloq'ej chuwach i q'iij,</para>
  <para style="q">ruum parub'ehel ti q'atwik q'orik.</para>
  <para style="q">
    <verse number="165" style="v" />Eh re' taqe i kik'axwik reh aak'uhb'aal, xa eliik suq kik'ux,</para>
  <para style="q">eh ma' awach ta neenq'eb'wik keh pamahk.</para>
  <para style="q">
    <verse number="166" style="v" />QaJaaw Dios, re' hin k'ahchi' wuy-eem chi nee kinako'leej</para>
  <para style="q">ruum re' hin k'ahchi' kiin i ruq'or taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="167" style="v" />Re' hin i nunimaj i ruq'or taqe aak'uhb'aal,</para>
  <para style="q">eh q'e' nuk'ax chu'nchel wánima.</para>
  <para style="q">
    <verse number="168" style="v" />Korik chi nunimaj taqe aak'uhb'aal, eh i nuyeew nuk'ux chub'aan i taqe inaq'or.</para>
  <para style="q">Eh re' hat aweht'al chu'nchel i nuna'ojb'al.</para>
  <para style="q">
    <verse number="169" style="v" />QaJaaw Dios nee ta tii nayeew weh i nupahqaaj aweh.</para>
  <para style="q">Chayeew nuna'ojb'al, je' rukab' inaq'or weh ruuk' aq'oral.</para>
  <para style="q">
    <verse number="170" style="v" />Eh nee ta tii nab'iraj i nutiij.</para>
  <para style="q">Eh kinako'leej je' rukab' aaq'orom weh.</para>
  <para style="q">
    <verse number="171" style="v" />Re' hin juneliik naa kaat nuloq'em ruuk' nuchii',</para>
  <para style="q">ruum xak'uhtaaj weh i rukorkiil taqe aak'uhb'aal.</para>
  <para style="q">
    <verse number="172" style="v" />Eh naa nutz'uyem awach ye'b'al ruloq'il aak'uhb'aal</para>
  <para style="q">ruum re' re' manlik wach, eh xti korik.</para>
  <para style="q">
    <verse number="173" style="v" />Neeta naq kinatoob'eej ruuk' awajaawriik,</para>
  <para style="q">ruum re' taqe aak'uhb'aal xnusik' wach chi naa nub'anam taqe i ruq'or.</para>
  <para style="q">
    <verse number="174" style="v" />QaJaaw Dios, inwaaj i hin chi nee kinako'leej.</para>
  <para style="q">Ruum re' aak'uhb'aal inye'wik rusuqkiil nuk'ux.</para>
  <para style="q">
    <verse number="175" style="v" />Eh chayeew nuk'achariik, reh chi nee tinuloq'ej.</para>
  <para style="q">Re' ta naq i rukorkiil wach ak'ux neentoob'inik weh.</para>
  <para style="q">
    <verse number="176" style="v" />Re' hin ximahkunik chawach, xa je' naq hinsah cheel laj tentzun.</para>
  <para style="q">Kinako'leej tii hin, hin awaj kamanoom,</para>
  <para style="q">ruum ma' insahchik ta panuk'ux taqe aak'uhb'aal.</para>
  <chapter number="120" style="c" />
  <para style="s">Re' tiij xub'an i reey David noq xb'aan ti' k'axik reh</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin noq wilkiin panti' k'axik, re' QaJaaw Dios inuq'o'reej,</para>
  <para style="q">eh re' reh kirutob'eej wo' hoq.</para>
  <para style="q">
    <verse number="2" style="v" />QaJaaw Dios, kinako'leej tii pan kiq'ab' taqe i</para>
  <para style="q">chukul q'orik, taqe i ma' holohik ta kiq'orik chi wiij.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Raaj taq i hat aj chukul q'orik</para>
  <para style="q">¿chib'ih taq i naa ak'axam ruuk' taqe re'?</para>
  <para style="q">
    <verse number="4" style="v" />Re' taq i naa ak'ulum chi riij re' chi naa taq kaat kikutum chi flecha q'as ju',</para>
  <para style="q">naa taq kaat kik'atam ruuk' q'aaq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' hin q'e' ti' wilkiin chupaam i tinamit Mesec,</para>
  <para style="q">noq patinik i nub'an chi kixilak i aj Cedar.</para>
  <para style="q">
    <verse number="6" style="v" />Eh najtir inutoq'aa' wihik chi kixilak i</para>
  <para style="q">ma' ki ajwanik ta wach i wihik pansuqkiil k'uxliis.</para>
  <para style="q">
    <verse number="7" style="v" />Noq nuq'or chi naa qawihiik pansuqkiil k'uxliis,</para>
  <para style="q">re' keh peleto chik kinkichaq' weej wii'.</para>
  <chapter number="121" style="c" />
  <para style="s">Re' QaJaaw Dios incha'jinik aweh</para>
  <para style="q">
    <verse number="1" style="v" />Eh noq ti' wilkiin xintz'ehtanik chinaah taqe yuuq', je' wili i xnuq'or:</para>
  <para style="q">¿Aha' naa ruchaliik i naa rutoob'inik weh?</para>
  <para style="q">
    <verse number="2" style="v" />Re' i naa rutoob'iniik weh, re' i QaJaaw Dios</para>
  <para style="q">i xyej-anik reh i taxaaj i wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' reh intoob'inik aweh reh chi ma' nee ta naq'eb' awiib'.</para>
  <para style="q">Ruum re' reh ma' inwirik ta chacha'jaljiik.</para>
  <para style="q">
    <verse number="4" style="v" />Re' reh xti korik noq ma' inwirik taj</para>
  <para style="q">ma' nchalik ta ruwiriik incha'jinik keh i aj Israel.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' QaJaaw Dios incha'jinik aweh, re' reh inko'linik aweh,</para>
  <para style="q">eliik wilik awuuk' cha toob'jiik.</para>
  <para style="q">
    <verse number="6" style="v" />Ruum aj re', re' i rutz'a'iil i q'iij ma' xta naa kaat ruchem pan q'iij,</para>
  <para style="q">eh ma' xta naa kaat ruchem i poh chaq'ab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' QaJaaw Dios inko'linik aweh chupaam chu'nchel i yohb'aal,</para>
  <para style="q">eh re' reh inko'linik riij aak'achariik.</para>
  <para style="q">
    <verse number="8" style="v" />Re' QaJaaw Dios naa rucha'jiniik aweh noq naa aweliik reje, eh noq naa asutiniik chaloq.</para>
  <para style="q">Je' re' i naa rub'anam awuuk' yu'naak, eh je' chi juneliik.</para>
  <chapter number="122" style="c" />
  <para style="s">Re' tiij chi riij chi naa ruwihiik suq kiil k'uxliis Jerusaleem</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin ma' k'insiin ta nsuuqb'ik nuk'ux</para>
  <para style="q">noq kinkik'am reje parupaat i QaJaaw Dios.</para>
  <para style="q">
    <verse number="2" style="v" />Eh yu'naak i hoj wilkooj chik chi chii'</para>
  <para style="q">i ookb'al reh i tinamit Jerusaleem.</para>
  <para style="q">
    <verse number="3" style="v" />Re' Jerusaleem xkorb'eesjik reh chi ar</para>
  <para style="q">naakimolom kiib' pan jinaj wach k'uxliis i tinamit chulooq'jiik i QaJaaw Dios.</para>
  <para style="q">
    <verse number="4" style="v" />Eh ar naa kojiik jar ch'uq taqe i aj Israel</para>
  <para style="q">chut'iosjiik i rotob'il i Dios,</para>
  <para style="q">je' rukab' i xq'orarik keh pampeet.</para>
  <para style="q">
    <verse number="5" style="v" />Ar wo' pan tinamit Jerusaleem</para>
  <para style="q">wilik i kiye'aab' inki a'n wii' i q'ataj q'orik taqe i ruk'u'liil i reey David.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Chapahqaaj taq chi wih-oq pansuqkiil k'uxliis i Jerusaleem.</para>
  <para style="q">Eh nee ta naq kielik korik i kik'axwik taq aweh.</para>
  <para style="q">
    <verse number="7" style="v" />Neeta naq inwihik i suq kiil k'uxliis chupaam taq aatinamiit.</para>
  <para style="q">Eh ma' ta naq chih neen kik'ul pan kiye'aab' taqe awaj taaq'oom.</para>
  <para style="q">
    <verse number="8" style="v" />Ruum chi nuk'ax i nutinamiit, taqe i wamigo, naa nupahqaam reh i QaJaaw Dios</para>
  <para style="q">chi wih-oq i suq kiil k'uxliis Jerusaleem.</para>
  <para style="q">
    <verse number="9" style="v" />Eh ruum chi q'e' nuk'ax i rupaat QaJaaw Dios</para>
  <para style="q">naa nupahqaam ree reh chi naa rutoob'eem i nutinamiit.</para>
  <chapter number="123" style="c" />
  <para style="s">Re' rupahqaljiik reh i QaJaaw Dios chi chub'aan i ketelinik wachiis</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios wilkaat cho pan taxaaj</para>
  <para style="q">aweh i hat inupahqaaj chi naakiin atoob'eem.</para>
  <para style="q">
    <verse number="2" style="v" />QaJaaw Dios kow inqapahqaaj aawotob'il,</para>
  <para style="q">je' rukab' noq i rupahqaaj otob'il reh i rupatroon i winaq.</para>
  <para style="q">Eh je' rukab' noq i rupahqaaj otob'il ixoq reh i rupatroon ixoq.</para>
  <para style="q">Je' re' inqa a'n aweh i hat korehtaal inaketelaaj qawach.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />QaJaaw Dios chaketelaaj qawach, cha kuy chaketelaaj tii qawach,</para>
  <para style="q">ruum ma' nqakuy ta chik i qab'ajariik inki a'n</para>
  <para style="q">
    <verse number="4" style="v" />Re' hoj ti' wilkooj ruum i qakaqse'ljiik inki a'n taqe i b'ehomaq.</para>
  <para style="q">Eh ruum chi ma' qohponik ta panaq'kiwach taqe i nimaq kiwach.</para>
  <chapter number="124" style="c" />
  <para style="s">Re' rulooq'jiik i QaJaaw Dios xkian i aj Israel ruum i kiko'ljiik</para>
  <para style="q">
    <verse number="1" style="v" />Eh ¿Chib'ih naq i xqak'ul i hoj,</para>
  <para style="q">i hoj aj Israel wi ta ma' xojruko'leej i QaJaaw Dios?</para>
  <para style="q">
    <verse number="2" style="v" />¿Chib'ih naq ixqa a'n noq yohb'aal wach i kijosq'iil noq xi chalik chi qapletohjik</para>
  <para style="q">i aj ixowaal wi ta ma' xojrutoob'eej i QaJaaw Dios?</para>
  <para style="q">
    <verse number="3" style="v" />Eh ruum i kijosq'iil jumehq'iil naq xkisach qawach,</para>
  <para style="q">xoj kib'iq' naq chi k'achlik qawach.</para>
  <para style="q">
    <verse number="4" style="v" />Ruuk' naq i xkian qeh re' re' je' naa xojruqerej reje i kowlaj rooq haa'.</para>
  <para style="q">Eh xumuq'aa' qanaah i nim ha'.</para>
  <para style="q">
    <verse number="5" style="v" />Je' naa xik'ik chi qanaah i kowlaj rooq ha'</para>
  <para style="q">wi ta ma' xooj ruko'leej i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Ruum aj re' nee ta naq inye'arik ruloq'il i QaJaaw Dios,</para>
  <para style="q">ruum ma' xuyeew ta q'ab' chi xkisach qawach i ki-ixowanik qeh.</para>
  <para style="q">
    <verse number="7" style="v" />Re' hoj xojko'ljik chuwach i kantesb'al,</para>
  <para style="q">je' rukab' noq i ruq'uch reje riib' i tz'ikin pan xirob'</para>
  <para style="q">ruum ma' xi elik ta korik ruuk' i xkian naq qeh.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Eh re' i xtoob'inik qeh re' i QaJaaw Dios</para>
  <para style="q">ixyej-anik cho reh i taxaaj, i wach ak'al.</para>
  <chapter number="125" style="c" />
  <para style="s">Re' QaJaaw Dios i rucha'jeej taqe i rutinamiit</para>
  <para style="q">
    <verse number="1" style="v" />Awach taqe i kiye'em kik'ux ruuk' i QaJaaw Dios,</para>
  <para style="q">je' kikab' i yuuq' Sión ma' nk'uyu'jik ta paruye'aab', wilik paruye'aab' chi juneliik.</para>
  <para style="q">
    <verse number="2" style="v" />Nik' wach noq wilkeeb' i yuuq' chi junsuut i tinamit Jerusaleem,</para>
  <para style="q">je' re' noq rusutem riij i rutinamiit i QaJaaw Dios yu'naak, eh je' chi juneliik.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i yiib' wach kina'ojb'al</para>
  <para style="q">ma' chu'nchel ta q'iij naa kiwihiik</para>
  <para style="q">chi taaq'anik chinaah i kiye'aab' korik wach kik'ux.</para>
  <para style="q">Ruum ma' nkitoq'aa' inche keh i yiib' wach taqe i korik wach kik'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />QaJaaw Dios, cha a'n otob'il keh i holohik kina'ojb'al,</para>
  <para style="q">je' wo' taqe i korik wach kik'ux.</para>
  <para style="q">
    <verse number="5" style="v" />Eh re' i kib'anik reh i yiib' wach na'ojb'al,</para>
  <para style="q">chayeew taqe panti' k'axik je' rukab' inkik'ul i yiib' wach kina'ojb'al.</para>
  <para style="b" />
  <para style="q">Eh nee ta naq inwihik i suq kiil k'uxliis kuuk' i aj Israel.</para>
  <chapter number="126" style="c" />
  <para style="s">Re' tiij chi riij i kisutiniik wo' chik chaloq i aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Noq xojrusutej wo' chik cho Jerusaleem i QaJaaw Dios,</para>
  <para style="q">xa je' xqaxohk'reej noq xqakapaaj.</para>
  <para style="q">
    <verse number="2" style="v" />Ruum i re' xooj se'lanik</para>
  <para style="q">xqak'er qachii' chi looq'jiik ruum rusuqkiil qak'ux.</para>
  <para style="q">Eh re' taqe i tokoom tinamit je' wili i xkiq'or.</para>
  <para style="q">Ma' k'isa sahchb'al k'uxliis i xub'an i Dios kuuk', inki taqe.</para>
  <para style="q">
    <verse number="3" style="v" />Korik wo' hoq chi re' QaJaaw Dios ma' k'isiin i sahchb'al k'uxliis xub'an cho quuk'</para>
  <para style="q">ruum aj re' q'e' suq qak'ux yu'naak.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />QaJaaw Dios chayeew wo' chik rusuqkiil qak'ux</para>
  <para style="q">je' rukab' noq inat'aqsaj i chiq yuuq' Neguev.</para>
  <para style="q">
    <verse number="5" style="v" />Awach taqe oq'ik inki a'n noq inkitik,</para>
  <para style="q">ruuk' chik suq kiil k'uxliis inkisik' i wach i kitik.</para>
  <para style="q">
    <verse number="6" style="v" />Atoob' taoq'ik inki a'n noq kiooj chutikariik i kijaa'.</para>
  <para style="q">Eh noq neenq'anb'ik i wach i kitik xasuq suq chik</para>
  <para style="q">kik'ux noq neenkik'am chaloq pampaat.</para>
  <chapter number="127" style="c" />
  <para style="s">Chu'nchel i chib'ih wilik qeh re' qaDios inye'wik qeh</para>
  <para style="q">
    <verse number="1" style="v" />Wila' ma' re' QaJaaw Dios xyej-anik reh i paat</para>
  <para style="q">xama' xta neerutiq i neenkian i aj yej-an reh.</para>
  <para style="q">Eh wila' ma' re' i QaJaaw Dios incha'jinik reh i tinamit</para>
  <para style="q">xama' xta rutiq i neenkian i aj cha'joom.</para>
  <para style="q">
    <verse number="2" style="v" />Eh xama' xta neerutiq reh jino'q chi neenokik q'iij chi kamanik,</para>
  <para style="q">xa k'axik wo' noq nee rureq rukaxlanwi'k.</para>
  <para style="q">Eh re' QaJaaw Dios ma' k'axik ta noq</para>
  <para style="q">i ruyeew kikaxlanwi'k taqe i ruk'ax, i ruyeew kihi'liik.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' taqe i qak'uun qixq'uun ki-aasjik xa qakooch</para>
  <para style="q">noq i ruyeew cho qeh i QaJaaw Dios, eh xiik' naah kiloq'il chi qeh.</para>
  <para style="q">
    <verse number="4" style="v" />Re' taqe i qak'uun qixq'uun ki-aasjik noq ko hoj ak'un,</para>
  <para style="q">je' naa jinaj flecha chi qeh. Je' rukab' i ruko'leej wii' riib' i winaq kow riib'.</para>
  <para style="q">
    <verse number="5" style="v" />Atoob' reh awach i wilik k'ih-oq rak'uun rixq'uun,</para>
  <para style="q">ruum ma' naa ta ruk'ixiik</para>
  <para style="q">chikiwach taqe i ki-ixowanik wach,</para>
  <para style="q">noq naa ruq'orob'jiik panookb'al.</para>
  <chapter number="128" style="c" />
  <para style="s">Atoob' keh awach inkihyohleej wach i QaJaaw Dios</para>
  <para style="q">
    <verse number="1" style="v" />Atoob' reh awach i ruyohleej wach i QaJaaw Dios,</para>
  <para style="q">eh i ruk'am naah taqe ruk'uhb'aal.</para>
  <para style="q">
    <verse number="2" style="v" />Atoob' aweh i hat ruum naa a'nam rusuqkiil i tz'aaq aakamaj,</para>
  <para style="q">eh suq naa awihiik.</para>
  <para style="q">
    <verse number="3" style="v" />Eh re' awehk'een</para>
  <para style="q">je' rukab' noq kiwachinik i uuva wilkeeb' chi junsuut aapaat.</para>
  <para style="q">Eh re' taqe awak'uun awixq'uun chi junsuut aamexa,</para>
  <para style="q">je' kikab' i ruche'el olivo.</para>
  <para style="q">
    <verse number="4" style="v" />Re' QaJaaw Dios je' re' rukuxeesjiik</para>
  <para style="q">naa rub'anam i winaq inyohlinik reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh nee ta naq ti rukuxisaj chee QaJaaw Dios ko ar Sión.</para>
  <para style="q">Neeta naq inawilow chi suq chik wilkeeb'aj Jerusaleem, nik' chik najtiil aak'achariik</para>
  <para style="q">
    <verse number="6" style="v" />Konee ta naq inkilow aawiih aamaam,</para>
  <para style="b" />
  <para style="q">chi pansuqkiil k'uxliis chik wilkeeb' i aj Israel.</para>
  <chapter number="129" style="c" />
  <para style="s">Re' QaJaaw Dios ineesanik keh panti' k'axik i aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Re' taq i hat wuch aj Israel yohb'aal wach i ti' k'axik taq ak'ulum,</para>
  <para style="q">xa re' wo' rutohq'iik chee qatinamiit cha q'or taq chi je' wili:</para>
  <para style="q">
    <verse number="2" style="v" />Re' hoj yohb'aal wach i ti' k'axik qak'ulum, xa re' wo' rutohq'iik chee qatinamiit.</para>
  <para style="q">Xa re' la', xakomajaa' ta wo' chih qoh kuchej.</para>
  <para style="q">
    <verse number="3" style="v" />Eh yohb'aal wach ti'kiil inki a'n qeh, k'ahchi'kooj kiye'em chi tz'uhuum,</para>
  <para style="q">xa rukanaa' chik rehtalil chi qajurub'.</para>
  <para style="q">
    <verse number="4" style="v" />Eh re' QaJaaw Dios korik wach ruk'ux,</para>
  <para style="q">re' reh xko'linik qeh pan kiq'ab' i yiib' wach kina'ojb'al.</para>
  <para style="q">
    <verse number="5" style="v" />Neeta naq inkimol chi elik ruum kik'ixiik</para>
  <para style="q">taqe i ki-ixowanik wach i tinamit Sión.</para>
  <para style="q">
    <verse number="6" style="v" />Eh nee ta naq kikahnik chi xa je' kikab' i ch'ahn impoq' naah paat</para>
  <para style="q">inchiqik noq komajaa' inchuqarik.</para>
  <para style="q">
    <verse number="7" style="v" />Eh chi xa je' kikab' i ch'ahn xama' xta inkamanik wii' reh isik'il trigo,</para>
  <para style="q">eh ni xata kamanik reh imb'ak'wik paam chi chuhtaal.</para>
  <para style="q">
    <verse number="8" style="v" />Eh awach i ki-ik'ik ma' kiq'or ta chi je' wili:</para>
  <para style="q">Re' QaJaaw Dios inkuxisanik keh, ma' inko'q ta taqe.</para>
  <para style="q">Eh ni xata neenpahqaljik i rotob'il i Dios chikinaah.</para>
  <chapter number="130" style="c" />
  <para style="s">Re' taqe aj Israel xq'orarik keh chi naakuy-eem i rotob'il i Dios</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, noq inyot'ik i nuk'ux, aweh i hat i nupahqaaj nutoob'jiik.</para>
  <para style="q">
    <verse number="2" style="v" />Jaaw nee ta tii kinab'iraj.</para>
  <para style="q">Neeta nayeew weh i nupahqaaj</para>
  <para style="q">aweh ruuk' ruti'kiil nuk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />QaJaaw Dios, nee ta qohayeew chutojariik i qamahk</para>
  <para style="q">ma' awach ta naq neenkuywik reh aajosq'iil.</para>
  <para style="q">
    <verse number="4" style="v" />Inakuy inasach la' chu'nchel i qamahk,</para>
  <para style="q">re' nawaaj i hat chi naa kaat qaloq'em.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' hin chu'nchel nuk'ux</para>
  <para style="q">inwuy-eej chi naa kiin rutob'eem i QaJaaw Dios,</para>
  <para style="q">ruum ruuk' i reh ch'iklik nuk'ux.</para>
  <para style="q">
    <verse number="6" style="v" />Re' hin kinokik chi ruyub'jiik i rotob'il i QaJaaw Dios.</para>
  <para style="q">Je' rukab' noq inkuy-eej i saq'ik i aj cha'jen tinamit.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' taq i hat aj Israel chawuy-eej taq i rotob'il i</para>
  <para style="q">QaJaaw Dios, ruum re' reh aj keteloom wachiis.</para>
  <para style="q">Eh re' reh neenko'linik taq aweh.</para>
  <para style="q">
    <verse number="8" style="v" />Re' QaJaaw Dios naa ruko'liniik keh i</para>
  <para style="q">aj Israel ruuk' chu'nchel i kimahk.</para>
  <chapter number="131" style="c" />
  <para style="s">Re' i tiij chi riij i ye'ej k'uxliis ruuk' i Dios</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, re' hin ma' nunimb'isaj ta nuwach.</para>
  <para style="q">Eh ma' nunimb'isaj ta nuwach</para>
  <para style="q">ruuk' i ruk'axariik i xa chib'ih jariik.</para>
  <para style="q">Ma' nusik' taj i nimaq wach na'ojb'al k'axik chi reqarik chi riij.</para>
  <para style="q">
    <verse number="2" style="v" />Xa ma' kinchoqik ta la',</para>
  <para style="q">xa je' nukab' jino'q i ha'lak'un, kore' xye'arik ruch'uuch' ruum i rutuut.</para>
  <para style="q">Korik noq re' hin je' nukab' jino'q i ha'lak'un konuujinaq ruum i ruch'uuch'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh re' taq i hat wuch aj Israel chawuy-eej taq i rotob'il i QaJaaw Dios,</para>
  <para style="q">je' yu'naak, eh je' chi juneliik.</para>
  <chapter number="132" style="c" />
  <para style="s">Re' i xq'orarik cho reh i reey David ruum i Dios</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, chatoob'eej tii i reey David</para>
  <para style="q">ruuk' chu'nchel i ti' k'axik k'ahchi' ruk'ulum.</para>
  <para style="q">
    <verse number="2" style="v" />K'oloq panak'ux i xti korik xuq'or chaaweh</para>
  <para style="q">i hat QaJaaw Dios, ruDios i Jacob.</para>
  <para style="q">
    <verse number="3" style="v" />Re' reh je' wili i ruq'orom chaloq:</para>
  <para style="q">Re' hin ma' nee ta kinookik panupaat, eh ma' nee ta i nuyok'aa' wiib' chi hi'lik.</para>
  <para style="q">
    <verse number="4" style="v" />Eh ma' jaruuj neekinokik chi wirik,</para>
  <para style="q">ma' nee ta numutz' k'isinoq i naq'nuwach.</para>
  <para style="q">
    <verse number="5" style="v" />Korehtaal inqareq i rupaat i loq'laj kaxa molik wii' aak'uhb'aal.</para>
  <para style="q">Re' naa ahi'liik wii' i hat QaJaaw Dios, ruDios Jacob, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Eh noq wilkooj cho Efrata xqib'iraj cho rib'iral i loq'laj kaxa re' re'.</para>
  <para style="q">Eh ko ar xqareq chupaam i ye'aab' Jaar rub'ihnaal.</para>
  <para style="q">
    <verse number="7" style="v" />Je' re' noq, taq taq chupaam i paat wilik wii' i QaJaaw Dios.</para>
  <para style="q">Qaxuk'aa' cho qiib' ri'si rooq ri'si q'ab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios, kim yu'naak,</para>
  <para style="q">hat-oq junokiik chi wihik chupaam aaye'aab'</para>
  <para style="q">ruuk' i loq'laj kaxa, re' wilik wii' awajaawriik.</para>
  <para style="q">
    <verse number="9" style="v" />Eh korik ta naq wach kik'ux taqe i k'amal kib'eeh aj tiij.</para>
  <para style="q">Eh nee ta naq inwihik rusuqkiil kik'ux i wilik kisantohiil.</para>
  <para style="q">
    <verse number="10" style="v" />Je' re' i cha a'n ketelb'al wach i reey David asik'im cho wach,</para>
  <para style="q">re' awaj kamanoom, mat tib'isaj ruk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' QaJaaw Dios xuq'or i xti korik reh i reey David,</para>
  <para style="q">eh ma' xik'ik ta wach, je' wili i ruq'orom cho reh:</para>
  <para style="q">Re' hin re' taqe awak'uun awixq'uun</para>
  <para style="q">naa nukojom chi reyil chajilob'aal.</para>
  <para style="q">
    <verse number="12" style="v" />Eh wila' xkinimaj i nuk'uhb'aal</para>
  <para style="q">awak'uun awixq'uun,</para>
  <para style="q">eh wila' xkik'am naah i naa nuk'uhb'aleem taqe wii'.</para>
  <para style="q">Re' keh naa wo' nukojom taqe chi reyil chi juneliik, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Ruum re' i QaJaaw Dios</para>
  <para style="q">rusik'im wach i ye'aab' Sión, chi ar naa ruwihiik.</para>
  <para style="q">
    <verse number="14" style="v" />Eh je' wili i ruq'orom:</para>
  <para style="q">Chupaam i ye'aab' wili naa nuwihiik chi juneliik, ruum je' re' i xponik chi nuwach.</para>
  <para style="q">
    <verse number="15" style="v" />Naa nukuxisam chi manlik i ye'aab' wili</para>
  <para style="q">naa nuye'em k'uxumb'al keh i ma' xta wilik keh.</para>
  <para style="q">
    <verse number="16" style="v" />Eh re' hin naa nuko'liniik keh i k'amal kib'eeh aj tiij.</para>
  <para style="q">Re' taqe i wilik kisantohiil naakik'erem kichii' ruum i rusuqkiil kik'ux.</para>
  <para style="q">
    <verse number="17" style="v" />Eh chi kixilak i rak'uun rixq'uun i reey David,</para>
  <para style="q">naa reliik chaloq i naa ruwihiik rajaawriik chi reyil,</para>
  <para style="q">nusik'im cho wach, re' reh i saqum.</para>
  <para style="q">
    <verse number="18" style="v" />Re' taqe i naa rixowanik wach naa ruk'uhtaam kik'ixb'ilaal.</para>
  <para style="q">Eh re' reh naa ruwihiik rajaawriik chi juneliik, inki.</para>
  <chapter number="133" style="c" />
  <para style="s">Re' ruye'ariik ruloq'il i k'axooj, eh wihik pansuqkiil k'uxliis</para>
  <para style="q">
    <verse number="1" style="v" />Chakoj taq rehtaal chi ma' k'isiin ta holwochiil.</para>
  <para style="q">Eh ma' k'isiin ta loq'il noq re' taqe hermano</para>
  <para style="q">wilkeeb' pan komonil, pan jinaj wach k'uxliis.</para>
  <para style="q">
    <verse number="2" style="v" />Eh je' k'ohonkiil aséite</para>
  <para style="q">chihkamaj cho wach naah i Aarón rajaaw aj tiij,</para>
  <para style="q">xik'ik rut'aqsaj i rusinchii', eh xoj qohoq ko chi rooq i ruso'.</para>
  <para style="q">
    <verse number="3" style="v" />Je' rukab' noq inqajik chee mus jab' chinaah i yuuq' Hermón,</para>
  <para style="q">chikinaah taqe yuuq' ar Sión.</para>
  <para style="q">Eh ar xukuxisaj taqe i rutinamiit i QaJaaw Dios,</para>
  <para style="q">eh xuyeew keh i juneliik k'acharik.</para>
  <chapter number="134" style="c" />
  <para style="s">Re' kik'uhb'aljiik i kikamanik chupaam i rupaat i Dios</para>
  <para style="q">
    <verse number="1" style="v" />Chab'iraj taq chawunchelaal i hat</para>
  <para style="q">i tikamanik taq pantaq chaq'ab' chupaam i rupaat i QaJaaw Dios.</para>
  <para style="q">Chayeew taq ruloq'il i QaJaaw Dios.</para>
  <para style="q">
    <verse number="2" style="v" />Eh chajosaj taq aq'ab' chulooq'jiik i QaJaaw Dios,</para>
  <para style="q">noq wilkaat taq parusantolaj ye'aab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' ta naq i QaJaaw Dios i xyej-anik reh i taxaaj, i wach ak'al</para>
  <para style="q">neenkuxisanik taq weh chupaam i ye'aab' Sión.</para>
  <chapter number="135" style="c" />
  <para style="s">Re' k'achlik Dios wilik rajaawriik, re' taqe i tiyoox ma' xta kajaawriik</para>
  <para style="q">
    <verse number="1" style="v" />Qaloq'ej taq i rub'ihnaal i QaJaaw Dios.</para>
  <para style="q">Chaloq'ej taq i hat i tib'anik taq reh i rukamaj.</para>
  <para style="q">
    <verse number="2" style="v" />Chayeew taq ruloq'il i QaJaaw Dios i hat i wilkaat taq chupaam i rupaat.</para>
  <para style="q">Je' wo' taq i hat i wilkaat taq chi chii' i rupaat i QaJaaw Dios.</para>
  <para style="q">
    <verse number="3" style="v" />Chaloq'ej taq i QaJaaw Dios ruum re' reh q'e' atoob'.</para>
  <para style="q">Eh cha a'n taq atz'uuy ye'b'al ruloq'il, ruum re' reh q'e' chaq'laam.</para>
  <para style="q">
    <verse number="4" style="v" />Re' QaJaaw Dios xusik' cho wach i Jacob,</para>
  <para style="q">eh xusik' cho wach i Israel reh chi xukanaa' chi rutinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' hin weht'al chi korik chi xa re' wo' QaJaaw Dios</para>
  <para style="q">k'achlik wilik rajaawriik chikiwach taqe i tiyoox.</para>
  <para style="q">
    <verse number="6" style="v" />Re' QaJaaw Dios chib'ih i rub'an pan taxaaj,</para>
  <para style="q">i rub'an wo' wach ak'al, i rub'an wo' chinaah palaw,</para>
  <para style="q">i rub'an wo' pantaq i julkahq.</para>
  <para style="q">
    <verse number="7" style="v" />Eh i rutaq'aaj chaloq i suutz' chinaah chu'nchel i wach ak'al,</para>
  <para style="q">i ruyeew chaloq i kahoq noq i rub'an i jab',</para>
  <para style="q">eh i rutaq'aaj chaloq i teew wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' QaJaaw Dios xkansanik keh chu'nchel i peet kak'uun taqe i aj Egipto,</para>
  <para style="q">je' wo' chu'nchel i peet rak'uun i kichikoop.</para>
  <para style="q">
    <verse number="9" style="v" />Eh ma' k'isiin taqe i ma' ilooj taj xub'an ar Egipto</para>
  <para style="q">reh chi xchalik ruyo'jiik i reey, je' wo' taqe i kikamanik ruuk'.</para>
  <para style="q">
    <verse number="10" style="v" />Ma' k'isiin taqe i nimaq tinamit xusach kiwach.</para>
  <para style="q">Eh xusach wo' kiwach taqe i reey q'e' kow kiib'.</para>
  <para style="q">
    <verse number="11" style="v" />Xukansaj i Sehón, kireey i aj amorreo,</para>
  <para style="q">je' wo' hoq i Og, kireey i aj Basán,</para>
  <para style="q">je' wo' chu'nchel i kireey i aj Canaán.</para>
  <para style="q">
    <verse number="12" style="v" />Re' i kiye'aab' naq taqe i reey re' re',</para>
  <para style="q">xuyeew i QaJaaw Dios chi kikooch i rutinamiit Israel.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />QaJaaw Dios re' hat k'achalkaat chi juneliik.</para>
  <para style="q">Ruum aj re', juneliik naa ak'uliik pankik'ux i tinamit, xajarch'iht pa' naakik'iik.</para>
  <para style="q">
    <verse number="14" style="v" />Re' QaJaaw Dios parub'ehel naa ruq'atam i q'orik chikinaah i rutinamiit,</para>
  <para style="q">eh naa ruketelaam kiwach i raj kamanoom.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Re' taqe i tinamit, xa oro,</para>
  <para style="q">xa plata ruyej-aal i ki dios, xa kiyej-aniik winaq taqe.</para>
  <para style="q">
    <verse number="16" style="v" />Wilik kichii', xama' kiq'orik ta wo' hoq,</para>
  <para style="q">wilik wo' naq naq' kiwach, xama' ki-ilwik ta wo' hoq.</para>
  <para style="q">
    <verse number="17" style="v" />Wilik kixikin, xama' ki-ib'irinik ta wo' hoq.</para>
  <para style="q">Eh xama' k'achalkeeb' ta wo' hoq.</para>
  <para style="q">
    <verse number="18" style="v" />Eh eliik wach kimemil ruuk' taqe i tiyoox re' re' awach inyej-anik keh,</para>
  <para style="q">je' wo' taqe inimanik keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Hat taq aj Israel chayeew taq ruloq'il i QaJaaw Dios,</para>
  <para style="q">hat riih rumaam i Aarón chayeew taq ruloq'il i QaJaaw.</para>
  <para style="q">
    <verse number="20" style="v" />Hat riih rumaam i Leví chayeew taq ruloq'il i QaJaaw Dios.</para>
  <para style="q">Eh re' taq i hat i tiyohlinik reh i QaJaaw Dios chayeew taq ruloq'il.</para>
  <para style="q">
    <verse number="21" style="v" />Eh loq'imaj ta naq i QaJaaw Dios ar Sión,</para>
  <para style="q">ruum re' reh ar wilik Jerusaleem.</para>
  <para style="b" />
  <para style="q">Loq'imaj ta naq i QaJaaw Dios.</para>
  <chapter number="136" style="c" />
  <para style="s">Re' rulooq'jiik i QaJaaw Dios ruum juneliik wilik i ketelinik wachiis ruuk'</para>
  <para style="q">
    <verse number="1" style="v" />Chaloq'ej taq i QaJaaw Dios, ruum re' reh q'e' atoob',</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk.</para>
  <para style="q">
    <verse number="2" style="v" />Chaloq'ej taq i QaJaaw Dios, ruum nim rajaawriik chikiwach taqe i tiyoox,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="3" style="v" />Chaloq'ej taq i QaJaaw Dios, re' i ajaab'ees chikinaah taqe ajaab'ees,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Xa re' wo' reh, i QaJaaw i rub'an taqe i ma' ilooj taj,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="5" style="v" />Re' reh i xyej-anik reh i taxaaj ruuk' i runa'ojb'al,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="6" style="v" />Re' reh xyej-anik reh i wach ak'al chinaah i ha',</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="7" style="v" />Re' reh xyej-anik reh i q'iij je' wo' i poh,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="8" style="v" />Re' q'iij xuyejaa' reh chi naa rusihq'iniik pan q'iij,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' poh, re' taqe i ch'umiil xuyejaa' reh chi naa kisihq'iniik chaq'ab',</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' reh xkansanik keh chu'nchel i peet kak'uun i aj Egipto,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="11" style="v" />Re' reh x-eesanik cho Egipto i rutinamiit Israel,</para>
  <para style="q">ruum juneliik wilik i ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="12" style="v" />Eh ruuk' i runimaal i rajaawriik xresaj taqe chaloq,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="13" style="v" />Re' reh xch'aqwik panyejaal i kaq palaw,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk.</para>
  <para style="q">
    <verse number="14" style="v" />Re' reh x-ik'sanik cho keh i aj Israel chi yejaal i palaw,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="15" style="v" />Re' reh xkutwik chupaam i kaq palaw i kireey, i ki soldado aj Egipto,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="16" style="v" />Re' reh xb'esanik cho reh i rutinamiit chupaam i ye'aab' chiq yuuq',</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Re' reh xkansanik keh i reey q'e' nimaq kiwach,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="18" style="v" />Re' reh xkansanik keh i reey q'e' naq kow kiib',</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="19" style="v" />Re' reh xkansanik reh i Sehón, i kireey i aj amorreo,</para>
  <para style="q">ruum juneliik wilik i ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="20" style="v" />Re' reh xkansanik reh i Og, kireey i aj Basán,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="21" style="v" />Re' reh xch'aqwik reh i kiye'aab' naq i reey re' re',</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="22" style="v" />Eh re' reh xye'wik i ye'aab' re' re' keh i aj Israel re' taqe i raj kamanoom,</para>
  <para style="q">ruum juneliik wilik i ketelinik wachiis ruuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Re' reh intoob'inik qeh noq wilkooj panti' k'axik,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="24" style="v" />Re' reh inko'linik qeh pan kiq'ab' i ki-ixowanik qawach,</para>
  <para style="q">ruum juneliik wilik i ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="25" style="v" />Re' reh ink'uxlanik keh i tinamit, je' wo' taqe i chikop,</para>
  <para style="q">ruum juneliik wilik i ketelinik wachiis ruuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Chayeew taq ruloq'il i QaJaaw Dios wilik cho pan taxaaj,</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis ruuk.</para>
  <chapter number="137" style="c" />
  <para style="s">Re' ruti'kiil kik'ux i aj Israel noq xi wihik Babilonia</para>
  <para style="q">
    <verse number="1" style="v" />Noq inqatzunaa' qiib' chi chii'</para>
  <para style="q">taqe nim haa' ar Babilonia,</para>
  <para style="q">inchalik qoq'iim noq ink'ulik cho panqak'ux i tinamit, Sión.</para>
  <para style="q">
    <verse number="2" style="v" />Eh chinaah taqe i q'ab' i chee'</para>
  <para style="q">wilkeeb' ar inqat'uyaa' taqe qarpa.</para>
  <para style="q">
    <verse number="3" style="v" />Re' taqe i xi k'amwik reje qeh pan tokoom tinamit,</para>
  <para style="q">i xiq'uchwik chib'ih qeh, je' wili i xkiq'or qeh:</para>
  <para style="q">Chatz'uyej taq qeh i tz'uuy chi suq taq ak'ux</para>
  <para style="q">je' rukab' taq i natz'uyej Sión, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh ¿Nik' wach noq neenqatz'uyej i tz'uuy loq'oomb'al</para>
  <para style="q">reeh QaJaaw Dios pan tokoom tinamit?</para>
  <para style="q">
    <verse number="5" style="v" />Eh wila' xat sahchik panuk'ux i hat Jerusaleem,</para>
  <para style="q">i ruk'ul chi neenchiqik i rusak'aaj nuq'ab'.</para>
  <para style="q">
    <verse number="6" style="v" />Eh i ruk'ul chi nee ruchop i panujah-aay i waaq'</para>
  <para style="q">wila' ma' nuyeew chik awajaawriik,</para>
  <para style="q">wila' ma' tik'ulik chik panuk'ux, eh chi re' hat</para>
  <para style="q">ti ye'wik rusuqkiil nuk'ux i hat Jerusaleem.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />QaJaaw Dios maakanaa' chi je' re' i xkian qeh i aj Edom,</para>
  <para style="q">noq xb'aan reh i Jerusaleem je' wili xkiq'or:</para>
  <para style="q">Chasach taq wach,</para>
  <para style="q">chasach taq wach chi jumpech, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' taq hat aj Babilonia naa taq rusahchiik awach.</para>
  <para style="q">Atoob' reh awach naa ruq'ajwiik wach taq aweh</para>
  <para style="q">i ti' k'axik xa a'n taq qeh.</para>
  <para style="q">
    <verse number="9" style="v" />Atoob' reh awach i naa ruchopom taq aakok' ha'lak'uun,</para>
  <para style="q">eh naa ruq'ojib'eem wa taq ab'aj.</para>
  <chapter number="138" style="c" />
  <para style="s">Re' tiij loq'oomb'al reh i QaJaaw Dios ruum i rotob'il</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios re' hin naa kaat nuloq'em chu'nchel i wánima.</para>
  <para style="q">Eh xa re' wo' hat naa nutz'uyem awach, chikiwach i tiyoox.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin naa nuxuk'aam wiib' chupaam i aapaat,</para>
  <para style="q">reh alooq'jiik ruum hat aj keteloom wachiis,</para>
  <para style="q">eh korik wach ak'ux.</para>
  <para style="q">Eh ruum chi xa re' wo' ab'ihnaal,</para>
  <para style="q">xa re' wo' aq'oral nim rajaawriik chikinaah i xa chib'ih wilkeeb'.</para>
  <para style="q">
    <verse number="3" style="v" />Eh noq xnupahqaaj aawotob'il xinatob'eej wo' hoq, eh xayeew wo' ruman i rukowiil nuk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Chu'nchel i reey wilkeeb' sut i wach ak'al naa kaat kiloq'em</para>
  <para style="q">na'kib'iraj rib'iral i na a'nam, re' aq'orom cho ruuk' aachii'.</para>
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios re' hat chu'nchel naakitz'uyiniik awach, ruum taqe i xa a'n.</para>
  <para style="q">Eh ruum chi q'e' nim aaloq'il.</para>
  <para style="q">
    <verse number="6" style="v" />Re' hat q'e' inaketelaaj kiwach i xama' nimaq ta kiwach.</para>
  <para style="q">Eh ma' suq ta kilariik i na a'n i inkinimb'isaj kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Noq wilkiin panyohb'aal</para>
  <para style="q">re' hat ti ko'linik riij i nuk'achariik.</para>
  <para style="q">Eh i nayeew weh awajaawriik,</para>
  <para style="q">kinako'leej chuwach i kijosq'iil taqe i ki-ixowanik nuwach.</para>
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios, korehtaal inamanaa' wach awotob'il wuuk',</para>
  <para style="q">ruum juneliik wilik ketelinik wachiis awuuk'.</para>
  <para style="q">Je' re' noq, chamanaa' wach aakamaj atoq'aam cho wuuk'.</para>
  <chapter number="139" style="c" />
  <para style="s">Re' QaJaaw Dios reht'al chu'nchel chib'ih imb'aan</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, re' hat inawilow, eh aweht'al nik' wach noq wilkiin.</para>
  <para style="q">
    <verse number="2" style="v" />Eh aweht'al noq kinwuktik. Je' wo' noq kintzuhnik,</para>
  <para style="q">ko chi najt i nanaab'eej aha' wilik taqe i nukapaaj.</para>
  <para style="q">
    <verse number="3" style="v" />Re' hat aweht'al chib'ih taqe nub'an noq kinhi'lik.</para>
  <para style="q">Eh aweht'al chib'ih jariik taqe i nub'an panuk'achariik.</para>
  <para style="q">
    <verse number="4" style="v" />QaJaaw Dios, atoob' ta komajaa' i nelik i q'orik ju' waaq'</para>
  <para style="q">re' hat aweht'al chik chib'ih i naa nuq'orom.</para>
  <para style="q">
    <verse number="5" style="v" />Re' hat i peet chi nuwach, re' hat i xam chi wiij,</para>
  <para style="q">eh i nayeew aaq'ab' chi nunaah.</para>
  <para style="q">
    <verse number="6" style="v" />Re' ana'ojb'al xiik' naah loq'il chi wee hin, xiik' naah nimaal wach,</para>
  <para style="q">ma' nureq ta chi riij nik' wach noq i na a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¿Mi neerub'an re' chi nee nukeb'aa' wiib' chuwach aawuxlaab'al?</para>
  <para style="q">¿Mi neerub'an re' chi nenooj nukeb'aa' wiib' chawach?</para>
  <para style="q">
    <verse number="8" style="v" />Neeta kinjohtik pan taxaaj nee wo' kinawilow ar.</para>
  <para style="q">Eh nee ta kinooj ko paruchamiil ak'al kiye'aab' i kamnaq, nee wo' kinawilow ar.</para>
  <para style="q">
    <verse number="9" style="v" />Eh nee ta nuq'or reh i teew chi nee kiruk'am reje chi patinik</para>
  <para style="q">ko chi juntar i palaw wilik parelb'aal q'iij.</para>
  <para style="q">
    <verse number="10" style="v" />Xa nee wo' kinawilow ar ruuk' awajaawriik.</para>
  <para style="q">Eh xama' nee ta wo' kinakanaa'.</para>
  <para style="q">
    <verse number="11" style="v" />Eh nee ta nooj nukeb'aa' wiib' panq'equm,</para>
  <para style="q">nee ta nsutinik chi q'equm aq'ab' i saqum wilik chi nujunsuut.</para>
  <para style="q">
    <verse number="12" style="v" />Re' q'equm xama' nee ta wo' kirukeb'aa' chawach.</para>
  <para style="q">Ruum chawee hat xa eliik wach chaq'ab' ruuk' pan i q'iij.</para>
  <para style="q">Xa eliik wach q'equm ruuk' saqum cha weh i hat.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' wo' hat xatyej-anik cho reh chu'nchel i nuti'jolal.</para>
  <para style="q">Eh re' wo' hat xatz'uhkrisanik cho weh ruuk' i nutuut.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hin tinuloq'ej ruum insahchik nuk'ux</para>
  <para style="q">i rub'an taqe akamaj a'nam.</para>
  <para style="q">Eh xiik' naah loq'il chu'nchel i a'nam, xti nunimaj chi je' re'.</para>
  <para style="q">
    <verse number="15" style="v" />Re' hat xawilow</para>
  <para style="q">noq xkorjik chu'nchel i nuti'jolal.</para>
  <para style="q">Ma' re' ta nkiwii' chi ma' eht'alimaj xintz'uhkrik chaloq ruuk' i nutuut.</para>
  <para style="q">
    <verse number="16" style="v" />Re' hat xawilow noq xkorjik i nuti'jolal,</para>
  <para style="q">chu'nchel i re' xanoq wo' atz'ihb'aam chaloq.</para>
  <para style="q">Xa noq wo' awajlaam cho riij</para>
  <para style="q">i nuq'ijil noq komajaa' kin-aasjik.</para>
  <para style="q">
    <verse number="17" style="v" />QaJaaw Dios, yohb'aal inche wach</para>
  <para style="q">nimaal wach taqe akapeew chi wee hin.</para>
  <para style="q">Xiik' naah loq'il chu'nchel noq inooj taqe ruk'ul riib'.</para>
  <para style="q">
    <verse number="18" style="v" />Eh nee ta naq inwajlaaj ma' nee ta naq i nukuy</para>
  <para style="q">rajaljiik ruum ma' xata je' k'ihaal i saniib',</para>
  <para style="q">eh noq inwik'raaj wiib' xa wilkaat wo' wuuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />QaJaaw Dios nee ta naq inasach kiwach i yiib' wach kina'ojb'al,</para>
  <para style="q">chawesaj taqe chi nuwach i aj kansan kas kichaaq.</para>
  <para style="q">
    <verse number="20" style="v" />Re' taqe i ma' holohik ta kiq'orik chawiij,</para>
  <para style="q">eh inkiq'or ab'ihnaal chi xama' xta rub'ehel.</para>
  <para style="q">
    <verse number="21" style="v" />QaJaaw Dios, re' hin inwixowaaj kiwach i ki-ixowanik awach i hat.</para>
  <para style="q">Ma' nwaaj ta kiwach taqe inkiq'ehtaaj kiib' chawach.</para>
  <para style="q">
    <verse number="22" style="v" />Ma' imponik ta chi nuwach inki a'n</para>
  <para style="q">ma' k'isiin ta inwixowaaj kiwach.</para>
  <para style="q">
    <verse number="23" style="v" />QaJaaw Dios, chawilow chib'ih taqe jariik i wilik cho pan wánima,</para>
  <para style="q">kinapaj reh chi nee nanaab'eej i nukapeb'aal.</para>
  <para style="q">
    <verse number="24" style="v" />Eh kinawilow, wila' re' i yiib' wach b'eeh inuk'am,</para>
  <para style="q">kinak'am tii chupaam i b'eeh ma' naa ta rusahchiik wach.</para>
  <chapter number="140" style="c" />
  <para style="s">Re' reey David xupahqaaj parutiij chi naa ruko'ljiik ruum i Dios</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, kinako'leej pan q'ab' i yiib' wach runa'ojb'al.</para>
  <para style="q">Kinako'leej pan kiq'ab' i yohb'aal wach kijosq'iil.</para>
  <para style="q">
    <verse number="2" style="v" />Re' taqe i xa re' wo' yiib' wach na'ojb'al wilik pankanima,</para>
  <para style="q">xa re' wo' peleto inki a'n chu'nchel q'iij.</para>
  <para style="q">
    <verse number="3" style="v" />Re' ju' kaaq' ma' ahl ta chi q'orik, je' rukab' i raaq' i aaq'.</para>
  <para style="q">Re' kiq'oral xanoq wo' inkansanik je' rukab' i rub'an i rukiih i aaq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />QaJaaw Dios kinako'leej pan kiq'ab' i yiib' wach kina'ojb'al, je' wo'</para>
  <para style="q">pan kiq'ab' i yohb'aal wach kijosq'iil. Re' ikiyejaam wach i nukanteesjiik.</para>
  <para style="q">
    <verse number="5" style="v" />Eh nimaq kiwach inki a'n kiib', inkikoj i xirob' panub'eeh,</para>
  <para style="q">xa nkisik' chik chi riij nik' wach noq naa kianam weh.</para>
  <para style="q">Eh inkiq'at panub'eeh reh chi naa nuq'ehb'iik.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' hin je' wili i nuq'orom cho reh i QaJaaw:</para>
  <para style="q">Re' hat, i hat nuDios, chayeew ti weh i nupahqaaj aweh,</para>
  <para style="q">chu'nchel nuk'ux.</para>
  <para style="q">
    <verse number="7" style="v" />QaJaaw Dios, nim awajaawriik hat aj ko'len weh,</para>
  <para style="q">eh xinako'leej pan kiq'ab' i aj q'aq'ineel reh chi ma' xta xinkuchej, kinki reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios, maayeew q'ab' reh i yiib' wach runa'ojb'al chi neenelik korik</para>
  <para style="q">ruuk' taqe iraaj rub'anam, ruuk' taqe i rukapaaj.</para>
  <para style="q">Reh chi ma' nee ta runimb'isaj riib'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' taqe i re' k'ul kiokik chaloq chub'anariik weh.</para>
  <para style="q">Re' taqe i yiib' wach q'orik i nelik cho pan</para>
  <para style="q">kichii' naa ruk'amwiik chee ti' k'axik chikinaah.</para>
  <para style="q">
    <verse number="10" style="v" />Re' taqe re' naq'wach q'aaq' qoplik</para>
  <para style="q">ruq'aq'al naa ruye'ariik chikinaah.</para>
  <para style="q">Eh naakikutariik chupaam i jul ma' jaruuj chik naakeliik cho ar.</para>
  <para style="q">
    <verse number="11" style="v" />Re' ma' holohik ta nq'orik xama' najt ta naa ruk'achariik ayu' wach ak'al.</para>
  <para style="q">Re' i yohb'aal wach josq'iil re' ti' k'axik naa rusachwiik wach reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' hin weht'al chi re' QaJaaw Dios naa ruketeliniik wach i ti' ruk'ux.</para>
  <para style="q">Eh re' reh naa rutoob'iniik reh i ma' xta wilik reh.</para>
  <para style="q">
    <verse number="13" style="v" />QaJaaw Dios re' taqe i korik wach kik'ux naa kiloq'inik reh aab'ihnaal.</para>
  <para style="q">Re' taqe i holohik kina'ojb'al naa kik'achariik chawach.</para>
  <chapter number="141" style="c" />
  <para style="s">Re' reey David xupahqaaj parutiij i rotob'il i Dios</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, re' hin nupahqaaj aawotob'il kinab'iraj tii</para>
  <para style="q">chi jumehq'iil. Chayeew weh i nupahqaaj aweh.</para>
  <para style="q">
    <verse number="2" style="v" />Eh nee ta naq imponik awuuk' i nutiij chi je' k'ohonkiil insensia.</para>
  <para style="q">Noq i nujosaj i nuq'ab' chawach je' ta naq rukab'</para>
  <para style="q">i mayiij inkiyeew chawach pantaq xq'eq.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />QaJaaw Dios kinaq'il ruuk' i nuq'oral.</para>
  <para style="q">Kinaq'il reh chi ma' nee ta nelik reje i yiib' wach q'orik panuchii'.</para>
  <para style="q">
    <verse number="4" style="v" />Eh maayeew q'ab' chi nee ruq'or nuk'ux taqe i yiib' wach na'ojb'al.</para>
  <para style="q">Reh chi ma' nee ta nub'an weh</para>
  <para style="q">inki a'n i ma' holohik ta kib'anik.</para>
  <para style="q">Eh ma' nee ta kinokik haa' chub'aan i kininq'iij taqe re'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh wila' kow xiruq'il i korik wach ruk'ux, otob'il neerub'an weh,</para>
  <para style="q">je' ink'ohnik laj iq'oom ineerujalk'iij wach nunaah. Eh kow neenub'an nutiij,</para>
  <para style="q">reh chi ma' nee ta inkahnik chi je' re' inki a'n weh i yiib' wach kina'ojb'al.</para>
  <para style="q">
    <verse number="6" style="v" />Re' i k'amal kib'eeh i yiib' wach kina'ojb'al naa kikutarik chaloq naa paat ab'aj.</para>
  <para style="q">Eh ar naa kikojom rehtaal chi re' i nuq'or i korik.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' i kib'aqil xa aha' naa rukahniik tzuub' chi chii' i rujuleel kamnaq.</para>
  <para style="q">Je' rukab' noq inkahnik tzuub' aak'al noq ink'otarik reje paam.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios, re' hin awuuk' i nuyeew inaq'nuwach.</para>
  <para style="q">Eh awuuk' hat inusik' ko'lemb'al wiib',</para>
  <para style="q">ruum weht'al chi ma' nee ta kinakanaa' chi wutkeel.</para>
  <para style="q">
    <verse number="9" style="v" />Jaaw kinako'leej tii chuwach i kixirob'.</para>
  <para style="q">Re' keh inkikoj i xirob' panub'eeh, reh chi naa kianam weh.</para>
  <para style="q">
    <verse number="10" style="v" />Eh re' ta naq i yiib' wach kina'ojb'al neekiq'ehb'ik chupaam i kixirob',</para>
  <para style="q">eh re' hin, nee kinooj chi nuwach.</para>
  <chapter number="142" style="c" />
  <para style="s">Re' tiij xub'an i reey David noq wilik panti' k'axik</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin kow i nupahqaaj i rotob'il i QaJaaw Dios.</para>
  <para style="q">Eh kow i nupahqaaj reh chi naa ruketelaam nuwach.</para>
  <para style="q">
    <verse number="2" style="v" />Eh xa reh wo' reh i nuq'or taqe i ti' k'axik inchalik chi nunaah.</para>
  <para style="q">Reh wo' reh i nuq'or taqe i ruti'kiil nuk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh noq xiik' naah ti'kiil i wánima,</para>
  <para style="q">re' hat Jaaw aweht'al inuk'achariik.</para>
  <para style="q">Eh xa aha' ta chik ma' nkikoj i xirob'</para>
  <para style="q">panub'eeh reh chi naa kianam weh.</para>
  <para style="q">
    <verse number="4" style="v" />Eh noq kintz'ehtanik</para>
  <para style="q">reje panusak'aaj</para>
  <para style="q">ma' awach taj ink'u'loq chi nutoob'jiik.</para>
  <para style="q">Ma' awach ta wo' ink'ulik ko'linoq weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios, re' hin i nupahqaaj aawotob'il,</para>
  <para style="q">je' wili i nuq'or: Re' hat ti ko'linik weh,</para>
  <para style="q">xa re' wo' hat wilkaat chinaah i nuk'achariik ayu', kinki.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Jaaw, chayeew tii weh i nupahqaaj aweh,</para>
  <para style="q">ruum q'e' ti' nuk'ux.</para>
  <para style="q">Kinako'leej pan kiq'ab' i ki-ixowanik nuwach,</para>
  <para style="q">ruum re' keh q'e' taqe kow kiib' chi nuwach i hin.</para>
  <para style="q">
    <verse number="7" style="v" />Re' hin je' naa pantz'ilom wilkiin.</para>
  <para style="q">Kinako'leej tii reh chi nee tinuloq'ej,</para>
  <para style="q">eh re' taqe i korik wach kik'ux naa rusuuqb'iik kik'ux wuuk'</para>
  <para style="q">noq naakib'iram chi xinako'leej.</para>
  <chapter number="143" style="c" />
  <para style="s">Re' tiij xub'an i reey David pahqb'al ko'lemb'al riib'</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios, chab'iraj tii i nutiij,</para>
  <para style="q">chayeew weh i nupahqaaj aweh.</para>
  <para style="q">Ruum re' hat q'e' hat atoob', eh korik wach ak'ux.</para>
  <para style="q">
    <verse number="2" style="v" />Ma' q'at i q'orik chi nunaah i hin, hin awaj kamanoom,</para>
  <para style="q">ruum chawach i hat ma' awach ta i nee ruq'or chi ma' xta ru mahk.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' taqe i ki-ixowanik nuwach inki a'n ti' k'axik weh,</para>
  <para style="q">xinkiyeq' panak'al.</para>
  <para style="q">Eh je' panq'equm wilkiin kuum,</para>
  <para style="q">je' nukab' taqe i kamnaq.</para>
  <para style="q">
    <verse number="4" style="v" />Re' hin ma' suq ta k'isinoq i nub'an kuum,</para>
  <para style="q">xantolik i wánima ruum i ruti'kiil nuk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' hin ink'ulik panuk'ux i q'iij</para>
  <para style="q">ik'inaq taqe chaloq i nukapaaj riij taqe i a'nam chaloq.</para>
  <para style="q">Je' wo' chu'nchel ayejaam taqe cho ruuk' aq'ab'.</para>
  <para style="q">
    <verse number="6" style="v" />Re' hin awuuk' hat i nujosaj i nuq'ab'</para>
  <para style="q">ruum re' wánima chiqiij chii' reh asik'ariik,</para>
  <para style="q">je' rukab' i chiq ak'al xaraaj chik ruhaa'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />QaJaaw Dios, chayeew tii weh chi jumehq'iil i nupahqaaj aweh,</para>
  <para style="q">ruum re' hin xama' kow ta chik nuk'ux inwik'raaj.</para>
  <para style="q">Eh wila' ma' xinatob'eej nee kinkahnik</para>
  <para style="q">chi je' kikab' i kamnaq.</para>
  <para style="q">
    <verse number="8" style="v" />QaJaaw Dios, rajlaal ta naq wahq'eq neenuk'ul aawotob'il,</para>
  <para style="q">ruum awuuk' i hat nuye'em nuk'ux.</para>
  <para style="q">Eh cha k'uhtaaj weh i naa nub'anam,</para>
  <para style="q">ruum awuuk' hat i nupahqaaj nuna'ojb'al.</para>
  <para style="q">
    <verse number="9" style="v" />Jaaw, kinako'leej tii pan kiq'ab' i ki-ixowanik nuwach,</para>
  <para style="q">ruum awuuk' i hat inusik' ko'lemb'al wiib'.</para>
  <para style="q">
    <verse number="10" style="v" />Eh cha k'uhtaaj weh rub'anariik inawaaj,</para>
  <para style="q">ruum re' hat i nuDios.</para>
  <para style="q">Re' ta naq aawuxlaab'al q'e' atoob' neenk'amwik weh</para>
  <para style="q">chupaam i korik laj b'eeh.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />QaJaaw Dios, chako'leej riij i nuk'achariik reh chi nee nuloq'ej aab'ihnaal.</para>
  <para style="q">Ruum chi korik wach ak'ux naa kiin awesam chupaam i ti' k'axik.</para>
  <para style="q">
    <verse number="12" style="v" />Eh ruum chi naaketelaaj nuwach chasach</para>
  <para style="q">kiwach i ki-ixowanik nuwach.</para>
  <para style="q">Chasach kiwach chu'nchel i kiye'wik ruti'kiil nuk'ux ruum re' hin, hin awaj kamanoom.</para>
  <chapter number="144" style="c" />
  <para style="s">Re' reey David xupahqaaj parutiij ree Dios chi naa ruko'ljiik</para>
  <para style="q">
    <verse number="1" style="v" />Neeta naq inye'arik ruloq'il i QaJaaw Dios</para>
  <para style="q">re' i paat ab'aj ko'lemb'al iib' chi weh.</para>
  <para style="q">Re' reh intijinik weh chi q'aq'inik.</para>
  <para style="q">
    <verse number="2" style="v" />Re' reh inketelinik nuwach, waj ko'loom,</para>
  <para style="q">ye'el rukowiil nuk'ux, esan weh panti' k'axik.</para>
  <para style="q">Eh pulato ch'ihch' ko'lemb'al iib' chi weh,</para>
  <para style="q">ruuk' i reh i nuyeew nuk'ux, i ruq'asaj chi ri'sil i wajaawriik i nutinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />QaJaaw Dios, ¿Chib'ih rub'anam i winaq chi tiqaaj kapeew chi riij?</para>
  <para style="q">Eh ¿Chib'ih rub'anam i xa rak'uun winaq chi ti' nawik'raaj?</para>
  <para style="q">
    <verse number="4" style="v" />Ruum re' ruk'achariik, xa je' nik'ik jun huup chi teew.</para>
  <para style="q">Eh xa je' nik'ik jino'q muuj.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />QaJaaw Dios, chaqasaj chaloq awajaawriik</para>
  <para style="q">kopan taxaaj k'oloq atz'aa'j taqe yuuq' reh chi nee nelik kisib'eel.</para>
  <para style="q">
    <verse number="6" style="v" />Chayeew chaloq taqe kahoq chikinaah i ki-ixowanik nuwach,</para>
  <para style="q">ruuk' flecha chakut taqe, reh chi neenkitukej kiib'.</para>
  <para style="q">
    <verse number="7" style="v" />Eh chayeew chaloq aq'ab' chi nunaah kopan taxaaj, kinako'leej.</para>
  <para style="q">Eh kinawesaj chupaam i je' chaamlaj ha' wilkiin wii'.</para>
  <para style="q">Kinako'leej pan kiq'ab' i tokoom tinamit.</para>
  <para style="q">
    <verse number="8" style="v" />Ruum re' keh xama' xta rub'ehel i kiq'oral,</para>
  <para style="q">xa re' i chukuj q'orik inkaaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />QaJaaw Dios, re' hin jinaj i ak'laj tz'uuy naa nutz'uyem ye'b'al aloq'il.</para>
  <para style="q">Eh naa nutz'uyem taqe i tz'uuy ruuk' taqe nu k'ahaam wach q'ooj.</para>
  <para style="q">
    <verse number="10" style="v" />Re' i hat ti esanik keh korik i reey.</para>
  <para style="q">Re' hat titoob'inik weh i hin David, hin awaj kamanoom,</para>
  <para style="q">chi ma' kinkikansaj ta ruuk' q'aslaj ch'ihch'.</para>
  <para style="q">
    <verse number="11" style="v" />Eh kinawesaj, kinako'leej</para>
  <para style="q">tii pan kiq'ab' taqe i tokoom tinamit.</para>
  <para style="q">Re' taqe i xama' xta rub'ehel kiq'orik,</para>
  <para style="q">xa re' chukuj q'orik inkaaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />QaJaaw Dios,</para>
  <para style="q">chayeew tii kikowiil i qak'uun,</para>
  <para style="q">je'-oq kik'ihik johtoq i k'ijol chee' chi xilak uhtz'ub'.</para>
  <para style="q">Re' taqe i qixq'uun je' ta naq kikab' i ruch'itil i nimlaj paat.</para>
  <para style="q">
    <verse number="13" style="v" />Chatoob'eej i qatik,</para>
  <para style="q">reh chi neenqamol panye'aab' reh i xa reh reh wach chi k'uxumb'al qeh.</para>
  <para style="q">Reh chi neenk'ihaaxb'ik i qachikoop,</para>
  <para style="q">korehtaal kiponik chi yohb'aal wach kik'ihaal chupaam i qaye'aab'.</para>
  <para style="q">
    <verse number="14" style="v" />Eh chayeew tii kikowiil taqe i qab'ooyax inqakoj reh qakamaj.</para>
  <para style="q">Ma' ta naq awach i neenokik chi i leq' panqatinamiit</para>
  <para style="q">reh chi ma' awach taj ineeruk'er chii' ruum ruyo'jiik.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Atoob' reh i tinamit i je' re' ruk'ulariik i rotob'il i Dios i rub'an.</para>
  <para style="q">Atoob' reh i tinamit i xa re' k'achlik Dios i rukoj chi ruDios.</para>
  <chapter number="145" style="c" />
  <para style="s">Chu'nchel ta naq i tinamit neekiloq'iniik reh i Dios</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin naa nuye'em i runimaal awach ruum hat nuDios, hat nuReey.</para>
  <para style="q">Eh naa nuye'em runimaal wach chi juneliik aab'ihnaal.</para>
  <para style="q">
    <verse number="2" style="v" />Raaj laal q'iij naa nuye'em runimaal awach,</para>
  <para style="q">eh naa nuloq'em chi juneliik ab'ihnaal.</para>
  <para style="q">
    <verse number="3" style="v" />Re' QaJaaw Dios xiik' naah nimaal wach, ruum aj re' ruk'ul chi naa ruye'ariik ruloq'il.</para>
  <para style="q">Re' i runimaal wach ma' aha' ta chi je'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh chi tuut, chi ajaaw, chi-iih maam naakiye'wiik ruloq'il taqe akamaj.</para>
  <para style="q">Eh naa kiq'orom chikiwach chi xiik' naah loq'il i a'nam taqe chaloq.</para>
  <para style="q">
    <verse number="5" style="v" />Naa wo' ruq'orariik rib'iral i runimaal awach q'e' looq',</para>
  <para style="q">re' hin naa nuq'orom rib'iral i nimaq kiwach na'ojb'al i na a'n.</para>
  <para style="q">
    <verse number="6" style="v" />Re' tinamit naa kiq'orom rib'iral i xiik' naah yohb'alil kiwach a'nam chaloq.</para>
  <para style="q">Eh re' hin naa nuq'orom rib'iral i runimaal awach.</para>
  <para style="q">
    <verse number="7" style="v" />Naa wo' kiq'orom rib'iral aawotob'il xiik' naah nimaal wach,</para>
  <para style="q">kow naa kiq'orom rib'iral chi re' hat korik wach ak'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' QaJaaw Dios q'e' atoob', eh aj keteloom wachiis,</para>
  <para style="q">ma' jumehq'iil ta nchalik rujosq'iil ruum wilik ketelinik wachiis ruuk'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' QaJaaw Dios q'e' atoob' chu'nchel aj uuk',</para>
  <para style="q">ruuk' q'unil i rucha'jeej taqe chu'nchel i ruyejaam chaloq.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Eh nee ta naq tikiloq'ej chu'nchel ayejaam chaloq.</para>
  <para style="q">Eh nee ta naq inkiyeew runimaal awach asantolaj aj nimaneel.</para>
  <para style="q">
    <verse number="11" style="v" />Neeta naq inkiq'or rib'iral i runimaal aaloq'il.</para>
  <para style="q">Eh nee ta naq inkiq'or rib'iral awajaawriik.</para>
  <para style="q">
    <verse number="12" style="v" />Neeta naq inkiyeew chi naab'jik awajaawriik keh i tinamit.</para>
  <para style="q">Je' wo' hoq i ruloq'il i runimaal awajaawriik.</para>
  <para style="q">
    <verse number="13" style="v" />Re' runimaal awajaawriik naa ruwihiik chi juneliik.</para>
  <para style="q">Eh naa awihiik chi taaq'anik chikinaah, i</para>
  <para style="q">jar ch'iht chi k'achareel inaakik'iik.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />QaJaaw Dios, re' hat ti ye'wik rukowiil kik'ux taqe i rub'an kiib' kik'ux.</para>
  <para style="q">Eh re' wo' hat titoob'inik keh i wilkeeb' panti' k'axik.</para>
  <para style="q">
    <verse number="15" style="v" />Chu'nchel i k'achareel inkuy-eej aawotob'il</para>
  <para style="q">reh chi nee nayeew i kiwa' kihaa' paruorahiil.</para>
  <para style="q">
    <verse number="16" style="v" />Jaaw, chayeew tii keh ajwaal wach chi keh.</para>
  <para style="q">Chayeew aawotob'il chikinaah taqe i k'achareel.</para>
  <para style="q">
    <verse number="17" style="v" />Re' QaJaaw Dios korik wach ruk'ux ruuk' taqe i rub'an.</para>
  <para style="q">Eh i ruketelaaj kiwach chu'nchel i ruyejaam chaloq.</para>
  <para style="q">
    <verse number="18" style="v" />Re' QaJaaw Dios, ma' najt ta wilik kuuk' i kipahqanik reh i rotob'il.</para>
  <para style="q">Re' taqe i korik wach kik'ux chupahqaljiik i rotob'il.</para>
  <para style="q">
    <verse number="19" style="v" />Eh i ruyeew i ajwaal wach chi keh i kiyohlinik ree reh.</para>
  <para style="q">Noq inkipahqaaj reh chi naa kitoob'jiik, ki-ib'irjik, kiko'ljik wo' hoq.</para>
  <para style="q">
    <verse number="20" style="v" />Re' i QaJaaw Dios i ruko'leej taqe i kik'axwik reh.</para>
  <para style="q">Eh i rusach kiwach taqe i yiib' wach kina'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Neeta naq inuloq'ej ruuk' nuchii' i QaJaaw Dios.</para>
  <para style="q">Chu'nchel ta naq neekiye'wik ruloq'il i rusantolaj b'ihnaal,</para>
  <para style="q">je' yu'naak, je' chi juneliik.</para>
  <chapter number="146" style="c" />
  <para style="s">Re' rulooq'jiik i Dios ruum taqe rub'anam chaloq</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin naa nuloq'em</para>
  <para style="q">i QaJaaw Dios pan wánima.</para>
  <para style="q">
    <verse number="2" style="v" />Naa nuloq'em i QaJaaw Dios panuk'achariik.</para>
  <para style="q">Naa nutz'uyem wach nik' pa' chik najtiil wilkiin ayu'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Maayeew taq ak'ux chikinaah i ajaab'ees</para>
  <para style="q">Ni xata chinaah chik jino'q i winaq ruum re' reh xama' inko'linik ta wo' hoq.</para>
  <para style="q">
    <verse number="4" style="v" />Eh noq inkimik kisutinik wo' chik chi pooq ak'al.</para>
  <para style="q">Eh xa chupaam i q'iij re' re' insahchik wach aha' naq wilik taqe i rukapaaj rub'aan.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Atoob' reh awach i ruk'ul i rotob'il i QaJaaw re' ruDios i Jacob.</para>
  <para style="q">Eh ruuk' wo' i RaJaaw i ruDios i ruyeew i ruk'ux.</para>
  <para style="q">
    <verse number="6" style="v" />Re' xyej-anik reh i taxaaj, i wach ak'al,</para>
  <para style="q">i palaw, je' wo' chu'nchel i wilkeeb' chupaam taqe re'.</para>
  <para style="q">Eh i rub'an taqe i ruq'or.</para>
  <para style="q">
    <verse number="7" style="v" />Re' rub'ehel i rub'an kuuk' i ti' wilkeeb'.</para>
  <para style="q">Eh i ruyeew kiwa' taqe i nuhmeel.</para>
  <para style="b" />
  <para style="q">Eh i resaj taqe panti' k'axik i je' pantz'ilom wilkeeb'.</para>
  <para style="q">
    <verse number="8" style="v" />Re' QaJaaw Dios i ruteh inaq'kiwach i moywach</para>
  <para style="q">Eh i ruksaj taqe i q'ehb'eel,</para>
  <para style="q">i ruk'ax taqe i korik wach kik'ux.</para>
  <para style="q">
    <verse number="9" style="v" />Re' QaJaaw Dios i ruko'leej taqe i tokoom tinamit,</para>
  <para style="q">taqe i ma' xta kituut kajaaw, taqe ixoq kamnaq kib'ahiil.</para>
  <para style="q">Eh i ruyoj wach inkiyejaa' wach i yiib' wach kina'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' taq i hat i aj Sión, re' taq aaWaJaaw aaDios naa ruwihiik chi taaq'anik,</para>
  <para style="q">xa jar ch'iht pa' chi k'achareel naa kik'iik.</para>
  <para style="b" />
  <para style="q">Neeta naq inye'arik ruloq'il.</para>
  <chapter number="147" style="c" />
  <para style="s">Re' tz'uuy ye'b'al ruloq'il i Dios ruum otob'il xub'an kuuk' i aj Jerusaleem</para>
  <para style="q">
    <verse number="1" style="v" />Loq'imaj ta naq i QaJaaw Dios.</para>
  <para style="q">Xiik' naah holwochiil rutz'uyjiik wach.</para>
  <para style="q">Ruum xa re' wo' reh i ruk'ul chi naa qaloq'em ruuk' suq kiil k'uxliis.</para>
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw Dios naa wo' chik ruyejaam i Jerusaleem, naa wo'</para>
  <para style="q">chik rumolom kiwach i aj Israel tukimaj kiwach.</para>
  <para style="q">
    <verse number="3" style="v" />Re' reh i resaj i kiti'kiil taqe inyot'ik i kánima,</para>
  <para style="q">eh iriq'omaj taqe ruuk' i kiti'kiil.</para>
  <para style="q">
    <verse number="4" style="v" />Re' reh i rajlaaj taqe chu'nchel i ch'umiil,</para>
  <para style="q">eh i ruq'or i kib'ihnaal chi ju'junaal.</para>
  <para style="q">
    <verse number="5" style="v" />Xti xiik' wo' chik naah nimaal wach i QaJaaw Dios.</para>
  <para style="q">Eh q'e' nim rajaawriik, xiik' naah loq'il taqe i runa'ojb'al.</para>
  <para style="q">
    <verse number="6" style="v" />Re' QaJaaw Dios i ruyeew runimaal kiwach i xama' nimaq ta kiwach,</para>
  <para style="q">eh i resaj chi jumpech i runimaal kiwach taqe i yiib' wach kina'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Chatz'uyej taq wach i QaJaaw Dios, chi t'iosb'al reh i rotob'il.</para>
  <para style="q">Chatz'uyej taq wach i qaDios ruuk' arpa.</para>
  <para style="q">
    <verse number="8" style="v" />Ruum re' reh imb'urwik paam i taxaaj ruuk' i suutz'.</para>
  <para style="q">Re' reh inyej-anik cho wach i jab' i ruyeew cho chinaah i wach ak'al.</para>
  <para style="q">Re' reh ink'isanik reh i kok' ch'ahn wa taq yuuq'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' reh inketwik keh chikop,</para>
  <para style="q">re' reh inketwik keh i kak'uun taqe i nimaq taq tz'ok,</para>
  <para style="q">noq k'erlik kichii' chupahqaljiik kiwa'.</para>
  <para style="q">
    <verse number="10" style="v" />Re' QaJaaw Dios ma' nsuuqb'ik ta ruk'ux ruuk' i kaansil i kawáyu,</para>
  <para style="q">je' wo' ruuk' i kikowiil taqe i xa winaq.</para>
  <para style="q">
    <verse number="11" style="v" />Insuuqb'ik la' ruk'ux i QaJaaw Dios kuuk' i kik'axwik reh.</para>
  <para style="q">Eh inkiyeew kik'ux ruuk' chi naa ruketeljiik kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Hat taq aj Jerusaleem chaloq'ej taq i QaJaaw Dios,</para>
  <para style="q">hat taq aj Sión chaloq'ej taq aaDios.</para>
  <para style="q">
    <verse number="13" style="v" />Re' reh inko'linik reh taq aatinamiit pan kiq'ab' i aj ixowaal.</para>
  <para style="q">Re' reh intoob'inik taq aweh i wilkaat taq chupaam aatinamiit re' re'.</para>
  <para style="q">
    <verse number="14" style="v" />Re' i Dios inye'wik i suq laj k'achariik chupaam taq aatinamiit.</para>
  <para style="q">Eh i ruyeew taq chaaweh i chihooj laj trigo.</para>
  <para style="q">
    <verse number="15" style="v" />Eh re' reh i rutaq'aaj chaloq i ruq'oral wach ak'al,</para>
  <para style="q">eh chi jumehq'iil inooj rib'iral xa aha'.</para>
  <para style="q">
    <verse number="16" style="v" />Eh i ruyeew i ha' chaaj chi xa je' chik saq lana.</para>
  <para style="q">Eh ruum i reh i rupuhkaaj riib' i ha' chaaj,</para>
  <para style="q">xa je' chik rukab' noq i rupuhkaaj riib' i pooq.</para>
  <para style="q">
    <verse number="17" style="v" />Eh i ruyeew chaloq i chaaj chi je' ruwii' saq b'och,</para>
  <para style="q">eh ruuk' i k'uxik i ruyeew i rujoot'isaj taqe ha' xa jot'ik chik paam.</para>
  <para style="q">
    <verse number="18" style="v" />Noq i ruq'or chi naa kihab'ik i ha'chaj kitoyom naq kiib' kihab'ik wo' chik.</para>
  <para style="q">Eh ruuk' i teew i ruyeew chaloq i rutoq'aa' b'ehik i rooq ha'.</para>
  <para style="q">
    <verse number="19" style="v" />Re' QaJaaw Dios xuyeew chi naab'jik i ruk'uhb'aal reh i Jacob.</para>
  <para style="q">Je' wo' keh i aj Israel taqe i ruq'or i ruk'uhb'aal.</para>
  <para style="q">
    <verse number="20" style="v" />Re' QaJaaw Dios ma' je' ta re' i xub'an kuuk'</para>
  <para style="q">chu'nchel i tinamit ma' xuyeew ta keh chi naab'jik taqe i ruq'or i ruk'uhb'aal.</para>
  <para style="b" />
  <para style="q">Loq'imaj ta naq i QaJaaw Dios.</para>
  <chapter number="148" style="c" />
  <para style="s">Ye'aroq ruloq'il i Dios kuum chu'nchel i rutz'ukrisam chaloq</para>
  <para style="q">
    <verse number="1" style="v" />Chaloq'ej taq i QaJaaw Dios i hat i wilkaat taq pantaxaj.</para>
  <para style="q">Chayeew taq ruloq'il pan taxaaj.</para>
  <para style="q">
    <verse number="2" style="v" />Chaloq'ej taq i QaJaaw Dios i hat, i hat ruánjel.</para>
  <para style="q">Je' wo' taq i hat ruk'ihaal taq chaawiib' ruchopom taq anaah ar pan taxaaj.</para>
  <para style="q">
    <verse number="3" style="v" />Chaloq'ej i QaJaaw Dios i hat q'iij, je' wo' hat poh.</para>
  <para style="q">Chaloq'ej wo' taq i QaJaaw Dios hat ch'umiil i tisihq'inik taq.</para>
  <para style="q">
    <verse number="4" style="v" />Chaloq'ej QaJaaw Dios i hat taxaaj, najt wilkaat chaloq,</para>
  <para style="q">je' wo' hat ha' wilkaat pan taxaaj.</para>
  <para style="q">
    <verse number="5" style="v" />Chaloq'ej taq i rub'ihnaal i QaJaaw Dios,</para>
  <para style="q">ruum noq xuq'or i reh chi naa kikorjiik xi korjik wo' chu'nchel.</para>
  <para style="q">
    <verse number="6" style="v" />Eh chu'nchel xuyeew taqe paruye'aab' reh juneliik.</para>
  <para style="q">Eh aha' wilik i xuq'or keh ma' awach ta naa ruq'atwiik wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Chaloq'ej taq i QaJaaw Dios i hat wach ak'al.</para>
  <para style="q">Je' wo' taq i hat nimaq josq'laj chikop wilkaat</para>
  <para style="q">taq pam palaw, eh i wilkaat taq pantaq jul.</para>
  <para style="q">
    <verse number="8" style="v" />Eh chuloq'ej QaJaaw Dios i ruch'aab' i kahoq,</para>
  <para style="q">i saq b'och, i mus jab', i raab' suutz'.</para>
  <para style="q">Je' wo' hoq i kowlaj teew jab' i rub'an i q'orooj reh ruum i reh.</para>
  <para style="q">
    <verse number="9" style="v" />Eh kiloq'ej i QaJaaw Dios taqe inajt naah yuuq', taqe i rub'ohl yuuq'.</para>
  <para style="q">Je' wo' i chee' chakaltee', taqe i chee' kiwachinik,</para>
  <para style="q">
    <verse number="10" style="v" />taqe i chikop xa ruuk' paat kiwihik, taqe i josq'laj chikop.</para>
  <para style="q">Je' wo' taqe i chikop kirupinik, taqe i kijukem kiib' noq kib'ehik.</para>
  <para style="q">
    <verse number="11" style="v" />Je' wo' taqe i reey wilkeeb' i wach ak'al, taqe chu'nchel i tinamit.</para>
  <para style="q">Je' wo' taqe k'amal b'eeh, taqe i wilkeeb' chi ajaab'esil wach ak'al.</para>
  <para style="q">
    <verse number="12" style="v" />Eh kiloq'ej i QaJaaw Dios taqe i tinamit</para>
  <para style="q">chi winaq chi ixoq, chi nimaq, chi kok' taq.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Chaloq'ej taq i rub'ihnaal i QaJaaw Dios,</para>
  <para style="q">ruum xa re' wo' reh xiik' nah nimaal wach.</para>
  <para style="q">Eh xiik' naah nimaal wach chinaah i wach ak'al, je' wo' pan taxaaj.</para>
  <para style="q">
    <verse number="14" style="v" />Re' i QaJaaw Dios</para>
  <para style="q">xye'wik ruloq'il i rutinamiit Israel.</para>
  <para style="q">Xuyeew runimaal kiwach chu'nchel i santo laj raj nimaneel.</para>
  <para style="b" />
  <para style="q">Loq'imaj ta naq i QaJaaw Dios.</para>
  <chapter number="149" style="c" />
  <para style="s">Re' rulooq'jiik i Dios, ruum re' reh aj tz'uhk'risoom, eh manlik reey</para>
  <para style="q">
    <verse number="1" style="v" />Loq'imaj ta naq i QaJaaw Dios.</para>
  <para style="q">Chatz'uyej taq i ak'laj tz'uuy ye'b'al ruloq'il i QaJaaw Dios.</para>
  <para style="q">Cha a'n taq chaxilak taq i hat i wilik taq asantohiil.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Suuqb'oq kik'ux i aj Israel ruuk' i QaJaaw Dios, je' wo' taqe i aj Sión,</para>
  <para style="q">ruum re' reh tz'uhk'risanik cho keh, re' reh kiReey.</para>
  <para style="q">
    <verse number="3" style="v" />Eh kiyeew ruloq'il i rub'ihnaal i kipisk'anoq pankooq</para>
  <para style="q">ruuk' arpa, ruuk' setset laj q'ooj.</para>
  <para style="q">
    <verse number="4" style="v" />Ruum ruuk' re' insuuqb'ik ruk'ux i QaJaaw Dios kuuk' i rutinamiit, eh i ruyeew kiloq'il.</para>
  <para style="q">Eh i ruko'leej taqe, i xama' nimaq ta kiwach.</para>
  <para style="q">
    <verse number="5" style="v" />Eh suuqb'oq kik'ux i wilik kisantohiil, ruum xi elik korik,</para>
  <para style="q">atoob' ta koyokolkeeb' wach kich'aht kian kitz'uuy.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Kiyeew kik'ux chulooq'jiik i QaJaaw Dios ruuk' kichii',</para>
  <para style="q">eh wilik-oq pan kiq'ab' i kich'ihch' k'ul q'as.</para>
  <para style="q">
    <verse number="7" style="v" />Reh chi neenkiq'aj wach imb'aan keh kuum i nimaq tinamit,</para>
  <para style="q">eh chi neenk'ik'saj chi ti' taqe i wilkeeb' pankok' tinamit.</para>
  <para style="q">
    <verse number="8" style="v" />Reh chi neenkib'ak' wach taqe i reey.</para>
  <para style="q">Eh neenkib'ak' wach chi karena ch'ihch' taqe i kow inki a'n kiib' chi taaq'anik.</para>
  <para style="q">
    <verse number="9" style="v" />Reh chi naa ruq'atariik i q'orik chikinaah je' rukab' i ruq'orom i QaJaaw Dios.</para>
  <para style="q">Ruuk' i wili xuyeew kiloq'il chu'nchel i wilik kisantohiil.</para>
  <para style="b" />
  <para style="q">Loq'imaj ta naq i QaJaaw Dios.</para>
  <chapter number="150" style="c" />
  <para style="s">Re' ruq'orariik chi naa rulooq'jiik i Dios ruuk' i xa reh reh wach chi q'ooj</para>
  <para style="q">
    <verse number="1" style="v" />Chaloq'ej taq i QaJaaw Dios chupaam i rupaat.</para>
  <para style="q">Chaloq'ej taq ruum taqe i xuyejaa' cho ruuk' i rajaawriik.</para>
  <para style="q">
    <verse number="2" style="v" />Chaloq'ej taq i QaJaaw Dios ruum taqe i rukamaj rub'anam chaloq.</para>
  <para style="q">Chaloq'ej taq ruum xiik' naah nimaal wach.</para>
  <para style="q">
    <verse number="3" style="v" />Eh chaloq'ej taq ruuk' i ruxuljiik taq aatuun.</para>
  <para style="q">Chaloq'ej taq ruuk' i ruq'ojiik taq aawarpa, ruuk' i aa kok' k'ahaam wach q'ooj.</para>
  <para style="q">
    <verse number="4" style="v" />Chaloq'ej taq i QaJaaw Dios ruuk' i setset laj q'ooj, tipisk'anoq taq panawooq.</para>
  <para style="q">Chaloq'ej taq ruuk' aaxuul q'ooj, ruuk' i k'ahaam kiwach q'ooj.</para>
  <para style="q">
    <verse number="5" style="v" />Chaloq'ej taq i QaJaaw Dios ruuk' i pulato ch'ihch' intzalajinik,</para>
  <para style="q">ruuk' i setesaq q'ooj intzalajinik.</para>
  <para style="q">
    <verse number="6" style="v" />Chu'nchel i wilik kuxlab'al kiloq'ej i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">Loq'imaj ta naq i QaJaaw Dios. <figure style="fig" desc="" file="BQ00174" size="SPAN" loc="" copy="" ref="">Ruuk' taqe q'ooj wili xlooq'jik chaloq i Dios.</figure></para>
</usx>