<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="LAM" style="id">LAMPOK.SFK 16-07-2,008 Adelina Quej. Pocomchi. Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">LAMENTACIONES</para>
  <para style="toc3">Lam</para>
  <para style="toc2">Lam</para>
  <para style="toc1">LAMENTACIONES</para>
  <para style="mt2">RE' I RUHUUJ I LAMENTACIONES</para>
  <para style="mt1">LAMENTACIONES</para>
  <chapter number="1" style="c" />
  <para style="s">Re' runimaal ruti'kiil ruk'ux i Jerusaleem</para>
  <para style="q">
    <verse number="1" style="v" />Re' tinamit Jerusaleem q'e' ti' xukul ruum xk'ahnik chi rutkeel.</para>
  <para style="q">Eh re' naq i reh xti nim wach,</para>
  <para style="q">chikinaah i k'ihset chi tinamit,</para>
  <para style="q">eh yu'naak xkahnik chi je' rukab' i ixoq kamnaq rub'ahiil,</para>
  <para style="q">ruum xk'amarik reje pankowlaj kamanik i rutinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Xa suq chik inoq'ik rajlaal aq'ab', xantz'urik chik i riis inaq'wach.</para>
  <para style="q">Eh re' taqe ink'axwik naq reh ma' jino'q chik i ye'wik rusuqkiil ruk'ux.</para>
  <para style="q">Eh re' taqe i naah ramigo xjot'arik kuum,</para>
  <para style="q">xi sutinik chi ixowan wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' taqe i aj Judá xi k'amarik reje pa ti' k'axik pankowlaj kamanik,</para>
  <para style="q">pan tokoom tinamit, ar chik k'acharik inki a'n ponoq yu'naak, xa</para>
  <para style="q">ma' kihilik ta chik.</para>
  <para style="q">Eh ma' inki a'n ta chik eliik chikiwach inixowanik kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh xan tz'irik chik paam taqe i b'eeh inooj Sión</para>
  <para style="q">ruum ma' awach ta chik ink'ulik chi ninq'ijinik.</para>
  <para style="q">Eh re' taqe i ookb'al reh i tinamit xan tz'irik chik.</para>
  <para style="q">Re' taqe i k'amal kib'eeh i aj tiij xasuq chik kioq'ik.</para>
  <para style="q">Eh re' taqe i q'ahxoq, eh chu'nchel i aj Jerusaleem xati' chik kik'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' inixowan wach xi elik korik re' chik i keh imb'anik i taaq'anik chinaah,</para>
  <para style="q">ruum re' i QaJaaw Dios xtib'isanik ruk'ux ruum ma' k'isiin i mahk xub'an chuwach.</para>
  <para style="q">Eh re' taqe i rak'uun rixq'uun xi k'amarik reje</para>
  <para style="q">pan tokoom tinamit chikiwach inixowanik kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Eh xsahchik wach i ruholwochiil i tinamit Sión.</para>
  <para style="q">Re' taqe i k'amal kib'eeh xak'ul chik kiooj</para>
  <para style="q">xa je' chik kikab' i keej ma' nkireq ta kiwa'.</para>
  <para style="q">Re' keh xama' xta chik kaansil noq xi elik naq chikiwach i aj ixowaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' taqe i aj Jerusaleem noq wilkeeb' panti' k'axik,</para>
  <para style="q">kuum i aj ixowaal ma' awach ta xtoob'inik keh.</para>
  <para style="q">Eh noq ti' wilkeeb' xk'ulik pankik'ux chi ma' xinimanik taj,</para>
  <para style="q">xk'ulik pankik'ux kib'ehomal.</para>
  <para style="q">Eh xk'ulik pankik'ux noq xchoparik kinaah kuum i aj ixowaal,</para>
  <para style="q">eh xikaqse'ljiik kuum.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' taqe i aj Jerusaleem ma' k'isiin i mahk xkian,</para>
  <para style="q">ruum i re' xi ehteesjik reje pan kiye'aab'.</para>
  <para style="q">Eh re' naq taqe inye'wik kiloq'il,</para>
  <para style="q">ma' x-ajawjik ta chik kiwach kuum, ruum pank'ixb'ilaal chik wilkeeb'.</para>
  <para style="q">Eh xasuq chik kioq'ik, xan kikeb'aa' chik i kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' keh xruxlab'ej i kiso' i ruch'uwa'iil kiwach,</para>
  <para style="q">eh ma' nkikapaaj taj chib'ih i naakik'ulum.</para>
  <para style="q">Eh noq xkik'ul i ti' k'axik ma' awach ta</para>
  <para style="q">xye'wik rusuqkiil kik'ux, je' naq chik wili i xkiq'or:</para>
  <para style="q">QaJaaw Dios chawilow xkesaj</para>
  <para style="q">i qajaawriik i aj ixowaal, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' taqe i aj ixowaal xkichop naah</para>
  <para style="q">i kib'ehomal i aj Jerusaleem.</para>
  <para style="q">Re' i tinamit xkilow noq yohb'aal wach i kijosq'iil</para>
  <para style="q">i tokoom tinamit chupaam i santo laj ye'aab',</para>
  <para style="q">re' i aq'orom i hat QaJaaw Dios chi ma' naa ta kokiik awuuk' ar.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Chu'nchel i rutinamiit xioq'ik,</para>
  <para style="q">xak'ul chik kiooj chi rusik'ariik kiwa',</para>
  <para style="q">reh chi ma' xikimik taj,</para>
  <para style="q">xkiyeew i kib'ehomal chi riij, je' wili i xkiq'or:</para>
  <para style="q">QaJaaw Dios chawilow i ti' k'axik inqak'ul, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Eh je' wili xkiq'or reh i kik'ik ar.</para>
  <para style="q">¿Mi ma' intib'ik taq ak'ux ruum i ti' k'axik</para>
  <para style="q">k'ahchi' qak'ulum? ¿Mi wilik ink'ulwik reh i ti' wili?</para>
  <para style="q">Re' hoj qeht'al noq re' i QaJaaw Dios</para>
  <para style="q">xtaaq'anik cho reh i ti k'axik wili ruum xqop wach i rujosq'iil.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Eh je' q'aaq' xuqasaj cho pan taxaaj chi qanaah,</para>
  <para style="q">xponik kochuwach taqe i qab'aqil.</para>
  <para style="q">Je' xirob' i xuyeew panqab'eeh reh chi xesaj qajaawriik,</para>
  <para style="q">eh xoj rukanaa' chi qutkeel chuk'ulariik i ti' k'axik rajlaal i q'iij.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Ruum chixiik'naah i qamahk,</para>
  <para style="q">re' QaJaaw Dios xoj ruyeew panti' k'axik</para>
  <para style="q">ahl laj ihq i xuyeew chi qanaah.</para>
  <para style="q">Eh xama' xta chik qansil inqik'raaj</para>
  <para style="q">xoj ruyeew pan kiq'ab' i ki-ixowanik qawach,</para>
  <para style="q">xama' qakuy ta chik pan kiq'ab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Re' QaJaaw Dios xusach kiwach</para>
  <para style="q">i qa soldado q'e' kow kiib'.</para>
  <para style="q">Eh xuk'am taqe chaloq i tokoom tinamit</para>
  <para style="q">chusachariik kiwach i qak'ijool.</para>
  <para style="q">Eh xuyeew i ti' k'axik chikinaah i aj Judá</para>
  <para style="q">je' rukab' noq inyeq'arik paam i uuva chupaam i yitz'b'al reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Re' i k'ahchi' qak'ulum wili qoh oq'ik ruum,</para>
  <para style="q">ma' awach ta inye'wik rusuqkiil qak'ux, rukowiil qak'ux.</para>
  <para style="q">Xsahchik kiwach i qak'uun qixq'uun,</para>
  <para style="q">ruum re' taqe i ki-ixowanik qawach</para>
  <para style="q">ma' xqakuy ta pan kiq'ab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Re' taqe i aj Sión xkisik' naq kitoob'jiik,</para>
  <para style="q">xama' awach ta wo' xye'wik rusuqkiil kik'ux.</para>
  <para style="q">Re' QaJaaw Dios xuyeew q'ab' chi re' taqe</para>
  <para style="q">i riih rumaam i Jacob naa rixowjiik kiwach ruum i kika'jaah.</para>
  <para style="q">Eh chi re' taqe i aj Jerusaleem naa rixowjiik kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Re' QaJaaw Dios rub'ehel i xub'an qeh,</para>
  <para style="q">ruum re' hoj ma' xqanimaj taj i ruq'oral.</para>
  <para style="q">Re' taq i hat tinamit chakoj taq rehtaal</para>
  <para style="q">i ti' k'axik k'ahchi' qak'ulum,</para>
  <para style="q">re' taqe i qak'ijolaaq,</para>
  <para style="q">taqe i qaq'ahxoqaaq xi k'amarik reje pan tokoom tinamit.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Eh xqapahqaaj naq qatoob'jiik keh i kik'axwik qeh,</para>
  <para style="q">ma' xkaaj taj. Re' taqe i k'amal b'eeh i aj tiij,</para>
  <para style="q">taqe i nimaq wach kina'ojb'al</para>
  <para style="q">xkuxik kikimiik panqatinamiit.</para>
  <para style="q">Eh xak'ul naq chik kiooj chusik'ariik i kiwa'</para>
  <para style="q">reh naq chi ma' naa ta kikimiik.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />QaJaaw Dios chaketelaaj ti qawach ruuk' i ti' k'axik wili,</para>
  <para style="q">xanaa chik ruk'eriik i chi' qak'ux noq inqik'raaj,</para>
  <para style="q">eh xan yot'ik chik i qanima, noq ink'ulik cho pan qak'ux chi ma' xoj nimanik taj.</para>
  <para style="q">Pantaq b'eeh q'aq'inik inkansanik keh i qak'uun</para>
  <para style="q">qixq'uun, eh panqapaat yab'ilaal inkasanik keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Eh inkib'iraj wo' naq qoq'iim, xama' awach ta wo' xye'wik rusuqkiil qak'ux.</para>
  <para style="q">Re' i ki-ixowanik qawach keht'al chi k'ahchi' qak'ulum</para>
  <para style="q">i ti' k'axik insuuqb'ik kik'ux chi riij i xa a'n qeh.</para>
  <para style="q">Chayeew chikinaah aaq'orom cho rib'iral,</para>
  <para style="q">reh chi neen kik'ul kekeh i ti' k'axik wili.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Xponik chik awuuk' taqe i kiyiib' wach na'ojb'al,</para>
  <para style="q">chayeew taqe chutojariik i kimahk je' rukab'</para>
  <para style="q">i xa a'n quuk' i hoj ruum ma' xat qanimaj taj.</para>
  <para style="q">Re' hoj ma' k'isiin taj oq'ik inqa a'n ruum,</para>
  <para style="q">re' qanimaxiik'naah ti'kiil wilik, inki taqe.</para>
  <chapter number="2" style="c" />
  <para style="s">Re' rukab' runimaal ruti'kiil k'uxliis chikiij i aj Sión</para>
  <para style="q">
    <verse number="1" style="v" />Re' QaJaaw Dios xuqequmb'risaj paam i Jerusaleem,</para>
  <para style="q">ruum i rujosq'iil xresaj i ruloq'il qatinamiit Israel, xuyeew panak'al.</para>
  <para style="q">Eh ruum i rujosq'iil ma' xuketelaaj ta wach i rupaat ye'aab' reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw Dios xusach wach i kipaat i riih rumaam i Jacob, je' wo'</para>
  <para style="q">inajt kinaah tz'aq inkiko'leej wii' kiib' i aj Judá.</para>
  <para style="q">Xresaj i rajaawriik i reey, je' wo' taqe i kitaaq'anik ruuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh ruum i rujosq'iil xresaj i kajaawriik i aj Israel,</para>
  <para style="q">ma' xojrutoob'eej ta chik ruuk' i rajaawriik noq xi k'uloq i aj ixowaal chi qanaah.</para>
  <para style="q">Eh je' q'aaq' i xuqop cho chi kixilak i riih rumaam i Jacob, kuxik ruk'atam taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' i QaJaaw Dios je' rukab' i aj ixowaal wilik ru flecha ruuk'</para>
  <para style="q">ruum xusach wach chu'nchel i xiik' naq naah holwochiil.</para>
  <para style="q">Eh chupaam i kiye'aab' taqe i aj Sión yohb'aal wach</para>
  <para style="q">noq xuyeew rujosq'iil xa je' chik rukab' i xaq q'aaq' insachwik.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' i QaJaaw Dios xub'an je' rukab' i rub'an i aj ixowaal xusach kiwach i aj Israel,</para>
  <para style="q">je' wo' i paat inki a'n wii' i taaq'anik i reey.</para>
  <para style="q">Eh xusach wach i paat inkiko'leej wii' kiib',</para>
  <para style="q">ma' k'isa ti' k'axik xuyeew chikinaah i aj Judá.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Ma' xuketelaaj ta wach noq xusach wach i rupaat,</para>
  <para style="q">je' wo' ye'aab' i molarik wii' iib'.</para>
  <para style="q">Ruuk' i re', re' QaJaaw xusach pankik'ux i tinamit taqe i ninq'ijinik,</para>
  <para style="q">i rumolariik taqe i hi'limb'al q'iij, ar Sión.</para>
  <para style="q">Eh ruum i rujosq'iil ma' xponik ta chik</para>
  <para style="q">chuwach i reey, je' wo' taqe i k'amal b'eeh aj tiij.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' QaJaaw Dios ma' xponik ta chik chuwach ru artaal, i rusantolaj ye'aab',</para>
  <para style="q">xuyeew pan kiq'ab' i aj ixowaal i koraal tz'aq ko'lb'al reh</para>
  <para style="q">i tinamit, reh chi xkisacham wach i rupaat i reey.</para>
  <para style="q">Eh xak'erik chik kichii' parupaat i Dios</para>
  <para style="q">xa je' chik rukab' noq imb'aan ninq'iij ar.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Eh re' i QaJaaw Dios xuyejaa' cho wach chi naa rusachariik wach</para>
  <para style="q">i tz'aq kotimaj wii' riij i holohik laj tinamit Sión, xub'an chi jumehq'iil.</para>
  <para style="q">Xusach kiwach i tz'aq, je' wo' taqe paat najt naah xkuxik ruch'ahaam wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' taqe i ru puertahiil i tinamit xi q'ehb'ik wach ak'al, xitoqib'ik i lutz'b'al reh.</para>
  <para style="q">Re' kireey, re' taqe i k'amal kib'eeh</para>
  <para style="q">xi k'amarik reje pan tokoom tinamit aha' ma' xta wii' i k'uhb'aal,</para>
  <para style="q">eh re' i Dios ma' xta chik i ruk'uhtaaj keh</para>
  <para style="q">pan kisaq wiriik i jalal ruq'oral.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Eh re' taqe i mama' winaq aj Sión</para>
  <para style="q">xkitzunaa' kiib' wach ak'al, xkitukej pooq wach kinaah,</para>
  <para style="q">xkikoj i q'as wach itz'ihy chikiij ruum i ruti'kiil kik'ux.</para>
  <para style="q">Eh re' taqe i q'ahxoq aj Jerusaleem i xkik'utzaa' qohoq i kinaah wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' hin ma' k'isiin ooq'ik,</para>
  <para style="q">xati' chik inwik'raaj xan yot'ik chik i wánima xub'an</para>
  <para style="q">noq xwilow chi xsacharik wach i nutinamiit.</para>
  <para style="q">Eh ruum chi xwilow taqe i kok' ha'lak'un chi xikimik pantaq b'eeh ruum kiwa' kihaa'.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Eh je' wili inkiq'or reh i kituut: Inqaaj naq qawa' qahaa', inki taqe.</para>
  <para style="q">Eh ruum i kinuhmiik kikimik wach kitileb' i kituut</para>
  <para style="q">xa je' chik rukab' noq kikimik pamb'eeh i kikanteesjik panq'aq'inik.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />¿Awach aj uuk' neetinupaj, neetinujalwachej i hat Jerusaleem?</para>
  <para style="q">¿Nik' wach noq neenuyeew rusuqkiil ak'ux i hat, hat holohik laj Sión?</para>
  <para style="q">Ruum tiyohb'aal wach i ti' xak'ul ma' xata je' chamiil paam</para>
  <para style="q">i palaw. ¿Mi wilik i neenesanik aweh chupaam noq inaq'or?</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' xkilow pan kisaq wiriik i kijalwik ruq'oral i Dios</para>
  <para style="q">re' xkiq'or xa jot'b'al taq aweh.</para>
  <para style="q">Re' keh ma' xkiq'or ta taq aweh chi naa taq ayot'om ak'ux chi riij taq amahk,</para>
  <para style="q">xachukuj q'orik taq i xkian aweh.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Eh noq inik'ik kilow i xuk'ul taq aatinamiit Jerusaleem,</para>
  <para style="q">xan kikaqse'laaj, xan kipohq'aaj chik paam i kiq'ab',</para>
  <para style="q">inkik'uyu'saj i kinaah inkixub'ej i koq je' wili inkiq'or:</para>
  <para style="q">¿Mi ma' re' naq re' i tinamit wili xiik' naah holwochiil</para>
  <para style="q">suq naq wilik chikiwach i tinamit wach ak'al? inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Eh chu'nchel i ki-ixowanik awach ma' holohik ta kiq'orik taq chawiij,</para>
  <para style="q">tikikaqse'laaj tikixub'eej taq, je' wili inkiq'or:</para>
  <para style="q">Qasach chik wach i kitinamiit, re' i q'iij wili xanqaaj naq chik chi naa ruponiik,</para>
  <para style="q">eh yu'naak xqasach chik wach, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Xa re' la' re' i QaJaaw Dios</para>
  <para style="q">xub'an taq wuuk' i ruyejaam cho wach,</para>
  <para style="q">i ruq'orom cho pampeet.</para>
  <para style="q">Xusach wach taq aatinamiit ma' xuketelaaj ta kiwach.</para>
  <para style="q">Eh xuyeew kajaawriik i aj ixowaal reh chi xkian taq aweh.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Re' taq i hat i holohik laj aj Sión</para>
  <para style="q">cha pahqaaj taq atoob'jiik reh i QaJaaw,</para>
  <para style="q">maa kanaa' taq chik oq'ik chi q'iij chi aq'ab'</para>
  <para style="q">maa hi'lisaj taq i naq'awach</para>
  <para style="q">reh oq'ik maakanaa' taq ruchihkiljiik i riis naq'awach.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Chak'er taq aachii' chi oq'ik chi q'iij chi aq'ab',</para>
  <para style="q">chuwach i QaJaaw, b'eh-oq taq i riis naq'awach chi je' rooq ha'.</para>
  <para style="q">Eh cha pahqaaj taq reh i Dios chu'nchel ak'ux</para>
  <para style="q">chajosaj taq aq'ab' chuwach chupahqaljiik</para>
  <para style="q">reh i kik'achariik taq awak'uun awixq'uun</para>
  <para style="q">ruum re' keh k'achi' kikimiik ruum</para>
  <para style="q">kiwa' kihaa' chi tz'uk taq b'eeh.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />QaJaaw Dios, noq inqaq'or i hoj ma' jino'q i a'nam reh chi je' re'.</para>
  <para style="q">¿Mi naa aye'em q'ab' reh chi re' taqe i tuutb'ees naa kik'uxum i kiha'lak'uun?</para>
  <para style="q">¿chi re' taqe i k'amal b'eeh aj tiij</para>
  <para style="q">chi re' taqe i kijalwik aq'oral naa kikanteesjiik chupaam i santo laj ye'aab'?</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Yu'naak xa aha' tuch'lik i kiti'jolal i kamnaq chi nimaq chi kok' taq,</para>
  <para style="q">chi je' taqe i k'ijolaq, chi je' taqe q'ahxoq xikimik ruum q'aq'inik.</para>
  <para style="q">Xakansaj taqe ruum aajosq'iil, ma' xaketelaaj ta kiwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Aha' ta chik ma' xak'am chaloq taqe i aj ixowaal, xa je' chik kik'uloq aj ninq'iijineel.</para>
  <para style="q">QaJaaw Dios noq xayeew aajosq'iil ma' awach taj i xkiko'leej kiib',</para>
  <para style="q">re' taqe i xnuk'isaj, ixnutijej xkuxik kikanteesjiik kuum i aj ixowaal.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' roox runimaal ti'kiil k'uxliis</para>
  <para style="q">
    <verse number="1" style="v" />Re' i hin i winaq xnuk'ul i runimaal</para>
  <para style="q">ti' k'axik xuyeew chi nunaah i Dios ruum i rujosq'iil.</para>
  <para style="q">
    <verse number="2" style="v" />Xiruk'am panq'equm,</para>
  <para style="q">eh ma' kiruk'am ta chik pansaqum.</para>
  <para style="q">
    <verse number="3" style="v" />Chi q'iij chi aq'ab' i ruyeew q'ab' chi nunaah reh</para>
  <para style="q">i ruye'ariik chee ti' k'axik chi nunaah.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh xirurijb'isaj, xutoqib'eej i nub'aqil noq i xwik'raaj.</para>
  <para style="q">
    <verse number="5" style="v" />Eh xukotej wiij chi ti' k'axik, eh chi ruti'kiil k'uxliis.</para>
  <para style="q">
    <verse number="6" style="v" />Eh xiruyeew panq'equm, je' rukab'</para>
  <para style="q">i q'equm wilkeeb' wii' i kamnaq najtir kikimik.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Xukotej wiij ma' xnub'an ta chik elik chupaam,</para>
  <para style="q">xub'ak' nuwach chi karena.</para>
  <para style="q">
    <verse number="8" style="v" />Eh xnuk'er nuchii' chupahqaljiik i nutoob'jiik</para>
  <para style="q">reh i QaJaaw xama' xrib'iraj ta wo' cho weh i nutiij.</para>
  <para style="q">
    <verse number="9" style="v" />Re' reh tusuj ab'aj i xukoj panub'eeh,</para>
  <para style="q">reh chi ma' xinelik ta korik ruuk' i k'ahchi' nukapaam.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' reh xa je' chik rukab' i kaq b'ahlam,</para>
  <para style="q">xa je' chik rukab' i oso xaraaj chi rukutum riib' chi nunaah</para>
  <para style="q">
    <verse number="11" style="v" />Eh xiresaj chupaam i nub'eeh, xiruxereb'eej, eh xirukanaa' chi wutkeel.</para>
  <para style="q">
    <verse number="12" style="v" />Re' xub'an weh re' re', je' naa xu yub' i kutb'al reh i ru flecha.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Je' naa xik'saj chupaam i nuti'jolal i ru flecha.</para>
  <para style="q">
    <verse number="14" style="v" />Eh re' i nutinamiit xa kinkikaqse'laaj chik,</para>
  <para style="q">xa hin chik tz'ajb'al paam kichii' rajlaal i q'iij.</para>
  <para style="q">
    <verse number="15" style="v" />Xa re' chik i ruti'kiil nuk'ux xuyeew, je' naa xi ruxohk'risaj ruuk' i k'ah laj ha'.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Eh je' naa xirukut wach ak'al, je' naa xutoqib'eej wach i weeh, xirutolej pan pooq.</para>
  <para style="q">
    <verse number="17" style="v" />Eh xama' suq ta chik i wihik xnub'an, xama' xnureq ta chik rusuqkiil nuk'ux.</para>
  <para style="q">
    <verse number="18" style="v" />Eh xnukapaaj chi xsahchik chik wach</para>
  <para style="q">i xnuch'ikaam naq reje wii' nuk'ux ruuk' i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Re' hin ink'ulik panuk'ux i ruti'kiil nuk'ux,</para>
  <para style="q">i rutz'irkiil nuwach, i ti' k'axik xnuk'ul.</para>
  <para style="q">
    <verse number="20" style="v" />Noq i nutoq'aa' nukapaam riij chu'nchel i re' rub'an kiib' nuk'ux ruum.</para>
  <para style="q">
    <verse number="21" style="v" />Xa re' la' jinaj inwaaj chi ma' nee ta nsahchik panuk'ux,</para>
  <para style="q">reh chi ar nee nuch'ikaa' nuk'ux.</para>
  <para style="q">
    <verse number="22" style="v" />Re' chi re' i QaJaaw Dios ma' jaruuj i rukanaa'</para>
  <para style="q">ruketeljiik qawach, eh ma' sahchinaq ta wach i rotob'il.</para>
  <para style="q">
    <verse number="23" style="v" />Iqal i iqal la' kirutob'eej ruum xiik' naah i rotob'il ruyeew chi nunaah.</para>
  <para style="q">
    <verse number="24" style="v" />Re' hin xnuq'or, re' i QaJaaw Dios neentoob'inik weh ruuk' i reh i nuyeew nuk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Re' i QaJaaw Dios q'e' atoob' kuuk' taqe inkiyeew kik'ux ruuk', kisik'wik reh.</para>
  <para style="q">
    <verse number="26" style="v" />Q'e' chihooj chi neenquy-eej ruuk' q'unil chi qoh ruko'leej i QaJaaw Dios.</para>
  <para style="q">
    <verse number="27" style="v" />Re' i winaq q'e' chihooj chi noq neeruq'asaj riib'</para>
  <para style="q">chi ri'sil i rajaawriik i Dios parak'uniil.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Q'e' chihooj chi ma' xta neeruq'or,</para>
  <para style="q">chi nee rukuy ruuk' q'unil i ti' k'axik,</para>
  <para style="q">ruum re' wo' Dios xye'wik chinaah.</para>
  <para style="q">
    <verse number="29" style="v" />Nee la' ruloch' riib' chi nee rutz'ub' aak'al, eh koneeruy-eej i rotob'il i Dios.</para>
  <para style="q">
    <verse number="30" style="v" />Eh nee ruyeew chi sak'arik i pan wach keh i nixowanik wach, neerukuy ransil i b'ajarik.</para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" />Ruum re' i QaJaaw Dios ma' jaruuj</para>
  <para style="q">nee qoh rukanaa' chi jumpech.</para>
  <para style="q">
    <verse number="32" style="v" />Atoob' ta neerutib'isaj qak'ux,</para>
  <para style="q">nee wo' chik i ruketelaaj qawach,</para>
  <para style="q">ruum ma' kisiin i k'axooj ruuk'.</para>
  <para style="q">
    <verse number="33" style="v" />Re' reh ma' awach taj i neerutib'isaj ruk'ux,</para>
  <para style="q">i nee ruyeew panti' k'axik chi ma' xta rub'ehel.</para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" />Eh ma' imponik ta chuwach chi neenyeq'arik panak'al</para>
  <para style="q">i wilkeeb' chi ri'sil i kajaawriik i tokoom tinamit.</para>
  <para style="q">
    <verse number="35" style="v" />Eh ma' imponik ta chuwach chi neenq'ucharik i chib'ih reh i tokoom.</para>
  <para style="q">
    <verse number="36" style="v" />Ma' imponik ta chuwach i QaJaaw noq ma' parub'ehel ta inq'atarik i q'orik.</para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" />¿Mi nee ruyeew riib' chi neen q'orarik</para>
  <para style="q">chi re' taqe ink'ularik ma' reht'al taj i QaJaaw Dios?</para>
  <para style="q">
    <verse number="38" style="v" />¿Mi ma' re' wo' re' i QaJaaw Dios</para>
  <para style="q">inyej-anik wach taqe i holohik,</para>
  <para style="q">taqe i ma' holohik taj ink'ularik?</para>
  <para style="q">
    <verse number="39" style="v" />Mi ma' ruum wo' re' i ru mahk i winaq</para>
  <para style="q">inchalik i ti' k'axik chinaah ¿Chib'ih reet noq intib'ik ruk'ux?</para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" />Re' hoj qakapaam riij i qana'ojb'al</para>
  <para style="q">neerub'an chi nee wo' chik inqanimaj i QaJaaw Dios.</para>
  <para style="q">
    <verse number="41" style="v" />Eh qajosaj johtoq i qaq'ab' i qanima chuwach</para>
  <para style="q">i QaJaaw Dios wilik cho pan taxaaj, je' wili i neenqaq'or:</para>
  <para style="q">
    <verse number="42" style="v" />QaJaaw Dios re' hoj xoj mahkunik chawach</para>
  <para style="q">ma' xat qanimaj taj, eh ma' xakuy taj i qamahk.</para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" />Eh ruum aajosq'iil xayeew i ti' k'axik chi qanaah</para>
  <para style="q">xakansaj taqe i qatinamiit ma' xta qamahk.</para>
  <para style="q">
    <verse number="44" style="v" />Je' naa jinaj suutz' q'atwik reh i qatiij</para>
  <para style="q">ruum i re' ma' xoj ab'iraj taj.</para>
  <para style="q">
    <verse number="45" style="v" />Eh xoj akanaa' chi hoj manlik kise'lb'aal, chu'nchel i tinamit.</para>
  <para style="b" />
  <para style="q">
    <verse number="46" style="v" />Chu'nchel i ki-ixowanik qawach ma' holohik ta kiq'orik chiqiij.</para>
  <para style="q">
    <verse number="47" style="v" />Q'e' ti' i xqak'ul xsacharik wach i qatinamiit, runimaal yo'jikwilkooj wii'.</para>
  <para style="q">
    <verse number="48" style="v" />Xa je' chik raasb'al ha' i riis naq'nuwach</para>
  <para style="q">ruum oq'ik i nub'an ruum xsacharik wach i nutinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="49" style="v" />Re' hin ma' kinhi'lik ta chi oq'ik ruum ma' qoh elik ta chupaam i ti' k'axik.</para>
  <para style="q">
    <verse number="50" style="v" />Xa kore' wo' neenumay wila' xaketelaaj cho qawach i QaJaaw kopan taxaaj.</para>
  <para style="q">
    <verse number="51" style="v" />Xanyot'ik chik i wánima i rub'an i xkik'ul</para>
  <para style="q">taqe ixoq wilkeeb' panutinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="52" style="v" />Re' i ki-ixowanik nuwach xinkichop</para>
  <para style="q">chi ma' xta numahk, je' rukab' noq</para>
  <para style="q">inchoparik pan xirob' i k'isa tz'ikin.</para>
  <para style="q">
    <verse number="53" style="v" />Eh k'achlik nuwach noq xinkikut pan chaamlaj jul, xkitz'ap naah chi ab'aj.</para>
  <para style="q">
    <verse number="54" style="v" />Ar xutz'ap nunaah i ha', eh je' wili i xnuq'or: Ayu' xkuxik wach i nuk'achariik kinki.</para>
  <para style="b" />
  <para style="q">
    <verse number="55" style="v" />QaJaaw Dios re' hin xnupahqaaj nutoob'jiik aweh noq wilkiin cho paruchamiil i jul.</para>
  <para style="q">
    <verse number="56" style="v" />Eh xab'iraj wo' i nutiij, noq xnuq'or aweh chi naa kiin ako'leem xina ko'leej wo' hoq.</para>
  <para style="q">
    <verse number="57" style="v" />Noq xnupahqaaj aweh chi naakiin atoob'eem</para>
  <para style="q">je' wili i xaq'or: Matyo'jik wilkiin awuuk', ti kiweh.</para>
  <para style="b" />
  <para style="q">
    <verse number="58" style="v" />QaJaaw Dios kinako'leej ti chupaam i ti' k'axik chako'leej riij i nuk'achariik.</para>
  <para style="q">
    <verse number="59" style="v" />Re' hat inawilow i ma' holohik taj</para>
  <para style="q">inki a'n weh kinako'leej tii weh.</para>
  <para style="q">
    <verse number="60" style="v" />Re' hat i naa wilow chi k'ahchi' kisik'im chi riij,</para>
  <para style="q">nik' wach noq naa kianam weh i ki-ixowanik nuwach.</para>
  <para style="b" />
  <para style="q">
    <verse number="61" style="v" />QaJaaw Dios re' hat inab'iraj i nub'ajariik inki a'n</para>
  <para style="q">je' wo' hoq i k'ahchi' kiyejaam wach chi wiij.</para>
  <para style="q">
    <verse number="62" style="v" />Re' i ki-ixowanik nuwach ma' holohik ta kiq'orik chi wiij</para>
  <para style="q">chu'nchel i q'iij, xa re' chik i hin kinkiq'or.</para>
  <para style="q">
    <verse number="63" style="v" />Eh inawilow wo' chu'nchel inki a'n xa hin chik kise'lb'aal chi jumpech.</para>
  <para style="b" />
  <para style="q">
    <verse number="64" style="v" />QaJaaw Dios chayeew taqe chutojariik i kimahk, je' rukab' i ruk'ul chi keh.</para>
  <para style="q">
    <verse number="65" style="v" />Chakowb'isaj i kánima reh chi ma' nee ta</para>
  <para style="q">nkireq chi riij i korik, chayeew i ti' k'axik chikinaah.</para>
  <para style="q">
    <verse number="66" style="v" />QaJaaw Dios chayeew aajosq'iil chikinaah, chasach kiwach chinaah i wach ak'al wili.</para>
  <chapter number="4" style="c" />
  <para style="s">Re' rukaaj runimaal ti'kiil k'uxliis</para>
  <para style="q">
    <verse number="1" style="v" />Re' i qa oro xq'eeqb'ik chik wach,</para>
  <para style="q">eh re' i xti manlik oro ma' rob'rotik ta chik kiwach.</para>
  <para style="q">Eh re' holohaq ab'aj wilik chupaam i santo laj ye'aab'</para>
  <para style="q">xa aha' chik t'analkeeb' pantaq b'eeh.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' taqe i aj Sión i xiik' naq naah k'ihaal kitz'aaq chuwach i oro, yu'naak</para>
  <para style="q">xi kahnik chi ma' xta chik k'isinoq kitz'aaq</para>
  <para style="q">xa je' chik kikab' ak'al xun ruyej-aniik winaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' ixoq xojb' i ruyeew naa re' ruch'uuch' i kok' rak'uun.</para>
  <para style="q">Raaj i nutinamiit reh ma' je' ta re' inki a'n xiik' la' naah kijosq'iil,</para>
  <para style="q">je' kijosq'iil i nimaq chikop wilik ruxiik' wilkeeb' panchiq yuuq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' i kok' ha'lak'uun ko kich'uch'ik i ruchop riib' i kaaq' pan kijahaay ruum kihaa'.</para>
  <para style="q">Eh re' taqe ha'lak'uun noq inkipahqaaj kikaxlanwi'k ma' awach ta nye'wik keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' naq taqe i suq atoob' inkik'ux,</para>
  <para style="q">yu'naak k'ahchi' kikimiik ruum wi'jaleel, pantaq b'eeh.</para>
  <para style="q">Eh re' taqe i xik'ihik pan b'ehomal, yu'naak pan sohk' inki yok'aa' kiib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' yiib' wach na'ojb'al inki a'n i nutinamiit,</para>
  <para style="q">ma' xata je' rukab' i mahk xkian i aj Sodoma.</para>
  <para style="q">Re' i xa chi jumehq'iil xsacharik wach chi ma' kota xb'aan i peleto kuuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' taqe xi k'amwik cho qab'eeh saq wo'</para>
  <para style="q">naq wach i kánima je' saq laj suutz'.</para>
  <para style="q">Eh xti kow naq kiib' q'e' naq taqe holohaq</para>
  <para style="q">je' kikab' i holohaq ab'aj koral, eh zafiro rub'ihnaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Eh yu'naak xa je' chik rukab' aaq'ut i kiq'eqiil</para>
  <para style="q">xama' naab'jik ta chik kiwach pantaq b'eeh.</para>
  <para style="q">Xa riplik chik i kitz'uhmal chuwach i kib'aqil</para>
  <para style="q">xa chiqij chik taqe xa je' chik taqe chiq sii'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Ma' xta reet i xkik'ul i xikimik panq'aq'inik,</para>
  <para style="q">chuwach i kikimik ruum wi'jaleel.</para>
  <para style="q">Ruum re' i xikimik ruum wi'jaleel q'uun i kimik</para>
  <para style="q">xkian korehtaal ma' xelik ta chik i tik wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Eh wilik taqe i tuutb'ees atoob' wo' naq taqe,</para>
  <para style="q">ruuk' kiq'ab' xkichaq'saj i kiha'lak'uun,</para>
  <para style="q">eh inkik'ux chi jilow kiwa'.</para>
  <para style="q">Je' re' i xkian chupaam i q'iij noq</para>
  <para style="q">sacharik wach i nutinamiit Jerusaleem.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' i QaJaaw Dios xuyeew i rujosq'iil chinaah i tinamit Jerusaleem.</para>
  <para style="q">Eh xusachib'eej wach ma' xta chik i rehtalil xukanaa',</para>
  <para style="q">je' jinaj q'aaq' noq xuqasaj chee rujosq'iil.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' taqe i kireey chu'nchel i tokoom tinamit ma' nkikapaaj ta naq</para>
  <para style="q">chi re' taqe i aj ixowaal naa kianam okik chupaam i tinamit Jerusaleem.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' taqe i xk'ularik re' re' kimahk i jalal naq ruq'oral i Dios.</para>
  <para style="q">Eh ruum i kiyiib' wach na'ojb'al i k'amal kib'eeh aj tiij.</para>
  <para style="q">Ruum xkikansaj taqe i korik wach kik'ux ar Jerusaleem.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' taqe re' xa je' taqe moywach noq xib'ehik pantaq b'eeh.</para>
  <para style="q">Xkisach i kiso' chi kik' ruuk' ikaansanik xkian,</para>
  <para style="q">ma' awach ta chik i rujil i koq riib' kuuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Eh je' wili inq'orarik keh: Eleen taq chi qawach,</para>
  <para style="q">ch'uwa' taq awach, ma' nee ta nqajil koq qiib' taq awuuk',</para>
  <para style="q">ma' ruk'ul taj chi nee taq ti k'acharik quuk' ki uchjik kuum i tinamit.</para>
  <para style="q">Eh xkimol chi elik pantaq tokoom tinamit.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Re' i QaJaaw Dios xtukinik reje kiwach ruum i rujosq'iil.</para>
  <para style="q">Eh ma' xuyeew ta chik kiloq'il i k'amal kib'eeh aj tiij.</para>
  <para style="q">Eh ma' xuketelaaj ta wo' kiwach i mama' winaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Re' hoj ti' naq wilkooj xqasik' naq qatoob'jiik tokoom,</para>
  <para style="q">xama' awach ta wo' xtoob'inik qeh.</para>
  <para style="q">Eh xqayeew naq qak'ux chinaah jinaj i tinamit</para>
  <para style="q">chi naakooj ruko'leem, xama' xoj ruko'leej ta wo' hoq.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Re' hoj xama' ruyeew ta chik riib' chi qoh elik pamb'eeh,</para>
  <para style="q">ruum xak'ahchi' chik kikojom qehtaal aha' qohooj</para>
  <para style="q">ruum qohkaaj kikansam, xponik chik i q'iij</para>
  <para style="q">chi naa rusachariik qawach.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Re' taqe i ki-ixowanik qawach kow kib'ehik,</para>
  <para style="q">ma' xata je' kowiil i rub'an i xihk inrupinik pan taxaaj.</para>
  <para style="q">Xa aha' inkiq'at chi qawach pantaq chiq yuuq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Eh xkichop i qareey i rusik'im cho wach i QaJaaw re' naq inqayeew wii' qak'ux.</para>
  <para style="q">Re' i qareey je' wili inqaq'or chi riij: Re' reh chi ri'sil i rumuuj i rajaawriik</para>
  <para style="q">naa qawihiik chupaam taqe i tinamit, qohki.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Tise'lanoq, suuqb'oq taq ak'ux i hat aj Edom, i hat taq aj Uz.</para>
  <para style="q">Xa re' la' ponik wo' reh i ti' k'axik taq cha naah i hat,</para>
  <para style="q">je' naa k'ah laj ha' i naa taq awuk'em,</para>
  <para style="q">naa taq akahniik chi je' taq hat xohk'reel, chi hat taq sonolkaat.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Re' taq i hat aj Sión xat hi'lik taq chik ruuk' ti' k'axik,</para>
  <para style="q">ma' naa ta chik taq kaat ruk'amam reje pan tokoom tinamit.</para>
  <para style="q">Eh re' taq i hat aj Edom naa taq kaat ruye'em chutojariik amahk,</para>
  <para style="q">ar naa reliik wach saqum taq amahk.</para>
  <chapter number="5" style="c" />
  <para style="s">Re' tiij xkian i aj Jerusaleem ruum i ruti'kiil kik'ux</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios k'oloq tii cho panak'ux i ti' k'axik xqak'ul,</para>
  <para style="q">ruum q'e' xkik'uhtaaj qak'ixb'ilaal.</para>
  <para style="q">
    <verse number="2" style="v" />Eh re' taqe chib'ih qeh xkiq'uch i tokoom tinamit,</para>
  <para style="q">eh xkiq'uch i qapaat.</para>
  <para style="q">
    <verse number="3" style="v" />Xoj kahnik chi ma' xta ilil qeh, xa je' ma' xta qajaaw,</para>
  <para style="q">re' taqe i qatuut xi kahnik chi je' kamnaq kib'ahiil.</para>
  <para style="q">
    <verse number="4" style="v" />Re' i qahaa' inquk'ej xan qaloq' chik,</para>
  <para style="q">eh re' i qasii' inqak'at xan qaloq' wo' chik.</para>
  <para style="q">
    <verse number="5" style="v" />Re' taqe i ki-ixowanik qawach jinaj ahl laj ihq i xkiyeew chi qanaah,</para>
  <para style="q">ma' qohi'lik ta chik kuum.</para>
  <para style="q">
    <verse number="6" style="v" />Eh koxqapahqaaj chik chib'ih qeh kuuk' i aj Egipto,</para>
  <para style="q">kuuk' i aj Asiria, xa je' chik re' noq xqa a'n qawa' qahaa'.</para>
  <para style="q">
    <verse number="7" style="v" />Re' taqe i qamaam qati't ximahkunik chaloq.</para>
  <para style="q">Eh re' chik i hoj k'ahchi' qatojwik wach i kimahk.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taqe i kimoso xkikoj chi taaq'anik chi qanaah.</para>
  <para style="q">Eh ma' awach ta chik ineesanik qeh pan kiq'ab'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' taqe i kansan qeh xa aha' wilkeeb'.</para>
  <para style="q">Xa yo'jik inqa a'n noq qohooj chusik'ariik i qawa'.</para>
  <para style="q">
    <verse number="10" style="v" />Re' i qati'jolal xan qop chik inqik'raaj ruum i qanuhmiik,</para>
  <para style="q">xa je' chik rukab' i rutz'a'iil i horna.</para>
  <para style="q">
    <verse number="11" style="v" />Re' taqe i aj ixowaal ar Sión,</para>
  <para style="q">ar Judá xkichop taqe ixoq, je' wo' taqe kok' xq'un.</para>
  <para style="q">
    <verse number="12" style="v" />Eh xkit'uyaa' chi kiq'ab' taqe i k'amal qab'eeh.</para>
  <para style="q">Eh ma' xkiyeew ta rajaawriik taqe i mama' winaq.</para>
  <para style="q">
    <verse number="13" style="v" />Eh re' taqe k'ijool wilik chik kaansil xkikoj chi ruke'jiik i trigo.</para>
  <para style="q">Eh re' taqe i kok' ak'un xakiq'ehb'ik chik chi ri'sil i ahl laj sii' inye'arik chikiij.</para>
  <para style="q">
    <verse number="14" style="v" />Ma' nilarik ta chik kiwach i mama' winaq panookb'al reh i tinamit.</para>
  <para style="q">Eh re' taqe i k'ijolaq ma' kitz'uyinik ta chik.</para>
  <para style="q">
    <verse number="15" style="v" />Eh re' hoj ma' qoh soninik ta chik.</para>
  <para style="q">Re' i rusuqkiil qak'ux xsutinik chi ruti'kiil qak'ux.</para>
  <para style="q">
    <verse number="16" style="v" />Xkesaj i qaloq'il,</para>
  <para style="q">q'e' wo' chik ti' i k'ahchi' qak'ulum ruum ma' k'isiin i mahk qa'nam chaloq.</para>
  <para style="q">
    <verse number="17" style="v" />Ruum taqe i ti' k'axik re' re' xan yot'ik chik i qanima,</para>
  <para style="q">eh ma' q'e' ta chik saqum qoh ilwik.</para>
  <para style="q">
    <verse number="18" style="v" />Eh re' taqe i wilik naq chinaah i yuuq' Sión xsacharik kiwach</para>
  <para style="q">xa re' chik i yaak k'uul kiooj chinaah.</para>
  <para style="q">
    <verse number="19" style="v" />Eh re' hat QaJaaw Dios chi juneliik naa awihiik chi reyil,</para>
  <para style="q">eh chi juneliik naa awihiik chi taaq'anik chupaam aaye'aab'.</para>
  <para style="q">
    <verse number="20" style="v" />QaJaaw Dios ¿Mi xoj sahchik panak'ux re'?</para>
  <para style="q">¿Chib'ih reet noq naakooj akanaam chi qutkeel nik'-oq najtiil?</para>
  <para style="q">
    <verse number="21" style="v" />Chakuy qoh ak'ul awuuk', nee wo' chik qoh sutinik awuuk'.</para>
  <para style="q">Eh nee ta tii i nayeew qeh i suq laj k'acharik je' rukab' i pampeet.</para>
  <para style="q">
    <verse number="22" style="v" />QaJaaw Dios ¿Mi xoj akanaa' chi qutkeel chi jumpech re'?</para>
  <para style="q">¿Mi juneliik naa aye'em aajosq'iil chi qanaah re'?</para>
</usx>