<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="JOL" style="id">JOEPOK.SFK 15-05-2,006 Adelina Quej Xoy. Pokomchi Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">JOEL</para>
  <para style="toc3">Jol</para>
  <para style="toc2">Jol</para>
  <para style="toc1">JOEL</para>
  <para style="mt2">RE' I RUHUUJ I JOEL</para>
  <para style="mt1">JOEL</para>
  <chapter number="1" style="c" />
  <para style="s">Re' ruq'orariik i nimaq taq chili'l xi sachwik kiwach i tik mu'uun</para>
  <para style="q">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Joel rak'uun Petuel:</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Chab'iraj taq i naa nuq'orom i hat taq</para>
  <para style="q">chik mama' winaq,</para>
  <para style="q">je' wo' taq i hat patim chupaam i tinamit wili.</para>
  <para style="q">¿Mi ak'ulum taq junriim-oq re' i hat mi kilom</para>
  <para style="q">cho junriim-oq re' taqe aamaam awati't i ti' k'axik</para>
  <para style="q">je' rukab' i k'achi' taq ak'ulum yu'naak?</para>
  <para style="q">
    <verse number="3" style="v" />Re' taqe i ti' k'axik wili chak'utjaaj</para>
  <para style="q">taq keh awak'uun awixq'uun</para>
  <para style="q">reh chi neenkik'utjaaj i keh reh kak'uun kixq'uun.</para>
  <para style="q">Eh re' chik i keh neekik'utjanik</para>
  <para style="q">keh i komajaa' ki-aasjik.</para>
  <para style="q">
    <verse number="4" style="v" />Chi pan jinaj q'iij xi k'ulik taqe i nimaq taq chili'l</para>
  <para style="q">xkik'uxib'eej taqe i tik.</para>
  <para style="q">Aha' wilik i ma' xkik'ux taj</para>
  <para style="q">i-xi-ik'ik peet re' i chik i xi k'uloq xam xik'uxwik reh,</para>
  <para style="q">kajb'uhr wach kininqaal i chili'l</para>
  <para style="q">xsachwik kiwach i tik.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' taq i hat xohk'reel na'lojoq taq aweh,</para>
  <para style="q">eh chamol taq chi oq'ik i hat i ti uk'inik taq reh i vino,</para>
  <para style="q">ruum re' taqe chikop xkisach wach i uuva, ma' xta chik i naarukorjiik wii' taq aavino</para>
  <para style="q">
    <verse number="6" style="v" />Re' taqe i nimaq chili'l,</para>
  <para style="q">xa je' chik i ruk'ihaal soldado noq xi k'uloq chinaah i qatinamiit.</para>
  <para style="q">Eh xa je' chik i reeh i kaq b'ahlam i keeh,</para>
  <para style="q">xa je' chik rutz'ii' reeh ixoq kaq b'ahlam i rutz'ii' i keeh.</para>
  <para style="q">
    <verse number="7" style="v" />Eh xkuxik kik'uxum i wach i qa uuva</para>
  <para style="q">i wach i qa higo</para>
  <para style="q">ma' xta chik k'isinoq xaq xkikanaa' xa re' chik i q'ab' i ruche'el xkikanaa'.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Eh nik' wach noq inoq'ik i k'isa q'ahxoq</para>
  <para style="q">noq i rukoj i ruq'eq' so' chiriij ruum</para>
  <para style="q">i ruti'kiil ruk'ux chiriij i rukimiik i naa naq rub'anam chi rub'ahiil,</para>
  <para style="q">
    <verse number="9" style="v" />je' re' noq naa kokiik chi oq'ik</para>
  <para style="q">taqe i k'amal kib'eeh aj tiij.</para>
  <para style="q">Ruum parupaat i QaJaaw Dios ma' xta chik taqe i wach i tik mu'uun</para>
  <para style="q">ni xata chik riis uuva inkik'am chaloq chi kimayiij.</para>
  <para style="q">
    <verse number="10" style="v" />Re' i wach ak'al ti' ruk'ux,</para>
  <para style="q">ruum ma' xta chik tik chuwach.</para>
  <para style="q">Re' i trigo xsahchik wach, re' taqe i uuva</para>
  <para style="q">i ruche'el i olivo xi chiqik</para>
  <para style="q">wo' hoq, ruum aj re' ma' xta chik aseite.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Eh re' taq i hat i ti tikwik taq reh i uuva,</para>
  <para style="q">i trigo ti oq'oq taq.</para>
  <para style="q">Ruum xsahchik taq wach atik, ma' xta chik i wach i trigo,</para>
  <para style="q">ma' xta chik i wach i sebada naa reliik.</para>
  <para style="q">
    <verse number="12" style="v" />Re' i ruche'el i uuva, i ruche'el i higo,</para>
  <para style="q">i ruche'el i granado, ruche'el i xaq ipak',</para>
  <para style="q">i ruche'el i mansano kuxik kichiqiik.</para>
  <para style="q">Eh xkuxik wo' kichiqiik chu'nchel i chee,</para>
  <para style="q">ruum i re' ma' xta chik rusuqkiil kik'ux i tinamit wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' taq i hat k'amal b'eeh aj tiij</para>
  <para style="q">tikamanik taq chuwach i ru artaal i QaJaaw Dios</para>
  <para style="q">chakoj taq i q'as wach itz'ihy chawiij,</para>
  <para style="q">ti oq'oq taq ruum i ruti'kiil ak'ux.</para>
  <para style="q">Ruum parupaat i QaJaaw Dios ma' xta chik i wach i tik,</para>
  <para style="q">ni xata riis uuva chik inkik'am chaloq chi kimayiij.</para>
  <para style="q">
    <verse number="14" style="v" />Chaq'or taq keh i mama' winaq,</para>
  <para style="q">je' wo' chu'nchel i tinamit</para>
  <para style="q">wilkeeb' ayu' chi kimol</para>
  <para style="q">kiib' chupaam i rupaat i QaJaaw,</para>
  <para style="q">Dios. Eh kian kitiij i chi ma' kianam ta kiwa' kihaa'.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Q'e' ti' i naa qak'ulum ruum re' i</para>
  <para style="q">QaJaaw Dios xailook' chik i ruyeew i ti' k'axik chi qanaah.</para>
  <para style="q">Eh naa rusacham wach i qatinamiit, jinaj runimaal ti' k'axik naa ruye'em cho qeh</para>
  <para style="q">i QaJaaw Dios nim rajaawriik</para>
  <para style="q">
    <verse number="16" style="v" />Eh pan naq'qawach</para>
  <para style="q">xkesaj chi qawach i qawa' qahaa'.</para>
  <para style="q">Eh ma' xta chik k'isinoq rusuqkiil k'uxliis</para>
  <para style="q">chupaam i rupaat i QaJaaw Dios.</para>
  <para style="q">
    <verse number="17" style="v" />Eh taqe i ja' xtikarik chi lohk'aal xkuxik kiq'ahiik,</para>
  <para style="q">re' taqe i ye'aab' reh i wach i tik xiq'ahik chik.</para>
  <para style="q">Eh re' i molarik wii' inaq'wach i trigo</para>
  <para style="q">xiyojib'ik ruum ma' xiwachinik ta chik.</para>
  <para style="q">
    <verse number="18" style="v" />Re' taqe i chikop oq'ik</para>
  <para style="q">chik inki a'n ruum kiwa',</para>
  <para style="q">xama' ha' ta chik inkireq kiwa' taqe i wakax.</para>
  <para style="q">Eh re' taqe i tentzun k'achi' chik kikimiik ruum kiwa'.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />QaJaaw Dios aweh i hat i nupahqaaj qatoob'jiik,</para>
  <para style="q">ruum re' taqe i ch'ahn panchiq yuuq' xa je' chik q'aaq' i xik'ik chinaah,</para>
  <para style="q">je' wo' taqe i chee' wilkeeb' wataq yuuq' k'ixkaab'.</para>
  <para style="q">
    <verse number="20" style="v" />Re' taqe josq'laj chikop</para>
  <para style="q">wilkeeb' pantaq ch'ahnoq'ik inki a'n</para>
  <para style="q">chawach ruum xkuxik kichiqiik taqe i raasb'al ha'.</para>
  <para style="q">Eh xa je' chik q'aaq' i xik'ik chinaah taqe i ch'ahn inkik'ux.</para>
  <chapter number="2" style="c" />
  <para style="q">
    <verse number="1" style="v" />Eh chaxulej taq i tuun chinaah i yuuq' Sión,</para>
  <para style="q">cha q'or taq rib'iral chupaam i rupaat i QaJaaw Dios.</para>
  <para style="q">Reh chi neenchalik kiyo'jiik chu'nchel i wilkeeb' Judá,</para>
  <para style="q">ruum re' QaJaaw xailook' chik ruye'em chee runimaal ti' k'axik.</para>
  <para style="q">
    <verse number="2" style="v" />Re' taqe i nimaq chili'l naaruq'equumriik wach i q'iij noq naa kik'uliik i loq.</para>
  <para style="q">Eh xa je' chik q'eq suutz', xa je' chik taqe ruk'ihaal soldado</para>
  <para style="q">noq naa kik'uliik i loq chinaah taqe i yuuq' kixkaab',</para>
  <para style="q">xa je' chik rukab' i noq i rusihq'eej i wach ak'al i q'iij noq insaq'ik.</para>
  <para style="q">Eh ma' jank'al ta nilarik i re',</para>
  <para style="q">eh ma' naa ta wo' chik rilariik chi jumpech.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh re' taqe chikop re' re'</para>
  <para style="q">xa je' chik naa rik'iik q'aaq' chikinaah taqe i ch'ahn kuum,</para>
  <para style="q">je' rukab' i rub'an i xaq q'aaq' ruk'at chiriij, i ruk'at chuwach.</para>
  <para style="q">Eh xa holohik naq chik taqe i tik chupaam taqe i ye'aab',</para>
  <para style="q">eh noq ik'inaq chik taqe ar inkahnik chi xa je' chik chiq yuuq'</para>
  <para style="q">ma' wach taj i naa ruko'leem riib' chikiwach.</para>
  <para style="q">
    <verse number="4" style="v" />Eh re' taqe i chikop re' re', je' kiwii' kawáyu,</para>
  <para style="q">je' kiajiminik kawáyu noq wilik i winaq iqlik chiriij reh ojik panq'aq'inik.</para>
  <para style="q">
    <verse number="5" style="v" />Re' choqik naa kianam chinaah taqe yuuq'</para>
  <para style="q">xa je' chik rukab' i choqik inki a'n i ruk'ihaal kareta.</para>
  <para style="q">Eh xa je' chik rukab' i choqik i rub'an i q'aaq' noq ruk'at i chiqiij laj xaq chee'.</para>
  <para style="q">Je' kikab' i ruk'ihaal soldado kow kiib',</para>
  <para style="q">kiyejaam kiib' chi q'aq'inik.</para>
  <para style="q">
    <verse number="6" style="v" />Eh re' taqe i tinamit xa saqmoq'ik chik naakiponiik</para>
  <para style="q">ruum kiyo'jiik kuum taqe i chikop re' re'.</para>
  <para style="q">
    <verse number="7" style="v" />Eh je' kikab' taqe i soldado kow kiib' chi q'aq'inik</para>
  <para style="q">kow kiajiminik, kijohtik chinaah taqe i tz'aq.</para>
  <para style="q">Eh chi korik kiooj chikiwach</para>
  <para style="q">ma' inkijal ta chik i kib'eeh.</para>
  <para style="q">
    <verse number="8" style="v" />Eh ni xata nkikuhraaj kiib'</para>
  <para style="q">noq kib'eehik inkik'am i kib'eeh chi korik,</para>
  <para style="q">atoob' ta naq nee kikanteesjik ruuk' flecha xama' xta wo' naa kuuchjiik.</para>
  <para style="q">
    <verse number="9" style="v" />Eh naakokiik chupaam i tinamit</para>
  <para style="q">xa kajimam chik kiib'</para>
  <para style="q">noq naakijohtiik naah taq tz'aq, nah taq paat, xa je' chik taqe ajileq'</para>
  <para style="q">noq naa kokiik pantaq kok' ventana reh taqe i paat.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Xa naa chik ruk'uyu'jiik ak'al naa kianam,</para>
  <para style="q">eh naaruq'equumriik paam i taxaaj ruum i kik'ihaal.</para>
  <para style="q">Re' q'iij ma' naa ta chik ruk'utiniik kuum,</para>
  <para style="q">je' wo' hoq i rusaqumaal ch'umiil.</para>
  <para style="q">
    <verse number="11" style="v" />Re' i QaJaaw naaruk'amam kib'eeh taqe i ru soldado,</para>
  <para style="q">eh kow naaruq'oriik chaloq.</para>
  <para style="q">Re' taqe i raj kamanoom re' re' xiik'nah kik'ihaal,</para>
  <para style="q">ma' nee ta inkuyjik kajaljiik taqe i kib'anik reh taqe i ruq'or chi naarub'aan.</para>
  <para style="q">Eh na' ponoq i q'iij chuwach i QaJaaw Dios,</para>
  <para style="q">q'e' ti' inaarilariik,</para>
  <para style="q">ma' jino'q i naarukuywiik reh.</para>
  <para style="s">Re' i ketelinik wachiis i rub'an i QaJaaw Dios</para>
  <para style="q">
    <verse number="12" style="v" />Eh re' i QaJaaw Dios je' wili i ruq'or:</para>
  <para style="q">Chayot' taq ak'ux,</para>
  <para style="q">kim wo' chik taq wuuk' chu'nchel taq awánima,</para>
  <para style="q">cha a'n taq atiij chi ma' a'nam taq awa' ahaa'</para>
  <para style="q">cha k'er taq aachii' chi oq'ik, inki.</para>
  <para style="q">
    <verse number="13" style="v" />Chanimaj wo' taq chik aaWaJaaw aaDios, re' taq awánima</para>
  <para style="q">naa aaxihim, ma' re' ta chik taq aso'</para>
  <para style="q">Ruum re' i QaJaaw Dios wilik q'unil ruuk',</para>
  <para style="q">q'uun inchalik rujosq'iil ruum q'e' aj keteloom wachiis,</para>
  <para style="q">eh intib'ik ruk'ux noq i ruyeew i ti' k'axik taq cha naah.</para>
  <para style="q">
    <verse number="14" style="v" />Ma' nee ta oon naq i ruyeew i ti' k'axik taq cha naah i QaJaaw Dios,</para>
  <para style="q">nee oon naq i ruyeew taq weh i rotob'il.</para>
  <para style="q">Nee oon wo' naq chik kiwachinik taqe i tik,</para>
  <para style="q">nee wo' naq chik inwihik riis i uuva,</para>
  <para style="q">eh neenkik'am reje chi mayiij reh i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Eh cha xulej taq chaloq i tuun</para>
  <para style="q">chinaah i yuuq' Sión reh chi neenkimol kiib' i tinamit.</para>
  <para style="q">Chaq'or taq keh chi ki a'n kitiij chi ma' kianam ta kiwa' kihaa'.</para>
  <para style="q">
    <verse number="16" style="v" />Chamol taq kiwach</para>
  <para style="q">i rutinamiit i Dios chakuxisaj taq,</para>
  <para style="q">chamol kiwach taqe i nimaq winaq,</para>
  <para style="q">je' wo' taqe i kok' ha'lak'un, i ko aj ch'uuch' taqe.</para>
  <para style="q">Eh cha q'or taq keh i koxki a'n kaxáro</para>
  <para style="q">chi kieloq cho chupaam i paat</para>
  <para style="q">k'ahchi' keeb' wii' chi hi'lik.</para>
  <para style="q">
    <verse number="17" style="v" />Re' taqe i k'amal kib'eeh aj tiij chu'nchel</para>
  <para style="q">i raj kamanoom i Dios kijil i koq kiib' wach artaal,</para>
  <para style="q">eh ruuk' oq'ik nee nkiq'or chi je' wili:</para>
  <para style="q">QaJaaw Dios cha kuy tii kimahk aatinamiit.</para>
  <para style="q">Maa yeew q'ab' chinee kikaqse'ljik, eh chi neenq'atarik kiwach kuum i tokoom tinamit</para>
  <para style="q">reh chi ma' nee ta nkiq'or chi je' wili i ma' kinimanik ta weh:</para>
  <para style="q">¿Aha' wilik i ki Dios i re'? ma' inko'q ta taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Eh chi je' re' i Dios neeruk'uhtaaj i ruk'axb'al chinaah i rutinamiit,</para>
  <para style="q">nee wo' chik i ruketelaaj kiwach.</para>
  <para style="q">
    <verse number="19" style="v" />Je' wili i xuq'or: Re' hin naa wo' chik nuye'em taq aweh i suq atoob',</para>
  <para style="q">naa wo' chik kiwachiniik i trigo, naa wo' chik ruwihiik i riis uuva,</para>
  <para style="q">i aseite korehtaal taq ti nujik.</para>
  <para style="q">Eh ma' naa ta nuye'em q'ab' chi naa</para>
  <para style="q">taq kaat kikaqse'laam i ma' kinimanik ta weh.</para>
  <para style="q">
    <verse number="20" style="v" />Re' hin naa taqe wesam reje panatinamiit i nimaq chili'l</para>
  <para style="q">xi chalik pantz'eet reh i rookb'aal q'iij, naanukaham taqe reje panchiq yuuq'.</para>
  <para style="q">Re' taqe i peet b'eeh naanukutum taqe chupaam i kamnaq palaw,</para>
  <para style="q">eh re' taqe i xam b'eeh naa taqe nukutum chupaam i palaw Mediterráneo,</para>
  <para style="q">ar naakichuhriik.</para>
  <para style="q">Re' hin wilik i nimaq wach na'ojb'al naa nub'anam taq awuuk', inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Je' re' noq re' taq i hat suuqb'oq taq ak'ux maayohb'isaj taq chik awiib',</para>
  <para style="q">ruum re' i QaJaaw Dios wilik i nimaq wach na'ojb'al naa rub'anam taq awuuk'.</para>
  <para style="q">
    <verse number="22" style="v" />Eh re' taqe i chikop pantaq ch'ahn</para>
  <para style="q">naa wo' chik ruwihiik kiwa', ruum naa wo' chik ruraaxb'iik kiwach i ch'ahn.</para>
  <para style="q">Eh re' taqe chee' naa wo' chik kiwachiniik,</para>
  <para style="q">eh naa wo' chik kiwachiniik i higo i uuva.</para>
  <para style="q">
    <verse number="23" style="v" />Eh re' taq i hat i wilkaat taq ar Sión</para>
  <para style="q">suuqb'oq taq ak'ux ruuk' taq aaWaJaaw aaDios.</para>
  <para style="q">Ruum re' reh xti manlik paruq'ijil naa ruye'em taq cha weh peet jab',</para>
  <para style="q">eh naa wo' ruye'em chaloq i jab' i rub'an koq'uun,</para>
  <para style="q">je' wo' rukab' i rub'an pampeet.</para>
  <para style="q">
    <verse number="24" style="v" />Re' trigo naa wo' chik ruwachiniik chi korik.</para>
  <para style="q">Je' wo' hoq i riis i uuva, je' wo' hoq aseite korehtaal i nujik i ye'aab' reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Re' hin naa taq nuye'em jilow aweh atik</para>
  <para style="q">xaq'eb' chupaam taqe i haab' noq xkuxik kik'uxum</para>
  <para style="q">i kajb'uhr wach kininqaal chili'l kajpech xik'ik.</para>
  <para style="q">Xa je' chik ruk'ihaal soldado xnutaq'aaj taq cho cha naah.</para>
  <para style="q">
    <verse number="26" style="v" />Eh naa wo' chik taq a'nam awa' ahaa' korehtaal taq ti nujik.</para>
  <para style="q">Eh naa taq kiin aloq'em i hin, hin taq aaWaJaaw aaDios,</para>
  <para style="q">ruum re' hin naa nub'anam i nimaq wach na'ojb'al taq awuuk',</para>
  <para style="q">eh ma' jaruuj taq chik naa akahniik pank'ixb'ilaal taq i hat nutinamiit.</para>
  <para style="q">
    <verse number="27" style="v" />Re' taq i hat aj Israel naa taq anab'eem chi wilkiin taq awuuk'.</para>
  <para style="q">Eh chi xa re' hin i jinaj chi Dios, ma' xta chik jino'q.</para>
  <para style="q">Eh ma' jaruuj taq chik naa akahniik pan k'ixb'ilaal taq i hat, nutinamiit, inki.</para>
  <para style="s">Re' ruq'orariik chi naa ruqajiik chaloq i Santolaj Uxlab'al</para>
  <para style="q">
    <verse number="28" style="v" />Noq ik'inaq chik taqe re' naanuqasam qohoq i Wuxlab'al chikinaah chu'nchel i tinamit.</para>
  <para style="q">Re' taqe i kak'uun kixq'uun naa kiq'orom wib'iral,</para>
  <para style="q">re' taqe k'ijolaq wilik i naanuk'uhtaam chikiwach.</para>
  <para style="q">Re' i mama' winaq wilik i naanuk'uhtaam keh pan wiriik.</para>
  <para style="q">
    <verse number="29" style="v" />Eh chupaam taqe i q'iij re' re', naa nuye'em i Wuxlab'al</para>
  <para style="q">pan kánima taqe i waj kamanoom, chi winaq chi ixoq.</para>
  <para style="q">
    <verse number="30" style="v" />Eh naanuk'uhtaam pan taxaaj i runimaal sahchb'al k'uxliis,</para>
  <para style="q">naa wo' nuk'uhtaam wach ak'al i ehtalil,</para>
  <para style="q">re' ruuk' i kik', eh q'aaq' jinaj runimaal sib' xa je' chik q'equm paam suutz'.</para>
  <para style="q">
    <verse number="31" style="v" />Re' q'iij naaruq'equumriik wach, eh re' poh naarukahniik chi</para>
  <para style="q">xa je' chik k'ik' noq komajaa' imponik i q'iij</para>
  <para style="q">chi naa nuq'atam i q'orik i hin re' ixiik'naah nimaal wach, eh ti yo'joq ruum, inki.</para>
  <para style="q">
    <verse number="32" style="v" />Eh chu'nchel i naa kiq'orom i b'ih i QaJaaw Dios pan kitiij</para>
  <para style="q">naakiko'ljiik, ruum ar Sión</para>
  <para style="q">ar Jerusaleem naarureqariik i ko'lemb'al iib',</para>
  <para style="q">je' rukab' i ruq'orom i QaJaaw Dios pampeet.</para>
  <para style="q">Re' taqe i rusik'im wach i reh naakiko'leem riij i kik'achariik.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' ti' k'axik naa ruye'em chikinaah i tinamit xib'anik i ti' k'axik</para>
  <para style="q">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Na' ponoq i q'iij re' re' naa wo' chik nuye'em keh i suq laj k'acharik i aj Judá,</para>
  <para style="q">je' wo' taqe i aj Jerusaleem na' kisutinoq cho pan kitinamiit.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin naanumolom kiwach chu'nchel i tinamit pan k'ixkaab' Josafat.</para>
  <para style="q">Ar naanuq'atam i q'orik chikinaah,</para>
  <para style="q">ruum i ti' k'axik xkian reh i nutinamiit Israel.</para>
  <para style="q">Ruum re' keh xkikaaj reje i nutinamiit pantaq tokoom tinamit,</para>
  <para style="q">eh xkich'aqib'eej i kiye'aab' i nutinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh xkiq'ijej riij i nutinamiit, xkich'aq chikiwach,</para>
  <para style="q">xkik'ayej taqe i kok' ak'un, i kok' xq'un.</para>
  <para style="q">Re' tz'aaq xkisach chi loq'b'al k'ahlaj ha',</para>
  <para style="q">chi loq'b'al k'oyoom laj ixoq.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />¿Chib'ih taq inawaaj wuuk' i hat aj Tiro, aj Sidón,</para>
  <para style="q">aj filisteo?</para>
  <para style="q">¿Mi wilik inawaaj taq aq'ajam wach weh re'?</para>
  <para style="q">Ma' xta reet naa taq nuye'em aweh chi jumehq'iil i tojb'al taq mahk i ruk'ul taq cha weh.</para>
  <para style="q">
    <verse number="5" style="v" />Re' taq i hat xawelq'aaj taq i nuplata i nu oro wilik naq panupaat,</para>
  <para style="q">xak'am taq chu'nchel i q'e' naq k'ih taq tz'aq chi wee hin,</para>
  <para style="q">ar taq chik xak'am reje parupaat taq aatiyoox.</para>
  <para style="q">
    <verse number="6" style="v" />Eh xak'am taq reje chi najt yuuq' i aj Judá,</para>
  <para style="q">je' wo' taqe i aj Jerusaleem xa k'ayej taq reje pankowlaj kamanik kuuk' i aj griego.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' hin naa wo' chik wesam taqe chaloq</para>
  <para style="q">aha' xa k'ayej taq reje wii'.</para>
  <para style="q">Eh cha naah taq chik i hat naa nuye'em i ti' k'axik xkik'ul i keh.</para>
  <para style="q">
    <verse number="8" style="v" />Re' hin naa nuye'em q'ab'</para>
  <para style="q">chi naa kik'ayjik taq aawak'uun awixq'uun keh i aj Judá.</para>
  <para style="q">Eh re' chik i keh nee kik'ayinik reje keh i aj sabeo kichalik chi najt yuuq'.</para>
  <para style="q">Re' hin kinq'orik i wili, inki i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' taq i hat cha q'or taq rib'iral keh i tinamit chi je' wili:</para>
  <para style="q">Chayuq'eej taqe chaloq i kowlaj winaq, kichaloq chi q'aq'inik</para>
  <para style="q">k'oloq kiq'at wach taqe i k'ahchi' keeb' chi q'aq'inik</para>
  <para style="q">
    <verse number="10" style="v" />Re' i kasaroon xkiyejaa' chi q'aslaj ch'ihch',</para>
  <para style="q">re' i kimacheet kiyejaa' chi kiq'as ju' ch'ihch'.</para>
  <para style="q">Eh re' winaq q'e' inyo'jik chuq'or chi je' wili:</para>
  <para style="q">Yu'naak hin chik kow chi q'aq'inik inko'q.</para>
  <para style="q">
    <verse number="11" style="v" />Eh chawunchelaal taq i hat wilkaat</para>
  <para style="q">taq chi junsuut i tinamit Israel chamol taq chaawiib'.</para>
  <para style="q">Re' hat QaJaaw Dios, cha taq'aaj taqe chaloq</para>
  <para style="q">awaj kamanoom chub'aan i ti' k'axik</para>
  <para style="q">keh taqe i re', kinki.</para>
  <para style="q">
    <verse number="12" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' taqe i nimaq tinamit ma' najt ta ruuk' i Israel,</para>
  <para style="q">kimol kiib' wach k'ixkaab' Josafat.</para>
  <para style="q">Ar naanuq'atam i q'orik chikinaah.</para>
  <para style="q">
    <verse number="13" style="v" />Re' hin naanusacham kiwach</para>
  <para style="q">je' kiyok'arik trigo xa q'an chik naa nub'anam taqe.</para>
  <para style="q">Je' wo' kiyitz'arik uuva</para>
  <para style="q">panyitz'b'al reh naa nub'anam taqe,</para>
  <para style="q">ruum xiik' naah yib'kiil wach i kina'ojb'al.</para>
  <para style="q">
    <verse number="14" style="v" />Eh xiik' naah k'ihaal i tinamit wilkeeb' wach k'ixkaab'.</para>
  <para style="q">Re' hin ar naanuq'atam i q'orik chikinaah,</para>
  <para style="q">ruum ponik reh i q'iij chi re' hin i Dios naanuq'atam i q'orik chikinaah.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Re' i q'iij ruch'ihil i poh naaruq'equumriik wach,</para>
  <para style="q">eh re' taqe i ch'umiil ma' naa ta chik kisihq'iniik chaloq, inki.</para>
  <para style="s">Re' i QaJaaw Dios xrisaj wo' chik taqe panti' k'axik i rutinamiit</para>
  <para style="q">
    <verse number="16" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Noq kow naaruq'ajb'aniik chaloq i nuq'oral chinaah i yuuq' Sión,</para>
  <para style="q">ar Jerusaleem, re' i taxaaj, re' wach ak'al naakik'uyu'jiik pan kiye'aab'.</para>
  <para style="q">Eh re' i nutinamiit Israel naa nuko'leem taqe,</para>
  <para style="q">naa nuye'em rukowiil kik'ux.</para>
  <para style="q">
    <verse number="17" style="v" />Re' taq i hat aj Israel naa taq anab'eem chi re' hin taq aaWaJaaw aaDios,</para>
  <para style="q">eh ar wilkiin chinaah i nuSantolaj ye'aab' Sión.</para>
  <para style="q">Eh re' i nutinamiit Jerusaleem naaruwihiik rusantohiil,</para>
  <para style="q">ma' naa ta chik ruchopariik naah</para>
  <para style="q">kuum i tokoom tinamit.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Eh chupaam taqe i q'iij re' re',</para>
  <para style="q">re' i riis i uuva, re' lecha xa je' chik rukab'</para>
  <para style="q">i rooq ha' i nelik pantaq yuuq' k'ixkaab',</para>
  <para style="q">eh chupaam taqe i rooq ha' wilkeeb' Judá</para>
  <para style="q">ma' k'isiin i ha' naakeliik chaloq.</para>
  <para style="q">Eh chupaam i nupaat, je' naa k'achlik ha'</para>
  <para style="q">inareliik chaloq, je' naarut'aqsam</para>
  <para style="q">chu'nchel i wach k'ixkaab' Sitim.</para>
  <para style="q">
    <verse number="19" style="v" />Eh re' i tinamit Egipto reh naa rusahchiik wach,</para>
  <para style="q">re' i tinamit Edom naarukahniik chi</para>
  <para style="q">ma' xta chik i wilkeeb' chupaam,</para>
  <para style="q">ruum i yiib' wach na'ojb'al xkian.</para>
  <para style="q">Re' keh xkikansaj taqe i aj Judá</para>
  <para style="q">chi xama' xta kimahk.</para>
  <para style="q">
    <verse number="20" style="v" />Re' taqe i aj Judá naa wo' chik kichaliik</para>
  <para style="q">chi patinik chi juneliik pan kitinamiit.</para>
  <para style="q">Eh je' wo' taqe i aj Jerusaleem,</para>
  <para style="q">naa wo' kiwihiik ar i xata wo' jar ch'iht</para>
  <para style="q">chi k'achareel i naakik'iik.</para>
  <para style="q">
    <verse number="21" style="v" />Re' hin naa taqe nuye'em chutojariik</para>
  <para style="q">i kimahk i kikansanik reh i nutinamiit.</para>
  <para style="q">Eh re' hin ar naanuwihiik chi juneliik Sión, inki i Dios.</para>
</usx>