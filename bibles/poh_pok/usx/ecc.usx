<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="ECC" style="id">EKKPOK.SFK 09-05-2,008. Adelina Quej Xoy. Pocomchi Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">ECLESIASTES</para>
  <para style="toc3">Ecl</para>
  <para style="toc2">Ecl</para>
  <para style="toc1">ECLESIASTES</para>
  <para style="mt2">RE' I RUHUUJ I ECLESIASTES</para>
  <para style="mt1">ECLESIASTES</para>
  <chapter number="1" style="c" />
  <para style="s">Chu'nchel imb'aan wach ak'al xama' xta ruk'am chaloq</para>
  <para style="q">
    <verse number="1" style="v" />Re' i Salomón xti wilik runa'ojb'al,</para>
  <para style="q">rak'uun i David xwihik cho chi reyil Jerusaleem je' wili i xuq'or:</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Chib'ih imb'aan, chib'ih i wilik wach ak'al xama' xta ruk'am chaloq,</para>
  <para style="q">eh xti korik noq chu'nchel i re' ma' xta ruk'am chaloq.</para>
  <para style="q">
    <verse number="3" style="v" />¿Chib'ih neeruk'ax i winaq chi rajlaal i q'iij</para>
  <para style="q">neeruk'at riib' chi kamanik chuwach i rutz'ahiil i q'iij?</para>
  <para style="q">
    <verse number="4" style="v" />Re' taqe i k'achareel kikimik, eh wilik wo' chik i ki-aasjik.</para>
  <para style="q">Eh kikimik wo' chik reje, eh re' wach ak'al xama' njaljik ta wo' wach.</para>
  <para style="q">
    <verse number="5" style="v" />Re' i q'iij i nelik chaloq</para>
  <para style="q">re' q'iij inokik qohoq, eh inenelik wo' chik chaloq chi junwaar.</para>
  <para style="q">
    <verse number="6" style="v" />Re' i teew inooj hupinoq pansak'aaj</para>
  <para style="q">reh i rookb'aal i q'iij, pantz'eet reh i rookb'aal i q'iij.</para>
  <para style="q">Eh xa aha' ta chik ma' nooj hupinoq eh insutinik wo' chik chaloq.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' taqe i rooq ha' pam palaw kiooj qohoq,</para>
  <para style="q">eh re' taqe palaw xama' kinujik ta wo' hoq,</para>
  <para style="q">eh aha' ki-ik'ik eqal eqal</para>
  <para style="q">xa ar wo' chik ki-ik'ik.</para>
  <para style="q">
    <verse number="8" style="v" />Eh chu'nchel i xa chib'ih jariik,</para>
  <para style="q">xaneenb'aan q'uhtik reh, ma' nee ta inkan i q'orik reh i ruq'orariik,</para>
  <para style="q">atoob' ta nee rilow inaq'qawach, neerib'iraj i qaxikin,</para>
  <para style="q">xama' nee ta wo' inch'iklojik k'uxliis.</para>
  <para style="q">
    <verse number="9" style="v" />Re' taqe i wilkeeb' cho najtir xa re' wo' re' i wilkeeb' yu'naak.</para>
  <para style="q">Re' i korjinaq cho najtir</para>
  <para style="q">xa re' wo' inkorjik yu'naak,</para>
  <para style="q">ma' xta chik jino'q i ak' inkorjik, chinaah i wach ak'al.</para>
  <para style="q">
    <verse number="10" style="v" />Eh ma' awach ta nee nq'orik reh, re' wili ko ak' chik,</para>
  <para style="q">ruum chu'nchel i chib'ih jariik wilkeeb'</para>
  <para style="q">xama' yu'naak wo' q'iij saqum rukorjiik chaloq.</para>
  <para style="q">
    <verse number="11" style="v" />Chu'nchel i b'anooj cho najtir xsahchik pank'uxliis,</para>
  <para style="q">eh chu'nchel i k'ahchi' yu'naak,</para>
  <para style="q">chu'nchel i naa rub'aan na' chub'an naa wo' rusahchiik, pank'uxliis.</para>
  <para style="s">Re' i rusik'ariik ruman i na'ojb'al xama' xta ruk'am chaloq</para>
  <para style="p">
    <verse number="12" style="v" />Re' hin i xti wilik nuna'ojb'al xinwihik cho chi kireey i aj Israel ar Jerusaleem. <verse number="13" style="v" />Re' hin xnuyeew nuk'ux chi rusik'ariik chi riij ruuk' i na'ojb'al nik' wach noq wilik chu'nchel imb'aan chinaah i wach ak'al wili. Eh xwilow chi re' i Dios yohb'aal wach kowiil i kamanik xuyeew cho chi qanaah. <verse number="14" style="v" />Eh re' hin xnukoj rehtaal chi chu'nchel imb'aan ayu' wach ak'al xama' xta ruk'am chaloq, xa je' rukab' noq neenajawjik ruchopariik i teew.</para>
  <para style="q">
    <verse number="15" style="v" />Re' yok yok noq wilik ma' nee ta chik i rub'an chi nee nayub' wach.</para>
  <para style="q">Eh jino'q i ma' manlik taj, ma' nee ta rub'an chi neenqamanaa' rajaljiik.</para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" />Re' hin xnuq'or pan wánima chi je' wili: Re' hin ayu' wilkiin xiik' naah nimaal nuwach, xiik' naah i nuna'ojb'al chikiwach i wihinaq taqe chaloq chi reyil ar Jerusaleem peet chi nuwach i hin. Eh ma' k'isiin i nuna'ojb'al xnureq kinki. <verse number="17" style="v" />Re' hin xnuchop nuk'ux chureqariik ruman i nuna'ojb'al, eh xwaaj naq nureqem chi riij i memil, i sah cheel laj na'ojb'al. Xa re' la' re' taqe i re' xama' xta ruk'am chaloq xaruti'kiil k'uxliis inki yeew. <verse number="18" style="v" />Ruum awach i,</para>
  <para style="b" />
  <para style="q">ma' k'isiin runa'ojb'al ma' k'isiin wo' ruk'axkiil inchalik.</para>
  <para style="q">Eh wila' ma' k'isiin reht'al ma' k'isiin wo' i ti' inchalik chinaah.</para>
  <chapter number="2" style="c" />
  <para style="s">Re' i rusik'ariik i suq kiil k'uxliis wach ak'al xama' xta ruk'am chaloq</para>
  <para style="p">
    <verse number="1" style="v" />Re' hin je' wili xnuq'or panuk'ux: Naa nunik'eem rusik'ariik i suq laj k'achariik, kinki. Eh re' taqe i re' xwilow chi xama' xta ruk'am chaloq. <verse number="2" style="v" />Re' se'eel i ruyeew i wach ak'al xasah cheel laj na'ojb'al, eh xama' xta ruk'am chaloq.</para>
  <para style="p">
    <verse number="3" style="v" />Eh re' hin sik'ij naq nuna'ojb'al i nub'an xnukapaaj naq chi naa nureqem rusuqkiil nuk'ux ruuk' i xohk'rik, xnuyeew reh i k'ahlaj ha' i nuti'jolal, i ib'al reh mi re' re' i ruk'ul chi neerub'an i winaq nik' najtiil i ruk'achariik ayu' wach ak'al. <verse number="4" style="v" />Yohb'aal wach i nimaq kamanik xnub'an ma' k'isiin taqe i nupaat xnuyejaa', eh runimaal i nu uuva xnutik. <verse number="5" style="v" />Eh nuyejaa' wo' nuye'aab' xnutik taqe i chee' ar re' ruuk' i suq inkiwachuj, eh xnutik taqe i uhtz'ub' ar. <verse number="6" style="v" />Xnuyejaa' wo' taqe i nimaq tz'aq ye'aab' ha' tz'aqtesb'al reh taqe i chee' kiwachinik. <verse number="7" style="v" />Eh re' hin xnuloq' taqe i numoso winaq, eh ixoq, xi wihik taqe i numoso pan nupaat xi-aasjik. Eh k'ih i nuwakax, i nutentzuun xi wihik, chikiwach i xwihik cho chi reyil Jerusaleem peet taqe chi nuwach i hin. <verse number="8" style="v" />Eh ma' k'isiin taqe i oro, i plata xnumol wach, je' wo' taqe i xa chib'ih jariik k'ih taq tz'aaq xkik'am cho weh i reey tokoom tinamit kichalik ma' k'isiin wo' taqe waj tz'uuy xiye'wik rusuqkiil nuk'ux chi winaq chi ixoq. Ma' k'isiin taqe i wixoqil xi wihik.</para>
  <para style="p">
    <verse number="9" style="v" />Xti xiik' wo' naq naah runimaal nuwach, eh xa re' wo' naq i hin ma' k'isiin i chib'ih weh xwihik chikiwach taqe i xi wihik cho chi reyil Jerusaleem peet chi nuwach i hin. Eh ma' k'isiin wo' i nuna'ojb'al wilik. <verse number="10" style="v" />Eh aha' wilik ixnuk'ax wach xnub'an wo' hoq, aha' wilik ixwaaj xnuyeew wo' reh i nuti'jolal. Re' taqe i re' xuyeew weh i kowlaj kamanik xnub'an.</para>
  <para style="p">
    <verse number="11" style="v" />Eh re' hin xnukapaaj riij taqe i nub'an, je' wo' chu'nchel i kowlaj kamanik xnub'an. Ar xnukoj rehtaal chi xama' xta ruk'am chaloq, xama' xtaj ixnuk'ax ruuk' chinaah i wach ak'al wili, xaruti'kiil k'uxliis i ruyeew.</para>
  <para style="p">
    <verse number="12" style="v" />Eh chi riij i re' xtohq'ik nukapaam chi riij i holohik laj na'ojb'al, je' wo' i memil laj na'ojb'al. Eh ¿chib'ih jariik i naa rub'anam i naa rokiik chi reyil noq ma' wilkiin ta chik i hin? ma' xta chik jino'q tokoom naa rub'anam xa re' wo' hoq i xnub'an i hin. <verse number="13" style="v" />Re' hin xwilow chi re' i holohik laj na'ojb'al q'e' holohik chuwach i na'ojb'al xanik' wach, je' rukab' i saqum q'e' holohik chuwach i q'equm.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' wilik runa'ojb'al saqum paam i rukapeb'aal,</para>
  <para style="q">re' i ma' nimanik taj q'equm paam i rukapeb'aal</para>
  <para style="q">xa re' la' jinaj wach inaruk'ulum i wilik runa'ojb'al ruuk' i ma' xta runa'ojb'al.</para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" />Re' hin je' wili i xnuq'or panuk'ux: Re' hin wilik nuna'ojb'al wila' naa nuk'ulum weh je' rukab' inaruk'ulum i ma' xta runa'ojb'al, xama' xta inki chi ma' k'isiin i nuna'ojb'al. Eh xnuq'or chi chu'nchel inqa a'n xama' xta ruk'am chaloq. <verse number="16" style="v" />Ruum ma' naa ta chik ruk'uliik pank'uxliis chi jumpech i wilik runa'ojb'al, i ma' xta runa'ojb'al. Ruum naa rukimiik i wilik runa'ojb'al, je' wo' hoq i ma' xta runa'ojb'al, kinki.</para>
  <para style="p">
    <verse number="17" style="v" />Re' hin xponik i q'iij noq xwixow wach i nuk'achariik, ruum chu'nchel imb'aan ayu' wach ak'al, xati' k'axik i ruyeew chi qanaah xama' xta ruk'am chaloq, xaruti'kiil k'uxliis i ruyeew.</para>
  <para style="p">
    <verse number="18" style="v" />Eh wixow wo' wach chu'nchel i kamanik xnub'an, chinaah i wach ak'al wili. Ruum weht'al chi chu'nchel i chib'ih weh naa nukanaam kahnoq reh i tokoom. <verse number="19" style="v" />Eh re' hin ma' weht'al taj mi wilik runa'ojb'al oon ma' xta runa'ojb'al i naa rehchaniik reh i xnumol wach ruuk' i kowlaj kamanik xnub'an wach ak'al. Eh re' i nunim wach na'ojb'al xama' xta ruk'am chaloq.</para>
  <para style="p">
    <verse number="20" style="v" />Noq xwilow chu'nchel i chib'ih weh xnureq ruuk' kowlaj kamanik xnub'an xaruti'kiil nuk'ux i ruyeew. <verse number="21" style="v" />Eh re' winaq wilik runa'ojb'al ruuk' rukorkiil wach ruk'ux i rub'an i kowlaj kamanik noq i rureq tz'aaq i chib'ih reh. Eh ma' reht'al taj chi re' chib'ih reh, reh i ma' rukamaneem ta wach naa rukanaam. Ar ink'utinik chi re' kamanik i rub'an xama' xta ruk'am chaloq.</para>
  <para style="p">
    <verse number="22" style="v" />Ruuk' i wili ink'utinik chi xama' xta rutiq reh i winaq chi nee rukansaj riib' chi kamanik ayu' wach ak'al. <verse number="23" style="v" />Eh chu'nchel i ruk'achariik xati' k'axik wilik, xaruq'uhtisaj riib' chi kamanik ni xata re' chaq'ab' inhi'lik i rukapeb'aal, eh chu'nchel i re' xama' xta ruk'am chaloq.</para>
  <para style="p">
    <verse number="24" style="v" />Re' ruk'ul chi naa rub'anam i winaq, re' chi chub'an ruwa' ruhaa', chub'an rusuqkiil i chib'ih reh i rureq ruuk' i rukamaj. Re' hin xnukoj rehtaal chi chu'nchel i chib'ih qeh re' i Dios inye'wik cho reh. <verse number="25" style="v" />Ruum ma' awach taj i neerub'an rusuqkiil chib'ih reh wila' ma' xuyeew i Dios. <verse number="26" style="v" />Awach imponik chuwach i Dios i rub'an, inye'arik runa'ojb'al, rukapeb'aal, rusuqkiil ruk'ux. Eh re' imb'anik reh i mahk inye'arik pankowlaj kamanik ruum i Dios reh chi rumol wach i chib'ih reh, reh i tokoom i ruyeew. Re' taqe i re' xama' xta i ruk'am chaloq, xaruti'kiil k'uxliis i ruyeew.</para>
  <chapter number="3" style="c" />
  <para style="s">Chu'nchel imb'aan ayu' wach ak'al wilik ruq'ijil eh wilik ru orahiil</para>
  <para style="p">
    <verse number="1" style="v" />Chu'nchel imb'aan ayu' wach ak'al wilik ruq'ijil, wilik ru orahiil je' wili noq wilik:</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Wilik ru orahiil noq imb'aan aasjik,</para>
  <para style="q">wilik ru orahiil noq imb'aan kimik,</para>
  <para style="q">wilik ruq'ijil noq imb'aan tik,</para>
  <para style="q">wilik ruq'ijil noq inchuqarik i tik.</para>
  <para style="q">
    <verse number="3" style="v" />Wilik ru orahiil ikaansanik,</para>
  <para style="q">wilik ru orahiil iq'omanik,</para>
  <para style="q">wilik ruq'ijil i yojoj paat,</para>
  <para style="q">wilik ruq'ijil i yej-anik paat.</para>
  <para style="q">
    <verse number="4" style="v" />Wilik ru orahiil oq'ik,</para>
  <para style="q">wilik ru orahiil i se'eel,</para>
  <para style="q">wilik ru orahiil i ti'kiil k'uxliis,</para>
  <para style="q">wilik ru orahiil i ninq'ijinik.</para>
  <para style="q">
    <verse number="5" style="v" />Wilik ruq'ijil noq imb'aan i kutuj ab'aj,</para>
  <para style="q">wilik ruq'ijil i moloj wach ab'aj,</para>
  <para style="q">wilik ru orahiil noq imb'aan q'ahchinik iib',</para>
  <para style="q">wilik ru orahiil noq inkanab'jik i q'ahchinik iib'.</para>
  <para style="q">
    <verse number="6" style="v" />Wilik ruq'ijil rusik'ariik,</para>
  <para style="q">wilik ru orahiil i rusachariik,</para>
  <para style="q">wilik ru orahiil i rumolariik,</para>
  <para style="q">wilik ru orahiil reh ruq'eb'ariik.</para>
  <para style="q">
    <verse number="7" style="v" />Wilik ru orahiil i xihij itz'ihy,</para>
  <para style="q">wilik ru orahiil i rub'ojariik i xiheel,</para>
  <para style="q">wilik ru orahiil chi neemb'aan i q'orik,</para>
  <para style="q">wilik ru orahiil chi ma' nee tamb'aan i q'orik.</para>
  <para style="q">
    <verse number="8" style="v" />Wilik ru orahiil i k'axaj iib',</para>
  <para style="q">wilik ru orahiil i ixowanik iib',</para>
  <para style="q">wilik ruq'ijil i q'aq'inik,</para>
  <para style="q">wilik ruq'ijil i wihik pansuqkiil k'uxliis.</para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" />Eh ¿Mi wilik ta wo' hoq i ruk'ax i winaq noq i rukansaj riib' chi kamanik ayu' wach ak'al? <verse number="10" style="v" />Re' hin xnukoj rehtaal chi re' Dios yohb'aal wach i kamanik i ruyeew chikinaah taqe i winaq reh chi naa kianam. <verse number="11" style="v" />Eh re' Dios paruq'ijil xuyejaa' taqe i chib'ih jariik chi q'e' holohaq, eh xuyeew pankikapeb'aal i winaq, i k'uluuj, i naa ruk'ulariik Eh xama' inkireq ta wo' chi riij i rub'anam chaloq Dios pampeet, i naa rub'anam na' chub'an.</para>
  <para style="p">
    <verse number="12" style="v" />Re' hin i nukoj rehtaal chi re' i ruk'ul chi neerub'an i winaq, re' chi neensuuqb'ik ruk'ux, eh chi neerub'an rusuqkiil i ruk'achariik. <verse number="13" style="v" />Ruum wila' xqa a'n qawa' qahaa' chi manlik, i wixqa a'n rusuqkiil i qakamaj, re' wo' QaJaaw Dios inye'wik cho qeh. <verse number="14" style="v" />Re' hin weht'al chi chu'nchel i ruyejaam i QaJaaw Dios manlik wach,</para>
  <para style="b" />
  <para style="q">ma' ruman ta chik chi neentiqarik naah, chi neenehteesjik ruuk'.</para>
  <para style="q">Ruum re' i QaJaaw Dios je' taqe re' ruyejeb'jiik</para>
  <para style="q">rub'anam, reh chi naa ruyohljiik wach i reh.</para>
  <para style="q">
    <verse number="15" style="v" />Eh ma' xtaj i wilik chi ma' ta wihinaq chaloq</para>
  <para style="q">ma' xtaj i naa ruk'ulariik chi ma' ta nk'ularik yu'naak.</para>
  <para style="q">Re' i QaJaaw Dios imb'anik chi nk'ularik wo' chik i k'uluuj chaloq.</para>
  <para style="s">Ayu' wach ak'al ma' xtaj imb'aan parub'ehel</para>
  <para style="q">
    <verse number="16" style="v" />Eh xnukoj rehtaal chi ayu' wach ak'al wilik i leq',</para>
  <para style="q">wilik i yiib' wach na'ojb'al,</para>
  <para style="q">xanaah re' i ruk'ul naq chi neemb'aan i rub'ehel</para>
  <para style="q">chi naa ruwihiik rukorkiil wach k'uxliis.</para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" />Re' hin i nuq'or chi re' i QaJaaw Dios naa ruq'atwiik i q'orik chinaah i korik wach ruk'ux, chinaah i yiib' wach runa'ojb'al. Ruum wilik ru orahiil chib'ih imb'aan, eh wilik ru orahiil chib'ih taqe ink'ularik.</para>
  <para style="p">
    <verse number="18" style="v" />Eh i nuq'or panuk'ux chi re' Dios k'ahchi' ruye'em taqe chi pajarik i winaq reh chi neenkireq chi riij chi re' i kina'ojb'al je' rukab' i kina'ojb'al taqe i chikop. <verse number="19" style="v" />Korik wo' hoq chi je' winaq, chi je' chikop eliik wach inkik'ul noq inooj kuxoq. Re' chikop kikimik wo' reje, re' winaq kikimik wo' reje, xa eliik wach chi ma' xta ruk'am chaloq.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Xa jinaj naa kojiik kuxoq wii',</para>
  <para style="q">pooq xikorb'eesjik wii',</para>
  <para style="q">eh pooq wo' chik naakisutiniik wii'.</para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" />¿Mi wilik nee nq'orik reh chi korik chi re' ruxlab'al inye'wik ruk'achariik i winaq injohtik taxaaj. Eh chi re' ruxlab'al inye'wik ruk'achariik i chikop inooj qohoq ri'si ak'al?</para>
  <para style="p">
    <verse number="22" style="v" />Ruuk' taqe re' xnukoj rehtaal chi re' i ruk'ul chi naa rub'anam i winaq re' chi naa rub'anam rusuqkiil i rureq ruuk' i rukamaj. Ruum xaruq'iij chi je' re' i k'acharik xub'an. Eh ma' awach ta neenk'uhtanik reh chib'ih i naa ruk'ulum chi riij chik i rukimiik.</para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chi riij i re' xwilow wo' hoq i ti' k'axik imb'aan ayu' wach ak'al. Re' imb'aan ti' k'axik keh xasuq chik kioq'ik, ma' awach ta jino'q inye'wik rusuqkiil kik'ux. Eh re' taqe i kib'anik ti k'axik xa chayeew chik inki a'n eh re' imb'aan ti' k'axik keh ma' awach taj jino'q intoob'inik keh. <verse number="2" style="v" />Ruum i re' xnuq'or i hin chi suq wilkeeb' i kamnaq chik taqe reje chuwach taqe i kok'achalkeeb'. <verse number="3" style="v" />Eh chikiwach taqe i re' xti q'e' wo' chik suq wilkeeb' i komajaa' ki-aasjik, ruum komajaa' inkilow i yiib' wach na'ojb'al imb'aan chinaah i wach ak'al wili.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh nukoj wo' rehtaal chi awach i</para>
  <para style="q">rumol chib'ih reh ruuk'</para>
  <para style="q">i kowlaj kamanik i rub'an,</para>
  <para style="q">i rutoq'aa' kaqwachiil ruuk' i ras ruchaaq',</para>
  <para style="q">chu'nchel i re' ma' xta ruk'am chaloq,</para>
  <para style="q">xaruti'kiil k'uxliis i ruyeew.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' i ma' nimanik taj i ruq'ahcheej i q'ab' chi' rik'ux,</para>
  <para style="q">ma' rusik' ta tz'aaq i k'uxumb'al reh.</para>
  <para style="q">
    <verse number="6" style="v" />Re' hin i nuq'or chi ma' xta reet</para>
  <para style="q">chi nee ruq'ahcheej i q'ab' chi' ruk'ux jino'q i winaq,</para>
  <para style="q">chuwach chi nee rukansaj riib' chi kamanik,</para>
  <para style="q">eh xaruti'kiil ruk'ux i neenye'arik.</para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" />Eh re' hin xnukoj wo' rehtaal chi wilik imb'aan ayu' wach ak'al xama' xta ruk'am chaloq. <verse number="8" style="v" />Re' jino'q i winaq ma' xta wilik reh, ma' xta wo' ramigo, ma' xta rak'uun rixq'uun, ma' xta ras oon ruchaaq'. Eh ma' hi'lik ta chi kamanik, ma' hi'lik ta wo' chi kapeb'jiik riij i rub'ehomal. Eh ma' rukapaaj taj awach aj eh naa rukahniik taqe i rureq ruuk' i kowlaj kamanik i rub'an, re' taqe i re' xama' xta ruk'am chaloq.</para>
  <para style="p">
    <verse number="9" style="v" />Ma' xta reet chi pankib'al neenb'aan i kamanik, chuwach chi xa jinaj neemb'anik reh, ruum pankib'al k'ihtz'aaq kikamaj. <verse number="10" style="v" />Ruum wila' xq'ehb'ik i jinaj, re' chik i jinaj neen nuksanik reh. Eh re' rutkeel riib' q'e' ti' i neeruk'ul ruum wixq'ehb'ik ma' awach ta nenuksanik reh. <verse number="11" style="v" />Eh je' wo' noq pankib'al neemb'aan wirik k'ul neenkiq'ixineej kiib'. Eh re' i rutkeel inwirik ma' awach ta neen q'ixinb'isanik reh. <verse number="12" style="v" />Awach i rutkeel riib' neerutik'aa' peleto neemb'aan reh, eh wila' pankib'al xkik'ulb'ilej ma' nee tamb'aan reh, je' rukab' i k'ahaam ixib' wach ma' nk'up ta chi jumehq'iil.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Q'e' chihooj i k'ijool ak'un atoob' ta xa neb'aa' tiih,</para>
  <para style="q">chuwach jino'q i reey xa rijib' chik, ma' nimanik taj,</para>
  <para style="q">eh ma' raaj ta chinkojarik runa'ojb'al.</para>
  <para style="q">
    <verse number="14" style="v" />Ruum re' i k'ijool ak'un atoob' ta pantz'ilom</para>
  <para style="q">nee nelik chaloq, neerub'an chi neenokik</para>
  <para style="q">chi reyil, atoob' ta xa neb'aa' tii.</para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" />Eh wila' chu'nchel neekiokik chi riij i k'ijool ak'un chi neenokik chi jilow i reey. <verse number="16" style="v" />Eh ma' k'isiin i tinamit neekiokik chi riij reh chi nee nokik chi reyil. Xa re' la' re' tinamit naa kiwihiik koq'uun ma' naa ta chik ruwihiik rusuqkiil kik'ux ruuk'. Chu'nchel i re' xama' xta i ruk'am chaloq, xaruti'kiil k'uxliis i ruyeew.</para>
  <chapter number="5" style="c" />
  <para style="s">Ajwaal wach chi naa rub'aan aha' wilik inq'orarik</para>
  <para style="p">
    <verse number="1" style="v" />Noq nee tiooj panrupaat i Dios, mo'-oq teheeh awach. Chajil i koq awiib' chi-ib'iriniik, maa nooj aq'asaj amayiij, je' rukab' noq ink'iq'asaj i kik'atoj mayiij i ma' kinimanik taj, ma' inkikoj ta rehtaal chi ma' holohik taj inki a'n.</para>
  <para style="p">
    <verse number="2" style="v" />Eh maa a'n teheeh awach chi q'orik, ma' chih aq'or reh i Dios chi naa a'nam eh mo'-oq wo' neena a'n rub'aan. Eh xakiib' ixib' aq'oral cha q'or ree Dios, ruum re' i Dios pan taxaaj wilik, eh re' hat ayu' wilkaat wach ak'al. <verse number="3" style="v" />Ruum wi q'e' xat qajik kapeew, wilik neeruk'uhtaaj riib' aweh panasaq wiriik. Eh wila' ma' k'isiin i q'orik xa a'n neenaq'or aweh i xa memil laj q'orik.</para>
  <para style="p">
    <verse number="4" style="v" />Eh wila' wilik i xaq'or ree Dios chi naa a'nam cha a'n wo' hoq, ruum re' Dios ma' mponik ta chuwach taqe i chukul q'orik. <verse number="5" style="v" />Eh ma' xta reet chi ma' nee ta naq'or reh chi neena a'n chuwach chi nee naq'or reh chi neena a'n, eh ma' nee ta wo' na a'n rub'aan.</para>
  <para style="p">
    <verse number="6" style="v" />Mayeew q'ab' reh aachii' chi nee tiruq'eb' pamahk, eh koq'uun chik neenaq'or chuwach iraaj taqareel i Dios chi xa asahchik xaq'or wii'. Wila' xaq'or i je' re' neenajosaj wach i rujosq'iil i Dios neerusach wach aha' wilik i xa a'n.</para>
  <para style="p">
    <verse number="7" style="v" />Re' hat,</para>
  <para style="b" />
  <para style="q">wila' ma' k'isiin i ruk'uhtaaj riib' aweh pansaq wiriik,</para>
  <para style="q">eh wila' xama' k'isiin i q'orik i na a'n,</para>
  <para style="q">re' taqe i re' xama' xta ruk'am chaloq.</para>
  <para style="b" />
  <para style="q">Re' hat chayohleej wach i Dios.</para>
  <para style="s">Re' imb'aan chupaam i k'acharik xama' xta ruk'am chaloq</para>
  <para style="p">
    <verse number="8" style="v" />Re' hat maa nsahchik ak'ux wila' wilik i tinamit xawil chi rub'aan i ti' k'axik keh i neb'aa', eh chi ma' imb'aan taj i q'ataj q'orik parub'ehel, ruum re' i q'atal q'orik xa taaq'amaj wo' ruum i nim wach chuwach i reh, eh re' reh jinaj wo' chik i nim wach intaaq'anik reh. <verse number="9" style="v" />Eh re' tik i nelik chupaam taqe i ye'aab' inkamanik reh i reey, re' wo' reh inilwik reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Awach i ruyeew i ruk'ux chinaah i tumiin koruman iraaj.</para>
  <para style="q">Awach i ruyeew ruk'ux chinaah i b'ehomal</para>
  <para style="q">ma' manlojik ta reh nik' nimaal i chib'ih reh wilik.</para>
  <para style="b" />
  <para style="q">Eh re' taqe i re' xama' xta ruk'am chaloq.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Awach i k'ih i chib'ih reh k'ih wo' hoq i rusach,</para>
  <para style="q">iraaj ruq'orom chi xama' xta wo' ruk'ax chi k'ih i chib'ih reh</para>
  <para style="q">xa nee wo' nooj k'uhloq chuwach.</para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" />Awach inkamanik atoob' ta neerub'an ruwa' chi korik atoob' ta ma' neerub'an ruwa' chi korik xasuq wo' inwirik. Eh re' i b'ehoom reh ma' nqajik tee ruwiriik chukapeb'jiik i chib'ih wilik reh.</para>
  <para style="p">
    <verse number="13" style="v" />Re' hin jinaj i q'e' ti' xwilow ink'ularik chinaah i wach ak'al wili, re' rumolariik wach i ma' k'isa b'ehomal, eh xati' k'axik i ruk'am chaloq, noq inooj kuxoq. <verse number="14" style="v" />Ruum wila' ma' xchol rilariik i rub'ehomal neensahchik wach. Eh ma' xta k'isinoq nee rukanaa' reh i rak'uun rixq'uun. <verse number="15" style="v" />Eh nik' wach noq x-aasjik je' wo' chik re' noq naa ruk'ohlaam reje i ruk'achariik t'uslik noq x-aasjik, t'uslik wo' chik noq naa rukimiik, ma' xtaj i naa ruk'amam reje. <verse number="16" style="v" />Re' wili q'e' ti' rilariik ruum nik' wach noq xk'uloq chinaah i wach ak'al wili, je' wo' chik re' noq naa reliik reje, inqakoj rehtaal chi xama' xta nki chi xukansaj riib' chi kamanik. <verse number="17" style="v" />Eh xa panq'equm wo' xk'acharik, eh xa eliik tib'ik ruk'ux, xa elik panti' pan yab'ilaal xwihik.</para>
  <para style="p">
    <verse number="18" style="v" />Re' i ruk'ul chi naa rub'anam i winaq re' chi naa rub'anam rusuqkiil i chib'ih reh xureq ruuk' i ma' k'isa kamanik xub'an. Paruk'achariik xama' najt ta rooq ayu' wach ak'al xye'arik reh ruum i Dios, i ruk'ul chi je' re' i naa rub'anam ruum je' re' xkanab'jik chinaah. <verse number="19" style="v" />Eh awach i ma' k'isiin rub'ehomal xye'arik cho reh ruum i Dios i ruyeew wo' q'ab' reh chi rub'an rusuqkiil aha' wilik i ree reh, noq i rub'an rusuqkiil i rureqem ruuk' i rukamaj re' Dios inye'wik reh. <verse number="20" style="v" />Ruum chi re' i Dios inye'wik rusuqkiil i ránima ma' nqaaj ta kapeew chi riij i chib'ih taqe i ruk'ul paruk'achariik ayu' wach ak'al.</para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Re' hin xnukoj rehtaal chi wilik wo' chik i k'axik xak'ahchi' ruk'ulariik ayu' wach ak'al, re' wili: <verse number="2" style="v" />Wilik inye'arik rub'ehomal ruum i Dios, inye'arik reh chu'nchel i ajwaal wach chi reh, inye'arik ruloq'il. Xa re' la' ma' inye'arik ta q'ab' reh ruum i Dios chi rub'an rusuqkiil, tokoom chik imb'anik rusuqkiil. Re' re' xama' xta ruk'am chaloq, xaruti'kiil k'uxliis i ruyeew. <verse number="3" style="v" />Re' winaq neerub'an chi neen wihik jino'q siento rak'uun rixq'uun, chi k'ih laj haab' neenk'acharik, eh wila' ma' xub'an, rusuqkiil i chib'ih reh, eh wila' ma' xukanaa' rutumiin muq'umb'al reh. Re' ti' nee ruk'ul saqb'ih chi neenik'ik jino'q i k'isa ha'lak'un.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Ruum re' k'isa ha'lak'un xaxik'ik xa</para>
  <para style="q">ma' x-ilarik ta wo' wach xa panq'equm xkahnik,</para>
  <para style="b" />
  <para style="m">eh xama' xkojarik ta wo' rub'ihnaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh ma' xrilow ta wo' wach i q'iij saqum,</para>
  <para style="q">eh ma' xuk'ul ta reh i ti' k'axik i xuk'ul i winaq kore' xqaq'or. <verse number="6" style="v" />Ruum re' winaq re' re' atoob' ta neenk'acharik</para>
  <para style="q">kib'-oq miil haab', eh ma' nee ta rub'an rusuqkiil i chib'ih reh.</para>
  <para style="q">¿Mi ma' jinaj kiooj wii' ruuk' re' k'isa ha'lak'un?</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' winaq i rukansaj riib' chi kamanik</para>
  <para style="q">chusik'ariik tz'aaq i k'uxunb'al reh,</para>
  <para style="q">xa re' la' xama' inch'iklojik ta wo' ruk'ux ruuk' i rureq.</para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" />¿Mi suq wilik re' i wilik runa'ojb'al chuwach i ma' xta runa'ojb'al? ¿Mi q'e' suq wilik re' i neb'aa' xchol k'acharik ayu' chi kixilak taqe i k'achareel? <verse number="9" style="v" />Eh ma' xta reet chi nee rilow ruuk' naq'awach i chib'ih reh jino'q, chuwach chi xa neerukapaaj. Xa re' la' xama' xta wo' ruk'am chaloq xaruti'kiil k'uxliis i ruyeew.</para>
  <para style="p">
    <verse number="10" style="v" />Aha' wilik ink'ularik yu'naak, ink'ularik wo' cho najtir, eht'alimaj chi xa je' wo' re' ink'ularik. Je' re' noq ma' ruk'ul taj chi awach neenwech'inik riij i ruyejaam wach i Dios nim rajaawriik.</para>
  <para style="p">
    <verse number="11" style="v" />Awach imponik chuwach i wech'inik iib' xama' xta ruk'am chaloq i rub'an, xama' xta wo' i neeruk'ax ruuk' i re'.</para>
  <para style="p">
    <verse number="12" style="v" />Xti korik chi ma' awach taj i neehtalinik reh aha' wilik i holohik chi reh i winaq noq kok'acharik i rub'an wach ak'al chuwach i xama' k'ih ta laj q'iij. Re' i k'achariik xama' xta ruk'am chaloq, xa je' nik'ik jinaj muuj. Eh ¿Mi wilik jino'q i nee nq'orik reh i chib'ih i naa ruk'ulrariik noq kamnaq chik reje?</para>
  <chapter number="7" style="c" />
  <para style="s">Ma' eliik ta wach i wilik runa'ojb'al ruuk' i ma' xta runa'ojb'al</para>
  <para style="q">
    <verse number="1" style="v" />Noq holohik rib'iral jino'q xiik' naah chihojal chuwach ink'ohnik laj iq'oom</para>
  <para style="q">Eh q'e' wo' chihooj i kimik, chuwach i aasjik.</para>
  <para style="q">
    <verse number="2" style="v" />Eh q'e' wo' chihooj ojik chupaam i paat wilik wii' i kamnaq,</para>
  <para style="q">chuwach ojik chupaam i paat k'ahchi' wii' i ninq'ijinik.</para>
  <para style="q">Ruum re' i kimik k'ahchi' ruye'em i k'achareel,</para>
  <para style="q">awach i kok'achlik inchol rukapaam riij.</para>
  <para style="q">
    <verse number="3" style="v" />Eh q'e' wo' chihoojoq'ik chuwach i se'eel</para>
  <para style="q">ruum ruuk' i ruti'kiil k'uxliis i ruyeew ruman i rukowiil qak'ux.</para>
  <para style="q">
    <verse number="4" style="v" />Re' wilik runa'ojb'al ar wilik reje i rukapeew chupaam i paat wilik wii' kamnaq.</para>
  <para style="q">Eh re' i ma' xta runa'ojb'al ar wilik reje</para>
  <para style="q">i rukapeew chupaam i paat wilik wii' i ninq'ijinik.</para>
  <para style="q">
    <verse number="5" style="v" />Q'e' chihooj chi neenib'irjik i q'ilooj i rub'an i wilik runa'ojb'al,</para>
  <para style="q">chuwach chi neenqayeew ruloq'il inki a'n i ma' xta kina'ojb'al.</para>
  <para style="q">
    <verse number="6" style="v" />Re' rusuqkiil ruk'ux i ma' nimanik taj xa junik'iik,</para>
  <para style="q">xa je' rukab' noq ink'ahtik i chiq k'ix chi ri'sil jino'q i xun.</para>
  <para style="q">Re' taqe re' xama' xta ruk'am chaloq.</para>
  <para style="q">
    <verse number="7" style="v" />Re' wilik runa'ojb'al, re' rub'anariik i ti' k'axik,</para>
  <para style="q">re' ruk'ulariik i tumiin chi riij i ma' korik taj inyojwik reh i runa'ojb'al.</para>
  <para style="q">
    <verse number="8" style="v" />Q'e' chihooj i rukuxeesjiik jino'q i chib'ih jariik chuwach i rutik'ib'jiik.</para>
  <para style="q">Eh q'e' chihooj chi xa hat kuyuul chuwach chi q'e' hat kow neena a'n awiib'.</para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" />Maa nchalik ak'aah chi jumehq'iil ruum xa re' wo' taqe i ma' xta kina'ojb'al inchalik kik'aah chi jumehq'iil.</para>
  <para style="p">
    <verse number="10" style="v" />Re' hat ma' naa ta q'orom chi je' wili: ¿Chib'ih reet noq re' taqe i q'iij ik'inaq chaloq q'e' chihooj chuwach taqe i q'iij yu'naak? mat ko'q. Ruum xa re' taqe i ma' xta kina'ojb'al kiq'orik reh i je' re'.</para>
  <para style="p">
    <verse number="11" style="v" />Re' i holohik laj na'ojb'al q'e' chihooj chi keh i k'achareel ayu' wach ak'al, jinaj kooch chi keh. <verse number="12" style="v" />Re' holohik laj na'ojb'al inkamanik chi toob'al reh i ju'jun, je' wo' hoq i tumiin. Xa re' la' re' wilik runa'ojb'al i ruko'leej riij i ruk'achariik.</para>
  <para style="p">
    <verse number="13" style="v" />Chakoj rehtaal i ruyejaam chaloq i Dios, ¿Mi wilik jino'q i neen ye'wik chi korik i yok yok noq xukanaa'? <verse number="14" style="v" />Nik' ma' xta reet wilkaat cha a'n rusuqkiil. Eh nik' ti' wilkaat xa chak'ulaa', cha kapaaj riij chi re' suq laj wihik, i ti' laj wihik re' wo' i Dios inye'wik reh. Re' ju'jun ma' reht'al taj i naa ruchaliik chinaah.</para>
  <para style="p">
    <verse number="15" style="v" />Re' i kiib' chi na'ojb'al wili wilom panuk'achariik xama' xta ruk'am chaloq: Re' chi re' taqe i korik wach kik'ux kikimik reje chi jumehq'iil, eh chi re' taqe i ma' holohik ta kina'ojb'al inajtb'ik rooq i kik'achariik.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Korik-oq wach ak'ux, xa re' la' ma' wik'saj naah.</para>
  <para style="q">Eh wilik-oq ana'ojb'al, xa re' la' maawik'saj naah,</para>
  <para style="q">¿Chib'ih neerutiq aweh chi xa nee nakansaj awiib'?</para>
  <para style="q">
    <verse number="17" style="v" />Mo'-oq i nik'ik naah i yiib' wach na'ojb'al i na a'n.</para>
  <para style="q">Eh maa wik'saj naah amemil.</para>
  <para style="q">¿Chib'ih neerutiq aweh chi nee tikimik noq komajaa' i rureq i ruq'ijil?</para>
  <para style="q">
    <verse number="18" style="v" />ma' xta reet chi neena a'n i wili,</para>
  <para style="q">eh ma' nee ta wo' inakanaa' rub'an i jinaj.</para>
  <para style="q">Awach i ruyohleej i Dios</para>
  <para style="q">naa reliik korik chuwach i naa rub'anam.</para>
  <para style="q">
    <verse number="19" style="v" />Re' holohik laj na'ojb'al i ruyeew rukowiil ruk'ux i wilik runa'ojb'al,</para>
  <para style="q">ma' xata je' rukab' i neen kiyeew i lajeeb' chi</para>
  <para style="q">ajaab'ees wilkeeb' chupaam i jino'q i tinamit.</para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" />Xti korik wo' hoq chi ma' xta jino'q i winaq xti korik wach ruk'ux, eh chi ma' ta nee rutz'a'j ruuk' i mahk chi jumpech.</para>
  <para style="p">
    <verse number="21" style="v" />Maa nimaj chu'nchel i neenkiq'or aweh i tinamit, reh chi ma' nee ta nab'iraj amoso wixuq'or i ma' holohik taj chawiij. <verse number="22" style="v" />Ruum re' hat xti aweht'al wo' hoq chi k'ihpech xaq'or i ma' holohik taj chi riij i tokoom.</para>
  <para style="p">
    <verse number="23" style="v" />Chu'nchel i wili xtohq'ik nusik'im chi riij ruuk' na'ojb'al, xa re' la' chik imb'anik reh xama' xta wo' nuna'ojb'al. <verse number="24" style="v" />Re' taqe wili xiik' nah k'ayewal chi reqarik chi riij, ma' awach ta neenreqwik chi riij.</para>
  <para style="p">
    <verse number="25" style="v" />Re' hin xnusik' chi riij chi naa nureqem i nuna'ojb'al reh chi naa nureqem chi riij i wili. Eh xwilow chi ma' holohik taj chi q'e' neenamin awiib' chub'aan inawaaj rub'aan, je' wo' rub'aan memil laj na'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Eh re' hin jinaj i q'e' ti' xnureq ma' xata je' ti'kiil noq ink'ularik kimik.</para>
  <para style="q">Re' ixoq ma' holohik ta runa'ojb'al noq i ruq'unej i winaq</para>
  <para style="q">korehtaal i nq'ehb'ik pan q'ab' i rukoj xirob' parub'eeh</para>
  <para style="q">xa re' i ruloq'ej i Dios neeruko'leej riib' pan q'ab',</para>
  <para style="q">eh re' i aj mahk neenq'ehb'ik pan q'ab'.</para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" />Noq xnusik' chi riij nik' wach noq wilkeeb' i chib'ih jariik. Re' hin i weht'al q'orik chi korik, xnureq chi riij taqe i na'ojb'al wili: <verse number="28" style="v" />Re' chi xakomajaa' wo' nureq i k'ahchi' nusik'im, chi kixilak i jinaj miil chi winaq jinaj ti holohik runa'ojb'al xnureq.</para>
  <para style="b" />
  <para style="q">Eh chi kixilak taqe i jinaj miil chi ixoq</para>
  <para style="q">ma' jino'q i holohik runa'ojb'al xnureq.</para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" />Re' hin re' wili i xwilow: Re' chi re' Dios xuyejaa' taqe winaq chi naa kianam i korik, xa re' la' re' chik i keh xkisik' i ma' holohik ta laj b'eeh.</para>
  <chapter number="8" style="c" />
  <para style="q">
    <verse number="1" style="v" />¿Mi wilik jino'q i je' rukab' i wilik runa'ojb'al?</para>
  <para style="q">¿Mi wilik chik jino'q i neench'obwik rub'ehel i chib'ih taqe jariik?</para>
  <para style="q">Eh re' reh re' runa'ojb'al inye'wik rusuqkiil ruk'ux</para>
  <para style="q">xan chalik chik ruse'eel i wach ruum.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin i nuq'or aweh chi chanimaj taqe i ruq'or i reey.</para>
  <para style="q">Eh cha nimaj wila' xuq'or aweh chi cha q'or i xti korik parub'ihnaal i Dios.</para>
  <para style="q">
    <verse number="3" style="v" />Eh mat elik chaloq pan ajiim b'eeh chuwach i reey,</para>
  <para style="q">matokik haa' chub'anariik i yiib' wach na'ojb'al</para>
  <para style="q">ruum re' reh neerub'an awuuk' aha' wilik iraaj.</para>
  <para style="q">
    <verse number="4" style="v" />Re' i ruq'oral i reey wilik rajaawriik,</para>
  <para style="q">eh ma' awach ta nee nq'orik reh chi ma' re' taj i rub'an.</para>
  <para style="q">
    <verse number="5" style="v" />Awach i rub'an inq'orarik reh ma' xtaj i ti' neeruk'ul.</para>
  <para style="q">Re' i wilik runa'ojb'al i rureq chi riij, reht'al jaruuj,</para>
  <para style="q">eh nik' wach runimjiik naa rub'anam.</para>
  <para style="q">
    <verse number="6" style="v" />Ruum wilik wo' ru orahiil chu'nchel chib'ih jariik iraaj b'anarik.</para>
  <para style="q">Xa re' la' re' ruk'axkiil i winaq,</para>
  <para style="q">
    <verse number="7" style="v" />re' chi ma' reht'al taj chib'ih jariik i naa ruchaliik chinaah.</para>
  <para style="q">Eh ma' awach ta nee nq'orik reh chib'ih i naa ruchaliik chinaah i ju'jun.</para>
  <para style="q">
    <verse number="8" style="v" />Ma' awach ta jino'q i wilik rajaawriik chinaah i k'achariik,</para>
  <para style="q">chi nee ta ruyeew nik'-oq najtiil.</para>
  <para style="q">Eh chi wilik ta rajaawriik chinaah kimik.</para>
  <para style="q">Re' yiib' wach runa'ojb'al ma' naa ta ruko'leem riib'</para>
  <para style="q">chuwach ruuk' taqe i rub'an.</para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" />Eh chu'nchel i wili xnukoj rehtaal i hin noq xnusik' chi riij chi korik chib'ih imb'aan ayu' wach ak'al. Wilik taqe i wilik kajaawriik xa re' la' inkikoj chi jot'b'al keh i kas kichaaq'.</para>
  <para style="s">Wilik taqe imb'aan xama' xta rub'ehel</para>
  <para style="p">
    <verse number="10" style="v" />Eh xwilow wo' hoq chi wilik i yiib' wach kina'ojb'al, inye'arik runimaal kiwach noq kimuhq'ik. Eh re' taqe i eliik wo' naq kiooj chupaam i rusantolaj paat i Dios, jumehq'iil xisahchik pank'uxliis chupaam i tinamit xkian wii' i korik. Re' taqe i re' xama' xta i ruk'am chaloq. <verse number="11" style="v" />Eh wila' ma' xiye'arik chutojariik i kimahk chi jumehq'iil taqe yiib' wach kina'ojb'al xasuq chik keh i tinamit xa re' chik i yiib' wach na'ojb'al inki a'n <verse number="12" style="v" />Eh atoob' ta re' aj mahk neerub'an jarpech-oq i mahk xa nee wo' k'acharik k'ih-oq haab'. Xa re' la' re' hin weht'al chi re' taqe inkiyeew ruloq'il, eh inkiyohleej wach i Dios holohik kielik. <verse number="13" style="v" />Re' taqe yiib' wach kina'ojb'al keh ma' holohik ta kielik xa je' nik'ik jinaj muuj i kik'achariik ruum ma' kiyeew ta ruloq'il i Dios.</para>
  <para style="p">
    <verse number="14" style="v" />Wilik taqe imb'aan wach ak'al ma' nureq ta chi riij. Ruum re' taqe i holohik kina'ojb'al inkik'ul i ti' je' ruk'ab' inkik'ul i yiib' wach kina'ojb'al. Eh re' taqe i yiib' wach kina'ojb'al suq kiwihik je' rukab' kiwihik holohik i kina'ojb'al. Re' taqe re' xama' xta ruk'am chaloq.</para>
  <para style="p">
    <verse number="15" style="v" />Re' hin i nuq'or chi re' winaq neerub'an chi nee rusik' rusuqkiil ruk'ux ayu'. Re' chi neerub'an ruwa' ruhaa', reh chi neen wihik rusuqkiil ruk'ux, eh neerub'an rusuqkiil i rukamaj chupaam i ruk'achariik wach ak'al inye'arik reh ruum i Dios.</para>
  <para style="p">
    <verse number="16" style="v" />Re' hin xnuyeew nuk'ux chusik'ariik i nuna'ojb'al nik' wach noq naa nureqem chi riij imb'aan wach ak'al. Ruum wilik taqe i chi q'iij chi aq'ab' inkikuy kiwiriik, ruum chib'ih inki a'n. <verse number="17" style="v" />Re' hin xwilow chi re' taqe i rukamaj i Dios ruch'ihil taqe imb'aan wach ak'al, ma' jaruuj nee rureq chi riij i winaq, atoob' ta nee ruchop i ruk'ux chusik'ariik. Atoob' ta re' i wilik runa'ojb'al nee ruq'or chi chu'nchel reht'al, xama' nee ta wo' rureq chi riij.</para>
  <chapter number="9" style="c" />
  <para style="s">Chiquncheel naaqakimiik</para>
  <para style="p">
    <verse number="1" style="v" />Re' hin xnuchop nuk'ux chusik'ariik chi riij nik' wach noq wilik taqe i wili: Eh xwilow chi re' inki a'n i holohik kina'ojb'al inki a'n i wilik kina'ojb'al pan q'ab' i Dios wilik. Ma' reht'al ta wo' hoq i winaq mi nk'axarik oon inixowjik wach atoob' ta k'ahchi' wo' naq rilom.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Eh eliik wach inkik'ul chi kunchelaal,</para>
  <para style="q">chi korik wach ruk'ux, chi ma' korik ta wach rik'ux,</para>
  <para style="q">chi saq wach i ránima, chi ma' saq ta wach i ránima.</para>
  <para style="q">Eh chi ruk'at i rumayiij, chi ma' ruk'at ta rumayiij,</para>
  <para style="q">chi ma' re' ta aj mahk, chi aj mahk,</para>
  <para style="q">chi ruq'or i b'ih i Dios noq i ruq'or i korik,</para>
  <para style="q">chi ma' ruq'or taj i b'ih i Dios ruuk' inkiq'or.</para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" />Re' i wili i ma' holohik taj imb'aan wach ak'al chi eliik wach inkik'ul chikuncheel. Eh re' i kikapeew taqe i winaq nujinaq chi yiib' wach na'ojb'al, reh i teh wachiil injot'wik keh nik' najtiil i kik'achariik ayu', eh noq inooj kuxoq naah kamnaq kiooj q'ehb'oq.</para>
  <para style="p">
    <verse number="4" style="v" />Eh re' i koneenkahnik chi k'achlik ko wilik neeruch'ikaa' wii' ruk'ux. Ruum ko wilik neen kamanik wii' i tz'i' kok'achlik, chuwach jino'q i kaq b'ahlam kamnaq chik.</para>
  <para style="p">
    <verse number="5" style="v" />Re' taqe i k'achalkeeb' keht'al chi naakikimiik. Eh re' taqe kamnaq ma' xta chik i keht'al, ma' xta chik i kitojb'aal naakik'ulum ruum xisahchik chik pank'uxliis. <verse number="6" style="v" />Ar wo' sahchik wach i k'axooj, ixowaal, kaqwachiil, inki a'n Eh ma' jaruuj chik naa kianam keh imb'aan ayu' chinaah i wach ak'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Eh cha a'n awa' chi suq ak'ux</para>
  <para style="q">chawuk'ej i riis i uuva chi suq awánima.</para>
  <para style="q">Re' holohik cha a'n reh chi neemponik chuwach i Dios.</para>
  <para style="q">
    <verse number="8" style="v" />Eliik-oq saq aso' chakoj chawiij,</para>
  <para style="q">elik wo' chakoj ink'ohnik laj iq'oom wach anaah.</para>
  <para style="q">
    <verse number="9" style="v" />Cha a'n rusuqkiil ak'achariik</para>
  <para style="q">ruuk' awehk'een q'e' nak'ax,</para>
  <para style="q">cha a'n rusuqkiil aak'achariik xa ik'ik reh</para>
  <para style="q">chinaah i wach ak'al wili xama' xta ruk'am chaloq,</para>
  <para style="q">ruum xa re' wo' re' i suq i ruk'am cha weh</para>
  <para style="q">i kowlaj kamanik i na a'n chinaah i wach ak'al wili.</para>
  <para style="q">
    <verse number="10" style="v" />Chu'nchel i neeruyee riib', i nee nakuy rub'aan, cha a'n.</para>
  <para style="q">Ruum noq wilkaat chik panjul i ojik i na a'n wii',</para>
  <para style="q">ma' xta chik i kamanik, ma' xta chik naa rukapeb'jiik,</para>
  <para style="q">eh ma' xta chik i na'ojb'al naa rub'aan.</para>
  <para style="q">
    <verse number="11" style="v" />Re' hin jinaj wo' chik i xwilow wach ak'al.</para>
  <para style="q">Re' chi ma' re' taj i kow kiajiminik kielik korik.</para>
  <para style="q">Eh ma' re' taj i kow kiib' i kielik korik ruuk' i peleto.</para>
  <para style="q">Ma' re' taj i wilik kina'ojb'al wilik kiwa' kihaa'.</para>
  <para style="q">Eh ma' xta kib'ehomal i wilik kina'ojb'al,</para>
  <para style="q">ni xata re' taqe i tijimaj suq kik'ulariik imb'aan,</para>
  <para style="q">ma' keht'al taj jaruuj inchalik i ti' k'axik chikinaah.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Ruum re' taqe i winaq ma' keht'al taj jaruuj inkik'ul i ti',</para>
  <para style="b" />
  <para style="q">je' rukab' inkik'ul i kar ma' keht'al taj noq kichopariik panya'al.</para>
  <para style="q">Eh je' rukab' inkik'ul i tz'ikin noq kichoparik pan xirob'.</para>
  <para style="q">Je' wo' re' inkik'ul i winaq ma' k'ahchi' ta kikapaam</para>
  <para style="q">noq ink'uloq i ti' k'axik chikinaah.</para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" />Re' hin jinaj wo' chik i na'ojb'al nim wach xwilow, wilik i ruk'uhtaaj qeh re' wili: <verse number="14" style="v" />Jinaj i k'isa tinamit xama' k'ih ta taqe i patineel chupaam, eh neenchalik pletojoq ruum jino'q i reey neerukotej riij ruuk' i ma' k'isa tz'a'amb'al reh q'aq'inik. <verse number="15" style="v" />Eh chupaam k'isa tinamit re' re' patim jinaj i winaq k'isa neb'aa', xa re' la' wilik runa'ojb'al. Ruuk' i runa'ojb'al i ruko'leej i tinamit, xanaah re' ma' awach ta nkapeb'inik reh. <verse number="16" style="v" />Re' hin je' wili i xnuq'or panuk'ux: Q'e' ma' xta reet chi wilik na'ojb'al chuwach i kow i rub'an riib'. Atoob' ta re' i runa'ojb'al i neb'aa' ma' ajwaal ta wach, eh ma' i nib'irjik taj chib'ih i ruq'or.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Re' i ruq'oral i wilik runa'ojb'al atoob' ta q'uun i ruq'or i nib'irjik</para>
  <para style="q">chuwach noq i ruk'er chii' jino'q i reey chi kiq'orob'jiik i ma' kinimanik taj.</para>
  <para style="q">
    <verse number="18" style="v" />Eh q'e' chihooj i wilik runa'ojb'al chuwach i tz'a'amb'al reh q'aq'inik.</para>
  <para style="q">Xa re' la' re' jinaj chi aj mahk neerusach wach chu'nchel i holohik.</para>
  <chapter number="10" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' taqe i kamnaq nimaq utz' neeruchuhb'isaj</para>
  <para style="q">i jinaj lemeta chi nk'ohnik laj iq'oom</para>
  <para style="q">Je' wo' re' i memil laj na'ojb'al imb'aan chi jumehq'iil</para>
  <para style="q">nee ruyoj wach i holohik laj na'ojb'al looq' chi ib'irjik.</para>
  <para style="q">
    <verse number="2" style="v" />Re' i holohik runa'ojb'al xa re' i holohik i rukapaaj rub'aan.</para>
  <para style="q">Eh re' i ma' nimanik taj xa re' yiib' wach i rukapaaj rub'aan.</para>
  <para style="q">
    <verse number="3" style="v" />Re' i ma' nimanik taj, i ruk'uhtaaj chi ma' xta runa'ojb'al</para>
  <para style="q">ruuk' chu'nchel i rukapaaj,</para>
  <para style="q">atoob' ta ruq'or chi re' taqe i tokoom ma' kinimanik taj.</para>
  <para style="q">
    <verse number="4" style="v" />Eh re' hat wila' xkaqrik i reey awuuk'</para>
  <para style="q">maa chaq'weej xa cha kuy.</para>
  <para style="q">Ruum ruuk' q'unil neena yejaa' i nimlaj aak'axkiil ruuk'.</para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" />Re' hin jinaj wo' chik i ma' holohik taj xwilow imb'aan chinaah i wach ak'al. Re' i reey imb'anik reh re' wili: <verse number="6" style="v" />Re' chik i ma' kinimanik taj ruyeew chupaam i nim wach kamanik. Eh re' i nimaq kiwach chupaam i ma' nimaq ta wach kamanik taqe ruyeew. <verse number="7" style="v" />Eh wilik wo' pech inwilow chi re' taqe i minooj pankowlaj kamanik riij kawáyu kib'ehik. Eh re' taqe i reey chi kooq kib'ehik, je' taqe xa moso.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Awach ink'otwik reh i jul xa re' wo' reh inq'ehb'ik chupaam.</para>
  <para style="q">Eh awach impaxinik reh i tz'aq</para>
  <para style="q">ink'uxarik ruum i aaq'.</para>
  <para style="q">
    <verse number="9" style="v" />Awach impaxinik reh ab'aj i ruq'oj riib' ruuk'.</para>
  <para style="q">Awach impaxinik reh i sii' panyohb'aal wilik ruum nee-oq i ruyok' riib'.</para>
  <para style="q">
    <verse number="10" style="v" />Eh wila' xik'ik i ruq'asiil ikej,</para>
  <para style="q">eh wila' ma' xjuk'arik chik</para>
  <para style="q">q'e' chik ansil iraaj noq inkojarik.</para>
  <para style="q">Ma' xta reet chi noq neensik'arik na'ojb'al reh chib'ih i naa rub'aan.</para>
  <para style="q">
    <verse number="11" style="v" />Re' i reht'al ruq'unjik wach i aaq' xama' xta neerutiq</para>
  <para style="q">reh wila' xti'arik ruum i aaq' noq komajaa' ruq'unej wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' ruq'oral i holohik runa'ojb'al holohik ink'amarik cho chinaah ruum.</para>
  <para style="q">Eh re' i ruq'oral i ma' nimanik taj ti k'axik inchalik chinaah ruum.</para>
  <para style="q">
    <verse number="13" style="v" />Re' reh i rutoqaa' ruq'orariik i memil laj q'orik,</para>
  <para style="q">eh noq inooj kuxoq xiik' chik naah yib'kiil wach taqe i ruq'or.</para>
  <para style="q">
    <verse number="14" style="v" />Re' i ma' nimanik taj ma' k'isiin ta imponik chuwach i q'orik,</para>
  <para style="q">xa re' la' xama' reht'al ta wo' hoq</para>
  <para style="q">chib'ih i naa ruk'ulariik na' chub'an.</para>
  <para style="q">
    <verse number="15" style="v" />Re' taqe i ma' kinimanik taj inkikansaj kiib' chi kamanik,</para>
  <para style="q">eh ma' keht'al taj aha' ojik inki a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Eh q'e' ketel wach i tinamit ko k'isa k'un rukojom chi ru reey.</para>
  <para style="q">Re' taqe i k'amal kib'eeh ki-ik'ik aq'ab' pantaq ninq'ijinik.</para>
  <para style="q">
    <verse number="17" style="v" />Eh atoob' reh i tinamit i rukoj chi ru reey i wilik ruloq'il.</para>
  <para style="q">Re' taqe i k'amal kib'eeh paru orahiil inki a'n kiwa' kihaa'</para>
  <para style="q">reh chi neen k'ulik i kaansil,</para>
  <para style="q">ma' re' ta xohk'rik inkikapaaj.</para>
  <para style="q">
    <verse number="18" style="v" />Re' i sikiil laj winaq ma' rutz'ap taj i kojweel reh i rupaat</para>
  <para style="q">ruum i re' inq'ahik taqe i ruche'el, eh inq'ehb'ik chinaah noq inooj kuxoq.</para>
  <para style="q">
    <verse number="19" style="v" />Eh re' i ninq'ijinik i ruyeew rusuqkiil k'uxliis</para>
  <para style="q">re' i ruuk'jiik i riis uuva i ruyeew rusuqkiil k'uxliis.</para>
  <para style="q">Eh ruuk' tumiin kiloq'arik.</para>
  <para style="q">
    <verse number="20" style="v" />Re' hat maa b'aj i reey ni xata naq panawánima neenab'aj.</para>
  <para style="q">Maa q'or wo' hoq i ma' holohik ta laj q'orik chi riij i b'ehoom</para>
  <para style="q">ni xata re' noq wilkaat cha wutkeel.</para>
  <para style="q">Ruum wilik taqe i je' kikab' i kok' tz'ikin nenooj kiq'or reh.</para>
  <chapter number="11" style="c" />
  <para style="q">
    <verse number="1" style="v" />Maa pixpuuj wach i chib'ih aweh,</para>
  <para style="q">wilik la' i chasiij neenak'ul jilow pan jinaj q'iij.</para>
  <para style="q">
    <verse number="2" style="v" />Eliik chawunej taqe i chib'ih aweh i tokoom,</para>
  <para style="q">ruum ma' aweht'al taj chib'ih i ti' k'axik naa ruchaliik chinaah aatinamiit.</para>
  <para style="q">
    <verse number="3" style="v" />Eh re' i suutz' noq i ruk'am chaloq i jab'</para>
  <para style="q">chinaah i wach ak'al i ruyeew chaloq.</para>
  <para style="q">Re' k'acharik xa je' rukab' i chee' inq'ehb'ik pansak'aaj,</para>
  <para style="q">inq'ehb'ik pantz'eet reh i rookb'aal q'iij xa ar kahnik.</para>
  <para style="q">
    <verse number="4" style="v" />Eh awach i rilow chi xk'uloq i teew ma' rub'an taj i tik.</para>
  <para style="q">Awach i rilow chi xk'uloq i suutz' ma' rumol taj wach i rutik.</para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" />Nik' wach noq ma' aweht'al taj i rub'an i teew, ma' aweht'al taj nik' wach noq i rutoq'aa' cho tz'uk'rik i ha'lak'uun ruuk' i rutuut. Je' wo' re' noq ma' aweht'al taj chib'ih taqe jariik i rub'an i Dios xtz'uhkrisanik chu'nchel i chib'ih i wilik.</para>
  <para style="p">
    <verse number="6" style="v" />Re' hat cha tik awijaa' wahq'eq, eh nee wo' chik i naa tik xq'eq, ruum ma' aweht'al taj aha' wilik i nee nelik korik mi re' i neena tik peet oon re' i neenatik koq'uun oon nee wo' nelik korik chu'nchel.</para>
  <para style="p">
    <verse number="7" style="v" />Korik wo' hoq chi q'e' holohik i k'acharik ayu' wach ak'al, eh q'e' holohik rilariik i q'iij saqum. <verse number="8" style="v" />Xa re' la' chik, atoob' ta re' i winaq neenk'acharik k'ih-oq haab', eh neerub'an rusuqkiil chu'nchel i chib'ih jariik, inchol runab'eem chi re' noq naa rub'aan kimik xama' xta ruk'am chaloq.</para>
  <para style="s">Rukojariik kina'ojb'al i k'ijool, i q'ahxoq</para>
  <para style="p">
    <verse number="9" style="v" />K'ijool, neerub'an chi nee nach'ikaa' ak'ux panak'achariik ruuk' taqe i chib'ih inak'ax wach pan ak'ijolal. Eh re' q'oreel xa chib'ih paruq'or ak'ux i hat, eh chib'ih inak'ax wach rub'aan. Xa re' la' chanab'eej chi ruum taqe i naa a'nam re' re', naa ruq'atam q'orik cha naah i Dios. <verse number="10" style="v" />Je' re' noq chawisaj panawánima ik'aah, je' wo' rukapeb'jiik i xa chib'ih jariik, maayeew chi ti' k'axik ati'jolal ruum re' i k'ijolal xama' naj taj, eh xama' xta ruk'am chaloq.</para>
  <chapter number="12" style="c" />
  <para style="q">
    <verse number="1" style="v" />Noq kowilkaat parusuqkiil ak'ijolal,</para>
  <para style="q">k'oloq panak'ux aaDios xtz'uhkrisanik cha weh,</para>
  <para style="q">noq komajaa' inchalik i ti' k'axik cha naah,</para>
  <para style="q">noq komajaa' imponik i haab' noq neenaq'or chi je' wili:</para>
  <para style="q">Ma' xta rusuqkiil i nuk'achariik, tiko'q.</para>
  <para style="q">
    <verse number="2" style="v" />K'oloq panak'ux aaDios noq konawil i rusaqumaal i q'iij</para>
  <para style="q">i rusaqumaal i poh, i rusaqumaal i ch'umiil,</para>
  <para style="q">noq komajaa' ink'uloq i suutz' ink'amwik cho reh i jab'.</para>
  <para style="q">
    <verse number="3" style="v" />Eh naa ruponiik i q'iij chi re' taqe aq'ab' inko'linik aweh xakib'arb'otik chik,</para>
  <para style="q">eh naa rulokom riib' taqe i panawaa' i q'e' naq kow kiib'.</para>
  <para style="q">Re' aweeh inkamanik chi k'ookb'al wach i wi'k xakiib' ixib' chik i naa rukahniik.</para>
  <para style="q">Re' taqe naq'awach i naa rumooyriik paam.</para>
  <para style="q">
    <verse number="4" style="v" />Re' taqe i axikin</para>
  <para style="q">ma' naa ta chik rib'iram i choq'ik naa rub'anam i keeb'al,</para>
  <para style="q">ma' naa ta chik ab'iram noq naakitz'uyiniik i kok' chikop pantaq wahq'eq.</para>
  <para style="q">Eh ma' naa ta chik ab'iram i kitz'uuy taqe i aj tz'uuy.</para>
  <para style="q">
    <verse number="5" style="v" />Eh naa chik ayo'jiik ruum i johtik yuuq',</para>
  <para style="q">xa yo'jik chik ruuk' i b'ehik naa a'nam</para>
  <para style="q">re' rismaal anaah naa rusaaqb'iik,</para>
  <para style="q">re' i xama' ahl ta wo' naq ma' naa ta chik akuyum, xama' xta chik i naa awaajwaam.</para>
  <para style="q">Ruum xailook' chik tiooj panjul chi jumpech,</para>
  <para style="q">re' i naa rutib'iik kik'ux chawiij</para>
  <para style="q">naa rib'irjiik i koqiim pantaq b'eeh.</para>
  <para style="q">
    <verse number="6" style="v" />K'oloq panak'ux aaDios, noq komajaa' inak'ul aweh je' rukab' noq ink'up i karena plata,</para>
  <para style="q">je' rukab' noq impaxik i xun re' ruuk' i oro,</para>
  <para style="q">je' rukab' noq impaxik ikom chii' ha',</para>
  <para style="q">eh noq kosuq ak'ux.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' aati'jolal naa wo' chik rusutiniik chi pooq ak'al re' xkorjik cho wii'.</para>
  <para style="q">Re' aawuxlaab'al naa wo' chik rusutiniik ruuk' i Dios re' xye'wik cho reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' hin i kinq'orik i k'uhb'aal,</para>
  <para style="q">i nuq'or chi chu'nchel imb'aan, inq'orarik wach ak'al, xama' xta ruk'am chaloq.</para>
  <para style="s">Re' ruq'orariik chib'ih i rub'an i winaq</para>
  <para style="p">
    <verse number="9" style="v" />Noq re' hin xnureq nuna'ojb'al chi korik q'e' chik xnukoj kina'ojb'al i tinamit xinkib'iraj, eh xnusik' chi riij i na'ojb'al. Eh ma' k'isiin taqe i jalwaach q'orik xnuyejaa' wach. <verse number="10" style="v" />Eh xnusik' chi riij i q'orik i ruk'ul chi q'orarik. Xnusik' chi riij nik' wach rutz'ihb'jiik naa nub'anam i ju'jun chi q'orik, chi re' ruq'orariik naa nub'anam.</para>
  <para style="p">
    <verse number="11" style="v" />Re' kiq'oral i holohik kina'ojb'al je' rukab' noq neench'aplojik i q'as ju' ch'ihch', oon je' rukab' noq inch'aplojik i kalawux i na'ojb'al inkiyeew i kiib' chi aj tijoom, i ruq'or i k'amal b'eeh. <verse number="12" style="v" />Hat wak'uun noq wilkaat chab'iraj i naa nuq'orom aweh re' rutz'ihb'jiik i ma' k'isa huuj ruch'ihil i ma' k'isa tijinik ma' xta ruk'am chaloq xa ruq'uhtiik i ti'jolal i ruyeew.</para>
  <para style="p">
    <verse number="13" style="v" />Yu'naak kuxik chik rib'irjiik i ruq'or i huuj wili. Re' naa a'nam i hat, re' chi naa ayohleem wach i Dios chi naa animam taqe i ruk'uhb'aal ruum re' re' ruk'ul chi na a'nam. <verse number="14" style="v" />Ruum re' i Dios naa ruq'atam i q'orik chi qanaah ruuk' i chib'ih ixqa a'n, i xqaq'or atoob' ta holohik, atoob' ta ma' holohik, eh atoob' ta xa chi ma' eht'alimaj xqa a'n.</para>
</usx>