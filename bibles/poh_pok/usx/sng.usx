<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="SNG" style="id">SNGPOK.SFK 09-05-2,008. Adelina Quej. Pocomchi. Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">CANTARES</para>
  <para style="toc3">Can</para>
  <para style="toc2">Can</para>
  <para style="toc1">CANTARES</para>
  <para style="mt2">RE' I RUHUUJ I CANTAR DE LOS CANTARES</para>
  <para style="mt1">CANTARES</para>
  <chapter number="1" style="c" />
  <para style="s">Re' loq'laj tz'uuy xutz'ihb'aaj i reey Salomón</para>
  <para style="q">
    <verse number="1" style="v" />Re' iloq laj tz'uuy wili xub'an i Salomón.</para>
  <para style="s">Re' peet tz'uuy</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="2" style="v" />Kina tz'ub' ruuk' aachii'</para>
  <para style="q">ruum re' i nuk'axariik neena a'n xiik' naah ki'iil chuwach i riis uuva.</para>
  <para style="q">
    <verse number="3" style="v" />Re' hat xa je' chik ink'ohnik laj iq'oom aawach.</para>
  <para style="q">Eh re' ab'ihnaal xa je' chik ink'ohnik laj iq'oom</para>
  <para style="q">ruum aj re' q'e' kich'ilojik chawiij taqe i q'ahxoq.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Kinak'am chawiij chi jumehq'iil.</para>
  <para style="q">Kinak'am panapaat i hat reey.</para>
  <para style="sp">PARUK'IHAAL</para>
  <para style="q">Re' hoj neenqa a'n i rusuqkiil, neensuuqb'ik qak'ux awuuk',</para>
  <para style="q">neen k'ulik panqak'ux i k'axooj i na a'n xa je' chik ki'iil riis uuva,</para>
  <para style="q">ruum i re' i q'e' kich'ilojik chawiij i q'ahxoq.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="5" style="v" />Re' hin, hin ixoq aj Jerusaleem, q'eq i nuti'jolal,</para>
  <para style="q">q'e' hin holohik, je' nuq'eqiil itz'ihy naa paat wilik Sedar.</para>
  <para style="q">Eh je' nu holwochiil itz'ihy wilik parupaat Salomón.</para>
  <para style="q">
    <verse number="6" style="v" />Maa koj taq rehtaal i nuti'jolal,</para>
  <para style="q">eh chi re' q'iij xk'atwik reh.</para>
  <para style="q">Re' taqe i was nuch'aaq xchalik kik'aah wuuk'.</para>
  <para style="q">Eh xinkikoj naq chi rucha'jaljiik taqe i uuva tikooj,</para>
  <para style="q">eh re' i nu uuva i hin ma' xnub'an ta rucha'jaljiik.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Hat winaq, re' hin q'e' ti nuk'ax, aweeh i nuk'achariik.</para>
  <para style="q">Chaq'or weh, ¿aha' taqe nab'esaj</para>
  <para style="q">nayeew chi hi'lik aachikoop kab'lajora i q'iij?</para>
  <para style="q">¿Chib'ih reet noq k'ul kinooj chasik'ariik</para>
  <para style="q">chi kixilak i aj cha'jen tentzun kuuk' taqe awuch'ihil?</para>
  <para style="sp">PARUK'IHAAL</para>
  <para style="q">
    <verse number="8" style="v" />Hat ixoq q'e' hat holohik, wila' ma' aweht'al</para>
  <para style="q">cha tahqeej i kooqb'aal i nutentzuun</para>
  <para style="q">hiy chab'esaj aakapraax</para>
  <para style="q">ma' najt ta ruuk' i kikok' paat i cha'jen tentzun.</para>
  <para style="sp">RE' B'AHIILB'EES</para>
  <para style="q">
    <verse number="9" style="v" />Re' i hat ixoq q'e' ti nuk'ax chi weh,</para>
  <para style="q">je' akab' i holohik laj kawáyu i nqerinik reh i rukareta i kireey i aj Egipto.</para>
  <para style="q">
    <verse number="10" style="v" />Q'e' holohik awach chupaam taqe i ka'xikin,</para>
  <para style="q">eh q'e' holohik ti k'utinik noq leklik chawalaq aakarena re' ruuk' perla.</para>
  <para style="q">
    <verse number="11" style="v" />Naaqayejaam aaka'xikin re' ruuk' i xti manlik oro,</para>
  <para style="q">eh neenqayeew aholwochiil ruuk' i plata.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="12" style="v" />Noq re' i reey tzunlik nah mexa, xnujik paam i ruye'aab' chi</para>
  <para style="q">nuk'ohonkiil, xa je' chik k'ohonkiil iq'oom Nardo.</para>
  <para style="q">
    <verse number="13" style="v" />Re' winaq q'e' nuk'ax xa je' chik k'ohonkiil i jinaj chi k'isa alb'oxox chi mirra</para>
  <para style="q">i nuyeew chi xilak i nuch'uuch'.</para>
  <para style="q">
    <verse number="14" style="v" />Re' winaq q'e' nuk'ax, xa je' chik k'ohonkiil i jumb'ohr chi uhtz'ub'</para>
  <para style="q">i nelik i wilik wii' i uuva ar En-gadi.</para>
  <para style="sp">RE' B'AHIILB'EES</para>
  <para style="q">
    <verse number="15" style="v" />Re' hat ixoq q'e' hat holohik q'e' nuk'ax awach,</para>
  <para style="q">xti korik chi q'e' hat holohik</para>
  <para style="q">re' kab'chel i naq'awach je' rukab' i kiib' chi paloma.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="16" style="v" />Re' hat xti xiik' naah aholwochiil</para>
  <para style="q">q'e' nuk'ax awach chi weh.</para>
  <para style="sp">RE' B'AHIILB'EES</para>
  <para style="q">Eh rax wach i kok' ch'ahn naa qayohkiik wii'.</para>
  <para style="q">
    <verse number="17" style="v" />Re' i holohaq chee' chakaltee' i rib'ojal i qapaat,</para>
  <para style="q">eh re' ruuk' taqe i holohaq sohchaj i ruche'el i naah i qapaat.</para>
  <chapter number="2" style="c" />
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin je' nuholwochiil i rosa tikooj ar Sarón</para>
  <para style="q">je' nuholwochiil i saq uhtz'ub' wilik wach k'ixkaab'.</para>
  <para style="sp">RE' B'AHIILB'EES</para>
  <para style="q">
    <verse number="2" style="v" />Re' ixoq q'e' nuk'ax wach, q'e' holohik chi kixilak, q'ahxoq,</para>
  <para style="q">xa je' chik holwochiil i saq uhtz'ub' i chi kixilak i k'iix.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="3" style="v" />Re' i winaq q'e' nuk'ax wach</para>
  <para style="q">q'e' holohik chi kixilak i k'ijool, xa je' chik</para>
  <para style="q">holwochiil i mansano chi kixilak i chee'.</para>
  <para style="q">Xa suq chik i hi'lik chi ri'sil i rumuuj,</para>
  <para style="q">eh ma' k'isiin ta ki'iil i ruwachuj.</para>
  <para style="q">
    <verse number="4" style="v" />Eh xiruk'am reje chupaam i paat k'ahchi' wii' i ninq'iij,</para>
  <para style="q">re' i nutz'ehtjiik i rub'an ink'utinik chi k'axb'al weh.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Chayeew rukowiil nuk'ux ruuk' i chiq uuva.</para>
  <para style="q">Eh kinak'uxlaaj ruuk' i mansano</para>
  <para style="q">ruum xakimik chik weh reh i ruk'axariik awach.</para>
  <para style="q">
    <verse number="6" style="v" />Eh nee ta rukoj chee rutz'eet q'ab' riij walaq,</para>
  <para style="q">ruuk' ta naq i rusak'aaj q'ab' nee kiruq'ahcheej.</para>
  <para style="sp">RE' B'AHIILB'EES</para>
  <para style="q">
    <verse number="7" style="v" />Re' taq i hat ixoq aj Jerusaleem pankib'ihnaal ixoq keej,</para>
  <para style="q">i kok' ixoq keej wilkeeb' pantaq ch'ahn,</para>
  <para style="q">i nuq'or taq aweh chi maa wuksaj taq i koq paruwiriik ixoq q'e' nuk'ax</para>
  <para style="q">konik' pa' neenwuktik paruk'ux i reh.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="8" style="v" />Re' i winaq q'e' nuk'ax wach chi weh, xb'iraj chik i ruq'oral,</para>
  <para style="q">xan pisk'anik chik xk'uloq chinaah i ch'ahn</para>
  <para style="q">chinaah taqe i rub'ohl i yuuq'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' i winaq q'e' nuk'ax wach</para>
  <para style="q">xa je' chik ink'uloq nimlaj keej</para>
  <para style="q">oon k'isa keej k'ulik chik iloq wach paat</para>
  <para style="q">xuk'uhtaaj chik riib' pan ventana</para>
  <para style="q">tz'eht chik i rub'an cho pampaat.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' winaq q'e' nuk'ax wach je' wili i xuq'or weh:</para>
  <para style="q">Wukteen ixoq hat weh q'e' ti nuk'ax,</para>
  <para style="q">taq reje k'een.</para>
  <para style="q">
    <verse number="11" style="v" />Ruum re' i ruq'ijil i jab' xik'ik chik</para>
  <para style="q">ma' naa ta chik rub'anam i jab'.</para>
  <para style="q">
    <verse number="12" style="v" />Eh xipoq' chik chaloq i uhtz'ub' chinaah i wach ak'al,</para>
  <para style="q">xponik chik i ruq'ijil chi naa rub'aan i tz'uuy.</para>
  <para style="q">X-ib'irjik chik pan qa ye'aab' i kitz'uuy kok' mukur.</para>
  <para style="q">
    <verse number="13" style="v" />Re' higo xwachinik chik,</para>
  <para style="q">eh re' i wach i uuva xank'ohnik chik i ruxlaab'.</para>
  <para style="b" />
  <para style="q">Re' hat ixoq q'e' hat holohik</para>
  <para style="q">q'e' ti nuk'ax chi weh kim wuuk'.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hat xa je' chik aholwochiil i paloma</para>
  <para style="q">wilik rusuuq i rukeb'aa' riib' paruhopil i ab'aj.</para>
  <para style="q">Re' hin inwaaj chi eliik neenak'uhtaaj weh awach,</para>
  <para style="q">inwaaj chi nee kinaq'oreej,</para>
  <para style="q">ruum q'e' suq i rub'an weh aq'oral, ruum q'e' hat holohik, inki.</para>
  <para style="sp">RE' B'AHIILB'EES, RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="15" style="v" />Chakansaj taq i nimaq yaak</para>
  <para style="q">i kok' yaak i njot'wik qeh qakab'cheel</para>
  <para style="q">je' rukab' noq inkisach wach i uuva,</para>
  <para style="q">noq wachinik, noq ixmak'inik i rub'an.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="16" style="v" />Re' winaq q'e' nuk'ax wach, re' reh inehchanik weh i hin.</para>
  <para style="q">Eh i rub'esaj taqe i rutentzuun xilak taqe saq uhtz'ub'.</para>
  <para style="q">
    <verse number="17" style="v" />Noq ik'ik chik i rub'an aq'ab', noq okik chik i rub'an chee saqum</para>
  <para style="q">neerub'an chi nee ti chalik wuuk' i hat b'ahiil q'e' ti nuk'ax,</para>
  <para style="q">je'-oq ti chalik nimlaj keej, k'isa keej</para>
  <para style="q">kielik chaloq chinaah i yuuq' Beter.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' xrilow paruwiriik i ehk'eenb'ees</para>
  <para style="q">
    <verse number="1" style="v" />Noq wirik i nub'an panuyokaab' xnusik' i winaq,</para>
  <para style="q">q'e' i nuk'ax pan wánima xnusik',</para>
  <para style="q">xa re' la' xama' xnureq ta wo' hoq.</para>
  <para style="q">
    <verse number="2" style="v" />Eh je' wili i xnuq'or:</para>
  <para style="q">Re' hin naa rojiik nusik'im chi junsuut i tinamit</para>
  <para style="q">pantaq b'eeh i winaq q'e' i nuk'ax pan wánima, kinki.</para>
  <para style="q">Eh xinooj wo' chusik'ariik,</para>
  <para style="q">xa re' la' xama' xnureq ta wo' hoq.</para>
  <para style="q">
    <verse number="3" style="v" />Eh xinkireq i kicha'jinik reh i tinamit,</para>
  <para style="q">je' wili i xnuq'or keh: ¿Mi xawilow taq wach</para>
  <para style="q">weh i q'e' i nuk'ax pan wánima? kinki keh.</para>
  <para style="q">
    <verse number="4" style="v" />Xa kore' wo' junk'aam wik'sam taqe i re'</para>
  <para style="q">noq xponik nureq i q'e' i nuk'ax pan wánima.</para>
  <para style="q">Eh nuchop reje chi q'ab' ma' kota chik woq'taaj</para>
  <para style="q">korehtaal xnuk'am</para>
  <para style="q">i koq parupaat i nutuut re' i xin-aasjik wii'.</para>
  <para style="sp">RE' B'AHIILB'EES</para>
  <para style="q">
    <verse number="5" style="v" />Hat taq ixoq aj Jerusaleem</para>
  <para style="q">pankib'ihnaal ixoq keej, i kok' ixoq keej wilkeeb' pantaq ch'ahn,</para>
  <para style="q">inuq'or taq aweh chi ma' jot' taq i koq paruwiriik ixoq q'e' i nuk'ax,</para>
  <para style="q">konik' pa' neenwuktik paruk'ux i reh.</para>
  <para style="s">Re' i roox tz'uuy</para>
  <para style="sp">PARUK'IHAAL</para>
  <para style="q">
    <verse number="6" style="v" />¿Awach injohtik i chaloq chupaam i ye'aab' chiq yuuq'</para>
  <para style="q">chalik i rub'an wuuk' xa je' chik rukab' i sib'</para>
  <para style="q">xan je' chik k'ohonkiil i mirra,</para>
  <para style="q">i insensia, i pooq iq'oom?</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' reey Salomón xk'ulik iloq</para>
  <para style="q">tzunlik chupaam i ruxoyimaj paam kareta</para>
  <para style="q">oxk'ahl chi winaq kow kiib' chi kixilak i aj Israel incha'jinik reh.</para>
  <para style="q">
    <verse number="8" style="v" />Chu'nchel i re' kitijem kiib' chi q'aq'inik,</para>
  <para style="q">wilik kiq'aslaj ch'ihch' nah kituuq,</para>
  <para style="q">ko'lb'al reh i reey ruum yohb'aal i b'ehik chaq'ab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' i reey Salomón xuyejaa' jinaj i ruxoyimaj paam kareta</para>
  <para style="q">re' ruuk' i chee' inchalik Líbano ruyej-aal.</para>
  <para style="q">
    <verse number="10" style="v" />Re' taqe i rutz'u'kaal re' ruuk' i plata,</para>
  <para style="q">re' ye'aab' reh i riij re' ruuk' i oro,</para>
  <para style="q">re' i tzunaab' i kaq itz'ihy i b'urb'al wach,</para>
  <para style="q">re' i paam ruuk' k'axooj xkixoyej</para>
  <para style="q">taqe i holohaq ixoq aj Jerusaleem.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Eleen taq chaloq i hat ixoq aj Sión chawil taq xk'uloq i reey Salomón,</para>
  <para style="q">wilik ru corona kojooj cho reh ruum i rutuut</para>
  <para style="q">noq xub'an kaxáro</para>
  <para style="q">chupaam i q'iij noq xwihik rusuqkiil i ránima.</para>
  <chapter number="4" style="c" />
  <para style="s">Re' b'ahiilb'ees i ruyeew ruloq'il i ehk'eenb'ees</para>
  <para style="sp">RE' B'AHIILB'EES</para>
  <para style="q">
    <verse number="1" style="v" />Re' hat ixoq q'e' tinukax chi weh</para>
  <para style="q">xiik' naah aholwochiil,</para>
  <para style="q">xti hat holohik.</para>
  <para style="q">Re' taqe i naq'awach, je' rukab' inaq'wach paloma chupaam i b'urb'al awach,</para>
  <para style="q">eh xa q'eq b'utz'ik chik i rismaal anaah, xa je' chik rukab' i</para>
  <para style="q">kiij i kaprax kiqajik cho wach yuuq' Galaad.</para>
  <para style="q">
    <verse number="2" style="v" />Re' taqe aweeh xasaq chik, xa je' chik saq'iil i kiij i tentzun</para>
  <para style="q">kore' xkian kitiin panha',</para>
  <para style="q">kore' xyok'arik i rismaal kiij.</para>
  <para style="q">Eh laach i kiha'lak'uun, inwihik, ma' jino'q keh i ma' nak'unanik taj.</para>
  <para style="q">
    <verse number="3" style="v" />Eh xa kaq chik i xaq aachii' xa je' chik iq'omamaj ruuk' i kaq laj iq'oom</para>
  <para style="q">yohb'aal wach holwochiil ti q'orik.</para>
  <para style="q">Eh re' pantaq awach</para>
  <para style="q">xa je' chik kaq'iil paam granado ink'utinik chupaam i b'urb'al awach.</para>
  <para style="q">
    <verse number="4" style="v" />Re' i awalaq,</para>
  <para style="q">je' holwochiil inajt naah paat xuyejaa' chee David,</para>
  <para style="q">re' inkich'ilaa' wii' i jinaj miil chi pulato ch'ihch'</para>
  <para style="q">re' inkiko'leej wii' kiib' i kow kiib'.</para>
  <para style="q">
    <verse number="5" style="v" />Re' i kab'chel ach'uuch' je' kikab' i kok' ixoq keej laach noq ki-aasjik</para>
  <para style="q">wilkeeb' chupaam i uhtz'ub'.</para>
  <para style="q">
    <verse number="6" style="v" />Eh noq naa ruchaliik rusaq'iik noq naa rokiik chee saqum,</para>
  <para style="q">re' hin nawojiik chinaah i yuuq' wilik wii' i mirra,</para>
  <para style="q">i wilik wii' i Insensia.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' hat ixoq q'e' ti nuk'ax chi weh,</para>
  <para style="q">xti manlik wach aawooq aq'ab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Kim wuuk' i hat wehk'een,</para>
  <para style="q">taq chupaam i ye'aab' Líbano</para>
  <para style="q">taq chinaah i yuuq' Amana rub'ihnaal,</para>
  <para style="q">je' wo' chinaah i yuuq' Senir wilik ar Hermón,</para>
  <para style="q">re' inkikeb'aa' wii' kiib' i kaq b'ahlam,</para>
  <para style="q">re' wo' inkikeb'aa' wii' kiib' taqe i nimaq winaq b'ahlam.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' hin xti ch'ilojik chawiij i wánima wehk'een je' hat wanaab' noq wilkaat,</para>
  <para style="q">xa ruuk' i jun iil xa a'n weh xanoq wo' xinok'rik chawiij</para>
  <para style="q">ruum ma' k'isiin holwochiil aakarena wilik chawalaq.</para>
  <para style="q">
    <verse number="10" style="v" />Hat weh k'een, hat wanaab' noq wilkaat,</para>
  <para style="q">ma' k'isiin ta holwochiil noq kinaq'acheej, ma' xata je' suq kiil i riis uuva.</para>
  <para style="q">Xiik' naah k'ohonkiil awach ma' xata je'</para>
  <para style="q">k'ohonkiil chu'nchel ink'ohnik laj iq'oom</para>
  <para style="q">
    <verse number="11" style="v" />Re' aq'oral i nelik cho xaq aachii' wehk'een</para>
  <para style="q">xa je' chik ki'iil i riis kaab', xa je' chik suq kiil lecha.</para>
  <para style="q">Re' aso' xiik' nah k'ohonkiil wach</para>
  <para style="q">xa je' chik k'ohonkiil iq'oom inchalik Líbano.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' hat wehk'een, je' hat wanaab' noq wilkaat, je' akab' i uhtz'ub' kojooj pan koraal,</para>
  <para style="q">je' akab' i k'achlik ha' kotimaj riij chi tz'aq.</para>
  <para style="q">
    <verse number="13" style="v" />Re' hat je' akab' i ye'aab' wilik wii' i granado</para>
  <para style="q">q'e' suq i ruwachuj,</para>
  <para style="q">je' akab' i ye'aab' wilkeeb' wii' uhtz'ub' Alhen-a rub'ihnaal.</para>
  <para style="q">
    <verse number="14" style="v" />Je' akab' i ye'aab' i nelik wii' ink'ohnik laj Nardo, i Azafrán,</para>
  <para style="q">nimaq rooq wach chee' canela.</para>
  <para style="q">Eh i nelik wii' i insensia,</para>
  <para style="q">i mirra, i áloes,</para>
  <para style="q">eh chu'nchel ink'ohnik laj iq'oom</para>
  <para style="q">
    <verse number="15" style="v" />Re' hat je' akab' i ye'aab' wilik wii' uhtz'ub',</para>
  <para style="q">je' wo' akab' i raasb'al k'achlik ha'</para>
  <para style="q">inb'ehik chee rooq ar Líbano.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="16" style="v" />Neeta naq inchalik i teew pantz'eet pansak'aaj reh i rookb'aal q'iij</para>
  <para style="q">nee ta naq inik'ik hupinoq chinaah i je' ye'aab' wilik wii' i tik.</para>
  <para style="q">Re' hat winaq, q'e' ti nuk'ax chi weh</para>
  <para style="q">kim ruuk' i je' tik chak'ux aweh i suq laj wach.</para>
  <chapter number="5" style="c" />
  <para style="sp">RE' B'AHIILB'EES</para>
  <para style="q">
    <verse number="1" style="v" />Re' hin xin chalik chik i wilik wii' i tik</para>
  <para style="q">hat wehk'een, hat wanaab' noq wilkaat,</para>
  <para style="q">xnumol chik i numirra, taqe ink'ohnik laj iq'oom</para>
  <para style="q">Eh xnub'an chik rusuqkiil i riis kab',</para>
  <para style="q">i nuriis uuva, i nulecha.</para>
  <para style="sp">PARUK'IHAAL</para>
  <para style="q">Hat taq wamigo cha a'n taq awa'</para>
  <para style="q">ahaa', eh cha a'n taq rusuqkiil i q'orinik awiib'.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin kiwirik naq, re' wánima xama' wirik ta wo' hoq,</para>
  <para style="q">re' winaq q'e' nuk'ax xb'iraj noq xuq'or weh chi je' wili:</para>
  <para style="q">Chateh weh i puerta i hat q'e' ti nuk'ax, hat wanaab' noq wilkaat,</para>
  <para style="q">je' akab' i k'isa xq'un paloma.</para>
  <para style="q">Re' mus jab' k'ahchi' kiin rut'aqsam,</para>
  <para style="q">re' k'uxik k'achi' rut'aqsam i rismaal nunaah, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' hin je' wili xnuq'or reh:</para>
  <para style="q">Xwesaj chik i nuso',</para>
  <para style="q">konee wo' chik i nukoj ruka'peech iraaj ruq'orom, eh nutz'aj chik i wooq,</para>
  <para style="q">nee wo' chik i nujik chi pooq.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh re' i winaq q'e' nuk'ax korehtaal xumin i koq i q'ab' pan hoop</para>
  <para style="q">xuteh riij i puerta, re' xub'an re' re' xutz'aj i wánima.</para>
  <para style="q">
    <verse number="5" style="v" />Eh xnuteh reh i puerta</para>
  <para style="q">i winaq q'e' nuk'ax,</para>
  <para style="q">xa je' chik k'ohonkiil mirra i nuq'ab' xukanaa'.</para>
  <para style="q">Eh xtz'uhranik chinaah i tehb'al reh i puerta.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Eh noq xnuteh reh i puerta i winaq q'e' nuk'ax,</para>
  <para style="q">re' reh elinaq chik reje ar.</para>
  <para style="q">Noq xtohq'ik naq chik nusik'im</para>
  <para style="q">ma' xnureq ta chik,</para>
  <para style="q">noq xnuyuq'eej reje xama' xiruchaq'weej ta wo' chik.</para>
  <para style="q">
    <verse number="7" style="v" />Eh xinkireq taqe i kicha'jinik reh i tinamit</para>
  <para style="q">xinkiq'ojib'eej, xinkihopib'eej.</para>
  <para style="q">Re' taqe i aj cha'joom wilkeeb' panookb'al reh i tinamit</para>
  <para style="q">xkilahk'aaj chi wiij i nub'urb'aal.</para>
  <para style="q">
    <verse number="8" style="v" />Hat taq ixoq aj Jerusaleem, re' hin i nuq'or taq aweh i korik</para>
  <para style="q">chi wixawil taq wach i winaq q'e' nuk'ax cha q'or taq reh</para>
  <para style="q">chi xanwotow chik rilariik wach xchalik nuyab'ilaal ruum.</para>
  <para style="sp">PARUK'IHAAL</para>
  <para style="q">
    <verse number="9" style="v" />¿Mi xiik' naah aholwochiil re' hat chikiwach chu'nchel ixoq?</para>
  <para style="q">¿Mi xiik' naah holwochiil re' i winaq q'e' nak'ax wach i hat chuwach chu'nchel i winaq?</para>
  <para style="q">Ruum inaq'or chi naa qaq'oreem aweh.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="10" style="v" />Re' winaq i nuq'or</para>
  <para style="q">kaqb'uxik i ruti'jolal, xa re' wo' reh xiik' naah</para>
  <para style="q">holwochiil ink'utinik chi kixilak i lajeeb' miil chi winaq.</para>
  <para style="q">
    <verse number="11" style="v" />Eh re' i naah je' holwochiil i manlik oro</para>
  <para style="q">re' i rismaal i naah k'oloch, eh xaq'eq chik</para>
  <para style="q">je' rukab' i nimlaj tz'ok q'eq riij chikop inrupinik pan taxaaj.</para>
  <para style="q">
    <verse number="12" style="v" />Re' taqe inaq'wach, je' kiholwochiil i paloma,</para>
  <para style="q">xa je' chik b'anooj kitiin ruuk' lecha, wilik i koq chi chii' i nim haa'.</para>
  <para style="q">
    <verse number="13" style="v" />Re' taqe i pan wach xa je' chik holwochiil uhtz'ub'.</para>
  <para style="q">Re' taqe i xaq chii' xa je' chik saq uhtz'ub'</para>
  <para style="q">xa je' chik k'ohonkiil ruha'iil mirra noq inqajik chaloq.</para>
  <para style="q">
    <verse number="14" style="v" />Eh wilik taqe rulopq'aaq' oro ju' taq q'ab', eh xoyimaj wach ruuk' ab'aj topacio,</para>
  <para style="q">re' i ruti'jolal xoyimaj wach ruuk' ab'aj marfil, ruuk' ab'aj safiro.</para>
  <para style="q">
    <verse number="15" style="v" />Re' taqe i rutuuq</para>
  <para style="q">xa je' chik holwochiil ab'aj Marmol,</para>
  <para style="q">ch'ikamaj chinaah i manlik oro.</para>
  <para style="q">Re' ruwii' q'e' holohik je' kiholwochiil i chee' chakaltee' inchalik Líbano.</para>
  <para style="q">
    <verse number="16" style="v" />Re' i q'orik i nelik cho panchii'</para>
  <para style="q">xa ki' chik, re' ruwii' xak'axb'al chik wach.</para>
  <para style="b" />
  <para style="q">Je' re' ruwii' i nub'ahiil, q'e' i nuk'ax,</para>
  <para style="q">wila' nawaaj taq anab'eem i hat taq ixoq aj Jerusaleem.</para>
  <chapter number="6" style="c" />
  <para style="sp">PARUK'IHAAL</para>
  <para style="q">
    <verse number="1" style="v" />Hat ixoq i xiik' naah aholwochiil</para>
  <para style="q">chikiwach taqe ixoq,</para>
  <para style="q">¿Aha' xuk'am i winaq q'e' nak'ax inaq'or? Chak'uhtaaj qeh</para>
  <para style="q">reh chi nee qohooj chawiij chusik'ariik.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="2" style="v" />Re' i nub'ahiil xooj qohoq i rutikim wii' i chib'ih reh</para>
  <para style="q">re' wilik wii' xiik' naah k'ohonkiil</para>
  <para style="q">xooj naa chub'ehteesjiik taqe i rutentzuun,</para>
  <para style="q">xooj chusik'ariik ruhtz'uub'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' winaq q'e' nuk'ax, re' inehchanik weh, eh re' wo' hin kinehchanik ree reh.</para>
  <para style="q">Eh rub'esaj taqe i rutentzuun pan uhtz'ub'.</para>
  <para style="sp">RE' B'AHIILB'EES</para>
  <para style="q">
    <verse number="4" style="v" />Re' hat ixoq q'e' ti nuk'ax, xiik' naah aholwochiil</para>
  <para style="q">je' aholwochiil i tinamit Tirsa, i tinamit Jerusaleem,</para>
  <para style="q">eh je' aholwochiil i ch'umiil wilkeeb' pan taxaaj</para>
  <para style="q">
    <verse number="5" style="v" />Chakanaa' nutz'ehtjiik</para>
  <para style="q">ruum xama' nukuy ta chik rilariik aholwochiil.</para>
  <para style="b" />
  <para style="q">Re' i rismaal anaah xa q'eq b'utz'ik chik xa je' chik rukab' i kiij i kaprax</para>
  <para style="q">noq kiqajik cho wach yuuq' Galaad.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taqe aweeh xasaq chik,</para>
  <para style="q">xa je' chik saqiil kiij i tentzun</para>
  <para style="q">kore' xi elik cho chi itinik panha'</para>
  <para style="q">kiyejaam chik kiib' chi naa ruyok'ariik i rismaal kiij.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' pantaq awach</para>
  <para style="q">xa je' chik kaq'iil paam granado ink'utinik i koq chupaam i b'urb'al wach anaah.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' taqe ixoq reey xnub'an wii' kaxáro oxk'ahl taqe,</para>
  <para style="q">re' taqe i xa wixoqil pan b'eeh,</para>
  <para style="q">re' taqe i kok' q'ahxoq kajwinaq taqe.</para>
  <para style="q">
    <verse number="9" style="v" />Xa re' la' xa jinaj wo' hoq ixoq</para>
  <para style="q">q'e' nuk'ax xtiruk'uliil i wánima je' holwochiil paloma,</para>
  <para style="q">xa jinaj wo' chuwach i rutuut looq reh.</para>
  <para style="q">Eh noq inilarik wach kuum i q'ahxoq inkiyeew rusuqkiil ruk'ux,</para>
  <para style="q">re' taqe i wixoqil reey,</para>
  <para style="q">je' wo' taqe i xa wixooq pan b'eeh xkiyeew wo' ruloq'il.</para>
  <para style="sp">PARUK'IHAAL</para>
  <para style="q">
    <verse number="10" style="v" />¿Awach ixoq xk'uloq inaq'or xasaqum chik i rub'an</para>
  <para style="q">xa je' chik rukab' i rusaqumaal i q'iij noq inokik cho rusaq'iik,</para>
  <para style="q">eh je' holwochiil i poh</para>
  <para style="q">xa je' chik ruk'ihaal soldado?</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="11" style="v" />Re' hin xinqajik qohoq tikooj taqe wii' i chee' okaal,</para>
  <para style="q">eh xwilow uhtz'ub' wataq k'ixkaab'.</para>
  <para style="q">Eh xwilow chi elik chik inki a'n chaloq i uuva,</para>
  <para style="q">eh ixmak'inik chik i rub'an i granado.</para>
  <para style="q">
    <verse number="12" style="v" />Eh noq majaa' nukohlaaj rilariik taqe re',</para>
  <para style="q">xa chi ma' weht'al xink'amarik reje,</para>
  <para style="q">ko wilkiin chik pan kareta wuch'ihil i k'amal nub'eeh noq xwil.</para>
  <para style="sp">PARUK'IHAAL</para>
  <para style="q">
    <verse number="13" style="v" />Tisutinoq, ti sutinoq chaloq i hat ixoq aj Sulamita</para>
  <para style="q">inqaaj qilom awach.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">¿Chihreet noq inawaaj taq awilom nuwach?</para>
  <para style="sp">PARUK'IHAAL</para>
  <para style="q">Re' hoj inqaaj qilom chi soon i na a'n, je' rukab' i soon inki a'n i soldado.</para>
  <chapter number="7" style="c" />
  <para style="sp">RE' B'AHIILB'EES</para>
  <para style="q">
    <verse number="1" style="v" />Hat wehk'een xiik' inche naah holwochiil ink'utinik aawooq pan axijaab'.</para>
  <para style="q">Re' i nah atuuq xa holohik chik</para>
  <para style="q">xa je' chik rukab' i ruyejaa' i aj ch'eyool ruuk' oro,</para>
  <para style="q">rutijem riib' chi korik.</para>
  <para style="q">
    <verse number="2" style="v" />Eh re' awatz'uum xa kotokik chik</para>
  <para style="q">xa je' chik rukab' i kulk inwihik wii' i suq laj riis uuva.</para>
  <para style="q">Re' apaam je' rukab' i juntuhb' chi Trigo</para>
  <para style="q">koralimaj riij chi uhtz'ub'.</para>
  <para style="q">
    <verse number="3" style="v" />Re' kab'chel ach'uuch' je' kikab' i kok' qahxoq keej laach noq ki-aasjik.</para>
  <para style="q">
    <verse number="4" style="v" />Eh re' awalaq je' holwochiil inajt naah paat Marfil ruyej-aal.</para>
  <para style="q">Re' taqe i naq'awach je' rukab' i ye'aab' ha'</para>
  <para style="q">wilik Hesbón ar chi chii' ookb'al Bat-rabim.</para>
  <para style="q">Eh re' aaju' je' holwochiil inajt naah paat ar Líbano,</para>
  <para style="q">inilwik reje Damasco.</para>
  <para style="q">
    <verse number="5" style="v" />Eh re' anaah yohb'aal wach holwochiil je' rukab' i yuuq' Carmelo,</para>
  <para style="q">re' i rismaal aanaah xa kaq lumik chik</para>
  <para style="q">je' rukab' i ruso' i reey.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Hat ixoq q'e' ti nuk'ax hat weh,</para>
  <para style="q">xti xiik' naah aholwochiil xti ch'iklik nuk'ux awuuk'.</para>
  <para style="q">
    <verse number="7" style="v" />Eh xa tijikik chik xa je' chik akab' i kalaab',</para>
  <para style="q">re' taqe i ach'uuch' je' rukab' noq i rukutaa' riib' i wach.</para>
  <para style="q">
    <verse number="8" style="v" />Re' hin inwaaj johtik chinaah i kalaab' re' re'</para>
  <para style="q">reh chi neenooj nusik' weh i wach.</para>
  <para style="q">Re' taqe ach'uuch' je' rukab' noq inkikutaa' kiib' i wach i uuva,</para>
  <para style="q">eh re' aawuxlaab' xa je' chik k'ohonkiil mansano.</para>
  <para style="q">
    <verse number="9" style="v" />Re' aq'oral je' rukab' i chi hoj laj riis uuva</para>
  <para style="q">xa ch'ub'ik chik noq inqajik</para>
  <para style="q">noq inuuk'jik qohoq.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="10" style="v" />Re' hin, hin reh i winaq q'e' nuk'ax,</para>
  <para style="q">xawuuk' i hin i rureq rusuqkiil ruk'ux.</para>
  <para style="q">
    <verse number="11" style="v" />Kim wuuk' i hat q'e' ti nuk'ax chi weh, taq panab'iix</para>
  <para style="q">ar neenqik'saj chee aq'ab' chupaam i uhtz'ub'.</para>
  <para style="q">
    <verse number="12" style="v" />Eh wahq'eq naa rojiik qilom mi xk'er chik i ruhtz'ub'aal</para>
  <para style="q">mi wilik chik wach i uuva,</para>
  <para style="q">mi xk'er chik i wach i granado.</para>
  <para style="q">Eh ar neenqak'ax qiib' neenuyeew rusuqkiil ak'ux.</para>
  <para style="q">
    <verse number="13" style="v" />Re' mandrágoras xupuhkaaj chik riib' i ruk'ohonkiil,</para>
  <para style="q">eh chi chii' taqe i qapuerta wilik ar chu'nchel i wach i chee' ink'uxarik.</para>
  <para style="q">Wilik taqe i kore' xsik'arik,</para>
  <para style="q">wilik i chiqinaq chik,</para>
  <para style="q">numolom taqe aweh i hat winaq q'e' ti nuk'ax.</para>
  <chapter number="8" style="c" />
  <para style="q">
    <verse number="1" style="v" />Hat ta naq nuxib'aal</para>
  <para style="q">jinaj ta xqa'an wii' qach'uuch' awuuk'</para>
  <para style="q">nee naq i rub'an chi nee tinutz'ub' pantaq b'eeh,</para>
  <para style="q">atoob' ta nee naq qoh kilow xama' awach ta naq neenkaqse'lanik weh.</para>
  <para style="q">
    <verse number="2" style="v" />Eh nee naq ti nuk'am i koq parupaat i qatuut</para>
  <para style="q">re' naq chik i hat neetitijinik weh,</para>
  <para style="q">eh nee naq i nuyeew aweh chi uuk'jik ink'ohnik laj vino,</para>
  <para style="q">korjinaq ruuk' i riis granado.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Chi je' re' nee naq inakoj chee rutz'eet aq'ab' rijwalaq,</para>
  <para style="q">eh ruuk' naq i rusak'aaj aq'ab' nee kinaq'ahcheej.</para>
  <para style="sp">RE' B'AHIILB'EES</para>
  <para style="q">
    <verse number="4" style="v" />Re' hin i nuq'or taq aweh i hat ixoq aj Jerusaleem</para>
  <para style="q">chi majot' taq i koq ruuk' i ruwiriik ixoq q'e' nuk'ax,</para>
  <para style="q">cha kanaa' taq konik' pa' neenwuktik.</para>
  <para style="sp">PARUK'IHAAL</para>
  <para style="q">
    <verse number="5" style="v" />¿Awach i xchalik chupaam i ye'aab' chiq yuuq'</para>
  <para style="q">yoklik i koq wach tileb' i winaq q'e' ink'axwik reh?</para>
  <para style="sp">RE' B'AHIILB'EES</para>
  <para style="q">Re' hin chi ri'sil i juniwal</para>
  <para style="q">chi mansano xat ponik wuksaj</para>
  <para style="q">panawiriik re' i xuk'ul wii' i ti' k'axik aatuut noq xat-aasjik.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="6" style="v" />Juneliik ta naq neekinwihik pan awánima, chalechaa' wach atileb' i nub'ihnaal.</para>
  <para style="q">Re' ak'axb'al xiik' naah ma' nuko'leej ta wiib' chuwach</para>
  <para style="q">je' rukab' noq inchalik i kimik.</para>
  <para style="q">Re' aak'axb'al je' rukab' i q'aaq' yohb'aal wach i xaq.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' i ruha'iil chu'nchel i palaw,</para>
  <para style="q">i ruha'iil i nim ha'</para>
  <para style="q">ma' jaruuj neenkian ruchupariik i ak'axb'al.</para>
  <para style="q">Eh ma' awach taj i nee ruyeew</para>
  <para style="q">chu'nchel i rub'ehomal chi jalb'al wach aak'axb'al</para>
  <para style="q">xa ruk'ixb'ilaal naq i neeruk'uhtaaj.</para>
  <para style="sp">PARUK'IHAAL</para>
  <para style="q">
    <verse number="8" style="v" />Re' hoj wilik i jinaj i qanaab' ko k'isa q'ahxoq</para>
  <para style="q">komajaa' ta chihruch'uuch'.</para>
  <para style="q">¿Chib'ih i neenqa a'n ruuk'</para>
  <para style="q">wila' xk'ulik pahqaljoq ruum jino'q winaq?</para>
  <para style="q">
    <verse number="9" style="v" />Re' ta ruuk' jino'q i tz'aq</para>
  <para style="q">nee naq inqayejaa' jino'q inajt naah paat chinaah ko'lemb'al iib' plata ruyej-aal.</para>
  <para style="q">Eh wita re' ruuk' jino'q puerta</para>
  <para style="q">nee naq inqatz'ap riij chi holohik chi chee' re' ruuk' i chakaltee'.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="10" style="v" />Re' hin je' nukab' jinaj i tz'aq,</para>
  <para style="q">re' taqe i nuch'uuch' je' rukab' i paat najt naah</para>
  <para style="q">re' i winaq q'e' nuk'ax</para>
  <para style="q">xti xureq rusuqkiil ruk'ux wuuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' Salomón xutik i ru-uuva</para>
  <para style="q">chupaam i ye'aab' Baal-hamón xukoj taqe cha'jen reh.</para>
  <para style="q">Reh chi paruq'ijil i rusik'ariik i wach i uuva</para>
  <para style="q">nanaq kiye'em i ju'jun miil chi tumiin tojb'al riij.</para>
  <para style="q">
    <verse number="12" style="v" />Eh i junseht chi uuva i nutikim xa wee hin,</para>
  <para style="q">re' hin kin cha'jinik reh, re' i jinaj miil chi tumiin re' Salomón naa ruk'ulwiik reh,</para>
  <para style="q">eh kiib' siento i keh i cha'jen reh i uuva.</para>
  <para style="sp">RE' B'AHIILB'EES</para>
  <para style="q">
    <verse number="13" style="v" />Re' hat ixoq q'e' ti nuk'ax, eh wilkaat xilak uhtz'ub'</para>
  <para style="q">chayeew chi ib'irjik aq'oral k'ahchi' kuy-eem taqe i qamigo,</para>
  <para style="q">chi naa aq'oriik.</para>
  <para style="sp">RE' EHK'EENB'EES</para>
  <para style="q">
    <verse number="14" style="v" />Kim awajiim winaq</para>
  <para style="q">q'e' ti nuk'ax je'-oq ti ajiminik cho keej,</para>
  <para style="q">eh je'-oq ti ajiminik rak'uun keej chinaah taqe i yuuq' xank'ohnik chik aawach.</para>
</usx>