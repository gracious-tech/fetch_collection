<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="JER" style="id">JERPOK.SFK 15-07-2,008 Adelina Quej. Pocomchí. Updated for DBL by G. Grasso and E. Canales, Dec 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">JEREMIAS</para>
  <para style="toc3">Jer</para>
  <para style="toc2">Jer</para>
  <para style="toc1">JEREMIAS</para>
  <para style="mt2">RE' I RUHUUJ I JEREMIAS</para>
  <para style="mt1">JEREMIAS</para>
  <chapter number="1" style="c" />
  <para style="s">Re' i ruyuq'ub'jiik, re' i naa rub'anam i Jeremías</para>
  <para style="p">
    <verse number="1" style="v" />Re' taqe i xuq'or, re' taqe i xub'an i Jeremías, rak'uun i Hilsías, re' ruuk' taqe i k'amal kib'eeh aj tiij xi patinik Anatot wilik paruyuq'ul i Benjamín. <verse number="2" style="v" />Re' i QaJaaw Dios xuq'oreej chaloq i Jeremías noq oxlaj haab' chik rokiik chi reyil Josías ar Judá i rak'uun Amón. <verse number="3" style="v" />Eh re' i QaJaaw Dios xuq'oreej i Jeremías noq xwihik chi reyil Judá Joacim rak'uun i Josías, eh noq i xwihik chi reyil ar i Sedequías rak'uun i Josías, korehtaal chik xukohlaaj i junlaj haab' chi reyil ar. Eh paroo' poh ree haab' re' re' xi k'amarik reje pan tokoom tinamit i aj Jerusaleem.</para>
  <para style="p">
    <verse number="4" style="v" />Re' i QaJaaw Dios je' wili i xuq'or weh:</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Noq komajaa' titz'uhk'rik cho ruuk' aatuut xa weht'al wo' naq chik awach.</para>
  <para style="q">Eh noq komajaa' ti aasjik xanoq wo' xat nukuxisaj,</para>
  <para style="q">eh xat nupab'aa' chi hat jalal nuq'oral chupaam chu'nchel i tinamit, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" />Eh re' hin je' wili xnuq'or:</para>
  <para style="b" />
  <para style="q">Jaaw xti ma' ruk'ul taj inaq'or weh chi je' re' ruum re' hin,</para>
  <para style="q">ko hin k'isa k'un, eh ma' kinchol ta q'orik, kinki reh.</para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" />Re' i QaJaaw Dios je' wili i xuq'or weh:</para>
  <para style="b" />
  <para style="q">Re' hat maa q'or chi ko hat k'isa k'un,</para>
  <para style="q">naa la' awojiik aha' naa kaat nutaq'aam reje.</para>
  <para style="q">Eh re' wo' naa aq'orom naa nuq'orom aweh.</para>
  <para style="q">
    <verse number="8" style="v" />Re' hat ma' awach ta aj uum naa ayo'jiik,</para>
  <para style="q">ruum re' hin naa nuwihiik awuuk' chako'ljiik, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" />Re' QaJaaw Dios xuyub' chaloq i q'ab' xutz'aj i xaq nuchii', je' wili i xuq'or weh:</para>
  <para style="b" />
  <para style="q">Re' wili rehtalil chi xnuyeew chik taqe i nuq'oral panachii'.</para>
  <para style="q">
    <verse number="10" style="v" />Yu'naak xat nukoj chikinaah i tinamit, chikinaah i reey.</para>
  <para style="q">Reh chi wilik i naa asacham wach,</para>
  <para style="q">chi wilik i naa aachuqum, chi wilik naa ayojom,</para>
  <para style="q">chi wilik i naa awesam, chi wilik i naa ayejaam,</para>
  <para style="q">i naa atikim, inki weh.</para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" />Re' i QaJaaw Dios je' wili i xuq'or weh: ¿Chib'ih jariik i k'achi' awilom wach? inki. Re' hin je' wili i xnuq'or: Re' hin jinaj i q'ab' chee' almendro k'achi' wilom wach, kinki reh. <verse number="12" style="v" />Re' i QaJaaw Dios je' wili i xuq'or weh: Korik i xaq'or re' re' i rehtalil chi naa nub'anam chi jumehq'iil taqe i nuq'orom chaloq, inki.</para>
  <para style="p">
    <verse number="13" style="v" />Re' i QaJaaw Dios je' wo' chik wili i xuq'or weh: Yu'naak ¿Chib'ih chik jariik i k'achi' awilom wach? inki. Jinaj i xun k'ahchi' wilom wach xan rooq rotik chik i ha' chupaam xaraaj chik reje b'uulinik pantz'eet reh i rookb'aal q'iij, kinki reh.</para>
  <para style="p">
    <verse number="14" style="v" />Re' i QaJaaw Dios je' wili i xuq'or weh:</para>
  <para style="b" />
  <para style="q">Re' re' i rehtalil chi pantz'eet reh i rookb'aal q'iij naa ruchaliik i ti' k'axik</para>
  <para style="q">naakik'ulum taqe i Judá.</para>
  <para style="q">
    <verse number="15" style="v" />Re' hin i Dios naa nuk'amam chaloq</para>
  <para style="q">i tinamit wilkeeb' cho pantz'eet reh i rookb'aal q'iij,</para>
  <para style="q">je' wo' taqe i kireey.</para>
  <para style="q">Eh ar naa kiyejaam i kipaat panookb'al reh i Jerusaleem,</para>
  <para style="q">ar naakilok'em reje kiib' chuwach i tz'aq kotimaj wii' riij i tinamit.</para>
  <para style="q">Eh ar naakilok'em reje i kipaat chuwach i tinamit Judá.</para>
  <para style="q">
    <verse number="16" style="v" />Ruum i kiyiib' wach na'ojb'al i tinamit re' re'</para>
  <para style="q">naa nuye'em i ti' k'axik chikinaah,</para>
  <para style="q">ruum xin kiq'eb' chi riij kik'ux, xkik'at i insensia, eh kiloq'ej taqe i tiyoox,</para>
  <para style="q">re' ki dios i tokoom tinamit xa re' keh kiyej-anik reh.</para>
  <para style="q">
    <verse number="17" style="v" />Re' hat Jeremías chakowej awiib'</para>
  <para style="q">hiy cha q'or keh i tinamit re' re' chu'nchel i xnuq'or aweh, mat yo'jik kuum.</para>
  <para style="q">Eh wila' ma' xa a'n i xnuq'or aweh</para>
  <para style="q">naa nuye'em q'ab' chi naa ab'arb'otiik ruum ayo'jiik chikiwach.</para>
  <para style="q">
    <verse number="18" style="v" />Yu'naak i hin naa kaat nukanaam</para>
  <para style="q">chi je' rukab' i tinamit kotimaj riij chi tz'aq,</para>
  <para style="q">chi je' akab' i rooq paat ch'ihch' ruyej-aal,</para>
  <para style="q">chi je' akab' i q'an ch'ihch' inkojarik chi koraal.</para>
  <para style="q">Reh chi nee nakuy kik'ulb'ejiik chu'nchel i tinamit wilkeeb' Judá,</para>
  <para style="q">taqe i kireey,</para>
  <para style="q">taqe i k'amal kib'eeh aj tiij.</para>
  <para style="q">
    <verse number="19" style="v" />Re' keh nanaq kianam aweh ruuk' q'aq'inik,</para>
  <para style="q">xa re' la' xama' xta wo' naa kaat kuchem,</para>
  <para style="q">ruum re' hin naa nuwihiik awuuk' chi ako'ljiik, inki i Dios.</para>
  <chapter number="2" style="c" />
  <para style="s">Re' i ma' holohik taj xkian i aj Israel chuwach i QaJaaw Dios</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or weh:</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Hiy kuuk' i aj Jerusaleem cha q'or keh chi je' wili:</para>
  <para style="q">Re' i QaJaaw Dios je' wili i xuq'or taq chawiij.</para>
  <para style="q">Re' hin ink'ulik panuk'ux noq xnuchop cho kinaah</para>
  <para style="q">noq xkitoq'aa' cho nimanik korik naq wach kik'ux wuuk'.</para>
  <para style="q">Eh kinkik'ax naq xkiyeew cho kik'ux wuuk',</para>
  <para style="q">re' noq xnuk'am cho kib'eeh panchiq yuuq'</para>
  <para style="q">re' i ma' xta wii' i tik.</para>
  <para style="q">
    <verse number="3" style="v" />Re' taqe i aj Israel santo laj tinamit naq taqe, peet naq taqe cho wak'uun wixq'uun,</para>
  <para style="q">ruum aj re' awach naq taqe imb'anik ti' k'axik keh</para>
  <para style="q">i nuyeew naq taqe chutojariik i kimahk tiko'q keh, inki i Dios.</para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" />Re' taq i hat, hat taq riih rumaam i Jacob, eh chawunchelaal taq i hat aj Israel, chab'iraj taq i ruq'oral i QaJaaw Dios. <verse number="5" style="v" />Re' reh je' wili i ruq'or taq chawiij:</para>
  <para style="b" />
  <para style="q">¿Chib'ih la' jariik i ma' holohik</para>
  <para style="q">taj xnub'an keh i kimaam kati't,</para>
  <para style="q">ruum re' chik taqe i tiyoox ma' xta kajaawriik xkinimaj.</para>
  <para style="q">Eh xkikanaa' kiib' chi xama' xta chik kikamaj?</para>
  <para style="q">
    <verse number="6" style="v" />Re' keh ma' xkikapaaj ta chik nunimjiik i hin.</para>
  <para style="q">Xanaah re', re' wo' naq i hin xineesanik cho keh ar Egipto.</para>
  <para style="q">Eh xnuk'am wo' naq cho kib'eeh panchiq yuuq',</para>
  <para style="q">Re' i ye'aab' ma' xta wii' ha' b'oqeel taqe paam,</para>
  <para style="q">ma' k'isiin taqe i yohb'aal chupaam.</para>
  <para style="q">Re' taqe i ye'aab' ma' xta patineel chupaam,</para>
  <para style="q">eh ma' awach ta i nik'ik ar.</para>
  <para style="q">
    <verse number="7" style="v" />Eh xnuk'am taqe chaloq chupaam i ye'aab'</para>
  <para style="q">wilik wii' i suq atoob' reh chi xkian rusuqkiil.</para>
  <para style="q">Xa re' la' re' keh xkitoq'aa' rub'an i re' ma' re'</para>
  <para style="q">xkisutej chi b'amb'al mahk i ye'aab' re' re'.</para>
  <para style="q">Eh xkich'uwa'risaj wach i nuye'aab' nuyeew keh.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taqe i k'amal kib'eeh aj tiij ma' re' ta chik i hin xinkinimaj,</para>
  <para style="q">eh re' taqe i k'amal kib'eeh xinsahchik pankik'ux.</para>
  <para style="q">Eh re' taqe i q'atal q'orik ma' xkiyeew ta wajaawriik.</para>
  <para style="q">Re' taqe i jalal naq nuq'oral re' chik i tiyoox Baal xkinimaj,</para>
  <para style="q">re' chik i xkinimaj i ma' xta kajaawriik.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Ruum aj re',</para>
  <para style="q">re' hin naa nuq'atam i q'orik taq cha naah i hat,</para>
  <para style="q">je' wo' chikinaah taqe awiih aamaam.</para>
  <para style="q">
    <verse number="10" style="v" />Yu'naak hiy taq chupaam i ye'aab' Quitim wilik reje parookb'aal q'iij.</para>
  <para style="q">Eh cha taq'aaj taq i reje i aj taqareel ar Cedar,</para>
  <para style="q">reh chi nee rilow chi korik mi wilik imb'anik reh je' rukab' i xa a'n taq i hat.</para>
  <para style="q">
    <verse number="11" style="v" />Eh ma' jino'q taqe kiloq'inik reh i tiyoox xkijal wach i ki dios.</para>
  <para style="q">Re' keh ma' nkijal ta wach i ki dios atoob' ta xama' xta wo' rajaawriik.</para>
  <para style="q">Eh re' taq i hat nutinamiit xajal taq nuwach kuuk' taqe i tiyoox</para>
  <para style="q">xama' xta wo' kajaawriik.</para>
  <para style="q">
    <verse number="12" style="v" />Eh re' taxaaj xan b'arb'otik chik</para>
  <para style="q">ruum ruyo'jiik noq xrilow</para>
  <para style="q">aha' wilik taq i xa a'n re' re'.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' taq i hat ki'ib' i yiib' wach na'ojb'al taq xa a'n</para>
  <para style="q">re' i peet re' chi xinaq'eb' taq chi riij ak'ux i hin,</para>
  <para style="q">je' naq hin k'achlik raasb'al ha' taq cha weh.</para>
  <para style="q">Eh je' naaxak'ot taq jino'q i jul</para>
  <para style="q">xama' xta wo' ha' i rumol, inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' taq i hat aj Israel</para>
  <para style="q">ma' hat ta naq taq k'ayimaj pan tokoom tinamit.</para>
  <para style="q">Eh yu'naak ¿Chib'ih reet noq xchoparik taq anaah kuum i tokoom tinamit?</para>
  <para style="q">
    <verse number="15" style="v" />¿Chib'ih reet noq yohb'aal wach i kijosq'iil i aj ixowaal</para>
  <para style="q">noq xi chalik taq cha naah xa je' chik kijosq'iil i kaq b'ahlam?</para>
  <para style="q">Eh xsacharik taq kiwach aatinamiit,</para>
  <para style="q">eh k'atarik ma' xta chik i xkahnik chupaam.</para>
  <para style="q">
    <verse number="16" style="v" />Re' taqe i tinamit kichalik Menfis, eh re' taqe i kichalik Tafnes</para>
  <para style="q">xisachwik wach taq aatinamiit.</para>
  <para style="q">
    <verse number="17" style="v" />Re' taq i hat je' taq re' i xak'ul ruum xinaq'eb'</para>
  <para style="q">taq chi riij ak'ux i hin, hin taq aaWaJaaw aaDios.</para>
  <para style="q">Eh hin wo' naq kink'amwik taq ab'eeh chupaam i holohik.</para>
  <para style="q">
    <verse number="18" style="v" />Eh yu'naak ¿Chib'ih taq neerutiq aweh chi nee taq tiooj Egipto</para>
  <para style="q">chi nee taq inawuk'ej aweh i nim ha' Nilo?</para>
  <para style="q">¿Chib'ih taq neerutiq aweh chi nee taq tiooj Asiria,</para>
  <para style="q">eh chi nee taq inawuk'ej aweh i nim ha' Éufrates?</para>
  <para style="q">
    <verse number="19" style="v" />Eh ruum taq ayiib' wach na'ojb'al naa ak'ulum i ti' k'axik,</para>
  <para style="q">ruum chi ma' tinimanik ta taq naa ruq'atariik i q'orik taq cha naah.</para>
  <para style="q">Xti cha kapaaj taq riij chi re' nuq'eb'ariik taq xa a'n ti' k'axik,</para>
  <para style="q">eh ruti'kiil k'uxliis i ruk'am taq cho cha naah,</para>
  <para style="q">ruum chi ma' nayeew ta taq chik nuloq'il i hin, inki, i QaJaaw Dios nim rajaawriik.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Re' taq i hat xa najtir wo' taq kinaq'eb' chi riij ak'ux,</para>
  <para style="q">ma' xawaaj ta taq chik nunimjiik, je' taq wili i xaq'or:</para>
  <para style="q">Re' hoj ma' nqaaj ta chik qa'nam i rukamaj, tiki taq.</para>
  <para style="q">Eh xat okik taq chub'anariik i je' k'oyomal</para>
  <para style="q">re' kilooqjiik taqe i tiyoox xa a'n taq</para>
  <para style="q">chi ri'sil taqe i nimaq taq chee' je' wo' chikinaah taqe i nimaq taq yuuq'.</para>
  <para style="q">
    <verse number="21" style="v" />Re' hin xti xatnuch'ikaa' wo' naq taq pana ye'aab',</para>
  <para style="q">je' rukab' noq intikarik i uuva holohik rija'eel.</para>
  <para style="q">¿Chib'ih reet noq xasutej taq awiib' chi je'</para>
  <para style="q">rukab' i uuva intikarik xama' holohik taj i rija'eel?</para>
  <para style="q">
    <verse number="22" style="v" />Re' taq i hat atoob' ta nee taq i na a'n awitiin ruuk' i xa chib'ih jariik,</para>
  <para style="q">oon nee taq i nakojib'eej awiib' pan xab'oon,</para>
  <para style="q">xama' jaruuj ta wo' naa reliik panaq' nuwach</para>
  <para style="q">i ruch'uwa'il taq wach amahk, inki QaJaaw Dios.</para>
  <para style="q">
    <verse number="23" style="v" />Eh ¿Nik' wach noq nee taq inaq'or chi je' wili:</para>
  <para style="q">Re' hoj ma' xta xqach'uwa'risaj wii' qiib'</para>
  <para style="q">ma' nqaloq'ej ta taqe i tiyoox, tiko'q taq?</para>
  <para style="q">Ruum re' taq i hat aweht'al taq xa a'n wa taq k'ixkaab',</para>
  <para style="q">xa a'n taq aweh je' rukab' ixoq cameyo</para>
  <para style="q">xa rajimam chik riib' inooj xa ruch'apaa' chik taqe i rixk'aq.</para>
  <para style="q">
    <verse number="24" style="v" />Xa a'n taq aweh i rub'an ixoq b'uurux, xa okrinaq wo' pantaq ch'ahn,</para>
  <para style="q">noq wilik parutehkiil wach</para>
  <para style="q">xanoq wo' rik'raaj reje i k'achi' rusik'im.</para>
  <para style="q">Eh xaraaj chik k'o'nik xama' awach ta chik impab'anik reh,</para>
  <para style="q">eh xa eliik inkan ruum i imas b'uurux chi xaraaj wo' k'o'nik.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Re' taq i hat aj Israel maa q'uhtisaj taq awiib', maa toxk'iij taq i nah aawooq,</para>
  <para style="q">maa kuy taq ahaa' chi ojik chikiij taqe i tiyoox.</para>
  <para style="q">Xa re' la' re' taq i hat je' wili taq inaq'or:</para>
  <para style="q">Re' hoj ma' nq'uhtik ta qak'ux chunimjiik taqe i tiyoox,</para>
  <para style="q">xa konaa wo' qatahqeem taqe, tiki taq.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Eh nik' wach noq ink'ixik i aj jileq' noq inkan chi riij,</para>
  <para style="q">je' re' noq naa taq ak'ixiik i hat aj Israel ruum taq i na a'n.</para>
  <para style="q">Eh naa wo' k'ixik taq aareey,</para>
  <para style="q">taqe i k'amal ab'eeh, taqe i k'amal kib'eeh i aj tiij, taqe i jalal naq nuq'oral i hin.</para>
  <para style="q">
    <verse number="27" style="v" />Re' chee' yej-amaj chi tiyoox je' wili taq inaq'or reh:</para>
  <para style="q">Hat wajaaw, tiki taq reh,</para>
  <para style="q">eh re' ab'aj korjinaq chi ixoq tiyoox,</para>
  <para style="q">hat nutuut, tiki taq reh.</para>
  <para style="q">Eh re' hin re' taq chik awiij xasutej weh.</para>
  <para style="q">Noq panyohb'aal taq chik wilkaat ko' ra'j</para>
  <para style="q">je' wili taq inaq'or weh re': Qoh ako'leej, tiki taq.</para>
  <para style="q">
    <verse number="28" style="v" />Re' taq i hat aj Judá xayejaa' taq</para>
  <para style="q">ju'jun atiyoox chupaam i ju'jun chi tinamit,</para>
  <para style="q">neerub'an chi kuuk' taqe re' neenapahqaaj taq atoob'jiik</para>
  <para style="q">noq neenchalik i ti' k'axik taq cha naah</para>
  <para style="q">i lb'al reh mi nee pa' inki a'n taq atoob'jiik.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />¿Chib'ih reet noq inchalik taq aa peleto wuuk'</para>
  <para style="q">chawunchelaal taq i hat ma' kinanimaj ta taq chik?</para>
  <para style="q">inki i QaJaaw Dios.</para>
  <para style="q">
    <verse number="30" style="v" />Re' hin xnuyeew taqe panti' k'axik aawak'uun,</para>
  <para style="q">eh xama' xkijal ta wo' wach i kina'ojb'al.</para>
  <para style="q">Chawunchelaal taq i hat xa kansaj taq chi q'aslaj ch'ihch' taqe i jalal nuq'oral,</para>
  <para style="q">xa je' taq chik akab' i josq'laj i kaq b'ahlam noq i ruchop i rutiib'.</para>
  <para style="q">
    <verse number="31" style="v" />Re' taq i hat i aj Israel</para>
  <para style="q">chab'iraj taq i nuk'uhb'aal.</para>
  <para style="q">¿Mi xa je' hin jino'q chiq yuuq'</para>
  <para style="q">mi xa je' hin jino'q i ye'aab' q'equm paam taq cha weh re'?</para>
  <para style="q">Hat taq nutinamiit, ¿Chib'ih reet noq inaq'or taq chi je' wili:</para>
  <para style="q">Yu'naak xoj elik chik panaq'ab' ma' jaruuj</para>
  <para style="q">chik naa kaat qanimam tiki'nche taq weh?</para>
  <para style="q">
    <verse number="32" style="v" />Re' i xq'un naa rub'anam kaxáro ma' jaruuj</para>
  <para style="q">neensahchik paruk'ux taqe naa ruxoyem wii' riib',</para>
  <para style="q">eh je' wo' hoq i ruso'.</para>
  <para style="q">Raaj taq i hat, i hat taq nutinamiit,</para>
  <para style="q">¿Chib'ih reet noq najtir kinsahchik taq panak'ux?</para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" />Eh xa nayejaa' taq chik reje awiib' noq tiooj taq chub'anariik i je' k'oyomal.</para>
  <para style="q">Eh hat taq aj tijoom chub'anariik taqe i yiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="34" style="v" />Re' taq i hat xasach taq aso'</para>
  <para style="q">ruuk' i kikik'eel taq aawas achaaq',</para>
  <para style="q">re' i xa neb'aa' tii taqe, eh ma' xta wo' naq i yiib' wach k'ahchi' keeb'.</para>
  <para style="q">Eh xama' xta wo' naq kimahk taq xareq.</para>
  <para style="q">
    <verse number="35" style="v" />Eh je' taq wili inaq'or:</para>
  <para style="q">Re' hoj ma' xta qamahk ma' kaqrinaq ta chik i Dios quuk', tiki taq.</para>
  <para style="q">Eh ruum taq inaq'or re' re', naa nuq'atam i q'orik taq cha naah.</para>
  <para style="q">
    <verse number="36" style="v" />Eh ¿Chib'ih reet noq tokoom chik inooj taq asik' atoob'jiik</para>
  <para style="q">tiooj taq kuuk' i aj Egipto? xa re' la' naa ruk'uhtjiik taq chaak'ixb'ilaal ar,</para>
  <para style="q">je' rukab' noq xk'uhtjik taq chaak'ixb'ilaal Asiria.</para>
  <para style="q">
    <verse number="37" style="v" />Re' taq i hat yohb'aal taq wach ak'ixiik noq naa taq aweliik cho Egipto</para>
  <para style="q">ruum re' hin naa wesam i kajaawriik awach naq aj uuk' naa rojiik asik'im atoob'jiik.</para>
  <para style="q">Re' keh xama' naa ta wo' taq kaat kesam panti' k'axik, inki i Dios.</para>
  <chapter number="3" style="c" />
  <para style="s">Re' taqe i aj Israel xkian i ma' holohik taj chuwach i Dios</para>
  <para style="q">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or keh i aj Israel:</para>
  <para style="q">Wila' re' ixoq xuch'aq riib'</para>
  <para style="q">ruuk' i rub'ahiil,</para>
  <para style="q">eh nee wo' chik i rub'an</para>
  <para style="q">kaxáro ruuk' tokoom winaq.</para>
  <para style="q">Re' i peet rub'ahiil ma' nee ta chik i rub'an chi neensutinik cho ruuk'</para>
  <para style="q">ruum wixsutinik chaloq k'ixb'ilaal chi reh i tinamit.</para>
  <para style="q">Raaj taq i hat aj Israel i xa a'n taq je' k'oyomal kuuk' i tokoom,</para>
  <para style="q">xa konee wo' taq ti nuk'ul wuuk', inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' taq i hat ti tz'ehtanoq taq chikinaah i yuuq',</para>
  <para style="q">nee taq inawil mi wilik reh i ye'aab' re' re'</para>
  <para style="q">ma' xa a'n ta taq wii' i je' k'oyomal.</para>
  <para style="q">Re' taq i hat xanutzunaa' taq chik awiib' chii' b'eeh chub'aan.</para>
  <para style="q">Eh xach'uwarisaj taq paam aatinamiit ruuk' i je' k'oyomal,</para>
  <para style="q">ruuk' i yiib' wach na'ojb'al taq xa a'n.</para>
  <para style="q">
    <verse number="3" style="v" />Eh ruum taq i xa a'n re' re' ma' rub'an ta chik i peet jab',</para>
  <para style="q">je' wo' i jab' i rub'an koq'uun.</para>
  <para style="q">Eh k'ixb'ilaal taq xat b'anik,</para>
  <para style="q">je' taq akab' i k'oyoom laj ixoq.</para>
  <para style="q">
    <verse number="4" style="v" />Eh je' taq wili inaq'or:</para>
  <para style="q">Hat manlik wajaaw toob'en qeh pan qak'ijolal, tiki taq weh.</para>
  <para style="q">
    <verse number="5" style="v" />¿Mi ma' jaruuj chik naa awesam re' aajosq'iil chi qanaah? tiki taq weh.</para>
  <para style="q">Eh noq k'ahchi' taq aq'orom taqe re' xa nach'ikaa' taq chik ak'ux</para>
  <para style="q">chub'anariik taqe i yiib' wach na'ojb'al, inki Dios.</para>
  <para style="s">Re' i Dios xuq'or keh i aj Israel, i aj Judá chi naa kiyot'om i kik'ux chi riij i kimahk</para>
  <para style="p">
    <verse number="6" style="v" />Re' i QaJaaw Dios je' wili i xuq'or weh, noq xwihik chi reyil Josías ar Judá: ¿Mi ma' xawilow re' i hat i xkian i aj Israel i ma' kinimanik ta weh? Re' keh xiooj chinaah taqe i yuuq' chi ri'sil taqe nimaq chee' chub'anariik i je' k'oyomal. <verse number="7" style="v" />Re' hin xnukapaaj naq chi naa wo' chik kiin kinimam noq kianam chik taqe i yiib' wach na'ojb'al. Eh xama' xinkinimaj ta wo' chik. Eh re' taqe i aj Judá ma' korik ta wach kik'ux, xkilow wo' naq i re'. <verse number="8" style="v" />Eh xkilow wo' naq i aj Judá chi xnuq'eb' chi riij nuk'ux taqe i aj Israel ruum i je' k'oyomal xkian, xnukanaa' taqe chi kutkeel. Xa re' la' re' taqe i aj Judá kichaaq' kiib' kuuk' i aj Israel, xama'xiyo'jik ta wo' hoq, xkian la' wo' chik i je' k'oyomal i keh. <verse number="9" style="v" />Re' keh ma' k'axik ta noq xkich'uwa'risaj paam i kitinamiit, ma' xkian taj i korik chi nuwach. Re' la' chik inche taqe i tiyoox ab'aj, chee' kiyej-aal xkiloq'ej. <verse number="10" style="v" />Eh noq b'anooj chik taqe re', re' taqe i aj Judá ma' kinimanik ta weh xama' xinkinimaj ta wo' hoq. Je' tii chik xintohq'ik kinimam xkian kiib' xa re' la' xama' korik ta wo' keh, inki Dios.</para>
  <para style="p">
    <verse number="11" style="v" />Eh je' wo' chik wili i xuq'or weh: Re' taqe i aj Israel ma' kinimanik ta weh xa manlik i kimahk i keh chikiwach taqe i aj Judá ma' korik ta wach kik'ux wuuk'. <verse number="12" style="v" />Hiy tiz'ehtanoq reje pansak'aaj reh i rookb'aal i q'iij je' wili i cha q'or:</para>
  <para style="b" />
  <para style="q">Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' taq i hat aj Israel i ma' tinimanik ta taq weh,</para>
  <para style="q">kinanimaj wo' taq chik,</para>
  <para style="q">re' hin ma' pank'aah ta nee taq ti nuk'ul reje,</para>
  <para style="q">eh ma' naa ta nuye'em i nujosq'iil taq cha naah chi juneliik</para>
  <para style="q">ruum q'e' hin aj keteloom wachiis, inki.</para>
  <para style="q">
    <verse number="13" style="v" />Xa re' chanab'eej taq chi xa a'n taq i ma' holohik taj chi nuwach,</para>
  <para style="q">ma' xinanimaj ta taq i hin. Tokoom la'</para>
  <para style="q">chik taq xaloq'ej, chi ri'sil taqe i nimaq chee',</para>
  <para style="q">ma' xanimaj ta taq i xnuq'or aweh i hin,</para>
  <para style="q">tiko'q keh, inki i Dios.</para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" />Eh je' wo' chik wili i xuq'or: Re' taq i hat ma' tinimanik ta taq, hin taq kinehchanik aweh kim wo' taq chik wuuk'. Re' hin ju'jun i naa nusik'im kiwach chupaam i ju'jun chi tinamit. Eh ka'kab' i naa nusik'im wach kuuk' i ju'jun chi patineel, naa nuk'amam taqe reje Sión. <verse number="15" style="v" />Re' hin naa nukojom taq k'amal aab'eeh je' rukab' i naa ruchaliik panuk'ux i hin, reh chi parub'ehel, eh ruuk' holohik laj na'ojb'al naa taq kaat kicha'jeem. <verse number="16" style="v" />Eh noq naa kik'ihaaxb'iik taq awak'uun awixq'uun chupaam taq aatinamiit, ma' awach ta chik naa ruq'oriik rib'iral i kaxoon moloj wii' i tz'ihb'amaj wii' i k'uhb'aal. Ma' awach ta chik naa rukapeb'iniik reh, ma' naa ta chik ruk'uliik pank'uxliis, ma' naa ta kesam i rajaawriik, eh ma' naa ta wo' chik kiyejaam jino'q i ak'. <verse number="17" style="v" />Ruum chupaam taqe i q'iij re' re', ruye'aab' i QaJaaw Dios naa rubíhnaam i Jerusaleem. Eh chu'nchel i tinamit naa ruchaliik kimolom kiib' ar reh i ruye'ariik nuloq'il, ma' naa ta chik kianam i yiib' wach na'ojb'al inchalik pankik'ux.</para>
  <para style="p">
    <verse number="18" style="v" />Eh noq naa ruponiik taqe i q'iij re' re', re' taqe i aj Judá naa kianam jinaj kiwach kuuk' i aj Israel junchaliik taqe noq naa kichaliik chupaam i ye'aab' wilik reje pantz'eet reh i rookb'aal q'iij, re' i xnuyeew cho chi kikooch aamaam awati't.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Hat taq aj Israel, re' hin xatnuk'ul</para>
  <para style="q">wo' naq taq chi wak'uun wixq'uun,</para>
  <para style="q">naa naq nuye'em taq aweh i ye'aab' k'axb'al wach,</para>
  <para style="q">je' wo' i tinamit xiik' naah holwochiil.</para>
  <para style="q">Re' hin xnukapaaj naq chi naakiin akojom taq chi awajaaw,</para>
  <para style="q">eh chi ma' jaruuj chik taq naa kiin akanaam.</para>
  <para style="q">
    <verse number="20" style="v" />Xa re' la' re' taq i hat xa a'n taq aweh</para>
  <para style="q">je' rukab' i rub'an ixoq ma' korik ta wach ruk'ux</para>
  <para style="q">i ruq'eb' i rub'ahiil,</para>
  <para style="q">je' re' noq xinaq'eb' taq chi riij ak'ux,</para>
  <para style="q">inki QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Eh je' wo' chik wili i xuq'or:</para>
  <para style="q">Re' taqe i xkiq'eb' chi riij kik'ux nunimjiik i hin,</para>
  <para style="q">x-ib'irjik i noq k'erik cho kichii' chinaah taqe i yuuq'</para>
  <para style="q">chupahqaljiik kitoob'jiik reh chi naa wo' chik nuketelaam kiwach.</para>
  <para style="q">
    <verse number="22" style="v" />Re' taq i hat wak'uun wixq'uun ma' tinimanik ta taq kinanimaj wo' taq chik.</para>
  <para style="q">Re' hin nee taq tiwiq'omaaj ruuk' ati'kiil re' re', inki Dios.</para>
  <para style="b" />
  <para style="q">Eh re' taqe i aj Israel je' wili i xkiq'or: Jaaw ayu' wilkooj xoj chalik awuuk'</para>
  <para style="q">ruum re' hat i qaDios.</para>
  <para style="q">
    <verse number="23" style="v" />Re' hoj xqakoj rehtaal chi xama' xta rutiq qeh</para>
  <para style="q">chi qoh hoj nah taq yuuq' chi kilooq'jiik taqe i tiyoox,</para>
  <para style="q">eh chi nqak'er qachii' chinaah i yuuq'.</para>
  <para style="q">Eh qeht'al wo' naq chi awuuk' hat QaJaaw Dios inqareq ko'lemb'al qiib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Eh ruum taqe i yiib' wach loq'inik tiyoox xqa a'n pan qak'ijolal xqaq'eb'</para>
  <para style="q">taqe i xkiyejaa' cho wach i qatuut qajaaw,</para>
  <para style="q">kak'uun kixq'uun, i kitentzuun, i kiwakax.</para>
  <para style="q">
    <verse number="25" style="v" />Re' hoj ma' k'isiin taj i qak'ixiik</para>
  <para style="q">noq xchalik qaloch' qiib' chawach.</para>
  <para style="q">Ruum re' taqe i qamaam qati't ximahkunik wo' chawach,</para>
  <para style="q">eh re' hoj kopan qak'isinal xqatoq'aa' cho mahkunik,</para>
  <para style="q">eh yu'naak xakok'ahchi' wo' kooj chawach i hat QaJaaw Dios,</para>
  <para style="q">korik wo' hoq chi ma' tiqanimaj taj, inki taqe.</para>
  <chapter number="4" style="c" />
  <para style="s">Re' Dios kow xuq'or keh i aj Israel chi naa wo' chik runimjiik</para>
  <para style="q">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili xuq'or keh i aj Israel:</para>
  <para style="q">Wila' naa wo' chik asutiniik taq cho wuuk'.</para>
  <para style="q">Eh wila' xakanaa' taq kinimjiik taqe tiyoox yiib' kiwach,</para>
  <para style="q">wila' ma' xinakanaa' taq chik.</para>
  <para style="q">
    <verse number="2" style="v" />Chi je' re' naa taq aq'orom i nub'ihnaal ruuk' i korik,</para>
  <para style="q">ruuk' i rub'ehel, ruuk' i rukorkiil.</para>
  <para style="q">Eh naa rukahniik chi wuum i hin naakik'ulum i wotob'il chu'nchel i tinamit,</para>
  <para style="q">naakiye'em nuloq'il ruuk' kitz'uuy, tiko'q taq.</para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" />Eh re' i QaJaaw Dios je' wili i xuq'or keh i aj Judá, i aj Jerusaleem:</para>
  <para style="b" />
  <para style="p">Chayejaa' taq awánima chi korik,</para>
  <para style="q">je' rukab' noq inyejeb'jik ak'al intikarik wii' i tik mo-oq je' pank'iix taq neenatik.</para>
  <para style="q">
    <verse number="4" style="v" />Hat taq aj Judá, hat taq aj Jerusaleem,</para>
  <para style="q">chawesaj taq i ch'uwa' panawánima.</para>
  <para style="q">Chayeew taq panawánima i nuk'uhb'aal.</para>
  <para style="q">Ruum wila' ma' xakanaa' taq rub'aan ayiib' wach na'ojb'al</para>
  <para style="q">naa nuye'em i nujosq'iil taq cha naah chi xa je' chik inqop xaq q'aaq'</para>
  <para style="q">ma' awach ta chik neenchupwik reh, inki.</para>
  <para style="s">Re' i tinamit Judá xq'orarik chi naa ruchopariik naah kuum i aj ixowaal</para>
  <para style="q">
    <verse number="5" style="v" />Re' i QaJaaw Dios je' wili i xuq'or weh:</para>
  <para style="q">Chaq'or keh i aj Jerusaleem, i aj Judá chi kixulej i kituun,</para>
  <para style="q">chi kik'er kichii' chuq'orariik chi je' wili chupaam chu'nchel i tinamit:</para>
  <para style="q">Yu'naak naa rojiik qamolom qiib' chupaam taqe i tinamit</para>
  <para style="q">kotimaj kiij chi tz'aq ko'lemb'al kiib'.</para>
  <para style="q">
    <verse number="6" style="v" />Chajosaj taq i rehtalil chi korkiil i Sión,</para>
  <para style="q">hiy taq cha sik' chi jumehq'iil aha' taq naa ako'leem awiib',</para>
  <para style="q">ruum re' hin pantz'eet reje reh i rookb'aal q'iij,</para>
  <para style="q">naa nuk'amam chaloq i naa rusachwiik taq awach.</para>
  <para style="q">
    <verse number="7" style="v" />Re' i je' josq'laj kaq b'ahlam xelik chik chaloq paruye'aab',</para>
  <para style="q">chalik chik i rub'an insachwik kiwach taqe i tinamit.</para>
  <para style="q">Re' reh xchalik chi rusachariik wach taq aatinamiit,</para>
  <para style="q">reh chi naa rukanaam chi ma' xta chik k'isinoq wilik chupaam.</para>
  <para style="q">
    <verse number="8" style="v" />Ruum aj re', re' taq i hat chakoj taq chawiij i q'as wach itz'ihy,</para>
  <para style="q">cha k'er taq aachii' ruum i ruti'kiil taq ak'ux,</para>
  <para style="q">ruum re' i runimaal rujosq'iil</para>
  <para style="q">i QaJaaw Dios komajaa' taq i nik'ik chawiij.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' i QaJaaw Dios je' wili i ruq'or:</para>
  <para style="q">Noq naa ruponiik i q'iij re' re',</para>
  <para style="q">re' i reey, re' taqe i k'amal b'eeh,</para>
  <para style="q">re' taqe i k'amal kib'eeh aj tiij,</para>
  <para style="q">re' taqe i jalal naq nuq'oral xanaa chik kib'arb'otiik ruum kiyo'jiik, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Eh re' hin je' wili i xnuq'or reh:</para>
  <para style="q">Jaaw q'e' wo' chik ti' naa ab'aniik re' hat xachuk i q'orik keh i aj Jerusaleem,</para>
  <para style="q">ruum re' hat xaq'or keh chi naa taqe aye'em pan suq laj wihik,</para>
  <para style="q">eh yu'naak je' naa ayohq'eem kich'ihch'aal reh i kikanteesjiik, kinki reh.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Eh noq naa ruponiik taqe i q'iij re' re'</para>
  <para style="q">je' wili i naa ruq'orariik keh i aj Jerusaleem:</para>
  <para style="q">Jinaj i runimaal teew naa reliik chaloq panchiq yuuq'</para>
  <para style="q">naa ruchaliik chinaah i nutinamiit.</para>
  <para style="q">Re' re' ma' xata je' rukab' i teew inkamanik chi puhb'al wach i trigo.</para>
  <para style="q">
    <verse number="12" style="v" />Je' re' noq re' teew naa nuye'em chaloq i hin xiik' naah kowiil chuwach i re',</para>
  <para style="q">chupaam aj re' i q'iij re' re' naa nuye'em taqe chutojariik i kimahk, inki.</para>
  <para style="q">
    <verse number="13" style="v" />Re' i kikareta taqe aj ixowaal xa je' chik kowiil</para>
  <para style="q">i rub'an i suutz' noq naa kik'uliik iloq,</para>
  <para style="q">eh re' i kikawayu xakow chik inki a'n</para>
  <para style="q">xa je' chik kowiil i rub'an i kaq suut teew, eh ma' xata je' kowiil kirupinik i xihk.</para>
  <para style="q">Xa re' la' q'e' ti' i naa qak'ulum taq awuum.</para>
  <para style="q">
    <verse number="14" style="v" />Re' taq i hat aj Jerusaleem</para>
  <para style="q">chawesaj taq i ch'uwa' wach wilik panawánima</para>
  <para style="q">chi je' re' nee taq tiko'ljik.</para>
  <para style="q">Eh ¿Kojaruuj taq inakanaa' rukapeb'jiik taqe i yiib' wach na'ojb'al?</para>
  <para style="q">
    <verse number="15" style="v" />Jinaj i ak' laj q'orik xchalik rib'iral chupaam i ye'aab' Dan,</para>
  <para style="q">chupaam i ye'aab' Efraim xchalik ruq'orariik chi k'ulik iloq reh</para>
  <para style="q">i runimaal ti' k'axik taq cha naah.</para>
  <para style="q">
    <verse number="16" style="v" />Chaq'or keh i nimaq tinamit,</para>
  <para style="q">je' wo' keh i aj Jerusaleem chi chupaam</para>
  <para style="q">i jinaj tinamit wilik chaloq chi najt xi chalik i aj ixowaal.</para>
  <para style="q">Eh k'erlik kichii' chuq'orariik</para>
  <para style="q">i q'aq'inik noq naa kik'uliik iloq chikinaah i aj Judá.</para>
  <para style="q">
    <verse number="17" style="v" />Naakikotem riij i tinamit Judá</para>
  <para style="q">naa kianam reh je' rukab' noq incha'jaljik jino'q i ye'aab'.</para>
  <para style="q">Naa rub'an keh ruum xkikanaa' nunimjiik,</para>
  <para style="q">inki QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Je' re' i ti' k'axik naa ruchaliik taq cha naah</para>
  <para style="q">ruum taq ayiib' wach na'ojb'al,</para>
  <para style="q">eh konaa ruponiik taq panawánima i ruti'kiil, inki.</para>
  <para style="s">Re' Jeremías xtib'ik ruk'ux ruum i xuk'ul i rutinamiit</para>
  <para style="q">
    <verse number="19" style="v" />Re' hin xan yot'ik chik i wánima, eh xankurkutik chik,</para>
  <para style="q">xama' nureq ta chik chi riij chib'ih i naa nub'anam,</para>
  <para style="q">re' hin wilik i naa nuq'orom chi riij,</para>
  <para style="q">ruum xb'iraj chik chi xuuljik chaloq i tuun</para>
  <para style="q">eh xak'erik chik kichii' i aj q'aq'ineel k'ulik inki a'n iloq.</para>
  <para style="q">
    <verse number="20" style="v" />Eh k'ahchi' chik qib'iram rib'iral chi naa rusachariik wach i qatinamiit</para>
  <para style="q">xa chi jumehq'iil xsacharik kiwach i tinamit,</para>
  <para style="q">nee-oq inkisach wach</para>
  <para style="q">i paat inqamol wii' qiib', je' wo' i itz'ihy naah paat qoh hi'lik wii'.</para>
  <para style="q">
    <verse number="21" style="v" />Eh ¿Kojaruuj i numay rilariik chi kijosam taxaaj i rehtalil i q'aq'inik?</para>
  <para style="q">¿Kojaruuj i numay rib'irjiik chi k'ahchi' ruxuljiik i tuun?</para>
  <para style="q">
    <verse number="22" style="v" />Re' taqe i wili k'achi' ruk'ulariik ruum re' taqe i nutinamiit</para>
  <para style="q">ma' kinkib'iraj taj ma' kinkinimaj taj,</para>
  <para style="q">ma' xta kina'ojb'al chub'anariik i holohik.</para>
  <para style="q">Xa re' la' i yiib' wach na'ojb'al kichol rub'aan, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Re' hin xwilow i wach ak'al chi ma' tuslik ta wach, chi ma' xta i wilik chupaam.</para>
  <para style="q">Eh xwilow i taxaaj chi ma' xta i saqum wilik chupaam.</para>
  <para style="q">
    <verse number="24" style="v" />Eh xwilow taqe inajt kinaah yuuq' chi xakib'arb'otik chik ruum kiyo'jiik,</para>
  <para style="q">eh xwilow chi chu'nchel i rub'ohl yuuq' xsacharik kiwach.</para>
  <para style="q">
    <verse number="25" style="v" />Eh xwilow chi ma' jino'q chik i k'achareel wilkeeb' chinaah i wach ak'al</para>
  <para style="q">re' taqe i chikop wilik kixiik' xkimol chi elik.</para>
  <para style="q">
    <verse number="26" style="v" />Eh xwilow chi re' taqe i rax paam ye'aab'</para>
  <para style="q">xi kahnik chi xa je' chik chiq yuuq',</para>
  <para style="q">xwilow chi chu'nchel i tinamit xsahchik kiwach.</para>
  <para style="q">Eh re' i QaJaaw Dios xb'anik taqe re' ruum i runimaal i rujosq'iil.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Chu'nchel i tinamit naa wik'sam chi ti' k'axik,</para>
  <para style="q">xa re' la' ma' naa ta nusacham wach chi jumpech.</para>
  <para style="q">
    <verse number="28" style="v" />Eh chupaam chu'nchel i wach ak'al naa runujiik i ruti'kiil k'uxliis,</para>
  <para style="q">re' i taxaaj naa ruq'equumriik paam.</para>
  <para style="q">Re' wili korik re' hin xinq'orik ma' nee ta chik i nuyoj,</para>
  <para style="q">ma' nee ta chik i nusutej chi riij i nuq'oral.</para>
  <para style="q">
    <verse number="29" style="v" />Noq xkib'iraj i tinamit chi k'erlik kichii'</para>
  <para style="q">taqe i k'ulik inki a'n iloq rij kawáyu ruch'ihil taqe i wilik cho kiflecha kuuk'</para>
  <para style="q">ma' k'isiin ta xiyo'jik xiooj lom kajiim xkikeb'aa' kiib' pantaq ch'ahn,</para>
  <para style="q">pantaq ruhopil ab'aj.</para>
  <para style="q">Ruum taqe re' xkahnik chi ma' xta chik wilik chupaam taqe i tinamit.</para>
  <para style="q">Eh xkahnik chi ma' jino'q chik patineel chupaam.</para>
  <para style="q">
    <verse number="30" style="v" />Re' taq aatinamiit naa rusachariik wach,</para>
  <para style="q">xama' xta nkih chi nakoj taq i holohaq itz'ihy,</para>
  <para style="q">chi naxoyej taq awiib' ruuk' oro.</para>
  <para style="q">Eh xama' xta nkih chi natz'ihb'aaj taq i rij naq'awach,</para>
  <para style="q">ruum awach aj uuk' taq xa a'n i je' k'oyomal</para>
  <para style="q">xat kiq'eb' taq chi riij kik'ux</para>
  <para style="q">akanteesjiik taq chik inkaaj.</para>
  <para style="q">
    <verse number="31" style="v" />Re' hin xb'iraj i jinaj i k'erej chi'is je' rukab' noq i ruk'er chii' ixoq</para>
  <para style="q">noq ink'ulik ruk'ux ruuk' i peet ruha'lak'uun.</para>
  <para style="q">Re' taqe i k'erik kichii' re' re',</para>
  <para style="q">re' taqe i aj Siónoq'ik inki a'n</para>
  <para style="q">inkiyub' chaloq i kiq'ab' je' wili inkiq'or:</para>
  <para style="q">Xti q'e' wo' chik ti' i k'ahchi' qak'ulum</para>
  <para style="q">naakooj kikansam taqe i aj i kaansoom, inki taqe, inki.</para>
  <chapter number="5" style="c" />
  <para style="p">Re' i mahk xkian i aj Jerusaleem.</para>
  <para style="q">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Yu'naak hiy taq cha sik'</para>
  <para style="q">chi korik pantaq b'eeh reh i Jerusaleem</para>
  <para style="q">nee oon inareq taq jino'q imb'anik reh i korik eh korik inq'orik.</para>
  <para style="q">Eh wila' xareq taq jino'q</para>
  <para style="q">neenukuy kimahk i aj Jerusaleem.</para>
  <para style="q">
    <verse number="2" style="v" />K'achlik i QaJaaw Dios inki, inki wo' naq taqe.</para>
  <para style="q">Xa re' la' ma' korik ta wo' keh inkiq'or inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />QaJaaw Dios, re' inasik' i hat re' taqe i korik wach kik'ux.</para>
  <para style="q">Korik wo' hoq chi xa a'n ti' k'axik keh,</para>
  <para style="q">xayoj wach i kitinamiit, eh xama' xokik ta wo' kina'ojb'al.</para>
  <para style="q">Q'e' kow i kinaah je' kowiil ab'aj,</para>
  <para style="q">ma' nkaaj ta chik sutinik chupaam i holohik laj b'eeh.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' hin je' wili i xnuq'or chikiij:</para>
  <para style="q">Re' taqe i wili q'e' ketel kiwach</para>
  <para style="q">ma' xta kina'ojb'al,</para>
  <para style="q">ruum ma' nkireq ta chi riij i nuq'or chi naa kianam.</para>
  <para style="q">
    <verse number="5" style="v" />Eh xuq'oreej wo' naq taqe i nimaq wach kina'ojb'al,</para>
  <para style="q">ruum xnukapaaj naq i hin chi nkireq chi riij iraaj i QaJaaw Dios.</para>
  <para style="q">Xa re' la' chi kunchelaal wo' keh kija'wachej kiib'</para>
  <para style="q">chuwach i QaJaaw Dios, xama' xkaaj ta wo' kinimam.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' taqe i aj ixowaal</para>
  <para style="q">naa rusachwiik kiwach xa je' chik kijosq'iil kaq b'ahlam kielik chaloq paraxchee'.</para>
  <para style="q">Eh xa je' chik kikab' i xojb' kichalik panchiq yuuq',</para>
  <para style="q">eh naa kichaliik chinaah taq aatinamiit</para>
  <para style="q">chi je' kijosq'iil nimaq taq b'ahlam, naa taq kisachib'eem awach.</para>
  <para style="q">Ruum yohb'aal taq wach aamahk, eh xa a'n taq ma' imponik ta chi nuwach, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¿Nik' wach noq naa nukuyum taq aamahk re' re'?</para>
  <para style="q">Re' taq awak'uun awixq'uun xin kiq'eb' chi riij kik'ux,</para>
  <para style="q">inkiq'or i korik pankib'ihnaal i tiyoox ma' re' ta wo' taqe Dios.</para>
  <para style="q">Eh xnuyeew wo' naq kiwa' kihaa',</para>
  <para style="q">xa re' la' xama' xkian ta wo' korik,</para>
  <para style="q">pankomonil la' xkian i je' k'oyomal.</para>
  <para style="q">
    <verse number="8" style="v" />Re' keh xa je' chik kikab' imas kawáyu k'achi' chik'onik</para>
  <para style="q">noq kiooj chi q'uchariik i rehk'een i kas kichaaq'.</para>
  <para style="q">
    <verse number="9" style="v" />¿Mi ma' naa nuye'em taqe</para>
  <para style="q">chi tojariik re' i kimahk ruum inki a'n re' re'?</para>
  <para style="q">¿Mi ma' ruk'ul chi naa nuye'em taqe chutojariik i kimahk re'</para>
  <para style="q">i tinamit re' re'?</para>
  <para style="q">
    <verse number="10" style="v" />Eh re' taqe i aj ixowaal,</para>
  <para style="q">naa taq kisacham awach, atoob' ta ma'</para>
  <para style="q">chawunchelaal ta taq i hat taq nu uuva noq wilkaat.</para>
  <para style="q">Xa re' wo' taqe i ma' holohik taj kina'ojb'al naa kesam iloq,</para>
  <para style="q">re' taqe i ma' re' ta taqe weh.</para>
  <para style="q">
    <verse number="11" style="v" />Re' i tinamit Israel, ruch'ihil i tinamit Judá</para>
  <para style="q">tokoom chik i xkikoj chi ki dios</para>
  <para style="q">chi nuwach i hin, inki QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' taqe aj Israel, i aj Judá</para>
  <para style="q">ma' xkinimaj taj i xuq'or i Dios je' wili i xkiq'or:</para>
  <para style="q">Re' hoj ma' xta ti' k'axik, ma' xtakaansanik,</para>
  <para style="q">ma' xta wi'jaleel naa ruchaliik chi qanaah, inki taqe.</para>
  <para style="q">
    <verse number="13" style="v" />Re' taqe i jalal naq nuq'oral naa kikahniik chi xa je' taqe teew</para>
  <para style="q">xama' re' ta wo' hoq i nuq'oral i hin</para>
  <para style="q">naa kiq'orom je' re' naa rub'aan kuuk'.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' i QaJaaw Dios nim rajaawriik, je' wili i xuq'or:</para>
  <para style="q">Re' taqe i tinamit ruum chi</para>
  <para style="q">xkiq'or taqe q'orik re' re'</para>
  <para style="q">naa nuye'em panachii' i nuq'oral chi je' jinaj q'aaq'.</para>
  <para style="q">Eh naa kikahniik chi je' rukab' i sii'</para>
  <para style="q">noq ink'ahtik inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Re' taq i hat aj Israel naa nuk'amam taqe</para>
  <para style="q">chaloq chi najt tinamit taqe i aj ixowaal</para>
  <para style="q">q'e' kow kiib' re' ruuk' taqe i najtir tinamit.</para>
  <para style="q">Eh ma' aweht'al ta taq nik' wach kiq'orik,</para>
  <para style="q">eh ma' naa ta taq areqem chi riij i naa kiq'orom taq aweh.</para>
  <para style="q">
    <verse number="16" style="v" />Eh chu'nchel taqe re' kowlaj q'aq'ineel taqe,</para>
  <para style="q">xa re' ikaansanik inki a'n ruuk' inkikoj chi kantesb'aal.</para>
  <para style="q">
    <verse number="17" style="v" />Re' chik i keh naakik'uxwiik reh taq aakaxlanwi'k,</para>
  <para style="q">naa kisacham wach awak'uun awixq'uun.</para>
  <para style="q">Eh naa kik'uxum taqe aatentzuun,</para>
  <para style="q">taqe i awaakaax, taqe aa-uuva, taqe a higo.</para>
  <para style="q">Eh ruuk' i q'aslaj ch'ihch' naa kisacham wach taq</para>
  <para style="q">aatinamiit i wilik inkiko'leej wii' kiib'</para>
  <para style="q">re' inach'ikaa' naq wii' ak'ux taq i hat.</para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" />Xa re' la' chupaam taqe i q'iij re' re' ma' naa ta nuye'em q'ab' chi naa rusachariik taq awach chi jumpech. <verse number="19" style="v" />Eh noq neenkipahqaaj aweh chi je' wili: ¿Chib'ih reet noq xub'an qeh chi je' wili i QaJaaw Dios inko'q taqe aweh? Re' i hat je' wili ruchaq'weesjiik naa a'nam: ¿Nik' wach noq xakanaa' taq runimjiik? re' chik taqe i ki dios i tokoom tinamit taq xaloq'ej pan aatinamiit je' wo' chik re' naa taq a'nam panatinamiit inkaaj i tokoom tinamit, inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Re' i hat cha q'or keh chi je' wili chu'nchel i aj Israel</para>
  <para style="q">re' taqe i riih rumaam Jacob, je' wo' keh i aj Judá:</para>
  <para style="q">
    <verse number="21" style="v" />Chab'iraj taq i hat tinamit ma' xta taq ana'ojb'al, ma' ti ib'irinik ta taq,</para>
  <para style="q">wilik wo' naq taq naq'awach, xama' ti ilwik ta wo' taq,</para>
  <para style="q">wilik wo' naq taq axikin xama' ti ib'irinik ta wo' taq.</para>
  <para style="q">
    <verse number="22" style="v" />Re' hin i Dios je' wili nuq'or: Re' taq i hat ma' kinayohleej ta taq,</para>
  <para style="q">ma' chalik ta taq ab'arb'otiik chi nuwach.</para>
  <para style="q">Re' hin xnukoj i q'atb'al chii' i palaw.</para>
  <para style="q">Atoob' ta yohb'aal wach i rub'ohl xan teleninik chik,</para>
  <para style="q">xama' rik'saj ta wo' reje q'atb'al chii' nukojom.</para>
  <para style="q">
    <verse number="23" style="v" />Raaj taq i hat ma' tinimanik ta taq k'isinoq,</para>
  <para style="q">xiik' naah kowiil taq awánima xinaq'eb' taq chi riij ak'ux chi jumpech.</para>
  <para style="q">
    <verse number="24" style="v" />Eh ma' xaq'or ta taq chi je' wili:</para>
  <para style="q">Qanimaj i QaJaaw Dios, chi je' re' manlik paruq'ijil</para>
  <para style="q">nee ruyeew cho qeh i peet jab', eh nee ruyeew cho qeh i xam jab'.</para>
  <para style="q">Eh nee ruyeew q'ab' qeh chi neenqajach</para>
  <para style="q">i wach qatik paruq'ijil, ma' tiki ta taq.</para>
  <para style="q">
    <verse number="25" style="v" />Xa re' la' re' taq i hat ruum taq amahk i na a'n</para>
  <para style="q">ma' na a'n ta taq rusuqkiil i wotob'il re' re'.</para>
  <para style="q">
    <verse number="26" style="v" />Ruum chaxilak taq i hat nutinamiit wilkeeb' taqe i yiib' wach kina'ojb'al,</para>
  <para style="q">kiooj chukanteesjiik i kas kichaaq' je' inkanteesjik chikop inki a'n</para>
  <para style="q">Eh inki a'n reh i kas kichaaq', je' rukab' noq inkojarik kixirob'aal taqe i tz'ikin.</para>
  <para style="q">
    <verse number="27" style="v" />Re' keh inkinujisaj i kipaat ruuk' i xa chib'ih jariik inkelq'aaj</para>
  <para style="q">xa je' chik inhamarik kok' tz'ikin pankok' kaxoon koraal inki a'n</para>
  <para style="q">Ruum i re' xnimb'ik kiwach, eh xib'ehoomb'rik.</para>
  <para style="q">
    <verse number="28" style="v" />Eh xiik' naah kiq'ina'iil ruum inkik'uxlaaj kiib' chi korik.</para>
  <para style="q">Re' i yiib' wach na'ojb'al inki a'n ma' pajooj taj.</para>
  <para style="q">Eh ma' nkitoob'eej ta taqe i ma' xta kituut kajaaw,</para>
  <para style="q">ma' nkiyeew ta q'ab' reh taqe i neb'aa'</para>
  <para style="q">chi neenkian aha' wilik i ruk'ul chi keh.</para>
  <para style="q">
    <verse number="29" style="v" />¿Mi ma' naa nuye'em taqe chutojariik re' kimahk?</para>
  <para style="q">¿Mi ma' ruk'ul re' chi nee nuq'aj wach keh je'</para>
  <para style="q">rukab' i ruk'ul chi keh? inki i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Xti korik wo' hoq chi yohb'aal wach,</para>
  <para style="q">eh ti yo'joq ruum i k'achi' ruk'ulariik panutinamiit.</para>
  <para style="q">
    <verse number="31" style="v" />Re' taqe i jalal naq nuq'oral re' chik i chukuj q'orik inkiq'or.</para>
  <para style="q">Re' taqe i k'amal b'eeh aj tiij inkik'am rub'eeh</para>
  <para style="q">i tinamit chi je' rukab' inkaaj i keh.</para>
  <para style="q">Re' taq i hat nutinamiit je' taq re' imponik chawach.</para>
  <para style="q">¿Chib'ih taq i naa a'nam na' chaloq i ti' k'axik? inki i Dios.</para>
  <chapter number="6" style="c" />
  <para style="s">Re' taqe i aj ixowaal xkikotej riij i tinamit Jerusaleem</para>
  <para style="q">
    <verse number="1" style="v" />Re' taq i hat aj Benjamín,</para>
  <para style="q">eleen taq reje Jerusaleem.</para>
  <para style="q">Eh chaxulej taq reje i tuun chupaam i tinamit Tecoa.</para>
  <para style="q">K'utinoq i sib' taxaaj chupaam i ye'aab' Bet-haquerem,</para>
  <para style="q">ruum re' taqe i aj ixowaal xi k'uloq i pantz'eet reh i rookb'aal q'iij</para>
  <para style="q">chub'anariik i runimaal ti' k'axik.</para>
  <para style="q">
    <verse number="2" style="v" />Re' tinamit Sión xa je' naq chik rukab' taqe i holohaq laj xq'un</para>
  <para style="q">xa re' la' naa rusachariik kiwach.</para>
  <para style="q">
    <verse number="3" style="v" />Re' taqe i je' cha'jen tentzun yiib' wach i kina'ojb'al naa rucha'jiniik keh.</para>
  <para style="q">Naa kiyejaam ki-itz'ihy naah paat chi junsuut i tinamit Sión,</para>
  <para style="q">eh naakicha'jeem i je' kitentzuun chi kiju'junaal.</para>
  <para style="q">
    <verse number="4" style="v" />Re' taqe i aj ixowaal je' wili inkiq'or:</para>
  <para style="q">Qayejaa' taq qiib' taq taq q'aq'ineel kuuk',</para>
  <para style="q">kim taq naa rojiik qa'nam keh kab'lajora i q'iij.</para>
  <para style="q">Xa re' la' q'e' ti' inqik'raaj ruum xokik chik i q'iij,</para>
  <para style="q">xokik chik chaloq i q'equm.</para>
  <para style="q">
    <verse number="5" style="v" />Eh qachop taq qak'ux chi chaq'ab' neeqa a'n keh,</para>
  <para style="q">neenqasach wach inajt kinaah tz'aq inkiko'leej wii' kiib', inki taqe.</para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" />Re' i QaJaaw Dios nim rajaawriik je' wili i xuq'or keh i aj ixowaal:</para>
  <para style="b" />
  <para style="q">Chayok' taq i chee' reh chi nee taq inayejaa' awiik'b'aal</para>
  <para style="q">noq nee taq inooj a a'n keh i aj Jerusaleem.</para>
  <para style="q">Ruum re' tinamit re' re', i ruk'ul chi naa ruye'ariik chutojariik i ru mahk,</para>
  <para style="q">ruum xa re' i yiib' wach inki a'n</para>
  <para style="q">
    <verse number="7" style="v" />Ar Jerusaleem i xa re' i yiib' wach na'ojb'al imb'aan,</para>
  <para style="q">je' rukab' noq ma' rumay ta elik chaloq i ha' paraasb'al.</para>
  <para style="q">Re' i nib'irjik rib'iral ar xa re' i ma' ruk'ul ta chi b'anarik,</para>
  <para style="q">xa re' pletohinik iib', xa re' i hopoj iib',</para>
  <para style="q">xa re' i ti' k'axik inki a'n reh i tokoom,</para>
  <para style="q">re' taqe i re' inki a'n chi nuwach.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taq i hat aj Jerusaleem, chajal taq wach ana'ojb'al,</para>
  <para style="q">reh chi ma' nee ta taq tinukanaa' cha wutkeel.</para>
  <para style="q">Reh chi ma' nee ta taq i nukanaa' aatinamiit chi xa je'</para>
  <para style="q">chik chiq yuuq', eh chi ma' xta chik</para>
  <para style="q">jino'q patineel ar, inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Re' i QaJaaw Dios nim rajaawriik je' wili xuq'or:</para>
  <para style="q">Re' taqe i aj Israel konaakikahniik ar aha' ta chik ma' naakisik'ariik</para>
  <para style="q">kuum i aj ixowaal korehtaal kireqariik.</para>
  <para style="q">Je' rukab' i rub'an i tikil uuva i rusik' chu'nchel i wach</para>
  <para style="q">ma' jino'q chik i rukanaa', inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Eh re' hin je' wili i xnuq'or:</para>
  <para style="q">Chi nee nuq'or rib'iral keh i re' ma' jino'q ineerunimaj,</para>
  <para style="q">ruum re' keh je' naa tz'aplik i kixikin.</para>
  <para style="q">QaJaaw Dios re' taqe i re' ma' jaruuj neenkaaj kib'iram neenkikaqse'laaj inaq'or,</para>
  <para style="q">ma' nee ta imponik panaq' kiwach.</para>
  <para style="q">
    <verse number="11" style="v" />Re' hin, hin nujinaq chi rujosq'iil i QaJaaw Dios, ma' nukuy ta chik.</para>
  <para style="q">Re' reh je' wili i xuq'or weh:</para>
  <para style="q">Chawik'saj aajosq'iil chikinaah i k'ijolaq pantaq b'eeh,</para>
  <para style="b" />
  <para style="q">je' wo' chikinaah taqe i komanaan inkimol kiib,</para>
  <para style="q">reh chi neekik'amarik reje pantz'ilom</para>
  <para style="q">taqe i winaq kuch'ihil kehk'een,</para>
  <para style="q">je' wo' taqe i riji' winaq.</para>
  <para style="q">
    <verse number="12" style="v" />Re' taqe re', chi je' kiye'aab', chi je' kipaat,</para>
  <para style="q">chi je' kehk'een re' chik taqe i aj ixowaal naa ruchopwiik kinaah.</para>
  <para style="q">Ruum re' hin</para>
  <para style="q">naa taqe nuye'em chutojariik i kimahk</para>
  <para style="q">taqe i patim chupaam i tinamit re' re', inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Chi nimaq chi kok' taq</para>
  <para style="q">xa re' i tumiin inkikapaaj re' inkireq ruuk' i leq'.</para>
  <para style="q">Eh chi je' jalal naq taqe nuq'oral, chi je' taqe k'amal kib'eeh i aj tiij</para>
  <para style="q">xa re' i jot'ooj inki a'n</para>
  <para style="q">
    <verse number="14" style="v" />Eh inkijot'isaj wach i ruti'kiil kik'ux i nutinamiit,</para>
  <para style="q">inki a'n kiib', je' wili inkiq'or:</para>
  <para style="q">Yu'naak xtiwilkooj pansuqkiil k'uxliis inki taqe</para>
  <para style="q">xanaah re' ma' xata wo' suq kiil k'uxliis.</para>
  <para style="q">
    <verse number="15" style="v" />Re' keh i ruk'ul naq chi nchalik kik'ixiik</para>
  <para style="q">ruum inki a'n re' re' xama' nukuy ta chik rilariik i hin.</para>
  <para style="q">Xa re' la' re' keh</para>
  <para style="q">xama' keht'al ta wo' wach k'ixik.</para>
  <para style="q">Ruum aj re' noq naa taqe nuye'em chutojariik i kimahk</para>
  <para style="q">i tokoom naa wo' kib'aniik i ti' k'axik re' re' i keh, inki i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Eh je' wili i xuq'or i QaJaaw Dios:</para>
  <para style="q">Chapab'aa' taq awiib' xilak taq b'eeh,</para>
  <para style="q">chapahqaaj taq aha' wilik i holohik i najtir b'eeh</para>
  <para style="q">re' taq chak'am,</para>
  <para style="q">chi je' re' nee taq i naa req ruhi'lb'aal awánima, inki.</para>
  <para style="q">Eh re' keh je' wili i xkiq'or:</para>
  <para style="q">Ma' chih taj, ma' nee ta qak'amam i b'eeh re' re' i hoj, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Re' i QaJaaw</para>
  <para style="q">xnukoj wo' naq cha'jen taq aweh,</para>
  <para style="q">reh chi xkiq'or taq aweh chi naa naq taq ab'iram</para>
  <para style="q">noq naa ruxuljiik chee i tuun rehtalil i ti' k'axik.</para>
  <para style="q">Eh je' taq wili i xaq'or:</para>
  <para style="q">Re' hoj ma' qanimaj taj i re', tiki taq.</para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" />Ruum aj re' je' wili i xuq'or i QaJaaw Dios: Chab'iraj taq i hat nimaq tinamit, chanab'eej taq chib'ih i naa ruk'ulum i nutinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Chab'iraj taq i hat i wilkaat taq wach ak'al,</para>
  <para style="q">re' hin naa nuk'amam chaloq i ti' k'axik chikinaah i tinamit wili,</para>
  <para style="q">ruum chi ma' xkinimaj ta taqe i xnuq'or keh,</para>
  <para style="q">xkiq'eb' chi riij kik'ux i nuk'uhb'aal.</para>
  <para style="q">
    <verse number="20" style="v" />¿Chib'ih reet noq ink'ulik taq ak'at i insensia inchalik ar Saba,</para>
  <para style="q">eh ink'ulik taq ak'at chi nuwach xa chib'ih chik jariik ch'ahniil</para>
  <para style="q">kik'ohnik kichalik chi najt yuuq'?</para>
  <para style="q">Re' hin ma' suq ta rub'an weh taq amayiij,</para>
  <para style="q">je' wo' hoq i k'atoj chikop i nayeew taq chi amayiij, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Ruum wo' re' i ruq'or chi je' wili i QaJaaw Dios:</para>
  <para style="q">Re' hin naa nuye'em q'ab' chi re' taqe i tinamit wili naa rusahchiik kiwach,</para>
  <para style="q">chi tuutb'ees chi ajaab'ees chi ak'uunb'ees</para>
  <para style="q">chi ixq'uunb'ees chi kika'jaah kiib',</para>
  <para style="q">eh chi kamigo kiib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Re' re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' taqe i aj ixowaal wilkeeb' cho chi najt tinamit,</para>
  <para style="q">pantz'eet reje reh i rookb'aal i q'iij,</para>
  <para style="q">re' wilik kajaawriik, chalik chik inki a'n chi q'aq'inik.</para>
  <para style="q">
    <verse number="23" style="v" />Eh kik'amam cho kiflecha, kiq'as ju' ch'ihch',</para>
  <para style="q">ma' awach taj i naa kiketelaam wach,</para>
  <para style="q">ruum yohb'aal wach kijosq'iil.</para>
  <para style="q">Xa je' chik rukab' i choqik i rub'an i palaw,</para>
  <para style="q">eh iqilkeeb' taqe riij kawáyu noq naa kik'uliik iloq,</para>
  <para style="q">chi q'aq'inik kuuk' i aj Sión, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Re' taqe i aj Jerusaleem je' wili inkiq'or:</para>
  <para style="q">Re' hoj xqib'iraj chik rib'iral i ti' k'axik re' re' ma' k'isiin ta xchalik qayo'jiik,</para>
  <para style="q">eh xchalik rutiib'iik qak'ux ruum,</para>
  <para style="q">je' rukab' noq inchalik ruti'kiil ixoq noq ink'ulik ruk'ux.</para>
  <para style="q">
    <verse number="25" style="v" />Ma' aha' taq tiooj pantaq ab'iix,</para>
  <para style="q">pantaq b'eeh</para>
  <para style="q">ruum re' taqe aj ixowaal kiyejaam chik cho kiib' reh ikaansanik</para>
  <para style="q">aha' ta chik ma' kipuhkaam kiib', inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Hat taq nutinamiit chakoj taq chawiij i q'as wach itz'ihy</para>
  <para style="q">cha tolej taq awiib' pan chaaj chakoj taq i q'eq itz'ihy chawiij.</para>
  <para style="q">Eh cha ch'ikaa' taq ak'ux chi oq'ik,</para>
  <para style="q">je' rukab' noq inooq'jik i rukimiik ak'uunb'ees</para>
  <para style="q">xa jinaj wo' chuwach i rutuut.</para>
  <para style="q">Ruum re' taqe i naa rusachwiik qawach</para>
  <para style="q">naa kik'uliik iloq chi jumehq'iil.</para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" />Eh re' QaJaaw je' wili i xuq'or weh: Re' hin i nuq'or aweh chakoj rehtaal i k'achi' keeb' ar neenawilow nik' wach i kina'ojb'al, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Eh re' taqe i keh Jaaw chi kunchelaal ma' ti kinimaj taj,</para>
  <para style="q">xa aj tz'aqal wach k'utaaj taqe, xa tee eh kiwach,</para>
  <para style="q">q'e' kow i kinaah je' kowiil q'an ch'ihch', je' kowiil rax ch'ihch'.</para>
  <para style="q">
    <verse number="29" style="v" />Eh noq inhuupjik i q'aaq' i ruhaahb'isaj i plomo.</para>
  <para style="q">Xa ma' xta inkih chi nsaqb'eejik kiwach,</para>
  <para style="q">eh re' taqe i yiib' wach kina'ojb'al</para>
  <para style="q">xama' nsahchik ta wo' kiwach.</para>
  <para style="q">
    <verse number="30" style="v" />Ruum aj re' i ruk'ul chi naa qaq'orom keh chi je' kikab' i plata xa nsahchik kiwach.</para>
  <para style="q">Ruum re' hat QaJaaw Dios naa asacham kiwach.</para>
  <chapter number="7" style="c" />
  <para style="s">Re' Jeremías xub'an i k'uhb'aal chupaam i rupaat i Dios</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios je' wili i xuq'or reh i Jeremías: <verse number="2" style="v" />Re' hat chapab'aa' awiib' panookb'al reh i nupaat, cha q'or rib'iral ar i nuk'uhb'aal wili, je' wili i neenaq'or: Hat taq aj Judá chawunchelaal taq i ti okik i koq chi chii' i ookb'al wili chab'iraj taq i k'uhb'aal wili: <verse number="3" style="v" />Re' i QaJaaw min rajaawriik re' qaDios i hoj aj Israel je' wili i xuq'or: Chayejaa' taq aak'achariik, re' chik i holohik taq cha a'n, reh chi neenuyeew q'ab' taq aweh chi nee taq ti k'acharik chupaam i ye'aab' wili. <verse number="4" style="v" />Manimaj taq i xachukuj q'orik noq neenkiq'or taq aweh chi je' wili: Ayu' wilik i rupaat i QaJaaw Dios, ayu' wilik i rupaat i QaJaaw Dios, ma' xta taq neenak'ul, tiuchjoq taq.</para>
  <para style="p">
    <verse number="5" style="v" />Eh wila' xayejaa' taq ak'achariik, wila' re' chik holohik taq xa a'n, wila' re' i korik taq xa a'n ruuk' aawas achaaq'. <verse number="6" style="v" />Wila' ma' xaq'uch taq chik i chib'ih keh i tokoom tinamit, taqe i ma' xta kituut kajaaw, taqe i kamnaq kib'ahiil. Eh wila' ma' xa kansaj taq chik taqe i ma' xta kimahk chupaam i ye'aab' wili, eh wila' ma' xaloq'ej chik taqe i tiyoox, re' ink'amwik chaloq i ti' k'axik taq cha naah, <verse number="7" style="v" />re' hin nee taq tinuyeew chi k'acharik nik'-oq najtiil chupaam i ye'aab' wili, re' i nuye'em cho keh chi jumpech taq aamaam awati't.</para>
  <para style="p">
    <verse number="8" style="v" />Re' taq i hat inach'ikaa' taq ak'ux ruuk' i xachukuj q'orik xama' xta ruk'am taq chaaweh. <verse number="9" style="v" />Re' taq i hat i na a'n taq i leq', ikaansanik, inach'uwa'risaj taq wach i aakaxáro, inaq'or taq i korik i na a'n awiib'. Eh inak'at taq insensia chuwach i tiyoox Baal, i nayeew taq kiloq'il taqe i tiyoox, ma' ruk'ul ta taq cha weh. <verse number="10" style="v" />Eh chi riij i re' ti chalik wo' taq chik ayu' chi nuwach chupaam i nupaat wili inloqjiik wii' i nub'ihnaal, je' wili taq inaq'or: Yu'naak hoj chik ko'limaj tiki taq. Noq ti sutinik taq reje inatoq'aa' wo' taq chik rub'aan i yiib' wach na'hojb'al. <verse number="11" style="v" />¿Mi nakapaaj taq re' hat chi re' i nupaat inlooq'jik wii' i nub'ihnaal xa je' kiye'aab' ajileq'? Re' hin inwilow chu'nchel i yiib' wach taq i na a'n. <verse number="12" style="v" />Re' taq i hat hiy taq chupaam i nupaat ar Silo, re' tinamit re' re' peet wo' naq xnuyeew kiloq'il ruuk' i nub'ihnaal. Re' taq i hat nee taq inakoj rehtaal chib'ih i ti' k'axik xnuyeew cho chikinaah ruum i kimahk i nutinamiit Israel. <verse number="13" style="v" />Re' hin k'ipech wo' naq xatnuq'il taq ruuk' aana'ojb'al, eh xama' xanimaj ta wo' taq, noq xat nuyuq'eej taq xama' xinab'iraj ta wo' taq. <verse number="14" style="v" />Ruum aj re' nik' wach noq xnusach wach i nuSantolaj ye'aab' xwihik cho Silo, je' wo' chik re' noq naa nusacham wach i paat wilik ayu', re' inlooq'jik wii' i nub'ihnaal. Re' i xnuyeew taq aweh i inach'ikaa' naq taq wii' ak'ux, xnuyeew wo' cho keh taq i aamaam awati't. <verse number="15" style="v" />Re' hin naa taq kaat wesam reje chi nuwach, je' rukab' noq xwesaj taqe reje chi nuwach i ma' tokoom ta taq awuuk', re' taqe i riih rumaam Efraín, inki taq aweh i QaJaaw Dios.</para>
  <para style="p">
    <verse number="16" style="v" />Eh je' wo' chik wili xuq'or: Re' hat Jeremías maa a'n chik atiij chikiij i tinamit wili, maa pahqaaj chik weh chi neenutoob'eej taqe, eh chi neenuketelaaj kiwach ruum re' hin xama' nee ta wo' chik tib'iraj. <verse number="17" style="v" />Ruum re' keh xa re' wo' hoq i ma' holohik ta laj na'ojb'al inki a'n chupaam i tinamit Judá. Eh je' wo' hoq xilak taq b'eeh reh i Jerusaleem. <verse number="18" style="v" />Re' taqe i kak'uun kisik'wik i sii', eh re' taqe ajaab'ees kiluk'wik i q'aaq, eh re' taqe i ehk'eenb'ees kiyej-anik reh i kaxlanwi'k inkiyeew chi mayiij chuwach ixoq tiyoox inkiq'or chi re' reh i reey pan taxaaj. Eh inkiyeew i riis uuva chikiwach i tokoom dios, ruuk' i re' inkiyeew nujosq'iil. <verse number="19" style="v" />Noq kinkiq'eet wachej hin xa re' wo' keh inkiq'et wachej kiib' ruum xa re' wo' keh inkik'uhtaaj kik'ixb'ilaal. <verse number="20" style="v" />Ruum aj re', re' hin i Dios korik i nuq'or taq aweh chi naa nuye'em chu'nchel i nujosq'iil chinaah i ye'aab' wili, chikinaah i patineel wilkeeb' ayu', chikinaah i chikop. Eh chikinaah i chee' kiwachinik, re' taqe i wach tik nakik'ahtiik ruuk' q'aaq' ma' jaruuj chik naa ruchuhpiik.</para>
  <para style="s">Re' ti' k'axik xye'arik chikinaah i aj Judá ruum ma' xinimanik taj</para>
  <para style="p">
    <verse number="21" style="v" />Re' i QaJaaw, i qaDios i hoj, hoj aj Israel nim rajaawriik, je' wili i xuq'or keh i rutinamiit: Chayeew taq chu'nchel k'atoj chikop chi mayiij xanik' pa' k'ihaal taq inawaaj, nee wo' rub'an chi nee taq inak'ux aweh i kitib'kaal. <verse number="22" style="v" />Xa re' la' re' hin noq xwesaj taqe chaloq aamaam awati't Egipto, xama' xta wo' xnuq'or keh, ma' xnumin ta taqe chupaam chi naa kiye'em i k'atoj mayiij, eh chi naa kik'atam i chikop chi kimayiij. <verse number="23" style="v" />Re' i xnuq'or keh i hin xa re' wo' naq chi nakiin kinimam. Reh naq chi xin kahnik chi hin ki Dios, eh chi re' keh xi kahnik naq chi nutinamiit taqe, je' naq re' xnuq'or keh chi naa kianaam reh naq chi holohik naakeliik. <verse number="24" style="v" />Xa re' la' re' keh xama' xinkinimaj ta wo' hoq, xama' xkinimaj ta wo' i xnuq'or keh, xkikowb'isaj la' i kinaah. Re' chik xkian i yiib' wach na'ojb'al i nelik cho pankanima, ma' xinkinimaj taj xin kiq'eb' chi riij kik'ux. <verse number="25" style="v" />Eh xa re' wo' noq xwesaj taqe chaloq aamaam awati't Egipto nutik'aam chaloq chi xariij chik riib' xnutaq'aaj taq cho chak'uhb'aljiik taqe jalal nuq'oral xnutaq'aaj taq cha weh chu'nchel i waj kamanoom. <verse number="26" style="v" />Re' taq i hat xama' xinanimaj ta wo' taq, ma' xanimaj ta taq i xnuq'or. Q'e' wo' chik xakowb'isaj taq anaah, ma' xata je' rukab' xkian taq aamaam awati't.</para>
  <para style="p">
    <verse number="27" style="v" />Eh je' wili xuq'or weh: Re' hat Jeremías cha q'or keh chu'nchel wili, atoob' ta ma' neetikib'iraj. Kow cha k'er aachii' chi kiq'orob'jiik atoob' ta ma' nee ta tikich'aqweej. <verse number="28" style="v" />Je' wili cha q'or keh: Re' i tinamit wili ma' nkinimaj taj i QaJaaw i qaDios, ma' nkaaj ta chi neen q'orarik keh chi neenkikanaa' i yiib' wach na'ojb'al, ma' korik ta chik kiq'orik, tiko'q keh, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Hat taq aj Jerusaleem,</para>
  <para style="q">chayok' taq i rismaal anaah chayeew taq reje wulu',</para>
  <para style="q">cha k'er taq aachii' chi oq'ik chinaah taqe i yuuq',</para>
  <para style="q">ruum re' i QaJaaw Dios ruum i rujosq'iil xat ruq'eb' taq, chi riij ruk'ux.</para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" />Re' QaJaaw Dios je' wili i xuq'or: Re' taqe i tinamit wilkeeb' Judá wilik i xkian ma' suq ta xub'an weh, xkiyeew i tiyoox chupaam i nupaat re' naq i kinkiloq'ej wii' xkich'uwa'risaj paam. <verse number="31" style="v" />Re' keh xkiyejaa' i artaal Tofet rub'ihnaal ar wach k'ixkaab' Ben-hinom ar xkik'at taqe i kak'uun kixq'uun chi mayiij chikiwach i tiyoox. Re' hin ma' xnuq'or ta keh chi je' re' i naa kianam, ni xata naq xik'ik panukapeb'aal. <verse number="32" style="v" />Ruum aj re' naa ruponiik i q'iij chi re' ye'aab' re' re' ma' re' ta chik Tofet ni xata Ben-hinom naa rubíhnaam, ye'aab' reh kanteesb'al iib', la' chik i naa rubíhnaam, ar chik Tofet naakimuq'aam taqe i kamnaq ruum ma' naa ta chik rumanlojiik i ye'aab' kimuhqik wii'. <verse number="33" style="v" />Re' kiti'jolal taqe i tinamit wili naa rukahniik chi kiwa' taqe i k'uch chi kiwa' taqe i josq'laj chikop, atoob' ta naq nee kiyohb'esjik chinaah ma' jaruuj chik naakikanaam ruk'uxariik. <verse number="34" style="v" />Re' hin naa nusacham kiwach pan tinamit Judá, pantaq xilak b'eeh Jerusaleem, ma' naa ta chik rib'irjiik i tz'uuy reh ninq'iij, reh suq kiil k'uxliis, tz'uuy reh kaxáro. Ruum re' i tinamit wili naa rukahniik chi xa je' chik ye'aab' chiq yuuq' ma' xta chik i naa ruwihiik chupaam, inki.</para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili ruq'or: Eh chupaam taqe i q'iij re' re', re' taqe i aj ixowaal, naa kesam cho pankijuleel i kib'aqil taqe i reey, i kib'aqil xk'amwik cho kib'eeh i aj Judá, i kib'aqil taqe i k'amal b'eeh aj tiij, i kib'aqil taqe i xijalwik cho nuq'oral, re' taqe i xi k'acharik cho Jerusaleem. <verse number="2" style="v" />Eh naakikanaam chi ch'a'lik i kib'aqil wach q'iij, chuwach i poh, chuwach taqe i ch'umiil, re' i xkikoj chi jilow ki dios, eh kiyeew ruloq'il xkinimaj. Ruum aj re', re' kib'aqil ma' awach ta chik naa rumolwiik reh, eh ma' naa ta chik kimuq'aam, naa la' kikahniik chi xach'a'lkeeb' chik wach ak'al xa je' chik rusaa' chikop. <verse number="3" style="v" />Re' taqe i konaakikahniik chi k'achalkeeb' re' ruuk' taqe i tinamit wilik yiib' wach i kina'ojb'al, xa aha' pa' naa kiwihiik, noq nutukem chik kiwach i hin, ma' naa ta chik kaajwaam k'acharik, re' la' chik i kimik naa kaajwaam, inki QaJaaw Dios.</para>
  <para style="p">
    <verse number="4" style="v" />Eh je' wili i xuq'or i QaJaaw Dios:</para>
  <para style="b" />
  <para style="q">Chakoj taq rehtaal noq awach inq'ehb'ik impa'lojik wo' chik,</para>
  <para style="q">noq insahchik reh i b'eeh i rusik' wo' chik, i rureq wo' chik.</para>
  <para style="q">
    <verse number="5" style="v" />Raaj taq i hat aj Israel ¿Chib'ih reet noq tokoom taq chik inanimaj?</para>
  <para style="q">¿Chib'ih reet noq xinaq'eb' taq chi riij ak'ux taq i hat i aj Jerusaleem?</para>
  <para style="q">¿Chib'ih reet noq ma' xinasik' ta taq chik ruka'peech?</para>
  <para style="q">
    <verse number="6" style="v" />Re' hin eliik naq imb'iraj,</para>
  <para style="q">xa re' la' ma' jank'al tamb'iraj chi nkipahqaaj ta kuyb'al kimahk.</para>
  <para style="q">Eh ma' inkiq'or ta wo' chi je' wili:</para>
  <para style="q">¿Chib'ih i ma' holohik taj nub'anam? ma' nki ta taqe.</para>
  <para style="q">Chi kunchelaal la' kiooj kajimam kiib' chub'aan i kiyiib' wach na'ojb'al</para>
  <para style="q">xa je' chik kiajiminik kawáyu ojik i rub'an panq'aq'inik.</para>
  <para style="q">
    <verse number="7" style="v" />Re' qamaan sajikiih inrupinik pan taxaaj</para>
  <para style="q">reht'al nare' jaruuj wo' chik insutinik reje.</para>
  <para style="q">Re' mukur ruch'ihil i siq'jil tz'ikin, i nimlaj tz'ikin</para>
  <para style="q">keht'al jaruuj kisutinik reje.</para>
  <para style="q">Eh re' taq i hat nutinamiit Israel,</para>
  <para style="q">xama' jaruuj wo' xawaaj taq animam i nuk'uhb'aal.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Eh ¿Nik' wach noq inaq'or taq chi wilik ana'ojb'al</para>
  <para style="q">chi k'achi' taq animam i nuk'uhb'aal?</para>
  <para style="q">Xanaah re', re' taqe i k'amal taq ab'eeh xijalwik wach rutz'ihb'jiik,</para>
  <para style="q">re' chik i chukuj q'orik xkikoj.</para>
  <para style="q">
    <verse number="9" style="v" />Re' taqe i aj na'ojb'al re' re',</para>
  <para style="q">naa ruchaliik kik'ixiik naa ruchaliik kiyo'jiik.</para>
  <para style="q">Eh ¿Nik' wach noq inkiq'or chi wilik kina'ojb'al</para>
  <para style="q">eh ma' imponik ta panaq'kiwach i nuk'uhb'aal?</para>
  <para style="q">
    <verse number="10" style="v" />Ruum aj re', re' hin naa nuye'em q'ab'</para>
  <para style="q">chi re' chik taqe i aj ixowaal</para>
  <para style="q">naa ruchopwiik naah i kehk'een, i kak'aal,</para>
  <para style="q">ruum chi nimaq chi kok' taq xa re' i tumiin inkikapaaj, re' inkireq ruuk' i leq'.</para>
  <para style="q">Eh chu'nchel i leq' ruuk' inki a'n</para>
  <para style="q">chi je' taqe k'amal b'eeh aj tiij chi je' taqe jalal naq nuq'oral.</para>
  <para style="q">
    <verse number="11" style="v" />Eh inkijot'isaj wach i ruti'kiil kik'ux i nutinamiit inki a'n kiib',</para>
  <para style="q">inkiq'or chi wilik suq kiil k'uxliis,</para>
  <para style="q">xanaah re' xama' xta wo' suq kiil k'uxliis.</para>
  <para style="q">
    <verse number="12" style="v" />Re' keh i ruk'ul naq chi nchalik kik'ixiik</para>
  <para style="q">ruum i ch'uwa' wach na'ojb'al inki a'n re' re'.</para>
  <para style="q">Xa re' la' re' keh xama' xta wo' inkaaj reh,</para>
  <para style="q">ma' keht'al ta wach i k'ixik.</para>
  <para style="q">Ruum aj re' noq naa taqe nuye'em chutojariik i kimahk i tokoom</para>
  <para style="q">naa kib'aniik i ti' k'axik keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' hin naa nusacham wach i nutinamiit,</para>
  <para style="q">naa kikahniik chi je' rukab',</para>
  <para style="q">i uuva, ma' wachinik taj,</para>
  <para style="q">i higo ma' wachinik taj,</para>
  <para style="q">xa chiqiij chik i xaq, re' naq i chib'ih i nuye'em</para>
  <para style="q">keh naa wesam chikiwach, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Eh re' taqe tinamit je' wili i naa kiq'orom:</para>
  <para style="q">¿Chib'ih kamaj chi naa qakahniik ayu' chi ruyub'jiik i qakimiik?</para>
  <para style="q">Taq taq chupaam i tinamit kotimaj kiij chi tz'aq neerub'an chi ar nee qoh kimik.</para>
  <para style="q">Ruum re' i QaJaaw Dios naakooj rukansam,</para>
  <para style="q">je' naa ruye'em qeh chi uuk'jik i ha' inkansanik</para>
  <para style="q">ruum ma' k'isiin i mahk xqa a'n chuwach.</para>
  <para style="q">
    <verse number="15" style="v" />Re' hoj k'ahchi' naq quy-eem i suq kiil k'uxliis,</para>
  <para style="q">xama' xta wo' i suq kiil k'uxliis k'achi' qilom.</para>
  <para style="q">K'ahchi' naq quy-eem</para>
  <para style="q">chi naa qakoowjiik qayo'jiik chik inchalik.</para>
  <para style="q">
    <verse number="16" style="v" />Eh re' taqe i aj ixowaal i nib'irjik chik ar Dan i choqik i rub'an i kikawayu,</para>
  <para style="q">noq kipisk'anik pankooq xan k'uyu'jik chik chu'nchel aak'al.</para>
  <para style="q">Eh xchalik kisach wach i tinamit, je' wo' hoq chib'ih i wilkeeb' chupaam,</para>
  <para style="q">je' wo' chu'nchel i patineel chupaam, inko'q taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Eh re' QaJaaw Dios je' wili i xuq'or keh:</para>
  <para style="q">Re' hin naa nutaq'aam taq cho cha naah taqe i aj ixowaal</para>
  <para style="q">je' kikab' i josq'laj aaq'.</para>
  <para style="q">Naa taq kaat kikansam ma' xta chik taq naa ako'leem wii' awiib' chikiwach, inki.</para>
  <para style="s">Re' ruti'kiil ruk'ux i Jeremías chi riij i rutinamiit</para>
  <para style="q">
    <verse number="18" style="v" />Re' ruti'kiil nuk'ux xama' xta chik neenik'ik wii'</para>
  <para style="q">xan yot'ik chik i wánima.</para>
  <para style="q">
    <verse number="19" style="v" />Ruum re' i nutinamiit xak'erik chik kichii',</para>
  <para style="q">i nib'irjik chupaam taqe i tinamit je' wili inkiq'or:</para>
  <para style="q">¿Mi ma' xta chik ar Sión re' i QaJaaw Dios?</para>
  <para style="q">¿Chib'ih reet noq ma' qohrutoob'eej chik i qa reey? inki taqe.</para>
  <para style="q">Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">¿Chib'ih reet noq xajosaj taq chee nujosq'iil ruum i kilooq'jiik taqe i tiyoox,</para>
  <para style="q">xama' xta kiokik wii'? inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Xik'ik chik i siq'jil xkuxik chik i rumolariik i kiwach i tik.</para>
  <para style="q">Eh re' hoj xama' qoh ko'ljik ta wo' hoq.</para>
  <para style="q">
    <verse number="21" style="v" />Re' hin q'e' intiib'ik nuk'ux chi riij i ti' k'axik k'ahchi' kik'ulum i nutinamiit.</para>
  <para style="q">Q'e' tz'irik nuwach, eh inchalik nuyo'jiik i rub'an.</para>
  <para style="q">
    <verse number="22" style="v" />¿Mi ma' awach re' ineenkan Galaad nee risaj i ti' k'axik chinaah i nutinamiit?</para>
  <para style="q">¿Mi ma' awach re' i neerub'an rehtesjiik i ti' k'axik?</para>
  <para style="q">¿Chib'ih reet noq ma' nkian ta riq'oomjiik i nutinamiit?</para>
  <chapter number="9" style="c" />
  <para style="q">
    <verse number="1" style="v" />Re' hin inwaaj naq chi</para>
  <para style="q">re' i riis naq'nuwach</para>
  <para style="q">je' rukab' i raasb'al ha' ma' jaruuj inchiqik.</para>
  <para style="q">Chi je' re' ma' jaruuj naq neenk'uhlik</para>
  <para style="q">atoob' ta nee naq inwoq'ej chi q'iij chi aq'ab' i kikimiik i nutinamiit.</para>
  <para style="q">
    <verse number="2" style="v" />Re' hin inwaaj naq rojiik nuyejaam</para>
  <para style="q">nuperpaat pan chiq yuuq',</para>
  <para style="q">reh naq chi neenukanaa' kahnoq i nutinamiit, eh ma' nee ta naq chik inwilow kiwach.</para>
  <para style="q">Ruum re' keh xkian i je' k'oyomal,</para>
  <para style="q">eh aj chukul q'orik taqe.</para>
  <para style="q">
    <verse number="3" style="v" />Eh re' kaaq' xanyub' chik chi chukuj q'orik</para>
  <para style="q">xa je' chik rukab' noq inyub' i kutb'al reh i flecha.</para>
  <para style="q">Ma' awach ta chik i korik inq'orik,</para>
  <para style="q">q'e' yiib' wach kib'anik,</para>
  <para style="q">ruum i re' je' wili i ruq'or QaJaaw Dios:</para>
  <para style="q">Re' tinamit wili ma' kinkinimaj ta chik.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Eh ma' awach taj i nee ruq'or chi korik inq'orik i ramigo.</para>
  <para style="q">Ma' awach ta wo' i nee ruq'or chi korik inq'orik i ras oon ruchaaq'</para>
  <para style="q">ruum re' keh k'ul inkijot' kiib' chikiwach.</para>
  <para style="q">Eh k'ul inkikoj kimahk chikiwach.</para>
  <para style="q">
    <verse number="5" style="v" />Xak'ul inkelq'aaj i kamigo</para>
  <para style="q">ma' inkiq'or taj i korik,</para>
  <para style="q">kitijem chik i kaaq' chi chukuj q'orik,</para>
  <para style="q">ma' xkaaj ta chik nimanik.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Xa re' i leq', xa re' jot'oj inki a'n</para>
  <para style="q">ma' kimponik ta k'isinoq panaq'kiwach i</para>
  <para style="q">ma' kinkaaj ta chik kiin kinimam, inki QaJaaw Dios.</para>
  <para style="q">
    <verse number="7" style="v" />Ruum aj re' je' wo' chik wili i xuq'or:</para>
  <para style="q">Re' hin naa nuye'em panti' k'axik je' naa wik'sam</para>
  <para style="q">taqe pan q'aaq' ilb'al reh chib'ih pa' i neenkian,</para>
  <para style="q">je' re' i naa nub'anam kuuk' i nutinamiit.</para>
  <para style="q">
    <verse number="8" style="v" />Re' kaaq' xa je' chik rukab' i q'aslaj ch'ihch',</para>
  <para style="q">xa re' i chukuj q'orik i nelik cho pan kichii'.</para>
  <para style="q">Pan suq kiil tii chik inkiq'oreej i kas kichaaq' inki a'n kiib',</para>
  <para style="q">xa re' la' pankanima kiyejaam cho wach chib'ih i naa kianam reh.</para>
  <para style="q">
    <verse number="9" style="v" />¿Mi ma' naa nuye'em taqe chutojariik re' i kimahk?</para>
  <para style="q">¿Mi ma' ruk'ul re' chi nee taqe nuyeew chutojariik i kimahk i tinamit re' re'</para>
  <para style="q">je' rukab' i ruk'ul chi keh? inki i QaJaaw i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' hin naa nuye'em q'ab'</para>
  <para style="q">chi naakik'erem kichii' chinaah taqe i yuuq'</para>
  <para style="q">noq naakilom chi k'ahtinaq chik taqe i ch'ahn chupaam i kiye'aab'.</para>
  <para style="q">Eh naa rutib'iik kik'ux ruum ma' naa ta chik rib'irjiik i koq'iim taqe i wakax,</para>
  <para style="q">ma' naa ta chik kiwihiik ar taqe i chikop wilik kixiik',</para>
  <para style="q">taqe i panch'ahn chikop.</para>
  <para style="q">Chu'nchel naakimolom chi elik.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' hin naa nuch'ahaam wach ak'al i tinamit Jerusaleem</para>
  <para style="q">naa nukanaam chi kiye'aab' k'ichi'ahq.</para>
  <para style="q">Eh naa nusacham wach i tinamit Judá,</para>
  <para style="q">naa nukanaam chi ma' jino'q chik i patineel chupaam.</para>
  <para style="s">Re' i rusachariik kiwach re' i kik'amariik reje pan tokoom tinamit</para>
  <para style="p">
    <verse number="12" style="v" />¿Awach i wilik runa'ojb'al nee rureq chi riij i naa ruk'ulariik wili? ¿Mi wilik jino'q i raj kamanoom i Dios neeruch'ob' rub'ehel? ¿Chib'ih reet noq naa rukahniik chi ma' xta chik i wilik chupaam i qatinamiit, eh naa rukahniik chi je' rukab' i chiq yuuq', eh ma' awach ta chik i naa rik'iik ar?</para>
  <para style="p">
    <verse number="13" style="v" />Re' i QaJaaw Dios je' wili i xuq'or: Re' nutinamiit je' re' inakik'ulum, ruum xkiq'eb' chi riij kik'ux taqe i nuk'uhb'aal, ma' inkik'am ta naah i nuq'or keh. <verse number="14" style="v" />Ruum i rukowiil i kinaah ma' xkikanaa'ta rulooq'jiik taqe i tiyoox xankiyeew chik kik'ux chub'aan, je' rukab' i xitijik kahnoq wii' kuum i kimaam kati't. <verse number="15" style="v" />Ruum aj re', re' hin i Dios wilik wajaawriik, hin ki Dios i aj Israel, je' wili xnuq'or: Re' hin naa nuye'em i ti' k'axik chikinaah, je' naa k'ah laj wi'k i naa nuye'em keh, je' na naa nuye'em keh chi uuk'jik i ha' inkansanik. <verse number="16" style="v" />Re' hin naa nutukem kiwach chupaam i tokoom tinamit ni xata re' keh ni xata re' i kimaam kati't xinab'inik reh. Eh naa nuye'em q'ab' chi naa kitahqaljiik reje ruuk' i q'aslaj ch'ihch' korehtaal insacharik kiwach chi kunchelaal, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Re' QaJaaw Dios nim rajaawriik, je' wili xuq'or weh:</para>
  <para style="q">Yu'naak cha taq'aaj kik'amarik ixoq xa re' oq'ik inkaaj,</para>
  <para style="q">eh xa re' re' kikamaj, inki.</para>
  <para style="q">
    <verse number="18" style="v" />Re' hin je' wili xnuq'or: ma' xta reet kichaloq chi jumehq'iil,</para>
  <para style="q">k'oloq kian koq'iim chiqiij i hoj ruum i ti' k'axik k'achi' qak'ulum.</para>
  <para style="q">Re' hoj nee wo' i nujik chi ha' paam inaq'qawach,</para>
  <para style="q">nee nb'ulinik chaloq i ha' pariij naq'qawach.</para>
  <para style="q">
    <verse number="19" style="v" />Eh k'achi' qib'iram noq re' taqe i aj Sión k'erik kichii' chi oq'ik je' wili inkiq'or:</para>
  <para style="q">Q'e' wo' chik ti' i k'ahchi' qak'ulum,</para>
  <para style="q">xsahchik wach i chib'ih qeh ma' k'isiin ta k'ixb'ilaal chi qeh,</para>
  <para style="q">naa qakanaam i qatinamiit, re' i qapaat xsacharik chik wach, inki taqe.</para>
  <para style="q">
    <verse number="20" style="v" />Re' hin je' wili xnuq'or: Hat taq ixoq chab'iraj taq i ruq'oral i QaJaaw,</para>
  <para style="q">xti chab'iraj taq chib'ih i ruq'or.</para>
  <para style="q">Eh cha k'uhtaaj taq keh awixq'uun i awamigo oq'ik inki a'n ixoq,</para>
  <para style="q">cha q'or taq keh chib'ih naa kianam noq ti' kik'ux, je' wili taq cha q'or keh:</para>
  <para style="q">
    <verse number="21" style="v" />Re' hoj k'ahchi' chik rukimiik awach qeh panqapaat,</para>
  <para style="q">wilik i ha'lak'un k'ahchi' kikansam pantaq b'eeh,</para>
  <para style="q">re' taqe i k'ijolaq k'achi' kikanteesjiik</para>
  <para style="q">pantaq k'aayb'al, tiko'q keh.</para>
  <para style="q">
    <verse number="22" style="v" />Re' kiti'jolal taqe i winaq naa rukahniik chi tuch'ulkeeb' pantaq b'eeh,</para>
  <para style="q">xa je' chik rukab' i rusaa' chikop pantaq ab'iix.</para>
  <para style="q">Je' rukab' i wach i trigo wilik pariij</para>
  <para style="q">inq'eb'arik kahnoq ruum i sik'il reh,</para>
  <para style="q">eh ma' awach ta chik i molwik reh.</para>
  <para style="s">Re' i runa'ojb'al i Dios inchol ruye'em ruloq'il i winaq</para>
  <para style="q">
    <verse number="23" style="v" />Re' Dios je' wili ruq'or:</para>
  <para style="q">Re' wilik runa'ojb'al ma' runimb'isaj riib' ruuk' i runa'ojb'al.</para>
  <para style="q">Eh re' wilik rajaawriik ma' runimb'isaj riib' ruuk' i rajaawriik.</para>
  <para style="q">Re' i b'ehoom ma' runimb'isaj riib' ruuk' i rub'ehomal.</para>
  <para style="q">
    <verse number="24" style="v" />Wila' awach iraaj runib'isam riib'</para>
  <para style="q">chunimb'isaj riib' ruuk' i runaab'jiik nuwach i hin,</para>
  <para style="q">re' i runaab'jiik chi re' hin i raJaaw i ruDios.</para>
  <para style="q">Eh chi hin aj keteloom wachiis,</para>
  <para style="q">eh chi re' i rukorkiil re' rub'ehel i nub'an wach ak'al,</para>
  <para style="q">re' taqe i re' imponik chi nuwach i hin, inki i Dios.</para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" />Eh je' wo' chik wili i xuq'or: Re' hin naa ruponiik i q'iij chi naa taqe nuye'em chutojariik i kimahk, i poch'ooj i rutz'uhmal naah i kik'achab', je' wo' taqe i ma' b'anooj ta keh i re'. <verse number="26" style="v" />Eh re' taqe i aj Egipto, i aj Judá, i aj Amón, i aj Edom, i aj Moab, eh chu'nchel i patim taqe panchiq yuuq', ma' kiq'asam ta kiib' weh chi korik. Ruum chu'nchel i tinamit, je' wo' taqe i tinamit Israel xti kiq'asam kiib' chulooq'jiik taqe i tiyoox, inki Dios.</para>
  <chapter number="10" style="c" />
  <para style="s">Re' rulooq'jiik i k'achlik Dios, eh re' kilooq'jiik i xatz'aqoj tiyoox</para>
  <para style="p">
    <verse number="1" style="v" />Re' taq i hat aj Israel chab'iraj taq aha' wilik i ruq'or taq aweh i QaJaaw Dios. <verse number="2" style="v" />Re' reh je' wili i xuq'or:</para>
  <para style="b" />
  <para style="q">Maa tijej taq aweh inki a'n i tokoom tinamit,</para>
  <para style="q">maayohb'isaj taq awiib' ruum i ehtalil i ruk'uhtaaj cho riib' pan taxaaj.</para>
  <para style="q">Je' rukab' inkik'ul taqe i tinamit re' re'.</para>
  <para style="q">
    <verse number="3" style="v" />Re' inki a'n i tinamit re' re' ma' xta tz'aaq,</para>
  <para style="q">inkiyok' i chee' inkiyeew reh i aj sehk.</para>
  <para style="q">Re' reh insehkanik wach ruuk' i ruch'ihch' i rukorb'isaj chi tiyoox.</para>
  <para style="q">
    <verse number="4" style="v" />Re' keh inkixoyej ruuk' oro, ruuk' plata,</para>
  <para style="q">eh inkikoj rukalawuxiil inkich'ey qohoq chi tuhyb'al reh,</para>
  <para style="q">re' inkaaj chi ma' q'ehb'ik taj.</para>
  <para style="q">
    <verse number="5" style="v" />Re' i kitiyoox xa je' rukab' i pooy cha'jalb'al reh tik.</para>
  <para style="q">Eh xama' kiq'orik ta wo' hoq,</para>
  <para style="q">eh ma' kib'ehik taj, kopantehl kiooj.</para>
  <para style="q">Re' taq i hat matyo'jik taq kuum taqe re' ruum xama' xta wo' neenkian,</para>
  <para style="q">ni xata re' i ma' holohik taj, ni xata re' i holohik inki a'n rub'aan inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />QaJaaw Dios xti korik wo' hoq noq ma' xta chik jino'q Dios chi je' rukab' i hat.</para>
  <para style="q">Ruum re' hat xiik' naah nimaal awach,</para>
  <para style="q">ehxiik'naah i rajaawriik ab'ihnaal.</para>
  <para style="q">
    <verse number="7" style="v" />QaJaaw Dios Reey chikinaah chu'nchel i tinamit,</para>
  <para style="q">i ruk'ul chi chu'nchel naakiyohliniik awach.</para>
  <para style="q">Ruum xa re' wo' hat wilik runimaal awach chikiwach taqe i reey,</para>
  <para style="q">chikiwach i wilik kina'ojb'al,</para>
  <para style="q">ma' awach ta jino'q i nee rureq chi je' rukab' i hat.</para>
  <para style="q">
    <verse number="8" style="v" />Chu'nchel i kiloq'inik reh taqe tiyoox,</para>
  <para style="q">meem taqe, ruum inkipahqaaj kina'ojb'al reh i xa chee'.</para>
  <para style="q">
    <verse number="9" style="v" />Eh ar Tarsis inkik'am chaloq i plata, ar Ufaz inkik'am chaloq i oro.</para>
  <para style="q">Ruuk' i re' i ruyejaa' i kitiyoox i aj ch'eyool,</para>
  <para style="q">eh inkitiq'aa' ruuk' i raxmuqik laj itz'ihy, ruuk' i kaq laj itz'ihy.</para>
  <para style="q">Re' taqe itz'ihy re' re', xti kichol keem kiyej-anik reh.</para>
  <para style="q">
    <verse number="10" style="v" />Eh re' i QaJaaw reh xti korik laj Dios,</para>
  <para style="q">eh k'achlik Dios re' wilik chi Reyil chi juneliik,</para>
  <para style="q">noq inchalik rujosq'iil xan b'arb'otik chik chu'nchel i wach ak'al chuwach,</para>
  <para style="q">eh re' taqe i tinamit ma' inkikuy taj i rujosq'iil.</para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" />Eh re' taq i hat i aj Israel cha q'or taq keh i kiloq'inik reh taqe i tiyoox. Re' i ki dios ma' re' tee keh xiyej-anik reh i taxaaj i wach ak'al, naa rusahchiik kiwach chi jumpech.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' QaJaaw Dios ruuk' i rajaawriik xuyejaa' i wach ak'al,</para>
  <para style="q">eh ruuk' i runa'ojb'al xuyeew taqe paruye'aab' i wilkeeb' chupaam,</para>
  <para style="q">eh xuhe' wach i taxaaj paruye'aab'.</para>
  <para style="q">
    <verse number="13" style="v" />Eh noq inq'orik inkitik'aa' cho choqik i suutz' kiye'wik chee jab' pan taxaaj.</para>
  <para style="q">Eh ruuk' ruq'oral i ruksaj taqe chaloq i suutz' chi junsut i wach ak'al,</para>
  <para style="q">i ruyeew taqe chaloq i ruch'aab' i kahoq noq k'ahchi' jab'.</para>
  <para style="q">Eh i resaj chaloq i teew aha' molik wii'.</para>
  <para style="q">
    <verse number="14" style="v" />Eh re' i tinamit ma' xta kina'ojb'al</para>
  <para style="q">ma' nkik'am ta naah i na'ojb'al i ruyeew i Dios.</para>
  <para style="q">Eh inki a'n i k'ixb'ilaal chi b'anarik,</para>
  <para style="q">inkiyejaa' taqe kitiyoox inkixuk'aa' kiib'</para>
  <para style="q">chuwach xama' xta wo' kajaawriik,</para>
  <para style="q">eh ma' k'achalkeeb' ta wo' hoq.</para>
  <para style="q">
    <verse number="15" style="v" />Xa je' taqe k'o'naal, ma' xta kitz'aaq,</para>
  <para style="q">junsachariik kiwach naa rub'aan ruuk' i kiyej-anik</para>
  <para style="q">reh na' chub'aan i q'ataj q'orik i QaJaaw Dios.</para>
  <para style="q">
    <verse number="16" style="v" />Eh re' ruDios i Jacob,</para>
  <para style="q">ma' je' ta kikab' taqe i tiyoox re' re',</para>
  <para style="q">ruum re' reh tz'uhk'risanik reh chu'nchel.</para>
  <para style="q">Eh re' reh xsik'wik cho kiwach i aj Israel chi rutinamiit,</para>
  <para style="q">eh Dios nim rajaawriik i rub'ihnaal.</para>
  <para style="s">Re' ruq'orariik chi naa rusachariik wach i tinamit Judá</para>
  <para style="q">
    <verse number="17" style="v" />Yu'naak taq i hat chamol wach i chib'ih taq aweh,</para>
  <para style="q">ruum naa taq ak'amariik reje pan tokoom tinamit</para>
  <para style="q">
    <verse number="18" style="v" />Ruum re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Yu'naak naa wesam taqe reje ayu' i tinamit wili,</para>
  <para style="q">naa nuye'em taqe panti' k'axik,</para>
  <para style="q">chi je' re' nee oon chee kinkisik' ruka'peech, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Re' tinamit je' wili i xuq'or:</para>
  <para style="q">Yohb'aal inche wach</para>
  <para style="q">i ti' k'axik naa ruchaliik chi qanaah ma' awach ta chik naa resaniik reh.</para>
  <para style="q">Re' hoj xqakapaaj naq chi naa qakuyum raansil taqe i re'.</para>
  <para style="q">
    <verse number="20" style="v" />Re' itz'ihy naah paat inqamol wii' qiib' naa ruyojib'iik</para>
  <para style="q">naakik'upib'iik taqe i ruk'ahamal.</para>
  <para style="q">Naakojiik taqe i tinamit ma' awach ta</para>
  <para style="q">chik naa rukorb'isaniik i qa itz'ihy naah paat.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Re' taqe i k'amal kib'eeh tinamit min min taqe chub'anariik inkaaj i keh,</para>
  <para style="q">ma' inkisik' taj i Dios,</para>
  <para style="q">ruum aj re' ma' kielik ta korik,</para>
  <para style="q">chu'nchel i kitinamiit xkitukej kiib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Eh k'ahchi' chik rib'iirjiik chi xa kichoqik chik xi k'uloq i aj ixowaal</para>
  <para style="q">chupaam i tinamit wilik pantz'eet reh i rookb'aal i q'iij,</para>
  <para style="q">chi rusachariik wach i tinamit Judá.</para>
  <para style="q">Eh naa kikanaam chi ma' xta chik i wilik chupaam,</para>
  <para style="q">naa kikanaam chi kiye'aab' i k'ichi'ahq, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />QaJaaw Dios re' hoj qeht'al noq re' winaq</para>
  <para style="q">ma' ehchan ta reh i ruk'achariik chi rib'il riib'.</para>
  <para style="q">Eh ma' re' tee reh naa ruq'oriik chib'ih jariik i naa ruchaliik chinaah.</para>
  <para style="q">
    <verse number="24" style="v" />Jaaw Dios xaruk'ul ta naq i ti' k'axik nee nayeew cho chi qanaah kojb'al qana'ojb'al.</para>
  <para style="q">Mayeew tii chaloq chu'nchel aajosq'iil chi qanaah reh chi ma' nee ta nasach qawach.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Chikinaah la' i tinamit ma' nkiyeew ta awajaawriik,</para>
  <para style="q">chayeew aajosq'iil.</para>
  <para style="q">Eh chinaah i ma' inkiq'or ta wib'iraal chayeew.</para>
  <para style="q">Ruum re' keh xkisach chik wach i tinamit</para>
  <para style="q">re' taqe i riih rumaam i Jacob</para>
  <para style="q">xkisach chik wach chi jumpech i tinamit, inki taqe.</para>
  <chapter number="11" style="c" />
  <para style="s">Re' tinamit ma' xkian taj i ruq'or i k'uhb'aal</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios xq'orik wuuk' i hin Jeremías, je' wili i xuq'or weh: <verse number="2" style="v" />Re' hat cha q'or keh i aj Israel chi kib'iraj chi korik i k'uhb'aal nuyejaam cho wach. Chaq'or wo' keh i aj Judá, i aj Jerusaleem. <verse number="3" style="v" />Chaq'or keh chi re' hin i Dios, ki Dios i aj Israel kinq'orik reh chi naa ruye'ariik pantojb'al mahk i ma' runimaj taj i ruq'or i k'uhb'aal nuyejaam cho wach. <verse number="4" style="v" />Re' k'uhb'aal wili nuyejaam cho wach kuuk' i kimaam kati't noq xwesaj taqe chaloq Egipto. Re' i tinamit, je' naq jinaj horna inkihaab'isaj wii' i ch'ihch' chi keh. Re' hin je' wili i xnuq'or keh: Kinanimaj taq cha a'n taq i nuq'or taq aweh, reh chi nee taq ti kahnik chi nutinamiit, eh re' hin nee kinkahnik taq chi hin aaDios. <verse number="5" style="v" />Eh wila' xanimaj taq i nuq'or taq aweh. Re' hin nee wo' nuyeew taq aweh i ye'aab', eh xnuq'or wo' cho keh xti korik taq aamaam awati't chi naa nuye'em taq aweh, re' i ye'aab' i nelik wii' i suq atoob' re' wilkaat taq wii' yu'naak, inki.</para>
  <para style="p">Eh re' hin je' wili ruchaq'weesjiik xnub'an: ma' xta reet Jaaw, kinki reh.</para>
  <para style="p">
    <verse number="6" style="v" />Je' wo' chik wili i xuq'or weh i QaJaaw: Re' hat cha q'or rib'iral aha' wilik i xnuq'or aweh, chupaam i tinamit Judá, je' wo' pantaq xilak b'eeh Jerusaleem, je' wili i cha q'or keh i tinamit: Chab'iraj taq nik' wach noq wilik i k'uhb'aal korjinaq cho wach, eh cha a'n taq aha' wilik i ruq'or, tiko'q keh. <verse number="7" style="v" />Noq xwesaj taqe chaloq Egipto i aamaam awati't xnuq'or wo' naq keh chi kinimaj aha' wilik xnuq'or keh, Xa re' wo' chupaam taqe i q'iij re' re' nutoq'aam cho ruq'orariik, eh yu'naak xa kok'achi' wo' nuq'orom taq aweh i hat chi tinimanoq taq. <verse number="8" style="v" />Xa re' la' re' keh xama' xkinimaj ta wo' hoq i xnuq'or keh ni xata xkinimaj, ruum i rukowiil i kinaah. Xa ma' nkikanaa' ta wo' rub'an i yiib' wach na'ojb'al inchalik pankanima. Ma' xkaaj ta kianam taqe i xnuq'or keh i hin, ruum i re' xnuyeew q'ab' chi xchalik chikinaah i ti' k'axik nuq'orom cho chupaam i k'uhb'aal nuyejaam wach kuuk', tiko'q keh, inki weh Dios.</para>
  <para style="p">
    <verse number="9" style="v" />Eh je' wo' chik wili i xuq'or weh: Re' taqe i tinamit wilkeeb' Judá, ruch'ihil taqe wilkeeb' Jerusaleem, wilik i ma' holohik taj k'ahchi' kianam chi nuwach. <verse number="10" style="v" />Re' keh k'ahchi' wo' kianam i mahk je' rukab' i xkian i kimaam kati't re' taqe i ma' xkaaj ta nunimjiik, re' chik taqe i tiyoox xkiloq'ej. Chi je' taqe aj Jerusaleem, chi je' taqe aj Judá ma' xkaaj ta kianam i ruq'or i nuk'uhb'aal nuyejaam wach kuuk' i kimaam kati't. <verse number="11" style="v" />Ruum aj re', re' hin naa nutaq'aam chaloq i runimaal ti' k'axik chikinaah, ma' naa ta rik'iik chikiij. Atoob' ta neenkik'er kichii' chupahqaljiik chi naa taqe nutob'eem re' hin xama' naa ta wo' nutoob'eem taqe. <verse number="12" style="v" />Eh noq naakilom chi je' re' taqe i aj Judá, ruch'ihil taqe i aj Jerusaleem naa rojiik kipahqaam kitoob'jiik keh taqe i tiyoox, re' taqe inkik'at i insensia chuwach. Xa re' la' ma' naa ta wo' kiko'ljiik kuum taqe i re' na' k'oloq i runimaal ti' k'axik chikinaah. <verse number="13" style="v" />Ruum re' taqe i aj Judá ju'jun kitiyoox wilik chupaam i ju'jun seht chi tinamit. Eh re' taqe i aj Jerusaleem rajlaal pantaq q'ab' b'eeh xkiyejaa' i ki altaar, reh chi nkik'at i insensia chuwach i tiyoox Baal.</para>
  <para style="p">
    <verse number="14" style="v" />Je' re' noq re' hat Jeremías maa a'n chik atiij chikiij i tinamit wili maa pahqaaj weh chi nee taqe nutob'eej. Ruum re' hin xama' naa ta wo' nutoob'eem taqe noq naa kipahqaam kitoob'jiik weh noq naa kiwihiik pa runimaal ti' k'axik.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />¿Chib'ih chik inkisik' panupaat i nutinamiit Israel?</para>
  <para style="q">Xanaah re' yohb'aal wach yib'kiil wach xib'anik chaloq.</para>
  <para style="q">¿Mi inkikapaaj re' keh, chi xa ruum chi neen kiyeew</para>
  <para style="q">i q'ina' i tiwik chi k'atoj mayiij chi nuwach</para>
  <para style="q">neenik'ik chikiij i runimaal ti' k'axik?</para>
  <para style="q">
    <verse number="16" style="v" />Pampeet, re' hin Dios i nukoj naq taqe i nutinamiit re' re'</para>
  <para style="q">chi je' kikab' i ruche'el i olivo q'e' inwachinik xa holohik chik.</para>
  <para style="q">Xa re' la' yu'naak naa nusacham kiwach i nutinamiit,</para>
  <para style="q">naa nub'anam keh je' rukab' imb'aan reh i olivo</para>
  <para style="q">noq ink'atarik i xaq ruuk' q'aaq', eh noq injehaarik i q'ab'.</para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" />Pampeet re' hin Dios wilik wajaawriik chikinaah chu'nchel, xinch'ikanik keh chi nutinamiit taqe. Eh yu'naak re' wo' chik i hin xin ye'janik wach i runimaal ti' k'axik naakik'ulum, ruum i yiib' wach na'ojb'al xkian i aj Judá, i aj Jerusaleem. Re' hin xin kiq'etwachej ruum xkik'at i insensia chuwach i tiyoox Baal, inki Dios.</para>
  <para style="s">Re' taqe i xi-ixowanik wach i Jeremías xkaaj naq kikansam</para>
  <para style="p">
    <verse number="18" style="v" />Re' i QaJaaw Dios xye'wik weh chi naab'jik chi re' taqe i ki-ixowanik nuwach wilik i ma' holohik taj k'achi' kiyejaam wach chi wiij je' re' noq xnunab'eej. <verse number="19" style="v" />Eh re' hin suq naq nuk'ux ma' xta naq i nukapaaj, je' rukab' i rak'uun tentzun noq ink'amarik reje pankanteesb'al. Eh ma' weht'al ta naq chi k'achi' kiyejaam wach nukanteesjiik kore' chik imb'iraj chi je' wili i xkiq'or: Yu'naak qasach wach chi jumpech, je' rukab' noq inyok'arik i chee' kosuq i k'ihik i rub'an reh chi ma' nee ta chik inq'orarik rib'iral chinaah i wach ak'al wili, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Eh re' hat QaJaaw Dios wilik awajaawriik, korik wach ak'ux chi q'ataj q'orik.</para>
  <para style="q">Eh aweht'al i wilik cho pankikapeb'aal pankanima i tinamit.</para>
  <para style="q">Re' hin inwaaj naq chi nee nak'uhtaaj weh</para>
  <para style="q">chi nee taqe nayeew chi tojariik i kimahk ruum re' hin panaq'ab' taqe nukanaa'.</para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" />Re' tinamit wilkeeb' cho Anatot k'ahchi' naq kisik'im chi riij nik' wach nukanteesjiik nakianam, re' taqe i ximinwik naq weh chupaam chi ma' naa ta chik nuq'orom awib'iral i hat QaJaaw Dios, ruum naq i re' xinkaaj kinkikansam, inki. <verse number="22" style="v" />Xa re' la' je' wili i xq'orarik keh ruum i QaJaaw Dios nim rajaawriik: Yu'naak taq i hat naa taq kaat nuye'em chutojariik amahk, re' taq ak'ijolaq ruuk' q'aslaj ch'ihch' naa kikimiik panq'aq'inik. Eh re' taqe awak'uun awixq'uun naakikimiik ruum wi'jaleel. <verse number="23" style="v" />Eh ma' jino'q taq chik aweh i naa kikahniik chi k'achalkeeb' ruum naa nuk'amam chaloq i runimaal ti' k'axik cha naah taq i hat, hat taq aj Anatot. Re' noq naa taq kaat nuye'em chutojariik taq amahk, inki.</para>
  <chapter number="12" style="c" />
  <para style="s">Re' i Jeremías xuq'oreej i Dios</para>
  <para style="q">
    <verse number="1" style="v" />QaJaaw Dios korik wach ak'ux,</para>
  <para style="q">xama' xta nkih chi nee tinuwech'uj.</para>
  <para style="q">Xa re' la' re' hin wilik i ma' suq ta inwilow, i ruk'ul chi naa nupahqaam aweh.</para>
  <para style="q">¿Chib'ih reet noq chu'nchel i nelik korik chikiwach i yiib' wach kina'ojb'al?</para>
  <para style="q">¿Chib'ih reet noq suq i wilkeeb' i tokoom chik inkinimaj?</para>
  <para style="q">
    <verse number="2" style="v" />Re' hat ti ye'wik keh wach ak'al kikoowjik,</para>
  <para style="q">ink'ihaaxb'ik i chib'ih keh, kib'ehomrik. Eh inkit'iosej tii chik aweh,</para>
  <para style="q">inki a'n kiib' xa re' la' xa chi kichii'</para>
  <para style="q">eh pankanima xama' tikikapaaj ta wo' k'isinoq.</para>
  <para style="q">
    <verse number="3" style="v" />Eh Jaaw re' hat aweht'al nik' wach noq wilkiin, eh inawilow i wánima.</para>
  <para style="q">Eh re' taqe i yiib' wach kina'ojb'al re' re' chakoj kehtaal</para>
  <para style="q">reh chi nee taqe nayeew panti' k'axik noq nee rureq i ruq'ijil.</para>
  <para style="q">Cha a'n kuuk' je' rukab' noq kik'amarik reje tentzun pankanteesb'al.</para>
  <para style="q">
    <verse number="4" style="v" />Eh ¿Nik' chik najtiil naa rub'anam chi xa je' chiq yuuq' i qa ye'aab'?</para>
  <para style="q">Re' taqe i ch'ahn kuxik chik ruchiqiik wataq yuuq' k'ixkaab'.</para>
  <para style="q">Re' taqe i chikop, re' taqe i tz'ikin k'ahchi' kikimik,</para>
  <para style="q">ruum i yiib' wach na'ojb'al inki a'n taqe i k'achareel, je' wili inkiq'or:</para>
  <para style="q">Re' Dios ma' rilow taj chib'ih inqa a'n, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Re' QaJaaw Dios je' wili nuchaq'weesjiik xub'an:</para>
  <para style="q">Wila' re' hat xat q'uhtik chupajariik awiib' kuuk'</para>
  <para style="q">xa chi kooq kib'ehik,</para>
  <para style="q">¿Nik' wach noq neenukuy rupajariik awiib' kuuk' i rij kawáyu wilkeeb'?</para>
  <para style="q">Eh wila' inchalik ruti'kiil ak'ux chupaam i ye'aab' ma' xta yohb'aal chupaam.</para>
  <para style="q">¿Chib'ih i naa a'nam chupaam i raxchee' wilik ar Jordán?</para>
  <para style="q">
    <verse number="6" style="v" />Eh re' taqe aawas, oon achaaq'</para>
  <para style="q">chu'nchel i awach aweh xi sutinik wo' chi ixowan awach.</para>
  <para style="q">Re' keh inkik'er kichii' chab'ajariik rij anaah,</para>
  <para style="q">ruum aj re' maach'ikaa' ak'ux kuuk'</para>
  <para style="q">atoob' ta xasuq chik neetikiq'oreej.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' hin xnukanaa' chik chi rutkeel i nutinamiit,</para>
  <para style="q">xnuq'eb' chik chi riij nuk'ux re' i hin naq kinehchanik reh.</para>
  <para style="q">Eh xnuq'asaj chik taqe pan kiq'ab' i aj ixowaal re' naq taqe q'e' nuk'ax.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taqe i tinamit re' re' je' chik kikab'</para>
  <para style="q">i josq'laj kaq b'ahlam wilkeeb' cho paraxchee' chi weh,</para>
  <para style="q">xankiqirich'eej chik naah ikehchi nunaah,</para>
  <para style="q">ruum aj re' xnuq'eb' taqe chi riij nuk'ux.</para>
  <para style="q">
    <verse number="9" style="v" />Re' taqe i nutinamiit naq naa nusacham kiwach</para>
  <para style="q">naa nutaq'aam taqe chaloq i k'uch, i</para>
  <para style="q">josq'laj chikop wilkeeb' pantaq rax chee'</para>
  <para style="q">naa ruk'uliik k'uxaroq i kiti'jolal.</para>
  <para style="q">
    <verse number="10" style="v" />Eh ma' kisiin taqe i k'amal b'eeh,</para>
  <para style="q">taqe i aj ixowaal xkisach wach i nutinamiit je' naq nu uuva noq wilkeeb'.</para>
  <para style="q">Xkich'uwareej paam,</para>
  <para style="q">xkikanaa' chi xa je' chik chiq yuuq' intz'irik paam,</para>
  <para style="q">i nuye'aab' q'e' nuk'ax.</para>
  <para style="q">
    <verse number="11" style="v" />Eh xkikanaa' i nutinamiit chi xa je' chik chiq yuuq' xan tz'irik chik paam.</para>
  <para style="q">Eh xb'iraj oq'ik inki a'n</para>
  <para style="q">ruum chu'nchel i tinamit ma' xta chik i wilik chupaam.</para>
  <para style="q">Ma' awach taj i ruchop ruk'ux chi neenkorjik.</para>
  <para style="q">
    <verse number="12" style="v" />Eh chinaah taqe i rub'ohl i yuuq k'ulik chik inki a'n iloq</para>
  <para style="q">taqe i aj ixowaal yohb'aal wach i kijosq'iil.</para>
  <para style="q">Je' re' noq re' hin je' naa ruuk' ch'ihch' k'ul q'as</para>
  <para style="q">naa nusacham kiwach i tinamit</para>
  <para style="q">ma' awach ta chik i naa rureqem rusuqkiil ruk'ux.</para>
  <para style="q">
    <verse number="13" style="v" />Eh noq naa kitikim i trigo k'iix chik i naruwachum</para>
  <para style="q">chu'nchel i kamanik naa kianam narojiik chi re' chi ma' re',</para>
  <para style="q">ma' xtaj i wach i kitik naakimolom, inki Dios.</para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" />Re' QaJaaw Dios je' wili i xuq'or chikiij i yiib' wach i kina'ojb'al, re' wilkeeb' chuka'jaah i Israel, re' taqe i xisachwik wach i ye'aab' i xnuyeew chi kikooch i nutinamiit Israel: Re' hin naa wesam taqe pan kitinamiit eh naa wesam taqe chaloq i aj Judá pankixilak. <verse number="15" style="v" />Xa re' la' noq wesam chik taqe chaloq pan kitinamiit naa wo' chik nuketelaam kiwach, naa wo' chik nuye'em q'ab' chi naa kisutiniik reje pan kiye'aab' eh pan kitinamiit <verse number="16" style="v" />Xti korik noq re' keh xik'uhtanik reh i nutinamiit chi parub'ihnaal chik i Baal inkiq'or i korik. Eh yu'naak nee wo' rub'an chi nee taqe nuk'ul chi kixilak i nutinamiit, xa re' la' mix ti korik keh chi neenkik'ulaa' nunimjiik je' rukab' inki a'n i nutinamiit, panub'ihnaal chik i hin neenkiq'or i korik. <verse number="17" style="v" />Eh re' taqe i tinamit ma' naa ta kinimaniik weh chi jumpech, naa nusacham kiwach, ma' xta chik kehtalil naa nukanaam, inki, QaJaaw Dios.</para>
  <chapter number="13" style="c" />
  <para style="s">Re' jalwaach q'orik chi riij i nim rooq itz'ihy b'ak'b'al pamis</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios je' wili xuq'or weh: Yu'naak Jeremías chaloq' jino'q i nim rooq itz'ihy b'ak'b'al pamis, re' ruuk' i lino chab'ak' reje panayejaal xa re' la' mat'aqsaj ruuk' ha', inki. <verse number="2" style="v" />Eh re' hin xnuloq' wo' hoq i nim rooq itz'ihy, je' rukab' i xuq'or weh QaJaaw, eh xnub'ak' wo' panuyejaal. <verse number="3" style="v" />Chi riij i re' xiruq'o'reej wo' chik chaloq i QaJaaw Dios je' wili i xuq'or weh: <verse number="4" style="v" />Yu'naak chak'am reje i nim rooq itz'ihy xaloq' chab'ak' panayejaal, hiy chi chii' i nim ha' Éufrates chakeb'aa' ar chupaam ruhopil ab'aj, inki. <verse number="5" style="v" />Eh re' hin xinooj wo' hoq chi chii' i nim ha' Éufrates, xnukeb'aa' wo' hoq nim rooq itz'ihy chupaam ab'aj je' rukab' i xuq'or weh i QaJaaw.</para>
  <para style="p">
    <verse number="6" style="v" />Eh noq k'ih laj q'iij chik ruponiik nukeb'aam je' wo' chik wili i xuq'or weh i QaJaaw Dios: Yu'naak hiy wo' chik chi chii' i nim ha' Éufrates chak'am wo' chik chaloq i nim rooq itz'ihy re' i xnuq'or aweh chi xponik i keb'aa' ar, inki. <verse number="7" style="v" />Eh re' i hin, xinooj wo' chik chi chii' i nim ha' Éufrates xtohq'ik nusik'im panak'al i nim rooq itz'ihy, eh xnureq wo' hoq xwisaj chaloq aha' naq nukeb'aam wii' xa re' la' q'ahinaq chik xama' xta chik kamaj.</para>
  <para style="p">
    <verse number="8" style="v" />Chi riij i re' je' wo' chik wili i xuq'or cho weh i QaJaaw Dios: <verse number="9" style="v" />Je' aj re' naa kikahniik i aj Judá ruch'ihil taqe i aj Jerusaleem noq naa wesam i runimaal kiwach. <verse number="10" style="v" />Re' i tinamit re' re' yiib' wach kina'ojb'al ma' xkian taj i xnuq'or keh. Eh ruum i rukowiil i kinaah xama' xkikanaa' ta wo' rub'aan i yiib' wach na'ojb'al wilik pankanima. Re' chik taqe i tiyoox xkinimaj, xkiloq'ej, re' keh naa kikahniik chi je' kikab' i nim rooq itz'ihy re' re' b'ak'b'al pamis xama' xta chik kamaj. <verse number="11" style="v" />Nik' wach noq i rujit' i paam i winaq ruuk' i nim rooq itz'ihy, je' wo' naq re' noq xnuchop taqe i aj Judá i hin, i aj Israel, reh naq chi naa nakiwihiik wuuk'. Re' naq xwaaj i hin chi naa kikahniik chi manlik nutinamiit. Reh naq chi naa kiye'em chi naab'jik i nub'ihnaal, ye'b'al nuloq'il, chi naa kiye'em runimaal nuwach. Xa re' la' re' keh xama' xinkinimaj ta wo' hoq, inki Dios.</para>
  <para style="s">Re' jalwaach q'orik chi riij i ikom inkinujisaj chi ha'</para>
  <para style="p">
    <verse number="12" style="v" />Eh je' wo' chik wili i xuq'or weh: Re' hat Jeremías naa aq'orom keh tinamit chi je' wili: Re' QaJaaw i qaDios i hoj, hoj aj Israel xuq'or chi chu'nchel kikoom naakinujiik chi riis uuva, inki, tiko'q keh. Re' taqe i aj Israel je' wili i naa kiq'orom aweh: Re' hoj xa qeht'al wo' hoq chi naa runujiik i qikoom chi riis uuva, inkoq taqe. <verse number="13" style="v" />Eh re' hat je' wili i cha q'or keh: Re' QaJaaw je' wili xuq'or: Re' ikom naa runujiik chi riis uuva rujal wach i ti' k'axik je' naa nuxohk'risam taqe chu'nchel i patim chupaam i tinamit wili, chi je' taqe wilkeeb' chi reyil, je' rukab' noq xwihik chi reyil i David, chi je' taqe k'amal rub'eeh aj tiij, chi je' taqe jalal naq nuq'oral, eh chu'nchel i patim Jerusaleem. <verse number="14" style="v" />Re' hin jumehq'iil naa nusacham kiwach je' rukab' noq impaxik i ak'al xaro k'ul inkiq'oj kiib' chi je' taqe ajaab'ees, chi je' taqe ak'uunb'ees elik wach naa nub'anam keh. Ma' naa ta nuketelaam kiwach junsachariik kiwach naa nub'anam, inki Dios tiko'q keh, inki.</para>
  <para style="s">Re' aj Israel xq'orarik keh ruum i Dios chib'ih i xkik'ul</para>
  <para style="q">
    <verse number="15" style="v" />Hat taq aj Israel, re' QaJaaw Dios kok'achi' taq kaat ruq'oreem</para>
  <para style="q">maa niimb'isaj taq awach chab'iraj taq chib'ih i ruq'or taq aweh.</para>
  <para style="q">
    <verse number="16" style="v" />Chayeew taq ruloq'il aaDios konee ruyeew riib' yu'naak</para>
  <para style="q">komajaa' i ruyeew chaloq i je' runimaal q'equm,</para>
  <para style="q">komajaa' ta nee inatoxk'iij taq aawooq</para>
  <para style="q">chinaah taqe i je' najt kinaah yuuq' ti yo'joq kuum.</para>
  <para style="q">Eh komajaa' wo' rusutej chi q'equm i saqum najtir intohq'ik taq awuy-eem.</para>
  <para style="q">
    <verse number="17" style="v" />Eh wii' ma' xata nimanik taq re' hin naawoq'iim chi ma' eht'alimaj</para>
  <para style="q">ruum taq aja'wachiil ma' k'isiin i riis naq'nuwach naa reliik</para>
  <para style="q">noq naawilom chi naa kik'amam reje</para>
  <para style="q">pan tokoom tinamit i rutinamiit QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Re' hin je' wili i xuq'or weh i Dios:</para>
  <para style="q">Yu'naak cha q'or reh i reey chi je' wili, je' wo' reh ixoq reey:</para>
  <para style="q">Yu'naak xelik chik awajaawriik ti tz'uun qohoq wach ak'al.</para>
  <para style="q">Ruum xelik chik aakorona wach anaah inye'wik naq runimaal awach, tiko'q reh.</para>
  <para style="q">
    <verse number="19" style="v" />Re' i tinamit Neguev kotimaj chik riij kuum i aj ixowaal</para>
  <para style="q">ma' awach ta chik i neerub'an ik'ik ar.</para>
  <para style="q">Eh chu'nchel i aj Judá xi k'amarik chik reje pankowlaj kamanik</para>
  <para style="q">ar pan tokoom tinamit.</para>
  <para style="q">
    <verse number="20" style="v" />Re' taq i hat chawilow taq reje i aj ixowaal k'ulik inki a'n iloq</para>
  <para style="q">pantz'eet reh i rookb'aal q'iij.</para>
  <para style="q">¿Aha' wilik i nutinamiit nuye'em taq aweh chi ilarik,</para>
  <para style="q">re' naq taqe inye'wik taq aholwochiil?</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Eh ¿Chib'ih i naa aq'orom taq i hat aj Jerusaleem</para>
  <para style="q">noq naa nuye'em q'ab' chi re' chik taqe i tinamit xatijej taq i hat</para>
  <para style="q">naa kokiik chi ajaab'esil taq cha naah? Eh ma' k'isiin ta naa rutiib'iik taq ak'ux</para>
  <para style="q">je' rukab' i ruti'kiil ixoq noq ink'ulik ruk'ux.</para>
  <para style="q">
    <verse number="22" style="v" />Re' taq i hat naa taq apahqaam chi je' wili:</para>
  <para style="q">¿Chib'ih reet inqak'ul chi je' wili? tiko'q taq.</para>
  <para style="q">Re' hin i nuq'or chi ruum chi xiik' naah yib'kiil wach taq amahk</para>
  <para style="q">naa taq kichopom anaah i aj ixowaal,</para>
  <para style="q">eh naa kikanaam chi ma' xta taq wilik aweh.</para>
  <para style="q">
    <verse number="23" style="v" />Re' q'eq chikop ma' nee ta rub'an chi nee rusutej chi saq i riij,</para>
  <para style="q">eh re' i nimlaj b'ahlam ma' nee ta rub'an chi neeresaj iloq i saq req'laq pariij.</para>
  <para style="q">Je' wo' re' taq i hat ma' nee ta wo' taq i na a'n i holohik chi b'anarik,</para>
  <para style="q">ruum hat taq chik okrinaq chub'aan i yiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="24" style="v" />Ruum aj re', re' hin naa nuye'em q'ab' chi k'ul taq naa atukem awiib'</para>
  <para style="q">je' rukab' noq inkutarik reje wulu' i rutuus ixiim</para>
  <para style="q">ruum i kowlaj teew inchalik panchiq yuuq'.</para>
  <para style="q">
    <verse number="25" style="v" />Re' taq i hat aj Israel je' taq re' naa ak'ulum,</para>
  <para style="q">re' taq i re' xawaaj chi naa nub'anam taq aweh</para>
  <para style="q">ruum xinsahchik taq panak'ux,</para>
  <para style="q">kuuk' chik taqe i tiyoox xayeew taq ak'ux.</para>
  <para style="q">
    <verse number="26" style="v" />Je' re' noq re' hin naa nukanaam chi ma' xta chik wilik taq aweh</para>
  <para style="q">naa nuye'em q'ab' chi naa taq ak'uhtaam ak'ixb'ilaal.</para>
  <para style="q">
    <verse number="27" style="v" />Re' hin xwilow chik i ch'uwarisanik wach aakaxáro taq i na a'n,</para>
  <para style="q">eh i nak'er taq aachii' chi q'orik,</para>
  <para style="q">chi xa re' i k'oyomal taq i na a'n.</para>
  <para style="q">Eh xaloq'ej taq i tiyoox chinaah taqe i rub'ohl i yuuq'.</para>
  <para style="q">Re' taq i hat aj Jerusaleem xiik' naah ti'kiil taq i naa ak'ulum</para>
  <para style="q">ruum ma' jaruuj taq xakanaa' taqe i ch'uwa' wach na'ojb'al, inki Dios.</para>
  <chapter number="14" style="c" />
  <para style="s">Re' noq ma' xub'an ta chik i jab', eh chiqik i ch'ahn wach ak'al</para>
  <para style="p">
    <verse number="1" style="v" />Ruum chi ma' rub'an ta chik i jab', re' i QaJaaw Dios je' wili xuq'or reh i Jeremías:</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' taqe i aj Judá xkikoj chik kiq'eq so' ruum</para>
  <para style="q">xkahnik chi ntz'irik paam i kitinamiit.</para>
  <para style="q">Eh xkipach'aa' kiib' wach ak'al i aj Jerusaleem</para>
  <para style="q">xak'erik chik kichii' chi oq'ik, ruum ma' inkireq ta chik kihaa'.</para>
  <para style="q">
    <verse number="3" style="v" />Re' taqe i b'ehomaq inkitaq'aaj i kajpooh chi k'amaj ha'</para>
  <para style="q">pantaq jul ha'</para>
  <para style="q">xa re' la' xama' nkireq ta wo' chaloq.</para>
  <para style="q">Eh kisutinik wo' chik chaloq ruuk' i kikoom chi ma' xta paam.</para>
  <para style="q">Xa yo'jik chik inki a'n xankib'ur chik i kiwach ruum kik'ixiik.</para>
  <para style="q">
    <verse number="4" style="v" />Re' ak'al k'ahchi' rutarib'iik</para>
  <para style="q">ruum ma' rub'an ta chik i jab' chupaam i qatinamiit.</para>
  <para style="q">Re' taqe i aj ab'ixoom xama' nkireq ta chik chi riij chib'ih i nakianam,</para>
  <para style="q">xankib'ur chik i kiwach ruum i ruti'kiil kik'ux.</para>
  <para style="q">
    <verse number="5" style="v" />Eh re' taqe ixoq keej kox-aasjik kak'uun</para>
  <para style="q">inkiq'eb' kahnoq i kak'uun,</para>
  <para style="q">ruum xkuxik ruchiqiik i ch'ahn inkik'ux.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taqe i b'uurux wilkeeb' naah taq yuuq'</para>
  <para style="q">xa chiqiij chik taqe ch'ahn chuwach,</para>
  <para style="q">xa teew chik inkijihq'aaj, je' rukab' inki a'n i k'ichi'ahq.</para>
  <para style="q">Xanchalik chik ruq'equmriik paam inaq'kiwach</para>
  <para style="q">ruum ma' inkireq ta chik i ch'ahn inkik'ux, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Re' tinamit je' wili i xkiq'or:</para>
  <para style="q">QaJaaw Dios, xti korik wo' chi xiik' naah i mahk xqa a'n chawach,</para>
  <para style="q">eh ma' xat qanimaj ta chi korik.</para>
  <para style="q">Xa re' la' inqapahqaaj otob'il aweh chi nee</para>
  <para style="q">ta tii qoh atoob'eej ye'b'al ruloq'il ab'ihnaal.</para>
  <para style="q">
    <verse number="8" style="v" />Re' hoj, i hoj aj Israel xa awuuk' wo' hat inqach'ikaa' qak'ux,</para>
  <para style="q">xa re' wo' hat ti ko'linik qeh panti' k'axik.</para>
  <para style="q">Eh yu'naak ¿Chib'ih reet noq ma' nakapaaj ta chik qatoob'jiik,</para>
  <para style="q">xa je' cho pan tokoom tinamit ti chalik</para>
  <para style="q">xa je' akab' i xa ik'al b'eeh xa junwar i nik'ik rub'an i na a'n qeh?</para>
  <para style="q">
    <verse number="9" style="v" />Eh ¿Chib'ih reet noq ina' a'n awiib' i hat chi je' rukab' i winaq yo'jik i rub'an,</para>
  <para style="q">eh chi je' rukab' soldado ma' nee ta rub'an i ko'linik?</para>
  <para style="q">QaJaaw Dios re' hoj qeht'al chi wilkaat quuk',</para>
  <para style="q">qoh atoob'eej tii qeh,</para>
  <para style="q">mansahchik panak'ux chi chu'nchel kinab'inik reh chi hoj aatinamiit, inki taqe.</para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" />Re' QaJaaw Dios je' wili i xuq'or chikiij i tinamit Israel: Re' tinamit re' re' xak'ul kiooj chub'aan i ma' holohik taj, ruum aj re' ma' mponik ta chi nuwach inki a'n Ruum aj re' yu'naak ink'ulik cho panuk'ux chu'nchel i kimahk, eh naa nuye'em taqe chutojariik, inki.</para>
  <para style="p">
    <verse number="11" style="v" />Eh re' QaJaaw Dios je' wili xuq'or weh: Re' hat maa pahqaaj chik akuyb'al weh chi nee taqe nutob'eej i tinamit re' re'. <verse number="12" style="v" />Eh atoob' ta neenkikuy kiwa' kihaa' chub'aan i kitiij, re' hin xama' nee ta wo' imb'iraj taqe, atoob' ta neenkiyeew i k'atoj chikop neen kiyeew i kimayiij chi nuwach xama' nee ta wo' imponik chi nuwach. Naa la' nusacham kiwach ruuk' q'aslaj ch'ihch' ruuk' wi'jaleel, ruuk' yab'ilaal, inki.</para>
  <para style="p">
    <verse number="13" style="v" />Re' hin je' wili i xuq'or: QaJaaw Dios re' taqe i jalal aq'oral k'ahchi' kiq'orom reh i tinamit chi ma' naa ta kikimiik panq'aq'inik, chi ma' naa ta kikimiik ruum wi'jaleel. Eh chi re' hat naa aye'wiik keh i suq laj k'acharik chupaam i ye'aab' wili, kinki reh.</para>
  <para style="p">
    <verse number="14" style="v" />Eh re' QaJaaw Dios je' wili i xuq'or weh: Re' taqe i jalal naq nuq'oral re' re' k'achi' kichukum i q'orik chi wiij. Re' taqe i re' ma' hin ta kintaaq'anik reje keh, ma' jank'al ta nuq'or keh chi naa kiq'orom i je' re', ma' jank'al ta nuq'oreej taqe. Eh ma' jank'al ta wo' ink'uhtjik chikiwach inkiq'or ruuk' jot'ooj, xama' xta ruk'am chaloq, inkiq'or rib'iral. <verse number="15" style="v" />Re' hin i Dios je' wili nuq'or chikiij: Re' keh panub'ihnaal tii chik i hin kiq'orik inki a'n kiib'. Xa ma' hin ta wo' kintaaq'inik reje keh. Re' taqe i kiq'orik reh chi ma' naa ta ruwihiik q'aq'inik, chi ma' naa ta ruwihiik wi'jaleel chupaam i tinamit wili. Re' taqe re' naa kikimiik panq'aq'inik, eh naa kikimik ruum wi'jaleel. <verse number="16" style="v" />Re' taqe i tinamit ki-ib'iriniik reh inkiq'or panq'aq'inik wo' naa kikimiik. Eh re' i kehk'een ruch'ihil taqe kak'uun kixq'uun, ruum wi'jaleel naa kikimiik. Re' i kiti'jolal naakikutariik xilak taq b'eeh ree tinamit Jerusaleem, ma' awach ta naa rumuq'aniik keh.</para>
  <para style="p">
    <verse number="17" style="v" />Eh re' hat je' wili i cha q'or keh i tinamit:</para>
  <para style="b" />
  <para style="q">Chi re' hin chi q'iij chi aq'ab'</para>
  <para style="q">naa woq'iim ruum i runimaal ti' k'axik</para>
  <para style="q">naakik'ulum i nutinamiit.</para>
  <para style="q">Eh ruum chi xiik' naah ti'kiil naa kiwihiik.</para>
  <para style="q">
    <verse number="18" style="v" />Noq naaweliik pantaq ab'iix naawilom wach</para>
  <para style="q">chi tuch'ulkeeb' ar i kiti'jolal taqe i naa kikimiik panq'aq'inik.</para>
  <para style="q">Eh noq naawik'iik pan tinamit naawilom chi wilik i kimik inki a'n ruum wi'jaleel.</para>
  <para style="q">Re' taqe i jalal naq nuq'oral taqe k'amal kib'eeh aj tiij k'ul kiooj pantaq tinamit,</para>
  <para style="q">eh ma' inkireq ta chi riij chib'ih reet noq je' re' i k'ahchi' ruk'ulariik.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Re' hin je' wili xnuq'or:</para>
  <para style="q">QaJaaw Dios, ¿Mi xti xaq'eb' chi riij ak'ux re' i tinamit Judá?</para>
  <para style="q">¿Mix q'uhtik ak'ux re' chi rilariik aatinamiit Sión?</para>
  <para style="q">¿Chib'ih reet noq xoj ayeew panti', eh ma' awach ta chik iniq'omanik qeh?</para>
  <para style="q">Re' hoj k'ahchi' naq quy-eem wihik pansuqkiil k'uxliis, xama' nqareq ta wo' hoq,</para>
  <para style="q">k'ahchi' naq quy-eem chi naa qakowjiik, qayo'jiik chik inchalik.</para>
  <para style="q">
    <verse number="20" style="v" />QaJaaw Dios, re' hoj inqanimaj inaq'or chi ma' k'isiin i qamahk,</para>
  <para style="q">ruum chi xqa a'n i yiib' wach na'ojb'al xk'uhtjik kahnoq qeh kuum i qamaam qati't,</para>
  <para style="q">xoj mahkunik chawach.</para>
  <para style="q">
    <verse number="21" style="v" />Reh chi neenqayeew aloq'il, maa qoh aq'eb' chi riij ak'ux,</para>
  <para style="q">ma' wixow wach aatinamiit ti' wilik wii',</para>
  <para style="q">k'oloq la' panak'ux ayejaam wach chi naa a'nam kuuk' maa yoj wach.</para>
  <para style="q">
    <verse number="22" style="v" />¿Mi wilik jino'q keh re' i tiyoox neen ye'wik chaloq i jab'?</para>
  <para style="q">¿Mi nee ruyeew chaloq re' i kowlaj jab' i taxaaj xa chi rib'il riib'?</para>
  <para style="q">QaJaaw Dios ¿Mi ma' re' re' hat ti ye'wik cho qeh i jab'?</para>
  <para style="q">¿Mi ma' re' re' hat i qaDios?</para>
  <para style="q">Re' hoj awuuk' i hat ch'iklik qak'ux</para>
  <para style="q">eh inquy-eej chi nakooj atoob'eem kinkih reh.</para>
  <chapter number="15" style="c" />
  <para style="s">Re' ruq'orariik rib'iral i ti' k'axik</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili nuchaq'wesjiik xub'an: Re' ta ne'chee Moisés, re' ta ne'chee Samuel xi wihik cho najtir, k'ahchi' chi q'orik wuuk' chikiij i tinamit wili xama' nee ta wo' naq inuketelaaj kiwach. Chaq'or keh chi kieloq reje chi nuwach. <verse number="2" style="v" />Eh wila' xkipahqaaj taq aweh chi aha' naa kojiik je' wili cha q'or keh: Re' QaJaaw je' wili ruq'or:</para>
  <para style="b" />
  <para style="q">Re' taqe i korjinaq wach chi yab'ilaal</para>
  <para style="q">naa rukansaniik keh, re' wo' re' naa rub'aniik keh.</para>
  <para style="q">Re' taqe i korjinaq wach chi panq'aq'inik naa kikimik, ar wo' naa kikimiik.</para>
  <para style="q">Re' taqe i korjinaq wach chi wi'jaleel,</para>
  <para style="q">naa rukansaniik keh re' wo' re' naa rub'aniik keh,</para>
  <para style="q">Re' i korjinaq wach chi naa kojiik pan tokoom tinamit, naa wo' kojiik.</para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" />Re' hin i Dios kijib' wach i ti' k'axik naa nutaq'aam cho chikinaah, re' naa kikanteesjiik panq'aq'inik, re' taqe tz'i' naa ruqeriniik reh i kiti'jolal, re' taqe i chikop wilik kixiik', re' taqe josq'laj chikop naa ruk'uxwiik reh i kiti'jolal. <verse number="4" style="v" />Re' hin naa nuye'em q'ab' chi xiik' naah yib'kiil wach naakilom chu'nchel i tinamit wach ak'al, ti' k'axik naa nuye'em chikinaah ruum i yiib' wach na'ojb'al xub'an ar Jerusaleem i kireey i aj Judá Manasés rub'ihnaal rak'uun i Ezequías.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Hat taq aj Jerusaleem na' chak'ul taq i re'.</para>
  <para style="q">¿Awach naa ruketeliniik taq awach?</para>
  <para style="q">¿Awach i ti' taq naa kaat rik'raam?</para>
  <para style="q">¿Awach naa resaniik taq aweh panti' k'axik?</para>
  <para style="q">
    <verse number="6" style="v" />Re' taq i hat xinsahchik taq panak'ux</para>
  <para style="q">xinaq'eb' ta chi riij ak'ux re' wili re' hin kinq'orik hin Dios,</para>
  <para style="q">xinq'uhtik taq chawuyub'jiik, ruum aj re' naa nuye'em i nuq'ab' taq cha naah</para>
  <para style="q">re' i rub'anariik taq aweh i ti' k'axik naa taq nusacham awach.</para>
  <para style="q">
    <verse number="7" style="v" />Re' hin naa nukutum taqe reje wulu' aatinamiit, je' inkutarik reje sohk'</para>
  <para style="q">eh naa nukanaam chi ma' xta chik tinamit chupaam i nutinamiit Jerusaleem</para>
  <para style="q">naa nusacham kiwach ruum ma' xkaaj ta chik sutinik cho wuuk'.</para>
  <para style="q">
    <verse number="8" style="v" />Eh ma' k'isiin taqe ixoq naa nukanaam chi ma' xta kib'ahiil,</para>
  <para style="q">ma' xata je' kik'ihaal i saniib' chi chii' palaw.</para>
  <para style="q">Eh xti manlik parusaqumaal i q'iij naa nuye'em i kimik</para>
  <para style="q">chikinaah i tuutb'ees, ak'uunb'ees, ixq'uunb'ees,</para>
  <para style="q">xa chi ma' keht'al naa nuye'em i ti' k'axik chikinaah.</para>
  <para style="q">
    <verse number="9" style="v" />Re' je' tuutb'ees wilik wuquub' rak'uun naa ruq'ehb'iik wach ak'al,</para>
  <para style="q">naa rukahniik chi ma' xta chik raansil.</para>
  <para style="q">Eh naa ruchaliik ruk'ixiik,</para>
  <para style="q">eh re' i rusuqkiil ruk'ux, naa rusutiniik chi ruti'kiil ruk'ux.</para>
  <para style="q">Eh wila' ko wilik keh i xi kahnik chi k'achalkeeb'</para>
  <para style="q">re' inixowanik kiwach naa rukansanik keh.</para>
  <para style="q">Re' wili xti korik ruum re' hin kinq'orik, inki Dios.</para>
  <para style="s">Re' Jeremías xuk'er chii' ruum ruti'kiil ruk'ux</para>
  <para style="q">
    <verse number="10" style="v" />Re' Jeremías je' wili xuq'or:</para>
  <para style="q">Hat nutuut, re' hin ma' nukuy ta chik i ruti'kiil nuk'ux,</para>
  <para style="q">i ruk'ul naq chi ma' xin-aasjik taj</para>
  <para style="q">ruum xa re' peleto i nub'an kuuk' i tinamit.</para>
  <para style="q">Ma' awach ta uuk' nukemelem nutumiin,</para>
  <para style="q">eh ma' awach taj i rukemelem rutumiin wuuk'.</para>
  <para style="q">Xa re' la' xa chu'nchel chik ma' holohik ta kiq'orik chi wiij.</para>
  <para style="q">
    <verse number="11" style="v" />QaJaaw Dios ma' xta naq reet inki a'n weh chi je' re'</para>
  <para style="q">wita ma' k'ahchi' kaat nunimam chi korik</para>
  <para style="q">wita ma' nupahqaam aweh chi naa taqe atoob'eem</para>
  <para style="q">i ki-ixowanik nuwach re' re' noq ti' i kik'ux, noq k'axik wilkeeb', inki.</para>
  <para style="s">Re' QaJaaw Dios xuq'or rib'iral chi naa ruye'em i ti' k'axik chikinaah i aj Israel</para>
  <para style="q">
    <verse number="12" style="v" />Re' QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">¿Mi wilik neenq'atwik wach i tinamit naa kichaliik pantz'eet reh i rookb'aal q'iij</para>
  <para style="q">xiik' naah kikowiil je' kikowiil i rax ch'ihch', eh je' kikowiil i q'an ch'ihch'?</para>
  <para style="q">
    <verse number="13" style="v" />Eh re' taq i hat xat mahkunik taq, re' taq ab'ehomal</para>
  <para style="q">naa nuq'asam pan kiq'ab' i ki-ixowanik taq awach</para>
  <para style="q">re' q'e' k'ih tz'aaq taq cha weh i wilik chupaam taq aatinamiit.</para>
  <para style="q">Eh xa chi siih naa kik'amam reje.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hin naa nuye'em q'ab' chi re' chik taqe i ki-ixowanik awach</para>
  <para style="q">naakichopwiik taq anaah,</para>
  <para style="q">chupaam i ye'aab' ma' aweht'al ta taq i hat,</para>
  <para style="q">ruum ma' k'isiin ta noq xqop i nujosq'iil taq cha naah</para>
  <para style="q">xa je' chik rukab' i q'aaq' xa re' yu' ink'atwik, inki.</para>
  <para style="s">Re' Jeremías xupahqaaj ree Dios chi naa rutoob'jiik</para>
  <para style="q">
    <verse number="15" style="v" />QaJaaw Dios, re' hat aweht'al chib'ih jariik</para>
  <para style="q">i k'ahchi' nuk'ulum, je' re' noq kinatoob'eej tii,</para>
  <para style="q">chaq'aj wach keh inki a'n weh i aj ixowaal.</para>
  <para style="q">Eh cha a'n cho kuuk' chi jumehq'iil reh chi ma' nee ta kinkikansaj i hin.</para>
  <para style="q">Re' hat aweht'al chi ruum animjiik i nukuy i pajarik.</para>
  <para style="q">
    <verse number="16" style="v" />Noq imb'iraj aq'oral ruuk' i re'</para>
  <para style="q">i nuk'uxlaaj wiib' panuxlab'al,</para>
  <para style="q">re' wo' re' inye'wik rusuqkiil i wánima q'e' ti' wilik.</para>
  <para style="q">Cha a'n tii otob'il weh Jaaw nim awajaawriik ruum hin wo' tii awak'uun.</para>
  <para style="q">
    <verse number="17" style="v" />Re' hin ma' inwuch'ihleej ta chik taqe i xa re' i ninq'ijinik inkik'ax wach.</para>
  <para style="q">Xa re' wo' noq xinawehchaaj chi hin awak'uun ma' numin ta wiib' xa aha'.</para>
  <para style="q">Xa re' la' chik i hat xti xiik' wo' chik naah</para>
  <para style="q">aajosq'iil xayeew cho chi nunaah.</para>
  <para style="q">
    <verse number="18" style="v" />Jaaw, ¿Chib'ih reet noq ma' hi'lik ta wach i nuti'kiil?</para>
  <para style="q">¿Chib'ih reet noq ma' nik'ik taj i nuti'kiil ma' xata riq'omal iraaj?</para>
  <para style="q">Eh re' hat chi weh i hin xat sutinik chi</para>
  <para style="q">xa je' hat jinaj rooq ha' xa ik'ik i rub'an, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Re' i QaJaaw Dios je' wili xuq'or weh:</para>
  <para style="q">Wila' xat sutinik wo' chik cho wuuk' neenwik'saj aati'kiil,</para>
  <para style="q">wila' xakanaa' i ma' holohik ta laj q'orik,</para>
  <para style="q">eh mi xa re' chik i holohik i neenaq'or neerub'an chi neena a'n i nukamaj.</para>
  <para style="q">Xa nee wo' tii kahnik chi hat jalal nuq'oral,</para>
  <para style="q">re' taqe i ki-ixowanik awach naakinimaniik chawach,</para>
  <para style="q">ma' re' tee hat naa animaniik chikiwach i keh.</para>
  <para style="q">
    <verse number="20" style="v" />Re' hin naa kaat nukanaam chi</para>
  <para style="q">je' rukab' i koraal re' ruuk' i q'an ch'ihch' ma' xta nee ruk'ul,</para>
  <para style="q">re' i tinamit re' re', naa naq kianam aweh ruuk' q'aq'inik</para>
  <para style="q">xa re' la' xama' xta wo' naa kaat kuchem,</para>
  <para style="q">ruum re' hin naa nuwihiik awuuk' cha toob'jiik, eh chako'ljiik.</para>
  <para style="q">
    <verse number="21" style="v" />Eh naa wo' kaat nuko'leem pan kiq'ab' i yiib' wach kina'ojb'al,</para>
  <para style="q">naa wo' kaat nuko'leem chuwach i kijosq'iil taqe i aj ixowaal, inki weh i Dios.</para>
  <chapter number="16" style="c" />
  <para style="s">Re' ti' k'axik xchalik chikinaah i tinamit Judá</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios je' wili i xuq'or weh: <verse number="2" style="v" />Re' hat ma' naa ta sik'im awehk'een chupaam i tinamit wili, eh ma' ruyeew ta riib' chi neen wihik awak'uun awixq'uun ayu'. <verse number="3" style="v" />Ruum re' hin i Dios i nuq'or chib'ih inakik'ulum taqe ak'un, xq'un naa kaasjiik chupaam i tinamit wili, je' wo' hoq inakik'ulum i kituut kajaaw. <verse number="4" style="v" />Re' keh yiib' wach yab'ilaal naa rukasaniik keh, ma' awach taj naa roq'iim chikiij, eh ma' naa ta kimuhqik. Xa aha' naa rukahniik tuch'ulkeeb' i kiti'jolal wach ak'al chi je' rusaa' chikop. Re' q'aq'inik, re' i wi'jaleel naa rusachwiik kiwach, re' kiti'jolal naa ruk'uxariik kuum i chikop wilik kixiik', eh kuum taqe i josq'laj chikop, inki.</para>
  <para style="p">
    <verse number="5" style="v" />Re' QaJaaw Dios je' wo' chik wili i xuq'or weh: Re' hat mat ik'ik i koq chupaam i paat aha' kikojom ikiq'eq so'. Eh ma' naa ta woq'em ma' naa ta ak'uhtaam chi naa rutib'iik ak'ux chi riij awach i naa rukimiik keh. Ruum re' hin wesam chik chinaah i tinamit wili i suq kiil k'uxliis, i nuk'axb'al, i ketelinik wachiis i nub'an, inki. <verse number="6" style="v" />Je' re' noq chi nimaq chi kok' taq naa kikimiik chupaam i tinamit wili, eh ma' awach ta naa rumuq'aniik keh, ma' naa ta kooq'jiik, ma' naa ta kiyok'om wach i kiti'jolal, ma' awach taj i naa ruyok'om i rismaal i kinaah ruum i ruti'kiil kik'ux chikiij. <verse number="7" style="v" />Eh ni xata naakimolom kiib' chi wi'k noq naakicha'jeem i kamnaq ye'b'al rusuqkiil kik'ux taqe i awach reh i xkimik. Eh ni xata naa ruye'ariik keh chi uuk'jik i riis uuva ye'b'al rusuqkiil kik'ux, chi riij i rukimiik i kituut i kajaaw. <verse number="8" style="v" />Je' wo' i hat ma' naa ta wo' awokiik i koq kuuk' aha' kimolom kiib' chi wi'k oon chi uk'ik, ma' naa ta tzunaam awiib' chi kixilak. <verse number="9" style="v" />Ruum re' hin i Dios nim wajaawriik, kiDios i aj Israel, i nuq'or chi chupaam i tinamit wili naa rumahyiik i tz'uuy pantaq ninq'iij, je' wo' hoq i rusuqkiil k'uxliis, je' wo' i tz'uuy reh kaxáro. Eh xti manlik paruq'ijil naa ruk'ulariik, re' taq i hat naa taq awilom ruuk' naq'awach.</para>
  <para style="p">
    <verse number="10" style="v" />Eh noq naa aq'orom rib'iral keh i tinamit wili, naa kipahqaam aweh chi je' wili: ¿Chib'ih reet noq xuq'or i Dios chi naa ruye'em chi qanaah i runimaal ti' k'axik re' re'? ¿Chib'ih i ma' holohik taj xqa a'n chuwach? ¿Chib'ih i mahk xoj q'ehb'ik wii' chuwach i QaJaaw, re' i qaDios? inko'q taqe. <verse number="11" style="v" />Re' hat je' wili i naa aq'orom keh, re' QaJaaw Dios je' wili i xuq'or: Re' hin je' re' i naa nub'anam keh, ruum re' taqe i kimaam kati't xin kiq'eb' chi riij kik'ux, re' chik taqe i tiyoox xtohq'ik kinimam, eh xtohq'ik kiloq'em. Eh re' hin xin kiq'eb' chi jumpech, ma' xkinimaj taj i nuk'uhb'aal xnutijej taqe wii'. <verse number="12" style="v" />Eh re' keh xti xiik' wo' chik naah yib'kiil wach kib'anik chikiwach i kimaam kati't, ruum i rukowiil i kinaah xkitoq'aa' rub'aan i ma' holohik ta chi b'anarik, re' i nelik cho pankanima. Ma' xinkaaj ta kinkinimam. <verse number="13" style="v" />Ruum aj re', re' hin naa wesam taqe reje chupaam i ye'aab' wili naa nutaq'aam taqe reje chupaam i tinamit ma' keht'al taj i keh. Eh ni xata re' i kimaam kati't xinab'inik cho reh, eh ar chi q'iij chi aq'ab' naa kiloq'em taqe i tiyoox, ruum aj re' ma' naa ta nuketelaam kiwach inki taq chawiij, tiko'q keh.</para>
  <para style="p">
    <verse number="14" style="v" />Eh naa ruponiik i q'iij chi ma' naa ta chik kiq'orom chi je' wili: Tik'achlik i QaJaaw Dios i x-esanik cho keh i aj Israel ar Egipto ma' ko'q ta chik taqe. <verse number="15" style="v" />Je' la' wili i neenkiq'or: K'achlik i QaJaaw Dios x-esanik cho keh i aj Israel chupaam i tinamit wilik chaloq pantz'eet reje reh rookb'aal i q'iij, resaj wo' chaloq i rutinamiit chupaam i tinamit aha' kitukem wii' kiib' inko'q ta taqe. Chi je' re', re' hin naa wo' chik taq kaat nuk'amam chaloq chupaam taq aaye'aab' re' i nuye'em cho keh taq aamaam awati't.</para>
  <para style="p">
    <verse number="16" style="v" />Xa re' la' re' hin i Dios naa nutaq'aam reje k'ih-oq i sik'il taq aweh aha' pa' akeb'aam taq awiib', naa taq kaat tikichop chaloq, je' rukab' i aj karineel noq i ruchop i kar. Eh je' rukab' inki a'n i kiooj aj chikop panch'ahn korehtaal inki a'n cho reh. Re' taqe aj sik'ool re' re' naa taq kaat rojiik kesam pantaq raxchee' nah taq yuuq', chupaam taqe i ruhopil ab'aj. <verse number="17" style="v" />Ruum re' hin inwilow chi ma' holohik ta taq tib'anik, eh inwilow chu'nchel taq i yiib' wach na'ojb'al taq i na a'n, ma' xtaj inkahnik pankeliik chi nuwach. <verse number="18" style="v" />Eh re' hin xiik' naah ti'kiil naa nuq'ajam wii' wach taq aweh ayiib' wach na'ojb'al, ruch'ihil taq amahk, ruum xa ch'uwareej taq wach i nuye'aab' ruuk' i yiib' wach kilooq'jiik taqe kamnaq tiyoox taq xa a'n ar. Eh chupaam chu'nchel i ye'aab' xnuyeew taq aweh chi akooch xa a'n taq i yiib' wach na'ojb'al ma' imponik ta chi nuwach inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Re' Jeremías je' wili xuq'or:</para>
  <para style="q">QaJaaw Dios, hat ye'el nukowiil, hat toob'en weh,</para>
  <para style="q">hat ko'len weh nik' wilkiin panyohb'aal.</para>
  <para style="q">Awuuk' i hat naa kichaliik taqe i tinamit wach ak'al, je' wili i naa kiq'orom aweh:</para>
  <para style="q">¿Mi xa re' wo' taqe i tiyoox xama' xta kajaawriik</para>
  <para style="q">xkik'ul chi kikooch i qamaam kati't?</para>
  <para style="q">
    <verse number="20" style="v" />¿Mi neerub'an re' chi xa neeruyejaa' rudios i winaq?</para>
  <para style="q">Re' dios inkiyejaa' i keh ma' re' ta wo' taqe korik laj dios inko'q taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Re' QaJaaw Dios je' wili i xuq'or weh:</para>
  <para style="q">Ruum aj re', re' hin naa nuk'uhtaam chi manlik i wajaawriik taq chawach.</para>
  <para style="q">Reh chi naa taq anab'eem chi re' i nub'ihnaal ajaab'ees Dios, inki.</para>
  <chapter number="17" style="c" />
  <para style="s">Re' i mahk, re' i ti' k'axik xye'arik cho chikinaah i aj Judá</para>
  <para style="q">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' taq amahk i hat aj Judá je' naa ruuk' q'as ju' ch'ihch',</para>
  <para style="q">ruuk' i q'as ju' holohaq ab'aj k'otooj ruye'aab' chupaam taq awánima,</para>
  <para style="q">je' wo' chuwach i ruk'aa' taq artaal.</para>
  <para style="q">
    <verse number="2" style="v" />Re' taq awak'uun awixq'uun ma' inkimay taj i mahk</para>
  <para style="q">xank'ulik wo' pankik'ux i kiartaal, i kitiyoox Asera</para>
  <para style="q">inkiyeew ruloq'il chi ri'sil taqe i nimaq taq chee'</para>
  <para style="q">eh chikinaah taqe inajt kinaah yuuq'.</para>
  <para style="q">
    <verse number="3" style="v" />Chinaah taqe i rax chee' pantaq ab'iix.</para>
  <para style="q">Eh ruum taq amahk i na a'n naa nuye'em q'ab' chi naa kelq'aam</para>
  <para style="q">taq ab'ehomal.</para>
  <para style="q">Eh chi naa kelq'aam paam i rupaat taq atiyoox</para>
  <para style="q">wilkeeb' chupaam chu'nchel i taq aatinamiit.</para>
  <para style="q">
    <verse number="4" style="v" />Eh naa taq akanaam kahnoq aa ye'aab' nuye'em taq chi akooch,</para>
  <para style="q">eh re' chik i ki-ixowinik taq awach</para>
  <para style="q">naakitaaq'aniik taq aweh chupaam i ye'aab'</para>
  <para style="q">ma' aweht'al ta taq. Ruum re' nujosq'iil</para>
  <para style="q">yohb'aal wach noq xqop,</para>
  <para style="q">xa je' chik rukab' i q'aaq' imb'anik sachooj, inki i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh je' wo' chik wili i xuq'or:</para>
  <para style="q">Q'e' ti' inaruk'ulum awach i resaj i ránima wuuk' i hin,</para>
  <para style="q">ruuk' chik i xa winaq i ruyeew ruk'ux,</para>
  <para style="q">ar chik i rusik' toob'al reh.</para>
  <para style="q">
    <verse number="6" style="v" />Re' imb'anik reh i je' re', naa rukahniik chi je' rukab' i kaq k'iix</para>
  <para style="q">wilik chupaam i ye'aab' chiq yuuq' ma' awach ta incha'jinik reh.</para>
  <para style="q">Eh xilak taq ab'aj ink'ihik johtoq chupaam i sahaab' paam ak'al</para>
  <para style="q">ma' awach taj i patim chupaam.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Eh awach i ruyeew ruk'ux wuuk' i hin naa ruk'ulum i wotob'il,</para>
  <para style="q">eh wuuk' i hin i ruch'ikaa' ruk'ux.</para>
  <para style="q">
    <verse number="8" style="v" />Re' reh je' rukab' i chee'</para>
  <para style="q">tikooj chii' rooq ha' inooj reje i raa' chii' ha',</para>
  <para style="q">ma' xta ruk'ul noq inchalik</para>
  <para style="q">i rutz'ahiil i q'iij xa eliik rax wach i xaq.</para>
  <para style="q">Eh noq inchiqik taqe i yuuq' k'ixkaab' xama' xta wo' ruk'ul,</para>
  <para style="q">xama' rukanaa' ta wo' wachinik.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Eh ma' xta chik jino'q imb'anik jot'ooj</para>
  <para style="q">chuwach i ma' holohik taj wilik cho pan ánima.</para>
  <para style="q">¿Mi wilik jino'q neenab'inik reh i ánima?</para>
  <para style="q">
    <verse number="10" style="v" />Re' hin i Dios ra'j weht'al re' chib'ih i wilik cho pan ánima,</para>
  <para style="q">i wilik cho chupaam i kapeb'al,</para>
  <para style="q">eh naa nuye'em i rutojb'aal i ju'jun je' rukab' i ruk'ul chi reh,</para>
  <para style="q">re' q'oreel chib'ih i xub'an, chib'ih i xuq'or inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Awach i rureq i rub'ehomal ma' re' ta parub'ehel,</para>
  <para style="q">i rub'an reh je' rukab' i rub'an i tz'ikin</para>
  <para style="q">i rumoheej i miloj ma' re' tee reh xk'otwik reh.</para>
  <para style="q">Re' reh panyejaal i ruk'achariik naa rukanaam kahnoq i rub'ehomal,</para>
  <para style="q">ar naa ruk'utiniik chi ma' xta runa'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Re' i rupaat i qaDios i hoj xiik' naah loq'il xanoq wo' pampeet xye'arik runimaal wach,</para>
  <para style="q">re' i santo laj ye'aab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />QaJaaw Dios awuuk' hat inqach'ikaa' qak'ux i hoj aj Israel,</para>
  <para style="q">eh chu'nchel i xat kiq'eb' chi riij kik'ux naa ruk'uhtjiik kik'ixb'ilaal.</para>
  <para style="q">Eh re' inkimay animjiik xa je' pampooq tz'ihb'amaj i kib'ihnaal,</para>
  <para style="q">ruum chi xat kiq'eb' i hat i je' naq hat jinaj k'achlik raasb'al ha' chi keh.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />QaJaaw Dios cha kuy kinak'achrisaj tii, chi je' re' neekink'achjik.</para>
  <para style="q">Eh kinako'leej tii, chi je' re' neekinko'ljik</para>
  <para style="q">ruum re' hin xa re' wo' hat i nuyeew aloq'il.</para>
  <para style="q">
    <verse number="15" style="v" />Re' tinamit je' wili inkiq'or weh:</para>
  <para style="q">¿Chib'ih reet noq ma' nqak'ul taj i ruq'or rib'iral qeh i Dios?</para>
  <para style="q">Re' hoj inqaaj qilom chi nenooj eloq wach yu'naak, inki taqe.</para>
  <para style="q">
    <verse number="16" style="v" />Re' hin ma' xnupahqaaj taa weh</para>
  <para style="q">chi naa nuyeew i ti' k'axik chikinaah,</para>
  <para style="q">ma' inwaaj taj chi neenkik'ul i ti' k'axik,</para>
  <para style="q">re' hat aweht'al chi re' taqe i xnuq'or</para>
  <para style="q">chi na kik'ulum re' wo' hat xat q'orik weh.</para>
  <para style="q">
    <verse number="17" style="v" />Jaaw maa kinayohb'isaj cho ruuk' aajosq'iil,</para>
  <para style="q">ruum xa awuuk' wo' hat inusik' ko'lemb'al wiib' noq inchalik i ti' k'axik chi nunaah.</para>
  <para style="q">
    <verse number="18" style="v" />Eh re' taqe i ki-ixowanik nuwach cha kanaa' taqe pank'ixb'ilaal,</para>
  <para style="q">ma' re' taj i hin.</para>
  <para style="q">Re' keh chayohb'isaj taqe ruuk' aajosq'iil, ma' re' taj i hin.</para>
  <para style="q">Xa k'ahchi'-oq aye'em i runimaal ti'kiil k'uxliis,</para>
  <para style="q">chikinaah.</para>
  <para style="s">Re' i ruk'ul chi b'anarik eh re' ma' ruk'ul ta chi b'anarik panhi'limb'al q'iij</para>
  <para style="p">
    <verse number="19" style="v" />Re' QaJaaw Dios je' wili i xuq'or weh: Yu'naak hiy chapab'aa' awiib' panookb'al reh i tinamit Judá re' kiokik i kielik wii' taqe i reey, eh nee wo' nooj apab'aa' awiib' chi chii' taqe i ookb'al reh i tinamit Jerusaleem. <verse number="20" style="v" />Eh je' wili i neenaq'or keh i tinamit, je' wo' keh taqe i reey, je' wo' keh i aj Judá, je' wo' keh i aj Jerusaleem: neeki okik i koq chupaam taqe i ookb'al re' re'. Chab'iraj taq i ruq'oral i QaJaaw Dios. <verse number="21" style="v" />Re' QaJaaw je' wili i xuq'or: Chaketelaaj taq wach aak'achariik maa k'am taq reje ihq chupaam i hi'limb'al q'iij, ma' naa ta wo' taq ak'amam reje chupaam taqe i ookb'al re' i tinamit Jerusaleem. <verse number="22" style="v" />Eh maa wesaj taq chaloq jino'q i ihq panapaat, eh ma' xta jino'q i kamanik naa a'nam. Naa la' taq akanaam chi loq'oomb'al weh i hi'limb'al q'iij re' re', je' rukab' i xnuq'or keh taq aamaam awati't chi naa kianam. <verse number="23" style="v" />Xa re' la' re' keh xama' xkian ta wo' hoq i xnuq'or keh, ni xata xinkinimaj. Eh ruum i rukowiil i kinaah ma' xkik'am ta naah i nuk'uhb'aal.</para>
  <para style="p">
    <verse number="24" style="v" />Re' hin i Dios kinq'orik chi kinanimaj taq i hat, maa k'am taq reje jino'q i ihq pantaq ookb'al reh i tinamit Jerusaleem chupaam i hi'limb'al q'iij. Cha kanaa' taq chi loq'oomb'al weh, ma' jino'q i kamanik taq naa a'nam chupaam. <verse number="25" style="v" />Eh wila' xa a'n taq i je' re', chi juneliik naa ruwihiik taq aareey je' rukab' noq xwihik i reey David. Pan kareta xoyimaj, eh rij kawáyu wilkeeb' noq naakokiik pantaq ookb'al reh i tinamit wili kuch'ihil taqe i k'amal b'eeh kuch'ihil taqe i aj Judá. Je' wo' taqe i aj Jerusaleem, chi je' re' junelik naa ruwihiik patineel Jerusaleem. <verse number="26" style="v" />Wilik inaakichaliik pan tinamit Judá, re' taqe i wilkeeb' chi junsuut i Jerusaleem, pan tinamit Benjamín, wach k'ixkaab' wilik wii' i rax chee' ar Neguev. Eh naa kik'amam cho chi kimayiij taqe i k'atoj chikop, eh wilik xa chi naq'wach i kitik, wilik insensia naa kik'amam cho chi kimayiij chupaam i ye'aab' chi ye'b'al nuloq'il. <verse number="27" style="v" />Eh wi ma' xanimaj taq i hat i nuk'uhb'aal, wila' ma' xakanaa' taq chi loq'oomb'al weh i hi'limb'al q'iij, eh wila' ma' xakanaa' taq i kojooj ihq chupaam taqe i ookb'al reh i tinamit Jerusaleem. Re' hin naa nukojom ruq'aq'al taqe i ookb'al reh i tinamit re' re', eh re' q'aaq re' re' naruk'atwiik reh taqe i paat imb'aan wii' i q'ataj q'orik ma' awach ta chik naa ruchupwiik reh, tiko'q keh, inki weh i Dios.</para>
  <chapter number="18" style="c" />
  <para style="s">Re' i QaJaaw Dios xujalwachej riib' ruuk' i yej-an ak'al xun</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or weh: <verse number="2" style="v" />Re' hat hiy qohoq parupaat i aj yej-an ak'al xun, ar nee nuch'ob' rub'ehel aweh i nuk'uhb'aal, inki. <verse number="3" style="v" />Eh re' hin xinqajik wo' qohoq, xponik nureq i yej-an ak'al xun chi k'ahchi' ruyuq'um paam i lech'ik laj ch'uwa' chinaah i rukamamb'aal. <verse number="4" style="v" />Eh xwilow noq k'ahchi' naq ruyejaam i xun ruuk' i lech'ik laj ch'uwa', inyoj wo' chik chuwach, eh intohq'ik wo' chik ruyejaam tokoom ruuk' i lech'ik laj ch'uwa' re' re'. Korehtaal xkorjik chuwach xti nik' wach iraaj i reh.</para>
  <para style="p">
    <verse number="5" style="v" />Noq k'achi' wilom i re' je' wili i xuq'or weh i QaJaaw Dios: <verse number="6" style="v" />Hat taq aj Israel, ¿Mi ma' nee taq i nub'an awuuk' re' je' rukab' i rub'an i aj yej-an xun ruuk' i lech'ik laj ch'uwa' re' re'? Re' taq i hat chanab'eej taq chi xa je' taq hat lech'ik laj ch'uwa' panuq'ab', je' rukab' lech'ik laj ch'uwa' pan q'ab' i yej-an xun, re' re'. <figure style="fig" desc="" file="HQ00139" size="COL" loc="" copy="" ref="(18.6)">Re' taq i hat je' taq hat lech'ik laj ch'uwak' panuq'ab'.</figure> <verse number="7" style="v" />Re' hin wilik pech xa chi jumehq'iil i nuq'or chi naa ruchopariik naah, chi naa ruyojiik wach, eh chi naa rusachariik wach junseht-oq i tinamit oon jino'q i reey chopen naah i tinamit. <verse number="8" style="v" />Eh wila' xkikanaa' i yiib' wach na'ojb'al inki a'n taqe i tinamit re' re' nee wo' chik inwisaj chikinaah i ti' k'axik ma' nee ta i nusach kiwach, je' naq rukab' nuyejaam cho wach. <verse number="9" style="v" />Eh jumehq'iil wo' neenuq'or chi nee taqe nuch'ikaa' chi nee taqe nuk'ihaaxb'isaj taqe i tinamit re' re', je' wo' taqe i reey. <verse number="10" style="v" />Eh wila' xkian i ma' holohik ta laj na'ojb'al, eh wila' ma' xkinimaj i nuq'or. Re' hin ma' naa ta nuye'em i wotob'il chikinaah ma' naa ta nuye'em keh i nuyejaam naq wach chi keh.</para>
  <para style="p">
    <verse number="11" style="v" />Re' hat hiy kuuk' taqe aj Judá, kuuk' taqe i aj Jerusaleem cha q'or keh chi je' wili: Chi re' hin i Dios wilik i k'ahchi' nuyejaam wach chikiij, k'achi' nuyejaam wach chi naa taqe nuye'em chutojariik i kimahk. Je' re' noq kikanaa' i yiib' wach b'eeh, kiyejaa' i kina'ojb'al, je' wo' hoq inki a'n <verse number="12" style="v" />Re' keh je' wili i naa kiq'orom aweh: Maa cham awiib' quuk', re' hoj imponik chi qawach i k'achariik je' rukab' inqaaj i hoj. Eh ma' qaaj ta qakanaam rub'aan i ma' holohik taj inchalik panqanima, inko'q taqe, inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Ruum aj re' je' wili i ruq'or i QaJaaw Dios.</para>
  <para style="q">Chapahqaaj chupaam taqe i tinamit</para>
  <para style="q">mi wilik jino'q ixq'orik reh je' rukab' i q'orik re' re'.</para>
  <para style="q">Re' taqe i tinamit Israel ma' k'isiin ta yib'kiil wach kib'anik.</para>
  <para style="q">
    <verse number="14" style="v" />Eh ¿Mi neerub'an chi ma' nee ta chik inqajik chaloq i musjab'</para>
  <para style="q">chinaah inajt naah yuuq' wilik Líbano?</para>
  <para style="q">¿Mi neerub'an chi nee kichiqiik</para>
  <para style="q">taqe i jot'ik paam ha' kichalik chi najt yuuq'?</para>
  <para style="q">
    <verse number="15" style="v" />Xa re' la' re' nutinamiit keh xinsahchik pankik'ux,</para>
  <para style="q">eh chuwach chik taqe i tiyoox inkik'at i insensia</para>
  <para style="q">xkikanaa' i holohik b'eeh</para>
  <para style="q">re' xkik'am chaloq i aj najtir q'iij.</para>
  <para style="q">Re' chik i b'eeh ma' eht'alimaj taj k'ahchi' kojiik wii'.</para>
  <para style="q">
    <verse number="16" style="v" />Je' aj re' noq re' i kitinamiit xsutinik chi xa je' chik chiq yuuq',</para>
  <para style="q">eh chu'nchel i naakik'iik ilwoq reh naa kikaqse'laam,</para>
  <para style="q">naa rusahchiik kik'ux naakik'uyusam i kinaah,</para>
  <para style="q">cha q'or i xuk'ul, inko'q taqe.</para>
  <para style="q">
    <verse number="17" style="v" />Eh re' hin je' naa ruuk' kowlaj teew inchalik parelb'aal q'iij</para>
  <para style="q">naa nukutum taqe i aj Israel chikiwach i inixowanik kiwach.</para>
  <para style="q">Eh noq naakik'ulum i ti' k'axik re' re', ma' naa ta nuko'leem taqe,</para>
  <para style="q">naa la' nukanaam taqe chi kutkel, inki Dios.</para>
  <para style="s">Re' noq xkiyejaa' wach chi naa kianam ti' k'axik reh i Jeremías</para>
  <para style="p">
    <verse number="18" style="v" />Re' i tinamit je' wili i xkiq'or: Qayejaa' taq wach chi neenqasach wach i Jeremías ruum i ruq'or. Re' hoj qeht'al chi xanaa wo' kiwihiik i k'amal b'eeh aj tiij aj tijen qeh, eh xanaa wo' kiwihiik kojol qana'ojb'al, xanaa wo' kiwihiik i jalal ruq'oral i Dios neenkiq'or qeh i k'uhb'aal. Qakoj taq ru mahk i Jeremías reh chi neenkanteesjik, eh manqanimaj taq reh taqe i ruq'or, inki taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Re' Jeremías je' wili i xuq'or parutiij:</para>
  <para style="q">QaJaaw Dios kinako'leej tii chuwach inkiq'or chi wiij taqe i ki-ixowanik nuwach. <verse number="20" style="v" />Re' keh nupletohjiik chik inki a'n chi q'ajb'al wach otob'il xnub'an keh.</para>
  <para style="q">Eh xankaaj naq chik kin kimuq'aam,</para>
  <para style="q">re' hat Jaaw aweht'al chi kinchoqik awuuk' chupahqaljiik i kitoob'jiik,</para>
  <para style="q">chi maayeew chik chaloq aajosq'iil chikinaah.</para>
  <para style="q">
    <verse number="21" style="v" />Eh i nupahqaaj aweh chi chayeew chee wi'jaleel chikinaah i kak'uun kixq'uun,</para>
  <para style="q">eh chi neekikanteesjik ruuk' q'aslaj ch'ihch'.</para>
  <para style="q">Eh chi nee kikahnik chi ma' xta chik kib'ahiil ma' xta chik kak'uun kixq'uun ixoq,</para>
  <para style="q">chi yab'ilaal neenkansanik keh i kib'ahiil,</para>
  <para style="q">eh re' kik'ijool kikimoq panq'aq'inik.</para>
  <para style="q">
    <verse number="22" style="v" />Re' hin Jaaw i nupahqaaj aweh chi cha taq'aaj cho juntuhb'-oq ajileq' chikinaah,</para>
  <para style="q">korehtaal i nib'irjik chi k'erik kichii',</para>
  <para style="q">ruum re' keh xkik'ot i jul reh chi naa nuq'ehb'iik chupaam,</para>
  <para style="q">eh xirob' inkikoj panub'eeh.</para>
  <para style="q">
    <verse number="23" style="v" />Xa re' la' re' hat Jaaw aweht'al chu'nchel i xkiyejaa' wach reh i nukanteesjiik.</para>
  <para style="q">Je' re' noq i nupahqaaj aweh</para>
  <para style="q">chi maa kuy kimahk ruuk' i kiyiib' wach na'ojb'al,</para>
  <para style="q">eh mansahchik panak'ux taqe i kimahk.</para>
  <para style="q">Chayeew taqe chutojariik i kimahk ruuk' aajosq'iil.</para>
  <chapter number="19" style="c" />
  <para style="s">Re' jalwaach q'orik chi riij i paxeel laj ak'al ikom</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios je' wili xuq'or weh: Yu'naak hiy chaloq jino'q aak'al ikom nee nak'am taqe kiib' ixib'-oq chawiij taqe i k'amal b'eeh chupaam i tinamit, neenak'am taqe chawiij i k'amal kib'eeh aj tiij. <verse number="2" style="v" />Chi riij i re' neetiqajik qohoq wach k'ixkaab' Ben-hinom neenapab'aa' awiib' chi chii' i ookb'al wilik reje chi korkiil ireelb'aalq'iij ar neenaq'or i nuk'uhb'aal naa nuq'orom aweh. <verse number="3" style="v" />Je' wili i neenaq'or keh: Re' taq i hat wilkaat taq chi reyil Judá, je' wo' taq i hat i wilkaat taq chi patinik Jerusaleem chab'iraj taq i k'uhb'aal wili, re' ruq'or i QaJaaw nim rajaawriik qaDios i hoj, hoj aj Israel. Re' hin naa nutaq'aam chaloq i runimaal ti' k'axik chinaah i ye'aab' wili, chu'nchel i naakib'iriniik reh naa rutib'iik i kixikin. <verse number="4" style="v" />Ruum re' taqe i aj Israel xin kiq'eb' chi riij kik'ux xkikanaa' i ye'aab' re' re' chi xa je' tokoom tinamit, ar xkik'at i insensia chikiwach taqe i tiyoox ma' keht'al ta wach i keh, ni xata re' i kimaam kati't ni xata re' taqe kireey i aj Judá xinab'inik cho kiwach. Re' taqe i aj Israel ma' k'isiin i ma' xta kimahk i xkikansaj ar. <verse number="5" style="v" />Eh xkiyejaa' wo' kiartaal k'atb'al reh taqe i kak'uun kixq'uun chi kimayiij chuwach i tiyoox Baal. Re' hin ma' xnuq'or ta keh chi je' re' naa kianam, ni xata naq xik'ik cho panukapeb'aal. <verse number="6" style="v" />Ruum aj re' chi nuwach i hin naa ruponiik i q'iij chi re' ye'aab' re' re' ma' re' ta chik Tofet ni xata Ben-hinom naa rubíhnaam, ye'aab' kantesb'al iib' la' chik inarub'ihnaam. Re' wili korik ruum re' hin i Dios kinq'orik. <verse number="7" style="v" />Eh chupaam i ye'aab' re' re' naa nusacham wach i kiyejaam wach i aj Judá, eh je' wo' hoq i kiyejaam i aj Jerusaleem. Re' hin naa nuye'em q'ab' chi naa rub'aan keh ruum inixowanik kiwach xiik' naah kijosq'iil re' taqe naa rukansaniik keh. Eh re' i kiti'jolal naa rukamaniik chi kiwa' k'uch chi kiwa' josq'laj chikop. <verse number="8" style="v" />Re' hin naa nukanaam i tinamit wili chi xa je' chik rukab' i ye'aab' chiq yuuq' yohb'aal wach i naa ruk'ulum. Eh chu'nchel i naakik'iik ilwoq reh chi xsahchik chik wach chi jumpech ma' k'isiin ta naa kikaqse'laam, eh naa rusahchiik kik'ux. <verse number="9" style="v" />Re' hin naa nuye'em q'ab' chi re' inixowanik kiwach yohb'aal wach kijosq'iil chikinaah, korehtaal kikanab'jik chi ma' xta wilik keh. Re' chik taqe i kamigo, re' chik taqe i kak'uun kixq'uun naa kik'uxum paruti'kiil, inki tiko'q keh.</para>
  <para style="p">
    <verse number="10" style="v" />Noq aq'orom chik keh i re' kora'j neenapaxej qohoq wach ak'al re' i ak'al ikom chikiwach taqe i winaq awuch'ihil. <verse number="11" style="v" />Eh je' wili i naa aq'orom keh: Re' QaJaaw Dios nim rajaawriik je' wili ruq'or: nik' wach noq xpaxik i ak'al ikom wili ma' jaruuj chik naa rukorjiik, je' re' noq naa nusacham kiwach i tinamit wili ma' jaruuj chik naa rukorjiik. Ruum chiyohb'aal wach ikaansanik naa rub'aan ma' naa ta chik rumanlojiik i ye'aab' kimuhqik wii' i kamnaq, ar chik Tofet naki muq'aam i kikamnaaq i tinamit. <verse number="12" style="v" />Je' re' naa nub'anam ruuk' i tinamit wili, je' wo' kuuk' chu'nchel i patim chupaam. Xa aha' naa rukahniik chi tuch'lik i kiti'jolal kamnaq, naa nukanaam chi je' rukab' i ye'aab' Tofet. <verse number="13" style="v" />Re' taqe i paat wilkeeb' Jerusaleem, re' taqe i paat inki a'n wii' i taaq'anik i reey ar Judá, re' taqe i ruk'ixkab'il naa taqe paat, re' inkik'at wii' i insensia chikiwach johtoq i ch'umiil. Re' inkichihkaaj wii' i riis uuva chikiwach taqe i tiyoox. Re' taqe i ye'aab' re' re' naa rukahnik chi ch'uwa' kiwach je' rukab' i ye'aab' Tofet, tiko'q keh inki i Dios.</para>
  <para style="p">
    <verse number="14" style="v" />Eh chi riij i re' xelik wo' chik chaloq i Jeremías ar Tofet re' xtaq'ab'jik reje wii' ruum i Dios noq xponik ruq'or i ruk'uhb'aal re' re'. Eh xoj rupab'aa' riib' chi chii' i rupaat i Dios je' wili i xuq'or keh i tinamit. <verse number="15" style="v" />Re' QaJaaw Dios nim rajaawriik qaDios i hoj, hoj aj Israel je' wili i xuq'or: Re' hin naa nuye'em chinaah i tinamit wili je' wo' chikinaah i tinamit wilkeeb' reje chuka'jaah taqe i ti' k'axik xnuq'or taq aweh. Eh ruum q'e' xkikowb'isaj i kinaah ma' xkaaj ta kinimam i nuq'oral, inki weh i Dios.</para>
  <chapter number="20" style="c" />
  <para style="s">Re' i xub'an i Pasur i nixowanik wach i Jeremías</para>
  <para style="p">
    <verse number="1" style="v" />Eh noq re' i rak'uun Imer Pasur rub'ihnaal k'amal b'eeh aj tiij nim wach ilil reh i rupaat i Dios, xrib'iraj i xuq'or i Jeremías chi naa ruk'ulariik. <verse number="2" style="v" />Ruum re', re' i Pasur xutaq'aaj ruchopariik i Jeremías xkiq'ojib'eej xkilutz' pan chee' i ralaq i rooq ar chi chii' i nim wach ookb'al Benjamín rub'ihnaal wilik ma' najt ta ruuk' i rupaat i Dios. <verse number="3" style="v" />Eh chi junwaar re' xutaq'aaj wo' chik ruq'orariik chi kesaj pan lutz' chee' i rooq. Re' i Jeremías je' wili i xuq'or reh Pasur: Re' hat narujalam wach ab'ihnaal i QaJaaw, runimaal yo'jik chik ab'ihnaal naa rukojom. <verse number="4" style="v" />Re' i QaJaaw Dios je' wili i xuq'or chawiij: Re' hin naa kaat nusutem chi xa re' hat naa ayohb'isam awiib', je' wo' chi keh taqe awamigo. Eh naa awilom ruuk' naq'awach noq naa kikanteesjiik taqe awamigo ruuk' q'aslaj ch'ihch'. Re' hin naa nuq'asam taqe i aj Judá pan q'ab' i kireey i aj Babilonia naa kik'amariik reje pankowlaj kamanik, ar naa kikanteesjiik ruuk' q'aslaj ch'ihch'. <verse number="5" style="v" />Naa wo' nuq'asam pan kiq'ab' i nixowanik kiwach i rub'ehomal i tinamit wili, je' wo' hoq i chib'ih jariij wilik keh, je' wo' hoq i k'ih taq tz'aaq chi keh. Eh je' wo' chu'nchel i xa chib'ih jariik q'e' k'ih tz'aaq wili keh i kireey i aj Judá, chu'nchel i re' naa kik'amam reje Babilonia i nixowanik kiwach. <verse number="6" style="v" />Eh re' hat Pasur naa wo' ak'amariik reje ar Babilonia, ruch'ihil taqe awach aweh ar naa akimiik, ar naa kaat kimuq'aam, ar naakimuhqiik chu'nchel i awamigo, re' i xiq'orik rib'iral taqe i xachukuj q'orik inki i Dios.</para>
  <para style="s">Re' Jeremías xujal johtoq ree Dios i ti' xuk'ul</para>
  <para style="q">
    <verse number="7" style="v" />QaJaaw Dios re' hat xachuk weh i q'orik,</para>
  <para style="q">ruum xaq'or weh chi nanaq kiin atoob'eem.</para>
  <para style="q">Eh re' hin xnunimaj ruum re' hat q'e' wilik awajaawriik chi nuwach i hin,</para>
  <para style="q">eh yu'naak xi nakanaa' chi k'ahchi' nuk'uhtaam nuk'ixb'ilaal,</para>
  <para style="q">eh chu'nchel kikaqse'lanik weh.</para>
  <para style="q">
    <verse number="8" style="v" />Jarpech kinq'orik xa re' i rusachariik wach i tinamit,</para>
  <para style="q">xa re' i ti' k'axik naa ruchaliik i nuq'or rib'iral.</para>
  <para style="q">Ruum taqe re' xak'ahchi' keeb' chi nub'ajariik,</para>
  <para style="q">chi nukaqse'ljiik,</para>
  <para style="q">eh ruum wo' i ruq'orariik aak'uhb'aal.</para>
  <para style="q">
    <verse number="9" style="v" />Re' hin je' wili i xnuq'or:</para>
  <para style="q">Ma' naa ta chik nuq'orom i ruk'uhb'aal i QaJaaw,</para>
  <para style="q">ma' naa ta chik nuq'oriik parub'ihnaal, kinki.</para>
  <para style="q">Xa re' la' re' aq'oral cho pan wánima xa je'</para>
  <para style="q">chik xaq q'aaq' imponik wach nub'aqil noq inwik'raaj</para>
  <para style="q">xwaaj naq nukanaam ruq'orariik, xa re' la' xama' xnukanaa' ta wo' hoq.</para>
  <para style="q">
    <verse number="10" style="v" />Re' hin imb'iraj chi re' taqe i tinamit aha' ta chik</para>
  <para style="q">ma' nkikoj numahk je' wili inkiq'or:</para>
  <para style="q">Ruum i reh aha' ta chik ma' wilik i yohb'aal,</para>
  <para style="q">qaq'or taq chi ru mahk i reh, inki taqe.</para>
  <para style="q">Eh re' taqe wamigo k'ahchi' wo' kuy-eem i keh</para>
  <para style="q">chi naa nuq'eb'em wiib', je' wili inkiq'or:</para>
  <para style="q">Qilow taq nee oon inche ruyeew riib' chi jot'arik</para>
  <para style="q">chi je' re' neerutoj wach qeh i rub'an, inki taqe.</para>
  <para style="q">
    <verse number="11" style="v" />Xa re' la' re' hat QaJaaw Dios nim awajaawriik wilkaat wuuk'</para>
  <para style="q">chi nuko'ljiik ma' awach ta neenq'atwik awach.</para>
  <para style="q">Re' taqe i ki-ixowanik nuwach ma' xta naa kiin kuchem,</para>
  <para style="q">naa ruchaliik kik'ixiik</para>
  <para style="q">ruum ma' naa takeliik korik,</para>
  <para style="q">naa kikahniik chi ma' xta chik kajaawriik chi jumpech.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />QaJaaw Dios nim awajaawriik.</para>
  <para style="q">Re' hat i nawilow i ránima i rukapeb'aal i ju'jun.</para>
  <para style="q">Ruum aj re' inwaaj chi nee nak'uhtaaj weh</para>
  <para style="q">nik' wach noq naa taqe aye'em chutojariik i kimahk i ki-ixowanik nuwach.</para>
  <para style="q">Re' hin xnukanaa' chik panaq'ab' i nuk'axkiil.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' hin i nuq'or taq aweh chi chatz'uyej taq wach i QaJaaw chayeew taq ruloq'il.</para>
  <para style="q">Ruum re' hin q'e' naq ti' nuk'ux, eh xi ruko'leej pan kiq'ab' i yiib' wach kina'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Xa re' la' re' hin i nuq'or</para>
  <para style="q">chi ma' ta naq xin-aasjik ruuk' i nutuut chupaam i q'iij xin-aasjik wii'</para>
  <para style="q">ruum re' hin i nukapaaj chi re' q'iij re' re' ma' holohik taj.</para>
  <para style="q">
    <verse number="15" style="v" />Eh i nuq'or wo' hoq chi ma' holohik ta xb'anik</para>
  <para style="q">awach i xye'wik rusuqkiil ruk'ux i wajaaw</para>
  <para style="q">noq xuq'or rib'iral reh chi re' hin naa wasjiik.</para>
  <para style="q">
    <verse number="16" style="v" />Re' reh i ruk'ul chi naa rusachariik wach</para>
  <para style="q">je' rukab' noq xusach kiwach i ki'ib' chi tinamit i Dios</para>
  <para style="q">ma' xuketelaaj ta kiwach, nee ta naq i ruk'er chii' pantaq wahq'eq,</para>
  <para style="q">eh kab'lajora i q'iij.</para>
  <para style="q">
    <verse number="17" style="v" />Wita re' Dios xuyeew q'ab' chi xin kimik</para>
  <para style="q">noq ko hin naq rihqaam i nutuut ar naq xin kahnik chi kamnaq,</para>
  <para style="q">chi je' re' ma' xin-aasjik ta naq chik chi jumpech.</para>
  <para style="q">
    <verse number="18" style="v" />¿Chib'ih ta wo' inchirutiq chi xin-aasjik ruuk' i nutuut,</para>
  <para style="q">xa re' inchel i ti' xa re' inchel i ruti'kiil k'uxliis,</para>
  <para style="q">xa hin inche k'uhtan nuk'ixb'ilaal xin chalik ayu' wach ak'al?</para>
  <chapter number="21" style="c" />
  <para style="s">Re' ruq'oriik rib'iral chi xchalik i ti' k'axik chinaah i tinamit Jerusaleem</para>
  <para style="p">
    <verse number="1" style="v" />Re' reey Sedequías xutaq'aaj reje Pasur rak'uun i Malquías ruuk' i k'amal b'eeh aj tiij Sofonías rub'ihnaal rak'uun i Maasías reh chi xoj chi q'orob'jiik i Jeremías je' wili xuq'or ponoq reh: <verse number="2" style="v" />Re' reey je' wili i xuq'or chaloq: chupahqaaj i rotob'il i QaJaaw Dios chiqiij, ruum re' i Nabucodonosor reey ar Babilonia k'achi' chi q'aq'inik quuk' nee oon i rub'an cho quuk' i QaJaaw je' rukab' taqe i nimaq wach ma' ilooj taj i rub'an. Reh chi re' i aj ixowaal neensutinik reje, inki.</para>
  <para style="p">
    <verse number="3" style="v" />Re' Jeremías je' wili ruch'aq'weesjiik xub'an i raj taqareel i Sedequías: <verse number="4" style="v" />Re' QaJaaw i qaDios i hoj, hoj aj Israel je' wili xuq'or: Re' hin naa wesam i kajaawriik i raj q'aq'ineel i Sedequías, eh ma' xta chik naa rukamaniik wii' i ch'ihch' reh q'aq'inik wilik pan kiq'ab'. Re' naq inkik'ulb'ilej wii' i kireey i aj Babilonia. Eh re' taqe i aj Caldeo wilkeeb' reje chi junsuut i tz'aq, korehtaal inumol kiwach panyejaal i tinamit wili. <verse number="5" style="v" />Eh re' rutinamiit i Sedequías, re' hin naa nub'aniik i peleto ruuk' i runimaal i wajaawriik ruum yohb'aal wach i nujosq'iil. <verse number="6" style="v" />Re' hin naa nuye'em i ti' k'axik chikinaah, chi winaq chi ixoq chi chikop naa kikimiik ruum i yiib' wach yab'ilaal. <verse number="7" style="v" />Eh re' Sedequías kireey i aj Judá ruch'ihil taqe i aj kamanoom naa taqe nuq'asam pan q'ab' i Nabucodonosor, pan kiq'ab' i nixowanik kiwach xiik' naah kikojsq'iil. Re' taqe i ru soldado, re' taqe i tinamit ma' naa ta kikimiik ruum q'aq'inik, ruum wi'jaleel, naa nuq'asam taqe pan kiq'ab' i aj ixowaal re' re'. Eh re' keh naa rukansaniik keh ruuk' q'aslaj ch'ihch', ma' naa ta ruketeljiik kiwach ma' naa ta rukuyariik i kimahk.</para>
  <para style="p">
    <verse number="8" style="v" />Eh cha q'or keh i tinamit wili chi je' wili: Re' QaJaaw Dios je' wili ruq'or: Re' hin i nuyeew q'ab' keh chi neenkisik' wach i kiib' chi b'eeh re' i rub'eeh i k'achariik, oon re' rub'eeh i kimik. <verse number="9" style="v" />Awach i naa rukahniik chupaam i tinamit wili naa rukimiik ruum q'aq'inik, ruum wi'jaleel, ruum yab'ilaal. Eh awach i naa reliik reje ayu' i naa ruq'asam riib' pan kiq'ab' i aj Caldeo, re' taqe i k'ahchi' kib'aniik i q'aq'inik chupaam i tinamit wili. Re' reh ma' naa ta rukimiik naa ruko'leem riij i ruk'achariik. <verse number="10" style="v" />Re' hin xchalik nuk'aah kuuk' i tinamit wili, ma' re' ta suq i naa nuk'amam cho chikinaah, ti' k'axik la' i naa nuk'amam chaloq. Naa nuq'asam pan q'ab' i kireey i aj Babilonia, re' reh naa ruk'atwiik ruuk' i q'aaq'.</para>
  <para style="p">
    <verse number="11" style="v" />Eh chupaam i rupaat i kireey i aj Judá je' wili i naa aaq'orom:</para>
  <para style="b" />
  <para style="q">Chab'iraj i ruq'oral i QaJaaw Dios naa ruq'atam q'orik cha naah.</para>
  <para style="q">
    <verse number="12" style="v" />Hat taq riih rumaam i reey David</para>
  <para style="q">i ti q'atwik taq q'orik cha a'n taq q'ataj q'orik parukorkiil</para>
  <para style="q">chu'nchel q'iij chawesaj taq panti' k'axik i k'ahchi' rub'an ti' k'axik keh,</para>
  <para style="q">reh chi ma' nee ta inqop wach i nujosq'iil taq cha naah</para>
  <para style="q">je' rukab' noq inqop i q'aaq' ma' awach ta chik inchupwik reh,</para>
  <para style="q">ruum taq i ayiib' wach na'ojb'al.</para>
  <para style="s">Re' ruq'orariik i ti' k'axik chinaah i tinamit Jerusaleem</para>
  <para style="q">
    <verse number="13" style="v" />Re' taq i hat i wilkaat taq wach k'ixkaab' je' taq aakowiil ab'aj i naa a'n awiib',</para>
  <para style="q">re' hin i Dios ma' ruk'ul ta nuk'ux taq i na a'n.</para>
  <para style="q">Je' taq wili inaq'or: Re' hoj ma' awach ta neen k'ulik kaansanoq qeh,</para>
  <para style="q">eh ma' awach ta neerub'an i chee johtik chupaam i ye'aab' wilkooj wii', tiki taq.</para>
  <para style="q">
    <verse number="14" style="v" />Xa re' la' re' hin</para>
  <para style="q">naa taq kaat nuye'em chutojariik amahk je' rukab' i ruk'ul taq cha weh.</para>
  <para style="q">Re' hin naa nuqopom ruq'aq'al taqe i rax chee'</para>
  <para style="q">wilkaat taq wii' re' re' naa rusachwiik taq awach,</para>
  <para style="q">je' wo' chu'nchel i chib'ih jariik i wilkeeb' taq cha junsuut, inki Dios.</para>
  <chapter number="22" style="c" />
  <para style="s">Re' ruq'orariik chib'ih i xkik'ul i xi wihik cho chi reyil Judá</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios je' wili i xuq'or weh: Hiy parupaat i kireey i aj Judá ar neenaq'or reh taqe i q'orik wili: <verse number="2" style="v" />Hat kireey i aj Judá je' rukab' noq xwihik cho chi reyil i David chab'iraj i ruq'oral i Dios naa nuq'orom aweh hat, i ruk'ul wo' chi naa kib'iram taqe i kikamanik awuuk' taqe aatinamiit kiokik cho chupaam aa ye'aab' wili. <verse number="3" style="v" />Je' wili i ruq'or i QaJaaw Dios: Parub'ehel naa kianam i q'ataj q'orik, naakiko'leem inq'ucharik i chib'ih keh. Eh mankelq'aaj i chib'ih keh i aj pan tokoom tinamit, je' wo' taqe ixoq kamnaq kib'ahiil, je' wo' taqe i ma' xta kituut kajaaw. Eh maa nkikansaj chik ma' xta kimahk, chupaam i ye'aab' wili. <verse number="4" style="v" />Wila' xti korik chi xkinimaj i nuq'oral juneliik naa ruwihiik i reey chinaah i tinamit re' re' je' rukab' noq xwihik cho chi reyil i David. Re' keh pan kareta, rij kawáyu wilkeeb' noq naa kokiik cho chupaam i ye'aab' wili kuch'ihil taqe i naa rukamaniik kuuk' kuch'ihil taqe i kitinamiit. <verse number="5" style="v" />Eh raaj wila' ma' xkinimaj i xnuq'or keh, re' hin xti nuq'or i korik chi re' paat wili i na a'n wii' i taaq'anik naa rusachariik wach chi jumpech, inki Dios.</para>
  <para style="p">
    <verse number="6" style="v" />Ruum re' reh je' wili ruq'orom cho chi riij i paat i rub'an wii' i taaq'anik i kireey i aj Judá:</para>
  <para style="b" />
  <para style="q">Re' hat q'e' naq tiwaaj je' rukab' noq inwaaj i yuuq' Galaad,</para>
  <para style="q">i yuuq' Líbano, xa re' la'</para>
  <para style="q">re' hin i nuq'or i korik chi naa akahniik chi xa je' chik akab' i ye'aab' chiq yuuq',</para>
  <para style="q">eh chi je' akab' i tinamit ma' xta patineel chupaam.</para>
  <para style="q">
    <verse number="7" style="v" />Eh naa nuk'amam taqe chaloq</para>
  <para style="q">i naa ruk'uliik sachwoq taq wach aatinamiit</para>
  <para style="q">wilik kich'ihch' pan kiq'ab' naakiyok'om taq aach'iit re' ruuk' i chakaltee'</para>
  <para style="q">naa kikutum pan q'aaq'.</para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" />Ma' k'isiin i naakik'iik ilwoq reh i tinamit re' re', je' wili i naa kiq'orom chikiwach: ¿Chib'ih reet noq xusach wach i QaJaaw Dios i tinamit wili xanaah re' xiik' naq naah nimaal? inko'q taqe. <verse number="9" style="v" />Eh je' wili kichaq'weesjiik naa rub'aan: Je' re' xuk'ul ruum ma' xkian taj aha' naq wilik i xkiyejaa' wach ruuk' i QaJaaw Dios. Re' la' chik i tiyoox xkiloq'ej, re' chik taqe i re' xkikamaneej wach kiuchjoq, inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' taq i hat maawoq'ej taq i rukimiik reey Josías.</para>
  <para style="q">Re' la' chawoq'ej taq i rak'uun Salum rub'ihnaal,</para>
  <para style="q">ruum re' reh naa ruk'amariik reje pan tokoom tinamit.</para>
  <para style="q">Eh ma' jaruuj ta chik naa rusutiniik chaloq,</para>
  <para style="q">ma' naa ta chik rilom wach i rutinamiit x-aasjik wii'.</para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" />Ruum re' i QaJaaw Dios je' wili ruq'or chi riij i Salum, rak'uun i Josías kireey i aj Judá. Re' Salum re' re' wilik chi reyil chi jilow i rajaaw naa ruk'amariik reje pan tokoom tinamit ma' jaruuj chik naa rusutiniik cha yu' parutinamiit. <verse number="12" style="v" />Ar la' naa rukimiik chaloq pan tokoom tinamit re' naa ruk'amariik reje wii' ma' naa ta chik rilom wach chi jumpech i ruye'aab' wili.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' hat reey Joacim q'e' ti' i naa ak'ulum</para>
  <para style="q">ruum ruuk' taqe yiib' wach na'ojb'al ruuk' i leq'</para>
  <para style="q">inayejaa' i paat i na a'n wii' i taaq'anik je' wo' taqe najt kinaah paat</para>
  <para style="q">inayejaa' inamin taqe pankowlaj kamanik taqe i tokoom, eh ma' natoj ta taqe.</para>
  <para style="q">
    <verse number="14" style="v" />Re' hat je' wili inaq'or:</para>
  <para style="q">Re' hin naa nuyejaam i nunim laj paat naa nub'anam wii' i taaq'anik,</para>
  <para style="q">eh k'ih tahs paam naa nub'anam</para>
  <para style="q">naa nukojom taqe ru ventanahiil.</para>
  <para style="q">Eh naa nukojom ruka'taah chi tz'ilom re' ruuk' i chakaltee',</para>
  <para style="q">naa wiq'omaam wach ruuk' i kaq laj iq'oom tiki.</para>
  <para style="q">
    <verse number="15" style="v" />¿Mi nakapaaj re' i hat chi re' reyil manlik ruuk'</para>
  <para style="q">chi xoyimaj wach aapaat cha junsuut ruuk' i tz'ilom i chakaltee'?</para>
  <para style="q">Korik re' awajaaw Josías xub'an rusuqkiil</para>
  <para style="q">i ruwa' ruum re' korik i xub'an</para>
  <para style="q">eh parub'ehel xub'an i q'ataj q'orik ruum aj re' suq xwihik.</para>
  <para style="q">
    <verse number="16" style="v" />Re' reh xuko'lej riij i ajwaal wach chi keh i neb'aa', taqe xb'aan cho ti' k'axik keh,</para>
  <para style="q">ruum aj re' suq xwihik,</para>
  <para style="q">¿Mi ma' ruuk' taqe re' re' xk'utinik chi xirunimaj?</para>
  <para style="q">inki QaJaaw Dios.</para>
  <para style="q">
    <verse number="17" style="v" />Eh re' hat xa re' inakapaaj chi naa areqem atumiin ruuk' i leq'</para>
  <para style="q">eh chi naa akansam taqe ma' xta kimahk</para>
  <para style="q">chi nayeew taqe panti' k'axik</para>
  <para style="q">chi nawelq'aaj i chib'ih keh aatinamiit, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" />Re' QaJaaw Dios je' wili xuq'or chi riij i reey Joacim rak'uun i Josías kireey aj Judá.</para>
  <para style="b" />
  <para style="q">Re' Jocim ma' awach ta naa roq'iniik reh na'kimoq</para>
  <para style="q">ma' awach ta naa ruq'oriik chi je' wili:</para>
  <para style="q">Q'e' ti' xuk'ul ma' ko'q ta taqe i ras i ruchaaq'.</para>
  <para style="q">Q'e' ti' xuk'ul i qajaaw reey nim rajaawriik ma' ko'q ta taqe.</para>
  <para style="q">
    <verse number="19" style="v" />Ma' naa ta kimuq'aam</para>
  <para style="q">naakiqerem reje i ruti'jolal chi riij i tinamit Jerusaleem</para>
  <para style="q">je' rukab' noq inkiqerej reje i ruti'jolal i b'uurux ma' nkimuq'aa' taj, inki.</para>
  <para style="q">
    <verse number="20" style="v" />Re' taq i hat aj Jerusaleem johteen taq chinaah i yuuq' Líbano</para>
  <para style="q">cha k'er taq aachii'</para>
  <para style="q">kow taq tiq'oroq reje chinaah i yuuq' Basán,</para>
  <para style="q">eh k'ul taq cha k'er reje aachii' ruum chu'nchel</para>
  <para style="q">i q'e' naq taq inak'ax xsacharik chik kiwach.</para>
  <para style="q">
    <verse number="21" style="v" />Re' hin xat nuq'oreej wo' naq taq noq kosuq taq wilkaat,</para>
  <para style="q">xa re' la' xama' xinawaaj ta wo' taq ab'iram.</para>
  <para style="q">Eh xa je' wo' re' i na a'n taq noq kore' xatoq'aa' taq cho nimanik,</para>
  <para style="q">xama' xinawaaj ta wo' taq ab'iram.</para>
  <para style="q">
    <verse number="22" style="v" />Re' taqe i k'amal ab'eeh xajunhuup chi teew naa ruk'amwiik reje keh,</para>
  <para style="q">chu'nchel i q'e' naq taq inak'ax naa kik'amariik reje pan tokoom tinamit.</para>
  <para style="q">Eh re' taq i hat naa taq ak'uhtaam ak'ixb'ilaal,</para>
  <para style="q">naa rukahniik chi xama' xta chik taq awajaawriik,</para>
  <para style="q">ruum taq ayiib' wach na'ojb'al.</para>
  <para style="q">
    <verse number="23" style="v" />Re' taq i hat yu'naak xasuq taq chik ak'ux chi wihik chupaam taq apaat,</para>
  <para style="q">akojom taq tz'ilom chuwach re' ruuk' i chakaltee' inchalik ar Líbano.</para>
  <para style="q">Xa re' la' ponik reh i q'iij chi naa ruchaliik taq i ti' k'axik cha naah</para>
  <para style="q">xa je' chik rukab' i ruti'kiil ixoq noq ink'ulik ruk'ux, inki Dios.</para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" />Re' QaJaaw Dios je' wili xuq'or reh Jeconias, rak'uun i Joacim reey ar Judá: Re' hin xti korik i nuq'or aweh atoob' ta naq je' hat nulopq'aaq' wilik ju' rusak'aaj nuq'ab' q'e' iloq weh re' i hin xa nee wo' naq tiinub'oq iloq ar. <verse number="25" style="v" />Reh chi nee ti nuq'asaj pan kiq'ab' taqe i ki-ixowanik awach i xiik' naah kijosq'iil, re' taqe i xiik' naah tiyo'jik kuum. Naa wo' kaat nuq'asam pan q'ab' i Nabucodonosor kireey i aj Babilonia, eh pan kiq'ab' i aj Caldeo. <verse number="26" style="v" />Naa nuye'em q'ab' chi naa ak'amariik reje pan tokoom tinamit i hat, je' wo' hoq i atuut, ma' re' ta taq xat aasjik wii'. Ar taq naa akimiik cho akab'cheel, inki. <verse number="27" style="v" />Je' re' noq re' keh ma' jaruuj chik naakisutiniik cho pan kitinamiit re' i xanaa naq chik kaajwaam kilom wach.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Re' Jeconias naa rukahniik chi xa je' chik rukab' jino'q paxeel laj pulato.</para>
  <para style="q">Eh chi je' rukab' i paxeel ak'al xaro</para>
  <para style="q">ruum naa ruk'amariik reje pan tokoom tinamit i reh,</para>
  <para style="q">je' wo' taqe i rak'uun rixq'uun.</para>
  <para style="q">
    <verse number="29" style="v" />Re' taq i hat wilkaat taq wach ak'al</para>
  <para style="q">eh chawunchelaal taq i wilkaat taq wach ak'al</para>
  <para style="q">xti chab'iraj taq i ruq'oral i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Chatz'ihb'aaj taq i naa ruk'ulum i winaq re' re'.</para>
  <para style="q">Ruum re' reh naa rukahniik chi</para>
  <para style="q">xa je' ma' xwihik ta rak'uun rixq'uun,</para>
  <para style="q">eh ma' xelik ta korik paruk'achariik ruuk' taqe i xub'an.</para>
  <para style="q">Ruum ma' jino'q i rak'uun ma' jino'q i riih naa rokiik chi reyil ar Judá</para>
  <para style="q">je' rukab' noq xwihik cho chi reyil i David ar, inki.</para>
  <chapter number="23" style="c" />
  <para style="s">Xuq'or i Dios chi naa wo' chik kisutinik chaloq i rutinamiit</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios je' wili i xuq'or: Q'e' ti' inakik'ulum i aj cha'joom inkisach wach, inkitukej wach i nutinamiit taqe nutentzuun.</para>
  <para style="p">
    <verse number="2" style="v" />Ruum aj re', re' QaJaaw, i qaDios i hoj, hoj aj Israel je' wili i xuq'or keh i kicha'jinik reh i rutinamiit: Re' taq i hat xatukej taq kiwach i nutinamiit, re' taqe nutentzuun xa kaaj taq reje ma' xacha'jej ta taq. Re' hin naa taq kaat nuye'em chutojariik amahk ruum ayiib' wach na'ojb'al taq xa a'n. <verse number="3" style="v" />Re' hin naa wo' chik numolom kiwach i ruqox i nutinamiit re' taqe i nutentzuun, re' i xnutaq'aaj taqe reje wii' chupaam i ju'jun chi tinamit, naa wo' chik nuk'amam taqe chaloq pan kitinamiit naa nuk'uxlaam taqe, eh naa kik'ihaaxb'iik. <verse number="4" style="v" />Eh re' hin naa nukojom cha'jen keh, reh chi naa kicha'jaljiik chi korik kuum, ma' naa ta chik kiyo'jiik ma' xta chik i naakik'ulum, ma' jino'q chik keh i naa rusahchiik wach, inki QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Eh je' wo' chik wili i xuq'or:</para>
  <para style="q">Naa ruponiik i q'iij chi re' hin naawuksam cho jino'q i xikin riih i reey David</para>
  <para style="q">re' chik i reh naa rokiik chi reyil korik wach ruk'ux, re' holohik,</para>
  <para style="q">eh parub'ehel naa rub'anam</para>
  <para style="q">i q'ataj q'orik chinaah chu'nchel i wach ak'al.</para>
  <para style="q">
    <verse number="6" style="v" />Noq naa ruwihiik chi reyil i reh naa ruko'ljiik i tinamit Judá,</para>
  <para style="q">je' wo' hoq i tinamit Israel pansuqkiil k'uxliis chik naa kik'achariik.</para>
  <para style="q">Eh je' wili i naa rubíhnaam</para>
  <para style="q">jinaj i Dios korik wach ruk'ux quuk', inko'q taqe reh, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" />Eh re' QaJaaw Dios je' wili xuq'or: Re' hin korik i nuq'or chi naa ruponiik i q'iij chi ma' naa ta chik kiq'orom chi je' wili: Xti k'achlik i QaJaaw Dios x-esanik cho keh i aj Israel paruyuq'ul i Egipto, ma' ko'q ta chik taqe. <verse number="8" style="v" />Je' la' chik wili i naa kiq'orom: K'achlik i QaJaaw Dios x-esanik cho keh i aj Israel chupaam i tinamit wilik pantz'eet reje reh i rookb'aal q'iij. Eh xresaj chaloq i rutinamiit chupaam taqe i tinamit kitukem naq wii' kiib', inko'q taqe, ruum re' hin naa wo' chik nuk'amam taqe cho pan kitinamiit, inki.</para>
  <para style="s">Re' xq'orarik keh chi naa rub'aan kuuk' taqe i jalal ruq'oral i Dios ma' korik ta wach kik'ux</para>
  <para style="q">
    <verse number="9" style="v" />Kuum taqe i jalal ruq'oral i Dios</para>
  <para style="q">ma' korik ta wach kik'ux,</para>
  <para style="q">xan yot'ik chik i wánima xakib'arb'otik chik chu'nchel i nub'aqil.</para>
  <para style="q">Xa je' chik nukab' i winaq</para>
  <para style="q">ma' rukuy ta chik i ruxohk'riik noq inwik'raaj,</para>
  <para style="q">ruum kiyo'jik chuwach i QaJaaw Dios,</para>
  <para style="q">chuwach i ru santo laj q'orb'al.</para>
  <para style="q">
    <verse number="10" style="v" />Ruum re' i tinamit wach ak'al</para>
  <para style="q">xa re' chik i ch'uwarisanik wach kikaxaro,</para>
  <para style="q">xa re' i yiib' wach na'ojb'al inki a'n ruum i yiib' wach na'ojb'al inki a'n</para>
  <para style="q">xkahnik i qaye'aab' chi ma' xta chik i wilik chupaam.</para>
  <para style="q">Re' taqe k'im inkik'ux naq i chikop xchiqik chi jumpech.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' taqe i jalal naq nuq'oral, taqe i k'amal kib'eeh</para>
  <para style="q">aj tiij re' wo' taqe haa' chub'anariik i yiib' wach na'ojb'al.</para>
  <para style="q">Re' hin xnureq taqe panupaat chub'anariik.</para>
  <para style="q">
    <verse number="12" style="v" />Re' i keh panq'equm paam b'eeh pan kalik naakib'eeh,</para>
  <para style="q">xa k'isiin naakimihnjik naa kiqehb'iik.</para>
  <para style="q">Ruum re' hin naa nuye'em i ti' k'axik chikinaah</para>
  <para style="q">noq naa ruponiik i q'iij chi nuwach i hin,</para>
  <para style="q">inki QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Re' hin xwilow taqe i kijalwik naq nuq'oral ar Samaria</para>
  <para style="q">chi wilik taqe i ma' imponik ta chi nuwach inki a'n</para>
  <para style="q">re' chik i tiyoox Baal xkiq'or rib'iral.</para>
  <para style="q">Ruuk' taqe re' xkiyeew q'ab' chi xkiq'eb' kiib' i nutinamiit Israel.</para>
  <para style="q">
    <verse number="14" style="v" />Eh xwilow kuuk' taqe i kijalwik nuq'oral ar Jerusaleem</para>
  <para style="q">chi xkian yiib' wach na'ojb'al,</para>
  <para style="q">xa re' i ch'uwa'risanik wach kikaxaro,</para>
  <para style="q">xa re' i chukuj q'orik inki a'n</para>
  <para style="q">Eh inkiyeew rukowiil kik'ux i yiib' wach kib'anik</para>
  <para style="q">reh chi ma' jino'q keh i neenkikanaa' rub'aan.</para>
  <para style="q">Re' taqe re', ruch'ihil chu'nchel i tinamit wilkeeb' ar</para>
  <para style="q">xa je' kikab' i tinamit Sodoma i tinamit Gomorra.</para>
  <para style="q">
    <verse number="15" style="v" />Ruum aj re', re' hin i Dios wilik wajaawriik,</para>
  <para style="q">je' wili i xnuq'or chikiij i jalal nuq'oral re' re':</para>
  <para style="q">Re' hin je' na naa nuye'em keh chi k'uxarik xiik' naah k'ahiil,</para>
  <para style="q">je' na naa nuye'em keh chi uuk'jik i k'ahlaj ha',</para>
  <para style="q">ruum kuuk' taqe i kijalwik nuq'oral ar Jerusaleem</para>
  <para style="q">xelik chaloq i k'ulb'anaj wachiis.</para>
  <para style="q">Eh xooj chi nimaal chinaah chu'nchel i wach ak'al kinki.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Eh re' QaJaaw Dios wilik rajaawriik je' wili i xuq'or:</para>
  <para style="q">Re' taq i hat aj Israel manimaj taq inkiq'or i jalal naq nuq'oral,</para>
  <para style="q">ruum re' inkiq'or taq aweh xachukuj q'orik,</para>
  <para style="q">ruuk' i re' inkiyeew taq rukowiil ak'ux,</para>
  <para style="q">xa re' keh kitz'aqwik wach.</para>
  <para style="q">Eh re' inkiq'or chi nkilow pan kisaqwiriik xa pankanima inchalik</para>
  <para style="q">ma' re' taj i hin kink'uhtanik keh.</para>
  <para style="q">
    <verse number="17" style="v" />Eh je' wili inkiq'or taqe i ki-ixowanik wach i nuq'oral:</para>
  <para style="q">Re' Dios xuq'or chi ma' xta taq ti' naa awilom wach, inki taqe</para>
  <para style="q">eh chi re' taqe i ma' holohik ta kib'anik suq</para>
  <para style="q">naa kiwihiik. Eh re' inki a'n i nelik cho pankanima</para>
  <para style="q">Ma' jino'q i ti' k'axik naa ruchaliik chikinaah inki taqe, inki i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />¿Mi wilik jino'q keh i jalal naq ruq'oral i Dios</para>
  <para style="q">i naab'inik reh i wilik cho panránima i Dios?</para>
  <para style="q">¿Mi wilik jino'q i rilom wach, eh rib'iram i ruq'oral?</para>
  <para style="q">¿Mi wilik jino'q i xuyeew ruk'ux chi rib'irjiik i ruk'uhb'aal eh xuk'am naah?</para>
  <para style="q">
    <verse number="19" style="v" />Re' QaJaaw Dios yohb'aal wach i rujosq'iil</para>
  <para style="q">naa ruye'em chikinaah taqe i yiib' wach kina'ojb'al</para>
  <para style="q">xa je' chik rukab' noq inchalik i kowlaj jab'</para>
  <para style="q">i kowlaj kaq suut teew.</para>
  <para style="q">
    <verse number="20" style="v" />Re' QaJaaw Dios ma' jaruuj naa resam i rujosq'iil chikinaah,</para>
  <para style="q">korehtaal i rub'an i ruyejaam wach paránima.</para>
  <para style="q">Eh pan jinaj q'iij naa taq areqem chi riij</para>
  <para style="q">chib'ih reet noq narojiik eloq wach taqe i re'.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Re' taqe i jalal naq nuq'oral ma' hin ta xin taaq'anik reje keh chi chukuj i q'orik.</para>
  <para style="q">Eh re' keh xankiyeew chik kik'ux chub'aan,</para>
  <para style="q">ma' hin ta xin taaq'anik reje keh.</para>
  <para style="q">Re' keh xakajiim chik kiooj chub'aan.</para>
  <para style="q">
    <verse number="22" style="v" />Wita xkik'am naah inwaaj i hin,</para>
  <para style="q">re' naq i nuq'oral xkiq'or reh i nutinamiit.</para>
  <para style="q">Eh xkesaj naq taqe chaloq chupaam i kiyiib' wach b'eeh,</para>
  <para style="q">eh xkitik'aa' wo' naq rub'aan i kiyiib' wach na'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' hin xa hin wo' Dios chi najt chi ma' najt.</para>
  <para style="q">
    <verse number="24" style="v" />Je' re' noq</para>
  <para style="q">ma' jino'q i rukeb'aa' riib' chi nuwach.</para>
  <para style="q">Re' hin inwilow paam chu'nchel i taxaaj,</para>
  <para style="q">je' wo' paam chu'nchel i wach ak'al.</para>
  <para style="q">Re' wili korik ruum re' hin i Dios kinq'orik.</para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" />Re' hin xb'iraj i chukuj q'orik xkian taqe i jalal naq nuq'oral, re' re' je' wili inkiq'or: Parub'ihnaal i QaJaaw wilik i ruk'uhtaaj qeh pan qawiriik, inki taqe. <verse number="26" style="v" />Re' taqe jalal naq nuq'oral re' re' ¿Kojaruuj inkimay ruq'orariik i xama' korik ta wo' hoq, re' taqe i xa re' i chukuj q'orik xa re' keh kitz'aqwik wach? <verse number="27" style="v" />Eh ruuk' inkixohk'reej pan kiwirik inkiq'or chikiwach inchalik ruyojiik kik'ux intohq'ik kikanaam nunimjiik i hin. Je' rukab' noq xkikanaa' cho nunimjiik i kimaam kati't, re' chik xkinimaj i tiyoox Baal. <verse number="28" style="v" />Eh awach i jalal naq nuq'oral wilik i xixohk'reej paruwiriik, re' wo' chuq'or i k'uhtjik reh. Awach i re' i nuq'oral i ruk'ul re' wo' nuq'oral chuq'or. Ruum re' naq'wach i Trigo ma' elik ta wach ruuk' i rusohk'iil, inki Dios. <verse number="29" style="v" />¿Mi ma' je' rukab' re' i q'aaq' i nuq'oral? ¿Mi ma' je' rukab' re' i nimlaj paxb'al ab'aj?</para>
  <para style="p">
    <verse number="30" style="v" />Ruum aj re', re' hin ma' ruk'ul ta nuk'ux chi re' taqe i jalal naq nuq'oral k'ul inkiq'or chikiwach chi je' re' i nuq'or, inki. <verse number="31" style="v" />Eh je' wo' chik wili i xuq'or i QaJaaw Dios: Re' hin ma' ruk'ul ta nuk'ux chi re' taqe i jalal naq nuq'oral re' re' inkiq'or chi re' nuk'uhb'aal i hin inkiq'or rib'iral xanaah re' xa re' wo' keh kiyej-anik wach. <verse number="32" style="v" />Eh ma' ruk'ul ta nuwach chi re' taqe i jalal naq nuq'oral inkiq'or rib'iral inkilow pan kiwirik xanaah re' xama' korik ta wo' hoq. Ruuk' taqe chukuj q'orik ruuk' taqe i xa kina'ojb'al i keh inkiyoj ruk'ux i nutinamiit. Ma' re' taj i hin kitaaq'anik keh, ma' hin ta kinq'orik keh taqe re'. Re' keh ma' xta kina'ojb'al chi kitoob'jiik taqe i tinamit, inki i Dios.</para>
  <para style="p">
    <verse number="33" style="v" />Re' hat Jeremías wixkipahqaaj aweh i tinamit oon jino'q keh taqe jalal naq i nuq'oral, oon jino'q keh i k'amal kib'eeh aj tiij chi je' wili: ¿Nik' wach i ruq'or i QaJaaw Dios? inko'q taqe aweh. Re' hat je' wili taq i naa aq'orom: Re' ruq'or i QaJaaw Dios, re' chi naa taq kaat rukanaam cha wutkeel, tiko'q keh. <verse number="34" style="v" />Eh wila' re' taqe i tinamit, taqe i jalal naq nuq'oral, taqe k'amal kib'eeh aj tiij nee nq'orik reh chi je' wili: Re' wili i xuq'or i QaJaaw Dios inko'q chi k'onb'al reh i nuq'oral i hin, hin Dios. Re' hin naa nuye'em i ti' k'axik chinaah i reh chikinaah i awach reh parupaat. <verse number="35" style="v" />Neerub'an chi nee rupahqaaj reh i ramigo i ju'jun oon reh i awach reh chi je' wili: ¿Chib'ih xchaq'wik cho wii' i QaJaaw? ¿Chib'ih i xuq'or i QaJaaw? inko'q. <verse number="36" style="v" />Xa re' la' ma' nee ta chik i rub'an chi nee taq ink'ulik pankik'ux i xuq'or i QaJaaw, ruum chu'nchel taq aq'oral naa rukamaniik chi wilik i ti' naa ruk'amam chaloq ruum xayoj taq wach i ruq'oral i k'achlik Dios, re' i Dios wilik rajaawriik chinaah chu'nchel. <verse number="37" style="v" />Eh re' hat Jeremías cha pahqaaj keh i jalal naq nuq'oral chi je' wili: ¿Chib'ih i xatruchaq'weej taq wii' i QaJaaw Dios? ¿Chib'ih i xuq'or taq weh? tiko'q keh. <verse number="38" style="v" />Wila' xaq'or chi je' wili: Re' wili i xuq'or i QaJaaw Dios inko'q taqe. Re' QaJaaw Dios je' wili i ruq'or taq cho chawiij: Ruum chi xaq'or taq i q'orik re' re' je' wili i xuq'or i QaJaaw tiki taq. Eh xnutaq'aaj naq ruq'orariik chi ma' naa ta taq aq'orom chi re' wili ruq'or i QaJaaw, kinki. <verse number="39" style="v" />Ruum re' i korik i nuq'or taq aweh chi naa taq asahchik panuk'ux naa wesam pan naq'nuwach i tinamit xnuyeew naq cho keh aamaam awati't. <verse number="40" style="v" />Eh chi juneliik naa wesam taq i runimaal awach naa nuye'em q'ab' chi naa taq ak'uhtaam ak'ixb'ilaal, ma' naa ta rusahchiik pank'uxliis chi jumpech, inki Dios.</para>
  <chapter number="24" style="c" />
  <para style="s">Re' i kiib' chakach chi higo xk'uhtjik reh i Jeremías paru saq wiriik</para>
  <para style="p">
    <verse number="1" style="v" />Eh noq re' Nabucodonosor ruk'amam chik reje pankowlaj kamanik ar Babilonia i kireey i aj Judío Jeconias rak'uun i Joacim. Eh xi k'amarik taqe reje haa' i k'amal kib'eeh aj Judá, taqe i kiyej-anik reh i xa chib'ih jariik, taqe i aj ch'eyel ch'ihch' wilkeeb' Jerusaleem. Re' QaJaaw Dios xuk'uhtaaj weh i ki'ib' chakach chi higo wilik i koq chuwach i rupaat i Dios ar Jerusaleem. <verse number="2" style="v" />Eh jinaj i chakach q'e' holohik ruq'aniil i higo wilkeeb' chupaam, re' i higo wilkeeb' chupaam i chakach jinaj i q'e' chik yiib' wach k'ahchi' chik kiq'ahiik ni xata naq chik nee ruyeew riib' chi k'uxarik. <verse number="3" style="v" />Eh re' i QaJaaw Dios je' chik wili xuq'or weh: ¿Chib'ih jariik i k'ahchi' awilom wach i hat Jeremías? inki. Re' hin je' wili xnuq'or: Re' hin k'achi' wilom kiwach i higo xa re' la' jinaj chakach i xiik' naah kiholwochiil, eh jinaj chakach xiik' naah yib'kiil kiwach, ni xata naq chik nee ruyeew riib' chi k'uxarik kinki.</para>
  <para style="p">
    <verse number="4" style="v" />Eh re' i QaJaaw Dios je' wili xuq'or weh: <verse number="5" style="v" />Re' hin i ki Dios i aj Israel je' wili nuq'or: Re' i holohaq laj higo wilkeeb' chupaam i chakach jinaj kijalwaach taqe i aj Judá naa kik'amariik reje pankowlaj kamanik chupaam i kiyuq'ul i aj Caldeo, re' i xnub'an keh re' re' jinaj otob'il chi keh. <verse number="6" style="v" />Re' hin naa nuko'liniik keh, naa wo' chik nusutem taqe cho chupaam i kitinamiit wili. Eh naa nuye'em q'ab' chi naakeliik korik ayu' ma' naa ta chik nusacham kiwach, naa taqe nuye'em pan kiye'aab' ma' naa ta chik wesam taqe reje. <verse number="7" style="v" />Re' hin naa nuye'em keh jinaj i ak' laj kapeew reh chi nee kinkikoj chi hin kaJaaw, eh hin ki Dios chi je' re' nee kikahnik chi nutinamiit taqe. Eh re' hin naa nukahniik chi hin ki Dios, ruum chu'nchel i kánima naa wo' chik kinkinimam.</para>
  <para style="p">
    <verse number="8" style="v" />Eh re' taqe i higo xayiib' chik kiwach k'achi' chik kiq'ahiik rujalwaach i Sedequías kireey i aj Judá kuch'ihil taqe i k'amal kib'eeh i tinamit kuch'ihil chu'nchel i ruqox i tinamit xi kahnik Jerusaleem, kuch'ihil taqe i xiooj chi patinik Egipto. Eh naa nub'anam keh je' rukab', imb'aan reh taqe i q'aah laj higo ma' ruyeew ta chik riib' chi nk'uxarik. <verse number="9" style="v" />Wilik i naa nub'anam kuuk' eh ruum i re' naa ruchaliik kiyo'jiik chu'nchel i tinamit wach ak'al. Ruuk' i re' naa wesam i runimaal kiwach, eh naa ruxoowjiik kiwach, ma' holohik taj i naa ruq'orariik chikiij chupaam taqe i tinamit aha' naa nuye'em q'ab' chi naa kik'amariik reje. <verse number="10" style="v" />Re' hin naa nutaq'aam reje i q'aq'ineel, i wi'jaleel, i yab'ilaal chikinaah, korehtaal inkuxik kikimiik ma' jino'q chik i naakikahnik chupaam i ye'aab' nuye'em kekeh, re' wo' i nuye'em cho keh i kimaam kati't, inki i Dios.</para>
  <chapter number="25" style="c" />
  <para style="s">Lajeeb' ru kajwinaq haab' i ti' k'axik i xponik kik'ul pan tokoom tinamit i aj Israel</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios xuq'or cho reh i Jeremías i ruk'uhb'aal wili re' wo' xq'orarik cho keh i aj Judá re' noq kijib' haab' chik rokiik chi reyil ar Judá i Joacim, rak'uun i Josías. Pampeet haab'rokiik chi reyil ar Babilonia i Nabucodonosor. <verse number="2" style="v" />Re' i Jeremías jalal ruq'oral i Dios xuq'or i k'uhb'aal keh chu'nchel i aj Judá, je' wo' keh chu'nchel i aj Jerusaleem, je' wili i xuq'or keh: <verse number="3" style="v" />Xa re' wo' noq oxlaj haab'rokiik chi reyil i Josías ar Judá rak'uun i Amón nutoq'aam cho ruq'orom taq aweh i ruk'uhb'aal i Dios, eh xata wo' jarpech taq xat nuq'oreej, eh xk'uloq ayu' yu'naak. Ixib' ru ka'winaq haab' nutoq'aam chaloq, eh re' taq i hat xama' nab'iraj ta wo' taq. <verse number="4" style="v" />Atoob' ta re' Dios xata wo' jarpech rutoq'aam taq cho aq'orob'jiik, chu'nchel i raj kamanoom taqe i jalal ruq'oral, eh re' taq i hat xama' nab'iraj ta wo' taq xama' nanimaj ta wo' taq chib'ih inkiq'or. <verse number="5" style="v" />Re' keh je' wo' naq wili inkiq'or taq aweh: Chakanaa' taq ayiib' wach b'eeh, cha kanaa' taq ayiib' wach na'ojb'al, chi je' re' nee taq ti k'acharik chupaam i ye'aab' wili xuyeew taq chaaweh i Dios i hat, re' wo' xye'arik cho keh taq aamaam awati't reh junelik. <verse number="6" style="v" />Manimaj taq i tiyoox, maa kamaneej taq kiwach, eh maa yeew taq kiloq'il. Mayeew taq rujosq'iil i QaJaaw Dios ruuk' i kilooqjiik taqe i tiyoox xa atz'aqam taq ruuk' aq'ab', chi je' re' ma' xta wo' ti' k'axik nee ruyeew taq cho cha naah i hat inki wo' naq taqe. <verse number="7" style="v" />Ruum aj re', re' i QaJaaw Dios je' wili i xuq'or taq cha weh: Re' taq i hat ma' kinanimaj ta taq, xayeew taq nujosq'iil ruum xaloq'ej taq i tiyoox xa re' taq i hat xatz'aqwik keh. Ruum i re' xak'am taq chaloq i ti' k'axik cha naah, inki.</para>
  <para style="p">
    <verse number="8" style="v" />Eh wili i xuq'or i QaJaaw Dios nim rajaawriik: Ruum chi re' taq i hat ma' xanimaj ta taq aq'ilariik xnub'an. <verse number="9" style="v" />Re' hin naa nuk'amam chaloq i tinamit wilkeeb' pantz'eet reh rookb'aal q'iij. Naa nuk'amam chaloq i Nabucodonosor kireey i aj Babilonia re' reh naa nukojom chi pleto kuuk' i tinamit wili, eh naa rukuxiik rub'anam keh i patineel wilkeeb' chupaam. Eh je' wo' i tinamit wilkeeb' chi junsuut i tinamit wili, eh naa nukanaam chi ma' xta chik i wilik chupaam, xa ti yo'joq chik ruum naa rukahniik. <verse number="10" style="v" />Eh ma' naa ta chik nuye'em q'ab' chi naa ruwihiik i tz'uuy pan kitinamiit, ma' naa ta chik ruwihiik rusuqkiil k'uxliis. Eh ma' naa ta chik rub'aan i ninq'ijinik i tz'uuy reh kaxáro, ma' naa ta chik rib'irjiik i keeb'al, naa rukahniik chi xaq'equm chik kipaam i tinamit. <verse number="11" style="v" />Chu'nchel i tinamit wili naa rusachariik wach, naa rukahniik chi ma' xta chik i wilik chupaam. Eh jar ch'uq i tinamit Israel chu'nchel naa kik'amariik reje chi ri'sil i rajaawriik i kireey i aj Babilonia, chuwach i lajeeb' rukajwinaq haab'. <verse number="12" style="v" />Eh noq ik'inaq chik i lajeeb' rukajwinaq haab' naa nuye'em chutojariik i ru mahk i Nabucodonosor, re' i kireey i aj Babilonia, chi riij nik' nimaal i ru mahk xub'an. Eh naa nuye'em taqe chutojariik i kimahk i rutinamiit je' wo' taqe i aj Caldeo. Re' hin naa nusacham kiwach chi jumpech. <verse number="13" style="v" />Re' hin naa nuye'em chinaah i tinamit re' re' chu'nchel i ti' k'axik tz'ihb'amaj rehtalil chupaam i huuj wili. Re' i ruq'orom rib'iral i Jeremías chi naakik'ulum chu'nchel i tinamit re' re'. <verse number="14" style="v" />Ruum re' keh naa wo' kiye'ariik panti' k'axik kuum i k'ih seht chi tinamit, je' wo' kuum i reey q'e' wilik kajaawriik. Re' hin naa nuye'em q'ab' chi naa rub'aan keh reh chi naa nuq'ajam wach keh i nakianam reh i nutinamiit, inki i Dios.</para>
  <para style="s">Re' i kulk rehtalil i rujosq'iil i Dios xk'uhtjik reh parusaq wiriik i Jeremías</para>
  <para style="p">
    <verse number="15" style="v" />Re' QaJaaw i qaDios i hoj, hoj aj Israel je' wili i xuq'or weh panusaq wiriik: K'oloq ak'ul panuq'ab' i kulk wili wilik k'ahlaj riis uuva chupaam rehtalil i nujosq'iil naa aye'em keh chi uuk'jik chu'nchel i tinamit aha' naa kaat nutaq'aam. <verse number="16" style="v" />Eh noq naa kuk'em naa ruchaliik kixab'iik, je' na naa ruchalik kahqalil ruum i q'aq'inik naa nutaq'aam cho chikinaah, inki weh.</para>
  <para style="p">
    <verse number="17" style="v" />Eh re' hin xnuk'ul wo' chik i kulk pan q'ab' i QaJaaw Dios, eh xponik chik nuyeew keh chi uuk'jik chu'nchel i tinamit xi rutaq'aaj wii'. <verse number="18" style="v" />Ar chik xtohq'ik reje nuye'em chi uuk'jik Jerusaleem, eh xinooj pan i tinamit Judá, xinooj kuuk' i kireey, eh kuuk' i k'amal kib'eeh, xnuyeew keh chi uuk'jik, reh chi naa rusahchiik kiwach, reh chi naa rub'aan yo'jik kuum, eh chi naa kikaqse'ljiik. Eh chi xab'ajb'al taqe, je' rukab' i k'ahchi' kik'ulum yu'naak. <verse number="19" style="v" />Eh xinooj chik ruuk' i kireey i aj Egipto, kuuk' i raj kamanoom, kuuk' i k'amal kib'eeh, kuuk' chu'nchel i rutinamiit xnuyeew chik keh chi uuk'jik i wilik pan kulk. <verse number="20" style="v" />Eh xnuyeew b'ila' chik keh chi uuk'jik i tokoom tinamit wilkeeb' pan kitinamiit, keh i reey wilkeeb' ar Uz, keh i kireey i aj filisteo, keh Ascalón, keh i aj Gaza, keh i aj Ecrón, keh nik' chik k'ihaal i ruqox i tinamit Asdod. <verse number="21" style="v" />Je' wo' keh i aj Edom, keh i aj Moab, keh i aj Amón. <verse number="22" style="v" />Je' wo' keh chu'nchel i kireey i aj Tiro, keh i aj Sidón, keh chu'nchel i kireey i tinamit wilkeeb' chi chii' i palaw. <verse number="23" style="v" />Je' wo' keh i aj Dan, aj Tema, aj Buz, keh i tinamit inkesaj i rismaal kinaah. <verse number="24" style="v" />Eh je' wo' keh chu'nchel i kireey i aj Arabia, keh i kireey taqe i tokoom tinamit patim taqe chupaam i ye'aab' chiq yuuq'. <verse number="25" style="v" />Je' wo' keh chu'nchel i kireey i aj Zimri, keh i kireey i aj Elam, keh chu'nchel i kireey i aj Media. <verse number="26" style="v" />Eh je' wo' keh chu'nchel i reey wilkeeb' pantz'eet reh i rookb'aal q'iij, keh i wilkeeb' chi najt chi ma' najt, keh chu'nchel i reey wilkeeb' chi junsuut i wach ak'al. Chu'nchel i re' xnuyeew keh chi uuk'jik i k'ahlaj vino, wilik pan kulk. Eh re' kireey i aj Babilonia ko xam chik xuk'ej reh noq xwilow.</para>
  <para style="p">
    <verse number="27" style="v" />Re' hat je' wili i naa aq'orom keh re' i QaJaaw Dios ki Dios i aj Israel nim rajaawriik je' wili xuq'or: Re' wili naa taq awuk'em, naa ruchaliik taq aaxohk'riik, naa ruchaliik taq axab'iik naa taq aq'ehb'iik wach ak'al ma' jaruuj taq chik naa awuktiik, re' wili rehtalil i q'aq'inik naa nutaq'aam taq cha naah, tiko'q keh. <verse number="28" style="v" />Eh wila' ma' inkaaj kik'ulum aweh i kulk je' wili ineneq'or keh: Re' i QaJaaw Dios nim rajaawriik, je' wili i xuq'or: Re' taqe re' xanaa wo' kuk'em keh i k'ah laj riis uuva wilik pan kulk. <verse number="29" style="v" />Re' hin naa nutaq'aam i ti' k'axik chinaah i nutinamiit ¿Nik' wach noq inakapaaj taq i hat chi naa taq rik'iik wach anaah i ti' k'axik? Re' hin i nuq'or taq weh chi ma' naa tarik'iik taq cha naah ruum re' hin naa nutaq'aam i q'aq'inik chinaah chu'nchel i tinamit wilkeeb' chi junsuut i wach ak'al, inki Dios nim rajaawriik.</para>
  <para style="p">
    <verse number="30" style="v" />Eh re' hat cha q'or keh i tinamit chu'nchel i naakik'ulum chi je' wili:</para>
  <para style="b" />
  <para style="q">Re' QaJaaw Dios ruuk' rujosq'iil</para>
  <para style="q">kow naa ruq'oreem chaloq i rutinamiit</para>
  <para style="q">chupaam i rusantolaj ye'aab'.</para>
  <para style="q">Eh je' rukab' noq inkik'er kichii'</para>
  <para style="q">i kiyitz'wik reh i uuva,</para>
  <para style="q">naa ruk'erem cho chii' chikinaah</para>
  <para style="q">chu'nchel i k'achareel wach ak'al.</para>
  <para style="q">
    <verse number="31" style="v" />Re' choqik naa rub'anam naa ruponiik chi junsuut i wach ak'al,</para>
  <para style="q">ruum re' i QaJaaw Dios peleto i rub'an kuuk' chu'nchel i tinamit.</para>
  <para style="q">Eh re' reh naa ruq'atwiik i q'orik chikinaah i k'achareel,</para>
  <para style="q">reh chi ruuk' q'aslaj ch'ihch' naa kikanteesjiik taqe i yiib' wach kina'ojb'al,</para>
  <para style="q">tiko'q keh, inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Re' QaJaaw Dios nim rajaawriik</para>
  <para style="q">je' wili i xuq'or weh:</para>
  <para style="q">Re' ti' k'axik re' re' tuslik naa rik'iik reje chupaam i ju'jun seht chi tinamit</para>
  <para style="q">jinaj i runimaal ti' k'axik naa ruchaliik chikinaah</para>
  <para style="q">tinamit chi junsuut i wach ak'al, inki.</para>
  <para style="q">
    <verse number="33" style="v" />Eh naa ruye'em q'ab' i QaJaaw Dios chi naa kikimiik chupaam taqe q'iij re' re'</para>
  <para style="q">xa aha' naa rukahniik tuuch' i kiti'jolal,</para>
  <para style="q">ma' awach ta naa roq'iniik keh, ma' awach ta naa rumolwiik i kiti'jolal,</para>
  <para style="q">ni xata naa kimuq'ub'jiik, naakikahnik chi ch'alkeeb'</para>
  <para style="q">chinaah i wach ak'al chi je' rusaa' chikop.</para>
  <para style="q">
    <verse number="34" style="v" />Re' taq i hat aj cha'joom, taq i hat k'amal b'eeh</para>
  <para style="q">yiib' taq wach ana'ojb'al cha k'er taq aachii' chi oq'ik,</para>
  <para style="q">cha tolej taq awiib' pan chaaj ruum i ruti'kiil taq ak'ux,</para>
  <para style="q">ruum k'ahchi' chikruponiiki q'iij reh taq akanteesjiik reh taqe i rutukjiik awach.</para>
  <para style="q">Eh naa taq akanteesjiik je' rukab' noq inkanteesjik i q'ina' laj tentzun.</para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" />Eh ma' naa ta chik ruye'em riib' chi naa kimolom chi elik taqe i aj cha'joom,</para>
  <para style="q">eh ma' ta naakiko'leem kiib' chuwach i ti' k'axik i tinamit inkichajeej.</para>
  <para style="q">
    <verse number="36" style="v" />Korik wo' hoq chi naa rib'irjiik chi naakik'erem kichii' taqe i aj cha'joom,</para>
  <para style="q">je' wo' koq'iim taqe i kitinamiit,</para>
  <para style="q">ruum re' QaJaaw Dios naa rukanaam chi ma' xta chik k'uxumb'al keh.</para>
  <para style="q">
    <verse number="37" style="v" />Re' QaJaaw Dios yohb'aal wach naa ruchaliik rujosq'iil</para>
  <para style="q">naa rusacham wach i kitik wilik pan kiye'aab'.</para>
  <para style="q">
    <verse number="38" style="v" />Re' reh yohb'aal wach i rujosq'iil naa ruchaliik</para>
  <para style="q">je' rukab' i rujosq'iil i kaq b'ahlam noq inwuktik cho parusuuq',</para>
  <para style="q">ruum i re' naa rusacham wach tinamit</para>
  <para style="q">Eh naa nuye'em runimaal q'aq'inik chikinaah.</para>
  <chapter number="26" style="c" />
  <para style="s">Re' Jeremías xq'orarik chi naa rukanteesjiik</para>
  <para style="p">
    <verse number="1" style="v" />Eh noq xokik chi reyil i ar Judá i Jocim rak'uun i Josías je' wili i xuq'or weh i QaJaaw Dios: <verse number="2" style="v" />Re' hat chapab'aa' reje awiib' chuwach i nupaat, eh cha q'oreej taqe jar ch'uq i tinamit wilkeeb' ar Judá, re' i kik'ulik chi nulooq'jiik panupaat. Re' hat cha q'or keh chu'nchel i xnuq'or aweh ma' jino'q chik ineenakanaa' chi ma' nee ta naq'or. <verse number="3" style="v" />Nee oon naq inche inki a'n i neenaq'or, nee oon naq inkikanaa' i kiyiib' wach na'ojb'al. Re' hin nee wo' naq chik inuketelaaj kiwach ma' nee ta wo' naq i nuyeew i taqe chutojariik i kimahk i nuyejaam wach chi keh. <verse number="4" style="v" />Re' hat je' wili i neenaq'or keh: Re' i QaJaaw Dios je' wili xuq'or: Wila' ma' xkib'iraj i nuk'uhb'aal xnuq'or keh, i wila' ma' xik'acharik chi je' rukab' i nutijej taqe wii'. <verse number="5" style="v" />Eh wila' ma' xkinimaj i kiq'ilariik imb'aan kuum taqe i jalal nuq'oral re' taqe i k'ih pech wo' naq nutaq'aam taq cho chaq'orob'jiik, eh re' taq i hat xama' xanimaj ta wo' taqe. <verse number="6" style="v" />Re' hin naa nusacham wach i nupaat wili, je' rukab' noq xnusach wach i paat ar Silo. Re' taqe i aj Jerusaleem naa kikahniik chi ma' holohik ta rib'iral chikiwach i tinamit wach ak'al tiko'q keh, inki weh i QaJaaw.</para>
  <para style="p">
    <verse number="7" style="v" />Eh re' taqe i k'amal kib'eeh taqe jalal ruq'oral i Dios, chu'nchel i tinamit xkib'iraj taqe i xuq'or i Jeremías chuwach reje i rupaat i Dios <verse number="8" style="v" />Noq xukohlaaj ruq'orariik i xq'orarik cho reh ruum i Dios, re' taqe i k'amal b'eeh aj tiij, taqe i jalal ruq'oral i Dios je' wo' chu'nchel i tinamit xkichop i Jeremías, je' wili i xkiq'or reh: Re' hat xti korik noq naa akimiik. <verse number="9" style="v" />¿Chib'ih reet noq xaq'or chi re' i Dios naa rusacham wach i rupaat wili je' rukab' noq xusach wach i paat ar Silo, chi naa rukahniik chi xan tz'irik chik paam i tinamit wili chi ma' jino'q chik patineel naa rukahniik chupaam? Chu'nchel i tinamit, xchalik kik'aah chinaah i Jeremías eh xkimol kiib' chuwach i rupaat i QaJaaw.</para>
  <para style="p">
    <verse number="10" style="v" />Eh re' taqe i k'amal kib'eeh i aj Judá noq xkib'iraj i k'ahchi' ruk'ulariik jumehq'iil xiooj chupaam i paat i rub'an wii' i taaq'anik i reey ar kitzunaa' i koq kiib' chi q'ataj q'orik chuwach i ak' puerta. Re' paat re' re' ma' najt ta i koq ruuk' i rupaat i Dios wilik. <verse number="11" style="v" />Eh re' taqe i k'amal b'eeh aj tiij, taqe i jalal naq ruq'oral i Dios je' wili i xkiq'or keh i k'amal kib'eeh i aj Judá, keh chu'nchel i tinamit: Re' winaq wili i ruk'ul chi nee taq inaq'at i q'orik chinaah reh i runkanteesjiik, ruum xuq'or chi naa rusahchiik wach i tinamit wili, eh re' taq i hat xab'iraj taq ruuk' axikin, inki taqe. <verse number="12" style="v" />Eh noq rib'iraj chi je' re' i Jeremías, je' wili i xuq'or keh i k'amal kib'eeh i aj Judá, keh i tinamit: Re' hin re' QaJaaw Dios xtaaq'anik cho weh chi naa nuq'orom chi re' tinamit wili naa rusahchiik wach je' wo' i rupaat i Dios, re' i xnuq'or taq xab'iraj. <verse number="13" style="v" />Je' re' hoq re' taq i hat chajal taq wach ana'ojb'al, je' wo' taq chib'ih i na a'n cha nimaj taq awajaaw aaDios. Chi je' re' ma' nee ta rutaq'aaj taq cho cha naah i ti' k'axik ruyejaam cho wach chi naa taq ak'ulum. <verse number="14" style="v" />Xa re' la' re' hin yu'naak panaq'ab' taq wilkiin chaq'at taq i q'orik chi nunaah nik' wach i ruk'ul chi weh taq inawilow. <verse number="15" style="v" />Xa re' la' chanab'eej taq chi korik chi wi xinakansaj taq i hat wach naah i tinamit wili naa rukahniik i nukimiik ruum re' hin ma' xta numahk ruum chu'nchel i xnuq'or taq xab'iraj re' i QaJaaw Dios xtaaq'anik cho weh chuq'orariik, inki.</para>
  <para style="p">
    <verse number="16" style="v" />Eh re' taqe i k'amal kib'eeh i aj Judá je' wili i xkiq'or reh taqe i k'amal kib'eeh aj tiij, keh i tinamit: Re' i winaq wili korik chi ma' xta ru mahk ma' ruk'ul taj chi neenqa q'at i q'orik chinaah, korik wo' hoq chi re' i xuq'or qeh re' wo' i QaJaaw Dios xq'orik cho reh, inki taqe. <verse number="17" style="v" />Wilik wo' taqe i mama' winaq wilik kina'ojb'al xipa'lojik johtoq je' wili i xkiq'or reh i tinamit kimolom kiib' ar: <verse number="18" style="v" />Noq xwihik cho chi reyil i Ezequías ar Judá re' i Miqueas aj Moreset, xuq'or wo' keh chu'nchel i tinamit Judá i xuq'or chee QaJaaw, je' wili i xuq'or:</para>
  <para style="b" />
  <para style="q">Re' QaJaaw Dios nim rajaawriik xuq'or chi</para>
  <para style="q">re' ye'aab' Sión naa rukahniik chi xa je' chik rukab' i ye'aab' ab'iixomaj wach,</para>
  <para style="q">re' tinamit Jerusaleem naa ruch'a'lojiik wach ak'al.</para>
  <para style="q">Eh re' yuuq' wilik wii' i rupaat i Dios naa ruchaamb'iik i ch'ahn chuwach, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" />Re' i reey Ezequías, re' i tinamit Judá, ¿Mi xkikansaj re' i Miqueas chi riij i xuq'or? Xuyohleej la' wach i QaJaaw Dios i reey, xub'an rutiij chuwach i QaJaaw Dios. Eh re' i QaJaaw ma' xuyeew ta wo' chaloq chikinaah i ti' k'axik ruyejaam naq cho wach. ¿Mi neerub'an re' chi re' hoj neenqayuq'eej i ti' k'axik chi qanaah ruum i rukanteesjiik i winaq wili? inki.</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' Urías jalal ruq'oral i Dios, rak'uun i Senaias aj pan tinamit Quiriat-jearim xuq'or cho rib'iral chi re' Dios naa rusacham wach i tinamit wili, je' wo' chu'nchel i ruyuq'ul i tinamit, je' rukab' i xuq'or i Jeremías.</para>
  <para style="p">
    <verse number="21" style="v" />Eh re' reey Joacim ruch'ihil taqe i kikamanik ruuk', taqe i k'amal b'eeh noq xkib'iraj rib'iral i xuq'or i Ursias xkaaj naq kikansam, eh noq xunab'eej i Urías chi je' re' xumol chi elik xooj pan tinamit Egipto. <verse number="22" style="v" />Eh re' reey Joacim xutaq'aaj ar Egipto i Elnatán rak'uun i Acbor wilik wo' chik taqe i winaq xutaq'aaj reje haa'. <verse number="23" style="v" />Re' keh xi ponik k'amwoq reh i Ursias ar Egipto xk'ulik kiq'asaj pan q'ab' i reey Joacim, eh xutaq'aaj rukanteesjiik, xuq'or chi naa rumuq'ub'jiik i ruti'jolal chupaam i xanik' wach jul, inki taqe.</para>
  <para style="p">
    <verse number="24" style="v" />Re' i Ahicam rak'uun i Safán xuko'leej riij i Jeremías, je' re' noq ma' xq'atarik taj i q'orik chinaah, ruum aj re' ma' xkanteesjik ta kuum i tinamit.</para>
  <chapter number="27" style="c" />
  <para style="s">Re' ruq'orariik chi re' tinamit naakiq'ahtesjiik pan q'ab' Nabucodonosor</para>
  <para style="p">
    <verse number="1" style="v" />Noq koxokik chi reyil ar Judá i Sedequías rak'uun i Joacim je' wili xq'orarik cho reh i Jeremías ruum i QaJaaw Dios: <verse number="2" style="v" />Re' hat cha yejaa' junrahp-oq i tz'uhuum cha yejaa' jino'q i per per wach chee', eh neenab'ak' riij awalaq i hat. <verse number="3" style="v" />Eh neenataq'aaj reje i q'orik reh i kireey i aj Edom, i kireey i aj Moab i kireey i aj Amón, kireey i aj Tiro, kireey i aj Sidón. Re' i q'orik re' re' neenataq'aaj reje chikiij i aj taqareel kik'ulik Jerusaleem ruuk' i Sedequías kireey i aj Judá. <verse number="4" style="v" />Neenataq'aaj reje ruq'orariik keh chi neenkiq'or reh taqe ajaab'ees wilik chikinaah chi re' hin i ki Dios i aj Israel nim wajaawriik, je' wili nuq'or. <verse number="5" style="v" />Eh neenkiq'or ponoq chi re' hin Dios ruuk' i runimaal i wajaawriik xnuyejaa' i wach ak'al i winaq, i chikop wilkeeb' chupaam. Eh neenuyeew keh awach aj eh inwaaj nuye'em i hin. <verse number="6" style="v" />Eh yu'naak i k'ih seht i tinamit wilik wach ak'al xnuq'asaj chik pan q'ab' i Nabucodonosor re' naa rukamaniik weh re' i kireey i aj Babilonia, eh xnuq'asaj chi ri'sil i rajaawriik taqe i josq' laj chikop wilkeeb' panch'ahn. <verse number="7" style="v" />Chu'nchel i tinamit naakikamaniik reh, je' wo' taqe i kak'uun kixq'uun, i kiih kimaam korehtaal inkahnik i kitinamiit chi ri'sil i rajaawriik, je' wo' taqe i k'ih seht chi tinamit, je' wo' taqe reey wilik kajaawriik.</para>
  <para style="p">
    <verse number="8" style="v" />Eh wila' wilik tinamit, wilik i reey ma' xkaaj ta kikamaneem wach i Nabucodonosor kireey i aj Babilonia, wila' ma' xuloch' riib' je' rukab' noq i ruloch' riib' i b'ooyax noq inkojarik i per per wach chee' wach naah. Re' hin naa nuye'em ti' k'axik chinaah, ruuk' q'aq'inik, ruuk' wi'jaleel ruuk' yab'ilaal korehtaal i ruyeew riib' chi ri'sil i wajaawriik, inki i Dios. <verse number="9" style="v" />Eh re' taq i hat manimaj taq i neenkiq'or i jalal q'orik, taqe i aj q'iij, taqe i aj war taqe i wilik inkixohk'reej, inkiq'or tii chik rib'iral chib'ih i naa ruk'ulariik manimaj taq wixkiq'or taq aweh chi maakamaneej taq wach i kireey i aj Babilonia. <verse number="10" style="v" />Ruum re' taqe re' xachukuj q'orik inkiq'or, wila' xayeew taq awiib' chi jot'arik, re' hin naa taq kaat wesam reje panaye'aab', naa taq kaat nutaq'aam reje chi najt, ar taq naa awojiik kimoq. <verse number="11" style="v" />Eh re' taqe i jarseht chi tinamit naa kiq'asam kiib' chi ri'sil i rajaawriik i kireey i aj Babilonia re' hin naa nuye'em q'ab' chi naa kikahniik chupaam i kitinamiit, reh chi ar neenkitik chib'ih keh, inko'q taqe, inki weh i Dios.</para>
  <para style="p">
    <verse number="12" style="v" />Eh re', hin i Jeremías xnuq'or wo' chik reh i Sedequías kireey i aj Judá taqe i re'. Eh nuq'or wo' reh chi chuq'asaj riib' chi ri'sil i rajaawriik i kireey i aj Babilonia chakamaneej wach je' wo' rutinamiit chi je' re' ma' nee ta tikimik. <verse number="13" style="v" />¿Chib'ih neerutiq aweh chi nee nayeew awiib' chi kimik i hat, eh neenayeew chi kimik aatinamiit ruum wi'jaleel, ruum q'aq'inik, ruum yab'ilaal? Ruum re' i QaJaaw Dios ruq'orom chi je' re' i kimik naakik'ulum jarseht i tinamit ma' naa kikamaneem wach i kireey i aj Babilonia. <verse number="14" style="v" />Re' hat manimaj taqe i jalal ruq'oral i Dios inki a'n kiib', wila' xkiq'or aweh chi maa a'n rukamaj i kireey i aj Babilonia ruum re' inkiq'or xachukuj q'orik, inko'q taqe. <verse number="15" style="v" />Re' QaJaaw Dios i ruq'or chi ma' re' tee reh intaaq'anik keh, chuq'orariik inkiq'or. Wila' xanimaj keh naa kaat resam reje panaye'aab' i QaJaaw i hat, taqe aatinamiit taqe i jalal ruq'oral i Dios inki a'n kiib', hat taq junkimiik kuuk' inki reh.</para>
  <para style="p">
    <verse number="16" style="v" />Eh re' taqe i k'amal kib'eeh aj tiij, taqe i tinamit je' wo' wili i xuq'or keh: Manimaj taq keh i jalal nuq'oral inki a'n kiib' wila' xkiq'or taq aweh chi xa chi jumehq'iil naa taq aweliik cho pan tinamit Babilonia, eh naa taq ak'amam chaloq i chib'ih jariik taqe kulk nkamanik panupaat. Re' taq ineenkiq'or aweh re' re' xachukuj q'orik. <verse number="17" style="v" />Manimaj taq keh ineenkiq'or taq aweh chakamaneej la' taq wach i kireey i aj Babilonia, chi je' re' ma' nee ta taq tikimik, inko'q taqe. ¿Chib'ih taq neerutiq aweh chi nee taq i nayeew q'ab' chi re' taq aatinamiit wili neensahchik wach? <verse number="18" style="v" />Wila' korik keh chi jalal taqe nuq'oral kipahqaaj wee hin Dios nim wajaawriik, chi ma' nee ta kik'amarik reje Babilonia i chib'ih taqe jariik inkamanik panupaat ko kanlik ar, je' wo' hoq i ko kanlik parupaat i kireey ar Judá i rub'an wii' taaq'anik, je' wo' hoq i ko kanalkeeb' Jerusaleem inki. <verse number="19" style="v" />Re' QaJaaw Dios nim rajaawriik je' wili xuq'or chi riij taqe i nimaq ch'iit q'an ch'ihch' kiyej-aal, chi riij i molb'al ha', taqe i ch'ikaab' reh i q'an ch'ihch' ruyej-aal chi riij i ruqox taqe i chib'ih jariik inkamanik parupaat i Dios kox kahnik chupaam i tinamit wili. <verse number="20" style="v" />Re' taqe i ma' xuq'uch ta reje i Nabucodonosor kireey i aj Babilonia, noq xresaj reje Jerusaleem xuk'am reje Babilonia i Jeconias kireey i aj Judá rak'uun i Joásim, je' wo' chu'nchel i xa atoob' wach kik'ux wilkeeb' naq Judá wilkeeb' naq Jerusaleem. <verse number="21" style="v" />Chanab'eej taq chi re' i QaJaaw Dios i hoj, hoj aj Israel nim rajaawriik, je' wili i xuq'or chi riij taqe i xa chib'ih jariik ko kanlik inkamanik parupaat i reh, je' wo' hoq i wilkeeb' parupaat i kireey i aj Judá, i wilkeeb' ar Jerusaleem: <verse number="22" style="v" />Chu'nchel i re' naa kik'amariik reje Babilonia, ar naa kiwihiik kore' chik naa ak'amam taqe chaloq chupaam i ye'aab' wili noq naa nuq'asam pan kiq'ab' i aj ixowaal i tinamit Babilonia inki Dios, kinki keh.</para>
  <chapter number="28" style="c" />
  <para style="s">Re' i ma' korik taj xuq'or rib'iral i Hananías</para>
  <para style="p">
    <verse number="1" style="v" />Eh paroo' poh reh i haab' re' re', re' noq kijib' haab'rokiik chi reyil ar Judá i Sedequías. Re' i Hananías jalal ruq'oral i Dios i rub'an riib', rak'uun i Azur aj Gabaón, xuq'oreej i Jeremías ar parupaat i Dios chikiwach i k'amal b'eeh aj tiij. Eh chikiwach chu'nchel i tinamit, je' wili i xuq'or reh: <verse number="2" style="v" />Re' QaJaaw Dios nim rajaawriik, re' ki Dios i aj Israel je' wili xuq'or: Re' hin naa wesam taqe i aj Israel chi ri'sil i rajaawriik i Nabucodonosor kireey i aj Babilonia. <verse number="3" style="v" />Re' hin xa pan kiib' haab' wo' chik i nuk'am taqe cho ayu' chu'nchel i xa chib'ih jariik inkamanik panupaat re' taqe i xuk'am reje Babilonia i reey Nabucodonosor. <verse number="4" style="v" />Eh naa wo' chik nuk'amam chaa yu' i Jeconias kireey i aj Judá rak'uun i Joacim, Naa wo' chik nuk'amam taqe chaloq chu'nchel i tinamit k'amooj taqe reje ar Babilonia, naa wesam i rajaawriik i kireey i aj Babilonia, inki i Dios.</para>
  <para style="p">
    <verse number="5" style="v" />Eh chikiwach chu'nchel i tinamit, chikiwach chu'nchel i k'amal b'eeh i aj tiij wilkeeb' parupaat i Dios je' wili i xuq'or i Jeremías reh i Hananías jalal ruq'oral i Dios i rub'an riib'. <verse number="6" style="v" />Ma' xta reet korik ta naq chi neerub'an Dios inaq'or, re' naq i QaJaaw Dios nee nq'orik chi korik ti q'orik. Nee naq inooj iloq wach i xaq'or chi naa wo' chik kik'amariik cha yu' i xa chib'ih jariik inkamanik parupaat i Dios. Eh chi naa wo' chik kik'amariik chaloq chu'nchel i tinamit k'amooj taqe reje Babilonia. <verse number="7" style="v" />Xa re' la' re' hin, inwaaj chi neenab'iraj i q'orik naa nuq'orom aweh, inwaaj wo' chi neenkib'iraj i tinamit: <verse number="8" style="v" />Re' taqe i jalal ruq'oral i Dios wihinaq taqe chaloq najtir, noq komajaa' ti aasjik i hat, je' wo' hoq i hin. Re' keh xa kiq'orom wo' cho rib'iral chi naa ruwihiik q'aq'inik, chi naa ruwihiik ti' k'axik, wi'jaleel chupaam taqe i ju'jun seht chi tinamit. Eh je' wo' chikinaah taqe i reey nim kajaawriik. <verse number="9" style="v" />Eh awach i jalal ruq'oral i Dios inq'orik chi naa ruwihiik i suq laj k'acharik, eh noq inooj eloq wach i ruq'or, ar inreqarik chi riij chi korik chi re' i QaJaaw Dios inq'orik reh i ruq'or, inki.</para>
  <para style="p">
    <verse number="10" style="v" />Noq xrib'iraj chi je' re' i Hananías ma' k'isiin ta xchalik ruk'aah xulahk'aaj i per per wach chee' ruye'em naq rijnaah i Jeremías xutoqib'eej. <verse number="11" style="v" />Re' Hananías je' wili i xuq'or keh i tinamit kimolom kiib' ar: Re' QaJaaw Dios korik chi je' wili xuq'or: Pan kiib' haab' noq naa wesam taqe chu'nchel i tinamit chi ri'sil i rajaawriik i Nabucodonosor kireey i aj Babilonia naa nusacham wach i rajaawriik, inki. Eh chupaam i jumehq' re' re' xelik reje ar i Jeremías. <verse number="12" style="v" />Eh noq re' Hananías i jalal ruq'oral i Dios i rub'an riib' rutoqib'eem chik i per per wach chee' ruye'em naq riij naah i Jeremías jalal ruq'oral i Dios xq'orob'jik Jeremías je' wili xq'orarik reh: <verse number="13" style="v" />Yu'naak hiy ruuk' i Hananías je' wili cha q'or reh, re' QaJaaw je' wili xuq'or: Re' reh per per wach chee' i xutoqib'eej, re' wilik naq riij anaah i hat. Eh re' hin jinaj i per per wach ahl laj ch'ihch' nuyejaam chi naa nukojom rij naah i reh. <verse number="14" style="v" />Ruum re' hin i Dios nim wajaawriik hin ki Dios i aj Israel je' naa per per ahl laj ch'ihch' i nukoj rij kinaah chu'nchel i nimaq tinamit, reh chi naa kiminariik pankowlaj kamanik ruum i Nabucodonosor kireey i aj Babilonia. Eh nuyeew wo' chi ri'sil i rajaawriik taqe i josq'laj chikop, tiko'q reh, inki Dios. <verse number="15" style="v" />Eh re' Jeremías je' wili i xuq'or reh i Hananías: Chab'iraj i hat Hananías re' QaJaaw Dios xuq'or chik weh chi ma' re' tee reh xq'orik aweh taqe i xaq'or, je' re' noq re' hat xachukuj q'orik i na a'n keh i tinamit. <verse number="16" style="v" />Ruum aj re', re' QaJaaw Dios je' wili i xuq'or chawiij: Re' reh naa wesam i ruk'achariik chinaah i wach ak'al. Eh xa chupaam i haab' wili naa rukimiik, ruum taqe i xuq'or keh i tinamit ruuk' i re' xin kiq'eb' chi riij kik'ux, inki. <verse number="17" style="v" />Eh re' Hananías xkimik wo' hoq chupaam i ruwuuq poh ree haab' re' re'.</para>
  <chapter number="29" style="c" />
  <para style="s">Re' ruhuuj i Jeremías xutaq'aaj reje keh i k'amooj taqe reje pan tokoom tinamit</para>
  <para style="p">
    <verse number="1" style="v" />Re' Jeremías jalal ruq'oral i Dios ar wilik Jerusaleem noq xutaq'aaj reje kihuuj i ruqox taqe mama' winaq wilik kina'ojb'al k'amooj taqe reje pan tokoom tinamit kuch'ihil taqe i k'amal kib'eeh aj tiij, taqe i jalal ruq'oral i Dios, kuch'ihil i tinamit xiehtesjik reje Jerusaleem xuk'am reje i Nabucodonosor ar Babilonia. <verse number="2" style="v" />Re' wili re' xb'aan noq ko xelik reje Jerusaleem i reey Jeconias ruch'ihil ixoq reey tuutb'ees, taqe nimaq wach kikamaj, ruch'ihil taqe i aj Jerusaleem, ruch'ihil taqe i aj ch'eyelch'ihch', taqe i kiyej-anik xa chib'ih jariik. <verse number="3" style="v" />Re' huuj re' re' xuk'am reje i Elasa rak'uun i Sefa, ruch'ihil i Gemarías rak'uun i Hilcías. Re' taqe i xutaq'aaj reje i Sedequías kireey i aj Judá ar Babilonia reh chi xi ponik ruuk' i Nabucodonosor kireey i aj Babilonia, eh re' huuj je' wili i ruq'or chupaam.</para>
  <para style="b" />
  <para style="pi">
    <verse number="4" style="v" />Re' QaJaaw Dios nim rajaawriik, re' i qaDios i hoj, hoj aj Israel, je' wili ruq'or keh, chu'nchel i xuyeew q'ab' chi xi elik reje Jerusaleem, eh xi k'amarik reje Babilonia: <verse number="5" style="v" />Chayejaa' taq i aapaat, ti patinoq taq chupaam, cha tik taq i chee' re' ruuk' i kiwachinik, eh cha a'n taq rusuqkiil i neenkiwachuj. <verse number="6" style="v" />Cha a'n taq kaxáro i hat, wih-oq taq awak'uun awixq'uun. Eh re' keh naa wo' kianam kaxáro, eh naa wo' ruwihiik kak'uun kixq'uun, reh chi nee taq ti k'ihaaxb'ik ar ma' nee ta intohq'ik rusahchiik taq awach. <verse number="7" style="v" />Tikamanoq taq, reh chi neenwihik i suq kiil k'uxliis chupaam i tinamit xat nutaq'aaj taq wii'. Eh cha pahqaaj taq weh, reh chi suq neen wihik i tinamit, ruum wii suq xwihik i tinamit re' re' suq wo' nee ti wihik taq i hat. <verse number="8" style="v" />Re' hin i Dios kiDios i aj Israel nim wajaawriik, i nuq'or taq aweh wili: Mayeew taq awiib' chi jot'arik keh i jalal nuq'oral inki a'n kiib', je' wo' keh i aj q'iij wilkeeb' taq panaxilak. Eh manimaj taq keh wila' xkiq'or taq aweh inkilow pan kiwiriik. <verse number="9" style="v" />Eh wila' xkiq'or taq aweh chi re' hin kinq'orik keh inkiq'or taq aweh xan kichuk ruum ma' hin ta kinq'orik keh, inki Dios. <verse number="10" style="v" />Eh je' wo' chik wili i xuq'or: Eh noq naa taq akohlaam i lajeeb' ru kajwinaq haab' taq awihik ar Babilonia, wilik i naa nub'anam chi toob'al taq aweh i hat. Naa nub'anam i nuq'orom, re' chi naa wo' chik taq kaat nusutem cho chupaam aatinamiit wili. <verse number="11" style="v" />Ruum re' hin weht'al chib'ih jariik i nuyejaam wach cha weh taq i hat reh chi suq taq naa awihiik, je' rukab' i k'ahchi' awuy-eem taq i hat, ma' re' ta yiib' wach i k'ahchi' nukapaam taq chawiij, inki i Dios. <verse number="12" style="v" />Eh chupaam i q'iij re' re' naa taq kiin aq'oreem, eh re' hin naa wo' taq kaat b'iram, eh naa taq apahqaam weh panatiij chib'ih taq inawaaj, re' hin naa wo' nuye'em taq aweh. <verse number="13" style="v" />Noq naa taq kiin asik'im naa wo' kiin taq areqem ruum chu'nchel taq ak'ux naa kiin asik'im. <verse number="14" style="v" />Eh noq hin taq chik areqem, re' hin naa wo' chik taq kaat wesam cho panti' k'axik. Naa taq kaat wesam cho chupaam taqe i nimaq tinamit chupaam taqe i ye'aab' aha' taq xat'ooj noq xnutukej taq reje awach. Chi je' re' naa wo' chik numolom taq awach ayu' aha' xat wesaj taq reje wii', inki i Dios. <verse number="15" style="v" />Xa re' la' re' taq i hat yu'naak je' taq wili inaq'or: Re' QaJaaw xusik' wo' wach i jalal ruq'oral ayu' Babilonia, tiki taq. <verse number="16" style="v" />Eh re' QaJaaw Dios je' wili i ruq'or chi riij i wilik chi reyil ayu' re' wihinaq cho wii' chi reyil i David, je' wo' chikiij taqe i patim chupaam i tinamit wili, je' wo' chikiij taqe i ma' tokoom ta taq awuuk' re' i ma' xi k'amarik ta taqe reje chawiij pan tokoom tinamit. <verse number="17" style="v" />Re' hin i Dios wilik wajaawriik, je' wili nuq'or chi re' hin naa nuye'em taq cho cha naah i q'aq'inik, wi'jaleel, i yab'ilaal. Reh chi naa taq kaat nukanaam chi je' rukab' i q'aah laj higo xama' xta chik kamaj ma' ruyee ta chik riib' chi neenk'uxarik. <verse number="18" style="v" />Re' hin ma' naa ta nukanaam ruye'ariik q'aq'inik, i yab'ilaal, i wi'jaleel taq cha naah, naa taq kaat nukanaam chi xa hat taq se'lb'al, chi naa taq ak'uhtaam ak'ixb'ilaal, chi naa taq akahniik chi xa je' taq hat yohb'isaneel. Eh naa taq akahniik chi ma' holohik ta taq awib'iral chi keh chu'nchel i tinamit nutukem taq reje wii' awach. <verse number="19" style="v" />Ruum re' taq i hat ma' nab'iraj ta taq i nuk'uhb'aal inkiq'or taq aweh waj kamanoom. Re' taqe i jalal nuq'oral xnutaq'aaj taq cho chaq'orob'jiik pampeet, eh je' wo' yu'naak xakok'ahchi' wo' nutaq'aam taq cha wuuk', eh xama' nawaaj ta wo' taq animam, inki Dios. <verse number="20" style="v" />Je' re' noq chawunchelaal taq i hat aj Jerusaleem i xnuyeew q'ab' chi xat k'amarik taq reje Babilonia cha nimaj taq i nuk'uhb'aal, inki. <verse number="21" style="v" />Eh je' wili xuq'or i QaJaaw Dios ki Dios i aj Israel nim rajaawriik, chi riij i Acab rak'uun i Colaias, chi riij i Sedequías rak'uun i Maasías, re' chi re' taqe chukuj q'orik inki a'n hin kinq'orik keh noq inkiq'or, re' hin naa nuye'em q'ab' chi naa kojiik q'ehb'oq pan q'ab' i Nabucodonosor kireey i aj Babilonia, eh naa kikanteesjiik chawach taq i hat. <verse number="22" style="v" />Eh chu'nchel i aj Judá k'amooj taqe reje Babilonia noq inkaaj chi naa ruk'ulum i ma' holohik taj i tokoom, je' wili i naa kiq'orom: Neeta naq i rub'an cha wuuk' i QaJaaw je' rukab' i xub'an cho ruuk' i Sedequías ruuk' Acab, noq xi k'atarik pan q'aaq' chi k'achlik kiwach. Ruum i Nabucodonosor kireey i aj Babilonia inko'q taqe. <verse number="23" style="v" />Ruum re' keh xkian i yiib' wach na'ojb'al kuuk' i aj Israel, eh xkich'uwa'risaj wach i kikaxarohiil, ruuk' i rehk'een i kas kichaaq', eh ruum chi xkiq'or chi re' hin xinq'orik keh i chukuj q'orik inki a'n Xanaah re' ma' re' ta wo' hin kinq'orik keh, inki i Dios inki panhuuj.</para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" />Re' QaJaaw Dios xuq'or reh i Jeremías chi je' wili i naa ruq'orom reh i Semaías aj Nehelam. <verse number="25" style="v" />Re' QaJaaw Dios nim rajaawriik, je' wili ruq'or: Re' i hat xataq'aaj reje jinaj i huuj xa panab'ihnaal i hat keh chu'nchel i tinamit wilkeeb' Jerusaleem. Eh je' wo' keh chu'nchel i k'amal kib'eeh i aj tiij wilkeeb' ar, xaq'or reje reh i Sofonías rak'uun i Maasías panhuuj chi je' wili: <verse number="26" style="v" />Re' QaJaaw Dios xkojwik aweh chi k'amal b'eeh aj tiij, chi jilow i Joiada reh chi re' hat i k'amal b'eeh chi rilariik i rupaat i Dios. Eh wila' awach i yojinaq i naah xoj k'oloq xtohq'ik-oq ruq'orom i q'orik je' rukab' inkiq'or i jalal ruq'oral i Dios, re' hat panaq'ab' wilik ruye'ariik pantz'ilom, eh neena lutz' paam chee' i rooq. <verse number="27" style="v" />¿Chib'ih reet noq komajaa' inachop i Jeremías aj Anatot rukoj riib' chi jalal ruq'oral i Dios? <verse number="28" style="v" />Re' reh je' wili i xutaq'aaj cho ruq'orariik qeh ayu' Babilonia: Re' taq i hat najt taq naa a'nam cho ar Babilonia, cha yejaa' taq apaat, ti patinoq taq chupaam. Eh cha tik taq i chee' re' ruuk' kiwachinik naa taq ak'uxum i naakiwachum, tiki reje maje' i nuchjik.</para>
  <para style="p">
    <verse number="29" style="v" />Eh re' k'amal b'eeh aj tiij Sofonías rub'ihnaal rilom wo' naq chik wach i huuj re' re' chi xikin i Jeremías jalal ruq'oral i Dios. <verse number="30" style="v" />Chi riij i re', je' wili i xq'orarik reh i Jeremías: <verse number="31" style="v" />Chataq'aaj reje ruq'orariik keh chu'nchel i k'amooj taqe reje Babilonia chi re' hin i Dios je' wili i nuq'or: Re' i Semaías aj Nehelam xuq'or chi re' hin xinq'orik reh taqe xuq'or. Eh ma' hin ta wo' hoq, xuch'ikaa' taq ak'ux i hat ruuk' taqe i chukuj q'orik xub'an. <verse number="32" style="v" />Re' hin i Dios naa nuye'em chutojariik i ru mahk i Semaías, je' wo' taqe i riih rumaam, ma' naa ta rupatiniik i awach reh chi kixilak i nutinamiit. Eh ni xata naakehtriik i rusuqkiil k'uxliis naa nuye'em i keh i nutinamiit, ruum xkichuk taq aweh i q'orik, eh ruum i re' xakanaa' taq nunimjiik i hat tiko'q reje keh, inki weh i Dios.</para>
  <chapter number="30" style="c" />
  <para style="s">Re' xuq'or i QaJaaw Dios chi naa rub'anam cho ruuk' i rutinamiit</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or reh i Jeremías: <verse number="2" style="v" />Re' i QaJaaw i qaDios i hoj, hoj aj Israel je' wili xuq'or: Re' hat cha tz'ihb'aaj chupaam jino'q i huuj chu'nchel taqe i xnuq'or aweh. <verse number="3" style="v" />Ruum re' hin naa ruponiik i q'iij chi naa wesam taqe cho panti' k'axik i nutinamiit Israel, taqe i aj Judá. Re' hin kinq'orik reh chi naa wo' chik nuk'amam taqe chaloq pan kitinamiit re' nuye'em cho chi kikooch i kimaam kati't, inki.</para>
  <para style="p">
    <verse number="4" style="v" />Re' taqe i wili xuq'or i QaJaaw chikiij i aj Israel, i aj Judá: <verse number="5" style="v" />Je' wili i xuq'or i QaJaaw Dios:</para>
  <para style="b" />
  <para style="q">Re' hin imb'iraj chi xa re' oq'ik inki a'n i nutinamiit ruum i ruti'kiil kik'ux.</para>
  <para style="q">Eh xa pan yo'jik wilkeeb' ma' xta rusuqkiil kik'ux.</para>
  <para style="q">
    <verse number="6" style="v" />Re' taqe i winaq q'e' ti' wilkeeb'</para>
  <para style="q">xan kiyot' chik i kiyej-aal xasaq moq'ik chik taqe,</para>
  <para style="q">xa je' chik rukab' inki a'n ixoq</para>
  <para style="q">noq ach k'isiin ma' nk'ulik kik'ux.</para>
  <para style="q">
    <verse number="7" style="v" />Eh chupaam taqe q'iij re' re' i naakik'ulum i ti' k'axik,</para>
  <para style="q">i ma' jank'al ta nilarik.</para>
  <para style="q">Jinaj runimaal ti'kiil k'uxliis chi keh i aj Israel riih rumaam taqe i Jacob.</para>
  <para style="q">Xa re' la' re' hin naa wesaniik keh chupaam.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Eh re' QaJaaw Dios nim rajaawriik, je' wili i xuq'or:</para>
  <para style="q">Re' hin korik i nuq'or chi naa wesam taqe chaloq i nutinamiit</para>
  <para style="q">chi ri'sil i rajaawriik i tokoom tinamit ma' jaruuj</para>
  <para style="q">chik naa kik'amariik reje pan tokoom tinamit.</para>
  <para style="q">
    <verse number="9" style="v" />Re' la' chik i hin naa kikamaneem nuwach, hin ki Dios,</para>
  <para style="q">naa wo' kikamaneem wach i riih rumaam i David</para>
  <para style="q">re' naa nukojom chi reey na' chub'an, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' taq i hat riih rumaam Jacob, hat taq aj Israel, hat taq waj kamanoom,</para>
  <para style="q">matyo'jik taq ruum re' hin naa taq kaat wesam chaloq hat,</para>
  <para style="q">je' wo' taqe awak'uun awixq'uun</para>
  <para style="q">chupaam inajt laj tinamit xat k'amarik taq reje wii'.</para>
  <para style="q">Eh naa wo' chik taq aak'achariik pansuqkiil k'uxliis,</para>
  <para style="q">ma' xta chik naa ruyohb'isaniik taq aweh.</para>
  <para style="q">
    <verse number="11" style="v" />Ruum re' hin taq aaDios naa nuwihiik taq awuuk' chako'ljiik.</para>
  <para style="q">Eh naa nusacham kiwach taqe i tinamit,</para>
  <para style="q">xnutukej taq reje wii' awach.</para>
  <para style="q">Re' taq i hat ma' naa ta nusacham taq awach,</para>
  <para style="q">xanaa la' taq kaat nuye'em panti' k'axik je' rukab' i ruk'ul taq cha weh.</para>
  <para style="q">Eh ma' naa ta nukanaam chi ma' naa ta taq atojom riij amahk, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Ruum re' i QaJaaw je' wili xuq'or:</para>
  <para style="q">Re' taq amahk xiik' wo' chik naah yib'kiil wach</para>
  <para style="q">je' naa rukab' jino'q i q'aah laj yok'eel ma' xata ruq'omal iraaj.</para>
  <para style="q">
    <verse number="13" style="v" />Ma' awach ta taq intoob'inik aweh ruuk' aak'axkiil,</para>
  <para style="q">ma' awach ta niq'omanik reh taq ati'kiil, xanaah re' ma' xata wo' chik ruq'omal iraaj</para>
  <para style="q">
    <verse number="14" style="v" />Re' taqe i q'e' naq kik'axwik taq aweh xat sahchik taq pankik'ux</para>
  <para style="q">ma' tikikapaaj ta taq chik,</para>
  <para style="q">ruum re' hin xnub'an taq ti' k'axik aweh</para>
  <para style="q">je' rukab' imb'aan reh i aj ixowaal.</para>
  <para style="q">Xti ti' taq i xnub'an aweh, ruum xiik' naah yib'kiil wach taq ana'ojb'al,</para>
  <para style="q">eh ma' k'isiin taq amahk.</para>
  <para style="q">
    <verse number="15" style="v" />¿Chib'ih reet noq inak'er taq aachii' ruum taq aati'kiil?</para>
  <para style="q">Re' taq aati'kiil ma' xata chik riq'omal iraaj,</para>
  <para style="q">ruum chi xiik' naah yib'kiil wach taq ana'ojb'al,</para>
  <para style="q">eh ruum chi ma' k'isiin taq amahk je' re' i xnub'an taq aweh.</para>
  <para style="q">
    <verse number="16" style="v" />Eh chu'nchel i kisachwik taq awach</para>
  <para style="q">naa wo' rusachariik kiwach i keh.</para>
  <para style="q">Eh chu'nchel i ki-ixowanik taq awach</para>
  <para style="q">naa kik'amariik reje pan tokoom tinamit,</para>
  <para style="q">eh re' taqe i kielq'anik chib'ih taq aweh naa wo' relq'jiik i chib'ih keh.</para>
  <para style="q">Eh re' taqe i kipletohinik taq aweh naa wo' kipletohjiik i keh.</para>
  <para style="q">
    <verse number="17" style="v" />Eh re' hin naa taq kaat wesam chupaam i ti' k'axik,</para>
  <para style="q">naa taq kaat nuk'achrisam ruuk' taq i ti'kiil,</para>
  <para style="q">ruum je' wili inkiq'or taq chawiij:</para>
  <para style="q">Re' taqe i wili re' taqe ruuk' i aj Sión</para>
  <para style="q">ma' awach ta nkapeb'inik keh inki taqe, inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Eh je' wo' chik wili i ruq'or:</para>
  <para style="q">Re' hin naa wesam taqe panti' k'axik i kitinamiit,</para>
  <para style="q">re' taqe i riih rumaam i Jacob, naa nuketelaam wach i kitinamiit.</para>
  <para style="q">Naa wo' chik rukorjiik i kitinamiit aha' wo' yojinaq wii',</para>
  <para style="q">eh re' i paat imb'aan wii' taaq'anik ar wo' chik naa rukorjiik aha' naq wilik pampeet.</para>
  <para style="q">
    <verse number="19" style="v" />Eh chupaam taqe i tinamit re' re' nareliik chee tz'uuy</para>
  <para style="q">reh t'iosinik, reh suq kiil k'uxliis,</para>
  <para style="q">ma' naa ta kojiik k'uhloq naa la' nuk'ihaaxb'isam taqe.</para>
  <para style="q">Ma' awach ta chik naa rixowaniik kiwach,</para>
  <para style="q">ruum re' hin naa nuye'wiik kiloq'il.</para>
  <para style="q">
    <verse number="20" style="v" />Re' taqe i aj Israel naa wo' chik kikahniik chi je' rukab' i pampeet</para>
  <para style="q">naa nuye'em rukowiil kik'ux.</para>
  <para style="q">Eh naa nuye'em taqe chutojariik i kimahk i naa rub'aniik ti' k'axik keh.</para>
  <para style="q">
    <verse number="21" style="v" />Naa wo' chik ruwihiik kajaab'ees naa rutaaq'aniik keh,</para>
  <para style="q">re' ruuk' i xa kitinamiit</para>
  <para style="q">eh naa nusik'im kiwach i hin chi naakichaliik wuuk'.</para>
  <para style="q">Ma' awach taj i neenchalik</para>
  <para style="q">wila' ma' re' hin xin sik'wik wach.</para>
  <para style="q">
    <verse number="22" style="v" />Eh naa taq akahniik chi hat taq nutinamiit i hat,</para>
  <para style="q">eh re' hin naa nukahniik chi hin taq aaDios, inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Re' rujosq'iil i QaJaaw Dios</para>
  <para style="q">je' rukab' i runimaal jab',</para>
  <para style="q">je' rukab' i kaq suut teew</para>
  <para style="q">noq naa ruye'em cho chikinaah i yiib' wach kina'ojb'al.</para>
  <para style="q">
    <verse number="24" style="v" />Re' reh ma' naa ta resam i rujosq'iil chikinaah</para>
  <para style="q">korehtaal i rub'an i ruyejaam cho wach chi keh.</para>
  <para style="q">Re' taq i hat naa ruponiik i q'iij</para>
  <para style="q">noq naa taq areqem chi riij chi korik i nuq'or taq aweh.</para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili xuq'or: Naa ruponiik i q'iij chi re' taqe i k'ih chuq' chi aj Israel, re' hin naa nukahniik chi ki Dios, eh re' keh naa kikahniik chi nutinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw Dios je' wili i xuq'or re' taqe i ma' xikimik ta cho panq'aq'inik.</para>
  <para style="q">Re' hin xnuketelaaj cho kiwach chupaam i ye'aab' chiq yuuq'.</para>
  <para style="q">Eh xnuhi'lisaj wo' taqe Israel re' re'.</para>
  <para style="q">
    <verse number="3" style="v" />Re' hin najtir i nuq'or cho keh chi je' wili i aj Israel:</para>
  <para style="q">Re' hin xatinuk'ax wo' taq chaloq, eh xanaa wo' taq kaat nuk'axam chi juneliik</para>
  <para style="q">ruum aj re' ma' jaruuj taq naa nukanaam ruketeljiik awach.</para>
  <para style="q">
    <verse number="4" style="v" />Je' re' noq re' hin naa wo'</para>
  <para style="q">chik nuyejaam taq aatinamiit Israel</para>
  <para style="q">eh naa wo' chik taq ak'amam chaloq i kotokaq q'ooj intzalajinik</para>
  <para style="q">naa taq asoniniik ruum i rusuqkiil taq ak'ux.</para>
  <para style="q">
    <verse number="5" style="v" />Eh naa wo' chik atikim taq i uuva paruyuq'ul i Samaria.</para>
  <para style="q">Awach i naa kitikim ki uuva</para>
  <para style="q">naa wo' kianam rusuqkiil i wach.</para>
  <para style="q">
    <verse number="6" style="v" />Ruum naa ruponiik i q'iij chi re' taqe i aj cha'jen ye'aab' paruyuq'ul i Efraín,</para>
  <para style="q">naakik'erem kichii' chuq'orariik chi je' wili:</para>
  <para style="q">Taq taq ar Sión i wilik choo wii'</para>
  <para style="q">QaJaaw Dios, inko'q taqe, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Eh re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' taq i hat titz'uyinoq taq ruum rusuqkiil taq ak'ux chikiij i aj Israel</para>
  <para style="q">riih rumaam taqe Jacob, nim kiwach chikiwach i tinamit,</para>
  <para style="q">naa taq rib'irjiik atz'uuy, chi je' wili:</para>
  <para style="q">Re' QaJaaw Dios xko'linik keh i ma' xi kanteesjik taj, tiko'q taq.</para>
  <para style="q">
    <verse number="8" style="v" />Eh naa taqe nuk'amam chaloq i wilkeeb' reje pantz'eet reh i rookb'aal q'iij,</para>
  <para style="q">i wilkeeb' cho chi junsuut i wach ak'al.</para>
  <para style="q">Eh naa ruchaliik chikiij taqe i moywach, taqe i chelej riib' kib'ehik,</para>
  <para style="q">taqe i yowaab' ixoq, taqe i kox-aasjik kiha'lak'uun,</para>
  <para style="q">xiik' naah k'ihaal noq naakimolom cho kiib'.</para>
  <para style="q">
    <verse number="9" style="v" />Re' keh oq'ik inki a'n noq xiooj,</para>
  <para style="q">eh suq chik kik'ux noq naa nusutem taqe chaloq,</para>
  <para style="q">naa nuk'amam taqe reje paraasb'al ha'.</para>
  <para style="q">Eh korik b'eeh taqe naa nuk'amam wii' reh chi</para>
  <para style="q">ma' xta neekiq'ehb'ik wii',</para>
  <para style="q">re' hin naa nukahniik chi manlik kaJaaw i aj Israel</para>
  <para style="q">re' taqe i aj Efraín peet wak'uun taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Hat taq nimaq tinamit chab'iraj i ruq'oral i QaJaaw Dios,</para>
  <para style="q">cha q'or taq rib'iral chupaam taqe i tz'a' laj yuuq' wilkeeb' chi najt,</para>
  <para style="q">je' wili taq i cha q'or: Re' QaJaaw Dios xutukej reje kiwach i rutinamiit Israel.</para>
  <para style="q">Xa re' la' naa wo' chik rumolom cho kiwach,</para>
  <para style="q">naa rucha'jeem taqe je' rukab' i rub'an cha'jen tentzuun, tiko'q taq.</para>
  <para style="q">
    <verse number="11" style="v" />Ruum re' i QaJaaw Dios naa ruko'leem taqe i aj Israel,</para>
  <para style="q">i riih rumaam taqe Jacob pan q'ab' i tinamit</para>
  <para style="q">xti kow riib' chikiwach i keh.</para>
  <para style="q">
    <verse number="12" style="v" />Re' keh xak'erlik chik kichii' chi tz'uuy</para>
  <para style="q">noq naa kik'uliik iloq chinaah i yuuq' Sión.</para>
  <para style="q">Naa kianam rusuqkiil i naa ruye'ariik keh ruum i QaJaaw, re' taqe wili:</para>
  <para style="q">Re' Trigo, re' riis uuva, re' Aseite, re' taqe tentzuun, re' taqe wakax.</para>
  <para style="q">Re' kik'achariik naa rukahniik chi je' rukab' i tik inik'ik rooq ha' chupaam,</para>
  <para style="q">eh ma' naa ta chik rutiib'iik kik'ux.</para>
  <para style="q">
    <verse number="13" style="v" />Re' taqe i qahxoq, i k'ijool,</para>
  <para style="q">taqe mama' winaq naakisoniniik ruum rusuqkiil kik'ux.</para>
  <para style="q">Ruum re' hin re' i ruti'kiil kik'ux naa nusutem chi suq kiil k'uxliis</para>
  <para style="q">naa rusahchiik pankik'ux i ruti'kiil kik'ux.</para>
  <para style="q">
    <verse number="14" style="v" />Eh re' taqe i k'amal b'eeh aj tiij,</para>
  <para style="q">re' chihooj laj mayiij ink'amarik reje</para>
  <para style="q">panupaat re' nakik'uxlaam wii' kiib'.</para>
  <para style="q">Re' taqe nutinamiit naa wo' kianam</para>
  <para style="q">rusuqkiil i k'uxumb'al keh naa nuye'em,</para>
  <para style="b" />
  <para style="q">inki QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Eh je' wo' chik wili i xuq'or:</para>
  <para style="q">Jinaj i q'orik x-ib'iirjik xb'aan chaloq Rama,</para>
  <para style="q">kowlaj oq'ik, jinaj i runimaal ti' kiil k'uxliis.</para>
  <para style="q">Re' po'nchel i Raquel oq'ik i rub'an chi riij taqe rak'uun</para>
  <para style="q">re' reh ma' xata chik q'uunjik wach xraaj</para>
  <para style="q">ruum xukapaaj i reh chi kamnaq chik taqe i rak'uun, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Xa re' la' je' wili xq'orarik reh ruum i QaJaaw Dios:</para>
  <para style="q">Raquel re' hat maa q'eb' chik i riis naq'awach,</para>
  <para style="q">ruum re' hin xat b'iraj chik naa wik'sam i ruti'kiil ak'ux,</para>
  <para style="q">re' taqe awak'uun awixq'uun naa wesam</para>
  <para style="q">taqe chaloq pan q'ab' i tinamit inixowanik kiwach.</para>
  <para style="q">
    <verse number="17" style="v" />Ko naa ruwihiik rusuqkiil ak'ux,</para>
  <para style="q">re' taqe awak'uun awixq'uun naa awilom</para>
  <para style="q">chi naa wo' chik kik'uliik iloq pan kitinamiit, inki i Dios.</para>
  <para style="q">
    <verse number="18" style="v" />Re' hin xb'iraj chik taqe i nutinamiit Efraín</para>
  <para style="q">k'erik kichii' ruum i ti' k'axik, je' wili inkiq'or:</para>
  <para style="q">Re' hoj je' naq qakab' i b'ooyax ma' tijimaj ta chi kamanik,</para>
  <para style="q">ruum i ti' k'axik xqak'ul xaloch' qanaah ruum aj re'</para>
  <para style="q">qoh ak'ul wo' chik awuuk' ruum xa re' wo' hat, QaJaaw i qaDios.</para>
  <para style="q">
    <verse number="19" style="v" />Korik noq re' hoj xat qaq'eb' chi riij qak'ux,</para>
  <para style="q">xa re' la' yu'naak xqayot' chik i qak'ux chi riij ixqa a'n.</para>
  <para style="q">Xan qatuy chik i koq i chi' qak'ux chi qaq'ab' xchalik qak'ixiik,</para>
  <para style="q">xama' nqareq ta chik chi riij inqa a'n</para>
  <para style="q">ruum i qamahk qatoq'aam cho pan qak'uniil, inki taqe.</para>
  <para style="q">
    <verse number="20" style="v" />Re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' i tinamit Efraín kok' wak'uun wixq'uun wo' taqe q'e' taqe nuk'ax.</para>
  <para style="q">Korik noq xnuyeew taqe panti' k'axik, xa re' la' yu'naak xakonuk'ax wo' taqe.</para>
  <para style="q">Ruum chi k'ahchi' kik'erem kichii', re' hin naa wo' chik nuketelaam kiwach,</para>
  <para style="q">ruum xutz'a'j i wánima i ti' k'axik k'ahchi' kik'ulum, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Hat taq aj Israel chakoj taq rehtalil chi korik i b'eeh,</para>
  <para style="q">aha' taq xat-ik'ik reje wii'.</para>
  <para style="q">Reh chi ma' k'axik ta taq noq neenareq noq nee taq ti sutinik chaloq,</para>
  <para style="q">chi je' re' nee taq ti sutinik cho chupaam aatinamiit</para>
  <para style="q">chi je' rukab' jino'q i k'isaxq'un ma' ruch'uwa'risam ta wach i ruk'achariik.</para>
  <para style="q">
    <verse number="22" style="v" />¿Kojaruuj taq inakanaa' rub'aan chi xak'ul taq tiooj,</para>
  <para style="q">xa je' taq akab' i ixq'uunb'ees xak'ul inooj?</para>
  <para style="q">Re' hin jinaj i ak' na'ojb'al nuyejaam wach taq aweh</para>
  <para style="q">chinaah i wach ak'al. Re' chi naa wo' chik taq kiin asik'im</para>
  <para style="q">naa taq kaat nuko'leem je' rukab' noq inko'ljik</para>
  <para style="q">ixchoparik ruum i kowlaj winaq, inki Dios.</para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" />Re' QaJaaw Dios nim rajaawriik ki Dios i aj Israel je' wili xuq'or: Eh noq naa wo' chik wesam taqe chaloq panti' k'axik i aj Judá naa wo' chik nuk'amam taqe chaloq pan kitinamiit. Eh pantaq tinamit Judá je' wili inakiq'orom, re' ta naq i QaJaaw Dios neenkuxisanik reh santo laj yuuq' wili ruum ayu' wilik i rukorkiil wach k'uxliis, inko'q taqe. <verse number="24" style="v" />Eh re' taqe i aj Judá naa wo' chik kik'achariik chupaam i ju'jun ch'uq chi kitinamiit chi je' taqe ab'ixoom, chi je' taqe aj cha'jen tentzun. <verse number="25" style="v" />Eh naa nuye'em kihi'liik taqe i q'uhtinaq, naa nuye'em rusuqkiil kik'ux i ti' kik'ux, inki Dios.</para>
  <para style="p">
    <verse number="26" style="v" />Noq wilom chik taqe re' panuwiriik xwi'raaj wiib', eh xnukoj rehtaal chi xaholohik chik i xuk'uhtaaj riib' weh.</para>
  <para style="s">Re' i jinaj chik ak' na'ojb'al</para>
  <para style="p">
    <verse number="27" style="v" />Re' QaJaaw Dios je' wili xuq'or: Naa ruponiik i q'iij chi naa wo' chik nuk'ihaaxb'isam taqe i tinamit. Je' wo' taqe i chikop ayu' Israel, je' wo' paruyuq'ul i Judá. <verse number="28" style="v" />Nik' wach noq xnusik' chi riij noq xnuyoj wach, noq xnusach, noq wesaj taqe reje, noq xwesaj i kajaawriik, noq xnutib'isaj kik'ux je' wo' chik re' noq naa nuyejaam wach, noq naa wo' chik nuye'em taqe pan kiye'aab', inki. <verse number="29" style="v" />Eh chupaam taqe i q'iij re' re' ma' awach ta chik i naa ruq'orom chi je' wili: Re' ajaab'ees i ruk'ux reh i je' ch'amlaj uuva, je' naa nerujot' riib' i reeh i rak'uun rixq'uun ma' inko'q ta chik taqe. <verse number="30" style="v" />Ruum awach naa ruk'uxwiik reh i je' ch'amlaj uuva, re' re', je' na naa rujoto'm riib' i reeh, eh chi kiju'junaal wo' naa kikimiik ruum i kimahk, inki i Dios.</para>
  <para style="p">
    <verse number="31" style="v" />Eh je' wo' chik wili i xuq'or: Naa ruponiik i q'iij noq jinaj i ak' k'uhb'aal naa nuyejaam wach kuuk' i aj Israel, i aj Judá. <verse number="32" style="v" />Ma' je' ta rukab' i xnuyejaa' cho wach kuuk' i kimaam kati't noq ruuk' i wajaawriik xnuchop cho chi kiq'ab' noq xwesaj taqe chaloq ar Egipto. Eh ruum chi ma' xkian ta runimjiik i k'uhb'aal i xnuyejaa' cho wach kuuk' xnukanaa' taqe chi kutkeel, atoob' ta re' wo' naq i hin kinehchanik keh, hin wo' naq ki Dios, inki. <verse number="33" style="v" />Eh re' taqe i wili naa nuyejaam wach kuuk' i aj Israel re' chi naa nuye'em i nuk'uhb'aal pankikapeb'aal, naa nutz'ihb'aam pankanima, chi je' re', re' chik i hin naa nukahniik chi manlik ki Dios. Eh re' keh naa kikahniik chi manlik nutinamiit taqe. <verse number="34" style="v" />Chupaam taqe i q'iij re' re', ma' kota chik ruman chi naa rutijem i rutinamiit, oon ruka'jaah, oon ma' tokoom ta ruuk', chi je' wili: Chanab'eej wach i QaJaaw, ma' koq ta chik, keh, ruum chu'nchel naakinab'iniik nuwach chi nimaq chi kok' taq. Eh re' hin naa nukuyum i kimahk ruuk' i kiyiib' wach na'ojb'al, ma' naa ta chik ruk'uliik cho panuk'ux i kimahk. Re' wili korik, inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" />Re' QaJaaw Dios xkojwik reh i q'iij chi naa rusihq'iniik pan q'iij,</para>
  <para style="q">re' wo' re' xkojwik reh i poh, ruch'ihil taqe i ch'umiil chi naa kisihq'iniik chaq'ab'.</para>
  <para style="q">Eh i rukaqrisaj i palaw i rutik'aa' teleninik i rub'ohl,</para>
  <para style="q">re' i Dios nim rajaawriik i rub'ihnaal, je' wili i ruq'or:</para>
  <para style="q">
    <verse number="36" style="v" />Pan jinaj poo q'iij wila' ma' xooj eloq wach</para>
  <para style="q">i ruq'or i nuk'uhb'aal wili,</para>
  <para style="q">xa chupaam wo' i q'iij re' re',</para>
  <para style="q">neenkahnik chi ma' re' ta chik nutinamiit taqe i aj Israel.</para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" />Eh wila' xb'aan rupajariik johtoq paam i taxaaj,</para>
  <para style="q">wila' xb'aan rupajariik chu'nchel i ch'ikaab' reh i wach ak'al,</para>
  <para style="q">chi je' re' nee naq i nuq'eb' chi riij nuk'ux chi jumpech taqe i aj Israel</para>
  <para style="q">ruum i kina'ojb'al kianam, je' wo' taqe i kiih kimaam, inki QaJaaw Dios.</para>
  <para style="b" />
  <para style="p">
    <verse number="38" style="v" />Eh je' wo' chi wili i ruq'or: Naa ruponiik i q'iij chi naa wo' chik nuyejaam i nutinamiit, ar naa nutoq'aam reje i wilik wii' inajt naah tz'aq Hananeel, eh naa ruponiik i wilik wii' i puerta wilik pantz'u'k. <verse number="39" style="v" />Ar naa reliik reje naa rojiik chi korik korehtaal imponik chinaah i yuuq' najt naah wilik paruyuq'ul i Gareb, eh naa rusutiniik reje naa ruponiik chupaam i ye'aab' Goa. <verse number="40" style="v" />Eh chu'nchel i k'ixkaab' kimuhqik wii' i kamnaq, inkiq'eb' wii' i chaaj, inaasjik cho wii' i ha' wilik Cedrón, imponik pantz'u'k kiokik wii' kawáyu, je' wo' hoq wilkeeb' reje parelb'aal q'iij naa nukanaam chi wilik kisantohiil. Eh chu'nchel taqe re' ma' naa ta chik ruchopariik kinaah, eh ma' naa ta chik rusachariik kiwach, inki Dios.</para>
  <chapter number="32" style="c" />
  <para style="s">Re' Jeremías xuloq' i ruye'aab' i Hanameel</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios xuq'oreej chee Jeremías noq lajeeb' haab' chikrokiik chi reyil i Sedequías ar Judá, noq waxaqlaj haab' chik rokiik chi reyil i Nabucodonosor ar Babilonia. <verse number="2" style="v" />Eh re' taqe i ru soldado i kireey i aj Babilonia kisutem chik riij i tinamit Jerusaleem. Eh re' i Jeremías jalal ruq'oral i Dios kiye'em chik pan i tz'ilom wilik reje chuwach i rupaat i kireey i aj Judá. <verse number="3" style="v" />Re' i reey Sedequías xtaaq'anik ruchopariik i Jeremías, je' wili i xuq'or reh: ¿Chib'ih reet noq xaq'or chi re' Dios xuq'or chi re' tinamit wili naa nuq'asam pan q'ab' i kireey i aj Babilonia, eh chi naa ruchopom naah? <verse number="4" style="v" />Eh xaq'or chi re' Sedequías wilik chi reyil Judá ma' naa ta ruko'leem riib' pan kiq'ab' i aj Caldeo, naa la' wo' ruchopariik naah i reh ruum i kireey i aj Babilonia korehtaal inooj pa'lojoq chuwach. <verse number="5" style="v" />Re' Nabucodonosor naa ruk'amwiik reje reh i Sedequías ar Babilonia ar naa ruwihiik korehtaal i nuyeew q'ab' chi ar naa rusahchiik wach. Atoob' ta nee taq i na a'n peleto kuuk' taqe i aj Caldeo, xama' naa ta wo' taq aweliik korik, inki.</para>
  <para style="p">
    <verse number="6" style="v" />Eh je' wo' chik wili i xuq'or i Jeremías: Re' QaJaaw Dios, je' wili i xuq'or weh: <verse number="7" style="v" />Chab'iraj re' Hanameel rak'uun awikaan Salum, naa ruk'uliik ruq'orom aweh chi naa aloq'om reh rak'aal wilik Anatot. Re' hat neerub'an chi nee naloq' reh ruum ma' tokoom ta awuuk', inki weh. <verse number="8" style="v" />Nik' wach i xuq'or weh i QaJaaw xk'ulik wo' ruq'or weh i Hanameel rak'uun i wikaan chi naa nuloq'om reh i ruye'aab' noq wilkiin reje chuwach i tz'ilom i wilik chuwach i rupaat i reey. Re' rak'aal re' re', ar wilik paruyuq'ul i Benjamín ruum chi re' i rak'uun i wikaan xk'ulik q'oroq weh, eh ruum chi xuq'or weh i QaJaaw Dios chi ruk'ul chi naa nuloq'om, xnuloq' wo' hoq.</para>
  <para style="p">
    <verse number="9" style="v" />Je' re' noq xnuk'am wo' hoq i rak'aal wilik Anatot i Hanameel, rak'uun i wikaan xnuq'asaj reh i tumiin waxiqiib' libra ruuk' medio rahliil chi plata. <verse number="10" style="v" />Eh xqayejaa' i ruhujil xnukoj i nub'ihnaal chuwach, eh xnukoj rehtalil chi korik, wilik wo' xi ilwik reh noq xnupaj i tumiin pan pexu. <verse number="11" style="v" />Chi riij i re' xnuchop chaloq kab'chel i huuj, re' korjik wii' chi korik i loq' xnub'an, jinaj inutz'ap naah chi korik, eh jinaj i ma' xnutz'ap ta naah. <verse number="12" style="v" />Eh re' ru huujil i aak'al xnuq'asaj reh i Baruc, rak'uun i Neria, riih i Maasías, eh chuwach i Hanameel rak'uun i wikaan, chikiwach wo' taqe i xi ilwik reh xkikoj i kib'ihnaal chi xnub'an i loq'. Eh chikiwach wo' chu'nchel i aj Judío tzunulkeeb' reje chuwach i tz'ilom. <verse number="13" style="v" />Chi kiwach chu'nchel i re', je' wili i xnuq'or reh i Baruc: <verse number="14" style="v" />Re' Dios nim rajaawriik ki Dios i aj Israel je' wili i ruq'or: Chak'am kab'chel i huuj re' re', re' i tz'aplik naah chi korik, eh re' i ma' tz'aplik ta naah chi korik neenamol chupaam jino'q ak'al xaro reh chi ma' nee ta nq'ahik nik' najtiil neemolarik.</para>
  <para style="p">
    <verse number="15" style="v" />Ruum ko wilik i paat ko wilik i ak'al, ko wilik i uuva tikooj naa ruloq'ariik, inki QaJaaw Dios nim rajaawriik. <verse number="16" style="v" />Eh noq xnuq'asaj chik reh i Baruc i ruhujil aak'al xnuloq', xnuq'o'reej i QaJaaw Dios panutiij, je' wili i xnuq'or reh: <verse number="17" style="v" />QaJaaw Dios, hat xat yej-anik reh i taxaaj ruch'ihil i wach ak'al ruuk' animaal awajaawriik. Eh ruum chi wilik awajaawriik ma' xta k'isinoq i k'axik rub'aan chawach. <verse number="18" style="v" />Re' hat q'e' naaketelaaj kiwach i tinamit kinimanik aweh jar ch'iht i ki-ik'ik xa re' la' i nayeew wo' taqe panti' k'axik i tinamit ruum i kimahk kianam i kituut kajaaw, Dios nim awajaawriik aab'ihnaal. <verse number="19" style="v" />Re' hat xti wilik ana'ojb'al, ma' k'isiin taqe i sahchb'al k'uxliis i na a'n xiik' naah loq'il taqe i na a'n. Re' hat eliik inawil i kina'ojb'al inki a'n i tinamit. Eh i nayeew kitojb'aal i ju'jun je' rukab' i ruk'ul chi keh, re' q'oreel chib'ih inki a'n chib'ih inkiq'or. <verse number="20" style="v" />Re' hat ma' k'isiin taqe i xak'uhtaaj, taqe i ma' ilooj taj xa a'n cho chi kixilak i aj Egipto. Eh yu'naak xakok'ahchi' wo' kaat, je' chi kuuk' taqe i aj Israel, je' chi kuuk' chu'nchel i tinamit. Je' re' noq re' ab'ihnaal xelik rib'iral chi xiik' naah nimaal wach. <verse number="21" style="v" />Eh xawesaj taqe chaloq aatinamiit Israel Egipto, ruuk' awajaawriik, ruuk' i rub'anariik taqe ma' ilooj taj, ruuk' taqe i ruk'uhtjiik i nimaq wach na'ojb'al, ma' xchalik kiyo'jiik chu'nchel i tinamit. <verse number="22" style="v" />Eh xayeew wo' keh i ye'aab' wili re' i wilik wii' i lecha, i wilkeeb' wii' chu'nchel i suq atoob'. Re' wo' hoq i ye'aab' xaq'or chee korik keh i kimaam kati't chi naa aye'em keh. <verse number="23" style="v" />Re' keh xkichop naah i ye'aab', eh xkian wo' naq rusuqkiil iwihik ar. Xa re' la' xama' xkinimaj taj aq'oral, eh ma' xkik'am ta naah aak'uhb'aal, xama' xkian ta wo' hoq i xaq'or keh chi naa kianam. Ruum aj re', re' hat naa aye'em cho chikinaah i ti' k'axik. <verse number="24" style="v" />QaJaaw Dios yu'naak xkiyejaa' chik i kiye'aab' taqe i aj Babilonia reh chi naa kikotem riij i tinamit Israel reh chi naa kichopom naah. Re' keh q'aq'inik wi'jaleel, runimaal yab'ilaal inkik'am chaloq. QaJaaw Dios xti korik wo' hoq chi k'ahchi' rojiik eloq wach i aaq'orom cho rib'iral. <verse number="25" style="v" />QaJaaw Dios q'e' wo' chik ti' wila' xailook' chik inq'ahxik pan kiq'ab' i aj Caldeo i tinamit wili. ¿Chib'ih reet noq xaq'or weh chi xnuloq' i ye'aab', eh chi wilik i xi-ilwik reh noq xnutoj? kinki.</para>
  <para style="p">
    <verse number="26" style="v" />Eh re' i QaJaaw Dios je' wili ruchaq'wesjik i Jeremías xub'an: <verse number="27" style="v" />Re' hin i Dios, hin ki Dios chu'nchel i k'achareel wach ak'al, ma' xta k'isinoq i k'axik rub'aan chi nuwach. <verse number="28" style="v" />Je' re' noq i nuq'or aweh chi re' hin naa nuye'em q'ab' chi re' tinamit wili naa ruchopariik naah ruum i Nabucodonosor kireey i aj Babilonia, re' kitinamiit i aj Caldeo. <verse number="29" style="v" />Re' taqe i aj Babilonia re' re' naa kik'uliik iloq, naa kokiik chupaam i tinamit, naakiqopom ruq'aq'al junk'atariik naa kianam ruuk' i paat inkik'at wii' mayiij loq'oomb'al reh i tiyoox Baal ruuk' i re' xinkija' wachej. Eh xkiyeew ink'ohnik laj iq'oom chikiwach i tiyoox. <verse number="30" style="v" />Re' taqe i aj Israel taqe i aj Judá xanoq wo' pampeet xkitoq'aa' cho rub'aan i ma' imponik ta chi nuwach. Re' taqe i aj Israel xkijosaj wach i nujosq'iil ruuk' i rulooq'jiik taqe i tiyoox inki a'n xa re' keh kiyej-anik reh, inki QaJaaw Dios. <verse number="31" style="v" />Re' i tinamit wili xa re' wo' noq xtohq'ik cho ruch'ihkik, eh xk'uloq ayu' yu'naak xa re' wo' hoq uksanik wach nujosq'iil inki a'n Ruum aj re' naa nusacham kiwach. <verse number="32" style="v" />Ruum re' taqe i aj Israel, taqe i aj Judá xa re' i yiib' wach na'ojb'al inki a'n chi nuwach. Eh je' wo' re' i kina'ojb'al i kireey, je' wo' taqe i k'amal kib'eeh, je' wo' taqe k'amal kib'eeh aj tiij, je' wo' hoq i jalal naq taqe nuq'oral, je' re' kina'ojb'al chu'nchel i aj Judá, chu'nchel i aj Jerusaleem. <verse number="33" style="v" />Re' keh xkisutej weh i kiij ma' xinkaaj ta kinimam. Eh re' hin eliik wo' naq i nutijej taqe, re' keh xama' xinkib'iraj ta wo' hoq. Eh ma' xkinimaj taj i kiq'ilariik xnub'an. <verse number="34" style="v" />Eh xkich'uwa'risaj paam i nupaat kinlooq'jik wii', ruum re' chik i tiyoox inkiloq'ej ar. <verse number="35" style="v" />Xkiyejaa' i artaal re' ruuk' i tusuj ab'aj loq'oomb'al reh i Baal ar wach k'ixkaab' Ben-hinom, ar xkik'at i kak'uun kixq'uun chi kimayiij chuwach i tiyoox Moloc. Ruuk' taqe i yiib' wach na'ojb'al re' re' xkiq'eb' pamahk taqe i aj Judá. Eh ma' hin xinq'orik keh chi nakianam re', ni xata naq xik'ik cho panukapeb'aal, inki Dios.</para>
  <para style="p">
    <verse number="36" style="v" />Re' QaJaaw Dios je' wili xuq'or weh: Re' hin i ki Dios i aj Israel, je' wili i nuq'or chikiij i tinamit wili, re' naa nub'anam ruuk' koq'uun, re' inaq'or i hat chi naa ruchopariik naah ruum i kireey i aj Babilonia, ruum q'aq'inik ruum wi'jalel, ruum yab'ilaal. <verse number="37" style="v" />Re' hin naa numolom wach i kitinamiit chupaam taqe i tinamit aha' xnutukej reje kiwach noq yohb'aal wach i nujosq'iil xchalik chikinaah, xama' nukuy ta chik. Eh naa wo' chik nuk'amam taqe chaloq pan kitinamiit, reh chi pansuqkiil k'uxliis naa kik'achariik. <verse number="38" style="v" />Eh naa wo' chik kikahniik chi nutinamiit taqe, eh re' hin naa wo' chik nukahniik chi ki Dios. <verse number="39" style="v" />Eh naa nuye'em pankanima chi xa re' chik naa kianam inwaaj i hin, eh chi naa kinkiyohleem, ruum re' re' chihooj chi kekeh, eh je' wo' chi keh i kiih kimaam. <verse number="40" style="v" />Re' hin wilik i naa nuyejaam wach kuuk' reh juneliik. Re' chi ma' jaruuj chik naa nukanaam kitoob'jiik, naa nuye'em pankanima chi naa kinkiyohleem, reh chi ma' nee ta chik inkikanaa' nunimjiik chi jumpech. <verse number="41" style="v" />Chi je' re' naa rusuqb'iik nuk'ux kuuk', naa nutob'eem taqe, xti korik chi naa wo' chik nuye'em taqe pan kitinamiit wili. Je' re' i naa nub'anam kuuk' chu'nchel nuk'ux, chu'nchel i wánima, inki Dios.</para>
  <para style="p">
    <verse number="42" style="v" />Eh je' wo' chik wili i xuq'or: Nik' wach noq naa nuye'em q'ab' chi naakik'ulum i runimaal ti' k'axik je' wo' chik re' noq naa nuye'em keh chu'nchel i wotob'il nuq'orom cho rib'iral keh. <verse number="43" style="v" />Eh naa wo' chik kehchaam i tinamit, re' xaq'or i hat chi naa rukahniik chi xan tz'irik chik paam, chi ma' xta chik tinamit, chi ma' xta chik chikop naa ruwihiik chupaam. Eh chi naa ruchopariik naah kuum i aj Babilonia. <verse number="44" style="v" />Naa wo' chik kiloq'om kak'aal, naakiyejaam ruhujil naa kikojom i kib'ihnaal i naa kilwiik reh chi xloq' naa kikojom rehtalil. Re' loq' wili ar naa rub'aan chupaam i ruyuq'ul i Benjamín, chi junsuut i Jerusaleem, eh chupaam taqe tinamit wilkeeb' Judá. Eh chupaam taqe tinamit wilkeeb' paraxchee', chupaam taqe i tinamit wilkeeb' Sefela, chupaam i tinamit Neguev, ruum naa wo' chik wesam taqe cho panti' k'axik, inki i QaJaaw Dios.</para>
  <chapter number="33" style="c" />
  <para style="s">Re' Dios xuq'or rib'iral chi naa wo' chik rusutiniik chee rutinamiit</para>
  <para style="p">
    <verse number="1" style="v" />Re' i Jeremías noq tz'aplik chuwach reje tz'ilom je' wili i xq'orarik reh ruum i Dios: <verse number="2" style="v" />Re' hin i Dios, hin xinyej-anik reh i taxaaj, i wach ak'al, eh xnuyeew taqe pan kiye'aab' je' wili i xnuq'or: <verse number="3" style="v" />Kow kinaq'oreej awuuk' re' hin nee tib'iraj, neenuk'uhtaaj aweh aha' wilik i ma' weht'al taj i hat, re' i ma' eht'alimaj taj. <verse number="4" style="v" />Ruum re' hin i Dios, ki Dios i aj Israel, je' wili i nuq'or chikiij i tinamit wili, chi riij i rupaat i reey, re' chi naa rusachariik kiwach naa rukahniik chi ke'emb'al kiib' taqe i naa kitoq'aam kik'ulb'ejiik chi q'aq'inik taqe i aj Babilonia. <verse number="5" style="v" />Eh naa runujiik chi kamnaq paam i tinamit, re' hin naa nuye'em q'ab' ruum i nujosq'iil chi naakik'ulum i ti' k'axik. Re' hin ma' naa ta nuketelaam kiwach naa nuq'eb'em taqe chi riij nuk'ux, ruum i yiib' wach na'ojb'al inki a'n <verse number="6" style="v" />Atoob' ta je' re' inki a'n re' hin naa wiq'omaam taqe, naa wesam i kiti'kiil, naa nuye'em keh i suq laj wihik, eh ma' xta chik inakik'ulum. <verse number="7" style="v" />Je' re' noq naa wo' chik taqe wesam chaloq panti' k'axik i aj Judá, taqe i aj Israel, naa wo' chik nuch'ikaam taqe pan kiye'aab' je' rukab' i pampeet. <verse number="8" style="v" />Naa wesam pankamanik chu'nchel i kiyiib' wach na'ojb'al, re' taqe i mahk xkian noq xkiq'eb' kiib' chi nuwach. Eh re' hin naa nukuyum chu'nchel i kimahk, eh ruum i re' xin kiq'eb' chi riij kik'ux. <verse number="9" style="v" />Re' i tinamit Jerusaleem naa rukahniik chi ye'el rusuqkiil nuk'ux, chi ye'el nuloq'il chi ye'el runimaal nuwach, chikiwach chu'nchel i tinamit sut i wach ak'al, Noq naa kib'iram rib'iral i tokoom tinamit chu'nchel i kitoob'jiik naa nub'anam chi suq chik naa kiwihiik ma' k'isiin ta naa kiyo'jiik, inki Dios.</para>
  <para style="p">
    <verse number="10" style="v" />Eh je' wo' chik wili i xuq'or: Re' taq i hat inaq'or taq chi re' tinamit wili xan tz'irik chik paam, ma' xta chik tinamit, ma' xta chik chikop, chi ma' xta chik wilik chupaam taqe i xilak taq b'eeh Judá, je' wo' xilak taq b'eeh Jerusaleem. Korik chi ma' xta chik tinamit, chi ma' xta chik chikop chupaam. <verse number="11" style="v" />Xa re' la' naa wo' chik rib'irjiik i tz'uuy, i ninq'iij reh i kaxáro, je' wili i naa ruq'orariik: Chat'iosej taq i rotob'il i QaJaaw Dios nim i rajaawriik ruum re' reh q'e' aj k'axool, eh juneliik wilik i ketelinik wachiis ruuk' inko'q taqe. Eh naa wo' rib'irjiik i kiq'oral i naa kik'amam chaloq i kimayiij panupaat reh i t'iosinik. Eh korik wo' hoq chi naa wo' chik wesam taqe cho pan ti k'axik i tinamit wili, reh chi naa wo' chik kikahnik chi je' rukab' i pampeet, inki Dios.</para>
  <para style="p">
    <verse number="12" style="v" />Re' QaJaaw Dios nim rajaawriik je' wili i xuq'or: Re' tinamit wili i ma' xta chik tinamit ma' xta chik chikop chupaam. Naa wo' chik ruwihiik ch'ahn chupaam reh chi re' taqe i aj cha'jen tentzun naa wo' chik kiye'em ruwa' i kitentzuun ar. <verse number="13" style="v" />Chi je' chupaam i tinamit wilkeeb' paraxchee', chupaam tinamit wilkeeb' Sefela, chupaam i tinamit wilkeeb' paruyuq'ul i Neguev, chupaam i ruyuq'ul Benjamín, chupaam i tinamit chi junsuut i Jerusaleem. Chupaam i tinamit wilkeeb' paruyuq'ul i Judá, naa wo' chik rilariik kiwach i aj cha'jen tentzun chi k'ahchi' kajlaam i kitentzuun.</para>
  <para style="p">
    <verse number="14" style="v" />Xti korik chi naa wo' chik ruponiik i q'iij chi nuwach noq naa nuye'em i wotob'il chikinaah i aj Israel, je' wo' chikinaah i aj Judá, je' wo' rukab' i nuq'orom rib'iral keh. <verse number="15" style="v" />Noq naa ruponiik i q'iij, re' hin naawisam jinaj manlik xikin riih i David, re' i wihinaq cho chi reyil. Eh re' reh naa ruch'ikaniik reh i rukorkiil wach k'uxliis chupaam i tinamit, je' wo' hoq i rub'ehel chi b'anarik. <verse number="16" style="v" />Eh chupaam taqe i q'iij re' re' naa nuko'leem taqe i aj Judá, taqe i aj Jerusaleem. Eh ma' xta chik ti' naakilom wach, je' wili i nub'ihnaal naa kiq'orom. Ruum i QaJaaw Dios naaqeliik korik, inko'q taqe.</para>
  <para style="p">
    <verse number="17" style="v" />Re' hin kinq'orik reh chi eliik naa ruwihiik xikin riih rumaam i David, re' i naa rokiik chi reyil chinaah i tinamit Israel. <verse number="18" style="v" />Eh ma' k'isiin taqe i k'amal b'eeh aj tiij naa ruwihiik chi kixilak, re' ruuk' taqe i riih rumaam i Leví, reh chi chu'nchel i q'iij naa kik'atam i mayiij chi nuwach. Naa kik'atam i kimayiij re' ruuk' i chi naq'wach, je' wo' hoq i tokoom mayiij inki.</para>
  <para style="p">
    <verse number="19" style="v" />Eh re' QaJaaw Dios, je' wili i xuq'or reh i Jeremías: <verse number="20" style="v" />Wila' wilik neerub'an ruyojariik wach nik' wach noq wilik q'iij, je' wo' hoq nik' wach noq wilik i chaq'ab', eh ma' re' ta chik paruorahiil nee ruyeew riib' i pan q'iij je' wo' chaq'ab'. <verse number="21" style="v" />Nee wo' naq rub'an chi nee nuyoj wach hin i nuyejaam wach ruuk' i David, ma' nee ta naq inwihik xikin riih naa rokiik chi reyil, je' rukab' noq xwihik cho chi reyil i reh. Eh ma' nee ta naq inooj eloq wach i nuyejaam wach kuuk' taqe i k'amal kib'eeh aj tiij, taqe i riih rumaam i Leví. <verse number="22" style="v" />Re' taqe i riih rumaam i waj kamanoom David, riih rumaam taqe Leví k'amal kib'eeh aj tiij naa nuk'ihaaxb'isam taqe. Korehtaal kiponik chi je' kik'ihaal i ch'umiil, chi je' kik'ihaal i saniib' tub'ulkeeb' chi chii' i palaw, ma' awach ta naa rukuywiik kajaljiik, inki Dios.</para>
  <para style="p">
    <verse number="23" style="v" />Eh re' i QaJaaw Dios, je' wo' chik wili xuq'or reh i Jeremías: <verse number="24" style="v" />¿Mi ma' nakoj rehtaal re' hat chi re' i tinamit inkiq'or chi xnuq'eb' taqe chi riij nuk'ux ka'ch'uq chi tinamit nusik'im cho kiwach, re' i Israel re' i Judá? Ruum aj re', re' keh ma' kiyeew ta chik rajaawriik i nutinamiit, ma' nkikoj ta chik chi nimlaj tinamit. <verse number="25" style="v" />Re' hin i Dios je' wili i nuq'or: Nik' wach noq ma' nee ta nuyoj wach i saqum pan q'iij, i q'equm chaq'ab' nuyejaam cho wach reh chi naa ruwihiik kajaawriik pan taxaaj, je' wo' wach ak'al. <verse number="26" style="v" />Je' wo' re' noq ma' nee ta nuq'eb' chi riij nuk'ux taqe i riih rumaam i Jacob, i riih rumaam David re' i waj kamanoom. Eh ma' naa ta wo' nukanaam kipa'ab'jiik i naa rub'aniik i taaq'anik chikinaah i riih rumaam Abraham, i riih rumaam Isaac, i riih rumaam Jacob. Ruum re' hin naa wo' chik nuketelaam kiwach, naa wesam taqe chaloq panti' k'axik, inki.</para>
  <chapter number="34" style="c" />
  <para style="s">Re' noq xq'orob'jik i reey Sedequías</para>
  <para style="p">
    <verse number="1" style="v" />Noq re' i Nabucodonosor kireey i aj Babilonia ruch'ihil chu'nchel i ru soldado kichalik chupaam taqe i tinamit ruchopom naah k'ulik chik inki a'n iloq chi q'aq'inik chinaah i Jerusaleem, chikinaah i tinamit wilkeeb' chi junsuut. Re' i QaJaaw Dios je' wili xuq'or reh i Jeremías: <verse number="2" style="v" />Re' hin i Dios, aaDios taq i hat i aj Israel i nuq'or aweh i hat chi hiy cha q'or reh i Sedequías kireey i aj Judá chi je' wili: Chi re' hin naa nuye'em q'ab' chi re' i rutinamiit naa ruchopariik naah ruum i kireey i aj Babilonia, eh naa kikojom ruq'aq'al. <verse number="3" style="v" />Eh re' reh ma' naa ta ruko'leem riib' pan q'ab', naa ruchopariik, naa ruq'ahtesjiik pan q'ab' i reey re' re' naa rilom wach ruuk' naq'wach. Eh xti naa rub'anam k'ulwach ruuk' noq naa rub'anam ruk'utaaj ruuk' ar Babilonia. <verse number="4" style="v" />Eh ma' xata re', i re' Sedequías kireey i aj Judá, chab'iraj i ruq'or chawiij i QaJaaw Dios: Re' reh ma' naa ta rukimiik ruuk' q'aslaj ch'ihch'. <verse number="5" style="v" />Pan suq kiil k'uxliis la' naa rukimiik parupaat, eh naa kik'atam ink'ohnik laj iq'oom je' rukab' i xk'atarik cho chikinaah i rumaam rati't, re' i xi wihik cho chi reyil chi peet chuwach i reh. Re' reh naakoq'em naa rutiib'iik kik'ux chi riij, je' wili inakiq'orom: Q'e' wo' chik ti' i xqak'ul xkimik i qareey, inko'q taqe, inki i Dios.</para>
  <para style="p">
    <verse number="6" style="v" />Eh re' Jeremías i jalal ruq'oral i Dios xponik ruq'or reh i Sedequías kireey i aj Judá ar Jerusaleem i xq'orarik reh ruum i Dios. <verse number="7" style="v" />Chupaam taqe q'iij re' re' k'ahchi' chik cho keeb' chi q'aq'inik i ru soldado i kireey i aj Babilonia, chinaah i tinamit Jerusaleem. Ach wo' re' i tinamit Laquis ruch'ihil i tinamit Azeca wilik ko'lemb'al kiib' chi korik wilkeeb' paruyuq'ul i Judá majaa' tanchalik i q'aq'inik chikinaah.</para>
  <para style="s">Xa ma' xioq'tejik ta wo' reje taqe i minooj pankowlaj kamanik</para>
  <para style="p">
    <verse number="8" style="v" />Re' QaJaaw Dios xuq'oreej wo' chik i Jeremías noq re' reey Sedequías ruyejaam naq chik wach kuuk' chu'nchel i aj Jerusaleem chi naa koq'taam reje i kimoso kiminim pankowlaj kamanik. <verse number="9" style="v" />Xuq'or keh chi, chi kunchelaal naa koq'taam reje i kimoso winaq i kimoso ixoq re' ruuk' taqe i aj hebreos, reh chi ma' jino'q keh i re' ruuk' i kitinamiit naa rukahniik chi kimoso. <verse number="10" style="v" />Re' taqe i k'amal b'eeh taqe i tinamit xuk'ul kik'ux chi kunchelaal i xuq'or i reey, xkoq'taaj wo' naq reje taqe i kimoso ma' xkimin ta chik pankowlaj kamanik. <verse number="11" style="v" />Xa re' la' ti' wo' chik xkik'raaj chi xkoq'taaj reje i kimoso xkichop wo' chik naah xkimin wo' chik pankowlaj kamanik. <verse number="12" style="v" />Ruum aj re', re' i QaJaaw Dios je' wili i xuq'or reh i Jeremías: <verse number="13" style="v" />Re' hin i Dios, aaDios taq i hat, hat taq i aj Israel wilik wo' naq i xnuyejaa' cho wach kuuk' taq aamaam awati't, noq xwesaj taqe chaloq Egipto, re' naq taqe i minooj pankowlaj kamanik, je' wili i xuq'or keh: <verse number="14" style="v" />Re' taq i hat xa waqiib' haab' naa rukamaniik taq awuuk' amoso aloq'om, eh paruwuuq haab' naa taq awoq'taam reje, kinki keh. Xa re' la' re' taq aamaam awati't xama' xkinimaj ta wo' hoq, eh xama' xinkaaj ta wo' kib'iram. <verse number="15" style="v" />Re' taq i hat yu'naak xajal wo' chik taq wach aana'ojb'al, eh xatoq'aa' naq taq chik rub'aan imponik chi nuwach i hin, ruum xawoq'taaj naq taq chik reje amoso xa aloq'om, re' ruuk' taq aatinamiit aj hebreo. Eh xatoq'aa' wo' naq taq rub'aan i xqayejaa' taq cho wach awuuk' chupaam i nupaat kinlooq'jik wii'. <verse number="16" style="v" />Chi riij i re' xajal wo' chik taq wach ana'ojb'al, xa yeq' taq panak'al i xnuq'or taq aweh xachop wo' chik taq naah amoso chi winaq, chi ixoq xa nim wo' chik taq pankowlaj kamanik. <verse number="17" style="v" />Ruum aj re' re' hin i Dios kinq'orik chi xama' xinanimaj ta wo' taq ruum xama' xawoq'taaj ta wo' taq reje amoso chi jumpech chi winaq chi ixoq re' ruuk' taq aatinamiit. Ruum aj re', re' hin naa nuye'em taq cha naah i q'aq'inik, i wi'jaleel, i runimaal yab'ilaal. Eh ruum i re' yohb'aal wach noq naa kiyo'jiik i tinamit sut i wach ak'al. <verse number="18" style="v" />Re' hin naa nuye'em taqe pan q'ab' i ti' k'axik re' re' chu'nchel i xiyeq'wik panak'al i xnuq'or naq keh chi naa kianam, eh ma' xkian taj i xqayejaa' wach kuuk'. Re' noq xkik'at i rak'uun wakax chi nuwach chi kimayiij, kiib' xkesaj, ki-ik'ik panyejaal i rutooq. <verse number="19" style="v" />Re' taqe i naa nuye'em panti' k'axik re' taqe i wili: Re' taqe i k'amal kib'eeh i aj Judá, i k'amal kib'eeh i aj Jerusaleem, i nimaq wach kikamaj, i k'amal kib'eeh i aj tiij. Eh chu'nchel i tinamit ki-ik'ik panyejaal i rutooq i mayiij. <verse number="20" style="v" />Eh re' hin naa nuq'asam taqe pan kiq'ab' i nixowanik kiwach re' taqe i k'ahchi' rusi'wiik keh reh i kikanteesjiik. Eh re' i kiti'jolal naa rukahniik chi kiwa' taqe i chikop kirupinik pan taxaaj, eh chi kiwa' taqe i josq'laj chikop wilkeeb' pantaq ch'ahn. <verse number="21" style="v" />Eh re' i Sedequías kireey i aj Judá, ruch'ihil i nimaq wach kikamaj wilkeeb' ruuk', naa nuq'asam taqe pan kiq'ab' i nixowanik kiwach, re' i k'ahchi' rusik'wiik keh reh i kikanteesjiik. Eh naa nuq'asam taqe pan kiq'ab' taqe i ru soldado i kireey i aj Babilonia, re' taqe i koxkikanaa' pechik i q'aq'inik taq awuuk'. <verse number="22" style="v" />Re' hin naa wo' chik nuye'em q'ab' keh chi naakichaliik chi q'aq'inik chinaah taq aatinamiit wili chi naa kichopom naah, chi naa kikojom ruq'aq'al. Re' i tinamit wilkeeb' paruyuq'ul i Judá naa nukanaam chi xan tz'irik chik kipaam, eh chi ma' jino'q chik i k'achareel chupaam, inki i QaJaaw Dios.</para>
  <chapter number="35" style="c" />
  <para style="s">Re' i xub'an i Jeremías kuuk' i aj Recabitas</para>
  <para style="p">
    <verse number="1" style="v" />Re' i Jeremías je' wili xuq'or: Noq wilik chi reyil ar Judá i Joacim rak'uun i Josías, re' QaJaaw Dios je' wili xuq'or weh: <verse number="2" style="v" />Hiy aha' patim taqe wii' i aj rekabitas cha a'n ak'utaaj kuuk' chak'am taqe johtoq paruka'ch'iht i paat wilik chucheel i rupaat i Dios ar nee nayeew keh chi uuk'jik i k'ahlaj vino, inki.</para>
  <para style="p">
    <verse number="3" style="v" />Eh re' hin xinooj wo' hoq chusik'ariik i Jaazanias rak'uun i wuch Jeremías jinaj riih Habasinías, haa' taqe i ruchaaq', taqe i rak'uun, chu'nchel i aj rekabitas. <verse number="4" style="v" />Eh xnuk'am taqe johtoq paruka'ch'iht jinaj i paat wilik chucheel i rupaat i QaJaaw Dios, re' i patim wii' taqe i rak'uun Igdalias. Re' paat wilik chucheel i kipaat, i kinimanik reh i Dios chi korik, eh chucheel i kipaat i kik'amwik b'eeh parupaat i Dios ar chinaah i paat wilik wii' Maasías rak'uun i Salum aj cha'joom chi chii' i puerta. <verse number="5" style="v" />Eh re' hin xnuyeew chikiwach chu'nchel i aj Recabitas taqe i kulk nujinaq taqe i chi k'ahlaj vino, eh je' wili i xnuq'or keh: Chawuk'ej taq i vino wili, kinki keh. <verse number="6" style="v" />Eh re' keh je' wili i xkiq'or: Re' hoj ma' jaruuj neenquk'ej qeh i k'ahlaj vino ruum re' Jonadab rak'uun i Recab re' i xikin qamaam ruq'orom cho qeh chi ma' jaruuj naa quk'em qeh i k'ahlaj vino i hoj, je' wo' taqe i qiih qamaam. <verse number="7" style="v" />Eh i xuq'or qeh chi ma' naa ta qayejaam qapaat, chi ma' xta na qatikim qeh, eh ni xata naa qatikim qa uuva. Eh ruq'orom cho qeh chi xa pankok' perpat itz'ihy kinaah, naa qak'achariik, chi je' re' najt taq nee ti k'acharik ayu' wach ak'al aha' i xa hat taq ik'al b'eeh, inki qeh. <verse number="8" style="v" />Chu'nchel i ruq'orom cho qeh i xikin qamaam Jonadab k'ahchi' qanimam ruum aj re' ma' jaruuj neenquk'ej qeh i k'ahlaj vino, ni xata re' i qehk'een, ni xata re' taqe i qak'uun, qixq'uun nee kiuk'inik reh. <verse number="9" style="v" />Ruum aj re', re' hoj ma' qayejaa' ta qapaat, eh ma' qatik ta qa uuva, eh ma' xta wo' hoq inqatik qeh panye'aab'. <verse number="10" style="v" />Xa pan itz'ihy naah paat la' k'acharik inqa'an, k'ahchi' qanimam chu'nchel i ruq'orom cho qeh i xikin qamaam Jonadab. <verse number="11" style="v" />Xa re' la' re' Nabucodonosor kireey i aj Babilonia xuchop naah i qatinamiit. Ruum i re' xchalik qakeb'aa' qiib' ayu' hoj, hoj aj Jerusaleem chikiwach taqe i ki soldado i aj Babilonia, je' wo' chikiwach i ki soldado i aj Siria. Ruum taqe i re' ayu' k'acharik inqa a'n Jerusaleem yu'naak, inki taqe.</para>
  <para style="p">
    <verse number="12" style="v" />Eh re' i QaJaaw Dios je' wili i xuq'or reh i Jeremías: <verse number="13" style="v" />Re' hin i Dios nim wajaawriik, ki Dios i aj Israel, i nuq'or aweh chi hiy kuuk' i aj Judá, kuuk' i aj Jerusaleem, cha q'or keh chi je' wili: ¿Mi ma' xkitijej keh re' i nunimjiik i xkian i tinamit re' re'? Ruum ma' xkinimaj taj i xnuq'or keh. <verse number="14" style="v" />Re' i xikin riih rumaam Jonadab rak'uun i Recab xkinimaj i xuq'or kahnoq chi ma' jaruuj naa kuk'em keh i k'ahlaj vino. Eh xama' xkuk'ej ta wo' keh chi jumpech, ruum xkinimaj i xuq'or kahnoq i xikin kimaam. Eh re' taq hat xata wo' jarpech nuq'orom taq aweh chi naa kin taq animam, xa re' la' xama' kinanimaj ta wo' taq, xama' na a'n ta wo' taq i nuq'or aweh. <verse number="15" style="v" />Re' hin kok' xilak xnutaq'aaj taqe chaloq i jalal nuq'oral taq chaxilak, reh chi xq'orarik taq aweh chi chakanaa' taq rub'aan i yiib' wach na'ojb'al. Eh chi ma' naa ta chik taq animam, aloq'em i tiyoox. Chi je' re' nanaq taq a'nam rusuqkiil i aak'achariik chupaam i ye'aab' nuq'orom cho rib'iral chi naa nuye'em taq aweh, re' wo' nuye'em cho keh taq aamaam awati't. Xa re' la' re' taq i hat xama' xanimaj ta wo' taq xama' xa a'n ta wo' taq i xnuq'or taq aweh. <verse number="16" style="v" />Eh re' taqe i xikin riih rumaam i Jonadab keh rak'uun i Recab k'ahchi' kinimam i xuq'or kahnoq i xikin kimaam. Raaj taq i hat aj Israel xama' kinanimaj ta wo' taq xama' nanimaj ta wo' taq i nuq'or aweh. <verse number="17" style="v" />Ruum aj re', re' hin i Dios nim wajaawriik, aaDios taq i hat aj Israel, naa nuye'em i runimaal ti' k'axik chikinaah i aj Judá, i aj Jerusaleem. Re' wo' nuq'orom rib'iral chi naa nuye'em chikinaah. Ruum re' hin xnuq'or naq keh chi naa kin kinimam, eh xama' xinkinimaj ta wo' hoq, xama' xkian ta wo' hoq i xnuq'or keh, inki weh Dios.</para>
  <para style="p">
    <verse number="18" style="v" />Eh re' Jeremías je' wili i xuq'or keh i aj Recabitas: Re' QaJaaw Dios nim rajaawriik ki Dios i aj Israel je' wili xuq'or: Ruum chi xanimaj taq i rukanaam kahnoq ruq'orariik i xikin taq aamaam Jonadab xanimaj taq chu'nchel i ruk'uhb'aal xukanaa' kahnoq, xa a'n taq i xuq'or. <verse number="19" style="v" />Ruum aj re', re' hin i Dios nim wajaawriik, ki Dios i aj Israel je' wili xnuq'or: Juneliik naa ruwihiik jino'q panukamaj chi nuwach i re' ruuk' i xikin riih i Jonadab, rak'uun i Recab, inki.</para>
  <chapter number="36" style="c" />
  <para style="s">Re' i Baruc xrilow wach i tz'ihb'amaj chupaam i junb'oht chi huuj</para>
  <para style="p">
    <verse number="1" style="v" />Eh noq parukaaj haab' chik rokiik chi reyil ar Judá i Joacim rak'uun i Josías, re' QaJaaw Dios. Je' wili i xuq'or reh i Jeremías: <verse number="2" style="v" />Yu'naak i hat cha chop jumb'oht-oq i huuj cha tz'ihb'aaj ar chu'nchel i xnuq'or weh pampeet re' noq xwihik cho chi reyil Judá i Josías, eh je' wo' taqe i k'ahchi' nuq'orom aweh yu'naak. Re' taqe i naakik'ulum i aj Israel, i aj Judá, i naakik'ulum chu'nchel i tinamit. <verse number="3" style="v" />Eh noq neenkib'iraj rib'iral i runimaal ti' k'axik k'achi' nukapaam chi naa nuye'em chikinaah re' taqe i aj Judá nee oon naq inche kikanaa' i kiyiib' wach na'ojb'al. Re' hin nee naq i nukuy i kimahk, i kiyiib' wach na'ojb'al, inki Dios.</para>
  <para style="p">
    <verse number="4" style="v" />Eh re' Jeremías xuyuq'eej ruuk' i Baruc re' i aj tz'ihb' rak'uun i Narias. Nik' nimaal i q'orooj reh i Jeremías ruum i Dios xuq'or reh i Baruc, eh xutz'ihb'aaj chu'nchel chupaam jumb'oht chi huuj. <verse number="5" style="v" />Chi riij i re', re' Jeremías je' wili i xuq'or reh i Baruc:</para>
  <para style="p">Re' hin ma' ye'ooj ta chik q'ab' weh chi naawokiik chupaam i rupaat i Dios. <verse number="6" style="v" />Ruum aj re' okeen i koq i hat, reh chi nee nawil wach ar i xatz'ihb'aaj chupaam i jumb'oht chi huuj, re' i ruq'oral i Dios xnuq'or aweh. Re' noq imb'aan i loq'inik chi ma' b'anooj ta wi'k ha', eh nee nawil wach reh chi neenkib'iraj i tinamit, reh chi neenkib'iraj i kichalik Judá, reh chi neenkib'iraj i ruk'uhb'aal i Dios. <verse number="7" style="v" />Chi je' re' nee oon naq inche inkipahqaaj kikuyb'al reh i Dios, nee oon naq inche kikanaa' i kiyiib' wach na'ojb'al, ruum re' Dios yohb'aal wach i rujosq'iil naa ruye'em chaloq. Re' i ruq'orom cho rib'iral chi naa ruye'em cho chikinaah i tinamit wili, inki Jeremías. <verse number="8" style="v" />Eh re' Baruc xub'an chu'nchel i xq'orarik reh ruum i Jeremías jalal ruq'oral i Dios, xrilow wo' wach parupaat i Dios chi kixikin i tinamit nik' nimaal i ruq'oral i Dios xutz'ihb'aaj chupaam i jumb'oht chi huuj.</para>
  <para style="p">
    <verse number="9" style="v" />Eh parub'eleej pooh reh i roo' haab' rokiik chi reyil Judá i Joacim rak'uun i Josías xq'orarik chi naa rub'aan rulooq'jiik i Dios chi ma' b'anooj ta wi'k ha', chi je' taqe i aj Jerusaleem, chi je' kichalik taqe paruyuq'ul i Judá. <verse number="10" style="v" />Re' i Baruc xrilow wach i ruq'oral i Dios chi kixikin i tinamit, re' xuq'or i Jeremís, re' i xutz'ihb'aaj i Baruc. Ar xrilow cho wach paruka'ch'iht i paat wilik wii' i aj tz'ihb' Gemarías rub'ihnaal, ma' najt ta ruuk' i ak' laj puerta wilik panookb'al reh i rupaat i Dios.</para>
  <para style="p">
    <verse number="11" style="v" />Eh re' Micaias rak'uun i Gemarías riih i Safán xkuxik rib'iram chu'nchel i ruq'oral i Dios xrilow wach i Baruc chupaam i jumb'oht chi huuj. <verse number="12" style="v" />Eh xooj chupaam i rupaat i reey paruka'ch'iht i paat wilik wii' i aj tz'ihb', re' i kimolom wii' kiib' i kikamanik ruuk' i ajaab'ees, re' taqe wili: Re' i Eliasama aj tz'ihb', re' Delaía rak'uun i Semaías, re' i Elnatán rak'uun i Acbor, re' Gemarías rak'uun i Safán, re' Sedequías rak'uun i Hananías, wilik chik taqe i kikamanik ruuk' i ajaab'ees wilkeeb' ar. <verse number="13" style="v" />Eh re' Micaias kuxik ruk'uhtjaam keh nik' nimaal i xrib'iraj noq xrilow wach i Baruc chi xikin i tinamit i tz'ihb'amaj chupaam i jumb'oht chi huuj. <verse number="14" style="v" />Noq xkib'iraj chi je' re', xkitaq'aaj i Jehudi i rak'uun i Netanías, riih i Selemías, riih i Cusi chuk'amariik i Baruc reh chi naa ruk'amam chaloq jumb'oht chi huuj xrilow wach chi kixikin i tinamit. Eh re' i Baruc xuchop chaloq i jumb'oht chi huuj xchalik chikiwach i raj kamanoom ajaab'ees kimolom kiib'. <verse number="15" style="v" />Eh re' keh je' wili i xkiq'or reh i Baruc: Titzuun quuk' chawilow wach qeh i jumb'oht chi huuj inki taqe. Re' i Baruc xrilow wo' wach i jumb'oht chi huuj. <verse number="16" style="v" />Noq xkib'iraj taqe i ruq'or chupaam i jumb'oht chi huuj ma' k'isiin ta xchalik kiyo'jiik k'ul xkitz'ehtaaj kiib' je' wili i xkiq'or chikiwach: Chu'nchel i xqib'iraj wili naa qaq'orom reh i reey, inki taqe. <verse number="17" style="v" />Eh xkipahqaaj reh i Baruc chi je' wili:</para>
  <para style="p">Chaq'or qeh nik' wach noq xatz'ihb'aaj taqe chu'nchel i q'orik re' re', inki taqe.</para>
  <para style="p">
    <verse number="18" style="v" />Re' i Baruc je' wili kichaq'weesjiik xub'an:</para>
  <para style="p">Chu'nchel i q'orik wili, re' Jeremías xq'orik weh, eh re' hin xnutz'ihb'aaj.</para>
  <para style="p">
    <verse number="19" style="v" />Eh re' taqe i raj kamanoom i ajaab'ees, je' wili i xkiq'or reh i Baruc:</para>
  <para style="p">Hiy chakeb'aa' awiib' awuch'ihil i Jeremías, mo'-oq jino'q neenab'inik reh aha' taq neenooj akeb'aa' awiib', inki taqe, reh.</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' taqe i nimaq wach kikamaj ruuk' ajaab'ees xkikanaa' i junb'oht chi huuj chupaam i paat wilik wii' i Elisama re' i aj tz'ihb'. Eh xiooj parupaat i reey, xponik kiq'or reh nik' nimaal i ruq'or chupaam i huuj. <verse number="21" style="v" />Chalik i reey xutaq'aaj reje i Jehudi parupaat i Elisama re' aj tz'ihb' chuk'amariik i jumb'oht chi huuj. Noq re' i Jehudi ruk'amam chik chee i huuj re' re' xrilow wach chi xikin i reey, chi kixikin i nimaq wach kikamaj ruuk' ajaab'ees kimolom kiib' ar. <verse number="22" style="v" />Eh chupaam i rub'eleej poh ree haab' re' re', re' i reey ar wilik paruka'ch'iht i paat i rub'an wii' i taaq'anik, re' i rik'saj wii' i jab' q'iij q'axnik i rub'an i koq chi chii' i q'aaq' luk'uuj ar. <verse number="23" style="v" />Noq re' i Jehudi i rilow wach oxch'iht oon kajch'iht chi q'orik wilik chupaam i huuj, re' reey i ruq'or reh i Jehudi chi ma' rilow pee chik wach, eh chi chuyok' iloq i huuj ruuk' kuchilo, tiklik ruk'atam wach q'aaq'. Korehtaal kuxik ruk'atam i jumb'oht chi huuj. <verse number="24" style="v" />Eh ni xata re' i reey, ni xata re' taqe i nimaq wach kikamaj ruuk' ajaab'ees xi ib'irinik reh i xuq'or panhuuj, eh xchalik kiyo'jiik, ni xata naq xkik'uhtaaj chi xtib'ik kik'ux chi riij i huuj re' re'. <verse number="25" style="v" />Atoob' ta re' i Elnatán, re' i Delaía, re' i Gemarías xkipahqaaj wo' naq kikuyb'al reh i reey chi maruk'at i jumb'oht chi huuj re' re'. Eh re' reh xama' xrib'iraj ta wo' k'isinoq. <verse number="26" style="v" />Re' reey xutaq'aaj reje i Jerameel, rak'uun i Hamelec, i Seraías rak'uun Azriel, i Selemías rak'uun i Abdeel, chi ruchopariik i Jeremías jalal ruq'oral i Dios ruch'ihil i Baruc re' i aj tz'ihb'. Eh xama' xkian ta wo' ruchopariik ruum re' i QaJaaw Dios xkeb'anik keh.</para>
  <para style="p">
    <verse number="27" style="v" />Eh noq re' i reey Joacim ruk'atam chik i jumb'oht chi huuj i wilik wii' i ruq'oral i Dios re' i xuq'or i Jeremías reh i Baruc chi xutz'ihb'aaj. Re' QaJaaw Dios je' wo' chik wili i xuq'or reh i Jeremías: <verse number="28" style="v" />Yu'naak i hat cha chop wo' chik jumb'oht-oq i huuj nee wo' chik i natz'ihb'aaj chupaam chu'nchel i q'orik xatz'ihb'aaj pampeet chupaam i jumb'oht chi huuj xuk'at wach q'aaq' i Joacim re' i kireey i aj Judá. <verse number="29" style="v" />Eh je' wili i cha q'or reh i reey re' re': Re' QaJaaw Dios je' wili ruq'or chawiij: Re' reh xuk'at i jumb'oht chi huuj, eh xat ruq'il i hat Jeremías chi xatz'ihb'aaj chupaam chi re' taqe i aj Babilonia ma' naa rik'iik wach chi ma' naa ta kichaliik chi rusachariik wach i tinamit wili. Eh chi naa kikanaam chi ma' jino'q chik i winaq, chi ma' jino'q chik i chikop naa rukahniik chupaam. <verse number="30" style="v" />Re' QaJaaw Dios je' wili i xuq'or chi riij i Joacim kireey i aj Judá: Re' reh ma' jaruuj naa ruwihiik jino'q i riih rumaam chi reyil, je' rukab' noq xwihik cho chi reyil i David. Eh re' i ruti'jolal noq naa rukimiik naa rukahnik chi tuch'lik chuwach i tz'a'laj q'iij, chuwach i runimaal k'uxik chaq'ab'. <verse number="31" style="v" />Re' taqe riih rumaam, taqe nimaq wach kikamaj wilkeeb' ruuk' naa nuye'em taqe chutojariik i kimahk. Eh naa nuye'em chikinaah i keh, chikinaah i aj Jerusaleem, chikinaah i aj Judá. Nik' nimaal i ti' k'axik xnuq'or rib'iral, re' i ma' xkaaj ta kib'iram, inki chawiij i Dios tiko'q reh.</para>
  <para style="p">
    <verse number="32" style="v" />Re' i Jeremías xuchop wo' chik chaloq i jumb'oht chi huuj tokoom chik xuyeew reh i Baruc rak'uun i Nerias, re' wo' xtz'ihb'anik reh i ruq'oral i Dios xq'orarik reh ruum i Jeremías. Re' i xutz'ihb'aaj chupaam i peet huuj xuk'at i Joacim. Eh re' i Jeremías xuq'or chi naa rutz'ihb'jiik i kore' xq'orarik cho reh ruum i Dios, wilik i xtiqarik naah.</para>
  <chapter number="37" style="c" />
  <para style="s">Re' noq xtz'aparik i Jeremías</para>
  <para style="p">
    <verse number="1" style="v" />Re' i Nabucodonosor i kireey i aj Babilonia xukoj chi reey ar Judá i Sedequías rak'uun i Josías chi jilow i Jeconias rak'uun i Joacim. <verse number="2" style="v" />Xa re' la' ni xata re' i Sedequías, ni xata re' taqe i raj kamanoom, ni xata re' taqe i tinamit xinimanik reh i ruk'uhb'aal i Dios xq'orarik keh ruum i Jeremías jalal ruq'oral i Dios.</para>
  <para style="p">
    <verse number="3" style="v" />Re' i reey Sedequías xutaq'aaj reje i Jucal rak'uun i Selemías, ruch'ihil i k'amal b'eeh aj tiij Sofonías rub'ihnaal rak'uun i Maasías, ruuk' i Jeremías jalal ruq'oral i Dios je' wili taq i cha q'or reh: Chub'aan rutiij chiqiij chuwach i QaJaaw Dios tiko'q taq reh, inki. <verse number="4" style="v" />Eh chupaam i q'iij re' re' komajaa' inye'arik pantz'ilom i Jeremías, koruyee riib' chinb'ehik chi kixilak i tinamit. <verse number="5" style="v" />Eh chupaam i q'iij re' re' k'ulik naq chik inki a'n iloq i ru soldado i kireey aj Egipto. Eh noq xkinab'eej taqe i ki soldado i aj Babilonia i k'ahchi' naq keeb' chi q'aq'inik ruuk' i aj Jerusaleem xi elik reje ar.</para>
  <para style="p">
    <verse number="6" style="v" />Chi riij i re', re' i QaJaaw Dios je' wo' chik wili i xuq'or reh i Jeremías jalal ruq'oral i reh: <verse number="7" style="v" />Re' hat je' wili i cha q'or reh i kireey i aj Judá: Re' i QaJaaw i qaDios i hoj, hoj aj Israel je' wili i xuq'or: Xuq'or chi naa apahqaam weh chib'ih naa rukahniik wii', cha q'or reh i reey re' re' chi re' taqe i ru soldado i kireey i aj Egipto xi chalik naq chi ruko'ljiik, naa wo' chik kisutiniik reje pan Egipto. <verse number="8" style="v" />Eh re' taqe i ki soldado i aj Babilonia naa wo' chik kichaliik chi q'aq'inik chinaah i tinamit Jerusaleem, naa kichopom naah, naa kikojom ruq'aq'al. <verse number="9" style="v" />Re' hin i Dios kinq'orik taq aweh chi maa jot' taq awiib' maa kapaaj taq chi re' i ki soldado i aj Babilonia ojik xkian chi jumpech ruum ma' je' ta re'. <verse number="10" style="v" />Atoob' ta nee wo' naq taq i na a'n keh i hat i ki soldado i aj Babilonia naa kib'aniik i q'aq'inik taq awuuk', xama' k'ih ta chik chi winaq i naa kikahniik, xanaa kiq'ojib'iik chupaam i kiye'aab' kimolom wii' kiib'. Re' taqe i re' naa wo' chik kik'achjik reje, re' chik i keh naakikojwiik ruq'aq'al aatinamiit, inki Dios.</para>
  <para style="p">
    <verse number="11" style="v" />Eh re' i ki soldado i aj Babilonia xi elik reje Jerusaleem, re' noq xkinab'eej chi re' taqe i ru soldado i kireey i aj Egipto k'ulik inki a'n iloq. <verse number="12" style="v" />Re' i Jeremías xelik reje pan tinamit Jerusaleem xooj naq chupaam i ruyuq'ul i Benjamín. Re' naq xraaj i reh chi xooj haa' chuch'aqariik i ye'aab' i xkik'ul chi kikooch ruch'ihil taqe i rutinamiit. <verse number="13" style="v" />Eh noq xooj k'oloq i Jeremías chi chii' i puerta wilik reje chi korkiil i ruyuq'ul i Benjamín, ar wilik jinaj i aj cha'joom kajaaw soldado Irías rub'ihnaal rak'uun i Selemías xuq'at i Jeremías je' wili xuq'or reh: Re' hat inawaaj ojik chi kixilak i aj Babilonia maje', inki reh. <verse number="14" style="v" />Eh re' Jeremías je' wili i xuq'or: Ma' korik taj inaq'or ma' k'ahchi' ta wojiik chi kixilak i aj Babilonia, inki. Eh re' Irías xama' xunimaj taj i xq'orarik reh, xuchop la' i Jeremías xuk'am reje chikiwach i nimaq wach kikamaj ruuk' i reey. <verse number="15" style="v" />Re' keh ma' k'isiin ta xchalik kik'aah chinaah i Jeremías noq xkilow wach xkiq'ojib'eej. Eh ar xkitz'ap parupaat i Jonatán, re' i aj tz'ihb', ruum re' i paat re' re' xkisutej chi kiye'aab' prexo.</para>
  <para style="p">
    <verse number="16" style="v" />Eh re' noq re' i Jeremías xye'arik i koq chupaam i jul wilik chupaam i paat, eh najt xub'an ar. <verse number="17" style="v" />Re' i reey Sedequías xuq'or: chi naa ruk'amariik reje i Jeremías chupaam i paat i rub'an wii' i taaq'anik, noq wilik chik ar i Jeremías, re' reey xupahqaaj reh chi qeqmaal chi je' wili: ¿Mi wilik jino'q i ruk'uhb'aal i Dios chi wee hin? inki. Re' Jeremías je' wili i xuq'or: Hoo' wilik, re' chi naa aq'ahtesjiik chi ri'sil i rajaawriik i kireey i aj Babilonia, inki. <verse number="18" style="v" />Eh re' i Jeremías xupahqaaj reh i reey Sedequías chi je' wili: Raaj i hin ¿Chib'ih i mahk xnub'an chawach i hat chikiwach i awaj kamanoom, chikiwach i tinamit, ruum xinkimin pantz'ilom? inki. <verse number="19" style="v" />Eh ¿Aha' wilkeeb' taqe i jalal ruq'oral i Dios inki a'n kiib' re' i xiq'orik aweh i chi re' kireey i aj Babilonia ma' naa ta ruchaliik chi q'aq'inik cha naah i hat, chikinaah aatinamiit? <verse number="20" style="v" />Qajaaw reey chab'iraj tii weh i naa nupahqaam aweh, inwaaj chi nee nayeew weh. Re' chi maayeew chik q'ab' chi nee kinooj kitz'ap parupaat i Jonatán ruum wi xinooj kitz'ap, ar neekinkimik, inki. <verse number="21" style="v" />Eh re' i reey Sedequías xuq'or chi cha'jaljoq chuwach reje i tz'ilom. Xuq'or chi rajlaal q'iij naa ruk'amariik reje rukaxlanwi'k re' ruuk' i xa pantaq b'eeh inloq'arik. Je' re' xkian reh korehtaal chik xk'uhlik i kaxlanwi'k. Je' aj re' noq xkahnik i Jeremías chuwach reje i tz'ilom.</para>
  <chapter number="38" style="c" />
  <para style="s">Re' hoq xye'arik pan chaam laj jul i Jeremías</para>
  <para style="p">
    <verse number="1" style="v" />Re' i Sefatías rak'uun i Matán, i Gedalías rak'uun i Pasur, i Jucal rak'uun i Selemías, i Pasur rak'uun i Malquías, xkib'iraj i Jeremías noq k'ahchi' ruq'orom keh i tinamit taqe i q'orik wili: <verse number="2" style="v" />Re' i QaJaaw Dios je' wili i xuq'or: Awach i naa kikahniik chupaam i tinamit wili naa kikimiik ruum q'aq'inik, ruum wi'jaleel, ruum yab'ilaal. Eh awach i naakeliik reje neenkiq'asaj kiib' pan kiq'ab' i aj Babilonia, neenkiko'leej riij i kik'achariik. <verse number="3" style="v" />Re' QaJaaw Dios i xuq'or chi re' i tinamit wili naa rukahniik chi ri'sil i kajaawriik i ru soldado i kireey i aj Babilonia. Re' reh naa ruchopwiik naah inki Dios, inki Jeremías. <verse number="4" style="v" />Eh re' taqe i nimaq wach kikamaj je' wili i xkiq'or reh i reey: Re' hoj inqaq'or chi ruk'ul chi neenkanteesjik i winaq re' re', ruum k'ahchi' rutukem wach i kikapeb'aal taqe i soldado koxikahnik panqatinamiit, je' wo' taqe i tinamit. Re' winaq re' re' ma' re' taj i holohik k'ahchi' rusik'im chi riij i qatinamiit, re' la' i yiib' wach k'ahchi' rusik'im, inki taqe. <verse number="5" style="v" />Eh re' reey Sedequías je' wili i xuq'or: Ma' xta reet cha a'n taq ruuk' aha' wilik taq inawaaj i hat. Re' hin xama' xta wo' neenub'an taq aweh chi riij, inki. <verse number="6" style="v" />Noq xkib'iraj chi je' re' xkichop i Jeremías xkiqasaj qohoq chi laso chupaam i chaamlaj jul wilik paruye'aab' i k'amal b'eeh Malquías rub'ihnaal. Re' jul re' re' ar wilik chuwach reje i tz'ilom, eh ruum chi ma' xta ha' chupaam i jul re' re' xa ch'uwa' i wilik chupaam xjutlujik qohoq ar i Jeremías.</para>
  <para style="p">
    <verse number="7" style="v" />Eh noq xrib'iraj i Ebed-melec aj Etiopía kapuun raj kamanoom reey chi xye'arik qohoq panjul i Jeremías. Eh chupaam i q'iij re' re' rumolom riib' i reey chik'utaaj kuuk' taqe i raj kamanoom chi chii' puerta Benjamín rub'ihnaal. <verse number="8" style="v" />Eh re' Ebed-melec xelik reje chupaam i paat i rub'an wii' i taaq'anik i reey, xooj chi q'orob'jiik i reey je' wili i xuq'or reh: <verse number="9" style="v" />Re' i xkian taqe i winaq re' re', reh i Jeremías jalal ruq'oral i Dios jinaj i runimaal mahk. Re' keh xkimin chupaam i chaam laj jul, eh yu'naak k'ahchi' rukimiik ar ruum wi'jaleel ruum ma' xta chik kaxlanwi'k chupaam i tinamit, inki. <verse number="10" style="v" />Eh chi riij i re', re' i reey xuq'or reh Ebed-melec chi chuk'am reje chi riij lajeeb'-oq ru ka'winaq taqe i winaq, reh chi naa rojiik kesam i Jeremías chupaam i chaam laj jul, reh chi ma' xkimik ta ar. <verse number="11" style="v" />Eh re' Ebed-melec xuk'am wo' taqe reje chi riij i winaq xooj i molarik wii' taqe itz'ihy inkamanik chupaam i paat i rub'an wii' i taaq'anik i reey xuk'am chaloq taqe i q'aah taq itz'ihy ruuk' laso xuqasaj qohoq reh i Jeremías chupaam i chaamlaj jul, je' wili i xuq'or reh: <verse number="12" style="v" />Chakoj taqe i q'aa itz'ihy re' re' pan asikan reh chi ma' nee ta tiruyol i laso, inki. Eh re' i Jeremías xub'an wo' hoq i xq'orarik reh. <verse number="13" style="v" />Eh re' taqe i winaq xkikut qohoq i laso reh i Jeremías, ruuk' i re' xkiqerej chaloq. Eh ar wo' chik xkahnik i Jeremías chuwach reje i tz'ilom.</para>
  <para style="s">Re' i reey Sedequías xutaq'aaj ruk'amariik i Jeremías</para>
  <para style="p">
    <verse number="14" style="v" />Re' i reey Sedequías xuq'or chi naa ruk'amariik reje chuwach i Jeremías ar chupaam i ookb'al reh i rupaat i Dios, je' wili xuq'or reh i Jeremías jalal ruq'oral i Dios:</para>
  <para style="p">Re' hin jinaj inwaaj nupahqaam aweh inwaaj chi nee naa chaq'weej weh chi korik, inki.</para>
  <para style="p">
    <verse number="15" style="v" />Re' i Jeremías je' wili i xuq'or:</para>
  <para style="p">Wila' xnuchaq'weej aweh chi korik re' hat neenataq'aaj nukanteesjiik. Eh wila' xnukoj ana'ojb'al xama' nee ta wo' kinanimaj, inki.</para>
  <para style="p">
    <verse number="16" style="v" />Eh re' i reey Sedequías xa chi qeqmaal xuq'or reh i Jeremías, chi je' wili:</para>
  <para style="p">Re' hin parub'ihnaal i QaJaaw i xye'wik k'achariik i nuq'or aweh i xti korik chi ma' nee ta nutaq'aaj akanteesjiik. Eh ma' nee ta tinuyeew pan kiq'ab' inkaaj akanteesjiik, inki.</para>
  <para style="p">
    <verse number="17" style="v" />Eh re' i Jeremías je' wili i xuq'or reh i reey Sedequías: Re' QaJaaw i qaDios i hoj, hoj aj Israel wilik rajaawriik je' wili i ruq'or chawiij:</para>
  <para style="p">Wila' re' reh xuq'asaj riib' pan kiq'ab' i k'amal kib'eeh taqe i ru soldado i kireey i aj Babilonia neeruko'leej riij i ruk'achariik i reh je' wo' i rak'uun rixq'uun. Eh re' i tinamit wili ma' nee ta inkojarik ruq'aq'al. <verse number="18" style="v" />Raaj wila' ma' xuq'asaj riib' keh taqe i ki soldado i aj Babilonia naa kichopom naah i tinamit wili naakiqopom ruq'aq'al. Eh re' reh ma' naa ta ruko'leem riib' chuwach, inki.</para>
  <para style="p">
    <verse number="19" style="v" />Re' i reey Sedequías je' wili i xuq'or:</para>
  <para style="p">Re' hin kinyo'jik kuum i aj Judío chi q'ahxik chi kixilak i aj Babilonia, ruum wila' xinkichop i keh neenkik'saj chi ti' i nuti'jolal, inki. <verse number="20" style="v" />Eh re' Jeremías je' wili xuq'or:</para>
  <para style="p">Re' hat ma' nee ta ti q'ehb'ik pan kiq'ab' cha nimaj la' i ruq'oral i Dios i nuq'or aweh, ma' xta reet nee ti elik, eh neenako'leej riij ak'achariik. <verse number="21" style="v" />Re' i QaJaaw Dios ruk'uhtaam chik weh chib'ih jariik i naa ak'ulum, wila' ma' xaq'asaj awiib' pan kiq'ab' i ru soldado i kireey i aj Babilonia. <verse number="22" style="v" />Eh chu'nchel ixoq naakikahnik chupaam i paat i na a'n wii' i taaq'anik i hat reey, xanaa wo' kiq'ahteesjiik pan kiq'ab' i k'amal kib'eeh i ru soldado i kireey i aj Babilonia, je' wili i naa kiq'orom reh i reey:</para>
  <para style="b" />
  <para style="q">Re' taqe i xti naah naq awamigo</para>
  <para style="q">xatkijot' xkiq'at awach,</para>
  <para style="q">xkiyeew q'ab' chi xat q'ehb'ik chupaam i ti' k'axik,</para>
  <para style="q">eh xatkikanaa' cha wutkeel, inko'q taqe.</para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" />Eh chu'nchel ixoq achopom kinaah, taqe i awak'uun awixq'uun naa kiq'ahteesjiik pan kiq'ab' taqe i aj Babilonia, eh re' hat i reey ma' naa ta ko'leem awiib' pan kiq'ab', naa la' kaat kiq'asam pan q'ab' i kireey i aj Babilonia. Eh re' i tinamit wili naakiqopom ruq'aq'al, inki.</para>
  <para style="p">
    <verse number="24" style="v" />Eh re' reey Sedequías je' wili xuq'or reh i Jeremías:</para>
  <para style="p">Wila' ma' nawaaj chi nee tikimik maa awach aj eh aq'or taqe i xaq'or weh. <verse number="25" style="v" />Wila' xkinab'eej taqe i waj kamanoom chi xnub'an nuk'utaaj awuuk' neenkipahqaaj weh chib'ih i xaq'or weh i hat. Eh je' wili i neenkiq'or aweh: Wila' nawaaj chi nee nuko'leej riij aak'achariik, cha q'or qeh i xaq'or taq ruuk' i reey, inko'q taqe aweh. <verse number="26" style="v" />Eh re' hat je' wili i neenaq'or keh: Re' hin re' i xnupahqaaj reh i reey re' chi ma' nee ta chik rutaq'aaj nutz'apariik parupaat i Jonatán, reh chi ma' nee ta tikimik ar, tiko'q keh inki.</para>
  <para style="p">
    <verse number="27" style="v" />Eh chu'nchel i raj kamanoom i reey xiooj wo' ruuk' i Jeremías i xkipahqaaj reh chib'ih jariik i xkiq'or. Re' Jeremías nik' wach i xq'orarik reh ruum i reey je' wo' re' i xuq'or keh, ruum i re' ma' xta kuchej, xkikanaa' chi je' re' ruum ma' awach ta x-ib'irinik reh i k'utaaj xkian. <verse number="28" style="v" />Eh re' i Jeremías ar wo' xkahnik chi tz'aplik chuwach reje i tz'ilom, korehtaal chik xponik i q'iij noq xchoparik naah i tinamit Jerusaleem.</para>
  <chapter number="39" style="c" />
  <para style="s">Re' noq xqehb'ik panti' k'axik i tinamit Jerusaleem</para>
  <para style="r">(<ref loc="2KI 24:20-25:21">2 Rey 24.20—25.21</ref>; <ref loc="2CH 36:17-21">2 Cron 36.17-21</ref>; <ref loc="JER 52:3-30">Jer 52.3-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Eh chupaam i ru lajeeb' poh reh i rub'elejeeb' haab' rokiik chi reyil i Sedequías ar Judá, re' i reey Nabucodonosor ruch'ihil taqe i ru soldado xi chalik chi q'aq'inik chinaah Jerusaleem, eh xkikotej riij. <verse number="2" style="v" />Eh parub'eleej q'iij reh i rukaaj poh chupaam i rujunlaaj haab'rokiik chi reyil i Sedequías, re' taqe i aj ixowaal xkiteh i koq jinaj i-ik'b'al chupaam i koraal tz'aq chi riij i tinamit, xi okik i koq pan tinamit. <verse number="3" style="v" />Eh chu'nchel i kitowik reh i kireey i aj Babilonia xi okik i koq, ar xiooj wih-oq chuwach i puerta wilik panyejaal, re' taqe re' je' wili i kib'ihnaal: Nergal-sarezer, Samgar-nebo, Sarsequim, k'amal kib'eeh taqe i kapuun, eh jinaj chik Nergal-sarezer re' taqe i re' nimaq wach kikamaj ruuk' i kireey i aj Babilonia. <verse number="4" style="v" />Eh noq xrilow chi je' re' i Sedequías kireey i aj Judá ruch'ihil taqe i ru soldado xkimol chi elik chaq'ab' reje chupaam i tinamit. Ar xi elik reje chupaam i b'eeh tikooj wii' i uhtz'ub' ma' najt ta ruuk' i ruye'aab' i reey xi elik reje chi chii' i puerta wilik panyejaal i tz'aq. Eh xkik'am qohoq i b'eeh wach k'ixkaab' i nik'ik wii' i nim ha' Jordán. <verse number="5" style="v" />Eh re' taqe i ki soldado i kireey i aj Babilonia xkitahqeej reje, korehtaal xponik kireq wach k'ixkaab' Jericó reey Sedequías. Eh ar xkichop xkik'am chuwach i reey Nabucodonosor wilik chupaam i ye'aab' Ribla wilik paruyuq'ul i Hamat, ar xuq'at i q'orik chinaah. <verse number="6" style="v" />Eh ar Ribla re' i kireey i aj Babilonia xutaq'aaj kik'amariik taqe i rak'uun rixq'uun i Sedequías, eh ti chuwach i reh xuyok' i kalaq taqe i rak'uun rixq'uun. Eh je' wo' re' i xub'an keh taqe i xa atoob' wach kik'ux wilkeeb' Judá. <verse number="7" style="v" />Eh re' reey Sedequías xresaj kab'chel i naq wach, b'ak'lik i q'ab' chi karena noq xk'amarik reje prexo pan tinamit Babilonia. <verse number="8" style="v" />Re' taqe i soldado kichalik Babilonia xkikoj ruq'aq'al i paat i rub'an wii' i taaq'anik i reey Sedequías. Eh xkikoj wo' ruq'aq'al i paat wilkeeb' pan tinamit, xkiq'eb' wach ak'al i tz'aq kotimaj wii' riij i tinamit Jerusaleem. <verse number="9" style="v" />Eh re' i Nabuzaradán k'amal kib'eeh i soldado kichalik Babilonia xuk'am taqe reje Babilonia nik' k'ihaal i koxikahnik Jerusaleem. Je' wo' taqe i xkiq'asaj naq kiib' chi kixilak i ki soldado i aj Babilonia eh xuk'am wo' taqe reje chu'nchel i tinamit koxikahnik naq. <verse number="10" style="v" />Xa re' wo' chik xukanaa' pantinamiit Judá i kok'neb'aa' ma' xta wilik keh. Eh chupaam i q'iij re' re' xuyeew kiye'aab' reh chi naa kitikim ki uuva.</para>
  <para style="s">Re' noq xelik chi prexohjik i Jeremías</para>
  <para style="p">
    <verse number="11" style="v" />Re' reey Nabucodonosor ko ar Babilonia xuq'or cho reh i Nabuzaradán k'amal kib'eeh soldado chi riij chib'ih i naa ruk'ulum i Jeremías, je' wili xuq'or: <verse number="12" style="v" />Re' hat naa achopwiik nah rucha'jaljiik i Jeremías, maa chih awuchej, naa aye'em reh chib'ih jariik i naa rupahqaam aweh, inki reh. <verse number="13" style="v" />Eh re' Nabuzaradán k'amal kib'eeh i soldado, ruch'ihil Nabusazbán, ruch'ihil i Nergal-sarezer, i k'amal kib'eeh taqe i kapuun nimaq wach kikamaj ruuk' i kireey i aj Babilonia. <verse number="14" style="v" />Xkesaj i Jeremías chupaam i paat wilik reje chuwach i tz'ilom. Eh re' i Gedalías xkikoj chi ilil reh, rak'uun Ahicam riih i Asaf, reh chi naa ruk'amariik reje parupaat. Re' i Jeremías xkahnik chi k'acharik chi kixilak i tinamit xi kahnik chupaam i tinamit re' re'.</para>
  <para style="s">Re' i Dios xuq'or chi naa ruko'leem riij i ruk'achariik i Ebed-melec</para>
  <para style="p">
    <verse number="15" style="v" />Noq re' i Jeremías ko tz'aplik chuwach reje i tz'ilom xq'rob'jik ruum i Dios, je' wili i xq'orarik reh: <verse number="16" style="v" />Re' hat cha q'or reh i Ebed-melec aj Etiopía. Je' wili i cha q'or reh. Re' i QaJaaw Dios nim rajaawriik i qaDios i hoj, hoj aj Israel, je' wili i ruq'or chawiij: Re' hin naa nuye'em i ti' k'axik chinaah i tinamit wili, ma' re' ta holohik i naa nuye'em chinaah. Eh noq naa ruk'ulariik i re', re' reh naa rilom ruuk' naq'wach. <verse number="17" style="v" />Xa re' la' re' reh naa nuko'leem, reh chi ma' nee ta nq'ehb'ik pan kiq'ab' i aj ixowaal re' re' q'e' inyo'jik kuum. <verse number="18" style="v" />Re' hin korik chi naa nuko'leem, reh chi ma' nee ta nkikansaj, naa nuko'leem riij i ruk'achariik ruum chi xuyeew ruk'ux wuuk', inki Dios tiko'q reh.</para>
  <chapter number="40" style="c" />
  <para style="s">Re' i Jeremías ar xkahnik ruuk' i Gedalías</para>
  <para style="p">
    <verse number="1" style="v" />Re' i Dios xuq'oreej i Jeremías noq re' i Nabuzaradán k'amal kib'eeh i soldado roq'taam chik reje i Jeremías chupaam i ye'aab' Rama. Eh re' Nabuzaradán prexo wilik i Jeremías b'ak'lik wach chi karena noq xponik rureq chi kixilak i aj Jerusaleem, chi kixilak i aj Judá k'ahchi' kik'amariik reje Babilonia. <verse number="2" style="v" />Re' i k'amal kib'eeh soldado xresaj reje chi rutkeel i Jeremías. Je' wili xuq'or reh: Re' i QaJaaw Dios ruq'orom chaloq chi naa ruye'em i runimaal ti' k'axik chinaah i tinamit wili. <verse number="3" style="v" />Eh yu'naak xub'an chik chaloq taqe i ruq'orom. Re' taqe i wili xchalik taq cha naah ruum xat mahkunik taq chuwach i QaJaaw, eh ma' xanimaj ta taq. <verse number="4" style="v" />Xa re' la' re' hin xatwoq'taaj chik xnuchej chik i karena b'ak'lik naq wii' taqe aq'ab'. Eh wila' i ruk'ul ak'ux chi netiooj chi wiij Babilonia neerub'an chi nee tiooj, re' wo' hin nee kincha'jinik aweh. Eh wila' ma' ruk'ul ak'ux chi nee tiooj nee wo' rub'an chi ma' nee ta tiooj. Wilik wo' chawach i runimaal tinamit wili xa aha' pa' nee ruk'ul ak'ux chi nee ti k'acharik neerub'an chi nee tiooj ar. <verse number="5" style="v" />Eh wila' nawaaj wo' chik sutinik reje neerub'an chi nee ti k'acharik ruuk' i Gedalías rak'uun i Ahicam riih i Safán, re' i xkojarik chi ajaab'esil ar Judá ruum i qareey i hoj aj Babilonia. Eh nee ti k'acharik chi kixilak i tinamit, xa aha' pa' i ruk'ul ak'ux i hat i nuchjik i Jeremías. Re' i k'amal kib'eeh soldado jinaj i rukooch i Jeremías xuyeew, eh xuch'aq reje. <verse number="6" style="v" />Re' i Jeremías xooj wo' ruuk' i Gedalías rak'uun i Ahicam chupaam i ye'aab' Mizpa. Ar xk'acharik chi kixilak i tinamit xi kahnik chupaam i ye'aab' re' re'.</para>
  <para style="p">
    <verse number="7" style="v" />Noq re' taqe i k'amal b'eeh kuch'ihil taqe i ki soldado re' ruuk' taqe i aj Judío wilkeeb' chupaam taqe i ye'aab' re' re', xkib'iraj chi re' i kireey i aj Babilonia re' i Gedalías rak'uun i Ahicam xukoj chi ajaab'ees chinaah i tinamit. Eh re' wo' reh xukoj chi cha'jen keh i tinamit q'e' taqe neb'aa', chi winaq chi ixoq, chi ha'lak'un, re' i ma' xi k'amarik ta taqe reje Babilonia. <verse number="8" style="v" />Re' taqe i k'amal b'eeh re' re' xiooj ar Mizpa chi rilariik i Gedalías. Eh xooj haa' i Ismael rak'uun i Netanías, haa' i Johanán, haa' i Jonatán, rak'uun Carea, haa' i Seraías rak'uun i Tanhumet, haa' taqe i rak'uun i Efai, haa' taqe i rak'uun Netofa, haa' i Jezanias rak'uun jinaj i winaq aj Maacateo, haa' taqe i winaq wilkeeb' chi riij. <verse number="9" style="v" />Eh re' Gedalías rak'uun Ahicam, rak'uun i Safán xuq'or i korik je' wili i xuq'or keh: Matyo'jik taq chi nee taq inaq'asaj awiib' chi kixilak i aj Babilonia. Neerub'an chi nee taq ti k'acharik ayu', xa re' la' chakamaneej taq wach kireey i aj Babilonia, ma' xta reet taq nee ti elik. <verse number="10" style="v" />Eh re' hin ayu' naa nukahniik chi k'acharik Mizpa, re' hin neekinq'orik taq chawiij kuuk' i aj Babilonia noq naa kik'uliik iloq ayu'. Re' taq i hat naa taq amolom i riis i uuva, i wach taq aachee', aseite reh i siq'jil, eh suq taq nee ti k'acharik chupaam i ye'aab' achopom taq naah, inki. <verse number="11" style="v" />Eh re' taqe i aj Judío wilkeeb' Moab, taqe i wilkeeb' Amón, taqe wilkeeb' Edom, taqe wilkeeb' xa aha' pantaq tokoom tinamit, xkib'iraj chi re' i kireey i aj Babilonia ko wilik taqe i aj Judío xukanaa' chupaam i kitinamiit, eh chi re' Gedalías xupab'aa' chi ajaab'ees chikinaah. <verse number="12" style="v" />Eh chu'nchel i aj Judío re' re' xi chalik, xi elik chaloq chupaam taqe i ye'aab' tukimaj reje wii' kiwach, xchalik kik'uhtaaj kiib' chuwach i Gedalías chupaam i ye'aab' Mizpa. Eh je' wo' keh ma' k'isiin k'ihaal i riis uuva xkimol, je' wo' i wach taqe i kichee'.</para>
  <para style="s">Re' i ma' holohik taj xuyejaa' wach i Ismael chi riij i Gedalías</para>
  <para style="p">
    <verse number="13" style="v" />Re' i Johanán rak'uun i Carea, ruch'ihil taqe i k'amal kib'eeh i soldado re' taqe i kanalkeeb' pantaq ye'aab' xiooj ar Mizpa chi rilariik i Gedalías. <verse number="14" style="v" />Je' wili i xkiq'or reh: ¿Mi aweht'al i hat chi re' i Baalis kireey i aj Amón xutaq'aaj chaloq i Ismael chakantesjiik? inki taqe reh. Xa re' la' re' Gedalías xama' xunimaj ta wo' hoq. <verse number="15" style="v" />Eh re' i Johanán rak'uun i Carea je' wili i xuq'or reh Gedalías chi q'eeqmaal: Chayeew q'ab' weh chi nenooj nukansaj i Ismael, ma' awach ta neenab'inik awach neemb'anik reh. ¿Nik' wach noq naaqaye'em q'ab' i hoj chi nee tirukansaj? ¿Mi neenqayeew q'ab' re' chi nee wo' chik inkitukej kiib' i aj Judío kimolom kiib' awuuk', eh neekikimiik? inki. <verse number="16" style="v" />Eh re' i Gedalías rak'uun i Ahicam je' wili i xuq'or: Maa a'n i je' re' aha' wilik inkiq'or chi riij i Ismael ma' korik taj, inki.</para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Eh paruwuuq poh chik re' i Ismael rak'uun i Netanías riih i Elisama, ma' tokoom ta kuuk' i nimaq wach kikamaj ruuk' i reey. Ruch'ihil taqe i lajeeb' chi winaq xiooj ar Mizpa chuq'orob'jiik i Gedalías, noq wi'k chik inki a'n ruuk' ar nah mexa. <verse number="2" style="v" />Re' i Ismael rak'uun i Netanías ruch'ihil taqe i lajeeb' chi winaq xi wuktik johtoq, chi jumehq'iil xkesaj chaloq i kiq'aslaj ch'ihch' xkikansaj i Gedalías rak'uun i Ahicam, rak'uun i Safán. Re' i xupab'aa' i kireey i aj Babilonia chi ajaab'ees chikinaah i aj Judá, <verse number="3" style="v" />Re' i Ismael xkuxik wo' rukansam chu'nchel i aj Judío je' wo' ki soldado i aj Babilonia wilik naq ruuk' Gedalías ar Mizpa.</para>
  <para style="p">
    <verse number="4" style="v" />Eh eew-oq chik inkanteesjik i Gedalías, re' noq komajaa' ta awach i naab'inik reh chib'ih i xk'ularik. <verse number="5" style="v" />Wilik taqe i winaq xi elik cho Siquem, i xi elik cho Silo, i xi elik cho Samaria kajwinaq chi kiib' kijoyom i kusinchii' xkiweq i kiso' chikiij, eh xkiyok'ib'eej wach i kiti'jolal. Eh wilik naq kimayiij i ki insensia xkik'am chaloq, reh naq chi naakiq'aasam parupaat i Dios. <verse number="6" style="v" />Eh re' Ismael xelik reje chupaam i ye'aab' Mizpa, xooj taqe ruk'ul wach b'eeh xasuq chik inoq'ik, xa re' wo' noq xuk'ul taqe je' wili xuq'or keh: Taq taq chawilow i Gedalías rak'uun i Ahicam. <verse number="7" style="v" />Xa re' la' noq xi ponik panyejaal i tinamit xyok'arik i kalaq ruum i Ismael rak'uun Netanías kuum taqe i winaq ruch'ihil. Eh xkikut taqe qohoq chupaam i jinaj i chaam laj jul. <verse number="8" style="v" />Eh lajeeb' chik chi winaq re' ruuk' i keh ma' xi kanteesjik taj je' wili i xkiq'or reh i Ismael: Maa qoh akansaj ti hoj ruum wilik i trigo, i sebada, i Aseite, i riis kaab' qakeb'aam panab'iix, inki taqe. Noq xrib'iraj chi je' re' Ismael ma' xukansaj ta taqe je' rukab' noq xukansaj taqe i kuch'ihil.</para>
  <para style="p">
    <verse number="9" style="v" />Re' chaamlaj jul xukut wii' i kiti'jolal i winaq i Ismael re' wo' hoq i jul xutaq'aaj ruk'otariik i reey Asa ko'lemb'al riib' chuwach i Baasa kireey i aj Israel. Re' i chaamlaj jul re' re' xiik' wo' naq naah nimaal xnujik ruum i kiti'jolal i xukansaj taqe i Ismael rak'uun i Netanías. <verse number="10" style="v" />Eh ma' xata re' re' xub'an i Ismael xuchop la' wo' taqe i rixq'uun i reey, je' wo' chu'nchel i tinamit xi kahnik naq Mizpa. Re' taqe i xye'arik reh i Gedalías chi naa rucha'jeem ruum i Nabuzaradán k'amal kib'eeh i soldado, re' i Ismael xuchop taqe i tinamit re' re', eh xuchop reje rub'eeh xq'ahxik reje pan kitinamiit i aj Amón.</para>
  <para style="p">
    <verse number="11" style="v" />Noq xrib'iraj rib'iral i Johanán rak'uun i Carea ruch'ihil taqe chu'nchel i k'amal kib'eeh i soldado chu'nchel ikaansanik xub'an i Ismael. <verse number="12" style="v" />Xkimol wach chu'nchel i ki soldado xiooj chi q'aq'inik chinaah i Ismael rak'uun i Netanías, ar xponik kireq chi chii' i nimlaj jul ha' wilik Gabaón. <verse number="13" style="v" />Eh noq re' taqe i tinamit k'ahchi' ruk'amam reje pan tokoom tinamit i Ismael manlik xkilow chi xooj k'oloq i Johanán rak'uun Carea ruch'ihil taqe chu'nchel i k'amal kib'eeh soldado, ma' k'isiin ta xsuuqb'ik kik'ux. <verse number="14" style="v" />Xi sutinik chaloq xchalik wo' chik kimol kiib' ruuk' i Johanán, eh re' taqe i tinamit resaj naq reje Mizpa i Ismael. <verse number="15" style="v" />Xa re' la' re' i Ismael rak'uun i Netanías waxiqiib' keh i winaq intowik reh xkian reje elik chuwach i Johanán ar chik xiooj pan kitinamiit i aj Amón. <verse number="16" style="v" />Eh re' i Johanán rak'uun i Carea ruch'ihil i k'amal kib'eeh soldado, taqe ixoq, taqe i kok' ha'lak'un, taqe i kapuun nimaq wach kikamaj xuk'am naq reje pan tokoom tinamit i Ismael rak'uun i Netanías. Re' taqe i xresaj reje Mizpa, noq rukansam chik i Gedalías rak'uun i Ahicam. Re' i Johanán xponik wo' chik taqe rusutej chupaam i ye'aab' Gabaón. <verse number="17" style="v" />Eh xkichop chee kib'eeh, korehtaal xi ponik chupaam i ye'aab' Gerut-quimam ma' najt ta ruuk' i Belén. Ar xi hi'lik chuwach i xama' k'ih ta laj q'iij, re' naq xkaaj i keh chi naakokiik chupaam i ruyuq'ul i Egipto. <verse number="18" style="v" />Re' naq inkaaj chi xkiko'leej kiib' chikiwach i aj Babilonia, xchalik kiyo'jiik ruum re' i Ismael rak'uun i Netanías xukansaj i Gedalías rak'uun i Ahicam. Re' naq i xukoj chi ajaab'ees chikinaah i aj Judío i kireey i aj Babilonia.</para>
  <chapter number="42" style="c" />
  <para style="s">Re' i tinamit xkipahqaaj reh i Jeremías chi naa rub'aan i tiij chikiij</para>
  <para style="p">
    <verse number="1" style="v" />Eh chu'nchel i k'amal kib'eeh soldado haa' i Johanán, haa' rak'uun i Carea, haa' Jezanías rak'uun i Osaías, haa' chu'nchel i tinamit, chi nimaq chi kok' taq xiooj ruuk' i Jeremías jalal ruq'oral i Dios. <verse number="2" style="v" />Eh je' wili xkiq'or reh:</para>
  <para style="p">Jinaj inaaqapahqaam aweh, xa re' la' maaq'or chi ma' nee ta na a'n. Re' chi chapahqaaj reh i aaDios panatiij chi nee qoh rutoob'eej i hoj i xama' hoj ta wo' chik k'ih xoj kahnik. Noq xub'an xiik' naq naah qak'ihaal, eh yu'naak xama' hoj ta chik k'ih je' rukab' i k'ahchi' awilom. <verse number="3" style="v" />Je' re' noq cha pahqaaj reh aaWaJaaw aaDios chi nee ruk'uhtaaj qeh i holohik b'eeh naa qak'amam, je' wo' hoq i naaqanam, inki taqe.</para>
  <para style="p">
    <verse number="4" style="v" />Eh re' i Jeremías je' wili i xuq'or keh:</para>
  <para style="p">Ma' xta reet naa nupahqaam reh i Dios taq inawaaj je' rukab' i xaq'or taq weh. Re' hin nee taq i nuq'or aweh chu'nchel i nee ruq'or weh i QaJaaw Dios, ma' xta chik i neenukanaa' chi ma' nee ta nuq'or, inki.</para>
  <para style="p">
    <verse number="5" style="v" />Re' keh je' wili xkiq'or reh i Jeremías:</para>
  <para style="p">Re' aaWaJaaw aaDios xti korik wach ruk'ux k'ahchi' rilwiik reh, neenye'wik qeh panti' k'axik wila' ma' xqa a'n i nee ruq'or aweh chi naa qa'nam. <verse number="6" style="v" />Atoob' ta nee ruk'ul qak'ux, atoob' ta ma' nee ruk'ul qak'ux i nee ruq'or qeh i QaJaaw Dios reh chi suq neenqohwih'ik. Re' i xqaq'or aweh chi naa apahqaam i rotob'il chiqiij, inki taqe.</para>
  <para style="p">
    <verse number="7" style="v" />Eh lajeeb'-oq chik q'iij kiq'orom i re', re' i QaJaaw Dios xuq'oreej wo' hoq i Jeremías. <verse number="8" style="v" />Re' reh xuyuq'eej ruuk' i Johanán rak'uun i Carea, je' wo' taqe i k'amal kib'eeh i soldado kiooj panq'aq'inik, je' wo' chu'nchel i taqe i tinamit, chi nimaq chi kok' taq je' wili i xuq'or keh: <verse number="9" style="v" />Re' i QaJaaw qaDios i hoj, hoj aj Israel, re' i xaq'or taq weh chi naa nupahqaam reh chib'ih taq inawaaj, je' wili i xuq'or weh: <verse number="10" style="v" />Wila' xi kahnik chupaam i tinamit wili, re' hin naa wesam taqe korik, eh ma' naa ta nusacham kiwach naa la' nu ch'ikam taqe pan kiye'aab', ma' naa ta wesam taqe reje ayu'. Re' hin ti' wo' inwik'raaj taqe chi xnuyeew i ti' k'axik chikinaah. <verse number="11" style="v" />Eh mankiyohleej chik i kireey i aj Babilonia re' i ma' k'isiin ta kiyo'jiik ruum. Manchalik chik kiyo'jiik, ruum re' hin naa nuwihiik kuuk' chi kiko'ljiik, re' hin naa wesaniik keh pan q'ab' i reey re' re'. <verse number="12" style="v" />Naa nuketelaam kiwach, eh naa wo' nuye'em paránima i reey chi naa ruketeljiik kiwach ruum, reh chi nee rukanaa' taqe chi k'acharik pan kitinamiit, inki. <verse number="13" style="v" />Eh wila' re' taq i hat ma' nawaaj taq k'acharik panatinamiit, wila' ma' xanimaj taq awajaaw aaDios, je' taq wili i neenaq'or: <verse number="14" style="v" />Re' hoj inqaaj ojik k'achareel Egipto aha' ma' naa ta qilom wach i q'aq'inik, ni xata naa qib'iram chi naa ruxuljiik i tuun rehtalil i q'aq'inik. Eh ma' nee ta qoh kimik ruum wi'jalel, tiko'q taq. <verse number="15" style="v" />Re' taq i hat koxat kahnik taq chi k'acharik Judá chab'iraj taq i ruq'or i QaJaaw Dios nim rajaawriik i qaDios i hoj, hoj aj Israel je' wili i ruq'or taq chawiij: Wila' re' keh xankotwaaj chik ojik k'achareel Egipto. <verse number="16" style="v" />Naa wo' kireqariik ar ruum i q'aq'inik, je' wo' ruum wi'jaleel, re' i ma' k'isiin ta kiyo'jiik ruum, re' wo' taqe i re' naa rukansanik keh ar. <verse number="17" style="v" />Eh chu'nchel i xankotwaaj chik ojik chi k'acharik Egipto ar wo' naa kikimiik ruum i q'aq'inik, ruum wi'jaleel, ruum yab'ilaal. Eh ma' jino'q chik i naa kikahniik chi k'achalkeeb', ma' jino'q naa ruko'leem riib' chuwach i runimaal ti' k'axik naa nuye'em chikinaah, inki.</para>
  <para style="p">
    <verse number="18" style="v" />Ruum re' i QaJaaw Dios nim rajaawriik, qaDios i hoj, hoj aj Israel je' wili i ruq'or taq chawiij: Nik' wach noq xqop i nujosq'iil chikinaah i aj Jerusaleem, je' wo' re' noq naa ruqopiik i nujosq'iil chikinaah i keh wila' xiooj Egipto. Eh chu'nchel i tinamit ma' holohik ta naa kiq'oriik chikiij, ti yo'joq ruum inakik'ulum, eh ma' naa ta chik kilom wach i kitinamiit, inki. <verse number="19" style="v" />Eh re' taq i hat i koxat kahnik taq chi k'acharik Judá. Re' i QaJaaw Dios i ruq'or taq aweh chi ma' naa ta awojiik taq Egipto, chanab'eej taq chi korik ruum re' hin i nuq'or taq aweh yu'naak chib'ih i ruq'or. <verse number="20" style="v" />Re' taq i hat runimaal mahk k'ahchi' taq kaat ruum xasutej taq chi riij aq'oral. Re' wo' naq taq i hat xat q'orik weh chi naa nub'anam nutiij chuwach i QaJaaw taq chawiij, je' wili taq i xaq'or weh: Chapahqaaj reh aaDios panatiij chi nee qohrutoob'eej, eh neenaq'or qeh i nee ruq'or aweh reh chi neenqa a'n, tiki taq. <verse number="21" style="v" />Eh re' hin xnuq'or taq chik aweh yu'naak i xuq'or weh QaJaaw Dios chi naa taq a'nam, xa re' la' re' taq i hat xama' xawaaj ta wo' taq a'nam. <verse number="22" style="v" />Je' re' noq yu'naak chanab'eej taq chi korik chi ruum q'aq'inik, ruum wi'jaleel, ruum yab'ilaal, naa taq akimiik chupaam i tinamit taq naa awojiik k'achareel, inki Jeremías.</para>
  <chapter number="43" style="c" />
  <para style="s">Xkik'am reje chikiij i Jeremías Egipto</para>
  <para style="p">
    <verse number="1" style="v" />Eh noq xukohlaaj ruq'orariik keh i tinamit i Jeremías chu'nchel i xq'orarik reh ruum i Dios chi naa ruq'orom. <verse number="2" style="v" />Re' i Azarías rak'uun i Osaías, i Johanán rak'uun Carea, taqe i winaq nimaq kiwach, je' wili i xkiq'or reh i Jeremías: Re' hat i nachuk qeh i q'orik, re' i QaJaaw i qaDios ma' xuq'or taa weh chi naa aq'orom qeh chi ma' ruk'ul ta chi naaqojiik k'achareel Egipto. <verse number="3" style="v" />Re' la' Baruc i rak'uun i Nerias i nixowanik qawach xq'orik aweh chi naa aq'orom qeh chi naa qakahniik ayu', reh chi nee qoh kahnik pan kiq'ab' i aj Babilonia, reh chi nee qoh kikansaj, oon chi nee qoh kik'am reje, inki taqe. <verse number="4" style="v" />Eh ni xata re' i Johanán rak'uun i Carea, ni xata re' i k'amal kib'eeh soldado, ni xata re' i tinamit koxikahnik paruyuq'ul i Judá xkinimaj i xq'orarik keh. Eh ma' xkinimaj taj i xuq'or i QaJaaw. <verse number="5" style="v" />Re' i Johanán rak'uun i Carea ruch'ihil taqe i k'amal rub'eeh soldado xkimol wach i kiqox i aj Judá xama' k'ih ta wo' chik taqe. Re' i xkitukej kiib' xa aha' yuuq', re' taqe i xi sutinik chaloq chi naa wo' naq chik kik'achariik Judá. <verse number="6" style="v" />Je' re' noq chi winaq chi ixoq, chi ha'lak'un chi re' taqe i rixq'uun i reey je' wo' chu'nchel i tinamit xukanaa' i Nabuzaradán k'amal kib'eeh soldado chi re' i Gedalías naa rilwiik keh re' i rak'uun i Hicam, xkikoj wo' haa' i Jeremías, ruch'ihil i Baruc. <verse number="7" style="v" />Re' keh ma' xkinimaj taj i xuq'or i QaJaaw chi naa naq kikahniik ar, xiooj la' Egipto, Korehtaal xi ponik chupaam i tinamit Tafnes rub'ihnaal.</para>
  <para style="p">
    <verse number="8" style="v" />Eh noq wilkeeb' chik chupaam i tinamit re' re', re' i QaJaaw Dios je' wili xuq'or reh i Jeremías: <verse number="9" style="v" />Re' hat cha sik' ixib'-oq nimaq ab'aj, eh chikiwach chu'nchel i aj Judá neenamuq'aa' chupaam i lech'ik laj ak'al, chuk'ulwaach imb'aan i koq wii' okik chupaam i paat i rub'an wii' i taaq'anik i reey chupaam i tinamit re' re'. <verse number="10" style="v" />Eh je' wili i cha q'or keh: Re' i QaJaaw Dios nim rajaawriik, re' i qaDios i hoj, hoj aj Israel je' wili i ruq'or: Re' hin naa nukojom chi waj kamanoom i Nabucodonosor kireey i aj Babilonia naa nuk'amam cho chikinaah. Eh chikinaah taqe i ab'aj xnumuq'aa' naakich'ikaam i rupaat naa rub'anam wii' i taaq'anik. <verse number="11" style="v" />Re' reh naa ruchaliik chi rusachariik wach i tinamit Egipto, Awach ye'ooj chikinaah chi naa kikimiik naa wo' kikimiik. Awach i ye'ooj chikinaah chi naa kik'amariik reje pan tokoom tinamit naa wo' kik'amariik reje. Awach i ye'ooj chikinaah chi panq'aq'inik naa kikimiik ar wo' naa kikimiik. <verse number="12" style="v" />Re' i Nabucodonosor naa rukojom ruq'aq'al i rupaat i kitiyoox i aj Egipto. Re' naa ruk'amam taqe reje chi riij parutinamiit. Naa rupuhum reje paam i tinamit Egipto, je' rukab' noq i rupuh i wach i ruso' i aj cha'jen tentzun, ma' k'axik ta noq naa ruk'amam taqe reje. <verse number="13" style="v" />Eh naa ruch'ahaam wach ak'al inajt kinaah tz'aq wilkeeb' paruyuq'ul i Egipto, naa rukojom ruq'aq'al i tiyoox Bet-semes rub'ihnaal re' inkiloq'ej i aj Egipto, tiko'q keh, inki Dios.</para>
  <chapter number="44" style="c" />
  <para style="s">Re' i xq'orarik keh ruum i Dios i aj Judío xiooj Egipto</para>
  <para style="p">
    <verse number="1" style="v" />Re' wili i k'uhb'aal xq'orarik reh i Jeremías ruum i Dios, reh chi xuq'or keh chu'nchel i aj Judío xiooj chi patinik ar Egipto, re' i xi patinik ar Migdo, ar Tafnes, ar Menfis, ar Patros je' wili i xuq'or keh: <verse number="2" style="v" />Re' QaJaaw Dios nim rajaawriik, i qaDios i hoj, hoj aj Israel je' wili xuq'or taq chawiij: Re' keh xkilow i runimaal ti' k'axik xnuyeew chikinaah i aj Jerusaleem, chikinaah i aj Judá, yu'naak ma' jino'q chik i k'achalkeeb' chupaam taqe i tinamit re' re'. <verse number="3" style="v" />Ruum i yiib' wach na'ojb'al xkian xkijosaj wach i nujosq'iil, ruum xkik'at i insensia, chi loq'oomb'al reh taqe tiyoox, ni xata re' keh, ni xata re' i kimaam kati't kieht'alinik wach. <verse number="4" style="v" />Eh ruum inki a'n re' re' xata wo' jarpech xnutaq'aaj cho chi kixilak i waj kamanoom reh chi xq'orarik keh chi naa kikanaam rub'aan i yiib' wach na'ojb'al re' re', ruum re' hin ma' mponik ta chi nuwach. <verse number="5" style="v" />Xa re' la' re' keh xama' xkib'iraj ta wo' hoq. Eh xama' xkikanaa' ta wo' rub'aan i yiib' wach na'ojb'al, xama' xkikanaa' ta wo' ruk'atariik i insensia chikiwach taqe i tiyoox. <verse number="6" style="v" />Ruum aj re', re' hin yohb'aal wach noq xqop i nujosq'iil chikinaah i xi patinik chupaam taqe i tinamit i Judá, chikinaah i xi wihik pantaq xilak b'eeh reh i Jerusaleem. Eh xsacharik kiwach xkahnik chi xan tz'irik chik paam, eh je' re' xkahnik chi jumpech. <verse number="7" style="v" />Eh re' QaJaaw Dios nim rajaawriik, qaDios i hoj, hoj aj Israel je' wili i xuq'or taq chawiij: ¿Chib'ih reet noq inki a'n i yiib' wach na'ojb'al, eh ti' k'axik i ruk'am cho chikinaah? Eh ruum taqe i re' naa rusahchiik kiwach i aj Judá chi winaq, chi ixoq, chi k'ijool, chi qahxoq, chi koch'uch' kipaam, ma' jino'q chik i naa rukahniik. <verse number="8" style="v" />¿Chib'ih reet noq inkijosaj wach i nujosq'iil ruuk' i kina'ojb'al ruuk' i k'ataj insensia chikiwach i tiyoox ayu' Egipto re' i xi chalik wih-oq wii'? Eh ruum i re' naa rusachariik kiwach, naakikahnik chi ma' xta chik kajaawriik, chu'nchel i wilkeeb' pan nimaq tinamit ma' holohik ta naa kiq'oriik chikiij. <verse number="9" style="v" />¿Mi xsahchik pankik'ux re' chib'ih i yiib' wach na'ojb'al xuk'am chaloq xkian chee i kimaam kati't, i yiib' wach na'ojb'al xkian i xi wihik cho chi reyil ar Judá, i xkian i kehk'een i yiib' wach na'ojb'al xkian i keh, i xkian i kehk'een paruyuq'ul i Judá, eh xilak taq b'eeh reh i tinamit Jerusaleem? <verse number="10" style="v" />Eh yu'naak i keh xama' inkijal ta wo' wach i kina'ojb'al, xama' kinkiyohleej ta wo' hoq. Eh xama' nkik'am ta wo' naah i kitijiik, i nuk'uhb'aal xnuq'or keh i kimaam kati't, eh xnuq'or wo' kekeh.</para>
  <para style="p">
    <verse number="11" style="v" />Ruum aj re' re' hin i Dios nim wajaawriik, ki Dios i aj Israel je' wili nuq'or: Re' hin naa nuye'em i ti' k'axik chikinaah korehtaal i nusach kiwach chu'nchel i aj Judá. <verse number="12" style="v" />Eh re' taqe i ruqox i aj Judá xiooj chi patinik ar Egipto, naa wo' rusachariik kiwach ar chi jumpech. Eh chu'nchel naa rusachariik kiwach chi nimaq chi kok' taq, naa rukuxiik kikimiik ruum i q'aq'inik, ruum i wi'jaleel, ma' holohik taj i naa ruq'orariik chikiij naa kikahniik chi ma' xta kajaawriik, ti yo'joq ruum i naakik'ulum. <verse number="13" style="v" />Re' taqe i aj Judá xiooj chi k'acharik Egipto naa nuye'em taqe panti' k'axik, je' rukab' noq xnuyeew taqe panti' k'axik i aj Jerusaleem, noq xnuyeew i q'aq'inik, wi'jaleel, i yab'ilaal chikinaah. <verse number="14" style="v" />Eh re' i kiqox i aj Judá xiooj chi k'achariik ar Egipto, ma' awach ta keh i naa ruko'leem riib', ma' jino'q chik keh i naa rukahniik chi k'achlik. Ma' awach ta chik jino'q i naa rusutiniik cho chi k'acharik Judá, wila' wilik kiib' ixib'-oq inkaaj chalik xakeb'an chik kiib' naa kichaliik, inki i Dios, inki Jeremías.</para>
  <para style="p">
    <verse number="15" style="v" />Eh chu'nchel i keht'al chi re' i kehk'een inkik'at i insensia chuwach taqe i tiyoox, wilik taqe ixoq wilkeeb' ar xiik' naah kik'ihaal noq xkimol kiib'. Eh haa' taqe i aj Judío xiooj chi k'acharik pansak'aaj reh i rookb'aal q'iij ar Egipto, je' wili ruchaq'weesjiik i Jeremías xkian: <verse number="16" style="v" />Re' taqe i xaq'or qeh chi re' i QaJaaw xq'orik aweh xama' naa ta wo' qanimam aweh. <verse number="17" style="v" />Naa la' qa'nam taqe i qaq'orom ruuk' aachii', naa qak'atam i insensia chuwach i qa ixoq tiyoox rehtalil i reey pan taxaaj, naa qajalk'iim ink'ohnik laj iq'oom chuwach. Je' rukab' i qa'nam, je' rukab' i xkian chee qamaam qati't, i xkian chee qa reey, i xkian k'amal qab'eeh, chupaam taqe i tinamit wilkeeb' Judá, je' rukab' inki a'n xilak taq b'eeh Jerusaleem. Eh noq inqa a'n taqe chee re' xa eliik wilik qawa' qahaa' qoh elik korik ruuk' taqe inqa a'n, eh ma' xta ti' k'axik inchalik chi qanaah. <verse number="18" style="v" />Xa re' wo' noq xqakanaa' ruk'atariik i insensia, xqakanaa' ruye'ariik ink'ohnik laj iq'oom chuwach i qa ixoq tiyoox rehtalil i reey pan taxaaj xoj kahnik chi ma' xta chik wilik qeh. Re' taqe i qatinamiit xtohqik kikimiik ruum q'aq'inik, eh ruum wi'jaleel. <verse number="19" style="v" />Re' taqe ixoq je' wili i xkiq'or: Re' hoj inqayejaa' wo' naq qakaxlanwi'k je' ruwii' i qa ixoq tiyoox rehtalil i reey pan taxaaj, inqak'at wo' naq i insensia inqayeew wo' naq ink'ohnik laj iq'oom chuwach. Eh chu'nchel inqa a'n re' re' qaq'orom reh i qab'ahiil, eh ma' naa ta qakanaam rub'aan, inki taqe.</para>
  <para style="p">
    <verse number="20" style="v" />Eh re' i Jeremías xuchaq'weej taqe chu'nchel i winaq, chu'nchel ixoq xichaq'winik reh chi je' re', je' wili i xuq'or keh: <verse number="21" style="v" />¿Mi nakapaaj taq re' hat chi re' i QaJaaw Dios ma' reht'al taj, chi sahchinaq paruk'ux, chi re' taq i hat, chi re' taqe aamaam awati't, chi re' taqe i reey, chi re' taqe i k'amal taq ab'eeh, taqe i tinamit xkik'at i insensia chikiwach taqe i tiyoox chupaam taqe i tinamit wilkeeb' i Judá, je' wo' xilak taq b'eeh Jerusaleem? <verse number="22" style="v" />Re' i QaJaaw Dios ma' xukuy ta chik nik'-oq najtiil i yiib' wach na'ojb'al taq xa a'n, re' reh ma' xponik ta chuwach. Ruum aj re', re' taqe aatinamiit xsacharik wach ma' jino'q chik patineel xkahnik chupaam, je' re' xkahnik chi jumpech. Eh xkahnik chi ma' holohik ta chik kiq'orik chi riij, ti yo'joq ruum i xuk'ul. <verse number="23" style="v" />Re' i runimaal ti k'axik xchalik taq cha naah re' re' ruum chi xak'at taq i insensia chikiwach taqe i tiyoox ruuk' i re' xat mahkunik taq chuwach i QaJaaw Dios. Eh ruum chi ma' xanimaj ta taq i xatrutijej wii', ma' xanimaj ta taq i xuq'or taq aweh, eh ruum chi ma' xa a'n ta taq i ruq'or taqe i ruk'uhb'aal, inki Jeremías.</para>
  <para style="p">
    <verse number="24" style="v" />Eh je' wili i xuq'or keh i tinamit, keh ixoq: Chab'iraj taq i ruk'uhb'aal i Dios naa taq nuq'orom aweh chawunchelaal taq i hat aj Judá, i k'acharik taq i na a'n ar Egipto. <verse number="25" style="v" />Re' QaJaaw Dios nim rajaawriik, i qaDios i hoj, hoj aj Israel je' wili i ruq'or taq chawiij: Chi re' keh, chi re' i kehk'een aha' wilik inkiq'or ruuk' kichii' chi naa kianaam inki a'n inkiq'or: Re' hoj qaq'orom chik chi naa qak'atam i insensia chi naaqaye'em ink'ohnik laj iq'oom chuwach i qa ixoq tiyoox rehtalil i reey pan taxaaj, korehtaal inqa a'n i qaq'orom, inki taqe. Ma' xta reet kian i kiq'orom. <verse number="26" style="v" />Xa re' la' kib'iraj chi kunchelaal i aj Judá k'acharik inki a'n Egipto i naa nuq'orom chi je' wili: Xti nuq'or i korik ruuk' i runimaal wach i nub'ihnaal chi ma' jino'q chik keh i aj Judá naa ruq'orariik i kib'ihnaal chupaam chu'nchel i ruyuq'ul i Egipto. Xa ma' xta chik inki chi neenkiq'or chi je' wili: K'achlik i Dios nee qohrutoob'eej, inko'q taqe. <verse number="27" style="v" />Ruum re' hin naa nutaq'aam chaloq i runimaal ti' k'axik chikinaah i aj Judá wilkeeb' paruyuq'ul i Egipto. Ma' re' ta holohik i naa nuye'em chikinaah, je' re' noq naa rukuxiik kikimiik ruum q'aq'inik, ruum wi'jaleel. <verse number="28" style="v" />Ach kiib' ixib' naakiko'leem kiib' chuwach i kimiik ruum q'aq'inik naa wo' chik keliik reje paruyuq'ul i Egipto, eh naa wo' chik kisutiniik reje Judá. Eh chu'nchel i aj Judá wilkeeb' chi k'acharik ar Egipto naakilom aha' wilik i naa rojiik eloq wach, mi re' i xnuq'or i hin, oon re' i xkiq'or i keh. <verse number="29" style="v" />Re' hin i Dios re' wili i rehtalil naa nuye'em chikiwach, naab'al reh chi narojiik eloq wach chi naa nuye'em ti' k'axik chikinaah chupaam i tinamit wilkeeb' wii'. <verse number="30" style="v" />Re' chi re' hin naa nuq'asam i Hofra kireey i aj Egipto pan kiq'ab' i nixowanik wach inkaaj rukanteesjiik. Je' rukab' noq xnuq'asaj i Sedequías xwihik chi kireey i aj Judá pan q'ab' i inixowanik wach re' Nabucodonosor kireey i aj Babilonia re' wo' hoq i xkansanik reh, inki Dios, inki.</para>
  <chapter number="45" style="c" />
  <para style="s">Re' i ruq'oral i Dios xq'orarik cho reh i Baruc</para>
  <para style="p">
    <verse number="1" style="v" />Re' i k'uhb'aal wili xuq'or i Jeremías reh i Baruc, re' noq kijib' chik haab' rokiik chi reyil ar Judá i Joacim rak'uun i Josías, eh re' noq re' i Baruc xtz'ihb'anik reh i ruq'oral i Dios xq'orarik reh ruum i Jeremías. <verse number="2" style="v" />Eh je' wili i xuq'or: Re' i hat Baruc je' wili i ruq'or cho chawiij i QaJaaw re' i ki Dios i aj Israel. <verse number="3" style="v" />Re' reh je' wili i ruq'or: Re' hin ma' k'isiin i ti' k'axik k'ahchi' nuk'ulum re' i Dios xutiq cho naah i ti' k'axik chi nunaah ma' xta chik rusuqkiil nuk'ux xinq'uhtik chik chi oq'ik, inki. <verse number="4" style="v" />Re' i QaJaaw Dios je' wili i xuq'or weh: Re' hat i cha q'or reh i Baruc chi re' hin i nusach wo' chik wach taqe i nuyejaa', eh inwesaj pan kiye'aab' taqe i nuch'ikaam pan kiye'aab', je' wo' re' i naa nub'anam ruuk' chu'nchel i wach ak'al wili. <verse number="5" style="v" />Re' reh xaraaj rusik'im runimaal wach xa ree reh chi rib'il riib', maruk'ul ta chi nee rusik' i re' ruum re' hin naa nuye'em i runimaal ti' k'axik chinaah chu'nchel i tinamit. Xa re' la' re' hin naa nuko'leem riij i ruk'achariik i reh xa aha' pa' yuuq' nenooj i k'oq, inki Dios.</para>
  <chapter number="46" style="c" />
  <para style="s">Re' noq xb'aan keh i aj Egipto chupaam i ye'aab' Carquemis</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios xuq'or cho reh i Jeremías jalal ruq'oral chib'ih xub'an kuuk' i ju'jun seht chi tinamit.</para>
  <para style="p">
    <verse number="2" style="v" />Je' wili i xuq'or chi riij i tinamit Egipto, chikiij i ru soldado Nacao kireey i aj Egipto wilkeeb' chupaam i ye'aab' Carquemis, wilik ma' najt ta ruuk' i nim ha' Éufrates. Re' taqe i xb'aan keh ruum i Nabucodonosor kireey i aj Babilonia noq kijib' chik haab' rokiik chi reyil ar Judá i Joacim rak'uun Josías.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh je' wili xuq'or:</para>
  <para style="q">Chayejaa' taq i nimlaj pulato ch'ihch' ko'lemb'al awiib'</para>
  <para style="q">hiy taq chak'ulb'ilej taqe i aj ixowaal.</para>
  <para style="q">
    <verse number="4" style="v" />Eh chakoj taq rihqb'aal aakawayu johteen taq chi riij</para>
  <para style="q">chakoj taq ach'ihch' puneet, ach'ihch' so'</para>
  <para style="q">chatus taq awiib'</para>
  <para style="q">chajuk' taq ach'ihch', inki.</para>
  <para style="q">
    <verse number="5" style="v" />Eh noq xwilow xi sutinik wo' chik xb'aan keh.</para>
  <para style="q">Eh re' i ki soldado,</para>
  <para style="q">ma' xkikuy taj i q'aq'inik.</para>
  <para style="q">Eh xkimol chi elik xkitukej kiib' ma' kota chik xitz'ehtanik cho chikiij,</para>
  <para style="q">ma' k'isiin i kiyo'jiik xa aha' yuuq', inki QaJaaw Dios.</para>
  <para style="q">
    <verse number="6" style="v" />Xa ma' kow ta wo' kiajiminik,</para>
  <para style="q">eh xama' xkiko'leej ta wo' kiib' i xti kow naq inki a'n kiib'.</para>
  <para style="q">Ar la' xiooj q'ehb'oq chi chii' i nim ha' Éufrates,</para>
  <para style="q">i wilik reje pantz'eet reh i rokb'aal i q'iij.</para>
  <para style="q">
    <verse number="7" style="v" />¿Awach taqe i soldado re' re' yohb'aal wach kikowiil inki a'n kiib'</para>
  <para style="q">xa je' chik rukab' i choqik i rub'an i nim ha' Nilo?</para>
  <para style="q">
    <verse number="8" style="v" />Re' taqe re', re' i ki soldado i aj Egipto,</para>
  <para style="q">re' choqik inki a'n je' rukab' i rub'an i nim ha' Nilo,</para>
  <para style="q">je' wili inkiq'or: Re' hoj naa qak'ihaaxb'iik naa qanujisam naah i wach ak'al.</para>
  <para style="q">Naa qasacham kiwach tinamit, je' wo' taqe i k'achareel chupaam, inki taqe.</para>
  <para style="q">
    <verse number="9" style="v" />Kichaloq i aj q'aq'ineel wilkeeb' chi riij i kawáyu,</para>
  <para style="q">i wilkeeb' pan kareta i xa chi kooq xi chalik,</para>
  <para style="q">kichaloq i kow kiib' chi q'aq'inik, je' wo' i ki soldado i aj Put,</para>
  <para style="q">kik'am cho kipulato ch'ihch',</para>
  <para style="q">kichaloq i ki soldado i aj Lud,</para>
  <para style="q">re' taqe i kichol rutz'a'jiik i flecha.</para>
  <para style="q">
    <verse number="10" style="v" />Ruum chupaam i q'iij re' re' naa ruq'ajam wach i QaJaaw Dios nim rajaawriik</para>
  <para style="q">keh i aj Egipto i nixowanik wach,</para>
  <para style="q">re' q'aslaj ch'ihch' naa runujiik chi kik'</para>
  <para style="q">naa rukuxiik ru kansam taqe.</para>
  <para style="q">Ruum re' QaJaaw Dios,</para>
  <para style="q">ma' k'isiin ikaansanik naa rub'anam</para>
  <para style="q">pantz'eet reje reh i rookb'aal i q'iij</para>
  <para style="q">ma' najt ta ruuk' i nim ha' Éufrates,</para>
  <para style="q">je' mayijimaj chikop taqe chi reh.</para>
  <para style="q">
    <verse number="11" style="v" />Re' taq i hat aj Egipto, i je' taq akab' i k'isa q'ahxoq,</para>
  <para style="q">naa naq rojiik asik'im aawiq'oom Galaad.</para>
  <para style="q">Atoob' ta ma' k'isa iq'oom taq i nee nakoj xama' xta wo' neerutiq taq aweh,</para>
  <para style="q">ruum ma'iq'oom ta wo' chik iraaj taq aati'kiil.</para>
  <para style="q">
    <verse number="12" style="v" />Re' taqe i nimaq tinamit naa kinab'eem chi xb'aan taq aweh.</para>
  <para style="q">Eh naa rib'irjiik chupaam i tinamit wach ak'al</para>
  <para style="q">chi naa taq ak'erem aachii'.</para>
  <para style="q">Eh re' taqe i a soldado q'e' kow kiib'</para>
  <para style="q">k'ul naakiq'ojom kiib' naa kiq'ehb'iik wach ak'al, inki Dios.</para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" />Re' QaJaaw Dios xuq'oreej i Jeremías jalal ruq'oral, noq ojik chik i rub'an i Nabucodonosor kireey i aj Babilonia chub'anariik keh i aj Egipto je' wili i xuq'or reh:</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Cha q'oreej taqe i aj Egipto,</para>
  <para style="q">aj Migdol, i aj Menfis, aj Tafnes, chi je' wili:</para>
  <para style="q">Chawikraaj taq awiib', cha yejaa' taq awiib'</para>
  <para style="q">ruum yohb'aal wach ikaansanik k'ahchi'</para>
  <para style="q">ruuk' i q'aslaq ch'ihch' taq cha junsuut, tiko'q keh.</para>
  <para style="q">
    <verse number="15" style="v" />¿Chib'ih reet noq xumol chi elik inye'wik taq rukowiil ak'ux inaq'or?</para>
  <para style="q">Xumol chi elik ruum re' hin i Dios xineesanik i rajaawriik.</para>
  <para style="q">
    <verse number="16" style="v" />Re' i ki soldado</para>
  <para style="q">k'ul nakiq'ehb'iik chikinaah chi kib'il kiib',</para>
  <para style="q">je' wili i naa kiq'orom: Qoh eloq reje</para>
  <para style="q">ayu' taq wo' taq chik panqatinamiit xoj-aasjik cho wii',</para>
  <para style="q">qamol reje chi elik chuwach i q'aq'inik wili, inkoq taqe.</para>
  <para style="q">
    <verse number="17" style="v" />Re' taq i hat naa taq akojom</para>
  <para style="q">rukab' i b'ih i kireey i aj Egipto chi je' wili:</para>
  <para style="q">Xa q'e' inq'orik, eh xama' xta wo' rub'an, tiko'q taq reh.</para>
  <para style="q">
    <verse number="18" style="v" />Eh re' hin i Dios k'achalkiin chi juneliik, wilik wajaawriik i nub'ihnaal.</para>
  <para style="q">Eh re' taqe i aj ixowaal naa ruchaliik chikinaah i aj Egipto,</para>
  <para style="q">xiik' naah nimaal wach ma' xata je' najtiil</para>
  <para style="q">naah i yuuq' Carmelo, wilik chi chii' i palaw.</para>
  <para style="q">
    <verse number="19" style="v" />Re' taq i hat i aj Egipto cha yejaa' taq chib'ih aweh reh ojik,</para>
  <para style="q">ruum re' i tinamit Menfis</para>
  <para style="q">naa rukahniik chi je' rukab' i chiq yuuq',</para>
  <para style="q">naa rukahniik chi ma' jino'q chik patineel chupaam.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Re' taqe i aj Egipto je' wo' naq kiholwochiil i q'ahxoq wakax.</para>
  <para style="q">Xa re' la' naa ruk'uliik b'anroq keh kuum i aj ixowaal</para>
  <para style="q">naa kichaliik pantz'eet reh i rookb'aal i q'iij.</para>
  <para style="q">
    <verse number="21" style="v" />Re' i ki soldado xa q'ina' wo' naq chik taqe,</para>
  <para style="q">xa je' chik kiq'ina'hiil i rak'uun wakax,</para>
  <para style="q">xa re' la' xama' naa ta wo' kikuyum ransil taqe i aj ixowaal.</para>
  <para style="q">Eh naakimolom chi elik ruum</para>
  <para style="q">naa ruchaliik i</para>
  <para style="q">runimaal ti' k'axik chikinaah chi tojb'al kimahk.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Re' taqe i aj Egipto naakimolom chi elik,</para>
  <para style="q">je' rukab' noq i rumol chi elik i mama' aaq'.</para>
  <para style="q">Eh noq naa ruk'uliik iloq i ki soldado i aj ixowaal chikinaah</para>
  <para style="q">naa ruyok'ariik i kinaah chi ikej je' kiyok'arik sii' naa rub'aan.</para>
  <para style="q">
    <verse number="23" style="v" />Eh je' kiyok'arik rax chee' naa rub'aan,</para>
  <para style="q">xa je' chik kik'ulik iloq ruk'ihaal nimaq chili'l</para>
  <para style="q">noq naa kik'uliik iloq i aj ixowaal chikinaah</para>
  <para style="q">ma' awach ta naa rukuywiik kajaljiik.</para>
  <para style="q">
    <verse number="24" style="v" />Re' taqe i aj Egipto naa rehtesjiik i kajaawriik,</para>
  <para style="q">naa ruchopariik kinaah ruum i tinamit wilik</para>
  <para style="q">reje pantz'eet reh i rookb'aal i q'iij, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" />Re' i QaJaaw Dios nim rajaawriik, qaDios i hoj, hoj aj Israel, je' wili i xuq'or: Re' hin naa nuye'em i ti' k'axik chikinaah i aj Amón, inkikoj chi ki dios i aj Tebas, chikinaah i aj Egipto, chinaah i kireey, je' wo' taqe inkiyeew kik'ux ruuk'. <verse number="26" style="v" />Eh naa nuye'em q'ab' chi naa ruchopariik kinaah kuum i aj kaansoom i nixowanik kiwach, re' i Nabucodonosor kireey i aj Babilonia, naa wo' nuq'asam taqe pan kiq'ab' i ru soldado. Xa re' la' naa wo' chik ruponiik i q'iij chi naa kiwihiik k'achareel ar Egipto, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Re' taq i hat aj Israel,</para>
  <para style="q">riih rumaam i Jacob</para>
  <para style="q">hat taq waj kamanoom mat yo'jik taq,</para>
  <para style="q">ruum re' hin naa taq kaat wesam chee hat,</para>
  <para style="q">taqe awak'uun awixq'uun chupaam inajt tinamit xat k'amarik taq reje wii'.</para>
  <para style="q">Eh naa wo' chik taq aak'achariik pansuqkiil k'uxliis,</para>
  <para style="q">ma' xta chik naa ruyohb'isaniik taq aweh.</para>
  <para style="q">
    <verse number="28" style="v" />Matyo'jik taq i hat riih rumaam i Jacob hat taq waj kamanoom,</para>
  <para style="q">ruum re' hin taq aaDios naa nuwihiik taq awuuk'.</para>
  <para style="q">Eh naa nusacham kiwach i tinamit</para>
  <para style="q">re' i xnutukej taq reje wii' awach,</para>
  <para style="q">ma' naa ta nusacham taq awach i hat,</para>
  <para style="q">xanaa la' taq kaat nuye'em chutojariik riij taq amahk parub'ehel,</para>
  <para style="q">xa re' la' ma' naa ta wo' nukanaam</para>
  <para style="q">chi ma' naa ta taq atojom wach aamahk, inki.</para>
  <chapter number="47" style="c" />
  <para style="s">Re' i ruq'orariik rib'iral chib'ih i xkik'ul i aj filisteo</para>
  <para style="p">
    <verse number="1" style="v" />Re' i wili i ruq'oral i Dios xuq'or reh i Jeremías chikiij taqe i aj filisteo, noq komajaa' inchalik i kireey aj Egipto chub'anariik keh i aj Gaza.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Pantz'eet reh i rookb'aal i q'iij naa kik'uliik iloq i ruk'ihaal soldado</para>
  <para style="q">xa je' chik rukab' i choqik i rub'an i nim ha',</para>
  <para style="q">naa kisacham wach i xata wo' jarseht chi tinamiit,</para>
  <para style="q">ruch'ihil i k'achareel wilkeeb' chupaam.</para>
  <para style="q">Eh naakik'erem kichii' ruum i ti' k'axik naakik'ulum.</para>
  <para style="q">
    <verse number="3" style="v" />Eh noq naa kib'iram chi xa kitelikinik chik taqe i kikawayu</para>
  <para style="q">i ruk'ihaal soldado, eh xampolojinik chik</para>
  <para style="q">i kikareta ma' k'isiin ta naa kiyo'jiik taqe i tuutb'ees ajaab'ees</para>
  <para style="q">naakiq'eb'em kahnoq i kak'uun kixq'uun.</para>
  <para style="q">
    <verse number="4" style="v" />Ruum chupaam i q'iij re' re' naa rusachariik kiwach i aj filisteo,</para>
  <para style="q">aj Tiro, aj Sidón, korehtaal inkuxik</para>
  <para style="q">rusachariik kiwach intowik keh i aj filisteo, inki.</para>
  <para style="q">Re' i QaJaaw Dios naa rusacham kiwach i aj filisteo,</para>
  <para style="q">je' wo' chu'nchel i wilkeeb' chupaam i ye'aab' Kaftor.</para>
  <para style="q">
    <verse number="5" style="v" />Eh re' taqe i aj Gaza naa kijoyom i rismaal kinaah ruum i ruti'kiil kik'ux,</para>
  <para style="q">re' taqe i aj Ascalón naa kikahniik meem.</para>
  <para style="q">Re' taq i hat i wilkaat taq wach k'ixkaab'</para>
  <para style="q">¿Kojaruuj taq i namay ruyok'ariik wach taq ati'jolal?</para>
  <para style="q">
    <verse number="6" style="v" />Eh je' wili taq i naa aq'orom:</para>
  <para style="q">QaJaaw Dios, re' hat xataaq'anik cho qakanteesjiik ruuk' q'aslaj ch'ihch'.</para>
  <para style="q">Chayeew q'ab' chi neenkikanaa' qakanteesjiik ruuk' q'aslaj ch'ihch',</para>
  <para style="q">chawesaj chi qanaah, tiko'q taq.</para>
  <para style="q">
    <verse number="7" style="v" />Eh ¿nik' wach noq neeresaj taq cha naah</para>
  <para style="q">wila' re' wo' i QaJaaw xtaaq'anik taq cho akanteesjiik</para>
  <para style="q">kikanteesjiik i aj Ascalón,</para>
  <para style="q">kikanteesjiik i wilkeeb' pan tz'a'laj yuuq' chi chii' i palaw?</para>
  <chapter number="48" style="c" />
  <para style="s">Re' i ruq'orariik rib'iral chib'ih i xkik'ul i aj Moab</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios nim rajaawriik, qaDios i hoj, hoj aj Israel je' wili i ruq'or chikiij i aj Moab:</para>
  <para style="b" />
  <para style="q">Q'e' ketel kiwach i aj Nebo</para>
  <para style="q">ruum naa rusachariik kiwach,</para>
  <para style="q">je' wo' taqe i aj Quiriataim naa ruchopariik kinaah</para>
  <para style="q">naa kikahniik chi ma' xta chik kajaawriik</para>
  <para style="q">naa rehtesjiik i kikowiil.</para>
  <para style="q">
    <verse number="2" style="v" />Re' taqe i aj Moab ma' jaruuj chik</para>
  <para style="q">ruye'ariik runimaal kiwach, ruum i</para>
  <para style="q">Hesbón re' taqe i aj ixowaal kiyejaam chik wach chi naa kisacham wach i tinamit Moab.</para>
  <para style="q">Eh je' wo' taq i hat aj Madmena naa wo' rusachariik taq awach</para>
  <para style="q">ruuk' q'aq'inik.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Eh wilik i naakik'erem cho kichii' ar Horonaim, je' wili i naa kiq'orom:</para>
  <para style="q">Naa rusachariik wach i tinamit, inko'q taqe.</para>
  <para style="q">
    <verse number="4" style="v" />Re' taqe i aj Moab naa rusachariik kiwach,</para>
  <para style="q">eh noq naa ak'erem kichii' naa ruponiik ko ar Zoar.</para>
  <para style="q">
    <verse number="5" style="v" />Eh naa koq'iim awach i naakijohtiik nah yuuq' Luhit.</para>
  <para style="q">Eh naa koq'iim</para>
  <para style="q">awach i naakiqajiik cho Horonaim,</para>
  <para style="q">eh naa kib'iram i nixowanik kiwach.</para>
  <para style="q">
    <verse number="6" style="v" />Awach i nee ruyeew riib' chuwach chumol chi elik,</para>
  <para style="q">chuko'leej riib', je'-oq rukab' i k'iix wilik</para>
  <para style="q">pan chiq yuuq' ink'amarik reje ruum i teew.</para>
  <para style="q">
    <verse number="7" style="v" />Eh re' taq i hat aj Moab i xach'ikaa' taq ak'ux</para>
  <para style="q">chinaah taq ab'ehomal naa wo' ruchopariik taq anaah.</para>
  <para style="q">Re' taq atiyoox Quemos i kib'ih</para>
  <para style="q">naa wo' kik'amariik reje pan tokoom tinamit,</para>
  <para style="q">ruch'ihil taqe i k'amal kib'eeh aj tiij,</para>
  <para style="q">taqe i k'amal b'eeh.</para>
  <para style="q">
    <verse number="8" style="v" />Eh naa rusahchiik kiwach i wilkeeb' chupaam i ju'junseht chi tinamit,</para>
  <para style="q">ma' junseht i tinamit naa ruko'leem riib'.</para>
  <para style="q">Chi je' wilkeeb' wach k'ixkaab',</para>
  <para style="q">chi je' wilkeeb' chinaah taqe yuuq' naa rusachariik kiwach,</para>
  <para style="q">je' rukab' i xnuq'or.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Eh wilik ta naq kixiik' i aj Moab nee naq inkimol chi elik.</para>
  <para style="q">Eh jarseht i tinamit ruchopom naah naa rusachariik kiwach,</para>
  <para style="q">ma' jino'q chik i k'achareel naa kikahniik ar, inki Dios.</para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" />Eh je' wili i xuq'or: Re' hin naa nuye'em panti' k'axik awach i xakiib' ruk'ux i rub'an i nukamaj, je' wo' hoq awach ma' naa ta rajwaam kikantesjiik taqe i aj Moab.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Re' aj Moab eliik naq suq chee kik'achariik</para>
  <para style="q">ma' jank'al ta naq kik'amarik reje pan tokoom tinamit.</para>
  <para style="q">Xa je' naq kikab' i riis uuva</para>
  <para style="q">xa jinaj wilik wii' ma' q'ahteesjik ta reje chupaam i tokoom ye'aab' reh,</para>
  <para style="q">ruum i re' ma' inyoj ta naq wach i rusuqkiil, i ruk'ohonkiil.</para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" />Re' QaJaaw Dios je' wili xuq'or xponik chik i q'iij chi naa nutaq'aam taqe chaloq i aj ixowaal reh chi naa kik'amariik reje. Naa rub'aan keh je' rukab' imb'aan reh i riis uuva noq inehteesjik chupaam i ye'aab' reh chupaam chik i tokoom ye'aab' inye'arik, eh re' naq i wilik wii' impaxjik. <verse number="13" style="v" />Eh naakik'uhtaam kik'ixb'ilaal i aj Moab, ruum i runimjiik i kitiyoox Quemos i b'ih, je' rukab' noq xkik'uhtaaj kik'ixb'ilaal i aj Israel ruum i runimjiik i kitiyoox Bet-el i b'ih re' naq i ch'iklik wii' kik'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' taqe i aj Moab ma' naa ta chik kiq'orom chi je' wili:</para>
  <para style="q">Q'e' hoj kow wilik qajaawriik chi q'aq'inik, ma' ko'q ta chik taqe.</para>
  <para style="q">
    <verse number="15" style="v" />Eh naa ruponiik i sachal kiwach i aj Moab,</para>
  <para style="q">je' wo' hoq jarseht chi tinamit ruchopom naah.</para>
  <para style="q">Eh re' taqe i k'ijolaq naa kik'amariik pankimik,</para>
  <para style="q">inki Reey, i Dios nim rajaawriik.</para>
  <para style="q">
    <verse number="16" style="v" />Re' i rusachariik kiwach,</para>
  <para style="q">re' i ti' k'axik naakik'ulum i aj Moab</para>
  <para style="q">xailook' chik ink'uloq chikinaah.</para>
  <para style="q">
    <verse number="17" style="v" />Re' taq i hat wilkaat taq chi junsuut i Moab, aweht'al taq wach</para>
  <para style="q">chaketelaaj taq wach</para>
  <para style="q">ti oq'oq taq chi riij je' taq wili i cha q'or:</para>
  <para style="q">Ti xsacharik wach i rajaawriik,</para>
  <para style="q">eh xti holohik wo' naq, tiko'q taq.</para>
  <para style="q">
    <verse number="18" style="v" />Re' taq i hat aj Dibón,</para>
  <para style="q">na taq atzunaam awiib' wach chiq ak'al ruum naa rehtesjiik taq awajaawriik,</para>
  <para style="q">ruum xi chalik wo' chi rusachariik taq awach i hat</para>
  <para style="q">i xi chalik chi rusachariik kiwach i aj Moab.</para>
  <para style="q">Eh naa rusachariik kiwach inako'leej taq wii' awiib'.</para>
  <para style="q">
    <verse number="19" style="v" />Re' taq i hat aj Aroer</para>
  <para style="q">naa taq awilom naa taq apab'aam awiib' chii' b'eeh,</para>
  <para style="q">naa taq apahqaam keh</para>
  <para style="q">i konaakikahniik chi k'achalkeeb' chib'ih i xk'ularik.</para>
  <para style="q">
    <verse number="20" style="v" />Eh noq naa ruk'ulariik naa taq awilom chi re' taqe i aj Moab,</para>
  <para style="q">esamaj chik i kajaawriik, eh naa kiyo'jiik, naa taq awoq'iim chikiij.</para>
  <para style="q">Naa taq aq'orom chi chii' i nim ha' Arnón,</para>
  <para style="q">chi xsacharik kiwach i aj Moab, inki Dios.</para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" />Eh xponik chik i ruq'ijil i ti' k'axik chi naa ruchaliik, chikinaah i aj wach k'ixkaab', chikinaah i aj Holón, i aj Jahoza, i aj Mefáat. <verse number="22" style="v" />Eh naa wo' ruchaliik chikinaah i aj Dibón, chikinaah i aj Nebo, chikinaah i aj Bet-diblataim. <verse number="23" style="v" />Eh chikinaah i aj Quiriataim, chikinaah i aj Bet-gamul, chikinaah i aj Bet-meón. <verse number="24" style="v" />Naa wo' ruchaliik chikinaah i aj Queriot, chikinaah i aj Bosra, chikinaah i jarseht chi tinamit ruchopom naah i tinamit Moab chi je' wilkeeb' chi najt chi ma' najt. <verse number="25" style="v" />Re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="b" />
  <para style="q">Re' taqe i aj Moab naa kikahniik chi ma' xta chik kikowiil,</para>
  <para style="q">chi ma' xta chik kajaawriik, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Re' i aj Moab</para>
  <para style="q">je' nanaa kixohk'resjiik ruum i Dios,</para>
  <para style="q">je' na naakitolem kiib' pankixab'iik,</para>
  <para style="q">eh chu'nchel i tinamit naa rukaqse'laniik keh.</para>
  <para style="q">
    <verse number="27" style="v" />Eh re' taq i hat aj Moab xanaa kaqse'laaj naq taqe i aj Israel,</para>
  <para style="q">inawixowaaj naq taq kiwach,</para>
  <para style="q">ma' holohik ta taq ti' q'orik chikiij,</para>
  <para style="q">xakoj taqe chi ajileq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Re' taq i hat aj Moab eleen taq reje chupaam i tinamit,</para>
  <para style="q">hiy taq cha sik' aa ye'aab' pantaq ruhopil ab'aj,</para>
  <para style="q">je' rukab' inki a'n i paloma</para>
  <para style="q">inooj kiyejaa' kisuuq' chi chii' taqe i ruhopil ab'aj.</para>
  <para style="q">
    <verse number="29" style="v" />Re' hoj qeht'al noq re' taqe i aj Moab q'e' inkinimb'isaj kiib',</para>
  <para style="q">xa nimaq chik kiwach inki a'n kiib',</para>
  <para style="q">chi xakow kiq'orik,</para>
  <para style="q">chi xama' awach taj imponik panaq'kiwach.</para>
  <para style="q">
    <verse number="30" style="v" />Re' QaJaaw Dios reht'al wo' hoq chi xa q'e' nim kiwach inki a'n kiib',</para>
  <para style="q">eh xa re' nimaq wach i q'orik inkiq'or,</para>
  <para style="q">je' wo' hoq i josq'iil inki a'n</para>
  <para style="q">
    <verse number="31" style="v" />Re' hin q'e' ti' naawik'raam,</para>
  <para style="q">naawoq'iim chikiij chu'nchel i aj Moab,</para>
  <para style="q">je' wo' chikiij i aj Qir-hares.</para>
  <para style="q">
    <verse number="32" style="v" />Re' taq i hat aj Sibma q'e' naawoq'iim taq chawiij</para>
  <para style="q">ma' xata je' rukab' oq'ik xb'aan chikiij i aj Jezer,</para>
  <para style="q">re' taq aa-uuva ma' naa ta chik ruwachiniik.</para>
  <para style="q">Eh komponik wo' naq chi chii' i taqe palaw taq aa-uuva.</para>
  <para style="q">Eh yu'naak naa rusachariik taq wach aa-uuva.</para>
  <para style="q">
    <verse number="33" style="v" />Ma' awach ta chik i naa ruk'erem chii' ruum rusuqkiil ruk'ux</para>
  <para style="q">chupaam taqe i ye'aab' tikooj wii' i uhtz'ub' ar Moab.</para>
  <para style="q">Re' i riis i uuva naa ruk'uhliik chupaam i molarik wii',</para>
  <para style="q">ma' awach ta chik naa ruyeq'wiik paam i uuva pan yitz'b'al reh.</para>
  <para style="q">Ma' awach ta chik naa rub'anam rutz'uuy.</para>
  <para style="b" />
  <para style="p">
    <verse number="34" style="v" />Naa la' kik'erem kichii' ruum i ti' k'axik i aj Hesbón, korehtaal inib'irjik ar Eleale, ar Jahaza, ar Zoar, ar Horonaim, eh ar Eglat-selesiya. Eh naa kichiqiik taqe raasb'al ha' wilkeeb' Nimrim.</para>
  <para style="p">
    <verse number="35" style="v" />Re' QaJaaw Dios je' wili xuq'or: Re' hin naa nusacham kiwach i aj Moab, kijohtik chinaah taqe i yuuq' chu k'atarik insensia, chuk'atariik i chikop chi kimayiij chikiwach taqe i tiyoox, inki. <verse number="36" style="v" />Ruum aj re', re' hin xtikinoq'ik chikiij i aj Moab, je' wo' chikiij taqe i aj Qir-hares. Re' taqe xuul narib'irjiik xa reh chik muq'anik, eh re' i kib'ehomal kimolom wach naa rusachariik wach chi jumpech. <verse number="37" style="v" />Eh chi kunchelaal naa kijoyom i rismaal kinaah, ruum ruti'kiil kik'ux, naa kijoyom i kusinchii', naakiyok'om wach i kiq'ab', naa kikojom chikiij i q'as wach itz'ihy.</para>
  <para style="p">
    <verse number="38" style="v" />Re' QaJaaw Dios je' wili xuq'or: Re' taqe i aj Moab, naakik'erem cho kichii' chi oq'ik nah kipaat. Eh naa koq'iim xilak taq b'eeh, ruum re' hin naa nusacham kiwach, je' kipaxik ak'al ikom naa nub'anam taqe, inki. <verse number="39" style="v" />Re' taqe i aj Moab naa koq'iim ruum i ti' naakik'ulum, xama' xta chik i naa kianam, naakik'uhtaam kik'ixb'ilaal, xama' xta chik kikamaj naa kikahniik, xama' xta chik kajaawriik naa kikahniik chikiwach taqe i wilkeeb' chi kijunsuut.</para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" />Ruum re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="q">Re' taqe i aj ixowaal naa kikutum kiib' chikinaah i aj Moab,</para>
  <para style="q">xa je' chik rukab' noq i ruhe' paam i ruxiik' i xihk noq i ruchop i rutiib'.</para>
  <para style="q">
    <verse number="41" style="v" />Re' taqe i ju'jun seht chi tinamit re' i nimaq paat inkiko'leej wii' kiib'</para>
  <para style="q">naa kichopom naah i aj ixowaal.</para>
  <para style="q">Eh re' taqe i kaj q'aq'ineel i aj Moab ma' naa kiyo'jiik,</para>
  <para style="q">xa je' chik rukab' ixoq noq ink'ulik ruk'ux.</para>
  <para style="q">
    <verse number="42" style="v" />Re' taqe i aj Moab naa rusachariik wach i kitinamiit,</para>
  <para style="q">i korehtaal inkahnik chi ma' xta chik wilik chupaam,</para>
  <para style="q">ruum q'e' xkinimb'isaj kiib' chi nuwach.</para>
  <para style="q">
    <verse number="43" style="v" />Re' taqe i aj Moab naakisik'ariik kuum i aj ixowaal</para>
  <para style="q">je' rukab' noq insik'arik i chikop kuum i aj puhb',</para>
  <para style="q">xanik' neekiq'ehb'ik panjul, oon pan xirob'.</para>
  <para style="q">
    <verse number="44" style="v" />Re' taqe i chikop ma' imb'aan ta keh chi puhb' kiooj q'ehb'oq panjul,</para>
  <para style="q">eh noq i kielik cho panjul kiooj q'ehb'oq pan xirob'.</para>
  <para style="q">Je' wo' re' i naakik'ulum i aj Moab ma' naa ta</para>
  <para style="q">rik'iik chikiij chi ma' naa rub'aan keh,</para>
  <para style="q">ruum re' hin naa nuye'em i ti' k'axik chikinaah,</para>
  <para style="q">inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="45" style="v" />Eh wilik i naakimolom chi elik chi ma' xta chik kaansil</para>
  <para style="q">naa naq rojiik kikeb'aam kiib' pan tinamit Hesbón,</para>
  <para style="q">eh re' i tinamit re' re' naa ruqopariik ruq'aq'al,</para>
  <para style="q">eh naa ruk'atam chu'nchel i ruyuq'ul i Moab,</para>
  <para style="q">haa' taqe i patineel wilkeeb' ar ruum ma' kinimanik taj.</para>
  <para style="q">
    <verse number="46" style="v" />Hat taq aj Moab, i hat taq rutinamiit i Quemos</para>
  <para style="q">q'e' taq ti' i naa ak'ulum ruum naa rusachariik taq awach.</para>
  <para style="q">Q'e' wo' chik ti' ruum re' taq awak'uun awixq'uun</para>
  <para style="q">naa kik'amariik reje pan tokoom tinamit.</para>
  <para style="q">
    <verse number="47" style="v" />Eh noq naa rojiik kuxoq</para>
  <para style="q">naa wo' chik wesam taqe cho panti' k'axik i aj Moab.</para>
  <para style="q">Re' wili korik ruum re' hin kiq'orik, inki Dios.</para>
  <para style="b" />
  <para style="q">Re' taqe i ti' k'axik wili naa ruye'em chee Dios chikinaah i aj Moab.</para>
  <chapter number="49" style="c" />
  <para style="s">Re' noq xq'orarik cho rib'iral chib'ih xkik'ul i aj Amonita</para>
  <para style="p">
    <verse number="1" style="v" />Re' i QaJaaw Dios je' wili i xuq'or chikiij i aj Amón:</para>
  <para style="b" />
  <para style="q">Hat taq aj Israel</para>
  <para style="q">¿Mi ma' re' naq re' taqe awak'uun awixq'uun naa kehchaniik reh i ye'aab' wili?</para>
  <para style="q">¿Chib'ih reet noq re' chik taqe aj Amón kiloq'inik reh i tiyoox Milcom</para>
  <para style="q">b'ih xichopwik naah i ye'aab' Gad,</para>
  <para style="q">je' wo' chu'nchel i kitinamiit i aj Israel?</para>
  <para style="q">
    <verse number="2" style="v" />Xa re' la' naa wo' chikruponiiki q'iij</para>
  <para style="q">chi naa nuye'em q'ab' chi re' taqe i aj Amón,</para>
  <para style="q">taqe i aj Rabá naakik'erem kichii'</para>
  <para style="q">ruum naa ruchaliik i q'aq'inik chikinaah,</para>
  <para style="q">naa rusachariik kiwach taqe i kitinamiit.</para>
  <para style="q">Eh re' keh naakik'atariik,</para>
  <para style="q">re' taqe i aj Israel naa wo' chik kichopom naah i kiye'aab',</para>
  <para style="q">inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Re' taq i hat aj Hesbón naa taq rutib'iik ak'ux</para>
  <para style="q">ruum re' taqe i aj Hai naa rusachariik kiwach.</para>
  <para style="q">Eh re' taq i hat aj Rabá naa taq ak'erem aachii' chi oq'ik,</para>
  <para style="q">naa taq akojom aq'as wach so' chawiij.</para>
  <para style="q">Eh k'ul taq naa awojiik, ruum re' taq aatiyoox Milcom i b'ih</para>
  <para style="q">naa ruk'amariik reje pan tokoom tinamit, kuch'ihil taqe i k'amal b'eeh aj tiij,</para>
  <para style="q">taqe i k'amal kib'eeh.</para>
  <para style="q">
    <verse number="4" style="v" />¿Chib'ih reet noq inanimb'isaj taq awach ruuk' akowiil?</para>
  <para style="q">re' taq aakowiil xanaa rik'iik wach taq i hat i ma' tinimanik ta taq.</para>
  <para style="q">Eh i nayeew taq ak'ux chinaah ab'ehomal, je' taq wili inaq'or:</para>
  <para style="q">¿Mi wilik jino'q i neenk'ulik b'anoq qeh i hoj? tiki taq.</para>
  <para style="q">
    <verse number="5" style="v" />Re' hin naa nuye'em q'ab' chi</para>
  <para style="q">xa aha' naa ruchaliik i ti' k'axik taq cha naah.</para>
  <para style="q">Re' wili korik ruum re' hin i Dios nim wajaawriik kinq'orik reh.</para>
  <para style="q">Je' re' noq k'ul taq naa amolom chi elik xa aha' pa' taq inawaaj i hat.</para>
  <para style="q">Eh ma' awach ta chik taq naa rumolwiik awach.</para>
  <para style="q">
    <verse number="6" style="v" />Xa re' la' naa wo' chikruponiiki q'iij chi nuwach i hin</para>
  <para style="q">chi naa wo' chik wesam taqe panti' k'axik i aj Amón, inki Dios.</para>
  <para style="s">Re' noq xq'orarik rib'iral chib'ih i xkik'ul i aj Edom</para>
  <para style="p">
    <verse number="7" style="v" />Re' QaJaaw Dios nim rajaawriik, je' wili i ruq'or chikiij i aj Edom:</para>
  <para style="b" />
  <para style="q">¿Mi ma' chih chik i na'ojb'al ar Temán re'?</para>
  <para style="q">¿Mi ma' awach chik re' i inkojwik na'ojb'al ar?</para>
  <para style="q">¿Mi xsahchik wach re' i kina'ojb'al?</para>
  <para style="q">
    <verse number="8" style="v" />Re' taq i hat i aj Dedán naa taq amolom chi elik,</para>
  <para style="q">naa rojiik taq akeb'aam awiib',</para>
  <para style="q">ruum re' hin naa nusacham kiwach i aj Esaú,</para>
  <para style="q">ruum xponik chik i q'iij chi naa nuye'em taqe panti' k'axik.</para>
  <para style="q">
    <verse number="9" style="v" />Eh noq insik'arik i wach i uuva ko wilik wo' k'isinoq inkahnik,</para>
  <para style="q">noq kiponik i aj jileq' chaq'ab'</para>
  <para style="q">xa re' wo' hoq i ajwaal wach chi keh inkik'am</para>
  <para style="q">xa ko wilik wo' inkikanaa' ar.</para>
  <para style="q">
    <verse number="10" style="v" />Eh re' hin ma' xta chik i naa nukanaam chupaam i tinamit Esaú,</para>
  <para style="q">naa nuyojom i ke'emb'al kiib'.</para>
  <para style="q">Re' taqe i kak'uun kixq'uun, taqe i ma' tokoom ta kuuk',</para>
  <para style="q">taqe i kika'jaah naa rukuxiik rusachariik kiwach.</para>
  <para style="q">Ma' jino'q chik i naa ruq'oriik reh chi je' wili:</para>
  <para style="q">
    <verse number="11" style="v" />Chakanaa' taq weh awak'uun awixq'uun,</para>
  <para style="q">taqe ixoq kamnaq kib'ahiil</para>
  <para style="q">re' hin neenwilow taqe ma' inko'q ta chik taqe, inki Dios.</para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" />Re' i QaJaaw Dios je' wili xuq'or: Wila' naakik'ulum i ti' k'axik i ma' xta kimahk je' naa jinaj kulk chi k'ahlaj ha' i naa kuk'em ra'j naa chik taq re' hat i aj Edom ma' naa ta ak'ulum i ti' k'axik. Je' naa jinaj kulk chi k'ahlaj ha' taq i naawuk'em. <verse number="13" style="v" />Re' hin i Dios xti korik i nuq'or chi re' i tinamiit Bosra naa rukahniik chi xan tz'irik chik paam, Eh naa rehtesjiik i kajaawriik, ma' holohik taj i naa ruq'orariik chikiij, eh re' taqe i tinamit i ruchopom naah naa rusachariik kiwach chi jumpech, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Re' hin wilik i xuq'or cho weh i QaJaaw,</para>
  <para style="q">jinaj i aj taqareel je' wili i xuq'or cho chupaam taqe i tinamit:</para>
  <para style="q">Chayejaa' taq awiib' reh chi nee tiooj</para>
  <para style="q">taq q'aq'ineel chikinaah i aj Edom.</para>
  <para style="q">
    <verse number="15" style="v" />Re' taq i hat aj Edom naa taq kaat nukanaam</para>
  <para style="q">chi ma' xta taq awajaawriik chikiwach i k'ih seht chi tinamit,</para>
  <para style="q">eh naakixowaam taq awach.</para>
  <para style="q">
    <verse number="16" style="v" />Re' taq i hat xayeew taq awiib' chi jot'arik</para>
  <para style="q">ruum q'e' taq inanimb'isaj awiib'</para>
  <para style="q">Atoob' ta nee taq i naakeb'aa' awiib' chupaam taqe i ruhopil ab'aj,</para>
  <para style="q">oon nee taq tiooj k'achareel chikinaah taqe yuuq',</para>
  <para style="q">oon nee taq nooj ayejaa' taq aaye'aab' chinaah taqe i yuuq', je' rukab' i rub'an xihk,</para>
  <para style="q">re' hin xanaa wo' taq kaat nuqasam cho ar.</para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" />Re' noq naa rusachariik kiwach i aj Edom yohb'aal wach ti'kiil i naa rilariik, naa rub'aan yo'jik ruum. Chu'nchel i naakik'iik ar naa kiyo'jiik naa kikaqse'laam. <verse number="18" style="v" />Ruum re' taqe i aj Edom naa rusachariik kiwach, je' rukab' noq xsacharik kiwach i aj Sodoma, i aj Gomorra. Eh re' taqe i tinamit wilik chuka'jaah naa rusachariik kiwach, ma' awach ta chik i naa rupatiniik ar, ma' awach ta chik i naa rik'iik ar, inki i Dios.</para>
  <para style="q">
    <verse number="19" style="v" />Re' hin yohb'aal wach nujosq'iil taq cha naah aj Edom,</para>
  <para style="q">je' rukab' i rujosq'iil i kaq b'ahlam i nelik chaloq panch'ahn Jordán</para>
  <para style="q">i rukut riib' chikinaah i rutiib',</para>
  <para style="q">re' hin naa taq kaat nukaham reje.</para>
  <para style="q">Eh re' taqe i aj ixowaal naa nukojom chi naaki a'nam taq aweh.</para>
  <para style="q">¿Mi wilik aj uuk' taq neenkipaaj i hin? ¿Awach i neerureq chi je' rukab' i hin?</para>
  <para style="q">¿Mi wilik jino'q i aj cha'joom neenq'atwik nuwach i hin?</para>
  <para style="q">
    <verse number="20" style="v" />Chab'iraj taq aha' wilik i nuyejaam wach i hin,</para>
  <para style="q">re' chi naa nuye'em taqe i chutojariik i kimahk i aj Edom.</para>
  <para style="q">Eh nuyejaam wo' wach chi naa nuye'em taqe chutojariik i kimahk i aj Temán.</para>
  <para style="q">Eh naa wo' kik'amariik reje i kihaa' lak'uun,</para>
  <para style="q">naa rusachariik wach i kiye'aab'.</para>
  <para style="q">
    <verse number="21" style="v" />Eh noq naa rusachariik kiwach i aj Edom,</para>
  <para style="q">ma' k'isa choqik, xan k'uyu'jik chik ak'al naa rub'anam.</para>
  <para style="q">Eh naakik'erem kichii' naa rib'irjiik cho ko chi chii' i kaq palaw.</para>
  <para style="q">
    <verse number="22" style="v" />Re' taqe i aj ixowaal xakow chik inki a'n noq naa kichaliik chikinaah i aj Bosra,</para>
  <para style="q">je' rukab' noq kirupinik i xihk.</para>
  <para style="q">Eh re' taqe i ki soldado i aj Edom ma' k'isiin naa kiyo'jiik,</para>
  <para style="q">je' rukab' noq inyo'jiik ixoq noq ach k'isiin ma' k'ulik ruk'ux, inki Dios.</para>
  <para style="s">Re' noq xq'orarik cho rib'iral chib'ih i xkik'ul i aj Damasco</para>
  <para style="p">
    <verse number="23" style="v" />Re' i QaJaaw Dios je' wili xuq'or chikiij i aj Damasco:</para>
  <para style="b" />
  <para style="q">Re' taqe i aj Hamat, taqe i aj Arfad, xkik'uhtaaj kik'ixb'ilaal,</para>
  <para style="q">ruum xkib'iraj chi ma' holohik taj i naa ruchaliik chikinaah.</para>
  <para style="q">Ma' kisiin taxiyo'jik xama' suq ta chik inki a'n</para>
  <para style="q">
    <verse number="24" style="v" />Re' taqe i aj Damasco naa kikahniik chi ma' xta chik kikowiil naakimolom chi elik,</para>
  <para style="q">ma' k'isiin ta naa kiyo'jiik,</para>
  <para style="q">naa ruchaliik i rutz'irkiil kiwach,</para>
  <para style="q">xa je' chik kikab' ixoq ach k'isiin ma' nk'ulik ruk'ux.</para>
  <para style="q">
    <verse number="25" style="v" />Re' i kitinamiit holohik naq rib'iral suq naq wilik,</para>
  <para style="q">naa rukanab'jiik chi kutkeel.</para>
  <para style="q">
    <verse number="26" style="v" />Eh re' taqe i k'ijolaq naa rukahniik chi kutlik i kiti'jolal xilak taq b'eeh.</para>
  <para style="q">Eh chu'nchel i kaj q'aq'ineel naa rukuxiik kikimiik,</para>
  <para style="q">inki QaJaaw Dios nim wajaawriik.</para>
  <para style="q">
    <verse number="27" style="v" />Re' hin naa nukojom ruq'aq'al i tz'aq kotimaj wii' riij i tinamit Damasco,</para>
  <para style="q">eh naa wo' ruk'ahtiik i paat i rub'an wii' i taaq'anik i reey Ben-adad, inki.</para>
  <para style="s">Re' noq xq'orarik rib'iral i xkik'ul i aj Cedar, je' wo' taqe i aj Hazor</para>
  <para style="p">
    <verse number="28" style="v" />Re' QaJaaw Dios je' wili i xuq'or chikiij i aj Cedar, chikiij taqe i k'amal b'eeh ar Hazor.</para>
  <para style="b" />
  <para style="q">Re' i xb'aan keh ruum i Nabucodonosor kireey i aj Babilonia:</para>
  <para style="q">Re' taq i hat i aj Babilonia hiy taq cha a'n keh i aj Cedar,</para>
  <para style="q">chasach taq wach i tinamit re' re' wilik reje pareelb'aal q'iij.</para>
  <para style="q">
    <verse number="29" style="v" />Naa taq achopom naah i ki-itz'ihy naah paat,</para>
  <para style="q">i kitentzuun, i chib'ih keh, i kikulk, i kicameyo.</para>
  <para style="q">Eh naa taq ak'erem i aachii' chuq'orariik keh chi je' wili:</para>
  <para style="q">Xk'uloq taq cha junsuut i runimaal yohb'aal, tiko'q taq keh.</para>
  <para style="q">
    <verse number="30" style="v" />Eh re' hin i Dios je' wili i naa nuq'orom keh:</para>
  <para style="q">Chamol taq chi elik i hat i patinik taq i na a'n Hazor,</para>
  <para style="q">hiy taq chakeb'aa' awiib' ruum re' i Nabucodonosor kireey i aj Babilonia</para>
  <para style="q">ruyejaam chik wach chi naa rub'anam taq aweh.</para>
  <para style="q">
    <verse number="31" style="v" />Re' wo' hin i Dios naa nuq'oriik reh chi je' wili:</para>
  <para style="q">Hiy taq cha a'n keh i tinamit re' re' i ma' xta naakik'ulum noq inkiq'or.</para>
  <para style="q">Eh suq wilkeeb', ma' xta koraal tz'aq chi riij,</para>
  <para style="q">eh ma' xta ru puertahiil i kitinamiit,</para>
  <para style="q">rutkeel wilik.</para>
  <para style="q">
    <verse number="32" style="v" />Naa taq aq'uchum i kikaweyo,</para>
  <para style="q">i kiwakax,</para>
  <para style="q">naa nutukem reje kiwach xa aha' yuuq'.</para>
  <para style="q">Re' taqe i tinamit re' re' inkijoy i rismaal kinaah</para>
  <para style="q">xa aha' naa nuk'amam chaloq i runimaal ti' k'axik chikinaah.</para>
  <para style="q">
    <verse number="33" style="v" />Re' i tinamit Hazor naa rukahniik chi xan tz'irik chik paam,</para>
  <para style="q">naa rukahniik chi kiye'aab' xojb'.</para>
  <para style="q">Ma' jino'q chik i patineel naa kikahniik chupaam,</para>
  <para style="q">eh ma' awach ta chik i naa rik'iik ar, inki i Dios.</para>
  <para style="s">Re' noq xq'orarik rib'iral chib'ih xkik'ul i aj Elam</para>
  <para style="p">
    <verse number="34" style="v" />Eh noq xokik chi reyil i Sedequías ar Judá, re' i QaJaaw Dios je' wili i xuq'or reh i Jeremías chikiij i aj Elam: <verse number="35" style="v" />Re' hin i Dios nim wajaawriik,</para>
  <para style="b" />
  <para style="q">xti korik i nuq'or chi naa rutoqib'iik i kiflecha</para>
  <para style="q">inkikoj chi kantesb'al taqe i aj Elam.</para>
  <para style="q">
    <verse number="36" style="v" />Naa nuk'amam taqe chaloq chi junsuut i aj ixowaal</para>
  <para style="q">chikinaah, xa je' chik kik'uloq kowlaj teew,</para>
  <para style="q">reh chi naa rutukjiik reje kiwach xa aha' yuuq'.</para>
  <para style="q">Korehtaal inkahnik chi ma' jino'q chik i tinamit naa rukahniik</para>
  <para style="q">aha' imponik kikeb'aa' kiib' i kitinamiit.</para>
  <para style="q">
    <verse number="37" style="v" />Re' hin naa nuye'em q'ab' chi naa kiyo'jiik i aj Elam</para>
  <para style="q">chikiwach i aj ixowaal naa rukansanik keh.</para>
  <para style="q">Ruum i nujosq'iil naa nuk'amam chaloq i ti' k'axik chikinaah,</para>
  <para style="q">naa nuk'amam chee q'aq'inik chikinaah,</para>
  <para style="q">korehtaal insacharik kiwach.</para>
  <para style="q">
    <verse number="38" style="v" />Re' hin tokoom chik i naa nukojom chi taaq'anik ar Elam,</para>
  <para style="q">naa nuye'em q'ab' chi naakikanteesjiik taqe i kireey,</para>
  <para style="q">je' wo' taqe i k'amal kib'eeh. <verse number="39" style="v" />Xa re' la' na' ohoq kuxoq</para>
  <para style="q">naa wo' chik taqe wesam chaloq panti' k'axik taqe i aj Elam,</para>
  <para style="q">inki i QaJaaw Dios.</para>
  <chapter number="50" style="c" />
  <para style="s">Re' i ruq'orariik rib'iral chi xb'aan keh i aj Babilonia</para>
  <para style="p">
    <verse number="1" style="v" />Re' i xuq'or i QaJaaw Dios chikiij i aj Babilonia kitinamiit i aj Caldeo, re' i xuq'or cho ruuk' chii' i Jeremías jalal ruq'oral, je' wili i xuq'or:</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Chaq'or rib'iral chayeew chi naab'jik chupaam i ju'jun seht chi tinamit.</para>
  <para style="q">Chajosaj i rehtalil aq'oral reh chi neenaq'or chu'nchel, je' wili i neenaq'or:</para>
  <para style="q">Re' i tinamit Babilonia ach k'isiin ma' inchopariik naah,</para>
  <para style="q">re' i kitiyoox Bel xa se'lb'al naa rukahniik wii'.</para>
  <para style="q">Re' i kitiyoox Merodac chu'nchel tiyoox inkiloq'ej</para>
  <para style="q">naa rusachariik kiwach.</para>
  <para style="q">
    <verse number="3" style="v" />Ruum pantz'eet reh i rookb'aal q'iij k'achi' kichaliik</para>
  <para style="q">i naa rukananiik reh i kitinamiit chi xan tz'irik chik paam.</para>
  <para style="q">Ma' awach ta chik jino'q i naa rupatiniik ar,</para>
  <para style="q">ni xata naq chik chikop i naa ruwihiik ar,</para>
  <para style="q">naa la' kimolom chi elik chi kunchelaal, tiko'q keh, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Re' QaJaaw Dios je' chik wili xuq'or:</para>
  <para style="q">Chupaam taqe ponoq i q'iij re' re'</para>
  <para style="q">naa wo' chik kinkisik'im i nutinamiit Israel,</para>
  <para style="q">kuch'ihil i taqe i aj Judá naa wo' chik</para>
  <para style="q">kin kikojom chi kaJaaw chi ki Dios.</para>
  <para style="q">
    <verse number="5" style="v" />Naakipahqaam aha' wilik i b'eeh inooj Sión,</para>
  <para style="q">je' wili i naa kiq'orom:</para>
  <para style="q">Qasik' wo' taq chik i QaJaaw,</para>
  <para style="q">wilik i naaqayejaam wach ruuk' chi naaqanam juneliik,</para>
  <para style="q">eh ma' naa ta chik rusahchiik panqak'ux, inko'q taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Re' taqe i nutinamiit sahchinaq naq taqe,</para>
  <para style="q">je' naq kikab' i tentzun ma' kicha'jaljiik ta</para>
  <para style="q">chi korik kuum i aj cha'joom</para>
  <para style="q">kisahchik xak'ul chik kiooj nah taq yuuq'</para>
  <para style="q">sahchik pankik'ux aha' wilik i kiye'aab'.</para>
  <para style="q">
    <verse number="7" style="v" />Eh noq kireqariik i nutinamiit kuum i aj ixowaal</para>
  <para style="q">imb'aankeh je' wili inq'orarik chikiij:</para>
  <para style="q">Ma' re' ta mahk inqa a'n keh ruum ximahkunik chuwach i Dios,</para>
  <para style="q">re' i xti manlik ehchan keh.</para>
  <para style="q">Re' Dios inkich'ikaa' cho wii' kik'ux i kimaam kati't.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Re' taq i hat aj Israel eleen taq reje Babilonia,</para>
  <para style="q">re' i kitinamiit i aj Caldeo hiy taq chi peet b'eeh</para>
  <para style="q">je' rukab' noq inooj chi peet b'eeh i kaprax chikiwach i tentzun.</para>
  <para style="q">
    <verse number="9" style="v" />Ruum re' hin naa nuye'em q'ab' keh i k'ih ch'uq chi tinamit,</para>
  <para style="q">re' i kow kiib' naa kichaliik pantz'eet reh i rookb'aal q'iij,</para>
  <para style="q">naa kia'nam reh i tinamit Babilonia.</para>
  <para style="q">Eh pankomonil</para>
  <para style="q">naa kichopom naah re' ruuk' taqe i aj q'aq'ineel</para>
  <para style="q">xti tz'eht i kiq'ab' noq inkikut i flecha.</para>
  <para style="q">
    <verse number="10" style="v" />Eh naa kikanaam chi ma' xta chik wilik keh i aj Caldeo,</para>
  <para style="q">naa kikansam chu'nchel korehtaal inch'iklojik kik'ux,</para>
  <para style="q">inki i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Eh je' wo' chik wili i xuq'or:</para>
  <para style="q">Re' taq i hat aj Caldeo xak'am taq i chib'ih keh i nutinamiit,</para>
  <para style="q">xatipisk'anik taq chik panawooq ruum i rusuqkiil ak'ux,</para>
  <para style="q">xa je' chik rukab' noq impisk'anik i q'ahxoq wakax,</para>
  <para style="q">xa je' chik rukab' noq i ruk'er chii' i kawáyu wach k'im.</para>
  <para style="q">
    <verse number="12" style="v" />Xa re' la' re' taq aatinamiit xat aasjik wii' naakik'uhtaam kik'ixb'ilaal,</para>
  <para style="q">ruum xa re' wo' re' ma' ajwaal ta kiwach na' chub'an.</para>
  <para style="q">Eh naa rukahniik chi xan tz'irik chik paam i kitinamiit,</para>
  <para style="q">ma' xta chik naa ruwihiik ar chi jumpech.</para>
  <para style="q">
    <verse number="13" style="v" />Ruum re' hin naa ruchaliik nujosq'iil chinaah i tinamit Babilonia,</para>
  <para style="q">ma' jino'q chik patineel naa nukanaam, xan tz'irik chik paam chi jumpech.</para>
  <para style="q">Awach naa rik'iik ilwoq reh i</para>
  <para style="q">ma' k'isiin taq naa ruchaliik ruyo'jiik ruum i ti' k'axik naakik'ulum.</para>
  <para style="q">
    <verse number="14" style="v" />Re' taq i hat i tikaansanik taq ruuk' flecha</para>
  <para style="q">chatus taq awiib' chakotej taq riij i</para>
  <para style="q">Babilonia nee taq inakansaj,</para>
  <para style="q">ruum ximahkunik chi nuwach i hin, hin Dios.</para>
  <para style="q">
    <verse number="15" style="v" />Chak'er taq aachii' chi junsuut, chi je' wili:</para>
  <para style="q">Re' i tinamit Babilonia achk'isiin ma' inkiq'asaj kiib'</para>
  <para style="q">xiq'ehb'ik chik i tz'aq inkiko'leej wii' wiib',</para>
  <para style="q">je' wo' hoq i tz'aq kotimaj wii' riij.</para>
  <para style="q">Je' re' ruq'ajariik wach naa nub'anam keh,</para>
  <para style="q">chaq'aj wo' taq wach keh i hat i xkian.</para>
  <para style="q">
    <verse number="16" style="v" />Re' taq i hat naa taq rukuxiik akansam i kib'anik i tik,</para>
  <para style="q">je' wo' taqe i kimolwik i wach i tik,</para>
  <para style="q">eh re' taqe i aj pan tokoom tinamit</para>
  <para style="q">naa wo' chik kisutiniik reje pan kitinamiit,</para>
  <para style="q">chi kiju'junaal.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Re' i nutinamiit Israel xkik'ul keh</para>
  <para style="q">i je' rukab' i ruk'ul i tentzun ajimamaj ruum i kaq b'ahlam.</para>
  <para style="b" />
  <para style="p">Ruum peet xb'aan ti' k'axik keh ruum kireey i aj Asiria, eh xb'aan wo' keh ruum i Nabucodonosor kireey i aj Babilonia, xpaaxjik paam i kib'aqil. <verse number="18" style="v" />Ruum aj re', re' hin i Dios wilik wajaawriik, ki Dios i aj Israel i nuq'or chi naa nuye'em panti' k'axik i kireey i aj Babilonia, je' wo' hoq i rutinamiit, je' rukab' i xnub'an ruuk' i kireey i aj Asiria.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Eh naa wo' chik nusutem taqe chaloq pan kitinamiit i aj Israel.</para>
  <para style="q">Naa nukanaam taqe chi je' kikab' i tentzun wilik kiwa' chi korik,</para>
  <para style="q">chuwach i yuuq' Carmelo, i ye'aab' Basán,</para>
  <para style="q">i rax chee' Efraín, i Galaad.</para>
  <para style="q">
    <verse number="20" style="v" />Re' hin i Dios kinq'orik chi</para>
  <para style="q">chupaam taqe ponoq i q'iij re' re'</para>
  <para style="q">naa nukanaam chi ma' xta chik i kimahk i aj Israel,</para>
  <para style="q">je' wo' taqe i aj Judá re' taqe i xnukanaa' cho chi kok'achalkeeb'</para>
  <para style="q">ruum naa nukuyum taqe i kimahk, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Re' QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' taq i hat aj q'aq'ineel hiy taq cha a'n keh i aj Meretaim,</para>
  <para style="q">i aj Pecod, chasach taq kiwach.</para>
  <para style="q">Cha a'n taq chu'nchel i nuq'or taq aweh</para>
  <para style="q">ruum re' hin kinq'orik, inki.</para>
  <para style="q">
    <verse number="22" style="v" />Naa rib'irjiik chupaam i tinamit chi naakik'erem kichii',</para>
  <para style="q">ruum naa ruponiik i q'aq'inik chikinaah.</para>
  <para style="q">
    <verse number="23" style="v" />Re' taqe i aj Babilonia imb'anik keh chu'nchel i tinamit wach ak'al naa rukahniik</para>
  <para style="q">chi ma' xta chik kamaj, eh naa rusachariik kiwach.</para>
  <para style="q">Eh ma' k'isiin ta naa kiyo'jiik i tinamit wach ak'al</para>
  <para style="q">noq naakilom i naakik'ulum i aj Babilonia.</para>
  <para style="q">
    <verse number="24" style="v" />Re' taq i hat aj Babilonia xa re' taq i hat</para>
  <para style="q">xakoj aaxirob'aal cha wib'il awiib' xa chi ma' aweht'al taq naa aq'ehb'iik chupaam,</para>
  <para style="q">ruum xinaq'etwachej taq i hin, hin Dios.</para>
  <para style="q">
    <verse number="25" style="v" />Re' QaJaaw Dios naa ruye'em q'ab' keh i aj q'aq'ineel</para>
  <para style="q">chi naakesam chee kich'ihch' reh q'aq'inik ruum i rujosq'iil.</para>
  <para style="q">Ruum re' i QaJaaw Dios nim rajaawriik,</para>
  <para style="q">naa rub'anam keh i aj Caldeo.</para>
  <para style="q">
    <verse number="26" style="v" />Re' taq i hat aj q'aq'ineel ti chaloq taq</para>
  <para style="q">xa aha' yuuq' hiy taq cha teh i kiye'aab' inkimol wii' i wach kitik,</para>
  <para style="q">chasach taq kiwach,</para>
  <para style="q">korehtaal inakanaa' taqe chi ma' jino'q i k'achalkeeb'.</para>
  <para style="q">
    <verse number="27" style="v" />Chakansaj taqe chi kunchelaal,</para>
  <para style="q">cha a'n taq kuuk' je' rukab' noq ink'amarik reje i k'ijol wakax pan kantesb'al.</para>
  <para style="q">Re' keh xiik' naah ti' kiil i naakik'ulum chupaam taqe i q'iij re' re'.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Eh re' taqe i ma' naa ta kikimiik ar Babilonia</para>
  <para style="q">naa rojiik kiq'orom ar Sión chi re' i QaJaaw Dios</para>
  <para style="q">xuyeew taqe chutojariik i kimahk i aj Babilonia,</para>
  <para style="q">je' rukab' i ruk'ul chi keh ruum xkiyeew chi re' chi ma' re' i rupaat i Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Chayuq'eej taqe chu'nchel</para>
  <para style="q">i kikansanik ruuk' flecha,</para>
  <para style="q">reh chi neenkikotej riij i tinamit Babilonia,</para>
  <para style="q">reh chi neenb'aan keh, eh ma' jino'q ineenkiko'leej kiib'.</para>
  <para style="q">Chi je' re' neenb'aan keh nik' wach i xkian i keh reh i tokoom.</para>
  <para style="q">Ruum xa nimaq chik kiwach inki a'n kiib' chi nuwach i hin</para>
  <para style="q">wilik nuSantohiil hin ki Dios i aj Israel.</para>
  <para style="q">
    <verse number="30" style="v" />Ruum aj re', re' taqe i k'ijolaq naa rukuxiik kikanteesjiik pantaq b'eeh.</para>
  <para style="q">Eh chu'nchel taqe i kaj q'aq'ineel kikansanik ruuk' flecha,</para>
  <para style="q">naa rukuxiik kikimiik chupaam taqe i q'iij re' re', inki i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" />Eh je' wo' chik wili i xuq'or i QaJaaw Dios nim rajaawriik:</para>
  <para style="q">Re' taq i hat tinamit xa nimaq taq chik awach i na a'n awiib'</para>
  <para style="q">ma' nwaaj ta wach taq i na a'n,</para>
  <para style="q">ruum aj re' xponik chik i q'iij chi naa taq kaat nuye'em panti' k'axik.</para>
  <para style="q">
    <verse number="32" style="v" />Re' taq i hat nimaq taq awach i na a'n awiib'</para>
  <para style="q">ma' naa ta taq aweliik korik noq naa ruk'uliik chee ti' k'axik taq cha naah,</para>
  <para style="q">ruum ma' awach ta taq naa rutoob'iniik aweh.</para>
  <para style="q">Re' hin naa ruqopom kiq'aq'al taqe i tinamit,</para>
  <para style="q">naa ruk'atam reje i chi junsuut, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" />Eh je' wo' chik wili xuq'or:</para>
  <para style="q">Re' taqe i tinamit Israel,</para>
  <para style="q">re' taqe i tinamit Judá k'achi'</para>
  <para style="q">rub'aan ti' k'axik keh kuum taqe i inixowanik kiwach</para>
  <para style="q">ar tz'apalkeeb' ma' kioq'teesjik ta chaloq.</para>
  <para style="q">
    <verse number="34" style="v" />Xa re' la' re' hin xti kow naa wesam taqe chaloq,</para>
  <para style="q">hin Dios nim wajaawriik i nub'ihnaal.</para>
  <para style="q">Re' hin naa nub'aniik i q'ataj q'orik,</para>
  <para style="q">suq kiil k'uxliis i naa nuye'em keh i nutinamiit Israel.</para>
  <para style="q">Eh runimaal ti' k'axik inanuye'em chikinaah taqe i aj Babilonia, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" />Re' i QaJaaw Dios je' wo' chik wili i xuq'or:</para>
  <para style="q">Re' taqe i aj Babilonia naa kikantesjiik ruuk' i q'aq'inik,</para>
  <para style="q">taqe i k'amal kib'eeh,</para>
  <para style="q">taqe i wilik kina'ojb'al.</para>
  <para style="q">
    <verse number="36" style="v" />Eh naa kikanteesjiik ruuk' q'aq'inik taqe i kaj q'iij,</para>
  <para style="q">naa ruchaliik ruyojiik paam i kinaah.</para>
  <para style="q">Naakikanteesjiik ruuk' q'aq'inik i xakow chik inki a'n kiib'.</para>
  <para style="q">
    <verse number="37" style="v" />Naakikanteesjiik ruuk' q'aq'inik taqe i ki soldado,</para>
  <para style="q">taqe i kikareta, i kikawayu, taqe i tokoom tinamit wilkeeb' chi kixilak.</para>
  <para style="q">Xa ma' xta chik i naa kianam naakikahnik chi xa je' chik taqe ixoq,</para>
  <para style="q">Eh naa relq'jiik chu'nchel i chib'ih keh.</para>
  <para style="q">
    <verse number="38" style="v" />Eh naa ruchiqiik taqe i kirooq haa',</para>
  <para style="q">i aj Babilonia ruum xa re' taqe i tiyoox xkiloq'ej,</para>
  <para style="q">ruum taqe i re' insahchik i kina'ojb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" />Ruum aj re', re' i tinamit Babilonia naa rukahniik chi kiye'aab' i yaak,</para>
  <para style="q">chi kiye'aab' xojb'.</para>
  <para style="q">Eh naa rukahniik chi kiye'aab' nimaq chikop wilik kixiik',</para>
  <para style="q">ma' jaruuj chik q'iij naa kiwihiik patineel chupaam.</para>
  <para style="q">
    <verse number="40" style="v" />Nik' wach noq xnusach kiwach i tinamit Sodoma, i Gomorra,</para>
  <para style="q">taqe i tinamit wilik chi kijunsuut ma' awach ta chik i naa rupatiniik ar.</para>
  <para style="q">Je' wo' re' noq naa nusacham wach i tinamit Babilonia,</para>
  <para style="q">ma' jino'q chik i naa rupatiniik chupaam.</para>
  <para style="b" />
  <para style="q">
    <verse number="41" style="v" />Eh chupaam i jinaj ye'aab' chi najt yuuq' wilik cho pantz'eet reh i rookb'aal q'iij</para>
  <para style="q">k'ahchi' cho ruyejaam riib' chi chalik jinaj i nimlaj tinamit xti kow riib',</para>
  <para style="q">ma' k'isiin kik'ihaal taqe i ru reey.</para>
  <para style="q">
    <verse number="42" style="v" />Xkik'am chaloq i kiflecha,</para>
  <para style="q">i kiq'asju' ch'ihch', yohb'aal wach i kijosq'iil,</para>
  <para style="q">ma' xta ketelinik wachiis kuuk'.</para>
  <para style="q">Eh yohb'aal wach i choqik naa kianam,</para>
  <para style="q">je' rukab' i rub'an i palaw.</para>
  <para style="q">Chalik chik inki a'n chi riij i kikawayu chi q'aq'inik chinaah i tinamit Babilonia.</para>
  <para style="q">
    <verse number="43" style="v" />Eh noq naa rib'iram chi je' re' i kireey i aj Babilonia naa rusik'riik ruum ruyo'jiik.</para>
  <para style="q">Eh ma' k'isiin ta naa rutib'iik ruk'ux,</para>
  <para style="q">je' rukab' noq inchalik ruti'kiil ixoq noq ink'ulik ruk'ux.</para>
  <para style="b" />
  <para style="q">
    <verse number="44" style="v" />Re' hin yohb'aal wach nujosq'iil</para>
  <para style="q">je' rukab' rujosq'iil i kaq b'ahlam i nelik cho panch'ahn Jordán</para>
  <para style="q">eh naa nukaham taqe reje ar i aj Babilonia.</para>
  <para style="q">Eh re' taqe i aj ixowaal naa nukojom chi naa kia'nam taq aweh taq i hat aj Babilonia.</para>
  <para style="q">¿Mi wilik i aj kuuk' taq nee kinapaj i hin?</para>
  <para style="q">¿Awach i nee rureq chi je' nukab' i hin?</para>
  <para style="q">¿Mi wilik jino'q i aj cha'joom neeruq'at nuwach i hin?</para>
  <para style="q">
    <verse number="45" style="v" />Chab'iraj taq aha' wilik i nuyejaam wach i hin chi naa nub'anam kuuk'</para>
  <para style="q">i aj Babilonia re' i kitinamiit i aj Caldeo, re' taqe i wili:</para>
  <para style="q">Re' hin nuyejaam wach chi naakik'amariik reje i keh,</para>
  <para style="q">je' wo' i kikok' halak'uun,</para>
  <para style="q">eh naa rusachariik wach i kiye'aab'.</para>
  <para style="q">
    <verse number="46" style="v" />Eh noq naa rusachariik kiwach i aj Babilonia,</para>
  <para style="q">ma' k'isiin i choqik naa rub'aan naa ruk'uyu'jiik i wach ak'al naakik'erem kichii'</para>
  <para style="q">naa rib'irjiik cho chupaam taqe i nimaq tinamit, inki Dios.</para>
  <chapter number="51" style="c" />
  <para style="s">Re' i rusachariik wach i kitinamiit i aj Babilonia</para>
  <para style="p">
    <verse number="1" style="v" />Re' QaJaaw Dios je' wili xuq'or:</para>
  <para style="b" />
  <para style="q">Re' hin naa nutaq'aam chaloq jinaj i naa rusachwiik wach i tinamit Babilonia,</para>
  <para style="q">eh chu'nchel i kiye'aab' i aj Caldeo naa nusacham wach.</para>
  <para style="q">
    <verse number="2" style="v" />Eh wilik i naa nutaq'aam chaloq i naa rukutwiik reje keh i aj Babilonia,</para>
  <para style="q">je' rukab' noq inkutarik reje inaq'wach i trigo.</para>
  <para style="q">Eh naa rukahniik chi ma' xta chik patineel chupaam i kitinamiit,</para>
  <para style="q">k'ul naa kichaliik i naa rub'aniik keh, paruq'ijil i ti' k'axik.</para>
  <para style="q">
    <verse number="3" style="v" />Eh naa nuq'orom chi naakiyejaam i kiflecha i kikansanik ruuk' flecha.</para>
  <para style="q">Eh chi naa kikojom i kich'ihch' so' chikiij,</para>
  <para style="q">chi ma' naa ta kiketelaam wach taqe i k'ijolaq ar Babilonia.</para>
  <para style="q">Eh naa rukuxiik kisacham wach i ki soldado.</para>
  <para style="q">
    <verse number="4" style="v" />Ar Babilonia pan kitinamiit taqe i aj Caldeo</para>
  <para style="q">naa rukahniik chi tuch'lik i kiti'jolal taqe kamnaq.</para>
  <para style="q">
    <verse number="5" style="v" />Atoob' ta re' taqe i aj Israel, taqe i aj Judá ximahkunik chi nuwach.</para>
  <para style="q">Eh xkinujisaj chi mahk paam i tinamit.</para>
  <para style="q">Re' hin i Dios nim wajaawriik,</para>
  <para style="q">hin kiSantolaj Dios i aj Israel xama' nukanaam ta wo' taqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Awach i nee ruyeew riib' chuwach eloq reje Babilonia,</para>
  <para style="q">chi ko'leej riib' maruyeew riib' chi kimiik ruum i kimahk i keh.</para>
  <para style="q">Ruum xponik chik i q'iij chi naa nuq'ajam wach keh i xkian i keh</para>
  <para style="q">je' rukab' i ruk'ul chi keh.</para>
  <para style="q">
    <verse number="7" style="v" />Re' i Babilonia chi weeh hin je' naq rukab' i kulk re' ruuk' i oro,</para>
  <para style="q">xkamanik weh chi ruuk' nujosq'iil i ruxohk'risaj taqe i tinamit,</para>
  <para style="q">je' naa k'ahlaj ha' i xuyeew keh</para>
  <para style="q">chi uuk'jik ruuk' i re' xusach i kina'ojb'al.</para>
  <para style="q">
    <verse number="8" style="v" />Re' taqe i aj Babilonia</para>
  <para style="q">jumehq'iil naa rusachariik kiwach.</para>
  <para style="q">Re' taq i hat naa taq awoq'iim chikiij, naa naq taq chik atoob'eem</para>
  <para style="q">xa i lb'al naq reh mi konee nik'ik, i kiti'kiil, inki Dios.</para>
  <para style="q">
    <verse number="9" style="v" />Eh re' taqe i aj Israel wilkeeb' poo ar je' wili i naa kiq'orom:</para>
  <para style="q">Re' hoj xqatob'eej wo' naq taqe i aj Babilonia,</para>
  <para style="q">xa re' la' ma' xta wo' chik i xraaj ruum re' i kimahk</para>
  <para style="q">xponik chik kopan taxaaj i kochi juntar i suutz',</para>
  <para style="q">taq taq chi qaju'junaal panqatinamiit.</para>
  <para style="q">
    <verse number="10" style="v" />Re' i QaJaaw Dios xoj resaj korik</para>
  <para style="q">ruuk' i ruk'ul chi qeh i hoj.</para>
  <para style="q">Taq taq qaq'or rib'iral ar Sión</para>
  <para style="q">i xub'an quuk' i QaJaaw Dios, inko'q taqe.</para>
  <para style="q">
    <verse number="11" style="v" />Re' i QaJaaw Dios i xraaj rusacham kiwach i aj Babilonia</para>
  <para style="q">xuyeew pankikapeb'aal taqe i kireey i aj Media i rukapaaj i reh.</para>
  <para style="q">Re' QaJaaw je' re' ruq'ajariik wach keh</para>
  <para style="q">naa rub'anam ruum xkiyeew chi re' chi ma' re' i rupaat.</para>
  <para style="q">Hat taq aj q'aq'ineel cha yejaa' taq aaflecha,</para>
  <para style="q">je' wo' taq apulato ch'ihch'.</para>
  <para style="q">
    <verse number="12" style="v" />Chayeew taq rehtalil chi naa taq asacham wach</para>
  <para style="q">i tz'aq' kotimaj wii' riij i tinamit Babilonia,</para>
  <para style="q">chakoj taq kiman i aj cha'joom cha yejaa' taq awiib' chub'aan,</para>
  <para style="q">ruum re' i QaJaaw Dios naa rub'anam i ruyejaam cho wach</para>
  <para style="q">chi naa rub'anam kuuk' i aj Babilonia.</para>
  <para style="q">
    <verse number="13" style="v" />Eh re' taq i hat aj Babilonia ma' k'isiin wo' naq</para>
  <para style="q">taqe i nim ha' wilkeeb' cha junsuut,</para>
  <para style="q">ma' k'isiin wo' naq taq ab'ehomal.</para>
  <para style="q">Xa re' la' yu'naak xponik chik i q'iij chi naa rusachariik taq awach.</para>
  <para style="q">
    <verse number="14" style="v" />Re' i QaJaaw Dios nim rajaawriik xuq'or korik, je' wili i xuq'or:</para>
  <para style="q">Re' hin naa nutaq'aam i ma' k'isa aj ixowaal taq cha naah,</para>
  <para style="q">xa je' chik taqe k'ihaal nimaq chili'l,</para>
  <para style="q">naa rusuqb'iik kik'ux ruum i naa kia'nam taq aweh, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Re' i QaJaaw Dios ruuk' i rajaawriik xuyejaa' i wach ak'al,</para>
  <para style="q">ruuk' i runa'ojb'al xuyeew taqe paruye'aab' i wilkeeb' chupaam.</para>
  <para style="q">Eh ruuk' runa'ojb'al xuhe' wach i taxaaj paruye'aab'.</para>
  <para style="q">
    <verse number="16" style="v" />Noq inq'orik i reh inkitik'aa' cho choqik i suutz' kiye'wik chee jab' pan taxaaj.</para>
  <para style="q">Eh i ruksaj chaloq i suutz' chi junsuut i wach ak'al,</para>
  <para style="q">i rub'an taqe chaloq i ruch'aab' i kahoq noq k'ahchi' i jab'.</para>
  <para style="q">Eh i resaj taqe chaloq i teew aha' wilik wii'.</para>
  <para style="q">
    <verse number="17" style="v" />Xa re' la' re' taqe i tinamit ma' xta kina'ojb'al</para>
  <para style="q">ma' inkik'am ta naah i runa'ojb'al i Dios,</para>
  <para style="q">inkixuk'aa' kiib' chuwach taqe i tiyoox.</para>
  <para style="q">Eh inkiq'asaj kiib' chub'aan i k'ixb'ilaal chi b'anarik,</para>
  <para style="q">inkiyejaa' kitiyoox xama' xta wo' kajaawriik, xama' k'achalkeeb' ta wo' hoq.</para>
  <para style="q">
    <verse number="18" style="v" />Xa ma' xta kitz'aaq, xa se'lb'al taqe,</para>
  <para style="q">naa rusachariik kiwach ruum i QaJaaw, noq naa ruye'em chee ti' k'axik.</para>
  <para style="q">
    <verse number="19" style="v" />Re' i ruDios chaloq i Jacob,</para>
  <para style="q">ma' je' ta kikab' taqe i tiyoox re' re'</para>
  <para style="q">ruum re' reh xtz'uhkrisanik chaloq chu'nchel i chib'ih jariik i wilik.</para>
  <para style="q">Eh re' reh xsik'wik cho kiwach i aj Israel, chi xukoj taqe chi rutinamiit.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' taq i hat aj Babilonia xatkamanik taq weh chi ch'eyb'al,</para>
  <para style="q">chi waj q'aq'ineel,</para>
  <para style="q">chi xqasach kiwach i tinamit ruch'ihil i kireey.</para>
  <para style="q">
    <verse number="21" style="v" />Re' taq i hat xatowik weh chub'aan keh</para>
  <para style="q">i kikawayu reh q'aq'inik, je' wo' i kijohtik chi riij,</para>
  <para style="q">je' wo' taqe i kikareta, je' wo' taqe i kiwihik chupaam.</para>
  <para style="q">
    <verse number="22" style="v" />Re' wo' taq i hat xatowik weh noq xnub'an keh i tinamit,</para>
  <para style="q">chi winaq chi ixoq chi nimaq chi kok' taq,</para>
  <para style="q">eh chi k'ijool, chi q'ahxoq.</para>
  <para style="q">
    <verse number="23" style="v" />Eh re' wo' taq i hat xatowik weh noq xnub'an</para>
  <para style="q">keh i aj cha'jen tentzun, ruch'ihil i kitentzuun.</para>
  <para style="q">Je' wo' noq xnub'an keh i aj arado ruch'ihil i kib'ooyax,</para>
  <para style="q">je' wo' taqe i k'amal rub'eeh i tinamit,</para>
  <para style="q">ruch'ihil taqe i kaj kamanoom, inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Re' i QaJaaw Dios je' wili i xuq'or keh i aj Israel:</para>
  <para style="q">Re' taq i hat naa taq awilom ruuk' naq'awach noq naa nuq'ajam wach keh i aj Babilonia</para>
  <para style="q">chu'nchel i aj Caldeo, chu'nchel i yiib' wach xkian reh i nutinamiit Sión.</para>
  <para style="q">
    <verse number="25" style="v" />Re' hin ma' imponik ta chi nuwach</para>
  <para style="q">i na a'n taq i hat aj Babilonia</para>
  <para style="q">ruum xa re' rusachariik kiwach i tinamit</para>
  <para style="q">wilkeeb' wach ak'al taq i na a'n.</para>
  <para style="q">Ruum aj re', re' naa nub'anam taq aweh i ti' k'axik</para>
  <para style="q">naa taq wesam i runimaal awach</para>
  <para style="q">naa ruqopariik ru i q'aaq' taq aatinamiit.</para>
  <para style="q">
    <verse number="26" style="v" />Naa ruyojib'iik chi jumpech</para>
  <para style="q">ma' jino'q chik i rab'ajiil naa rokiik chi yejemb'al paat.</para>
  <para style="q">Xti korik chi naa rukahniik chi xan tz'irik chik paam chi jumpech,</para>
  <para style="q">inki QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Re' taq i hat chajosaj taq itz'ihy rehtalil</para>
  <para style="q">i q'aq'inik chinaah i tinamit Babilonia, eh chaxulej taq aatuun,</para>
  <para style="q">reh chi nee kichalik i tinamit chub'anariik keh i tinamit re' re'.</para>
  <para style="q">Eh chak'am cho chikinaah taqe i kireey i aj Ararat,</para>
  <para style="q">i aj Mini, i aj Askenaz, chapab'aa' taq jino'q,</para>
  <para style="q">k'amal rub'eeh i q'aq'inik,</para>
  <para style="q">chak'am taq chaloq i ruk'ihaal kawáyu, xa je' chik ruk'ihaal nimaq chili'l.</para>
  <para style="q">
    <verse number="28" style="v" />Chaq'or taq keh i nimaq tinamit chi chaloq kian reh i tinamit Babilonia.</para>
  <para style="q">Chaq'or taq keh i kireey i aj Media,</para>
  <para style="q">i k'amal b'eeh,</para>
  <para style="q">i ki itaaq'anik sut i wach ak'al, inki.</para>
  <para style="q">
    <verse number="29" style="v" />Re' i Jeremías je' wili i xuq'or:</para>
  <para style="q">Re' taqe i aj q'aq'ineel xan k'uyu'jik chik ak'al naa kianam</para>
  <para style="q">noq naa rojiik eloq wach i ruyejaam cho wach i QaJaaw</para>
  <para style="q">re' chi naa rukanaam i tinamit Babilonia chi xan tz'irik chik paam.</para>
  <para style="q">
    <verse number="30" style="v" />Re' taqe i ki soldado i aj Babilonia</para>
  <para style="q">naa kikanaam i q'aq'inik,</para>
  <para style="q">naa kikahniik chupaam</para>
  <para style="q">i kiye'aab' naa ruk'uhliik i kaansil,</para>
  <para style="q">naa kikahniik chi xa je' chik taqe ixoq.</para>
  <para style="q">Eh naa ruchopariik naah i kitinamiit,</para>
  <para style="q">eh re' i kipaat naa rukojariik ruq'aq'al.</para>
  <para style="q">
    <verse number="31" style="v" />Eh xa kitahqeem chik kiib' i aj taqareel</para>
  <para style="q">noq naa rojiik kiq'orom</para>
  <para style="q">reh i kireey i aj Babilonia</para>
  <para style="q">chi xchoparik chik naah i rutinamiit.</para>
  <para style="q">
    <verse number="32" style="v" />Re' taqe i aj ixowaal naakitz'apam paam i b'eeh</para>
  <para style="q">chu'nchel naa kikojom ruq'aq'al imb'aan wii' i ko'linik iib'.</para>
  <para style="q">Eh re' i ki soldado i aj Babilonia ma' k'isiin ta naa kiyo'jiik.</para>
  <para style="q">
    <verse number="33" style="v" />Ruum re' i QaJaaw Dios nim rajaawriik, ki Dios i aj Israel je' wili i xuq'or:</para>
  <para style="q">Re' i tinamit Babilonia xailook' chik insacharik wach,</para>
  <para style="q">je' rukab' i trigo k'achi' ruq'anb'iik i wach</para>
  <para style="q">xailook' chik inq'ojarik paam chi chee', inki.</para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" />Re' taqe i aj Sión je' wili i naa kiq'orom:</para>
  <para style="q">Re' i Nabucodonosor kireey i aj Babilonia</para>
  <para style="q">xusachib'eej wach i chib'ih qeh,</para>
  <para style="q">xukanaa' chi xa je' jino'q pulato ma' xta paam.</para>
  <para style="q">Eh re' chik i reh xinujisaj riib',</para>
  <para style="q">je' rukab' noq i runujisaj riib' i qaman josq'laj chikop.</para>
  <para style="q">Eh xoj resaj reje panqatinamiit.</para>
  <para style="q">
    <verse number="35" style="v" />Yu'naak aj re' naa kitojom wach i tinamit Babilonia</para>
  <para style="q">ruum re' i kireey xkesaj i qajaawriik,</para>
  <para style="q">eh ruum chi xkian ti' k'axik qeh.</para>
  <para style="q">Eh re' kaansanik xub'an qeh</para>
  <para style="q">naa kitojom wach chu'nchel i aj Caldeo, inko'q taqe.</para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" />Re' i QaJaaw Dios je' wili xuq'or keh i aj Israel:</para>
  <para style="b" />
  <para style="q">Re' hin naa nuq'ajam wach keh i ki-ixowanik taq awach</para>
  <para style="q">i xkian taq aweh.</para>
  <para style="q">Eh naa nuchiqsam taqe i raasb'al ha', taqe i nim ha' wilkeeb' paruyuq'ul i Babilonia.</para>
  <para style="q">
    <verse number="37" style="v" />Naa ruyojib'iik, naa rusachariik wach,</para>
  <para style="q">naa rukahniik chi kiye'aab' xojb',</para>
  <para style="q">ma' awach ta chik i naa rupatiniik chupaam.</para>
  <para style="q">Eh ma' k'isiin ta naa kiyo'jiik awach i naa kilwiik reh.</para>
  <para style="q">
    <verse number="38" style="v" />Re' taqe i aj Babilonia naakik'erem kichii' ruum i ti' naakik'ulum,</para>
  <para style="q">xa je' chik rukab' noq i ruk'er chii' i nimlaj b'ahlam, oon rak'uun b'ahlam.</para>
  <para style="q">
    <verse number="39" style="v" />Eh noq naakitz'ab'iik je' naa k'ah laj ha' i naa nuye'em keh chi uuk'jik,</para>
  <para style="q">je' na naakixohk'riik, naa ruyojiik kina'ojb'al,</para>
  <para style="q">je' na naakiqajik chi suq laj wirik,</para>
  <para style="q">ma' jaruuj chik naa runa'lojiik keh.</para>
  <para style="q">
    <verse number="40" style="v" />Re' hin naa nukansam taqe je' rukab' noq kinkanteesjik, taqe imas tentzun,</para>
  <para style="q">taqe ixoq kaprax, i imas kaprax noq</para>
  <para style="q">kik'amarik reje pankanteesb'al, inki i QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="41" style="v" />Re' i kitinamiit i aj Babilonia naa rusachariik wach,</para>
  <para style="q">re' naq i xti wilik rib'iral chupaam chu'nchel</para>
  <para style="q">i tinamit wach ak'al chi xiik' naah nimaal wach.</para>
  <para style="q">Yu'naak naa ruchopariik naah, naa kiyo'jiik i aj pan nimaq tinamit ruum i naa ruk'ulum.</para>
  <para style="q">
    <verse number="42" style="v" />Re' taqe i aj Babilonia xa je' chik kikab' i rub'ohl i palaw</para>
  <para style="q">noq naa ruchaliik i aj ixowaal chikinaah, naa rusachariik kiwach.</para>
  <para style="q">
    <verse number="43" style="v" />Re' taqe i ju'junseht chirutinamiit naa kikahniik chi xan tz'irik chik paam.</para>
  <para style="q">Eh ma' naa ta chik ruwihiik patineel chupaam,</para>
  <para style="q">ma' awach ta chik i naa rik'iik ar.</para>
  <para style="b" />
  <para style="q">
    <verse number="44" style="v" />Re' hin naa rojiik nuq'uchum chupaam i rupaat i tiyoox Bel rub'ihnaal,</para>
  <para style="q">nik' nimaal i xkik'am reje Babilonia.</para>
  <para style="q">Re' taqe i tokoom tinamit ma' naa ta chik kichaliik ruuk',</para>
  <para style="q">eh naa ruq'ehb'iik wach ak'al i tz'aq kotimaj wii' riij.</para>
  <para style="q">
    <verse number="45" style="v" />Re' taq i hat nutinamiit eleen taq cho chi kixilak</para>
  <para style="q">chako'leej taq riij aak'achariik</para>
  <para style="q">chuwach i runimaal i nujosq'iil naa nuye'em cho chikinaah.</para>
  <para style="q">
    <verse number="46" style="v" />Maa yohb'isaj taq awiib'</para>
  <para style="q">ruum i ti' k'axik naa taq ab'iram rib'iral chupaam i tinamit</para>
  <para style="q">eh chupaam i ju'jun chi haab' xa reh reh wach i ti' k'axik naa rib'irjiik,</para>
  <para style="q">naa rib'irjiik chi k'ahchi' ikaansanik chupaam i tinamit.</para>
  <para style="q">Eh naa kitoq'aam peleto chikiwach i ajaab'ees.</para>
  <para style="q">
    <verse number="47" style="v" />Eh ponik reh i q'iij chi naa nuye'em panti' k'axik i tinamit Babilonia</para>
  <para style="q">je' wo' taqe i kitiyoox.</para>
  <para style="q">Re' taqe i kitinamiit naa kikahniik chi ma' xta chik kajaawriik,</para>
  <para style="q">aha' ta chik ma' naa rukahniik tuuch' i kiti'jolal.</para>
  <para style="q">
    <verse number="48" style="v" />Re' taqe i wilkeeb' pan taxaaj i wilkeeb' wach ak'al</para>
  <para style="q">ma' k'isiin ta naa rusuqb'iik kik'ux noq naakilom</para>
  <para style="q">chi naa rusachariik wach i tinamit Babilonia.</para>
  <para style="q">Re' noq naa kichaliik pantz'eet reh i rookb'aal i q'iij i naa rusachwiik wach.</para>
  <para style="q">
    <verse number="49" style="v" />Re' i tinamit Babilonia naa rusachariik wach</para>
  <para style="q">ruum i kikanteesjiik i aj Israel xub'an,</para>
  <para style="q">ruum ikaansanik xub'an chi junsuut i wach ak'al, inki QaJaaw Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="50" style="v" />Re' taq i hat naa taq ako'leem awiib' chuwach i kimik,</para>
  <para style="q">naa taq amolom chi elik, ma' aha' ta chik taq nee tipahiik.</para>
  <para style="q">Eh i ruk'ul chi naa taq akapaam i QaJaaw Dios,</para>
  <para style="q">eh chi naa ruk'uliik taq panak'ux i tinamit Jerusaleem.</para>
  <para style="q">
    <verse number="51" style="v" />Re' hoj q'e' qoh k'ixik</para>
  <para style="q">noq qohkib'aj.</para>
  <para style="q">Eh xan qatz'ap chik i qawach ruum qak'ixiik,</para>
  <para style="q">ruum re' taqe i tokoom tinamit xi okik chupaam i Santolaj ye'aab'</para>
  <para style="q">wilik parupaat i qaDios, tiko'q taq.</para>
  <para style="b" />
  <para style="q">
    <verse number="52" style="v" />Re' i QaJaaw Dios je' wili i xuq'or:</para>
  <para style="q">Re' hin xailook' i nuyeew taqe panti' k'axik i aj Babilonia, je' wo' taqe i kitiyoox.</para>
  <para style="q">Eh chupaam i kitinamiit naakik'erem kichii' taqe i naa kiq'ojib'iik.</para>
  <para style="q">
    <verse number="53" style="v" />Atoob' ta naq inche neenjohtik kopan taxaaj</para>
  <para style="q">chi keb'anik riib' i tinamit Babilonia.</para>
  <para style="q">Re' hin xa nee wo' i nutaq'aaj reje i aj ixowaal reh chi ar neenooj sacharoq wach,</para>
  <para style="q">inki Dios.</para>
  <para style="b" />
  <para style="q">
    <verse number="54" style="v" />Naa rib'irjiik noq re' taqe i aj Babilonia naakik'erem kichii' chi oq'ik,</para>
  <para style="q">ruum i ti' naakik'ulum, ruum chi naa rusachariik wach i kiye'aab' i aj Caldeo.</para>
  <para style="q">
    <verse number="55" style="v" />Ruum re' i QaJaaw Dios naa rusacham kiwach i aj Babilonia,</para>
  <para style="q">naa resam i runimaal kiwach.</para>
  <para style="q">Re' taqe i aj ixowaal yohb'aal wach i kijosq'iil noq naa ruk'uliik iloq chikinaah,</para>
  <para style="q">xa je' chik rukab' i rub'ohl i palaw.</para>
  <para style="q">
    <verse number="56" style="v" />Re' keh naa kisacham wach i aj Babilonia,</para>
  <para style="q">naa ruchopariik i ki soldado kow kiib'.</para>
  <para style="q">Eh re' i kiflecha naa wo' kitoqib'eem,</para>
  <para style="q">ruum re' i QaJaaw naa ruye'em taqe chi tojariik i kimahk</para>
  <para style="q">je' rukab' i ruk'ul chi keh.</para>
  <para style="q">
    <verse number="57" style="v" />Re' i Reey i QaJaaw Dios nim rajaawriik, je' wili i ruq'or:</para>
  <para style="q">Re' hin naa nuxohk'risam taqe i k'amal kib'eeh i aj Babilonia,</para>
  <para style="q">taqe i wilik kina'ojb'al, taqe i k'amal rub'eeh tinamit,</para>
  <para style="q">taqe i nimaq wach kikamaj, taqe i ki soldado.</para>
  <para style="q">Eh naa nuqasam i kiwiriik ma' jaruuj chik naakik'raam kiib'.</para>
  <para style="q">
    <verse number="58" style="v" />Re' hin i Dios nim wajaawriik,</para>
  <para style="q">i nuq'or chi re' i nim wach tz'aq kotimaj wii' riij i tinamit Babilonia</para>
  <para style="q">naakich'ahaam wach ak'al i aj ixowaal.</para>
  <para style="q">Eh re' taqe nimaq taq puerta naa ruqopariik ruq'aq'al,</para>
  <para style="q">naa rojiik wach ak'al i kamanik kianam i k'ihset chi tinamit,</para>
  <para style="q">xa q'aaq' naa rusachwiik wach kikamaj, inki.</para>
  <para style="b" />
  <para style="p">
    <verse number="59" style="v" />Eh kijib'-oq chik haab' rokiik chi reyil i Sedequías Judá, re' i Jeremías jalal ruq'oral i Dios xuyeew jinaj i taqarik reh i Seraías rak'uun i Nerias riih i Maasías. Re' i Seraías ruch'ihil i reey Sedequías noq xooj Babilonia, re' reh xyej-anik reh aha' inwirik i reey. <verse number="60" style="v" />Re' i Jeremías rutz'ihb'aam chik chupaam i jumb'oht chi huuj taqe i xq'orarik chi riij i tinamit Babilonia. Re' chi naa ruchaliik i runimaal ti' k'axik chinaah, re' chu'nchel i tz'ihb'amaj chi naa ruk'ulum. <verse number="61" style="v" />Re' i Jeremías je' wili xuq'or reje reh i Serarías: Noq naa aponiik Babilonia kow chawil wach chu'nchel taqe i q'orik tz'ihb'amaj chupaam i jumb'oht chi huuj. <verse number="62" style="v" />Eh je' wili i aatiij naa a'nam: QaJaaw Dios re' hat xat q'orik chi naa asacham wach i tinamit wili, reh chi ma' naa ta chik rub'aan patinik chupaam, ni xata naq chik chikop i naa ruwihiik chupaam, ruum re' hat naa akanaam chi xan tz'irik chik paam chi jumpech, tiko'q. <verse number="63" style="v" />Eh re' jumb'oht chi huuj wili neenab'ak' chuwach jino'q ab'aj neenakut qohoq chupaam i nim ha' Éufrates. <verse number="64" style="v" />Eh je' wili i neenaq'or: Je' aj wili noq naa rumuhqiik naah i tinamit Babilonia, ma' jaruuj chik naa reliik chupaam i ti' k'axik naa ruye'ariik chinaah ruum i Dios, tiko'q, inki. Ayu' xkuxik wach i ruq'oral i Jeremías.</para>
  <chapter number="52" style="c" />
  <para style="s">Re' noq xwihik chi reyil i Sedequías</para>
  <para style="r">(<ref loc="2KI 24:18-20">2 Rey 24.18-20</ref>; <ref loc="2CH 36:11-16">2 Cron 36.11-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Re' i Sedequías jinaj ru ka'winaq haab' i wilik reh noq xokik chi reyil ar Jerusaleem, eh junlaj haab' xwihik chi reyil. Eh re' i rutuut Hamutal rub'ihnaal rixq'uun Jeremías jinaj chik aj Libna. <verse number="2" style="v" />Re' i Sedequías xa re' i yiib' wach na'ojb'al xub'an chuwach i QaJaaw Dios, je' rukab' i xub'an i reey Joacim. <verse number="3" style="v" />Ruum aj re', re' i QaJaaw Dios xchalik rujosq'iil chikinaah i aj Jerusaleem, i aj Judá, xuq'eb' taqe chi riij ruk'ux. Re' i reey Sedequías xuq'etwachej riib' chuwach i kireey i aj Babilonia.</para>
  <para style="s">Re' noq xsacharik wach i tinamit Jerusaleem</para>
  <para style="r">(<ref loc="2KI 24:20-25:7">2 Rey 24.20—25.7</ref>; <ref loc="JER 39:1-7">Jer 39.1-7</ref>)</para>
  <para style="p">
    <verse number="4" style="v" />Eh pan rulajeeb' rub'eeh i ru lajeeb' poh reh i rub'eleej haab'rokiik chi reyil i Sedequías ar Judá. Re' i reey Nabucodonosor ruch'ihil taqe chu'nchel i ru soldado xi chalik chi q'aq'inik chinaah i tinamit Jerusaleem xkikotej riij. Eh xkiyejaa' i kiye'aab' chi junsuut reh chi ar naa kianam cho reh. <verse number="5" style="v" />Eh ar xi wihik chi junsuut i tinamit Jerusaleem chuwach i kiib' haab' korehtaal xub'an i junlaj haab' chi reyil i Sedequías. <verse number="6" style="v" />Eh parub'eleej q'iij reh i rukaaj poh reh i rujunlaaj haab'rokiik chi reyil i Sedequías, xooj chi nimaal i wi'jaleel chupaam i tinamit re' re', ma' ha' ta chik inkireq kiwa' i tinamit. <verse number="7" style="v" />Eh noq kotimaj kiij kuum i ki soldado i aj Babilonia. Re' i reey Sedequías ruch'ihil taqe i ru soldado xkiteh reje jinaj i kiik'b'aal chupaam i tz'aq kotimaj wii' riij i Jerusaleem, ar xi elik reje. Eh xi elik reje chi chii' i puerta wilik panyejaal i tz'aq, ma' najt ta ruuk' i tikooj wii' i ruhtz'uub' i reey, eh xkik'am qohoq i b'eeh wach k'ixkaab' chi chii' i nim ha' Jordán. <verse number="8" style="v" />Eh re' taqe i ru soldado i kireey i aj Babilonia xkitahqeej reje korehtaal xponik kireq i reey Sedequías wach k'ixkaab' Jericó. Eh xq'eb'arik kahnoq kuum taqe i ru soldado. <verse number="9" style="v" />Eh ar xkichop i reey Sedequías, xkik'am reje chuwach i kireey i aj Babilonia ar Ribla wilik paruyuq'ul i Hamat. Eh xuq'at i q'orik chinaah i reey Sedequías. <verse number="10" style="v" />Eh chuwach i Sedequías xyok'arik i kalaq i rak'uun rixq'uun ruum i Nabucodonosor ar Ribla, xukansaj taqe i k'amal kib'eeh i aj Judá. <verse number="11" style="v" />Eh re' kireey i aj Babilonia xresaj kab'chel i naq wach, reey Sedequías b'ak'lik i q'ab' chi riij chi karena noq xk'amarik reje Babilonia ar xkojarik prexo korehtaal xkimik ar.</para>
  <para style="s">Re' noq xsacharik wach i rupaat i Dios ar Jerusaleem</para>
  <para style="r">(<ref loc="2KI 25:8-21">2 Rey 25.8-21</ref>; <ref loc="2CH 36:17-21">2 Cron 36.17-21</ref>; <ref loc="JER 39:8-10">Jer 39.8-10</ref>)</para>
  <para style="p">
    <verse number="12" style="v" />Eh pan lajeeb' rub'eeh i roo' poh reh i rub'elejlaj haab' rokiik chi reyil i Nabucodonosor Babilonia, re' Nabuzaradán raj kamanoom i reey chi k'amal kib'eeh i soldado xponik ar Jerusaleem. <verse number="13" style="v" />Re' reh xuk'at i rupaat i Dios, je' wo' hoq i paat i rub'an wii' i taaq'anik i reey. Eh xuk'at taqe i paat chupaam i tinamit, je' wo' taqe i kipaat i xa atoob' wach kik'ux. <verse number="14" style="v" />Re' i Nabuzaradán ruch'ihil taqe i ki soldado i aj Babilonia xkituhb'aaj wach ak'al i tz'aq kotimaj wii' riij i tinamit Jerusaleem. <verse number="15" style="v" />Re' i Nabuzaradán xuk'am reje Babilonia i tinamit nik' kik'ihaal i koxikahnik Jerusaleem, je' wo' taqe i xkiq'asaj kiib' chi kixilak i ki soldado i aj Babilonia, xuk'am wo' taqe reje chu'nchel i tinamit. <verse number="16" style="v" />Eh re' Nabuzaradán k'amal kib'eeh soldado, xa re' wo' chik xukanaa' pan tinamit Judá i kok'neb'aa', eh xuyeew kiye'aab' reh chi xkitik ki uuva.</para>
  <para style="p">
    <verse number="17" style="v" />Re' taqe i aj Babilonia xkixereb'eej i kulk, i xa chib'ih chik jariik re' ruuk' q'an ch'ihch' wilkeeb' parupaat i Dios. Eh je' wo' i nimaq pilalix, i ch'ikaab' reh i molb'al ha', i xa chib'ih chik jariik re' ruuk' q'an ch'ihch' xkik'am reje Babilonia. <verse number="18" style="v" />Eh xkik'am wo' reje taqe i molb'al chaaj, taqe i likb'al, taqe i nimaq taq xun, taqe i nimaq taq cucharo, xkuxik kik'amam reje chu'nchel i kulk, je' wo' hoq i xa chib'ih chik jariik i re' ruuk' i q'an ch'ihch' inkamanik chupaam i rupaat i Dios. <verse number="19" style="v" />Re' k'amal kib'eeh soldado xuk'am reje Babilonia i re' ruuk' i oro, re' ruuk' plata re' taqe i wili: Re' i likb'al ha', re' i ye'aab' nah wach q'aaq', re' i nimaq kulk, re' i molb'al chaaj, re' i ye'aab' kantela, re' i nimaq cucharo, re' i kulk impajarik wii' i riis uuva inye'arik chi mayiij. <verse number="20" style="v" />Re' taqe i kiib' chi pilalix, re' i nimlaj molb'al ha', re' taqe i kab'laj chi imas wakax re' ruuk' i q'an ch'ihch', i ch'iklik wii' i molb'al ha', re' taqe i flecha, re' ruyejaam chaloq i reey Salomón chi naa rukahniik parupaat i Dios, re' taqe re' ma' pajooj taj i kahliil ruum q'an ch'ihch' korjinaq wii'. <verse number="21" style="v" />Re' i kiib' chi pilalix laj taq b'ara rooq, re' i runinqaal kipaam ach k'isiin ma' wuqtaq b'ara, eh re' i runimaal i q'an ch'ihch' chikiij kaj taq q'ab', eh hoop kipaam i pilalix re' re'. <verse number="22" style="v" />Re' taqe i kiib' chi pilalix re' re' ik'inaq ixib' b'ara i kiju' b'otooj riij chi q'an ch'ihch' xoyimaj i kiju' chi tolotaq je' kiwach chee', eh q'an ch'ihch' korjinaq wii', eh elik wach i b'anooj keh kab'chel. <verse number="23" style="v" />Eh ach kijib' ma' jinaj siento chi tolotaq chi je' wach chee' wilik chi junsuut i kiju', eh jinaj siento i xa jinaj kimolom wii' kiib'.</para>
  <para style="p">
    <verse number="24" style="v" />Re' i Nabuzaradán k'amal kib'eeh soldado xuchop i Seraías rajaaw i k'amal kib'eeh i aj tiij, ruch'ihil i Sofonías rukab' k'amal kib'eeh aj tiij, kuch'ihil ixib' chi winaq kicha'jinik reh i rupaat i Dios. <verse number="25" style="v" />Eh xuchop haa' taqe i wilkeeb' Judá, eh xuchop ink'amwik kib'eeh i soldado, je' wo' taqe i wuquub' chi winaq i kib'anik naq reh rutaqariik i kireey i aj Judá, ar xkireq pan tinamit. Eh xuchop wo' haa' i winaq i molwik kiwach i winaq reh ojik chi soldado hiil, xuchop wo' taqe i oxk'ahl chi winaq xkireq ar pan tinamit. <verse number="26" style="v" />Eh re' i Nabuzaradán k'amal kib'eeh soldado chu'nchel taqe re' xuk'am reje chuwach i kireey i aj Babilonia wilik ar Ribla. <verse number="27" style="v" />Re' i kireey i aj Babilonia ar xkuxik taqe rukansam i aj Judá re' re' ar Ribla wilik chupaam i ruyuq'ul i Hamat. Je' re' noq xi k'amarik reje pan tokoom tinamit i aj Judá.</para>
  <para style="p">
    <verse number="28" style="v" />Re' taqe i tinamit wili xi k'amarik reje ruum i Nabucodonosor noq wuquub' haab' rokiik chi reyil je' wili kik'ihaal: ixib' miil ruuk' ixib' ru ka'winaq chi aj Judío. <verse number="29" style="v" />Eh noq waxaqlaj haab' chik rokiik chi reyil xuk'am taqe reje i waxiqiib' siento ruuk' kab'laj ru ka'winaq chi aj Jerusaleem. <verse number="30" style="v" />Eh noq ixib' ru ka'winaq haab' rokiik chi reyil, re' i k'amal kib'eeh soldado Nabuzaradán xuk'am wo' chik taqe reje Babilonia i wuquub' siento ruuk' ho'oob' roxk'ahl chi aj Judío, Chu'nchel i xi k'amarik reje Babilonia xponik kijib' miil ruuk' waqiib' siento (4,600) chi tinamit.</para>
  <para style="s">Re' i Joaquín x-ehtesjik prexo, eh xye'arik ruloq'il ar Babilonia</para>
  <para style="r">(<ref loc="2KI 25:27-30">2 Rey 25.27-30</ref>)</para>
  <para style="p">
    <verse number="31" style="v" />Eh noq ho'oob' ru ka'winaq rub'eeh i ruka'b'laj poh reh i wuqlaj ru ka'winaq haab' ruk'amariik reje prexo i Joaquín ar Babilonia, re' i xwihik cho chi reyil ar Judá, chupaam i peet haab' rokiik chi reyil ar Babilonia i Evil-merodac. Re' reh xuketelaaj wach i Joaquín xresaj chi prexohjik. <verse number="32" style="v" />Eh xuq'oreej panotob'il, xa re' wo' reh q'e' xuk'ax chuwach taqe i reey wilkeeb' ruuk' ar Babilonia. <verse number="33" style="v" />Je' re' noq xresaj i ruso' prexo chi riij i Joaquín, eh jinaj inki a'n wii' kiwa' nah mexa ruuk' nik' chik najtiil xk'acharik. <verse number="34" style="v" />Eh eqal eqal inye'arik reh ruum i kireey i aj Babilonia aha' wilik i ruk'uxlaaj wii' riib', je' re' i xb'aan reh nik' najtiil xk'acharik ar korehtaal chik xkimik.</para>
</usx>