<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id">JONVAGIRI PROJect</book>
  <para style="toc3">యోనా</para>
  <para style="toc2">యోనా</para>
  <para style="toc1">యోనా</para>
  <para style="mt1">యోనా</para>
  <para style="imt1">పరిచయం</para>
  <para style="is">గ్రంథం లిఖ్యొతె</para>
  <para style="ip">యోనా పుస్తకం బైబిల్ మా ఛాతే హాఃరు పుస్తకంతీబి అఖ్కనా అర్దం హూ లిఖ్హాయైరూస్. ఆ పుస్తకం దేవ్ ని వాతేనా మీరీన్ మీలైలేనూ కరి దేక్యొతే ఏక్ ప్రవక్తనూ టెకే. యోనా ఏక్ అమీతాయి నో ఛియ్యో.ఇన ఏక్ ధన్నె యోహోవానే నినేవె నంగర్ మా అక్కుజణు కారబ్ కామ్ కరూకరతే దేఖిన్ యో నంగర్ పూర ఉజ్జడ్ హూసేకరి యో వాత్ నా జైన్ యువనా బోల్ కరి బోలమా యోనా ఇం నాకర్ నూతిం దూర్ చలేగొ. తెదె యేహోవానే ఇన కెత్రుకి కష్టల్ ఘాలామా తెదె యో ఇను తప్పు మాలంకర్లీన్ దేవ్ బోల్యొతే కాం కర్యొ. తెదె నినేవెమా జైన్ తుమె పాపం కరనూ మేందేవో న్హైతో ఉజ్జడ్ హూయిజాసు కరి బోలమా, యూవునే పాశ్చతాపం పడమా యేహోవానే దేఖిన్ యూవనా ప్రేమించిన్ భచయో.</para>
  <para style="iot">ఆ వాతె ఛాతే అధ్యాయల్</para>
  <para style="io1">దేవ్ ని బులావట్ నా వూలంగ్యోతే యోనా 1:1-17</para>
  <para style="io1">యోనా పశ్చాతాపం హూవమా చొఢయో 2:1-10</para>
  <para style="io1">నినేవె నంగర్ మా యోనా వాతె కర్యోతే 3:1-10</para>
  <para style="io1">నినేవె నంగర్ నా ఉప్పర్ దేవ్ ని దయా 4:1-11</para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">దేవ్ని వాతేనా హఃమ్జ కొయినితే యోనా</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />యెహోవా వాత్ అమిత్తయినో ఛియ్యో యోనాతి ఆ వాతెన బోల్యొ. <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />నీనెవె ఏక్ మోటు నంగర్. ఇనమా ర్హావాళు అద్మీయే హాఃరు కర్రాబ్ కామ్ కరుకరతే యెహొవా దేవ్నె దేఖిన్, తూ ఉట్టిన్ యో నంగర్మా జైన్ తుమె కరుకరతే కర్రాబ్ కామ్నా మ్హెందెవోకరి బొల్లిదా. ఆ నంగర్ వాలు కర్యుతె ఖర్రాబ్ కామ్ మార నజర్మా ఘణు ఘోరంతి ఛా. <verse eid="JON 1:2" /><verse number="3" style="v" sid="JON 1:3" />తెదె యోనా దేవ్ను వాతె హఃమ్జో కొయిని. ఇనటేకే ఇని హాఃమేతు దూర్ జానుకరీ దిల్మా షోఛిలీదొ. ఎజ్గాతో నిక్లిన్, యొప్పెనా ఝాజ్మా బీరాతె జోగొ జైన్ ఏజ్గాతూ తర్షిషు జావాళి ఏక్ ఝాజ్ నా దేఖిన్, ఇన హూవయెత్రు చార్జినా రఫ్యాదీన్, ఝాజ్ మా ఛడీన్ బేషిగయో.<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />యో ఝాజ్ జావజావమా దేవ్నె ఏక్ మోటు వాయిరో తుఫాన్నా బోలిమొక్లో. తుఫాన్ జాహఃత్ హుయీన్ పాణి హాఃరు ఝాజ్మా భరాయిగయు. <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />యో ఝాజ్మా ఛాతె అద్మీయేహాఃరు గ్హణు ఢరీజైన్, ఇవ్నుఇవ్ను దేవ్నా హాఃలామ్ కర్యు. ఝాజ్ హాల్కు హూవనాటేకె ఇన్మా ఛాతె ఖావనురాచు హాఃరు పాడిన్ బ్హాధర్ ఫేక్యు దిదు. ఇవ్నేతి అగాఢీస్ యోనా ఝాజ్ను హేట్ను భాగంమా జైన్ లింధర్ లెంకర్తొ.<verse eid="JON 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 1:6" />తెదె ఝాజ్ను నావికుడ్ యోనాను కందె ఆయిన్ “తూ షాత్ కరుకరాష్‌? ఓ నింధర్‌లెంకరాతే తూ కోణ్? తూ ఉట్టీన్ తారు దేవ్నా హాఃలామ్ కర్! ఏక్‌థార తారొ దేవ్‌ అప్నా కనికరంచాస్కీ అప్నె నాషనం నాహోనుతిమ్ దేక్షెసీకి” కరి ఇనేతి బోల్యు.<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />ఎత్రాస్‌మా నావికుల్ “కినా భన్తీ అత్రే కీడు అప్నా ఆయుకీ మాలంకరనాటేకె అవ్నె చీట్లు నాఖియే ఆయో” ఏక్తియేక్‌ బొల్లీన్‌, చీట్లు నాఖ్యు. చీటీ యోనాను నామ్తి ఆయు. <verse eid="JON 1:7" /><verse number="8" style="v" sid="JON 1:8" />అనటేకె ఇవ్నే “కిను కారణంతీ ఆ కీడు ఆయుకీ హమ్నా బోల్‌. తారు దందో షాత్? తూ కెజ్గతూ ఆయో? తారు కెహూ దేహ్ః? కెహూ అద్మియేతకంతూ ఆయో?” కరి యోనానా పుఛ్చాయు.<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />ఇనె ఇవ్నేతి అమ్ బోల్యొ. మే హెబ్రీవాలొ, ధర్యావ్నా జమీన్నా సృష్టికర్త, ఆకాష్‌మా ఛాతె దేవ్‌హుయోతె యెహోవా భన్తి‌ భయభక్తీ రాఖిన్‌ ర్హావాలొ. <verse eid="JON 1:9" /><verse number="10" style="v" sid="JON 1:10" />ఇవ్నె జాహఃత్తి ఢరిజైయిన్ ఇనేతి “తూ కర్యొతె కామ్‍ ష్యాత్?” బోల్యొ. షానకతో ఇనె యెహోవా సన్నధికంతూ మిలాయిలెంకరాష్‌కరి ఇనె ఇవ్నా బోల్యొ. <verse eid="JON 1:10" /><verse number="11" style="v" sid="JON 1:11" />తెదె ఇవ్నే యోనాతీ “ధర్యావ్ హమారటేకె షోపొర్హానుకతో హమే తునషాత్ కర్ను?” కరి పుఛ్చాయు. షానకతో ధర్యావ్ అజూ జాహఃత్‌హోతూ ఛా.<verse eid="JON 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12" />యోనా ఆంబోల్యొ, “ఆ తుఫాన్ మారటేకెస్ ఆయుకరి మన మాలం. మన పాడిన్ ధర్యావ్మా నాఖిదేవొ, తెదె ధర్యావ్ తుమారఫర్ ఆవకొయినితిమ్ భీరిజాషె” కరి ఇవ్నా జవాబ్‌దిదొ.<verse eid="JON 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13" />తెదె ఝాజ్నా కనారిలిన్ జానూకరి కెత్రు హిమ్మత్ కర్యూతోబి వాయిరో గణు హూయిజైన్ ఇవ్నహఃత్ కోహూయిని. <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />ఇనటేకే ఇవ్నే యెహోవా దెవ్నా ఆ తారి ఇష్టంతీస్ హూయు, అ ఆద్మీతి హఃమ్నా కాయి నకోకరీస్ , ఆనా మార్యకరీ హఃమ్నా తూ నకోమారీస్కరి యెహోవాతీ ప్రార్దన కర్యూ. <verse eid="JON 1:14" /><verse number="15" style="v" sid="JON 1:15" />తెదె ఇవ్నె యోనానా ఝాజ్మాతు పాడిన్ ధర్యావ్ మా పెక్యూదిదూ. ధర్యవ్ తెదె తండో హుయిగయు. <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />తెదె యెహోవా దేవ్తీ ఢరీజైన్, ఇన పూజకరీన్ బలిదిన్, మొక్కుబడి దెవ్నా ఒప్పిలీన్, జైన్ ఇం కర్యొ.<verse eid="JON 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17" />యెహోవా దెవ్నె ఏక్ మోటా మాస్లాన నియమింఛో, యోనాన తుజైన్ గళీలా, ఇన తీన్‍ధన్‍ మాస్లాన పేట్మా రాయో.<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">యోనా మాస్లాను పేట్మాతు ప్రార్దన</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />యో మోటా మాస్లాను పెట్మాతు ఆంభోలిన్ యేహోవా<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">పరలొకంమా ఛాతె దాధజీ</char></note> మారి ప్రార్దన<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">దేవ్ తీ వాతె బొలానూ</char></note>కర్యో.<verse eid="JON 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JON 2:2" />“మే గణు మోటు భార్మిమతు యెహోవాన హఃయల్ కర్లేవమా, యో మన జవాబ్ దిదో. మోటు ఖవాయిమతూ మే తూనా చిక్ర్హామా తూ మారీ ప్రార్థన హఃమ్జి రాక్యోస్.<verse eid="JON 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3" />తూ మన అగాధంమా, ధర్యావ్నుగర్భంమా నాఖిదిదొ. పాణినూ ఝుకాళో మన ఆస్పీస్‌ లప్టిరాక్యూస్‌. తారు ఝుకాళో తరంగాలూ మారు ఉప్పర్ జంకరాష్‌.<verse eid="JON 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4" />తారు సన్నిధికంతూ మన నహాఃడీన్‌ నాఖ్యొతె, తారు పరుషుద్ధాలయం బాజు దేఖిష్‌ సోఛిలెంకరూస్‌.<verse eid="JON 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5" />పాణి మన అస్పీష్ భరాయ్‌జావమా మే ఆఖరీనుజాన్‌తీ ఛౌ. ధర్యావ్ను ఘధర్ మన ఆవరించి ఛా. ధర్యావ్ను పాంజియే మారా ముఢ్క్యానా లప్టిరాక్యుస్.<verse eid="JON 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6" />మే కెదేబి చఢీన్‌ నాఆవ్నుతిమ్ జమీన్నూ గడియాల్ మన మూచినాఖ్యు. పర్వత్ను పునాధిమా మే ఉత్రీన్ గైరోస్, మారొ దేవ్, యెహోవా, తూ మారు జాన్నా అగాధం మతూ ఉప్పర్ ఉట్టాడి రాక్యోస్.<verse eid="JON 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7" />మారు జాన్ మారమా కృషీస్తూ ర్హయుతో మే యెహోవానా హఃయల్ కర్లిదో. తారు పరిషూద్ధ్‌ దేవల్మా తారు ఖందె మారు ప్రార్థన చేర్యు.<verse eid="JON 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8" />ఫాల్తుహుయుతే మూర్తియే దేవ్‌ఫర్ లక్చ్యం హాఃలామ్ కరవాళనా ఇవ్నటేకె తారు కేహూ సహాయంబి కోమాళని.<verse eid="JON 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9" />మే హుయోతో మే కృతజ్ఞతాస్తుతుతీ తున బలి సమర్పించుకరాస్‌. మే మొక్కిలీదొతె ఇనా ఖఛ్చితంగా కరీస్. యెహోవా ఖందేస్ బఛ్చాణ్ మల్చె.”<verse eid="JON 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10" />తెదె యెహోవానే యో మోటా మాస్లానా బోలమా యోనాన భాధర్ కనారిను ఉప్పర్ ఆయిన్ ఓక్రి నాఖ్యు.<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">యోనా దెవ్ను వాత్ హఃమ్జొ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />యెహోవాను వాతె బెంమ్మని వహాఃత్ యోనానా ఆయిన్ బోల్యుతె షాత్‌కతొ. <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />తూ ఉట్టీన్, నీనెవె మోటు నంగర్మా జైయిన్‍ మే తున ఆజ్ఞదిదోతె ఖబర్నా ఇనా ప్రచార్‌కర్‌.<verse eid="JON 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 3:3" />అనటేకె యోనా ఉట్టీన్ యెహోవాను వాత్నా లోబడీన్ నీనెవె నంగర్నా చాల్తొహుయిన్‌ గయో, నీనెవె నంగర్ దేవ్ను నజర్మా ఘణు మోటు. ఆ తీన్ ధన్ జావనుయెత్రె మోటు థూ.<verse eid="JON 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 3:4" />యోనా యో నంగర్మా ఏక్ ధన్ జావానుయెత్రు దూర్మా జైయిన్, అజూ 40 ధన్మా నీనెవె నంగర్ నాషనం హుయిజాషెకరి ప్రచార్‌ కర్యొ.<verse eid="JON 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 3:5" />నీనెవె నంగర్‌ వాలు దేవ్‌మా విష్వాస్‌ రాఖిన్‌ పస్తు ప్రచార్‌కర్యు. గొప్పవాలు, మాములీఅద్మియే హాఃరుజణు ఛైను గోతం బాందిలీది.<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />ఆ సంగతి ఎగ్గీస్‌మా నీనెవె రాజొనా చేర్యు. ఇనె ఇను సింహాసనం ఉత్రీన్, ఇను రాజను లుంగ్డనా కాఢినాఖీన్, ఛైనుగోతంనా బాందిలీన్‌ రాఖ్‌మా బేస్సిగొ. <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />ఇనె అమ్‌ ప్రచార్‌ కరాయో “రాజొ ఇను మంత్రుల్ ఆజ్ఞాదేయ్తె షాత్‌కతో, అద్మియే షాత్ని నాఖాణు. దాండబోక్డా చారో నాఖాణు, పాని నా పీణు.” <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />ఏక్ ధన్నె దేవ్ అద్మినాటేకె యోనాను దిల్ బదలి జానుకరి బుజు అప్నా మర్రాఖ్యొకొయినితిం ఇను చంఢాల్ను కామ్నా కరిలిదొ, అద్మినా హాఃరు ఖర్రాబ్ కామ్ కరుకరాతే ఇవ్నే హాఃరు బులిజాణుకరి బోల్యొ. <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />బుజు ఆద్మియెను దాండ,బొక్డాహాఃరు దెవ్నా హఃలామ్ కరునుకరి దెవ్నా దుత్తలు నీనెవెగామ్మ ఛాతె అద్మినా బోల్యొ.<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />దేవ్ నినేవె హాఃయర్ అద్మియేన ఇవ్నుకరుకరతే ఖర్రాబ్ కామ్ బులిగయుకరి మాలంకరీన్ దేవ్ ఇవ్నా మాద్‌కరిన్ బుజు యో బొల్యోతె వాతేనా బద్లాయిలీన్ దేవ్ ఇవ్నా మ్హెందిదొ.<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s">యోనాను చంఢాల్ దేవ్ను దయా</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />పన్కి, ఆ యోనాను నజర్‌మా ఘణు గలత్‌నితరా సొఛ్చాయు. ఇనె చంఢాల్తీ మండిన్‌పడ్యు. <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />అనటేకె “మారు దేహ్ఃమా రయ్యోతెదె అమ్మాష్‌ హుసేకరి బోల్యొ కొయిన్నా! అనటేకెస్ మేస్‌ అగాఢి‌ తర్సీషునా మిలాయిలేవనా కోసీష్‌కర్యొ. షానకతో, తూ కృపహుయోతె దేవ్‌కరి, గోర్‌కరతె వాళొకరి, ఎగ్గీస్ చండ్డాల్‌కరతె వాళొ కాహెకరి, పూర్తితీ నమ్మకంహుయోతె వాళొకరీ, నాష్‌ కరనటేకె పీఠెజావాళొ కాహేకరి మన మాలం. <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />అనటేకె యోహోవా, హంకె మారు జాన్‌ కన్నాక్‌కరి బతిమాలుకరూస్‌. షానకతో మే జీవనా బదుల్‌తీబి మర్జానూస్‌ అష్యల్‌.”<verse eid="JON 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4" />తెదె యెహోవా “తూ యెత్రే చండ్డాల్‌కరను న్యాయమాస్‌న్నా?” కరి పుఛ్చాయో.<verse eid="JON 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5" />తెదె యోనా ఆ నంగర్ మతూ జైయిన్ ఇనా ధన్‌నికతేబాజు ఏక్ జొగొమా బేషిగొ. ఎజ్గా ఏక్‌ పందిల్ నాఖిలీన్, నంగర్‌నా సాత్ హువజాషెకీ దేక్నుకరి, ఆ పందిల్‌ను చాలమా బేసిగొ. <verse eid="JON 4:5" /><verse number="6" style="v" sid="JON 4:6" />యోహోవా దేవ్ ఏక్ మొక్కన తయార్‌ కరీన్, ఇనా హుయుతె బాధ కాడనటేకె, ఆ ఓదీన్‌ యోనాను ముఢ్క్యాను ఉప్పర్ ఛాళొ దేవహఃర్కు. ఆ మొక్కనా బట్టిన్ యోనా ఘణు ఖుషిహుయో.<verse eid="JON 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 4:7" />పాసల్ను ధన్నే దేవ్ ఏక్‌ కీడనా సిద్ధంకరిన్ రాఖ్యొ. ఆ యోమొక్కనా ఖైనాకమా యోఝాడు హుఃకాయిగు. <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />అన పాసల్‌ తడ్కో ఆయుతెదె, దేవ్ తూర్పుతు కంతూ వాగతె గర్మినువాయిరొ సిద్ధం కర్యొ. యోనానా తడ్కోను మార్‌ లాగిన్ గబ్రాయిన్‌ పడిగయో. “జీవను బదూల్ మర్జావను అష్యల్” కరి ఇను యో దిల్మాసోచిల్దొ.<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />తెదె దేవ్ యోనాతీ “ఆ మొక్కను బారెమా తూ యెత్రె ఛండాల్‌కరనూ న్యాయమాస్నా?” బోల్యొ. యోనా “జాన్ జావయెత్రు చండ్డాల్ ఖావనూ న్యాయమస్‌” కరి బోల్యొ.<verse eid="JON 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10" />అనటేకె యెహోవా “తూ కెత్రేబి మిన్హత్ కరకొయినితిమ్, పాల్యొకొయినితిమ్ ఇనుయోస్‌ ఒద్యుతె మొక్క ఫర్ తూ జాలిపడుకరాస్ని. ఆ ఏక్ రాత్మాస్ ఒదీన్ ఏక్ రాత్మాస్ హుఃకాహుయు. <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />హుయుతో నీనెవె మహా నంగర్మా అఛ్చు ఖర్రాబ్ మాలంకొయింతె ఏక్‌ లాక్ ఈహ్ః హజార్ తీబి జాహఃత్అద్మి, అద్మియే ఛా. ఘను దాంఢాబోక్డాబీ ఛా. ఇను బారెమా మే జాలిపడిష్‌కొయిన్నా?” కరి ఇనేతి బోల్యొ.<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>