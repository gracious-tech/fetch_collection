<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Vagri Old Testment</book>
  <para style="h">Amos</para>
  <para style="toc3">Amos</para>
  <para style="toc2">Amos</para>
  <para style="toc1">Amos</para>
  <para style="mt1">ఆమోసు</para>
  <para style="imt1">పరిచయం</para>
  <para style="is">గ్రంథం లిఖ్యొతె</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="s">ఆమోస్నా యెహోవాను సందేషం</para>
  <para style="r">(<ref loc="2KI 15:1-7">2రాజా 15:1-7</ref>; <ref loc="2CH 26:1-23">2దిన 26:1-23</ref>; <ref loc="2KI 14:23-29">2రాజా 14:23-29</ref>; <ref loc="JOL 3:16">యోవే 3:16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />ఇష్రాయేలీయుల్ను బారెమా తెకోవమాను మ్హేండను చరావవాలొ ఆమోసు దేక్యొతె హోఃణెమాను విషయం. యూదానురాజొ ఉజ్జియాను ధన్మా ఇస్రాయేల్ను రాజొ యెహోయాషు ఛియ్యో యరొబాము ధన్నేమా భూకంపం ఆవనా బేవరాహ్ఃను అగాఢి, ఇనె ఆ హోఃణె దేఖ్యొ. <verse eid="AMO 1:1" /><verse number="2" style="v" sid="AMO 1:2" />ఇనె అమ్‍ బోల్యొ, “యెహోవా సీయోన్‍ కంతూ, ఖీజ్‌పడుకరాస్. యెరూషలేమ్ కంతూ ఇను న్హేటొపాడీన్‌ హఃమ్జాంకరాస్. కావ్లివాళు హర్యుజమీన్‌ దుఃఖ్‌ హుంకరాష్‌. కర్మెలు పర్వత్ షిఖరం” హుఃకాంకరష్‌.<verse eid="AMO 1:2" /></para>
  <para style="s">ఇష్రాయేలు బగల్ను దేహ్‌ఃవాలఫర్ న్యావ్‌,</para>
  <para style="s">సిరియా</para>
  <para style="r">(<ref loc="JER 49:23-27">యిర్మీ 49:23-27</ref>; <ref loc="ISA 17:1">యెష 17:1</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />యెహోవా, బోలుకరాతె షాత్కతో, “దమస్కు నంగరంవాలు తీన్ కర్యుతె పాప్న బట్టి, మే తప్పకుండా ఆస్, షింగ్డా పనిముట్లతో గిలాదును నూర్చారు. <verse eid="AMO 1:3" /><verse number="4" style="v" sid="AMO 1:4" />మే హజాయేలు ఘేర్ను ఐగుప్తుఫర్ ఆగ్ బోలిమొక్లీస్. యో బెన్ హదదు రాజను భవనాలను బాలినాక్షే. <verse eid="AMO 1:4" /><verse number="5" style="v" sid="AMO 1:5" />దమస్కు ధర్వాజును ఆడుగడియల్నా తోడినాఖీష్‌. ఆవెను ఖవేరుమా ఛాతె జీంకరాతె వాలనా నాషనం కరీష్. బెత్ ఏదేనుమా రాజనుదండం ధర్యుతెవాలనా హరాయిదీష్. సిరియాను దేహ్‌ఃవాలు బంధీహుయిన్‌ ఫైదాకర్యొ, దరైజయిన్ కీరు జైయిన్‍ జాషె.” <verse eid="AMO 1:5" /><verse number="6" style="v" sid="AMO 1:6" />యెహోవా బోలుకరతె షాత్కతో, “గాజా తీన్ చోట్‌, చార్ చోట్‌ కర్యుతె పాపాల్నా బట్టిన్‌, మే ఖచ్చితంతీ ఇనా దండ్ నాఖిష్‌. షానకతో ఇవ్నే ఘణూ అద్మినా దేహ్మాదాసుల్నుతరా మొక్లో తుమారు ఎదోము ఇవ్ను ఛాసికీకరి కర్యా. <verse eid="AMO 1:6" /><verse number="7" style="v" sid="AMO 1:7" />గాజా భీతేను ఫర్ మే ఆగ్ బోలిమొక్లీస్. ఆతె ఇవ్ను రాజనున కోటయేనా బాలినాక్షె. <verse eid="AMO 1:7" /><verse number="8" style="v" sid="AMO 1:8" />అష్డోదుమా జీంకరాతె ఇవ్నా హరాయ్‌నాఖీస్. అష్కెలోనుమా రాజనులట్టొ ధర్లిదూతె ఇనా హరాయ్‌ నాఖీస్. ఎక్రోనునా విరోధంతీ మారు హాత్ పాడిస్. అజూ మిగ్లీతె ఫిలిష్తీయులు నాష్‌హుషె” కరి ప్రభువుహుయోతె యెహోవా బోలుకరస్‍.<verse eid="AMO 1:8" /></para>
  <para style="s">తూరు</para>
  <para style="r">(<ref loc="ISA 23:1-18">యెష 23:1-18</ref>; <ref loc="EZK 26:1-28:19">యెహె 26:1–28:19</ref>; <ref loc="EZK 3:4-8">3:4-8</ref>; <ref loc="ZEC 9:1-4">జెక 9:1-4</ref>; <ref loc="MAT 11:21-22">మత్త 11:21-22</ref>; <ref loc="LUK 10:13-14">లూకా 10:13-14</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />యెహోవా బోలుకరతె షాత్కతో, “తూరు తీన్ చోట్ చార్ చోట్ కర్యుతె పాప్నా భన్తీ మే ఖచ్చితంతి ఇనా షిక్చ నాఖీస్. షానకతో ఇవ్నే అద్మియేను గళ్లో మొత్తంనా ఎదోమునా ధరాయ్‌ దీస్. ఇవ్నే భైయ్యేను భావంతీ కర్లీదుతె నిబంధననా తోడిలీన్‌ దూర్ హుయిగా. <verse eid="AMO 1:9" /><verse number="10" style="v" sid="AMO 1:10" />మే, తూరు భీతె నంగర్‌మా ఉప్పర్‍ ఆగ్ బోలిమొక్లీస్. యో ఇను రాజను భవనాలను బాలినాక్షే.”<verse eid="AMO 1:10" /></para>
  <para style="s">ఎదోము</para>
  <para style="r">(<ref loc="ISA 34:5-17">యెష 34:5-17</ref>; <ref loc="ISA 63:1-6">63:1-6</ref>; <ref loc="JER 49:7-22">యిర్మీ 49:7-22</ref>; <ref loc="EZK 25:12-14">యెహె 25:12-14</ref>; <ref loc="EZK 35:1-15">35:1-15</ref>; <ref loc="OBA 1:1-14">ఓబ 1–14</ref>; <ref loc="MAL 1:2-5">మలా 1:2-5</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />యెహోవా, బోలుకరాతె షాత‌కతో, “ఎదోము తీన్ ఛోట్, చార్‌ ఛోట్‌ కర్యుతె పాప్న బన్తీ, మే ఖచ్ఛితంతి షీక్షానాఖిష్‌. సానకాతో యో ఇవ్నఫర్‍ చూపకుండా థల్వార్‍. ఇను భైయ్నా ఓడించా. ఇను చండాల్ కెదేబి రగులుతూనే ఛా. ఇను ఆగ్రహం కెదేబి ఉబ్రిరూతె ఛా. <verse eid="AMO 1:11" /><verse number="12" style="v" sid="AMO 1:12" />తేమాను ఉప్పర్‍ మే ఆగ్ బోలిమొక్లీస్. యో బొస్రా రాజను బంగ్లావ్నా బాలినాక్చె.”<verse eid="AMO 1:12" /></para>
  <para style="s">అమ్మోన్ను దేహ్‌ః</para>
  <para style="r">(<ref loc="JER 49:1-6">యిర్మీ 49:1-6</ref>; <ref loc="EZK 21:28-32">యెహె 21:28-32</ref>; <ref loc="EZK 25:1-7">25:1-7</ref>; <ref loc="ZEP 2:8-11">జెఫ 2:8-11</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />యెహోవా బోలుకరాతె షాత్ కతో, “అమ్మోనీయులు తీన్ ఛోట్, చార్‌ చోట్‌ కర్యుతె పాప్నా బట్టీన్ మే కఛ్చితంతీ ఇవ్నా షిక్చనాఖిష్‌. షానకతో ఇవ్ను ఆజుబాజుమా అజూ సరిహద్దునా ఛౌడు కర్లేనుకరి ఇవ్నె గిలాదుమాను బేజిణివాళిను పేట్నా చీరినాఖ్యు. <verse eid="AMO 1:13" /><verse number="14" style="v" sid="AMO 1:14" />రబ్బా భీతేవ్నా బాలినాఖిష్‌. లడ్డాయ్ ఆవాజ్‌, సుడి వ్యారో వాగనువహఃత్‌ హువతె ఆవాజ్తీ ఆతె రాజ బంగ్లావ్నా బాలినాక్చె. <verse eid="AMO 1:14" /><verse number="15" style="v" sid="AMO 1:15" />ఇవ్ను రాజొ, ఇనా అధిపతుల్‌హాఃరు బందీల్ తరా దేహ్‌ఃమా జాషె” కరి యెహోవా బోలుకరాష్‌.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s">మోయాబు</para>
  <para style="r">(<ref loc="ISA 15:1-16:14">యెష 15:1–16:14</ref>; <ref loc="ISA 25:10-12">25:10-12</ref>; <ref loc="JER 48:1-47">యిర్మీ 48:1-47</ref>; <ref loc="EZK 25:8-11">యెహె 25:8-11</ref>; <ref loc="ZEP 2:8-11">జెఫ 2:8-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />యెహోవా బోలుకరతె షాత్‌కతో “మోయాబు తీన్ ఛోట్, చార్‌ చోట్‌ కర్యుతె పాపాల్నా బట్టిన్‌ మే ఖఛ్చితంతీ ఇనా షిక్చనాఖిస్; షానకతో ఇవ్నె ఎదోమురాజొ హఢ్క్యావ్‌నా బాలీన్‍ బూడిద కర్యు. <verse eid="AMO 2:1" /><verse number="2" style="v" sid="AMO 2:2" />మోయాబు ఫర్ మే ఆగ్ బోలిమొక్లీస్. ఆతె కెరీయోతు భీతేనా బల్లాక్చె. లడ్డాయ్ను ఆవాజ్‌ బాకానాదం హఃమ్జాంకరతో మోయాబు మరణ్‌ను ఛిక్రాణ్ కర్తూ మ‌ట్టిగయు. <verse eid="AMO 2:2" /><verse number="3" style="v" sid="AMO 2:3" />ఎజ్గాను యేలవాలొ నార్హానుతిమ్‌ నాషనం కరిష్. ఇనకేడెబీ ఇవ్ను అధిపతుల్‌హాఃరనా మే మర్రాఖిదీస్” కరి యెహోవా బోలుకరాస్‌.<verse eid="AMO 2:3" /></para>
  <para style="s">యూదయ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />యెహోవా బోలుకరాతె షాత్కతో “యూదా తీన్ చోట్, చార్ చోట్ కర్యుతె పాపాల్నా బట్టిన్‌ మే కఛ్చితంగా ఇవ్నా షిక్చనాఖిస్‌. షానకతో ఇవ్నే ఇవ్ను నాణొవొడొ చాల్యతె ఇవ్ను చాహ్డ్‌ను భన్తీ మోసంహుయిన్ యెహోవా ధర్మషాస్త్రంనా బెందీన్, ఇను నియ‌మాల్నా పాటించకొయిని. <verse eid="AMO 2:4" /><verse number="5" style="v" sid="AMO 2:5" />యూదా ఫర్ మే ఆగ్‌నా బోలి మొక్లీస్, ఆతె యెరూషలేమ్ రాజను కోటల్నా బల్లాకిదిషె.”<verse eid="AMO 2:5" /></para>
  <para style="s">ఇష్రాయేల్‌న ఫర్ దేవ్ను న్యావ్‌</para>
  <para style="r">(<ref loc="DEU 3:8-11">ద్యీతియోపదేషకాండమ్‍ 3:8-11</ref>; <ref loc="NUM 6:1-8">సంఖ్యా 6:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />యెహోవా మాలంకరాంకరతె షాత్కతో “ఇష్రాయేల్ తీన్ చోట్ ఛార్ చోట్‍ కర్యుతె పాపాల్నా బట్టిన్ మే కఛ్చితంతి ఇనా షిక్చానాఖిస్‌; షానకతో రఫ్యానటేకె ఇవ్నే నిర్దోషులను ఏఛి నాఖిదిదు. చెప్లెనటేకె గరీబ్‌వాలనా ఏఛినాఖిదిదు. <verse eid="AMO 2:6" /><verse number="7" style="v" sid="AMO 2:7" />జమీన్‍ ఫర్‍ మాట్టినా అద్మియే కుంద్లినాక్యుతిమ్ దిక్కుకొయింతె ఇవ్ను ముఢ్క్యావ్‌నా కుంద్లినాకు కరాస్. తగ్గించీన్‌ ఛాతె ఇవ్నా పార్లిబాజుమా నహాఃడి దెంకరాస్. భా, ఛియ్యో ఎక్కస్‌ బాయికోతి వ్యభిచార్ సంబంధమ్ మ్హేందిలీన్ మారు పవిత్ర నామ్నా ఇజ్జత్‌ కరుకరాస్. <verse eid="AMO 2:7" /><verse number="8" style="v" sid="AMO 2:8" />తాకట్టుగా బేంద్యుతె లుంగ్డవ్‌నా కోదేయినితిమ్ హరేక్ బలిపీఠం కందె ఇను ఫర్ నిందర్‌లెంకరాస్‌. జుల్మాన్‌ ఫైషాతి లీదుతె అంగూర్నుదారున ఇవ్ను దేవ్ను మందిరంమా పీషె. <verse eid="AMO 2:8" /><verse number="9" style="v" sid="AMO 2:9" />దేవదారును ఝాడుయెత్రె ఊచుహుయుతె వాళు సింధూర్‍ను మోటు ఝాడుయెత్రె బలంఛాతె అమోరీయుల్నా ఇవ్ను హాఃమె ఉబ్రకొయినితిమ్ మే నాష్ కర్యొ కొయిన్నా! ఉప్పర్ ఇవ్ను ఫలంనా హేట్ ఇవ్ను జడ్‌నా నాషనమ్‍ మే నాషనం కర్యొ కొయిన్నా! <verse eid="AMO 2:9" /><verse number="10" style="v" sid="AMO 2:10" />ఐగుప్తు దేహ్ఃమతూ తుమ్నా బులాయిన్‌, అమోరీయుల్ను దేహ్నా తుంనా దేనుకరి చాలీహ్ః వరహ్ః జంగల్మా తుమ్నా చలాయో. <verse eid="AMO 2:10" /><verse number="11" style="v" sid="AMO 2:11" />తుమారు ఛియ్యావ్‌మా ప్రవక్తల్నా నియంమించి రాఖ్యొస్; తుమారు కవ్వారు చొగ్రయేమా <note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">ప్రత్యేకం కర్లిదొ, అపవిత్రంను నా ఛీమ్నుతిమ్‌ కేహ్‌ః నాకతర్నుతిం ర్హావను సంఖ్యా 6:1-8</char></note>నాజీరులనా యెంచిరాక్యోస్. ఇష్రాయేలీయువాలా, ఆతె హాఃఛి కాహెనా?” యెహోవా బోల్యోతె ఆస్. <verse eid="AMO 2:11" /><verse number="12" style="v" sid="AMO 2:12" />“హుయుతో నాజీరులనా తుమే అంగూర్నుదారు పిఢాయు. ప్రవచించొ నొకొకరి ప్రవక్తల్నా ఆజ్ఞా దిదా. <verse eid="AMO 2:12" /><verse number="13" style="v" sid="AMO 2:13" />దేఖొ ధాణొతీ భరాయుతె బండి కినాబిహో అణచి కుంద్లియుతిమ్ మే తుమ్నా కుంద్లినాఖిదీస్. <verse eid="AMO 2:13" /><verse number="14" style="v" sid="AMO 2:14" />చాతుర్‌ హుయుతెవాళు ఇవ్నెబీ చుఖ్కాయిలీషెకొయిని. బలంఛాతెవాళు ఇవ్ను బలాన్ని బట్టిన్‌ హిమ్మత్‍ లాయిలీషెకొయిని. గొప్ప వీరుడ్‌బి ఇను జాన్‍నా బఛ్చాయిలీషెకొయిని. <verse eid="AMO 2:14" /><verse number="15" style="v" sid="AMO 2:15" />తీర్వాళొ ఉబ్బార్షెకొయిని. ఎగ్గీస్ మిలావతెవాళు చుక్కాయిలిషెకొయిని. ఘోడన చలావాళు ఇను జాన్నా కాపాడిలీషెకొయిని. <verse eid="AMO 2:15" /><verse number="16" style="v" sid="AMO 2:16" />తయోధన్నె జాహఃత్తి హిమ్మత్‌వాళోస్‌ షూరుల్‌బి ఆయుధాలు బెందిన్ మిలాయిలీషె. యెహోవా ప్రచార్‍ కరూకరతె ఆస్.”<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s">దేవ్తి ఇష్రాయేల్ను ఛాతె సంబంధం</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />ఇష్రాయేలియుల్ను అద్మియే! యెహోవా తుమ్నా వాత్‍ బోలిన్‍ ఐగుప్తును దేహ్మాతు, ఇనె బులాయి లాయోతె వంషంమొత్తంనా బారెమా ఇనె మాలంకరాయోతె వాత్ హఃమ్జో. <verse eid="AMO 3:1" /><verse number="2" style="v" sid="AMO 3:2" />ములక్మా వంషంఅక్కుమా తుమ్నా మాత్రమాస్ ఎంచిలీదొ. అనటేకె తుమారు పాపాలన్ని బట్టికీ తుమ్నా షిక్షానాఖిస్.<verse eid="AMO 3:2" /></para>
  <para style="s">ప్రవక్తల్‌ను కామ్‌</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 3:3" />మద్దత్‌ దేయికొయినితిమ్‌ బే మలీన్‍ చాల్షేనా? సాత్బి మలకొయినితిమ్మస్‌ సింహాం, జాడిమ గర్జిస్తుందా? <verse eid="AMO 3:3" /><verse number="4" style="v" sid="AMO 3:4" />కెవూబి దర్లేయికొయినితిమ్‌ కొధమ సింహాం గుహమతూ ఛిక్రాన్ బేంద్చెనా? <verse eid="AMO 3:4" /><verse number="5" style="v" sid="AMO 3:5" />జమీన్‍ఫర్‍ ఎర నాబేంద్యుతె జిన్వార్ ఫాజిమా అట్కిజాషెనా? ఉరిమా కెహూబీ నా అట్కితో ఫాజి బేందతెవాళు బెందిన్ జాషెనా? <verse eid="AMO 3:5" /><verse number="6" style="v" sid="AMO 3:6" />హఃయర్మా బాకానాదం హఃమ్జాయుతె అద్మియే ఢర్షెకొయిన్నా? యెహోవా మొక్లకొయినితిమ్ హఃయర్మా విపత్తు ఆవ్షెనా? <verse eid="AMO 3:6" /><verse number="7" style="v" sid="AMO 3:7" />ఇను సేవకరహుయతె ప్రవక్తల్నా ఇను హూఃజ్నా మాలం కరావకొయినితిమ్ ఖఛ్చితంతీ యెహోవా కెహూ కరకొయిని. <verse eid="AMO 3:7" /><verse number="8" style="v" sid="AMO 3:8" />సింహాం గర్జించుకరాష్‌, ఢరకొయింతె వాళు యోకోన్‌ యెహోవా ప్రభువు బోల్యొ. ప్రచార్ కరకొయింతె వాళొ యోకోన్‌.<verse eid="AMO 3:8" /></para>
  <para style="s">సమరీయనా మిన్హత్‌</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9" />అష్డోదు రాజను బంగ్లావ్మా ప్రచార్‌ కరొ. ఐగుప్తుదేహ్ఃను రాజను బంగ్లావ్‌మా ప్రచార్‌కరొ. ఇవ్నెతీ అమ్‍ బోలొ, “తుమె సమరయ పర్వాత్ను ఉప్పర్ను ఇక్కట్‌ హుయిన్‌ ఇనమాను గందరగోళంనా దేఖొ. ఎజ్గ జరగతే జబర్దేస్తినా దేఖొ. <verse eid="AMO 3:9" /><verse number="10" style="v" sid="AMO 3:10" />సరిహుయుతె ఇనా కిమ్ కర్నుకీ ఇవ్నా మాలంకొయిని.” యెహోవా ప్రచార్‍ కరూకరతె ఆస్. ఇవ్నే ఇవ్ను రాజను బంగ్లమా ఘణు జబర్దేస్తి, నాషనం లపాఢిలీదు. <verse eid="AMO 3:10" /><verse number="11" style="v" sid="AMO 3:11" />అనటేకె యెహోవా ప్రభువు బోలుకరతె షాత్‌కతో, వైరి యో ఇలాహొఃనా కోండిలీషె. ఇనె తున పట్టుఛాతె ఇనా దక్లినాక్చె. తారు రాజను బంగ్లావ్నా లూటిలీన్ జాషె. <verse eid="AMO 3:11" /><verse number="12" style="v" sid="AMO 3:12" />యెహోవా బోలుకరతె షాత్కతో, “అదొగొను మ్హోడమా కంతూ కేవలం బే గోడా పన్కీ కాన్ టుక్డోనా జూనా పన్కి పాలవాళొ చొడ్డావతిమ్‌ సమరయమా జీంకరాతె ఇష్రాయేలీయుల్ వాలన బఛ్చాయిస్‍. కేవలం మంచంను మూల, నార్హయితో బూనిస్ను టుక్డనా” బఛ్చాయిష్‌. <verse eid="AMO 3:12" /><verse number="13" style="v" sid="AMO 3:13" />యాకోబ్‍ ఘర్ను ఇవ్నా విరోధంతీ ఆతె హాఃమ్జిన్‍ ప్రచార్‌ కరొ. యెహోవా ప్రభువు, సైన్యంనో దేవ్ బోలుకరతె షాత్కతో, <verse eid="AMO 3:13" /><verse number="14" style="v" sid="AMO 3:14" />“ఇష్రాయేలీయుల్ పాపాల్నా మే షిక్చనాఖతె ధన్‌, బేతేలుమాను బలిపీఠంనాబి మే షిక్చనాఖతె. బలిపీఠం షింగ్డా తుటిజైయిన్ జమీన్‌ఫర్ పడ్చె. <verse eid="AMO 3:14" /><verse number="15" style="v" sid="AMO 3:15" />ఠండ్ను ధన్మను బంగ్లావ్నా టడ్కను ధన్మాను బంగ్లావ్నా మే నాషనమం కరిస్‍. హత్తిను దాత్తీ బాంద్యుతె ఘర్ నాషనంహుషె. మోటు బంగ్లా అంతంహుయిజాషె.” యెహోవా ప్రచార్‍ కరూకరతె ఆస్.<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1" />సమరయ ఫహాడ్‌ ఉప్పర్ ఛాతె బాషాను గాయ్యే, గరీబ్నా కుందల్తూహుయిన్ కర్షే దిక్కుకొయింతె వాలనా ఇవ్న బాధిస్తూ, తుమారు బావ్రియేతీ “హామ్నా సారాయి లీలిన్ ఆవ్” కరి తుమే, ఆ వాత్‍ హాఃమ్జొ <verse eid="AMO 4:1" /><verse number="2" style="v" sid="AMO 4:2" />యెహోవా, ఇను పరిపూర్ణంకర్లీన్‍ తోడని మే. ఆస్, “తుమ్నా కొక్కేలతో ధర్లీన్‍ జాయితే సాధునుమేండను చెల్కానుతరతో ధన్‍ నిఖీన్‍ జంకరస్‍. తుమారమా మిగతావారిని చేపల గాలాలతో పట్టుకుపోతారు. <verse eid="AMO 4:2" /><verse number="3" style="v" sid="AMO 4:3" />తుమే ప్రాకారాల్లో పగుళ్ళగుండా దూరి వెళ్లిపోతారు. తుమ్నా హెర్మోను పర్వత్‌ బాదర్‍ పడ.” యెహోవా ప్రచార్‍కరూకరియేస్‍ ఆస్.<verse eid="AMO 4:3" /></para>
  <para style="s">దేవ్నుబాజు పరకొయింతె ఇష్రాయేల్‌</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4" />బేతేలునా ఆయిన్, పాచుపరిన్ లడ్డాయ్‌ కరొ. గిల్గాలుకు జైయిన్. పాపంకరవాళ కరి. హార్యేక్ వాణే బలుల్ లీన్ అవో. తీన్‍ వరహ్ః ఏక్‍ తుమారు దహ్ఃమను భాగ్ తీసుకురండి. <verse eid="AMO 4:4" /><verse number="5" style="v" sid="AMO 4:5" />రొట్టెతీ కృతజ్ఞత అర్పణ దెవ్వొ. దిల్ భర్తితీ దేయితిమ్‌ ప్రకటించొ. ఇవ్ను బారెమా చాటించొ. ఇష్రాయేలీయువాలా, అమ్‍ కరను తుమ్నా ఇష్టం కాహెనా. యెహోవా ప్రచార్‍ కరూకరతె ఆస్‌. <verse eid="AMO 4:5" /><verse number="6" style="v" sid="AMO 4:6" />తుమారు హఃయర్ అక్కుమ తుమ్నా ఖావనటేకె కాయ్బి కొయినితిమ్‍ కర్యొ. తుమె ఛాతెజొగొనుఅక్కుమా తుమ్నా ఖాణు కొయినితిం కర్యొ. హుయుతోబి తుమే మార భణే పర్యాకొయిని. యెహోవా ప్రచార్‍ కరూకరతె ఆస్. <verse eid="AMO 4:6" /><verse number="7" style="v" sid="AMO 4:7" />ఫికాయి వాడనుధన్తోడి తీన్ మ్హైనా అగాఢీస్ పానికొయినితిమ్ కర్యొ. ఏక్ హఃయర్ ఉప్పర్ పాని వర్హాయిన్‌ అజేక్ హఃయర్ ఉప్పర్ వర్హాయో కొయిని. ఏక్ జొగొ పాని పడ్యు, పాని పడకొయింతె జొగొ వర్హాఃయోకొయిని. పాని పడకొయింతె ఖేతర్ హుఃకాయిగు. <verse eid="AMO 4:7" /><verse number="8" style="v" sid="AMO 4:8" />బే తీన్‍ గాంమ్మా పీయను పానినాటేకె అజేక్ గాంమ్నా ఆత్రంగా గయతో ఎజ్గాబి ఇవ్నా పూరిజావయెత్రె పాని మల్యుకొయిని. హుయుతోబి తుమె మార భణె పర్యుకొయిని. యెహోవా ప్రచార్‍ కరుకరాతె ఆస్. <verse eid="AMO 4:8" /><verse number="9" style="v" sid="AMO 4:9" />విస్తార్‌ హుయుతె తుమారు అంగూర్ను బాగ్నా గుల్లర్‌ను బాగ్నా ఒలీవను ఝాడనా చిడ్డా ఖైయినాఖి దిషె. హుయుతో తుమే అజూబి మారబాజు పర్యాకొయిని. యెహోవా ప్రచార్‍ కరూకరతె ఆస్. <verse eid="AMO 4:9" /><verse number="10" style="v" sid="AMO 4:10" />మే ఐగుప్తీయుల వాలఫర్‌ తెగుళ్లు మొక్ల్యొతిమ్ తుమార ఉప్పర్బి తెగుళ్లునా మొక్ల్యొ. తుమారు కవ్వారవ్నా ఛరితీ మర్రాక్యొ. తుమారు ఘోడయేనా లీన్‌ గయు. తుమారు షిబిరాల్మా ఫైదాహుయుతె హఃరబ్‍ వాహ్ః తుమారు ముక్కుల్లోకి ఎక్కింది. హుయుతోబి తుమే మార బణే తిరగలేదు. యెహోవా ప్రచార్‍ కరుకరతే ఆస్. <verse eid="AMO 4:10" /><verse number="11" style="v" sid="AMO 4:11" />దేవ్‍ సొదొమ గొమొర్రా హఃయర్నా నాషనమ్‍ కర్యోతిం మే తుమారమా థోడుజణునా నాషనమ్‍ కర్యో. తుమే ఆగ్ మతూ ఖేచినాఖ్యుతే లాక్డానుఘోని చుఖ్కాయిలీదు. హుయుతోబి తుమే మార బణే ఫర్యాకొయిని. యెహోవా ప్రచార్‍ కరూకరతే ఆస్. <verse eid="AMO 4:11" /><verse number="12" style="v" sid="AMO 4:12" />అనటేకె ఇష్రాయేలీయుల్‌ వాళా, తుమారభన్తి కఠినంతీ అమ్‍ కరిస్. అనటేకె ఇష్రాయేలీయుల్ వాలా, తుమారు దేవ్నా మలనటేకె తయార్హుయిన్‌ ర్హవొ. <verse eid="AMO 4:12" /><verse number="13" style="v" sid="AMO 4:13" />పర్వతాల్నా బణావతెవాళొ వాయ్రోనా ఫైదాకరతెవాళొబి యోస్‍. ఇనె ఇను హూఃజ్‌యేనా అద్మియేనా మాలంకరావ వాళొబి, యోస్; వ్హాణునా అంధారుతరా బద్లావ్షె. జమీన్ను ఊచు జొగొఫర్‍ చాల్చె. ఇనె నామ్‍ సైన్యంనా అధిపతిహుయోతె ప్రభువు యెహోవా కరి ఇను నామ్‌.<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">ప్రక్షాతాపంటేకె బులావను</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />ఇష్రాయేల్ అద్మియే, తుమ్నా భన్తి మే దుఃఖంతీ రొవ్వాను వాత్‍ హాఃమ్జిన్‍. <verse eid="AMO 5:1" /><verse number="2" style="v" sid="AMO 5:2" />ఇష్రాయేల్ సియోన్‌ ఛోరి పడిగయు. యోబాయికొనా అజు కెదేబి ఉట్షెకొయిని. పాడవాళొ ఏక్జనూబి కొయిబి నార్హావమా యోబాయికొ జమీన్‌ఫర్ పడిజైయిన్‌ ఛా. <verse eid="AMO 5:2" /><verse number="3" style="v" sid="AMO 5:3" />యెహోవా ప్రభుహుయోతె బోల్యొతె షాత్కతో “ఇష్రాయేల్ ఇవ్నమా ఏక్ హజార్ అద్మియే నిక్ల్యుతె హఃయరేమా నికిన్ గయుతె హొః అద్మిహుయిన్ నిఖీన్ గయుతో హఃయర్యేమా దహ్‌ఃష్‌ అద్మి చుఖ్కి జైయిన్‌ ఆవ్షె.” <verse eid="AMO 5:3" /><verse number="4" style="v" sid="AMO 5:4" />ఇష్రాయేలీయుల్తి యెహోవా ఆంబోలుకరస్, “మనా దూండీన్ ఆయతో తుమె జీవ్సు.” <verse eid="AMO 5:4" /><verse number="5" style="v" sid="AMO 5:5" />బేతేలును ఆష్రయించొనొకొ. గిల్గాలుమా నొకొజవొ, బెయేర్షెబాకనా నొకొజవొ; గిల్గాలువాళు జరూతితీ ఠాణమా బందీల్‌తరా ధర్లీన్‌జాషె, బేతేలుమా అజూ దుఖమాస్‌. <verse eid="AMO 5:5" /><verse number="6" style="v" sid="AMO 5:6" />యెహోవానా ఆష్రయించొ; తెదె తుమె జీవ్సు, ఆష్రయించతో బేతేలుమా కోన్బి ఉజ్జావకొయినితిమ్ ఆగ్‌ పడతిమ్ ఇనె యోసేపు ఖాందాన్నాఫర్‌ పడీన్ ఇన నాష్‌ కరినాక్చె. <verse eid="AMO 5:6" /><verse number="7" style="v" sid="AMO 5:7" />ఇవ్నె న్యాయంనా అన్యాయంతరా కరిన్‌, నీతినా జమీన్‌ఫర్ నాఖిదెంకరాతెవాళా, <verse eid="AMO 5:7" /><verse number="8" style="v" sid="AMO 5:8" /><note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="JOB 9:9">యోబు 9:9</ref>; <ref loc="JOB 38:31">38:31</ref></char></note>ఇనె సప్తరుషీ థారొయేను గళ్లొ మృగషీర్ష గల్లొ థారొయేను ఫైదాకరాయోతెవాళొ. అంధారు గడప్నా వ్హాణుతరా బద్లావవాళొ, ధర్యావ్ను పానినా బులాయిన్ ఇనా జమీన్‌ఫర్ దొర్లిన్ నహాఃడవాళొ. <verse eid="AMO 5:8" /><verse number="9" style="v" sid="AMO 5:9" />ఇను నామ్ యెహోవా. థాకత్ వాలను ఉప్పర్‍ ఇనె నాషనంనా లావదేవమా కోటల్ నాష్ హుషె. <verse eid="AMO 5:9" /><verse number="10" style="v" sid="AMO 5:10" />పన్కి ధర్వాజుయేమా ఉబ్రీన్‌ బుద్ధిబోలతె వాలను ఉప్పర్ అద్మియే దుష్మాన్‌ హుషె; యథార్థంతీ వాతెబోలతె వాలనా అసహ్యించిలీషె. <verse eid="AMO 5:10" /><verse number="11" style="v" sid="AMO 5:11" />తుమె గరీబ్నా కుందల్తూహుయిన్ రఫ్యా లీలిన్‌ నీతిమంతుల్నా, బాధమ్హేందుతూ, ధర్యాజుకనా ఆవతె గరీబ్నా అన్యాయంతీ కరనుబారెమా <verse eid="AMO 5:11" /><verse number="12" style="v" sid="AMO 5:12" />తుమారు గల్తినా ఘనుజాహఃత్‌హుయుకరి, తుమారు పాపాల్నా ఘోరంహుయితెకరి మన మాలం. దరిద్రుల్‌కనా హాఃల్ మోప్నా లీలెతాహుయిన్ తుమె ఇవ్నా కుంద్లినాకుకరాస్. అనటేకె గలత్‌ కరకొయింతె ఇవ్నా బాధించుకరాస్‌. గామ్ను ధర్వాజు కందె గరీబ్నా పట్టించుకకొయిని. <verse eid="AMO 5:12" /><verse number="13" style="v" sid="AMO 5:13" />ఆతె ఖరాబ్‌ధన్‌ అనటేకె ఆ ధన్మా దిమాక్‌వాళు గఛ్చూప్‌ ర్హాషె. <verse eid="AMO 5:13" /><verse number="14" style="v" sid="AMO 5:14" />తుమె జీవ్నుతిమ్ కీడ్ మ్హెందిన్‍ మేల్ దూండొ; అంనితరా కరనుబారెమా తుమె లైహిజాయితె తిమ్‌ దేవ్‌నోబి సైన్యంనా అధిపతిహుయోతె యెహోవా తుమారకేడె ర్హాషె. <verse eid="AMO 5:14" /><verse number="15" style="v" sid="AMO 5:15" />కీడునా ద్వేషించీన్‌ మేల్నా ఫ్యార్‌ కర్తాహుయిన్, ధర్వాజుయేమా న్యాయం ఉబ్బారికాడొ. ఏక్ చోట్‌ యెహోవా, సైన్యంనా అధిపతిహుయోతె దేవ్‌ యోసేపు ఖాందాన్మా ధర్లీన్‌ గయుతె వాలఫర్‌ గోర్ కర్షె. <verse eid="AMO 5:15" /><verse number="16" style="v" sid="AMO 5:16" />అనటేకె యెహోవా ప్రభువు, సైన్యంనా అధిపతిహుయోతె యెహోవా దేవ్‍ బోలుకరాతె షాత్కతో, “హర్యేక్‍ రాజను వాట్మా, రొవ్ను ర్హాషె. హార్యేక్ నడివీధిమా అద్మియే జమహుయిన్‌ అయ్యో! కరి బోల్చె. రొవ్వానటేకె, ఇవ్నె రైతులను బులావ్షె. దుఖపడతె అష్యత్తి ర్హాయితె వాలనా రొవ్వతెటేకె బులావ్షె. <verse eid="AMO 5:16" /><verse number="17" style="v" sid="AMO 5:17" />అంగూర్ను బాగ్‌ మొత్తంమా రొవ్వాను జాహఃత్తీ ర్హాషె. మే ఇవ్నా తుమార ఇచ్మాతీ” <note caller="+" style="f"><char style="fr" closed="false">5:17</char><char style="ft" closed="false">మూలభాషమా షిక్షినాఖిస్‌</char></note>జైయిష్‌. <verse eid="AMO 5:17" /><verse number="18" style="v" sid="AMO 5:18" />యెహోవా న్యావ్‍ ధన్‌ ఆవ్నుకరి ఆహ్‌ః కరతె తుమ్నా ఘణు బాధ. యెహోవా న్యావ్‍ ధన్ హాఃజె షాన ఆహ్‌ః కర్షె? ఆతె ఉజాళుతరా కోర్హాయిని, అంధారుతరా ర్హాషె. <verse eid="AMO 5:18" /><verse number="19" style="v" sid="AMO 5:19" />ఏక్జణు సింహాం కంతూ చుక్కాయిలీదుతో రీచ్ హాఃమె పడినట్టు, న్హైయితో ఏక్జణు ఘమా జైయిన్‍, భీత్‍ ఫర్‍ హాత్ నాక్యుతో హాఃప్ ఇనా కల్డ్యుతిమ్‌ ర్హాషె. <verse eid="AMO 5:19" /><verse number="20" style="v" sid="AMO 5:20" />యెహోవాను ధన్ ఉజాళుతర కాహెతిమ్‍ అంధారంతరా ర్హాషెకొయిన్నా? కాంతితో కాహెతిమ్‍, అంధారుతరా ర్హాషెకొయిన్నా?<verse eid="AMO 5:20" /></para>
  <para style="s">ఇష్రాయేల్ను భక్తి కార్యాల్నా గుర్కావను</para>
  <para style="r">(<ref loc="ACT 7:42-43">అపొ 7:42-43</ref>)</para>
  <para style="r">(<ref loc="ISA 1:11-14">యెష 1:11-14</ref>; <ref loc="ACT 7:42-43">అపొ 7:42-43</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="AMO 5:21" />తుమారు పండగ హుఃకాయి జావదీన్‍ మన అష్యల్‌ కోలాగని. యోహఃరు మన గిట్టవు. తుమరు ఆలాదు సభలంటే నొకొ దిల్‍కొయిని. <verse eid="AMO 5:21" /><verse number="22" style="v" sid="AMO 5:22" />మన దహనబలులనూ నైవేద్యాలనూ మీరర్పించినా మే అంగిరిస్ని. సమాధాన బలులుగా మీరర్పించే అష్యల్‍నూ; మే కొయిని. <verse eid="AMO 5:22" /><verse number="23" style="v" sid="AMO 5:23" />తుమారు పాటల అవాజ్ మార కంతు. తుమారు తీగ గీద్ను గీద్బోలను మే. <verse eid="AMO 5:23" /><verse number="24" style="v" sid="AMO 5:24" />నీళ్లలా నీతిన న్హాఃహదెవొ. నీతినా కెదేబి న్హాహతిమ్‌ కర్యొ. <verse eid="AMO 5:24" /><verse number="25" style="v" sid="AMO 5:25" />ఇష్రాయేలియుల్వాలా, చాలిహ్‌ః వరహ్‌ః తుమే నైవేద్యాలనూ మన లాయునా? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />తుమే తుమారటేకె కైవాను కరి థారోను దేవ్ను మూర్తియేనా కర్లిదా. సిక్కూతు కరి దేవ్ను మూర్తియేనా రాజొనితరా తుమె ఢొయిలీన్ ఆయు కొయిన్నా. <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />అనటేకె మే దమస్కు హఃయర్ను పార్లిబాజు తుమ్నా బందీల్తరా బులీయిలీన్ జైయిస్‌, కరి యెహోవా బోలుకరాస్‌. ఇను నామ్‍ సైన్యంనో అధిపతి హుయోతె దేవ్‍.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s">ఇష్రాయేల్ను నాషనం</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1" />సీయోన్‌మా హాయితీ సుఖపడతె వాలనా బాధ తప్పకొయిని. సమరయ పహాడ్ను ఉప్పర్‌ దర్జాగా జీవతెవాలన బాధ తప్పకొయిని. ఇష్రాయేల్ వాలనా మద్దత్ కరవాలనా ఛాతె మోటు రాజ్యాల్మాను ముఖ్య గల్డవ్నా బాధ తప్పకొయిని. <verse eid="AMO 6:1" /><verse number="2" style="v" sid="AMO 6:2" />తుమారు నాయకుల్ అమ్‍ బోలుకరాష్‌, కల్నేకు జైయిన్ దేఖొ. ఏజ్గతూ హమాతు కరీ మోటు నంగర్మా జవొ. ఇనా బద్మా తూ ఫిలిష్తియుల్నా, గాతునా జవొ. ఆతె తుమారు బే రాజ్యాల్తీబి ఘణు ఊచ్చు కాహెనా? ఇను సరిహద్దులకంతూ తుమారు విషాలంహుయుతె కాహెనా? <verse eid="AMO 6:2" /><verse number="3" style="v" sid="AMO 6:3" />విపత్తును ధన్నే దూర్ ఛాకరి సోచిలీన్ అన్యాయంను న్యావ్‌ కరనాటేకె తుమారు ఇచ్మా తుమె పీఠముల్నా బాందుకరాస్. <verse eid="AMO 6:3" /><verse number="4" style="v" sid="AMO 6:4" />ఇవ్నే దాత్ను మంచొను ఉప్పర్ హుఃయిన్, గాధిను పర్పుఫర్‌ లాగిన్ దేహఃస్‌. మందమాను ప్రధానుల్ మ్హెండవ్ను చెల్కౌనా, సాలలో బల్షూతె కెల్డవ్నా వాడిలీన్‌ ఖాషు. <verse eid="AMO 6:4" /><verse number="5" style="v" sid="AMO 6:5" />స్వరమండలాలతీ మలిన్ దివాణుగీద్ బోల్తూ దావీద్‌తరా వజాడను రాచు అజు మెరుగ్గా వాయిస్తారు.<verse eid="AMO 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 6:6" />కఠొరోమా ద్రాక్షాను రహ్‌ఃనా నాఖిన్ పీయష్. పరిమళ తైలమ్‌ లోతిలోష్. పన్కి యోసేప్ను ఖాందావాళనా హుయుతె నాషనంను బారెమా చింతపడ్సెకొయిని. <verse eid="AMO 6:6" /><verse number="7" style="v" sid="AMO 6:7" />అనటేకె బందీల్తరా జాయితె ఇనమా అవ్నేస్‌ అగాఢి జాషె. తెదె సుఖభోగాలతీ కరిలేయితె ఖాణు, ఖేల్కూద్ అజు ర్హాషెకొయిని.<verse eid="AMO 6:7" /></para>
  <para style="s">ఇష్రాయేల్</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />“ప్రభుహుయోతె యెహోవా ఇను కేడెకరి ప్రమాణమ్ కర్యొ; ఆస్ దేవ్ హుయోతె సైన్యంనో అధిపతిహుయోతె యెహోవా వాత్. <verse eid="AMO 6:8" /><verse number="9" style="v" sid="AMO 6:9" />ఏక్‍ పరివార్మా ధహ్ఃజణు అద్మియే ర్హయుతోబి ఇవ్నె మర్షె. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />ఏక్ను గోడనుహేట్‌ ఇవ్నకేడెబి హఢ్క్యానా ఘేర్ మతూ బాదర్ లీన్‍ జావనటేకె ఘొరాడాన పాడ్యుతెదె ఘర్ను పీటెను బాజుమా ఏక్నాదేఖిన్ ఘర్మా అజు కోన్బి మిగ్లీన్‌ ఛానా? కరి పుఛ్చావమా ఇనె అజు కోన్బి కొయినికరి బోల్చె; తెదె దాయాదిట్ల అమ్ బోల్చె తూ అజు మేషాత్బి నొకొబోలిస్‌తిమ్ గఛ్చూప్ ర్హాజొ, యెహోవాను నామ్‍ హఃయల్‌ నాకర్ను; <verse eid="AMO 6:10" /><verse number="11" style="v" sid="AMO 6:11" />షానకతో మోటు ఘర్ వాళుబీ, గళ్లినాయేక్‌ హుషె, కరి తుమ్నా యెహోవా ఆజ్ఞ దీరాక్యోస్‌. <verse eid="AMO 6:11" /><verse number="12" style="v" sid="AMO 6:12" />ఘోడా బంఢాను ఉప్పర్ మిలావ్షేనా? ఎజాత్ను జొగొ కోన్బి దాండవ్తీ దున్చేనా? హుయుతోబి తుమే హమారు థాకత్తీస్ బలంనా లాయిలీషుకరి బోయిలేతె తుమె, పాల్తుహుయుతె ఇనభన్తి ఖుషిహువతె తుమె, <verse eid="AMO 6:12" /><verse number="13" style="v" sid="AMO 6:13" />న్యాయంనా ఘోరంహుయుతె అన్యాయంతరా, నీతిఫలంనా ఘోర దుర్మార్గంతరా బద్లాయథా. <verse eid="AMO 6:13" /><verse number="14" style="v" sid="AMO 6:14" />అనటేకె దేవ్‌హుయోతె సైన్యంనా అధిపతిహుయోతె యెహోవా బోలుకరతె షాత్కతో, ఇష్రాయేలీయుల్వాళా, మే తుమార ఉప్పర్ ఏక్ జనంనా ఆవదీస్‌, ఇవ్నె హమాతునా జాయితె వాట్ను మొదుల్తూ ధరిన్ జంగల్‌ను కనాల్తోడి తుమ్నా బాధినాక్షె.”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">చిడ్డావ్ను హోఃణె</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />ప్రభుహుయోతె యెహోవా ఆ మన దెఖ్కాడ్యొ. రాజొనా ఆవ్నుతె ఫికాయ్ను బాద్మా ఘాహ్ః పుట్యుతెదె ఇనె చిడ్డావ్నా పాంబల్నా ఫైదాకరాయో. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />యోతె హర్యుఘాహ్‌ అక్కూ ఖైనాక్యుతెదె మే అమ్ బోల్యొ. “యెహోవా ప్రభూ, దయకరిన్ క్చమకర్. యాకోబ్ ఖాందన్ థోడు అద్మియేస్‌థోని. ఆ కిమ్‍ ఉభర్షె” <verse eid="AMO 7:2" /><verse number="3" style="v" sid="AMO 7:3" />అను బారెమా యెహోవా దిల్ బద్లాయిన్ “ఆతె జరగకొయిని” కరి బోల్యొ.<verse eid="AMO 7:3" /></para>
  <para style="s">ఆగ్ను హొఃణె</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />యెహోవా ప్రభువు ఆ మన దెఖ్కాడ్యొ. షిక్చానాఖనటేకె యెహోవా ప్రభువు ఆగ్నా ‌ఆవదియో, ఆతె జమీన్ను హేట్‌ ఛాతె అగాధ మోటు పాణినా హుఃకాయినాఖిన్ జమీన్నాబి గలిలేవనూస్‌. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />హుయుతో మే అమ్ బోల్యొ. “యెహోవా ప్రభూ, యాకోబు ఖాందాన్ థోడుజణూస్ని. ఆతె కిమ్ ఉభర్షె?” ఆతె భులిజాకరి మే వేడిలేవమా <verse eid="AMO 7:5" /><verse number="6" style="v" sid="AMO 7:6" />అను బారెమా యెహోవాను దిల్ బద్లాయిలీన్ “యోబి హుషెకొయిని” బోల్యొ.<verse eid="AMO 7:6" /></para>
  <para style="s">మోజను ఢోరి హోఃణె</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />బుజు ఆమన దెఖ్కాడ్యొ. హదేక్‍, మట్టపుగుండు హాత్మా ధర్లిన్ ప్రభువు భీత్‍ను హాఃమె ఉబ్రిగయో. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />యెహోవా మారెతీ అమ్ బోల్యొ. “ఆమోసూ, తూషాత్ దేఖుకరాస్‌?” మట్టపు గుండు బోల్యొ. తెదె ప్రభువు అమ్‍ బోల్యొ. “మారు అద్మియేహుయాతె ఇష్రాయేలీయుల్ ఇచ్మా మే మట్టపు గుండు నాఖజంకరూస్‌. అజు కెత్రేబి మే ఇవ్నా బెందీస్‌కొయిని. <verse eid="AMO 7:8" /><verse number="9" style="v" sid="AMO 7:9" />ఇస్సాక్‍ ఖాందన్ ఇవ్ను ఊచు జొగొ నాషనంహుషె. ఇష్రాయేలీయుల్ను ప్రతిష్ఠిత జొగొయే ఉజ్జాడ్ హుయిజాషె. యరొబాము ఖాందన్నా విరోధంతీ చరి” పాడీష్‌.<verse eid="AMO 7:9" /></para>
  <para style="s">ఆమోస్ అజు అమాజ్యా</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />తెదె బేతేల్‍ యాజకుడ్ అమజ్యా, ఇష్రాయేల్ రాజొ యరొబామునా అమ్‍ వర్తమానంనా మొక్ల్యొ “ఇష్రాయేలీయుల్ ఇచ్మా, ఆమోసు తారఫర్ కుట్ర కరుకరాస్‌. ఇను వాతె దేహ్ః హఃమాల్యుకొయిని.” <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />తెదె ఆమోసు, యరొబాము ఛరితీ మర్జాషె. ఇష్రాయేలీయుల్ కఛ్చితంతీ ఇవ్ను దేహ్‌ఃనా బెందిన్ బందీల్‌తరా జాషెకరి బోల్యొ. <verse eid="AMO 7:11" /><verse number="12" style="v" sid="AMO 7:12" />అమజ్యా ఆమోసుతీ అమ్ బోల్యొ. “ప్రవక్తా, జలొజా! యూదా దేహ్‌ఃనా మిలాయిలా. ఎజ్గాస్‌ ప్రచార్‌ కర్తొహుయిన్‌ పేట్నా పాలిలా. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />బేతేలుమా అజూ కెత్రేబి ప్రవచించ్‌నొకొ. రాజొ ఆరాధించతె జొగొ, రాజొను రాజ్యంను మందిరంను గుడి అజ్గ ఛా.” <verse eid="AMO 7:13" /><verse number="14" style="v" sid="AMO 7:14" />అనటేకె ఆమోసు అమజ్యాతీ అమ్‍ బోల్యొ. “మే ప్రవక్త కాహె, ప్రవక్తను ఛియ్యోబి కాహె. మే మ్హేండను కావ్లివాళొ. గుల్లర్ను ఝాడనా పండా చూణిలెంకరూష్‌. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />పన్కీ, మే మారు మందొనా చరావ్తో ర్హయోతో యెహోవా మన బులైన్‍, తూ జైయిన్ మారు అద్మియేహుయుతె ఇష్రాయేల్ వాలనా ప్రవచించ్ కరి బోల్యొ.” <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />అనటేకె యెహోవా వాత్ హాఃమజ్‌. తుమె అమ్ బోల్యు. ఇష్రాయేలీయుల్నా బారెమా ప్రవచించొనొకొ. ఇస్సాక్‍ ఖాందాన్నా పాచుఫర్జైన్‌ వాత్‍ తప్పొనొకొ. <verse eid="AMO 7:16" /><verse number="17" style="v" sid="AMO 7:17" />యెహోవా బోలుకరాతె షాత్కతో, తారి బావణ్‍ హఃయర్మా వ్యభిచారిహుషె. తార ఛియ్యా, ఛోరియే ఛరితీ ఖతంహుషె. వైరియే తారు జమిన్నా మోజీన్ బాగ్ పల్లిషె. తూ అపవిత్ర్‌ దేహ్ఃమా జాన్‍ బెందీష్‌ కఛ్చితంతీ ఇష్రాయేలీయుల్ ఇవ్ను దేహ్‌ః బెందీన్ బందీల్‌ హుషె.<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">పండ్యుతె పండను టోక్రొ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />అజు ప్రభుహుయోతె యెహోవా, హోఃణెను రీతితీ టడ్కను ధన్నూ పండ్లను గంపొ ఏక్ మన దెఖ్కాడీన్‌. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />ఆమోస్‌, తున దెఖ్కాంకరాతె షాత్కరి మన పుఛ్చావమా టడ్కను ధన్నూ పండావ్నుగంపొ మన దెఖ్కాంకార్‌ కరి మే బోల్యొ, తెదె యెహోవా మారెతి బోల్యొతె షాత్కతో మారు అద్మియేహుయుతె ఇష్రాయేలీయుల్నా అంతం ఆయినాస్‌ ఛా, అజు మే ఇవ్నా ఏన్‌ బేందిస్కొయిని. <verse eid="AMO 8:2" /><verse number="3" style="v" sid="AMO 8:3" />ప్రభువైన యెహోవా బోల్యొతె షాత్కతో “మందిర్మా ఇవ్నే బోలతె గీదె యో ధన్నె రోవ్నుహుషె. యోధన్నే ముర్దా గణ్తినా జాహఃత్‌ హుషె, హర్యేక్ జొగొమాబి ఆతె నాఖిదిషె” గచ్చూప్ ర్హవొ.<verse eid="AMO 8:3" /></para>
  <para style="s">ఇష్రాయేలీయుల్నా మిన్హత్</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 8:4" />దేహ్ఃమాను గరీబ్నా దోచులేతూ హుయిన్‌ గరీబ్నా నాష్ కరతె తుమె ఆవాత్ హఃమ్జొ. <verse eid="AMO 8:4" /><verse number="5" style="v" sid="AMO 8:5" />ఇవ్నె అమ్ బోల్చె, “అప్నె చావల్ ఏచనటేకె అమాహ్‌ఃను కెదె చల్జాస్కీ? ఘౌను దందో కర్లేవనటేకె ఆరామ్నుధన్‌ కెడె జాస్కి? అప్నె మోజను పాత్రనా న్హాను కరీన్, మోల్ భడాయే. ఛాడ్ తూకంతీ అప్నె దోఖ కరియే. <verse eid="AMO 8:5" /><verse number="6" style="v" sid="AMO 8:6" />ఖర్రాబ్‌హుయుతె ఘౌనా ఏఛిన్, ఱూపునా గరీబ్వాలనా మోల్‌ లీలియే. గరీబ్నా, ఏక్ జోడు చెప్లెను మోల్నా గరీబ్‌నా లియే.” <verse eid="AMO 8:6" /><verse number="7" style="v" sid="AMO 8:7" />యాకోబ్ను గర్వంను కారణం యెహోవా అమ్ జిభాన్ కర్యొ. “ఇవ్నె కర్యుతె కామ్మా షాత్బీ‌ మే భులీస్కొయిని.” <verse eid="AMO 8:7" /><verse number="8" style="v" sid="AMO 8:8" />అను భన్తి జమీన్‍ హల్చెకొయిన్నా? ఇనమా జీంకరాతె హాఃరుబీ దుఃఖ్ హుషెకొయిన్నా? నైలునదితిమ్ జమీన్ అక్కూ పొంగిజాషె. ఐగుప్తుదేహ్ఃను నైలునదిను తరా ఆతె ఉప్పర్ ఉట్టీన్, అజూ అణిగి జాషె. <verse eid="AMO 8:8" /><verse number="9" style="v" sid="AMO 8:9" />ప్రభువు హుయోతె యెహోవా బోలుకరాతె షాత్కతో, యోధన్నె మే దొప్పారేను వహఃత్నాస్‌ ధన్ డుబిజావంతరా కరీస్‌. ధన్నూస్‌ జమీన్నా అంధారు డపాయ్‌ నాఖిదీస్‌. <verse eid="AMO 8:9" /><verse number="10" style="v" sid="AMO 8:10" />తుమారు పండగలనా దుఃఖ్‌ను ధన్నుతరా తుమారు గీద్ మొత్తంనా దుఃఖ్‌ను గీద్‌నుతరా బద్లాయీస్‌. తుమె ఛైయిను కోథొ బాందిలేయితిమ్‌ కరిస్. తుమారు అక్కవ్ను ముఢ్క్యు బోడికరిదీస్‌. ఎక్కస్‍ ఛియ్యో మరిగుతో రొవ్వనుధన్నుతరా మే కరిస్. ఇను ముక్చావను ఘోరంహుయుతె ధన్నుతరా ర్హాషె. <verse eid="AMO 8:10" /><verse number="11" style="v" sid="AMO 8:11" />యెహోవా ప్రచార్‍ కరూకరతె ఆస్, “ఆవ్సెతె ధన్మా దేహ్ఃమా మే ఖాల్ ఆవదీస్‌. ఆతె ఖాణనాటేకె, అఛ్చు పానినాటేకె ఖాల్‌ కాహె పన్కి, యెహోవా వాత్ హఃమ్జనటేకె కొరువుహుయిన్‌ ర్హాషె. <verse eid="AMO 8:11" /><verse number="12" style="v" sid="AMO 8:12" />యెహోవా వాత్ హఃమ్జనటేకె ఏక్ ధర్యావ్ కంతూ అజేక్‌ ధర్యావ్ తోడి, ఉత్తర దిక్కుతోడి పర్షె పన్కీ ఆతె ఇవ్నా మల్చెకొయిని. <verse eid="AMO 8:12" /><verse number="13" style="v" sid="AMO 8:13" />యో ధన్‍ రంగేళిహుయితె ఛొగ్రియే కవ్వారాబి తరహ్ఃతీ ముర్జాయిజాషె. <verse eid="AMO 8:13" /><verse number="14" style="v" sid="AMO 8:14" />సమరయ పాప్తీ ఒట్టు బేందిలేయితె ఇవ్నే, దాను తారు దేవ్ను జాన్‍ ఫర్‍ ఒట్టు, <note caller="+" style="f"><char style="fr" closed="false">8:14 </char><char style="ft" closed="false">మూర్తిను పూజను జోక్ను</char></note>‘బెయేర్షెబా దేవ్ను జాన్‍ ఫర్‍ ఒట్టు’ కరి బోలవాలు అజూ కెదేబి ఉట్టకొయినితిమ్ పడిజాషె.”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">ఇష్రాయేల్ఫర్‌ దేవ్ను న్యావ్‌</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />బలిపీఠమ్ కన, ప్రభువు ఉబ్రీన్‍ ర్హావను దేఖ్యొతొ. ఇనె ఆం బొల్యో. ధర్వజాహాఃర హలిజావ హఃర్కూ స్థంబంఫర్ జోరెహూ భాగంనమార్. ఉప్పర్లి కప్పున ముఢ్కఫర్ పడహఃర్హూ ఇన పోడినాక్. ఇను బాద్మా బఛ్చిగయుతె ఇవ్నా మే ఛరిహూః మారినాఖిస్. కోన్బి మిలాయికోజాషెని. కోన్బి బఛ్చికోజాషెని. <verse eid="AMO 9:1" /><verse number="2" style="v" sid="AMO 9:2" />మార్యుతె ఇవ్నెఛాతె జొగొకనా ఇవ్నే మహీగయుతో ఎజ్గాతు మారు హాఃత్ ఇవ్నా బాదర్ కేచుకరస్. ఇవ్నే ఆబ్నుఫర్ జడిగయుతోబి ఏజ్గతూ ఇవ్నా హేట్ ఉత్తారినాఖిస్‌. <verse eid="AMO 9:2" /><verse number="3" style="v" sid="AMO 9:3" />కర్మెలు పర్వత్ షిఖరంఫర్‌ ఇవ్నే లఫిగయుతోబి మే ఇవ్నా దూండిన్ ధర్లిస్. మార డోలమా దేఖ్కావకొయినితిం ఇవ్నే ధర్యానుమ గధర్మా లఫిగయుతో ఇవ్నా కల్డికవన <note caller="+" style="f"><char style="fr" closed="false">9:3</char><char style="ft" closed="false">ఆదీనంమా ఛాతె ధర్వావ్‌ను జీవి</char></note>హఃప్నా బోలిమొక్లిస్. యోఇన కల్డికాక్చె. <verse eid="AMO 9:3" /><verse number="4" style="v" sid="AMO 9:4" />వైరియే ఇవ్నహఃరవ్నా ధర్లీన్ బందీల్‌తరా బగల్ను దేహ్మాలీన్ గయుతోబి మే ఎజ్గా <note caller="+" style="f"><char style="fr" closed="false">9:4</char><char style="ft" closed="false">మూలభాషమా కత్రినాఖిష్‌</char></note>ఛరినకామ్ బోలిష్‌. ఆతె ఇవ్నా మారినాక్షె. మేల్‌ కరను హువకొయింతె కీడు కరనటేకెస్‌ మారు నజర్ ఇవ్నఫర్ మ్హేలిరాఖిస్. <verse eid="AMO 9:4" /><verse number="5" style="v" sid="AMO 9:5" />ఇనె సైన్యంనా అధిపతిహుయోతె యెహొవా; ఇనె జమీన్నా ఛీమ్యుతో యోతె కరిగి జాషె. ఇనమా జీవ్నుకరవాళు హఃరుజణు రొవ్షే. నైలునదిను ఘోణి యోఅక్కూ పొంగిజాషె. ఐగుప్తును దేహ్మాను నైలునది నదితరా ఆతె ఉప్పర్ ఉట్టిన్, అజూ అణిగిజాషె. <verse eid="AMO 9:5" /><verse number="6" style="v" sid="AMO 9:6" />ఇనె ఆబ్‌యేమా ఇన టేకె మిద్దెమేడల్నా బాంధవాళొ. జమీన్‌ఫర్ ఇను పునాది నాఖ్యొతెవాళొ. ధర్యాను పానినా వర్హాత్ను గోణి జమిన్‌ఫర్ వర్హావతె తూస్. ఇను నామ్ యెహొవా. <verse eid="AMO 9:6" /><verse number="7" style="v" sid="AMO 9:7" />ఇష్రాయేల్నుయేలీయువాలా, తుమె ఇథియోపియా అద్మియే మారి నజమా సమానమాస్‌ కాహెనా! మే ఐగుప్తు దేహ్మా కంతూ ఇష్రాయేలీయుల్నా, క్రేతు కంతూ ఫిలిష్తీయుల్నా, కీరు మతూ అరామీయుల్నా బులాయి మంగయో. <verse eid="AMO 9:7" /><verse number="8" style="v" sid="AMO 9:8" />యెహోవా ప్రభువు డోలా ఆ పాపిష్ఠిను రాజ్యంనా దేఖుకరాస్. ఇనా జమీన్ ఫర్ నార్హనుతిం నాషనం కరిస్. పన్కీ యాకోబు ఖాందాన్నా పూర్తితీ నాషనం కోకరిస్ని. యెహొవా బోలిరాక్యొతె ఆస్. <verse eid="AMO 9:8" /><verse number="9" style="v" sid="AMO 9:9" />“దేఖొ, మే ఏక్ ఆజ్ఞ దీస్‌. ఏక్జణొ అనాజ్నా జల్లెడిమా నాఖిన్ ఏక్ దాణొబి హేట్ నాఫడతిం జల్లెడి కరతిం, ఇస్రాయేలీయుల్నా హాఃరా రాజ్యాల్ను ఇచ్మా జల్లిడినాఖీస్. <verse eid="AMO 9:9" /><verse number="10" style="v" sid="AMO 9:10" />‘ఆపదా అప్ను షేడె కోఆవ్షేని. అప్నా రపట్షెకొయినికరి’ కరి మారు అద్మియేమా సోఛిలేయితె పాపాత్ముల్ హాఃరు తల్వార్‌తీ మరిజాషె.”<verse eid="AMO 9:10" /></para>
  <para style="s">ఇష్రాయేల్నా జమాణను వైభవంనా దేవను</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />పడిగూతె ధావీదును ఢేరవ్నా త్యో ధన్నే మే ఉబ్రాకాడీస్‌. బీతెనా అష్యల్ కరిస్. మిద్దేన బాందిస్. అగాఢి ర్హాయితిమ్‌ అజుపాచు బాందిస్, ఆస్ యెహోవాను వాత్. <verse eid="AMO 9:11" /><verse number="12" style="v" sid="AMO 9:12" />ఇవ్నే ఎదోముమా మిగిలీతె ఇవ్నా మారు నామ్ మ్హేలిరాఖ్యుతె రాజ్యాల్‌ అక్కూ మారు అద్మియే స్వాధీనం కర్లేవహఃర్కూ కరిస్. అమ్ కరతె యెహోవాను వాత్ ఆస్. <verse eid="AMO 9:12" /><verse number="13" style="v" sid="AMO 9:13" />“ఆవజాసెతె ధన్మా ఫికాయి వాడవాళు ఖేతర్ దున్నావాలనకేడె ఆవ్షె. బింజ్లా నాఖను వొహఃత్ ద్రాక్షానుపండన కుంద్లావాళు ఆవ్షె. ఫహాడ్ పర్బాత్ మిట్టుద్రాక్షాను రహ్ః మ్హేలిదిషె. ఫహాడ్బి ఇన చాలావ్షె. యెహోవా బోలుకరతె ఆస్. <verse eid="AMO 9:13" /><verse number="14" style="v" sid="AMO 9:14" />ధరైజయిన్ బందీల్‌తరా బగల్‌ దేహ్‌ః గయుతె మారు అద్మియేహుయాతె ఇష్రాయేలీయుల్నా మే ఫరిన్‍ బులాలీన్‍ ఆయిస్‍. నాష్ హుయుతె నంగర్నా అజు బాందిలీన్‍ ఇవ్నే ఇనమా జీవ్షె. అంగూర్నుబాగె గాడీన్ ఇను అంగూర్ను రహ్‌ః పీషె. బాగ్ నాఖిన్ ఇవ్ను పండా ఖాషె. <verse eid="AMO 9:14" /><verse number="15" style="v" sid="AMO 9:15" />ఇవ్ను దేహ్ఃమా మే ఇవ్నా గాడిస్‌. మే ఇవ్నా దిదోతె దేహ్‌ః మతూ ఇవ్నా అజు కెదెబి కేఛినాఖను జరగ్చెకొయిని.” తుమారొ దేవ్ హుయోతె యెహోవా బోలుకరాష్‌.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>