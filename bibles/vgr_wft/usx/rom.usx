<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ROM" style="id">VAGIRI project - Copyright World Bible Translation Center UTF-8 Version 1‏.</book>
  <para style="h">రోమా</para>
  <para style="toc3">రోమా</para>
  <para style="toc2">రోమా</para>
  <para style="toc1">పౌల్‍ రోమియుల్‍నా లిఖ్యొతె పుస్తక్</para>
  <para style="mt2">పౌలు రోమియులకు వ్రాసినా పత్రిక</para>
  <para style="mt1">పౌల్‍ రోమియుల్‍నా లిఖ్యొతె పుస్తక్</para>
  <para style="imt">అగ్లివాతె</para>
  <para style="ip">రోమ పత్రిక క్రీ. ష. 54-58 వరహ్ఃను ఇచ్మా పౌల్‍నా హాతెహుః లిఖ్కాయు. పౌల్‍ రోమా సంఘంనా దేఖనహుయుకొయింతె వహఃత్‍మా రోమమా ఛాతె యూదుల్‍ అజు యూదేతరను విష్వాసుల్నా ప్రోత్సహించనాటేకె ఆ ఉత్తరం లిఖ్కాయు. అనే కొరింథీ పట్టణంమా ర్హావను వహఃత్‍ ఆ ఉత్తరంనా లిఖ్యు. ఆ ఉత్తరంను బారెమా హాఃరు దేహ్ఃమా ఛాతె యేసుక్రీస్తునా విష్వాస్‍కర్నూకరి ఇను ఉద్దేష్యం <char style="xt"><ref loc="ROM 16:26">16:26</ref></char>.</para>
  <para style="ip">రోమా పత్రికా క్రైస్తవుల్‍హాఃరనా హాఃరు వహంత్‍మా ఘనూ ముఖ్యాతిహుయూతె పుస్తక్‍ షానకతో అన్మా పౌల్‍, యేసుక్రీస్తునా బారెమా అప్నా బచ్చను కిమ్‍ ఆవస్కీ హుఃద్‍తి వివరించబడ్యు. ఇమ్మస్‍ పౌల్‍ను జూను నిబంధనమా సువార్తనాబి అజ్గ వివరించు. ఆ పుస్తక్‍మా ఘనూ ముఖ్యాతిహుయూతె వచన్‍ <char style="xt"><ref loc="ROM 1:16">1:16</ref></char> కరి థోడుజను పండితుల్‍ బోల్యా, అన్మా సువార్త బోలనాటేకె మే కెత్రేబీ షరమ్‍కోపడుని, షానకతో నమ్మతెహాఃరనా కతొ అగాడి యూదుడ్‍నా అజు యూదేతరూల్నా బచ్చావనాటేకె ఆ దేవ్ను తాకత్‍హుయీన్‍ ఛా. ఆ పుస్తకంమా అగాడి అద్యాయాల్ క్రైస్తవా జీవ్నునా గూర్చి ముఖ్యాతిహుయూతె సలహల్‍ ఛా <char style="xt"><ref loc="ROM 13-15">13–15</ref></char></para>
  <para style="iot">విషయా సూచిక</para>
  <para style="io1">1. పౌల్‍ ఇను గూర్చి పరిచయం కర్లేతొహుయీన్‍ కినా లిఖ్యుకరస్‍కరి బోలను <char style="ior"><ref loc="ROM 1:1-15">1:1-15</ref> </char></para>
  <para style="io1">2. పాసల్‍ అద్మినూ స్థితి అజు ఇవ్నా యేసుక్రీస్తు బారెమా బఛ్చావను<char style="ior"><ref loc="ROM 1:16">1:16</ref>; <ref loc="ROM 11:36">11:36</ref> </char></para>
  <para style="io1">3. పాసల్‍తి పౌల్‍ క్రైస్తవుల్నూ జీవ్నునా గూర్చి సలహాల్‍ దేవను <char style="ior"><ref loc="ROM 12:1-13">12:1-13</ref>,<ref loc="ROM 12:15">15</ref> </char></para>
  <para style="io1">4 ఆఖరీమా రోమా సంఘస్తుల్నా హఃలామ్‍ బోలిన్‍ బంద్‍కరను <char style="ior"><ref loc="ROM 16:1-27">16:1-27</ref> </char></para>
  <chapter number="1" style="c" sid="ROM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1"/>యేసు క్రీస్తు<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">మూలభాషమా అభిషక్తుడ్‍కరి అర్థం</char></note> దాసుడ్‍, అపొస్తల్‍నితరా ర్హావనటేకె బులాయుమంగాహుయోబి, దేవ్ను సువార్తనటేకె ప్రత్యేకించుహుయోతె<verse eid="ROM 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 1:2"/>పౌల్‍ రోమమా ఛాతె దేవ్ను ఫ్యార్ను అద్మి ఖారవ్నా కతొ పరిసుద్దుడ్‍ని తరా రవ్వానటేకె బులాయుహు హాఃరన్నా లిఖ్కుకరతె అప్న భా హుయోతె దేవ్‍ కంతుబి, ప్రభుహుయోతె యేసుక్రీస్తు కంతుబి, కృపాసమాధానంబి తుమ్న హువదా దేవ్‍ ఇను ఛియ్యోనా అప్న ప్రభువుహుయోతె యేసు క్రీస్తును విషయంహుయూతె <verse eid="ROM 1:2"/><verse number="3" style="v" sid="ROM 1:3"/>యో సువార్తల్నా పరిసుద్ధ్ లేఖనాల్‍కనా ఇను ప్రవక్తల్‍ బారేమా అగాడి వాగ్ధానం కర్యొ <verse eid="ROM 1:3"/><verse number="4" style="v" sid="ROM 1:4"/>ఇను పరిత్రహుయూతె ఆత్మతి ప్రభావంతి మరన్‍మతూ జీవిన్‍ ఉట్టను తాఖత్‍ అజు పరిసుద్ధహుయుతె ఆత్మనాటేకె దేవుని ఛియ్యానితర ప్రభావంతీ జనాబనా హాఃమె రుజుహుయు, <verse eid="ROM 1:4"/><verse number="5" style="v" sid="ROM 1:5"/>క్రీస్తుయేసు నామ్ను బణేతీ సమస్తంను అద్మిహాఃరు విష్వాస్‍నా విధేయులునాహువనాటేకె ఇనా బరేమా హమే కృపబి అపొస్తులునుత్వవం పొందిరాక్యస్‍. <verse eid="ROM 1:5"/><verse number="6" style="v" sid="ROM 1:6"/>ఇనేతి హామే కృపబి, తుమేబి ఇవ్నామా రవ్వాలహుయిన్‍ యేసు క్రీస్తువాలంతర రవ్వానటెకె బులాయ్‍ రాఖిన్‍ ఛా,<verse eid="ROM 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7"/>హుయుతో రోమను హాఃరవ్నా గూర్చి అజు దేవ్ను లాఢ్‍హుయాతె అద్మియేనుటేకె లిఖ్యో; మారొ దేవ్‍ అప్ను భా హుయుతె ప్రభువుహుయుతె యేసుక్రీస్తు అప్నా గోర్‍బి షాంతి దిసె,<verse eid="ROM 1:7"/></para>
  <para style="s">కృతజ్ఞత ప్రార్థన</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8"/>తుమారు విష్వాస్‍ ములక్‍హాఃరు ప్రచార్‍హువను దేఖిన్‍ అగాఢి తుమారు హాఃరవ్నాటేకె యేసుక్రీస్తు బారేమా మార దేవ్నా కృతజ్ఞాతస్తుతుల్‍ బోలుకురుస్‍, <verse eid="ROM 1:8"/><verse number="9" style="v" sid="ROM 1:9"/>అనహాఃజె యో ఛియ్యోను సువార్తను విషయంమా మే మారు పూర్ణదిల్మా సేవించుకరతె దేవస్‍ మన సాబుత్‍, <verse eid="ROM 1:9"/><verse number="10" style="v" sid="ROM 1:10"/>హంకె కింమ్‍ కింతోబి ఆటంకం కొయినీతిమ్ తుమారకన‍ ఆవనటెకె దేవ్ని చిత్తంతీ వీల్‍హువస్‍షికి కరి, మారు ప్రార్థనమా కెదేబి ఇనస్‍ బతిమాలుకురుస్‍, <verse eid="ROM 1:10"/><verse number="11" style="v" sid="ROM 1:11"/>తుమె ఏక్‍ జొగొ ఖడ్నూకిరి, కతొ తుమ్నబి మనబీ కల్గీన్‍ఛాతె విష్వాస్‍న క్హాజె, కతొ అప్నే ఏక్ను విష్వాస్‍తి ఏక్‍ ఆదరణపొందును కరి, మారు ఆఖ్‍ః <verse eid="ROM 1:11"/><verse number="12" style="v" sid="ROM 1:12"/>ఆత్మాసంబంధంహుయూతె కృపావరంను కెహూబి తుమ్నా దెవ్వానా తుమ్న దేనుకరి ఆహ్క కరుకరూస్‍;<verse eid="ROM 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13"/>భైయ్యె మే అలాదుహుయూతె అన్యజనాభోమా ఫల్‍ పొందునుకరి తుమారమాబి కెహూబి ఫాయ్‍దొ పొందునుతింమ్‍ కెత్రూకి వహఃత్‍ తుమారకన ఆవ్నుకరి సోఛొ థొ; పన్కి హంకెతోడి ఆటంకంహుయూతు; ఆ తుమ్న మాలంకొయినితింమ్‍ రవ్వాను మన ఇష్టంకొయిని; <verse eid="ROM 1:13"/><verse number="14" style="v" sid="ROM 1:14"/>గ్రీసు దేహ్ఃవాలనబి గ్రీసుదేఖ్‍ఃవాలకాహేతె ఇవ్నబి, జ్ఞానుల్‍నబి బుద్దికొయింతె ఇవ్నబి మే రుణస్తుడ్‍; <verse eid="ROM 1:14"/><verse number="15" style="v" sid="ROM 1:15"/>ఇంమ్‍ హుయూతొ మారవల హువ యెత్రుతోడి రోమమాఛ్చాతె తుమ్నబి సువార్తన బోలనాటెకె తయాయ్‍ హుయీన్‍ఛావ్‍.<verse eid="ROM 1:15"/></para>
  <para style="s">సువార్తను థాకత్</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16"/>సువార్తనటేకె మే ష్యరమ్‍హువవాలొ కాహె కింకతొ విష్వాస్‍ హర్యేక్‍ జననా, అగాఢి యూదుల్‍దేఖ్‍ః, గ్రీసుదేఖ్‍ః వాలనబి బఛ్చాడనాటేకె యో దేవ్ని థాఖత్‍ హుయిన్‍‌ ఛా <verse eid="ROM 1:16"/><verse number="17" style="v" sid="ROM 1:17"/>సానకతో నీతిమంతుడ్‍ విష్వాస్‍నుబారెమా జివ్సేకరి లిక్కాయ్‍రాక్యుతిమ్‍ విష్వాస్‍నుబారేమా ఘను విష్వాస్‍హువతింమ్‍ దేవ్ని నీతి ఇనమా బయలు పరుచుబడుకురాస్‍.<verse eid="ROM 1:17"/></para>
  <para style="s">అద్మియేను పాప్</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18"/>దుర్నితి హాఃచిన ఆఢు ఆవతె అద్మియేను సమస్తనా భక్తితపార్‍ దుర్నీతిపార్‍ దేవ్ని చంఢాల్‍ స్వర్గంతూ బయలుపరుచుబడుకురాస్‍ <verse eid="ROM 1:18"/><verse number="19" style="v" sid="ROM 1:19"/>సానకతో దేవ్న గూర్చూన్‍ మాలంకర వెత్రూ కెహూకి యో ఇవ్నూ ఇచ్మా విషద్దపరచి రాక్యోస్‍, <verse eid="ROM 1:19"/><verse number="20" style="v" sid="ROM 1:20"/>ఆ ములక్‍ ఫైదయుతే కంతు, అనంతహుయుతే థాఖత్‍ దైవత్వమ్‍ కరి యో అద్రుష లక్చణం, కతో యో నిత్యథాఖాత్‍ దేవ్‍త్వమ్‍బి, ధర్తిను అగాఢితూ నిఖిన్‍ సృష్టంచిహుయూతె రాచునబి హాఃయల్‍కరమా తేటపరుచుకరస్‍ పన్కి ఇవ్నే నిరుత్తర్‍ హుయీన్‍ ఛా. <verse eid="ROM 1:20"/><verse number="21" style="v" sid="ROM 1:21"/>బుజు ఇవ్నే దేవ్నా మాలంకరీన్‍బి ఇనా దేవ్‍కరి మహిమపరచకొయినీ, కృతజ్ఞతస్తుతులుబి చెల్లించకొయినీ, పన్కి ఇవ్ను లఢాయమా వ్యర్దయుల్‍హుయూ ఇవ్నే అవివేకలు దిల్‍తి అంధారుహుయు, <verse eid="ROM 1:21"/><verse number="22" style="v" sid="ROM 1:22"/>ఇవ్ను అక్కల్‍వాల కరి బోలిదు పన్కి ఇవ్నే బుద్దిహీనుల్‍హుయూ, <verse eid="ROM 1:22"/><verse number="23" style="v" sid="ROM 1:23"/>ఇవ్నే మఠిజాసెకొయినితిమ్‍ దేవ్ని మహిమన మట్టిజంకతె అద్మితీబి, జిన్వార్‍తిబీ, నాక్హనూజిన్వార్‍తీబి, కీడనుతీబి, హార్యేక్‍ రూపంమా బద్లయా<verse eid="ROM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24"/>అనహఃజే ఇవ్నే ఇవ్ను దిల్‍ను ఆహ్ఃనాబ్హనె చాలిన్‍, ఇవ్ను ఆంగ్తాను ఇవ్నమా ఇవ్నేస్‍ అవమానం కర్లెనుతింమ్‍ దేవ్‍ ఇవ్నా అపవిత్రతన దెవ్వాడిదిదూ <verse eid="ROM 1:24"/><verse number="25" style="v" sid="ROM 1:25"/>ఎజాత్నూ ఇవ్నే దేవ్ను హాఃచినా జూటింతర బద్లాయిన్‍ బుజు సృష్టికర్తన బదుల్‍ సృష్టంనా ప్రార్థనకరీన్‍ సేవించుతూ యోస్‍ యుగయుగల్నా స్తోత్రార్హుడుహుయిన్‍ ఛా ఆమెన్‍. <verse eid="ROM 1:25"/><verse number="26" style="v" sid="ROM 1:26"/>అనటేకే దేవ్నె ఇవ్నా కారబ్‍హుయుతె ఆహ్ః దరాయిదిదో. ఇవ్ని బాయ్‍కొ స్తెతం సహజ సంబంధనా మ్హెందీన్‍ అసహజహుయుతె సంబంధనా ఎంచిలిదా. <verse eid="ROM 1:26"/><verse number="27" style="v" sid="ROM 1:27"/>ఇంమితరస్ మరద్మానోబి బాయ్‍కవ్‍ను సహజ ధర్మంనా బెందీన్‍, మరధ్‍మానోతి మరధ్‍మానొ నాకర్నూతె కర్తూహుయీన్‍, ఇవ్ను తప్పున కామ్‍నా తగినా ప్రతిపలం పోందిలిన్‍ ఏక్‍ప్పర్‍ ఏక్‍ మస్తివాలుహుయా. <verse eid="ROM 1:27"/><verse number="28" style="v" sid="ROM 1:28"/>బుజు ఇవ్నే ఇవ్నూ దిల్‍మా దేవ్నా జొగొన దిదూకొయినీ. అనహఃజే కరకొయింతె కార్యాల్‍నా కరన దేవ్‍ భ్రష్ట్ దిల్నా ఇవ్నా దెవాడో. <verse eid="ROM 1:28"/><verse number="29" style="v" sid="ROM 1:29"/>ఎజాత్నూ ఇవ్నే సమస్తహుయూతె దుర్నితిబి, దుష్టత్వంక్హూబి, లోభితిక్హూబి, ఈర్ష్యహూఃబి, బరాయ్‍హుయీన్‍, ఏక్కతో ఏక్‍పడ కొయినితిమ్‍, మర్రాకనూ, లఢాయ జగనా బుజు వైరమ్‍ భరాయ్‍ రయ్యూ. <verse eid="ROM 1:29"/><verse number="30" style="v" sid="ROM 1:30"/>చాహ్డాన బోలవాలు, నిందల్‍ నాఖవాలు, దేవ్నా ద్వేషించవాల, హింసకరవాల, హంకార్‍వాల, జూటి వాతె బోలవాలు, ఆయ బాన వాతె ఖంజకొయింతె ఇవ్నా, <verse eid="ROM 1:30"/><verse number="31" style="v" sid="ROM 1:31"/>అఖ్కల్‍కొయింతె ఇవ్నా, వాత్‍ బద్లావవాల, అనురాగరహితూల్‍బి, గోర్‍కొయిన్‍తెవాల. <verse eid="ROM 1:31"/><verse number="32" style="v" sid="ROM 1:32"/>అజాత్ను కార్యల్‍నా అభ్యసించవాలన మరణ్‍న బరాబ్బర్‍ పూరిగయూహు కరి దేవ్ని న్యాయవిధినా ఇవ్నే అఛ్చుతి మాలంకరీన్‍బి, ఇనాస్‍ కరూకరస్‍. ఆస్‍ కాహేతింమ్‍ ఇనేతి అభ్యసించుకరతే ఇవ్నేతి ఖుషీతి ఒప్పిలెంకరాస్‍.<verse eid="ROM 1:32"/></para>
  <chapter eid="ROM 1"/>
  <chapter number="2" style="c" sid="ROM 2"/>
  <para style="s">దేవ్ను న్యావ్‍</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1"/>అనహఃజే న్యావ్‍ తీర్చు కరుకురతే అద్మి, తూ కోన్‍ రయ్యోతోబి సరే నిరుత్తుడ్‍హుయిన్‍ ఛ్చా. కెహూ విషయంమా అగాఢివాలన న్యావ్‍ తీర్చుకరస్‍కి ఇనా విషయంమా తూస్‍ దోషికరి న్యావ్‍ తీర్చిలెంకరస్‍; సానకతో న్యావ్ తీర్చుకరతె తూబి ఎజాత్నూ కార్యల్‍నా కరుకరస్‍ని కాహేనా? <verse eid="ROM 2:1"/><verse number="2" style="v" sid="ROM 2:2"/>ఎజాత్నూ కార్యల్‍నా కరవాలప్పర్‍ దేవ్ను న్యావ్‍ హాఃచినా అనుసరించనూస్‍ కరి మలంరాక్చూ.<verse eid="ROM 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 2:3"/>ఎజాత్నూ కార్యల్‍నా కరుకరతె ఇవ్నా న్యావ్‍ తీర్చును ఇనాస్‍ కరుకరతె అద్మి, తూ దేవ్ను న్యావ్‍మతూ చుక్కాయ్‍జైస్‍కరి సోచిలెంకరస్‍న్నా? <verse eid="ROM 2:3"/><verse number="4" style="v" sid="ROM 2:4"/>దేవ్ను కటాక్చమ్‍ తునా పస్చాత్తాపమ్‍ హువనాటేకె తున ప్రేరేపించుకరస్‍ కరి మాలంకొయినీ తింమ్‍ ఇను అష్యల్‍ను కతో ఐష్వర్యమును సహనంనా దీర్ఘ షాంతంనా నొకొరిబొలుకురాస్‍న్నా? <verse eid="ROM 2:4"/><verse number="5" style="v" sid="ROM 2:5"/>తారు ఘట్‍ జాన్‍ బద్లాకొయింతె తారు దిల్నా అనుసరించీన్‍, చంఢాల్‍న ధన్నె తెదె కతో దేవ్ను హాఃచి న్యాయంహుయ్‍తె న్యావ్‍ బాధర్‍ నాక్చే ధన్నే తారు తూస్‍ ఖీజ్‍నా లాయిలెంకరస్‍. <verse eid="ROM 2:5"/><verse number="6" style="v" sid="ROM 2:6"/>యో హర్యేక్‍జననా ఇను ఇని క్రియల్‍నా బట్టీన్‍ ప్రతిఫలం దిస్యే. <verse eid="ROM 2:6"/><verse number="7" style="v" sid="ROM 2:7"/>అష్యల్ క్రియల్‍నా ఓపికతి కర్తూ, మహిమన, ఘనతన, అక్చయతన ధూండవాలన నిత్యమ్‍ జీవం దిస్యే. <verse eid="ROM 2:7"/><verse number="8" style="v" sid="ROM 2:8"/>హుయుతొ లఢాయనా కరాయిన్‍, హాఃచినా లొంగకొయినీతిమమ్‍ దుర్నితినా లోబడతె ఇవ్నప్పర్‍, దేవ్ను చంఢాల్‍బి ఖీజ్‍బి ఆవ్సే. <verse eid="ROM 2:8"/><verse number="9" style="v" sid="ROM 2:9"/>దుష్‍కార్యంనా కరతె హర్యేక్‍ అద్మిను ఆత్మనా అగాడి యూదుల్‍కరి, గ్రీసుదేఖ్‍ వాలనబి, మిన్హత్‍, వేదనల్‍బి హుషే. <verse eid="ROM 2:9"/><verse number="10" style="v" sid="ROM 2:10"/>అష్యల్‍కరతె హర్యేక్‍జననాబి, అగాడి యూదుల్‍, గ్రీసుదేక్హ్ వాలనబి, మహిమబి, ఘనతబి షాంతిసమాధానం హూస్‍.<verse eid="ROM 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 2:11"/>దేవ్నా హర్యేక్‍జనణ పక్చపాతం కొయినితిమ్‍ <verse eid="ROM 2:11"/><verse number="12" style="v" sid="ROM 2:12"/>ధర్మషాస్ర్తం రవాలహుయిన్‍ పాప్‍ కర్యూహు ఖారు ధర్మషాస్ర్తంను న్యావ్‍ లిషె. <verse eid="ROM 2:12"/><verse number="13" style="v" sid="ROM 2:13"/>ధర్మషాస్ర్తంన క్హంజవాలు దేవ్ను నాజర్‍మా నీతిమంతుల్‍ కాహేగాని ధర్మషాస్ర్తంనా చాలవాలొ ప్రవర్తించాలోస్‍ నీతిమంతుడ్‍ గోణి ఎంచబడ్‍సే. <verse eid="ROM 2:13"/><verse number="14" style="v" sid="ROM 2:14"/>ధర్మషాస్ర్తం కొయింతే అన్యజనాభోనా ధర్మషాస్ర్తంను సంబంధంచుయుహు క్రియల్‍న కర్యుతెదె ఇవ్నేధర్మషాస్ర్తం కొయింతెహుయుతోబి, ఇవ్ను ఇవ్నేస్ ధర్మషాస్ర్తం హువంతరా ఛా. <verse eid="ROM 2:14"/><verse number="15" style="v" sid="ROM 2:15"/>ఎజాత్నానూ దిల్‍క్హాఛిబీ సాక్చిబోలుకరతోబి, ఇవ్ను క్హయల్‍ ఏక్నూప్పర్‍ ఏక్‍ తప్పుననాక్తూ న్హైతో తప్పు కొయినీకరి బొలుకరతోబి, ధర్మషాస్ర్తం సారంతీ ఇవ్ను దిల్‍నుక్హామె లిక్కారుతింమ్‍ వతాలుకరస్‍. <verse eid="ROM 2:15"/><verse number="16" style="v" sid="ROM 2:16"/>దేవ్‍ మారు సువార్తన‍ ప్రకారం యేసు క్రీస్తున బారేమ అద్మిను రహస్యాల్‍నా న్యావ్‍కరను ధన్నే ఇమ్‍ హుసే.<verse eid="ROM 2:16"/></para>
  <para style="s">యూదుల్‍ అజు చట్టం</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17"/>తూ యూదుల్‍కరి నామ్‍ మ్హేందిలీన్‍ ధర్మషాస్ర్తంఫర్‍ బరోసారాఖీన్‍ దేవ్నక్హామె అతిసయించుకరస్‍ కాహేనా? <verse eid="ROM 2:17"/><verse number="18" style="v" sid="ROM 2:18"/>ఇను చిత్తంనమాలంకరీన్‍, ధర్మషాస్ర్తంకన ఉపదేషంనా పొందొహుయుహొ వాలొరహీన్‍, స్రేష్ఠహుయూతె ఇనస్‍ మెఛ్చిలెంకరస్‍ని కాహేనా? <verse eid="ROM 2:18"/><verse number="19" style="v" sid="ROM 2:19"/>జ్ఞాన్‍ ఖాచ్ఛిన స్వరూప్‍హుయూతె ధర్మషాస్ర్తంన కల్గీరహీన్‍, మే కాణ ఢోలవాలనా వాట్‍వతాలవాలొ. అంధారమా ఛ్చాతెఇవ్నా ఉజాలునా, <verse eid="ROM 2:19"/><verse number="20" style="v" sid="ROM 2:20"/>అంధారమా ఛాతె ఇవ్నా ఉజాలునా, అక్కల్ కొయింతెవాలనా అజు హాఃచిన సిక్చాదెవ్వాను, లడ్కావ్‍నా ఉపాధ్యాయులుహుయిన్‍ ఛాకరి తారు తూస్‍ ధైర్యమ్‍నా లాయిలెంకరస్‍ కాహేనా? <verse eid="ROM 2:20"/><verse number="21" style="v" sid="ROM 2:21"/>హాఃమెనువాలన బోధించవాలో తూ తున తూస్‍ బోధించికోలేయిన్నా? ఛోర్‍నుకామ్‍ నొకొకర్‍కరి ప్రచార్‍కర్యతె తూ ఛోర్‍నుకామ్‍ కరాస్‍న్నా? <verse eid="ROM 2:21"/><verse number="22" style="v" sid="ROM 2:22"/>వ్యభిచార్‍ నొకొకర్‍కరి బోలతె తూస్‍ వ్యభిచార్‍కరస్‍న్నా? విగ్రహాల్‍నా అసహ్యింయంచతె తూ గుడినా దోచిలేస్‍న్నా? <verse eid="ROM 2:22"/><verse number="23" style="v" sid="ROM 2:23"/>ధర్మషాస్ర్తంమా అతిసయించతె తూ ధర్మషాస్ర్తం మీరమా అనహఃజే దేవ్ను ఇజ్జాత్‍ కాఢస్‍న్నా? <verse eid="ROM 2:23"/><verse number="24" style="v" sid="ROM 2:24"/>లిఖ్కాయ్‍రు ప్రకారమ్‍ తుమారటెకేస్‍కాహేనా దేవ్ను నామ్‍ అన్యజనాభోనా ఇచ్మా గాలయ్‍ఖాసు?<verse eid="ROM 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25"/>తూ ధర్మషాస్ర్తంనా అనుసరించీన్‍ చాలవాలో హుయ్‍రోతొ, సున్నతి ప్రయోజనంహుసే పన్కీ ధర్మషాస్ర్తంనా మీరీన్‍ అతిక్రమించవాలొహుయోతో, తారు సున్నతి సున్నతికాహె తింమ్‍హుసె. <verse eid="ROM 2:25"/><verse number="26" style="v" sid="ROM 2:26"/>అనహఃజే సున్నతి కొయింతెయో ధర్మషాస్ర్తంను నీతి నియామాల్‍నా మాలంకర్యతొ తెదె యో సున్నతి కొయింతే వాలొ హుయ్యోతోబి సున్నతి ర్హావాలంతరా ఎంచబడ్చే కాహేనా? <verse eid="ROM 2:26"/><verse number="27" style="v" sid="ROM 2:27"/>బుజు ఛాల్‍నబట్టీన్‍ సున్నతి కొయింతే యో ధర్మషాస్ర్తంనా నెరవేర్చితొతెదె అక్చర్‍నా సున్నతిబి హువ్వాలొహుయీన్‍ ధర్మషాస్ర్తంనా అతిక్రమించతె తున న్యావ్‍నా తీర్చకొయిన్నా? <verse eid="ROM 2:27"/><verse number="28" style="v" sid="ROM 2:28"/>ఉప్పర్‍ యూదుల్‍నితర హుయోహొ యూదుల్‍ కాహె; ఆంగ్తానుప్పర్‍ సున్నతిహుయోతె సున్నతి కాహె. <verse eid="ROM 2:28"/><verse number="29" style="v" sid="ROM 2:29"/>హుయ్‍తొ దిల్‍మా యూదుల్‍హుయేతె యోస్‍ యూదుల్‍. బుజు సున్నతి దిల్నా సంబంధహుయీన్‍ ఆత్మమా జరగకొయింతెస్‍ పన్కి అక్చరంనాహాఃజె కలగ్చెతె కాహె. ఎజాత్ననా మెఛ్చతె అద్మిటేకె కల్గకొయినీ, దేవ్నాబారేమాస్‍ కలగ్చె.<verse eid="ROM 2:29"/></para>
  <chapter eid="ROM 2"/>
  <chapter number="3" style="c" sid="ROM 3"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1"/>అమ్‍హుయుతో యూదుల్నా హుయుతె మహాన్‍ సాత్? సున్నతినాటేకె ప్రయోజనంసాత్‍? <verse eid="ROM 3:1"/><verse number="2" style="v" sid="ROM 3:2"/>క్హాచిస్‍ హర్యేక్‍విషయంమా గ్హానుస్‍. అగాఢిను, దేవ్ను వాతె అగ్గాడిస్‍ యూదుల్‍నా దెవ్వాయుగయూ. <verse eid="ROM 3:2"/><verse number="3" style="v" sid="ROM 3:3"/>కింకతో థోడుజను అవిస్వాసులు నాహుయుతె? ఇవ్నే అవిస్వాసుహుయుతెతిమ్‍ దేవ్‍ విష్వాస్‍వాలొ ర్హాసేకొయిన్నా? ఇమ్‍నాబొల్‍ను. <verse eid="ROM 3:3"/><verse number="4" style="v" sid="ROM 3:4"/>ఇమ్‍ హుస్‍కొయిని “తారు వాత్మా తూ నీతిమంతుడునితరా తీర్చబడ్నుతిమ్‍ తూ న్యావ్‍హుయుతెదె గెల్చనుతిమ్‍” కరి లిఖ్యుతిమ్‍ ప్రకారం హార్యేక్‍ అద్మియోను చాఢివాలనితార పన్కి దేవ్‍ మాత్రం హాఃఛివాలొ.<verse eid="ROM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5"/>అప్ను దుర్నితి దేవ్నా నీతిను ప్రసిద్ధి హాఃరుయుతె బారేమా సాత్‍బొల్‍సు? తో హామే ఖారబ్‍ కామ్‍ కర్యాతో కిజ్హానా వొతాల్‍ దేవ్‍ అన్యాయుస్తు హుసెనా? మే అద్యియోనుతార వాత్‍బొలుకురుస్‍; <verse eid="ROM 3:5"/><verse number="6" style="v" sid="ROM 3:6"/>ఇమ్‍నాబొల్‍ను. ఇమ్‍ హుసేతో దేవ్‍ ములక్‍నా కిమ్‍ న్యావ్‍ తీర్‍చె?<verse eid="ROM 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7"/>మారు జోట్టినాటేకె దేవ్‍ హాఃచి ప్హైలగుతో ఇనా మహిమ కలిగ్యుతొ మే పాప్‍కర్యూహుయో న్యావ్‍ పొందనా సానా? <verse eid="ROM 3:7"/><verse number="8" style="v" sid="ROM 3:8"/>ఆవొ అప్నె హాఃరు ఖరాబ్‍ కామ్‍కారి అష్యల్ హోను, ష్యానకతొ అప్న థోడుజను తుమ్న గాలెదీన్‍ బోల్యుతె ప్రకారం హమె ష్యాన నాబొల్ను? ఎజాత్ననా హుస్‍తె సిక్చావిధి న్యాయమస్‍.<verse eid="ROM 3:8"/></para>
  <para style="s">కోన్బి నీతిమంతుల్‍ కొయిని</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9"/>కిమ్‍హుయుతోబి సాత్‍బోల్సుకరి? హమే ఇవ్నేతి స్రేష్ఠలంనా? కామ్‍వాలన? ఎత్రే మాత్రమంకాహే యూదుల్‍ గ్రీసుదేక్హ్ను హాఃరుజణు పాప్‍నాహేట్‍ ఛాకరి అనఅగాడి హఃరాబ్‍ వాతెకరి రాహఃస్‍,<verse eid="ROM 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 3:10"/>అనగూర్చి లిఖ్కిరాక్యుతె సాత్‍కతొ నీతిమంతుడ్‍ కొయిన్‍, లేఖనాల్‍ తిమ్‍ ఏక్జనుబి కొయిని,<verse eid="ROM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 3:11"/>గ్రహించువాలొ కొన్బిస కొయిని</para>
  <para style="q2" vid="ROM 3:11">దేవ్నా ధూండవాలు కొన్బి కొయిని,<verse eid="ROM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12"/>హాఃరుబి వాట్‍ చుక్కిజైయిన్‍ ఏక్‍హుయిన్‍</para>
  <para style="q2" vid="ROM 3:12">కామెఆవకొయిని తిమ్‍ హుయ్‍గయూ.</para>
  <para style="q2" vid="ROM 3:12">మేల్‍ కరవాలు కొయిని, ఏక్జనుబి కొయిని.<verse eid="ROM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13"/>ఇవ్నే బాకు కాడ్యుతె గొర్రాడు,</para>
  <para style="q2" vid="ROM 3:13">ఇవ్ను జీబ్తి మోసం కర్సె;</para>
  <para style="q2" vid="ROM 3:13">ఇవ్ను వోట్ను ఉప్పట్‍ హాఃప్ను విషం ఛా.<verse eid="ROM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ROM 3:14"/>ఇవ్ను బాకుభరిన్‍ సపించానుబి ఖీజ్బి ఛా.<verse eid="ROM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15"/>ల్హొయినా దేఖనాటేకె<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">మూల భాషమా ఇవ్ను గోఢ మార్రకనాటేకె మిలాంకరస్‍.</char></note> ఇవ్ను గోడ మిలాంకరాస్‍.<verse eid="ROM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ROM 3:16"/>నాసనంనా కష్టంనా ఇవ్నే వాట్‍మా ఛా.<verse eid="ROM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17"/>షాంతి వాట్మా ఇవ్నేనా మాలంకొయిని.<verse eid="ROM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ROM 3:18"/>ఇవ్ను నజర్నానా హాఃమే దేవ్ను ఢర్‍ కొయిని.<verse eid="ROM 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19"/>హార్యేక్‍ను బాకు ముచ్చావ్‍నుతిమ్‍, ములక్‍హాఃరు దేవ్ను సిక్చనా పాత్రహుయుతిమ్‍, ధర్మషాస్ర్తం బోలుకరతె ఆహాఃరన ధర్మషాస్ర్తంనా లోబడెనుహుయుతె ఇవ్నేతి బోలుకురుస్కరి మాలంకర్చు. <verse eid="ROM 3:19"/><verse number="20" style="v" sid="ROM 3:20"/>కింకతొ ధర్మషాస్ర్తం సంబంధంహుయుతె క్రియనుమూలంతి కెవు అద్మిమిబి ఇన నజర్మా ఆంగ్తాను నీతిమంతుడ్‍ కరి తీర్చబడ్సెకొయిని; ధర్మషాస్త్రంనాటేకె పాప్‍ కాతొ కెజాత్నుకి మాలంహుకొరాస్.<verse eid="ROM 3:20"/></para>
  <para style="s">దేవ్ కనా నీతిమంతుడ్‍నిరా కిమ్‍ హుసు</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21"/>అమ్‍ఛాతొ ధర్మషాస్ర్తంనా అలదుతి దేవ్నా నీతి భార్‍ పడుకరస్; ఇన ధర్మషాస్ర్తంనా ప్రవక్తల్‍నా సాక్చ్యం దెమ్కరాస్‍. <verse eid="ROM 3:21"/><verse number="22" style="v" sid="ROM 3:22"/>ఆ యేసు క్రీస్తుమా నీతి విష్వాస్‍ మూలంహుయుతె, నమ్మతె ఇవ్నా హాఃరవ్నా హుసెతె దేవ్ను నీతిహుయిన్‍ ఛా. కెహు భేదం కొయిని; <verse eid="ROM 3:22"/><verse number="23" style="v" sid="ROM 3:23"/>హాఃరుబి పాప్‍ కరీన్‍ దేవ్‍ అనుగ్రహించొతె మహిమనా పొందకొయిన్‍తిమ్‍ చల్‍జొంకొరస్‍. <verse eid="ROM 3:23"/><verse number="24" style="v" sid="ROM 3:24"/>అనటేకే నమ్మస్‍తె ఇవ్నే ఇన కృపతీస్‍, క్రీస్తుయేసుమా విమోచనమ్‍తీస్‍ థ్యారకతీ నీతిమంతుడ్‍ కరి తీర్చబడుకురస్‍. <verse eid="ROM 3:24"/><verse number="25" style="v" sid="ROM 3:25"/>క్రీస్తుయేసు ల్హొయి విస్వాస్‍తీస్‍ లయోస్‍ కరుణాధారంతి బయలుపర్చొ. దేవ్ యేసుక్రీస్తునా అప్నా బలి అర్పణంగా అర్పించొ. జమానమా కర్యూహుయుతె పాప్‍నా దేవ్ ఇను ఓర్పుతి ప్రాయష్చితమ్‍ యో ఇను నీతిన వతాలిలెంకరస్‍కరి. <verse eid="ROM 3:25"/><verse number="26" style="v" sid="ROM 3:26"/>దేవ్‍ హంకెను కాలంమా ఇను నీతిన దెఖాడతె నిమిత్తం, యో నీతిమంతుడ్‍ కరి యేసుమా విష్వాస్‍ఛాతె ఇనా నీతిమంతుడుతార న్యావ్‍కరవాలొహుయిన్‍ రావ్వానటేకె యో ఇమ్మాస్‍ కర్యొ.<verse eid="ROM 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27"/>అనటేకె అప్నే బడ్డాయ్‍ బొలిలేవ్వాన కెజ్గా? ఇనా మర్రాకి దెవ్వాను హుయుగు. కేవు న్యాయంనాబట్టీ ఇనా మర్రాకిదిసే? క్రియనియమంను బట్టీన్నా? కాహే, ధర్మషాస్ర్తం విష్వాస్‍ నియంమ్నాటేకెస్‍. <verse eid="ROM 3:27"/><verse number="28" style="v" sid="ROM 3:28"/>కతో ధర్మషాస్ర్తం సంబంధహుయుతె, క్రియల్‍నా కొయిన్‍తిమ్‍ విష్వాస్‍తీస్‍ అద్మియోనా నీతి మంతుడ్‍తరా తీర్చబడుకరస్కరి ఎంచుకురస్‍. <verse eid="ROM 3:28"/><verse number="29" style="v" sid="ROM 3:29"/>దేవ్‍ యూదుల్‍నా మాత్రంమస్‍ దేవ్నా? అన్యజనాభోనా దేవ్‍ కావేనా? ఒహో, అన్యజనాభోనాబి దేవ్‍. <verse eid="ROM 3:29"/><verse number="30" style="v" sid="ROM 3:30"/>దేవ్‍ ‍ఎక్కస్‍ పన్కి, యో యూదుల్‍ ఇవ్నే విస్వాస్‍ మూలంగాతీబి, అన్యజనుల్‍ ఇవ్నే విష్వాస్‍మ్ను బరేమా, నీతిమంతుడ్‍తరా తీర్చె. <verse eid="ROM 3:30"/><verse number="31" style="v" sid="ROM 3:31"/>విష్వాస్‍బారెమా ధర్మషాస్త్రంనా నిరర్థకం కరూకరియేస్‍నా? ఇమ్‍నబొల్‍ను; ధర్మషాస్ర్తంనా పాటించుకరియేస్‍.<verse eid="ROM 3:31"/></para>
  <chapter eid="ROM 3"/>
  <chapter number="4" style="c" sid="ROM 4"/>
  <para style="s">విష్వాస్‍ను బారెమా అబ్రాహామ్‍ నిర్దోషితరా హువను</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1"/>అనటేకె ఆంగ్తాను విషయంమ అప్ను మూల మరద్మానొహుయుతె అబ్రాహామ్‍నా సాత్‍ మల్యుకరి బోల్సు ఇను అనుభవం సాత్‍? <verse eid="ROM 4:1"/><verse number="2" style="v" sid="ROM 4:2"/>అబ్రాహామ్ను కామ్ను మూలంతి నీతిమంతుడ్‍ కరి తీర్చబడీన్‍ ర్హయోతొ ఇనా అతిసయకారణం హుస్‍ పాన్కి యో దేవ్నా హాఃమే హుసెకొయిని.<verse eid="ROM 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 4:3"/>లేఖనం సాత్‍ బోలుకరస్‍? అబ్రాహామ్ను విష్వాస్‍ బారేమా దేవ్నా నమ్యో, యో ఇనా నీతితి ఎంచబడ్యు <verse eid="ROM 4:3"/><verse number="4" style="v" sid="ROM 4:4"/>కామ్‍ కరవాలొనా జీతంనా జీతగాడ్ పన్కి దానంకరి బహుమతికరి ఎంచబడకొయిని ఇనటేకె కామ్‍ కర్ను. <verse eid="ROM 4:4"/><verse number="5" style="v" sid="ROM 4:5"/>కామ్‍ కరకొయినితిమ్‍, భక్తిహీనుడ్నా నీతిమంతుడ్నితరా తీర్చు వాలోనా విష్వాస్‍ బట్టి ఇనబీ ఇన విష్వాసంనా నీతి తరా ఎంచబడుకరస్‍. <verse eid="ROM 4:5"/><verse number="6" style="v" sid="ROM 4:6"/>యో ప్రకారం క్రియల్‍ కొయినితిమ్‍ దేవ్నాస్‍ ఇనా నీతిమంతుడ్‍తరా ఎంచొయో అద్మియే ధన్యుడ్‍కరి దావీద్‍బి బోలుకరస్‍.<verse eid="ROM 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7"/>“ఇను పాప్‍నా ప్రాయచిత్తం పొంద్యొతె యో ధన్యుడు.</para>
  <para style="q2" vid="ROM 4:7">కింకాతొ ఇను అతిక్రమంనా మాప్‍ పరిహరింపబడ్చె. పొంద్యొతెయో<verse eid="ROM 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8"/>ప్రభువుహాతె పాప్‍నా లెక్కమా లెవ్వాకొయిన్‍తె యో ధన్యుడు.”<verse eid="ROM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9"/>ఆ ధన్యవచనం సున్నతి ఛాతె ఇవ్నే యూదుల్‍ గూర్చి బొలయునా సున్నతి కొయిన్‍తె ఇవ్నే అన్యజనుల్నా గూర్చిబి బొలయునా? అబ్రాహామ్‍ను విష్వాస్‍ ఇనా నీతి కరి ఎంచబడుకురస్‍ కాహేనా? <verse eid="ROM 4:9"/><verse number="10" style="v" sid="ROM 4:10"/>అషల్; యో కెవు సీతిమా ఎంచబడ్యు? అబ్రహామ్‍ సున్నతి కలిగిరాహితొ సున్నతి కొయితెటెపార్‍? సున్నతి కలిగిరాహితొ కాహె సున్నతి కొయింతెదెస్‍. <verse eid="ROM 4:10"/><verse number="11" style="v" sid="ROM 4:11"/>అజు సున్నతి కొయింతే ఇవ్నేనా, నమ్మతె ఇవ్న ఖార్వానా యో భా హువనటేకె ఇవ్నే నీతి ఆరోపించనాటేకె, యో సున్నతి పొందకొయింతె అగాడి, ఇనా కలుగుతె విష్వాస్‍హుయుతె నీతినా ఛాపొ, సున్నతి కరి సాబుత్‍ పొందెయో. <verse eid="ROM 4:11"/><verse number="12" style="v" sid="ROM 4:12"/>అజు సున్నతి ఛాతె ఇవ్నే భా హువనటేకె, కాతొ సున్నతి మాత్రం పొందితె ఇవ్నే కాహే అప్ను భాహుయుతె అబ్రాహామ్ను సున్నతి పొందకొయితె అగాఢి ఇనా కల్గితె విష్వాస్‍ను ఛాల్యుతె ఇవ్నే భా హువానటేకె, యో గుర్తు పొందెయో.<verse eid="ROM 4:12"/></para>
  <para style="s">విష్వాస్‍ బారెమా దేవ్ను వాగ్దానం పొందిలేవను</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13"/>యో ములక్నా వారసుడ్‍హుసె వాక్ముల్ అబ్రాహామ్‍నాబి ఇను సంతానంనాబి ధర్మషాస్ర్తం మూలంతి హుయుకొయిని పన్కి విష్వాస్‍నాటేకెహుయుతె నీతి మూలంతీస్‍ కల్యుగు. <verse eid="ROM 4:13"/><verse number="14" style="v" sid="ROM 4:14"/>ధర్మషాస్ర్తం సంబందుల్‍నా వారసుల్‍హుయతె విష్వాస్‍నా పాల్తుహుసెకొయిని, ఈ వాక్ముల్‍ నిరర్థకంహుస్‍. <verse eid="ROM 4:14"/><verse number="15" style="v" sid="ROM 4:15"/>కింకతొ ధర్మషాస్ర్తంనా ఖీజ్‍నా ఫైదకరతె; ధర్మషాస్ర్తం కొయింతెబారేమా అతిక్రమంకొయిని హుసె.<verse eid="ROM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16"/>ఆ కారణంతీబి యో వాక్ముల్‍నా ఖంయదాన్‍ ఖారవ్నా, కాతొ ధర్మషాస్ర్తం వాలనా మాత్రం కావే అబ్రాహామ్‍నా ఛాతె విష్వాస్‍ఛాతె ఇవ్నా కెడెబి ఘటిన్‍ హోనుకరి, కృపానానుసరించిన్‍ ఛాతిమ్‍, యో విస్వాసను మూలంహుయు యో అప్నహాఃనా భాహుయీన్‍ ఛా. <verse eid="ROM 4:16"/><verse number="17" style="v" sid="ROM 4:17"/>ఇనే విష్వాస్‍ రాక్యొతె దేవ్నా ఖామే, కతొ మరిగుతె వాలన జివ్వాడవాలో, కొయింతే ఇనా ఛాతె తిమ్‍ బొలయోహుయుతె దేవ్నా హఃమే, యో అప్న ఖారనా భాహుయిన్‍ ఛా. అనటేకే తారు గూర్చి ఖారు జనాభోనా భానితరా నియమించోకరి లిఖ్కిరాక్యుస్‍. <verse eid="ROM 4:17"/><verse number="18" style="v" sid="ROM 4:18"/>అబ్రహమ్‍ నమ్మకంతి ర్హైన్‍ కెత్రూకి అద్మియేనా తున ఉండునని తారు సంతానంనా ఇమ్మాస్‍ ర్హాస్‍కరి బొలుయుతె ఇనాబట్టి ఇనాస్‍ జనాబనా భా హువాతిమ్‍, నిరీక్చణనా ఆధారం కొయినితెదె యో నిరీక్చణ కలిగిన్‍ నమ్మెయో. <verse eid="ROM 4:18"/><verse number="19" style="v" sid="ROM 4:19"/>అబ్రహామ్నా బొరాబ్బర్‍ ఖోః వరఖ్‍ వుంబర్‍ ర్హాహియు, అజు యో విష్వాస్‍మా ఖంజొర్‍వాలో కాహే, తెత్రమా ఇను ఆంగ్తాను సారా బెజినినా వామ్జిణితరా హాఃయల్‍ పన్కి. ఇనే విష్వాస్‍మా కంజోర్‍ కోహుయోని. <verse eid="ROM 4:19"/><verse number="20" style="v" sid="ROM 4:20"/>అవిష్వాస్‍నుటేకె దేవ్ను వాక్ముల్‍ను గూర్చి సందేహించక ఇను విష్వాస్‍ ఇనా బలపర్చూ, దేవ్ను మహిమ పరిచి, <verse eid="ROM 4:20"/><verse number="21" style="v" sid="ROM 4:21"/>యో వాక్ముల్‍ దిదొతె ఇనా నెరవేర్చనాటేకె కరిదేఖడావాలోతరా ఖఛ్చితంగా విష్వసించి విష్వాసంటేకె తాఖత్నా పొంద్యె. <verse eid="ROM 4:21"/><verse number="22" style="v" sid="ROM 4:22"/>అనటేకే అబ్రహామ్‍ విష్వాసం మూలమతీ ఇనా నీతితార ఎంచబడ్యొ. <verse eid="ROM 4:22"/><verse number="23" style="v" sid="ROM 4:23"/>యో ఇనా ఎంచబడ్నుకరి ఇనా నిమిత్తం మాత్రంమస్‍ లిఖ్కాయు కాహేపన్కి; <verse eid="ROM 4:23"/><verse number="24" style="v" sid="ROM 4:24"/>అప్నా ప్రభువుహుయుతె యేసునా మరిగొతె కంతు ఉట్యోతె ఇనా విష్వాస్‍ర్హాకిన్‍ లిఖ్కు గయూతిమ్‍ నిమిత్తంటేకె అప్నా ఎంచబడ్యు. <verse eid="ROM 4:24"/><verse number="25" style="v" sid="ROM 4:25"/>యో అప్ను పాప్‍నా నిమిత్తం ధరాయిజైయిన్, అప్నె దేవ్మా నీతి మంతుల్‍ గోని తీర్చబడనాటేకె ఉట్యో.<verse eid="ROM 4:25"/></para>
  <chapter eid="ROM 4"/>
  <chapter number="5" style="c" sid="ROM 5"/>
  <para style="s">దేవ్‍మా నీతిమంతుల్‍నితరా బద్లను</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1"/>అనటేకె విష్వాస్‍ మూలంనా అప్నే నీతిమంతుడ్‍ తార తీర్చబడిన్‍, అప్నా ప్రభువుహుయుతె యేసు క్రీస్తుతిస్‍ దేవ్తి షాంతిసమాధానం కలిగిరాసు. <verse eid="ROM 5:1"/><verse number="2" style="v" sid="ROM 5:2"/>అజు ఇనాబారేమా అప్నా విష్వాస్‍నాటేకె ఆ కృపమా ప్రవేసంహుయు, ఇనమా ఉబ్రిర్హాహిన్‍, దేవ్ను మహిమనా గూర్చినా నిరీక్చణటేకె గౌర పడుకరియేస్‍. <verse eid="ROM 5:2"/><verse number="3" style="v" sid="ROM 5:3"/>ఎత్రెస్‍ కాహే; కష్టంమా అతిషయ పడియేస్‍, అప్నా మాలం పరీక్చా నిరీక్చాణ కల్గాంకరస్‍. <verse eid="ROM 5:3"/><verse number="4" style="v" sid="ROM 5:4"/>మిన్హత్‍ ఓర్పునా, ఓర్పు పరీక్చానా, పరీక్చా నిరీక్చణనా కల్గమ్‍కరస్‍కరి మాలం; స్రమల్‍మా అతిసయపడో. <verse eid="ROM 5:4"/><verse number="5" style="v" sid="ROM 5:5"/>సానటేకె కతొ ఆ నిరీక్చణ అప్నా షెరం కోహువదేయ్‍ని. అప్నా అనుగ్రహించబడొతె పరిసుద్ధాత్మతీస్‍ దేవ్ను ఫ్యార్‍ అప్నా దిల్‍మా కుమ్మరించిన్‍ ఛా.<verse eid="ROM 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6"/>కింకతో అప్న హంకెతో నిరీక్చణ కొయింతే ఇవ్నితరా, క్రీస్తు అప్నాదేవ్‍ భక్తిహీనుల్‍నాటేకె మరిగొ. <verse eid="ROM 5:6"/><verse number="7" style="v" sid="ROM 5:7"/>నీతిమంతుడ్‍నాటేకె సహితం ఏక్జాను మరిగొతొ మాములీస్‍; అష్యల్‍వాలనాటేకె కొన్‍బి ఎక్తార మరిజావనాటేకె తెగించస్‍. <verse eid="ROM 5:7"/><verse number="8" style="v" sid="ROM 5:8"/>హుయుతో దేవ్‍ అప్నబారేమా ఇను ఫ్యార్‍ వెల్లడిపరుచుకురాస్‍; కిమ్‍కాతొ అప్నె హంకెబి పాపేలుహుయిన్‍ ర్హావమా క్రీస్తు అప్నాటేకె మరిగొ. <verse eid="ROM 5:8"/><verse number="9" style="v" sid="ROM 5:9"/>అనటేకే ఇను ల్హొయి హంకె నీతిమంతుడ్‍ తార తీర్చబడిన్‍, అజు నిష్చయంతి ఇనెతీస్ ఖీజ్‍మతూ బఛ్చాయిజాసు. <verse eid="ROM 5:9"/><verse number="10" style="v" sid="ROM 5:10"/>అప్నే వైరిహుయిన్‍‌ థాబి, ఇను ఛియ్యాన మరణ్‍తీస్‍ అప్నే దేవ్తి సమాధానం పరచబడిన్‍ యో జీవం అజు ఖఛ్చింతిస్‍ బఛ్చాయిజాసు. <verse eid="ROM 5:10"/><verse number="11" style="v" sid="ROM 5:11"/>యోస్‍కాహె; అప్ను ప్రభువుహుయుతె యేసు క్రీస్తుతిస్‍ అప్నె దేవ్కనా అతిసయ ఖుషి పడుకరుయేస్‍; ఇనేతిస్‍ అప్నె హంకె సమాధానంను స్థితిని పొందిరాక్యస్‍.<verse eid="ROM 5:11"/></para>
  <para style="s">ఆదామ్‍ బుజు క్రీస్తు</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12"/>అమ్‍ ర్హావమా ఏక్‍ అద్మినుబారేమా పాప్‍బీ పాప్‍ను బారేమా మరణ్‍ ములక్‍మా కిమ్‍ ప్రవేసించుకి, ఇమ్మాస్‍ అద్యియోక్హారనా పాప్‍ కార్యెయోతె మరణ్‍ హాఃరనా దాపరించూ. <verse eid="ROM 5:12"/><verse number="13" style="v" sid="ROM 5:13"/>కింకతొ ధర్మషాస్ర్తం అవకొయిన్‍తె అగాడి పాప్‍ ములక్‍మా ఛా, పన్కి ధర్మషాస్ర్తం కొయింతే వఖాత్‍ పాప్‍ నిరూపించె కోహుయుని. <verse eid="ROM 5:13"/><verse number="14" style="v" sid="ROM 5:14"/>హుయుతోబి ఆదామ్‍ కర్యొతె అతిక్రమంనాజోక్ పాప్‍ కరకొయితె ఇవ్నపర్బి, ఆదామ్‍తూ సురూహుయిన్‍ మోషేతొడి మరణ్‍నా యేల్యూ; ఆదామ్‍ అవ్సెతె ఇనా గుర్తుహుయిన్‍ ఛా. <verse eid="ROM 5:14"/><verse number="15" style="v" sid="ROM 5:15"/>హుయుతో పాప్‍ హుస్‍తిమ్‍ కృప వరమ్‍ కలుగ్యుకొయిని. కింకాతొ ఏక్ను అపరాధంనాటేకె ఘనుజను మరిగ్యొతొ బుజు ఘను దేవ్ను కృపబి, యేసుక్రీస్తు ఏక్‍ అద్మిహుయుతె యేసుక్రీస్తు కృపతి కెత్రుకి జననా ప్హైలాయుగయూ. <verse eid="ROM 5:15"/><verse number="16" style="v" sid="ROM 5:16"/>అజు పాప్‍ కరిన్‍ ఏక్నాటేకె సిక్చావిధి హోనుతిమ్‍ యో ధానమ్‍ హుయుకొయుని. కిమ్‍ కతొ న్యావ్‍ ఏక్‍ అపరాధం మూలంతి ఆయుతె సిక్చావిధి కారణంహుయు; కృపావరంహుయుతె ఘానుహుయుతె అపరాధంను మూలమా అయుతె అద్మియోనా నీతిమంతుడ్‍తార తీర్చబడ్‍సే కారణంహుయు. <verse eid="ROM 5:16"/><verse number="17" style="v" sid="ROM 5:17"/>మరణం ఎక్నా పాప్‍ మూలంతి అయుతె యో ఏక్నతీస్‍ ఏలితొ బారేమ కృపాబాహుల్యంనా నీతి దానంనా పొందవాల జీవం ఛాతె ఇవ్నే, అజు నిష్చయంతి యేసుక్రీస్తు ఏక్నా తీస్‍ పాల్సు.<verse eid="ROM 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18"/>అనటేకే న్యావ్‍ ఏక్‍ పాప్‍నా మూలంతి అయుతె, అద్మియోనా ఖారనా సిక్చావిధి హువానాటేకె కిమ్కి కారణంహుయు, ఇమ్మాస్‍ ఏక్‍ పుణ్య్ కార్యంనాటేకె అద్మియే ఖారనా జీవం ప్రథమ్‍హుయుతె నీతి విధింపబడనటేకె కారణం హుయు. <verse eid="ROM 5:18"/><verse number="19" style="v" sid="ROM 5:19"/>కిమ్కాతొ ఏక్‍ అద్మి అవిధేయతటేకె ఘానుజనణ పాప్‍వాల కిమ్‍ కర్యోకి, ఇమ్మాస్‍ ఏక్ను విధేయతనటేకె ఘానుజను నీతిమంతుడ్‍తరా కార్యంహుయుతె.<verse eid="ROM 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20"/>అజు అపరాధం ఫేలాయుతిమ్‍ ధర్మషాస్ర్తం పేఖిన్‍, హుయుతొబి పాప్‍ కేజ్గా బఢాస్‍కి ఏజ్గాగ దేవ్ను కృప అజు ఘాను బఢాసే. <verse eid="ROM 5:20"/><verse number="21" style="v" sid="ROM 5:21"/>ఇమ్మాస్‍ నిత్యమ్‍జీవం కలుగనాటేకె, నీతి తీస్‍ కృపబి అప్ను ప్రభువుహుయోతె యేసుక్రీస్తు మూలంతి పాలనునిమిత్తం పాప్‍ కెజ్గా ఫైలాయుకి ఎజ్గా కృప ఘాను ఫైలాయు.<verse eid="ROM 5:21"/></para>
  <chapter eid="ROM 5"/>
  <chapter number="6" style="c" sid="ROM 6"/>
  <para style="s">పాప్‍మా మరణ్‍, యేసుక్రీస్తుమా జీవమ్‍</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1"/>ఇంతోబి సాత్‍బోలిస్‍? కృప ప్హైలావునుకరి పాప్‍మా ఉబ్రీన్‍రయ్యానా? <verse eid="ROM 6:1"/><verse number="2" style="v" sid="ROM 6:2"/>ఇంమ్‍ నా బోల్ను. పాప్‍నా విషయంమా మర్‍జైయిన్‍ అప్నె హంకేతునికీన్‍ కింమ్‍ ఇన్నా జీవ్‍సు. <verse eid="ROM 6:2"/><verse number="3" style="v" sid="ROM 6:3"/>క్రీస్తు యేసుమా బాప్తిస్మమ్‍ పొందితె, అప్నే ఖారబి ఇను మరణ్‍మా బాప్తిస్మం పొంద్యాకరి తుమ్నా మాలంకొయిన్‍నా కాహేన? <verse eid="ROM 6:3"/><verse number="4" style="v" sid="ROM 6:4"/>అప్నే బాప్తిస్మమ్‍ బారేమా మరణ్‍మా పాలు పొందనాటేకె కోమ్దీన్‍ గడాయ్‍గయా. అనటేకే భా మహిమనటేకె క్రీస్తు మరణ్‍మతు కిమ్‍ ఉట్యోకి, ఇమ్మాస్‍ అప్నేబి నవూ జీవంమా పొందితెవాలహుయిన్‍ ఛాల్‍తిమ్‍,<verse eid="ROM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5"/>అజు ఇను మరణ్‍న సాద్రుష్యమా ఇనేతి మలిన్‍ ఛాతె ఇవ్నే బారెమ, యో జీవిన్‍ ఉట్టమా సాద్రుస్యంమా ఇనేతె మలిన్‍ వాలహుయిన్‍ ర్హాసు. <verse eid="ROM 6:5"/><verse number="6" style="v" sid="ROM 6:6"/>సాత్కతొ అప్నె హంకేబి పాప్నా దాసుల్‍ నాహోనుతిమ్‍ పాప్ను ఆంగ్తన్నా ర్హావకొయినితిమ్‍ గతించుగయూతె, అప్ను జూను స్వభావంనా ఇనాకెడె సిలువ నాక్యుకరి మాలం. <verse eid="ROM 6:6"/><verse number="7" style="v" sid="ROM 6:7"/>మరిగొతె యోఅద్మి పాప్‍మతూ బఛ్చీన్‍ విడుదలా పొందిరాక్యుస్‍. <verse eid="ROM 6:7"/><verse number="8" style="v" sid="ROM 6:8"/>అప్నె క్రీస్తునాకెడె మరిగుతొ, ఇనాకెడే జీవ్సు ర్హాసుకరి నమ్ముకురుస్‍. <verse eid="ROM 6:8"/><verse number="9" style="v" sid="ROM 6:9"/>హామ్న మాలం క్రీస్తు మారణ్‍ మాతు జివుట్యో, క్రీస్తు అజు మర్సేకొయినికరి, మరణ్‍ ఇనాపార్‍ అధికారమ్‍ కర్సెకొయిని. <verse eid="ROM 6:9"/><verse number="10" style="v" sid="ROM 6:10"/>కిమ్‍కతొ యో మరణ్‍ దేఖ్యతొ, పాప్‍ను విషయంహుయ్తొ, ఎక్కాస్‍త్తార మరిగొ పన్కి యో జీవ్ను దేఖ్యతొ, దేవ్ను విషయంహుయిన్‍ జిమ్కరాస్‍ <verse eid="ROM 6:10"/><verse number="11" style="v" sid="ROM 6:11"/>ఇంనితార తుమేబి పాప్‍నా విషయంహుయిన్‍ మరణ్‍నితార ఛా, దేవ్ను విషయంహుయిన్‍ క్రీస్తుయేసుమా జీవ్నుజివం తార తుమ్నా తుమేస్‍ ఎంచిలెవొ.<verse eid="ROM 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12"/>అనహాఃజె ఆంగ్‍తాను దురాషనా లోబడుతిమ్‍ మరణ్‍నా లోనుహుయుతొ తుమరు ఆంగ్‍తాన్‍మా పాప్‍నా ఏల నొకొదెవొ. <verse eid="ROM 6:12"/><verse number="13" style="v" sid="ROM 6:13"/>అజు తుమరు అవయవమునా క్హారబ్‍ సాధనంనీతరా పాప్‍నా ద్హరాయి నొకొలెవొ, హుయుతొ మరణ్‍మతూ జీవ్తావాలకరి, తుమ్నా తుమేస్‍ దేవ్నా ద్హారయిలెవొ, తుమరు అవయవమునా నీతిసాధనంగా దేవ్నా ద్హారయిలెవొ. <verse eid="ROM 6:13"/><verse number="14" style="v" sid="ROM 6:14"/>తుమే దేవ్ను కృపనాస్‍ పన్కి ధర్మషాస్ర్తంనా లోబడహుయుతె ఇవ్నె కాహే, పన్కి పాప్‍నా తుమరఫర్‍ అధికారం కార్సేకొయినీ.<verse eid="ROM 6:14"/></para>
  <para style="s">నీతినా దాసుల్‍</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15"/>ఇమ్‍ హుయుతొబి కృపనాస్ పన్కి ధర్మషాస్ర్తంనా లోనుహువాల కాహెకరి పాప్‍నా కరియేనా? ఇమ్‍ కాహెస్‍ కాహే. <verse eid="ROM 6:15"/><verse number="16" style="v" sid="ROM 6:16"/>లొంగనాటేకె దేవ్నా తుమారు తుమేస్‍ దాసుడ్‍తార ద్హారయిలిసూకి, యో మరణ్‍ను నిమిత్తంతార పాప్‍నాస్‍ పన్కి, నీతి నిమిత్తంతరా విధేయతనాస్‍ పన్కి, కినా తుమే లోబడ్సుకి ఇనాస్‍ దాసుడ్‍హుసుకరి తుమ్న మాలంకొయినా? <verse eid="ROM 6:16"/><verse number="17" style="v" sid="ROM 6:17"/>దేవ్నా ధన్యవాద్‍ కరుకురుస్‍ తుమే పాప్నా దాసుడ్‍హుయిన్‍ ర్హయ్యా పన్కి కేవు ఉపదేషక్రమంనా తుమే అప్పగిమ్చలిదాకి, ఇనా దిల్‍నుపూర్వకంతి లోబడిన్‍ర్హావొ, <verse eid="ROM 6:17"/><verse number="18" style="v" sid="ROM 6:18"/>పాప్‍మాతు ఛూట్కార్‍హుయిన్‍ నీతినా దాసులైహుయ అనటేకే దేవ్నా స్తోత్రం. <verse eid="ROM 6:18"/><verse number="19" style="v" sid="ROM 6:19"/>తుమే ఆంగ్తాను ఖంజొర్‍టేకె మే అద్మితార వాత్‍బొలుకురాస్‍ కింకాతొ అతిక్రమంనా కారనాటేకె, అపవిత్రతనా బుజు పాప్న అక్రమంనా తుమరు అవయవంనా నీతినాలిన్‍ పరిషుద్ధఆత్మ ఛాలవ్వానటెకే దాసుడ్‍తార అప్పగించిలెవొ.<verse eid="ROM 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20"/>తుమే పాప్నా దాసుడ్‍హుయిన్‍ ర్హాయితెదె నీతినువిషయమం ఆడుకొయింతె వాలహుయీన్‍ రయ్యా. <verse eid="ROM 6:20"/><verse number="21" style="v" sid="ROM 6:21"/>తెదెను క్రియల్నాటేకె తుమ్నా సాత్బి ఫలం హుయుకి? ఇనాగురించి తుమే హంకే షరంలెంకరస్‍ కాహేనా? ఇనా అంతమ్‍ మరణ్ నా ఫలితం, <verse eid="ROM 6:21"/><verse number="22" style="v" sid="ROM 6:22"/>అజుబి హంకేబి పాప్‍మతు విమోచింపబడీన్‍ దేవ్నా దాసుడ్‍హుయతిమ్‍ పరిసుద్ధత హువతిమ్‍ తుమ్నా ఫలం ఇను అఖరిను ఫలితం నిత్యమ్‍జీవం. <verse eid="ROM 6:22"/><verse number="23" style="v" sid="ROM 6:23"/>కింకతొ పాప్నాటేకె అవ్సేతె జీతం మరణ్‍, హుయుతొ దేవ్ను కృపవరమ్ అప్ను ప్రభువుహుయుతె క్రీస్తుయేసుమా నిత్యమ్‍జీవం.<verse eid="ROM 6:23"/></para>
  <chapter eid="ROM 6"/>
  <chapter number="7" style="c" sid="ROM 7"/>
  <para style="s">య్హాను బారెమా బోలను</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1"/>భ్యేనే భైయే, అద్యియో జీవిన్ ర్హావతొడి ధర్మషాస్ర్తం ఇనాఫర్‍ హాఃర్కార్‍ కరూకరస్నాకరి తుమ్న మాలంకొయిన్నా? ధర్మషాస్ర్తంనా మాలంహుయుతె తుమారేతి వాత్‍బోలుకురూస్‍. <verse eid="ROM 7:1"/><verse number="2" style="v" sid="ROM 7:2"/>బావ్రిఛాతె బాయికొ, బావ్రి జీవిన్‍ర్హావతొడి ధర్మషాస్ర్తంనటేకె ఇన బద్ధురాల్‍ పన్కి, బావ్రి మరిగొతొ బారేమ బావ్రి విషయంహుయిన్‍ ధర్మషాస్ర్తం మాతు యో ఛుట్కా పొంది. <verse eid="ROM 7:2"/><verse number="3" style="v" sid="ROM 7:3"/>అనటేకే బావ్రి జీవిరాహితొ యో అజెక్‍ అద్మితి జాయితొ వ్యభిచారికరి బోల్సె పన్కి, బావ్రి మరిగొతో యో ధర్మషాస్ర్తంన కంతు విడుదల పొందిన్‍ పన్కి అజేక్‍ అద్మినా య్హా కార్లిదితొ వ్యభిచారిని వుసెకొయిని. <verse eid="ROM 7:3"/><verse number="4" style="v" sid="ROM 7:4"/>మార భ్యేనే భైయే, అప్నే దేవ్నాటేకె ఫలం ఫలించెతిమ్‍ మరణ్‍ కంతు ఉట్యోతె క్రీస్తు కరి అలాదనా చేరనాటేకె తుమేబి ఇను ఆంగ్తాన్‍తిస్‍ ధర్మషాస్ర్తం విషయంహుయున్‍ మరిగా. <verse eid="ROM 7:4"/><verse number="5" style="v" sid="ROM 7:5"/>కింకాతొ అప్నే ఆంగ్తాను సంధంహుయిన్‍ ర్హాయతేదె మరణ్‍ సంబంధంహుయితె ఫలంనా ఫలింనటేకె, ధర్మషాస్ర్తంనటేకె పాప్ను ఆఖ్‍ఃతి అప్ను అవయంతి కామ్‍ కార్తురహియు. <verse eid="ROM 7:5"/><verse number="6" style="v" sid="ROM 7:6"/>హంకెహుయుతో దేవ్తి నిర్బంధింబడిహుయుతె ఇను విషయంహుయిన్‍ మరిగాతె అప్నే, ధర్మషాస్ర్తం కంతు ఛుట్కార పొంద్యా పన్కి అప్నె అక్చర్‍నా సారంహుయుతె జూనుస్థితివాలా కాహె ఆత్మనుసారంతి నౌవుస్థితి వాలాహుయిన్‍ సేవా కరుకరియేస్‍.<verse eid="ROM 7:6"/></para>
  <para style="s">ధర్మషాస్ర్తం అజు పాప్‍</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7"/>అనటేకే సాత్‍బొల్ను? ధర్మషాస్ర్తం పాప్నా? ఇంనాబొల్ను. ధర్మషాస్ర్తంనటేకె పన్కి పాప్‍కాతొ సాత్కి మన మలంకొయిని. ఆఖ్‍ఃకరోనోకొకరి ధర్మషాస్ర్తం బొలుతెబారెమ దురాసనా కెద్దెనుకి మన మలంకోయిని. <verse eid="ROM 7:7"/><verse number="8" style="v" sid="ROM 7:8"/>హుయుతొ పాప్‍ ఆజ్ఞాననా కర్లీన్‍హాఃరు విధంహుయుతె దురాసనా మారమా పుట్టించొ. ధర్మషాస్ర్తం కొయింతే వహఃత్‍ పాప్‍ మరిగు. <verse eid="ROM 7:8"/><verse number="9" style="v" sid="ROM 7:9"/>ఏక్తార మే ధర్మషాస్ర్తం కొయిన్‍తిమ్ జీవించుకరథో పన్కి, ఆజ్ఞ ఆయుతెదే పాప్నా ఆజు జీవ్ను ఆయు; మేహుయుతొ మరిగో. <verse eid="ROM 7:9"/><verse number="10" style="v" sid="ROM 7:10"/>తెదే జీవార్థంహుయుతె ఆజ్ఞనా మన మర్జాంతరా దెహాఃయు. <verse eid="ROM 7:10"/><verse number="11" style="v" sid="ROM 7:11"/>కింకాతొ పాప్‍ ఆజ్ఞనా హేతువుకరిన్‍ మన దోహాఃకరిన్‍ ఇనేతి మన మరదిదొ.<verse eid="ROM 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12"/>అనటేకే ధర్మషాస్ర్తంమా పరిసుద్ధ హుయుతె, ఆజ్ఞకెడె పరిసుద్ధడ్‍హుయుతె నీతిమంతుడ్‍హుయుతె ఉత్తమంహుయిన్‍ఛా. <verse eid="ROM 7:12"/><verse number="13" style="v" sid="ROM 7:13"/>ఉత్తమంహుయుతె మన మరణ్‍నా హుయునా? ఇమ్‍ నాబొల్ను. హుయుతొ పాప్‍ ఉత్తమంహుయుతె ఇనా మూలంతి మన మరణంనా కరావ్తూ, పాప్‍ పాప్‍హుయుతిమ్‍ ద్యెక్హావతిమ్‍ నిమిత్తం, కాతొ పాప్‍ ఆజ్ఞమూలంతి గ్హను పాప్‍హుయుతె నిమిత్తం, యో మన మరణ్‍కరంహుయు.<verse eid="ROM 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14"/>ధర్మషాస్ర్తం ఆత్మ సంబంధహుయుతె మాలం; హుయుతె మే పాప్‍నా ఎచ్చాయ్‍జైయిన్‍ ఆంగ్తాను సంబంధహుయిన్‍ ఛా. <verse eid="ROM 7:14"/><verse number="15" style="v" sid="ROM 7:15"/>కింకతొ మే కారొయోతె మే మాలంకోకర్యోని; మే కరుతె నిచ్ఛయించుతె కార్యొకొయినితిమ్‍ ద్యేషించుకారుతె కరూకురుస్‍. <verse eid="ROM 7:15"/><verse number="16" style="v" sid="ROM 7:16"/>ఇచ్ఛయింపుతె మే కార్యాతెబారెమ ధర్మషాస్ర్తం అషల్‍కరి ఒప్పుకురుస్‍. <verse eid="ROM 7:16"/><verse number="17" style="v" sid="ROM 7:17"/>అనటేకే హంకెతు ఇన కరూకరతె మేకాహె మారకనా జింకరతే పాపస్‍ పన్కి మే కాహె. <verse eid="ROM 7:17"/><verse number="18" style="v" sid="ROM 7:18"/>మరకాన, కాతొ మరు ఆంగ్‍తాన్‍మ అష్యల్ కేవుకి నివసించెకొయినికరి పాప స్వభావం మనమలం. పన్కి అష్యల్ కర్నూకరి ఆఖ్‍ః మన హుకొరాస్ పన్కి, ఇనా కరనటేకె మన హుకొరకొయిని. <verse eid="ROM 7:18"/><verse number="19" style="v" sid="ROM 7:19"/>మే కర్నూకరి మేలు కరకొయిన్తిమ్‍ కరీస్‍కొయిని నాకర్నూతే యో కీడు కరూకురూస్‍. <verse eid="ROM 7:19"/><verse number="20" style="v" sid="ROM 7:20"/>మే కొర్యొకోయిన్తే ఇనా కార్యోతొ, ఇనా కార్యెతె మరకాన నివసించితె పాప్‍మస్‍ పన్కి హంకెబి మే కాహె.<verse eid="ROM 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21"/>అంనితార మన ఏక్‍ ధర్మషాస్ర్తం నియమమ్‍ మాలంహుయు. యోసాత్‍ కాతొ అషల్ కర్‍నుకరి ఇష్టంహుయుతె ఎజ్గా పాప్‍ ఛా. <verse eid="ROM 7:21"/><verse number="22" style="v" sid="ROM 7:22"/>మారు దిల్‍ దేవ్నా ధర్మషాస్ర్తంమా మే ఖుషితిఛావ్‍ <verse eid="ROM 7:22"/><verse number="23" style="v" sid="ROM 7:23"/>అజేక్‍ నియమం మారు అవయవల్‍తి ఛాతె మన ద్యెఖాకురాస్. యో మారు దిల్మా ధర్మషాస్ర్తంతి లడ్డాయికరిన్‍ మారు అవయనల్‍మాఛాతె పాప్‍నునియమంనా మన లోబరొచుకురుస్‍. <verse eid="ROM 7:23"/><verse number="24" style="v" sid="ROM 7:24"/>అయ్యో, మేఎత్రెస్‍ బేకార్‍? అద్దాను మరణ్‍నా లోనుహువతిమ్‍ ఆంగ్తాన్‍కంతు మన చుఖాయో? <verse eid="ROM 7:24"/><verse number="25" style="v" sid="ROM 7:25"/>అప్నొ ప్రభువుహుయుతె యేసు క్రీస్తుతిస్‍ దేవ్నా ధన్యవాద్‍ బోలుకురుస్‍, హువమా దిల్‍ను విషయంమా మే దేవ్ను ధర్మషాస్ర్తంను, ఆంగ్తాను విషయంమా పాప్నా దాసుడుహుయిరొస్‍.<verse eid="ROM 7:25"/></para>
  <chapter eid="ROM 7"/>
  <chapter number="8" style="c" sid="ROM 8"/>
  <para style="s">ఆత్మామా జీవమ్‍</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1"/>అనటేకె హంకె క్రీస్తుయేసుమఛాతే ఇవ్నా కెవు సిక్చవిధిబీ కొయిని. <verse eid="ROM 8:1"/><verse number="2" style="v" sid="ROM 8:2"/>క్రీస్తుయేసుమా జీవందేస్తె ఆత్మను నియమంన పాప్‍ అజు మరణ్‍ నియమం కంతు మన చుక్కాయు. <verse eid="ROM 8:2"/><verse number="3" style="v" sid="ROM 8:3"/>ఆంగ్తాన్‍నా అనుసరించకొయిని‍తిమ్‍ ఆత్మను అనుసరించినాస్‍ ఛాల్ను అప్నాకన ధర్మషాస్ర్తం సంబంధహుయుతె నీతివిధి నెరవేర్చచును కరి పాప్‍ను పరిహారంనిమిత్తం. <verse eid="ROM 8:3"/><verse number="4" style="v" sid="ROM 8:4"/>దేవ్‍ ఇనో ఛియ్యోను పాప్‍మా ఆంగ్తానుసారంతి బొలిమొక్లీన్, యో ఆంగ్‍తాన్‍మా పాప్‍ను సిక్చనా విధించు. <verse eid="ROM 8:4"/><verse number="5" style="v" sid="ROM 8:5"/>ఆంగ్తానుసారులు ఆంగ్తాన్ను విషయంపర్‍ దిల్‍రాక్సు; ఆత్మను సంబందహుయుతె ఆత్మను విషయంపార్‍ దిల్‍కారక్సు; ఆంగ్‍తాను సారంహుయుతె దిల్నా మరణ్‍; <verse eid="ROM 8:5"/><verse number="6" style="v" sid="ROM 8:6"/>ఆత్మాను సారంహుయుతె దిల్‍ జీవంనబి షాంతి సమాధానంహుయిన్‍ ఛా. <verse eid="ROM 8:6"/><verse number="7" style="v" sid="ROM 8:7"/>కింకాతొ ఆంగ్తాను సారంహుయుతె దిల్‍ దేవ్నా విరొధంహుయిన్‍ ఛా; యో దేవ్ను ధర్మషాస్ర్తం లోబడ్సెకొయిని, ఏమాత్రంబి లోబడ్సేకొయిని. <verse eid="ROM 8:7"/><verse number="8" style="v" sid="ROM 8:8"/>ఆంగ్తాను స్వభావంతి ఛాతె ఇవ్నే దేవ్నా ఖుషీ కరకొయిని.<verse eid="ROM 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9"/>దేవ్ను ఆత్మ తుమరమ నివసించిరాహితొ బరెమ తుమే ఆత్మను స్వభావంతి ఛాతె ఇవ్నే పాన్కి ఆంగ్తాను స్వభావం ఛాతె ఇవ్నేకాహె. కొన్బి క్రీస్తు ఆత్మ కొయితె ఇవ్నే యో ఇనువాలో కాహె. <verse eid="ROM 8:9"/><verse number="10" style="v" sid="ROM 8:10"/>క్రీస్తు తూమరమ ర్హహితొ తుమారు ఆంగ్తాన్‍ పాప్‍ను విషయంహుయిన్‍ మరిగయో పన్కి తుమారు నీతి విషయంహుయుతె జీవం కల్గిన్‍ ఛా. <verse eid="ROM 8:10"/><verse number="11" style="v" sid="ROM 8:11"/>మరణ్‍మతూ కంతు యేసునా ఉట్యోతె ఇన ఆత్మ తుమారమ నివసించిన బారెమ, మరిగొతె కంతు క్రీస్తుయేసునా ఉట్యోతె మరనాటేకెలొను హుయుతె తుమారు ఆంగ్‍తాన్‍న కెడె తుమారమ నివసించుకురతె ఇను అత్మతిస్‍ జీవడ్సే.<verse eid="ROM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12"/>అనటేకే భేనే భైయెనా, అప్నె ఇమ్‍ జీవనా కర్తవయం ఉన్నది. ఆంగ్తాను సారంతి ఛాల్‍నటేకె ఆప్నెఆంగ్తనా ‍రుణపడిన్‍ కోచయ్యెని. <verse eid="ROM 8:12"/><verse number="13" style="v" sid="ROM 8:13"/>తుమే ఆంగ్తానుసారంహుతె ఛాలితొబరెమ మరనుతు ఇవ్నే ర్హాసు పాన్కి, ఆత్మతి ఆంగ్‍తాను క్రియల్తి మరఖిదిదుతోబి జీవ్సు. <verse eid="ROM 8:13"/><verse number="14" style="v" sid="ROM 8:14"/>దేవ్ను ఆత్మతి కెత్రుకి ఛాలయాహుయో ఇవ్నె హాఃరు దేవ్ను ఛియ్యోహుయు రాసు. <verse eid="ROM 8:14"/><verse number="15" style="v" sid="ROM 8:15"/>కింకతొ అజు ఢరనాటేకె తుమే దాస్యపు ఆత్మన పొందకొయిని పన్కి దత్త ఛియ్యోను ఆత్మనా పొంద్యొ యో ఆత్మ కలిగితె ఇవ్నే అప్నె అబ్బా భా కరి ప్రార్థనా కరూకరుయేస్‍ <verse eid="ROM 8:15"/><verse number="16" style="v" sid="ROM 8:16"/>అప్నె దేవ్‍ లడ్కాకరి ఆత్మ ఇనూయోస్‍ అప్ను ఆత్మతి కెడె సాక్చ్యం దెమ్కరాస్. <verse eid="ROM 8:16"/><verse number="17" style="v" sid="ROM 8:17"/>అప్నె లడ్డాకహుయుతొ వారసులం, కాతొ దేవ్ను వారసులం; క్రీస్తున కెడె మహిమ పొంనాటేకె యో స్రమపాడితె బరెమ, క్రీస్తునాకెడె వారసులం.<verse eid="ROM 8:17"/></para>
  <para style="s">ఆవ్సేతె మహిమా</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18"/>అప్నుబరెమ ప్రత్యక్చం వుసెతె మహిమనా ఖామే హంకెను వఖాత్మ స్రమల్‍ కోర్లీదుతే కాహెకరి ఎంచుకురుస్‍. <verse eid="ROM 8:18"/><verse number="19" style="v" sid="ROM 8:19"/>దేవ్ను ఛియ్యో ప్రత్యక్చతంటేకె సృష్టి గ్హాను ఆహ్ః తి దేక్తూ ర్హంకరస్‍. <verse eid="ROM 8:19"/><verse number="20" style="v" sid="ROM 8:20"/>కింకతొ సృష్టి, నాసనంనా లోనుహుయుతె దాస్యంన కంతు చొడాయిన్‍, దేవ్ను లడ్కా పొంద్సే‍తె మహిమను స్వాతంత్ర్యంనా పొందీస్కరి నిరీక్చణహుయీవ్‍, <verse eid="ROM 8:20"/><verse number="21" style="v" sid="ROM 8:21"/>స్వేచ్ఛతిమ్‍ కాహె ఇనా లోపర్‍చుతెవాలనా మూలంతి పాల్తుహుయ్రూస్. యో <verse eid="ROM 8:21"/><verse number="22" style="v" sid="ROM 8:22"/>హమ్నా ఆ మాలం సాత్కాతో, సృష్ట హాఃరు హంకెతొడి ఏక్‍హుయిన్ టుమ్తూ జనాను ధర్రాద్‍ పడుకరస్‍కరి అప్నామాలం. <verse eid="ROM 8:22"/><verse number="23" style="v" sid="ROM 8:23"/>యోస్కాహేతిం, ఆత్మను ప్రథమ ఫల్నా అగాడిను ఫలంన పోందతె అప్నెబి దత్త ఛియ్యోనటేకె, కతొ అప్ను ఆంగ్తాన్ను విమోచనమ్నటేకె మాలంకరిన్‍ అప్నమా అప్నే టుముకురస్‍ <verse eid="ROM 8:23"/><verse number="24" style="v" sid="ROM 8:24"/>కిమ్‍కతొ అప్నే ఆఖ్ తి కల్గతె వాలహుయీన్‍ బఛ్చాయిగా. నిరీక్చింప బడ్యుతె దెఖాయుతెదె, ఆఖ్‍ తి కామ్‍కోర్హాయిని; ఇనే దేకుకరతే ఇనాటేకె కోన్‍ ఆఖ్‍ తి ర్హాను? <verse eid="ROM 8:24"/><verse number="25" style="v" sid="ROM 8:25"/>అప్నే ద్యెకాకొయితెటేకె ఆఖ్‍ తి బరెమ ఓపికతి ఇనటేకె మాలంకార్‍సు. <verse eid="ROM 8:25"/><verse number="26" style="v" sid="ROM 8:26"/>ఇంనితరా పవిత్రఆత్మబి అప్ను కంజోర్న దేఖీన్‍ సహాయం కరూకురస్‍. కింకతొ అప్నె అష్యల్‍తి కిమ్‍కర్నుకి ప్రార్థన కార్‍నుకరి అప్న మలంకొయిని పాన్కి, వాత్‍ బొలనాహువ కొయిన్‍తె క్హాదరిన్‍ యో ఆత్మనాస్‍ అప్నె బణెతి విజ్ఞాపనమ్‍ కరుకురస్‍. <verse eid="ROM 8:26"/><verse number="27" style="v" sid="ROM 8:27"/>అజు దిల్మ పరిసోధించొవాలొ ఆత్మనుబి దిల్‍ను సాత్‍కి మాలం; కింకతొ ఇన దేవ్ను చిత్తప్రకారం పరిసుద్ధనటేకె విజ్ఞాపనం కరూకరస్‍.<verse eid="ROM 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28"/>హామ్నా మాలం. దేవ్న ఫ్యార్‍కరవాల, కాతొ ఇను సంకల్పం చొప్పున బులైయతె ఇవ్నే, అష్యల్ హువనటేకె ఖారున సమకుడిన్‍ హుకొరస్‍కరి మాలం, <verse eid="ROM 8:28"/><verse number="29" style="v" sid="ROM 8:29"/>సానటేకెకాతొ ఇను ఛియ్యోబి ఖారతి భైయెతి భేనేబి, జ్యెష్ఠడుహువతిమ్‍, దేవ్‍ కినా అగాడి మాలంకర్యకి, ఇవ్నే ఇనా ఛియ్యానితరా పోలీన్ రూపం‍ హువనాటేకె ఇవ్నే అగాడి నిర్ణయించో. <verse eid="ROM 8:29"/><verse number="30" style="v" sid="ROM 8:30"/>అజు కినా అగాఢి నిర్ణయించాకి ఇవ్నే బొల్య; కినా బొలయోకి ఇవ్నే నీతిమంతుల్‍తార కర్యాయో; కినా నీతిమంతుడ్‍ తార కర్యయోకి ఇవ్నే మహిమపరిచ.<verse eid="ROM 8:30"/></para>
  <para style="s">యేసుక్రీస్తుమా దేవ్ను ఫ్యార్‍</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31"/>ఇమ్‍ ర్హహితొ సాత్‍బొల్సు? దేవ్‍ అప్న బ్హనె ర్హహితొ అప్న విరోదంకొన్‍? <verse eid="ROM 8:31"/><verse number="32" style="v" sid="ROM 8:32"/>అజు ఇనో ఛియ్యాన దానంకరనాబి పిటె హట్యోకొయిని తిమ్‍ అప్న క్హారనటేకె ఇనా అప్పగించ్యొతె యో ఇనకేడె సమస్తంనా అప్న సానటేకె అనుగ్రహించ బడ్యుసేకోయిన్నా? <verse eid="ROM 8:32"/><verse number="33" style="v" sid="ROM 8:33"/>దేవ్తి ఏర్పచిరాక్యొతె ఇవ్నా ఫర్‍ నేరం నాక్యుతె యోకోన్‍? నీతి మంతుల్‍తరా హాఃరవాలొ దేవుస్‍; <verse eid="ROM 8:33"/><verse number="34" style="v" sid="ROM 8:34"/>సిక్చ విధించొవాలొ కోన్‍? మరిగొతె క్రీస్తు యేసుతూస్‍; యోస్‍ కాహె, మరణ్‍మతు ఉట్యోతె దేవ్ను ఖావాత్‍బణె ఛాతేయో అప్నాటేకె విజ్ఞాపతినంబి కరవాలోబీ యోస్‍. <verse eid="ROM 8:34"/><verse number="35" style="v" sid="ROM 8:35"/>క్రీస్తు ఫ్యార్‍ కంతు అప్నా దూర్‍ కారవాలొ యోకోన్‍? స్రమహుయుతొబి, బాధహుయుతొబి, హింసహుయుతొబి, ఖ్హాల్‍హుయుతొబి, లుంగ్డా క్హరాబ్‍ హుయూతోబి, ఉపద్రవంహుయుతొబి, తాల్వార్‍హుయుతోబి, అప్న దూర్‍కర్సేనా? <note caller="+" style="f"><char style="fr" closed="false">8:35 </char><char style="ft" closed="false">కిర్తనాలు; </char></note> <verse eid="ROM 8:35"/><verse number="36" style="v" sid="ROM 8:36"/>అనా గూర్చి లిక్యురాక్యుతె సాత్‍ కతొ తునా బట్టి ధిన్‍భరీన్‍ హమే కత్రాయావాలహుయ్రాస్‍ ఓత్రనా తయాయ్‍హుయుతె మ్హేంఢా కరి హమే ఎంచబడతేవాల. <verse eid="ROM 8:36"/><verse number="37" style="v" sid="ROM 8:37"/>హుయ్‍తోబి ఆ ఖారివాతేమా అప్నా ఫ్యార్‍కర్యతొయో ఇనా బారెమా అప్నె ఆ ఖారమా జాఖాత్‍ విజాయం పోందిరాక్యస్‍. <verse eid="ROM 8:37"/><verse number="38" style="v" sid="ROM 8:38"/>కిమ్‍కతో మరణ్‍హుయుతొబి జీవంహుయుతొబి దేవ్నుదూతహుయుతొబి ప్రధానుహుయుతొబి ఛాతెహుయుతొబి అవ్సెతెహుయుతొబి ఏలవాలొహుయుతొబి షక్తుల్‍ హుయుతొబి ఊచుహుయుతొబి ఘదర్‍హుయుతొబి సృష్టింపబడుతె బుజు కెవూబి, <verse eid="ROM 8:38"/><verse number="39" style="v" sid="ROM 8:39"/>అప్ను ప్రభువుహుయుతె క్రీస్తుయేసుమా దేవ్ను ఫ్యార్‍కంతు అప్నా దూర్‍ కర్సేకొయినీకరి ఖఛ్చితంతీ నమ్ముకురూస్‍.<verse eid="ROM 8:39"/></para>
  <chapter eid="ROM 8"/>
  <chapter number="9" style="c" sid="ROM 9"/>
  <para style="s">దేవ్‍ బులాయోతే</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1"/>మన ఘను దుఃఖం, మారు దిల్మా తీరకొయిన్‍తె వేదననా‌ ఛా. <verse eid="ROM 9:1"/><verse number="2" style="v" sid="ROM 9:2"/>క్రీస్తుకన ఖాచ్ఛిస్‍ బొలుకురుస్‍, జుట్టివాత్‍ కొయిన్‍. <verse eid="ROM 9:2"/><verse number="3" style="v" sid="ROM 9:3"/>పరిసుద్ధాత్మమ మారు దిల్‍సాక్చిన మారకెడె సాబుత్‍ దెమ్కొరతె. సాధ్యహుయుతొ బారెమ, ఆంగ్తాన్ సంబంది హుయుతె మారు భైయ్యేనాటేకె మే క్రీస్తుకంతు దూర్‍హుయీన్‍ షాపగ్రస్తుడ్‍ హువానటేకె కోర్లిస్‍. <verse eid="ROM 9:3"/><verse number="4" style="v" sid="ROM 9:4"/>అవ్నేఇస్రాయేల్‍ను; దత్తపుత్రత్వంన మహిమనబి నిబంధనల్‍నా ధర్మషాస్త్రం ప్రధానంహుయుతె ఆచారాలువాలన వాగ్దానంనా అవ్ను. <verse eid="ROM 9:4"/><verse number="5" style="v" sid="ROM 9:5"/>భానొభా అవ్నెవాల; ఆంగ్తానుబట్టి క్రీస్తుఅవ్నమా ఫైదాహుయో. యో సర్వాధికారిహుయు దేవ్‍హుయిన్‍ కెదేబి స్తొత్రార్హుడు హుటిన్‍‌ ఛా. ఆమేన్‍.<verse eid="ROM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6"/>హుయుతొ దేవ్నువాత్‍ తప్పి జావంతరా కాహె; ఇష్రాయేల్‍ సంబంది ఖారుబి ఇష్రాయేలీయుల్‍ కాహె. <verse eid="ROM 9:6"/><verse number="7" style="v" sid="ROM 9:7"/>అబ్రాహామ్ను సంతానహుయుతె మాత్రంతి ఖారనబి లడ్డాకకాహె పన్కి “ఇస్సాక్‍టేకెహుయుతె తారు సంతానం కారిబొల్య” <verse eid="ROM 9:7"/><verse number="8" style="v" sid="ROM 9:8"/>కతొ ఆంగ్తాను సంబంది హుయుతె లడ్కాన దేవ్ను లడ్కాకాహే పన్కి వాక్ముల్‍నా సంబంది హుయుతె లడ్కా సంతానంకరి ఎంచబడ్‍సె. <verse eid="ROM 9:8"/><verse number="9" style="v" sid="ROM 9:9"/>వాక్ముల్‍ రూపహుయుతె వాక్యంమస్‍ హాంకెతొ ఆ వఖాత్‍న అవ్సే; తెదె సారాన ఛియ్యో కాలగ్‍సే.<verse eid="ROM 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10"/>యోస్‍కాహె; రిబ్కా అప్ను భాహుయుతె ఇస్సాక్‍నా కరి ఏక్‍నాటేకె బేజినిహుయుతెదె, <verse eid="ROM 9:10"/><verse number="11" style="v" sid="ROM 9:11"/>ఏర్పాట్‍న అనుసరించుతె దేవ్ను సంకల్పం, కరతే అష్యల్ అజు ఖరాబ్‍ను కామ్ను మూలంతి కాహే బొలవాలొనా మూలొతిమ్‍ నిలకడతి ఛాతె నిమిత్తం, <verse eid="ROM 9:11"/><verse number="12" style="v" sid="ROM 9:12"/>లడ్క అజుబి పెద్దాయిన్‍ అష్యల్‍బి ఖారబ్‍బి కారకొయిన్‍తిమ్‍ అగాడి మొట్టొన నానాన దాసుడుహుస్‍ కరి ఇనేతి బొల్యా. <verse eid="ROM 9:12"/><verse number="13" style="v" sid="ROM 9:13"/>అనగూర్చి మే యాకోబ్‍న ఫ్యార్‍కార్‍యో, ఏసావున ద్యేషించిన్‍ కరి లిఖురాక్యుస్‍ ఛా.<verse eid="ROM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14"/>అనటేకే సాత్‍బొల్‍సుకి? దేవ్ కాన అన్యాయం ఛానా? హుసే కొయినీ. <verse eid="ROM 9:14"/><verse number="15" style="v" sid="ROM 9:15"/>అనటేకే దేవ్ మోషేతి అమ్‍బొల్‍యో “మే కినాకి గోర్‍ ఇనాబి గోర్‍కరీన్‍; కినాబారెమబి గోర్‍తి ద్యెకిస్‍కి ఇనాబారెమ గోర్‍తి ద్యెకిస్‍.” <verse eid="ROM 9:15"/><verse number="16" style="v" sid="ROM 9:16"/>కాహే పొందుగొర్‍సెతె వాలొటేకెహుయుతె, ప్రయాసపాడ్‍తె ఇనటేకెహుయుతె కాహే పన్కి, గోర్‍ వోతలను దేవ్ను వల్లె హుస్‍.<verse eid="ROM 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 9:17"/>అజు లేఖనం ఫరోతి అమ్‍ బొల్‍యో మే తారకనా మారు తాఖాత్‍ ద్యెఖాడనటేకె, మారు నామ్‍ ధర్తిఖారనా ప్రచురంహువాతిమ్‍, అనునిమిత్తంమస్‍ తూన నియమించొ. <verse eid="ROM 9:17"/><verse number="18" style="v" sid="ROM 9:18"/>పన్కి యో కినాకి గోర్‍ కార్‍సెకి ఇనా గోర్‍ కరిస్‍; కినా కఠనాపార్‍చునికి ఇనా కఠనా పార్‍చును.<verse eid="ROM 9:18"/></para>
  <para style="s">దేవ్ను కృప అజు ఖీజ్‍</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19"/>అమ్‍హుయుతొ ఇను చిత్తంనా గుర్కవాలొ యోకోన్‍? యో హాంకెబి నేరము మోపకు కిమ్‍ కరి తూ మరెతి బొలిస్‍. <verse eid="ROM 9:19"/><verse number="20" style="v" sid="ROM 9:20"/>ఓ పన్కి ఓ అద్మిమి, దేవ్ను ఎదురు బొలను తుకొన్‍? మేసాన అమ్‍కారియో రూపింపబడ్యుతె రూపించిచుతె ఇనాతి బొలునా? <verse eid="ROM 9:20"/><verse number="21" style="v" sid="ROM 9:21"/>ఏక్‍ ముద్దమతు ఏక్‍ ఘటం ఘనతకునా ఏక్‍ ఘనహీనతంనా కారనటేకె మట్టిపార్‍ కుమ్మరిఇనా అధికార్‍ కొయినా?<verse eid="ROM 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22"/>ఇమ్మాస్‍ దేవ్‍ ఇను ఖీజ్‍నా ద్యెఖావాతిమ్‍, ఇను ప్రభావంనా ద్యెకాడానటేకె, ఇచ్చయించినహుయుతె, నాసనమునం సిద్దపడిన్‍ ఖీజ్‍ను పాత్రహుయో ఘటంనా యో ఘాను ధీర్ఘషామ్తంతి సహించిన్‍ సాత్‍? <verse eid="ROM 9:22"/><verse number="23" style="v" sid="ROM 9:23"/>అజు మహిమ పొందనటేకె సిద్ధపరిచిన్‍ గోర్‍పాత్రనా ఘటమునుబారెమ, కాతొ యూదుల్‍మకంతు మాత్రమస్‍ కాహే, <verse eid="ROM 9:23"/><verse number="24" style="v" sid="ROM 9:24"/>అన్యజనాభోనా కంతు యో బులయిన్‍ అప్నుబారెమ, ఇను మహిమైస్వర్యంనా దెఖావునుకరి ఛా సాత్‍?<verse eid="ROM 9:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ROM 9:25"/>అనా గురించి హోషేయా గ్రంథంమా యో అమ్‍హుషె బోలుకురస్‍,</para>
  <para style="q2" vid="ROM 9:25">యో ప్రకారం మారు జనాభో కాహెతె ఇవ్నే మారు జనాభోకరి,</para>
  <para style="q1" vid="ROM 9:25">ఫ్యార్‍వాలి కాహెతె ఇనా ఫ్యార్‍వాలికరి, నామ్‍ మ్హేందిస్‍.<verse eid="ROM 9:25"/></para>
  <para style="q2">
    <verse number="26" style="v" sid="ROM 9:26"/>అజు హుస్‍తే సాత్‍కాతొ,</para>
  <para style="q1" vid="ROM 9:26">తుమే మారు జనాబొ కాహేకరి ఇవ్నేతి కెజ్గా బొలయిహుయు,</para>
  <para style="q2" vid="ROM 9:26">యో జొగొస్‍ జీవమ్‍హుయుతె దేవ్ను ఛియ్యాకరి ఇవ్నే</para>
  <para style="q1" vid="ROM 9:26">నామ్‍మేదిస్‍ కరి హోషేయమా యో బొలుకురస్‍.<verse eid="ROM 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27"/>అజు ప్రభువు ఇను వాత్‍ ఖాతమ్‍కరిన్‍, క్లుప్తపరిన్‍ జామిన్‍పార్‍ ఇనా కారనటేకె పన్కి ఇష్రాయేల్‍నా ఛియ్యాను సంఖ్య ధర్యావ్‍ను రెతినుతార ఛా మన సేషమస్‍ బఛ్చాయిగాకరి <verse eid="ROM 9:27"/><verse number="28" style="v" sid="ROM 9:28"/>యెషయాబి ఇష్రాయేల్‍నా గూర్చి ఘాణు ఆవాజ్‍తి బులకురాస్‍.<verse eid="ROM 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ROM 9:29"/>అజు యెషయా పైహ్లూ బోల్యొతె ప్రకారం “సైన్యంనా అధిపతిహుయుతె ప్రభువు, అప్నాటేకె వంషంనా మిగ్లాయిన్‍ నా రాక్యొహోతొ సొదొమనుతరస్‍ హుయహోత్‍, గొమొఱ్ఱానుతరా పోలిన్‍ ర్హయహోత్‍.”<verse eid="ROM 9:29"/></para>
  <para style="s">ఇష్రాయేల్‍ను అవిష్వాస్‍</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30"/>అమ్‍హుయుతొ అప్నె సాత్‍బోల్సు? నీతితీ చాల కొయింతే అన్యజనూల్‍ నీతినా, కతొ విష్వాస్‍ను మూలంహుయుతె నీతినా పొంద్యా; <verse eid="ROM 9:30"/><verse number="31" style="v" sid="ROM 9:31"/>హుయితొ ఇష్రాయేల్‍ నీతి కారణంహుయిన్‍ నియమంనా రేప్‍టిన్‍ మన యో నియమంనా అందుకరకొయిని, <verse eid="ROM 9:31"/><verse number="32" style="v" sid="ROM 9:32"/>ఇవ్నేసానా అందుకరకొయిని? ఇవ్నే విష్వాస్‍మూలంతి కాహే క్రియనుమూలొతి ఇనా దుమ్డ్యా. ఇవ్నా గోడ్డాన అడుభండొ లగ్గీన్‍ పల్టీన్‍ పడ్యా. <verse eid="ROM 9:32"/><verse number="33" style="v" sid="ROM 9:33"/>ఆదేక్‍ మే అడుఫాత్రొ అడుబండో సీయోనుమా స్థాపించుకరూస్‍; ఇనాకనా విష్వాస్‍రాకిన్‍ యో షెరం ఖాస్‍కొయిని కరి లిఖూతె ప్రకారం ఇవ్నే అడొఫాత్రొ లగిన్‍, గోడొ పిహ్లిన్‍ పడ్యా.<verse eid="ROM 9:33"/></para>
  <chapter eid="ROM 9"/>
  <chapter number="10" style="c" sid="ROM 10"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1"/>భైయ్యె భ్యేనె, ఇస్రాయేలుల్‍నా బఛ్చడన పొందునుకరి మారు దిల్‍మా ఆహ్ః ఇవ్నేను విషయమం మే దేవ్నా కార్యు ప్రార్థనకారుకురుస్‍. <verse eid="ROM 10:1"/><verse number="2" style="v" sid="ROM 10:2"/>దేవ్ను విషయమ్‍ ఇవ్నే ఘను ఆఖ్‍ఃతి ఛాతె ఇవ్నే గురించి సాక్చం దెమ్కొరాస్‍; హుయుతొబి ఇవ్నే ఆఖ్‍ః జ్ఞానుసారంతిహుయుతె కాహె. <verse eid="ROM 10:2"/><verse number="3" style="v" sid="ROM 10:3"/>కింకతొ ఇవ్నే దేవ్‍కనా నీతిమలంకొయిన్‍తిమ్‍ ఇవ్ను స్వనీతి స్థాపించనా ద్యేతా దేవ్ను నీతినా లోబడ్యుకొయిని. <verse eid="ROM 10:3"/><verse number="4" style="v" sid="ROM 10:4"/>కిమ్‍కాతో విష్వాస్‍కరాతె హార్యేక్‍జణ నీతి కలుగుతిమ్‍ యేసుక్రీస్తు మాస్‍ ధర్మషాస్ర్తంనా పూర్తిహుయిన్‍ ఛా.<verse eid="ROM 10:4"/></para>
  <para style="s">హాఃరనటేకె బచ్చణ్‍</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5"/>ధర్మషాస్ర్తం మూలంతి నీతిన నెరవేరేచొవాలొ ఇనా బారేమస్‍ జీవ్‍నుకరి మోషే లిఖుకురాస్‍. <verse eid="ROM 10:5"/><verse number="6" style="v" sid="ROM 10:6"/>హుయుతొ విష్వాస్‍మాలంహుయుతె నీతి అమ్‍ బొలుకురాతే కొన్‍ స్వర్గమ్‍మా చాడిన్‍ జాసే. <verse eid="ROM 10:6"/><verse number="7" style="v" sid="ROM 10:7"/>కొయిన్‍తొ కొన్బి నరకమ్‍మా<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">పాపుల్‍నా షిక్చీమ్చాత్‍ అగ్నుగుండమ్‍</char></note> ఉతిరిజాసేనా? కతొ క్రీస్తునా మరిగొతె కంతు ఉప్పర్‍ లేవాను కరి తూ తారు దిల్‍మ నొకొరాయిజ్ వో. <verse eid="ROM 10:7"/><verse number="8" style="v" sid="ROM 10:8"/>యోసాత్‍కరి బొలుకురాస్‍ దేవ్ను వాత్‍ తారకనా, తారు బాకుమాతు తారు దిల్‍మా ఛా; యో హామే ప్రచార్‍ను విష్వాస్‍నా సంబంధహుయుతె వాత్‍బి యోస్. <verse eid="ROM 10:8"/><verse number="9" style="v" sid="ROM 10:9"/>యోసాత్‍కతొ యేసు ప్రభువుకరి తారు బాకుతి ఒప్పిలీన్‍, దేవ్ను మరిగొతె కంతు ఇనాబి ఉట్యోకరి తారు దిల్‍మా విష్వాస్‍ను బారేమ, తూ బఛ్చాయిజాసు. <verse eid="ROM 10:9"/><verse number="10" style="v" sid="ROM 10:10"/>కింకతొ నీతి కలుగుతిమ్‍ అద్మిమి దిల్‍మా విష్వాస్‍కరిన్‍, బఛ్చడనహుసేతిమ్‍ బాకుతి ఒపిలిసే. <verse eid="ROM 10:10"/><verse number="11" style="v" sid="ROM 10:11"/>సాత్‍కాతొ, ఇనాకనా విష్వాస్‍ర్హాఖీన్‍ యోకొన్‍కరి సారమ్‍ఖాయిస్‍కొయిని లేఖనం బొలుకురాస్‍. <verse eid="ROM 10:11"/><verse number="12" style="v" sid="ROM 10:12"/>యూదుల్‍కరి గ్రీసు దేఖ్కరి ఫారాక్‍ కొయిని; ఏక్‍ దేవాస్‍ ఖారనా ప్రభువుహుయిన్‍ ర్హాహిన్‍, ఇన ప్రార్థనకారుతె ఖారనాబారేమ కృప ద్యెఖాడానటేకె ఘాను ఆషీర్వాద్‍ ఛా.<verse eid="ROM 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 10:13"/>సానాకాతొ ప్రభువు నామ్ను బట్టి ప్రార్థనకరస్‍తె యోకొన్‍బి బఛ్చాయిజాసు కరి లిఖ్యాయ్‍రుస్‍.<verse eid="ROM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14"/>ఇవ్నే విష్వాస్‍ కరకోయితె వాలన కిమ్‍ ప్రార్థన కర్సు? నాహఃమ్జవాలన కిమ్‍ విష్వాస్‍కర్‍యో? నా ఖాంజ్యుతో ఇను నామ్‍ సాన లేను, ప్రచార్‍వాలొ కొయిన్‍తిం ఇవ్నేకిమ్‍ ఖాంచే?<verse eid="ROM 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 10:15"/>సువార్తన బోలవాలొనా బొలిమొక్లితో ఇన బారేమ కిమ్‍ ప్రచార్‍కరతే? అను విషయంమ ఉత్తమంహుయుతె ఇనా గూర్చినా అష్యల్‍ను ప్రచార్‍కరతే ఇవ్నేపాదం కెత్రూకి సుందర్‍హుయుతె కరి లిఖ్కిరాక్యుస్‍.<verse eid="ROM 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16"/>హుయుతొబి హాఃరుజణు సువార్తన లోబడుకొయిని ప్రభువు, హామే మాలంకారయిన్‍ సమాచరంవాలొ విష్వాస్‍కర్యొకొయిని కరి యెషయా బోలుకురాస్‍ కాహే?<verse eid="ROM 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 10:17"/>కతొ హఃమ్జన బారెమా విష్వాస్‍ హుసె; హఃమ్జను క్రీస్తును బారెమ హుయూతె వాత్‍తి హుయు.<verse eid="ROM 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18"/>హుయుతొ మే సాత్‍ బోలుకరూస్‍ కతొ, ఇవ్నే హఃమ్జకొయిన్నా? హఃమ్జా హుయా? ఇవ్నే ఆవాజ్‍ జామిన్‍పర్‍ ఖారనాబి, ఇవ్నే వాత్‍ ములక్‍ను ఆఖరితోడి నిక్‍ల్యా.<verse eid="ROM 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ROM 10:19"/>అజు మే సాత్‍ బోలిస్‍కతొ ఇష్రాయేల్‍నా మాలంకొయిన్‍నా?</para>
  <para style="q2" vid="ROM 10:19">జనాభో కరి ఇవ్నేటేకె తుమ్నా రోషం పుట్టించో,</para>
  <para style="q1" vid="ROM 10:19">అక్కల్‍కొయింతెవాలనా జనాభొ హాఃరనావల్లా</para>
  <para style="q2" vid="ROM 10:19">తుమ్నా ఛండాల్‍ కర్యాస్‍. కరి అగాఢి మోషే బోలుకరాస్‍.<verse eid="ROM 10:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ROM 10:20"/>అజు యెషయా తెగించొతె దూండవాలన మే మలీస్‍;</para>
  <para style="q2" vid="ROM 10:20">మన పుఛ్చావకొయింతె ఇవ్నే ప్రత్యక్చహుయుతొ కరి బోలుకరూస్‍.<verse eid="ROM 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 10:21"/>ఇష్రాయేల్‍ను విషయం హుయుతొ అవిధేహుయిన్‍ పీటెఫరతే అద్మినా మే ధన్‍అక్కూ మార హాత్‍తి బోలుకరూస్‍.<verse eid="ROM 10:21"/></para>
  <chapter eid="ROM 10"/>
  <chapter number="11" style="c" sid="ROM 11"/>
  <para style="s">ఇస్రాయేల్నా ఉప్పర్‍ దేవ్ను దయా</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1"/>ఇమ్‍ హుయితో మే పుచ్చాయోతె సాత్కాతొ, దేవ్‍ ఇనా ప్రజల్న మేన్దిదొ? ఇంనాబొల్ను. మేబి ఇస్రాయేల్‍ కరి, అబ్రాహామ్ను సంతానమా బెన్యామీన్‍ గోత్రంమా పెద్దాహుయోతెస్‍.<verse eid="ROM 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 11:2"/>ఇనా అగాఢిస్ మాలం ఇనా ప్రజలన్నా దేవ్‍ మేన్దిదొకొయిని. ఏలియాన గూర్చిను భాగంమా లేఖనంమ బొలయు తుమ్నా మలంనా? <verse eid="ROM 11:2"/><verse number="3" style="v" sid="ROM 11:3"/>ప్రభువా, ఇవ్నే తారు ప్రవక్తల్నా మరాఖీదిదా, తారు బలిపీఠమ్నా పట్టకాయిన్‍నాఖీదిదు, మే ఎక్సేజాను మిగిలిరొస్, మరు జాన్‍ కాడుకరస్‍కరి ఇష్రాయేల్నా వైరితి దేవ్నా ఖామే యో వాదించుకురస్‍. <verse eid="ROM 11:3"/><verse number="4" style="v" sid="ROM 11:4"/>హుయుతొ దేవ్‍ దిదోతే జవాబ్‍ ఖమ్జో, బయలునా గుడ్డెకెనాకి‍తే ఖాత్‍హజార్‍ వాగ్రీనా మే సేషంతి రాకిరక్యొస్‍. <verse eid="ROM 11:4"/><verse number="5" style="v" sid="ROM 11:5"/>ఇమాస్‍ తెదెను కాలంమ సయితము కృపను ఏర్పాటును చొప్పుతి సేషంతి మిగిలిన్‍ ఛా. <verse eid="ROM 11:5"/><verse number="6" style="v" sid="ROM 11:6"/>యో కృపతిహుయుతె బరేమ అజుబి క్రియలతి మూలొహుయుతె కాహే ఇమ్‍ హుయితో కృప అజుబి కృప హుస్‍కొయిన్‍నా.<verse eid="ROM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7"/>ఇమ్‍హుయూతొ సాత్‍హుసే? ఇష్రాయేల్‍ దూండుడోకరతె సాత్‍కి యో ఇవ్నే మల్యుకొయిని, దేవ్ను క్రుపానువల్లా ఏర్పాటు హుయుతెవాలనా యో మలియు మిగిలుతె ఇవ్నే కఠినచిత్తుహుయా.<verse eid="ROM 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 11:8"/>అనావిషయంమ హంకెతొడి దేవ్ను ఇవ్నే నిందార్ను మత్తుహుయూతె దిల్నా, దెక్హావాకొయిన్‍తె డొలనా, హఃమ్జకొయిన్‍తె కాన్‍నా దీరాక్యొస్‍కరి లిఖ్కిరాక్యొస్‍. <verse eid="ROM 11:8"/><verse number="9" style="v" sid="ROM 11:9"/>దావీద్‍ బొల్యెతే సాత్‍కాతొ, అజు ఇవ్ను దాన్‍ ఇవ్నా ఉరినితార, బోన్‍తార, ఆటంకమ్‍తార ఇవ్నే క్రియల్‍నా ప్రతిఫలంహువను ర్హాసె పన్కి. <verse eid="ROM 11:9"/><verse number="10" style="v" sid="ROM 11:10"/>ఇవ్నే దేఖకొయినితిమ్‍ ఇవ్నే ఢోళ అంధారుహుయు పాన్కి. ఇవ్నే పీట్పర్‍ కెదేబి జుఖీన్‍ ర్హానుతిమ్‍ కరోకరి దావీద్‍తి బోలుకురస్‍.<verse eid="ROM 11:10"/></para>
  <para style="s">యూదుల్నా బఛ్చాడన</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11"/>అనటేకె మే బోలుకరతే సాత్‍కాతొ, యూదుల్‍ పడిజవాతిమ్‍ తొట్రిల్లిచ్‍నా? ఇమ్‍నాబొల్‍ను, ఇవ్నేను రోషం పుట్టించనాటేకె ఇవ్నేతి తోట్రు పాటుటేకె అన్యజనాభోతి బఛ్చడన కిలిగిన్‍. <verse eid="ROM 11:11"/><verse number="12" style="v" sid="ROM 11:12"/>ఇవ్నేతి తొట్రుపాటు ములక్‍నా ఐస్వర్యంనా, ఇవ్నే నష్టం అన్యజనాభోనా ఐస్వర్యంనా హుయుతొబరేమ ఇవ్నే పరిపూర్ణంతి కెత్రుకి‍ జాక్హత్‍ ఐస్వర్యంహుసే, తేదే యుదుల్బి బుజు జాఖాత్‍ పరిపుర్నత హువుంకారస్‍.<verse eid="ROM 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13"/>ఇవ్నేమ తొడుజానునా బఛ్చావ్‍నుకరి మారు సేవనా ఘనపరుచుకురుస్‍. <verse eid="ROM 11:13"/><verse number="14" style="v" sid="ROM 11:14"/>అన్యజనాభో తుమరెతి మే వాత్‍బొలుకురుస్‍. మే అన్యజనాభోనా అపొస్తలుహుయున్‍ఛా పాన్కి కిమ్‍హుయుతొబి మారు ఆంగ్‍తాను సంబందినా ఖీజ్‍ పుట్టించిన్‍. <verse eid="ROM 11:14"/><verse number="15" style="v" sid="ROM 11:15"/>ఇవ్నే తిరస్కారం పొందాను, ములక్‍నా దేవ్తి సమాధానంహువానటేకె హుయుతొబరేమ, ఇవ్నే చేర్చిలెవాను సాత్‍హుస్‍? మరిగొతె ఇవ్నే సాజీవంమాస్‍ హుయిన్‍ ఉట్టాసే కాహేన?<verse eid="ROM 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16"/>ఆట్టాను ముద్దమా అగాడి ఏక్జానో పరిసుద్ధ హుయుతె ఆట్టోను ముద్దక్హారుబి పరిసుద్ధమాస్‍ జాఢ్ పరిసుద్ధహుయుతొబి ఢాలిబి పరిసుద్ధాస్‍. <verse eid="ROM 11:16"/><verse number="17" style="v" sid="ROM 11:17"/>హుయుతొ ఢాలిమా తొడు తుటిగొ, జ్హాడిమా ఒలీవ డాలీహుయురుతె తూ ఇనా ఇచ్చమా అంటుకట్టబడిన్‍, ఒలీవజ్హాడుతార సారవంతంహుయుతె జాఢ్‍నా ఇనేతి మలిన్‍ పాలుపొందినబరేమ, యో ఢాలిఫర్‍ <verse eid="ROM 11:17"/><verse number="18" style="v" sid="ROM 11:18"/>తుహుయో ఢాలి ఫార్‍ బడ్డాయినొకొమార్‍, జాడ్‍ తునా భరించుకురస్‍ ‍పాన్కి తూ జాఢ్‍నా భరించాకొయిని.<verse eid="ROM 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19"/>ఇనాటేకె మే అంటుకట్టబడిన్‍ నిమిత్తం ఢాలినా తొడిన్‍ నాక్హిదిదుకరి తూ బొలిస్‍. <verse eid="ROM 11:19"/><verse number="20" style="v" sid="ROM 11:20"/>ఖాచీస్‍ ఇవ్నే అవిస్వాసంనాబట్టి తొడాయహుయా, తుహుయుతొ విష్వాస్‍నాబట్టి ఉభీరీరోస్‍ తారు తుస్‍ గ్వోరాపాడ్‍నొకొ తీమ్‍, ఢర్‍ కాలిగిన్‍ ర్హా. <verse eid="ROM 11:20"/><verse number="21" style="v" sid="ROM 11:21"/>సానకాతో దేవ్నూ స్వాభావికంహుయుతె ఢాలినా మేదిన్‍ బారేమ తునాబి కోమేన్దాసే.<verse eid="ROM 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22"/>అనటేకె దేవ్ను అనుగ్రహంనా కాఠిన్యంతి కాతొ పడిజైయిన్‍ ఇవ్నఫర్‍ కాఠిన్యంనా, తూ అనుగ్రహ ప్రాప్తుహుయోతె హుబిరొతె బరేమ తారపార్‍ ఛాతె దేవ్ను అనుగ్రహంనా ద్యెక్‍ అమ్‍ హుబర్‍సేకరి బారేమ తూబి క్హాత్రయిజాయిస్‍. <verse eid="ROM 11:22"/><verse number="23" style="v" sid="ROM 11:23"/>బుజు యూదుల్‍బి ఇవ్ను అవిష్వాసంమా హుబిరినార్హహితొ బారేమ అంటుకట్టబడ్‍సు; దేవ్ను ఇవ్నే బారేమ అంటుకట్టటనా తాక్హాత్‍వాలొ. <verse eid="ROM 11:23"/><verse number="24" style="v" sid="ROM 11:24"/>కింకతొ తూ స్వాభావికహుయుతె జాడిన ఒలివ జ్హాడ్‍ కంతు వాడయుగుతె స్వభావవిరుద్ధంతి అషల్ ఒలీవ జ్హాడాన అంటుకట్టబడ్యుతె బారేమ స్వాభావికహుయుతె ఢాలినా ఇవ్నే అజు నిష్చయంతి ఇవ్నేతి ఇను ఒలీవజ్హాడాన అంటుకట్టబడ్‍యా కొన్నా<verse eid="ROM 11:24"/></para>
  <para style="s">ఇస్రాయేల్నా పునర్థానము</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25"/>భేనే భైయ్యె, తుమరుద్రుష్టన తుమే దిమాక్‍వాల కరి అనుకొలెంకొరుస్‍ ఆ మర్మంనా తుమే మలంకార్‍నుకరిఛావు. యోసాత్‍కతొ, అన్యజనాభోనా పేసిన్‍ సంపూర్ణహువాతొడి ఇష్రాయేల్‍నా కఠిన్‍ దిల్తివాలు తొడుతొడి కలిగ్యు.<verse eid="ROM 11:25"/></para>
  <para style="s">హాఃరంఫర్‍ దేవ్ను దయ</para>
  <para style="r">(<ref loc="MAT 23:39">మత్త 23:39</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 11:26"/>ఇవ్నే పేసిన్‍ విమోచకుడునా సీయోనుమాంతు అయిన్‍ యాకోబ్‍కంతు భక్తిహీనతాన చుఖాయో<verse eid="ROM 11:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27"/>మే ఇవ్ను పాప్‍నా పరిహరించీన్‍,</para>
  <para style="q2" vid="ROM 11:27">మారటేకె ఇవ్న హుసెతె నిబంధన అస్నా కరి లిఖ్యుతిమ్‍,</para>
  <para style="q1" vid="ROM 11:27">ఇస్రాయేల్‍ జనాభొహాఃరు బఛ్చాయి జాసె.<verse eid="ROM 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28"/>సువార్త విషయహుయుతె తుమ్నాబట్టి వైరిహుయిన్‍ ర్హావజాయ్‍ పన్కి, దేవ్ను ఏర్పాటును విషయహుయుతె భానుభా బట్టి ఇవ్నె దేవ్నా లాఢ్‍వాలు హుయిన్‍ ఛా. <verse eid="ROM 11:28"/><verse number="29" style="v" sid="ROM 11:29"/>కింకతొ, దేవ్ను ఇను కృపావరంలొ విషయంమా, దేవ్ను బులావను విషయంమా పష్చాత్తాపం పడ్సేకొయిని. <verse eid="ROM 11:29"/><verse number="30" style="v" sid="ROM 11:30"/>సామకతో జమానమా తుమే దేవ్నా అవిధేహుయున్‍ ర్హవొ, హంకెతొ అన్యజనాబో హుయుతే తుమే దేవ్ను దయాన పోందిన్‍ ఛా, యూదుల్ హుయుతే తూమే అవిధేయతబట్టి గోర్‍ పొంద్యొ. <verse eid="ROM 11:30"/><verse number="31" style="v" sid="ROM 11:31"/>ఇమ్నితరా తుమారురు బారేమ ద్యెహాఃడ్యుతె గోర్‍ బట్టి ఇవ్నేబి హంకె గోర్‍ పొందిన్‍ నిమిత్తం, తెదె ఇవ్నే అవిధేహుయున్‍‌‌ ఛా. <verse eid="ROM 11:31"/><verse number="32" style="v" sid="ROM 11:32"/>హాఃర ఫర్‍ ఇను గోర్‍ దేక్నుకరి, దేవ్ను హాఃరన అవిధేయతాసీతిమా మూచిదిన్‍ బంధించిన్‍ఛా.<verse eid="ROM 11:32"/></para>
  <para style="s">దేవ్నా మహిమా కరను</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33"/>బాబ్రే, దేవ్ను దిమక్‍నుజ్ఞానంతి బాహుష్యంన కెత్రుకి గంభీరంతి; యో న్యావ్‍నా పహాఃవనుతిమ్‍ అషక్యంనా యో వాట్‍మకెత్రుకి అగమ్యం.<verse eid="ROM 11:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34"/>ప్రభువును దిల్నా మాలంహుయతె యోకోన్‍?</para>
  <para style="q2" vid="ROM 11:34">ఇనా హఃయల్నా బోల్యుతె యోకోన్‍?<verse eid="ROM 11:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35"/>కొన్బీ యేసునా సాత్బి దిరాఖ్యుకి,</para>
  <para style="q2" vid="ROM 11:35">పాఛు యో దేనారో కొయిన్నా? ప్రతిఫలం పొందను యోకొన్‍?<verse eid="ROM 11:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ROM 11:36"/>యో మూలంతి ఇనేతిస్‍ యో నిమిత్తంను సమస్తం కలుగురాస్‍. పిఢపిఢినా తోడి ఇనాస్‍ కెదేబి మహిమ కలుగుస్‍ పన్కి. ఆమేన్‍.<verse eid="ROM 11:36"/></para>
  <chapter eid="ROM 11"/>
  <chapter number="12" style="c" sid="ROM 12"/>
  <para style="s">దేవ్నా సేవకరనా జీవను</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1"/>అనటేకె భైయ్యె, పరిసుద్ధంనా దేవ్నా అనుకూలం హుయుతె జీవనుయాగంతి తుమే ఆంగ్‍తాను ఇనా సమర్పింపిచిలెవొ దేవ్ను త్యాగమ్‍ వాత్యల్యంనుబట్టి తుమ్నా పొఖాలవుకురుస్‍. అజాత్నూ సేవ తుమ్న యుక్తహుయురొస్‍, తో ఆ ఖాచీస్‍. కరి మే బొలుకరుస్‍, <verse eid="ROM 12:1"/><verse number="2" style="v" sid="ROM 12:2"/>తుమే ఆ ములక్‍ను అద్మియే అనుసారంచుకరతే తుమే నొకొఅనుసరించొ, అనుకూలంనా, సంపూర్ణంహుయుతె దేవ్ను చిత్తంసాత్కి పరీక్చించిన్‍ మాలంకరతిమ్‍ తుమారు దిల్‍ బద్లాయిన్‍ నవూహువానటేకె రూప్నా పొందితొ అష్యల్.<verse eid="ROM 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3"/>ఇనా యోస్‍ ఎంచుకొనతగిన ఇనకనా ఘాను ఎంచకొయిన్‍తిమ్‍, దేవ్‍ ఏక్నా ఏక్‍ విభజిమ్చిన్‍ దిదొతె విష్వాస్‍ పరిమాణ ప్రకారం, యో స్వస్థ దిమాక్‍వాల హువనాటేకె తగిన రీతితిమ్‍ ఇనా ఎంచిలీస్‍ కొయినికరి, మన అనుగ్రహింపబడ్యుతె కృపనుబట్టి తుమరమాబి హర్యేక్‍తి బొలుకురుస్‍. <verse eid="ROM 12:3"/><verse number="4" style="v" sid="ROM 12:4"/>ఇమ్‍హుయితో ఏక్‍ ఆంగ్‍తాన్‍తి అప్నా కెత్రుకి అవయావాల్‍ ర్హాహితొబి, ఆ అవయవాల్‍ ఖారనా ‍ఎక్కస్‍ కామ్‍ కిమ్‍కి ర్హాసెకొయిని, <verse eid="ROM 12:4"/><verse number="5" style="v" sid="ROM 12:5"/>ఇమ్మాస్‍ అనుకులంహుయుతె అప్నే క్రీస్తుమా ఏక్‍ ఆంగ్‍తానుతార ర్హహిన్‍, ఏక్నా ఏక్‍ ప్రత్యేకంతి అవయవాల్‍ హుయిన్‍ ఛా. <verse eid="ROM 12:5"/><verse number="6" style="v" sid="ROM 12:6"/>అప్నా అనుగ్రహింపబడ్యుతె కృప చొప్పుతిమ్‍ అలాదుకొన్కి కృపావరంతి హుయువాల హుయిరాస్న పాన్కి, ప్రవచనవరం హుయుతె విష్వాస్‍ పరిమాణంమా చొప్పుతిమ్‍ ప్రవచించు; <verse eid="ROM 12:6"/><verse number="7" style="v" sid="ROM 12:7"/>సేవకారవాలహుయుతొ సేవ కార్‍, బోధించొవాలొ హుయుతొ బోధించాను కార్‍, <verse eid="ROM 12:7"/><verse number="8" style="v" sid="ROM 12:8"/>ప్రోత్సహించవాలొహుయుతొ ప్రోత్సహించమా కామ్‍హుయిన్‍ ర్హాసు. పంఛవాలొ స్రద్ధాదిల్తి పంచును, పార్ను విచారణకరవాలో జాగ్రుత్‍తి, గోర్‍వాలొ కామ్‍ కారవ్ను.<verse eid="ROM 12:8"/></para>
  <para style="s">క్ర్తెస్తవుల్ను ఛాల్</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9"/>తుమారు ఫ్యార్‍ నిష్కపట హుయుతే ర్హాను. హాఃరబ్‍నా నసహ్యింసిచిన్‍ అష్యల్నా ధారిలేవో. <verse eid="ROM 12:9"/><verse number="10" style="v" sid="ROM 12:10"/>భైయే, భేనేను ఫ్యార్‍ను విషయంమా ఏక్నా ఏక్‍ అనురాగము హుయుతె ఇవ్నే, ఘనతను విషయంమా ఏక్నాఏక్‍ గొప్పతి ఎంచిలెవొ. <verse eid="ROM 12:10"/><verse number="11" style="v" sid="ROM 12:11"/>స్రద్ధాసక్తుల్‍ విషయంమా పిటే నొకొర్హావొ, ఆత్మమా తీవ్రతావాలహుయిన్‍ ప్రభువునా దిల్తీ సేవించొ. <verse eid="ROM 12:11"/><verse number="12" style="v" sid="ROM 12:12"/>నిరీక్చణ హుయుతె ఇవ్నే ఖుషితి, ఓర్పుహుయిన్‍ ఇవ్నే, ప్రార్థనామా హామేసా పట్టుదలతి కల్గీన్‍ ర్హవొ. <verse eid="ROM 12:12"/><verse number="13" style="v" sid="ROM 12:13"/>దేవ్ను అద్మియోనా అవసరం హుయుతె ఇవ్నా సహయాం కారో, ఖాదర్‍తి ఆతిథ్యం షీఖిలెకొరాస్‍.<verse eid="ROM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14"/>తుమ్నా హింసించవాలనా ఆసీర్వాదించొ; ఆసిర్వాదించో పన్కి సపించానొకొ. <verse eid="ROM 12:14"/><verse number="15" style="v" sid="ROM 12:15"/>ఖుషితీ ఇవ్నేతి ఖుషితి ర్హవొ; రొవ్వావాలతీ రొవ్వొ; <verse eid="ROM 12:15"/><verse number="16" style="v" sid="ROM 12:16"/>ఏక్ను ఏక్‍ దిల్‍తీ మలీన్‍ ర్హవొ, తుమారు తుమేస్‍ దీనుల్తీ సహవాసం కరో; దిమాక్‍ వాలొకరి నొకొర్హహిజవొ.<verse eid="ROM 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17"/>క్హారబ్‍నా ప్రతి హాఃరాబ్‍ ఇవ్నే కర్‍నొకొ; అద్మిహాఃరనా నజర్మా యోగ్యహుయుతె ఇనాబారెమా హఃయల్‍ కల్గీన్‍ ర్హవొ. <verse eid="ROM 12:17"/><verse number="18" style="v" sid="ROM 12:18"/>వీల్‍హుయూతొ హుయుతె తుమరు హాత్నుహుయుతే మట్టుకుతీ సమస్తం అద్మియేతి షాంతీతీ ర్హవొ. <verse eid="ROM 12:18"/><verse number="19" style="v" sid="ROM 12:19"/>లాఢ్‍హుయతే భైయ్యే, తుమ్నా తుమేస్‍ పగతిర్చి కొయిన్‍తిమ్‍, దేవ్నా ఖీజ్నా జోగోదేవో పగతీర్చునాను మారు కామ్‍, మే ప్రతిఫలంతి దిస్కరి ప్రభువు బొలుకురాస్‍కరి లిఖ్హురాక్యుస్‍ ఛా. <verse eid="ROM 12:19"/><verse number="20" style="v" sid="ROM 12:20"/>అనటేకే, తారు వైరి భుక్కె లాగ్యు ర్హయితో ఇనా ధాన్‍ నాఖో, ఎక్కాతరా తర్హాక్తి ర్హైతో పానిదెవ్వొ; ఇమ్మాస్ కర్యాతొ ఇనా దిల్మా షారమ్‍ ఖైయిన్‍ ఆగ్‍నితరా హుసే. <verse eid="ROM 12:20"/><verse number="21" style="v" sid="ROM 12:21"/>కారబ్నాహాతె తుమ్నాఉపర్‍ జీతొకొయినీతింమ్‍, ఖరాబ్తి హారినొకొజావొ పన్కి, అష్యల్లి కారబ్నా జిత్‍సు.<verse eid="ROM 12:21"/></para>
  <chapter eid="ROM 12"/>
  <chapter number="13" style="c" sid="ROM 13"/>
  <para style="s">మోటవ్నా బ్హన్తీ బాద్యతా</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1"/>హర్యేక్‍జణు ఉప్పర్ను అధికార్‍నా లోబడి ర్హావానటేకె; కింకతొ దేవ్నటేకె హుయుతె తప్ప అజు కెవు అధికారంబి కొయిని; ఛాతె అధికారంనా దేవ్తీస్‍ నియమింబడిన్‍ ఛా. <verse eid="ROM 13:1"/><verse number="2" style="v" sid="ROM 13:2"/>అనటేకే కొన్బి అధికార్‍నా ఎదిరించొవాల దేవ్ను నియమంనా ఎదిరించుకురాస్‍; ఎదిరించవాల ఇవ్నేఫర్‍ ఇవ్నేస్‍ న్యావ్‍ ల్యాలిసే. <verse eid="ROM 13:2"/><verse number="3" style="v" sid="ROM 13:3"/>హఃర్కార్‍ కరవాలనా ఖర్రాబ్‍ కార్యంనాస్‍ పన్కి అష్యల్ కార్యంనా భయమ్‍కర్‍వాలొ కాహే; తునా అషల్ హుసెతిమ్‍ అధికార్‍నా దేవ్ను పరిచారకులు; ఇవ్నే ఢర్ కొయిన్‍తిమ్‍ ర్హాను కోర్యెనా? కేహుఅష్యల్‍కి కారో, తెదె ఇవ్నేతి ఘనతపొందిస్‍. <verse eid="ROM 13:3"/><verse number="4" style="v" sid="ROM 13:4"/>తూ హాఃరబ్‍ కార్యయోతె బారేమ ఢరొ, ఇవ్నే చుక్కేస్‍ తాల్వార్‍నా పేర్లీదా; కీడు కారవాలొఫర్‍ ఖీజ్‍ వతాలనుటేకె ఇవ్నే ప్రతికారం కరవాల దేవ్ను ప్రచార్‍ కరవాలొ. <verse eid="ROM 13:4"/><verse number="5" style="v" sid="ROM 13:5"/>అనటేకే ఖీజ్నుఢర్‍ బట్టి యోస్‍ కాహే దిల్ను జామీన్‍ బట్టిబి అధికారుల్నా లొంగీన్‍ ర్హావను ఆవస్వకం.<verse eid="ROM 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6"/>కింకతొ ఆ కారణంతీస్‍ పాన్నుల్‍ భాందుకారస్‍, ఇవ్నే దేవ్ను సేవకుడ్‍హుయున్‍ ఛా కెదేబి సేవమా కామ్‍ హుయిన్‍ ర్హాస్‍. <verse eid="ROM 13:6"/><verse number="7" style="v" sid="ROM 13:7"/>అనటేకే తుమే కంతుబీ ప్హేడుకరస్‍? అనటేకే కిను పన్ను ఇనా పన్నుబి, కినాబి సుంకమో ఇనా సుంకంనా చెల్లించొ. కినాబారేమబి ఢర్‍ర్హాను కరి ఇనాబారేమ ఢర్‍బి, కినాబిబారేమ సన్మానమం హుయిన్‍ర్హావొ, ఖారనా ఇవ్ను ఇవ్ను రుణంనా తీర్చొ.<verse eid="ROM 13:7"/></para>
  <para style="s">ఏక్నా యేక్ ఫర్‍ బాద్యతా</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8"/>ఏక్నాయేక్‍ ఫ్యార్‍ను విషయంమా తప్పఅజు సాత్బి కినాబి రుణం ర్హావొనొకొ. అలాదువాలనా ఫ్యార్‍కరవాలొ ధర్మషాస్ర్తంనా నెరవేర్చెచవాలొ. <verse eid="ROM 13:8"/><verse number="9" style="v" sid="ROM 13:9"/>కింకతొ వ్యభిచరింనొకొకారొ, నరహత్య నొకొరారొ, చొర్‍నొకొకారొ, ఆక్హాక్‍నొకొకారొ, కారిహుయుతె, అజు కెహు ఆజ్ఞనహుయుతొబి ఛాతె బారేమ యోబి తారిన్‍తార తారు అలాదువాలొనబీ ఫ్యార్‍ను వాక్యంనా సంక్చేపంతి ఇమిడిన్‍ ఛా. <verse eid="ROM 13:9"/><verse number="10" style="v" sid="ROM 13:10"/>ఫ్యార్‍ అలాదువాలనా కీడు కర్సెకొయిని పన్కి ఫ్యార్‍హుయిన్‍ ర్హాను ధర్మషాస్ర్తంనా క్హారు నెరవేర్చనుటేకె.<verse eid="ROM 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11"/>అజు తుమే ధన్‍ మాలంకరీన్‍, లిందర్‍మతూ‍ ఉట్టిన్‍ వక్హత్‍హుయూకరి మాలంకరీన్‍, ఇమ్మాస్‍ కరొ. అప్నే విష్వాస్‍హుయతొ కంతు హంకె, బఛ్చడన అప్న అజు ఖందెస్‍ఛా. <verse eid="ROM 13:11"/><verse number="12" style="v" sid="ROM 13:12"/>రాత్‍ గ్హనుహుయిన్‍ వ్హాను క్హందెస్‍ఛా పన్కి అప్నే అంధారాను క్రియల్‍నా మ్హేందిన్‍, ఉజాలనుసంబంధహుయుతె కవచమ్‍ పేరిలిన్‍ లిసు. <verse eid="ROM 13:12"/><verse number="13" style="v" sid="ROM 13:13"/>అల్లరితి మలితె కెలానుకుదానుహుయుతె దారు పిన్‍ మత్తుమాబి కొయిన్‍తిమ్‍, కామవిలాసంహుయుతె పోకిరి చేష్టనాబి కొయిన్‍తిమ్‍, ఖీజ్‍, కలహంహుయుతొబి మత్సరంహుయుతొబి కొయిన్‍తిమ్‍, ఉజాలమా ఛాలతిమ్‍ మర్యాదతి ఛాల్చే. <verse eid="ROM 13:13"/><verse number="14" style="v" sid="ROM 13:14"/>ఇమ్మాస్‍ పిటేతి ప్రభువుహుయుతె యేసు క్రీస్తును అయుదామ్మా పేర్లేవో, ఇవ్నే ఆంగ్తాన్‍ను ఇచ్ఛల్నా నెరవేర్చాటేకె ఆంగ్‍తాను విషయంత ఆలోచిన్‍ కర్లెవో.<verse eid="ROM 13:14"/></para>
  <chapter eid="ROM 13"/>
  <chapter number="14" style="c" sid="ROM 14"/>
  <para style="s">బగల్‍ వాలన న్యాయం నాబోలును</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1"/>విష్వాస్‍ను విషయంహుయతె కంజొర్‍వాలన బులయిలెవొ, హుయుతొబి సందేహామ్‍ తీర్చునటేకె లడ్డాయిన మెదినొకొలెవొ <verse eid="ROM 14:1"/><verse number="2" style="v" sid="ROM 14:2"/>ఏక్‍ ధర్తి ఖావజైకరి నమ్ముకురస్‍, అజెక్ జణు ఖంజోర్ హుయిన్‍ ర్హాయో, చట్టినురాచునా క్హాంకొరాస్‍. <verse eid="ROM 14:2"/><verse number="3" style="v" sid="ROM 14:3"/>క్హావాలొ క్హావకొయిన్‍తె ఇనా నొకొకరినాబొల్‍ను, క్హావ్వాలొ క్హావుంకరాతెఇనా న్యావ్‍ కర్‍లేను; కింకతొ దేవ్‍ఇనా చేర్‍చిలేస్‍. <verse eid="ROM 14:3"/><verse number="4" style="v" sid="ROM 14:4"/>అజెయేక్ జణుసేవకుడ్నా వీషయాంమా న్యావ్‍ దెవ్వానా తూ కొన్‍? యో ఉబిరిర్హావాను హుయుతొబి పడిర్హావను హుయుతొబి ఇను యజమానినా కామ్‍మాస్‍; యో ఉబిర్‍సే, ప్రభువు ఇనా ఉబరానటేకె తాఖత్‍వాలొ హుసె.<verse eid="ROM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5"/>ఏక్జనొ ఏక్‍ ధన్‍తీబి అజుఏక్‍ ధన్‍ అషల్ ధన్‍కరి ఎంచిలింకొరాస్‍; హర్యేక్‍జానొ ఇనాతొడి యోస్‍ ఇను దిల్‍నా ఖఛ్చితంకార్‍లెకొరాస్‍. <verse eid="ROM 14:5"/><verse number="6" style="v" sid="ROM 14:6"/>ధన్నా లక్చ్యపెట్టవాలొ ప్రభువు కోసం లక్చ్యమేదుకురాస్‍; క్హావాలొ దేవ్ను కృతజ్ఞతాస్తుతులు చెల్లించుకురాస్‍ పన్కి ప్రభువు కోసంమాస్‍ క్హాకొర్‍స్‍, నాక్హావాలొ ప్రభువు కొసం క్హానుబంద్‍కరిన్‍, దేవ్ను కృతజ్ఞతాస్తులు చెల్లించుకురాస్‍. <verse eid="ROM 14:6"/><verse number="7" style="v" sid="ROM 14:7"/>అప్నామ కొన్‍బి ఇనాటేకెస్‍ జీవ్‍సేకొయిని, కొన్‍బి ఇనాటేకె మరెసేకొయిని. <verse eid="ROM 14:7"/><verse number="8" style="v" sid="ROM 14:8"/>అప్నే జీవియాతొబి ప్రభువు కోసమాస్‍ జీకొరాస్‍; మరిగొతొబి ప్రభువు కోసమాస్‍ మరిజొకొరుస్‍. అనటేకే అప్నే జీవితొబి మరిగాతొబి ప్రభువువాలయిన్‍ ఛా. <verse eid="ROM 14:8"/><verse number="9" style="v" sid="ROM 14:9"/>యో మరిగొతెనా జీవిన్‍ఛాతె ప్రభువుహుయిన్‍ ర్హానా అను నిమిత్తం కాహేనా క్రీస్తు మరిన్‍ అజు జీయో. <verse eid="ROM 14:9"/><verse number="10" style="v" sid="ROM 14:10"/>హుయుతొ తూ తారు భైయోన బుజు భేనేనా న్యావ్‍ తీర్చకిమ్‍? తారు భైయోన నిరాకరింపనుకిమ్‍? అప్నేక్హారా దేవ్ను న్యాయ పీఠమ్నా క్హామే ఉబర్‍సు. <verse eid="ROM 14:10"/><verse number="11" style="v" sid="ROM 14:11"/>మారు జీవమ్‍తోడు, హర్యేఏక్‍ గుడ్డెయో మరా క్హామే వంగ్‍సే, హర్యేక్‍ జిబ్‍ దేవ్ను స్తుతించును కరి ప్రభువు బొలుకురాస్‍ కరి లిఖ్హురాక్యుస్‍. <verse eid="ROM 14:11"/><verse number="12" style="v" sid="ROM 14:12"/>పన్కి అప్నమా హర్యేక్‍జాను ఇను గురించి దేవ్ను లెక్క అప్పగిమ్చును.<verse eid="ROM 14:12"/></para>
  <para style="s">ఏక్నాయేక్‍ పడిజావనుతరా నోకొకర్లేవో</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13"/>ఇనటెకే అప్నెహంకెతు ఎక్నాఎక్ న్యావ్‍ తీర్చలిసు. అస్‍కాహే, భైయో, భేనేనా, అడుహుయుతె ఆటంకంహుయుతె‍ కార్‍రుకరి తూమే నిష్చయించొ. <verse eid="ROM 14:13"/><verse number="14" style="v" sid="ROM 14:14"/>సహజంతి కెవుబి నిషిద్ధం హుయుకొన్‍యితె మే ప్రభువుహుయుతె యేసుమా మాలం ఖఛ్చితంగా నమ్ముకురుస్‍. హుయుతె కెవుబి గలీజ్‍కరి ఎంచవాలనా యో గలీజాస్‍. <verse eid="ROM 14:14"/><verse number="15" style="v" sid="ROM 14:15"/>తారు భైయో, భేనే, తారు క్హాణు మూలంతి దుఃఖంచెతొ బారేమ తారుహంకె ఫ్యార్‍హుయిన్‍ ఛాలవాలొ యోకొన్‍. కినాటెకె క్రీస్తు మరిగొకరి ఇనా తారు క్హాణుతి క్హారబ్‍ కార్‍నొకొ. <verse eid="ROM 14:15"/><verse number="16" style="v" sid="ROM 14:16"/>తుమ్నా ఛాతే అష్యల్‍హుయుతె గాలయ్‍ హువాననొకొద్యెవొ. <verse eid="ROM 14:16"/><verse number="17" style="v" sid="ROM 14:17"/>దేవ్ను రాజ్యమ్‍ ఖావ్వాను పియాను కాహే పన్కి, నీతిబి షాంతిబి పరిసుద్ధాత్మమా ఖుషిహుయిన్‍ ఛా. <verse eid="ROM 14:17"/><verse number="18" style="v" sid="ROM 14:18"/>సానకతో ఆ విషయంమా క్రీస్తునా దాసుడుహుయుతె యో దేవ్ను ఇష్టుడుహుయుతె అద్మియెన ద్రుష్టినా యోగ్యుడ్‍.<verse eid="ROM 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19"/>అనటేకే షాంతిసమాధానంనా, బుజుఏక్‍ దుసారతీ సాంతితి ప్రోసాహీంచో కార్‍కుకరాతె ఇనా అఖ్‍తి అనుసరింతచు. <verse eid="ROM 14:19"/><verse number="20" style="v" sid="ROM 14:20"/>ఖాణును నిమిత్తం దేవ్ను కామ్మా ఖారబ్‍నొకొకారొ; ఖావను పదార్థంనా పవిత్రమాస్‍ పన్కి అనుమానంతి ఖావాలొ యో ఖారబ్‍. <verse eid="ROM 14:20"/><verse number="21" style="v" sid="ROM 14:21"/>బొట్టి క్హాను పన్కి, ద్రాక్చనురసం పియాను పన్కి, తారు భైయె, భేనే, అడ్డు కలుగుకారాస్‍కరి అజుకెవుబి పన్కి, బులిజ్హానొ అషల్. <verse eid="ROM 14:21"/><verse number="22" style="v" sid="ROM 14:22"/>తూనాఛాతె విష్వాస్‍నా దేవ్ను ఖామే తారటేకె తూస్‍ ఎంచిలెకొరాస్‍; యో సమ్మతించొతె విషయంమా ఇనా యోస్‍ న్యావ్‍ తీర్చుతిచిలెవాలొ ధన్యుడు. <verse eid="ROM 14:22"/><verse number="23" style="v" sid="ROM 14:23"/>అనుమనంచొవాలొ ఖాద్యెతెబరేమ విష్వాస్‍ కొయిన్‍తిమ్‍ ఖాసే, పన్కి దోషికరి న్యావ్‍ పొందవాలొ. విష్వాసమూలంతి హుయుతె కెవుకి యో పాప్‍.<verse eid="ROM 14:23"/></para>
  <chapter eid="ROM 14"/>
  <chapter number="15" style="c" sid="ROM 15"/>
  <para style="s">తారు తూస్‍ కాహేతిమ్‍ అలాదవ్నా భడ్డావను</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1"/>కాహే తాఖత్‍వాలొయుహుతె తప్ప, అప్నా అప్నాస్‍ ఖుషిహువకొయిన్‍తిమ్‍, క్హాంజొర్‍ దౌర్బల్యంహుయుతె పేరిలెవానటేకె రుణమ్ హుయిన్‍ ఛా. <verse eid="ROM 15:1"/><verse number="2" style="v" sid="ROM 15:2"/>ఇను బగ్లాల్‍వాలు క్చేమాభిహ్రుద్ధి హువాతిమ్‍ అప్నమా హర్యేఏక్‍జాను అష్యల్ హుయుతె ఇనమా ఇనా ఖుషిరాక్‍నుకరి. <verse eid="ROM 15:2"/><verse number="3" style="v" sid="ROM 15:3"/>క్రీస్తుబీ ఇనాయోస్‍ ఖుషికర్‍లిదొకొయిని పన్కి తునా క్హుజయివాల గాలై మరపార్‍ పాడ్యు. కరి లిఖ్హుతిమ్‍ ఇనా హుయు. <verse eid="ROM 15:3"/><verse number="4" style="v" sid="ROM 15:4"/>కిమ్‍కాతొ ఓర్పునటేకె, ప్రోత్సహించటేకె అప్నా నిరీక్చణ హువాతిమ్‍ జామనామా లిఖ్హుతిమ్‍ క్హారుబి అప్నా బొధహుసేతిమ్‍ నిమిత్తం లిఖిలిన్‍ ఛా. <verse eid="ROM 15:4"/><verse number="5" style="v" sid="ROM 15:5"/>క్రీస్తు యేసు చిత్తప్రకారం ఎక్‍ దిల్తీ ఏక్‍ ఆవాజ్తి మల్యుతె ఇవ్నే ఓర్పునా ఆదరణనా కర్తహుయుతె దేవ్నా తుమ్నా అనుగ్రహించిస్‍ పన్కి. <verse eid="ROM 15:5"/><verse number="6" style="v" sid="ROM 15:6"/>తుమేస్‍ ఏక్‍భావం వాలా ఎకగ్రీవంతి అప్నా ప్రభువుహుయుతె యేసు క్రీస్తు భాహుయుతె దేవ్న మహిమపరచటేకే యేసుక్రీస్తుని వాతేఖమ్జిన్ ఇన్మారవానా ఎకామనస్సుతి ఒర్పుతి ఆదరణతిచాతే దేవ్ తుమ్నాదేవాదా.<verse eid="ROM 15:6"/></para>
  <para style="s">అన్యజణుల్నాటేకె సుభవార్త</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7"/>అనటేకే క్రీస్తు తుమ్నా చేర్చులిదోతే ప్రకారం దేవ్ను మహిమతీ కలుగుతిమ్‍ తుమేబి ఏక్నాఏక్‍ చేర్చలెవొ. <verse eid="ROM 15:7"/><verse number="8" style="v" sid="ROM 15:8"/>మే బోలుకురాతే సాత్‍కతో, దేవ్ను హాఃచినా బ్హణే అన్యజణుల్‍ ఓఢో యో కర్యయోతే సుష్థిరంతీ వాక్ముల్‍నా తిరంతి కరనటేకె క్రీస్తు సున్నతి ఛాతే ఇవ్నా ప్రచార్‍ కరవాలొహుయో.<verse eid="ROM 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 15:9"/>తుమేస్‍ ఏక్‍భావం వాలా ఎకగ్రీవంతి అప్నా ప్రభువుహుయుతె యేసుక్రీస్తు భాహుయుతె దేవ్న మహిమపరచ నిమిత్తం, మే బొలుకుర్‍తెసాత్‍కాతొ, భానొభా కార్యాతె వాగ్దానంనా విషయంమా దేవ్ను గోర్‍బి మహిమపరచటేకె క్రీస్తు సున్నతి వాలానా పరిచారకుడుహుయుతె. ఇన విషయంమా ఆ కారణంతి అన్యజనాభో మే తునా స్తుతించిస్‍; తారు నామ్‍నుసంకీర్తనా కార్‍సుకారి లిఖ్హురాక్యుస్‍.<verse eid="ROM 15:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 15:10"/>అజు అన్యజనాభో,</para>
  <para style="q2" vid="ROM 15:10">ఇనా ప్రజల్‍నా ఖుషితి ర్హావో కరి<verse eid="ROM 15:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 15:11"/>అజు ధరత్తినా అన్యజనాభో,</para>
  <para style="q2" vid="ROM 15:11">ప్రభువునా స్తుతించొ హర్యేక్ అద్మి</para>
  <para style="q2" vid="ROM 15:11">ఇనా కొనియాడ్సుకరి బోలుకురాస్‍.<verse eid="ROM 15:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 15:12"/>అజు యెషయా ఇమాస్‍ బొలుకురాస్‍,</para>
  <para style="q2" vid="ROM 15:12">యెష్షయిను ఖాందాన్‍ మాతు ఝడ్‍ ఆవ్సే,</para>
  <para style="q2" vid="ROM 15:12">కతొ అన్యజనాభో ఏలానటేకే ఉట్టావాలొ అవ్సే;</para>
  <para style="q2" vid="ROM 15:12">ఇనాకనా అన్యజనాభో ఆఖ్‍తి ర్హాక్‍సు.<verse eid="ROM 15:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 15:13"/>హువామా తూమే పరిసుద్ధాత్మను తాఖత్‍నా పొందిన్‍, విస్తారంతి నిరీక్చణ హువాలతిమ్‍ నిరీక్చణకర్తహుయతె దేవ్ను విష్వాస్‍తిస్‍ ధారతి ఖారుబి షాంతి తుమ్మనా భారిస్‍ పన్కి.<verse eid="ROM 15:13"/></para>
  <para style="s">పౌల్‍ అధికారంతి ఉత్తరం లిఖ్కను</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14"/>మారా భైయ్యే బుజు భేనె, తుమే కేవలం అచ్చువాల నమ్ముకురు, సమస్త తారుపూరజ్ఞాన్‍తి, ఎక్నాయేక్‍ దిమక్‍బోలిన్‍ యోగ్యుల్‍హుయుతెకరి మరతొడి మేబి తుమ్నా గూర్చి ఖఛ్చింతి నమ్ముకురుస్‍. <verse eid="ROM 15:14"/><verse number="15" style="v" sid="ROM 15:15"/>హుయుతొ అన్యజానబొ కరి అర్పణ పరిసుద్ధాత్మటేకె ప్రీతిహువాతిమ్‍, మే సువార్త విషయంహుయిన్‍ యాజక ధర్మం హుయిన్‍, దేవ్తి మన అనుగ్రహింపబడిన్‍ కృపను బట్టి, <verse eid="ROM 15:15"/><verse number="16" style="v" sid="ROM 15:16"/>సానటేకె అన్యజనాభోనా అర్పణ పరిసుద్థాత్మహాఃజె పవిత్రహుయిన్‍, దేవ్నా ఇష్టమ్‍హువతిమ్‍, మే సువార్త విషయమ్‍మా యాజక ధర్మమ్‍ కర్తహుయిన్‍, దేవ్ను మన అనుగ్రహించుతే కృపటేకె అన్యజనాభోవాలనా యేసుక్రీస్తు సేవకుడ్‍హుయిన్‍ ఛావు. <verse eid="ROM 15:16"/><verse number="17" style="v" sid="ROM 15:17"/>హువామా, క్రీస్తుయేసునాబట్టి దేవ్ను సేవ విషయంహుయిన్‍ సంగతుల్‍మా మన గర్వంకారణం ఛా. <verse eid="ROM 15:17"/><verse number="18" style="v" sid="ROM 15:18"/>కింకతొ అన్యజనాభో విధేయులుహువాతిమ్‍, వాక్యంతి, క్రియతి, సాబుత్‍ థాకత్‍తి, బోలుకరూస్‍, <verse eid="ROM 15:18"/><verse number="19" style="v" sid="ROM 15:19"/>అద్బుతాల్‍తి, పరిసుద్ధాత్మ థాకత్‍తి క్రీస్తు మరేతి ఎంచిన్‍ ఇన గూర్చిను పన్కి అజు ఇన గూర్చిబి వాత్‍బొలనా తెగించ్యొ. అనటేకే యెరూషలేమ్‍తూ ధరీన్‍ ఆజు బాజుమాఛాతే దేఖ్‍, ఇల్లూరితొడి క్రీస్తు సువార్తనా పూర్తితీ ప్రచార్‍కర్‍రాక్యోస్‍. <verse eid="ROM 15:19"/><verse number="20" style="v" sid="ROM 15:20"/>మేహుయుతొ అజేక్ను పునాదిఫర్‍ నాబ్హాద్‍నుకరి క్రీస్తు నామ్ మాలంకొయింతెజొగొ సువార్తన ప్రచార్ కరి గ్హాను ఆఖ్‍తి ఇమ్‍ ప్రకటించో,<verse eid="ROM 15:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ROM 15:21"/>లిఖ్కుతిమ్‍ ప్రకారం</para>
  <para style="q2" vid="ROM 15:21">క్రీస్తునా బారెమా సమాచరం మాలంకొయినికి ఇవ్నా ఇవ్నే దేఖ్యా.</para>
  <para style="q2" vid="ROM 15:21">కోన్‍ హఃమ్జ్యూ కొయినికి ఇవ్నే మాలంకర్చె.<verse eid="ROM 15:21"/></para>
  <para style="s">పౌల్‍ రోమవాలనా మలను</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22"/>ఆ కారణంతి తుమరకానా అవకొయినితిమ్‍ మన కెత్రుకి చోట్‍ పర్యాయలు ఆఢు హుయు. <verse eid="ROM 15:22"/><verse number="23" style="v" sid="ROM 15:23"/>హంకేహుయుతొ ఆ జోగొ మేహంకె సంచరింపనుకరి భాగ్‍ కొయిని పన్కి, కెత్రుకి వారఖ్‍ కంతు తుమరకాన అవ్నుకరి ఘాను అపేక్చకలిగిన్‍ ఛావు, <verse eid="ROM 15:23"/><verse number="24" style="v" sid="ROM 15:24"/>మే స్పెయిను దేఖాక్నా గాయితొ వాట్‍మా తుమ్నా ద్యెకిన్‍, అగాడి తుమరు మాలనాటేకె తొడుతొడి ఖుషివొనొకరి, తుమరెతి ఎగ్జా బొలిమొకులునుకరి ఆఖ్‍తి రాస్‍. <verse eid="ROM 15:24"/><verse number="25" style="v" sid="ROM 15:25"/>హుయుతొ హంకె దేవ్ను అద్మియే సేవా కర్తహుయిన్‍ యెరూషలేమ్‍నా జొమ్కురాస్‍. <verse eid="ROM 15:25"/><verse number="26" style="v" sid="ROM 15:26"/>కింకతొ యెరూషలేమ్‍మా ఛాతె దేవ్ను అద్మియేనా గారిబ్‍హుయుతె ఇవ్నే నిమిత్తం మాసిదోనియవాలబి అకయవాలాబి తొడు పైసా దేనుకరి ఇష్టంహుయూ. <verse eid="ROM 15:26"/><verse number="27" style="v" sid="ROM 15:27"/>ఓ ఇవ్నేఇష్టపడ్యె ఇనా కరిన్‍; ఇవ్నే ఇవేనా రుణపడిన్‍; కింకతొ అన్యజనాభోనా తప్ప ఇవ్నే ఆత్మ సంబంహుయుతె ఆషీర్వాదంనా విషయంమా భాగ్‍వాలహుయిన్‍ ఛా పన్కి ఆంగ్తాను సంబంధ హుయుతె విషయంమా ఆవ్నే <verse eid="ROM 15:27"/><verse number="28" style="v" sid="ROM 15:28"/>ఆ కామ్‍ పూర్తికరిన్‍ ఆ ఫలంనా ఇవ్నేఅప్పగిమ్చిన్‍, మే తుమ్నా మలిన్‍, స్పెయిన్‍తొడి ప్రయాణంనా కరీస్‍. <verse eid="ROM 15:28"/><verse number="29" style="v" sid="ROM 15:29"/>మే తురకనా అయోతెదె, క్రీస్తును ఘాను ఆషీర్వాదమ్తీ ఆయిస్‍కరి మన మాలం.<verse eid="ROM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30"/>భైయ్యె, భేనె మారటేకె దేవ్నా కార్‍యుతె ప్రార్థనామ మరకెడె మలిన్‍ లడ్డాయికార్‍నుకరి, అప్ను ప్రభువుహుయుతె యేసు క్రీస్తునా బట్టి, ఆత్మనటేకె ఫ్యార్‍ను బట్టి తుమ్నా పొఖాలవుకురుస్‍. <verse eid="ROM 15:30"/><verse number="31" style="v" sid="ROM 15:31"/>మే యూదయమా ఛాతె ఆవిష్వాస్‍నా హత్‍ కంతు చుఖ్కాయ్‍ జానుకరి ప్రార్థన కర్యొ, బుజు యెరూషలేమ్‍మా కారనుఛాతె ఆ సేవ దేవ్ను అద్మియేనా హఃమ్జనుతిమ్‍. <verse eid="ROM 15:31"/><verse number="32" style="v" sid="ROM 15:32"/>ఆజు మే దేవ్ను చిత్తంటేకె ఖుషితి తుమరకానా అయిన్‍, తుమరెతి మలిన్‍ అరామ్‍ పొందాయో, <verse eid="ROM 15:32"/><verse number="33" style="v" sid="ROM 15:33"/>షాంతిసమాధాన కర్తహుయోతె దేవ్నాతుమరక్హారన తొడుహుయిన్‍ పన్కి. ఆమేన్‍.<verse eid="ROM 15:33"/></para>
  <chapter eid="ROM 15"/>
  <chapter number="16" style="c" sid="ROM 16"/>
  <para style="s">ప్రత్యేకం హుయితే హఃలామ్‍</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1"/>మే ఫీబే కరి అప్ను భేన్‍ హుయితె, కెంక్రేయమాఛాతె సంఘనా ప్రచార్‍కరవాలి హుయిన్‍ ఛా <verse eid="ROM 16:1"/><verse number="2" style="v" sid="ROM 16:2"/>ఇనా తుమరటేకె హోనుతె కెవుబి ఛాతెబారేమ సహాయం కార్‍నుకరి యోబాయికొ గూర్చి తుమ్నా సిఫారస్‍ కరూకరాస్‍ యో మనా బుజు గ్హను అద్మినా సహాయం కరి.<verse eid="ROM 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3"/>క్రీస్తుయేసుమా మారు భేన్‍ హుయితే అకులకునా ప్రిస్కిల్లనా మారు హఃలామ్‍ కరి బొలొ. <verse eid="ROM 16:3"/><verse number="4" style="v" sid="ROM 16:4"/>ఇవ్నే మారటేకెస్‍ కాహే యెజ్గా ఛాతె సంఘం హాఃరనాటేకె జాన్‍ దెవ్వావనటేకె ఇవ్నే తెగిమ్చా. అజు ఇవ్ను గేర్‍ సంఘమ్‍నా క్హాలమ్‍ బోలొ, మేస్‍ కాహే అన్యజనాభోమా సంఘమ్‍క్హార్‍నా ఆవ్నాభాన్నే కృతజ్ఞలుహుయిరాస్‍. <verse eid="ROM 16:4"/><verse number="5" style="v" sid="ROM 16:5"/>అజు ఇవ్ను ఘర్మా మలీన్‍ ఛా సంఘంనా హఃలమ్‍. ఆసియామా అగాడి క్రీస్తునా విష్వాసించొతె మారొ లాఢ్‍హుయోతె ఎపైనెటుకు ఖాలామ్‍. <verse eid="ROM 16:5"/><verse number="6" style="v" sid="ROM 16:6"/>తుమరటేకె గ్హాను ప్రయాసపడిన్‍ అజుతుమ్‍నా మరియనా హఃలమ్‍. <verse eid="ROM 16:6"/><verse number="7" style="v" sid="ROM 16:7"/>మన మయామాత్ర మరు తొడు ఖైదీల్‍నా ఆంద్రొనీయనా ఖాలమ్‍, యూనీయనబి ఖాలమ్‍; అవ్నే అపోస్తలుమా నామ్‍ పొందినవాలా, మరుకంటె అగాడి క్రీస్తుమా విష్వాస్‍కర్యుతె ఇవ్నే.<verse eid="ROM 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8"/>ప్రభువుమా మన లాఢ్‍హుయోతె అంప్లీయతునా క్హాలమ్‍. <verse eid="ROM 16:8"/><verse number="9" style="v" sid="ROM 16:9"/>క్రీస్తుమా అప్ను జొడుకామ్‍వాలా ఊర్బానాకు మారు లాఢ్‍హుయోతె స్టాకునా ఖాలమ్‍. <verse eid="ROM 16:9"/><verse number="10" style="v" sid="ROM 16:10"/>క్రీస్తుమా యోగ్యుడ్‍ హుయోతె అపెల్లెనా హఃలమ్‍. అరిస్టొబూనా ఘేర్‍వాలనా ఖాలమ్‍. <verse eid="ROM 16:10"/><verse number="11" style="v" sid="ROM 16:11"/>మరు మయామాత్ర హెరోది యోనునా హఃలమ్‍. నార్కిస్సు ఘేర్‍వాలనా ప్రభువుమా ఇవ్నే హఃలామ్‍.<verse eid="ROM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12"/>ప్రభువుమా ప్రయాసపడు త్రుపైనాకు, త్రుఫోసాకు హఃలమ్‍. లాఢ్‍వాల పెర్సిసునా హఃలమ్‍; యో ప్రభువుమా ఘను ప్రయాసపడ్యా. <verse eid="ROM 16:12"/><verse number="13" style="v" sid="ROM 16:13"/>ప్రభువుమా ఏర్పచిరాక్యొతె రూపునా ఖాలమ్‍; ఇనా అయానబి ఖాలమ్‍; యో మనబి అయా. <verse eid="ROM 16:13"/><verse number="14" style="v" sid="ROM 16:14"/>అసుంక్రితునా, ప్లెగో, హెర్మే, పత్రొబ, హెర్మానా, ఇనామా మలిన్‍ఛాతె భైయెనా బెనేనాబి ఖాలమ్‍. <verse eid="ROM 16:14"/><verse number="15" style="v" sid="ROM 16:15"/>పిలొలొనా, యూలియాన, నేరియన, ఇను భేనెనాబి, ఒలుంపాకునా ఇవ్నేతెఛాతె పరిసుధ్ధుల్‍ హాఃరనా హఃలామ్‍.<verse eid="ROM 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 16:16"/>పవిత్రహుయుతె బుచ్చదిన్‍ ఏక్నాయేక్‍ హఃలమ్‍ కరొ. క్రీస్తుసంఘం హాఃరుబి తుమ్నా హఃలామ్‍ బోలుకురుస్‍.<verse eid="ROM 16:16"/></para>
  <para style="s">ఆఖరిను (నియమాలు)</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17"/>భైయ్యే, భేనెనా తుమే సికిలిదాతె బోధనా వ్యతిరేకంతి భేదంతి ఆటంకంనా కలిగిమ్చోతే ఇవ్నే కనిపెట్టి ర్హవొ తుమ్నా పొఖాలవుకురుస్‍. ఇవ్నేకంతు దుర్‍హువొ. <verse eid="ROM 16:17"/><verse number="18" style="v" sid="ROM 16:18"/>ఎజాత్ను వానా అప్ను ప్రభువుహుయుతె క్రీస్తునా కాహే ఇవ్నే పేట్‍నా దాసులు; ఇవ్నే హంకెతు వాత్తిగాని ఇచ్చకంటేకెతొబి నిష్కపటుల దిల్నా మోసంకార్‍సే. <verse eid="ROM 16:18"/><verse number="19" style="v" sid="ROM 16:19"/>తుమరు విధేయత క్హారనా ప్రచురంహుయు పన్కి తుమ్నాగూర్చి ఖుషితిఛావ్‍. తుమే అష్యల్ విషయంహుయిన్‍ జ్ఞానుల్‍నా, కారబ్ను విషయహుయిన్‍ నిష్కపటుహుయుతె ర్హానుకరి కోరుకురుస్‍. <verse eid="ROM 16:19"/><verse number="20" style="v" sid="ROM 16:20"/>షాంతిసమాధాన కర్తహుయుతె దేవ్నా సైతాన్‍ తుమరు గొడనాహేట్‍ కుద్హాల్వాసే. అప్ను ప్రభువుహుయుతె యేసుక్రీస్తు కృప తుమ్నా తొడహుయిన్‍ పన్కి. <verse eid="ROM 16:20"/><verse number="21" style="v" sid="ROM 16:21"/>మారు జొడుకామ్‍వాలా తిమోతి మారు మయామాత్ర‍నా లూకియ యాసోను, సోసిపత్రు కరివాలన తుమ్నా హఃలమ్‍ బోలుకరూస్‍.<verse eid="ROM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22"/>ఆ పత్రిక లిఖ్యూతె తెర్తియు కరి మే ప్రభువుమా తుమ్నా హాఃలమ్‍ కరుకరూస్‍.<verse eid="ROM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23"/>మనబి సంఘంహాఃరనా ఆతిథ్యందెవ్వాలొ గాయి తుమ్నా హఃలామ్‍ బోలుకురుస్‍, ఆ ఖాయేర్‍ ఖజానావాలొ ఎరస్తు భైయెనా క్వర్తునా తుమ్నాబి హఃలామ్‍ బోలుకురుస్‍.<verse eid="ROM 16:23"/></para>
  <para style="s">ఆఖరీను ప్రార్థనమా స్తుతి</para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 16:24"/>అప్ను ప్రభువుహుయోతె యేసుక్రీస్తు తుమ్నా తొడుహుయిన్‍ ర్హాస్ పన్కి. <verse eid="ROM 16:24"/><verse number="25" style="v" sid="ROM 16:25"/>ఆ మర్మంనా ఘను రోజ్తీ అనుసరించిఛాతె మరు సువార్త ప్రకారం కరి, యేసు క్రీస్తు గూర్చినా ప్రచార్‍నా ప్రకారంకరి, తుమ్నా సిరపరచిక్హాత్‍వాలొ. <verse eid="ROM 16:25"/><verse number="26" style="v" sid="ROM 16:26"/>సారహుయుతె అన్యజనాబ విష్వాస్‍నా విధేయులుతిమ్‍, జామనా కంతు రహస్యంతి ర్హాకిరాకిన్‍ కెదెబి ప్రత్యక్చపరచబడ్యుతె మర్మంనా, నిత్యమ్‍ దేవ్నా ఆజ్ఞప్రకారం ప్రవక్తల్‍నా లేఖనంను తీస్‍ ఇవ్నే తెలుపబడిన్‍ ఛా.<verse eid="ROM 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27"/>ఏక్‍ జ్ఞానంవాలొహుయుతె దేవ్నా, యేసు క్రీస్తు తిస్‍, కెదేబి మహిమ కలుగ్‍సే గాక. ఆమేన్‍.<verse eid="ROM 16:27"/></para>
  <chapter eid="ROM 16"/>
</usx>
