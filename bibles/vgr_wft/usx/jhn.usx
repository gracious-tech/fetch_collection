<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- VAGIRI project -Copyright World Bible Translation Center UTF-8 Version 1‏.</book>
  <para style="h">యోహాన్</para>
  <para style="toc3">యోహా</para>
  <para style="toc2">యోహా</para>
  <para style="toc1">యోహాన్ లిఖ్యొతె సువార్త</para>
  <para style="mt2">యోహాను వ్రాసిన సువార్త</para>
  <para style="mt1">యోహాన్ లిఖ్యొతె సువార్త</para>
  <para style="imt">మొదుల్ను వాతె</para>
  <para style="ip">యోహాన్ లిఖ్యొతె సువార్తమా, క్రీస్తుని బారెమా వివరించుతె చార్‍ సువార్తల్మా ఏక్‍. ఆహాఃరనా “సువార్త” కరి బోలస్‍. సువార్త కతొ “సుసమాచారమ్‍” కరి అర్థము. యేసుక్రీస్తును మరణ్‍ను మత్తయ, మార్కు, లూకా అజు యోహాన్‍ బరోభర్‍ క్రీ. ష. 90 వరహ్‍ఃమా ఆ పుస్­తక్‍ లిఖ్కిరాక్యుసేకరి బోల్యు. అనమా ఆ పుస్తకంను రఛయితా యోహాన్‍కరి స్పటంతీ మాలంకరాయుకొయుని, పన్కి ఆ పుస్­తకంమా లిఖ్కాయుతెవిధానంబి అజు యోహాన్‍ పుస్­తకాల్‍హుయూ­తె 1, 2, 3 పుస్తకాల్మా లిఖ్కాయుతెవిధానం ఎక్కస్‍నితరా ర్హావ­నా బారెమా ఆ యోహాన్‍ లిఖ్కీన్‍ రాక్యొసేకరి థోడుజణను చరిత్రావాలును బోలు­కరస్‍. యో వహఃత్‍మా అనే ఎపెస్సు నంగ­ర్‍మా ర్హయోథొ అన­టేకె ఎజ్గతూస్ ఆ లిఖ్కిన్‍ ర్హావజాయ్‍కరి చరిత్రావాలను అభిప్రాయ.</para>
  <para style="ip">ఆపుస్తకంమా యోహాన్‍ యేసూస్‍ జాన్వాలొహుయోతె దేవ్ను ఛియ్యో <char style="xt"><ref loc="JHN 20:31">20:31</ref></char> క్రీస్తు ఇను అద్మియే విష్వాస్‍కరనా నిరూపణ్‍ కరనూస్‍ ముఖ్యా ఉద్యేషంనితరా బొలాయు. ఇనూ నా­మ్మా విష్వాస్‍రాఖను బారెమా అప్నా నిత్యజాన్‍కరి, అజు ఎక్కస్‍ యూదులస్‍ కాహెతిమ్‍ యూదుల్‍ కాహెతె హాఃరవ్నాబి ఉద్దేషించిన్‍ లిఖ్కాయిన్‍ ఛా. ఆ సువార్త మిగిలితె తీన్‍ సువార్తతీబి ముఖ్యంహుయూ హుయీన్‍ ఛా. అన్మా యేసు బోల­తె ఉపమానంతీబి కర్యొ­తె సూచక క్రియల్నా గూర్చిన్ జాహఃత్‍ వివరణ్‍ దెవ్వాయు. ముఖ్యహుయూతె విషయం­మా యేసు బాప్తిస్మమ్‍ అజు జంగల్మా క్రీస్తు పరీక్చనా బారెమా ఇన్మా లిఖ్కాయ్రుకొయిని.</para>
  <para style="iot">విషయ్‍ సూచక్‍</para>
  <para style="io1">1. యోహాన్‍ సువార్త సురుహువను <char style="ior"><ref loc="JHN 1:1-18">1:1-18</ref></char></para>
  <para style="io1">2. యేసు కర్యొతె కెత్రూకిహుయూతె అద్భుతాల్నా చూచక క్రియల్నా గూర్చి <char style="ior"><ref loc="JHN 1:19-12:50">1:19–12:50</ref></char></para>
  <para style="io1">3. యేసు మరణ్‍ అజు జీవీన్‍వుట్టానూ పాసల్తి సంఘటనల్‍ గూర్చి <char style="ior"><ref loc="JHN 13:1-20:31">13:1–20:31</ref></char></para>
  <para style="io1">4. పుస్తక్‍మా ఆఖరి, అజు యేసు జీవీన్‍వుట్టానూ పాసల్‍ సంగతుల్‍ గూర్చి వివరణ్‍ కర్తూ, పుస్తక్‍ను ఉద్దేష్యం బారెమా <char style="ior"><ref loc="JHN 21:1-25">21:1-25</ref></char></para>
  <chapter number="1" style="c" sid="JHN 1"/>
  <para style="s">వాత్ ‍అద్మిన రూప్మతూ భడను</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1"/>జమాననూ అగాఢి వచన్‍ థూ, యో వచన్‍ దేవ్కన థూ, యోవచన్‍ దేవ్‍హుయిన్‍ థొ. <verse eid="JHN 1:1"/><verse number="2" style="v" sid="JHN 1:2"/>యో త్యో జమానమా దేవ్కనా థొ.<verse eid="JHN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 1:3"/>సమస్తంబీ ఇన బన్తీస్‍ హుయు. హుయీన్ ఛాతె కెహూబి యో కొయినితిమ్‍ కోహుయూని. <verse eid="JHN 1:3"/><verse number="4" style="v" sid="JHN 1:4"/>ఇనమా జీవం థూ; యో జీవమస్‍ అద్మిహాఃరనా ఉజాలుహుయిన్‍<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">మూలభాషమా అద్మియేనా అఖ్కల్‍హుయీన్‍ థూ. ఇను యోహాన్‍</char></note> థూ. <verse eid="JHN 1:4"/><verse number="5" style="v" sid="JHN 1:5"/>యోఉజాలు అంధారమా బలుకరస్‍ పన్కి, అంధారు యో ఉజాలనా గ్రహించకరకొయిని.<verse eid="JHN 1:5"/></para>
  <para style="s">బాప్తిస్మమ్‍ దేయ్తె యోహాన్ ప్రచార్‍కరను</para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6"/>దేవ్ కంతు బోలి మొక్లాయుహుయుతే ఏక్ అద్మి థూ ఇను నామ్‍ యోహాన్‍.<verse eid="JHN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 1:7"/>ఇనబారేమా హాఃరుబి విష్వసించా హాఃర్కూ యో యోఉజాలున గూర్చి బోలనటేకె సాబుత్‍నితార ర్హయో. <verse eid="JHN 1:7"/><verse number="8" style="v" sid="JHN 1:8"/>యో యోఉజాలనీతర కాహె పన్కి యోఉజాలునటేకె సాబుత్ ‍బోలనఖాజె ఇనే ఆయో.<verse eid="JHN 1:8"/></para>
  <para style="s">యేసుక్రీస్తును ఉజాళు</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 1:9"/>హాఃఛి ఉజాలు<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">మూలభాషమా; ఉజాలుకతో వచన్‍</char></note> థూ; యోములక్మా ఆవ్తూ హర్యేక్‍ అద్మియేనా బల్తూరయ్యూ.<verse eid="JHN 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10"/>వాక్యం ఆములక్మా థొ, ఆములక్‍ ఇన బారేమా హుయు. పన్కి ములక్మాఛాతె ఇవ్నే వాక్యంనా అంగీకరించాకొయినీ.<verse eid="JHN 1:10"/></para>
  <para style="s">అవిష్వాస్‍హుయతె ఛియ్యా</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 1:11"/>యో ఇను స్వంత అద్మికనా ఆయో; పన్కి ఇవ్నే ఇనా అంగీకరించాకొయినీ.<verse eid="JHN 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 1:12"/>ఇన కెత్రుకి అద్మి అంగీకరించాస్కి, కతో ఇవ్నా హఃరవ్‍నా ఇను నామ్తీ విష్వాసంరాఖవాలన దేవ్‍ను లడ్కా హువనటెకె హక్కు దిరాక్యోస్‍ <verse eid="JHN 1:12"/><verse number="13" style="v" sid="JHN 1:13"/>ఇవ్నే దేవ్ను బారెమా ప్హైదాహుయాస్‍ పన్కి, లోహితితోబి, ఆంగ్తాన్ను ఆహ్‍ఃతితోబి ప్హైదాహుయాతె కాహె. పన్కి ఇవ్నా భా దేవ్‍హుయీన్‍ ఛా.<verse eid="JHN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14"/>యో వచన్‍ అంగ్తాన్‍తి హుయీన్‍ ఛా, కృపాసత్యసంపూర్ణంతీ అప్నా ఇఛ్మా జీవిన్‍ ర్హయ్యో. భా కంతు ఆయోతే ఏక్నొఏక్‍ ఛియ్యోనూ, మహిమతర అప్నె ఇను మహిమాన దేఖ్యా.<verse eid="JHN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15"/>యోహాన్‍ ఇనబారేమా సాబుత్‍ బోల్తొహుయిన్‍ మారఫీటె ఆవ్సేతె మారెతీబి మోటొగల్డొ ఇనటెకె యో మారెతీబి అగాఢివాలొ హుయోకరీ మే బోల్యొతె యోస్‍ ఆస్కరీ గట్తి చిక్రీన్‍ బోల్యొ.<verse eid="JHN 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16"/>ఇను పరిపూర్ణ కృపమాతు అప్నెహాఃరు ఆసీర్వాద్‍మతూ ఆసీర్వాద్‍ అప్నే పొందిరాక్యస్‍.<verse eid="JHN 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 1:17"/>దేవ్‍ ధర్మషాస్త్రం మోషెనా బారెమా అనుగ్రహించబడ్యూ; పన్కి కృపబీ, హాఃఛి యేసు క్రీస్తుబారేమా హుయూ <verse eid="JHN 1:17"/><verse number="18" style="v" sid="JHN 1:18"/>కోన్బి కెదేబీ దేవ్నా దేక్యాకొయిని; భానుతర ఇను రూప్మాఛాతె, ఏక్నొయేక్‍ ఛియ్యోస్‍ ఇనగూర్చి భార్‍నాక్యో.<verse eid="JHN 1:18"/></para>
  <para style="s">బాప్తీస్మమ్‍ దేయ్తె యోహాన్‍ సందేష్‍</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19"/>బుజు యూదుల్నుమొట్టా యెరూషలేమ్‍థూ యాజకుల్‍నా, లేవీయుల్‍మా థోడుజను యోహాన్‍కన మొక్లితెదె థూ కోన్కరి? పుఛ్చావనటేకె యోబోల్యొతె సాబుత్‍ ఆస్‍.<verse eid="JHN 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20"/>ఇనటేకె యో మాలంకొయినీకరి ఒప్పిలిదు; హుఃద్‍తి “క్రీస్తు కాహేకరి” బోల్యొ.<verse eid="JHN 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21"/>తెదె ఇవ్నే బుజు థూ కోణ్, థూ ఏలియానా? కరి పుఛ్చావమా “యో కాహేకరి” బోల్యొ. థూ యోప్రవక్తనా? కరి పుఛ్చావమా యో కాహేకరి బోల్యొ.<verse eid="JHN 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22"/>అనటేకే ఇవ్నే థూ కోణ్? హమ్నా మొక్లొతె ఇవ్నా హమే జవాబ్‍దేను, అనహాఃజె తారగూర్చి థూ సాత్ బొల్లేంకరస్‍కరి ఇన పుఛ్చాయూ!<verse eid="JHN 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23"/>ఇనటేకె ఇనే ప్రవక్తాహుయూతె యెషయ<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">మూలభాషమా దే‍వ్కంతూ ఖాబర్‍ లీన్‍ ఆవాలొ</char></note> బోలొతిమ్ మే ప్రభువును వాట్‍నా హూఃదుకర్యో కరి, జాఢిమా ఖైకార్‍ బేందుకరతే ఏక్ను ఆవాజ్‍కరి ఇవ్నేతి బోల్యొ.<verse eid="JHN 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24"/>బుజు పరిసయ్యుల్‍ థోడుజాను హఃబర్‍ బోలవాలన బోలిమొక్లల్యో. <verse eid="JHN 1:24"/><verse number="25" style="v" sid="JHN 1:25"/>ఇవ్నే “థూ క్రీస్తుతోబీ, ఏలియతోబి, ప్రవక్తతోబి నాహుయోతో సానఖాజె బాప్తిస్మమ్‍నా ద్యెకరస్కరి ఇన పుఛ్చావమా”<verse eid="JHN 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26"/>ఇనటెకె యోహాన్‍ మే పానిమా బాప్తిస్మమ్‍ దెమ్‍కురుస్ పన్కి యో తుమారయిచ్మా ఛా; తుమె ఇన మాలంకర్సుకొయిని, <verse eid="JHN 1:26"/><verse number="27" style="v" sid="JHN 1:27"/>మార పీట్పాసల్‍ వలావస్‍ పన్కి, “మే ఇని చెప్లెకాడనబీ మన యోగ్యత కొయినీ” కరి ఇవ్నేతీ బోల్యొ.<verse eid="JHN 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28"/>యోహాన్ బాప్తిస్మమ్‍ దేవుంకరతే యొర్దాను నదినా పార్‍ఛాతే బేతనీయగామ్మా ఆ సంగతుల్‍ హాఃరు జరగ్యు.<verse eid="JHN 1:28"/></para>
  <para style="s">దేవ్ను మ్హేండను చెల్కు</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29"/>బుజేక్‍ధన్నే యోహాన్ ఖందే యేసు ఆవను దేఖీన్‍ హదేక్‍ ములక్ను పాప్‍నా ఢోహిలీన్‍ జవ్వాలొ దేవ్నొ మ్హేండనుచెల్కు. <verse eid="JHN 1:29"/><verse number="30" style="v" sid="JHN 1:30"/>మే కినా బారెమా వాత్‍ బోలుకరూస్కి యోస్‍ ఆ మారపీటె ఏక్ అద్మి ఆవుంకరస్‍; యో మారెతీబి ప్రముఖుడ్‍; ఇనటెకె మరేతీబి అగాఢివాలో హుయిరోస్కరి మే కినాలీన్ బోల్యొకి యోస్‍ ఆ. <verse eid="JHN 1:30"/><verse number="31" style="v" sid="JHN 1:31"/>మే ఇన మాలంకర్యొకొయినీ పన్కి, యో ఇష్రాయేల్‍నా ప్రత్యక్చాహువనటేకె మే పాణిమా బాప్తిస్మమ్ దేతొహుయిన్‍ ఆయోకరి బోల్యొ.<verse eid="JHN 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32"/>బుజు యోహాన్‍ సాబుత్‍ బోల్తొహుయిన్‍ ఆకాష్‍మతూ ఆత్మ పర్యావ్‍నీతర ఉత్రీన్‍ ఆవను దేఖీన్; ఆత్మ ఇనాఉఫ్పర్‍ ఉబ్రూగు. <verse eid="JHN 1:32"/><verse number="33" style="v" sid="JHN 1:33"/>మే ఇనా మాలంకర్యొకొయిని పన్కి, పాణిమా బాప్తీస్మం దేవనటెకె మన బోలీమోక్లోతే దేవ్‍ కినా ఉఫ్పర్‍ ఆత్మ వుత్రీన్‍ ఆవను దేకీస్కి యోస్‍ పరిసుద్ధాత్మమా బాప్తిస్మమ్‍ దేవ్వాలొకరీ మారేతి బోల్యొ. <verse eid="JHN 1:33"/><verse number="34" style="v" sid="JHN 1:34"/>మే దేఖీన్‍ “ఆస్‍ దేవ్నొ ఛియ్యోకరి” సాబుత్నా బోలుకురుస్కరి బొల్యొ.<verse eid="JHN 1:34"/></para>
  <para style="s">యేసునె పైహ్లు సిష్యుల్నా బులావను</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35"/>బుజేక్‍ధన్నె అజు యోహాన్బి ఇనా సిష్యుల్మా బేజన ఉబ్రీన్‍ ర్హావమా, <verse eid="JHN 1:35"/><verse number="36" style="v" sid="JHN 1:36"/>తెదె ఛాలుకరతే యేసు బణే దేఖీన్‍ హదేక్ దేవ్నో మ్హేండను చెల్కుకరి బోల్యొ.<verse eid="JHN 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37"/>యో బోల్యొతె వాతెవ్నా యో బేజణ సిష్యుల్‍ హాఃమ్జీన్‍ యేసునా కేడెగయా. <verse eid="JHN 1:37"/><verse number="38" style="v" sid="JHN 1:38"/>తెదె యేసు పీటెఫరీన్‍ ఇవ్నే ఇన కేడెఆవను దేఖీన్‍ తుమే సాత్‍ ధూండుకరస్కరి ఇవ్నా పుఛ్చావమా ఇవ్నే రబ్బీ<note caller="+" style="f"><char style="fr" closed="false">1:38 </char><char style="ft" closed="false">రబ్బీ కరి వాత్‍నా బోధాకుడ్‍ కరి అర్థం</char></note> తూ కెజ్గా ర్హంకరస్కరి ఇనా పుఛ్చావమా. రబ్బీ కతో బోధకుడ్‍ కరి అర్థం.<verse eid="JHN 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39"/>యేసు తెదె ఆయిన్‍ దేకో కరి యో ఇవ్నా బోలామ ఇవ్నే జైన్‍ యో ర్హయోతే జోగో దేఖ్య, తెదె బరోభర్ వ్హానె‍ ఛార్‍బజా హూయు. యో ధన్నే ఇనకన ర్హైయ్యా.<verse eid="JHN 1:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40"/>యోహాను వాత్‍ హఃమ్జీన్‍ ఇనా పీటే గయాతే ఇవ్నమా ఏక్జననూ నామ్‍ సీమోన్‍ పేతుర్నో భైహుయోతే అంద్రెయా. <verse eid="JHN 1:40"/><verse number="41" style="v" sid="JHN 1:41"/>ఇనే అగాడి ఇనొ భైహుయోతె సీమోన్‍నా దేఖీన్‍; హామే మేస్సీయాన<note caller="+" style="f"><char style="fr" closed="false">1:41 </char><char style="ft" closed="false">మేస్సియా కరి వాత్‍న అభీషక్తుడ్‍ కరి అర్థం.</char></note> మాలంకరిలిదా కరి ఇనేతి బోలిన్‍ <verse eid="JHN 1:41"/><verse number="42" style="v" sid="JHN 1:42"/>యేసుకన ఇనా బులైలీన్ ఆయో. యేసు ఇనా బణే దేకిన్‍ తూ యోహాన్‍నో ఛియ్యో హుయోతే సీమోన్‍; తూ కేఫా<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="ft" closed="false">కేఫాకరీ వాత్న ఫత్రోకరీ అర్థం.</char></note> కరీబోలైలీస్‍కరీ బోలస్‍ కేఫాకరీ వాత్‍న ఫత్రోకరీ అర్థం.<verse eid="JHN 1:42"/></para>
  <para style="s">యేసు ఫిలిప్పున నతనయేల్న బులావను</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43"/>బుజేక్‍ ధనే యేసు గలిలయమా జానుకరి ఫిలిప్పునా మాలంకరీన్‍ మారకెడె ఆవుకరీ ఇనేతి బోల్యొ. <verse eid="JHN 1:43"/><verse number="44" style="v" sid="JHN 1:44"/>ఫిలిప్పు బేత్సయిదావాలు, కతో అంద్రెయ పేతుర్‍కరీ బోలవలాన ఖాయర్మా ర్హవ్వాలో. <verse eid="JHN 1:44"/><verse number="45" style="v" sid="JHN 1:45"/>ఫిలిప్పు నతనయే‍ల్నా మాలంకరీన్‍ ధర్మషాస్త్రంమా మోషేప్‍బీ కినా బారెమా లిఖ్యుకి ప్రవక్తల్‍బి ఇన గురించి లీఖ్యా; యో నజరేయును గామ్నుహుయోతె యోషేప్‍నో ఛియ్యో యేసుకరి ఇనేతి బోల్యొ.<verse eid="JHN 1:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46"/>ఇనటెకె నతనయేలు, “నజరేతుమాతీ అష్యల్‍ను కేహుబీ అవ్సేనాకరి” ఇన పుఛ్చావమా, ఆయిన్‍ దేక్కకరి ఫిలీఫ్పు ఇనేతి బోల్యొ, <verse eid="JHN 1:46"/><verse number="47" style="v" sid="JHN 1:47"/>యేసు నతనయేలు ఇనకన అవను దేక్కీన్‍ “హదేక్‍ ఆ హాఃఛిమాస్ ఇస్రాయేల్‍వాలో ఇనామ కేహుబీ కపటం కొయినీ” కరి ఇనేతి బోల్యొ.<verse eid="JHN 1:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48"/>తూ మన కిమ్‍ మాలంకర్యొ కరి నతనయేలు ఇన పుఛ్చావమా యేసు ఫిలీఫ్పు తునా బులావనా అగాఢీస్‍ తూ యో గుల్లర్‍నుఝాడ హేట్‍ థో తెదేస్‍ మే తున దేక్యోకరీ ఇనేతి బోల్యొ.<verse eid="JHN 1:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49"/>నతనయేల్‍ “బోధకుడ్‍ తూ దేవ్‍నో ఛియ్యో ఇష్రాయేల్‍నో రాజో” కరి ఇన జవాబ్‍ బోల్యొ.<verse eid="JHN 1:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50"/>ఇనటెకె యేసు యో గుల్లర్ను ఝాడహేట్‍ తున మే దేక్యో కరి బోలామ తూ నమ్మూకరస్‍సూనా? అనేతీ గోప్ప కర్యాల్‍ దేకీస్‍ కరి ఇనేతి బోల్యొ.<verse eid="JHN 1:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 1:51"/>బుజు యేసు, “తుమే ఆకాష్‍ కోలైజావను, దేవ్నుదూతల్‍ అద్మినా ఛియ్యానా వుపర్తీ ఛడనూ, ఉత్రాను దేక్సూ” కరి తుమారేతి హాఃఛితీ బోలుకరూస్‍ కరి బోల్యొ.<verse eid="JHN 1:51"/></para>
  <chapter eid="JHN 1"/>
  <chapter number="2" style="c" sid="JHN 2"/>
  <para style="s">కనాను గాంమ్మా య్హానా యేసునా బులావను</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1"/>తీన్మను ధన్నె గలిలయమా ఛాతె కానాకరి హఃయర్మా ఏక్ య్హా హుయూ. <verse eid="JHN 2:1"/><verse number="2" style="v" sid="JHN 2:2"/>యేసుని ఆయా ఎజ్గ ర్హైతి; బుజు యేసుబి ఇను సిష్యుల్‍బీ యో య్హాన బులాయ్‍ మంగాయు.<verse eid="JHN 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 2:3"/>ద్రాక్చాను రహ్క్ హుయ్గుతెదె యేసుని ఆయా ఇవ్నా ద్రాక్చాను రహ్క్ కొయినీకరి యేసుతి బోలమా!<verse eid="JHN 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4"/>యేసు ఇనేతి ఆయా, మారేతి తున షాను కామ్‍? మారు వహాఃత్ బుజుబి కోఆయూనికరి బోల్యొ. <verse eid="JHN 2:4"/><verse number="5" style="v" sid="JHN 2:5"/>ఇని ఆయ ప్రచార్‍ కరవాలన దేఖిన్‍ యో తుమారేతి సాత్‍ బోలస్కి ఇనా కరోకరి బోలి.<verse eid="JHN 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6"/>యూదుల్‍ సుద్ధికరణు<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">యూదుల్‍ ఆచారం తింమ్‍ హాత్‍ గోడా దోవను</char></note> ఆచారం ప్రకారంతి ఛారిఖ్‍ః న్హైతొ ఖోః లీటర్‍ ధహరను ఛో పత్రాను కొట్టియేవ్నా ఎజ్గా బేందిరాక్యుతు. <verse eid="JHN 2:6"/><verse number="7" style="v" sid="JHN 2:7"/>యేసు యోబాణమా పాని భరీన్‍ మ్హేందోకరి ఇవ్నేతి బోలమా! ఇవ్నే ఇనా కనారితోడి భర్యు. <verse eid="JHN 2:7"/><verse number="8" style="v" sid="JHN 2:8"/>తెదె యో ఇవ్నేతి తుమే హంకె కొట్టియేమాతు తోడు రహ్‍ భర్లీన్ ఖాణు కంకరతే ప్రధానికనా లీన్జవోకరి బోలమా! ఇవ్నేలీన్‍ గయ్యూ. <verse eid="JHN 2:8"/><verse number="9" style="v" sid="JHN 2:9"/>యో ద్రాక్చను రహ్ కెజ్గాతూ ఆయూకి, కింమ్ బద్లూకి ప్రచార్‍ కరవాలన, యోపానీ బర్లిన్‍ లీగయుతె ఇవ్నస్‍ మాలం; పన్కి విందు ప్రధానినా మాలంకోతూని, అనటేకే ద్రాక్చాను రహ్ తోబీ యోపానినా చాఖీన్‍ దేక్యూతెదె, యోవిందు ప్రధాని నౌరోనా బులాయిన్‍ <verse eid="JHN 2:9"/><verse number="10" style="v" sid="JHN 2:10"/>హర్యేక్‍ అద్మి అగాడి అషల్ ద్రాక్చాను రహ్ నాకీన్‍ జనాబో మాత్తుమా ర్హావనీవహఃత్‍ జబ్బును రహ్క్ నాఖస్‍; తూహుయోతో హంకెతోడీ అష్యల్ ద్రాక్చను రహ్క్ రాఖిలీన్‍ ఛా కరి ఇనేతి బోల్యొ. <figure style="fig" alt="Filling water in the stone jars" file="lb00135c.tif" size="col" copy="Horace Knowles ©" ref="2:10">బాణమా పాని భరను</figure><verse eid="JHN 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11"/>యేసు గలిలయామాఛాతె కానామ ఆ మోదుల్ను సూచక క్రియల్‍నా కరీన్‍ ఇను మహిమను బయాలు పరిచీలిదో; అనటెకె ఇను సిష్యుల్‍ ఇనాఫర్‍ వీస్వాసం రాఖ్యు.<verse eid="JHN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12"/>ఇనాపాస్సల్తీ యోబీ ఇని ఆయాబీ, భై బుజు సిష్యుల్‍ మలీన్‍ కపెర్నహూమ్‍‍మా ఖాయర్‍మా జైన్‍ ఎజ్గా థోడుధన్‍ ర్హయ్యు.<verse eid="JHN 2:12"/></para>
  <para style="s">యేసు మందీర్మా జావను</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13"/>తెదె యూదుల్ను పస్కాపండగా ఖందె ఆవమా, యేసు యెరూషలేమ్మా గయో. <verse eid="JHN 2:13"/><verse number="14" style="v" sid="JHN 2:14"/>దేవ్ను ఆలయంమా ధాండొన, మ్హేంఢానా, పర్యావ్నా ఏచవాలనా పైషా బద్లావతే జోగమా ఇవ్నె బాల్లాపర్‍ బేసీన్‍రవ్వాను దేఖీన్‍ <verse eid="JHN 2:14"/><verse number="15" style="v" sid="JHN 2:15"/>ఇనటెకె డోరితీ కోల్డాతికరీన్‍ మ్హేంఢావ్నా ధాండొనా హాఃర్వనా దేవ్ను మందిర్‍మాతూ హక్లిదీన్‍ పైషా బద్లావతే ఇవ్ను పైషావ్నా ఛిడ్కిదీన్‍ ఇవ్ను బాల్లల్నా ధక్లీనాకిదీన్‍; <verse eid="JHN 2:15"/><verse number="16" style="v" sid="JHN 2:16"/>పర్యావ్నా ఏచాతే ఇవ్నేతీ ఆఖారు అజ్గాతులీన్‍ జావో! మారో “భాను ఘార్‍నా ధందోకరను బజార్నీతర నొకొ కరోకరి” గట్టింతి బోల్యొ. <verse eid="JHN 2:16"/><verse number="17" style="v" sid="JHN 2:17"/>ఓ దేవ్‍ తారు ఘర్ను గూర్చి లేఖనాల్మా ఆహ్క్ మన హఃతావుసేకరి లిఖ్కాయ్‍ రూస్‍కరి ఇను సిష్యుల్‍ హఃయాల్ ‍కర్లీదు.<verse eid="JHN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18"/>అనటెకె యూదుల్‍ తూ కేహు హాక్కుతీ ఆ కార్యయాల్‍న కరుకరస్‍కీ హమ్నా కెహూ అద్బుతంనా కరిన్‍ వాతలిన్‍ బోలిస్‍ కరి ఇనా పుఛ్చాయ.<verse eid="JHN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19"/>యేసు, “ఆ దేవ్ను మందిర్‍నా ఫోడినాక్కో తీన్‍ ధన్‍మా ఇన బ్హాందీస్‍కి” ఇవ్నేతి బోల్యొ.<verse eid="JHN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20"/>యూదుల్‍ ఆ మందిర్‍నా ఛోప్పర్‍ చాలీక్‍ వరహ్ఃమా భాంద్యాని; తూ తీన్‍ధన్మా ఇన భాధిస్‍నా? కరి పుఛ్చాయా.<verse eid="JHN 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21"/>హుయూతొ యో మందిర్‍నా గూర్చీ ఆ వాత్‍ బోల్యొకీ యో ఇను ఆంగ్‍తన్నుగుర్చీ బోల్యో. <verse eid="JHN 2:21"/><verse number="22" style="v" sid="JHN 2:22"/>తెదె యో మరణ్మతూ ఉట్టాడెతే బాద్మా యో ఆవాతే బోల్యొకరి ఇను సిష్యుల్‍ ఖాయాల్‍ కర్లీన్‍ లేఖనాల్నాబి బుజు యేసు బోల్యొతె వాత్నా నమ్యా.<verse eid="JHN 2:22"/></para>
  <para style="s">యేసు దిల్నుఅంతరమునా మాలంకరవాళొ</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23"/>యో పస్కా పండగాన వఖాత్‍ యేరుషలేమ్మా ర్హావమా; యో పండగామా కెత్రూకిజణు యో కర్యోతె అద్బుతల్నా దేఖీన్‍ ఇనపర్‍ వీష్వాస్‍ రాఖ్యూ. <verse eid="JHN 2:23"/><verse number="24" style="v" sid="JHN 2:24"/>పన్కి యేసు ఖారవ్న మాలం కర్యోహొయో. అనటెకె యో ఇవ్నా సంపూర్ణంతి నమ్యకోయిని. <verse eid="JHN 2:24"/><verse number="25" style="v" sid="JHN 2:25"/>యో అద్మీను దిల్మానాబి మాలం కరవాలో, అనటెకె కోన్బీ అద్మినా గూర్చి ఇనఫర్‍ సాబుత్‍ బొలాను జరూరత్‍కోయిని.<verse eid="JHN 2:25"/></para>
  <chapter eid="JHN 2"/>
  <chapter number="3" style="c" sid="JHN 3"/>
  <para style="s">యేసు బుజు నికోదేమ్నుతి వాతె బోలను</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1"/>యూదుల్ను అధికారిహుయోతె నీకొదెమ్కరి పరిసయ్యకుడ్‍ ఏక్జనొ థో. <verse eid="JHN 3:1"/><verse number="2" style="v" sid="JHN 3:2"/>ఇనె ఏక్‍ రాత్ యేసుకనా ఆయిన్‍ బోధకుడ్, తూ దేవ్‍కంతొ ఆయోతె బోధకుడ్‍ కరి హమ్నామాలం; దేవ్ ‍ఇన జొడ్మా రయ్యోతోస్ తప్ప థూ కరుకరతె అద్భుతాల్నా కోన్బీ కర్చెకొయినీకరి ఇనేతి బోల్యొ.<verse eid="JHN 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3"/>అనటెకె యేసు ఇవ్నేతీ బోల్యొ ఏక్జనో నవో పైదాహుయోతోస్‍ పన్కి ఇనే దేవ్ను రాజ్యంనా దేక్చేకొయినీకరి కరి తుమారితి హాఃఛితి బోలుకరుస్.<verse eid="JHN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4"/>అనటెకె నీకొదెమ్‍ బుడోహుయోతె అద్మికింమ్‍ పైయిదా హూసే? బెంమ్మను ఛోట్‍ ఆయాను పేట్మాపేషిన్‍ పైదాకర్నునా కరి ఇనా పుఛ్చావమా!<verse eid="JHN 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5"/>యేసు అమ్ బోల్యొ ఏక్జనొ పానీనూ బారేమాతోబీ, ఆత్మానబారేమాతోబి, పైదాహుయోతో పన్కి, యో దేవ్నీ రాజ్మంమా జాసెకొయినీకరి తుమారేతి హాఃఛితి బోలుకరూస్‍ <verse eid="JHN 3:5"/><verse number="6" style="v" sid="JHN 3:6"/>ఆంగ్తాన్‍ బారేమా పైదాహుయోతె ఆంగ్తాన్‍తీస్‍ ఆత్మను బారేమా పైదాహుయోతె ఆత్మాహుయిన్ ఛా! <verse eid="JHN 3:6"/><verse number="7" style="v" sid="JHN 3:7"/>తుమే నవూ పైదాహూనుకరి మే తుమారేతి బోల్యొకరి, అష్యంనొకొహువో. <verse eid="JHN 3:7"/><verse number="8" style="v" sid="JHN 3:8"/>వ్యారో ఇన ఇష్టంహుయుజొగొమా వాగస్‍; తూ ఇను ఆవాజ్ హఃజీస్‍ పన్కి, యో కెజ్గాతూ నికీన్‍ ఆవస్కి, కెజ్గాజాస్కి, తూన మాలంకొయినీ ఆత్మమూలంమా పైదాహుయోతె హర్యేక్‍జనూ ఇమ్మాస్‍ ఛా కరి బోల్యొ.<verse eid="JHN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9"/>అనటేకే నీకొదెమ్‍ ఆసంగతుల్‍ కింమ్‍ సాధ్యం కరి ఇనేతి పుఛ్చావమా!<verse eid="JHN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10"/>యేసు అమ్ బోల్యొ, తూ ఇష్రాయేల్‍నా బోధకుడ్‍ రహిన్బీ అన మాలంకరకొయిన్నా <verse eid="JHN 3:10"/><verse number="11" style="v" sid="JHN 3:11"/>హుయ్తోబి హమే మాలంకర్యా సంగతుల్నా బోలుకరూస్‍ దేఖ్యతె ఇనస్ హాఃఛి బోలుకరూస్‍ హమారు హాఃచీన తుమే ఒప్చుకొయినీకరీ, తుమారేతి హాఃచీతి బోలుకరూస్‍ <verse eid="JHN 3:11"/><verse number="12" style="v" sid="JHN 3:12"/>జమీన్‍ సంబంధహుయు సంగతుల్‍నా, మే తుమారేతీ బోల్యొతొ తెదె నమ్యకొయినీ, స్వర్గంను సంబంధంహుయు తుమారేతీ బోల్యొ తెదె కింమ్‍ నమ్సూ?<verse eid="JHN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 3:13"/>బుజు స్వర్గంమతూ ఉత్రీన్‍ ఆయోహుయోస్‍ కతో స్వర్గంమా ఛాతె అద్మినఛియ్యోన తప్ప స్వర్గంమా చఢీన్‍గయోహుయో కోన్బీ కొయినీ.<verse eid="JHN 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14"/>జాఢిమా మోషే హాఃప్‍నా కింమ్‍ పాడ్యోకి; <verse eid="JHN 3:14"/><verse number="15" style="v" sid="JHN 3:15"/>ఇమ్మస్‍ విష్వాస్‍రాకవాలో హర్యేక్‍జనూ మట్సేకొయినీతిమ్‍ ఇను బరేమా నిత్యజీవంనా లేవకర్కూ అద్మినఛియ్యో ఉట్టాడనుఛా. <verse eid="JHN 3:15"/><verse number="16" style="v" sid="JHN 3:16"/>దేవ్ ఆ ములక్నా కెత్రూకి ఫ్యార్‍కర్యో, ఇనటెకె యో ఇను ఏక్నాఏక్‍ ఛియ్యోని గోణి ప్హైయిదాహుయుతె ఇనపార్‍ విష్వాసం రఖావాలు హార్యేజను నాషనం నాహోనుకరి, ఇవ్నే నిత్యజీవుణు మల్ను కరి ఇనా అనుగ్రహించి రాక్యొస్‍ <verse eid="JHN 3:16"/><verse number="17" style="v" sid="JHN 3:17"/>ములాక్నా రక్చణమాలనటేకె ఇన ఛియ్యాన బొలిమోక్లొ పన్కి, ములాక్నా షిక్చిచానటెకె దేవ్‍ ఇనా కొబోలిమోక్లొయిని.<verse eid="JHN 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18"/>ఇనాపర్‍ వీష్వాసం రాహాఃవలాన న్యావ్‍ తీర్చేకొయిని; దేవ్ని ఏక్నా ఏక్ ఛియ్యాన, నామ్‍పర్‍ విష్వాసం రాక్యుకొయినితే, ఇవ్నా అన అగాఢీస్‍ న్యావ్‍ తీ ర్చిబడ్సే <verse eid="JHN 3:18"/><verse number="19" style="v" sid="JHN 3:19"/>దేవ్‍ బోల్యొతే న్యావ్‍ ఆస్‍; ఉజాలు ములక్మా ఆయూ పన్కి ఇవ్ను కామ్‍ ఖారబ్‍ హువమా, అద్మియే ఉజాలనా ఫ్యార్‍కరకోయిన్తిం అంధరనాస్‍ ఫ్యార్‍కర్యు. <verse eid="JHN 3:19"/><verse number="20" style="v" sid="JHN 3:20"/>గలత్‍ కామ్‍ కరతే హర్యేజను ఉజాలాన ద్వేసించుకరస్‍ ఇను క్రియల్‍ దుష్‍క్రియాల్‍ నితర దేఖావకోయినితిమ్‍ ఉజాలుకన ఆవకోయిని. <verse eid="JHN 3:20"/><verse number="21" style="v" sid="JHN 3:21"/>పన్కీ హాఃఛివాలో హుయోతే ఇను క్రియల్ దేవ్నీ బరేమా కరిర్యాకొస్‍ కరి ప్రత్యక్చబడ్నుతీమ్‍ ఉజాలుకనా ఆవ్సే.<verse eid="JHN 3:21"/></para>
  <para style="s">బాప్తిస్మమ్‍ దేయ్తె యోహాన్ను ఆఖరీను సాబుత్‍</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22"/>ఇనపాస్సల్‍ యేసు ఇన సిష్యుల్‍తీ కెడే యూదయను దేఖ్‍మా ఆయిన్‍ ఎజ్గా ఇవ్నేతి థోడుధన్‍ ర్హాతు బాప్తిస్మమ్‍ దేతోహుయిన్‍ ర్హయో. <verse eid="JHN 3:22"/><verse number="23" style="v" sid="JHN 3:23"/>సలీమ్నా ఖందెఛాతె ఐనోనుకరి జొగోమ పాణి భరైన్‍ థూ. అనహాఃజె యోహన్‍బి ఎజ్గా బాప్తిస్మమ్‍ దేతొహుయీన్‍ ర్హయ్యో, అద్మిఖారు ఆయిన్‍ బాప్తిస్మమ్‍ లీదు. <verse eid="JHN 3:23"/><verse number="24" style="v" sid="JHN 3:24"/>యోహాన్న బుజుబీ ఠాణమా బంది కోకర్యుని. ఇన అగాడి జార్యగుతే సంగాతుల్‍<verse eid="JHN 3:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25"/>సుద్ధికరణ ఆచారంను గూర్చి యోహాన్‍ సిష్యుల్నా ఏక్‍ యూదుడ్‍తీ లఢైయి హుయు. <verse eid="JHN 3:25"/><verse number="26" style="v" sid="JHN 3:26"/>అనహఃజే ఇవ్నే యోహన్‍కన ఆయిన్‍ బోధకుడ్‍ ఏక్జనో యొర్దాను నది పార్లీబాజు తారేతి ర్హాయోకి, తూ కిన బారెమా సాబుత్‍ బోల్యొతోకి హదేక్‍ యో బాప్తిస్మమ్‍ ద్యేకరస్‍ హాఃరు ఇనకన ఆంకరస్కరి ఇనేతి బోల్యొ.<verse eid="JHN 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27"/>అనటేకె యోహాన్ అమ్‍ బోల్యొ, ఇన దేవ్‍ కంతు దేవాయిరాక్యుతోస్‍ పన్కి కోన్బీ సాత్‍బీ పోంద్సేకోయిని. <verse eid="JHN 3:27"/><verse number="28" style="v" sid="JHN 3:28"/>మే క్రీస్తు కాహేకరీ, ఇనేతీబి అగాడి బోలిమోక్లోహుయోస్‍ కరి బొలాయుతిమ్‍ తుమేస్‍ మన జామిన్‍దారి. <verse eid="JHN 3:28"/><verse number="29" style="v" sid="JHN 3:29"/>య్హాను నౌరిహో, య్హాను నౌరోహో హుయితో ఉబ్రీన్ యో య్హాను నౌరోను, ఆవజ్‍ ఖంజీన్‍ దోస్థ్ కెత్రూకి ఖూషిహుసేకి, ఇమ్మాస్ ఆ మారు ఖూసాల్‍ పరిపూర్ణంహుయిరుస్‍. <verse eid="JHN 3:29"/><verse number="30" style="v" sid="JHN 3:30"/>యో హెచ్చిలిన్ రవ్వను ఛా; మే కామ్‍ కర్లేవాను ఛా.<verse eid="JHN 3:30"/></para>
  <para style="s">ఆస్‍ స్వర్గంమతూ ఆయోతె</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31"/>ఉప్పర్‍తో ఆవ్వలో హాఃర్వనా ఉపార్‍ రవ్వలో, జమీన్‍తూ నీకిన్‍ అవ్వలో జమీన్‍సంబంధి హుయిన్ ‍ఛా, జమీన్‍న చెందీహుయు సంగతుల్‍నా గుర్చి వాతె బోల్యొ, స్వర్గంతూ అవ్వలో హాఃర్వతీ ఉపార్‍ ర్హైన్‍ <verse eid="JHN 3:31"/><verse number="32" style="v" sid="JHN 3:32"/>ఇనే దేఖ్యూతే ఇనా గుర్చి ఖాంజూతే ఇనగుర్చి ఖాబర్‍ బోల్సే పన్కి ఇనా బోదానా కోన్బీ ఇను సాబుత్నా ఓప్సేకోయినీ. <verse eid="JHN 3:32"/><verse number="33" style="v" sid="JHN 3:33"/>ఇను హాఃఛినా ఓప్పవాలో దేవ్‍ హాఃచెలోకరి నిరూపించుకురాస్‍. <verse eid="JHN 3:33"/><verse number="34" style="v" sid="JHN 3:34"/>కింకతో దేవ్‍ యో మోక్లొతె ఇనా కొలతకోయినీతిమ్‍ పవిత్రా ఆత్మనా దిసే అనటెకె యో దేవ్ని వాతెనాస్‍ బోల్సే. <verse eid="JHN 3:34"/><verse number="35" style="v" sid="JHN 3:35"/>భా ఛియ్యోనా ఫ్యార్‍కరుకరాస్‍ ఇనాఖాజే ఇనా హాత్మా సమస్తమ్‍ దేవాయిర్హాకోస్‍ <verse eid="JHN 3:35"/><verse number="36" style="v" sid="JHN 3:36"/>ఛియ్యోనా ఖామే విష్వాస్‍ కరవాలోస్‍ నిత్యంజీవమ్‍ రవ్వలొ; ఛియ్యోను విధేయుడ్ తార రవ్వకోయింతెవాలొ జీవమ్‍ దేక్చెకొయిని పన్కి, దేవ్ను ఛండాల్‍ ఇనఫర్‍ వుబ్రీన్‍రాసే.<verse eid="JHN 3:36"/></para>
  <chapter eid="JHN 3"/>
  <chapter number="4" style="c" sid="JHN 4"/>
  <para style="s">యేసు బుజు సమరయ బాయికొ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1"/>యోహాన్‍తీబి యేసు ఘాణు అద్మియేనా సిష్యుల్‍నీతర కర్లీన్‍ ఇవ్నా బాప్తిస్మమ్‍ దేవుంకరతె సంగతి పరిసయ్యుల్‍ మాలంహుయుతెదె. <verse eid="JHN 4:1"/><verse number="2" style="v" sid="JHN 4:2"/>హుయుతోబి యేసు బాప్తిస్మమ్ కోదిదోని పన్కి ఇన సిష్యుల్‍ దేవుంకర్తూ థూ. <verse eid="JHN 4:2"/><verse number="3" style="v" sid="JHN 4:3"/>ఇజ్గా ఇవ్నేవాతె బోల్యొతె యేసు హఃజీన్‍ యూదయా దేహ్కానా బెందీన్‍ గలిలయ దేహ్ఃమా ఫరీన్‍ గయో. <verse eid="JHN 4:3"/><verse number="4" style="v" sid="JHN 4:4"/>యో సమరయా హఃయర్‍ మారగ్‍పర్తూ జానుపడ్యు.<verse eid="JHN 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5"/>ఇనటేకె యాకోబ్‍ ఇనో ఛియ్యోహుయోతె యోషేపునాదదోతె జమీన్‍ ఖందెఛ్చాతె సమరయ దేహ్ః సుఖారుకరీ గాంమా ఆయ. <verse eid="JHN 4:5"/><verse number="6" style="v" sid="JHN 4:6"/>ఎజ్గా యాకోబ్ను బావ్డి థూ; ఇనటేకె యేసు ప్రయాణమ్ కరిన్ థాకీజావమా యో బావ్డీకన బేసీన్‍థో తెదె బరోబ్బర్‍ భారబజీరా థూ.<verse eid="JHN 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7"/>తెదె సమరయా హుయితె ఏక్‍ బాయికో ఏక్జని పాణి సెందిలేవనటేకె ఎజ్గా ఆయి. యేసు బోల్యొ, “మన తర‍హ్ః లాగుకరస్‍ పీయానా పాణి దా! కరి యోబాయికోన పుఛ్చాయో” <verse eid="JHN 4:7"/><verse number="8" style="v" sid="JHN 4:8"/>ఇన‍ సిష్యుల్‍ ఖాణు మోల్‍లావనటేకె హాఃయర్‍మా జైన్‍ థా.<verse eid="JHN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9"/>యో సమరయా బాయికో, యూదుడ్‍ హుయోతె తూ సమరయాహుయితె బాయికో మన పాణి దా! కరి కిమ్‍ పుఛ్చాంకరస్‍కరి ఇనేతి బోలి. కిమ్కతో యూదుల్‍ సమరయుల్తీ కెజాత్నూబి సంబంధం కోకరని.<verse eid="JHN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10"/>అనటెకె యేసు బోల్యొ, తూ దేవ్ను వరంనా, “మన తరాహ్ః తోడ్‍కరీ మాంగుకరతె యోకోన్కి యోబి తున మాలంర్హైయితొ తూ ఇనా పుఛ్చాయిస్, యో తున జీవజల్‍ దిసేకరీ” యో బాయికోతి బోల్యొ.<verse eid="JHN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11"/>తెదె యో బాయికో మాలిక్‍ ఆ బావ్డీ జాహఃత్‍ లోత్మా ఛా సెందీలేవనటెకె తారకనా కాయిబీకోయిన్నీ; యో జీవజాలం కిమ్‍ తునా మల్సే? <verse eid="JHN 4:11"/><verse number="12" style="v" sid="JHN 4:12"/>హమారొ జమాననూ భానొ భాహుయోతే యాకోబ్‍ ఇనా లడ్కావ్నా, ధండా బుజు బోక్డానా మందోనబి, ఆ బావ్డీను పాణి పీన్‍ హమ్నాదిదో. ఇనేతీబి తూ గొప్పవాలోసూ? కరి ఇనా పుఛ్చాయి.<verse eid="JHN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13"/>ఇనటెకె యేసు బోల్యొ, ఆ పాని పీయవాలు హర్యేక్‍జణు బుజేక్‍తార తారఖ్‍ః లాగ్సే. <verse eid="JHN 4:13"/><verse number="14" style="v" sid="JHN 4:14"/>పన్కి “మే దిదోతె పాణి పియవాలు ఇనకెదేబి తరహ్ః లాగ్సేకొయిని. మే ఇన దేవుంతెపాణి నిత్య జీవంనటేకెస్‍ నిత్యం ఇన్మాపొంగీ పాణిను బుగ్గనితరా ర్హాసేకరి” యో బాయికోతి బోల్యొ. <verse eid="JHN 4:14"/><verse number="15" style="v" sid="JHN 4:15"/>యో బాయికో ఇనా దేఖీన్‍ “మాలిక్ మన తరహ్ః నాలాగ హఃర్కు సెందానటేకె అత్రుదూర్‍ నాఆవునుతీమ్‍ యోపాని మన దయాకర్కరీ” పుఛ్చాయి. <verse eid="JHN 4:15"/><verse number="16" style="v" sid="JHN 4:16"/>తెదె యేసు, “తూ జైన్‍ తార బావ్రినా బులైలీన్‍ అజ్గ పాచు ఆవ్కరీ” యో బాయికోతి బోల్యొ. <verse eid="JHN 4:16"/><verse number="17" style="v" sid="JHN 4:17"/>యో బాయికో, “మన బావ్రీ కోయిని కరి బోలమా” యేసు యో బాయికోతి, బావ్రీ కొయినికరి బోలితె వాత్‍తో హాఃఛీస్‍; <verse eid="JHN 4:17"/><verse number="18" style="v" sid="JHN 4:18"/>తునా పాచ్‍జన బావ్రీ థా, హంకే ఛాతే యో తారో భావ్రి కాహే “తూ ఆ ఖబర్‍ హాఃఛితీ బోల్యొకరి బోల్యొ”<verse eid="JHN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19"/>తెదె యో బాయికో, మాలిక్‍ తూ ప్రవక్తకరి మే గ్రహీంచుకరూస్‍ <verse eid="JHN 4:19"/><verse number="20" style="v" sid="JHN 4:20"/>హమరా పుర్వికుల్‍ ఆ పహాడ్‍నా ఆరాధించా పన్కి, ఆరాధనకరను జొగొ యేరుషలేంమా ఛాకరీ, తూమే బోలుసుకరి ఇనేతి కాతో యేసు బాయికోతి బోలమా.<verse eid="JHN 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21"/>యేసు యో బాయికోతి అమ్‍ బోల్యొ ఆయా! ఏక్ వఖాత్‍ ఆవుంకరస్‍ యోధన్మా ఆ పహాడ్నావుపర్‍హో, యెరుషలేమ్‍మాహో తుమే భాన కోఆరాధించుని మారు వాత్నా నమ్‍ <verse eid="JHN 4:21"/><verse number="22" style="v" sid="JHN 4:22"/>సమరయుల్‍ హుయితె తుమే మాలంకోయింతె ఇనా ఆరాధించావాల; యూదుల్‍ హుయుతే హామేకోన్కి మాలంహుయూ ఆరాధించియేస్‍; బఛ్చాడను యూదుల్‍మాతూస్‍ కలుగుకరస్‍. <verse eid="JHN 4:22"/><verse number="23" style="v" sid="JHN 4:23"/>అజు యధార్థంతీ ఆరాధించవాల దేవ్ను ఆత్మతీబి హాఃఛితీబి భాన ఆరాధనకరను ధన్‍ ఆవుంకరస్‍; యో హంకేబి ఆయ్రూస్‍ ఇన ఆరాధించవాలు ఎజాత్నుస్‍ హోనుకరీ భా కొరిలెంకొరాస్‍. <verse eid="JHN 4:23"/><verse number="24" style="v" sid="JHN 4:24"/>దేవ్‍ ఆత్మ హుయ్రోస్‍ అనటేకె ఇనా ఆరాధించవాల ఆత్మతీబి హాఃఛితీబి ఆరాధన కర్నూకరి బోల్యొ.<verse eid="JHN 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25"/>తెదె యో బాయికొ ఇనేతి, క్రీస్తు బోలావతే మేస్సియ ఆవుంకరస్ కరి మన మాలం, యో ఆయోతెదె హమ్నా సమస్తంనా మాలంకరావ్సే కరి బోలి.<verse eid="JHN 4:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26"/>తెదే యేసు, “తారేతీ వాతే బోలుకరతే మేస్‍ యోకరీ” బోల్యొ.<verse eid="JHN 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27"/>ఎత్రాస్‍మా ఇనా సిష్యుల్‍ ఆయిన్‍ యేసు యో బాయికోతి వాతెబోలాను దేఖీన్, హాష్యంహుయిగు పన్కి, తునా సాత్‍హోనుకతోబి, ఆ బాయికోతీ షాన వాతేబోలుకరస్‍కరీ కోన్బి కోపుచ్ఛాయుని.<verse eid="JHN 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28"/>యో బాయికో ఇను కుండు బేందీన్‍ గమ్మా జైన్‍ యో పట్టానంవాలతీ బోలి. <verse eid="JHN 4:28"/><verse number="29" style="v" sid="JHN 4:29"/>తుమే ఆయిన్‍ మే కర్యుతే హాఃరుబీ మరేతి బోలుతే అద్మినా దేఖో; యో మెస్సీయా కాహేనా<verse eid="JHN 4:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 4:30"/>ఇవ్నే పట్టనం మాతు నిఖీన్‍ యేసుకన గయూ.<verse eid="JHN 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31"/>తెప్తోడి సిష్యుల్‍ బోధకుడ్‍ దాన్‍ ఖాకరి ఇనా బాతిమాలీదా. <verse eid="JHN 4:31"/><verse number="32" style="v" sid="JHN 4:32"/>ఇనటెకె యేసు, ఖావనటెకె తుమ్నా మాలంకోయినీతె ఆహారం మరకన ఛా, కరి ఇవ్నేతి బోలమా.<verse eid="JHN 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33"/>తెదే సిష్యుల్‍ ఇన ఖావనటెకె కోన్బి సాత్బి లాయుసుకి? కరి ఏక్నుఏక్‍ బొల్లిదూ.<verse eid="JHN 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34"/>యేసు ఇవ్నా దేఖీన్‍ మన బోలిమోక్లోతె ఇనే చిత్తననెరవేర్చాను, ఇను కామ్‍ పూర్తికరనూస్‍ మారు ఆహరం హుయిన్‍ ఛా. <verse eid="JHN 4:34"/><verse number="35" style="v" sid="JHN 4:35"/>బుజు ఛార్ మహీనా హుయిజావదీన్ ఇనపాసల్‍ వాడనుధన్‍ ఆవ్సేకరి తుమే బోల్సుకొయిన్నా! హదేక్‍ తుమార ఢోలపాఢీన్‍ ఖేతర్నా దేకొ; యో హంకేస్ పిఖీన్‍ వాడన ఆయ్రూస్‍ కరి తుమారేతి బోలుకరూస్‍ <verse eid="JHN 4:35"/><verse number="36" style="v" sid="JHN 4:36"/>పిఖావాలుబీ వాఢవలుబీ ఖూషీహుయితిమ్‍ వాఢవలు జీతంకమైయిన్‍ నిత్యజీవార్థంను ఫలమ్‍ జమకర్లేంకరస్‍ <verse eid="JHN 4:36"/><verse number="37" style="v" sid="JHN 4:37"/>బింజోళా నాఖవాలు ఏక్జను, వాఢవాలుబీ ఏక్జను ఆ వాత్‍ హాఃఛిస్‍ <verse eid="JHN 4:37"/><verse number="38" style="v" sid="JHN 4:38"/>తుమే కినాలీన్‍ మినాత్‍ కోకరనీకి ఇన వాఢనటెకె తుమ్న బోలిమోక్లో థో, పార్లూ మినాత్‍పడ్యుతే తుమే ఇవ్నీ మినాత్‍ను ఫలంనా భాగ్‍ హువుంకరస్ కరి బోల్యొ.<verse eid="JHN 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39"/>“మే కర్యోతె ఖారుబీ మారేఖు బోల్యొకరి” సాబుత్‍దిదితే యో బాయికోను వాతేనా లీన్‍ యో పట్టనంమను సమరయుల్‍ ఘాణుజనూ ఇనఫర్‍ వీస్వాసం రాఖ్యూ. <verse eid="JHN 4:39"/><verse number="40" style="v" sid="JHN 4:40"/>యో సమరయుల్‍ ఇనకన ఆయిన్‍ ఇవ్నాకన ర్హాకరి ఇన బతీమాల్లీదా ఇనటెకె యో ఎజ్గా బే ధన్‍ ర్హాయో.<verse eid="JHN 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41"/>ఇను వాతేవ్నా హఃజమా బుజుబి కెత్రుక్‍జణు నమ్యా, <verse eid="JHN 4:41"/><verse number="42" style="v" sid="JHN 4:42"/>యో బాయికోనా దేఖిన్‍ హంకేతు ధరీన్‍ థూబోల్యోతె వాతేనా కాహేతిమ్‍ హామరు వాతేన హామే ఖంజీన్‍ ఆ హాఃఛిస్‍ ఆస్‍ ములక్‍నా బచ్చవాలో కరి మాలంకరీన్‍ నమ్ముకరేస్‍ కరి బోల్యా.<verse eid="JHN 4:42"/></para>
  <para style="s">యేసు అధికారిను ఛియ్యానా అష్యల్‍ కరను</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43"/>యో బే ధన్‍ హువ్వది ఇన పాస్సల్‍ యో ఎజ్గాతూ నీకీన్‍ గలిలయమా గయో. <verse eid="JHN 4:43"/><verse number="44" style="v" sid="JHN 4:44"/>సానకతో ప్రవక్త ఇను హుఃద్ను గమ్మా ఘనత పొంద్చేకోయినికరి యేసు సాబుత్‍నా బోల్యొ <verse eid="JHN 4:44"/><verse number="45" style="v" sid="JHN 4:45"/>గలిలయావాలుబీ యో పస్కాను పండగాన జవ్వాలు, ఇనటెకె యేరూషలేమా పండగను వఖాత్‍ యో కర్యోతే కార్యల్‍ ఖారు ఇవ్నే దేక్యాకరి యో గలిలయమా ఆయోతెదె ఇవ్నే ఇనా బులైలీగయు.<verse eid="JHN 4:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46"/>యేసు పానినా ద్రాక్చానురహ్ః గోణికర్యోతే గలిలయమా కానాను దేహ్కామా యో పరీన్‍ ఆయోతెదె కపెర్నహూమ్మా ఏక్‍ మోట్టొ మాలిక్నో ఛియ్యో రోగ్‍వాలో హుయిన్‍ థో. <verse eid="JHN 4:46"/><verse number="47" style="v" sid="JHN 4:47"/>యేసు యూదయతునీకీన్‍ గలిలయమా ఆయోకరీ యో హాఃజీన్‍ ఇనకన జైన్‍ ఇనో ఛియ్యో మరాన్‍నీ సిత్ధిమ రవ్వమా ఇనటెకె యో ఆయిన్‍ ఛిమిన్‍ ఇన స్వస్థకరును కరి బాతిమాలీదో. <verse eid="JHN 4:47"/><verse number="48" style="v" sid="JHN 4:48"/>యేసు సుచాక క్రియాల్‍నా మహత్కర్యాల్‍నా నాదేక్యాతో తుమారమా ఏక్జనుబి నంసుకోయినికరి ఇనేతి బోల్యొ.<verse eid="JHN 4:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49"/>అనహఃజే యో మోట్టొ మాలీక్‍ ఖాయాబ్‍ మారో ఛియ్యో మర్జావనా అగాఢీస్‍ ఆవ్కరీ బతిమాల్యో.<verse eid="JHN 4:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50"/>యేసు బోల్యొ, థూ “జా; తారొ ఛియ్యో జీవీన్‍ ఛాకరి” ఇనేతి బోలమా యోఅద్మి ఇనే బోల్యొతె వాత్నా ఖాంజీన్ నమ్మీన్‍ చలీగయో. <verse eid="JHN 4:50"/><verse number="51" style="v" sid="JHN 4:51"/>యో బుజు జంకరమా ఇనో కామ్కరవాలు ఇన ఖామే ఆయిన్‍ ఇను ఛియ్యో జివీన్‍ఛాకరి మాలంకరాయో.<verse eid="JHN 4:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52"/>కెత్రా బాజేన ఇన అషల్ హుసేకరి ఇవ్నా పుఛ్చాయోతెదె, ఇవ్నేకాల్‍ ధోపారే ఏక్ బజాన రోగ్‍ ఇన బేందిదూకరి ఇనేతి బోల్యా. <verse eid="JHN 4:52"/><verse number="53" style="v" sid="JHN 4:53"/>“తారో ఛియ్యో జివీన్‍‍ఛాకరి” యేసు ఇనేతి బోల్యోతె వఖాత్‍ యోస్కరి భా మాలంకరీలీదొ అనటెకె యోబీ ఇను ఘర్మను ఖారు నమ్యా.<verse eid="JHN 4:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54"/>యేసు యూదయతు నీకీన్‍ గలిలయమా ఆయిన్‍ కర్యోతె ఆ బెంమ్మాను సూచాక క్రియల్‍.<verse eid="JHN 4:54"/></para>
  <chapter eid="JHN 4"/>
  <chapter number="5" style="c" sid="JHN 5"/>
  <para style="s">కోనేర్‍మా ఏక్‍ రోగ్‍వాలన స్వస్థత కరను</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1"/>ఇనుపాసల్‍ యూదుల్ను పండగ ఏక్ ఆవామ, ఇనఖాజే యేసు యెరూషలేమ్‍ గయో.<verse eid="JHN 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 5:2"/>యెరూషలేమ్‍మా మ్హేండనా ధర్వాజునకన హాఃమె హెబ్రిభాషమ బెతెస్థకరి బోలాతే ఏక్ కోనేర్ రవ్వమా ఇన పాచ్‍మంటపాల్‍ ఛా. <verse eid="JHN 5:2"/><verse number="3-4" style="v" sid="JHN 5:3-4"/>త్యొ, వఖాత్మా దేవ్నుదూత కోనేర్‍మా వుత్రీన్‍ పాణినా హలావ్తూ థూ! పాణినా హళనా పాసల్‍ అగాడి కోన్‍ పాణిమా ఉత్రస్కి యో కెజాత్నూ రొగాఢివాలోబీ అషల్ హువ్వస్‍ ఇనటెకె మండపాల్‍మా రోగ్‍వాలా, కాణువాలు, లంగ్డొవాలు హాత్‍పడిగ్యుతె అద్మి, గల్లొనితర రవ్వానూ దేక్యొ. <verse eid="JHN 5:3-4"/><verse number="5" style="v" sid="JHN 5:5"/>ఎజ్గా ఆట్‍వుప్పర్‍ డోఢిహ్క్ వరహ్క్ తూ ఏక్ రొగాఢి అద్మి ర్హాతుథూ. <verse eid="JHN 5:5"/><verse number="6" style="v" sid="JHN 5:6"/>యేసు ఇన పఢిరవ్వాను దేఖిన్‍ యోతెప్తు కెత్రూకి ధన్‍తూ ఇంమ్‍ ర్హవ్వాను యో జోగొమా ఛాకరి సోచిలీన్‍ అష్యల్‍హోనుకరి సోచుకరస్‍న్నాకరి ఇన పుఛ్చావమా!<verse eid="JHN 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7"/>యో రోగ్వాలు ఓ మాలిక్‍ పాణి హలుతెదె మన కోనేర్మా ఉత్రావనాటేకె కోన్బీకొయినీ అనటేకే మే ఆవతోడి ఎత్రమాస్‍ బుజేక్జనో మారెతీబీ అగాడి ఉత్రుకరస్కరి ఇనేతి జవాబ్‍దిదో.<verse eid="JHN 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8"/>యేసు బోల్యొథూ ఉట్టీన్‍ తారు బిఛ్చావును పల్లిన్‍ జా కరి ఇనేతి బోలమా!<verse eid="JHN 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 5:9"/>తెదేస్‍ యో అష్యల్‍హుయిన్‍ ఇను బిఛ్చావును పల్లీన్‍‍ ఛాలనిక్యొ యోధన్‍ ఆరామ్నుధన్‍ <verse eid="JHN 5:9"/><verse number="10" style="v" sid="JHN 5:10"/>ఇనటెకె యూదుల్ ఆ ఆరామ్నుధన్‍ కాహేనా తూ బిచ్ఛావును పల్లీన్‍ ఛాల్కరి హుసేకొయిన్నీకరి అష్యల్‍హుయోతె ఇనేతి బోల్యొ.<verse eid="JHN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11"/>ఇనటెకె మన నయంకర్యోతే యో తారు బిఛ్చాను పల్లీన్‍‍ ఛాల్కరి మారేతి బోల్యొకరి బోలాస్‍.<verse eid="JHN 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12"/>ఇవ్నేతారు బిఛ్చావును పల్లీన్‍‍ ఛాల్కరి తున బోల్యొతె యో కోన్‍? కరి ఇన పుఛ్చాయా!<verse eid="JHN 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13"/>యో కోన్కి నయంకరిహుయు ఇనా మాలంకొయినీ; యోజొగొమా గల్లొభరాయిన్‍ ర్హావ్వమా! ఇనటెకె యేసు చుక్కయిలీన్‍ నికిగో.<verse eid="JHN 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14"/>ఇనపాసల్‍ మందిరంమా యేసున దేఖిన్‍ హదేక్‍ నయంహుయో కరి; బుజు “జాహఃత్‍ కీడుతున నాలాగ్నూతింమ్ హంకెతు పాప్‍ నొకొకర్కరి” బోలమా!<verse eid="JHN 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15"/>యోజైన్‍ మన నయంకరోహో యేసుకరి యూదుల్‍ అధికారితి మాలంకరాయో. <verse eid="JHN 5:15"/><verse number="16" style="v" sid="JHN 5:16"/>ఇనటేకె ఆకార్యల్‍నా ఆరామ్‍ధన్నె కర్యోకరి యూదుల్‍ అధికారి యేసునా హాఃథాయా! <verse eid="JHN 5:16"/><verse number="17" style="v" sid="JHN 5:17"/>హుయుతో యేసు, “మారో భా హంకెతోడి కామ్‍కరూకరస్‍ మేబీ కరుకరూస్కురి” ఇవ్నేతి జవాబ్‍దిదో.<verse eid="JHN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18"/>యోధన్ ఆరామ్నుధన్‍ ఆచారంనాబీ మీరిన్‍ కాహేతీమ్‍ దేవ్‍ ఇను అస్లీ భాకరి బొల్లీన్‍ ఇనుయోస్‍ దేవ్తి సమాన్‍కరి కర్లిదో అనటెకె ఇనునిమిత్తమ్‍ యూదుల్‍ ఇనా మర్రాక్నుకరి బుజుజాఖాత్ కోషిస్‍కర్యు.<verse eid="JHN 5:18"/></para>
  <para style="s">ఛియ్యాను అధికారం</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19"/>ఇనటెకె యేసునే ఇవ్నేతీ అంమ్‍నితర ఫరాయిన్‍బొల్యొ. భాకెహూ కరను ఛియ్యో దేఖ్‍స్కి యోస్‍పన్కి ఇనుయోస్‍ కెహూబీ కరకొయినీ; యో కెహూ కరస్కి, ఇనా ఛియ్యోబి ఇమ్మాస్‍ కర్సే. <verse eid="JHN 5:19"/><verse number="20" style="v" sid="JHN 5:20"/>భా ఛియ్యోనా లాఢ్‍కర్తొహుయిన్‍ యో కరుకరతె ఖారు ఇన దెఖావుంకరస్కరి తుమారేతి హాఃఛితి బోలుకరుస్‍ బుజు తుమే అష్యంహువతిమ్ అనేత్తీబి మోట్టో కార్యయల్న ఇన దె‍ఖాడ్‍సె <verse eid="JHN 5:20"/><verse number="21" style="v" sid="JHN 5:21"/>భా మరిగయోనా కింమ్‍ జీవాడీన్‍ ఉట్టాడస్కీ, ఇమ్మాస్‍ ఛియ్యోబీ ఇన ఇష్టంహుయుతే ఇవ్నా జీవాడ్సె. <verse eid="JHN 5:21"/><verse number="22" style="v" sid="JHN 5:22"/>భా కినాబి న్యావ్‍ తీర్చాకోయినీ పన్కి, భాన ఘనపరచనీతర హాఃరుబీ ఛియ్యానబి ఘనపరచుని కరి న్యావ్‍ తీర్చాన సర్వహకుబీ ఛియ్యానస్‍ దేవ్వాయిరాక్యోస్‍ <verse eid="JHN 5:22"/><verse number="23" style="v" sid="JHN 5:23"/>ఛియ్యో నాఘనపరచాకోయినితే ఇవ్నే ఇన మోక్లోతే భానబీ ఘనపరచాకోయిని.<verse eid="JHN 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24"/>దేవ్నిఛియ్యాను వాత్‍ హఃమ్జీన్‍ మన మోక్లోతే ఇనఫర్‍ విష్వాస్‍ రాఖవాలో నిత్యజీవంమా రవ్వాలో; యో న్యావ్‍మా అవకోయినీతీమ్ మరణ్‍మతో నిఖీన్‍ జీవంబణే దాటిన్‍ ఛాకరీ తుమారేతి హాఃఛితి బోలుకురుస్‍ <verse eid="JHN 5:24"/><verse number="25" style="v" sid="JHN 5:25"/>మరిగుహుయు దేవ్ని ఛియ్యాను ఆవాజ్‍ ఖాంజను వఖాత్‍ ఆవుంకరస్‍ హాంకేస్‍ ఆయ్రూస్‍; ఇనా ఖంజవాలు జీవ్సెకరి తుమారేతి హాఃఛితిస్‍ బోలుకరూస్‍ <verse eid="JHN 5:25"/><verse number="26" style="v" sid="JHN 5:26"/>భా కిమ్‍ ఇనుగోణి యోస్‍ జాన్‍వాలోహుయిన్ ఛాకీ ఇమ్మాస్‍ ఛీయ్యోనాబీ ఇనుయోస్‍ జాన్‍వాలోహుయిన్‍ రవ్వనాటెకె ఛియ్యోనాబీ హక్కు దేవ్వాయ్‍రుస్‍ <verse eid="JHN 5:26"/><verse number="27" style="v" sid="JHN 5:27"/>బుజు యో అద్మినఛియ్యోనా హువమా న్యావ్‍ తీర్చానటేకే అధికార్నా దీరాక్యోస్‍ <verse eid="JHN 5:27"/><verse number="28" style="v" sid="JHN 5:28"/>అనహఃజే అష్యం నొకొహువో, ఏక్ ధన్ ఆవుంకరస్‍; యో ధన్మా గోరఢమా ఛాతె ఇవ్నేఖారుబి ఇను ఆవాజ్‍ ఖాంజ్చె. <verse eid="JHN 5:28"/><verse number="29" style="v" sid="JHN 5:29"/>అష్యల్ కర్యుహూయు జీవిన్‍ పునారుత్థానమా, కిడూ కర్యుహూయు న్యావ్‍ పునరుత్థనంమాతూ భాధర్‍ ఆవ్సే.<verse eid="JHN 5:29"/></para>
  <para style="s">యేసును సాబుత్‍</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30"/>మారు మేస్ సాత్బి కోకరిస్‍ని మే హఃమ్జొతిమ్‍ న్యావ్‍న తీర్చుకరూస్ మన మోక్లోతె ఇని చిత్తప్రకారమాస్‍ కరనసోఛీస్‍ పన్కి మారు ఇష్టప్రకరామ్‍ కరీస్‍కోయిని, అనటేకె మారు న్యావ్‍ న్యాయం హుయ్రూస్‍<verse eid="JHN 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31"/>మార బారెమా మేస్‍ సాబుత్‍ బొల్లీదోతొ, మారు సాబుత్‍ హాఃఛికాహే <verse eid="JHN 5:31"/><verse number="32" style="v" sid="JHN 5:32"/>పన్కి మారుబారెమా సాబుత్‍ బోలవాలో బుజేక్జనో ఛా! యో మారగూర్చి దిసేతే సాబుత్‍ హాఃఛికరి మే మాలంకరీలిస్‍ <verse eid="JHN 5:32"/><verse number="33" style="v" sid="JHN 5:33"/>తుమే యోహాన్‍కన థోడుజణనా మోక్లోథా; యో హాఃఛినగూర్చీ సాబుత్‍దిదొ. <verse eid="JHN 5:33"/><verse number="34" style="v" sid="JHN 5:34"/>మే అద్మినాకంతూ ఆయుతే జామీన్‍న ఒప్పీస్‍కొయిని పన్కి, తుమే బచ్చీజానుకరీ ఆ వాతె బోలుకురూస్. <verse eid="JHN 5:34"/><verse number="35" style="v" sid="JHN 5:35"/>యోహాన్‍ బొల్తోహుయిన్‍ ప్రకాసించుకరతే దివ్వొహుయిన్‍ ర్హాసే, తుమే ఇను ఉజాలుమా ర్హైన్‍ థోడుధన్ ఖుషాల్తి ర్హావనటెకె ఇష్టంహుయాథా. <verse eid="JHN 5:35"/><verse number="36" style="v" sid="JHN 5:36"/>పన్కి యోహాన్‍ మారటెకె దిదొతె సాబుత్‍తీబి అజు జాఖాత్‍ హాఃఛ్చిను గొప్పసాబుత్‍ మారకనా ఛా; యోసాత్‍కతో, మే నేరవెర్చానటెకె భా కేహూక్రియాల్‍న మన దీరక్యోస్‍కీ, మే కరుకరతే యోస్‍ క్రియల్‍ భా మన బోలిమోక్లీరక్యోస్‍ ఆ క్రియల్‍ మనగూర్చిన్‍ జామీన్‍ దెంకరాస్‍ <verse eid="JHN 5:36"/><verse number="37" style="v" sid="JHN 5:37"/>బుజు మనమోక్లోతే భాస్‍ మన గూర్చీన్ సాబుత్‍దెంకరాస్‍ తుమే కెహుధన్మాబీ, ఇను అవాజ్నా ఖాంజ్యాకొయినిఇన స్వరుపంనా దేక్యాకోయిని. <verse eid="JHN 5:37"/><verse number="38" style="v" sid="JHN 5:38"/>అజు యో కినా బోలిమొక్లొకి ఇన తుమే నమ్మకోయిని, అనటెకె తుమారు దిల్మా ఇను వఛన్‍ వుబ్రీ ర్హయుకొయిని. <verse eid="JHN 5:38"/><verse number="39" style="v" sid="JHN 5:39"/>లేఖనాల్‍మా తుమ్న నిత్యజివంను ఛాకరీ సోచీలేతుహుయిన్‍ ఇనాస్‍ పరిషోధంచుకరస్‍ యోస్ మన గూర్చిన్‍ సాబుత్‍ దేవుంకరస్‍ <verse eid="JHN 5:39"/><verse number="40" style="v" sid="JHN 5:40"/>హుయ్తోబి తుమ్న జాన్‍హోనుతిమ్‍ తుమే మారకన ఆవాకోయిని.<verse eid="JHN 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41"/>మే అద్మీయేనుబారెమా మహిమనా ఆసించవాలొకాహే. <verse eid="JHN 5:41"/><verse number="42" style="v" sid="JHN 5:42"/>పన్కి తుమారు దిల్ కెజాత్నూకి మన మాలంకర్లిదో; దేవ్నీ ఫ్యార్‍ తుమారమ కొయినీ. <verse eid="JHN 5:42"/><verse number="43" style="v" sid="JHN 5:43"/>మే మార భాను నామ్తీ‍ ఆయ్రోస్‍; పన్కి తుమే మన అంగీకరీంచా కొయినీ, బుజేక్జనో ఇను నామ్పర్‍ ఆయోతొతెదె ఇన అగీకరించుకరస్‍; <verse eid="JHN 5:43"/><verse number="44" style="v" sid="JHN 5:44"/>ఏక్నాఏక్‍ దేవ్నఖాజె ఆవతే మెప్పున కోరకొయినీ తింమ్‍ ఏక్ను మహిమన పొందుకరతె తుమే కింమ్‍ నమ్ఛు? <verse eid="JHN 5:44"/><verse number="45" style="v" sid="JHN 5:45"/>మే భా కన తుమారప్పర్‍ నేరంనా మోపిదీస్కరీ నొకొసోచొ; తుమే ఆహ్‍ఃకరతే మోషే తుమారప్పర్‍ నేరంన మోప్సే. <verse eid="JHN 5:45"/><verse number="46" style="v" sid="JHN 5:46"/>తెదె యో మన గూర్చిన్‍ లిఖ్యో అనటెకె తుమే మోషేనా నమ్యాహూయ్తొ మనాబీ నమ్చూ. <verse eid="JHN 5:46"/><verse number="47" style="v" sid="JHN 5:47"/>తుమే ఇను లేఖనల్నా నానమ్యతో తెదె మారు వాతె కింమ్‍ నమ్చుకరీ బోల్యొ.<verse eid="JHN 5:47"/></para>
  <chapter eid="JHN 5"/>
  <chapter number="6" style="c" sid="JHN 6"/>
  <para style="s">యేసు పాచ్‍హాజార్‍ అద్మినా ధాన్‍ ఖఢావను</para>
  <para style="r">(<ref loc="MRK 6:30-44">మార్కు 6:30-44</ref>; <ref loc="LUK 9:10-17">లూకా 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1"/>ఇనపాసల్‍ యేసు తిబెరియ నాహితో గలిలయ ధర్యావ్నా దాటీన్‍ పార్లిబాజు ఠగర్ఫర్‍ గయో. <verse eid="JHN 6:1"/><verse number="2" style="v" sid="JHN 6:2"/>రోగ్వాలను బారెమా యో కర్యోతె సూచక క్రియల్‍నా దేఖీన్‍ కెత్రూకిజనూ ఇనకెడె గయూ. <verse eid="JHN 6:2"/><verse number="3" style="v" sid="JHN 6:3"/>యేసు ఫాడ్‍చఢీన్‍ ఎజ్గా ఇను సిష్యుల్తీ బేసీన్‍ రయ్యో. <verse eid="JHN 6:3"/><verse number="4" style="v" sid="JHN 6:4"/>తెదె యూదుల్ను పస్కాకరి పండగా ఖాందె ఆవమా.<verse eid="JHN 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5"/>అనహాఃజె యేసు ఢోలాపాడిన్ కేత్రుకిజను ఇనకన ఆవాను దేఖీన్‍ ఇవ్నా ఖావనటెకె కెజ్గాతూ రోటామోల్లీన్‍ మాంగాయిస్‍ కరి ఫిలిఫ్పున పుఛ్చాయో! పన్కి, <verse eid="JHN 6:5"/><verse number="6" style="v" sid="JHN 6:6"/>యేసునె సాత్‍ కరజాసేకి యోస్‍ మాలంకరిన్‍ ఇన పరీక్చాకరనటెకె ఇమ్‍ పుఛ్చాయో.<verse eid="JHN 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7"/>అనటెకె ఫిలిఫ్పు, ఇవ్నామా హార్యేక్‍జనునా దధ్రాసు రోటా లేవ్వానటేకెబి బేఖో, దేనారం<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">మూలభాషమా బరోబ్బర్‍ </char></note>న రోటా పూర్సేకొయిని కరి ఇనేతి బోల్యొ. <verse eid="JHN 6:7"/><verse number="8" style="v" sid="JHN 6:8"/>యేసున సిష్యుల్మా‍ ఏక్జనొ, కతో సీమోన్‍ పేతుర్‍నో భై హుయోతె అంద్రెయ; <verse eid="JHN 6:8"/><verse number="9" style="v" sid="JHN 6:9"/>“అజ్గ ఛాతే ఏక్ న్హాన ఛొగ్రకనా పాచ్‍ రోటా బే మాస్ల ఛాకరీ పన్కి, అత్రా అద్మియేనా పూర్సేకొయిని ఇనేతి బోలమా”<verse eid="JHN 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10"/>యేసునే అద్మీ హాఃర్వనా బేఖాడోకరీ బోల్యొ. యో జోగోమా ఘాను గాఖ్‍ రవమా, ఇనటెకె గణ్యతొ కంసేకమ్‍ పాచ్‍హాజార్‍ మరద్మాన బేట్యు. <verse eid="JHN 6:10"/><verse number="11" style="v" sid="JHN 6:11"/>యేసు యో రోటనాపన్‍ పల్లీన్‍ కృతజ్ఞాతా స్తుతుల్‍కరీన్‍ బేట్యుతే హాఃరజావ్నానా వడ్డించ్యు. ఇమ్మాస్ మాస్లాబీ ఇవ్నా ఇష్టంహుయు ఎత్రు వడ్డించ్యు. <verse eid="JHN 6:11"/><verse number="12" style="v" sid="JHN 6:12"/>ఇవ్నే ధండారుభరీన్‍ ఖైన్‍ పాసల్‍ కాయిబి నష్టంకోయినితిమ్‍ మిగ్లుతె టుక్డాన హొఃతొకరి ఇను సిష్యుల్‍తీ బోల్యొ <verse eid="JHN 6:12"/><verse number="13" style="v" sid="JHN 6:13"/>ఇనాటెకె ఇవ్నే ఖావమ్మా ఇనపాసల్తి ఇవ్నాకన పాచ్‍ రోటాను టుక్డాన జమాకరీన్‍ భార టోక్రా భర్యూ.<verse eid="JHN 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14"/>యో అద్మీయే యేసు కర్యోతే అద్బుత క్రియాల్‍న దేఖీన్‍ హాఃఛితీస్‍ ఆ ములక్‍మా ఆవుంకరతే ప్రవక్త ఆస్కరీ బోల్లీదు.<verse eid="JHN 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 6:15"/>అనటేకే రాజో కర్నూకరి ఇవ్నే ఆయిన్‍ ఇన జభర్‍దస్తీఖూ ధర్లీజావనా వలావస్‍కరీ యేసు సోచీన్‍ బుజు పహాడ్‍కనా ఎకేలొస్‍ గయో.<verse eid="JHN 6:15"/></para>
  <para style="s">యేసు పానిఫర్‍ చాలను</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16"/>ఖాంజ్‍ హుయుతెదె యేసును, సిష్యుల్‍ ధర్యావ్ను సేడెఛాతె ఢోంగ చఢీన్‍ గలిలీయాజంకరమా; <verse eid="JHN 6:16"/><verse number="17" style="v" sid="JHN 6:17"/>ఎత్రాస్మా రాత్‍హుయిగు పన్కి యేసు ఇవ్నాకన బుజుబీ అయోకోయిని. <verse eid="JHN 6:17"/><verse number="18" style="v" sid="JHN 6:18"/>తెదె మోటు వ్యారో ఆవామ! ధర్యావ్మా జుకాళో ఉక్లుకరా, <verse eid="JHN 6:18"/><verse number="19" style="v" sid="JHN 6:19"/>ఇవ్నే బరోభ్బర్‍ పాఛ్‍ నైతొ ఛో పర్లాంగ్‍ ఎత్రే దూర్మా ఢోంగాన లీజావమా పాస్సల్‍ యేసు ధర్యావ్నా ఉప్పర్‍చాల్తోహుయిన్‍ ఇవ్ను ఢోంగాన హఃమే ఆవనూ దేఖీన్‍ ఢారిగయూ; <verse eid="JHN 6:19"/><verse number="20" style="v" sid="JHN 6:20"/>పన్కి యో మేస్‍ ఢరొనొకొకరి ఇవ్నేతి బోల్యొ. <verse eid="JHN 6:20"/><verse number="21" style="v" sid="JHN 6:21"/>అనటెకె ఇనా ఢోంగామ చడైలేవనాటెకె ఇవ్నా ఇష్టంహుయు, ఎగ్గీస్‍ యో ఢోంగ ఇవ్నే జవుంకరతే జొగొమ చేరిగు.<verse eid="JHN 6:21"/></para>
  <para style="s">అద్మియే యేసునా ధూండాను</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22"/>బుజెక్ ధన్నె వ్హాణే ఖాత్రే ధర్యావ్ను ఒడ్డుకనా ఉబ్రీన్‍ ఛాతె అద్మీను గుమ్మల్‍ ఆయిన్‍ దేఖమా! ఏక్ న్హాను ఢోంగా తప్ప బుజు కెహూబి ఎజ్గా కొయినీకరీ యేసు ఇను సిష్యుల్‍నా కేడె చడ్యాకోయిని పన్కి ఇన సీష్యులాస్‍ గయాకరీ మాలంకరిలిదా. <verse eid="JHN 6:22"/><verse number="23" style="v" sid="JHN 6:23"/>పన్కి ప్రభూన కృతజ్ఞాతాస్తుతుల్‍ దీనాకితెదె ఇవ్నే రోటాఖాద్యతె జొగొమా ఖందె ఛాతె తిబెరియాతువాలను ఢోంగాల్‍ లీన్‍ఆయూ. <verse eid="JHN 6:23"/><verse number="24" style="v" sid="JHN 6:24"/>అనహఃజే యేసు బుజు ఇను సిష్యుల్‍ ఎజ్గా నార్హావను అద్మియేఖారు దేక్యాతెదె ఇవ్నే ఢోంగా చఢీన్‍ యేసునా ధూండుతూహుయిన్‍ కపెర్నాహూమ్నా గాయూ.<verse eid="JHN 6:24"/></para>
  <para style="s">యేసు జీవను ఖాణు</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25"/>ధర్యావ్నుకనారిన ఇనా మాలంకరీన్ బోధకుడ్‍ తూ కెదె అజ్గ ఆయోకరి పుఛ్చావమా!<verse eid="JHN 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26"/>యేసు, తుమే హాఃనద్నా దేఖాను బారెమా కాహేపన్కి రోట్టాఖైయిన్‍ ఢండార్‍బరీన్‍ పొందనటెకేస్ మన ధూండుకరస్‍ కరి తుమారేతి హాఃఛితి బోలుకరూస్‍ <verse eid="JHN 6:26"/><verse number="27" style="v" sid="JHN 6:27"/>మట్జాయితె ధాన్నాటెకె మినాత్‍ నొకొపడ పన్కి, నిత్యజీవంన జావాను ఇనటెకేస్‍ మినాత్‍కారో; అద్మినఛియ్యో ఆ తుమ్నాదిషే, అనటెకేస్‍ భా హుయోతె దేవ్‍ ఇన ఛాపొ నాఖిరాక్యోస్‍కరి బోల్యొ.<verse eid="JHN 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28"/>ఇవ్నే హామె దేవ్న నచ్యుకతొ సాను కామ్‍ కర్నూకరి ఇన పుఛ్చావమా!<verse eid="JHN 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29"/>యేసు, యో మొక్లొతె ఇనకనా తుమే విస్వాష్‍ రాఖానుస్‍ దేవ్ని కామ్‍ కరి ఇవ్నేతి బోల్యొ<verse eid="JHN 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30"/>అనటేకె ఇవ్నే, ఇమ్‍హుయుతో హఃమే దేఖిన్‍ విష్వాస్‍ కరనా తూ కెహూ హాఃనద్నూ క్రియల్నా కరుకరస్‍? సాత్‍ కరాయిస్‍ కరి ఇన పుఛ్చాయ. <verse eid="JHN 6:30"/><verse number="31" style="v" sid="JHN 6:31"/>స్వర్గంమాతు ఖావనటెకె యో ధన్నా ఇవ్నా దెవ్వాడిరాఖోస్‍ కరి లిఖ్కార్యుతిమ్‍ అప్న భాన భా, జాఢిమా మన్నాను ఖాను ఖాద్యకరీ ఇనేతి బోల్యొ.<verse eid="JHN 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32"/>అనహఃజే యేసు స్వర్గంమతు ఆవతే ధాన్‍ మోషే తుమ్నాదీరాక్యొకొయినీ, మారో భాస్‍ స్వర్గంమాతు ఆవతే హాఃఛిను ధాన్‍నా తుమ్న దేవ్వాడిరాక్యోస్‍ <verse eid="JHN 6:32"/><verse number="33" style="v" sid="JHN 6:33"/>స్వర్గంతూ ఉత్రీనాయిన్‍ ములక్నా జీవం దేంవ్‍కరతే దేవ్‍ దీరాక్యోతె ధాన్‍హుయిన్‍ ఛా కరి తుమారేతి హాఃఛిస్‍ బోలుకరూస్‍ కరి ఇవ్నేతి బోల్యొ <verse eid="JHN 6:33"/><verse number="34" style="v" sid="JHN 6:34"/>అనహాఃజె ఇవ్నే మాలీక్‍ ఆ ఖాణు కేదెబి హమ్నా దేవ్వాయిరాక్కరి బోల్యా.<verse eid="JHN 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35"/>అనటెకె యేసు ఇవ్నేతి అమ్‍ బోల్యొ, జీవాహారంబీ మేస్‍ మారకన ఆవ్వాలొ కెదేబి పస్తూ ర్హాసెకొయిని; మారఫర్‍ విష్వాస్‍ కరవాలో యో కెదేబి తరాఖ్‍ తి ర్హాసెకోయిని. <verse eid="JHN 6:35"/><verse number="36" style="v" sid="JHN 6:36"/>తుమే మన దేఖీన్‍ ర్హహీన్బి విష్వాస్‍ కరకొయిని తీమ్‍ ఛాకరీ తుమారేతి బోల్యొ థో. <verse eid="JHN 6:36"/><verse number="37" style="v" sid="JHN 6:37"/>భా మన దేవ్వాయిరాక్యొతె ఇవ్నే ఖారుబి, మారకన ఆవ్సే; మారకన ఆవ్వాలన మే కెత్రేబి భాధర్‍ ధక్లిస్‍కోయిని. <verse eid="JHN 6:37"/><verse number="38" style="v" sid="JHN 6:38"/>హుయుతో మారు ఇష్టంనా నేరవేర్చనటెకె మే కోఆయోని, మన మొక్లోతె ఇను చిత్తమ్నా నెరవేర్చనటేకెస్‍ స్వర్గంమతూ ఉత్రీన్‍ ఆయో. <verse eid="JHN 6:38"/><verse number="39" style="v" sid="JHN 6:39"/>యో మన దిరక్యోతే ఇన్మా ఖారమబి మేసాత్బి గమాయోకొయినీతిమ్‍ ధర్తిను ఆఖరిధన్మా ఇన ఉట్టాడునూస్‍ మన మొక్లోతె ఇను ఇష్టంహుయిన్ ఛా. <verse eid="JHN 6:39"/><verse number="40" style="v" sid="JHN 6:40"/>ఛియ్యోనా దేఖీన్‍ ఇనఫర్‍ విష్వాస్‍రాఖవాలు హార్యేక్జను మరణ్ కోయినితిమ్‍ నిత్యజీవంన పొందనూస్‍ మార భా చిత్తం; ధర్తిను ఆఖరినుధన్‍ మే ఇవ్నా ఉట్టాడీస్‍<verse eid="JHN 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41"/>అనటెకె “మే స్వర్గంమాతు ఉత్రీన్‍ ఆయోతెధాన్కరీ యో బోల్యొ” కరి యూదుల్ మోటా ఇను గూర్చి భణ్కిలేతూ, <verse eid="JHN 6:41"/><verse number="42" style="v" sid="JHN 6:42"/>ఆ యోషేప్‍నొ ఛియ్యోహుయోతే యేసు కాహేనా? అను ఆయా, భాన అప్న మాలంహుయిన్‍ఛా కాహేనా? మే స్వర్గంమతూ ఉత్రీన్‍ ఆయ్రోస్‍ కరి అనే కిమ్‍ బోలుకరస్‍ కరి పుఛ్చాయా.<verse eid="JHN 6:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43"/>అనటేకె యేసు తుమారమా తుమేస్‍ నొకోబణికిలేవొ; <verse eid="JHN 6:43"/><verse number="44" style="v" sid="JHN 6:44"/>మన మోక్లోతె భా ఇన మాలంకర్యొతోస్‍ పన్కి కోన్బీ మారకన ఆవ్సెకోయిని; ధర్తిను ఆఖరిధన్‍ మే ఇన వుట్టాడీస్‍ <verse eid="JHN 6:44"/><verse number="45" style="v" sid="JHN 6:45"/>ఇవ్నె ఖారుబి దేవ్నిహాతేఖు బోధించబడ్చేకరి ప్రవక్తల్‍ లేఖనంమా లిఖాయ్రూస్‍ అనహాఃజె భాన బారేమ ఖంజీన్‍ సికిరాక్యతే హర్యేక్జను మారకనా ఆవ్సే. <verse eid="JHN 6:45"/><verse number="46" style="v" sid="JHN 6:46"/>భాన కోన్బి కోదేఖిరాక్యోని; దేవ్కంతూ ఆయోతె యో అనేస్‍ తప్ప బుజు భాన దేఖిరాక్యోస్‍ <verse eid="JHN 6:46"/><verse number="47" style="v" sid="JHN 6:47"/>మే హాఃఛితిస్‍ బోలుకురుస్‍ విష్వాస్‍ కరవాలోస్‍ నిత్యజీవన్‍ ర్హాసె, <verse eid="JHN 6:47"/><verse number="48-49" style="v" sid="JHN 6:48-49"/>జీవనూ ఖానుబి మేస్‍; తుమార భాన భా జాఢిమా మన్నానా ఖాద్యాతోబి మరిగయు. <verse eid="JHN 6:48-49"/><verse number="50" style="v" sid="JHN 6:50"/>అనా ఖవ్వాలో మర్యొకొయిని తిమ్‍ స్వర్గంమతూ ఉత్రీన్‍ ఆయుతే ఖాణు ఆస్‍ <verse eid="JHN 6:50"/><verse number="51" style="v" sid="JHN 6:51"/>స్వర్గంమతు ఉత్రీన్‍ ఆయుతె జీవంనుఖాను మేస్. కోన్బి ఆ ఆహారంనా ఖాద్యుతొ యో కొమార్సేకొయిన్‍తిమ్‍ జీవ్సె; బుజు మే దెంకురుతె ఖాణు ములక్నా జీవమ్‍నటెకె మారు ఆంగస్‍కరి తుమారేతి హాఃచ్చీతి బోలుకురూస్కరి బోల్యొ.<verse eid="JHN 6:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52"/>ఇవ్నే అనే ఇను ఆంగ్‍తాన్‍ కిమ్‍ ఖావదిసేకరి ఏక్నా ఏక్ వాదించిలీదు<verse eid="JHN 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53"/>ఇనటేకె యేసు అమ్‍ బోల్యొ, తుమే అద్మినొఛియ్యోనా ఆంగ్‍తాన్‍<note caller="+" style="f"><char style="fr" closed="false">6:53 </char><char style="ft" closed="false">మూలభాషమా రోటొ</char></note> ఖైయిన్‍ ఇను లోహి<note caller="+" style="f"><char style="fr" closed="false">6:53 </char><char style="ft" closed="false">మూలభాషమా ద్రాక్చాను రక్హ్</char></note> పిదాతొస్‍ తప్ప, తుమారమా తుమే జాన్‍హుయిన్‍ కోర్హాసుని. <verse eid="JHN 6:53"/><verse number="54" style="v" sid="JHN 6:54"/>మారు ఆంగ్న ఖైయిన్‍ మారు లోహినా పిదోహుయోస్‍ నిత్యజాన్వాలొ హుయోవోహొ; ధర్తీను ఆఖరినుధన్మా మే ఇనా ఉట్టాడీస్‍ <verse eid="JHN 6:54"/><verse number="55" style="v" sid="JHN 6:55"/>మారు ఆంగ్‍తాన్‍ హాఃఛిహుయూతె ఖానుహుయిన్‍ మారు లోహి హాఃఛిహుయుతె పా‍నియంహుయిన్‍ ఛా. <verse eid="JHN 6:55"/><verse number="56" style="v" sid="JHN 6:56"/>మారు ఆంగ్నా ఖైయిన్‍ మారు లోహి పిదోహుయోహో మారజోడ్మా మే ఇనా బరాబ్బర్‍ ఉబ్రీన్‍ ర్హాసు. <verse eid="JHN 6:56"/><verse number="57" style="v" sid="JHN 6:57"/>జాన్‍తి ఛాతె మారొ భా మన మొక్లొ అనహాఃజె మే భాను బారేమా జీవుంకరతె తిమ్మస్‍ మన ఖోంకరతె యోబీ మారు బారేమా జీవ్సె. <verse eid="JHN 6:57"/><verse number="58" style="v" sid="JHN 6:58"/>స్వర్గంతూ ఉత్రీన్‍ ఆయుతే ఖాణు ఆస్‍; భాన భా మన్నాన ఖైయిన్బి మరీగయూ తిమ్‍ కాహే; ఆ ఖాణు ఖవ్వాలో కెదేబీ జివీన్‍ ర్హాసేకరి హాఃఛీతి తుమారేతి బోలుకురూస్ కరి బోల్యొ.<verse eid="JHN 6:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59"/>యో కపెర్నహూమ్‍మా బోధించుతొహుయిన్‍ యూదుల న్యావ్‍కరనుజొగొ ఆవాతె బోల్యొ.<verse eid="JHN 6:59"/></para>
  <para style="s">నిత్యజీవంనాటేకె దేవ్ను వాతె</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60"/>కెత్రుకిజను ఆ భోధ హఃజిన్‍ ఆ మినాత్ను భోధ ఆ కోణ్ హఃమ్చె కరి బొల్లీదు. <verse eid="JHN 6:60"/><verse number="61" style="v" sid="JHN 6:61"/>యేసు గురించి కెత్రుకి అద్మియో ఇన గురీంచీ భణికిలేంకరస్కరి ఇను యోస్‍ సోచీన్‍ ఇవ్నేతీ అంమ్‍ బోల్యొ, అనటెకె తుమే అభ్యంతరంగా ఛానా. <verse eid="JHN 6:61"/><verse number="62" style="v" sid="JHN 6:62"/>ఇమ్‍హుయుతొ అద్మినొఛియ్యో అగాడి ఛాతె జొగోమా ఛాఢిజావాను దేఖ్యతెదె తుమే సాత్‍ బోల్చు. <verse eid="JHN 6:62"/><verse number="63" style="v" sid="JHN 6:63"/>దేవుడు దిదొతే ఆత్మాస్‍ జివ్వాడుకరస్‍; ఆంగ్తన్‍ చుక్కేష్‍ నిష్‍ప్రయోజనమ్‍ మే తుమారేతి బోలిరాక్యోతె వాతె ఆత్మనా జాన్‍హుయీన్‍ ఛా! పన్కి <verse eid="JHN 6:63"/><verse number="64" style="v" sid="JHN 6:64"/>తుమారమా విష్వాసం కరకొయింతే థోడుజనూ ఛాకరి ఇవ్నేతి బోల్యొ. విష్వాసం కరకొయింతె యోకోన్కి, ఇనా ధరైయ్‍దెవ్వాలొ యో కోన్కి, యేసునా అగాఢితూస్‍ మాలం. <verse eid="JHN 6:64"/><verse number="65" style="v" sid="JHN 6:65"/>బుజు యో, భాన హాతె ఇవ్నా కృప దెవ్వాడి రాఖనుతీబి కోన్బిహో మారకన కోఆవ్సేనికరి అకారణంటేకెస్‍ తుమారేతి బోల్యొ.<verse eid="JHN 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66"/>తెప్తూ ధరిన్‍ కెత్రూకి జణు ఫీటెచలీగు, బుజు కెదేబీ ఇనాకేడె కోగయూని. <verse eid="JHN 6:66"/><verse number="67" style="v" sid="JHN 6:67"/>ఇనటెకె యేసు బోల్యొ, తుమేబీ చలీజానూకరి ఛానా? కరి యో భారజననా‌ సిస్యుల్తి పుఛ్చావమా.<verse eid="JHN 6:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68"/>సీమోన్‍ పేతుర్‍ బోల్యా, ప్రభూ! కినాకన జైయే? తూస్‍ నిత్యజీవంనా గూర్చివాతె బోలవాలొ హూయ్రోస్‍; <verse eid="JHN 6:68"/><verse number="69" style="v" sid="JHN 6:69"/>“తూస్‍ దేవ్ని ఛియ్యో పరిసుద్దుడ్‍ కరి హమే విష్వాసంకరిన్” మాలం రాక్యస్‍కరి ఇనేతి బోల్యొ.<verse eid="JHN 6:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70"/>ఇనటేకె యేసు, మే తుమ్నా భారజనకరి ఎంచిరాక్యోస్నీ? తుమారమా ఏక్జనో భూత్‍ కరి ఇవ్నేతి బోల్యొ. <verse eid="JHN 6:70"/><verse number="71" style="v" sid="JHN 6:71"/>సీమోన్‍ ఛియ్యో హుయోతె ఇస్కరియోతు యూదా భారజనమా ఏక్జనురహీన్‍‍ ఇనా ధరైయిదేనుకరి థో! ఇనటేకె ఇన గుర్చినాస్ యో ఆవాతె బోల్యొ.<verse eid="JHN 6:71"/></para>
  <chapter eid="JHN 6"/>
  <chapter number="7" style="c" sid="JHN 7"/>
  <para style="s">యేసు బుజు ఇను భైయ్యె</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1"/>ఇనపాసల్‍ యూదుల్‍ యేసునా మర్రక్నూ కరి దుంఢలగమా యో యూదయమా జావకోయిని తిమ్‍ గలిలయమ పర్తురంకరాస్. <verse eid="JHN 7:1"/><verse number="2" style="v" sid="JHN 7:2"/>యూదుల్‍ను ఢేరను పండగా ఖాందె ఆవమా, <verse eid="JHN 7:2"/><verse number="3" style="v" sid="JHN 7:3"/>పన్కి ఇన భైయేఖారు ఇన‍ దేఖీన్‍ తూ కరుకరతే క్రియాల్‍ తారు సిష్యుల్‍బి దేకహఃర్కు ఆ జోగొ బేందిన్‍ యూదయామ చాలోజా. <verse eid="JHN 7:3"/><verse number="4" style="v" sid="JHN 7:4"/>బహిరంగంమా అంగీకరీంపబడవాలో యోకోన్బి ఇనుకామ్‍ ఆహ్‍క్రేతీ కర్సేకోయిని. తూ ఆకార్యమ్‍ కరుకరతోతెదె తున తూస్‍ ములక్నా దెఖాడిలాకరి బోల్యొ. <verse eid="JHN 7:4"/><verse number="5" style="v" sid="JHN 7:5"/>ఇనుస్‍ భైయ్యె హుయుతోబీ ఇనఫర్‍ విష్వాస్‍ రాక్యకోయిని.<verse eid="JHN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6"/>యేసు ఇవ్నేతి బోల్యొ, మారు వఖాత్‍ బుజుబి కోఆయుని తూమరు వఖాత్‍ కెదేబి సిద్దతార ఛా. <verse eid="JHN 7:6"/><verse number="7" style="v" sid="JHN 7:7"/>ములక్‍ తుమ్న ద్వేషించే కోయిని పన్కి, ఇను క్రియల్‍ ఖారాభ్‍ మే ఇను గూర్చి ‍సాబుత్‍ దేవుంకరుస్‍ ఇనటేకె యో మన ద్వేషించుకరస్‍ <verse eid="JHN 7:7"/><verse number="8" style="v" sid="JHN 7:8"/>తుమే పండగాన జవొ; మారు వఖాత్‍ బుజుబి పూర్తి కోహుయుని ఇనటేకె మే ఆ పండగాన హంకేస్‍ జైస్‍కోయిని, కరి ఇవ్నేతి బోల్యొ. <verse eid="JHN 7:8"/><verse number="9" style="v" sid="JHN 7:9"/>యో ఇవ్నేతి అమ్‍ బోలిన్‍ గలిలయమ ర్హైయిగొ.<verse eid="JHN 7:9"/></para>
  <para style="s">గుడారాల పండగమా యేసు జావను</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10"/>పన్కి ఇన భైయే పండగామ నికిజావమా ఇన పాస్సల్‍తి యోబి కినమాలం కొయినితిమ్‍ ఆక్రేతీ గయో. <verse eid="JHN 7:10"/><verse number="11" style="v" sid="JHN 7:11"/>పండగామ యూదుల్‍ యో కెజ్గా ఛాకరి ధూంఢు కరుకర్తథా.<verse eid="JHN 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12"/>బుజు కెత్రుకి అద్మి ఇన గుర్చి ఛాఢీబోలలగ్యు, థోడుజను యో అషల్ వాలోకరి; బుజు థోడుజను కాహేకరి; యో అద్మిఖారు మోసం కరవాలోకరి బోల్యా. <verse eid="JHN 7:12"/><verse number="13" style="v" sid="JHN 7:13"/>హుయుతోబి యూదుల్నా అధికరినా ఢరీన్‍ ఇనగురించి సభనఖామే వాతె కోబోల్యుని.<verse eid="JHN 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14"/>ఆదు పండుగా హుయిగుయు తెదె యేసు మందిర్‍మా జైన్‍ బోధించుకుర్తు థో. <verse eid="JHN 7:14"/><verse number="15" style="v" sid="JHN 7:15"/>ఇనటెకె యూదుల్ను అధికారి అష్యంహుయిన్‍ పడాను ఆవకోయినితె ఇన ఆ కింమ్‍ ఆయూకరి బోల్లిదు.<verse eid="JHN 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16"/>ఇనటెకె యేసు అమ్‍ బోల్యొ, మే కరుకరతే బోధ మారుకాహే మన మోక్లోతె ఇనూస్. <verse eid="JHN 7:16"/><verse number="17" style="v" sid="JHN 7:17"/>కోన్బి ఇన ఛిత్తమ్‍ ప్రకారం కర్నుకరి సోచిలిదాతో, తెదె యో బోధ దేవ్ని బన్తి హుయికీ నైతో, మారు మేస్‍ బోధించుకరుస్‍కీ ఇనే మాలం కర్లీసే. <verse eid="JHN 7:17"/><verse number="18" style="v" sid="JHN 7:18"/>ఇను యోస్‍ బోలవలో స్వంత మహిమ దూండు‍కరాస్‍ పన్కి ఇన మోక్లోతే ఇనీ మహిమన ధూండవలో హాఃఛోఅద్మి ఇనకన కెహూ దుర్నితీబికొయిని. <verse eid="JHN 7:18"/><verse number="19" style="v" sid="JHN 7:19"/>మోషే తుమ్న ధర్మషాస్త్రంనా దిదొకోయిన్నా? హుయుతోబి తుమారమ కొన్బి యో ధర్మషాస్త్రంనా మాలంకరకోయిని; తుమేసె మన మర్రాక్నుకరి దేఖుకరస్‍? కరి ఇవ్నేతి బోల్యొ.<verse eid="JHN 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20"/>అనటెకె అద్మినుగల్లో థూ భూత్‍ ధర్రాక్యుహుయూతెవాలో కోన్‍ తునా మర్రాక్నుకరీ దేకుకరస్ పుఛ్చావమా.<verse eid="JHN 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21"/>యేసు ఇవ్నా దేఖీన్‍ బోల్యొ, మే ఏక్ కార్యమ్‍ కర్యొ; ఇనటెకె తుమే ఖారు అష్యంహుంవుకరస్‍ <verse eid="JHN 7:21"/><verse number="22" style="v" sid="JHN 7:22"/>మోషే తుమ్న సున్నతిన అచారంనా నియమించిరాక్యోస్‍ ఆ అచారమ్‍ మోషేతిహుయుతే కాహే భాన భాన‍టేకెస్‍ హుయూ. హుయుతోబి ఆరమ్నుధన్‍ తుమే అద్మినా సున్నతి షాన కరుకరాస్‍ <verse eid="JHN 7:22"/><verse number="23" style="v" sid="JHN 7:23"/>మోషె ధర్మషాస్త్రంనా తుమే సోచ్చాతింమ్‍ ఏక్ అద్మినా ఆరమ్ను ధన్నె సున్నతీన పొంద్సె పన్కి! అమ్‍ర్హావమా మే ఆరమ్‍నుధన్నె ఏక్ అద్మినా పూర్తి స్వస్థతని గోణి ఇంనితర కర్యోకరి తుమె మారఫర్‍ చంఢాల్‍ కరుకరతె సే. <verse eid="JHN 7:23"/><verse number="24" style="v" sid="JHN 7:24"/>భార్ దెఖావతె ఇనబట్టి న్యావ్‍ తీర్చాకొయినితింమ్ న్యాయంహుయూతె న్యావ్‍నా తీర్చొకరి బోల్యొ.<verse eid="JHN 7:24"/></para>
  <para style="s">మేస్సయా ఆస్‍నా</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25"/>యేరుషలేమ్మా థోడుజను ఇవ్నె మార్రాక్నుకరి దుమ్‍డుకరతె యో ఆస్ కాహేనా? <verse eid="JHN 7:25"/><verse number="26" style="v" sid="JHN 7:26"/>హాదేక్‍ అనే బహీరంగంమా వాతె బోలుకరతోబి అనా షాత్బీ బోలకోయిని; అనే క్రీస్తుకరి అధికారుల్‍ హాఃఛితీ మాలంకరీన్‍ ర్హాసేనా. <verse eid="JHN 7:26"/><verse number="27" style="v" sid="JHN 7:27"/>హుయుతోబి అనే కెజ్గనోకి హామ్నమాలం. మెస్సయా ఆవని వఖాత్ ఇనే కెజ్గానొవాలోకి కోన్బీ మాలంకర్సెకొయిని కరి బొల్లిదు.<verse eid="JHN 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28"/>హుయుతోబి యేసునె దేవ్ని మందిరంమా బొధకర్తొహుయిన్‍ “తుమే మన మాలంకర్సు; మే కెజ్గాను వాలోకి మాలంకర్సు మారు మేస్‍ ఆయోకోయిని, మన మోక్లోతే యో హాఃఛివాలొ, ఇనా తుమే మాలంకర్సుకొయిని. <verse eid="JHN 7:28"/><verse number="29" style="v" sid="JHN 7:29"/>మే ఇనకంతు ఆయో! ఇనే మన మోక్లో అనటేకే మే ఇనా మాలంకరిస్కరి” గట్టీతి బోల్యొ.<verse eid="JHN 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30"/>ఇనటేకె ఇవ్నేఇన ధర్లేనుకరి కోసీస్‍కర్యా, పన్కి ఇను వహఃత్ బుజుబి ఆయుకోయిని అనటేకె కోన్బి ఇనా ధర్యుకొయిని. <verse eid="JHN 7:30"/><verse number="31" style="v" sid="JHN 7:31"/>బుజు అద్మియేన గల్లొమా కెత్రూకిజణు ఇనఫార్‍ విష్వాస్‍ రాకీన్‍ క్రీస్తు ఆయోతెదె అనే కర్యోతె ఇనేతీబి జాహఃత్‍ సూచక క్రియల్‍ కర్సేనా? కరి బొల్లీదు.<verse eid="JHN 7:31"/></para>
  <para style="s">యేసున ధర్లేవనాటేకె భటుల్నా మొక్లను</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32"/>అద్మియేను గళ్లో యేసును గురించి అమ్‍ భణికిలీదు పరిసయ్యుల్‍ ఖంజీన్‍ ఇవ్నె ప్రధానయాజకుల్‍ ఇనా ధర్లేవానా సైనికుల్‍నా మొక్లూ. <verse eid="JHN 7:32"/><verse number="33" style="v" sid="JHN 7:33"/>యేసు “బుజుబీ థోడుధన్‍ మే తుమారకేడె ర్హహీస్‍; పాసల్తీ మన మొక్లొతె ఇనకన జైస్. <verse eid="JHN 7:33"/><verse number="34" style="v" sid="JHN 7:34"/>తుమే మన ధూండ్సు పన్కి మాలంకర్సుకొయిని, మే కెజ్గా ర్హైస్కీ, ఎజ్గా తుమే ఆవ్సుకొయిని” కరి బోల్యొ.<verse eid="JHN 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35"/>అనహాఃజె యూదుల్‍ అప్నె అన నామాలంకరఖార్కూ తిమ్‍ అనే కెజ్గా జోమ్‍కరస్‍? గ్రీసుదేఖ్‍ వాలమా చెదిరిగుతే ఇవ్నాకన జైన్‍ గ్రీసుదేఖ్ వాలన బోధించేనా? <verse eid="JHN 7:35"/><verse number="36" style="v" sid="JHN 7:36"/>మన ధూండ్సు పన్కి మాలంకరకొయిని, మే కెజ్గా ర్హైయిస్కి, ఎజ్గా తుమె కోఆవ్సునీకరి ఇనే బోల్యొతె ఆవాత్‍ సాత్‍కరి ఇవ్నామా ఇవ్నె బోల్లీదు.<verse eid="JHN 7:36"/></para>
  <para style="s">జీవంనా దెయ్తె జలాధారల్ను పాని</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37"/>యో పండగమా మహాధన్‍హుయూతె ఆఖరునుధన్నె యేసు వుబ్రీన్‍ “కోన్బీ తరఖ్‍ లాగ్గివుసేతో మారకనా ఆయిన్‍ తరాఖ్‍ తక్‍తొల్లెవోకరి బోల్యొ. <verse eid="JHN 7:37"/><verse number="38" style="v" sid="JHN 7:38"/>మారకనా విష్వాస్‍ రాకవాలు కోన్కీ లేఖనంమా బోల్యుతిమ్‍ ఇనా పేట్ మాతు జీవంను జలాధరాల్‍ పొంగ్సేకరిస” జోరేఖు బోల్యొ. <verse eid="JHN 7:38"/><verse number="39" style="v" sid="JHN 7:39"/>ఇనకన విష్వాస్‍ రాఖావాలు పొందజాసేతే ఆత్మనా గూర్చి యో వాతె బోల్యొ. యేసు బుజుబి మహిమపరచబడ్యోకొయిని ఇనటెకె ఆత్మ బుజుబి అనుగ్రహీంపబడ్యుకొయిని.<verse eid="JHN 7:39"/></para>
  <para style="s">అద్మియేమా భేదాల్‍</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40"/>అద్మియేను గళ్లొమా థోడుజను ఆవాతేన హాఃజీన్‍ “హాఃఛిస్‍ ఆ ప్రవక్తస్‍కరి” బోల్యు.<verse eid="JHN 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41"/>“అజు థోడుజణు ఆ క్రీస్తునా” బోల్యా; బుజు థోడుజను సే? అజు థోడుజాను క్రీసు గలిలయమాతు ఆవ్సేనా? <verse eid="JHN 7:41"/><verse number="42" style="v" sid="JHN 7:42"/>క్రీస్తునే దావీద్ను జాత్మా ప్హైయిదాహుయిన్‍ దావిద్‍ థోతె బేత్లెహేమ్ కరి పట్టణం ఆవ్సేకరి లేఖనంమా బోలుకరాస్‍ కొయిన్నా. <verse eid="JHN 7:42"/><verse number="43" style="v" sid="JHN 7:43"/>అనహఃజే అన బారెమా అద్మియేను గుంబ్బల్మా భేదాల్‍ హుయు. <verse eid="JHN 7:43"/><verse number="44" style="v" sid="JHN 7:44"/>ఇవ్నమా థోడుజణు ఇన ధర్లేనుకరి సోచూ! పన్కి కోన్బి ఇన ధర్యుకొయిని.<verse eid="JHN 7:44"/></para>
  <para style="s">యూదా అధికారిల్ను అవిష్వాస్‍</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45"/>యో సైనికుల్నా ప్రధాన యాజకుల్‍ కన పరిసయ్యుల్‍ కన, ఆయాతెదె ఇవ్నె “తుమే షానటెకె ఇన బులైలీన్‍ ఆయుకోయిని” పుఛ్చావమా!<verse eid="JHN 7:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46"/>యోసైనికుల్‍ యో అద్మి బోల్యుతిమ్ కోన్బీ కెదేబి ఇమ్నితార వాతె బోల్యుకొయినికరి బోల్యు.<verse eid="JHN 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47"/>అనహఃజే పరిసయ్యుల్‍ తుమేబి మోసం హుయిగయనా? <verse eid="JHN 7:47"/><verse number="48" style="v" sid="JHN 7:48"/>“అధికారుల్మాహో పన్కి పరిసయ్యూల్మాహో పన్కి కోన్బీ అనకన విష్వాస్‍రాక్చునా? <verse eid="JHN 7:48"/><verse number="49" style="v" sid="JHN 7:49"/>ధర్మషాస్త్రం మాలంకొయింతే యోక అద్మిఖారు షాపగ్రస్తల్ హుయూకరి” ఇవ్నేతి బోల్యు.<verse eid="JHN 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50"/>ఇనఅగాఢి అనకన అయోతే నికోదేమ్ ఇవ్నామా ఏక్జనో థూ. <verse eid="JHN 7:50"/><verse number="51" style="v" sid="JHN 7:51"/>యో ఏక్‍అద్మిను వాత్‍ ఖాంజన అగాఢిస్‍ ఇనే కర్యోతె మాలంకరకోయినితె అగాఢి, అప్ను ధర్మషాస్త్రం ఇనా న్యావ్‍ తీర్చేనా? కరి పుఛ్చావమా.<verse eid="JHN 7:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52"/>యూదుల్‍ తుబి గలిలయావాలోనా? లేఖనాల్‍ పడ్యొకొయినిషూ ఏన్‍ కరిన్‍దేక్‍ గలిలయామా కెహూ ప్రవక్తాబి కోఫైదాహుసేని. <verse eid="JHN 7:52"/><verse number="53" style="v" sid="JHN 7:53"/>తెదే ఇవ్నే ఘెర్నా ఇవ్నా గాయా.<verse eid="JHN 7:53"/></para>
  <chapter eid="JHN 7"/>
  <chapter number="8" style="c" sid="JHN 8"/>
  <para style="s">వ్యభచార్‍ హుయితె బాయికొ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1"/>తెదె కిను ఘేర్కన ఇవ్నే చలీగు, పన్కి యేసు, ఒలీవలా పహాడ్‍కనా గయో! <verse eid="JHN 8:1"/><verse number="2" style="v" sid="JHN 8:2"/>యేసు బుజేఏక్‍ ధనె వ్యానేకత్రేస్‍ ఫరీన్‍ దేవ్ని మందిర్‍మా ఆవమా అద్మి హాఃరు ఇనకనా ఆయూ ఇనటేకె ఇనే భేషీన్‍ ఇవ్నా బోధించుకరా. <verse eid="JHN 8:2"/><verse number="3" style="v" sid="JHN 8:3"/>తెదె ధర్మషాస్ర్తంనా బోధించువాలు, షాస్ర్తుల్‍బీ పరిసయ్యుల్‍బీ, వ్యభిచార్‍కనా ధర్యుతే ఏక్ బాయికొ నా బులాలిఆయిన్‍ ఇన ఇచ్మా ఉభారి రాఖీన్‍.<verse eid="JHN 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 8:4"/>బోధకుడా, ఆ బాయికో వ్యభిచార్‍ కరుకరాతేదే, <verse eid="JHN 8:4"/><verse number="5" style="v" sid="JHN 8:5"/>ఎజాత్ను వాలన ఫత్రాతి భిర్కైన్‍ మర్రాక్ను కరి మోషే ధర్మ షాస్ర్తంమా ఆజ్ఞాదిరాక్యోస్‍ కాహేనా? హుయుతోబీ థూ సాత్‍ బోలుకరస్‍? కరి ఇన పుఛాయ్యా. <verse eid="JHN 8:5"/><verse number="6" style="v" sid="JHN 8:6"/>ఇన ఉప్పరస్‍ ఛాడి<note caller="+" style="f"><char style="fr" closed="false">8:6 </char><char style="ft" closed="false">కర్యోకొయింతె తప్పున కర్యోకరి బోలను </char></note> నాక్నుకరీ ఇనస్‍ ఖాహతావ్తూ అమ్నితర పుఛ్చాయు. పన్కి యేసు జుఖీన్‍ జమీన్‍ఫర్‍ అంగ్లితీ సాత్కీ లిఖ్కాలగూ.<verse eid="JHN 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 8:7"/>ఇవ్నే ఇనా బేందాకోయినితిమ్‍ బోలలాగమా యేసు మోడుపాడీన్‍ దేఖీన్‍ తుమారమా పాప్‍ కర్యుకోయింతె యో అగాడి ఇనఫర్‍ ఫత్రో నాకజాయి కరి ఇవ్నేతి బోలీన్‍ <verse eid="JHN 8:7"/><verse number="8" style="v" sid="JHN 8:8"/>బుజు జుకిన్‍ మాటీపర్‍ లీఖాలగ్యూ! <verse eid="JHN 8:8"/><verse number="9" style="v" sid="JHN 8:9"/>ఇవ్నే ఇని వాత్న ఖంజీన్‍ మోటా అద్మితూ నికీన్‍ అడ్డాణి లడ్కాలగు ఏక్ను కేడె ఏక్ బెందీన్‍ గయూ; యేసు ఎక్కస్‍జనో మిగ్లిగో యో బాయికో ఇచ్మా ఉబ్రీన్‍ రయ్యో. <verse eid="JHN 8:9"/><verse number="10" style="v" sid="JHN 8:10"/>యేసునే ముడ్‍క్యూపాడిన్‍ ఆయా ఇవ్నే కేజ్గాఛా? కోన్‍బీ తున సిక్చ నాక్యుకోయిన్నా? కరి పుఛ్చాయుతెదె!<verse eid="JHN 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11"/>యో బాయికొ కొయిని ప్రభూవా కరి బోలి అనటేకే యేసు మేబి తున సిక్చించు కొయిని; తూ జైన్‍ హంకేతు పాప్‍ నోకోకరిస్‍ కరి ఇనెతీ బోల్యొ.<verse eid="JHN 8:11"/></para>
  <para style="s">యేసు ములక్నా ఉజాళు</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12"/>బుజు యేసు మే ములాక్న ఉజాళు, మన మారకెడె చాలవాలో యో అంధారమా చాల్సేకొయిని జీవంను ఉజాలు హుయిన్‍ ర్హాసేకరి ఇవ్నేతీ బోల్యొ.<verse eid="JHN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13"/>తెదె పరిసయ్యుల్‍ తారు థూస్‍ సాబుత్‍ బొల్లెంకరస్‍; తారు సాబుత్‍ హాఃఛికాహేకరి ఇనెతీ బోలమా.<verse eid="JHN 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14"/>యేసునే మే కెజ్గాతూ ఆయోకి కెజ్గా జైయిస్కి సోచిరాక్యోస్‍; అనహాఃజె మారహాఃజె మేస్‍ సాబుత్‍ బోల్లిదొతోబి మారు సాబుత్‍ హాఃచ్ఛీస్‍; మే కెజ్గాతూ నికీన్‍ వాలంకురుస్కి, కెజ్గా జంకురస్కి తుమ్నామాలంకొయిని. <verse eid="JHN 8:14"/><verse number="15" style="v" sid="JHN 8:15"/>తుమే ఆంగ్‍బట్టి న్యావ్‍ తీర్చుకరస్‍ <verse eid="JHN 8:15"/><verse number="16" style="v" sid="JHN 8:16"/>పన్కి మే కినాబి న్యావ్ తీర్ఛీస్‍కొయిని, మే ఏక్జనో ర్హహీస్‍కొయినితింమ్‍ మేబీ, మన మొక్లొతె భా బీ ఛియ్యో అనటేకె మే బీ న్యావ్‍ తీర్చతోబి మారున్యావ్‍ హాఃఛిస్‍ <verse eid="JHN 8:16"/><verse number="17" style="v" sid="JHN 8:17"/>బుజు బే అద్మిను సాబుత్‍ హాఃఛి తుమార ధర్మషాస్ర్తంమా లిఖ్కాయ్‍రూస్‍కాహేనా! <verse eid="JHN 8:17"/><verse number="18" style="v" sid="JHN 8:18"/>మార గూర్చిన్‍ మే సాబుత్‍ బొల్లిలిదోత్‍; మన మొక్లొతె భా సబి మార గూర్చిన్‍ సాబుత్‍ బోలుకరస్‍కరి బోల్యొ.<verse eid="JHN 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19"/>తెదె యేసు ఇవ్నేతి తారో భా కెజ్గఛాకరి పుఛ్చావమా; యేసు తుమే మనతోబి, భానతోబి మారో భాతోబి మాలంకరకోయిని; మన మాలం కర్యానా మార భానబి మాలంకర్చూ కరి ఇవ్నేతి బోల్యొ.<verse eid="JHN 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20"/>ఇనే దేవ్ను మందిర్‍మా బోధాకర్తోర్హావమా పైసానకను పేట్టీనా జోగోమా ఆ వాతె బోల్యు, ఇను బాజను బుజుబి ఆయుకోయిని, పన్కి కోన్బీ అన ధర్లిదుకోయిని.<verse eid="JHN 8:20"/></para>
  <para style="s">మే జైస్‍తె జొగోమా తుమే ఆవ్సుకొయిని</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21"/>బుజు ఏక్ వఖాత్‍ ఇనే, “మే ఛలోజంక్రుస్‍; తుమే మన ధూండ్సు పన్కి, తుమార పాప్ మాస్‍ రైయిన్‍ మార్జాసు; మే జైయిస్తే జొగోమా తుమే కోఆవ్సుని” కరి బోల్యొ.<verse eid="JHN 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22"/>ఇనటెకె యూదుల్‍ అధికారల్‍ మే జేస్‍తే జోగోమా తుమే కోఆవుసునీ కరి యో బోలుకరస్‍నీ; ఇను యోస్‍ మరిజాసేనా కరి బొల్లిదు.<verse eid="JHN 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23"/>తెదే యో, “తుమే ములక్నాసంబంధించుయుహు, అద్మి మే సర్గంనా సంబంధిహుయోహో; తుమే ములక్మా సంబందించుయుహు మే ములక్ను సంబందంహుయుతే కాహే. <verse eid="JHN 8:23"/><verse number="24" style="v" sid="JHN 8:24"/>ఇనటెకె తూమరు పాపంమాతు తుమే మార్జాసు కరి తుమారేతి బోల్యోతొ, మే యోస్కరి తుమే విస్వాసం నాకర్యుతో తుమే తుమార పాప్‍ మతూస్‍ మర్జాసుకరి” ఇవ్నేతీ బోల్యొ.<verse eid="JHN 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25"/>ఇనటేకె ఇవ్నే, తు కోన్కరి ఇన పుఛ్చావమా యేసు ఇవ్నేతి, అగాడీతీ మే తుమ్న కోన్కరి బోలుకరూస్కి మేస్కరి బోల్యొ. <verse eid="JHN 8:25"/><verse number="26" style="v" sid="JHN 8:26"/>తుమ్నా లీన్‍ బోలనుబి న్యావ్‍ తీర్చానటెకెబి ఘాణు సంగతుల్‍ మన మాలం పన్కి మన బోలీమోక్లోతె యో హాఃచేలొ మే ఇనకనా ఖాంజ్యోతే సంగతుల్‍ నస్‍ ములక్‍నా బోధించుకరుస్‍ కరి బోల్యొ.<verse eid="JHN 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27"/>భానలీన్‍ యో ఇవ్నేతి బోలుకరస్కరి ఇవ్నే మాలం కోకర్యాని. <verse eid="JHN 8:27"/><verse number="28" style="v" sid="JHN 8:28"/>ఇనటెకె యేసు, తుమే అద్మినా ఛీయ్యోనా ఉపర్‍ పడ్యాతెదే యో మేస్‍కరీ, మారు మేస్‍ సాత్‍బీ కోకరిస్‍నీతిం భా మనా‍ సీకడ్యోతిమ్‍ ఆ సంగతుల్‍ బోలుకరూస్కరి తుమే మాలంకర్‍సు. <verse eid="JHN 8:28"/><verse number="29" style="v" sid="JHN 8:29"/>మన బోలీమోక్లోతె యో మారకేడె ఛా! నచ్యుతే కార్యంనా మే కెదేబి కరిస్‍ ఇనటెకే యో మన ఎకేలోస్‍ కొబెంద్యొని కరి బోల్యొ.<verse eid="JHN 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30"/>యో ఆ సంగతుల్‍నా బోల్తొ ర్హావమా కెత్రూకి జను ఇనపర్‍ విస్వాసం రాఖ్యూ.<verse eid="JHN 8:30"/></para>
  <para style="s">హాఃఛిస్‍ తుమ్నా చొఢావ్సె</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31"/>ఇనటేకె యేసు ఇనా నమ్యుతె యూదుల్మా తుమే “మారు బోధనా హాఃజీన్‍ రవ్వాలవుసేతో హాఃఛిమాస్‍ మార సిష్యుల్‍ హుయిన్‍ హాఃచినా మాలంకర్‍సూ; కరి బోల్యొ. <verse eid="JHN 8:31"/><verse number="32" style="v" sid="JHN 8:32"/>తెదే యో హాఃఛిమాస్‍ తూమ్నా స్వతంత్రులనుగా కర్‍సేకరి” బోల్యొ.<verse eid="JHN 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33"/>తెదె ఇవ్నే, హామే అబ్రాహామ్‍నా సంతానం హామే కెదేబీ కీనాబి దాసుడ్ హుయిన్‍ కోర్హయిని తుమే స్వతంత్రులనుగా రాసు కరి కిమ్‍ బోలుకరస్‍ కరి ఇనేతి బోల్యు.<verse eid="JHN 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34"/>ఇనటేకే యేసు పాప్‍ కరిహుయు హార్యేక్జను పాప్న దాసుడ్‍ కరి తుమరేతి హాఃఛితి బోలుకరాస్‍ <verse eid="JHN 8:34"/><verse number="35" style="v" sid="JHN 8:35"/>దాసుల్‍ కెదేబి ఘార్మా కోర్హయిని; ఛియ్యో హమేసాబి జివుంకరస్. <verse eid="JHN 8:35"/><verse number="36" style="v" sid="JHN 8:36"/>ఛియ్యో తుమాన స్వతంత్రుల్గా కర్యుతో తుమే హాఃఛీమాస్‍ స్వతంత్రుల్‍ హుయిన్ రాసు.<verse eid="JHN 8:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 8:37"/>తుమే అబ్రాహామ్‍నా సంతానం కరి మన మాలం హుయుతోబీ తుమారమ మార వచన్న టెకే జోగో కొయిని, ఇనటేకె మన మర్రాకన దేఖూకరాస్‍ <verse eid="JHN 8:37"/><verse number="38" style="v" sid="JHN 8:38"/>మే మార భాకన దేక్యోతే సంగతులస్‍ బోధించుకరుస్‍; యో ప్రకరమాస్‍ తుమే తుమారభా<note caller="+" style="f"><char style="fr" closed="false">8:38 </char><char style="ft" closed="false">ముల భాషమా సైతానొ ఛియ్యా</char></note> కన ఖాంజుతే ఇనస్‍ కరుకరాస్‍ ఇవ్నేతి బోల్యొ.<verse eid="JHN 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39"/>ఇనటేకె ఇవ్నే ఇనేతి హామరో భా అబ్రాహామ్ను కరి బోల్యానీ; యేసు, “తుమే అబ్రాహామ్నా లడ్కా హుయాతో అబ్రాహామ్ను కర్యోతే క్రియాలస్‍ కర్సూ.” <verse eid="JHN 8:39"/><verse number="40" style="v" sid="JHN 8:40"/>దేవ్నుకాంతు ఖాంజుతె హాఃఛినా తుమారేతి బోల్యోతె మనహంకెస్ తుమే మర్రాకన దేఖుకరస్నీ; అబ్రాహామ్ను ఇమ్‍ కోకర్యోని. <verse eid="JHN 8:40"/><verse number="41" style="v" sid="JHN 8:41"/>తుమే తుమార భాన క్రియలస్‍ కరుకరాస్‍ కరి ఇవ్నేతి బోల్యొ; ఇనటేకె ఇవ్నే హామే వ్యభిచార్వాలా ఫైదాహుయాకాహే, “దేవ్‍ ఏక్కాస్‍ హామ్నా భా బుజు హామే ఇనా లడ్కా” బోలామ.<verse eid="JHN 8:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42"/>యేసు ఇవ్నేతీ ఆమ్‍నీతర బోల్యొ; దేవ్‍ తుమరో భా హుయోతో తుమే మన ఫ్యార్‍కరసు; మే దేవ్‍కంతీ బయాలుదేరిన్‍ ఆయిరోస్‍ మారు మేస్‍ కోఆయోని, యో మన బోలిమోక్లో. <verse eid="JHN 8:42"/><verse number="43" style="v" sid="JHN 8:43"/>తుమే కిమ్‍ మారువాతేనా మాలంకోకరని? తుమే మారు బోధనా ఖంజాను తుమ్నా సహనమ్‍ కొయిని? <verse eid="JHN 8:43"/><verse number="44" style="v" sid="JHN 8:44"/>తుమే తుమార భాన వల భూత్‍ సంబందుల్‍; తుమార భాన ఆఖ్నా పురాకర్ను కరి కోరిలేవుంకరస్‍ జామానతి యో నరహంతకుడ్‍ హుయిన్‍ హాఃఛినాటెకె వుబీరోహుయో కాహే; ఇనమా హాఃఛీస్‍ కొయినీ యో ఛాడ్‍బోల్యా తెదె ఇను స్వభావమ్‍ ఛాలీన్‍ వాతె బోలస్‍; యో ఛాడ్‍ ఛాడ్న భాహుయిన్‍ ఛా. <verse eid="JHN 8:44"/><verse number="45" style="v" sid="JHN 8:45"/>మే హాఃఛినస్‍ బోలుకరూస్‍ ఇనటెకె తుమే మన నమ్మా కొయినీ. <verse eid="JHN 8:45"/><verse number="46" style="v" sid="JHN 8:46"/>మరామ పాప్ ఛాకరి తుమారమ కోన్‍ వతాల్‍సే? మే హాఃఛి బోలుకర్తో హుసేతో తుమేసే? మన నమ్మా కోనమ్యని.<verse eid="JHN 8:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 8:47"/>దేవ్నా సంభాధి హువ్వాలో దేవ్‍ను వాతేనా ఖంజాస్‍ తుమే దేవ్నా సంబంధుల్‍ కాహే ఇనటెకె తుమే కోఖంజానీ కరి బోల్యొ.<verse eid="JHN 8:47"/></para>
  <para style="s">యేసు బుజు అబ్రాహామ్ను</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48"/>ఇనటెకె యూదుల్‍ తూ సమరయుడ్నొ భూత్‍ ధర్యోతెవాలో కరి హమే బోల్యాతె వాత్‍ హఃఛిస్‍ కాహేనా. కరి ఇనేతి బోలామ. <verse eid="JHN 8:48"/><verse number="49" style="v" sid="JHN 8:49"/>యేసు మే భూత్‍ ధర్యాక్యుతే వాలో కాహే, మార భాన ఘనాపరచా వాలో; తుమే మన అవమానం కాడుకరస్ కరి బోల్యొ. <verse eid="JHN 8:49"/><verse number="50" style="v" sid="JHN 8:50"/>మే మార మహిమన ధూండుకురూ కోయిని; ధూండ్తోహుయిన్‍ న్యావ్‍ తీర్చావాలో ఏక్జను ఛా. <verse eid="JHN 8:50"/><verse number="51" style="v" sid="JHN 8:51"/>ఏక్జనో మారివాతేనా పాట్టీన్చావాలు యో కెదేబి మారణ్నా కోదెక్సేనికరి తుమారేతి హాఃఛితి బోలుకరూస్‍ కరి ఉత్తరం బోల్యొ.<verse eid="JHN 8:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52"/>ఇనటేకె యూదుల్‍ తూ భూత్‍ ధరాక్యోహుయోకరి హాంకే మాలంకర్యా; అబ్రాహామ్‍బి, ప్రవక్తాల్బీ మరీగయా; హుయితోబీ ఏక్జాను మారు వాత్‍ యో కెదేబి మారణ్నా కోదేక్సెనికరి తూ బోలుకరస్‍ <verse eid="JHN 8:52"/><verse number="53" style="v" sid="JHN 8:53"/>అప్నో భా హుయోతే అబ్రాహామ్ను మరిజాస్‍ కాహేన; ప్రవక్తల్బీ మరిజాస్నీ తూ ఇవ్నేతీబీ గొప్పవాలోసూ? తూ తార దీల్‍ కోన్‍కరీ రైయిజంక్రస్‍కరి పుఛ్చాయా.<verse eid="JHN 8:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54"/>ఇనటెకే యేసు, మారు మేస్‍ మహిమా పరిచీలిదోతో మారు మహిమాన విలువా కొయిని; హామారో దేవ్కరీ కినాలీన్‍ బోలుకరస్కీ, యో మారో భాస్‍ మన మహిమా పరుచుకరస్‍ <verse eid="JHN 8:54"/><verse number="55" style="v" sid="JHN 8:55"/>తుమే ఇన మాలంకరకొయినీ, పన్కి యో మనా మాలం; యో మన మాలంకొయినీ కరి బోల్యొతొ తుమ్మారని తరాస్‍ మే జూటీవాలొహుయిస్‍ పన్కి, మే ఇన మాలంకర్యొ, ఇని వాత్‍ఫర్‍ మే ఛాలుకరూస్‍ <verse eid="JHN 8:55"/><verse number="56" style="v" sid="JHN 8:56"/>తుమారో భా హుయోతె అబ్రాహామ్‍నా దేక్‍సు కరి ఘాను ఆనందింస్యు; యో దేఖీన్‍ ఖూషి హుసు కరి బోల్యొ.<verse eid="JHN 8:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57"/>ఇనటెకె యూదులస్ తునా “వుజుబీ అఢైహ్ః వరహ్‍ఃబీకొయిని తూ అబ్రాహామ్‍నా దేక్యనా” కరి బోలమా. <verse eid="JHN 8:57"/><verse number="58" style="v" sid="JHN 8:58"/>యేసు, “అబ్రాహామ్ను ప్హైదాహువనా అగాడ్తిస్‍ మె ఛావ్కరి తుమారేతి హాఃఛితి బోలుకరూస్కరి” బోల్యొ.<verse eid="JHN 8:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59"/>ఇనటేకె ఇవ్నే ఇనవుపర్‍ ఫేకానటెకె ఫత్రోపాడ్యో, పన్కి యేసు లాపిన్‍ దేవ్ను మందిర్ మాతీ బాధర్‍ నికిలీజాస్‍.<verse eid="JHN 8:59"/></para>
  <chapter eid="JHN 8"/>
  <chapter number="9" style="c" sid="JHN 9"/>
  <para style="s">యేసు పైదాఖ్తి ఖాణు అద్మినా నయం కరను</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1"/>యేసు వాట్‍ఫర్తూ జంకరమా తెదె పైదాఖ్ తూ ఏక్‍ కాణు అద్మి దెఖ్కాయో. <verse eid="JHN 9:1"/><verse number="2" style="v" sid="JHN 9:2"/>ఇన సిష్యుల్‍ బోధకుడ్‍ ఆ ఖాణుహుయిన్‍ ప్హైదాహువనా కోన్‍ పాప్‍కర్యూ? కరి పుఛ్చావమా, ఆకి, అన ప్హైదాకర్యతె ఆయా భానా కరి ఇనా పుఛ్చావమా.<verse eid="JHN 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3"/>యేసు అనెహో అన ప్హైదాకర్యొహొ, పాప్‍కోకర్యోని పన్కి, దేవ్ను క్రియల్‍ అన‍కన వతాలనటెకె ఆ ఖాణుహుయిన్‍ ప్హైదాహుయు. <verse eid="JHN 9:3"/><verse number="4" style="v" sid="JHN 9:4"/>ఉజాలు ర్హావయెత్రాతోడి మన బోలిమోక్లొతే ఇనుక్రియాల్‍ అప్నె కర్తూర్హాను; రాత్‍ హుయుతెదె, కొన్బి కామ్‍ కర్సెకొయినీ, <verse eid="JHN 9:4"/><verse number="5" style="v" sid="JHN 9:5"/>మె ఆ ములక్మా ర్హయ్యోతెదె ఆ ములక్మా ఉజాలుహుయిన్‍ ర్హయీస్కరి బోల్యొ.<verse eid="JHN 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6"/>యో అంబోలీన్‍ జమీన్‍ప్పర్‍ థూకీన్‍ థూక్తి ఛిక్కడ్‍ కరీన్‍ ఇనా ఢోలాప్పర్‍ ఛిక్కడ్నా లొథిన్‍; <verse eid="JHN 9:6"/><verse number="7" style="v" sid="JHN 9:7"/>“తూ సిలోయమా కోనేర్‍కనా జైన్‍ ఇన్మా ధొయిలాకరి” బోల్యొ, సిలోయమ్కరి వాత్నా అర్థం బోలిమొక్లొ. యో జైన్‍ డోలా ద్హోయిలీన్ ఢోలవాలొహుయిన్‍ ఆయొ.<verse eid="JHN 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8"/>ఇనటెకె అజు బాజును అద్మి, యో మాంగిఖావాలుకరి ఇనేతి అగాఢి దేఖ్యుహుయు ఆ బేసీన్ మాంగవాలు కాహేనా? కరి బోల్యా.<verse eid="JHN 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9"/>ఆస్కరి థొడుజనూ ఆకాహేకరి అనింతరస్‍ బుజేక్‍ జన్నుకరి అజు థోడుజను బోల్యు యోహుయితో మేస్కరి బోల్యు<verse eid="JHN 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10"/>ఇవ్నే, తునా కిమ్‍ దేఖాంకురాస్‍ కరి ఇన పుఛ్చావమా;<verse eid="JHN 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11"/>యో బోల్యు యేసుకరి ఏక్‍ అద్మి చిక్కడ్‍ కరిన్‍ మారఢోలఫర్‍ లోథిన్‍ తూ సిలోమయా కోనేర్కన జైన్‍ దోయిలాకరి మారేతి బోల్యొ; తెదె మే జైన్‍ దోయోతెదె ఖోలాయుకరి బోల్యొ.<verse eid="JHN 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12"/>ఇవ్నే, యో కెజ్గఛాకరి పుఛ్చావమా, యో కెజ్గాఛాకి మన మాలంకొయినీకరి బోల్యొ.<verse eid="JHN 9:12"/></para>
  <para style="s">పరిసయ్యూల్‍ స్వస్థతను బారెమా పుఛ్చావనూ</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13"/>తెదె ఇనేహుః అగాఢి కాణుహుయిన్‍ ఛాతె ఇనా ఇవ్నే పరిసయ్యూల్‍కనా బులైలీన్‍ గయ్యూ. <verse eid="JHN 9:13"/><verse number="14" style="v" sid="JHN 9:14"/>యేసు చిక్కడ్ కరీన్‍ ఇనా ఢోళ ఖొలాయూతె ధన్‍ ఆరమ్‍కరను ధన్‍ <verse eid="JHN 9:14"/><verse number="15" style="v" sid="JHN 9:15"/>యో కిమ్‍ నజర్న పొంద్యోకి ఇనాగూర్చిన్‍ అజేక్‍ ఛోట్‍ పరిసయ్యూల్బి ఇన పుఛ్చావమా యో, మార ఢోలాఫర్‍ ఛిక్కడ్‍ లఘాడామా మే దోయిలీన్‍ నజర్నా పోందిలిదో కరి ఇనేతి బోల్యొ.<verse eid="JHN 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16"/>హుయితోబి పరిసయ్యూల్మా థోడుజను, ఆ అద్మి ఆర్మనుధనే ఆచరించుకరస్‍ కొయిని ఇనాటెకె దేవ్కన్తు ఆయుతే అద్మి కాహేకరి బోల్యా, బుజు థోడుజను, పాప్‍హుయోతె అద్మి ఆజాత్నూ సూచక క్రియల్నా కిమ్‍ త్యోబి కరూకరస్‍కరి; ఇమాస్‍ ఇవ్నామా భేదును పడ్యాగు.<verse eid="JHN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17"/>ఇనటెకె ఇవ్నే బుజు యో కాణుఅద్మితీ యో తరా ఢోలా ఖొలాయో ఇనటేకే తు ఇనలిన్‍ సాత్‍లయిజావుంకరస్‍ కరి పుఛ్చావమా కాణు అద్మి యో ఏక్ ప్రవక్త కరి బోలస్‍<verse eid="JHN 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18"/>యో కాణు రాహీన్‍ ఢోలాన పొందోకరి యూదుల్‍ నమ్యకొయిని ఢోలనపోందుతే అద్మిను ఆయా, భా న బూలాయిన్‍ <verse eid="JHN 9:18"/><verse number="19" style="v" sid="JHN 9:19"/>కాణుహుయిన్‍ ఫైదాహుయూకరి బోల్యతె తుమారొ ఛియ్యో ఆస్నా? ఇమ్‍హుయుతో హంకె ఆకీమ్ దేఖూకరస్ కరి ఇవ్నా పుఛ్చావమా.<verse eid="JHN 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20"/>ఇనటేకె ఇను ఆయా భా బోల్యా, ఆ హామారో ఛియ్యోకరి ఆ కాణుహుయిన్‍ ఫైదాహుయోకరి హామ్న మాలం. <verse eid="JHN 9:20"/><verse number="21" style="v" sid="JHN 9:21"/>హాంకె ఆ కింమ్‍ దేఖుకరస్కీ హామ్న మాలంకోయిని; కోన్‍ అనా ఢోలాన ఖోలాయోకీ యోబి హామ్న మాలంకొయిని; పన్కి అనామాలం అనాస్‍ పుఛ్చావో <verse eid="JHN 9:21"/><verse number="22" style="v" sid="JHN 9:22"/>ఇనా ఆయాభా యూదుల్‍నా ఢరిజైయిన్‍ ఇమ్మస్‍ బోలస్‍; ఆ వుంబార్‍వలో, ఇనాస్‍ పుఛ్చావో; ఇను సంగతి యో బోల్లిసే కరి ఇనేతి బోల్యొ. <verse eid="JHN 9:22"/><verse number="23" style="v" sid="JHN 9:23"/>హుయుతోబీ ఇనా ఆయా భా, యో ఉంబ్బర్వా‍లో ఇనాస్‍ పుఛ్చావో కరి బోల్యా.<verse eid="JHN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24"/>“ఇనటెకే ఇవ్నే కాణుహుయిన్‍చ్ఛాతే అద్మినా బెంమ్మాని ఛోట్‍ బులాయ్‍ మంగాయిన్‍ దేవ్నా డరావాలోహుయోతొ మహిమపరచీన్‍; ఖాఛి బోల్కరి” బోలమా. కాణు యో పాపికీ కాహేకీ మన మాలంకొయిని,<verse eid="JHN 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25"/>“ఇనాటేకె ఏక్‍ మాత్రం మన మాలం; యో కాణు హుయిన్‍ థో. హంకే దేఖూకరస్‍ కరి” బోల్యొ.<verse eid="JHN 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26"/>ఇనటెకె ఇవ్నే, యో తునా సాత్‍ కర్యో తార ఢోలాకింమ్‍ ఖొలైగుకరి ఇనా బుజేక్‍ ఛోట్‍ పుఛ్చావమా.<verse eid="JHN 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27"/>యో కాణు, అనేఖూ అగఢిస్‍ తుమారేతి బోల్యోథో. పన్కి తుమే ఖాంజ్యాకొయిని తుమే సాన బుజేక్‍చోట్‍ ఖాఖమాజ్నుకరి ఛా? తుమేబీ ఇన‍ సిష్యుల్‍ హోనుకరి కోరిలేంక్రస్కీ ఇమ్కరి ఇవ్నేతి బోలమా.<verse eid="JHN 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28"/>ఇనాటెకె ఇవ్నే, తూస్‍ ఇనో సిష్యుడ్‍; హామే మోషేనా సిష్యుల్‍కరి బోల్యా. <verse eid="JHN 9:28"/><verse number="29" style="v" sid="JHN 9:29"/>దేవ్‍ మోషేతీ వాతె బోలాస్కరి మాలంకర్యు; పన్కి ఆ కెజ్గాతి ఆయోకి హామ్నా మాలంకొయినీ, కరి బోలీన్‍ ఇనా గట్టీతి బోల్యూ.<verse eid="JHN 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30"/>ఇనటేకె యో అద్మి, అజు యో కిజ్గాతి ఆయోకీ తుమ్నా మాలంకోయినీతె అష్యంమాస్‍; హుయుతోబీ యో మారఢోలా ఖోలాయియోకరి బోల్యొ. <verse eid="JHN 9:30"/><verse number="31" style="v" sid="JHN 9:31"/>దేవ్‍ పాపుల్ను మానవీ ఖాంజాకోయినికరి హామ్న మాలం; కోన్బీహో దైవభక్తుడ్ హుయిన్‍ ఇను చిత్తంతీస్‍ హుయుతో, యో ఇను వాత్నా హఃఛే. <verse eid="JHN 9:31"/><verse number="32" style="v" sid="JHN 9:32"/>ఫైదాకంతు యో కాణు అద్మిను ఢోలాన కోన్బీ ఖోలాయుతిమ్‍ హంకెతోడి కెదేబి కర్యుకొయిని. <verse eid="JHN 9:32"/><verse number="33" style="v" sid="JHN 9:33"/>ఆ దేవ్కంతీ ఆయుతే అద్మి నావుసేతో సాత్బీ కోకరస్నీకరి ఇవ్నేతి బోలస్‍.<verse eid="JHN 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34"/>ఇనటేకె ఇవ్నే, “తూ ఖాలి పాపిహుయిన్‍ ఫైయిదాహుయోతె; తూ హామ్నా బోధించన ఆయోసూకరి” ఇనేతి బోలీన్‍ ఇనా యాదుల్ను ప్రార్థనా జోగొమాతు బోలిమోక్లీదిదూ.<verse eid="JHN 9:34"/></para>
  <para style="s">ఆత్మీయతను</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35"/>పరిసయ్యుల్‍ ఇనా బోలిక్యులీదుకరి యేసు హాఃజీన్‍ ఇనా మాలంకర్లీన్‍ తూ అద్మినుఛియ్యానఫర్‍ విష్వాస్‍ రాఖూకరాస్నా కరి పుఛ్చావస్‍.<verse eid="JHN 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36"/>ఇనటేకె ఇవ్నే, మాలిక్‍ మే ఇనపర్‍ విష్వాసంరకనా యో కోన్‍కరి పుఛ్చావమా.<verse eid="JHN 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37"/>యేసు, తూ ఇనా దేఖుకరస్ని; తారేఖు వాతె బోలుకరతే అద్మి యోస్‍ కరి బోలస్‍<verse eid="JHN 9:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38"/>ఎత్రామాస్‍ యో, ప్రభూ, మే విస్వాసం కరుకురుస్‍ కరి బోలీన్‍ గుడ్యామేట్పర్ఆయిన్‍ ఇనా ఖాలామ్‍ కర్యొ.<verse eid="JHN 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39"/>తెదె యేసు, “దేఖో కొయిన్‍తే అద్మి యో దేక్యుకరస్, దేక్కావాలు అద్మి కాణుహుసే, కరి న్యావ్‍నా నిమిత్తంతీ యో మూలక్మా ఆయోకరి” బోలస్‍<verse eid="JHN 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40"/>ఇనటటేకె ఛాతే థోడుజను పరిసయ్యుమా ఆ వాతేనా ఖంజీన్, హామేబి కాణు అద్మిసూ కరి పుఛ్చాయా.<verse eid="JHN 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41"/>ఇనటేకె యేసు, తుమే కాణు అద్మి హుయాతో తుమ్నా పాప్‍ కోయిని పన్కి దేఖుకరస్కరి తుమే హంకే బోలిలేంక్రస్‍ ఇనటేకె తూమరు దోషసిక్చ ఉబ్రిన్‍ ఛాకరి బోల్యొ.<verse eid="JHN 9:41"/></para>
  <chapter eid="JHN 9"/>
  <chapter number="10" style="c" sid="JHN 10"/>
  <para style="s">మ్హేండన చరావాలను ఉపమానం</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1"/>మే హాఃఛిస్‍ బోలుకురూస్‍ మ్హేండను దొడ్డిమాతూ జావకొయినీతింమ్ అలాదు వాట్మాతూ ఛడీన్‍ జవ్వాలో ఛోట్టుబి లపాడవాలోహుయీన్‍ ఛా <verse eid="JHN 10:1"/><verse number="2" style="v" sid="JHN 10:2"/>దొడ్డీను వాట్మతూ జావ్వాలొ మ్హేంఢన కావ్లీహుయిన్‍ ఛా <verse eid="JHN 10:2"/><verse number="3" style="v" sid="JHN 10:3"/>ఇన ధర్వాజు కాడాస్‍ మ్హేంఢా ఇను అవాజ్నా హఃమ్జస్‍ యో ఇను ఖూద్ను మ్హేండనా నామ్‍ మ్హేలీన్‍ మైహీ బులాయిన్‍ లీన్జాస్‍ <verse eid="JHN 10:3"/><verse number="4" style="v" sid="JHN 10:4"/>బుజు యో ఇనా ఖుద్ను మ్హేండా హాఃరవ్నా మాహీ బులైలీన్‍జాస్‍ మ్హేంఢాహూః అగాడి జాస్‍ మ్హేంఢా ఇను ఆవాజ్నా మాలంకరిలేస్‍ ఇనాటెకె ఇవ్నే ఇనా కేడేజాసే, <verse eid="JHN 10:4"/><verse number="5" style="v" sid="JHN 10:5"/>అలద్వాను ఆవాజ్నా ఇవ్నే మాలంకోకరానీ ఇనటేకె ఆలద్వాన కేత్రుకరితోబి కేడేకోజైని ఇనాకంతు మిలైలిజాస్‍ కరి తూమరేతి హాఃచీతి బోలుకారుస్ కరి ఇవ్నేతి బోల్యొ.<verse eid="JHN 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6"/>ఆ ఉపమానం యేసు ఇవ్నేతీ బోలస్‍ పన్కి యో ఇవ్నేతి బోల్యోతె సంగతుల్‍ కేజాత్నుకి ఇవ్నే గ్రహించ్యా కొయిని.<verse eid="JHN 10:6"/></para>
  <para style="s">యేసుస్‍ అచ్చొ కావ్లివాలొ</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7"/>ఇనటేకే యేసు బుజేక్‍చోట్‍ మే హాఃఛిస్‍ బోలుకురస్‍ ఇవ్నేతీ బోల్యొ, మ్హేంఢాజావను ధర్వాజు మేస్‍; <verse eid="JHN 10:7"/><verse number="8" style="v" sid="JHN 10:8"/>మరేఖూ అగాడి ఆయుతే ఇవ్నేఖారు ఛోటుబి, లపడిలివ్వాలు హుయిన్‍ ఛా! మ్హేంఢా ఇన ఆవాజ్నా ఖాంజాకోయిని. <verse eid="JHN 10:8"/><verse number="9" style="v" sid="JHN 10:9"/>మేస్‍ వాట్వాలొ; మారవలనా కోన్బీ మాహీ గయూతో యో బచ్చిజావాలోహుయిన్‍ మాహీ జాతుహుయిన్‍ భాదర్‍ ఆవ్తూహుయిన్‍ ఛారో ఛార్తూరాస్‍ <verse eid="JHN 10:9"/><verse number="10" style="v" sid="JHN 10:10"/>చొట్టు, చోర్కరనబి, మర్రకనాబి, నాషనం కరనటేకె ఆవస్‍ పన్కి బుజు సానటెకేబి కోఆవని; మ్హేండనా జీవమ్‍ కలగనాటేకె ఇవ్నే సమృధ్దిగా కలగానటెకే మే ఆయోకరి తుమారేతి నిస్చయంతి బోలుకరూస్‍.<verse eid="JHN 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11"/>మే మ్హేండనా అషల్ చరావ్వాలొ; అషల్ చరావ్వాలొ మ్హేండనటెకె ఇను జాన్నబి దిసే. <verse eid="JHN 10:11"/><verse number="12" style="v" sid="JHN 10:12"/>జితగాడ్‍ మ్హేంఢాన కావిలి కాఖావాలో కాహే; ఇనటేకే మ్హేంఢా ఇను కాహే కాబట్టి జరాక్‍ ఆవాను దేఖీన్‍ మ్హేంఢానా బేందీన్‍ మిలైయిదేస్‍ జరాక్‍ యో మ్హేంఢానా ధరిన్ గాల్లీనా ఏక్‍ కారకీదేస్‍ <verse eid="JHN 10:12"/><verse number="13" style="v" sid="JHN 10:13"/>జితాగడ్‍ జీతంనాటేకెస్‍ సోచాస్‍ ఇనటెకె మ్హేంఢానా పటింకొయిన్‍తిమ్‍ మీలైయిదేస్‍ <verse eid="JHN 10:13"/><verse number="14" style="v" sid="JHN 10:14"/>మే మ్హేంఢానా ఆస్సల్‍ కావిలి కాఖావాలో; <verse eid="JHN 10:14"/><verse number="15" style="v" sid="JHN 10:15"/>భా మన కిమ్‍ మాలంకరస్‍కీ మే భాన కిమ్‍ మాలంకరుకి ఇమాస్‍ యో మార మ్హేంఢానా మాలంకరుకరస్‍ మార మ్హేంఢ మన మాలంకర్సే, బుజు మ్హేంఢానాటెకె మారు జాన్‍బి దేవుకరుస్‍ <verse eid="JHN 10:15"/><verse number="16" style="v" sid="JHN 10:16"/>ఆ మ్హేండను దొడ్డి మంధా కహేతీమ్‍ ఆలాద మ్హేంఢాను మంధా మన ఛా! ఇనబీ మే హాక్కాలిలీన్‍ ఆవుస్‍; యోమంధా మారి ఆవాజ్నా ఖాంచ్చె, తెదె గుంపుబి మ్హేంఢాన కావ్లి కాఖావాలోబీ ఉబ్రిర్హాసే. <figure style="fig" alt="Shepherd with his sheep in sheepfold" file="lb00014c.tif" size="col" copy="Horace Knowles ©" ref="10:7">మ్హేండను కాపరి ఇను మ్హేండనకేడె ర్హావను</figure><verse eid="JHN 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17"/>మే ఇనా బుజు లీన్‍ అవ్నుకరి మారు జాన్నా బేందుకరూస్‍; అనహాఃజె మారొ భా మన ఫ్యార్‍ కరూకరస్‍ <verse eid="JHN 10:17"/><verse number="18" style="v" sid="JHN 10:18"/>కోన్బీ మార జాన్‍లిసేకొయిని; మారు మేస్‍ ఇనా బేందుకరుస్‍; ఇనా బేందానటెకె మన అధికారం ఛా, అజు ఇనా పాచుఫారీన్ లేవనటేకె మన అధికారం ఛా; మార భానటెకె ఆ ఆజ్ఞాపోందుకరస్‍ కరి బోలస్‍ <verse eid="JHN 10:18"/><verse number="19" style="v" sid="JHN 10:19"/>ఆ వాతేవ్నా లీన్‍ యూదుల్‍మా బుజు భేదల్‍ పడైయిజాస్‍ <verse eid="JHN 10:19"/><verse number="20" style="v" sid="JHN 10:20"/>ఇవ్నమా కెత్రూకిజణు, యో భూత్‍ ధరాఖుతే అద్మిబి, బుజు పగల్‍ అద్మి ఇని వాతె సాన హఃమ్జకరస్‍ కరి బోల్యొ.<verse eid="JHN 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21"/>బుజు థోడుజాను ఆ భూత్‍ధరుతే రాఖువాతే అద్మిను వాతె కాహే; భూత్‍‍ కాణు అద్మిను ఢోలాన ఖోలావుసే, కరి బోల్యా.<verse eid="JHN 10:21"/></para>
  <para style="s">యేసునా ఒప్యుకొయిని</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22"/>యో థండ్నుధన్‍ ఆలాయంను ప్రతిష్ఠత<note caller="+" style="f"><char style="fr" closed="false">10:22 </char><char style="ft" closed="false">మూలభాషమా వరక్హనా ఏక్‍ఛోట్కరతె నవూధన్‍</char></note> పండుగా యేరుషలేమ్‍మా జరుగూకరాస్‍ <verse eid="JHN 10:22"/><verse number="23" style="v" sid="JHN 10:23"/>తెదె యేసు దేవును మందిర్‍మా సోలొమోన్‍ను పాందిల్నా హేట్‍ ఫరుకరామా, <verse eid="JHN 10:23"/><verse number="24" style="v" sid="JHN 10:24"/>తెదె యూదుల్ ఇనా అస్పీస్‍ మలిన్‍ హుయిన్‍ అమ్‍ బోల్యా, కెత్రాధన్‍ అనుమానంమా ర్హాస్‍? తూ క్రీస్తు హుయోతో హామరేతీ ఖూదు బొల్‍<verse eid="JHN 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25"/>అనటేకె యేసు మే మారేతి అగాడిస్ బోల్యోతొ పన్కి తుమే నమ్యాకోయిని; మే మార భాన నామ్తి కరుకరతే క్రియాల్‍ మానలిన్‍ సాబుత్ బోకుకరస్‍ <verse eid="JHN 10:25"/><verse number="26" style="v" sid="JHN 10:26"/>హుయుతోబి తుమే మార మ్హేంఢామా చేమ్‍ద్యాహుయా కాహే ఇనటెకె తుమే నమ్మాకోయిని, <verse eid="JHN 10:26"/><verse number="27" style="v" sid="JHN 10:27"/>మార మ్హేంఢా మారు ఆవాజ్‍ ఖాంమ్చే మే ఇవ్నా మాలంకరిలేవుస్‍ ఇవ్నే మారకేడె ఆవ్సే. <verse eid="JHN 10:27"/><verse number="28" style="v" sid="JHN 10:28"/>మే ఇవ్నా నిత్యజీవంనా దేవుంకురుస్‍ ఇనటెకె ఇవ్నే కెదేబి మిట్‍సే కొయిని, కోన్‍బి ఇవ్నా మార హాత్మతి ఖేఛిలిసేకొయిని. <verse eid="JHN 10:28"/><verse number="29" style="v" sid="JHN 10:29"/>యో మ్హేంఢాఖారు మన దీరాక్యోతె మారొ భా ఖారేతిబి మోటొఅద్మి. పన్కి కోన్బి మార భా నహాత్మతూ కోన్బి ఇవ్నాఛిన్వాసేకొయిని. <verse eid="JHN 10:29"/><verse number="30" style="v" sid="JHN 10:30"/>మే బి బుజు భాబి ఏక్‍హుయిన్‍ ఛియ్యేకరి బోల్యొ<verse eid="JHN 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31"/>యూదుల్‍ ఇన మార్నుకరి పత్రో హత్మా పల్లేవామా! <verse eid="JHN 10:31"/><verse number="32" style="v" sid="JHN 10:32"/>ఇనటేకె యేసునె ఇవ్నేతి అమ్‍ బోల్యొ, భాకన కంతూ కెత్రూకి అషల్ క్రియల్‍నా తుమ్న వత్లో; ఇన్మా కెహూ క్రియల్నాటెకె మన ఫత్రేఖా మార్సుకరి ఇవ్నా పుఛ్చాయో<verse eid="JHN 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33"/>యూదుల్‍ యేసుతి, తూ అద్మిర్హహీన్‍ దేవ్కన బరోబ్బర్‍కరి బొల్లేంకరస్‍; అనటెకె దేవ్నా ఛాడికరుకరాస్‍ అనటెకె తున ఫత్రాంతి మారుకర్యేస్‍ పన్కి అష్యల్‍కామ్‍ కర్యోకరికాహే కరిఇనేతి బోల్యొ.<verse eid="JHN 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34"/>అనహాఃజె యేసునె అమ్ బోల్య తుమారు ధర్మషాస్ర్తంమా తుమేస్ దేవ్కరి లిఖ్కారూస్‍కొయిన్నా? <verse eid="JHN 10:34"/><verse number="35" style="v" sid="JHN 10:35"/>లేఖనాల్ను ఫాల్తు హోనుకరి కాహేనా, దేవ్నిలేఖనాల్‍ కినా ఆవస్కి, ఇవ్నేస్‍ దేవస్కరి బోల్లిలిదుతో మే దేవ్ని ఛియ్యోకరి బోల్యోకరి, <verse eid="JHN 10:35"/><verse number="36" style="v" sid="JHN 10:36"/>భా ప్రతిష్ఠకరిన్‍ ఆ ములక్మా మొక్లొతె ఇవ్నేతి తూ దేవ్నా దూషణ కరూకరస్కరి ఇవ్నేతి బోల్యు? <verse eid="JHN 10:36"/><verse number="37" style="v" sid="JHN 10:37"/>మే మారో భా ను క్రియల్నా నా కర్యోతోతెదె మన నమ్మనొకొ. <verse eid="JHN 10:37"/><verse number="38" style="v" sid="JHN 10:38"/>కర్యొతొతెదె మన నా నమ్యతోబి భా మారఖామె మే భానఖామేబి ఛియ్యేకరి తుమే గ్రహించిన్‍ మాలంకరతిం యోక్రియల్‍నా నమ్మనాటెకె ఇవ్నేతీ బోల్యొ.<verse eid="JHN 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39"/>ఇవ్నే బుజు ఇనస్‍ ధర్నూకరి దేక్యూ పన్కి, యో ఇవ్నహాత్‍మతూ చుక్కాలీన్‍ గయో.<verse eid="JHN 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40"/>యొర్దాను నది పార్లిబజు యోహాన్‍ అగాడి బాప్తిస్మమ్‍దిదోతె జొగొమా పరీన్‍జైయిన్‍ ఎజ్గారయ్యో. <verse eid="JHN 10:40"/><verse number="41" style="v" sid="JHN 10:41"/>కెత్రూకిజణు ఇనకనా ఆయిన్‍ “యోహాన్‍ సుచకా క్రియల్‍నాబి కర్యోకొయిని, పన్కి అనగూర్చి బోల్‍తెసంగతుల్‍ హాఃఛిచిస్‍కరి” బోల్యు. <verse eid="JHN 10:41"/><verse number="42" style="v" sid="JHN 10:42"/>ఎజ్గా కెత్రూకిజణు ఇనఫర్‍ విష్వాస్‍ కర్యు.<verse eid="JHN 10:42"/></para>
  <chapter eid="JHN 10"/>
  <chapter number="11" style="c" sid="JHN 11"/>
  <para style="s">లాజర్ను మరణ్‍</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1"/>మరియకరి బుజు ఇని భేనెహుయీతె మార్త కరి ఇను గామ్‍ హుయుతె బేతనియమా ఛాతె లాజర్‍కరి ఏక్జనో రోగ్వాలో థో. <verse eid="JHN 11:1"/><verse number="2" style="v" sid="JHN 11:2"/>ఆ మరియా ప్రభువున అత్తర్‍ లగాఢీన్‍ ముడ్‍క్యాన కేహ్‍నా తేల్‍ ఇను హాతేలి నుఛ్చితే మరియనొ భై. <verse eid="JHN 11:2"/><verse number="3" style="v" sid="JHN 11:3"/>ఇని భేనె ప్రభూ, థూ లాఢ్‍కర్యొతె యో రొగ్తీ ఛాకరి, ఇనకనా వర్తమానమనా మొక్లొ.<verse eid="JHN 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4"/>తెదె “యేసు ఆ హాఃజీన్‍ ఆ రోగ్ మర్రాఖనటేకె ఆయుకొయిని పన్కి, అనటేకే దేవ్‍నో ఛియ్యో ఇనుటేకె మహిమపరచబడ్నుతింమ్ దేవ్ను మహిమనటేకె ఆయుకరి” బోల్యొ.<verse eid="JHN 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5"/>యేసునే మార్తనఫర్‍ ఇను భేనె బుజు లాజర్నా ఫ్యార్‍కర్యో. <verse eid="JHN 11:5"/><verse number="6" style="v" sid="JHN 11:6"/>ఇనే రొగాఢిహుయిన్‍ ఛాకరి మాలంహువమా, యేసు ఛాతె జొగొమా బుజు భే, ధన్‍ థో. <verse eid="JHN 11:6"/><verse number="7" style="v" sid="JHN 11:7"/>అనుపాసల్‍ ఇనే “అప్నె యూదయమా ఫరిన్‍ జయ్యేకరి” ఇ‌ను సిష్యుల్‍తి బోలమా<verse eid="JHN 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8"/>ఇ‌ను సిష్యుల్‍ బోధకుడ్‍ హంకేస్‍ యూదుల్‍ తున పత్రవ్‍తి మార్నుకరి దేకుకరస్‍ని, బుజు ఎజ్గా పరీన్‍ జియ్యానా? కరి ఇనా పుఛ్చాయా.<verse eid="JHN 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9"/>అనటేకే “యేసు, ధోపారే భార ఘంటాఛా, కాహేనా ఏక్జనో ధన్నూచాలీన్ గయో. తెదె ఆ ములక్నూ ఉజాలూ దేక్చే. పన్కి, పిస్లీన్‍ పడిజాసెకొయిని. <verse eid="JHN 11:9"/><verse number="10" style="v" sid="JHN 11:10"/>పన్కి రాత్నివఖాత్‍ ఏక్జనొ చాల్యొతెదె ఇనకనా ఉజాలుకొయిని, అనహఃజే పడిజాసేకరి” బోల్యొ. <verse eid="JHN 11:10"/><verse number="11" style="v" sid="JHN 11:11"/>ఇనే ఆ వాతె బోలీన్‍ పాసల్తీ అప్న దోస్త హుయోతే లాజర్‍ నిందార్‍మా ఛా ఇనా ఖూద్రావనటేకె జావుంకురు కరి ఇవ్నేతి బోలామ,<verse eid="JHN 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12"/>సిష్యుడ్‍ ప్రభూవా ఇనే ఖూత్యోతో అజు ఖుదర్‍సేనా కరి బోల్యొ.<verse eid="JHN 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13"/>యేసు ఇను మరణ్నఖాజే ఆ వాత్‍ బోల్యొ. పన్కి, ఇవ్నే ఇను ఖావను ఆరామ్‍నాఖాజె బోల్యుకరి రహిగు. <verse eid="JHN 11:13"/><verse number="14" style="v" sid="JHN 11:14"/>అనటేకే యేసు లాజరు మరిగొ, <verse eid="JHN 11:14"/><verse number="15" style="v" sid="JHN 11:15"/>అనహాఃజె యేసు లాజర్‍ మరిగయో, తుమే నమ్ఛుతింమ్‍ మే ఎజ్గాకోథోని, కరి తుమారబారేమా ఖుషీహుయిరోస్‍ హుయితోబి ఇనకన అప్నెజియ్యే, ఇవ్నేతి బోల్యొ.<verse eid="JHN 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16"/>అనటేకే దిదుమ<note caller="+" style="f"><char style="fr" closed="false">11:16 </char><char style="ft" closed="false">మూలభాషమా కవలలు</char></note> కరి బోలతె తోమా “బోధకుడుకెడె మరిజవాన అప్నేబి జియ్యెకరి” ఇనకెడె ఛాతె సిష్యుల్నా బోల్యు.<verse eid="JHN 11:16"/></para>
  <para style="s">యేసుస్‍ జీవమ్‍ అజు పునరుత్థానం</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17"/>యేసు ఆయిన్‍ తెదేస్‍ యో ఛార్‍ ధన్‍ సమాధిమా రయ్యోకరి మాలంకర్లిదొ. <verse eid="JHN 11:17"/><verse number="18" style="v" sid="JHN 11:18"/>బేతనియ యెరూషలేమ్‍నా హాఃమేస్‍ రైహితూ ఇనఖామే బరాబ్బర్‍ తీన్‍ మైల్‍ దూర్‍ థూ. <verse eid="JHN 11:18"/><verse number="19" style="v" sid="JHN 11:19"/>అనటేకె యూదుల్‍మా ఘనూ అద్మి ఇవ్ని భైయేనా మరాన్‍ గూర్చిన్‍ మార్తనా బుజు మరియనా ఖాంజావనటెకే ఆవ్నకన ఆయిన్‍ థా<verse eid="JHN 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20"/>తెదె మార్త, యేసు వలావాస్కరి ఖంజీన్‍ ఇన మల్నుకరి గెయి. పన్కి, మరియా ఘర్మా బేసిన్‍ తి. <verse eid="JHN 11:20"/><verse number="21" style="v" sid="JHN 11:21"/>తెదె మార్తనె యేసుతి, ప్రభువా తూ అజ్గ రయోతో మార భై మర్యోహోత్కొయిని కరి బోలి. <verse eid="JHN 11:21"/><verse number="22" style="v" sid="JHN 11:22"/>హంకేబిహొ తూ దేవ్నా సాత్‍ మాంగ్యొతోబి దేవ్‍ తునబి దెవ్వాయి జాసెకరి మే సోఛ్చిరాక్యోస్‍<verse eid="JHN 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23"/>యేసునె తారొ భై బుజు ఉట్సేకరి, బాయికోతి బోలమా<verse eid="JHN 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24"/>మార్త ఇనెతి ఆఖారి ధన్మా జీవిన్‍ ఉట్సేకరి మనమాలం.<verse eid="JHN 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25"/>అనటేకే యేసు బోల్యొ మారన్‍ మాతు జీవిన్‍హుయ్‍ర్రొతె, జివీన్‍ఛాతే మేస్‍; మన నమ్మా వాలు మరిగుతోబి జీవ్సె, <verse eid="JHN 11:25"/><verse number="26" style="v" sid="JHN 11:26"/>మారప్పర్‍ విష్వాస్‍ రాఖవాలో హర్యేక్‍జనూ కెదేబి మర్సేకోయిని. ఆవాత్‍ నమ్ముకరస్నాకరి యో బాయికోనా పుఛ్చాయో.<verse eid="JHN 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27"/>బాయికో “ఓహో, ప్రభూ తూ ములక్నాటేకె ఆవను ఛాతె దేవ్నోఛియ్యోహుయోతె క్రీస్తుకరి హమే నమ్ముకరస్కరి” ఇనేతి బోలి.<verse eid="JHN 11:27"/></para>
  <para style="s">యేసు ఆంజు కాఢను</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28"/>బద్మా మార్త ఆవాత్‍ బోలిన్‍ జైయిన్‍ బోధకుడునా; ఆయిన్‍ తున బులాంకరస్కరి ఇను భేనెహుయితె మరియానా ఆఖ్రాతీ బులాయు. <verse eid="JHN 11:28"/><verse number="29" style="v" sid="JHN 11:29"/>తెదె బాయికో హాఃజీన్‍ ఎగ్గీస్‍ ఉట్టీన్‍ ఇనకనా గయీ. <verse eid="JHN 11:29"/><verse number="30" style="v" sid="JHN 11:30"/>యేసు బుజుబి యోగామ్మా నాఆవమా మార్త ఇన మల్యాతే జోగొమాస్‍ రయ్యోథో. <verse eid="JHN 11:30"/><verse number="31" style="v" sid="JHN 11:31"/>అనహఃజే ఘర్మా మరియతీబి ర్హహీన్‍ బాయికోనా ఓదార్చుకరతె యూదుల్నా మరియ ఎగ్గీస్‍ ఉట్టీన్‍ జావను దేఖిన్‍ ఆ బాయికో గొర్రాడుకన రొవ్వానటెకె ఎజ్గా జంకరస్కరి సోచిలీన్‍ బాయికోనకెడె గయూ.<verse eid="JHN 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32"/>ఎత్రమస్‍ మరియా యేసుఛాతె జొగొకన ఆయిన్‍ ఇన దేఖిన్‍ ఇను గోడఫర్‍ పడీన్‍ ప్రభూ తూ ర్హాయోతొ మార భై మర్యోహోత్‍ కొయినీకరి బోలి.<verse eid="JHN 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33"/>యో బాయికొ రొవ్వానుబి, బాయికోనకెడె ఆయుతె యూదుల్బి రొవ్వాను యేసునె దేఖిన్‍ గబ్రాయిన్‍ ఆత్మమా కుంగావ్తో<verse eid="JHN 11:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 11:34"/>ఇన కెజ్గా రాక్యాస్‍కరి పుఛ్చావమా. ఇవ్నే ప్రభూ ఆయిన్‍ దేక్కరి ఇనేతి బోల్యొ.<verse eid="JHN 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35"/>యేసునే ఆంజు ఖాడ్యో. <verse eid="JHN 11:35"/><verse number="36" style="v" sid="JHN 11:36"/>అనటేకే యూదుల్‍ ఇన కింనితర ఫ్యార్‍కరోకి దేక్కోకరి బొల్లిదా.<verse eid="JHN 11:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37"/>హుయుతో ఇవ్నమా థోడుజను ఆ కాణోనా ఢోలాకొల్యొహొతే అనే, అన మరకొయింనితింమ్‍ కర్సెకోయిన్నా? కరి బోల్యా.<verse eid="JHN 11:37"/></para>
  <para style="s">యేసు లాజర్నా జివ్వాడను</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38"/>యేసు బుజు మహ్హీస్ బాదతి సమాధికనా అయిన్‍ కేవు గుహాను ధర్వాజునా బండో బేందిరాక్యుతు యో సమాదికనా గయో. <verse eid="JHN 11:38"/><verse number="39" style="v" sid="JHN 11:39"/>యేసునె యో బంఢోనా కనాక్కరి బోలమా, మరీగుతె ఇని భేన్‍హుయితె మార్త ప్రభూ, ఇనే మరిజైయిన్‍ ఛార్రోజ్‍ హుయ్గు. అనహఃజే వాఖ్‍ మార్సేకరి ఇనేతి బోల్యొ.<verse eid="JHN 11:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40"/>అనటేకె యేసు ఇనేతి బోల్యొ, తూ నమ్మితోతెదె దేవ్ని మహిమనా దేఖిస్‍కరి మే తారేతీ బోల్యొకొయిన్నా. <verse eid="JHN 11:40"/><verse number="41" style="v" sid="JHN 11:41"/>తెదె ఇవ్నే యో బాంఢోనా కనాక్యూ యేసునె ఢోళాపాఢీన్ “భా, తూ మారు మనవిన ఖాంజ్యో అనటేకే తూన కృతజ్ఞతల్‍ చెల్లించుకరుస్‍ <verse eid="JHN 11:41"/><verse number="42" style="v" sid="JHN 11:42"/>తూ కెదేబి మారు మనవిన ఖాంజుకరస్‍కరి మే దిల్మాకర్యాకోస్‍ పన్కి, తూ మన మొక్లోకరి అస్సిస్‍ ఉబ్రిన్‍ఛాతె ఆ అద్మిహఃర్వనా నమ్మతింమ్‍ ఇవ్నఖాజె ఆవాత్‍ బోల్యొకరి” బోల్యు. <verse eid="JHN 11:42"/><verse number="43" style="v" sid="JHN 11:43"/>యో ఇమ్నితర బోలిన్‍ లాజర్, భాధర్‍ అవ్‍కరి గట్టితి బోలమా <verse eid="JHN 11:43"/><verse number="44" style="v" sid="JHN 11:44"/>మరిగుతే యో హాత్‍ గోడా లుంగ్డవ్తీ బందాయిన్‍ భాధర్‍ ఆయో ఇను మోఢన రుమాల్‍ బాందిరాక్యుతు. తెజాత్నో యేసు తుమే “ఇను కట్లునఛోడీన్‍ జావదాకరి” ఇవ్నేతి బోల్యొ.<verse eid="JHN 11:44"/></para>
  <para style="s">యేసుఫర్‍ పాచుఫరను</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45"/>అనహాఃజె మరియకన ఆయిన్‍ ఇనే కర్యోతె కార్యల్‍నా దేక్యుతె యూదుల్మా ఘాణుజను ఇనపర్‍ విష్వాషంనరాక్యూ, <verse eid="JHN 11:45"/><verse number="46" style="v" sid="JHN 11:46"/>పన్కి ఇవ్నమా థోడుజను పరిసయ్యల్కన ఆయిన్‍ యేసు కర్యొతె కార్యాల్‍నా గూర్చి ఇవ్నేతి బోల్యు. <verse eid="JHN 11:46"/><verse number="47" style="v" sid="JHN 11:47"/>అనటేకే ప్రధాన్‍యాజకుల్‍ పరిసయ్యుల్‍ కెవ్డుకి మోటు సభనా జోడ్‍కరిన్‍ అప్నె సాత్‍కరుకరియస్‍? ఆ అద్మి కెత్రూకి సూచక క్రియల్‍నా కరుకరస్‍కి. <verse eid="JHN 11:47"/><verse number="48" style="v" sid="JHN 11:48"/>అప్నే ఇనా అమ్‍ దేక్తా గప్చూప్‍రయ్యాతో హఃరుజనూ ఇనప్పర్‍ విష్వాషం రాక్చ తెదె రోమీయుల్‍ ఆయిన్‍ అప్ను మందిర్నా, అప్నూ అద్మినా కోన్డిలిసేకరి బోల్యు.<verse eid="JHN 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49"/>హుయుతో ఇవ్నమా ఏక్జనో కయపకరి నామ్‍వాలు యోవరఖాన ప్రధాన్ యాజకుడ్ “తుమ్న సాత్బీ మాలంకొయిని” కరి బోల్యొ. <verse eid="JHN 11:49"/><verse number="50" style="v" sid="JHN 11:50"/>యో అజు, “దేహ్క్ ఖారూ నాషనంహువణూ బదుల్‍ అద్మినటెకె ఏక్ అద్మి మర్జావను అషల్ ఆ తుమ్న సోచిలేంకరస్‍” కరి ఇవ్నే బోల్యొ. <verse eid="JHN 11:50"/><verse number="51" style="v" sid="JHN 11:51"/>ఇను యోస్‍ అమ్‍ బోల్యో కొయిని పన్కి, యోవరఖ్ నా ప్రధాన్‍యాజకుడ్‍ హుయిన్‍ థో <verse eid="JHN 11:51"/><verse number="52" style="v" sid="JHN 11:52"/>అనటేకే యేసు “యో యూదుల్నా‍టేకెస్ కాహేతింమ్‍ నాసిగుతే దేవ్ని జానమ్‍ ఏక్నితర జమకరనాటేకె, మరణాటేకె హుయిన్‍ ఛా” కరి ప్రవచించ్యో.<verse eid="JHN 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53"/>యుదా అధికారుల్‍ యో ధ‍న్తూ నిఖీన్‍ ఇవ్నే యేసున మర్రాక్నూకరి సోచలగూ. <verse eid="JHN 11:53"/><verse number="54" style="v" sid="JHN 11:54"/>అనహాఃజె యేసునె తెప్తూధరిన్‍ యూదియామా భాధర్‍ పరకొయినీతింమ్‍ ఎజ్గాతూ నిఖీన్‍ ఝాడినూ హాఃమేను జొగొమా ఛాతె ఎఫ్రాయికరి గామ్మా జైయిన్‍ ఎజ్గా ఇను సిష్యుల్‍నాకేడె మలీన్‍ రయ్యో.<verse eid="JHN 11:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55"/>బుజు యూదుల్ను పస్కాపండగను ధన్ హాఃమేహుయిన్‍ రయ్యూ. అనహాఃజె కెత్రూకిజణు ఇవ్నే యినూ సుద్ధి కర్లేవనటేకె పస్కానుపండగ ఆవకొయింతె అగాఢీస్‍ గామ్తూనికిన్‍ యెరూషలేమ్మా ఆయూ. <verse eid="JHN 11:55"/><verse number="56" style="v" sid="JHN 11:56"/>ఇవ్నే యేసునా ధూండ్తూహుయిన్‍ మందిర్‍మా ఉబ్రీన్‍ తుమ్న సాత్‍ సోఛ్చుకరాస్‍? ఇనే పండగనా ఆవ్సే కోయినా సానటేకెకరి ఎక్తి ఏక్‍ బొలిదా. <verse eid="JHN 11:56"/><verse number="57" style="v" sid="JHN 11:57"/>పన్కి, ప్రధానయాజకుల్బీ పరిసయ్యల్బీ ఇనే ఎజ్గా ఛాతె కినాబిమాలంహుయుతో హమే ఇనా ధర్లేవనాటెకె హమ్నా మాలంకరావోకరి ఆజ్ఞదిన్‍ రయ్యో.<verse eid="JHN 11:57"/></para>
  <chapter eid="JHN 11"/>
  <chapter number="12" style="c" sid="JHN 12"/>
  <para style="s">బేతనియమా యేసునా తేల్‍ లోథను</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1"/>అనటేకె యేసు యో మర్రణ్‍మతూ ఉట్టాడెతె లాజర్‍ థోతే బేతనియమా పస్కాపండగనా ఛో ధన్‍ అగాఢీస్‍ ఆయు. <verse eid="JHN 12:1"/><verse number="2" style="v" sid="JHN 12:2"/>ఎజ్గా ఇన ఖానునా బణయు, మార్త వడ్డించుకరాస్‍ లాజర్ ఇనేతి ధాన్‍ఖావన భేషుతె ఇవ్నమా ఏక్జనో. <verse eid="JHN 12:2"/><verse number="3" style="v" sid="JHN 12:3"/>తెదె మరియ కంసేకంను మోల్ను హుయుతే అత్తర్నా ఆదులీటర్నూ అఛ్చు జటామాంసిను ఝాడు ఖాడుతే విలుహుయుతే సుంగంధను తేల్‍ యేసున గోఢన లగాఢీన్‍ ఇను మాథను ఖేహ్‍తి ఇను గోఢనా నుఛ్చీన్‍ యో ఘర్మా అత్తర్‍ను వాఖ్‍తి భరైగు. <verse eid="JHN 12:3"/><verse number="4" style="v" sid="JHN 12:4"/>ఇను సిష్యుల్‍మతో ఏక్జనో కతో ఇన ధరాలిసేకరి ఛాతె ఇస్కరియోతు యూదా! <verse eid="JHN 12:4"/><verse number="5" style="v" sid="JHN 12:5"/>ఆ అత్తర్‍సాన తీన్‍ఖో దేనారాల్‍నా ఏఛీన్‍ గరీబ్నా దిదుకొయినికరిబోల్యొ. <verse eid="JHN 12:5"/><verse number="6" style="v" sid="JHN 12:6"/>యోఅమ్‍ బోల్యొతె గరీబ్‍ప్పర్‍ ష్రద్దహుయిన్‍ కాహేపన్కీ ఇనే ఛోర్‍రైహిన్‍ ఇనకన రప్యాను సంచిరవ్వామా ఇన్మా నాక్యూహు ఛోర్‍కర్తొహుయిన్‍ ఆయో అనటెకె ఇంమ్‍ బోల్యొ.<verse eid="JHN 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7"/>అనహాఃజె యేసు మన సమాధికరనూ ధన్మా గుర్తునితర బాయికోనా ఆ‍మ్నితరా కరదా; <verse eid="JHN 12:7"/><verse number="8" style="v" sid="JHN 12:8"/>యేసు అమ్‍ బోల్యొ గరీబ్‍ కెదేబి తుమారకన ర్హాసే పన్కి, మేకెదేబి తుమారకెడె రైహిస్‍కొయిని. <figure style="fig" alt="Alabaster jars" file="hk00142c.tif" size="col" copy="Horace Knowles ©" ref="12:8">మోల్ను అత్తర్ను షీసి.</figure><verse eid="JHN 12:8"/></para>
  <para style="s">లాజర్ ఫర్‍ ఫాచుపరను</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9"/>అనహఃజే యూదుల్మా గోప్ప అద్మిమ ఇనే ఎజ్గా ఛాకరి మాలంకరీన్‍ యేసున దేఖనా ఖాజేస్‍ కాహేతింమ్‍ మర్రాణ్‍మతూ యో ఉట్టాడొతె లాజర్నబీ దేఖనా ఆయూ. <verse eid="JHN 12:9"/><verse number="10-11" style="v" sid="JHN 12:10-11"/>హుయుతే ఇనగూర్చి యూదుల్‍మా కెత్రూకిజనూ ఇవ్నా హఃరనబెందీన్‍ యేసుఫర్‍ విష్వాస్‍రాక్యూ. అనటెకె ప్రధానయాజకుల్‍ లాజర్‍నబి, మర్రాక్‍నుకరి సోచు.<verse eid="JHN 12:10-11"/></para>
  <para style="s">యెరూషలేమ్మా గోప్ప సందఢితి గయో</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12"/>పాసల్‍ధన్‍ పస్కాపండగన ఆయుతె కెత్రూకి జనాభో యేసు యెరూషలేమ్‍మా వలావస్కరి హాఃజీన్‍ <verse eid="JHN 12:12"/><verse number="13" style="v" sid="JHN 12:13"/>తెదె ఖర్జూరంను డాలియాన ధర్లీన్‍ ఇన మల్నూకరి జైయిన్‍ హోసన్నా! ప్రభువున నామ్తీగ వలావతె ఇష్రాయేల్‍నో రాజో ఆషిర్వాధించబడదా కరి ఛిక్రాన్‍ బేంద్యూ. ఇన మాలనాటేకె గయూ<verse eid="JHN 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14"/>సీయోన్ను ఛోరి, ఢర్నొకో, హదేక్‍ తారో రాజో ఘదేఢను చెల్కాఫర్‍ బేసిగయో<verse eid="JHN 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15"/>లేఖనాల్మా లిఖ్కారుతిమ్‍ యేసు</para>
  <para style="q2" vid="JHN 12:15">ఏక్ న్హాను ఘదేడను చెల్కాన</para>
  <para style="q2" vid="JHN 12:15">మాలంకరీన్‍ ఇనఫర్‍ వలోవాస్‍<verse eid="JHN 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16"/>ఇను సిష్యుల్‍ ఆవాత్‍ అగాడి గ్రహించకొయిని పన్కి, యేసుని మహిమ హుసెతెదె ఇనగూర్చిన్‍ లిక్కారుకరి, ఎత్రే‍స్‍ కాహెతిమ్‍ ఇవ్నె కర్యూతే ఇనుగూర్చి హఃయల్‍ కర్లీదు.<verse eid="JHN 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17"/>యో లాజర్‍న సమాధిమతూ బులాయిన్‍ మరణ్‍మతూ ఇన ఉట్టాడోతెదె, ఇనకెడె తూతె అద్మి ఇను గురించి సాబుత్ బోల్యు. <verse eid="JHN 12:17"/><verse number="18" style="v" sid="JHN 12:18"/>అనహాఃజె యో అద్భదాల్‍ కర్యోకరి అద్మియే ఖాంజిన్‍ ఇన మలనటెకె గయూ.<verse eid="JHN 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 12:19"/>అనహాఃజె పరిసయ్యుల్‍ ఏక్ను ఏక్ అప్ను కోసిష్‍ ఖారు‍ కింమ్ పా‍ల్తూ హుయుగయూతె దెక్కో. హదేక్‍ ములక్‍ఖారు ఇనపిటె చలిగయూకరి బొల్లిదు.<verse eid="JHN 12:19"/></para>
  <para style="s">యూదుల్‍ కాహేతెవాలు యేసునకేడె జావను</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20"/>యో పండుగమా ఆరాధన కర్నూకరి యేరుషలేమా ఆయూతె ఇవ్నమా థోడుజనూ గ్రీసుమా రైతు. <verse eid="JHN 12:20"/><verse number="21" style="v" sid="JHN 12:21"/>ఇవ్నే గలిలయమా బేత్సయిదను హుయుతె చెంద్యు హుయు ఫిలిప్పుకన ఆయిన్‍ “ఖాయాబ్‍” హమే యేసున దేఖ్నూకరి ఇవ్నేతి బోల్యు.<verse eid="JHN 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22"/>ఫిలిప్పునే ఆయిన్‍ అంద్రెయతి బోల్యూ, తెదె అంద్రెయబి ఫిలిప్పునే ఆయిన్‍ యేసుతి బోల్యా. <verse eid="JHN 12:22"/><verse number="23" style="v" sid="JHN 12:23"/>అనటెకేస్‍ యేసు ఇవ్నేతి అంబోల్యొ అద్మినఛియ్యో మహిమపొందనుతూతె వక్హత్‍ ఆయ్రూస్‍ <verse eid="JHN 12:23"/><verse number="24" style="v" sid="JHN 12:24"/>ఘౌను బింజోళ జమిన్‍ప్పర్‍ పఢీన్‍ నామర్యూతొ ఆ ఎక్కాస్‍హుయిన్‍ ర్హైజాసె ఆ మర్యూతొ తెదె ఘణూ పాయిదోనా దిసే ఖాఛితంతి బోలుకరుస్‍ <verse eid="JHN 12:24"/><verse number="25" style="v" sid="JHN 12:25"/>ఇను జాన్న ఫ్యార్‍కరవాలో ఇన గమాయ్‍లిసే, ఆ ములక్మా ఇన జాన్నా దూషణకరవాలో నిత్యజీవంనటెకె ఇన బఛ్చాయ్‍లిసేకరి తుమారితి ఖాష్చితి బోలుకరూస్‍ <verse eid="JHN 12:25"/><verse number="26" style="v" sid="JHN 12:26"/>ఏక్జనో మన ప్రచార్‍ కరుకురతెదె మారకెడె ఆవ్ను తెదె మే కెజ్గా రవుస్‍కి మార సేవకుడ్‍బి ర్హాసె, ఏక్జనొ మనసేవకర్యొతొ మార భా ఇన ఘనపర్చాసె.<verse eid="JHN 12:26"/></para>
  <para style="s">యేసు మరణ్ బారెమా బోలను</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27"/>హంకె మార జాన్‍ గబ్రాతు ర్హంకరస్‍ మే సాత్‍బోల్లీస్? భా ఆ వఖాత్‍ నాఆవునుతింమ్‍ మన బఛ్చాడ్‍ “హుయుతోబి అనహఃజేస్ మే ఆ వఖాత్‍నా ఆయోతె, <verse eid="JHN 12:27"/><verse number="28" style="v" sid="JHN 12:28"/>భా తారు నామ్నా మహిమపరచిలాకరి బోల్యొ” ఎత్రాస్మా మే ఇన మహిమపరిచోతొ బుజూ మహిమ పరిచిస్కరి ఆకాష్మతూ ఏక్ ఆవాజ్‍ ఆయూ.<verse eid="JHN 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29"/>అనహాఃజె ఎజ్గా ఉబ్రీన్‍ ఖాంజుతె అద్మిఖారు ఇజ్లీకరి బోల్యు. బుజు థోడుజను “దేవ్నుదూత ఏక్జనొ ఇనేతి వాతె బోల్యుకరి” బోల్యు.<verse eid="JHN 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30"/>అనటేకె యేసు బోల్యొ ఆ అవాజ్‍ మారటేకె ఆయుకొయిని, తుమారటెకేస్‍ ఆయూ. <verse eid="JHN 12:30"/><verse number="31" style="v" sid="JHN 12:31"/>హంకె ఆ ములక్‍నా న్యావ్‍హుంకరస్‍ తెదె ఆ ములక్‍ను అధికారివాలొ భాదర్‍ దక్లాయ్‍జాసె <verse eid="JHN 12:31"/><verse number="32" style="v" sid="JHN 12:32"/>“మే ఆ జమిన్‍మతో ఉప్పర్‍ గయ్యొతెదె అద్మిఖారవనా మారఖాందె ధపాయ్‍లీస్‍కరి” బోల్యొ. <verse eid="JHN 12:32"/><verse number="33" style="v" sid="JHN 12:33"/>తెదె ఇనే కిమ్నితర మరణ్న పొందుకరస్కి, సూచించిన్‍ యో ఆవాత్‍ బోల్యొ. <verse eid="JHN 12:33"/><verse number="34" style="v" sid="JHN 12:34"/>అద్మిన గళ్లో, కెదేబి ర్హాసేకరి ధర్మషాస్ర్తంమా బోలను హఃమ్‍జ్యా. అద్మినఛియ్యో ఉప్పర్‍ పడయ్‍జాసెకరి తూ బోలుకరతె సంగతి సాత్‍? అద్మినఛియ్యో ఇనే కోన్కరి యో పుఛ్చాయో.<verse eid="JHN 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35"/>అనటెకె యేసు బోల్యొ, బుజూ థోడుధన్‍ ఉజాళు తుమార మద్యమా ర్హాసే రాత్‍ తుమారప్పర్‍ కమ్మినాఖకొయినితింమ్‍ తుమ్న ఉజాలు రయ్యూతెదేస్‍ ఛాలో రాత్‍మా ఛాలవాలొ యో కెజ్గా జంకరస్‍కీ మాలంకరకొయిని. <verse eid="JHN 12:35"/><verse number="36" style="v" sid="JHN 12:36"/>తుమ్న ఉజాలు సంబందహుయుతింమ్‍ తుమ్న ఉజాలురయ్యూతెదేస్‍ ఉజాలుమా విష్వాస్‍రాకొకరి ఇవ్నేతి బోల్యొ.<verse eid="JHN 12:36"/></para>
  <para style="s">విష్వాస్‍ కొయింతె అద్మియే</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37"/>యేసు ఆ వాత్‍బోలీన్‍ జైయిన్‍ ఇవ్నా దెఖ్కావకొయినీతింమ్‍ లపీన్‍రవ్వామా, యో ఇవ్నహఃమే ఎత్రూ సూచక క్రియల్‍ కర్యొతోబి ఇవ్నేఇనా విష్వాస్నా రాక్యాకొయిని.<verse eid="JHN 12:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JHN 12:38"/>ప్రభూ, హమారు సమాచార్‍నా నమ్మవాలో యోకోన్‍?</para>
  <para style="q2" vid="JHN 12:38">ప్రభూవును, కువ్వత్‍ కినా బయల్‍పర్చబడూ?</para>
  <para style="q1" vid="JHN 12:38">కరి ప్రవక్తహుయోతె యెషయా</para>
  <para style="q2" vid="JHN 12:38">బోల్యొతె వచన్‍ నెరవేర్చునుతింమ్‍ అమ్‍ హుయు.<verse eid="JHN 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39"/>అనహాఃజె ఇవ్నే నమ్యకొయిని, సానకతో ఇవ్నే ఢోలాతి దేఖిన్‍ దిల్మా గ్రహించీన్‍ మనస్సున బద్లాలీన్‍ దేవ్ను బాజు ఫారిన్‍ దేక్యాహోత్తొ స్వస్థతబడ్నుతింమ్‍<verse eid="JHN 12:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40"/>యో ఇవ్నా ఢోలనా</para>
  <para style="q2" vid="JHN 12:40">అంధారు కరీన్‍ ఇవ్న దిల్నా</para>
  <para style="q1" vid="JHN 12:40">కఠినంకర్లిదు కరి యెషయా</para>
  <para style="q2" vid="JHN 12:40">అజేక్ జోగొమ బోల్యొ.<verse eid="JHN 12:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41"/>యెషయానె ఇను మహిమన దేక్యోకరి ఇన గూర్చీన్ ఆ వాతె బోల్యొ.<verse eid="JHN 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42"/>ఇను అధికార్‍మాబీ కెత్రూకిజణు ఇనప్పర్‍ విస్వాష్‍న రాక్యు పన్కి, న్యావ్‍కరను జోగొ తూ నఖాడిదేస్కికరి పరిసయ్యుల్‍న ఢరీన్‍ ఇవ్నే ఒప్యుకొయిని. <verse eid="JHN 12:42"/><verse number="43" style="v" sid="JHN 12:43"/>ఇవ్నే దేవ్న్కంతూ ఆవతె మహిమతీబి అద్మికంతు ఆవతె మహిమనస్‍ జాఖాత్‍ ఫ్యార్‍కరుయుతె.<verse eid="JHN 12:43"/></para>
  <para style="s">యేసును వాతెను భన్తీ న్యావ్‍</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44"/>తెదె యేసు గట్ట్ తి చిక్రీన్‍ అమ్‍బోల్యొ, మారప్పర్‍ విష్వాస్‍నరాఖవాలొ మారమ ఖాహే మన మొక్లోతె ఇనస్‍ప్పర్‍ విష్వాస్‍ రాఖుకరాస్‍ <verse eid="JHN 12:44"/><verse number="45" style="v" sid="JHN 12:45"/>మన దేఖవాలొ మన మొక్లొతెయినస్‍ దేకుకరస్‍ <verse eid="JHN 12:45"/><verse number="46" style="v" sid="JHN 12:46"/>మారమ విస్వాస్‍నరాఖవాలొ హర్యేక్‍జణు అంధారమా ఉబ్రిన్‍ నార్హానుతింమ్‍ మే ఆ ములక్‍మా ఉజాళుహుయిన్‍ ఆయ్‍ర్హోస్‍<verse eid="JHN 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47"/>కోన్బి మారివాతెన హాఃమ్జీన్‍ ఇన నాపాటించతోతెదె మే ఇన న్యావ్‍ తిర్చీస్‍ కొయిని మే ఆ ములక్మా న్వావ్‍ తీర్చన ఆయోకొయిని పన్కి ములక్‍నా బఛ్చావనటెకేస్‍ ఆయోతొ <verse eid="JHN 12:47"/><verse number="48" style="v" sid="JHN 12:48"/>మన దక్లినాఖీన్‍ మారు వాతేన అంగీకరించకొయింతె ఇవ్నా న్యావ్‍ తీర్చీన ఏక్జనో ఛా మే బోల్యొతె వాతెస్ ఆఖరిధన్‍మా ఇనా న్యావ్‍ తీర్చే.<verse eid="JHN 12:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 12:49"/>కింమ్‍కతో మారు మేస్‍ వాతెకోబోలుకరుని; మే సాత్‍బోలునుకి సాణి వాతెబోలునుకి ఇనగూర్చీ మన మొక్లోతె భాస్‍ మనజ్ఞనా దిరాక్యోస్‍ <verse eid="JHN 12:49"/><verse number="50" style="v" sid="JHN 12:50"/>బుజు ఇను ఆజ్ఞ నిత్యజీవంకరి మన మాలం. అనటేకే మే బోలుతె సంగతుల్ భా మారేతి బోల్యొ తిమ్మస్‍ బోలుకరూస్‍కరిబోల్యు.<verse eid="JHN 12:50"/></para>
  <chapter eid="JHN 12"/>
  <chapter number="13" style="c" sid="JHN 13"/>
  <para style="s">యేసు సిష్యుల్ను గోఢ ద్హొవను</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1"/>యో ఆ ములక్‍మతూ భా కన జావనుతూతె వహఃత్‍ ఆయుకరి యేసునె పస్కాపండగను అగాఢిస్‍ మాలంకర్యోహుయిన్‍ ములక్మాఛాతె ఇవ్నుఖారవ్‍నా ఫ్యార్‍కరిన్ ఇవ్నా ఆఖరితోడి ఫ్యార్‍కర్యో.<verse eid="JHN 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2"/>యేసుబి ఇను సిష్యుల్‍ ధాన్‍ ఖంకరమా ఇన ధర్యాయ్‍దేనుకరి సీమో‍న్ను ఛియ్యోహుయోతె ఇస్కరియోతు యూదను దిల్‍మా భూత్‍నె అనేఖుఅగాఢి ఖాయల్‍ పైదాకర్యాకొ అనటేకే <verse eid="JHN 13:2"/><verse number="3" style="v" sid="JHN 13:3"/>భానె ఇనహాత్మా సమస్తంనా హాత్మా దెవ్వాఢి రాక్యోస్‍కరి, ఇనే దేవ్కంతూ నాకిన్‍ ఆయోకరి, దేవ్కన జావను ఛాకరి యేసు మాలంకరిన్‍; <verse eid="JHN 13:3"/><verse number="4" style="v" sid="JHN 13:4"/>ధాన్‍ ఖావను ఎజ్గాతూఉట్టీన్‍ ఉప్పర్‍ను లుంగ్డానా ఫార్‍బెందీన్‍ ఏక్ టువాల్‍ పల్లీన్‍ కంబర్‍నా బాందిలిదో. <verse eid="JHN 13:4"/><verse number="5" style="v" sid="JHN 13:5"/>తెదె గిన్నిమా పాని నాకిన్‍ సిష్యుల్‍ను గోఢ దొవ్వానటెకె, ఇనే కంబ్బర్‍న బాందిరాక్యోతె టువాల్‍తీ సిష్యుల్నా నుఛ్చనటేకె సురుకర్యూ.<verse eid="JHN 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6"/>అమ్‍కర్తూ యో సీమోన్‍ పేతుర్‍కన ఆయుతెదె ఇనే ప్రభూ, తూ మార గోఢన దొయిస్నా? కరి ఇనేతి బోల్యొ.<verse eid="JHN 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7"/>అనటెకె యేసు బోల్యు, మే కరుకరతె హంకె తుమ్న మాలంకొహుసేని పన్కి హంకేతునికిన్‍ మాలంకర్లిసుకరి ఇనేతి బోలమా.<verse eid="JHN 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8"/>పేతుర్‍ “తూ కెదేబి మార గోఢన నోకొదొవ్” కరి ఇనేతి బోల్యు. అనటెకె “యేసు మే తార గోఢనా దొయ్యోతొతెదె, తూ మారేతి సిష్యుడ్నిహుయీన్‍ కోరహీస్ని” కరి బోల్యు.<verse eid="JHN 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9"/>సీమోన్‍ పేతుర్‍ “ప్రభూ, మారగోఢస్‍ కాహేతింమ్‍ మారహాత్, మార‍ ముడ్‍క్యూనాబి దోవ్కరి” ఇనేతి బోల్యొ.<verse eid="JHN 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10"/>యేసు ఇన దేఖీన్ బోల్యొ పాని నొయ్యుతె యో బుజు కాయిబి దొవ్వాను అవసరంకొయినీ, యో కేవలమ్‍ పవిత్రుడుహుయో. “తుమేబి పవిత్రుల్‍ పన్కి తుమారమా ఖారు పవిత్రులు కాహేకరి” బోల్యు. <verse eid="JHN 13:10"/><verse number="11" style="v" sid="JHN 13:11"/>యేసునా ధరాయ్‍ దెవ్వాలొన మాలంకర్యొ అనటెకె తుమారమా ఖారు సుద్ద్ కాహెకరి ఇనే బోల్యొ.<verse eid="JHN 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12"/>ఇవ్ను గోఢన దొయ్యీన్‍ ఇను ఉప్పర్ను లుంగ్డఫర్‍ నాఖను పాసల్తీ, యో బుజు బేసీన్‍ మే తుమ్న కర్యోతె కామ్‍ తుమ్న మాలంహుయూనా? <verse eid="JHN 13:12"/><verse number="13" style="v" sid="JHN 13:13"/>“బోధకుడ్కరి, ప్రభూకరి తుమె మన బులాంకరస్‍; మే బోధకుడ్కరి ప్రభూకరిబి అనటేకె ఇమ్ బులావనూ న్యాయమస్‍. <verse eid="JHN 13:13"/><verse number="14" style="v" sid="JHN 13:14"/>అనహాఃజె ప్రభూబి, బోధకుడ్‍హుయోతె మే తుమారు గొఢ ధొయ్యోతొతెదె తుమేబీ ఏక్‍ను గోఢన ఏక్ దొవ్వును” బోల్యొ. <verse eid="JHN 13:14"/><verse number="15" style="v" sid="JHN 13:15"/>మే తుమ్న కర్యొతింమ్‍ తుమేబి కర్నూకరి తుమ్న మాదిరింతరా అమ్‍ కర్యొ. <verse eid="JHN 13:15"/><verse number="16" style="v" sid="JHN 13:16"/>దాసుడ్‍ ఇను యజమానితీబి గొప్పవాడ్‍ కాహె, మొక్లిరాక్యొతె ఇన మొక్లోతె ఇనేతీబి గొప్పవాడ్‍ కాహేకరి తుమారితి ఖాఛితి బోలుకరూస్‍. <verse eid="JHN 13:16"/><verse number="17" style="v" sid="JHN 13:17"/>ఆ సంగతుల్‍ తుమె మాలంకర్యాకస్‍ అనహాఃజె ఆహాఃరు కర్యతొ తుమె ధన్యుల్‍ హుషు.<verse eid="JHN 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18"/>తుమ్నా హాఃరవ్నా బారెమా మే బోలు కరూకొయిని; మే చూణిరాక్యొతె ఇవ్నా మాలంకర్యాక్యోస్‍ పన్కి మారేతి బేసీన్‍ ధాన్‍ఖాహదొహో మనస్‍ పాచుపర్యాన్‍ ఇను వైరీహుయీన్‍ ఛా. కరి లేఖనాల్‍ నెరవేర్చన అంనితర జరిగ్యూ. <verse eid="JHN 13:18"/><verse number="19" style="v" sid="JHN 13:19"/>హుయుతెదె మేస్‍ యోకరి తుమే నమ్మతింమ్‍ యోహువకొయింతె అగాఢిస్‍ తుమారితి బోలుకరూస్‍. <verse eid="JHN 13:19"/><verse number="20" style="v" sid="JHN 13:20"/>మే కినా మొక్లుస్‍కి ఇన చెరాయ్‍లెవాలొ మన చెరాయ్‍ లావాలోహుసె; మన చేర్చాయ్‍లావాలొ మనమొక్లొతె ఇనబి చేర్చాయ్‍లావాలొహుసెకరి తుమారితి ఖాఛితి బోలుకరూస్‍కరి ఇవ్నేతి బోల్యొ.<verse eid="JHN 13:20"/></para>
  <para style="s">యేసు ధర్యాయ్‍ దేవాలను బారెమా బోలను</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21"/>యేసు ఆవాత్‍ బోలీన పాసల్‍ ఆత్మమా గబ్రాయిన్‍ తుమారమా ఏక్జనో మన దర్యాయ్‍దిసె తుమారేతి హాఃఛితి బోల్యకరి రూఢిమ్‍తర బోల్యు.<verse eid="JHN 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22"/>యో కినబారెమా అమ్‍నితర బోల్యొకి కరి సిష్యుల్‍ సందేహంహూతు ఏక్ను బాజు ఏక్జను దేక్తూ రవ్వామా. <verse eid="JHN 13:22"/><verse number="23" style="v" sid="JHN 13:23"/>ఇను సిష్యుల్‍మా యేసు ఫ్యార్‍కర్యోతె ఏక్జనో యేసున హఃమే బేసిన్‍ ర్హంకరమా. <verse eid="JHN 13:23"/><verse number="24" style="v" sid="JHN 13:24"/>అనహాఃజె కినబారెమా యో బోల్యొకి ఆ హమ్నా బోల్‍కరి సీమోన్‍కరి బోల్వాతే పేతుర్‍ ఇన సైగకర్యో.<verse eid="JHN 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25"/>ఇనే యేసున బుజుఖాందె లగ్గిన్‍ ప్రభూ, యోకోన్కరి ఇనపుఛ్చాయో.<verse eid="JHN 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26"/>అనహాఃజె యేసు బొల్యొ మే రొట్టాను టుక్డా డుబాయిన్‍ కిన దేవ్‍స్కి యోస్కరి బోలీన్‍ ఏక్ టుక్డోన డుబాయిన్‍ సీమోన్‍ ఛియ్యోహుయోతె ఇస్కరియోతు యూదన దిదో; <verse eid="JHN 13:26"/><verse number="27" style="v" sid="JHN 13:27"/>ఇనే యో టుక్డోన లెంకరస్మా సాతాన్‍ ఇనమా గయూ. యేసు తూ కరుకరాతె ఎగ్గిస్‍ కర్కరి ఇనేతి బోలమా. <verse eid="JHN 13:27"/><verse number="28" style="v" sid="JHN 13:28"/>యో సానఖాజె ఇనేతి ఇంమ్‍ బోల్యుకి ఆ ధాన్‍ ఖావన బేష్యుతె ఇవ్నమా కినాబి మాలంకోహుయూని. <verse eid="JHN 13:28"/><verse number="29" style="v" sid="JHN 13:29"/>రప్యాను సంచి యూదకనా తూ అనహాఃజె పండగన ఇవ్నా హోనుతె రాఛున లీలకరిబితోబి, గరీబ్న సాత్బీ దా! కరితోబి యేసు ఇవ్నేతి బోలన్‍తార థోడుజను ర్హైయిగు.<verse eid="JHN 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30"/>ఇనే యో ముక్కన లీన్ ఎగ్గీస్‍ భాదర్‍ చలిగయో; తెదె రాత్నువఖాత్‍.<verse eid="JHN 13:30"/></para>
  <para style="s">నవూ ఆజ్ఞ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31"/>యూదా చలీజావన పాసల్‍ యేసు అంమ్‍బోల్యు, హంకె అద్మినఛియ్యో మహిమ పరచబడిన్‍ ఛా; దేవ్బి ఇనపర్‍ మహిమ పరచబడిన్‍ ఛా <verse eid="JHN 13:31"/><verse number="32" style="v" sid="JHN 13:32"/>దేవ్‍ ఛియ్యోన ఖామే మహిమ పరచబడితొ, దేవ్‍ ఇనఖామే ఇన మహిమపరస్చే; ఎగ్గిస్‍ ఇన మహిమపరస్చే. <verse eid="JHN 13:32"/><verse number="33" style="v" sid="JHN 13:33"/>లడ్కా అజుబి థోడుధన్‍ తుమారితి ర్హహీస్‍ తుమే మన దుమ్‍డ్చూ మేకెజ్గా జైయిస్కి ఎజ్గా తుమే ఆవ్సుకొయిని మే యూదుల్తి బోల్యొతిమ్మస్‍ హంకె తుమారితిబి బోలుకరూస్‍ <verse eid="JHN 13:33"/><verse number="34" style="v" sid="JHN 13:34"/>తుమే ఏక్న ఏక్ ఫ్యార్‍కర్లేనుకరి మే తుమ్న ఫ్యార్‍కర్యో తిమ్మస్‍ తుమేబి ఏక్న ఏక్ ఫ్యార్‍కర్లేనుకరి తుమ్న నవూ ఆజ్ఞన దెమ్‍కరూస్‍ <verse eid="JHN 13:34"/><verse number="35" style="v" sid="JHN 13:35"/>తుమే ఏక్న ఏక్ ఫ్యార్‍కరవాలహుయోతొ అనబట్టీనస్‍ తుమే మార సిష్యుల్‍కరి ఖారుజనుబి మాలంకర్‍లిసెకరి బోల్యు.<verse eid="JHN 13:35"/></para>
  <para style="s">పేతురు అగాఢీస్‍ ఛాడ్‍ బోల్‍సేకరి యేసు బోలను</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36"/>సీమోన్‍ పేతుర్‍ “ప్రభూ, తూ కెజ్గా జంకరస్కరి” ఇనేతి పుఛ్చావమా, యేసు మే జంకరతె జొగోమ తూ హంకె ఆయిస్‍ కొయిని పన్కి, పాసల్తీ ఆయిస్కరి ఇనేతి బోల్యు.<verse eid="JHN 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37"/>అనహాఃజె పేతుర్‍ ప్రభూ, మే సానటెకె హంకె తారకెడె ఆయిస్‍ కొయిని తారటెకె మార జాన్‍న బేందీస్‍కరి ఇనేతి బోలమా.<verse eid="JHN 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38"/>యేసు బోల్యొ, తూ మారటెకె తార జాన్నా బేందీస్‍నా? మే కోన్కి మాలంకొయినీకరి తీన్‍ఛోట్‍బోలన అగాడి ముర్గు వ్హాక్చేకొయినికరి తారేఖూ హాఃఛితి బోలుకరూస్‍ కరి బోల్యొ.<verse eid="JHN 13:38"/></para>
  <chapter eid="JHN 13"/>
  <chapter number="14" style="c" sid="JHN 14"/>
  <para style="s">యేసుస్‍ దేవ్నుకన జావన వాట్‍</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1"/>యేసు ఇవ్నేతి బోల్యొ, తూమరు దిల్మా చింతానోకో పడాదిసు; దేవ్‍పర్‍ వీస్వాసం రాకొ మారఫర్‍బీ విస్వాష్‍ రాకో. <verse eid="JHN 14:1"/><verse number="2" style="v" sid="JHN 14:2"/>మారు “భాను” ఘార్మా కెత్రుకి జీవాను ఛా, నావుసెతో తుమారేతి బోలిస్‍; తుమ్నా జొగొ సిధ్దాపరచానటెకె అగాఢి జంకురూస్‍ <verse eid="JHN 14:2"/><verse number="3" style="v" sid="JHN 14:3"/>మే జైన్‍ తుమ్నా జొగో సిధ్దాపరిచ్చాతో మే ర్హాయోతే జొగొమా తుమేబి ర్హావహఃర్కూ బుజు ఆయిన్‍ మారకనా ర్హావనటేకె తుమ్నా బులైలీజైస్‍ <verse eid="JHN 14:3"/><verse number="4" style="v" sid="JHN 14:4"/>మే జంకరూతె జొగోను వాట్ తుమ్నా మాలంహుసె.<verse eid="JHN 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5"/>ఇనటేకె “తోమా ప్రభూ కెజ్గా జంకరస్కి” హంనా మాలంకోయిని; యో వాట్‍ హంనా కిమ్‍ మాలంపడ్సే కరి ఇనా పుఛ్చావమా.<verse eid="JHN 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6"/>యేసు ఇవ్నేతి బోల్యొ, మేస్‍ మారగ్‍బీ హాఃఛిబి, జివంబి; మారవలస్‍ తప్ప కోన్బి భాకన కోఅవ్సేని. <verse eid="JHN 14:6"/><verse number="7" style="v" sid="JHN 14:7"/>తుమే మన మాలంకరిరాక్యాతో మార భానబీ మాలంకర్సు; హంకేతీ లీన్‍ తుమే ఇనా మాలంకరుసు, బుజు ఇనా దేక్కిరాక్యస్‍ కరి బోల్యొ.<verse eid="JHN 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8"/>తెదే ఫిలిప్పు బోల్యొ, ప్రభూ భాన హమ్నా వతాల్‍ హామ్నా యోస్‍ బైస్‍ కరి బోల్యొ.<verse eid="JHN 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9"/>తెదె “యేసు ఫిలిఫ్పుతీ బోల్యొ, మే అత్రాధన్‍ తుమార కనా ర్హాయోతొబీ తూ మన మాలంకొకర్యనీ సూ? మన దేక్కావాలు భానబీ దేకిరాక్యుస్‍ ఇనాటెకె ‘భాన హమ్నా వాతల్కరి’ కిమ్‍ బోలుకరస్‍? <verse eid="JHN 14:9"/><verse number="10" style="v" sid="JHN 14:10"/>పిలిప్పు భాకనా మే, మరాకనా భా ఛా కరి తూ నమ్ముకరా కోయినిసూ? మే తుమారేతి బోలుకరుతే ఆ వాతె మారు ఖూద్ను మేస్‍ కోబొలుకరుని భా మారమా ర్హాతోహుయిన్‍ ఇనా క్రియల్‍నా కరూకరస్‍ కరి” సిష్యుల్తి బోల్యొ. <verse eid="JHN 14:10"/><verse number="11" style="v" sid="JHN 14:11"/>భా కనా మే మారకనా భా ఛియ్యేకరి ఆవాత్నా నమ్మో; నైయితొ క్రియల్నాతోబి నిమితంతోబి మన నమ్మో.<verse eid="JHN 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 14:12"/>మే భా కనా జావుంకురుస్‍ ఇనటెకే మే కరుతె క్రియల్‍ మారప్పర్‍ విస్వాష్‍ రాఖవాలనబీ కర్‍సే, ఇనేతిబీ బుజు ఇనెతిబి గోప్ప యో కర్సేకరి తుమారేతి ఖాఛితి బోలుకురూస్‍ <verse eid="JHN 14:12"/><verse number="13" style="v" sid="JHN 14:13"/>తుమే మార నామ్‍మా కెహూ మాంగ్‍సుకి మల్సె, భా ఛియ్యోనాకన మహిమపరచనటెకేస్‍ ఇనకర్సే. <verse eid="JHN 14:13"/><verse number="14" style="v" sid="JHN 14:14"/>మార నామ్తీ తుమే మారకన సాత్‍ మాంగితోబి మే కరిస్‍.<verse eid="JHN 14:14"/></para>
  <para style="s">పరిషుద్ధాత్మను బారెమా వాగ్దానం</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15"/>తుమే మన ఫ్యార్‍కర్యతోతెదె మార ఆజ్ఞన్‍లా మాలంకర్సు. <verse eid="JHN 14:15"/><verse number="16" style="v" sid="JHN 14:16"/>మే భాన వేడిలేవుంకరు, తుమారకనా హమేసా ర్హావనటేకె యో అలాదు మద్దత్‍ కరవాలో, దిస్యే. <verse eid="JHN 14:16"/><verse number="17" style="v" sid="JHN 14:17"/>ఇనే దేవ్ను హాఃఛిన బయల్పర్చనటేకె ఆత్మహుయీన్‍ ఛా, ములక్‍ ఇనా కేదెబి కోదేక్నారుని, యో ఇవ్నామాలం ఇనాటేకె తుమే ఇనా గుర్తుధరస్‍ యో తుమరేతి నివసింసే, తుమారమా రాసే.<verse eid="JHN 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18"/>తుమాన అనాదుతరా కోమేదిస్ని తుమారకనా థొడు ధన్నా బాద్మా ఆయిస్‍ <verse eid="JHN 14:18"/><verse number="19" style="v" sid="JHN 14:19"/>ఆ ములక్‍ మనా అజు కేదేబి దేక్సెకొయిని. హుయితొ తుమే మనా దేక్సు, పన్కి బుజు తుమే మన దేక్సూ, మే జిమ్‍క్రూతె ఇమ్‍ తుమేబి జివ్సూ. <verse eid="JHN 14:19"/><verse number="20" style="v" sid="JHN 14:20"/>యో ధన్ ఆయుతెదె, మే మార భాకనా ఛావు కరి, తుమే మరాకన మే తుమారకనా ఛియ్యేకరి యో ధన్నా తుమే మాలంకర్సు.<verse eid="JHN 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21"/>మార ఆజ్ఞాల్‍నా అంగీకారించీన్‍ ఇవ్నామాలంకర్య హుయోస్‍ మన ఫ్యార్‍వాలో. మన ఫ్యార్‍కరవాలో మార భాతి ఫ్యార్‍హుయు బడ్సే మేబి ఇనా ఫ్యార్‍కరస్‍; మనాబి ఇవ్నా ఓపిలిసే కరి బోలాస్.<verse eid="JHN 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22"/>యూదా ఇస్కరియోతు కాహేతె బుజెక్‍ యుదా, ప్రభూ తూ ములక్నా కాహేతీమ్‍ హమారు హామ్నాస్‍ తారు తునా దెఖాడిలేవను సే? పుఛ్చావమా.<verse eid="JHN 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23"/>తెదె యేసు ఇవ్నా బోల్యొ, ఏక్జాను మన ఫ్యార్‍కరతే యో మారి బోధా గ్రహించే తెదె మారో భా ఇనా ఫ్యార్‍కరస్‍; హమే ఇనకనా ఆయిన్‍ ఇనా ఖందె నివాసం కరుసు. <verse eid="JHN 14:23"/><verse number="24" style="v" sid="JHN 14:24"/>మన ఫ్యార్‍కరకొయిన్‍తే వాలో మారి బోధనా ఖాంచేకొయిని; తుమే ఖాంజుకరతె బోధ మారి బోధ కాహే మన మోక్లోతే భాను బోధ.<verse eid="JHN 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25"/>మే తుమారకనా థో. తెదేస్‍ ఆ వాతె ఖారి తుమారేతి బోల్యొ థో. <verse eid="JHN 14:25"/><verse number="26" style="v" sid="JHN 14:26"/>ఆదరణకర్త, కతో భాన నామ్తీ బోలిమోకల్సేతే పరిసుద్ధాత్మ, సమస్తంనా తుమ్నా బోధించీన్‍ మే తుమారేతి బోల్యోతే సంగతుల్‍ ఖారూబి తుమ్న‍ హఃయాల్‍ కరావ్సే.<verse eid="JHN 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27"/>షాంతినా తుమ్నా అనుగ్రాహీంచీన్‍ జంకరూస్‍; మార షాంతినస్‍ తుమ్నా అనుగ్రాహీంచుకరుస్‍; ములక్‍ దేవుంకరస్‍ తీమ్‍ మే తుమ్నా అనుగ్రాహించుకరుస్‍ కోయిని, తుమారు దిల్నా బాధనొకొ పడాదేవో బుజు కినాబి నొకొదిసూ. <verse eid="JHN 14:27"/><verse number="28" style="v" sid="JHN 14:28"/>మే జైన్‍ తుమారకన పాఛ్చు ఆయిస్‍ కరి బోల్యోతే వాత్‍ తుమే ఖాంజ్యా కోయినా భా మరేతిబి గోప్ప వాలొ ఇనటెకె తుమే మన ఫ్యార్‍కర్యతో మే భాకనా జావుంకురుస్‍ కరి తుమే ఖూషిహుసు. <verse eid="JHN 14:28"/><verse number="29" style="v" sid="JHN 14:29"/>ఆ సంగతి హువాకొయిన్‍తే అగాడి తుమే నమ్మును కరి యో సంభావించనా అగాఢీస్‍ తుమారేతి బోలుకారుస్‍ <verse eid="JHN 14:29"/><verse number="30" style="v" sid="JHN 14:30"/>హంకెతూ తుమారేతి జాహఃత్‍ వాత్‍కోబోలిస్ని; ఆ ములక్ను అధికారి ఆవుంకరస్‍; మారేతి ఇనా సంబంధమ్‍ కాయ్బి కొయిని. <verse eid="JHN 14:30"/><verse number="31" style="v" sid="JHN 14:31"/>హుయుతోబి మే భాన ఫ్యార్‍కరుకరస్‍; ములక్నా మాలంకరును తిమ్‍ భా ఆజ్ఞాపించోతె హువతోడి మే అమ్మస్‍ కరిస్‍ ఉట్టో అజ్గాతి జైయే.<verse eid="JHN 14:31"/></para>
  <chapter eid="JHN 14"/>
  <chapter number="15" style="c" sid="JHN 15"/>
  <para style="s">హాఃఛ్చి ద్రాక్చాను రహ్‍ః</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1"/>యేసు బోల్యొ; మే హాఃఛిహుయోతె ద్రాక్చావల్లీ. మారో భా ఖేతర్‍వాలొ. <verse eid="JHN 15:1"/><verse number="2" style="v" sid="JHN 15:2"/>మారమా ఫలించకొయింతె హర్యేక్‍ డాలిన ఇన కత్రీన్‍ ఫేకిదిసె; ఫలించతె హర్యేక్‍ డాల్లి బుజు ఘణు ఫలించానటెకె, ఇన్మతూ ఫాల్తు డాలినా ఛాట్టినాక్చే. <verse eid="JHN 15:2"/><verse number="3" style="v" sid="JHN 15:3"/>మే బోల్యోతే వాతేవ్నా లీన్‍ తుమే పవిత్రుల్‍ హుయిన్‍ ఛా. <verse eid="JHN 15:3"/><verse number="4" style="v" sid="JHN 15:4"/>మార మ్హాడ్తి వుబ్రిన్‍ ర్హవో; తుమార మ్హాడ్తి మేబి వుబిర్హావుస్‍ ద్రాక్చావలిమా డాల్లి ఉబ్రిన్‍ ర్హాయితోస్‍ గాని ఇనుయోస్‍ కింకోఫలించానికి ఇంమాస్‍ మారమా వుబ్రిన్‍ ర్హాయితోస్‍ కాని తుమేబి ఫలించుకోయిని.<verse eid="JHN 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5"/>ద్రాక్చావల్లి మే, డాల్లియే తుమె, కినా మ్హాడ్తి వుబ్రిన్‍ ర్హాసుకి యో జాఖాత్‍ ఫలించే; మారేతి దుర్‍ ర్హాయిన్‍ తుమే కైయ్‍బి కొర్నారునీ. <verse eid="JHN 15:5"/><verse number="6" style="v" sid="JHN 15:6"/>కోన్బి మారభానె వుబ్రిన్‍ నార్హాయితొ యో డాలినిజోక్‍ భాధర్‍ పెకైజైన్ హూఃకాయిజాసే; అద్మియే జోక్నా తోఢిన్‍ ఆగ్మా నాఖాదిసే, బుజు యో బలిజాసే. <verse eid="JHN 15:6"/><verse number="7" style="v" sid="JHN 15:7"/>మారమ తుమే తుమరా మారి వాతె వుబ్రిన్ ర్హాయితోస్‍ తుమ్న కెహూ ఇష్టంకీ మంగో, యో తుమ్న మల్సె. <verse eid="JHN 15:7"/><verse number="8" style="v" sid="JHN 15:8"/>తుమే ఘాణు ఫలించానవల మారో భా మహిమ పరచాబడ్సే; ఇనటేకె తుమే మార సిష్యుల్‍ హూసు.<verse eid="JHN 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9"/>భా మన కిమ్‍ ఫ్యార్‍కర్యోకి మేబి తుమ్నా ఇమ్మాస్‍ ఫ్యార్‍కరిస్‍ మార ఫ్యార్‍‍ఫర్‍ వుబ్రిన్‍ ర్హావొ. <verse eid="JHN 15:9"/><verse number="10" style="v" sid="JHN 15:10"/>మే మార భా ను ఆజ్ఞాల్‍నా మాలంకరిన్‍ ఇనా ఫ్యార్‍మా వుబ్రిన్‍ ఛావుతే లపట్మా తుమేబి మారు ఆజ్ఞాల్నా మాలంకర్యాతెదె మారు ఫ్యార్‍మా వుబ్రిన్ ర్హాసు.<verse eid="JHN 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11"/>తుమారకన మారు ఖుషి ర్హానుకరి, అజు తుమారు ఖుషి పురా భర్తి హోనుకరి ఆ సంగతుల్‍ తుమారేతి బోలుకరూస్‍ <verse eid="JHN 15:11"/><verse number="12" style="v" sid="JHN 15:12"/>మే తుమ్నా ఫ్యార్‍కర్యొతే ప్రకారం తుమేబి ఏక్నుయేక్‍ ఫ్యార్‍ కర్నూకరి ఆస్‍ మారు ఆజ్ఞా. <verse eid="JHN 15:12"/><verse number="13" style="v" sid="JHN 15:13"/>ఇను దొస్తుల్‍నటేకె; ఇను జాన్‍ భేమ్‍దావాలుకనా అజు కేవు మహాన్‍ ఫ్యార్‍ ర్హావ్వాలు కోయిని. <verse eid="JHN 15:13"/><verse number="14" style="v" sid="JHN 15:14"/>మే తుమ్నా దిదోతె ఆజ్ఞాల్‍నా కర్యాతో, తుమే మార దొస్తుల్‍ హుయిన్‍ ర్హాసూ. <verse eid="JHN 15:14"/><verse number="15" style="v" sid="JHN 15:15"/>హంకేతు మే తుమ్నా దాసుడ్‍కరి కొబొలిస్నీ, సానకతొ దాసుడ్‍నా మాలంకోయినికి ఇనొ యజామనుడ్‍ సాత్‍ కరస్కి; పన్కి మేతొ తుమ్నా దొస్తుల్‍ కరి బోల్యొ; సానకతొ మే యో వాతెఖారుబి మార భా కనా ఖాంజోతె; యో హాఃరుబి తుమాన బొల్దిదొ. <verse eid="JHN 15:15"/><verse number="16" style="v" sid="JHN 15:16"/>తుమే మన ఏర్పచిరాక్యకోయిని, తుమే మార నామ్తీ భా సాత్‍ మాంగాస్‍కి యో ఇనా దేవ్యాజాసే తీమ్‍ తుమె జైన్‍ ఫలించానటెకె తుమారు ఫల్‍ ఉబ్రరావ ఖార్కు మే తుమ్నాఎంచీ రాక్యోస్‍ <verse eid="JHN 15:16"/><verse number="17" style="v" sid="JHN 15:17"/>తుమే ఏక్నుయేక్‍ ఫ్యార్‍ కర్నుకరి ఆ సంగతుల్‍నా తుమ్నా ఆజ్ఞదెంకరూస్‍.<verse eid="JHN 15:17"/></para>
  <para style="s">ములక్‍ ద్వేషించను</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18"/>ములక్‍ తమ్నా ద్వేషించ్యాతో; తుమారేతిబి అగాడి మన ద్వేషించు కరాస్కరి తుమ్నమాలంహుసే <verse eid="JHN 15:18"/><verse number="19" style="v" sid="JHN 15:19"/>తుమె ములక్నా సంబందుల్‍హుయీన్‍ ర్హాయితో ములక్‍ తుమాన ఫ్యార్‍ కర్సె హుయితోబి తుమే ములక్‍ సంబందుల్‍ కాహే మే తుమ్నా ములక్‍మాతు ఎంచిలిదో; ఇనటెకే ములక్‍ తుమ్న ద్వేషించుకరస్‍ <verse eid="JHN 15:19"/><verse number="20" style="v" sid="JHN 15:20"/>దాసుడ్‍ ఇను యాజమానుడ్‍తిబి మహాన్‍ అద్మి కాహేకరి, మే తుమారేతి బోల్యోతే వాతె ఖాయాల్‍ కరిలేవొ; ములక్‍వాలు మన హింషిన్‍చ్యాతో తుమానబి హింషింసే; మారు వాతె మాలంకర్యాతొ తుమారు వాతేనాబి మాలంకర్సె. <verse eid="JHN 15:20"/><verse number="21" style="v" sid="JHN 15:21"/>హుయితో ఇవ్నే మన బోలిమోక్లోతె ఇనా మాలంకోకార్యని; ఇనటేకె మార నామ్మా నిమిత్తంతి ఆఖారవ్నాతుమ్నా కరూస్‍<verse eid="JHN 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 15:22"/>మే ఆయిన్‍ ఇవ్నా నాబోధించిన్‍ ర్హయతొ, ఇవ్నా పాప్‍ దూషణ కొర్హాసేని; పన్కి హంకెతూ ఇవ్ని పాప్మనువాట్‍ చుఖ్కావనా అవకాసం కొయిని. <verse eid="JHN 15:22"/><verse number="23" style="v" sid="JHN 15:23"/>మన ద్వేషించవాలో మార భానబి ద్వేషించుకరస్‍ <verse eid="JHN 15:23"/><verse number="24" style="v" sid="JHN 15:24"/>కోన్బి కార్యుకోయినితే క్రియాల్‍ మే ఇవ్నా ఇచ్మా నాకార్యోతో ఇవ్నా పాప్‍ దూషణ హుసేకోయిని; హంకేతో ఇవ్నే మనాహో మార భానాహో దేకిన్‍ ద్వేషించుకరాస్‍ <verse eid="JHN 15:24"/><verse number="25" style="v" sid="JHN 15:25"/>పన్కి మన కారణంకొయినితింమ్‍ ద్వేషించు కరి ఇవ్నా ధర్మషాస్త్రంమా లిఖారుతే వాక్యం హుయుతిమ్‍ అమ్నితరా హుసే.<verse eid="JHN 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26"/>భా కంతూ తుమారకనా మద్దత్‍కరవాలొ మోక్లాయిస్‍ కతో భా కంతు ఏక్‍ నిక్యొతె దేరుతే హాఃఛిబోలతె ఆత్మా ఆయుతెదె మార బారెమా సాబుత్నా దిసే. <verse eid="JHN 15:26"/><verse number="27" style="v" sid="JHN 15:27"/>తుమే అగాడితి లీన్‍ మరాకన ర్హాయుహుయు కరి. ఇనాటేకె తుమేబి సాబుత్‍ బోల్చు.<verse eid="JHN 15:27"/></para>
  <chapter eid="JHN 15"/>
  <chapter number="16" style="c" sid="JHN 16"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1"/>తుమే విస్వాష్‍మా ఉబ్రిన్‍ ర్హానుకరి ఆవాతె తుమారేతి బోలుకరూస్‍ <verse eid="JHN 16:1"/><verse number="2" style="v" sid="JHN 16:2"/>ఇవ్నే తుమ్న న్యావ్‍కరను జోగొమతూ మొక్లిదిసె; తుమ్న మరాఖిదెయితె హర్యేక్‍ జాణు యో దేవ్నా సేవా కరూకరస్‍ కరి సోచ్చాను ధన్ ఖాందే ఆంకరస్‍ <verse eid="JHN 16:2"/><verse number="3" style="v" sid="JHN 16:3"/>ఇవ్నే భాన మన మాలంకోకర్యస్‍ని ఇనటేకె అమ్‍కర్సె. <verse eid="JHN 16:3"/><verse number="4" style="v" sid="JHN 16:4"/>హుయితో యో జర్గానువఖాత్‍ ఆయుతెదె మే ఇనా గుర్చి తుమ్నా బోల్యొ థో కరి, తుమే హఃయల్‍ కరిలేవా హఃర్కు ఆ సంగతుల్‍నా తుమారేతి బోలుకరూస్‍.</para>
  <para style="s" vid="JHN 16:4">పరిషుద్ధాత్మను కామ్‍</para>
  <para style="p" vid="JHN 16:4">పన్కి మేబి తుమరాకేడె థో ఇనటేకె అగాఢీస్ తుమ్నా ఆ కోబోల్యొని. <verse eid="JHN 16:4"/><verse number="5" style="v" sid="JHN 16:5"/>హంకే మన బోలిమోక్లోతే ఇనకనా జావుంకురుస్‍ తూ కిజ్గా జావుంకరస్‍ కరి హంకేలాగు తుమారమా ఏక్జనూబి కోపుఛ్చాయుని. <verse eid="JHN 16:5"/><verse number="6" style="v" sid="JHN 16:6"/>పన్కి మే ఆ సంగతుల్‍ తుమ్నా బొలమా తుమారు దిల్ ఘాణు దుఃఖాంతి భార్యయిన్‍ ఛా, <verse eid="JHN 16:6"/><verse number="7" style="v" sid="JHN 16:7"/>అజు మే తుమారేతి హఃఛిస్‍ బోలుకరూస్‍ మే ఛలిజావను తుమ్న అష్యాల్‍; మే ఛలిగొతో మద్దత్‍ కరవ్వాలు తుమారకన కోఆవుసేని; మే గయోతో ఇనా తుమరాకన బోలిమోక్లిస్‍ <verse eid="JHN 16:7"/><verse number="8" style="v" sid="JHN 16:8"/>యో ఆయోతెదె పాప్నా గూర్చిబి, నీతి బారెమాబి, బుజు దేవ్ను న్యావ్‍ను గూర్చి, ములక్ను అద్మియెనా ఒప్పిలేవా హఃర్కూ, కర్సే. <verse eid="JHN 16:8"/><verse number="9" style="v" sid="JHN 16:9"/>ములక్ను మారహఃమే విస్వాష్‍ కోరాక్యుని, సానకతో ఇవ్ను పాప్‍న మాలంకోకర్యని. <verse eid="JHN 16:9"/><verse number="10" style="v" sid="JHN 16:10"/>మే వుజు భా కనా జంకరూస్‍ తుమే బుజు మన కోదేక్సుని పన్కి నీతిన కోమాలంకర్యూని. <verse eid="JHN 16:10"/><verse number="11" style="v" sid="JHN 16:11"/>ఆ ములక్‍ను అధికారి న్యావ్‍ అగాఢీస్‍ పోందిరాక్యుస్‍ ఇనటెకె న్యావ్‍ తుమే అర్థంకోకరూకరని.<verse eid="JHN 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12"/>మే తుమారేతి బొలాను వుజుబి కెత్రూకి సంగతుల్‍ ఛా, పన్కి హంకే తుమే ఇవ్నా ఖామల్‍చుకొయిని. <verse eid="JHN 16:12"/><verse number="13" style="v" sid="JHN 16:13"/>బుజు యో, కతో దేవ్ను హాఃఛినా మాలంకరవాతె ఆత్మ ఆయుతో తుమ్న స్వరసత్యంమా ఛలావ్సే; యో ఇనుయోస్‍ సాత్బి నాబోధించీన్‍ కెహూ హఃమ్జస్కి ఇనాస్‍ బోధించి జర్గజాసెతే సంగతుల్‍నా తుమ్నా మాలంకరసే. <verse eid="JHN 16:13"/><verse number="14" style="v" sid="JHN 16:14"/>యో మారమతు థోడుకడిన్‍ లీన్‍ తుమ్నా మాలం కరవ్సే, ఇనటెకే మన మహిమా పరచాస్‍ <verse eid="JHN 16:14"/><verse number="15" style="v" sid="JHN 16:15"/>భాన కలిగ్యుతే ఖారుబి మారుస్. ఇనఖాజే యో మారమతూ లీన్‍ తుమ్నా మాలంకరవును కరి మే బోల్యో థొ.<verse eid="JHN 16:15"/></para>
  <para style="s">ఆహ్‍ః నిరాహ్ః</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16"/>థోడు ధన్నా బాద్మా తుమే మన దేక్చూకొయినికరి; బుజు థోడుధన్‍నా మన దేక్చుకరి బోల్యొ.<verse eid="JHN 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17"/>అనటెకె ఇను సిష్యుల్మా థోడుజను “థోడుధన్నా బాద్మా మన ధేక్చూకొయిని; బుజు థోడుధన్‍హువన బాద్మా మన దేక్చూకరి మే భాకన జంకరుస్‍కరి, యో అప్నేతి బోలుకరతే వాత్‍ సాత్‍కరి ఏక్తి ఏక్ బొల్లీదు. <verse eid="JHN 16:17"/><verse number="18" style="v" sid="JHN 16:18"/>థోడు ధన్‍కరి యో బొలుకరతే సాత్‍? యో బోలుకరతే సంగతుల్‍ అప్నా మాలంకొయినికరి” బొల్లీదు.<verse eid="JHN 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19"/>ఇవ్నేఆ వాత్‍ ఇన పుఛ్చావ్‍సెకరి యేసు సోచిన్‍ ఇవ్నేతి అమ్‍ బోల్యొ థోడు ధన్నా బాద్మా తుమే మన దేక్చూకొయినికరి, బుజు థోడుధన్నా మన దేక్చుకరి మే బోల్యొతె వాత్‍టేకె తుమే ఏక్నా ఏక్‍ సాత్‍ సోచిలెంకరస్‍నా? <verse eid="JHN 16:19"/><verse number="20" style="v" sid="JHN 16:20"/>తుమే రొవ్వాస్‍ పన్కి ములక్‍ ఖుషిహుసే; తుమే దుఃఖాపడుసు పన్కి తుమారు దుఃఖామ్‍ సంతోషం హోనుకరి తుమారేతి హాఃఛితి బోలుకరూస్‍ <verse eid="JHN 16:20"/><verse number="21" style="v" sid="JHN 16:21"/>బాయికొ జణావనుధన్‍ వఖాత్‍ ఆయు. అనటేకే యోబాయ్‍కొ బాధపడస్‍; పన్కి లడ్కుపైదహువన పాసల్‍ ములక్‍మా లడ్కుపైదాహుయోకరి యో ఖుషినటెకె బాయికో యోబాధన బుజు ఖాయల్‍ కరకొయినీ. <verse eid="JHN 16:21"/><verse number="22" style="v" sid="JHN 16:22"/>ఇమ్నితరాస్ తుమేబి దుఃఖాపడుకరస్‍ పన్కి తుమ్న బుజే చోట్‍ దేక్యో తెదె తుమారు దిల్‍ ఖూషిహుసె, తుమారు ఖూషినా తుమారకంతు కోన్బి లిసేకోయిని.<verse eid="JHN 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23"/>యో ధన్నే తుమే కినా గుర్చిబి కోపుఛ్చవుసుని; మే తుమారేతి హాఃఛి బోలుకురుస్‍ భా న తుమే మరానమ్తి సాత్బి మాంగ్యతోబి యో తుమ్నా మల్సే. <verse eid="JHN 16:23"/><verse number="24" style="v" sid="JHN 16:24"/>హంకేలగు తుమే మార నామ్తీ సాత్బీ మంగ్యా కోయిని; తుమారు ఖూషి పరిపుర్ణం హువఖార్కు మాంగో; తుమాన మల్సే.<verse eid="JHN 16:24"/></para>
  <para style="s">ములక్‍ ఫర్ జీత్‍ గెల్చను</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25"/>ఆ సంగతుల్‍ ఉపామనంతి తుమారేతి బోలుకరూస్‍; హుయుతో మే బుజు కెదేబి ఉపామనంనితర తుమారేతి వాతె నాబోలిన్‍ భాన లీన్‍ స్పష్టంతి మాలంకరావను వఖాత్‍ ఆయుతురు. <verse eid="JHN 16:25"/><verse number="26" style="v" sid="JHN 16:26"/>యో ధన్ముఆ తుమే మార నామ్తి మాంగుసు పన్కి తుమారటెకె మే భాన కొబతీమాలిస్ని కరి తుమారేతి కోబోలుకరుస్‍ని. <verse eid="JHN 16:26"/><verse number="27" style="v" sid="JHN 16:27"/>తుమే మన ఫ్యార్‍ కర్య; ఇనటెకె మే భా కంతు బయాలుదేరిన్‍ ఆయో కరి తుమె నముకరాస్‍ ఇనటెకే భాస్‍ తుమాన ఫ్యార్కరుకరాస్‍ <verse eid="JHN 16:27"/><verse number="28" style="v" sid="JHN 16:28"/>మే భా కంతు నికిన్‍ ములక్మా ఆయో, బుజు ఆ ములక్నా బేందిన్‍ భా కనా జావుంకురుస్‍ కరి ఇవ్నేతి బోలస్‍<verse eid="JHN 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29"/>తెదె ఇను సిష్యుల్తి, హదేక్‍ హంకేతు కేహు ఉపమానం నా బోలిన్‍ స్పష్టంతి వాతె బోలుకరస్‍ <verse eid="JHN 16:29"/><verse number="30" style="v" sid="JHN 16:30"/>సమస్తంనా మాలంకర్యో హుయో కరి, కోన్‍బి తునా ప్రస్నా బొలాను ఆవసరం కోయినికరి, హంకెమాలంపడ్యు తూ దేవ్‍ కంతు తూ నికీన్ ఆయోకరి అనాలిన్‍ నమ్ముకరాస్ కరి బోలామ,<verse eid="JHN 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31"/>యేసు ఇవ్నా మ్హడి దేఖిన్‍ హంకె నమ్ముకరాస్‍సూ? <verse eid="JHN 16:31"/><verse number="32" style="v" sid="JHN 16:32"/>హదేక్‍ తుమారమ హర్యేక్‍జణు ఇను ఘేర్‍కనతో నికిజైన్‍ మన ఎక్కెలాన బేందెవాను వహఃత్‍ ఆంక్రాస్‍; ఆయిత్రూస్‍ హుయితో మారో భా మరకేడె ఛా ఇనటెకె మే ఎక్కెలో కోచవ్ని. <verse eid="JHN 16:32"/><verse number="33" style="v" sid="JHN 16:33"/>మార యందు తుమ్న సమాధనం హువాఖార్కు ఆ వాతెవ్నా తుమరేతి బోలుకరస్‍ ములక్నా తుమా మినాత్‍ పడ్సే మే ములక్నా జైన్చుకరుస్‍ కరి బోల్యొ.<verse eid="JHN 16:33"/></para>
  <chapter eid="JHN 16"/>
  <chapter number="17" style="c" sid="JHN 17"/>
  <para style="s">యేసు ఇనా సిష్యుల్‍నాటేకె ప్రార్థన కర్యో</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1"/>యేసు ఆ వాతెహాఃరి బోలిన్‍ ఇనపాసల్‍ ఆబ్‍ మ్హాడి డోలో పడిన్‍ అమ్‍ బోలిన్‍ భా మార వఖాత్‍ ఆయిరుస్‍ తారొ ఛియ్యో తునా మహిమా పరచాఖార్కు తార ఛీయ్యానా మహిమా పరాచ్‍; <verse eid="JHN 17:1"/><verse number="2" style="v" sid="JHN 17:2"/>తూ తరా ఛీయ్యానా దిదొతె ఇవ్నా హాఃర్వాన మే నిత్యజీవమ్‍న అనుగ్రహించతింమ్‍ అద్మియే హాఃరవ్పర్‍ ఇనా అధికార్‍న దీరాక్యోస్‍ <verse eid="JHN 17:2"/><verse number="3" style="v" sid="JHN 17:3"/>అద్వితియానో హాఃఛి దేవ్‍ హూయోతె తునా, తూ బోలిమోక్లోతె యేసు క్రీస్తునా గుర్తుధరనుస్‍ నిత్యజివమ్‍ <verse eid="JHN 17:3"/><verse number="4" style="v" sid="JHN 17:4"/>కరనాటేకె తూ మన దిదొతె కామ్‍ మే సంపూర్ణంతి జామిన్‍పర్‍ తునా మహిమా పరచ్యో. <verse eid="JHN 17:4"/><verse number="5" style="v" sid="JHN 17:5"/>భా ములక్‍ పైదాహువనా అగాఢి థూస్‍ తరాకన మన కెహూ మహిమా తుకి యో మహిమాతి మన హంకె తరకనా మహిమా పర్చిలా.<verse eid="JHN 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6"/>ములక్‍ మాతు తూ మన దీరాక్యోతె అద్మియోనా తరా నామ్తీ మహిమపరుచుకరస్, ఇవ్నే తారు హుయిన్‍ ర్హాయూ, తూ ఇవ్నాబి మన దెవ్వాడిరాక్యోస్‍; ఇవ్నే తారి వ్యాకంనా మాలంకరిన్‍ ఛా. <verse eid="JHN 17:6"/><verse number="7" style="v" sid="JHN 17:7"/>అనటెకె తూ మన దీరాక్యోతె ఖారూబి తారువలనస్‍ హుయుకరి ఇవ్నేహంకె మాలంకరిన్‍ ఛా! <verse eid="JHN 17:7"/><verse number="8" style="v" sid="JHN 17:8"/>థూ మన దీరాక్యోతె వాతెన ఇవ్నా దీరాక్యోస్‍; ఇవ్నేయోవాతేనా ఒప్పిలీన్ మే తారకంతూ నికిన్‍ ఆయోకరి హాఃఛితి ఎంచీన్‍ తూ మన మొక్లోకరి ఇవ్నే నమ్ముకారస్.<verse eid="JHN 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9"/>మే ఇవ్నటెకె ప్రార్ధననా కరుకరూస్‍; ములక్నటెకె ప్రార్ధన కొకరుకరుని పన్కి, తూ మన దెవ్వాడిరాక్యోతె ఇవ్నేతారువాలకరి బోలీన్‍ ఇవ్నే ఖాజేస్‍ మే ప్రార్ధననా కరుకరూస్‍ <verse eid="JHN 17:9"/><verse number="10" style="v" sid="JHN 17:10"/>మారు ఖారుబి తారు, తారు ఖారూబీ మారు; ఇవ్నమా మే మహిమమా హుయ్‍రోస్‍.<verse eid="JHN 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 17:11"/>మే ఆ ములక్మా బుజు కోరహీస్‍ని పన్కి అవ్నే ములక్మా ఛా; మే తారకన వలాంకరూస్‍ పరిసుద్దుడ్‍హుయోతె మారో భా అప్నె ఏక్‍ హుయిన్‍ రయ్యేతింమ్‍ ఇవ్నేబి ఏక్‍హుయిన్‍ ర్హానుతింమ్‍ తూ మన దీరాక్యోతె తారు నామ్మాతి ఇవ్నా బఛ్చావ్‍ <verse eid="JHN 17:11"/><verse number="12" style="v" sid="JHN 17:12"/>మే ఇవ్నేకనా రవ్వమా తూ మన దిదోతె తారు నామ్మాలిన్‍ ఇవ్నా బఛ్చాయో. అనటెకె లేకనాల్‍ నెరవేర్చతింమ్‍ నాస్‍హువన బరాబ్బర్‍నో తప్ప, ఇవ్నేమా బుజు కోన్బీ నాస్‍నహోనుకరి మే ఇవ్నా జత్తన్‍కర్యో <verse eid="JHN 17:12"/><verse number="13" style="v" sid="JHN 17:13"/>హంకె మే తారకనా వలాంకరూస్‍; మారు ఖుషాల్‍ ఇవ్నవలా కొదువాహోనుకరి, ములక్మా ఆవాత్‍ బోలుకరూస్‍ <verse eid="JHN 17:13"/><verse number="14" style="v" sid="JHN 17:14"/>ఇవ్నా తారు వాతేనా దిరాక్యోస్‍ మే ములక్ను సంబందహుయొ కాయేతిమ్‍ ఇవ్నేబీ ములక్ను సంబందహుయుకాహె అనటెకె ములక్‍ ఇవ్నా దావ్వోకరూకరస్‍.<verse eid="JHN 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 17:15"/>తూ ములక్‍మతూ ఇవ్నా బులాలిజాకరి మే ప్రార్ధనా కరుకరాకొయిని పన్కి దుష్మాన్కంతూ బఛ్చావ్‍కరి ప్రార్ధననా కరుకరుస్‍ <verse eid="JHN 17:15"/><verse number="16" style="v" sid="JHN 17:16"/>మే ములక్ను సంబందిహుయొ కాహే, తుమేబి ములక్న సంబందిహుయా కాహే. <verse eid="JHN 17:16"/><verse number="17" style="v" sid="JHN 17:17"/>హాఃఛిమా ఇవ్నా ప్రతిష్ఠ పర్చను; తారు వాక్యమస్‍ హాఃచి. <verse eid="JHN 17:17"/><verse number="18" style="v" sid="JHN 17:18"/>తూ మన ములక్మా మొక్లోతిమ్మస్‍ మేబి ఇవ్నా ములక్మా బొలిమొక్లొ. <verse eid="JHN 17:18"/><verse number="19" style="v" sid="JHN 17:19"/>ఇవ్నేబి ఖాఛిమా ప్రతిష్టబడ్నుతింమ్‍ ఇవ్నహాఃజె మారుమేస్‍ తున ప్రతిష్ఠ కర్‍లెంకురుస్‍<verse eid="JHN 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20"/>ఇవ్ని వచన్‍టేకె మారకనా విష్వాస్‍న రాఖవాల హఃరూబి ఏక్‍హుయిన్‍ ర్హానుకరి ఇవ్నటెకె కాహే గాని అవ్ను వాతెవ్న ఖాంజ్యతే ఇవ్నాటెకె మే ప్రార్ధన కరూకరాస్‍ <verse eid="JHN 17:20"/><verse number="21" style="v" sid="JHN 17:21"/>బుజు తూ మన మొక్లోకరి ములక్‍ నమ్మనుతింమ్‍; భా, మారకన తూబి, తారమా మేబి ర్హంకరతెతింమ్‍; ఇవ్నేబి అప్నమా ఏక్‍హుయిన్‍రానుకరి ఇవ్న ఖాజేస్‍ మే ప్రార్ధన కరుకురుస్‍; <verse eid="JHN 17:21"/><verse number="22" style="v" sid="JHN 17:22"/>అప్నె ఏక్‍హుయిన్‍ ఛియ్యేతింమ్‍ ఇవ్నేబి ఏక్‍హుయిన్‍ ర్హానుకరి తూ మన దెవ్వాడిరాక్యోతె మహిమమా మే ఇవ్నా దిదో. <verse eid="JHN 17:22"/><verse number="23" style="v" sid="JHN 17:23"/>ఇవ్నకన మేబి మారకనా తూబి రయ్యతొ ఇవ్నే సంపూర్ణుతరా హుయిన్‍ ఏక్నితరా ఛియ్యెకరి తూ మన మొక్లోకరి, తూ మన ఫ్యార్‍ కరోతిమ్మస్‍ ఇవ్నబి కర్యాకోస్కరి, ములక్ను మాలంకరతింమ్‍ మన అనుగ్రహించొతె ఫ్యార్ ఇవ్నాదిదొ<verse eid="JHN 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24"/>భా మే కెజ్గారవుస్కీ ఎజ్గా తూ అనుగ్రహించితె ఇవ్నేబి మారకెడె ర్హానుస్‍కరి, తూ మన అనుగ్రహించుతె మారు మహిమనా ఇవ్నే దేక్నూకరి కోరిలెంక్రుస్‍ సానకతో ములక్‍ ఫైదాహుయుకొయింతె అగాడిస్ తూ మన ఫ్యార్‍ కర్యాకోస్‍.<verse eid="JHN 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 17:25"/>నీతి స్వరూపుడ్‍హుయోతె భా, ములక్ను తున మాలంకర్యూకొయుని; మే తున మాలంకర్యో; తూ మన మొక్లోకరి అవ్నేమాలంకరిన్‍ ఛా! <verse eid="JHN 17:25"/><verse number="26" style="v" sid="JHN 17:26"/>తూ మారప్పర్‍ రాక్యోతె ఫ్యార్‍నా ఇవ్నకన ర్హానుతింమ్‍ మే ఇవ్నకన ర్హానుతింమ్‍ ఇవ్న తారు నామ్నా మాలంకర్యాయో అజుబి మాలం కర్యాస్‍కరి బోల్యొ.<verse eid="JHN 17:26"/></para>
  <chapter eid="JHN 17"/>
  <chapter number="18" style="c" sid="JHN 18"/>
  <para style="s">యేసున బంధికరను</para>
  <para style="r">(<ref loc="MRK 14:43-50">మార్కు 14:43-50</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1"/>యేసు ఆవాతే హాఃరు బోలిన్‍ ఇనబద్మా ఇనా సిష్యుల్‍నా కేడె కెద్రొను లోయాన దాటిన్‍ గయ్యా, ఇజ్గా ఏక్‍ తోట్‍ థూ, ఎజ్గా యో ఇన సిష్యుల్‍తి మలిన్‍ జాస్‍ <verse eid="JHN 18:1"/><verse number="2" style="v" sid="JHN 18:2"/>యేసు ఇనా సిష్యుల్‍తి మలిన్‍ ఘానిచోట్‍ ఎజ్గా గాయ్యో ఇనటేకె, ఇనా ధరైదెవ్వాలొ యూదానబి యో జోగొ గనుచోట్‍ మాలం థూ. <verse eid="JHN 18:2"/><verse number="3" style="v" sid="JHN 18:3"/>ఇనహాఃజె యూదా రోమాసైనికుల్నా ప్రధానయాజాకుల్‍ పరిసయ్యుల్‍ బుజు మోక్లోతె బంట్రౌతుల్నా కెడెనాఖిలీన్‍ దివ్‍టిల్‍తి దివ్వోతి ఆయుధాల్‍తి ఎజ్గాగయు. <verse eid="JHN 18:3"/><verse number="4" style="v" sid="JHN 18:4"/>యేసు ఇనాహుసేతెఖారు మాలంకరిన్‍ ఇవ్నాకన జైన్‍ తుమే కినా దుండుకరస్‍? కరి ఇవ్నా పుఛ్చావస్‍.<verse eid="JHN 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5"/>ఇవ్నే బోలస్‍ “నజరేయుడ్‍ హుయోతే యేసున కరి” జావబ్‍ దేవమా యేసు యో మేస్‍ కరి ఇవ్నేతి బోలస్‍ ఇనా ధరైదిదొతే యూదాబి ఇవ్నే కెడె వుబ్రిన్‍ ర్హాస్‍ <verse eid="JHN 18:5"/><verse number="6" style="v" sid="JHN 18:6"/>యేసు యో మేస్కరి ఇవ్నేతి బోలామ ఇవ్నే పిటె ఖార్కిన్‍ దర్లేవానటేకె తయార్‍హుయా. <verse eid="JHN 18:6"/><verse number="7" style="v" sid="JHN 18:7"/>బుజెక్‍ చోట్‍ యో, తుమే కినా దూండుకరస్‍? కరి ఇవ్నేతి పుఛ్చావస్‍ ఇనటేకె ఇవ్నే “నజరెతు హుయోతె యేసు” కరి బోలామ.<verse eid="JHN 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8"/>యేసు ఇవ్నేతి యో మేస్‍ కరి బోల్యొ థోని, ఇనటేకె తుమే మన దుండుకర్తా హుసెతొ అవ్నా జావదేవో కరి బోలస్‍ <verse eid="JHN 18:8"/><verse number="9" style="v" sid="JHN 18:9"/>తూ మన అనుగ్రాహించోతే ఇవ్నామ ఏక్ జణుబి కోగమైలిదోని కరి యో బోల్యొతే వాత్‍ నెరవేర్నుతిమ్‍ అమ్‍ బోల్యొ.<verse eid="JHN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10"/>సీమోన్‍బి పేతుర్‍కనా ఛారి ర్హావమా యో ఛారినా కడిన్, ప్రధానయాజకుడ్‍ను దాసుడ్‍నా ఖావ్వత్నుబాజును కాన్నా కాత్రినాకిదెస్. యో దాసుడ్‍ను నామ్‍ మల్కు. <verse eid="JHN 18:10"/><verse number="11" style="v" sid="JHN 18:11"/>యేసు పేతుర్‍తి అమ్‍ బొల్యొ, తారు ఛారిన భేందా భా మన అనుగ్రహించ్యోతే గిన్ని మాను మినాత్‍ మే నా పినుసు.<verse eid="JHN 18:11"/></para>
  <para style="s">అన్నను హాఃమె యేసునా ఉభారి రాఖను</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12"/>ఎత్రమాస్‍ రోమా అధికారులు, సైనికుల్బి, యూదుల్నూ బంట్రౌతుల్‍ యేసునా ధర్లీన్‍ ఇనా బాంధించ్యా. <verse eid="JHN 18:12"/><verse number="13" style="v" sid="JHN 18:13"/>అగాడి అన్నాకనా లీన్జాస్‍ యో ఆ వరఖాను ప్రధానయాజాకుడ్‍ హుయోతె కయాపనా మామో <verse eid="JHN 18:13"/><verse number="14" style="v" sid="JHN 18:14"/>ఏక్ అద్మి ప్రజల్‍నటేకె మరిజావను ప్రయోజాకరంకరి కయప యూదుల్నా ఆలోచాన బోల్యొహుయో.<verse eid="JHN 18:14"/></para>
  <para style="s">పేతుర్‍ యేసు మాలంకొయినికరి బోలాను</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15"/>సీమోన్బి పేతుర్‍బి బుజేక్‍ సిష్యుడ్‍బి యేసునకెడె జంకరా. యోసిష్యుడ్‍ ప్రధానయాజకుడ్‍నా మాలంహుయో, అనటేకే యో ప్రధాన యాజక్ను ఘర్నువరన్డా యేసుతిబి గయా. <verse eid="JHN 18:15"/><verse number="16" style="v" sid="JHN 18:16"/>పేతుర్నె ధర్వాజును భార్‍ ఉబ్రిన్‍తో పన్కి ప్రధానయాజక్న మాలంహుయోతె యో సిష్యుడ్‍ ఆయిన్‍ ఘర్‍వాలితీ వాత్‍బోలీన్‍ పేతుర్నా మహీ బులాలీన్‍గయో. <verse eid="JHN 18:16"/><verse number="17" style="v" sid="JHN 18:17"/>ధర్వాజుకన కావ్లీచ్చాతే ఏక్ న్హాని పేతుర్‍తి తుబి ఇనా సిష్యుల్మా ఏక్‍జనొ కాహేనా? కరి బోలమా తెదె యో కాహేకరి బోల్యొ.<verse eid="JHN 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18"/>తెదె థండ్‍ లగమా దాసుల్బి బంట్రౌతుల్‍ ఆగ్‍ బాలీన్‍‌ షేక్తుహుయిన్‍ వుబ్రిన్‍ ర్హావమా పేతుర్‍బి ఇవ్నాకన వుబ్రిన్‍ ఆగ్ షేక్కోకర్తొ థో.<verse eid="JHN 18:18"/></para>
  <para style="s">ప్రధాన యాజకుల్‍ యేసుతి పుచ్ఛావను</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19"/>ప్రధానయాజకుల్‍ ఇనా సిష్యుల్‍నా గురించిబి ఇనా బోధనా గురించి యేసునా పుఛ్చవమా. <verse eid="JHN 18:19"/><verse number="20" style="v" sid="JHN 18:20"/>యేసు, మే హాఃరానఖామే వాతె బోల్యొ; యూదుల్‍ ఖారు జమాహువాతె న్యావ్‍కరనుజోగొ దేవును మందిర్‍మా కెదేబి బోధించో పన్కి చోరేతి మే సాత్బి వాతెబోల్యాకొయిని. <verse eid="JHN 18:20"/><verse number="21" style="v" sid="JHN 18:21"/>తూ మన పుఛ్చావతెసాత్‍ మే తుమ్న సాత్‍ భోదించిరాక్యొతె ఖాంజిరాక్యుతె ఇవ్నా పుఛ్చావ్‍కరి; హదేక్‍ మే బోల్యొతే ఇవ్నామాలంకరి ఇనేతి బోల్యొ.<verse eid="JHN 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22"/>యో ఆవాతె బోల్యొతెదె ఖాందె ఉబ్రీన్‍ ఛాతె ఇవ్నే బంట్రౌతుల్‍మా ఏక్జనో ప్రధాన్‍యాజకుడ్‍న్‍ అమ్‍ ఉత్తర్‍దెంకరస్‍నా; కరి బోలీన్‍ యేసున హాత్తి మార్యో.<verse eid="JHN 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23"/>ఇనటేకె యేసు, అజ్గ ఛాతెఅద్మి హాఃర్వానా పుఛావో, మే సాత్బి తప్పుతి వాతే బోల్యొ హుసెతో మనాషే మారుకరతే? కరి బోలస్‍<verse eid="JHN 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24"/>ఎజాత్ను భైయే, యేసునా బంధిచిరక్యుతింమాస్‍ ప్రధానయజాకుడ్ హుయోతె కయపకనా మోక్లో.<verse eid="JHN 18:24"/></para>
  <para style="s">యేసు మాలంకోయినికరి పేతుర్‍ బుజు యేక్తార బోలను</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25"/>సీమోన్‍బి పేతుర్ వుబ్రిన్ థండ్‍ షేకుకరమా ఇవ్నే ఇనా దేఖీన్ తూబి ఇనా సిష్యుల్‍మా ఏక్ కాహేనా? కరి బోలామ మే కాహే యో మన మలంకోయిని కరి బోలస్‍<verse eid="JHN 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26"/>పేతుర్‍ కినా కాన్న కత్రినక్యోకి ఇవ్నీ మాయమత్రనూ ప్రధానయజాకుడ్మా దాసుడ్మా ఎక్బీ, తూ తోట్‍మా ఇవ్నేతీ మాలిన్‍ ర్హావను మే దేక్యోకోయిన్‍నా? కరి బోల్యొ,<verse eid="JHN 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27"/>పేతుర్‍నే “మన మాలంకోయిని” కరి బుజేక్‍ తరా బోల్యొ తేదెస్‍ ముర్గు వ్వాస్యు.<verse eid="JHN 18:27"/></para>
  <para style="s">పిలాతునా హాఃమే యేసు</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28"/>వానెఖాత్రే ఇవ్నే కయప ఘెర్మాకంతు లిన్ రోమా అధికారిన భంగ్లమా యేసునా బులైలిగయూ, ఇనఖాజే ఇవ్నే పస్కాను పండుగను దాన్‍ ఖావనటేకె అగాడి ఇవ్నే అచారం ప్రకారం మైలు పడకొయినితిమ్‍ ర్హానుకరి. <verse eid="JHN 18:28"/><verse number="29" style="v" sid="JHN 18:29"/>అనహాఃజె పిలాతునే బాధర్‍ ఛాతే ఇవ్నాకన ఆయిన్‍ ఆ అద్మినా ఉప్పర్‍ తుమే కెహూ నేరాంనా నాఖుకరస్ కరి పుచ్చావమా?<verse eid="JHN 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30"/>ఇనటేకె ఇనెతి అమ్ బోల్యు, ఆ తప్పు నాకర్యొతొ అన తుమారకనా ధరాయ్‍ద్యావనో కాహే ఇనెతి బోల్యొ.<verse eid="JHN 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31"/>ఇనటెకె పిలాతునె ఇవ్నేతి తుమే అన బులాలిజైయిన్‍ తుమారు ధర్మషాస్ర్తంతింమ్‍ ప్రకార్‍ అన న్యావ్‍ తీర్చోకరి బోలమా; తెదె యూదుల్ కినాబి మరాణ షిక్చ నఖాన హమ్నా అధికారం కోయినికరి ఇనెతి బోల్యా <verse eid="JHN 18:31"/><verse number="32" style="v" sid="JHN 18:32"/>ఇనఖాజే యేసు యో కేజాత్ను మరాణంనా మల్సేకి ఇనా సోచిలిన్‍ బోల్యుతే వాత్‍ నేరవేర్సే.<verse eid="JHN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33"/>తెదే పిలాతు బుజు రోమా రాజ్యఅధికారి భంగ్లుమా జైన్‍ యేసునా బులాయిన్‍ ఇనేతి తూ యూదుల్‍నో రాజోనా? కరి బోల్యొ.<verse eid="JHN 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34"/>యేసునె తారు తూస్ ఆవాత్నా బొలుకరస్నా, నైహ్తో పార్లు మార గురించి బోలుకరూస్నా? కరి పుఛ్చాయో,<verse eid="JHN 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35"/>ఇనాటెకె పిలాతు, మే యూదుడ్‍ కరి లైజొమ్‍ఖారస్నా? తారు స్వంతాద్మిన ప్రధానయాజాకుల్నా తునా ధరాయిదిదుని; తూ సాత్ యోకరి? పుఛ్చావమా.<verse eid="JHN 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36"/>యేసు అమ్ బోల్య, మారు రాజ్యం ఆ ములక్‍ సంబంధి కహే “మారు రాజ్యం ఆ ములక్‍సంబంధి హుయుతో మే యూదుల్నా నా ధారైదెనుకరి మార సేవాకుల్‍ లడైయి కర్సె పన్కి మారు రాజ్యం అజ్గాను సంబంధహుయు కహేకరి” బోలస్‍<verse eid="JHN 18:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37"/>ఇనాటేకె పిలాతు, తూ రాజొనా? కరి ఇన పుఛ్చావమా యేసు తూ బోల్యోతిమ్ మాస్‍ మే రాజో; హాఃఛినాలిన్‍ సాబుత్ దెవనటేకె పైదాహుయో, అనా లీన్‍ ఆ ములక్మా ఆయిరోస్ హాఃచి హుయుతె హర్యేజను మార వాతె ఖాంస్చె కరి బోల్యొ.<verse eid="JHN 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38"/>ఇనటేకె పిలాతు, హఃఛికతో సాత్‍? కరి ఇవ్నేతి బోల్యొ.</para>
  <para style="s" vid="JHN 18:38">యేసు మారణ షిక్చా దేవాను</para>
  <para style="p" vid="JHN 18:38">యో ఆవాతె బోలిన్‍ భాధర్‍థూతె యూదుల్‍కన జైయిన్‍ ఇనకన కెహూ దోషంబి మన కోదెఖాయుని. <verse eid="JHN 18:38"/><verse number="39" style="v" sid="JHN 18:39"/>పస్కాపండగనా ధన్నే మే ఏక్నా బేందేవను ఆచార్‍ ఛాకొన్నా మే యూదుల్‍నో రాజోన చుట్‍కార్ కరను తుమ్న ఇష్టంనా కరి బోల్యొ,<verse eid="JHN 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40"/>బుజు ఇవ్నే అననొకొ, బరబ్బానా బెందాకరి బుజు‍ చిక్రాన్‍ బేంద్యూ, ఆ బరబ్బా బందిపోట్‍ ఛోర్‍.<verse eid="JHN 18:40"/></para>
  <chapter eid="JHN 18"/>
  <chapter number="19" style="c" sid="JHN 19"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1"/>తెదె యేసున పిలాతునె ధరిన్‍ ఇన కొరడాల్తి మరాయా. <verse eid="JHN 19:1"/><verse number="2" style="v" sid="JHN 19:2"/>సైనికుల్‍ కాట్ఠావ్ను డాలీనా కిరీటం అల్లిన్‍ ఇను ముడ్క్యాపర్‍ ఘాలిన్‍; <verse eid="JHN 19:2"/><verse number="3" style="v" sid="JHN 19:3"/>తెదె బైంగని రంగ్ను లుంగ్డనా పెరాయిన్ ఇనకన‍ ఆయిన్‍ యూదల్నో రాజొ, అష్యల్ హువదాకరి బోలిన్‍ ఇన మార్య.<verse eid="JHN 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4"/>పిలాతు బుజు భార్‍ ఆయిన్‍ “హదేక్‍ అన భాంతి మన కెహూ తప్పుబి దేఖావుకర కొయినికరి తమ్నా మాలం హూవదాకరి ఇన తుమారకనా బాధర్‍లిన్‍ ఆవుస్‍కరి” ఇవ్నేతి బోల్యొ. <verse eid="JHN 19:4"/><verse number="5" style="v" sid="JHN 19:5"/>యో కాటొవ్ను కిరీటం బైంగని రంగ్ను లుంగ్డనా పెర్రాయిన్‍ యేసునె భార్‍ ఆవమా పిలాతు అమ్‍ బోల్యొ! హదేక్‍ ఆస్‍ యో అద్మికరి ఇవ్నేతి బోల్యొ.<verse eid="JHN 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6"/>ప్రధానయాజకుల్‍బి బుజు భటుల్‍ ఇన దేకిన్ సిలువనాక్‍, సిలువనాక్‍ కరి చిక్రాన్‍ బేందమా తెదె పిలాతునె ఇనకన మన కెజాత్నూ దోషంబి మన దెఖావుకరకొయిని ఇనటెకె తుమేస్‍ అన బులాలిజైయిన్‍ సిలువ నాకోకరి ఇవ్నేతి బోల్యొ.<verse eid="JHN 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7"/>ఇనాటేకె యూదుల్‍ హామ్నా ఏక్ నియామం ఛా! యో దేవ్నొ ఛియ్యోకరి ప్రాచారం బోల్లేవుంకరస్‍ ఇనాటెకె యో నియామంనా ఖాజే యో మారణ్‍ పాత్రుడు కరి బోలస్‍<verse eid="JHN 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8"/>పిలాతు యో వాతె ఖాంజిన్‍ బుజు ఘాణు ఢారిజైన్‍;<verse eid="JHN 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 19:9"/>పాచుఫారిన్‍ అధికార భంగ్లొ జైన్‍ తూ కెజ్గాతి ఆయో కరి యేసునా పుచ్చాయో, హుయితొబి యేసు ఇనా జావబ్‍ కొదిదొని. <verse eid="JHN 19:9"/><verse number="10" style="v" sid="JHN 19:10"/>ఇనాటేకె పిలాతు, యేసుతి మారేతి వాతె కొబోలానిసూ? తునా భేమ్‍దెవనామి, బుజు తునా సిలువ నఖానబి అధికరం మన ఛా కరి తునా మాలంకోయినిసూ?<verse eid="JHN 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11"/>ఇనాటేకె యేసు తునా యో అధికారం దేవ్‍కంతు ఆయితోస్‍ తప్ప మారఫర్‍ కెహూ అధికారంబి కోయిని. ఇనఖాజే మన తునా ధారైదేవ్వాలనా జాహఃత్‍ పాప్‍ షిక్చా ఇవ్నాఫర్‍ ఆవ్సే.<verse eid="JHN 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12"/>ఆ వాతెనా లీన్‍ పిలాతు ఇనా విడుదలా కరనాటెకె కోషిస్‍ కరస్‍ పన్కి అద్మిహాఃరు ఛిక్రాన్‍ భేమ్‍తూ తు అనా విడుదలా కర్యోతో కైసర్‍నా భై కాహే ఇను యోస్‍ రాజో కరిలేవ్వాలో యో కైసరునా విరోధంతి వాతె బోలాన్‍తర్‍ కరి బోల్యా.<verse eid="JHN 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13"/>పిలాతు ఆ వాతెవ్నా ఖాంజిన్‍ యేసునా బాధర్‍ బులైలిఆయిన్‍ “ఫాత్రో భంద్యుతే జోగొమా” న్యాయపిఠమ్‍ పర్‍ బేసిగో; హేబ్రి భాషమా యో జోగొను నామ్‍ గబ్బతా; <verse eid="JHN 19:13"/><verse number="14" style="v" sid="JHN 19:14"/>యో ధన్‍ పస్కాకను సిధ్దార్చాను ధన్‍; తెదె ధోపారేను భారభజేన హుంకరా యో హదేక్‍ తూమరు రాజొకరి యూదుల్తి బోలమ<verse eid="JHN 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15"/>ఇనటేకె ఇవ్నే గఛీన్తి ఛిక్నాన్‍ భేందిన్‍ అనా మర్రాకిదేవో మర్రాఖిదెవో సిలువనాకో కరి చిక్రణ్‍ బేంద్యు పిలాతు అదేక్‍ తుమే రాజోనా సిలువ నాకుసునా? కరి ఇవ్నా పుఛ్చావమా ప్రధానయాజకల్‍ కైసర్ తప్ప హామనా బుజు కెహూ రాజోబి కోయిని కరి బోల్యా.<verse eid="JHN 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16"/>తెదె సిలువ నఖావనటెకేస్‍ ధరైయిదెస్.</para>
  <para style="s" vid="JHN 19:16">యేసునా సిలువ నాఖను</para>
  <para style="p" vid="JHN 19:16">యో యేసునా ఇవ్నా ధర్యాయ్‍దిదొ.<verse eid="JHN 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17"/>ఇవ్నే యేసునా బులాలీన్‍ గయూ. యో ఇను సిలువనా డొహిలీన్‍ కపాల జొగొమా గయా. హెబ్రీను వాత్మా ఇన గొల్గొతాకరి అర్థం. <verse eid="JHN 19:17"/><verse number="18" style="v" sid="JHN 19:18"/>ఎజ్గా హంకల్నీ బజు ఏక్జన హింకల్నీ బజు ఏక్జననా ఇచ్మా యేసున రాఖిన్‍ ఇనకెడె బే జననా సిలువ నాక్యూ. <verse eid="JHN 19:18"/><verse number="19" style="v" sid="JHN 19:19"/>బుజు పిలాతు, యూదుల్‍నో రాజో హుయోతే నజరేయుహుయోతే యేసు కరి పల్కఫర్ లిఖాయిన్‍ సిలువ ఫార్ మేంద్యా. <verse eid="JHN 19:19"/><verse number="20" style="v" sid="JHN 19:20"/>యేసునా సిలువా నఖాయోతే జోగొ పటానంనా ఖాందె థూ, యో హెబ్రి, గ్రీక్, రోమా, భాషల్మా లీహఃయూ ఇనటెకె యూదుల్‍మా కెత్రూకి జణు ఇనా పడ్యూ. <verse eid="JHN 19:20"/><verse number="21" style="v" sid="JHN 19:21"/>మే యూదుల్ను రాజో కరి యో బోల్యొ తిమ్‍ లిఖో, పన్కి యూదుల్ను రాజో కరి లిఖ్యునుకరి యూదుల్ను ప్రధానయాజకుల్‍ పిలాతుతీ బోలామ,<verse eid="JHN 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22"/>పిలాతు ఇవ్నేతి అమ్‍ బొల్యో, మే లీక్యుతే సాత్కీ లిక్యో కరి బోల్యొ యో ఇమ్మస్‍ ర్హావదా.<verse eid="JHN 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23"/>సైనికుల్‍ యేసునా సిలువనా నఖాది ఇనపాస్సల్తి, ఇనా ఉప్పర్ను లుండ్గానా లీన్‍ ఏక్‍ఏక్‍ సైనికుడ్‍నా ఏక్‍ఏక్‍ భాగ్‍ మలునుతీమ్‍ ఇనా ఛార్‍ భాగల్నా ఫాడ్యు, యో లుండ్గనా కుట్టు నారవ్వామా ఉప్పర్‍తూ మొత్తంబి నాఖాయిగొ పాన్కి <verse eid="JHN 19:23"/><verse number="24" style="v" sid="JHN 19:24"/>ఇవ్నే ఇనా నాఫాడీన్‍ బుజు యో కినా ఆవ్సేకీ ఇనటెకె చీటీయే నాఖీయే కరి ఏక్నుఏక్‍ బొల్లీదు ఇవ్నే మార లుంగ్డా ఇవ్నామా భాగ్‍పాడిల్దా మార కుడ్తానటేకె చీట్లు నాక్సేకరి లేఖనంమా నేరవేర్చనటెకె ఆ జర్గ్యూ ఇనటేకేస్‍ సైనికుల్‍ అమ్‍ కర్యూ.<verse eid="JHN 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25"/>ఇని ఆయాబి, ఇన ఆయాని భేన్‍బి క్లోపాని భావణ్‍ హుయితే మరియాబి బుజు మగ్దలలేని మరియబి యేసును సిలువకనా వుబ్రిన్ థా, <verse eid="JHN 19:25"/><verse number="26" style="v" sid="JHN 19:26"/>యేసుఇని ఆయాబి యో ఫ్యార్‍ కర్యతో ఇనా భైయ్యే ఖందే వుబ్రిన్‍ రావను దేఖీన్‍ “ఆయా ఆదేక్‍ తారో ఛియ్యో కరి ఇని ఆయాతి” బోల్యొ.<verse eid="JHN 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27"/>పాస్సతి సిష్యుడ్‍ మ్హాడి దేఖిన్‍ “హదేక్‍ తారి ఆయా” కరి బోలస్‍ యో వఖాత్తీ లీన్‍ యో సిష్యుడ్‍ ఇనా ఘెర్మా రాక్యొ.<verse eid="JHN 19:27"/></para>
  <para style="s">యేసును మరణ్‍</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28"/>ఇన పాస్సల్‍తీ సమస్తమ్‍ తెదేస్‍ ఖాతమ్‍ హువంకరస్‍ కరి యేసు మాలంకరీన్ లేఖనమ్‍ నేరవేరాఖార్కూ, మన తారఖ్‍ లాగుకరస్‍ కరి బోల్యొ.<verse eid="JHN 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29"/>ఎజ్గా చిరకతీ బ్హరాయిన్‍ ఛాతె ఖాటు ద్రాక్చాను రహ్క్ పాత్ర ర్హావమా అనటేకె ఇవ్నే ఏక్ స్పాంజి చిరకతి డుబాయిన్‍, హిస్సోపు కొమ్మన బాందిన్‍ ఇనా మ్హోడన లగాడ్యు. <verse eid="JHN 19:29"/><verse number="30" style="v" sid="JHN 19:30"/>యేసు యో రహ్క్ నా పిన్‍ సమస్తంను ఖారు బోలిన్‍ మూడుక్యు జుకాయిన్‍ ఆత్మాన దినాదిదో.<verse eid="JHN 19:30"/></para>
  <para style="s">యేసును బాజునా హాఃభల్తి టోచాను</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31"/>యో ధన్‍ పస్కా పండగా సిద్దాపరచాను ధన్‍; బేంమాను రోజే ఆరమ్‍ కరను ధన్‍ మోటు ధన్‍ ఇనటేకె యో ఆంగ్తానా ఆరమ్‍ కరను ధన్‍ సిలువఫార్‍ నార్హానుతిమ్‍; ఇవ్నా గోడా తోడ్యునాకిదిన్‍ ఇవ్నా ఖాడైనాక్‍ కరి యూదుల్‍ పిలాతుతి బోల్యొ <verse eid="JHN 19:31"/><verse number="32" style="v" sid="JHN 19:32"/>ఇనటెకె సైనికుల్‍ ఆయిన్‍ యేసు నాకడే మలైన్‍ సిలువ నాక్యుతే అగాడి వాలనబి గోడాన బుజు బేంమాను వాలనబి గోడానబీ తోడ్‍నాకిదిదూ. <verse eid="JHN 19:32"/><verse number="33" style="v" sid="JHN 19:33"/>ఇవ్నే యేసు కనా ఆయిన్‍ ఇనేఖు అగాడిస్‍ మరిజావను దేఖీన్‍ ఇనా గోడా తోడ్యాకోయిని పన్కి, <verse eid="JHN 19:33"/><verse number="34" style="v" sid="JHN 19:34"/>సైనికుల్‍మా ఏక్జనో ఇనా పాక్తినా హఃభల్తి టోచాస్ తేదెస్‍ లోహిబి పాని చూవాస్‍ <verse eid="JHN 19:34"/><verse number="35" style="v" sid="JHN 19:35"/>యో దేక్యోతే ఆ సాబుత్‍దేవుకరస్‍; ఇను సాక్చం హాఃఛిస్‍ తుమే నమ్మ ఖార్కు యో హాఃచిబోలుకరస్‍ కరి యో మాలంకరిన్‍ <verse eid="JHN 19:35"/><verse number="36" style="v" sid="JHN 19:36"/>ఇనా హడ్‍క్యామా ఏక్తోబి తుట్సేకొయినికరి లేఖనమ్‍ నెరవేరా హఃర్కు ఆ జారగస్‍ <verse eid="JHN 19:36"/><verse number="37" style="v" sid="JHN 19:37"/>బుజు యో ఇన టోచ్యుతే ఇనా మ్హాడి దేక్సే కరి బుజేక్‍ లేఖానమ్‍ బోలుకరాస్‍.<verse eid="JHN 19:37"/></para>
  <para style="s">యేసునా సమాధి కరను</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38"/>ఇనా పాస్సల్‍తి యూదుల్ ఢార్జావమా ఛోరేతి యేసునో సిష్యుడ్‍ హుయోతె అరిమతయియతు యోషేపు యో యేసును మూర్దొ లీన్‍జావనటెకె పిలాతు కనా మంగాస్‍ పిలాతు లిన్జాకరి బోలాస్ ఇనాటేకె యో ఆయిన్‍ యేసును షేవంన లీన్‍ జాస్‍ <verse eid="JHN 19:38"/><verse number="39" style="v" sid="JHN 19:39"/>అగాడి రాత్నువహఃత్‍ ఇనహాఃమే ఆయుతె నీకొదేమ్‍బి బరాబ్బర్‍ ఢోడీహ్ః కిలోను బోలమ్‍న బుజు చంధన్ వ్హాక్ను జాఢు ద్రవ్యమ్‍, ఊద్నికాడినా ఇనకేడె లీన్‍ ఆయు. <verse eid="JHN 19:39"/><verse number="40" style="v" sid="JHN 19:40"/>ఎత్రస్‍మా యేసును షేవంనా పల్లీన్‍ ఆయిన్‍ యూదుల్‍ మర్యాదాతీ గాడతిమ్‍ యో సుగంధా ద్రవ్యము ఇనా లోథిన్‍ ధోలు లుంగ్డా లాప్టూతు సమాధినాటెకె తయార్‍ కర్యు <verse eid="JHN 19:40"/><verse number="41" style="v" sid="JHN 19:41"/>యేసునా సిలువ నాక్యుతే జొగోమా ఏక్ భాగ్‍ థూ యో బాగ్మా కోన్బి కెదేబి ర్హావనాటెకె నవూ సమాధి ఏక్ థూ <verse eid="JHN 19:41"/><verse number="42" style="v" sid="JHN 19:42"/>యో సమాధి ఖాందే ర్హవామ ఇనటెకె యో ధన్‍ యూదుల్‍ను సిద్ధపరుచను ధన్‍ రవమా ఇవ్నే యేసునా ఇన్మా మేల్యా.<verse eid="JHN 19:42"/></para>
  <chapter eid="JHN 19"/>
  <chapter number="20" style="c" sid="JHN 20"/>
  <para style="s">ఖాలి గోరెడు</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1"/>ఆదివారంనా జరా రాత్‍రవ్వాన వ్హానె హఃత్రేస్‍ మగ్దలేని మరియ వ్హానే ఘొరాఢకనా ఆయిన్‍ ఘొరాఢన ఫర్‍ ముచ్చాయూతే బండొకాఢిన్‍ రవ్వమా దేఖి. <verse eid="JHN 20:1"/><verse number="2" style="v" sid="JHN 20:2"/>అనటేకే మరియ మిలావ్తీహుయిన్‍ సీమోన్‍ పేతుర్‍కనబి యేసునె ఫ్యార్‍కర్యొతె యోఅజేక్‍ సిష్యుడ్‍కనా ఆయిన్‍ ప్రభువున ఘొరాఢమతూ పల్లీన్‍ గయూ ఇన కెజ్గా రాఖ్యాకి మాలంకొయినికరి బోల్యూ.<verse eid="JHN 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3"/>అనటేకే పేతుర్‍బి అజు సీమోన్‍ ఇను యో సిష్యుడ్‍ నిఖిన్‍ ఘొరాఢకన ఆయూ. <verse eid="JHN 20:3"/><verse number="4" style="v" sid="JHN 20:4"/>ఇవ్నేబేజణ మలీన్‍ మిలావుతూ రవ్వమా, యో సిష్యుడ్‍ పేతుర్‍తిబి ఎగ్గిస్‍ మిలావ్తూహుయిన్‍ అగాఢి సమాధికనా ఆయిన్‍ <verse eid="JHN 20:4"/><verse number="5" style="v" sid="JHN 20:5"/>మహీ జుఖీన్‍ దేఖ్మ ధోలు లుంగ్డా పఢిన్‍రవ్వాను దేఖ్యొ పన్కి ఇనే గోరేడుమా ప్రవేసించోకొయిని. <verse eid="JHN 20:5"/><verse number="6" style="v" sid="JHN 20:6"/>సీమోన్‍బి పేతుర్‍ ఇనాకెడె ఆయిన్‍ ఘొరాఢమా గయ్యా. ధోలా లుంగ్డా పడిర్హావనుబి <verse eid="JHN 20:6"/><verse number="7" style="v" sid="JHN 20:7"/>ఇను ముఢ్క్యాను టువాల్నా ధోలు లుంగ్డా కనా కొయినితిమ్‍ అలాదూ ఏక్ జోగొమా లప్టేన్‍ ర్హావను దేఖాస్‍ <verse eid="JHN 20:7"/><verse number="8" style="v" sid="JHN 20:8"/>తెదె అగాఢి సమధికనా ఆయుతే యో సిష్యుడ్‍ మహీజైన్‍ దేఖిన్‍ నమ్మాస్‍ <verse eid="JHN 20:8"/><verse number="9" style="v" sid="JHN 20:9"/>యో మరణ్‍ మతూ ఉట్టాను హాఃచీ కరి లేఖనాల్మా ఇవ్నే బుజుబి గ్రహించకోయిని. <verse eid="JHN 20:9"/><verse number="10" style="v" sid="JHN 20:10"/>తెదేస్‍ యో సిష్యుల్‍ పాచు ఫరీన్‍ ఇవ్నా ఘర్కనా చలిగొ.<verse eid="JHN 20:10"/></para>
  <para style="s">యేసు మద్గలేని మరియా దేఖ్కావను</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11"/>తెదె మరియా సమాధినా భాధర్‍ వుబ్రిన్‍ రోవుంకర్తితి, యో రొవ్తీహుయీన్‍ సమధిమా జుకీన్‍ దేకమా. <verse eid="JHN 20:11"/><verse number="12" style="v" sid="JHN 20:12"/>ధోలు లుంగ్డా పేరాక్యుతె బేజాణ దేవ్నుదూతల్‍ యేసును మూర్దు మ్హేలురాక్యుతె జోగొమా ముడక్యా మ్హానె ఏక్జాణు గోడా మ్హాడి ఏక్జాణు బేసిన్‍ ర్హావను దెఖాయా. <verse eid="JHN 20:12"/><verse number="13" style="v" sid="JHN 20:13"/>తెదె దూతాల్‍ మరియతి ఆయా సానటెకే రోవుంకర్‍ కరి ఇనా పుఛ్చావమా, “మరియ మార ప్రభూన కోన్కి పల్లిచలీగు, ఇనా కిజ్గా మ్హేలిరాక్యుస్కి మన మాలంకోయిని” కరి బోలి.<verse eid="JHN 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14"/>యో ఆ వాతె బోలిన్‍ ఫిటేఫరీన్‍ యేసు వుబ్రిన్‍ ర్హావాను దేఖి పన్కి యో యేసు కరి హాఃనాద్‍ ధరికోయిని. <verse eid="JHN 20:14"/><verse number="15" style="v" sid="JHN 20:15"/>యేసు ఆయా సానటేకె రోవుంక్రస్ కినాటెకె ధూండుకరస్‍? కరి మరియన పుఛ్చావమా యో బాయికో ఇనా తోటా మాలికరి లైహీజైన్‍ ఖాయాబ్‍ తూ ఇనా లీన్గయోతోబి ఇనా కిజ్గా మ్హేల్‍రాక్యోస్కీ మన బోల్‍ మే ఇనా పల్లీన్‍ జైస్‍ కరి బోలి.<verse eid="JHN 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16"/>యేసు బాయికోన దేఖిన్‍ మరియ కరి బూలైన్‍ యోబాయికొ ఇనా భాణే ఫరిన్‍ ఇనా హేబ్రి భాషమా రబ్బూని కరి బూలవస్‍ యో వాత్నా బోధకుడ్‍ కరి అర్థం<verse eid="JHN 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17"/>యేసు భాకోతి మే బుజుబి భా కన గయోకొయిని; అనటేకే మన ఛీమ్నోకో; హుయుతొ మార భైయేకనా జైయిన్‍ మార భా తుమార భా బి, మార దేవ్బి తుమార దేవ్‍హుయోతె ఇవ్నాకన ఫరిన్‍ జంకురుస్ కరి ఇవ్నేతి బోల్కరి బోల్యొ.<verse eid="JHN 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18"/>మగ్దలేనే మరియ ఆయిన్‍ మే ప్రభువునా దేక్యితి, యో మారేతి ఆ వాతె సిష్యుల్నా బోల్కరి మాలంకర్యి.<verse eid="JHN 20:18"/></para>
  <para style="s">యేసు సిష్యుల్నా దెఖ్కావను</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19"/>ఆదివార్న హఃజే సిష్యుల్‍ యూదులనా అధికారల్‍ ఢరీన్‍ ఇవ్నే ఛాతె ఘర్ను తలుపున మూఛిలీన్‍ రవ్వామా యేసు ఆయిన్‍ ఇచ్మా ఉబ్రీన్‍ తుమ్న షాంతి హువదాకరి ఇవ్నేతి బోల్యొ. <verse eid="JHN 20:19"/><verse number="20" style="v" sid="JHN 20:20"/>యో ఇమ్నితర బోలీన్‍ ఇవ్నాఇను హాత్నా బగల్‍ వతాలమా, సిష్యుల్‍ ప్రభూవున దేఖీన్ ఖుషిహుయూ. <verse eid="JHN 20:20"/><verse number="21" style="v" sid="JHN 20:21"/>తెదె యేసు బుజు తుమ్న సమాధనంతి హువదా, భా మన మొక్లోతిమ్మస్‍ మేబి తుమ్న మొక్లూ కరూస్కరి ఇవ్నేతి బోల్యొ. <verse eid="JHN 20:21"/><verse number="22" style="v" sid="JHN 20:22"/>యో ఆవాతె బోలీన్‍ ఇవ్నాఫార్‍ పూఖీన్ పరిసుద్ధాత్మనా పొందొ <verse eid="JHN 20:22"/><verse number="23" style="v" sid="JHN 20:23"/>తుమే కినా పాప్నా మాప్‍ కరస్కి, ఇవ్నా పాప్‍నా మాప్‍ కర్సె; కిను పాప్న తుమే రాఖస్కి యోపాప్‍ ఇమ్మస్‍ ర్హాసెకరి తుమారేతి బోలుకరూస్‍.<verse eid="JHN 20:23"/></para>
  <para style="s">యేసు బుజు తోమా</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24"/>యేసు ఆయోతెదె, భారజణమా ఏక్జనో దిదుమకరి బొలావతె తోమా ఇవ్నమా కోథోని. <verse eid="JHN 20:24"/><verse number="25" style="v" sid="JHN 20:25"/>అనటేకే మిగ్లితె సిష్యుల్‍ “హమే ప్రభువునా దేక్యాకరి ఇనేతి బొలమా యో మేఇను హుత్మా మేక్నుగుర్తునా దేఖీన్‍ మార అంగ్లీయే యోమేక్ను గుర్తుమా బేందీన్‍ మార హాత్న ఇను హాత్న హఃమే రాక్యొతోస్‍ పన్కి నమ్మనూస్‍ నమ్మిస్‍కొయినికరి” ఇవ్నేతి బోల్యొ.<verse eid="JHN 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26"/>ఆ‍ఠ్మాను ధనే‍ ఇను సిష్యుల్‍ బుజు మహీ రయ్యూతెదె తోమా ఇవ్నేతి మలిన్‍ రయ్యోతొ. తలుపు ముఛ్చాయిన్‍ రవ్వామా యేసు ఆయిన్ ఇవ్నాయిచ్మా ఉబ్రిన్‍ “తుమ్న సమాధానంహువదా” కరి బోల్యొ. <verse eid="JHN 20:26"/><verse number="27" style="v" sid="JHN 20:27"/>పాసల్తీ తోమాన దేఖిన్‍ తారు హాత్‍ హంకడ్‍ ఛీదుకరిన్‍ మార హాత్న దేక్‍; తారహాత్‍ ఛీదుకరీన్‍ మార పహాఃలిమా రాఖ్‍ అవిష్వాసం కొయినీతింమ్‍ విష్వాస్‍హుయిన్ ర్హాకరి‍ బోల్యొ.<verse eid="JHN 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28"/>అనటేకే తోమా ఇనేతి మార ప్రభూ, మార దేవ్‍ బోల్యొ<verse eid="JHN 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29"/>యేసు తూ మన దేఖీన్‍ నమ్యో, దేఖకొయినీతింమ్‍ నమ్మితెయివ్నే ధన్యుల్‍కరి ఇనేతి బోల్యొ.<verse eid="JHN 20:29"/></para>
  <para style="s">యోహాన్‍ పుస్తక్‍ను ఉద్దేష్యం</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30"/>బుజు కెత్రూకిహుయుతె అలాదు ఖానద్ను క్రియల్‍నా యేసు ఇను సిష్యుల్‍నఖామే కర్యొ; యో ఆ తలాక్ను కాగత్‍ లిక్కారుకొయినీ <verse eid="JHN 20:30"/><verse number="31" style="v" sid="JHN 20:31"/>పన్కి యేసు దేవ్ను ఛియ్యోహుయోతె క్రీస్తుతుకరి తుమే నమ్నూతింమ్‍, నమ్మిన్‍ ఇను నామ్మా జీవమ్‍ పొందునుకరి ఆ లిక్కాయ్‍రూస్‍.<verse eid="JHN 20:31"/></para>
  <chapter eid="JHN 20"/>
  <chapter number="21" style="c" sid="JHN 21"/>
  <para style="s">యో క్రీస్తు అప్ను సేవనా మాలిక్‍</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1"/>ఇనపాసల్తీ యేసునె తిబెరియ ధర్యావ్‍ను కనారికన సిష్యుల్నా బుజేక్‍తార యోస్‍ ప్రత్యక్చాపరచిలిదో. <verse eid="JHN 21:1"/><verse number="2" style="v" sid="JHN 21:2"/>కింమ్‍కతో సీమోన్‍కరి బోలవాతే పేతుర్‍బి, దిదుమకరి బోలావతె తోమాబి, గలిలయమా కానాకరి గామ్‍వాలొహుయుతె నతనయేల్‍బి, జెబెదయని ఛియ్యాబి, బుజు ఇను సిష్యుల్‍మా బుజు బే జనబి మలిన్‍ రయ్యుతూ. <verse eid="JHN 21:2"/><verse number="3" style="v" sid="JHN 21:3"/>సీమోన్‍ పేతుర్‍ మే మాస్లాధరనటెకె జంకరస్‍ కరి ఇవ్నేతి బోలమా ఇవ్నే హమేబి తారకేడె అయేస్కరి బోల్య. ఇవ్నే జైయిన్‍ ఢోంగాచఢ్యా పన్కి, యోరాతె సాత్బి ధర్యాకొయిని. <verse eid="JHN 21:3"/><verse number="4" style="v" sid="JHN 21:4"/>వానేఖాత్రే హుంకరమా యేసు కనారిన ఉబ్రిన్‍ థో, పన్కి యో యేసుకరి సిష్యుల్‍ ఖానద్‍ కర్యకొయిని. <verse eid="JHN 21:4"/><verse number="5" style="v" sid="JHN 21:5"/>యేసు “దోస్త్, ఖావనటేకె తుమారకనా సాత్బి” ఛా? కరి ఇవ్నా పుఛ్చావమా కొయినికరి ఇవ్నే ఇనేతి బోల్యా.<verse eid="JHN 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6"/>తెదె యో ఢోంగాన ఖవ్వాత్‍ భణే జర్యాన నాక్కో తుమ్నామల్చేకరి బోల్యొ. అనటేకే ఇవ్నే ఇంకరమా, మాస్లా జాఖాత్తి పఢమా జర్యానకేఛనబి కో హుయూని.<verse eid="JHN 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7"/>తెదె యేసు ఫ్యార్‍కర్యతె సిష్యుడ్‍ ఇనే ప్రభువుకరి పేతుర్‍తీ బోల్యొ. యో ప్రభువుకరి సీమోన్‍ పేతుర్‍ హాఃజీన్‍ ఉగ్గాడహుయిన్‍ రవ్వామా ఉప్పర్‍నులుంగ్డాన నాఖిలీన్‍ ధర్యావ్మా కూదిగా <verse eid="JHN 21:7"/><verse number="8" style="v" sid="JHN 21:8"/>కనారిన బరాబ్బర్‍ బే ఖో మూరల్ను దూర్‍ రవ్వామా. మిగ్లితె సిష్యుల్ మాస్లా‍తూతె జర్యాన కేస్తూ యోహాను ఢోంగమా ఆయూ. <verse eid="JHN 21:8"/><verse number="9" style="v" sid="JHN 21:9"/>ఇవ్నే ఉత్రీన్‍ కనారిన ఆవుంస్‍కరా ఎజ్గా ఆగ్బి ఇనప్పర్‍ బేంద్యురాక్యుతె మాస్లాబి, రోటా దెక్కాయు. <verse eid="JHN 21:9"/><verse number="10" style="v" sid="JHN 21:10"/>యేసు ఇవ్నేతి తుమేహంకె దర్యాతె మాస్లామా థోడులీన్‍ ఆవోకరి ఇవ్నేతీబోలమా<verse eid="JHN 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11"/>సీమోన్‍ పేతుర్‍ ఢోంగచఢిన్‍ జర్యానా కనారినా కేఛ్యూ యో ఏక్‍ఖో తీన్‍ప్పర్‍ అఢాయక్ మోట్టా మాస్లావ్తీ బరాయిన్ తూ కెత్రూకి మాస్లా జర్యా బరాయ్‍యిన్‍ పడితోబి జర్యా జరబీ పాట్యూకొయిని. <verse eid="JHN 21:11"/><verse number="12" style="v" sid="JHN 21:12"/>యేసు బోల్యొ ఆవో ఖవ్వోకరి ఇవ్నేతి బోల్యొ. యో ప్రభువుకరి ఇవ్నా మాలంహుయ్‍జావమా తూ కోన్కరి సిష్యుల్మా కోన్బి ఇన పుఛ్చావన కినా హాత్కోహుయూని. <verse eid="JHN 21:12"/><verse number="13" style="v" sid="JHN 21:13"/>యేసునె ఆయిన్‍ యోరోట్టన తోఢీన్‍ ఇవ్నా భాగ్‍పాడ్యొ. ఇమ్మస్‍ మాస్లానబీ భాగ్‍పాడీన్‍దిదో.<verse eid="JHN 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14"/>యేసు మరన్‍మతూ ఉట్టీన్‍ పాసల్తి సిష్యుల్న ప్రత్యక్చహువనూ ఆ తీన్‍మనూఛోట్‍.<verse eid="JHN 21:14"/></para>
  <para style="s">యేసు అజు పేతుర్‍</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15"/>ఇవ్నే ఖానుఖైయిన్‍ పాసల్తీ యేసు సీమోన్‍ పేతుర్న దేఖీన్‍ యోహాన్ను ఛియ్యో‍హుయోతె సీమోన్‍, అవ్నెతిబి తూ మన జాఖాత్తి ఫ్యార్‍కరూకరస్‍న్నా? కరి పుఛ్చావమా ఇనే ఓవో ప్రభూ, మే తునా ఫ్యార్‍కరూకరస్‍ కరి తునాస్‍ మాలంకరి ఇనేతి బోల్యొ; యేసునె మారు మ్హేండన చరావ్కరి ఇనేతి బోల్యొ. <verse eid="JHN 21:15"/><verse number="16" style="v" sid="JHN 21:16"/>బుజేక్తార యో యోహాన్‍‌ ఛియ్యోహుయోతె సీమోన్‍ మన ఫ్యార్ కరుకరస్‍నా? కరి బెంమ్మనితార ఇనస్‍ పుఛ్చావమా ఇనే ఓహో ప్రభు మే తున ఫ్యార్‍కరుకరస్‍ కరి తూస్‍ మాలంకర్‍ లీస్కరి ఇనేతి బోల్యొ యేసునె మారు మ్హేండన కాప్లారవ్వోకరి బోల్యొ. <verse eid="JHN 21:16"/><verse number="17" style="v" sid="JHN 21:17"/>తీన్మనుఛోట్‍ యో యోహాన్ను ఛియ్యోహుయోతె సీమోన్‍, మన ఫ్యార్ కరుకరస్నా? కరి తీన్మను ఛోట్‍ ఇనస్ పుఛ్చాయోకరి పేతుర్‍ ఇబ్బందిహుయిన్‍ ప్రభూ, తూ సమస్తంనా మాలంకర్యాకోస్‍, తున ఫ్యార్‍కరూకరస్‍ కరి తూస్‍ మాలంకర్‍లిస్కరి ఇనేతి బోల్యొ. యేసు బోల్యొ, మార మ్హేంఢన ఛరావో.<verse eid="JHN 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 21:18"/>తూ కవ్వారోహుయో తెదె తారుతూస్‍ కంబర్నా బాంధిలీన్‍ సిద్దపఢిన్‍ తున ఇష్టంహుయు జొగోమా పర్తోరయ్యో; తూ భుఢ్డోహుయో తెదె తారహాత్ తూ పహాఃరిస్‍ అజేక్జనో తారు కంబర్నా బాంధీన్‍ తున ఇష్టంహుయు జొగోమా తున ఢోహిలీన్‍ జాసేకరి తారేఖూ హఃఛితీ బోలుకరూస్కరి ఇనేతి బోల్యొ. <verse eid="JHN 21:18"/><verse number="19" style="v" sid="JHN 21:19"/>ఇనే కెజాత్నూ మరణ్తి దేవ్నా మహిమపర్చేకి ఇన సోచీన్‍ యో ఆవాత్నా బోల్య. అమ్‍ బొలీన్‍ “మార కెడె ఛాలో” ఇనెతి బోల్యొ.<verse eid="JHN 21:19"/></para>
  <para style="s">యేసు అజు ఏక్ సిష్యుడు</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20"/>పేతుర్‍ పీట్టేపరీన్‍ యేసు ఫ్యార్‍కర్యోహొబి ఖాణు ఖాహాద్యతె బంతిన ఇను ఛాతికన లగాడీన్‍ ప్రభూ, “తున దర్యాయ్‍దె వాలో కోన్కరి పుఛ్చాయోహొ” సిష్యుడ్‍ ఇవ్నాకెడె ఆవను దేక్యొ. <verse eid="JHN 21:20"/><verse number="21" style="v" sid="JHN 21:21"/>పేతుర్‍ ఇన దేఖిన్‍ ప్రభు, అను సంగతి సాత్‍హుసేకరి యేసున పుఛ్చాయో.<verse eid="JHN 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22"/>యేసు బోల్యొ, “మే ఆవతోడి ఇనే రవ్వాను మన ఇష్టంహుయుతొ యో తునసే? తూ మారకెడె ఛాల్‍కరి” బోల్యు.<verse eid="JHN 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23"/>ఇనఖాజే యోసిష్యుడ్నె మర్చెకొయినికరి వాత్‍ భైయేమా ప్రచార్‍హుయు. పన్కి యేసు మర్సెకొయినికరి యేసు ఇనేతి బోల్యొకొయిని పన్కి మే ఆవతోడి యో రవ్వాను మన ఇష్టంహుయుతొ యో తునసేకరి? బోల్యొ.<verse eid="JHN 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24"/>ఆ సంగతుల్న బారెమా జామీన్‍బోల్తూ ఆ లీక్యోతె సిష్యుడ్‍ ఆస్‍; అను సాబుత్‍ హాఃఛికరి మాలం‍కరిన్‍ ఛా.<verse eid="JHN 21:24"/></para>
  <para style="s">ఆఖరి</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25"/>యేసు కర్యోతె కార్యల్‍ బుజుబి కెత్రూకి ఛా. ఇనమా హర్యేక్‍నా వివరించిన్‍ లీక్యుతో ఇంమ్‍ లిక్కాయుతె తలాక్ను కాగత్‍బి ములక్ను పూర్సెకొయినికరి మన సొచ్చాంకరాస్‍.<verse eid="JHN 21:25"/></para>
  <chapter eid="JHN 21"/>
</usx>
