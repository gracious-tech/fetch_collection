  <para style="h">Matiu</para>
  <para style="toc1">Ñwed Matiu</para>
  <para style="toc2">Matiu</para>
  <para style="toc3">Mt</para>
  <para style="mt1">Ñwed Matiu</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">Ubon Emana Jisọs Kraist</para>
  <para style="lh">
    <verse number="1" style="v" sid="MAT 1:1" />Emi edi ñwed emana Jisọs Kraist, emi ekedide eyen Defid, emi okotode ke ubon Ebraham.<verse eid="MAT 1:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2" />Ebraham ekedi Ete Aisik, Aisik onyuñ edi ete Jekọb. Jekọb onyuñ edi ete Juda ye nditọ ete esie.<verse eid="MAT 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 1:3" />Juda ekedi ete Peres ye Sera emi Tama akamande; Peres ekedi ete Esrọn; Esrọn ekedi ete Ram.<verse eid="MAT 1:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 1:4" />Ram ekedi ete Aminadab; Aminadab ekedi ete Nasọn; Nasọn ekedi ete Salmọn;<verse eid="MAT 1:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="MAT 1:5" />Salmọn ekedi ete Boas emi Rehab akamande; Boas ekedi ete Obed emi Rut akamande; Obed ekedi ete Jesi,<verse eid="MAT 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="MAT 1:6" />Jesi ekedi ete Edidem Defid. Defid ekedi ete Sọlọmọn emi eka esie ekedide ñwan ndọ Uria;<verse eid="MAT 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="MAT 1:7" />Sọlọmọn ekedi ete Rehobuam; Rehobuam ekedi ete Abiya; Abiya ekedi ete Asa;<verse eid="MAT 1:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="MAT 1:8" />Asa ekedi ete Jehosafat; Jehosafat ekedi ete Joram; Joram ekedi ete Usia;<verse eid="MAT 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="MAT 1:9" />Usia ekedi ete Jotam; Jotam ekedi ete Ahas; Ahas ekedi ete Esikaya;<verse eid="MAT 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="MAT 1:10" />Esikaya ekedi ete Manase; Manase ekedi ete Amọn; Amọn ekedi ete Josia;<verse eid="MAT 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="MAT 1:11" />Josia ekedi ete Jekonia ye nditọ ete esie, emi ekemanade ke ini emi eketañde mmọ eka ke Babilọn.<verse eid="MAT 1:11" /></para>
  <para style="lh">
    <verse number="12" style="v" sid="MAT 1:12" />Ndien ke ema eketañ mmọ eka ke Babilọn; Jekonia ekedi ete Salatiel, Salatiel ekedi ete Serubabel;<verse eid="MAT 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="MAT 1:13" />Serubabel ekedi ete Abiud; Abiud ekedi ete Eliakim; Eliakim ekedi ete Asọ;<verse eid="MAT 1:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="MAT 1:14" />Asọ ekedi ete Sadọk; Sadọk ekedi ete Akim; Akim ekedi ete Elihud;<verse eid="MAT 1:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15" />Elihud ekedi ete Eliesa; Eliesa ekedi ete Matan; Matan ekedi ete Jekọb;<verse eid="MAT 1:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="MAT 1:16" />Jekọb ekedi ete Josef, emi ekedide ebe Meri, eka Jisọs Kraist, emi ekotde Andinyaña.<verse eid="MAT 1:16" /></para>
  <para style="lf">
    <verse number="17" style="v" sid="MAT 1:17" />Ntre kpukpru emana, ọtọñọde ke Ebraham osim Defid ekedi emana duopenañ. Onyuñ ọtoñọde ke Defid tutu osim ini emi eketañde mmọ eka ke Babilọn ekedi emana duopenañ, ndien duopenañ ñko ọtọñọde ke ini oro tutu osim ini emana Kraist.<verse eid="MAT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Ndien emana Jisọs Kraist ekedi ntem: Ke ema ekemen Meri eka Esie enọ Josef ke ndọ, mbemiso mmọ enyene ebuana añwan ye ebe, ema eyarade efiọk ete ke enye oyomo idibi oto ke odudu Edisana Spirit. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Edi sia Josef ebe esie ekedide edinen owo, mikinyuñ iyomke ndisuene enye ke iso owo, enye ama ebiere ndisio enye ndọ ke ndibe.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Edi ke ini enye okosuk ekerede ñkpọ emi, sese, Enjel Jihofa ama ọbiọñọde enye ke iso ke ndap, onyuñ ọdọhọ enye, ete, “Josef, eyen Defid, kufehe ndik ndida Meri nte ñwan fo: koro idibi oro enye oyomode oto Edisana Spirit. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Ndien enye eyeman eyen eren, ndien afo eyenyuñ osio Enye enyiñ JISỌS, koro edi Enye edinyaña ikọt Esie isio ke mme idiọkñkpọ mmọ.”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Ndien kpukpru mme ñkpọ emi eketibe man osu nte Jihofa akadade inua Asiak Uduak Esie etiñ, ete; <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“Sese eyenọwọñ añwan eyeyomo, onyuñ aman, eyen eren, ndien eyenyuñ esio Enye enyiñ Imanuel,” emi ọwọrọde ete, “Abasi ododu ye ñnyin.” <verse eid="MAT 1:23" /><verse number="24" style="v" sid="MAT 1:24" />Ke ini Josef ama ekedemere, enye ama onyuñ anam kpa nte Enjel Jihofa eketemede enye, onyuñ ada ñwan esie adian ke idem esie. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Edi enye ikọdiọñọke enye iferi nte ñwan tutu enye aman eyen eren. Ndien Josef ama osio Enye enyiñ “JISỌS”.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">Emana Jisọs</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Jisọs akamana ke obio Betelehem ke Judia, ke eyo Edidem Erọd. Mme ọfiọkñkpọ owo ema eto ke edem usiahautin edi ke Jerusalem, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />enyuñ ebup ete, “Eyen emi amanade nte Edidem Mme Ju odu mmọñ? Koro ñnyin ima ikut ntantaọfiọñ Esie ke edem usiahautin, ndien ñnyin imedi ndituak ibuot nnọ Enye.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Ke ini Edidem Erọd okokopde ñkpọ emi, esit ama etimede enye ye kpukpru mbio obio Jerusalem. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Enye ama okot kpukpru mme ikpọ oku ye mme ewet ñwed obio, onyuñ obup mmọ ete, “Mmọñ ke Kraist edimana?”<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />Mmọ ema ebọrọ enye, ete, “Ke Betelehem ke Judia,” koro emi edi se Asiak Uduak Abasi ekewetde: <verse eid="MAT 2:5" /><verse number="6" style="v" sid="MAT 2:6" />“ ‘Ndien afo, O Betelehem ke isọñ Juda, ukprike ukaha ke baba usuñ kiet ke otu mbon Juda; koro ada usuñ editode fi ke esit iwọrọ, emi edikarade ikọt Mi Isrel.’ ”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Ekem Erọd okot mme ọfiọkñkpọ owo oro ke ndibe, onyuñ otim obup mmọ ini emi ntantaọfiọñ oro ọkọwọrọde. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Ndien enye ama ọdọñ mmọ eka ke Betelehem, onyuñ ọdọhọ mmọ ete, “Eka eketim eduñọde ebaña nsekeyen oro, ndien ke ini mbufo edikutde Enye, efiak edi edidọhọ mi, man ami ñko ñka ñkatuak ibuot nnọ Enye.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Ke mmọ ema ekekop uyo Edidem, mmọ ema edaha isañ, ndien sese, ntantaọfiọñ emi mmọ ekekutde ke edem usiahautin ebe iso ọnọ mmọ ndien edituak ada ke ebiet emi nsekeyen oro okodude. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Ke ini mmọ ekekutde ntantaọfiọñ oro, mmọ ema edat esit etieti.<verse eid="MAT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 2:11" />Ke mmọ ema ekeduk ufọk ekekut nsekeyen ye eka esie Meri, mmọ ema eduọñọ ke isọñ etuak ibuot enọ Enye. Ndien mmọ ema ekubọde ekebe ñkpọuto mmọ enyuñ enọ Enye enọ gold, ye ufuọññkpọ ye mir (itiat emi enemde ufuọñ eke efọpde). <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Sia Abasi okoduride mmọ utọñ ke ndap ete mmọ ekufiak eka ebine edidem Erọd, do mmọ ema esaña usuñ efen enyọñ obio mmọ.<verse eid="MAT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Ekem ke mmọ ema ekenyọñọ, sese, Enjel Jihofa owut Josef idem ke ndap, onyuñ ọdọhọ enye ete, “Daha ke enyọñ da nsekeyen ye eka esie, fehe ka ke Ijipt, nyuñ tie do tutu Ami ndọhọ fi ọnyọñ, koro Erọd eyeyom nsekeyen oro ndiwot.” <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Ndien enye ama adaha ke enyọñ onyuñ emen nsekeyen ye eka Esie ke okoneyo oro efehe aka ke Ijipt, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />ebiet emi enye eketiede tutu osim ini ñkpa Erọd. Man osu nte Jihofa akadade inua Asiak Uduak Esie etiñ ete.</para>
  <para style="p" vid="MAT 2:15">“Ñkokot eyen Mi nsio ke Ijipt edi.”<verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Ke ini Erọd okokutde ete ke mme ọfiọkñkpọ owo oro ema ebiaña imọ, enye ama ayat esit eti eti, onyuñ ọdọhọ eka ekewot kpukpru nditọ irenowo isua iba tutu osim nsek nditọ, nte asañade ekekem ye ini emi enye, okokopde oto mme ọfiọkñkpọ owo. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Ntem, emi ama osu nte Jerimaya, Asiak Uduak Abasi, ọkọdọhọde ete, <verse eid="MAT 2:17" /><verse number="18" style="v" sid="MAT 2:18" />“Ndien ekop uyo otode ke Rama, ntuaña ye ñkpo mfuhọ, Rakel katua abaña nditọ esie, onyuñ esin ndibọ ndọñesit, koro mmọ miduhọ aba.”<verse eid="MAT 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Ke ini Erọd ama akakpa, sese, Enjel Jihofa ama owut Josef idem esie ke ndap ke Ijipt, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />ndien ọdọhọ enye ete, “Dahada ke enyọñ, nyuñ men nsekeyen emi ye eka esie fiak nyọñ ke isọñ Isrel, koro mmọ emi ekeyomde ndiwot nsekeyen oro ekpaña.”<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Ndien enye ama adaha kenyọñ, ada nsekeyen ye eka esie afiak ọnyọñ ke isọñ Isrel. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Edi ke ini enye okokopde ete ke Akelọs ama ada ubọñ ke Judia ke itie ete esie Erọd, enye ama efehe ndik ndika do. Edi nte Abasi eketemede enye ke ndap enye ama akabade ọnyọñ isọñ, Kalili, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />okoduñ ke akwa obio emi ekerede Nasaret. Man osu nte mme Asiak Uduak Abasi eketiñde ete, “Eyekot Enye Eyen Nasaret.”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">Jọn Babtis Ọtọñọ Utom Esie</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Ke mme usen oro Jọn Babtis ama ọtọñọ ndikwọrọ ikọ ke isọñ utatan Judia, ete: <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />“Mbufo ekabade esit, koro Obio Ubọñ Abasi ekpere.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Jọn ekedi enyemi Aisaya (Asiak Uduak Abasi) eketiñde abaña ete, “Uyo kofiori ke akpa utatan, ete, mbufo ediọñ usuñ Jihofa, eneñede ọkpọusuñ Esie.”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Jọn ekesine ọfọñidem emi edade idet unam emi ekerede Kamel enam, onyuñ ọbọbọ ikpa unam ke isin esie; udia esie okonyuñ edi ñkukuñkpọyọriyọ, ye aranọkwọk ikọt. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Ekem mbio Jerusalem ye ofuri mbon Judia, ye ofuri ñkanñkuk Jọdan ema ewọñọ etiene enye. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Mmọ ema eyarade mme idiọkñkpọ mmọ, ndien enye ama enim mmọ babtisim.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Edi ke ini enye okokutde ediwak mme Farisi ye Sadusi edide ndina babtisim ke ubọk esie, enye ama ọdọhọ mmọ, ete: “Mbufo nditọ urukikọt! Anie eketeme mbufo ete efeñe ebọhọ iyaresit Abasi emi edidide? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Esioño mfri emi ekemde ye edikabade esit, <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />ekunyuñ ekere ke esit mbufo, ete, ‘Mmimọ imenyene Ebraham nte Ete’; yak ndọhọ mbufo nte ke Abasi ekeme ndinam mme itiat emi edaha eda edi nditọ enọ Ebraham. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Enim ekuri ke etak eto, ndien kpukpru eto emi miñwumke nti mfri eyesibe eduọk, ndien emen esin ke ikañ.”<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />“Ami nda mmọñ nnim mbufo babtisim ke ntak edikabade esit, edi Enyemi, etienede mi ke edem enyene odudu akan mi, nte ami mme ndotke ndikama ikpaukot Esie. Enye eyenim mbufo babtisim ye Edisana Spirit ye ikañ. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Enye eyebak ibokpot osioño ke okpotok, asat mbio efep ndien ọfọp okpotok ke ikañ emi asakde ke nsinsi, ndien atañ ñkpasip mmọ onim ke ubet unim ibokpot.”<verse eid="MAT 3:12" /></para>
  <para style="s1">Jisọs Ana Babtisim</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Ekem Jisọs oto ke Kalili edi ke Jọdan etiene Jọn man onim enye babtisim. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Jọn ama odomo ndibiọñọ Enye, ete, “Akam edi Afo ekpenim mi babtisim, Afo edi didie etiene mi?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Edi Jisọs ama ọbọrọ enye ete, “Yak edi ntre ke emi. Koro ke ntem ke ñnyin idinam kpukpru ndinen ido esu.” Do ke Jọn ekenyime ọnọ Enye.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Ke Jisọs ama akana babtisim ama, onyuñ ọwọrọ ke mmọñ ọdọk obot, sese enyọñ ama eberede ndien enye okut Spirit Abasi nte ọsuhọrede nte Ibiọm edisọrọ Enye ke idem. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Ndien uyo oto ke enyọñ ọdọhọ ete, “Emi edi edima Eyen emi enemde Mi esit etieti.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">Idomo Jisọs</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Ekem Edisana Spirit ada Jisọs usuñ aka ke isọñ utatan (Wildanes) man Setan okodomo Enye. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Ke Enye ama eketre udia ke uwemeyo aba ye ke okoneyo aba, biọñ ama ọdọñ Enye. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Setan ama edi ebine Enye, onyuñ ọdọhọ Enye ete, “Edieke Afo edide Eyen Abasi, nam mme itiat emi ekabade edi uyo.”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Jisọs ama ọbọrọ enye ete, ewet ete, “Owo ididuhọ uwem ito ke uyo ikpọñ, edi oto ke kpukpru ikọ emi ọwọrọde Abasi ke inua.”<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Ekem Setan ada Enye aka ke edisana obio, onyuñ anam Enye ọdọk ada ke ñkoñkoñ ebiet ke itie Ukpono Abasi (Temple), <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />ndien ama ọdọhọ Enye ete, “Edieke Afo edide Eyen Abasi, frọ duọ ke isọñ,” koro ema ewet ete, “Abasi eyewuk mme enjel Esie ebaña Fi, ndien mmọ eyekpobi Fi ke ubọk mmọ, man Afo udutuak ukot Fo ke itiat.”<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Jisọs ama ọbọrọ enye ete, “Ema ewet ñko ete, ‘Kudomo Ọbọñ Abasi fo.’ ”<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Setan ama ọtọñọ ntak ada Enye ọdọk aka ke enyọñ ñkoñkoñ obot, onyuñ owut Enye kpukpru mme obio ererimbot ye ubọñ mmọ. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Ndien ọdọhọ Enye ete, kpukpru emi ke ami ndinọ fi, edieke Afo ọtọñọde edọñ onyuñ atuak ibuot ọnọ mi.<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Do ke Jisọs ọkọdọhọ enye ete, “Daha Mi ke iso Setan! Koro ema ewet ete, afo enyene ndituak ibuot nnọ Ọbọñ Abasi fo, ñnyuñ nnam ñkpọ nnọ Enye ikpọñikpọñ.”<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Ekem Setan ama adaha ọkpọñ Enye; ndien mme enjel ema edise ñkpọ ebaña Enye.<verse eid="MAT 4:11" /></para>
  <para style="s1">Jisọs Ọtọñọ Ndikwọrọ Ikọ</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Ndien ke ini Jisọs okokopde ete ke ema ekọbi Jọn, Enye ama ebe aka Kalili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Ke Enye ama ọkọkpọñ Nasaret, Enye ama okoduñ ke Kapanọm, emi okodude ke mben ñkpọdiọhọ mmọñ emi okodude ke ñkanñkuk Sebulọn ye Naftali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Emi eketibe man se Asiak Uduak Abasi Aisaya eketiñde osu,<verse eid="MAT 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 4:15" />“Isọñ Sebulọn ye eke Naftali emi edade ke usuñ emi esañade eka akwa akpa, onyuñ adade ke edem eken, Kalili mme mmọ emi midighe mme Ju!<verse eid="MAT 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 4:16" />Mbio oro etiede ke ekim, ekut akwa uñwana; ndien mmọ eken emi eduọñọde ke isọñ mfut ñkpa, uñwana asiaha ọnọ mmọ.”<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Ọtọñọde ke ini oro; Jisọs ama ọtọñọ ndikwọrọ etop Esie ete, “Mbufo ekabade esit koro Obio Ubọñ Abasi ekpere.”<verse eid="MAT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Nte Jisọs akasañade ke mben ñkpọdiọhọ mmọñ Kalili. Enye ama okut nditọ eka iba, emi ekedide mme ọkọiyak, Saimọn (emi ekekotde Pita) ye eyen eka esie Andru nte ekọde iyak ke ñkpọdiọhọ mmọñ oro.<verse eid="MAT 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 4:19" />Ndien Enye ama ọdọhọ mmọ ete, “Edi etiene Mi, ndien Ami ñyekpep mbufo nte ekọde owo.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Ndien ke ndo ndo oro mmọ ema ekpọñ mme iyire mmọ enyuñ etiene Enye.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Nte Enye asañade aka iso, Enye ama okut nditọ eka iba efen, Jems eyen Sebidi, ye Jọn eyeneka esie, ke ubom ye ete mmọ Sebidi, ke ediọñ iyire mmọ, ndien enye okot mmọ, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />inikiet inikiet mmọ ema ekpọñ ubom, ekpọñ ete mmọ, enyuñ etiene Jisọs.<verse eid="MAT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Jisọs ama asaña ke ofuri Kalili ekpep ñkpọ ke mme itie ukpepñkpọ mmọ, onyuñ ọkwọrọ Eti Mbuk Obio Ubọñ Abasi, onyuñ ọkọk kpukpru oruk udọñọ ye kpukpru oruk ubiak ke otu mbio obio oro. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Ntre ke etop Esie akasuana ke ofuri Siria, ndien mmọ ema eda kpukpru mbon udọñọ mmọ, emi mme nsio nsio udọñọ ye ndutuhọ ekesimde; ye mmọ emi ekenyuñ enyenede mme ndedehe spirit ke idem, ye mmọ emi ekeduọde mbukpi ye akpaubeñ; ndien Enye ọkọk mmọ. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Ndien ata ediwak otu owo ema eto ke mme ikpọ obio duop, ye Jerusalem, Judia, ye mme obio ke edem inyañ Jọdan eken etiene Enye.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">Ukwọrọ Ikọ Ke Enyọñ Obot</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Ke ini Jisọs okokutde akwa otu owo, Enye ama ọdọk ke enyọñ obot onyuñ ọsuhọde etetie. Mme mbet Esie ema ekuk Enye esin, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />ndien Enye ama ọtọñọ ndikpep mmọ ñkpọ, ntem:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“Ọfọfọn ọnọ mmọ emi edide ubuene ke spirit,</para>
  <para style="q2" vid="MAT 5:3">koro Obio Ubọñ Abasi enyenede mmọ;<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Ọfọfọn ọnọ mmọ emi efuhọde,</para>
  <para style="q2" vid="MAT 5:4">koro edidọñde mmọ esit,<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Ọfọfọn ọnọ mmọ emi enyenede ifure ifure ido,</para>
  <para style="q2" vid="MAT 5:5">koro mmọ edidade isọñ inyene;<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Ọfọfọn ọnọ mmọ emi ekopde biọñ ye nsatitọñ kabaña edinen ido,</para>
  <para style="q2" vid="MAT 5:6">koro edinamde mmọ eyuhọ;<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Ọfọfọn ọnọ mmọ emi etuade owo mbọm,</para>
  <para style="q2" vid="MAT 5:7">koro eyetua mmọ mbọm,<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Ọfọfọn ọnọ mmọ emi esit mmọ asanade,</para>
  <para style="q2" vid="MAT 5:8">koro mmọ eyekut Abasi;<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Ọfọfọn ọnọ mme anam emem,</para>
  <para style="q2" vid="MAT 5:9">koro eyekot mmọ nditọ Abasi;<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Ọfọfọn ọnọ mmọ oro ekọbọde mmọ ke ntak eti edu uwem,</para>
  <para style="q2" vid="MAT 5:10">koro Obio Ubọñ Abasi enyenede mmọ.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Ọfọfọn ọnọ mbufo, ke ini mme owo esabarede, enyuñ ekọbọde mbufo, enyuñ etiñ mme nsionsio ndiọi ikọ ebaña mbufo ke nsu ke ntak Mi. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Enem esit, enyuñ edara eti eti, koro utib mbufo okponde ke enyọñ, koro kpa ntem ke mme owo ekekọbọ mme Asiak Uduak Abasi emi ekebemde mbufo iso.<verse eid="MAT 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Mbufo edi inuñ enọ ererimbot. Edi edieke inuñ minyeneke aba inem, edida nso inam enye enyene inem? Enye ifọnke ke baba ñkpọ kiet, ke ebede nditop enye nduọk, ndien mme owo edighi ke ukot. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />Mbufo edi uñwana ererimbot. Obio emi ebọpde ke enyọñ obot, ikemeke ndidibe. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Owo inyuñ idomoke utueneikañ ida abañ ifuk; edi edori enye ke enyọñ ñkpọ udori utueneikañ ke ebiet emi enye ayamade ọnọ kpukpru owo ke ufọk. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Eyak uñwana mbufo ayama ke iso mme owo man mmọ ekut nti utom mbufo, enyuñ enọ Ete mbufo emi odude ke enyọñ ubọñ.<verse eid="MAT 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Ekukere ete ke Ami ndi ndibiat ibet ye mme Asiak Uduak Abasi. Ami ñkedighe ndibabiat edi ñkedi ndinam kpukpru esu. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Koro ke akpanikọ ke ndọhọ mbufo nte, tutu enyọñ ye isọñ ebe efep, baba ntọi kiet mme ekpri nde kiet ke ibet idibehe ifep, tutu kpukpru mmọ esu. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Ke ntre, edieke owo ekededi abiatde andikpri ñkan ke otu mme ibet onyuñ ekpepde mbon efen ndinam ntre, enye eyedi andikpri ñkan ke Obio Ubọñ Abasi. Edi ama edi mmọ emi ekpepde ndien enyuñ enam se ibet etemede, mmọ eyekpon ke Obio Ubọñ Abasi.<verse eid="MAT 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 5:20" />Edi Ami nduri mbufo utọñ nte, ibọhọke nti ido mbufo ekpon ekan eke mme Farisi ye eke mme ada ibuot ukara mme Ju, mbufo idikemeke ke baba usuñ ndomokiet ndiduk ke Obio Ubọñ Abasi.<verse eid="MAT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Mbufo ema ekop ete ke ema enọ mbio eyo oko uyo, ete, ‘Kuwot owo, ndien owo ekededi emi owotde owo eyeda ke ikpe.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Edi Ami ndọhọ mbufo nte, owo ekededi emi ayatde esit ye eyen ete esie enyene ndida ke ikpe, ndien owo ekededi emi edidọhọde eyen ete esie ete, Raka (oburobut owo), ekeme ndida enye ñka akwa esop, ndien owo ekededi emi ọdọhọde eyen ete esie ete, ‘Afo ndisime,’ eyeka ikañ itie ndutuhọ.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />Ke ntem, edieke afo adade enọ fo edi ke itie uwa, ndien afo eti do ete ke eyen ete fo enyene ikọ ye afo, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />kpọñ enọ fo do ke itie uwa, ndien ka kebem iso nam emem ye eyen ete fo, ndien afo edinọ enọ fo. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />Wara nam emem ye owo utọk fo kadaña emi mbufo edude ke usuñ esop man enye ediyak fi ọnọ ebiere ikpe, ndien ebiere ikpe ayak fi ọnọ isuñutom esop, ndien esin fi ke ufọk ñkpọkọbi. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Kakpan ke ndọhọ fi nte, afo uduwọrọke do, tutu afo osio kpukpru okuk ama.<verse eid="MAT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Mbufo ema ekop nte ekedọhọde ete, ‘Kusin efibe.’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Edi Ami ndọhọ mbufo nte owo eke esede ñwan ke enyin use, enye akam esesin efibe ke esit esie ye enye. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Ke ntre, edieke enyin fo, ekpedi enyin ubọk nnasia fo, anam fi anam idiọkñkpọ, tibi enye sio duọk, koro ọfọn ubak idem fo kiet nditak ñkan ndimen fi ofuri ofuri ntop nsin ke ikañ ndutuhọ (hell). <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Ñko edieke ubọk fo, ekpedi ubọk nnasia fo esin fi anam idiọkñkpọ, sibe enye duọk, koro ọfọn nte ubak idem fo kiet atakde, akan ndisin ofuri idem fo ke ikañ itie ndutuhọ.<verse eid="MAT 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />Mbet Moses ọdọhọ ete, edieke owo oyomde ndisio ñwan esie ndọ, yak enye ọnọ enye ñwed usio ndọ. <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Edi Ami ndọhọ mbufo nte, edieke owo osiode ñwan esie ndọ ke mitoho ke ntak efibe, enye anam ñwan oro edi esin efibe, ndien owo ekededi emi ọdọde ñwan emi esiode ndọ, enye ñko esin efibe.<verse eid="MAT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Mbufo ema ekop ñko nte ekedọhọde mbio eyo oko ete, ekubiat uyo eñwọñọ edi enam enọ Jihofa se ekeñwọñọde. <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Edi Ami ndọhọ mbufo nte, ekuñwọñọ baba ñkpọ kiet, edide nditomo ikpa enyọñ, koro oro edide ebiet ebekpo Ubọñ Abasi; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />mme edide ikpa isọñ, koro emi edide udoriukot Esie, mme edide Jerusalem, koro emi edide akwa obio akwa Edidem. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Kunyuñ utomo ibuot fo, koro afo mukemeke ndinam idet ibuot fo kiet akabade edi afia mme obubit. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Edi, eyak ikọ mbufo edi Ih mme Ih Ih koro se ibede oro oto andidiọk.<verse eid="MAT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Mbufo ema ekop ekedọhọde ete, Enyin ke enyin, ye edet ke edet. <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Edi Ami ndọhọ mbufo nte, ekuñwana ye anam idiọk. Edi owo ekededi ama amia fi ke mfuk nnasia, wọñọde mfuk eken nọ enye ñko: <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Ndien edieke owo oyomde ndikot fi ikpe mbọ ọfọñ eñyọñ idem fo, yak akwa ewura fo nọ enye ñko. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Ndien owo ekededi emi edinyikde fi asaña itiat kiet ye enye, saña iba ye enye. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Nọ enyemi ebeñede fi, kuñyuñ usin ndibuọt enyemi oyomde ebuọt oto fi.<verse eid="MAT 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Mbufo ema ekop ekedọhọde ete, ema mbọhọiduñ mbufo, enyuñ esua owo usua mbufo. <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Edi Ami ndọhọ mbufo nte, ema mme asua mbufo, enyuñ ebọñ akam ebaña mmọ emi ekọbọde mbufo, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />man mbufo edi nditọ emi Ete mbufo odude ke enyọñ. Enye anam utin Esie asiaha ọnọ ndiọi owo ye nti owo, onyuñ anam edim edep ọnọ ndinen owo ye mmọ emi minenke. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Koro edieke mbufo emade kpa mmọ emi emade mbufo, nso utib ke mbufo enyene? Nte idem mme anam idiọk inamke kpasuk ntre? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Ndien edieke mbufo ekọmde nditọ ete mbufo ikpọñ ikpọñ mbufo enam nso ekan mme mmọ efen? Nte idem mme mmọ emi midighe Ju inamke kpasuk ntre? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Mbufo ndien enyene ndifọn mma, kpa nte Ete mbufo ke enyọñ ọfọnde ama.”<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Ekpeme! Ekunam edinen ido mbufo ke iso mme owo man mmọ ekut. Ke enamde ntre, mbufo idinyeneke utib ito Ete mbufo emi odude ke enyọñ. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Mmọdo ke ini afo ọnọde mme ubuene ñkpọ, kutaña ase nte mme mbon mbubik enamde ke mme ebiet ntuak ibuot mme Ju, ye ke mme efak, man mme owo etoro mmimọ. Ke akpanikọ ke ndọhọ mbufo, nte ke mmọ ebebọ utib mmọ. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Edi ke ini efọnde ido ye owo, enam edi ke ndibe, ekuyak ubọk ufien mbufo ọfiọk se nnasia anamde, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />man mfọnido mbufo edi ke ndibe; ndien Ete mbufo emi okutde ke ndibe eyenọ mbufo utib.<verse eid="MAT 6:4" /></para>
  <para style="s1">Akam Ye Utreudia</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Ndien ke ini mbufo ebọñde akam, ekutie nte mme mbubik, koro mmọ emade ndida ke mme itie ntuak ibuot mme Ju (Sinakọk), ye ke mme ituñ efak mbọñ akam, man mme owo ekut mmọ. Ke akpanikọ ke ndọhọ mbufo nte, mmọ ebebọ utib mmọ. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Edi afo, kini afo ọbọñde akam, duk ke ubet fo nyuñ beri usuñ, bọñ akam nọ Ete fo emi odude ke ndibe, ndien Ete fo emi okutde ke ndibe, eyenọ fi utib.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />Ndien ke ebọñde akam ekutiñ mme uwak ikpuikpu ikọ nte mme anam idiọk enamde, koro mmọ ekerede ete ke edikop akam mmimọ ito ke uwak ikọ mmọ. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Mmọdo ekubiet mmọ, koro Ete mbufo ọfọfiọk mme ñkpọ emi ananade mbufo mbemiso mbufo ebebeñe Enye.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />“Ebọñ akam ndien ntem ete, Ete ñnyin emi odude ke enyọñ, yak ikpono Enyiñ Fo: <verse eid="MAT 6:9" /><verse number="10" style="v" sid="MAT 6:10" />Yak Obio Ubọñ Fo edi, yak inam uduak Fo ke isọñ, nte emi enamde ke enyọñ; <verse eid="MAT 6:10" /><verse number="11" style="v" sid="MAT 6:11" />Nọ ñnyin udia emi ekemde ñnyin ke usen mfin. <verse eid="MAT 6:11" /><verse number="12" style="v" sid="MAT 6:12" />Ñnyuñ dahado nọ ñnyin ke kpukpru mme idiọkñkpọ ñnyin kpa nte emi ñnyin idahadedo inọ mmọ emi enamde ñnyin idiọkñkpọ; <verse eid="MAT 6:12" /><verse number="13" style="v" sid="MAT 6:13" />Kuda ñnyin usin ke idomo, edi sio ñnyin ke ubọk andidiọk, koro ubọñ ye odudu, ye ukpono enyenede Fi, ke nsinsi nsinsi.” <verse eid="MAT 6:13" /><verse number="14" style="v" sid="MAT 6:14" />Edieke mbufo edaharedo enọ mmọ emi eduede mbufo, Ete mbufo ke enyọñ eyenyuñ adahado ọnọ mbufo ñko. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Edi mbufo mifenke inọ mme owo ke ndudue mmọ, Ete mbufo idinyuñ ifenke inọ mbufo.<verse eid="MAT 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Ndien ke ini mbufo etrede udia, ekutie mfuhọ mfuhọ nte mme mbio mbubik. Mmọ ebiat iso mmọ, man mme owo ekut ete ke mmọ etre udia. Ke akpanikọ ke ndọhọ mbufo nte, mmọ ebebọ utib mmọ. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Edi ke ini mbufo etrede udia, eyet iso mbufo enyuñ esari idet mbufo, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />man mmọ efen edidiọñọ ete ke mbufo etre udia, ke mibọhọke Ete mbufo emi ọfiọkde kpukpru ndibe ñkpọ. Ndien Enye eyenọ mbufo utib.<verse eid="MAT 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Ekubon mme ñkpọuto enọ idem mbufo ke isọñ, ke ebiet emi ñkakat ye ñkarafañ edibiatde, ndien mme inọ ñko ebuñ eduk enyuñ eyip. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Edi enim inyene enọ idem mbufo ke enyọñ, ebiet emi ñkakat ye ñkarafañ miditaha, mme inọ ñko midibuñke iduk iyip. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Koro ebiet emi inyene mbufo odude, do ñko ke esit mbufo enyene ndidu.<verse eid="MAT 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />Enyin edi utueneikañ ikpọkidem, mmọdo edieke enyin fo ọfọnde, ofuri ikpọkidem fo eyeyọhọ ye uñwana. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Edi, edieke enyin fo okimde ke ntak idiọk ekikere esit ye udọñitọñ ñkpọ ererimbot emi, afo etim odu ke ata ọkpọsọñ ekim ke spirit. Edieke uñwana emi odude fi ke idem odukde ekim, ekim oro okpon didie!<verse eid="MAT 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />Baba owo kiet ikemeke ndinam utom nnọ eteufọk iba, koro enye eyesua kiet, onyuñ ama enye eken; enye eyesuk ibuot ọnọ kiet ndien ofumi enye eken.<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Mmọdo Ami ndọhọ mbufo nte, ekuyak ekikere etimede mbufo ke ntak uwem mbufo, ke se mbufo edidiade, mme se mbufo ediñwọñde, mme ke ntak ikpọkidem mbufo, se mbufo edisinede. Nte uwem ifọnke ikan udia, ikpọkidem ñko ikanke edisine ñkpọ? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Ese mme inuen enyọñ; mmọ itọhọtọ inyuñ idọkkedọk, inyuñ itañke ibon ke ubet ubon udia, edi Ete mbufo emi odude ke enyọñ kọnọnọ mmọ udia. Nte mbufo isọñke urua ikan mme inuen enyọñ emi? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Anie ke otu mbufo ke editimede esit ekeme ndidian usen kiet ke mme isua uwem esie?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />“Ndien nso idi ntak emi mbufo ekerede ebaña ọfọñidem? Ese nte mme ekpoñidim ke iñwañ ekọride, mmọ ibọhọ ufen ndifiak ndidi. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Edi Ami ndọhọ mbufo nte, idem Sọlọmọn ke ofuri ubọñ esie ikesineke se iyede nte kiet ke otu mme ekpoñidim emi. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Edieke Abasi esinede mbiet iñwañ edisine ñkpọ ntre, mbiet emi odude mfin, ndien ñkpọñ emen esin ke usañ uyo, nte Enye idisineke mbufo se ikande oro, O mbufo mbon ekpri mbuọtidem?<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />Ndien ekuyak esit etimede mbufo ebup ete, ‘Nso ke ñnyin ididia?’ mme ‘Nso ke ñnyin idiñwọñ?’ mme ‘Nso ke ñnyin idisine?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Koro mme mmọ emi midighe Ju efeñede mfeñe kabaña mme ñkpọ emi, edi Ete mbufo ke enyọñ ọfiọk ete ke mbufo emenana kpukpru mme ñkpọ emi. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Edi mbufo ebem iso eyom Obio Ubọñ Abasi ye edinen ido Esie, ndien eyedian kpukpru mme ñkpọ emi enọ mbufo.<verse eid="MAT 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 6:34" />Ntem ekuyak ekikere etimede mbufo abaña ñkpọñ, koro ñkpọñ eyekere abaña idem esie. Mme mfina eke usen ekem ye usen.”<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Ekusioño owo ndo, man edisioño mbufo ndo. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Koro nte mbufo esioñode owo ndo, kpa ntre ke edisioño mbufo ndo. Ndien udomo emi mbufo edade edomo, ke edida idomo inọ mbufo. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Ntak emi afo esede ekpri mbio emi odude ke enyin eyen ete fo, edi ukereke ibio eto emi odude ke enyin fo? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Didie ke afo edidọhọ eyen ete fo ete, yak nsio ekpri mbio ke enyin fo, ndien sese, ibio eto mmọdo ke enyin fo? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Afo mbubik, bem iso sio ibio eto oro ke enyin fo fep, ndien afo eyetim okut usuñ nte adade osio ekpri mbio ke enyin eyen ete fo efep.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />Ekumen edisana ñkpọ enọ ebua, ekunyuñ eduọñọ ñkpọuto mbufo ke iso mme edi, man mmọ edidighi ke ukot mmọ, enyuñ ewọñọrede ebine mbufo.<verse eid="MAT 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Ebeñe, ndien eyenọ mbufo, eyom, ndien mbufo eyekut, etuak ndien eyeberede usuñ enọ mbufo; <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />koro owo kiet kiet emi ebeñede, eyebọ; ndien owo ekededi emi oyomde, eyekut; ndien eyeberede usuñ enọ enyemi atuakde. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Anie ke otu mbufo edinọ eyen esie itiat ke ini enye ebeñede uyo? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Mme ndinọ enye urukikọt ke ini enye ebeñede iyak? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Edieke mbufo emi ediọide efiọkde ndinọ nditọ mbufo nti enọ, adaña didie ke Ete mbufo emi odude ke enyọñ edinọ mmọ emi ebeñede Enye nti ñkpọ ikan oro!<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />Ke ntre se ededi emi mbufo eyomde owo anam ye mbufo, enam kpa ntre ye mmọ, koro emi edide se ibet ye mme prọfet Abasi ekpepde.<verse eid="MAT 7:12" /></para>
  <para style="s1">Usuñ Obio Ubọñ Abasi</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Ebe ke mfafaha usuñ eduk, koro usuñ emi adade owo aka nsobo atara, ọkpọusuñ esie onyuñ añwaña, mme mmọ emi edukde ebe ke esit ewak. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Edi usuñ emi adade owo osim Obio Ubọñ Abasi afafaha, ọkpọusuñ esie onyuñ afaha ndien mmọ emi ekutde enye iwakke.<verse eid="MAT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Ekpeme mme andikpep emi ekpepde mme nsu nsu ukpepñkpọ, emi efọrọde ikpa erọñ, edi etiene mbufo. Edi ke esit mmọ, mmọ edi ekpe ikọt. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Mbufo eyeda mfri mmọ ediọñọ mmọ. Nte owo ekeme nditet sokoro nto kpukpru eto ñkukim? Mme udari ke mbaraekpe? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Kpa ntre ke kpukpru nti eto eñwum nti mfri, edi ndiọi eto eñwum ndiọi mfri. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Eti eto ikemeke ndiñwum idiọk mfri, idiọk eto inyuñ ikemeke ndiñwum eti mfri. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Eto ekededi emi miñwumke nti mfri, eyesibe enye enyuñ emen esin ke ikañ. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Ke ntre mbufo eyeda mfri eto ediọñọ eto.<verse eid="MAT 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />Idighe kpukpru mmọ emi ekotde Mi ete, Ọbọñ, Ọbọñ, ediduk ke Obio Ubọñ Abasi; edi enyemi akade iso ndinam uyo Ete Mi emi odude ke enyọñ. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Ediwak owo eyedọhọ Mi ke usen oro, ete, Ọbọñ, Ọbọñ, nte ñnyin ikadaha enyiñ Fo isiak uduak Fo, inyuñ ida enyiñ Fo ibin mme dimọn, inyuñ ida enyiñ Fo inam mme ediwak utibe ñkpọ? <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Ndien Ami ñyedọhọ mmọ iso ye iso nte, akananam Ami ndiọñọke mbufo, edaha Mi ke iso, mbufo mme oburobut owo.<verse eid="MAT 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Ntem owo kiet ekededi emi okopde ikọ Mi emi, onyuñ anamde mmọ, ñyedomo enye ye enyene ibuot owo emi ọbọpde ufọk esie ke enyọñ akamba itiat. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Edim edep, ukwọ onyuñ edi, ofum onyuñ abara, onyuñ ebere ke ufọk oro, ndien enye iduọhọ koro ebọpde enye ke enyọñ akamba itiat.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />Edi owo kiet ekededi emi okopde ikọ Mi emi, ndien inamke, eyedomo enye ye ndisime owo emi ọbọpde ufọk esie ke enyọñ utatan. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Edim edep, mmọñ ukwọ onyuñ edi, ofum onyuñ abara ebere ufọk oro ndien enye ọduọ, ñwure esie onyuñ okpon. <verse eid="MAT 7:27" /><verse number="28" style="v" sid="MAT 7:28" />Edikem ke ini Jisọs ama eketiñ mme ikọ emi ama, idem ama akpa mme otu owo oro ke abaña mme ukpepñkpọ Esie. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Koro Enye ekekpepde mmọ ñkpọ ye uko, ọkpuhọde ye mme andikpep mme Ju.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">Jisọs Ọkọk Nsio Nsio Udọñọ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Ke ini emi Enye ọkọsuhọrede ke obot, akwa otu owo ema etiene Enye.<verse eid="MAT 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 8:2" />Ndien sese owo akpamfia kiet asaña edituak ibuot ọnọ Enye, onyuñ ọdọhọ Enye ete, “Ọbọñ, edieke Afo enyimede, emekeme ndinam mi nsana.”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Ndien Jisọs anyanade ubọk Esie otuk enye, ete, “Ami mmenyime, Sana!” Ke ndo ndo oro, udọñọ akpamfia ama okure enye.<verse eid="MAT 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 8:4" />Ndien Jisọs ọdọhọ ete, “kutiñ unọ owo ndomokiet, edi nyọñ ka kowut oku idem fo, nyuñ wa uwa enọ emi Moses eketemede, man edi ñkpọ ntiense ọnọ mme owo.”<verse eid="MAT 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Edi kadaña emi Enye okodukde Kapanọm, Etubom udim ekọñ kiet ama ebine Enye, onyuñ ekekpe ye Enye ete, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“Ọbọñ, eyen ufọk mi ke ufọk ana ye udọñọ akpaubeñ, onyuñ odu ke ata ndutuhọ.”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Jisọs ama ọdọhọ enye ete, “Ami ndi ndinam enye okop nsọñidem?”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Ndien Etubom ekọñ oro ama ọbọrọ Enye, ete, “Ọbọñ, ami ndotke nte Afo okpodukde ke idak ọkọm mi; edi kam tiñ ikọ, ndien idem eyesọñ eyen ufọk mi. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Koro ami ñko ññyuñ ndude ke ukara, mmonyuñ ñnyene mme mbon ekọñ efen ke idak mi, ndien ndọhọ owo enye emi nte, ‘Ka ko,’ ndien enye aka, ñnyuñ ndọhọ efen, nte, ‘Di,’ ndien enye edi, ñnyuñ ndọhọ ofin mi, nte, ‘Nam emi,’ ndien enye anam.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Ndien ke ini Jisọs okokopde ikọ emi idem ama akpa Enye, ndien Enye ọdọhọ mme mmọ emi eketienede Enye ete, “Ke akpanikọ ke ndọhọ mbufo, nte, akananam Ami ñkwe mbuọtidem emi okponde ntre, kpa ye ke idem Isrel. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Ndien Ami ndọhọ mbufo nte ke ediwak owo eyeto ke edem usiahautin, ye ke edem usoputin, editie ye Ebraham ye Aisik ye Jekọb ke Obio Ubọñ Abasi. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Edi ediwak ke otu nditọ Isrel emi ekenimde Obio Ubọñ emi enọ ididukke. Eyeduọk mmọ ke añwa ke ekim, ke ebiet eyet ye ntaedet edidude.”<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Ndien Jisọs ama ọdọhọ Etubom ekọñ oro ete, “Nyọñ ufọk fo, koro nte afo onimde ke akpanikọ ke esit fo, oyosu ntre ọnọ fi.” Ndien eyen ufọk esie onyuñ okop nsọñidem kpa ke ini oro.<verse eid="MAT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Edi kadaña emi Jisọs okosimde ufọk Pita, eka añwan Pita akana ke ñkpana, koro ọkpọsọñ ufiopidem okomumde enye. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Ndien Jisọs ama otuk enye ke ubọk, ufiop idem onyuñ ọkpọñ enye, ndien enye ama adaha ke enyọñ onyuñ anam ñkpọ ọnọ Enye.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Ekedikem ini mbubreyo, ema eda ediwak owo emi mme nsio nsio ndiọi spirit ekemumde ebine Enye. Enye onyuñ ada ikọ inua Esie ebin mme dimọn oro; onyuñ anam kpukpru mbon udọñọ oro ekop nsọñidem. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Man osu nte Asiak Uduak Abasi Aisaya ọkọdọhọde ete, “Enye ke idem Esie ọbọ mme mmemidem ñnyin, onyuñ obiom mme udọñọ ñnyin.”<verse eid="MAT 8:17" /></para>
  <para style="s1">Ekọmurua Nditiene Jisọs</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Ke ini emi Jisọs okutde nte otu owo ewakde, Enye ama ọdọhọ mbet Esie ete yak mmọ ebeñe idem man mmimọ ibe ika edem inyañ eken.<verse eid="MAT 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 8:19" />Kpa ke ndo ndo oro, owo kiet ke otu mme ọfiọk ibet mme Ju ọdọhọ Enye ete, “Andikpep, ami ñyetiene Fi ñka ebiet eke Afo akaka.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Jisọs ama ọbọrọ enye ete, “Mme ebua ikọt enyene ndudu; mme inuen enyọñ enyuñ enyene mme efọk, edi Eyen owo inyeneke ebiet emi Enye ebride ibuot Esie.”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Owo efen ke otu mme nsaña Esie ama ọdọhọ Enye ete, “Ọbọñ, yak mi ñka kaña ñkobuk ete mi.”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Edi Jisọs ama ọbọrọ enye ete, “Tiene Mi, yak mme akpaña ñkpa ebuk mme akpaña ñkpa mmọ.”<verse eid="MAT 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Jisọs ama oduk ubom ye mme mbet Esie. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Ndien sese, akwa oyobio otibe, mbufit akpa onyuñ ofuk ubom, edi Jisọs ke ede idap.<verse eid="MAT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 8:25" />Do mme mbet esie ema ekedemere Enye, enyuñ edọhọ Enye, ete, “Ọbọñ, nyaña ñnyin koro ñnyin imọñọ isip!”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Enye ama ọdọhọ mmọ ete, “Nsinam mbufo efehede ndik, mbufo mbon ñkpri mbuọtidem?” Ndien Enye ama adahada, onyuñ asua ọnọ ofum ye mbufit akpa; ndien inyañ odop ana suñ-ñ. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Idem ama akpa mme mbet emi, ndien mmọ ema edọhọ ete, “Nso utọ owo idi emi? Kpa idem ofum ye mbufit inyañ esuk ibuot enọ uyo Esie!”<verse eid="MAT 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Edi ke ini Jisọs osimde edem inyañ eken ke idut ke Kadarin, owo iba emi ekeyọhọde ye ndiọi spirit (dimọn) ema esaña eto efak mme udi ekesobo ye Enye. Mmọ emi ema enyene ndik eti eti, nte baba owo ndomokiet mikekemeke ndisaña ke usuñ oro mbe.<verse eid="MAT 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 8:29" />Mmọ ema etuak eda enyuñ efiori ete, “Nso ke ñnyin inyene ndinam ye Afo, Afo Eyen Abasi? Nte Afo edi ndituhọde ñnyin mbemiso ini ñnyin edikem?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Ke nsañade nda esisit, otu edi ema edu, ke edia udia. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Ndien mme ndiọi spirit oro ema ekpe Jisọs ubọk ete, “Edieke Afo edibinde ñnyin isioño, nam ñnyin ika ikoduk ke otu mme edi.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Jisọs ama ọdọhọ mmọ ete, “Eka ndien!” Ndien mmọ ema ewọñọ ekeduk mme edi ke idem, ndien ofuri otu edi ema efeñe esuhọde ke ebedeñ ekeduọñọ edọñọ ke ñkpọdiọhọ mmọñ enyuñ ekpaña. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Edi mme ọbọk edi ema efeñe eka obio eketiñ ofuri se iketibede ye mmọ ye se iketibede ye mme mmọ oro ndiọi spirit ekeduñọde mmọ ke idem. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Ke ntak emi ofuri obio ema ewọñọ edi edisobo ye Jisọs, enyuñ ekpe ye Enye ete yak Enye ọkpọñ ñkanñkuk obio mmimọ.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">Utom Mi Mi Ke Isọñ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Jisọs ama oduk ubom onyuñ ebe inyañ ọnyọñ aka ke obio emana Esie. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Mme owo ema emen owo emi ọkọdọñọde akpaubeñ, emi ekebiomde ke ñkpana ebine Enye. Ndien kini Jisọs okutde mbuọtidem mmọ, Enye ama ọdọhọ ọdọñọ akpaubeñ oro ete, “Eyen Mi dara, koro emefen mme idiọkñkpọ fo.”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Ke ntak emi, ndusuk mme andikpep ibet mme Ju ema etiñ ke otu mmọ ete, “Owo emi ke asabade Abasi.”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Jisọs ama ọdiọñọ ekikere mmọ, ndien Enye ama ọdọhọ mmọ, ete, “Nso inam mbufo ekerede mme ndiọi ekikere ke esit mbufo? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Ewe emem akan, ndidọhọ nte, ‘Emefen mme idiọkñkpọ fo,’ mme ndidọhọ nte, ‘Daha ke enyọñ saña?’ <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Edi man mbufo efiọk ete, ke Eyen owo enyene odudu ke isọñ ndifen mme idiọkñkpọ.” Enye ama ọdọhọ owo oro ọdọñọde akpaubeñ ete, “Daha ke enyọñ nyuñ men ñkpọ nna fo nyọñ ufọk.”<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Ndien owo oro ama adaha ke enyọñ ọnyọñ ufọk esie.<verse eid="MAT 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 9:8" />Ndik ama onyuñ omum kpukpru mmọ ke adañaemi mmọ ekekutde se ikitibede emi, ndien mmọ enyuñ etoro Abasi ke ndinọ owo odudu eke etiede ntre.<verse eid="MAT 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Nte Jisọs akasañade ebe, Enye ama okut owo emi ekekerede Matiu nte etiede ke itie ubọ taksi, ndien Enye ama ọdọhọ enye ete, “Tiene Mi.” Ndien enye ama adaha ada etiene Enye.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Ke ini emi Jisọs etiede ke itie udia ke esit ufọk, ubak mme ọbọ ataksi, ye mme anam idiọkñkpọ editiene etie ye Jisọs ke okpokoro udia, ye mme mbet Esie nde.<verse eid="MAT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 9:11" />Ke ini emi mme Farisi ekekutde ñkpọ emi, mmọ ema ebup mme mbet Esie, ete, nsinam Andikpep mbufo adiade ñkpọ ye mme ọbọ utib obio ye mme ndiọi owo?<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Ke Jisọs ama okokop emi, Enye ama ọbọrọ ete, “Idighe owo nsọñidem oyom abiaibọk, edi owo udọñọ oyom.” <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Edi mbufo eka ekekpep se mme ikọ emi ewọrọde: Se Ami ñyomde edi mbọm, idighe uwa. Ndien ke akpanikọ Ami ñkedighe ndikot mme mfọnmma owo, edi ñkedi ndikot mme anam idiọkñkpọ.<verse eid="MAT 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Ndien mme mbet Jọn Baptis ema esaña etiene Jisọs enyuñ ebup Enye ete, “Ntaha emi ñnyin ye mme Farisi itrede udia, edi mme mbet fo itreke-e?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Ndien Jisọs ama ọbọrọ mmọ ete, “Nte nditọ ufọk ndọ ekeme ndifuhọ ke adaña ini nte ebendọ odude ye mmọ? Usen eyedi emi edidiañarede ebendọ ikpọñ mmọ, ndien ini oro ke mmọ editre udia.”<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“Owo baba kiet ikimke akani ntaha ọfọñ idian ke obufa ọfọñ, midighe eyenam ọfọñ odo awaha akan nte ekpedide.” <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Kpa nte owo mikemeke ndida akani ekpeme mmin nsin obufa mmin, edieke enamde ntre, ekpeme oro eyebomo; ndien mmin oro onyuñ ọduọhọ, ekpeme ñko onyuñ obomo. Baba, esin obufa mmin ke obufa ekpeme mmin, ndien mmọ mbiba ebighi.<verse eid="MAT 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Nte Enye osuk etiñde mme ikọ emi, sese andikara kiet emi odude ke esop mme Ju, edi, onyuñ ọtọñọ edọñ okpono Enye, onyuñ ọdọhọ ete, “Ekpri Eyen mi añwan osuk akpa idahaemi, edi edieke Afo edide edidori enye ubọk Fo, enye eyetọñọ ntak odu uwem.”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Ndien Jisọs ama adaha ke enyọñ etiene enye ye mme mbet Esie. <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />Ndien sese ñwan emi ọkọdọñọde uwọrọ iyip ke ñkpọ nte isua duopeba etiene Enye ke edem ndien otuk mben isọñ ọfọñ idem Esie, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />koro enye ekekerede ke esit esie ete, mma ñkam ntotuk mben ọfọñidem Esie, ami ñyekop nsọñidem.<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Ndien Jisọs ama ọwọñọrede okut enye onyuñ ọdọhọ enye ete, “Eyen Mi añwan kpukpru ñkpọ ọfọn ama, mbuọtidem fo ọkọk fi.” Ndien idem ama ọsọñ ñwan oro ọtọñọde ke ini oro.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Ndien ke ini Jisọs ama ekesim ufọk adaukara emi, Enye ama okut otu owo nte eyomode uyom ye mme efri ban itie ikpo. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Enye ama ọdọhọ mmọ ete, “Ewọñọ, koro ekpri eyen añwan emi ikpahakpa, edi edede.” Edi mmọ ema esak Enye eti eti.<verse eid="MAT 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 9:25" />Ke ema ekenam mme otu owo ewọñọ, Enye ama oduk esit ufọk emi eyen añwan oro akanade okonyuñ emenerede enye ke ubọk esie; ndien eyen añwan oro ama adaha ke enyọñ onyuñ okop nsọñidem. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Ndien etop utibe idiọñọ emi ama asuana akanade kpukpru ñkanñkuk oro.<verse eid="MAT 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Nte Jisọs ọkọwọrọde ọkpọñ ufọk mmọ, owo nnan iba ema etiene Enye, ke efiori ke ọkpọsọñ uyo, ete, “Eyen Defid tua ñnyin mbọm.”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Ndien ke Jisọs ama okosim ufọk, mme nnan iba oro ema eduk etiene Enye ndien Enye ama obup mmọ ete, “Nte mbufo emenim ke akpanikọ nte ke mmekeme ndinam ñkpọ emi?” Mmọ ema ebọrọ ete, “Ọbọñ, ñnyin imenim ke akpanikọ.”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Ndien Enye otuk enyin mmọ onyuñ ọdọhọ ete “Yak osu ọnọ mbufo nte mbuọtidem mbufo edide.”<verse eid="MAT 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 9:30" />Ndien enyin mmọ ema etara. Jisọs ama oduri mmọ utọñ ete, “Ekpeme, ekuyak owo ndomokiet ọfiọk abaña ñkpọ emi.” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Edi mmọ ewọñọ ekesuan etop Esie ke ofuri ñkanñkuk oro.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Nte mmọ ekewọñọde, sese ema eda owo imum emi mme ndiọi ekpo eketuhọrede ebine Jisọs. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Ndien ke Jisọs ama ekebin mme ndiọi ekpo emi osioño enye ke idem, owo imum emi ama etiñ ikọ, ndien idem ama akpa kpukpru owo. Ndien mmọ ema edọhọ ete, “Akananam ñnyin ikwe oruk utibe ñkpọ ntem ke Isrel.”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Edi mme Farisi ema edọhọ ete, “Edi ke odudu ọbọñ mme ndiọiñkpọ ke Enye ada ebin mme ndiọi spirit osioño.”<verse eid="MAT 9:34" /></para>
  <para style="s1">Eyom Enyuñ Ekot Mme Anam Utom</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Jisọs ama asaña akanade kpukpru ikpọ obio ye mme ñkpri obio iñwañ emi edude ke edem oro, ekpep ñkpọ ke mme itie ukpepñkpọ mme Ju onyuñ ọkwọrọ Eti Mbuk Obio Ubọñ Abasi, onyuñ ọkọk kpukpru oruk udọñọ ye mbiakidem ke otu mmọ, <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Ndien ke Enye ama okokut mme otu owo, esit Esie ọyọhọ ye mbọm kabaña mmọ, koro mmọ ekebọde ufen, enyuñ enana uñwam nte mme erọñ emi minyeneke andikpeme.<verse eid="MAT 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 9:37" />Ndien Enye ama ọdọhọ mme mbet Esie ete, “Ke akpanikọ idọk okpon, edi mme anam utom iwakke. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Ebọñ akam ebeñe Ọbọñ idọk ete yak Enye ọdọñ mbio idọk ke iñwañ Esie, eduk idọk.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">Jisọs Ọdọñ Mbet Esie Duopeba Utom</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Jisọs okot mbet Esie duopeba, onyuñ ọnọ mmọ odudu ndibin mme ndiọi spirit ñnyuñ ñkọk kpukpru oruk udọñọ ye ubiak.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />Enyiñ mme mbet duopeba oro edi emi, akpa, Saimọn, emi ekekotde Pita, ye eyen eka esie Andru; Jems, eyen Sebidi, ye eyen eka esie Jọn; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filip, ye Batolomiu, Tọmọs ye Matiu (ọbọ ataksi) Jems, Alfios ye Tadiọs. <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Saimọn (owo ñka Silọt, akwa ada ukara) ye Judas Iskariọt, enye emi akatapde Jisọs ọnọ ñkpa.<verse eid="MAT 10:4" /></para>
  <para style="s1">Enọ Mme Mbet Ewuhọ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Jisọs ama ọdọñ owo duopeba emi ewọñọ eka ekekwọrọ ikọ ye mme item emi. “Ekuka ke ubon emi midighe eke mme Ju, ekunyuñ eduk obio Sameria ndomokiet. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Edi ekekwọrọ enọ kpukpru owo emi etode ufọk Isrel, mme erọñ Abasi emi esopde. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Eka ekenam mmọ efiọk ete ke Obio Ubọñ Abasi ekpere. <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Ekọk mbon udọñọ, enam akpa ñkpa eset, enam akpamfia asana, enyuñ ebin mme ndiọi spirit esioño. Enọ ke mfọn kpa nte mbufo ekebọde ñko ke mfọn.”<verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />Ekukama kol, mme silfa, mme kpa okuk ke ekpat usin okuk mbufo. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Ekunyuñ ekama ekpat isañ mme ọfọñidem iba, mme ikpaukot, mme esañ, koro ana nte mme mmọ emi mbufo eñwamde enọ mbufo udia, enyuñ ese ñkpọ ebaña mbufo, koro eyen utom odotde ñkpọ eyen utom esie. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />Ini kiet ekededi emi mbufo edukde akamba obio, mme ekpri obio iñwañ, eyom owo emi odotde, enyuñ etie do ke ufọk esie tutu mbufo ekpọñ obio oro. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Ndien ke ini emi mbufo edukde ke ufọk, enọ ekọm. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Ndien edieke ufọk oro odotde, eyak emem mbufo ọsuhọ ke esit, edi edieke ufọk oro midotke, eyak emem mbufo afiak etiene mbufo. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Ndien obio mme ufọk ekededi emi midarake mbufo, ekeñ ntan ikpat mbufo ebon do, ke ini mbufo ewọñọde ke esit. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Ke akpanikọ, ke ndọhọ mbufo nte, ke eyefọn ye Sọdọm ye Komora akan mmọ oro ke usen ikpe.<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“Ami ndọñ mbufo nte erọñ ke ufọt mme ekpe. Ke ntre enyene ifiọk nte urukikọt enyuñ edu ifure ifure uwem nte ibiom. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Edi ekpeme idem mbufo ye mme owo koro mmọ eyemum mbufo enyuñ eda mbufo eka ikpe, enyuñ emia mbufo ke itie ukpono mme Ju. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Ke ntak Mmi, eyeda mbufo ewọrọ ke iso mme mbuot ukara, ye mme ndidem, man etiñ eti mbuk uwọrọ ufin enọ mmọ ye mme mmọ emi midighe Ju nde.<verse eid="MAT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 10:19" />Ke ini emi edimumde mbufo, ekukere ebaña se editiñde ke iso ekpe ikpe mme nte editiñde. Ke ekemini, eyenọ mbufo se editiñde, <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />koro idighe mbufo editiñ ikọ, edi Spirit Ete mbufo ke enyọñ editiñ ikọ Esie ito mbufo.”<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />Eyeneka eyetap eyeneka ọnọ ñkpa; ete eyenyuñ atap eyen esie ọnọ ñkpa; ndien nditọ eyenyuñ etọñọ afanikọñ ye mme ete mmọ enyuñ eda mmọ enọ ñkpa. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Kpukpru owo eyesua mbufo ke ntak Enyiñ Mi. Edi owo ekededi ke otu mbufo emi ediyọde kpukpru ukut emi isim akpatre, eyenyaña enye.<verse eid="MAT 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 10:23" />Kadaña emi ekọbọde mbufo ke obio kiet, efeñe eka obio efen. Koro ke akpanikọ ke ndọhọ mbufo nte, ke mbufo idikanakede mme obio Isrel ima mbemiso Eyen owo edi. <verse eid="MAT 10:23" /><verse number="24" style="v" sid="MAT 10:24" />Eyen ufọk ñwed ikponke ikan andikpep esie, mme eyen ufọk ndikpon ñkan eteufọk esie. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Odot eyen ufọkñwed ndibiet andikpep esie, kpa ntre ñko ye eyen ufọk ndibiet eteufọk esie. Edieke ekotde ibuot ufọk, Belsibọb, nte idikotke ikọt ufọk esie ikan oro? <verse eid="MAT 10:25" /><verse number="26" style="v" sid="MAT 10:26" />“Ntem ekufehe mmọ. Ñkpọ ndomokiet iduhọ emi efukdefuk emi midiyarakede, mme se edipdedip emi midiyarakede.<verse eid="MAT 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 10:27" />Se ntiñde nnọ mbufo ke ekim emen etiñ añwa añwa; se mbufo ekopde ke odu, ekwọrọ ke ọkọm ufọk.<verse eid="MAT 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 10:28" />Ekufehe mmọ emi ekemede ndiwot ikpọkidem mbufo edi ikemeke ndiwot ukpọñ. Edi, ekam efehe Enye emi ekemede ndiwot obukidem ye ukpọñ ke nsinsi ikañ ñkpa. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Nte owo inyamke akadañ Abasi iba ke okpoho okuk kiet? Ndien baba mmọ ndomokiet iduọhọ ke isọñ ke Ete mbufo midiọñọke ibaña. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Edi ama edi mbufo, ema ebat idet ibuot mbufo kpukpru. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Ke ntre, ekufehe ndik koro mbufo emesọñ urua ekan mme akadañ abasi.”<verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“Mmọdo, owo ekededi emi ediyararede añwa añwa nte ke imọ idi okim, Ami ñyenyuñ ñyarade enye ke iso Ete Mi emi odude ke enyọñ. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Edi edieke owo akañde Mi ke iso mme owo, Ami ñyenyuñ ñkañ enye ñko ke iso Ete Mi ko ke enyọñ.”<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“Ekukere ete ke Ami ñkada emem ndi ke isọñ. Baba, ñkadaha emem ndi, edi ñkada ofut ndi.” <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ami ñkedi ndinam</para>
  <para style="q1" vid="MAT 10:35">eyen eren añwana ye ete esie,</para>
  <para style="q2" vid="MAT 10:35">eyen añwan onyuñ añwana ye eka esie,</para>
  <para style="q1" vid="MAT 10:35">ndien ñwan eyen añwana ye eka ebe esie;<verse eid="MAT 10:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36" />ndien mme asua owo edidi kpa mbio esit ufọk esie.<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />“Enyemi amade ete mme eka esie akan Mi idotke ndidi mbet Mi; ndien enyemi amade eyen esie eren mme eyen esie añwan akan Mi idotke ndidi mbet Mi. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Ndien owo emi mimenke krọs esie itiene Mi, idotke ndidi mbet Mi.<verse eid="MAT 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 10:39" />Enyemi oyomde uwem esie eyeduọk enye, ndien enyemi ọduọkde uwem esie ke ntak Mi eyetọñọ ntak okut enye.”<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“Enyemi adarade mbufo, adara Mi; ndien enye emi adarade Mi adara Enyemi ọkọdọñde Mi. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Enye emi adarade Isuñutom Abasi ke ntak emi enye edide Isuñutom Abasi, eyebuana ke utib esie. Ndien owo ekededi emi adarade eti owo koro enye edide eti owo, eyebuana ke utib esie.<verse eid="MAT 10:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 10:42" />Ndien, edieke owo ekededi ọnọde kiet ke otu ñkpri owo emi kọb mbit mbit mmọñ kiet ọñwọñ ke tak emi enye edide mbet Mi, Ami ntiñ akpanikọ nnọ mbufo, enye iditreke ndibọ utib.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s1">Jisọs ye Jọn Babtis</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Ke Jisọs ama okokure ke ndinọ mbet esie duopeba item, Enye ama adaha ọkpọñ ebiet oro, aka ndikpep ñnyuñ ñkwọrọ ikọ Abasi ke mme obio eken ekperede do.<verse eid="MAT 11:1" /></para>
  <para style="s1">Jisọs ọsọñọ Jọn Idem</para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Edi ke ini Jọn Babtis, esinede ke ufọk ñkpọkọbi okop mbuk utom Kraist, enye ama ọdọñ mbet esie, ekebup enye ete: <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />“Tiñ nọ ñnyin mme Afo edi Enye mi ekenyenede ndidi, mme ñnyin idori enyin ke owo efen?” <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Jisọs ama ọbọrọ mmọ ete, “Efiak eka eketiñ enọ Jọn kpukpru mme ñkpọ emi mbufo ekopde enyuñ ekutde: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />mme nnan etọñọ ntak ekut usuñ, ndien mme mbuñọ enyuñ esaña, mme akpamfia esana, ndien mme inan ekop ikọ, ndien emenam mme akpaña ñkpa eset, enyuñ ekwọrọ eti etop enọ nditọ ubuene. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Ndien ọfọfọn ọnọ owo ekededi emi mikwe ñkpọ iduọ ke idem Mi.”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Kadaña emi mbet Jọn enyọñọde, Jisọs ama ọtọñọ nditiñ nnọ ofuri otu owo mbaña Jọn ete, “Mbufo ekeka isọñ utatan ndikut nso? Ñnyanyaña emi ofum enyeñede? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Ekewọñọ eka ndikut nso? Owo emi esinede ndiye ọfọñ? Baba, mme mmọ emi esinede ndiye ọfọñidem eduñọ ke ufọk mbọñ. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Nso ndien ke ekeka ndikut? Asiak Uduak Abasi? Ih, ami ntiñ nnọ mbufo nte ke enye akam okpon akan Asiak Uduak Abasi (Prọfet).” <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Enye edi enyemi ekewetde ñkpọ ebaña ete, “Ami ñyedọñ Isuñutom mi ebem fi iso emi editimde usuñ isañ fo inọ fi.”<verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />Ke akpanikọ ke ndọhọ mbufo nte, ke otu mme mmọ emi iban emande owo baba kiet akananam iduhọ uwem emi okponde akan Jọn Baptis. Edi enye emi ekpride akan ke Obio Ubọñ Abasi okpon akan enye. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Ọtọñọde ke ini Jọn Babtis tutu osim emi, Obio Ubọñ Abasi ke akaka iso ye odudu ndien mbio odudu emum enye ke nsọñubọk. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Koro kpukpru mme Asiak Uduak Abasi ye Ibet, eketiñ ebaña Obio Ubọñ Abasi tutu edisim ini Jọn Babtis. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Ndien edieke mbufo edimade ndinim mme etop mmọ ke akpanikọ, Jọn emi edi Edaiya, emi ekesiande ebaña edidi esie. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Owo emi enyenede utọñ ndikop, yak enye okop.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />“Ami ñkeme ndida nso ndomo ye emana emi? Mmọ ebiet nditọ ọwọñ emi etiede ke añwa urua ekot ñka mmọ.”<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />“ ‘Ñnyin imefri ikwọ inọ mbufo,</para>
  <para style="q2" vid="MAT 11:17">ndien mbufo inekke unek;</para>
  <para style="q1" vid="MAT 11:17">ñnyin imonyuñ ikwọ ikwọ ñkpa,</para>
  <para style="q2" vid="MAT 11:17">mbufo ituaha eyet.’<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />Koro Jọn ekedide ika diaha inyuñ iñwọñke ñkpọ, ndien mmọ ema edọhọ ete, enye enyene ndedehe ekpo ke idem! <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Eyen owo emedi, adia onyuñ ọñwọñ ñkpọ ndien mmọ ete, ‘Sese owo ama udia ye ama mmin, ufan mme ọbọ ataksi obio, ye eke mme ndiọi owo.’ Eda edinam ọniọñ eyararede mme ọniọñ edi edinen.”<verse eid="MAT 11:19" /></para>
  <para style="s1">Nduri Utọñ Ye Ikot</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Ndien Jisọs ama ọtọñọ ndisuñi mme obio emi enye akanamde mme ikpọ utibe ñkpọ, koro mmọ ikamaha ndi kabade esit ntiene Abasi. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“Ọdọdiọk ọnọ fi Kọrasin, ọdọdiọk ọnọ fi Betsaida! Koro edieke ekpekenamde ke Taya ye Sidọn mme utibe utom emi eke namde ke otu mbufo, mmọ ekpekabade esit anyan ini esine ọfọñ ikpo, ye ntọñ ukut. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Edi, Ami ndọhọ mbufo nte, ke eyefọn ye Taya ye Sidọn ke usen ikpe akan mbufo. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Ndien afo Kapanọm, nte afo okoyom ndimenerede idem fo ke enyọñ? Eyetop fi esuhọrede esin ke itie ndutuhọ. Edieke ekpenamde kpukpru mme utibe ñkpọ emi eke namde ke esit fo, ke Sọdọm, enye ke okposuk odudu ke uwem mfin emi. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Edi ndọhọ fi nte ke ikpe eyefere ye isọñ Sọdọm ke usen ikpe akan ye afo.”<verse eid="MAT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Ke ini oro Jisọs ama ọdọhọ ete, “Ami mmọnọ Fi ekọm, O Ete, Ọbọñ enyọñ ye isọñ, koro Afo okodipde mbon ọniọñ ye mbon ifiọk mme ñkpọ emi, ndien ayarade mmọ ọnọ mme ñkpri nditọ. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Ih, Ete, koro emi edi nte Afo okoyomde ete etibe.”<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />“Ete Mi, amayak kpukpru ñkpọ ọnọ Mi, ndien baba owo kiet idiọñọke Eyen ọyọhọ ọyọhọ ke mibọhọke Ete, baba owo kiet inyuñ idiọñọke Ete ke mibọhọke Eyen ye owo ekededi emi Eyen edimade ndiyarade Enye nnọ. <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />Etiene Mi, kpukpru mbufo emi ekpade mba eto ke edibiom ndodobi mbiomo, ndien Ami ñyenọ mbufo nduọk odudu. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Ekọñọ ọkpọnọ Mi ke itọñ mbufo, enyuñ ekpebe Mi, koro Ami ndide suñsuñ, ñnyuñ ñnyenede nsuhọre idem ke esit. Ndien ukpọñ mbufo eyekut nduọkodudu. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Koro ọkpọnọ Mi ememde, mbiomo Mi onyuñ eferede.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">Jisọs, Andikara Sabat</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Ke ini emi Jisọs akasañade ebe ke iñwañ ibokpot ke usen ibet, biọñ ama ọdọñ mme mbet Esie, ndien mmọ ema etọñọ ndiwai ibokpot nta.<verse eid="MAT 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 12:2" />Ke ini mme Farisi ekekutde emi, ema edọhọ Enye ete, “Sese mme mbet Fo ke enam se minenke owo ndinam ke usen Sabat.”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Edi Jisọs ama ọbọrọ mmọ ete, “Nte mbufo ikokotke se Edidem Defid akanamde ke ini biọñ ọkọdọñde enye ye mme mmọ emi ekedude ye enye?” <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Nte enye okodukde ufọk Abasi onyuñ emen edisana uyo Abasi ata ye mmọ emi ekesañade ye enye, emi mikenenke mmọ ndita, ke mibọhọke mme oku ikpọñ? <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Mme nte mbufo ikonyuñ ikotke ke ñwed mbet nte mme oku ke ufọk Abasi ekesabarede enyuñ ebiatde usen Sabat ndien inyeneke ndudue? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Ndien ke akpanikọ ke ndọhọ mbufo nte, kiet odu mi emi okponde akan ufọk Abasi. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Edi, edieke mbufo ekpediọñọde se itie ñwed Abasi emi ọwọrọde: “Ami ñyom mbufo etua owo mbọm ekan nte enọde mme uwa ye mme nsio nsio enọ inemesit, mbufo ikpomiomke mme mmọ emi miduehe isop ikpe. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Koro Ami Eyen Owo ndi Ọbọñ Sabat.”<verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Jisọs ama ọkpọñ ebiet oro onyuñ aka atayat ubọñ akam kiet, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />ke ebiet emi owo emi ubọk esie kiet akakpade okodude. Mme owo ema edu do emi ekeyomde usuñ ndidori Jisọs ikọ nte ke Enye anam idiọkñkpọ, do mmọ ema ebup Enye ete, “Nte owo ndikọk owo udọñọ ke usen ederi akatuaha ye ibet?” <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Jisọs ama ọbọrọ ete, “Edieke owo mbufo ndomokiet enyenede erọñ kiet kpọt, ndien enye ọduọ oduk obube ke usen ederi, nte enye ikpodomoke ofuri ukeme esie ndisio enye ke obube ke usen oro?” <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Ndien owo ọsọñ urua akan erọñ, ke ntem, enen owo ndinam eti ñkpọ ke usen ederi. <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Do ke Enye ọkọdọhọ owo oro ete, “Neñerede ubọk fo.” Enye ama eneñerede ubọk esie, ndien ubọk oro ama ọsọñidem ukem nte ubọk ñkañ eken.<verse eid="MAT 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 12:14" />Mme Farisi ema ewọñọ ekeduk ediomi ebaña nte edisañade iwot Jisọs. <verse eid="MAT 12:14" /><verse number="15" style="v" sid="MAT 12:15" />Ke Jisọs ama ọkọfiọk ekikere mmọ Enye ama adaha ọkpọñ ebiet oro. Mme ediwak owo ema etiene Enye, ndien Enye ama ọkọk mme udọñọ mmọ, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />onyuñ oduri mmọ utọñ ete yak mmọ ekuyarade Imọ. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Enye akanam emi man se oku Abasi Aisaya eketiñde okposu:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Sese isuñutom emi Ami mmekde,</para>
  <para style="q2" vid="MAT 12:18">enyemi Ami mmade, ñnyuñ nemde esit mbaña.</para>
  <para style="q1" vid="MAT 12:18">Ami ñyesin Enye Spirit mi ke idem ndien</para>
  <para style="q2" vid="MAT 12:18">Enye eyekwọrọ unen ọnọ kpukpru mme idut.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Enye idinenike eneni, idinyuñ ibọñke ñkpo;</para>
  <para style="q2" vid="MAT 12:19">mme ndimenerede uyo Esie ke enyọñ, ke mme efak.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Enye idibuñke ñnyanyaña,</para>
  <para style="q2" vid="MAT 12:20">idinyuñ ifurike ọfọñ utuenikañ inime.</para>
  <para style="q1" vid="MAT 12:20">Enye eyeyire tutu unen akan,<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />ndien ke Enye, ke ofuri idut edisin idorenyin mmọ.”<verse eid="MAT 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Ekem, ema eda owo emi ndedehe spirit okomumde, emi ekedide nnan ye imum, esọk Jisọs. Ndien Enye ama anam udọñọ esie okure. Ntre enye ama ekeme nditiñ ikọ ñnyuñ ñkut usuñ. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Ndien idem ama akpa ofuri otu owo oro, mmọ enyuñ edọhọ ete, “Nte Enye mi edi Eyen Defid?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Edi ke adaña emi mme Farisi ekekopde ebaña mme utibe utom Esie, mmọ ema etiñ ete, “Enye ekeme ndibin ndedehe spirit koro Belsibọb, etubom mme ndedehe spirit ọnọde Enye odudu.”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Sia Jisọs ama ọkọdiọñọ ekikere mmọ, ama onyuñ ọdọhọ mmọ ete, “kpukpru idut emi ebaharede eda eñwan ye idem mmọ, eyeduk ke nditaha, ndien kpukpru mme obio ye mme ufọk emi abaharede eda eñwan ye idem esie, idisọñọke ida.” <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />“Ndien edieke Setan ebinde Setan, enye añwana ye idem esie, ndien enye onyuñ abiat obio ubọñ esie. <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Ndien edieke Ami ndade odudu Setan mbin ndedehe spirit, nditọ mbufo eda odudu anie ebin mmọ esioño? Ntem, mmọ eyekpe ikpe enọ mbufo. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Ndien edieke Ami mbinde ndedehe spirit mfep ke odudu Abasi, oro ọwọrọ ete ke obio ubọñ Abasi edi ke otu mbufo.” <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Ñko, owo ekeme didie ndiduk ke ufọk ọkpọsọñ owo ñkatañ mme ñkpọ esie, ke ini enye mibemke iso ibọp ọkpọsọñ owo oro, ndien enye ekeme ndibume ñkpọ ufọk esie? <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Enye emi misañake ye Ami, ọbọbiọñọ Mi; ndien owo ekededi emi mitañke ibok ye Ami, asasuan.<verse eid="MAT 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 12:31" />Ntem ke Ami ndọhọ mbufo nte, ke eyefen enọ owo ke kpukpru idiọkñkpọ ye edisabade, edi idifenke inọ owo ndomokiet ke ndisabade Edisana Spirit. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Eyefen enọ owo ekededi emi etiñde ikọ adian Eyen Owo, edi ididahakedo inọ owo ndomokiet emi editiñde ikọ idian Edisana Spirit, edide ke ererimbot enyemi, onyuñ edide ke enye emi edidide.<verse eid="MAT 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />“Enam eto ọfọn, ndien mfri esie eyefọn; enam eto ọdiọk ndien mfri esie ọyọdiọk ñko. Koro edade mfri eto ediọñọ eto. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Mbufo nditọ urukikọt, didie ke ndiọi owo nte mbufo ekeme nditiñ nti ikọ? Koro se owo ekerede ke esit esie kpa oro ke enye osio etiñ ke inua esie. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Eti owo osioño nti ñkpọ oto ke nti ñkpọ emi edọñọde enye ke idem; idiọk owo ñko osioño mme ndiọi ñkpọ oto ke mme ndiọi ñkpọ emi edọñọde enye ke idem. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Ndien Ami ndọhọ mbufo kemi nte ke owo kiet kiet eyenam ibat ke usen ikpe abaña mme ikpuikpu ikọ emi enye eketiñde. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Koro edida ikọ inua mbufo itebe mbufo ikpe, mme itip mbufo ikpe.”<verse eid="MAT 12:37" /></para>
  <para style="s1">Nọ Ñnyin Idiọñọ</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Usen kiet, mme ekpep mbet mme Ju, ye mme Farisi ema edidọhọ Enye ete, “Andikpep, ñnyin iyom ndikut idiọñọ nto fi.”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Jisọs ama ọbọrọ mmọ ete, “Edi oburobut emana ye emana efibe edi emi eyomde idiọñọ! Mbufo idikwe idiọñọ ndomokiet, ke ebede idiọñọ Prọfet Jona. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Koro nte Jona okodude ke idibi iyak uwemeyo ita ye okoneyo ita, kpa ntre ke Eyen Owo edidu uwemeyo ita ye okoneyo ita ke esit isọñ. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Mbio obio Nenife eyedaha eda ke ikpe ye emana emi ke usen ikpe, enyuñ enam ikpe etip enye, koro mmọ ema ekabade esit kadaña ini Jona ọkọkwọrọde ikọ Abasi ọnọ mmọ. Ndien idahaemi, Enye emi okponde akan Jona odu mi ke otu mbufo, edi mbufo etre ndinim Enye ke akpanikọ. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Ọbọñañwan Sheba, eyedaha ada ke ikpe ye emana emi ke usen ikpe, onyuñ etip enye ikpe, koro enye okotode anyan idut edi man edikop ifiọk Edidem Sọlọmọn; ndien kemi, Enye emi okponde akan Sọlọmọn odu mi, edi mbufo etre ndinim Enye ke akpanikọ.”<verse eid="MAT 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“Ke ini idiọk spirit ọwọrọde owo ke idem, enye asaña oyo ke nsat isọñ oyom nduọk odudu, edi ikwe. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Ndien enye ọdọhọ ete, ‘Ami ñyefiak ñnyọñ ufọk emi ami ñkotode ke esit ñwọrọ.’ Ndien ke ini enye afiakde edi, okut nte ufọk oro anade ukpọk, ema ekpọri enyuñ ebana enye. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Enye ndien aka akada mme ndiọi spirit itiaba efen emi ediọkde ekan enye adian ke idem, ndien mmọ ediduk enyuñ eduñ do, ndien ukperedem itie owo oro akabade ọdiọk akan nte ekedide. Kpa ntre ke edidi ye idiọk emana emi!”<verse eid="MAT 12:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Nte Jisọs okosuk etiñde ikọ ye mme otu owo, sese eka Esie ye nditọ eka Esie edida ke añwa eyom ndineme nneme ye Enye. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Owo kiet ama ọdọhọ Enye ete, “Sese Eka Fo ye nditọ Eka Fo ke añwa eda, eyom ndineme nneme ye Afo.” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Edi Enye ama obup ete, “Anie edi Eka Mi? Mme anie edi nditọ Eka Mi?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Enye anyanarede ubọk Esie owut mme mbet Esie, onyuñ ọdọhọ ete, “Mmọ emi edi eka Mi ye nditọ eka Mi.” <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Ndien Enye afiak adian uyo ete, “Owo ekededi emi edinamde se Ete Mi emi odude ke enyọñ amade, enye edi eyeneka Mi eren, ye eyeneka Mi añwan, ye Eka Mi.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">Mme Mbuk Obio Ubọñ Abasi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Kpa ke ñkpọ nte esisit ini ama ekebe ke usen oro, Jisọs ama ọwọrọ ọkpọñ ufọk onyuñ aka eketie ke mben ñkpọdiọhọ mmọñ. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Otu owo emi ekebohode ama okpon eti eti, oro anam Enye ama oduk ke ubom kiet onyuñ ọsuhọde etetie. Kpukpru mme owo oro ekebohode ekeda ke isọñ esuk. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Ndien Enye ama etiñ ediwak ikọ ọnọ mmọ ke ñke, ete, “Ọtọ iñwañ kiet ama aka ndisuan mme ñkpasip ke iñwañ esie. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Nte Enye akasuande ñkpasip, ubak ema eduọñọ, ke ọkpọusuñ, ndien mme inuen enyọñ editañ mmọ eta. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Ndien ndusuk ema eduọñọ ke isọñ itiat, ebiet emi esisit isọñ okodude. Ndien mmọ ema etibe usọp usọp koro isọñ mikọtuñọke. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Edi ke ini ekpri eyo asiahade, mmọ kpukpru eyemede, enyuñ ekpaña, koro oruñ mmọ miketimke iduk esit isọñ. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Ndusuk ñkpasip ema eduọñọ ke isọñ ñkukim, ndien ñkukim ama ọkọri onyuñ ofuk mmọ kpukpru. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Edi ndusuk ema eduọñọ ke eti isọñ enyuñ eñwum mfri; ubak eñwum mfri ikie, ubak ata, ubak edip ye duop. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Owo emi enyenede utọñ ndikop, yak enye okop.”<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Mbet Esie edi, enyuñ edibup Enye ete, “Nsidi ntak emi Afo etiñde ikọ ye mmọ ke ñke?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Enye ama ọbọrọ mmọ ete, “Edi mbufo ikpọñ ke enọ unen ndifiọk mme ndibe ñkpọ Obio Ubọñ Abasi, edi idighe inọ mmọ. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Enye emi ama ekenyenyene, eyemana edian enọ enye, man enye ototim enyene awak. Enye emi mikenyeneke nyene eyebọ enye kpa se enye ekenyenede. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />‘Ntak emi Ami ntiñde ikọ ye mmọ ke ñke edi: okposuk edi emi mmọ esede, mmọ ikwe usuñ; okposuk edi emi mmọ ekpañde utọñ, mmọ ikopke inyuñ idiọñọke se ọwọrọde.’<verse eid="MAT 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 13:14" />Ndien ntiñnnim ikọ Asiak Uduak Abasi Aisaya omosu ke idem mmọ, nte enye ọkọdọhọde, ete,</para>
  <para style="q1" vid="MAT 13:14">‘Mbufo eyekpañ utọñ enyuñ ekpañ utọñ edi idiñwañake mbufo;</para>
  <para style="q2" vid="MAT 13:14">eyeka iso ndise, edi idikwe.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Koro esit idut emi ọsọñde,</para>
  <para style="q2" vid="MAT 13:15">ọsọsọñ mmọ ndida utọñ mmọ ñkop ikọ</para>
  <para style="q2" vid="MAT 13:15">ndien mmọ ema ebọp enyin mmọ.</para>
  <para style="q1" vid="MAT 13:15">Ke mikpedighe ntre, mmọ ekpekut usuñ ye enyin mmọ,</para>
  <para style="q2" vid="MAT 13:15">enyuñ ekop ikọ ye utọñ mmọ,</para>
  <para style="q2" vid="MAT 13:15">enyuñ ediọñọ se ọwọrọde,</para>
  <para style="q1" vid="MAT 13:15">ndien ewọñọde etiene Mi man Ami ñkọk mmọ.’<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />Edi ọfọfọn ọnọ enyin mbufo, koro mmọ ekutde usuñ, ye utọñ mbufo, koro mmọ ekopde ñkpọ. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Ediwak mme oku Abasi ye mme nti owo emi ekponode Abasi, ema enyene udọñ ndikut se mbufo ekutde, ñnyuñ ñkop se mbufo ekopde, edi mmọ ikekemeke.<verse eid="MAT 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />Ekpañ utọñ ekop se ñke asuan ñkpasip ọwọrọde. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Ke ini owo ekededi okopde ikọ Abasi, ndien enye ifiọkke se ikọ oro ọwọrọde, andidiọk edi editañ se ekesuande ke esit esie efep. Emi edi mme ñkpasip emi ekeduọñọde ke ọkpọusuñ.<verse eid="MAT 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 13:20" />Eke enyọñ isọñ itiat edi esit emi okopde ikọ Abasi, onyuñ ọbọ enye ke inemesit. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Edi ikọ oro isinke oruñ ke uwem esie anam enye ibighike. Ke ini afanikọñ mme ukọbọ ọtọñọde ke ntak se enye onimde ke akpanikọ, inemesit esie ọtọñọ ndinime nte ikañ, ndien enye ọduọ ọkpọñ usuñ. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Isọñ emi ọyọhọde ye ñkukim edi esit owo emi okopde ikọ Abasi, edi udọñitọñ uwem ye udọñitọñ inyene ekọri efuk ikọ Abasi ndien enye ọtọñọ ndiduri idem esie nsio suñsuñ ñkpọñ ndinam ñkpọ nnọ Abasi. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Edi eti isọñ edi esit owo emi akpañde utọñ ọnọ ikọ Abasi onyuñ ọfiọk se enye ọwọrọde, ndien enye ọwọrọ okonyuñ ada owo edip ye duop, owo ata, mme owo ikie, oduk edi ke Obio Ubọñ Abasi.”<verse eid="MAT 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Se ñke efen mi emi Jisọs akadade ekpep ñkpọ abaña Obio Ubọñ Abasi: “Obio Ubọñ Abasi etie nte ọtọ iñwañ emi ọtọde nti ñkpasip ke iñwañ esie. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Edi ke okoneyo usen kiet, nte kpukpru owo enade ede idap, asua esie edi editọ mme ndiọi ñkpasip abuak ye nti ñkpasip ibokpot esie, ndien okokure enye ọwọrọ ọkpọñ iñwañ oro. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Ndien kadaña emi nti ñkpasip etọñọde ndikọri mme ndiọi ñkpasip oro enyuñ ekọri ye mmọ ukem ukem.”<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />Mme anam utom ke iñwañ edisian enyene iñwañ, ete, “Ete, iñwañ fo emi afo ọkọtọde nti mfri, eyeyọhọ idahaemi ye mme mbaraekpe.”<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />Ndien enye ama ọbọrọ ete, “Asua mi anam oro.” Mmọ ebup enye ete, “Nte ñnyin iwubede kpukpru mmọ ifep?”<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />“Edi Enye ama ọbọrọ mmọ, ete Baba-o, mbak mbufo ediwot mme mmọ eken edide nti mfri ibokpot ke edinam ntre. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Eyak kpukpru mmọ ekọri ebiet kiet tutu osim usen ñkpeñe, ndien ñyedọhọ mme ekpeñe ibokpot esat nti esioño enyuñ etebe mmọ ekọñ ke enyọñ ikañ, ndien efọp kpukpru mme ndiọi ñkpasip.” <verse eid="MAT 13:30" /><verse number="31" style="v" sid="MAT 13:31" />Enye onyuñ otop ñke efen ọnọ mmọ, ete: “Obio Ubọñ Abasi etie nte ñkpasip ofriyo kiet, emi owo ọtọde ke iñwañ esie. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Enye ekpri akan ke otu mme ñkpasip, edi ke ini enye ọkọride enye akabade edi akamba eto emi mme inuen enyọñ ekemede ndibọp efọk, ñnyuñ nduñ ke esit.”<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Enye afiak otop ñke efen, ete, “Eda Obio Ubọñ Abasi edomo ye ibọk unam uyo emi ñwan odomode onyuñ abuak ke ndom uyo ndinam enye emenerede idem, emi enye onyuñ abuakde kpukpru tutu enye abuaha ofuri ofuri ye ndom uyo.”<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Jisọs akada ñke etiñ ikọ ọnọ mme otu owo; Enye iketiñke baba ikọ ndomokiet ye mmọ ke mibọhọke ke ñke. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Man osu nte Asiak uduak Abasi eketiñde ete, ñyetat inua Mi ntiñ ikọ ke ñke, ñyetiñ ñkpọ emi ekedibede toto ke editọñọ ererimbot.<verse eid="MAT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Ke Enye ama akadaha ọkpọñ otu owo ke añwa, Enye ama oduk ufọk, ndien mme mbet Esie ema edidọhọ Enye ete, yak Enye anam mmimọ ifiọk se ñke ndiọi ñkpasip iñwañ oro ọwọrọde.<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Enye ama ọbọrọ mmọ ete, “Enye emi ọkọtọde nti ñkpasip edi Eyen Owo (Jisọs). <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Iñwañ oro edi ererimbot; ndien nti ñkpasip edi nditọ Obio Ubọñ Abasi, ndiọi ñkpasip edi nditọ andidiọk (Setan). <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Asua emi ọkọtọde ndiọi ñkpasip abuak edi Setan; ini idọk edi utit ererimbot; ndien mme ekpeñe ibokpot edi mme isuñutom Abasi (mme Enjel).”<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />Nte esatde ndiọi ñkpasip esioño enyuñ efọp ke ikañ, kpa ntre ke utit ofuri ererimbot editie, <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Eyen owo eyedọñ mme asañautom Abasi (enjel) Esie, ndien mmọ eyewubede kpukpru mme ñkpọ emi adade owo esin ke idiọkñkpọ, ye mme mmọ emi enamde idiọk ido ke Obio Ubọñ Esie osioño, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />enyuñ etomo mmọ edọñ ke akwa edeme ikañ emi asakde, ke ebiet emi ntuaña ye ntaedet edidude. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Ndien mme ndinen owo eyeyama nte utin usenubọk ke Obio Ubọñ Ete mmọ. Enye emi enyenede utọñ yak enye okop.<verse eid="MAT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Obio Ubọñ Abasi etie nte ñkpọuto emi owo okutde nte ọbuhọde ke isọñ iñwañ, ndien enye otim ofuk enim, ndien ke idaraesit enye aka akanyam kpukpru se enye ekenyenede ada edep iñwañ oro.”<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“Ñko, Obio Ubọñ Abasi ebiet anyam urua emi oyomde mme nsọñurua itiat; <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />ndien ke enye ama okokut eti esie, emi ọsọñde urua, enye akanyam kpukpru inyene esie ada edep enye.”<verse eid="MAT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“Utọñọntak ñko, eda Obio Ubọñ Abasi edomo ye mme ọkọ iyak emi mi etopde iyire mmọ efuk ke inyañ ibom, ndien emum mme nsio nsio oruk iyak. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Ndien ke iyire ama ọkọyọhọ, mmọ eduri edọk obot, enyuñ etọñọ ndisat iyak kiet kiet ke iyire nsioño, ndien etañ kpukpru se ifọnde edọñ ke akpasa enyuñ etomo mmọ emi mifọnke eduọñọ. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Emi edi se iditibede ke utit ererimbot. Mme Enjel eyesuhọde edi, edibahade mme ndiọi owo ye nti owo. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Ndien etomo mme ndiọi owo edọñ ke akwa edeme ikañ, ke ebiet emi ntuaña ye ntaedet edidude.” <verse eid="MAT 13:50" /><verse number="51" style="v" sid="MAT 13:51" />“Nte kpukpru ñkpọ emi añwaña mbufo?” Mmọ ema ebọrọ ete, “Añwaña.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Ntem ke Enye akafiak adian ikọ ete, “Kpukpru mme ntaifiọk ke ibet mme Ju emi ekabade edi mme mbet Mi idaha emi, emenyene mme ñkpọuto utim ikaba eto akani ediomi kpa ye obufa ediomi.”<verse eid="MAT 13:52" /></para>
  <para style="s1">Nte Emi Idighe Eyen Kabinta</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Ke Jisọs ama ekekure nditop kpukpru mme ñke Esie, Enye ama ọkpọñ ñkanñkuk oro. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Ndien Enye ama afiak aka obio emana Esie. Enye ama ọtọñọ ndikpep mmọ ñkpọ ke itie ntuak ibuot mme Ju, tutu idem akpa mmọ. Mmọ enyuñ ebup idem mmọ ete, “Owo emi ada utọ ifiọk ye odudu unam mme utibe ñkpọ emi oto mmọñ?”<verse eid="MAT 13:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 13:55" />“Nte Enye idighe eyen kabinta? Nte eka Esie ikereke Mmeri? Nte nditọ eka Esie iren inyuñ ikereke Jems, ye Josef, ye Saimọn, ye Judas? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Nte mme nditọ eka esie iban iduhọ mi ye ñnyin? Ke mmọñ ndien ke owo emi ada kpukpru mme ñkpọ emi?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Ndien mmọ ema etọñọ ndikop idiọkesit mbaña Enye. Edi Jisọs ọdọhọ mmọ ete, “Asiak Uduak Abasi inanake ukpono ke imibọhọke ke obio emana esie ye ke ufọk esie.”<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Ndien Enye ikenamke ediwak mme utibe idiọñọ do oto ke unana mbuọtidem mmọ.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">Nte Ekewotde Jọn</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Ke ini oro, Edidem Erọd ama okop mbuk abaña etop Jisọs, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />ndien enye ama ọdọhọ mbon esop esie ete, “Owo emi edi Jọn Babtis ke idem esie; enye eset ke ñkpa, ntak edi oro odudu ndinam mme utibe ñkpọ odude enye ke idem.” <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />Ekedi Erọd emi okomum Jọn ndien ọbọp enye esin ke ufọk ñkpọkọbi oto ke ntak Erọdias emi ekedide ñwan ndo eyen eka esie, Filip. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Koro Jọn ama ọdọhọ enye ete ke ifọnke enye ndida ñwan eyen eka esie emi osuk odude ke uwem ndọ. <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Enye okpowot Jọn ini kiet edi oto ke ntak ndik akwa ntime nditibe, koro kpukpru otu owo ekenimde ke akpanikọ nte ke Jọn ekedi Asiakuduak Abasi. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Edi ke usen usọrọ emana Erọd, eyen añwan Erọdias ama enek unek emi ekenemde Erọd esit, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />tutu enye ama ọñwọñọ ndinọ eyenañwan oro ñkpọ kiet ekededi emi enye edibeñede. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Ke ntak item eka esie, eyenañwan emi ama ebeñe ete, “nọ mi ibuot Jọn Babtis ke usanikpañ.”<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Esit ama etimede Edidem, edi ke ntak uñwọñọ esie ye mmọ emi eketiede ke okpokoro usọrọ ye enye, enye ama ọdọhọ ete yak enọ enye ebeñe esie;<verse eid="MAT 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 14:10" />ndien enye ama ọdọñ ekesibe ibuot Jọn ke ufọk ñkpọkọbi. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Ema emen ibuot Jọn ke usanikpañ edinọ eyenañwan emi, ndien enye ama emen ọkọnọ eka esie.<verse eid="MAT 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 14:12" />Mme mbet Jọn ema ekemen okpo esie ekebuk, enyuñ enam Jisọs ọfiọk abaña kpukpru se iketibede.<verse eid="MAT 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Kadaña emi Jisọs okopde mbuk emi, Enye ama oduk ubom ini kiet ọkpọñ ebiet oro aka ke ebiet emi odobode eketie ikpọñ. Ke ini mme otu owo ekekopde, mmọ ema esaña obot obot ebe ediwak obio ebine Enye.<verse eid="MAT 14:13" /></para>
  <para style="s1">Jisọs Ọnọ Owo Tọsin Ition Udia</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 14:14" />Ndien ke ini Jisọs ekesimde isọñ Enye ama okut otu owo emi eketiede ebet Enye, ndien Enye ama atua mmọ mbọm, onyuñ ọkọk mmọ emi ekedọñọde udọñọ.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Ke ama ekesim mbubreyo, mbet Esie edidọhọ Enye ete, “Ini udia mbubreyo ekem ndien baba udia ndomokiet idughe ke isọñ utatan emi, dọhọ kpukpru owo enyọñọ man ekpekedep udia mmọ ke mme ñkpri obio iñwañ emi mmọ edisañade ke esit ibe.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Edi Jisọs ama ọbọrọ ete, “Ntak iduhọ mmọ ndiñyọñọ, enọ mmọ udia edia ke idem mbufo.”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Mmọ ema edọhọ Enye ete, “Ñnyin inyene ebok uyo ition ye iyak iba kpọt.”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Jisọs ama ọdọhọ mmọ ete, “Eda mmọ esọk Mi.”<verse eid="MAT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 14:19" />Enye ama ọdọhọ otu owo ete esuhọde etetie ke mbiet; ndien Enye ama emen ebok uyo ition ye iyak iba oro emenede enyin Esie ese ikpaenyọñ onyuñ ọdiọñ mmọ ndien ama obuñ mme uyo oro, onyuñ ayak ọnọ mme mbet Esie, emi ekemende enọ mme otu owo eta. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Kpukpru mmọ ema eta nte ọkọyuhọde mmọ; ndien mme mbet ema etañ mme mbeñe uyo oro ye iyak esin eyọhọ akpasa duopeba. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Ibat mmọ emi eketade uyo oro ekedi ñkpọ nte tọsin irenowo ition ke esiode iban ye nditọ ọwọñ efep. <verse eid="MAT 14:21" /><verse number="22" style="v" sid="MAT 14:22" />Ke emi ama okokure, Jisọs ama ọdọhọ mbet Esie ete yak mmọ eduk ubom ebe inyañ eka edem eken, kadaña emi Enye añwanade ndinam otu owo esuana enyọñọ.<verse eid="MAT 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 14:23" />Ke Enye ama akanam mme otu owo enyọñọ, Enye ama ọdọk aka obot ikpọñ ndibọñ akam! Enye okodu do ikpọñ tutu osim mbubreyo. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Ke ubom ama ekesighede ọkpọñ isọñ anyan, akpa ama adaha eti eti, onyuñ etimede ubom sia ofum ọkọwọrọde ọbọi iso.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Edi ke ñkpọ nte ñkanika inañ usenubọk, Jisọs ama adaha asaña ke enyọñ ikpa mmọñ ebine mmọ, <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />ndien ke ini mme mbet Esie ekekutde Enye nte asañade ke enyọñ mmọñ, ndik ama anam mmọ eti eti ndien mmọ efiori ke ọkpọsọñ uyo ete edi ekpo.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Edi Jisọs ke ndo ndo oro ama osioro uyo ete, “Esọñ esit, ke edi Ami, ekufehe ndik.”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Do ke Pita ọkọdọhọ Enye ete “Ọbọñ, edieke edide Afo, dọhọ mi nsaña ke enyọñ mmọñ mbine Fi.”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Jisọs ama ọdọhọ ete, “Di.” Do Pita ama ọsuhọ ke ubom onyuñ asaña ke enyọñ mmọñ ebine Jisọs. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Edi nte enye okokutde ọkpọsọñ oyobio, ndik ama anam enye, ndien enye ọtọñọ ndideñ. Enye ama ofiori ete, “Ọbọñ, nyaña mi!”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Jisọs ama anyanade ubọk Esie inikiet, omum enye onyuñ ọdọhọ enye ete, “Afo owo ekpri mbuọtidem, ntak emi afo ekeyikde?” <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Ndien kadaña emi mmọ ema ekedọk eduk ubom, ofum inyañ ibom ama etre.<verse eid="MAT 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 14:33" />Mme mmọ emi ekedọñọde ke ubom ema etuak ibuot enọ Enye, enyuñ edọhọ ete, “Ke akpanikọ, Afo edi Eyen Abasi.”<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Ke mmọ ema ekebe inyañ, mmọ ema ekebehe ke isọñ Kenesaret. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Ndien ke adañaemi mbon edem oro ekeyararede ediọñọ ete ke ekedi Jisọs, mmọ ema esuan etop enọ ofuri ñkanñkuk mmọ, ndien mmọ ema eda mme mbọn udọñọ ebine Enye, <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />enyuñ ekpe Enye ubọk ete yak Enye ayak mmọ ekam etuk mben ọfọñidem Esie ikpọñ. Ndien kpukpru mmọ emi eketukde ema ekop nsọñidem.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">Mme Ibet Ye Mme Ido Edinam</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Ekem mme Farisi ye mme andikpep mme Ju, eto ke Jerusalem edisobo ye Jisọs, enyuñ ebup Enye ete,<verse eid="MAT 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 15:2" />“Nso inam mme mbet Fo ebiatde ido eset mme Ju? Ke emi mmọ miyetke ubọk ndien mmọ edia udia?” <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Ndien Enye ama ọbọrọ mmọ ete, “Ndien nsidi ntak emi mbufo ebiatde mme ibet Abasi ke ntak ido emana mbufo? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Koro Abasi ọkọdọhọde ete, ‘Kpono usọ ye uka,’ ndien owo ekededi emi osuñide ete mme eka esie enyene ndiwot enye. <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Edi mbufo edọhọ ete, Edieke owo kiet ekededi ọdọhọde ete mme eka esie ete, ami mmayak se ñkpadade ññwam fi nnọ Abasi, <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />ebọ enye ubiọñ ediñwam ete ye eka esie. Ke usuñ emi mbufo emebiat mme ibet Abasi oto ke mme ido ukpono mbufo.” <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Mbufo mbon mbubik! Ekedi mbufo ke Aisaya eketiñ abaña ke ini enye akasiakde Uduak Abasi, ete. <verse eid="MAT 15:7" /><verse number="8" style="v" sid="MAT 15:8" />“ ‘Mmọ emi ekpono Mi ke ñkpọkinua, edi esit mmọ ọkpọñ Mi anyan ebiet. <verse eid="MAT 15:8" /><verse number="9" style="v" sid="MAT 15:9" />Edi ke ikpuikpu ke mmọ ekpono Mi, sia mmọ ekpepde mme ibet ubọk owo.’ ”<verse eid="MAT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Ndien Enye ama okot otu owo onyuñ ọdọhọ mmọ ete “Ekpañ utọñ enyuñ efiọk se ọwọrọde. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Idighe se idukde owo ke inua asabade owo, edi se iwọrọde owo ke inua asabade owo.”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Ekem mme mbet Esie edidọhọ Enye ete, “Nte Afo ọmọfiọk ete ke mme Farisi eyat esit ke ini mmọ ekekopde mme ikọ emi?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Enye ama ọbọrọ ete, “Eyewubede kpukpru mme eto emi midighe Ete Mi ọtọ. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Ekpọñ mmọ; mmọ edi mme nnan emi etemede owo usuñ. Edieke nnan adade nnan usuñ, kpukpru mmọ eyeduọñọ edọñọ ke obube.”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Ndien Pita ọdọhọ Enye ete, “Yarade ñke emi nọ ñnyin.” <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Ndien Jisọs obup mmọ ete, “Nte mbufo ñko idiọñọke ñkpọ kaña? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Nte mbufo ikwe ite ke ñkpọ ekededi emi odukde owo inua ebe oduk idibi, ndien esio eduọk ke ufọk ekwe? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Edi mme ñkpọ emi ewọñọde owo ke inua, eto ke esit, edi mmọ emi esabade owo. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Koro mme ndiọi ekikere eto ke esit ewọñọ, uwot owo, efibe, use, inọ, ntiense nsu, ye edisabade owo. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Kpukpru mme ñkpọ emi edi se isabarede owo. Edi edidia udia ye ubọk emi owo miyetke isabakede owo.”<verse eid="MAT 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Ekem Jisọs ama adahado aka ke ñkañ Taya ye Sidọn.<verse eid="MAT 15:21" /></para>
  <para style="s1">Mme Utibe ñkpọ Efen</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 15:22" />Eyen añwan emi okotode Kenan, emi okoduñde ekpere do ama asaña etiene Enye, onyuñ ofiori ete, “Tua mi mbọm, Ọbọñ, Eyen Edidem Defid! Idiọk spirit kọtuhọde eyen mi añwan ke ata idiọk usuñ.”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Edi Jisọs ikosioroke uyo. Ndien mme mbet Esie ema ekpe Enye ubọk ete, “Sio enye unyọñ, koro enye kosio ñkpo etiene ñnyin.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Do ke Jisọs ọkọbọrọ mmọ ete, “Ekedọñ Mi enọ mme erọñ ufọk Isrel emi esopde ikpọñ ikpọñ.”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Edi eyen añwan emi ama asaña edi, editọñọ erọñ ke iso Jisọs, onyuñ ebeñe ete, “Ọbọñ, ñwam mi.”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Jisọs ama ọbọrọ ete, “lnenke ndimen uyo nditọ ntop nnọ mme ebua.”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Ñwan oro ama ọbọrọ ete, “Edi ntre Ọbọñ mi, edi mme ebua ekeme nditañ mme mbeñe udia emi eduọñọde eto enyọñ okpokoro udia ete mmọ.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Ndien Jisọs ama ọbọrọ enye ete, “O, eyen añwan, mbuọtidem fo omokpon, yak osu ọnọ fi nte afo oyomde.” Ndien eyen esie añwan ama okop nsọñidem kpasuk ke ndo ndo oro.<verse eid="MAT 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Jisọs ama adaha ọkpọñ do aka mben akpa Kalili, onyuñ ọkọdọk obot ọsuhọde etetie. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Akwa otu owo ema emen mme mbuñọ ye mme nnan, ye mme ñkpoho, ye mme imum ye ediwak mbon udọñọ enyuñ ekenim Jisọs ke iso, ndien Enye ama anam udọñọ okure mmọ. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Idem ama akpa otu owo oro kadaña emi mmọ ekekutde nte imum etiñde ikọ, mme mbuñọ eneñerede esaña, mme nnan ekut usuñ, ndien mmọ etoro Abasi Isrel.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Ndien Jisọs okot mme mbet Esie ete edi, onyuñ ọdọhọ mmọ ete, “Ami mmokop otu owo emi mbọm, kemi mmọ ema ekedu ye Ami usen ita idaha emi ndien mmọ inyeneke se ediade. Ami ñkpamaha ndinam mmọ enyọñọ idibi ukpọk man mmọ edikikpaña mba ọbiọñ ke usuñ.”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Mbet Esie ema ebọrọ Enye ete, “Mmọñ ke ñnyin idinyene udia emi edikemde kpukpru ibat owo emi ndidia ke ebiet emi asatde ntem?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Jisọs ama obup mmọ ete, “Eboho uyo ifañ ke mbufo enyene?” Ndien mmọ ema ebọrọ Enye ete, “Eboho uyo itiaba ye ibad ibad ñkpri iyak ifañ.”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Ndien Jisọs ama ọdọhọ ofuri otu owo etetie ke isọñ. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Ndien Enye emen eboho uyo itiaba ye iyak onyuñ ọnọ Abasi ekọm kabaña mmọ; ndien obuñ onyuñ ọnọ mbet Esie, ndien mmọ emen edeme enọ otu owo. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Kpukpru owo ema eta tutu mmọ eyuhọ, mme mbet enyuñ etañ ñkeñe emi ọkọsuhọde, eyọhọ akpasa itiaba. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Mmọ emi eketade uyo emi ekedi tọsin owo inañ, ke esiode iban ye nditọ ọwọñ efep.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Ke ini Enye ama akanam mme otu owo enyọñọ, Enye ama oduk ke ubom onyuñ ebe edi ke ñkañ obio Makadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">Eyom Edinam Idiọñọ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Mme Farisi ye mme Sadusi ema edi edidomo Enye ke edidọhọ Enye owut mmimọ idiọñọ otode ikpa enyọñ.<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />Edi Enye ama ọbọrọ mmọ ete, “Ke ini mbubreyo mbufo edọhọ ete, usen eyefọn, koro enyọñ adatde. <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Ndien ke usenubọk mbufo edọhọ ete, usen eyediọk, koro enyọñ adatde, onyuñ ọfuhọde. Mbufo emediọñọ ndikabade mme idiọñọ ikpaenyọñ, edi mbufo ikemeke ndifiọk mme idiọñọ ini. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Edi idiọk emana ye emana efibe eyom mme utibe idiọñọ, edi idinọhọ enye idiọñọ ndomokiet, ke ebede idiọñọ Jona.” Ndien Enye ama adaha ọkpọñ mmọ ke idaha.<verse eid="MAT 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Mme mbet Esie ema efre ndida uyo ke ini mmọ ekebede ñkpọdiọhọ mmọñ eda ke edem eken.<verse eid="MAT 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 16:6" />Jisọs ama oduri mmọ utọñ ete, “Etim ekpeme ibọk edimenede ndom uyo (yeast) mme Farisi ye Sadusi.”<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Mmọ ema etiñ ye idem mmọ ete, “Enye etiñ emi koro ñnyin mikadaha uyo ndomokiet ibe inyañ.”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Jisọs ama ọfiọk ekikere mmọ ndien Enye ama ọdọhọ mmọ ete, “O mbufo mbio ekpri mbuọtidem, nsidi ntak emi mbufo etiñde ebaña unana uyo?” <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Nte itimke ifiọk ñkpọ kaña? Inyuñ itighi uyo ition emi tọsin owo ition eketade ye mme ibat akpasa emi mbufo eketañde? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Inyuñ itighi uyo itiaba emi owo tọsin inañ eketade, ye ibat akpasa emi mbufo eketañde. <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Ntaha ndien mbufo mikemeke ndifiok nte ke Ami ñketiñke mbaña uyo? Edi ñkọdọhọ nte “Ekpeme idem mbufo kabaña ibọk umenede ndom uyo mme Farisi ye mme Sadusi.”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Ndo ndo oro mmọ ema ediọñọ, ete, ke Enye iketiñke ye mmimọ ibaña ibọk unam uyo, edi ekedi kabaña mme ukpepñkpọ mme Farisi ye mme Sadusi.<verse eid="MAT 16:12" /></para>
  <para style="s1">Mbufo Ekere Ete Ami Ndi Anie?</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Kadaña emi Jisọs ekesimde Siseria Filipai, enye ama obup mbet Esie ete, “Mme owo edọhọ ete Eyen Owo edi anie?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Ndien mmọ ema ebọrọ ete, “Ndusuk owo edọhọ ete ke Enye edi Jọn Babtis, ndusuk edọhọ ete Elaiya, ndusuk ete Jerimaya, ndusuk ete kiet ke otu mme oku Abasi eset.”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Enye ama obup mmọ, “Ndien mbufo-o? Edọhọ ete ke Ami ndi anie?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Do ke Saimọn Pita ọkọbọrọ enye ete, “Afo edi Kraist Eyen Odu Uwem Abasi.”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Ndien Jisọs ama ọbọrọ enye ete, “Ọfọfọn ọnọ fi, Saimọn eyen Jona. Koro idighe obuk ye iyip akayarade ñkpọ emi ọnọ fi, edi Ete Mi emi odude ke enyọñ. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Ke ntre, Ami ndọhọ fi idaha emi nte, Afo edi Pita (itiat), ndien ami ñyebọp ufọk Mi ke enyọñ itiat emi, ndien mme inuaotop itie ndutuhọ idinyuñ ikanke enye. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Ami ñyenọ fi mme ukpọhọde Obio Ubọñ Abasi, ndien se ededi emi afo edibọpde ke isọñ, eyebọp ke enyọñ, se ededi emi afo editatde ke isọñ, eyetat ñko ke enyọñ.”<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Enye ndien ama owuk mme mbet Esie ete yak mmọ ekutiñ enọ baba owo ndomokiet nte ke Imọ idi Kraist.<verse eid="MAT 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Ọtọñọde ke ini oro tutu aka iso, Jisọs ama ọtọñọ nditiñ iñwañ iñwañ nnọ mbet Esie mbaña edika Esie ke Jerusalem ye se idisimde Enye do ke ubọk mme ñyobio owo, ye mme ikpọ oku, ye mme andikpep mme Ju, ndien ke mmọ eyenyuñ ewot imọ, ndien ke ọyọhọ usen ita imọ iyeset.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Ndien Pita ama ada Enye adaha ọkpọñ otu owo onyuñ ọtọñọ ndisua nnọ Enye ete, “Nsa Fo, O Ọbọñ, utọ ñkpọ oro ikemeke nditibe ye afo.”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Edi Jisọs ọwọñọrede onyuñ ọdọhọ Pita ete, “Be da Mi ke edem, setan. Afo edi ñkpọ iduọ ọnọ Mi, koro usuñ ekikere fo idighe eke Abasi, edi eke owo.”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Ekem Jisọs ama ọdọhọ mbet Esie ete, “Edieke owo ekededi oyomde nditiene Mi, yak enye akañ idem esie onyuñ emen mbiomo esie etiene Mi. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Koro owo ekededi emi enimde uwem esie ọnọ idem esie, eyeduọk enye, edi owo eke ayakde uwem esie ọduọk ke ntak Mi eyefiak enyene uwem esie. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Nso udori idu do, edieke afo enyenede ofuri ererimbot ndien ọduọk ukpọñ fo? Nso ke owo edida ikpuhọ ye ukpọñ esie? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Koro Eyen Owo eyedi ke ubọñ Ete Esie ye mme enjel Esie ndien Enye eyenọ kpukpru owo kiet kiet utib etiene se enye akanamde.” <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />“Ke akpanikọ ke ndọhọ mbufo nte, ndusuk owo edu ke otu emi edade mi, emi miditabike ñkpa tutu mmọ ekut Eyen owo edide ke ubọñ Esie.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">Jisọs Ke Ubọñ Esie</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Ke usen itiokiet ama ekebe, Jisọs ama ada Pita ye Jems ye Jọn, eyen eka Jems, ọdọk ke ñkoñkoñ obot eketie ke idem mmọ. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Ndien nte mmọ ekesuk esede Enye, Enye ama ọkpuhọrede uduot. Iso Esie onyuñ ayama nte utin, ndien ọfọñ idem Esie akabade afia nte uñwana.<verse eid="MAT 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 17:3" />Ndien sese Moses ye Elaiya ewọrọ eda mmọ ke iso, enyuñ eneme nneme ye Jisọs. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Do ke Pita ọkọdọhọ Jisọs ete, “Ọbọñ, ọfọn ñnyin ndidu mi. Edieke Afo edinyimede, ñyebọp atayat ita mi, kiet enyene Fi, kiet enyene Moses, kiet enyene Elaiya.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Enye ke eketetiñ ikọ, sese afia ntuhube ye uyama eto ke enyọñ ekan mmọ okuk, ndien uyo ama oto ke ikpaenyọñ emi eketiñde ete, “Emi edi edima Eyen Mi, emi enemde mi esit, mbufo ekop uyo Esie.”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Ndien ke ini mme mbet ekekopde uyo oro, mmọ ema eduọñọ ekibi iso mmọ ke isọñ oto ke ọkpọsọñ ndik. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Edi Jisọs ama asaña edi, edituk mmọ, onyuñ ọdọhọ ete, “Edaha ke enyọñ, ekufehe ndik.”<verse eid="MAT 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 17:8" />Ndien ke ini mmọ emenerede enyin ese, mmọ ikekwe baba owo kiet efen ke mibọhọke Jisọs ikpọñ.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Ndien nte mmọ esuhọrede ke enyọñ obot Jisọs ama owuk mmọ ete, “Ekutiñ enọ owo baba kiet se mbufo ekekutde tutu emenede Eyen owo ke ñkpa.”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Mbet Esie ema ebup Enye ete, “Ntaha mme Andikpep ibet edọhọde ete ke Elaiya enyene ndibemiso ndi-e?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Jisọs ama ọbọrọ mmọ ete, “Mmọ enen. Elaiya enyene ndibem iso ndi man editim kpukpru ñkpọ onim ke itie mmọ. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Edi ke akpanikọ ke ndọhọ mbufo nte, Elaiya ama ededi, ndien mmọ ikediọñọke enye, edi ekenam ye enye nte mmọ ekemade. Kpasuk ntre ke Eyen Owo ñko edikut ukut ke ubọk mmọ.”<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Ntem ke mbet ekefiok ete ke Enye eketiñ ye mmọ abaña Jọn Babtis.<verse eid="MAT 17:13" /></para>
  <para style="s1">Jisọs Ọsuhọde Edi Isọñ</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Ke mmọ ema ekedisim otu owo, owo kiet ama edi editọñọ edọñ ke iso Jisọs. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“Ete, tua eyen mi mbọm, koro enye edi owo ndisi, enye onyuñ odu ke akamba ndutuhọ; kpukpru ini enye ọdọduọ oduk ikañ mme mmọñ. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Ami mma nda enye nsọk mme mbet Fo edi mmọ ikekemeke ndikọk udọñọ esie.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Jisọs ama ọbọrọ ete, “O mbufo mbio emana emi enanade mbuọtidem, enyuñ ekwañade ido, adaña didie ke Ami ndidu ye mbufo? Adaña didie ke Ami ndiyọ mbufo? Da enye sọk Mi.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Jisọs ama asua ọnọ ndedehe spirit emi ekesinede eyen oro ke idem; ndien enye ọkpọñ enye, ndien ke ndo ndo oro eyen oro ama okop nsọñidem.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Ke oro ama ekebe, mbet Esie ekebup Enye ke ndibe ete, “Nsidi ntak emi ñnyin mikekemeke ndibin spirit oro nsio eyen oro ke idem?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Enye ama ọbọrọ mmọ ete, “Oto ke ntak ekpri mbuọtidem mbufo,” koro edieke ekpenyenede mbuọtidem emi ekpride nte ñkpasip ofriyo kiet, emekeme ndidọhọ obot emi ete, “Wuhọde mi, ka kọwuhọ ko,” ndien enye eye ọwuhọde. Baba ñkpọ kiet idisọñke ikan mbufo ndinam. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Edi oruk ndedehe spirit emi ikemeke ndiwọrọ ntre ibọhọke mbufo ebọñ akam enyuñ etre udia.<verse eid="MAT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Ke mmọ ema ekedisobo ọtọ kiet ke Kalili, Jisọs ọdọhọ mmọ ete, “Emọñ etap Eyen Owo esin ke ubọk mme owo, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />mmọ eyenyuñ ewot Enye, ndien ke ọyọhọ usen ita eyenam Enye eset onyuñ ọtọñọ ntak odu uwem.” Ndien mbet ema efuhọ eti eti.<verse eid="MAT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Ke mmọ ema ekesim Kapanọm, mme ọbọ ataksi itie ukpono ema ebine Pita enyuñ ebup enye ete, “Nte Andikpep mbufo ekpe taksi itie ukpono?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Pita ama ọbọrọ ete, “Enye ekpe.” Ke enye ama okoduk ufọk, Jisọs ebem iso obup Enye ete, Saimọn, “Afo ekere nso? Ndidem ererimbot ebọ mme anie taksi ye utomo, ebọ eto nditọ mmọ, mme ebọ eto mme isenowo?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Pita ama ọbọrọ ete, “Ebọ eto isenowo.” Jisọs ama ọbọrọ enye ete, “Ke ntre nditọ isọñ ebọhọ. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Edi mbak ñnyin idiyat mmọ esit, ka ke inyañ kesin uwam, ñnyuñ men akpa iyak emi udumumde, nyuñ tat enye inua, ndien afo eyekut okuk kiet. Men nọ mmọ ke okuk ataksi Mi ye okwo.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">Etie Nte Ñkpri Nditọ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Kpa ke ini oro mbet ema ebine Jisọs ekebup enye ete, “Anie edikpon ikan ke Obio Ubọñ Abasi?”<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Jisọs ama okot ekpri eyenọwọñ onyuñ anam enye ada ke ufọt mmọ. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Onyuñ ọdọhọ ete, “Kakpan, ke ndọhọ mbufo nte, ibọhọke mbufo ekabade, enyuñ etie nte ñkpri nditọ, mbufo ididukke Obio Ubọñ Abasi. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Ke ntre, owo ekededi emi ọsuhọrede idem esie, etie nte ekpri eyenọwọñ emi, kpa enye okpon akan ke Obio Ubọñ Abasi. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Ndien owo ekededi emi edidarade ekpri eyenọwọñ kiet nte enyemi ke enyiñ Mi, adara Mi.” <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />“Edi, edieke owo ndomokiet anamde kiet ke otu ñkpri nditọ emi ebuọtde idem ye Ami ọduọk mbuọtidem esie ke idem mi, ọkpọfọn ye enye akan edieke ekpedade akwa itiat etebe enye ke itọñ, ndien emen enye etop esin ke udem inyañ.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />Ọdọdiọk ọnọ ererimbot ke ntak kpukpru mme etabi idiọkñkpọ esie. Mme etabi idiọkñkpọ enyene ndidu, edi ọdọdiọk ọnọ owo emi etabi idiọkñkpọ editode ke enye. <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Edieke edide ubọk, mme ukot fo esin fi anam idiọk, sibe enye fep nyuñ top enye duọk. Ọfọn ndidi mbuñọ nduk ke Obio Ubọñ Abasi ye uwem akan ndinyene ubọk iba ye ukot iba ndien etop fi esin ke nsinsi ikañ ndutuhọ. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Ndien edieke enyin fo esinde fi ọduọ, tibi enye sio, nyuñ men enye top duọk. Koro ọfọn ndiduk Obio Abasi ye enyin kiet akan nditop fi nsin ke ndutuhọ ikañ ye enyin iba.”<verse eid="MAT 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Ekpeme mbak mbufo edisin kiet ke otu ñkpri nditọ emi ke ndek. Koro Ami ndọhọ mbufo nte mme enjel mmọ ke enyọñ ke ese iso Ete Mi kpukpru ini. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Eyen owo ekedi ndinyaña mmọ emi ekesopde.<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />“Mbufo ekere ise? Edieke owo enyenede erọñ ikie ndien kiet oyo, onyuñ osop, nte enye idikpọñke anañ ye efutenañ eken ke enyọñ obot ndikoyom enye emi osopde? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Ndien, edieke enye okutde enye, enye eyedara abaña enye akan anañ ye efutenañ emi mikesopke. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Kpasuk ntre, idighe uduak Ete mbufo ke enyọñ nte, kiet ke otu ñkpri emi akpatakde.”<verse eid="MAT 18:14" /></para>
  <para style="s1">Edahado Enọ Mmọ Efen</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Edieke eyen ete fo eduede fi, ka kowut enye ndudue esie suk fi ye enye ikpọñ. Edieke enye akpañde utọñ ọnọ fi, afo ama ada eyen ete fo enyene. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Edi edieke enye mikpañke utọñ inọ fi, da owo kiet mme iba efen dian ye idem ka, man ke inua mme ntiense iba mme ita kpukpru ikọ ọkpọsọñọ ada. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Edieke enye osuk etrede ndikpañ utọñ nnọ mmọ, men tiñ nọ ufọk Abasi; ndien enye ama esin ndikop uyo ufọk Abasi, da enye nte ekpedade enye emi akananam mikopke ikọ Abasi. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />Ami ntiñ akpanikọ nnọ mbufo nte, sededi emi mbufo ebọpde ke isọñ kpa ntre ke edibọp ke enyọñ, ndien sededi emi mbufo etatde ke isọñ, kpa ntre ke editat ke enyọñ.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />“Ami ntọñọ ntak ntiñ emi nnọ mbufo nte, edieke mbufo owo iba ke isọñ enyenede iwuk ebaña ñkpọ kiet ekededi emi mbufo ebeñede Ete Mi emi odude ke enyọñ, eyenam ñkpọ oro ọnọ mbufo. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Koro ebiet ekededi emi owo iba, mme ita esobode, ke enyiñ Mi, Ami ñyedu ke otu mmọ.”<verse eid="MAT 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Ekem Pita adaha etiene Enye onyuñ obup Enye ete, “Ọbọñ, ikafañ ke ami ñkpadahado nnọ eyen ete mi emi eduede mi? Ikatiaba?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Jisọs ama ọbọrọ enye ete, “Ami ndọhọ fi nte idighe ikatiaba, edi utim ata ye efuteba.”<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />“Ke ntre, ekeme ndida Obio Ubọñ Abasi ndomo ye Edidem emi ebierede ndinam ibat okuk ye ifin esie. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Ke ini enye ọtọñọde ndinam ibat okuk emi, ema eda owo isọn kiet edi emi akakamade enye ñkpọ nte tọsin ekpat okuk. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Sia enye mikekemeke ndisio isọn oro, eteufọk esie ama ọnọ uyo ete yak enyam enye, ye ñwan esie ye nditọ esie, ye kpukpru inyene esie eda esio isọn esie.” <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Ofin oro ama ọduọ ke iso eteufọk esie onyuñ atuak ibuot ọnọ enye, onyuñ ọdọhọ enye ete, “O, ete mbọk, nyene ime ye ami ndien ñyesio kpukpru isọn mi.<verse eid="MAT 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 18:27" />Ntem ke eteufọk esie okokop mbọm abaña enye, onyuñ ayak enye ọnyọñ, onyuñ adahado ọnọ enye ke isọn esie.”<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />“Edi kadaña emi owo oro ọkpọñde eteufọk esie, enye ama okokut eyen ufọk mmọ kiet emi akakamade enye okuk ikie, enye ama onyuñ omum enye ke itọñ, efik ekpere ndiwot enye, onyuñ ọdọhọ enye ete, ‘kpe mi se afo akamade mi!’<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />Owo oro ama ọduọ ọtọñọ edọñ onyuñ ekpe enye ubọk ete ‘Nyene ime ye ami ndien ñyekpe fi kpukpru.’ ”<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />Edi enyene okuk emi ikenyimeke ndibet. Enye ama anam emum akama isọn oro enyuñ esin ke ufọk ñkpọkọbi tutu enye ekpe okuk esie ofuri ofuri.<verse eid="MAT 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 18:31" />Mmọdo ke adaña emi nditọ ete esie ekekutde se iketibede, mmọ ema efuhọ eti eti, enyuñ emen eketiñ enọ eteufọk mmọ kpukpru se iketibede. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Ndien eteufọk ama okot enye edi, onyuñ ọdọhọ enye ete, afo idiọk eyen ufọk. Ami mma ndahado ke kpukpru isọn fo nnọ fi, koro afo ekebeñede mi, <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />nte, afo ñko ukpunyeneke mbọm unọ eyen ufọk mbufo kiet, kpa nte ami ñkenyenede ye afo.<verse eid="MAT 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 18:34" />Ndien eteufọk ama ayat esit ye enye, onyuñ ayak enye ọnọ esin ke ufọk ñkpọkọbi tutu enye osio ofuri isọn esie. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />Kpasuk ntre ke Ete Mi emi odude ke enyọñ edinam ye mbufo edieke mbufo esinde ke akpanikọ ndidahado nnọ nditọ ete mbufo ke ndudue mmọ ke ofuri esit.<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">Ndisio ke Ndọ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Edikem ke ini Jisọs ama ekekure nditiñ ikọ Esie, Enye ama ọkpọñ Kalili aka ke ñkanñkuk Judia emi odude ke edem inyañ Jọdan eken. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Akamba otu owo ema etiene Enye, ndien Enye ama ọkọk mmọ emi ekedọñọde.<verse eid="MAT 19:2" /></para>
  <para style="s1">Mmọ Eñwana Ndimum Enye</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Ndusuk mme Farisi ema edi ndidomo Enye nse. Mmọ ema ebup Enye ete, “Nte enen owo ndisio ñwan esie ke ndọ ke ntak kiet ekededi?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Enye ama ọbọrọ mmọ ete, “Nte mbufo ikotke ite ke enye emi okobotde owo okobot mmọ eren ye ñwan toto ke editọñọ, <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />ndien ke ntak emi, eyen eren eyekpọñ ete ye eka esie, ndien adiana ye ñwan esie, ndien mmọ mbiba eyekabade edi obuk kiet. <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Ke ntre mmọ idighe aba owo iba, edi eyedi obuk kiet. Ke ntem, se Abasi ama akadian, yak owo ndomokiet okudiañade.”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Mmọ ndien ebup Enye ete, “Nso ndien idi ntak emi Moses okowukde ete yak ewet ñwed usio ndọ enọ ñwan ndien esio enye ke ndọ?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Jisọs ama ọbọrọ mmọ ete, “Moses ama onyime mbufo esio iban mbufo ke ndọ oto ke ọkpọsọñ isọñesit mbufo. Edi ikedighe ntre ke editọñọ. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Edi ami ndọhọ mbufo nte, edieke owo ekededi osiode ñwan esie ke ndọ ke mitoho ke edisin efibe, edinyuñ idọde ñwan efen, enye esin efibe. Ndien owo emi ọdọde ñwan oro esiode ke ndọ, esin efibe.”<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Mme mbet Esie ema edọhọ Enye ete, “Edieke edide se idude ke ufọt eren owo ye ñwan esie edi oro, ifọnke owo ndidọ ndọ.”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Jisọs ama ọbọrọ ete, “Idighe kpukpru owo ekeme ndinyime ukpepñkpọ emi, ke mibọhọke mmọ emi Abasi ọnọde ukeme ndinyime, <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />koro ndusuk owo emana itọ eto idibi eka mmọ, ndusuk edi itọ eto ubọk owo, ndusuk enam idem mmọ itọ eto ke ntak Obio Ubọñ Abasi. Yak owo ekededi emi ekemede ndibọ ukpepñkpọ emi ọbọ.”<verse eid="MAT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Ema eda ñkpri nditọ esọk Jisọs man Enye odori mmọ ubọk onyuñ ọbọñ akam ọnọ mmọ. Edi mbet Esie ema esua enọ mmọ emi ekedade nditọ edi.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Jisọs ama ọdọhọ, ete, “Eyak ñkpri nditọ etiene Mi, ekukpan mmọ, koro Obio Ubọñ Abasi enyenede utọ mmọ emi.” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Ndien Enye ama odori mmọ ubọk onyuñ ọdiọñ mmọ mbemiso Enye ọkọkpọñ mmọ.<verse eid="MAT 19:15" /></para>
  <para style="s1">Owo Inyene Afiak Edem</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Ekem owo kiet ama ebine Jisọs onyuñ obup Enye ete, “Andikpep, nso eti ñkpọ ke ñkpanam man ñnyene nsinsi uwem?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Jisọs ama obup enye ete, “Ntaha afo obupde Mi abaña se ifọnde? Kiet kpọt kpọt odu emi ọfọnde. Edieke oyomde ndinyene nsinsi uwem, nim mme ewuhọ.”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Owo oro ama obup Enye ete, “Mme ewuhọ efe?” Jisọs ama ọbọrọ enye ete, “Kuwot owo, kusin efibe, kuyip inọ, kutie ntiense nsu, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />kpono usọ ye uka, nyuñ ma mbọhọiduñ fo nte idem fo.”<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Akparawa oro ama ọbọrọ Enye ete, “Mma nnenim kpukpru mme ewuhọ emi, nso efen ke ñkpenyene ndinam?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Jisọs ama ọbọrọ enye ete, “Edieke afo oyomde ndifọn mma, ka kanyam kpukpru inyene fo, ndien men okuk oro nọ mme ubuene, ndien afo eyenyene ekese inyene ke Obio Ubọñ Abasi. Ndien fiak di disaña ye Ami.” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Ndien ke akparawa oro ama okokop ikọ oro, enye ama adaha ọnyọñ ye mfuhọ, koro enye ekenyenede ediwak inyene.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Do ke Jisọs ọkọdọhọ mbet Esie ete, “Ami ntiñ akpanikọ nnọ mbufo nte ke edi ata ọkpọsọñ ñkpọ owo inyene ndiduk Obio Ubọñ Abasi. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Ami mfiak ndọhọ mbufo nte ke edi mmemmem ñkpọ enañ ndibe ke odudu abiabon akan owo inyene ndiduk Obio Ubọñ Abasi.”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Ndien ke ini mme mbet ekopde ikọ emi idem ama akpa mmọ eti eti, ndien mmọ ema ebup ete, “Anie ndien ke ekeme ndinyaña?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Edi Jisọs owuk enyin ese mmọ, onyuñ ọdọhọ mmọ ete, “Owo ikemeke ndinam emi, edi Abasi ekeme ndinam kpukpru ñkpọ.”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Do ke Pita ọkọdọhọ Enye ete, “Ñnyin ima ikpọñ kpukpru ñkpọ itiene Fi! Nso ndien ke ñnyin idinyene?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Jisọs ama ọdọhọ mmọ ete, “Ke akpanikọ ke ndọhọ mbufo nte ke ema enam kpukpru ñkpọ efiak edi obufa, ke ini Eyen Owo editiede ke ebekpo Ubọñ Esie ye uteñe ke enyọñ, mbufo emi etienede Mi ke eyo emi eyenyuñ etie ñko ke mme ebekpo duopeba ndikpe mme idut Isrel duopeba ikpe. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Ndien owo ekededi emi ọkpọñde ufọk esie, mme nditọ ete esie iren ye iban, mme ete, mme eka, mme nditọ, mme isọñ, ke ntak Mi, eyebọ utim ikikie, ndien enye eyenyuñ enyene nsinsi uwem. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Edi ediwak mmọ emi edide mme ebemiso ke emi, eyekpere edem, ndien mme ediwak mmọ emi ekperede edem idaha emi eyebe iso.”<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">Ñke mme Anam Utom ke Iñwañ Vain</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Koro Obio Ubọñ Abasi ebietde enyene iñwañ kiet, emi akabakde ọwọrọ ke usenubọk aka ndikpe mme anam utom nsin ke iñwañ esie. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Ndien ke enye ama ekenyime ete ke iyekpe mmọ okuk kiet ke ofuri usen utom kiet, enye ama ọdọñ mmọ eka ekenam utom.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />Nte enye ọkọwọrọde añwa ke ñkpọ nte ñkanika usukkiet usen ubọk, enye ama okut ndusuk mme owo ekedade ke añwa urua inyeneke se enamde. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Ndien Enye ama ọdọhọ mmọ ete, mbufo eka ñko ke iñwañ mi ekenam utom, ndien ami ñyekpe, mbufo nte odotde. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Ke ntre mmọ ema eka. Ke ufọt uwemeyo, ye ke ñkpọ nte ñkanika ita, enye ama afiak okot mbon efen, onyuñ ọdọhọ eka ñko ke iñwañ ekenam utom.<verse eid="MAT 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 20:6" />Ke ñkanika ition mbubreyo, enye ama afiak aka añwa urua ndien okokut mme irenowo efen nte edade do ntre. Enye ama obup mmọ ete, “mbufo eda didie ntre ebiat usen emi, inyeneke se enamde?”<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />Mmọ ema ebọrọ enye ete, “Koro owo ndomokiet ikekpehe ñnyin utom,” Enye ama ọdọhọ mmọ ete, “Eka ñko ke iñwañ mi ekenam utom.”<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Ke mbubreyo oro, enyene iñwañ ama ọdọhọ ese utom esie ete, kot mme anam utom edi, ñnyuñ kpe mmọ okuk mmọ, ọtọñọde ke mme ekperedem tutu osim mme ebem iso. <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Mme anam utom ekedade ke ñkanika ition ema edi ndien ema ekpe mmọ okuk silfa kiet. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Ke ntre, ke ini mbon emi ekebemde iso etọñọ utom ekedide ndibọ okuk, mmọ ema ekere ete ke mmimọ iyebọ okuk awak akan. Edi mmọ ekebọ kpa ukem okuk silfa kiet.<verse eid="MAT 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 20:11" />Ke mmọ ema ekebọ okuk mmọ, mmọ ema etọñọ ndikuni mbaña enyene iñwañ. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Mmọ emi ekpede utom akpatre, enam utom ñkpasip awa kiet kpọt edi ebọ okuk ukem nte mmimọ emi ikọtọñọde utom ọtọñọde ke usenubọk inyuñ inam utom ke idak ufiop eyo.<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />Enyene inwañ oro ama ọbọrọ kiet ke otu mmọ ete, “Ufan nsehe nte motuk fi, akam edi afo ekenyime ke idem fo ndibọ silfa kiet ke utom usen kiet. <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Da okuk utom fo nyọñ. Ami ñkemek ndinọ owo emi ñkekpede ukperedem ukem ukem nte ami nnọde fi. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Nte ami ñnyeneke unen ndinam ye okuk mi nte ami mmade? Mme afo ọdiọk esit koro ami mfọnde ido?” <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Ke ntre mmọ emi ekperede edem, eyebe iso, ndien mmọ emi ebede iso eyekpere edem.<verse eid="MAT 20:16" /></para>
  <para style="s1">Ada Usuñ Enyene Ndinam Ñkpọ Mmọ Eken</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Nte Jisọs akasañade ke usuñ aka Jerusalem, Enye ama ada mbet Esie duopeba esihede ada ñkañ kiet, onyuñ ọdọhọ mmọ ete, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />ñnyin ika Jerusalem, ndien eyetap Eyen owo enọ mme ikpọ oku ye mme andikpep ibet. Mmọ eyebiere ikpe ñkpa enọ Enye. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Ndien mmọ eyeyak Enye esin ke ubọk mme mmọ emi midighe Ju, ndien mmọ eyesak Enye, enyuñ emia Enye, enyuñ ekọñ Enye ke Krọs. Ndien ke ọyọhọ usen ita eyemenerede Enye ke ñkpa esin ke uwem.<verse eid="MAT 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Ekem eka nditọ iren Sebidi asaña ye nditọ iren esie ekebine Jisọs editọñọ edọñ ke iso Esie onyuñ anam ebeñe oto Enye.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Ndien Jisọs obup enye ete, “Nso ke afo oyom nnam nnọ fi?” Enye ama ọbọrọ ete, “Nyime ete ke nditọ iren mi iba emi, kiet eyetie ke ubọk nnasia Fo kiet ke ubọk ufien Fo ke Obio Ubọñ Fo.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Edi Jisọs ama ọdọhọ enye ete, “Afo ufiọkke se ebeñede.” Ntem ke enye ọkọwọñọde enyin ese Jems ye Jọn ndien obup mmọ ete, “Nte mbufo emekeme ndinwọñ kọb emi Ami ñkade ndiñwọñ?” Mmọ ema ebọrọ ete, “Ñnyin imekeme.”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Jisọs ama ọdọhọ mmọ ete, “ke akpanikọ mbufo eyeñwọñ eto ke kọb Mi, edi nditie ke ubọk nnasia Mi, ye ke ubọk ufien Mi, idighe Ami ñnyene ndinam emi. Mme itie emi enyene mmọ emi Ete Mi eketimde itie emi enim ọnọ mmọ.”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Mbet duop eken ema edu ke ọkpọsọñ iyaresit ke ini mmọ ekekopde se Jems ye Jọn ekebeñede Jisọs.<verse eid="MAT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 20:25" />Edi Jisọs ama okot kpukpru mmọ obon ebiet kiet onyuñ etiñ ete, “Mbufo emefiọk ete ke mme andikara mme idut ekara mmọ ke nsọñubọk, ikpọ owo mmọ enyuñ ebre odudu ye mmọ. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Inaha edi ntre ke otu mbufo. Owo ekededi eke oyomde ndikpon ñkan ke otu mbufo enyene ndidi asañautom mbufo. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Ndien owo emi oyomde ndidi adausuñ ke otu mbufo, enye enyene ndinam ñkpọ nnọ mbon eken nte ofin. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Kpa nte Eyen Owo mikedighe man enam ñkpọ enọ Enye, edi ekedi ndinam ñkpọ nnọ mme owo, ñnyuñ nnọ uwem Esie nte usio isop idiọkñkpọ nnọ ediwak owo.”<verse eid="MAT 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Nte Jisọs ye mbet Esie ekekpọñde obio Jeriko, akwa otu owo ema etiene mmọ ke edem.<verse eid="MAT 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 20:30" />Nnan iba eketie ke mben usuñ, ndien ke ini mmọ ekekopde ete ke Jisọs ke ededi ke usuñ oro, mmọ ema etọñọ ndifiori ete “Ọbọñ, Eyen Edidem Defid, tua ñnyin mbọm!”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Edi otu owo oro ema esua enọ mmọ enyuñ edọhọ mmọ ekibi inua, edi mmọ enenehede efiori ke ọkpọsọñ uyo, “Ọbọñ, tua ñnyin mbọm, Afo Eyen Edidem Defid.”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Ndien Jisọs ama atuak ada, onyuñ okot mmọ obup ete, “Nso ke mbufo eyom Mi nnam nnọ mbufo?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Mmọ ema ebọrọ Enye ete, “Ọbọñ iyom atat ñnyin enyin.”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Mbọm mmọ ama anam Jisọs, ndien Enye ama otuk mmọ enyin, ndien ndo ndo oro mmọ ema ekut usuñ, enyuñ etiene Enye.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">Jisọs Ọdọk Aka Jerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Nte Jisọs ye mbet Esie ekperede Jerusalem, mmọ ema edisim Betfek ke obot Ọlif; Jisọs ama ọdọñ mbet Esie iba, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />onyuñ ọdọhọ mmọ ete, “Eka ekeduk ke ekpri obio iñwañ emi adade ko ke iso ndien ema enyuñ ededuk mbufo eyekut ekpri enañ mbiomo eyirede ye eyen esie etat mmọ eda esọk Mi. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Edieke owo baba kiet obupde mbufo ñkpọ ekededi, ebọrọ enye ete ke edi Ọbọñ oyom mmọ, ndien enye eyeyak mmọ ọnọ mbufo ke usọp.”<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Ñkpọ emi akada itie man okosu ye se mme Asiak Uduak Abasi eketiñde enim ete, <verse eid="MAT 21:4" /><verse number="5" style="v" sid="MAT 21:5" />“Edọhọ eyenañwan Sayọn ete, sese Edidem mbufo kedi ebine mbufo, Enye edi ke nsuhọde idem, onyuñ awat ke enañ mbiomo, ye ke enyọñ eyen enañ mbiomo.”<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Mbet iba oro ema eka ekenyuñ enam nte Enye eketemede mmọ. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Mmọ ema eda enañ mbiomo ye eyen enañ mbiomo oro edi, ndien ebri mme ọfọñidem mmọ ke edem mmọ, ndien Jisọs ama ọdọk etie mmọ ke edem. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Ata akwa otu owo oro ema ebri mme ọfọñ idem mmọ ke ọkpọusuñ, ke ini ndusuk eken ekekpide mme ñkọk eto, ebon ke usuñ.<verse eid="MAT 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 21:9" />Mme otu owo emi ekebede Enye iso, ye mmọ emi eketienede Enye ke edem ema efiori ete, “Osana enyene Eyen Defid! Abasi ọdiọñ Enye emi edide ke Enyiñ Ọbọñ! Osana ke ata enyọñ!”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Ke ini Jisọs ama okoduk Jerusalem, ofuri obio ama otime ndien ema ebup ete, “Anie ededi emi?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Ndien otu owo ema ebọrọ ete, “Edi Jisọs, Asiak Uduak Abasi emi otode Nasaret ke Kalili.”<verse eid="MAT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Jisọs ama oduk ke Ufọk Abasi onyuñ ekebin kpukpru mmọ emi ekenyamde enyuñ edepde urua do osioño, ndien onuk okpokoro mme ọkpuhọ okuk ye ñkpọ itie mme anyam ibiom ọduọk.<verse eid="MAT 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 21:13" />Enye ama ọdọhọ mmọ ete, “Ema ewet ete, edikot ufọk Mi ufọk akam; edi mbufo emenam, enye akabade edi itie mbon ñwo.”<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Mme nnan ye mme mbuñọ ema edi ebine Enye ke edisana ebiet (temple) ndien Enye ama ọkọk mmọ kpukpru udọñọ mmọ. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Edi kadaña emi mme ikpọ oku ye mme andikpep ibet mme Ju ekekutde mme utibe ñkpọ emi Enye akanamde, enyuñ ekopde nte ñkpri nditọ ekefioride ete, “Ubọñ enyene Eyen Edidem Defid,” emi ama ayat mmọ esit eti eti.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />Mmọ ema ebup Enye ete, “Nte Afo omokop se ñkpri nditọ emi ekade iso ndifiori?” Jisọs ama ọbọrọ mmọ ete, “Ami mmokop.” “Nte akananam mbufo ikotke ke Edisana Ñwed Abasi, itie emi ewetde ete, ke inua ñkpri ye mme nsek nditọ afo omodot itoro.”<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Ndien Enye afiak ọnyọñ aka Betani, ebiet emi Enye akadañde tutu eyo esiere.<verse eid="MAT 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Ke usenubọk, nte Jisọs afiakde aka Jerusalem, biọñ ama ọdọñ Enye ke usuñ.<verse eid="MAT 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 21:19" />Ndien ke ini Enye okokutde eto fik kiet ke mben usuñ, Enye ama asaña ekpere eto emi edi Enye ikekwe mfri ke esit ke mibọhọke ikọñ ikpọñ, ndien Enye ama ọdọhọ eto oro ete, “Uduñwumke mfri aba!” Ndien ke ndo ndo oro eto fik oro ama eyemede akpa.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Ndien ke ini mme mbet ekekutde ñkpọ emi, idem ama akpa mmọ eti eti, mmọ enyuñ ebup ete, “Didie ke eto fik emi akpa iwiwa ntem?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Jisọs ama ọdọhọ mmọ ete, “Akpanikọ ke Ami ntiñ, edieke mbufo enyenede mbuọtidem, mminyuñ iyikke, idighe se ami nnamde ye eto fik emi ikpọñ ke mbufo edinam. Edi edieke mbufo edọhọde obot emi ete, ‘Wuhọde, ka koduk akwa akpainyañ,’ eyewọrọ osu ntre. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Edieke enimde ke akpanikọ, eyebọ ñkpọ kiet ekededi emi edibeñede ke akam.”<verse eid="MAT 21:22" /></para>
  <para style="s1">Mme Adausuñ Mme Ju Ekọk Mme Afia Mmọ</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Ke ini Jisọs ama akafiak oduk ke Ufọk Abasi, nte Enye akakade iso ndikpep ñkpọ, mme ikpọ oku ye mme ñyebiowo ema ebine Enye, enyuñ ebup Enye ete, “Nso unen ke afo enyene ndinam mme ñkpọ emi? Anie ọnọ fi odudu emi?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Jisọs ama ọbọrọ mmọ ete, “Ami ñyebup mbufo mbume kiet kpọt, ndien mbufo ema ebọrọ Mi, Ami nde ñyenyuñ ntiñ nnọ mbufo ebiet emi Ami ndade odudu nnam mme ñkpọ emi. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Babtisim Jọn okoto mmọñ? Okoto enyọñ mme okoto owo?” Ndien mmọ ema ekọk ibuot enyuñ edọhọ ete, “Edieke ñnyin idọhọde ite ke okoto Abasi, Enye eyebup ñnyin ndien ete, nsidi ntak emi mbufo mikenimke enye ke akpanikọ? <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Ndien edieke ñnyin ikañde ite ke idighe Abasi ọkọdọñ enye edi, ke okoto owo, ndik odu kabaña otu owo emi, koro kpukpru owo enimde ke akpanikọ nte ke Jọn ekedi Isuñutom Abasi.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Do mmọ ema ebọrọ Enye ete, “Ñnyin ifiọkke.” Ndien Enye ama ọdọhọ mmọ ete, “Ami ñko nditiñke nnọ mbufo odudu emi ndade nnam mme ñkpọ emi.”<verse eid="MAT 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“Edi nso ke mbufo ekere ebaña emi? Owo kiet ekenyene nditọ iren iba; ndien enye ọkọdọhọ akpan esie ete, ‘Eyen mi, ka iñwañ mi kanam utom mfin.’ ” <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />“Ndien enye ama ọbọrọ ete, ‘ami ndikaha,’ edi ke akpatre, enye akabade esit onyuñ aka akanam utom ke iñwañ usen oro.” <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />“Kpa ntre ke ete ọkọdọhọ udọ esie anam. Ndien enye ama ọbọrọ ete, ‘Ami ñyeka, Ọbọñ,’ edi enye ikenamke uyo ete esie.” <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />“Anie ke otu nditọ iba emi akanam se ete okoyomde ete enam?” Mmọ ema ebọrọ Enye ete, “Edi akpa eyen.” Jisọs ama ọdọhọ mmọ ete, “Ami ntiñ emi nnọ mbufo: mme ọbọ ataksi, ye mme iban akpara eyebem mbufo iso eduk Obio Ubọñ Abasi. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Koro Jọn Babtis ekedi ndiwut mbufo usuñ edinen ido, edi mbufo ikenimke enye ke akpanikọ, edi mme ọbọ ataksi ye mme iban akpara ema enim enye ke akpanikọ. Ndien kadaña emi mbufo ekekutde mmọ emi, mbufo ikekabakede esit inyuñ inim enye ke akpanikọ.”<verse eid="MAT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />“Ekpañ utọñ ekop ñke efen: Ete ufọk kiet okodu emi ọkọtọde iñwañ eto emi ekotde Vain, onyuñ ọbọp ọkọ akanade enye okuk, onyuñ otibi obube unyimi mmin (wain) ke esit, onyuñ ọbọp enyọñ itie ukpeme, onyuñ ayak ọnọ mme ọtọ iñwañ ke ukpe okuk, ndien enye aka anyan isañ.”<verse eid="MAT 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 21:34" />Ke ini ñkpeñe ekekemde, enye ama ọdọñ mme isuñutom esie ebine mme ekpeme iñwañ ekebọ udeme mfri esie. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Mme ekpeme iñwañ ema emum mme isuñutom esie, emia kiet, enyuñ ewot kiet, ndien etọñọ enyeken ke itiat.<verse eid="MAT 21:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 21:36" />Enyene iñwañ ọtọñọ ntak ọdọñ mme isuñutom esie efen emi ekewakde ekan mme ebemiso, edi mmọ ema enam ye mmọ kpasuk nte ekenamde ye mme mmọ eken. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Edi ke akpatre, enyene iñwañ ama ọdọñ eyen esie, onyuñ ekere ete ke mmọ eyekpono enye.<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />“Edi ke adaña emi mme ekpeme iñwañ ekekutde eyen esie edide, mmọ ema etiñ ke otu mmọ ete, Enye emi edi adia akpa iñwañ emi, eyak ñnyin iwot enye man ida akpa esie. <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Ntre ke mmọ ekeduri enye esio ke iñwañ enyuñ ewot enye.”<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />“Ke ntre ke ini enyene iñwañ editode isañ esie edi, mbufo ekere ete nso ke enye edinam ye mme ekpeme iñwañ oro?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Mmọ ema ebọrọ Enye ete, “Enye eyewot mme idiọk owo oro onyuñ ayak iñwañ esie ọnọ mme ekpeme iñwañ efen emi edikpede enye utib iñwañ esie ke ñkem ñkem ini.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Jisọs ama obup mmọ ete, “Akananam mbufo ikotke se ewetde ke ñwed Abasi, ete, ‘Itiat emi mme ọbọp ufọk ekesinde amakabade edi etubom itiat inuk; Ọbọñ anam emi, ndien edi utibe ñkpọ ke enyin ñnyin?’ ”<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />“Mmọdo Ami ndọhọ mbufo nte, eyebọ mbufo Obio Ubọñ Abasi ndien eyak enọ mmọ emi edisioñode nnen nnen mfri. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Owo ekededi emi ediduọde ke itiat emi, itiat eyekpok enye mbai mbai, edi owo emi itiat emi ediduọde ifik enye, eyekọk enye nte obu.”<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Kadaña emi mme ikpọ oku ye mme Farisi ekekopde mme ñke Jisọs, mmọ ema efiọk ete, ke Enye eketiñ mme ikọ emi abaña mmimọ. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Mmọ ema eyom ifet ndimum Enye, edi ndik ama anam mmọ ke ntak emi otu owo oro ekedade Jisọs nte Akwa oku.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">Se Obio Ubọñ Abasi Ebietde</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Jisọs ama ọtọñọ ntak etiñ ikọ ye mmọ ke ñke, ete, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Obio Ubọñ Abasi ebiet edidem kiet emi eketimde usọrọ ndọ ọnọ eyen esie eren. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Enye ama ọdọñ ikọt esie ekesian mme mmọ oro ekekotde, ete edi ke ini usọrọ ndo ekem. Edi mmọ ndomokiet ikedighe.” <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Ntre ke enye ọtọñọ ntak ọdọñ nditọ ufọk esie ekedọhọ mmọ oro ekekotde ete, “Sese, Mmanam udia mma, mma ñwot enañ mi ye mme unam emi esehede, kpukpru ñkpọ ebono ke itie, yak mmọ edi usọrọ ndo.”<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />Edi mme isenowo emi enye okokotde ema esin enye ke mbuburu enyuñ eka iso ndinam mme mbubehe mmọ; kiet aka iñwañ, eken aka urua esie. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Ndusuk mmọ emum mme isuñutom emi etuhọde enyuñ ewot mmọ.<verse eid="MAT 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7" />Edidem emi ama ayat esit onyuñ ọnọ mbio ekọñ esie ekewot kpukpru mme owot owo oro enyuñ efọp obio mmọ ofuri ofuri. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Ndien enye ama ọdọhọ nditọ ufọk esie ete, “Usọrọ ndọ ebeñe idem, ndien mbon emi ami ñkokotde edi, ikodotke ndidi. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Idahaemi ewọñọ eka ke mme efak ekekot owo kiet ekededi emi mbufo edikutde edi usọrọ ndọ emi.<verse eid="MAT 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 22:10" />Nditọ ufọk esie ema eka ekenam kpasuk nte enye eketemede, ndien mmọ ema eda kpukpru oruk owo emi mmọ ekekutde, nti ye ndiọi edi, ndien ufọk ọyọhọ fap ye isenowo.” <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />Edi ke ini edidem okodukde edi man edisobo ye mme isenowo esie, enye ama okut owo kiet emi mikesineke ọfọñidem ndo (emi ekenọde enye).<verse eid="MAT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 22:12" />Enye ama obup enye ete, “Ufan, asaña didie edidu mi ke ini afo musineke ọfọñidem ndọ?” Owo oro ikenyeneke ibọrọ ndomokiet.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />Ntem ke edidem ọkọdọhọ mme ekpeme ufọk usọrọ ete, “Ebọp enye ubọk ye ukot, ndien emen enye eketop eduọk ke akwa ekim ke añwa, ke ebiet emi eyet ye ntaedet odude. <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Koro ekekotde ediwak, edi ema emek ibad ibad owo.”<verse eid="MAT 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Do ke mme Farisi ekewọñọ ekesobo ọtọkiet enyuñ ekere usuñ nte editapde inyuñ imum Jisọs ito ikọ inua Esie. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Mmọ ema edọñ mme mbet mmọ ye mme mbon ñka Erọd ete ekebup Enye mbume emi: “Andikpep ñnyin imọfiọk ite ke Afo edi nnen nnen owo akpanikọ, onyuñ ekpep usuñ Abasi ke akpanikọ, Afo uyakke owo etimerede Fi koro Afo mudọñke enyin ke se owo edide. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Tiñ ndien nọ ñnyin, se idide ekikere Fo? Nte enen ndikpe taksi nnọ Sisa, mme inenke?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Edi Jisọs ama ọdiọñọ idiọk uduak mmọ, ndien ọdọhọ ete, “Mbufo mbio mbubik, nsinam mbufo eñwanade nditap Mi mmum?” <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Ewut Mi okuk emi edade ekpe taksi. Ndien mmọ ema eda okuk denariọs kiet esọk Enye, <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />ndien Enye ama obup mmọ ete, “Usio idem anie edi emi? Anie ewet mme ñwed emi?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Mmọ ema ebọrọ Enye ete, ke edi eke Sisa. Ndien Enye ama ọdọhọ mmọ ete, “Enọ Sisa se inyenede Sisa, enyuñ enọ Abasi se inyenede Abasi.”<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Ibọrọ Esie ama akpa mmọ idem eti eti, onyuñ afina mmọ ñko, ndien mmọ ema edaha ekpọñ Enye enyuñ enyọñọ.<verse eid="MAT 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Edi kpa ke usen oro, ndusuk mme Sadusi emi ekedọhọde ete ke ediset ke ñkpa idughe ema ebine Jisọs, enyuñ ebup Enye ete, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“Andikpep, Moses ọkọdọhọ ete, edieke owo akpade inyeneke nditọ, yak eyeneka esie ada ebekpa oro ọdọ, man enye obon nditọ ke enyiñ eyeneka esie. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Ñnyin ima inyene kiet ke otu ñnyin emi ekenyenede nditọ eka irenowo itiaba, ndien akpa ke otu mmọ ama ọdọ ñwan, ndien enye akpa ikenyeneke nditọ, ke ntre ebekpa oro amakabade edi ñwan eyeneka ọyọhọ iba. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Ntre ke ekedi ye udiana, ye ọyọhọ ita, tutu osim eyen eka ọyọhọ itiaba: <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Ke akpatre, ñwan oro ñko ama akpa. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Ke emi, ñwan anie owo ke enye edidi ke usen ediset ke ñkpa? Koro enye ekedide ñwan mmọ owo itiaba?”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Jisọs ama ọbọrọ mmọ ete “Ndudue mbufo oto ke unana edifiọk Ñwed Abasi ye odudu Abasi.” <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Koro ke ediset ke ñkpa owo ididọhọ ndọ, idinyuñ inọhọ owo ke ndọ, mmọ editie nte mme enjel ke Enyọñ. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Ke se itukde ediset ke ñkpa, nte mbufo ikekotke se Abasi eketiñde ye mbufo ete, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />“Ami ndi Abasi Ebraham, ye Aisik, ye eke Jekọb? Ke ntre Abasi idighe Abasi mme akpaña ñkpa, edi eke mme oduuwem.”<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Idem ama akpa ofuri otu owo eti eti kabaña ukpepñkpọ Esie. <verse eid="MAT 22:33" /><verse number="34" style="v" sid="MAT 22:34" />Edi ke ini emi mme Farisi ekekopde ete ke Jisọs ama okibi mme Sadusi inua, mmọ ema ebok idem oto kiet. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Ata ọfiọk ibet kiet ke otu mmọ, ama obup Jisọs ke etabi ete, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Andikpep, efe ewuhọ okpon akan ke otu mme ibet?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Jisọs ama ọbọrọ ete, “Ma Ọbọñ Abasi fo ke ofuri esit fo, ye ke ofuri ukpọñ fo, ye ke ofuri ekikere fo. <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Enye emi edi akpa ibet ye andikpon ñkan. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Ndien udiana aka ntem; ‘Ema mbọhọiduñ mbufo kpa nte emade idem mbufo.’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Kpukpru ofuri ibet ye se mme Asiak Uduak Abasi ekekpepde ekọñọ ke ibet iba emi.”<verse eid="MAT 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Ke ini mme Farisi ema ekeboho ke ebiet kiet, Jisọs ama obup mmọ ete, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“Mbufo ekere didie ebaña Kraist? Eyen anie owo ke Enye edi?” Mmọ ema ebọrọ Enye ete, “Enye edi Eyen Defid.”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Enye ama ọdọhọ ete, “nso inam ndien Defid okokotde Enye oto nda usuñ Spirit, ‘Ọbọñ! Koro Defid ọkọdọhọ ntem ete,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />Abasi ọkọdọhọ Ọbọñ mi ete:</para>
  <para style="q2" vid="MAT 22:44">Tie mi ke ubọk nnasia mi</para>
  <para style="q1" vid="MAT 22:44">tutu nda mme asua Fo</para>
  <para style="q2" vid="MAT 22:44">ke idak ukot Fo.<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Edieke Defid okotde Enye Ọbọñ, Enye ekeme didie ndien ndidi eyen esie?’ ”<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Owo ndomokiet ikekemeke ndinyene se enye ọkpọbọrọde ndien ọtọñọde ke usen oro aka iso, owo ndomokiet ikenyeneke uko ndibup Enye baba mbume ndomokiet.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">Ebiet Emi Mme Farisi Ekenamde Ndudue</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Ekem Jisọs ama ọdọhọ mme otu owo ye mme mbet Esie ete, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“Mme andikpep ibet ye mme Farisi etie ke ifum Moses. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Ke ntem mbufo enyene ndisuk ibuot nnọ mmọ ñnyuñ nnam kpukpru se mmọ etiñde enọ mbufo, edi ekunam se mmọ enamde, koro mmọ misinke ke edinam se mmọ ekwọrọde. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Mmọ ebọp ndodobi mbiomo edori mme owo ke afara, edi mmọ ke idem mmọ ibeñeke idem ndibiom ndomokiet.”<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />“Edi mmọ enam kpukpru utom mmọ man enyin mme owo ekut. Mmọ enam ekpat udim ikọ Abasi emi mmọ ebọpde ke ekoiso ye ke afara okpon, enyuñ eyiri ñnyan mmanima ke isọñ ewura mmọ. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Enyuñ ema itie ukpono ke itie usọrọ ye mme akpan itie ke mme ufọk ukpepñkpọ mme Ju. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Mmọ ema ekọm mmọ ke añwa urua, eyom mme owo ekot mmọ mme andikpep. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Edi inaha ekot mbufo ‘Andikpep’ koro mbufo enyenede Andikpep kiet, ndien mbufo edi nditọ ete. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Ndien ekukot owo ndomokiet ‘ete,’ ke isọñ, koro mbufo enyenede Ete kiet emi odude ke enyọñ. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Ekunyuñ eyak ekot mbufo mme mbuot, koro ibuot mbufo edide kiet kpa Kraist ikpọñ ikpọñ,<verse eid="MAT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 23:11" />Enye emi okponde akan ke otu mbufo enyene ndidi anam ñkpọ nnọ mbufo eken. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Koro owo emi edimenerede idem esie eyesuhọrede enye, ndien owo emi edisuhọrede idem esie, eyemenerede enye ke enyọñ.”<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“Edi ọdọdiọk ọnọ mbufo mme andikpep mme Ju ye mme Farisi mbon mbubik, koro mbufo eberide usuñ Obio Ubọñ Abasi ebaha mme owo. Mbufo ke idem mbufo idukke, inyuñ iyakke mmọ emi eyomde ndiduk eduk. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Ọdọdiọk ọnọ mbufo mme andikpep ibet ye mme Farisi! Mbufo mbon mbubik! Mbufo eduk ebume ufọk mme ebekpa, ndien ke nditaña ase, mbufo ebọñ ñnyan akam. Ke ntak emi ufen mbufo eyedobi eti eti.” <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />Ọdọdiọk ọnọ mbufo mme ekpep ibet ye mme Farisi, mbon mbubik, koro mbufo ekañade inyañ ye obot ke ndinam owo kiet akabade esit etiene mbufo, ndien ke enye amakabade edi kiet ke otu mbufo, mbufo enam enye odot ndika ikañ ndutuhọ utim ikaba akan nte mbufo edide.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Ọdọdiọk ọnọ mbufo mme nnan ada owo usuñ, ke emi edọhọde ete ke owo otomo itie ukpono inamke enye ñkpọ; edi owo ekededi emi otomode gold emi odude ke itie ukpono, uñwọñọ omum enye. <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Mbufo mme nnan ndisime, ewe okpon akan, gold mme itie ukpono emi anamde gold edi edisana? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Mbufo enyuñ edọhọ ete ke owo ada uñwọñọ ke enyiñ itie uwa ke ñkpọ iduhọ; edi owo ekededi emi adade uñwọñọ ke enọ emi anade ke itie uwa, uñwọñọ oro omum enye. <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Mbufo mme nnan, ewe okpon akan, enọ itie uwa mme itie uwa, emi anamde enọ edi edisana? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Ke ntre, enyemi ọñwọñọde ke enyiñ itie uwa, ọñwọñọ ke enyiñ itie uwa ye kpukpru mme ñkpọ emi ebonode ke esit. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Ndien enyemi ọñwọñọde uñwọñọ ke enyiñ itie ukpono, ọñwọñọ ke enyiñ itie ukpono ye ke enyiñ enyemi oduñde ke itie ukpono. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Ndien enyemi ọñwọñọde ke ikpaenyọñ ọñwọñọ ke enyiñ ebekpo Abasi ye ke enyiñ Enyemi etiede ke esit.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />“Ọdọdiọk ọnọ mbufo mme andikpep ibet ye mme Farisi, mbufo mbon mbubik, koro mbufo ekpede ubak kiet ke mbak duop ke mme ikọñ ikọt iñwañ mbufo, ye mme mfri iñwañ eken edi efumi mme idem akpan ñkpọ ke ibet nte, edikpe unen, mbọm, ye edinam akpanikọ. Akpana enam mme ukperedem ñkpọ emi, ekunyuñ efumi mme akpa oro ñko. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Mme nnan ada usuñ! Mbufo eduhọde nsuñ ke ediñwọñ ñkpọ mbufo esio, ndien emen enañ emi ekotde Kamel esin ke idibi.”<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“Ọdọdiọk ọnọ mbufo mme andikpep ibet ye mme Farisi, mbon mbubik, koro mbufo eyetde edem ọkọb ye edem usan asana edi ke esit mmọ eyọhọ ye ñwo ye unana mfat ke idem. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Mbufo nnan Farisi! Ebem iso eyet esit ọkọb ndien ofuri edem ọkọb eyesana.”<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />“Ọdọdiọk ọnọ mbufo mme andikpep ibet ye mme Farisi, mbon mbubik, koro mbufo ebietde mme udi emi eyetde afia ñkpọ ke enyọñ esie emi anamde enye eye, edi ke esit esie edi okpo mme akpaña ñkpa ye mme ndedehe ñkpọ eyọhọ. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Ntre ñko, mbufo etie nte nti owo ke enyin mme owo, edi ke esit mbufo edi mbubik ye oburobut ido eyọhọ.”<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“Ọdọdiọk ọnọ mbufo mme andikpep ibet ye mme Farisi, mbon mbubik, koro mbufo ebotde udi mme Asiak Uduak Abasi, enyuñ enamde udi ndinen owo eye.<verse eid="MAT 23:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 23:30" />Ndien edọhọ ete, ‘edieke ñnyin ikpekodude ke eyo mme ete ñnyin, ñnyin ikpebuanake ye mmọ ke ndiduọk iyip mme isuñutom Abasi.’<verse eid="MAT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 23:31" />Ke ntem mbufo etie ntiense ebaña idem mbufo nte, ke mmimọ idi nditọ mmọ emi ekewotde mme isuñutom Abasi. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Ọfọn ama, mbufo enam ndien udomo idiọkñkpọ mme ete ete mbufo ọyọhọ, ke edinam se mmọ eketọñọde okure!” <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />“Mbufo mme urukikọt, ye nditọ ibọm, didie ke mbufo edibọhọ utib ikpe itie ndutuhọ?<verse eid="MAT 23:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 23:34" />Sese Ami ke ini Mi, mmọdọñ mme Asiak Uduak Abasi ye mme ọfiọkñkpọ owo, ye mme andikpep nnọ mbufo. Mbufo eyewot ndusuk mmọ, enyuñ ekọñ mmọ ke Krọs, ndusuk mmọ mbufo eyemia ke itie ukpepñkpọ mbufo, eyenyuñ ekọbọ enyuñ ebine mmọ ke obio ke obio. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Man ofuri iyip ndinen owo emi ekeduọkde ke isọñ ọtọñọde ke iyip edinen Ebel, tutu osim iyip Sakaraya eyen Barakia, emi mbufo ekewotde ke ufọt itie ukpono ye itie uwa, ọsọp mbufo. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Akpanikọ ke ntiñ nnọ mbufo, ufen kpukpru mme ñkpọ emi eyetiene emana emi.”<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“O Jerusalem, Jerusalem, afo emi owotde mme oku onyuñ ọtọñọ kpukpru mmọ emi Abasi ọkọdọñde ọnọ fi ke itiat. Ikafañ ke Ami ñkatat ubọk Mi ndifuk kpukpru ikọt fo, kpa nte eka unen obokde nditọ esie ke idak mba esie, edi mbufo iyakke Mi nnam ntre? <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Ndien idahaemi eyak ufọk mbufo enọ ke ñwure. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Koro ndọhọ mbufo nte, mbufo idikwe Mi aba, tutu mbufo edọhọ ete, ‘ọfọfọn ọnọ Enye emi edide ke enyiñ Ọbọñ.’ ”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">Jisọs Ese Ini Iso</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Nte Jisọs osuk asañade ọwọrọ ọkpọñ añwa itie ukpono, mbet Esie esaña etiene Enye, enyuñ eyom ndida Enye nsaña ñkanade nse kpukpru esit ufọk emi edude ke itie ukpono.<verse eid="MAT 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 24:2" />Edi Enye ama ọdọhọ mmọ ete, “Nte mbufo emekut kpukpru ñkpọ emi? Ami ntiñ akpanikọ nnọ mbufo nte, ke idiyakke itiat ndomokiet odoro ke eken, eyedoñode kiet kiet eduọñọ.”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Nte Jisọs etiede ke obot Ọlif, mme mbet Esie edi edibup Enye ke ndibe, ete, “Tiñ nọ ñnyin ini emi mme ñkpọ emi editibede, ye se ididide idiọñọ edidi fo ye eke utit ini.”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Jisọs ama ọbọrọ mmọ ete, “Ekpeme, ekuyak owo ndomokiet abiaña mbufo. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Koro ediwak owo eyedi ke enyiñ Mi, enyuñ edọhọ ete, ‘Ami ndi Kraist oro,’ ndien mmọ eyebiaña ediwak owo. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Mbufo eyekop ebaña ekọñ ñkpet-ñkpet, ye uyom ekọñ ke anyan ebiet, edi, ekuyak ndik anam mbufo. Mme ñkpọ ntem enyene nditibe, edi mmọ iwutke nte ke utit ini edisim. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Mme idut eyeñwana ye idem mmọ, mme ndidem eyeñwana ye idem mmọ, ndien akañ ye unyekisọñ eyedu ke ediwak itie. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Kpukpru mme ñkpọ emi edi akpa ntọñọ ubiak uman.”<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />“Ndien mmọ eyemum mbufo eyak enọ emia ufen enyuñ ewot. Ofuri mme idut eyesua mbufo ke ntak Mi. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Ediwak owo eyesana mbuọtidem mmọ ke ini oro eyak, mmọ eyetap kiet eken, enyuñ esua idem mmọ, <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />ndien ediwak mme nsu nsu oku eyedaha eda, enyuñ ebiaña ediwak owo. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Ke ntak emi idiọkñkpọ editọtde ke kpukpru ebiet, ima ediwak owo eyebit. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Edi owo eke ọsọñọde ada tutu osim utit eyenyaña enye.<verse eid="MAT 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 24:14" />Ndien eyekwọrọ Eti Mbuk emi abañade Obio Ubọñ Abasi ke ofuri ererimbot nte ñkpọ ntiense ọnọ ofuri ubon owo, do ndien, ke utit edidi.”<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“Ke ntre, ke ini mbufo ekutde mme mbubiam ñkpọ nsobo emi Asiak Uduak Abasi Daniel eketiñde abaña adade ke edisana ebiet, yak añwaña okot ñwed Abasi. <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Do yak mmọ emi edude ke Judia efeñe edọk mme ikpọ obot. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Yak mmọ emi edude ke mme ọkọm ufọk ekukpa ndisuhọde nduk esit ufọk ñkemen mme inyene mmọ. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Yak owo emi odude ke iñwañ okuka ufọk ndimen ọfọñidem esie.”<verse eid="MAT 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 24:19" />“Eyenyene ndik eti eti ke mme usen oro ye mme iban emi esañade ye idibi, ye mmọ emi ekamade nsek nditọ ke ubọk. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Ebọñ akam, itọk mbufo okudi ke ini ekarika mme ke usen ederi mme Ju. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Koro ọkpọsọñ ukut eyedu ke ini oro ke usuñ emi akananam miduhọ tọtọñọ ke ntọñọ ererimbot tutu osim ini emi, mbiet esie idinyuñ iduhodu.”<verse eid="MAT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 24:22" />“Edieke mikpakanamke mme usen oro emuhọ, baba owo ndomokiet ikpeduhọ uwem, edi ke ntak mmọ emi Abasi emekde eyenam mme usen oro emuhọ.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />Ke ini oro, owo ndomokiet ekpedọdọhọ mbufo ete, ‘Sese, Kraist oro mi,’ mme, ‘Se Enye ko,’ ekunim ke akpanikọ. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Koro mme nsu nsu kraist ye mme nsu nsu mme ọkwọrọ ikọ eyewọñọ ewut idem, ndien enyuñ enam mme ikpọ idiọñọ ye mme utibe ñkpọ ndibiaña mmọ emi emekde edieke emi ekpedide mmem mmem. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Sese Ami mmeduri mbufo utọñ ke eti ini.”<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />“Do edieke owo ndomokiet ọdọhọde ete, se Enye ko ke isọñ utatan, ekuwọrọ eka, mme ke edọhọde ete se Enye mi ke esit ubet, ekunim ke akpanikọ. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Koro kpa nte emireñ-mireñ otode ke usiahautin asiaha aka ke usoputin, kpa ntre ke edidi Eyen owo editie. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Ebiet ekededi emi okpo ñkpọ anade do ke mme utere eboho.”<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“Ndo ndo emi ukut mme usen oro edibede, utin eyeduk ekim, ndien ọfiọñ idiyamake aba, mme ntantaọfiọñ eyeduọñọ eto ikpa enyọñ, ndien eyenyuñ enyeñe mme odudu enyọñ.”<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />“Ke ini oro idiọñọ Eyen owo eyewọrọ ke ikpa enyọñ ndien kpukpru idut ke isọñ eyefuhọ. Mmọ eyekut Eyen Owo nte Enye edide ke obubit ikpa enyọñ, ye odudu ye akwa ubọñ. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Ndien Enye ọyọdọñ mme enjel Esie ye akwa uyo obukpoñ ukot owo, ndien mmọ eyetañ mme mmọ emi Enye emekde obok ke ituñ enyọñ mbinañ, otode ke ituñ enyọñ kiet tutu osim ituñ eken.”<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“Do ndien eda ukpepñkpọ eto eto Fik. Ini ekededi emi ñkpri ñkọk esie ememde, mme ikọñ esie enyuñ efiaride, mbufo eda oro ediọñọ ete ke ndaeyo ekpere. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Kpasuk ntre ñko ke ini mbufo edikutde kpukpru mme ñkpọ emi nte etọñọde nditibe, emekeme ndifiọk ete ke ini edidi Mi ekpere. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Ami ntiñ akpanikọ nnọ mbufo, nte, ke emana emi idibehe ifep, tutu mme ñkpọ emi ewọrọ esu.”<verse eid="MAT 24:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 24:35" />“Enyọñ ye isọñ eyebe efep, edi mme ikọ Mi idibehe ifep.” <verse eid="MAT 24:35" /><verse number="36" style="v" sid="MAT 24:36" />Baba owo ndomokiet idiọñọke ibaña usen oro mme ñkanika oro, tutu osim idem mme enjel ke enyọñ idiọñọke, kpa ye Eyen Owo nde, edi, edi Ete ikpọñ ikpọñ ọdiọñọ.<verse eid="MAT 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 24:37" />Nte ekedide ke mme usen Nua, kpa ntre ke edidi ke ini edidi Eyen Owo. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Koro ke mme usen emi ekebemde ukwọ iso, mme owo ke eketa enyuñ eñwọñ ñkpọ, ke ekedọ ndọ enyuñ enọ mme owo ke ndọ, tutu osim usen emi Nua okodukde ubom; <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />ndien mmọ ikọdiọñọke baba ñkpọ ndomokiet ibaña se iditibede tutu mmọñ ukwọ oto edikpọri mmọ efep.<verse eid="MAT 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 24:40" />Owo iba eyeda enam utom ke iñwañ, ndien eyemen kiet enyuñ ekpọñ eken. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Iban iba eyekọk ñkpọ ke ukọk ibokpot; eyemen kiet ekpọñ kiet.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />“Ke ntre edu ke ukpeme koro mbufo midioñọke usen emi Ọbọñ mbufo edidide.<verse eid="MAT 24:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 24:43" />Edi etim efiọk emi: Edieke enyene ufọk ọkpọdiọñọde ini emi inọ edidide ke okoneyo, enye ekpekpeme, ikponyuñ iyakke ebuñ ufọk esie eduk. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Ke ntre mbufo ñko enyene ndidu ke mbeñeidem, koro Eyen Owo eyedi ke ini ñkanika emi mbufo mikebeñeke idem inọ Enye.”<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“Anie ndien edi anam akpanikọ ye enyene ibuot eyen utom, ndi enye emi eteufọk esie ọnọde enye ubiọñ mme nditọ ufọk esie eken, ndinọ mmọ udia mmọ ke eti ini? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Eyefọn ye eyen utom oro, emi eteufọk esie edikutde nte enye anamde ntre ke enye ama ọnyọñ edi. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Ami ntiñ akpanikọ nnọ mbufo nte, ke eteufọk esie eyeyak ubiọñ kpukpru inyene esie esin enye ke ubọk.”<verse eid="MAT 24:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 24:48" />“Edi edieke eyen utom oro edide owo ibak onyuñ ọdọhọ ke esit esie, ete ‘Eteufọk mi eyebighi,’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />ndien enye ọtọñọ ndimia ekemọ nditọ ufọk, ndien adia onyuñ ọñwọñ ñkpọ ye mme akpaña mmin. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Ete ufọk esie eyedi ke usen emi enye mikebeñeke idem ibet enye ye ke ini ñkanika emi enye midiọñọke. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Enye eyekpok enye idem onyuñ ọnọ enye itie ye mme mbon mbubik, ke ebiet emi eyet ye ntaedet edidude.”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">Mme Mbuk Efen Etukde Obio Ubọñ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“Ekeme ndida Obio Ubọñ Abasi ndomo ye mbuk nditọ iban ndọ duop emi ekekamade mme utueneikañ mmọ eka ndisobo ye ebe ndọ. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Ition ke otu mmọ ekedi mme ọfiọkñkpọ ndien eken ekedi mme ndisime. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Mme ndisime ition oro ema ekama utueneikañ edi ikakamake aran efen ke ekpeme. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Edi mme ọfiọkñkpọ iban ition eken ema ekama aran ke ekpeme edian ye utueneikañ mmọ.<verse eid="MAT 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 25:5" />Ebe ndọ ama ebighi ndidi, do kpukpru mmọ ema eyet idap enyuñ ede.” <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />“Ke ufọt okoneyo, ema efiori ete, Sese Ebe ndọ mi, ewọñọ edisobo ye enye.”<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />“Ndien kpukpru nditọ iban emi ema edemere enyuñ ediọñ mme utueneikañ mmọ. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Mme ndisime ition oro ema edọhọ mme ọfiọk ñkpọ ition eken ete, ‘Enọ ñnyin aran mbufo esisit, koro utueneikañ ñnyin emọñ enime.’ ”<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />“Mme ọfiọkñkpọ ition oro ema ebọrọ mmọ ete, baba, koro se idude idikemke ñnyin ye mbufo. Ekam eka ke ebiet mme anyam aran ekedep nte eyomde.”<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />“Edi ke ini mmọ ekedude ke usuñ udep aran, Ebe ndọ ama edisim. Mme nditọ iban emi ekebeñede idem ebet ema etiene enye eduk ekebuana ke usọrọ ndọ, ndien ema eberi usuñ.”<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />“Ikebighike ikaha mme nditọ iban ition eken ema enyọñọ edi, enyuñ efiori ete, Ọbọñ, berede usuñ enọ ñnyin.”<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />“Edi enye ama ọbọrọ mmọ ete, ‘Ami ntiñ akpanikọ nnọ mbufo nte, ke ami ndiọñọke mbufo.’ ”<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />“Ke ntre etaba idap enyuñ ekpeme koro mbufo mifiọkke usen mme ini ñkanika.<verse eid="MAT 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Ñko ekeme ndida Obio Ubọñ Abasi ndomo ye owo emi okoyomde ndika isañ ke anyan idut, ndien enye ama okot mme nditọ ufọk esie, onyuñ ayak ubiọñ mme inyene esie esin mmọ ke ubọk.”<verse eid="MAT 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 25:15" />“Enye ama ọnọ owo kiet bọn ition, ndien ọnọ efen bọn iba, ndien enye ama ọnọ akpatre owo bọn kiet, enye ọkọnọ mmọ etiene nte ukeme mmọ kiet kiet ekedide. Ndien enye ama adaha esie. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Owo emi ọkọbọde bọn ition ama ọtọñọ ke ndo ndo oro ndida okuk oro ndep ñkpọ ñnyuñ ñnyam, ndien ikebighike enye ama anam udori bọn ition odori. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Owo emi ọkọbọde bọn iba onyuñ ada esie ini kiet ọtọñọ urua ñko, onyuñ adia udori bọn iba odori.<verse eid="MAT 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 25:18" />Edi owo emi ọkọbọde bọn kiet ama otibi isọñ obuk okuk eteufọk esie.”<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“Ekem ke anyan ini ama ekebe, eteufọk mmọ ama ọnyọñ isañ esie edi, ndien ama okot mmọ ete edi edinam ibat okuk esie enọ enye. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Owo emi enye ọkọnọde bọn ition ama ada bọn duop ọsọk enye, onyuñ ọdọhọ enye ete; ‘Ete ufọk, afo ọkọnọ mi bọn ition, ndien ami madia udori ition ndori.’ ”<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />“Ete ufọk esie ama otoro enye eti eti ke eti utom esie, onyuñ ọdọhọ enye ete ‘amanam akpanikọ ke ekpri okuk emi; ke ntre idahaemi ñyenọ fi ediwak ñkpọ efen ekpeme. Di dibuana ke idara eteufọk fo.’ ”<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />“Enye emi ọkọbọde bọn iba onyuñ edi, onyuñ ọdọhọ ete, ‘Ete ufọk, afo ọkọnọ mi bọn iba, se madia udori bọn iba ndori.’ ”<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />“Ete ufọk esie ama ọbọrọ enye ete, ‘amanam eti eti, afo eti asañautom ye owo akpanikọ. Afo amanam akpanikọ ke ata ekpri okuk emi, ntre ami ñyenọ fi ubiọñ ediwak ñkpọ. Di dibuana ke idara eteufọk fo.’ ”<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />“Ekem owo emi ọkọbọde bọn kiet edi, onyuñ ọdọhọ, ete, ‘Ete ufọk, ami mma ndiọñọ nte ke afo edi owo emi ọsọñde ido, onyuñ ọdọkde ke ebiet emi afo mukọtọhọ, <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />onyuñ ọkọ ke ebiet emi afo mukasuanke ñkpasip. Ntem ami mma ñkop ndik, oro anam mma mmen okuk fo ñkebuk ke isọñ, sese se inyenede fi mi.’ ”<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />“Edi eteufọk esie ama ọbọrọ enye ete, ‘Afo idiọk owo ye owo ifu! Nte afo ama ọdiọñọ ete ke ami ndọk ke ebiet emi ami mme ñkọtọhọ, ñnyuñ ñkọ ke ebiet emi ami mme ñkesuanke ñkpasip? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Afo akpakakam emen okuk mi ekesin ke itie unim okuk man ami mma ñnyọñ ndi ami ñkpọbọ okuk mi ye udori.’ ” <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Ebọ owo emi okuk oro enyuñ enọ owo emi ekenyenede bọn duop. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Koro owo emi akamade se enọde enye ọfọn, eyemana edian enọ enye, man enye ọkọkọrọ enyene awak akan. Edi owo emi minamke akpanikọ, eyebọ enye idem ekpri emi enye ekenyenede. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Ndien etop anana udori eyen ufọk oro esio ke añwa, ke ekim, ke ebiet emi eyet ye ntaedet edidude.<verse eid="MAT 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“Edi ke ini Eyen Owo edidide ke ubọñ Esie ye kpukpru mme enjel esie, Enye eyetie ke ebekpo Esie, emi ọyọhọde ye ubọñ enyọñ. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Kpukpru idut eyesobo ke iso Esie, ndien Enye eyebahade mme owo osio kiet ke eken nte ekpeme erọñ abaharede erọñ osioño ke otu mme ebot. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Enye eyenim mme erọñ ke ubọk nnasia Esie ndien mme ebot ke ufien Esie.”<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />“Ndien Edidem eyedọhọ mmọ emi edude ke ubọk nnasia Esie ete, ‘Edi, mbufo emi Ete Mi ama ọkọdiọñ, edida obio ubọñ emi ekebeñede enim enọ mbufo toto ke editọñọ ererimbot. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Koro biọñ ama ọdọñ Mi ndien mbufo ema enọ Mi udia, itọñ ama asat Mi, ndien mbufo ema enọ Mi mmọñ ññwọñ. Ñkedi esen, ndien mbufo ema eda Mi esin ke ufọk mbufo. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Ñkasaña iferi ndien mbufo ema esine Mi ọfọñ, Ami ñkọdọdọñọ ndien mbufo ema ese ñkpọ ebaña Mi, ñkedu ke ufọk ñkpọkọbi ndien mbufo edise Mi.’ ”<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />“Ntem kpukpru nti owo eyebọrọ ete, ‘Ete, ini ewe ke ñnyin ikokut nte biọñ ọdọñde Fi ndien inọ Fi udia? Mme nte itọñ akasatde Fi, ndien ñnyin inọ Fi mmọñ ọñwọñ. <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Ini ewe ke ikokut edide esen, ndien ñnyin iñwam Fi? Mme nte akasañade iferi ndien ñnyin isine Fi ọfọñ? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Ini ewe ke ñnyin ikokut nte ọdọñọde, mme odude ke ufọk ñkpọkọbi, ndien ñnyin idise Fi?’ ”<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />“Edidem eyebọrọ ete, ‘Ami ntiñ akpanikọ nnọ mbufo nte, se ededi emi mbufo ekenamde enọ usuhọde owo kiet ke otu nditọ Ete Mi, mbufo ekenam enọ Mi.’ ” <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />Ndien Enye eyedọhọ mmọ emi edude Enye ke ubọk ufien ete, Ediañade ekpọñ Mi, mbufo emi esuñide, eduk ke nsinsi ikañ emi ekebeñede enim enọ Andidiọk (setan) ye mme enjel esie. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Koro biọñ ama ọdọñ Mi ndien mbufo ikọnọhọ Mi udia, itọñ ama asat Mi ndien mbufo ikọnọhọ Mi mmọñ ññwọñ. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ñkedi esen, ndien mbufo ikadaha Mi iduk ufọk mbufo, mma nnana ọfọñidem ndien mbufo ikesineke Mi ọfọñ, ñkọdọdọñọ ñnyuñ nsine ke ufọk ñkpọkọbi ndien mbufo ikedighe idise Mi.<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />“Mmọ eyebọrọ ete, ‘Ọbọñ ini ewe ke ñnyin ikokut nte biọñ ọkọdọñde Fi mme nte itọñ akasatde Fi, mme nte ekedide esen, mme nte akasañade iferi, mme nte ọkọdọñọde, mme nte okodude ke ufọk ñkpọkọbi, ndien ñnyin isin ndiñwam Fi?’ ”<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />“Ndien Enye eyeboro ete, ‘Akpanikọ ke Ami ntiñ nnọ mbufo nte, sededi emi mbufo mikanamke inọ usuhọde owo kiet ke otu emi, mbufo ikenamke inọ Mi.’ ”<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />“Ndien mmọ emi eyeka ekeduk ke nsinsi ufen, edi, mme nti owo eyeduk ke nsinsi uwem.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">Etap Jisọs</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Ke ini Jisọs ama ekekure nditiñ mme ikọ emi, ye mme mbet Esie, Enye ama ọdọhọ mmọ, ete,<verse eid="MAT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 26:2" />“Nte mbufo ediọñọde ebaña, usọrọ ube inyañ eyetọñọ ke ñkpọ nte usen iba ke iso, ndien eyetap Eyen Owo eyak enọ ekọñ ke eto.”<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Kpasuk ke ukem ini oro mme ikpọ oku ye mme etubom mme Ju eken ema ekesobo ke ufọk Kaifas emi edide Akwa Oku. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Ndien mmọ ediomi nte edisañade imum Jisọs ke ñkari usuñ inyuñ iwot Enye <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Edi mmọ ema edọhọ ete, yak okudi ke ini usọrọ, midighe ntre, ntime eyekpon ke otu mme owo eti eti.<verse eid="MAT 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Ke ini Jisọs okodude ke Betani ke ufọk owo emi ediọñọde nte Saimọn ọdọñode akpamfia, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />ñwan kiet ama asaña ye ekpeme alabasta (enem utebe aran) emi ọsọñde urua eti eti, oduk etiene Enye, onyuñ ọtọhọ ọduọk Enye ke ibuot, ke itie udia.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Ke ini mme mbet Esie ekekutde emi, ikenemke mmọ esit. Do mmọ ema ebup ete, “Nso uto edibiat ñkpọ idi emi?” <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />“Ekeme ndikpanyam enem utebe aran emi ke ata ediwak okuk, enyuñ emen okuk oro enọ mme ubuene.”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Jisọs ama ọfiọk se mmọ ekekerede, ndien Enye ama ọdọhọ mmọ ete, “Nsidi ntak emi mbufo efinade ñwan emi? Enye amanam ediye ñkpọ ye Ami. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Mbufo eyesuk enyene mme ubuene kpukpru ini ke otu mbufo, edi mbufo idinyeneke Mi kpukpru ini. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Se enye akanamde ekedi ndiñwaña enem utebe aran oro nduọk Mi ke idem man enye ebeñe Mi abaña ini emi edibukde Mi. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Akpanikọ ke ndọhọ mbufo nte, ebiet ekededi emi ekwọrọde Eti Mbuk emi ke ofuri ererimbot, ana etiñ ebaña se enye akanamde, nte ñkpọ editi esie.”<verse eid="MAT 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Ndien kiet ke otu mbet duopeba, enye emi ekekotde Judas eyen Iskariọt, ama ebine ikpọ oku, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />ndien okobup mmọ ete, “Okuk ifañ ke mbufo edikpe mi edieke ndade Jisọs nsin mbufo ke ubọk?” Do ke mmọ ekesio okuk silfa edip ye duop enọ enye. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Ọtọñọde ke ini oro Judas ama ọtọñọ ndikpeme eti ifet man atap Jisọs ọnọ.<verse eid="MAT 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Ke akpa usen edinam usọrọ uyo emi ibọk ndom uyo miduhọ ke esit, mme mbet ema edi ebine Jisọs enyuñ ebup Enye, ete, “Mmọñ ke ñnyin idinam mbeñe idem ndidia usọrọ uyo emi ibọk ndom uyo miduhọ ke esit?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Enye ama ọbọrọ mmọ ete, “Eka ekeduk esit obio ndien mbufo eyekut ufọk ete kiet, ndien edọhọ enye ete, Andikpep ọdọhọ ete, lni emi ekenimde enọ Mi ekpere, Ami ñyom ndidia usọrọ Uwọrọufin ke ufọk fo ye mme mbet Mi.” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Ntre ke mbet Esie ekenyuñ ekenam kpa nte Enye eketemede mmọ, enyuñ etim mme ñkpọ ebeñe usọrọ uwọrọ ufin.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Ke mbubreyo oro, nte Enye eketiede ndidia ñkpọ ye mme mbet duopeba, <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />kadaña emi mmọ ekekade iso ndidia udia, Enye ama ọdọhọ ete, “Ke akpanikọ ke Ami ndọhọ mbufo, owo mbufo kiet eyetap Mi.”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Mmọ ema efuhọ eti eti, ndien etọñọ ndibup owo kiet kiet, ete, “Nte etiñ ye ami Ọbọñ?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Jisọs ama ọbọrọ ete, “Edi enye emi edebide ubọk esie ke usan kiet ye Ami editap Mi. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Eyen Owo eyekpa, kpa nte ekewetde ebaña Enye. Edi, ọdọdiọk ọnọ owo oro atapde Eyen Owo; akpakam ọfọn ye owo oro nte enye mikpemanakemana.”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Judas ñko ama obup Enye ete, “Andikpep, nte edi Ami?” Jisọs ama ọbọrọ enye ete “Edi afo.”<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Nte mmọ ekesuk ediade ñkpọ, Jisọs ama emen uyo, ndien ọnọ ekọm, onyuñ obuñ, ndien ọnọ mme mbet Esie, ọdọhọ ete, “Ebọ enyuñ eta, emi edi idem Mi.”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Ndien Enye ama emen kọb, onyuñ ọnọ Abasi ekọm, ndien ọnọ mmọ, ọdọhọ ete, “Eñwọñ kpukpru mbufo. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Koro emi edi Iyip Mi emi ọbọpde obufa Ediomi, emi eduọkde ebaña edifen mme idiọkñkpọ ediwak owo. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Ami ndiñwọñke nto mfri eto Vain aba ọtọñọde ke emi tutu osim usen emi ndiñwọñde ke obufa usuñ ye mbufo ke Obio Ubọñ Ete Mi.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Ndien ke ini mmọ ema ekekwọ ikwọ, mmọ ema ewọñọ eka obot Ọlif.<verse eid="MAT 26:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Ke ini oro, Jisọs ama ọdọhọ mmọ ete, “Ke okoneyo emi, kpukpru mbufo eyeduọñọ ekpọñ usuñ ke ntak Mi, koro ema ewet ete, Ami ñyewot ekpeme erọñ, ndien mme otu erọñ eyesuana.” <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Edi ke mma nset, Ami ñyebem mbufo iso ñka ñkoduk Kalili.<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Pita ama ọbọrọ ete, “Edieke kpukpru owo ediañarede ekpọñ Fi, ami ndidiañakede ñkpọñ Fi.”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Jisọs ama ọdọhọ enye ete, “Akpanikọ ke ntiñ nnọ fi nte kpa ke okoneyo emi, mbemiso ekikọ ọkpọk, afo eyekañ Mi utim ikata.”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Edi Pita eyire etiñ, ete, “Ekpededi ana nte ami ñkpa ye Afo, ami ndikañke Fi.” Ndien kpukpru mme mbet ema etiñ kpa ntre.<verse eid="MAT 26:35" /></para>
  <para style="s1">Jisọs Ọbọñ Akam</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Do, ke Jisọs akada mme mbet Esie aka ke ebiet emi ekotde Ketsemeni, onyuñ ọdọhọ mmọ ete, “Esuhọde etetie ebet Mi ke adañaemi Ami ñkade ndibọñ akam.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Enye ama ada Pita ye nditọ Sebidi iba, Jọn ye Jems, ndien Enye ama ọtọñọ ndiyọhọ ye mfuhọ ye mfina ke esit Esie.<verse eid="MAT 26:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 26:38" />Do ke Enye ọkọdọhọ mmọ ete, “Mfuhọ ofuk ukpọñ Mi tutu ekpere idaha ñkpa. Etie mi enyuñ ekpeme ye Ami.”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Enye ama asaña aka iso esisit, ndien ama ọduọ ofuk iso Esie ke isọñ, onyuñ ọbọñ akam ete, “Ete Mi, edieke edide mmemmem, yak ebọ Mi kọb enyemi. Edi idighe nte Ami nduakde, edi yak edi nte Afo aduakde.”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Do ke Enye akafiak ebine mme mbet Esie ndien okokut mmọ nte edede idap. Enye ama obup Pita ete, “Nte mbufo ikemeke nditie ñkpeme eyo ye Ami ke ñkpọ nte awa ñkanika kiet? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Etaba idap enyuñ ebọñ akam, man mbufo ediduọ eduk idomo. Spirit onyime, edi obukidem emem.”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Enye ama afiak ọyọhọ ikaba aka ọkọbọñ akam ete, “Ete Mi, edieke midighe mmem mmem ndibọ Mi kọb emi tutu Ami ññwọñ, yak enam uduak Fo.”<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Ke ini Enye afiakde edem edi Enye ama ọtọñọ ntak okut mmọ nte edede idap koro enyin mmọ ama odobi. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Ntre ke Enye ọkọkpọñ mmọ afiak aka ọkọbọñ akam ọyọhọ ikata osuk etiñ kpa nte Enye eketiñde ke akpa ifet.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Do ke Enye akafiak ebine mme mbet onyuñ ọdọhọ mmọ ete, “Nte mbufo ke edede idap enyuñ eduọk odudu? Sese, ini oro ekpere, ndien etap Eyen Owo esin ke ubọk mme anam idiọkñkpọ. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Edaha eda, eyak ñnyin ika. Sese anditap Mi mi, kedi.”<verse eid="MAT 26:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Kpa ke ini oro Enye okosuk etiñde ikọ, Judas, kiet ke otu mme mbet Esie duopeba, ama edisim. Enye akasaña ye ediwak mme owo emi ekekamade akañkañ, ye eto eñwan, emi Akwa Oku ye mme ikpọ owo mme Ju ekedọñde. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Mbemiso mmọ edisim anditap Enye ama ọnọnọ mmọ idiọñọ ete, “Enyemi ami nditimde inua edi owo oro, emum Enye.” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Ke ntre, Judas ama asaña nnen nnen ebine Jisọs ndien ọdọhọ Enye ete, “Ekọm do, Andikpep,” onyuñ otim Enye inua.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Jisọs ama ọdọhọ enye ete, “Ufan Mi, ka iso nam se afo ekedide ndinam.” Do ndien ke mme irenowo oro ekewọñọ emum Jisọs enyuñ eda Enye edaha; <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Kiet ke otu mmọ emi ekesañade ye Jisọs ama oduri akañkañ esie osio ke efọk onyuñ esibe eyen ufọk Akwa oku utọñ.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Jisọs ama ọdọhọ enye ete, “Sin akañkañ fo ke efọk esie, koro kpukpru mmọ emi emende akañkañ, eyekpa ke akañkañ. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Nte mbufo ekere ete, ke Ami ñkemeke ndikot Ete Mi, ndien Enye eyenọ se ikande mme enjel tọsin kiet ebine Mi ini kiet. <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Didie ndien ke ikọ Abasi emi ọdọhọde ete ke editibe ke usuñ emi, ediwọrọ isu?” <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />Ke ini oro Jisọs ama ọdọhọ otu owo ete, “Nte Ami ndi Enye emi ndade mbon nsọñibuot usuñ, esin mbufo ekama akañkañ ye eto eñwan edi ndimum Mi? Kpukpru usen Ami ñketie ke edisana ebiet mbufo ñkpep ñkpọ, ndien mbufo ikemumke Mi. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Edi emi eketibe man se mme Asiak Uduak Abasi ekewetde enim okposu.” Do ke kpukpru mme mbet ekesin Enye enyuñ efeñe ekpọñ Enye.<verse eid="MAT 26:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Mmọ emi ekemumde Jisọs ema eda Enye eka edem Kaifas, Akwa Oku, ke ebiet emi mme ekpep ibet ye mme mbuot ema ekebono ebet. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Edi Pita ama asaña nsan nsan etiene Enye, tutu ekesim añwa ufọk Akwa Oku. Enye ama oduk onyuñ ọsuhọde etetie ye mme ekpeme ukpeme, man enye okut se iditibede.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Mme ikpọ oku, ye kpukpru mme mbon akwa esop mme Ju ema etọñọ ndiyom mme ntiense nsu ebaña Jisọs man oto do mmọ ekeme ndiwot Enye. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Edi mmọ ikekwe ndomo kiet okposuk edi oro ediwak ntiense nsu ekewọñọde edi ndisu nsu edori Enye; ke akpatre owo iba ema ewọrọ edi, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />enyuñ edọhọ ete owo emi ọkọdọhọ ete, “Ami mmekeme ndiwuri ufọk ukpono Abasi emi, ndien mfiak mbọp enye ke usen ita.”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Do ke Akwa Oku akadaha ke enyọñ onyuñ obup Jisọs ete, “Nte Afo udubọrọke? Omokop mme ikọ ntiense emi etiñde edian Fi?”<verse eid="MAT 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MAT 26:63" />Edi Jisọs ikesioroke uyo. Ndien Akwa Oku ama ọdọhọ Enye ete, “Ami mowuk Fi ke uñwọñọ ke Enyiñ Odu Uwem Abasi: Tiñ nọ ñnyin mme Afo edi Kraist oro, emi edide Eyen Abasi?”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Jisọs ama ọbọrọ ete, “Edi ntre kpa nte mbufo etiñde. Edi Ami ndọhọ mbufo nte, ke ini iso mbufo eyekut Eyen Owo nte etiede ke ubọk nnasia Andikpon ñkan ndien onyuñ edide ke obubit ikpa enyọñ.” <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Ke ntak emi Akwa Oku ama awai ọfọñidem esie, onyuñ ofiori ete, “Osuñi Abasi! Ntaha ñnyin ndien ikpoyomde mme ntiense efen-e?” Mbufo emekop nte Enye esuenede Abasi. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Nso idi ekikere mbufo? Mmọ ema efiori ete, “Enye odot ñkpa.”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Do mmọ ema etọ Enye etap ke iso enyuñ etọ Enye ita. Ubak owo ema esiak Enye ufia, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />ndien ema edọhọ ete, “Kut ñkukut nọ ñnyin, Afo Kraist, Anie emia Fi?”<verse eid="MAT 26:68" /></para>
  <para style="s1">Pita Akañ Jisọs</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Ofuri ini oro Pita eketie ke esit okure, ndien ekpri eyen añwan ama asaña ebine enye onyuñ ọkọdọhọ enye ete, “Afo ñko okodu ye Jisọs, koro mbufo mbiba eto Kalili edi.”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Edi Pita ama akañ Enye ke ọkpọsọñ uyo ke iso mmọ kpukpru ete, “Ami ndiọñọke se afo etiñde abaña.”<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Do ke enye ọkọwọrọ aka ke inua otop ke ebiet emi ekpri eyen añwan efen ekekutde enye ndien ama ọdọhọ mme owo emi ekedude do, ete, “Se owo emi okodu ye Jisọs emi otode Nasaret.”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Pita amafiak akañ, ndien ama ọbọrọ ete, “Ami ntiñ ke idak uñwọñọ nte ke ami ndiọñọke owo oro!”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Ke esisit ini ama ekebe, mme owo emi ekedade do ema esaña ekpere Pita enyuñ edọhọ enye ete, “Ñnyin imọfiọk ite ke afo edi kiet ke otu mbet Esie, koro ñnyin imekeme nditiñ añwa añwa ite ke afo oto Kalili oto usuñ nte etiñde ikọ nte mbon Kalili.”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Pita ama ọtọñọ ndisuñi idem esie, onyuñ ada uñwọñọ ete, “Ami ndiọñọke owo oro.” Ndo ndo oro, ekikọ ama ọkpọk.<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />Ntem ke Pita eketi se Jisọs eketiñde: “Mbemiso ekikọ ọkpọk, afo eyekañ Mi ikata.” Ndien enye ama adaha ọwọrọ añwa akatua eyet ata eti eti.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">Ikpe Ye Ediwot</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Ke tughi tughi usenubọk mme ikpọ oku ye mme ikpọ owo mme Ju ema efiak esobo man ediomi, ebaña usuñ nte edisañade iwot Jisọs. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Mmọ ema eda Enye ye ñkpọkọbi ke ubọk esọk Pailet, ada ibuot ukara mbon Rom.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Ke ini Judas emi akatapde Jisọs okutde ete ke ebiere ikpe ñkpa enọ Jisọs enye ama ọkpuhọde ekikere esie onyuñ atua ñkpọfiọk abaña se enye akanamde ndien ama ada mbai silfa edip ye duop, okuk emi enye ọkọbọde, ọsọk mme ikpọ oku ye ikpọ owo mme Ju.<verse eid="MAT 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 27:4" />Enye ama ọdọhọ ete, “Ami mmanam idiọkñkpọ, koro ñkatapde iyip emi miduehe isop.” Mmọ ema ebọrọ enye ete, “Oro abuana nso ye ñnyin? Enye oro edi mbubehe fo.” <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Ntem ke Judas okotomo okuk oro ọduọñọ ke isọñ itie ukpono Abasi, ndien adaha ọwọrọ onyuñ ekeyire ke eto akpa. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Mme ikpọ oku ema etañ okuk oro enyuñ edọhọ ete, “Ñnyin ikemeke ndisin okuk emi ke otu okuk ñnyin, koro edide okuk iyip.”<verse eid="MAT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 27:7" />Mmọ ema eneme ebaña okuk emi, ndien ke akpatre mmọ ema ebiere ndidep ekpri isọñ emi esiode ndom ubot abañ, man eda enim nte udi ubuk isenowo. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Oro edi ntak emi ekotde isọñ oro, “Isọñ Iyip” tutu osim mfin emi.<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />Emi anam se Oku Abasi Jerimaya eketiñde osu: “Mmọ ekebọ okuk silfa edip ye duop, emi edide ekọm urua emi nditọ Isrel ekenyimede ndikpe ke ibuot esie, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />ndien mmọ ema edep isọñ ndom ubot abañ, nte Ọbọñ okowukde mi.”<verse eid="MAT 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Jisọs ama ada ke iso adaibuot ukara, Pailet, ndien Pailet ama obup Enye ete, “Nte Afo edi Ọbọñ mme Ju?” Jisọs ama ọbọrọ ete, “lh, edi kpa nte afo etiñde.”<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Edi Enye ikebọrọke ikọ ndomokiet ituk mme ikọ emi mme ikpọ oku ye mme ada idaha mme Ju ekedoride Enye.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Do ke Pailet okobup Enye ete, “Nte Afo ukopke kpukpru mme ñkpọ emi etiñde edori fi?”<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Edi Jisọs ikọbọrọke baba ikọ kiet, emi ama anam idem akpa ada ibuot ukara eti eti.<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ekesidi ido ada ibuot ukara ke ini usọrọ ndisana owo ñkpọkọbi kiet emi otu owo edimekde ñyak. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Ke ini oro mmọ ema enyene ata oburobut anam idiọkñkpọ kiet emi ekekotde Barabas. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Ndien ke ini otu owo ema ekeboho, Pailet ama obup mmọ ete, “Anie ke mbufo eyom mi nsana ñyak nnọ mbufo? Barabas, mme Jisọs emi ekotde Kraist?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Koro enye ama ọdiọñọ ke idem esie ete ke ekeyak Jisọs enọ imọ oto ke emi mmọ ekefubede Enye.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Kpa ke ini oro Pailet etiede ke ifum ukpe ikpe, ñwan esie ama ọnọ etop emi esọk enye: “Kunyene ñkpọ ndomokiet ndinam ye owo oro miduehe isop, koro ami mmokut ukut eti eti mfin ke ndap ke ntak Esie.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Edi mme ikpọ oku ye mme ada idaha ke otu mme Ju ema enyik otu owo ete yak mmọ edọhọ ete yak eyak Barabas, ndien ewot Jisọs. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Ndien ada ibuot ukara ọtọñọ ntak obup mmọ ete, “Anie ke otu owo iba emi ke mbufo eyom nsana ñyak nnọ mbufo?” Mmọ ema ebọrọ ete, “Barabas”.<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Ndien Pailet obup mmọ ete, edọhọ nnam didie ndien ye Jisọs emi ekotde Kraist? Mmọ kpukpru ema ebọrọ ete, “Kọñ Enye ke eto”.<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Do ke Pailet okobup mmọ ete, “Ntaha? Nso idiọkñkpọ ke Enye anam?” Edi mmọ etetim efiori ke ọkpọsọñ uyo ete, “Koñ Enye ke eto.”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Ke ini Pailet okokutde nte ke unyaña imọ idaha imọ ika baba ebiet kiet, utu ke oro edi ndutime ọkọtọñọ, enye ama ada mmọñ eyet ubọk esie mbiba ke iso otu owo, onyuñ ọdọhọ ete, “Ami mbuanake do ke iyip owo emi; emi edi mbiomo mbufo.”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Kpukpru owo ema ebọrọ ke uyo kiet, ete, “Yak iyip Esie ọkọbọ ñnyin ye mme nditọ ñnyin.”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Do ke enye akasana Barabas ayak ọnọ mmọ. Onyuñ amia Jisọs, ndien enye ayak Enye esin mmọ ke ubọk ete ekọñ Enye ke eto. <verse eid="MAT 27:26" /><verse number="27" style="v" sid="MAT 27:27" />Mbon ekọñ Pailet ema eda Jisọs eduk ke akwa ufọk ada ibuot ukara, ndien ofuri udim mbon ekọñ ekanade Enye ekuk. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Mmọ ema esioño Enye ọfọñ ke idem efep, enyuñ emen ididuot ewura esine Enye. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Ndien mmọ ema edọk anyanya ñkukim eyara Enye ke ibuot, enyuñ efak Enye esañ ke ubọk nnasia, ndien etọñọ edọñ ke iso Esie ke ido nsahi. Mmọ enyuñ edọhọ ete, “Itọñ uwem ọsọñ fi Edidem mme Ju.” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Ndien mmọ ema etọ Enye etap, ndien ebọ Enye esañ oro, enyuñ eda eyibi Enye ke ibuot kuyire kuyire.<verse eid="MAT 27:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 27:31" />Ke mmọ ema ekesak Enye ema, mmọ ema esio Enye ewura ndien efiak esine Enye mme ọfọñidem Esie. Ema eda Enye ndien eka ndikọñ ke eto. <verse eid="MAT 27:31" /><verse number="32" style="v" sid="MAT 27:32" />Edi nte mmọ ekesañade ke usuñ eka, mmọ ema ekesobo owo emi otode Sirin, emi ekekerede Saimọn, ndien mmọ ema enyik enye obiom etoñkpa. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Mmọ ema ekesim ebiet emi ekotde Kọlkọta (emi ọwọrọde ebiet ñkpọkpọrọ). <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Do ke mmọ ekenọ Enye mmin emi ekebuakde etidot ete ọñwọñ, edi ke Enye ama akatabi, Enye ama esin ndiñwọñ.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Ke mmọ ema ekekọñ Jisọs ke eto ema, mbon ekọñ ema esin afia enyuñ ebahade ọfọñidem Esie ke otu mmọ. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Ndien mmọ esuhọde etetie ekanade enyuñ ekpeme Enye nte ọkọñọde ke etoñkpa. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Ke ọkpọñde ibuot Esie esisit, mmọ ema ewet isọñ ikpe mmọ edian Enye:</para>
  <para style="pc" vid="MAT 27:37">
    <char style="sc">“EMI EDI JISỌS ỌBỌÑ MME JU.”</char><verse eid="MAT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />Ema ekọñ mme inọ iba ñko ye Enye, kiet ke ubọk nnasia Esie ye kiet ke ubọk ufien Esie. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Mme mmọ emi ekesañade ebe ema enyeñe ibuot mmọ enyuñ esuñi Jisọs enyuñ edọhọ ete, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />“Afo emi okoyomde ndiwuri edisana ebiet ñnyuñ ntọñọntak mbọp enye ke usen ita, nyaña idem fo edieke Afo edide Eyen Abasi! Suhọrede ke etoñkpa di.”<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Ke ukem usuñ oro, mme ikpọ oku, mme andikpep ibet, ye ikpọ mbuot obio ema etọ Enye ndọk. <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Enye akanyaña mmọ efen, edi Enye ikemeke ndinyaña idem Esie! Enye edi Edidem Isrel! Yak Enye ọsuhọde ke etoñkpa edi, ndien ñnyin iyenim Enye ke akpanikọ. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Enye odori enyin ke Abasi. Yak Abasi edifak Enye idahaemi edieke Enye oyomde Enye, koro Enye ọkọdọhọde ete, Ami ndi Eyen Abasi.”<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />Ke ukem ukem usuñ oro idem mme inọ emi ekekọñde ye Enye ema etiene esuñi Enye.<verse eid="MAT 27:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Ọtọñọde ke uwemeyo oro, ekim ama ofuk ofuri iso isọñ, emi ekebighide osim ñkpọ nte ñkanika ita uwemeyo.<verse eid="MAT 27:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 27:46" />Ke ñkpọ nte ñkanika ita uwemeyo, Jisọs ama ofiori ke ọkpọsọñ uyo ete, “Elai, Elai, Lema Sabaktani?” Emi ọwọrọ ete, “Abasi Mi, Abasi Mi, nsinam Afo ọkpọñde Mi?”<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Ndusuk mbon emi ekedade do ema ekop, enyuñ edọhọ ete, “Enye okot Elaiya.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Ndo ndo oro owo mmọ kiet ama efehe ekemen mfube ekedebi ke mmin emi ekerede vineka ndien emen afak ke eto, onyuñ emenerede ọnọ Jisọs ete ọñwọñ. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Edi mmọ eken ema edọhọ ete, “Sana Enye yak. Yak ñnyin ise mme Elaiya ọmọñ edinyaña Enye”.<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Ndien ke ini Jisọs ama akafiak ofiori ke ọkpọsọñ uyo, Enye ama ọduọk akpatre ibifik Esie. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Ke ndo ndo oro, ikpehe Edisana itie uwa ama asiaha ke mbak iba ọtọñọde ke enyọñ tutu osim isọñ, ndien isọñ enyek, mme itiat enyuñ esiaha, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />mme udi ekubọrede ndien mme ediwak ikọt Abasi emi ekekpañade ema etọñọ ntak eset ke ñkpa edu uwem. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Mmọ kpukpru ewọñọ ke mme udi, ndien ke Jisọs ama ekeset mmọ ema eduk ke edisana obio (Jerusalem) enyuñ ekewut mme ediwak owo idem mmọ.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Ke ini etubom ekọñ ye mme mmọ emi ekedude ye enye ekpeme Jisọs ekekutde unyekisọñ ye kpukpru se iketibede, ndik ama anam mmọ eti eti, ndien mmọ ema efiori ete, “Ke akpanikọ Enye ekedi Eyen Abasi!”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Ediwak iban ema edu do emi ekedade nsan nsan ese, mmọ eketiene Jisọs tọñọ ke Kalili ndise ñkpọ mbaña Enye. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Ke otu mmọ ekedi Meri Makdalin, ye Meri eka Jems ye Josef; ye eka Jems ye Jọn nditọ Sebidi.<verse eid="MAT 27:56" /></para>
  <para style="s1">Akpa, Ndien Ema Ebuk</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Ke ini osimde mbubreyo, enyeneñkpọ owo kiet emi okotode obio Arimatia, emi enyiñ esie ekerede Josef, kiet ke otu mme mbet Jisọs ama edi. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Enye ama adaha ebine Pailet onyuñ ekebeñe okpo Jisọs, ndien-Pailet ama ọnọ uyo ete esana eyak enọ enye, <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Josef ama emen okpo Jisọs, onyuñ awañ Enye ke edisana mmemmem ọfọñ, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />ndien onim Enye ke obufa udi esie emi enye okobotde ke itiat, onyuñ akpat itiat eberi ke inua udi, ndien enye ọnyọñ. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Meri Makdalin ye Meri enye eken esuk etie do esak iso ese udi.<verse eid="MAT 27:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Ke ndañ nsiere, emi eketienede usen mbeñeidem usọrọ uwọrọ ufin, mme ikpọ oku ye mme Farisi ema ebine Pailet, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />enyuñ edọhọ enye ete, “Ñnyin imeti ite ke ini owo abiaña oro okodude ke uwem, Enye ama ọdọhọ ete, ke usen ita ama ebe, Imọ iyeset. <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Ke ntre nọ uyo etim ekpeme udi tutu osim ọyọhọ usen ita, ke midighe ntre mme mbet Esie ekeme ndidi ediyip okpo Esie ndien edọhọ mme owo ete ke Enye ama eset. Akpatre abiaña emi eyediọk akan eke akpa.”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Pailet ama ọbọrọ mmọ, ete, “Eda owo ukpeme eka ekekpeme udi nte mbufo efefiọk ndinam.”<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Do mmọ ema eka ekenam idiọñọ mmọ do ke itiat, ndien ebon ukpeme ekanade ekuk.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">Enye Emeset!</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Ke Sabat ama ekebe, ke ñkpọusen, ke akpa usen urua emi edide Ederi, Meri Makdalin ye Meri eken ema eka ndise udi.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Ndo ndo oro, akwa unyek isọñ otibe, koro enjel Ọbọñ Abasi ọkọsuhọrede oto ke enyọñ edi ke isọñ edikpat itiat efep ke inua udi, onyuñ ọsuhọde etetie ke enyọñ esie. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Iso Esie akayama nte emireñ mireñ, edisine ñkpọ esie afia nte sno (snow). <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Mme ekpeme ukpeme ema ekop ndik eti eti, tutu mmọ ema ekabade etie nte mme akpaña ñkpa.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Enjel ama ọdọhọ mme iban oro ete, “Ekuyak ndik anam mbufo, sia ami mmọfiọk nte ke mbufo eyom Jisọs emi ekekọñde ke eto. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Enye idughe mi; Enye eset, kpasuk nte Enye ọkọdọhọde mbufo. Eduk edise ebiet emi okpo Esie akanade. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Ndien idahaemi, esọp eka ekedọhọ mbet Esie ete, ke Enye ama eset ke ñkpa ndien Enye ebem iso aka ke Kalili. Do ke mbufo edikut Enye. Se ñkenyenede nditiñ nnọ mbufo edi oro.”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Ke ntre iban emi ema ekpọñ udi usọp usọp ke ndik, edi ema eyọhọ ye akwa idara, ndien efeñe eka nditiñ nnọ mbet Esie. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Nte mmọ ekefeñede eka, ke unana idorenyin Jisọs ama osobo ye mmọ, onyuñ ọkọm mmọ ete, “Emem odu ye mbufo.” Ndien kpukpru mmọ eduọñọ ke isọñ ke iso Esie enyuñ emum Enye ukot, ndien etuak ibuot enọ Enye.<verse eid="MAT 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 28:10" />Do ke Jisọs ọkọdọhọ mmọ, ete, “Ekufehe ndik, eka ekedọhọ nditọ Ete Mi ete yak mmọ eka ke Kalili, ke ebiet emi mmọ edikutde Mi.”<verse eid="MAT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Adaña ini emi iban oro ekesuk edude ke usuñ, ubak mmọ emi ekekpemede udi ema esọp eduk ke obio eketiñ enọ mme ikpọ oku kpukpru se iketibede. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Mme ikpọ oku ema ekesobo ye mme ikpọ owo, ndien mmọ ema ebọp uduak mmọ; mmọ ema enọ mme mbon ekọñ ata ediwak okuk, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />ndien edọhọ mmọ ete, “Mbufo enyene ndidọhọ ete, ke mme mbet esie ekedi ke okoneyo ediyip okpo Esie ke adaña ini emi mmimọ ikedede idap.<verse eid="MAT 28:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 28:14" />Ndien edieke ada ibuot ukara okopde ikọ emi, ñnyin iyeyuhọ enye inyuñ isioño mbufo ke afanikọñ ifep.”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Ntre ke mme mbon ekọñ ekebọ okuk oro enyuñ enam nte eketemede mmọ. Ndien mbuk emi ama atara ọyọhọ ke otu mme Ju tutu osim idem mfin emi.<verse eid="MAT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Mme mbet duopekiet eken ema eka Kalili, ke obot emi Jisọs eketemede mmọ ndika. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Ke ini mmọ ekekutde Enye, mmọ ema etuak ibuot enọ Enye, okposuk edi emi ndusuk mmọ ekeyikde.<verse eid="MAT 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18" />Jisọs ama asaña ekpere mmọ, onyuñ ọdọhọ ete, “Enọ Mi kpukpru odudu ke enyọñ ye ke isọñ. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Mbufo eka ndien ebine kpukpru owo ke kpukpru ebiet, enyuñ enam mmọ edi mme mbet Mi: enim mmọ babtisim ke enyiñ Ete, ye ke enyiñ Eyen, ye ke enyiñ Edisana Spirit, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />ndien ekpep mmọ esuk ibuot enọ kpukpru mme ñkpọ emi Ami ñkewukde mbufo enam. Ndien Ami ñyedu ye mbufo kpukpru ini, tutu esim utit ini.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>