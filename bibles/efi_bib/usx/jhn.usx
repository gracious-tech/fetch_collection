  <para style="h">Jọn</para>
  <para style="toc1">Ñwed Jọn</para>
  <para style="toc2">Jọn</para>
  <para style="toc3">Jọn</para>
  <para style="mt1">Ñwed Jọn</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s1">Uñwana Ke Ekim</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />Ke editọñọ Ikọ okodu, ndien ikọ oro okodu ye Abasi. Ikọ oro okonyuñ edi Abasi. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />Enye (Ikọ) okodu ke editọñọ ye Abasi. <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />Abasi akanam kpukpru ñkpọ oto ke Enye. Ndien ke mikpotoho ke Enye ikpanamke baba ndomo ñkpọ kiet emi ekenamde. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />Uwem okodu ke Enye, ndien uwem emi ekedi uñwana ọnọ kpukpru owo. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />Uñwana emi ayama ke ekim, edi ntiense, nte ke Jisọs Kraist edi Uñwana emi, man oto ke Enye ekim ikemeke ndimen uñwana oro mfep.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Abasi ama ọdọñ isuñ Esie emi ekekerede Jọn. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Enye ekedi nditie ntiense, nte ke Jisọs Kraist edi Uñwana emi, man oto ke Enye kpukpru owo ekpenim ke akpanikọ. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Jọn ke idem esie ikedighe uñwana emi, enye ekedi nte ntiense kpọt ọnọ uñwana emi. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />Enye ekedi ata uñwana emi ayamade ọnọ kpukpru owo emi edukde edi ke ererimbot.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />Enye ama odu ke ererimbot, ndien okposuk edi emi ekebede ke Enye enam ererimbot, ererimbot ikọdiọñọke Enye. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />Enye ekedi etiene oruk esiemọ, edi oruk esiemọ ikenyimeke Enye. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />Edi kpukpru mmọ emi ekedarade Enye enyuñ enimde enyiñ Esie ke akpanikọ, Enye ama ọnọ mmọ unen ndikabade ndi nditọ Abasi; <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />mme nditọ emi emande itoho ke iyip, inyuñ itoho ke udọñitọñ obukidem, edi emana eto Abasi.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />Edi ikọ emi ama akabade edi obukidem, onyuñ oduñ ke otu ñnyin ke esisit ini ke ererimbot. Ñnyin inyuñ ikut ubọñ Esie, ubọñ ikpọñ Eyen emi okotode ke Ete ke enyọñ, emi ọyọhọde ye mfọn ye akpanikọ.<verse eid="JHN 1:14" /></para>
  <para style="s1">Jọn akanyan Ubọk Owut Jisọs</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />Jọn etiñ ikọ ntiense abaña Enye, onyuñ ofiori, ete, “Emi edi Enyemi ñketiñde mbaña nte, Enye emi etienede mi ke edem okpon akan mi, koro Enye ekebemde mi iso odu.” <verse eid="JHN 1:15" /><verse number="16" style="v" sid="JHN 1:16" />Kpukpru ñnyin imọbọ edidiọñ ikọrọ ye edidiọñ emi otode ke uyọhọ mfọn Esie. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Abasi ọkọnọ mme ibet oto Moses; edi mfọn ye akpanikọ eketo ke Jisọs Kraist. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Akananam owo baba kiet ikwe Abasi, ñkpasip Eyen Esie kierakiet, emi edide ukem nte Abasi, onyuñ etiede ke ñkañ Ete, Enye anam ñnyin idiọñọ kpukpru ñkpọ ibaña Ete.<verse eid="JHN 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Emi edi ikọ ntiense emi Jọn eketiñde kini mme ikpọ owo mme Ju ekedọñde mme oku ye mme udiana mmọ ke Jerusalem eka ekebup Jọn mme enye edi anie?<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />Enye ama akañ añwa añwa ete, “Ami ndighe Kraist.”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Mmọ ema ebup enye ete, “Ndien afo edi anie? Nte afo edi Elaiya?” Enye ama ọbọrọ ete, “Ami ndighe Elaiya.” “Nte afo edi Asiak Uduak Abasi?” Enye ama ọbọrọ ete, “Ami ndighe Asiak Uduak Abasi.”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Ke akpatre mmọ ema ebup enye ete, “Afo edi anie? Nọ ñnyin ibọrọ ida isọk mme mmọ emi ekedọñde ñnyin. Afo etiñ nso abaña idem fo?”<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Jọn ama ọbọrọ mmọ etiene nte se Prọfet Aisaya eketiñde, ete, “Ami ndi uyo andifiori ke akpa utatan, ete, eneñede usuñ Ọbọñ.”<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Ndien kpukpru mme mmọ emi mme Farisi ekedọñde, <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />ema edibup enye ete, “Ntaha afo enimde mme owo babtisim, edieke afo mudighe Andinyaña, mme Elaiya, mme Asiak Uduak Abasi-e?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />Jọn ama ọbọrọ mmọ ete, “Ami nda mmọñ nnim mbufo babtisim,” “edi owo odu ke ufọt mbufo idahaemi, emi mbufo midiọñọke. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Enye edi Enyemi etienede mi ke edem, emi ami mmendotke nditat uruk ikpaukot Esie.”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Ofuri mme ñkpọ emi eketibe ke Betani, obio emi odude ke edem inyañ akpa Jọdan eken, ke ebiet emi Jọn okonimde mme owo babtisim.<verse eid="JHN 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Ko ke ndañnsiere, Jọn ama okut Jisọs nte asañade ọbọiso ebine enye, ndien enye ama ọdọhọ ete, “Sese Eyenerọñ Abasi emi emende idiọkñkpọ ererimbot efep! <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Enye edi Enyemi ñketiñde mbaña ke ini ñkọdọhọde nte, ‘Owo emi etienede mi ke edem okpon akan mi, koro Enye ekebemde Mi iso odu.’ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Ami ke idem mi ñkọdiọñọke Enye edi ñkeka iso ndinim mme owo babtisim man ñyararede Enye ñwut esien Isrel.”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Ndien Jọn onyuñ ọnọ ikọ ntiense ete: “Ami mmañkut nte Edisana Spirit osuhọrede nte Ibiom oto enyọñ ọsọrọ Enye ke idem.<verse eid="JHN 1:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 1:33" />Tutu ye oro ami ñkọdiọñọke Enye, ke ebede emi ọkọdọñde mi nnim babtisim ke mmọñ, ama ọdọhọ mi ete, ‘Owo emi udukutde nte Spirit ọsuhọrede odoro enye ke idem, edi Enye edi Enyemi edinimde babtisim ke Edisana Spirit.’ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Ami mma ñnyuñ ñkut nte ñkpọ emi etibede, ñnyuñ ntie ntiense nte ke akpanikọ, emi edi Eyen Abasi.”<verse eid="JHN 1:34" /></para>
  <para style="s1">Jisọs Emek Mme Adañsaña</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Ke ndañnsiere, Jọn ama ada ye mbet esie iba. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Ke ini enye okutde Jisọs nte asañade ebe, enye ama ọdọhọ ete, “Sese Eyenerọñ Abasi!”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Ke ini mbet iba oro ekopde nte enye etiñde ntem, mmọ ewọñọde, enyuñ etiene Jisọs.<verse eid="JHN 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 1:38" />Jisọs ama ọwọñọde okut mmọ nte etienede Enye ndien Enye obup mmọ ete, “Mbufo eyom nso?” Mmọ ema ebọrọ ete, “Andikpep Afo oduñ ke mmọñ?”<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />Edi enye ama ọbọrọ mmọ ete, “Edi, edise.” Ke ntre mmọ ema etiene Enye ekediọñọ ebiet emi Enye oduñde, enyuñ ebiat usen oro ye Enye. Ekedi ñkpọ nte ñkanika inañ mbubreyo. <verse eid="JHN 1:39" /><verse number="40" style="v" sid="JHN 1:40" />Kiet ke otu owo iba emi ekekopde se Jọn eketiñde, onyuñ etienede Jisọs, ekedi Andru eyen eka Saimọn Pita.<verse eid="JHN 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 1:41" />Akpa ñkpọ emi Andru akanamde ekedi ndiyom eyen eka esie Saimọn, ndien ọdọhọ enye ete, “Ñnyin imokut Andinyaña emi edide Kraist.” <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Ndien enye ama ada Saimọn ọsọk Jisọs. Jisọs ama owuk enyin ese enye ndien ọdọhọ ete, “Afo edi Saimọn eyen Jọn. Eyekot fi Kefas” (emi ke edikabade ọwọrọ Pita) onyuñ ada ọnọ itiat.<verse eid="JHN 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Ke ndañnsiere, Jisọs ama ebiere ndika Kalili. Enye ama okut Filip, onyuñ ọdọhọ enye ete, “Tiene Mi.” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />Filip okoto Betsaida, obio kiet ye Andru ye Pita!<verse eid="JHN 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 1:45" />Filip ama okut Nataniel ndien ọdọhọ enye ete, “Ñnyin imọkut enyemi Moses ekewetde ñkpọ abaña ke ñwed ibet, emi mme Asiak Uduak Abasi ñko ekewetde ñkpọ ebaña. Enye edi Jisọs eyen Josef emi otode Nasaret.”<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Nataniel ama obup ete, “Nte baba eti ñkpọ ekeme ndito Nasaret?” Filip ama ọbọrọ enye ete, “Kam di dise.”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Ke ini Jisọs okutde nte Nataniel asañade ekpere, Enye ama etiñ ikọ otuk enye ete, “Sese ata eyen Isrel mi, emi nsu nsu ñkpọ ndomokiet miduhọ enye ke idem.”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Nataniel ama obup Enye ete, “Afo asaña didie ọdiọñọ mi?” Jisọs ama ọbọrọ enye ete, “Ami mma ñkut fi tọñọ ini emi afo okodude ke idak eto Fik mbemiso Filip okot fi.”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Ndien Nataniel ama ọdọhọ ete, “Andikpep, afo edi Eyen Abasi; Afo edi Edidem Isrel.”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />Jisọs ama ọdọhọ ete, “Idighe afo enim ke akpanikọ koro ñkọdọhọde fi nte ke mma ñkut fi ke idak eto Fik? Afo eyekut mme ikpọ ñkpọ emi akande oro.” <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Ndien Enye ama ọdọhọ mmọ ete, “Akpanikọ ke ntiñ nnọ mbufo, nte mbufo eyekut nte ikpaenyọñ ebererede, ye nte mme enjel Abasi edọkde enyuñ esuhọrede ke idem Eyen Owo.”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s1">Usọrọ Ndọ Ke Kenan</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Ke ọyọhọ usen ita, usọrọ ndọ ama odu ke Kenan ke Kalili. Eka Jisọs ama odu do, <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />ndien ema ekot Jisọs ye mme mbet Esie ñko ete edibuana ke usọrọ emi. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Ke ini wain ama okokure ke ufọt usọrọ, eka Jisọs ama ọdọhọ Enye ete, “Wain isuhọke aba inọ mmọ.”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Jisọs ama ọbọrọ enye ete, “Eka, ñkemeke ndinam baba ñkpọ kiet kaña ke emi, ini Ami ndinam utibe ñkpọ ikemke kaña.”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Ndien eka Jisọs ọdọhọ mme asañautom ete, “Enam se ededi emi Enye ọdọhọde mbufo ete enam.”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Ndien mme abañ mmọñ itiokiet emi edade itiat ebot ema ediọhọ ekpere do, nte asañade ekekem ye ido edinam idem asana mme Ju. Ndien abañ mmọñ kiet okoduk ñkpọ nte ekpeme mmọñ ikie ye ata, mme ikie ye anañ. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />Jisọs ama ọdọhọ mme asañautom ete, “Esin mmọñ eyọhọ ke mme abañ emi.” Mmọ ema esin mmọñ ọyọhọ ke mme abañ emi tutu osim inua mmọ. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />Ke ini mmọ ema ekekure, Enye ama ọdọhọ ete, “Ekoi ubak enyuñ emen esọk Etubom usọrọ.” Mmọ ema enam nte Enye ọkọdọhọde.<verse eid="JHN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 2:9" />Ndien ke ini Etubom usọrọ akatabide mmọñ emi ama akabade edi wain, enye ikọfiọkke ebiet emi wain emi otode, (edi mme asañautom emi ekekoide mmọñ ema efiọk). Do ke enye okokot ebendọ ada ñkañ kiet, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />onyuñ ọdọhọ enye ete, “Emi edi eti wain, afo amanam ọkpuhọde ye mbon efen. Etubom usọrọ esibem iso ọnọ isenowo ata eti wain, ndien ke ukperedem ke adañaemi kpukpru owo eyuhọde wain minyuñ iyomke aba efen, ndien enyene ndida wain emi minemke ndi. Edi afo ama onim inem wain tutu ke utit usọrọ emi.”<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Akpa utibe ñkpọ emi Jisọs akanamde ekedi ke Kena, obio emi odude ke Kalili. Enye ama ayarade Ubọñ Esie, ndien mbet Esie ebuọt idem ye Enye.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Ke usọrọ ndọ emi ama okokure, Jisọs ye Eka Esie, ye nditọ eka Esie, ye mme mbet Esie ema esuhọde eka ke Kapanọm, ndien ema edu do ke ñkpọ nte usen ifañ. <verse eid="JHN 2:12" /><verse number="13" style="v" sid="JHN 2:13" />Ndien ke usọrọ uwọrọ ufin mme Ju ama ekekpere, Jisọs ama ọdọk aka Jerusalem ndidia usọrọ oro.<verse eid="JHN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 2:14" />Ke esit okure Edisana Ebiet mme Ju, Enye ama okut mme anyam urua nte enyamde enañ, erọñ ye ibiom emi edade ewa uwa, ye mme ọkpuhọ okuk etiede ye okpokoro urua mmọ. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Jisọs ama ada uruk anam ikpa ndien ebin kpukpru mmọ osioño ke Edisana Ebiet oro, onyuñ ebin enañ ye mme erọñ osioño. Ndien Enye ama onuk okpokoro mme ọkpuhọ okuk onyuñ asuan kpukpru mme okuk mmọ ọduọñọ. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Ndien Enye ama asaña ekpere mme irenowo emi enyamde ibiom, onyuñ ọdọhọ mmọ ete, “Etañ kpukpru ñkpọ emi efep mi. Ekuda Ufọk Ete Mi enim itie urua.”<verse eid="JHN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 2:17" />Mme mbet Esie ema eti ebaña se ekewetde ke ñwed Abasi ete, “Ifiopesit ñnyenede nno ufọk Fo esak ke esit mi nte ikañ.”<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Ikpọ owo mme Ju ema ebup Enye ete, “Nso unen ke Afo enyene ndibin mmọ nsioño? Edieke Afo enyenede unen emi oto Abasi, nam utibe ñkpọ nte idiọñọ da sọñọ.”<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />Jisọs ama ọbọrọ mmọ ete, “Ọfọn, emi edi utibe ñkpọ emi ndinamde ñwut mbufo: Ewuri itie ukpono emi, ndien ke usen ita Ami ñyemenerede enye ñwuk.”<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />Mme Ju ema ebọrọ Enye ete, “Ekeda isua aba ye itiokiet ebọp Edisana Ebiet Ukpono Abasi emi, ndien Afo emekeme ndibọp enye ke usen ita?” <verse eid="JHN 2:20" /><verse number="21" style="v" sid="JHN 2:21" />Edi Edisana Ebiet Ukpono emi Enye eketiñde abaña ekedi Edisana Ikpọkidem Esie. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Ke Enye ama ekeset ke ñkpa mme mbet Esie ema eti se Enye eketiñde. Do ke mmọ ekenim ñwed Abasi ye mme ikọ emi Jisọs ekesitiñde ke akpanikọ.<verse eid="JHN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Ke ntak mme utibe ñkpọ emi Enye akanamde ke Jerusalem ke ini usọrọ uwọrọ ufin, mme Ju ye mme ediwak owo ema enim ke enyiñ Esie ke akpanikọ, nte ke Enye edi “Andinyaña.” <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Edi Jisọs ikeyakke idem Esie inọ mmọ, koro Enye otimde ọdiọñọ se mme owo edide. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Ikanaha owo baba kiet etiñ ọnọ Enye se owo edide, koro Enye ọdiọñọde se idude ke esit owo kiet kiet.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s1">Ndedibe Esenowo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Owo mme Farisi kiet ama odu emi ekekerede Nikodimọs, ada usuñ kiet ke esop ukara mme Ju. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Enye ama ebine Jisọs ke okoneyo, onyuñ ọkọdọhọ ete, “Andikpep, ñnyin imọfiọk ite ke afo edi Andikpep emi otode ke Abasi. Koro baba owo ndomokiet ikemeke ndinam mme utibe idiọñọ emi afo akade iso ndinam edieke Abasi midaha ye enye.” <verse eid="JHN 3:2" /><verse number="3" style="v" sid="JHN 3:3" />Jisọs ama ọbọrọ enye ete, “Ami nda ofuri esit mi ntiñ emi nnọ fi nte, ke osiode owo amana obufa, enye ikemeke ndikut Obio Ubọñ Abasi.”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Nikodimọs ama obup Enye ete, “Owo emi ama okokpon ama ekeme didie nditọñọ ntak mmana obufa? Eyighe iduhọ nte enye ikemeke nditọñọ ntak nduk eka esie idibi man enye ọtọñọ ntak amana ọyọhọ ikaba!”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Jisọs ọbọrọ enye ete, “Se Ami ntiñde emi edi akpanikọ, ibọhọke owo amana oto ke mmọñ ye Spirit enye ikemeke ndiduk Obio Ubọñ Abasi. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Owo amana oduk ererimbot oto Ete ye Eka, edi enye enyene emana Spirit oto ke Spirit. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Kuyak idem akpa fi ke emi ndọhọde fi nte, mbufo enyene ndimana obufa. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Ofum ofume aka nte enye amama; afo okop uyom emi enye anamde, edi afo udiọñọke ebiet emi enye otode edi mme ebiet emi enye akade. Ukem ukem ke edi ye owo kiet ekededi emi amanade oto Spirit.”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Nikodimọs obup Jisọs ete, “Ñkpọ ntem ekeme didie nditibe?”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Jisọs ama ọbọrọ enye ete, “Afo edi andikpep ke Isrel, ndien afo udiọñọke ñkpọ emi? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Akpanikọ ke Ami ntiñ nnọ mbufo nte ñnyin itiñ ibaña se ñnyin ifiọkde, inyuñ itie ntiense ibaña se ikutde; tutu ye oro owo mbufo ndomokiet ibeñeke idem ndinyime etop ñnyin. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Mbufo inimke Mi ke akpanikọ ke ini ntiñde ikọ nnọ mbufo mbaña mme ñkpọ isọñ emi; didie ndien ke edinim Mi ke akpanikọ ke ini ntiñde ikọ nnọ mbufo mbaña mme ñkpọ enyọñ? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Ndien baba owo ndomokiet akananam idọkke enyọñ ke ebede Eyen Owo, emi okotode enyọñ ọsuhọrede edi isọñ. <verse eid="JHN 3:13" /><verse number="14" style="v" sid="JHN 3:14" />Kpasuk nte Moses ekemenerede urukikọt okpoho ke enyọñ ke ọkọkọk ke isọñ utatan, kpasuk ntre ke edimenerede Eyen Owo ke enyọñ, <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />man otodo owo ekededi emi edinimde Enye ke akpanikọ ekpenyene nsinsi uwem. <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />Koro Abasi akamama ererimbot, oro akanam Enye osio ikpọñ ikpọñ Eyen Esie ọdọñ, ete owo ekededi emi ọbuọtde idem ye Enye okutak, edi enyene nsinsi uwem. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Abasi ikọdọñke Eyen Esie ke ererimbot ndidi ekpe ikpe esie, edi ekedi man anyaña ererimbot oto ke Enye.<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />Koro owo ekededi emi onimde Enye ke akpanikọ ididaha ke ikpe; edi owo ekededi emi minimke Enye ke akpanikọ, ikpe ama etetip enye ama, koro enye minimke enyiñ ikpọñ ikpọñ Eyen Abasi ke akpanikọ. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Ndien emi edi ntak utib ikpe: Uñwana edi ke ererimbot, edi mme owo ekema ekim ekan uñwana, koro mme edinam mmọ ekedide idiọk. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Owo ekededi emi anamde idiọk, asasua uñwana, ndien enye idinyuñ idighe ke itie uñwana, koro enye miyomke mme oburobut edinam esie ewọrọ ewut idem. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Edi owo ekededi emi odude uwem akpanikọ, ọwọrọ owut idem ke uñwana, do ke etim ekut ete se enye akanamde okoto ndausuñ Abasi.”<verse eid="JHN 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Ke ñkpọ emi ama ekebe, Jisọs ye mme mbet Esie ema ekpọñ Jerusalem eka ke usuk obio Judia, Enye ama odu do ye mmọ ke esisit ini, ndien onyuñ enim mme owo babtisim.<verse eid="JHN 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 3:23" />Jọn ñko ama aka iso ndinim mme owo babtisim ke ebiet emi ekekotde Enọn, emi mikeyomke usuñ ikpọñ ebiet emi ekekotde Salim, koro ata ediwak mmọñ ama odu do. Mme owo ke ekeka ebine enye, enye ñko ke ekenim mmọ babtisim. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />Ñkpọ emi ama otibe mbemiso emum Jọn esin ke ufọk ñkpọkọbi. <verse eid="JHN 3:24" /><verse number="25" style="v" sid="JHN 3:25" />Usen kiet eneni ama etibe ke ufọt mme mbet Jọn ye owo Ju kiet abaña edu unam idem asana nte asañade ekekem ye ukpepñkpọ ido ukpono mmọ. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Ntre mmọ ema ebine Jọn ndien ekedọhọ enye ete, “Andikpep, owo oro okodude ye afo ke edem akpa Jọdan oko, kpa Enye emi afo eketiede ntiense abaña, sese Enye ke onim mme owo babtisim ndien kpukpru owo ke ebine Enye.”<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />Jọn ama ọbọrọ ete, “Owo ekeme ndibọ kpọt se enọde enye oto enyọñ.” <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Mbufo ke idem mbufo emekeme ndidi ntiense nte ke mma ntiñ nte ke ami ndighe Kraist, edi ekedọñ mi ete ndinọ ntọt mbaña edidi Esie. <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Ñwan ndọ enyene ebendọ. Ufan emi esede ñkpọ abaña ebendọ enyene ndibet ñnyuñ ñkpañ utọñ, ñnyuñ ndara ke ini emi enye okopde uyo ebendọ. Kpa ntem ke enam idara Mi ọyọhọ. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Enye enyene ndidọdiọñ ñkọri ñka iso, kadaña emi ami nsuhọrede.<verse eid="JHN 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Enyemi otode enyọñ okoñ akan kpukpru owo, ndien owo emi otode isọñ enyene isọñ, onyuñ etiñ ikọ abaña mme ñkpọ isọñ. Enyemi otode enyọñ okoñ akan kpukpru owo. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Enye etiñ abaña se Enye okokutde ye se Enye okokopde, edi baba owo ndomokiet ikenyimeke ikọ ntiense Esie. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Ndien owo ekededi emi enyimede ikọ ntiense Esie ayarade owut nte ke Abasi anam akpanikọ. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Enyemi Abasi okosiode ọdọñ etiñ mme ikọ Abasi, koro Abasi ọnọde Enye uyọhọ Spirit. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Ete ama Eyen Esie ndien ayak kpukpru ñkpọ esin ke ukara Esie. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Owo ekededi emi ọbuọtde idem ye Eyen enyene nsinsi uwem, edi owo ekededi emi esinde Eyen idikwe uwem oro, koro iyaresit Abasi odorode enye ke idem.<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s1">Ñwan Emi Enyenede Mme Ebe Ition</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Mme Farisi ema ekop ete ke Jisọs ke ọkọkọ onyuñ enenim ediwak owo babtisim akan nte Jọn akanamde, <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />okposuk edi oro, ke akpanikọ, mikedighe Jisọs ke idem Esie ekenim mme owo babtisim edi ekedi mme mbet Esie ekenim mme owo babtisim. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Ke ini Jisọs okokopde abaña ñkpọ emi, Enye adaha ọkpọñ Judia ndien ọtọñọ ntak aka Kalili ini kiet efen.<verse eid="JHN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 4:4" />Enye ekenyene ndisaña mbe ke Sameria. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />Enye ama edisim obio kiet ke Sameria emi ekekotde Saika, emi mikeyomke usuñ ikpọñ isọñ emi Jekọb ọkọnọde eyen esie Josef. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Obube mmọñ Jekọb ama odu ekpere, ndien ke mba anyan isañ, Enye ama ọsuhọde etie ke mben obube mmọñ oro. Emi ekedi ke ñkpọ nte ufọt uwemeyo.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Ikebighike ñwan Sameria kiet ama edi ndiduri mmọñ, ndien Jisọs ama ọdọhọ enye ete, “Nọ Mi mmọñ ññwọñ.” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />Enye eketie ikpọñ ke mben obube emi, koro kpukpru mbet Esie ema edaha eduk esit obio ndikedep udia. <verse eid="JHN 4:8" /><verse number="9" style="v" sid="JHN 4:9" />Idem ama akpa eyen añwan Sameria eti eti, do enye ama ọbọrọ Jisọs ete, “Ete, Afo edi owo Ju, ndien ami ndi ñwan Sameria. Didie ke Afo ekeme ndibeñe mi mmọñ ke ini mme Ju minyeneke ebuana ye mbon Sameria?”<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Jisọs ama ọbọrọ enye ete, “Edieke afo ọkpọfiọkde se Abasi ekemede ndinọ kpa ye idem owo emi ebeñede fi mmọñ ndiñwọñ, afo akpakam ebeñe Enye ndien Enye ọkpọnọ fi oduuwem mmọñ.”<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />Edi ñwan emi ọdọhọ Enye ete, Ete, “Afo unyeneke uruk mme abañ ukoi mmọñ; ndien ñko, obube mmọñ emi ọtuñọ eti eti. Afo ududa oduuwem mmọñ emi ke mmọñ? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Nte afo omokpon akan ete ñnyin Jekọb emi ọkọnọde ñnyin obube mmọñ emi, onyuñ etiene ọñwọñ ke idem esie, kpa ye kpukpru mme nditọ ye mme ufene esie?”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />Jisọs ama ọbọrọ enye ete, “Owo ekededi emi ọñwọñde mmọñ enye emi, eyetọñọ ntak okop nsatitọñ, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />edi owo kiet ekededi emi ọñwọñde mmọñ enye emi Ami nnọde enye idikopke aba nsatitọñ. Ke akpanikọ, mmọñ emi Ami nnọde enye eyekabade edi obube mmọñ ke idem esie emi edinọde enye mmọñ uwem, onyuñ ọnọ enye nsinsi uwem.”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Ñwan oro ama ebeñe Enye ete, “Ete, mbọk nọ mi oduuwem mmọñ oro man itọñ okusat mi aba, man ami ntre ndidi ke obube enye emi ndiduri mmọñ.”<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Jisọs ama ọdọhọ enye ete, “Ka ndien kokot ebe fo, nyuñ saña ye enye edi.”<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Edi ñwan oro ama ọbọrọ ete, “Ami ñnyeneke ebe.” Jisọs ama ọbọrọ ete, “Afo emenen, ke emi afo ọdọhọde ete imọ inyeneke ebe. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />Akpanikọ kedi, afo ama ọdọdọ mme ebe ition, ndien owo emi afo oduñde ye enye ke ufọk idahaemi idighe ebe fo, se afo etiñde edi akpanikọ.”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />Eyen añwan emi ama ọdọhọ ete, “Ete ami mmokut nte ke afo edi Asiak Uduak Abasi. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Koro mme ete ete ñnyin ke Sameria ekekpono Abasi ke enyọñ obot emi, edi mbufo mme Ju edọhọ ete ke Jerusalem edi ebiet emi ñnyin inyenede ndikpono Abasi.”<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />Jisọs ama ọdọhọ enye ete, “Eyen añwan, nim Mi ke akpanikọ, ini ke ededi emi mme owo midikponoke Ete Mi ke obot emi, mme ke Jerusalem. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Koro mbufo mbon Sameria itimke ifiọk enye emi mbufo etuakde ibuot enọ; ñnyin mme Ju imọdiọñọ Enyemi ñnyin ituakde ibuot inọ, koro edinyaña otode ke ubon mme Ju. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Edi ini ke ededi, ndien omonyuñ ededi ama, emi ata mme andituak ibuot edituakde ibuot inọ Ete ke Spirit ye ke akpanikọ. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Abasi edi Spirit, ndien mme andituak ibuot nnọ Enye enyene ndituak ibuot nnọ Enye ke Spirit ye ke akpanikọ.”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Ñwan oro ama ọdọhọ Enye ete, “Ami mmọfiọk nte ke Andinyaña emi ekotde Kraist ke ededi, ndien ke Enye ama edi, Enye eyenam kpukpru ñkpọ añwaña ñnyin.”<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Do ke Jisọs akayarade ọnọ enye ete, “Ami emi ntiñde ikọ ye afo ndi Enye.”<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Kpa ke ndo ndo oro mme mbet Esie ema enyọñọ edi, ndien idem ama akpa mmọ ke ndisobo Enye nte etiñde ikọ ye eyen añwan. Edi mmọ ndomokiet ikebupke eyen añwan oro ete, “Nso ke afo oyom?” Mme ndibup Jisọs ete, “Ntaha Afo enemede nneme ye eyen añwan emi-e?”<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Do ke eyen añwan emi akadaha ọkpọñ otu mmọñ esie ke mben obube mmọñ, ndien enye ama afiak aka esit obio, onyuñ ọkọdọhọ mme owo do ete, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“Edi edise owo emi etiñde kpukpru se ami ñkanamde ọnọ mi. Nte emi idighe Kraist oro?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Ntre ke ediwak owo ekewọñọ ke obio, eka ebine Jisọs.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Ke ufọt ini oro mme mbet ke ekekpe ye Jisọs ete, “Andikpep dia ñkpọ.” <verse eid="JHN 4:31" /><verse number="32" style="v" sid="JHN 4:32" />Edi Enye ama ọbọrọ mmọ ete, “Ami menyene udia ndidia emi mbufo midiọñọke ñkpọ ibaña.”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Do ke mme mbet Esie ekeneme ke ufọt mmọ ete, “Nte owo ndomokiet ama ada udia ọsọk Enye?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Jisọs anam añwaña mmọ añwa añwa ete, “Udia Mi edi ndinam uduak Enyemi ọkọdọñde Mi, ñnyuñ nnam utom Esie mma. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Nte mbufo idọhọke ite ke ayak ọfiọñ inañ ndien esim ini idọk? Edi Ami ndọhọ mbufo nte yak etat enyin mbufo ndien etim ese iñwañ idọk, kpukpru ñkpọ ke iñwañ esọñ, ekem ini idọk. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Owo emi ọdọkde idọk eyebọ okuk utom esie, ndien enye ọkọ idọk esie enim ọnọ nsinsi uwem, man otodo owo emi ọkọtọde ye enye emi ọdọkde ekpedara ebiet kiet. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Se esitiñde emi edi akpanikọ, nte, ke owo kiet ọtọtọ, owo efen ọdọdọk. <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Ami ñkọdọñ mbufo nte ekedọk se mbufo miketọhọ. Mbio efen ema enanam kpukpru ñkpọsọñ utom ke iñwañ emi, ndien idahaemi mbufo emedọk nti idọk eto akwa utom mmọ.”<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Ndien ediwak mbon Sameria emi etode obio oro ema enim kpukpru ikọ Esie ke akpanikọ oto ke ntak ikọ ntiense emi ñwan oro eketiñde ete, “Enye ama etiñ ọnọ mi kpukpru se ñkenanam.” <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Ke ntre ke ini mbon obio Sameria oro ekedide ebine Enye, mmọ ema ekpe ye Enye, ete, yak Enye adañ ye mmimọ; ndien Jisọs ama adañ ye mmọ usen iba. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />Mme ediwak mmọ efen ema enim ke akpanikọ eto ke mme ikọ Esie. <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />Ndien mmọ edọhọ ñwan oro ete, “Ñnyin imenim idahaemi ke akpanikọ, itoho ke se afo eketiñde, edi oto koro ñnyin ke idem ñnyin imokop iko Esie, ndien ñnyin imetim idiọñọ ite ke Enye ke akpanikọ edi Andinyaña ererimbot.”<verse eid="JHN 4:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Ke Jisọs ama akadañ usen iba do, Enye ama ọkpọñ do aka Kalili. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />Koro Jisọs ke idem Esie ama ọdọhọ ete, “Prọfet inyeneke ukpono ke obio Esie.” <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Ke ini Enye ama ekesim Kalili, mbon obio Kalili ema edara Enye eti eti, koro mmọ ema ekut kpukpru se Enye akanamde ke Jerusalem ke ini usọrọ uwọrọ ufin, sia kpukpru mmọ ekedude do ñko ke Jerusalem.<verse eid="JHN 4:45" /></para>
  <para style="s1">Ema Ekọk Eyen Akwa Owo Utom Udọñọ</para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Jisọs ama ọtọñọ ntak aka Kenan ke Kalili, ebiet emi Enye akanamde mmọñ akabade wain. Ndien owo anam utom ukara kiet ama odu do emi eyen eren owo esie ọkọdọñọde ke Kapanọm. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Ke ini owo emi okokopde ete ke Jisọs ama oto Judia edisim Kalili, enye ama ebine Enye onyuñ ekebeñe Enye ete, yak Enye edika Kapanọm ọkọkọk eyen imọ emi ọkọdọñọde ekpere ndikpa.<verse eid="JHN 4:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48" />Jisọs ama ọdọhọ enye ete, “Mbufo ndomokiet ikemeke ndinim ke akpanikọ tutu mbufo ekut mme ikpọ utom odudu ye mme ñkpọ ñkpaidem.”<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />Owo emi ama ọbọrọ ete, “Ete tiene mi mbak eyen mi edikpa.”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />Jisọs ama ọbọrọ enye ete, “Afo emekeme ndinyọñ, eyen fo eyedu uwem.” Owo emi ama onim ikọ Jisọs ke akpanikọ onyuñ ọnyọñ. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />Kadaña ini emi Enye okosuk odude ke usuñ unyọñ, mme nditọ ufọk esie ema ekesobo enye ke usuñ ye eti etop emi, ete, “Eyen fo odu uwem.” <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />Enye ama obup mmọ ini emi eyen esie ọkọtọñọde ndikop nsọñidem, ndien mmọ ema ebọrọ ete, ekedi ke ñkpọ nte ñkanika kiet uwemeyo ñkpọñ ke ufiopidem ọkọkpọñ enye. <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />Ete eyen emi ama eti ke ndo ndo oro nte ke ekedi kpa ke ukem ini oro ke Jisọs ọkọdọhọ imọ ete, “Eyen fo eyedu uwem.” Ke ntak emi, enye ye ofuri ufọk esie ema enim ke akpanikọ.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />Emi ekedi udiana utom odudu emi Jisọs akanamde ke Enye ama okoto Judia ọnyọñ edi Kalili.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s1">Mme Ada Ibuot Ema Efaña Edikọk</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Ke ini esisit ama ekebe, Jisọs ama aka Jerusalem man akabuana ke usọrọ mme Ju. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Ke esit Jerusalem, ke nsaña-nduk emi ekotde lnua Otop mme erọñ, ñkpọdiọhọ mmọñ emi ekenyenede mme itie ndọknda ition ama odu, emi ekekotde ke usem mme Hibru Betesda. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Ata ediwak udim mbio udọñọ ema ena ke mme itie ndọknda emi, mme nnan, mme mbuñọ ye mme mbio akpaubeñ. Mmọ ekebet mmọñ oro etimede. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />Koro kini, kini, enjel Abasi esisuhọde oduk onyuñ etimede mmọñ oro ndien ata akpa owo udọñọ emi ọsuhọrede oduk ñkpọdiọhọ mmọñ emi ke ini ema eketimede mmọñ emi, esinyene ndibọ edikọk nto oruk udọñọ kiet ekededi emi enye ọkọdọñọde.<verse eid="JHN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 5:5" />Owo kiet ama odu ke otu mmọ emi ọkọdọñọde ke ñkpọ nte isua edip ye efuteta. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Ke ini Jisọs okokutde enye anade do, Enye ama ọfiọk inikiet nte ke enye ama ana do ye udọñọ esie ke ediwak isua. Do ke Jisọs okobup enye ete, “Nte afo omoyom ndikop nsọñidem?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Owo udọñọ ama ọbọrọ ete, “Ete ami ñnyeneke owo emi emende mi esin ke ñkpọdiọhọ mmọñ ke ini asañautom Abasi (enjel) etimerede mmọñ. Kadaña ini emi ññwanade ndiduk, owo efen esibem mi iso oduk.”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />Jisọs ama ọdọhọ enye ete, “Daha ke enyọñ, fut mbri fo, nyuñ saña.” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />Ndo ndo oro, owo oro ama okop nsọñidem. Enye ama ofut mbri esie onyuñ ọtọñọ ndisaña isañ. Utibe ñkpọ emi eketibe ke usen Sabat. <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />Do mme ikpọ owo mme Ju ema edọhọ owo oro ekekọkde enye udọñọ ete, “Mfin edi usen Sabat, ndien mbet ñnyin akpan afo ndimen mbri fo.”<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Edi enye ama ọbọrọ mmọ ete, owo emi akanamde udọñọ okure mi ọkọdọhọ mi ete, “Daha ke enyọñ, fut mbri fo nyuñ saña.”<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />Do mmọ ema ebup enye ete, “Anie edi owo oro ọkọdọhọde fi ete, ofut mbri fo, onyuñ adaha asaña?”<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Owo emi ikọdiọñọke andikọk enye Udọñọ, koro otu owo ama okpon eti eti, ndien ñko Jisọs ama ọfiọnọde ọwọrọ. <verse eid="JHN 5:13" /><verse number="14" style="v" sid="JHN 5:14" />Edi edikem, Jisọs ama okokut enye ke itie ukpono mme Ju, onyuñ ọdọhọ enye ete, “Sese idem ọsọñ fi idahaemi. Sana mme idiọkñkpọ fo yak, ke midighe ntre, se idiọkde ikan emi ekeme ndisim fi.”<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />Owo emi ama ọnyọñ ndien eketiñ ọnọ mme Ju nte ke ekedi Jisọs ọkọkọk.<verse eid="JHN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16" />Ke ntak emi, mmọ ema etọñọ ndikọbọ Jisọs koro Enye ọkọkọkde owo oro udọñọ ke usen Ederi mme Ju. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Edi Jisọs ama ọbọrọ mmọ ete, “Ete Mi ananam utom Esie kpukpru ini, ndien Ami ñko ana nte nnam utom Mi.”<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />Ikọ Esie emi ama anam ukara mme Ju etetim ebiere ndiwot Enye. Idighe koro Enye abiatde Sabat ikpọñ, edi ye emi Enye ọdọhọde ete, ke Abasi edi Ete Imọ, ke ntre, Enye anam idem Esie ukem ukem ye Abasi.<verse eid="JHN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Jisọs ama ọbọrọ mmọ ete, “Ami ntiñ akpanikọ nnọ mbufo: Eyen inamke baba ñkpọ ndomokiet ke idem Esie, Enye anam kpasuk se Enye okokutde se Ete anamde. Se Ete anamde, oro ke Eyen anam ñko. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Koro Ete ama ama Eyen Esie, onyuñ owut Enye kpukpru ñkpọ emi Enye anamde. Ndien eyesuk akpa mbufo idem koro Enye eyewut Enye ediwak ñkpọ emi okponde akan mmọ emi ndinam. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Kpa nte Ete emenerede mme akpaña ñkpa onyuñ ọnọ uwem, ke ukem usuñ oro ke Eyen onyuñ ọnọ mmọ emi Enye oyomde uwem. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Ke ndidian do, Ete ke idem Esie ikpehe ikpe baba owo ndomokiet. Enye ama ayak ọyọhọ odudu ọnọ Eyen Esie ndikpe ikpe, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />man otodo kpukpru owo ekpono Eyen ukem ukem kpa nte ekponode Ete. Owo kiet ekededi emi mikponoke Eyen, ikponoke Ete emi ọkọdọñde Enye.”<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />Ami ntiñ akpanikọ nnọ mbufo nte, owo eke akpañde utọñ ọnọ etop Mi, onyuñ onimde Abasi emi ọkọdọñde Mi ke akpanikọ, enyene nsinsi uwem, ndien enye ididaha ke ikpe ke ntak idiọkñkpọ esie, koro enye ama ebe ọkpọñ ñkpa oduk ke uwem. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Ami ntiñ akpanikọ nnọ mbufo, nte ke ini ke ededi, ini oro onyuñ ededi ama, emi mme akpaña ñkpa edikopde uyo Eyen Abasi, ndien mmọ emi ekopde eyetọñọ ntak edu uwem. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Kpa nte Ete enyenede uwem ke idem Esie, ntre ñko ke Enye ọnọ Eyen unen ndinyene uwem ke idem Esie. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Ndien Enye omonyuñ ọnọ Enye odudu ndidi ekpe ikpe kpukpru idiọkñkpọ ofuri ubon owo, koro Enye edide Eyen Owo. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />Ekuyak emi akpa mbufo idem, koro ini ke ededi emi kpukpru mme mmọ emi edude ke mme udi mmọ eyekop uyo Esie, <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />ndien ewọñọ ke udi: mme mmọ emi ekenamde eti eyedaha eda eduk ke uwem, ndien mme mmọ emi ekenamde idiọk, eyedaha eda eduk ke utib ikpe.<verse eid="JHN 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />Ke idem Mi, Ami ñkemeke ndinam baba ñkpọ ndomokiet; Ami ñkpe ikpe ntiene nte Ami ñkopde ndien ubiere ikpe Mi edi unen koro Ami mmeñnyeneke ndinem idem Mi esit, edi ndinem Enye emi ọkọdọñde Mi esit.<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />“Edieke Ami ntiede ntiense mbaña idem Mi, inaha nte eda mme ikọ emi nte akpanikọ. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Edi owo efen odu emi etiede ntiense abaña Mi, ndien Ami mmọfiọk nte ke mme ikọ ntiense esie emi enye etiñde abaña Mi edi akpanikọ.” <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />Mbufo ema edọñ mme isuñutom mbufo eka ebine Jọn Babtis ndien enye ama etie ntiense abaña akpanikọ emi. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Idighe nte ana Ami ñnyene ntiense emi edide owo; Ami ntiñ emi man otodo mbufo enyene edinyaña. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Jọn ekebiet utueneikañ emi asakde onyuñ ayamade emi mbufo ekemade uñwana esie ke esisit ini. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />Edi ami mmenyene ntiense emi okponde akan eke Jọn: mme utom emi Ami nnamde, mme utom emi Ete Mi ọkọdọñde Mi ete nnam, kpukpru emi etie ntiense ebaña Mi, enyuñ esio ewut nte ke Ete ọkọdọñ Mi. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Ndien Ete emi ọkọdọñde Mi ke idem Esie etie ntiense abaña Mi. Edi akananam mbufo ikopke uyo Esie inyuñ ikwe iso Esie; <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />ndien mbufo idipke mme etop Esie ke esit mbufo, koro mbufo minimke Enyemi Enye ọkọdọñde ke akpanikọ. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Mbufo esuk esin ifik eduñọde ñwed Abasi koro mbufo ekerede ete ke mmimọ iyenyene nsinsi uwem ito ke edinam ntre. Mme ikọ Abasi oro etiñ ikọ ebaña Mi. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />Kpa ye oro, mbufo inyimeke ndidi ntiene Mi, man mbufo enyene uwem.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />“Ami ñyomke itoro nto owo ndomokiet. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Edi Ami mmọdiọñọ mme uduot owo emi mbufo edide, mmonyuñ ndiọñọ nte ke mbufo inyeneke ima ke esit mbufo ibaña Abasi. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Ami mmedi ke otu mbufo ke odudu enyiñ Ete Mi, ndien mbufo edidide ke odudu idem esie, mbufo eyedara enye. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Mbufo emema ndibọ itoro nto kiet eken, edi mbufo idomoke ndibọ itoro nto Abasi kierakiet; didie ndien ke mbufo ekeme ndinim ke akpanikọ?<verse eid="JHN 5:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45" />Edi ekukere ete ke Ami ñyetiñ ikọ ndian mbufo ke iso Ete. Moses edi enyemi editiñde ikọ idian mbufo, kpa Moses emi mbufo enyenede idorenyin ke enye. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Edieke mbufo ekpenimde Moses ke ata akpanikọ, mbufo ekpenyuñ enim Mi ke akpanikọ, koro enye ekewetde abaña Mi. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Edi sia mbufo mikenimke se enye ekewetde, ekeme didie ndinim ke akpanikọ se Ami ntiñde?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s1">Jisọs ọnọ Owo Tọsin Ition Udia</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Ke emi ama ekebe, Jisọs ama afiak edem ekebe inyañ Kalili emi enyuñ ekotde Taiberias aka edem eken. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Ndien akwa otu owo ema etiene Enye ke ntak emi mmọ ekekutde mme utibe idiọñọ emi Enye akanamde ke idem mme mbon udọñọ. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Jisọs ama ọdọk enyọñ obot eketetie ye mme mbet Esie. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Koro usọrọ uwọrọ ufin mme Ju ama ekpere. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />Ke ini emi Jisọs emenerede enyin ese, Enye ama okut akwa otu owo nte esañade ebine Enye. Enye ọwọñọde enyin onyuñ obup Filip ete, “Mmọñ ke edidep uyo inọ mme mmọ emi eta?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Jisọs okobup mbume emi man Enye odomo Filip ese, koro Enye ama ọdọdiọñọ ke esit Esie se Enye enyenede ndinam.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Filip ama ọbọrọ Enye ete, “Okuk utom owo kiet ke ọfiọñ itiaita idikemeke ndidep uyo emi ekemde mme mmọ emi ndita owo kiet kiet.”<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Mbet Esie kiet emi ekerede Andru, emi edide eyen eka Saimọn Pita ama ọdọdiọñọ ete, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“ekpri eyen eren kiet odu ke otu emi, emi enyenede ebok uyo ibokpot ition ye iyak iba. Edi nso ke ekeme ndida emi nnam?”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />Jisọs ama ọdọhọ ete, “Enam kpukpru owo etetie.” Ediwak mbiet ama odu ke ebiet emi, do ke kpukpru owo eketetie, ama esim ñkpọ nte tọsin owo ition. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Jisọs ama emen mme ebok uyo oro, ọnọ Abasi ekọm, onyuñ edeme ọnọ mme mmọ emi eketiedetie ke mbiet eta nte mmọ ekeyeyom. Enye akanam kpa ntre ye iyak, ndien kpukpru owo ema eta nte ekeyuhọde.<verse eid="JHN 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12" />Ke ini mmọ ema eketa nte ekekemde mmọ, Jisọs ama ọdọhọ mme mbet Esie, ete, “Etañ kpukpru mme mbeñe oro ekeduọñọde, ekuyak ndomokiet atak.” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Do mmọ ema etañ kpukpru enyuñ edọñ ọyọhọ ke akpasa duopeba se ikeduọñọde ito uyo ition ye iyak iba emi otu owo oro eketade.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Ke ini mme owo emi ekekutde utibe ñkpọ emi Jisọs akanamde, mmọ etọñọ nditiñ ete, “Ke akpanikọ, emi edi Prọfet emi akanade edi ke ererimbot.”<verse eid="JHN 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 6:15" />Jisọs ama ọdiọñọ ete ke mmọ emọñ edimum Imọ ke odudu enam Edidem, ke ntre Enye ama adaha ọdọk ke enyọñ obot ikpọñ.<verse eid="JHN 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Ke mbubreyo oro mme mbet Esie esuhọde eka ke mben ñkpọdiọhọ mmọñ, <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />ke ebiet emi mmọ ekedukde ubom enyuñ etọñọ ndibe inyañ ñka Kapanọm. Ñkuteyo ama esim mmọ ke akpa, ndien Jisọs ikeduhọ do ye mmọ. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Ọkpọsọñ oyobio ama ofume onyuñ etimede akpa. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Ke mmọ ema ekewat ubom ñkpọ nte itiat ita mme inañ, mmọ ema ekut nte Jisọs asañade ke enyọñ mmọñ ebine ubom, ndien ndik ama anam mmọ eti eti. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Edi Jisọs ama ọdọhọ mmọ ete, “Ekufehe ndik, ke edi Ami!” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Mmọ ke ekeyoyom ndimum Enye nsin ke ubom; edi kpa ke ndo ndo oro ubom ama esesim isọñ ke ebiet emi mmọ ekekade.<verse eid="JHN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Ke ndañnsiere, otu owo emi ekedude ke edem ñkpọdiọhọ mmọñ eken ema ekut ete ke ñkpasip ubom kiet kpọt ọkọsuhọ, mmọ ñko ema ediọñọ ete ke Jisọs ikodukke ubom ye mme mbet Esie, koro mmọ ema edaha ekpọñ Enye. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Mme ubom efen ema eto Taiberias edibehe ke ebiet emi mme otu owo oro eketade uyo. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Ke ini otu owo emi ekekutde ete ke Jisọs ikesineke ke mme ubom oro ndomokiet, mme mme mbet Esie, mmọ ema eduk mme ubom enyuñ eka Kapanọm ndiyom Jisọs.<verse eid="JHN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Ke mmọ ema ekekut Jisọs ke edem ñkpọdiọhọ mmọñ eken, mmọ ema ebup Enye ete, “Andikpep, ini ewe ke Afo ekesim mi?” <verse eid="JHN 6:25" /><verse number="26" style="v" sid="JHN 6:26" />Jisọs ama ọbọrọ ete, “Ami ntiñ akpanikọ nnọ mbufo, mbufo eyom Mi, idighe koro mbufo ekutde mme idiọñọ ye mme utibe ñkpọ, edi, koro mbufo eketade mme ebok uyo oro enyuñ eyuhọ. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Ekunam utom ke ntak udia emi edibiarade; edi ekam enam utom kabaña udia emi edibighide ikesim nsinsi uwem. Edi udia enye oro ke Eyen Owo edinọ mbufo, koro Abasi emi edide Ete, amayak idiọñọ edinyime Esie ọnọ Enye.”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Do ke mmọ ekebup Enye ete, “Ñnyin idinam nso man ewut nte ñnyin imenam utom Abasi?”<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />Jisọs ama ọbọrọ mmọ ete, “Emi edi utom emi Abasi oyomde enam: Enim Enye emi Enye osiode ọdọñ ke akpanikọ.” <verse eid="JHN 6:29" /><verse number="30" style="v" sid="JHN 6:30" />Do ke mmọ ekebup Enye, ete, “Mme nso idiọñọ utom odudu ke Afo uduwut man otodo ñnyin ikut inyuñ inim Fi ke akpanikọ? Nso ke Afo udunam? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Mme Ete ete ñnyin ekedia mana ke isọñ utatan, kpa nte ñwed Abasi etiñde ete: Enye ọkọnọ mmọ uyo oto ke enyọñ eta.”<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Jisọs ama ọdọhọ mmọ ete, “Ami ntiñ akpanikọ nnọ mbufo, nte ke uyo emi Moses ọkọnọde mbufo ikedighe uyo emi otode enyọñ, edi Ete Mi edi Enyemi ọnọde mbufo idem ata uyo emi otode enyọñ. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Koro uyo emi Abasi ọnọde edi Enyemi otode ke enyọñ ọsuhọrede edi onyuñ ọnọ ererimbot uwem.”<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />Mmọ ema edọhọ ete, “Ete, ọtọñọde ke emi, ka iso ndinọ ñnyin uyo oro.”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />Do ke Jisọs akayarade ete, “Ami ndi uyo uwem oro. Enyemi edide etiene Mi, idikopke biọñ, ndien owo emi enimde Mi ke akpanikọ idikopde nsatitọñ. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Edi kpa nte Ami ñketiñde nnọ mbufo, mbufo emekut Mi, edi kpa ye oro mbufo inimke ke akpanikọ. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Kpukpru mme mmọ emi Ete ọnọde Mi, eyedi etiene Mi, ndien owo ekededi emi edide etiene Mi, Ami ndibinke nduọk. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Koro Ami ñkoto ke enyọñ nsuhọrede ndi, ñkedighe ndinam uduak Mi, edi ndinam uduak Enye emi ọkọdọñde Mi. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />Ndien emi edi uduak Enyemi ọkọdọñde Mi, nte baba kiet ke otu mme mmọ emi Enye ọnọde Mi ekusop, edi yak Ami mmenerede mmọ kpukpru nsin ke uwem ke akpatre usen. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Koro se Ete Mi oyomde edi emi: Nte yak kpukpru mme mmọ emi ekutde Eyen enyuñ enim Enye ke akpanikọ, ana enyene nsinsi uwem; ndien Ami ñyemenerede mmọ nsin ke uwem ke akpatre usen.”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Mme Ju ema etọñọ ndikuni mbaña Enye, koro Enye ọkọdọhọde ete, “Ami ndi uyo oro emi okotode ke enyọñ ọsuhọrede edi.”<verse eid="JHN 6:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 6:42" />Do ke mmọ ekedọhọ ete, “Nte emi idighe Jisọs eyen Josef, emi ñnyin idiọñọde ete ye eka esie? Enye ekeme didie idahaemi ndidọhọ ete, ‘Ami nto ke enyọñ nsuhọrede ndi’?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Edi Jisọs ama ọbọrọ mmọ ete, “Etre ñkuni ke otu mbufo.” <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />“Baba owo ndomokiet ikemeke ndidi ntiene Mi ke mibọhọke Ete Mi emi ọkọdọñde Mi oduri enye ọnọ Mi, ndien Ami ñyemenerede enye nsin ke uwem ke akpatre usen. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Mme Prọfet ema ewet ete: ‘Edi Abasi edikpep kpukpru owo ñkpọ.’ Owo kiet ekededi emi akpañde utọñ ọnọ Ete onyuñ ekpepde ñkpọ oto Enye eyedi ebine Mi. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Baba owo ndomokiet akananam ikwe Ete, ke mibọhọke owo kiet emi otode ke Abasi; kpa Enye ikpọñ okut Ete.<verse eid="JHN 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 6:47" />Ami ntiñ akpanikọ nnọ mbufo nte, ke enyemi enimde ke akpanikọ enyene nsinsi uwem. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Ami ndi uyo uwem. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Mme ete ete mbufo ema eta mana ke isọñ utatan, edi mmọ ema ekpaña. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Edi uyo emi otode ke enyọñ ọsuhọrede edi, edi utọ emi, nte owo ekededi atade enye idikpaha. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Ami ndi odu uwem uyo, emi okotode ke enyọñ ọsuhọrede edi: Edieke owo ekededi atade uyo emi, enye eyedu uwem ke nsinsi. Uyo emi Ami ndinọde enye edi ikpọkidem Mi emi Ami nnọde man otodo ererimbot edu uwem.”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Mme ikọ emi ama ada ọkpọsọñ eneni iyaresit edi ke otu mme Ju. Mmọ ema ebup ete, “Owo emi ekeme didie ndinọ ñnyin ikpọkidem Esie ita?”<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Jisọs ama ọdọhọ mmọ ete, “Ami ntiñ akpanikọ nnọ mbufo, edieke mbufo mitaha ikpọkidem Eyen Owo, inyuñ iñwọñ iyip Esie, mbufo idinyeneke uwem ke idem mbufo. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Owo ekededi emi atade ikpọkidem Mi onyuñ ọñwọñ iyip Mi, enyene nsinsi uwem, ndien Ami ñyemenede enye ke ñkpa nsin ke uwem ke akpatre usen. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Koro ikpọkidem Mi edide udia ke akpanikọ, ndien iyip Mi onyuñ edide ediñwọñ ñkpọ ke akpanikọ. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Owo ekededi emi atade ikpọkidem Mi onyuñ ọñwọñde iyip Mi, odu ke Ami ndien Ami ñko ndu ke enye. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Kpa nte Odu-uwem Ete ọkọdọñde Mi, ndien Ami ndu uwem oto ke ntak Ete, kpa ntre ñko ke enye emi atade ikpọkidem Mi, onyuñ ọñwọñde iyip Mi edidu uwem ke ntak Mi. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Emi ndien edi uyo emi okotode enyọñ ọsuhọrede edi, enye itiehe nte uyo emi mme ete ete mbufo eketade, edi ndien, mmọ ekpaña. Owo emi editade uyo enye emi eyedu uwem ke nsinsi.” <verse eid="JHN 6:58" /><verse number="59" style="v" sid="JHN 6:59" />Jisọs eketiñ emi ke ini emi Enye akakade iso ndikpep ñkpọ ke ufọk ukpepñkpọ mme Ju ke Kapanọm.<verse eid="JHN 6:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Ke ini mme ediwak mmọ emi eketienede Enye ekekopde mme ikọ emi mmọ ema edọhọ ete, “Ukpepñkpọ enye emi ọsọñ akaha. Anie ekeme ndikpañ utọñ nnọ utọ ikọ emi?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Jisọs ama ọdiọñọ ete ke mme mbet Imọ ke ekuni kabaña se imọ iketiñde, do ke Enye okobup mmọ ete, “Nte emi anam mbufo eyom ndifiak edem? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Nso ndien ke mbufo ekpetiñ edieke mbufo ekutde Eyen Owo nte ọdọkde enyọñ afiak aka ebiet emi Enye okodude ke editọñọ? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />Se inọde owo uwem edi Spirit Abasi; odudu obukidem inyeneke ufọn ndomokiet. Mme ikọ emi Ami ntiñde ye mbufo edi spirit ye uwem. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Kpa ye oro, mbufo inimke ke akpanikọ.” Jisọs ama ọfiọk toto ke editọñọ mme mmọ emi midinimke ke akpanikọ, ye enyemi edinyuñ itapde Enye.<verse eid="JHN 6:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="JHN 6:65" />Enye ama aka iso nditiñ ete, “Emi edi ntak emi Ami ñketiñde nnọ mbufo nte, baba owo kiet ikemeke ndidi ntiene Mi ke mibọhọke Ete ọnọ enye ukeme.”<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Ọtọñọde ke ini oro ata ediwak mme mbet Esie ema efiak edem ikonyuñ itieneke Enye aba.<verse eid="JHN 6:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67" />Jisọs ama obup mme mbet Esie duopeba, ete, “Nte mbufo ñko emọñ ekpọñ Mi?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Saimọn Pita ama ọbọrọ Enye ete, “Ọbọñ mi, anie ke ñnyin idikpọñ Fi ibine? Afo enyene mme ikọ nsinsi uwem. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Ñnyin imenim ke akpanikọ inyuñ idiọñọ ite ke Afo edi Edisana Eyen Abasi.”<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />Do ke Jisọs ọkọbọrọ ete, “Nte Ami ñkemekke mbufo owo duopeba? Edi owo kiet ke otu mbufo edi eke andidiọk.” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />Enye eketiñ abaña Judas, eyen Iskariọt, emi, okposuk edi emi enye ekedide kiet ke otu mme mbet duopeba, enye ke utit ekenyene nditap Ọbọñ Jisọs.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s1">Eneni Emi Otukde Jisọs Ọsọñ Ubọk</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Ke ñkpọ emi ama ekebe, Jisọs ama asaña akanade Kalili, Enye ikoyomke ndisim Judia koro ukara mme Ju ekeyomde Enye ndiwot. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Ke ini usọrọ editi isua aba ke isọñ utatan ama ekekpere, <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />nditọ eka Jisọs ema edọhọ Enye, ete, “Kpọñ ebiet emi, di ka Judia, man otodo mme mbet Fo ekpekeme ndikut mme utom emi Afo akade iso ndinam. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Owo emi oyomde ndidi ọwọrọ etop owo, ikemeke ndidip utom emi Enye akade iso ndinam. Sia Afo akade iso ndinam mme ñkpọ emi yak ofuri ererimbot ediọñọ Fi.” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Koro idem nditọ eka Esie ikenimke Enye ke akpanikọ.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />Jisọs ama ọdọhọ mmọ ete, “Ñkemñkem ini Mi isimke kaña; ini kiet ekededi enenen ọnọ mbufo. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Ererimbot ikemeke ndisua mbufo, edi enye asua Mi, koro Ami ñkade iso nditiñ ye enye nte ke edinam esie ifọnke. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Mbufo eka usọrọ. Ami ndikaha usọrọ emi kaña, koro nnen nnen ini Mi ikemke kaña.” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Ke Enye ama eketiñ ntem, Enye ama aka iso nditie ke Kalili.<verse eid="JHN 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Nte ededi, ke ini nditọ eka Esie ema ekedaha eka usọrọ, Enye ñko ama aka, edi ikedighe añwa añwa, ekedi ke ndibe ndibe usuñ. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Mme ikpọ mbon ukara mme Ju ema eka iso ndiyom Enye ke itie usọrọ. Mmọ ema ebup ete, “Enye Enye?” <verse eid="JHN 7:11" /><verse number="12" style="v" sid="JHN 7:12" />Mme owo ema esuk Enye uyo. Ubak owo ema edọhọ ete, “Enye edi eti owo.” Ubak ete, baba, O! “Enye edi Enyemi adade mme owo otun usuñ.” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Edi ikenyeneke baba owo kiet emi ekenyenede isọñesit ndida ntiñ ikọ añwa añwa mbaña Enye ke ntak ndik emi mmọ ekenyenede ebaña mme Ju.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Ekem, ke ini esimde ufọt usọrọ, Jisọs ama oduk esit Edisana ebiet onyuñ aka iso ndikpep ñkpọ. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Idem ama akpa ikpọ owo mme Ju eti eti, ndien mmọ ema ebup ete, “Owo emi asaña didie ọfiọk mme ñkpọ ntem ke ini Enye akananam ikaha ufọk ñwed?”<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Jisọs ama ọbọrọ mmọ ete, “Se Ami ñkpepde idighe ukpepñkpọ Mi, edi oto Abasi emi ọkọdọñde Mi. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Edieke owo emekde ndinam uduak Abasi, enye eyeyarade ọdiọñọ mme ukpepñkpọ Mi oto Abasi, mme Ami ntiñ ikọ Idem Mi. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Owo ekededi emi etiñde ikọ idem esie anam ntre oyom ndida ukpono nnọ idem esie. Edi enyemi anamde utom oyom ubọñ ye ukpono ọnọ enyemi ọkọdọñde enye, edi owo akpanikọ; baba abiaña kiet iduhọ ke Enye. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Nte Moses ikọnọhọ mbufo mbet? Edi baba owo mbufo ndomokiet inimke mbet emi. Ntaha mbufo eyomde ndiwot Mi-e?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />Otu owo ema ebọrọ ete, “Idiọk Spirit oduk Fi ke idem! Anie eñwana ndiwot Fi?”<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />Jisọs ama ọbọrọ ete, “Ami ñkanam utom odudu kiet ndien idem ama akpa kpukpru mbufo. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Moses ama owuk mbufo ete yak enim nditọ mbufo mbobi (okposuk edi oro mikedighe Moses, edi ekedi mme ete ete mbufo eketọñọ ñkpọ emi.) Ke ntre, mbufo enim eyen erenowo mbobi ke usen Sabat, <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />man otodo mbufo ekubiat ibet Moses, ntaha mbufo ndien eyatde esit ye Ami ke ntak emi Ami nnamde owo okop nsọñidem ofuri ofuri ke usen Sabat-e? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Etre ndibiere ikpe nto ke se mbufo ekutde ke enyin, edi ebiere ikpe eto ke se idide akpanikọ.”<verse eid="JHN 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Ndusuk owo emi eduñde ke Jerusalem ema edọhọ ete, “Nte emi idighe owo emi mmọ eyomde ndiwot? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Se Enye mi, ke etetiñ ikọ añwa añwa, ndien mmọ itiñke ikọ ndomokiet ye Enye; nte mme andikara mme Ju, enyime ñko ke akpanikọ ete ke Enye edi Kraist (Andinyaña)? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Edi ñnyin imọdiọñọ ebiet emi owo emi otode; ke ini Andinyaña oro edidide, owo ndomokiet ididiọñọke ebiet emi Enye editode.”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Nte Jisọs okosuk ekpepde ñkpọ ke Edisana Ebiet, Enye ama ofiori ke ọkpọsọñ uyo, ete, “Ih, mbufo emediọñọ Mi, ye ebiet emi Ami ntode. Edi Ami nduhọ mi ke odudu idem Mi, edi Enyemi ọkọdọñde Mi edi anam akpanikọ. Mbufo idiọñọke Enye. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />Edi Ami mọdiọñọ Enye, koro Ami ntode ke Enye, onyuñ edi Enye ọkọdọñ Mi.”<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Mmọ ema eñwana ndimum Enye, edi owo ndomokiet iketukke Enye ubọk koro ini Esie mikekemke kaña.<verse eid="JHN 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 7:31" />Kpa ye oro ediwak owo ke akwa otu oro ema ebuọt idem ye Enye, enyuñ ebup ete, “Ke ini Kraist (Andinyaña) oro edidide, nte Enye eyenam mme utibe idiọñọ akan owo emi?”<verse eid="JHN 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Mme Farisi ema ekop nsukuyo otu owo emi ebaña Enye, do ke akwa oku ye mme Farisi ekedọñ ubak mme ekpeme Edisana Ebiet ekemum Jisọs. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />Jisọs ama ọdọhọ ete, “Ami ndu ye mbufo ke esisit ini, ndien Ami mfiak ntiene Enyemi ọkọdọñde Mi. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Mbufo eyeyom Mi edi idikwe Mi, koro mbufo midikemeke ndisim ebiet emi Ami ndude.”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Mme Ju emi ema etiñ kiet ye eken ete, “Owo emi oyom ndika mmọñ emi ñnyin midikemeke ndiyom Enye ñkut? Nte Enye oyom ndika ke mme ikpọ obio mme Krik emi mme Ju eduñọde, ñnyuñ ñkekpep mme Krik ñkpọ?” <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Mme ikọ Esie emi ewọrọ didie, “Mbufo eyeyom Mi, edi mbufo idikwe Mi.” Ye “Ebiet emi Ami ndude mbufo idikemeke ndisim do?” <verse eid="JHN 7:36" /><verse number="37" style="v" sid="JHN 7:37" />Akpatre usen usọrọ oro ekedi ata akpan usen, Jisọs ama adaha ada onyuñ ofiori ke ọkpọsọñ uyo, ete, “Edieke itọñ mmọñ asatde owo ndomokiet yak enye edi edibọ Mi mmọñ ọñwọñ. <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Owo ekededi emi onimde Mi ke akpanikọ, nte ñwed Abasi ama eketiñ, udiọñ idim mmọñ uwem eyefehe ke esit idem esie.” <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Enye eketiñ emi abaña Edisana Spirit emi mme mmọ emi ekenimde ke akpanikọ edibọde. Tutu osim ini oro ikọnọhọ kaña Edisana Spirit koro Jisọs mikedọkke ke ubọñ kaña.<verse eid="JHN 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Ke ini mme ubak owo ekekopde mme ikọ emi, mmọ ema edọhọ ete, “Ke akpanikọ, Owo emi edi Prọfet.” <verse eid="JHN 7:40" /><verse number="41" style="v" sid="JHN 7:41" />Ndusuk owo ema edọhọ ete, “Enye edi Andinyaña.” Edi mme mmọ efen ema ebup ete, “Andinyaña ekeme didie ndito ke Kalili?” <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Nte ñwed Abasi itiñke ite ke Kraist oro edito ke ubon Defid ye ke Betelehem, obio emi Defid okoduñde? <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Ke ntak emi ubahade ama oduk ke otu owo oro ke ntak Jisọs. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Ubak mmọ ema eyom ndimum Enye, edi owo baba kiet iketukke Enye ubọk.<verse eid="JHN 7:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Ke akpatre, mme ekpeme Edisana Ebiet ema efiak edem ebine akwa oku ye mme Farisi, emi ekebupde mmọ ete, “Ntaha mbufo midaha Enye iduk idie?”<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />Mme ekpeme Edisana Ebiet ema ebọrọ ete, “Akananam baba owo ndomokiet itiñke ikọ ke uduot usuñ emi owo emi etiñde.”<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />Mme Farisi ema ebup mmọ ete, “Ewut ñnyin nte ke Enye etimede mbufo ñko?” <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />“Nte mbufo emekut owo Farisi mme andikara mme Ju ndomokiet ọbuọtde idem ye Enye? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Iduhọ! Ke mibọhọke mme otu ndisime emi midiọñọke ñkpọ ndomokiet ibaña mme mbet Moses, isuñi Abasi odoro mmọ ke idem.”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Nikodimọs emi ama okososobo ye Jisọs ekedi kiet ke otu mmọ, ndien ama obup mbume, ete, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“Nte mbet ñnyin enyime etip owo ikpe ke ini owo mibemke iso ikop ito enye, ndiduñọde mfiọk se enye akade iso ndinam?”<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />Mmọ ema ebọrọ enye ete “Afo onyuñ oto Kalili ñko? Tim duñọde ñwed Abasi se, afo eyekut ete ke Prọfet ndomokiet itoho ke Kalili.” <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />Ndien owo kiet kiet ama ọnyọñ ufọk esie.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s1">“Enye Mme Mmọ Emi Edoride Fi Ikọ?”</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Edi Jisọs ama afiak aka obot Ọlif. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Tughi tughi usen ubọk ke ndañnsiere, Jisọs ama afiak aka Edisana Ebiet. Mme otu owo ema ekanade Enye ekuk, ndien Enye ama etetie onyuñ ọtọñọ ndikpep mmọ ñkpọ <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Nte Enye okosuk etiñde ikọ, ikpọ owo mme Ju ye mme Farisi ema eda eyen añwan emi ekemumde nte esinde efibe edi, enyuñ enam enye ọwọrọ ada ke iso kpukpru owo.<verse eid="JHN 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 8:4" />Ndien ema ekot Jisọs ete, “Andikpep, ñnyin ikomum eyen añwan emi ke idem itie emi enye esinde efibe. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Ke mbet ñnyin Moses ama owuk ete yak etọñ utọ añwan oro ke itiat. Idahaemi Afo ọdọhọ didie?”<verse eid="JHN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 8:6" />Mmọ ekeda mbume emi nte afia ndida ñnyene isọñ ndidori Enye ikọ. Edi Jisọs ama ọnuhọ ke isọñ onyuñ ọtọñọ ndiwet ñkpọ ye nnuenubọk Esie ke isọñ. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Nte mmọ ekekade iso ndibup Enye mbume, Enye ama emenerede idem onyuñ ọdọhọ mmọ ete, “Edieke odude owo mbufo ndomokiet emi akananam minamke idiọkñkpọ, yak enye ebem iso emen itiat ọtọ eyen añwan emi.”<verse eid="JHN 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 8:8" />Do ke Enye ọkọtọñọ ntak ọnuhọ onyuñ ewet ñkpọ ke isọñ. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />Ke ini mmọ ema ekekop mme ikọ emi, mmọ ema etọñọ ndidiañade kiet kiet ñnyọñọ, ọtọñọde ke mme ikpọ oku, tutu Jisọs ọkọsuhọ ikpọñ ye eyen añwan oro.<verse eid="JHN 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 8:10" />Jisọs ama emenerede idem onyuñ obup eyen añwan oro ete, “Eyen añwan, enye mmọ? Nte, owo ndomokiet ibiomke fi ikpe?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Enye ama ọbọrọ ete, “Ete, baba mmọ ndomokiet ibiomke mi ikpe.” Jisọs ama ọdọhọ enye ete, “Ke ntre, Ami ñko mbiomke fi ikpe, nyọñ idahaemi, edi sana uwem idiọkñkpọ fo yak.”<verse eid="JHN 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Ke ini Jisọs ọkọtọñọde ntak etiñ ikọ ọnọ mme otu owo, Enye ama ọdọhọ ete, “Ami ndi uñwana ererimbot, owo ekededi emi etienede Mi enye enyene uñwana uwem, ndien enye idisañake ke ekim.”<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />Mme Farisi ema efaña ye Enye ete, “Ke emi Afo etie ntiense idem Fo, se Afo etiñde isọñọke baba ñkpọ kiet.”<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />Jisọs ama ọbọrọ mmọ ete, “Ekpededi Ami ntie ntiense idem Mi, se Ami ntiñde edi akpanikọ koro Ami ndiọñọde ebiet emi Ami ntode ndi mi, ñnyuñ ndiọñọ ebiet emi Ami ñkade. Edi mbufo inyeneke ifiọk ibaña ebiet emi Ami ntode ndi mi, mme ebiet emi Ami ñkade. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Mbufo ebiere ikpe ke idaha ifiọk owo, Ami mbiomke owo ndomokiet ikpe. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Edi edieke Ami ñkpebiomde mbufo ikpe, edibiere Mi edi nnen nnen koro Ami mmendaha ikpọñ. Ami nda ye Ete emi ọkọdọñde Mi. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Emewet ke mbet mbufo ete, ke ntiense iba ema etiñ ikọ kiet, se mmọ etiñde edi akpanikọ. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Ami ntie ntiense mbaña idem Mi, ndien Ete Mi emi ọkọdọñde Mi onyuñ etie ntiense abaña Mi.”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />Mmọ ema ebup Enye ete, “Enye Ete Fo?” Jisọs ama ọbọrọ ete, “Mbufo idiọñọke Mi, mme ndidiọñọ Ete Mi, edieke mbufo ekpediọñọde Mi, mbufo ekpediọñọ Ete Mi ñkọ.”<verse eid="JHN 8:19" /></para>
  <para style="s1">Ediwak Owo Ema Etọñọ Ndinim Ke Akpanikọ Ñnyuñ Neni</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Jisọs eketiñ mme ikọ emi ke ini Enye akade iso ekpep ñkpọ ke Edisana Ebiet ke nde emi ekperede itie usin enọ. Kpa ye oro owo ndomokiet ikemumke Enye koro ini Esie ikọyọhọke.<verse eid="JHN 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Jisọs ama ọtọñọ ntak etiñ ọnọ mmọ ini kiet efen ete, “Ami mmọñ ñnyọñ ndien mbufo eyeyom Mi, ndien mbufo eyekpa ke idiọkñkpọ mbufo. Ebiet emi Ami ñkade mbufo ikemeke ndisim do.”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />Mme ikọ emi ama anam mme Ju ebup ete, “Nte Enye oyom ndiwot idem Esie? Mme oro ekpedi ntak emi enye ọdọhọde ete, ebiet emi Ami ñkade mbufo ikemeke ndisim do?”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />Edi Jisọs ama aka iso nditiñ ete, “Mbufo eto ke ererimbot mi ke isọñ, Ami nto ke enyọñ. Mbufo edi eke ererimbot; Ami ndighe eke ererimbot. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Ntak edi oro ñkọdọhọde mbufo nte ke eyekpaña ke mme idiọkñkpọ mbufo, edieke mbufo minimke ite ke Ami ndi Enyemi Ami ndide, ke akpanikọ mbufo eyekpaña ke idiọkñkpọ mbufo.”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />Mmọ ema ebup Enye ete, “Afo emi ededi anie?” Jisọs ama ọbọrọ ete, “Kpa se Ami mma ñketetiñ nnọ mbufo toto ke editọñọ ke Ami ndi. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Mme ata ediwak ñkpọ edu emi Ami ñnyenede nditiñ ñnyuñ nda mbiom mbufo ikpe. Enye emi ọkọdọñde Mi, ke usuñ kiet ekededi edi anam akpanikọ, ndien Ami ñko ñnyuñ ntiñ nnọ ererimbot kpa se Ami ñkopde nto Enye.” <verse eid="JHN 8:26" /><verse number="27" style="v" sid="JHN 8:27" />Mmọ ikọdiọñọke ite ke Enye eketiñ ikọ emi ọnọ mmọ abaña Ete Esie.<verse eid="JHN 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 8:28" />Do ke Jisọs ọkọdọhọ mmọ ete, “Ke ini mbufo ema emenede Eyen Owo ke enyọñ, mbufo eyediọñọ ete ke Ami ndi Enyemi Ami ndide; ini oro ke mbufo edifiọk ete ke Ami nnamke ñkpọ baba kiet ke idem Mi, edi ntiñ kpasuk se Ete ekekpepde Mi. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Enyemi ọkọdọñde Mi odu ye Ami, Enye ikpọñke Mi ikpọñ koro Ami nnamde se inemde Enye esit kpukpru ini.”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />Ke adañaemi Enye okosuk etiñde ikọ, ediwak owo ema ebuọt idem ye Enye. <verse eid="JHN 8:30" /><verse number="31" style="v" sid="JHN 8:31" />Jisọs ama ọdọhọ mme Ju oro ekebuọtde idem ye Enye, ete, “Edieke mbufo edisukde ibuot inọ ukpepñkpọ Mi, mbufo eyetim edi mme mbet Mi. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />Mbufo eyefiọk akpanikọ, ndien akpanikọ eyenam mbufo ewọrọ ke ufin.”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />Mmọ ema ebọrọ Enye ete, “Ñnyin idi ubon Ebraham ndien akananam ñnyin idukke ufin inọ owo baba kiet. Afo ekeme didie ndien ndidọhọ ete ke eyenam ñnyin iwọrọ ke ufin?”<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />Jisọs ama ọbọrọ mmọ ete, “Ami ntiñ akpanikọ nnọ mbufo, nte, owo ekededi emi anamde idiọkñkpọ edi ofin idiọkñkpọ.<verse eid="JHN 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 8:35" />Ofin inyeneke iwuk itie ke ekpuk, edi eyen edi inyene ekpuk ke nsinsi. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Ke ntre edieke Eyen Owo anamde mbufo ewọrọ ufin, mbufo eyewọrọ ufin ke akpanikọ. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Ami mmọfiọk nte ke mbufo eto ubon Ebraham, kpa ye oro mbufo ke eyom usuñ ndiwot Mi, koro mbufo esinde ukpepñkpọ Mi. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Ami ntiñ mbaña se Ete Mi ama okowut Mi, edi mbufo enam se ekopde eto ete mbufo.”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />Mmọ ema ebọrọ Enye ete, “Ebraham edi ete ñnyin.” Jisọs ama ọbọrọ ete, “Edieke mbufo ekpedide ata nditọ Ebraham ke akpanikọ, mbufo ekpenam mme ukem utom emi enye akanamde.” <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Nte edide, idahaemi mbufo emebiere ndiwot Mi koro Ami ntiñde akpanikọ emi ñkopde nto Abasi nnọ mbufo. Ebraham ikanamke utọ ñkpọ eke etiede ntem. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />“Mbufo enam mme ñkpọ emi ete mbufo anamde.” Mmọ ema efaña eti eti ete, “Ñnyin idighe nditọ iban akpara. Ete kiet emi ñnyin inyenede edi Abasi ke idem Esie.”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Jisọs ama ọdọhọ mmọ ete, “Edieke Abasi ekpedide Ete mbufo, mbufo ekpema Mi, koro Ami ntode ke Abasi, ndien idahaemi, Ami mmọ mi. Ami ñkedighe ke idem Mi, edi Enye ọkọdọñ Mi. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Ntak emi usem Mi miñwañake mbufo edi koro mbufo mikemeke ndikop se Ami ntiñde. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Mbufo edi inyene ete mbufo, andidiọk (Setan), ndien mbufo eyom ndinam uduak ete mbufo. Enye ekedi owot owo toto ke editọñọ, ikonyuñ inyimeke akpanikọ, koro akpanikọ baba kiet miduhọ enye ke idem. Ke ini emi enye osude nsu, enye esem usem obio emana esie, koro enye edide osunsu ye ete kpukpru oruk nsu. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Edi sia ntiñde akpanikọ, mbufo inimke Mi ke akpanikọ.”<verse eid="JHN 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 8:46" />“Nte owo mbufo ndomokiet ekeme ndibiom Mi ikpe kabaña idiọkñkpọ? Edieke Ami ntiñde akpanikọ, ntaha mbufo minimke Mi ke akpanikọ-ọ? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Owo ekededi emi edide eke Abasi okokop se Abasi etiñde. Ntak emi mbufo mikopke edi koro mbufo idighe eke Abasi.”<verse eid="JHN 8:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />Mme Ju ebọrọ Enye ete, “Nte ñnyin inenke edieke idọhọde ite ke Afo edi owo Sameria ye enyemi mme ndiọi spirit eduñde ke idem?”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Jisọs ama ọbọrọ ete, “Ami ñnyeneke idiọk spirit ke idem Mi. Ami nnọ Ete Mi ukpono edi mbufo ikponoke Mi. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Ami ñyomke itie ukpono nnọ idem Mi. Owo kiet odu emi oyomde ukpono oro, emi etebede Mi ikpe. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Ami ntiñ akpanikọ nnọ mbufo nte, edieke owo omumde ikọ Mi akama enye idikpaha ñkpa.”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Mme Ju ema edọhọ Enye ete, “Idahaemi ñnyin imetim idiọñọ ite ke Afo emenyene ndiọi spirit ke idem! Ebraham ama akpa, kpasuk ntre ñko ye mme Asiak Uduak Abasi eken. Kpa ye oro Afo ọdọhọ ete edieke owo enimde ikọ Fo ke akpanikọ enye iditabike ñkpa. <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Nte Afo omokpon akan ete ñnyin Ebraham? Enye ama akpa, ndien kpa ntre ye mme Asiak Uduak Abasi. Afo ekere ete Imọ idi anie?” <verse eid="JHN 8:53" /><verse number="54" style="v" sid="JHN 8:54" />Jisọs ama ọbọrọ ete, “Edieke Ami ñkponode idem mi, ukpono oro iwọrọke ñkpọ ndomokiet, Ete Mi emi mbufo edọhọde ete ke onyuñ edi Ete mbufo edi Enyemi emenerede Mi ọnọ itie ukpono. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Okposuk edi nte mbufo midiọñọke Enye, Ami mọdiọñọ Enye. Edieke Ami ñkpọdọhọde nte ke Ami ndiọñọke Enye, Ami ñkpedi osunsu nte mbufo, edi Ami mmọdiọñọ Enye, ñnyuñ nnim mme ikọ Esie. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Ete mbufo Ebraham ama adara ke ekikere edikut usen Mi; enye ama okut usen oro onyuñ adat esit.”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Mme Ju ema edọhọ Enye ete, “Afo udighe kaña isua aba ye duop ke emana, ndien afo okut Ebraham?”<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />Jisọs ama ọbọrọ ete, “Ami ntiñ akpanikọ nnọ mbufo nte mbemiso Ebraham akamana, Ami mma ndodu!”<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />Ke ntak emi mmọ ema etañ itiat nditọñ Enye, edi Jisọs ama edibe onyuñ ọfiọnọde ọwọrọ ke añwa Edisana Ebiet.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s1">Jisọs Ọkọk Owo Emi Akamanade Nnan</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Nte Enye akasañade ke usuñ Enye ama okut owo emi ekedide nnan toto ke emana esie.<verse eid="JHN 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 9:2" />Mme mbet Esie ema ebup Enye, ete, “Andikpep, anie ekenam idiọkñkpọ, eyen eren emi, mme ete ye eka esie, emi esinde enye amana nnan?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />Jisọs ama ọbọrọ ete, “Idighe enye, mme ete ye eka esie ekenam idiọkñkpọ, edi emi eketibe man otodo utom Abasi ayarade owut idem ke uwem esie. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Adaña nte edide uwemeyo ñnyin inyene ndinam utom Enyemi ọkọdọñde Mi. Okoneyo ke ededi emi owo baba kiet midikemeke ndinam utom. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Kadaña emi Ami ndude ke ererimbot, Ami ndi uñwana ererimbot.”<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Ke enye ama eketiñ ntem, Enye ama ọkọk etap enim ke isọñ, ada etap emi abuak ye ntan ọwọrọ mbat, ndien ada mbat oro eyet owo nnan oro ke enyin esie mbiba. <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />Jisọs ama ọdọhọ enye ete, “Ka keyet iso fo ke ñkpọdiọhọ mmọñ Silọm” (emi ọwọrọ “Ema edọñ”). Owo emi ama aka ekeyet iso esie ndien enye ama afiak edem edi ye enyin esie mbiba nte okutde usuñ.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Mme mbọhọiduñ esie ye mme mmọ eken ekam esikutde nte enye ebeñede ebeñe, ema ebup ete, “Nte emi idighe owo emi esitiede mi ebeñe ebeñe?”<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />Ndusuk owo ema enyime ete ke edi enye. Mme ubak owo ema ekañ ete ke idighe enye, ke edi owo enye emi enyene mbiet esie. Edi enye enyene idem ama eyire ọbọrọ ete, “Ami ndi owo oro.”<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Mmọ ema ebup enye ete, “Didie ndien ke ekenam fi okut usuñ?”<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Enye ama ọbọrọ ete, owo emi mmọ ekotde Jisọs akanam mbat ndien eyet mi ke enyin mi mbiba. Enye ama ọdọhọ mi ete yak ñka ke Silọm ñkeyet iso. Do ami mma ñka ñkeyet iso ndien ami ñkeme ndikut usuñ.<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />Mmọ ema ebup enye ete, “Enye Enye?” Enye ama ọbọrọ ete, “Ami ndiọñọke.”<verse eid="JHN 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Mmọ ema eda owo oro ekedide nnan ewọrọ ke iso mme Farisi. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Usen emi Jisọs akanamde mbat ada atat owo emi enyin ekedi ke usen ibet (Sabat) <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Mme Farisi ema etọñọ ntak ebup owo oro nte enye akasañade okut usuñ. <verse eid="JHN 9:15" /><verse number="16" style="v" sid="JHN 9:16" />Enye ama etiñ ọnọ mmọ ete, “Enye ekeyet esisit mbat ke enyin mi mbiba, ami mma ñyet iso mi, ndien idahaemi ami mmekeme ndikut usuñ.”<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Ke akpatre, mmọ ema etọñọ ntak ewọñọde ebine owo emi ekedide nnan enyuñ ebup enye ete, “Nso ke afo ekeme nditiñ mbaña owo oro?” Edi enyin fo ke Enye akatat! Owo oro ama ọbọrọ ete, “Enye edi Asiak Uduak Abasi.” (Prọfet).<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Mme Ju, tutu oro ikenimke ke akpanikọ nte ke owo oro ekedi nnan, ndien ke ema etat enye enyin; tutu mmọ ekedọñ ekekot ete ye eka owo emi. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />Mmọ ema ebup ete ye eka owo emi ete, “Nte emi edi eyen mbufo? Ndien enye edi enyemi mbufo edọhọde ete ke akamana nnan? Enye asaña didie ndien okut usuñ idahaemi?”<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />Ete ye eka esie ema ebọrọ ete, “Ñnyin imọfiọk ite ke enye edi eyen ñnyin erenowo, ndien ñnyin imenyuñ idiọñọ ite ke enye akamana nnan. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Edi nte enye ekemede ndikut usuñ idahaemi, mme owo emi atatde enye enyin, ñnyin idiọñọke. Ebup enye, enye okpon ekem; ndien enye eyetiñ ikọ idem esie.”<verse eid="JHN 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 9:22" />Ete ye eka esie eketiñ emi koro mmọ ekebakde mme ikpọ owo mme Ju, koro kañakaña mme Ju ema ebebiere enim ete owo ekededi emi editiñde añwa añwa ete ke Jisọs edi Kraist, eyesio enye efep ke ufọk akam mme Ju. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Ntak ekedi oro eka ye ete esie ekedọhọde ete, “Enye okpon ekem; ebup enye.”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Ntre mmọ ema etọñọ ntak ekot owo emi ekedide nnan enyuñ edọhọ enye ete, “Nọ Abasi ubọñ ke nditiñ akpanikọ, koro ñnyin imọdiọñọ ite ke owo oro edi anam idiọkñkpọ.”<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Enye ama ọbọrọ ete, “Mme enye edi anam idiọkñkpọ mme idighe, ami ndiọñọke mbaña. Edi ñkpọ kiet ke ami mfiọk. Ami ñkedi nnan, edi idahaemi ami mokut usuñ.”<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />Do ke mmọ ekebup enye ete, “Enye akanam didie ye afo? Enye akasaña didie atat fi enyin?”<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />Enye ama ọbọrọ mmọ ete “Ami mmantetiñ nnọ mbufo ndien mbufo ikekpañke utọñ. Ntaha mbufo eyomde nditọñọ ntak ñkop-e? Nte mbufo eyom ndikabade ndi mme mbet Esie ñko?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Mmọ ema eñwaña isuñi efuk enye enyuñ edọhọ ete, “Afo edi mbet owo oro, ñnyin idi mme mbet Moses; <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Ñnyin imọfiọk ite ke Abasi ama etiñ ikọ ye Moses, edi, ama edi owo oro ñnyin itimke idiọñọ ebiet emi enye otode edi.”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Owo oro ekedide nnan ama ọbọrọ ete, “Nso utibe ñkpọ idi emi, mbufo idiọñọke ebiet emi Enye otode, edi Enye ama atat mi enyin mbiba! <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Ñnyin imọfiọk ite ke Abasi ikpañke utọñ inọ mme anam idiọkñkpọ. Enye akpañ utọñ ọnọ owo emi abakde Enye onyuñ anamde uduak Esie. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Owo ndomokiet akananam ikopke ibaña editat enyin owo emi akamanade nnan. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Edieke owo emi mikpetoho ke Abasi, Enye ikpekemeke ndinam ñkpọ ndomokiet.”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Mmọ ema ebọrọ se enye eketiñde, ete, “Afo ọkọbuhọ ke idiọkñkpọ ke usen emana fo, afo ekeme didie ndikpep ñnyin ñkpọ?” Ndien mmọ ema emum enye efuñ ke añwa.<verse eid="JHN 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Jisọs ama okop ete ke ema esio enye eduọk ke añwa, ndien Enye ama ọdọhọ enye ke ini Enye okosobode enye, ete, “Nte afo emenim Eyen Owo ke akpanikọ?”<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />Owo oro ama ebup ete, “Enye edi anie Ete? Tiñ nọ mi man ami nnim Enye ke akpanikọ.”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />Jisọs ama ọdọhọ ete, “Afo omokut Enye idahaemi; ke editim ntiñ edi Enye etiñ ikọ emi ye afo.”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Do ke owo emi ọkọdọhọ, ete, “Ọbọñ ami menim ke akpanikọ,” ndien enye atuak ibuot ọnọ Enye.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Jisọs ama ọdọhọ ete, “Ami ñkedi ke ererimbot emi ndikpe ikpe, man otodo nnan okut usuñ, ndien mme mmọ emi ekekutde usuñ ekabarede edi nnan.”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Mme Farisi emi ekedade do ye Enye, ema ekop nte Enye eketiñde mme ikọ emi, ndien mmọ ema ebup Enye ete, “Okudi ikọ fo ọwọrọ ete ke ñnyin idi nnan ñko?”<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />Jisọs ama ọbọrọ ete, “Edieke mbufo ekpedide nnan, ikpe idiọkñkpọ ikpetipke mbufo; edi ke emi mbufo edọhọde ete ke mmimọ imekeme ndikut usuñ, utibikpe mbufo osuk anana ọnọ mbufo.”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s1">“Ami Ndi Eti Ekpeme-Erọñ”</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />“Ami ntiñ akpanikọ nnọ mbufo, owo emi midukke ufọk erọñ ito inua otop, edi ọdọkde oduk ke usuñ efen, edi inọ ye owo ñwo. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />Owo emi odukde oto inua otop edi Enyemi ekpemede erọñ Esie.<verse eid="JHN 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 10:3" />Ekpeme usuñ osio usuñ ọnọ Enye ndien mme erọñ ekpañ utọñ enọ uyo Esie. Enye okot mme erọñ esie ke enyiñ mmọ, onyuñ ada mmọ ọwọrọ añwa. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Ke enye ama akada mmọ kpukpru ọwọrọ ke añwa, enye ebe iso ndien mme erọñ esie etiene enye koro mmọ ediọñọde uyo esie. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Edi mmọ iditieneke esen owo, ke akpanikọ mmọ eyefeñe ekpọñ enye koro mmọ midiọñọke uyo esen owo.”<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />Jisọs eketiñ ikọ emi nte mbuk, edi mmọ ikọdiọñọke se Enye eketiñde ọnọ mmọ ọwọrọde. <verse eid="JHN 10:6" /><verse number="7" style="v" sid="JHN 10:7" />Do ke Jisọs ọkọtọñọ ntak etiñ ete, “Ami ntiñ akpanikọ nnọ mbufo, Ami ndi inua otop ufọk erọñ. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Kpukpru mme mmọ emi ekebemde Mi iso edi, ekedi mme inọ ye mbon ñwo, edi mme erọñ ikekpañke utọñ inọ mmọ. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Ami ndi lnua Otop, owo ekededi emi ebede ke Ami oduk eyenyaña enye. Enye eyeduk onyuñ ọwọrọ, enye eyenyuñ okut awawa mbiet. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Ñkukure ntak emi inọ edide edi ndiyip ñnyuñ ñwot ñnyuñ nsobo. Ami mmedi man otodo mmọ ekpekam enyene uwem, enyuñ enyene uwem emi nte ọyọhọde ọfọn.”<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />Ami ndi Eti ekpeme-erọñ. Eti ekpeme-erọñ ebeñe idem ndikpa ke ntak mme erọñ. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Enye emi ekpedekpe, idighe ekpeme-erọñ emi enyenede mme erọñ, ke ntre ke ini enye okutde nte ekpe edide, enye ọkpọñ mme erọñ onyuñ efehe. Do ndien ke ekpe edisin eñwan ye mme erọñ onyuñ asuan mmọ. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Owo emi efehe ọkpọñ mme erọñ koro enye edide ñkpeutom emi mikereke ñkpọ ndomokiet ibaña mme erọñ.<verse eid="JHN 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14" />“Ami ndi eti ekpeme-erọñ, Ami mmọdiọñọ mme erọñ Mi, ndien mme erọñ Mi ñko ediọñọ Mi. <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />Kpa nte Ete ọdiọñọde Mi, ndien Ami ñko ñnyuñ ndiọñọ Ete, ñnyuñ ñyak uwem Mi nduọk ke abaña mme erọñ. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Ami mmenyene mme erọñ efen emi miduhọ ke otu mme erọñ enye emi. Ami ñnyene ndida mmọ ndi ñko. Mmọ ñko eyekpañ utọñ enọ uyo Mi, ndien mmọ eyedi otu erọñ kiet ye ekpeme-erọñ kiet ñko.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />Ntak emi ete mi amade Mi edi koro mma yak uwem Mi nnim man otodo ñkpetọñọ ntak mmen. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Baba owo ndomokiet ibọhọ Mi uwem Mi, edi Ami ñyak nnọ ke uduak ye unyime esit Mi. Ami mme nyene odudu ndiyak uwem Mi nnọ, mmonyuñ ñnyene odudu nditọñọ ntak mbọ. Ami mbọ ewuhọ emi nto Ete Mi.”<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Ubahade ama ọtọñọ ntak odu ke otu mme Ju ke ntak mme ikọ emi. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Ediwak mmọ ema edọhọ ete, “Idiọk spirit oduk enye idem onyuñ anam ibuot abiara Enye. Ntaha mbufo ekpañde utọñ enọ Enye-e?” <verse eid="JHN 10:20" /><verse number="21" style="v" sid="JHN 10:21" />Edi mme mmọ efen ema edọhọ ete, “Mme ikọ emi idighe mme ikọ emi owo emi mme ndiọi spirit edukde ke idem ekpetiñde. Ndiọi spirit ekpekeme didie nditat owo nnan enyin?”<verse eid="JHN 10:21" /></para>
  <para style="s1">Tim Tiñ Anwaña Ñnyin</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Ama edikem ini usọrọ edinam Edisana Ebiet asana ke Jerusalem. Ndien ekedi ke ini ọkpọsọñ ekarika. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />Ndien Jisọs okodu ke Edisana Ebiet emi ekekotde edian Sọlọmọn. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Ikpọ owo mme Ju ema ekanade Enye ekuk, enyuñ ebup Enye ete, “Adaña didie ke Afo edinam ñnyin itak ke eyighe? Edieke Afo edide Andinyaña (Kraist), tiñ nọ ñnyin añwa añwa.”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Jisọs ama ọbọrọ ete, “Ami mma ntetiñ nnọ mbufo, edi mbufo inimke ke akpanikọ. Mme utibe ñkpọ emi Ami nnamde ke Enyiñ Ete Mi etiñ ikọ ebaña Mi. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />Edi mbufo inimke Mi ke akpanikọ koro mbufo idighe kiet ke otu erọñ Mi. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Mme erọñ Mi ekpañ utọñ enọ uyo Mi. Ami mmọdiọñọ mmọ, ndien mmọ etiene Mi. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Ami nnọ mmọ nsinsi uwem, ndien mmọ iditakke; owo ndomokiet ikemeke ndiwamade mmọ mbọ Mi ke ubọk. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Ete Mi emi ọnọde Mi mmọ okpon akan kpukpru ñkpọ; owo ndomokiet ikemeke ndiwabade mmọ mbọ ke ubọk Ete. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Ami ye Ete Mi inyuñ idi kiet.”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Ini kiet efen mme Ju ema etañ itiat ndida ntọñọ Enye ñwot.<verse eid="JHN 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 10:32" />Edi Jisọs ama ọdọhọ mmọ ete, “Ami mmowut mbufo mme ediwak utibe ñkpọ emi etode Ete, ke ntak ewe ke otu emi ke mbufo eyom nditọñọ Mi ke itiat?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />Mmọ ema ebọrọ Enye ete, “Ñnyin iyomke nditọñọ fi ke itiat ke ntak eti utom ndomokiet, edi, edi ke usuñ emi Afo adade ọsọñọ enyin ye Abasi: Afo edi owo kpọt kpọt, edi añwana ndinam idem Fo Abasi.”<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Jisọs ama ọbọrọ ete, “Nte iwetke isin ke ñwed ibet mbufo, ete, Ami mmọdọhọ nte ke mbufo edi mme abasi? <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Mbet eketiñ abaña mme mmọ oro ekedọñde ikọ Abasi enọ nte mme abasi; ndien owo ikemeke ndibiat se ewetde ke ñwed Abasi. <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />Ekeme nditiñ nso ye Ami emi Ete ekemekde onyuñ osio ọdọñ ke ererimbot emi? Ntaha edọhọde ndien ete ke Ami mmọsọñọ enyin ye Abasi ke emi ndọhọde nte ke Ami ndi Eyen Abasi-e? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Ekunim Mi ke akpanikọ edieke Ami mme nnamke mme utom Ete Mi. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Edi edieke nnamde mme utom Ete Mi, okposuk edi emi mbufo mminimke Mi ke akpanikọ, akpana mbufo enim mme utibe utom idiọñọ emi ke akpanikọ, man otodo mbufo etim ediọñọ ete ke Ete odu ke Ami, Ami ñko ñnyuñ ndu ke Ete.”<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />Ini kiet efen mmọ ema eyom ndimum Enye, edi Enye ọfiọnọde ọbọhọ mmọ. <verse eid="JHN 10:39" /><verse number="40" style="v" sid="JHN 10:40" />Jisọs ama ọtọñọ ntak ebe inyañ Jọdan aka ke ebiet emi Jọn ekesinimde babtisim onyuñ odu do. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Ndien ediwak owo ema edibine Enye. Mmọ ema edọhọ ete, “Okposuk edi nte Jọn mikanamke mme utibe ñkpọ, edi kpukpru se enye eketiñde abaña owo emi ekedi akpanikọ.” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Ndien ediwak owo ke ebiet oro ema enim Jisọs Kraist ke akpanikọ.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s1">Ñkpa Lasarọs</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Owo kiet emi ekekerede Lasarọs ama ọdọñọ. Enye okoto Betani, obio iñwañ emi Meri ye eyen eka esie Mata eketode. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />Meri emi eyen eka esie ọkọdọñọde, ekedi enye emi ọkọduọkde Ọbọñ enem ufuọñ aran okonyuñ adade idet esie ọkwọhọrede ikpat Jisọs. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Nditọ eka Lasarọs iba ema enọ etop esọk Jisọs ete, “Ọbọñ, ufan emi Afo amade kọdọñọ.”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Ke ini Jisọs okokopde etop emi, Enye ama ọdọhọ ete, “Udọñọ emi idisuñọke ke ñkpa. Edi ndida ubọñ nnọ Abasi man otodo Enye Abasi ọbọ ubọñ oto ke esit.”<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />Jisọs ama ama Mata ye eyen eka esie añwan ye Lasarọs eti eti. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Ke ini Enye okokopde ete ke Lasarọs kọdọñọ, Enye ama osuk etie ke ebiet emi Enye okoduñde ke ñkpọ nte usen iba efen. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />Do ke Enye ọkọdọhọ mme mbet Esie ete, “Eyak ñnyin ifiak ika Judia.”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />Mme mbet ema edọhọ Enye ete, “Andikpep, ibighike bighi mme Ju ekeyom nditọñọ Fi ke itiat, ndien Afo onyuñ oyom ndifiak ñka Judia?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />Jisọs ama obup ete, “Nte idighe awa ñkanika duopeba odu ke uwemeyo? Owo emi asañade ke uwemeyo isituakke ukot, koro enye okutde usuñ oto uñwana ererimbot emi. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Edi ke enye ama asaña isañ ke okoneyo ke enye edituak ukot koro enye minyeneke uñwana.” <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />Ke Enye ama eketiñ mme ikọ emi ama, Enye ama aka iso etiñ ọnọ mmọ ete, “Ufan ñnyin Lasarọs ede idap, edi Ami ke ñka do ndidemede enye.”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Mme mbet Esie ema ebọrọ ete, “Ọbọñ edieke enye edede, idem eyesọñ enye.” <verse eid="JHN 11:12" /><verse number="13" style="v" sid="JHN 11:13" />Jisọs eketiñ abaña ñkpa esie, edi mme mbet Esie ekekere ete mme Enye etiñ abaña ikpuikpu idap.<verse eid="JHN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14" />Do ndien ke Enye akasian mmọ añwa añwa ete, “Lasarọs akpa, <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />ndien ke ntak mbufo man otodo mbufo enim ke akpanikọ, Ami mmokop inemesit sia Ami mme ñkeduhọ do. Edi eyak ñnyin ika ibine enye.”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Ndien Tọmọs emi ekotde Amanamba, ama ọdọhọ mme mbet eken ete, “Eyak ñnyin ñko ika, man ikakpa ye Enye.”<verse eid="JHN 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Ke ini mmọ ema ekesim Betani, Jisọs ama ayarade ọfiọk ete ke ema ebebuk Lasarọs ke usen inañ emi ekebede. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Betani ekedi ñkpọ nte itiat iba ye Jerusalem. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />Ndien ediwak ikpọ owo mme Ju ema edu ndidọñ Mata ye Meri esit ke ñkpa eyen eka mmọ. <verse eid="JHN 11:19" /><verse number="20" style="v" sid="JHN 11:20" />Ke ini Mata okokopde ete ke Jisọs ke edi, ama ọwọrọ ebine Enye, edi Meri ama ọsuhọ ke ufọk.<verse eid="JHN 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 11:21" />Mata ama ọdọhọ Jisọs, ete, “Ọbọñ mi, edieke Afo okpokodude mi, eyen eka mi ikpikpaha. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Edi ami mmọfiọk nte kpa ke idem idahaemi, Abasi eyenọ fi sededi emi Afo edibupde.”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Jisọs ama ọdọhọ enye ete, “Eyen eka fo eyefiak odu uwem.”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />Mata ama ọbọrọ ete, “Ami mmọfiọk nte ke enye eyedahada onyuñ enyene uwem ke akpatre usen.”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Jisọs ama ọdọhọ enye ete, “Ami ndi ediset ke ñkpa ye uwem. Owo emi enimde Mi ke akpanikọ eyedu uwem, okposuk edi nte enye ama akakpa, <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />ndien owo ekededi emi odude uwem ndien enim Mi ke akpanikọ, idikpaha. Nte afo emenim emi ke akpanikọ?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Enye ama ọbọrọ Jisọs, ete, “Ih Ọbọñ, Ami mmonim ke akpanikọ nte, ke Afo edi Andinyaña (Kraist) oro, Eyen Abasi, emi akanade nte edi ke ererimbot.”<verse eid="JHN 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Ke Mata ama eketiñ mme ikọ emi ama, enye ama afiak edem aka ufọk ndien okokot eyen eka esie Meri esik ada, onyuñ ọdọhọ enye, ete, “Andikpep edi, ndien Enye koyom fi.” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Ke ini Meri okokopde ikọ emi, enye ama adaha ada ke usọp onyuñ ebine Jisọs.<verse eid="JHN 11:29" /></para>
  <para style="s1">Jisọs Emenede Lasarọs</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 11:30" />Jisọs ikedukke kaña obio iñwañ oro edi okosuk odu ke ebiet emi Mata okosobode Enye. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />Ke ini mme Ju emi ekedude ke ufọk ndidọñ Meri esit ekekutde nte enye akadahade usọp usọp ọwọrọ anwa, mmọ ema etiene enye, ekere ete ke enye oyom ndika udi ñkatua eyen eka esie.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Ke ini Meri ama ekesim ebiet emi Jisọs okodude onyuñ okut Enye, enye ama ọduọ Enye ke ukot onyuñ ọdọhọ ete, “Ọbọñ, edieke Afo okpokodude mi, eyen eka mi ikpikpaha.”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Ke ini Jisọs okokutde nte enye atuade eyet, ye nte ikpọ owo mme Ju emi esañade ye enye etuañade, esit ama ọbuñọ Enye eti eti. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Jisọs ama obup ete, “Ekebuk enye ke mmọñ?” Mmọ ema ebọrọ Enye Ete, “Di dise Ọbọñ.” <verse eid="JHN 11:34" /><verse number="35" style="v" sid="JHN 11:35" />Jisọs ama atua eyet.<verse eid="JHN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 11:36" />Do ke mme Ju ekedọhọ ete, “Sese nte Enye akamade enye!”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Edi ubak mmọ ema edọhọ, ete, “Nte Enye emi akatatde mme nnan enyin ikpekemeke ndibiọñọ owo emi ndikpa?” <verse eid="JHN 11:37" /><verse number="38" style="v" sid="JHN 11:38" />Ama otuk Jisọs ini kiet efen, ndien Enye ama asaña aka ke udi, ekedi aba emi eketibide ke itiat enyuñ eda itiat eberi ke nsañanduk esie.<verse eid="JHN 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 11:39" />Jisọs ama ọdọhọ ete, “Ekpat itiat emi efep.” Edi Mata eyen eka akpa ñkpa ama ọdọhọ ete, “Edi Ọbọñ, ke utọ ini emi idiọk utebe eyedu, koro ekebuk enye ke ñkpọ nte usen inañ emi ekebede.”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Jisọs ama ọdọhọ enye ete, “Nte Ami ñkọdọhọke fi nte edieke afo udunimde ke akpanikọ, afo eyekut ubọñ Abasi?”<verse eid="JHN 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41" />Do ke mmọ ekekpat itiat esio. Ndien Jisọs emenerede enyin ese enyọñ onyuñ ọdọhọ ete, “Ete, sọsọño koro Afo omokop Mi. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Ami mmọdiọñọ nte ke Afo emesikop Mi kpukpru ini, edi Ami ñketiñ emi ke ntak ufọn mme mmọ emi edade mi, man otodo mmọ enim ke akpanikọ nte ke edi Afo ọkọdọñ Mi.” <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />Ke Enye ama eketiñ mme ikọ emi ama, Jisọs ama okot ke ọkpọsọñ uyo, ete, “Lasarọs, wọrọ di.”<verse eid="JHN 11:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 11:44" />Ndien akpa ñkpa ama ọwọrọ edi ye mbọbọ ọfọñ udi ye ọfọñ ke iso esie. Jisọs ama ọdọhọ ete “Etat enye mme mbọbọ udi oro, enyuñ enam enye enyọñ ufọk.”<verse eid="JHN 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Ke ntak emi, ediwak mme Ju emi ekedide ndise Meri, ndien enyuñ ekutde se Jisọs akanamde, ema eyak mbuọtidem mmọ enọ Jisọs enyuñ enim Enye ke akpanikọ. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Ubak mmọ ema eka ebine mme Farisi eketiñ enọ mmọ se Jisọs akanamde.<verse eid="JHN 11:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 11:47" />Do ke mme ikpọ oku ye mme Farisi ekekot mbon esop ete, “Ñnyin idinam didie? Sese owo emi ke ananam ediwak mme utibe ñkpọ ye mme idiọñọ. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Edieke ñnyin iyakde Enye osuk aka iso ntem, kpukpru owo eyebuọt idem mmọ ye Enye, ndien mbon Rom eyedi enyuñ ebọ ñnyin mme itie ukpono ñnyin ye idut ñnyin.”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Ndien owo mmọ kiet emi ekerede Kefas emi ekedide akwa oku ke isua oro ama ọdọhọ ete, “Mbufo idiọñọke ñkpọ ndomokiet. <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Nte mbufo ikereke ite ke ọfọn ye mbufo akan nte owo kiet akpa ọnọ kpukpru owo, akan ofuri idut nditak?”<verse eid="JHN 11:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51" />Enye, ke ofuri akpanikọ iketiñke ikọ emi ito idem esie, edi nte akwa oku isua oro enye akayarade uduak Abasi nte ke Jisọs eyekpa ọnọ idut mme Ju, <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />ndien idighe idut mme Ju ikpọñ ikpọñ, edi edikpa inọ mme nditọ Abasi emi ekesuande, man atañ mmọ obok ebiet kiet onyuñ anam mmọ edi kiet. <verse eid="JHN 11:52" /><verse number="53" style="v" sid="JHN 11:53" />Ke ntak emi ọtọñọde ke usen oro, mmọ ema ekọk mme afia ndiwot Jisọs.<verse eid="JHN 11:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 11:54" />Do Jisọs ikasañake aba isañ añwa añwa ke Judia, edi adaha aka ebiet emi ekperede isọñ utatan ke obio emi ekekotde Ifrem, onyuñ odu do ye mme mbet Esie.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Ke ini usọrọ uwọrọ ufin mme Ju ekekperede, ediwak owo ema edọk eka Jerusalem man ekenam ido edisana ke idak ukpono mmọ mbemiso ekem ini usọrọ uwọrọ ufin mme Ju. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Mmọ ema eka iso ndiyom Jisọs ndien nte mmọ ekedade ekpere Edisana Ebiet mmọ ema ebup idem mmọ ete, “Ekere didie? Nte Enye ididighedi usọrọ emi?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Edi mme ikpọ oku ye mme Farisi ema enenọ uyo ete owo ekededi emi ediyararede idiọñọ ebiet emi Jisọs odude, yak enye asian man mmimọ ika ikemum Enye.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s1">Ami Ndiduhọ Ye Mbufo Mbighi Ñkaha</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Akayak usen itiokiet ndikem usen usọrọ uwọrọ ufin. Jisọs ama ekesim Betani, ebiet emi Lasarọs okoduñde, enye emi Jisọs akanamde eset ke ñkpa. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Ema enam udia mbubreyo enọ Jisọs do, ndien Mata akañwam ndinọ udia oro, ke ini Lasarọs eketiede ke okpokoro ye Jisọs. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Do ndien ke Meri ekemen ọyọhọ ekpeme ata nsọñurua enem ufuọñ aran emi edade ñkpọ emi ekotde Nard enam, ọduọk Jisọs ke ukot ndien ada idet ibuot esie ọkwọhọde Enye ukot mbiba. Ndien ufọk oro ama ọyọhọ ye ufuọñ enem utebe aran oro.<verse eid="JHN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4" />Edi kiet ke otu mbet Jisọs, Judas Iskariọt, emi akanade nte atap Enye ke ini iso, ama afaña. <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“Ntaha owo mikenyamke enem ufuọñ aran emi, ndien emen okuk esie enọ mme ubuene-e? Aran emi ama ọyọhọ okuk owo utom kiet ke isua kiet.” <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Enye iketiñke emi koro enye ekekerede ñkpọ abaña mme ubuene, edi koro enye ekedide inọ; nte akama okuk, enye ama esiñwañwam idem esie ke se esesin ke ekpat okuk emi enye akamade ke edu inọ.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Jisọs ama ọbọrọ enye ete, “Sana enye yak, koro akana nte enye afam enem ufuọñ aran emi enim abaña usen emi edibukde Mi. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Mbufo eyenyene nditọ ubuene mi ye mbufo kpukpru ini ke otu mbufo, edi mbufo idinyeneke Mi kpukpru ini.”<verse eid="JHN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Akwa otu owo ema ekop ete ke Jisọs mmọ ke Betani, do mmọ ema eka do; mmọ ikakaha do ibaña Jisọs ikpọñ ikpọñ, edi ekedi man ekut Lasarọs emi Jisọs akanamde eset ke ñkpa ñko. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Do mme ikpọ oku ema enyuñ enam ekikere ndiwot Lasarọs ñko; <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />koro oto ke ntak esie ediwak mme Ju ema ekpọñ mmọ emi ekedade mmọ usuñ ekabade enim Jisọs ke akpanikọ.<verse eid="JHN 12:11" /></para>
  <para style="s1">Otu Owo Edara Jisọs</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Ke udiana usen, akwa otu owo emi ekedide usọrọ ema ekop ete ke Jisọs odu ke usuñ isañ ke ndidi Jerusalem. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Mmọ ema ekama mme ndak eyop ebine Enye ke usuñ, ke efefiori ete, “Osana! Edidiọñ enyene Edidem Isrel emi edide ke enyiñ Ọbọñ.”<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />Jisọs ama okut ekpri eyen enañ mbiomo ndien Enye ọdọk etie ke edem esie, nte ikọ Abasi ọdọhọde ete, <verse eid="JHN 12:14" /><verse number="15" style="v" sid="JHN 12:15" />“Ekufehe Edidem mbufo mbon Jerusalem, sese Ọbọñ mbufo ke edi; awat ke enyọñ abak enañ mbiomo.”<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Mme mbet Esie ikediọñọke mme ñkpọ emi ke akpa ifet; edi ke ini emi ema ekemenerede Jisọs esin ke ubọñ ke mmọ eketi ete ke Ñwed Abasi ama etiñ ntem abaña Enye, ndien ke mmọ ekenam nte ekewetde enọ Enye.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Ndien otu owo emi ekedude ye Enye ema eka iso ndisuan etop nte ke Enye ama okot Lasarọs osio ke otu mme akpaña ñkpa. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Mme ediwak owo ke ntak emi mmọ ekekopde ete ke Enye ama anam utibe ñkpọ ñkpaidem ema ewọñọ eka ndisobo ye Enye.<verse eid="JHN 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 12:19" />Do ke mme Farisi eketiñ kiet ye eken ete, “Mbufo emekut, ñkpọ iduhọ emi ñnyin ikemede ndinam. Sese nte ofuri ererimbot etienede Enye!”<verse eid="JHN 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Mme mbon Krik ema edu ke otu mme mmọ oro ekekade ndituak ibuot ke ini usọrọ oro. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Mmọ ema eka ebine Filip emi okotode Betsaida ke Kalili ye ebeñe, enyuñ edọhọ ete, “Ete, ñnyin imoyom ndikut Jisọs.” <verse eid="JHN 12:21" /><verse number="22" style="v" sid="JHN 12:22" />Filip ama eketiñ ọnọ Andru; Andru ye Filip ema eketiñ enọ Jisọs.<verse eid="JHN 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23" />Jisọs ama ọbọrọ ete, “Ini oro edisim idahaemi, emi edinọde Eyen Owo akamba ubọñ. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Ami ntiñ akpanikọ nnọ mbufo nte ke ebede ñkpasip ibokpot ọduọ ke isọñ onyuñ akpa, enye eyesuk edi kpa ñkpasip kiet. Edi edieke enye akpade, enye eyesioño mme ñkpasip efen. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Owo ekededi emi amade uwem esie eyeduọk enye; edi owo emi asuade uwem esie ke ererimbot emi eyenim enye enọ nsinsi uwem.<verse eid="JHN 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 12:26" />Owo ekededi emi oyomde ndinam ñkpọ nnọ Mi, enyene nditiene Mi, man otodo eyen utom Mi okpodu ye Ami ke ebiet emi Ami ndude. Ete Mi eyekpono enye emi anamde ñkpọ ọnọ Mi.” <verse eid="JHN 12:26" /><verse number="27" style="v" sid="JHN 12:27" />Idahaemi, Esit Mi etimede ndien Ami nditiñ nso? Nte Ami ndidọhọ nte, Ete kuyak awa ñkanika emi esim Mi? Baba, emi edi ntak emi Ami ñkedide, man otodo ami mbe ke utọ ini ukut emi. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Ete, da ubọñ ye ukpono nọ enyiñ Fo. Do ke uyo eketiñ ikọ oto enyọñ ete, “Ami mmenọ enye ubọñ ndien Ami ñyetọñọ ntak nnam ntre.” <verse eid="JHN 12:28" /><verse number="29" style="v" sid="JHN 12:29" />Mme otu owo emi ekedade do ema ekop uyo oro, ndien ema edọhọ ete, “Obuma asiaha.” Mme mmọ eken ema edọhọ ete, “Enjel eketiñ ikọ ye Enye.”<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Edi Jisọs ama ọdọhọ mmọ ete, “Ikedighe ke ntak Mi ke uyo oro eketiñde ikọ edi, ekedi ke ntak mbufo. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Ini edikpe ikpe ererimbot emekem; ini edidorode andikara ererimbot emi nduọk ekem. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Edi ke ema emenerede Mi ekpọñ isọñ, Ami ñyeduri kpukpru owo nnọ idem Mi.” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Enye eketiñ emi ndiwut utọ uduot ñkpa emi Enye edikpade.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Mme otu owo ema ebọrọ Enye ete, “Mme mbet ñnyin etiñ enọ ñnyin nte ke Andinyaña eyedu uwem ke nsinsi, ndien Afo ekeme didie ndien ndidọhọ nte ke ana nte emenede Eyen Owo ke enyọñ? Anie edi Eyen Owo oro?”<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Jisọs ama ọbọrọ ete, “Mbufo eyenyene uñwana oro ke otu mbufo ebighi esisit. Eka iso esaña ke usuñ mbufo ke ini mbufo enyenede uñwana oro, mbak ekim edisim mbufo. Koro owo emi asañade ke ekim idiọñọke ebiet emi enye akade. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Enim uñwana ke akpanikọ ke ini mbufo enyenede enye, man otodo mbufo ekabarede edi nditọ uñwana.” Ke ini Enye ama eketiñ ikọ ama, Jisọs ama ọkpọñ mmọ onyuñ edip idem Esie ke enyin mmọ.<verse eid="JHN 12:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />Kpasuk ye emi Jisọs ama akanam kpukpru mme idiọñọ ñkpọ ñkpaidem ke iso mmọ, mmọ ikenyimeke. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Akana edi ntre man ọkọsọñọ ikọ emi Asiak Uduak Abasi Aisaya eketiñde ete, “Ọbọñ anie enim etop ñnyin ke akpanikọ, mme anie ke Abasi okowut odudu esie?” <verse eid="JHN 12:38" /><verse number="39" style="v" sid="JHN 12:39" />Ke ntak emi mmọ ikekemeke ndinim ke akpanikọ, koro Aisaya ama onyuñ ọdọhọ ete, <verse eid="JHN 12:39" /><verse number="40" style="v" sid="JHN 12:40" />“Abasi ama ekim mmọ enyin, onyuñ ọsọñ mmọ esit, mbak mmọ edida enyin mmọ ekut usuñ, enyuñ ekere ñkpọ ke esit mmọ efiọk, ndien mmọ idinyuñ iwọñọkede itiene Mi man Ami ñkọk mmọ.” <verse eid="JHN 12:40" /><verse number="41" style="v" sid="JHN 12:41" />Aisaya eketiñ emi koro enye ama okut ubọñ Jisọs onyuñ etiñ abaña Enye.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Kpa ke utọ ini emi ediwak mme ada ukara mme Ju ema enim Jisọs ke akpanikọ; edi ke ntak mme Farisi mmọ iketiñke ikọ ibaña Enye añwa añwa, mbak edibin mmọ esioño ke ufọk ukpepñkpọ. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />Koro mmọ ekema itoro ubọk owo ekan itoro ubọk Abasi.<verse eid="JHN 12:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Do ke Jisọs eketiñ ke ọkpọsọñ uyo ete, “Owo ekededi emi enimde Mi ke akpanikọ, inimke Mi ikpọñ ke akpanikọ, edi etiene enim Enyemi ọkọdọñde Mi ke akpanikọ ñko. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Owo ekededi emi okutde Mi, okut Enyemi ọkọdọñde Mi ñko. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Ami mmedi ke ererimbot nte uñwana, man owo kiet ekededi emi enimde Mi ke akpanikọ okusine ke ekim. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />Owo ekededi emi okopde etop Mi ndien isukke ibuot inọ Mi, Ami ndikpehe enye ikpe. Koro Ami ñkedighe ndikpe ererimbot ikpe, edi ndinyaña enye. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Owo ekededi emi esinde Mi mme inyuñ ibọhọ etop Mi, enyene enye emi edikpede ikpe ye enye. Ikọ emi mma ñketetiñ edidi ekpe ikpe esie ke akpatre usen. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Koro Ami ñketiñke ikọ ke odudu idem Mi, edi Ete emi ọkọdọñde Mi, okowuk Mi abaña se ñnyenede nditiñ ye usuñ emi Ami ñnyenede nditiñ. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Ami mmọfiọk nte ke ewuhọ Esie ada nsinsi uwem edi. Ke ntre, se ededi emi Ami ntiñde, Ami ntiñ ukem ukem se Ete Mi ọkọdọhọde Mi ntiñ.”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s1">Jisọs Eyet Mme Mbet Esie Ukot</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Ekedi ke usen emi ekebemde usọrọ uwọrọ ufin iso, ke Jisọs ọkọdiọñọ ete ke ini edikem emi anade nte imọ ikpọñ ererimbot emi inyuñ itiene Ete. Ke Enye ama akama ikọt Esie emi ekedude ke isọñ, Enye ndien ama owut mmọ uyọhọ ima Esie ke edima mmọ tutu esim utit. <verse eid="JHN 13:1" /><verse number="2" style="v" sid="JHN 13:2" />Ke ini emi Jisọs ye mme mbet Esie ekediade udia mbubreyo, Setan ama ekesin ke esit Judas Iskariọt eyen Saimọn ete atap Jisọs. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Jisọs ama ọdiọñọ ete ke Ete ama ayak kpukpru ñkpọ esin ke idak odudu Imọ, ndien ke Imọ ikoto ke Abasi inyuñ iyom ndi fiak ntiene Abasi. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />Do ke Enye akadaha ada ọkpọñ udia, osio ọfọñ enyọñ idem Esie, ndien emen tọwid, (ọfọñ ukuọhọrede idem) awaña ke isin. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Ke Enye ama akanam emi ama, Enye ama añwaña mmọñ esin ke besin onyuñ ọtọñọ ndiyet mme mbet Esie ukot ndien ada tọwid emi Enye akawañade ke isin ọkwọhọrede.<verse eid="JHN 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6" />Enye ama edisim Saimọn Pita, emi ọkọdọhọde enye ete, “Ọbọñ mi, nte Afo oyom ndiyet mi ukot?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />Jisọs ama ọdọhọ enye ete, “Afo udiọñọke idahaemi se Ami nnamde, edi ọyọdiọñọ ke ini iso.”<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />Pita ama ọdọhọ ete, “Baba, Afo uduyetke ukot mi.” Jisọs ama ọbọrọ enye ete, “Ibọhọke Ami ñyet fi ukot, afo ududighe aba mbet Mi.”<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />Saimọn ama ọbọrọ ete, “Ọbọñ kuyet mme ukot mi ikpọñ, edi yet mme ubọk ye ibuot mi dian.”<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />Jisọs ama ọbọrọ, ete, “Owo emi ama ekeyere mmọñ, enyene ndiyet ukot ikpọñ man enye asana ofuri idem. Mbufo emesana ke ebede owo kiet.” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Koro Jisọs ama ọdiọñọ owo emi editapde Enye inọ ñkpa, ndien emi ekedi ntak emi Enye ọkọdọhọde ete ke idighe kpukpru owo esana.<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Ke Enye ama ekeyet mmọ ukot okure, Enye ama emen ọfọñ Esie esine onyuñ akada itie Esie. Enye ama obup mmọ ete, “Nte mbufo emediọñọ se Ami ñkenamde ye mbufo?” <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Mbufo ekot Mi Andikpep ye Ọbọñ; emi edi nnen nnen mbufo ndinam ntre koro Ami ndide se mbufo ekotde oro. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Ke emi Ọbọñ ye Andikpep mbufo ama ekeyet mbufo ukot, mbufo ñko enyuñ eyet kiet eken ukot. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Ami mmọnọ mbufo uwutñkpọ nte yak mbufo enam nte Ami mma ñkanam ye mbufo. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Ami ntiñ akpanikọ nnọ mbufo nte eyen ufọk ndomokiet ikponke ikan Ete ufọk esie, mme asañautom ndikpon ñkan enye emi ọkọdọñde enye utom. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Ke emi mbufo ema ekefiọk mme ñkpọ emi, eyefọn ye mbufo edieke mbufo enamde mmọ.<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />Ami ntiñke emi mbaña kpukpru mbufo, ami mmetim ndiọñọ kpukpru mme mmọ emi ñkemekde. Edi, emi edi ndisọñọ se ñwed Abasi etiñde ete, “Owo emi abuanade uyo ye Ami eyewọñọde añwana ye Ami.” <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />“Ami ntiñ emi nnọ mbufo idahaemi mbemiso editibe, man ke adaña ini emi mme ñkpọ emi editibede mbufo ekpenim ke akpanikọ nte ke Ami ndi Enye.<verse eid="JHN 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 13:20" />Ami ntiñ akpanikọ nnọ mbufo nte, owo ekededi emi enyimede enye emi Ami ndọñde, enyime Mi, ndien owo ekededi emi enyimede Mi enyime Enyemi ọkọdọñde Mi.”<verse eid="JHN 13:20" /></para>
  <para style="s1">“Owo Mbufo Kiet Eyetap Mi”</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Ke Jisọs ama eketiñ mme ikọ emi ama, esit ama etimede Enye, ndien Enye ama osio owut añwa añwa ete, “Ami ntiñ akpanikọ nnọ mbufo, owo kiet ke otu mbufo eyetap Mi ọnọ ñkpa.” <verse eid="JHN 13:21" /><verse number="22" style="v" sid="JHN 13:22" />Mme mbet Esie ema ewọñọde enyin ese kiet eken ye ọkpọsọñ eyighe ete mme anie owo ke Enye etiñ abaña. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Kiet ke otu mmọ, mbet emi Jisọs akamade, eketie adiana Enye. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Saimọn ama ọnọ enye idiọñọ ke ibuot ete yak enye obup Jisọs owo emi ekemede ndinam oruk ñkpọ emi etiede ntre.<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />Enye ama esik ekpere Jisọs, onyuñ obup Enye ete, “Ọbọñ, anie edi owo oro?”<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />Jisọs ama ọbọrọ ete, “Edi owo emi Ami ndinọde ibio uyo emi ke mma ndebi enye ke usan.” Do ke Enye edebi ibio uyo oro ndien ayak ọnọ Judas Iskariọt, eyen Saimọn.<verse eid="JHN 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 13:27" />Ndo ndo oro Judas ọkọbọde uyo oro, Setan ama oduk enye idem. Jisọs ama ọdọhọ enye ete, “Se afo oyomde ndinam, nam usọp usọp.”<verse eid="JHN 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 13:28" />Edi baba owo ndomokiet ke okpokoro udia oro ikọfiọkke ntak emi Jisọs eketiñde ikọ ye enye. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Sia Judas ekedide akama okuk, ubak mmọ ekekere ete ke Jisọs ọkọdọhọ enye edep se ediyomde ke usen usọrọ, mme ndinọ mme mbio ubuene ñkpọ. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />Judas okonyuñ ọbọbọ uyo oro, enye ama adaha ada ọwọrọ añwa. Ndien ekedi ke okoneyo.<verse eid="JHN 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Ke ini enye ama akaka ama, Jisọs ama ọdọhọ ete, “Idahaemi ke enọ Eyen Owo ubọñ ndien Ete onyuñ ọbọ ubọñ ke Eyen. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Edieke Ete ọbọde ubọñ ke Eyen, Ete ñko eyenọ Eyen ubọñ ke idem Esie, ndien eyenọ Enye ubọñ inikiet.” <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />“Mme nditọ Mi, ami ndidu ye mbufo ke esisit ini. Mbufo eyeyom Mi, ndien kpa nte ñketiñde nnọ mme Ju, kpa ntre ke ntiñ ñko nnọ mbufo, ebiet emi Ami ñkade mbufo ikemeke nditiene Mi.<verse eid="JHN 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 13:34" />Obufa ewuhọ ke Ami nnọ mbufo! Ema kiet eken. Nte Ami ñkamade mbufo, ntre ke mbufo enyene ndima kiet eken. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Edieke mbufo emade kiet eken, do ke kpukpru owo edidiọñọ ete ke mbufo edi mme mbet Mi.”<verse eid="JHN 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Saimọn Pita ama obup Enye ete, “Ọbọñ, Afo oyom ndika mmọñ?” Jisọs ama ọbọrọ ete, “Afo ukemeke nditiene Mi idahaemi ñka ebiet emi Ami ñkade, edi ke ini iso afo eyedi etiene Mi.”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />Pita ama obup ete, “Ọbọñ, ntaha ami mmeñkemeke nditiene Fi idahaemi-e? Ami ñyeyak uwem mi nnọ ke ntak Fo.”<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />Do ke Jisọs ọkọbọrọ ete, “Nte afo eyeyak uwem fo ke akpanikọ ọnọ ke ntak Mi? Ami ntiñ akpanikọ nnọ fi, nte, mbemiso ekikọ ọkpọk, afo eyekañ Mi ikata.”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />“Ekuyak esit etimede mbufo, mbufo ekaiso ndibuọt idem ye Abasi, enyuñ ebuọt idem ye Ami. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Ediwak ufọk edu ke ufọk Ete Mi ko ke enyọñ, ke mikpedighe ntre, Ami ñkpetiñ nnọ mbufo. Ami mmọñ ñka do nditim itie nnim nnọ mbufo. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Ndien Ami mma ñka ñketim itie nnọ mbufo, Ami ñyefiak ndi ndien ndida mbufo ekedu ye Ami man mbufo ñko ekpedu ye Ami ke ebiet emi Ami ndude. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Mbufo emediọñọ usuñ emi esimde ebiet emi Ami ñkade.”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Tọmọs ama ọdọhọ Enye ete, “Ọbọñ, ñnyin idiọñọke ebiet emi Afo akade, ñnyin ikeme ndien didie ndidiọñọ usuñ?”<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />Jisọs ama ọbọrọ enye ete, “Ami ndi usuñ ye akpanikọ ye uwem. Owo baba kiet idighe itiene Ete ke mibọhọke ke Ami. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Edieke mbufo ekpediọñọde ke akpanikọ enye emi Ami ndide, mbufo ekpediọñọ Ete Mi nde. Ọtọñọde ke emi mbufo emediọñọ Enye, emenyuñ ekut Enye.”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Filip ama ọbọrọ Enye ete, “Ọbọñ, wut ñnyin Ete oro ndien ñnyin iyeyuhọ.”<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Jisọs ama ọbọrọ ete, “Nte afo udiọñọke Mi, Filip?” Kpa ye Ami emi mma ñkodu ye mbufo ke utọ anyan ini oro? Owo ekededi emi okutde Mi okut Ete. Afo ekeme didie ndidọhọ ete, “Wut mi Ete ndien? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Nte mbufo inimke ke akpanikọ ite ke Ami ndu ke Ete ndien Ete ñko onyuñ odu ke Ami? Mme ikọ emi Ami ntiñde ye mbufo idighe okim, edi eke Ete emi oduñde Mi ke idem, edi Enye akaiso ndinam utom Esie. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Enim Mi ke akpanikọ ke ini ndọhọde nte ke Ami ndu ke Ete ñko ke Ete odu ke Ami; ke midighe ntre enim ke akpanikọ kabaña mme nnam-ñwut utibe ñkpọ emi mbufo ekutde.<verse eid="JHN 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 14:12" />Ami ntiñ akpanikọ nnọ mbufo nte, owo ekededi emi ọbuọtde idem ye Ami, enye eyenam se Ami ñkekade iso ndinam. Enye eyenam mme ñkpọ emi ekande oro, koro Ami mmọñ ñka mbine Ete Mi. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Ndien Ami ñyenam se ededi emi mbufo edibupde ke enyiñ Mi, man otodo Eyen ada ubọñ ọnọ Ete. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Mbufo eyebup Mi ñkpọ kiet ekededi ke enyiñ Mi, ndien Ami ñyenam enye.”<verse eid="JHN 14:14" /></para>
  <para style="s1">Eñwọñọ Ndinọ Edisana Spirit</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />“Edieke mbufo emade Mi eyenam se Ami ñwukde nte mbufo enam. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Ami ñyebup Ete ndien Enye eyenọ mbufo ọnọ-item efen emi edidude ye mbufo ke nsinsi. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />Kpa Spirit emi ayararede akpanikọ abaña Abasi. Ererimbot ikemeke ndibọ Enye ñnyene, koro mmọ mikemeke ndikut Enye mme ndidiọñọ Enye. Edi mbufo ema ediọñọ Enye, koro Enye oduñde ye mbufo, ndien Enye eyeduk oduñ mbufo ke idem. <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />Ami ndikpọñke mbufo nte nditọ akpa; Ami ñyefiak ndi ntiene mbufo. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Idibighike, ererimbot idikwe Mi aba, edi mbufo eyekut Mi; ndien sia Ami ndude uwem, mbufo ñko eyenyuñ edu uwem. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Ke usen oro ama edi, mbufo eyefiọk ete ke Ami ndu ke Ete, ndien ke mbufo ñko edu ke Ami, kpa nte Ami ndude ke mbufo. <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />Owo ekededi emi enyimede onyuñ enimde mme ibet Mi enye edi enyemi amade Mi. Ete Mi eyema enyemi amade Mi; Ami ñko ñyema enye ñnyuñ ñyarade idem Mi nnọ Enye.”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />Judas (idighe Judas lskariọt) ama ọdọhọ ete, “Ọbọñ ntaha anade nte Afo ayarade idem fo ọnọ ñnyin muyarakede unọ ererimbot-e?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Jisọs ama ọbọrọ enye ete, “Edieke owo ndomokiet amade Mi, enye eyenim mme ukpepñkpọ Mi. Ete Mi eyema enye, ndien ñnyin iyedi itiene enye inyuñ inam ebiet iduñ ñnyin ye enye. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Owo emi mimaha Mi, idinamke mme ukpepñkpọ Mi. Mme ikọ emi mbufo ekopde eto Mi idighe eke idem Mi; mmọ enyene Ete emi ọkọdọñde Mi. <verse eid="JHN 14:24" /><verse number="25" style="v" sid="JHN 14:25" />Ami ntiñ emi nnọ mbufo ke adañaemi Ami nsuk ndude ye mbufo. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Edi andiñwam, Edisana Spirit, emi Ete edidọñde ke enyiñ Mi, eyekpep mbufo kpukpru ñkpọ, onyuñ anam mbufo eti kpukpru se Ami mma ñketetiñ nnọ mbufo.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />Emem ke Ami ñkpọñ nnọ mbufo, emem Mi ke Ami nnọ mbufo. Ami nnọhọ mbufo nte ererimbot enọde. Ekuyak esit etimede mbufo, ekunyuñ efehe ndik. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />Mbufo ema ekop Mi ndọhọde nte, Ami ñyekpọñ mbufo, edi Ami ñyefiak ndi mbine mbufo; edieke mbufo ekemade Mi, mbufo eyedara ke ntak emi Ami ñkade mbine Ete, koro Ete okponde akan Mi. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Ami mmetiñ nnọ mbufo idahaemi mbemiso ñkpọ emi etibe, man otodo ke ini mmọ editibede mbufo ekpenim ke akpanikọ.<verse eid="JHN 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 14:30" />Ami nditiñke ikọ ebighi aba ye mbufo, koro andinyene ubọñ ererimbot emi (Setan) ke ededi. Enye inyeneke odudu ndomokiet ke idem Mi, <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />edi ererimbot enyene ndifiọk nte ke Ami mmama Ete, ndien ke Ami nnam ukem ukem se Ete Mi owukde Mi nnam. Edi eyak ñnyin idaha ikpọñ ebiet emi.”<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s1">Ata Vain</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />“Ami ndi ata Vain, ndien Ete Mi edi ese iñwañ. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Enye eyesibe kpukpru ñkọk ke Ami, emi miñwumke mfri efep, ndien Enye eyekpọñ kpukpru ñkọk emi oñwumde mfri. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Mbufo ema esasana oto ke ikọ emi Ami ñketiñde nnọ mbufo. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Ediana kiet ye Ami, ndien Ami ñyediana kiet ye mbufo. Baba ñkọk kiet ikemeke ndiñwum mfri ke idem esie, ibọhọke eyire ke idem eto Vain. Ke ntre mbufo ikemeke ndiñwum mfri ibọhọke mbufo esine ke Ami.”<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />“Ami ndi eto Vain, mbufo edi mme ñkọk. Edieke owo odude ke Ami, ndien ami ñko ndu ke enye, enye eyeñwum ediwak mfri; ke esiode Mi efep mbufo idikemeke ndinam ñkpọ ndomokiet. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Edieke owo ekededi miduhọ ke Ami, enye ebiet ñkọk emi ema eketop eduọk ndien onyuñ asat, mme utọ ñkọk oro ke etañ enyuñ edọñ ke ikañ efọp. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Edieke mbufo edude ke Ami, ndien mme ikọ Mi eduñ mbufo ke esit, ebup sededi emi mbufo emade, ndien eyenọ mbufo. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Emi owut ubọñ Ete Mi edieke mbufo eñwumde ediwak mfri, ke usuñ emi ke mbufo ekeme ndiwut idem nte edi mme mbet Mi.”<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />“Nte Ete amade Mi, kpa ntre ñko ke Ami mma mbufo; esọñọ etie ke ima Mi. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Edieke mbufo enimde mme mbet Mi, mbufo eyesuk edu ke ima Mi, kpa nte Ami nsukde ibuot nnọ mme mbet Ete Mi ñnyuñ ndude ke ima Esie. <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />Ami ñketiñ mme ñkpọ emi nnọ mbufo man otodo inemesit Mi odu ye mbufo, man inemesit mbufo ọfọn ama. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Ewuhọ Mi edi emi: Ema kiet eken kpa nte Ami mmade mbufo. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Owo ndomokiet inyeneke ima emi okponde akan ima enye emi anamde ufan ayak uwem esie ọnọ ke ntak mme ufan esie. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Mbufo edi mme ufan Mi edieke mbufo enamde se Ami ñwukde mbufo enam. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Ami ñkotke mbufo nditọ ufọk aba, koro eyen ufọk idiọñọke se eteufọk esie anamde. Ñkam ñkot mbufo mme ufan, koro Ami mma ntiñ kpukpru ñkpọ emi Ami ñkekopde nto Ete Mi nnọ mbufo.”<verse eid="JHN 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 15:16" />Idighe mbufo ekemek Mi, edi Ami ñkemek mbufo, ñnyuñ ndọñ mbufo nte eka ekeñwum ediwak mfri, mme uduot mfri emi edibighide. Ndien ke ntre, Ete eyenọ mbufo se ededi emi mbufo ebupde ke enyiñ Mi. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Emi edi ewuhọ Mi: Ema kiet eken. <verse eid="JHN 15:17" /><verse number="18" style="v" sid="JHN 15:18" />“Edieke ererimbot esuade mbufo, mbufo enyene nditi ete ke mmọ ekebem iso esua Mi. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Edieke mbufo edide eke ererimbot, ererimbot eyema mbufo nte esie. Ke emi mbufo idighe eke ererimbot, edi Ami ñkemek mbufo nsio ke ererimbot; ntak edi oro ererimbot asuade mbufo. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Eti mme ikọ emi Ami ñketiñde ye mbufo nte: Ke eyen ufọk ndomokiet ikponke ikan eteufọk esie. Edieke mmọ ekekọbọde Mi, mmọ eyekọbọ mbufo ñko. Edieke mmọ ekesukde ibuot enọ mme ukpepñkpọ Mi, mmọ eyesuk ibuot enọ eke mbufo ñko. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Mmọ eyenam kpukpru mme ñkpọ emi ye mbufo ke ntak enyiñ Mi, koro mmọ midiọñọke Enye emi ọkọdọñde Mi.<verse eid="JHN 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 15:22" />Edieke Ami mme ñkpedighe nditiñ ikọ nnọ mmọ, ikpenyeneke ubiomikpe idiọkñkpọ. Idahaemi ke usuñ kiet ekededi, mmọ inyeneke se mmọ ekpefañade ebaña mme idiọkñkpọ mmọ. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Owo emi asuade Mi, asua Ete Mi ñko. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Edieke Ami mme ñkpenamke mme ikpọ utom emi ke otu mmọ, emi owo ndomokiet akananam minamke, mmọ ikpenyeneke ubiomikpe ke mme idiọkñkpọ mmọ. Edi ke emi mmọ ekut mme utibe utom odudu emi, tutu ye oro mmọ esuk esua Mi ye Ete Mi.” <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Akana edi ntre man ọkọsọñọ se ekewetde ke mme mbet mmọ, ete, “Mmọ ekesua Mi inyeneke ntak.”<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />“Ke ini ọnọ-item oro edidide, emi Ami ndidọñde nnọ mbufo nto Ete, kpa Spirit akpanikọ emi ọwọrọde oto Ete, Enye eyetie ntiense abaña Mi. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Edi ana mbufo ñko etie ntiense ebaña Mi, koro mbufo ema edu ye Ami toto ke editọñọ.”<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="s1">Ubiak Ye Idara Edu ke Iso</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />“Ami ñketiñ kpukpru ñkpọ emi nnọ mbufo man mbufo ediduọ ekpọñ usuñ. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Mmọ eyebin mbufo esio ke mme ñkpri ufọk akam; ndien ke akpanikọ, ini ke edi emi owo ekededi emi ediwotde mbufo edikerede ete ke imọ inam utom inọ Abasi. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Mmọ eyenam mme oruk ñkpọ emi ye mbufo koro mmọ mikediọñọke Ete mme Ami. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Ami ñketiñ emi nnọ mbufo, man kadaña emi ini oro edikemde mbufo ekpeti ete ke Ami mma nduri mbufo utọñ. Ami ñketiñke emi nnọ mbufo ke editọñọ koro Ami ñkedude ye mbufo.<verse eid="JHN 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />Edi idahaemi, mmọñ ñnyọñ ntiene Enyemi ọkọdọñde Mi, edi owo mbufo baba kiet ibupke Mi ite, ‘Afo aka mmọñ?’ <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Edi ke emi mma ñketiñ nnọ mbufo, esit mbufo ọyọhọ ye mfuhọ <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Edi Ami ntiñ nnọ mbufo, edi ke ufọn mbufo ke Ami ñyom ndinyọñ. Ke mibọhọke Ami ñnyọñ, idọñesit oro ididighe itiene mbufo. Edi edieke Ami ñnyọñde, Ami ñyedọñ Enye edi ebine mbufo.<verse eid="JHN 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 16:8" />Ndien ke Enye ama edi Enye eyeyarade owut ererimbot ndudue esie kabaña idiọkñkpọ, ye kabaña edinen ido ye ikpe. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />Kabaña idiọkñkpọ, koro mme owo minimke Mi ke akpanikọ. <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />Kabaña edinen ido, koro Ami ke ñnyọñ mbine Ete Mi ke ebiet emi mbufo midikwe Mi aba. <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />Ndien kabaña ikpe koro andida ubọñ ererimbot emi, (Setan) ikpe etip enye”. <verse eid="JHN 16:11" /><verse number="12" style="v" sid="JHN 16:12" />“Ami mmenyene se iwakde ikan emi nditiñ nnọ mbufo, emi mbufo midikemeke ndimum kpukpru. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Edi ke Enye, Spirit akpanikọ, ama edi, Enye eyeda mbufo usuñ oduk ke kpukpru akpanikọ. Enye iditiñke ikọ idem Esie. Enye editiñ kpa se Enye okopde, ndien Enye eyetiñ ọnọ mbufo se iditibede ke ini iso. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Enye eyenọ Mi ubọñ, koro Enye edibọ se Ami ñnyenede nditiñ itiñ inọ mbufo. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Kpukpru se Ete enyenede, edi Okim. Ntak edi oro Ami ñkọdọhọde nte ke Spirit edibọ se Ami nnọde ndien etiñ ọnọ mbufo.” <verse eid="JHN 16:15" /><verse number="16" style="v" sid="JHN 16:16" />“Ke esisit ini mbufo idikwe Mi aba; ndien ke esisit ini ama ebe mbufo eyefiak ekut Mi.”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Do ke ubak mme mbet Esie eketiñ ye idem mmọ ete, mme se Enye etiñde emi ọwọrọ nso, ke Enye ndidọhọ nte: “Ke esisit ini mbufo idikwe Mi aba,” ye “Ke esisit ini ama ebe, mbufo eyefiak ekut Mi, ye koro Ami ñnyọñ mbine Ete.” <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Mmọ ema ekaiso ndibup, “Nso ke ikọ emi ‘Ke esisit ini,’ ọwọrọ? Ñnyin idiọñọke se Enye etiñde abaña.”<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />Jisọs ama ọfiọk ete ke mmọ eyom ndibup Imọ mbaña mme ikọ emi, do ke Enye ọkọdọhọ mmọ ete, “Nte mbufo ebup idem mbufo mbume ebaña ikọ emi Ami ndọhọde nte, ‘Ke esisit ini mbufo idikwe Mi aba’, ye, ‘Ke esisit ini ama ebe, eyefiak ekut Mi?’ <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Ami ntiñ akpanikọ nnọ mbufo nte, ke mbufo eyetua enyuñ efuhọ ke ini emi ererimbot ediade idara. Mbufo eyefuhọ, edi mfuhọ mbufo eyekabarede edi idara. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Ñwan emi oyomde ndiman eyen okop ubiak koro ini esie ekemde; edi ke enye ama akaman eyen esie ama, enye efre mme ubiak esie ke ntak idaraesit, koro eyen amana oduk ke ererimbot. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Kpa ntre ke edi ye mbufo; idahaemi edi ini emi mbufo enyenede mfuhọ, edi Ami ñyetọñọ ntak ñkut mbufo ndien mbufo eyedia idara, ndien baba owo kiet idibọhọ idara mbufo. <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />Usen oro ama edi, mbufo idibupke Mi baba ñkpọ kiet aba. Ami ntiñ akpanikọ nnọ mbufo nte, ke Ete Mi eyenọ mbufo ñkpọ kiet ekededi emi mbufo edibupde ke enyiñ Mi. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Tutu esim emi mbufo ibupke baba ñkpọ kiet ke enyiñ Mi. Ebup, ndien mbufo eyebọ, ndien idara mbufo eyeyọhọ ọduọi.”<verse eid="JHN 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“Okposuk edi nte Ami ntiñde mme ikọ emi nnọ mbufo ke ñke, ini ke ededi emi Ami mme nditiñke ikọ aba ye mbufo ke ñke, edi nditiñ ikọ ye mbufo añwa añwa mbaña Ete. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Usen oro ama edi, mbufo eyebup Ete ñkpọ ke enyiñ Mi. Ami ndọhọke nte ke Ami ndibip Ete ñkpọ ke ibuot mbufo. <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />Baba, koro Ete ke idem Esie ama mbufo eti eti, koro mbufo emade Mi, enyuñ enimde ke akpanikọ ete ke edi Ete ọkọdọñ Mi. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Ami ñkoto Ete ndi ke ererimbot, ndien idahaemi Ami ke ñkpọñ ererimbot emi mfiak mbine Ete.”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Ndien mme mbet Jisọs ema edọhọ ete, “Idahaemi Afo eyetiñ ikọ añwa añwa usinke aba ñke ndomokiet. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Ñnyin imokut idahaemi ite ke Afo ọmọfiọk kpukpru ñkpọ, ndien inaha owo baba kiet obup Fi mme mbume. Emi anam ñnyin inim ke akpanikọ ite ke Afo oto ke Abasi edi.”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />Jisọs ama obup mmọ ete, “Nte mbufo emenim ndien ke akpanikọ ke akpatre? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Edi ini ke ededi, ndien ososim ama, emi edisuande mbufo, owo kiet kiet eyefiak ọnyọñ ufọk esie, ndien mbufo eyekpọñ Mi ikpọñ. Okposuk edi oro, ami ndighe ikpọñ, koro Ete Mi odude ye Ami. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />Ami ntiñ mme ikọ nnọ mbufo, man otodo mbufo ekpenyene emem ke edidiana kiet ye Ami. Ke ererimbot emi, mbufo eyenyene mfina. Edi esọñ esit! Ami mmakan ererimbot.”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s1">Jisọs Ọbọñ Akam Ọnọ Ikọt Esie</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Ke ini Jisọs ama eketiñ mme ikọ emi okure, Enye ama emenede enyin ese enyọñ, onyuñ ọbọñ akam ete, “Ete ini oro edisim. Nọ Eyen Fo ubọñ, man Eyen Fo ñko ọkpọnọ Fi ubọñ. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Koro Afo ọkọnọde Enye odudu ndikara kpukpru owo, man otodo Enye ọkpọnọ kpukpru mme mmọ emi Afo ọkọnọde Enye nsinsi uwem. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Ndien emi edi nsinsi uwem oro; nte mmọ ekpekam ediọñọ Fi, ñkpasip Abasi akpanikọ kierakiet, ye Jisọs Kraist, emi Afo ọkọdọñde. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Mmemenede ubọñ fo ke isọñ ke ndinam utom emi Afo ọkọnọde Mi mma. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Ndien idahaemi Ete, nọ Mi ubọñ ke iso Fo, ukem ubọñ emi Ami ñkenyenede ye Afo mbemiso ekenanam ererimbot.”<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />“Ami mmanam mme mmọ emi Afo okosioñode ke ererimbot ọnọ Mi ediọñọ Fi. Mmọ ekedi inyene Fo; ndien Afo amayak mmọ ọnọ Mi, ndien mmọ ema esuk ibuot enọ ikọ Fo. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Ndien idahaemi mmọ efiọk ete ke kpukpru ñkpọ emi Afo ọkọnọde Mi eto Fi. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Koro Ami mma nnọ mme ikọ emi Afo ọkọnọde Mi, ndien mmọ ema ebọ mme ikọ emi, mmọ ema efiọk ke akpanikọ ete ke Ami ñkoto ke Afo, enyuñ enim ke akpanikọ ñko ete ke edi Afo ọkọdọñ Mi.”<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />Ami mbọñ akam mbaña mmọ, Ami mbọñke akam mbaña ererimbot, edi mbọñ mbaña mme mmọ emi Afo ọkọnọde Mi, koro mmọ edide okuo. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Kpukpru se Ami ñnyenede edi okuo, ndien kpukpru se Afo enyenede edi Okim. Ndien ubọñ esim Mi oto mmọ. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Ami ndiduhọ aba ke ererimbot, edi mmọ ke ededu ke ererimbot, ndien Ami ke ñnyọñ mbine Fi, Edisana Ete, kpeme mmọ to ke odudu enyiñ Fo, enyiñ emi Afo ọkọnọde Mi, man otodo mmọ edi kiet kpa nte emi ñnyin idide kiet. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Kadaña ini emi Ami ñkodude ye mmọ, Ami mma ñkpeme mmọ ñnyuñ nnim mmọ ke ifure ke enyiñ oro Afo ọkọnọde Mi. Ndomokiet ikosopke ke ebede eyen nsobo, man otodo ọkọsọñọ se ekewetde ke Ñwed Abasi.<verse eid="JHN 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13" />Ndien idahaemi Ami ke ñnyọñ mbine Fi, ndien Ami ntiñ mme ñkpọ emi ke ini Ami nsuk ndude ke ererimbot, man otodo mmọ ekpenyene ọyọhọ udeme idara Mi ke esit mmọ. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Ami mma nnọ mmọ ikọ Fo, ndien ererimbot ema esua mmọ, koro mmọ midighe eke ererimbot aba kpa nte Ami mme ndighe eke ererimbot. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Mbeñeke nte yak Afo osioño mmọ efep ke ererimbot, edi mbeñe nte yak Afo ekpeme mmọ man andidiọk (Setan) edituk mmọ. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Mmọ idighe eke ererimbot kpa nte Ami mme ndighe eke ererimbot. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Da akpanikọ yet mmọ esana, ikọ Fo edi akpanikọ. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Kpa nte Afo ọkọdọñde Mi ke ererimbot, kpasuk ntre ñko ke Ami ndọñ mmọ ke ererimbot. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Ke ntak mmọ Ami mmanam idem Mi asana, man mmọ ñko ekpesana ke ofuri akpanikọ.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“Ami mbọñke akam Mi nnọ mmọ emi ikpọñ, edi mbọñ akam ñko mbaña mme mmọ emi edikabarede esit enim Mi ke akpanikọ ke ini iso, eto ke etop Eti Mbuk emi mmọ edikwọrọde. <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />Mbeñe nte yak mmọ kpukpru edi kiet, Ete, kpa nte emi Afo odude ke Ami ndien Ami ñko ndude ke Afo, yak mmọ ñko edu ke ñnyin man otodo ererimbot ekpenim ke akpanikọ ete ke edi Afo ọkọdọñ Mi. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Ami mmọnọ mmọ ubọñ emi Afo ọkọnọde Mi, man mmọ edi kiet kpa nte emi ñnyin idide kiet. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Ami ke mmọ, ndien Afo ke Ami, man otodo mmọ edi kiet ọyọhọ ọyọhọ, man ererimbot ediọñọ ete ke edi Afo ọkọdọñ Mi, ndien ke Afo amama mmọ nte Afo amade Mi.” <verse eid="JHN 17:23" /><verse number="24" style="v" sid="JHN 17:24" />“Ete, Ami ñyom mmọ emi Afo ama ọkọnọ mi ekpedu ye Ami ke ebiet emi Ami ndude, ndien enyuñ ekut ubọñ Mi, ubọñ emi Afo ọkọnọde Mi, koro Afo ama ama Mi mbemiso Afo obobot ererimbot.”<verse eid="JHN 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 17:25" />“Edinen Ete, okposuk edi nte ererimbot midiọñọke Fi, Ami mọdiọñọ Fi, ndien mmọ efiọk ete ke edi Afo ọkọdọñ Mi. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Ami mma ñyarade Fi nnọ mmọ, ndien Ami ñyeka iso ndinam mmọ ediọñọ Fi, man ima oro Afo enyenede ọnọ Mi ekpedi eke mmọ ñko, ndien man Ami ke idem Mi ñkpodu ke mmọ.”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s1">Ema Emum Jisọs</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Ke Jisọs ama ọkọbọñ akam ama, Enye ama ada mme mbet Esie ebe ebedeñ emi ekotde Kidrọñ ada ke edem eken. Ke edem oro mme eto ọlif ema eda ewak, ndien Enye ye mme mbet Esie ema esaña ekeduk do. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />Judas emi akatapde Enye ama ọdiọñọ ebiet emi, koro Jisọs esiwawak ndisobo do ye mbet Esie.<verse eid="JHN 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 18:3" />Do Judas ama edi ke iñwañ eto emi onyuñ asaña ye mme mbio ekọñ Rom ye mme isuñutom mme ikpọ mbọbọ ekọñ, enyuñ ekama mme ñkpọ unan ye utueneikañ.<verse eid="JHN 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4" />Ke ini Jisọs ama ọkọfiọk kpukpru se iyomde nditibe ye Enye, ama ọwọrọ añwa okobup mmọ ete, “Mbufo eyom anie?” <verse eid="JHN 18:4" /><verse number="5" style="v" sid="JHN 18:5" />Mmọ ema ebọrọ ete, “Ñnyin iyom Jisọs eyen Nasaret” Jisọs ama ọdọhọ ete, “Ami ndi Enye.” Judas anditap Kraist akada do ye mmọ. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Ke ini Jisọs ama ọkọdọhọ ete, “Ami ndi Enye,” mmọ ema efiak edem enyuñ eduọñọ ke isọñ.<verse eid="JHN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7" />Enye ama ọtọñọ ntak obup mmọ ete, “Mbufo eyom anie?” Ndien mmọ ema ebọrọ ete, “Jisọs eyen Nasaret.”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />Jisọs ama ọbọrọ ete, “Ami mma ndọdọhọ mbufo nte ke edi Ami ndi Enye. Edieke mbufo ekeyomde Mi, eyak mme mmọ emi enyọñọ.” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />Emi eketibe man se Enye eketiñde ekeme ndisu: “Ami ñyakke ndomokiet ke otu mmọ emi Afo ọkọnọde Mi osop.”<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Do Saimọn Pita, emi ekenyenede akañkañ, ama oduri osio ke efọk onyuñ esibe eyen ufọk akwa oku utọñ ubọk nnasia. (Eyen ufọk akwa oku oro ekekere Malkọs).<verse eid="JHN 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11" />Jisọs ama owuk Pita ete, “Sin akañkañ fo ke efọk; nte ikpanaha Ami ñnwọñ kọb ukut emi Ete Mi ọkọnọde Mi?”<verse eid="JHN 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Do ndien ke mme mbon ekọñ ye ada iso mmọ ye mme mbio utom mme Ju ekemum Jisọs, enyuñ ebọp Enye ubọk. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />Ndien ebem iso eda Enye eka ke edem Anas, emi ekedide ete añwan Kaifas, emi ekedide akwa oku isua oro. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />Kaifas ekedi enye emi ọkọnọde mme Ju item nte ke eyefọn edieke owo kiet akpade ke ibuot kpukpru owo eken. <verse eid="JHN 18:14" /><verse number="15" style="v" sid="JHN 18:15" />Saimọn Pita ama asaña ye mbet kiet efen etiene Jisọs oduk ke esit okure akwa oku. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />Edi Pita ekenyene ndibet ke añwa ke enyin usuñ. Mbet eken oro ekemehede ye akwa oku ama afiak edem editiñ ikọ ye eyen añwan emi okodude ke utom ukpeme usuñ, ndien enye ama ada Pita oduk esit okure. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />Eyen añwan emi ekekpemede usuñ ama obup Pita ete, “Nte afo udighe kiet ke otu mme mbet owo emi?” Enye ama ọbọrọ ete “Ami ndighe-o.”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Ebiet ama ebit, do nditọ ufọk akwa oku ye mme mbio utom ema ebara ikañ ukañ eda ekanade ewebe. Pita ama ada ñko ye mmọ etiene ewebe ikañ.<verse eid="JHN 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Akwa oku ama aka iso ndibup Jisọs mbaña mme mbet Esie ye mme ukpepñkpọ Esie.<verse eid="JHN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 18:20" />Jisọs ama ọbọrọ ete, “Ami mmetiñ ikọ añwa añwa nnọ ofuri ererimbot ndikop. Ami mmesika iso ndikpep ñkpọ ke mme ufọk akam ye ke mme Edisana Ebiet emi kpukpru mme Ju esibohode. Akananam Ami ntiñke ikọ ndomokiet ke ndibe. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Ntak emi afo obupde Mi mbume-e? Kam bup mme mmọ emi ekekopde Mi. Ke akpanikọ mmọ ediọñọ kpukpru se Ami ñketiñde.”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Ke ini Jisọs ama eketiñ ntem, kiet ke otu mme ada ukpeme do ama amia Enye ufia onyuñ ọdọhọ ete, “Afo asaña didie etiñ ikọ ke utọ usuñ oro ye akwa oku!”<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />Jisọs ama ọbọrọ enye ete, “Edieke Ami ntiñde ikọ ndomokiet emi ọdiọkde tiñ nọ kpukpru owo emi se ikọ oro ekedide. Edi edieke ñketiñde se idide akpanikọ, ntaha afo akamiade Mi ufia-a?”<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />Do ke Anas ọkọnọ Enye kpa nte ekebọpde Enye ọsọk Kaifas, akwa oku.<verse eid="JHN 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Nte Saimọn Pita okosuk adade ewebe ikañ, ema ebup enye ete, “Nte afo udighe kiet ke otu mme mbet owo emi?” Pita akañ ete, “Ami ndighe.”<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />Kiet ke otu mme nditọ ufọk akwa oku, iman owo emi Pita ekesibede enye utọñ, ama obup enye ete, “Nte ami ñkekwe fi ye Enye ke iñwañ eto ọlif?”<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />Pita ama ọtọñọ ntak akañ, kpa ke ndo ndo oro ekikọ ama ọkpọk.<verse eid="JHN 18:27" /></para>
  <para style="s1">Jisọs Ke Iso Pailet</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Ke tughi tughi usenubọk, ema eda Jisọs ewọrọ ke esa Kaifas, eka ufọk andikara mbon Rom (Konsin). Mme mbuot mme Ju ikodukke esit okure Kọnsin, koro mmọ ekeyomde ndinim idem mmọ asana nte mbet ido ukpono mmọ etemede, man mmọ ekeme ndidia udia usọrọ uwọrọ ufin. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Ke ntre, Pailet ama ọwọrọ añwa ebine mmọ okonyuñ obup ete, “Mbufo edọhọ ete owo emi anam nso?”<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Mmọ ema ebọrọ ete, “Edieke Enye mikpedighe abiat ibet, ñnyin ikpeyakke Enye isin fi ke ubọk.”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />Pailet ama ọdọhọ mmọ ete, “Mbufo eda Enye eka ekekpe ikpe Esie ke idem mbufo nte ibet mbufo etemede.” Mme Ju ema efaña ete, “Edi ñnyin inyeneke odudu ndibiere ikpe ñkpa nnọ owo.” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Emi eketibe man mme ikọ emi Jisọs eketiñde abaña uduot ñkpa emi Enye edikpade osu.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />Pailet ama adaha ndien afiak edem oduk okure onyuñ okot Jisọs ndien obup Enye ete, “Nte Afo edi Ọbọñ mme Ju?”<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />Jisọs ama obup ete, “Nte emi edi ekikere esit fo, mme edi mme mmọ efen etiñ ye afo ebaña Mi?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />Pailet ama ọbọrọ Enye ete, “Afo ekere ete ke ami ndi kiet ke otu mme Ju? Ekedi ikọt mbufo ye akwa oku mbufo ekeyak fi esin mi ke ubọk. Afo akanam nso?”<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />Jisọs ama ọbọrọ ete, “Obio ubọñ Mi idighe ke isọñ emi. Edieke ekpedide ntre, mme nditọ ufọk Mi ekpeñwana eñwan ndibiọñọ mme Ju ndimum Mi. Edi idahaemi obio ubọñ Mi oto ebiet efen.”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Pailet ama obup Enye ete, “Nte afo ndien edi Edidem?” Jisọs ama ọbọrọ ete, “Afo ọmọdọhọ ete ke Ami ndi Edidem. Ekeman Mi, ndien ami ñkonyuñ ndi ke ererimbot ke ntak kiet emi, nditiñ ikọ mbaña akpanikọ oro. Owo ekededi emi adade ke ñkañ akpanikọ oro eyekpañ utọñ ọnọ Mi.”<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />Pailet ama obup Enye ete, “Ndien nso idi akpanikọ?” Ke idak mbume emi ke Pailet akafiak ọwọrọ añwa ebine mme Ju ndien ọkọdọhọ mmọ ete, “Ami ñkwe isọñ emi ami ñkpadade mbiom owo emi ikpe. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />Edi ido mbufo nte Ami ñyak owo ñkpọkọbi kiet nnọ mbufo ke ini usọrọ uwọrọ ufin. Nte mbufo emeyom mi nsana Edidem mme Ju Enye ñyak?”<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />Mmọ ema efiori ke ọkpọsọñ uyo, ete, Ih, Ih, kuyak Enye, edi yak Barabas nọ ñnyin. Barabas emi ekedi owo ñwo.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Do ke Pailet akanam emia Jisọs. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Mme mbon ekọñ ema edọk anyanya ñkukim eyari Enye ke ibuot. Mmọ ema esine enye ọfọñ ubọñ, emi enyin esie ekedide mmọñibọñ. <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />Ndien mmọ ema eka iso nditọ Enye ndọk ete, “Itọñ uwem ọsọñ Fi, Edidem mme Ju!” Ndien mmọ ema emia Enye ke mbañ.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Pailet ama ọtọñọ ntak ọwọrọ añwa edidọhọ mme Ju oro, ete, “Se ami mmọñ nda Enye nsọk mbufo man mbufo efiọk ete ke ami ñkwe isọñ ndomokiet ndibiom Enye ikpe.” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Ke ini Jisọs ọkọwọrọde edi ye anyanya ñkukim ke ibuot ye ọfọñ mmọñibọñ oro ke idem, Pailet ama ọdọhọ mmọ ete, “Sese owo oro Mi!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Ke ini emi mme ikpọ oku ye mme mbon ukpeme ekekutde Enye, mmọ ema efiori, ete, “Ekọñ Enye ke eto, Ekọñ Enye ke eto!” Edi Pailet ama ọbọrọ ete, “Mbufo eda Enye eka ekekọñ Enye ke idem mbufo. Ama edi ami, ñkwe isọñ ikpe ndida ñkpe ikpe ye Enye.”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />Mme Ju ema esọñọ eyire ete, “Ñnyin imenyene mbet, ndien nte mbet oro etemede, Enye enyene ndikpa, koro Enye ọdọhọde ete ke imọ idi Eyen Abasi.”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Ke ini Pailet okokopde emi, ndik ama ọkọkọrọ anam enye akan nte ekedide. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />Enye ama afiak oduk esit okure okobup Jisọs ete, “Afo oto mmọñ edi mi?” Edi Jisọs ikọbọrọke enye.<verse eid="JHN 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 19:10" />Pailet ama obup Enye ete, “Nte Afo esesin nditiñ ikọ ye Ami? Nte Afo ufiọkke ete ke ami mmenyene odudu ndisana Fi ñyak, mme ndikọñ Fi ke etoñkpa?”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />Jisọs ama ọbọrọ ete, “Afo unyeneke odudu ndomokiet ke idem Mi emi mikenọhọ fi ito ke enyọñ. Ke ntem, enyemi akayakde Mi esin fi ke ubọk edue isop akamba idiọkñkpọ.”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Ke ini Pailet okokopde emi, enye ama odomo ndiyom usuñ nte enye ekemede ndisana Jisọs ñyak, edi mme Ju ema efiori, ete, “Edieke afo asanade Enye ayak, edinam fo ediwọrọ nte ke afo udighe ufan ye ada ibuot ukara, Sisa. Owo kiet ekededi emi ọdọhọde ete ke imọ idi Edidem edi asua ye ada ibuot ukara!”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Kadañaemi Pailet okokopde mme ikọ emi, enye ama ada Jisọs ọwọrọ edi añwa, onyuñ ọsuhọde etetie ke akpakaha ikpe, ke ebiet emi ediọñọde nte etehe itiat (emi ke usem mme Hibru ekotde Kabata). <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Ekedi usen mbeñe idem mbaña usọrọ uwọrọ ufin ke ñkpọ nte ñkanika duopeba uwemeyo, Pailet ama ọdọhọ mme Ju ete, “Esese Ọbọñ mbufo do.”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Edi mmọ ema efiori ete “Emen Enye ewọrọ! Emen Enye ewọrọ! Ekekọñ Enye ke eto!” Pailet ama obup mmọ ete, “Eyom ami ñkọñ Edidem mbufo ke eto?” Mme ikpọ oku ema ebọrọ ete, “Ñnyin inyeneke Edidem efen ke ebede Sisa.”<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />Ke akpatre, Pailet ama ayak Enye ọnọ mmọ ekekọñ Enye ke eto. Mme mbon ekọñ ema eda ekpeme Jisọs.<verse eid="JHN 19:16" /></para>
  <para style="s1">Edikọñ Ke Eto Ñkpa</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />Jisọs ama ọwọrọ ye etoñkpa (Krọs) Esie emi Enye okobiomde onyuñ aka ke ebiet emi ekekotde ebiet ñkpọkpọrọ (emi ke usem mme Hibru ekotde Kọlkọta). <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Edi mi ke mmọ ekekọñ Enye ke eto edian ye inọ iba, kiet ke ubọk nnasia, kiet ke ubọk ufien, ndien Jisọs esine ke ufọt. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />Pailet ama ewet ñkpọ ke ubak obukpọk onyuñ adian ke etoñkpa oro. Ndien se enye ekewetde do ekedi emi:</para>
  <para style="pc" vid="JHN 19:19">
    <char style="sc">Jisọs Eyen Nasaret, Edidem mme Ju.</char><verse eid="JHN 19:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="JHN 19:20" />Ediwak mbon Ju ema ekot idiọñọ emi, koro ebiet emi mmọ ekekọñde Jisọs ke eto ama ekekpere akwa obio, ndien ekewet ñkpọ emi ke usem Hibru, Latin, ye Krik.<verse eid="JHN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 19:21" />Ikpọ oku ye mme Ju ema efaña ye Pailet, ete, “Kuwet ete ke Enye edi Edidem mme Ju, edi wet ete ke owo emi ọkọdọhọ ete ke Imọ idi Edidem Mme Ju.”<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Pailet ama ọbọrọ ete, “Yak se mma ñkewet ada nte ami ñkewetde.”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Ke ini mme mbon ekọñ ema ekekọñ Jisọs ke etoñkpa ekure, mmọ ema emen ọfọñidem Esie, esiak ke mbak inañ, ubak kiet ke owo kiet. Ọfọñ idakidem Esie ikenyeneke ibuñ, ekedọk enye nte ọfọñ kiet ọtọñọde ke itọñ tutu esim mben. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Mmọ ema etiñ kiet ye eken ete, “Eyak ñnyin ikuwak enye emi. Eyak isin afia man idiọñọ owo emi anade ada ọfọñ enye emi.” Emi eketibe man ikọ Abasi osu emi ọkọdọhọde ete, “Mmọ ema edeme mme ọfọñ Mi enọ idem mmọ, ndien esin afia ke abaña ewura Mi.” Ke ntre mme mbon ekọñ oro ema esin afia. <verse eid="JHN 19:24" /><verse number="25" style="v" sid="JHN 19:25" />Mmọ emi ekedade ekpere etoñkpa Jisọs ekedi Eka Esie, eyeneka eka Esie Meri, ñwan Klopas, ye Meri Makdalin. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Ke ini Jisọs okokutde Eka Esie do ye mbet emi Enye akamade nte edade, Enye ama ọdọhọ eka Esie ete, “Enye edi eyen fo.”<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />Ndien onyuñ ọdọhọ mbet Esie ete, “Enye edi Eka fo”. Ọtọñọde ke usen oro, mbet Esie oro ama ada eka Jisọs ọnyọñ ufọk esie.<verse eid="JHN 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Jisọs ama ọfiọk ete ke kpukpru ñkpọ ema eda ke itie mmọ ọyọhọ ọyọhọ, ndien man osu nte ekewetde ke ñwed Abasi, Enye ama ọdọhọ ete, “ltọñ Asat Mi.” <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />Otu mmin emi ekotde finika ama ana do, do mmọ ema eda ndọbọ edebi ke esit emen ekọñ ke enyene mfa eto emi ekotde Aisọb, ndien emenede edian Enye ke ñkpọkinua.<verse eid="JHN 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 19:30" />Ke Jisọs ama ọkọñwọñ finika oro ama, Enye ama ọdọhọ ete, “Okure,” ndien Enye osuk ibuot Esie onyuñ ayak uwem Esie ke ñkpa.<verse eid="JHN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Ndien mme Ju ema ebeñe Pailet ete yak enye ayak mmimọ ibuñ mme ọkpọ ukot mme mmọ oro ekewotde ndien ekọñde mmọ ke etoñkpa (Krọs). Mmọ ekenam ebeñe emi koro usen oro ekedide Fraide, ndien mmọ ikoyomke mme okpo mmọ ekọñọ ke etoñkpa tutu esim usen ibet Satide, akpan akpan sia Satide enye oro ekedide edisana ke asaña asaña usuñ. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Ke ntre mme mbon ekọñ ema ekebuñ ọkpọ ukot akpa owo ye eke owo enye eken emi ekekọñde ini kiet ye Jisọs. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Edi kadañaemi mmọ ekesimde Jisọs, mmọ ema ekut ete ke Enye ama akpakpa do mmọ ikebuñke mme ọkpọ ukot Esie. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Ke usuñ kiet ekededi, kiet ke otu mbon ekọñ oro ama emenerede eduat esie ekim Jisọs ke ñkañ; ndien ndo ndo oro mmọñ ye iyip ema ewet ewọrọ. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />Enye emi okokutde mme ñkpọ ntibe emi ọnọ ikọ ntiense, ndien ikọ ntiense esie edi akpanikọ. Enye ọdiọñọ ete ke imọ itiñ akpanikọ, ndien etie ntiense emi man afo ñko ekpenim ke akpanikọ. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Mme ñkpọ emi eketibe man ikọ ñwed Abasi osu: “Ọkpọ Esie baba kiet owo idibuñke.” <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />Ndien kpa nte itie ñwed Abasi efen etiñde, ete, “Mmọ eyewuk enyin mmọ ese Enye emi mmọ ekekimde ke eduat.”<verse eid="JHN 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Ke esisit ini ama ekebe, Josef emi okotode obio Arimatia ama okobup Pailet abaña okpo Jisọs. Ke emi Josef ekedi mbet Jisọs, edi enye ekedi ke ndibe, koro enye akabakde mme Ju. Ke Pailet ama ekenyime, enye ama edikọñọde okpo Jisọs. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Enye akasaña ye Nikodimọs, owo emi ekebinede Jisọs ke okoneyo. Nikodimọs ama akama mbuaha enem ufuọñ ñkpọ, emi ke ekọm urua esie akakpade ñkpọ nte bọn ikie ye aba ye duop. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Ke mmọ ema ekemen okpo Jisọs, mmọ ema eda afia ọfọñ ewañ okpo Esie edọñ mme enem utebe ñkpọ oro. Ekenam etiene nte ido ubuk owo mme Ju esidide. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Ke ebiet emi ekekọñde Jisọs ke eto, ekpri iñwañ ama odu do, ndien ke iñwañ emi, obufa udi emi eketibede ke itiat ama odu emi akananam owo mibukke owo do. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Koro usen oro ekedi usen mbeñeidem mme Ju kabaña usen ibet (Sabat), ye ñko, koro udi oro ekekperede, mmọ ema ekebuk Jisọs do.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s1">Jisọs Ọtọñọ Ntak Odu Uwem</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Ke ata usenubọk ke akpa usen ke urua, kadaña emi eyo mikeñwañake kaña, Meri emi ekotde Makdalin ama aka ke udi oro ndien okokut nte ke ema ekpat itiat efep ke inua udi.<verse eid="JHN 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 20:2" />Do ke enye ekefehe ebine Saimọn Pita ye mme mbet eken, enye emi Jisọs akamade onyuñ ọdọhọ ete, “Mmọ ema esio Ọbọñ ñnyin ke udi, ndien ñnyin idiọñọke ebiet emi mmọ enimde Enye.”<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Ke ntre Pita ye mbet eken ema edaha eka ndise udi. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Mmọ mbiba ekefehe itọk edi mbet enye eken ama efehe ebe Pita onyuñ ebem iso ekesim udi. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Enye ama ọnuhọ okut ebok afia ọfọñ nte anade do, edi ikedukke esit. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Ekem Saimọn Pita emi eketienede enye ke edem ama edisim, ndien ama ebe oduk ke esit udi. Enye ama okut ebok afia ọfọñ emi ekedade ewañ Enye nte anade do, <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />kpa ye ọfọñ ñkpa emi ekedade ebọp Jisọs ke ibuot. Ọfọñ ibuot emi ama ọfọrọde ke idem esie ọkpọñ eken, ọfurọ ke idem Esie ana do. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Ke akpatre, mbet eken emi ekebemde iso esim udi ama onyuñ enim ke akpanikọ. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Kpa ye oro, mmọ iketighi se ñwed Abasi eketiñde ete, ke akana Jisọs eset ke ñkpa.<verse eid="JHN 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 20:10" />Do mme mbet ema efiak enyọñọ ufọk mmọ. <verse eid="JHN 20:10" /><verse number="11" style="v" sid="JHN 20:11" />Edi Meri ama osuk ada ke inua udi ke atua eyet. Nte enye okosuk atuade eyet, enye ama ọnuhọ ete ise esit udi, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />ndien enye ama okut mme enjel iba esinede mfia ọfọñ idem nte etiede ke ebiet emi okpo Jisọs akanade, kiet ke ñkañ ibuot, ndien enye eken ke ukot.<verse eid="JHN 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13" />Mme enjel ema ebup enye ete, “Eyen añwan, ntaha afo atuade eyet-e?” Enye ama ọbọrọ ete, “Mmọ emen Ọbọñ mi edaha, ndien ami ndiọñọke ebiet emi mmọ emende Enye ekenim.”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />Meri ke eketetiñ ntem, ye enye ndiwọñọrede, sese Jisọs do ada, edi enye ikediọñọke ite ke ekedi Jisọs.<verse eid="JHN 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15" />Jisọs ama obup Enye ete, “Eyen añwan nsinam afo atuade eyet? Afo oyom anie?” Enye ekekere ete ke anditiñ ikọ oro ekedi ekpeme ekpri iñwañ oro, oro anam enye ama ọbọrọ ete, “Ete, edieke ekedide afo ekemen Enye efep, tiñ nọ mi ebiet emi afo enimde Enye, ndien ami ñyekemen Enye.”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />Jisọs ama okot enye ete, “Meri!” Enye ama ọwọñọde ese enye onyuñ ofiori ke usem Hibru, ete, “Raboni” (Emi ọwọrọde ete, Andikpep).<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />Jisọs ama ọdọhọ enye ete, “Kutuk Mi ubọk koro Ami ñnyọñke kaña mbine Ete Mi. Edi ka bine nditọ Ete Mi nyuñ dọhọ mmọ ete, ke Ami ke mfiak mbine Ete Mi, ye Ete mbufo, ke mbine Abasi Mi, ye Abasi mbufo.”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />Meri emi okotode Makdala ama ebine mme mbet ye eti mbuk emi nte ke imọ imekut Ọbọñ ndien ke Enye eketiñ mme ikọ emi ọnọ imọ.<verse eid="JHN 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Ke mbubreyo akpa usen urua oro, ke ini mme mbet ekebonode ebiet kiet ekọbi usuñ esine ke ntak ndik mme Ju, Jisọs ama oduk edida ke otu mmọ onyuñ ọdọhọ ete, “Emem odu ye mbufo.” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Ke Enye ama eketiñ ntem ama, Enye ama owut mmọ mme ubọk Esie ye ñkañ Esie. Idara ama okpon eti eti ke emi mmọ ekekutde Ọbọñ mmọ.<verse eid="JHN 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21" />Jisọs ama ọtọñọ ntak ọdọhọ ete, “Emem odu ye mbufo! Nte Ete ọkọdọñde Mi, ami ñko mmonyuñ ndọñ mbufo.” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Ke Enye ama eketiñ emi, Enye ama eñwek ibifik ọduọk mmọ onyuñ ọdọhọ ete, “Ebọ Edisana Spirit. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Edieke mbufo efende owo ekededi mme idiọkñkpọ esie, efen kpukpru enọ owo oro; edieke mbufo mifenke inọ mmọ, idinyeneke edifen.”<verse eid="JHN 20:23" /></para>
  <para style="s1">Tọmọs Owo Eneni</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Kiet ke otu mme mbet Esie emi edide Tọmọs, emi ekekotde amanamba, ikọduhọ ye mme mbet eken ke ini emi Jisọs ekedide. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Ke ini emi mme mbet eken eketiñde enọ enye ete ke mmimọ ima ikut Ọbọñ, enye ama eneni ete, “Tutu ami ñkut mme nde okpoukwak ke mme ubọk Esie ñnyuñ mmen nnuen ubọk mi nsin ke mme nde oro mme ukwak eketibide, ñnyuñ nsin ubọk ke ñkañ Esie, ami ndinimke ke akpanikọ.”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Ñkpọ nte urua kiet ama ekebe, mme mbet ema etọñọ ntak ebono ọtọkiet ke esit ufọk, ndien Tọmọs ama odu ye mmọ. Okposuk edi emi ekeberideberi usuñ, Jisọs ama oduk akada ke ufọt mmọ, ndien ọkọdọhọ ete, “Emem odu ye mbufo.”<verse eid="JHN 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 20:27" />Do ke Enye ọkọdọhọ Tọmọs ete, “Sin nnuen ubọk fo mi; se mme ubọk Mi. Nyanarede ubọk fo, nyuñ sin Mi ke ñkañ. Tre eyighe fo ndien, nyuñ nim ke akpanikọ.”<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />Tọmọs ama ọdọhọ Enye ete, “Ọbọñ mi ye Abasi mi!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />Do ke Jisọs ọkọdọhọ enye ete, “Koro afo ama okokut Mi, afo emenim ke akpanikọ? Ọfọfọn ọnọ mmọ emi mikwe ke enyin edi enim ke akpanikọ.”<verse eid="JHN 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Jisọs ama anam ata ediwak mme utibe ñkpọ efen ke iso mme mbet Esie, emi owo miwetke isin ke ñwed emi. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Edi ewet mme mmọ emi man otodo mbufo enim ke akpanikọ nte ke Jisọs edi Kraist Andinyaña ye Eyen Abasi, ndien ke edinim ke akpanikọ mbufo ekpenyene uwem ke enyiñ Esie.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s1">Udia Usenubọk Ke Usiahautin</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Ke emi ama ekebe, Jisọs ama amana owut mme mbet Esie idem ke mben akpa emi ekotde Tiberias. Eketibe ntem.<verse eid="JHN 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 21:2" />Saimọn Pita, Tọmọs (emi ekotde Amanamba), Nataniel emi otode Kenan ke Kalili, nditọ Sebidi, ye mbet iba efen ekebono ebiet kiet.<verse eid="JHN 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 21:3" />Saimọn Pita ama ọdọhọ mmọ ete, “Ami mmọñ ñka ñkọkọ iyak.” Ndien mmọ eken ema edọhọ enye ete, “Ñnyin ñko iyeka ye afo.” Do mmọ ema ewọñọ ekeduk ubom. Edi ke okoneyo oro mmọ ikemumke ndomo iyak kiet. <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />Ke tughi tughi usenubọk Jisọs ama ada do ke mben inyañ, edi mme mbet Esie ikọdiọñọke Enye.<verse eid="JHN 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 21:5" />Enye ama esin uyo okot mmọ ete, “Mme ufan, nte mbufo imumke iyak ndomokiet?” Mmọ ema ebọrọ ete, “Ñnyin imumke baba ñkpọ kiet.”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />Enye ama ọdọhọ mmọ ete, “Etop iyire mbufo ke ñkañ ubọk nnasia ubom ndien mbufo eyenyene ñkpọ.” Mmọ ema enam ntre, ndien ikekemeke ndiduri iyire nsio ke mmọñ nsin ke ubom koro mme iyak emi ekeduọñọde ke iyire ema ewak eti eti.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Mbet emi Jisọs akamade ama ọdọhọ Pita ete, “Edi Ọbọñ edi oro,” Saimọn Pita okokokop nte mbet oro etiñde ete, “Edi Ọbọñ edi oro,” enye ama emen ọfọñ enyọñ idem esie esine (koro enye ama osio ọfọñ oro enim), ndien enye ama ọfrọ oduk mmọñ, <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Mme mbet mmọ eken ema etiene enye ye ubom ke eduri iyire emi iyak ọkọyọhọde, koro mmọ ekeyomde usuñ ekpọñ isọñ ke ñkpọ nte ikpat ikie. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Ke ini mmọ ema ekesim isọñ mmọ ema ekut ikañ emi ekedade ukañ ebara ye iyak ke esit odoro, ye mme ebok uyo.<verse eid="JHN 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 21:10" />Jisọs ama ọdọhọ mmọ ete, “Eda ndusuk iyak emi mbufo esuk emumde edi.” <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />Saimọn Pita ama oduk ubom onyuñ oduri iyire odori ke obot. Ikpọ iyak ema eyọhọ ke esit, ñkpọ nte iyak ikie ye aba ye duopeta, kpa ye utọ uwak iyak oro, iyire ikawahake.<verse eid="JHN 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 21:12" />Jisọs ama ọdọhọ mmọ ete, “Edi, edidia udia.” Baba owo kiet ke otu mme mbet emi ikedomoke domo ndibup Enye ete, “Afo edi anie?” Koro mmọ ema ediọñọ ete ke ekedi Ọbọñ. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Jisọs ama ekemen uyo edeme ọnọ mmọ, ndien onyuñ anam kpa ntre ye iyak.<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />Emi akanam ọyọhọ ikata Jisọs ndiwut mme mbet Esie idem ke Enye ama ekeset ke ñkpa.<verse eid="JHN 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Ke mmọ ema ekedia ñkpọ ema, Jisọs ama ọdọhọ Saimọn Pita ete, “Saimọn eyen Jọn, nte afo amama Mi ke ofuri esit akan emi?” Enye ama ọbọrọ ete, “Ih Ọbọñ, Afo ọmọfiọk ete ke mmama Fi.” Jisọs ama ọdọhọ enye ete, “Bọk mme erọñ Mi.”<verse eid="JHN 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16" />Jisọs ama ọtọñọ ntak obup enye ete, “Saimọn Eyen Jọn, nte Afo amama Mi ke ofuri esit?” Enye ama ọbọrọ, ete, “Ih, Ọbọñ, Afo ọmọfiọk ete ke ami mmama Fi.” Jisọs ama ọdọhọ enye ete, “Tim se mme erọñ Mi.”<verse eid="JHN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17" />Enye ama afiak obup enye ọyọhọ ikata, ete, “Saimọn eyen Jọn, nte afo amama Mi?” Pita ikekopke inemesit koro Jisọs okobupde enye kpa mbume kiet emi ikata ete, “Nte afo amama Mi?” Enye ama ọdọhọ ete, “Ọbọñ, Afo ọmọfiọk kpukpru ñkpọ. Afo ọmọfiọk ete ke ami mmama Fi.” Jisọs ama ọdọhọ enye ete, “Bọk mme erọñ Mi.” <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Ami ntiñ akpanikọ nnọ mbufo, nte ke ini emi mbufo ekedide ñkpri owo mbufo esidọdiọñ idem mbufo eka ebiet emi mbufo emade, edi ke ini mbufo edukde usọñ, mbufo eyeneñede ubọk mbufo ndien owo efen esine mbufo ọfọñ onyuñ ada mbufo aka ebiet emi mbufo mikpamaha ndika; <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />Jisọs eketiñ emi ndiwut utọ uduot ñkpa emi Pita edikpade ndinọ Abasi ubọñ. Do ndien ke Enye ọkọdọhọ enye ete, “Tiene Mi.”<verse eid="JHN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Pita ama ọwọñọrede okut ete ke mbet emi Jisọs akamade ke eketiene mmọ (Enye edi enye emi ekeberede Jisọs ke idem ke itie udia mbubreyo, okonyuñ ọdọhọde ete, “Ọbọñ, anie oyom nditap Fi?”) <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Ke ini Pita okokutde enye, enye ama obup Jisọs ete, “Ọbọñ edi didie ye Enye?”<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />Jisọs ama ọbọrọ ete, “Edieke Ami ñyomde enye osuk odu uwem tutu Ami mfiak ndi, oro ebehe fi didie? Tiene Mi.”<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />Ke ntak emi, mme ikọ ema ekanade isọñ isọñ ke otu mme nditọ ete, ete ke mbet emi idikpaha. Edi Jisọs ikọdọhọke ete ke enye idikpaha. Enye ọkọdọhọ ibibio ete, “Edieke Ami ñyomde enye osuk odu uwem tutu Ami mfiak ndi oro ebehe fi didie?”<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />Emi edi mbet emi ọnọde ntiense abaña mme ñkpọ emi, onyuñ edi enye ekewet mme ñkpọ emi enim. Ñnyin imọfiọk ite ke ikọ ntiense esie edi akpanikọ.<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Jisọs ama anam mme uwak ñkpọ efen ñkọ. Edieke ekpewetde kpukpru mmọ kiet kiet enim, ami mmekere nte ke idem ererimbot ikpenyeneke ufañ ye itie inọ mme ñwed emi ekpewetde.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>