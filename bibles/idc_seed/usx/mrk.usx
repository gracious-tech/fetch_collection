<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">IMRK - Ajigha</book>
  <para style="toc3">IMar</para>
  <para style="toc2">IMarkus</para>
  <para style="toc1">Ila ididuma ka avọ IMarkus</para>
  <para style="mt2">ILA IDIDUMA KA AVỌ</para>
  <para style="mt1">IMARKUS</para>
  <para style="imt">Unyeni</para>
  <para style="ip">Ila ididuma ka vọ iMarkus ukyo ba no upii si “Ila ididuma kaya iYesu iKristi, Anọ Ọnọng.” IYesu anyeni nga ko tọ ajiya uju utina ni ẹrẹgọrọ. Ẹrẹgọrọ nga nyeni ko mẹẹ nga, ki ẹrẹkyuọ kaya ọshei, kunu ukpa ajiya uvulu bu. IYesu pii ka ya ẹrẹkwẹ nga ko tọọ Anọ Ajiya ka ba ka ma ẹrẹkwẹ nga ka fo ajiya ka vulu bu.</para>
  <para style="ip">IMarkus nyeni ila iYesu na ki kya, itra imogo, ki sa vulo ka uma ju iYesu, ki gina ighang upii kina umẹẹ nga wu. Akperi uce unyeni ila iYahaya aghọ na aBaptisma kina aBaptisma kina umara iYesu, aghọ wọọ kishang A kpa utina uju iYesu ọnga lẹni na adumu kina umẹẹ nga. Idẹ ukyeng akyua ni, aghọyii nga ava kpẹlẹ nga naiburu, ni aghọ tọrọ bu nga ba tọrọ bu nga nagigang. Irisop inga maa nyeni umumani iYesu ju ọnga awii atinsara utili nga ka sing, naiburu mani agira nga kaya ukumu shi kina usang nga ka lor.</para>
  <para style="ip">Ika ipai amaa awọ ni, ingọ mani ataa ago ko, nadidu na ayira si ace aghọ nga wo ba aghu mani awo awoo iMarkus ba.</para>
  <para style="iot">Umumani ushi kidẹ</para>
  <para style="io1">Irẹkpa ila ididuma 1.1-13</para>
  <para style="io1">Utina iYesu ga aGalili 1.14-9; 50</para>
  <para style="io1">Ko kpa ka aGalili kiya ta ka aUrshelima 10.1-52</para>
  <para style="io1">Awii itinsara amaa kidẹ aUrshelima kina uhọ nga wu 11.1-15; 47</para>
  <para style="io1">Usisang iYesu ka alọr 16.1-8</para>
  <para style="io1">Ukunu kina ukyeng Ate mani asang ka lọr ki kyaa ayaya 16.9-20</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">IYahaya ghila iminimini akeri utra</para>
  <para style="r">(<ref loc="MAT 3:1-12">IMat 3.1-12</ref>; <ref loc="LUK 3:1-9">ILuk 3.1-9</ref>; <ref loc="LUK 3:15-17">ILuk 3.15-17</ref>; <ref loc="JHN 1:19-28">IYah 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Udiwu shi ila ididuma na kyọ ju kaya ẹrẹkwẹ iYesu iKristi, Anọ Ọnọng. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />Aju kindọ kọnọ mani awọọ kidẹ awọ aghọ pii kọ ọtọ Ọnọng Ishaya ni si,</para>
  <para style="q1" vid="MRK 1:2">“Uwẹ ni, iki tuma atuma mi ka aba la ngọ ite kọ,</para>
  <para style="q2" vid="MRK 1:2">Aghọ umani aki ker ngọ utra.”<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />Ẹrẹwyuẹ yọrọ ka aghumu sọ tẹri si,</para>
  <para style="q1" vid="MRK 1:3">“Inu ker Ate ọna utra,</para>
  <para style="q2" vid="MRK 1:3">Inu nawa itra nga.”<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />IYahaya aghọ uju iminimini vasa yeni ẹrẹkwẹ nga ka ghumu na asọ tẹri upii Ọnọng na tẹri si ajiya lọkpaa na ju bọ iminimini ka cira bọ avulu bọ kọ. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Nadidu ajiya ọsii anọrọfọng aYahudiya, kina ajiya Urushelima asha keng ọkọ shi nga na asha tẹri avulu bọ na asha lọkpaa. Asa ju bọ iminimini ka Ẹrẹyẹma Urdun. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />Igbang iYahaya ni aju wu na ufung ọrahimi kọ. Avasa lor abuu nga kini idang. Imila nga ni agiya yọ kini iritọng. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Atẹri upii Ọnọng, na atẹri si, “Ace aghọ ki ba kọ tumu mi aghọ umani agana mi nọ ughọghe, aghọ umani ita ma mi ni kpogho ki yemi aning akpọ nga ba. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Imẹ ju nu iminimini na amusumu, inga ni Aghing Ọnọng nga ni aki ju nu kọ.<verse eid="MRK 1:8" /></para>
  <para style="s">Aju iYesu iminimini</para>
  <para style="r">(<ref loc="MAT 3:13-17">IMat 3.13-17</ref>; <ref loc="LUK 3:21-22">ILuk 3.21-22</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Akyua ra ni, iYesu ba ka aNazaret ki ẹrẹbọng aGalili, iYahaya vasa ju nga iminimini ka Ẹrẹyẹma Urdun. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />IYesu sọ kunu kidẹ na amusumu ni, avasa nu ayaya na yemi, Aghing Ọnọng sọ shulu kaya nga kọ tọọ ikhimi. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Avasa kọng iriywi ka ayaya ni tẹri si, “Ingọ shi Anọ mi angọ umani imẹ yoo. Ika peni ikwyi tọmọ ni ngọ nagigang.”<verse eid="MRK 1:11" /></para>
  <para style="s">Ishẹẹ mra iYesu</para>
  <para style="r">(<ref loc="MAT 4:1-11">IMat 4.1-11</ref>; <ref loc="LUK 4:1-13">ILuk 4.1-13</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Kaidu akyua ni Aghing Ọnọng vasa kpaa iYesu ki kyaa idẹ aghumu kọ, <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />ukadu wu na ci kọ ki ta ka awii ishi nari. Ishẹẹ sọ mra nga. IYesu shi kini inọma aghumu, kindi wu ni Atuma Ọnọng sha shi ni nga na aju nga utina.<verse eid="MRK 1:13" /></para>
  <para style="s">IYesu kyọ uju utina nga ka aGalili</para>
  <para style="r">(<ref loc="MAT 4:12-17">IMat 4.12-17</ref>; <ref loc="LUK 4:14-15">ILuk 4.14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Aya ta iYahaya kọ ubọọ iting ni, iYesu vasa ghila ifọng aGalili na sọ tẹri ila ididuma umani ikunu kukushi Ọnọng. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Asọ tẹri si, “Akyua ya ju! Ẹrẹgọm Ọnọng ya ba ayayo! Ọlọkpaa, kọ uma aipang ni ila ididuma.”<verse eid="MRK 1:15" /></para>
  <para style="s">IYesu yọrọ aghọ hwiri itagbo anari</para>
  <para style="r">(<ref loc="MAT 4:18-22">IMat 4.18-22</ref>; <ref loc="LUK 5:1-11">ILuk 5.1-11</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />IYesu sọ wolu ka abẹni ighọng aGalili ni, avasa nu iSiman kina anayuru nga Andrawus, na sọ fẹri isha angọ hwiri itagbo ka ighọng nga ka bọ ni aghọ hwiri itagbo bọ. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />IYesu vasa tẹri bọ si, “Inu yii mi, Imẹ ki tee ni nu aghọ hwiri ajiya kọ ba nọ ukushi mi kọ.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Kaishang ni avasa ya isha bọ ungọ hwiri itagbo, ki yii nga.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Aya fuma ite naji ni, avasa nu iYakubu anọ iZabadi, kina anayuru nga iYahaya, ashi kidẹ ọgbọlọ bọ, asọ ker isha angọ hwiri itagbo. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Kaishang ni ava yọrọ bọ, avasa ya ate bọ iZabadi ya kidẹ ọgbọlọ nga kina aghọ ju utina umani akpaa, avasa yii nga.<verse eid="MRK 1:20" /></para>
  <para style="s">IYesu wuli aghing ababi</para>
  <para style="r">(<ref loc="LUK 4:31-37">ILuk 4.31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />IYesu kina aghọyii nga ya ghila aKafarnahum ni. Awii Uwuru aYahudawa ya ju ni avasa ghila ọkọ takwyuẹ aYahudawa na sọ mẹẹ. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Asa wo ica kọnọ umẹẹ nga, ka amẹẹ bọ kini aghọ shi ni ẹrẹgọrọ nga ni, ashi kini aghọmẹẹ umẹẹ iMusa ni ba. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />Ba irishu na ace ajiya ashi kina aghing ababi ashi kidẹ ọkọ takwyuẹ aYahudawa bọ asọ ca kpa na sha tẹri si, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />“Ikẹmbọ nọ wang kini yi, iYesu anga aNazaret? Ingọ ba kọ ma pili yi kọ? Iye to ngọ shi nga ni, ingọ shi aghọ upipar angọ Ọnọng!”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />IYesu vasa gẹr ushẹẹ nga, ki tẹri si, “Kọmọ na kikir! Kunu kidẹ ajiya ri!”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />Aghing ababi vasa zuru ajiya nga nagigang, ata kpa, avasa kunu kidẹ nga.<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />Ajiya nadidu vasa wo ica, na asha ghulu ace bọ na asha tẹri si, “Ikẹmbọ shi kindi ni? Tabijam! Aidi ni umẹẹ ọsọsa wẹ kina ẹrẹgọrọ! Ajiya ri shi kini ẹrẹgọrọ umani aki gawa na aghing ababi ka kọng nga lẹ!” <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Kaishang ila vasa kpaa kwabi ki ẹrẹbọng aGalili.<verse eid="MRK 1:28" /></para>
  <para style="s">IYesu lẹni kini akẹri IBitrus</para>
  <para style="r">(<ref loc="MAT 8:14-15">IMat 8.14-15</ref>; <ref loc="LUK 4:38-39">ILuk 4.38-39</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Aya kunu kọ ọkọ takwyuẹ aYahuda ni, avasa ghila ọna iBitrus kina Andrawus kina iYakubu ni iYahaya. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Akẹr iBitrus yẹẹ ni ẹrẹnọma nga furu wu ashi akyuọ ba. IYesu ya ghila ni, avasa tẹri nga ila wu. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Avasa kyaa ukushi nga kiya kpẹnẹ nga avọ ki shang nga. Avasa lẹni nọ udumu nga, avasa sisang ki ju utina ker bọ imila.<verse eid="MRK 1:31" /></para>
  <para style="s">IYesu lẹni na ajiya nagigang</para>
  <para style="r">(<ref loc="MAT 8:16-17">IMat 8.16-17</ref>; <ref loc="LUK 4:40-41">ILuk 4.40-41</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Kọnọ ọnọghe, nọ ukpaa ọnọng, avasa ba iYesu nadidu adumu, kina ajiya shi nọ ushẹẹ. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Ajiya ifọng nadidu vasa ta ikuu ka anyu ọna. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />A lẹni na adumu na pam, kina aghọ shi ni idumu ighi-ghọ, avasa wuli ajiya ushẹẹ na pam. Ata va ma agọlọ nọ ushee pẹni ba, ka aye ta anga shi inga.<verse eid="MRK 1:34" /></para>
  <para style="s">IYesu kyaa ọkọ pii no Ọnọng ọkọ umani ba ace aghọ ya ba</para>
  <para style="r">(<ref loc="LUK 4:42-44">ILuk 4.42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Kọnọ ọti ikyua, itii su shi kọ, iYesu sisang ki kunu ki kyaa uce uka umani ba ace aghọ ya ba, kiya pii nọ Ọnọng kọka du. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />ISiman kini aghọmani ashi kini nga vasa kunu wang nga. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Aya peni nga ni avasa tẹri nga si, “Ajiya nadidu sọ wang ngọ.”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />IYesu vasa yira bọ si, “Ayọ ma kẹẹ kọ ufọng shi kite, ki imẹ ya tẹri upii Ọnọng kọ kadu ki imumani iba ni mẹ yidu.” <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />Aghẹmẹ ufọng aGalili nadidu na asọ tẹri upii Ọnọng ka ọkọ takwyuẹ aYahudawa bọ, na sha wuli ajiya ushẹẹ kọ.<verse eid="MRK 1:39" /></para>
  <para style="s">IYesu lẹni kini aghọnọ ubili</para>
  <para style="r">(<ref loc="MAT 8:1-4">IMat 8.1-4</ref>; <ref loc="LUK 5:12-16">ILuk 5.12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Ace aghọnọ ubili ba ọkọ shi iYesu, ata aghong na sọ shọr na tẹri si, “Ipeni uyira ushọr mi ni, lẹni ni imẹ ki ba na pipar.<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Ahwoo vasa kpẹnẹ iYesu kọ, avasa nawa avọ nga ki piya nga kọ, ki tẹri nga si, “Imẹ yira, ba na pipar!” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Ki iripẹ ukadu ni ubili nga vasa kpẹri bọ, avasa ba na pipar. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Ki iripẹ ukadu ni iYesu vasa shira nga kiva waa nga atọng si, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />“Ingọ ba ya tẹri ace aghọ ba. Nọsọ ya yeni ẹrẹkwẹ ngọ kukushi ifirist, ọsọ ya dọmọ kọnọ umani umẹẹ iMusa tẹri ni, kọ hwuru ẹrẹkwẹ ngọ ka ajiya kpẹlẹ si ọkọ lẹni.” <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />Kọ taa udu ni, ajiya nga vasa kunu na sha tẹri upii Ọnọng kwabi. Udu sani iYesu ta bra ughila ice ifọng ka ayayẹ ba, a lite nọ ci ka sing ẹkọ mani ba ace aghọ ya ba. Kindi ni ajiya lite nọ keng ukushi nga ki ẹka na pam.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">IYesu lẹni na aghọ shọmọ avọ</para>
  <para style="r">(<ref loc="MAT 9:1-8">IMat 9.1-8</ref>; <ref loc="LUK 5:17-26">ILuk 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Ala nira awii ni, iYesu vasa kimi vuwa nga aKafarnahum, ajiya vasa kọng ila si ashi ka aca. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Ajiya nagigang vasa curu, ba kọ she ki ta ka anyu bọọ. IYesu sọ tẹri bọ upii Ọnọng. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Agha nari vasa ba na kpaa ajiya mani avọ nga kọ shọmọ wu. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Na ra bra bọ ghila ni nga ukushi iYesu ba ka ajiya fo nagigang, avasa yẹmi ọkọ ufiya iripẹ ọkọ mani iYesu shi kọ. Akulu uka ni, avasa shulu kini ajiya nga kini ishọr nga.<verse eid="MRK 2:4" /></para>
  <para style="s">Ọkọ fiya mani a yẹmi</para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 2:5" />IYesu ya nu uma aipang bọ ni avasa tẹri aghọ shọmọ avọ si, “Anọ mi, a cira avulu ngọ kọ.”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Kindọ ni ace aghọmẹẹ umẹẹ iMusa shi kọ kadu, asọ sha ghulu kidẹ ikwyi bọ, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />asha tẹri si, “Ikẹmbọ ba ni ajiya ri sọ pii kindọ? Asọ pii nọ Ọnọng kagbagbara kindi ni! Ingaa shini udu ẹrẹgọrọ cira avulu ace aghọ basi Ọnọng ba ni kayu nga?”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Kaishang iYesu vasa kpẹlẹ imumani asọ pii kidẹ ikwyi bọ, avasa tẹri bọ si, “Ikẹmbọ ba ni ọsọ pii kidẹ ikwyi nọ kindọ? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Uligba kọ gina nọ yuyo, na tẹri adumu nga si, ‘A cira avulu ngọ kọ,’ Kọta atẹri si, ‘Sisang kọ kpaa ishọr ngọ kọ keng?’ <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />kindọ ni iwang sọ nu ye si Anọ Ajiya shina ẹrẹgọrọ cira avulu kaya asing ri.” Avasa tẹri aghọ shọmọ avọ si, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“Imẹ tẹri ngọ si, sisang, kọ kpaa ishọr ngọ kọ kyang aca.” <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />Avasa sisang kaishang, ki kpaa ishọr nga, ki kunu nga. Nadidu ajiya nga sọ kyoo nga, na sa wo ica, na jọọ Ọnọng na tẹri si, “Iyi sọnọ nu yi ighọ ima ushii kindi ba.”<verse eid="MRK 2:12" /></para>
  <para style="s">IYesu yọrọ iLawi</para>
  <para style="r">(<ref loc="MAT 9:9-13">IMat 9.9-13</ref>; <ref loc="LUK 5:27-32">ILuk 5.27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />IYesu vasa khimi kunu ku ki kyaa anyu Ighọng aGalili. Ajiya nagigang ti kuu ki ghimi nga, avasa mẹẹ bọ. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Asọ wọlu ni, avasa nu iLawi anọ iHalfa na ci kọ bọọ yira agonu. iYesu vasa ju nga si, “Yii mi.” Avasa sisang ki yii nga.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Ace awii ni, iYesu sọ la imila kọ ọna ilawi. Ace aghọ yira agonu kina ace aghọ vulu nagigang sọ la imila kina aghọyii nga ka ajiya nagigang kidẹ bọ yii nga. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Ace aghọmẹẹ umẹẹ iMusa na aFarisiyawa bọ, anu na sọ la imila kina aghọ vulu ra kina aghọ yira agonu. Avasa wulu atina nga si, “Ikẹmbọ sa na sọ la imila kina aghọ yira agonu kina aghila avulu?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Akọọ kindi ni, iYesu vasa tẹri bọ si, “Agha akyuọ kara wang bọ avaa ba, sa adumu. Ita bami ki ma yọrọ aghọ shina aipang ba, sa aghọ vulu.”<verse eid="MRK 2:17" /></para>
  <para style="s">Uwulu upii ka ukpẹnẹ anyu</para>
  <para style="r">(<ref loc="MAT 9:14-17">IMat 9.14-17</ref>; <ref loc="LUK 5:33-39">ILuk 5.33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Kindọ ni atina iYahaya aghila iminimini kina anga aFarisiyawa sọ kpẹnẹ anyu, ace ajiya vasa ba ọkọ shi iYesu na sọ wulu nga si, “Ikẹmbọ ba ni atina iYahaya kina nga aFarisiyawa aka kpẹnẹ anyu bọ, ni anga ngọ ka ju bọ ba?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />IYesu vasa yira bọ si, “Ayikyo aghimi ubiya ka kpẹnẹ anyu ka kyua mani ashi kini bọ lẹ? Ai, na akyua mani aghimi ubiya shi kini bọ ni, aki kpẹnẹ bọ anyu ba. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Akyua ki ba mani aki kpaa aghimi ubiya kaya bọ. Akyua ra kọ na aki kpẹnẹ anyu kọ.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“Ba aghọ ki ta igbang ititang kina ugyauto asasa. Insi aju kindọ ni, uta ọsọsa sọ yuru igbang ititang ya, kọ giya gina kọnọ ubibi. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Ba aghọmani aki shiri amusumu ikọlọ na shi asasa kidẹ uwo ọtọtang. Ipeni aju kindọ ni amusumu ikọlọ na shi ki sara uwo kọ ka ava taa uwo kina amusumu ikọlọ na shi, amusumu ikọlọ na shi asasa sa uwo ọsọsa.”<verse eid="MRK 2:22" /></para>
  <para style="s">IYesu nga shi Ate Awii uwuru aYahudawa</para>
  <para style="r">(<ref loc="MAT 12:1-8">IMat 12.1-8</ref>; <ref loc="LUK 6:1-5">ILuk 6.1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Ace Awii uwuru aYahudawa ni iYesu kina atina nga asọ walu ki ija alkama. Ashi kidẹ ukeng ni atina nga vasa wura akwyi alkama. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />AFarisiyawa vasa tẹri nga si, “Nu imumani atina ngọ su ju. Ikẹmbọ sani inu ju imumani umẹẹ iMusa kla kọ si aju ka Awii uwuru aYahudawa?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />IYesu vasa yira si, “Inu sọnọ pila imumani iDauda ju ka akyua umani inga kina ayikyo ukeng nga kọọ idafo? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Akyua Abiyata ifirist ighighẹ ni, iDauda vasa ghila idẹ ọna Ọnọng, kila ubiredi mani akyo, ungọ umani umẹẹ iMusa ni, awang bọ si ace aghọ la ba, se ifirist ka yayu nga, kiva ma ayikyo ukeng nga kọ!”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Avasa tẹri bọ si, “Aju Awii uwuru aYahudawa kaya ajiya kọ, basi ajiya nga ni aju kaya awii wuru aYahudawa ba. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Kindi ni Anọ Ajiya nga shi Ate ọna kina Awii uwuru aYahudawa.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">IYesu lẹni na aghọni avọ nga shọmọ wu</para>
  <para style="r">(<ref loc="MAT 12:9-14">IMat 12.9-14</ref>; <ref loc="LUK 6:6-11">ILuk 6.6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Ace awii ni, iYesu ghila idẹ ọkọ takwyuẹ aYahudawa, ace ajiya shiya ni avọ ila nga kọ shọmọ wu. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Ace ajiya sa nga ica, ka anu ta iYesu ki lẹni ni nga ka Awii uwuru aYahudawa ni, kibọ peni nga na uvulu. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />IYesu ba tẹri ajiya aghọmani avọ nga shọmọ wu si, “Sisang kọba titara kite bajiya.”<verse eid="MRK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4" />IYesu ba ghulu bọ si, “Ikẹmbọ shi ọdọdọma na ju ka Awii uwuru aYahudawa? Aju ima ididọma ta akakiya? Afoo ọkyuọ ta apii wu ni?” Ni aba kọmọ na kikir.<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />Aba kyoo bọ nadidu bọ na anang, kini ikwyi ibibi nọ mani aka hwiri bọ atọng ba, aba ju ajiya shọmọ avọ si, “Nawa avọ ngọ.” Asa nawa, avọ nga ba akyuọ. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Afarisiyawa ba kunu bọ na aba dẹẹ kọ wang utra kina ajiya iHiridus umani aki pii iYesu kọ.<verse eid="MRK 3:6" /></para>
  <para style="s">Ikir bajiya yii iYesu ki ya fuma ighọng aGalili</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />IYesu sang nga kina aghọyii nga ki kya bọ anyu ighọng, ni ikir bajiya ka aGalili yii nga. Ajiya na pam ba ka aGalili yii nga kina ajiya aYahudiya, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />kina Urushelima, kina aghọ ishẹẹ Edom, kina aghọ ubuu ẹrẹyẹma Urdun, kina ajiya ishẹẹ aTaya kina aSidon. Nadidu ajiya ri ba ukushi iYesu ka akọọ nadidu umumani ashi kọ ju. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Ikir bajiya sa ni, atẹri aghọyii nga si awang nga anọ ọgbọlọ, ka ajiya ba mẹni nga kọ ba. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Aju kindọ ka akọ ma ajiya na pam lẹni, ki ta kọ mani adumu su yiri kya bọ na awang ya piya nga. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Nadidu akyua umani aghing ababi nu nga kọ ni, aka kpaa kite nga ki ci na tẹri si, “Ingọ ni anọ Ọnọng nga.” <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Ni, aba waa atọng bọ si, aba yeni ace aghọ ta anga ni inga ba.<verse eid="MRK 3:12" /></para>
  <para style="s">IYesu hwiya Atina nga ushọ na apai</para>
  <para style="r">(<ref loc="MAT 10:1-4">IMat 10.1-4</ref>; <ref loc="LUK 6:12-16">ILuk 6.12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />IYesu ya Kila nga Aya ugbana, ni aba ba yọrọ aghọmani awang, ni aba ba ukushi nga. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Aba hwiya aghọ ushọ na apai kidẹ bọ, ace aghọ bọ ni ayọrọ bọ si atina nga. Aki ka shi kina nga, aki ka tuma ka aya tẹri upii Ọnọng, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />ka aba shi na ẹrẹgọrọ uwuru ushẹẹ. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Aghọ ushọ na apai na hwiya bẹ, iSiman, aghọmani iYesu ma nga uca si iBitrus, <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />iYakubu anọ iZabadi kina anayuru nga iYahaya aghọmani ama bọ uca si iBuwarnajis, anọ iriviya. <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Andarawus, iFilibus, iBartalomi, iMatiyu, iToma, iYakubu anọ iHalfa, iTadiyos, iSiman, agha aKan’ana, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />iYahuda Iskariyoti aghọmani agbara iYesu.<verse eid="MRK 3:19" /></para>
  <para style="s">IYesu kina uBalzabul</para>
  <para style="r">(<ref loc="MAT 12:22-32">IMat 12.22-32</ref>; <ref loc="LUK 11:14-23">ILuk 11.14-23</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />IYesu ba ghila uce ọna, ikir bajiya ba curu ki sa ni inga kina aghọyii nga ta peni bọ akyua ula imila ba. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Aghọ ọna nga ya kọọ kindi ni, aba kyaa si ibọ ya kpẹnẹ nga, ka ajiya su tẹri si azọọ nga.<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Aghọmẹẹ iMusa na aba ka Urushelima ba ju si, “uBalzabul agọm ushẹẹ nga ghila nga! Akyuọ nga wu na asu wuru ushẹẹ wu.”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />IYesu ba yọrọ bọ ki pii kina ibọ na ighang upii, “Na nyi wu ni ishẹẹ ki woo ishẹẹ kọ? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Insi ẹrẹgọm kau ni, ni isọ ju irisho na ace ni, ita ki tara wu ba. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Kindi wu ni insi ọna kau ni, ni isọ ju irisho na ace ni, uta ki tara wu ba. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Ni insi Ishẹẹ ghila ki kau ẹrẹkwẹ nga ika ipai ni, aki tara nga ba. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />Aipang ni, ba aghọmani aki ghila idẹ ọna agha ẹrẹkyuọ kaya kpaa uma nga ba inbasi azọnọ lo agha ẹrẹkyuọ ba ni, aki tọ bira uyi ka ọna. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />Imẹ tẹri nu aipang, aki kpaa ajiya ko iligba ighọ avulu kọ kina upii agbagbara mani apii nu Ọnọng. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Ni, aghọmani apii agbagbara na aghing Ọnọng ni, aki cira bọ avulu nga kọ ba; A vulu nga shi na amra ba.”<verse eid="MRK 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 3:30" />Atẹri kindi ka abọ sọ tẹri si “Ashi na aghing ababi.”<verse eid="MRK 3:30" /></para>
  <para style="s">Ayuru iYesu kina anayuru nga</para>
  <para style="r">(<ref loc="MAT 12:46-50">IMat 12.46-50</ref>; <ref loc="LUK 8:19-21">ILuk 8.19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Ayuru iYesu kina anayuru nga ba ukushi nga, a tara kọ seshi na asa tuma si ayọrọ nga. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Ikir bajiya ci ki ghimi nga, ni aba tẹri nga si, “Ayuru ngọ kina anayuru ngọ kina afọọ ngọ si ka useshi ni awang nu ngọ.”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Aba ghulu si, “Inga bu bọ si ayuru mi kina anayuru mi?”<verse eid="MRK 3:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 3:34" />Aba kra aghọmani aci ki ghimi nga ki ju si, “Ayuru mi wẹ kina anayuru mi! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Aghọmani aju imumani Ọnọng wang, anga si anayuru mi kina afọọ mi kina ayuru mi.”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Ighang upii aghọ upila</para>
  <para style="r">(<ref loc="MAT 13:1-9">IMat 13.1-9</ref>; <ref loc="LUK 8:4-8">ILuk 8.4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />IYesu kpaa umẹẹ ka anyu Ighọng aGalili. Ikir bajiya na acuru ni asi na pam nagigang ki ta kọ umani aghila idẹ ọgbọlọ ki cica ki ighọng, ni ajiya nga shi ka ya ugbana ka anyu ighọng. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />A mẹẹ bọ uma na pam ni ighang upii, kidẹ umẹẹ nga ni asi, <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />Inu kọ! Aghọ uwuu kyaa upila ighọ nga. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Ashi kidẹ uta ighọ ni, ice kpaa ka utra, anurunu la yọ kọ. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Ice kpaa ka uka mani atii shiya, uka umani ba ẹrẹbọ nagigang. Amii kaisa ka ẹrẹbọ ta shiwu ikyuu ba. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Ọnọng utaa ya ba uci ni, ọba for bọ na ghau bọ ka ataa shi bọ na akang ba. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Idaa ighọ kpaa kidẹ akara, iya fọnọ ni, isa tulu imila, na ataa sa bọ ikii ba. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Ice kpaa ki ẹrẹbọ ididuma. Amii ki fọnọ ki sa ikir, ishi-shitai, ishi-shitin kina ara-raji.”<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Asa ju si, “Nadidu aghọ shi na atọng ni, akọ.”<verse eid="MRK 4:9" /></para>
  <para style="s">Ima ri ighang upii aghọ upila yeni</para>
  <para style="r">(<ref loc="MAT 13:10-17">IMat 13.10-17</ref>; <ref loc="LUK 8:9-10">ILuk 8.9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Akyua ni iYesu shi kayu nga ni, aghọyii nga kina atina nga usho na pai ghulu nga imumani ighang upii yeni. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Aba tẹri bọ si, “Aku yeni nu ushi ẹrẹgọm Ọnọng. Aghọmani ashi bọ kidẹ nu ba ni, aka tẹri bọ uma nadidu ni ighang upii. <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />Uwu sa ni,</para>
  <para style="q1" vid="MRK 4:12">‘Aki nu ni ataa ki kpẹlẹ bọ ba,</para>
  <para style="q2" vid="MRK 4:12">Aki kọọ ni ataa ki kpẹlẹ bọ ba,</para>
  <para style="q1" vid="MRK 4:12">Iba kindi ba ni, ata kọ vuwa na cira uvulu bọ kọ’”!<verse eid="MRK 4:12" /></para>
  <para style="s">IYesu yeni ighang upii aghọ upila</para>
  <para style="r">(<ref loc="MAT 13:18-23">IMat 13.18-23</ref>; <ref loc="LUK 8:11-15">ILuk 8.11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />IYesu ba tẹri bọ si, “Inu ta kpẹlẹ nu ighang upii ri ba? Na nyi wu ni inu ki kpẹlẹ ighang ushẹ wu? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Aghọ upila pila upii Ọnọng. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Ace ajiya shi kini ighọ mani ikpaa kọ utra ni, uka umani apila upii Ọnọng kọ ni. Akyua na akọọ ni, Ishẹẹ ki ba ka aba kpaa upii na akọọ wu. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Ace aghọ bọ ni, ashi kina ighọ na apila kidẹ atii ni, akọọ upii ni, ayira ni ikwyifu. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Ashi bọ na akang ba ni, a tara anakyua wu. Asọ kọọ ububi kini umẹni upii ni, kidẹ anakyua ni aka vuwa nọ utumu. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Ighọ ni ikpaa kidẹ akara ni, abọ si aghọmani akọọ upii, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />ni uduma asing nu ci kidẹ, kina ahwula uce nọ uma sa ni upii ta ci wu kidẹ ikwyi ki ju utina ba. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Inga ni ikpaa ki ẹrẹbọ ididuma ni, abọ si aghọmani akọọ upii, ki yira, ki ju utina wu ki jee kaya, ace aghọ bọ ni ishi-shitai, ace aghọ bọ ni ishi-shitin, ace aghọ bọ ni ara-raji.”<verse eid="MRK 4:20" /></para>
  <para style="s">Ighang upii agbilimọ ni ima uting</para>
  <para style="r">(<ref loc="LUK 8:16-18">ILuk 8.16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />IYesu ju bọ si, “Inu ka ta ugha ọgbẹlẹmọ ki kyo kidẹ ikọọ ko ata icuru? Ba inu ka kyo kaya uka ukyo ọgbẹlẹmọ ba? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Nadidu imumani asọ ni, aki nu yọ, nadidu imumani isi kọ yuyi ni, aki ta yọ ka yayẹ. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Nadidu aghọ shi na atọ ni, akọ.”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Aba ju bọ si, “Inu ka ghla atọng nọ kọọ na biribọ! Imumani inu mira kọ ni, iyọ na aki mira nu kọ, ka aba khimi kọ. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Aghọmani ashi ni ima ni, aki khimi nga kọ; aghọmani ashi ni ima ba ni, anọ imumani ashi ni yọ ni, aki ya yira wu kukushi nga.”<verse eid="MRK 4:25" /></para>
  <para style="s">Ighang upii ighọ umani imii</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Aba tẹri si, “Umani ẹrẹgọm Ọnọng shi wẹ. Shi kini ajiya na ata ighọ ki ẹrẹbọ ni. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Ating kina atọnọọ, ko ni amoo, ko ni ata moo nga ba ni, ighọ ki mii ki fọnu, ni ata ye nga ba. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Ẹrẹbọ ka ma imila ki kirkwyi wu, aka zọnọ wo ushii, ni atọ wo akwyi alkama, ẹrẹkwẹ ba ma ikir. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Imila yọ ba ula ni, aki wa ni ikuma waa imila, ka akyua ucuru imila ya ba.”<verse eid="MRK 4:29" /></para>
  <para style="s">Ighang upii ikii ikpo</para>
  <para style="r">(<ref loc="MAT 13:31">IMat 13.31</ref>; <ref loc="LUK 13:18-19">ILuk 13.18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />IYesu ba ju si, “Ayọ ki tẹri si ẹrẹgọm Ọnọng shi na nyi, ta iligba ighang upii yọ ni ayọ ki yeni wu? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Ishi kini ikir ikpo ni, inga ni iyọ cẹẹ nọ ọzọzi ikir kidẹ uma umani apila ki ẹrẹbọ. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Kindi ni, insi apila ni, aka fọnu ki cẹẹ uma umani apila kidẹ uwiya, kina aga akakọ, anurunu ayaya ka shulu ki ta asọọ ki ci ki iwuu nga.<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Ighang upii yọ na pam ni iYesu tẹri bọ upii wu, kọ mani aki kpẹlẹ. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Ata tẹri bọ ice ima ba ighang upii ba. Ni akyua umani ashi kina aghọyii nga ka ayu bọ ni, aka yeni kwikẹ ka yayẹ.<verse eid="MRK 4:34" /></para>
  <para style="s">IYesu dara ugya ẹrẹyẹma</para>
  <para style="r">(<ref loc="MAT 8:23-27">IMat 8.23-27</ref>; <ref loc="LUK 8:22-25">ILuk 8.22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Awii ra nọ ughẹ ni, iYesu tẹri atina nga si, “Ayọ ba kyai kọ uda ugẹẹ ẹrẹyẹma.” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Asang bọ ki ya ikir bajiya kọ kaa, asang bọ kini inga kọnọ umani ashi kidẹ ọgbọlọ ni. Ace agbọlọ shiya kini nga. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Uyuu afiya kina uwuu ni ẹrẹkyuọ sang, ni ugya sọ ghila idẹ ọgbọlọ nga, ni uya sọ utii na amusum. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />IYesu shi kọ utumu ọgbọlọ nga ni asọ moo, a tiya ẹrẹkwẹ nga ka ya ima utiya ẹrẹkwẹ. Atina nga shiya nga ki ju nga si, “Aghọmẹẹ, ingọ ta duma ngọ ko ni ayọ kpuru yi ba?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Aba sisang ki gẹr uwuu ki tẹri ugya si, “Kọmọ! Na kikir!” Uwuu ba kpẹẹ wu, uka ba kọmọ nakikir.<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />Aba tẹri atina nga si, “Ikẹmbọ sa ni inu sọ tẹ ẹrẹbata? Ki ta ka kyuari inu ta shi nu nọ uma aipang ba?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Aba kọọ ẹrẹbata nagigang ni asọ ghulu ace bọ si, “Inga wudi ri? Uwuu kina ugya sọ kọọ nga atọng!”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">IYesu lẹni na aghọmani aghing Ababi ghila</para>
  <para style="r">(<ref loc="MAT 8:28-34">IMat 8.28-34</ref>; <ref loc="LUK 8:26-39">ILuk 8.26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />IYesu kina aghọyii nga ya bulu ushii ighọng mani ishi ka ẹlẹbọ aGarasinawa. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />IYesu ya kunu nga ka ọgbọlọ ni, ace ajiya umani asọ kina aghing ababi ba shi kunu ka uka na alọr ki ma peni nga. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Ajiya ri ni, aci ka uka na alọr, ba aghọ umani aki bra lo nga, ko na asara. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Aku ke loru nga ka na asara ka avọ na afra, ni ava kara asara ki wura ima upọwu ki ifra nga. Ba aghọmani ashi ni ẹrẹkyuọ udẹmi nga ba. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Ating na atọnọ kidẹ na alọr kina aya apa na asọ taa akpa na asa waa ẹlẹnọma nga na atii.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Aya nu iYesu adọ shi ka atatọọ ni, asang nọ utitẹ ki ya kpaa na agho ka sice nga. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Ata akpa nagigang, “Ikẹmbọ duma ngọ na ayọ, iYesu, Anọ Ọnọng, Aghọ ucẹẹ nọ Ughọghẹ? Suu nọ Ọnọng ni ungọ dọ ma mi nga ọlọ ma!” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Ki iYesu kọ taa nga, “Kunu kidẹ nga ungọ aghing ababi!”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />IYesu ba ghulu nga si, “Ikẹmbọ sọ uca ngọ?” A ya yila di taa nga,</para>
  <para style="p" vid="MRK 5:9">“Uca mi bọ sọ Napam, ka ayọ shi na pam.” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Ala kọ shọr iYesu ama kara bọ kọ uka ẹlẹbọ ma.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Atumu alade dogo pee ka ayayo upa. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Aghing ababi shọr IYesu, di taa ni, “Ta ma ayọ kukushi alade li na ayọ ghina kidẹ bọ.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />IYesu yila bọ, aghing ababi kunu di ghila idir alade, idir bọ la aji usho upai, ado kya bọ anyu ighọng, di kpaa ya kidẹ di kpuru bọ kidẹ amusum.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Kadu wu aghọ pee alade sang nọ utitẹ di ya taa kidẹ ifọng kina ẹlẹbọ. Ajiya da ba ni ibọ ba nu imumani iba. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Aya ba ukushi iYesu ni, ada nu ajiya umani ashi nọ ushẹẹ na pam na akhii ni nga na igbang kana ọkyuọ nga, ada kọng ẹrẹbata. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Aghọ umani aju ima kaya ica bọ ada taa ajiya umani aba na aghọ shi nọ ushẹẹ vasa ta bọ ukikilẹ alade. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Ada dẹẹ ko shọr iYesu aya bọ ẹlẹbọ bọ.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Aya sang ghila nga kidẹ ọgbọlọ ni, ajiya umani ada shi nọ ushẹẹ da shọr ni nga ki yii nga. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />IYesu yila nga ma, ada tẹri nga, “Kya ngọ idẹ ọna kọ ya pini ate ọna ngọ nọ tẹri bọ ima li umani Ọnọng ju ngọ, kina umani akọọ ahwo kaya ngọ.” <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Ajiya nga da ki kyaa nga di ya tee aghọ tẹri upii Ọnọng ka aDikafolis imumani IYesu ju nga. Nadidu ajiya wo ica.<verse eid="MRK 5:20" /></para>
  <para style="s">IYesu sang anayiri mani akọ kpoo ki ba lẹni na ayiri mani ashi adumu</para>
  <para style="r">(<ref loc="MAT 9:18-26">IMat 9.18-26</ref>; <ref loc="LUK 8:40-56">ILuk 8.40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />IYesu ya bulu kidẹ ọgbọlọ di kyaa nga udaa uviya ighọng ni, ikir majiya culu kukushi nga na shi ka ikyọrọ ighọng. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Ace agha aghaghẹ uka takwyuẹ aYahudawa aghọnọ uca si iYayirus ada ba, aya nu nga, ada kpaa ka sici nga, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />di shọlọ nga nagigang ataa ni “Ananọ mi anayiri wang kpo nga; imẹ do shọr ngọ ba ma tiya avọ ngọ kaya nga umani a pini ufoo lẹ.” <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />Ni iYesu da kyaa ni nga.</para>
  <para style="p" vid="MRK 5:24">Ajiya na pam da kiyii nga ado di mẹni nga. <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />Ace ayiri shi kadu umani ala anyi ushọ na pai adu shiri ayi. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Akọ kọọ ọlọ ka avọ aghọmẹẹ ikang nagigang. Akọ kpẹ na imumani asọ ni yọ nadidu, nọ umani apeni ọkyuọ, ima pala ubira yọ. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Aya kọng ila IYesu ni, ada ba ka utumu nga kidẹ idir ma ajiya di piya igbang nga, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />ka a kpaa ka ikwyi nga si, “Imẹ ma piya igbang nga ni imẹ ki lẹni.” <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Kidẹ na akyua ni ushiri ayi nga da tra, akọọ kidẹ ẹrẹnọma nga umani apeni ọkyuọ ka diji ọlọ umani asọ kidẹ.<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />Ka adidu akyua ni iYesu kpẹlẹ kidẹ nga ice ẹrẹkyuọ kunu ka ẹlẹnọma nga, atee kidẹ ikir majiya di ghulu “Inga piya igbang mi?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Aghọyii nga si, “Ingọ nu idir majiya adọ go mẹni ngọ, ungọ dọ va ghulu inga piya ngọ?”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Ala ku va ghulu adọ go ki kala ukaa awang nu aghọ umani aju nẹdọ. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Ayiri ye imumani iba kini nga, ada kunu di kpaa ka sici nga ado titaa na ẹrẹbata, ataa nga nadidu aipang. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Ada taa nga, “Anọ mi, uma aipang ngọ ma ngọ ọkyuọ; ki kya ngọ ni ikwyifu kọ ungọ lẹni kọ ọlọ umani ngọ sọ kidẹ.”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Ashi kọ upii ni, ace ajiya na aghala kọ ọna agha aghaghẹ uka takwyuẹ aYahudawa iYariyus, ataa si “Anọ ngọ anayiri kọ kpo nga, Ikẹmbọ sa ngọ dọ dama aghọmẹẹ wu?”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Ni iYesu dama nga na imumani ataa ma, ada taa agha aghaghẹ uka takwyuẹ aYahudawa, “Ama kọọ ẹrẹbata ma; uma aipang.”<verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />Aya nga ace aghọ na yii nga ma sai iBitrus, na iYakubu, na iYahaya anayuru iYakubu. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Aya ba kọ ọna agha aghaghẹ uka takwyuẹ aYahudawa ni, iYesu nu ni ajiya adọ go zọọ bọ, na ci na uwaa kpa nagigang. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Aya ghina kidẹ ni, ataa bọ, “Ikẹmbọ sa unu dọ ci nu taa akpa nagigang nidọ? Anọ kọ kpo nga ma, adọ go moo wu.” <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Ada tee aghọ sala nga unga akakiya.</para>
  <para style="p" vid="MRK 5:40">Aya woo ajiya nadidu na akya bọ useshi, a kpaa ate anọ na ayuru anọ na atina nga mani asọ kini nga, aghina uka mani anọ sọ. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />A kpẹnẹ avọ anọ, ataa nga, “Italita kumi!” umani ọdọ go yeni, “Ananọ anayiri, mi dọ ta ngọ sisang.” <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />Anọ anayiri da sang ka didu akyua da tee aghọ keng, asọ anyi ushọ na pai nọ ujee. Ka didu akyua ni awo ica. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Ada waa atọng bọ ama taa ace aghọ ma, ada taa bọ ama anọ imila na la.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Ayira bọ iYesu ka aNazaret ba</para>
  <para style="r">(<ref loc="MAT 13:53-58">IMat 13.53-58</ref>; <ref loc="LUK 4:16-30">ILuk 4.16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Asang kadu ki vuwa kya nga ifọng nga, atina nga yii nga. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Awii uwuru aYahudawa ya ba ni, ada tee aghọmẹẹ kidẹ ọkọ takwyuẹ aYahudawa, ajiya na pam umani ahwiri nga wo ica na asu taa si,</para>
  <para style="p" vid="MRK 6:2">“Ka abi kọ aghimi li peni diji uma? Ugba uye ukyuu wu na ama nga na dọ ju uma usa uwo ica?” <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Awẹ ba anga shi anọ aghọshọ ra ba? Anọ iMaryamu, anayuru iYakubu na iYusufu na iYahuda, kini iSiman? Afọọ nga shi bọ ka ji na ayọ ma?” Aba kọọ anang ni nga.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />IYesu taa bọ, aghọ pii kọ ọtọ Ọnọng ka peni nga ọkpọtọrọ ka ajiya ọna nga kina anayuru nga ma.” <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Ado bra nga ju ima usa uwo ica kadu ma, asa do ciya avọ nga kaya ace adumu na ji ki ma bọ lẹni. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Awo ica nọ umani ama bọ aipang ba.</para>
  <para style="s" vid="MRK 6:6">IYesu tuma atina nga</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">IMat 10.5-15</ref>; <ref loc="LUK 9:1-6">ILuk 9.1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">IYesu ba ghina nga anọrọfọng adọ mẹẹ. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />Aya yolo ushọ na pai dẹ tuma bọ agha pila pai, ada ma bọ ẹrẹgọrọ kaya aghing ababi.<verse eid="MRK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 6:8" />Ataa bọ ama kpaa ice ima ma sa ashi ukyeng bọ, ama kpaa imila ma, ko ipa, ko ufẹ ma. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Inu sọmọ akpọ, inu ma kpaa ice igbang ma si inga shi ki irinuma nu. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Ọna umani inu ghina ni, inu ci ya sa akyua ni inu ya ifọng. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Inkini inu ghina ifọng ada yila nọ ma ta atọrọ bọ kọọ nu, inu ya ukadu, nu zuru acọ ifra nọ ka uyeni ukpẹlẹ amaa ka aya bọ.”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Akunu di dẹ aghọ tẹri upii Ọnọng si ajiya lọkpaa. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Aba wuli ushẹẹ na pam, ki ba coo adumu na pam anyi, na aba peni ulẹni.<verse eid="MRK 6:13" /></para>
  <para style="s">Ukpo iYahaya aghọnọ abaptisma</para>
  <para style="r">(<ref loc="MAT 14:1-12">IMat 14.1-12</ref>; <ref loc="LUK 9:7-9">ILuk 9.7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Agọm IHiridus ya kọng diji ni, uca iYesu kpaa kwabi. Ace aghọ bọ su ju si, “IYahaya aghọ uju iminimini nga sang kọ ukpo, uwu sa ni ashi ni ẹrẹgọrọ ju uma usa uwo ica ri.”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Ace aghọ bọ su ju si, “Atina Ọnọng Iliya nga.”</para>
  <para style="p" vid="MRK 6:15">Ace aghọ bọ su ju si, “Kayi, ace aghọ pii kọ ọtọ Ọnọng nga anga adaa akyua.”<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />IHiridus ya kọng diji ni, asi, “IYahaya aghọmani imi kọ kyua nga ẹrẹkwẹ wu, anga sang kọ ukpo!”<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17" />IHiridus kirẹkwyuẹ nga sa si a kpẹnẹ iYahaya ki taa nga kọ bọọ iting. IHiridus ju diji kaya iHiridiya, ayiri anayuru nga iFilibus aghọmani iHiridus vo. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />IYahaya la kọ taa iHiridus si, “Umẹẹ iMusa yeni si, ushi wu uduma ma ni ingọ vo ayiri anayuru ngọ ma.” <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />IHiridiya ko IYahaya ka ikwyi nga na awang pii nga wu, ni adọ peni utra ma, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />ka iHiridus ka kọng ẹrẹbata iYahaya, aye mani asọ agha aipang kina aghọ upipar nga ado kala ọkyuọ nga. IHiridus ka duma nagigang ka kyua mani iYahaya do pii, nidọ ni aka kọọ ọdọdọma hwiri nga.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Kọ utumu ni, akyua ba. Awii agya ujee iHiridus ni, a sra aghakakọng kina agọm ọsii aGalili agya. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Anọ iHiridiya ya ba ki ma ya ni, ikwyi iHiridus kina aghakakọng tọmọ.</para>
  <para style="p" vid="MRK 6:22">Agọm ba taa anayiri si, “Ikẹmbo ni ingọ wang? Kwikẹ ingọ shọr ni imẹ ki ma ngọ yọ.” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Ada va suu nga, di taa si, “Imumani ingọ shọlọ ni, imẹ dọ ma ngọ ko na abiyatẹ ẹrẹgọm mi wu.”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Akunu di kyaa nga kushi ayuru nga di taa nga si, “Ikẹmbọ ni imẹ dọ shọlọ?”</para>
  <para style="p" vid="MRK 6:24">Aba taa nga si, “Ẹrẹkwyuẹ iYahaya aghọ uju iminimini.”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Anayiri da sang kadu di wọmọ di kyaa ukushi agọm na di ya shọlọ, “Imẹ wang ingọ ma mi ka kyuakyuari ẹrẹkwẹ iYahaya aghọ uju iminimini kidẹ ipẹ.<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Agọm da kọng ikwyi ibibi nagigang, umani akọ suu kina aghakakọng nga ni, ata bra nga tọrọ nga ma. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Kidẹ anakyua ni, agọm atuma aghọ sa nga si aya ba ni ẹrẹkwẹ iYahaya. Ajiya ba kya ki ya kyua ẹrẹkwẹ iYahaya kidẹ ubọọ iting, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />ada ba ni ẹrẹkwẹ kidẹ ipẹ. Ama anayiri, inga da ya ma ayuru nga. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Atina iYahaya ya kọng diji ni, aba di ma kpaa ọkọ nga di ya naa kọ kidẹ alọr.<verse eid="MRK 6:29" /></para>
  <para style="s">IYesu cee ajiya aji ushọ atọ</para>
  <para style="r">(<ref loc="MAT 14:13-21">IMat 14.13-21</ref>; <ref loc="LUK 9:10-17">ILuk 9.10-17</ref>; <ref loc="JHN 6:1-14">IYah 6.1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Atina iYesu curu kukushi nga di taa nga imumani ibọ ju ki ba mẹẹ. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Ni ajiya na pam sọ sa ba na asa sang bọ ni ashi bọ ni imumani aki la ba, adi taa bọ, Inu ba ki ba kya ọka umani aghọ shiya ba ka inu ya wuru.”<verse eid="MRK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32" />Ada kya bọ idẹ ọgbọlọ ka yayu bọ ki kya bọ ọka umani ajiya shi bọ ma. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Ughẹ aghọmani anu bọ ni, akpili bọ na ada te ni ifra bọ, kọ ufọng nadidu di la bọ ite wu. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />IYesu ya shulu ọka di nu idir majiya ni, ada kọọ ahwoo bọ, ka asọ lilẹ atẹm umani ashi bọ na aghọcee ma. Ada dẹẹ aghọmẹẹ bọ uma na pam.<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />Adidu akyua ni ughẹ kọ kpaa, atina nga da ba di ma taa nga, “Aghọ shinga kawẹ ma, ating wẹ ni akọ kpaa. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Shila ajiya na ki kya bọ ufọng na anila ufọng naya ghẹ ẹrẹkwẹ bọ imila.”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Ada yira bọ si, “Inu ma bọ ice ima ka ala.”</para>
  <para style="p" vid="MRK 6:37">Ava ghulu nga, “Ayọ ya ghẹ imila inga mani iki la utina awii aji apai ọnga aghọ utina na yo maa bọ na la?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Ataa bọ, “Inu sọ na ubiredi a mii? Inu kya nu ya kẹr!”</para>
  <para style="p" vid="MRK 6:38">Ada ya peni, ataa, ubiredi atọng na itagbo apai.”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />IYesu ya taa bọ aya cica aga gimi ka ya nọ ọbọng. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Ada cica aga gimi ajilaji kini ishọ itili itọng. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />A kpaa ubiredi atọng na itagbo apai ashang ibace nga ayaya, asa Ọnọng izaa ada wula ubiredi dima atina nga na ama ajiya. Ada va kau itagbo upai kidẹ bọ nadidu. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Nadidu bọ da la di suu, <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />ni atina nga da culu ọkọọ ushọ nọ upai unga awo ubiredi na itagbo. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Aghimi umani ada la shi agha aji ọshọ atọng.<verse eid="MRK 6:44" /></para>
  <para style="s">IYesu kyeng ka aya amusumu Ighọng</para>
  <para style="r">(<ref loc="MAT 14:22-27">IMat 14.22-27</ref>; <ref loc="JHN 6:16-21">IYah 6.16-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Kidẹ akyua, iYesu sa atina nga na aghila idẹ ọgbọlọ ka la ite nga ka akya bọ aBetsaida ni inga sa shira ikir bajiya. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Aya shira bọ ni, ada kya nga aya ugbana ka aya upii nọ Ọnọng.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />Ọka ya ba ughẹ na ọgbọlọ nga shi ka abiyatẹ ighọng ni inga shi ka yayu nga ka ya ugbana. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Anu atina nga na adọ kọrọ nọ ọgbọlọ nga ka uwuru sang. Ishii akyua atai anga ating wu na a kyeng ka aya na amusumu ighọng ka ya peni bọ. Awang wolu ka acẹẹ bọ, <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />aya nu nga adogo kyeng ka aya na amusumu ni, a kpaa sa ahwu nga. Aba ca akpa, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />nọ umani anu nga ni ẹlẹbata kpẹnẹ bọ kọ.</para>
  <para style="p" vid="MRK 6:50">Kidẹ akyua ni aba pẹni kini bọ di taa, “Ba duma ba! Imẹẹ. Inu ma kọọ ẹrẹbata ma.” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Kadu ni ada kila kidẹ ọgbọlọ ni bọ, uwuru da tara. Nadidu bọ wo ica, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />ada kpẹlẹ bọ ẹkẹkẹlẹ ubiredi ma; ikwyi bọ kọ ba na gbigbọng.<verse eid="MRK 6:52" /></para>
  <para style="s">IYesu lẹni na adumu ka aJanisarat</para>
  <para style="r">(<ref loc="MAT 14:34-36">IMat 14.34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Aya kpẹ ubuu udaa ushii ni, aya suu ka ẹrẹbọ aJanisarat, a ya lor ọgbọlọ ka sice kadu. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Aya kunu kidẹ ọgbọlọ ajiya da kpẹlẹ iYesu. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Ati ki kpẹri ifọng ko ki yeri adumu ni ishọr kọ ka mani a kọng si asọ <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Nadidu ọka mani akya kidẹ anọrọfọng, ufọng kina ẹrẹbọng ava kyuru adumu kọ ka ju izẹ. Asa shọr nga si aya bọ ka piya ifila igbang nga, nadidu aghọmani a piya nga ni apeni ọkyuọ.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Umẹẹ itali</para>
  <para style="r">(<ref loc="MAT 15:1-9">IMat 15.1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Ace Afarisiyawa kina aghọmẹẹ iMusa na aba kisighi Urushelima ata ikuu kite iYesu. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />Avasa nu ni ace aghọyii iYesu asọ la imila bọ ni ivọ irigbẹli, uwu shi si ara hwuru bọ ivọ bọ ba kọnọ umani itali umẹẹ nyeni. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />Ka Afarisiyawa, na ushẹ aYahudawa, ayii umẹẹ mani ayira kukushi akwyite bọ, aka la bọ ba sa hwuru ivọ bọ kini mani itali nyeni. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Insi aya vuwa ka ọka ta akwyi aghọ gheli no gbura aka la bọ imila ba sa hwuru ivọ bọ. Ni aka va yii ace idir umẹẹ mani akọ yira, kini utra ọdọdọma uhwuru asọng, iwoo, usọng, kina awuu. <verse eid="MRK 7:4" /><verse number="5" style="v" sid="MRK 7:5" />Ni Afarisiyawa kina aghọmẹẹ iMusa aghulu iYesu, “Ikẹmbọ sa ni aghọyii ngọ ashi bọ yii umẹẹ anirakpẹẹ ba, ni sọ sa la na avọ irigbẹli?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />IYesu va yira bọ si, “Aipang Ishaya tẹri imumani iki ba kaya akwyi nu! Inu aghọ ju unu ica bọ, kunu mani awọọ ni,</para>
  <para style="q1" vid="MRK 7:6">‘Ajiya ri ni, anyu kọ na sọ jọọ mi ko,</para>
  <para style="q2" vid="MRK 7:6">Ni ikwyi bọ shi atatọọ kini imẹ.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Ijirija wu ni aka jọọ mi wu,</para>
  <para style="q2" vid="MRK 7:7">Ka abọ ka mẹẹ umẹẹ bajiya</para>
  <para style="q2" vid="MRK 7:7">Kọnọ ọnga mẹ wu ni!’<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />“Inu kyo ọwọọ Ọnọng no vasa yii umẹẹ bajiya.”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Ni iYesu va tẹri bọ si, “Inu shi kini itra na mira ingọ tọrọ nọ umẹẹ Ọnọng ki inu yii unga nu umẹẹ. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Ki iMusa tẹri si, Jọọ ate ngọ kina ayuru ngọ, ni, ‘Insi ingọ cira ate ngọ kina ayuru ngọ, iyiya asọ pii nga wu.’ <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Ni inu ka ya ajiya na aya aghọ jẹẹ nga ka kyua mani ashi kini imẹni, asi nadidu imumani inu ki peni ukushi mi ni imẹ ko ma Ọnọng. <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />Ama bọ ayaye anga taa sa ate ko ayuru bọ avọ wu. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Kindi wu ni oka pulu upii Ọnọng ko, ki itali mani inu ka mẹẹ anọ nu. Kindi wu ni uka ju uce nu uma nagigang.”<verse eid="MRK 7:13" /></para>
  <para style="s">Uma mani oka sa ajiya ni irighe</para>
  <para style="r">(<ref loc="MRK 15:10-20">IMar 15.10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />NI iYesu vasa yọrọ ikir majiya nga kukushi nga kiva tẹri bọ si, “Ọkọng mi, nadidu nu, nu va kpẹlẹ na kikya. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Ba imumani ika ghila idẹ ajiya kọ kpaa ka sing ni ki sa nga irighe ba. Si, ingọ mani ikunu ki idẹ iyu ki sa nu irighe.” <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Aghọ shina atọng kọng na kọng.<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Aya sheri ikir majiya kiya ghila nga idẹ ọna ni, atina nga vasa ghulu nga si atẹri bọ uyeri ighang upii ri. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />“Inu shi kina ukpẹlẹ ki cẹri ushẹ majiya wu,” IYesu tẹri bọ si. “Inu ma ra kpẹlẹ nu ba? Inu ta kpẹlẹ nu si ba imumani ighila idẹ ajiya kọ kpaa ka sing iyu ka sa irighe ba? <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Ki ika ra kyaa yọ idẹ ikwyi ngọ ba si idẹ afo ngọ kiva kunu yọ kidẹ ẹrẹnọma?” Utẹri udu ni, iYesu yeni si imila nadidu shi na pipar.<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Avasa la ite nọ tẹri si, “Imumani ikunu kidẹ nyu iyọ ka sa ngọ irighe. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Ko kpaa kidẹ ikwyi ajiya yọ ni, uju uma ubibi ka kunu wu, uju uma ẹrẹnọma, uyi, upili ajiya, ọfifọng, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />Aghula, akakiya, udoru, uwang ọkọọ ọdọdọma, upii agbagbara, anang aghọ, ubira aghọ uca, usang ẹrẹkwẹ kina iribo. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Nadidu uma ubibi ri ni uka kunu kidẹ ikwyi ki sa nọ ba ni irighe.”<verse eid="MRK 7:23" /></para>
  <para style="s">Uma aipang ace ayiri</para>
  <para style="r">(<ref loc="MAT 15:21-28">IMat 15.21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Ni IYesu va sang nga ki kyaa isii ẹrẹbọng aTaya kina aSidon. Aghila uce ọna na ara wang ace aghọ ye sa ashi ku kadu ba, na ara bra ushoru ba. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Kidẹ akyua ni ace ayiri, aghọmani ananọ nga anayiri shi kina aghing ababi, kọng ila iYesu nava ba ukushi nga ki kpaa kite ifra nga. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Ayiri ni aBaheleniya nga, ajee nga ka aBasurofinikiya ka ẹrẹbọng aSuriya. Aghulu iYesu ka awo ushẹẹ mani ushi kidẹ anọ nga.<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />Ni IYesu va yira nga si, “Aya ananọ ka kyo la ka suu. Ushi wu nu uyeri ba na A kpa imila anọ ka fẹni ava ba.”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Ayiri va tẹri nga si “Ate ọna, ko ava ka tata igọ ka la imumani ishi inga anọ wu mani upra ki ẹrẹbọng!”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />IYesu va tẹri nga si, “Kini mani uyira ri ni, kyang aca, uki ya nu ni ushẹẹ nga ko ya anọ!”<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Akya aca kiya nu anọ nga na ayẹẹ kaya curu, ushẹẹ nga ko ya nga.<verse eid="MRK 7:30" /></para>
  <para style="s">IYesu lẹni na agbatọng</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />IYesu ya isii aTaya ki wor ka aSidon ki kyaa Ighọng aGalili, ki kyeng ki ẹrẹbọng ufọng aDikafolis. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Ukadu wu ni aba nga na ace ajiya agbatọng na akara bra nga upii ba, nava shọr iYesu sa atiya avọ nga kaya ajiya nga ka lẹni ni nga.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />IYesu kpa nga kayu nga, oka mani ba ajiya, ki sumu anivọ kidẹ ọtọng nga, ki ta akpe ki piya irighimi ajiya nga wu. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />IYesu va sang ẹrẹkwẹ ka ayaya, ki sho ufeni nagigang, ki tẹri ajiya nga si, “Iffata,” Uwu shi, “Yemi!” <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Kidẹ agọlọ ayeng ajiya nga va bra upii, irigbatọng nga va kpẹ wu, ava bra upii na bibọrọ.<verse eid="MRK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36" />Ni iYesu va tẹri bọ si ama tẹri ace aghọ ba, insi atẹri bọ si ama tẹri ba ni, aka tẹri upii Ọnọng. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Nadidu aghọmani a kọng ni awo ica. “Aju umari na bibọrọ!” Asọ pii. “Asa agbatọng na kọng upii kina izii na pii!”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">IYesu ma ajiya aji ushọ anari imila</para>
  <para style="r">(<ref loc="MAT 15:32-39">IMat 15.32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Awii ra ni, ikir majiya ba oka uyeng. Ashi bọ ni mara aki la ba, iYesu va yọrọ atina nga ki tẹri bọ si, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“Imẹ kọng ahwoo ajiya ri, ka ashi ni imẹ awii atai na aikyuari ni ashi bọ ni ima ri aki la ba. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Insi isa bọ sa akya bọ aca ba uma bọ imila ba ni, aki kpaa ko utra, ka ace aghọ bọ ba ka atatọọ.”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Aghọyii nga ghulu nga si, “Abi wu kidẹ aghumu ri ace aghọ ki peni imila mani aki ma ajiya ri?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />IYesu ghulu bọ si “Ubiredi umi wu nu ushi ni wu?”</para>
  <para style="p" vid="MRK 8:5">Ava yira si, “Ikọlọ itinsara,”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />IYesu tẹri ajiya sa acica ki ẹrẹbọ. Ava kpaa ikọlọ itinsara ki sa izaa, ava wura ki ma atina nga ka akau ajiya, atina nga va ju kindu. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Ashi kina itagbo na zẹẹ. IYesu sa izaa kaya bọ ava tẹri atina nga si ava kau bọ. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Ajiya nga la, ki suu, ki shẹ awo ki tii ọkọọ utinsara. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Ajiya nga la agha aji ushọ anari. IYesu va shira bọ. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Kidẹ akyua ni iYesu va ghila idẹ ọgbọlọ kina atina nga ki kyaa ifọng aDalmanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">Uwang amaa</para>
  <para style="r">(<ref loc="MAT 12:38-42">IMat 12.38-42</ref>; <ref loc="MAT 16:1-4">16.1-4</ref>; <ref loc="LUK 12:54-56">ILuk 12.54-56</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Ace Afarisiyawa ba ọka shi iYesu na sọ la inang kini nga. Awang mra nga, ava shọr nga si ayeni bọ amaa ka ayaya mani aki nyeni ẹrẹgọrọ nga. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Ni iYesu va sho ufẹni nagigang nava tẹri si, “Ikẹmbọ sa ni ajiya akyua ri wang amaa? kai, Isọ tẹri nu aipang! Kai ba amaa mani aki yeni agha akyua ri ba!” <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />A ya bọ, ki ghila nga idẹ ọgbọlọ, bulu udaa ogha.<verse eid="MRK 8:13" /></para>
  <para style="s">Uyisti aFarisiyawa kina iHiridus</para>
  <para style="r">(<ref loc="MAT 16:5-12">IMat 16.5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Aghọyii nga yuu ukpa ubiredi ughẹ wu ni uyeng wu na ago kidẹ ọgbọlọ nga. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />IYesu waa bọ atọng, “Inu sha kara, inu ci na zizal kina uyisti aFarisiyawa nọ nga iHiridus.”<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Ava kpẹnẹ upii na ace bọ, “Atẹri udi ka iyi shi yi kina ubiredi ba.”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />IYesu ye imumani asọ tẹri, ava ghulu bọ si, “Ikẹmbọ sa ni inu so pii ko taa ubiredi? Ko taa ka aikyuari inu ta ye nu ba nu va kpẹlẹ ba? Ikwyi nu kọ kiri yu? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Inu shini ica nu ka nọ nu ba? Inu shini atọng, nu kara kọng nu ba? Nu uta shuni nu ba? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Imẹ ya wura ki ma aghọ aji ọshọ atọng abiredi atọng, ọkọrọ umi bọ ni inu kpaa awo na titọ mani ashẹ wu?”</para>
  <para style="p" vid="MRK 8:19">Avasa yira nga si, “Ọkọọ ushọ nọ upai.”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“Ni, abiredi atinsara mani imẹ wura ki ma aghọ aji ọshọ anari ni? Ọkọrọ ọkọkọng umi bọ tii kina awo?”</para>
  <para style="p" vid="MRK 8:20">Avasa tẹri nga si, “Ọkọọ utinsara.”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Avasa tẹri bọ si, “Ni, ki ta ka akyua ri ni inu sọnọ kọ kpẹlẹ nọ upii mi ba?”<verse eid="MRK 8:21" /></para>
  <para style="s">Ulẹni ni afoo ka aBetsaida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Aya fuma aBetsaida ni, ava ba nga na ace afoo, ava shọr nga ka piya nga. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Ava kpẹnẹ avọ afoo, ki kya ni nga utumu ifọng. Aya ta nga na akpe ki ica nga, ki tiya nga avọ, avasa ghulu nga si, “Ingọ bra unu ice ma?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Ni afoo va sang ẹrẹkwẹ, ki tẹri si, “Imẹ kyoo ajiya, ashi kini ashẹ bọ ni imẹ kyoo bọ, asọ goru.”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Avasa ba tiya nga avọ ki ica nga. Afoo va wo ica, ava lẹni, ava nu kwikẹ na bibọrọ. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Ni iYesu va shira nga na vuwa nga aca, ki tẹri nga si, “Ko anifọng ni uma ghila ba.”<verse eid="MRK 8:26" /></para>
  <para style="s">IBitrus nyeni si iYesu nga shi iKristi</para>
  <para style="r">(<ref loc="MAT 16:13-20">IMat 16.13-20</ref>; <ref loc="LUK 9:18-21">ILuk 9.18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />IYesu sang, kina atina nga, ki ghila anọrọfọng aKaisariya aFilibi. Kọ utra ni ava ghulu atina nga, “Inga ni ajiya tẹri si imẹ shi?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Avasa tẹri nga si, “IYahaya aghọ uju iminimini, ace aghọ bọ ni, Iliya, ace aghọ bọ ni, ace aghọ kidẹ aghọ pii kọ ọtọ Ọnọng adaa akyua.”<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Avasa ghulu bọ si, “Ni inu ni, inga ni inu ka tẹri si imẹ shi?”</para>
  <para style="p" vid="MRK 8:29">IBitrus va yira nga si, “Ingọ shi iKristi.”<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Avasa waa atọng bọ si ama tẹri ace aghọ ila nga ba.<verse eid="MRK 8:30" /></para>
  <para style="s">IYesu tẹri ighọ ukpo nga</para>
  <para style="r">(<ref loc="MAT 16:21-28">IMat 16.21-28</ref>; <ref loc="LUK 9:22-27">ILuk 9.22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Ava kpẹnẹ umẹẹ bọ, si iyiya yọ ni Anọ Ajiya kọng ọlọ atataki, akwyite, kina ifirist ighighẹ, kina aghọmẹẹ umẹẹ iMusa ki tọrọ bọ nga. Iyiya ni aki pii nga wu, utumu awii atai ni aki sisang ni ọkyuọ. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Atẹri upii ka ayayẹ. Ni iBitrus waa nga ushii uyeng, ki sa nọ gẹr nga.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />Ni iYesu ya tee ki kyo atina nga ni, ava gẹr iBitrus ki tẹri si, “Kyang atatọọ nọ ukushi mi, Ishẹẹ! Ingọ ka pii kidẹ ikwyi ngọ kina ajiya ni ba si Ọnọng ba.”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Ava yọrọ ajiya kina atina nga, ki tẹri bọ si, “Nadidu aghọmani awang yii mi ni, sa atọrọ ẹrẹkwẹ nga, na a kpaa ukumu ushi nga, ka yii mi. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Nadidu aghọmani awang ọkyuọ nga ni, sa ataa wu. Nadidu aghọmani ataa ọkyuọ nga kaya ẹrẹkwẹ mi, kaya utẹri ila ididuma mi ni, uwang ufoo wu na aju. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Ikẹmbọ na ajiya peni inkansi apeni asing nadidu kọ taa ọkyuọ nga? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Ikẹmbọ na ajiya ko taa ọkyuọ nga? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Nadidu aghọmani akọng ighong uyeni mi kina upii mi akyua ri aghọ taa upipar kina aghila avulu, Anọ Ajiya ma ki kọng ighong uyeni nga, inkansi aya ba ni ujọọ Ate nga, kina atuma Ọnọng utaa avulu.”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Avasa terbọ si, “Isọ tẹri nọ aipang, ace aghọ bọ shiwu na ting kọ ke, na ki kpuru bu ba, sa nu ẹrẹgọm Ọnọng ni ba ni ẹrẹgọrọ.”<verse eid="MRK 9:1" /></para>
  <para style="s">Ushi iYesu tee</para>
  <para style="r">(<ref loc="MAT 17:1-13">IMat 17.1-13</ref>; <ref loc="LUK 9:28-36">ILuk 9.28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Aju awii atin ni, iYesu vasa kpa iBitrus, kini iYakubu, kini iYahaya, ki kya ni bọ ka yọọ ice ikur ighighẹ ingọ shi igbang na shi kayu bu. Ashi kọ kadu ni ushi nga vasa tee ki te bu, <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />ọgbang nga vasa ba na kpasi, nọsọ taa ọnọng, mani ba aghọ uhulu mani aki bra ju kindọ ka asing. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Sa aghọ pii kọ ọtọ Ọnọng Iliya kina aghọ pii kọ ọtọ Ọnọng iMusa na akunu ukushi bọ, na sọ pii ni iYesu.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />IBitrus vasa tẹri iYesu si, Aghọmẹẹ, ushi uduma ushii yi kọ kẹẹ, taa ni ta ọzọghọ ọtai, iyeng shi inga ngọ, iyeng ni nga aghọ pii kọ ọtọ Ọnọng iMusa, iyeng ni nga aghọ pii kọ ọtọ Ọnọng Iliya.” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Adaa ye nga imumani aki tẹri ba ka kọng ẹrẹbata nagigang.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Ace amọ vasa ba ki ma yuru bọ ya, avasa kọng ice ẹrẹwyuẹ kidẹ amọ nga, isọ tẹri si, “A ngaa shi Anọ mi, angọ mani imẹ yoo nagigang. Inu kọng nga.<verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />Ba irishu, atee ni ara nu bọ ace aghọ ba, si iYesu kaya yu nga kini bọ.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Asọ shulu ki tili ni, iYesu vasa waa bọ atọng sa ma tẹri ace aghọ ima mani anu ba, sa Anọ Ajiya sisang ka lọr. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Kindọ ni avasa ko upii kidẹ bọ, na sọ pii na ace bọ ka ara kpẹlẹ bu ẹrẹkwẹ upii ba, usang ka lọr ni.<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />Avasa wulu nga si, “Ikẹmbọ sani aghọmẹẹ iMusa tẹri si Iliya kyọ ba sọ mani iKristi sọ ra ba ni?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />IYesu vasa tẹri si, aipang nga Iliya ki kyọ ba, ka ma kyer akọ ike. Ni awọọ kidẹ upii ọnọng si, Anọ Ajiya ki kọng ọlọ nagigang, aki va tọrọ bọ nga. Ba ushi wudu ba? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Ni isọ tẹri nọ si, Iliya kọ ba, akọ ju nga akọ ike mani awang ju nga, kọnọ mani awọọ mani uki ba ka ya ẹrẹkwẹ nga.<verse eid="MRK 9:13" /></para>
  <para style="s">IYesu lẹni na anọ ushii na aghing ababi</para>
  <para style="r">(<ref loc="MAT 17:14-21">IMat 17.14-21</ref>; <ref loc="LUK 9:37-43a">ILuk 9.37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Aya vuwa bu ukushi ọshe aghọyii nga ni, avasa nu ikir ma ajiya na aghimi bọ. Aghọmẹẹ umẹẹ iMusa sọ la amuwa ni bọ. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Aya nu iYesu ni ikir ma ajiya nga vasa wo ica, avasa sang nọ utii kiya bili nga.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />Avasa wulu si, ikẹmbọ nọ sọ la amuwa kini bọ?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Ace ajiya kidẹ ikir ma ajiya vasa yira nga, ki tẹri si, “Aghọmẹẹ, imẹ we ni ba ngọ kina anọ mi, shi na ace aghing kila nga upii. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Uka mani aghing ababi sang yọ kọ ni, aka ta nga ki ẹrẹbọng. Uka sa nga na wuli ọfọ ka nyu nga, aka wula ayiri nga, ẹrẹnọma sa nawa na gbigbọng. Ipeni na aghọyii ngọ si awo bọ kọ ni, ata bra bọ ba.”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />IYesu vasa terbọ si, unu ajiya aikyua ri aghọ ta aipang, kaya ta ka aligba akyua ni iki ci kini nu? Kaya ta ka gba akyua ni imẹ ki mọr kini inu? Ọbami kini anọ.”<verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />Avasa ba kini anọ. Aghing ababi ya nu iYesu ni, bọ bra akyua avasa gyo anọ, ẹrẹnọma nga sọ tagha, a kpaa ki ẹrẹbọ na sọ vula, anyu ni asọ wuli ọfọ.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />IYesu vasa wulu ate anọ, “Kọ kpa ka aligba wii ko ni ima ri ba nga kọ?”</para>
  <para style="p" vid="MRK 9:21">Ate nọ vasa tẹri nga si, “Asọ shi ananọ. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Udumu nga ka fẹni nga ki dọ ugha kini idẹ na amusumu ka pii nga. Insi ọki bra ju icima ni kọng ahwoo yi nọ she yi kọ.”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />IYesu ba tẹri nga si, “Ikẹmbọ sa ni ọsọ wulu mi iki bra ni? kọ ike ni ima bra yọ ka aghọmani ama aipang.”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Ate anọ vasa shang iri wii ki tẹri si, “Imẹ ma aipang, shẹ mi ki imẹ sher utaa aipang ya!”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />IYesu ya nu ajiya na kyeng ba nọ tii ni, ava gẹr aghing ababi ki tẹri si, “Ingọ aghing kla Anọri upii kọ, igẹring si kunu ki ẹrẹnọma anọri, ma sọ ghila ẹrẹnọma nga ba.”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Aghing ababi vasa ta kpaa, kiva zọọ anọ nagigang, avasa kunu. Anọ vasa nyẹri kọnọ ọkọng wu ni, ajiya nagigang vasa tẹri si, “Akọ kpoo.” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Ni iYesu vasa kpẹnẹ nga kavọ kishang nga, avasa sisang ki titara.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />IYesu ya ghila idẹ ca ni, aghọyii nga vasa wulu nga kọ yuyi si, “Ikẹmbọ sa ni iyi ra bra yi uwuli aghing ababi ba?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />IYesu vasa yira bọ si, “Adibi aghing ta yo kunu bọ ba sai nọ upii nọ Ọnọng.<note caller="+" style="f"><char style="fr" closed="false">9.29 </char><char style="ft" closed="false">Ọkpini anyu</char></note>”<verse eid="MRK 9:29" /></para>
  <para style="s">IYesu va peni kọ kpo nga</para>
  <para style="r">(<ref loc="MAT 17:22-23">IMat 17.22-23</ref>; <ref loc="LUK 9:43-45">ILuk 9.43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />IYesu kini atina nga vasa yọ ka, ki lite nọ kyeng, vasa wolu kidẹ aGalili. IYesu wang si aca aghọ ye ọkọ mani ashi wu ba, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />ka sọ mẹẹ aghọyii nga si, “Aki ma Anọ Ajiya kidẹ vọ ajiya, aki pighi nga kọ. kidẹ awii atai aki sisang.” <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Kindọ ni ara kpẹlẹ bọ ima mani asọ tẹri bọ ba, ahwiri ẹrẹbata uwulu nga.<verse eid="MRK 9:32" /></para>
  <para style="s">Inga gina ni ughọghẹ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">IMat 18.1-5</ref>; <ref loc="LUK 9:46-48">ILuk 9.46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Afuma aKafarnahum ni. IYesu ya ghila aca na vasa wulu aghọyii nga si, “Ikẹmbọ nọ sọ linang kọ tra kọ ni?” <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />Avasa kọmọ na ikir, ka ala inang kọ tra ka aghọmani aki shi agha aghaghẹ kidẹ bọ.<verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />IYesu vasa cica, avasa yọrọ ọshọ na pai ki tẹri bọ si, “Nadidu aghọmani awang tee akwyi te ni sa tee aghọ tumu nadidu, ka va tee agira majiya nadidu.”<verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />A kpa ana nọ jii ki sa nga na tara ka biyating bọ ki kẹni nga, ki tẹri bọ si, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />nadidu ajiya mani ayira ananọ jii, kidẹ nọ uca mi ni, imẹẹ na yira, aghọmani ayira mi ni, ba imẹẹ na yira ba, aghọmani atuma mi nga na yira.”<verse eid="MRK 9:37" /></para>
  <para style="s">Aghọmani ashi asho yi ba ni anga yi nga</para>
  <para style="r">(<ref loc="LUK 9:49-50">ILuk 9.49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />IYahaya vasa tẹri nga si, “Aghọmẹẹ, iyi nu ace aghọ na sọ wuli ushẹẹ kidẹ nọ uca ngọ, iyi vasa kila nga kọ, ka shi kidẹ yi ba.”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />IYesu vasa tẹri bọ si, unu ma kila nga kọ ba. Ki ba aghọ ki ju uce uma usa uwo ica kidẹ nọ uca mi, na pii ighang ibibi ka yiri kwyi mi ka kyua ba. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Aghọmani ashi kọ ju iri shọ ni yi ba ni, anga yi nga. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Isọ tẹri nọ aipang, nadidu aghọmani ama nọ asọng amusumu ọsa kidẹ nọ uca mi, ka inu anga iKristi bọ, aipang ni sọ tẹri nọ, aki taa ọka nga ba”<verse eid="MRK 9:41" /></para>
  <para style="s">Uma usa kpa afra</para>
  <para style="r">(<ref loc="MAT 18:6-9">IMat 18.6-9</ref>; <ref loc="LUK 17:1-2">ILuk 17.1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“Ipeni aca aghọ sa ukpaa agha yeng kidẹ ananọ ri mani ama aipang ni me ni, ọki gina mani alọr nga utighi ọghọghẹ ko ọmọọ ka fẹni nga kidẹ avọng. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Ipeni avọ ngọ ka sa ngọ uvulu ni, ọsọ kpa wu kọ. Ọki gina ngọ nọ mani ingọ ghila nu ọkyuọ na avọ ayeng, kọnọ mani uya ghila idẹ ugha kini ivọ ngọ ki pai, ugha mani uka kpo wu nga ba. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />Uka ni, igbii na aka la bọ ka kpuru bọ nga ba, ugha ka bra wu kpẹlẹ bọ ba.<note caller="+" style="f"><char style="fr" closed="false">9.44 </char><char style="ft" closed="false">Ice iwọ inga ada akyua shi bọ nu wu ba. </char></note><verse eid="MRK 9:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 9:45" />Ipeni afra ngọ ka sa ngọ uvulu ni, nọsọ kyua kọ. Ọki gina nọ mani ọghila ọna Ọnọng na afra ayeng nọ ọkyuọ nọ mani aki fẹni ngọ kidẹ ugha ni ifra ngọ ki pai. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />Uka ni, igbii na aka la bọ ka kpuru bọ nga ba, ugha ka bra wu kpẹlẹ bọ ba.<note caller="+" style="f"><char style="fr" closed="false">9.46 </char><char style="ft" closed="false">Ice iwọ inga ada akyua shi bọ nu wu ba. </char></note> <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Ipeni ica ngọ ka sa ngọ nu uvulu ni, nọ sọ wo yọ kọ. Ọki gina ngọ nọ mani ọghila idẹ ẹrẹgọm Ọnọng ni ica iyeng, nọ mani ọghila idẹ ugha ni ica ipai.<verse eid="MRK 9:47" /></para>
  <para style="pi">
    <verse number="48" style="v" sid="MRK 9:48" />Uka ni,</para>
  <para style="q1" vid="MRK 9:48">Igbii na aka la bọ ka kpuru bọ nga ba,</para>
  <para style="q2" vid="MRK 9:48">Ugha ka bra wu kpẹlẹ bọ ba.<note caller="+" style="f"><char style="fr" closed="false">9.48 </char><char style="ft" closed="false">Ice iwọ inga ada akyua shi bọ nu wu ba. </char></note><verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />Aki hwuru akwi nga nọ ogha, kọnọ mani aka cira udumu kina atọ ni.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />“Atọ ni ima ididuma yọọ, ipeni atọ ya ọdidọwu nga ya ni, ikẹmbọ nọ inu ki kẹri kọ? iwang si inu shina atọ kukushi nu, kọ ci ọkyuọ na acee nu.”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Umẹẹ iYesu kaya upii ubọgha</para>
  <para style="r">(<ref loc="MAT 19:1-12">IMat 19.1-12</ref>; <ref loc="LUK 16:18">ILuk 16.18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />IYesu ya ukadu, ki kya ẹrẹbọ aYahudiya, kiya bulu ẹrẹyẹma Urdun. Ajiya nagigang ba ukushi nga, nava sa mẹẹ bọ kọnọ umani akọ ghẹli ko ni.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Ace aFarisiyawa ba ukushi iYesu ka mra nga si, “Ọsọ ọdọma na Ajiya bara ubọgha na ayiri nga lẹ?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Avasa yira bọ si, “Ikẹmbọ ni iMusa tẹri nọ?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />“IMusa ta anyu ki tẹri si aghimi wo awọ pighi ubọgha, ka shira ayiri.”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />IYesu vasa yira bọ si, “Ikwyi ugboho nọ yọ sa ni IMusa wọọ nọ ki tẹri nu udu kọ. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Kọ kpaa kọ keri asing ni, Ọnọng ju bu aghimi kini ayiri. <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />Udu ki sa ni aghimi kiya Ate nga kina ayuru nga, ka dẹri ayiri nga, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />ka pai bọ ki tee ẹrẹnọma Iyeng. Aki sọ shibọ agha pai ba, sa agha ayeng. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Kindọ ni nadidu ima mani Ọnọng dara ki iripẹ iyeng ni, aghọ kọnọ ma bara ba.”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Ashi kidẹ ọna ni, aghọyii nga vasa va wulu iYesu ka yọ du upii. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Avasa yira bọ si, “Aghọmani a bara ubọgha na ayiri nga ki vo ace ayiri ni avulu ingọ ọfifọng. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Ipeni ayiri nga ya aghimi nga ki puga ace aghimi ni, avulu ọfifọng na ju.”<verse eid="MRK 10:12" /></para>
  <para style="s">IYesu kina anọ ọfisi</para>
  <para style="r">(<ref loc="MAT 19:13-15">IMat 19.13-15</ref>; <ref loc="LUK 18:15-17">ILuk 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Ajiya ba kina ananọ ọfisi ukushi iYesu ka piya bọ, kindọ aghọyii iYesu vasa gẹr bọ. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />IYesu ya nu kindọ ni, avasa kọng anang, ava tẹri bọ si, “Unu ya ananọ ọfisi ka ba ukushi mi, unu ma kla bọ ba, ka ẹrẹgọm Ọnọng ni inga ighọ bọ kọ. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Imẹ sọ tẹri nọ aipang si agho mani ata yira ẹrẹgọm Ọnọng kina umani ananọ jii shi ba ni, aki ghila idẹ ẹrẹgọm ba.” <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Avasa kpaa anọ ki kẹni bọ, na sọ pra bọ, asọ sira bọ anyu adaduma.<verse eid="MRK 10:16" /></para>
  <para style="s">Ana ghimi shinọ upeni</para>
  <para style="r">(<ref loc="MAT 19:16-30">IMat 19.16-30</ref>; <ref loc="LUK 18:18-30">ILuk 18.18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />IYesu aya so ya ọka ni, ace ajiya vasa ba nọ ọtiti, ki kpaa kpogho kite nga, avasa wulu nga si, “Aghọmẹẹ adaduma, iki bọ niki ju ki peni ọkyuọ mani ushi wu na amra ba?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />IYesu vasa tẹri nga si ikẹmbọ sani uyọrọ mi si agha adaduma? ki ba agha aipang sọ Ọnọng kayu nga <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Ingọ ye imumani Ọnọng tẹri, ‘Ingọ ma pighi aghọ ba. Ingọ ma nyẹri na ayiri aghọ ba. Ingọ mayi ba. Ingọ ma lor ateri abugu ba. Kọnọ mala akpara ace aghọ ba. Kọng upighi ate ngọ kina nga ayuru ngọ.’”<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Ana ghimi vasa tẹri nga si, “Aghọmẹẹ, nadidu umari ni ikọ ju bu ni sọ shi ananọ.”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />IYesu vasa kyọghu nga ọngọ yoo. “Avasa tẹri nga si, imi yeng yọ shẹ ngọ,” Avasa tẹri si ya gbira upeni ngọ kọ, kọ ma aghila amiri, ọki shinọ upẹni nagigang ka ayaya. Ọso ba kọma yii mi.”<verse eid="MRK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22" />A kọng kindọ ni avasa shighi ibẹtẹ nga kọ, asang nọ bra ikwyi, ki inga na aghọlọ ufe nga nagigang.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />IYesu vasa kyọghu aghọyii nga, vasa tẹri bọ si, “Ọki lo nagigang na aghọlọ ufe ghila ẹrẹgọm Ọnọng!”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Aghọyii nga vasa woo ica nọ upii nga. IYesu vasa tẹri bọ si, “Inu anọ mi, ọki lo nagigang, na ghila ẹrẹgọm Ọnọng! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Ọki gina Ọrahimi nọ yuyo na ghila iwiri anyura, kọnọ mani aghọlọ ufe ghila ẹrẹgọm Ọnọng.”<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Aghọyii nga va woo ica na sọ tẹri ace bọ na si, “Ipeni ashi wudu ni inga ki peni ufoo?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />IYesu kyọghu bu avasa tẹri si, “Ukushi Ajiya ni, aki bra ba, ni ukushi Ọnọng ni aki bra. Ka kwiligba ima ukushi ọnọng ni, aki bra.”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Ni IBitrus vasa shang iriywi ki tẹri si, “Iyi bẹ ni, iya akwikẹ ya ki yii ngọ!”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />IYesu tẹri si, aipang nga ni sọ tẹri nọ, Aghọmani aya ọna nga, kọ Anayuru kina afọọ nga, kọ Ayuru nga, kọ Ate nga, kọ Anọ nga, kọ irite nga, kọ ayirikwi me kọ ila ididuma, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />Aki peni ka di asing ri, iki gina kọta ka aji, ni irina, kina Anayuru na afọọ, kina Ate, kina Anọ, kina Iriteh, ni ọki dara kọnọ ọlọ. Asing ki ba ni, aki peni ọkyuọ mani Ushi wu na amra ba. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Ajiya nagigang ngọ shite, aki tee aghọ tumu, na agho tumu kite aghọ shite.<verse eid="MRK 10:31" /></para>
  <para style="s">IYesu kimi upẹni kọ ukpo nga</para>
  <para style="r">(<ref loc="MAT 20:17-19">IMat 20.17-19</ref>; <ref loc="LUK 18:31-34">ILuk 18.31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />A kyeng ghila bọ Urushelima ni, IYesu shi ki ite, atina nga sọ kyeng ni nga, na sa woo ica. Aghọmani ayii nga kọ tumu ni, a huri ẹrẹbata. IYesu vasa yọrọ aghọ ọshọ na pai uho kiva tẹri bọ imumani iki ba ni nga. Atẹri si, <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />“Iyi bẹ ni iki kya yi Urushelima.” Aki ta Anọ Ajiya utumu kidi avo ifirist ighighẹ kina Aghọmẹẹ iMusa. Aki wa nga ashu’a ukpọ, ka ma nga kidi avo aghọmani ashi bọ aYahudawa ba. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />Aki kali nga, ka ta nga akpe, ka ca nga na aiwirimi, ka pighi nga. Kidẹ awii atai ni, aki sang ka kyo”<verse eid="MRK 10:34" /></para>
  <para style="s">Ushọr iYakubu kini iYahaya</para>
  <para style="r">(<ref loc="MAT 20:20-28">IMat 20.20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Ashi kidẹ udu ni, Anọ iZabadi, iYakubu kini IYahaya, aba ukushi iYesu, avasa tẹri si, “Aghọmẹẹ, iyi wang si uma yi, nadidu imumani iyi shọr ngọ”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Avasa wulu si, Ikẹmbọ nọ wang si ju nu?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Avasa yira si, “Ta ni agha yeng yi cicaa kavọ ila ngọ ada ghọ kavọ iprọma ngọ ka awii ujọọ ngọ.”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />“Inu ye nu imumani uwulu ba,” IYesu wulu kindọ. “Inu ki bra ọsa ka asọng mani iki sa wu? Ta inu ki bra mani, aju nu abaptisma kina iminimini mani aki ju mi kọ?”<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Avasa yira nga si, “Ibọ ki bra.”</para>
  <para style="p" vid="MRK 10:39">IYesu vasa tẹri bọ si, “Inu ki sa kọ ko mani iki sa kọ, aki ju nu iminimini kina abaptisma mani aki jumi kọ. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Ni ọci kavọ ila mi, ni iprọma mi, ba ọnga me kọ ba. udu ka ni, inga aghọmani akọ kyer bọ wu.”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Ushe atina ọshọ ya kọng kindọ ni, avasa teghi aghọ huri anang iYakubu kini iYahaya. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />IYesu sa yọrọ bọ ki tẹri bọ si “Inu ye si, aghọmani aye bọ ni ẹrẹgọm kidẹ ajiya ri na ashi bọ aYahudawa ba, Aghakakọng bọ ka nyeni bọ ẹrẹgọrọ. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Ni bọ mani uki shiwudu kidẹ nọ ba. Kindọ ni, aghọmani awang tee agha ghaghẹ kidẹ nọ ni, sa tee agira, <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />Aghọmani awang tee akyote ni, sa tee agira akọ inga. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Ka Anọ Ajiya ra ba ka ma ju nga irigara ba, si ni ka tee aghọ ju ajiya utina, ka va ma bọ ọkyuọ nga ka fo ajiya wu.”<verse eid="MRK 10:45" /></para>
  <para style="s">IBartimawus afoo peni ọkyo uka</para>
  <para style="r">(<ref loc="MAT 20:29-34">IMat 20.29-34</ref>; <ref loc="LUK 18:35-43">ILuk 18.35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Aya ba aYeriko. Aya sang kunu bọ ka aYeriko ni, iYesu kina atina nga, kina ajiya nagigang, ava nu ace afoo aci ka nyu ọtra asọ shọlọ. Ayọrọ nga si IBartimawus, anọ iTimawus. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Aya kọng si IYesu agha aNazaret nga ni, avasa shang iriywi nga, na tẹri si “IYesu Anọ iDauda kọng ahomi!”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Aceghọ bọ vasa gẹr ki tẹri si akọmu nai kikir. Kindọ ni avasa shang ẹrẹwyuẹ nga nagigang na sha tẹri si, “Ngọ Anọ iDauda, kọng ahomi!”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />IYesu vasa titara ki tẹri si, “Ọyọr mi nga wu.” Aba yọrọ afoo ki ju si, “Kpẹnẹ ikwyi nọ, sisang kaa ayọrọ ngọ.” <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />Ava naa imu fiya nga kọ ka uyeng, ki ka ma! ki sisang ki kya ukushi iYesu.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />IYesu va wulu nga si, “Ikẹmbọ nọ wang si iju ngọ?”</para>
  <para style="p" vid="MRK 10:51">Afoo vasa yira si, “Aghọmẹẹ, imẹ wang peni ukyo ọka.”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />IYesu va tẹri nga si, “wolu, uma aipang ngọ lẹni ni ngọ.” Ki iripẹ ukadu ni avasa peni ukyo ọka, avasa yii iYesu, avasa wulu.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">IYesu ghila nga urushelima</para>
  <para style="r">(<ref loc="MAT 21:1-11">IMat 21.1-11</ref>; <ref loc="LUK 19:28-40">ILuk 19.28-40</ref>; <ref loc="JHN 12:12-19">IYah 12.12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Aya ba ayayo kina Urushelima ni, aba ba aBetafaji kina aBetani, ugbana umani ushi uzaitun shi wu, iYesu ba tuma atina nga apai, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />aba tẹri bọ si, “Inu kyaa anọ ifọng na ashi kite nu, inu ba ghila ni, inu ki ya nu anọ izaki na alor, inga umani ba aghọ ni akọ kila wu ba. Inu shii ka inu ba wu kọ kawẹ. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Insi ace aghọ ghulu nu si, “Ikẹmbọ sa ni inu su ju kindi?” Inu tẹri nga si, ‘Aghọ ọna nga wang wu ni aki vuwa ni kọ kidẹ akyua.’”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Aba wor ki ya peni anọ izaki kọ seshi anyu utra alor ka anyu ọna. Asu shii wu ni, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />ace ajiya na atẹng kọ kaa ba tẹri bọ si, “Ikẹmbo ni inu su ju, inu su shii anọ izaki?” <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />Aba yira bọ kọnọ mani iYesu tẹri bọ ni, ajiya nga ba ya na awor ni kọ. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Aya ba iYesu ni anọ izaki ni, aba yaa nga ugbang bọ ku tumu izaki, ni aba kila ki cicaa ka ayaa. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Ajiya na pam yaa ugbang bọ kọ utra, ace aghọ bọ ni, ayaa aniraga ashi afa umani akẹr. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Aghọmani ashi kite nga kina utumu nga taa akpa na ju si,</para>
  <para style="q1" vid="MRK 11:9">“Hosanna<note caller="+" style="f"><char style="fr" closed="false">11.9 </char><char style="ft" closed="false">Ujọọ</char></note>!</para>
  <para style="q1" vid="MRK 11:9">Anyu adaduma ka aghọmani aba kidẹ nọ uca aghọ ọna!”<verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />“Anyu adaduma na ẹrẹgọm uki ba inga ate bayọ iDauda!</para>
  <para style="q1" vid="MRK 11:10">Hosanna ka Ọnọng aghọcẹẹ nọ ughọghẹ”!<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />IYesu ghila Urushelima ki kya idẹ ọna Ọnọng. A kra uka nadidu, aya nu ni ughẹ ya ba ni, aba kunu nga kina aghọ ushọ na pai ra ki kya bọ aBetani.<verse eid="MRK 11:11" /></para>
  <para style="s">IYesu ma ushi uwe anyu ababi</para>
  <para style="r">(<ref loc="MAT 21:18-19">IMat 21.18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Uka ya yẹ na aya sang ushee aBetani ni, iYesu ba kọọ idafo. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Anu uce ọshẹ uwe ka tatọọ ni ọshẹ ni ayaa, aba ka ya nu ta ushi shini ikọlọ ni. Aya fuma ni aba nu ni ayaa yọ shiya, ka akyua ula uwe kọ ba wu ba. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Aba tẹri uwe si, “Ace aghọ taaki ba la nga ikọlọ ngọ ba ka ta kọ sang asing.” Atina nga kọọ imumani atẹri.<verse eid="MRK 11:14" /></para>
  <para style="s">IYesu ghila ọna Ọnọng</para>
  <para style="r">(<ref loc="MAT 21:12-17">IMat 21.12-17</ref>; <ref loc="LUK 19:45-48">ILuk 19.45-48</ref>; <ref loc="JHN 2:13-22">IYah 2.13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Asu fuma Urushelima ni, iYesu ghila nga kidẹ ọna Ọnọng ki kila aghọmani asu gheli na agbira uma kidẹ. A yiri ugọọ uka umani aghọ ser ufẹ shi wu kina uka ni aghọ gbara ukhimi shi wu, <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Ki ba kila na a kpaa ice ima ka awor ni yọ kọ ukaa ọna Ọnọng. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Aba mẹẹ bọ si, “Awọọ si, “‘Aki yọrọ ọna mi si ọna upii nọ Ọnọng ajiya nadidu ba’? Uwẹ inu tee ni wu uka sọlu ayi akakọng.’”<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Afirist akakọng kina aghọmẹẹ umẹẹ iMusa ya kọọ udi upii ni, aba wang utra ni asọ pii nga wu, ka asọ hwiri ẹrẹbata nga, ikir bajiya ni icuru nadidu woo ica nọ umẹẹ nga.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Uka ya ba ughẹ ni, aba kunu bọ kidẹ ifọng.<verse eid="MRK 11:19" /></para>
  <para style="s">Ushii uwe mani uhwiya wu</para>
  <para style="r">(<ref loc="MAT 21:20-22">IMat 21.20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Asọ wor ni ikyuating ni, aba nu ọshẹ uwe ra nọ uhwiya wu ku kpaa ka akang. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />IBitrus ba shuni, aba ju iYesu si, “Aghọmẹẹ, nu! ọshẹ uwe mani inga ma wu anyu ababi ra ni uhwiya wu!”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />IYesu ba ju si, “Inu uma aipang kọ Ọnọng! <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />“Imẹ tẹri nu aipang, insi ace aghọ ju upang ri si, ‘Wor, ya kpaa kidẹ ẹrẹyẹma,’ insi ama aipang kidẹ ikwyi ni, ki ba yira si ima utẹri nga ki ba ni, aki ju kọnọ utẹri nga ni. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Kindọ ni, imẹ sọ tẹri ngọ, nadidu imumani inu shọrọ ki pii nọ Ọnọng ni, uma aipang si ingọ ki yira yọ, ni iki shi inga ngọ. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Insi ingọ tara upii nọ Ọnọng ni ingọ ko ace aghọ ki ikwyi ni, yira ọlọ kpaa nga, ka Ate nu ka ayaya kọ cira uvulu nu kọ. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Insi inu ta yira nọ ula ukpaa ba ni, Ate nu ka yaya ki kpaa nu nga nu uvulu kọ ba.”<verse eid="MRK 11:26" /></para>
  <para style="s">Ayira bọ akyuọ iYesu ba</para>
  <para style="r">(<ref loc="MAT 21:23-27">IMat 21.23-27</ref>; <ref loc="LUK 20:1-8">ILuk 20.1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Aya ba fuma Urushelima, ni iYesu sọ kyeng kidẹ ọna Ọnọng, afirist akakọng, aghọmẹẹ umẹẹ iMusa kina aghọ ite ba ukushi nga. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />“Ẹrẹkyuọ inga nga wu ni ungọ su ju umari kọ? Inga ma ngọ ẹrẹgọrọ ri?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />IYesu ba yira si, Iki ghulu nu upii uyeng. Inu yira mi, imẹ ki kọ tẹri nu ta ẹrẹgọrọ nga wu ni imẹ su ju umari kọ. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Iminimini iYahaya ni, ka ayaya ko ta unga ajiya ko? Inu tẹri mi!”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Apii kina ace bọ ka aya na aba ju si, “Insi ayọ ju si ‘Ka ayaya’ ni, aki ghulu ayọ si, ‘Ikẹmbọ sa ni inu ta uma aipang ba?’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Insi ayọ ju si unga ‘Ajiya wu’ ni (asọ hwiri ẹrẹbata bajiya ka kwinga ye si iYahaya ni aghọ pii kọ ọtọ Ọnọng nga.)<verse eid="MRK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33" />Aba yira iYesu si, “Ayọ ye yi ba.”</para>
  <para style="p" vid="MRK 11:33">IYesu ba ju bu si, Imẹ ki kọ tẹri nu nga ta ẹrẹgọrọ inga wu ni imẹ sọ ju umari kọ ba.<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Ighang upii ka aya aghọ yira ija inabi</para>
  <para style="r">(<ref loc="MAT 21:33-46">IMat 21.33-46</ref>; <ref loc="LUK 20:9-19">ILuk 20.9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />IYesu ba pii kini ibọ na ighang upii, Asi, “Ace ajiya pila ija inabi nga. Asa viya uwiya ki ghimi wu, na aba tumu uhwo umẹẹ inabi nga wu ki ba viya ubọ usha. Aba ma ace aghọ uwuu ija uta na asisang ukyeng. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Akyua ucuru imila ya ju ni aba tuma ace agira nga ka ija ka aya yira ice ikọlọ inabi ka aba ma nga. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Aba kpẹnẹ nga ki ca nga, ki ya nga na vuwa nga na avọ ahwọọ. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Aba tuma ace agira nga kukushi bọ; aba kyo ajiya nga ka ẹrẹkwẹ ki kọng nga ọlọ ki ju nga ububi. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Aba khimi utuma ace aghọ wọ, aba pii nga wu. Aba tuma ace aghọ bọ; aca ace aghọ bọ ni asa pili ace aghọ bọ wu.<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />Ashẹ na aghaye na atuma, anọ nga, aghọmani anga yoo. Aba tuma nga kọ tutumu, si, ‘Aki ma anọ ẹrẹgọrọ.’<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />Aghọtina ija ba ju ace bọ si, ‘Aghọ ki lara ni ija nga we. Ayọ ba pii nga ka ija tee inga yi.’ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Aba kpẹnẹ nga ki pii wu, ki fẹni nga kọ seshi ija.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />Ikẹmbọ ni aghọ ọna ki ju ajiya nga? Aki ba ka aba pili aghọtina ra ka ma ace aghọ bọ ija.<verse eid="MRK 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 12:10" />Inu kọ pila nọ upii Ọnọng ri ba,</para>
  <para style="q1" vid="MRK 12:10">‘Utii ni aghọ uviya tọọ bọ ni,</para>
  <para style="q2" vid="MRK 12:10">Ọbọ tee unga utina kọ uviya;<verse eid="MRK 12:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="MRK 12:11" />Aghọ ọna nga ju udii,</para>
  <para style="q2" vid="MRK 12:11">Ima ididuma yọ ka ica ma ajiya?’”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Agha ite aYahudawa wang utira ni aki kpẹnẹ nga kọ ka aye si akwyi bọ yọ ni ighang upii ri shiwu. Ni asọ tẹ ẹrẹbata ikir bajiya; aba ya nga ya na sa wor.<verse eid="MRK 12:12" /></para>
  <para style="s">Ughulu ka aya uma uKaisar agonu</para>
  <para style="r">(<ref loc="MAT 22:15-22">IMat 22.15-22</ref>; <ref loc="LUK 20:20-26">ILuk 20.20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Ko tumu ni aba tuma ace aFarisiyawa kina ajiya iHiridus kukushi iYesu ka aya peni nga na vulu ko upii nga. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Aba ukushi nga ki ba ju si, “Aghọmẹẹ, ayọ ye si ingọ ni agha aipang nga. Aghọ ka biya nga utee ngọ ba, ka ingọ shi ngọ nu uyoo ẹrẹkwyuẹ ba; ingọ ka mẹẹ utira Ọnọng na aipang. Ọsọ ọdọma na ayọ ja iKaisar nga agonu ta ushi wu uduma ba? <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Ayọ ja ta ayọ ba ja ba?”</para>
  <para style="p" vid="MRK 12:15">IYesu ye ima ushi kidẹ ikwyi bọ. “Ikẹmbọ sa ni inu wang mra mi?” Aba ju bọ si, “Inu ma mi ufẹ<note caller="+" style="f"><char style="fr" closed="false">12.15 </char><char style="ft" closed="false">Dinari uwu shi ufe akyua bọ</char></note> ka imẹ kra.” <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />Aba ma nga, na aba wulu bọ si, “Iwuu kini uca inga bọ shiya?</para>
  <para style="p" vid="MRK 12:16">Aba yira si, “IKaisar.”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />IYesu ba ju bọ si, “Ma iKaisar imumani ishi inga iKaisar ni inu ma Ọnọng imumani ishi inga Ọnọng.”</para>
  <para style="p" vid="MRK 12:17">Aba woo ica nagigang.<verse eid="MRK 12:17" /></para>
  <para style="s">Ughulu ka aya usang aghọkpo</para>
  <para style="r">(<ref loc="MAT 22:23-33">IMat 22.23-33</ref>; <ref loc="LUK 20:27-40">ILuk 20.27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Ni aSadukiyawa mani asi ba usang ko kpo ba ukushi iYesu ki ghulu nga si, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“Aghọmẹẹ, iMusa woo ayọ si, insi anayuru ajiya kpoo ki shee ayiri nga ba anọ ba, iyiya yọ ni ajiya nga ki vo ayiri aghọkpo ka apeni anayuru nga anọ. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Ka kyuakyuari ni aju ace anayuru atinsara. Aghite vo ayiri ki kpoo ba anọ. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Aghi ipai ba vọ ayiri aghọkpo, aba kọ kpoo ba anọ. Kindọ wu na aghi itai. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Nadidu bọ ka atinsara bọ ni ba aghọ ni apeni anọ. Kutumu ni, ayiri kpoo. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Awii usang aghọ kpuru ni, aki shi ayiri inga, ka agha atinsara kọ vo nga?”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />IYesu yira bọ si, “Inu ta vulu nu ba ka inu ta ye nu upii Ọnọng kina ẹrẹkyuọ nga ba? <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Akyua usang aghọkporu ni, aki ju bọ ọbiya ba na ama bọ ọbiya ba. Aki shi kini atuma Ọnọng bọ ni ka ayaya. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Kaya awii usang aghọ kpuru ni, inu ta kọ pila nọ awọ iMusa, ama ila umani ugha la kidẹ aghumu, ni Ọnọng ju nga si, ‘Imẹ si Ọnọng Ibrahim, kina Ishaku kina iYakubu?’ <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Ashi Ọnọng aghọkpo ba, anga agha akyuọ bu. Inu vulu nagigang!”<verse eid="MRK 12:27" /></para>
  <para style="s">Ima utẹri ighighẹ</para>
  <para style="r">(<ref loc="MAT 22:34-40">IMat 22.34-40</ref>; <ref loc="LUK 10:25-28">ILuk 10.25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Agha yeng kidẹ aghọmẹẹ umẹẹ iMusa ba ki ba kọọ ni asọ linang. Aya kpẹlẹ si iYesu sọ yira bọ upii na birbọ ni, aba ghulu nga si, “Nadidu uma umani Ọnọng sa uju ni, uligba wu cẹẹ nọ ughọghẹ?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />IYesu ba yira nga ki ju si, “Ọnga ni ucẹẹ nọ ughọghẹ ni, ‘Inu kọ, Israila, Ate Ọnọng bayọ, Ate ni ayeng nga. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Yoo Aghọ ọna Ọnọng ngọ kini ikwyi nu nadidu kina ọkyuọ nu nadidu, kini ikwyi ngọ nadidu kini ẹrẹkyuọ ngọ nadidu! <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Ọnga ipai cẹẹ nọ ughọghẹ umani Ọnọng sa uju kọ shi, Yoo agha ayayo ngọ kini ẹrẹkwẹ ngọ ni.’ Ba ọnga mani ucẹẹ adii ri ba.”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Ajiya nga ba yira si, “Ingọ tẹri aipang, aghọmẹẹ umẹẹ iMusa. Ingọ tẹri aipang nọ umani ingọ si Ọnọng shi uyeng ba ace aghọ ba sa anga. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Yoo nga kini ikwyi ngọ nadidu kini ukpili ngọ nadidu kini ẹrẹkyuọ ngọ nadidu, kọ ba yoo agha a yayo ngọ kini ẹrẹkwẹ ngọ ni ucẹẹ nọ umani ingọ ya ta ugha ọlọkpa kunu uwa ifuu.”<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />IYesu ya nu na a yira upii na uye ni, aba ju nga si, Ingọ shi ngọ atọọ kini ẹrẹgọm Ọnọng ba.” Kọ kpaa ka akyua ra ni, ba aghọmani asọ ghulu nga ima ba.<verse eid="MRK 12:34" /></para>
  <para style="s">Ughulu kaya iKristi</para>
  <para style="r">(<ref loc="MAT 22:41-46">IMat 22.41-46</ref>; <ref loc="LUK 20:41-44">ILuk 20.41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />IYesu sọ mẹẹ kidẹ ọna Ọnọng ni, aba ghulu si, “Ikẹmbọ sa ni, aghọmẹẹ umẹẹ iMusa si, iKristi ni Anọ iDauda nga? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />IDauda ki kirkwyi nga pii kidẹ aghing Ọnọng si,</para>
  <para style="q1" vid="MRK 12:36">“Ate tẹri Aghọ ọna mi si,</para>
  <para style="q2" vid="MRK 12:36">“Cica ka avọ ila mi</para>
  <para style="q1" vid="MRK 12:36">Sa imẹ sa asho ngọ</para>
  <para style="q2" vid="MRK 12:36">Ka ifra ngọ.<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />IDauda ki kirkwyi nga yọrọ nga si ‘Ate ọna,’ Na nyi wu ni aki ba yọrọ nga si anọ nga?”</para>
  <para style="p" vid="MRK 12:37">Ikir bajiya na ashi kọ ukaa kọọ ikwyifu.<verse eid="MRK 12:37" /></para>
  <para style="s">IYesu Ta Aghọmẹẹ IMusa ka Ayayẹ</para>
  <para style="r">(<ref loc="MAT 23:1-36">IMat 23.1-36</ref>; <ref loc="LUK 11:37-54">ILuk 11.37-54</ref>; <ref loc="LUK 20:45-47">20.45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Ashi kidẹ umẹẹ ni, iYesu ba ju si, “Inu ju na birbọ na aghọmẹẹ umẹẹ iMusa aghọ wang soru uma ọkọkọng na asọ goru. Awang si a bili bọ kọ ka ju izẹ <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />ka aba ma bọ uka ucẹ ọkọkọng kọ ọkọ takwyuẹ aYahudawa kọnọ uka usra agya. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Aka yira ayiri mani aghimi bọ kọ kpurubu ọna bu na aka ba upii nọ Ọnọng ọgbọọgbang ka anu bọ. Aki ju bọ ashuwa nagigang.”<verse eid="MRK 12:40" /></para>
  <para style="s">Uma aghọmani aghimi kọ kpoo</para>
  <para style="r">(<ref loc="LUK 21:1-4">ILuk 21.1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />IYesu cẹẹ kidẹ ọna Ọnọng kọ uka uta uma na asọ kyoo umani ikir bajiya su ma uma bọ. Aghọnọ upeni na pam ma na pam. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Ni aghina amir mani aghimi nga kọ kpoo ba ki ba ta anini apai ya anga umani ata fuma yọ ukọbọ ba.<verse eid="MRK 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43" />IYesu ba yọrọ atina nga ki ju bọ si, “Imẹ sọ tẹri nọ aipang, aghina amir mani aghimi nga kọ kpoo ri ma ki cẹẹ aghọ bọ nadidu kidẹ uka uta uma. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Nadidu bọ ma kidẹ nọ upeni bọ; inga ni, kidẹ na amir nga ni ama nadidu imumani ashi ni yọ kọ cẹ nga.<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">IYesu pii kaya pulu ọna Ọnọng</para>
  <para style="r">(<ref loc="MAT 24:1-2">IMat 24.1-2</ref>; <ref loc="LUK 21:5-6">ILuk 21.5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Ashi kọ kunu ka ọna Ọnọng ni, agha yeng kidẹ atina nga taa nga si, “Aghọmẹẹ! Kala, ighọ apang li kini ighọ ivra li ọdọdọma!”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />IYesu yira nga si “Ingọ nu ivra ighighẹ li? Ba utii ko uyeng umani aki ya kaya uce. Aki pulu kwiligba wu!<verse eid="MRK 13:2" /></para>
  <para style="s">Amaa asing</para>
  <para style="r">(<ref loc="MAT 24:3-14">IMat 24.3-14</ref>; <ref loc="LUK 21:7-19">ILuk 21.7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />IYesu shi ci kaya ugbana ishi uzaitun mani do kyo ọna Ọnọng, iBitrus, na iYakubu, na iYohana, na Andarawus ada ghulu nga kọ yuyi di taa si. <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Taa ayọ, awii mani ima li ki ba kọ? “Ikẹmbọ wu ki shi amaa iyi do nu na yọ kpẹlẹ ni ima li ki ba?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />IYesu taa bọ, “Inu kala na ki kya nu ma yaya na ace aghọ dolu nu ma. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Ajiya na pam ki ba nọ uca mi, na taa. ‘Imẹ si Inga,’ adọ dolu ajiya na pam. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Inkini nu kọ irishu ikọrọ kini ila ikọrọ ni, inu ma duma ma. Iyiya ni uma li ki ba, ni usang ashi kọ ta kọ ba ma. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Ajiya ki ju irisho kina ajiya, ẹrẹgọm kina ẹrẹgọm. Aki peni uzẹẹ ẹlẹbọ ka ika na pam, idafo dọ shi. Adọ sang kọọ ọlọ wuji.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />Inu ci nu ye. Aki kyaa na nu ka sice aghọ ẹlẹshuwa ka aca nọ kọ ọkọ takwyuẹ aYahudawa. Aki kyaa ni nu kushi aghọ kakọng na agọm kaya nọ uca mi, inu kite aghọ ko ẹlẹbọ na agọm ka inu ma ila ididuma. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Ni sa inu zọnọ tẹri si ama ila ididuma ka ajiya nadidu. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Akyua umani A kpẹnẹ nu ki ba ni nu ka ẹlẹshuwa ni, inu ma duma ni imumani inu dọ taa ma. Taa imumani ama nọ ka akyua la, ka inu bọ dọ pii ma, aghing Ọnọng nga.<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />Anayuru dọ gbala anayuru ka aya ta kọ ukpo, ate kina anọ nga. Ananọ ki ju irisho na ate bọ ka aya ta kọ ukpo. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Nadidu ajiya ki tọrọ nu kaya uca mi, ni aghọ umani bra tra di fuma amara ni aki ufoo bọ.<verse eid="MRK 13:13" /></para>
  <para style="s">Ọlọ ububi</para>
  <para style="r">(<ref loc="MAT 24:15-28">IMat 24.15-28</ref>; <ref loc="LUK 21:20-24">ILuk 21.20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />“Insi inu nu irighe ni ika sa ukpo kọ ọka umani ọshiwu dọ ba, (ta ni aghọ pila kpẹlẹ), ni aghọ shi ka aYahudiya atii bọ ka akya bọ aya apang. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Aghọ umani asọ ka ayaya ọna ama shuu ma ko na ghina kidẹ na awang ice ima ma. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Aghọ umani asọ kaya ibiya ama vura ni nga wang ya kpa igbang. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Ọlọ ka ayiri mani ashi na afo kina aghọ ko anọ ji kidẹ na awii la! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Inu pii nọ Ọnọng ka ima li ma ba na ẹlẹkpẹlẹ ma. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Ka adidu akyua ni adọ ghina ọlọ ububi mani akọ ju wu ma kọ kpaa ka akyua umani Ọnọng kyeli ashi dima ta ka diji akyua. Aki ba ju bu ighọ ma ta ka amaa asing.<verse eid="MRK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 13:20" />Kpaa si Ate ọna kyua nga igbang na awii la ma ni, ba aghọmani ada kọ lang ma. Ni kaya aghọmani ahwiya, owo sa na akyua igbang la wi kọ ki ufoo bọ. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />Ka akyua la ni in kini ace aghọ taa si, “Nu, iKristi wẹ, ko ni awa!” Inu ba ma aipang ba. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Ka iYesu atẹri kina aghọ pii kọ ọtọ Ọnọng atẹri dọ ba da ama ju amaa na uma ọsa wo ica ka dolu nu kina aghọ umani ahwiya insi ọki yini. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Ni inu nu do ci na zizal; Imẹ yọ titaa nu kwikẹ kidẹ akyua.”<verse eid="MRK 13:23" /></para>
  <para style="s">Ọki vuwa Anọ Ajiya</para>
  <para style="r">(<ref loc="MAT 24:29-31">IMat 24.29-31</ref>; <ref loc="LUK 21:25-28">ILuk 21.25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />Ni kidẹ la awii la ni, bam ni ọlọ mani aki kọng ni,</para>
  <para style="q1" vid="MRK 13:24">“‘Ọnọng uta dọ ba ni iting.</para>
  <para style="q2" vid="MRK 13:24">Ọpri dọ ma wu uyeri ma,<verse eid="MRK 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25" />Ẹyẹrẹ dọ ka kpala yọ ka ayaya,</para>
  <para style="q2" vid="MRK 13:25">Adọ zuru uma ọkọkọng umani ọsọ ka yaya.’<verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />Ka didu akyua ni ajiya dọ nu Anọ Ajiya adọ ki ba kidẹ amọ, kina ẹrẹkyuọ na ujọọ. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Ni aki tuma atuma Ọnọng da ama culu aghọ umani Ahwiya ka ushii ọnari mani uwuu ka sang kọ, kọ kpaa ka amara ashi kiya ta amara ayaya.”<verse eid="MRK 13:27" /></para>
  <para style="s">Umẹẹ kaya ushi uweng</para>
  <para style="r">(<ref loc="MAT 24:32-35">IMat 24.32-35</ref>; <ref loc="LUK 21:29-33">ILuk 21.29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />Inu mẹẹ ighang upii nu ọshẹ uwe Insi aga nga dẹ kọ shuu ni, adogo wo ayaa asasa, inu ye si ẹlẹkpẹlẹ kọ ya sang ba wudu. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Ushi wu du ọnga mani inu nu ima lẹ do ba, inu ye akọ ba yayo, ado shi ka anyu bọọ. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Imẹ dọ taa nu aipang, ajiya akyua li ki wolu bọ ma sa ima li ba. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Ayaya na ẹrẹbọ ki wolu wu ni upii mi ki wolu wu ma.”<verse eid="MRK 13:31" /></para>
  <para style="s">Ba aghọ ye awii uvuwa iYesu ma</para>
  <para style="r">(<ref loc="MAT 24:36-44">IMat 24.36-44</ref>; <ref loc="LUK 17:26-30">ILuk 17.26-30</ref>; <ref loc="LUK 17:34-36">ILuk 17.34-36</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />Ni awii la ni, ko akyua la ni, ba aghọ ye, ko atuma Ọnọng mani asọ ka ayaya, ko Anọ Ọnọng ma sai Ate kayu Nga. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Inu kala! Inu ci nu ye! Inu ye nu akyua mani aki ba ma. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Usọ lilẹ ajiya umani asang ukyeng di tẹri agira nga na kala nga ọna, kwinga sọ nọ utina nga, adi taa aghọ sha anyu bọọ sa aci na ye.<verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />Inu ci nu ye, ka inu ye nu akyua mani ate ọna ki vuwa ma, ta no ughẹ, tanaa biyateng ating kọ, ta nọ uki ta ẹrẹwyuẹ akọrọ wu, ta ni ikyuating yọ ni. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Peni aba ba aghọ ye ni, ama peni nu ni inu dọ moo ma. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Ima ni imẹ dọ taa nu ni, mi do ta kwinga wu, uwu ni inu ci nu uye!”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Aghakakọng aYahudawa pii kina ace bọ umani aki pii iYesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">IMat 26.1-5</ref>; <ref loc="LUK 22:1-2">ILuk 22.1-2</ref>; <ref loc="JHN 11:45-53">IYah 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Ushẹ awii apai na aju Agya Ubulu na agya imila mani shi yọ nọ uyisti ma, ni ifirist ighighẹ na aghọmẹẹ umẹẹ iMusa wang utra kpẹnẹ iYesu kọ yuyi, ka apii nga wu. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />“Bam na akyua agya ma,” Abọ dọ taa, “Ka ajiya ma kpẹnẹ ọkọrọ ma.”<verse eid="MRK 14:2" /></para>
  <para style="s">Ashii iYesu na anyi uvọng ka aBetani</para>
  <para style="r">(<ref loc="MAT 26:6-13">IMat 26.6-13</ref>; <ref loc="JHN 12:1-8">IYah 12.1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />IYesu sọ ka aBetani ko ọna iSaminu aghọnọ ubili. Adọ la imila ni, ace ayiri ya ba na ni iwoo anga la anyi uvọng ọdọdọma ungọ ayaa unardi<note caller="+" style="f"><char style="fr" closed="false">14.3 </char><char style="fq" closed="false">Unardi </char><char style="ft" closed="false">Udi ni ayaa yọ mani aka keri anyẹ ọvọng ko. </char></note>, ada tsiga anọ iwoo, di shi anyi kaya ẹrẹkwẹ iYesu.<verse eid="MRK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4" />Ace aghọmani ashi kọ ọkaa ada kọọ anang kọ. Ada dọ taa ace bọ, “Ikẹmbọ sa ni adọ biya anyi uvọng wu kini? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Ada kọ dọ gbala anyi uvọng ọdọdọma kọ kaya udinari aji atai, adi ma aghọ lamiri!” Ada kọng anang nga di gẹr ayiri nagigang.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />IYesu taa, “Inu ya nga ya. Ikẹmbọ sa inu do dama nga? Ima ididuma yọ na aju mi. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Ko aligba awii ni inu sọ na aghọ lamiri, nu dọ bra nọ ju bọ ima ididuma ma, imẹ shimi kini nu ko aligba wii ma. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Aju imumani aki bra ju. A shii mi na anyi uvọng ka ẹrẹnọma sọ mani akyua ukpo mi ya ba. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Imẹ dọ taa nu aipang, nadidu oka mani aki tẹri ila ididuma ka asing, adọ ka taa ima ni ayiri li ju, nọ mani aka shuni ni nga.”<verse eid="MRK 14:9" /></para>
  <para style="s">IYahuda Iskariyoti yira si inga dọ gbala iYesu ko</para>
  <para style="r">(<ref loc="MAT 26:14-16">IMat 26.14-16</ref>; <ref loc="LUK 22:3-6">ILuk 22.3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />IYahuda Iskariyoti, agha aye kidẹ aghọ ushọ na pai la, akyaa kukushi ifirist ighighẹ inga dọ gbala iYesu ku shi bọ. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Aya kọng nidọ ni ada kọ ọdọdọma, ada ta nga anyu si abọ dọ ma nga ufẹ. Inga la kọ wang utra ubgala bọ nga.<verse eid="MRK 14:11" /></para>
  <para style="s">IYesu la imila Agya Ubulu kina atina nga</para>
  <para style="r">(<ref loc="MAT 26:17-25">IMat 26.17-25</ref>; <ref loc="LUK 22:7-14">ILuk 22.7-14</ref>; <ref loc="LUK 22:21-23">22.21-23</ref>; <ref loc="JHN 13:21-30">IYah 13.21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Awii iyeng agya ubulu mani ishi yọ nu uyisti ma, awii mani aka wa itimi inga Agya Ubulu, atina iYesu ba ghulu nga si, “Abi kọ nọ wang si iya ker ngọ imila Agya Ubulu kọ?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Ada tuma atina nga agha pai, ataa bọ, “Inu ghina kidẹ ifọng. Kadu nọ ọki takwyuẹ na ace aghọ ako iwoo la amusum, nu kiyii nga. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />Nadidu ọna mani aghina, nu taa aghọ ọna, “Aghọmẹẹ ghulu, ki ọbọọ mani imẹ dọ la Agya Ubulu na atina nga?” <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Anga ki yeni nu ọbọọ ughọghẹ kọ ọbọọ ayaya, akọ keli yọ. Kadu wu nu dọ keli ayọ imila wu.”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Atina sang dẹ ghina bọ kidẹ ifọng aya peni kwikẹ kini mani ataa bọ ni, ada kyeli Agya Ubulu.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Uka ya ba ughẹ ni, ada ba kina agha ushọ na pai la. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Ashi kọ la imila ni, iYesu da taa, Imẹ dọ taa nu aipang, ayayi kidẹ nu ado gbala mi, aghọmani ayọ do la ni nga.”<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Ada kọng ikwyi ibibi, ka yayi adọ taa nga, “Ta imẹẹ?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Ada taa bọ, “Agha aye kidẹ ushọ na pai li, aghọmani ayọ sọ la kidẹ isọ iye. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Anọ Ajiya kpoo kọnọ umani awọọ kaya nga ni. Ọlọ kukushi aghọmani adọ gbala Anọ Ajiya! Ada kọ do jee bọ nga ma.”<verse eid="MRK 14:21" /></para>
  <para style="s">Ọla imila amaa</para>
  <para style="r">(<ref loc="MAT 26:26-30">IMat 26.26-30</ref>; <ref loc="LUK 22:14-23">ILuk 22.14-23</ref>; <ref loc="1CO 11:23-25">1AKor 11.23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Ada shi kọ la imila, iYesu kpaa ubiredi, di sa Ọnọng izaa, ada wura wu, di ma bọ ada taa, nu yila, diji ẹrẹnọma mi wu.”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Ada kpaa isọ, aya kpee sa Ọnọng izaa ni, ama bọ. Nadidu bọ da sa kidẹ.<verse eid="MRK 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24" />Ada taa bọ, “Diji ayi mi bọ. Angọ dọmọ mani anawu kaya ajiya na pam. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Imẹ do taa nu aipang, imẹ ki va sa mi amusumu ikọlọ na ashi ma, sa awii umani mi ki sa asasa ka ẹrẹgọm Ọnọng.”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Aya kpẹ ọta atẹ ni, avasa sang ki kyabọ ka yọ ugbana ishi uzaitun shi wu.<verse eid="MRK 14:26" /></para>
  <para style="s">IBitrus ki nẹrẹ uye iYesu</para>
  <para style="r">(<ref loc="MAT 26:31-35">IMat 26.31-35</ref>; <ref loc="LUK 22:31-34">ILuk 22.31-34</ref>; <ref loc="JHN 13:36-38">IYah 13.36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />IYesu tẹri bọ si, “Naidu nu ki ti nọ kọ yami yaa, “Ka woo kidẹ awọọ ọnọng si,</para>
  <para style="q1" vid="MRK 14:27">‘Iki pili aghọ cẹẹ kọ,</para>
  <para style="q2" vid="MRK 14:27">Na atẹm ki furu bu.’<verse eid="MRK 14:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28" />Ipeni iya sang ka lor ni, Iki lite nu ki kyami aGalili.”<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />IBitrus vasa tẹri nga si, “Ko na ti bọ naidu bọ, imẹ ki ya ngọ ba.”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />IYesu vasa tẹri nga, “Aipang, imẹ so tẹri ngọ, kaidi ating ri, akọr ta kọ ta iriywi iri pai ni ngọ, ki linang uyemi iri tai.” <verse eid="MRK 14:30" /><verse number="31" style="v" sid="MRK 14:31" />Kindọ ni IBitrus vasa lite nọ vọlọ upii na kyo si, “Ko ni ikpo mi, iki lami inang uyeng ba.” Naidu bu vasa tẹri kindọ.<verse eid="MRK 14:31" /></para>
  <para style="s">IYesu pii nu Ọnọng ka aGatsemani</para>
  <para style="r">(<ref loc="MAT 26:36-46">IMat 26.36-46</ref>; <ref loc="LUK 22:39-46">ILuk 22.39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Ada ya fuma upye uka, ni uca si aGetsemani. IYesu do ta, atina nga “Nu cica kokẹ ni imẹ ya pii nọ Ọnọng.” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Ada kpa iBitrus ni iYakubu, ni iYahaya, akyọ kọng ọlọ kọnọ bira ikwyi nga wu nagigang. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Ada ta bọ si, “Ikwyi mi dogo ko ọlo nagigang, lẹlẹ mi ukpomi ni. Nu tra ka ji, nu ka sha ka ji.”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Aya kya ite naji ni, avasa kpa ki ẹrẹbọng, ki pii nọ Ọnọng ki tẹri si, in pẹni uyira ushọr mi ni, kpa mi udi ọlọ wu. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />“Ate, <note caller="+" style="f"><char style="fr" closed="false">14.36 </char><char style="ft" closed="false">Abba uwo shi Ate</char></note> kọligba ima ki bra ba, ukọ shi ngọ. Kindọ ni, kpa mi asọng ọlọ ri wu. Ni ba uyo mi ba sa imumani ingọ wang.”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Avura dima pini bu ado moo, ada ta IBitrus, “IBitrus, ngọ dogo moo? Ngọ do bra ngọ sha elesha ngọ akyua ayayi ma? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Inu ci sha elesha nu sa va pii nọ Ọnọng mani nu ma ghina kidẹ umra ma. Ni aghing wang, ni ẹrẹnọma tọrọ wu.”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Ada va vura, di pii nọ Ọnọng, asa va vọlọ upii aiwu. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Ada va vura, dima pini bu adoko moo, ọmọọ ku fuwa bu ica. Ada yebu ima mani aki ta nga ma.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Ava vura ngọ itai, ata bu, unu do shi kọ moo nu wuru? Ọmaa nedo! akyua ya ba, nu aki ma Anọ Ajiya ka vọ ma aghọ vulu. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Inu sisang na yo ma ke, aghọ gbala mi we ata ba!”<verse eid="MRK 14:42" /></para>
  <para style="s">A kpẹnẹ IYesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">IMat 26.47-56</ref>; <ref loc="LUK 22:47-53">ILuk 22.47-53</ref>; <ref loc="JHN 18:3-12">IYah 18.3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />IYesu so ko pii ni, iYahuda, agha aye ki de aya ọshọ na pai la, kunu. Kini inga ni ikir ma juwa kọnọ ukuma gbugbang na ashi. Agha afirist akakọng na aghọmẹẹ iwoo iMusa na aghọ ite bọ tuma bu.<verse eid="MRK 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44" />Aghọ gbala nga kọ nyeni amaa si, “Aghọmani mi ki kẹni nga, adu aghọ nga; nudo kpeni nga nu kya ne nga na ace aghọ ko nga ni ẹrẹkyuọ.” <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />Nu ba anga iYahuda uko shi iYesu, di ta nga, “Aghọmẹẹ!” ava kẹni nga. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Ada kpeni iYesu, ki wulu ni nga. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Ayi kidẹ aghọmani ating, da woo ikọma igbigbang nga, ada kpa ayi kidẹ agira ifirist ighighẹ, acuwa nga ọtong.<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />IYesu da wulu bu, “Ukunu nọ ọkọma ọkọkọng na ashi kunu ma kpeni mi lilai aghọ yi? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Kwaligba wii ni isọ ni nu, isha mẹẹ kidẹ ọna Ọnọng nu, nu da bra nu kpeni mi ma. Aju diji kọ upii Ọnọng kaya ẹrẹkwẹ nga hwura. <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Ni kwinga ya nga ki tii.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Ace anọ anaghẹmẹ, akọ nga ice ma ba si ima fuwa alili, ada kiyi iYesu. Aju ta aki kpẹnẹ nga, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />inga da ya bu ima fuwa, ada tii ba ighima.<verse eid="MRK 14:52" /></para>
  <para style="s">IYesu ki ite aghakakọng</para>
  <para style="r">(<ref loc="MAT 26:57-68">IMat 26.57-68</ref>; <ref loc="LUK 22:54-55">ILuk 22.54-55</ref>; <ref loc="LUK 22:63-71">22.63-71</ref>; <ref loc="JHN 18:13-14">IYah 18.13-14</ref>; <ref loc="JHN 18:19-24">18.19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Ada pka iYesu di kya ni nga ukushi afirist akakọng, na aghọ ite na aghọmẹẹ umẹẹ iMusa a culu ka ukushi nga. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />IBitrus da ki yii nga ka tatọọ, ada ya ghila idẹ ọna ifirist ighighẹ la, aya ki ka na aghọ sha irisha ado kọng ọco ci ugha.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />Afirist akakọng na aghọgunu nadidu da wang avulu mani aki yeni kaya iYesu, mani apeni na pighi nga ada peni bu ma. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Ajiya na pam yeni di ta atẹri kaya nga, ni anyu bu da ba bọ uka yeng ma.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Ace aghọ kutumu da va sang di ma taa ateri ka ya nga, dita si, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />Iyi kọng atẹri si anga ki pulu diji ọna Ọnọng mani ajiya avura na avo, kidẹ awẹẹ atai mi ki vura uce mani aki vura bu na avo ma. <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Nedu nadidu anyu bọ yeni da ba wo ko yi ma.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Kadu kọ ni ifirist ighighẹ da sang di tara ka buga ting bu di wulu iYesu dita ni, “Ingọ shi ngọ na ice ma mani Ingọ ki tẹri ma? Uma mani ado ta ka ya ngọ ni?” <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Ni iYesu la na kikari a ghari nga ma,</para>
  <para style="p" vid="MRK 14:61">ifirist ighighẹ da va wulu nga, “Ushi wu du Ingọ so iKristi Anọ Ọnọng aghọ shina anyu adaduma?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />IYesu ta, “Imẹ.” Nudo nu Anọ Ajiya cica avo ila aghọmani ace na ẹrẹkyuọ ado va suu kidẹ ẹlẹmọ ayaya.”<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Ifirist ighighẹ da giya igbang nga, ata agba upii iyi do va wang? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />“Nu kọng ado pii agbagbara mani ata! Inu nu na nyi?”</para>
  <para style="p" vid="MRK 14:64">Nedo bu da wa nga ashuwa mani ama ukpo. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />Ace aghọ bu ba tanga akpe, ada yuru nga ica ya, ada ca nga asa va ta nga si, “Nu tẹri yi imumani iki ba kite!” Aghọ sha irisha da kpa nga di ca nga.<verse eid="MRK 14:65" /></para>
  <para style="s">IBitrus anẹrẹ uye iYesu</para>
  <para style="r">(<ref loc="MAT 26:69-75">IMat 26.69-75</ref>; <ref loc="LUK 22:56-62">ILuk 22.56-62</ref>; <ref loc="JHN 18:15-18">IYah 18.15-18</ref>; <ref loc="JHN 18:25-27">IYah 18.25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />IBitrus shi ka ta ayayẹ ọna ọdona, ace agira ayiri angọ ifirist ighighẹ ada ba, <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Aya no iBitrus do whẹẹ ugha, asa nga ica, dita,</para>
  <para style="p" vid="MRK 14:67">“ingọ doshi na aghọ agha aNazaret li iYesu!”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Ava nẹrẹ dita, imẹ da do yemi imumani ingọ do pii ma, ada kunu ba nga anyu utra, akọr data ẹrẹwyuẹ.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Ana agira ayiri la ya va nu nga ada va ta aghọmani ating kadu ajiya so ayi kidẹ bu.” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Ada va nẹrẹ.</para>
  <para style="p" vid="MRK 14:70">Ada tẹri bu ma aghọmani ki ting ni nga data iBitrus, “Ingọ aipang ingọ so ayayi kidẹ bu ni ingọ so aghọ aGalili”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Ada vasa ma ẹrẹkwẹ nga anyu, na vasa suu ado ta bu “Imẹ dado yemi ajiya li mani nu pii ma,”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Kidẹ anakyua ni akọr da ta ẹrẹwyuẹ ọnga ipai. IBitrus ya shuni no upii mani IYesu tẹri si, “Anakro da ko ta ẹrẹkwẹ ọnga ipai ingọ do nere ngọ yimi nga ma iri tai.” Ada kpaa kya nga nu uci.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Iyesu ki ite iBilatus</para>
  <para style="r">(<ref loc="MAT 27:1-2">IMat 27.1-2</ref>; <ref loc="MAT 27:11-14">IMat 27.11-14</ref>; <ref loc="LUK 23:1-5">ILuk 23.1-5</ref>; <ref loc="JHN 18:28-38">IYah 18.28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Kini ikwyi kwyetin, afirist akakọng, kina akwite, kina aghọmẹẹ umẹẹ iMusa kina agha ẹrẹgọm nadidu ataa anyu si. Alor iYesu, ava kpa nga kiya ma iBilatus.<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />“Ingọ shi agọm aYahudawa?” iBilatus wulu nga.</para>
  <para style="p" vid="MRK 15:2">“Mani utẹri ni,” IYesu yira nga.<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Afirist akakọng tẹri nga uma ikir. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />IBilatus va kimi uwulu nga si, “Ushi ngọ nu ice iri yara ba? Nu idir nu ma mani ajiya ri su cira ngọ nu bọ.?<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Ni kọ ta aikyuari ni iYesu ra tẹri ice ma ba, ni iBilatus va wo ica.<verse eid="MRK 15:5" /></para>
  <para style="s">Awa iYesu ashuwa ukpọ</para>
  <para style="r">(<ref loc="MAT 27:15-26">IMat 27.15-26</ref>; <ref loc="LUK 2:13-25">ILuk 2.13-25</ref>; <ref loc="JHN 18:39">IYah 18.39</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Akuari ni aku gheli nu ka sheri bu agha asara ayeng ka agolu usra agya aghu mani ajiya wang. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Ace ajiya ayuru nga si iBarabas ashi ka asara, kina ace aghula igigra na pighi ukyo ka gọlọ igigra bọ. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Ikir majiya nga va ba ukushi iBilatus sa aju bu kini mani akọ gheli ko.<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />Ibilatus ghulu si, “Uwang si imẹ sheri nu agọm aYahudawa?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />A kpẹlẹ si uyo ikwyi kini irisho wu ni agha afirist akakọng ma nga iYesu. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Ni afirist akakọng ava ser ajiya si iBilatus shẹribọ iBarabas.<verse eid="MRK 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12" />IBilatus va wulu bu si, “Ikẹmbọ ni imẹ ki ju, kina aghu mani inu yuru nga si agọm aYahudawa?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Avasa gyo anyu si “Gra nga ko ukumu ushi!”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />IBilatus wulu bu si, “Kikẹ? Ikẹmbọ na aju?”</para>
  <para style="p" vid="MRK 15:14">Ni ava yemi ẹrẹwyuẹ nagigang, “A gara nga ku ukumu ushi!”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Uwang ju imumani ajiya wang, iBilatus sheri bu iBarabas. Asa na aca iYesu na awiwuru, ava ma bu na a gara nga.<verse eid="MRK 15:15" /></para>
  <para style="s">Aghula ukpọ a sira iYesu</para>
  <para style="r">(<ref loc="MAT 27:27-31">IMat 27.27-31</ref>; <ref loc="JHN 19:2-3">IYah 19.2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Aghina akpọ kpaa nga ki kya bọ ọna bọ idẹ ugunu ava yọrọ nadidu ikir aghina akpọ. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Avasa fuga nga nu ugẹẹ ugyauto ọnga amusum ulilẹrẹ ubula, avasa ju nga ifa ẹrẹkwẹ inga akara ki sọmọ nga. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Avasa tee aghu yuru nga si, “Pẹmi nga, agọm aYahudawa!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Asa tanga ashi kaya ẹrẹkwẹ na tanga na akpe. Na ata aghong, ki kpoo sa asu bili nga ọnga ujeri amiya. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Aya kpẹri usra nga ni, ava wo nga igbang amusum ulilẹrẹ ubula wu, ava sumu nga unga nga, ava wo nga ki kyabọ asing ko kaya gara nga kaya ukumu ushi.<verse eid="MRK 15:20" /></para>
  <para style="s">A Gara iYesu</para>
  <para style="r">(<ref loc="MAT 27:32-44">IMat 27.32-44</ref>; <ref loc="LUK 23:26-43">ILuk 23.26-43</ref>; <ref loc="JHN 19:17-27">IYah 19.17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Ace aghọ wolu ayuru nga si, iSiman ajiya iSayirin, ate Alekzanda kina iRufas, asọ ki vuwa ka anifọng. Avasa sa nga na kpa ukumu ushii. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Avasa kya ni iYesu uce uka mani ayọrọ si aGolgota, (uko shi “uka igbahu ẹrẹkwẹ”). <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Avasa ma nga amusum ikọlọ ashi mani azọgọ kina ọkang, ava tọrọ sa. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Na vasa gara nga kaya ukumu ushii. Ava ko ugbang uko nga, ava fẹni itii ka nu ta ume bu ni ko inga ki peni.<verse eid="MRK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25" />Kina agọlọ a larọshọ anga ikweting nga na a gara nga kaya ukumu ushi. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Avasa woo avulu nga si, <char style="sc">AGỌM AYAHUDAWA. </char> <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Avasa gara nga kina ace agha pai aghu pili ajiya kina inga, agha ayeng ka vo ila na agha ayeng kavọ ipuruma. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Udiwu shi utighi upii mani atẹri si “Apila nga kidẹ aghila avulu” <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Aghu sa wolu sha tẹri nga upii bra ikwyi agbagbara, asa zuru akwyi bu na tẹri si, “Ni! Ingọ ki pulu ọna Ọnọng ko va vura wu kidẹ awii atai, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />Shulu kaya ukumu ushi ko ufoo ẹrẹkwẹ ngọ wu!” <verse eid="MRK 15:30" /><verse number="31" style="v" sid="MRK 15:31" />Kindiwu ni agha afirist akakọng kina aghọmẹẹ umẹẹ iMusa a cira nga kidẹ bu. “Afoo ace aghọ bu,” Ava tẹri si, “Ni uwẹ ni ata ki bra nga ufoo ẹrẹkwẹ nga ba! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Tara ni aghọfoo, agọm Israila, ashulu kaya ukumu ushi, kiyi nu ki ma aipang.” Aghu mani agira bu kini inga ni abu ma acira nga.<verse eid="MRK 15:32" /></para>
  <para style="s">Ukpo iYesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">IMat 27.45-56</ref>; <ref loc="LUK 23:44-49">ILuk 23.44-49</ref>; <ref loc="JHN 19:28-30">IYah 19.28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Kina atinọng, iting ba ki ma fuga ẹrẹbọng ya nadidu ki fuma agọlọ atai atinọng. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Kina agọlọ atai atinọng iYesu va ta a kpaa, “Eloi, Eloi, lama sabaktana?” Uwu shi si “Ọnọng mi, Ọnọng mi, ikẹmbọ sa ni ingọ nami wu?”.<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Aghọmani ating kaya yo nga a kọng ni, ava tẹri si, “Ukọng, asọ yuru Iliya.”<verse eid="MRK 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36" />Ace aghọ va titi kiya sọ asọsọ kina amusumu ikọlọ na shi ukpọkpam, ki sumu ka ashi, ki ma iYesu si asa. “Aikuari ni uya nga kaya yu nga. Ima nu ta Iliya ki ba ka ma shulu ni nga ni.”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Kina uci nagigang, iYesu waga ufeni unga amaa.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Ugyauto anyu bọ ọna Ọnọng va gaa iri ipai ko kpa ka yaya ki ta ka taa. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Aghọ la kpọ mani ating na kyu iYesu ya nu mani akpoo ni, ava tẹri si, “Aipang na ajiya ri ni Anọ Ọnọng nga!”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Ace ayiri asu kyu ka atatọọ. Kidẹ bu ni iMaryamu iMagadaliya, kina iMaryamu ayuru iYakubu aghu utumu kina iYusuf, kina iSalomi, <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Ka aGalili ayiri ri yii nga na sa ju nga utina. Ayiri nagigang mani akyeng ni nga ka Urushelima shiya ko kaa.<verse eid="MRK 15:41" /></para>
  <para style="s">Ọnaa ọkọng iYesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">IMat 27.57-61</ref>; <ref loc="LUK 23:50-56">ILuk 23.50-56</ref>; <ref loc="JHN 19:38-42">IYah 19.38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Awii ucuru akpara (akọ shi, awii lara awii uhuru aYahudawa). Ughẹ ya kpaa ni, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />iYusufu agha Arimatiya, aghu aghaghẹ kidẹ ugunu, aghu mani anga ma su sha ẹrẹgọm Ọnọng, alor ikwyi nga ki kya ukushi iBilatus kiya shọr ukọng iYesu. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />IBilatus wo ica nu mani a kọng si iYesu ko kpo. Ava yọrọ aghọ la kpọ ẹrẹkyuọ ta iYesu ko kpo ni. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Aya kọng ka anyu aghọ la kpọ ẹrẹkyuọ si ushiwudu ni, ava ma iYusufu ukọng. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />IYusufu va ghẹ ugyauto ufufugu, ki shulu nu ukọng, ki fuga ni ugyauto, ki ta nga kidẹ alọr anga ughẹ upang. Ava fuga kina ubule ọtighi ka anyu alor. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />IMaryamu iMagadaliya kina iMaryamu ayuru iYusuf anu uka mani anaa nga wu.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">IYesu sisang ka alọr</para>
  <para style="r">(<ref loc="MAT 28:1-10">IMat 28.1-10</ref>; <ref loc="LUK 24:1-12">ILuk 24.1-12</ref>; <ref loc="JHN 20:1-10">IYah 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Awii uwuru aYahudawa ya wolu wọ ni, iMaryamu iMagadaliya, kina iMaryamu ayuru iYakubu, kina iSalomi, aghẹ uma uvọng kaya coo ẹrẹnọma iYesu wu. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Kina iki kywating awii aye kidẹ awii atinsara ni, ọnọng ta, ava kpẹnẹ utra alọr nga <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />ava wulu ace bọ, “Inga ki yini utighi wu ka anyu alọr?”<verse eid="MRK 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4" />Na aba sang ica ka yaya ni, ava nu ni utii, mani ushi ughọghẹ, akọ yini bọ. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Aya ghila alọr ni, ava nu ace anọ ajiya ago uma ufufugu acii ka vo ila, ayi vasa kpa bu.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />“Ayi ma kpanọ kọ ba,” Atẹri bọ. “Inu so wang iYesu anga agha aNazaret, aghu mani a gra nga kaya ukumu ushọ. Akọ sisang! Ashi kokẹ ba. Nu ọka mani aya nga wu. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Ukya, uya tẹri atina nga kina iBitrus, Aki shi ki te nu ka kya aGalili. Uka duwu ni inu ki nu nga kọ, kini mani atẹri nu.”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Aipang ni ava kunu kina uti nọ titaa ika, ki ya alọr iYesu ya. Ara tẹri bọ ace aghọ ighima ba, ka a kọng ẹrẹbata.<verse eid="MRK 16:8" /></para>
  <para style="s">IYesu yeni ẹrẹkwyuẹ nga ukushi iMaryamu iMagadaliya</para>
  <para style="r">(<ref loc="JHN 20:11-18">IYah 20.11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />IYesu ya sisang ko kpo ka awii ayeng ka awii ating sara ni, ava yeni ẹrẹkwyuẹ nga ukushi iMaryamu iMagadaliya, aghọmani awo nga ushẹẹ utinsara wu. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Ava kya kiya tẹri aghu mani ashi ni iYesu na asọ ju ikwyi ibibi na sa ci. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Aya kọng si iYesu sha akyo ayiri si anga nu nga, ara ma bọ aipang ba.<verse eid="MRK 16:11" /></para>
  <para style="s">IYesu yeni ẹrẹkwyuẹ nga ukushi atina nga apai</para>
  <para style="r">(<ref loc="LUK 24:13-35">ILuk 24.13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Kusang kindi ni, iYesu vasa yeni ẹrẹkwẹ nga ukushi atina nga apai na aghing mani ashi ayeng ba mani a kyeng kidẹ anifọng. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Kindọ agha pai Avughu kiya tẹri ushe; kindọ ni, ara ma bọ aipang ba.<verse eid="MRK 16:13" /></para>
  <para style="s">IYesu yeni ẹrẹkwyuẹ nga ka atina nga ọshọ na ayeng</para>
  <para style="r">(<ref loc="MAT 28:16-20">IMat 28.16-20</ref>; <ref loc="LUK 24:36-49">ILuk 24.36-49</ref>; <ref loc="JHN 20:19-23">IYah 20.19-23</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Ata ricuru ni iYesu va yeni ẹrẹkwyuẹ nga ukushi ọshọ na ayeng mani asọ la imila. Ava gẹr bọ ko taa aipang bọ, kina mani atọrọ bọ uma aipang na aghọmani anu nga mani asisang.<verse eid="MRK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15" />Ava tẹri bọ, si “Ukya idẹ asing kọ ya tẹri ila ididuma ko shi ajiya nadidu. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Aghọmani ama aipang, na aju nga iminimini ni, aki peni foo. Aghọmani ata ma aipang ba ni aki wa nga ashuwa. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Aki nu uma uwo ica ukushi aghọ ma aipang, Kidẹ nu uca mi ni ọki wuli ushẹẹ; aki pii ni irighimi mani ayẹbuba; <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />aki kpeni iyọọ kina ivọ bọ; insi asa akang ni, aki jubọ icima ba; aki tila ivọ bọ kaya adumu, na ki lẹni.”<verse eid="MRK 16:18" /></para>
  <para style="s">A kpa iYesu ki kya bu ayaya</para>
  <para style="r">(<ref loc="LUK 24:50-53">ILuk 24.50-53</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Utumu mani Ate ọna iYesu pii ni bọ ni, ava kpa nga ki kyabọ ayaya ko, na va cica kavọ ila Ọnọng. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Atina nga va kunu kiya tẹri ila ididuma kwabi, Ate ọna sha shẹ bọ kọ na sha sa imumani atẹri unga uwo ica nu shi kindọ.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>