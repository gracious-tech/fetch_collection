<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">MARKUS - Hona Bible</book>
  <para style="h">Markus</para>
  <para style="toc3">Markus</para>
  <para style="toc2">Markus</para>
  <para style="toc1">Markus</para>
  <para style="mt1">Markus</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Tangsang Yahaya tǝ Mbaptisma kwamanaɗǝ</para>
  <para style="r">(<ref loc="MAT 3:1-12">Matta3:1-12</ref>; <ref loc="LUK 3:1-9">Luka3:1-9</ref>,<ref loc="LUK 3:15-17">15-17</ref>; <ref loc="JHN 1:19-28">Yahaya1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Katǝra ɗeleewar tǝ Peɗǝnda aten Yeeso Ƙǝrǝsti, Wan Faara. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />Chirethleng nda hai hu ɗeleewar annabi Ishaya tǝ ndaarha,</para>
  <para style="q1" vid="MRK 1:2">“Niya ˈwa thlǝn tǝ thlǝndǝna ɗǝ ma sa,</para>
  <para style="q2" vid="MRK 1:2">na a takso kwamana ɗǝ” <note caller="*" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Malachi3:1</ref></char></note><verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />“Urarha a aah farha a kaheerha.</para>
  <para style="q1" vid="MRK 1:3">‘Taksaman kwamana Chinǝm sǝ</para>
  <para style="q2" vid="MRK 1:3">pǝpǝnaman kwaman sarya ɗǝ a ndǝghǝn.’” <note caller="*" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">Ishaya40:3</ref></char></note><verse eid="MRK 1:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Yahaya kyagha ɓa a kahedɗi nagha a ndang nda fiya a malangganda ɗimiyid ndan fananggǝn kanda yi chakh ɗimiyirha. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Kahad fiya na a chehweed Yahuda tǝ fiya heu na a Urshalima kyanda ɓa ɗǝnda thlǝmadghǝn ɗǝ. Malang nda ɗimiyid ndan ǝnangga Yahaya mbaptisǝma kanda a kufad Urdun.<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />Yahaya kalɗǝ lukrha ǝnana nda tǝ was thlǝkhmu, ƙǝnanggǝn muwun tǝ paama, mbeeya tǝ ɗee ndǝna ǝnnadghǝn mii.<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">2 Kutǝrya 1:8</char></note> <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Ndanggǝn fiya, “Na niifa sǝ ɓayi a samadna na tǝ sǝsǝmnda fa kalgha nggi mu, sahad pahamggǝn tsǝkki na a kwasang nggi hai wa. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Ənanggi mbaptisǝma kun tǝ aama, amma ndǝghǝnggi nǝn a ǝnang mbaptisǝma kun tǝ sǝsǝna tǝ Peɗǝnda.”<verse eid="MRK 1:8" /></para>
  <para style="s">Ənang nda mbaptisǝma Yeeso</para>
  <para style="r">(<ref loc="MAT 3:13-17">Matta3:13-17</ref>; <ref loc="LUK 3:21-22">Luka3:21-22</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />A hu sayidɗi kee ɓagha Yeeso ɓa a Nadzarat na hu chehweed Nggalili ǝnangga Yahaya mbaptisǝma a kufad Urdun. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Nana Yeeso a kyarha sǝ hu aamɗi kee, ƙǝlagha hai talara inɗaɗǝ nagha Sǝsǝn Faara a tǝraa tenggǝn hai ƙǝla tǝtiliurha. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Sǝk urarha nda a talara hai, “Sani Waana, nggǝmni niyi a tǝk mbǝnduwa fa kaan.”<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">Katǝrarha 22:2; Dzabura 2:7; Ishaya 42:1; Matta 3:17; 12:8; Markus 9:7; Luka 3:22</char></note><verse eid="MRK 1:11" /></para>
  <para style="s">Ƙǝƙǝrang Sheetan Yeeso</para>
  <para style="r">(<ref loc="MAT 4:1-11">Matta4:1-11</ref>; <ref loc="LUK 4:1-13">Luka4:1-13</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Tsu kee tǝrangga Sǝsǝna tǝ Peɗǝnda a kaheerha ɗǝ, <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />tsauka a kahedɗi yi ɓeena kumggit faɗa nagha sheetan a ƙǝƙǝrang nda. Ndǝghǝn a kahedɗi tǝ thlukkya yi heerha, nagha fathlǝngya Faara a ǝnang taara.<verse eid="MRK 1:13" /></para>
  <para style="s">Katǝrang Yeeso targhǝn hai</para>
  <para style="r">(<ref loc="MAT 4:12-17">Matta4:12-17</ref>; <ref loc="LUK 4:14-15">Luka4:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />A kwasamadɗi muwang nanda Yahaya ahu porsǝna ɗǝ, ɗǝgha Yeeso Nggalili ɗǝ nagha a pǝr laɓar Faara. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Nagha a ndaarha, “Ɓad sayidɗa ɓa, kutǝryid Faara nduwusɗa ɓa. Malaman ɗimiyid nun fǝrƙǝkafek nun tǝ Laɓarɗi na Mbǝnggǝn.”<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">Matta 3:2</char></note><verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Nduwusna Yeeso mii kufad Nggalili ɗǝ, na Siman nǝn tǝ wan man Andrawus a muk panggama a kufadɗi ƙǝsǝr kanda fa ƙǝs tǝngya ni. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Ndangga Yeeso kanda, “Ɓama ɓa, mbuwama samadna, niya tsawang kun fa ƙǝs fiya ɓa.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Tsu a mbǝɗi kee malangganda panggamggi ndan mbu samadghǝn nda.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Ɗǝnǝn mbeeɗǝ, na Yakubu nǝn tǝ wanman Yahaya wangya Dzabaɗi ahu kwambuwol, kanda a tangsang panggamnggi ndan ɗǝ. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Nana Yeeso kanda aah kanda nǝn, mal chi ndan nda Dzabaɗi ahu kwambuwol ɗi tǝ fingya nafiya na a ɗang kanda sǝ mbu samadghǝn nda.<verse eid="MRK 1:20" /></para>
  <para style="s">Ƙǝnang Yeeso niifa na tǝ ǝnkaheerha fa</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luka4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Ɗǝnda Kafarnahum ɗǝ, nduwusna far yiɓǝd Yahudaya ɓa, kyagha Yeeso Ƙǝn Faara ɗǝ katǝranggǝn tsaharhaha. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Nagha fiya ǝnwulteena a ten tsahadghǝn ha, ƙǝsǝr tsahanggǝn kanda ha ƙǝla niifa na tǝ ngyakhrha ha, mbǝ ƙǝla fa malǝmngya yi ɗeleewar Musa wa. <note caller="*" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">Matta7:28-29</ref></char></note><verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Tǝrgha ahu ƙǝn hwan Faarɗan na niifa sǝ na tǝ ǝnkaheerha fa huhwaagha, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />ndǝghǝn, “Mana midwa tǝ kan, Yeeso tǝ Nadzarat? Ɓana ɓa ka ɓǝlangga kan wa? Sǝnɗi sa, na chahal yi Faara!” <verse eid="MRK 1:24" /><verse number="25" style="v" sid="MRK 1:25" />Yanangga Yeeso, “Nggǝlang miiwa! Kyosǝ a fadghǝn.”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />Muwangga ǝnkaheedɗi hweeɗe hai, huhwaagha, kyagha sǝ a fadghǝn.<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />Fiya na a mbǝɗi ka ǝnwulteena na nda a ndang nda ndan, “Tur maniya? Weerinda tsaharhaha tǝ ngyakhrha! Nǝn yanang ǝnkaheeya na nda a takkwa miighǝn.”<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />Laɓarghǝn welɗaɗǝ ƙǝkar ahu chehweed Nggalili.<verse eid="MRK 1:28" /></para>
  <para style="s">Ƙǝnang Yeeso Fiya hangga</para>
  <para style="r">(<ref loc="MAT 8:14-15">Matta8:14-15</ref>; <ref loc="LUK 4:38-39">Luka4:38-39</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Kyana nda hai ahu Ƙǝn Faara, nda Yakubu tǝ Yahaya ɗǝnda wuri ki Mbiturus ɗǝ tǝ Andrawus. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Thlaɓǝr Mbiturus tǝnuwunda fadghǝn ɓee kalth hu sǝra, pǝrang nggǝnda Yeeso. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Ɗǝgha Yeeso thlǝmad nuɗaɗǝ, ƙǝs harghǝnǝn thlenggǝn sǝ. <verse eid="MRK 1:31" /><verse number="32" style="v" sid="MRK 1:32" />A figrha mukna yanfaara hai ɓagha fiya thlǝmad Yeeso ɓa tǝ nafiya na fandan ɓee tǝ fingya na tǝ ǝnkaheeya fa. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Nafiya na ahu talɗi wuma nda kwatkirǝm ɗa ɓa. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Ƙǝnangga Yeeso fiya hangga na tǝ wanhaaya fa ɗǝɗamǝn-ɗǝɗamǝn. Kyanggǝn ǝnkaheeya sǝ hangga na a fad fiya, amma mbǝ malang ǝnkaheeyini kala nda sǝ wa ƙǝsǝr sǝn ndan.<verse eid="MRK 1:34" /></para>
  <para style="s">Hwan Yeeso Faara a mbǝrha na ɓǝɓee</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luka4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />A tsar ƙǝrǝt, ka pit mbǝrha ɓa, thliigha Yeeso sǝ ɗǝgha mbǝrha ɗǝ na ɓǝɓee hwan Faara nǝn. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Mbiturus tǝ ka wiyighǝn ɗǝnda ka kaɗadghǝn ɗǝ, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />walang nanda, ndang ngganda, “Fiya kahad a kaɗa sa!”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Nggǝmangga Yeeso kanda, “Taama mbǝrha ɗǝ pak ahu talya ɗǝ na tsau tǝni ɗǝ pǝr laɓarɗi a mbǝɗi ƙǝm. Ndǝghǝnni ɓani ɓa ka manggǝn.”<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />Wenggǝn chehweed Nggalili hai nagha a pǝr laɓar Faara ahu ƙǝn tsahad Yahudaya tǝ kyang nda ǝnkaheeya sǝ.<verse eid="MRK 1:39" /></para>
  <para style="s">Niifa na tǝ wanhad termeerha</para>
  <para style="r">(<ref loc="MAT 8:1-4">Matta8:1-4</ref>; <ref loc="LUK 5:12-16">Luka5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Niifa na tǝ wanhad termeerha fa ɓagha thlǝmadghǝn ɓa ɓǝrgha hai tǝ waɗedghǝn hwanggǝnǝn, ndanggǝn, “A nggǝmna fa, tsaɓee ɗǝ.”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Haɗangga niifɗi Yeeso fa, tǝrangga Yeeso harghǝn sǝ tsuwarghǝnǝn fa ndanggǝn, “Nggǝmɗifa, tsaɓuɗǝ.” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Tsu a mbǝɗi kee, kyagha termedɗa sǝ a fadghǝn ƙǝngga.<verse eid="MRK 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43" />Ƙǝsgha Yeeso thlǝmadghǝn, ndanggǝn, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />“A pǝrang nan niifa wa. Amma ɗuwaɗǝ, a kyaɗang fadwa firis ǝna sataka na ƙǝla ndana ngyakhrha ɗeleewar Musa a kyaɗang ndaarha nǝn kanda tsabna ɗǝ.” <note caller="*" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Livitikus14:1-32</ref></char></note><verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />A meghedghǝn kyagha niifɗa hai nagha a pǝrghǝn. Ndǝn ǝnagha ndǝn, ɓalwa Yeeso nggǝr kyarha hur tala hai a pǝpal amma ishgha a ƙǝsǝr wure a mbǝrha mbuwana niifa sǝ. Ko nanǝn kee na fiya naarha ɓarha thlǝmadghǝn ɓa a mbǝya ɓa hangga.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Ƙǝnang Yeeso niifa mǝrna fadghǝn hai</para>
  <para style="r">(<ref loc="MAT 9:1">Matta9:1</ref>,<ref loc="MAT 9:8">8</ref>; <ref loc="LUK 5:17-26">Luka5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Mǝngwaha wa, nggǝrgha Yeeso kyarha Kafarnahum hai, sǝkka fiya ndaarha ɓaɗǝ wure ɓa. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Wumngga fiyaɓa, lǝɗang ngganda ƙǝnɗi ta mii kwatminda ɓa, a nagha a pǝrang laɓar Faara kanda. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Ɓagha nafiya ɓa faɗa tǝ niifa mǝrna fadghǝn hai. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Walwa nda kwamana wa ƙǝsǝr ka hangnda fiya. Thlǝɓangganda ten ƙǝnɗa ɗǝ mǝmǝl tǝ man ten Yeeso fǝrghǝn nda hai tǝ ɗǝngǝlɗi hunangganda hai a mbed Yeeso.<verse eid="MRK 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 2:5" />Nana Yeeso fǝrƙǝkafǝkkin ndan, ndanggǝn hadɗi na kath, “Waana chohonda ɗimiyidwa ɗǝ.”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Nanǝn ya, fasǝngya ngyakhrha tǝ Farisaya kanda a numarha tǝ ndaarha, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“Kama na niifɗi ndaarha kee ya? Tǝ sar farha ni! Mbǝ niifa sǝ na chakh ɗimiyirha wa ƙǝl Faara katenggǝn.”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Tsu kee sǝngga Yeeso ǝnɗi nanda a numarha ahur ndan, ndanggǝn kanda, “Kama nun a numarha aten ǝngginiya? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Yanggini pǝpa, ndanggǝm tǝ mǝrra fadɗa hai, ‘Chohonda ɗimiyidwa ɗǝ wa,’ nduwa ndam, ‘Thliusǝ, tǝrang ɗǝnggǝl wa wiu wa?’ <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Amma a sǝnunsǝ Wan niifa nǝghǝn tǝ sǝsǝmnda ha hu ƙǝshidɗiya yi chakh ɗimiya.” Ndanggǝn niifɗi mǝrna fadghǝn hai,<verse eid="MRK 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 2:11" />“Ndoyi, thliusǝ tǝrang ɗǝggǝl wa wiina wureɗǝ.” <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />Thliigha sǝ tǝranggǝn ɗǝnggǝlghǝn kyagha hai a yid fiya heu. Ənɗiya fǝrang ɗǝ ǝnwulteena kanda na nda a fal Faara, na nda a ndaarha, “ˈWawum na tur ǝnɗiya wa.”<verse eid="MRK 2:12" /></para>
  <para style="s">Yeeso aahɗǝ Lawi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Matta9:9-13</ref>; <ref loc="LUK 5:27-32">Luka5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Nggǝrgha Yeeso ɗǝrha mii kufad Nggalili ɗǝ. Ɓagha fiya hangga thlǝmadghǝn ɓa, nagha a tsahang kanda ha. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Nanǝn a mbǝra ɗǝ, na Lawi nǝn wan Halfa tsau a thlǝ tsamnda. Ndanggǝn, “Mbuwu samadna.” Thliigha Lawi sǝ mbu samadghǝnǝn.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Nana Yeeso a hǝb ǝnnarhami a minda ki Lawi, fa thlǝ tsamngya hangga tǝ fa “ɗimiya” na nda a hǝbrha tǝghǝn tǝ fatsahayighǝn, ƙǝsǝr fiya hangga mbuwa samadghǝn. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Nana fa sǝngya ɗeleewar Musa na Farisaya na nandan a hǝbrha tǝ fa “Ɗimiya” tǝ fa thlǝ tsamngya, tsahang mee nda fatsahayighǝn, “Kama nǝn a hǝbrha tǝ fa thlǝ tsamngya tǝ fa ‘Ɗimiya’?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Sǝkna Yeeso kee ndanggǝn kanda, “Mbǝ nafiya na ƙǝkanglang kaɗa tǝ purha wa, Ƙǝl haaya. Ɓawi ka aah nafiya ɓa na a ǝna nggayirha wa, amma fa ɗimiya.”<verse eid="MRK 2:17" /></para>
  <para style="s">Tsakhmee aten kar aama</para>
  <para style="r">(<ref loc="MAT 9:14-17">Matta9:14-17</ref>; <ref loc="LUK 5:33-39">Luka5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Fatsahaya Yahaya tǝ Farisaya na nda kar aama. Ɓagha fingya thlǝmadghǝn ɓa tsahang mee nda Yeeso, “Mani ǝnagha ndǝn, fatsahaya Yahaya tǝ yi Farisaya kanda a kar aama, amma finayiwa mba nda ǝnaarha wa?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Nggǝmangga Yeeso kanda, “Pashiya wutsamnda na nda kar aama wutsamnda ɓalɗǝ a thlǝmad ndan wa? A ɓal wutsamnda a thlǝman ndan mba nda ǝnaarha wa. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Na sayi ɓayi ɓana nda tǝrang wutsamndǝɗi ma kanda. A mbǝɗaniya ɓa nanda kar aama.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“Mbǝ niifa sǝ na njar ɓar kaɓarha ɓa mbuhanggǝnǝn suhurra lukrha fa wa. A ǝna ɗǝ kee, mbuhudɗi na tǝ kukwasharra ɓar kaɓadɗi nǝn njaara hai a fad luwudɗi kal yanɗa nǝn mu na kaar. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Mbǝ niifa sǝ na irang weerǝnda aam inabi ahu suhurra samsami hai wa. A ǝna ɗǝ kee, na weerǝnda aam inabi ɗi ɗathlang nda samsami ɗa ɗǝ. Nǝn iraɗǝ, sǝbgha samsami ɗa ɗǝ. Kamɗǝ weerǝnda aam inabi nǝm irangnda ahur weerǝnda samsami hai.”<verse eid="MRK 2:22" /></para>
  <para style="s">Tsakhmee aten far yibrha</para>
  <para style="r">(<ref loc="MAT 12:1-8">Matta12:1-8</ref>; <ref loc="LUK 6:1-5">Luka6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Na farɗa sǝ, far Yibrha Yahudaya, Yeeso tǝ fatsahayighǝn tǝrnda kwaman heerha; tǝrgha fatsahayighǝn kya ten ǝnnarhami nda na ƙǝla wan hwaliirha fahwang ngganda hai na nda a kiighǝn.<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">Nggurub Ngwa Kumaarha 23:25</char></note> <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Ndagha Farisaya, “Mani na fatsahayiwa ǝna ˈya kee, ˈyaɗana ngyakhrha Musa yi far Yibrha?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Nggǝmangga Yeeso kanda, “Karatang ngwanun ǝnɗi na hu ɗeleewar Faara ǝnana Ndauda tǝ nafighǝn na miirha a ƙǝs kanda wa? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />A thlakh mbǝd Abiyata mamnda firis, kyanǝn hu Ƙǝn Faara ɗǝ tǝrnǝn mburodi sǝ ɗǝfangna nda ɗǝ ka firis katenggǝn, kiigha ǝnangǝn pashiya wiyighǝn ha.”<note caller="*" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">Livitikus24:9</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">2:26 </char><char style="ft" closed="false">Firistaya 24:9</char></note> <verse eid="MRK 2:26" /><verse number="27" style="v" sid="MRK 2:27" />Ndangga Yeeso kanda, “Əna nanda far yibrha ka niifa, mbǝ niifa ka far yibrha wa. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Nanǝn kee, Wan Niifa Chinǝm ni heu tǝ far Yibrha.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Niifa mǝrna harghǝn hai a Kafarnahum</para>
  <para style="r">(<ref loc="MAT 12:9-14">Matta12:9-14</ref>; <ref loc="LUK 6:6-11">Luka6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Na farɗa sǝ fadɗǝn, kyagha Yeeso Ƙǝn Faara ɗǝ, na niifa sǝ mǝrna harghǝn hai ahur ƙǝnɗi. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Na nafiya sǝ na mindan a ƙǝsangganda Yeeso tǝ ɗimiyirha, ƙǝlaghǝn nda ha tǝnǝn a ƙǝnang nda niifɗi a far yibrha.<verse eid="MRK 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 3:3" />Ndangga Yeeso niifɗi mǝrna harghǝn hai, “Thliusǝ ɓa isha a mbed fiya.” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Tǝrgha tsahangga Yeeso mee kanda, “Yanggini mǝmǝl a ǝnam a far Yibrha? Əna nggayirha nǝm wa nduwa mbǝlfeerha wa, a hǝrghanggǝm yibrha wa nduwa ɓǝlanggǝm wa?”<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />Ƙǝlangga Yeeso kanda tǝ sǝbrha hura tǝ ƙǝm ǝn kawani ka kakrakkid ten ndan. Ndanggǝn niifɗi, “Pǝpǝnang harwa ɗǝ.” Pǝpǝnanggǝn harghǝn ɗǝ, a mbǝɗi kee nggǝrgha harghǝn ɓa ƙǝla kaar. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Tǝrgha Farisayini kya nda ƙǝshaaɗǝ ɗa nda ndikrha tǝ nafiya Hirdus na a kaɗa kwaman ɓǝllang nda Yeeso.<verse eid="MRK 3:6" /></para>
  <para style="s">Mbu fiya samad Yeeso</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yeeso tǝ fatsahayighǝn ɗǝnda mii kufad Nggalili ɗǝ, fiya hangga mbuwa samadghǝn. <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />Hǝrǝm nanda sǝk ǝngya ǝnanǝn heu, fiya hangga ɓagha ɓa a Yahuda, tǝ Urshalima, tǝ Idomiya, tǝ fingya na a pǝm kufad Urdun, tǝ nafiya Taya tǝ Sidon. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Ka hangnda fiya ndangga Yeeso fa tsahayighǝn a ɓang kombuwol nda ɓa na ngguchit amana fiya ˈyaɓang mbǝrha fa. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Ƙǝsǝr ˈwaɗǝ teena ƙǝnang ɗǝ fiya hangga, ndǝn ǝnagha ndǝn fingya na tǝ wanhaaya fa kanda a ˈwaarha mbee ɓa ka a tsǝwarghǝn nda fa. <note caller="*" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MRK 4:1">Markus4:1</ref>; <ref loc="LUK 5:1-3">Luka5:1-3</ref></char></note> <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Kala sayidɗi nana sǝsǝn mbǝlfeeya ndǝn, ƙǝl na nda fǝla hai a mbedghǝn na nda a ndaarha, “Wan Faara ni Sa.”<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />Amma ƙǝsɗǝ thlǝman ndan a pǝr ndan tǝ wunni ndǝghǝn wa.<verse eid="MRK 3:12" /></para>
  <para style="s">Wur Yeeso fa thlǝnggighǝn kumkap sǝri</para>
  <para style="r">(<ref loc="MAT 10:1-4">Matta10:1-4</ref>; <ref loc="LUK 6:12-16">Luka6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Tǝrgha Yeeso wumnda sǝ, aah fingyayina nǝn ɓa na midghǝn, ɗǝnda thlǝmadghǝn ɗǝ. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Wurgha hasǝ ahur ndan Kum kap sǝri, aah kanda nǝn fathlǝnggighǝn, a tsawa nda tǝghǝn tǝ ƙǝm a nagha thlǝn kanda ka pǝr laɓar Faara ɗǝ, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />tǝ wal ngyakhrha na kyangganda ǝnkaheeya sǝ. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Kulo nafini kumkap sǝri wurnǝn ya.</para>
  <para style="b" vid="MRK 3:16" />
  <para style="li" vid="MRK 3:16">Siman, ɗǝfang na Yeeso thlǝma Mbiturus,<verse eid="MRK 3:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="MRK 3:17" />Yakubu wan Dzabadi tǝ wanman na Yahaya.</para>
  <para style="li" vid="MRK 3:17">Ɗǝfangna Yeeso thlǝma kanda Mbuwadjis, ndaarha ni “Wangya Tǝrˈyana.”<verse eid="MRK 3:17" /></para>
  <para style="li">
    <verse number="18" style="v" sid="MRK 3:18" />Andrawus,</para>
  <para style="li" vid="MRK 3:18">Filibus,</para>
  <para style="li" vid="MRK 3:18">Mbatalomi,</para>
  <para style="li" vid="MRK 3:18">Matta,</para>
  <para style="li" vid="MRK 3:18">Toma,</para>
  <para style="li" vid="MRK 3:18">Yakubu wan Halfa,</para>
  <para style="li" vid="MRK 3:18">Tandawus,</para>
  <para style="li" vid="MRK 3:18">Siman tǝ sǝrǝk chehweedghǝn.<verse eid="MRK 3:18" /></para>
  <para style="li">
    <verse number="19" style="v" sid="MRK 3:19" />Tǝ Yahuda Iskaryoti, fǝrgha Yeeso.<verse eid="MRK 3:19" /></para>
  <para style="s">Yeeso tǝ Mbaˈaldzabul</para>
  <para style="r">(<ref loc="MAT 12:22-32">Matta12:22-32</ref>; <ref loc="LUK 11:14-23">Luka11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Tǝrgha Yeeso kyagha ahur minda hai, nggǝrgha fiya wumnda ɓa, ndǝghǝn tǝ fa tsahayighǝn mba nda wal kwaman ǝna ˈya mii wa. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Sǝkna hurfayighǝn ǝnɗi nǝn a ǝnaarha, ɗǝnda ɗǝ ka a ƙǝsangganda, ƙǝsǝr na fiya a ndaarha, “Kyahar hutenggǝn hai.”<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Fa malǝmngya ngyakhrha ɓagha ɓa Urshalima ndaa nda, “Nǝghǝn tǝ Mbaˈaldzabul fa! Tǝ ngyakhrha Mbaˈaldzabul ni nǝn a kyang ǝnkaheeya sǝ.” <note caller="*" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Matta9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char></note><verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Aagha Yeeso kanda ɓa thlǝghang karapu nǝn kanda sǝ, “Na sheetan ƙǝn na mbang kyang Sheetan sǝ?” <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />A tsakh kutǝryirha hai sǝri, mbǝ kutǝryidɗi isha wa. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />A tsakh wure hai sǝri, mbǝ wuriɗi isha wa. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Ana Sheetan a yan altenggǝn tǝ ƙǝm tsakhka hai, mbǝ mbang isha wa. Ɓa ngwala ɓenggǝn ɓa.<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />Ƙǝkafek, mbǝ niifa sǝ na kyarha minda ki niifa hai na kanglang wiigha tǝ ǝnggighǝn wa ƙǝl ma ˈwaɗǝ teena ƙǝnangɗǝ niifɗa hai na kanglang ˈwan. A mbanggǝn har karid wurighǝn.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />“Niya pǝrang ƙǝkafek kun, ɗimiya na heu tǝ sarfaya ǝnana fiya na nda chahanggǝn kanda ɗǝ. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Amma kala niifa sargha Sǝsǝna tǝ Peɗǝnda mba tam chahanggǝn ɗǝ wa, ǝnaɗǝ ɗimiyirha yi pa kwanɗǝ.”<note caller="+" style="f"><char style="fr" closed="false">3:29 </char><char style="ft" closed="false">Luka 12:10</char></note><verse eid="MRK 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 3:30" />Thlǝkna Yeeso ndǝn kee ƙǝsǝr na nda a ndaarha, “Nǝghǝn tǝ ǝnkaheerha fa.”<verse eid="MRK 3:30" /></para>
  <para style="s">Man Yeeso tǝ Wanmanggighǝn</para>
  <para style="r">(<ref loc="MAT 12:46-50">Matta12:46-50</ref>; <ref loc="LUK 8:19-21">Luka8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Tǝrgha ɓagha man Yeeso ɓa tǝ wanmanggighǝn. Isha nda a ƙǝshi thlǝn farha nda ɗa nda aaghǝn ɓa. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Fiya wumngga hai muwang nda maɗufu hai, ndang ngganda, “Muwa tǝ wanmanggiwa kanda a ƙǝshi kanda a kaɗa sa.”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Tsakhmee nǝn, “Nda wunni iiya tǝ wanmanggina?”<verse eid="MRK 3:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 3:34" />Tǝrgha ƙǝlanggǝn fiya muwangga maɗufu hai ndǝghǝn, “Kulo nda iiya ya tǝ wanmanggina! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Kala niifa ǝnagha taara tǝ ˈya na mid Faara tsauɗǝ wan pa tǝ wan nya tǝ iiya.”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Karapu aten tǝhǝfrha</para>
  <para style="r">(<ref loc="MAT 13:1-9">Matta13:1-9</ref>; <ref loc="LUK 8:4-8">Luka8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Yeeso nggǝrghǝn ɗǝrha mbeeɗǝ tǝ tsahang fiya ha a mii wuri aam Nggalili. Fiya wumngga thlǝmadghǝn ɓa mulnda hai kaan pa kyagha hu kombuwol hai fiya tsǝtsau a mii ƙǝkǝshɓang nda.<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">Luka 5:1-3</char></note> <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Tsahang ɗǝ ǝngya kanda ha hangga tǝ karapuya. A hu tsahadghǝn ha ndǝghǝn, <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />“Kama thlǝmarha hai! Tǝ huɗarha ɗǝɗǝ ka hǝfrha ɗǝ. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Nanǝn aten wash wiidɗi, hǝrgha fingya hai aten kwamana, ɓagha wuɗikkya ɓa ɗamangganda. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Hǝrgha fingya hǝreng keela hai, ka mbuwana chehweerha sǝ ngga kya nda sǝ ƙǝkar, ƙǝsǝr mbǝ chehweedghǝn kuɗimnggǝn wa. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Amma tǝkna yanfaara hai, hwara nda ɗǝ, ƙǝsǝr kwa wanda thlaara hai wa. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Fingya hǝra nda pathlang ndakhkya hai kya nda sǝ kal wanda farha hai a pathlang ndakhkini wa ko kanda ǝna wee. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Amma fingya hǝra nda hu chehweerha hai na ngga kyanda sǝ ǝna wee nda fingya katǝra kumnggit mahan-mahan, fingya ƙǝm kumnggit mikki-mikki har haru-haru.” <verse eid="MRK 4:8" /><verse number="9" style="v" sid="MRK 4:9" />Ndǝghǝn, “Yi na tǝ thlǝmad sǝkrha, sǝkƙǝnǝn.”<verse eid="MRK 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Sayidɗi nanǝn katenggǝn, kumkap sǝri ɗi tǝ fingya na a thlǝmadghǝn tsahang mee nda ha aten karapu yini. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Ndanggǝn kanda, “Nggǝmang nda kun fa na a sǝn ˈya nun na kutǝryid Faara ahurghǝn, fingya a mbǝ tǝ karapu wa mba nda sǝnggǝn wa. <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />Tǝna nda,</para>
  <para style="q1" vid="MRK 4:12">“‘Ƙǝlaarha ɗǝ, amma mba nda kukwalang hai wa,</para>
  <para style="q2" vid="MRK 4:12">na nda sǝkƙǝn ƙǝm, amma mba nda sǝnang hai wa.</para>
  <para style="q1" vid="MRK 4:12">Kam kyahar nda ɓa,</para>
  <para style="q2" vid="MRK 4:12">chahang ɗimiyid ndan nda kanda ɗǝ!’ ”<note caller="*" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Ishaya6:9-10</ref></char></note><verse eid="MRK 4:12" /></para>
  <para style="s">Pǝr Yeeso ten karapu ɗi</para>
  <para style="r">(<ref loc="MAT 13:18-23">Matta13:18-23</ref>; <ref loc="LUK 8:11-15">Luka8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Tǝrgha ndangga Yeeso kanda, “Ashe sǝnanggun karapu ɗa hai ya wa, ƙǝƙǝn nun sǝn fingya karapuya? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Tǝ hǝfǝdɗi, laɓar Faara ni nǝn a pǝra. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Wiidɗi hǝrgha aten kwamana hai nǝghǝn aten nafiya sǝkka laɓarɗi, amma ɓagha Sheetan ɓa tǝranggǝn laɓar ɗaɗǝ ahur ndan. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Fingya, na nda ƙǝla wiirha hǝf nanda a hǝreng keela, sǝk nanda laɓarɗi thlǝghǝn nda tǝ hura pǝpet. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Amma mbuwana thlar ndan sǝ, mǝngwanda ha wa. A hǝrǝm ɓillarha nduwa sǝsaarha ɓarha ɓa ƙǝsǝr ka laɓarɗi mba nda kwas kyaharra hai wa. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Tǝ ƙǝm na fingya ƙǝla wiiya hǝrgha pathlang ndakhkya hai, sǝkka laɓarɗi; <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />amma ƙǝsǝr ɓillad ƙǝshiirha, tǝ suna ƙǝna tǝ nggǝm ǝn ƙǝshiirha thluranggǝn laɓarɗi ahur ndan tsauka mbǝ ˈyani na ngga wa. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Wiiya hǝrgha hu chehweerha hai na ngga, nafiyani sǝkka laɓar Faara thlǝghǝnda fa tǝ chikrha katǝra kumnggit mahan-mahan, kumnggit mikki-mikki tǝ haru-haru aten ǝnɗi hǝf nanda.”<verse eid="MRK 4:20" /></para>
  <para style="s">Patilla tsǝtsǝɓa tǝ tǝɓa</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luka8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Ndangga Yeeso kanda, “ˈWad niifa ɓarha ɓa tǝ patilla tsǝɓanggǝn tǝ tǝɓa nduwa ɗǝfanggǝn kasǝra ɗǝ wa? Mbǝ nǝm ɗǝfang nda a mbǝd ɗǝfǝdghǝn wa?<note caller="*" style="x"><char style="xo" closed="false">4:21 </char><char style="xt" closed="false"><ref loc="MAT 5:15">Matta5:15</ref>; <ref loc="LUK 11:33">Luka11:33</ref></char></note> <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Mbǝ ˈyasǝ na ɓǝɓee mbuwa kyarha sǝ wa. Mbǝ ˈyasǝ ƙǝm na nggǝnggǝla mbuwa wa kyarha pǝpal ɓa wa. <note caller="*" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">Matta10:26</ref>; <ref loc="LUK 12:2">Luka12:2</ref></char></note> <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Kala niifa na tǝ thlǝmad sǝkrha sǝkƙǝnǝn.”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />“Kwarama tǝ sǝk pathla nun naarha sǝkrha, tur tasau ƙǝƙǝrɗi nun a ƙǝƙǝrra sǝ, ndǝghǝnni na nda a ƙǝƙǝrang kunsǝ ƙǝm har kal yinun nǝn mu.” <note caller="*" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="MAT 7:2">Matta7:2</ref>; <ref loc="LUK 6:3">Luka6:3</ref></char></note> <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />“Kala niifa na tǝ ˈya ha na nda a chighanggǝn, kala niifa ƙǝm mbuwa wa tǝ ˈya ha, yanɗi nanǝn tǝghǝn ha ƙǝm na nda a thlang nda hai.”<verse eid="MRK 4:25" /></para>
  <para style="s">Karapu aten wiirha na a tsǝrha</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Nggǝrgha Yeeso ndaarha, “Na kutǝryid Faara kiya. Niifa washgha wiirha ahu hedghǝn ɗǝ. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Mǝngga ha, kyagha wiidɗa sǝ, sǝngwa sǝ tǝ katǝradghǝn hai ƙǝƙǝn wa. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Tǝ altenggǝn nagha a tsǝrha, katǝradghǝn hai tǝ kwaafa, ɗǝfgha hur iiwee nǝn. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />A hǝrǝmɗǝ nakhɗaarha, nǝn a hwasang sǝ tǝ ɗǝhwasarha ƙǝsǝr tsǝ shifiirha hai.”<note caller="+" style="f"><char style="fr" closed="false">4:29 </char><char style="ft" closed="false">Djoyel 3:13</char></note><verse eid="MRK 4:29" /></para>
  <para style="s">Karapu aten wiirha na ƙǝla wan parsǝna</para>
  <para style="r">(<ref loc="MAT 13:31-32">Matta13:31-32-34</ref>; <ref loc="LUK 13:18-19">Luka13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Nggǝrgha Yeeso ndaarha, “Tǝ ma nǝm sakh kutǝryid Faara, nduwa tǝ tur yanggi karapu nǝm sakhƙǝn sǝ? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Nǝghǝn ƙǝla wan parsǝna na wanggǝn ngguchit ahur wiiya na heu nǝm hǝfrha. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />A hǝfang ɗǝm hai nǝn tsǝrha tsauka ɗǝfrha manggǝn kal fingya nǝn na ahu hedɗi ǝnagha wuɗikkya ƙǝndan a wuhwaryighǝn.”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Tǝ fingya karapuya ƙǝla yanɗiya hangga thlǝghangna Yeeso kanda sǝ, tǝ fingya na nda mbang sǝnang hai. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Mbǝ ˈyasǝ nǝn thlǝghang kanda kula karapu wa. Amma sayidɗi nanǝn tǝ fatsahayighǝn nǝn fǝlanggǝn kanda hai.<verse eid="MRK 4:34" /></para>
  <para style="s">Yanang Yeeso ɓereu ˈyaara</para>
  <para style="r">(<ref loc="MAT 8:23-27">Matta8:23-27</ref>; <ref loc="LUK 8:22-25">Luka8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />A farɗi tsǝna figrha hai, ndanggǝn fatsahayighǝn, “Tama pǝm wuri aamɗa ɗǝ ya.” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Mal fiya nda a samarha, wii nda ɗǝ tǝghǝn ahu kombuwol ɗi nanǝn sǝ. Na fingya kombuwalya sǝ ƙǝm a mbǝɗi mbuwa samadghǝn. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Thliigha ɓereu ˈyaara ɓa, nagha a pǝshang aama ahu kombuwol ndan ɓa takhka a timnda hai. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yeeso a ɓeena a samad kombuwol ɗi. Thlengga fatsahayighǝn sǝ ndang ngganda, “Mala, sǝngwa takh ɗǝm a mǝra wa?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Thliigha Yeeso sǝ, yananggǝn ɓereu ɗi, “Nggasu hai! Ishiu!” Isgha ɓereu ɗi, nggasgha mbǝrha hai.<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />Tǝrgha ndanggǝn fatsahayighǝn, “Mani tǝrǝm nun? Ai fǝrƙǝkafekkid nun?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Tǝr ma nda kaan, tsahang mee nda ndan, “Wunniya? Na ɓereurha tǝ kufulla aama fǝrang mamnggirha!”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Ƙǝnang Yeeso niifa na tǝ ǝnkaheerha fa</para>
  <para style="r">(<ref loc="MAT 8:28-34">Matta8:28-34</ref>; <ref loc="LUK 8:36-39">Luka8:36-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Yeeso tǝ fatsahayighǝn ɗǝnda pǝm wuri aamɗa ɗǝ na a chehweed Nggarasina. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Tǝrna Yeeso hai ahu kombuwol ɗi, na niifasǝ tǝ ǝnkaheerha fa, kyaghǝn ɓa a mbǝd ten kwaya hwathla Yeeso nǝn fa. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Niifɗiya nǝn mǝnda ahur kwad mǝrya, mbǝ niifasǝ na mbang ƙǝnang hai ko tǝ wuyiwurra ni wa. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Ƙǝsǝr na nda yakh ƙǝnang nda hai nda harghǝn tǝ sarghǝn tǝ wuyiwurra, amma nǝn ɗahang nda ɗǝ hwasang nggǝn ɗǝɓǝlyina ɗǝ na a sarghǝn. Mbǝ niifasǝ na kanglang na mbang kǝsang hai wa. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Nda yanfaara tǝ fǝɗigrha nǝn naarha aten kwaya, tǝ ten ferya, nagha ahuhwaarha tǝ thleng nda fadghǝn ɗǝ tǝ ferya.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Nanǝn Yeeso ɗǝ inggun, ɗagha ɗǝ ɓǝra hai a mbedghǝn. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Tǝranggǝn uradghǝn sǝ kaan huhwagha ndǝghǝn, “Mana midwa tǝ nggi, Yeeso, Wan Faara Amshi? Hwanni sa hu thlǝm Faara a sǝsenna wa!” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Thlǝk nǝn ndǝn kee ƙǝsǝr ndangga Yeeso, “Kyosǝ a fad niifɗiya, sa ǝnkaheerha!”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Tǝrgha tsahangga Yeeso mee, “Thlǝmwani ƙǝn?”</para>
  <para style="p" vid="MRK 5:9">Ndǝghǝn, “Hangga, ƙǝsǝr nan hangga.” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Nagha a hwan Yeeso a rǝkɗǝ kanda ma mbǝɗi wa.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Na chiɓǝd ƙǝlengarya sǝ a mbǝɗi a lafrha tsau tǝ sar wumnda fa. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Hwangga ǝnkaheeyini Yeeso, “Malang kan ɗan thlǝmad ƙǝlengaryina ɗǝ ya, kyan hur ndan hai.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Nggǝmanggǝn kanda fa, kya nda sǝ a fad niifɗi ɗa nda kyarha ahur ƙǝlengaryina hai. Chiɓǝd ƙǝlengaryini sǝl nda haru kumnggit sǝri, ɗa nda hu wuri aamɗa ɗǝ mǝra nda ɗǝ.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Fa laf ƙǝlengaryini ɗan ndani wupǝri ɗǝ tǝ fingya talya ɗa nda pǝr ǝnɗi katǝragha hai. Ɗagha fiya ɓa, ɓa nda na ǝnɗi katǝragha hai. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Ɓana nda thlǝmad Yeeso ɓa, na niifɗa nda na tǝ ǝnkaheeyina fa, tsau hai, kalɗǝ lukrha fa ngga ɓa hutenggǝn ɓa, tǝr ma nda. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Nafini na a mbǝɗi nagha ǝnɗi katǝragha hai, pǝranggǝn nda kanda ǝnɗi katǝragha hai tǝ niifɗi na tǝ ǝnkahedɗa fa tǝ ƙǝlengaryini ƙǝm.<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />Tǝrgha nafini hwan Yeeso nda a malanggǝn chehweed ndan.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Na Yeeso a kyarha hu kombuwol hai, niifɗi na tǝ ǝnkahedɗa fa hwan Yeeso nǝn a ɗǝgha ɗǝ a samadghǝn.<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />Nggǝmangwa Yeeso fa wa, amma ndanggǝn, “Ɗuwa wureɗǝ ɗa wal nafiwa, pǝrang ǝnɗana kanda ǝnona Chinǝm tǝ haɗonǝn fa.” <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Tǝrgha niifɗi wiigha wureɗǝ ɗǝgha naarha pǝr ǝngya ǝnangna Yeeso a talya kum. Fiya na heu na nda a na ǝnwulteena,<verse eid="MRK 5:20" /></para>
  <para style="s">Nggǝrang Yeeso yibrha wutararha ƙǝfa tǝ ƙǝnang nda nuneefa na faara a ɓang fa</para>
  <para style="r">(<ref loc="MAT 9:18-26">Matta9:18-26</ref>; <ref loc="LUK 8:40-56">Luka8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Nggǝrna Yeeso ɗǝrha pǝm wuri aamɗa ɗǝ tǝ kombuwol, wumngga fiya thlǝmadghǝn ɓa hangga ndǝghǝn ɓalɗǝ a mii wuri aamɗi. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Tǝrgha tal ahur mamngya Ƙǝn hwan Faara sǝ na nda aarha Yayirus, ɓa ɗǝ mbǝɗa ɓa. Nanǝn Yeeso ɓǝrgha hai tǝ waɗedghǝn, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />hwanggǝnǝn, “Wutarad na a mǝra. Niya hwan sa ɓoɓa ɓa ɗǝfang haara teena tǝnǝn ƙǝnda wal yibrha nǝn.”<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />Ɗǝgha Yeeso ɗǝ a samadghǝn. Fiya hangga mbuwa samadghǝn ɗǝ tǝ ƙǝm na nda a ˈyaɓang mbǝrha fa.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Na nuneefa sǝ a mbǝɗi na faara a ɓang nda fa hai hurarha kumkap sǝri. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Sǝsaɗǝ kaan ahar fa fǝr ɗǝfya hangga tǝ ƙǝm ɓǝlang ɗǝ ǝn huharghǝn ɗǝ, a meghedghǝn ˈya kamngga a ƙǝngga amma ƙǝl chikrha. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Sǝknǝn laɓar Yeeso, ɓagha ɓa tǝ man samadghǝn ahur fiya tsuwar kootodghǝnǝn fa, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />ƙǝsǝr numaɗǝ, “A tsuwarɗi kootodghǝn fa kee, niya wal ƙǝnda.” <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />A mbǝɗi tsu kee ishgha farɗi na a ɓang nda fa hai, tǝkƙǝnǝn fa a fadghǝn walɗǝ ƙǝnda ahu sǝsadghǝn.<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />Tsu sǝnangga Yeeso hai na sǝsǝmnda sǝ kyagha ɗǝ a fadghǝn. Kyahargha hai ahur fiya tsakhmee nǝn, “Wunni tsuwargha kootodna fa?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Nggǝmangga fatsahayighǝn, “Nanna fiya a ˈyaɓo mbǝrha fa, nana a tsakhmee, ‘Wun tsuwargha nggi fa?’ ”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Amma nagha Yeeso a ƙǝlarha ɗǝ tǝ wunni ǝnagha kee. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Tǝrgha nuɗi, sǝnnǝn ˈya katǝragha hai tǝghǝn, ɓagha ɓa ɓǝrgha hai a mbedghǝn, nagha fadghǝn a rǝbrha fa ka tǝrǝmnda, pǝrang ƙǝkafek nǝn ˈya katǝragha hai heu. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Ndangga Yeeso nuɗi, “Waana, fǝrƙǝkafekkid wa ƙǝnoɗǝ. Ɗuwaɗǝ hu ɗǝɗemnggirha yibna hu sǝsadwa.”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Yeeso ɓalɗǝ a ndikrha fa kee, ɓagha fingya ɓa a minda ki Yayirus, ndaa nda, “Mǝr wutarad wa, kama nun nggǝr ƙǝtǝlang tǝ malǝmndǝɗa fa?”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Ɗǝfwa Yeeso teena tǝ path nafini wa, ndanggǝn mamnda tǝ Ƙǝn Faara na ngguchit, “A tǝrǝmna wa, furu ƙǝkafek kee.”<verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />Malangwa fiya mbu samadghǝn nda wa, ƙǝl Mbiturus, Yakubu tǝ Yahaya wanman Yakubu. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Ɓana nda minda ki mamnda Ƙǝn Faara ɓa na ngguchit, ƙǝlagha Yeeso fiya a tsǝ teena na nda a tǝrha tǝ huhwaarha kaan. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Kyanǝn sa hai ndanggǝn kanda, “Kama nda nun a tsǝ teena tǝ huhwaarha kaan kee? Mǝrwa wanɗi wa amma nǝghǝn a shiirha.” <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Amma masangganda.</para>
  <para style="p" vid="MRK 5:40">A kwasamadɗi kyang nǝn fiya ƙǝsha hai, tǝranggǝn nda chin wanɗi tǝ man tǝ fa tsahayighǝn na a thlǝmadghǝn, kyagha hu ƙǝnɗa ɗǝ na wanɗa sǝ. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Ƙǝs harghǝnǝn ndanggǝn, “Talita kumi,” ndǝna “Sa wutararha, thliusǝ!”<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Thliigha wanɗa sǝ wiigha hai. Huradghǝn kumkap sǝri. Katǝrana ǝnɗa hai ya kanda heu ǝna ǝnwulteena nda. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Ƙǝs thlǝman ndan nǝn a sǝk niifa ǝnɗiya wa, ndanggǝn kanda a fǝrang ǝnnarhami nda ǝnagha mii.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Karnda Yeeso a Nadzarat</para>
  <para style="r">(<ref loc="MAT 13:53-58">Matta13:53-58</ref>; <ref loc="LUK 4:16-30">Luka4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Malna Yeeso mbǝɗi, ɗǝgha hu talghǝn ɗǝ tǝ fatsahayighǝn a samadghǝn. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Ɓana far yibrha ɓa yi Yahudaya, katǝranggǝn tsaharhaha ahu Ƙǝn Faara na ngguchit, Fiya hangga sǝkka ndǝn ǝna ǝnwulteena na nda, na nda a ndaarha, “Walgha niifɗi ǝnggini a yanggi ya? Tur yanggi sǝnda ni walnǝn, nǝn naarha ǝna ǝnwulteengya kiya?”<verse eid="MRK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 6:3" />“Ndeye, mbǝ kafinta ɗani ya wa? Mbǝ wan Mairamu ni wanmangya Yakubu, tǝ Yisufu, tǝ Yahuda tǝ Siman wa? Wanmanggighǝn nishya mbǝ kulu kǝm tǝ kanda ya wa?” Sǝbgha hur ndan ɗǝ tǝghǝn.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Ndangga Yeeso kanda, “Ƙǝl ahur talghǝn, a pathlang hurfayighǝn tǝ hur mindǝghǝn ndǝn mbuwana annabi wal mamnggirha.” <note caller="*" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="JHN 4:44">Yahaya4:44</ref></char></note><verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />Ənawa Yeeso ǝnwulteena a mbǝɗi wa, ƙǝl haara ɗǝfang nǝn fingya haaya fa, ƙǝnanggǝn kanda. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Fǝrang ɗǝ ǝnwulteena, ka yamid fǝrƙǝkafekkid ndan.</para>
  <para style="s" vid="MRK 6:6">Thlǝn Yeeso kumkap sǝri ɗi</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">Matta10:5-15</ref>; <ref loc="LUK 9:1-6">Luka9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">Tǝrgha Yeeso nagha a wiirha hai tala-tala a tsahang fiya ha; <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />Aah kumkap sǝri ɗa nǝn thlǝmadghǝn ɓa, thlǝn kanda nǝn sǝri-sǝri fǝrang sǝsǝmnda nǝn kanda aten ǝnkaheeya. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Ndanggǝn kanda, “A turɗun ˈya ahu widɗi ya wa ƙǝl sǝsaala kee. A ƙǝsɗun mburodi ha, ko yawarha, ko wuɗǝɓǝla ahu panjakwayinun wa. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Paama pakhma amma ma Kǝsɗun lukrha ha sǝri wa. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Kala minda ˈwanun kyarha sahai tsawama sǝ ƙǝl farɗi mal nun talɗi. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Kala mbǝrha thlǝwa nanda kun fa, nduwa ƙǝm kangwanda thlǝmarha kun fa wa, a naɗun a mal talɗi tinid talɗi na a sarnun pamanɗǝ ka a tsauka ǝn sakhrha aten ndan<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">Luka 10:4-11</char></note><note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">Tar Fathlǝngya 13:51</char></note>. <verse eid="MRK 6:11" /><verse number="12" style="v" sid="MRK 6:12" />Ƙya nda ƙǝshaaɗǝ ɗa nda pǝr laɓar Faara a fiya a malangganda ɗimiyid ndan. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Kyangganda ǝnkaheeya sǝ hangga a tǝ irang fǝɗeerha fiya fa mbuwa wa ƙǝkanglang ƙǝnangganda kanda.” <note caller="*" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">Yakubu5:14</ref></char></note><verse eid="MRK 6:13" /></para>
  <para style="s">Mǝrra Yahaya tǝ Mbaptisma</para>
  <para style="r">(<ref loc="MAT 14:1-12">Matta14:1-12</ref>; <ref loc="LUK 9:7-9">Luka9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Sǝkna Hirdus laɓarɗi ya, ƙǝsǝr thlǝm Yeeso ɗǝɗa ɗǝ inggun. Fingya a ndaarha, “Yahaya tǝ Mbaptisma ni thliigha sǝ hu mǝrra, ndǝghǝnni nanǝn tǝ sǝsǝmnda fa yi ǝna ǝnwuteengya.”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Fingya a ndaarha, “Annabi Ilya ni.”</para>
  <para style="p" vid="MRK 6:15">Ndagha fingya ƙǝm, “Annabi ni, ƙǝla tal ahur annabiya na kaar.”<note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="ft" closed="false">Matta 16:14; Markus 8:28; Luka 9:19</char></note><verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Amma sǝkna Hirdus laɓarɗiya, ndǝghǝn, “Yahaya, niifɗi kyathlangni tenggǝn ɗǝ, thliiɗa sǝ hu mǝrra!” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Ƙǝsǝr Hirdus fǝrɗǝ ngyakhrha a ƙǝsangganda Yahaya, muwanggǝn hu porsǝna ɗǝ. Ənanǝn kee ƙǝsǝr ka Herodiya, nu wanman Filibus, kahang nǝn. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Ƙǝsǝr Yahaya nǝn naarha ndang nda Hirdus, “Kamngwa a kahangga nu wanmuwa wa.”<note caller="+" style="f"><char style="fr" closed="false">6:18 </char><char style="ft" closed="false">Luka 3:19-20</char></note> <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />Herodiya sǝb hurghǝn ɗǝ tǝ Yahaya, na midghǝnsǝ a ɓǝlanggǝn amma mbǝ mbang wa. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Ƙǝsǝr Hirdus nǝghǝn a tǝrǝm Yahaya, nǝn naarha lafghǝn mbǝ midghǝnsǝ a walgha ˈya ndǝn wa, ƙǝsǝr Yahaya ka niifa ni tǝ peɗǝnda ni. A sǝk Hirdus fad Yahaya nǝn ɓillaghǝn fa kaan, ko nanǝn kee nǝn naarha kang thlǝmarha fa. <verse eid="MRK 6:20" /><verse number="21" style="v" sid="MRK 6:21" />A kwasamadghǝn wal kwamana nǝn, a farɗi ǝnana Hirdus wutsǝfayid lǝghǝtta ɓen nggǝttǝghǝn hai, aah nǝn mamnggighǝn ɓa tǝ mamngya sodjaya tǝ fingya mamngya na hu chehhweed Nggalili. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Tǝrgha wutarad Hirdus kyagha ɓa rǝpgha, mbǝnanggǝn Hirdus tǝ ronggighǝn nana nda a hǝb ǝnnarhami.</para>
  <para style="p" vid="MRK 6:22">Ndangga kutǝrɗi wutaradɗi, “Tsahe ˈya na midwa, niya furoƙǝn.” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Nggǝmɗa fa har tǝ aah thlǝm Faara, “Kala ˈya tsakhna niya furoƙǝn ko mberra chehweedna ni!”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Ɗǝgha thlǝmad man ɗǝ, ndanggǝn, “Mani tsahang nda?”</para>
  <para style="p" vid="MRK 6:24">Ndangga man, “Ten Yahaya tǝ Mbaptisma.”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />A mbǝɗi kee thliigha ƙǝkar a thlǝma kutǝra ɗa ɗǝ ndanggǝn, “Na minnasǝ nanǝnya ten Yahaya tǝ Mbaptisma ahu pǝlee.”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Tǝrgha mǝrgha fad kutǝrɗa hai, amma ka ɗǝf miighǝn ǝnanǝn a mbed ronggighǝn, nggǝmngwa fa a hwasanggǝn wa. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Tǝrgha thlǝn sodja nǝn ɗǝgha ɓarha ɓa tǝ ten Yahaya. Ɗǝgha ƙǝn porsǝna ɗǝ kyathlanggǝn ten Yahaya hai; <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />ɓagha ɓa tǝ ten Yahaya ahu pǝlee fǝranggǝnǝn wutaradɗa ɗǝ, wutaradɗi ƙǝm fǝranggǝnǝn man ɗǝ. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Sǝkna fatsahaya Yahaya ǝnɗi katǝragha hai, ɓa nda ɓa tǝrang ngganda merreghǝn hai pangganda.<verse eid="MRK 6:29" /></para>
  <para style="s">Hǝɓang Yeeso nafiya haru kumnggit tuf</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matta14:13-21</ref>; <ref loc="LUK 9:10-17">Luka9:10-17</ref>; <ref loc="JHN 6:1-14">Yahaya6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Fathlǝngya Yeeso wuma nda thlǝmadghǝn ɓa, pǝrang ǝnggina nda heu ǝnana nda tǝ tsahan ndan ha. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Tǝrgha, ƙǝsǝr ka nana fiya hangga na a ɓarha ɓa tǝ fingya a wiirha wal wa Yeeso tǝ fa tsahayighǝn kwaman ǝna ˈya mii wa. Ndanggǝn kanda, “Taama a mbǝrha ɗǝ mbuwana fiyasǝ ƙǝm katen nǝm ɗun yibrha.” <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Tǝraa nda hu Kombuwol hai katendan ɗǝnda mbǝrha ɗǝ mbuwana fiya sǝ.<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />Amma fiya hangga nagha kanda a wiirha, kukwalangganda kanda hai ɗa nda ɗǝ tǝ saara tǝ hur talya heu ˈwaa nda mbǝɗa ɗǝ ma kanda. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Tǝrna Yeeso hai na fiya nǝn hangga haɗangganda fa, ƙǝsǝr na nda ƙǝla chaukhraya kula tǝ lafrha. Katǝranggǝn tsahang ǝngya kanda ha hangga.<note caller="+" style="f"><char style="fr" closed="false">6:34 </char><char style="ft" closed="false">Ɗeleewar Kirassa 27:17; 1 Kutǝrya 22:17; 2 Laɓarya 18:16; Izikiyel 34:5; Matta 9:36</char></note> <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Tsǝna figrha hai, ɓagha fatsahayighǝn thlǝmadghǝn ɓa, ndang ngganda, “Kaheerha ni mbǝɗiya kulo mbiya tsǝ figrha hai. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Kalu fiya hai tǝna nda ɗǝrha ahu heeya ɗǝ tǝ talya na tsau a mbǝɗiya ɗa nda kaɗa ǝnnarhami tafan ndan.”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Amma ndangga Yeeso kanda, “Kun tafan nun fǝraman ˈya kanda ǝnna ndami lee.” Ndang ngganda, “Wuɗǝɓǝla na ahar nan nǝn sǝl wuɗǝɓel rapathlaarha na nda teng niifa yi ndǝree wuvaɗa! Ɗan heng mburodi kanda ɓa tǝghǝn fǝranggǝnan kanda ǝna nda mii wa?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Tsahangga Yeeso mee kanda, “Mburodi kurmi ni ahar nun? A ƙǝla man ɓa.”</para>
  <para style="p" vid="MRK 6:38">Wuɗa nda ɓa ndang ngganda, “Mburodi tuf tǝ tǝna sǝri.”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Tǝrgha ndangga Yeeso fiya a wumangganda tendang tsawa nda hai aten hwalirha. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Tǝrgha wumangganda tendan tsawa nda hai fingya kumggit tuf-tuf, fingya haru-haru. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Tǝranggǝn mburodi ɗa sǝ tuf tǝ tǝnɗi sǝri, ƙǝlagha talara sǝ, usa Faara nǝn a kyanggǝn mburodi ɗa hai. Fǝranggǝnǝn fatsahayighǝn ndǝghang nggǝnda fiya. Nggǝrghǝn ndǝghang tǝn ɗa hai kowunni walɗǝ. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Əna nda mii heu nggaala nda. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Wumangga fatsahayighǝn katǝpghǝn kutasya kumkap sǝri heu tǝ tǝnɗi. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Hang nda hǝshya ǝnagha mburodi ɗa mii haru kumggit tuf ni.<verse eid="MRK 6:44" /></para>
  <para style="s">Yeeso wiiɗǝ aten aama</para>
  <para style="r">(<ref loc="MAT 14:22-33">Matta14:22-33</ref>; <ref loc="JHN 6:16-21">Yahaya6:16-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Tsu a kwasamad ǝnɗiya, ndangga Yeeso fatsahayighǝn kya nda ahu kombuwol hai ˈwaa nda mbeeɗǝ tǝɗangganda wuri aamɗi teena a Mbatseda ɗe, ndǝghǝnggi ƙǝm kal fiya nǝn hai. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />A kwasamadɗi kal nǝn fiya hai tǝrgha wumnda sǝ ka ɗǝgha hwan Faara.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />Tsǝna figrha hai, kombuwolɗi a maɗufu wuri aamɗi, ndǝghǝn katenggǝn aten chehweerha. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Ƙǝlagha Yeeso hai fatsahayighǝn ahu ɓillaarha kaan, ƙǝsǝr ɓereurha a tsang hura kanda fa ahar tsar, ɗǝgha thlǝmad ndan ɗǝ, nagha a wiirha aten wuri aamɗi. Tsǝgha ƙǝla nǝn a mbǝrang kanda hai. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Amma nana ndan a wiirha aten wuri aamɗi. Huhwaa nda ka hǝreenga, tamngganda ndaarha mǝnda-mǝnda ni. Huhwaa nda, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />ƙǝsǝr kanda heu nandan tǝr ma nda. Inanggǝn mighǝn hai ƙǝkar ndanggǝn kanda, “Ƙǝrsaama, nggini. A tǝrǝmɗun wa.” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Tǝrgha kyagha ahur kombuwol ɗa hai tǝ kanda, nggasgha ɓereu ɗa hai. Ƙǝsgha ǝnwulteena kanda, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />ƙesǝr ɓalgha nda kula sǝnang ǝnwulteena ɗa hai ǝnana Yeeso aten mburodi ɗi, ƙǝsǝr ka kakrakkit tendan. <verse eid="MRK 6:52" /><verse number="53" style="v" sid="MRK 6:53" />Tǝɗang nanda wuri aamɗi teena, sǝla nda Djanisǝrat ɗǝ, ƙǝnangganda kombuwol ndan hai. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Kyana nda sǝ ahur kombuwol ɗi, kukwalangga fiya Yeeso hai. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Ɗa nda hai ahu chehwedɗi kahad na nda a ɓarha ɓa tǝ haaya ahu ɗǝnggǝlya kala mbǝrha sǝknanda na Yeeso sǝ. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Kala mbǝrha ɗǝna Yeeso sa ɗǝ, hu talya tǝ wupǝri tǝ kaheeya na nda hunang haaya hai hu kasu hwanggǝnda a tsuwar pǝpǝshaprha kaɓadghǝn nda fa. Kala niifa tsuwargha ndǝn fa wal ɗǝ ƙǝnda.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Tsahad Yeeso ha aten pǝpedyid hura</para>
  <para style="r">(<ref loc="MAT 15:1-9">Matta15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Farɗa sǝ ɓagha fingya Farisaya tǝ famalǝmngya ngyakhrha a Urshalima ɓa, wuma nda thlǝmad Yeeso ɓa. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />Ƙǝla nda hai fingya fatsahaya Yeeso kanda a hǝb ǝnnarhami haryi ndan tǝ “Paarha”, ndǝna haryi ndan kula tsaɓrha ɗǝ.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />Ƙǝsǝr Farisaya tǝ Yahudaya mba nda hǝb ǝnnarhami kanda kula tsaɓang har ndan ɗǝ wa, ƙǝs nda ǝntin shingya ha. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Nǝghǝn kee ƙǝm mba nda kii ˈya hiina nda ɓa ahu kasu wa ƙǝl tsaɓang na nda haryi ndan ɗǝ ˈwan. Na ǝntingya sǝ ƙǝm hangga na nda lafrha, ƙǝla tsab ɗengya tǝ ɓǝǝya tǝ tasaukya tǝ ɓaleeya tǝ ǝnfuya.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Tǝrgha Farisayini tǝ famalǝngya ngyakhrha tsahang mee nda Yeeso, “Kama mbuwana fatsahayiwa takkwa ǝntin shingginǝm, na nda a ǝna ˈya mii tǝ har paaya?” <verse eid="MRK 7:5" /><verse number="6" style="v" sid="MRK 7:6" />Nggǝmangga Yeeso kanda, Kun fa thlǝrɓuya! A ten nun ni thlǝkna annabi Ishaya pathɗiya, ƙǝla nanǝn chichireethlee hai tǝ ndaarha,</para>
  <para style="q1" vid="MRK 7:6">“‘Nafiniya, ahu mii ndan ni kee na nda fǝre mamnggirha,</para>
  <para style="q2" vid="MRK 7:6">amma hur yi ndan nǝghǝn inggun ma nggi;<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />ka ni kee na nda a tǝree shilee teena,</para>
  <para style="q2" vid="MRK 7:7">ƙǝsǝr ɗǝfangganda tsahad ǝntina a mbee,</para>
  <para style="q2" vid="MRK 7:7">ma ˈya ndana Faara.’”<note caller="*" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="ISA 29:13">Ishaya29:13</ref></char></note><verse eid="MRK 7:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />“Malanggun ˈya ndana Faara ƙǝs ǝntina nun ha ǝnana chichiyi nun.”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Ndanggǝn kanda, “Kar ngyakhrha Faara nun fa ka a laf ngyakhrha ǝntin chingginun nun! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Ƙǝsǝr ndagha Musa, ‘Fǝrang mamnggirha nda muwa tǝ tsu,’ tǝ ƙǝm, ‘Kala niifa ˈyargha chin nduwa man na nda ɓǝlang nda.’ <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Amma nduwun, a ndang niifa chin nduwa man, ‘ˈYa niya kya ɗang nda kunsǝ, ˈwaɗi teena ɗǝfangɗi ndǝn Faara ɗǝ,’ <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />tǝrgha mbun malang niifɗiya ɗanggǝn chin sǝ nduwa man wa. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Tsawanggun laɓar Faara mbǝ ˈya ni na ngga wa, ka ǝntin ngginun. Nun naarha ǝna ǝngya kee hangga.”<verse eid="MRK 7:13" /></para>
  <para style="s">ˈYa na tsawang nda niifa tǝ ɗimiyirha fa a mbed Faara</para>
  <para style="r">(<ref loc="MAT 15:10-20">Matta15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Fiya wumngga hai nggǝrgha Yeeso aah kanda thlǝmadghǝn ɓa, ndanggǝn kanda, “Keema thlǝmarha fa kun heu, a sǝn ǝnɗanun ya. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />ˈYa na a ƙǝshi kyagha hur niifa ɗǝ mbǝ ndǝna tsawang tǝ paarha wa, amma ƙǝl ˈya na a kyarha sǝ ahurghǝn ndǝna tsawang nda tǝ paarha fa. <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Yi na tǝ thlǝmad sǝkrha sǝkƙǝnǝn.”<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />A kwasamadɗi malna Yeeso fiya kyanǝn hur minda hai, fatsahayighǝn tsahang mee nda ha aten karapu ɗi ya. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Tsahangga Yeeso mee kanda, “Sǝnanggun hai wa? Mbun a naghǝn wa ˈya kyagha hur niifa ɗǝ a ƙǝshi mbǝ ndǝna tsawang nda tǝ paarha fa wa? <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Ƙǝsǝr kyawa ahurghǝn hai wa amma ahu mbǝbǝlǝmndǝghǝn ɗǝ, nggǝrghǝn kyarha sǝ a fadghǝn.” (Thlǝk nǝn pathɗiya a kyad ndaarha nǝn ǝnnarhami heu na nda ngga.)<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Ɗǝgha mbeeɗǝ tǝ ndaarha, “ˈYa na a kyarha ɓa ahur niifa ndǝna tsawang nda tǝ ‘paarha fa’. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Ƙǝsǝr ahur niifa sǝ, ndǝna numad ǝn mbǝlfeeya kyarha ɓa, susuwayirha, ngaara, ɓǝl farha, kulafayirha, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />kwit hura, mbǝlfeerha, nggaɓarha, suna, sǝrǝkkirha, sǝb thlǝma, nggǝm alteena, tǝ yamid huteena. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Ən mbǝlfeeyini na heu ya na nda kyarha sǝ ahur niifa; nǝn tsawang niifa ‘ɗimirha.’ ” <verse eid="MRK 7:23" /><verse number="24" style="v" sid="MRK 7:24" />Tǝrgha Yeeso mal Nggalili nǝn ɗǝgha hu chehweed Taya ɗǝ tǝ Sidon. Kyagha hur minda hai mbǝ midghǝn sǝ a sǝngga fiya sǝ wa, amma mbǝ mbang ɓǝɓeng ɓadghǝn ɓa wa. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />A mbǝɗi kee, nuneefa sǝ na wutaradghǝn tǝ ǝnkaheerha fa, sǝknǝn laɓar Yeeso ɓagha ɓa ɓǝrgha hai a mbedghǝn. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Nuɗi tǝ Helenarha ni, nggǝtgha ndan a Fǝnikiya a chehweed Suriya. Hwan Yeeso nǝn a kyanggǝn ǝnkaheedɗa sǝ a fad wutaradghǝn.<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />Ndangga Yeeso, “Malang wundakhnaya ˈwan nggaala nda, ƙamngwa tǝranggǝm ǝnnadmid wundakhnaya fǝranggǝnǝm wuɗaya wa.”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Ndangga nuɗi Yeeso, “nǝghǝn kee, Chinǝm, amma na wuɗaya ǝna fǝfǝsǝrra ǝnnarhami na a hǝra hai ahar wundakhnaya.”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Ndangga Yeeso, “Ƙǝsǝr ka laɓarɗi kyawa nggǝreena sǝ ya, wiu fayiwa, ǝnkaheedɗi kyaɗa sǝ a fad wutarad wa.”<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Ɗǝgha nuɗi wure ɗǝ ɗǝgha wal wutaradɗi keeghǝn kath hu sǝra, ɗǝkɗa hai tǝ ǝnkaheedɗi.<verse eid="MRK 7:30" /></para>
  <para style="s">Ƙǝnang Yeeso Niifa na teɓeng tǝ tip</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Tǝrgha malgha Yeeso chehweed Taya kyagha tǝ chehweed Sidon tǝ chehweerha na tǝ Talya Kum ɗǝgha wuri aam Nggalili ɗǝ. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Na nafiya sǝ ɓagha ɓa tǝ niifa a Yeeso na teɓeng tǝ ƙǝm mbǝ mbang kaala sǝ wa. Hwanggǝnda a ɗǝfang haara nǝn teena.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />Ɗǝgha Yeeso tǝ teɓeng ɗi man patu ɗǝ ma fiya, panggǝn wan haryighǝn ahu thlǝmadghǝn ɗǝ. Chakh yakhrha nǝn hai, tsuwar sheneu niifɗa nǝn. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Ƙǝlagha Yeeso talara sǝ yibgha fa kaan ndanggǝn, “Ifata!” Ndǝna “Inuɗǝ!”<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />Tǝrgha ingga thlǝmad niifɗa ɗǝ, kwasgha sheneuƙǝn hai nagha a ndikrha fa ngga. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Ndangga Yeeso kanda a pǝrang ndan niifa wa. Amma ndǝghǝn aten yanang kanda, kanda aten pǝrghǝn ɗǝ. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Ƙǝsgha ǝnwulteena fiya kaan na nda a ndaarha, “Ənaɗǝ ǝngya heu ngga, ƙǝnanggǝn teɓengya tǝ fingya mbuwa mbang kalasǝ.”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Yeeso hǝɓang fiya haru kumnggitghǝn faɗa</para>
  <para style="r">(<ref loc="MAT 15:32-39">Matta15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Na farɗa sǝ nggǝrgha fiya wumnda thlǝmad Yeeso ɓa, nanǝn mbǝ ǝnnarhami sǝ ahar ndan wa, aagha Yeeso fatsahayighǝn thlǝmadghǝn ɓa ndanggǝn kanda, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“Na nafini a haɗee fa ya. Ɓeena mahan kanda a thlǝmanna, takhkwa ˈya ahar ndan a ǝna nda mii wa. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />A kal ɗi kanda hai wii nda wureeɗǝ a miirha, ɗǝna nda fǝla hai a kwamana. Ƙǝsǝr ɓagha fingya ɓa a mbǝrha ɓa inggun.”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Ndangga fatsahayighǝn, “Amma ɗǝnǝm wal ǝnnarhami ɓa a yanggi a kahedɗiya na tsǝghang kanda?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Tsahangga Yeeso mee kanda, “Mburodi kurmi ahar nun”?</para>
  <para style="p" vid="MRK 8:5">Ndang ngganda, “Mǝd.”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Ndanggǝn fiya a tsawa nda hweeɗe hai. Haranggǝn mburodiɗa sǝ mǝd, hwan parka Faara nǝn, kyanggǝn hai fǝranggǝnǝn fatsahayighǝn ɗǝ a ndǝghang nggǝnda fiya ɗǝ, ǝna nda kee. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Tǝna sǝ ahar ndan ngguchit ƙǝm, hwan parka Faara nǝn atenggǝn, ndanggǝn fatsahayighǝn a ndǝghangganda ɗǝ. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Ənagha fiya mii nggaala nda. Akwasamadghǝn wumangga fatsahayighǝn kwasamadghǝn kutasya mǝd. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Hǝshya ǝnanda haru kumnggitghǝn faɗa. Kal nǝn kanda hai, <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />kyagha ahur kombuwol hai tǝ fatsahayighǝn ɗǝgha a chehweed Ɗalmanuta ɗǝ.<verse eid="MRK 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Ɓagha Farisaya ɓa katǝrang ngganda tsahang mee Yeeso ha. Ka a ƙǝƙǝrangganda, tsahang mee nda ha a kyad ǝnsakhrha nǝn a talara hai.<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">Matta 12:38; Luka 11:16</char></note> <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Yibgha fa ndǝghǝn, “Mani na nafiya ƙǝshiid weeriya a kaɗa ǝnsakhrha yi wulteena? Niya pǝrang ƙǝkafek kun, mbǝ ǝnsakhrha sǝ nanda a kyatta wa.”<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">Matta 12:39; Luka 11:29</char></note> <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Tǝrgha mal kanda nǝn, wudgha ahur kombuwol hai tǝɗagha man patu ɗǝ.<verse eid="MRK 8:13" /></para>
  <para style="s">Mehen Farisaya tǝ yi Hirdus</para>
  <para style="r">(<ref loc="MAT 16:5-12">Matta16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Fatsahaya Yeeso mbǝɗang ɗǝ kanda ɓawa nda ɓa tǝ mburodi wa, ƙǝl tal ni kee ahur kombuwol ɗi. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Ƙǝsgha Yeeso thlǝmandan ndǝghǝn, “Kwarama tǝ mehen Farisaya tǝ yi Hirdus.”<note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="ft" closed="false">Luka 12:1</char></note><verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Tsǝ laɓara nda atenggǝn a pathlang ndan, ndanda, “Ƙǝsǝr mbuwana mburodi sǝ ahar nǝm.”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Yeeso sǝnang ɗǝ numan ndan hai ndanggǝn kanda, “Kama nun tsǝ laɓara tǝ ndaarha mbǝ mburodi sǝ ahar nun wa? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Kun tǝ yirha mbun a naghǝn wa, tǝ thlǝman nun sǝ mbun a sǝkƙǝn wa? Ɓal wun kula sǝnang hai wa?<note caller="+" style="f"><char style="fr" closed="false">8:18 </char><char style="ft" closed="false">Irmiya 5:21; Izikiyel 12:2; Markus 4:12</char></note> <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Kyang ni mburodi ɗa hai tuf a fiya haru kumnggitghǝn tuf, Kutasya kurmi wumang nun kwasamadghǝn?”</para>
  <para style="p" vid="MRK 8:19">Ndang ngganda, “Kum kap sǝri.”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />Ndangga Yeeso kanda, “Kyang ni mburodi ɗa hai mǝd a fiya haru kumnggitghǝn faɗa, kutasa kurmi wumang nun katǝpghǝn?”</para>
  <para style="p" vid="MRK 8:20">Ndang ngganda, “Mǝd.”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Ndanggǝn kanda, “Sǝnanggun hai wa?”<verse eid="MRK 8:21" /></para>
  <para style="s">Ƙǝnang Yeeso kwamarha a Mbatsaida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Ɓa nda Mbatsaida ɓa, ɓagha nafiya ɓa tǝ kwamarha hwan Yeeso nda a tsuwarghǝnǝn fa. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Ƙǝs har kwamadɗa nǝn kya nda sǝ ma hur talɗi ɗǝnda ƙǝsǝr talɗa ɗǝ. Chakh nǝn yakhrha a yid niifɗa ɗǝ ɗǝfang haara nǝn fa, tsahangga Yeeso mee, “Na ˈya sǝ nana wa?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Ƙǝlagha sǝ ndǝghǝn, “Nggi a na fiya, na nda ƙǝla ɗǝfya a wiirha hai.”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Nggǝrgha Yeeso ɗǝfang harghǝn a yid niifɗa ɗǝ. Tǝrgha ingga yidghǝn ɗǝ, nggǝrgha yidghǝn ɓa, nagha a ƙǝlarha ɗǝ ngga. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Wuɗangga Yeeso wureeɗǝ, ndanggǝn, “A nanna a wutta wureeɗǝ a kyanna hur talɗa hai ya wa.”<verse eid="MRK 8:26" /></para>
  <para style="s">Mbiturus fǝrɗǝ ƙǝkafek Yeeso ndǝna Ƙǝrǝsti</para>
  <para style="r">(<ref loc="MAT 16:13-20">Matta16:13-20</ref>; <ref loc="LUK 9:18-21">Luka9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Yeeso tǝ fatsahayighǝn ɗǝnda hu talya ɗǝ a Kaisariya Filibi. Nana nda a wiirha hu kwamana tsahangga Yeeso mee fatsahayighǝn, “Na fiya a ndaarha wunni nggi?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Ndang ngganda, “Fingya a ndaarha Yahaya tǝ Mbaptisǝma, fingya a ndaarha Ilya ni, fingya a ndaarha ƙǝm, nǝghǝn tal ahur annabiya.”<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Ndangga Yeeso kanda, “Amma kun wu, nuwun a ndaarha wunni nggi?”</para>
  <para style="p" vid="MRK 8:29">Ndangga Mbiturus, “Sani Ƙǝrǝsti.”<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">Yahaya 6:68-69</char></note><verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Ƙǝsgha Yeeso thlǝmandan a pǝrang ndan niifa tǝ wunni ndǝghǝn wa.<verse eid="MRK 8:30" /></para>
  <para style="s">Thlǝk Yeeso kwaman mǝrrǝghǝn</para>
  <para style="r">(<ref loc="MAT 16:21-28">Matta16:21-28</ref>; <ref loc="LUK 9:22-27">Luka9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Katǝranggǝn tsahang kanda ha tǝ ndaarha Wan niifa tǝtani a sǝsaagha aten ǝngya hangga, na shingya, tǝ mamnda firistaya, tǝ famalǝmngya ngyakhrha a karghǝn fa, nanda a ɓǝlang nda akwasamad ɓeena mahan nǝn a nggǝr thliirha sǝ. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Thlǝkƙǝn pathɗiya a pǝpal.</para>
  <para style="p" vid="MRK 8:32">Ɗǝgha Mbiturus tǝghǝn man patu ɗǝ ndanggǝn mǝmǝlwa nagha a thlǝk ˈya kiya wa.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />Amma kyahargha Yeeso hai ƙǝlanggǝn fingya fatsahayighǝn ɗǝ yanaggǝn Mbiturus, ndǝghǝn, “Nduwu hai tǝ nggi sa Sheetan, mba a ƙǝlang ǝngya na mid Faara wa, amma ǝngya kee na mid fiya.”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Tǝrgha aah fiya nǝn thlǝmadghǝn ɓa heu tǝ fatsahayighǝn ndanggǝn kanda, “Ana mid niifa sǝ mbu samanna nǝn malanggǝn nggǝm altenggǝn tǝranggǝn kaɗidghǝn sǝ, mbu samadna nǝn.<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="ft" closed="false">Matta 10:38; Luka 14:27</char></note> <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Ana mid niifa sǝ ɗǝf yiɓǝdghǝn ɗǝ nǝn ƙǝɗeng nda. Amma kala niifa fǝrgha yiɓǝdghǝn ka nggi tǝ yi laɓarɗi na mbǝnggǝn ya ɗǝfang nǝn ɗǝ.<note caller="+" style="f"><char style="fr" closed="false">8:35 </char><char style="ft" closed="false">Matta 10:39; Luka 17:33; Yahaya 12:25</char></note> <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Ma chighang nǝn niifa a walɗǝ ǝn ƙǝshiirha heu ƙǝɗenggǝn yiɓǝdghǝn? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Nduwa ƙǝm mana niifa fǝra a meghed yiɓǝdghǝn? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />A shiɗangwa niifa tǝ laɓarna ahu ƙǝshiid kulafayirha tǝ ɗimiyirha wa, Nggi, na Wan Niifa, mbǝ shiɗeerha ka ndǝghǝn wa a ɓaɗǝ hu mamnggit Chin ɓa tǝ yi fathlǝngya Faara tǝ peɗǝnda.”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Tǝrgha ndanggǝn kanda, “Niya pǝrang ƙǝkafek kun, na fingya sǝ ƙǝkǝt a mbǝɗiya nanǝnya mba nda a taarang mǝra fa wa na nda a naa Kutǝryid Faara ɓayi tǝ sǝsǝmnda mamnggitghǝn.”<verse eid="MRK 9:1" /></para>
  <para style="s">Kyaharra fad Yeeso hai</para>
  <para style="r">(<ref loc="MAT 17:1-13">Matta17:1-13</ref>; <ref loc="LUK 9:28-36">Luka9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Akwasamad ɓeena mikki tǝrangga Yeeso Mbiturus tǝ Yakubu tǝ Yahaya tǝraa nda wumnda sǝ, kanda katendan. A mbǝɗi kyahargha fadghǝn hai a mbed ndan. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Lukkighǝn kyakhra nda hai pǝpet, pǝpettǝghǝn kalɗǝ mbǝrha mu hu ƙǝshidɗiya. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Tǝrgha kyagha nda Ilya ɓa tǝ Musa katǝrang ngganda ndikrha hai tǝ Yeeso. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Ndangga Mbiturus Yeeso, “Mala, nǝghǝn ngga nanǝm a mbǝɗiya, ngwa ǝna chama nan mahan-tal yiwa, tal yi Musa tǝ ƙǝm tal yi Ilya.” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Sǝngwa ˈya nǝn a thlǝkrha, ƙǝsǝr kanda heu tǝrǝmnda kaan.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Tǝrgha ɓagha hashbe ɓa nggǝlanggǝn kanda, sǝk urarha nda hai ahur hashbiɗi tǝ ndaarha, “Waana niya, nggǝmni. Kaman thlǝmarha fa!”<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">2 Mbiturus 1:17-18</char></note> <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />Kula sǝndǝndan sǝ, ƙǝla nda hai ko niifa ɓal, ƙǝl Yeeso katenggǝn.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Na nanda a tǝraa hai a wumndǝɗi, ƙǝsgha Yeeso thlǝmandan a pǝrang ndan niifa ˈya na nanda wa ƙǝl ma thlid Wan Niifa sǝ ahu mǝrra.<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />Nanǝn kee ƙǝsghǝnda ha ahur ndan, na nda a ndang nda ndan tǝmani “Thliirha sǝ hu mǝrra.”<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />Tsahang mee nda ha, “Mani na famalǝmngya ngyakhrha ndaarha tǝta Ilya ni a ˈwa ɓaarha ɓa?”<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">Malachi 4:5; Matta 11:14</char></note> <verse eid="MRK 9:11" /><verse number="12" style="v" sid="MRK 9:12" />Ndangga Yeeso kanda, “Ƙǝkafekni, Ilya ni a ˈwa ɓarha ɓa, ka ɓagha tangsang ǝngya ɗǝ heu. Kama nda chireethleng nanda hai Wan Niifa tǝtani a sǝsaagha tǝ ƙǝm karghǝnda fa? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Amma niya ndang nda kun, ɓa Ilya ɓa, ǝnang ǝngya nda fa tǝrna mindan, ƙǝla nanǝn chichirethlee hai atenggǝn.”<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">Matta 17:13</char></note><verse eid="MRK 9:13" /></para>
  <para style="s">Ƙǝnang Yeeso Wundǝlaarha na tǝ ǝnkaheerha fa</para>
  <para style="r">(<ref loc="MAT 17:14-21">Matta17:14-21</ref>; <ref loc="LUK 9:37-43a">Luka9:37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Tǝrnanda hai, ɓa nda wal fingya fatsahaya, ƙǝla nda hai wum fiya thlǝmandan ɓa tǝ famalǝmngya ngyakhrha kanda a ngaala tǝ kanda. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Hǝrǝmna fiya na Yeeso, tǝk mbǝnda nda fa ɗaa nda ɗǝ ɗa nda ndangˈya.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />Tsahangga Yeeso mee fatsahayighǝn, “Mani nun a ngaalang teena tǝ kanda?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Ndagha niifa ahur fiya ɓa, “Mala, ɓoni waana ɓa, nǝghǝn tǝ ǝnkaheerha fa har ˈyaɗang ɗǝ ndikrha fa. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />A thliiɗa ɓa, nǝn muwang hweeɗa hai. Nagha miighǝn a hufrha fa, nagha a ƙǝt miighǝn hwargha fadghǝn ɗǝ. Kalangɗi fatsahayiwa sǝ, amma mbang ngwanda wa.”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Ndangga Yeeso, “Kun wangya ƙǝshiid weeriya fa yamid fǝrƙǝkafekkya, pa kwanɗǝ ni tsaurha tǝ kun? Pa kwanɗǝ ni naarha tǝ kun? Ɓee wanɗa ɓa.”<verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />Ɗang wanɗa nda ɗǝ. Nana ǝnkaheedɗi Yeeso, muwanggǝn wundǝladɗi a hweeɗa hai nagha fadghǝn a rǝprha fa tǝ miighǝn a hufrha hai.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />Tsahangga Yeeso mee chin wundǝladɗi, “Ɓeena kurmi ndǝghǝn tǝghǝn kiya?”</para>
  <para style="p" vid="MRK 9:21">Ndagha chin wanɗi, “Ka ndǝghǝn ngguchit. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Na ǝnkaheedɗi naarha muwang hu waarha hai tǝ aama ka a ɓǝlanggǝn. Amma a nanna a mbangnda a haɗowan fa ɗang kansǝ.”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Ndagha Yeeso, “‘A nanna a mbangnda’? ˈYa na heu nǝghǝn pǝpa a fad niifa fǝrgha ƙǝkafek.”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Ƙǝkar ndagha chin wanɗi, “Fǝrɗi ƙǝkafek, amma ɗeesǝ tǝna fǝrƙǝkafekkid na chikrha!”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Ƙǝlana Yeeso hai fiya a ɗaarha ka ƙǝlarha ɓa, yananggǝn ǝnkaheedɗi, ndanggǝn, “Sǝsǝn teɓeng tǝ tip, ndoyi kyosǝ a fad wanɗiya a Nggǝrna kyarha fadghǝn hai ɓalwa!”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Tǝrgha ǝnkaheedɗi huhwaagha nagha wanɗi a tsǝˈya fa kaan a kyagha sǝ. Tsauka wanɗi kǝla mǝrra, kowunni a ndaarha, “Mǝrɗǝ.” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Amma ƙǝsgha Yeeso harghǝn sǝ, thliigha sǝ ƙǝt.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />A kwasamadɗi kyana Yeeso wure hai, tsahangga fatsahayighǝn mee ɓǝɓee, “Mani mbangwa nan kyang ǝnkaheedɗa sǝ?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Ndangga Yeeso kanda, “Tur yanɗiya ƙǝl tǝ hwan Faara ndǝnǝn kyarha sǝ.”<verse eid="MRK 9:29" /></para>
  <para style="s">Nggǝr Yeeso ndikrha aten mǝrrǝghǝn</para>
  <para style="r">(<ref loc="MAT 17:22-23">Matta17:22-23</ref>; <ref loc="LUK 9:43b-45">Luka9:43b-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Yeeso tǝ fatsahayighǝn malangganda mbǝɗi kya nda tǝ Nggalili. Mbǝ midghǝn sǝ a sǝngga fiya mbǝɗi nanǝn sǝ wa, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />ƙǝsǝr nǝghǝn a tsahang fatsahayighǝn ha tǝ ndaarha, “Wan Niifa na nda a fǝrghǝn ahar nafiya hai. Na nda a ɓǝlang nda. A kwasamad ɓeena mahan nǝn a nggǝr thliirha sǝ.” <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Amma sǝnangwanda tsahadɗa ha keeghǝn ya wa, kanda ƙǝm a tǝrǝm tsahang mee.<verse eid="MRK 9:32" /></para>
  <para style="s">Wunni Manggǝn?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Matta18:1-5</ref>; <ref loc="LUK 9:46-48">Luka9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Ɓa nda Kafarnahum ɓa, nana nda ahur minda, tsahangga Yeeso mee kanda, “Mani nun a ngaalang teena a kwamana?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />Amma nggasa nda hai tǝtip ƙǝsǝr a kwamana na nda a ngaala aten wunni manggǝn.<note caller="+" style="f"><char style="fr" closed="false">9:34 </char><char style="ft" closed="false">Luka 22:24</char></note><verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />Tsauka Yeeso hai, aah kumkap sǝri ɗanǝn ɓa, ndanggǝn kanda, “Kala niifa na midghǝn sǝ a tsauka a mbee, tǝtani tsauka a samaarha heu tǝ mafad kowunni.”<note caller="+" style="f"><char style="fr" closed="false">9:35 </char><char style="ft" closed="false">Matta 20:26-27; 23:11; Markus 10:43-44; Luka 22:26</char></note><verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />“Tǝranggǝn wundakhnee ɓa ishanggǝn a maɗufun ndan. Ƙǝs harghǝnǝn ndanggǝn kanda, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />Kala niifa thlǝgha wundakhnee fa ngguchit ƙǝla yanɗiya ahu thlǝmna thlǝnǝn nggi fa, tǝ ƙǝm kala niifa thlǝgha nggi fa thlǝnǝn Pǝpa fa thlǝngga nggi ɓa.”<note caller="+" style="f"><char style="fr" closed="false">9:37 </char><char style="ft" closed="false">Matta 10:40; Luka 10:16; Yahaya 13:20</char></note><verse eid="MRK 9:37" /></para>
  <para style="s">Kala niifa mbuwa tsan ƙǝm yinǝm ni</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luka9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Ndangga Yahaya Yeeso, “Mala, na ɗan niifa a kyang ǝnkaheeya sǝ tǝ thlǝmwa, yanang ɗan ƙǝsǝr mbǝ ahur nǝm wa.”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Ndangga Yeeso, “A yanang ɗun wa, ƙǝsǝr kala niifa ǝnagha ǝnwulteena tǝ thlǝmna akwasamadghǝn mbǝ thlǝk ǝngya mbuwa ngga atenna wa. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Kala niifa mbuwa tsan ƙǝm, yinǝm ni.<note caller="+" style="f"><char style="fr" closed="false">9:40 </char><char style="ft" closed="false">Matta 12:30; Luka 11:23</char></note> <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Niya pǝrang ƙǝkafek kun, kala niifa fǝrangga aam saarha kun ko ahu wuhuleurha tal ahu thlǝmna ƙǝsǝr ka tsaunun yina mbǝ tam ƙǝɗeng wal ƙǝnaghǝn wa.<note caller="+" style="f"><char style="fr" closed="false">9:41 </char><char style="ft" closed="false">Matta 10:42</char></note><verse eid="MRK 9:41" /></para>
  <para style="s">Ɗimiyirha tǝ fǝrƙǝkafek</para>
  <para style="r">(<ref loc="MAT 18:6-9">Matta18:6-9</ref>; <ref loc="LUK 17:1-2">Luka17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“Ana niifa sǝ kyangga tal ahur wangginiya hu ɗimiyirha hai, A nggushi waghang nda fǝn hǝrha ura mughang ngganda ahu wuri aama ɗǝ. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Ana harwa a kyorha hu ɗimiyirha hai, kyathlang ɗǝ, a nggushi kyana hu kutǝryid talara ɗǝ tǝ haara tal ma kyana hu waarha ɗǝ mbuwa mǝra hai tǝ haara sǝri. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />A mbǝɗi waya na naarha kii kanda mba nda mǝra wa, wadɗi ƙǝm mba nda mbang ɓǝlang hai wa.<note caller="+" style="f"><char style="fr" closed="false">9:44 </char><char style="ft" closed="false">Matta 5:30</char></note> <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Ana sarwa a kyorha hu ɗimiyirha hai, kyathlang ɗǝ. A nggushi kyana hu kutǝryid talara ɗǝ tǝ saara tal ma kyana hu waarha ɗǝ tǝ saara sǝri. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />A mbǝɗi waya na naarha kii kanda mba nda mǝra wa, wadɗi ƙǝm mba nda mbang ɓǝlang hai wa. <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Ana yidwa kyorha hu ɗimiyirha hai, ƙǝɗang ɗǝ. A nggushi kyana hu kutǝryid talara ɗǝ tǝ yirha tal ma kyana hu waarha ɗǝ tǝ yirha sǝri.<note caller="+" style="f"><char style="fr" closed="false">9:47 </char><char style="ft" closed="false">Matta5:29</char></note> <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />A mbǝɗi,</para>
  <para style="b" vid="MRK 9:48" />
  <para style="q1" vid="MRK 9:48">‘Wayini na kii kanda mba nda mǝra wa,</para>
  <para style="q2" vid="MRK 9:48">wadɗi ƙǝm mba nda mbang ɓǝlang hai wa.’”<note caller="+" style="f"><char style="fr" closed="false">9:48 </char><char style="ft" closed="false">Ishaya66:24</char></note><verse eid="MRK 9:48" /></para>
  <para style="b" />
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />“Kala niifa na nda a tsaɓang nda ɗǝ tǝ waarha ƙǝla na nda tsaɓang sataka ɗǝ tǝ fǝsa.” <note caller="*" style="x"><char style="xo" closed="false">9:49 </char><char style="xt" closed="false"><ref loc="LEV 2:13">Livitikus2:13</ref></char></note><verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />“Fǝsa nǝghǝn ngga, amma a tǝr mbǝndǝghǝn ɗǝ, tǝma nǝm nggǝr nggǝrang ɓa? Naama tǝ fǝsa fa, tǝ ƙǝm naama ɗǝɗem tǝ ndan,”<note caller="+" style="f"><char style="fr" closed="false">9:50 </char><char style="ft" closed="false">Matta 5:13; Luka 14:34-35</char></note><verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Tsahad Yeeso ha aten ɓǝlla kakhrha</para>
  <para style="r">(<ref loc="MAT 19:1-12">Matta19:1-12</ref>; <ref loc="LUK 16:18">Luka16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Tǝrgha malgha Yeeso Kafarnahum, ɗǝgha chehweed Yahuda ɗǝ tǝ pǝm kufad Urdun. Nggǝrgha fiya naarha wumnda thlǝmadghǝn ɓa, tsahanggǝn kanda ha ƙǝla nǝn tǝ ǝnaarha.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Ɓagha fingya Farisaya ɓa na mindan sǝ a ɗǝfang takthleera nda. Tsahang mee nda ha, ndang ngganda, “Pǝranggǝn kan, ahu ngyahad nǝm mǝmǝlni a kalgha niifa nukkun hai?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Tsahangga Yeeso mee kanda, “Ndagha ɗeleewar Musa ƙǝn?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Ndang ngganda, “Ndagha ɗeleewar Musa a chirethlengga niifa ɗeleewar nǝn nukkun sǝ kalghǝnǝn hai.”<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="ft" closed="false">Ɗeleewar Nggurub Ngwa kumarha24:1-4; Matta5:31</char></note><verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Amma nggǝrangga Yeeso kanda sǝ, ndǝghǝn, “Ka kakrakid tennun ni ndangna Musa kun kee. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Amma a katǝra ǝna ƙǝshiirha, ‘Faara ǝnaɗǝ hǝshneefa tǝ nuneefa.’ <note caller="*" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Katǝrarha1:27</ref>; <ref loc="GEN 5:2">5:2</ref></char></note> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />Ndǝn ǝnagha ndǝn na niifa mal chin tǝ man thlǝthlǝɓanggǝn nukkun fa, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />sǝri ɗi nanda tsau thlu farha tal. Ɓalwanda sǝri ɓalwa, amma tsau nda tal.<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">Katǝrarha2:24</char></note> <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Tsaunǝn kee mbǝ niifa sǝ na ndǝghang ˈya hai wumangna Faara wa.”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Wudnanda hur minda hai, nggǝrgha fatsahayini tsahang mee Yeeso aten laɓarɗiya. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Ndanggǝn kanda, “Kala niifa kalgha nukkun hai kakhka pak ǝnanǝn kulafayirha aten nuɗi. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Nǝghǝn kee ƙǝm, kala nuneefa ndǝkka hai tǝ chimadghǝn, nggǝrghǝn kakh chimarha pak ǝnanǝn kulafayirha.”<note caller="+" style="f"><char style="fr" closed="false">10:12 </char><char style="ft" closed="false">Matta 5:32; 1 Korontiyaya 7:10-11</char></note><verse eid="MRK 10:12" /></para>
  <para style="s">Ɗǝfang Yeeso parka wundakhnaya teena</para>
  <para style="r">(<ref loc="MAT 19:13-15">Matta19:13-15</ref>; <ref loc="LUK 18:15-17">Luka18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Na farɗasǝ ɓagha fiya ɓa tǝ wanggindan ka a ɗǝfangga Yeeso parka kanda teena, amma fatsahayighǝn na nda a yanang kanda. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Amma nana Yeeso ǝnɗi na nda a ǝnaarha, sǝbgha hurghǝn ɗǝ ndanggǝn kanda, “Malaman wundakhnaya na nggun-ngguchit ɓa nda thlǝmanna ɓa, a yanang ɗun kanda wa. Ƙǝsǝr Kutǝryid Faara yi tur ndanni. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Niya pǝrang ƙǝkafek kun, kala niifa thluwawa kutǝryid Faara ƙǝla na wundakhnee ngguchit ǝnaarha wa mbǝ tam kyaarha saɗǝ wa.”<note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="ft" closed="false">Matta 18:3</char></note> <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Tǝrgha tǝranggǝn wanggini a fad pǝniyighǝn sǝ ɗǝfang haara nǝn kanda teena fǝrang parka nǝn kanda.<verse eid="MRK 10:16" /></para>
  <para style="s">Tǝ ƙǝna</para>
  <para style="r">(<ref loc="MAT 19:16-30">Matta19:16-30</ref>; <ref loc="LUK 18:18-30">Luka18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Thliina Yeeso wiirha, ɗagha niifa thlǝmadghǝn ɓa ɓǝrgha hai tǝ waɗedghǝn a mbedghǝn ndanggǝn, “Ka tǝmalǝmnda, ma kamngga tǝta a ǝnee tǝni wal yibrha mbuwa ngwalarha?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Ndangga Yeeso, “Mani na aah nggi ka niifa? Mbǝ ka niifa sǝ wa ƙǝl Faara katenggǝn. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Sǝnna ˈya ndaana ngyakhrha, ‘A ɓǝlna farha wa, a ǝnanna kulafayirha wa, a ngaarna wa, a nggaɓangna niifa fa ka wa, a huk na farha wa, fǝrang mamnggirha nda muwa tǝ tsu,’ ”<note caller="+" style="f"><char style="fr" closed="false">10:19 </char><char style="ft" closed="false">Kyarhaɓa20:12-16; Ɗeleewar nggurub Ngwa Kumarha5:16-21</char></note><verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Ndangga niifɗi Yeeso, “Mala, ka nggi ngguchit lafɗi ngyakhkini ya.”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Ƙǝlangga Yeeso niifɗi tǝ yid nggǝmnda ndanggǝn, “Taho ˈyaha tal kamngga a ǝnana, ɗuwaɗǝ ɗa heng ǝnggiwa ɗǝ heu nana tǝghǝn ha fǝrang wuɗǝɓǝlghǝna fa yamiiya, na wal mbǝd ɗǝfǝdghǝn a talara. Tǝrgha a ɓana ɓa, ɓa mbu samadna.” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />A mbǝɗiya sǝbgha hur niifɗaɗǝ, wiigha tǝ hurghǝn sǝsǝɓa ɗǝ ƙǝsǝr tǝ ƙǝnani kaan.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Kyahargha Yeeso hai ƙǝlagha ɗǝ, ndanggǝn fatsahayighǝn, “Nǝghǝn pǝɗaghǝn a kyagha tǝ ƙǝna ahu kutǝryid Faara ɗǝ!”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Sǝkna Fatsahayini pathɗi kee fǝrang ǝnwulteena nǝn kanda. Amma nggǝrgha Yeeso ndang kanda, “Wanggina, nǝghǝn pǝɗaghǝn kaan, na a kyagha niifa hu kutǝryid Faara ɗǝ.<note caller="+" style="f"><char style="fr" closed="false">10:24 </char><char style="ft" closed="false">Pǝɗaghǝn</char><char style="ft" closed="false">Fingya chireelthya yi kaar chik ndan tǝ “tǝƙǝna” nduwa “yanɗi mbǝrsagha tǝ ƙǝna.”</char></note> <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Nǝghǝn pǝpa a kyagha thlǝkhmu ɗǝ tǝ kwad libra ma tǝ ƙǝna kyagha hu kutǝryid Faara ɗǝ!”<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Nggǝrgha pathɗi chighang ǝnwulteena fatsahayini na nda a tsahang mee ndan ha, “Anaɗǝ kee wunni a wal hǝrǝkrha?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Ƙǝlangga Yeeso kanda ɗǝ ndǝghǝn, “Niifa tǝ wasa in nǝghǝn pǝɗaghǝn, amma mbǝ tǝ Faara wa, ƙǝsǝr ǝngya heu nǝghǝn pǝpa a fad Faara.”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Tǝrgha ndangga Mbiturus, “Malang ɗan ǝngya heu mbuɗan samadwa.”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Nggǝrangga Yeeso sǝ, “Niya pǝrang ƙǝkafek kun, mbǝ niifa sǝ malangga wurighǝn nduwa wan manggighǝn hǝshya nduwa wan manggighǝn nishya nduwa man nduwa chin nduwa wanggighǝn nduwa heeyighǝn ka nggi tǝ laɓar Faara <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />na ƙǝɗeng wal ƙǝnaghǝn katǝra haru aten, wuraya, wan mangya hǝshya, wan mangya nishya, mangya, waya tǝ kaari-tǝ sǝsaaya. A hu ƙǝshiirha na ɓayi na nda a wal yibrha mbuwa ngwalarha. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Amma fingya ˈwagha kanda ni a nggǝl mee, fingya nggǝlgha mee kanda ni a ˈwaarha.”<verse eid="MRK 10:31" /></para>
  <para style="s">Nggǝr Yeeso thlǝk kwaman mǝrrǝghǝn</para>
  <para style="r">(<ref loc="MAT 20:17-19">Matta20:17-19</ref>; <ref loc="LUK 18:31-34">Luka18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Kanda hu kwaman ɗǝrha Urshalima ɗǝ, Yeeso a mbee, fatsahayighǝn a na ǝnwulteena, fiya na a mbusamad ndan ƙǝm ƙǝsgha hǝreenga kanda. Nggǝrghǝn ɗǝrha tǝ fatsahayighǝn man patu ɗǝ pǝrang ˈya nǝn kanda ɗǝgha katǝrarha hai tǝghǝn. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />Ndanggǝn kanda, “Ɗǝnǝm Urshalima ɗǝ, ɗǝna nda fǝr Wan Niifa a mamnda firistaya tǝ famalǝmngya ngyakhrha. Na nda a ngwang kumad mǝrra fǝranggǝnda fingya mbuwa Yahudaya. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />Na nda a waaghǝn, chahang yakhrha nda fa, tsaɗaghǝn nda, ɓǝlangganda. A kwasamad ɓeena mahan nǝn a nggǝr thliirha sǝ.”<verse eid="MRK 10:34" /></para>
  <para style="s">Hwandǝn nda Yakubu tǝ Yahaya</para>
  <para style="r">(<ref loc="MAT 20:20-28">Matta20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Tǝrgha nda Yakubu tǝ Yahaya wangya Dzabadi, ɓa nda thlǝmadghǝn ɓa ndang ngganda, “Mala, na minnan sǝ a ɗangga kansǝ.”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Tsahang mee nǝn kanda, “Mana minnun a ǝnanggi kun?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Nggǝrangganda sǝ, “A ɗǝd na hu tsǝnggam kutǝryidwa ɗǝ ngwa tsauka tal ahur nan a yisǝmadwa tal ƙǝm a yikawadwa.”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Nggǝrangga Yeeso kanda sǝ ndǝghǝn, “Sǝnggun ˈya nun a hwanda wa! Nun mbang saarha tǝ wuhuleuɗi niya saarha sǝ wa nduwa ǝnang mbaptisǝma nda kun tǝ tur mbaptisǝma ǝneena nda wa?”<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Ndang ngganda, “Haˈi, nan a mbang nda.” Ndangga Yeeso kanda, “Nun a mbang saarha tǝ wuhuleu sanna tǝ ƙǝm ǝnang mbaptisǝma nda kun tǝ tur mbaptisǝma ǝneena nda, <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />amma tsaurha a yisǝmadna tǝ yikawadna mbǝ nggini fǝrghǝn wa. Mbǝyini ya yi fingya ni ngwagha fa.”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Tahad fingya kum sǝknanda kee, sǝbgha hurndan ɗǝ aten nda Yakubu tǝ Yahaya. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Nanǝn kee, aagha Yeeso kanda ɓa heu ndǝghǝn, “Sǝnɗunsǝ fingya tsauka kutǝrya fiya hu ƙǝshidɗiya mbuwa Yahudaya sǝnna nda kanda tǝ kutǝryirha, fingya mamngya ƙǝm kanda ni tǝ sǝsǝmnda ha heu aten fingya na a kamu ndan. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Amma ahur nun nǝn a tsaurha pak. Kala niifa na midghǝn tsauka ndǝghǝnni mamnda tǝta ni tsauka ƙǝla mafad nun.<note caller="+" style="f"><char style="fr" closed="false">10:43 </char><char style="ft" closed="false">Luka 22:25-26</char></note> <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />Kala niifa na midghǝn a nagha a mbee, tǝtani a tsauka mafad kowunni.<note caller="+" style="f"><char style="fr" closed="false">10:44 </char><char style="ft" closed="false">Matta 23:11; Markus 9:35; Luka 22:26</char></note> <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Ko nggini na Wan Niifa, ɓawi ɓa mbǝ ka a ǝnee taara nda wa, amma ka ǝnang taara ni fingya tǝ ƙǝm fǝr yiɓǝd nani a meyed fiya hangga.”<verse eid="MRK 10:45" /></para>
  <para style="s">Ƙǝnang Yeeso kwamarha</para>
  <para style="r">(<ref loc="MAT 20:29-34">Matta20:29-34</ref>; <ref loc="LUK 18:35-43">Luka18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Tǝrgha ɓa nda Djeriko ɓa. Nana Yeeso tǝ fatsahayighǝn heu tǝ fiya na a mbusamad ndan a kyarha sǝ ahur talɗi, na kwamarha sǝ tsau a mii kwamana a hwanda thlǝmnggǝnni Mbartimawus wan Timawus. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Sǝknǝn ndaarha Yeeso tǝ Nadzarat ni na a mbǝraɗǝ, katǝranggǝn huhwaarha hai, “Yeeso! Wan Ndauda! A haɗoyi fa!”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Fiya hangga njarghǝnda, ndang ngganda, “Nggasu hai.”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Sǝkna Yeeso ndǝn, ishgha hai ndǝghǝn, “Ndaman a ɓagha ɓa.”</para>
  <para style="p" vid="MRK 10:49">Aaghǝn nda, ndang ngganda, “No wutsǝfayirha fa, thliusǝ nǝghǝn a aah sa.” <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />Tǝrgha kwamadɗi pǝrgha sǝ, muwanggǝn kootodghǝn ɗǝ, ɗǝgha thlǝmad Yeeso ɗǝ.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Tsahangga Yeeso mee, “Mana midwa a ǝnoyi?”</para>
  <para style="p" vid="MRK 10:51">Ndangga kwamadɗi, “Mala, na minnasǝ a namanani hai.”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Ndangga Yeeso, “Ɗuwaɗǝ, fǝrƙǝkafekkid wa ƙǝnoɗǝ.”</para>
  <para style="p" vid="MRK 10:52">Tsu a mbǝɗi kee na mana nǝn hai mbusamad Yeeso nǝn.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Thlǝd fiya Yeeso fa tǝ wutsǝfayirha a Urshalima</para>
  <para style="r">(<ref loc="MAT 21:1-11">Matta21:1-11</ref>; <ref loc="LUK 19:28-40">Luka19:28-40</ref>; <ref loc="JHN 12:12-19">Yahaya12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Takhna Yeeso tǝ fatsahayighǝn a ndusang Urshalima fa, ɓa nda Mbetafaji ɓa tǝ Mbetani na a Wumngya Ɗǝfya Dzaitun, thlǝngga Yeeso sǝri ahur fatsahayighǝn a ˈwa nda mbeeɗǝ. <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />Ndanggǝn kanda, “Ɗaama ahu talɗa ɗǝ na a mbennun taarha, a kyaɗun sahai, nun a na wan kwaara ƙǝƙǝna hai ˈwawana nanda tǝraa. Kwasaman hai, ɓon ɓa tǝghǝn. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />A tsahang niifa mee kun, ‘kama nun a ǝnaarha kee?’ ndaman, ‘Chinǝm ndagha na midghǝnsǝ nǝn a wuɗang ɓa wed.’ ”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Ɗǝgha fatsahayina ɗǝ ɗa nda wal wan kwarɗi a mii kwamana, ƙǝƙǝna hai a kwatkirma. Na nanda a kwasang hai, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />nafiya na ƙǝƙǝt a mbǝɗi tsahang mee nda kanda, “Ma nun a ǝnaarha, kama nun a kwasang wan kwarɗa hai?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />Pǝr ǝnɗa nda thlǝghangna Yeeso kanda, malangga nafini kanda. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Ɓang wan kwarɗa nda Yeeso ɓa muwangganda parkoyindan a ƙǝsǝrghǝn sǝ. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Fiya hangga lǝlǝɓangganda kootoyindan hai ahu kwamana, fingya kyath shiiya nda ɓa lǝlǝɓangganda hai. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Nagha fiya na a samadghǝn tǝ yi mbedghǝn ahuhwaarha,</para>
  <para style="b" vid="MRK 11:9" />
  <para style="q1" vid="MRK 11:9">“Falama Faara!</para>
  <para style="q2" vid="MRK 11:9">Tǝ parkani niifɗi ɓagha ɓa ahu thlǝm Chinǝm!<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">Dzabura 118:25-26</char></note><verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />Parkani kutǝryidɗi na ɓayi</para>
  <para style="q2" vid="MRK 11:10">yi chichit nǝm Ndauda.</para>
  <para style="q1" vid="MRK 11:10">Falama Faara</para>
  <para style="q2" vid="MRK 11:10">na a talara!”<note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false">Samaila 7:11-14</char></note><verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Ɗǝna Yeeso Urshalima ɗǝ kyagha ahu Ƙǝn hwan Faara ɗǝ. Ƙǝlanggǝn mbǝya heu, amma tsaunǝn hǝm yanfaara hai, kyagha sǝ tǝ fatsahayighǝn ɗǝnda Mbetani ɗǝ.<verse eid="MRK 11:11" /></para>
  <para style="s">Shiwang Yeeso ɗǝf shiɓarha</para>
  <para style="r">(<ref loc="MAT 21:18-19">Matta21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Ɗathna mbǝrha hai na nanda a mal Mbetani, nagha miirha a ƙǝs Yeeso. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Ƙǝla nǝn ɗǝ na ɗǝf shiɓarha nǝn ɗǝ tǝ shee fa, ɗǝgha kamughǝn ɗǝ ƙǝlanggǝn tǝnǝn wal wanggǝn. Ndusang nǝn fa, mbǝ ˈyasǝ wal nǝn a uradghǝn wa ƙǝl shiiya, ƙǝsǝr shifidghǝnni wa. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Tǝrgha ndanggǝn ɗǝfǝdɗi, “A nggǝr niifa kii ɗǝfǝd wa ɓalwa pakwanɗǝ.” Sǝkka fatsahayighǝn ˈya ndanǝn.<verse eid="MRK 11:14" /></para>
  <para style="s">Rǝghang Yeeso fa shafiliya ɗǝ a Ƙǝn Faara</para>
  <para style="r">(<ref loc="MAT 21:12-17">Matta21:12-17</ref>; <ref loc="LUK 19:45-48">Luka19:45-48</ref>; <ref loc="JHN 2:13-22">Yahaya2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Sǝlna Yeeso tǝ fatsahayighǝn a Urshalima ɗǝ, kyagha a pǝpal Ƙǝn Faara ɗǝ ƙatǝranggǝn rǝghang nda nafiya ɗǝ na a ǝna shafili a mbǝɗi. Chaggǝlanggǝn tebǝrya fa mbeɗed wuɗǝɓǝla tǝ kulohod fa heng kataprakkya, <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />mbǝ malang niifa mbǝrgha ɗǝ tǝ ǝn shafili tǝ pǝpal Ƙǝn Faara wa. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Tsahanggǝn kanda ha ndǝghǝn, “Nǝghǝn chichirethlee hai ahu ɗeleewar Faara tǝ ndaarha,</para>
  <para style="q1" vid="MRK 11:17">“‘Ƙǝnna nǝm aaghǝn</para>
  <para style="q2" vid="MRK 11:17">Ƙǝn Faara yi fiya heu.’</para>
  <para style="q1" vid="MRK 11:17">Amma tsawanggun mbǝd ɓǝɓed ngaarya.”<note caller="*" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Ishaya56:7</ref>; <ref loc="JER 7:11">Irmiya7:11</ref></char></note><verse eid="MRK 11:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Mamnda firistaya tǝ famalǝmngya ngyakhrha sǝk nanda ǝnɗi katǝragha hai katǝrang ngganda kaɗa kwamana hai na a ɓǝlangganda. Amma kanda a tǝrǝmnggǝn, ƙǝsǝr fiya heu tsahadghǝn ha nǝghǝn a fǝrang ǝnwulteena kanda.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Tsǝna figrha hai, Yeeso tǝ fatsahayighǝn kya nda sǝ a wupǝri ɗi.<verse eid="MRK 11:19" /></para>
  <para style="s">Tsaharhaha aten shiɓadɗi</para>
  <para style="r">(<ref loc="MAT 21:20-22">Matta21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />A tsar, na nanda a wiirha, na shiɓadɗa nda hwarɗaɗǝ tǝ thlaryighǝn. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Ɗalghǝna Mbiturus ndǝn in ndanggǝn Yeeso, “Mala! Kuloɗǝ! Ɗǝfǝd shiɓadɗi shiwangna na!”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Tǝrgha ndangga Yeeso fatsahayini, “Fǝrama ƙǝkafek a Faara. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Niya pǝrang ƙǝkafek kun, a ndang niifa wumndǝɗi ya, ‘Ɗǝwaɗǝ, ɗa muwang fadwa a wuri aama ɗǝ,’ a ngaal wa ahurghǝn wa amma fǝrɗǝ ƙǝkafek tǝ ndaarha ˈya thlǝknǝn nǝn a katǝrarha hai, nanda a ǝnanggǝn.<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">Matta 17:20; 1 Korontiyaya 13:2</char></note> <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Tsaunǝn kee niya ndang nda kun, kala ˈya na minnun a hwanang ɗun Faara, tǝ ƙǝkafekkirha, nun a walghǝn. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />A naɗun a hwan Faara, ˈwaama teena chahang ɗimiyid ndan nun fingya ɗǝ ǝnangga ɗimiyirha kun fa, tǝna yinun Chiina na a talara chahang ɗimiyid nun kun ɗǝ. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Amma a chakhkun ɗimiyirha wa, mbǝ yinun Chiina na a talara a chahang ɗimiyid nun kun ɗǝ wa.” <note caller="*" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="MAT 6:14-15">Matta6:14-15</ref></char></note><verse eid="MRK 11:26" /></para>
  <para style="s">Mamngya Yahudaya tsahang nda mee Yeeso</para>
  <para style="r">(<ref loc="MAT 21:23-27">Matta21:23-27</ref>; <ref loc="LUK 20:1-8">Luka20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Nggǝrna Yeeso ɓaarha Urshalima ɓa, ndǝghǝn a wiirha hai a pǝpal Ƙǝn Faara, Mamnda firistaya, famalǝmngya ngyakhrha tǝ shingya ɓaa nda thlǝmadghǝn ɓa. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Tsahang mee nda, “Tǝ tur yanggi ngyahadyi na ǝna ǝngginiya, wun furowa kwaman ǝna ǝnɗiya?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Nggǝmangga Yeeso kanda, “Niya tsahang mee kun ha tal. A nggǝreeɗun sǝ, niya pǝranggǝn kun tǝ wun fǝreegha kwamana niya ǝna ǝngginiya. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Wun fǝrangga kwamana Yahaya ǝna mbaptisǝma nǝn? Faara fǝrangga wa, nduwa fiya wa? Pǝreemadghǝn!”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Tǝrgha thliigha ngaala sǝ a pathlang ndan, ndaa nda, “A ndaa ɗǝm, ‘a talara ni hai,’ nǝn a tsakh mee, ‘Kama fǝrangwa nun ƙǝkafek?’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />A ndaa ɗǝm, Fiya fǝrangga.” Na nda a tǝrǝm fiya, ƙǝsǝr sǝn fiya sǝ Yahaya annabini. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Ndang ngganda Yeeso, “Sǝngwan wa.”</para>
  <para style="p" vid="MRK 11:33">Ndangga Yeeso kanda, “Nggi ƙǝm mbi pǝranggǝn kun tǝ wunni fǝreegha ngyakhrha niya ǝna ǝngginiya wa.”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Karapu aten nafiya huɗagha hu hed niifa</para>
  <para style="r">(<ref loc="MAT 21:33-46">Matta21:33-46</ref>; <ref loc="LUK 20:9-19">Luka20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Katǝrangga Yeeso laɓara hai tǝ karapuya, ndǝghǝn, “Na niifa sǝ ǝnagha hed wan ɗǝfya, kanggǝn raa mbǝd ˈyaɗa wan ɗǝfyina nǝn tǝ ƙǝm tǝn mbǝd ƙǝla hedɗa nǝn ɗangkam. Dzǝmanggǝnǝn fahuɗaya ha ɗǝgha hu chehweerha ɗǝ inggun.” <note caller="*" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">Ishaya5:1-2</ref></char></note><verse eid="MRK 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 12:2" />Tsǝna shifirha hai thlǝn mafadghǝn nǝn thlǝmad nafina ɗǝ nzǝmngga hedɗi a ǝnang wan ɗǝfyina nda ha.<verse eid="MRK 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 12:3" />Amma nafini nzǝmngga hedɗi ɗǝghangganda mafadɗa ɗǝ wuɗangganda ko ˈya a harghǝn. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Nggǝrghǝn thlǝnang mafarha kanda ɗǝ, ɗǝkƙǝn nda atenggǝn fǝrang shilee nda.<verse eid="MRK 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 12:5" />Yi mafarha nggǝrnǝn thlǝnda ɗǝ ɓǝlangganda. Ɗǝgha mbeeɗǝ tǝ thlǝn mafayighǝn ɗǝ fingya ɗǝk kanda nda, fingya ɓǝlangganda kanda.<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />“Tahanggǝn ha tal nǝn a thlǝnda, wanggǝn nggǝmnǝn kaan. Thlǝnanggǝn wanggǝn a thlǝmad ndan ɗǝ, ahu numadghǝn, ‘Ɗǝna nda fǝrang mamnggirha waana.’”<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />“Amma ndangga fahuɗayini ndan, ‘Kulo tǝ har langad hedɗi ɓayiya, tama ɓǝlanggǝm tǝna hedɗi tsaurha yinǝm ya!’ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Nanǝn kee, ƙǝsangganda wan ɗa ɓa ɓǝlangganda muwangganda ƙǝshaaɗǝ ma hedɗi.”<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />Tsahangga Yeeso mee kanda, “Ma kamngga a ǝnagha tǝ hedɗi? Nǝn a ɓarhaɓa ɓǝlanggǝn nafina ɗǝ dzǝmngga hedɗi fǝrang hedɗa nǝn nafiya pak. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />ˈWawun karatang ǝnɗiya ahu ɗeleewar Faara wa?</para>
  <para style="b" vid="MRK 12:10" />
  <para style="q1" vid="MRK 12:10">‘Feera karna fa tǝngya</para>
  <para style="q2" vid="MRK 12:10">ndǝn tsauka fer sar ƙǝnna.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Ənɗa ǝnana Faara ya,</para>
  <para style="q2" vid="MRK 12:11">Nadghǝn ǝnwulteena ni.’”<note caller="+" style="f"><char style="fr" closed="false">12:11 </char><char style="ft" closed="false">Dzabura 118:22-23</char></note><verse eid="MRK 12:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Tǝrgha kaɗa kwamana nda na a ƙǝsangganda ƙǝsǝr sǝndasǝ a tendan ni ǝnanǝn karapuɗiya. Amma kanda a tǝrǝm fiya; nanǝn kee malangganda wii fayindan nda.<verse eid="MRK 12:12" /></para>
  <para style="s">Tii tsamnda a Kaisar</para>
  <para style="r">(<ref loc="MAT 22:15-22">Matta22:15-22</ref>; <ref loc="LUK 20:20-26">Luka20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Kanda sǝ, thlǝn Farisaya nda tǝ nafiya Hirdus a thlǝmad Yeeso ɗǝ a ɗǝfang takthleera nda tǝ pathya tǝna nda ƙǝsang nda tǝ pathla ɗimi. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Ɓaa nda thlǝmadghǝn ɓa ndang ngganda, “Mala, sǝnɗansǝ ka niifa ni sa, Sa mba wurahasǝ wa fiya heu yiwa ni, Sa na thlǝk ƙǝkafek. Kamɗǝ ateng tsamnda nan Kaisar wa nduwa awo? <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />A ten wa nduwa awo?”</para>
  <para style="p" vid="MRK 12:15">Amma Yeeso sǝnɗǝ thlǝrɓuyindan, ndanggǝn kanda, “Kama nda nun a ɗǝfee takthleera? Fǝree ma pene ɗa ɓa ƙǝlanggi.”<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />Ɓang pene ɗa nda ɓa, tsahang mee nǝn kanda, “Shishing nda wunni tǝ thlǝm wunni atenggǝn?”</para>
  <para style="p" vid="MRK 12:16">Ndang ngganda, “Yi Kaisar ni.”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Tǝrgha ndangga Yeeso kanda, “Fǝraman ˈya Kaisar tsauka yi Kaisar, a Faara tsauka yi Faara.”</para>
  <para style="p" vid="MRK 12:17">Əna ǝnwulteena nda tǝghǝn.<verse eid="MRK 12:17" /></para>
  <para style="s">Tsakhmee aten thliirha sǝ ahu merra tǝ kakhrha</para>
  <para style="r">(<ref loc="MAT 22:23-33">Matta22:23-33</ref>; <ref loc="LUK 20:27-40">Luka20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Tǝrgha Sadukiyaya ɓa nda thlǝmad Yeeso ɓa kanda ndagha mbǝ thliirha sǝ hu mǝra wa tǝ tsakhmee, <note caller="*" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ACT 23:8">Tar fathlǝngya23:8</ref></char></note> <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />ndang ngganda, “Mala, chireethleng Musa ndǝn kan hai tǝ ndaarha a mǝr wan man niifa mal nuneefa nǝn hai amma kula wundakhnaya, tǝtani a kahangga wan man nuu mǝrɗi ka a nggǝɗang waya nǝn wan mansǝ.<note caller="+" style="f"><char style="fr" closed="false">12:19 </char><char style="ft" closed="false">Nggurub Ngwa Kumaarha 25:5</char></note> <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Nanǝnya na wan mangya sǝ mǝd. Tǝpamǝnda kahanggǝn mǝrgha kula nggǝt wundakhnaya. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Yi sǝri kahanggǝn nu mǝrɗi, amma mǝrgha kula mal wee hai. Nǝghǝn kee ƙǝm tǝ yi mahan. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Kanda heu mǝd kahang nda nuɗi mǝra nda kula kanda mal wundakhnaya hai. A kwasamadghǝn nuɗi ƙǝm mǝrgha. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Nanǝnya, ahu thliirha sǝ hu mǝrra na nuɗi tsaurha yi wun, tsaunǝn nafini mǝd kahang nda?”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Nggǝrangga Yeeso kanda sǝ, ndǝghǝn, “Numad nun mbǝ mǝmǝl wa ƙǝsǝr sǝnggun Laɓar Faara na chichireethlee hai tǝ sǝsǝmnda Mamnggitghǝn wa. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />A far thliirha sǝ hu mǝra, na nda tsaurha ƙǝla fathlǝngya Faara mba nda kakhrha wa. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Nanǝnya aten thlid mǝrya sǝ, a ɗeleewar Musa, karatanggun laɓar nji waarha na a kaheerha ndangna Faara, ‘Nggini Faara yi Ibrahim, tǝ Ishaku tǝ ƙǝm Yakubu’ wa? <note caller="*" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Kyarhaɓa3:6</ref></char></note> <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Ndǝghǝnggi mbǝ Faarani yi mǝrya wa, amma yi fa yibya ni, kun sahadɗun kaan!”<verse eid="MRK 12:27" /></para>
  <para style="s">Ngyakhrha na manggǝn</para>
  <para style="r">(<ref loc="MAT 22:34-40">Matta22:34-40</ref>; <ref loc="LUK 10:25-28">Luka10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Niifa tal ahur famalǝmngya ɗeleewar Musa ɓagha ɓa ɓagha wal kanda a ngaala. Ƙǝlanǝn hai nggǝrang Yeeso kanda sǝ mǝmǝl, tsahang mee nǝn Yeeso, “A hu ngyakhkya heu, yanggini manggǝn?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Ndangga Yeeso, “Yanɗi na manggǝn nǝghǝn kiya, ‘Sǝghamadghǝn, kun Isǝreela! Chinǝm Faarnǝm ndǝghǝnni Chinǝm katenggǝn. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Nggǝmu Chinǝm Faarwa, tǝ hurwa heu, tǝ yiɓǝdwa heu tǝ huten wa heu, tǝ kanglanggid wa heu.’ <note caller="+" style="f"><char style="fr" closed="false">12:30 </char><char style="ft" closed="false">Ngwa Kumarha 6.4</char></note> <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Yi na a takkwaghǝn ndǝna, ‘Nggǝmu tuladwa ƙǝla altenwa.’ Mbǝ ngyakhrha sǝ kalgha finayiniya wa.” <note caller="+" style="f"><char style="fr" closed="false">12:31 </char><char style="ft" closed="false">Livitikus 19.18</char></note><verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Tǝmalǝmnda ɗeleewar Musa ɗi ndanggǝn Yeeso, “Mala, thlǝknan mǝmǝl. Thlǝkna ƙǝkafek ndana Faara tǝtal mbusǝ pak wa.<note caller="+" style="f"><char style="fr" closed="false">12:32 </char><char style="ft" closed="false">Nggurub Ngwa Kumaarha 4:35</char></note> <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Na a nggǝmnggǝ nǝm, tǝ hurnǝm heu, yiɓǝd nǝm heu, tǝ kanglanggid nǝm heu, tǝ kǝm nggǝmu tuladwa ƙǝla altenwa ndǝna manggǝn na nji satakh maɓiya tǝ fingya satakhkya.”<note caller="+" style="f"><char style="fr" closed="false">12:33 </char><char style="ft" closed="false">Hodzaya 6:6</char></note><verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Nana Yeeso kamshiiɗi nggǝrang ɗa sǝ ngga tǝ ndǝdǝlyirha ndanggǝn, “Mbaa inggun tǝ kutǝryid Faara wa.” A mbǝɗi kee nggǝrwa niifa tsahang mee ɓalwa.<verse eid="MRK 12:34" /></para>
  <para style="s">Tsakh Yeeso mee aten Ƙǝrǝsti</para>
  <para style="r">(<ref loc="MAT 22:41-46">Matta22:41-46</ref>; <ref loc="LUK 20:41-44">Luka20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Nana Yeeso a tsaharhaha a pǝpal Ƙǝn Faara, tsakh mee nǝn, ndǝghǝn, “Mani na famalǝmngya ngyakhrha ndaarha Ƙǝrǝsti wan Ndauda ni? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Ndauda tafadghǝn, nanǝn lǝlǝgɗa tǝ Sǝsǝna tǝ Peɗǝnda ndǝghǝn,<note caller="+" style="f"><char style="fr" closed="false">12:36 </char><char style="ft" closed="false">Dzabura 1101</char></note></para>
  <para style="q1" vid="MRK 12:36">“‘Chinǝm ndanggǝn Yina China,</para>
  <para style="q2" vid="MRK 12:36">Tsawu a yisǝmanna</para>
  <para style="q1" vid="MRK 12:36">ƙǝl a tsawangɗi fa tsanggiwa,</para>
  <para style="q2" vid="MRK 12:36">a kamu saryiwa.’”<note caller="+" style="f"><char style="fr" closed="false">12:36 </char><char style="ft" closed="false">Dzabura 110:1</char></note><verse eid="MRK 12:36" /></para>
  <para style="b" />
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />“Ndauda tafadghǝn aaghǝn ndǝn, ‘Chinǝm.’ Ƙǝƙǝn nǝn tsaurha wanggǝn?”</para>
  <para style="p" vid="MRK 12:37">Fiya wumngga hai na nda a kang thlǝmarha fa tǝ wutsǝfayirha.<verse eid="MRK 12:37" /></para>
  <para style="s">Yeeso yanangɗǝ Famalǝngya ngyakhrha</para>
  <para style="r">(<ref loc="MAT 23:1-36">Matta23:1-36</ref>; <ref loc="LUK 11:37-54">Luka11:37-54</ref>; <ref loc="LUK 20:45-47">20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />A hu tsahadghǝn ha, ndǝghǝn, “Kwarama tǝ famalǝngya ngyakhrha. Kanda na mindansǝ kal kaɓaya fa ana nda a wiirha hai a yid fiya tǝ ƙǝm anagha fiya a ndangˈya kanda ahu kasu. <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />Na nda naarha wur mbǝd tsaukya na nggǝngga a ƙǝngya tsahad Yahudaya tǝ mbǝd mbǝnafa. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Na nda naarha huk nu mǝrya ahu wurayindan. Na nda djib hwan Faara tǝna fiya ndaarha ka nafiya ni kanda. Tur nafiniya na Faara sǝsang kanda kaan ma fingya.”<verse eid="MRK 12:40" /></para>
  <para style="s">Fal Yeeso fǝrra nu mǝrra</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luka21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Tǝrgha Yeeso tsauka tsau tǝ mbǝɗi na panjakwadɗa sǝ nagha a ƙǝlang kanda a Ƙǝn Faara. Fa ƙǝnaya hangga fǝr nda wuɗǝɓǝlya manggǝn. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Tǝrgha ɓagha nu mǝrra ɓa tǝ yamirha fǝr yighǝn nǝn anini sǝri.<verse eid="MRK 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43" />Aah fatsahayighǝn nǝn thlǝmadghǝn ɓa, ndanggǝn kanda, “Niya pǝrang ƙǝkafek kun, fǝrrǝɗi kii nu mǝrɗiya kalɗǝ yi fiya heu. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Nafini na heu ya fǝrghanda ahu hangnda ˈya na nanda tǝghǝn ha, amma ndǝghǝn nggi ahu yamidghǝn fǝrɗǝ ˈya na a harghǝn heu.”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Əngya na a katǝrarha hai a mii ngwala ƙǝshiirha</para>
  <para style="r">(<ref loc="MAT 24:1-2">Matta24:1-2</ref>; <ref loc="LUK 21:5-6">Luka21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Na Yeeso a kyarha sǝ ahu Ƙǝn Faara, tal ahur fatsahayighǝn ndanggǝn, “Mala! Ƙǝlang feryini na mǝmanggǝn sakhɗang nanda tǝnggina sǝ ya! Tur tǝngginiya ǝnwulteena ni!”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />Ndangga Yeeso, “Nanna tǝnggini na nggǝngga ya? Nanda a chaggǝnlang kanda hai, mbǝ feera sǝ nanda a malang aten shadghǝn wa.”<verse eid="MRK 13:2" /></para>
  <para style="s">Katǝra sǝsaarha</para>
  <para style="r">(<ref loc="MAT 24:3-14">Matta24:3-14</ref>; <ref loc="MAT 21:7-19">21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Nana Yeeso tsau a mbǝd ɗǝfya Dzaitun kang hura nǝn Ƙǝn Faara fa, Nda Mbiturus, tǝ Yakubu, tǝ Yahaya tǝ Andǝrawus tsahang mee nda Yeeso ha ɓǝɓee, ndang ngganda, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Akwan na ǝnggini a katǝrarha hai ya? Mani ǝn sakhrǝghǝn na a kyat lǝghǝttǝghǝn nǝn?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Ndangga Yeeso kanda, “Kwarama naɗǝ niifa sakhɗang kun. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Fiya hangga na a ɓarha ɓa hu thlǝmna, na nda a ndaarha kanda ni ‘nggi,’ naa nda a sakhɗang fiya hangga. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />A sǝkɗun yangya tǝ fiya a tsǝ laɓar yangya, a tǝrǝm ɗun wa. Tsauɗǝ tǝtani a katǝragha hai, amma mii ngwaladghǝn ɓalɗǝ ˈwan. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Na chehweeya yanda tǝ ndan, kutǝrya ƙǝm na nda yanda tǝ ndan. Na chehweerha a rǝprha fa a mbǝya hangga, tǝ miirha. Əngginiya katǝra sǝsaarha ni ˈwan.”<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />Amma kwarama. Ƙǝsǝr na nda a ɗǝrha tǝ kun mbed mamngya ɗǝ na ahu ƙǝngya tsahad Yahudaya tsaɗa kun nda, tǝ ƙǝm muwangganda kun ahu porsǝna ɗǝ. Nanda a ɗǝrha tǝ kun a mbed ngwamnaya ɗǝ tǝ kutǝrya ka thlǝmna. Ənɗaniya na fǝrang kwamana kun pǝr ƙǝkafek nun atenna. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Laɓarɗi na mbǝnggǝn ya tǝtani pǝrghǝnɗa hu ƙǝshiirha ɗǝ heu. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Amma a ƙǝsang nda kun a ɓillaɗun tǝ ˈya nun a thlǝkrha ka a hǝrghanggun fannun wa. Thlǝghaama ǝnɗi ndangna Faara kun kee, ƙǝsǝr mbǝ kunni na a kaala sǝ wa, amma Sǝsǝna tǝ Peɗǝnda ni.<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="ft" closed="false">Matta 10:17-20; Luka 12:11-12</char></note><verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />“Na wan maana a fǝr wan man ɓǝlangganda, chiina ƙǝm nǝn a fǝr wanggǝn. Wundakhnaya na nda a thleng chinggindan fa ka a ɓǝlangganda kanda. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Na fiya heu a kar kun ƙǝsǝr ka nggi, amma kala niifa ƙǝrǝsgha ta mii ngwalarha ɗǝ nǝn a hǝrǝkrha.”<note caller="+" style="f"><char style="fr" closed="false">13:13 </char><char style="ft" closed="false">Matta 10:22</char></note><verse eid="MRK 13:13" /></para>
  <para style="s">Sǝsaarha na pǝɗaghǝn</para>
  <para style="r">(<ref loc="MAT 24:15-28">Matta24:15-28</ref>; <ref loc="LUK 21:20-24">Luka21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />“Na sayi ɓayi ɓanun naa ‘Ən tsangya na ɓarha ɓa tǝ ndǝkrha hai’ ƙǝt a mbǝrha kamngwa wa. Tǝrgha fingya na a Yahudiya a ɗaarha wumngya sǝ.<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">Ndaniyel 9:27; 11:31; 12:11</char></note> <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Niifa na aten ƙǝnna mbǝ tǝra hai kyagha ƙǝnɗǝ ka a ngwagha fa wa.”<verse eid="MRK 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 13:16" />Niifa na a hee a wudɗǝ ndaagha ɗǝnǝn tǝrang kootodghǝn wa. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Kawa ma nishya na ahur tǝ fingya na tǝ waaya ƙǝsǝr a faryiniya! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Hwanama Faara a katǝra ɗa hai ahu mbiirha wa. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Ƙǝsǝr na sǝsaarha a naarha sǝ kaan ˈwawanda ǝnaarha, ka ǝnana Faara ƙǝshiirha ta hu sayidɗa ɓa ya. Tǝ ƙǝm mba nda nggǝr ǝna turghǝn wa.<note caller="+" style="f"><char style="fr" closed="false">13:19 </char><char style="ft" closed="false">Ndaniyel 12:1; Tar Fathlǝngya 7:14</char></note> <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />A mbǝnana Faara thleng ɓengginiya wa, mbǝ niifa sǝ na takh tǝ yibrha wa. Amma ƙǝsǝr ka nafiyighǝn na wuwura, ndǝn tsang nǝn ɓenggini hwas.<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />“A sayidɗiya a ndon niifa, ‘Kulo Ƙǝrǝsti ya,’ nduwa ‘Kulo ndǝghǝn taarha,’ a kangna thlǝmaarha fa wa. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Ƙǝsǝr na fa nggaɓaya Ƙǝrǝsti sǝ tǝ yi annabiya na a thliirha sǝ ǝna ǝnwuteengya nda ka a sakhɗang ngganda fiya heu tǝ fingya na wuwura yi Faara, a naɗǝ a kya naarha sǝ. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Nanǝn kee, kwarama ƙǝsǝr ˈwaɗi teena pǝrangɗi ndǝn kun.”<verse eid="MRK 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />“A akwasamad sǝsadɗi,</para>
  <para style="q1" vid="MRK 13:24">“‘Na yanfaara a tsaurha wulghǝn,</para>
  <para style="q2" vid="MRK 13:24">ndǝree ƙǝm mbǝgha njaara hai wa.<note caller="+" style="f"><char style="fr" closed="false">13:24 </char><char style="ft" closed="false">Ishaya 13:10; Izikiyel32:7; Djoyel 2:10; 3:4; 3:15; Tar Fathlǝngya 6:12</char></note><verse eid="MRK 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25" />Na wufǝlgaarya a mukrha hai a fǝrakh amshi,</para>
  <para style="q2" vid="MRK 13:25">ǝngya na mǝmanggǝn a talara na nda a tsǝˈyafa.’”<note caller="+" style="f"><char style="fr" closed="false">13:25 </char><char style="ft" closed="false">Ishaya13:10, 34:4; Djoyel2:10; Tar Fathlǝngya6:13</char></note><verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />“A farɗi na fiya a naa Wan Niifa ɓayi ahu hashbe tǝ sǝsǝmnda tǝ mamnggitghǝn.<note caller="+" style="f"><char style="fr" closed="false">13:26 </char><char style="ft" closed="false">Ndaniyel 7:13; Tar fathlǝngya 1:7</char></note> <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Nǝn a thlǝn fathlǝnggighǝn ɗǝ ɗa nda wumang nafighǝn ɓa wurnǝn ahu ƙǝshiirha heu.”<verse eid="MRK 13:27" /></para>
  <para style="s">Tsaharhaha aten ɗǝf shiɓaarha</para>
  <para style="r">(<ref loc="MAT 24:32-35">Matta24:32-35</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“Walama tsaharhaha aten ɗǝf shiɓaarha. A naɗun ndǝn a tsǝtsǝtta, sǝnɗun sǝ nduwus fegrha ɓa. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Ko nanǝn kee, a naɗun a naa ǝngginiya a katǝrarha hai, sǝnɗunsǝ nduwus ɗa ɓa tsau a mii kwatminda. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Niya pǝrang ƙǝkafek kun, nafiya ƙǝshiid weeriya mba nda a mǝra wa ƙǝl katǝrana ǝnggina hai ya. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Nda talara tǝ hweeɗe na nda ngwalarha hai, amma laɓarna mbǝ tam ngwalarha wa.<verse eid="MRK 13:31" /></para>
  <para style="s">Mbǝ niifa sǝ sǝngga farɗi nduwa sayidɗi wa</para>
  <para style="r">(<ref loc="MAT 24:36-44">Matta24:36-44</ref>; <ref loc="LUK 17:26-30">Luka17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />“Mbǝ niifa sǝ na a sǝn farɗi nduwa sayidɗi na ǝnggini a katǝrarha hai ya wa, ko fathlǝngya na a talara, nduwa Wanɗi, ƙǝl chinɗi kee ndǝn sǝngga ndǝn.<note caller="+" style="f"><char style="fr" closed="false">13:32 </char><char style="ft" closed="false">Matta 24:36 </char></note> <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Kwarama! A sǝnunsǝ sǝnggun ɓad sayidɗa ɓa wa. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Nǝghǝn ƙǝla niifa na a wiirha, mal wurighǝnǝn ahar mafayighǝn, kowunni tǝ yighǝn taara fǝrang nǝn, ndanggǝn tǝ ƙǝla kwatkirma ha a shiiɗǝ wa.<note caller="+" style="f"><char style="fr" closed="false">13:34 </char><char style="ft" closed="false">Luka 12:36-38</char></note> <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />Tsaunǝn kee, a shiiɗun wa ƙǝsǝr sǝnggun farɗi na tǝ wuriɗi a ɓarha ɓa wa, tǝ a figrha, nduwa a manad fǝɗikrha, nduwa ka tǝtad ɗiyarha, nduwa a tsar. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />A ɓaɗa ɓa huhwam ɓa wa wal kun a shiirha wa. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Ənɗi pǝrang ni kun ya, pǝranggi ndǝn kowunni kee, ‘A shiiɗun wa!’ ”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Ƙǝnang mamngya Yahudaya hai a ɓǝlang ngganda Yeeso</para>
  <para style="r">(<ref loc="MAT 26:1-5">Matta26:1-5</ref>; <ref loc="LUK 22:1-2">Luka22:1-2</ref>; <ref loc="JHN 11:45-53">Yahaya11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Takhƙǝn ɓeena sǝri a ǝna wutsǝfayidɗa nda yi mburodi kula mekhna, mamnda firistaya tǝ famalǝmngya ngyakhrha kanda a kaɗa kwaman ƙǝsang nda Yeeso ɓǝɓee ka a ɓǝlangganda. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Amma ndaa nda, “Mbǝ a far wutsǝfayidɗiya wa, naɗǝ fiya har ƙǝm yanda.”<verse eid="MRK 14:2" /></para>
  <para style="s">Ƙǝmang nda fǝɗeerha Yeeso teena a Mbetani</para>
  <para style="r">(<ref loc="MAT 26:6-13">Matta26:6-13</ref>; <ref loc="JHN 12:1-8">Yahaya12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Nana Yeeso a Mbetani a hǝb ǝnnarhami a minda ki niifa na nda aarha Siman na tǝ wanhad termeerha fa, kyagha nuneefa ɓa tǝ ƙǝthlikrha urdi na tǝ wuɗǝɓǝla fa kaan, mbalanggǝn mii ƙǝthlikrǝɗaɗǝ iranggǝn fǝɗedɗi aten Yeeso hai.<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Luka 7:37-38</char></note><verse eid="MRK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4" />Fingya nanda a hǝb ǝnnarhami a mbǝrha tal tǝ Yeeso sǝbgha hur ndan ɗǝ ndaa nda, “Kama sǝɓang nǝn fǝɗedɗa ɗǝ na ngga kee ya? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Andam heng ɗaɗǝ nǝn kal wuɗǝɓǝl rapathlaarha yi hurarha tal, fǝrang nggǝnǝn fa yamiiya.” Tǝrgha yanangganda kaan.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Amma ndangga Yeeso kanda, “Malaman lee, kama nun a ɓillaghǝn ka ǝnanǝn ˈya na ngga a nggi? <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Na fa yamiya sǝ hangga ahur nun, kala faara nggǝmna hur nun fǝraman kanda. Amma mbǝ kakwanni nun naarha na nggi wa.<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="ft" closed="false">Nggǝr Ngwa Kumaarha 15:11 </char></note> <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Ənaɗǝ ˈya nǝn a mbang nda. ˈWa nǝn iree fǝɗedɗa fa ya ka yi panna. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Niya pǝrang ƙǝkafek kun, kalla mbǝrha pǝr nda laɓar Faara saaɗǝ ahu ƙǝshidɗiya, ˈya ǝnanǝn na nda a pǝrghǝn ɗǝ ƙǝm, ka a ɗalghǝnda teena.”<verse eid="MRK 14:9" /></para>
  <para style="s">Nggǝm Yahuda fa a fǝr Yeeso nǝn</para>
  <para style="r">(<ref loc="MAT 26:14-16">Matta26:14-16</ref>; <ref loc="LUK 22:3-6">Luka22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Tǝrgha Yahuda Iskaryoti tal ahur kumkap sǝri ɗi, ɗǝgha thlǝmad mamnda firistaya ɗǝ ka a fǝr Yeeso nǝn a kanda. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Tǝkka mamnda firistayini mbǝnda fa sǝk nǝn ˈya ɓangga ɓa nggǝma nda fa a fǝrang wuɗǝɓǝla nda. Ƙǝla sayi nǝn fa tǝ mbǝrha nǝn a fǝrang Yeeso kanda.<verse eid="MRK 14:11" /></para>
  <para style="s">Hǝb Yeeso ǝnnadmid wutsǝfayid tǝɗaarha ɗǝ heu tǝ fatsahayighǝn</para>
  <para style="r">(<ref loc="MAT 26:17-25">Matta26:17-25</ref>; <ref loc="LUK 22:7-14">Luka22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yahaya13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />A katǝra far Wutsǝfayidɗi yi Mburodi kula Mekhna, farɗani na nda ǝna sataka tǝ wan kamnda yi Tǝɗaarha. Tsahangga fatsahayighǝn mee, “A yanggi na midwa ɗan nggorha fa ɗǝna hǝb ǝnnadmid wutsǝfayid tǝɗaarha sǝ?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Tǝrgha thlǝngga Yeeso sǝri ahur fatsahayighǝn ndanggǝn kanda, “Ɗaama hur wupǝri ɗǝ, ɓana niifa wal kun tsǝb tǝ tsuliina ha, mbuwa ma samadghǝn.” <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />Ndaman tǝ wuriɗi kyanǝn sa hai, “Tǝmalǝmnda ni tsakhka mee, ‘Na ƙǝn rongya a yanggi, niya hǝb ǝnnadmid Tǝɗaarha sǝ tǝ fatsahayina?’ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Nǝn a kyaɗang ƙǝnna kun na manggǝn, na tǝ mbǝd tsaukya sǝ hangga. Ngwaman ƙǝm fa a mbǝɗi.”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Wiigha fatsahayini a wupǝri ɗaɗǝ, ɗa nda walghǝn ƙǝla thlǝghang na Yeeso kanda. Ngwa nda fa tǝ ǝnnadmid tǝɗadɗi a mbǝɗi.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Tsǝna figrha hai, sǝlgha Yeeso ɓa tǝ kumkap sǝri ɗi. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Tsauna nda hai kanda a hǝb ǝnnarhami, ndangga Yeeso kanda, “Niya pǝrang ƙǝkafek kun, tal ahur nun nǝn a fǝr nggi, yanɗi nani a hǝbrha tǝghǝn.” <verse eid="MRK 14:18" /><verse number="19" style="v" sid="MRK 14:19" />Kanda heu sǝbgha hur ndan ɗǝ na nda a ndang nda tǝtal tǝtal, “Mbǝ nggini wa, nduwa nggini wa?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Ndanggǝn kanda, “A hur nun ni kun na kumkap sǝriɗi ya, yanɗi na harnan tal hu ɗengnda. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Na Wan Niifa a wiirha ƙǝla chireethleng nanda hai atenggǝn. Amma ǝn kawa ni a niifɗi fǝrgha ndǝn! A fadghǝn a nggushi nggǝt wa na ndan.”<verse eid="MRK 14:21" /></para>
  <para style="s">Hǝb ǝnnadmid Chinǝm</para>
  <para style="r">(<ref loc="MAT 26:26-30">Matta26:26-30</ref>; <ref loc="LUK 22:14-23">Luka22:14-23</ref>; <ref loc="1CO 11:23-25">1 Korontiyaya11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Na nanda a hǝb ǝnnarhami, tǝrangga Yeeso mburodi sǝ hwan parkad Faara nǝn atenggǝn, kyanggǝn hai fǝranggǝnǝn fatsahayighǝn ɗǝ, ndǝghǝn, “Thlamadghǝn; thlu fanna niya.”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Tǝranggǝn wuhuleu aam inabi sǝ usa Faara nǝn, fǝranggǝnǝn kanda ɗǝ, sangganda. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Ndangga Yeeso kanda, “Farna niya irang nanda ɗǝ ka fiya hang. Fara lǝɗangga ɗǝfmi Faara.<note caller="+" style="f"><char style="fr" closed="false">14:24 </char><char style="ft" closed="false">Kyarhaɓa 24:8; Irmiya 31:31-34</char></note> <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Niya pǝrang ƙǝkafek kun, mbiya nggǝr sa aam inabi ɓalwa, ƙǝl ahu kutǝryid Faara ndǝn ɓani sa weerindǝghǝn.”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Ngwala nanda aah amshe, kya nda sǝ ɗǝnda wumnda ɗǝfya Dzaitun sǝ.<verse eid="MRK 14:26" /></para>
  <para style="s">Na Mbiturus a ngaal sǝnda Yeeso</para>
  <para style="r">(<ref loc="MAT 26:31-35">Matta26:31-35</ref>; <ref loc="LUK 22:31-34">Luka22:31-34</ref>; <ref loc="JHN 13:36-38">Yahaya13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Ndangga Yeeso fatsahayighǝn, “Kun heu nun a kar nggi fa, ƙǝsǝr nǝghǝn chichireethlee hai tǝ ndaarha;</para>
  <para style="q1" vid="MRK 14:27">“ ‘Niya ɗǝk tǝ lafadɗi,</para>
  <para style="q2" vid="MRK 14:27">na chaukhrayini a weela hai.’<note caller="*" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Dzakariya13:7</ref></char></note><verse eid="MRK 14:27" /></para>
  <para style="b" />
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28" />Amma a kwasamadɗi thliini sǝ hu mǝrra, niya ˈwaarha Nggalili ɗǝ ma kun.”<note caller="+" style="f"><char style="fr" closed="false">14:28 </char><char style="ft" closed="false">Matta 28:16</char></note><verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Ndaagha Mbiturus, “Ka kar nanda sa fa heu, nggi kam mbi naarha wa.”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Ndangga Yeeso, “Mbiturus, niya puro ƙǝkafek, a fǝɗik weeriya kapa na kilngaara tǝtaarha sǝri, na ngaal sǝndǝna katǝra mahan.”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Amma Mbiturus ɗǝgha mbeeɗǝ tǝ ndaarha, “Ko nǝm a mǝra ƙǝm kyab, mbi tam ngaal sǝnduwa wa.”</para>
  <para style="p" vid="MRK 14:31">Fingya fatsahaya heu ndaa nda kee ƙǝm.<verse eid="MRK 14:31" /></para>
  <para style="s">Hwan Yeeso Faara a Nggetsǝmani</para>
  <para style="r">(<ref loc="MAT 26:36-46">Matta26:36-46</ref>; <ref loc="LUK 22:39-46">Luka22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Ɗǝnda mbǝrha ɗǝ na nda aarha Nggetsǝmani, ndangga Yeeso fatsahayighǝn, “Tsawama a mbǝɗiya ɗǝni ka hwan Faara ɗǝ.” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Tǝranggǝn Mbiturus, tǝ Yakubu tǝ Yahaya nagha tǝ ɓillaarha tǝ sǝbrha hura kaan. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Ndanggǝn kanda, “Sǝb hurna ɗǝ ƙǝla ni mǝra. Tsawama a mbǝɗiya a shiiɗun wa.”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Nduwusgha mbeeɗǝ, ɓǝrgha hweeɗa hai hwan faara a naɗǝ a ǝnaarha hai a ndǝkka hai tǝ sǝsadɗiya. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Ndagha, “Pǝpa, ǝngya heu nǝghǝn pǝppa a fadwa. A nggǝmna fa tǝree sǝsadɗaɗǝ ya. Mbǝ nggǝmnda hurna wa, amma ˈya nggǝmna hurwa ndǝna mǝmǝl.”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Tǝrgha wudgha thlǝmad fatsahayighǝn ɓa, ɓagha wal kanda a shiirha. Ndanggǝn Mbiturus, “Mbiturus, nun a shiirha? Mbun mbang tsaurha tsǝɓaku a ƙǝlaarha wa? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />A shiiɗun wa, hwanama Faara amanun mukrha hu ƙǝƙǝrra hai. Minnun sǝ ǝnaarha, amma thlu fannun mǝrɗa hai.”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Tǝrgha Yeeso mal kanda ɗǝgha ka hwan Faara ɗǝ, nggǝrghǝn thlǝkrha ƙǝla ˈwanǝn hwanda. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Nggǝrghǝn wutta thlǝmandan ɓa ɓagha wal kanda a shiirha faɗǝn, ƙǝsǝr ngwalang ɓeena fandan. Sǝngwanda ǝnɗi na nda thlǝghang nda wa.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Wud nǝn ɓa yi mahan, ndanggǝn kanda, “Ɓal wun a shiirha tǝ yibrha? Tsǝkɗǝ kee! Ɓad sayidɗa ɓa. Fǝr nda Wan Niifa ahar fa ɗimiya hai. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Thleema sǝ! Taama wiim! Kulo tǝ fǝrrǝna ɓayi ya!”<verse eid="MRK 14:42" /></para>
  <para style="s">Ƙǝsang nda Yeeso</para>
  <para style="r">(<ref loc="MAT 26:47-56">Matta26:47-56</ref>; <ref loc="LUK 22:47-53">Luka22:47-53</ref>; <ref loc="JHN 18:3-12">Yahaya18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Nana Yeeso aten ndikrha kee, ƙǝlagha hai ka Yahuda, tal na ahur fatsahayighǝn kumkap sǝri ɗi kyagha ɓa tǝ fiya hangga a samadghǝn ngwanda fa tǝ thlakh ƙǝlarya tǝ sǝsalya. Thlǝnna mamnda firistaya kanda, tǝ famalǝmngya ngyakhrha tǝ shingya. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />ˈWad Yahuda teena saghang ɗa ndǝn kanda tǝ ndaarha, “Yanɗi ndang ni ˈya tǝ fǝbrha, niifɗa ni; ƙǝsaaman win tǝghǝn ƙǝlaghǝnun ha ngga.”<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />Ɓana Yahuda thlǝmad Yeeso ɓa aaghǝnǝn, “Mala!” Fǝɓanggǝn. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Tǝrgha ƙǝsangganda Yeeso, ƙǝsghǝnda ha ngga. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Amma niifa tal ƙǝɗanggǝn thlaukh ƙǝlarghǝn sǝ kyathlanggǝn thlǝmad mafad mamnda firistaya ɗǝ.<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />Ndangga Yeeso kanda, “Tǝrwun nggi niifa ni na tǝmbǝng, nun ɓaarha ɓa tǝ thlaukh ƙǝlarya tǝ sǝsalya ka a ƙǝseewun wa? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Ƙǝtsar nggi a thlǝmad nun, nggi a tsaharhaha a pǝpal Wuri Faara, ƙǝseewun wa. Amma katǝra nǝn hai kee ka a lǝghǝdgha ˈya ndaana ɗeleewar Faara.”<note caller="+" style="f"><char style="fr" closed="false">14:49 </char><char style="ft" closed="false">Luka 19:47; 21:37</char></note><verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />Tǝrgha fatsahayighǝn kowunni ƙǝl ɗaarha mal Yeeso nda.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Na wundǝlarha sǝ tal ahur nafiya na a mbu samad Yeeso, mbǝ lukrha sǝ a fadghǝn wa ƙǝl kooto kee ndǝn kaunǝn fa. Ɓana nafini ka ƙǝsang Yeeso ɓa, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />muwanggǝn kootodɗa ɗǝ na a fadghǝn ɗaagha tawalth.<verse eid="MRK 14:52" /></para>
  <para style="s">Ɗǝnda tǝ Yeeso a mbed mamngya</para>
  <para style="r">(<ref loc="MAT 26:57-68">Matta26:57-68</ref>; <ref loc="LUK 22:54-55">Luka22:54-55</ref>; <ref loc="JHN 18:13-14">Yahaya18:13-14</ref>; <ref loc="JHN 19:24">19:24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Ɗǝnda tǝ Yeeso a minda ki mamnda firistaya ɗǝ, a mbǝɗani wumna fingya mamngya firistaya sǝ, tǝ shingya, tǝ famalǝmngya ngyakhrha. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Mbuwa Mbiturus samad ndan ɗǝ a samarha inggun ta pǝpal minda ki mamnda firistayina ɗǝ. Tsauka hai a thlǝma fa ƙǝlaya ha nagha a tǝk waarha fa. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />Mamnda firistayini tǝ fingya wumngga hai na nda a kaɗa kwamana na a ƙǝsangganda Yeeso tǝ ˈya na ɗimi, tǝna nda ɓǝlang nda, amma wal wanda wa. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Nggaɓangga fingya fa tǝ pathya hangga, amma ɓawa mii ndan ɓa tal wa.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Tǝrgha thliigha fingya sǝ pǝr laɓarya nda yi nggaɓaarha ndaa nda, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“Sǝk ɗan fadghǝn ndǝghǝn, ‘Niya chang Ƙǝn Faara hai tǝnna fiya, tǝngga pak ahu ɓeena mahan, mbǝ niifa ni a tǝnggǝn wa.’ ”<note caller="+" style="f"><char style="fr" closed="false">14:58 </char><char style="ft" closed="false">Yahaya 2:19</char></note> <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Ko nanǝn kee tǝrwa path ndan kwamana wa.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Tǝrgha mamnda firistayini thliigha sǝ a mbed fiya tsahang mee nǝn Yeeso, “Mba mbang nggǝra sǝ wa? Ma na ndaarha aten pathɗi thlǝkna nafini aten wa ya?”<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />Amma nggasgha Yeeso tip, nggǝrwa sǝ wa.</para>
  <para style="p" vid="MRK 14:61">Nggǝrgha mamnda firisyini tsahang mee, “Nduwa sani Ƙǝrǝsti, Wan Faara amshi tǝ Parka?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Ndangga Yeeso, “Nggini.</para>
  <para style="b" vid="MRK 14:62" />
  <para style="q1" vid="MRK 14:62">Nun a naa Wan Niifa tsau a yisǝmad Faara Amshi na tǝ mamnggirha ha heu,</para>
  <para style="q2" vid="MRK 14:62">nǝghǝn ɓayi ahu hashmbe a talara hai.”<note caller="+" style="f"><char style="fr" closed="false">14:62 </char><char style="ft" closed="false">Ndaniyel 7:13</char></note><verse eid="MRK 14:62" /></para>
  <para style="b" />
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Tǝrgha mamnda firistayini djaranggǝn luwudghǝn ɗǝ, ndǝghǝn, “Palth ma nǝm nggǝr kaɗaarha faɗǝn? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Sǝkɗǝm ndǝn hai a miighǝn laɓar sar Faara nda nǝn. Ma ndanun?”</para>
  <para style="p" vid="MRK 14:64">Kanda heu ndaa nda, a ɓǝlangganda. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />Tǝrgha fingya katǝrang ngganda chahang yakhrha Yeeso fa; ƙǝnangganda yidghǝn mbighǝnda, ndang ngganda, “Kulo! Wun mbiigha sa hu sayidɗi ya, annabi?” Fa ƙǝla ƙǝn Faara ha ɗǝnda mbeeɗǝ tǝ ɗǝkƙǝn.<verse eid="MRK 14:65" /></para>
  <para style="s">Ngaal Mbiturus sǝnda Yeeso</para>
  <para style="r">(<ref loc="MAT 26:69-75">Matta26:69-75</ref>; <ref loc="LUK 22:56-62">Luka22:56-62</ref>; <ref loc="JHN 18:15-18">Yahaya18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Nana Mbiturus a pǝpal mindǝɗi a tǝk waarha fa, kyagha wee nuwun ɓa tal ahur mafaya mamnda firistayini. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Nanǝn Mbiturus a tǝk waarha fa ƙǝlanggǝn ɗǝ ngga. Ndanggǝn, “Sa na tal ahur nafini na a mbu samad Yeeso tǝ Nadzarat ɗi.”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Amma ngaalghǝnǝn. Ndanggǝn, “Sǝngwi ǝnɗi na a thlǝkrha ya wa,” thliigha sǝ ɗǝgha kwatkirma ɗǝ. Tǝrgha tǝtaagha ɗiyarha.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Nggǝrna mafadɗi naghǝn, ndanggǝn nafini na ƙǝƙǝt a mbǝɗi, “Niifɗiya nǝghǝn tal ahur ndan.” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Nggǝrghǝn ngaalghǝn faɗǝn.</para>
  <para style="p" vid="MRK 14:70">Tsǝna nda tsǝɓaku, nafini na ƙǝƙǝt a mbǝɗi ndang ngganda Mbiturus, “Sa mbǝ ngaala sǝ wa na tal ahur ndan, ƙǝsǝr tǝ Nggalilad ni sa.”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Katǝranggǝn ang shiurha tenggǝn fa ɓa ndǝghǝn, “Aahɗi Faara, sǝngwi niifɗi nun a thlǝkrha ya wa.”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Tǝrgha tǝtaagha ɗiyarha yi sǝri. Ɗalgha Mbiturus teena hai tǝ laɓar Yeeso ndang nǝn, “Kapa na kidngaara tǝtaarha yi sǝri na ngaal sǝndǝna katǝra mahan.” Kwanggǝn tenggǝn hai nagha a tǝrha.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Ɗǝnda tǝ Yeeso a mbed Mbilatus ɗǝ</para>
  <para style="r">(<ref loc="MAT 27:1-2">Matta27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luka23:1-5</ref>; <ref loc="JHN 18:28-38">Yahaya18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />A tsar ƙǝrǝt wumngga mamngya firistaya hai tǝ shingya tǝ famalǝmngya ngyakhrha, tǝ fingya kognaya ƙǝnangganda path ndan hai. Ƙǝnangganda Yeeso ɗǝnda tǝghǝn a mbed Mbilatus ɗǝ. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Tsahangga Mbilatus mee, “Sani kutǝr Yahudaya wa?”</para>
  <para style="p" vid="MRK 15:2">Nggǝmangga Yeeso, “Ƙǝla thlǝkna na.”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Tǝrgha mamnda firisɗi nagha a ɗahang pathya fa aten ǝngya hangga. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Nggǝrgha Mbilatus tsahang mee, “Mba nggǝra sǝ ndeye wa? Sǝkkwa ǝnɗi nana nda a thlǝworha fa wa!”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Amma Yeeso kalwa sǝ wa, fǝrang ǝnwulteena nǝn Mbilatus.<verse eid="MRK 15:5" /></para>
  <para style="s">Ngwang nda kumad mǝrra Yeeso</para>
  <para style="r">(<ref loc="MAT 27:15-26">Matta27:15-26</ref>; <ref loc="LUK 23:13-25">Luka23:13-25</ref>; <ref loc="JHN 18:39-19:16">Yahaya18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Kala wutsǝfayid tǝɗaarha yakh Mbilatus kal niifa hai tal muwang nanda hu porsǝna ɗǝ yi hwanna fiya. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Na niifa sǝ thlǝmnggǝnni Mbarabas muwang nanda hu porsǝna ɗǝ ka tǝmbǝnggidghǝn ˈwanǝn ɓǝl niifa. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Wumna fiya thlǝmad Mbilatus ɓa, hwanggǝnda a kalang niifa nǝn kanda hai na hu porsǝna ƙǝla nǝn tǝ ǝnaarha. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Nggǝmanggǝn kanda ndǝghǝn, “Na minnun sǝ a kalang kutǝr Yahudaya ni kun hai wa?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Ƙǝsǝr sǝnɗasǝ ka sǝrǝkkid mamnda firistaya ni ɓang nanda Yeeso ɓa.<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />Amma Mamngya firistaya shighangganda fiya fa a kalgha Mbilatus Mbarabas hai a meghed Yeeso. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Ndangga Mbilatus kanda, “Amma a kalangɗi Mbarabas kun hai, niya ǝnaarha ƙǝn tǝ niifɗi nun aarha kutǝr Yahudaya?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Tǝrangganda urad ndan sǝ, “Tawaman ɗǝ!”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Ndangga Mbilatus kanda, “Kama nda, ɗimid ma ǝna nǝn?”</para>
  <para style="p" vid="MRK 15:14">Amma tǝrangga fiya urad ndan sǝ kaan, “Tawaman ɗǝ!”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Nanǝn na mid Mbilatus sǝ a tǝkka fiya mbǝnda fa, kalang Mbarabas nǝn kanda hai. Tǝrgha fǝr Yeeso nǝn a tsaɗaghǝn nda, a fǝranggǝnǝn sodja Romaya tawangganda ɗǝ.<verse eid="MRK 15:15" /></para>
  <para style="s">Sodjaya wanda Yeeso</para>
  <para style="r">(<ref loc="MAT 27:27-31">Matta27:27-31</ref>; <ref loc="JHN 19:2-3">Yahaya19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Sodja yini ɗǝnda tǝ Yeeso a mbǝd tar ndan ɗǝ, aah fingya sodjaya nda ɓa. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Kalang kaɓad kutǝryirha nda fa na yiɓa, faɗang ngganda ndaha na nzǝnzang panggǝn nda atenggǝn. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Tǝrgha tǝrangganda urad ndan sǝ na nda a ndangˈya, “Alvari! Kutǝr Yahudaya!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Na nda a ɗǝkƙǝn tǝ sǝsaala a tenggǝn, tǝ ƙǝm na nda a chahang yakhrha fa. Ɓǝra nda hai tǝ waɗeeyi ndan wai na nda a fǝrang mamnggirha yi waa farha.<verse eid="MRK 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 15:20" />Ngwalang na nda waaghǝn, ƙǝɗangganda kaɓad kutǝryidɗa hai na a fadghǝn kalang yighǝn nda. Tǝrgha ɗǝnda tǝghǝn ƙǝshaaɗǝ ƙǝsǝr a ɗaa nda tawang ɗǝ.<verse eid="MRK 15:20" /></para>
  <para style="s">Tawang nda Yeeso ɗǝ</para>
  <para style="r">(<ref loc="MAT 27:32-44">Matta27:32-44</ref>; <ref loc="LUK 23:26-43">Luka23:26-43</ref>; <ref loc="JHN 19:17-27">Yahaya19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Na nanda a wiirha tǝ Yeeso ƙǝma nda tǝ niifa na nda aarha Siman tǝ Sayirarha chin nda Alizanda tǝ Rufus, ɓaghǝn ɓa a Sarin. Ngyaɓang tǝr kaɗid ɗa nda fa.<note caller="+" style="f"><char style="fr" closed="false">15:21 </char><char style="ft" closed="false">Romaya 16:13</char></note> <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Ɓa nda tǝ Yeeso a mbǝrha ɓa na nda aarha Nggolggota ndǝna mbǝd ɓalhwar teena. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Fǝrang aam inabi nda kukurɗa tǝ mur,<note caller="+" style="f"><char style="fr" closed="false">15:23 </char><char style="fk">Mur:</char> Ɗǝf saarha ni na thlahang hatta fad niifa ɗǝ</note> amma karɗǝ saarha fa. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Tǝrgha tawangganda Yeeso ɗǝ ndǝghangganda karidghǝn hai a pathlang ndan, Əna chacha nda aten lukkighǝn tǝ kurmi na niifa a waala.<note caller="+" style="f"><char style="fr" closed="false">15:24 </char><char style="ft" closed="false">Dzabura 22:19</char></note> <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Tawangganda ɗǝ tǝ tsar fa. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />A man tenggǝn chireethleng ngganda ǝnɗa hai ɗahang nanda fa, “KUTƏR YAHUDAYA.” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Tawang ngganda fathlee kwamangya ɗǝ sǝri, tal a yikawadghǝn, tal ƙǝm a yisǝmadghǝn<note caller="+" style="f"><char style="fr" closed="false">15:27 </char><char style="ft" closed="false">Ishaya53.12</char></note>. Fingya chirethya yi kaar na nda tǝ mbǝdghǝn 28 tǝ ndaagha: “Lǝghǝtta palthɗa ni tǝ ndaagha, ‘Saghang nda ahur fa ɗimiya hai.’ ”<note caller="+" style="f"><char style="fr" closed="false">15:27 </char><char style="ft" closed="false">Ishaya 53:12</char></note><verse eid="MRK 15:27" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />Fiya na a mbǝraɗǝ na nda a thlǝghang pathya fa yi sar farha na nda a tsangˈya tendan fa na nda a waaghǝn, “Sa ndaagha na fǝlang Ƙǝn Faara hai na manggǝn tǝnangga hu ɓeena mahan,<note caller="*" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="PSA 22:8">Dzabura22:8</ref>; <ref loc="PSA 109:25">109:25</ref>; <ref loc="MRK 14:58">Markus14:58</ref>; <ref loc="JHN 2:19">Yahaya2:19</ref></char></note> <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />Hǝrghang fadwa lee tǝraa na hai aten kaɗidɗiya!”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Nǝghǝn kee ƙǝm, mamngya firistaya tǝ famalǝmngya ngyakhrha na nda a waaghǝn, “Hǝrghanggǝn fingya, amma mbǝ mbang hǝrghang fadghǝn wa! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Ngwa na Ƙǝrǝsti ɗa nǝm kutǝr Isǝrela, tǝrgha hai a ten kaɗidɗi naghǝnǝm tǝnǝm fǝrang ƙǝkafek!” Ko fathlee kwamanggini tawang nanda kanda ɗǝ tǝghǝn na nda a thlǝghang pathya fa mbuwa mbǝnggǝn.<verse eid="MRK 15:32" /></para>
  <para style="s">Mǝrra Yeeso</para>
  <para style="r">(<ref loc="MAT 27:45-56">Matta27:45-56</ref>; <ref loc="LUK 23:44-49">Luka23:44-49</ref>; <ref loc="JHN 19:28-30">Yahaya19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Na yan faara a sǝrǝkrha wula nggǝlanggǝn chehwedɗi heu ta figrha ɗǝ. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Tǝrgha a fiyidɗi tǝrangga Yeeso Uradghǝn sǝ, “Eloi, Eloi, lama sabaktani?” Ndaarha ni, “Faarna, Faarna, kama nda malna nggi?” <note caller="*" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Dzabura22:1</ref></char></note><verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Fingya na ƙǝƙǝt a mbǝɗi sǝkkwa ndan ngga wa tamngganda ndaarha nǝghǝn a aah annabi Ilya.<verse eid="MRK 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36" />Tal ahur ndan ɗagha ɗǝ tǝtǝnanggǝn soso tǝ aam inabi na chichakh panggǝn hu sǝsaala fǝranggǝnǝn sǝ ka a saagha. Ndaagha niifa, “Malaman, tama ƙǝlaghǝnǝm ha tǝ ɗǝna Ilya tǝrang hai.”<note caller="+" style="f"><char style="fr" closed="false">15:36 </char><char style="ft" closed="false">Dzabura 69:21</char></note><verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Tǝrgha nggǝrgha Yeeso tǝrang uradghǝn sǝ, a mǝrgha.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Shishamarɗi na ahu Ƙǝn Faara na manggǝn djaragha hai sǝri a talara hai ta hweeɗe hai.<note caller="+" style="f"><char style="fr" closed="false">15:38 </char><char style="ft" closed="false">Kyarhaɓa 26:31-33</char></note><verse eid="MRK 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 15:39" />Mamnda Sodja Romaya na ƙǝƙǝt a mbed Yeeso fa naɗǝ kwamanɗi mǝrnǝn ndǝghǝn, “Ƙǝkafek, Wan Faarani ya!”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Na fingya nishya sǝ a mbǝɗi na ƙǝƙǝt inggun a ƙǝlang ˈya na a katǝrarha hai. A hur ndan na Mairamu Makdaliya sǝ, Mairamu man Yakubu tǝ fewunda tǝ Yisufu, tǝ Salomi. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Ka a Nggalili ɓa takkwana nishyina ndǝn ɓa na nda a ɗang sǝ tǝ tarya, na fingya nishya sǝ hangga a samadghǝn ka Urshalima ɓa.<note caller="+" style="f"><char style="fr" closed="false">15:41 </char><char style="ft" closed="false">Luka 8:2-3</char></note><verse eid="MRK 15:41" /></para>
  <para style="s">Pang nda Yeeso</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matta27:57-61</ref>; <ref loc="LUK 23:50-56">Luka23:50-56</ref>; <ref loc="JHN 19:38-42">Yahaya19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Katǝragha ǝnɗa hai ya a far ɗemnda yi far yiɓǝd Yahudaya, nanǝn tsǝ figrha hai. <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Na ka niifasǝ thlǝmnggǝnni Yisufu tǝ Aramatiya, nǝghǝn ahur mamngya na ƙǝnang pathla hai, Nǝghǝn a ƙǝla kutǝryid Faara fa. Tǝrǝm ngwa wa, ɗǝgha thlǝmad Mbilatus ɗǝ hwan mǝrra Yeeso nǝn. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Fǝrwa Mbilatus ƙǝkafek mǝr Yeeso wa, aah mamnda Sodja Romaya nǝn ɓa tsahang mee nǝn. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Pǝrangga mamnda sodja ɗa ndǝn, ndangga Mbilatus Yisufu a ɗǝgha tǝrang mǝrɗi.<verse eid="MRK 15:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 15:46" />Hiigha Yisufu kaɓad pa mǝrra ɓa pǝpet, tǝranggǝn fad Yeeso ahu kaɗidɗi, faɗanggǝn Yeeso tǝ kaɓadɗi ɗǝgha ɗǝ panggǝn ahu kwaarha raa nanda hu feera. Kwatǝranggǝn feera ɓa na manggǝn nggǝlanggǝn kwadɗa sǝ.<verse eid="MRK 15:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 15:47" />Mairamu Magdaliya tǝ Mairamu man Yisǝfu na mbǝɗa nda pang nanda Yeeso sǝ.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Thlid Yeeso sǝ hu mǝrra</para>
  <para style="r">(<ref loc="MAT 28:1-8">Matta28:1-8</ref>; <ref loc="LUK 24:1-12">Luka24:1-12</ref>; <ref loc="JHN 20:1-10">Yahaya20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Kyana far yiɓǝd Yahudayina ɗǝ, Mairamu Magdaliya tǝ Mairamu man Yakubu tǝ Salomi hii urdi nda na mindan sǝ ɗa nda ƙǝmang fad Yeeso tǝghǝn. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />A tsar far katǝra thlǝtta ɓeena, yanfaara a kyarha ɓa ƙǝs kwamana nda aten kwadɗa ɗǝ <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />tsahang mee nda ndan ha, “Wunni a kwatǝrang ferɗi ƙǝm ɗǝ na a mii kwadɗi?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Amma tǝrang nanda tendan sǝ ƙǝla nda hai ferɗi na manggǝn kwatǝrang nda ɗǝ.<verse eid="MRK 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 16:5" />Kyana nda ahur kwadɗa hai ƙǝla nda hai wundǝlarha tǝ lukrha fa pǝpet tsaua man yisǝma, tǝr ma nda.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />Ndanggǝn kanda, “A fidɗun hai wa, nun a kaɗa Yeeso tǝ Nadzarat tawang nanda ɗǝ. Thliiɗa sǝ ɓalwa mbǝɗiya wa. Kǝlaman mbǝɗi hunang nanda sa hai ya. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Amma ɗamaɗǝ ɗun pǝranggǝn fatsahayighǝn tǝ Mbiturus tǝ ndaarha, ‘Nǝn a ˈwaarha Nggalili ɗǝ ma kun. Ɗǝnun naghǝn a mbǝɗi ƙǝla pǝrang nǝn kun.’”<note caller="+" style="f"><char style="fr" closed="false">16:7 </char><char style="ft" closed="false">Matta 26:32, Markus 14:28 </char></note><verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Thliigha nishyini tǝ ɗaarha aten kwadɗi nagha fad ndan a rǝprha fa ka hǝreenga. Kalang ngwanda niifa sǝ wa, ƙǝsǝr ƙǝs hǝreenga kanda.<verse eid="MRK 16:8" /></para>
  <para style="s">Kyad Yeeso fadghǝn a Mairamu</para>
  <para style="r">(<ref loc="MAT 28:9-10">Matta28:9-10</ref>; <ref loc="JHN 20:11-18">Yahaya20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Thliina Yeeso sǝ ahu mǝrra a far katǝra thlǝtta ɓeena ˈwaghǝn kyad fadghǝn a Mairamu Magdaliya nuɗi kyang nǝn ǝnkaheeya sǝ mǝd a fadghǝn. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Ɗǝgha ɗǝ pǝranggǝn nafini na nanda tǝghǝn kaar na nanda tǝ sǝbrha hura kanda a tǝrha. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Amma sǝkna nda na Yeeso tǝ yibrha, na ɗa ndǝn, fǝr wanda ƙǝkafek wa.<verse eid="MRK 16:11" /></para>
  <para style="s">Kyad Yeeso fadghǝn a fatsahayighǝn sǝri</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luka24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Akwasamadghǝn kyakhrangga Yeeso fadghǝn hai kyad fadghǝnǝn a fatsahayighǝn sǝri na nanda a kwaman ɗǝrha mbǝrha ɗǝ. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Wuɗa nda ɗa nda pǝranggǝn shayindan, amma fǝr wanda ƙǝkafek tǝ path ndan wa.<verse eid="MRK 16:13" /></para>
  <para style="s">Fǝrang Yeeso taara fatsahayighǝn</para>
  <para style="r">(<ref loc="MAT 28:16-20">Matta28:16-20</ref>; <ref loc="LUK 24:36-49">Luka24:36-49</ref>; <ref loc="JHN 20:19-23">Yahaya20:19-23</ref>; <ref loc="ACT 1:6-8">Tar fathlǝngya1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Tsǝɓaku kyadgha Yeeso fadghǝn a kumkap tal ɗi a sayidɗi na nanda a hǝb ǝnnarhami. Tǝrgha yananggǝn kanda ƙǝsǝr ka yamid fǝrƙǝkafekkid ndan tǝ kakrakkin tendan fǝrang ngwanda ƙǝkafek nafini nagha ndǝn a kwasamadɗi thliinǝn sǝ.<verse eid="MRK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15" />Ndanggǝn kanda, “Ɗaama hu ƙǝshiirha ɗǝ ɗun pǝr laɓarɗi na mbǝnggǝn ya a fiya heu.<note caller="+" style="f"><char style="fr" closed="false">16:15 </char><char style="ft" closed="false">Tar Fathlǝngya 1:8</char></note> <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Kala niifa fǝrgha ƙǝkafek ǝnang mbaptisǝma nda, nǝn a hǝrǝkrha, amma niifa fǝrwa wa ƙǝkafek na nda a ngwang kumarha sǝ. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Fingya fǝrgha ƙǝkafek na nda a wal sǝsǝmnda ǝna ǝnwuteengya hangga. Hu thlǝmna na nda a kyang ǝnkaheeya sǝ, tǝ ƙǝm na nda a ndikrha tǝ fingya miiya pak. <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />Na nda a ƙǝsang huthlingya tǝ haryindan, ko saa nanda warkami mbǝ ǝnang ˈya kanda wa. Na nda ɗǝfang haara haaya teena, ƙǝna nda.”<verse eid="MRK 16:18" /></para>
  <para style="s">Tǝrang nda Yeeso talara ɗǝ</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luka24:50-53</ref>; <ref loc="ACT 1:9-11">Tar fathlǝngya1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />A kwasamadɗi ngwalana Yeeso ndikrha tǝ kanda, tǝrang ngganda talara ɗǝ tsauka a yisǝmad Faara.<note caller="+" style="f"><char style="fr" closed="false">16:19 </char><char style="ft" closed="false">Tar Fathlǝngya 1:9-11</char></note> <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Tǝrgha fatsahayighǝn ɗǝnda mbeeɗǝ tǝ pǝr laɓar Faara, Chinǝm nǝghǝn tǝ kanda ha nagha. Nǝn naarha kyaɗang ƙǝkafekkid laɓarghǝn kanda tǝ ǝnwuteengya nanda a ǝnaarha.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>