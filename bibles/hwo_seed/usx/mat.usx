<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">TA - Hona Bible</book>
  <para style="h">MATTA</para>
  <para style="toc1">MATTA</para>
  <para style="toc2">MATTA</para>
  <para style="toc3">MATTA</para>
  <para style="mt1">Matta</para>
  <para style="mt2">Laɓara na Mbǝnggǝn aten Yeeso</para>
  <para style="imt">Katǝra laɓaara</para>
  <para style="im">Matta tal ahur fa fatsahaya Yeeso ndǝn chirethgha ɗeleewar ɗiya. Laɓara na Mbǝnggǝn aten Yeeso yi Matta pǝrangɗǝ ndaarha ƙǝm Yeeso Ƙǝrǝsti ni. Ndǝghǝnni tǝ hǝrǝkrha lǝɗangna Faara ɗǝf miighǝn a nafiyighǝn ahu Ɗeleewar Faara tǝ Peɗǝnda yi ƙǝtǝm. Laɓarɗi na Mbǝnggǝn ya mbǝ a Yahudaya katendan wa, amma a ƙǝshiirha kahad. Chireethleng Matta ǝnggina hai katǝragha hai tǝtal-tǝtal. Katǝranggǝn hai tǝ laɓar nggǝtta Yeeso, tǝ mbaptisǝmadghǝn tǝ ƙǝƙǝrrǝghǝn. Tǝ ƙǝm kwamanɗi katǝrang nǝn pǝr laɓar Faara, tǝ tsahadghǝn ha, tǝ ƙǝnang nda fiya a Nggalili. Pǝrɗǝ laɓar wiid Yeeso thliinǝn a Nggalili ɗǝnǝn Urshalima ɗǝ; tǝ ǝngya katǝragha hai atenggǝn har tawang nanda ɗǝ tǝ thliidghǝn sǝ ahu mǝra. Laɓara na Mbǝnggǝn aten Yeeso yi Matta kyadɗa ndǝn a pǝpal tǝ ndaarha Yeeso Ƙǝrǝsti mamnda tǝmalǝmnda ni. Nǝghǝn tǝ sǝsǝmnda yi fǝlang nda Ngyakhrha Faara hai ma Musa.</para>
  <para style="ip">Tsahang Matta hai pǝmnggǝn tuf: 1. Tsahad Yeeso ha a mbǝrha na ɗangkam, aten ǝngya kamngga a tsauka wangya Kutǝryid Faara (5-7). 2. Tsahang ɗǝ fatsahayighǝn ha kumkap sǝri, kwamana kamngga a ǝna taara nda mǝmǝl (10). 3. Na karapu sǝ ɗǝɗamǝn-ɗǝɗamǝn tsahana Yeeso ha aten kutǝryid Faara (13). 4. Kwamana na a tsauka tǝ mbu samad Yeeso (18). 5. Tsaha ɗaha aten mii ngwala ƙǝshiirha tǝ ǝngya na a katǝrarha hai a farɗi (24-25). Əngya na ahurghǝn.</para>
  <para style="io1">Chichiiya Yeeso tǝ nggǝttǝghǝn hai 1:1-25; 2:23</para>
  <para style="io1">Tarya ǝnana Yahaya tǝ Mbaptisǝma 3:1-12</para>
  <para style="io1">Mbaptisǝmad Yeeso tǝ ƙǝƙǝrrǝghǝn 3:13-17; 4:11</para>
  <para style="io1">Tarya ǝnana Yeeso a chehweed Nggalili 4:12, 18:35</para>
  <para style="io1">Mal Yeeso Nggalili ɗǝgha Urshelima ɗǝ 19:1-30; 20:34</para>
  <para style="io1">Mii ngwala tar Yeeso a Urshelima 21:1-46; 27:30</para>
  <para style="io1">Taurha Yeeso ɗǝ tǝ mǝrrǝghǝn 27:32-66</para>
  <para style="io1">Thlid Yeeso sǝ hu mǝra tǝ kyatta fadghǝn 28:1-20</para>
  <para style="ib" />
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Chichiiya Yeeso</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luka3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Kulo thlǝmngya chichiiya Yeeso Ƙǝrǝsti ya, chichid Ndauda tǝ Ibrahim.<verse eid="MAT 1:1" /></para>
  <para style="b" />
  <para style="li">
    <verse number="2" style="v" sid="MAT 1:2" />Ibrahim nggǝtgha Ishaku,</para>
  <para style="li" vid="MAT 1:2">Ishaku nggǝtgha Yakubu.</para>
  <para style="li" vid="MAT 1:2">Yakubu nggǝtgha Yahuda tǝ wan manggighǝn.<verse eid="MAT 1:2" /></para>
  <para style="li">
    <verse number="3" style="v" sid="MAT 1:3" />Yahuda nggǝtgha Peres tǝ Dzara. Ma ndan ndǝna Tamar.</para>
  <para style="li" vid="MAT 1:3">Peres nggǝtgha Hesron,</para>
  <para style="li" vid="MAT 1:3">Hesron nggǝtgha Aram, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Aram nggǝtgha Aminadab,</para>
  <para style="li" vid="MAT 1:4">Aminadab nggǝtgha Nashon,</para>
  <para style="li" vid="MAT 1:4">Nashon nggǝtgha Salmon.<verse eid="MAT 1:4" /></para>
  <para style="li">
    <verse number="5" style="v" sid="MAT 1:5" />Salmon Nggǝtgha Mboz. Man ndǝna Rahap.</para>
  <para style="li" vid="MAT 1:5">Mboz nggǝtgha Obed. Man ndǝna Ruth.</para>
  <para style="li" vid="MAT 1:5">Obed nggǝtgha Djeshi,<verse eid="MAT 1:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="MAT 1:6" />Njessi nggǝtgha kutǝra Ndauda.</para>
  <para style="li" vid="MAT 1:6">Ndauda nggǝtgha Sulemanu. Man ndǝna Mbasheba, nu mǝra Uriya.<verse eid="MAT 1:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="MAT 1:7" />Sulemanu nggǝtgha Rehobom,</para>
  <para style="li" vid="MAT 1:7">Rehobom nggǝtgha Abidja,</para>
  <para style="li" vid="MAT 1:7">Abidja nggǝtgha Asa,<verse eid="MAT 1:7" /></para>
  <para style="li">
    <verse number="8" style="v" sid="MAT 1:8" />Asa nggǝtgha Djehoshafat,</para>
  <para style="li" vid="MAT 1:8">Djehoshafat nggǝtgha Djoram,</para>
  <para style="li" vid="MAT 1:8">Djoram nggǝtgha Adzariya,<verse eid="MAT 1:8" /></para>
  <para style="li">
    <verse number="9" style="v" sid="MAT 1:9" />Adzariya nggǝtgha Djothlam,</para>
  <para style="li" vid="MAT 1:9">Djothlam nggǝtgha Ahas,</para>
  <para style="li" vid="MAT 1:9">Ahas nggǝtgha Hedzekiya,<verse eid="MAT 1:9" /></para>
  <para style="li">
    <verse number="10" style="v" sid="MAT 1:10" />Hedzekiya nggǝtgha Manasa,</para>
  <para style="li" vid="MAT 1:10">Manasa nggǝtgha Aman,</para>
  <para style="li" vid="MAT 1:10">Aman nggǝtgha Djosiya,<verse eid="MAT 1:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="MAT 1:11" />Djosiya nggǝtgha Djekoniya <note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fk">Djekoniya:</char> sǝn ndan ƙǝm tǝ thlǝma “Djehoyakin”. Ƙǝlang 2 Kutǝrya 25:27</note> tǝ wanmanggighǝn, a sayidɗi ƙǝsang ngganda nafiya Yahuda ngyaɓang tsaurha nda kanda fa hu chehweed Mbabila ɗǝ.<note caller="*" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2 Kutǝrya24:14-15</ref>; <ref loc="2CH 36:10">2 Ɗeleewar fa sǝngya36:10</ref>; <ref loc="JER 27:20">Irmiya27:20</ref></char></note><verse eid="MAT 1:11" /></para>
  <para style="b" />
  <para style="li">
    <verse number="12" style="v" sid="MAT 1:12" />A kwasamadɗi ɗǝna nda tǝ kanda a Mbabila ɗǝ, Djokoniya nggǝtgha Sheyaltiyel,</para>
  <para style="li" vid="MAT 1:12">Sheyaltiyel nggǝtgha Dzerubabel,<verse eid="MAT 1:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="MAT 1:13" />Dzerubabel nggǝtgha Abihudu,</para>
  <para style="li" vid="MAT 1:13">Abihudu nggǝtgha Eliyakim,</para>
  <para style="li" vid="MAT 1:13">Eliyakim nggǝtgha Adzor,<verse eid="MAT 1:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="MAT 1:14" />Adzor nggǝtgha Dzadok,</para>
  <para style="li" vid="MAT 1:14">Dzadok nggǝtgha Akim,</para>
  <para style="li" vid="MAT 1:14">Akim nggǝtgha Eliyud,<verse eid="MAT 1:14" /></para>
  <para style="li">
    <verse number="15" style="v" sid="MAT 1:15" />Eliyud nggǝtgha Eleyadza,</para>
  <para style="li" vid="MAT 1:15">Eleyadza nggǝtgha Mattan,</para>
  <para style="li" vid="MAT 1:15">Mattan nggǝtgha Yakubu,<verse eid="MAT 1:15" /></para>
  <para style="li">
    <verse number="16" style="v" sid="MAT 1:16" />Yakubu nggǝtgha Yisufu, chimad Mairamu.</para>
  <para style="li" vid="MAT 1:16">Mairamu nggǝtgha Yeeso na nda aarha Ƙǝrǝsti.<verse eid="MAT 1:16" /></para>
  <para style="b" />
  <para style="m">
    <verse number="17" style="v" sid="MAT 1:17" />Chichiiya kumkap faɗa a thlakh mbǝd Ibrahim ɗǝgha thlakh mbǝd Ndauda ɗǝ. Thliirha a thlakh mbǝd Ndauda ɗǝgha hu sayidɗa ɗǝ ngyaɓang nanda tsaurha kanda fa a Mbabila, chichiiya kumkap faɗa ni. Thiirha ƙǝm a sayidɗi mal nanda Mbabila ɗǝgha hu sayidɗa ɗǝ nggǝt nanda Ƙǝrǝsti chichiiya kumkap faɗa ni.<verse eid="MAT 1:17" /></para>
  <para style="s">Nggǝtta Yeeso</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luka2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Kulo kwaman nggǝtta Yeeso Ƙǝrǝsti ya. A sayidɗi ngwanna Yisufu Mairamu man Yeeso, amma kanda kula kakhrha, ƙǝlagha Mairamu hai, nǝghǝn ahur yi Sǝsǝna tǝ Peɗǝnda. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yisufu ka niifa ni mbǝ midghǝn sǝ a fǝrang shilee nǝn Mairamu a yid fiya wa, ahu numadghǝn na midghǝn sǝ a kalghǝnǝn hai ɓǝɓee. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Amma ndǝghǝn hu numadɗi kee, ɓagha tǝthlǝnda Faara thlǝmadghǝn ɓa hu sǝsǝniirha ndanggǝn, “Yisufu, wan Ndauda, a tǝrǝmna kakh Mairamu wa, ƙǝsǝr huryidɗi keeghǝn yi Sǝsǝna tǝ Peɗǝnda ni. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Nǝn a nggǝt wee hǝshin, ɗǝfang thlǝma na Yeeso<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="fk">Yeeso:</char> Thlǝmɗi “Yeeso” tǝ mii Helenaya ni, ndǝna “Djeshiwa” tǝ mii Ibraniyaya. Thlǝmɗi ndaarha ni, “Faara tǝ hǝrǝkrha ni”</note> Ƙǝsǝr ndǝghǝn ni a hǝrghang nafiyighǝn ahu ɗimiyid ndan.”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Ənggini heu ya katǝra nǝn hai ka a lǝɗang ngganda ˈya ndana annabi.<verse eid="MAT 1:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />“Na wutararha a ɗǝfrha hur nggǝt wee hǝshin nǝn</para>
  <para style="q2" vid="MAT 1:23">ɗǝfang thlǝma nda Imaniyel.”</para>
  <para style="m" vid="MAT 1:23">Thlǝmɗi ndaarha ni, “Faara nǝghǝn tǝ ƙǝm ha.”<note caller="*" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">Ishaya7:14</ref></char></note><verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Mehenna Yisufu sǝ a ɓeena, takkwa ǝn ɗanǝn pǝrangna tǝthlǝnda Faara, kahanggǝn Mairamu. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Amma sǝngwa ndǝn wee nuwun wa, ƙǝl a kwasamadɗi nggǝt nǝn wee hǝshin, ɗǝfang thlǝma nǝn Yeeso. <note caller="*" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">Luka2:21</ref></char></note><verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Ɓad fasǝngya ɓa a man kyad yanfaara</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Akwasamadɗi nggǝt nanda Yeeso a Mbaitalami ahu chehweed Yahudiya, a thlakh mbed kutǝryid Hirdus, ɓagha fasǝngya a Urshelima ɓa a man kyad yanfaara ɓa. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />Tsakh mee nda, “Ai wanɗi nggǝt nanda kutǝr Yahudaya? Na ɗan wufǝlngarghǝn a man kyad yanfaara, ɓa nan ɓa ka a tǝrang shilee nan in.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Hǝrǝmna kutǝra Hirdus sǝkƙǝn kee, ɓillagha kaan, heu tǝ nafiya Urshelima. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Tǝrgha wumanggǝn mamngya firistaya ɓa, tǝ fasǝngya ngyakhrha Musa, tsahang mee nǝn kanda, “A yanggi na nda a nggǝt Ƙǝrǝsti?”<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />Ndang ngganda, “Ahu tal Mbaitalami hu chehweed Yahudiya, ƙǝsǝr chirethlengga annabi hai kee tǝ ndaarha:<verse eid="MAT 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘Amma sa ƙǝm Mbaitalami na hu chehweed Yahudiya,</para>
  <para style="q2" vid="MAT 2:6">ƙǝɗiwa ahur kutǝryid wupǝriya Yahuda wa.</para>
  <para style="q1" vid="MAT 2:6">Ƙǝsǝr a fadwa na kutǝra a kyarha ɓa,</para>
  <para style="q2" vid="MAT 2:6">nǝn a tsaurha tǝ lafrha nafina Isǝreela.’ ” <note caller="*" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">Meka5:2</ref></char></note><verse eid="MAT 2:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Tǝrgha Hirdus aah fasǝnggina nǝn ɓa ɓǝɓee, tsahang mee nǝn kanda sayidɗi na nanda wufǝlngarɗi. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Thlǝn kanda nǝn Mbaitalami ɗǝ ndanggǝn kanda, “Ɗama ɗǝ ɗun sǝye laɓar wanɗa ɓa ya tǝ sammayirha. A walangɗun, ɓamaɓa ɓun pǝreƙǝn nggima ɗiyaɗǝ ɗi tǝrang shilee teena.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />A kwasamadɗi sǝk nanda laɓarɗi ki kutǝra, thlii nda wii fayindan nda. Wufǝlngarɗi ˈwa nanda narha a man kyad yanfaara ɓa nagha a mbendan ɗǝgha isha a mbǝɗi na wanɗa sǝ. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Na nanda wufǝlngarɗi tǝk mbǝnda nda fa kaan. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Kyana nda mindǝɗa hai, na wanɗa nda tǝ man Mairamu, ɓǝra nda hai tǝrang shilee nda teena. Tǝrgha inang ngganda yawayindan ɗǝ fǝrang tǝfaasa nda tǝ urdi tǝ mur.<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />Yanang ngganda kanda ahu sǝsǝniirha a wunda tǝ thlǝmad Hirdus wa, nanǝn kee wuɗa nda tal ndan ɗǝ tǝ kwamana pak.<verse eid="MAT 2:12" /></para>
  <para style="s">Ɗanda Yisufu tǝ Mairamu a Masar ɗǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />A kwasamadɗi wiina fasǝnggini, tǝrgha tǝthlǝnda Chinǝm ɓagha thlǝmad Yisufu ɓa hu sǝsǝniirha ndanggǝn, “Thliusǝ, tǝrang wanɗi tǝ man ɗaana tǝ kanda a Masar ɗǝ. Tsawama a mbǝɗi ƙǝl a pǝrang ɗi ndǝn kun, ƙǝsǝr Hirdus nǝn a kaɗa wanɗi a ɓǝlanggǝn.”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Tǝrgha thliigha sǝ tǝranggǝn wanɗi tǝ man a fǝɗigɗi wiigha Masar ɗǝ. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Tsawa nda a mbǝɗi ƙǝl merna Hirdus. Ənɗiya katǝra nǝn hai ka a lǝɗang ngganda ǝnɗi ndaana Chinǝm a mii annabi, “Aah yi waana ɓa a Masar.” <note caller="*" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">Hodzaya11:1</ref></char></note><verse eid="MAT 2:15" /></para>
  <para style="s">Ɓǝlang Hirdus wangya hǝshya na nggu-ngguchit a Mbaitalami</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Ƙǝlana na Hirdus hai fasǝnggini na a man kyad fara ɓa pǝpǝlǝk ndan hai, sǝbgha hurghǝn ɗǝ kaan. Thlǝnanggǝn sodjaya ɗǝ a ɓǝlangganda wangya hǝshya ɗǝ na nggu-ngguchit a Mbaitalami tǝ tulayighǝn, sǝlna hura yindan sǝri tǝ fingya sǝlwawa, mǝmǝlla sayidɗi pǝrangna fasǝnggini kyana wufǝlngarɗa ɓa.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />Tǝrgha ˈya thlǝkna annabi Djermiya lǝghǝdɗǝ:<verse eid="MAT 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Sǝkɗǝm huhwaarha a Ramah,</para>
  <para style="q2" vid="MAT 2:18">tǝrha tǝ thlee hura,</para>
  <para style="q1" vid="MAT 2:18">Rachal a tǝrha ka wanggighǝn</para>
  <para style="q2" vid="MAT 2:18">karɗǝ nggabrha fa,</para>
  <para style="q1" vid="MAT 2:18">ƙǝsǝr mǝr wanggighǝn ɗǝ.” <note caller="*" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="JER 31:15">Irmiya31:15</ref></char></note><verse eid="MAT 2:18" /></para>
  <para style="s">Wutta Nadzarat ɗǝ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />A kwasamadɗi mǝrna Hirdus, tǝrgha tǝthlǝnda Chinǝm kyad fadghǝnǝn a Yisufu hu sǝsǝniirha a Masar, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />ndanggǝn, “Thliusǝ tǝrang wanɗiya tǝ man wuɗana chehweed Isǝreela ɗǝ, ƙǝsǝr nafini na a kaɗa yiɓǝd wanɗi mǝr nda ɗǝ.” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Tǝrgha Yisufu thliigha sǝ, tǝranggǝn wanɗi tǝ man wuɗa nda chehweed Isǝreela ɗǝ.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />Amma sǝknǝn wan Hirdus, Arkilus ni hu tsǝnggam chin, a ǝna kutǝryirha a chehweed Yahuda, tǝrǝm ɗǝrha nǝn mbǝɗaɗǝ. Yanangganda hu sǝsǝniirha a ɗǝɗa ɗǝ wa, tǝrgha kyalthgha chehweed Nggalili ɗǝ. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Ɗǝgha tsaurha ahu tala na nda aarha Nadzarat, lǝghǝdgha ˈya thlǝkna annabiya: “Na nda aaghǝn Tǝnadzarat.”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Tsahad Yahaya Tǝbaptisǝma</para>
  <para style="r">(<ref loc="MRK 1:1-8">Markus1:1-8</ref>; <ref loc="LUK 3:1-18">Luka3:1-18</ref>; <ref loc="JHN 1:19-28">Yahaya1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Akwasamad huraya Yahaya Tǝbaptisǝma a pǝr laɓar Faara a fiya a kaheerha na a chehweed Yahuda, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />nagha a ndaarha, “Malaman ɗimiyid nun, ƙǝsǝr Kutǝryid Talara nduwusɗa ɓa.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Niif ɗani ndaana annabi Ishaya:</para>
  <para style="b" vid="MAT 3:3" />
  <para style="q1" vid="MAT 3:3">“Urarha a aah farha a kaheerha,</para>
  <para style="q2" vid="MAT 3:3">‘Tangsaaman kwamana Chinǝm sǝ,</para>
  <para style="q2" vid="MAT 3:3">pǝpǝnaman kwaman sarya ɗǝ a ndǝghǝn.’ ” <note caller="*" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">Ishaya40:3</ref></char></note><verse eid="MAT 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Luwud Yahaya ǝnagha ndan tǝ was thlǝkhmu, ƙǝnanggǝn muwun tǝ paama. Ənnadghǝn mii mbeerha tǝ aam ɗee. <note caller="*" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 Kutǝrya1:8</ref></char></note><verse eid="MAT 3:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 3:5" />Fiya na a Urshalima tǝ Yahudiya heu tǝ chehweeya kahad na a mii kufad Urdun ɗǝnda thlǝmadghǝn ɗǝ. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Kanda a pǝr ɗimiyid ndan, nagha a ǝnang mbaptisǝma kanda a kufad Urdun.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Amma nana Yahaya Farisaya tǝ Sadukiyaya hangga a ɓarha mbǝɗa ɓa nǝn a ǝnang mbaptisǝma fiya sǝ, ndanggǝn kanda, “Kun huthlingya! Wun ƙǝsgha thlǝmad nun a ɗa sǝsad Faara nun hai na ɓayi? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Ənama ˈya kyadgha ndaarha malangɗun ɗimiyid nun. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />A numaɗun ndon kee, ‘Chichid nǝm ni Ibrahim, mbǝ Faara a sǝsang ƙǝm wa.’ Niya ndang nda kun na Faara tǝ sǝsǝmnda ha na a ǝnang wundakhnaya nǝn Ibrahim sǝ tǝ feryini ya. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />ˈWanda teena pangnda wurra a kul ɗǝfrha, kala ɗǝfrha mbuwa nggǝtta ngga nanda kyathlang nda ɗǝ muwangganda ahu waarha ɗǝ. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Niyi a ǝnang mbaptisǝma kun tǝ aama. Amma niifa sǝ na ɓayi kalgha nggi mu, tsǝkki na a kwasanggi sahad pahamggǝn hai wa, ndǝghǝnggi ɓanǝn ǝnang mbaptisǝma kun tǝ Sǝsǝna tǝ Peɗǝnda tǝ waarha. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Nǝghǝn tǝ ɗeng pǝra ha, nǝn a pǝrang ɗiɗiirha ɗǝ ngwanggǝn wan hwalidghǝn ahu ɓirukkun hai. Nǝn a njang nda ɗiɗidghǝn ɗǝ tǝ waarha mbuwa mǝra hai.”<verse eid="MAT 3:12" /></para>
  <para style="s">Mbaptisǝmad Yeeso</para>
  <para style="r">(<ref loc="MRK 1:9-11">Markus1:9-11</ref>; <ref loc="LUK 3:21-22">Luka3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Tǝrgha Yeeso thliigha a Nggalili ɗǝgha kufad Urdun ɗǝ ka a ǝnangga Yahaya mbaptisǝma. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Amma Yahaya karɗafa a ǝnang mbaptisǝma nǝn Yeeso, ndǝghǝn, “Kamɗǝ sani ǝne mbaptisǝma. Kama na ɓarha thlǝmanna ɓa?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Nggǝmangga Yeeso ndǝghǝn, “Nanǝnya ngwa tsauka kee, ƙǝsǝr kamɗǝ a lǝɗanggǝm ǝngya heu na mid Faara.” Tǝrgha nggǝmngga Yahaya fa.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Hǝrǝm nanda ǝnang mbaptisǝma Yeeso, kyanǝn sǝ ahur aamɗi kee, tǝrgha talara inggaɗǝ na Sǝsǝn Faara nǝn a tǝra hai ƙǝla tǝtiliurha tsauka a tenggǝn. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Sǝk urarha nda a talara hai, “Waana niya, nggǝmni, niyi a tǝk mbǝndǝghǝn fa kaan.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Ƙǝƙǝrang Sheetan Yeeso</para>
  <para style="r">(<ref loc="MRK 1:12-13">Markus1:12-13</ref>; <ref loc="LUK 4:1-13">Luka4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Tǝrgha Sǝsǝna tǝ Peɗǝnda ɗǝgha tǝ Yeeso a kaheerha ɗǝ ka a ƙǝƙǝrangga sheetan. <note caller="*" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="HEB 2:18">Ibraniyaya2:18</ref>; <ref loc="HEB 4:15">4:15</ref></char></note> <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Yeeso karɗǝ aama yi ɓeena kumnggit faɗa nda fǝɗigrha tǝ yan fara. Akwasamdghǝn ƙǝsgha miirha ndǝn. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Tǝrgha sheetan ɓagha thlǝmadghǝn ɓa ndanggǝn, “Ana Wan Faara ni sa, tsawang feryini ya ka mburodi.”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Amma nggǝmangga Yeeso ndanggǝn, “Nǝghǝn chichirethlee hai hu ɗeleewar Faara:</para>
  <para style="b" vid="MAT 4:4" />
  <para style="q1" vid="MAT 4:4">‘Mbǝ tǝ mburodi kee na niifa ƙǝra sǝ wa,</para>
  <para style="q2" vid="MAT 4:4">amma tǝ laɓaara na kyarha ɓa a mii Faara.’”<verse eid="MAT 4:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Tǝrgha sheetan tǝranggǝn Urshelima ɗǝ wupǝri tǝ Peɗǝnda, tǝranggǝn ten Ƙǝn Faara sǝ na a Urshelima. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />Ndanggǝn, “Ana Wan Faara ni sa, puru hweeɗe hai, ƙǝsǝr nǝghǝn chichirethlee hai hu ɗeleewar Faara,</para>
  <para style="b" vid="MAT 4:6" />
  <para style="q1" vid="MAT 4:6">‘Nǝn a ndang fathlǝnggighǝn a nggawo wa nda sǝ,</para>
  <para style="q2" vid="MAT 4:6">tǝ haryindan na nda a nggawo sǝ,</para>
  <para style="q2" vid="MAT 4:6">amana ɗǝghang sarwa feera fa.’ ”<verse eid="MAT 4:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Nggǝmangga Yeeso, “Nǝghǝn chichireethlee hai, ‘a ƙǝƙǝrangna Chinǝm Faarwa wa.’ ”<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Nggǝrgha Sheetan tǝrang nda a ten wumnda sǝ na nzang kyaɗang kutǝryid ƙǝshiirha nǝn heu tǝ mamnggitghǝn. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Ndanggǝn, “Ənggini heu ya niya furo ƙǝn, a ɓǝrna hai fǝree mamnggirha na.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Ndangga Yeeso, “Kalu kwamanna hai, Sheetan! Ƙǝsǝr nǝghǝn chichirethlee hai hu ɗeleewar Faara:</para>
  <para style="b" vid="MAT 4:10" />
  <para style="q1" vid="MAT 4:10">‘Tǝtani a ɗǝfang shilee na Chinǝm Faarwa in,</para>
  <para style="q2" vid="MAT 4:10">ndǝghǝn katenggǝn na fǝrang mamnggirha.’ ”<verse eid="MAT 4:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Tǝrgha Sheetan mal Yeeso nǝn. Ɓagha fathlǝngya Faara ɓa ƙǝlaghǝn ndaha.<verse eid="MAT 4:11" /></para>
  <para style="s">Ƙatǝrang Yeeso targhǝn hai a Nggalili</para>
  <para style="r">(<ref loc="MRK 1:14-15">Markus1:14-15</ref>; <ref loc="LUK 4:14-15">Luka4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Sǝkna Yeeso muwang nda Yahaya hu porsǝna ɗǝ, mal Yahudiya nǝn ɗǝgha Nggalili ɗǝ. <note caller="*" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="MAT 14:3">Matta14:3</ref>; <ref loc="MRK 6:17">Markus6:17</ref>; <ref loc="LUK 3:19-20">Luka3:19-20</ref></char></note> <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />ˈWa ɗǝrha nǝn Nadzarat ɗǝ a wudgha Kafarnahum ɗǝ na a mii wuri aama tǝ tsaurha, na a chehweed Dzebulu tǝ Naftali. <note caller="*" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">Yahaya2:12</ref></char></note> <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Ƙǝsǝr a lǝɗang ngganda ˈya ndana annabi Ishaya tǝ ndaarha:<verse eid="MAT 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Chehwed Dzebuluna tǝ chehweed Naftali,</para>
  <para style="q2" vid="MAT 4:15">kunna a kwaman wuri aama, tǝ ƙǝsǝr kufad Urdun,</para>
  <para style="q1" vid="MAT 4:15">tǝ ƙǝm chehweed Nggalili yi fingya mbuwa wa Yahudaya.<verse eid="MAT 4:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="MAT 4:16" />Nafiya na tsaurha a wula nanda kukwaryirha kaan,</para>
  <para style="q2" vid="MAT 4:16">Fingya na tsaurha a mishim mǝrra kyad kukwaryirha ɓa.”<note caller="*" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ISA 9:1">Ishaya9:1</ref></char></note><verse eid="MAT 4:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Ka a farɗi ndǝn katǝrangna Yeeso pǝr laɓar Faara hai, nagha a ndaarha, “Malaman ɗimiyid nun, ƙǝsǝr Kutǝryid Talara nduwusɗa ɓa.” <note caller="*" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Matta3:2</ref></char></note><verse eid="MAT 4:17" /></para>
  <para style="s">Katǝrang Yeeso wur fatsahayighǝn hai</para>
  <para style="r">(<ref loc="MRK 1:16-20">Markus1:16-20</ref>; <ref loc="LUK 5:1-11">Luka5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Nana Yeeso a wiirha hai a mii wuri aam Nggalili, na nafiya nǝn sǝri a wanmanggi nda Siman na nda aarha Mbiturus tǝ wanman Andǝrawus. Na nda a ƙǝs tǝngya tǝ panggamnggi ndan ahu wuri aamɗi ƙǝsǝr fa ƙǝs tǝngya ni.<verse eid="MAT 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 4:19" />Tǝrgha Yeeso ndanggǝn kanda, “Mbuwama samadna, niya tsawang kun fa ƙǝs fiya ɓa.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Tsu a mbǝɗi kee malangganda panggamnggi ndan mbu samadghǝn nda.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Chik nǝn ɗǝrha mbeeɗǝ, nggǝrghǝn na nafiya sǝri a wanmanggi, Yakubu wan Dzabadi tǝ wanman na Yahaya. Kanda ahu kombuwol chii ndan Dzabadi, a tangsang panggamnggi ndan ɗǝ, aagha Yeeso kanda. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Tsu a mbǝɗi kee malangganda kombuwol ndan tǝ chi ndan mbu samadghǝn nda.<verse eid="MAT 4:22" /></para>
  <para style="s">Tsahad Yeeso ha tǝ ƙǝm ƙǝnang ɗǝ fiya</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luka6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yeeso wengɗǝ chehweed Nggalili kahad nagha a tsahang fiya ha hu ƙǝn tsahad Yahudaya nagha a pǝr Laɓara na Mbǝnggǝn yi kutǝryid Faara, tǝ ƙǝnang nda fiya natǝ wanhaya ɗǝɗamǝn tǝ ɓeerha farha. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Laɓarghǝn ɗǝɗa ɗǝ inggun ta Suriya ɗǝ. Ɓang haya nda ɓa, heu tǝ fingya natǝ wanhaya fa ɗǝɗamǝn-ɗǝɗamǝn, fingya ƙǝnangna ǝnkaheeya kanda hai, tǝ kachelya tǝ fingya mǝrna fandan hai, ƙǝnanggǝn kanda heu. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Fiya hangga mbuwa samadghǝn, fingya a Nggalili ɓa, fingya hu chehweerha ɓa na nda aarha talya kum, fingya a Urshelima ɓa tǝ Yahudiya tǝ fingya ƙǝm a pǝm kufad Urdun ɓa.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Tsahad Yeeso ha aten parka a wumnda</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Hǝrǝmna Yeeso na fiya wumnda hai hangga, tǝrgha wumnda sǝ tsauka hai. Ɓagha fatsahayighǝn thlǝmadghǝn ɓa, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />katǝranggǝn tsahang kanda ha.<verse eid="MAT 5:2" /></para>
  <para style="s">Parka r (Luka 6:20-23)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />Fa parkayani nafiya sǝnggasǝ fa yamiya ni hu sǝsǝna,</para>
  <para style="q2" vid="MAT 5:3">ƙǝsǝr Kutǝryid Talara yi ndanni.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Fa parkayani nafiya na a tǝrha nanǝnya,</para>
  <para style="q2" vid="MAT 5:4">ƙǝsǝr na nda a nggab kanda.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Fa parkayani nafiya mbuwa tǝrang tendan sǝ,</para>
  <para style="q2" vid="MAT 5:5">ƙǝsǝr na nda a har langad ƙǝshiirha.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Fa parkayani nafiya na miirha a ƙǝsa tǝ hushim nggayirha;</para>
  <para style="q2" vid="MAT 5:6">ƙǝsǝr nun a nggaala!<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Fa parkaya ni nafiya na fiya a haɗang kanda fa,</para>
  <para style="q2" vid="MAT 5:7">ƙǝsǝr na nda a haɗang Faara fa.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Fa parkayani nafiya na hur ndan chahal,</para>
  <para style="q2" vid="MAT 5:8">ƙǝsǝr na nda ana Faara.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Fa parkayani nafiya na ɓang tsau ɗǝɗemnggirha,</para>
  <para style="q2" vid="MAT 5:9">ƙǝsǝr na nda aah kanda wangya Faara.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Fa parkayani nafiya na a sǝsaarha ka nggayirha,</para>
  <para style="q2" vid="MAT 5:10">ƙǝsǝr Kutǝryid Talara yi ndanni.<verse eid="MAT 5:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Fa parkayani kun, ana fiya a ˈyar kun, sǝsangganda kun, kanda a nggaɓa kun tǝ ndaarha fa mbǝlfeeya ni kun, ƙǝsǝr ka nggi. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Ənama wutsǝfayirha tǝ tǝk mbǝnda fa, nun wal ƙǝnaghǝn hangga a talara. Ƙǝsǝr annabiya na ƙǝtǝm sǝsangganda kanda kee.<verse eid="MAT 5:12" /></para>
  <para style="s">Tsahad Yeeso ha aten fǝsa tǝ kukwaryirha</para>
  <para style="r">(<ref loc="MRK 9:50">Markus9:50</ref>; <ref loc="LUK 14:34-35">Luka14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Kunni fǝs ƙǝshiirha. Amma a tǝr mbǝnda fǝsa ɗǝ, ƙǝƙǝn nǝm nggǝr nggǝrang ɓa? Ɓalwa targhǝn sǝ wa, ƙǝl iraɗǝ kee ishangga fiya hai.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Kunni kukwaryid ƙǝshiirha. Wupǝri na a mbǝrha na ɗangkam mbǝ ɓǝɓeerha hai wa. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Tǝ ƙǝm mbǝm njang patilla tsǝɓanggǝm tǝ tǝɓa wa. A meghedghǝn nǝm ɗǝfang nda a mbǝd wagrǝghǝn tǝnǝn fǝrang kukwaryirha fiya na ahur mindǝɗi. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Nǝghǝn kee ƙǝm, ngwa njargha kukwaryid nun hai a mbed fiya naghǝn nda, tǝna kowunni fal Chinun na a talara. <note caller="*" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1 Mbiturus2:12</ref></char></note><verse eid="MAT 5:16" /></para>
  <para style="s">Tsahad Yeeso ha aten ngyakhrha</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />A numaɗun ndon ɓani ɓa ka ɓi weleng ngyakhrha Musa ɗǝ tǝ yi annabiya wa. Ɓawi ɓa ka ɓi weleng kanda ɗǝ wa, amma ka ɓi lǝɗang nda kanda. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Niya pǝrang ƙǝkafek kun, ƙǝl ma ngwala talara tǝ hweeɗe, mbǝ ˈyasǝ na ngguchit a ƙǝtta ɗǝ hu ngyakhrha Musa wa, ƙǝl ma lǝghǝdɗǝ heu. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Kala niifa tǝɗangga yanɗi na ngguchit ahu ngyakhkini teena ya, tsahang nggǝnǝn fiya ha ƙǝm, nǝn a tsaurha ngguchit hu Kutǝryid Talara. Kala niifa ƙǝm ǝnagha taara tǝ ngyakhkiniya tsahanggǝn nǝn fiya ha ƙǝm nǝn a tsaurha manggǝn hu Kutǝryid Talara. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Niya ndang nda kun, a kalwa nggayid nun yi fasǝngya ngyakhrha Musa tǝ yi Farisaya wa, mbun tam kyarha hu Kutǝryid Talara ɗǝ wa.<verse eid="MAT 5:20" /></para>
  <para style="s">Tsahad Yeeso ha aten sǝbrha hura</para>
  <para style="r">(<ref loc="LUK 12:57-59">Luka12:57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“Sǝkɗun ˈya ndang nanda chichiyinǝm kaar tǝ ndaarha, ‘A ɓǝlɗun farha wa, kala niifa ɓǝlgha farha na a nda a ngwang kumarha sǝ.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Amma nggi ƙǝm niya ndang nda kun, kala niifa sǝbna hurghǝn ɗǝ tǝ shadghǝn na nda a ngwang kumarha sǝ. Niya nggǝr ndang nda kun niifa ndangga shadghǝn, ‘Ka wuɗe,’ na nda ɗǝrha tǝghǝn mbed fa ngwa kumaaya ɗǝ. Amma niifa ndangga shadghǝn, ‘Nura!’ na nda a muwang nda hu waarha ɗǝ mbuwa mǝra hai.”<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />“Tsaunǝn kee, a nanna a fǝr ǝn fǝrrǝwa a Faara a mbǝd sataka, a ɗalna teena hai sǝɓang na hur shadwa ɗǝ, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />malu ǝn fǝrrǝwa a mbǝd sataka. Ɗuwa ɗǝ ˈwan ɗun tangsang pathlang nun tǝ shadwa, tǝrgha a ɓana ɓa, ɓa ɗǝrha mbeeɗǝ tǝ fǝrrǝwa. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />A huhwad niifa sa, kaɗu kwamana na a tangsanggun pathlang nun ƙǝkar kapa nun sǝla kǝn ngwa kumarha ɗǝ. A karna fa, ɗǝnǝn tǝsa a mbed tǝ ngwa kumarha ɗǝ. Tǝ ngwa kumarha ƙǝm nǝn fǝrang sa wan sǝsalya. Wan sǝsalya ƙǝm na nda muworha hu porsǝna. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Niya pǝro ƙǝkafek, mba kyarhaɓa wa ƙǝl tiina ǝnɗi kyo nanda heu.”<verse eid="MAT 5:26" /></para>
  <para style="s">Tsaharha Yeeso ha aten kulafayirha</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“Sǝkɗun ndǝn tǝ ndaarha, ‘A ǝnanna kulafayirha wa.’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Amma nggi ƙǝm niya ndang nda kun kala niifa ƙǝlangga nuneefa sunaghǝnǝn ˈwaɗǝ teena ǝnaɗǝ kulafayirha tǝghǝn ahurghǝn. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />A kyo yidwa yisǝma hu ɗimiyirha hai, kutethleng sǝ muwangga ɗǝ. A nggushi ƙǝɗeng na patu tal a fadwa ma muwangganda fadwa heu ahu waarha ɗǝ mbuwa mǝra hai. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Ana harwa yisǝma a kyorha hu ɗimiyirha hai, kyathlang ɗǝ muwangga ɗǝ. A nggushi ƙǝɗeng na patu tal a fadwa ma muwangganda fadwa heu ahu waarha ɗǝ mbuwa mǝra hai.”<verse eid="MAT 5:30" /></para>
  <para style="s">Tsahad Yeeso ha aten mǝrra kakhrha</para>
  <para style="r">(<ref loc="MAT 19:9">Matta19:9</ref>; <ref loc="MRK 10:11-12">Markus10:11-12</ref>; <ref loc="LUK 16:18">Luka16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“Thlǝk ndan tǝ ndaarha, ‘Kala niifa kalgha nukkun hai tsawang ɗafa tǝta a chireethleng ɗeleewar nǝn sǝ yi kala hai.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Amma nggi ƙǝm niya ndang nda kun kala niifa kalgha nukkun hai a mbǝ aten ɗimid kulafayirha wa, kyang nǝn hu kulafayirha hai. Kala niifa ƙǝm kakhka nuneefa kal nanda hai ǝnanǝn kulafayirha.”<note caller="*" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">Matta19:9</ref>; <ref loc="MRK 10:11-12">Markus10:11-12</ref>; <ref loc="LUK 16:18">Luka16:18</ref>; <ref loc="1CO 7:10-11">1 Korontiyaya7:10-11</ref></char></note><verse eid="MAT 5:32" /></para>
  <para style="s">Tsahad Yeeso ha aten ɗǝfmee</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“Nggǝr ɗun sǝkƙǝn a mii chichiiyi nǝm kaar tǝ ndaarha, ‘A tǝɗang ɗun ˈya in ndaanun a Faara wa, amma ƙǝsaama ɗǝfmi nun ha ǝna nun a Chinǝm.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Amma nggi niya ndang nda kun, a ɗǝf ɗun mee tǝ thlǝm talara wa, ƙǝsǝr mbǝd tsawud Faara ni. <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />A ɗǝf ɗun mee tǝ thlǝm hweeɗe wa, ƙǝsǝr ndǝna mbǝd yiɓǝd sar Faara. A ɗǝf ɗun mee tǝ thlǝm Urshalima wa, ƙǝsǝr wupǝri ni yi Faara, kutǝra na manggǝn. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />A ɗǝf ɗun mee tǝ thlǝm ten nun wa, ƙǝsǝr mbun mbang nggǝrang was nun hai tsauka pǝpet nduwa iˈim wa. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />ˈYa kamngga kee, ‘Yoo’ tsauka ‘Yoo,’ tǝ ƙǝm ‘Awo’ tsauka ‘Awo.’ Kala laɓaara kalgha yanɗamu ya kyaghǝn ɓa a mii tǝmbǝlfedɗi.”<verse eid="MAT 5:37" /></para>
  <para style="s">Tsahad Yeeso ha aten nggǝr haara mu</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luka6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“Sǝkɗun ndǝn tǝ ndaarha, ‘Yirha a meghed yirha, thlaana a meghed thlaana.’ <note caller="*" style="x"><char style="xo" closed="false">5:38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">Kyarhaɓa21:24</ref>; <ref loc="LEV 24:20">Livitikus24:20</ref>; <ref loc="JDG 19:21">Ɗeleewar fa ngwa kumaya19:21</ref></char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Amma niya ndang nda kun, a karɗun tǝ mbǝlfeerha fa wa. A mbi niifa sa hu ƙǝmeng wa yisǝma, kyakhrang man patu ɓa ƙǝm. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />A huhwad niifa sa ka a thlanggǝn luwudwa, fǝrang kaɓad wa ƙǝm. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />A ngyaɓo niifa hu wiirha hai mel tal, weema ɗǝ kyab mel sǝri. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Kala niifa hwanowa ˈya, fǝrang, kala niifa kaɗagha kumarha a harwa a ˈyaɗang na wa.”<verse eid="MAT 5:42" /></para>
  <para style="s">Nggǝmama fa tsangginun</para>
  <para style="r">(<ref loc="LUK 6:27-28">Luka6:27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“Sǝkɗun ndǝn tǝ ndaarha, ‘Nggǝmama tula yinun kar fatsan ngginun nun.’ <note caller="*" style="x"><char style="xo" closed="false">5:43 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Livitikus19:18</ref></char></note> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Amma niya ndang nda kun, nggǝmama fa tsangginun, hwana man Faara nafiya teena na a sǝsang kun. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />A naɗun kee, nun tsaurha wangya Faara na a talara, ƙǝsǝr nǝn fǝr yanfaara a ka nafiya tǝ fa mbǝlfeeya. Nǝn ɓa ˈyaara a nafiya na tǝ nggayirha fa tǝ fingya mbuwa tǝ nggayirha fa. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Ana ɗun a nggǝm nafiya na a nggǝm kun kee, ƙǝƙǝn nun wal parka? Ko fathlǝ tsamngya ni ma mbǝna nda ǝnaarha kee wa? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />A naɗun a ǝna nggayirha a pashiyi nun kee, ma nun a ǝnaarha kalgha fingya mu? Mbǝna fa ɗahaya ǝnaarha kee wa? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Amma tsawama lǝlǝgɗa ƙǝla nana Chinun na a talara lǝlǝgɗa.”<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Tsahad Yeeso ha aten ǝnfǝra</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Kwarama a kyad ɗun nggayirha a mbed fiya ka a na kun nda wa. A ǝna ɗun kee, mbun wal ƙǝnaghǝn a har chinun na a talara wa.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />A naɗun a fǝra a kalɗun miighǝn ɗǝ ƙǝla na fa thlǝrɓuya ǝnaarha hu Ƙǝn Faara, tǝ ten kwamangya, ahur wure ka a fal kanda nda wa. Niya pǝrang ƙǝkafek kun, ˈWanda teena thlǝnda yi ndan ƙǝna. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Amma a naɗun a fǝrang niifa ˈya na midghǝn, a nggǝmɗun fa sǝngga yi kawa ˈya na yisǝma a fǝra wa. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />No a fǝra ɓǝɓee, tǝrgha tsu na a na ˈya na a ǝnaarha ɓǝɓee nǝn a fǝro ƙǝnaghǝn.<verse eid="MAT 6:4" /></para>
  <para style="s">Tsaharha ha aten hwan Faara</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luka11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“Anaɗun a hwan Faara, a ǝna ɗun ƙǝla fa thlǝrɓuya wa. Ƙǝsǝr kanda na mindan sǝ hwan Faara ƙǝt ƙǝkǝɗa a ƙǝngya yi hwan Faara, tǝ ƙǝm aten kwamangya ahur tala ka a nagha fiya kanda. Niya pǝrang ƙǝkafek kun ˈwanda teena wal nda ƙǝna ndan. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Amma anaɗun a hwan Faara, kyama hur ƙǝnna ɗǝ, nggǝlang nggun kwatminda a hwanang nggun chinun, mbuwawa nǝm a naarha. Tǝrgha Chinun, na a na ˈya ɓǝɓee, nǝn a fǝrang ƙǝnaghǝn kun.”<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />“Anaɗun a hwan Faara, a nggurɓang ɗun ˈya nun a thlǝkrha ƙǝla nafiya sǝngwa Faara na a ǝnaarha wa. Tamngganda ndaarha na nda sǝk fandan a nanda a nggurɓang pathla mu. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />A tsauɗun ƙǝla kanda wa, ƙǝsǝr Chinun sǝnɗǝ ˈya na minnun kapa nun tsahang mee. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Hwanama kiya.”</para>
  <para style="b" vid="MAT 6:9" />
  <para style="q1" vid="MAT 6:9">“Chinǝm na a talara</para>
  <para style="q2" vid="MAT 6:9">a chilɓi thlǝm wa nǝm ha.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Kutǝryid wa ɓagha ɓa.</para>
  <para style="q2" vid="MAT 6:10">ˈYa na midwa a ǝnaghǝnan,</para>
  <para style="q2" vid="MAT 6:10">hu ƙǝshiirha ƙǝla yanɗi na nanda a ǝnaarha a talara<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Fǝrang ǝnnadmid par fara kan.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Chahang ɗimiyid nan kanɗǝ,</para>
  <para style="q2" vid="MAT 6:12">ƙǝla nan chahanggǝn fingyaɗǝ na a ǝnang ɗimiyirha kan fa.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />A ɗǝnna tǝ kan hu ƙǝƙǝrra ɗǝ wa,</para>
  <para style="q2" vid="MAT 6:13">amma hǝrghang kan a haar tǝmbǝlfedɗi.”<verse eid="MAT 6:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Ƙǝsǝr a chahang ɗun ɗimiyindan fiyaɗǝ ǝnangga ɗimiyirha kun fa, Chinun na a talara ƙǝm nǝn a chahang ɗimiyid nun kun ɗǝ. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Amma a chahang nggun ɗimiyid ndan fiya ɗǝ wa, Chinun na a talara ƙǝm mbǝ chahang ɗimiyid nun kun ɗǝ wa.<verse eid="MAT 6:15" /></para>
  <para style="s">Tsaharha ha aten kar aama</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“Anaɗun a kar aama, a ndeng ɗun yid nun hai ƙǝla na fa thlǝrɓuya ǝnaarha wa, ƙǝsǝr na nda ndeng yindan hai tǝna fiya sǝndasǝ na nda a kar aama. Niya pǝrang ƙǝkafek kun, ˈwanda teena thlǝnda ƙǝna ndan. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Amma ana ɗun a kar aama, tsǝtsǝɗang was wa ƙǝm fǝɗeerha na aten wa, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />amana fiya sǝnda sǝ nun a kar aama. Chinun mbuwawa nǝm a naarha, na a na ˈya nǝm a ǝnaarha ɓǝɓee, nǝn a fǝrang ƙǝnaghǝn kun.”<verse eid="MAT 6:18" /></para>
  <para style="s">Tsaharha ha aten wumnda ƙǝna a talara</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luka12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“A ɗǝfang ɗun ƙǝna alten nun ɗǝ hu ƙǝshidɗiya, na mǝmemngya tǝ hǝla sǝɓang nda ɗǝ, tǝ ƙǝm na ngaarya kyarha ɗǝ tǝrang ngganda wa. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Amma ɗǝfa man ƙǝna altennun ɗǝ a talara, mbuwana mǝmemngya tǝ hǝla sǝɓang ɗǝ, tǝ ƙǝm mbuwana ngaarya kyarha ɗǝ ngaara nda. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Ƙǝsǝr kala mbǝrha nana ƙǝnawa sǝ ndǝna mbǝd numad wa.”<verse eid="MAT 6:21" /></para>
  <para style="s">Kukwaryid farha</para>
  <para style="r">(<ref loc="LUK 11:34-36">Luka11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />Yirha ndǝna kukwaryid farha, ana yidwa kanglang hai, fadwa na heu nǝn narha lǝlǝgɗa tǝ kukwaryirha. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Amma a mbǝ yidwa kanglang hai wa, fadwa na heu nǝn narha tǝ wula. Ana kukwaryirha na a fadwa wulani, fadwa na heu nǝn narha tikɗik.<verse eid="MAT 6:23" /></para>
  <para style="s">Manang nda Faara wa nduwa ƙǝna wa</para>
  <para style="r">(<ref loc="LUK 16:13">Luka16:13</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“Mbǝ mafarha sǝ na ǝnang taara turaya sǝri wa. Tsauɗǝ nǝn nggǝm tal kar tahadghǝnǝn, nduwa ƙǝm mananggǝn tal sar tahadghǝnǝn. Mbǝ ǝnaarha hai ǝnang taara nun Faara tǝ wuɗǝɓǝla kyab wa.”<verse eid="MAT 6:24" /></para>
  <para style="s">A ɓillaɗun wa</para>
  <para style="r">(<ref loc="LUK 12:22-31">Luka12:22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Tsaunǝn kee, niya ndang nda kun, a ɓillaɗun tǝ yiɓǝd nun wa, tǝ ˈya nun ǝnnarhami tǝ sarha wa, nduwa fannun ˈya nun kala fa wa. Kalwa yiɓǝd nun ǝnnarhami wa, nduwa kalwa fannun ˈya nun a kala fa wa? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Kǝla man wuɗikkya lee! Mba nda hǝfrha wa, mba nda haathla wa, mba nda tǝ ƙǝn ǝnnarhami nduwa ɓiriukya wa, ko nanǝn kee na Faara fǝrang ǝnnarhami kanda. Sǝngunsǝ mamnggit nun kalɗǝ yi wuɗikkya wa? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Wunni ahur nun aten ɓilladghǝn na mbang chik ɓenggǝn hu ƙǝshiirha?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />Kama nun ɓillarha aten lukkya? Kǝla man fid ɗǝfya na tsǝrha. Mba nda ǝna taara, ko pu kaɓarha wa. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Ko nanǝn kee, niya ndang nda kun, ko kutǝra Sulemanu tǝ mamnggitghǝn ˈwa wa ngwarha fa ƙǝla tal ahur ndan wa. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Ana Faara a ngwang nda fid ɗǝfya fa na a hee kiya, hwaliirha nasǝ a weeriya, a ɓinda ƙǝm njigha ɗǝ, sakkwa kun nǝn ngwang kun fa. Kama nanun tǝ yamid fǝrƙǝkafek?<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />“Nanǝn kee a ɓillaɗun aten ǝngginiya tǝ ndaarha, ‘Ma nan ǝnnarhami? Nduwa, ma nan saarha? Nduwa, ma nan kala fa?’” <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Ƙǝsǝr nafiya sǝngwa Faara ndǝna kaɗa tur ǝngginiya, Chinun na a talara sǝnɗasǝ na minnun sǝ ǝngginiya. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Kaɗama kutǝryid Faara ˈwan tǝ ǝna nggayirha, ǝnggini na heu ƙǝmya nǝn a fǝranggǝn kun. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Tsaunǝn kee, a ɓillaɗun tǝ ɓinda wa, ƙǝsǝr ɓinda nǝn a ɓarha ɓa tǝ ɓilladghǝn. Kala parra yanfaara nǝghǝn tǝ ɓillad altenggǝn.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Tsahad Yeeso ha aten ngwang kumarha fingya</para>
  <para style="r">(<ref loc="LUK 6:37-38">Luka6:37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“A ngwangɗun kumarha fingya wa, kun nggima mba nda ngwang kumarha kun wa. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Ƙǝsǝr na nda a ǝnang nda kun ƙǝla ǝnang nun fingya. Tasau nun a ƙǝƙǝrang fiya sǝ ndǝna nda ƙǝƙǝrang nda kun sǝ. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Mani na ƙǝlang hwaliirha na a yid shadwa, sa kula ƙǝɗang miwaarha ɗǝ na a yidwa? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Ƙǝƙǝn na ndang nda shadwa, ‘Wanya ni a ƙǝɗo hwaliirha ɗǝ a yidwa’ kula sa na miwaarha na yidwa? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Sa tǝthlǝrɓu! Katǝrang ƙǝɗang miwadɗǝ ˈwan na yidwa tǝna na mana hai ngga, na a mbangga ƙǝɗang hwaliirha ɗǝ na yid shadwa.”<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />A fǝrang ɗun ˈya wuɗaya na chahal wa. A tsamang ɗun ǝn thlǝmaaya ɗǝ tǝ ǝn uraya natǝ wuɗǝɓǝla fa a ƙǝlengarya ɗǝ wa. A ǝna ɗun kee, na nda ishang hai a kamu saryi ndan. Na wuɗa yini a kyaharra hai njarang ngganda kun ɗǝ kushir-kushir.<verse eid="MAT 7:6" /></para>
  <para style="s">Tsaharha ha aten hwan Faara</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luka11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Naama a hwanda na nda fǝrang kun. Naama a kaɗaarha nun a waala. Naama a ɗǝk kwatminda, na nda inanggǝn kun hai. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Ƙǝsǝr kala niifa hwangga, na nda a fǝrang, niifa kaɗagha ƙǝm nǝn a waala. Kǝmɗarha kala niifa ɗǝkka kwatminda nanda inanggǝn hai.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />Wunni ahur nun, a hwanang wanggǝn mburodi fǝrang feera nǝn? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Nduwa a hwanang ɗǝ tǝna fǝrang hulthne nǝn? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />A tsauɗǝ, kun na fa mbǝlfeeya sǝnɗun ˈya nun fǝrang nda wangginun ǝngya na ngga, sakwata chinun a talara, nǝn fǝr ǝngya na ngga a nafiya na hwanda.<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />Tsaunǝn kee, ǝnaman ˈya fiya ƙǝla na mid nun a ǝnang ngganda kun. Ƙǝsǝr tsahad ngyakhrha Ɗeleewar Musa niya tǝ yi annabiya.<verse eid="MAT 7:12" /></para>
  <para style="s">Tsaharha ha aten kwatkirma na iˈyaɓa</para>
  <para style="r">(<ref loc="LUK 13:24">Luka13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Kyarha hu kutǝryid Faara ɗǝ tǝtani kyana tǝ kwatkirma na iˈyaɓa. Kwaman ɗǝrha hu waarha ɗǝ nǝghǝn manggǝn, kwatkirǝm nggǝn ƙǝm nǝghǝn ƙǝthlǝng, nafiya hangga wurgha kwaman ɗi. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Kwatkirǝm wal yibrha nǝghǝn ngguchit, tǝ ƙǝm kwamanggǝn nǝghǝn pǝɗaghǝn, nafiya na a kyarha sǝ na nda ngguchit.<verse eid="MAT 7:14" /></para>
  <para style="s">Tsahad Yeeso ha aten annabiya fa nggaɓaya</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luka6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Kwarama tǝ annabiya fa nggaɓaya. Na nda ɓarha thlǝmad nun ɓa tǝ lukrha fa ƙǝla chauraya, amma hur ndan nǝghǝn ƙǝla mǝmereeya. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Nǝm sǝnang kanda hai ahu ǝn ǝnad ndan ƙǝla nǝm sǝn ɗǝfrha tǝ tur wanggighǝn. Mbǝm ɗakh wan inabi ɓa a fad ndaha wa, nduwa wan shiɓarha a fad ndakh mbǝlfeerha wa.<verse eid="MAT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 7:17" />Ɗǝfrha na ngga nǝn nggǝt wan ɗǝfrha na ngga, ɗǝfrha mbuwawa ngga nǝn nggǝt wan ɗǝfrha mbuwawa ngga. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Ɗǝfrha na ngga mbǝ nggǝt wan ɗǝfrha mbuwawa ngga wa, tǝ ƙǝm ɗǝfrha mbuwawa ngga mbǝ nggǝt wan ɗǝfrha na ngga wa. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Kala ɗǝfrha mbuwa nggǝt wan ɗǝfya ngga na nda kyathlang ɗǝ muwang ngganda ahu waarha ɗǝ. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Nǝghǝn kee, ƙǝla nǝm sǝnang ɗǝfrha hai tǝ tur wanggighǝn, nǝm sǝnang annabiya fa nggaɓaya hai kee ƙǝm tǝ ǝn ǝnad ndan.<verse eid="MAT 7:20" /></para>
  <para style="s">Tsahad Yeeso ha aten kyaarha hu Kutǝryid Talara ɗǝ</para>
  <para style="r">(<ref loc="LUK 13:25-27">Luka13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“Mbǝ fiya heu na a aah nggi, ‘Chinǝm, Chinǝm,’ na a kyarha hu Kutǝryid Talara ɗǝ wa, amma ƙǝl nafini ǝnagha ˈya na mid Pǝpa na a talara.” <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />“Nafiya hangga na a ndeerha a farɗi, ‘Chinǝm, Chinǝm,’ pǝr ɗan laɓar Faara tǝ thlǝmwa, tǝ ƙǝm kyang ɗan ǝnkaheeya sǝ tǝ thlǝmwa, tǝ ƙǝm ǝna ɗan ǝnwulteengya hangga tǝ thlǝmwa.” <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />“Amma niya nggǝrang kanda sǝ, ‘ˈwawi sǝn kun wa. Weema ma thlǝmadna kun fa mbǝlfeeya!’”<verse eid="MAT 7:23" /></para>
  <para style="s">Karapu aten fa tǝngya sǝri</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luka6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Kala niifa kang ngga thlǝmaarha tsahad na fa ǝna taara nǝn sǝ nǝghǝn ndǝndǝl, kǝla niifa tǝngga wurighǝn aten feera. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Ɓana ˈyaara hai, lǝghǝdgha kufaarha, ɗǝkka ɓereu ˈyaara wuriɗi amma mbangwa chang hai wa, ƙǝsǝr tǝngga ndan aten feera.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />“Amma niifa sǝkka tsahad na ǝnawa taara sǝ wa, nǝghǝn ƙǝla nur niifa tǝngga wurighǝn aten chehweerha. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Ɓana ˈyaara hai, lǝghǝdgha kufaarha, ɗǝkka ɓereu ˈyaara wuriɗi chang nggǝn hai hwaf.”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Ngwalang na Yeeso tsahadghǝn ha, fiya wumngga hai ǝna ǝnwulteena nda aten tsahadghǝn ha. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Ƙǝsǝr tsahadghǝn ha nǝghǝn ƙǝla niifa na tǝ sǝsǝmnda, mbǝ ƙǝla fatsahaya yi ngyakhrha wa.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Tsaɓang Yeeso niifa ɗǝ na tǝ wanhad termeerha</para>
  <para style="r">(<ref loc="MRK 1:40-45">Markus1:40-45</ref>; <ref loc="LUK 5:12-16">Luka5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Tǝrna Yeeso hai a wumnda, takkwagha fiya ndǝn hangga. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Na niifa sǝ na tǝ wanhad termeerha fa, nanǝn Yeeso ɗǝgha thlǝmadghǝn ɗǝ, ɓǝrgha hai a mbedghǝn hwanggǝn nǝn ndanggǝn, “Chinǝm, a nggǝmna fa na mbang tsaɓeeɗǝ.” <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Tǝrgha Yeeso fǝr harghǝnǝn ɗǝ tsuwarghǝnǝn fa ndanggǝn, “Nggǝmɗi fa a tsaɓana ɗǝ. Tsaɓuɗǝ!” A mbǝɗi tsu kee, termedɗi ndǝkka hai tǝghǝn. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Tǝrgha ƙǝsgha Yeeso thlǝmadghǝn ndanggǝn, “A pǝrang nan niifa wa, amma ɗuwaɗǝ kyaɗang fadwa firis na sa nǝn. A ǝno sataka tǝna fiya sǝndasǝ tsabnaɗǝ kǝla ndana ngyakhrha Musa.”<verse eid="MAT 8:4" /></para>
  <para style="s">Yeeso ƙǝnang ɗǝ mafad mamnda sodja Romaya</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luka7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Kyana Yeeso Kafarnahum hai, ɓagha mamnda sodja Romaya thlǝmadghǝn ɓa hwanggǝn nǝn ndanggǝn, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“Chinǝm, mafadna kalth a wuri mbǝ kanglang wa, mǝr fadghǝn hai nǝghǝn a sǝsarha kaan.” <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Ndangga Yeeso, “Niya ɗǝrhaɗǝ ɗi ƙǝnang nda.”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Tǝrgha mamnda sodja Romaya nggǝmanggǝn Yeeso ndanggǝn, “Chinǝm, tsǝkki na a ɓana minda kyana ɓa wa, amma a nggǝmna fa kalu sǝ kee a mbǝɗi na nana na mafanna a ƙǝnda. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Ƙǝsǝr nggi niyi akamu ngyakhrha niifa, ƙǝmɗa tǝ sodjaya a kamuna. Ni ndangnda yanɗiya, ‘ɗuwaɗǝ’, nǝn ɗǝrhaɗǝ; yanɗi taarha ƙǝm ndanggi ˈɓoɓaˈ, nǝn a ɓarha ɓa, ndanggi mafanna, ǝno kiya, ǝnagha ƙǝla ndangni.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Sǝkna Yeeso ndǝn kee, wulangga teena. Kyahargha hai ndanggǝn nafini na a mbu samadghǝn, “Niya ndang nda kun, ahur Isǝreela ˈwawi wal niifa tǝ fǝrƙǝkafek fa tǝ kanglanggirha ƙǝla yanɗiya wa.” <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />“Niya ndang nda kun, fiya hangga na a ɓarha ɓa a man kyad yanfaara tǝ man hǝmndǝghǝn, na nda a tǝr mbǝd tsawud ndan tǝ Ibrahim, tǝ Ishaku tǝ Yakubu ahu wutsǝfayidɗi hu Kutǝryid Talara. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Amma Isǝreelaya hangga kya nanda ǝna Kutǝryidɗi ka kanda, nanda a muwang kanda ahu wula ɗǝ, a mbǝɗani na nanda a tǝrha sǝ tǝ ƙǝt mee.” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Tǝrgha ndangga Yeeso mamnda sodja Romadɗi, “Wuɗu wureeɗǝ, ka fǝrƙǝkafekkid wa ni ǝnagha ndǝn katǝra nǝn hai kee.” Mafadɗi keeghǝn ƙǝngga mǝmǝlla sayidɗi wu.<verse eid="MAT 8:13" /></para>
  <para style="s">Ƙǝnang Yeeso fiya hangga</para>
  <para style="r">(<ref loc="MRK 1:29-34">Markus1:29-34</ref>; <ref loc="LUK 4:38-41">Luka4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Sǝlna Yeeso a minda ki Mbiturus ɗǝ, ɗǝgha wal thlaɓǝr Mbiturus tǝnuwunda fadghǝn ɓee kalth hu sǝra. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Tsuwargha Yeeso harghǝn fa, ƙǝngga. Tǝrgha thliigha sǝ fǝrang ǝnnarhami nǝn. <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />Tsǝna figrha hai, nafiya natǝ ǝnkaheeya fa hangga ɓa nda tǝ kanda thlǝmad Yeeso ɓa. Kyanggǝn ǝnkaheeyina sǝ tǝ mee kee, tǝ ƙǝm ƙǝnanggǝn haaya heu. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Ənanǝn ǝnɗiya ka a lǝghǝdgha laɓarɗi thlǝkna Chinǝm tǝ mii annabi Ishaya, ndanǝn:</para>
  <para style="b" vid="MAT 8:17" />
  <para style="q1" vid="MAT 8:17">“Tǝrang ɗǝ ɓeerha fayi nǝm,</para>
  <para style="q2" vid="MAT 8:17">tǝ ƙǝm ƙǝɗanggǝn wanhayi nǝm ɗǝ.” <note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false">Ishaya 53:4 </char></note><verse eid="MAT 8:17" /></para>
  <para style="s">Pǝɗayid mbu samad Yeeso</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luka9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Ƙǝlang na Yeeso fiya wumngga thlǝmadghǝn ɓa, ndanggǝn fatsahayighǝn a ɗǝnda pǝm wuri aama Nggalili ɗǝ. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Tǝrgha tal ahur famalǝmngya ngyakhrha Musa ndanggǝn, “Mala, niya mbusamad wa kala mbǝrha na a ɗǝrha saaɗǝ.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Nggǝrangga Yeeso sǝ, “Tsarwaya tǝ kwandan sǝ, wuɗikkya na hu ɓereurha tǝ ƙǝndan sǝ, amma Wan Niifa mbǝ mbǝdghǝn sǝ ko na a ɗǝfanggǝn tenggǝn sahai wa.”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Tal ahur fatsahayighǝn ndanggǝn, “Chinǝm, malee ˈwan wuɗi wureeɗǝ ɗi pangnda pǝpa.”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Amma ndangga Yeeso, “Mbuwu samanna nanǝnya! Malang mǝrya pang ngganda mǝrrǝndan.”<verse eid="MAT 8:22" /></para>
  <para style="s">Yanang Yeeso ɓereu ˈyaara</para>
  <para style="r">(<ref loc="MRK 4:35-41">Markus4:35-41</ref>; <ref loc="LUK 8:22-25">Luka8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Tǝrgha Yeeso kyagha hu kombuwol hai katǝranggǝn tǝɗang wuri aamɗi teena tǝ fatsahayighǝn. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Kula sǝndǝndan sǝ, ɓagha ɓereu ˈyaara ɓa na kanglang ahu wuri aam ɗaɓa katǝrangga aamɗi kuɗufulla hai nagha aama a pisha ahur kombuwol ɗa hai. Amma tǝrang ɓeena Yeeso ɗǝ. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Ɗǝgha fatsahayighǝn ɗǝ mekhneng ngganda sǝ ndang ngganda, “Chinǝm, hǝrghang ƙǝm! Nǝm a hwaarha ɗǝ!”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Amma nggǝrangga Yeeso kanda sǝ, “Kama nun a tǝrǝmnda? Ƙǝɗi fǝrƙǝkafekkid nun!” Tǝrgha thliigha sǝ yanaggǝn ɓereuɗi tǝ kuɗufulla aamɗi, nggasgha mbǝrha hai.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Ƙǝsangga ǝnwulteena fatsahayighǝn tsakhmee nda, “Tur niif wunni ya? Ko ɓereurha ni tǝ kuɗufulla aama na nda a takkwa ˈya ndanǝn!”<verse eid="MAT 8:27" /></para>
  <para style="s">Ƙǝnang Yeeso nafiya sǝri na tǝ ǝnkaheeya fa</para>
  <para style="r">(<ref loc="MRK 5:1-20">Markus5:1-20</ref>; <ref loc="LUK 8:26-39">Luka8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Sǝlna Yeeso a pǝm wuri aam ɗaɗǝ, na a man ki chehweed Nggadaraya, nafiya sǝri na tǝ ǝnkaheeya fa ɓa nda thlǝmadghǝn ɓa. Ɓagha nda ɓa a mbǝd ten kwaya, mbǝ niifa sǝ na mbang mbǝraɗǝ tǝ mbǝɗi wa, ƙǝsǝr tsau nda ǝn tǝrǝmnda. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Katǝrang ngganda huhwang nda hai na nda a ndaarha, “Ma djiɗoyiwa tǝ kan, Wan Faara? Ɓana ɓa ka a sǝsangga kan kapa na far ngwa kumad nan tsǝrha hai wa?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Tsau tǝ mbǝɗi na ƙǝlengarya sǝ na a lafrha. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Hwangga ǝnkaheeyini Yeeso, “A kyang na kan sǝ, ɗang kan ahur chiɓǝd ƙǝlengaryina ɗǝ taarha.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Ndanggǝn kanda, “Ɗaama ɗǝ!” Nanǝn kee kya nda sǝ ɗǝnda ahur ƙǝlengaryina ɗǝ. Chiɓǝd ƙǝlengaryini kahat ɗaa nda ahur wuri aam ɗaɗǝ hwaa nda ɗǝ.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Nafini na a laf ƙǝlengaryini ɗaa nda hur tala ɗǝ pǝr ǝnɗa nda katǝragha hai heu, tǝ ƙǝm ǝnɗi katǝragha hai tǝ nafini sǝri na tǝ ǝnkaheeya fa. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Tǝrgha nafiya hur talɗi heu kya nda ɓa ka ɓa nda na Yeeso. Na nanda Yeeso hwanggǝnda a mal chehweed ndan nǝn.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Ƙǝnang Yeeso niifa mǝrna fadghǝn hai</para>
  <para style="r">(<ref loc="MRK 2:1-12">Markus2:1-12</ref>; <ref loc="LUK 5:17-26">Luka5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Kyagha Yeeso ahu kombuwol hai ɗǝgha hu talghǝn ɗǝ mannǝn sǝ Kafarnahum. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Ɓagha fingya nafiya ɓa tǝ niifa mǝrna fadghǝn hai kalth ahu ɗǝnggǝla. Nana Yeeso fǝrƙǝkafekkid ndan, ndanggǝn niifɗi mǝrna fadghǝn hai, “A ɓilladna wa waana, chohonda ɗimiyidwa ɗǝ.” <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Fingya famalǝmgya ngyakrha na nda a ndaarha ahur ndan tǝ ndaarha, “Kamshiɗiya nǝghǝn a sar Faara.”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Sǝnangga Yeeso numad ndan hai ndanggǝn kanda, “Kama nun numad ǝn mbǝlfeerha kiya ahur nun? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Yanggini pǝpa, a ndang nggi tǝ mǝrra fadɗi, ‘Chohonda ɗimiyidwa ɗǝ wa,’ nduwa, ‘Thliusǝ wiu wa?’ <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Amma niya kyaɗang ndaarha kun, Wan Niifa nǝghǝn tǝ sǝsǝmnda ha hu ƙǝshidɗiya yi chakh ɗimiya.” Tǝrgha ndanggǝn niifɗi mǝrna fadghǝn hai, “Thliusǝ, tǝrang ɗǝnggǝlwa sǝ, wiina wureeɗǝ.”<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Thliigha niifɗa sǝ harad ɗǝgha wureeɗǝ. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Nagha fiya wumngga hai ǝnɗi katǝragha hai ƙǝsangga ǝnwulteena kanda. Tǝrgha manang ngganda Faara tǝ thlǝnangga niifa ɓa natǝ sǝsǝmnda fa kaan kiya.<verse eid="MAT 9:8" /></para>
  <para style="s">Aah Yeeso Matta a mbu samadghǝn nǝn</para>
  <para style="r">(<ref loc="MRK 2:13-17">Markus2:13-17</ref>; <ref loc="LUK 5:27-32">Luka5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Nana Yeeso ɗiye mbeeɗǝ tǝ wiirha na niifa nǝn na nda aarha Matta, ndǝghǝn tsau a mbǝd thlǝ tsamnda. Tǝrgha ndangga Yeeso, “Mbuwu samanna.” Thliigha sǝ mbu samadghǝn nǝn.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Tsǝɓaku, na Yeeso a hǝb ǝnnarhami a wuri ki Matta, ɓagha fa thlǝ tsamngya tǝ faɗimiya hangga, hǝb ǝnnarhami nda tǝghǝn tǝ fatsahayighǝn.<verse eid="MAT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 9:11" />Nana Farisayini ndǝn kee, tsahang mee nda fatsahayighǝn ha, “Kama na tǝmalǝm ndǝnun hǝbrha tǝ fathlǝ tsamngya tǝ faɗimiya?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Sǝkna Yeeso ndǝn kee, nggǝranggǝn kanda sǝ, “Nafiya na ƙǝkanglang hai mba nda kaɗa tǝpurha wa, kǝl nafiya mbuwa ƙǝkanglang. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Nanǝnya, ɗamaɗǝ ɗun tsaha ǝnɗi na laɓar Faara a ndaarha, ‘haɗang nda niifa fa ndǝna minna a fannun, mbǝ sataka wa.’ Ƙǝsǝr ɓayi ɓa ka a aah nafiya ni na a numad ndaarha na nda a ǝna nggayirha wa, amma kǝl fa ɗimiya.”<verse eid="MAT 9:13" /></para>
  <para style="s">Tsakhmee aten kar aama</para>
  <para style="r">(<ref loc="MRK 2:18-22">Markus2:18-22</ref>; <ref loc="LUK 5:33-38">Luka5:33-38</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Tǝrgha ɓagha fatsahaya Yahaya a thlǝmad Yeeso ɓa ndang ngganda, “Ma ǝnagha ndǝn kan tǝ Farisaya a kar aama, amma fatsaha yiwa mba nda kar aama wa?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Nggǝrangga Yeeso kanda sǝ, “Ƙǝƙǝn na hur pashiya wutsamnda sǝbrha ɗǝ ndǝghǝn wutsamnda ɓalɗǝ a thlǝmad ndan? Na fara ɓayi nanda a tǝrang wutsamnda ma kanda. A farɗa ni na nanda a kar aama.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“Mbǝ niifa sǝ na mbuhwang suhurra lukrha tǝ weerǝnda ɓar kaɓaarha wa, ƙǝsǝr na mbuhudɗi a njarang nda luwudɗa ɗǝ, njarrǝghǝn nǝn a kal yi kaar. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Tǝ kǝm mbǝ niifa sǝ na irang nda weerǝnda aam inabi ahu suhurra samsamiya hai wa. A irang nda sa hai, na samsamiyini a ɗathla ɗǝ, na aam inabiɗi a iraaɗǝ, samsamiyini na nda sǝbrha ɗǝ. Weerinda aam anab, kamɗǝ a irang nggǝm ahu weerǝnda samsamiya hai. A ǝnaɗǝm kee na aam inabiɗi tǝ samsamiyini a ɓaala hai.”<verse eid="MAT 9:17" /></para>
  <para style="s">Kǝnang Yeeso wutarad Yayirus tǝ nuneefa</para>
  <para style="r">(<ref loc="MRK 5:21-43">Markus5:21-43</ref>; <ref loc="LUK 8:40-56">Luka8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Yeeso ɓalɗǝ a kalang kanda sǝ, ɓagha mamnda ƙǝn tsahad Yahudaya ɓa ɓǝrgha hai a mbedghǝn ndagha, “Mǝrgha wutarad na kukuling ya, ɓoɓa ɓa tsǝwarghǝn fa, nǝn a thliirha sǝ tǝ yibrha.”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Thliigha Yeeso sǝ tǝ fatsahayighǝn mbu samadghǝn nda.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Tǝrgha na nuneefa sǝ ǝnagha hurarha kumkap sǝri fara a ɓang fa hai. Ɓagha ɓa tǝman ƙǝsǝrghǝn tsuwar mii luwudghǝnǝn fa, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />ƙǝsǝr numaghǝn tǝ ndaarha, “Ko luwudghǝn tsuwar ni fa kee, niya ƙǝnda.”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Kyaharna Yeeso hai na nǝn ndǝn, ndagha, “A ɓillanna wa, waana, fǝrƙǝkafekkid wa ƙǝnoɗǝ.” Tsu a mbǝɗi kee ƙǝngga.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Kyana Yeeso minda ki mamndǝɗa hai, na fa pi perǝmngya nǝn tǝ fiya wumngga hai kanda a mbeela. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Tǝrgha ndagha, “Kyama ƙǝshaaɗǝ, mǝr wa wutaradɗi wa, nǝn a shiirha ni kee.”Amma masangga fiya wumngga hai. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Akwasamadɗi rǝk nanda fiya ƙǝshaaɗǝ, kyagha ɗǝ ƙǝs har wutaradɗa nǝn, thliigha sǝ. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Laɓar ǝnwulteenɗiya welɗaɗǝ ahu chehwedɗi kahat.<verse eid="MAT 9:26" /></para>
  <para style="s">Ƙǝnang Yeeso kwamaya tǝ niifa mbuwa mbang kaala sǝ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Akwasamadɗi malna Yeeso mbǝɗi, kwamaya sǝri hǝshya mbu samadghǝn nda kanda a aaghǝn, “A haɗowan fa, Wan Ndauda!”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Kyana Yeeso hur minda hai, tǝrgha kwamayini ɗǝnda thlǝmadghǝn ɗǝ, tsahang mee nǝn kanda, “Fǝrɗun ƙǝkafek ni mbang ƙǝnang kun wa?” Nggǝrang ngganda sǝ “Ha i, Chinǝm.”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Tǝrgha tsuwar yiyi ndan nǝn fa ndagha, “Ƙǝsǝr ka fǝrƙǝkafekkid nun, nun a ƙǝnda.” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Tǝrgha yiyi ndan inggaɗǝ. Ƙǝsgha Yeeso thlǝmad ndan kaan ndagha, “A pǝrang ɗun ndǝn niifa wa.”<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />Amma kya nda sǝ pǝr laɓar ɗaa nda ahu chehwedɗi kahat.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Kyana nda sǝ, na niifa sǝ natǝ ǝnkaheerha fa mbǝ mbang kalasǝ wa, ɓa nda tǝghǝn thlǝmad Yeeso ɓa. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Kyang na Yeeso ǝnkaheedɗa sǝ, niifɗi mbuwa mbang kalasǝ kalgha sǝ. Fiya wumngga hai ƙǝsgha ǝnwulteena kanda ndaa nda, “ˈWaghǝm tam na ˈya manggǝn ƙǝla yanɗiya a Isǝreela wa.”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Amma ndagha Farisaya, “Mamnda ǝnkaheeya fǝrangga sǝsǝmnda kyang nda ǝnkaheeya sǝ.”<verse eid="MAT 9:34" /></para>
  <para style="s">Ƙǝɗi fatarya</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yeeso wengɗǝ wupǝriya hai tǝ talya heu a tsahang fiya ha ahu ƙǝn tsahad Yahudaya, tǝ pǝr Laɓara na Mbǝnggǝn yi Kutǝryid Faara, tǝ ƙǝm a ƙǝnang nda fiya natǝ wanhaya ɗǝɗamǝn-ɗǝɗamǝn. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Nana Yeeso fiya wumngga hai, haɗangga nafina fa, ƙǝsǝr na nda hu sǝsaarha, mbǝ niifa sǝ na ɗang kanda sǝ wa. Na nda kǝla chauraya na kula tǝlafrha. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Tǝrgha ndanggǝn fatsahayighǝn, “Mul hathla hai, amma ƙǝɗi fatarya. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Tsaunǝn kee, hwanama tǝhedɗi, thlǝn fatarya nǝn ɓa ɓanda hathlang sǝ.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Wur Yeeso fathlǝngya kumkap sǝri</para>
  <para style="r">(<ref loc="MRK 3:13-19">Markus3:13-19</ref>; <ref loc="LUK 6:12-16">Luka6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Aagha Yeeso fatsahayighǝn kumkap sǝri a thlǝmadghǝn ɓa, fǝrang sǝsǝmnda nǝn kanda a kyang ngganda ǝnkaheeya sǝ tǝ ƙǝm ƙǝnang ngganda wanhaya ɗǝɗamǝn-ɗǝɗamǝn tǝ ɓeerha farha. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Kulo thlǝm fathlǝngya Yeeso kumkap sǝri ya:</para>
  <para style="b" vid="MAT 10:2" />
  <para style="li" vid="MAT 10:2">Siman nanda aarha Mbiturus,</para>
  <para style="li" vid="MAT 10:2">Andrawus wanman Siman,</para>
  <para style="li" vid="MAT 10:2">Yakubu wan Dzabadi,</para>
  <para style="li" vid="MAT 10:2">Yahaya wanman Yakubu,<verse eid="MAT 10:2" /></para>
  <para style="li">
    <verse number="3" style="v" sid="MAT 10:3" />Filibus,</para>
  <para style="li" vid="MAT 10:3">Mbatalomi,</para>
  <para style="li" vid="MAT 10:3">Toma,</para>
  <para style="li" vid="MAT 10:3">Matta tǝ thlǝ tsamnda,</para>
  <para style="li" vid="MAT 10:3">Yakubu wan Alfiyus,</para>
  <para style="li" vid="MAT 10:3">Taddiyus, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Siman tǝsǝrǝk chehweedghǝn,</para>
  <para style="li" vid="MAT 10:4">Yahuda Iskaryoti fǝrgha Yeeso ɗǝ.<verse eid="MAT 10:4" /></para>
  <para style="s">Thlǝn Yeeso kumkap sǝri ɗi</para>
  <para style="r">(<ref loc="MRK 6:7-13">Markus6:7-13</ref>; <ref loc="LUK 9:1-6">Luka9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Thlǝngga Yeeso kumkap sǝri ɗi ndanggǝn kanda, “A ɗuɗun thlǝmad fingya ɗǝ mbuwa Yahudaya, nduwa talya Samariyaya wa. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Amma ɗaama thlǝmad nafiya Isǝreela ɗǝ, chauraya Faara sahadgha. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Ɗaamaɗǝ ɗun ndangnda kanda nduwus Kutǝryid Faara ɓa. <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Ƙǝnaman haya, thleeman mǝrya sǝ, ƙǝnaman fingya natǝ wanhad termeerha fa, kyaman ǝnkaheeya sǝ. Fǝrang nggandan kun ka, kun ƙǝm fǝramadghǝn ka ƙǝla thlǝnun ndǝn! <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />A ƙǝsɗun wuɗǝɓǝla ha hu panjakwan nun wa, ko tǝfaasa, nduwa wurirha, nduwa kala ˈya na ƙǝla wuɗǝɓǝla wa. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />A ƙǝsɗun yawarha ha tǝ lukrha tǝ pakhma, nduwa sǝsaala wa. Kala ˈya fǝrang nanda kun a karɗun ndǝn wa, ƙǝsǝr tǝtaara kamɗǝ a wal ǝnnarhami nǝn.”<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Kala wupǝri nduwa tala kyanun sahai, kaɗaama ka niifa tsawun ahur mindǝghǝn ta far ɗaɗǝ nun a mal talɗi. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />A kyaɗun hur minda hai, ndaamaˈya tǝ ƙǝm fǝrang parka nun kanda. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Ana ka minda ni ngwa tsauka parkad nun sǝ. Amma a mbusǝ kee wa, ngwa wudgha parkad nun a fad nun ɓa. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Kala tala nduwa wure kyanun sahai, a thluwa nda kun fa wa, nduwa kar nda kang thlǝmaarha kun fa, anaɗun a wiirha paman tinid mbǝɗa ɗǝ na a fad sarnun. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Niya pǝrang ƙǝkafek kun, a far ngwa kumarha a nggushi nda Sodom tǝ Nggomara na nda a haɗang kanda fa ma talɗi.<verse eid="MAT 10:15" /></para>
  <para style="s">Sǝsaarha na ɓayi</para>
  <para style="r">(<ref loc="MRK 13:9-13">Markus13:9-13</ref>; <ref loc="LUK 12:11-12">Luka12:11-12</ref>; <ref loc="LUK 21:12-19">21:12-19</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Niya thlǝn kun ƙǝla chauraya ahur mǝmereeya ɗǝ. Nanǝn kee tsawama thladwayirha ƙǝla huthlingya tǝ ƙǝm tsawama mǝsǝlǝmnda nafiya ƙǝla kataprakkya. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Kwarama! Ƙǝsǝr na nda a ɗǝrha tǝ kun mbed fa ngwa kumaya ɗǝ tǝ ƙǝngya tsahad Yahudaya tsaɗa kun nda. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Nanda a ɗǝrha tǝ kun a mbed ngwamnaya ɗǝ tǝ kutǝrya ƙǝsǝr ka nggi. Ənɗaniya na fǝrang kwamana kun pǝrang ƙǝkafek nun kanda atenna. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Amma a ƙǝsang nda kun a ɓillaɗun tǝ ˈya nun a thlǝkrha tǝ ƙǝƙǝn nun a thlǝkƙǝn wa. Ƙǝsǝr a mǝmǝlla sayidɗi na Faara a pǝrang ˈya kun nun a thlǝkrha. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Ƙǝsǝr mbǝ kunni na a kaala sǝ wa, Sǝsǝn Chinun ni na a kaala sǝ ahur nun.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />“Wanmana nǝn a fǝr wanman a ɓǝlang ngganda. Chingya na nda a fǝr wanggindan, na wundakhnaya a thleng fa nggǝt yindan fa a ɓǝlang ngganda kanda. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Na fiya heu a kar kun ƙǝsǝr ka nggi. Amma kala niifa ƙǝrǝsgha, nǝn a hǝrǝkrha. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />A sǝsang nda kun ahu yanɗi tala ya, ɗaama hu tala ɗǝ pak. Niya pǝrang ƙǝkafek kun, Nggi, na Wan Niifa, ni a wutta ɓa kapa nun weng talya Isǝreela hai heu.”<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />“Wan tǝmakarantarha mbǝ kal tǝmalǝmndǝghǝn wa, tǝ ƙǝm mafarha mbǝ kal turighǝn wa. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Wangya makarantaya kamɗǝ a na nda ƙǝla tǝmalǝmndǝn ndan, mafaya ƙǝm a na nda ƙǝla turi ndan. Nanǝn Nggi, na tuwuri ɗi, anda nggi kogna ǝnkaheeya, wangya wuriɗi ƙǝm na nda aah kanda tǝ thlǝma kalgha yina mu!”<verse eid="MAT 10:25" /></para>
  <para style="s">Yanɗi kamngga a tǝrǝmnggǝnǝm</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luka12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“Nanǝn kee, a tǝrǝm ɗun fingya na a sǝsang kun wa. Ƙǝsǝr na farghǝn ɓayi kala ˈya na nggǝnggǝla na nda a inang ɗǝ; kala ˈya na ɓǝɓee ƙǝm nǝn a kyarha pǝpal ɓa sǝkƙǝna fiya heu. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />ˈYa pǝrang ni kun hu wula, tǝraman urad nun sǝ pǝrghǝn nun a yanfaara a ɗalth mbǝrha hai. ˈYa shishiwang ni kun hu thlǝmaarha hai, tǝrama ten ƙǝnna sǝ tǝranggun urad nun sǝ pǝrghǝn nun sǝkƙǝna kowunni! <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />A tǝrǝm ɗun fingya na a ɓǝl farha wa; ƙǝsǝr mba nda mbang ɓǝlang shingnda wa. Amma tǝrmama Faara katenggǝn, ndǝghǝn na mbang ɓǝlang farha tǝ shingnda kyab ahu hwanga. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Mbǝ na nda heng wuɗikkya ɗǝ sǝri kobo tal wa? Amma a muk tal a hweeɗe hai na Chinun sǝnda sǝ. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Ko was tengginun heu nǝghǝn thlǝthlǝɗa. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Nanǝn kee, a tǝrǝm ɗun wa; kal ɗun wuɗikkya hangga a mbed Faara.”<verse eid="MAT 10:31" /></para>
  <para style="s">Kyad sǝnda Yeeso a mbed fiya</para>
  <para style="r">(<ref loc="LUK 12:8-9">Luka12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“Niya ndang nda kun, kala niifa ndagha sǝnɗǝ nggi a mbed fiya hu ƙǝshidɗiya, nggi ƙǝm niya ndaarha sǝnɗi ndǝn a mbed Pǝpa na a talara. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Amma niifa ƙǝm ndagha sǝngwa nggi wa a mbed fiya hu ƙǝshidɗiya, nggi ƙǝm niya ndaarha sǝngwi ndǝn wa a mbed Pǝpa na a talara.”<verse eid="MAT 10:33" /></para>
  <para style="s">Tsaharha ha aten tsawud ɗǝɗemnggirha tǝ sǝsaarha</para>
  <para style="r">(<ref loc="LUK 12:51-53">Luka12:51-53</ref>; <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />A numaɗun ndon ɓang ni tsawud ɗǝɗemnggirha ƙǝshiirha ɓa wa. Awo, ɓawi ɓa tǝ tsawud ɗǝɗemnggirha wa, amma thlaukh ƙǝlara. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />“Ɓani ɓa ka a ɓi wumang yanda a pathlang:</para>
  <para style="b" vid="MAT 10:35" />
  <para style="q1" vid="MAT 10:35">‘Nda wee hǝshin tǝ chin,</para>
  <para style="q2" vid="MAT 10:35">nda wutararha tǝ man,</para>
  <para style="q1" vid="MAT 10:35">nda nu wee tǝ</para>
  <para style="q2" vid="MAT 10:35">thlaɓǝrghǝn tǝ nuwunda. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />Fa saryi nun,</para>
  <para style="q2" vid="MAT 10:36">na nda naarha ahur mindǝnun.’”<verse eid="MAT 10:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />A nggǝmna tsu nduwa muwa ma nggi, tsǝkka a tsawana yina wa. Tǝ ƙǝm a nggǝmna wundǝlad wa nduwa wutarad wa ma nggi, tsǝkka a tsawana yina wa. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Kala niifa kargha tǝr kaɗidghǝn fa mbu samadna nǝn, tsǝkkwa a tsauka yina wa. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Kala niifa nggǝmngga yiɓǝdghǝn, nǝn a ƙǝɗeng nda, tǝ ƙǝm kala niifa ƙǝɗengga yiɓǝdghǝn ka nggi nǝn a walghǝn.<verse eid="MAT 10:39" /></para>
  <para style="s">Tsaharha ha aten ƙǝna</para>
  <para style="r">(<ref loc="MRK 9:41">Markus9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“Kala niifa thlǝgha kun fa thlǝnǝn nggi, tǝ ƙǝm kala niifa thlǝgha nggi fa thlǝnǝn Chinɗi thlǝngga nggi ɓa. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Kala niifa thlǝgha annabi fa ƙǝsǝr ka nanǝn annabi, nǝn a wal ƙǝnaghǝn yi annabi. Kala niifa thlǝgha ka niifa fa, ƙǝsǝr ka nanǝn ka niifa nǝn a wal ƙǝnaghǝn yi ka niifa. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Kala niifa fǝrangga aam saarha na shishiu ahu wuhuleurha a tal ahur fingyayini na nggun-ngguchit ahu fatakkwayina, ƙǝkafek nǝn a wal ƙǝnaghǝn.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Laɓara aten Yahaya Tǝbaptisǝma</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luka7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Ngwalang na Yeeso thlǝghang palthyini a fatsahayighǝn kumkap sǝri, kyagha sǝ ka ɗǝgha tsahang fiya ha tǝ pǝr laɓar Faara hu fingya a talya Yahudaya.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Nana Yahaya tǝ Mbaptisǝma ahu porsǝna, sǝk laɓaara nǝn aten ǝnggini na Ƙǝrǝsti a ǝnarha. Tǝrgha thlǝn fatsahayighǝn nǝn ɗǝ ɗa nda tsahang mee Yeeso. <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />Ndang ngganda Yeeso, “Sani Ƙǝrǝsti ɗi nan a ƙǝlaarha fa wa, nduwa ɗan mbeeɗǝ tǝ ƙǝla niifa fa pak wa?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Ndangga Yeeso kanda, “Wuɗaama ɗun pǝranggǝn Yahaya ˈya nun a sǝkrha tǝ ˈya nun a naarha. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Kwamaya a na mana hai, Sǝfǝngya a wiirha hai, fa tǝrmeeya kanda a wal ƙǝnda, teɓengya a sǝk laɓaara, kanda a thleng mǝrya sǝ tǝ yibrha, tǝ ƙǝm kanda a pǝr Laɓara na Mbǝnggǝn a fa yamiya. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Ndaaman, ‘A fǝrangga Faara parka fingya kawaa ƙǝsǝra, ƙǝsǝr ka nggi.’ ”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Nana fatsaha yini ki Yahaya a wiirha, katǝrangga Yeeso tsǝ laɓaara hai aten Yahaya ahu terɗi wumngga hai. Ndanggǝn kanda, “Tur yanggi niifa ni ɗunun ka ƙǝlang nda a kaheerha ɗǝ? Niifa ni na kyakhrang hutenggǝn hai ƙǝla hwaliiya na nzǝnzang na ɓereurha a tsang ˈya fa wa? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Nduwa nuwun a numad ndaarha ɗunun ka ƙǝlang niifa ɗǝ ngwagha fa tǝ kari na tǝ wuɗǝɓǝla fa ngga wa? Awo, nafiya na kal kari fa natǝ wuɗǝɓǝla na nda tsaurha a kwakirǝm kutǝra, mbǝ a kaheerha wa. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Ɗunun ka kaɗa annabi wa? Yoo, kalɗǝ annabi.” <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />“Ƙǝsǝr Ɗeleewar Faara tsǝɗǝ laɓaara aten Yahaya ndanǝn,</para>
  <para style="b" vid="MAT 11:10" />
  <para style="q1" vid="MAT 11:10">‘Niya thlǝn tǝthlǝndǝna ˈwagha mbeeɗǝ ma sa,</para>
  <para style="q2" vid="MAT 11:10">nǝn a takso kwamana ɗǝ kapa na ɓarhaɓa.’” <note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false">Mal 3.1 </char></note><verse eid="MAT 11:10" /></para>
  <para style="b" />
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Niya, pǝrang ƙǝkafek kun, mbǝ niifa sǝ nggǝt nanda hu ƙǝshidɗiya kalgha Yahaya tǝ mbaptisǝma mamnggirha wa. Amma ko yanɗa ni na ngguchit ahu Kutǝryid Talara kalɗǝ Yahaya mamnggirha. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Ka a thlakh mbǝdɗi katǝrangna Yahaya tǝ mbaptisǝma pǝr laɓar Faara hai, ta weeri ɗaɓa ya, Kutǝryid Talara aten ɗǝrha mbeeɗǝ tǝ kanglanggirha, ko nanǝn fa mbǝlfeeya na nda a yanda tǝghǝn. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Ƙǝsǝr kapa na Yahaya ɓarha ɓa, annabiya heu tǝ Ɗeleewar ngyakhrha Musa thlǝk nda ˈya ɓagha katǝrarha hai. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />A naɗun a nggǝmfa tǝ ˈya ndaani, Yahaya ndǝghǝnni Ilya, yanɗi ndana annabiya nǝn a ɓarha ɓa. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Kala niifa na tǝ thlǝmad sǝkrha, sǝkƙǝnǝn.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />Tǝ ma ni sakh nafiya ƙǝshiid weeriya? Nǝghǝn ƙǝla wundakhnaya na a ɓashaarha a pǝpal kasu, na nda a aah ndan tǝ ndaarha:<verse eid="MAT 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />“‘Peng ɗan perǝma kunsǝ,</para>
  <para style="q2" vid="MAT 11:17">karɗun rǝbrha fa,</para>
  <para style="q1" vid="MAT 11:17">ang ɗan amshi mǝrra kunsǝ,</para>
  <para style="q2" vid="MAT 11:17">karɗun tǝrha fa.’<verse eid="MAT 11:17" /></para>
  <para style="b" />
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />Ɓana Yahaya tǝ Mbaptisǝma ɓa mbǝ a hǝbrha tǝ saarha wa, amma kun a ndaarha, nǝghǝn tǝ ǝnkaheerha fa.” <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />“Wan Niifa ɓa ɗaɓa, a hǝbrha, a saarha kun a ndaarha, ‘Tǝ yakh hǝbrha tǝ saarha, pashid fathlǝ tsamngya ni tǝ fa ɗimiya!’ Amma ana niifa tǝ sǝnda Faara na ǝn ǝnadghǝn kyadghǝn.”<verse eid="MAT 11:19" /></para>
  <para style="s">Talya kargha malang ɗimiyid ndan</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luka10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Tǝrgha katǝrangga Yeeso kiki talyi na fa ǝnanǝn ǝnwulteengya sǝ hangga, ƙǝsǝr malangwa nda ɗimiyid ndan kyakhra nda thlǝmad Faara ɓa wa. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“Kawa Koridzin! Kawa Mbatseda! Ana ǝnwulteengya ɗǝɗamǝn ǝnanda ahur nun ndǝghǝn ǝnanda a Taya tǝ Sidon, kam ƙǝtǝm ˈwad nafi ndan teena malang nda ɗimiyid ndan, kal kukwasharya nda fa tǝ ƙǝm ƙǝmang ngganda yid ndan tǝ fishe. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Niya ndang nda kun, a far ngwa kumarha, na Taya tǝ Sidon haɗang nda Faara fa ma kun. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Kun ƙǝm nafiya Kafarnahum; tamngga ndaarha, nanda a mano a talara wa? Awo! Na ɗǝrha hu hwanga ɗǝ. Ƙǝsǝr ana ǝnwulteenggina ni ǝna nanda a kyanun ndǝn ǝna nanda a Sodom, ndǝghǝnni ƙǝm ɓalgha sǝ ta weeri ɓa ya. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Niya ndang nda kun, a far ngwa kumarha, na Sodom a haɗang nda Faara fa ma kun.”<verse eid="MAT 11:24" /></para>
  <para style="s">Ɓamaɓa ɓun yibrha a thlǝmadna</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luka10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />A sayidɗi ndagha Yeeso, “Usaɗi sa Pǝpa, Chinǝm yi talara tǝ hweeɗe, ɓǝɓengna ǝnggini heu ya a nafiya na ndǝndǝl tǝ fa hutengya, kyaɗang nggǝna pakhtǝɗuya. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Nǝghǝn kee, Pǝpa, ndǝn kamogha yid!”<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />Fǝre Pǝpa ǝngya heu, ƙǝsǝr ndǝghǝnni katenggǝn sǝngga Wanɗi. Ƙǝkafek yanɗi sǝngga Chinɗi ndǝna Wanɗi. Amma Wanɗi na midghǝn sǝ pǝrang laɓaara nǝn fingya aten Chinɗi, tǝna nda sǝnggǝn ƙǝm.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“Ɓama thlǝmadna ɓa kun ɗakhna mid nun ɗǝ na tǝ rǝfrha in haaghǝn, niya yiɓang nda kun. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Tǝrang miiwadna a kakhpǝniwa tǝna tsaharha a fanna. Mǝsǝlǝmnda niifa ni nggi hu sǝsǝna tǝ sammayirha, ƙǝsǝr nun a wal yibrha. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Na tǝrra miiwadna pǝpa, rǝfǝdɗiya ƙǝm fǝrang ni kun nǝghǝn kaftang.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Tsakhmee aten far Yiɓǝd Yahudaya</para>
  <para style="r">(<ref loc="MRK 2:23-28">Markus2:23-28</ref>; <ref loc="LUK 6:1-5">Luka6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Tsǝɓaku, a sayidɗi na Yeeso a mbǝra ɗǝ tǝ heerha a far Yiɓǝd Yahudaya. Ƙǝsgha miirha fatsahayighǝn, tǝrgha ƙǝs kya ten wan hwaliirha nda na nda a kiighǝn. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Amma nagha fingya Farisaya kanda ndang ngganda Yeeso, “Kuloɗǝ, fatsahayiwa a ǝna ˈya ˈyaɗana ngyakhrha na nda kya wan hwalirha a far Yibrha.”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Ndangga Yeeso kanda, “Karatang ngwanun ǝnɗi na hu Ɗeleewar Faara ǝnana Ndauda ƙǝsna miirha ndǝn tǝ pashiyighǝn wa?” <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Kyagha hu Ƙǝn Faara ɗǝ, kii mburodi nda ɗǝfang nanda ɗǝ ka a kiigha firistaya. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Nduwa karatang ngwa nun ahu ngyakhrha Musa ndanǝn nggǝmang nda firistaya fa a ǝna taara ahu Ƙǝn Faara na a Urshalima a far Yibrha wa? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Niya ndang nda kun, ƙǝlama niifa ya kalgha Ƙǝn Faara na a Urshalima. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Amma andam kwang sǝnang ɗun ˈya hai ndana Ɗeleewar Faara, ʻNa minna sǝ nagha fiya a haɗang kun fa, mbǝ ǝna sataka wa, kam ˈyarwun fatsahayina na ka nafiya wa, <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Ƙǝsǝr Wan Niifa Chinǝm ni, heu tǝ far Yibrha!<verse eid="MAT 12:8" /></para>
  <para style="s">Ƙǝnang Yeeso niifa mǝrna harghǝn hai</para>
  <para style="r">(<ref loc="MRK 3:1-6">Markus3:1-6</ref>; <ref loc="LUK 6:6-11">Luka6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Tǝrgha wiirha Yeeso kyagha hu kǝn tsahad Yahudaya ɗǝ. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />A mbǝɗi na niifa sǝ mǝrna harghǝn hai. Tsahangga farisaya mee Yeeso, “Nggǝm ngyakhrha fa a ǝnagha niifa tar kǝnang nda niifa a far Yibrha?” Tamngganda ndaarha na Yeeso a ndaarha ooh, tǝna nda kǝsang nda tǝ ɗimiyirha.<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Ndanggǝn kanda, “Ana chaurad nun sǝ mukka hu kwaarha hai a far Yibrha, mbun ɗǝrhaɗǝ ɗun ƙǝɗang sǝ wa? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Kal niifa chaurarha kaan, haˈi nggǝmang ngyakhrha niifa fa a ǝna ˈya na ngga a far Yibrha.”<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Tǝrgha ndanggǝn niifɗi, “Pǝpǝnang harwa ɗǝ.” Nanǝn kee pǝpǝnangga niifɗi harghǝn ɗǝ, nggǝrgha harɗi mǝmǝl kǝla tahadghǝn.<verse eid="MAT 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 12:14" />Tǝrgha wumngga farisayina hai ka a kaɗa kwaman ɓǝlla Yeeso nda.<verse eid="MAT 12:14" /></para>
  <para style="s">Yeeso ndǝna mafad Faara wurnǝn</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Sǝnangga Yeeso numad ndan hai. Nanǝn kee mal mbǝɗa nǝn, mbugha fiya samadghǝn hangga, ƙǝnanggǝn fiya heu na fandan ɓee ahur ndan. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Amma ƙǝs thlǝmad ndan nǝn a pǝr nda tǝwunni ndǝghǝn wa. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Tǝrgha lǝghǝdgha ˈya ndana Annabi Ishaya:<verse eid="MAT 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />Kǝlaman Mafanna wurni,</para>
  <para style="q2" vid="MAT 12:18">nggǝmɗi ndǝn, nǝn ǝna ˈya mbǝnegha,</para>
  <para style="q1" vid="MAT 12:18">Niya fǝrang sǝsǝnna,</para>
  <para style="q2" vid="MAT 12:18">nǝn a ǝna nggayirha a fingya heu.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Mbǝ ǝna kakyathlaanga tǝ fiya,</para>
  <para style="q2" vid="MAT 12:19">nduwa djargha hai ahur fiya wa.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Nǝn naarha tǝ sammayirha a fingya mbuwa kanglang,</para>
  <para style="q2" vid="MAT 12:20">nǝn fǝrang kaali niifa mbuwa tǝ mbǝrsaarha.</para>
  <para style="q2" vid="MAT 12:20">Akwasamadghǝn, kowunni nǝn a wal kwaman nggayirha.<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />Na thlǝmnggǝn a tsau yi mbǝrsad</para>
  <para style="q2" vid="MAT 12:21">ƙǝshiirha kahat.<verse eid="MAT 12:21" /></para>
  <para style="s">Yeeso tǝ kutǝr ǝnkaheeya</para>
  <para style="r">(<ref loc="MRK 3:20-30">Markus3:20-30</ref>; <ref loc="LUK 11:14-23">Luka11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Tǝrgha ɓang niifa nda Yeeso ɓa na tǝ ǝnkaheerha fa, na kwamarǝn tǝ ƙǝm mbǝ mbang kalasǝ wa. Ƙǝnanggǝn niifɗi mbanggǝn kaala sǝ tǝ na maana hai kyab. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Fiya heu na ǝnwulteena nda tsakhmee nda, “Ndee mbǝ Yeeso ɗa na ya, na wan Ndauda wa?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Amma sǝkna Farisaya ǝnwulteenɗi ǝnanǝn, ndaa nda, “Mbǝ ngaala sǝ wa kyang ɗǝ ǝnkaheeya sǝ. Ƙǝsǝr walghǝn sǝsǝmnda a ahar Sheetan kutǝr ǝnkaheeya.”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Sǝnangga Yeeso numad ndan hai, nggǝranggǝn kanda sǝ, “Kala kutǝryirha ndǝkka hai tǝ yanda mbǝ tam isha wa, tǝ ƙǝm kala tala nduwa wure ndǝkka hai tǝ kakyathlaanga nǝn weela ɗǝ. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Ana sheetan a kyang sheetan sǝ, nǝn a yanda tǝ altenggǝn. Mbǝ kutǝryidghǝn a mǝndaha wa. <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Ana tǝ sǝsǝmnda Sheetan ni kyan ǝnkaheeya sǝ, tǝ sǝsǝmnda wun na fatakkwayinun kyang kanda sǝ? Fatakkwayinun ni a ngwang kumarha kun sǝ. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Amma a kyangɗi ǝnkaheeya sǝ tǝ Sǝsǝn Faara, nanǝn kee Kutǝryid Faara ɓaa ɗǝ pathlang nun ɓa.”<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />Wunni na kanglang kaan na mbang kyaarha hu minda ki niifa hai na kanglang ƙǝla Sheetan ngaaranggǝn ǝnggighǝn? Ƙǝl ˈwanǝn teena ƙǝnanggǝn niifɗa hai na kanglang ˈwan a mbanggǝn har ǝngya na midghǝn.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />Kala niifa mbuwa tǝ nggi, nǝn a tsan nggi. A mba a ɗee sǝ wumang fiya ɓa wa, na a waleng kanda ɗǝ. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Niya ndang nda kun, kala tur yanggi ɗimiyirha ǝnana nduwa ndaana na nda a chahoƙǝn ɗǝ. Ko kalna sǝ yi ˈyar Wan Niifa, na nda a chahoƙǝn ɗǝ. Amma a sarna Sǝsǝna tǝ Peɗǝnda, mba nda tam chahoƙǝn ɗǝ wa, ko nanǝnya nduwa ƙǝshiirha na ɓayi. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Kala niifa ˈyargha Wan Niifa na nda mbang chahanggǝn ɗǝ, amma kala niifa ˈyargha Sǝsǝna tǝ Peɗǝnda, mba nda tam chahanggǝn ɗǝ wa, ko nanǝnya nduwa ƙǝshiirha na ɓayi.<verse eid="MAT 12:32" /></para>
  <para style="s">Nǝm sǝn ɗǝfrha tǝ tur wanggighǝn</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luka6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />Ana ɗǝfrha ngga, na wanggighǝn naarha ngga. A mbǝ ɗǝfrha ngga wa, mbǝ wanggighǝn narha ngga wa. Nǝm sǝn ɗǝfrha tǝ tur wanggighǝn. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Kun huthlingya, ƙǝƙǝn na nafiya natǝ mbǝlfeerha fa ƙǝla kun thlǝk ˈya na ngga tǝ ƙǝm kamngga? Ƙǝsǝr ˈya na ahurwa ndǝghǝn na a kyarha ɓa thlǝkƙǝna. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Ka nafiya na nda ǝna ˈya na ngga ahur ndan sǝ, amma fambǝlfeeya na nda kyang ǝngya ɓa mbuwa ngga ahur ndan sǝ.<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />Niya pǝrang palthɗi kun ya, a far ngwa kumarha tǝtani a ngwang kumarha nda kun sǝ aten ˈya na ɗimi ndaanun. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Ənɗi kyagha ɓa a miiwa nǝn a hǝrworha nduwa ƙǝnoghǝn.<verse eid="MAT 12:37" /></para>
  <para style="s">Famalǝmgya ngyakhrha tǝ Farisaya a kaɗa ǝnsakhrha</para>
  <para style="r">(<ref loc="MRK 8:11-12">Markus8:11-12</ref>; <ref loc="LUK 11:29-32">Luka11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Farɗasǝ fingya famalǝmngya ngyakrha Musa tǝ Farisaya ɓanda thlǝmad Yeeso ɓa ndang ngganda, “Mala, na minnasǝ a kyaɗang sakh ǝnwulteena na kan na a kyad ndaarha furo Faara sǝsǝmnda.”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Amma nggǝrangga Yeeso kanda sǝ, “Nafiya ƙǝshiid weeriya fambǝlfeeya tǝ fa yamid fǝrƙǝkafek ndǝna kaɗa ǝnsakhrha yi wulteena, amma mbǝ ǝn sakhrha sǝ na nda a kyaɗang kanda wa, kǝl yanɗi ki annabi Yunana. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Kǝla ǝnana Yunana ɓeena mahan tǝ paara mahan ahur tǝna, nanǝn kee na Wan Niifa a ǝna ɓeena mahan tǝ paara mahan kǝm ahu kwaarha. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />A far ngwa kumarha na nafiya Nineba a thleng nafiya ƙǝshiid weeri fa ya kyaɗang ndaarha nda kanda ǝnawa nda mǝmǝl wa, ƙǝsǝr kanda malang nda ɗimiyid ndan, ka laɓar Faara thlǝghangna Yunana kanda. Nanǝnya, kulo niifa kalgha Yunana a mbǝɗiya, amma karɗun malang nda ɗimiyid nun! <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />A far ngwa kumarha, na Kwatam nda Sheeba a thleng nafiya ƙǝshiid weeri fa ya kyaɗang ndaarha nǝn kanda ǝnawun mǝmǝl wa. Ɓaghǝn ɓa a mbǝrha na inggun ka ɓagha sǝk sǝnda Sulemanu. Nanǝnya kulo niifa a mbǝɗiya kalgha Sulemanu, amma karɗun kang thlǝmaarha fa.”<verse eid="MAT 12:42" /></para>
  <para style="s">Wutta Ənkaheerha ɓa</para>
  <para style="r">(<ref loc="LUK 11:24-26">Luka11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“A kya ǝnkaheerha sǝ a fad niifa, nǝn ɗǝrha ka kaɗa mbǝd yibrha a kaheerha ɗǝ, amma mbǝ waala wa. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Tǝrgha nǝn ndaarha, ‘Niya wutta thlǝmad niifɗa ɗǝ kyani saɓa.’ Nanǝn kee wudgha ɓagha wal wuriɗi mal nǝn mbǝ niifa sǝ wa, ngwa wuriɗa ɗǝ ngga, tangsang nda. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Tǝrgha na ǝnkaheedɗi a kaɗa ǝnkaheeya ɓa mǝd kalgha ndǝn mbǝlfeerha kya nda hur niifɗa hai tsawa nda sǝ. A kwasamadghǝn, tsawud niifɗiya sǝssadghǝn nǝn kal yi kaar. Nun a tsaurha kee kun fambǝlfeeya ƙǝshiid weeriya.”<verse eid="MAT 12:45" /></para>
  <para style="s">Man Yeeso tǝ wanmanggighǝn</para>
  <para style="r">(<ref loc="MRK 3:31-35">Markus3:31-35</ref>; <ref loc="LUK 8:19-21">Luka8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Nana Yeeso a ndikrha tǝ fiya wumngga hai, man tǝ wanmanggighǝn ƙǝƙǝt a ƙǝshi, na minda sǝ a ndiya nda tǝghǝn. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Ndangga niifa Yeeso, “Nda muwa tǝ wanmanggiwa a ƙǝshi, na minda sǝ ndikrha tǝ sa.” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Tsakhka Yeeso mee, “Wunni iiya? Mingya ni kǝm wanmanggina?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Tǝrgha kyad fatsahayighǝn nǝn ɗǝ tǝ haara ndǝghǝn, “Ƙǝlama nda iiya tǝ wanman nggina ha ya. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Tsaunǝn kee, kala niifa ǝnagha ˈya ndana Pǝpa na a talara, ndǝghǝnni wan pa, wanya tǝ ƙǝm iiya.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Karapu aten tǝhǝfrha</para>
  <para style="r">(<ref loc="MRK 4:9">Markus4:9</ref>; <ref loc="LUK 8:8">Luka8:8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Tsu a farɗi malgha Yeeso wuriɗi ɗǝgha a mii wuri aam Nggalili ɗǝ. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Wumngga fiya thlǝmadghǝn ɓa hangga, nanǝn kee kyagha hu kombuwol hai. Tsauka ahur kombuwolɗi nagha a tsahang fiya ha na ƙǝƙǝt a mii wuri aamɗi.<verse eid="MAT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 13:3" />Tsǝɗǝ asǝɗaya hangga tǝ karapuya, ndǝghǝn: “Kama thlǝmaarha hai! Tǝhuɗaarha ɗǝɗǝ ka hǝfrha ɗǝ. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Nanǝn aten wash wiidɗi, hǝrgha fingya hai aten kwamana, ɓagha wuɗikkya ɓa ɗamangganda. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Hǝrgha fingya hu hǝreng keela hai, ka mbuwana chehweerha sǝ kaan kya nda sǝ ƙǝkar. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Amma tǝkna yanfaara hai, hwara nda ɗǝ mǝra nda, ƙǝsǝr kwa wa nda thlaara hai wa. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Fingya wiiya hǝra nda pathlang ndakhkya hai ˈyaɓangga ndakhkini kanda. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Amma fingya hǝra nda hu chehweerha hai na ngga kyanda sǝ ǝna wee nda fingya katǝra kumnggit mahan-mahan, fingya ƙǝm kumnggit mikki-mikki har haru-haru.”<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />“Kala niifa na tǝ thlǝmad sǝkrha, sǝkƙǝnǝn.”<verse eid="MAT 13:9" /></para>
  <para style="s">ˈYa ǝnagha ndǝn na Yeeso tsaharha ha tǝ karapu</para>
  <para style="r">(<ref loc="MRK 4:10-12">Markus4:10-12</ref>; <ref loc="LUK 8:9">Luka8:9</ref>,<ref loc="LUK 8:10">10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Tǝrgha ɓagha fatsahayighǝn thlǝmadghǝn ɓa tsahang mee nda, “Kama na thlǝk karapuya a nanna a kalang fiya sǝ?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Nggǝranggǝn kanda sǝ, “Nggǝmang nda kun fa na a sǝn ˈya nun na Kutǝryid Talara ahurghǝn, amma fingya nggǝmang ngwanda kanda fa wa. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Kala niifa natǝ ˈya ha na nda chighanggǝn tsǝghanggǝn kaan, amma kala niifa mbuwana ˈyasǝ a harghǝn, na nda a thlang ngguchit tǝɗi na harghǝn. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Ndǝghǝnni ni ǝna taara tǝ karapuya a naɗi a kalang kanda sǝ ƙǝsǝr,</para>
  <para style="b" vid="MAT 13:13" />
  <para style="q1" vid="MAT 13:13">na nda ƙǝlaarha ɗǝ, amma mba nda naghǝn wa,</para>
  <para style="q2" vid="MAT 13:13">na nda kathlǝmaarha hai, amma mba nda sǝkƙǝn nduwa sǝnang ngganda hai wa.”<verse eid="MAT 13:13" /></para>
  <para style="b" />
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />“Ndǝn na lǝghǝtta ˈya ndaana annabi Ishaya:</para>
  <para style="b" vid="MAT 13:14" />
  <para style="q1" vid="MAT 13:14">‘A sǝkɗun ˈya ndaani,</para>
  <para style="q2" vid="MAT 13:14">Mbun sǝnang hai wa,</para>
  <para style="q1" vid="MAT 13:14">A naɗun ˈya ǝnani,</para>
  <para style="q2" vid="MAT 13:14">mbun kukwalang hai wa.<verse eid="MAT 13:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Ƙǝsǝr na ten ndan kakrak,</para>
  <para style="q2" vid="MAT 13:15">mbǝ thlǝmaayi ndan sǝk ˈya wa,</para>
  <para style="q1" vid="MAT 13:15">nggǝlang nda yid ndan,</para>
  <para style="q2" vid="MAT 13:15">nanǝn kee mbǝ yid ndan na maana hai wa,</para>
  <para style="q1" vid="MAT 13:15">mbǝ thlǝmaayi ndan sǝk ˈya wa,</para>
  <para style="q2" vid="MAT 13:15">Mbǝ ten ndan sǝnang hai wa,</para>
  <para style="q1" vid="MAT 13:15">Mba nda kyaharra thlǝmadna ɓa wa,</para>
  <para style="q2" vid="MAT 13:15">ngwa ƙǝnang nggi kanda.’” <note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="xt"><ref loc="ISA 6:9">Ishaya6:9</ref>,<ref loc="ISA 6:10">10</ref></char></note><verse eid="MAT 13:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />“Amma na yid nun tǝ parka, ƙǝsǝr na nda namaana hai; tǝ thlǝmaayinun ƙǝm, ƙǝsǝr na nda sǝk ˈya. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Niya Pǝrang ƙǝkafek kun, annabiya hangga tǝ ka fiya tǝrmindan na ǝnɗi nanun ya, amma nawa ndan wa. Tǝrmindan sǝk ǝnɗi sǝk nun ya, amma sǝkkwa ndan wa.”<verse eid="MAT 13:17" /></para>
  <para style="s">Pǝr Yeeso ten karapuɗi kii tǝ hǝfrha</para>
  <para style="r">(<ref loc="MRK 4:13-20">Markus4:13-20</ref>; <ref loc="LUK 8:11-15">Luka8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“Nanǝnya kaama thlǝmaarha hai ngga, sǝk ten karapu ɗanun kii tǝhǝfǝdɗi. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Fingya sǝkka laɓar Kutǝryid Talara amma sǝnangwa nda hai wa, na nda ƙǝla wiirha hǝrgha hai a kwamana, ɓagha Tǝbǝlfeedɗa ɓa thlanggǝn ǝnɗa ɗǝ hǝf nanda ahur ndan hai. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Fingya wiiya hǝrgha aten keela hai nǝghǝn ƙǝla fingya sǝkka laɓarɗi thlǝghǝn nda fa tǝ wutsǝfayirha. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Amma kwa wa thlaara hai ngga wa, mbǝ mǝnda ha wa. A ɓa ɓillaarha ɓa nduwa sǝsaarha ƙǝsǝr ka laɓarɗi, mba nda kwas kyaharra hai wa. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Fingya wiiya hǝrgha ahu ndakhkya hai, nǝghǝn aten fingya sǝkka laɓarɗi, amma ɓillaarha yi ƙǝshidɗiya tǝ nggǝmnda ƙǝna ˈyaɓang nggǝn laɓarɗi ˈyaɗang tsǝrha nǝn fa mbǝ ˈyasǝ na nda mbang ǝnaarha ngga wa. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Amma fingya hǝf nǝn ahu chehweerha na ngga nǝghǝn aten nafiya sǝkka laɓar ɗi, sǝnang ngganda hai wal chikrha nda fingya kumnggit mahan-mahan, fingya kumnggit mikki-mikki, tǝ ƙǝm fingya haru-haru.”<verse eid="MAT 13:23" /></para>
  <para style="s">Karapu aten wuthlaafa ahur wan hwaliirha</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Nggǝrgha Yeeso thlǝghang karapu kanda sǝ, ndǝghǝn, “Kutǝryid Talara nǝghǝn kiya: Hǝf niifa wiirha ngga ahu hedghǝn. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />A fǝɗikrha nana fiya a ɓeena, ɓagha tǝtsanda ɓa hǝf wuthlaafa nǝn a pathlang wiid wan hwalidɗa hai wii fayighǝn nǝn. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Katǝrana wan hwalidɗi tsǝrha tǝ yiwee, nagha wuthlaafɗi ƙǝm a tsǝrha.” <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Tǝrgha ɓagha fatarya tǝhedɗa ɓa ndang ngganda tǝheedɗi, “Tuwuri nan, hedɗi hǝfang na tǝ wiirha ngga lǝghǝdɗǝ tǝ wuthlaafa! Kyagha nda ɓa a yanggi?” <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Ndagha tǝheedɗi, “ ‘Tǝtsanda ni ǝnagha ǝnɗiya!’” Ndagha fataryini, “Ɗan ƙǝɗang kanda ɗǝ wa?” <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Ndagha tǝheedɗi, “ ‘Awo.’ a ǝna ɗun kee nun ɗǝ ƙǝɗang kanda ɗǝ heu tǝ wan hwalidɗi. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />‘Malaman kanda tsǝnda kyab ƙǝl a shifiirha ana ɗǝm a halthghǝn. Tǝrgha a ndanggi fahalthya wurang ngganda wuthlaafa sǝ, ƙǝnang ngganda kanda djang ngganda ɗǝ, tǝrgha wan hwalidghǝn iree ƙǝnda ahu ɓirwa hai.’ ”<verse eid="MAT 13:30" /></para>
  <para style="s">Karapu aten wiirha na ƙǝla wan parsǝna</para>
  <para style="r">(<ref loc="MRK 4:30-32">Markus4:30-32</ref>; <ref loc="LUK 13:18">Luka13:18</ref>,<ref loc="LUK 13:19">19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Nggǝrgha Yeeso pǝrang karapu kanda, ndǝghǝn, “Kutǝryid Talara nǝghǝn kǝla wan parsǝna tǝrangna niifa hǝfanggǝn hai ahu hedghǝn. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Wiirha ni na ngguchit kaan ahur wiiya, amma tsǝnǝn sǝ, tsauka ɗǝfrha ni na manggǝn kaan ahur ɗǝfya heu, taksaagha wuɗikkya ƙǝn ndan ahu wuharyighǝn.”<verse eid="MAT 13:32" /></para>
  <para style="s">Karapu aten mekhna</para>
  <para style="r">(<ref loc="LUK 13:20">Luka13:20</ref>,<ref loc="LUK 13:21">21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Nggǝrgha Yeeso pǝrang karapu kanda ndǝghǝn, “Kutǝryid Talara nǝghǝn ƙǝla mekhna yangna nuneefa tǝ humbarha tasau mahan ana ɗǝ a ǝna mburodi. Ko nanǝn ǝnaghǝn mehenɗi sahai ngguchit kiya, nǝn chichaɗang hufgha sǝ.”<verse eid="MAT 13:33" /></para>
  <para style="s">Na Yeeso tsaharha tǝ karapu ka a lǝɗanggǝn ˈya nda annabi</para>
  <para style="r">(<ref loc="MRK 4:33">Markus4:33</ref>,<ref loc="MRK 4:34">34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Kala tsaharha na Yeeso ǝnaarha a fiya wumngga hai ƙǝl tǝ karapu, mbǝ ˈyasǝ nǝn thlǝghang kanda kula karapu wa. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />“Ndǝn lǝghǝdna laɓar Faara ndanǝn a mii annabi,</para>
  <para style="b" vid="MAT 13:35" />
  <para style="q1" vid="MAT 13:35">Niya kalang kunsǝ tǝ karapu,</para>
  <para style="q2" vid="MAT 13:35">niya pǝr ˈya na ɓǝɓee, ka ǝna nanda ƙǝshiirha.”<verse eid="MAT 13:35" /></para>
  <para style="s">Pǝr Yeeso ten karapuɗi yi wan hwaliirha tǝ wuthlaafa</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Malgha Yeeso fiya a ƙǝshi kyagha hur minda hai. Ndangga fatsahayighǝn, “Nan a hwan sa pǝrang ten karapuɗi kan yi wan hwaliirha tǝ wuthlaafa na ahu hedɗi.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Nggǝrangga Yeeso kanda sǝ, “Tǝheedɗi ndǝna Wan Niifa hǝfgha wiirha na ngga. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Hedɗi ndǝna ƙǝshiirha, wiirha na ngga ndǝna aten nafiya Kutǝryidɗi. Wuthlaafa ndǝna nafiya Tǝbǝlfeedɗi. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Tǝtsandǝɗi hǝfgha wuthlaafɗi a pathlang wan hwalidɗa ɗǝ ndǝna Sheetan. Halthɗi ndǝna mii ngwala ƙǝshiirha, fahalthyini ƙǝm ndǝna fathlǝngya Faara. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Ƙǝla wurang nanda wuthlaafa sǝ djang ngganda ɗǝ hu waarha, nǝn a naarha kee a mii ngwala ƙǝshiirha. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Na Wan Niifa a thlǝn fathlǝnggighǝn, ɗa nda ƙǝɗang ǝngya ɗǝ heu na ahu Kutǝryidghǝn na ɓang ɗimiyirha ɓa tǝ fingya na a ǝna mbǝlfeerha. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Na nda a muwang kanda ahu waarha ɗǝ mbuwa mǝra hai, a mbǝɗani na nanda naarha tǝrha tǝ ƙǝtmee. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Tǝrgha fingya ǝnagha nggayirha na nda a djaara hai ƙǝla yanfaara ahu Kutǝryid Chi ndan. Kala niifa natǝ thlǝmad sǝkrha, sǝkƙǝnǝn!”<verse eid="MAT 13:43" /></para>
  <para style="s">Karapu aten ƙǝna na ɓǝɓee</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />Nanǝn kee ndagha Yeeso, “Kutǝryid Talara nǝghǝn ƙǝla ƙǝna na ɓǝɓee walang na niifa hu heerha. Nanǝn tǝ wutsǝfayirha nggǝrghǝn ɓǝɓeng hai hu hedɗi, henggǝn ǝnggighǝn ɗǝ heu ka a wal wuɗǝɓǝla nǝn ngga henggǝn hedɗa sǝ.”<verse eid="MAT 13:44" /></para>
  <para style="s">Karapu aten djamkwatar</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />Ƙǝmɗa, Kutǝryid Talara nǝghǝn ƙǝla tǝshafiliirha na a kaɗa djamkwatar. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Ƙǝla nǝn hai na djamkwatarɗi tǝ wuɗǝɓǝla fa, henggǝn ǝnggighǝn ɗǝ heu henggǝn sǝ!<verse eid="MAT 13:46" /></para>
  <para style="s">Karapu aten panggaama</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“Tǝ ƙǝm, Kutǝryid Talara nǝghǝn ƙǝla panggaama muwang nanda hu wuri aama ɗǝ ƙǝs tǝngya nǝn ɗǝɗamǝn-ɗǝɗamǝn. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Lǝghǝdna panggamɗi, kahang ngganda ƙǝƙǝshɓangnda ɓa. Tǝrgha tsawa nda hai, wurang ngganda tǝngya sǝ na nggǝngga ahu kutaasa hai, amma tsamang ngganda fingyayina ɗǝ mbuwa ngga. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Ɓanǝn naarha kee a mii ngwala ƙǝshiirha. Na fathlǝngya Faara a ɓaarha ɓa wurang ngganda nafiya ɗǝ na a ǝna mbǝlfeerha ahur nafiya na a ǝna nggayirha. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Na nda a muwang fa mbǝlfeeya ahu waarha ɗǝ mbuwa mǝra hai, a mbǝɗani na nanda naarha tǝrha sǝ tǝ ƙǝtmee.”<verse eid="MAT 13:50" /></para>
  <para style="s">Suhurra tǝ weerǝnda ƙǝna</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Tsahangga Yeeso mee fatsahayighǝn, “Sǝnang ɗun ǝnggina hai heu ya wa?” Nggǝrang ngganda sǝ, “Oh, sǝnang ɗan hai.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Tǝrgha nggǝrghǝn chikƙǝn ndaagha, “Kala tǝmalǝmnda ngyakhrha tsauka tǝtsaharha ahu Kutǝryid Talara nǝghǝn ƙǝla tuwure kyangga hurad tǝ weerǝnda ǝnggighǝn sǝ a mbǝrha ɗǝ ɗǝfnǝn ƙǝnaghǝn sǝ.”<verse eid="MAT 13:52" /></para>
  <para style="s">Kar nda Yeeso a Nadzarat</para>
  <para style="r">(<ref loc="MRK 6:1-6">Markus6:1-6</ref>; <ref loc="LUK 4:16-30">Luka4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Ngwalangna Yeeso pǝr karapu yini mal mbǝɗa nǝn. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Wudgha hu talghǝn ɗǝ Nadzarat. Tsaha nǝn ha hu ƙǝn tsahad Yahudaya, fiya heu sǝkka ndǝn ǝna ǝnwulteena na nda, na nda a ndaarha, “Walgha niifɗi tur sǝndǝɗi tǝ sǝsǝmnda ǝna ǝnwulteengya a yanggi?” <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Tǝrgha na nda a ndaarha, “Mbǝ wan kafinta ɗani ya, sǝnɗǝm Mairamu man, tǝ wanmanggighǝn nda Yakubu tǝ Yisufu, tǝ Siman tǝ Yahuda? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Kulo wanmanggighǝn nishya ya ahur nǝm. Tsahaghǝn ǝnggini a yanggi ya?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Nanǝn kee, karghǝnda fa, fǝr wanda ƙǝkafek tǝghǝn wa. Tǝrgha ndangga Yeeso kanda, “Na nda manang nda annabi ko a yanggini ƙǝl ahur talghǝn ahu nafiyighǝn.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Əna ǝnwulteengya nǝn ngguchit kee, ƙǝsǝr ka yamid fǝrƙǝkafekkid ndan.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Mǝrra Yahaya Tǝbaptisǝma</para>
  <para style="r">(<ref loc="MRK 6:14-29">Markus6:14-29</ref>; <ref loc="LUK 9:7-9">Luka9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />A sayidɗi Sǝkna Hirdus Kutǝr chehweed Nggalili laɓar Yeeso, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />ndanggǝn fataryighǝn, “Yahaya Tǝbaptisǝma ni ya thliigha sǝ hu mǝrra! Ndǝn nanǝn tǝ sǝsǝmnda ǝna ǝnwultenggini ya.”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Nanǝnya Hirdus ˈwaɗǝ teena ƙǝsang ɗǝ Yahaya, ƙǝnanggǝn, muwanggǝn hu porsǝna ɗǝ ka Herodiya nu wanman Filibus kahang nǝn. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Ƙǝsǝr Yahaya nǝn naarha ndang nda Hirdus ahu ngyakhrha Yahudaya kamngwa a kahanggǝn Herodiya wa. <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Na mid Hirdus sǝ a ɓǝlanggǝn Yahaya, amma nǝghǝn a tǝrǝm fiya, ƙǝsǝr fiya heu fǝr nda kǝkafek tǝ ndaarha Yahaya Annabi ni.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Amma a far wutsǝfayid lǝghǝtta ɓen nggǝtta Hirdus, wutarad Herodiya rǝɓanggǝn kanda sǝ, mbǝnanggǝn Hirdus kaan. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Nggǝmɗa fa har tǝ aah thlǝm Faara, kala ˈya na midghǝn nǝn a fǝranggǝn.<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />Ndangga man wutaradɗi ɗǝgha ndaarha, “Ten Yahaya Tǝbaptisǝma na minna ahu pǝlee.”<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Kutǝrɗi ƙǝm ǝna masǝnɗi kee nǝn aten ˈya ndanǝn, amma ƙǝsǝr ka thlǝm Faara aah nǝn a mbed nafiya mbunǝn ɓa, ǝnang ǝnɗa nda ndanǝn. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Thlǝn sodjaya nǝn a kyathlang ngganda ten Yahaya ɓa ahu porsǝna. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Ɓang ten ɗa nda wutaradɗa ɓa ahu pǝlee, ɗanggǝnǝn man ɗǝ. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Tsǝɓaku ɓagha fatsahaya Yahaya ɓa tǝrang ngganda mǝrrǝghǝn ɓa pang ngganda, tǝrgha ɗǝnda ɗǝ pǝranggǝn nda Yeeso.<verse eid="MAT 14:12" /></para>
  <para style="s">Hǝɓang Yeeso nafiya haru kumnggit tuf</para>
  <para style="r">(<ref loc="MRK 6:30-44">Markus6:30-44</ref>; <ref loc="LUK 9:10-17">Luka9:10-17</ref>; <ref loc="JHN 6:1-14">Yahaya6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Sǝkna Yeeso laɓarɗi, kyagha hu kombuwol hai, mal mbǝɗa nǝn ɗǝgha mbǝrha ɗǝ ka a tsauka katenggǝn. Amma sǝkna fiya mbǝɗi nanǝn sǝ, mbu samadghǝn nda tǝ saara ahu talya ɓa hangga. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Tǝrna Yeeso hai ahu kombuwol ɗi, na fiya nǝn hangga haɗangganda fa, ƙǝnanggǝn haya.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Na figrha a tsǝrha hai, ɓagha fa tsahayighǝn a thlǝmadghǝn ɓa, ndang ngganda, “Kaheerha ni ya tǝ kǝm tsǝ figrha hai, kalu fiya hai ɗǝnda hu talya ɗǝ, tǝna nda ɗǝ hii ǝnnarhami.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Amma nggǝrangga Yeeso kanda sǝ, “Kamngwa a wii nda a miirha wa, fǝraman ˈya kanda ǝna nda mii.”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Ndangga nda, “Mburodi tuf ni kee a harnan, tǝ tǝngya sǝri.”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Ndagha, “Ɓemadghǝn mbǝɗa ɓa ya.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Tǝrgha ndanggǝn fiya tsawanda hai a ten hwaliirha, tǝranggǝn mburodi ɗa sǝ tuf tǝ tǝnggini sǝri, kǝlagha talara sǝ, ɗǝfang parka nǝn in. Kyanggǝn mburodi ɗa hai fǝranggǝnǝn fatsahayighǝn ndǝghang nggǝnda fiya. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Kii nda kanda heu kǝla na mindan pa tsǝghanggǝn kanda, tǝrgha fatsahayighǝn wumangga nda katǝbghǝn kutasya kumkap sǝri. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Hǝshya kiigha mburodi ɗi sǝl nda haru kumnggit tuf, thlǝɗang ngwa nda nishya tǝ wundakhnaya wa.<verse eid="MAT 14:21" /></para>
  <para style="s">Wii Yeeso a ten aama</para>
  <para style="r">(<ref loc="MRK 6:45-52">Markus6:45-52</ref>; <ref loc="JHN 6:15-21">Yahaya6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Tsu a mbǝɗi kee, ndangga Yeeso fatsahayighǝn kya nda hu kombuwal hai tǝɗang ngganda wuri aama teena, ndǝghǝnggi ƙǝm ishgha hai kal fiya nǝn hai. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />A kwasamad ɗi kal nǝn fiya hai, tǝrgha wumnda sǝ katenggǝn ka a hwan Faara nǝn, tsǝgha figrha hai ndǝghǝn a mbǝɗi katenggǝn.<verse eid="MAT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 14:24" />Amma ahu sayidɗiya kombuwol ɗi inggun ma ƙǝkǝshɓanda, fatsahayini a habɓaarha tǝ ɓereurha tǝ kuɗufulla aama.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Takhna mbǝrha a ɗathla hai ɓagha Yeeso thlǝman ndan ɓa, a wiirha aten aama. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Nana fatsahayighǝn ndǝn a wiirha aten aamɗi tǝrma nda. Ka hǝreenga huhwa nda, tamngganda ndaarha mǝnda-mǝnda ni.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Amma tsu kee kalangga Yeeso kanda sǝ, “A tǝrǝm ɗun wa nggini ƙǝrsaama.”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Ndangga Siman, “Chinǝm, ana ƙǝkafek sani, ndee ɗi thlǝmad wa ɗǝ a aten aamɗi.”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Ndangga Yeeso, “Haˈi, ɓoɓa,” tǝrgha siman tǝrgha hai ahu kombuwal ɗi, ƙǝs wiirha nǝn aten aamɗi a thlǝmad Yeeso ɗǝ. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Amma nanǝn ɓereu ˈyaarɗi tǝrǝmngga, nagha a timnda hai, huhwagha ndagha, “Hǝrye Chinǝm.”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Tsu kee Ƙǝsgha Yeeso harghǝn ƙǝsanggǝn ɓa, ndangga Yeeso, “Ƙǝɗi fǝrƙǝkafekkid wa, ƙǝn fǝr waana ƙǝkafek na mbang wiirha aten aamɗi?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Kyana nda ahu kombuwal hai, ishgha ɓereu ˈyaarɗi. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Tǝrgha fatsahayighǝn ɗǝfang shilee nda in, na nda a ndaarha, “Ƙǝkafek Wan Faarani Sa.”<verse eid="MAT 14:33" /></para>
  <para style="s">Ƙǝnang Yeeso haaya a Djanasarat</para>
  <para style="r">(<ref loc="MRK 6:53-56">Markus6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />A kwasamadɗi tǝɗang na nda wuri aamɗi teena, tǝra nda hai a Djanasarat. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Kukwalang na nafiya talɗa hai Yeeso ni, thlǝn farha nda ahu talya ɗǝ na ahu chehwedɗi kahat. Nagha fiya a ɓarha ɓa tǝ haaya, ka a ƙǝnanggǝn kanda. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Hwanggǝnda a malanggǝn haaya tsuwar mii kotodghǝnda fa kee, kala niifa tsuwargha ndǝn fa ƙǝnɗǝ.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Tsahad chichiiya ha</para>
  <para style="r">(<ref loc="MRK 7:1-13">Markus7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Tǝrgha fingya Farisaya tǝ famalǝmngya ngyakhrha thliigha ɓa a Urshalima tsahang mee nda Yeeso, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Kama na fatsahayiwa hwasang ǝntin shingginǝm? Mba nda tsaɓang haryi ndan ɗǝ a hǝb ǝnnarhami nda wa!”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Nggǝrangga Yeeso kanda sǝ, “Kama nun hwasang nda ǝngya ndaana Faara ka ǝntinggi nun? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Ƙǝsǝr ndagha Faara, ‘Fǝrang mamnggirha nda muwa tǝ tsu’ tǝ ƙǝm ‘Kala niifa sargha man nduwa chin tǝtani a ɓǝlang ngganda.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Amma nun tsaharha ha tǝ ndaarha ana ˈya sǝ a haar niifa na a ɗanggǝn chin sǝ nduwa man, nǝn ndaarha ‘ˈya nun a kya waala a fanna ɗǝfang ɗi ndǝn Faara ɗǝ.’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Ahu kwamana kiya Mǝmǝlwa a fǝrang mamnggirha nǝn fa nggǝtyighǝn tǝghǝn wa. Nanǝn kee kar laɓar ɗanun fa ndaana Faara ka ǝntin nun. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Kun fathǝrɓuya! Laɓar Faara ndaana Ishaya aten nun mǝmǝlni:<verse eid="MAT 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‘Nafiniya ahu mii ndan ni kee na nda fǝre mamnggirha,</para>
  <para style="q2" vid="MAT 15:8">amma huryi ndan nǝghǝn inggun ma nggi;<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />ka ni kee na nda ɗǝfee shilee teena,</para>
  <para style="q2" vid="MAT 15:9">ƙǝsǝr ɗǝfang ngganda tsahad ngyakhkya fiya ha a mbee a meyed laɓar Faara.’ ”<note caller="*" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ISA 29:13">Ishaya29:13</ref></char></note><verse eid="MAT 15:9" /></para>
  <para style="s">Əngya na tsawang nda niifa ɗimi a mbed Faara</para>
  <para style="r">(<ref loc="MRK 7:14-23">Markus7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Tǝrgha aagha Yeeso nafini wumngga hai a thlǝmadghǝn ɓa ndǝghǝn, “Keema thlǝmaarha fa tǝnun sǝn ǝnɗi niya thlǝkrha. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />ˈYa kyagha hur niifa hai mbǝ ndǝna tsawang tǝ ‘paarha’ fa wa, amma ƙǝl ˈya na a kyarha ɓa a miighǝn ndǝna tsawang tǝ ‘paarha’ fa.”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Tǝrgha fatsahayini ɓa nda thlǝmadghǝn ɓa tsahang mee nda, “Sǝnna sǝ sǝb hur Farisayina ɗǝ sǝk nanda laɓarɗi?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Nggǝrangga Yeeso kanda sǝ, “Kala hǝfrha a mbǝ pǝpa na a talara hǝfgha ndǝn wa, na nda a ƙǝɗang ɗǝ tǝ thlarghǝn. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Malaman kanda. Na nda ƙǝla mangya kwamaya na nda a ƙǝs sǝsal kwamaya. Ana kwamarha a ƙǝs sǝsal kwamarha, kanda kyab na nda a mukrha hu kwaarha hai.”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Ndangga Mbiturus Yeeso, “Pǝrang ten karapuɗi kan ya.”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Tsahangga Yeeso mee kanda, “Ɓal wun kula sǝnang hai wa? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Kala ˈya ǝnana niifa mii nǝn kyarha hurghǝn ɗǝ nggǝrghǝn kyarha sǝ a fadghǝn. <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Amma ǝnɗi na a kyarha ɓa ahu mee, kyaghǝn sǝ ahur niifa. Ndǝghǝnni na tsawang nda niifa tǝ ‘paarha’ fa. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Ƙǝsǝr ahur niifa sǝ ndǝna numad mbǝlfeerha kyarha ɓa, tǝ ɓǝl farha, tǝ kulafayirha, tǝ pateyirha, tǝ ngaara, tǝ ƙǝnang paama nggaɓaarha mu tǝ sǝb thlǝma. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Əngginiya ndǝna tsawang niifa tǝ paarha fa a mbed Faara, amma hǝb ǝnnarhami kula tsab haara mbǝ ndǝna tsawang niifa tǝ paarha fa a mbed Faara wa.”<verse eid="MAT 15:20" /></para>
  <para style="s">Fǝrƙǝkafekkid nuneefa tǝ kanˈaniyarha</para>
  <para style="r">(<ref loc="MRK 7:24-30">Markus7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Tǝrgha Malgha Yeeso Nggalili ɗǝgha hu chehweed Taya ɗǝ tǝ Sidon. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Na nuneefa sǝ tǝ Kanˈana ɓagha thlǝmadghǝn ɓa hwanggǝnǝn, “A haɗoyi fa Chinǝm, Wan Ndauda, ƙǝsǝr wutarad na nǝghǝn tǝ ǝnkaheerha fa nǝn naarha sǝsang nda kaan.”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Amma nggǝrang ngwa Yeeso sǝ wa. Tǝrgha ndangga fatsahayighǝn, “Ndang a wiigha, nǝghǝn a ɓilla ƙǝm tǝ hwanda.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Nggǝrgha Yeeso sǝ, “Thlǝnna nda nggi ɓa ka ɓi ɗang nda chauraya Isǝreela sǝ sahadgha kee.”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Ɓagha nuɗa ɓa ɓǝrgha hai a mbedghǝn nggǝrghǝn hwanggǝn, “Chinǝm ɗeesǝ!”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Nggǝrgha Yeeso sǝ, “Kamngwa tǝranggǝm ǝnnadmid wundakhnaya fǝranggǝnǝm wuɗaya wa.”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Nggǝrangga nuɗa sǝ, “Ƙǝkafek ni Chinǝm, amma ko wuɗaya ni na nda hǝb fǝfǝsǝrra ǝnnarhami hǝrgha hai a mbǝd ɗauyad turi ndan.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Tǝrgha nggǝrangga Yeeso sǝ, “Sa nuneefa na fǝrƙǝkafekkid wa manggǝn kaan, ˈya na midwa wal nan.” Tsu kee ƙǝngga wutaradɗi keeghǝn.<verse eid="MAT 15:28" /></para>
  <para style="s">Ƙǝnang Yeeso nafiya hangga</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Malgha Yeeso mbǝɗi ɗǝgha wuri aam Nggalili ɗǝ tǝrgha wumnda sǝ tsauka hai. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Wumngga fiya thlǝmadghǝn ɓa hangga. Ɓa nda ɓa tǝ sǝfǝngya, tǝ kwamaya, tǝ fingya mǝrna fandan hai, tǝ fingya mbuwa mbang kaala sǝ tǝ fingya haaya hangga. Ɗǝfang ngganda kanda hai a mbed Yeeso, ƙǝnanggǝn kanda heu. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Ƙǝsangga ǝnwulteena fiya wumngga hai na nanda fingyayini mbuwa mbang kaala sǝ kanda a kaala sǝ, fingya mǝrna fandan hai wal nda ƙǝnda, sǝfǝngya a wiirha hai tǝ ƙǝm kwamaya a na maana hai. Na nda a fal Faara yi Isǝreela.<verse eid="MAT 15:31" /></para>
  <para style="s">Hǝɓang Yeeso nafiya haru kumnggit faɗa</para>
  <para style="r">(<ref loc="MRK 8:1-10">Markus8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Tǝrgha aagha Yeeso fatsahayighǝn ɓa ndanggǝn kanda, “Na nafini a haɗee fa ya. Ɓeena mahan kanda a thlǝmadna a mbǝɗiya, tahang ngwa ˈya kanda ha na a ǝna nda mii wa. Mbǝ minna sǝ kal kanda ni hai wii nda wureɗǝ a miirha wa, asǝmha ɗǝgha shiwid kanda teena a kwamana.”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Nggǝrangga fatsahayighǝn sǝ, “A yanggi ɗǝnǝm wal mburodi ɓa a kahedɗi ya na a tsǝghanggǝn fiya hangga kiya?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Tsahangga Yeeso mee kanda, “Mburodi kurmi ni a har nun?” Ndang ngganda, “Mǝd tǝ tǝngya na miɗiɗi ngguchit.”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Ndangga Yeeso fiya wumngga hai a tsawa nda hai a hweeɗe. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Tǝrgha haranggǝn mburodi yina sǝ mǝd tǝ tǝnggini, usa nǝn Faara, kyanggǝn hai kutelth-kutelth. Fǝranggǝnǝn fatsahayighǝn ndǝghang nggǝnda fiya ɗǝ. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Kanda heu kii nda nggaala nda. Wumangga fatsahayini katǝbghǝn kutasya mǝd. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Nafiya hǝbgha ǝnnadɗami hǝshya haru kumnggit faɗa kula thlǝɗang nda nishya tǝ wundakhnaya. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Akwasamadɗi kalna Yeeso fiya hai, kyagha ahu kombuwol hai ɗǝgha chehweed Manggadan ɗǝ.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Kaɗa mamngya ǝnsakhrha</para>
  <para style="r">(<ref loc="MRK 8:11-13">Markus8:11-13</ref>; <ref loc="LUK 12:54-56">Luka12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Farɗasǝ Farisaya tǝ Sadukiyaya ɓa nda thlǝmad Yeeso ɓa ka a ƙǝƙǝrang ngganda, na mindan sǝ a kyaɗang ǝnsakhrha nǝn kanda yi wulteena a talara hai tǝna nda sǝndasǝ nǝghǝn tǝ sǝsǝmnda Faara fa. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Nggǝranggǝn kanda sǝ, “A tsǝ figrha hai, a naɗun fǝrakh amshi tsǝɗǝ yiɓa, nun ndaarha na mbǝrha a naarha kukwar a ɓinda. <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />A tsar ƙǝm a naɗun fǝrakh amshi yiɓa, nun ndaarha a weeriya na ˈyaara a ɓaarha. Kun a sǝnang ǝngya hai na a katǝrarha hai a fǝrakh amshi, amma mbun a sǝnang ǝnsakhkya ƙǝshiid weeri hai ya wa. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Ƙǝl fa mbǝlfeeya, tǝ kulafaya ƙǝshiid weeriya kandani na kaɗa ǝnsakhkya, amma ǝnsakhrha niya kyaɗang kanda ndǝna yi annabi Yunana.” Tǝrgha malgha Yeeso kanda wii fayighǝn nǝn.<verse eid="MAT 16:4" /></para>
  <para style="s">Mehen Farisaya tǝ yi Sadukiyaya</para>
  <para style="r">(<ref loc="MRK 8:14-21">Markus8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Akwasamadɗi tǝɗang nanda wuri aam Nggalili teena ƙǝlagha fatsahayina hai takhkwa nda mburodi ha ɓa wa. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Ƙǝsgha Yeeso thlǝmandan, “Kwarama tǝ mehen Farisaya tǝ yi Sadukiyaya.”<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Katǝrang ngganda ngaala hai tǝ ndan ƙǝsǝr ka takhkwa nanda mburodi ha ɓa.<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Sǝnangga Yeeso ǝnɗa hai na nanda a ndikrha atenggǝn, nanǝn kee ndanggǝn kanda, “Ƙǝɗi fǝrƙǝkafekkid nun! Kama nda nun a ngaala tǝ ndan ka mbuwana mburodi sǝ a har nun? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ɓal wun kula sǝnang hai wa? Ɗal wun teena hai tǝ mburodi tuf hǝɓang ni nafiya haru kumnggit tuf wa, tǝ ƙǝm kutasya kurmi wumang nun katǝpghǝn? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Nduwa mburodi mǝd hǝɓang ni nafiya haru kumnggit faɗa, kutasa kurmi wumang nun katǝpghǝn? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Mani sǝnangwa nun hai tǝ ndaarha mbǝ aten mburodi ni niya tsǝ laɓaara wa? Niya nggǝr ndaarha, ‘Kwarama tǝ mehen Farisaya tǝ yi Sadukiyaya.’ ”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Tǝrgha a mbǝɗiya sǝnangga fatsahayina hai mbǝ a tsǝ laɓaara aten mekhna na ahu mburodi wa, amma aten tsahad Farisaya ni tǝ yi Sadukiyaya.<verse eid="MAT 16:12" /></para>
  <para style="s">Fǝr Mbiturus ƙǝkafek Yeeso ndǝghǝnni Ƙǝrǝsti</para>
  <para style="r">(<ref loc="MRK 8:27-30">Markus8:27-30</ref>; <ref loc="LUK 9:18-21">Luka9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Ɓana Yeeso chehweed Kaisariya Filibi ɓa, tsahang mee nǝn fatsahayighǝn, “Na fiya a ndaarha wunni Wan Niifa?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Ndang ngganda, “Fingya a ndaarha Yahaya Tǝ Mbaptisǝma, fingya Ilya, fingya ƙǝm Irmiya nduwa tal ahur annabiya.”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Ndangga Yeeso kanda, “Amma kun wu nuwun a ndaarha wunni nggi?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Ndangga Mbiturus, “Sani Ƙǝrǝsti, Wan Faara natǝ yibrha ha.”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Ndangga Yeeso, “Tǝ parka ni sa, Siman wan Yunana, mbǝ niifa ni thlǝwogha ǝnɗiya wa, amma Pǝpa ni na a talara. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Niya ndorha sa Mbiturus, aten ferɗiya ndǝn niya tǝn ƙǝn hwan Faarna, mbuwana sǝsǝmnda hwanga mbang chang hai. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Niya furo ǝncha kwatmingya yi Kutǝryid Talara. Kala ˈya ƙǝnang nun hai ahu ƙǝshiirha nǝghǝn ƙǝƙǝna hai kee a talara, tǝ ƙǝm kala ˈya kwasang nun hai hu ƙǝshiirha nǝghǝn kukwasa hai ƙǝm a talara.” <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Tǝrgha ƙǝs thlǝmad fatsahayighǝn nǝn a pǝrang ndan niifa ndǝghǝnni Ƙǝrǝsti wa.<verse eid="MAT 16:20" /></para>
  <para style="s">Thlǝk Yeeso kwaman mǝrrǝghǝn</para>
  <para style="r">(<ref loc="MRK 8:31-38">Markus8:31-38</ref>; <ref loc="MRK 9:1">9:1</ref>; <ref loc="LUK 9:22-27">Luka9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Ka a farɗi katǝrangga Yeeso pǝranggǝn fatsahayighǝn a pǝpal tǝ ndaarha tǝta ni a ɗǝgha Urshalima ɗǝ ɗǝgha sǝsaarha aten ǝngya hangga ahar shingya tǝ firistaya tǝ famalǝmngya ngyakhrha. Na nda a ɓǝlang nda, amma a far ɓeena yi mahan nǝn a thliirha sǝ ahu mǝrra.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Amma ɗǝgha Mbiturus tǝghǝn man patu ɗǝ ndanggǝn, “A kaptangga Faara ɗǝ, Chinǝm, mbǝ tam katǝrarha hai tǝ sa kee wa!”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Kyahargha Yeeso hai ndanggǝn Mbiturus, “Nduwu hai tǝ nggi sa Sheetan, tsauna fer kii saara ka nggi. Na a ƙǝlang ǝngya kee na mid fiya, amma mbǝ yi Faara wa.”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Tǝrgha ndangga Yeeso fa tsahayighǝn, “Ana mid niifa sǝ tsauka tǝ mbusamad na, tǝta ni malanggǝn nggǝm altenggǝn, tǝranggǝn kaɗidghǝn sǝ mbu samad na nǝn. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Ƙǝsǝr kala niifa na midghǝn ɗǝfang yiɓǝdghǝn ɗǝ nǝn a ƙǝɗeng nda. Amma kala niifa ƙǝɗengga yiɓǝdghǝn ka nggi, ɗǝfang nǝn ɗǝ. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Ma chighang nǝn niifa a walɗǝ ǝn ƙǝshiirha heu ƙǝɗenggǝn shingndǝghǝn? Nduwa mani kalgha shingndǝghǝn mu? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Ƙǝsǝr wan Niifa nǝn a ɓarha ɓa ahu mamnggid Chin tǝ fathlǝnggighǝn ngwang kumarha nǝn fiya heu aten ǝngya ǝnana nda. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Niya pǝrang ƙǝkafek kun, na fingya sǝ ƙǝƙǝt a mbǝɗiya mba nda a mǝra wa ƙǝl ma nanda Wan Niifa ɓayi ahu Kutǝryidghǝn.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Mamnggid Yeeso</para>
  <para style="r">(<ref loc="MRK 9:2-13">Markus9:2-13</ref>; <ref loc="LUK 9:28-36">Luka9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Akwasamad ɓeena mikki tǝrangga Yeeso Mbiturus tǝ Yakubu tǝ Yahaya wanman Yakubu tǝraa nda wumnda sǝ, tǝna nda narha katendan. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />A mbǝɗi nagha fiya ndǝn nggǝrɗa hai a mbed ndan. Nagha pǝmnggǝn a chimnda fa ƙǝla yanfaara, tǝ ƙǝm lukkighǝn tsawa nda pǝpet ƙǝla kukwaryirha. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Kula sǝndǝndan sǝ kyagha nda Ilya ɓa tǝ Musa katǝrang ngganda ndikrha hai tǝ Yeeso.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Ndangga Mbiturus Yeeso, “Chinǝm, nǝghǝn ngga nanǝm a mbǝɗiya, a nggǝmna fa, ngwa ǝna chama ni mahan-tal yiwa, tal yi Musa tǝ ƙǝm tal yi Ilya.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Ndǝghǝn aten ndikrha kee, ɓagha hashbe ɓa nggǝlanggǝn kanda, sǝk urarha nda hai ahur hashbiɗi tǝ ndaarha, “Waana niya, nggǝmni. Kaaman thlǝmaarha fa!”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Sǝkna fatsahayini uradɗi kee fǝla nda hweeɗa hai ka hǝreenga. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Tǝrgha ɓagha Yeeso ɓa tsuwar kanda nǝn fa ndanggǝn kanda, “Thleema sǝ, a tǝrǝm ɗun wa.” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Tǝrang nanda tendan sǝ, ƙǝla nda ɗǝ ko niifa, ƙǝl Yeeso katenggǝn.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Na nanda a tǝraa hai a wumndǝɗi, ndangga Yeeso kanda, “A pǝrang ɗun ˈya niifa nanun wa, ƙǝl a thlid Wan Niifa sǝ ahu mǝra.”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Tǝrgha tsahangga fatsahayighǝn mee, “Mani na famalǝmngya ngyakhrha ndaarha annabi Ilya ni a ˈwa wutta ɓa ma Ƙǝrǝsti?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Nggǝrgha Yeeso sǝ, “Ƙǝkafek ni na Ilya a ˈwa ɓarha ɓa ka ɓagha tangsang ǝngya heu mǝmǝl. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Amma niya ndang nda kun, ˈwad Ilya teena ɓaɗa ɓa, sǝnangwanda hai wa, amma ǝnang ˈya nda fa ƙǝla tǝrna mid ndan. Nǝghǝn kee ƙǝm ɓana Wan Niifa sǝsaarha ahar ndan.”<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Tǝrgha fatsahayini sǝnang ngganda hai nǝghǝn a ndikrha aten Yahaya Tǝbaptisǝma.<verse eid="MAT 17:13" /></para>
  <para style="s">Ƙǝnang Yeeso Wundǝlaarha na tǝ ǝnkaheerha fa</para>
  <para style="r">(<ref loc="MRK 9:14-29">Markus9:14-29</ref>; <ref loc="LUK 9:37-43a">Luka9:37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />A sar wumndǝɗi, fiya hangga wumngga hai a ƙǝla kanda fa. Ɓagha niifa thlǝmad Yeeso ɓa ɓǝrgha hai ndǝghǝn, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“Chinǝm, a haɗowa waana fa. Nǝghǝn tǝ kacheela fa nǝn sǝsang nda kaan. Nǝn yakh muwang nda hu waarha hai nduwa ahu aama hai. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Ɓang ɗi ndǝn fatsahayiwa ɓa, amma mbang ngwanda ƙǝnang wa.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Ndagha Yeeso, “Kun nafiya ƙǝshiid weeriya, mbuwa tǝ fǝrƙǝkafek fa mbǝlfeeya! Pakwanɗǝ ni tsaurha tǝ kun? Tǝ ƙǝm pakwanɗǝ ni ƙǝrǝssa tǝ yamid fǝrƙǝkafekkid nun? Fǝreema wanɗa ɓa.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Tǝrgha Yanangga Yeeso ǝnkaheedɗi na ahur wanɗi, kyagha sǝ mal wanɗa nǝn. Tsu a mbǝɗi kee ƙǝngga.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Akwasamadghǝn tsahangga fatsahayighǝn mee ɓǝɓee, “Mani ǝnagha ndǝn kyangwa nan ǝnkahedɗa sǝ?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Ndangga Yeeso kanda, “Ƙǝɗi fǝrƙǝkafekkid nun. Niya pǝrang ƙǝkafek kun, ana fǝrƙǝkafek sǝ a fad nun ngguchit ƙǝla wan parsǝna, nun a ndang nda wumndǝɗi ya, ‘Ndusu a mbǝɗiya a mbǝɗa ɗǝ taarha,’ nǝn a nduwussa. Mbǝ ˈya sǝ na kal kun mu wa.”<verse eid="MAT 17:20" /></para>
  <para style="s">Nggǝr Yeeso ndikrha aten mǝrrǝghǝn</para>
  <para style="r">(<ref loc="MRK 9:30-32">Markus9:30-32</ref>; <ref loc="LUK 9:43b-45">Luka9:43b-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Akwasamadɗi nggǝr nanda wumnda hai a Nggalili, ndangga Yeeso fatsahayighǝn, “Na nda a fǝr Wan Niifa a har fiya hai. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Na nda a ɓǝlang nda, amma akwasamad ɓeena mahan na nda a thleng sǝ ahu mǝrra.” Lǝghǝdgha fatsahayini tǝ sǝbrha hura.<verse eid="MAT 17:23" /></para>
  <para style="s">Tii tsamnda Ƙǝn hwan Faara na a Urshalima</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Ɓana Yeeso tǝ fatsahayighǝn a Kafarnahum ɓa, fathlǝ tsamngya Ƙǝn Faara na a Urshalima ɓa nda thlǝmad Mbiturus ɓa ndang ngganda, “Mbǝ tǝmalǝm ndǝnun tii tsamnda Ƙǝn hwan Faara na a Urshalima wa?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Nggǝranggǝn kanda sǝ, “Haˈi, nǝn tiirha.” Kyana Mbiturus hur minda hai tsauna Yeeso sǝ, katǝrangga Yeeso kalang sǝ, “Siman, mana ndaarha aten tsakh miiɗi ya? A har wun na kutǝrya ƙǝshidɗiya thlǝ tsamnda, ahar wanggindan nduwa ahar nafiya pak wa?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Ndagha Mbiturus, “Ahar nafiya pak.” Ndagha Yeeso, “Nanǝn kee mbǝ wanggindan tiirha wa. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Amma mbǝ minnǝm sǝ ƙǝsangganda ƙǝm tǝ ɗimiyirha wa, ɗuwa hu wuri aama ɗǝ ɗa muk nggal aama. Tǝna ˈwana ƙǝsa, inang miighǝn hai na a wal wuɗǝɓǝl wurirha na a tsǝk tii tsamndǝɗi. Harang ɗa tii tsamnduwa tǝ yina.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Wunni manggǝn hu Kutǝryid Faara</para>
  <para style="r">(<ref loc="MRK 9:33-37">Markus9:33-37</ref>; <ref loc="LUK 9:46-48">Luka9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Ahu sayidɗiya ɓagha fatsahaya thlǝmad Yeeso ɓa tsahang mee nda, “Wunni manggǝn hu Kutǝryid Faara?”<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Aagha Yeeso wundakhne ɓa na ngguchit ishanggǝn a maɗufun ndan. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Tǝrgha ndaagha, “Niya pǝrang ƙǝkafek kun, a malanggun ɗimiyid nun tsawun ƙǝla wanɗi na ngguchit ya wa mbun tam kyarha hu Kutǝryid Faara ɗǝ wa. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Nanǝn kee kala niifa manangwawa altenggǝn tsauka ƙǝla wanɗi na ngguchit ya ndǝghǝn ni na manggǝn hu Kutǝryid Faara. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Kala niifa thlǝgha wundakhne fa ƙǝla yanɗiya ahu thlǝmna nggini thlǝnǝn fa.”<verse eid="MAT 18:5" /></para>
  <para style="s">Əngya na kyang niifa hu ɗimiyirha hai</para>
  <para style="r">(<ref loc="MRK 9:42-48">Markus9:42-48</ref>; <ref loc="LUK 17:1-2">Luka17:1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />Amma ana niifasǝ kyangga tal ahur wanggini na nggu-ngguchit ya fǝrgha ƙǝkafek a nggi ahu ɗimiyirha hai, a nggushi waghang nda fǝn hǝrha ura mughang ngganda ahu wuri aama ɗǝ. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Kawa ƙǝshiirha ƙǝsǝr ka ǝnggini na nda ǝnaarha kyang ngganda fiya hu ɗimiyirha hai. Ənggini na kyang nda fiya hu ɗimiyirha hai tǝtani a ɓagha ɓa, amma na sǝbrha hura a ƙǝla niifɗa fa ǝnagha kee.<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />Ana harwa nduwa sarwa a kyorha hu ɗimiyirha hai, kyathlang ɗǝ muwangga ɗǝ. A nggushi kyana hu ahu yibrha ɗǝ mbuwa ngwalarha tǝ haara tal nduwa saara tal ma nana tǝ haara kyab nduwa saara kyab muwo wanda ahu waarha ɗǝ mbuwa mǝra hai. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />A kyo yidwa ahu ɗimiyirha hai, ƙǝɗang ɗǝ muwangga ɗǝ. A nggushi kyana ahu yibrha ɗǝ mbuwa ngwalarha tǝ yirha tal, ma muwo wanda ahu waarha ɗǝ mbuwa mǝra hai tǝ yidwa kyab.<verse eid="MAT 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Kwarama, a sarɗun wanggini na nggu-ngguchit ya wa. Ƙǝsǝr niya ndang nda kun a talara wan thlǝngya Faar ndan na nda naarha a mbed Pǝpa na a talara. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Ƙǝsǝr Wan niifa ɓanǝnɓa ka a hǝrghanggǝn fingya sahadgha.<verse eid="MAT 18:11" /></para>
  <para style="s">Karapu aten chaurarha sahadgha</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luka15:3-7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />Ana niifa tǝ chauraya haru tal, tǝrgha tal sahadgha, ma nǝn ǝnaarha? Mbǝ mal kumnggit wutarihe kap wutarihe a mbǝd lafrha ɗǝgha ka kaɗa yanɗaɗǝ sahadgha wa? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />A walang ɗaɓa, niya pǝrang ƙǝkafek kun, nǝn tǝk mbǝnda fa kaan aten chauradɗi tal ma kumnggit wutarihe kap wutarihe ɗi sahadwa wa! <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Nǝghǝn kee ƙǝm, mbǝ nggǝmnda hur Pǝpa ni na a talara ko tal ahur wanggini na nggu-ngguchit ya sahadgha wa.<verse eid="MAT 18:14" /></para>
  <para style="s">A ǝno shadwa ɗimiyirha fa</para>
  <para style="r">(<ref loc="LUK 17:3">Luka17:3</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />A ǝno shadwa ɗimiyirha fa, ɗuwa thlǝmadghǝn ɗǝ kyaɗang ɗimiyidghǝn, a pathlang nun kun sǝri. A koɗǝ thlǝmaarha fa, wuɗang na ɓa. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Amma a kowa thlǝmaarha fa wa, turu niifa tal nduwa sǝri ɗun thlǝmadghǝn ɗǝ tǝna laɓaara kyarhaɓa a mii nafiya sǝri nduwa mahan tsauka shedawaya atenggǝn. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />A karɗǝ kang thlǝmaarha kanda fa, pǝranggǝn mamngya Ƙǝn Faara. A karɗǝ kang thlǝmaarha mamngya Ƙǝn Faara fa, tsawang niifɗiya tǝ takkwa ɗaharha ni nduwa tǝ thlǝ tsamnda.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />Niya pǝrang ƙǝkafek kun, kala ˈya ƙǝnang nun hai hu ƙǝshiirha nǝghǝn ƙǝƙǝna hai ƙǝm a talara. Kala ˈya kwasang nun hai hu ƙǝshiirha, nǝghǝn kukwasa hai kee a talara.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />“Niya nggǝr ndang nda kun, ana nafiya sǝ sǝri ahur nun hu ƙǝshiirha nggǝmngga fa aten ˈya nun a hwanda, Pǝpa na a talara a fǝranggǝn kun. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Ƙǝsǝr kala mbǝrha wumna fiya sa hai sǝri nduwa mahan ahu thlǝmna niyi a pathlang ndan.”<verse eid="MAT 18:20" /></para>
  <para style="s">Karapu aten mafarha kargha chakh ɗimiyirha fa</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Tǝrgha ɓagha Mbiturus thlǝmadghǝn ɓa tsahang mee nǝn, “Chinǝm, saara kurmi ni chahanggǝn shadna ɗǝ a ǝneeɗǝ ɗimiyirha fa? Saara mǝd wa?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Nggǝrangga Yeeso sǝ, “Awo, mbǝ katǝra mǝd kee wa, amma kumnggit mǝd katǝra mǝd! <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Tsaunǝn kee, Kutǝryid talara nǝghǝn ƙǝla kutǝra na midghǝn kirassa ƙǝnaghǝn na a har mafayighǝn nzǝmngga wuɗǝɓǝla a harghǝn. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Katǝrang nǝn hai kee, ɓang niifa nda ɓa nǝn a takkwarha wuɗǝɓǝl wurirha haru kumnggidghǝn tuf. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Nanǝn mbǝ mbang tiighǝn wa, tǝrgha kutǝrɗi ndǝghǝn a heng ngganda ɗǝ tǝ nukkun, tǝ wanggighǝn tǝ ǝngya nanǝn tǝghǝn ha heu a tii kumadɗa nǝn. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Ɓǝrgha mafadɗa hai a mbedghǝn hwanggǝnǝn, ‘Niya hwan sa, ƙǝrsu tǝ nggi, niya tiighǝn heu.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Tǝrgha kutǝrɗi haɗanggǝn fa, kalghǝnǝn hai chahang kumadɗa nǝn ɗǝ.”<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />“Amma kyana mafadɗi ƙǝshaaɗǝ, ɗǝgha wal shadghǝn mafarha nǝn a takkwarha wuɗǝɓǝl wurirha haru tal. Ƙǝsanggǝn, ˈyaɓanggǝn, ndanggǝn, ‘Tee kumad na.’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Ɓǝrgha shadɗa hai keeghǝn hwanggǝnǝn, ‘Ƙǝrsu tǝ nggi niya teuƙǝn.’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Amma kargha fa ƙǝsanggǝn muwanggǝn ahu porsǝna ɗǝ ƙǝl tii nǝn wuɗǝɓǝlɗi heu. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Nana fingya mafaya ǝnɗi katǝragha hai, sǝbgha hur ndan ɗǝ. Ɗǝnda thlǝmad kutǝrɗa ɗǝ pǝrang ǝnɗa nda katǝragha hai. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Tǝrgha kutǝrɗi aah mafadɗa nǝn ɓa chahang nǝn kumarha ɗǝ ndanggǝn, ‘Sa ka wuɗi mafarha! Chahoɗi kumarha ɗǝ na a tenwa ka hwanna nggi. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Mbǝ shadwa mafarha haɗo fa ƙǝla haɗoni fa wa?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Tǝrgha kutǝrɗi hu sǝbrha hura muwanggǝn hu porsǝna ɗǝ ƙǝl a tii ɗǝ kumadɗi heu. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />Na Pǝpa na a talara a ǝnang kun kee a kowunni kargha chahang ˈya shadghǝn ɗǝ tǝ hura tal.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Tsahad Yeeso ha aten ɓǝlla kakhrha</para>
  <para style="r">(<ref loc="MRK 10:1-12">Markus10:1-12</ref>; <ref loc="LUK 16:18">Luka16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Ngwalang na Yeeso thlǝk ǝnggini ya, mal Nggalili nǝn ɗǝgha hu chehweed Yahudiya ɗǝ na a pǝm kufad Urdun. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Fiya hangga takkwagha samadghǝn ƙǝnanggǝn kanda a mbǝɗi.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Ɓagha fingya Farisaya thlǝmadghǝn ɓa ka a ƙǝƙǝrang ngganda. Tsahang mee nda, “Nggǝm ngyahad nǝm fa a kalgha niifa nukkun hai aten kala ˈya ǝnanǝn wa?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Nggǝrangga Yeeso kanda sǝ “Karatang nggun ahu ɗeleewar Faara wa? A katǝra ǝna ƙǝshiirha ‘ǝna Faara nuneefa tǝ hǝshneefa.’ Nggǝrghǝn ndaarha,<note caller="+" style="f"><char style="fr" closed="false">19:4 </char><char style="ft" closed="false">Katǝrarha 1:27; 5:2</char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />‘Ndǝghǝn ni ǝnagha ndǝn na niifa malang nda man tǝ chin thlǝthlǝɓanggǝn nukkun fa, kanda kyab tsau nda tal.’<note caller="+" style="f"><char style="fr" closed="false">19:5 </char><char style="ft" closed="false">Katǝrarha 2:24</char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Nanǝn kee mba nda sǝri wa, amma tal ni. Tsaunǝn kee, ˈYa wumangna Faara, a ndǝghang niifa hai wa.”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Tsahang mee nda, “Kama nda ndaana Musa niifa mbuwana midghǝn nukkun a fǝrang ɗeleewar kaala nǝn hai, ndanggǝn wiu?”<note caller="+" style="f"><char style="fr" closed="false">19:7 </char><char style="ft" closed="false">Nggurub Ngwa Kumaarha24:1-4; Matta 5:31</char></note><verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Nggǝrangga Yeeso kanda sǝ, “Ndaana Musa kee ƙǝsǝr ka kakrakkid ten nun. Amma a katǝradghǝn mbǝ kee wa. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Niya ndang nda kun kala niifa kalgha nukkun hai, a mbǝ nana nuɗi a ǝna kulafayirha wa, nggǝrghǝn kakh nuneefa pak ǝnaɗǝ kulafayirha.”<note caller="+" style="f"><char style="fr" closed="false">19:9 </char><char style="ft" closed="false">Matta 5:32; 1 Korontiyaya 7:10-11</char></note><verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Ndangga fatsahayighǝn, “Ana ˈyasǝ kee a pathlang nda nuneefa tǝ chimadghǝn nggushi tsauna niifa kula kakhrha.”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Amma ndagha Yeeso, “Mbǝ fiya heu na nggǝm palthɗa fa ya wa, ƙǝl fingya nggǝmang na Faara kanda fa. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Na fingya sǝ nggǝt nanda kulabrha, fingya sǝ ƙǝm firang nanda kanda, fingya sǝ mbǝ mid ndan sǝ kakhrha wa ƙǝsǝr ka Kutǝryid talara. Yi na a mbang thlǝ laɓarɗi ya thlǝghǝnǝn.”<verse eid="MAT 19:12" /></para>
  <para style="s">Ɗǝfang Yeeso parka wundakhnaya teena</para>
  <para style="r">(<ref loc="MRK 10:13-16">Markus10:13-16</ref>; <ref loc="LUK 18:15-17">Luka18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Tǝrgha ɓang wundakhnaya nda Yeeso ɓa na nggu-ngguchit ka a ɗǝfang parka nǝn kanda teena tǝ ƙǝm hwangga aten ndan. Amma fatsahayighǝn na nda yanang nda nafini na a ɓaarha ɓa tǝ wanggini. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Amma ndangga Yeeso kanda, “Malaman wundakhnaya ɓa nda thlǝmad na ɓa. A karang ɗun kanda fa wa. Ƙǝsǝr Kutǝryid talara yi fingya ni na ƙǝla wanggini ya.”<verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />Ɗǝfang haara nǝn kanda teena fǝrang parka nǝn kanda a wiigha.<verse eid="MAT 19:15" /></para>
  <para style="s">Tǝ ƙǝna</para>
  <para style="r">(<ref loc="MRK 10:17-31">Markus10:17-31</ref>; <ref loc="LUK 18:18-30">Luka18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Ɓagha Niifa thlǝmad Yeeso ɓa tsahang mee nǝn, “Mala, mani ǝnaarha na ngga tǝni wal yibrha mbuwa ngwalarha?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Ndangga Yeeso, “Mani na tsahe mee aten ˈya na ngga? Niifa tǝtal ni kee na ngga. Ana mid wa yibrha mbuwa ngwalaarha, ǝno taara tǝ ngyakhkini.”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Ndangga niifɗi Yeeso, “Yanggi?” Nggǝrangga Yeeso sǝ, “A ɓǝlna farha wa. A ǝnanna kulafayirha wa. A ngaarna wa. A pǝrna nggaɓaarha aten niifa wa.<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">Kyarhaɓa 20:13-16; Nggurub Ngwa Kumaarha 5:17-20</char></note> <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />Fǝrang mamnggirha nda muwa tǝ tsu. Nggǝmu tuladwa ƙǝla alten wa.”<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="ft" closed="false">Kyarhaɓa 20:12; Nggurub Ngwa Kumaarha 5:16; Ɗeleewar Firistaya 19:18</char></note><verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Ndagha wundǝladɗi, “Lafɗi ngyakhkini ya heu. Ma takhka tsauka tǝta a ǝnee?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Ndangga Yeeso, “Ana mid wa sǝ tsawana lǝlǝgɗa, ɗuwa ɗǝ ɗa heng ǝnggiwa ɗǝ heu fǝrang wuɗǝɓǝlghǝna fa yamiiya, na wal mbǝd ɗǝfǝdghǝn a talara. Tǝrgha ɓa na ɓa mbu samadna na.”<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Amma hǝrǝmna wundǝladɗi sǝkrha kee, wii fayighǝn nǝn hurghǝn sǝsǝɓa ɗǝ, ƙǝsǝr tǝƙǝna ni kaan.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Tǝrgha ndangga Yeeso fatsahayighǝn, “Niya pǝrang ƙǝkafek kun, nǝghǝn pǝɗaghǝn kyagha tǝƙǝna hu Kutǝryid Talara ɗǝ. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Niya nggǝr ndang nda kun, nǝghǝn pǝpa kyagha thlǝkhmu ɗǝ tǝ kwat libra ma tǝƙǝna kyagha hu Kutǝryid Faara ɗǝ.”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Sǝkna fatsahayighǝn kee, wulangga teena kanda tsakh mee nda, “A tsauɗǝ kee wunni wal hǝrǝkrha?” <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Amma ƙǝlangga Yeeso kanda ɗǝ ndǝghǝn, “A fad niifa tǝ wasa in mbǝ ǝnaarha hai wa, amma a fad Faara nǝghǝn pǝpa.” <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Tǝrgha ndangga Mbiturus, “Malang ɗan ǝngya heu mbuɗan samadwa nan, ma nan waala?” <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Ndangga Yeeso kanda, “Niya pǝrang ƙǝkafek kun, ahu ƙǝshiirha na ɓayi, a sayidɗi na Wan Niifa a tsaurha hu mamnggit tsǝnggam Kutǝryidghǝn, kun mbuwa samadna nun a tsaurha hu tsǝnggamngya kumkap sǝri, non a ngwang kumarha turya kumkap sǝri yi Isǝreela.<note caller="+" style="f"><char style="fr" closed="false">19:28 </char><char style="ft" closed="false">Matta 25:31; Luka 22:33</char></note> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Kala niifa malgha wure nduwa wanmanggighǝn hǝshya nduwa wanmanggighǝn nishya nduwa chin nduwa man nduwa wanggighǝn nduwa ǝnggighǝn, ka nggi, nǝn a wal ƙǝnaghǝn katǝra haru kum tǝ ƙǝm nǝn a wal yibrha mbuwa ngwalaarha. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Amma fingya ˈwagha kanda ni a nggǝl mee, fingya nggǝlgha mee kanda ni a tsaurha a mbee.” <note caller="+" style="f"><char style="fr" closed="false">19:30 </char><char style="ft" closed="false">Matta 20:16; Luka 13:30</char></note><verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Karapu aten fatarya a hed inabi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“Ƙǝsǝr Kutǝryid talara nǝghǝn ƙǝla tǝheerha wargha ka kaɗa fatarya ɗǝ ka ɓa nda ǝnang taara ahu hed inabidghǝn. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Ƙǝnang nanda wuɗǝɓǝl paara hai puwanggǝn kanda ahu hedghǝn ɗǝ. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Tǝrna yanfaara sǝ, kyagha sǝ ɗǝgha wal fiya ahu kasu mbǝ ˈyasǝ na nanda a ǝnaarha wa. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Ndanggǝn kanda ɗaa nda huɗaarha ahu hedghǝn nǝn a teng kanda ˈya kamngga ahu paara. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Nanǝn kee ɗǝnda ɗǝ ɗaa nda huɗang sǝ. Yanfara a sǝrǝkrha tǝ ƙǝm yarna yanfaara hai ǝnagha kee. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />A figrha ɗǝgha wal fingya ƙǝƙǝt. Tsahang mee nǝn kanda, ‘Kama nanun ƙǝƙǝt a mbǝɗiya mbǝ ˈyasǝ nun a ǝnaarha wa?’” <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Nggǝrang ngganda sǝ, “Mbǝ niifa sǝ aagha kan wa.” Ndangga tǝhedɗi kanda, “Tsaunǝn kee ɗamaɗǝ ɗun wal fingya na a huɗaarha hu hed na.”<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Mukna yanfaara hai, ndangga tǝhedɗi niifɗi na aten hedghǝn, “Ooh fatar yina ɓa teng wuɗǝɓǝl paara na kanda, katǝrang hai tǝ fingya ɗǝgha ɗǝ a kwasamarha ta ten fingya ɗǝ ˈwagha ɗǝ.” <note caller="+" style="f"><char style="fr" closed="false">20:8 </char><char style="ft" closed="false">Ɗeleewar Firistaya 19:13; Nggurub Ngwa Kumaarha 24:15</char></note> <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Fingya ɗǝgha ɗǝ a figrha teng ngganda kanda, kowunni walɗǝ wuɗǝɓǝl paara. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Fingya ˈwagha ɗǝ ɓa nanda ka thlǝ yindan ɓa, tamngganda ndaarha na yindan a kal yi fingya. Amma teng wuɗǝɓǝl paara nda kanda ƙǝm. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Thlǝna ndan katǝrang ngganda huhurumnda hai aten tǝhedɗi. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />“‘Nafini ya ɓagha nda ɓa a samarha amma tengga kanda mǝmǝl tǝ kan ǝnagha taara ka a tsar ahu weng-weng nda yanfaara.’”<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />“Amma nggǝranggǝn tal sǝ ahur ndan, ‘Pashidna, hukki sa wa! Mbǝ ƙǝnanggǝm hai niya teurha wuɗǝɓǝl paara na nda tiirha wa? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Thlu wuɗǝɓǝl wa wiina. Hurna nggǝmngga niya teng nda nafini ɓagha ɓa a samarha mǝmǝl ƙǝla teu ni. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Kamngwa a ǝna ˈya ni tǝrna minna tǝ wuɗǝɓǝl na wa? Na sǝrǝkrha ka ɗang ni fingya sǝ wa?’”<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />“Nanǝn kee yi nggǝlgha mee ndǝna a ˈwaarha, yi ˈwaagha ndǝna a nggǝl mee.”<note caller="+" style="f"><char style="fr" closed="false">20:16 </char><char style="ft" closed="false">Matta 19:30; Markus 10:31; Luka 13:30</char></note><verse eid="MAT 20:16" /></para>
  <para style="s">Nggǝr Yeeso thlǝk kwaman mǝrrǝghǝn</para>
  <para style="r">(<ref loc="MRK 10:32-34">Markus10:32-34</ref>; <ref loc="LUK 18:31-34">Luka18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Na Yeeso a ɗǝrha Urshalima ɗǝ, kyalthgha Yeeso man patu ɗǝ tǝ fatsahayighǝn kumkap sǝri ndanggǝn kanda, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Nǝm a ɗǝrha ta Urshalima ɗǝ, Na nda a fǝr Wan Niifa a har mamngya firistaya hai tǝ famalǝmngya ngyakhrha. Na nda a ngwang kumad mǝrra sǝ. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Tǝrgha na nda fǝrghǝn a har Romaya hai, waghǝn nda, tsaɗaghǝn nda tǝ ƙǝm tawang ngganda ɗǝ. Amma a far paara yi mahan nǝn a thliirha sǝ ahu mǝra.”<verse eid="MAT 20:19" /></para>
  <para style="s">Hwanda man Yakubu tǝ Yahaya</para>
  <para style="r">(<ref loc="MRK 10:35-45">Markus10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Tǝrgha man wangya Dzabadi. Nda Yakubu tǝ Yahaya, ɓagha thlǝmad Yeeso ɓa tǝ wanggighǝn. Ɓǝrgha hai tǝ waɗedghǝn ka a hwanang ˈya nǝn na midghǝn.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Tsahangga Yeeso mee, “Mana midwa?” Nggǝranggǝn Yeeso sǝ, “Tsawang wanggini kyana na sǝri ya tal a yisǝmad wa, tal ƙǝm a yi kawad wa ahu Kutǝryid wa.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Amma nggǝrangga Yeeso kanda sǝ, “Sǝnggun ˈya nun a tsakhrha wa! Nun mbang saarha tǝ wuhuleuɗi ɗini saarha wa?” Nggǝrang ngganda sǝ, “Haˈi nan mbang nda.”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Ndangga Yeeso kanda, “Nun mbang saarha tǝ wuhuleuɗi, amma tsaurha a yisǝmanna nduwa yi kawad na mbǝ nggini fǝrghǝn wa. Taksaagha Pǝpa mbǝyini ya a nafini wurnǝn.”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Sǝkna fingya fatsahaya kum ǝnɗi hwanna nda Yakubu tǝ Yahaya sǝbgha hur ndan ɗǝ tǝ kanda. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Amma aagha Yeeso kanda thlǝmadghǝn ɓa ndanggǝn kanda, “Sǝnɗunsǝ kutǝrya na hu ƙǝshidɗiya mbuwa Yahudaya na nda kyad sǝsǝmnggit ndan aten nafi ndan, mamnggi ndan ƙǝm na nda kyad sǝsǝmnda aten nafiya na a kamu ndan. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Amma ahur nun nǝn a naarha pak. Kala niifa na midghǝn tsauka ndǝghǝnni mamnda tǝtani tsauka niifa ni na a ǝnang taara kun.<note caller="+" style="f"><char style="fr" closed="false">20:26 </char><char style="ft" closed="false">Luka 22:25-26</char></note> <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Kala niifa na midghǝn a nagha a mbee, tǝtani a tsauka mafad nun.<note caller="+" style="f"><char style="fr" closed="false">20:27 </char><char style="ft" closed="false">Matta 23:11; Markus 9:35; Luka 22:26</char></note> <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Ƙǝsǝr ɓad Wan Niifa ɓa mbǝ ka a ǝnang taara nda wa, amma a ǝnang taara nǝn fingya tǝ ƙǝm fǝr yiɓǝdghǝnǝn ka a hǝrghanggǝn fiya hangga.”<verse eid="MAT 20:28" /></para>
  <para style="s">Ƙǝnang Yeeso kwamaya sǝri</para>
  <para style="r">(<ref loc="MRK 10:46-52">Markus10:46-52</ref>; <ref loc="LUK 18:35-43">Luka18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Hǝrǝmna Yeeso tǝ fatsahayighǝn mal Djeriko, mbuwa fiya samadghǝn hangga. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Tǝrgha kwamaya sǝri tsau ami kwamana. Sǝnna nda sǝ na Yeeso a mbǝra ɗǝ tǝ kwamanɗi, katǝrang ngganda tǝrang urad ndan sǝ, “Chinǝm, Wan Ndauda, a haɗowan fa!”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Yanangga fiya kanda a nggasa nda hai, amma ɗǝnda mbeeɗǝ tǝ tǝrang urad ndan sǝ kaan, “Chinǝm, Wan Ndauda, a haɗowan fa!”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Sǝkna Yeeso kanda, ishgha hai aah kanda nǝn, “Mana minnun a ǝnanggi kun?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Nggǝrang ngganda sǝ, “Chinǝm, na minnan sǝ a na mana nan hai!”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Haɗangga nafini Yeeso fa tsuwar yindan nǝn fa, tsu a mbǝɗi kee na mana nda hai. Tǝrgha mbu samadghǝn nda.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Kyad Yeeso Urshalima hai ƙǝla kutǝra</para>
  <para style="r">(<ref loc="MRK 11:1-11">Markus11:1-11</ref>; <ref loc="LUK 19:28-40">Luka19:28-40</ref>; <ref loc="JHN 12:12-19">Yahaya12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Na Yeeso tǝ fatsahayighǝn a takh ndusang Urshalima fa, ɓa nda hu tala ɓa na nda aarha Mbetafaji ahu Wumngya ɗǝfya Dzaitun. Thlǝngga Yeeso fatsahayighǝn sǝri a ˈwa nda mbeeɗǝ. <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />Ndanggǝn kanda, “Ɗama hu talɗa ɗǝ na a mbǝɗi taarha, a kyaɗun sa hai, nun awal kwaara ƙǝƙǝna hai tǝ wanggǝn a thlǝmadghǝn. Kwasaman kanda hai mbee kanda nun ɓa. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />A tsahang niifa mee kun, ndaman kee, ‘Na mid Chinǝm sǝ kanda,’ tsu a mbǝɗi kee nǝn a malang kun ɗun ɗǝ tǝ kanda.”<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Katǝrana ǝnɗa haya ka lǝɗang ngganda ˈya ndaana annabi:<verse eid="MAT 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Ndang nafiya Urshalima,</para>
  <para style="q2" vid="MAT 21:5">‘Kulo, Kutǝr nun ɓayi thlǝmannun ɓa.</para>
  <para style="q1" vid="MAT 21:5">Niifa ni mbuwana tenggǝn kakrak</para>
  <para style="q2" vid="MAT 21:5">ɓayi a ƙǝsǝr kwaara,</para>
  <para style="q2" vid="MAT 21:5">Nǝghǝn ɓayi a ƙǝsǝr wan kwaara.’”<note caller="*" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">Dzakariya9:9</ref></char></note><verse eid="MAT 21:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Ɗǝgha fatsahayina ɗǝ ǝna nda kǝla ndangna Yeeso kanda. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Ɓang kwarɗa nda ɓa tǝ wan kwarɗi, lǝlǝɓang ngganda lukki ndan a ƙǝsǝr wan kwarɗa sǝ tsauka atenggǝn. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Lǝlǝɓangga fiya lukki ndan hai aten kwamana a mbedghǝn, fingya kǝm kyalth shiiya nda ɓa lǝlǝɓang ngganda a tǝn kwamana. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Nafiya ˈwagha mbeeɗǝ ma ndǝghǝn tǝ fingya na mbusamadghǝn tǝrang ngganda urayi ndan sǝ, kanda ndaarha:</para>
  <para style="b" vid="MAT 21:9" />
  <para style="q1" vid="MAT 21:9">“Faala a tsauka aten Wan Ndauda!</para>
  <para style="q2" vid="MAT 21:9">Parka tsauɗǝ aten,</para>
  <para style="q1" vid="MAT 21:9">niifɗi na ɓayi ahu thlǝm Chinǝm!</para>
  <para style="q2" vid="MAT 21:9">Falama Faara na manggǝn a talara!”<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">Dzabura 118:25-26</char></note><verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 21:10" />Kyana Yeeso a Urshalima hai, wupǝri ɗi kahad wulangga teena kanda, na nda tsakh miiya tǝ ndaarha “Wunni ya?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Nggǝmangga nafini, “Yeeso ni, annabi ɗi ɓagha ɓa a Nadzarat na a Nggalili.”<verse eid="MAT 21:11" /></para>
  <para style="s">Rǝghang Yeeso fa shafiliya ɗǝ a Wuri Faara</para>
  <para style="r">(<ref loc="MRK 11:15-19">Markus11:15-19</ref>; <ref loc="LUK 19:45-48">Luka19:45-48</ref>; <ref loc="JHN 2:13-22">Yahaya2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Kyagha Yeeso Kǝn Faara ɗǝ na Urshalima katǝranggǝn rǝghang nda nafiya ɗǝ na a hiirha tǝ hǝng nda maɓiya ɗǝ ka sataka. Changgǝlanggǝn tebǝrya fa mbeɗed wuɗǝɓǝlya ɗǝ tǝ kulohod fingya na a heng kataprakkya ɗǝ. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Ndanggǝn kanda, “Ndagha ɗeleewar Faara,</para>
  <para style="b" vid="MAT 21:13">‘Kǝnna nǝm aaghǝn Kǝn hwanda Faara,’<note caller="+" style="f"><char style="fr" closed="false">21:13 </char><char style="ft" closed="false">Ishaya 56:7</char></note></para>
  <para style="q2" vid="MAT 21:13">Amma tsawanggun mbǝd ɓǝɓed ngaarya!”<note caller="+" style="f"><char style="fr" closed="false">21:13 </char><char style="ft" closed="false">Irmiya 7:11</char></note><verse eid="MAT 21:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Ɓagha kwamaya ɓa tǝ sǝfǝngya a thlǝmadghǝn ɓa ahu Kǝn Faara, ƙǝnanggǝn kanda. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Amma nana mamngya firistaya tǝ famalǝmngya ngyakhrha Musa ǝnwultenggini ǝnanǝn, wundakhnaya ma kanda a huhwarha a pǝpal Ƙǝn Faara kanda ndaarha, “Faala tsauɗǝ aten Wan Ndauda.” Amma mamnggini sǝbgha hur ndan ɗǝ. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Tsahang mee nda Yeeso, “Sǝkna ǝnɗi na wanggini ndaarha ya wa?” Nggǝmangga Yeeso, “Hǝng, ˈWawa nun karatang nda ɗeleewar Faara wa? Ƙǝsǝr ndagha nda,</para>
  <para style="b" vid="MAT 21:16" />
  <para style="q1" vid="MAT 21:16">‘Tsahang ɗun wundakhnaya ha tǝ wufar waya,<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="ft" closed="false">Dzabura 8:2</char></note></para>
  <para style="q2" vid="MAT 21:16">ka a fal kun nda.’ ”<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="ft" closed="false">Dzabura 8:2</char></note><verse eid="MAT 21:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />A mbǝɗi kee mal kanda nǝn wudgha Mbetani ɗǝ mǝngga hai a mbǝɗi.<verse eid="MAT 21:17" /></para>
  <para style="s">Shiwang Yeeso Ɗǝf Shiɓaarha</para>
  <para style="r">(<ref loc="MRK 11:12-14">Markus11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Ɗalthna mbǝrha hai nanǝn a wutta Urshelima ɗǝ, ƙǝsgha miirha ndǝn. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Na shiɓarha nǝn a ƙǝlar kwamana, ɗǝgha thlǝmadghen ɗǝ kǝlagha hai ko wee a uradghǝn kǝl shiiya kee. Tǝrgha ndanggǝn shiɓadɗi, “Ma nggǝrna tam nggǝtta ɓalwa!” Tsu kee hwargha ɗǝfǝdɗa ɗǝ.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Nana fatsahayighǝn ǝnɗi katǝragha hai, ƙǝsgha ǝnwulteena kanda kaan, ndanda, “Ƙǝƙǝn hwarna shiɓadɗa ɗǝ ƙǝkar kee ya?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Tǝrgha ndangga Yeeso kanda, “Niya pǝrang kǝkafek kun, anaɗun tǝ fǝrƙǝkafek fa ngaalanggun alten nun wa, nun a ǝna ǝngya kǝla yanɗiya, nduwa kalgha yanɗamu ya. Nun mbang ndang nda wumndǝɗi ya, ‘Thliusǝ muwana hu wuri aamɗa ɗǝ ya,’ nǝn a katǝrarha hai kee.<note caller="+" style="f"><char style="fr" closed="false">21:21 </char><char style="ft" closed="false">Matta 17:20; 1 Korontiyaya 13:2</char></note> <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Nun hwanang Faara kala ˈya na minnun, a fǝrɗun kǝkafek, nun walghǝn.”<verse eid="MAT 21:22" /></para>
  <para style="s">Tsakhmee aten sǝsǝmnda Yeeso</para>
  <para style="r">(<ref loc="MRK 11:27-33">Markus11:27-33</ref>; <ref loc="LUK 20:1-8">Luka20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Wudna Yeeso ahu Ƙǝn Faara ɗǝ na a Urshelima katǝranggǝn tsaharhaha, Mamnda Firistayini tǝ shingya nafini ɓanda thlǝmadghǝn ɓa. Tsahang mee nda, “Tǝ sǝsǝmnda wun na ǝna ǝnggini hǝu ya? Wun fǝrowa sǝsǝmndǝɗi ya?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Nggǝmangga Yeeso kanda, “Niya tsahang mee kun ha tal. A nggǝreeɗun sǝ, niya pǝranggǝn kun tǝ wun fǝreegha Sǝsǝmnda niya ǝna ǝngginiya. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Wun fǝrangga kwamana Yahaya ǝna mbaptisǝma nǝn? Faara fǝrangga wa, nduwa fiya wa?” Tǝrgha thliigha ngaala sǝ a pathlang ndan, ndaa nda, “A ndaa ɗǝm, ‘Faara fǝrangga,’ nǝn a tsakh mee, ‘Kama fǝrwa nun ƙǝkafek tǝghǝn?’”<verse eid="MAT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 21:26" />“Amma a ndaɗǝm, ‘Fiya fǝrangga,’ nǝm a tǝrǝm fiya, ƙǝsǝr fǝr nda ƙǝkafek Yahaya annabi ni.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />A kwasamadghǝn nggǝrang ngganda sǝ, “Sǝngwan wa.” Tǝrgha ndanggǝn kanda, “Nggi ƙǝm mbi pǝranggǝn kun wun fǝreegha sǝsǝmnda niya ǝna ǝnggini ya wa.”<verse eid="MAT 21:27" /></para>
  <para style="s">Karapu aten wundǝlaya sǝri</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“Amma ma numa nun? Na niifa sǝ tǝ wundǝlayighǝn sǝri, ɗǝgha thlǝmad tǝ pamǝnda ɗǝ ndanggǝn, ‘Waana, a weeriya ɗǝwa ɗǝ ɗa ǝna taara ahu hed inabi.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Tǝrgha ndagha wundǝladɗi, ‘Mbi ɗǝrha ɗǝ wa,’ amma numagha ɗǝgha ɗǝ. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Tǝrgha chin ɗǝgha thlǝmad tahad wundǝlad ɗaɗǝ ndanggǝn, ‘sa ɗǝwa ɗǝ,’ ndagha wundǝladɗi, ‘hǝng pǝpa, niya ɗǝrha ɗǝ.’ Amma ɗǝwa ɗǝ wa.” <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />“A hur ndan na sǝri ya yanggi ǝnagha ˈya na mid chin?” Nggǝra nda sǝ, “Yanɗi ˈwanǝn thlǝnda.” Ndangga Yeeso kanda, “Niya pǝrang kǝkafek kun, fathlǝ tsamngya tǝ susuwaya nanda ˈwarha hu kutǝryid Faara ɗǝ ma kun.”<verse eid="MAT 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 21:32" />Ƙǝsǝr Yahaya tǝ Mbaptisǝma ɓaɗa ɓa kyaɗang ɗǝ kwamana kun na a tsawun ngga a mbed Faara, amma fǝr wun kǝkafek wa, amma fathlǝ tsamngya tǝ susuwaya fǝr nda kǝkafek tǝghǝn. Ko nanun ǝnggini a katǝrarha hai, karɗun fa fǝrƙǝkafek nun tǝghǝn. 21:32 Luka 3:12; 7:29-30.<verse eid="MAT 21:32" /></para>
  <para style="s">Karapu aten fahuɗaya nzǝmngga hed inabi</para>
  <para style="r">(<ref loc="MRK 12:1-12">Markus12:1-12</ref>; <ref loc="LUK 20:9-19">Luka20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Nanǝnya kaaman thlǝmaarha asǝɗarha fa pak. Na niifa sǝ pagha wan ɗǝfya inabi, kanggǝn tǝ kalthmaana, ra mbǝd ˈyaɗa wan inabi nǝn ahurghǝn, nggǝrghǝn ra sǝfa na nzang na tǝƙǝla hedɗa ha a tsaurha a tenggǝn. Tǝrgha nzǝmang hed inabi ɗa nǝn fahuɗaya ha wii tala nǝn.<verse eid="MAT 21:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="MAT 21:34" />Tsǝna shifirha hai, thlǝn mafayighǝn nǝn ɗa nda thlang yighǝn ǝnnarhami ɓa. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Amma fa nzǝm heeyini kǝsang ngganda mafayini; ɗǝk tal nda, ɓǝlang ngganda tal, muk tahadghǝn nda tǝ ferya. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Tǝrgha nggǝrghǝn thlǝn fingya mafaya thlǝmad ndan ɗǝ, kalgha yanggini ˈwa nǝn thlǝn nda ɗǝ. Fa nzǝm hedɗi nggǝrgha nda ǝnang kanda kǝla yi ƙǝtǝm. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Akwasamadghǝn tǝ hedɗi thlǝn wan hurghǝn nǝn a thlǝman ndan ɗǝ nǝghǝn a numad ndaarha, “‘Mbǝ ngaala sǝ wa na nda fǝrang mamnggirha waana.’” <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />“Amma nana fa nzǝm heeyini wanɗi keeghǝn ɓayi, ndang ngganda ndan, ‘Yo, kulo tǝ har langaad hedɗi ɓayi ya. Taama ɓǝlanggǝm tǝnǝm har langaad hedɗi.’” <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Tǝrgha ƙǝsang ngganda, kahang ngganda ƙǝsǝr kadɗa ɗǝ, ɓǝlang ngganda.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />“A ɓad tǝ hedɗa ɓa, ma nǝn ǝnang nda fa nzǝm hedɗi?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Mamngya fatakkwayini ndaa nda, “Nǝn a ɓǝlang fa mbǝlfeyini tǝ sǝsaarha na pǝɗaaghǝn, fǝrang hedɗa nǝn nafiya pak, na narha fǝrang yighǝn ǝnnarhami kala shifirha.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Tǝrgha tsahangga Yeeso mee kanda, “ˈWawanun karatang nda ahu ɗeleewar Faara wa? Ndanǝn:</para>
  <para style="b" vid="MAT 21:42" />
  <para style="q1" vid="MAT 21:42">‘Ferɗi karna fa tǝngya,</para>
  <para style="q2" vid="MAT 21:42">ndǝn tsaukwa ka feera.</para>
  <para style="q1" vid="MAT 21:42">Yanɗiya ˈya ni ǝnana Chinǝm,</para>
  <para style="q2" vid="MAT 21:42">ǝnwulteena ni a yid nǝm.’ ”<note caller="+" style="f"><char style="fr" closed="false">21:42 </char><char style="ft" closed="false">Dzabura 118:22-23</char></note><verse eid="MAT 21:42" /></para>
  <para style="b" />
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />“Tsaunǝn kee, niya ndang nda kun, na nda a thlang nda kutǝryid Faara a harnun, fǝrang nggǝnda chehweeya na fǝr wan ɗǝfya ngga.” <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Kala niifa mukka ten ferɗa hai, nǝn hwasarha fa ɓatal, ɓatal, amma yi mukna ferɗi tenggǝn hai nǝn a tsarang ɗǝ.<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Sǝkna mamngya firistayini tǝ Farisayini karapu ɗi, walang ngganda nǝn a thlǝk asǝɗadɗi aten ndan kanda ni fahuɗayini na tǝ mbǝlfedɗa fa. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Na mid ndan sǝ a kǝsang ngganda, amma kanda tǝrǝm fiya wumngga hai, ƙǝsǝr na fiya a ndaarha annabi ni.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Karapu aten wutsǝfayid kakhrha</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luka14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Nggǝrgha Yeeso pǝrang laɓara kanda tǝ karapu, ndǝghǝn, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />Kutǝryid talara nǝghǝn ƙǝla kutǝra ngwagha fa ka ǝna wutsǝfayid kakhrha nǝn a wanggǝn. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Thlǝnanggǝn mafayighǝn ɗǝ ɗa nda aah nafina ɓa mbu nanda kanda ɓa, amma kar nafini ɓarha fa ɓa. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Tǝrgha nggǝrghǝn thlǝn fingya mafaya ɗǝ tǝ ndaarha, “Ndaaman nafini mbu ni, ngwaɗi wutsǝfayidɗa fa, thleeɗi urad thlaaya na ndǝndaura tǝ kwelya, ngwaɗi fa, ɓamaɓa ƙǝkar.” <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Amma nafini mbu nǝn ɗǝf wanda teena sǝ wa, tal ɗǝgha heeɗǝ, tahadghǝn ƙǝm ɗǝgha ka ǝna shafilidghǝn ɗǝ. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Fingya ƙǝsang ngganda mafayighǝn hai, ɗǝk kanda nda tǝ kǝm ɓǝllang ngganda kanda. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Hufgha kutǝrɗi hur kaan. Thlǝnanggǝn sodjayighǝn ɗǝ ɓǝllang ngganda fa ɓǝl fayina ɗǝ, tǝ kǝm njang ngganda wupǝri ndan ɗǝ. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Tǝrgha ndanggǝn mafayighǝn, ʻNgwala ngwa wutsǝfayid kahadɗa fa, amma nafini mbu nǝm ɓa mbǝ kanda ni kamngga a ɓa nda ɓa wa. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />“Nanǝnya, ɗaama hu kwaman hu wuraya ɗǝ mbu fiya nun ɓa kala niifa nanun ɓa nda hu wutsǝfayidɗa ɓa.” <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Nanǝn kee, ɗǝgha mafayini ahu kwaman hu wuraya ɗǝ mbu ka nafiya nda ɓa na nanda tǝ ndǝrwaya, lǝghǝdgha ƙǝn wutsǝfayid kahadɗi tǝ rongya.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Amma kyana kutǝr ɗa ɓa ka ɓagha na ronggi ni mbunǝn ɓa, na niifa nǝn kalwawa kari yi wutsǝfayid kahadɗi. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Tsahang mee nǝn, “Pashinna, ƙǝƙǝn kyana mbǝɗa ɓa ya kula sa kal karid wutsǝfayid kahadɗa fa?” Amma mbangwa kamshiɗi nggǝrang sǝ wa. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Tǝrgha kutǝrɗi ndanggǝn nafiya na ǝnang taara, “Ƙǝnaman haarghǝn tǝ sarghǝn muwanggun ƙǝshaaɗǝ ahu wula ɗǝ mbǝɗi nanda a tǝrha tǝ ƙǝt mee.”<note caller="+" style="f"><char style="fr" closed="false">22:13 </char><char style="ft" closed="false">Matta 8:12; 25:30; Luka 13:28</char></note><verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />“Ƙǝsǝr nafiya hangga aah nanda, amma ngguchit wurna nda hasǝ.”<verse eid="MAT 22:14" /></para>
  <para style="s">Tsakhmee aten tii tsamnda a Kaisar</para>
  <para style="r">(<ref loc="MRK 12:13-17">Markus12:13-17</ref>; <ref loc="LUK 20:20-26">Luka20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Tǝrgha Farisayini wuma nda hai kaɗa kwamana nda a ɗǝfang takthleera nda Yeeso ka a thlǝk ˈya nǝn tǝna nda ƙǝsang nda. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Thlǝn fatsaha yindan nda ɗǝ tǝ nafiya Hirdus ka a tsahang mee nda, ndaa nda, “Mala sǝnɗansǝ ka niifa ni sa, na tsahang kwaman Faara fiya ha tǝ ƙǝkafekkirha. Sa kǝm mba wurahasǝ wa. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Nanǝnya pǝranggǝn kan, mani numad wa aten ǝnɗiya, nǝghǝn mǝmǝl a teng tsamnda nan kaisar wa nduwa awo?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Amma Yeeso sǝnɗǝ numad mɓǝlfedɗi na ahur ndan, ndagha, “Kun fathlǝrɓuya, kama na mid nun a ɗǝfee takthleera? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Keɗeema pene tii tsamndǝɗi. Fǝrang pene ɗa nda.”<verse eid="MAT 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 22:20" />Tsahang mee nǝn kanda, “Shishingnda wunni tǝ thlǝm wun a tenggǝn?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Ndang ngganda, “Yi Kaisar.” Ndanggǝn kanda, “Fǝraman Kaisar ˈya tsauka yi Kaisar, tǝ kǝm fǝraman Faara ˈya tsauka yi Faara.”<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Sǝk nanda kee, ǝna ǝnwulteena nda pa wii fayindan nda.<verse eid="MAT 22:22" /></para>
  <para style="s">Tsakhmee aten thliirha sǝ ahu mǝrra tǝ kakhrha</para>
  <para style="r">(<ref loc="MRK 12:18-27">Markus12:18-27</ref>; <ref loc="LUK 20:27-40">Luka20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Tsu a farɗi fingya Sadukiyaya ndagha mbǝ thliirha sǝ hu mǝra wa ɓa nda thlǝmad Yeeso ɓa tǝ tsakhmee.<note caller="+" style="f"><char style="fr" closed="false">22:23 </char><char style="ft" closed="false">Tar Fathlǝngya 23:8</char></note> <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Ndang ngganda, “Mala, ndangga Musa kan, ‘A mǝr wan man niifa malɗǝ nukkun hai kula nggǝtta, na wan man tǝrangsǝ hu langaarha ka a nggǝɗanggǝn sǝ.’<note caller="+" style="f"><char style="fr" closed="false">22:24 </char><char style="ft" closed="false">Nggurub Ngwa Kumaarha 25:5</char></note> <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Nanǝnya, na nafiya sǝ mǝd a wanmanggi. Tǝ pamǝnda kakhka mǝrgha kula wal wee, tǝrgha yi sǝri tǝranggǝn nuɗasǝ. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Amma wan man yi sǝri mǝrgha ƙǝm, yi mahan wai kee har ta ten yi mǝd ɗǝ. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Akwasamadghǝn, nuɗi ƙǝm mǝrgha. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Nanǝnya, ahu thliirha sǝ hu mǝrra na nuɗi tsaurha yi wun tsaunǝn kanda heu mǝd, tǝrang nda nuɗasǝ?”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Nggǝrangga Yeeso kanda sǝ, “Numad nun mbǝ mǝmǝl wa ƙǝsǝr sǝnggun Laɓar Faara na chichireethlee hai tǝ sǝsǝmndǝghǝn wa. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Thliirha sǝ hu mǝra mbǝ nishya tǝ hǝshya kakhrha wa. Nanda tsaurha kǝla fathlǝngya Faara a talara. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Amma aten thliirha sǝ hu mǝra, karantanggun ˈya ndang na laɓar Faara kun wa? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Nggini Faara yi Ibrahim, Faara yi Ishaku, tǝ ƙǝm Faara yi Yakubu’. Mbǝ Faara ni yi mǝrya wa, amma yi fingya natǝ yibrha fa.”<note caller="+" style="f"><char style="fr" closed="false">22:32 </char><char style="ft" closed="false">Kyarhaɓa 3:6</char></note><verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Sǝkna fiya ndǝn wumngga hai, ǝna ǝnwulteena nda tǝ tsahayighǝn ha.<verse eid="MAT 22:33" /></para>
  <para style="s">Ngyakhrha na manggǝn</para>
  <para style="r">(<ref loc="MRK 12:28-34">Markus12:28-34</ref>; <ref loc="LUK 10:25-28">Luka10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Amma sǝkna Farisayini tǝ ndaarha nggǝlangga Yeeso mii Sadukiyayini tǝ laɓaara nggǝrang nǝn kanda sǝ, wuma nda hai ka a nggǝra nda tsahang mee. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Tal ahur famalǝmngya ɗeleewar Musa, na midghǝn sǝ a ɗǝfang takthleera nǝn tsahang mee nǝn Yeeso, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Mala yanggini manggǝn ahur ngyakhkya heu?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Nggǝmangga Yeeso, “Nggǝmu Chinǝm Faarwa tǝ hurwa heu, tǝ shingnduwa heu tǝ huten wa heu.<note caller="+" style="f"><char style="fr" closed="false">22:37 </char><char style="ft" closed="false">Nggurub Ngwa Kumaarha 6:5</char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Yanɗiya ndǝna katǝra ngyakhrha na mam. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Yi sǝri ƙǝm nǝghǝn manggǝn: ʻNggǝmu tuladwa ƙǝla altenwa. <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Ngyakhrha heu tǝ tsahad annabiya ha na nda aten ngyakhkini sǝri ya.”<verse eid="MAT 22:40" /></para>
  <para style="s">Tsakh mee aten Ƙǝrǝsti</para>
  <para style="r">(<ref loc="MRK 12:35-37">Markus12:35-37</ref>; <ref loc="LUK 20:41-44">Luka20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Wumna Farisaya hai tsahangga Yeeso mee kanda, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“Mani numad nun aten Ƙǝrǝsti? Wan wunni?”</para>
  <para style="p" vid="MAT 22:42">Ndang ngganda, “Wan Ndauda ni.”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Nggǝrangga Yeeso kanda sǝ, “Ƙǝƙǝn na Ndauda tǝ sǝsǝmnda Sǝsǝna aaghǝn ‘Chinǝm’? Ƙǝsǝr ndagha Ndauda,<verse eid="MAT 22:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />Ndangga Chinǝm yina China:</para>
  <para style="q2" vid="MAT 22:44">‘Tsawu a yisǝmanna,</para>
  <para style="q1" vid="MAT 22:44">ƙǝl a tsawangɗi fatsanggiwa</para>
  <para style="q2" vid="MAT 22:44">a kamu saryiwa.’<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="ft" closed="false">Dzabura 110:1</char></note> <verse eid="MAT 22:44" /><verse number="45" style="v" sid="MAT 22:45" />Ana Ndauda a aah Ƙǝrǝsti ‘Chinǝm,’ ƙǝƙǝn nǝn tsaurha wanggǝn?”<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Mbǝ niifa sǝ mbangga nggǝrang sǝ wa, ka farɗi mbǝ niifa sǝ ndengga yidghǝn nggǝrghǝn tsahang mee wa.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Yanang Yeeso Famalǝngya ngyakhrha</para>
  <para style="r">(<ref loc="MRK 12:38-39">Markus12:38-39</ref>; <ref loc="LUK 11:43">Luka11:43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45-47">20:45-47</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Tǝrgha Yeeso ndanggǝn fiya wumngga hai tǝ fatsahayighǝn, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“Famalǝmgya ngyakhrha tǝ Farisaya kanda ni nggǝmang na nda kanda fa a pǝr ngyakhrha Musa nda. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Nanǝn kee tsahama tǝ ƙǝm ǝna taara nun tǝ ˈya ndang nanda kun, amma a ǝnaɗun kǝla nanda ǝnaarha wa, ƙǝsǝr mba nda ǝna ˈya na nanda a tsaharhaha wa. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Nanda ɗǝfang rǝfrha fiya in na haghǝn, amma kanda tǝ alten ndan mba nda thlar kanda ko tǝ wan haara wa.” <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Na nda ǝna tar ndan ka a nagha fiya kanda, nanda ƙǝn masparma natǝ chireethla laɓar Faara a pǝmnggindan, na nda ndǝn pǝratsan nzǝnzang a mii karindan.<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="ft" closed="false">Matta 6:1; Ɗeleewar Kirassa 15:38; Nggurub Ngwa Kumaarha 6:8</char></note><verse eid="MAT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 23:6" />Yakh mid ndan tsaurha a mbǝd tsaukya na nggǝngga hu teera, tǝ kǝm mbǝd tsaukya natǝ thlǝma a ƙǝn tsahad Yahudaya. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Na mid ndan a ndangˈya nda kanda yi mamnggirha a nan nda a wiirha hai ahu kasu, tǝ ƙǝm nagha fiya a aah kanda, Mala. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />“A nggǝmna fa a aah sa nda ‘Mala,’ wa ƙǝsǝr tǝmalǝmnda tǝtal ni, kun heu nuwun tal a wanmanggi. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />A aah ɗun kowunni ahu ƙǝshidɗi ya ‘Pǝpa’ wa, ƙǝsǝr Faara na talara ndǝna Pǝpa hu Sǝsǝna. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />A nggǝmna fa aagha kowunni sa ‘Mala’ wa, ƙǝsǝr tǝmalǝmnda tǝtali ni, ndǝna, Ƙǝrǝsti. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Yi na manggǝn ahur nun tǝta ni a tsauka mafad nun.<note caller="+" style="f"><char style="fr" closed="false">23:11 </char><char style="ft" closed="false">Matta 20:26-27; Markus 9:35; 10:43-44; Luka 22:26 </char></note> <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Amma kala nafiya manangga altenggindan nanda tsaurha ngguchit, tǝ kǝm nafiya tsawangga altenggindan ngguchit nanda manang kanda.<note caller="+" style="f"><char style="fr" closed="false">23:12 </char><char style="ft" closed="false">Luka 14:11; 18:14</char></note><verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“Amma kawama, kun famalǝmngya ngyakhrha Musa tǝ Farisaya, fathlǝrɓuya! Nggǝlanggun kwatminda kyarha hu kutǝryid talara ɗǝ ma fiya. Kun tafad nun kyawun sa ɗǝ wa, ˈyaɗang kwamana nun fiya na mindan kyarha sa ɗǝ.” <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Kawama famalǝmngya Ngyakhrha tǝ Farisaya, ndirwiya, nun hǝb karid nishya mǝrna chimayi ndan, non naarha hwan Faara kaan ka a na kun nda. Tsaunǝn kee na nda a ngwang kumarha kun sǝ na pǝɗaghǝn.<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />Kawama, famalǝmgya ngyakhrha tǝ Farisaya, fathlǝrɓuya! Nun wii tala aten chehweerha tǝ wuri aama ka wal niifa nun malangga ɗimiyidghǝn, a malang ɗǝ ɗimiyidghǝn, nun sǝɓang nda ɗǝ kaan kal kun nǝn ɗimiyirha.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Kawama, kwamaya na kyad kwamana! Nun ndaarha, “Kala niifa aagha thlǝm Faara tǝ Ƙǝn Faara, mbǝ ɓillarha sǝ wa, amma kaala niifa aagha thlǝm Faara tǝ tǝfasa yi Ƙǝn Faara, tsau ɗǝ tǝta a ǝna ǝnɗa nǝn aah nǝn Faara a tenggǝn.” <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Kun nur kwamaya! Yanggi ni manggǝn, tǝfasa wa nduwa Ƙǝn Faara na a Urshalima tsaɓangga tǝfasa ɗǝ wa? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Nun ndaarha, “Kaala niifa aagha Faara tǝ ‘mbǝd fǝr Sataka,’ mbǝ ɓillarha sǝ wa, amma niifa aagha thlǝm Faara tǝ ǝnfǝra na a mbǝd ǝna Sataka, tǝtani ǝna ǝnɗa nǝn ndanǝn nǝn a ǝnaarha.” <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Kun kwamaya! Yanggini manggǝn, ǝnfǝrɗi wa nduwa mbǝd nji sataka tsaɓangga ǝnfǝr ɗaɗǝ wa? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Tsaunǝn kee, kala niifa aagha thlǝm Faara tǝ mbǝd nji ǝnfǝra, aah nǝn Faara tǝ ˈya na tenggǝn heu. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />A anna thlǝm Faara tǝ Ƙǝn Faara na a Urshalima, aah na thlǝm Faara na tǝ tsaurha a mbǝɗi. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />A anna thlǝm Faara tǝ Talara, na aah tsǝnggam Faara, tǝ ndǝghǝn na tǝ tsaurha ahu tsǝnggamɗi.<note caller="+" style="f"><char style="fr" closed="false">23:22 </char><char style="ft" closed="false">Ishaya 66:1; Matta 5:34</char></note><verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Kawama famalǝmngya ngyakhrha Musa tǝ farisaya, fathlǝrɓuya! Nun fǝr ǝn fǝrrǝ nun tal ahu kum yi shi chimbee amma malanggun ǝngya na nggǝngga ahu ngyakhrha, ndǝna, ƙǝkafek, haɗang ndan fa, tǝ nggayirha. Ənggina ni kamngga na nggǝngga a ǝnon ya, a malang ɗun fingya wa.<note caller="+" style="f"><char style="fr" closed="false">23:23 </char><char style="ft" closed="false">Ɗeleewar Firistaya 27:30</char></note> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Kun kwamaya fa kyad kwamana, nun kang aama hai amawa nun muɗang kukwakhtaara amma nun muɗang thlǝkhmu.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Kawama, famalǝmgya ngyakhrha Musa tǝ Farisaya, fathlǝrɓuya! Nun tsaɓang ƙǝsǝr wuhuleurha ɗǝ tǝ tasau, amma ahurghǝn nǝghǝn lǝlǝgɗa tǝ nggǝm alteena tǝ hukrha! <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Sa kwamad tǝfarisarha! Tsaɓang hur wuhuleurha ɗǝ tǝ tasau ˈwan, tǝna ƙǝsǝrghǝn narha tsǝtsaɓaɗǝ ƙǝm.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />“Kawama, famalǝmgya ngyakhrha Musa tǝ Farisaya, fathlǝrɓuya! Nuwun kǝla ten kwaya ƙǝmang nanda tǝ penti na pǝpet, nagha ngga hu yirha, amma hurghǝn lǝlǝgɗa tǝ aal nafiya mǝrgha tǝ paarha ɗǝɗamǝn-ɗǝɗamǝn.<note caller="+" style="f"><char style="fr" closed="false">23:27 </char><char style="ft" closed="false">Tar Fathlǝngya 23:3</char></note> <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Tǝ ƙǝm ahu yirha naa fiya a na kun ka nafiya, amma ahur nun sǝ nuwun lǝlǝgɗa tǝ thlǝrɓuyirha tǝ mbǝlfeerha.”<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“Kawama, famalǝmgya ngyakhrha Musa tǝ Farisaya, fathlǝrɓuya! Nun tǝn ten kwaya a annabiya, tǝ kǝm nun sakhɗang nda ten kwaya yi ka fiya fǝrgha ƙǝkafek a Faara. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Tǝrgha nun ndaarha, ‘Andam nǝghǝm sǝ a sayid chichiyinǝm, kam ɗangwan kanda sǝ ɓǝlang nda annabiya wa.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Amma a naɗun a ndaarha kee, nun a thlǝghanggǝn altennun tǝ ndaarha kunni chichiya nafini ɓǝlangga annabi yini. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Ɗama mbeeɗǝ ngwalanggǝn ˈya katǝrangna chichiyi nun hai.” <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" /><note caller="+" style="f"><char style="fr" closed="false">23:33 </char><char style="ft" closed="false">Matta 3:7; 12:34; Luka 3:7</char></note>Kun huthlingya, wangya huthlingya na tǝ mbǝlfeerha yid! Ƙǝƙǝn nun hǝrǝkrha ma ngwa kumad hwanga? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Tsaunǝn kee niya thlǝnang annabiya kun ɗǝ tǝ fasǝngya, tǝ famalǝmngya ngyakhrha Musa. Amma nun a ɓǝlang fingya tǝ taurha ɗǝ, nun a tsaɗa fingya ahu ƙǝn tsahad Yahudaya, nun takkwa kanda tala-tala, kun a sǝsang kanda. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Tsaunǝn kee, niya thlǝnang nafina ɗǝ ya ƙǝsǝr na hakked ka nafini ɓǝlang nun a tsaurha a ten nun heu ka a sayi far Habila kaniifa ɗǝgha ten Dzakariya wan Mberikiya, ɓǝlang nun a pathlang Ƙǝn Faara na a Urshalima tǝ mbǝd ǝna sataka.<note caller="+" style="f"><char style="fr" closed="false">23:35 </char><char style="ft" closed="false">Kyarhaɓa 4:8; 2 Laɓarya 24:20-21</char></note> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Niya pǝrang kǝkafek kun, na ǝnggini a katǝrarha hai hu ƙǝshiid weeriya.<verse eid="MAT 23:36" /></para>
  <para style="s">Sǝb hur Yeeso ɗǝ aten Urshalima</para>
  <para style="r">(<ref loc="LUK 13:34">Luka13:34</ref>,<ref loc="LUK 13:35">35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Aiya Urshalima, Urshalima! Fa ɓǝl annabiya tǝ muk fathlǝngya Faara tǝ feera thlǝnna nda thlǝmadwa ɗǝ! Saara kurmi tǝrna minna a wumanggi kun kamuna ɓa kǝla na ɗiyarha ngwang wanggighǝn kamughǝn ɗǝ, amma karɗun fa. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Kǝlama hai nanǝnya, malang nda wuri nun kun fa tsauɗǝ kwad wure.<note caller="+" style="f"><char style="fr" closed="false">23:38 </char><char style="ft" closed="false">1 Kutǝrya 9:7,8; Irmiya 22:5</char></note> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Ƙǝsǝr niya pǝranggǝn kun, mbun a nggǝr na nggi ɓal wa ƙǝl fara ndanun, “Tǝ parkani niifɗi na a ɓarha ɓa hu thlǝm Chinǝm.”<note caller="+" style="f"><char style="fr" closed="false">23:39 </char><char style="ft" closed="false">Dzabura 118:26; Matta 21:9</char></note><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Əngya na a katǝrarha hai a mii ngwala ƙǝshiirha</para>
  <para style="r">(<ref loc="MRK 13:1-2">Markus13:1-2</ref>; <ref loc="LUK 21:5-6">Luka21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Na Yeeso a mal Ƙǝn Faara na a Urshalima, kyaɗangga fatsahayighǝn tur tǝngya Ƙǝn Faara. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Amma nggǝranggǝn kanda sǝ, “Naɗun tur tǝnggini na heu ya? Niya pǝrang kǝkafek kun, mbǝ feera sǝ ko tǝtal na nda a mala aten shadghǝn wa, kahad nanda chang nda kanda hai!”<verse eid="MAT 24:2" /></para>
  <para style="s">Katǝra sǝsaarha</para>
  <para style="r">(<ref loc="MRK 13:3-13">Markus13:3-13</ref>; <ref loc="LUK 21:7-19">Luka21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Tsǝɓaku na Yeeso tsau a ten ɗǝfya wumnda Dzaitun, ɓagha fatsahayighǝn thlǝmadghǝn ɓa ɓǝɓee ndang ngganda, “Pǝranggǝn kan a kwan na ǝnggini katǝrarha hai ya? Mani a tsaurha ǝnsakhrha wuttuwa ɓa tǝ ngwala mii ƙǝshiirha?”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Ndangga Yeeso kanda, “Kwarama, a nggǝmɗun fa nggaɓagha niifa kun wa, <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />ƙǝsǝr nafiya hangga na a ɓarha ɓa hu thlǝmna, na nda a ndaarha, ‘Nggini Ƙǝrǝsti,’ har na nda nggaɓa fiya hangga. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Nun a sǝk laɓar yangya, tǝ mii ndaama aten yangya, amma a tǝrǝmɗun wa, tsauɗǝ tǝtani a katǝragha ǝnggini hai, amma ɓawa mii ngwaladghǝn ɓa ˈwan wa. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Na tur a thleng tur fa tǝ yanda, na kutǝryirha a thleng kutǝryirha fa. Na miirha a narha sǝ tǝ rǝprha ƙǝshiirha fa a mbǝya ɗǝɗamǝn-ɗǝɗamǝn. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Amma heu ǝngginiya katǝra mii sǝsarha ni kee.”<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />“Na nda a ƙǝsang nda kun, sǝsang ngganda kun tǝ kǝm ɓǝlang ngganda kun. Ƙǝshiirha heu na nda kar kun ƙǝsǝr ka thlǝmna.<note caller="+" style="f"><char style="fr" closed="false">24:9 </char><char style="ft" closed="false">Matta 10:22</char></note> <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Fiya hangga na a mal fǝrƙǝkafekkid ndan, na nda a fǝr ndan tǝ kar ndan. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Na annabiya fa nggaɓaya a kyarhaɓa hangga, nggaɓa fiya nda hangga. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Na mbǝlfeerha a mulgha hai, nggǝm ndan nǝn a tsaurha shishiu. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Amma kala niifa ƙǝrǝsgha ta mii ngwaladghǝn ɗǝ nǝn a hǝrǝkrha.<note caller="+" style="f"><char style="fr" closed="false">24:13 </char><char style="ft" closed="false">Matta 10:22</char></note> <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Laɓarɗi na Mbǝnggǝn yi kutǝryid Faara na nda a pǝrghǝn kahad hu ƙǝshiirha ɗǝ, ƙǝsǝr ka sǝkka talya ndǝn; a mbǝra ɓagha mii ngwaladghǝn ɓa.”<verse eid="MAT 24:14" /></para>
  <para style="s">Sǝsaarha na ɓayi</para>
  <para style="r">(<ref loc="MRK 13:14-23">Markus13:14-23</ref>; <ref loc="LUK 21:20-24">Luka21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“Nun a naa ǝn tsanda na rǝk fiya, ƙǝt hu Ƙǝnna na Chahal ƙǝla ndaana annabi Ndaniyel. (Ngwa walangga tǝ karatarha),<note caller="+" style="f"><char style="fr" closed="false">24:15 </char><char style="ft" closed="false">Tar fathlǝngya 16:13; Ndaniyel 9:27; 11:31; 12:11</char></note> <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Tǝrgha nafiya na ahur Yahudiya tǝtani ɗanda wumngya sǝ. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Niifa na aten ƙǝnna a ndaa ɗǝ nǝn a tǝra hai ɗǝgha tǝr ˈya ɓa a wuri wa. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Niifa na hee a ndaa ɗǝ nǝn wutta wure ɗǝ ɗǝgha tǝrang kootodghǝn ɓa wa. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Nǝn a tsaurha ǝn kawa a nishya na a hur tǝ nishya na tǝ waya ƙǝsǝr ahu sayidɗi! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Hwanama Faara amana ɗadɗi naarha a sayid mbiirha nduwa afar yibrha Yahudaya wa. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Ƙǝsǝr a farɗi na sǝsarha a naarha sǝ kaan ˈwawa tam naarha sǝ kee ka a far katǝra ƙǝshiirha ta weeri ɗaɓa ya, mbǝ turghǝn a nggǝr naarha sǝ ɓalwa.<note caller="+" style="f"><char style="fr" closed="false">24:21 </char><char style="ft" closed="false">Ndaniyel 12:1; Sǝsǝnid Yahaya 7:14</char></note> <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />A mbǝ thlaghang nanda ɓenggina haaɗǝ ya wa, mbǝ niifa sǝ na a naarha tǝ yibrha wa. Amma ƙǝsǝr ka nafiya wurna Faara ndǝn nanda thlahang ɓenggina haaɗǝ.”<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />“Ahu sayidɗi a ndang niifa kun, ‘Kuloɗǝ, kulo Ƙǝrǝsti ɗiya!’ Nduwa ‘Kulo ndǝghǝn taarha!’ A fǝrna ƙǝkafek sǝ wa. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Ƙǝsǝr na fa nggaɓaya Ƙǝrǝsti sǝ tǝ fa nggaɓaya annabiya a kyarhaɓa, na nda a ǝna ǝnsakhkya mǝmanggǝn tǝ ǝnwuteengya ka a nggaɓa fiya nda har tǝ fingya wurna nda anaɗǝ a ǝnaarha hai.”<verse eid="MAT 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 24:25" />“Ƙǝlama hai, ˈWaɗi teena yanangɗi kun ƙǝtǝm.”<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />“Nanǝn kee a ndang niifa kun, ‘Kulo ndǝghǝn taarha a kaheerha,’ a kyaɗun ƙǝsha ɗǝ wa; nduwa, ‘Kulo ndǝghǝn ahur ƙǝnna ya,’ a fǝrɗun ƙǝkafek sǝ wa. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Ƙǝsǝr ƙǝla na ˈyaara kyatta a man kyat faara nǝn djaara hai ta man hǝmndǝghǝn ɗǝ, nanǝn kee na wutta Wan niifa ɓa a narha kee.”<note caller="+" style="f"><char style="fr" closed="false">24:27 </char><char style="ft" closed="false">Luka 17:24; Matta 8:20</char></note><verse eid="MAT 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28" />“Mbǝrha nana mǝrra sǝ, a mbǝɗani na sǝkhɗiya wumnda sa hai.”<note caller="+" style="f"><char style="fr" closed="false">24:28 </char><char style="ft" closed="false">Luka 17:37 </char></note><verse eid="MAT 24:28" /></para>
  <para style="s">Wutta Wan niifa ɓa</para>
  <para style="r">(<ref loc="MRK 13:24-27">Markus13:24-27</ref>; <ref loc="LUK 21:25-28">Luka21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Akwasamad sǝsadɗi ya,</para>
  <para style="b" vid="MAT 24:29" />
  <para style="q1" vid="MAT 24:29">“ ‘Na yanfaara a tsaurha wula,</para>
  <para style="q2" vid="MAT 24:29">ndǝree ƙǝm mbǝ a kyat kukwaryirha wa.</para>
  <para style="q1" vid="MAT 24:29">Na wufǝlngarya mukrha hai a fǝrakh-amshi,</para>
  <para style="q2" vid="MAT 24:29">ǝngya na mǝmanggǝn na talara nanda tsǝˈyafa.’”<note caller="+" style="f"><char style="fr" closed="false">24:29 </char><char style="ft" closed="false">Ishaya 13:10; 34:4; Ezikiyel 32:7; Djoyel 2:10,31; Dzafaniya 1:15; Sǝsǝnid Yahaya 6:12, 13; 8:12</char></note><verse eid="MAT 24:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />“Ahu sayidɗi na nda a naa ǝnsakhrha a fǝrakh-amshi yi Wan niifa. Nafiya ƙǝshiirha heu nanda tǝrha ka hǝreenga. Nanda a na Wan niifa ɓayi ahu hashmbe a fǝrakh-amshi hai, tǝ sǝsǝmnda tǝ mamnggirha kaan.<note caller="+" style="f"><char style="fr" closed="false">24:30 </char><char style="ft" closed="false">Ndaniyel 7:13; Dzakariya 12:10-14; Sǝsǝnid Yahaya 1:7</char></note> <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Nǝn a thlǝn fathlǝnggighǝn ɓa tǝ pi kodwomnda, na nda wumang nafighǝn ɓa na wuwura hu kudma faɗa na ahu ƙǝshiirha.”<verse eid="MAT 24:31" /></para>
  <para style="s">Tsaharhaha a ten ɗǝf shiɓarha</para>
  <para style="r">(<ref loc="MRK 13:28-31">Markus13:28-31</ref>; <ref loc="LUK 21:29-33">Luka21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“Nanǝnya tsahama ˈya a fat shiɓadɗiya, ana wuhwaryighǝn a kyaharra hai, nǝn a tsǝtsǝtta, nun sǝndasǝ nduwus fegrha ɓa. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Nǝghǝn kee kǝm, anaɗun ǝnggini heu ya, nun a sǝnda sǝ nduwus wuttǝghǝn ɓa, nǝghǝn a mii kwatminda fa. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Niya pǝrang ƙǝkafek kun, nafiya ƙǝshidɗiya mba nda mǝra wa, kǝl ma katǝra ǝnggina hai ya. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Nda talara tǝ hweeɗe na nda a ngwalarha hai amma Laɓarna mbǝ tam ngwalarha hai wa.”<verse eid="MAT 24:35" /></para>
  <para style="s">Mbǝ niifa sǝ sǝngga far ɓad Ƙǝrǝsti ɓa wa</para>
  <para style="r">(<ref loc="MRK 13:32-37">Markus13:32-37</ref>; <ref loc="LUK 17:26-30">Luka17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“Mbǝ niifa sǝ sǝngga farɗi, nduwa sayi na ǝnggini a katǝrarha hai ya wa, ko fathlǝngya Faara na talara nduwa Wanggǝn tafadghǝn wa, ƙǝl Chin katenggǝn. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Ƙǝla katǝra nǝn hai a thlakh mbǝd Nuhu, nǝn a naarha kee a far wutta Wan niifa ɓa.<note caller="+" style="f"><char style="fr" closed="false">24:37 </char><char style="ft" closed="false">Katǝrarha 6:5-8</char></note> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />A faryini kapa na aam afa afa ɗi ɓarha ɓa, fiya a hǝbrha tǝ saarha, kanda kakhrha tǝ fǝr wanggindan chimarha ɗǝ, ta farɗa ɗǝ kyana Nuhu hu kombuwol hai.<note caller="+" style="f"><char style="fr" closed="false">24:38 </char><char style="ft" closed="false">Katǝrarha 6:14</char></note> <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Sǝngwanda ˈya na katǝrarha hai wa, har ɓana aam afa afa ɗaɓa hwanggǝn kanda ɗǝ. Nǝn a naarha kee a far wutta Wan niifa ɓa.<note caller="+" style="f"><char style="fr" closed="false">24:39 </char><char style="ft" closed="false">Katǝrarha 6:24</char></note> <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Nafiya sǝri a ǝna taara kyab a hee, na nda tǝr tal mal tahadghǝn nda. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Nishya sǝri a hǝrha ahu fǝna, na nda tǝrang nda tal mal tahadghǝn nda.”<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />“Tsaunǝn kee, tsawama nggungwa fa, ƙǝsǝr sǝnggun farɗi na Chinun a ɓarha ɓa wa. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Amma a sǝnunsǝ: A ndam na turi ɗi a sǝn farɗi na ngaara a ɓarha ɓa a fiɗikrha, kam mbǝ a shiirha malanggǝn ngaarɗi kyagha minda keeghǝn hai wa. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Nanǝn kee tsawama nggugwafa, ƙǝsǝr na Wan Niifa a ɓarha ɓa a sayidɗi sǝngwawa nun sǝ.”<note caller="+" style="f"><char style="fr" closed="false">24:44 </char><char style="ft" closed="false">1 Tasalonikaya 5:6; Luka 12:39-40</char></note><verse eid="MAT 24:44" /></para>
  <para style="s">Ka niifa tǝ ndǝrwid niifa</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luka12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“Wunni mafadɗi na tǝ ƙǝkafek fa, ɗǝfang na turighǝn tǝkǝla wurighǝn ha, na fǝrang ǝnnarhami fingya mafaya ahu sayidɗi kamngga? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Nǝn a naarha ngga a fad mafadɗi a wud turighǝn ɓa ɓagha walghǝn a ǝna targhǝn. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Niya pǝrang kǝkafek kun, nǝn a ɗǝfang nda tsauka mam a ten karidghǝn heu. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Amma andam mafadɗi tǝ mbǝlfeerha ni, nǝn a ndang nda altenggǝn, ‘Turina mbǝ a wutta ɓa wet wa.’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />Tǝrgha katǝranggǝn ɗǝk fingya mafaya hai, ndǝghǝn a hǝbrha tǝ sarha tǝ fingya na a nggal mbalya, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />a ǝnaɗǝ kee na turighǝn a wutta ɓa ahu sayidɗi tǝ farɗi sǝngwawa nǝn sǝ. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Nǝn a kyathlang nda ɗǝ ɗawal-ɗawal tǝ kǝm fǝrang mbǝrha nǝn a thlǝmad fa thǝrɓuya. A mbǝɗi na tǝrha sǝ tǝ ƙǝt mee.”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Karapu aten wutaraya kum</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Tǝrgha ndagha Yeeso, “Kutǝryid talara nǝghǝn ƙǝla wutaraya kum tǝrang nanda patillad ndan ka ɗaa nda wal wutsamnda.<note caller="+" style="f"><char style="fr" closed="false">25:1 </char><char style="ft" closed="false">Luka 12:35</char></note> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Tuf ahur wutarayini nurya ni, tuf ƙǝm na nda ndǝndǝl. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Fingya yini na nurghǝn takhkwa nda fǝɗeerha haɗǝ ka ɗaa nda ira hu patilla yindan hai wa. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Amma fingyayini tuf na ndǝndǝl takh nda fǝɗeerha haɗǝ ahu ƙǝthlikrha ka patilla yindan. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Ɓawana wutsamnda ɓa wed, ƙǝsgha ɓeena kanda shii nda ɗǝ.”<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />“A manad fǝɗikrha thlii nda sǝ ka mbeela sǝk nanda. ‘Kulo wutsamnda ya thleema sǝ ɗun hwathlaghǝn fa!’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Tǝrgha wutarayini kum thlii nda sǝ tangsang ngganda patilla yindan. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Nurya wutarayini tuf tsahang fǝɗeerha nda wutarayini tuf na ndǝndǝl, Naghan a hwan kun, ‘Ənaman fǝɗed nun kan ha ngguchit lee, ƙǝsǝr na patilla yinan a mǝra hai.’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Amma nggǝrangga fingyayina sǝ, ‘Mbǝ tsǝghang ƙǝm heu wa. Ɗama ɗǝ ɗun hii yinun ɓa.’” <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Wii nanda ka hii fǝɗedɗa ɗǝ, a samad ndan ɓagha wutsamnda ɓa. Tǝrgha fingya yini ngwagha fa kya nda a mbǝd wutsǝfayid kahadɗa ɗǝ, chang ngganda kwakirma.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />Tsǝɓaku sǝlgha fingya yina ɓa ɗǝgha ka hii fǝɗedɗa ɗǝ, isha nda a ƙǝshi na nda a aah farha, “Chinǝm! Chinǝm! Inang kwakirma kan hai!” <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Amma nggǝrangga wutsamnda kanda sǝ, “Ƙǝkafek, sǝngwi kun wa.”<note caller="+" style="f"><char style="fr" closed="false">25:12 </char><char style="ft" closed="false">Luka 13:25</char></note><verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />“Tsaunǝn kee tsawama nggungwa fa, ƙǝsǝr sǝnggun farɗi nduwa sayidɗi niya wutta ɓa wa.”<verse eid="MAT 25:13" /></para>
  <para style="s">Karapu aten mafaya mahan</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luka19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Tǝ ƙǝm kutǝryid Talara nǝghǝn ƙǝla niifa na a wii tala a mbǝrha ɗǝ inggun. Aah mafayighǝn nǝn ɓa fǝrang ƙǝnaghǝnǝn kanda. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Fǝrang wuɗǝɓǝl wurirha nǝn yi tal yawarha tuf, yi sǝri fǝrang wuɗǝɓǝl wurirha nǝn yawarha sǝri, mafarha yi mahan fǝranggǝn yawarha tal, kowunni mǝmǝl tǝ ˈya nǝn a mbang nda. Tǝrgha wii fayighǝn nǝn. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Yi mafarha thlǝgha wuɗǝɓǝla yawarha tuf, ǝna shafili nǝn sǝ wal chikrha nǝn yawarha tuf. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Yi thlǝgha yawarha sǝri ndǝghǝnggi ƙǝm ǝna shafili nǝn sǝ wal chikrha nǝn yawarha sǝri. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Amma yi thlǝgha yawarha tal wiigha ɗǝgha ra kwaarha ɓǝɓenggǝn wuɗǝɓǝlɗi ki turighǝn sahai.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />Mǝnnǝn ha wudgha turi mafayina ɓa aah kanda nǝn ɓa a fǝrang kirassa ˈya nda ǝnana nda tǝ wuɗǝɓǝlghǝn. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Yi mafarha fǝrang nǝn wuɗǝɓǝl wurirha yawarha tuf ɓagha ɓa ndǝghǝn, “Turina, fǝrenna wuɗǝɓǝl wurirha yawarha tuf ka a ǝna shafili ni sǝ, walɗi chikrha yawarha tuf atenggǝn.” <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Falghǝna turighǝn, ndǝghǝn, “Usakko ka mafanna. Ənanna ƙǝkafekkirha ahu ˈya ngguchit. Niya ɗǝforha aten ǝngya hangga. Ɓoɓa ɓa ǝna wutsǝfayirha tǝ nggi.”<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />Mafadɗi thlǝgha wuɗǝɓǝl wurirha yawarha sǝri ɓagha ɓa ndǝghǝn, “Turina, fǝrenna wuɗǝɓǝl wurirha yawarha sǝri, ǝnaɗi shafili sǝ, walɗi chikrha yawarha sǝri atenggǝn.” <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Ndangga turiɗi, “Usakko ka mafanna na tǝ ƙǝkafek fa. Ənana ƙǝkafekkirha ahu ˈya ngguchit, niya ɗǝforha aten ǝngya hangga. Ɓoɓa ɓa ǝna wutsǝfayirha tǝ nggi.”<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />Tǝrgha yi mafarha thlǝgha wuɗǝɓǝl wurirha yawarha tal ɓagha ɓa, ndǝghǝn, “Turina, sǝnɗi sa na ngyangthlang, na hathla a mbǝrha hǝfwa nana tǝ ƙǝm na wumang ǝnnarhami hai huɗawana na. Sa ƙǝm na midwa sǝ ǝn ka kaan. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Nanǝn kee tǝrǝmɗi raɗi kwarha ɓǝɓeng ɗi wuɗǝɓǝl wa sǝ. Kulo ndǝghǝn ya thlu ǝnwa.”<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />Amma ndangga turighǝn, “Sa tǝmbǝlfed mafarha na tǝ sǝbrha yid! Ashe kyanna sǝnda sǝ ni hathla a mbǝrha hǝfwa ni tǝ ƙǝm ni wumang ǝnnarhami hai a mbǝrha huɗawani, <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />mani ɗǝfewana wuɗǝɓǝl na hu mbanki? A wuɗɗi ɓa kam niya thlǝghǝn har tǝ chikrha atenggǝn.” <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Tǝrgha ndǝghǝn, “Thlaama wuɗǝɓǝlɗi na a harghǝn, fǝrang nggǝnun yanɗi natǝ wuɗǝɓǝl wurirha yawarha kum. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Ƙǝsǝr kala yanɗi natǝ ˈyaha na nda chighanggǝn, tǝnǝn waala ha kaan. Amma kala niifa mbuwa tǝghǝn ha, ko yanɗi na ngguchit nanǝn tǝghǝn ha na nda a thlang hai a haarghǝn.<note caller="+" style="f"><char style="fr" closed="false">25:29 </char><char style="ft" closed="false">Matta 13:12; Markus 4:25; Luka 8:18</char></note> <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Nanǝnya muwaman ka wuɗi mafadɗiya a ƙǝsha ɗǝ, ahu wula ɗǝ, a mbǝɗani na nanda a tǝrha sǝ tǝ ƙǝt mee.”<note caller="+" style="f"><char style="fr" closed="false">25:30 </char><char style="ft" closed="false">Matta 8:12; 22:13; Luka 13:28</char></note><verse eid="MAT 25:30" /></para>
  <para style="s">Far ngwala mii ngwa kumarha</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />A fara ɓana Wan Niifa ɓa ahu mamnggitghǝn, tǝ fathlǝngya Faara a thlǝmadghǝn, nǝn a tsaurha ahu tsǝnggam mamnggitghǝn a talara.<note caller="+" style="f"><char style="fr" closed="false">25:31 </char><char style="ft" closed="false">Matta 16:27; 19:28</char></note> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Nafiya ƙǝshiirha na nda a wumnda a mbedghǝn ɓa, nǝn wurang nda fiya ɗǝ ƙǝla na tǝlafrha wurang nda chauraya ɗǝ ahur ˈwalya. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Nǝn a sang chauraya a yisǝmadghǝn ˈwalya ƙǝm a yikawadghǝn. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Tǝrgha na kutǝra a ndang nda fingya na a yisǝmadghǝn, “Ɓama ɓa, kun fǝrangna Pǝpa parka, harama langaad kutǝryidɗi ɗǝfang nanda ka kun ka ǝnana nda ƙǝshiirha. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Ƙǝsǝr ƙǝs miirha nggi fǝree ɗun ǝnnarhami. Ƙǝs hushimnda nggi fǝree aam saarha nun. Tsauɗi ronga, thlǝ nggi nun fa ahu wurayinun. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Niyi tawalth hai fǝree ǝn ƙǝnda nun. Fanna ɓee, pu nggi nun. Muwenda ahu porsǝna ɗǝ, ɗun ka ndee ˈyaɗǝ.”<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />“Tǝrgha ka nafiya na nda a nggǝrang sǝ, ‘Chinǝm, akwanni nanan sa a miirha fǝro ǝnnarhami nan? Nduwa ƙǝs hushimnda sa furo aam saarha nan? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Nduwa ronga ni sa thlǝ sa nan fa? Nduwa sa tawalth furo ǝn kaala nan? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Akwan nanan sa fadwa ɓee nduwa ahu porsǝna ɗan ndoˈya?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Na kutǝrɗi a nggǝrang kanda sǝ, ‘Niya pǝrang ƙǝkafek kun, a ǝnang ɗun tal na ngguchit kaan ahur wanman nggini kyana ya, ǝna nun ndǝn a nggi.’<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />“Tǝrgha na kutǝrɗi a kyaharra thlǝmad nafina ɗǝ na a yikawadghǝn ndanggǝn kanda, ‘Weema ma thlǝmadna, kun shiwangna Faara, ɗun hu waarha ɗǝ mbuwa mǝra hai tangsang nanda hai ka sheetan tǝ fathlǝnggighǝn. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Ƙǝsǝr nggi hu miirha, fǝreewun ǝnnarhami wa. Ƙǝs hushimnda nggi fǝreewun aam saarha wa. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Tsauɗi ronggirha thlǝwun nggi fa ahu wurayinun wa. Nggi tawalth hai, fǝreewun ǝn kaala fa wa. Fanna ɓee tǝ ƙǝm nggi ahu porsǝna ɗuwun ka ndee ˈyaɗǝ wa.’<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />“Kanda ƙǝm na nda a nggǝrang sǝ ndaa nda, ‘Chinǝm, akwan ni nanan sa a miirha nduwa a hushimnda nduwa ronga ni sa nduwa tawalth nduwa fadwa ɓee nduwa ahu porsǝna, ɗowan sǝ wa?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Nǝn a nggǝrang nda kanda sǝ, ‘Niya pǝrang ƙǝkafek kun, a karɗun ɗang nda wanmanggina sǝ na nggu-ngguchit ya, kar nun ɗeerha sǝ.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Tǝrgha na nda a ɗǝrha hu sǝsaarha ɗǝ mbuwa tam ngwalaarha, amma ka nafiya na nda a ɗǝrha hu yibrha ɗǝ mbuwa tam ngwalaarha.”<note caller="+" style="f"><char style="fr" closed="false">25:46 </char><char style="ft" closed="false">Ndaniyel 12:2</char></note><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Ƙǝnang mamngya Yahudaya hai a ɓǝlang ngganda Yeeso</para>
  <para style="r">(<ref loc="MRK 14:1-2">Markus14:1-2</ref>; <ref loc="LUK 22:1-2">Luka22:1-2</ref>; <ref loc="JHN 11:45-53">Yahaya11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Ngwalang na Yeeso thlǝk ǝnggini heu, ndanggǝn fatsahayighǝn, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Ƙǝla sǝnnunsǝ, takhƙǝn ɓeena sǝri na a ǝna wutsǝfayid tǝɗaarha nda, na nda a fǝr Wan Niifa ka a tawang ngganda ɗǝ.”<note caller="+" style="f"><char style="fr" closed="false">26:2 </char><char style="ft" closed="false">Kyarhaɓa 12:1-27</char></note><verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Tǝrgha mamnda firistaya tǝ shingya na nda a wumnda hai a kwakirǝm Firis na manggǝn, na thlǝmnggǝn Kayafa. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Ƙǝnang ngganda hai na nda a ƙǝsang Yeeso ɓǝɓee ɓǝlang ngganda. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Ndaa nda, “Amma mbǝ a sayid wutsǝfayidɗi wa. Naɗǝ fiya ǝna kakyathlaanga.”<verse eid="MAT 26:5" /></para>
  <para style="s">Irang nuneefa fǝɗeerha Yeeso teena a Mbetani</para>
  <para style="r">(<ref loc="MRK 14:3-9">Markus14:3-9</ref>; <ref loc="LUK 7:37-38">Luka7:37-38</ref>; <ref loc="JHN 12:1-8">Yahaya12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Nana Yeeso a Mbetani, a minda kii Siman ˈwana termeerha ƙǝsa. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Nanǝn a hǝb ǝnnarhami, ɓagha nuneefa ɓa tǝ ƙǝthlikrha urdi na sǝdghǝn mbǝnggǝn na tǝ wuɗǝɓǝla fa kaan iranggǝnǝn Yeeso a tenggǝn.<note caller="+" style="f"><char style="fr" closed="false">26:7 </char><char style="ft" closed="false">Luka 7:37-38</char></note> <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Amma nana fatsahayina ndǝn sǝbgha hur ndan ɗǝ ndaa nda, “Yanɗiya sǝbrha ni ɗǝ kee.” <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />“A ndam kwang heng nda fǝɗedɗa ɗǝ na nda a wal wuɗǝɓǝla sǝ kaan fǝrang wuɗǝɓǝlghǝn nda fa yamiya.”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Amma sǝnang na Yeeso ǝnɗa hai na nda a thlǝkrha ndanggǝn kanda, “Kama nun a ɓilla nuɗiya? Ai ǝnaɗǝ ˈya na ngga a nggi. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Ƙǝtsar na fa yamiya narha tǝ kun, amma mbi naarha ƙǝtsar tǝ kun wa.<note caller="+" style="f"><char style="fr" closed="false">26:11 </char><char style="ft" closed="false">Nggurub Ngwa Kumaarha 15:11</char></note> <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Iree nǝn urdi ɗa fa ya, ngwe nǝn fa ka yi panna. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Niya pǝrang ƙǝkafek kun, Kala mbǝrha pǝrna nda laɓar Faara sǝ ahu ƙǝshidɗiya, ǝnɗi ǝnana nuɗiya mbǝ tam mbǝtta wa na nda naarha ɗalghǝn teena.”<verse eid="MAT 26:13" /></para>
  <para style="s">Nggǝm Yahuda fa a fǝr Yeeso nǝn</para>
  <para style="r">(<ref loc="MRK 14:10-11">Markus14:10-11</ref>; <ref loc="LUK 22:3-6">Luka22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Tǝrgha Yahuda Iskaryoti tal ahur fatsahaya Yeeso kumkap sǝri ɗǝgha thlǝma mamnda firistaya ɗǝ <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />tsakhmee nǝn, “Ma nun a fǝreerha a fǝrangɗi Yeeso kun?” Nanǝn kee fǝrang wuɗǝɓǝl wurirha nda kumnggit mahan.<note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="ft" closed="false">Dzakariya 11:12</char></note> <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Ka a farɗi nagha Yahuda a kaɗa kwamana na a fǝrang Yeeso nǝn kanda.<verse eid="MAT 26:16" /></para>
  <para style="s">Hǝb Yeeso ǝnnarhami yi Tǝɗaarha tǝ fatsahayighǝn</para>
  <para style="r">(<ref loc="MRK 14:12-21">Markus14:12-21</ref>; <ref loc="LUK 22:7-13">Luka22:7-13</ref>; <ref loc="JHN 13:21-30">Yahaya13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />A katǝra far wutsǝfayidɗi yi mburodi kula mekhna, ɓagha fatsahaya Yeeso thlǝmadghǝn ɓa tsahang mee nda, “A yanggi na midwa ɗan nggorha fa ɗǝna hǝb ǝnnadmid tǝɗaarha sǝ?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Ndanggǝn kanda, “A kyaɗun hu wupǝri ɗa hai, na niifa sǝ nun a naarha. Ndaman, ‘Ndagha mala, nduwus sayid na ɓa, ni a hǝb ǝnnadmid Wutsǝfayid Tǝɗaarha tǝ fatsahayina a minda kyawa.’ ”<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />Nanǝn kee ǝnagha fatsahayini ƙǝla ndangna Yeeso kanda ngwa nda fa tǝ ǝnnadmid Wutsǝfayid Tǝɗaarha a mbǝɗi.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Tsǝna figrha hai tsauka Yeeso hai hǝb ǝnnarhami nǝn tǝ fatsahayighǝn kumkap sǝri. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Na nanda a hǝb ǝnnarhami ndangga Yeeso kanda, “Niya pǝrang ƙǝkafek kun, tal ahur nun nǝn a fǝr nggi.”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Sǝbgha hur ndan ɗǝ nagha kowunni a ndang nda, “Nggini wa, Chinǝm?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Nggǝrangga Yeeso kanda sǝ, “Tal ahur nun hǝbgha ǝnnarhami tǝ nggi hu tasau tal nǝn a fǝr nggi.<note caller="+" style="f"><char style="fr" closed="false">26:23 </char><char style="ft" closed="false">Dzabura41:9</char></note> <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Ƙǝsǝr tǝtani a mǝrgha Wan Niifa, ƙǝla thlǝkna Ɗeleewar Faara ƙǝtǝm. Amma ǝn kawa ni a niifɗi fǝrgha ndǝn. Nǝn a tsaurha a fad niifɗi a nggushi nggǝt waana ndan.”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Tǝrgha Yahuda yanɗi na a fǝr Yeeso, ndǝghǝn nggi ƙǝm Tsakhmee nǝn, “Mala, nduwa nggini wa?”</para>
  <para style="p" vid="MAT 26:25">Nggǝrangga Yeeso sǝ, “Sa ma thlǝk nan.”<verse eid="MAT 26:25" /></para>
  <para style="s">Hǝb ǝnnarhami yi Chinǝm</para>
  <para style="r">(<ref loc="MRK 14:22-26">Markus14:22-26</ref>; <ref loc="LUK 22:14-20">Luka22:14-20</ref>; <ref loc="LUK 11:23-25">11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Na nanda a hǝb ǝnnarhami, tǝrangga Yeeso mburodi sǝ usa Faara nǝn kyanggǝn hai fǝranggǝnǝn fatsahayighǝn ɗǝ ndanggǝn kanda, “Thlaama kyaman, thlu fanna ni ya.”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Tǝranggǝn wuhuleurha sǝ na tǝ aam inabi usa Faara nǝn atenggǝn. Fǝranggǝnǝn kanda ɗǝ ndǝghǝn, “Saama kun heu. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Ƙǝsǝr farna ni ya yi lǝghǝtta ɗǝfmee, irang nanda ɗǝ ka fiya hangga yi chakh ɗimiyirha.<note caller="+" style="f"><char style="fr" closed="false">26:28 </char><char style="ft" closed="false">Kyarhaɓa 24:8; Irmiya 31:31-34</char></note> <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Niya ndang nda kun, mbiya nggǝr sa aam inabiɗi ya wa, ƙǝl a farɗi niya sa weerǝn ndǝghǝn tǝ kun ahu Kutǝryid Pǝpa.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Tǝrgha Yeeso tǝ fatsahayighǝn aah amshe nda, kya nda sǝ ɗǝnda wumnda ɗǝfya Dzaitun ɗǝ.<verse eid="MAT 26:30" /></para>
  <para style="s">Na Mbiturus a ngaal sǝnda Yeeso</para>
  <para style="r">(<ref loc="MRK 14:27-31">Markus14:27-31</ref>; <ref loc="LUK 22:31-34">Luka22:31-34</ref>; <ref loc="JHN 13:36-38">Yahaya13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Tǝrgha ndangga Yeeso kanda, “A fǝɗik weeriya kun heu nun a ɗaarha ma nggi. Ƙǝsǝr nǝghǝn chichirethlee hai ahu ɗeleewar Faara,</para>
  <para style="b" vid="MAT 26:31" />
  <para style="q1" vid="MAT 26:31">‘Niya ɗǝk tǝlafǝdɗi,</para>
  <para style="q2" vid="MAT 26:31">na chiɓǝd chaukhrayini a weela hai.’”<note caller="+" style="f"><char style="fr" closed="false">26:31 </char><char style="ft" closed="false">Dzakariya 13:7</char></note><verse eid="MAT 26:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32" />“Amma a thliiɗi sǝ ahu mǝrra, niya ˈwaarha ma kun a Nggalili ɗǝ, a mbǝɗani ɗǝnǝm ƙǝmarha sǝ.”<note caller="+" style="f"><char style="fr" closed="false">26:32 </char><char style="ft" closed="false">Matta 28:16</char></note><verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Tǝrgha Ndangga Mbiturus, “Ko ɗad fiya heu ma sa, nggi kam mbi ɗaarha ma sa wa.”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Nggǝrangga Yeeso sǝ, “Niya pǝro ƙǝkafek, Mbiturus, a fǝɗik ɗiya, kapa na kilngaara tǝtaarha, na a ngaal sǝndǝna katǝra mahan.”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Amma ndagha Mbiturus, “Ko nǝm a mǝra kyab, mbi tam ngaal sǝnduwa wa!” Fingya fatsahaya ƙǝm ndaa nda kee.<verse eid="MAT 26:35" /></para>
  <para style="s">Hwan Yeeso Faara a Nggetsǝmani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Markus14:32-42</ref>; <ref loc="LUK 22:39-46">Luka22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Tǝrgha ɗǝgha Yeeso tǝ fatsahayighǝn a mbǝrha ɗǝ na nda aarha Nggetsǝmani, ndanggǝn kanda, “Tsawama a mbǝɗiya, ɗǝni mbǝɗaɗǝ taarha ɗi hwan Faara.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Tahanggǝn Mbiturus haaɗǝ tǝ wangya Dzabaɗi sǝri Yakubu tǝ Yahaya, nagha tǝ sǝbrha hura tǝ ɓillaarha. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Tǝrgha ndanggǝn kanda, “Niyi tǝ sǝbrha hura kaan ƙǝla ni mǝra. Tsawama a mbǝɗiya a shiiɗun wa nam a ƙǝlaarha tǝ nggi.”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Nduwusgha mbeeɗǝ kwanggǝn tenggǝn hweeɗe hai, hwan Faara nǝn, “Pǝpa, a naɗǝ a ǝnaarha hai, tǝrang wuhuleu sǝsadɗiya ma nggi. Ko nanǝn kee, mbǝ nggǝmnda hurna ni wa, amma nggǝmnda hur wa.”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Tǝrgha wudgha thlǝmad fatsahayighǝn ɗǝ ɗǝgha wal kanda a shiirha. Ndanggǝn Mbiturus, “Mbun mbang naarha a ƙǝlaarha ko tsun tsǝɓaku wa? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Tsawama a ƙǝlaarha non a hwan Faara, amawa nun kyaarha hu ƙǝƙǝrra hai. Na mid sǝsǝna sǝ, amma tsǝ thlu farha shishiu!”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Wiigha Yeeso ma kanda yi sǝri hwan Faara nǝn, “Pǝpa, a mbǝ a ǝnaarha hai tǝrgha wuhuleu ɗaɗǝ ya wa ƙǝl a saaɗi ndǝn, ngwa tsauka nggǝmnda hurwa kee. <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Nggǝr nǝn wutta thlǝmad ndan ɗǝ, ɗǝgha wal kanda a shiirha, ƙǝsǝr nggalang ɓeena yid ndan.”<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />Nanǝn kee nggǝrghǝn wiirha ka hwan Faara ɗǝ yi mahan, nagha a thlǝkrha ƙǝla ˈwanǝn thlǝkrha. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Tǝrgha wudgha thlǝmad fatsahayighǝn ɓa ndanggǝn kanda, “Ɗaama mbeeɗǝ tǝ shiirha, yiɓun. Ƙǝlama hai mbiya nduwus sayi ɓa, fǝr nda Wan Niifa a haar faɗimiya hai. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Thleema sǝ, tama wiim! Kulo niifɗi fǝrgha nggi ɓaɗa ɓa!”<verse eid="MAT 26:46" /></para>
  <para style="s">Ƙǝsang nda Yeeso</para>
  <para style="r">(<ref loc="MRK 14:43-50">Markus14:43-50</ref>; <ref loc="LUK 22:47-53">Luka22:47-53</ref>; <ref loc="JHN 18:3-12">Yahaya18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Kapa na Yeeso nggǝlang miighǝn, Yahuda tal ahur fatsahaya Yeeso kumkap sǝri sǝlɗa ɓa tǝ fiya hangga a samadghǝn ƙǝs nda thlaukh ƙǝlarya ha tǝ sǝsalya. Mamnda firistaya tǝ shingya thlǝngga kanda ɓa. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Tǝ thlǝrɓu ɗi, Yahuda, saghang ɗǝ kwamana kanda tǝ ndaarha, “Yanɗi fǝɓang ni niifɗa ni ƙǝsaaman.”<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Ɗǝgha Yahuda thlǝmad Yeeso ɗǝ ndanggǝn, “Niyi a ndoˈya Mala!” Tǝrgha fǝɓangga Yahuda.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Nggǝrangga Yeeso sǝ, “Pashinna, ɗu mbeeɗǝ tǝ ˈya ɓoogha ɓa.” Tǝrgha nafini ƙǝsang ngganda Yeeso.<verse eid="MAT 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51" />Amma tal ahur fiya na a thlǝmad Yeeso ƙǝɗanggǝn thlaukh ƙǝlara sǝ kyathlanggǝn thlǝmad mafad firis ɗǝ. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Ndangga Yeeso niifɗi, “Wuɗang thlaukh ƙǝlar wa ahu ƙǝnggǝn hai, ƙǝsǝr kala niifa tǝrgha thlaukh ƙǝlara, thlaukh ƙǝlara ni a ɓǝlang nda. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Sǝnggun sǝ ni mbang hwan pǝpa, puwanggǝn fathlǝngya Faara ɓa kalgha kiwad sodjaya kumkap sǝri wa? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Amma a ǝnaɗi kee, ƙǝƙǝn na laɓar Faara lǝghǝtta ndanǝn nǝn a katǝrarha hai ƙǝla nanǝnya?”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Tǝrgha ndangga Yeeso fiya wumngga hai, “Tǝrwun nggi niifa ni na tǝmbǝng, nun ɓaarha ɓa tǝ thlaukh ƙǝlarya tǝ sǝsalya ka a ƙǝseewun wa? Ƙǝtsar nggi a thlǝmad nun, nggi a tsaharhaha ahu Ƙǝn Faara na a Urshalima ƙǝseewun wa.<note caller="+" style="f"><char style="fr" closed="false">26:55 </char><char style="ft" closed="false">Luka 19:47; 21:37</char></note> <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Amma katǝraghǝn hai heu kee ka a lǝghǝdgha ˈya ndaana annabiya na chichirethlee hai ahu ɗeleewar Faara.” Tǝrgha fatsahayighǝn ɗaa nda mal Yeeso nda.<verse eid="MAT 26:56" /></para>
  <para style="s">Ɗǝnda tǝ Yeeso a mbed kognaya ɗǝ</para>
  <para style="r">(<ref loc="MRK 14:53-65">Markus14:53-65</ref>; <ref loc="LUK 22:54-55">Luka22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yahaya18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Tǝrgha nafini ƙǝsangga Yeeso ɗǝnda tǝghǝn a minda ƙi Kayafa ɗǝ mamnda firistaya, a mbǝɗani wumna famalǝmngya ngyakhrha sahai tǝ shingya. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Amma Mbiturus mbuɗǝ samadghǝn ɗǝ inggun ta pǝpal minda mamnda firis ɗǝ. Kyagha sahai tsauka hai a thlǝmad fa ƙǝlaya ha nagha a ƙǝla ˈyaha na a katǝrarha hai. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Mamnda firistayini tǝ kogna yini wumngga hai na nda a kaɗa kwamana na a ƙǝsangganda Yeeso tǝ ˈya na ɗimi, tǝna nda ɓǝlang nda. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Amma walwa nda wa ko nanǝn fingya sǝ hangga nggǝmngga fa na nda a thlǝghang nggaɓaarha fa ǝnawa nda taara tǝ palth ndan wa. Akwasamadghǝn kyagha nafiya ɓa sǝri <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />ndaa nda, “Ndagha kamshiɗiya, ‘Ni mbang chang Ƙǝn Faara hai na a Urshalima nggǝr yi tǝnang ahu ɓeena mahan.’ ”<note caller="+" style="f"><char style="fr" closed="false">26:61 </char><char style="ft" closed="false">Yahaya 2:19</char></note><verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Tǝrgha thliigha mamnda firis sǝ ndanggǝn Yeeso, “Mba mbang nggǝra sǝ wa? Ma na ndaarha aten pathɗi thlǝkna nafini aten wa ya?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Amma nggasgha Yeeso tip. Tǝrgha ndangga mamnda firis, “Na minna sǝ ahu thlǝm Faara natǝ yibrha, pǝranggǝn kan ana sa ni Ƙǝrǝsti, Wan Faara,”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Nggǝrangga Yeeso sǝ, “Pǝr nan. Amma niya ndang nda kun heu a mbee nun a na Wan niifa tsau a yisǝmad Faara Amshi tǝ ƙǝm ɓayi ahu hashmbe a talara hai.”<note caller="+" style="f"><char style="fr" closed="false">26:64 </char><char style="ft" closed="false">Ndaniyel 7:13</char></note><verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Tǝrgha mamnda firis ɗi djaranggǝn luwudghǝn ɗǝ, ndǝghǝn, “Sarɗǝ Faara! Palthma nǝm nggǝr kaɗaarha faɗǝn? Sǝkɗǝm ndǝn hai a miighǝn laɓar sar Faara.<note caller="+" style="f"><char style="fr" closed="false">26:65 </char><char style="ft" closed="false">Ɗeleewar Firistaya 24:16</char></note> <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Ma ndaa nun?” Kanda heu ndaa nda, “Kamɗǝ a mǝrgha!”<note caller="+" style="f"><char style="fr" closed="false">26:66 </char><char style="ft" closed="false">Ɗeleewar Firistaya 24:16</char></note><verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Tǝrgha chahang yakhrha nda fa ɗǝkƙǝn nda. Fingya ƙǝm mbighǝnda,<note caller="+" style="f"><char style="fr" closed="false">26:67 </char><char style="ft" closed="false">Ishaya 50:6</char></note> <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />na nda a ndaarha, “Kulang kansǝ, Ƙǝrǝsti! Wun mbiigha sa?”<verse eid="MAT 26:68" /></para>
  <para style="s">Ngaal Mbiturus sǝnda Yeeso</para>
  <para style="r">(<ref loc="MRK 14:66-72">Markus14:66-72</ref>; <ref loc="LUK 22:56-62">Luka22:56-62</ref>; <ref loc="JHN 18:15-18">Yahaya18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Nanǝnya Mbiturus tsau a ƙǝshi a pǝpal minda, kyagha mafad wee nuwun ɓa ndanggǝn, “Sa na tal ahur nafini na a mbu samad Yeeso tǝ Nggalilad ɗi.”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Amma ngaalghǝna Mbiturus a mbed ndan heu. Ndanggǝn, “Sǝngwi ǝnɗi na a thlǝkrha ya wa,” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Tsǝɓaku kyagha kwakirma sǝ nggǝrgha mafad wee nuwun naghǝn ndanggǝn fiya na a mbǝɗi, “Niifɗiya kanda ni tǝ Yeeso tǝ Nadzarat.”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Nggǝrgha Mbiturus ngaalghǝn, har tǝ aah thlǝm Faara ndǝghǝn, “Sǝngwi niifɗi nun a thlǝkrha ya wa.”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Nggǝrna nda tsǝrha tsǝɓaku nafini na ƙǝƙǝt a mbǝɗi ɗǝnda thlǝmad Mbiturus ɗǝ ndang ngganda, “Sa mbǝ ngaala sǝ wa na tal ahur ndan, ƙǝsǝr ahu laɓar wa kyadɗǝ ndaarha tǝ Nggalilarha ni sa.”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Tǝrgha nagha Mbiturus a ang shiurha fadghǝn fa ɓa aah nǝn thlǝm Faara a Kanda ndaanǝn, “Sǝngwi niifɗi wa!” Tsu kee tǝtaagha ɗiyarha.<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />Tǝrgha ɗalgha Mbiturus teena hai tǝ laɓar Yeeso ndang nǝn, “Kapa na ɗiyarha tǝtaarha yi sǝri na ngaal sǝndǝna katǝra mahan.” Kyagha ƙǝshaaɗǝ tǝgha kaan.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Ɗǝnda tǝ Yeeso a mbed Mbilatus ɗǝ</para>
  <para style="r">(<ref loc="MRK 15:1">Markus15:1</ref>; <ref loc="LUK 23:1-2">Luka23:1-2</ref>; <ref loc="JHN 18:28-32">Yahaya18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />A tsar ƙǝrǝt, mamnda firistaya tǝ shingya heu, wuma nda hai ka a kaɗa kwaman ɓǝlla Yeeso nda. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Kǝnang ngganda, ɗǝnda tǝghǝn a mbed Mbilatus ɗǝ, ngwamnad Romaya.<verse eid="MAT 27:2" /></para>
  <para style="s">Mǝrra Yahuda</para>
  <para style="r">(<ref loc="ACT 1:18-19">Tar fathlǝngya1:18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Kǝlaana Yahuda hai fǝrgha Yeeso, ngwang nda kumad mǝrra Yeeso sǝ. Tǝrgha sǝbgha hurghǝn ɗǝ, haranggǝn wuɗǝɓǝl wuridɗa sǝ kumggit mahan wuɗanggǝnǝn mamnda firistaya ɗǝ tǝ shinggini. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Ndanggǝn kanda, “Ənaɗi ɗimiyirha, ƙǝsǝr fǝrɗi niifa ǝnawa ɗimiyirha.” Ndang ngganda, “Mbǝ ˈya sǝ djiɗangwa kan wa, kǝl ˈya ǝnana.”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Tǝrgha Yahuda tsamanggǝn wuɗǝɓǝlɗa hai ahu Ƙǝn Faara, wiigha ɗǝgha waghang altenggǝn sǝ.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Harangga mamnda firistaya wuɗǝɓǝlɗa sǝ, ndaa nda, “Kamngwa a ɗǝfanggǝm wuɗǝɓǝlɗi ya a mbǝd ɗǝfǝd yi Ƙǝn hwan Faara wa, nanǝn wuɗǝbǝl ƙǝna ɓǝl farha ni.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />A kwasamadghǝn ƙǝnang ngganda hai na nda a hii pǝpal yi taɓǝd tǝn ɓǝya sǝ tǝ wuɗǝɓǝlɗi, tsawang ngganda mbǝɗi, mbǝd ten kwad rongya. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Ndǝn na nda aah mbǝɗi, Pǝpal fara.<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />Tǝrgha lǝghǝdgha ˈya ndana annabi Irmiya ndanǝn, “Tǝrang ngganda wuɗǝɓǝl wuridɗa sǝ kumggit mahan, wuɗǝɓǝlɗi kyana nafiya Isǝreela. <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />Hii mbǝd taɓǝd tǝn ɓǝya nda sǝ kǝla ndaana Chinǝm”.<verse eid="MAT 27:10" /></para>
  <para style="s">Tsahang Mbilatus mee Yeeso</para>
  <para style="r">(<ref loc="MRK 15:2-5">Markus15:2-5</ref>; <ref loc="LUK 23:3-5">Luka23:3-5</ref>; <ref loc="JHN 18:33-38">Yahaya18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Nana Yeeso ƙǝt a mbed Mbilatus ngwamnad Romaya, tsahangga ngwamnaɗi mee, “Sani kutǝr Yahudaya wa?” Nggǝrangga Yeeso sǝ, “Ooh, ƙǝla ndaana.”<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Amma nana mamngya firistaya tǝ shingya a ˈyarghǝn, nagha Yeeso tip fayighǝn.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Ndangga Mbilatus, “Mbuwana a sǝk ǝnɗi na nda a thlǝkrha atenwa wa?”<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Amma nggǝrang ngwa Yeeso kanda sǝ aten ǝnggini heu thlǝk nanda wa, ƙǝsgha ǝnwulteena ngwamnaɗi kaan.<verse eid="MAT 27:14" /></para>
  <para style="s">Ngwang nda kumad mǝrra Yeeso sǝ</para>
  <para style="r">(<ref loc="MRK 15:6-15">Markus15:6-15</ref>; <ref loc="LUK 23:13-25">Luka23:13-25</ref>; <ref loc="JHN 18:39">Yahaya18:39</ref>,<ref loc="JHN 18:40">40</ref>; <ref loc="JHN 19:16">19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Nanǝnya ǝntin ngwamna ɗa ni nǝn yakh kalang niifa kanda hai tal na ahu porsǝna na min ndan a far wutsǝfayid Tǝɗaarha. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Ahu sayidɗi na niifa sǝ na tǝmbǝng, ƙǝnang na nda ahu porsǝna, na nda aarha Mbarabas. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Tsaunǝn wum fiya hai a kwakirǝm Mbilatus, tsahangga Mbilatus mee kanda, “Wun na minnun a kalang nggǝni kun hai, Mbarabas wa, nduwa Yeeso nanda aarha Ƙǝrǝsti wa?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Sǝn ɗa sǝ ƙǝsang na shingya Yeeso ƙǝsǝr ka sǝrǝkrha.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Nana Mbilatus tsau a mbǝd tsawud ngwa kumarha, thlǝngga nukƙun farha a thlǝmadghǝn ɗǝ a ndang ngganda, “Ma ǝnangna ˈya ka niifɗa fa ya wa ƙǝsǝr sǝsaaɗi kaan hu sǝsǝniirha atenggǝn a fǝɗik weeriya.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Amma mamngya firistaya tǝ shingya shik fiya nda, a ndang ngganda a kal Mbarabas nǝn hai, ɓǝlang ngganda Yeeso. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Nggǝrgha kutǝr ɗi tsakh mee, “Wun na minnun a kalang nggǝni kun hai ahur nafiyini na kyab ya?” Tǝrangga fiya urad ndan sǝ, “Mbarabas!”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Ndangga Mbilatus kanda, “Mani ǝnaarha tǝ Yeeso na nda aarha Ƙǝrǝsti?” Tǝrang ngganda urad ndan sǝ, “Tawaman ɗǝ!”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Ndangga Mbilatus kanda, “Kama nda? Ma ǝnanǝn na ɗimi?” Amma nagha fiya a tǝrang urad ndan sǝ, “Tawaman ɗǝ!”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />“Ƙǝlaana Mbilatus hai mbǝ ˈyasǝ nǝn mbang ǝnaarha wa, na nda a katǝrang kakyathlaanga. Tǝrgha thlǝn farha nǝn a ɓang aama nda ɓa tsaɓanggǝn harghǝn ɗǝ a mbed fiya, ndagha, Nggi, mbǝ harna tsuwar faar ka niifa fa wa. Kun ndǝn sǝngga ǝnnun.”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Nggǝmangga fiya heu, “Ngwa tsauka hakked farghǝn aten nan, kan tǝ wagginan!”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Tǝrgha Mbilatus kalang Mbarabas nǝn kanda hai. Fǝr Yeeso nǝn tsaɗa ghǝnda tǝ wutǝteerha, fǝranggǝnǝn sodjad Romaya ka ɗanda tawang ɗǝ.<verse eid="MAT 27:26" /></para>
  <para style="s">Waa sodjaya Yeeso</para>
  <para style="r">(<ref loc="MRK 15:16-20">Markus15:16-20</ref>; <ref loc="JHN 19:2-3">Yahaya19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Fingya sodjaya ngwamnaɗi tǝrangga nda Yeeso a mbǝd tar ndan ɗǝ, aah sodjaya nda ɓa heu. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Ƙǝɗangga nda lukkighǝn hai, kalang kaɓarha nda fa yiɓa. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Yam wuhar ndakhkya nda ƙǝla matuwel, panggǝnda atenggǝn, fǝrang sǝsal kutǝryirha nda a yisǝmadghǝn. Ɓǝra nda hai a mbedghǝn waaghǝn nda, na nda a ndangˈya, “Alvari, kutǝr Yahudaya!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Chahang yakhrha nda fa, thlǝ sǝsal ɗa nda na nda a ɗǝkƙǝn sǝ a tenggǝn. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Ɗakhna mindan ɗǝ tǝ waaghǝn, ƙǝɗang ngganda kaɓadɗa hai a fadghǝn, nggǝrgha nda kalang yighǝn lukrha fa. Tǝrgha wii nda tǝghǝn ka ɗa nda tawang ɗǝ.<verse eid="MAT 27:31" /></para>
  <para style="s">Tawang nda Yeeso ɗǝ</para>
  <para style="r">(<ref loc="MRK 15:21-32">Markus15:21-32</ref>; <ref loc="LUK 23:26-43">Luka23:26-43</ref>; <ref loc="JHN 19:17-27">Yahaya19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Nana nda aten wiirha, ɗa nda wal tǝ Sayirarha, thlǝmnggǝn ni Siman, ngyaɓang tǝr kaɗidɗa nda fa. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Sǝlna nda a mbǝrha ɓa nanda aarha Nggolggota, ndaarha ni mbǝd ɓalhwar teena, <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Fǝrangga sodja yini aam inabi nda kukurɗa tǝ ˈya na iˈikh, amma taarang nǝn, kar sad ghǝnǝn.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />A kwasamadɗi tawang na nda ɗǝ, ndǝghang ngganda lukkighǝn hai tǝ ǝna chacha. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Tǝrgha tsawa nda hai a mbǝɗi, nanda a ƙǝlaghǝn ha. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Chireelth ǝn sak ɗimiyidghǝn nda a man tenggǝn tǝ ndaarha, “KULO YEESO YA, KUTƏR YAHUDAYA!” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Na fathlee kwamangya sǝ sǝri tawang na nda kanda ɗǝ a thlǝmadghǝn, tal a man yisǝmadghǝn, tal a yikawa.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />Nagha fiya na a mbǝra ɗǝ a huhwang nda, na nda a tsang ˈya ten ndan fa yi waa farha. <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />Na nda a ndaarha, “Ndaana na mbang chang wuri Faara hai na a Urshalima tǝnangga sǝ hu paara mahan, ana Wan Faara ni sa, hǝrghang altenwa lee tǝra na hai a ten kaɗidɗiya!”<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Mamngya firistaya tǝ famalǝmgya ngyakhrha Musa, tǝ shingya ƙǝm waa Yeeso nda. <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Hǝrghang ɗǝ fingya, amma mbangwa hǝrghang nda altenggǝn wa. Ana ndǝghǝn ni kutǝr Isǝreela! Tǝrgha hai a ten kaɗidɗi nanǝnya lee, nǝm a fǝrƙǝkafek a ndǝghǝn. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Fǝrɗǝ ƙǝkafek a Faara, ngwa hǝrghangga Faara nanǝnya anaɗǝ na midghǝn sǝ! Ƙǝsǝr ndǝghǝn, Wan Faara ni nggi.”<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />Ko fa thlee kwaman nggina ni tawang na nda kanda ɗǝ tǝghǝn, waa ghǝnda kǝla ǝnana fiya.<verse eid="MAT 27:44" /></para>
  <para style="s">Mǝrra Yeeso</para>
  <para style="r">(<ref loc="MRK 15:33-41">Markus15:33-41</ref>; <ref loc="LUK 23:44-49">Luka23:44-49</ref>; <ref loc="JHN 19:28-30">Yahaya19:28-30</ref>; <ref loc="MRK 15:16-20">Markus15:16-20</ref>; <ref loc="JHN 19:2-3">Yahaya19:2-3</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Yanfara a sǝrǝkrha, nggǝlangga wula chehwedɗi heu har yargha yanfaara hai. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Yarna yanfaara hai kalgha Yeeso sǝ tǝ urarha manggǝn, “Eloi, Eloi, lama sabaktani?” Ndaarha ni, “Faarna, Faarna, kama karna nggi?”<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Fingya na ƙǝƙǝt a mbǝɗi sǝngwa nda sǝwa tamngga nda ndaarha nanǝn a aah annabi Ilya. <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Ɗagha niifa ɗǝ tal ahur ndan tǝtǝnanggǝn soso tǝ aam inabi na chichakh, panggǝn hu sǝsaala hai fǝranggǝnǝn sǝ ka a saagha.<verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />Amma ndagha fingya, malaman, ƙǝlaghǝnǝm ha, asǝmha ɓana Ilya hǝrghang nda.<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Tǝrgha nggǝrgha Yeeso tǝrang uradghǝn sǝ kaan tǝgha, mbǝ kal yiɓǝdghǝnǝn hai.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />A mǝmǝlla sayidɗi djargha shishamar Ƙǝn Faara hai sǝri, a talara hai ta hweeɗe hai. Rǝbgha ƙǝshiirha fa, fǝlgha ferya ɗǝ. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Ingga ten kwaya ɗǝ, ka nafiya Faara hangga mǝrgha, thlii nda sǝ. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Kyanda sǝ ahu ten kwaya, a kwasamadɗi thliina Yeeso sǝ ahu mǝrra, ɗǝnda ahu wupǝri ɗǝ tǝ peɗǝnda, kyad fandan nda a fiya hangga.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Mamnda sodja Romaya tǝ fingya sodjaya na a ƙǝla Yeeso ha, nana nda rǝbrha chehwedɗi tǝ ǝngya heu katǝrarha hai tǝrma nda, ndaa nda, “Ƙǝkafek niifɗiya Wan Faara ni!”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Tǝ nishya hangga ɓagha ɓa mbuwa samad Yeeso a Nggalili ɓa ka a ndang ngganda sǝ tǝ ˈya na midghǝn na nda a ƙǝlarha ɓa inggun. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Ahur ndan na Mairamu Magdaliya sǝ, tǝ Mairamu man nda Yakubu tǝ Yisǝfu, tǝ man nda Yakubu tǝ Yahaya, wangya Dzabadi.<verse eid="MAT 27:56" /></para>
  <para style="s">Pang nda Yeeso</para>
  <para style="r">(<ref loc="MRK 15:42-47">Markus15:42-47</ref>; <ref loc="LUK 23:50-56">Luka23:50-56</ref>; <ref loc="JHN 19:38-42">Yahaya19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Tsǝna figrha hai, na tǝ ƙǝna sǝ ɓagha ɓa a Aramatiya, thlǝmnggǝn ni Yisǝfu, tsauka tǝ takkwa Yeeso, <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />ɗǝgha thlǝmad Mbilatus ɗǝ tsakh mǝrra Yeeso nǝn, ndagha Mbilatus fǝraman ndǝghǝn. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Tǝrangga Yisǝfu mǝrɗi faɗanggǝn hu kaɓaarha hai na ngga pǝpet. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Ɗǝgha pang ahu yighǝn weerǝnda ten kwarha hai ranǝn ahu feera. Tǝrgha kwatǝranggǝn feera ɓa na manggǝn, nggǝlanggǝn mii tenkwadɗa sǝ wiigha. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Nda Mairamu Magdaliya tǝ tahad Mairamu ɗi kanda tsǝtsau a mii ten kwadɗi kanda a naghǝn.<verse eid="MAT 27:61" /></para>
  <para style="s">Fa ƙǝla tenkwadɗa ha</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Ɗathna mbǝrha hai a far yiɓǝd Yahudaya, Mamnda firistaya tǝ farisaya ɗǝnda thlǝmad Mbilatus ɗǝ. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Ndang ngganda, “Alvari, ɗal ɗan teena hai aten ˈya ndaana tǝnggaɓad ɗi ndǝghǝn ɓalɗǝ tǝ yibrha, ‘A kwasamad ɓeena mahan nǝn a thliirha sǝ ahu mǝrra.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Nanǝn kee furu kwamana a ƙǝla ten kwadɗa ndaha yi ɓeena mahan. A mbǝ kee wa ɓana fatsahayighǝn ngaarang, ndangganda fiya thliinǝn sǝ ahu mǝrra.”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Ndangga Mbilatus kanda, “Harama sodjaya ƙǝla mbǝɗaha, ngga.”<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Nanǝn kee mǝlɗeng ngganda ten kwadɗi, sǝ sodjaya nda sǝ na ƙǝlaghǝn ha.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Thlid Yeeso sǝ ahu mǝrra</para>
  <para style="r">(<ref loc="MRK 16:1-8">Markus16:1-8</ref>; <ref loc="LUK 24:1-12">Luka24:1-12</ref>; <ref loc="JHN 20:1-10">Yahaya20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />A kwasamad far yiɓǝd Yahudaya, a tsar ƙǝrǝt a far ladi Mairamu magdaliya tǝ tahad Mairamu wii nda ka ƙǝlang tenkwadɗa ɗǝ. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Kula sǝndǝndan sǝ rǝbgha hweeɗe fa kaan, ƙǝsǝr tǝthlǝnda Faara tǝrgha hai a talara, kwatǝranggǝn ferɗi a man patu ɗǝ, tsauka a tenggǝn. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Nagha pǝmnggǝn a chimnda fa ƙǝla yan fara, lukkighǝn ƙǝm pǝpet ƙǝla humba kaɓarha. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Tǝrǝmngga nafini na a ƙǝla ten kwadɗa ha, nagha fandan a rǝbrha fa, muwa nda hweeɗe hai, shiwit kanda nǝn in.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Tǝrgha kalangga tǝthlǝndǝ ɗi nishyina sǝ, ndǝghǝn, “Ma tǝrǝm ɗun wa sǝnɗisǝ nun a kaɗa Yeeso, tawang nanda ɗǝ. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Mbǝ a mbǝɗiya wa, thliiɗa sǝ ahu mǝrra, ƙǝla ndaanǝn nǝn a katǝrarha hai. Ɓamaɓa, ɓun na mbǝɗi huna nǝn sahai. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Nanǝnya, weema ƙǝkar ɗun thlǝghanggǝn fatsahayighǝn tǝ ndaarha thliiɗasǝ ahu mǝrra, nǝn a mbed nun ɗǝnǝn Nggalili ɗǝ. Ɗǝnun naghǝn a mbǝɗi. Ɗalama teena hai tǝ ˈya ndang ni kun.”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Ɗagha nishyini ƙǝkar ma ten kwadɗi, tǝrǝm nda kaan amma naa nda lǝlǝgɗa tǝ wutsǝfayirha fa, nagha pǝr laɓarɗi a kukwasang kanda fa pǝrang na tǝthlǝndǝɗi kanda a fatsahayighǝn. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Ɓa Yeeso wal kanda, ndang ˈya nǝn kanda. Ɓa nda thlǝmadghǝn ɓa, fǝb saryighǝn nda fa, manangganda thlǝmnggǝn. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Tǝrgha ndangga Yeeso kanda, “Ma tǝrǝm ɗun wa, ɗama ɗǝ ndanggun wanmanggina ɓanda a Nggalili ɓa, ɓana nda na nggi a mbǝɗi.”<verse eid="MAT 28:10" /></para>
  <para style="s">ˈYa thlǝkna fa ƙǝla ten kwadɗa ha</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Nana nishyini a ten kwamana, fingya fa kǝla mbǝɗaha ɗǝnda ahur wupǝri ɗǝ thlǝghang ǝnɗa nda mamnda firistaya ǝnɗi katǝragha hai heu. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Aah shingya nda wuma nda hai, ƙǝnangganda hai na nda a fǝrang wuɗǝɓǝla kanda manggǝn. <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />“Ndang ngganda sodja yini, ‘A ndaama, fa tsahaya Yeeso ɓagha ɓa a fǝɗikrha nanan a ɓeena, ngaarang ngganda mǝrrǝghǝn.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />A sǝk ngwamna laɓarɗiya, kan ƙǝm nan a isha a mbed nun, amanun sǝsarha.”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Tǝrgha sodja yini ƙǝm thlǝ wuɗǝɓǝlɗa nda ǝna nda ƙǝla saghang nanda kanda. Ɗǝgha laɓar ɗaɗǝ inggun ahur Yahudaya, ɓagha ta weeri ɗaɓa ya.<verse eid="MAT 28:15" /></para>
  <para style="s">Taara fǝrang na Yeeso fatsahayighǝn</para>
  <para style="r">(<ref loc="MRK 16:14-18">Markus16:14-18</ref>; <ref loc="LUK 24:36-49">Luka24:36-49</ref>; <ref loc="JHN 20:19-23">Yahaya20:19-23</ref>; <ref loc="ACT 1:6-8">Tar fathlǝngya1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Tǝrgha fatsahayini kumkap tal ɗǝnda Nggalili ɗǝ, tǝra nda wumnda sǝ ndangna Yeeso kanda.<note caller="+" style="f"><char style="fr" closed="false">28:16 </char><char style="ft" closed="false">Matta 26:32; Markus 14:28</char></note> <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Nana ndan manang ngganda thlǝmnggǝn, amma fingya sǝ ngalgha ndǝn. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Ɓagha Yeeso ɓa ndanggǝn fatsahayighǝn, “Fǝreenda sǝsǝmnggit talara tǝ yi hweeɗe heu. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Tsaunǝn kee ɗaama ɗǝ, ɗun tsahang fiya ha heu, ǝnang mbaptisǝma nun kanda, hu thlǝm Pǝpa tǝ yi Wee, tǝ yi Sǝsǝna tǝ Peɗǝnda.<note caller="+" style="f"><char style="fr" closed="false">28:19 </char><char style="ft" closed="false">Tar Fathlǝngya 1:8</char></note> <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Tsahaman kanda ha a ǝna taara nda tǝ ǝngya heu ndang ni kun. A sǝnunsǝ niyi tǝ kun ƙǝtsar ta mii ngwala ƙǝshiirha ɗǝ.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>