<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Hona Bible</book>
  <para style="h">Nggalatiyaya</para>
  <para style="toc3">Nggalatiyaya</para>
  <para style="toc2">Nggalatiyaya</para>
  <para style="toc1">Nggalatiyaya</para>
  <para style="mt1">Nggalatiyaya</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="s">Ɗeleewar Mbulus chireethleng nǝn Nggalatiyaya ɗǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Kyagha ɗeleewar ɗaɓa ya a har Mbulus, tǝthlǝnda Yeeso Ƙǝrǝsti, mbǝ nafiya nduwa niifa aagha nggi wa, amma Yeeso Ƙǝrǝsti tǝ Faara na Chinɗi, thlengga Yeeso sǝ ahu mǝrra. <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />Shayina na heu na a thlǝmanna kanda a ndang ˈya fatakkwaya ƙǝngya hwan Faara fa na a Nggalatiya. <verse eid="GAL 1:2" /><verse number="3" style="v" sid="GAL 1:3" />A tsauka nggayirha tǝ ɗǝɗemnggirha yi Faara na Chinɗi tǝ Chinǝm Yeeso Ƙǝrǝsti tǝ kun. <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />Ndǝghǝnni fǝrgha yiɓǝdghǝn ka ɗimiyid nǝm a hǝrghanggǝn kǝm ahu ƙǝshiid mbǝlfedɗi nanǝm sǝ ya, kǝla sakhna Faara na Chinɗi. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />Fǝraman mamnggirha Faara pakwanɗǝ. Atsaukake.<verse eid="GAL 1:5" /></para>
  <para style="s">Laɓara na Mbǝnggǝn tal ni</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Ƙǝs ǝnwulteena nggi. A hu ɓǝngya ngguchit na minnun sǝ a malanggun Faara wurgha kun tǝ nggayid Ƙǝrǝsti ƙǝkar. Tǝrgha minnun kyaharra hu weerinda “Laɓara ɗǝ na Mbǝnggǝn” pak. <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />Amma ƙǝkafek mbǝ “Laɓara sǝ na Mbǝnggǝn” pak wa, amma na nafiya sǝ na a tsang teena kun na mindan sǝ a mbeɗeng ngganda ƙǝkafekkid Laɓara hai na Mbǝnggǝn yi Ƙǝrǝsti. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Amma ko ƙǝmni, nduwa tǝthlǝnda Faara a talara hai, a pǝrang laɓar Faara kun pak ma yanɗiya, na Faara a shiwang nda. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Ƙǝla ˈwa nan teena pǝr ɗan ndǝn ƙǝtǝm, niya nggǝr pǝranggǝn kun, a pǝrang niifa laɓara kun pak ma yanɗi pǝrang nan kun ya, na Faara a shiwang nda. <verse eid="GAL 1:9" /><verse number="10" style="v" sid="GAL 1:10" />Nana minnasǝ a thlǝgha fiya nggi fa wa, nduwa Faara wa? Nduwa tamnggun ndaarha nana minna sǝ a thlǝk ˈya ni na a mbǝnanggǝn fiya wa? Awo, andam niyi a thlǝk ˈya na a mbǝnanggǝn fiya kee, kam tsauki mafad Ƙǝrǝsti wa.<verse eid="GAL 1:10" /></para>
  <para style="s">Wurna Faara Mbulus</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Shayina, na minna sǝ a sǝnunsǝ, laɓarɗi na Mbǝnggǝn pǝr ni kyawa ɓa a mii niifa wa. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Mbǝ a har niifa thlǝni laɓarɗiya wa, tǝ ƙǝm mbǝ niifa ni tsahegha ndǝn ha wa, Yeeso Ƙǝrǝsti tǝ altenggǝn keɗeegha ndǝn. <verse eid="GAL 1:12" /><verse number="13" style="v" sid="GAL 1:13" />Sǝk ɗun tur tsawud na kaar tam ni a takkwa Yahudaya, sǝsang ni fatakkwaya Faara, har na minna sǝ na a ɓǝlanggi kanda.<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">Tar Fathlǝngya Yeeso 8:3; 22:4-5; 26:9-11 </char></note> <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />Sǝnɗunsǝ kal ɗi fingya shayina tsǝnan sǝ hu takkwa Yahudaya aten sǝrǝk ǝntin chichiyi nǝm. <verse eid="GAL 1:14" /><verse number="15" style="v" sid="GAL 1:15" />Amma Faara tǝ nggǝm ndǝghǝn wurghǝn nggi kapa na nda nggǝt nggi, aah ɗǝ nggi hu nggayidghǝn, tǝkɗǝ mbǝnda fa <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />keɗee Wanggǝn tǝni pǝr laɓara atenggǝn a pathlang nafiya mbuwa Yahudaya. Katǝra nǝn hai kee, tsahanggi mee niifa wa. <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />Ɗǝwi Urshalima ɗǝ a thlǝmad fathlǝngya ɗǝ ˈwagha ma nggi wa, amma ƙǝs kwamana ni a chehweed Arabiya ɗǝ, tsǝɓaku wuɗi a wupǝri Ndimaska ɓa. <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" />A kwasamad huraya mahan ndǝn ɗǝni a Urshalima ɗǝ, ɗi na Mbiturus. Tsawi tǝghǝn yi ɓengya kumkap tuf. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />Nawi fingya fathlǝngya wa ƙǝl Yakubu wanman Chinǝm. <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />Ənɗi chireelth ni ƙǝkafek ni, mbiyi a nggaɓarha wa, a mbed Faara thlǝkni ndǝn. <verse eid="GAL 1:20" /><verse number="21" style="v" sid="GAL 1:21" />A kwasamadghǝn wii ahu Chehweed Suriya ɗǝ tǝ Kelikiya. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />A sayidɗi fatakkwaya Yeeso na ahur Ƙǝn hwan Faara na a Yahudiya, sǝngwanda nggi tafan ndan wa. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />Sǝk fiya ndaarha, “Niifɗa ni tamngga sǝsang ƙǝm ya ndǝghǝnni na a thlǝk laɓar fǝrƙǝkafek na midghǝn ɓǝlang nda kaar.” <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Fal nda Faara ƙǝsǝr ka nggi.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">Fingya fathlǝngya Yeeso thlǝnda Mbulus fa</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />A kwasamad huraya kumkap faɗa nggǝryi wutta a Urshelima ɗǝ. Nggi tǝ Mbarnaɓa wudgha ɗǝ, tahang nggan Titus haɗǝ ƙǝm. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Ɗǝghi mbǝɗaɗǝ ƙǝsǝr Faara ndǝn keɗeegha ndǝn ahu sǝsǝna ˈya na midghǝn a ǝne. Sǝl ni a mbǝɗa ɗǝ tsawan hai tǝ shingya Ƙǝn Faara ɓǝɓee. Thlǝghang Laɓar ɗani kanda na Mbǝnggǝn yanɗi pǝrang ni fingya mbuwa Yahudaya. Na minna sǝ a sǝnisǝ naɗǝ pǝpǝla ɗan na tsaurha mere. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Pashid wiid na Titus, ko nanǝn tǝ Helenarha ni, mbǝ niifa sǝ ndangga tǝtani a thleng muwa nda wa. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />Thliigha laɓar ɗa sǝ ya ƙǝsǝr ka fingya shayinǝm fa nggaɓaya kyagha ɓa ɓǝɓee. Kyana nda ɓa ka sǝɓang ngganda wal alteena ɗǝ nanǝm tǝghǝn ahu Yeeso Ƙǝrǝsti, na mindan sǝ a tsawang ngganda ƙǝm mafaya. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />Amma nggǝmang ngwan kanda fa ko ngguchit wa, ƙǝsǝr na minnan sǝ a ƙǝs ƙǝkafekkid laɓar ɗa nan ha na mbǝnggǝn ya ka kun. <verse eid="GAL 2:5" /><verse number="6" style="v" sid="GAL 2:6" />Amma fingya kamngga a na nda mamngya, mbǝ ˈyasǝ djiɗegha tǝ wunni kanda wa. Mbǝ Faara a tattaha wa. A hur mamnggini mbǝ ˈyasǝ chik nanda aten laɓar na wa. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />A meyedghǝn, tǝr nda ndaarha fǝrena Faara taara na a pǝrang laɓar ɗa ni na mbǝnggǝn ya a fingya mbuwa Yahudaya, ƙǝla fǝrang nǝn taara Mbiturus a pǝr laɓara nǝn na mbǝnggǝn a Yahudaya. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />Ƙǝsǝr Faar ɗani ǝnagha taara ahur Mbiturus ƙǝsǝr a tsauka tǝ thlǝnda Yeeso a Yahudaya, ndǝghǝn ǝnagha taara ƙǝm ahur na a tsawi tǝthlǝnda Yeeso a nafiya mbuwa Yahudaya. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />Nda Siman Mbiturus, tǝ Yakubu, tǝ Yahaya kandani sǝnna nda fǝrang nanda mamnggid fatakkwaya kanda, thlǝ kanda fa kan tǝ Mbarnaɓa tǝ hura tǝtal. Nggǝm ɗan fa a ɗan thlǝghang laɓara Faara fingya mbuwa Yahudaya, kanda ƙǝm ɗǝnda a thlǝmad Yahudaya ɗǝ. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />Ndangga nda kan a nan naarha ɗal fa yamiiya in kee, nggi ƙǝm ǝnɗa ni na mina a ǝnee ya ka ƙǝtǝm.<verse eid="GAL 2:10" /></para>
  <para style="s">Yanang Mbulus Mbiturus a Antakiya.</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Ɓana Mbiturus a Antakiya ɓa, tǝrgha yanang ɗi hu yidghǝn sǝ, ƙǝsǝr ka ˈya ǝnanǝn mbuwa ngga. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Kapa na fingya yini thlǝnna Yakubu kanda sǝla ɓa, na Mbiturus yakh hǝb ǝnnarhami tǝ fingya mbuwa Yahudaya fǝrgha ƙǝkafek. Amma a kwasamadɗi sǝlna nafina ɓa, tǝrgha kyanggǝn fadghǝn mu nggǝrwa hǝb ǝnnarhami tǝ fingya yini mbuwa Yahudaya wa, ƙǝsǝr nǝghǝn a tǝrǝm nafiyini na mindansǝ a thleng muwa nda nafiya mbuwa Yahudaya. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Nanǝn kee, fingya Yahudaya na Ƙǝrǝstaya takkwanda thlǝrɓuyid Mbiturus, tsang teena nda Mbarnaɓa kyangganda hu thlǝrɓuyid ndan hai. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />Amma ƙǝla ni hai mba nda a takkwa ƙǝkafekkid laɓar Faara wa, ndanggi Mbiturus a mbed ndan heu, “Tsaunǝn tǝ Yahudarha ni sa, malangga takkwa ngyakhkya Yahudaya tsawana ƙǝla nafiya mbuwa Yahudaya. Kama ƙǝm na a kyang nafiya mbuwa Yahudaya ahu ǝntin Yahudaya hai?”<verse eid="GAL 2:14" /></para>
  <para style="s">Hǝrghang nda Yahudaya tǝ fingya mbuwa Yahudaya</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />“Ƙǝm kyab Yahudaya nggǝtgha ƙǝm, mbǝ fa ɗimiya ƙǝla nafiya mbuwa Yahudaya wa. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />Tǝkee, sǝnɗǝm sǝ mbǝ niifa narha chahal a mbed Faara ka nanǝn a takkwa ɗeleewar ngyakhrha Musa wa, amma ƙǝl fǝrƙǝkafek a Yeeso Ƙǝrǝsti. Nanǝn kee, ƙǝm ƙǝmɗa fǝr ɗǝm ƙǝkafek a Yeeso Ƙǝrǝsti nǝm a naarha chahal hu Ƙǝrǝsti mbǝ takkwa ngyakhrha wa, ƙǝsǝr a naɗǝm a ǝna taara tǝ ngyakhrha mbǝ niifa sǝ na naarha chahal a mbed Faara wa. <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />Ana min nǝm sǝ tsawum chahal a mbed Faara hu fǝrƙǝkafek tǝ Ƙǝrǝsti, ɓa nda wal ƙǝm tǝ ɗimiyirha ƙǝsǝr ka malang nǝm takkwa ngyakhrha. Kyad nǝn ndarha kyang na Ƙǝrǝsti ƙǝm hu ɗimiyirha wa? Awo, ko ngguchit.” <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />“A naɗi a nggǝr tǝnang nda ǝngya chang ni hai kaar, tsauɗi tǝ ɗimiyirha. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Ƙǝsǝr ka tsahad ngyakhrha Musa tsauɗi mǝmǝra aten ngyahadɗi, malang ɗi ǝna taara tǝ ˈya na midghǝn tǝni tsaurha yi Faara. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />Tawang nda suhurra fadna ɗǝ tǝ Ƙǝrǝsti. Nanǝnya mbǝ nggini tǝ tsaurha wa, amma Ƙǝrǝsti ni na tǝ tsaurha ahur na. Nanǝn kee, tsawudɗi nani sǝ tǝghǝn yi farha yi ƙǝshidɗiya fǝr ni ƙǝkafek tǝ Wan Faara, nggǝmngga nggi, fǝr nǝn altenggǝn ka nggi. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Kalwi ƙǝshiɓu tǝ nggayid Faara fa wa, ƙǝsǝr ana ɗǝm a wal nggayirha hu ngyakhrha, tsauɗǝ mǝrgha Yeeso ka kee.”<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">Takkwa Ngyakhrha nduwa fǝrƙǝkafek a Yeeso wa.</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Kun nurya Nggalatiyaya, wun mbǝlfeegha kun? Kyaɗang ɗi ndǝn kun a pǝpal mǝrra Yeeso Ƙǝrǝsti aten kaɗiirha. <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Nanǝnya na minna sǝ a tsahang mee ni kun tǝtal kee. Thlǝnun Sǝsǝn Faara ka laɓar ngyakhrha Musa wa, nduwa fǝr nun ƙǝkafek ka laɓara sǝk nun aten Ƙǝrǝsti wa? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Tur nuryid mani ǝna nun ya? Katǝrang nggun tsawun nun hai hu Sǝsǝn Faara, amma kama na minnun sǝ ngwalang nda hu tar thlu farha? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />Sǝsan nun aten ǝngya hangga tsauɗǝ ka kee wa? Ƙǝkafek ni tsauɗǝ ka kee wa? <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Niya nggǝr tsahang mee kun ha, fǝrang na Faara sǝsǝn nggǝn kun, ǝna ǝnwultengya nǝn ahur nun, ƙǝsǝr ka nanun a takkwa ngyakrha wa, nduwa ƙǝsǝr ka fǝr nu ƙǝkafek tǝ laɓara sǝknun aten Ƙǝrǝsti wa? <verse eid="GAL 3:5" /><verse number="6" style="v" sid="GAL 3:6" />Ƙǝlaman Ibrahim, “Fǝrɗǝ ƙǝkafek tǝ Faara, ndǝn thlǝɗang na Faara ahu tar nggayidghǝn hai.” <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />A sǝnunsǝ, nafiya fǝrgha ƙǝkafek a Faara tsau nda wangya Ibrahim. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Laɓar Faara na chichirethlee hai ka ƙǝtǝm kyadɗǝ ndaarha fingya mbuwa Yahudaya, na Faara thlǝ kanda fa ƙǝsǝr ka fǝrƙǝkafekkid ndan. Ndǝn pǝrang na Faara laɓara Ibrahim na mbǝnggǝn tǝ ndarha, “Na fiya heu a wal parka hai a fadwa”. <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Nanǝn kee, fingya fǝrgha ƙǝkafek tǝ Ƙǝrǝsti na nda a wal parka heu nda Ibrahim, ƙǝsǝr ka fǝrƙǝkafekkidghǝn. <verse eid="GAL 3:9" /><verse number="10" style="v" sid="GAL 3:10" />Amma kala nafiya mbǝrsagha tǝ ngyakhrha shiwang nda kanda. Ƙǝsǝr nǝghǝn chichireethlee hai tǝ ndaarha, “Kala niifa ǝnawa taara tǝ ˈya na ahu ngyakhrha Musa heu shiwang nda.” <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />Nanǝnya nǝghǝn a pǝpal tǝ ndarha mbǝ niifa wal nggayirha a naɗǝ a takkwa ngyakrha Musa wa, ƙǝsǝr ndagha ɗeleewar Faara, “Kala niifa natǝ nggayirha fa, nǝn a wal hǝrǝkrha a fǝrɗǝ ƙǝkafek tǝ Faara.” <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Kwaman fǝrƙǝkafek nǝghǝn pak ma takkwa ngyakhrha, ƙǝla ndanǝn, “Kala niifa ǝnagha taara tǝ ˈya ndana ngyakhrha nǝn wal yibrha.”<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Livitikus 18:5 </char></note> <verse eid="GAL 3:12" /><verse number="13" style="v" sid="GAL 3:13" />Amma nanǝnya Ƙǝrǝsti pǝl ɗǝ ƙǝm ama shiwid takkwa ngyakrha, tǝrang ɗǝ ɗimiyid nǝm ɗǝ, a kwasamadɗi tawang na nda ɗǝ a ten kaɗiirha, ƙǝsǝr nǝghǝn chichirethlee hai tǝ ndaarha, “Kala niifa waghang nanda ɗǝ a urad ɗǝfrha shiwang nda a mbed Faara.” <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />Ahu Ƙǝrǝsti Yeeso ni, fǝrangna Faara parka a nafiya mbuwa Yahudaya tǝ tur parka fǝrang nǝn Ibrahim, ƙǝm na fa fǝrƙǝkafekkya, hu ƙǝkafek tǝnǝm wal Sǝsǝna tǝ Peɗǝnda ɗǝfna Faara miighǝn.<verse eid="GAL 3:14" /></para>
  <para style="s">ˈYa ndǝghang ngga pathlang nda Ngyakhrha hai tǝ ɗǝf mii Faara</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Shayina, niya fǝrang ǝnsakhrha kun aten ǝngya sǝsǝn nun sahai, ana nafiya sǝ sǝri ƙǝnangga ˈya hai tǝƙǝm nggǝm nda fa a tsauka kee, mbǝ niifa sǝ na mbeɗeng hai wa nduwa fahwanggǝn ɗǝ wa. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Faara ɗǝf ɗǝ miighǝn tǝ Ibrahim a chichiyighǝn. Ndawa Ɗeleewar Faara, “Chichiya wa,” a fiya hangga, amma “Chichidwa,” tal ni kee. Chichidɗiya Ƙǝrǝsti ni. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />ˈYa niya ndaarha, ɗǝf Faara mee tǝ Ibrahim tǝƙǝm tsauɗǝ kee. Ɓagha nda ɓa tǝ ngyahad Musa akwasamad huraya 430, mbǝ mbang mbeɗeng nda ɗǝfmiɗi ǝnana Faara ƙǝtǝm wa.<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Kyarhaɓa 1240</char></note> <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Andam tsauɗǝ ǝna taara nǝm tǝ ngyahad Musa tǝnǝm wal parkaya Faara, kam parka yini ya mbǝ ɓarha thlǝmad nǝm ɓa ƙǝsǝr ɗǝfmi Faara wa. Amma Ibrahim aten ɗǝfmi Faara ni wal nǝn parka. <verse eid="GAL 3:18" /><verse number="19" style="v" sid="GAL 3:19" />Ana ɗǝ kee, ƙǝn ɓana nda ɓa tǝ tsahad ngyakhrha Musa? Chik na ndan tǝ tsahadɗa ha ya ka a kyad ɗimiyid fiya nǝn a pǝpal. Ɓana nda ɓa tǝghǝn a kyat ndarha nǝn na nda a ǝna taara sǝ ta farɗaɗǝ na chichiya Ibrahim a ɓarhaɓa, nanǝn ndǝghǝn ni ɗǝfna nda miiɗi atenggǝn. Fathlǝngya Faara ndǝn fǝrgha ngyahadɗi ya, a har niifa hai na a pathlang nda niifa tǝ Faara. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Nanǝnya tǝ tsaurha a pathlang nǝm nǝn thlaara ana fiya hangga a ƙǝnang pathla hai. Amma Faara na tal ǝnawa taara tǝ tǝtsaurha a pathlanga, a sayidɗi ɗǝf nǝn mee a Ibrahim wa.<verse eid="GAL 3:20" /></para>
  <para style="s">ˈYa na mid Faara a tsauka Ɗeleewar Ngyakhrha</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />Na ngyakhrha ǝna tǝsaryirha tǝ ɗǝfmi Faara wa? Awo, sam mbǝ kewa! Ƙǝsǝr andam na ngyahadɗi fǝr weerinda yibrha, kam nǝm wal nggayirha hu ngyakhrha. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Amma ndagha ɗeleewar Faara, ƙǝshiirha heu na nda a kamu sǝsǝmnda ɗimiyirha, nanǝn thlǝɗǝm ɗǝfmi Faara yi hǝrǝkrha hu fǝrƙǝkafek tǝ Yeeso Ƙǝrǝsti. <verse eid="GAL 3:22" /><verse number="23" style="v" sid="GAL 3:23" />Amma kapa na sayid fǝrƙǝkafek ɓarhaɓa, ngyahadɗi ya ƙǝnang ɗǝ ƙǝm ƙǝla porsǝnaya, ƙǝl sayidɗi na fǝrƙǝkafek a kyarhaɓa. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Nanǝn kee, ngyakrha ƙǝlagha ƙǝm ha kapa na Ƙǝrǝsti ɓarhaɓa, ndǝghǝn lafgha ƙǝm tǝnǝm tsaurha tǝ nggayirha a mbed Faara hu fǝrƙǝkafek. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Nanǝnya ɓana fǝrƙǝkafek ɓa, mbǝ ngyakrha ni a ƙǝla ƙǝm ha ɓalwa. <verse eid="GAL 3:25" /><verse number="26" style="v" sid="GAL 3:26" />Nanǝnya tsauɗun ka wangya Faara ƙǝsǝr ka fǝrƙǝkafekkid nun hu Yeeso Ƙǝrǝsti. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />Ƙǝsǝr kun heu ǝnang nanda mbaptisǝma kun hu Yeeso Ƙǝrǝsti tsauɗǝ kalɗun Yeeso Ƙǝrǝsti fa. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Ɓalwa aarha sǝ tǝ Yahudarha nduwa fingya mbuwa Yahudaya wa, mafarha nduwa niifa mbuwa mafarha wa, hǝshnefa tǝ nuneefa wa. Nanǝnya kun heu nuwun tal hu Yeeso Ƙǝrǝsti. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />A tsauɗun yi Ƙǝrǝsti, tsauɗun ka wangya Ibrahim. Nun a har langad ǝnɗi ɗǝfna Faara miighǝn aten Ibrahim.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Niyi a ndaarha, tǝ har langaarha a ɓalɗǝ wundakhne, kalwa mafarha wa, ko nanǝn ǝngya heu na ahur wuri ɗi yighǝn ni. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Nǝn narha ahar niifa ƙǝrang ngga sǝ ta far ɗaɗǝ ɗǝfna chin miighǝn. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />Nǝghǝn kee ƙǝm tǝ ƙǝm kapa nǝm sǝn kwaman Ƙǝrǝsti, nǝghǝm ƙǝla wundakhnaya, mafaya ni ƙǝm hu sǝsǝmngya sǝsǝn ƙǝshidɗiya. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />Amma a sayidɗi ɓana farɗa ɓa, tǝrgha thlǝnanggǝn wanggǝn ɓa nggǝtna nuneefa, nggǝtna nda kamu ngyakhrha Musa. <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />Ka a hǝrghanggǝn fingya na a kamu ngyakhrha tǝnǝn tsang ƙǝm wangya Faara. <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />Nanǝnya tsau nǝm wanggighǝn, ndǝghǝn ni thlǝnang na Faara Sǝsǝn wanggǝn ahur nǝm hai. Sǝsǝn ɗiya aaghǝn Faara, “Abba, Pǝpa.” <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Nanǝn kee, ɓal wa mafarha ni sa wa, amma wan Faara. Tsaunǝn wee ni sa yi Faara, tsawod Faara tǝ har langadghǝn.<verse eid="GAL 4:7" /></para>
  <para style="s">Ɓillad Mbulus kaan aten Nggalatiyaya</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Kaar, sǝngwa nun Faara, nun naarha tǝrang shilee ɗahaya in tǝƙǝm tsawun mafaya a fingya ǝngya mbuwa faarya. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Amma nanǝnya sǝnɗun Faara, nduwa ndam ƙǝm sǝn Faara kun, kama nda nun nggǝr wutta ahu sǝsǝmnda sǝsǝngya ƙǝshiirha ɗǝ mbuwa tǝ shembe? Kama nun nggǝr tsaurha mafaya a ndǝghǝn faɗǝn? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Nun ƙǝs ɓengya ha, tǝ ndǝriya tǝ sayi tǝ huraya. <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Niyi a tǝrǝmnda ka kun. Tsauɗǝ sǝsanna mere ni sani fa ka kun. <verse eid="GAL 4:11" /><verse number="12" style="v" sid="GAL 4:12" />Niya hwan kun shayina, tsawama ƙǝla nggi, ƙǝsǝr nggi tsauɗi ƙǝla kun, mbǝ ˈyasǝ ˈwanun ǝne fa mbuwa ngga wa. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Sǝnɗunsǝ sayidɗi nana fadna ɓee, ndǝn pǝrang ni laɓara kun na mbǝnggǝn a katǝra ɓad na ɓa. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Ko nanǝn ɓeerha fadɗi kyana ɓilla ɗǝ kun fa kaan, malee wun nduwa kar nggi nun fa wa. A meyedghǝn thlǝɗun nggi fa ƙǝla tǝthlǝnda Faara a talara hai, nduwa Yeeso Ƙǝrǝsti fa tafadghǝn. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Tǝk ɗun mbǝnda fa kaan a farɗi! Nanǝnya, ai wutsǝfayidɗi ǝna nun ka nggi? Sǝnɗisǝ a farɗi anaɗǝ a ǝnaarha hai kam ƙǝɗang ɗun yiyi nun hai fǝree ƙǝnun. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Tsauɗi tǝsar nun ƙǝsǝr thlǝghang ni ƙǝkafek kun wa? <verse eid="GAL 4:16" /><verse number="17" style="v" sid="GAL 4:17" />Nafiniya ƙǝs nda kun ha ngga, amma mbǝ hu kwamana na ngga wa. Mbǝ mid ndan sǝ a wum teena nun tǝ nggi wa tǝnǝn naarha kala ˈya heu non naarha ɗǝrha thlǝman ndan ɗǝ. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Ana niifasǝ na midghǝn sǝ a ǝnang ˈya nǝn kun na ngga nǝghǝn ngga; malaman kanda ǝnaghǝn nda ƙǝtsar, mbǝ ƙǝl nani a thlǝmad nun wa. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />Kun wanggina, katǝra sǝri ni nanǝnya niya tǝk hatta nggǝtǝnun fa, tǝ ƙǝm niya ɗǝrha mbeeɗǝ tǝ tur sǝsadɗiya ƙǝl ma tsau Ƙǝrǝsti ahur nun. <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />Andam kwang niyi a thlǝmad nun nanǝnya, kam niya kyakhrang uradna hai. Ƙǝkafek ɓillaɗi kaan ka kun.<verse eid="GAL 4:20" /></para>
  <para style="s">Karapu aten nda Hadjara tǝ Saratu</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Pǝremadghǝn, kun na minnun sǝ takkwa ngyakrha ɗeleewar Musa, sǝkkun ǝnɗi ndana ngyahadɗi wa? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Ƙǝsǝr nǝghǝn chichirethlee hai tǝ ndarha, wangya Ibrahim sǝri ni hǝshya, tal wee nggǝt na mafarha, tahadghǝn ƙǝm wan nuɗi na tǝ altenggǝn. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Wan mafad nuɗi, nggǝtgha ndan ƙǝla nanda nggǝt wundakhnaya. Amma tahad wanɗi na nggǝtna nuɗi na tǝ altenggǝn nggǝtgha ndan hu ɗǝfrha mii Faara. <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />Nishyini kyab ya tsau nda ǝn sakhrha aten ɗǝf mii Faara sǝri. Nuneefa yi tal, Hadjara, ndǝn tsauka wumnda Sǝnai thlǝna fiya ngyakhrha sǝ kyangga kanda hu mafayirha hai. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Nanǝnya Urshalima nǝghǝn ƙǝla wumnda Sǝnai ahu chehweed Arabiya, ƙǝsǝr ndǝghǝn tǝ wanggighǝn tsau nda mafaya hu ngyakhrha. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Amma tahad nuɗi, Saratu ndǝna ameyed Urshalima na a talara, nǝghǝn tǝ altenggǝn, tǝƙǝm manǝm ni. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Ƙǝsǝr nǝghǝn chichirethlee hai tǝ ndarha, “Əno wutsǝfayirha sa nuneefa na kwarenga mbuwa nggǝtta, tǝrang urad wa sǝ huhwana sa ˈwa wagha tǝk hatta ngǝtta fa, ƙǝsǝr wangya nuɗi malna chimadghǝn tsǝnda hangga, kal nda wangya nuɗi na chimadghǝn sǝ.” <verse eid="GAL 4:27" /><verse number="28" style="v" sid="GAL 4:28" />Nanǝnya shayina, kun ƙǝmɗa wangya ɗǝfmee ni ƙǝla Ishaku. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Ƙǝla nanǝn kaar wanɗi nggǝt nanda yi thlu farha thleng ɗǝ wanɗa fa nggǝt nanda tǝ sǝsǝmnda Sǝsǝn Faara. Ta weeriɓa ya nǝghǝn kee. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Amma ndagha laɓar Faara ƙǝn? “Rǝwu mafad nuɗiya tǝ wanggǝn, ƙǝsǝr mbǝ wan mafad nuɗi har langaarha kyab tǝ wan nuɗi mbuwa mafarha wa.” <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Nanǝn kee shayina, mbǝ wangya mafad nuɗa ni ƙǝm wa, amma wangya nuɗa ni mbuwa mafarha.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">Wal alteena hu Yeeso Ƙǝrǝsti</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Ƙǝsǝr Yeeso Ƙǝrǝsti ndǝn hǝrghangga ƙǝm tǝnǝm tǝk mbǝnda fa tǝ wal alten nǝm. Nanǝn kee, ishama tǝ kanglanggirha hu fǝrƙǝkafek. A nggǝm ɗun fa nggǝr wun tsaurha mafayirha hu ngyakhrha Musa wa. <verse eid="GAL 5:1" /><verse number="2" style="v" sid="GAL 5:2" />Kama thlǝmarha hai, nggi, Mbulus, niya ndang nda kun, a nggǝmɗun fa thleng muwa nda kun wa, tsauɗǝ mbǝ ˈya sǝ ɗang na Ƙǝrǝsti kun sǝ wa. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Niya nggǝr ndang nda kun, kala niifa nggǝmngga fa thleng muwa nda, tsauɗǝ tǝta ni takkwa ngyahad Musa nǝn. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Kunna na minnun a wal hǝrǝkrha nun a mbed Faara non a takkwa ngyakhrha ɗeleewar Musa, tsauɗǝ kyang ɗun alten nun sǝ hu takkwa Yeeso Ƙǝrǝsti, nuwun inggun ma nggayid Faara. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />Amma ƙǝm na hu Sǝsǝna nǝghǝn a kukwasang ƙǝm fa ka a thlǝ nggayid Faara nǝm tǝ fǝrƙǝkafek ɗǝf nǝn miighǝn. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />A naɗǝm a takkwa Yeeso Ƙǝrǝsti nda thleng nanda muwa ƙǝm nduwa thlengwa nda ƙǝm wa mbǝ ˈyasǝ ahurghǝn wa. ˈYa kamngga ndǝna fǝrƙǝkafek tǝ nggǝm ndan kee. <verse eid="GAL 5:6" /><verse number="7" style="v" sid="GAL 5:7" />A katǝradghǝn kun a ɗǝrha mbeeɗǝ kaan, wun ˈyaɗangga takkwa ƙǝkafek kun fa? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Huwudɗiya ɓawa ɓa a thlǝma Faara aagha kun wa. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Mekhna ngguchit nǝn safang nda mburodi. <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Mbǝrsaɗi tǝ Chinǝm ndǝn mbuwa nun sǝk mii niifa pak ma yina. Yanɗi na a ɓilla kun ya na nda ngwang kumarha sǝ, ko ndǝghǝnni wun. <verse eid="GAL 5:10" /><verse number="11" style="v" sid="GAL 5:11" />Shayina, andam ɓal yi a pǝr laɓar Faara aten thlee muwa, ƙǝla ndana fingya niyi a ǝnaarha, kama ɓalna nda a sǝseerha? Andam ɓalwi a pǝr laɓar hǝrǝkrha hu kaɗid Ƙǝrǝsti wa kam tsaukwi ǝn kii saara a fingya. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Niyi a ndaarha nafini na a ɓilla kun ya a nggushi tsau nanda firya. <verse eid="GAL 5:12" /><verse number="13" style="v" sid="GAL 5:13" />Shayina, aah nanda kun ka a wal alteena nun, amma a tsawang ɗun wal alten ɗi ya tsawun hu sǝsǝmnda ɗimiyirha wa. A meyedghǝn ngwa tsaukwa nggǝmnda ahur nun non a ǝnang taara ndan. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Ƙǝsǝr ngyakhrha Ɗeleewar Musa nǝghǝn aten laɓara tal, ndǝna, “Nggǝmu tuladwa ƙǝla alten wa.” <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Amma ana ɗun a ƙǝt ndan, kun a kii ndan. Kwarama, nun a ɓǝlang nda ndan.<verse eid="GAL 5:15" /></para>
  <para style="s">Sǝsǝn Faara tǝ yi thlu farha</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Nanǝn kee niya ndang nda kun ana Sǝsǝn Faara a laf kun, mbun ǝna tar thlu farha wa. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Ƙǝsǝr ˈya na mid thlu farha mbǝ ndǝna mid Sǝsǝn Faara wa, Sǝsǝn Faara ƙǝm mbǝ midghǝn sǝ ˈya na mid thlu farha wa. Kanda kyab na nda a yanda tǝ ndan, nanǝn kee, mbun mbang ǝna ˈya na minnun wa. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Amma ana Sǝsǝn Faara ni a ƙǝla kun ha, mbun nggǝr naarha a kamu ngyakhrha Musa wa. <verse eid="GAL 5:18" /><verse number="19" style="v" sid="GAL 5:19" />Tar thlu farha nǝghǝn a pǝpal, ɓereukirha, tǝ kulafayirha, tǝ suna ǝn ƙǝshiirha, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />tǝ takkwa ɗaharha, tǝ thlǝrǝfyirha, kar ndan fa, tǝ sǝrǝkkirha, tǝ sǝbrha hura, tǝ nggǝm alteena, tǝ ndǝkrha hai tǝ ndan. <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />Tǝ ƙǝs ndan hur, tǝ sa mbaala, tǝ fingya ǝngya, niya ƙǝs thlǝman nun ƙǝla ˈwani ǝnang nda kun kaar, tǝ ndarha nafiya na a ǝna tur ǝngginiya mba nda wal kutǝryid Faara wa. <verse eid="GAL 5:21" /><verse number="22" style="v" sid="GAL 5:22" />Amma ˈya na Sǝsǝn Faara ǝnaarha ndǝna, nggǝmnda, tǝ wutsǝfayirha, tǝ tsau ɗǝɗemnggirha, tǝ ƙǝrǝsta, tǝ hakkilo tǝ nggayirha, tǝ ƙǝkafekkirha. <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />Tǝ sammayirha, tǝ ƙǝs alteena, mbǝ ngyakhrha sǝ ˈyaɗagha ǝngginiya wa. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />Fingya na yi Yeeso Ƙǝrǝsti tawang nda ǝn thlu farha ɗǝ tǝ ǝn mbǝlfeeya heu aten kaɗiirha. Ɓalwanda nda a takkwa tur ǝngginiya wa. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />A tsau ɗǝm yi Sǝsǝn Faara, tama wiim hai ƙǝm tǝ Sǝsǝn ɗi. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Ana ɗǝm a taala wa. Ana ɗǝm a sǝɓang hur ndan ɗǝ wa. Ana ɗǝm a suna ǝn fiya wa.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">Ɗaman ndan sǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Shayina, a naɗun niifa kyaɗǝ hu tar ɗimiyirha hai, kun na tǝ Sǝsǝna tǝ Peɗǝnda wuɗaman hu kwamana ɓa na ngga. Amma ǝnamadghǝn tǝ sammayirha, ƙǝsǝr nun ɗǝ mukrha hu ƙǝƙǝrra hai ƙǝmɗa. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Ɗaman ndan sǝ, anaɗun a ɗang sǝ ahu ˈya kiya lǝɗang nun ngyahad Ƙǝrǝsti. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Ana niifa a numad ndaarha ka niifa manggǝn, amma mbǝ kewa, huk nǝn altenggǝn. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Kowunni ƙǝƙǝranggǝn targhǝn, a nagha a taala a tafadghǝn, mbǝ ƙǝl ƙǝƙǝrang nǝn altenggǝn tǝ shadghǝn wa. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Ƙǝsǝr kowunni nǝn a tǝr rǝfǝd altenggǝn. <verse eid="GAL 6:5" /><verse number="6" style="v" sid="GAL 6:6" />Kala niifa tsahang nanda laɓar Faara ha, nǝn ndǝghang ǝnggighǝn hai na ngga tǝ niifɗi tsahangga ha. <verse eid="GAL 6:6" /><verse number="7" style="v" sid="GAL 6:7" />A nggaɓa ɗun altennun wa. Ƙǝsǝr mba ndǝndǝlang nda Faara fa wa. Na niifa wumang ǝnnarhami ahu ˈya hǝf nǝn. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Ƙǝsǝr yanɗi hǝfgha yi thlu farha, nǝn a ɗang ahu mǝrra ɗǝ. Amma a hǝf ɗǝ yi Sǝsǝna tǝ Peɗǝnda nǝn a ɗang ahu yibrha ɗǝ mbuwa ngwalarha. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Nanǝn kee, a tǝkɗǝ ƙǝm tǝ ǝna ǝngya na ngga wa. Ƙǝsǝr a tǝkkwa ƙǝm mal ǝngya nǝm na ngga nanǝm a ǝnaarha wa, na sayi ɓayi ɓa nǝm halth yi parka. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Nanǝn kee, a wal ɗum kwamana, tama ɗanggǝm fiya sǝ heu, ƙǝla shayinǝm na hu Ƙǝrǝsta.<verse eid="GAL 6:10" /></para>
  <para style="s">Mii ngwala shawarid Mbulus</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />ƘƏLAMAN TUR CHIREELTH ƊI NA MƏMANGGƏN NIYA CHIREETHLENG KUN ƊƏ TƏ HARNA <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />Nafiyini na a taala tǝ alten ndan, kanda ni na a ngyaɓang thlee muwa kun fa na mindansǝ ana kanda nda ngga. Na nda a ǝnaarha kee ƙǝsǝr na nda a tǝrǝm sǝsadɗi na nda a kyarha sahai ƙǝsǝr ka kaɗid Yeeso. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Ko nafini thleng nanda muwa kanda, mba nda a takkwa ˈya ndaana ngyakhrha ɗeleewar Musa wa. Na mindan sǝ a thleng muwa nda kun tǝna nda narha taala tǝ ndaarha kanda kyangga kun hu thlee muwa hai. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />Amma nggi ƙǝm mbi tam taala tǝ altenna wa, ƙǝl aten kaɗid Chinǝm Yeeso Ƙǝrǝsti. Ƙǝsǝr sunanna heu tauɗa ɗǝ aten kaɗidɗi, Suna ǝn ƙǝshiirha heu ƙǝm mǝrɗǝ ahur na. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Mbǝ ˈya sǝ hu thleegha muwa nduwa niifa thlee wa muwa wa, ˈya kamangga kee a tsauka niifa weerǝnda nggǝtta. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Ngwa tsauka ɗǝɗemnggirha tǝ nggayid Faara tǝ fingya takkwagha ǝnɗi thlǝk ni ya, ƙǝmɗa aten ka nafiya Isǝreela yi Faara. <verse eid="GAL 6:16" /><verse number="17" style="v" sid="GAL 6:17" />A kwasamadghǝn, a nggǝr ɗun ɓilla nggi aten ǝnggini ɓal wa, ƙǝsǝr kwad wundǝyini na a fadna ya, kyadɗǝ ndarha mafad Yeeso ni nggi. <verse eid="GAL 6:17" /><verse number="18" style="v" sid="GAL 6:18" />Nggayid Chinǝm Yeeso Ƙǝrǝsti, a tsauka tǝ sǝsǝn nun, shayina. Atsaukake.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>