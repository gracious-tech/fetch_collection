<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Hona Bible</book>
  <para style="h">Afisaya</para>
  <para style="toc3">Afisaya</para>
  <para style="toc2">Afisaya</para>
  <para style="toc1">Afisaya</para>
  <para style="mt">Ɗeleewar Mbulus a Afisaya.</para>
  <para style="im">Ten laɓaara.</para>
  <para style="ip">Mbulus ndǝn chirethgha ɗeleewar ɗiya a sayidɗi nanǝn ahu porsǝna a Roma, asǝmha ahu hurarha kumggit mikki a kwasamad nggǝtta Yeeso. Thlǝnang na Mbulus ɗeleewar ɗiya a Afisaya ɗǝ tǝ numa ndaarha a ngwalang nda karatang nda, nggǝra nda thlǝnanggǝn fingya ɗǝ pak fatakkwaya.</para>
  <para style="ip">ˈYa na manggǝn ahu ɗeleewar ɗiya ndǝna kwamana ǝnana Faara na a wumanggǝn nafiya na ahu ƙǝshiirha hǝu a kamu ngyakhrha Yeeso Ƙǝrǝsti ɓa, mbǝ ma fiya kee wa, amma heu tǝ yibya heu ǝnana Faara a talara tǝ hweeɗe.</para>
  <para style="ip">Ɗeleewar ɗiya fǝrang ɗǝ kaali fiya na a tsawa nda ahu kwamana na a kyad ndaarha tsau nda tal yi ƙǝkafek, mbǝ ahu mee kee wa.</para>
  <para style="ip">Ahu ɗeleewar ɗiya katǝranggǝn tsǝ laɓaara hai aten wum teena, kyadɗǝ kwamana wurna Faara nafiyighǝn, kyaɗǝ ƙǝm nggayidghǝn hu kwaman chakh ɗimiyid ndan ǝnang nǝn kanda, kyang nǝn kanda sǝ ahu ngyakhrha ɗimiyirha ƙǝsǝr ka mǝrra Ƙǝrǝsti Yeeso, tǝ ɗǝf nǝn miighǝn hu tar Sǝsǝna tǝ Peɗǝnda.</para>
  <para style="ip">A hu ɗeleewar ɗiya na karapuya sǝ kyadgha wum ten nafiya Faara tǝ Ƙǝrǝsti. Saghang nda nafiya Ƙǝrǝsti tǝ fad niifa, Ƙǝrǝsti ƙǝm ndǝna teena. Saghang nda kanda sǝ tǝ wuronga, Ƙǝrǝsti ƙǝm ndǝna wutsamnda. Saghang nda kanda sǝ tǝ ɗǝf sar kǝnna na tsauka tǝ shembe. Ənana Faara ǝnɗiya ƙǝsǝr a tǝrang ngganda thlǝmnggǝn sǝ.</para>
  <para style="iot">Əngya na ahurghǝn</para>
  <para style="io1">Katǝra laɓara 1:1-2</para>
  <para style="io1">Tsaurha tǝ ndan tal hu Ƙǝrǝsti 1:3-3,21</para>
  <para style="io1">Kwamana na kyad ndaarha nǝghǝm tal 4:1-6,20</para>
  <para style="io1">Mii ngwala laɓaara 6:21-24</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="s">Ɗeleewar Mbulus chireethleng nǝn Afisaya ɗǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Kyagha ɗeleewar ɗaɓa ya a har Mbulus, wurna Faara ka a tsauka tǝthlǝnda Yeeso Ƙǝrǝsti. Niyi a chireethleng nafiya Faara ɗǝ na chahal a Afisa, nafiya na a ɗǝrha mbeeɗǝ tǝ fǝrƙǝkafek fa ahu Yeeso Ƙǝrǝsti. <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" />Ngwa tsauka nggayirha tǝ tsawud ɗǝɗemnggirha yi Faara na yinǝm China tǝ Chinǝm Yeeso Ƙǝrǝsti a tsauka tǝ kun.<verse eid="EPH 1:2" /></para>
  <para style="s">Parkaya yi Sǝsǝna ahu Ƙǝrǝsti</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Tsau faala yi Faara tǝ Chin Chinǝm Yeeso Ƙǝrǝsti. Fǝrangga parka ƙǝm a talara hai tǝ kala Sǝsǝn parka hu Ƙǝrǝsti. <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />Kapa nǝn ǝna ƙǝshiirha, nggǝm Faara kǝm wurɗǝ ƙǝm ahu Ƙǝrǝsti a tsawum chahal kula ǝn ˈyaara hu yidghǝn. <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />Faara ˈwaɗǝ teena ƙǝtǝm na a tsawum fa wurayighǝn tǝ wumang nda ƙǝm a thlǝmadghǝn ɓa tsawum wanggighǝn ahu Yeeso Ƙǝrǝsti. Ənɗani na midghǝn ya a ǝnagha, ka a mbǝnanggǝn kaan. <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />Nanǝn kee faala ma Faara ƙǝsǝr ka mamnggit nggayidghǝn fǝrang nǝn ƙǝm tǝka ahu Wanggǝn nggǝm nǝn. <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />Ƙǝsǝr ka far Ƙǝrǝsti ndǝn wal nǝm pǝla, ndǝna, chahang nda ɗimiyid nǝm ƙǝm ɗǝ. Ƙǝsǝr ka nggayidghǝn mulgha hai, <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />fǝrang nǝn ƙǝm hangga heu tǝ thladwayirha tǝ sǝnda. <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />Nanǝnya kyaɗang Faara sǝndǝghǝn ƙǝm na ɓǝɓee aten Ƙǝrǝsti, ˈya ǝnanǝn ka a lǝɗanggǝn ˈya na midghǝn ahu Ƙǝrǝsti. <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />A lǝghǝd sayi, na Faara a ǝna ǝngya heu na midghǝn, na Ƙǝrǝsti a wumang ǝngya heu na a talara tǝ na a hweeɗe nagha a harghǝn. <verse eid="EPH 1:10" /><verse number="11" style="v" sid="EPH 1:11" />Ƙǝsǝr ka nanǝm hu Ƙǝrǝsti, thlǝ ɗǝm langaarha a har Faara, ƙǝsǝr ƙǝtǝm ˈwaɗǝ teena wurɗǝ ƙǝm, tsanggǝn ǝngya ǝna nda ƙǝla na midghǝn ǝnaarha. <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />Taama ƙǝm Yahudaya ˈwagha shiteena tǝ Ƙǝrǝsti tama tsawum fal mamnggitghǝ nǝm. <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />Nanǝnya kun mbuwa Yahudaya sǝk ɗun laɓar ƙǝkafek ɗi ƙǝm, laɓarɗi na mbǝnggǝn yi hǝrǝkrha. A sayidɗi fǝr nun ƙǝkafek tǝ Ƙǝrǝsti, fǝrang Faara Sǝsǝna kun tǝ Peɗǝnda ƙǝla ɗǝf nǝn miighǝn ƙǝtǝm, tsauɗǝ ƙǝla ǝnsakhrha na kyat ndarha kun yighǝn ni. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />Sǝsǝn tǝ peɗǝnda ndǝn kyaɗangga ndarha ƙǝm ɗǝf Faara miighǝn a nafiyighǝn, ndǝn kyaɗangga ndaarha ƙǝm na Faara a fǝrang alteena fingya tsauka yighǝn. Taama fal mamnggitghǝn nǝm.<verse eid="EPH 1:14" /></para>
  <para style="s">Hwan Mbulus Faara ka nafiya Afisa</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Nanǝn kee, sǝk ni laɓar fǝrƙǝkafekkid nun fǝr nun a Chinǝm Yeeso, tǝ ƙǝm nggǝm ndǝnun a nafiya Faara na chahal, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />malanggwi usa Faara ka kun wa. Ni naarha hwan Faara ka kun ƙǝtsar, <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />hwan Faara ni Faara yi Chinǝm Yeeso Ƙǝrǝsti, tǝ Chinɗi na manggǝn, fǝrang Sǝsǝna nǝn kun yi thladwayirha tǝ sǝnda tǝnun chik sǝnggǝn ngga. <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />Niya hwan Faara a inanggǝn hur nun ɗǝ na kukwaryidghǝn nun, tǝnun sǝn tǝmani shiiten ɗi aah nǝn kun ka kamanggǝn, tǝ ƙǝm sǝn hangnda mamnggit parkayidghǝn ɗǝf nǝn miighǝn a nafiyighǝn na chahal. <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />Niya nggǝr hwanda ƙǝm tǝnun sǝn mamnggit sǝsǝmndǝghǝn kalgha mbǝrha mu, na a ǝna taara ahur nǝm, ƙǝm fǝrgha ƙǝkafek. Sǝsǝmndǝɗi na ǝna taara ahur nǝm, nǝghǝn tal tǝ mamnggit sǝsǝmndǝɗi. <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />Ndǝn ǝnagha taara ahu Ƙǝrǝsti a sayidɗi thleng nanda sǝ hu mǝrra, tǝ ƙǝmɗa fǝrang ɗǝ tsǝnggam tsaurha a yisǝmadghǝn a talara. <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />A mbǝɗa ni na Ƙǝrǝsti a ǝna kutǝryirha sǝ aten kutǝrya heu tǝ sǝsǝmnda, nduwa tǝ shembe tǝ kutǝryirha. Nǝghǝn tǝ thlǝma kalgha thlǝma mu heu na nda a fǝra, mbǝ hu ƙǝshiidɗi kee ya wa, ta hu ƙǝshiirha ɗǝ na ɓayi <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Faara ɗǝfang ɗǝ komani a kamu sar Ƙǝrǝsti, tsau ɗǝ teena yi kutǝryid ǝngya heu, ka a thlar Ƙǝn hwan Faara nǝn<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">Dzabura 8:7</char></note> <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />na fadghǝn, nǝghǝn lǝlǝgɗa hu Ƙǝrǝsti, ƙǝla nanǝn tǝ altenggǝn lǝɗang nǝn ǝngya heu.<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">Kolosiyaya 1:18</char></note><verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">Thliirha sǝ hu mǝra ahu yibrha ɗǝ tǝ Ƙǝrǝsti</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Ƙǝtǝm nuwun mǝmǝra hu sǝsǝna, ƙǝsǝr ka kar mii nun fa tǝ ɗimiyirha. <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />Takkwa ɗun kwaman ƙǝshidɗiya ǝna taara nun tǝ ˈya na mid ǝnkaheerha. Ndǝghǝn ni na a ǝna kutǝryirha hu ƙǝshiirha, tǝ ƙǝm na Sǝsǝnggǝn tǝ sǝsǝmnda fa aten kowunni mbuwa ǝna taara tǝ ˈya na mid Faara. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />Ƙǝm heu nǝghǝm kee ƙǝtǝm, ƙǝm a takkwa ˈya na mid thlu fad nǝm, nǝghǝm a takkwa ˈya na mid fad nǝm tǝ numad nǝm kee, hu kiya ƙǝsǝr ka ǝn ǝnad thlu farha, kǝm kaar ɓad sǝbrha hur Faara a tennǝm ɓa ƙǝla nanǝn aten fingya wangya ƙǝshidɗiya. <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />Amma na niifa haɗang Faara fa kaan, tǝ ƙǝm nggǝmndǝghǝn a ƙǝm mulɗahai, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />ko nanǝm mǝmǝra ka ɗimiyid nǝm, fǝrang yibrha nǝn ƙǝm sǝ heu tǝ Ƙǝrǝsti. (Ƙǝsǝr ka nggayid Faara ni hǝrghang nanda kun.) <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Thlenggǝn ƙǝm sǝ tǝ Ƙǝrǝsti Yeeso, fǝrang mbǝd tsaurha na ƙǝm a talara tǝghǝn. <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />Ənana Faara ǝnɗiya ƙǝsǝr ka ƙǝshiirha na ɓayi a kyad nggayid ghǝnǝn mbuwa nǝm mbang sakhƙǝn, naɗǝ ƙǝmhai tǝ nggayid ɗi keeghǝn kyaɗang nǝn ƙǝm hu Yeeso Ƙǝrǝsti. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Ƙǝsǝr ka nggayid Faara ni wal nun hǝrǝkrha hu fǝrƙǝkafek. Yanɗiya mbǝ ka ˈya ǝna nun yi alten nun ni wa, fǝrra Faara ni <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />mbǝ ka ǝna taara wa, naɗǝ niifa taala. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Ƙǝsǝr ƙǝm karid tar Faara ni, ǝnanǝn hu Yeeso Ƙǝrǝsti tǝnǝm ǝna taara na ngga, ˈwanǝn fǝrang ƙǝm ka ƙǝtǝm a ǝnam.<verse eid="EPH 2:10" /></para>
  <para style="s">Tama tsawum tal tǝ Yeeso Ƙǝrǝsti</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Tsaunǝn kee, ɗalama teena hai tǝ tsawud nǝn ƙǝtǝm kun mbuwa Yahudaya ni nggǝtgha kun aah nanda, “nafiya thleewa muwa” a mii fingya aagha fad ndan, “nafiya thleegha muwa” (kulo hai mbiya thlee mu ɗiya, yi thlu farha ni kee na nda ǝnaarha tǝ haara.) <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />Ɗalama teena hai a sayidɗi nanun ndǝndǝgha hai tǝ Yeeso, rongya ni kun mbuwun ahur nafini wurna Faara wa. Mbuwun ahur ɗǝf miiɗi wa, tsawud nun hu ƙǝshidɗiya mbuwun tǝ shiteena tǝ ƙǝm mbuwun tǝ Faara wa. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Amma nanǝnya nuwun hu Ƙǝrǝsti Yeeso, kun ƙǝtǝm nuwun inggun tǝ Faara, amma nanǝnya ɓanda ɓa tǝ kun tsau tǝ ndǝghǝn fa ahu far Ƙǝrǝsti. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />Ƙǝsǝr ƙǝrǝsti tafadghǝn ɓang ɗǝ tsawud ɗǝɗemnggirha ƙǝm ɓa. Wumang nǝn Yahudaya tǝ fingya mbuwa Yahudaya tsawa nda nafiya tal, hu farghǝn irang nǝn ɗǝ aten kaɗiirha, changgǝn kalman ɗa hai ndǝghangga kanda hai tsawangga kanda tǝsaryi. <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />Malanggǝn ǝna taara tǝ ngyakhkya Musa wumanggǝn Yahudaya tǝ fingya mbuwa Yahudaya tsawa nda nafiya tal. Ənanǝn ndǝn kee ka a tsawum hu ɗǝɗemnggirha. <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />Ənanǝn kee ƙǝm ka a tangsanggǝn pathlang ndan kyab tǝ Faara. A tsawa nda farha tal hu mǝrrǝghǝn a ten kaɗiirha. Ndǝghang ɗǝ kanda hai tǝ tsawud tǝsaryidɗi nana nda sǝ ƙǝtǝm. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Ɓa ɗaɓa tǝ pǝrang Laɓara kun na mbǝnggǝn yi tsawud ɗǝɗemnggirha, a kun mbuwa Yahudaya na inggun tǝ Faara, tǝ Yahudaya ƙǝm na tsau tǝ Faara fa. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />Ƙǝsǝr ka Ƙǝrǝsti ni ƙǝm kyab nǝm mbang ɗǝrha thlǝmad Pǝpa ɗǝ hu Sǝsǝna tal.<verse eid="EPH 2:18" /></para>
  <para style="s">Ƙǝn Faara yi Chinǝm</para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />Nanǝn kee, kun mbuwa Yahudaya, mbǝ rongya ni kun ɓalwa, kun nafiya ni na tǝ altendan heu tǝ nafiya Faara na chahal. Kun wangya wuraya na yi Faara. <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />Kun heu nuwun ƙǝla ƙǝnna tǝnna nda aten mbukhrha ƙǝnna hai ǝnana fathlǝngya Yeeso tǝ annabiya, Yeeso Ƙǝrǝsti tafadghǝn ndǝna fer sar tǝndǝɗi. <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />A hurghǝn ni Wumna tǝndǝɗi heu tsǝgha sǝ tsauka Ƙǝn Faara chahal yi Chinǝm. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />A hurghǝn ni ƙǝm tǝnna nda kun heu ka a tsawun a mbǝrha na Faara sǝ tǝ tsaurha tǝ Sǝsǝnggǝn.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">Pǝr Mbulus Laɓar Faara a nafiya mbuwa Yahudaya</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Tsaunǝn kee, nggi Mbulus wan porsǝna ka Ƙǝrǝsti Yeeso ka kun mbuwa Yahudaya. <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />Sǝnɗisǝ sǝkɗun laɓara aten nggayid Faara fǝree nǝn tar ɗiya ka a thlar kun ni, <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />ƙǝla ˈwani chireethleng ˈya hai keɗena Faara ǝnwulteena ǝnanǝn. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />A karatang ɗun ǝnɗi chireethleng ni hai, nun a walang ˈya sǝnni aten Ƙǝrǝsti. <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />Amma kaar ǝnɗi na ɓǝɓee ya pǝrangwandan fiya wa, ƙǝla pǝrang na Sǝsǝna tǝ Peɗǝnda fathlǝngya Faara tǝ annabiya na chahal, <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />ndǝna, pǝr laɓaara na Mbǝnggǝn yi Yeeso Ƙǝrǝsti, fingya mbuwa Yahudaya tsau nda fa har langaarha kǝla ƙǝm Yahudaya. Ƙǝm tǝ kanda tsau ɗǝm thlu farha tal. Kanda ƙǝm na nda wal yindan ƙǝnaghǝn ahu ɗǝfmi Faara a ƙǝm hu Yeeso Ƙǝrǝsti. <verse eid="EPH 3:6" /><verse number="7" style="v" sid="EPH 3:7" />Tsawed nda fa tǝta a ǝna tar pǝr laɓarɗa ni na mbǝnggǝn hu fǝrra nggayid Faara tǝ sǝsǝmndǝghǝn na a ǝna taara ahur na. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Ko nanǝn nggini ngguchit ahur nafiya Faara na chahal, nggini fǝree nanda nggayid ɗiya ka a pǝr laɓar ɗani ahur nafiya mbuwa Yahudaya aten Ƙǝrǝsti mbuwa nǝm mbang kirasang nda ƙǝnaghǝn. <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />Wurna nda nggi ka thlǝghang nggǝni fiya heu kwaman ɗi na ɓǝɓee ɓǝɓeng na Faara ka ƙǝtǝm, ǝnagha ǝngya heu. <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />Na midghǝn sǝ nanǝnya nafiya na hu Ƙǝn hwan Faara,a pǝr sǝnda Faara nda ɗǝɗamǝn-ɗǝɗamǝn a kutǝrya tǝ sǝsǝmnda ha a talara. <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />Ənɗa na midghǝn Faara ya ka ƙǝtǝm, lǝɗang ɗǝ ˈya na midghǝn hu Yeeso Ƙǝrǝsti Chinǝm. <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />Ƙǝsǝr ka fǝrƙǝkafekkid nǝm a ndǝghǝn, nanǝnya ndǝnǝm mbang ɗǝrha thlǝmad Faara ɗǝ kula hǝreenga. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Nanǝn kee, niya hwan kun, a mǝr fad nun hai ka sǝsadɗi niya sǝsarha fa ka kun ya wa, sǝsadɗiya ƙǝsǝr ka a manangganda kun.<verse eid="EPH 3:13" /></para>
  <para style="s">Hwan Faara ka nafiya Afisa</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Ƙǝsǝr ka kee niyi a ɓǝra hai tǝ waɗed na a mbed Chinɗi, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />ahurghǝn ni na fa wurayighǝn heu na a talara tǝ hweeɗe a wal ka thlǝm ndan sǝ. <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />Niyi a hwanggǝn a fǝrang mamnggit ƙǝnaghǝnǝn kun tǝnǝn fǝrang shembe nǝn tsawun tǝ sǝsǝmnda Sǝsǝnggǝn a hur nun, <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />tǝna Ƙǝrǝsti tsaurha ahur nun hu fǝrƙǝkafek. Niya hwan Faara a non kanglang, ƙǝmɗa non a tsǝrha hu nggǝm ndan <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />tǝnun wal sǝsǝmnda sǝnang nda hai, kun tǝ fingya na chahal heu, tǝnun sǝn hangnda nggǝmnda Kǝrǝsti, ndǝna kǝthlǝng ndǝghǝn tǝ nzanggidghǝn, tǝ kuɗimnggidghǝn. <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />Tǝ ƙǝm a sǝn nggǝmnda Ƙǝrǝsti nun, ko nanǝn mbǝm sǝnang hai heu wa, lǝgɗun ngga tǝ sǝnda Faara. <verse eid="EPH 3:19" /><verse number="20" style="v" sid="EPH 3:20" />Mamnggirha heu yi Faara ni, na sǝsǝmndǝghǝn a ǝna taara ahur nǝm, heu tǝ ǝngya mbangwa nǝm hwanda, nduwa numawa nǝm. <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />A tsauka mamnggirha tǝ Faara ahu Ƙǝn hwan Faara tǝ ƙǝmɗa Yeeso Ƙǝrǝsti pakwanɗǝ! Atsaukake.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">Tsaurha tal tǝ ndan hu Ƙǝrǝsti</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Tsaunǝn kee, ƙǝla nani hu porsǝna ƙǝsǝr ka Chinǝm, niya hwan kun tsawama tǝ ndan hu kwamana aah na nda kun kamanggǝn. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />Ƙǝtsar tsawama mǝsǝlǝmnda nafiya tǝ sammayirha, tǝ ƙǝrǝsta. Munyaama tǝ ndan hu nggǝmnda. <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />Ndeeman yid nun laf wumten ɗa nun ha kyanun fǝrang na Sǝsǝna kun, ahu ɗǝɗemnggidɗi wumangga kun heu. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Thlu farha tǝtal ni, Sǝsǝna tǝ Peɗǝnda ƙǝm tǝtal ni, ƙǝla na shiteena aah nanda kun kamanggǝn tǝtal ni, <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />na Chinǝm tal, fǝrƙǝkafek ƙǝm tǝtal ni, tǝ mbaptisma tǝtal. <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />Faara tal Chin kowunni heu, na aten ǝngya heu, ahu heu ƙǝmɗa. <verse eid="EPH 4:6" /><verse number="7" style="v" sid="EPH 4:7" />Amma fǝrang Ƙǝrǝsti nggayirha kowunni ahur nǝm. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Ƙǝla ndana laɓar Faara,</para>
  <para style="q1" vid="EPH 4:8">“A sayidɗi tǝr nǝn talara sǝ</para>
  <para style="q2" vid="EPH 4:8">har ɗǝ porsǝngya haaɗǝ,</para>
  <para style="q2" vid="EPH 4:8">Fǝrang ɗǝ ǝn ǝnaarha fiya ɗǝɗamǝn-ɗǝɗamǝn.”<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">Dzabura 68:18</char></note><verse eid="EPH 4:8" /></para>
  <para style="b" />
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />(Mani ndarha “tǝrɗǝ talara sǝ”? Nǝghǝn a kyad ndaarha tǝrɗa hai ta kamu chehweerha ɗǝ. <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Niifɗi tǝrgha hai, ndǝghǝnni ƙǝm tǝrgha talakh talara sǝ, ka a lǝgdanggǝn talara tǝ hweeɗe heu.) <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />Ndǝghǝnni ƙǝm fǝrangga fingya fathlǝngya Yeeso, fingya annabiya, fingya fa pǝr Laɓara na Mbǝnggǝn, fingya pastoya tǝ famalǝmngya, <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />ka a ngwanggǝn nafiya Faara fa na chahal ǝnang taara nda yi tǝnang nda fad Ƙǝrǝsti, <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />Nǝn a ɗǝrha mbeeɗǝ kee ƙǝl a sǝl wumten nǝm hu fǝrƙǝkafek tǝ sǝn Wan Faara tsawum lǝlǝgɗa tsǝkka yi Ƙǝrǝsti. <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />Tǝrgha mbǝm a nggǝr tsaurha ƙǝla wundakhnaya wa, nduwa tsawum ƙǝla fingya na nanda tsang teena kanda tǝ tur tsaharhaha na a kyakhrang huten ndan hai, nafiya na ndǝndǝl kanda a nggaɓa kanda tǝ huk kanda tǝ ˈya ǝna nanda. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />Ameyedghǝn, a pǝr ƙǝkafek nǝm hu nggǝmnda, manǝm sǝ heu ahurghǝn ndǝghǝnggi na teena, ndǝna Ƙǝrǝsti. <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />Ƙǝsǝr ndǝghǝnni wumangga mbǝd njiya farha heu chik tsǝrha nda kala mbǝd njirha ǝna targhǝn nda hu nggǝmnda.<verse eid="EPH 4:16" /></para>
  <para style="s">Weerinda yibrha hu Ƙǝrǝsti</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Niya ndang nda kun, niya nggǝr ndang nda kun hu thlǝm Chinǝm, tǝ ndaarha a nggǝr ɗun tsaurha ƙǝla nafiya mbuwa Yahudaya wa, mbuwana numad ndan mǝmǝl <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />huten ndan lǝlǝgɗa tǝ wula. Ndǝghang nda kanda hai tǝ yibrha na Faara a fǝra, ƙǝsǝr ka yamid sǝndǝndan, tǝ hur ndan na kakrak. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Mbǝ shilee sǝ a yid ndan wa fǝr nda fad ndan ka tar kulafayirha, na nda sunad kala ǝn tsanda. <verse eid="EPH 4:19" /><verse number="20" style="v" sid="EPH 4:20" />Mbǝ kee tsaha nun aten Ƙǝrǝsti wa. <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />Sǝnɗisǝ pǝrang nda laɓara kun atenggǝn tsau nǝn nafiyighǝn ni kun, tsahang nda kun ha aten ƙǝkafek na ahu Yeeso. <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />Nanǝn kee, malaman ɗimiyid nun tǝ ǝn ǝnad nun yi kaar, ǝn ǝnaarha na sǝɓang kun ɗǝ ƙǝsǝr ka nggǝm ǝngya mbuwa ngga. <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />Ngwa kyakhrangga sǝsǝna numad nun hai. <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />Tǝrama weerǝnda tsaurha ǝnana Faara na ƙǝla altenggǝn, yi nggayirha, tǝ tsaurha yi ƙǝkafek chahal. <verse eid="EPH 4:24" /><verse number="25" style="v" sid="EPH 4:25" />Tsaunǝn kee, malaman nggaɓaarha, kowunni nagha a thlǝghang ƙǝkafek nǝn tuladghǝn, ƙǝsǝr ƙǝm ni ndan heu. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />A sǝb hur nun ɗǝ, a nggǝmɗun fa kyangga sǝbrha hura kun hu ɗimiyirha hai wa, tǝ ƙǝm a nggǝm ɗun fa hǝmnga yanfaara hai hur nun sǝsǝɓa ɗǝ wa. <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />Amma a malang ɗun kwamana Sheetan wa. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Niifa na a ngaara a nggǝrɗǝ ngaara wa. Ameyedghǝn ǝna taara nǝn yi ƙǝkafek tǝ harghǝn, tǝnǝn wal ˈya ha a fǝranggǝn fa yamiya. <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />A kyad laɓara ɓa mbuwa mbǝnggǝn a mii nun wa, kǝl tur laɓara na mbǝnggǝn na fǝr kaali yi taksarha tǝ ndan, hu ǝnaarha kiya nǝn ɗang nda nafina sǝ na a sǝkƙǝn. <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />Kwarama nun ɗǝ sǝɓang hur Sǝsǝna Tǝ Peɗǝnda ɗǝ yi Faara na tǝ yibrha. Ɗalama teena hai a tsauka Sǝsǝnɗi shedawa aten nun na a kyad ndarha a fara sǝmǝn nun a wal alten nun hu ɗimiyirha. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Ndǝghama hai tǝ tur laɓaara na iˈikh, tǝ hufrha hura, tǝ sǝbrha hura tǝ yanda, tǝ ˈyar farha tǝ sǝb thlǝma tǝ kala tur yanggi kaara. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />Ənaman nggayirha ndan, non a haɗang ndan fa, non a chahang ɗimiyirha ndan ɗǝ ƙǝla chahang na Faara ɗimiyid nun kun ɗǝ hu Ƙǝrǝsti.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">Tsaurhahu kukwaryirha</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Tsaunǝn kun wangya Faara ni nggǝm nǝn, tsahama tsaurha ƙǝla ndǝghǝn, <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />tǝ ƙǝm tsawama yi nggǝm ndan, ƙǝla nggǝmna Ƙǝrǝsti ƙǝm, fǝr nǝn fadghǝn ka ƙǝm, sataka na sǝdghǝn mbǝnggǝn, sataka yi Faara. <verse eid="EPH 5:2" /><verse number="3" style="v" sid="EPH 5:3" />Amma ahur nun a sǝk nda ko laɓar kulafayirha wa, ko tur yanggini, nduwa nagha suna sǝ ahur nun wa, ƙǝsǝr kamngwa tǝ nafiya Faara na chahal wa. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />Nǝghǝn kee tǝ laɓara na mbuduhul tǝ palthya yi nuryirha nduwa na iˈikh kamngwa tǝ kun wa. Ameyedghǝn nama narha usa Faara. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />A sǝnunsǝ tǝ ndaarha, niifa na a ǝna pateyirha nduwa susuwayirha, nduwa suna, tsau ɗǝ tal tǝ takkwa ɗaharha, mba nda wal langaarha hu kutǝryid Ƙǝrǝsti tǝ yi Faara wa ko ngguchit. <verse eid="EPH 5:5" /><verse number="6" style="v" sid="EPH 5:6" />A nggaɓa niifa kun tǝ laɓarya mere wa. Ƙǝsǝr tur ǝnggini ya ndǝna sǝɓang hur Faara ɗǝ aten nafiya ǝnawa taara tǝ ˈya ndanǝn. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Tsaunǝn kee a wumɗun teena tǝ kanda wa. <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />Ƙǝsǝr kun kaar nuwun hu wula, amma nanǝnya, wal ɗun kukwaryirha a fad Chinǝm. Nanǝn kee, tsawama nafiya na hu kukwaryirha, <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />Ƙǝsǝr kukwaryirha na ahur nun ndǝna ɓang ˈya ɓa na ngga, tǝ tsawud nggayirha tǝ ƙǝkafek. <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />Tsahama ǝngya na a mbǝnanggǝn Chinǝm. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Ndǝghama hai tǝ ǝn wula mbuwa ngga, a meyedghǝn pǝramadghǝn. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />Ƙǝsǝr ǝn shilee ni a pǝr ǝnggina nǝm na nda a ǝnaarha ɓǝɓee. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />A ɓa ǝnggini a mbǝd kukwaryirha ɓa, kowunni nǝn naghǝn. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />Ƙǝsǝr kukwaryirha ndǝn kyangga ˈya pǝpal ɓa. Ndǝghǝnni nda nanda,</para>
  <para style="b" vid="EPH 5:14" />
  <para style="q1" vid="EPH 5:14">“Mekhnu sa na a shiirha!</para>
  <para style="q2" vid="EPH 5:14">Thliu sǝ hu mǝrra!</para>
  <para style="q2" vid="EPH 5:14">Na Ƙǝrǝsti a fǝro kukwaryirha.”<verse eid="EPH 5:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Nanǝn kee, kwarama tǝ tsawud nun. A tsauɗun ƙǝla nurya wa, amma tsawama ƙǝla nafiya na ndǝndǝl. <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />Ənama taara tǝ kwamana wal nun yi nggayirha, ƙǝsǝr ɓenggini nanǝm sǝ yi mbǝlfeerha. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Tsaunǝn kee a naɗun nurya wa, ƙǝl sǝn ˈya nun na mid Chinǝm. <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />A nggal ɗun tǝ aam inabi wa, yanɗi na ɗang kun hu ǝn shilee ɗǝ wa. Ameyedghǝn lǝgɗaama tǝ Sǝsǝna tǝ Peɗǝnda, <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />kalaman ndan sǝ tǝ laɓarya yi Dzabura, tǝ amshiya yi faala, tǝ amshiya yi sǝsǝna. Aama amshe a Chinǝm tǝ hur nun heu. <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />Ƙǝtsar nama narha usa Faara China ǝnagha ǝngya heu, ahu thlǝm Chinǝm Yeeso Ƙǝrǝsti.<verse eid="EPH 5:20" /></para>
  <para style="s">Tsawud nishya tǝ hǝshya hu kakhrha</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />Fǝraman altennun ndan hu Ƙǝrǝsti. <verse eid="EPH 5:21" /><verse number="22" style="v" sid="EPH 5:22" />Nishya na tǝ kakhrha teena fǝraman fannun a chimayinun ƙǝla nun ǝnanggǝn Chinǝm. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Ƙǝsǝr chimarha ndǝghǝn ni aten nukkun, ƙǝla na Ƙǝrǝsti aten Ƙǝn hwan Faara, Ndǝghǝnggi tafadghǝn ndǝghǝnni tǝ hǝrǝkrha fadɗi. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Ƙǝla fǝrna fatakkwaya alten ndan a Ƙǝrǝsti, nishya ƙǝm fǝrama alten nun a chimayi nun ko hu mani.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />Kun hǝshya nggǝmama nishyinun ƙǝla nggǝmna Ƙǝrǝsti fatakkwayighǝn har fǝr nǝn yiɓǝdghǝn ka kanda <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />ka a nagha chahal, tsaɓanggǝn ɗǝ tǝ aama tǝ sǝsǝmnda laɓarghǝn. <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />Əna nǝn kee fǝr nǝn altenggǝn a walgha fatakkwaya mamnggirha na chahal kula ǝn ˈyaara fa nduwa ǝn tsanda nduwa ˈya ɗimi. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Nǝghǝn kee kamɗǝ, hǝshya a nggǝm nishyindan nda ƙǝla nggǝm nanda fad ndan. Ƙǝsǝr kala niifa nggǝmngga nukkun, nggǝm nǝn altenggǝn. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Mbǝ niifa sǝ ˈwagha kar fadghǝn wa, amma nǝn narha hǝɓang nda ƙǝlaghǝn nǝn ha ngga, kǝla na Ƙǝrǝsti laf fatakkwayighǝn, <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />ƙǝsǝr kǝm ndan ni hu fadghǝn. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />Kǝla ndana Ɗeleewar Faara,</para>
  <para style="b" vid="EPH 5:31" />
  <para style="q1" vid="EPH 5:31">“Na niifa mal man tǝ chin,</para>
  <para style="q2" vid="EPH 5:31">Thlǝthlǝɓanggǝn nukkun fa,</para>
  <para style="q2" vid="EPH 5:31">kanda kyab tsawanda thlu farha tǝtal.”<verse eid="EPH 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EPH 5:32" />Ən ɗiya nǝghǝn ɓǝɓee kuɗimnggǝn kaan, amma niyi a ndaarha Ƙǝrǝsti ni tǝ fatakkwaya. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Nanǝn kee, kala hǝshnefa tǝtani a nggǝm nukkun nǝn ƙǝla nggǝm nǝn altenggǝn, kala nuneefa ƙǝm tǝta ni a fǝrang mamnggirha nǝn chimadghǝn.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">Tsawud wundakhnaya tǝ fa nggǝtyindan</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Kun wundakhnaya, tǝraman shilee fa nggǝtyinun teena ƙǝsǝr kun yi Chinǝm ni, ƙǝsǝr ndǝna mǝmǝl. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />Ngyakhrha yi tal ǝna nanda tǝ ɗǝfmee ndǝghǝn, “Tǝrang shilee nda muwa tǝ tsu teena, <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />tǝna tsawud nun naarha ngga, tǝ ƙǝm na yiɓǝd nun a naarha dzang hu ƙǝshiirha.” <verse eid="EPH 6:3" /><verse number="4" style="v" sid="EPH 6:4" />Kun chingya, a sǝɓang ɗun hur wangginun ɗǝ wa; a meyedghǝn, ƙǝraman kanda sǝ hu kwamana na ngga, tǝ ƙǝm tsaha man laɓar Chinǝm kanda ha.<verse eid="EPH 6:4" /></para>
  <para style="s">Mafaya tǝ tuwurayindan</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Kun mafaya, tǝraman shilee tuwurayinun teena na hu ƙǝshiirha. Fǝraman mamnggirha kanda, koma nun a ǝnaarha ǝnamadghǝn tǝ hura tǝtali, kǝla nun a ǝnang Ƙǝrǝsti. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />A fǝrang ɗun mamnggirha kanda ka tǝrǝm hu yirha tǝnǝn mbǝnang fiya wa. Amma ƙǝla mafaya yi Ƙǝrǝsti, ǝnama ˈya na mid Faara tǝ hura tǝtali. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />Ənama taara tǝ hura tǝtali, ƙǝla nun a ǝnang taara Chinǝm ni, mbǝ fiya wa. <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />A sǝnunsǝ, na Chinǝm a fǝrang ƙǝnaghǝn kowunni ahur nǝm kala ˈya ǝna nǝm ngga, ko mafaya ni, nduwa nafiya na tǝ alten ndan. <verse eid="EPH 6:8" /><verse number="9" style="v" sid="EPH 6:9" />Kun tuwuraya, kunggi ma ǝnaman mafayinun kee. A naɗun a tǝrmang kanda wa. A sǝnunsǝ kun kyab na tuwuri nun tal a talara, ndǝghǝnggi kǝm mbǝ wura hasǝ wa.<verse eid="EPH 6:9" /></para>
  <para style="s">Ƙǝsǝmnda Faara</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />A mii ngwaladghǝn tsawama tǝ shembe ahu Chinǝm tǝ sǝsǝmnda mamnggitghǝn. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Ngwama fa tǝ ƙǝsǝmnda yanda yi Faara fǝrang nǝn kun, tǝnun mbang pa ƙǝfarha tǝ Sheetan ana midghǝn huk kun. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Ƙǝsǝr mbǝm a yanda yi thlu farha tǝ fara wa, amma tǝ sǝsǝn ƙǝshiid mbǝlfeeya mbuwa nǝm naarha, tǝ kutǝrya tǝ fingya na tǝ tǝ sǝsǝmnda ha, tǝ fingya na tǝ kutǝryid ƙǝshiid wula a har ndan. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Tsaunǝn kee, kalaman ƙǝsǝmnda yanda heu yi Faara, tǝnun mbang isha a farɗi mbuwa ngga na ɓayi. A kwasamadɗi ngwalang nun yanda nun narha tǝ shembe isha ƙǝt. <verse eid="EPH 6:13" /><verse number="14" style="v" sid="EPH 6:14" />Ishama tǝ shembe, ƙǝkafek tsauka ƙǝla ǝn ƙǝn munun, nggayid Faara na ƙǝsǝm ndǝghǝn laf kun nǝn, <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />na a kyad ndaarha ngwa ɗun fa ka a pǝr Laɓaara nun na Mbǝnggǝn ƙǝla pa pakhma yi tsawud ɗǝɗemnggirha. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />Ngwa tsauka fǝrƙǝkafek ƙǝsǝm ndǝnun tǝnun mbang ɓǝlang wad hafya hai na tǝ mbǝlfedɗi a chaarha ɓa. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Tǝrama tǝtar tasau yi hǝrǝkrha, tǝ ƙǝm thlaukh ƙǝlar Sǝsǝna, ndǝna laɓar Faara. <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />Hwanama Faara ƙǝtsar tǝ sǝsǝmnda Sǝsǝna. Hwanama Faara aten ǝngya ɗǝɗamǝn-ɗǝɗamǝn. Ƙǝsǝr non a ƙǝla alten nun ha ngga a sayidɗi nun a hwanda aten fatakkwaya heu. <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />Nggi ƙǝm Hwaneema Faara in, tǝna Faara fǝre ˈya kamngga a thlǝyi, pǝr Laɓarghǝn ni na Mbǝnggǝn yi ǝnwulteena a fiya kula hǝrenga. <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />Ƙǝsǝr ka laɓarɗi na mbǝnggǝn ya ndǝn tsauni a meyed Yeeso, ko nani hu porsǝna. Hwaneema Faara in tǝni pǝr laɓar Faara kamngga a ǝne.<verse eid="EPH 6:20" /></para>
  <para style="s">Mii ngwala ndaˈya</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Tikikus, wanmanǝm nggǝm nǝm, na a ǝna taara hu kwamana na ngga a Chinǝm, Nǝn a pǝrang ˈya kun heu, tǝnun sǝn ˈya niya ǝnaarha tǝ kwamanɗi niya ǝnaghǝn. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />Thlǝnni ndǝn thlǝman nun ɗǝ ƙǝsǝr a sǝn ˈya nun nanan a hurghǝn, tǝ ƙǝm fǝrang kaali kun nǝn.<note caller="+" style="f"><char style="fr" closed="false">6:22 </char><char style="ft" closed="false" /></note> <verse eid="EPH 6:22" /><verse number="23" style="v" sid="EPH 6:23" />Shayina, ngwa tsauka ɗǝɗemnggid Faara na chinɗi, tǝ Chinǝm Yeeso Ƙǝrǝsti tǝ nggǝmnda tǝ fǝrƙǝkafek tǝ kun. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Ngwa tsauka nggayid Faara aten kowunni nggǝmngga Chinǝm Yeeso Ƙǝrǝsti tǝ nggǝmnda mbuwa tam ngwalarha. Atsaukake.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>