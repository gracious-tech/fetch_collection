<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">2 YAHAYA</book>
  <para style="h">2 Yahaya</para>
  <para style="toc3">2 Yahaya</para>
  <para style="toc2">2 Yahaya</para>
  <para style="toc1">2 Yahaya</para>
  <para style="mt1">2 Yahaya</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s">Ndaˈya</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Kyagha ɗeleewar ɗa ɓa ya a har mamnda ƙǝn hwan Faara, a nuneefa tǝ wanggighǝn nggǝmni kaan, mbǝ nggi katenna wa, amma heu tǝ fingya sǝngga fǝrƙǝkafek, <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />ƙǝsǝr fǝrƙǝkafekkidɗi na ahur nǝm nǝn a tsaurha tǝƙǝm pakwanɗǝ. <verse eid="2JN 1:2" /><verse number="3" style="v" sid="2JN 1:3" />Ngwa tsauka nggayirha tǝ haɗang nda ndan fa tǝ tsawud ɗǝɗemnggirha ɓagha ɓa a thlǝmad Faara na Chinɗi tǝ Yeeso Ƙǝrǝsti Wan Chinɗi a tsauka tǝ ƙǝm hu ƙǝkafek tǝ nggǝmnda.<verse eid="2JN 1:3" /></para>
  <para style="s">Tsaurhahu ƙǝkafekkirha</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Ənaɗi wutsǝfayirha kaan nani fingya wangginun kanda a takkwa ƙǝkafekkidɗi, ƙǝla ndangna Chinɗi ƙǝm. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Nanǝnya shayina, niya chireethleng kun ɗǝ ka a ɗalang nggǝni kun teena a nggǝm ndan nun. Mbǝ ˈyasǝ pak niya pǝrang kun wa, amma yanɗi nanǝm tǝghǝn ha ka ƙǝtǝm. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Nggǝmnda ndaarha ni a ǝna ǝnɗa nǝm ndang na Faara ƙǝm, ndanggǝn ƙǝm a nggǝm ndan nǝm ƙǝla sǝk nǝm ka a katǝradghǝn. <verse eid="2JN 1:6" /><verse number="7" style="v" sid="2JN 1:7" />Pǝrang ni ndǝn kun kee ƙǝsǝr wel fa nggaɓaya hu ƙǝshiirha ɗǝ. Nggǝm ngwa nda fa tǝ ndaarha ɓa Yeeso Ƙǝrǝsti ɓa ahu thlu farha wa. Tur nafiniya na nda tukhɓang huten fingya, tǝ ƙǝm kanda ni na kalang nda fatsangya Ƙǝrǝsti. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Tsaunǝn kee, kwarama nun ɗǝ ƙǝɗeng ƙǝna tar nǝm, tǝnǝm wal ƙǝna tar nǝm ngga. <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />Kala niifa ishwa wa ahu tsahad Ƙǝrǝsti mbǝ tǝ Faara wa. Amma kala niifa ishgha aten tsahad Ƙǝrǝsti, nǝghǝn tǝ Chinɗi tǝ Wanɗi ƙǝm. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />A ɓad niifa thlǝmad nun ɓa a naɗǝ a tsaharhaha pak ma ƙǝkafekkid Ƙǝrǝsti, a thlǝɗun ndǝn fa hu wura yinun wa, nduwa a ndangˈya nun wa. <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />Kala niifa ndangga ˈya tur niifɗi ya, wum nǝn teena tǝghǝn hu tar ɗimiyidghǝn.<verse eid="2JN 1:11" /></para>
  <para style="s">Mii ngwala laɓaara</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />Na ǝngya sǝ hangga na minna a pǝrang nggi kun, amma mbǝ minna sǝ a chireethleng nggi hai ahu ɗeleewar ɗi ya wa, a meyedghǝn, niyi a shiteena a weng tala ni kun tsǝ laɓaara nǝm yirha tǝ yirha, tǝna wutsǝfayid nǝm lǝghǝtta. <verse eid="2JN 1:12" /><verse number="13" style="v" sid="2JN 1:13" />Wangya wanmuwa wurna Faara kanda a ndoˈya fa.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>