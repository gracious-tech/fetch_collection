<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">3 YAHAYA</book>
  <para style="h">3 Yahaya</para>
  <para style="toc3">3 Yahaya</para>
  <para style="toc2">3 Yahaya</para>
  <para style="toc1">3 Yahaya</para>
  <para style="mt1">3 Yahaya</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s">Ndaˈya</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Kyagha ɗeleewar ɗaɓa ya a har mamnda ƙǝn hwan Faara a pashidna Nggayus nggǝmni tǝ ƙǝkafekkirha. <verse eid="3JN 1:1" /><verse number="2" style="v" sid="3JN 1:2" />Pashidna, niyi a ndaarha na kanglang hai hu thlu farha ƙǝla nani sa kanglang hai ƙǝmɗa hu sǝsǝna. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Tǝkɗi mbǝnda fa kaan sǝk ni ndaarha a mii shayinǝm tǝ ndaarha sa ƙǝsna fǝrƙǝkafekkid wa ha ngga. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Mbǝ ˈyasǝ mbǝnegha kaan ma wa sǝk ni ndaarha na wanggina a takkwa ƙǝkafek.<verse eid="3JN 1:4" /></para>
  <para style="s">Fal nda Nggayus</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Pashidna, na tǝ ƙǝkafek fa aten ǝngya na a ǝnaarha aten shayinǝm, ko nanǝn rongya ni kanda a fadwa. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />Pǝr ndan hu ƙǝn hwan Faara aten nggǝm nduwa. Niya hwan sa ɗu mbeeɗǝ tǝ ɗang nda fa malǝmngya sǝ ahu kwamana na a mbǝnanggǝn Faara. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Kyagha nafina ɓa ya ka a pǝr laɓar Ƙǝrǝsti nda, kula thlǝ ˈya a haar nafiya fǝrwa wa ƙǝkafek. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Tsaunǝn kee, mǝmǝl ɗǝ na a ɗanggǝm nafina sǝ ya, tǝnǝm tsaurha pashiya taara hu ƙǝkafek.<verse eid="3JN 1:8" /></para>
  <para style="s">Ndiyotarifis tǝ Ndimitiriyus</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Chireethleng ɗi fatakkwaya ɗǝ na a kyawa, amma Ndiyotarifis, na midghǝn sǝ a tsauka mamndǝ ndan, kar ɗǝ thlǝ laɓar nǝm fa. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />A ɓaɗiɓa, ɓani pǝr fingya ǝngya nǝn ǝnaarha, tǝ laɓar nggaɓarha nǝn narha thlǝkrha aten nan. Ndǝghǝn tafadghǝn karɗǝ thlǝ fa fǝrƙǝkafekkya fa. Ndanggǝn fingya ƙǝmɗa a thlǝnda kanda fa wa. A ɗang fingya kanda sǝ, nǝn rǝk kanda ma ƙǝn hwan Faara.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Pashidna, a tsahad na ˈya mbuwa ngga wa, amma tsahu ˈya na ngga. Kala niifa na a ǝna ˈya ngga yi Faara ni, niifa ƙǝm mbuwa a ǝna ˈya na ngga sǝngwa Faara wa. <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />Kowunni ƙǝl tsǝ laɓara aten Ndimitiriyus, tǝ laɓar ƙǝkafekkidghǝn tafadghǝn. Ƙǝm ma tsǝɗǝm laɓara na ngga atenggǝn, sǝnnasǝ tǝ ndaarha ˈya thlǝk nǝm ƙǝkafek ni.<verse eid="3JN 1:12" /></para>
  <para style="s">Ngwala mii ndaˈya</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Na ǝngya sǝ hangga na minna a pǝro ƙǝni, amma mbǝ minnasǝ a chireethleng nggi hai hu ɗeleewar wa. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Tsǝɓaku na minna sǝ a na sa ni, ndǝn nǝm a tsǝ laɓaara nda yirha tǝ yirha. <verse eid="3JN 1:14" /><verse number="15" style="v" sid="3JN 1:15" />A tsauka ɗǝɗemnggirha tǝ sa. Pashiyi wa heu na a mbǝɗiya kanda a ndoˈya fa. Ndangˈya pashiyi nǝm fa na a mbǝɗi tǝtal-tǝtal.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>