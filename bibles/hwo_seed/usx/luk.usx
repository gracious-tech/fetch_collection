<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">Luka Luka - Hona New Testament</book>
  <para style="h">Luka</para>
  <para style="toc3">Luka</para>
  <para style="toc2">Luka</para>
  <para style="toc1">Luka</para>
  <para style="mt1">Luka</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s">Luka chirethleng ɗǝ ɗeleewar Tiyafulus ɗǝ aten Yeeso</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Fiya hangga chirethgha aten ǝnggini ǝnana Faara a pathlang nǝm. <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />Ƙǝla malang nandan ƙǝm hai ahar nafini ˈwagha naghǝn tǝ yindan kal nanda mii laɓar Faara ɗǝ. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />Tsaunǝn kee, paɓa Tiyafulus, nggi tǝ altenna raɗi mu ǝnggina ha ya tǝ sammayirha ka a katǝradghǝn, ƙǝlaɗi hai nǝghǝn mǝmǝl a fanna a chirethleu ƙǝni hai tǝtal-tǝtal. <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />Na minna sǝ a sǝn ƙǝkafekkid ǝnggina na tsaho nanda ha.<verse eid="LUK 1:4" /></para>
  <para style="s">Tǝ Thlǝnda Faara kalɗǝ mii nggǝtta Yahaya tǝ Mbaptisǝma</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />A thlakh mbǝd kutǝryid Hirdus a Yahudiya, na firis sǝ thlǝmnggǝnni Dzakariya, nǝghǝn ahu kiwad Firistaya a wuri ki Abidja. Nukkun ƙǝm Alisaɓatu turya Haruna ni. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Kanda kyab ka nafiya ni kanda a mbed Faara, na nda a laf ngyakhrha Faara na heu. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />Amma mbu wan nggindan sǝ wa, ƙǝsǝr Alisaɓatu kwarengani, tǝ ƙǝm kanda kyab suhur nda.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Fara sǝmǝn far tar Dzakariya yi firistayirha a mbed Faara, <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />wurna ndan ƙǝla ndana ǝntin firistaya, a kyagha hu Ƙǝn Faara ɗǝ na a Urshalima nji urdi nǝn na sǝdghǝn mbǝnggǝn. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Sǝlna sayid nji urdi ɗa ɓa, fiya heu wumnda ɓa, kanda a ƙǝshi a hwan Faara.<verse eid="LUK 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11" />Kula sǝndǝghǝn sǝ na tǝ thlǝnda Faara nǝn ƙǝt a yi sǝmad mbǝɗi nanda nji urdi sǝ. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Nana Dzakariya ndǝn, hargha ƙǝfadghǝn, tǝrǝmngga. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Amma ndangga tǝ thlǝnda Faara, “A tǝrǝmna wa Dzakariya; sǝk Faara hwanduwa. Nuwa Alisaɓatu nǝn a nggǝɗo wee hǝshin sǝ, ɗǝfang thlǝma na Yahaya. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />Nǝn a tsaurha ǝn wutsǝfayirha kaan a fadwa, fiya hangga ƙǝm na nda ǝna wutsǝfayirha ƙǝsǝr ka nggǝttǝghǝn hai. <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />Nǝn a tsaurha niifa na manggǝn a mbed Chinǝm. Mbǝgha sa aam inabi ko mbaala wa. Ka far nggǝttǝghǝn hai nǝn a lǝghǝtta tǝ Sǝsǝna tǝ Peɗǝnda. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Fiya hangga a Isǝreela nǝn a wuɗang kanda a thlǝmad Chinǝm farndan ɓa. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />Nǝn a ˈwarha a mbed Chinǝm ɗǝ, hu sǝsǝna tǝ sǝsǝmnda ƙǝla annabi Iliya. Nǝn a ɓang tsawud ɗǝɗemnggirha ɓa a pathlang chingya tǝ wanggi ndan. Nǝn a kyakhrang fiya ɓa fingya na tǝ yamid fǝr mamnggirha tsawa nda nafiya natǝ nggayirha fa, nǝn tansang fiya a Chinǝm.”<verse eid="LUK 1:17" /></para>
  <para style="pi">
    <verse number="18" style="v" sid="LUK 1:18" />Tsahangga Dzakariya mee tǝ thlǝnda Faara, “Kǝƙǝn ni sǝnda sǝ ǝnɗi thlǝkna ya nǝn tsaurha ƙǝkafek? Kulo nggi, suhurɗi nuuna ƙǝm kee.”<verse eid="LUK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19" />Nggǝmangga tǝ thlǝnda Faara, “Nggini Djibirilla na ƙǝt a mbed Faara. Thlǝnna nda nggi ɓa, a ɓi puro laɓarɗi na mbǝnggǝn ya. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Nanǝn ya na naarha tip, mba nggǝr kalasǝ wa ƙǝl a farɗi katǝranǝn hai, ƙǝsǝr sa karna fǝrƙǝkafek fa tǝ pathna, ɓagha tsaurha ƙǝkafek a sǝl ɓenggǝn ɓa.”<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />Nanǝn ya, fiya a ƙǝla Dzakariya fa a kyagha ɓa, na nda a numarha tǝ mani tsǝnǝn tsǝɓaku kee ahu ƙǝn hwan Faarɗi. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Kyanǝn ɓa, mbangwa kalang kanda sǝ wa. Walangganda tǝ ndaarha kyaɗang Faara ˈya ahu ƙǝn hwan Faarɗi, ƙǝsǝr nǝn naarha kyad haara a kanda, mbangwa kalasǝ wa.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />Ngwalang nǝn ɓen targhǝn, wudgha wureɗǝ. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />Mǝngwaha wa nukkun Alisaɓatu ɗǝfgha hur. Tsau fayighǝn nǝn a wuri mbǝ kyarha ƙǝshaaɗǝ wa yi ndǝre tuf. <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />Ndagha Alisaɓatu, “Faara ǝneegha ǝnɗiya! A hu ɓengginiya ndǝn haɗang ni fa, keeɗa sǝ hu shilee a mbed fiya.”<verse eid="LUK 1:25" /></para>
  <para style="s">Tǝ Thlǝnda Faara kalɗǝ mii nggǝtta Yeeso</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Nana Alisaɓatu tǝ ndǝre mikki, thlǝngga Faara tǝ thlǝndǝghǝn Djibirilla ahu tala ɗǝ a Nggalili, nanda aarha Nadzarat. <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />A ɗǝgha thlǝmad wutararha ɗǝ na thlǝmnggǝn Mairamu, ngwanna niifa na nda aarha Yisufu, turya Ndauda. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Ɗǝgha tǝ thlǝndǝɗi thlǝmadghǝn ɗǝ ndanggǝn, “Niya ndo ˈya, sa na tǝ parka teena! Chinǝm nǝghǝn tǝ sa ha.”<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />Sǝkna Mairamu nda ǝnɗi, ɓillagha kaan, nzǝmnggǝnǝn tǝ tur nda ǝn mani ya. <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Amma ndangga tǝ thlǝnɗǝɗi, “A tǝrǝmna wa, Mairamu, walna nggayirha a mbed Faara.<verse eid="LUK 1:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="LUK 1:31" />Na a ɗǝfrha hur,</para>
  <para style="q2" vid="LUK 1:31">nggǝt wee hǝshin na,</para>
  <para style="q2" vid="LUK 1:31">ɗǝfang thlǝma na Yeeso. <note caller="+" style="f"><char style="fr" closed="false">1:31</char><char style="fk">Yeeso </char> Thlǝmɗi “Yeeso” na Helenaya aaghǝn “Djeshiwa” tǝ mii Ibraniyaya ndaarha ni “Hǝrǝkrha Faara”.</note><note caller="+" style="f"><char style="fr" closed="false">1:31 </char><char style="ft" closed="false">Matta 1:21</char></note><verse eid="LUK 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 1:32" />Nǝn a tsaurha manda niifa,</para>
  <para style="q2" vid="LUK 1:32">nanda aaghǝn,</para>
  <para style="q2" vid="LUK 1:32">Wan Faara na tǝ sǝsǝmnda ha heu.</para>
  <para style="q1" vid="LUK 1:32">Na Chinǝm Faara a fǝrang tsǝnnggam kutǝryid chichidghǝn Ndauda.<verse eid="LUK 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LUK 1:33" />Nǝn tsau kutǝryirha aten nafiya Isǝreela pa kwanɗǝ,</para>
  <para style="q2" vid="LUK 1:33">kutǝryidghǝn mbǝ mii ngwaladghǝn sǝ wa.” 1:33 2 Samaila 7:12; 13; 16; Ishaya:haya 9:7 1:33, Ndaniyel 2:44; 7:27; Mika 4:7.<verse eid="LUK 1:33" /></para>
  <para style="b" />
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />Tsahangga Mairamu mee tǝ thlǝnda Faara, “Kǝƙǝn na ǝnɗi katǝrarha hai ya nggi kula sǝn hǝshnefa?”<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />Nggǝmangga tǝ thlǝnda Faara,</para>
  <para style="q1" vid="LUK 1:35">“Sǝsǝna tǝ Peɗǝnda nǝn a tǝraa tenwa hai,</para>
  <para style="q2" vid="LUK 1:35">sǝsǝmnda Faara Amshi nǝn a nggǝlorha.</para>
  <para style="q1" vid="LUK 1:35">Tsaunǝn kee, Wanɗi tǝ Peɗǝnda na a nggǝtta ya,</para>
  <para style="q2" vid="LUK 1:35">nǝm aaghǝn tǝpeɗǝnda Wan Faara.<verse eid="LUK 1:35" /></para>
  <para style="b" />
  <para style="m">
    <verse number="36" style="v" sid="LUK 1:36" />Kwana Alisaɓatu hurfidwa, nda nanda kwarenga ni, tǝ suhuryidghǝn nǝn a nggǝt wee. Nanǝnya nǝghǝn ahur tǝ ndǝre mikki. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />Ƙǝsǝr mbǝ ˈyasǝ na pǝɗaghǝn a fad Faara wa.”<note caller="+" style="f"><char style="fr" closed="false">1:37 </char><char style="ft" closed="false">Kyarhaɓa 18:14</char></note><verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />Ndagha Mairamu, “Yoo, nggi mafad Faara ni, a tsauka ƙǝla tǝ thlǝkna na.” Tǝrgha tǝ thlǝnda Faara wiigha.<verse eid="LUK 1:38" /></para>
  <para style="s">Mairamu wengɗǝ tala Alisaɓatu</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />A sayidɗi, Mairamu ngwagha fa thliigha ƙǝkar ɗǝgha hu tala ɗǝ na ahu wumngya chehweed Yahudaya. <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />Sǝlnǝn ɗǝ kyagha minda ki Dzakariya hai, ndang ˈya nǝn Alisaɓatu. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Sǝkna Alisaɓatu nda ǝnɗi ki Mairamu, wanɗi na ahurghǝn tsǝˈya nǝn fa. Alisaɓatu ƙǝm lǝghǝdgha tǝ Sǝsǝna tǝ Peɗǝnda. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />Tǝrangga Alisaɓatu uradghǝn sǝ kaan, ndanggǝn Mairamu, “Tǝ parkani sa ahur nishya, tǝ ƙǝm tǝ parkani wanɗi ɓana nggǝtta! <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Mani na nggayirha ɓarha tenna ɓa kee, na man China ɓarha thlǝmadna ɓa? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Hǝrǝm ni sǝk nda ǝnwa, wanɗi na a hurna tsǝˈya nǝn fa kaan ka wutsǝfayirha. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Tǝ parkani sa fǝrgha ƙǝkafek aten ˈya ndona Chinǝm nǝn tsaurha ƙǝkafek.”<verse eid="LUK 1:45" /></para>
  <para style="s">Amshi Mairamu</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Ndagha Mairamu,</para>
  <para style="q1" vid="LUK 1:46">“Hurna nǝghǝn a fal Faara<verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />yiɓǝnna nǝghǝn a ǝna wutsǝfayirha a Faara tǝ Hǝrǝkrǝna,<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />ƙǝsǝr ɗalɗǝ nggi in,</para>
  <para style="q2" vid="LUK 1:48">mafadghǝn mbuwa a mii ˈya.</para>
  <para style="q1" vid="LUK 1:48">Nanǝnya fiya na heu yi weeriya tǝ na ɓayi nanda ndaarha tǝ parkani nggi,<verse eid="LUK 1:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="LUK 1:49" />ƙǝsǝr ka ǝngya na mǝmanggǝn ǝneena Faara Amshi,</para>
  <para style="q2" vid="LUK 1:49">thlǝmnggǝnni tǝ Peɗǝnda.<verse eid="LUK 1:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50" />Na fiya haɗang fa na a tǝrǝmnggǝn,</para>
  <para style="q2" vid="LUK 1:50">Ka chichiiya na ƙǝtǝm.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />Ənaɗǝ ǝngya na mǝmanggǝn tǝ harghǝn;</para>
  <para style="q2" vid="LUK 1:51">welengɗǝ fingya ɗǝ na a manang alten ndan hu numan ndan.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />Tǝrangɗǝ kutǝrya hai hu tsǝnggam nggindan,</para>
  <para style="q2" vid="LUK 1:52">amma mananggǝn fingya mbuwa a mii ˈya.”<verse eid="LUK 1:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 1:53" />“Nggalang ɗǝ fingya na a mirha tǝ ǝngya na nggǝngga,</para>
  <para style="q2" vid="LUK 1:53">amma rǝghanggǝn fa ƙǝnaya ɗǝ kula ˈya a harndan.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />Ɗangɗǝ mafadghǝn sǝ Isǝreela,</para>
  <para style="q2" vid="LUK 1:54">tǝ ɗal teena hai haɗang nda<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />Ibrahim fa tǝ chichiyighǝn pa kwanɗǝ</para>
  <para style="q2" vid="LUK 1:55">ƙǝla ndang nǝn chingginǝm na kaar.”<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Mairamu tsauɗǝ a thlǝmad Alisaɓatu yi ndǝre mahan a wudgha wureɗǝ.<verse eid="LUK 1:56" /></para>
  <para style="s">Nggǝtta Yahaya tǝ Mbaptisǝma</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Lǝghǝdna ɓen nggǝtta Alisaɓatu, nggǝt wee hǝshin nǝn. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />Tulayighǝn tǝ nggǝɗayighǝn sǝk nanda kyaɗang Faara nggayirha, ɗangganda sǝ tǝ wutsǝfayirha.<verse eid="LUK 1:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59" />Lǝghǝnna wanɗi ɓeena uvaɗa, ɓa nda ka thlee muwa ɓa, tǝ ƙǝm na mindansǝ a ɗǝfang thlǝm chin nda Dzakariya. <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />Tǝrgha kalgha mansǝ ndǝghǝn, “Awo! Nǝm aaghǝn Yahaya.”<verse eid="LUK 1:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61" />Ndang ngganda, “Mbǝ niifa sǝ ahur nggǝɗiyinun na tǝ thlǝmɗiya wa.”<verse eid="LUK 1:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 1:62" />Tǝrgha tsahang mee nda chin wanɗi tǝ haara a pǝr thlǝm wanɗa nǝn nanda a ɗǝfang nda. <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />Tsakh ǝn chirethla nǝn, chirethlenggǝn hai, “Thlǝmnggǝnni Yahaya.” Fiya na heu na ǝnwulteena nda. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />A mbǝɗi kee ingga mighǝn hai tǝ ƙǝm sheneuƙǝn kwasgha hai, katǝranggǝn ndikrha hai nagha a fal Faara. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Tulayighǝn na heu nanda ǝnwulteena, tǝ ƙǝm tǝrmanda, ƙǝsǝr ka ǝnɗi katǝragha hai. Kala mbǝrha heu na a wumngya chehweed Yahudaya nagha fiya a tsǝ laɓara atenggǝn. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />Kala niifa sǝkka laɓarɗi ƙǝl wulna teena, tǝ tsakh mee nǝn, “Ɓana wanɗi tsaurha ƙǝƙǝn ya?” Ƙǝsǝr na Faara tǝghǝn ha.<verse eid="LUK 1:66" /></para>
  <para style="s">Dzakariya falɗǝ Faara</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Chin na Dzakariya lǝghǝdgha tǝ Sǝsǝna tǝ Peɗǝnda katǝranggǝn thlǝk pathla hai kyaɗang na Faara tǝ ndaarha,<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />“Tama fal Chinǝm nǝm, Faara yi Isǝreela,</para>
  <para style="q2" vid="LUK 1:68">ƙǝsǝr ɓanǝn ɓa ka ɓagha pǝl nafiyighǝn.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />Fǝrɗǝ tǝ ngyakhrha na a hǝrghang nda ƙǝm</para>
  <para style="q2" vid="LUK 1:69">a wuri ki mafadghǝn Ndauda.<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />Kǝla ˈwanǝn thlǝkrha ƙǝtǝm a mii annabiyighǝn tǝ peɗǝnda<verse eid="LUK 1:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71" />hǝrǝkrha ahar fa tsangginǝm na heu.<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />Əngginiya ǝnanǝn ndǝn a kyaɗang nggayirha nǝn chingginǝm</para>
  <para style="q2" vid="LUK 1:72">tǝ ɗal teena hai hu ɗǝf mighǝn tǝ peɗǝnda ǝna nǝn.<verse eid="LUK 1:72" /></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73" />Ɗǝf mighǝn ǝna nǝn a chichin nǝm Ibrahim,<verse eid="LUK 1:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74" />a pǝl ƙǝm nǝm ahar fa tsangginǝm,</para>
  <para style="q2" vid="LUK 1:74">tǝnǝm ɗǝfang shilee teena kula hǝreenga,<verse eid="LUK 1:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75" />anam tsǝtsaɓaɗǝ tǝ nggayirha a mbed Faara ahu tsawun nǝm hu ƙǝshiirha.”<verse eid="LUK 1:75" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />“Sa ƙǝm waana, nanda aah sa annabi yi Faara Amshi,</para>
  <para style="q2" vid="LUK 1:76">ƙǝsǝr na ˈwarha mbeeɗǝ ma Chinǝm a tangsang kwamana na ɗǝ,<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />a fǝrang huteena nǝn nafiyighǝn aten kwaman hǝrǝkrha</para>
  <para style="q2" vid="LUK 1:77">ahu chakhrha ɗimiyid ndan ɗǝ,<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />ƙǝsǝr ka haɗang nǝm Faara fa,</para>
  <para style="q2" vid="LUK 1:78">kukwaryid hǝrǝkrha nǝn a njaara tennǝm hai a talara hai.<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />Nǝn a njaara aten fingya hai na ahu wula,</para>
  <para style="q2" vid="LUK 1:79">tǝ fa tsaukya na a mishim mǝra,</para>
  <para style="q1" vid="LUK 1:79">nǝn a laf ƙǝm ahu kwaman ɗǝɗemnggirha.”<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Yahaya mangga sǝ, nagha kanglang hu farha tǝ huteena, tsauƙǝn a kaheerha ƙǝl farɗi kyanǝn pǝpal ɓa ka a pǝr laɓarghǝnǝn a nafiya Isǝreela.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s1">Nggǝnda Yeeso a Mbaitalami</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />A hu ɓengginiya Kaisar Anggusta kalɗǝ mee a thlǝɗangganda fiya na hu kutǝryid Roma. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Ndǝna katǝra thlǝtta fiya ǝnanda, a sayidɗi tsauna Karniwus ngwamna a Suriya. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Fiya na heu wunda hu talyi ndan ɗǝ ka a thlǝɗangganda kanda. <verse eid="LUK 2:3" /><verse number="4" style="v" sid="LUK 2:4" />Yisufu ndǝghǝnggima malɗǝ tal Nadzarat na hur Nggalili ɗǝgha hu tal Mbaitalami ɗǝ na hur Yahudiya, tala nggǝnda kutǝra Ndauda sǝ. Yisufu ɗǝɗǝ mbǝɗaɗǝ, ƙǝsǝr nggǝɗit Ndauda ni. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />Wiighǝn tǝ Mairamu ngwannǝn ka a thlǝɗangganda kanda kyab, ahu sayidɗi ndǝghǝn ahur. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Na nanda a Mbaitalami ɗi lǝghǝdgha ɓen nggǝttǝghǝn. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Nggǝt wan ˈwadghǝn nǝn hǝshin, lǝlǝɓanggǝn tǝ pam ƙǝnɗǝghǝn, hunanggǝn ahu nggam maɓiya hai, ƙǝsǝr walwanda ƙǝnna a min rongya wa.<verse eid="LUK 2:7" /></para>
  <para style="s1">Falafya tǝ Fathlǝngya Chinem</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />A ƙǝsǝr talɗi na fa lafya sǝ, na nda mǝnda a pǝpal, na nda a ƙǝla maɓiyindan ha a fǝɗigrha. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />Kula sǝndǝndan sǝ, tǝ thlǝnda Faara ɓagha thlǝmandan ɓa, tǝrgha mamnggit Faara yangga hai, tǝrmanda kaan. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Tǝrgha, wan thlǝndǝɗi ndanggǝn kanda, “A tǝrǝm ɗun wa ɓa ni ɓa tǝ laɓara na mbǝnggǝn yanɗi na fiya heu ana pǝpetyid hura kaan. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />A weeriya ahur tal Ndauda nggǝɗang nda tǝ Hǝrǝkrha kun hai, Ƙǝrǝsti Chinǝm. <note caller="+" style="f"><char style="fr" closed="false">2:11</char><char style="fk">Ƙǝrǝsti </char> Nduwa Ƙǝrǝsti Ibraniyaya na nda aaghǝn, “Mashiha,” Helenaya ƙǝm na nda aaghǝn, “Ƙǝrǝsti.” Ƙǝrǝsti ɗiya, ndaarha ni, “Niifa na wuwura,” tǝ ƙǝm mbǝdghǝn 26.</note> <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Ənɗiya ndǝna a kyaɗang ǝnsǝnda kun, ɗunun wal wufarwee lǝlǝɓang nda tǝ pam ƙǝndǝghǝn, hunang nda hai ahu nggama.” <verse eid="LUK 2:12" /><verse number="13" style="v" sid="LUK 2:13" />Kula sǝndǝndan sǝ, tǝrgha Fathlǝngya Faara hangga na a amshi, ɓanda hai, ɓa nda wal yanɗi ˈwagha hai, kanda heu a fal Faara nanda a ndaarha,<verse eid="LUK 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />“Mamnggit Faara na talara,</para>
  <para style="q2" vid="LUK 2:14">tǝ na hu ƙǝshiirha ngwa tsauka ɗǝɗemnggirha a thlǝma nafiya na Faara a tǝk mbǝndǝ ndan fa.”<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />Malna Fathlǝnggini kanda, wuɗa nda talara ɗǝ, ndangga fa lafyini ndan “Tama Mbaitalami ɗǝ ɗǝm na ǝnɗi katǝragha hai tǝ pǝrangna Chinǝm ƙǝm.” <verse eid="LUK 2:15" /><verse number="16" style="v" sid="LUK 2:16" />Thliinda ƙǝkar ɗanda wal Mairamu tǝ Yisufu, na wanɗa nda kath ahu nggam maɓiya. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Nana fa lafyini wanɗi, pǝr laɓar ɗa nda thlǝghangna tǝ Thlǝnda Faara kanda. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />Sǝkna fiya laɓar ɗi, kowunni ƙǝl ƙǝs mee nanda ǝnwulteena ka ǝnɗi ndana fa lafyini. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Mairamu ƙǝsɗǝ ǝnggina haya ahurghǝn, nagha a numarha atenggǝn. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Fa lafyini wuɗa nda, na nda a aah amshe yi fal Faara ka ǝnɗi sǝknanda, tǝ na nanda, nǝghǝn ƙǝla thlǝkna tǝ Thlǝnda Faara.<verse eid="LUK 2:20" /></para>
  <para style="s">Ɗǝfang nda thlǝma Yeeso</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Ənana wanɗi ɓeena uvaɗa, thleng muwa nda, ƙǝmɗa ɗǝfang thlǝma nda Yeeso, thlǝmɗi ɗǝfna tǝ Thlǝnda Faara kapa na nda ɗǝfghǝn hur.<verse eid="LUK 2:21" /></para>
  <para style="s">Fǝr nda Yeeso ahu Wuri Faara</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />Ndukna farɗa ɓa, Mairamu tǝ Yisufu ǝnanda ǝnɗi thlǝkna ngyakhrha Musa tǝ ndaarha, a tsaɓangganda altendan ɗǝ, tǝrang ngganda Yeeso, ɗǝnda tǝghǝn Urshelima ɗǝ ƙǝsǝr a fǝrghǝnda a Chinǝm. <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />Kǝla nanǝn chichrethlee hai ahu ngyakhrha Faara, “Kala wan ˈwarha nggǝn nanda, nanda fǝranggǝn Faara.” <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />Na sataka nda ƙǝla thlǝkna ngyakhrha Chinǝm tǝ ndaarha, “Titiliukya sǝri ko wan kataprakkya sǝri ndǝna nda thleerha.”<verse eid="LUK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />A farɗi, na niifa sǝ nǝghǝn tǝ tsaurha a Urshelima, nanda aaghǝn Simiyon. Ka niifa ni, nǝn naarha ɗǝfang shilee Faara teena. Kǝmɗa nǝghǝn a ƙǝla farɗi nanda a hǝrghang nda Isǝreela. Nǝghǝn tǝ Sǝsǝna tǝ Peɗǝnda. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Sǝsǝna tǝ Peɗǝnda ndanggǝn niifɗi, mba a mǝra wa ƙǝl farɗi nana Ƙǝrǝsti tǝ yidwa. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />Nagha Sǝsǝna tǝ Peɗǝnda a shikƙǝn, kyagha Ƙǝn Faara ɗǝ, mǝmǝl tǝ sayidɗi ɓa na fa nggǝtya Yeeso ɓa tǝghǝn a Ƙǝn Faara ɓa, ƙǝla ndana hai ngyakhrha a ǝna nda. <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />Simiyon thlǝ wanɗa nǝn fal Faara nǝn, ndǝghǝn, <verse eid="LUK 2:28" /><verse number="29" style="v" sid="LUK 2:29" />“Na nǝn ya, China, kalu mafadwa hai wiigha hu ɗǝɗemnggirha, ƙǝla tǝ thlǝkna na,”<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />“Ƙǝsǝr yinna naɗǝ hǝrǝkrǝwa,<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />hǝrǝkrha ǝna na a mbed fiya heu,<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />Kukwaryirha kyadna a fiya mbuwa Yahudaya,</para>
  <para style="q2" vid="LUK 2:32">tǝ mamnggirha a nafiwa Isǝreelaya.”<verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />Chin wanɗi tǝ man ƙǝsangganda mii ndan kanda ana ǝnwulteena tǝ ǝnɗi thlǝkna Simiyon aten wanɗi. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Simiyon ɗǝfanɗǝ parka kanda teena, ndanggǝn Mairamu man wanɗi “Wur Faara wanɗiya ƙǝsǝr a tsaukwa fǝlla fingya hai, tǝ thlid fingya sǝ hangga ahur Isǝreela, nǝn tsaurha ǝnsakrha a thlǝma Faara mbuwa na mid fiya sǝ hangga. <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />Nanǝnke, ǝn ǝnandan na ahu tendan nǝn kyarha pǝpal ɓa. Ənɗiya nǝn hatta fa kaan, ƙǝla kuthla thlaukh ƙǝlara.”<verse eid="LUK 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />Na suhurra annabi sǝ nuwun, thlǝmnggǝn ni Hanatu, wan Famuwel turya Ashiru. Tsauɗǝ a chimarha yi hurarha mǝd kee. <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />Tǝrgha chimadghǝn mǝrgha. Nanǝn ya, huradghǝn kumnggit uvaɗa kap faɗa. Mbǝ malang Ƙǝn Faara wa, nǝn naarha manang thlǝm Faara nda fǝɗigrha tǝ yan fara ahu hwanda tǝ kar aama. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Mǝmǝlla sayidɗiya, kyagha ɓa nagha a usa Faara, ƙǝmɗa thlǝkɗǝ pathla aten wanɗiya a nafiya na a ƙǝla farɗi na Faara a fǝrang alteena Urshelima.<verse eid="LUK 2:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />Yisufu tǝ Mairamu ngwalang nanda ˈya ndana ngyakhrha Chinǝm, wuɗa nda tal ndan ɗǝ Nadzarat na a Nggalili. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />Man wanɗi, nǝghǝn tǝ kanglanggirha, lǝlǝgɗa tǝ sǝnda, nggayid Faara ƙǝm nǝghǝn tǝghǝn ha.<verse eid="LUK 2:40" /></para>
  <para style="s">Yeeso, wundakhne ngguchit ahur Ƙǝn Faara</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Kafad hurarha fa, fa nggǝtya Yeeso nanda ɗǝrha Urshelima ɗǝ ƙǝsǝr ka wutsǝfayid kyarhaɓa ahu sǝsaarha. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Lǝkɗangna Yeeso hurarha Kum kap sǝri tǝ nggǝtta hai, ɗenda hu wutsǝfayirha ɗǝ ƙǝla tǝ sǝsǝnna nda sa hai. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Ngwalana wutsǝfayidɗi, ƙǝs kwaman wutta nda wure ɗǝ. Tǝrgha Yeeso ishgha hai a samarha a Urshelima, kula sǝnda chin sǝ tǝ man. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />Na nda a ndaarha asǝmha nǝghǝn ahur fiya, ƙǝs wiirha nda yi paara tal. Katǝrang ngganda kaɗaghǝn hai ahur shayindan tǝ ƙǝm pashiyi ndan, <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />nawa ndan wa. Nanǝnke, wuɗa nda Urshelima ɗǝ, ƙǝsǝr a kaɗaghǝnda a mbǝɗi. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />A far ɓeena yi mahan, ɗanda walghǝn tsau ahu Ƙǝn Faara a thlǝmad famalǝmngya, ndǝghǝn a ka thlǝmarha hai, nagha ƙǝm a tsahang mee kanda ha. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Fiya na heu a mbǝɗi nanda a kang thlǝmarha fa, kanda a ƙǝs mee, wulanggǝn kanda tǝ tur sǝndǝghǝn tǝ nggǝmnda nǝn a nggǝmang kanda sǝ. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />Chin tǝ man wulang teena kanda na nandan a mbǝɗi. Ndangga man, “Waana mani ǝnangna kan kee? Nggi tǝ tsu tsǝ fannan chichakh kaan, nawanan sa.”<verse eid="LUK 2:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49" />Nggǝmanggǝn kanda tǝ ndaarha, “Kama nun kaɗa nggi? Sunggunsǝ kamɗǝ a tsawi a wuri ki Pǝpa wa?” <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Sǝngwanda numadghǝn tǝ pathɗiya wa.<verse eid="LUK 2:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51" />Thliigha mbu saman ndan nǝn, wuɗa nda Nadzarat ɗǝ heu. Nǝn naarha a na fa nggǝtyighǝn hai, man ƙǝm, ƙǝs ǝngginanǝn haya ahurghǝn. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />Yeeso ƙǝl chikrha tǝ ndǝndǝlyirha tǝ tsǝrha, hu pǝmnggǝn pǝpet a mbed Faara tǝ fiya.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">Yahaya tǝ Mbaptisǝma tangsang ɗǝ kwamana Yeeso ɗǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Ahu hurarha kumkap tuf yi kutǝryid Kaisar Tǝmbariyani; Mbuntus Mbilatus ndǝna ngwamna Yahudiya, Hirdus ndǝna kutǝr Nggalili, wanman na Filibus ndǝna kutǝr Ituriya tǝ Tarakunitas, Lisaniyas ndǝna kutǝr Ambiliya. <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />Nda Hanana tǝ Kayafa ndǝna Mamngya Firistaya. A faryini ndikka Faara tǝ Yahaya wan Dzakariya a hee. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Tǝrgha Yahaya wenggǝn chehweed yina hai na a mii kufad Djodan ndǝghǝn a thlǝk laɓar Faara a fiya tǝ ndaarha, a malangganda ɗimiyindan ka a fanangganda kanda tǝna Faara chahang ɗimiyindan kanda ɗǝ. <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />Kǝla nanǝn chichirethlee hai ahu ɗeleewar annabi Ishaya tǝ ndaarha,</para>
  <para style="q1" vid="LUK 3:4">“Urarha a aah farha a kaheerha tǝ ndaarha,</para>
  <para style="q1" vid="LUK 3:4">‘Taksaman kwamana Chinǝm sǝ,</para>
  <para style="q2" vid="LUK 3:4">katǝraman pǝpǝnang nda kwamangya ɗǝ.<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />Njighaman suhwadya heu,</para>
  <para style="q2" vid="LUK 3:5">fǝlaman mbǝya ɗǝ na ɗangkam, ɗangkam tǝ wumngya.</para>
  <para style="q1" vid="LUK 3:5">Pǝpǝnaman kwamangya ɗǝ na ƙǝƙǝɓa, ƙǝƙǝɓa tsawa nda ndip,</para>
  <para style="q2" vid="LUK 3:5">kwamangya na kukuchang nanda ngga.<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />Fiya na heu nanda a na hǝrǝkrha Faara!’”<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />Kǝsǝrke, nǝghǝn a ndang nda fiya na ɓaarha ɓa ka a fananggǝn kanda, “Kun huthlingya! Wun ƙǝsgha thlǝmannun ƙǝsǝr ka sǝbrha hur Faara na ɓayi? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />Nama ˈya kyadgha ndaarha malangɗun ɗimiyinnun. A numaɗun ahur nun ndon Ibrahim ndǝna Chinun wa. Niya ndangnda kun Faara nǝn mbang ǝnang wundakhnaya Ibrahim sǝ tǝ feryini ya. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />ˈWanda teena pangnda wurra a kul ɗǝfrha, kala ɗǝfrha mbuwa nggǝtta nanda kyathlang nda ɗǝ muwangganda ahu waarha ɗǝ.”<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Tsahangga fiya mee ha tǝ ndaarha, “Ma nan ǝnaarha mbiya?”<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />Nggǝmanggǝn tǝ ndaarha, “Niifa na tǝ lukrha sǝri tǝranggǝn niifa ha mbuwana yighǝnsǝ, niifa na tǝ ǝnnarhami ha, nagha kee ndǝghǝn nggima.”<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />Fa thlǝ tsamngya ƙǝm ɓa nda ɓa na a fananggǝn kanda, tsahang mee nda, “Mala, ma nan ǝnaarha?” <verse eid="LUK 3:12" /><verse number="13" style="v" sid="LUK 3:13" />Ndanggǝn kanda, “A thlǝɗun ˈya kalgha yanɗamu tǝ thlǝghang nanda kun wa.” <verse eid="LUK 3:13" /><verse number="14" style="v" sid="LUK 3:14" />Sodjaya ƙǝm tsahang mee nda ha, “Kanggiwu ma nan ǝnaarha?” Ndanggǝn kanda, “A ngyaɓangɗun fiya a fǝrang wuɗǝɓǝla nda kun wa. A nggaɓaɗun kanda ƙǝsǝr a fǝrang ˈya nda kun wa. Usama Faara tǝ ˈya na nda a teng nda kun.” <verse eid="LUK 3:14" /><verse number="15" style="v" sid="LUK 3:15" />Nana fiya a ƙǝla ɓad Ƙǝrǝsti fa ɓa, tǝrgha fiya na heu kanda a numarha ahur ndan tǝ ndaarha, ko Yahaya ndǝna Ƙǝrǝsti ɗi. <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Ndangga Yahaya kanda, na heu, “Niya fanang nda kun tǝ aama. Amma niifa sǝ na ɓayi na tǝ sǝsǝmnda fa kalgha nggi mu, tsǝkki na a kwasanggi sahad pahamggǝn hai wa, ndǝghǝnggi ɓanǝn fanang nda kun tǝ Sǝsǝna tǝ Peɗǝnda tǝ waarha. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />Nǝghǝn tǝ ɗeng pǝra ha, nǝn a pǝrang ɗiɗiirha ɗǝ ngwanggǝn wan hwalidghǝn ahu ɓirukkun hai. Nǝn a njang nda ɗiɗidghǝn ɗǝ tǝ Waarha mbuwa mǝra hai.” <verse eid="LUK 3:17" /><verse number="18" style="v" sid="LUK 3:18" />Tǝ yiyi thlamarha hangga, Yahaya thlǝkɗǝ laɓar Faara na ngga a fiya. <verse eid="LUK 3:18" /><verse number="19" style="v" sid="LUK 3:19" />Yahaya yanang ɗǝ Hirdus, ƙǝsǝr Hirdus kahang ɗǝ Hirudiya nu wanman, tǝ ƙǝm ǝnaɗǝ ǝngya mbuwa ngga. <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />A kwasamadghen Hirdus nggǝrɗǝ sǝɓang nda ɗǝ tǝ ngyakhrha fǝrnǝn a kanda heu. A ƙǝsangganda Yahaya changganda ƙǝnɗǝ.<verse eid="LUK 3:20" /></para>
  <para style="s">Fanang Yahaya Yeeso</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />A kwasamadɗi fanang nda fiya, Yeeso ndǝghǝn nggima fanangganda. Tǝrgha nanǝn a hwan Faara, frakh amshi inggaɗǝ, <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />Sǝsǝna tǝ Peɗǝnda tǝrgha atenggen hai ƙǝla titiliurha, sǝk urarha nda a talara hai tǝ ndaarha, “Sani na waana tǝtali nggǝmni, tǝkɗi mbǝnduwa fa kaan.”<verse eid="LUK 3:22" /></para>
  <para style="s">Turya Yeeso</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />A farɗi katǝrangna Yeeso targhǝn hai yi tsaharhaha, nǝghǝn a kaɗa hurarha kumnggit mahan ahu ƙǝshiirha. Tǝrgha fiya ndǝn tǝ ndaarha wan Yisufuni,</para>
  <para style="q1" vid="LUK 3:23">na wan Heli, <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />Heli wan Mattaat,</para>
  <para style="q1" vid="LUK 3:24">Mattaat wan Lawi, Lawi wan Malki,</para>
  <para style="q1" vid="LUK 3:24">Malki wan Yanna, Yanna wan Yisufu,<verse eid="LUK 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 3:25" />Yisufu wan Mattaatiya, Mattaatiya wan Amos,</para>
  <para style="q1" vid="LUK 3:25">Amos wan Nahum, Nahum wan Asaliya,</para>
  <para style="q1" vid="LUK 3:25">Asaliya wan Nanjaya, <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />Nanjaya wan Maˈata,</para>
  <para style="q1" vid="LUK 3:26">Maˈata wan Mattaatiya, Mattaatiya wan Shimeya,</para>
  <para style="q1" vid="LUK 3:26">Shimeya wan Njosek, Njosek wan Yahuda,<verse eid="LUK 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LUK 3:27" />Yahuda wan Yowanan, Yowanan wan Refaya,</para>
  <para style="q1" vid="LUK 3:27">Refaya wan Dzarubabel, Dzarubabel wan Sheyaltiyel,</para>
  <para style="q1" vid="LUK 3:27">Sheyaltiyel wan Niri, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />Niri wan Malki,</para>
  <para style="q1" vid="LUK 3:28">Malki wan Addi, Addi wan Kosama,</para>
  <para style="q1" vid="LUK 3:28">Kosama wan Almadama, Almadama wan Er,<verse eid="LUK 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 3:29" />Er wan Djoshuwa, Djoshuwa wan Eliyeser,</para>
  <para style="q1" vid="LUK 3:29">Eliyeser wan Yorim, Yorim wan Mattaat,</para>
  <para style="q1" vid="LUK 3:29">Mattaat wan Lawi, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />Lawi wan Simiyon,</para>
  <para style="q1" vid="LUK 3:30">Simiyon wan Yahuda, Yahuda wan Yisufu,</para>
  <para style="q1" vid="LUK 3:30">Yisufu wan Yonana, Yonana wan Eliyakim,<verse eid="LUK 3:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="LUK 3:31" />Eliyakim wan Malaya, Malaya wan Mainana,</para>
  <para style="q1" vid="LUK 3:31">Mainana wan Mattaata, Mattaata wan Natan,</para>
  <para style="q1" vid="LUK 3:31">Natan wan Ndauda, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />Ndauda wan Njessi,</para>
  <para style="q1" vid="LUK 3:32">Njessi wan Obida, Obida wan Mbuwasa,</para>
  <para style="q1" vid="LUK 3:32">Mbuwasa wan Salmon, Salmon wan Nashon,<verse eid="LUK 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LUK 3:33" />Nashon wan Amminadab, Amminadab wan Aram,</para>
  <para style="q1" vid="LUK 3:33">Aram wan Hesruna, Hesruna wan Feresa,</para>
  <para style="q1" vid="LUK 3:33">Feresa wan Yahuda, <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />Yahuda wan Yakubu,</para>
  <para style="q1" vid="LUK 3:34">Yakubu wan Ishaku, Ishaku wan Ibrahim,</para>
  <para style="q1" vid="LUK 3:34">Ibrahim wan Tera, Tera wan Nahor,<verse eid="LUK 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LUK 3:35" />Nahor wan Serug, Serug wan Reyu,</para>
  <para style="q1" vid="LUK 3:35">Reyu wan Feleg, Feleg wan Eber,</para>
  <para style="q1" vid="LUK 3:35">Eber wan Shela, <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />Shela wan Kenan,</para>
  <para style="q1" vid="LUK 3:36">Kenan wan Arfakshad, Arfakshad wan Shem,</para>
  <para style="q1" vid="LUK 3:36">Shem wan Nuhu, Nuhu wan Lamek,<verse eid="LUK 3:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="LUK 3:37" />Lamek wan Metusela, Metusela wan Enok,</para>
  <para style="q1" vid="LUK 3:37">Enok wan Yared, Yared wan Mahalalel,</para>
  <para style="q1" vid="LUK 3:37">Mahalalel wan Kenan, <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />Kenan wan Enosh,</para>
  <para style="q1" vid="LUK 3:38">Enosh wan Shitu, Shitu wan Adamu,</para>
  <para style="q1" vid="LUK 3:38">Adamu ƙǝm wan Faara.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">Sheetan ƙǝƙǝrangɗǝ Yeeso</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Yeeso lǝlǝgɗa tǝ Sǝsǝna tǝ Peɗǝnda wud nǝn ɓa a kufad Urdun, nagha Sǝsǝna a shikƙǝn a kaheerha ɗǝ. <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />A mbǝɗi ƙǝƙǝrangga sheetan yi ɓeena kumnggit faɗa. Akwasamadghǝn ƙǝsgha mirha ndǝn, ƙǝsǝr ǝnawa ˈya mii wa. <verse eid="LUK 4:2" /><verse number="3" style="v" sid="LUK 4:3" />Ndangga sheetan, “Ana Wan Faara ni sa tsawang ferɗiya ka mburodi.” <verse eid="LUK 4:3" /><verse number="4" style="v" sid="LUK 4:4" />Nggǝmangga Yeeso, “Nǝghǝn chichireethlee hai ahu ɗeleewar Faara mbǝ tǝ ǝnnarhami kee na niifa ƙǝrasǝ wa.” <verse eid="LUK 4:4" /><verse number="5" style="v" sid="LUK 4:5" />Tǝrgha sheetan ɗǝgha tǝghǝn a mbǝrha ɗǝ na ɗangkam kaan, kyaɗang kutǝryid ƙǝshiirha nǝn ahu shibrha yirha. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />Ndangga sheetan, “Sa niya furo sǝsǝmnda kutǝryid ɗiya tǝ mamnggitghǝn, ƙǝsǝr nggi fǝreena ndan, a nggǝmɗi ni fǝranggǝn niifa nggǝmna hurna. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Na heu niya furoƙǝn a ɗǝfenna shilee teena.” <verse eid="LUK 4:7" /><verse number="8" style="v" sid="LUK 4:8" />Nggǝmangga Yeeso, “Nǝghǝn chichireethlee hai tǝ ndaarha,</para>
  <para style="q1" vid="LUK 4:8">“‘ɗǝfang shilee Faarwa teena,</para>
  <para style="q1" vid="LUK 4:8">ndǝghǝn katenggǝn.’ ”<verse eid="LUK 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="LUK 4:9" />Tǝrgha sheetan ɗǝgha tǝ Yeeso a Urshelima ɗǝ, tǝranggǝn talakh ten Ƙǝn Faara sǝ ndanggǝn, “Ana Wan Faara ni sa, puru hweeɗa hai. <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />Ƙǝsǝr nǝghǝn chichireethlee hai tǝ ndaarha,</para>
  <para style="q1" vid="LUK 4:10">‘Nǝn fǝrang sǝsǝmnda fathlǝnggighǝn a laf sa nda,</para>
  <para style="q2" vid="LUK 4:10">ƙǝla sa nda ha.<verse eid="LUK 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11" />Tǝ ƙǝmɗaarha, nanda a nggawo sǝ tǝ haryindan,</para>
  <para style="q2" vid="LUK 4:11">ƙǝsǝr naɗǝ ɗǝghang sarwa feera fa.’ ”<verse eid="LUK 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="LUK 4:12" />Ndangga Yeeso, “Nǝghǝn chichireethlee hai,</para>
  <para style="q1" vid="LUK 4:12">‘A ƙǝƙǝrangna Chinǝm Faarwa wa.’ ”<verse eid="LUK 4:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />Akwasamadɗi ngwalangna sheetan ƙǝƙǝrang nda Yeeso, ndekka hai tǝghǝn ˈwan.<verse eid="LUK 4:13" /></para>
  <para style="s">Yeeso Katǝrang ɗǝ Tsaharhaha a Nggalili</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Yeeso wudɗǝ a Nggalili ɗǝ lǝlǝgɗa tǝ sǝsǝmnda Sǝsǝna tǝ Peɗǝnda, laɓarghen welɗǝ hu talya ɗǝ na hu chehwedɗi. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />Tsahaɗaha ahu Ƙǝn Faara hangga ko wuni falɗa ndǝn.<verse eid="LUK 4:15" /></para>
  <para style="s">Kar nda Yeeso fa a Nadzarat</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Ɗǝgha Nadzarat ɗǝ mbǝɗi mannǝnsǝ, kyagha Ƙǝn Faara ɗǝ a far yiɓǝd Yahudaya ƙǝla sǝsǝnnǝn sa hai. Thliigha sǝ nǝn a karatarha, <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />fǝrang ɗeleewar annabi Ishaya nda. Inanggǝn ɗeleewar ɗa hai, wal mbǝrha nǝn chireethleng nanda hai tǝ ndaarha,<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />“Sǝsǝn Chinǝm nǝghǝn tǝ nggi ha,</para>
  <para style="q2" vid="LUK 4:18">ƙǝsǝr wurɗǝ nggi,</para>
  <para style="q2" vid="LUK 4:18">na a ɓang laɓar Faara ni fa yamiya ɓa.</para>
  <para style="q1" vid="LUK 4:18">Na a kalmii kalla nafiya ni ƙǝnangna ɗimiyirha kanda hai.</para>
  <para style="q2" vid="LUK 4:18">A inanggi yid kwamaya ɗǝ.</para>
  <para style="q1" vid="LUK 4:18">A kal fiya ni hai njithlang nanda kanda hai.<verse eid="LUK 4:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19" />Tǝ ƙǝm, a thlǝghang ndaarha ni fiya na heu, ɓad ɓeena ɓa na Chinǝm a hǝrghang nafiyighǝn.”<verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />Ngwalang nǝn karataarha, nggǝlanggǝn ɗeleewarɗi fǝranggǝnǝn niifɗa ɗǝ na a ƙǝla ƙǝnɗa ha tsaukwa hai. Fiya heu na a ƙǝnɗi irang yirha nda fa, <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />katǝranggǝn ndangnda kanda, “Aweeriya laɓar ɗiya lǝghǝdɗǝ ahu thlǝman nun hai.”<verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />Kanda heu na a mbǝɗi tǝk nda mbǝndǝghǝn fa, kanda a na ǝnwulteena tǝ laɓarya na mbǝnggǝn na a kyarhaɓa a miighǝn, na nda a ndaarha, “Ndeye, mbǝ wan Yisufuni ya wa?”<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />Ndangga Yeeso kanda, “Sǝnɗisǝ nun thlǝye tur karapu ɗafa ya, ‘tǝ purha ƙǝnang fadwa’ non a ndeerha ‘ǝno ǝnɗi tǝ sǝknan ǝnanna a Kafarnahum ahu talɗi kyawa ya lee.’ ” <verse eid="LUK 4:23" /><verse number="24" style="v" sid="LUK 4:24" />Nggǝrghǝn ndang kanda, “Niya thlǝghang ƙǝkafek kun, mbǝ annabi sǝ na nda thlǝghǝn fa ahu talghǝn wa.<verse eid="LUK 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 4:25" />“Keema thlǝmarha fa, nǝghǝn ƙǝkafek na nishya sǝ mǝrna chimayi ndan hangga a Isǝreela athlakh mbǝd annabi lliya, ɓa waana ˈyaara hurarha mahan tǝ ndǝre mikki. Kyagha miirha hu chehwedɗa hai kaan. <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />Ko nanǝn kee, thlǝn ngwanda Iliya a thlǝmad ko tal ɗǝ ahur ndan wa, thlǝngga ndan a thlǝmad nuneefa ɗǝ mǝrna chimadghǝn a Nzarifat na a chehweed Sidon. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />Athlakh mbǝd annabi Ilesha ƙǝm, na fa termeeya sǝ hangga a Isǝreela. Mbusǝ ko tǝtal ƙǝnang nanda wa, ƙǝl Naˈaman tǝ Suriyarha katenggǝn.”<verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />Sǝk nanda laɓarɗi kee, fiya heu na a Ƙǝn Faara sǝbgha hur ndan ɗǝ. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Thlii nda sǝ kyang ngganda Yeeso sǝ ma hur talɗi, ɗǝnda tǝghǝn ten ferɗa ɗǝ tǝnna nda talɗa sǝ. Mindan sǝ a muwang ngganda hweeɗe hai. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />Amma kyagha tǝ pathlang ndan wii fayighǝn nǝn.<verse eid="LUK 4:30" /></para>
  <para style="s">Kǝnang Yeeso niifa na tǝ ǝnkaheerha fa</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Tǝrgha wiigha Kafarnahum ɗǝ, ahu tala ɗǝ na a chehweed Nggalili, nagha a tsahang kanda ha a far yiɓǝd Yahudaya. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />Tsahadghǝn ha a ǝnang ǝnwulteena kanda, ƙǝsǝr laɓarghǝn nǝghǝn tǝ (sǝsǝmnda) ngyakhrha.<verse eid="LUK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33" />Ahu ƙǝn hwan Faarɗi na niifa sǝ na tǝ ǝnkaheerha fa. Tǝranggǝn uradghǝn sǝ kaan ndaagha, <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />“Iyau! Miwa tǝ kan Yeeso tǝ Nadzarat? Ɓa na ɓa ka a rǝk kanna wa? Sǝnɗi sa, sani (tǝ Peɗǝnda) na Tsǝtsaɓaɗǝ Wan Faara.”<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />Yanangga Yeeso ǝnkaheedɗi ndanggǝn “Nggasu hai kyosǝ ahur niifɗiya.” Tǝrgha tǝrangga ǝnkahedɗi niifɗa sǝ muwanggǝn hweeɗe hai a mbendan, ambǝra ndǝkka hai tǝghǝn malanggǝn niifɗi kula wal wundǝrha fa.<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />Nafini na heu ƙǝsangga ǝnwulteena kanda na nda a ndangnda ndan “Tur mani kee? Tǝ kanglanggirha, tǝ sǝsǝmnda niifɗiya ndanggǝn ǝnkaheeya kyanda sǝ, pa kya nda sǝ.” <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Ənɗi ǝnana Yeeso ya, kanda a tsǝ laɓarghǝn ko a yanggi ni ahu chehwedɗi.<verse eid="LUK 4:37" /></para>
  <para style="s">Yeeso ƙǝnangɗǝ fiya hangga</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />A kwasamadɗi kyana Yeeso hai a Ƙǝn Faara, kyagha wuri ki Siman hai. Thlaɓǝr Siman tǝ nuwunda tǝ ɓeerha farha, hwan nggǝnda a ɗanggǝn sǝ. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Ishgha Yeeso atenggen, yananggǝn wan hadɗi a ndǝkka hai tǝghǝn, ndǝkka wanhadɗa hai tǝghǝn. Thliigha sǝ kaɗang ǝnnarhami nǝn kanda sǝ.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Tsǝna figrha hai ɓagha fiya ɓa tǝ pashiyi ndan na tǝ wanhaya ɗǝɗamǝn-ɗǝɗamǝn, ɗǝfang haara nǝn kanda teena, ƙǝnanggǝn kanda heu. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />Ənkaheeya ƙǝm, kyanda sǝ a fad fiya hangga, kanda ahuhwaarha tǝ ndaarha, “Sa Wan Faara ni,” njaranggǝn kanda ɗǝ, ˈyaɗang ndikrha nǝn kanda fa ƙǝsǝr sǝnda sǝ ndǝghǝn ni Ƙǝrǝsti.<verse eid="LUK 4:41" /></para>
  <para style="s">Yeeso thlǝkɗǝ laɓar Faara ahu ƙǝngya hwan Faara</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Ɗalthna mbǝrha hai, ɗǝgha Yeeso a mbǝrha ɗǝ mbuwana fiya sǝ. Nagha fiya a kaɗaghen, walang ngganda, hwan nggǝnda na a tsaukwa tǝ kanda. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />Amma ndangga Yeeso kanda, “Kamɗǝ aɗi tǝ Laɓarɗi na Mbǝnggǝn ya, yi Kutǝryid Faara ahu talya ɗǝ pak, ƙǝsǝr nden thlǝn nanda nggi ɓa kamanggǝn.”<verse eid="LUK 4:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44" />Tǝrgha ɗǝgha mbeeɗǝ tǝ thlǝk laɓarghǝn ahu ƙǝngya hwan Faara a chehweed Yahudiya.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">Yeeso katǝrangɗǝ aah fatsahayighǝn</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />Na farɗa sǝ Yeeso ƙǝt a mii Wuri Aam Nggalili. Nduwusgha fiya thlǝmadghen ɓa hangga kanda ˈyaɓang mbǝrhafa ka a sǝk laɓar Faara nda. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Yeeso na kombuwalya nǝn sǝri a mii wuri aamɗi. Fa kombuwalyini kyanda sǝ kanda a tsaɓang panggamnggindan ɗǝ. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Tǝrgha ahur tal hai, yi Siman, ndanggǝn a puwanggǝn kombuwalghǝn ahu aamɗa hai ngguchit ma ƙǝƙǝshɓangnda. Tsauka ahurghǝn nagha a tsahang fiya ha.<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />Ngwalanǝn ndikrha, ndanggǝn Siman, “Puwan kombuwal ɗi a mbǝd kuɗimnda ɗǝ, muwanggun panggam ɗa hai, ƙǝs tǝna nun.”<verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />Nggǝmangga Siman, “Paɓa, ka a fǝɗigrha kan a mukrha, mbǝ ˈya sǝ walnan wa. Amma ndana kee, niya muwang panggam ɗi sa hai.”<verse eid="LUK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6" />Muwangganda panggamɗi kyandan sa hai, ƙǝs tǝna nda hangga, nagha panggamɗi a thluwussa. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />Tǝrgha aah pashiyi ndan nda ɓa na ahu tahad kombuwalɗi a ɓa nda ɗang kanda sǝ. Lǝɗang ngganda kombuwalya sǝri tǝ tǝna, nagha kombuwal yini a timnda hai ka haarha.<verse eid="LUK 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8" />Nana Siman Mbiturus ǝnɗi katǝragha hai ɓǝrgha hai a mbed Yeeso ndagha, “Mala, kalu kwamanna hai, ƙǝsǝr tǝ ɗimiyirha ni nggi!” <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />Ƙǝsǝr ndǝghǝn tǝ nafiya na nanda heu, wulang teena kanda ka tǝnɗi ƙǝs nanda. <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />Nanǝn kee, nda Yakubu tǝ Yahaya wangya Dzabadi, pashiya tar Siman Mbiturus. Ndangga Yeeso Siman Mbiturus, “Ma tǝrǝmna wa; nanǝn ya fiya na a ƙǝsa ɓa mbǝ tǝna wa” <verse eid="LUK 5:10" /><verse number="11" style="v" sid="LUK 5:11" />Kahangganda kombuwal yindan ƙǝƙǝsh ɓangnda ɓa, malangganda ˈya na heu mbu samad Yeeso nda.<verse eid="LUK 5:11" /></para>
  <para style="s">Yeeso ƙǝnangɗǝ tǝ termeerha</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Fara sǝmǝn na Yeeso ahu tala a chehweed Nggalili, na niifa sǝ na wanhad termeerha a sǝsangnda. Nanǝn Yeeso, ɓagha ɓa, ɓǝrgha hai a mbedghǝn, hwanggǝn nǝn ndanggǝn, “China, a nggǝmna fa, tsaɓeeɗǝ.”<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />Tǝrgha Yeeso fǝr harghǝnǝn ɗǝ, tsuwarghǝnǝn fa ndanggǝn, “Nggǝmɗi fa a tsaɓanaɗǝ. Tsaɓuɗǝ!” A mbǝɗi kee, termedɗi ndǝkka hai tǝghǝn.<verse eid="LUK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 5:14" />Ƙǝsgha Yeeso thlǝmadghǝn, ndanggǝn, “A pǝrangnan niifa wa ɗuwaɗǝ kyaɗang fadwa firis na sa nǝn. A ǝno sataka tǝna fiya sǝndasǝ tsabnaɗǝ ƙǝla tǝ ndana Musa.”<verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />Nanǝn kee, laɓar Yeeso ƙǝl chik ɗǝrha mbeeɗǝ, fiya hangga aten ɓarha ɓa ƙǝsǝr a kang thlǝmanda fa tǝ ƙǝmɗa a wal ƙǝnda nda ahu wanhayindan. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Amma, Yeeso nǝn naarha ɗǝrha mbǝrha ɗǝ katenggǝn mbuwana fiyasǝ nagha a hwan Faara.<verse eid="LUK 5:16" /></para>
  <para style="s">Yeeso ƙǝnangɗǝ niifa mǝrna fadghǝn hai</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Farɗa sǝ Yeeso a tsaharhaha, fingya Farisaya tǝ fa sǝngya ngyakhrha tsǝtsau a mbǝɗi. Ɓagha nda ɓa ahu talya Nggalili tǝ Yahudiya tǝ ƙǝm ahu tal Urshelima. Sǝsǝmnda Chinǝm nǝn teghǝn ha ƙǝsǝr a ƙǝnanggǝn nafiya na tǝ wan haya fa. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />Kanda sǝ, ɓagha nafiya ɓa tǝ niifa mǝrna fadghǝn hai, kath aten ɗǝnggǝla. Na nda a kaɗa kwamana a ɗǝnda tǝghǝn wure hai a hunang ngganda hai a mbed Yeeso. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />Walwa nda kwamana wa ka hangnda fiya. Kǝla nda hai mbǝ kwamana sǝ wa, thlǝɓangganda ten ƙǝnna ɗǝ fǝrghǝn nda hai tǝ ɗǝngǝlɗi hunangganda hai a maɗufud fiya a mbed Yeeso.<verse eid="LUK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20" />Nana Yeeso fǝrƙǝkafǝkkin ndan, ndanggǝn hadɗi na kath, “Pashinna chohonda ɗimiyidwa ɗǝ.”<verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />Fasǝngya ngyakhrha tǝ Farisaya kanda a numarha tǝ ndaarha, “Wunniya na thlǝk laɓar sarfadɗiya a Faara? Ai Faara katenggǝn ndǝna chakh ɗimiyirha.”<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />Walangna Yeeso ǝnɗi nanda a numarha, ndanggǝn kanda, “Kama nda nun ǝna tur numadɗiya? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />Yanggi ni pǝpa, ‘Ndarha chohonda ɗimiyid wa ɗǝ wa,’ nduwa ‘Thliusǝ wiu wa?’ <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Amma na minna sǝ a sǝnunsǝ tǝ ndaarha Wan Niifa nǝghǝn tǝ ngyahad chakh ɗimiyirha ahu ƙǝshidɗiya.” Ndanggǝn tǝ mǝrra fadɗi, “Ndoyi thliusǝ, tǝrang ɗǝnggǝlwa wiu wure ɗǝ!” <verse eid="LUK 5:24" /><verse number="25" style="v" sid="LUK 5:25" />A mbǝɗi kee, thliigha niifɗa sǝ a yid fiya, tǝranggǝn ɗǝnggǝlghǝn sǝ nǝn hunaarha sǝ ƙǝtǝm wiigha wure ɗǝ nagha a fal Faara. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />Kanda na heu ɗǝf haara nda mii, ka ǝnwulteena nana nda na nda a fal Faara. Lǝlǝgɗa tǝ tǝrǝmnda na nda a ndaarha, “A weeriya na ɗan ǝnwulteena!”<verse eid="LUK 5:26" /></para>
  <para style="s1">Yeeso aah ɗǝ Lawi</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />A kwasamadɗi kyana Yeeso sǝ, na niifa nǝn tǝ thlǝ tsamnda thlǝmnggǝnni Lawi tsau a thlǝ tsamnda ndangga Yeeso, “Mbuwu samanna,” <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />Lawi malanggǝn ˈya na heu, thliigha sǝ mbusamadghǝn nǝn. <verse eid="LUK 5:28" /><verse number="29" style="v" sid="LUK 5:29" />Tǝrgha Lawi ngwagha fa ǝna wutsǝfayirha nǝn manggǝn a wuri keeghǝn. Yeeso ndǝn na ronga na manggǝn. Fa thlǝ tsamngya hangga tǝ fingya nafiya kanda a hǝb ǝnnarhami tǝ Yeeso. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />Amma Farisaya tǝ Fasǝngya ngyakhrha, katǝrang ngganda huhurumnda hai ndang ngganda fatsahaya Yeeso, “Kama na nun a hǝbrha tǝ sarha tǝ fa thlǝ tsamngya tǝ fa ɗimiya?” <verse eid="LUK 5:30" /><verse number="31" style="v" sid="LUK 5:31" />Nggǝmangga Yeeso kanda, “Nafiya na ƙǝkanglang mba nda kaɗa tǝpuurha wa, ƙǝl haaya. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />Ɓayi ɓa ka fiya na ǝna ˈya ngga wa, ƙǝl fa ɗimiya, a malangganda ɗimiyindan.”<verse eid="LUK 5:32" /></para>
  <para style="s1">Tsakhmee aten kar aama</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Fingya nafiya sǝ ndang ngganda Yeeso, “Fa fatsahaya Yahaya tǝ Mbaptisǝma, nanda kar aama ƙǝtsar tǝ hwan Faara, na Farisaya kee. Fǝnayiwa kanda hǝbrha tǝ sarha parang.” <verse eid="LUK 5:33" /><verse number="34" style="v" sid="LUK 5:34" />Nggǝmangga Yeeso kanda tǝ ndaarha, “Nun mbang ngyaɓang kar aama pashiya wutsamnda fa ndǝghǝn ɓalɗǝ a thlǝmandan wa? <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Na farghǝn ɓayi na nda a tǝrang mal kanda nǝn. A farɗi ndǝnanda a kar aama.”<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />Tǝrgha Yeeso fǝrang karapu nǝn kanda tǝ ndaarha, “Mbǝ niifa sǝ na njar kukwasharraɓa a fat lukrha na ngga mbuhwang nggǝnǝn kukwasharra fa wa. A ǝna ɗǝ kee, ƙǝl njarang nǝn luwudɗa ɗǝ na ngga, ƙǝsǝr mbuhudɗi mbuhwang nǝn suhurra luwudɗa fa tǝ yanɗi na ngga mbǝ kamang wa. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />Tǝ ƙǝm mbǝ niifa sǝ na irang weerǝnda aam inabi ahu suhurra samsami hai wa. A ǝna ɗǝ kee, na weerǝnda aam inabi ɗi ɗathlang nda samsami ɗa ɗǝ. Nǝn iraɗǝ, sǝbgha samsami ɗa ɗǝ. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Kamɗǝ weerǝnda aam inabi nǝm irangnda ahur weerǝnda samsami hai. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />Mbǝ niifa sǝ na nggǝm weerǝnda aam annab a kwasamadɗi sanǝn yanɗi mǝngga ɗǝ wa, ‘Ai, nǝn ndaarha yanɗi mǝngga ɗǝ kal ɗa ndǝn mbǝnda.’ ”<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s1">Tsakhmee a tǝn laf far Yibrha</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Na fara sǝmǝnsǝ, far Yibrha Yahudaya, Yeeso tǝ fatsahayighǝn tǝrnda kwaman heerha; tǝrgha fatsahayighǝn kya ten ǝnnarhami nda na ƙǝla wan hwaliirha fahwang ngganda hai na nda a kiighǝn. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Ndagha fingya Farisaya, “Mani nun ǝna ˈya kee ˈyaɗana ngyakhrha Musa yi far Yibrha?” <verse eid="LUK 6:2" /><verse number="3" style="v" sid="LUK 6:3" />Nggǝmangga Yeeso kanda tǝ ndaarha, “karatang ngwanun ǝnɗi na hu ɗeleewar Faara ǝnana Ndauda tǝ nafighǝn na miirha a ƙǝs kanda wa? <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />Kyana Ndauda a Ƙǝn Faara ɗǝ tǝrnǝn mburodi sǝ ɗǝfangna nda ɗǝ ka firis katenggǝn, kiigha har ǝnangǝn pashiya wiyighǝn ha.” <verse eid="LUK 6:4" /><verse number="5" style="v" sid="LUK 6:5" />Ngwalanggǝn pathɗi tǝ ndaarha, “Ai, Wan Niifa Chinani har tǝ far Yibrha.”<verse eid="LUK 6:5" /></para>
  <para style="s">Niifa mǝrna harghǝn hai</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />A fara sǝmǝn far Yibrha Yahudaya fadghǝn, Yeeso kyaɗǝ Ƙǝn Faara ɗǝ a tsaharhaha. Na niifa sǝ a mbǝɗi mǝrna harghǝn a yisǝma. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Tǝrgha fa malǝmgya ngyakhrha tǝ Farisaya kanda a ƙǝla Yeeso ha tǝ nǝn a ƙǝnang nda fiya a far Yibrha ƙǝsǝr a ƙǝsangganda tǝ ɗimiyirha. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Yeeso sǝn ɗǝ ǝnɗi nanda a numarha. Ndanggǝn niifɗi wu, “Thliusǝ ɓa isha a mbǝɗiya.” Tǝrgha niifɗi thliigha sǝ isha a mbǝɗi.<verse eid="LUK 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9" />Ndangga Yeeso kanda, “Niya tsahang mee kun ha, ma kamngga a nam a far Yibrha? Əna nggayirha nǝm, nduwa mbǝlfeerha wa? A hǝrghanggǝm yibrha, nduwa ɓǝlanggǝm wa?” <verse eid="LUK 6:9" /><verse number="10" style="v" sid="LUK 6:10" />Tǝrgha ƙǝlanggǝn kanda na heu; akwasamadghǝn ndanggǝn niifiɗiwu, “Pǝpǝnang harwa ɗǝ.” Ndǝghǝn nggi ƙǝm pǝpǝnanggǝn harghǝn ɗǝ. Tǝrgha harɗi pǝpǝngga ɗǝ. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />A mbǝɗiwu hur Farisaya tǝ fa malǝmgya sǝbgha ɗǝ kaan, katǝrang ngganda thlǝk pathla hai aten ˈya na nda ǝnaarha tǝ Yeeso.<verse eid="LUK 6:11" /></para>
  <para style="s">Wur Yeeso fathlǝngya Kum kap sǝri.</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />A hu ɓengginiya, Yeeso tǝrɗǝ ten feera sǝ ka a hwangga. Mǝnggǝn ka hwan Faara. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Ɗalthna mbǝrha hai aah fatsahayighǝn nǝn ɓa, wurgha hasǝ ahur ndan Kum kap sǝri, aah kanda nǝn fathlǝnggighǝn. <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Kanda na Siman, ɗǝfang na Yeeso thlǝma Mbiturus, tǝ wanman Andǝrawus, tǝ Yakubu, tǝ Yahaya, tǝ Filibus, tǝ Mbatalomi, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />tǝ Matiyu, tǝ Toma, tǝ Yakubu wan Halfa, tǝ Siman na nda aarha tǝ sǝrǝk chehweedghǝn, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />tǝ Yahuda wan Yakubu, tǝ ƙǝm Yahuda Iskaryoti, tǝ tsaukwa tǝ thlǝrɓu.<verse eid="LUK 6:16" /></para>
  <para style="s1">Yeeso Tsahangɗǝ Fiya ha tǝ ƙǝm ƙǝnang ɗǝ kanda</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />Tǝrgha Yeeso tǝraa hai tǝ kanda ishgha a pǝpal tǝ fiya hangga na mbusamadghǝn. A mbǝɗi ƙǝm fiya hangga ɓagha ɓa a Yahudiya tǝ Urshelima, tǝ ƙǝm chehweed Taya tǝ Sidon na tsau tǝ wuri aama. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />Ɓagha nda ɓa ka a sǝk laɓarghǝn nda tǝ ƙǝm awal ƙǝnda nda ahu wan hayindan. Kǝnanggǝn fiya na ǝnkaheeya a sǝsang kanda. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Fiya na heu a kaɗa kwamana na a tsuwarghǝn ndafa ƙǝsǝr sǝsǝmnda a kyarhaɓa a fadghǝn na a ƙǝnanggǝn kanda.<verse eid="LUK 6:19" /></para>
  <para style="s1">Wutsǝfayirha tǝ sǝsaarha</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Yeeso ƙǝlanggǝn fa tsahayighǝn sǝ ndanggǝn kanda, “Nafiya ni kun na tǝ parka, kun na fa yamiya; ƙǝsǝr Kutǝryid Faara yinun ni! <verse eid="LUK 6:20" /><verse number="21" style="v" sid="LUK 6:21" />Nafiya ni kun na tǝ parka, kun na miirha a ƙǝs kun nanǝn ya; ƙǝsǝr nun a nggaala! Nafiya ni kun na tǝ parka, kun na a tǝrha nanǝn ya; ƙǝsǝr nuna maasa! <verse eid="LUK 6:21" /><verse number="22" style="v" sid="LUK 6:22" />Kun fa parkayani, na fiya a ƙarkun, kanda a wurang kun ɗǝ, kanda ˈyar kun tǝ ndaarha kun fa mbǝlfeeya ni ƙǝsǝr ka Wan Niifa!”<verse eid="LUK 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23" />“Nama wutsǝfayirha a katǝra ǝnɗa haya, tǝ ƙǝm rǝɓama ka wutsǝfayirha ƙǝsǝr nun wal ƙǝnaghǝn hangga a talara. Ƙǝsǝr ƙǝtǝm nangga chichiyindan annabiya kee.”<verse eid="LUK 6:23" /></para>
  <para style="s">Ən Kawa</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 6:24" />“Kawama nafiya, kun na tǝ ƙǝna ha nanǝn ya, ƙǝsǝr ˈwaɗun teena tǝk ɗun mbǝndafa! <verse eid="LUK 6:24" /><verse number="25" style="v" sid="LUK 6:25" />Kawama nafiya nggalgha nanǝn ya, ƙǝsǝr ɓa na miirha ƙes kun! Kawama, kun na maasa nanǝn ya, ƙǝsǝr na hur nun a sǝbrha ɗǝ non a tǝrha! <verse eid="LUK 6:25" /><verse number="26" style="v" sid="LUK 6:26" />Kawama, kun na fiya a faala ƙǝsǝr nangga chichiyindan annabiya fa nggaɓaya kee.”<verse eid="LUK 6:26" /></para>
  <para style="s1">Kyaɗaman nggǝmnda nafiya na tsan kun.</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />“Niya ndang nda kun na sǝk fanna, nggǝmama fiya na tsan kun. Nama ˈya na ngga a fiya na karkun. <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />Ɗǝfaman parka fiya teena na ˈyarkun, tǝ ƙǝm hwana man Faara fiya teena na sǝsang kun. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />A mbi niifa sa ahu yanɗi ƙǝmenga ya, kyakhrang man patu ɓa. Athlang niifa kapad wa, ƙǝɗang yanɗa hai na ngguchit. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />Kala niifa hwanowa ˈya, fǝrang, niifa ƙǝm thlangga ǝnwa a ndangna a nggǝroƙǝnǝn ha wa. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />Ənaman ˈya fiya ƙǝla na minnun a ǝnang ngganda kun.”<verse eid="LUK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32" />“A naɗun a nggǝm nafiya na a nggǝm kun kee, ƙǝƙǝn nun wal parka? Fa ɗimiya ƙǝm na nda nggǝm nafiya na nggǝm ka nda kee. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />Kǝm ɗarha anaɗun a na ˈya na ngga ka fiya na nang kun kee, ƙǝƙǝn nun wal parka? Fa ɗimiya na nda naarha kee. <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Tǝ ƙǝm ana fiya na mbang teng kun kee, ndǝnun fǝrang kumarha kanda, ƙǝƙǝn nun wal parka? Fa ɗimiya na nda fǝrang kumarha fa ɗimiya ƙǝsǝr ateng ngganda kanda mǝmǝl. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />Nanǝn kee, nggǝmama nafiya na tsan kun tǝ ƙǝm ǝnaman ˈya kanda na ngga. Fǝrama kumarha mbǝ ka atenggǝnda kun wa. A naɗun a naarha kee nun wal ƙǝnaghǝn hangga, tǝ ƙǝm nun tsaurha wangya Faara Amshi, ƙǝsǝr nǝghǝn nang ˈya fiya na ngga mbuwa usa Faara tǝ ƙǝm fa mbǝlfeeya. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />Tsawama nafiya na fiya haɗang kun fa, ƙǝla nana Chinǝm Faara, na fiya a haɗang fa.”<verse eid="LUK 6:36" /></para>
  <para style="s1">A Fǝrangɗun ɗimiyarha Fiya wa</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />“A fǝrangɗun ɗimiyirha fiya wa, kun nggima mba nda fǝrang kun wa. A ngwangɗun kumarha fiya wa, kun nggima mba nda ngwang kumarha kun wa. Chahaman ɗimiyin ɗan fiya ɗǝ, kun nggima nanda chahang ɗimiyin nun kun ɗǝ. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />Fǝrama, kun nggima nanda fǝrang nda kun tasau lǝlǝgɗa hǝrha hai, irang tahadghǝn nda kun ahu har luwun nun hai. Tasau nun a ƙǝƙǝrang fiya sǝ ndǝna nda ƙǝƙǝrang nda kun sǝ.”<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />Yeeso fǝrang ɗǝ karapu kanda tǝ ndaarha, “Na kwamarha ƙǝs sǝsal kwamarha wa? Anaɗǝ kee, kanda kyab na nda mukrha ahu kwarha hai. <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />Mbǝ wan tǝ tsaharhaha sǝ, kalgha tǝmalǝm ndǝghǝn wa. Ƙǝsǝr, wan tǝ tsaharhaha a ngwalang ɗǝ tsahadghǝn ha, nǝn tsaurha ƙǝla tǝmalǝm ndǝghǝn.”<verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />“Mani na ƙǝlang hwalirha na a yid shadwa, sa kula ƙǝɗang miwaarha ɗǝ na a yidwa? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Kǝƙǝn na ndang nda shadwa, ‘Wanya ni a ƙǝɗo hwalirha ɗǝ a yidwa,’ kula sa na miwaarha na yidwa? Sa tǝ thlǝrɓu! Katǝrang ƙǝɗang miwad ɗǝ ˈwan na yidwa ƙǝsǝr ana manana hai ngga, na a mbangga ƙǝɗang hwalirha ɗǝ na yid shadwa.”<verse eid="LUK 6:42" /></para>
  <para style="s1">Nǝm sǝn ɗǝfrha tǝ tur wanggighǝn</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />“Ɗǝfrha na ngga mbǝ nggǝt wee mbuwa ngga wa, ɗǝfrha ƙǝm mbuwa ngga mbǝ nggǝt wee na ngga wa. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />Nǝm sǝn ɗǝfrha tǝ wanggighǝn. Mbǝ naarha hai ɗakh wan shiɓarha nǝm a fad ndaha wa, nduwa wan inabi a fad ndakh mbǝlfeerha wa. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />Ka niifa nǝn ǝna ǝngya na ngga, ƙǝsǝr ǝngya na ngga ndǝna ahurghǝn. Tǝ ƙǝm, tǝ mbǝlfeerha nǝn ǝna ǝngya mbuwa ngga, ƙǝsǝr ǝngya mbuwa ngga ndǝna ahurghǝn. Ƙǝsǝr ˈya na ahur niifa ndǝna kyarha ɓa a miighǝn.”<verse eid="LUK 6:45" /></para>
  <para style="s1">Fa tǝngya sǝri</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />“Kǝn nun aah nggi, ‘Pǝpa, Pǝpa,’ kun a kar ˈya ndang ni kun a non? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Kala niifa ɓagha thlǝmanna ɓa, a sǝk ˈya niya thlǝkrha tǝ ƙǝm ndǝghǝn a ǝna ˈya ɗani, niya pǝrang tur niifɗi kun. <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />Nǝghǝn ƙǝla niifa na a tǝn wurighǝn, ranggǝn sarghǝn sǝ kuɗimnggǝn, tǝ ƙǝm ɗǝfanggǝn sar ƙǝnɗi aten feera. Lǝghǝdna kufarha ɗǝk nǝn wuriɗi mbangwa tsangˈya fa wa, ƙǝsǝr ɗǝfanggǝn sarghǝn aten keela. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Ƙǝsǝr niifa sǝkka pathna nawa taarasǝ wa, nǝghǝn mǝmǝl tǝ niifa tǝngga wurighǝn kula tansang sar ƙǝnggǝn ngga. Lǝghǝdna kufarha mbǝn nǝn wuriɗi chagha hai hǝrǝm, chat wuri ɗa hai, ˈya ni mbuwa ngga kaan.”<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">Yeeso ƙǝnang ɗǝ mafad mamnda sodja Romaya</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />A kwasamadɗi ngwalangna Yeeso pathla a fiya aten ǝnggini na midghǝn sǝ a pǝranggǝnǝn kanda, widghǝn ni Kafarnahum ɗǝ. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />A mbǝɗi, na mamnda sodja Romaya sǝ na mafadghǝn hadghǝn kaan tsau tǝ mii mǝra fa. Mamnda sodja Romaya ɗiwu nggǝmɗǝ mafadɗi keeghǝn kaan. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Sǝknǝn laɓar Yeeso, thlǝn fingya fa malǝmgya Yahudaya nǝn ɗa nda hwanggǝn ɓaa ƙǝnang nda mafadghǝn. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Famalǝmgini ɗǝnda thlǝmad Yeeso ɗǝ, hwanggǝnda kaan ndang ngganda, “Niifɗiya kam ɗǝ a ɗangga sǝ! <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />Nggǝmɗǝ nafinan har tǝnang ɗǝ Ƙǝn Faara kan sǝ.”<verse eid="LUK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6" />Wiigha Yeeso tǝ kanda. Ɗǝnda ɗǝ, kanda tsau tǝ wuri ɗi, mamnda sodja Romaya ɗi, thlǝn pashiyighǝn nǝn ndang ngganda Yeeso, “Paɓa, a ƙǝtǝlangna fadwa ka nggi wa, ƙǝsǝr tsǝkki na a ɓana wuri kyana ɓa wa. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Ndǝghǝnni ndani tsǝkki na ɗi thlǝmad wa ɗǝ wa, kalusǝ kee na mafanna a wal ƙǝnda. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Ƙǝsǝr nggi niyi akamu ngyakhrha niifa, ƙǝmɗa tǝ sodjaya a kamuna, ni ndaa nda yanɗiya, ‘ɗuwa ɗǝ’, nǝn ɗǝrha ɗǝ; yanɗi ƙǝm ndanggi ˈɓoɓaˈ, ɓagha ɓa, ndanggi mafanna, ǝno kiya, ǝnagha kee.”<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />Sǝkna Yeeso ndǝn kee, wulangga teena. Kyahargha hai ndanggǝn nafini na a mbu samadghǝn, “Niya ndang nda kun, ahur Isǝreela ˈwawi wal niifa tǝ fǝrƙǝkafek fa tǝ kanglanggirha ƙǝla yanɗiya wa.” <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />Nafini thlǝn nanda ɗǝ wu wunna nda a wuri ki mamnda sodja Romaya ɗǝ, ɗanda wal mafadɗi ƙǝnɗǝ.<verse eid="LUK 7:10" /></para>
  <para style="s1">Yeeso thleng ɗǝ wan nuneefa sǝ mǝrna chimadghǝn</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Tsuwa tsǝɓaku wa Yeeso ɗǝgha ahu tala ɗǝ na nda aarha Nayin, fatsahayighǝn tǝ fiya hangga mbu samadghǝnda. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Nduwus na nda a kwakirǝm talɗa ɓa, tǝrgha (na) nafiya (nda) a kyarhaɓa tǝ mǝrra wunɗelarha, ndǝghǝnni tǝtal nggǝnna (ahar) man, chimadghǝn (nuɗi) ƙǝm mǝrɗǝ. Nafiya hangga ahu talɗi kanda a ɗǝfangɗǝ. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />Nana Yeeso nuɗi, haɗanggǝn fa, ndanggǝn, “A tǝnna wa!”<verse eid="LUK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14" />Ɗǝgha ɗǝ tsuwar alkau ɗa nǝn fa, nafini na tǝghǝn ha isha nda hai. Ndagha Yeeso, “Wundǝlad ɗiya ndoyi thliusǝ!” <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Tǝrgha wundǝlad ɗi mǝrgha thliighasǝ tsaukwa tsau, katǝranggǝn ndikrha hai. Yeeso ƙǝm fǝranggǝnǝn man ɗǝ.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />Tǝrgha tǝrmanda kanda na heu, manangganda thlǝm Faara nanda a ndaarha, “Kǝkafek, ɓat mamnda annabi ahur nǝm ɓa! Ɓa na Faara ɓa ka a hǝrghanggǝn nafiyighǝn.” <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />Laɓar ǝnɗi ǝna na Yeeso ya, ɗǝɗa ɗǝ inggun ahu Yahudiya tǝ tulayighǝn.<verse eid="LUK 7:17" /></para>
  <para style="s1">Fathlǝngya Yahaya tǝ Mbaptisǝma</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Tǝrgha fatsahaya Yahaya pǝrang ǝnggina nda na heu, aagha Yahaya sǝri ahur ndan. <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />Thlǝn kanda nǝn thlǝmad Chinǝm ɗǝ tǝ Tsakhmee, “Sani na a ɓadɗaɓa wa, nduwa ƙǝla niifa nan pak wa?”<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />Sǝlna fa tsahayini a thlǝmad Yeeso ɗǝ, “Ndang ngganda Yahaya tǝ Mbaptisǝma ndǝghǝn thlǝngga kan a thlǝmad wa ɓa, nan a tsaho mee, sani na a ɓadɗaɓa wa, nduwa ƙǝla niifa nan pak wa?”<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />A mbǝɗi tsu ƙǝnangga Yeeso nafiya mbuwa ƙǝkanglang, tǝ ǝnkaheeya. Kwamaya hangga ƙǝmɗa kanda ana mana hai. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Tǝrgha nggǝmangga Yeeso kanda ndǝghǝn, “Ɗamaɗǝ ɗun pǝranggǝn Yahaya ǝnɗi sǝknun tǝ ǝnɗi na nun. Sǝfǝngya a wiirha, fa termeeya kanda a wal ƙǝnda, teɓengya a sǝk pathla, kanda a thleng mǝrya sǝ ƙǝmɗa kanda a fǝr laɓar Faara a fa yamiya. <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />Faara nǝn fǝr parka a fiya nggalgha tǝ fǝrƙǝkafek nanda tǝghǝn atenna.”<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Akwasamad ɗi wiina fathlǝnggini ki Yahaya, tǝrgha Yeeso katǝranggǝn tsǝ laɓar Yahaya ahu terɗi ngwagha hai, ndagha, “Kǝladma ɗunun ka ƙǝladɗǝ a kaheerha? Hwaliiya na dzang na ɓereurha a tsang ˈya fa wa?” <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />Yoo, ƙǝladma ɗǝnun ka ƙǝladɗǝ? Nduwa ngwadɗa fa ngwanda fa ya wa? Ai ƙǝmɗarha fa ngwaya fa na ngga, na nda tsaurha kwakirǝm kutǝra. <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />Yoo, ƙǝladma ɗǝnun ka ƙǝladɗǝ? Annabi wa? Kǝkafek niya pǝranggǝn kun har kalɗǝ annabi. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />Yahaya ndǝna laɓar Faara chichirethlee hai tǝ ndaarha, “Iya, thlǝnɗi tǝ thlǝndǝna ˈwa ɗǝ mbee masa, yanɗi na a takso kwamana kapa na ɓarhaɓa, <verse eid="LUK 7:27" /><verse number="28" style="v" sid="LUK 7:28" />Niya, pǝranggǝn kun ahu fǝnayini na heu nggǝt na nishya mbǝ yanɗa sǝ kalgha Yahaya mamnggirha wa, nanǝn kee yanɗi na ngguchit ahu kutǝryid Faara kalɗa ndǝn mamnggirha.”<verse eid="LUK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29" />Nafiya sǝkka ǝnɗiya heu tǝ fa thlǝ tsamngya sǝndasǝ kwaman Faara ndǝna mǝmǝl, ƙǝsǝr kanda ǝnnanda mbaptisǝma yi Yahaya. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Amma Farisaya tǝ fa sǝn ɗǝleewar ngyakhrha, kar nda ɗǝfang shilee ǝnɗi na mid Faara nang nda kanda, ƙǝsǝr kar nda fa a nangga Yahaya mbaptisǝma kanda.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />Ɗǝgha Yeeso mbeeɗǝ tǝ ndaarha, “Yoo, tǝ manda nǝm sakh nafiya ƙǝshiid weeriya? Na nda ƙǝƙǝn? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />Na nda ƙǝla wundakhnaya na tsaurha a kasu, nanda aah ndan, kanda a ndaarha,</para>
  <para style="q1" vid="LUK 7:32">“‘Peng ɗan perǝma kunsǝ</para>
  <para style="q2" vid="LUK 7:32">karɗun rǝbrha fa,</para>
  <para style="q1" vid="LUK 7:32">angɗan amshi mǝrra kunsǝ,</para>
  <para style="q2" vid="LUK 7:32">karɗun tǝrha fa!’”<verse eid="LUK 7:32" /></para>
  <para style="b" />
  <para style="p">
    <verse number="33" style="v" sid="LUK 7:33" />“Yahaya tǝ Mbaptisǝma ɓa nǝn ɓa mbǝ a hǝb ǝnnarhami wa, mbǝ a sa aam inabi wa, amma kun a ndaarha, ‘Nǝghǝn tǝ ǝnkaheerha fa!’ <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Wan Niifa ɓa ɗa ɓa, a hǝbrha, a sarha, kun a ndaarha, ‘Na ɗun ndǝn tǝ yakh hǝbrha tǝ saarha, pashid fa thlǝ tsamngya tǝ fa ɗimiyirha ni!’ <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Nanǝn kee, nafiya nggǝmngga fa tǝ ndǝndǝlyid sǝnda Faara, kanda ƙǝl ndaarha nǝghǝn tǝ ƙǝkafek fa.”<verse eid="LUK 7:35" /></para>
  <para style="s1">Yeeso a minda ki Saminu tǝ Farisarha</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Tǝ Farisarha sǝ aagha Yeeso ka hǝb ǝnnarhami a wuri keeghǝn ɗǝ, tǝrgha kyagha ki tǝ Farisadɗa hai, tsaukwa hai a hǝb ǝnnadɗami. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />A hu talɗiya na nuneefasǝ mbuwana ǝn ǝnadghǝn ngga, sǝknǝn ndaarha na Yeeso a hǝb ǝnnarhami a ki tǝ Farisarha ɓagha ɓa tǝ ƙǝthlikrha fǝɗeerha na tǝ wuɗǝɓǝla fa. <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />Ishgha aman ƙǝsǝrghǝn tǝman sarghǝn fa, nagha a tǝrha, tǝrgha aam yidghǝn nagha a tsǝtsaarha aten sarghǝn hai fǝɓanggǝn sarɗi, panggǝn ɗǝ tǝ was tenggǝn, ƙǝmanggǝn tǝ fǝɗeerha na tǝ sǝdghǝn mbǝnggǝn.<verse eid="LUK 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39" />Nana tǝ Farisadɗi aagha ndǝn ndagha ahurghǝn, “Ana niifɗiya annabi ni kam sǝnɗǝ tǝ wunniya, tǝ ƙǝm ndaarha tur nu wunniya na a tsuwarghǝn fa ƙǝsǝr tǝ ɗimiyirha ni.”<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />Nggǝmangga Yeeso ndanggǝn, “Saminu, na ˈyasǝ niya puro,” ndǝghǝn ƙǝm ɗarha, “Mala puruwun.” <verse eid="LUK 7:40" /><verse number="41" style="v" sid="LUK 7:41" />Ndagha Yeeso, “Niifasǝ a takkwa nafiya sǝri kumarha, tal wuɗǝɓǝl wurirha haru tuf, tahadghǝn ƙǝm kumnggit tuf. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Pǝɗangna tidghǝn kanda, tǝrgha chahanggǝn nǝn kanda ɗǝ ngwad kyab. Yoo, ahur ndan yanggini nggǝm nggǝn kaan?”<verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />Nggǝmangga Saminu ndanggǝn, “Ai yanɗi chahang na nda ɗǝ na hangga.” Ndanggǝn, “Nggǝmangna mǝmǝl.”<verse eid="LUK 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44" />Kyahar nǝn thlǝmad nuɗa ɗǝ, ndanggǝn Saminu, “Nanna nuɗiya? Kyaɗi kyawa hai fǝre wa aam tsab sara wa, amma ndǝghǝnggi irang ɗǝ aam yidghǝn aten saryina hai, panggǝn ɗǝ tǝ was tenggǝn. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />Sa fufubwa nggi wa, ndǝghǝnggi ƙǝm ka kyani mbǝɗa ɓaya malangwa fǝb sarghǝn wa. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />Ƙǝmang ngwa tenna tǝ fǝɗeerha wa amma ndǝghǝnggi ƙǝmang ɗǝ sarna tǝ fǝɗeerha na sǝdghǝn mbǝnggǝn. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Nanǝn kee niya puroƙǝn, pat ɗimiyini keeghǝn na hangga chahang ndanɗǝ, ƙǝsǝr nǝghǝn tǝ nggǝmnda na hangga yanɗi chahang nanda ɗǝ ngguchit ƙǝm nggǝmnda ngguchit nǝn waala.”<verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />Tǝrgha ndangga Yeeso, nuɗi, “Ɗimiyid wa chahon ndan ɗǝ.”<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />Nafini na a hǝbrha tǝghǝn, na nda a ndangnda ndan, “Wunni yanɗi ƙǝmya na chahang ɗimiyirha ɗǝ.”<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />Tǝrgha ndangga Yeeso nuɗi, “Fǝr ƙǝkafekkid wa hǝrwo ɗǝ ɗuwa ɗǝ hu ɗǝɗemnggirha.”<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s1">Fingya nishya takkwanda Yeeso</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Mǝnggaha wa na Yeeso a Pǝr laɓar kutǝryid Faara tala-tala, fatsahayighǝn na Kum kap sǝri a thlǝmadghǝn, <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />tǝ fingya nishya ndǝghang nda kanda hai tǝ ǝnkaheeya tǝ fingya wan haya. A hur ndan na Mairamu sǝ nanda aarha Magdaliya ndǝghang nda hai tǝ ǝnkaheeya mǝd. <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />Tǝ Yowana nu Kudza tǝ thlǝnda Hirdus, tǝ Sudzanatu tǝ fingya hangga ɗangga kanda sǝ tǝ rǝfyindan.<verse eid="LUK 8:3" /></para>
  <para style="s1">Karapu aten tǝ hǝfrha</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />Wumna fiyaɓa hangga, nafiya aten chikrha ɓa, tala-tala kanda a ɓarha thlǝmadghǝn ɓa. Thlǝghang karapu nǝn kanda sǝ ndǝghǝn, <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />“Na niifasǝ ɗǝgha ka hǝfrha ɗǝ, ndǝghǝn aten wash wiirha, fingya hǝra nda hai aten kwamana ishangga fiya hai tǝrgha ɗamangga wuɗikkya. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Hǝrgha fingya hai ahu hǝreng keela hai, kya nda sǝ tǝkna yan faara hai hwara nda ɗǝ ƙǝsǝr mbǝ lǝssa suwa. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Fingya hǝra nda pathlang ndakhkya hai kya nda sǝ kal wanda farha hai a pathlang ndakhkini wa. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Hǝrna fingya hai ahu chehweerha hai na ngga kyanda sǝ ngga tǝ chikrha haru-haru.” Ndanǝn kee tǝranggǝn uradghǝn sǝ ndagha “Yi na tǝ thlǝmad sǝkrha sǝkƙǝnǝn.”<verse eid="LUK 8:8" /></para>
  <para style="s1">Ten karapu ɗi</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />Fa fatsahaya Yeeso tsahang mee nda aten karapu ɗiya. <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />Ndanggǝn kanda, “Nggǝmang nda kun fa na a sǝn ˈya nun na kutǝryid Faara ahurghǝn, fingya a mbǝ tǝ karapu wa mba nda sǝnggǝn wa, naarha nandan, kanda mba nda kukwalang hai wa, sǝkrha ƙǝm sǝk ndan, kanda mba nda sǝnggǝn wa.”<verse eid="LUK 8:10" /></para>
  <para style="s1">Yeeso pǝrɗǝ ten karapu ɗi ki tǝ hǝfǝdɗi</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />Ndǝghǝn “Karapu ɗiya nǝghǝn kiya, Wiirha laɓar Faara ni. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Fingya hǝrgha hai ahu kwamana nǝghǝn aten nafiya sǝkka laɓar Faara, tǝrgha ɓagha Sheetan ɓa tǝranggǝn laɓar ɗa ɗǝ ahur ndan amana nda fǝrƙǝkafek na a wal hǝrǝkrha nda. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />Yi hǝreng keela nǝghǝn aten fingya a hǝrǝmna nda sǝk laɓar Faara nanda thlǝghǝn tǝ hura pǝpet, mbǝ mbǝd tsawudghǝn sǝ ahur ndan wa, ƙǝsǝr nanda fǝrƙǝkafek yi ɓeena ngguchit, a wal nda ƙǝƙǝrra mba nda kwas kyaharra hai wa. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />Fingya hǝrgha ahu ndakhkya hai, ndǝna aten fingya sǝkka laɓar ɗi, ƙǝsǝr nda weeriya tǝ ɓinda ka ǝn ƙǝshiirha, tǝ ƙǝna tǝ ǝn mbǝndayirha fa yi ƙǝshiid ɗiya thluranggǝn kanda ƙǝsǝr mbǝ ˈyasǝ nanda mbang ǝnaarha ngga wa. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />Fingya hǝf nǝn ahu chehweerha na ngga ndǝna aten nafiya sǝkka laɓar ɗi, ƙǝsghǝnda ha ngga tǝ hura tǝtal, ƙǝrsa nda na ˈya nda na ngga.”<verse eid="LUK 8:15" /></para>
  <para style="s1">Patilla tsǝtsǝɓa tǝ tǝɓa</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />“Mbǝ niifa sǝ na njang patilla tsǝɓanggǝn tǝ tǝɓa wa, tǝ ƙǝm ɗǝfanggǝn kamu wusǝra ɗǝ wa. Nǝm ɗǝfang nda a mbǝd ɗǝfrha na a pǝpal ƙǝsǝr ka nafiya na kyarha ɓa na kukwaryirha nda. <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" />Mbǝ ˈyasǝ na ɓǝɓee mbuwa kyarha sǝ wa. ˈYa ƙǝm na nggǝnggǝla nǝn kyarha pǝpal ɓa. <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" />Kwarama tǝ sǝk pathla nun a naarha sǝkrha a sǝnunsǝ niifa na tǝ ˈya ha nanda chighanggǝn, yanɗi mbuwa tǝ ˈya anaɗǝ a numarha nǝghǝn tǝghǝn ha nanda thlang nda.”<verse eid="LUK 8:18" /></para>
  <para style="s1">Man Yeeso tǝ wanmanggighǝn</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Man tǝ wanmanggighǝn ɗǝnda thlǝmadghǝn ɗǝ, wal wanda sǝla thlǝmadghǝn ɗǝ wa ƙǝsǝr ka hangnda fiya. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Ndang ngganda, “muwa tǝ wanmanggiwa kanda a ƙǝshi na mindansǝ na sa.” <verse eid="LUK 8:20" /><verse number="21" style="v" sid="LUK 8:21" />Nggǝmanggǝn kanda ndǝghǝn “Nafiya na sǝk laɓar Faara thlǝnangganda ɗǝ kanda ni iiya tǝ wanmanggina.”<verse eid="LUK 8:21" /></para>
  <para style="s1">Yeeso yanang ɗǝ ɓereu ˈyaara</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Na fara sǝ kyanǝn hur kombuwal hai tǝ fatsahayighǝn, ndanggǝn kanda, “Tama pǝm wuri aamɗa ɗǝ ya.” Thlii wiirha nda. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />Nanda aten wiirha tǝrangga ɓeena ɗǝ. Tǝrgha ɓereu ˈyaara thliigha ɓa, kombuwal ndan takh ɗǝ a lǝghǝtta tǝ aama, tǝrmanda.<verse eid="LUK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24" />Ɗǝnda ɗǝ thlengganda sǝ a ɓeena, ndang ngganda, “Paɓa-paɓa nǝm a mǝra!” Thliigha sǝ yananggǝn ɓereu ˈyaarɗi tǝ kuɗǝfǝlla amɗi nggasa nda hai tip. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />Ndanggǝn kanda, “Ai fǝrƙǝkafekkid nun?”</para>
  <para style="p" vid="LUK 8:25">Tǝrgha tǝrma nda tǝ wulteena, na nda a ndangnda ndan, “Wunniya na ɓereu ˈyaara tǝ aama ɗǝfang shilee in?”<verse eid="LUK 8:25" /></para>
  <para style="s1">Yeeso ƙǝnang ɗǝ niifa na tǝ ǝnkaheerha fa a Nggarasina</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Ɗǝnda mbeeɗǝ tǝ wiirha a Nggalili ta Nggarasina ɗǝ na a pǝm wuri aama. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Tǝrnda hai a mii wuri aamɗi, na niifasǝ tǝ ǝnkaheerha fa, kyagha ɓa ahur talɗi hwathla kanda nǝn fa. Mǝndaha ˈwawa kal kaɓarha fa wa. Mbǝ tsaurha a wuri wa ƙǝl a mbǝd ten kwaya. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Nanǝn Yeeso tǝrgha huhwagha, fǝlgha hai a mbedghǝn tǝranggǝn uradghǝn sǝ ndǝghǝn, “Ma njidoyiwa tǝ nggi Yeeso Wan Faara Amshi? Niya hwan sa a sǝsenna wa.” <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Thlǝk nǝn ndǝn kee, ƙǝsǝr Yeeso ˈwaɗǝ teena yanang ɗǝ ǝnkaheedɗi a ndǝkka hai tǝ niifɗi. Sara hangga na ǝnkaheedɗi naarha ɗǝghang niifɗa hai, na fiya ƙǝnang hai tǝ wuyiwurra nǝn ɗahang ɗǝ ɗangga ǝnkaheedɗi a heeɗǝ.<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />Tǝrgha Yeeso tsahang mee nǝn ha, “Thlǝm wani ƙǝn?” Ndǝghǝn, “Hangga.” Ƙǝsǝr ǝnkaheeya hangga kyangga fa. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Na nda a hwanggǝn a ɗangɗǝ kanda hu kwaɗaɗǝ na kuɗimnggǝn wa.<verse eid="LUK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32" />A mbǝɗi wu na chiɓǝt ƙǝlengarya sǝ a lafrha a wumnda, hwanggǝn nda a kya nda ahur ndan hai, nggǝmanggǝn kanda fa. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Tǝrgha ǝn kaheeyini ndǝghang nanda kanda hai tǝ niifɗi kyanda hur ƙǝlengaryina hai. Tǝrgha ƙǝlengaryini thlii nda sǝ tǝ ɗarha kya nda hu wuri aamɗa hai, mǝra nda sǝ.<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />Fa laf ƙǝlengaryini nanda ǝnɗi katǝragha hai, ɗandan ni wure ɗǝ na nda a pǝrghǝn tala-tala. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Tǝrgha fiya kya nda ɓa ka na ǝnɗa nda katǝragha hai ɓa nda thlǝmad Yeeso ɓa, ɓanda walghǝn tǝ niifɗi ndǝkna ǝnkaheeyina hai tǝghǝn tsau a mbedghǝn kalɗǝ lukrha fa, ɓa hutenggǝn ɓa. Tǝrgha tǝrmanda. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Na nafiya sǝ ǝnana Yeeso ǝnɗi a yindan thlǝghanggǝn nda kanda kwamanɗi ƙǝnang nda tǝ ǝn kaheedɗi. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Nafiya Nggarasina kahat hwan Yeeso nda na a ndǝkka hai tǝ kanda, ƙǝsǝr ƙǝs hǝreenga kanda kaan. Tǝrgha Yeeso ahu kombuwal hai wiigha.<verse eid="LUK 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38" />Niifɗi ndǝkna ǝnkaheeyina hai tǝghǝn hwanggǝnǝn na a wii nda kyab. Tǝrgha ndanggǝn, <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />“Wuɗu wureɗǝ ɗa thlǝk ǝnɗi ǝnona Faara.” Widghǝn ni hur tala ɗǝ nagha a thlǝk ǝnɗi ǝnangna Yeeso.<verse eid="LUK 8:39" /></para>
  <para style="s1">Wutarad Yayirus tǝ nuneefa na fara ɓang fa</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Wunna Yeeso ɓa, fiya hangga hwathlagha ndǝn fa, ƙǝsǝr nanda a ƙǝlaghǝn fa. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Tǝrgha na niifa sǝ thlǝmnggǝn ni Yayirus mamnda niifa ni a Ƙǝn Faara, mbǝrgha hai a mbed Yeeso hwanggǝnǝn a ɗǝgha wuri keeghǝn ɗǝ. <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />Na wutaradghǝn sǝ tǝtal huradghǝn ǝnaɗǝ Kum kap sǝri a mǝra. Tǝrna Yeeso kwamana, fiya hangga a ngyaɓang mbǝrha fa. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />A hur ndan na nuneefa sǝ sǝsagha yi hurarha kumkap sǝri fara aten ɓang ndafa hai, ɓǝlang ɗǝ ǝn hu harghǝn ɗǝ ka kaɗa puurha, walwa ƙǝnda wa. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />Tǝrgha kyagha tǝ man ƙǝsǝrghǝn tsuwar pǝpǝshiprha parkwadghǝnǝn fa. A mbǝɗi wu farɗi na ɓang fa hai tǝrgha.<verse eid="LUK 8:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45" />Ndagha Yeeso, “Wunni tsuwargha nggi fa?” Ngaalangganda, tǝrgha Mbiturus tǝ fingya na a thlǝmadghǝn ndang ngganda, “Paɓa na fiya hangga na puworha ɓa kanda a ngyaɓo mbǝrha fa.” <verse eid="LUK 8:45" /><verse number="46" style="v" sid="LUK 8:46" />Ndagha Yeeso, “Na niifa sǝ tsuwargha nggi fa ƙǝsǝr na sǝsǝmnda sǝ kyagha ɗǝ a fanna.” <verse eid="LUK 8:46" /><verse number="47" style="v" sid="LUK 8:47" />Kǝlaana nuɗa hai mbǝ mbang ɓeerha wa, Nduwusgha thlǝmadghǝn ɗǝ nagha fadghǝn a rǝbrha fa, ɓǝrgha hai a mbedghǝn pǝrghǝnǝn a mbed fiya na heu ǝnɗi nagha ndǝn tsuwarnǝn ndǝn fa tǝ wal ƙǝnda wal nǝn a mbǝɗi. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />Ndangga Yeeso nuɗi, “Waana fǝrƙǝkafekkid wa ƙǝnoɗǝ wiu fadwa ahu ɗǝɗǝmnggirha.”<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />Ndǝghǝn aten fǝr laɓara, ɓagha niifa ɓa a wuri ki Yayirus mamnda Ƙǝn Faara ndanggǝn, “Wutaradwa mǝrɗǝ a sǝsangna tǝ malǝmndǝ ɗaɗǝ wa.”<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />Sǝkna Yeeso ndǝn, ndanggǝn mamndǝɗi, “A tǝrǝmna wa furu ƙǝkafek kee nǝn a ƙǝnda.” <verse eid="LUK 8:50" /><verse number="51" style="v" sid="LUK 8:51" />Nduknǝn hur wuriɗa ɗǝ nggǝmangwa fiya fa mbusamadghǝ nda wa, ƙǝl Mbiturus, tǝ Yahaya, tǝ Yakubu tǝ ƙǝm chin wanɗi tǝ man. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />Fiya aten tǝrha tǝ huhwaarha ka mǝra wutaradɗi. Ndagha Yeeso, “Malaman tǝrha, mǝrgha wa nǝghǝn a shiirha.”<verse eid="LUK 8:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53" />Tǝrgha masangganda yi sarfarha, ƙǝsǝr sǝndasǝ mǝrɗǝ. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Ndǝghǝnggi ƙǝm ƙǝs nǝn har wanɗi tǝranggǝn uradghǝn sǝ ndǝghǝn, “Waana thliu sǝ.” <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Sǝsǝnggǝn wudgha ɓa thliigha sǝ, ndanggǝn kanda fǝraman ǝnnarhami hǝbgha. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />Fa nggǝtyighǝn wulangga teena kanda. Yi yang thlǝmarha nǝn kanda teena a pǝrang ndan fiya ǝnɗi katǝragha hai wa.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s1">Thlǝn Yeeso fatsahayighǝn Kum kap sǝri ɗi</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Aah nǝn fatsahayighǝn kumkap sǝri ɗa ɓa, ndanggǝn kanda, fǝrangɗi sǝsǝmnda kun na a ƙǝnanggun fiya na tǝ ǝnkaheeya tǝ wan haya ɗǝɗamǝn, <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />tǝ ƙǝm thlǝn kanda nǝn ɗaa nda pǝr laɓar kutǝryid Faara, tǝ ƙǝnang nda haaya. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Ndanggǝn kanda, “A thliiɗun wiirha ma tǝrɗun sǝsala, tǝ yawarha, tǝ ǝnnarhami, tǝ wuɗǝɓǝla, tǝ ƙǝm lukrha sǝri wa. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />A ɗǝɗun ɗǝ, wuriɗi ˈwanun kyarha sahai, tsawama sǝ pa far wuttǝnun ɓa. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />Kala nafiya thlǝwa nanda kun fa, a naɗun a mal talɗi tinid talɗi na sarnun pamanɗǝ ka a tsauka ǝn sakhrha ni a tendan.” <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />Thlii nda, wengganda talya hai hangga, kanda a pǝr laɓar Faara tǝ ƙǝnang nda fiya ko a yanggini.<verse eid="LUK 9:6" /></para>
  <para style="s1">Thlǝwul ten Hirdus aten Yeeso</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />Hirdus kutǝr Nggaliliya, sǝkɗǝ ˈya na a katǝrarha hai ahu chehweedghǝn, ƙǝrǝdɗadǝn fa kaan, ƙǝsǝr fingya na nda a ndaarha Yahaya tǝ Mbaptisǝma ni thleng nanda sǝ ahu mǝrra. <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />Fingya ƙǝm ndaa nda Iliya ni kyagha ɓa, fingya a ndaarha tal ni ahur annabiya na kaar thliigha sǝ. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Ndagha Hirdus, “Yahaya kyathlangɗi tenggǝn ɗǝ, wunni ƙǝm mbiya ni a sǝk ǝnggini ɗǝɗamǝn atenggǝn ya?” Nanǝn kee, midghǝnsǝ a na Yeeso nǝn.<verse eid="LUK 9:9" /></para>
  <para style="s1">Yeeso hǝɓang ɗǝ fiya haru kumnggitghǝn tuf</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Wunna fatsahayighǝn ɓa pǝrang ǝnggina nda ǝnana nda. Tǝrgha thliigha tǝ kanda katendan ɗǝnda ahu tala ɗǝ nanda aarha Mbatseda. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />Sǝnna fiya mbǝɗi nǝn a ɗǝrha saɗǝ, mbu samadghǝn nda. Thlǝ kandanǝn fa, pǝrang laɓar kutǝryid Faara nǝn kanda, ƙǝnanggǝn fingya na mindan ƙǝnda. <verse eid="LUK 9:11" /><verse number="12" style="v" sid="LUK 9:12" />Yarna fara hai, Kum kap sǝriɗi ɓaa nda thlǝmadghǝn ɓa ndang ngganda, “Kamɗǝ nanǝn ya kal fiya na hai kya nda hur tala ɗǝ ɗanda kaɗa ǝnnarhami tǝ mbǝd mǝnda ƙǝsǝr mbǝɗi nanǝm sǝ ya mbǝ fiya sǝ wa.” <verse eid="LUK 9:12" /><verse number="13" style="v" sid="LUK 9:13" />Ndangga Yeeso kanda, “Kun tǝ altennun fǝraman ǝnnarhami kanda lee.” Ndang ngganda, “ˈya na a har nan mburodi ni tuf tǝ tǝna sǝri kee, a mbǝ nanan kyarha hur tala ɗǝ ɗan heng ǝnnarhami fiya ɓa na heu wa.” <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />Hǝshya ǝnanda haru kumnggit tuf. Ndangga Yeeso fatsahayighǝn, “Ndaman fiya tsawanda hai, wumangganda tendan kumnggit tuf-tuf.” <verse eid="LUK 9:14" /><verse number="15" style="v" sid="LUK 9:15" />Fatsahayighǝn tsawangganda fiya hai ƙǝla ndanǝn. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Tǝrgha haranggǝn mburodi ɗi tuf tǝ tǝn ɗi sǝri, tǝranggǝn tenggǝn talara ɗǝ, usa Faara nǝn, kyanggǝn hai, fǝranggǝn nǝn fatsahayighǝn ndǝghanggǝn nda fiya. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Fiya na heu ǝnanda mii nggal nda. Tǝrgha fatsahayighǝn wumangganda kwasamadghǝn kutasya kumkap sǝri.<verse eid="LUK 9:17" /></para>
  <para style="s">Yeeso ndǝna Ƙǝrǝsti</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Na farɗa sǝ Yeeso a hwan Faara katenggǝn tǝ fatsahayighǝn a thlǝmadghǝn, tsahang mee nǝn kanda, ndǝghǝn, “Na fiya ndaarha wunni nggi?” <verse eid="LUK 9:18" /><verse number="19" style="v" sid="LUK 9:19" />Nggǝmangganda, “Fingya a ndaarha Yahaya tǝ Mbaptisǝma, fingya Iliya, fingya ƙǝm a ndaarha tal ni ahur annabiya na kaar thliigha sǝ.” <verse eid="LUK 9:19" /><verse number="20" style="v" sid="LUK 9:20" />Ndanggǝn kanda, “Kun tǝ altennun nun a ndaarha wunni nggi?” Tǝrgha Mbiturus nggǝmanggǝn ndǝghǝn, “Sani Ƙǝrǝsti yi Faara.”<verse eid="LUK 9:20" /></para>
  <para style="s1">Yeeso thlǝkɗǝ kwaman sǝsadghǝn tǝ mǝrrǝghǝn</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />Yeeso yiyang thlǝmarha nǝn fatsahayighǝn, a pǝrang ndan niifa laɓar ɗi thlǝghang nǝn kanda wa. <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />Ndangga Yeeso kanda, “Kǝkafek ni, Wan Niifa nǝn a sǝsaarha ahar shingya, tǝ mamnda firistaya, tǝ ƙǝmɗa fasǝngya ngyakhrha, nanda a karghǝn fa, ɓǝlang ngganda, a far ɓeena yi mahan nǝn a thliirha sǝ.” <verse eid="LUK 9:22" /><verse number="23" style="v" sid="LUK 9:23" />Ndanggǝn kanda na heu, “Ana mid niifasǝ mbu samanna ƙǝl karnǝn altenggǝn tǝranggǝn kaɗidghǝnsǝ ka fad ɗathla mbǝrha fa hai ndǝnǝn mbang mbu samanna. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />Niifa na midghǝnsǝ a hǝrghanggǝn yiɓǝdghǝn nǝn a ƙǝɗeng nda, kala niifa ƙǝɗengga yiɓǝdghǝn ka nggi nǝn a wal yibrha mbuwa ngwalarha. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />Kǝmɗa, ma chighang nǝn niifa a walɗǝ ǝn ƙǝshiid weeriya heu ƙǝɗenggǝn yiɓǝdghǝn? <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Kala niifa niya shiɗang tǝ laɓarna, Wan Niifa ƙǝm nǝn a shiɗang nda tǝ ndaarha sǝngwa ndǝn wa aɓaɗǝ hu mamnggitghǝn ɓa yi Chin tǝ yi fathlǝngya Faara tǝ peɗǝnda. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Kǝkafek niya pǝrang nda kun, na fingya sǝ ƙǝƙǝt a mbǝɗiya mba nda a mǝra wa, nanda a naa kutǝryid Faara tǝ yindan a mǝra nda.”<verse eid="LUK 9:27" /></para>
  <para style="s1">Fatsahaya Yeeso mahan nan nda mamnggitghǝn</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Akwasamad ɓeena uvaɗa tǝ thlǝk palthɗiya, Yeeso tǝranggǝn Mbiturus tǝ Yahaya tǝ Yakubu tǝraa nda wumnda sǝ ƙǝsǝr a hwan Faara nda. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Ndǝghǝn aten hwan Faara, ƙǝla nda hai pǝmnggǝn a chim nda fa, lukkighǝn tsaukwa pǝpet nagha ahar yirha. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />Kula sǝndǝndan sǝ na nafiya nda sǝri a thlǝmadghǝn, kanda a tsǝ laɓara tǝghǝn. Nafiniya nda Musa ni tǝ Iliya. <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />Ɓanda thlǝmadghǝn ɓa tǝ mamnggirha, na nda a tsǝ laɓara tǝ Yeeso ahu lǝghǝtta ˈya na mid Faara aten mǝrrǝghǝn a Urshelima. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />Mbiturus tǝ fingya na a mbǝɗi kanda a ɓeena. Mehen na nda ɓa, tǝrgha na mamnggitghǝn nda, tǝ ƙǝmɗa nafini sǝri ƙǝƙǝt a thlǝmadghǝn. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Na nafini sǝri a ndǝkrha hai tǝghǝn, tǝrgha Mbiturus ndanggǝn Yeeso, “Paɓa, nǝghǝn ngga nanǝm a mbǝɗiya, na chama nan mahan, tal yiwa, tal yi Musa, tal ƙǝmɗa yi Iliya.” Sǝngwa ǝnɗi nǝn a thlǝkrha wa. <verse eid="LUK 9:33" /><verse number="34" style="v" sid="LUK 9:34" />Ndǝghǝn a ndikrha kee, ƙǝla nda hai hashmbe nggǝlanggǝn kanda. Nggǝlangna hashmbiɗi kanda tǝrmanda. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />Sǝk urarha nda hai ahur hashmbiɗi tǝ ndaarha, “Waana niya wurni, sǝgha madghǝn.” <verse eid="LUK 9:35" /><verse number="36" style="v" sid="LUK 9:36" />Akwasamad sǝk uradɗi, na Yeeso nda ƙǝt katenggǝn. Fatsahayighǝn nggasanda hai titib, a sayidɗiya pǝrangwandan niifa ǝnɗi katǝragha hai wa.<verse eid="LUK 9:36" /></para>
  <para style="s1">Kǝnang Yeeso wee na tǝ ǝnkaheerha</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Ɗalthna mbǝrha hai, Yeeso tǝ fatsahayighǝn tǝrna nda hai a wumndǝɗi, wumngga fiya thlǝmadghǝn ɓa hangga. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Na niifa sǝ ahur nafini wumngga ɓa aaghǝnǝn ndǝghǝn, “Paɓa ni a hwan sa ƙǝlang waana thlarghǝna, ƙǝsǝr ndǝghǝnni tǝtal a harna. <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />Na ǝnkaheerha tsang hurafa, nǝn huhwarha, ɗǝghanggǝn hai, nagha fadghǝn a rǝprha fa, nagha miighǝn ƙǝm a hufrha. A fara sǝmǝn mbǝ malang wa ƙǝl sǝsangnǝn kaan. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Hwan ɗi fatsahayiwa a ƙǝnang ngganda, mbang ngwanda wa.” <verse eid="LUK 9:40" /><verse number="41" style="v" sid="LUK 9:41" />Nggǝmangga Yeeso ndǝghǝn, “Kun nafiya ƙǝshiid weeriya fa mbǝlfeeya, mani ƙǝɗiina fǝrƙǝkafekkid nun? Pa kwanɗǝ nǝm tsaurha, nggi aten ƙǝrǝsta tǝ kun? Ɓotǝghǝn wanɗi kyawa.” <verse eid="LUK 9:41" /><verse number="42" style="v" sid="LUK 9:42" />Na wanɗi ɓayi tǝrgha ǝnkaheedɗi ɗǝghanggǝn hai nagha fadghǝn a rǝpfa. Tǝrgha Yeeso njaranggǝn ǝnkaheedɗa ɗǝ, ƙǝnanggǝn wanɗi wuɗanggǝnǝn chin ha. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Fiya na heu a mbǝɗi wulangga teena kanda aten mamnggit tar Faara.</para>
  <para style="s" vid="LUK 9:43">Yeeso nggǝrɗǝ thlǝk kwaman mǝrrǝghǝn</para>
  <para style="p" vid="LUK 9:43">Na fiya heu aten na ǝnwulteena aten ǝnɗi ǝna na Yeeso, ndanggǝn fatsahayighǝn. <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />“A mbǝɗanɗǝ kun tǝ pathɗi niya pǝrang nda kun wa, nanda a fǝr Wan Niifa ahar fiya hai.” <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Kanda hwathlang ngwanda numadghǝn hai wa, ɓǝɓeng ndan kanda ƙǝsǝr amana nda kukwalang hai. Kanda ƙǝm a tǝrǝm tsahang mee aten path ɗiya.<verse eid="LUK 9:45" /></para>
  <para style="s1">Wunni manggǝn ahu kutǝryid Faara?</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />Tǝrgha thliigha ngaala sǝ a pathlang fatsahayighǝn aten wunni ahur ndan na manggǝn. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Sǝnna Yeeso numan ndan tǝrgha ƙǝs har wee nǝn ɓa ngguchit ishanggǝn a thlǝmadghǝn. <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />Ndanggǝn kanda, “Kala niifa thlǝgha wanda fa ya ka nggi, nggi thlǝnǝn. Niifa thlǝgha nggi ƙǝm, thlǝnǝn niifɗi thlǝngga nggi ɓa. Nanǝn kee, niifa na ngguchit ahur nun ndǝna manggǝn.”<verse eid="LUK 9:48" /></para>
  <para style="s1">Niifa mbuwa tsan kun yinun ni</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />Ndangga Yahaya, “Paɓa, na ɗan niifa a ƙǝnang ǝnkaheerha tǝ thlǝm wa, ˈyaɗang ɗandǝn fa ƙǝsǝr mbǝ ahur nǝm wa.” <verse eid="LUK 9:49" /><verse number="50" style="v" sid="LUK 9:50" />Nggǝmangga Yeeso kanda, “A ˈyaɗang ɗundǝn fa wa, ƙǝsǝr niifa mbuwa tsan kun yinun ni.”<verse eid="LUK 9:50" /></para>
  <para style="s">Samariyaya ahu tala karnda thlǝ Yeeso</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Nduwusna ɓenggǝn ɓa nǝn a wutta talara ɗǝ, ɗǝf ɗǝ teena kaan tǝ ɗǝrha Urshelima ɗǝ. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Thlǝn farha nǝn a ˈwanda mbee ahu tala ɗǝ na a chehweed Samariya, ɗa nda ngwang ǝngya fa a mbǝɗi. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />Amma nafini na a mbǝɗi kar thlǝdghǝnda fa, ƙǝsǝr sǝndasǝ na midghǝn ɗǝrha Urshelima ɗǝ. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />Tǝrgha fatsahayighǝn, nda Yakubu tǝ Yahaya, ƙǝlana nda hai kee, tsahang mee nda Yeeso, “Chinǝm, na midwasǝ aah waarha nan hai a talara njanggǝn kanda ɗǝ wa?” <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" />Amma kyahargha Yeeso hai yananggǝn kanda. <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />Ɗǝnda hu talaɗǝ tǝ sǝmǝn.<verse eid="LUK 9:56" /></para>
  <para style="s1">Nafiya mahan na mindan mbusamad Yeeso</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Kanda aten wiirha ahu kwamana, ndangga niifa Yeeso, “Niya mbu samadwa kala mbǝrha na a ɗǝrha saɗǝ.” <verse eid="LUK 9:57" /><verse number="58" style="v" sid="LUK 9:58" />Nggǝmangga Yeeso ndǝghǝn, “Tsarwaya tǝ kwandan sǝ, wuɗikkya tǝ ƙǝndan sǝ, amma Wan Niifa mbǝ mbǝd mǝndǝghǝnsǝ wa.” <verse eid="LUK 9:58" /><verse number="59" style="v" sid="LUK 9:59" />Ndanggǝn niifa pak, “Mbuwu samanna.”</para>
  <para style="p" vid="LUK 9:59">Amma nggǝmangga niifɗi ndanggǝn, “Paɓa, malee ˈwan ɗi pang nda pǝpa.” <verse eid="LUK 9:59" /><verse number="60" style="v" sid="LUK 9:60" />Ndangga Yeeso, “Malang mǝrya panggan nda mǝrrǝndan, sa ƙǝmɗa ɗuwa ɗǝ ɗa pǝr laɓar kutǝryid Faara.” <verse eid="LUK 9:60" /><verse number="61" style="v" sid="LUK 9:61" />Na niifa sǝ ƙǝmɗa ndanggǝn Yeeso, “Paɓa, niya mbu samad wa, malee ˈwan ɗi ndang nafina wiiɗi.” <verse eid="LUK 9:61" /><verse number="62" style="v" sid="LUK 9:62" />Ndangga Yeeso, “Kala niifa katǝrangga huɗarha hai, anaɗǝ a ƙǝlarha samarha ɗǝ, mǝmǝl wa tǝ tar kutǝryid Faara wa.”<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s1">Yeeso thlǝnɗǝ nafiya kumggit mǝd kap sǝri</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Akwasamad yanɗiya, chinǝm wurɗǝ nafiya kumnggit mǝd kap sǝri, thlǝn kanda nǝn sǝri-sǝri, a ˈwanda mbeeɗǝ, ɗǝnda hu talya ɗǝ ɗǝɗamǝn na ndǝghǝn nggi a ɗǝrha saɗǝ. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />Ndanggǝn kanda, “Hathla sǝ hangga fa taryighǝn ƙǝɗin nda. Nanǝn kee, hwanama tǝ heerha puwanggǝn fa hathya ɓa, hathlangganda sǝ. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />Nanǝn ya, weema niya thlǝn kun ƙǝla wan chaukhraya ahur mǝmereeya ɗǝ. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />A tǝrɗun wuɗǝɓǝla, tǝ ǝnnarhami, tǝ pakhma wa. A mbǝdɗun hai ka nda ˈya tǝ niifa a kwamana wa. <verse eid="LUK 10:4" /><verse number="5" style="v" sid="LUK 10:5" />Kala minda kyanunsa hai, ndama, ‘Koomaa, nafiya wuriɗiya!’ <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />Ana nggǝm nda sǝ afad nafini ahur mindǝɗi, ngwa tsaukwa parkad nda ǝnnun ahur ndan, a mbǝ kewa nǝn a nggǝra thlǝman nun ɓa. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />Tsawama ahur mindǝɗi, kala ˈya ɓangnda kun ɓa ǝnamami. Tǝ taara kamɗǝ teng thlǝthlǝn ndǝghǝn nda, ma naɗun a kya wure-wure wa. <verse eid="LUK 10:7" /><verse number="8" style="v" sid="LUK 10:8" />Kala tala kyanun sahai a thlǝnda kun fa, kala ˈya ɓangnda kun ɓa ǝnamami. <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />Kǝnaman haaya ahu talɗi, ndanggǝn nafini kutǝryid Faara nduwusɗa ɓa tsau tǝ kun. <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />Kala tala kyanun sahai a thlǝwa nda kun fa wa, kyama tǝ kwamangya, ndon, <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />tǝnid talnun tsauka a fad sarnan pang ɗan ndǝn kun hai. Kǝl a sǝnunsǝ kutǝryid Faara ndusang ɗǝ kun fa. <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />Niya pǝranggǝn kun a far ngwala ƙǝshiirha na Saduma haɗang nda Faara fa ma tal ɗiya.<verse eid="LUK 10:12" /></para>
  <para style="s1">Talya malangwa ɗimiyid ndan</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />“Kawa Koridzin! Kawa Mbatseda! Ənwulteena ɗǝɗamǝn ǝnanda ahur nun ndǝghǝn ǝnanda a Taya tǝ Saduma, kam ˈwanda teena malang nda ɗimiyid ndan, kalnda kukwasharya fa tsawa nda hai, na nda a irang fishe fandan fa. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />A far ngwala ƙǝshiirha, na Taya tǝ Saduma haɗang nda Faara fa ama kun. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />Sa ƙǝm Kafarnahum; tamngga ndaarha, nanda a mano a talara wa? Awo! Na ɗǝrha hu hwanga ɗǝ. <verse eid="LUK 10:15" /><verse number="16" style="v" sid="LUK 10:16" />Kala niifa sǝkka kun, nggini sǝknǝn, niifa kargha kun nggi karnǝn, kala tǝ karrǝna, karnǝn niifɗi thlǝngga nggi ɓa.”<verse eid="LUK 10:16" /></para>
  <para style="s1">Wutta kumggit mǝd kap sǝri ɗa ɓa</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Nafini kumnggit mǝd kap sǝri ɗi wunda ɓa tǝ wutsǝfayirha fa, ndang ngganda Yeeso, “Chinan, kahat tǝ ǝnkaheeya nanda sǝk kan a ndangɗan kanda kyama sǝ ahu thlǝm wa!” <verse eid="LUK 10:17" /><verse number="18" style="v" sid="LUK 10:18" />Ndangga Yeeso kanda, “Na ɗi Sheetan mukɗa hai a talara ƙǝla kyatta ˈyaara. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />Kama thlǝmarha hai, fǝrang ɗi sǝsǝmnda kun na a ishanggun huthlingya hai tǝ ngǝrɗaya, nun a kal fa mbǝlfeeya mba nda nang ˈya kun fa wa ko ngguchit. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />Ma tsǝɗun wutsǝfayirha nanǝn ya ka sǝkna ǝnkaheeya kun wa, ǝnama wutsǝfayirha fa ƙǝsǝr chirethleng nda thlǝm nun hai a talara.”<verse eid="LUK 10:20" /></para>
  <para style="s1">Tǝk Yeeso mbǝndafa</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />A sayidɗiya lǝghǝdɗǝ tǝ mbǝnafarha fa a fad Sǝsǝna tǝ peɗǝnda, ndǝghǝn, “Usaɗi sa Pǝpa, china yi talara tǝ hweeɗe, ƙǝsǝr ɓǝɓengna tur ǝngginiya a Fasǝngya tǝ fa hutengya, kyaɗang nan wundakhnaya nǝghǝn kee Pǝpa, ƙǝsǝr ǝnɗiya ndǝ kamogha. <verse eid="LUK 10:21" /><verse number="22" style="v" sid="LUK 10:22" />Pǝpa fǝreɗǝ ˈya na heu, mbǝ niifasǝ sǝngga wanɗi wa ƙǝl chin kee, tǝ ƙǝmɗa tǝ sǝngga wunni chin ɗi, ƙǝl wanɗi tǝ niifa na mid wanɗi kyaɗanggǝnǝn.”<verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />Kyahargha thlǝmad fatsahayighǝn ɓa, ndanggǝn kanda katendan, “Kun nun tǝ parka katǝrana ǝnggina hai ya a yinnun! <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />Niya pǝranggǝn kun, annabiya tǝ kutǝrya hangga mindan sǝ na ǝnɗi nun a naarha nanǝn ya, nawa ndan wa, tǝ ƙǝm sǝk ǝnɗa nda nun a sǝkrha ya, sǝkkwandan wa!”<verse eid="LUK 10:24" /></para>
  <para style="s">Wunni tulat na?</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />Na niifa sǝ tǝ sǝn ɗeleewar tǝ chireelth na Musa, ishgha sǝ ƙǝt nǝn a ƙǝƙǝrang nda Yeeso. Ndanggǝn, “Mala, ni naarha ƙǝn na a wal yibrha ni mbuwa ngwalarha?”<verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />Ndangga Yeeso, “Mani chirethleng nanda hai ahur ɗeleewar ɗi? Na karataghǝn ƙǝƙǝn?”<verse eid="LUK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27" />Nggǝmanggǝn, “Nggǝmu Chinǝm na Faara tǝ hurwa heu, tǝ yiɓǝd wa heu, tǝ kanglanggid wa heu, tǝ huten wa heu. Nggǝmu tulat wa ƙǝla alten wa.”<verse eid="LUK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28" />Ndangga Yeeso, “Nggǝmangna mǝmǝl, ǝno kee na wal yibrha.”<verse eid="LUK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />Kamshiɗiwu, na midghǝnsǝ na hǝrghanggǝn fadghǝn tsahang mee nǝn Yeeso, “Wunni tulat na?”<verse eid="LUK 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />Nggǝmangga Yeeso tǝ laɓara, “Na niifa sǝ thliigha a Urshelima ɗǝnǝn Djariko ɗǝ, mukka ahar fa thlee kwamangya fa hai, ɗǝkƙǝnda ƙǝɗanggan nda hai tawalth, malghǝn nda a pathlang yibrha tǝ mǝra. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />Na firis sǝ tǝrgha kwaman ɗi, ɓa walghǝn kalth mbǝrgha ɗǝ tǝ man patu. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />Na tǝ Lawirha sǝ ƙǝm tǝrgha kwaman ɗi. Na nǝn ndǝn kalth, ndǝghǝn nggima mbǝrgha ɗǝ tǝ man patu. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />Na tǝ Samariyarha sǝ tǝrgha kwaman ɗi, ɓa a walghǝn kalth, haɗanggǝn fa. <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />Ɗǝgha thlǝmadghǝn ɗǝ, tsaɓang wundǝdghǝnǝn ɗǝ tǝ aam annab, irang fǝɗeerha nǝn sǝ, ƙǝnanggǝn nǝn. Tǝranggǝn a ƙǝsǝr kwarghǝn sǝ ɗǝgha tǝghǝn a ƙǝn rongya ɗǝ.<note caller="+" style="f"><char style="fr" closed="false">10:34 </char><char style="ft" closed="false">Ƙǝn rongya, Kǝn hunaarha nǝm tiirha</char></note> <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Ɗalthna mbǝrha hai haranggǝn wuɗǝɓǝl wurirha sǝ sǝri fǝranggǝnǝn tǝ mindǝɗi, ndanggǝn, ‘Kǝlee niifɗa ha ya ˈya ɓǝlangna heu a kwasamad ǝnɗi furo ni ya, a wudɗiɓa ɓa ɓani nggeroƙǝn ha.’”<note caller="+" style="f"><char style="fr" closed="false">10:35 </char><char style="ft" closed="false">Pene: wuɗǝɓǝl tǝ ra pathlarha yi paara tal</char></note><verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />Tǝrgha Yeeso ndanggǝn, “A hur nafini na mahan ya, wunni tulat kamshiɗi mukka ahar fathlee kwaman nggina fa?”<verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />Ndangga tǝ sǝndǝɗi, “Niifɗi haɗangna niifɗa fa, ndǝna tuladghǝn.” Ndangga Yeeso, “Ɗuwaɗǝ a ǝno kee.”<verse eid="LUK 10:37" /></para>
  <para style="s1">Yeeso weng ɗǝ tala Marthla tǝ Mairamu</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />Yeeso tǝ fatsahayighǝn kanda aten wiirha, ɓa kyarha hu tala hai, na nuneefa sǝ thlǝmnggǝn ni Marthla. Thlǝghǝnǝn fa a minda keeghǝn. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Na wanman Marthla sǝ, thlǝmnggǝn ni Mairamu, ɓagha ɓa tsauka hai a thlǝmad Yeeso ndǝghǝn a kang thlǝmarha fa. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Marthla ƙǝm tar ǝnnarhami tǝrang ɗǝ tenggǝn ɗǝ. Tǝrgha ɓaa thlǝmad Yeeso ɓa ndanggǝn, “Paɓa, mba naghǝn wa yina wanmana maleɗǝ tar ǝnnarhami fa katenna? Ndang ɓagha ɗee sǝ lee.” <verse eid="LUK 10:40" /><verse number="41" style="v" sid="LUK 10:41" />Ndangga Yeeso, “Marthla! Marthla! Sa a ƙǝtǝlang fadwa fa aten fingya ǝngya hangga. <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />ˈYa tǝtal ni kee nanda kaɗaarha, Mairamu wurɗǝ ˈya na ngga, ƙǝsǝr mbǝ niifa sǝ na mbang thlang a harghǝn wa.”<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s1">Tsahad Yeeso ha aten hwan Faara</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Farɗa sǝ, Yeeso a hwan Faara a mbǝrha. Ngwalanǝn, tǝrgha tal ahur fatsahayighǝn ndanggǝn, “Paɓa, tsahang kwaman hwan Faara kan ha, ƙǝla tsahangna Yahaya tǝ Mbaptisǝma fatsahayighǝn ha lee.” <verse eid="LUK 11:1" /><verse number="2" style="v" sid="LUK 11:2" />Ndangga Yeeso, kanda, a naɗun a hwan Faara ndama,</para>
  <para style="q1" vid="LUK 11:2">“Chinǝm na a talara, <note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="ft" closed="false">Fingya ɗeleewarya na nda tǝ, </char></note></para>
  <para style="q1" vid="LUK 11:2">a chilɓi thlǝm wa nǝm ha,</para>
  <para style="q1" vid="LUK 11:2">kutǝryid wa ɓagha ɓa.<note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="ft" closed="false">Fingya ɗeleewarya ɓagha ɓa. ˈYa na midwa a ǝnaghǝnan hu ƙǝshiirha ƙǝla nanda a ǝnaarha a talara</char></note> <verse eid="LUK 11:2" /><verse number="3" style="v" sid="LUK 11:3" />Fǝrang ǝnnarhami kan yi weeriya tǝ yi ɓengya na ɓayi. <verse eid="LUK 11:3" /><verse number="4" style="v" sid="LUK 11:4" />Chahang ɗimiyin nan kanɗǝ, ƙǝla nan chahanggǝn fingyaɗǝ ǝnangga ɗimiyirha kan fa. A ɗǝnna tǝ kan ahu ƙǝƙǝrra ɗǝ wa.”<verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />Nggǝrgha Yeeso ndangnda fatsahayighǝn, “Ndam tal ahur nun nǝghǝn tǝ pashirha, ɗǝgha thlǝmadghǝn ɗǝ a manad fǝɗigrha ndanggǝn, ‘Wayee ǝne kumad mburodi ha mahan lee. <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />Ƙǝsǝr, na pashinna sǝ ɓaa ɓa ka wiirha tǝrɗa hai a kyana nanǝn ya. Kǝmɗa mbǝ ǝnnarhami sǝ a har na wa.’ <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" />Tǝrgha, andam pashidɗi kaɗagha kumarha a harghǝn, nggǝmngga ɓa a ƙǝn ndǝghǝn, ‘A ɓillanna nggi wa. ˈWaɗi teena changɗi kwatminda, kan tǝ wanggina hunaɗan hai, mbi mbang thliirha sǝ furo ˈya ni wa?’ <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />Niya ndangnda kun, a mbǝ a thliirha sǝ fǝrang ˈya nǝn ka tsaunǝn pashidghǝn wa, nǝn thlid sǝ fǝranggǝn tǝ kurmi na midghǝn. Ƙǝsǝr pashidghǝn ƙǝswa shilee ndǝn tǝ hwandǝɗi hwanang nǝn wa. <verse eid="LUK 11:8" /><verse number="9" style="v" sid="LUK 11:9" />Niya ndangnda kun, hwanama nanda fǝrang kun. Kaɗama nun a waala. Nama a ɗǝk kwatminda, nanda inanggǝn kun hai. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Ƙǝsǝr kala niifa hwangga, nanda a fǝrang, niifa kaɗagha ƙǝm nǝn a waala. Kǝmɗarha kala niifa ɗǝkka kwatminda nanda inanggǝn hai. <verse eid="LUK 11:10" /><verse number="11" style="v" sid="LUK 11:11" />Wunni ahur nun, a hwanang wanggǝn tǝna fǝrang huthne nǝn? <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />Tǝ ƙǝm a hwanang wanggǝn nggal ɗiyarha fǝrang ngǝrɗarha nǝn? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />A tsauɗǝ, kun na fa mbǝlfeeya sǝnɗun ˈya nun fǝrangnda wangginun ǝngya na ngga, sakwata chinun a talara, nǝn fǝr Sǝsǝna tǝ Peɗǝnda a nafiya na hwanda.”<verse eid="LUK 11:13" /></para>
  <para style="s1">Yeeso tǝ Mbaˈaldzabul</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Yeeso ƙǝnangɗǝ niifa ƙǝnangna ǝnkaheerha miighǝn, hǝrǝmna ǝnkaheedɗi kyarha sǝ a fadghǝn, katǝranggǝn ndikrha hai. Tǝrgha fiya ngwagha hai na ǝnwulteena nda. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />A mbǝɗi na fingya nafiya sǝ ndaa nda, “Mbaˈaldzabul ni kutǝr ǝnkaheeya fǝrangga ngyakhad ɗiya yi kyang ǝnkaheeya sǝ?” <verse eid="LUK 11:15" /><verse number="16" style="v" sid="LUK 11:16" />Fingya sǝ na mindan sǝ ƙǝƙǝrangganda Yeeso, ndang ngganda, a ǝna ǝnwulteena nǝn kyadgha ndaarha na Faara tǝghǝn ha. <verse eid="LUK 11:16" /><verse number="17" style="v" sid="LUK 11:17" />Tǝrgha Yeeso walang ɗǝ numan ndan, ndanggǝn kanda, “Kala kutǝryirha ɗǝkka hai sǝri, nanda yanda tǝ ndan, kutǝryidɗi mbǝ isha wa. Nǝghǝn kee ƙǝm a ɗǝk wure hai sǝri kanda a yanda, wuriɗi nǝn weela ɗǝ. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />A ndǝk Sheetan hai mbǝdghǝn sǝri, nǝn yan altenggǝn, ƙǝƙǝn na kutǝryirha ɗǝrha mbeeɗǝ? Nduwun tǝ ngyakhrha Mbaˈaldzabul ni kyangnda ǝnkaheeya sǝ. <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Anaɗǝ tǝ ngyakhrha Mbaˈaldzabul ni kyang ǝnkaheeya sǝ, fa tsahayinun wu? Tǝ ngyahad wun nanda kyang nda sǝ? Fa tsahayinun ni ngwang kumarha kun sǝ aten yanɗiya. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />Anaɗǝ tǝ sǝsǝmnda Faara ni kyang ǝnkaheeya sǝ, tsauɗǝ kutǝryid Faara ɓaɗǝ thlǝman nun ɓa. <verse eid="LUK 11:20" /><verse number="21" style="v" sid="LUK 11:21" />Niifa na kanglang, a ngwaɗa fa ngga, ndǝghǝn a ƙǝla wurighǝn ha, kari wurighǝn mbǝ ˈya sǝ walghǝn wa. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />Aɓad niifa ɓa ƙǝm kalgha ndǝn mu kanglanggirha, harghǝnǝn yanda, ɗǝghanggǝn hai, thlanggǝn kari yandǝɗi mbǝrsanǝn sǝ, tǝrgha ndǝghanggǝn kari ɗaɗǝ thlang nǝn. <verse eid="LUK 11:22" /><verse number="23" style="v" sid="LUK 11:23" />Niifa mbuwana midghǝn nggi, nǝghǝn a tsan nggi. Niifa ɗewa sǝ wumndǝghǝn, tǝ waleng nda ni ɗǝ.”<verse eid="LUK 11:23" /></para>
  <para style="s1">Wutta ǝnkaheerha tǝ imǝnda ɓa</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />“A kyad ǝnkaheerha sǝ tǝ imǝnda a fad niifa, nǝn naarha wiirha hai a mbǝǝya mbuwana aama sǝ ka a wal mbǝd yibrha nǝn. A walwa wa, nǝn ndaarha, ‘Ni wutta wuri ɗa ɗǝ kyani sa ɓa.’ <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />A ɓaɗa ɓa walɗǝ wuriɗi ngwangnda ɗǝ, tangsangnda wuriɗi ngga, <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />nǝn a wutta ɗǝgha ngwangnda ǝnkaheeya ɓa mǝd kalgha ndǝn mbǝlfeerha, ɓaanda tsaurha a mbǝɗi. A kwasamadghǝn, tsawud niifɗiya sǝssadghǝn nǝn kal yi kaar.”<verse eid="LUK 11:26" /></para>
  <para style="s1">Parka yi ƙǝkafek</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Na Yeeso a thlǝk ǝngginiya, tǝrangga nuneefa uradghǝn sǝ a pathlang fiya ndanggǝn, “Tǝ parka ni nuɗi nggǝtgha sa, har ƙǝronǝn sǝ ya!” <verse eid="LUK 11:27" /><verse number="28" style="v" sid="LUK 11:28" />Nggǝmangga Yeeso ndanggǝn, “Haˈi nǝghǝn kee, amma parkayirha kalɗǝ tsaurha afad nafiya na a sǝk laɓar Faara, kanda na taara sǝ.”<verse eid="LUK 11:28" /></para>
  <para style="s1">Mid fiya sǝ na ǝnwulteena</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />Na fiya aten chik ɓaarha thlǝmad Yeeso ɓa, ndǝghǝn, “Nafiya ƙǝshiid weeriya fa mbǝlfeeya ni. Na mindansǝ a kyaɗang ǝnwulteena nda kanda, mbǝ ǝnwulteena sǝ nanda kyaɗang kanda pak wa ƙǝl yi Yunana. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />Kǝla tsauna Yunana ǝnwulteena a nafiya Nineba, Wan Niifa ƙǝm nǝn tsaurha kee a nafiya ƙǝshiid weeriya. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />A far nggwala ƙǝshiirha, kwatamnda man ki pǝlasarya, nǝn a thliirha ɓa heu tǝ nafiya ƙǝshiid weeriya, kyaɗang ndaarha nǝn kanda ǝnawun mǝmǝl wa. Ɓaghǝn ɓa a mbǝrha na inggun ka ɓagha sǝk sǝnda Sulemanu. Nanǝn ya kulo niifa kalgha Sulemanu a mbǝɗiya. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />A far nggwala ƙǝshiirha, Ninebaya nanda a thliirha sǝ tǝ nafiya ƙǝshiid weeriya kyaɗang ndaarha nǝn kanda ǝnawa nda mǝmǝl wa, ƙǝsǝr kanda malangnda ɗimiyindan, ka laɓar Faara thlǝghangna Yunana kanda. Nanǝn ya, kulo niifa kalgha Yunana a mbǝɗiya!”<verse eid="LUK 11:32" /></para>
  <para style="s1">Kukwaryit farha</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />“Mbǝ niifa sǝ na njangnda patilla ɓǝɓenggǝn wa, nduwa tsǝɓanggǝn tǝ tǝɓa. Kǝl nǝn ɗǝfang nda a pǝpal na a kya niifa ɓa, na kukwaryirha nǝn. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Yirha ndǝna kukwaryit farha, ana yidwa kanglang hai, fadwa na heu nǝn naarha tǝ kukwaryirha. A mbǝ yidwa kanglang wa, fadwa na heu nǝn naarha hu wula. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Kulo sa hai, kukwaryirha nana tǝghǝn mbǝ wulani wa. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Ana fadwa na heu tǝ kukwaryirha, mbǝ mbǝrha sǝ na tǝ wula wa, fadwa na heu nǝn njaara hai, ƙǝla na kukwaryit patilla ǝnaarha.”<verse eid="LUK 11:36" /></para>
  <para style="s1">Yeeso yanangɗǝ Farisaya tǝ Fasǝngya ngyakhrha</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Ngwalana Yeeso laɓara, tǝrgha tǝ Farisarha mbu Yeeso nǝn wuri keeghǝn ɗǝ ka hǝb ǝnnarhami ɗǝ. Ɗǝgha Yeeso ɗǝ tsauka hai a hǝb ǝnnadɗa mii. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />Kǝla na tǝ Farisadɗa hai katǝrang Yeeso hǝbrha hai kula tsaɓang harghǝn ɗǝ wulangga teena. <verse eid="LUK 11:38" /><verse number="39" style="v" sid="LUK 11:39" />Ndangga Chinǝm, “Kun Farisaya, nun tsaɓang ƙǝsǝr tafarha ɗǝ tǝ ɗengnda nagha hur nun lǝlǝgɗa tǝ hukrha tǝ mbǝlfeerha. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Nurya kee, mbǝ Faarani ǝnagha ƙǝsǝrɗi tǝ hurɗi wa? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Amma fǝrama ˈya na a har nun a fa yamiya, ˈya na heu na yinun nǝn naarha tsǝtsaɓaɗǝ. <verse eid="LUK 11:41" /><verse number="42" style="v" sid="LUK 11:42" />Kawa ma, Farisaya! Nun fǝrangnda Faara tal ahu kum shi chimbee tǝ fingya shi kyahangya na heu. Malanggun tar ƙǝkafek tǝ nggǝmnda Faara. Tur ǝnggina niya kamngga ǝnon, kamngwa malanggun fingya wa. <verse eid="LUK 11:42" /><verse number="43" style="v" sid="LUK 11:43" />Kawa ma Farisaya! Na minnun sǝ a fǝrang mbǝd tsaurha nun kun na ngga ahu Ƙǝn Faara tǝ ƙǝmɗa nagha fiya a ndang ˈya kun ahu kasu. <verse eid="LUK 11:43" /><verse number="44" style="v" sid="LUK 11:44" />Kawa ma! Nuwun ƙǝla kwat mǝrya na fiya a wiirha atenggǝn ka yamid sǝnda.”<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Tǝrgha niifa tal ahur Fasǝngya ngyakhrha, ndanggǝn Yeeso, “Mala, a ndanna kee, ˈyarna kan ƙǝm!” <verse eid="LUK 11:45" /><verse number="46" style="v" sid="LUK 11:46" />Nggǝmangga Yeeso ndǝghǝn, “Kawa ma kun Fasǝngya ngyakhrha! Fǝrang rǝfrha nun fiya na haghǝn, kun tǝ alten nun ˈwawun tsuwarghǝn fa tǝ wan haara tal a thlar kanda nun wa. <verse eid="LUK 11:46" /><verse number="47" style="v" sid="LUK 11:47" />Kawa ma, tǝnɗun ten kwaya na nggǝngga ka a mananggun annabiya Faara, ɓǝlangna chichiyinun kanda ɗǝ. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />Kun tǝ alten nun naɗun ndǝn, ƙǝmɗa nggǝmɗun fa tǝ ˈya ǝnana chichiyinun. Ɓǝlangganda annabiya, kun ƙǝm tǝnanggun ten kwayindan. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />Nanǝn kee, ndǝn ndana sǝnda yi Faara, niya thlǝnang annabiya kanda ɗǝ tǝ Fatsahaya, nanda a ɓǝlang fingya, sǝsangganda fingya. <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />Tsaunǝn kee, na Faara a ngwang kumarha nafiya ƙǝshiid weeriya aten ɓǝla, ɓǝlang na nda annabiya ɗǝ na heu, ka katǝra ƙǝshiirha. <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />Ka aten far Habila ɗǝgha hu yi Dzakariya ɗǝ ɓǝlang na nda a pathlang mbǝd sataka tǝ mbǝrha na Tsǝtsaɓa ɗǝ ahu Ƙǝn Faara. Niya pǝranggǝn kun nanda a ngwang kumarha nafiya ƙǝshiid weeriya ƙǝsǝr ka nafini na heu ya. <verse eid="LUK 11:51" /><verse number="52" style="v" sid="LUK 11:52" />Kawa ma, Fasǝngya ngyakhrha! Kǝsɗun ǝn cha kwatmin sǝnda ha. Kun tǝ alten nun kyawun saɗǝ wa, malanggun fiya na mindan kyarha sa ɗǝ, kya nda ɗǝ wa.” <verse eid="LUK 11:52" /><verse number="53" style="v" sid="LUK 11:53" />Malangna Yeeso mbǝɗi, Fasǝngya ngyakhrha tǝ Farisaya katǝrang ngganda tsandǝghǝn hai, na nda a dzaramnggǝn tǝ tsakh miiya. <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />Na mindansǝ ɗǝfang takthleera nda ka a thlǝk ˈya nǝn mbuwa mǝmǝl.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s1">Yiyi thlǝmarha aten thlǝrɓuyid Farisaya</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />Wumna fiya ɓa hangga har kanda ishang ndan hai, katǝrangga Yeeso tsǝ laɓara ˈwan tǝ fatsahayighǝn, ndǝghǝn, “Kwarama tǝ mehen Farisaya ndǝna thlǝrɓuyirha. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />Mbǝ ˈyasǝ na nggǝnggǝla mbuwa inɗaɗǝ wa, tǝ ƙǝm mbǝ ˈyasǝ na ɓǝɓee mbuwa kyarha pǝpal ɓa wa. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Kala ˈya thlǝknun ɓǝɓee na fiya sǝƙǝn a pǝpal, ˈya thlǝknun ƙǝƙǝɗak nanda a kalmiighǝn ɗǝ sǝkƙǝna fiya.<verse eid="LUK 12:3" /></para>
  <para style="s1">Faara ndǝn kamngga a tǝrǝmnggǝnǝm</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />“Niya ndang kun shayina, a tǝrǝmɗun nafiya na a ɓǝl farha wa, a kwasamadɗi ɓǝlang na nda, mbu ˈyasǝ nanda naarha ɓal wa. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Niya pǝrang niifa kun nun tǝrǝmnda, tǝrmama Faara na tǝ sǝsǝmnda ɓǝlang nda farha, a kwasamadghǝn muwanggǝn ahu hwanga ɗǝ. Kǝkafek niya pǝranggǝn kun tǝrmama Faara! <verse eid="LUK 12:5" /><verse number="6" style="v" sid="LUK 12:6" />Mbǝna nda heng wuɗikkya ɗǝ tuf pene sǝri wa? Ko tǝtali ahur ndan mbǝɗangwa Faara wa. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Ko was tengginun ni ma nǝghǝn thlǝthlǝɗa. A tǝrǝmɗun wa, ƙǝsǝr kalɗun wuɗikkya kaan!”<verse eid="LUK 12:7" /></para>
  <para style="s1">Kyad sǝnda Ƙǝrǝsti a mbed fiya</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />“Niya ndang nda kun, kala niifa ndagha sǝnɗǝ nggi a mbed fiya, Wan Niifa ƙǝm nǝn a ndaarha sǝnɗa ndǝn a mbed fathlǝngya Faara. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />Niifa ƙǝm ndaarha sǝngwa nggi wa a mbed fiya, nggi ƙǝm ni ndaarha sǝngwi ndǝn wa a mbed fa thlǝngya Faara wa. <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" />Kala niifa na thlǝk pathla mbuwa ngga aten Wan Niifa na nda chahanggǝnɗǝ. Amma niifa sargha Sǝsǝna tǝ Peɗǝnda mba nda chahanggǝn ɗǝ wa. <verse eid="LUK 12:10" /><verse number="11" style="v" sid="LUK 12:11" />A ɗǝn nda tǝ kun a mbed mamngya Ƙǝn Faara ɗǝ, tǝ fa ngwa kumaya, tǝ kutǝrya, a ɓillaɗun tǝ kwamana nun a kyang altennun sǝ wa, ko tǝ pathla nun a nggǝrang kanda sǝwa. <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />Ƙǝsǝr Sǝsǝna tǝ Peɗǝnda nǝn a tsahang ˈya kun ha kamngga a thlǝwun.”<verse eid="LUK 12:12" /></para>
  <para style="s1">Karapu aten nur tǝƙǝna</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Tǝrgha niifasǝ ahur fiya ndanggǝn Yeeso, “Mala, ndang wan mana fǝre yina langaarha nǝn malang na mǝra chinan kan hai.” <verse eid="LUK 12:13" /><verse number="14" style="v" sid="LUK 12:14" />Tǝrgha Yeeso ndanggǝn, “Kaiya wayee, wun ɗǝfegha tǝ ngwa kumarha, ni ɗǝk langaarha?” <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Tǝrgha ndanggǝn kanda, “Kwarama fa, nama inggun tǝ ˈya na ɓarha ɓa tǝ kwit hura, ƙǝsǝr yiɓǝd niifa kalɗǝ ǝn ƙǝshiirha.” <verse eid="LUK 12:15" /><verse number="16" style="v" sid="LUK 12:16" />Fǝrang karapu nǝn kanda ndǝghǝn, “ˈWad tǝ ƙǝna naarha sǝ walgha ǝnnarhami ahu hedghǝn kaan. <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />Ndagha, ‘Mbǝ mbǝd ɗǝf ǝnnadɗami sǝ kyana wa. Mani naarha?’”<verse eid="LUK 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 12:18" />“Ndǝghǝn, ‘Yoo! Sǝnɗi ˈya niya naarha. Niya fǝlang ɓiriukina ɗǝ ya, tǝn fingya ni na mǝmanggǝn, iranggi ǝnnannami sa hai tǝ karinna heu.’” <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />Ndanggi altenna, “Kai! Na ǝngyasǝ na nggǝngga tǝ ǝnnarhami ɗǝfangna ɗǝ yi huraya hangga. Yiɓu, hǝɓu, saana tǝk mbǝnda na fa.” <verse eid="LUK 12:19" /><verse number="20" style="v" sid="LUK 12:20" />“Amma Faara ndanggǝn, ‘Sa nura! A fǝɗigɗi ya na nda a kaɗa yiɓǝdwa. Kariɗi ɗǝfangna ɗǝ ya nǝn a tsaurha yi wun?’”<verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />Ngwalangga Yeeso pathɗiya tǝ ndaarha, “Nǝn tsaurha kee tǝ niifa wumangga ƙǝna hai a altenggǝn, amma a mbed Faara tǝ yaminni.”<verse eid="LUK 12:21" /></para>
  <para style="s1">Ndangga Yeeso fatsahayighǝn ma ɓillaɗun wa</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Ndangga Yeeso fatsahayighǝn, “Niya ndang nda kun, a ɓillaɗun tǝ yiɓǝd nun, tǝ ˈya nun ǝnnarhami, tǝ ƙǝm ˈya nun kala fa wa. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Ƙǝsǝr yibrha kalɗǝ ǝnnarhami, farha ƙǝm kalɗǝ lukkya. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />Kǝla man wuɗikkya lee! Mba nda hǝfrha wa, mba nda hathla wa, mba nda tǝ ƙǝn ǝnnarhami ko ɓiriukya wa, ko nanǝn kee na Faara fǝrang ǝnnarhami kanda. Sǝngunsǝ mamnggit nun kalɗǝ yi wuɗikkya wa? <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Wunni ahur nun aten ɓilladghǝn na mbang chik ɓenggǝn, ko yi ɓeena tal ahu ƙǝshiirha? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />A mbun a mbang ǝna ˈya ngguchit ƙǝla yanɗiya wa, ƙǝn nun ɓillarha aten fingya ǝngya na mid nun?<verse eid="LUK 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27" />“Kǝla man fid ɗǝfya na nda tsǝrha. Mba nda na taara, ko pu kaɓarha wa. Nanǝn kee, niya ndang nda kun, ko kutǝra Sulemanu tǝ mamnggitghǝn ˈwa wa ngwarha fa ƙǝla tal ahur ndan wa. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />Ana Faara a ngwang nda hwalirha fa na a hee kiya, hwalirha nasǝ aweeriya, a ɓinda ƙǝm njigha ɗǝ, sakkwa kun nǝn ngwang kun fa? Kun fa yamid fǝrƙǝkafek! <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />A naɗun a numarha aten ǝnnarhami ko ǝn sarha wa, ma ɓillaɗun aten ǝnggini ya wa. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />Nafiya sǝngwa Faara na nda kaɗa tur ǝnggini ya, amma Chinun sǝnɗǝ ˈya na minnun. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Kun nggi kaɗama kutǝryid Faara, ǝnggini na heu ƙǝmya nǝn fǝranggǝn kun.<verse eid="LUK 12:31" /></para>
  <para style="s1">Tsaharhaha aten ɗǝfrha ƙǝna ɗǝ a talara</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />“Kun chiɓrha na ngguchit, a tǝrǝmɗun wa, ƙǝsǝr Chinǝm nǝn a tǝk mbǝndafa a fǝrang kutǝryidghǝn nǝn kun. <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />Heeman ˈǝngginun ɗǝ na heu, fǝrang wuɗǝɓǝlghǝn nun fa yamiya. Ɗǝfaman ƙǝna altennun ɗǝ mbuwa ngwalarha, ƙǝna mbuwa sǝbrha ɗǝ a talara, mbǝrha mbuwana ngaara kyarha ɗǝ ɗǝgha tǝrang, tǝ mbǝrha mbuwana mǝmemngya sǝɓang ɗǝ. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Ƙǝsǝr mberha na ƙǝnawa sǝ, ndǝna mbǝd numad wa.”<verse eid="LUK 12:34" /></para>
  <para style="s1">Ngwama fa ka wutta Yeeso ɓa</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />“Ngwama fa ka taara, patillan nun njinji. <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />Tsawama ƙǝla mafaya na ƙǝla turi ndan fa na wutta ɓa ahu wutsǝfayid kakhrha. A Wudɗa ɓa ɗǝk kwatminda nǝn, nanda inanggǝn hai wet. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Nǝn naarha ngga a fad mafayini a wud turi ndan ɓa, a ɓaɗǝ wal kanda a ƙǝlarha ka taara. Niya ndang nda kun, nǝn a kalang kaɓadghǝn hai kal yi taara nǝn, ndanggǝn kanda tsawama hai, fǝrang ǝnnarhami nǝn kanda. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />Nǝn naarha ngga a fad mafayini a wud turi ndan ɓa a manad fǝɗigrha, ko ahar tsar aɓaɗǝ wal kanda nggungwa fa.” <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />Nggǝrgha Yeeso thlǝghang karapu kanda, ndǝghǝn, “A sǝn ture sayidɗi na ngaara a kyarha wuri keeghǝn hai, mbǝ malang nda kyagha sa hai wa. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Kun ƙǝm tsawama nggungwa fa, ƙǝsǝr Wan Niifa nǝn a wutta ɓa a sayidɗi sǝngwa nun sǝ.”<verse eid="LUK 12:40" /></para>
  <para style="s1">Wunni mafarha na tǝ ƙǝkafek?</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Ndagha Mbiturus, “Paɓa, karapu ɗiya aten nan ǝnana nan wa, nduwa aten fiya na heu wa?” <verse eid="LUK 12:41" /><verse number="42" style="v" sid="LUK 12:42" />Nggǝmangga Chinǝm ndǝghǝn, “Tsawama ƙǝla mafadɗi na tǝ ƙǝkafek na ndǝndǝl ƙǝm, ɗǝfangna turighǝn aten mafayighǝn, na fǝrang ǝnnarhami kanda a sayidɗi kamngga. <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />Nǝn naarha ngga a fad mafadɗi ɓana turighǝn walghǝn a ǝna targhǝn mǝmǝl. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />Kǝkafek niya pǝranggǝn kun, nǝn ɗǝfang mafadɗi aten karidghǝn na heu. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />Amma a ndang mafadɗi altenggǝn, ‘Turina ɓawaɓa wet wa,’ tǝrgha katǝranggǝn ɗǝk mafaya nishya tǝ hǝshya, kyagha hu hǝbrha hai tǝ sarha nagha a tǝrang teena. <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />Turi mafadiya nǝn a wutta ɓa a fara sǝnngwanǝn sǝ. Turiɗi wu nǝn ɗǝkƙǝn kaan wumanggǝn tǝ nafiya na ɗimi.”<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />“Mafadɗi sǝngga ˈya na mid turighǝn a ǝnagha, amma ngwawafa wa, tǝ ƙǝm ǝnawa ǝnɗi ndang nanda a ǝnagha wa, na nda a tsaɗaghǝn kaan. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />Amma niifa sǝngwawa sǝ, a naɗǝ ˈya kamngga a tsǝtsǝlghǝn nda, na nda ɗǝkƙǝn ngguchit. Kala niifa fǝrang nda ˈya hangga, na nda kaɗa ˈya hangga a harghǝn. Niifa fǝrang nda ˈya hangga kaan, nanda kaɗa ˈya hangga a harghǝn kaan.”<verse eid="LUK 12:48" /></para>
  <para style="s1">Laɓar Yeeso nǝn tsahang fiya hai</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />Tǝrgha ndagha Yeeso, “Ɓani hu ƙǝshiirha ɓa tǝ ngwa kumarha na ƙǝla waarha. Ana nggǝmndǝna ni kam njang nda ɗǝ! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />Na mbaptisǝma sǝsaarha sǝ na nda a ǝneerha, ɓillaɗi kaan na a ǝneeƙǝn nda! <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Tamnggun ndaarha ɓang ni tsawud ɗǝɗemnggirha ƙǝshiirha ɓa wa? Awo! Niya ndang nda kun, ɓaniɓa tǝ tsakhrha hai. <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />Nanǝn ya, ahu wure tal nafiya tuf nanda tsakhrha hai pǝmnggǝn sǝri, nafiya mahan a tsan nafiya sǝri, nafiya sǝri ƙǝm a tsan nafiya mahan. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />China nǝn tsan wanggǝn. Wanɗi ƙǝm nǝn tsan chin. Man nǝn tsan wutaradghǝn, wutaradɗi ƙǝm a tsan man. Thlaɓǝrra nǝn tsan nu wanggǝn, nu wanɗi ƙǝm nǝn tsan thlaɓǝrghǝn.”<verse eid="LUK 12:53" /></para>
  <para style="s1">Sǝnda ˈya na mid Faara ǝnana ahu ɓengginiya</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Tǝrgha ndanggǝn fiya, “A naɗun hashmbe a man hǝmnda faara ɓa, nun ndaarha ‘Na ˈyaara ɓayi,’ ɓagha hai. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />A na ɓereurha ɓayi manki pǝlasarya ndon ‘Na ƙǝrta a naarha sǝ’, tǝrgha naghasǝ. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Fa thlǝrɓuya! Mbangɗun sǝnang kyaharra mbǝrha hai na a hweeɗe tǝ fǝrakh-amshi, amma sǝnda ǝn ɓengginiya sǝnggundun wa.<verse eid="LUK 12:56" /></para>
  <para style="s1">Taksaman Pathlang nun</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />“Mani mbuwa nun numarha ǝna ˈya nun na ngga kun tǝ alten nun?” <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Ndagha Yeeso, “Kǝla ndam, a huhwad niifa sa, kaɗu kwamana na a tangsanggun pathlang nun a kwamana. A karna fa, ɗǝnǝn tǝsa a mbed tǝ ngwa kumarha ɗǝ. Tǝ ngwa kumarha ƙǝm nǝn fǝrang sa wan sǝsalya. Wan sǝsalya ƙǝm na nda muworha ƙǝnɗǝ. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />Niya ndorha, mba kyarhaɓa wa ƙǝl tiina ǝnɗi kyo nanda heu.”<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s1">Malaman ɗimiyin nun amanun mǝra</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Nanǝn ya fingya sǝ a mbǝɗi, pǝranggǝn nda Yeeso laɓar Nggalilaya ndana Mbilatus a ɓǝlang ngganda kanda. Tǝrgha sodjaya ɓǝlangganda nafini a farɗi nanda a fǝr satakh ndan a Faara. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Nggǝmangga Yeeso kanda, ndǝghǝn, “Ka ɓǝlang nanda Nggalilayini kee, tamnggun ndaarha kalnda fiya na heu ɗimiyirha a Nggalili wa? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Awo! Niya pǝranggǝn kun, a malanggun ɗimiyid nun wa, kun na heu nun a mǝra ƙǝla kanda. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />Nduwa ƙǝm, ƙǝla nafini na kumkap uvaɗaɗi chana tǝndǝɗi na dzang a tendan hai a Siluwan, ɓǝlanggǝn kanda, tamggun ndaarha kalnda fiya na heu a Urshelima ɗimiyirha wa? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Awo! Niya pǝranggǝn kun, a malanggun ɗimiyid nun wa, kun na heu nun a mǝra ƙǝla kanda.”<verse eid="LUK 13:5" /></para>
  <para style="s1">Karapu aten shiɓarha mbuwa nggǝtta</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Tǝrgha Yeeso fǝrang karapu nǝn kanda, ndǝghǝn, “ˈWad niifa naarha sǝ na tǝ shiɓarha ahu hedghǝn, ɓagha ɓa ka a ɗakh wanggǝnǝn hai, walwa ko tǝtal wa. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Tsaunǝn kee, ndanggǝn niifɗi na a ƙǝla hedɗa ha, ‘Kulo a weeriya hurarha mahan nggi a ɓaarha ka kaɗa wan shiɓadɗa ɓa ya, ˈwawi wal wee atenggǝn wa. Kyathlang ɗǝ! Kama nda nǝm malang sǝ ˈwanggǝn mbǝrha hai ka?’ <verse eid="LUK 13:7" /><verse number="8" style="v" sid="LUK 13:8" />Tǝrgha tǝ ƙǝla hedɗa ha ndanggǝn, ‘Paɓa, malang sǝ, hasang chehweerha ni mu, irang thlii ˈwalya ni mu ahu huradɗiya. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />A nggǝdɗǝ a mbee tsaukwa sǝ, a nggǝtwa wa a kyathlanggǝm ɗǝ.’ ”<verse eid="LUK 13:9" /></para>
  <para style="s1">Yeeso ƙǝnangɗǝ nuneefa a far yibrha</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Farɗasǝ Yeeso a tsaharhaha a Ƙǝn Faara a far yibrha. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />Na nuneefa sǝ ǝnangna ǝnkaheerha wan haarha fa, sǝfnanggǝn yi hurarha kumkap uvaɗa. Nǝghǝn ƙǝƙǝɓa hai mbǝ mbang pǝpǝnɗa sǝ wa. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Nana Yeeso ndǝn, aaghǝnǝn ndanggǝn, “Sa nuɗiya, ƙǝnonda ahu wan hadwa.” <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Tǝrgha ɗǝfang haara nǝn teena, a mbǝɗi tsu, pǝpǝnggasǝ ɗǝfang shilee nǝn Faara teena. <verse eid="LUK 13:13" /><verse number="14" style="v" sid="LUK 13:14" />Tǝrgha mamnda ƙǝn hwan Faarɗi sǝbgha hurghǝn ɗǝ, ƙǝsǝr ka ƙǝnangna Yeeso nuɗi a far yibrha. Ndanggǝn nafini na a mbǝɗi, “Far taara mikki kamngga ana taara nǝm, ɓamaɓa hu ɓengginiya ƙǝnangganda kun mbǝ a far yibrha wa.”<verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />Ndangga Chinǝm kanda, “Fa thlǝrɓuya kee! Ashe, mbun kwasang thladnun sǝ tǝ kwarnun ɗun kyaɗang aama a far yibrha wa? <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Nuɗiya chichid Ibrahim ni, ƙǝnangna Sheetan hai, a weeriya hurarha kumkap uvaɗa. Ashe, mbǝ mǝmǝl ƙǝnanggǝm a far yibrha wa?”<verse eid="LUK 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 13:17" />A kwasamadɗi thlǝkna Yeeso laɓarɗiya, fingya na a tsanggǝn a mbǝɗi shiɗanggǝn kanda. Fingya nafiya ƙǝm, ƙǝl ǝna wutsǝfayirha nda heu, ƙǝsǝr ka ǝnwulteena ǝna nǝn.<verse eid="LUK 13:17" /></para>
  <para style="s1">Karapu yi wan parsǝna</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Tǝrgha ndagha Yeeso, “Na kutǝryid Faara ƙǝƙǝn? Tǝma nda ni sakhƙǝn sǝ? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />Kutǝryid talara nǝghǝn ƙǝla wan parsǝna na wanggǝn ngguchit ahur wiiya na heu, tǝrang na niifɗa sǝ hǝfanggǝn hai ahu hedghǝn. Mangga tsauka ɗefrha, wuɗikkya ǝna ƙǝnna nda ahu wuhwaryighǝn.”<verse eid="LUK 13:19" /></para>
  <para style="s1">Karapu aten mekhna</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Yeeso nggǝrghǝn tsakh mee, ndǝghǝn, “Tǝma ni sakh Kutǝryid Faara? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />Nǝghǝn ƙǝla mekhna yangna nuneefa tǝ humbarha tasau mahan, tǝrgha mehen ɗi wu chichaɗanggǝn.”<verse eid="LUK 13:21" /></para>
  <para style="s1">Kwamana hu Kutǝryid Faara ɗǝ nǝghǝn ƙǝla kwatminda na Iˈyaɓa</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Kǝsna Yeeso kwamana ɗǝnǝn Urshelima ɗǝ, kyagha hu talya hai na manggǝn tǝ na ngguchit nagha a tsahang fiya ha. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Tsahangga niifa mee ha tǝ ndaarha, “Mala, nafiya ngguchit ni ƙee na wal yibrha?” Ndangga Yeeso kanda, <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />“Habɓama na a kyon sa hai tǝ kwatminda na iˈyaɓa, ƙǝsǝr na minna sǝ a sǝnunsǝ, nafiya hangga na a kaɗa kyarha sa hai, mba nda mbangnda wa. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />A thlid tuwure sǝ ˈwaɗǝ teena nggǝlangɗǝ kwatminda, kun nggi ƙǝm nun a isha a ƙǝshi non a ɗǝk kwatminda ɗi, non a ndaarha, ‘Ture inang kwatminda kan hai!’ Ndǝghǝnggi ƙǝm nǝn a nggǝmang kun ndagha, ‘Sǝngwi mbǝɗi kyanun saɓa wa!’”<verse eid="LUK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 13:26" />“Tǝrgha nun a ndaarha, ‘Haba! Kǝm hǝɓǝm, sam tǝsa, har tsahannaha ahu talyi nan.’ <verse eid="LUK 13:26" /><verse number="27" style="v" sid="LUK 13:27" />Amma nǝn a ndangnda kun, ‘Sǝngwi mbǝɗi kyanun saɓa wa, ndǝghama hai tǝ nggi, fa mbǝlfeeyini ya.’<verse eid="LUK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28" />“Anaɗun Ibrahim tǝ Ishaku tǝ Yakubu, tǝ annabiya na heu, ahu Kutǝryid Faara, kun ƙǝm nanda a rǝk kun, a mbǝɗani nun a tǝrha tǝ ƙǝd mee. <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Nafiya a ɓarhaɓa a man kyad fara tǝ man hǝmndǝghǝn, man ki pǝlasarya tǝ man ki wufaya, tsawanda a mbǝd mbǝnafarha fa ahu Kutǝryid Faara. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />A mbǝɗaniya, fingya na a samarha, nanda a tsaurha a mbee, fingya na a mbee ƙǝm, nanda tsaurha a samarha.”<verse eid="LUK 13:30" /></para>
  <para style="s1">Sǝb hur Yeeso ɗǝ kaan aten Urshelima</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />A kwasamadɗi ngwalana Yeeso laɓara, fingya Farisaya ɓaa nda ɓa ndang ngganda Yeeso, “Thliu a mbǝɗiya, ƙǝsǝr Hirdus na midghǝnsǝ a ɓǝloghǝn.” <verse eid="LUK 13:31" /><verse number="32" style="v" sid="LUK 13:32" />Tǝrgha ndanggǝn kanda, “Ɗamaɗǝ ɗun pǝranggǝn tǝ thlǝrɓu ɗi tǝ ndaarha a weeriya ni a kyang ǝnkaheerha sǝ, tǝ ƙǝm ni a ƙǝnang nda fiya, aɓinda ƙǝm wai kee, a shikka ndǝ ni a ngwalang tarna. <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Ko nanǝn tsawee ɗafa a ɗi mbeeɗǝ tǝ winna nda weeriya tǝ ɓinda, ɗǝgha shikka ɗǝ. Kamngwa annabi mǝrgha a mbǝrha pak wa, ƙǝl a Urshelima. <verse eid="LUK 13:33" /><verse number="34" style="v" sid="LUK 13:34" />Sa! Urshelima! Urshelima! Fa ɓǝl annabiya tǝ muk fiya thlǝnna nda thlǝman nun ɓa. Sara kurmi na minna wumanggi kun ƙǝla na ɗiyarha ngwamang wanggighǝn a kamughǝn ɗǝ, amma karɗun fa! <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />Kulo mbiya wuri nun mbǝ niifa sǝ wa! Ni a pǝranggǝn kun, mbun nggǝr na nggi wa, ƙǝl fara ndanun tǝ ‘Parkani tǝ ɓagha ɓa hu thlǝm Chinǝm.’ ”<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s1">Yeeso ƙǝnangɗǝ niifa a far yibrha</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />A far yiɓǝd Yahudaya, ɗǝna Yeeso ka hǝb ǝnnarhami a minda ki mamnda tǝ Farisarha ɗǝ, djang yirha nda fa. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />A mbǝɗi ƙǝlagha hai niifa ƙǝt a mbedghǝn, saryighǝn tǝ haryighǝn hǝhǝthla hai. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Tsahangga Yeeso mee Farisayini tǝ fasǝngya ngyakhrha, “Ngyakhad Musa nggǝmɗafa a ƙǝnanggǝm niifa a Far Yibrha wa?” <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />Amma nggasa nda titib. Ƙǝsgha Yeeso har niifɗi, ƙǝnanggǝn ndanggǝn wiu fayi wa <verse eid="LUK 14:4" /><verse number="5" style="v" sid="LUK 14:5" />Tǝrgha tsahangga Yeeso mee kanda, “Ndam ahur nun na niifasǝ na tǝ wanggǝn<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="ft" closed="false">Fingya ɗeleewarya ndagha nda kwara a meyed wee</char></note> nduwa thladghǝn, mukɗǝ hu kwat aama hai afar yibrha, mbun ɗǝrhaɗǝ ɗun ƙǝɗang sǝ ƙǝkar wa?” <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />Mbangwanda kalasǝ wa.<verse eid="LUK 14:6" /></para>
  <para style="s1">Tsahad Yeeso ha tǝ ndaarha a manangna altenwa wa</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Kǝla na Yeeso hai nafini mbunanda ɓa, wurnda mbǝd tsaukya na nggǝngga, thlǝghang karapu ɗa nǝn kanda sǝ ya. <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />“A mbud niifa sa ahu wutsǝfayid kakhrha ɗǝ, ma tsauna a mbǝd tsawud mamngya wa. Nǝn ɓa naarha mbunda niifa ɓa kalgha sa mu mamnggirha. <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />Anaɗǝ kee, niifɗi mbuwa kun kyab, ɓagha ndorha, ‘Fǝrang mbǝd tsawud wa niifɗiya.’ Tǝrgha a mbǝɗiya na shilee ƙǝsorha, na thliirha a mbǝd tsaurha ɗǝ na ngguchit. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Amma a mbunda sa, wuru mbǝd tsaurha na ngguchit, a ɓad niifɗa ɓa mbuwa sa nǝn ndorha ‘Pashi, kulo mbǝd tsaurha na ngga ya.’ Tǝrgha na wal mamnggirha a mbed shayiwa na heu mbuna nda ɓa. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />Ƙǝsǝr kala niifa manangga altenggǝn nanda tsawang nda ngguchit, yanɗi manangwawa altenggǝn ƙǝm nanda manang nda.”<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Tǝrgha ndangga Yeeso niifɗi aagha ndǝn, “A anna niifa ka hǝb ǝnnarhami ɓa, ko ngwanna wutsǝfayirha fa, a mbunna pashiyi wa ɓa kee wa, ko wan manggiwa, tǝ hurfayiwa, tǝ tulayiwa fa ƙǝnaya wa. A ǝnanna kee, a fara sǝmǝn nanda a aah sa kanda nggima, teu ǝnɗa nda ǝnangna kanda. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Amma a nanna a mbu fiya hu wutsǝfayirha ɓa, mbuwu fa yamiya, tǝ nafiya mǝrna fandan, tǝ sǝfǝngya tǝ kwamaya, <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />na wal parka, ko nanǝn mba nda mbang teuƙǝn wa, Faara ni a teuƙǝn afar thlid fiya sǝ hu mǝra ǝnagha nggayirha.”<verse eid="LUK 14:14" /></para>
  <para style="s1">Karapu aten wutsǝfayirha na mam</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Na niifasǝ tal ahur nafini na a hǝb ǝnnarhami tǝ Yeeso sǝknǝn pathɗiya, ndanggǝn, “Tǝ parkani niifa ɓagha hǝb ǝnnarhami yi mbǝnafarha fa hu kutǝryid Faara.”<verse eid="LUK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16" />Nggǝmangga Yeeso, “Na niifa sǝ ngwagha fa ǝna wutsǝfayirha nǝn manggǝn mbu fiya nǝn hangga. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />A far wutsǝfayidɗi, thlǝn mafadghǝnǝn ɗǝgha ndang nda nafini mbunǝn ɓa, ‘Ɓama ɓa, ƙǝsǝr ngwaɗi fa nanǝnya.’”<verse eid="LUK 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 14:18" />“Amma kanda na heu na nda a ˈwarha hai. Yi tal ndǝghǝn, ‘Hiiɗi heerha ɗini ƙǝlang nda ɓa, hwanni sa a ƙǝrsana.’”<verse eid="LUK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 14:19" />“Yanɗasǝ ƙǝm ndǝghǝn, ‘Hiiɗi thlad huɗaya nggarma tuf, niyi hu kwaman ƙǝƙǝrang kanda, hwanni sa a ƙǝrsana.’ <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" />Tahadghǝn ƙǝm ndǝghǝn, ‘Kakhki ahu ɓenɗiya, tsaunǝn kee mbiya ɗǝrha ɗǝ wa.’”<verse eid="LUK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21" />“Wudgha mafadɗa ɓa pǝrang ǝngginanǝn turighǝn thlǝkna nafini. Tǝrgha turiɗi sǝbgha hurghǝn ɗǝ, ndanggǝn mafadghǝn, ‘Ɗuwaɗǝ ƙǝkar tǝr kwaman huɗarha na tǝ kwaman sarya ɗǝgha hu talya ɗǝ, ɓana ɓa tǝ fa yamiya, tǝ sǝfǝngya, tǝ kwamaya tǝ nafiya mǝrna fandan hai.’ <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" />Ndagha mafadɗi, ‘Paɓa, ngwalangɗi ǝnɗi ndaana, kulo mbiya takh mbǝrha.’”<verse eid="LUK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 14:23" />“Tǝrgha ndangga turiɗi mafadghǝn, ‘Ɗuwaɗǝ turu kwaman huɗaya ɗǝgha hu talya ɗǝ, ndangga kanda ɓanda ɓa tǝna wurina lǝghǝtta. <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />Niya pǝranggǝn kun, mbǝ niifa sǝ ahur nafini ˈwani mburha ɓa na taarang wutsǝfayidɗa fa kyana ya wa.’ ”<verse eid="LUK 14:24" /></para>
  <para style="s1">Pǝɗayid mbu samad Yeeso</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Farɗasǝ, fiya hangga a mbu samad Yeeso, tǝrgha kyahargha hai ndanggǝn kanda, <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />“Kala niifa na midghǝn mbu samadna a nggǝmngwa nggi kal yi chin nǝn tǝ man, nukkun tǝ wanggighǝn, wan manggighǝn hǝshya tǝ nishya, tǝ altenggǝn wa, mbǝ mbang tsaurha wan tǝ tsahanna wa. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />Kala niifa mbangwa tǝrang kaɗidghǝn sǝ mbu samanna nǝn, mbǝ mbang tsaurha wan tǝ tsahanna wa.”<verse eid="LUK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28" />“Andam na niifa sǝ ahur nun na midghǝn sǝ tǝn ƙǝnna na dzang, mbǝnǝn ˈwarha teena tsauka hai thlǝɗanggǝn ǝngya hai na ngwalang tǝndǝɗi ˈwan wa, ƙǝlanggǝn tǝ na wuɗǝɓǝla sǝ a harghǝn ngga na mbang ngwalang tǝndǝɗi wa?”<verse eid="LUK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 14:29" />A mbuhangɗa hai mbangwa mishilang wa, na fiya naarha waghǝn, <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />nanda a ndaarha, “Ƙǝlama kamshiɗa hai katǝrangɗǝ tǝnda hai mbangwa mishilang wa.”<verse eid="LUK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31" />“Nduwa ƙǝm ana kutǝra sǝ na midghǝnsǝ yanda tǝ shadghǝn kutǝra. Mbǝnǝn tsaurha hai numagha ƙǝlanggǝn tǝna sodjayighǝn haru kumnggit kum mbang pa ƙǝfarha tǝ ka yandǝghǝn na ɓai tǝ sodjaya haru kumnggit sǝri wa? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />A mbǝ a mbang wa, nen ˈwarha teena thlǝn nafiya ɗǝ ka yandǝghǝn ɓalɗǝ inggun ɗa nda kaɗa kwaman tsawud ɗǝɗemnggirha. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Nǝghǝn kee ƙǝm, kala niifa ahur nun a malangwa ǝngya nanǝn tǝghǝn heu wa, mbǝ tsaurha tǝ tsahanna wa.”<verse eid="LUK 14:33" /></para>
  <para style="s1">Tǝrra mbǝnda fǝsa ɗǝ</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />“Fǝsa ˈyani na ngga, amma a tǝr mbǝndǝghǝn ɗǝ, tǝ ma nǝm nggǝrang mbǝndǝghǝn ɓa? <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Ɓalwa targhǝnsǝ hu heerha na a mǝthlanggǝn wa, ƙǝl iraɗǝ kee.</para>
  <para style="p" vid="LUK 14:35">“Yi na tǝ thlǝmad sǝkrha sǝkƙǝnǝn.”<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s1">Karapu aten chaukhrarha sahadgha</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />Nanǝn ya fa thlǝ tsamngya tǝ fingya fa ɗimiya kanda heu a wumnda thlǝmad Yeeso ɓa ka a kang thlǝmanda fa. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />Amma Farisaya tǝ Fasǝngya ngyakhrha na nda a huhurumnda, “Kǝlaman niifɗiya ƙǝl thlǝ fa ɗimiya fa tǝ ƙǝm nagha a hǝbrha tǝ kanda.” <verse eid="LUK 15:2" /><verse number="3" style="v" sid="LUK 15:3" />Tǝrgha Yeeso fǝrang karapu ɗanǝn kanda ya. <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />“Ndam na niifasǝ ahur nun tǝ chauraya haru tal, sahadgha tal ahur ndan. Mbǝ malang kumnggit wutarihe kap wutarihe ɗi a mbǝd lafrha, ɗǝgha ka kaɗa yanɗaɗǝ sahadgha ƙǝl ma walangɗaɓa wa? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />A walang ɗaɓa, tǝ wutsǝfayirha nǝn a tǝrang a fad uradghǝn sǝ <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />ɗǝgha wure ɗǝ. Tǝrgha aah pashiyighǝn ɓa tǝ tulaya heu, ndanggǝn kanda, ‘Ɗeemasǝ wutsǝfayirha, walangɗi chauradɗi kyana sahadgha.’ <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />Niya pǝranggǝn kun, nanda ǝna wutsǝfayirha fa kaan kee a talara aten tǝ ɗimiyirha tǝtali malangga ɗimiyidghǝn, ma fingyayini na kumnggit wutarihe kap wutarihe na tǝ ƙǝkafek fa.<verse eid="LUK 15:7" /></para>
  <para style="s1">Karapu aten wuɗǝɓela sahadgha</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />“Nduwa ƙǝm ndam nuneefasǝ tǝ wuɗǝɓǝl wurirha kum sahadgha tal. Mbǝnǝn njang patilla, ngwanggǝn mindǝɗaɗǝ djib kaɗadghǝnǝn wa? <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />A walang ɗǝ, nǝn a aah wukwayighǝn ɓa tǝ tulaya, ndanggǝn kanda, ‘ɗeemasǝ wutsǝfayirha fa, walangɗi wuɗǝɓǝlɗi kyana sahadgha.’ <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />Niya pǝranggǝn kun, na wutsǝfayirha fa sǝ kee, a mbed fa thlǝngya Faara aten tǝ ɗimiyirha tǝtali malangga ɗimiyidghǝn.”<verse eid="LUK 15:10" /></para>
  <para style="s1">Karapu aten nggǝmnda china</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Yeeso ɗǝgha mbeeɗǝ tǝ pathla ndǝghǝn, “ˈWad niifa narhasǝ tǝ wundǝlayighǝn sǝri, <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />tǝ fewunda ndanggǝn chin, ‘Pǝpa fǝre yina langaarha ɓa.’ Tǝrgha chinɗi ndǝghang ƙǝnaghǝnǝn kanda.” <verse eid="LUK 15:12" /><verse number="13" style="v" sid="LUK 15:13" />Mǝngwa ha wa, tǝfewundǝɗi ngwanggǝn ǝnggighǝn na heu, ɗǝgha ahu chehwedɗǝ na inggun. A mbǝɗi ɓǝlanggǝn ƙǝnaghǝn ɗǝ hu ǝngya ƙǝlara tǝ pateyirha. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />A kwasamadɗi ngwalana ƙǝnaɗa hai keeghǝn, kyagha mirha hu chehwedɗa hai kaan, ƙǝsangga yamirha. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />Kaɗa taara nǝn ahar wan tǝ chehwedɗi, ndǝghǝn nggi ƙǝm fǝrang laf ƙǝlengarya nǝn. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Nǝn naarha kaɗa nggushir ƙǝlengaryini a ǝnagha mii, amma mbǝ niifasǝ fǝrangga ndǝn wa. <verse eid="LUK 15:16" /><verse number="17" style="v" sid="LUK 15:17" />“Ɓana hutenggǝn ɓa, ndǝghǝn, ‘Kai! Fa tarya pǝpa heu kanda a nggaala tǝ ǝnnarhami kaan kulo nggi a mǝra tǝ mirha! <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Niya thliirha nanǝnya, wuɗi thlǝmad pǝpa ɗǝ, ndanggi; Pǝpa, ǝnangɗi ɗimiyirha Faara fa, ǝnoɗi fa ƙǝm. <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />Kamngwi a aah nggina wan wa ɓalwa, tsawe kee tal ahur fa tar yiwa.’”<verse eid="LUK 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 15:20" />Thlidghǝnni, ɗǝgha wal chin.</para>
  <para style="p" vid="LUK 15:20">Amma ndǝghǝn ɓalɗǝ inggun, naghǝna chin ɗǝ, ɗaghaɗǝ hwathlaghǝn fa; ɗaghaɗǝ ɗǝgha wal wanggǝn, fǝɓanggǝn.<verse eid="LUK 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21" />“Ndangga wanɗi, ‘Pǝpa, ǝnangɗi ɗimiyirha Faara fa, ǝnoɗi fa ƙǝm, kamngwi a aah nggi nda wanwa ɓalwa.’”<verse eid="LUK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22" />“Amma chinɗi ndanggǝn mafayighǝn, ‘Ɗamaɗǝ ƙǝkar! Tǝrama kaɓarha ɓa na ngga kalanggunun fa. Paman wulenduwa a wan harghǝn tǝ pakhma a sarghǝn. <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />Kǝsama wan kwel ɓa, thlenggun uradghǝn, kim, ǝna wutsǝfayirha nǝm. <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />Ƙǝsǝr wanɗi kyana ya mǝrɗǝ, nggǝrɗǝ yibrha ƙǝfa; sahadɗǝ walang ɗǝm.’ Tǝrgha ɗǝnda mbeeɗǝ tǝ wutsǝfayirha fa.<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />“Katǝrana ǝnggina hai ya wanggǝn tǝ pamǝnda nǝghǝn a hee, ndusang nǝn wure fa, sǝk ɗǝk kangkar nǝn, fiya a rǝbrha. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />Tǝrgha aah mafad wuri ndan nǝn ɓa tal, tsahang mee nǝn ha, tǝma tsǝgha hai. <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />Ndangga mafadɗi, ‘Wan muwa ɓagha ɓa, tsu thlengɗǝ urad wan kwel sǝ, ƙǝsǝr wudɗa ɓa kanglang hai.’<verse eid="LUK 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28" />“Tǝ pamǝndǝɗi sǝbgha hurghǝn ɗǝ kaan kar kyarha nǝn fa wure hai. Kyagha chinsǝ, lǝmggǝnǝn fa. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />Amma ndanggǝn chin, ‘Kulo hai! Huraya hangga nggi a ǝno taara ƙǝla mafarha ˈwawi karo mee fa wa. Amma ˈwawa fǝre ko wan ˈwala ǝna wutsǝfayirha ni tǝ pashiyina wa. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />Amma wunna wanɗaɓa kyawa ya, sǝbangga ƙǝnawa ɗǝ afad sǝsǝwaya thleng urad wan kwel na sǝ!’”<verse eid="LUK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31" />Ndangga chin, “‘Waana, ka fad ɗathla mbǝrha fa hai ƙǝm kyab, ˈya na yina heu yiwa ni. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Amma ˈyani kamngga ǝna wutsǝfayirha nǝm, tǝk mbǝnda nǝm fa, ƙǝsǝr wan manɗi kyawa ya mǝrɗǝ, nggǝrɗǝ yibrha ƙǝfa. Sahadɗǝ walang ɗǝm.’ ”<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">Tsahad Yeeso aten thladwayid ƙǝla ƙǝna ha</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Ndangga Yeeso fatsahayighǝn, “ˈWad tǝ ƙǝna naarha sǝ na fiya a kiki mamnda tǝ targhǝn fa tǝ ndaarha nǝghǝn a sǝɓang ƙǝnaghǝn ɗǝ. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Aagha tǝ ƙǝnaɗi tǝ tarɗi keeghǝn tsahang mee nǝn, ‘Path ma niya sǝkrha atenwa? Fǝre kirassa tarwa ǝna nana, ƙǝsǝr mba nggǝr tsaurha mamnda tǝ tarna ɓalwa.’ <verse eid="LUK 16:2" /><verse number="3" style="v" sid="LUK 16:3" />Ndangga mamnda tǝ tarɗi altenggǝn, ‘Mani ǝnaarha nanǝnya? Kulo na turina a rǝk nggi ahu tarna. Nggi mbiyi kanglang na a huɗee wa, kee hu hwanda hai nǝn shiɗeerha. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Sǝnɗi ˈya niya ǝnaarha, a ƙǝɗen nda hai ma tarna tǝna fiya thlǝ nggi fa ahur mindǝndan.’”<verse eid="LUK 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5" />“Tǝrgha aah fa kumaya turighǝnǝn tǝtal, tǝtal. Tsahang mee nǝn yi tal, ‘Kurmi na turina a takkwa sa kumarha?’”<verse eid="LUK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6" />Ndanggǝn, “Fǝɗeerha ƙǝthlikrha haru uvaɗa.” Ndangga mamnda tǝ tarɗi, “Thlu ɗeleewar, tsawu hai ƙǝkar, chirethlengga hai haru faɗa.” <verse eid="LUK 16:6" /><verse number="7" style="v" sid="LUK 16:7" />Tǝrgha tsahang mee nǝn yi sǝri, ndanggǝn, “Kumarha kurmi a harwa?”</para>
  <para style="p" vid="LUK 16:7">Ndanggǝn, “‘Yawarha haru kum yi wan hwalirha.’” Ndanggǝn, “Thlu ɗeleewar chirethlengga hai haru uvaɗa.”<verse eid="LUK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8" />“Turiɗi fal mamnda tǝ tarɗa nǝn keeghǝn mbuwa wa tǝ ƙǝkafek fa ka thladwayidghǝn. Ƙǝsǝr nafiya ƙǝshiid weeriya hu tsawundan tǝ fiya yi ƙǝshin ndan kalnda nafiya na tǝ ƙǝkafekkirha thladwayirha.” <verse eid="LUK 16:8" /><verse number="9" style="v" sid="LUK 16:9" />Niya pǝranggǝn kun, ǝnama taara tǝ ƙǝna nun yi ƙǝshidɗiya tǝnun wal pashiya, ƙǝsǝr a fara ngwalanǝn hai, nanda thlǝ kun fa a talara pakwanɗǝ.<verse eid="LUK 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 16:10" />“Niifa na fiya fǝrƙǝkafek tǝghǝn ahu ˈya na ngguchit, tǝ ƙǝkafekni ƙǝm ahu ˈya na manggǝn. Niifa mbuwana ƙǝkafek sǝ a fadghǝn ahu ˈya na ngguchit, mbǝ ƙǝkafek sǝ ƙǝm a fadghǝn ahu ˈya na manggǝn wa. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />A ǝnawun ƙǝkafekirha hu ƙǝssa ƙǝna ƙǝshiirha wa, wunni fǝrƙǝkafek tǝ kun aten ƙǝna yi ƙǝkafek na a talara? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />A ǝnawun ƙǝkafekkirha aten ǝn niifa wa, wunni fǝrang yi altennun kun?<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />“Mbǝ mafarha sǝ na ǝnang taara turaya sǝri wa. Tsauɗǝ nǝn nggǝm tal kar tahadghǝnǝn, nduwa ƙǝm mananggǝn tal sar tahadghǝnǝn. Mbǝ ǝnaarha hai ǝnang taara nun Faara tǝ wuɗǝɓǝla kyab wa.”<verse eid="LUK 16:13" /></para>
  <para style="s">Yiyang Yeeso thlǝmarha Farisaya teena</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Farisaya na ngyingyilǝm tǝ wuɗǝɓǝla, sǝk nanda ǝnggini heu, nanda a chang yirha Yeeso fa. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />Ndanggǝn kanda, “Kunni manang nda fannun a yid fiya, amma Faara sǝnɗǝ huryinun. ˈYa nggǝmna fiya kaan, ǝn tsandani a yid Faara.<verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />“Ngyakhrha tǝ ɗeleewar annabiya ndǝna fiya takkwarha ɗǝgha hu ƙǝshiid Yahaya tǝ Mbaptisǝma ɗǝ. Ka a farɗi, laɓarɗi na ngga yi kutǝryid Faara pǝrndan, nagha kowunni a kaɗa kwamana na kyagha sa hai. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />Nǝghǝn pǝpa nda talara tǝ hweeɗe ngwalanda hai, ma ˈya ngguchit hu ɗeleewar ngyakhrha Faara kyagha ɗǝ.<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />“Kala niifa kalgha nukkun hai nggǝrghǝn kakhrha ǝnanǝn kulafayirha. Niifa ƙǝm kakhka nuneefa kalnanda hai, ǝnanǝn kulafayirha.”<verse eid="LUK 16:18" /></para>
  <para style="s">Liyadzuru tǝ tǝƙǝna</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />Ndangga Yeeso kanda, “Na tǝ ƙǝna sǝ, nǝn naarha kal kaɓarha fa na nggǝngga ka fad ɗathla mbǝrha fa hai nǝn naarha tǝk mbǝndayidghǝn fa. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />A kwatkirǝmnggǝn, na tǝ hwanda sǝ thlǝmnggǝnni Liyadzuru fadghǝn na heu wundǝyani. <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />Na midghǝnsǝ nagha a ɗan fǝfǝsǝrra ǝnnadɗami hǝrgha hai ahar tǝ ƙǝnaɗi. Wuɗaya nanda naarha ɓarha ɓa nanda a nii wundiyini keeghǝn.<verse eid="LUK 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22" />“Tsǝgha farɗa hai mǝrgha Liyadzuru, tǝrangga wangya thlǝnda Faara a thlǝmad Ibrahim ɗǝ. Tǝ ƙǝnaɗi ƙǝm mergha pangganda. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />Ndǝghǝn ahu hwanga a sǝsaarha, tǝranggǝn tenggǝn sǝ ƙǝlagha ɗǝ, na Ibrahim nǝn ɗǝ inggun tǝ Liyadzuru a thlǝmadghǝn. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />Tǝrgha aaghǝnǝn ɗǝ, ‘Pǝpa Ibrahim a haɗoyi fa, thlǝnu Liyadzuru ɓa ɓagha pang wan harghǝn hu aama hai tsǝtse ƙǝnǝn mii hai mbiɗenggǝn sheneuna ɗǝ, ƙǝsǝr ni a sǝsaarha kaan ahu waɗɗiya.’<verse eid="LUK 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25" />“Amma ndangga Ibrahim, ‘Waana ɗalu teena hai tsawudwa hu ƙǝshiirha, walna ǝn ƙǝshiirha tǝkna mbǝnda fa, Liyadzuru ƙǝm sǝsaɗǝ. Amma kulo nanǝnya a tǝk mbǝnda fa a mbǝɗiya, sa a sǝsaarha. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />Mbǝ kee ma wa, pathlang nan tǝ sa na kwarhasǝ manggǝn kuɗimnggǝn, fingya na mindansǝ ɗǝrha thlǝmannun ɗǝ amana nda mbang nda, tǝ ƙǝmɗa, ahur nun mbǝ niifa mbang tǝɗaarha thlǝmannan ɓa wa.’ <verse eid="LUK 16:26" /><verse number="27" style="v" sid="LUK 16:27" />Ndagha tǝ ƙǝnaɗi, ‘Nanǝn kee, niya hwan sa pǝpa, thlǝnu Liyadzuru a minda ki pǝpa ɗǝ; <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />ƙǝsǝr na wanmanggina sǝ tuf hǝshya. Ɗǝgha yiyi thlǝman ndan, amana nda ɓarha hu sǝsadɗa ɓa ya ƙǝm.’<verse eid="LUK 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29" />“Ndangga Ibrahim, ‘Na ngyakhrha Musa sǝ, tǝ yi Annabiya, kang thlǝmanda kanda fa lee.’ <verse eid="LUK 16:29" /><verse number="30" style="v" sid="LUK 16:30" />Ndagha tǝ ƙǝnaɗi, ‘Mbǝ kewa pǝpa Ibrahim, amma a thlid niifa sǝ ahur mǝrya ɗǝgha thlǝmandan ɗǝ nanda fǝrƙǝkafek.’<verse eid="LUK 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31" />“Ndangga Ibrahim, ‘A sǝkkwanda ˈya chirethna Musa tǝ yi Annabiya wa, ka thliina niifa sǝ ahur mǝrya, mba nda kang thlǝmarha fa wa.’ ”<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">Thlǝk Yeeso pathla aten ɗimiyirha tǝ chakhrǝghǝn ɗǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Ndangga Yeeso fatsahayighǝn, “Əngya na kyang niifa hu ɗimiyirha hai nǝn ɓarha ɓa, amma kawa a niifɗi ɓagha ɓa tǝghǝn. <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />A nggushi waghang nda fǝn hǝrha ura mughangganda ahu wuri aama ɗǝ, ma kyanggǝn tal ahur wangginiya hu ɗimiyirha hai. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" />Yoo, kwarama altennun.”</para>
  <para style="p" vid="LUK 17:3">“A ǝnad shadwa ɗimiyirha, yanang, a nda ɗǝ cheeɗa hai, chahanggǝn ɗǝ. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />A ǝnoɗǝ ɗimiyirha fa sara mǝd hu parra fara, sara mǝd a wutta thlǝmad wa ɓa, ndǝghǝn, ‘Cheeɗa hai,’ chahanggǝn ɗǝ.”<verse eid="LUK 17:4" /></para>
  <para style="s">Chighang fǝrƙǝkafek kan</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Fathlǝngya Yeeso ndang ngganda, “Chighang fǝrƙǝkafek kan.”<verse eid="LUK 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6" />Ndanggǝn kanda, “Ana fǝrƙǝkafek sǝ a fannun ƙǝla wan parsǝna, nun ndangnda ɗǝfǝdɗi na manggǝn ya, ‘Kǝɗusǝ ɗa rarha hai hu wuri aama ɗǝ,’ nǝn takkwa miwa.<verse eid="LUK 17:6" /></para>
  <para style="s">Tsawud nggayid mafarha</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />“A ndam tal ahur nun na mafadghǝn sǝ na a huɗang sǝ nduwa na a lafang chaukhrayighǝn. Nǝn ndangnda mafadɗi a wudɗaɓa a hee, ‘Ɓoɓa nanǝn ya ɓa tsau hai hǝɓaana’? <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />A meghedghǝn kamngwa a ndagha, ‘Fuweesǝ ˈwan ngwana fa ƙǝla nggina ngwala hǝbrha ni tǝ sarha aɗa hǝb yiwa tǝ sarha wa’? <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />Nǝn usa mafadɗi, ƙǝsǝr ka ǝnanǝn taara ndangnanda ǝnagha wa? <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />Nuwun kee ƙǝm, a ngwalang ɗun ǝngya ndang nanda kun ǝnon, ndaama, ‘Mafaya ni kan kee, ǝnanan tar nan.’ ”<verse eid="LUK 17:10" /></para>
  <para style="s">Yeeso ƙǝnangɗǝ fa termeeya kum</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Nanǝn ya na Yeeso a ɗǝrha Urshelima ɗǝ, tǝrghǝn kwamana kyagha tǝ ten sǝrǝk chehweed Samariya tǝ Nggalili. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Takh nǝn a kyarha hu tala hai, nafiya kum na tǝ wanhad termeerha ɓa nda ɓa isha nda ɗǝ inggun <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />aaghǝn nda ɗǝ tǝ urarha manggǝn, “Yeeso, Paɓa, a haɗowan fa!”<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />Nanǝn kanda, ndǝghǝn, “Ɗamaɗǝ ɗun kyaɗang fannun firistaya.” Kanda aten wiirha kee, ƙǝla nda hai ƙǝnda. <verse eid="LUK 17:14" /><verse number="15" style="v" sid="LUK 17:15" />Tal ahur ndan, ƙǝla nǝn hai ƙǝnɗǝ, wudgha ɓa, tǝranggǝn uradghǝn sǝ kaan nagha a fal Faara. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />Ɓaa ɓǝrgha hai a mbed Yeeso, usaghǝnǝn. Ndǝghǝnggi ƙǝm tǝ Samariyarha.<verse eid="LUK 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17" />Tsakhka Yeeso mee, “Mbǝ kanda kum heu ƙǝngga wa? Ai fingya wutarihe? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />Mbusǝ ko tǝ tǝtal wudgha ɓa ɓaa usa Faara wa ƙǝl rongɗiya?” <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Tǝrgha ndangga Yeeso, “Thliu sǝ wiu; fǝrƙǝkafekkid wa ni ƙǝnowa.”<verse eid="LUK 17:19" /></para>
  <para style="s">Tsakh mee aten ɓad Kutǝryid Faara ɓa</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Na farɗa sǝ, Farisaya tsahang mee nda Yeeso, “A kwan na kutǝryid Faara a ɓarha ɓa.” Nggǝmangga Yeeso kanda ndǝghǝn, “Ai ɓad kutǝryid Faara ɓa, mbun naghǝn tǝ yirha wa. <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />Mbǝ fiya ndaarha, ‘Kulo ndǝghǝn ya,’ nduwa, ‘Kulo ndǝghǝn taarha,’ wa. Ƙǝsǝr kutǝryid Faara nǝghǝn ahur nun.”<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Tǝrgha ndangga Yeeso fatsahayighǝn, “Na fara ɓayi na minnun ɓa tǝraa nang yirha Wan Niifa fa ko yi paara tal, amma mbun naghǝn wa. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />Na fiya ndang nda kun, ‘Kulo ndǝghǝn taarha!’ nduwa, ‘Kulo ndǝghǝn ya!’ a ɗaɗun ɗǝ a samandan wa. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />Ƙǝsǝr Wan Niifa a far wuttǝghǝn ɓa, nǝn naarha ƙǝla kyatta ˈyaara na djaara hai a fǝrakh amshi tsuwar mbǝya nǝn fa heu. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Amma nǝn a ˈwa taarang sǝsaarha fa ɗǝɗamǝn-ɗǝɗamǝn, tǝ ƙǝm nafiya ƙǝshiid weeriya nanda a karghǝn fa.<verse eid="LUK 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26" />“Ƙǝla ˈwanǝn katǝrarha hai a thlakh mbǝd Nuhu, ɓanǝn naarha kee ƙǝm a far wutta Wan Niifa ɓa. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />Fiya a hǝbrha tǝ sarha, hǝshya a kakhrha, kanda a fǝr nishya a chimadɗǝ ta farɗaɗǝ kyana Nuhu ahu kwambuwol hai. Tǝrgha ɓagha aam afa afa ɓa ɓǝlanggǝn kanda ɗǝ heu.”<verse eid="LUK 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28" />Nǝghǝn wai kee a thlakh mbǝd Lutu. Fiya a hǝbrha tǝ sarha, kanda a hiirha tǝ hengnda ɗǝ, kanda a hǝfrha tǝ tǝnda. <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />Amma a farɗi malna Lutu Sodom, irr nda waarha hai tǝ tsal waarha a talara, ˈyanggǝn kanda ɗǝ heu.<verse eid="LUK 17:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30" />“Ɓanǝn naarha ƙǝla yanɗiya a far wutta Wan Niifa ɓa. <verse eid="LUK 17:30" /><verse number="31" style="v" sid="LUK 17:31" />A farɗi, mbǝ niifa naarha aten ƙǝnggǝn, tǝ karidghǝnsǝ a ƙǝn, mbǝ tǝraa hai ɓagha harang wa. Tǝ ƙǝm, mbǝ niifa ɗǝrha heeɗǝ ndagha nǝn wutta wure ɗǝ ka ɗǝgha har ǝngya wa. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />Ɗalama teena hai tǝ ˈya walgha nu Lutu! <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />Kala niifa nggǝmngga yiɓǝdghǝn nǝn ƙǝɗengnda, yi ƙǝɗengga yiɓǝdghǝn, ɗǝfang nǝn ɗǝ. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />Niya pǝranggǝn kun, a fǝɗikɗi na ǝnɗi a katǝrarha hai ya, nafiya sǝri kanda kalth ahu sǝra tal, na nda a tǝraa tal mal tal. <verse eid="LUK 17:34" /><verse number="35-36" style="v" sid="LUK 17:35-36" />Nishya sǝri a hǝ hwarma kyab, nanda tǝraa tal takhka tal. Na hǝshya sǝri naarha a hee, nanda a tǝraa tal mal tal nda.”<verse eid="LUK 17:35-36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37" />Tsahang mee nda, “A yanggi na ǝnɗi katǝrarha hai ya, Chinǝm?” Ndanggǝn kanda, “Mbǝd mǝrra ˈya, mbǝd wumnda sǝkɗiyani.”<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">Karapu aten nu mǝrra tǝ tǝngwa kumarha mbuwa tǝrǝm Faara</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Tǝrgha Yeeso fǝrang karapu nǝn fatsahayighǝn na a tsahanggǝn kanda ha a ɗǝnda mbeeɗǝ tǝ hwanda Faara kafad ɗathla mbǝrha fa hai, ma tǝkɗǝ kanda wa. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />Ndǝghǝn, “Na tǝ ngwa kumarha sǝ hu tala mbǝ tǝrǝm Faara wa, tǝ ƙǝm njiɗangwa ˈya tǝ fiya wa. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />A hu talɗi na numǝrra sǝ nǝn naarha ɓarha thlǝmadghǝn ɓa tǝ hwanda, ‘Nggo kumad ƙǝkafekkirha a pathlang nan tǝ niifɗi ya.’ <verse eid="LUK 18:3" /><verse number="4" style="v" sid="LUK 18:4" />A hu katǝradghǝn karɗa fa. Amma akwasamadghǝn ndanggǝn altenggǝn, ‘Ko nanǝn mbi tǝrǝm Faara wa tǝ ƙǝm njiɗewa ˈya tǝ fiya wa; <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />ƙǝsǝr ka nuɗi ɓillagha nggiya, niya ngwang kumad ƙǝkafekkirha amanǝn nggǝr ɗahang minna ɗǝ!’ ”<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />Ndagha Chinǝm, “Sǝghama ˈya ndana ndirwid tǝ ngwa kumadɗi. <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />Ashe, Faara mbǝ mbang ngwang kumad ƙǝkafekkirha nafiyighǝn wurnǝn, na a hwanggǝn nda yan fara tǝ fǝɗikrha wa? Nǝn kukwasa hu ɗang nda kanda sǝ wa? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />Niya pǝranggǝn kun, nǝn ƙǝlarha hai walnda ngwa kumad ƙǝkafekkirha ƙǝkar. Amma, a wud Wan Niifa ɓa, ɓa nǝn wal fǝrƙǝkafekirha ahu ƙǝshidɗiya wa?”<verse eid="LUK 18:8" /></para>
  <para style="s">Karapu aten tǝ Farisarha tǝ tǝthlǝ tsamnda</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Aten fingya na numarha na nda tǝ ƙǝkafek fa na nda a sarang fiyaɗǝ, thlǝghangga Yeeso karapuɗi kanda sǝ ya. <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />Ndǝghǝn, “Nafiya sǝri, kyanda hu Ƙǝn Faara ɗǝ na manggǝn ka a hwan Faara nda. Tal tǝ Farisarha ni tahadghǝn ƙǝm tǝ thlǝ tsamnda. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />Tǝ Farisadɗi thliigha sǝ hwan Faara nǝn ka altenggǝn, ndǝghǝn, ‘Faara usaɗi sa mbuwani ƙǝla fingya nafiya tsauka ngaarya, fa mbǝlfeeya, kulafaya, tǝ ƙǝm mbiyi ƙǝla tǝ thlǝ tsamdǝɗiya wa. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Ni kar aama sara sǝri ahu ɓeena mǝd tǝ ƙǝm ni fǝr tal ahu ˈya kum walni ha heu.’<verse eid="LUK 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13" />“Tǝ thlǝ tsamndǝɗi ishgha ɗǝ inggun. Mbǝ ƙǝlarha talara ɗǝwa, amma nagha a ɗǝk ƙǝfadghǝn ka sǝbrha hura ndǝghǝn, ‘Faara a haɗoyi fa, kulo nggiya tǝ ɗǝmiyirha, ɗee sǝ!’<verse eid="LUK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14" />“Niya pǝranggǝn kun, tǝ ndaarha niifɗiya mbǝ ƙǝla tǝ Farisadɗi wa, wiiɗǝ wureɗǝ tǝ nggayid Faara a fadghǝn. Ƙǝsǝr kala niifa manangga altenggǝn nanda a tsawangnda ngguchit, tǝ ƙǝm niifa tsawangga fadghǝn ngguchit nanda a manang nda.”<verse eid="LUK 18:14" /></para>
  <para style="s">Ɗǝfang Yeeso Parka Wundakhnaya Teena</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Nagha fiya a ɓarha ɓa tǝ wanggindan a thlǝmad Yeeso ɓa ka ɗǝfang parka nǝn kanda teena. Ƙǝlana fatsahayighǝn hai kee, nanda a yanang kanda. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />Amma Yeeso aah wanggina nǝn a thlǝmadghǝn ɓa, ndǝghǝn, “Malaman wanggini na nggu-ngguchit ɓanda thlǝmanna ɓa, a ˈyaɗang ɗun mana kanda wa. Ƙǝsǝr kutǝryid Faara yi tur ndan ni. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Niya pǝrang ƙǝkafek kun, kala niifa thlǝwa wa kutǝryid Faara fa ƙǝla na wundakhnee ngguchit ǝnaarha wa, mbǝ tam kyarha sahai wa.”<verse eid="LUK 18:17" /></para>
  <para style="s">Tǝ ƙǝna tǝ kutǝryid Faara</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Na mamnda Yahudaya sǝ, tsahang mee nǝn Yeeso, ndǝghǝn, “Ka tǝmalǝmnda, mani ǝnaarha tǝni wal yibrha mbuwa ngwalarha?”<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />Ndangga Yeeso, “Mani na aah nggi ka niifa? Mbǝ ka niifa sǝ wa ƙǝl Faara katenggǝn. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />Sǝnna ˈya ndana ngyakhrha Musa, a ǝnanna kulafayirha wa, a ɓǝlna farha wa, a ngarna wa, a pǝrna ˈya aten nggaɓaarha wa, no tsu hai tǝ muwa.”<verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />Ndangga niifɗi, “Ka nggi ngguchit lafɗi ǝngginiya.”<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />Sǝkna Yeeso ndǝn, ndanggǝn, “Taho ˈyaha tǝtal. Heng ǝnggiwa ɗǝ heu fǝrang wuɗǝɓǝlghǝna fa yamiya, na wal mbǝd ɗǝfrǝghǝn a talara. A ɓanaɓa ɓa mbu samanna.”<verse eid="LUK 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 18:23" />Sǝknǝn pathɗiya, sǝbgha hurghǝn ɗǝ kaan, ƙǝsǝr niifani na tǝ ƙǝna kaan. <verse eid="LUK 18:23" /><verse number="24" style="v" sid="LUK 18:24" />Kǝlangga Yeeso ɗǝ, ndǝghǝn, “Nǝn naarha pǝɗaghǝn na a kyagha tǝ ƙǝna hu kutǝryid Faara ɗǝ! <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Nǝn naarha pǝpa na a kyagha thlǝkhmu ɗǝ tǝ kwad libra, ma tǝ ƙǝna na a kyagha hu kutǝryid Faara ɗǝ.”<verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />Nafiya sǝkka pathɗiya tsahang mee ndaha, “Anaɗǝ kee, wunni wal hǝrǝkrha?” <verse eid="LUK 18:26" /><verse number="27" style="v" sid="LUK 18:27" />Nggǝmangga Yeeso ndǝghǝn, “ˈYa mbuwana fiya mbang ǝnaarha, na Faara mbang ǝnaghǝn.”<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />Ndangga Mbiturus, “Kulo kanya, malangɗan ǝngginan heu mbuɗan samadwa!”<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />Ndangga Yeeso kanda, “Niya pǝrang ƙǝkafek kun, mbǝ niifasǝ na malang wure, nduwa nukkun, nduwa wanmanggighǝn, nduwa fa nggǝtyighǝn, nduwa wanggighǝn ƙǝsǝr ka kutǝryid Faara <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />na ƙǝɗeng nda walla ǝngya hangga kal yi ƙǝtǝm nǝn hu ƙǝshiid weeriya wa. A talara ƙǝm nǝn wal yibrha mbuwa ngwalarha.”<verse eid="LUK 18:30" /></para>
  <para style="s">Nggǝr Yeeso ndikrha aten kwaman mǝrrǝghǝn</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Tǝrgha Yeeso ɗǝgha tǝ Kum kap sǝri ɗi man patu ɗǝ, ndanggǝn kanda, “Ɗǝnǝm Urshalima ɗǝ, a mbǝɗi ˈya chirethleng na annabiya hai aten Wan Niifa nǝn a lǝghǝtta. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />Na nda a fǝranggǝn nafiya mbuwa Yahudaya. Nanda a waghǝn, kyalanda tǝghǝn, chahang yakhrha nda fa tsaɗaghǝnda kaan tǝ ƙǝm ɓǝlangganda. <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />A far paara yi mahan nǝn a thliirha sǝ.”<verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />Fatsahayighǝn hwathlang ngwanda pathɗa hai ki Yeeso wa. Ɓǝɓeng nda ten laɓarɗi kanda, ndǝghǝnni hwathlang ngwanda pathɗa hai nǝn a thlǝkrha.<verse eid="LUK 18:34" /></para>
  <para style="s">Ƙǝnang Yeeso kwamarha tǝhwanda</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Ndusangna Yeeso Djariko fa, na kwamarha sǝ tsau a mii kwamana a hwanda. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />Sǝknǝn fad fiya hangga a mbǝraɗǝ, tsakh mee nǝn, mani katǝragha hai? <verse eid="LUK 18:36" /><verse number="37" style="v" sid="LUK 18:37" />Ndang ngganda, “Yeeso tǝ Nadzarat ndǝna a mbǝraɗǝ.”<verse eid="LUK 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38" />Tǝranggǝn uradghǝn sǝ kaan, ndǝghǝn, “Yeeso, Wan Ndauda a haɗoyifa.”<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />Fingya na a mbee njarghǝnda a nggasgha hai. Amma nggǝrghǝn tǝrang uradghǝn sǝ kaan, ndǝghǝn, “Wan Ndauda a haɗoyi fa!”<verse eid="LUK 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40" />Ishgha Yeeso hai ndagha a ɓaa nda tǝghǝn thlǝmadghǝn ɓa. Nduwusnǝn ɓa tsahangga Yeeso mee, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />“Mana midwa a ǝnoyi?” Nggǝmangga kwamadɗi, ndǝghǝn, “Paɓa, na minna sǝ a namana ni hai.” <verse eid="LUK 18:41" /><verse number="42" style="v" sid="LUK 18:42" />Ndangga Yeeso, “Yoo, no mana hai, fǝrƙǝkafekkid wa ƙǝnoɗǝ.” <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />A mbǝɗi kee, namana nǝn hai mbu samad Yeeso nǝn, nagha a fal Faara. Fiya heu na nanda ǝnɗi katǝragha hai, fal Faara nda ƙǝm.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">Yeeso tǝ Dzakka</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Kyagha Yeeso hur Djariko hai, nǝn a mbǝra mbeeɗǝ tǝ hur talɗi. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />A mbǝɗi na niifasǝ thlǝmnggǝnni Dzakka, mamnda fa thlǝ tsamngyani tǝ ƙǝm tǝ ƙǝna ni. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />Na midghǝnsǝ ana niifɗanǝn nanda aarha Yeeso, amma ka nanǝn kwakhmarha mbangwa nadghǝn wa, ƙǝsǝr ka hangnda fiya. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Nanǝn kee, ɗadghǝnni mbeeɗǝ ɗǝgha tǝraa ura ɗǝfrha sǝ na manggǝn ka a naghǝnǝn tsaunǝn na Yeeso a mbǝraɗǝ tǝ kwamanɗi.<verse eid="LUK 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5" />Sǝlna Yeeso mbǝɗaɗǝ, ƙǝlagha ura ɗǝfǝdɗasǝ ndanggǝn, “Dzakka, turu hai ƙǝkar. Ƙǝsǝr rong wa ni nggi a weeriya.” <verse eid="LUK 19:5" /><verse number="6" style="v" sid="LUK 19:6" />Tǝrgha hai ƙǝƙar thlǝghǝnǝn fa tǝ wutsǝfayirha.<verse eid="LUK 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7" />Nana fiya ǝnɗiya, katǝrang ngganda huhurumnda hai, tǝ ndaarha, “Kǝlama hai, tsauɗǝ rong tǝ ‘ɗimirha.’ ”<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />Amma Dzakka thliigha sǝ ndanggǝn Chinǝm, “Kuloɓa, Paɓa! A mbǝɗiya nanǝnya, niya fǝrang mberra ˈya nani tǝghǝn ha a fa yamiya, a ˈwaɗi huk niifa, niya tenggǝn katǝra faɗa aten ǝnɗi thlǝni a harghǝn.”<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />Ndangga Yeeso, “A weeriya hǝrǝkrha kyaɗǝ minɗǝɗa hai ya, ƙǝsǝr niifɗiya ƙǝm chichid Ibrahim ni. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />Ƙǝsǝr Wan Niifa ɓanǝn ɓa ka ɓagha kaɗa ˈya sahadgha, ka a hǝrghanggǝn.”<verse eid="LUK 19:10" /></para>
  <para style="s">Karapu aten kutǝra tǝ mafayighǝn kum</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Na fiya aten ka thlǝmarha hai, ɗǝgha mbeeɗǝ tǝ thlǝghang karapu kanda sǝ, ƙǝsǝr ndusangɗǝ Urshelima fa. Tǝ ƙǝm fiya numanda tǝ ndaarha kutǝryid Faara nǝn a ɓarhaɓa a sǝl nda Urshelima ɗǝ. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />Ndǝghǝn, “ˈWad kogna naarha sǝ wiigha hu chehweed nafiya ɗǝ inggun a ɗaa nda faɗang kutǝra, wudgha ɓa. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Kapa nǝn wiirha, aah mafayighǝn nǝn ɓa kum, fǝrang wuɗǝɓǝla nǝn kanda hangga<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="ft" closed="false">Na Nggirkaya aaghǝn “mina.”</char></note> Wuɗǝɓǝl taara yi ndǝre mahan. Ndanggǝn kanda, ‘Ənama shafili sǝ kapa ni wutta ɓa.’”<verse eid="LUK 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14" />Amma nafiyaghǝn tsandan. Nanǝn kee, thlǝn fiya nda a samadghǝn tǝ ndaarha, “Mbǝ minnan sǝ kamshiɗiya tsauka kutǝr nan wa.”<verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />“Ko nanǝn kee, faɗang kutǝryidɗa nda, wudgha wureɓa. Ka kyadghǝn wure hai, thlǝn farha nǝn a ang mafayighǝn nda ɓa na heu fǝrang nǝn wuɗǝɓǝla kanda, ƙǝsǝr a sǝn ˈyanǝn tǝ kurmi wal nanda chikrha atenggǝn. <verse eid="LUK 19:15" /><verse number="16" style="v" sid="LUK 19:16" />Yi tal ɓagha ɓa ndanggǝn, ‘Alvari, ǝnaɗi taara tǝ wuɗǝɓǝlwa walɗi chikrha katǝra kum.’” <verse eid="LUK 19:16" /><verse number="17" style="v" sid="LUK 19:17" />Ndangga turighǝn, “‘ˈYauwa ka mafanna! Ƙǝsǝr ka ƙǝkafekkid wa ǝnana ahu ˈya na ngguchit, tsawu kutǝra aten tala kum.’”<verse eid="LUK 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18" />“Yi sǝri ɓagha ɓa ndanggǝn, ‘Alvari, walɗi chikrha katǝra tuf.’”<verse eid="LUK 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19" />Nggǝmangga turighǝn, “Sa, tsawu kutǝra aten tala tuf.”<verse eid="LUK 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20" />“Tǝrgha ɓagha tahad mafarha ɓa, ndǝghǝn, ‘Alvari, kulo wuɗǝɓǝl wa ya; ƙǝnangɗi hu kukwasharra hai ɓiɓengɗi. <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />Tǝrǝmɗi sa, ƙǝsǝr na ngyangthlang. Midwa ǝnka kaan, tǝ ƙǝm na hath ˈya hǝfwa nana.’”<verse eid="LUK 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22" />“Ndangga turighǝn, ‘Niya nggo kumarha sǝ aten ˈya thlǝkna tǝ miwa, ka wuɗi mafarha! Kyanna sǝnda sǝ, niyi ngyangthlang, minna ǝnka, tǝ ƙǝm, ni hath ˈya hǝfwa ni? <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />Mani fǝrangwana ndǝn fa shafiliya a wuɗɗi ɓa tǝni ɓa thlǝghǝn tǝ chikrha?’”<verse eid="LUK 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24" />“Tǝrgha ndanggǝn fingya na ƙǝƙǝt a mbǝɗi, ‘thlama wuɗǝɓǝlɗi na a harghǝn fǝranggunun tǝ kum ɗǝ.’”<verse eid="LUK 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25" />“Ndang ngganda, ‘Alvari, ai na kumsǝ a harghǝn!’”<verse eid="LUK 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26" />“Nggǝmanggǝn kanda, ndǝghǝn, ‘Niya pǝranggǝn kun kala niifa na tǝ ˈyaha, nanda chighanggǝn. Amma yanɗi mbuwa tǝ ˈyaha, ko yanɗi na ngguchit a harghǝn nanda thlang nda. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />Amma fa tsanggina mbuwana mindansǝ nggi a tsawi kutǝr ndan, ɓama tǝ kanda mbǝɗa ɓa ya, ɓǝlanggun kanda ɗǝ a mbenna.’”<verse eid="LUK 19:27" /></para>
  <para style="s">Yeeso kyaɗǝ Urshalima hai</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Ngwalana Yeeso thlǝk pathɗiya, ɗǝgha mbeeɗǝ tǝ wiirha a Urshelima ɗǝ. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Ndusang nǝn talya Mbetafadji fa tǝ Mbetani na aten wumnda nanda aarha Wumnda ɗǝfya Dzaitun, thlǝn fatsahayighǝn nǝn sǝri, ndagha, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />“Ɗama hu talɗa ɗǝ na ngguchit a mbennun ni, a kyaɗun sa hai, ɗunun wal wan kwara ƙǝƙǝna hai a mbǝɗi, ˈwawanda tǝraa. Kwasaman ɓa. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />A tsahang niifa mee kun ‘kama nda nun a kwasang hai?’ Ndaman Chinǝm ndagha na midghǝn sǝ.”<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />Fatsahayini sǝri thlǝnnanda, ɗǝnda ɗǝ ɗanda walghǝn ƙǝla thlǝghang nǝn kanda. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Na nanda a kwasang hai kee, nafiya wan kwarɗi, tsahang mee nda kanda, “Kama nda nun a kwasang wan kwarɗa hai?”<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />Ndang ngganda kanda, “Chinǝm ndagha na midghǝn sǝ.” <verse eid="LUK 19:34" /><verse number="35" style="v" sid="LUK 19:35" />Ɓang nggǝnda Yeeso ɓa, lǝlǝɓangganda lukkindan ƙǝsǝr kwarɗa sǝ, tǝrang ngganda Yeeso a ƙǝsǝrghǝn sǝ. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Ndǝghǝn aten wiirha, nagha fiya a lǝlǝɓang lukkindan hai aten kwamanɗi.<verse eid="LUK 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37" />Ɓanǝn ɓa tsau tǝ kwamanɗi na yiyirakh tǝ wumnda ɗǝfya Dzaitun fa. Tǝrgha fatsahayighǝn tǝ fiya na heu, tǝrang ngganda urandan sǝ na nda a fal Faara tǝ wutsǝfayirha aten ǝnwulteena hangga nana nda.<verse eid="LUK 19:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LUK 19:38" />Kanda a ndaarha, “Tǝ parkani kutǝrɗi ɓagha ɓa hu thlǝm Chinǝm!”</para>
  <para style="q2" vid="LUK 19:38">“Tsawud ɗǝɗemnggirha nagha a talara, tǝ manang nda thlǝm Faara ƙǝm!”<verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />Fingya Farisaya na ahur fiya ndang ngganda Yeeso, “Mala, ndang fatsahayiwa nggasanda hai!”<verse eid="LUK 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40" />Nggǝmanggǝn kanda ndǝghǝn, “Niya pǝranggǝn kun, ka nggasna nda hai, ferya tafandan na nda a fal nggi.”<verse eid="LUK 19:40" /></para>
  <para style="s">Yeeso tǝɗǝ ƙǝsǝr ka sǝsaarha na ɓayi ten Urshelima ɓa</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Ɓanǝn kaƙǝn Urshelima ɓa, nanǝn talɗi, tanggǝn teena. <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />Ndǝghǝn, “Andam kwang a weeriya, sǝnɗun ˈya na ɓang tsawud ɗǝɗemnggirha kun ɓa! Amma kulo mbiya ɓǝɓeng nda ma yinnun. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Na fara ɓayi na fa tsangginun a tǝrang hur shee kun teena muwangganda kun a maɗufu hai ˈyaɓang mbǝya nda kun fa. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />Nanda a ɗǝghang kun hweeɗe hai, kun tǝ wangginun na ahur talnun. Mbǝ ˈyasǝ nanda a tahang wa, ƙǝsǝr sǝnggun farɗi ɓana Faara thlǝmannun ɓa wa.”<verse eid="LUK 19:44" /></para>
  <para style="s">Rǝghang Yeeso fa shafiliya ɗǝ a Ƙǝn Faara na manggǝn</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Tǝrgha Yeeso kyagha a pǝpal Ƙǝn Faara ɗǝ na manggǝn, katǝranggǝn rǝghang fiya ɗǝ na a heng ǝngyaɗǝ a mbǝɗi. <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />Ndanggǝn kanda, “Nǝghǝn chichirethlee hai tǝ ndaarha, ‘Kǝnna nǝn tsaurha ƙǝn hwandǝna,’ amma tsawanggun mbǝd ɓǝɓed ngaarya.”<note caller="+" style="f"><char style="fr" closed="false">19:46 </char><char style="ft" closed="false">Ishaya 56:7; Irmiya 7:11</char></note> <verse eid="LUK 19:46" /><verse number="47" style="v" sid="LUK 19:47" />Ka fat paara fa, nǝn tsaharhaha a pǝpal ƙǝn Faarɗi na manggǝn. Amma mamnda Firistaya, fasǝngya ngyakhrha tǝ fingya mamngya na ahur fiya, nanda a kaɗa kwaman ɓǝllǝghǝn. <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />Ko nanǝn kee, walwanda kwamanggǝn wa, na nda a tǝrǝm fiya na a kang thlǝmarha fa, ƙǝsǝr laɓarghǝn kyaɗǝ huten ndan hai.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">Mamngya Yahudaya tsahang nda mee Yeeso</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Farɗa sǝ Yeeso a tsaharhaha a pǝpal Ƙǝn Faara tǝ thlǝk laɓar Faara na mbǝnggǝn a fiya. Tǝrgha mamnda firistaya tǝ fa sǝngya ngyakhrha, tǝ fingya shingya, wuma nda thlǝmadghǝn ɓa. <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />Ndang ngganda, “Pǝranggǝn kan tǝ yanggi ngyahadyi na a ǝna ǝngginiya. Wunni furogha ngyahadɗiya?”<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3" />Nggǝmangga Yeeso kanda, ndǝghǝn, “Nggima na Tsakhmee sǝ a miina. Pǝremadghǝn, <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />mbaptisǝma ǝnana Yahaya, Faara fǝrangga ngyakhrha wa, nduwa fiya wa?”<verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />Tǝrgha tsǝ laɓara nda atenggǝn, ndaa nda, “A ndaa ɗǝm, ‘Faara fǝrangga,’ nǝn a tsakh mee, ‘Kama fǝrwa nun ƙǝkafek tǝghǝn?’ <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />Amma a ndaa ɗǝm, ‘Fiya fǝrangga,’ fiya na heu nanda a mukƙǝm tǝ ferya, ƙǝsǝr fiya na heu nggǝmndafa tǝ ndaarha, Yahaya annabi ni.” <verse eid="LUK 20:6" /><verse number="7" style="v" sid="LUK 20:7" />Tsaunǝn kee, ndang ngganda, “Sǝngwan mbǝɗi ɓanǝn sa ɓa wa.”<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />Ndangga Yeeso kanda, “Nggi ƙǝm mbi pǝranggǝn kun tǝ yanggi ngyahadyi niya ǝna ǝngginiya wa.”<verse eid="LUK 20:8" /></para>
  <para style="s">Karapu aten nafiya huɗagha hu hed niifa</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Ɗǝgha Yeeso mbeeɗǝ tǝ thlǝghang karapu ɗi kanda sǝ ya, ndǝghǝn, “Na niifa sǝ pagha ɗǝfya inabi, dzǝmanggǝnǝn fahuɗaya ha, wiigha hu chehwedɗǝ pak mǝngga ha. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Tsǝna shifirha hai thlǝn mafadghǝn nǝn thlǝmad nafina ɗǝ nzǝmngga hedɗi a ǝnang ǝn hedɗa nda ha. Tǝrgha nafini nzǝmngga hedɗi ɗǝghangganda mafadɗa ɗǝ wuɗangganda ko ˈya a harghǝn. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Nggǝrghǝn thlǝn mafarha ɗǝ, ɗǝkƙǝn nda ƙǝtǝlangganda wuɗangganda kula ˈya a harghǝn. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />Nggǝrghǝn thlǝndaɗǝ yi mahan, ǝnang wundǝrha nda fa muwangganda ƙǝsha ɗǝ.<verse eid="LUK 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13" />“Tǝrgha tǝ hedɗi ndǝghǝn, ‘Mani ǝnaarha? Niya thlǝnang waana ɗǝ nggǝmni kaan; asǝmha nanda fǝrang mamnggirha.’<verse eid="LUK 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14" />“Amma nana nafini nzǝmngga hedɗi wanɗi, tsǝ laɓara nda atenggǝn. Ndaa nda, ‘Yauwaa! Kulo tǝ har langad hedɗiya, nggushi ɓǝlang nǝm, tǝna hedɗi tsaurha yinǝm!’ <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Tǝrgha kyangganda sǝ ma hedɗi, ɓǝlangganda.</para>
  <para style="p" vid="LUK 20:15">“Mana tǝ hedɗi ǝnang nda kanda? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />Nǝn a ɓarha ɓa ɓǝlanggǝn nafina ɗǝ nzǝmngga hedɗi fǝranggǝnǝn nafiya pak.” Sǝkna fiya ndǝn kee, ndaa nda, “A kaptangga Faara ɗǝ.”<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />Kǝlangga Yeeso kanda hu yidsǝ ndǝghǝn, “Laɓarɗi chireethleng nanda hai manǝn a ndaarha,</para>
  <para style="q1" vid="LUK 20:17">“‘ferɗi karna fa tǝngya,</para>
  <para style="q2" vid="LUK 20:17">ndǝghǝnni tsauka fer sar ƙǝnna’ ”?<verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />“Kala niifa mukka ten ferɗa hai, nǝn hwasarha fa, amma yi mukna ferɗi tenggǝn hai nǝn a tsarang ɗǝ.”<verse eid="LUK 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Fasǝngya ngyakhrha tǝ mamnda firistaya kaɗa kwaman ƙǝssa Yeeso nda a mbǝɗi, ƙǝsǝr sǝndasǝ karapuɗi thlǝknǝn ya a tendanni. Amma kanda ƙǝm a tǝrǝm fiya.<verse eid="LUK 20:19" /></para>
  <para style="s">Tsakh mee aten tii tsamnda a Kaisar</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20" />Nanda a lafghǝn, thlǝn fa harmuya nda ɗǝ, a tsawa nda ƙǝla ka nafiya na tǝ ƙǝkafek fa. Na mindansǝ a ƙǝsangganda Yeeso tǝ ɗimiyirha tǝna nda ɗanggǝn ngwamna ɗǝ na tǝ sǝsǝmnda ha. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Fa harmuyini thlǝn nanda tsahang mee nda Yeeso tǝ ndaarha, “Mala, sǝnɗansǝ pathwa tǝ tsahadwaha nǝghǝn mǝmǝl, sa ƙǝm mba wurahasǝ wa, amma na tsahang kwaman Faara fiya ha tǝ ƙǝkafekkirha. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />Nǝghǝn mǝmǝl a fannan ateng tsamnda nan Kaisar wa, nduwa awo?”<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />Kǝlagha Yeeso hai na mindan ɗǝfang takthleera, ndanggǝn kanda, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />“Kyaɗeema pene ɗi ki Romayini. Shishingnda wunni tǝ thlǝm wunni atenggǝn?” <verse eid="LUK 20:24" /><verse number="25" style="v" sid="LUK 20:25" />Nggǝmangganda, “Yi Kaisar ni.” Ndanggǝn kanda, “Fǝraman Kaisar ˈya tsauka yi Kaisar, tǝ ƙǝm fǝraman Faara ˈya tsauka yi Faara.”<verse eid="LUK 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26" />A mbǝɗi ƙǝm mbangwanda ƙǝsang tǝ ˈya thlǝknǝn a mbed fiya wa. Na ǝnwulteena nda tǝ tur nggǝmndǝɗi nggǝmang nǝn kanda pa, nggasa nda hai.<verse eid="LUK 20:26" /></para>
  <para style="s">Tsakhmee aten thliirha sǝ ahu merra tǝ kakhrha</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />Fingya Sadukiyaya, ndagha mbǝ thliirha sǝ hu mǝra wa, ɓa nda thlǝmad Yeeso ɓa tǝ tsakh mee. <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />Ndang ngganda, “Mala, Musa chireethleng ɗa ndǝn kan hai tǝ ndaarha, ‘A mǝr wanman niifa malɗǝ nukkun hai kula nggǝtta, na wanman tǝrangsǝ hu langaarha ka a nggǝɗanggǝn mǝrra wanman sǝ.’ <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Nanǝn ya, na nafiya sǝ mǝd a wanmanggi. Tǝ pamǝnda kakhka mǝrgha kula wal wee. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />Yi sǝri tǝranggǝn nuɗasǝ mǝrgha kula wal wee. <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />Yi mahan wai kee. Kanda na heu mǝd tǝrang nda nuɗasǝ mǝra nda kula nuɗi nggǝɗang kanda sǝ. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Akwasamadghǝn, nuɗi ƙǝm mǝrgha. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Nanǝnya, ahu thliirha sǝ hu mǝrra na nuɗi tsaurha yi wun tsaunǝn kanda heu mǝd, tǝrang nda nuɗasǝ?”<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />Ndangga Yeeso kanda, “A hu ƙǝshiidɗi ya hǝshya a kakhrha, kanda a fǝr nishya a chimadɗǝ. <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />Amma nafiya kamngga a thlii nda sǝ hu mǝra tǝ ƙǝm tsawanda ahu ƙǝshiirha na ɓayi, hǝshya mba nda kakhrha wa, mba nda fǝr nishya a chimadɗǝ wa. <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />Kanda ƙǝm mba nda nggǝr mǝra wa, ƙǝsǝr na nda ƙǝla fathlǝngya Faara. Tsau nda wangya Faara ƙǝsǝr thliinda sǝ hu mǝra. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />Amma aten laɓar ɗǝfǝdɗi na ngguchit ƙǝsgha waarha, ko Musa ma kyadɗa ndǝn a pǝpal tǝ ndaarha, na thliirha sǝ ahu mǝra, ƙǝsǝr aaghǝn Chinǝm, ‘Faara yi Ibrahim, Faara yi Ishaku tǝ ƙǝm Faara yi Yakubu.’ <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />Mbǝ Faara ni yi mǝrya wa, amma yi fa yibya ni, ahu yighǝn kanda heu nanda tǝ yibrha.” <verse eid="LUK 20:38" /><verse number="39" style="v" sid="LUK 20:39" />Fingya fasǝngya ngyakhrha ndang ngganda, “Mala, thlǝkna pathla ngga!” <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />A mbǝɗi, mbǝ niifasǝ nggǝrgha tsahang mee ɓalwa.<verse eid="LUK 20:40" /></para>
  <para style="s">Tsakh Yeeso mee aten Ƙǝrǝsti</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Tǝrgha Yeeso ndanggǝn kanda, “Kǝn nanda ndaarha Ƙǝrǝsti Wan Ndauda ni? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />Ndauda tǝ atenggǝn ndǝghǝn ahu Dzabura,</para>
  <para style="q1" vid="LUK 20:42">“‘Chinǝm Faara ndanggǝn China,</para>
  <para style="q2" vid="LUK 20:42">“Tsawu a yisǝmanna<verse eid="LUK 20:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 20:43" />ƙǝl ma tsawangɗi fa tsanggiwa</para>
  <para style="q2" vid="LUK 20:43">a kamu saryiwa.” ’”<note caller="+" style="f"><char style="fr" closed="false">20:43 </char><char style="ft" closed="false">Dzabura 110:1</char></note><verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />“Aagha Ndauda nden, ‘Chinǝm.’ Ƙǝƙǝn ƙǝm na nda ndaarha Wan Ndauda ni?” <verse eid="LUK 20:44" /><verse number="45" style="v" sid="LUK 20:45" />Ndanggǝn fatsahayighǝn a mbed fiya, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />“Kwarama tǝ Fasǝngya ngyakhrha. Kanda na mindansǝ kal kaɓaya fa a nanda a wiirha hai a yid fiya. Na mindansǝ a ndangga fiya ˈya kanda ahu kasu. Na mindansǝ ƙǝm a fǝrang mbǝd tsaukya nda kanda na nggǝngga ahu ƙǝngya hwan Faara tǝ mbǝya wutsǝfayirha. <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />Kanda ni na hǝb langad nishya mǝrna chimayindan, na nda djib hwan Faara tǝna fiya ndaarha ka nafiya ni kanda. Tur nafiniya na Faara sǝsang kanda kaan ma fingya.”<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">Fǝrra nuneefa mǝrna chimadghǝn</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Tǝrangna Yeeso tenggǝnsǝ, na fa ƙǝnaya nǝn ɓanda ɓa tǝ fǝryindan kanda a irangnda ahu panjakwad Ƙǝn Faara hai na manggǝn. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />Na nuneefa nǝn mǝrna chimadghǝn ƙǝm tǝ yamirha fǝr yighǝn nǝn anini sǝri. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Ndagha Yeeso, “Kǝkafek niya pǝranggǝn kun, fǝrrǝɗi ki nuɗi tǝ yamidɗiya kalɗǝ yi fingya na heu. <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />Nafini na heu ya fǝrghanda ahu hangnda ˈya na nanda tǝghǝn ha, amma ndǝghǝn nggi ahu yamidghǝn fǝrɗǝ ˈya na a harghǝn heu.”<verse eid="LUK 21:4" /></para>
  <para style="s">Tsahad Yeeso ha aten ˈya na a katǝrarha hai a mbee</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Tǝrgha fingya fatsahayighǝn katǝrang ngganda tsǝ laɓara hai aten tǝn ƙǝn hwan Faarɗi na manggǝn tǝ ferya na nggǝngga, sakhɗang nanda sǝ tǝ ǝn fǝrya a Faara. Amma ndagha Yeeso, <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />“Kǝla nanun feryini ya, yoo! Na farghǝn ɓayi mbuwanda malang feera aten shadghǝn. Ko yanggini ahur ndan nanda a changgǝlang kanda hai.”<verse eid="LUK 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />Tsakh mee nda, “Mala, akwan na ǝnggini a katǝrarha hai ya? Tǝ ƙǝm mani ǝn sakhrha na a sǝnansǝ nduwus ɓenɗaɓa ya?” <verse eid="LUK 21:7" /><verse number="8" style="v" sid="LUK 21:8" />Ndǝghǝn, “Kwarama kanda, amana nda sakhɗang kun. Ƙǝsǝr fiya hangga na a ɓarhaɓa ahu thlǝmna na nda a ndaarha, ‘Nggini Ƙǝrǝsti,’ tǝ ndaarha ƙǝm ‘nduwus ɓenɗaɓa.’ Ma mbuɗun samandan wa. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />A tǝrǝmɗun wa, a sǝkɗun laɓar yangya tǝ kakyathlanga. Kǝkafekni a katǝragha ǝnggina hai ya ˈwan, amma mii ngwaladghǝn ɓalghǝn kula ɓarha ɓa.” <verse eid="LUK 21:9" /><verse number="10" style="v" sid="LUK 21:10" />Tǝrgha ndanggǝn kanda, “Tur nǝn thleng tur fa, kutǝryirha ƙǝm nǝn thleng kutǝryirha fa. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />Na ƙǝshiirha a rǝbrha fa kaan, tǝ mirha, tǝ patal a mbǝya ɗǝɗamǝn. Na ǝntǝrǝmgya a naarha sǝ tǝ ƙǝm nun na ǝnsakrha yi wulteena hangga a fǝrakh amshi.<verse eid="LUK 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12" />“Amma kapa na ǝnggini katǝrarha hai ya, nanda a ƙǝsang kun, sǝsangganda kun. Nanda a ɗǝrha tǝ kun ahu ƙǝngya hwan Faara ɗǝ, tǝ ƙǝm muwangganda kun ahu porsǝna ɗǝ. Nanda a ɗǝrha tǝ kun a mbed kutǝrya ɗǝ tǝ ngwamnaya ka thlǝmna. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />Ənɗaniya na fǝrang kwamana kun pǝr ƙǝkafek nun atenna. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />Amma tsaunǝn kee, ˈwama teena nggon fa ahur nun ma ɓillaɗun tǝ kwaman thlang fannun sǝ a mbed fa ngwa kumaya wa. <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />Ƙǝsǝr niya fǝrang pathla kun tǝ sǝnda, ko tal ahur fa tsangginun mba nda mbang kyakhrang laɓarnun hai, nduwa ngaalangganda kun wa. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Ko fa nggǝt yinun, tǝ wanmangginun, tǝ hurfayinun, tǝ pashiyi nun na nda a fǝr kun. Na nda a ɓǝlang nda fingya ƙǝm ahur nun. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Fiya na heu nanda a karkun ƙǝsǝr ka nggi. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Amma ko tal ahu was tennun mbusǝ na a sahatta wa. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />A ƙǝrǝsɗun, nun a hǝrǝkrha.”<verse eid="LUK 21:19" /></para>
  <para style="s">Pǝr Yeeso kwamanɗi na Urshelima a fǝla hai</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />“Anaɗun sodjaya tǝrang nda hurshe Urshelima teena, a sǝnunsǝ takh nda a chang hai. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />Tǝrgha fingya na ahu Yahudiya, ɗaa nda wumngya sǝ. Fingya ƙǝm na a wupǝri kya nda sǝ, fingya ƙǝm, na hu talya a ɗǝnda wupǝri ɗǝ wa. <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />Ƙǝsǝr sayidɗiya ɓen sǝsaarha ni, tǝ lǝghǝtta ǝngya heu chireethleng nanda hai.<note caller="*" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="HOS 9:7">Hodzaya9:7</ref></char></note> <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Kawama nishya na ahur, tǝ fingya na wanggindan a iirha! A farɗiya, na sǝsaarha a kyarha hu chehwedɗa hai tǝ sǝbrha hur Faara aten nafini ya. <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />Nanda a ɓǝlang fingya tǝ thlaukh ƙǝlara, ƙǝsangganda fingya tsawa nda porsǝngya hu chehweeya ɗǝ pak. Fingya mbuwa Yahudaya, nanda thlǝ Urshelima sǝssangganda ƙǝl ma lǝghǝd ɓen ndan.<verse eid="LUK 21:24" /></para>
  <para style="s">Wutta Wan Niifa ɓa</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />“Nun a na ǝn tǝrǝmngya a fad yanfaara, ndǝre tǝ wufǝlngarya. A hu ƙǝshiirha ƙǝm, na fiya a peela hai ka hǝreenga ƙǝsǝr ka hufrha tǝ yanda wuri aama. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />Nǝn a shiwid fiya teena ka tǝrǝmnda, na ƙǝfayindan a haara ka ǝngya na a ɓarha hu ƙǝshiirha ɓa, ƙǝsǝr ǝngya na mǝmanggǝn a fǝrakh amshi nanda a tsǝ ˈya fa. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />A farɗi, nanda a na Wan Niifa ɓayi ahu hashmbe tǝ sǝsǝmnda tǝ mamnggirha kaan. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Ana ǝnggini a katǝrarha hai ya, thlema sǝ tǝranggun tennun talara sǝ, ƙǝsǝr far hǝrǝƙrǝnun nduwusɗa ɓa.”<verse eid="LUK 21:28" /></para>
  <para style="s">Tsaharhaha aten ɗǝf shiɓarha</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Thlǝghang karapu ɗa nǝn kanda sǝ ya, “Kǝlaman shiɓarha tǝ ɗǝfya na heu. <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />A hǝrǝmna nda katǝrang tsǝtsǝtta hai, kun tǝ altennun sǝnɗunsǝ nduwus fegrha ɓa. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Nǝghǝn kee ƙǝm, anaɗun ǝnggini a katǝrarha hai ya, sǝnɗunsǝ Kutǝryid Faara nduwus ɗa ɓa.<verse eid="LUK 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32" />“Niya pǝrang ƙǝkafek kun, nafiya ƙǝshiid weeriya mba nda a mǝra wa, ƙǝl katǝrana ǝnggina hai ya ˈwan. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Nda talara tǝ hweeɗe nanda a ngwalarha, amma laɓarna mbǝ tam ngwalarha wa.<verse eid="LUK 21:33" /></para>
  <para style="s">Yiyi thlǝmarha aten tsaurha nggu-ngwa fa</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />“Kwarama, amana hur nun mǝra tǝ mbǝna farha fa, tǝ sa ǝngya na tǝrang kun in, tǝ ɓillad tsawud ƙǝshiirha. A mbǝ kewa, ɓana farɗi wal kun kula sǝndǝnun sǝ ƙǝla takthleera. <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />Ƙǝsǝr nǝn ɓarha ten fiya ɓa heu na a tsaurhahu ƙǝshiirha. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Tsawama nggu-ngwa fa, ƙǝtsar. Hwan Faara nun tǝ nun wal hǝrǝkrha aten ǝnggini na ɓa katǝrarha hai, amana shilee ɓa ƙǝsang kun isha a mbed Wan Niifa.”<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />Ka fad par fara fa, na Yeeso tsaharhaha hu Wuri Faara. Ka fad figrha fa ƙǝm nǝn kyarha sǝ, ɗǝgha mǝnda a wumnda nanda aarha Wumnda ɗǝfya Dzaitun. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />A tsar ƙǝrǝt, na fiya ɗǝrha hu Ƙǝn Faara ɗǝ na manggǝn ka a sǝk laɓarghǝn nda.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">Yahuda nggǝmnɗafa a fǝr Yeeso nǝn</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />Nanǝnya, far Wutsǝfayirha yi Mburodi kula Mekhna, nanda aarha Tǝɗaarha a nduwussa ɓa. <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />Mamnda Firistaya tǝ famalǝmngya ngyakhrha nanda a kaɗa kwaman ɓǝlang nda Yeeso ɓǝɓee, ƙǝsǝr nanda a tǝrǝm fiya. <verse eid="LUK 22:2" /><verse number="3" style="v" sid="LUK 22:3" />Tǝrgha sheetan kyagha ahur Yahuda hai, nanda aarha Iskaryoti, tal ahur kumkap sǝri ɗi. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Yahuda ɗǝgha thlǝmad mamnda firistaya ɗǝ tǝ mamngya na a ƙǝla Ƙǝn Faara ha na manggǝn, ndiya nda aten kwamana nǝn a fǝr Yeeso a kanda. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Tǝk mbǝnda nda fa kaan, nggǝma nda fa a fǝrang wuɗǝɓǝla nda. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />Yahuda ƙǝm nggǝmɗafa kee, ƙǝla sayidɗa nǝn fa mbuwana fiyasǝ a fǝr Yeeso nǝn a kanda.<verse eid="LUK 22:6" /></para>
  <para style="s">Hǝb Yeeso ǝnnarhami yi Tǝɗaarha tǝ fatsahayighǝn</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Tǝrgha nduwusna far Wutsǝfayidɗa ɓa yi Mburodi kula Mekhna. Far ɗa na nda na sataka tǝ wan kamnda yi Tǝɗaarha. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Thlǝngga Yeeso Mbiturus tǝ Yahaya ndanggǝn kanda, “Ɗamaɗǝ ɗun ngwang nda ƙǝmfa ɗǝm hǝb ǝnnadmid ter wutsǝfayid Tǝɗaarha.”<verse eid="LUK 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9" />Tsahang mee nda ha, “A yanggi na midwa sǝ ɗan ngwadɗa fa?”<verse eid="LUK 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10" />Ndanggǝn kanda, “A kyaɗun hur talɗa hai, ɓana niifa wal kun tǝ tsulina ha. Mbuwama samadghǝn ta minɗǝɗa ɗǝ nǝn a kyarha sa hai.” <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />Ndanggun tǝ wuriɗi, “Tǝmalǝmnda ni tsakhka mee, ‘Na ƙǝn rongya a yanggi, niya hǝb ǝnnadmid Tǝɗaarha sǝ, tǝ fatsahayina?’ <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />Nǝn a kyaɗang ƙǝnna kun na manggǝn, na tǝ mbǝd tsaukya sǝ hangga. Ngwama fa a mbǝɗi.”<verse eid="LUK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13" />Wii nda ɗanda walghǝn mǝmǝl ƙǝla pǝrangna Yeeso kanda. Ngwandafa a mbǝɗi tǝ ǝnnarhami yi wutsǝfayid Tǝɗaarha.<verse eid="LUK 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Tsǝna sayidɗa hai, Yeeso tǝ wan thlǝnggighǝn tsawa nda hai ka a hǝb ǝnnarhami nda. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />Ndanggǝn kanda, “Nǝghǝn a kukwase fa na a hǝb ǝnnadmid Tǝɗaarha ni tǝ kun kapa ni sǝsaarha. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />Niya pǝranggǝn kun, mbiya nggǝr hǝbghǝn ɓalwa, ƙǝl ma ɓad lǝghǝttǝghǝn ɓa ahu kutǝryid Faara.”<verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />Akwasamadghǝn tǝranggǝn wuhuleu aam inabi sǝ, usa Faara nǝn, ndanggǝn kanda, “Thlama, ndǝghaman hai. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />Niya pǝranggǝn kun, mbiya nggǝr sa aam inabi ɓalwa, ƙǝl ma ɓad kutǝryid Faara ɓa.”<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />Tǝranggǝn mburodi sǝ, usa Faara nǝn, kyanggǝn hai, fǝranggǝnǝn kanda, ndagha, “Thlu fanna niya fǝr nda ka kun. Nama kee non a ɗal nggi in.”<verse eid="LUK 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 22:20" />Nǝghǝn kee ƙǝm, akwasamad ǝnnadɗami, tǝranggǝn wuhuleuɗa sǝ, ndagha, “Wuhuleuɗiya, yi weerǝnda ƙǝn pathnani ahu farna, irgha ɗǝ ka kun. <verse eid="LUK 22:20" /><verse number="21" style="v" sid="LUK 22:21" />Amma niifɗi na a fǝr nggi kan nan a mbǝrha tal a hǝbrha. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />Wan Niifa nǝn a mǝra ƙǝla tǝ ndana nda, amma ǝn kawa ni a niifɗi tǝ fǝrgha ndǝn.” <verse eid="LUK 22:22" /><verse number="23" style="v" sid="LUK 22:23" />Katǝrang ngganda tsahang mee ndan ha tǝ wunni ahur ndan na mbang ǝna tur ǝnɗiya.<verse eid="LUK 22:23" /></para>
  <para style="s">Fatsahaya Yeeso ngalnda aten wunni manggǝn</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Thliigha ngaala sǝ ƙǝm a pathlang ndan tǝ wunni ahur ndan na a tsaurha manggǝn. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Ndangga Yeeso kanda, “Kutǝrya fingya sǝngwa Faara tǝ mamngya, nanda kyaɗang ngyakhrha fiya, tǝ ƙǝm nanda tǝr fandan fa ɗangya fiyasǝ. <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />Amma a tsauɗun kee wa. Ameyedghǝn, yanɗi na manggǝn ahur nun tsauka ƙǝla ndǝghǝn ni ngguchit, tǝ kal mbeerha ƙǝm tsauka ƙǝla mafarha. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />Yanggini manggǝn, yanɗi tsauka hai na a hǝbrha wa, nduwa yanɗi fǝrgha ǝnnarhami ɗǝ wa? Mbǝ yanɗa ni tsauka hai na a hǝbrha wa? Amma niyi a pathlang nun ƙǝla mafarha. <verse eid="LUK 22:27" /><verse number="28" style="v" sid="LUK 22:28" />Kunni ishgha tǝ nggi ahu ƙǝƙǝrra sanifa. <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />Fǝrang ɗi kutǝryirha kun, ƙǝla yanɗi fǝrena Pǝpa. <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />Tsaunǝn kee, nun a hǝbrha tǝ sarha a thlǝmanna hu kutǝryidna tǝ ƙǝm nun a tsaurha aten tsǝnggamngya, ngwang kumarha nun turya kumkap sǝri yi Isǝreela.”<verse eid="LUK 22:30" /></para>
  <para style="s">Mbiturus nǝn a ngaal sǝnda Yeeso</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />“Mbiturus, Mbiturus! Hwan sheetan kwamana na a ƙǝƙǝranggǝn kun na heu ƙǝla na tǝ huɗarha pǝr wan hwalirha. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />Amma hwanoɗi Faara teena Mbiturus, amana fǝrƙǝkafekkid wa ƙǝɗiirha. A kyaharna ɓa, kalang wanman nggiwa sǝ ƙǝm.”<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />Amma nggǝmangga Mbiturus ndǝghǝn, “Paɓa, niyi nggungwa fa a ɗǝm hu porsǝna ɗǝ kyab, ana ǝn mǝrra ni, mǝrǝm kyab!”<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />Ndangga Yeeso, “Niya Puroƙǝn Mbiturus, kapa na ɗiyarha tǝtaarha a fǝɗikɗiya na ngal sǝnɗǝna katǝra mahan.”<verse eid="LUK 22:34" /></para>
  <para style="s">Ngwaman fannun fa ka sǝsaarha na ɓayi</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />Tǝrgha Yeeso tsahang mee nǝn fatsahayighǝn, “Thlǝnni kun kula wuɗǝɓǝla, kula ǝnnarhami, kula pakhma, ƙǝɗeng ɗun ˈya wa?”</para>
  <para style="p" vid="LUK 22:35">Ndanda, “Awo!”<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />Ndanggǝn kanda, “Amma nanǝnya ana wuɗǝɓǝla sǝ a har nun ƙǝsamadghǝn ha, tǝ ƙǝm ǝnnarhami. A mbǝ thlaukh ƙǝlara sǝ a harwa wa, heng luwudwa ɗǝ hiina. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />Nǝghǝn chichireethlee hai tǝ ndaarha, ‘Wumangnda tǝ fa ɗimiya,’ niya pǝranggǝn kun tǝtani a lǝghǝdgha atenna. Ƙǝsǝr ǝnɗi chireethleng nanda hai atenna takhɗǝ a lǝghǝtta.”<note caller="*" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="ISA 53:12">Ishaya53:12</ref></char></note><verse eid="LUK 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38" />Ndangga fatsahayighǝn, “Paɓa kuloɓa! Thlaukh ƙǝlarya sǝri ya.”</para>
  <para style="p" vid="LUK 22:38">Ndangga Yeeso kanda, “Tsǝkɗǝ kee.”<verse eid="LUK 22:38" /></para>
  <para style="s">Hwan Yeeso Faara a Wumnda ɗǝfya Dzaitun</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Kyagha Yeeso sǝ ƙǝla nǝn tǝ ǝnaarha, tǝrgha hu Wumnda ɗǝfya Dzaitun sǝ tǝ fatsahayighǝn a samadghǝn. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Sǝlnǝn mbǝɗaɗǝ, ndanggǝn kanda, “Hwanama Faara amanun ɗǝ mukrha hu ƙǝƙǝrra hai.” <verse eid="LUK 22:40" /><verse number="41" style="v" sid="LUK 22:41" />Nduwusgha mbeeɗǝ ma kanda, ɓǝrgha hai hwan Faara nǝn. <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />Ndagha, “Pǝpa a nggǝmnafa tǝree sǝsaɗɗaɗiya, mbǝ nggǝmnda hurna wa, amma ˈya nggǝmna hurwa ndǝna mǝmǝl.” <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />Ɓagha tǝ thlǝnda Faara thlǝmadghǝn ɓa a talara hai fǝrang kanglanggirha nǝn. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Ndǝghǝn hu sǝsaarha kaan, ɗǝgha mbeeɗǝ tǝ hwan Faara tǝ ƙǝkafekkirha nagha thlǝthlǝndǝghǝn a tsǝtsaarha hweeɗe hai ƙǝla fara.<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />Thliinǝn sǝ ka hwan Faara, wudgha thlǝmad fatsahayighǝn ɗǝ ɗǝgha wal kanda a shiirha ka sǝbrha hura. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />Tsahang mee nǝn kanda, “Kama nun a shiirha? Thlemasǝ hwan Faara nun amawanun mukrha hu ƙǝƙǝrra hai,”<verse eid="LUK 22:46" /></para>
  <para style="s">Kǝssang nda Yeeso</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Ndǝghǝn aten thlǝk pathla ɓagha fiya ɓa hangga, tǝ niifɗi na nda aarha Yahuda. Nǝghǝn tal ahur kumkap sǝri ɗi, ndǝghǝnni a kal mbeerha. Ɗǝgha thlǝmad Yeeso ɗǝ ka a fǝɓanggǝn. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Tǝrgha Yeeso tsahang mee nǝn, “Yahuda ashe tǝ fǝbrha na a fǝr Wan Niifa?”<verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />Fatsahaya Yeeso ƙǝla na nda hai na ˈya sǝ na a katǝrarha hai tsahang mee nda Yeeso, “Paɓa, kyath kanda nan tǝ thlaukh ƙǝlaryi nan wa?” <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Tǝrgha tal ahur ndan kyathlanggǝn thlǝmad mafad firis ɗǝ na manggǝn a yi sǝma.<verse eid="LUK 22:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51" />Ndangga Yeeso fatsahayighǝn, “Malaman kanda!” Tsuwar thlǝmadɗa nǝn fa ki niifɗi kyathlang nanda ɗǝ ƙǝnanggǝn.<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />Tǝrgha ndangga Yeeso mamnda Firistaya, tǝ mamngya fa ƙǝla Kǝn Faara ha na manggǝn, tǝ fingya shingya ɓagha ɓa ka ndǝghǝn, “Tǝrwun nggi niyi tǝmbǝng nun ɓarha ɓa tǝ thlaukh ƙǝlarya, tǝ sǝsalya ka a ƙǝsewun wa? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />Ƙǝtsar nggi a thlǝman nun a pǝpal Wuri Faara ƙǝsewun wa, amma nanǝn ya sayid nun ni na Sheetan a ǝna taara tǝ kun.”<verse eid="LUK 22:53" /></para>
  <para style="s">Mbiturus ngalɗǝ sǝnda Yeeso</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Tǝrgha ƙǝsangganda Yeeso ɗǝnda tǝghǝn minda ki Firis ɗǝ na manggǝn. Mbiturus ƙǝm mbu samandan nǝn ɗǝ inggun ma kanda. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Amma dzǝk na nda waarha a pǝpal wuriɗi, tsawa nda hai kanda na heu a thlǝma wadɗi, ɓagha Mbiturus ɓa tsauka hai ahur ndan. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Tal ahur wangya nishya na ǝna taara ahur wuriɗi na Mbiturus nǝn tsau a thlǝma wadɗi. Irang yirha nǝn fa, ndǝghǝn, “Niifɗiya, kanda ni tǝ Yeeso.” <verse eid="LUK 22:56" /><verse number="57" style="v" sid="LUK 22:57" />Amma Mbiturus ngalghǝnǝn ndagha, “Sa nuɗiya, nggi fa sǝngwi ndǝn wa.”<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />Tsǝɓaku na niifasǝ nagha Mbiturus, ndagha, “Sa ƙǝm na tal ahur ndan.”</para>
  <para style="p" vid="LUK 22:58">Ndangga Mbiturus, “Sa pashi! Mbǝ nggi ni wa.”<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />Tsǝnǝn tsǝɓaku faɗǝn, nggǝrgha niifa ndaarha, “Mbǝ ngaala sǝ wa, niifɗiya kanda ni tǝghǝn, ƙǝsǝr tǝ Nggalilarha ni.”<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />Ndagha Mbiturus, “Sa pashi! Sǝngwi ǝnɗi na a thlǝkrha ya wa!” Ndǝghǝn kula nggǝlang mighǝn tǝtaagha ɗiyarha. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />Chinǝm kyahargha hai ƙǝlanggǝn Mbiturus ɗǝ. Tǝrgha Mbiturus ɗal teena nǝn hai tǝ ǝnɗi thlǝghang na Chinǝm, “Kapa na ɗiyarha tǝtaarha a fǝɗik weeriya na a ngal sǝnɗǝna katǝra mahan”. <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Tǝrgha Mbiturus ɗǝgha ƙǝshaaɗǝ tǝgha kaan.<verse eid="LUK 22:62" /></para>
  <para style="s">Fa ƙǝlaya ha wanda Yeeso</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Fa ƙǝlaya Yeeso ha katǝrang ngganda waghǝn hai na nda a ɗǝkƙǝn ƙǝm. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />Kǝnangganda yidghǝn ana nda a tsahang mee ha, “Kulo, wunni ɗǝkka sa.” <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Nanda a ˈyarghǝn tǝ laɓar sarfaya a ndǝghǝn.<verse eid="LUK 22:65" /></para>
  <para style="s">Yeeso a mbed mamngya Yahudaya</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Ɗathna mbǝrha hai wumngga mamngya Yahudaya ɓa. Kandani na mamngya firistaya, tǝ fasǝngya ngyakhrha. Ɓa nda tǝ Yeeso a mbed ndan ɓa. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />Ndang ngganda, “Ana sani Ƙǝrǝsti, pǝranggǝn kan.”</para>
  <para style="p" vid="LUK 22:67">Nggǝmangga Yeeso kanda, “A pǝrangɗi ndǝn kun, mbun a fǝrƙǝkafek wa, <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />tǝ ƙǝm a tsahangɗi mee kun ha mbun a nggǝresǝ wa. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Amma ka a weeriya, na Wan Niifa a tsaurha a yisǝmad Faara na tǝ ngyakhrha ha heu.”<verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />Kanda na heu tsahang mee nda ha, “Wan Faara ni sa wa?”</para>
  <para style="p" vid="LUK 22:70">Nggǝmanggǝn kanda, “Pǝrɗundǝn, nggini.”<verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />Tǝrgha ndaa nda, “Kama nǝm nggǝr kaɗa pathya atenggǝn? Sǝkɗǝm ndǝn hai a mighǝn.”<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">Ɗǝnda tǝ Yeeso a mbed Mbilatus ɗǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Tǝrgha mamngya Yahudayini heu thliinda tǝ Yeeso a mbed Mbilatus ɗǝ. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />Katǝrang ngganda ɗahang nda fa, “Ɗǝghan wal niifɗiya a tsang teena nafinǝm. Nagha a ndang nda kanda a teng nda tsamnda Kaisar wa, tǝ ƙǝm wai ndǝghǝnni Ƙǝrǝsti, kutǝra.”<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />Tsahangga Mbilatus mee Yeeso, “Sani na kutǝr Yahudaya wa?”</para>
  <para style="p" vid="LUK 23:3">Nggǝmangga Yeeso ndǝghǝn, “Nǝghǝn kee, ƙǝla thlǝkna.”<verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />Tǝrgha ndangga Mbilatus mamnda firistaya, tǝ fiya na heu a mbǝɗi, “Nggi nawi niifɗiya tǝ ɗimiyirha fa wa.”<verse eid="LUK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5" />Ɗǝnda mbeeɗǝ tǝ ɗahang fa tǝ ndaarha, “Tsahadghǝn ha nǝghǝn a tsang teena fiya a chehweed Yahudiya na heu. Katǝranggen hai a Nggalili har ta mbǝɗa ɓa ya.”<verse eid="LUK 23:5" /></para>
  <para style="s">Mbilatus thlǝnang ɗǝ Yeeso a mbed Hirdus ɗǝ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />Sǝkna Mbilatus ndǝn kee, Tsakhmee nǝn tǝ ndaarha, “Tǝ Nggalilarha ni wa?” <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Sǝknǝn ndaarha kyagha Yeeso ɓa a manɗi na Hirdus a ǝna kutǝryirha sǝ, thlǝnanggǝn Yeeso a thlǝmad Hirdus ɗǝ, ƙǝsǝr a farɗi nǝghǝn a Urshelima.<verse eid="LUK 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8" />Nana Hirdus Yeeso, tǝk mbǝnda nǝn fa kaan, ƙǝsǝr ka ƙǝtǝm na midghǝn sǝ a nang yirha nǝn fa. Aten ǝngya ˈwaa nǝn sǝkrha atenggǝn, na midghǝn sǝ a ǝna ǝnwulteena nǝn. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Hirdus tsahang miiya nǝn ha hangga, amma Yeeso kalwa sǝ wa. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Mamnda firistaya tǝ famalǝmngya ngyakhrha kanda a mbee ƙǝƙǝt a ɗahang pathya fa. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Tǝrgha Hirdus tǝ sodjayighǝn sarangganda ɗǝ tǝ ƙǝm waghǝnda. A mbǝɗi kalang kaɓarha nda fa yi kutǝryirha, wuɗangganda thlǝmad Mbilatus ɗǝ. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Hirdus tǝ Mbilatus afar ɗani tsaunanda pashiyi, ƙǝsǝr ka ƙǝtǝm mba nda kalang ndan sǝ wa.<verse eid="LUK 23:12" /></para>
  <para style="s">Ngwang nda kumarha Yeeso yi mǝra</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Mbilatus aah mamnda firistaya nǝn ɓa, tǝ mamngya tǝ fiya na hǝu. <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />Ndanggǝn kanda, “Ɓeenun niifɗa ɓa ya tǝ ndaarha nǝghǝn a tsang teena fiya. Nanǝnya, raɗi mu pathɗa haya tǝ tsakh miiya tsahang ni a mbennun, walanggi tǝ ˈya na ɗimi tǝ ndanun wa. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />Hirdus ƙǝm nawa ndǝn tǝ ɗimiyirha fa wa, ndǝghǝn ɗani wuɗang nǝn thlǝmad nǝm ɓa. Mbǝ ˈyasǝ ǝnana kamshiɗiya tsǝkka a ɓǝlanggǝm wa. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />Nanǝn kee, niya tsaɗaghǝn kee kalghǝni hai.”<note caller="+" style="f"><char style="fr" closed="false">23:16 </char><char style="ft" closed="false">Fingya chirethya na kaar na nda tǝ mbǝdghǝn 17 kiya, “A far wutsǝfayid tǝɗaarha ɓa, ka fad hurarha fa nǝn naarha kal niifa hai ahu porsǝna hwanang nanda.”</char></note> <verse eid="LUK 23:16" /><verse number="18" style="v" sid="LUK 23:18" />Kanda heu tǝrang ngganda urandan sǝ tǝ ndaarha, “Ɓǝlamam kamshiɗiya! Kalaman Mbarabas kan hai!” <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />Muwangganda Mbarabas ƙǝnɗǝ ka tǝbǝnggidghǝn ǝna nǝn ahu talaɗǝ na manggǝn, tǝ ɓǝlang nǝn niifa.<verse eid="LUK 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20" />Mbilatus na midghǝnsǝ a kal Yeeso nǝn hai, nggǝrghǝn kalang kanda sǝ. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />Amma karnda fa na nda a huhwarha tǝ ndaarha, “Tawaman ɗǝ! Tawaman ɗǝ!”<verse eid="LUK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22" />Katǝra mahan Mbilatus a kalang kanda sǝ, “Kama nda? Ɗimiyid ma ǝna na kamshiɗiya? Nggi nawi ndǝn tǝ ɗimiyirha tsǝkka a ɓǝlang nggǝm wa. Niya fǝrghǝn tsaɗaghǝn nda kalghǝn nda hai.”<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />Amma isha nda aten path ndan, na mindan sǝ tawangganda ɗǝ. A kwasamadghǝn huhwan ndan kalɗǝ mbǝrha mu. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Mbilatus ƙǝm ǝnagha ƙǝla na mindan. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />Kal niifɗa nǝn hai tǝ muwang nanda hu porsǝna ɗǝ ka tǝbǝnggidghǝn ǝna nǝn, tǝ ɓǝlang nǝn niifa ƙǝla tsakhna nda. Fǝrang Yeeso nǝn kanda, ƙǝla na mindan.<verse eid="LUK 23:25" /></para>
  <para style="s">Tawang nda Yeeso ɗǝ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Na nanda a wiirha tǝ Yeeso, ƙǝma nda tǝ niifa nanda aarha Siman tǝ Sayirarha. Ndǝghǝn ɓayi ahu tala na ngguchit, ngyaɓang tǝr kaɗidɗa nda fa, tǝranggǝn mbu samad Yeeso nǝn. <verse eid="LUK 23:26" /><verse number="27" style="v" sid="LUK 23:27" />Fiya hangga mbuwa samadghǝn, ahur ndan ƙǝm nishya sǝ na a tǝrha tǝ huhwarha ka ndǝghǝn. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />Kyahargha Yeeso hai, ndanggǝn kanda, “Nishya Urshelima, a tǝɗun ka nggi wa, tama ka alten nun, tǝ wangginun. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />Ƙǝsǝr na fara ɓayi, ɓa nun ndaarha, ‘Fa parkayani kwarengya, tǝ hurya ˈwawa wa nggǝtta tǝ ɓee iwana wee iirha!’ <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />Tǝrgha</para>
  <para style="q1" vid="LUK 23:30">“‘Na fiya a ndang nda wumngya, “Muwa ma tennan hai!”</para>
  <para style="q2" vid="LUK 23:30">Ndang ngganda mbǝya na ɗangkam, ɗangkam, “Nggǝlaman kan!” ’<note caller="*" style="x"><char style="xo" closed="false">23:30 </char><char style="xt" closed="false"><ref loc="HOS 10:8">Hodzaya10:8</ref>; <ref loc="REV 6:16">Sǝsǝnid Yahaya6:16</ref></char></note><verse eid="LUK 23:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="LUK 23:31" />A ǝna fiya ǝngginiya ndǝghǝn ɗǝfrha ɓalɗǝ nduwun, mani katǝrarha hai a hwarɗǝ?”<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />Nafiya sǝri, fa mbǝlfeeya, wii nda tǝ kanda ka a ɓǝlangganda kanda tǝ Yeeso. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Ɓa nanda mbǝɗa ɓa na nda aarha Mbǝd Ɓalhwar Teena, a mbǝɗa ni tawang nanda ɗǝ tǝ fa ɗimiya sǝri, tal a yisǝmadghǝn tal ƙǝm a yi kawadghǝn. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />Ndagha Yeeso, “Pǝpa, chahanggǝn kanda ɗǝ, ƙǝsǝr sǝngwanda ǝnɗi nanda a ǝnaarha wa.” Əna wura nda aten lukkighǝn. <verse eid="LUK 23:34" /><verse number="35" style="v" sid="LUK 23:35" />Ishgha fiya hai kanda a ƙǝlarha. Mamngini ƙǝm kanda a waghǝn, nanda a ndaarha, “Hǝrghanggǝn fingya, a hǝrghanggǝn altenggǝn ƙǝm lee, ana ndǝghǝnni Ƙǝrǝsti, Wurra Faara!”<verse eid="LUK 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36" />Sodjaya ƙǝm ɓa nda ɓa nanda a waghǝn. Fǝrang aam inabi nda sǝ na chichakh. <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />Ndang ngganda, “Ana kutǝr Yahudayani sa hǝrghang altenwa lee!” <verse eid="LUK 23:37" /><verse number="38" style="v" sid="LUK 23:38" />Aman tenggǝn ƙǝm chirethlengganda hai, “KUTƏR YAHUDAYA NI YA.” <verse eid="LUK 23:38" /><verse number="39" style="v" sid="LUK 23:39" />Tal ahur fa mbǝlfeyini tawangnda kanda ɗǝ tǝghǝn thlǝghang pathya nǝn sǝ na iˈikh nagha a ndang nda, “Mbǝ sani na Ƙǝrǝsti wa? Hǝrghang altenwa tǝ kan ƙǝm lee!” <verse eid="LUK 23:39" /><verse number="40" style="v" sid="LUK 23:40" />Amma tahad tǝ mbǝlfedɗi djaranggǝn ɗǝ ndagha, “Mba tǝrǝm Faara wa, sa walgha wadghǝnfa mǝmǝl tǝghǝn? <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Ənangganda ƙǝm mǝmǝl, ƙǝsǝr ƙǝna ˈya ǝna nǝm ndǝ walnǝm. Amma niifɗiya mbǝ ˈyasǝ ǝnanǝn na ɗimi wa.”<verse eid="LUK 23:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42" />Tǝrgha ndagha, “Yeeso, ɗalu nggi teena a ɓanna hu kutǝryid wa ɓa” <verse eid="LUK 23:42" /><verse number="43" style="v" sid="LUK 23:43" />Nggǝmangga Yeeso, “Niya puro ƙǝkafek, a weeriya ɗǝna naarha a thlǝmanna a talara.”<verse eid="LUK 23:43" /></para>
  <para style="s">Mǝrra Yeeso</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />Fara a sǝrǝkrha, tǝrgha wula nggǝlanggǝn chehweerha heu, har yargha yanfaara hai. <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />Ƙǝsǝr yanfaara malang ɗǝ djaara hai. Shishamarɗi na a mbǝɗi na tsǝtsaɓa ɗǝ kaan hu Ƙǝn Faara djargha hai sǝri. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />Tǝrangga Yeeso uradghǝn sǝ kaan ndagha, “Pǝpa, ahu harwa hai niya fǝr yiɓǝnna.” Thlǝknǝn ndǝn kee, mǝrgha.<verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />Mamnda sodja ɗi na ƙǝt a mbǝɗi nanǝn ǝnɗi katǝragha hai, fal Faara nǝn ndagha, “Kǝkafek niifɗiya ka niifa ni.” <verse eid="LUK 23:47" /><verse number="48" style="v" sid="LUK 23:48" />Nafini ngwagha hai ka ƙǝlarha, na nanda ǝnɗi katǝragha hai, kanda na heu wuɗa nda wureɗǝ kanda a ɗǝk ƙǝfayindan hu sǝbrha hura. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />Amma nafini na heu sǝngga Yeeso tǝ nishyini mbuwa samadghǝn ɓa, ka ahu chehweed Nggalili ɓa, isha nda ɗǝ inggun, nanda a ƙǝlang ǝnɗi na a katǝrarha hai.<verse eid="LUK 23:49" /></para>
  <para style="s">Pangnda Yeeso</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />Na niifasǝ thlǝmnggǝnni Yisǝfu, nǝghǝn ahur mamngya na ƙǝnang pathla hai, ka niifa ni. <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />Nggǝmngwa fa tǝ ǝnɗi ƙǝnang na nda hai wa. Ɓaghǝn ɓa ahu tal Aramatiya na a chehweed Yahudaya tǝ ƙǝm nǝghǝn a ƙǝla kutǝryid Faara fa. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />Ɗǝgha thlǝmad Mbilatus ɗǝ hwan mǝrra Yeeso nǝn a panggǝn. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />Tǝrgha tǝranggǝn hweeɗe hai, faɗanggǝn hu kaɓad pa mǝrra hai, ɗǝfanggǝn hu kwadɗa hai rana nda ahu feera, yanɗi ˈwa wanda pa mǝrra sǝ. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />Far ngwarha ni fa yi yibrha Yahudaya, takh nda a kyarha hu far yiɓǝdɗa hai.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />Nishyini ɓaa ɓa a samad Yeeso ka a Nggalili ɓa, mbu samad Yisǝfu nda, na ten kwadɗa nda, tǝ mbǝɗi hunang nanda sa hai. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />Tǝrgha wuɗa nda wureɗǝ ngwa nda fa tǝ urdi tǝ fǝɗeerha na sǝdghǝn mbǝnggǝn. Amma yiɓa nda a far Yiɓǝdɗi ka fǝrang mamnggirha nda ˈya ndana ngyakhrha.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">Thlid Yeeso sǝ ahu mǝrra</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />A hu katǝrad par fara yi ɓeena mǝd, a tsar ƙǝrǝt, nishyini tǝrang ngganda kariyi ni na sǝdghǝn mbǝnggǝn, ngwana nda fa ɗǝnda tǝghǝn a ten kwadɗa ɗǝ. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Ɗa nda wal ferɗi nggǝlang na nda mii kwadɗa sǝ kwatǝrɗǝ man patu ɗǝ. <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />Amma kyana nda sa hai, nawa nda mǝrra Yeeso wa. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Nana nda a numarha aten ǝnɗi katǝragha hai kee, kula kanda sǝndasǝ na nafiya nda sǝri tǝ lukki ndan a chimnda fa nagha ahar yirha ƙǝƙǝt a thlǝman ndan. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />Ka tǝrǝm nda, nishyini kwangganda tǝn ndan a hweeɗe hai, amma ndangga nafini kanda, “Kama nun a kaɗa tǝ yibrha, a pathlang mǝrya? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />Ɓalwa a mbǝɗiya wa, thliiɗa sǝ! Ɗalama teena hai tǝ ˈya thlǝghang nǝn kun, ndǝghǝn ɓalɗǝ tǝ kun a Nggalili. <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />‘Wan Niifa nǝn a mukrha ahar fa ɗimiya hai, tawangganda ɗǝ, a far paara yi mahan nǝn a nggǝr thliirha sǝ.’ ” <verse eid="LUK 24:7" /><verse number="8" style="v" sid="LUK 24:8" />Tǝrgha ɗal teena nda hai aten pathghǝn.<verse eid="LUK 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9" />Wud nanda ɓa aten kwadɗi, pǝrang ǝnggina nda heu a Kum Kap Talɗi tǝ fingya fiya. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />Nda Mairamu tǝ Magdaliya, tǝ Yowana tǝ Mairamu man Yakubu, tǝ fingya nishya nananda a mbǝɗi, kanda ni pǝrangga ndǝn fa thlǝngya Yeeso. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />Amma fǝrwanda ƙǝkafek tǝ path nishyini wa, ƙeser tǝrgha nda path ndan ƙǝla ɓasharha ni. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />Mbiturus thliighasǝ tawad ɗagha ten kwadɗa ɗǝ. Ɓǝrgha a mii kwadɗi ƙǝlagha sa ɗǝ, na kaɓadɗa nǝn pang nandasǝ a man patu. Wudgha, ǝnwulteena nǝn tǝ ǝnɗi katǝragha hai.<verse eid="LUK 24:12" /></para>
  <para style="s">A kwaman Imawus</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Nanǝnya tsu a farɗi sǝri ahur nafiya na a mbu samad Yeeso kanda a kwaman ɗǝrha ahu tala ɗǝ nanda aarha Imawus, na iundǝghǝn mel mǝd tǝ Urshelima. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />Kanda a tsǝ laɓara aten ǝnggini katǝragha hai. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Na nanda a tsǝ laɓara aten ǝnggini kee, Yeeso tǝ altenggǝn ɗǝgha thlǝman ndan ɗǝ wii nda ɗǝ. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />Amma nggǝlang nda yindan, amana nda kukwalang hai.<verse eid="LUK 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17" />Tsahang mee nǝn kanda, “Laɓar ma nun a tsǝrha kee kun aten wiirha?”</para>
  <para style="p" vid="LUK 24:17">Isha nda hai ƙǝƙǝt, ƙǝlagha Yeeso hai na hur ndan sǝsǝɓa ɗǝ. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Tal ahur ndan, na thlǝmnggǝn Kilobas, tsahang mee nǝn, “Sa ndǝna ronga kee a Urshelima sǝngwa ǝnɗi katǝragha hai a mbǝɗi ahu ɓǝngginiya wa!” <verse eid="LUK 24:18" /><verse number="19" style="v" sid="LUK 24:19" />Tsakh mee nǝn, “Mani ǝnggini?”</para>
  <para style="p" vid="LUK 24:19">Ndang ngganda, “Ənggini tsǝgha hai aten Yeeso tǝ Nadzarat. Annabini, ǝn ǝnadghǝn tǝ laɓarghǝn nǝghǝn tǝ sǝsǝmnda a mbed Faara tǝ fiya na heu. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />Mamnda firistaya tǝ mamngginǝm fǝr ndan a ngwang kumad mǝrra nda, tawangganda ɗǝ. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />Amma nan a numarha ndǝghǝnni ɓagha hǝrghang nda Isǝreela. Ma takhka ɓal, kulo, a weeriya ɓenggǝn mahan tǝ katǝrana ǝnɗa hai ya. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Mbǝ kee mawa, fingya nishya fǝrangnda ǝnwulteena kan. War nda aten kwadɗa ɗǝ a tsar weeriya, <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />amma nawa nda mǝrrǝghǝn sǝ wa. Ɓa nda ɓa ndang ngganda kan, nanda fathlǝngya Faara, ndaa nda nǝghǝn tǝ yibrha. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Tǝrgha fingya ahur nan ɗǝnda aten kwadɗa ɗǝ ndaa nda nǝghǝn ƙǝla thlǝkna nishyini, amma ndǝghǝn nggi nawa ndan wa.”<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />Ndangga Yeeso kanda, “Hai, kama tsaunun nurya kee, mani ƙǝɗiina fǝrƙǝkafekkid nun aten ˈya thlǝkna annabiya! <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Ashe, kamngwa a sǝsagha Ƙǝrǝsti aten inggini ya a kyagha ahu mamnggitghǝn ɗǝ wa?” <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Katǝradghǝn tǝ Musa tǝ annabiya na heu, pǝrang ɗa ndǝn kanda ˈya thlǝkna ɗeleewar Faara aten Ƙǝrǝsti.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Ndusang nanda talɗa fa nanda a ɗǝrha saɗǝ, tsǝgha Yeeso ƙǝla nǝn a mbǝra mbeeɗǝ. <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />Amma hwanggǝnda kaan tǝ ndaarha, “Tsawu a thlǝman nan, tsǝt figrha hai, kulo yanfaara hǝmɗa hai.” Ɗǝgha ɗǝ tsauka tǝ kanda.<verse eid="LUK 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 24:30" />Tsau nǝn hai nǝn a hǝb ǝnnarhami tǝ kanda, tǝranggǝn mburodi sǝ, usa Faara nǝn, kyanggǝn hai fǝranggǝnǝn kanda ɗǝ. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Tǝrgha ingga yindan ɗǝ kukwalangganda hai, a mbǝɗi kee sahadgha ma yindan. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />Tsahang mee nda ndan, “Mbǝ tǝk ɗǝm mbǝnda fa ahur nǝm na nǝn a kalang ƙǝmsǝ a kwamana, inang nǝn laɓar Faara ƙǝm hai wa?”<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />Thliinda sǝ ƙǝkar wuɗa nda Urshelima ɗǝ. A mbǝɗi ɗanda wal Kum Kap Tal ɗi tǝ fingya nafiya wumngga hai. <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />Nanda a ndaarha, “Ƙǝkafek ni! Chinǝm thliiɗa sǝ har kyaɗang ɗǝ fadghǝn Siman!” <verse eid="LUK 24:34" /><verse number="35" style="v" sid="LUK 24:35" />Tǝrgha nafini na sǝri pǝr ǝnɗa nda katǝragha hai a kwamana, tǝ kukwalang nanda hai kyang nǝn mburodi hai.<verse eid="LUK 24:35" /></para>
  <para style="s">Yeeso kyaɗang ɗǝ fadghǝn fatsahayighǝn</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Kanda ɓal nda a tsǝ laɓara aten ǝnɗi kee, Yeeso tǝ altenggǝn ishgha a maɗufun ndan ndanggǝn kanda, “A fifidɗun hai wa!”<verse eid="LUK 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37" />Tǝr ma nda nagha fandan a rǝbrha fa, kanda a numarha mǝnda-mǝnda na nanda. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />Ndanggǝn kanda, “Kama tǝrǝm nun? Kama ƙǝm nun a kwana nggi ahur nun? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Kǝla man haryina tǝ saryina. Nggi ni tǝ altenna! Tsuwarama nggi fa nawunun, ƙǝsǝr mǝnda-mǝnda mbǝ thluwa sǝ a fadghǝn tǝ ala ƙǝla nanun nggi tǝghǝn fa wa.”<verse eid="LUK 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40" />Thlǝkna Yeeso ǝnɗiya, kyad haryighǝn nǝn tǝ saryighǝn a kanda. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />Ko na nanda tǝ wutsǝfayirha fa tǝ ǝnwulteena, ngwalangwanda fǝrƙǝkafek thliiɗa sǝ wa. Tǝrgha tsahang mee nǝn kanda, “Na ǝnnarhami sǝ a har nun a mbǝɗiya wa?” <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />Fǝrang tǝna nda fifi. <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />Thlǝghǝnǝn kiigha, kanda a ƙǝlang nda.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />Ndanggǝn kanda, “Ənɗa pǝrang ni kun ya nggi ɓalɗǝ tǝ kun. ˈYa na heu ƙǝl ma lǝghǝdɗǝ chirethleng nda hai a tenna ahu ngyakhrha Musa tǝ yi annabiya tǝ ƙǝm Dzabura.”<verse eid="LUK 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45" />“Tǝrgha ɗathlanggǝn hutǝn ndan ɗǝ, tǝna nda sǝn ˈya na chichirethlee hai ahu ɗǝleewar Faara.” <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />Ndanggǝn kanda, “Kulo, ǝnɗi chirethleng na nda hai ya, Ƙǝrǝsti nǝn a sǝsaarha, nǝn a thliirha sǝ hu mǝra a far paara yi mahan. <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />Mal ɗimiyirha tǝ chakhrǝghǝn ɗǝ nanda a pǝrghǝn ɗǝ ahu thlǝmnggǝn a ƙǝshiirha na heu, nǝn a katǝrarha hai a Urshelima. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Kunni nagha ǝngginiya tǝ yinnun, pǝramadghǝn. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />Ɗǝni thlǝnang Sǝsǝna tǝ Peɗǝnda kun ɓa ndana Pǝpa. Amma tsawama a Urshelima, ƙǝl nggǝlang sǝsǝmnda Faara kun a talara hai.”<verse eid="LUK 24:49" /></para>
  <para style="s1">Tǝrang nda Yeeso a talara ɗǝ</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />Kya nǝn sǝ tǝ kanda ma Urshalima ɗǝnda mbǝrha ɗǝ tsau tǝ Mbetani fa, a mbǝɗi haranggǝn haryighǝn sǝ ɗǝfang parka nǝn kanda teena. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Nanǝn a ɗǝfang parka kanda teena, ɗǝkka hai tǝ kanda tǝrang ngganda a talara ɗǝ. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Tǝrgha ɗǝfang shilee nda teena, wuɗa nda a Urshelima ɗǝ lǝlǝgɗa tǝ wutsǝfayirha kaan. <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />Ka fat paara fa na nda naarha fal Faara ahu Wuri Faara.<verse eid="LUK 24:53" /></para>
  <para style="restore">01-Sep-2009@09:54, Backup Description=19-Jun-2009@18:05, Dale Hoskins -</para>
  <para style="restore">12-Jan-2010@14:59, Backup Description=12-Jan-2010@14:41, Paul S. -</para>
