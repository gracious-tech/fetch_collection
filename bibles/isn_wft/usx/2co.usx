<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- Isanzu Bible Version</book>
  <para style="h">2 Akolinto</para>
  <para style="toc1">Balʉa akabɨɨlɨ a mitʉmi Paʉlo kʉ Akolinto</para>
  <para style="toc2">2 Akolinto</para>
  <para style="toc3">2 Ako</para>
  <para style="h">2 Balʉa akabɨɨlɨ Mbugulu a Akolinto</para>
  <para style="mt1">Akolinto</para>
  <para style="imt">Ntongeela akwe</para>
  <para style="ip">Balʉa ɨyɨ nakabɨɨlɨ kʉ Akolonto ɨandɨkilwe nʉ mitʉmi Paʉlo mʉtʉʉng'wa mʉ ng'waka nʉwa makʉmi ataano na itaano nɨ makʉmi ataano na mʉpungatɨ kʉpuma nʉwatugɨwe ʉ Kilisito 1:1. Balʉa ɨyɨ ingɨ yɨpalʉng'wɨ mʉbalʉa naɨyandɨkilwe nʉ Paʉlo kʉ antʉ nɨamʉhʉɨɨe Kilisito nɨakolɨ kʉ Kolinto. Asomi ahʉɨɨe kɨna Paʉlo aɨʉandɨkɨe Akolinto ɨbalʉa nɨkete nkani nkakʉ itungo iniino wazewakɨlɨ kandɨka ɨbalʉa nɨ nkaku. Kɨagila anga ʉkɨmbʉkɨɨlyo wɨhi nʉwa balʉa nanso mitʉmi Paʉlo naɨ ʉkʉmɨtambʉla mʉ mʉlango 2:3,4. Ihumɨkile ʉ Paʉlo aɨwandɨkile ɨbalʉa akabɨɨlɨ naɨ ʉkolɨ kʉ Mkedonia 2:13.</para>
  <para style="ip">Balʉa akabɨlɨ kʉ Akolinto ingɨ ɨsa nɨ nzʉya kʉnsoko ɨtambʉe makani dʉ nang'wa Paʉlo palʉng'wɨ nɨ masɨgo akwe. Paʉlo ʉkʉganʉla ʉlowa kʉnsoko nkani nza niya antʉ nʉamʉhʉɨɨe Kilisito nɨakolɨ kʉ Kolinto nʉsɨngɨɨye kʉpuma kʉng'wa Tito. Mʉbalʉa ɨyɨ, kʉʉlija ʉmanyisigwa ʉkʉlʉ antʉ nɨɨatakɨwe kʉpumya anga Ilago Nipya nɨlɨlagɨɨye, nɨɨza mʉng'wakwe ʉ Paʉlo ʉkʉlagɨɨlya kʉnsoko akʉhangʉlya mpia ahume kʉaaɨɨlya antʉ nɨamʉhʉɨɨe ʉ Kilisito nɨakolɨ kʉ Yelusalemu 8-9. Yilagɨɨe kɨna itʉmi aʉteele nɨang'wɨ nɨshanga antʉ nɨamʉhʉɨɨe ʉ Kilisito ɨkatʉmɨla ʉbɨ naɨalekeye antʉ nɨamʉhʉɨɨe ʉ Kilisito aleke kʉmʉhʉɨɨla Paʉlo, kisɨgo nɨla kikʉlya ɨenso. Ɨkagema kʉatenda antʉ akankanyale kʉhʉɨɨla ʉhumi wang'wa Paʉlo, ikani naɨlɨmʉtendile Paʉlo watʉmɨle nkani niyikete ngulu mʉʉmaɨɨlyo nʉwa balʉa ɨyɨ kʉkaminkɨɨlya ʉhumi wakwe anga mitʉmi wang'wa Yesʉ Kilisito.</para>
  <para style="iot">Namolɨ</para>
  <para style="io">Paʉlo ʉkandya kandɨka balʉa akwe kʉlilamʉsha antʉ nɨamʉhʉɨɨe Kilisito 1:1-7.</para>
  <para style="io">Sʉnga Paʉlo ʉkʉligitɨlya ʉkaɨlɨki waihambi nʉwamɨhɨnzo akwe, nɨ nkani yao naɨwɨgule kʉ a Kolinto nʉʉsʉkɨɨlyo wao kʉ balʉa akwe nang'wandyo 1:8-7-16.</para>
  <para style="io">Naɨ yakɨla pang'wanso, Paʉlo wɨkalagɨɨlya ʉhangʉlyi wampia kʉaaɨɨlya antʉ nɨamʉhʉɨɨe Kilisito nɨakolɨ kʉ Yelusalemu 8:1-9-15.</para>
  <para style="io">Paʉlo ʉkʉmaɨɨlya balʉa akwe kʉʉkʉɨɨla witʉmi wakwe, hangɨ ʉkʉhʉgʉlya kʉ mʉhɨnzo wakwe naɨwahumbeela 10:1-13-10.</para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />Ʉnene Paʉlo mʉtʉʉng'wa wang'wa Yesʉ Kilisito kʉʉlowa wang'wi Itunda, kɨpalʉng'wɨ nʉmʉnyandʉgʉ witʉ Timoteo.</para>
  <para style="p" vid="2CO 1:1">Kʉʉmʉandɨkɨla ʉnyenye milʉndo nʉwa antʉ nɨamʉhʉɨɨe ʉ Kilisito nɨmʉkolɨ kʉ Kolinto, nɨantʉ ɨhi nɨang'wi Itunda mʉisalɨ yɨhi nɨya kʉ Akaya.<verse eid="2CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2" />Kʉʉmʉlompa Itunda Tata witʉ nɨ Isekʉlʉ witʉ Yesʉ Kilisito wamʉkembete nʉ kʉmʉpa matiliga mɨhi.<verse eid="2CO 1:2" /></para>
  <para style="s">Paʉlo ʉkʉmʉsongelya Itunda</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />Wakʉligwe Itunda Tata wang'wi Isekʉlʉ witʉ Yesʉ Kilisito, Tata nʉkete kɨaisa hangɨ Itunda nʉwɨkʉaɨɨlya mʉlwago lɨhi. <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />Ng'wenso wɨkʉaɨɨlya ʉsese mʉlwago litʉ lɨhi, nʉsese kʉhume kʉaɨɨlya nɨangɨɨza mʉlwago kʉ ʉaɨɨlya wʉwo wʉʉwo nɨkɨsɨngɨɨlya kʉpuma kʉng'wi Itunda. <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />Anga nɨkʉlongolekile kagigwa kʉnsoko akʉmʉhʉɨɨla ʉ Kilisito, itɨʉ Itunda ʉlongolekile kʉʉaɨɨlya kʉkɨɨla Kilisito. <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />Ʉsese anga kagigwe, ingɨ kʉnsoko aʉaɨɨlya nʉ ʉgunɨki wanyu. Anga ɨze kʉʉaɨɨligwa, ingɨ kʉnsoko akʉmʉaɨɨlya mʉgimye mʉlwago lʉlo nʉlɨkaja ʉsese. <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />Hangɨ isʉmbɨɨlyo nɨkukete kʉng'wanyu ingɨ ikʉlʉ, kʉnsoko kʉlɨngile kɨna anga magigwe anga sese, ʉʉgwa Itunda ʉkʉmʉkomya nkolo anga ʉsese.<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />Anyandʉgʉ itʉ, kʉʉhiya mʉmanye ʉlwago naɨ kʉlʉpantɨkile ʉko kʉ kɨsalɨ ka Asia, lwago nʉlanso aɨlʉkʉlemilye kɨkaʉlya ɨnsʉla akʉlongoleka kɨshiɨ. <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />Kʉlʉ kʉʉlʉ aɨkʉsɨgile kaina anga antʉ nɨapɨsɨɨigwe kʉbʉlagwa. Ingɨ kʉmanyisigwa kʉleka kisania ʉsese, kʉmʉsanie Itunda nʉwɨiʉsha antʉ nɨakulee. <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />Itunda naɨʉkʉgunile mʉlwago nʉla nsha, hangɨ nʉlongolekile kʉʉguna, ʉsese kʉsʉmbɨɨye kɨna ʉkʉʉguna hangɨ. <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />Nʉnyenye mʉkʉaɨɨlye ʉsese kʉmʉlompa Itunda, wahume kija malompi anyu nʉkʉ ʉkembeta ʉsese, papo antʉ ɨdʉ akʉmʉlʉmba Itunda kʉnsoko itʉ.<verse eid="2CO 1:11" /></para>
  <para style="s">Paʉlo ʉkʉdɨla mʉhɨnzo wakwe</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />Ʉsese kʉiketela kɨntʉ kɨng'wɨ du, kʉsɨgile kɨna kɨshiɨ mʉ ʉnkʉmbigʉlʉ nʉ kʉng'wanyu, kʉ ʉhʉɨɨli nʉ ʉgoloku naɨkʉpewe ni Itunda, shanga aɨkʉtendile nanso kʉ mahala a kɨʉntʉ ingɨ kʉ ʉkende wang'wi Itunda. <verse eid="2CO 1:12" /><verse number="13" style="v" sid="2CO 1:13" />Kʉʉmʉandɨkɨla ʉnyenye makani nɨmʉhumile kʉmasoma nʉ kʉmalɨnga, nsɨgɨɨe kɨna mʉkʉlɨnga nʉnda, <verse eid="2CO 1:13" /><verse number="14" style="v" sid="2CO 1:14" />kʉnsoko kʉpikɨɨla ino makʉlɨnga ɨniino. Kʉlɨngile kɨna mʉlʉhikʉ nʉla kʉtulya Isekʉlʉ witʉ Yesʉ mʉzɨɨzi isanɨlya sese, anga ʉsese nɨkʉisania kʉnsoko anyu.<verse eid="2CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />Nsʉmbɨɨye kʉmʉgendela ʉnyenye mʉhume kʉkembetwa hangɨ. <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" />Mʉ mʉhɨnzo nɨnongoe kʉ kɨsalɨ ka Makedonia nomee kʉkɨɨla kʉng'wanyu napa nɨkʉtulya, mʉnzaɨɨlye impamba niya mʉhɨnzo wane nɨnongoe kʉ kɨsalɨ ka Ʉyahudi. <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />Itɨɨ, naɨnomee ikani ɨlɨ azanɨhanga mʉntʉ nʉwa mampɨlʉ ne? Itɨɨ mʉsɨgɨɨe kɨna kitʉma makani ane kʉmasɨgo akɨʉntʉ kɨna “nahita” hangɨ “nagomba” papo paapo? <verse eid="2CO 1:17" /><verse number="18" style="v" sid="2CO 1:18" />Itunda wɨtambʉla ɨtai du, ʉnene anga nʉnge “nahita” ang'wɨ anga nʉnge “nagomba” ingɨ yituleʉ. <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" />Kʉnsoko Yesʉ Kilisito Ng'wana wang'wi Itunda aɨkʉmutanantilye kʉng'wanyu, ʉnene nʉ Siliwamo nʉ Timoteo, shanga antʉ a “kʉhita” nʉ “kʉgomba” ingɨ nʉwanso mahikʉ ɨhi aɨwɨlʉnga “nagomba.” <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />Kʉnsoko maintʉ ɨhi Itunda nʉlʉngile ʉkitʉma apikɨɨla kʉkɨɨla Yesʉ Kilisito. Kʉnsoko akwe kɨlʉnga “Nagomba” kʉnsoko akʉmʉkʉlya Itunda. <verse eid="2CO 1:20" /><verse number="21" style="v" sid="2CO 1:21" />Itɨ gwa Itunda ng'wenso wɨkʉkomelya nkolo ʉsese palʉng'wi nʉ nyenye kʉkamɨnkane nʉ Kilisito, nʉkʉhoile ingɨ Itunda ng'wenso, <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />ng'wenso ʉkʉɨkɨe lʉkao kʉtule kɨ antʉ akwe, aɨʉkʉpee Ng'wahʉ Ng'welʉ mʉnkolo yitʉ itule kɨkamɨnkɨɨli ka makani ɨhi naɨ ʉtambʉe kɨna ʉkʉʉpa.<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />Itunda ng'wenso ʉlɨngile kɨna kʉtambula ɨtai, ʉmɨlɨngile ɨnkolo ane. Ʉnene shanga aɨnzile kʉ kɨsalɨ ka Kolinto kʉmʉaisɨɨlya. <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />Shanga kʉloilwe kʉmʉsinja mʉ ʉhʉɨɨli wanyu, ʉsese kʉlɨngile kɨna ʉnyenye mʉkomilye nkolo mʉ ʉhʉɨɨli, ingɨ kʉitʉma mʉlɨmo palʉng'wɨ nʉnyenye mʉhume kiloa.<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />Itɨ gwa mʉnkolo ane aza nsɨgɨɨe ndeke kʉmʉgenipa hangɨ kʉnsoko ndeke kʉmʉsasha mʉtule nʉ ʉkɨa. <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />Aɨnamʉe itɨ kʉnsoko anga nʉmʉsashe mʉtule nʉ ʉkɨa nyenyugwa nʉʉkʉnzaɨɨlya? Ingɨ ʉnyenye nɨɨza mʉndoeeye. <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />Nʉmʉandɨkɨe ikani ɨlɨ ingɨ anga nɨze kʉng'wanyu ndeke kʉpegwa ʉkɨa nʉnyenye naza mʉzetula ʉlowa wane. Nɨhʉɨɨe kɨna ʉnene anga ndowe, nʉnyenye ga mʉkʉlowa. <verse eid="2CO 2:3" /><verse number="4" style="v" sid="2CO 2:4" />Naɨ nʉmʉandɨkɨe kʉnsoko alwago nʉlʉkʉlʉ nɨkaga nangulu mʉnkolo ane hangɨ kʉhunʉla liholi lɨdʉ, shanga aɨkʉmʉsasha mʉtule nʉ ʉkɨa ingɨ kʉnsoko akʉmʉlagɨɨla kɨna nʉmʉloilwe ikʉlʉ.<verse eid="2CO 2:4" /></para>
  <para style="s">Kʉlekelwa kʉ mʉnya mɨlandʉ</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />Anga ɨtule mʉntʉ wasashe ʉmʉya watule nʉ ʉkɨa, shanga ʉsakilye ʉkɨa kʉng'wane, ingɨ ʉsakilye ʉkɨa kʉng'wanyu mɨhi, hangɨ shanga ndoilwe ntule nɨmʉtaki kʉkɨlɨnkɨɨla. <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />Ʉpɨsɨligwa naɨ wamʉpantɨka kʉpuma kʉ antʉ ang'wɨ anyu wankoela. <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />Nɨ kɨsagile igɨ bahu ʉnyenye mʉmʉaisɨɨlye mʉntʉ nʉwanso nʉkʉmʉkomelya nkolo waleke kʉlemigwa nʉ ʉkɨa nangulu nʉ kʉkatapa. <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />Kʉlʉlo nʉmʉlompile, mʉlagɨɨlɨ hangɨ kɨna mʉmʉloilwe. <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />Yɨyɨ nsoko akʉandɨka balʉa ɨyo, ingɨ nɨhume kʉlɨnga kɨna mʉhumile kʉnija mʉ makani ɨhi. <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />Ʉnyenye anga mʉmʉlekele mʉntʉ wɨhi, nʉnene ga kʉmʉlekela. Kʉnsoko nʉnene ga anga nʉmʉlekele mʉntʉ ikani lɨhi, nʉmʉlekela kʉnsoko anyu ntongeela angwa Kilisito. <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />Ingɨ ʉ Shetani waleke kʉʉlemya, kʉnsoko kʉlɨngile ihala lakwe.<verse eid="2CO 2:11" /></para>
  <para style="s">Paʉlo mʉ kɨsalɨ ka Tiloa</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />Naɨ napika kʉ kɨsalɨ ka Tiloa kʉtanantya Nkani Nza niyang'wa Kilisito, Isekʉlʉ wɨkanɨngasa nitʉme mʉlɨmo wakwe. <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />Ingɨ nɨkahʉsha nangulu kʉhita kʉmʉhanga mʉluna witʉ Tito. Kʉlʉlo nikaalaga ɨantʉ pang'wanso nɨkalongola kʉ Makedonia.<verse eid="2CO 2:13" /></para>
  <para style="s">Kʉhuma kʉʉaɨɨlya wang'wa Kilisito</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />Ingɨ kʉmʉlʉmbila Itunda nʉwikʉtongeela mahikʉ ɨhi mʉmɨhɨnzo nɨkʉkamɨnkanile nʉ Kilisito. Nʉwanso wɨkʉpeza ʉhumi kʉtanantye mpola yang'wa Kilisito nkɨka yɨhi anga manyunkɨɨlo nɨnyunkɨɨla iza. <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />Kʉnsoko ʉsese kʉng'wi Itunda kɨhanga anga manyunkɨɨlo nɨ maza na ʉbani napumigwe nʉ Kilisito kʉng'wi Itunda, nɨapikɨɨla antʉ ɨhi, antʉ nɨakʉgunwa nɨ antʉ nɨshanga amʉhʉɨɨe ʉ Yesʉ Kilisito. <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />Kʉ antʉ nɨshanga amʉhʉɨɨe ʉ Yesʉ Kilisito, mʉnyunko nʉwanso ingɨ nsha, ingɨ kʉ antʉ nɨakʉgunɨka, mʉnyunko nʉwanso ingɨ ʉpanga. Nyenyu gwa, nʉhumile kitʉma makani nanso? <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />Ʉsese shanga kimpyani nɨ antʉ ang'wɨ nɨɨgʉlya lʉkani lang'wi Itunda, ʉsese kɨtanantya lʉkani lang'wi Itunda kʉ ʉhʉɨɨli, anga antʉ nɨalagɨigwe ni Itunda, ɨze kʉkamɨnkanile nʉ Kilisito.<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="s">Itʉmi Ilago Nipya</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />Itɨɨ, ʉsese kʉandya kɨkoola ne? Itɨɨ, kʉʉhiya balʉa ne nakikoola kʉng'wanyu, ʉsese shanga anga antʉ nɨangɨza nɨɨlompa balʉa akikoola kʉ ng'wanyu? <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" />Ʉnyenye ingɨ mɨbalʉa itʉ nɨandɨkilwe mʉnkolo yitʉ nɨmanyɨkile nʉkʉsong'wa nɨ antʉ ɨhi ahume kumanya mʉlɨmo nɨkitumile kʉng'wanyu. <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />Ingɨ ɨtai kɨna ʉnyenye mʉmanyɨkile kɨna mɨbalʉa nɨpumɨɨe kʉng'wa Kilisito, naɨʉmɨtae kʉkɨɨla ʉsese. Nɨshanga ɨandɨkilwe kʉ wino, ingɨ kʉ Ng'wahʉ wang'wi Itunda nʉ mʉpanga, shanga ɨandɨkilwe mʉng'waigwe nʉsesilwe, ingɨ mʉnkolo ya ana antʉ.<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />Kʉhumile kʉtambʉla aya kʉnsoko isʉmbɨɨlyo litʉ nɨkʉkete kʉng'wi Itunda kʉkɨɨla makani nʉkʉtende ʉ Kilisito. <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />Shanga kʉhumile kitʉma kɨntʉ kɨhi kʉngulu yitʉ, ingɨ ʉhumi witʉ wɨhi wɨpuma kʉng'wi Itunda. <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />Itunda yʉyo wɨkakʉaɨɨlya ʉsese kʉlɨtʉmɨla Ilago Nipya shanga ilago nɨlamalagɨɨyo naandɨkilwe, ingɨ Ilago la Ng'wahʉ. Kʉnsoko malagɨɨlyo naandɨkilwe ileta nsha, ingɨ Ng'wahʉ wɨleta ʉpanga.<verse eid="2CO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />Malagɨɨlyo aɨ aɨkilwe akaze aandɨkilwe mʉ ana magwe. Ɨmpelo akwe ingɨ nsha, ʉkʉlʉ wakwe wɨkatula ʉkʉlʉ nangulu nɨ ana Aisilaeli ɨkaleng'wa kʉʉgoza ʉsʉ wang'wa Musa kʉnsoko aʉmɨlɨgɨntu wakwe. Hangi ʉmɨlɨgɨntu nʉwanso aɨwitungo ikupɨ. Kʉitɨ, anga ɨtule malagɨɨlyo naɨasakilye ɨnsha iletilwe kikʉlyo nikʉlʉ itɨ, <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />ʉʉgwa mʉlɨmo nʉwa Ng'wahʉ wang'wi Itunda ʉkete ʉkʉlʉ nangalu. <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />Anga itule mʉlɨmo nʉwanso nʉwɨsasha ʉlamʉlwi kʉ antʉ ʉkete ikʉlyo, kʉlʉlo ikʉlyo nɨla mʉlɨmo nʉwɨasasha antʉ agombeke kʉng'wi Itunda ingɨ ʉkʉlʉ mbele. <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />Kʉlʉlo ikʉlyo nɨ Lilago la kalɨ lalimansɨɨla, kʉnsoko ikʉlyo Lilago Nipya nikʉlʉ ikɨlo lahola ɨlyoma lakwe. <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />Anga ɨze ɨkɨ nɨkɨkɨla kɨkete ikʉlyo lakwe, ʉʉgwa ɨkɨ nɨkakishiɨ kalɨ na kalɨ kɨkʉtula nɨkʉlyo ikʉlʉ nangalu<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />Kʉnsoko ɨlɨ lɨlɨ isʉmbɨɨlyo litʉ, ʉsese kʉʉligitya kʉngulu yɨhi kɨagila anga woa. <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />Ʉsese shanga kʉʉtenda anga Musa naɨʉtakɨwe kʉkunɨkɨla ʉsʉ wakwe kʉ kɨtambala Aisilaeli aleng'we kʉona ʉsʉ wakwe kʉpikɨɨla ʉmɨlɨgentu ʉwo naɨ ʉkʉzizɨɨla. <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />Ingɨ Aisilaeli ɨpilimig'wa mahalaao, sambʉnʉyʉ anga lɨsong'we Ilago nɨla Kalɨ shanga ɨlɨnga ɨtai. Kɨtambala nɨkanso kɨkʉhega ʉdu anga mʉntʉ wamʉhʉɨɨle ʉ Kilisito. <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />Sambʉnʉyʉ nakʉsong'wa malagɨɨlyo ang'wa Musa mahalaao iza akɨlɨ akunɨkɨwe shanga ɨlɨnga ɨtai. <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />Ingɨ, anga Wandɨkwa wang'wa Mʉsa nʉwandɨkilwe kɨna, “Mʉntʉ anga wamʉgombe Isekʉlʉ kɨtambala nɨkanso kɨhegigwa.” <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />Itɨ gwa “Isekʉlʉ” ingɨ Ng'wahʉ, napo nʉkolɨ ʉ Ng'wahʉ wang'wi Isekʉlʉ papo widesi ʉmolɨ. <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />Itɨ gwa, ʉsese kɨhi nɨɨza shanga kʉkunɨkɨwe ʉsʉ witʉ, kɨona ʉkʉlʉ wang'wi Isekʉlʉ anga mʉkɨyoo, kʉ ʉkaɨlwa kimpyane nangalu nʉng'wenso kʉpuma ʉkʉlʉ kenda ʉkʉlʉ, nʉwanso ingɨ mʉlɨmo wa Ng'wahʉ wang'wi Isekʉlʉ.<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s">Kɨʉto ka Ng'wahʉ mʉyʉngʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />Itɨ gwa, Itunda kʉ kɨaisa kakwe, wakʉpeza ʉsese mʉlɨmo ʉwʉ kʉlʉlo shanga kʉʉkatapa. <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />Ingɨ kahitile lʉkʉlʉ makani ɨhi namɨnyala naya nawipiho. Hangɨ shanga kɨmʉkongela mʉntʉ, ang'wɨ kʉhanja nʉ ʉteele mʉlʉkanɨ lang'wi Itunda, ingɨ kʉʉtambʉla ɨtai kʉtilɨ ipiho antʉ alɨnge kɨna ʉsese kɨantʉ atai pang'wi Itunda. <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />Ndogoelyo, anga ɨze Nkani Nza nɨkʉʉtanantya yipihilwe, ingɨ yipihilwe kʉ antʉ nɨshanga amʉhʉɨɨe Itunda. <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />Antʉ nɨanso shanga ahʉɨɨe kʉnsoko ʉ Shetani mʉkʉlʉ nʉwa ʉnkʉmbigʉlʉ ʉwʉ waapʉngʉtaye mahalaao aleng'we kʉona nzelya niya Nkani Nza nikʉlyo lang'wa Kilisito, nɨɨza mpyani ang'wi Itunda. <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />Ndogoelyo shanga kʉitanantya anga sese, ingɨ kʉʉmʉtanantya Yesʉ Kilisito kɨna Isekʉlʉ, ʉsese kɨ itʉmi anyu kʉnsoko akwe. <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />Kʉnsoko Itunda aɨʉtambʉe, “Nzelya nelye mʉkiti,” yʉyo nʉwelya mʉnkolo yitʉ, nʉkʉʉpa nzelya niya ʉlɨngi nʉwa ʉkʉlʉ wakwe nʉwelya mʉ ʉsʉ wang'wa Kilisito.<verse eid="2CO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />Itɨ gwa, ʉsese nɨkʉkete kɨʉto ɨki nɨkɨpuma kʉng'wi Itunda kɨmpyani ni yʉngʉ niibadʉka, yilɨngɨke kɨna ngulu ɨyɨ nɨnkʉlʉ ɨpumɨɨe kʉng'wakwe, shanga kʉng'witʉ. <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />Kɨkɨɨla mʉlwago, ingɨ shanga kɨlekwa kʉaɨɨligwa ni Itunda, kikankania ingɨ shanga kɨkatapa, <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />kagigwa, ingɨ shanga kɨlekwa ni Itunda, palʉng'wɨ nʉkʉtagwa pihɨ, shanga kʉlimansɨɨe. <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />Matungo ɨhi antʉ ɨkenda hiya kʉʉbʉlaga anga naɨamʉtendee ʉ Yesʉ, ndogoelyo ʉpanga wang'wa Yesʉ wigeeleke mʉ mɨɨlɨ itʉ. <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />Kʉnsoko ʉsese nɨkɨapanga, matungo nɨkʉishiɨ kʉkolɨ mʉʉlʉgʉ wansha kʉnsoko ang'wa Yesʉ, ingɨ ʉpanga wang'wa Yesʉ wigeeleke mʉmɨɨlɨ itʉ nɨkuza. <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />Matungo ɨhi kagigwa pakupɨ ɨnsha, kʉlʉlo ʉnyenye mɨlija ʉpanga.<verse eid="2CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13" />Wandɨkwa wang'wi Itunda wandɨkilwe kɨna, “Aɨnʉmʉhʉɨɨe Itunda, papo nɨkatambʉla.” Nʉ sese ga kʉkete nkolo yɨyo yɨɨyo nakʉhʉɨɨla, kʉlʉlo kʉʉtambʉla kʉnsoko kʉhʉɨɨe. <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />Kʉlɨngile kɨna Itunda naɨʉmiʉshilye Isekʉlʉ Yesʉ, ʉkʉiʉsha nʉsese ga anga naɨʉmiʉshilye ʉ Yesʉ, ʉsese nʉ nyenye kʉʉɨkwa pantongeela akwe. <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />Makani aya ɨhi ingɨ kʉnsoko ansaɨlo anyu, ingɨ antʉ amʉlʉmbe Itunda kʉ ʉkende wakwe nʉwɨapikɨɨla antʉ ɨdʉ nangalu, kʉkɨɨla itɨ Itunda walongoleke kʉkʉligwa.<verse eid="2CO 4:15" /></para>
  <para style="s">Kishiɨ kʉ ʉhʉɨɨli</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />Kʉlʉlo shanga kɨkatapa, palʉng'wɨ kɨna mɨɨlɨ itʉ ɨlongolekile kʉkatala nʉ kʉnyampala, ingɨ nkolo yitʉ yitendwa ʉpya mahikʉ ɨhi. <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />Lwago nɨkʉʉkɨɨla ingɨ lʉniino, hangɨ kitungo ʉdu, ingɨ lɨkʉpeza ikʉlyo nʉlʉkɨile lwago lɨhi, ikʉlyo nigila anga mpelo. <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />Kʉlʉlo shanga kʉsanilye anga maintʉ nɨkʉmaine, ingɨ kʉsanilye maintʉ nɨshanga kʉmaine. Kʉnsoko maintʉ nɨkʉmaine ɨkɨlaa, ingɨ maintʉ nishanga kʉmaine yayo akalɨ na kalɨ.<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />Kʉnsoko kʉlɨngile kɨna mɨɨlɨ itʉ ɨhanga kɨtala nɨkishiɨ itungo ɨlɨ mʉnʉ mʉʉnkumbigʉlʉ kɨzɨɨzataʉlwa, ingɨ Itunda ʉkʉʉpa likalo nʉlʉngɨza kigʉlʉ, nyʉmba akalɨ na kalɨ nɨshanga ɨzengwa nɨ antʉ. <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />Itungo ɨlɨ, nɨkishiɨ mʉnʉ mʉʉnkumbigʉlʉ kʉilɨɨla kʉ ʉwai, kʉnsoko kʉsʉmbɨɨye kenda kishiɨ mʉlikalo litʉ nʉla kigʉlʉ, <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />kʉlʉ kʉʉlʉ kʉʉtugalwa mɨɨlɨ akigʉlʉ anga itugalo nipya, shanga kʉʉtula kɨ kɨmpʉnyʉ. <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />Nɨkʉmolɨ mʉkɨtala ɨkɨ nɨka mʉʉnkumbigʉlʉ, kʉilɨɨla kʉnsoko makani ɨdʉ nakʉlemeeye. Shanga kɨna kʉloilwe kʉtugʉla mʉɨlɨ ʉwʉ nʉwɨsha, ingɨ kʉlolwe kʉtugalwa mʉɨli nɨshanga wɨsha, ingɨ mʉɨlɨ ʉwo nʉwakʉsha ʉkaɨlwe nʉ mʉɨlɨ nɨshanga wɨkuza. <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />Itunda ng'wenso aɨʉkʉnoneeye ikani ɨlɨ, hangɨ ʉkʉpee Ng'wahʉ wakwe watule kɨɨkɨɨli ka makani nʉkʉnoneeye.<verse eid="2CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6" />Mahikʉ ɨhi kʉkamatɨkile. Kʉlɨngile kɨna kʉlongoleka kishiɨ mʉ mʉɨlɨ ʉwʉ, ingɨ kishiɨ kʉlɨ ni Isekʉlʉ. <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />Kʉnsoko kishiɨ kʉ ʉhʉɨɨli, shanga kʉ makani nɨkɨmaona. <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />Kɨakamatɨku ɨtai taai kʉnsoko kʉine bahu kʉhame mʉ mʉɨlɨ ʉwʉ, kʉhamɨle kʉng'wi Isekʉlʉ. <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />Kʉlʉlo kʉsʉmbɨɨye kɨntʉ kɨng'wɨ, ingɨ kʉmʉloeelya ikani ɨlɨ iza nangalu kʉng'wi Isekʉlʉ kishiɨ mʉnʉ mʉʉnkumbigʉlʉ. <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" />Kʉnsoko ʉsese kɨhi kʉimɨka pang'wa Kilisito kʉlamʉlwe, ingɨ antʉ ɨhi asɨngɨɨlye kʉkɨɨla ntendo naɨatendile itungo naɨishiɨ mʉʉnkumbigʉlʉ, yitule atendile iza ang'wɨ atendile ibɨ.<verse eid="2CO 5:10" /></para>
  <para style="s">Kʉkamɨnkana ni Itunda kʉkɨɨla Kilisito</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />Itɨ gwa, ʉsese kʉlɨngile ndogoelyo akʉmʉkʉlya Itunda, ingɨ kʉkagupile kʉaleta antʉ kʉng'wi Itunda. Itunda ʉkʉlɨngile ɨtai taai, nʉnene nɨhʉɨɨe kɨna nʉ nyenye ga mʉkʉmanyile ɨtai taai. <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />Shanga kʉʉgema kikʉlya hangɨ kʉng'wanyu, ingɨ kʉhiya kʉmʉɨla makani natakɨkwe kikʉlya kʉnsoko itʉ, ingɨ mʉhume kʉasʉkɨɨlya antʉ nɨasanilye makaniao nakʉnzi amʉɨlɨ kʉkɨla namolɨ mʉnkolo yao. <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />Anga kʉonwe kɨna kapʉngʉtaae, ingɨ kʉnsoko ang'wi Itunda, hangɨ aga kʉonwe kʉkete mahala nɨmaza, ingɨ kʉnsoko anyu. <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />Ʉlowa wang'wa Kilisito ʉkʉtongee, ʉsese nɨkʉlɨngile kɨna mʉntʉ ʉng'wɨ ʉkule kʉnsoko aantʉ ɨhi, kʉlʉlo antʉ ɨhi aɨakʉlee. <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />Aɨʉkule kʉnsoko aantʉ ɨhi, ingɨ antʉ nɨapanga aleke kishiɨ kʉnsokoao, ingɨ ishiɨ kʉnsoko akwe naɨʉkule nʉkiʉkigwa kʉnsokoao.<verse eid="2CO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16" />Itɨ gwa, kandɨɨlya ino, ʉsese shanga kʉʉmʉona mʉntʉ wɨhi anga ʉnkumbigʉlʉ nʉwɨaona ɨantʉ. Palʉng'wɨ nɨ kɨna pakalɨ aɨkʉmʉine ʉ Kilisito kɨʉntu, ɨtungo ɨlɨ shanga kʉʉtenda itɨ hangɨ. <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />Mʉntʉ wɨhi anga wakamɨnkane nʉ Kilisito waina mʉntʉ mʉpya, makani akalɨ ɨkɨla, kolwa makani ɨhi ɨtula mapya. <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />Makani aya ɨhi ingɨ mʉlɨmo wang'wi Itunda nʉwɨkʉhunga ʉsese nʉng'wenso kʉkɨɨla Kilisito. Wɨkʉpeza mʉlɨmo nʉwakʉahunga antʉ ni Itunda. <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />Anga nɨkɨlʉnga kɨna, Itunda wɨagomba antʉ a mahɨɨ ɨhi kʉkɨɨla Kilisito, hangɨ shanga ʉkʉalya mɨlandʉ. Ng'wenso wakʉpeza mʉlɨmo nʉwa kʉatanantɨlya antʉ akamɨnkane nʉng'wenso. <verse eid="2CO 5:19" /><verse number="20" style="v" sid="2CO 5:20" />Kʉlʉlo ʉsese kʉlagɨigwe nʉ Kilisito kitʉme mʉlɨmo wakwe, Itunda nʉyo ʉkʉlagɨɨye ʉsese kʉminena ʉnyenye. Ɨkɨ kɨkɨ ʉ Kilisito ʉkʉlagɨɨye ʉsese kʉminene ʉnyenye mitʉme. <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />Kilisito aɨmʉgila anga mɨlandʉ, ingɨ Itunda wɨkamʉtenda watule mʉnya mɨlandʉ kʉnsoko itʉ, ingɨ ʉsese kʉʉkamɨnkani nʉ Kilisito kʉaɨligwe kɨna kʉgombekile kʉng'wi Itunda.<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />Itɨ gwa, ʉsese kitʉmania mʉlɨmo ni Itunda, kʉʉminena mʉleke kʉgomba ʉkende ʉwo naɨmʉsɨngɨɨye kʉpuma kʉng'wi Itunda ʉlimɨle nakanda. <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />Itunda ʉlʉngile itɨ,</para>
  <para style="q" vid="2CO 6:2">“Itungo naɨlɨgombekile aɨnʉkʉtegeeye,</para>
  <para style="q" vid="2CO 6:2">itungo nɨla ʉgunwi</para>
  <para style="q" vid="2CO 6:2">aɨnʉkʉaɨɨye,</para>
  <para style="q" vid="2CO 6:2">Itɨ gwa, itungo niligombekile ingɨ lɨlɨ,</para>
  <para style="m" vid="2CO 6:2">Kolwa! Lʉhikʉ nʉla kʉgunɨka ingɨ lʉlʉ.<verse eid="2CO 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3" />Ingɨ kʉleke kʉasasha antʉ angɨɨza asoshe ʉmʉlɨmo witʉ, shanga kʉloilwe kʉmʉgilya mʉntʉ wɨhi waleke kʉhʉɨɨla. <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />Nsuta nɨ itɨ kigelekile kɨna ʉsese kɨitʉmi ang'wi Itunda. Kiʉmɨɨye nangalʉʉ mʉwagigwi nʉ mʉʉkaku nʉ mʉlwago. <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" />Kʉkʉilwe nʉ kʉtugwa mʉmageleza nʉkʉhamɨɨlwa pa antʉ, kitʉmile mɨlɨmo nɨmɨkaku, ʉtikʉ nʉ ng'ʉng'wɨ shanga aɨkɨkendalya ang'wɨ kʉlala. <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />Kɨonwa kɨna kɨ itʉmi a mɨlɨmo ang'wi Itunda kʉnkolo nɨnza nʉ ʉmanyi nʉ wiʉmɨɨlyi nʉ ʉkende nʉ kʉ Ng'wahʉ Ng'welʉ nʉ kʉʉlowa nʉwa tai, <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />kʉtambʉla mpola niya tai nʉ kʉngulu yang'wi Itunda. Ʉtyata tai yɨyo yɨgɨ yitʉ niya kilahɨla nɨ ngʉla akikɨngɨla. <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" />Ʉsese kʉʉmitʉmɨla Itunda antʉ akʉkʉlye ang'wɨ akʉdalahe, akʉsoshe ang'wɨ akʉkʉlye, kʉsɨgɨɨwe kɨna kɨateele ingɨ kʉʉtambʉla itai, <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />kʉtuile anga antʉ nɨshanga amanyɨkile, ingɨ kʉmanyɨkile kʉ antʉ ɨhi anga antʉ nɨakule, kʉnʉ kɨapanga, kɨkʉwa ingɨ shanga kɨsha, <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />kʉinwe anga kʉhʉkilye, ingɨ mahikʉ ɨhi kiloile, kʉinwe anga kɨahimbɨ ingɨ kaagolɨpilye antʉ ɨdʉ, kʉinwe anga kɨagila anga kɨntʉ ingɨ kʉkete maintʉ ɨdʉ.<verse eid="2CO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11" />Anyandʉgʉ itʉ Akolinto kitambʉʉye nʉnyenye shanga kipihɨɨye, hangi ʉsese kʉmʉloilwe nangalu. <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />Anga maona kɨnkwantya kɨhi nɨkakʉsasha kʉleke kʉmʉlowa ʉnyenye, kɨnkwantya nɨkanso kanyu, ʉsese shanga kʉʉleka kʉmʉlowa ʉnyenye. <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />Itɨ gwa kʉmʉɨla anga mɨana ane. Milowe anga ʉsese nɨkʉmʉloilwe.<verse eid="2CO 6:13" /></para>
  <para style="s">Leki ɨkɨhʉmbashʉya nɨ antʉ nɨshanga amʉhʉɨɨe Itunda</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />Mʉleke ɨkɨhʉmbashʉya nɨ antʉ nɨshanga amʉhʉɨɨe Itunda. Itɨɨ, ʉbɨ nʉ ʉza wigombya ne? Nzelya nɨ kiti yihumilene kihanja? <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />Kilisito ʉhumile ne kilɨnga nʉ Shetani? Mʉntʉ nʉmʉhʉɨɨe Itunda ʉkilɨngane nʉyo nɨshanga ʉmʉhʉɨɨe Itunda? <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" />Nyʉmba ang'wi Itunda ikete wilɨngi kɨ nɨ adʉdʉ itunda aʉteele? Ndogoelyo ʉsese kɨ Nyumba ang'wi Itunda nɨ mʉpanga. Anga Itunda ng'wenso naɨʉtambʉe:</para>
  <para style="q1" vid="2CO 6:16">“Kikalania nɨenso,</para>
  <para style="q" vid="2CO 6:16">nʉ kʉgedania nɨenso,</para>
  <para style="q" vid="2CO 6:16">Kʉtula ni Itunda wao,</para>
  <para style="q" vid="2CO 6:16">nɨenso akʉtula antʉ ane.”<verse eid="2CO 6:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="2CO 6:17" />Kʉlʉlo Isekʉlʉ ʉlʉngile hangɨ,</para>
  <para style="q" vid="2CO 6:17">“Hegi mʉng'wao,</para>
  <para style="q" vid="2CO 6:17">mikome nɨenso,</para>
  <para style="q" vid="2CO 6:17">miko kʉamba intʉ niibɨ,</para>
  <para style="q" vid="2CO 6:17">ʉnene kʉmʉsɨngɨɨlya.<verse eid="2CO 6:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="2CO 6:18" />Ʉnene kʉtula nɨ Tata wanyu,</para>
  <para style="q" vid="2CO 6:18">nʉ nyenye mʉkʉtula mɨana ane nɨagoha nawa nɨasʉngʉ,</para>
  <para style="q" vid="2CO 6:18">nene Isekʉlʉ Itunda mʉkola ngulu nɨntambʉe itɨ.”<verse eid="2CO 6:18" /></para>
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />Itɨ gwa, ahʉmbaɨane nɨ nʉmʉloilwe, ɨtule kapewe malago aya ɨhi, ingɨ kʉtemanʉke nɨ maintʉ ɨhi nahumile kʉkanza mɨɨlɨ ni nkolo yitʉ yileke kʉgombeka kʉng'wi Itunda, kʉtule kɨantʉ ang'wi Itunda nʉkɨshiɨ likalo nʉla kʉmʉkʉlya ng'wenso.<verse eid="2CO 7:1" /></para>
  <para style="s">Ʉlowa wang'wa Paʉlo</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />Kʉʉlompa mʉkʉlowe. Shanga kʉmʉgazɨɨye mʉntʉ wɨhi, hangɨ shanga kʉmʉaaye ang'wɨ kʉmʉkongela mʉntʉ wɨhi. <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />Shanga kʉtambʉla itɨ kʉmʉsosha mʉntʉ wɨhi, ingɨ kʉnsoko anga nɨnakondya kʉmʉɨla, kɨna ʉsese kʉmʉloilwe ʉnyenye hangɨ kʉtilɨ kɨntʉ nɨkakʉʉtemanʉla nʉnyenye itule nsha ang'wɨ ʉpanga. <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />Ʉnene Paʉlo nihumile kʉligitya nʉnyenye kʉ ʉhʉɨɨli ʉkʉlʉ, nisanɨɨye nangalu ʉnyenye. Palʉng'wɨ nʉlwago lɨhi naɨkʉkɨɨe, mankomelya nkolo hangɨ ndoilwe nangalu.<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />Napoga naɨkapika pa Makedonia, shanga aɨkʉsupilye. Aɨkʉlemigwe nʉlwago mpande yɨhi, kʉnzɨ wilei, nʉ mʉnkolo yitʉ kʉkete mitumbo. <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />Ingɨ Itunda nʉwɨakomelya nkolo antʉ nɨakatapile, wɨkakʉkomelya nkolo ʉsese apo ʉ Tito naɨwaza. <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />Shanga naɨwaza ʉ Tito du, ingɨ kɨkapantika ngulu naɨkija nʉnyenye mʉmʉkomeeye inkolo. Ng'wenso ʉkʉɨɨe kɨna mʉkete nsʉla akʉmona ʉnene, nɨmʉkatapile, hangɨ nɨmɨhiya kʉnkʉɨɨla, lʉkani ʉlʉ landoeelya nangalu.<verse eid="2CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8" />Ndogoelyo palʉng'wɨ nʉkʉlʉnga ɨbalʉa naɨnʉmʉandɨkɨe amʉsasha mʉhʉshe, ʉnene shanga kʉaalɨka mʉnkolo. Palʉng'wɨ nɨ kɨna mʉkʉhʉsha, nɨngile kɨna mʉkʉhʉsha kitungo ʉdu. <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />Ingɨ itungo ɨlɨ nalowa, shanga kʉnsoko nʉmʉaaye, ingɨ kʉhʉsha kʉng'wanyu yasasha mʉkaɨle isɨgo lanyu nʉkila itʉnʉ. Mʉhʉkilye anga Itunda naɨʉsɨgɨɨe, kʉlʉlo ʉsese shanga kʉmʉtendee anga ʉbɨ wɨhi. <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />Kʉhʉsha anga nʉsɨgɨɨe Itunda yisasha antʉ aleke ʉʉbɨ nʉ kʉgunɨka, hangɨ shanga yɨsasha antʉ alɨke mʉnkolo. Ingɨ ʉhʉshi nʉwɨsakigwa nɨ makani amʉʉnkumbigʉlʉ wɨsasha nsha. <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />Kolwa ʉhʉshi nʉ ʉpumɨe kʉ ʉlowa wang'wi Itunda. Maina mʉkete nsʉla akʉtenda makani nʉmaloilwe Itunda, mahuma kikoola kɨna mɨagila ɨmagazo, hangɨ maʉbɨpɨlwa ʉʉbɨ. Mʉmʉkʉiye Itunda mʉkete nsʉla akʉʉona nʉ kʉona kɨna mʉntʉ nʉkʉgaza ʉkʉpɨsɨɨligwa mʉitakɨwe. Ʉnyenye makamɨnkɨɨlya kɨna shanga mʉgazilye mʉ makani aya ɨhi.<verse eid="2CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 7:12" />Itɨ gwa, nsoko nakʉandɨka balʉa ɨyo shanga aɨnsoko amʉntʉ naɨʉgazilye, ang'wɨ kʉnsoko amʉntʉ naɨʉgazɨigwe. Aɨnandɨkile kʉnsoko yigeeleke pang'wi Itunda anga nɨmipumilye kʉnsoko itʉ. <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />Kʉlʉlo ʉsese kakomya nkolo. Shanga kʉkomya nkolo ʉdu, ingɨ aɨkʉloeigwe nʉ ʉlowa wang'wa Tito naɨʉkete kʉnsoko naɨmʉmʉloeeye ɨnkolo akwe. <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />Ʉnene aɨnʉmʉkʉiye nangulu pang'wakwe, ʉnyenye shanga mʉnihumilye mɨnyala. Mahikʉ ɨhi kʉmʉtambʉɨe ɨtai, naɨnɨmʉkʉlya ʉnyenye kʉngwa Tito yaile lʉkani latai ntilɨ. <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />Nʉ ʉlowa wakwe kʉng'waanyu ingɨ ʉkʉlʉ anga wakɨmbʉke naɨmʉmʉsɨngɨɨye iza nʉ lwijo naɨmʉkete, hangɨ kikʉlyo ikʉlʉ. <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />Niloile nangalu kɨna nɨhumile kʉmʉsania ʉnyenye mʉ makani ɨhi.<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s">Kʉpumya kʉ nkolo nza</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />Itɨ gwa anyandʉgʉ ane, ndoilwe ʉnyenye mʉlɨnge ʉkende ʉwo Itunda nʉakendepile milʉndo nʉwa antʉ nɨamʉhʉɨɨe ʉ Kilisito nɨakʉ Makedonia. <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />Palʉng'wɨ nɨ mageng'wa angulu nʉlwago nɨɨkɨɨla, ingɨ aɨaloilwe lʉkʉlʉ, palʉng'wɨ kɨna aɨahimbɨ kʉkɨlɨnkɨɨla, nɨanso aɨakete nkolo nza. <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />Kʉmʉɨla kʉlʉ kʉʉlʉ kɨna aɨapumilye maintʉ ɨdʉ kʉkɨla ingulu yao. Hangɨ aɨapumilye kʉ ʉlowa wao, kʉtilɨ ʉmʉntʉ naɨ ʉatambʉɨe, <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />ɨkakinena kʉagombye kitʉmania nʉsese mʉmʉlɨmo ʉwʉ nʉwakʉaɨɨlya antʉ ang'wi Itunda nɨakolɨ kʉ kɨsalɨ ka Yelusalemu. <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />Aɨapumilye kʉkɨla naɨkʉsɨgɨɨe, nɨanso ɨkandya kipumya hanza kʉng'wi Isekʉlʉ, sʉnga ɨkipumya hangɨ kʉng'witʉ, anga Itunda nʉloilwe. <verse eid="2CO 8:5" /><verse number="6" style="v" sid="2CO 8:6" />Kʉlʉlo, kɨkaminena ʉ Tito naiwandilye mʉlɨmo nʉwanso, waze wamʉaɨɨlye mʉkodeelye mʉlɨmo ʉwʉ nʉwa ʉlowa mʉng'wanyu <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />Ʉnyenye mʉkete maintʉ ɨhi. Mʉkete ʉhʉɨɨli nʉ ʉhumi nʉ ʉlɨngi ni ngulu yɨhi nɨyakitʉma makani nɨmaza, nʉ ʉlowa wanyu kʉng'witʉ. Kʉlʉlo kʉsɨgile mʉtule mɨakamatɨku nɨ nkolo nza mʉ mʉlɨmo ʉwʉ nʉwa ʉlowa.<verse eid="2CO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8" />Shanga kʉmʉsinja, ingɨ ndoilwe kʉmʉlagɨɨla antʉ ang'wɨ nɨakete ngulu niyakʉaɨɨlya nɨhume kʉlɨnga ʉlowa wanyu nʉwatai wɨʉlɨ. <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />Ndogoelyo mʉlɨngile ʉkende Isekʉlʉ witʉ Yesʉ Kilisito ʉmʉkendepile ʉkende wakwe, mʉlɨngile kɨna aɨʉkete maintʉ ɨhi, wakitendisa mʉhimbɨ kʉnsoko anyu, ingɨ kʉkɨɨla ʉhimbɨ wakwe wamʉgolɨpye ʉnyenye.<verse eid="2CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10" />Itɨ gwa ndoilwe kʉmʉɨla kɨna, yɨnonee itungo ɨlɨ kʉmaɨɨlya makani ayo naɨ mandilye ʉng'wakazo. Ʉnyenye aɨmandilye kitʉma itɨ. <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />Itɨ gwa, anga naɨmʉkete nkolo akʉaɨɨlya, ʉʉgwa pumyi anga nʉkete ʉmʉntʉ, kondeelyi ʉmʉlɨmo ʉwʉ kʉnkolo anga naɨmandilye. <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />Kʉnsoko angaze mʉntʉ ʉkete nkolo akʉaɨɨlya, Itunda wɨsɨngɨɨlya kɨntʉ kɨhi nʉʉhumile kʉpumya, shanga wɨgoza kɨntʉ mʉntʉ nɨmʉgila.<verse eid="2CO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 8:13" />Ʉnyenye shanga mʉtakɨwe magigwe nʉ kʉtula nʉmʉligo nʉwa kʉaaɨɨlya antʉ nɨangɨɨza, itakɨwe mʉleke kikɨlankɨla. <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />Itungo ɨlɨ mʉkete maintʉ ɨdʉ kʉkɨlɨnkɨɨla mʉhumile kʉaaɨlya antʉ nɨagila. Ingɨ nɨenso anga alije maintʉ ɨdʉ kʉkɨlɨnkɨɨla, ahumile kʉmʉaɨɨlya ʉnyenye anga mʉhiɨlwe, kʉlʉlo shanga mʉkikɨlankɨla, <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />anga Wandɨkwa wang'wi Itunda nʉwandɨkile kɨna, “Naɨ wilingile yɨdʉ aɨmʉgila anga ʉsago, Nʉyo naɨwilingɨɨe pikeehʉ shanga wɨkakepelwa.”<verse eid="2CO 8:15" /></para>
  <para style="s">Tito nɨahʉmbaʉya akʉlagɨɨligwa kʉ Kolinto</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />Nʉmʉlʉmbile Itunda naɨʉmʉpee ʉ Tito nkolo akʉmʉaɨɨlya ʉnyenye anga nɨnkete ʉnene. <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />Shanga kɨna ʉ Tito aɨʉgombile ilompi litʉ, ingɨ aɨʉloilwe kʉmʉaɨɨlya kʉpikɨɨla kʉlamʉla ʉng'wenso kɨza kʉng'wanyu. <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />Palʉng'wɨ nʉ Tito kʉʉmʉlagɨɨlya mʉntʉ ʉng'wɨ nʉwa lʉkumo lʉza mʉ milʉndo nʉwa antʉ nɨamʉhʉɨɨe ʉ Kilisito kʉ mʉlɨmo wakwe nʉwa kʉatanantɨlya antʉ Nkani Nza. <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />Shangaʉ du, nʉwanso ʉhoilwe nʉ milʉndo nʉwa antʉ nɨamʉhʉɨɨe ʉ Kilisito wakʉɨlanie nʉ sese mʉ mʉhɨnzo itungo nɨkʉʉtala mʉlɨmo witʉ ʉwʉ nʉwa ʉlowa, mʉlɨmo nikʉitʉma kʉnsoko aʉkʉlʉ wang'wa Isekʉlʉ Itunda nʉkʉlagɨla isɨgo litu niza.<verse eid="2CO 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 8:20" />Shanga kʉloilwe kʉmelwe nʉ mʉntʉ mʉwimɨɨli witʉ nʉwakʉtala maintʉ napumigwe nɨantʉ kʉ nkolo nza. <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />Ʉsese shanga kʉloilwe kitʉma iza pang'wi Isekʉlʉ du, ingɨ nʉ mʉantʉ ga.<verse eid="2CO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22" />Itɨ gwa, kʉʉmʉlagɨɨlya mʉluna witʉ mʉngɨɨza palʉng'wɨ nɨaluna nɨanso, mʉntʉ ʉyʉ kamʉgemile nkʉa yɨdʉ nʉkʉmʉona kɨna ʉkete nkolo nza nakʉaɨɨlya antʉ angɨɨza, nɨtungo ɨlɨ ga ʉkete nkolo nza nakʉaɨɨlya ɨantʉ kʉnsoko ʉmʉhʉɨɨe ʉnyenye. <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />Anga ɨze ʉkolɨ mʉntʉ ʉloilwe kʉmʉlɨnga ʉ Tito ingɨ mɨane, kitʉmania mʉlɨmo kʉnsoko akʉaɨɨlya ʉnyenye, hangɨ anga ɨze ʉkolɨ mʉntʉ ʉloilwe kʉlɨnga anyandʉgʉ awa nɨakʉɨlanilye, antʉ nɨanso ingɨ amilʉndo nʉwa antʉ nɨamʉhʉɨɨe ʉ Kilisito, nɨenso ɨmʉkʉlya ʉ Kilisito. <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />Kʉlʉlo, ʉlowa wanyu wingeeleke kʉng'wao, ingɨ milʉndo nʉwa antʉ nɨamʉhʉɨɨe ʉ Kilisito alɨnge kɨna kilolya kʉnsoko anyu.<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="s">Kʉaɨɨlya antʉ nɨamʉhʉɨɨe ʉ Kilisito</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />Kʉlʉ kʉʉlʉ nɨmʉgila anga nsoko kʉmʉandɨkɨla mʉlɨmo nʉwa kʉaɨɨlya antʉ ang'wi Itunda nɨakolɨ kʉ Yelusalemu. <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />Kʉnsoko nɨngile nkolo nza nɨmʉkete nakʉaɨɨlya, hangɨ ʉnene kiketa kʉnsoko anyu kʉ lʉkani nʉlanso pa antʉ nɨakʉ Makedonia. Aɨnɨatambʉɨe, “Anyadʉgʉ itʉ nɨakʉ Akaya kʉpuma ng'wakazo aɨihambile kʉpumya.” Ʉʉgwa, nkolo anyu nɨza nakʉpʉmɨlya asambɨɨlya antʉ ɨdʉ nangalu. <verse eid="2CO 9:2" /><verse number="3" style="v" sid="2CO 9:3" />Ingɨ nɨalagɨɨye nɨ anyandʉgʉ itʉ, Tito nɨɨakwe abɨɨlɨ. Ingɨ kikʉlya kʉng'witʉ kʉaɨɨlya wanyu ʉleke kʉtula nkani ntilɨ, ingɨ ilɨngɨke kɨna mɨhambile kʉhangʉlya anga naɨntambʉe. <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />Anga nɨze kʉng'waanyu palʉng'wɨ nɨantʉ akʉ Makedonia kʉhange shanga mɨhambile, pang'wanso ʉsese kʉ ʉhung'wa mɨnyala kʉnsoko aɨkʉmʉhʉɨɨe nangalu. Nʉnyenye ga mʉkʉhung'wa mɨnyala. <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />Kʉlʉlo, naona iza kʉalompa anyandʉgʉ itʉ awa akʉtongeele kɨza kʉng'wanyu, ahume kʉnɨng'anɨɨlya kɨpegwa kanyu kɨkʉlʉ naɨmʉlapile kʉpumya. Nɨnyenso yigele kɨna ingɨ kɨpegwa aɨkɨpumigwe kʉnkolo ɨng'wɨ shanga kʉsingigwa.<verse eid="2CO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />Kɨmbʉki ntambʉ ɨyɨ, mʉntʉ nɨmʉkata wɨpʉɨla mʉnkonzele nʉ mʉntʉ nɨ mʉsimbi wɨpʉlaa wɨdʉ. <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />Mʉntʉ wɨhɨ nʉwapumye anga nʉsɨɨgɨe mʉnkolo akwe, waleke kʉpumya waze ʉhininae ang'wɨ kʉsingigwa, ndogoelyo Itunda wɨmʉlowa mʉntʉ nʉwɨpumya kʉʉlowa. <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />Itunda ʉhumile kʉmʉpa kʉkɨlɨnkɨɨla ayo nɨmʉtakile, mahikʉ ɨhi ɨze mʉkete maintʉ ɨhi nɨmʉkʉhiya, nɨ itɨ mʉlongoleke kiaɨɨlya mʉ mɨlɨmo nɨ mɨza. <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />Wandɨkwa wang'wi Itunda wandɨkile kɨna,</para>
  <para style="q" vid="2CO 9:9">“Ʉpumilye yɨdʉ,</para>
  <para style="q" vid="2CO 9:9">ʉapee ahimbɨ,</para>
  <para style="q" vid="2CO 9:9">makani aʉkende wakwe ɨsaga ɨkalɨ na kalɨ.”<verse eid="2CO 9:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="2CO 9:10" />Itunda wɨmʉpeza mʉminzi mbeʉ waminze nʉ kʉmʉpa indya, kʉlʉlo ʉkʉmʉpeza nʉ nyenye ga mbeʉ nɨmʉiloilwe, hangɨ ʉkʉipumisa yikʉle mʉhume kʉpʉla ntenya kʉ ʉkende wanyu. <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />Itunda ʉkʉmʉgolɨpya maintʉ ɨdʉ mʉtule mɨakende mahikʉ ɨhi, ingɨ antʉ ahume kʉmʉlʉmba Itunda kʉnsoko aɨpegwa yanyu nɨakʉisɨngɨɨlya kʉpuma kʉng'witʉ. <verse eid="2CO 9:11" /><verse number="12" style="v" sid="2CO 9:12" />Kʉitɨ mʉlɨmo ʉwʉ nɨmʉkitʉma shanga ʉkʉaɨɨlya antʉ ang'wi Itunda du, ingɨ ikʉsasha antʉ ɨdʉ amʉsongelye Itunda. <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />Kʉkɨɨla wigeleki nʉwa mʉlɨmo witʉ ʉwʉ, antʉ ɨkamʉkʉlya Itunda kʉ ʉhʉɨɨli wanyu kʉ Nkani Nza kʉnsoko ang'wa Kilisito nɨ mʉkʉtanantya mʉantʉ, hangɨ kʉnsoko aʉkende wanyu nɨmɨapeza enso nɨ antʉ ɨhi. <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />Kʉlʉlo akʉmʉlompeela ʉnyenye kʉ nkolo aʉlowa kʉnsoko aʉkende nʉwatai nɨmʉkembetilwe ni Itunda. <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />Kʉmʉlʉmbe Itunda kʉnsoko akɨpegwa kakwe nɨshanga ka kʉganʉlwa.<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s">Paʉlo ʉkʉilongoola mʉlɨmo wakwe</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />Itɨ gwa, ʉnene Paʉlo ɨza nɨmʉpolo nɨkine nʉnyenye, ingɨ nɨmʉtaki nɨnkolɨ kahelo nʉnyenye, kʉmʉlompa kʉkɨaisa nʉ ʉkende wang'wa Kilisito. <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />Nʉmʉlompile leki kʉntashi itungo nɨmpembilye kʉng'wanyu, kʉnsoko kʉhuma ntule nɨmʉtaki kʉ antʉ nɨakʉsɨgɨe kɨna kishiɨ anga antʉ nɨatyatile intendo niya mihɨɨ. <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />Palʉng'wɨ nɨ kɨna kishiɨ mihɨɨ, ingɨ shanga kʉikʉa mbita akɨʉntʉ. <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />Ndogoelyo yɨgɨ nɨkʉikʉɨla shanga niya kɨʉntʉ, ingɨ ngulu yang'wa Itunda nɨyihumile kʉgazanja ngulu yɨhi. Kʉʉgazanja masɨgo ɨhi naʉteele, <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />nʉkʉbalansania inkwaatya yɨhi niya anya lʉgoha nahutanile nʉ ʉmanyisi wang'wi Itunda, kʉ ʉkaɨla masɨgo nʉkʉamanyisa atule nʉ lwijo kʉng'wa Kilisito. <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />Anga mʉkondanɨle kʉtula nʉ lwijo kʉng'wa Kilisito mʉ maintʉ ɨhi, ʉsese kihambile kʉpɨsɨɨlya antʉ ɨhi nɨagila lwijo.<verse eid="2CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7" />Ʉnyenye magozi makani nɨ mʉmaine kʉ miho anyu. Itɨɨ, ʉkolɨ mʉntʉ wɨhi nʉsɨgɨe kɨna nʉwanso mʉntʉ wang'wa Kilisito? Itɨ gwa, nʉwasɨgɨle kɨna nʉsese ga kɨantʉ ang'wa Kilisito anga ʉng'wenso nɨ mʉntʉ wang'wa Kilisito. <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />Shanga kʉhung'wa mɨnyala kikʉlya kʉ ʉkʉlʉ nɨmpewe ni Isekʉlʉ, kʉnsoko ʉhumi nʉwanso shanga ʉkʉmʉlimɨlya ingɨ ʉkʉmʉzenga mʉ ʉhʉɨɨli wanyu. <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />Shanga ndoilwe mʉsɨge kɨna kʉbalʉa yane kʉmʉsasha mogope. <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />Antʉ ang'wɨ ɨlʉnga, “Balʉa yang'wa Paʉlo ingɨ ntaki hangɨ nkaku, nɨkɨpalʉng'wɨ nʉsese ingɨ mʉntʉ nʉmʉgila anga ngulu, napaga nʉkʉligitya inkani yakwe yituile anga sha kɨntʉ.” <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />Mʉntʉ nʉtambʉe itɨ bahu wakɨmbʉke kɨna ayo naɨkʉandɨkile mʉbalʉa naɨkʉmolɨ kʉlɨ shanga yihutanile nɨ makani nɨkʉitʉma itungo nɨkine nʉnyenye.<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />Shanga kʉutula ang'wɨ kɨmpyana nɨantʉ nɨikʉlya ɨenso. Antʉ nɨanso apʉngʉ kʉnsoko itendisa kɨna enso ngele akʉgemeelya, antʉ nɨigemeelya enso kʉ enso igeeleka kɨna apʉngʉ <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />Ingɨ ʉsese shanga kʉʉkɨlɨnkɨla kikʉlya, kikʉlya kʉng'witʉ yikʉsiga kʉ ngele amʉlɨmo naɨkʉpewe ni Itunda, mʉlɨmo nʉwanso, wʉwo kʉitʉma kʉng'wanyu. <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />Itungo naɨkʉzile kʉng'wanyu ʉsese shanga aɨkʉkɨlɨnkɨe kikʉlya. Ʉsese aɨkʉtongee kɨza kʉng'wanyu kɨkamʉletela Nkani Nza nɨyang'wa Kilisito. <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />Itɨ gwa, ʉsese shanga kʉʉkɨlɨnkɨɨla kikʉlya kʉ mʉlɨmo nɨitʉmile antʉ nɨangɨza kʉkɨla ngele naɨkʉpewe. Ingɨ kʉsʉmbɨɨye kɨna ʉhʉɨɨli wanyu kʉng'wi Itunda ʉlongeelekile, nʉ mʉlɨmo witʉ kʉng'wanyu ʉkʉtula ʉkʉlʉ anga nʉloewe Itunda. <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />Pang'wanso kʉhumile kʉtanantya Nkani Nza mʉ mahɨɨ mangɨɨza nakʉlɨ nʉnyenye, nɨshanga kʉhumile kikʉlya kʉmʉlɨmo nɨitʉmile antʉ angɨɨza. <verse eid="2CO 10:16" /><verse number="17" style="v" sid="2CO 10:17" />Ingɨ anga Wandɨkwa wang'wi Itunda nʉwandɨkilwe, “Mʉntʉ wɨhi nʉloilwe kikʉlya, wikʉlye kʉ makani nʉwitʉmile Isekʉlʉ.” <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />Nʉgombekile shanga mʉntʉ nʉwikʉlya ng'wenso, ingɨ mʉntʉ nʉwɨkʉligwa ni Isekʉlʉ.<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s">Paʉlo nɨ Itʉmi aʉteele</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />Bahu aza mʉgimye iniino, palʉng'wɨ nɨ kɨna nɨmʉpʉngʉ. Mʉgimye iniino. <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />Nʉmʉkee ikʉlʉ, ingɨ ʉkeli wane ʉpumile kʉng'wi Itunda, ndogoelyo ʉnyenye mɨhanga mʉnanso nʉwakɨlɨ kʉmanya mitʉnja, nʉnene nʉmʉlongeeye mʉgoha ʉng'wɨ du ingɨ Kilisito. <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />Ingɨ nogopile kɨna, anga ɨnzoka kʉ ʉhʉgu wakwe ɨkamʉkongela ʉ Hawa, masɨgo anyu ahumile kʉpɨʉlwa, maleka ʉhʉɨɨli wanyu nʉwa tai kʉng'wa Kilisito. <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />Ndogoelyo mʉntʉ wɨhi anga waze wamʉtanantye mpola yang'wa Yesʉ nʉ wɨsa nʉyʉ nɨkʉmʉtanantilye, ʉnyenye mʉkʉsɨngɨɨlya kʉ mɨkono ɨbɨɨlɨ. Hangɨ mʉmʉgombile Ng'wahʉ Ng'welʉ wɨsa nʉyo naɨkʉmʉtanantɨɨye ang'wɨ mpola yisa ni Nkani Nza naɨkʉmʉtanantɨɨye ʉnyenye.<verse eid="2CO 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5" />Shanga nsɨgile kɨna ʉnene nɨmʉniino kʉkɨla “itʉmi nɨakʉlʉ.” <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />Palʉng'wɨ nɨ kɨna shanga nihumile kʉtambʉla kɨsa, ingɨ nɨngile makani ɨdʉ, ikani ɨlɨ kalɨɨka kɨhenga kʉng'wanyu, matungo ɨhi hangɨ kʉnzɨla yɨhi.<verse eid="2CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7" />Ʉnene aɨntanantilye kʉng'wanyu Nkani Nza nɨyang'wi Itunda shanga mpegwe kɨnyamʉlɨmo kɨhi, aɨnɨninompilye ʉnyenye mʉhume kʉkʉligwa. Itɨɨ, aɨntendile ʉbɨɨ ne? <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />Naɨkʉmitʉmɨla ʉnyenye mʉlɨmo, anɨsɨngɨɨlya mpia kʉpuma milʉndo ʉngɨɨza nʉwa antʉ nɨamʉhʉɨɨe ʉ Kilisito. Aɨyihanga kʉahegelya maintʉao nihume kʉmʉaɨɨlya ʉnyenye. <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" />Ʉnene naɨkɨpalʉng'wɨ nʉnyenye apo naɨntakile mpia shanga aɨnɨmʉnyoma mʉntʉ wɨhi, ahʉɨɨli ɨanyu kʉpuma kʉ Makedonia ɨndetela maintʉ ɨhi nɨndoilwe. Aɨnɨmʉkendegeli nangalu ndeke kʉmʉlemeelya kʉmpyani ɨhi, hangɨ kʉlongoleka kʉtulaʉʉ. <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" />Kʉtilɨ anga mʉntʉ mʉ kɨsalɨ ka Akaya nʉhumile kʉngilya kikʉlya kikani nɨlanso, ntambʉe itɨ kʉnsoko atai ang'wa Kilisito nɨmolɨ mʉng'wane. <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />Nɨkɨ kʉtambula itɨ, Itɨɨ kʉnsoko shanga nʉmʉloilwene ʉnyenye? Itunda ʉlɨngile kina nʉmʉloilwe.<verse eid="2CO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12" />Kʉlongoleka kitʉma anga nɨkitʉma itungo ɨlɨ, ingɨ ndeke kʉapa lyoma awo nɨakʉduma nkikʉlya kɨna agwe akituma mʉlɨmo anga ʉsese. <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />Ndogoelyo, antʉ nɨanso ingɨ itʉmi aʉteele, nɨɨkongela mʉlɨmo wao nʉkisania kɨna nɨanso itʉmi atai nɨang'wa Kilisito. <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />Mʉleke kʉkʉɨlwa kʉng'witʉ. Kʉnsoko shetani nʉyo witendisa kɨna nʉng'wenso malaɨka nʉwa nzelya. <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />Kʉlʉlo shanga ikani nʉlakʉkʉɨlwa anga ɨtule nɨ itʉmi akwe nɨanso akisanya kɨna itʉmi nɨagombekile pang'wi Itunda. Mpeloao akʉpantika anga nɨatendile.<verse eid="2CO 11:15" /></para>
  <para style="s">Lwago nʉla Mitʉmi Paʉlo</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />Kʉtambʉla hangɨ mʉntʉ wɨhi waleke kʉmona kɨna nɨmʉpʉngʉ. Ingɨ anga mʉmone itɨ, ʉʉgwa, nɨhoeeli anga nɨmʉpʉngʉ ingɨ nʉnene mpantɨke kaniino nikakiketela. <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />Makani akikʉlya nɨkʉmatambʉla itungo ɨlɨ shanga apumile kʉng'wi Isekʉlʉ, ingɨ ingɨ ikani nɨlanso lɨlo kiloelya, kʉtambʉla anga mʉntʉ nɨ mʉpʉngʉ. <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />Kʉlʉlo antʉ ɨdʉ ikʉlya kʉmpyani akɨʉntʉ, nʉnene ga kikʉlya. <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />Ʉnyenye mʉkete mahala, yɨyo nsoko mɨgimya ʉʉpʉngʉ nɨakʉtenda antʉ. <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />Mɨgimya nʉ mʉntʉ ga nʉwɨmʉtenda ʉnyenye mɨatʉʉng'wa, nʉ mʉntʉ nʉwɨmʉhegelya maintʉ anyu nʉ mʉntʉ nɨɨlɨla kʉ mɨgongo a antʉ nʉ mʉntʉ nʉwikʉlya nʉ mʉntʉ nʉwɨmʉtʉkɨla! <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />Nihumilwe mɨnyala kʉlʉnga kɨna ʉsese aɨkɨagila ngulu kitʉma makani aya.</para>
  <para style="p" vid="2CO 11:21">Anga ɨze ʉkolɨ mʉntʉ wɨhi nʉʉkʉgema kikʉɨɨlya, nʉnene ga kʉgema kikʉlya, ingɨ kʉtambʉla anga mʉntʉ nʉmʉpʉngʉ. <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />Itɨɨ, nɨanso Aebulania ne? Nʉnene ga nɨ Mʉebulania. Itɨɨ, nɨanso Aisilaeli ne? Nʉnene ga nɨ Mʉisilaeli. Nɨanso a wileli wang'wa Ibulahimʉ ne? Nʉnene ga nɨ wileli wang'wa Ibulahimʉ. <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" />Nɨanso anyamʉlɨmo ang'wa Kilisito ne? Nʉnene ga nɨ mitʉmi ang'wa Kilisito. itungo ɨlɨ ntambʉle anga kɨmonyele, ʉnene nɨ mitʉmi wang'wa Kilisito kʉkɨla nɨanso. Ʉnene nitʉmile mʉlɨmo ʉkaku nangalu, nikae migeleza nkʉa yɨdʉ tai, nkʉilwe nkʉa yidʉ tai hangɨ nkʉa yidʉ nahimile ʉlʉngʉ kʉkɨla nɨanso. <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />Nkʉa itaano nkʉilwe nkotya makʉmi ataatʉ na kenda nɨ Ayahudi. <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" />Aɨnkʉilwe mɨlanga kataatʉ nɨ Alumi, aɨnkʉilwe magwe kang'wɨ, aɨmbunɨkɨwe nɨmeli kataatʉ mʉlʉzɨ, mʉng'wanso mʉlʉzɨ nɨkelya ʉtikʉ nʉ ngʉng'wɨ. <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" />Mʉmɨhɨnzo ane nkʉa yidʉ mponee ʉneneaʉ kʉtalwa nɨ mazɨ, mponee ʉneneaʉ kʉbʉlagwa nɨa abʉlagani, nagigwe nɨ Ayahudi ɨane, nagigwe nɨ antʉ nɨshanga Ayahudi, nagigwe mʉwɨɨ nʉ mʉkɨsalɨ, lwago nʉla mʉlʉzɨ nʉlʉkʉlʉ, nagigwe nɨantʉ nɨakitendisa kɨna amʉhʉɨɨe ʉ Kilisito. <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />Nitʉmile mɨlɨmo nʉkaga, nkʉa yɨdʉ shanga nkɨɨwe ʉtʉlo, nahumilwe ɨnzala nɨ nyota, nkʉa yɨdʉ aɨmbʉiye indya nʉkishiɨ mʉmpepo ɨze nɨmʉgila myenda akikɨngɨsɨɨlya nɨ mpepo. <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />Hangɨ, kʉleka makani maʉya nɨdʉ, mahikʉ ɨhi aɨnɨkendaasɨga milʉndo nʉwa antʉ ɨhi nɨamʉhʉɨɨe ʉ Kilisito. <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />Anga ɨze mʉntʉ wɨhi mʉgila anga ngulu, nʉnene ga kiona nɨmʉgila anga ngulu, anga mʉntʉ wɨhi wasakigwe kitʉma mʉlandʉ, ʉnene nɨbɨpɨlwa nangalu.<verse eid="2CO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30" />Anga insinje kikʉlya, itɨgwa, kikʉlya naʉʉgila ngulu wane. <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />Itunda hangɨ Tata wang'wi Isekʉlʉ witʉ Yesʉ, nʉtakɨwe kʉkʉligwa ɨkalɨ na kalɨ, ng'wenso ʉlɨngile kɨna shanga kʉtambʉla ʉteele. <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" />Naɨnkolɨ kʉ Damesiki, mʉkʉlʉ nʉwa kɨsalɨ, naɨmʉhemba wamʉtemi Aleta, aɨwɨlindɨɨla mʉmpita nʉwa kɨsalɨ ingɨ ahume kʉmamba. <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />Ingɨ, nɨkasɨmɨɨligwa mʉ kɨsela kɨkʉlʉ kʉkɨɨla lyoma naɨlɨkolɨ mikiligo, kʉlʉlo nɨkamʉtigana.<verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s">Mʉloto nʉ Ʉkunʉkʉlwa wang'wa Paʉlo</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />Ʉnene kikʉlya, palʉng'wɨ nɨkɨna shanga yɨnonee. Ingɨ itungo ɨlɨ kʉtambʉla kʉkɨɨla mʉloto nʉ ʉkunʉkulwa nɨmpewe ni Isekʉlʉ. <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />Nʉmʉmanyile mʉntʉ ʉng'wɨ nɨmʉhʉɨɨli, myaka ikʉmi na inɨɨ nɨkɨile aɨʉkenkilwe nʉkʉtalwa kigʉlʉ kʉng'wi Itunda. Shanga nɨngile kɨna aɨʉkolɨ kɨmʉɨlɨne ang'wɨ kɨnkolo, ingɨ Itunda ng'wenso ʉlɨngile. <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />Kʉsʉkɨɨla kʉtambʉla, nɨngile kɨna mʉntʉ nʉwanso aɨʉkenkilwe nʉkʉtalwa kigʉlʉ kʉng'wi Itunda. Ingɨ shanga nɨngile ʉkolɨ kʉng'wanso kɨmʉɨlɨne ang'wɨ kɨnkolo, ingɨ Itunda ng'wenso ʉlɨngile. <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />Kʉng'wanso wɨkija makani nɨshanga ahumile kʉganʉlwa, kʉtilɨ mʉntʉ nʉgombigwe ni Itunda kʉtambʉla. <verse eid="2CO 12:4" /><verse number="5" style="v" sid="2CO 12:5" />Itɨ gwa, kiketela mʉntʉ nʉwɨhanga nʉwanso, ingɨ shanga kikʉlya ʉnene, ingɨ kikʉlya kʉʉgila ngulu wane. <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />Anga azandowe kikʉlya shanga aza nzetambʉla anga mʉntʉ nɨmʉpʉngʉ, kʉnsoko azanzetambʉla tai ntile. Itungo shanga kʉlongoleka kikʉlya, kʉnsoko shanga ndoilwe mʉntʉ wansɨgɨɨle kɨna nɨmʉza kʉkɨla nʉkʉmona kitʉma ang'wɨ kija nɨkʉtambʉla.<verse eid="2CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7" />Ingɨ ʉ Paʉlo wɨkalʉnga, kʉnsoko makani aya nɨmakʉlʉ naɨndotigwe aleke kʉnsasha nɨkete nangalu, aɨmbaaigwe mʉmʉɨlɨ anga lija lɨnihomile, mʉntʉ wang'wa shetani nʉwɨnaja ndeke kiketa kʉkɨlɨnkɨɨla. <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />Nkʉa itaatʉ aɨnʉminenile Isekʉlʉ wanihegelye ʉlwago ʉlʉ. <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />Ingɨ Isekʉlʉ wɨkambɨla, “Ʉkende wane ʉkondile, kʉnsoko mʉntʉ anga waʉlye ingulu, papo ʉhumi wang'wi Itunda wɨmʉkondanɨlya nangulu.” Itɨ gwa, ingɨ iza nangalʉ kiketela ʉgila ngulu wane ingɨ ʉhumi wang'wa Kilisito wishiɨ mʉng'wane. <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />Kʉlʉlo ndoeeigwe nʉ ʉgila ngulu nʉ kʉtʉkɨlwa nʉ wagigwi nʉ lwago nʉ ʉlya intʉ kʉnsoko ang'wa Kilisito. Kʉnsoko anga ntule nɨmʉgila ngulu, papo nɨtula nɨmʉnya ngulu.<verse eid="2CO 12:10" /></para>
  <para style="s">Woa wang'wa Paʉlo kʉ Kolinto</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />Naina nɨmʉpʉngʉ, ingɨ ʉnyenye mʉnsakilye ntule itɨ. Ʉnyenye aza mʉtakɨwe kʉnganʉla niiza. Ndogoelyo, palʉng'wɨ kɨna ʉnene shanga kɨntʉ, nkʉa yɨhi ʉnene shanga nɨmʉniino kʉkɨla “itʉmi nɨakʉlʉ.” nɨanso. <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" />Naɨkipalʉng'wɨ nʉnyenye aɨnɨmʉgimyi nʉkitʉma mɨʉkʉɨɨlwa niilɨngasɨɨlyo nɨyilagɨɨe kɨna ʉnene nɨ mitʉmi. <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />Kɨntʉ kɨɨ naɨmʉkepewe kʉkɨla milʉndo nʉwa antʉ nɨangɨza nɨamʉhʉɨɨe ʉ Kilisito, kʉhita kʉlompa kɨntʉ kʉng'wanyu? Anga ɨze lɨlo igazo lane, kʉlʉlo kikani nɨlanso ndeki nakanda.<verse eid="2CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14" />Itungo ɨlɨ nɨhamba kɨza kʉng'wanyu nkʉa akataatʉ, shanga kʉhiya mʉmpe kɨntʉ kɨhi. Ndogoelyo nɨkʉduma shanga nsao yanyu, ingɨ kʉmʉduma ʉnyenye. Kʉnsoko ɨza ntendo aleli kʉaɨkɨlya kɨʉto anaao, shanga ana kʉaɨkɨlya kɨʉto aleliao. <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />Kʉlʉlo nkete ʉlowa kʉtʉmɨla kɨntʉ kɨhi nɨnkete kʉnsoko anyu, hangɨ kɨpumya ʉnene kʉnsoko anyu. Itɨɨ, anga itule ʉlowa wane ʉkʉlʉ kʉng'wanyu, ʉlowa wanyu ʉkʉkepane kʉng'wane?<verse eid="2CO 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 12:16" />Itɨ gwa, mʉkʉgomba kɨna shanga aɨnʉmʉlemeeye. Ingɨ mʉntʉ mʉngɨza ʉhumile kʉlʉnga, “Kʉnsoko ʉ Paʉlo mʉhʉgʉ, ʉmʉpembeseeye nʉkʉmʉkonga.” <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" />Itɨɨ, ʉnene ndɨɨe mʉ mɨgongo anyu kʉkɨɨla mʉntʉ wɨhi naɨnʉmʉlagɨɨye kʉng'wanyu? <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />Ʉnene aɨnʉminenile ʉ Tito, nɨkamʉlagɨɨlya kʉng'wanyu nʉ mɨitʉ mʉngɨɨza. Itɨɨ, ʉ Tito wɨkalɨla mʉ mɨgongo anyune? Itɨɨ, shanga mʉlɨngile kɨna ʉsese kɨtongwa nʉ ng'wahʉ ʉng'wɨ nʉ kitʉmania?<verse eid="2CO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19" />Mʉhumile kʉsɨga kɨna itungo ɨlɨ ʉsese kainikoola pang'wanyu. Ingɨ, kʉtambʉla makani aya pang'wi Itunda, ɨze kʉkamɨnkanile nʉ Kilisito. Makani aya ɨhi anyandʉgʉ ane, kʉnsoko akʉmʉkomelya nkolo ʉnyenye. <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />Nogopile, anga nɨze kʉng'wanyu kʉmʉhanga nɨshanga nɨndoilwe nʉmʉhange, nʉnene ga kʉtula anga nɨshanga mʉloilwe ʉnyenye. Nogopile nihumile kʉhanga mʉkete wilei nɨ nkolo mbɨ ni ikʉo nʉ wikʉngʉmi nʉ kisongeela nʉ wiketi nʉ wikʉlyi nʉ minyomo. <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />Nogopile nɨnzile hangɨ Itunda wane ʉkʉnsasha mbʉlye nɨkakʉtambʉla pang'wanyu, ʉnene nɨkadʉmɨnkɨla kʉona antʉ ɨdʉ nɨitʉmile mɨlandʉ. Ingɨ shanga ilile itʉnʉ, kʉnʉ akɨlɨ akosi alongolekile kigoolya nʉ ʉsambo.<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="s">Paʉlo ʉkʉmaɨɨlya kʉahʉgʉlya nʉ kʉalaga</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />Ɨyɨ ɨkʉtula nkʉa akataatʉ ʉnene kɨza kʉng'wanyu, Wandɨkwa wang'wi Itunda wandɨkilwe kɨna, “Ʉsemelwa wɨhi ʉkʉlamʉlwa kʉ ʉkʉɨɨli nʉwa antʉ abɨɨlɨ ang'wɨ ataatʉ.” <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />Nakondilye kʉmʉɨla, naɨkine nʉnyenye nkʉa akabɨɨlɨ, nitungo ɨlɨ ninkolɨ kʉlɨ kʉmʉɨla hangɨ. Anga nɨze shanga kʉaaisɨɨlya antʉ ɨhi nɨatendile ʉbɨɨ nʉkʉhita kila itʉnʉ nɨantʉ nɨangɨza. <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />Mʉloilwe kʉkamɨnkɨɨligwa kɨna ʉ Kilisito ʉkʉtambʉla mʉng'wane. Kilisito shanga mʉgila anga ngulu, ingɨ ng'wenso ʉkete ngulu niyʉtʉma mɨlɨmo mʉng'wanyu. <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />Palʉng'wɨ nɨ kɨna ʉ Kilisito aɨʉkomilwe mʉmʉsalaba kʉnsoko aʉgila ngulu, ingɨ itungo ɨlɨ mʉpanga kʉ ʉhumi wang'wi Itunda. Nʉsese ga mʉʉlya ngulu witʉ kʉkamɨnkanile nʉ Kilisito, ingɨ kɨapanga kʉ ʉhumi wang'wi Itunda kʉnsoko anyu.<verse eid="2CO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5" />Ikolenkeelyi ʉnyenye mʉhume kʉlɨnga kɨna tai mʉhʉɨɨe. Mikolye ʉnyeye. Itɨɨ, shanga mʉlɨngile ne kɨna ʉ Kilisito Yesʉ ʉmolɨ mʉng'wanyu? Ang'wɨ shangaʉ, ʉnyenye maleng'wa kʉtula anga nʉloilwe nʉwanso. <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />Ingɨ nihʉɨɨe kɨna ʉnyenye mʉkʉlɨnga kɨna ʉsese shanga kʉleming'we nigeng'wa nɨlanso. <verse eid="2CO 13:6" /><verse number="7" style="v" sid="2CO 13:7" />Kʉʉmʉlompa Itunda mʉleke kitʉma ʉbɨɨ wɨhi, shanga nsoko kigele anga antʉ nɨakondilye kʉhuma, ingɨ nɨkʉkee apaitɨ shanga antʉ alɨnge kɨna kalɨlemya igengwa mʉmʉlɨmo ʉwo naɨkitʉmanilye nʉnyenye. Ʉsese nɨkʉkɨloilwe ingɨ ʉnyenye mitʉme makani nɨmaza, palʉng'wɨ nɨ kɨna ʉsese kʉigeleka kɨna kaleming'wa nigeng'wa nɨlanso. <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />Kʉʉleng'wa kitʉma kɨntʉ kɨhi nsuta nɨtai, ʉhumi nɨkukete ingɨ kʉlongoleka mʉtai <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />Kʉloilwe kʉona ʉnyenye mʉkʉine ʉsese kɨagila anga ngulu, ingɨ ʉnyenye mʉkete ngulu, kʉlʉlo kʉmʉlompa Itunda ʉnyenye mʉkondanɨɨle mʉʉhʉɨɨli wanyu. <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />Itɨ gwa, balʉa ɨyɨ kʉandɨkɨla kʉlɨ, ingɨ anga mpike kʉng'wanyu ndeke kʉtula nɨmʉtaki kʉkɨɨla ʉhumi ʉwo naɨmpewe ni Isekʉlʉ. Isekʉlʉ ʉmpee ʉhumi nʉwa kʉmʉzenga shanga kʉmʉgazanja.<verse eid="2CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />Itungo ɨlɨ, ayandʉgʉ ane, kʉmʉlaga! Mʉkondanɨɨle mʉʉhʉɨɨli nʉ kʉtyata inkani yane, mʉsange nʉʉlowa, mɨshiɨ nɨmatiliga, Itunda nʉwa ʉlowa watule palʉng'wɨ nʉnyenye.<verse eid="2CO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12" />Mʉzilamʉsha kʉʉlowa wang'wa Kilisito.</para>
  <para style="p" vid="2CO 13:12">Antʉ ɨhi nɨang'wi Itunda amʉlamʉkilye.<verse eid="2CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 13:13" />Kʉmʉlompeela mʉtule nʉʉkende wang'wa Kilisito, <verse eid="2CO 13:13" /><verse number="14" style="v" sid="2CO 13:14" />nʉʉlowa wang'wi Itunda nʉ mʉhangʉ nʉwa Ng'wahʉ Ng'welʉ, yitule palʉng'wɨ nʉnyene mɨhi.<verse eid="2CO 13:14" /></para>
  <chapter eid="2CO 13" />
</usx>