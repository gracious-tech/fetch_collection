<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Isanzu Bible Version</book>
  <para style="h">ALUMI</para>
  <para style="toc1">IBADA LANG'WA PAɄLO KɄ ALUMI</para>
  <para style="toc2">Alumi</para>
  <para style="toc3">Alu</para>
  <para style="mt2">Ibada lang'wa Paʉlo kʉ</para>
  <para style="mt1">ALUMI</para>
  <para style="imt">NTONGEELA</para>
  <para style="ip">Ntongeela ibada kʉ Alumi. Ibada kʉ Alumi lɨhumɨlile lɨandɨkilwe nʉ Mitʉmi Paʉlo mʉng'waka nʉwa 54 nɨ 58 naɨyakɨla kʉtugwa ʉ Kilisito. Matungo nanso, Paʉlo aɨwakɨlɨ kʉpika kʉ Lumɨ, kʉlʉlo aɨʉtʉmile ibada ɨlɨ kisɨgo nɨla kʉalɨngasa Antʉ ɨhi nɨamʉhʉɨɨe ʉ Kilisito naɨishiɨ kʉ kɨsalɨ ka Lumi, Ayahudi nawa nɨshanga Ayahudi. Paʉlo aɨwandikile ibada ɨlɨ wazeʉkolɨ kʉ kɨsalɨ ka Kolinto kʉko aɨwishiɨ matungo nanso. Aɨʉtambʉe ibada ɨlɨ waze ʉloilwe antʉ nɨshanga Ayahudi amʉhʉɨɨle nʉkʉmija ʉ Kilisito 16:26. Ibada nɨla Alumi ingɨ kɨaɨɨlya iza kʉ Antʉ nɨamʉhʉɨɨe ʉ Kilisito nɨa mahɨɨ ɨhi nɨ matungo ɨhi, kʉ itɨ ʉ Paʉlo nʉkumʉʉe kɨhenga ʉgunwa nɨkʉhumile kʉʉlija kʉkɨɨla kʉng'wa Kilisito. Paʉlo ʉikʉɨnkanilye iza Nkani Nza niyang'wa Kilisito ni Ilago nɨla Kalɨ. Asomi ɨdʉ ahʉɨɨe kɨna lʉkɨɨlɨ nʉlimɨkɨɨe nʉkʉtambʉla nkani nɨyibada ɨlɨ ingɨ lʉkɨɨlɨ nʉla 1:16 nʉlʉandɨkile, “Ʉnene shanga kʉhung'wa minyala kʉtanantya Nkani Nza, kʉnsoko Nkani Nza ingɨ ʉhumi wang'wi Itunda nʉɨleta ʉguni kʉ antʉ ɨhi nɨakʉhʉɨɨla ʉ Ysesʉ, kandɨɨlya Ayahudi sʉnga antʉ nɨshanga Ayahudi.” Ng'wandyo nʉ wibada nɨla Alumi kandɨɨlya mʉlango nʉwa 1-12 lɨkenkile makani makʉlʉ hangɨ a kʉlʉ kʉʉlʉ naʉmanyisi wang'wi Itunda, nɨla kabɨɨlɨ mibada ɨlɨ kandɨɨlya mʉlango nʉwa 13-15 lɨkete ʉganʉlwa wɨdʉ nʉwa ʉtendi nʉ likalo nʉla Kɨkilisito kʉ ntendo yɨhi.</para>
  <para style="iot">Namolɨ:</para>
  <para style="io">Paʉlo anga nɨkʉmizɨɨe wandilye kʉandɨka ibada lakwe kitambʉla ʉng'wenso, nʉkʉlʉnga ʉkʉaandɨkɨla antʉ kɨɨ. Mʉlango nʉwa 1:1-15.</para>
  <para style="io">Paʉlo ʉlongolekile kʉandɨka mʉntʉ nɨ mʉnyamɨlandʉ nʉwɨlɨ nɨ itɨ nʉhumile kʉgunwa kʉkɨɨla Kilisito. Mʉlango nʉwa 1:16-11-36.</para>
  <para style="io">Sʉnga Paʉlo ʉkʉlɨngasa kʉntendo mʉitakɨwe kɨshiɨ antʉ nɨamʉhʉɨɨe ʉ Kilisito. Mʉlango nʉwa 12:1-15-13.</para>
  <para style="io">Paʉlo ʉmaɨɨye kʉandɨka ibada nɨla kʉ Alumi kʉpumya mɨlamʉ kʉ antʉ ang'wɨ nɨakolɨ mʉahʉɨɨli a kʉ Lumi 16.</para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />Ʉnene Paʉlo mitʉmi wang'wa Kilisito Yesʉ, nɨ nɨmitʉmi nɨ niholanigwe nʉ kitangwa kʉnsoko akʉtanantya Nkani Nza niyang'wi Itunda.<verse eid="ROM 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 1:2" />Pakalɨ Itunda naɨʉatambʉɨe ɨantʉ kɨna ʉkʉapa Nkani Nza kʉkɨɨla amanga akwe, anga nɨyandɨkilwe Mʉwandɨkwa wakwe. <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />Impola izi Ninza yimʉganʉe Ng'wana wang'wi Itunda, Isekʉlʉ witʉ ʉ Yesʉ Kilisito, mʉkɨʉntʉ kakwe aɨʉtugɨwe miele lang'wa Daudi, <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />ingɨ kʉ ʉhumi nʉwa Ng'wahʉ Ng'welʉ yʉyʉ naɨ ʉkumʉʉwe kɨna ng'wenso Ng'wana wang'wi Itunda naɨ wiʉkigwe, ingɨ Kilisito Isekʉlʉ witʉ. <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />Kʉkɨɨla Kilisito nʉwanso, ʉnene mpewe ʉkendepwa kʉtula mitʉmi nʉwa kʉitanga antʉ nɨshanga Ayahudi ahume kʉhʉɨɨla nʉ kʉkela. <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />Mʉantʉ nɨanso nʉ nyenye ga mʉkolɨ, mitangilwe mʉtule mɨantʉ akwe ʉ Kilisito Yesʉ mʉkola.<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />Kʉitɨ gwa, nʉmʉandɨkɨe mɨhi nɨmʉkolɨ kʉ Loma, kɨna Itunda nʉmʉloilwe nangaluu, wɨkamʉhola mʉtule mɨantʉ akwe.</para>
  <para style="p" vid="ROM 1:7">Kʉmʉlompa Itunda Tata witʉ ni Isekʉlʉ witu Kilisito wamʉpe ʉnyenye ʉkende nɨ matiliga.<verse eid="ROM 1:7" /></para>
  <para style="s">Malompi nɨ malʉmbɨɨlyo kʉng'wi Itunda</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />Ng'wandyo lʉkʉlʉ, nʉmʉlʉmbɨɨye Itunda kʉkɨɨla Kilisito, kʉnsoko kʉhʉɨɨla kʉng'wanyu yakumʉka mahɨɨ ɨhi. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />Itunda ʉyʉ nɨkʉmitʉmɨla kʉnkolo ane ɨhɨ nɨ kʉtanantya Nkani Nza niya Ng'waakwe. Ingɨ ng'wenso ʉine nʉ kʉlɨnga kɨna nʉmʉkɨmbʉkile matungo ɨhi mʉ malompi ane. <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />Kʉmʉlompa Itunda anga walowe, kʉmpa lyoma niza nɨlakɨza kʉng'wanyu. <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />Kʉnsoko nsʉmbɨɨye nangalu nʉmʉone nihume kʉmʉaɨɨlya mʉlije ɨpegwa niya kɨnkolo mʉkamatɨke mʉ ʉhʉɨɨli wanyu. <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />Ingɨ anga kʉtule palʉng'wɨ ʉnene nʉ nyenye kikomelye ɨnkolo kʉ mʉhʉɨɨla Isekʉlʉ witʉ ʉ Kilisito.<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />Anyandʉgʉ ane ndoilwe mʉlɨnge kɨna nkʉa yɨdʉ aɨnɨkenda hiya kʉmiʉmbaʉmbɨla, ingɨ itungo ɨlɨ nkɨlɨ ngiɨigwe. Nihume kʉatanantɨlya antʉ amʉhʉɨɨle ʉ Kilisito anga nɨtanantilye kʉ antʉ a mahɨɨ mangɨza. <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />Ʉnene ntakɨwe kʉatanantɨlya antʉ a mahɨɨ ɨhi Ayunani nawa nɨshanga Ayunani, antʉ nɨakete mahala ang'wɨ nɨagila mahala, kʉ antʉ nɨasomile ang'wɨ nɨshanga asomile. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />Yɨyo nsoko ndoilwe kʉmʉtanantɨlya Impola Ninza ʉnyenye nɨmʉkolɨ kʉ Lumi.<verse eid="ROM 1:15" /></para>
  <para style="s">Yikolɨ ngulu mʉ Mpola Ninza</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />Ʉnene shanga kʉhung'wa minyala kʉtanantya Nkani Nza, kʉnsoko Nkani Nza ingɨ ʉhumi wang'wi Itunda nʉɨleta ʉguni kʉ antʉ ɨhi nɨakʉhʉɨɨla ʉ Yesʉ, kandɨɨlya Ayahudi sʉnga antʉ nɨshanga Ayahudi. <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />Kʉnsoko Nkani Nza ilagɨɨe kɨna Itunda ʉloilwe antʉ atule ingɨ ahume kʉgombeka pang'waakwe, lʉkani ʉlʉ litʉng'wa kʉhʉɨɨli kandɨɨlya ʉng'wandyo sʉnga nitungo ɨlɨ. Yandɨkilwe kɨna, “Mʉntʉ nʉkʉmʉhʉɨɨla ʉkishiɨ kʉ ʉhʉɨɨli.”<verse eid="ROM 1:17" /></para>
  <para style="s">Magazo a antʉ</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />Kʉpuma kilunde Itunda ʉatakɨɨe antʉ ɨhi kʉnsoko aʉpɨlʉki nʉ ʉbɨ wɨhi nʉwa antʉ, kʉkɨɨla nzɨla yao nɨmbɨ nɨɨgilya nkani niyatai ileke kʉkumʉka. <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />Kʉnsoko, makani ɨhi nang'wi Itunda aɨkilwe kɨhenga kʉng'wao. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />Kʉnsoko kʉpuma Itunda naɨʉtundile ihɨɨ, ʉhumi wakwe nʉwa kalɨ na akalɨ nʉ ʉpuumo wakwe ʉng'wenso kʉtula Itunda, palʉng'wɨ nʉkʉtula igeelekile kɨhenga wɨzelɨngwa kʉpumɨɨla kʉ ayo nʉwitʉmile ingɨ ana antʉ azeleng'wa kilongola. <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" />Antʉ awa palʉng'wɨ nʉkʉtula alɨngile kɨna Itunda ʉkolɨ, ingɨ shanga ɨmʉpaa ʉkʉlʉ mʉitakɨwe, hangɨ shanga ɨmʉsongelya. Shanga ɨsɨga nɨiza, apʉngʉtae nɨ mahalao ʉpʉngʉ ʉtilɨ. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />Isania kɨna akete mahala, kʉnʉ shanga alɨngile anga kɨntʉ, <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />apeile kipolya kʉng'wi Itunda nʉwishiɨ kalɨ na kalɨ, kɨmɨkɨɨli kakwe akipolya kʉ adʉdʉ nɨimpyani nɨantʉ niisha, niikalɨ ni nyʉnyi ang'wi ikalɨ niyagula.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />Kʉnsoko yɨyo Itunda ʉalekile atyate kitʉma ʉbɨ mʉaloewe mʉ nkolo yao nʉkitendeela makani amɨnyala mʉmɨɨliao. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />Akʉkaɨla tai ang'wi Itunda ʉtule ʉteele, akʉiye nʉkʉsania iʉmbwa nʉkʉmʉleka Itunda nʉʉmbile, ʉyo nʉwɨkʉligwa ɨkalɨ kalɨ! Tai ituleʉ.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />Kʉlʉlo Itunda wɨkaaleka atyate nsula nɨmbɨɨ. Sʉnga asʉngʉ ɨkakaɨla kʉtʉmɨla mɨɨlɨ kʉ agohaao, ɨkatula kitɨna enso. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />Nɨitʉnja ga, alekile ʉtʉmɨli nʉwa mɨɨlɨ anga naɨaʉmbilwe kʉasʉngʉ, nɨenso ɨkatula kitɨna enso. Itʉnja akitendeela makani amɨnyala, akʉlija ʉpɨsɨɨligwa mʉ likalo lao kʉnsoko antendo yao nimbɨ.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />Kʉnsoko antu aɨahitile kʉmʉlɨnga Itunda, ingɨ Itunda wɨkaaleka atyate masɨgoao naʉlimɨli, ɨkituma makani nɨshanga anonee kitʉma. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />Izʉe mpyani yɨhi niyaʉbɨ, ʉsambo, ʉbɨɨ, wikapi nʉ ʉlaku nʉ kʉpantɨka nsao niyawii. Izʉe wɨlu nʉ ʉbʉlagi nʉ ʉgali, ʉkongelani nɨ masɨgo nɨmabɨɨ antʉ awa ategetani, <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />hangɨ akinyɨli, ingɨ antu akʉbɨpɨlwa ni Itunda, abehʉli, ɨlʉgoha, nʉwilolyi, amankata akʉtenda nɨmabɨɨ, hangɨ agila lwijo kʉ aleliao, <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />apʉngʉ, shanga ɨheja malapo nɨilapɨe, agilanga ʉkende agila ga nɨkɨaisa kʉ antʉ nɨangɨza. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />Palʉng'wɨ nʉkʉtula amalɨngile ɨmalagɨɨlyo atai nang'wi Itunda kɨna antʉ nɨitʉma intendo anga niyanso atakɨwe ashe. Kʉkɨla nanso ʉdu, shanga kɨna akitʉma makani nanso enso akola, ingɨ ga nʉkʉalʉmbɨɨlya awo nɨakitʉma makani nanso.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">Ʉlamʉlwi wang'wi Itunda nʉwa tai</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />Itɨ gwa, mʉhʉmbamɨane, anga ɨze ʉewe wɨapɨsɨɨlya ɨako, shanga ʉhumile kilongoola, anga itule ʉewe wɨ nyenyu. Kʉnsoko aya nʉwɨapɨsɨɨlya nɨang'wɨ yayo yayoo nʉewe witʉma <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />Kʉlɨngile kɨna ʉlamʉlwi wang'wi Itunda watai kʉ antʉ nɨituma makani anga nanso. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />Itɨgwa ʉewe mʉhʉmbamɨane nʉwɨapɨsɨɨlya awa nɨitʉma makani anga nanso, kʉnʉ nʉewe ʉzituma yayo yaayo, itɨɨ ʉsɨgile kɨna Itunda shanga ʉkʉʉpɨsɨɨlya ne? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />Ang'wɨ ʉdalahile ʉkende wang'wi Itunda nisʉmbɨɨlyo lakwe nʉigigimɨɨlyi wakwe, shanga ʉlɨngile kɨna ʉkende wakwe ʉloilwe ʉewe ʉhume kila itʉnʉ ʉleke ɨmɨlandu ako nʉkʉmʉpɨlʉkɨla Itunda? <verse eid="ROM 2:4" /><verse number="5" style="v" sid="ROM 2:5" />Kʉnsoko lʉgoha mʉhitile kʉleka ɨmɨlandʉ, kʉlʉlo mʉkiɨkɨlya ʉpɨsɨɨligwa kʉlʉhikʉ nʉlanso angalɨpike itungo Itunda nʉkʉpɨsɨɨlya kʉ taiane. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />Lʉhikʉ nʉlanso ng'waamʉntʉ wɨhi ʉzepegwa ni Itunda kʉtyata mʉntendo yakwe mʉyɨlɨ. <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />Antʉ nɨakomanɨɨye kʉtenda nɨmaziza, nɨakʉduma ʉkʉlʉ nʉkʉlʉ nʉ likalo nɨshanga lɨkaɨlɨka Itunda ʉkʉapa ʉpanga nʉwa kalɨ na kalɨ. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />Ingɨ kʉ antʉ nɨangɨza nɨiloilwe ɨenso du, nɨatyatɨla makani nɨmabɨɨ amahitile ɨmakani atai, akʉmʉsasha Itunda watake nʉyo ʉkʉapɨsɨɨlya mʉitakɨwe. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />Lʉkigela lwago nʉ ʉwai kʉ antʉ ɨhi nɨɨtenda nɨmabɨɨ. Ʉkandɨɨlya kʉ Ayahudi atyatwe ga nɨantʉ nɨshanga Ayahudi. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />Ingɨ gwa Itunda ʉkʉsasha antʉ awa nɨɨtenda nɨmaza akʉligwe atule nɨ matiliga, ʉkandɨɨlya kʉ Ayahudi atyatwe nɨ antʉ nɨshanga Ayahudi. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />Kʉnsoko Itunda wɨkʉɨɨla mʉntʉ wɨhi nʉkʉlamʉla.<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />Antʉ ɨhi nɨshanga Ayahudi nɨɨtenda mɨlandʉ palʉng'wɨ nʉkʉtula shanga azealɨngile kɨna akʉbunanga malagɨɨlyo ang'wi Itunda naɨʉmʉpee ʉ Musa akʉlimansɨɨligwa anga ɨmalagɨɨlyo nalagɨɨye. Nɨ Ayahudi nɨɨtenda mɨlandʉ azealɨngile kɨna akʉbunanga malagɨɨlyo ang'wi Itunda naɨʉmʉpee ʉ Musa akʉlamʉlwa anga ɨmalagɨɨlyo nalagɨɨye. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />Kʉnsoko shanga antʉ nɨija malagɨɨlyo ɨgombwa ni Itunda, ingɨ antʉ nɨakete ʉlwijo nʉkʉtenda malagɨɨlyo ɨgombwa kɨna akete taiane. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />Kʉnsoko antʉ nɨshanga Ayahudi nɨagila malagɨɨlyo, kʉtongwa nɨ masɨgoao pɨhi itʉma ntendo niya malagɨɨlyo nalagɨɨye, enso akʉtula ngele a malagɨɨlyo palʉng'wi nʉkʉtula shanga alɨngile malagɨɨlyo. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />Likalo lao ligeelekile kɨna nsʉla amalagɨɨlyo aandɨkilwe mʉnkolo yao. Masɨgoao akʉtanantya makani yayo, ng'waao nkʉa ying'wɨ ɨsemelwa nɨ masɨgoao, nkʉa ying'wɨ iakʉɨɨla. <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />Kʉlʉlo, kʉtyata Nkani Nza izi nɨkʉtanantya, ʉʉgwa izetula lʉhikʉ ni Itunda nʉkʉlamʉla makani akɨnkunku na anaantʉ kʉkɨɨla Kilisito Yesʉ.<verse eid="ROM 2:16" /></para>
  <para style="s">Ayahudi nɨ malagɨɨlyo ang'wi Itunda</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />Nʉewe, itɨ? Ʉewe mʉkola widaya kɨna wɨ Mʉyahudi, ʉsanilye malagɨɨlyo nʉkʉhʉɨɨla kɨna wɨmʉntʉ wang'wi Itunda, <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />kʉkɨɨla kʉmanyisigwa nɨmalagɨɨlyo ang'wi Itunda, ʉhumile kitʉma makani natakɨwe kitʉng'wa, <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />ʉewe nʉkiona kɨna wɨmʉtongeeli waapoku hangɨ wɨlʉmʉlɨ kʉ antʉ nɨakolɨ mʉkiti, <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />ʉkiona kɨna wɨmʉmanyisi nʉwa apʉngʉ nɨ antʉ nɨshanga amanyile itai aʉhʉɨɨli. Kʉnsoko ʉkete ʉlɨngi nʉwamahala amalagɨɨlyo nanso. <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />Itɨ gwa ʉewe, wɨmanyisa ɨako, nɨkɨ shanga wimanyisa ʉewe? Ʉewe nʉwɨtanantya kɨna, “Leki kia,” kʉnʉ ʉewe ʉkia? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />Ʉkʉlʉnga, “Leki kʉgoolya,” kʉnʉ ʉewe wɨgoolya? Ʉbɨpɨwe adʉdʉ aalʉngʉ kʉnʉ ʉewe wia maintʉ mʉnyʉmba niya kipoelya adʉdʉ aalʉngʉ? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />Ʉewe wikumazʉsha kɨna ʉambile malagɨɨlyo ang'wi Itunda, itɨ shanga ʉinene kɨna wɨbunanga malagɨɨlyo nʉkʉtula wamʉdalaha Itunda? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />Anga niyandɨkilwe Mʉʉandɨkwa wang'wi Itunda kɨna, “Kʉnsoko anyu Itunda wɨtʉkɨlwa nɨantʉ amahɨɨ mangɨza.” <verse eid="ROM 2:24" /><verse number="25" style="v" sid="ROM 2:25" />Kʉtalwa kiganda kʉng'wako yɨkʉtula yikete ndogoelyo anga ʉtyate malagɨɨlyo ang'wi Itunda. Ingɨ anga ʉbunange malagɨɨlyo ang'wi Itunda bahu aɨʉleke kʉtalwa kiganda. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />Anga itule mʉntʉ nɨshanga ʉtawe kiganda ʉkitʉma mʉitakɨwe malagɨɨlyo, itɨ gwa kʉleka kʉtalwa kiganda kʉng'wakwe shanga ʉkʉaɨligwane kɨna ʉtawe kiganda? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />Antʉ amahɨɨ mangɨza akʉʉlamʉla ʉewe nʉwɨ Mʉyahudi nʉbunangile ilagɨɨlyo, palʉng'wɨ nʉkʉtula ʉkete ʉandɨkwa nʉa malagɨɨlyo hangɨ ʉtawe kiganda, nɨanso atyatile malagɨɨlyo kʉnʉ shanga atawe kiganda. <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />Kʉlʉlo kʉlʉnge, mʉntʉ wɨhi nʉtugilwe nʉ Mʉyahudi ingɨ Mʉyahudi, ang'wɨ kʉtalwa kiganda nɨkatai shanga kɨntʉ ka kʉmʉtenda mʉntʉ watule Muyahudi. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />Mʉyahudi nʉwatai ingɨ yuyo nɨ Mʉyahudi mʉnkolo, ingɨ nʉtawe kiganda mʉnkolo. Ɨlɨ ingɨ ikani la Ng'wahʉ Ng'welʉ, shanga ikani laʉandɨkwa nʉwa malagɨɨlyo. Mʉntʉ nʉwɨitɨ mʉgila anga ʉkʉlʉ kʉ antʉ ingɨ kʉng'wi Itunda.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />Itɨgwa, Mʉyahudi ʉkete kɨntʉ kɨɨ nɨkɨkɨlɨnkɨe kʉ awa nɨshanga Ayahudi? Ang'wɨ kʉtalwa kiganda ikʉaɨɨlya ntʉni? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />Ee ingɨ tai kʉtula Wɨmʉyahudi ɨkʉaɨɨlya! Itunda aʉapee hanza Ayahudi impola yakwe. <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />Yɨkatula ʉlɨ gwa anga itule Ayahudi nɨang'wɨ shanga ahʉɨɨli? Itɨɨ, ikani nɨlanso lɨkʉsasha Itunda waleke kʉhʉɨɨlwa? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />Shangaʉ! Matungo ɨhi Itunda wɨsaga wakʉhʉɨɨlwa nɨ antʉ, palʉng'wɨ nʉkʉtula ɨana aantʉ ɨhi ateele. Anga nɨyandɨkile kɨna</para>
  <para style="q" vid="ROM 3:4">“Lʉkani lɨhi nʉkʉligitya ingɨ yatai,</para>
  <para style="q" vid="ROM 3:4">nʉ mʉʉlamʉlwi ʉewe wɨhuma.”<verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />Ingɨ, anga itule ʉʉbɨ witʉ ʉkʉlagɨɨla kɨna Itunda witʉma ɨtai ntilɨ, kʉlʉngeʉlɨ gwa? Itɨɨ! Kʉlʉnge Itunda ʉkete igazone anga wakʉpɨsɨɨlye? Apa kʉtambʉla kɨʉntʉ. <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />Shangaʉ! Anga aɨyitule Itunda shanga mʉnyatai, aɨʉzehuma ʉlɨ kʉʉlamʉla ʉnkʉmbigʉlʉ.<verse eid="ROM 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7" />Anga ɨze ʉsese kɨateele kɨatenda antʉ ang'wɨ ahume kʉona kɨna Itunda mʉnyatai, antʉ nɨanso akulongoleka kʉmʉkʉlya, itungo ɨlɨ kʉnɨkɨ ikɨlɨ kʉlamʉlwa kɨna kitʉma mɨlandʉ? <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />Ingɨ itendile anga kʉlʉnga, “Kitʉme nɨmabɨɨ kʉhume kʉlija nɨmaza?” Antʉ ang'wi ɨkʉtunja kʉlʉnga kɨna ga nʉsese kʉmanyisilyeʉ. Nɨakʉtambʉla itɨ akʉlamʉlwa anga mʉʉbɨ wao.<verse eid="ROM 3:8" /></para>
  <para style="s">Antʉ ɨhi atendile mɨlandʉ</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />Ʉsese kʉlʉnge ʉlɨgwa? Itɨɨ, ʉsese nɨkɨ Ayahudi kɨazane kʉkɨla ɨantʉ nɨshanga Ayahudi? A! a! Kʉnsoko nakondya kʉmʉɨla ʉng'wandyo kɨna Ayahudi nɨantʉ nɨshanga Ayahudi ɨhi ɨkaɨwe nɨmɨlandʉ. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />Anga ʉandɨkwa wang'wi Itunda nʉʉandɨkilwe.</para>
  <para style="q" vid="ROM 3:10">“Kʉtile mʉntʉ wɨhi nʉwitʉma aya nagombekile kʉng'wi Itunda,<verse eid="ROM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ROM 3:11" />kʉtilɨ anga mʉntʉ wɨhi nʉkete ɨmahala,</para>
  <para style="q" vid="ROM 3:11">ang'wɨ nʉwimʉkʉlya Itunda.<verse eid="ROM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ROM 3:12" />Antʉ ɨhi amʉlekile Itunda,</para>
  <para style="q" vid="ROM 3:12">kʉtilɨ mʉntʉ wɨhi nʉwitʉma makani natakɨwe ni Itunda,</para>
  <para style="q" vid="ROM 3:12">kʉtilɨ nʉyʉ nʉng'wɨ ga<verse eid="ROM 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ROM 3:13" />Ilakalao impyani niibɨɨla nɨshanga ituhɨɨwe,</para>
  <para style="q" vid="ROM 3:13">mʉ lʉlɨmɨ izʉe ʉteele,</para>
  <para style="q" vid="ROM 3:13">mʉ mɨlomo ɨtambʉla nkani nimbɨ anga ʉhʉngʉ nʉwa nzoka.<verse eid="ROM 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ROM 3:14" />Mʉmɨlomoao ɨtambʉla nkani yawizumi nʉkʉaalya mʉnkolo niya antʉ.<verse eid="ROM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ROM 3:15" />Antʉ awa apepeele kʉabʉlaga antʉ ang'wɨ,<verse eid="ROM 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ROM 3:16" />ga yɨhi nɨenda ɨkanza maintʉ nʉkʉalekela antʉ sʉka,<verse eid="ROM 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ROM 3:17" />shanga amanyile kishiɨ nɨ antʉ aʉya matiliga.<verse eid="ROM 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ROM 3:18" />Shanga amogapile Itunda.”<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />Ʉsese kʉlɨngile kɨna makani ihɨ nɨtambʉlwa mʉ malagɨɨlyo atʉngile antʉ nɨatongilwe nɨmalagɨɨlyo, shanga ahumile kilongola kɨntʉ kɨhi, nʉ ʉnkʉmbigʉlʉ wɨhi ʉkolɨ mʉ ʉlamʉlwa wang'wi Itunda. <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />Kʉlʉlo kʉtilɨ ng'waa mʉntʉ nʉhumile kʉgombwa ni Itunda nʉambile malagɨɨlyo, malagɨɨlyo ingɨ kɨntʉ kakʉmʉkɨmbʉsha ʉdʉ mʉntʉ kɨna witʉma mʉlandʉ.<verse eid="ROM 3:20" /></para>
  <para style="s">Kʉgombwa ni Itunda kʉkɨɨla ʉhʉɨɨli</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />Ingɨ itungo ɨlɨ, nzɨla ang'wi Itunda kʉagomba ɨantʉ kʉtula aza aɨkilwe kɨhenga, hangɨ shanga kʉsania malagɨɨlyo. Malagɨɨlyo ang'wa Musa nʉ ʉandɨkwa nʉwa amanga ang'wi Itunda aɨɨtambʉla ikani ɨlɨ. <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />Nzɨla nanso nakʉagomba antʉ ingɨ kʉmʉhʉɨɨla ʉ Kilisito Yesʉ, Itunda wɨtenda itɨ kʉ antʉ ɨhi nɨatyatile tai, shanga wɨmʉkoma mʉntʉ wɨhi. <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />Antʉ ɨhi atendile mɨlandʉ aleka kʉkʉligwa ni Itunda. <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />Ingɨ gwa kʉ kɨpegwa ka ʉkende wang'wi Itunda, antʉ ɨhi ɨgombwa atule akende pang'wi Itunda kʉkɨɨla kʉkomolwa nʉ Kilisito Yesʉ. <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />Itunda aɨʉmʉpumilye ʉ Yesʉ ingɨ kʉsakami akwe, watule yiyo nzɨla akʉahegelya antʉ mɨlandʉao. Aʉtendile itɨ wahume kʉlagɨɨla kɨna nʉwanso mʉkende. Pakalɨ Itunda aɨmʉgimya shanga aʉkee mɨlandʉ a antʉ, <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />itungo ɨlɨ, matungo aya shanga ʉkʉleka mɨlandʉ a antʉ, ʉtendile itɨ nʉwanso wahume kʉlagɨɨla kɨna mʉkende. Kʉkɨɨla itɨ Itunda ng'wenso ʉkʉlagɨɨla ʉkende wakwe, hangɨ kɨna wɨmʉtenda mʉntʉ wɨhi wagombwe nʉng'wenso kʉkɨɨla Kilisito Yesʉ. <verse eid="ROM 3:26" /><verse number="27" style="v" sid="ROM 3:27" />Kʉnsoko, kʉhumile kiketela kɨntʉ kɨɨ? Kɨagila nɨka kiketela! Kʉnɨkɨ? Itɨɨ, itule kʉnsoko antendone? A! a! Ingɨ kʉiketa kʉnsoko kʉmʉhʉɨɨe ʉ Yesʉ ʉdu. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />Kʉlʉlo kaona kɨna Itunda wɨmʉgomba mʉntʉ kɨna mʉza kʉng'wakwe kʉkɨɨla kʉmʉhʉɨɨla Yesʉ, shanga kʉnsoko akʉtyata malagɨɨlyo nalagɨɨye. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />Itɨɨ, Itunda iza wa Ayahudi ʉdune? Ang'wɨ shanga Itunda kʉ antʉ ɨhi? Ee, yʉyo Itunda nʉwa antʉ ɨhi. <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />Itunda ingɨ ʉng'wɨ, nʉyo ʉkʉaaɨlya Ayahudi ʉkʉagomba kɨna aza pang'waakwe kʉ ʉhʉɨɨli wao, nɨ antʉ ɨhi ga ʉkʉaaɨlya ʉkʉagomba kɨna aza pang'waakwe kʉ ʉhʉɨɨli wʉwo wʉʉwo. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />Itɨgwa, nɨkʉʉlʉnga kʉmʉhʉɨɨle ʉ Yesʉ, itɨɨ nɨkʉʉtambʉla itɨ malagɨɨlyo ang'wa Musa akʉʉlyane ɨnsaɨlo? A! a! Anga kʉmʉhʉɨɨle ʉ Yesʉ kʉʉtenda makani aya malagɨɨlyo ang'wa Musa nalagɨɨye.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">Mpyani ang'wa Ibulahimu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />Ʉsese kʉlʉnge ʉlɨgwa, Ibulahimu tata witʉ kɨmʉɨlɨ, anga ng'waa mʉntʉ, nʉwanso aɨʉlɨngile ʉlɨ ikani ɨlɨ nɨla kʉgombeka kʉng'wi Itunda? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />Anga itule Ibulahimu aɨʉmʉgombile kɨna ʉkete ntendo nza kʉng'wi Itunda, ʉgwa ʉkʉtula ʉkete nɨkakisania pang'wi Itunda. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />Kʉnsoko, yandɨkilwe itɨ Mʉwandɨkwa nʉ wang'wi Itunda kɨna, “Ibulahimu aʉmʉhʉɨɨe Itunda, ni Itunda wɨkamʉgomba kɨna mʉntʉ nʉtyatile ɨtai. <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />Mitʉma mʉlɨmo wɨlɨpwa kɨnyamʉlɨmo kakwe, kɨnyamʉlɨmo nɨkanso shanga kɨpegwa kakʉgombeka kʉng'wi Itunda. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />Ingɨ gwa mʉntʉ wɨhi waleke kʉsania ntendo yakwe, ingɨ nʉamʉhʉɨɨle Itunda nʉwɨalekela mɨlandʉ antʉ nɨabɨ, ʉgwa Itunda wɨgoza ʉhʉɨɨli wa mʉntʉ nʉwanso, wɨgomba kɨna ʉtyatile tai. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />Daudi nʉyo ʉlʉngile itɨ mʉwiloi nʉwa mʉntʉ nʉgomilwe ni Itunda ʉkete ʉkendepwa nʉwanso.<verse eid="ROM 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ROM 4:7" />“Akembetilwe antʉ nɨakʉlekelwa ɨmɨlandʉao,</para>
  <para style="q" vid="ROM 4:7">mɨlandʉao ahegigwa!<verse eid="ROM 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ROM 4:8" />Ʉkembetilwe mʉntʉ ʉyo</para>
  <para style="q" vid="ROM 4:8">nɨshanga ʉkʉaɨligwa ʉbɨ ni Isekʉlʉ wakwe!”<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />Itɨɨ, ʉkembetwa ʉwʉ nʉtambʉe ʉ Daudi kʉ antʉ nɨatawe kigandane, ang'wi nʉ kʉ antʉ nɨshanga atawe kiganda? E, e, ingɨ ga nɨantʉ nɨshanga atawe kiganda, kʉnsoko kakondya kʉlʉnga itɨɨ, “Ibulahimu aʉhʉɨɨe, ni Itunda wɨkamʉgomba kɨna mʉntʉ nʉtyatile tai ane.” <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />Itɨɨ, matungo kɨɨ Ibulahimu naɨʉaɨɨgwe ni Itunda kɨna mʉnya tai? Itɨɨ, naɨwakɨlɨne kʉtalwa kigandane ang'wɨ naɨwatalwa kiganda? A! a! shanga naɨwatalwa kiganda, ingɨ naɨwakɨlɨ kʉtalwa kiganda. <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />Ibulahimu aɨʉtawe kiganda panyambele, nʉʉtalwa kiganda nʉwanso aɨkɨlɨngasɨɨlyo kakʉkamɨnkɨɨlya kɨna Itunda aɨʉmʉgombile Ibulahimu kɨna ʉkete ntendo nza kʉnsoko aʉhʉɨɨli wakwe naɨʉkete naɨwakɨlɨ kʉtalwa kiganda. Kʉlʉlo Ibulahimu wɨkatula tata nʉwa antʉ ɨhi, palʉng'wɨ nʉkʉtula shanga atawe kiganda, aɨʉmʉhʉɨɨe Itunda, Itunda ʉkʉgomba kʉtula antʉ nɨakete ntendo nza. <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />Hangɨ Ibulahimu tata nʉwa antʉ nɨatawe kiganda, ingɨ shanga kʉnsoko atawe kiganda, ingɨ kʉnsoko ahʉɨɨe anga ʉtata witʉ Ibulahimu naɨʉhʉɨɨe naɨwakɨlɨ kʉtalwa kiganda.<verse eid="ROM 4:12" /></para>
  <para style="s">Ilago lang'wi Itunda lɨsɨngɨɨligwa kʉ ʉhʉɨɨli</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />Itunda aɨʉmʉɨɨe ʉ Ibulahimu nʉ wileli wakwe kɨna ihɨɨ ɨhi ɨkʉtula nsao akwe. Ilago nɨlanso shanga kʉnsoko Ibulahimu aʉtyatile malagɨɨlyo, ingɨ kʉnsoko aʉhʉɨɨe, kʉlʉlo Itunda wɨkamʉgomba kɨna ʉkete ntendo nza. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />Kʉnsoko anga itule ilago ɨlɨ akʉpegwa antʉ nɨatyatile malagɨɨlyo, ʉgwa kʉhʉɨɨla yʉkʉtula kʉtilɨ anga ng'waao wɨhi, itɨ gwa Itunda ʉkʉtula walongopa. <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />Malagɨɨlyo ɨsasha Itunda wahung'we ikuo, ingɨ gwa anga itule kʉtilɨ anga malagɨɨlyo, shanga ihumɨkile kʉbunangwa malagɨɨlyo. <verse eid="ROM 4:15" /><verse number="16" style="v" sid="ROM 4:16" />Kʉnsoko, ikani ɨlɨ lɨza kʉkɨɨla kʉhʉɨɨla, kʉlʉlo gwa ilago ɨlɨ lɨpumigwe kʉnsoko a ʉkende wang'wi Itunda, hangɨ kɨna kʉlʉkʉʉlʉ ilago nɨlanso ingɨ la antʉ ɨhi. Shanga kʉ antʉ wawa du nɨaambile malagɨɨlyo, ingɨ ga nʉkʉ antʉ nɨishiɨ kʉ ʉhʉɨɨli anga Ibulahimu. Nʉwanso yʉyo tata witʉ kɨhi. <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />Anga ʉandɨkwa wang'wi Itunda nʉandilwe, “Nʉkʉɨkile ʉtule wɨtata nʉwa antʉ amahɨɨ ɨdʉ.” Lʉkani nʉlanso nʉlʉtambʉwe latai pang'wi Itunda kʉnsoko ʉ Ibulahimu aʉmʉhʉɨɨe Itunda nɨ wɨapangataalya antʉ nɨakule, kʉngulu yakwe, maintʉ nɨkʉtile igela. <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />Ibulahimu aɨʉhʉɨɨe nʉ kʉsʉmbɨɨlya palʉng'wɨ nʉkʉtula lʉkani nʉlanso aɨlʉkaku kʉhʉɨɨla, kʉlʉlo waile tata kʉ antʉ amahɨɨ ɨdʉ anga niyandɨkile mʉ Ʉandɨkwa nʉwang'wi Itunda. “Wileli wakwe ʉkʉtula antʉ ɨdʉ anga inzota.” <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />Ibulahimu aɨmʉnyampala anga wamyaka igana itɨ, ingɨ ʉhʉɨɨli wakwe shanga aɨkepile palʉng'wɨ nʉkʉtula aʉlɨngile kɨna ʉmʉɨlɨ wakwe aɨwaile anga wakule, hangɨ nʉ mʉsʉngʉ wakwega, ʉ Sala, aɨmʉgʉmba.” <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />Ibulahimu shanga aɨwikankanilye ilago lang'wi Itunda, wɨkalija ngulu mʉʉhʉɨɨli wakwe, wɨkamʉkʉlya Itunda. <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />Ibulahimu aɨʉlɨngile kɨna Itunda ʉhumile kʉtimɨlya ilago lakwe nʉtambʉe. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />Yɨyo nsoko, “Itunda aɨʉmʉgombile kɨna ʉkete ntendo nza”. <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />Makani naandɨkilwe kɨna, “Itunda aɨʉmʉine kɨna ʉkete ntendo nza,” shanga ʉkʉtambʉlwa ʉ Ibulahimu du. <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />Ikani ɨlɨ nɨlakʉgombwa ni Itunda ingɨ litʉ nʉsese ga nɨkʉmʉhʉɨɨe Itunda naɨʉmiʉkilye ʉ Yesʉ, Isekʉlʉ witʉ. <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />Itunda aɨʉmʉpumilye ʉ Yesʉ wabʉlagwe kʉnsoko amɨlandʉ itʉ, wɨkiʉkigwa ingɨ ʉsese kʉhume kʉgombwa kɨna kʉkete ntendo nza.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">Kʉtula nɨkihʉmbashʉya ni Itunda</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />Kʉnsoko kagombeka kʉng'wi Itunda kʉkɨɨla ʉhʉɨɨli, ʉgwa kʉkete matiliga kʉng'wi Itunda kʉkɨɨla Isekʉlʉ witʉ Kilisito. <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />Kʉkɨɨla kʉhʉɨɨla kʉng'witʉ kʉng'wa Yesʉ, Itunda ʉkʉpee ʉkende wakwe. Itungo ɨlɨ kʉlongolekile kishiɨ mʉʉkende wakwe. Kiloile ikʉlʉ, kʉnsoko kʉsʉmbɨɨye kɨna kʉkamantana ni Itunda mʉʉkʉlʉ lakwe. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />Shanga yayo du, ingɨ ga nʉkʉlowa mʉlwago kʉzekʉlɨngile kɨna ʉlwago lɨsasha kiʉmɨɨlya, <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />wiʉmɨɨlyi wɨsasha ʉkamatɨku, nʉ ʉkamatɨku wɨsasha ʉsʉmbɨɨlyi. <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />Ʉsʉmbɨɨlyi witʉ shanga ʉkʉʉkatapya kʉnsoko Itunda wakondilye kʉʉletela ʉlowa wakwe mʉnkolo yitʉ, kʉkɨɨla a Ng'wahʉ Ng'welu nʉwazile.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />Naɨkʉkɨlɨ kʉlemilwe kiguna, itungo lang'wa Kilisito, naɨlapika, wɨkasha kʉnsoko itʉ nɨkɨanya mɨlandʉ. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />Ingɨ, ikaku mʉntʉ kʉsha kʉnsoko amʉntʉ nʉkete ntendo nza, kwala bahu mʉntʉ washe kʉnsoko amʉntʉ nʉwankolo nza. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />Ingɨ Itunda wakondilye kʉkamɨnkɨɨlya kɨna ʉkʉloilwe ikʉlʉ, kʉnsoko apo naɨkʉkɨlɨ kɨanyamɨlandʉ, Kilisito Yesʉ aʉkule kʉnsoko itʉ. <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />Kʉnsoko itungo ɨlɨ kagombilwe ni Itunda kʉkɨɨla sakami ang'wa Kilisito, ingɨ yigeelekile kɨna ʉhumile kʉʉguna mikʉo lang'wi Itunda! <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />Kʉnsoko naɨ kɨalʉgʉ ang'wi Itunda, Itunda aɨkʉsakilye kʉkamɨnkane nʉyo kʉkɨɨla nsha a Ng'waakwe, itɨɨ anga kʉkamɨnkanigwe shanga kʉ ʉgunwa kʉnsoko Itunda mʉpanga. <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />Hangɨ shanga yayo du, ingɨ nʉkiloa kʉng'wi Itunda kʉnsoko ang'wa Kilisito Yesʉ, nɨ kʉkɨɨla kʉng'wakwe kʉgombwe ni Itunda.<verse eid="ROM 5:11" /></para>
  <para style="s">Adamu nʉ Kilisito</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />Kʉlʉlo gwa, kʉkɨɨla mʉntʉ ʉng'wɨ mʉlandʉ aɨwingɨe mʉantʉ ɨhi mʉʉnkumbigʉlʉ, nɨnsha ɨkasakigwa kʉ antʉ ɨhi. Kʉlʉlo ɨnsha ɨkaapikɨɨla antʉ ɨhi, kʉnsoko ɨhi itʉmile mʉlandʉ. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />Kʉnsoko naɨkʉtilɨ malagɨɨlyo ang'wa Musa, mɨlandʉ aɨmolɨ mʉʉnkumbigʉlʉ, ingɨ kʉnsoko aɨkʉtilɨ anga malagɨɨlyo, mɨlandʉ shanga ɨaligwa. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />Nɨitɨ ga, kʉpuma matungo ang'wa Adamu kʉpikɨɨla matungo ang'wa Musa, ɨnsha aɨkolɨ kʉ antʉ ɨhi nɨshanga atendile mʉlandʉ anga Adamu naɨ ʉmʉhitile Itunda. Adamu aɨwimpyanigwe nʉ Kilisito naɨʉzɨɨza. <verse eid="ROM 5:14" /><verse number="15" style="v" sid="ROM 5:15" />Ingɨ mʉlandʉ wang'wa Adamu shanga lɨhumile kimpyanigwa nʉ ʉkende wang'wi Itunda. Kʉnsoko, palʉng'wɨ nʉkʉtula mʉlandʉ nʉwa mʉntʉ ʉng'wɨ aɨsakilye nsha mʉ antʉ ɨhi, kʉ ʉza wamʉntʉ ʉng'wɨ, ingɨ ʉ Kilisito, Itunda waongeeye antʉ ɨhi ʉkende wakwe ni ipegwa yakwe. <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />Ikolɨ nsuta mʉ ipegwa yang'wi Itunda nʉ mʉlandʉ nʉa mʉntʉ ʉyo nʉng'wɨ. Kʉnsoko, igazo nɨla mʉntʉ ʉng'wɨ, Itunda wɨkalamʉla kʉpɨsɨɨlya, ingɨ antʉ ɨdʉ naɨ agaza, Itunda wɨkaapa kɨpegwa ka kʉalekela mɨlandʉ. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />Ɨtai, anga ɨze kʉkɨɨla mʉlandʉ nʉa mʉntʉ ʉng'wɨ, antʉ ɨkandya kʉsha nsoko amʉntʉ yʉyo nʉʉng'wɨ, ɨhi nɨakʉsɨngɨɨlya ʉkende nʉwanso nʉwang'wɨ Itunda akʉpegwa kɨpegwa kakwe mʉ ʉaligwi waahʉɨɨli, akʉtema mʉʉpanga kʉ nzɨla amʉntʉ yʉyo nʉʉng'wɨ, ʉ Kilisito Yesʉ.<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />Kʉlʉlo, igazo la mʉntʉ ʉng'wɨ lɨkaletelya ʉpɨsɨɨligwi kʉ antʉ ɨhi naɨitʉmile mɨlandʉ, ʉʉgwa nʉʉza nʉwa mʉntʉ ʉng'wɨ kileta ʉhʉɨɨli nʉ ʉpanga kʉ antʉ ɨhi. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />Hangɨ kʉnsoko igazo nɨla mʉntʉ ʉng'wɨ antʉ idʉ ɨkingɨla mʉmɨlandʉ, ʉʉgwa nʉkʉkɨɨla kʉ mʉntʉ ʉng'wɨ ʉkʉkʉtenda antʉ ɨdʉ agombwe ni Itunda.<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />Malagɨɨlyo naɨiletilwe ɨkasasha kongeeleka mɨlandʉ, nɨmɨlandʉ naɨongeeleka, ʉkende wang'wi Itunda ʉkongeeleka nangalu. <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />Anga ʉ mʉlandʉ naɨ ʉkete ntendo nza nʉkʉsasha nsha, nʉ ʉkende wang'wi Itunda ga ʉkʉsasha antʉ ɨdʉ agombwe ni Itunda nʉkʉaletela ʉpanga nʉwa kalɨ na kalɨ kʉkɨɨla Kilisito Yesʉ Isekʉlʉ witʉ.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s">Kʉsha mʉ mɨlandʉ nʉ kishiɨ nʉ Kilisito</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />Kʉlʉnge ʉlɨ gwa? Itɨɨ, kʉlongoleke kitʉma mɨlandʉ ingɨ ʉkende wang'wi Itunda ʉhume kongeeleke? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />A, a! Ʉsese kakule mʉ mɨlandʉ kʉʉlongoleka ʉlɨ hangɨ kikiɨ mʉ mɨlandʉ? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />Ang'wɨ, mʉlɨngile kɨna ʉsese naɨ kʉbadisigwe kaile kɨpalʉng'wɨ nʉ Kilisito Yesʉ, aɨkʉbadisigwe mʉnsha akwe. <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />Naɨkʉbadisigwe aɨkʉkamantanile nʉyo mʉnsha akwe, kɨkaɨkwa palʉng'wɨ nʉyo, ingɨ anga ʉ Kilisito naɨwiʉkigwe kʉngulu yɨdʉ niyang'wa Tata, nʉsese ga kʉlongoleke kishiɨ mʉlikalo nʉlʉpya.<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />Kʉnsoko, anga ʉsese kakamɨnkana nʉyo mʉnsha anga ʉng'wenso, nɨitɨ ga kakamɨnkana nʉyo mʉwiʉki anga ʉng'wenso naɨwiʉkile. <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />Kʉlɨngile kɨna ʉntʉ witʉ nʉwa kalɨ aɨʉkule nʉkʉkong'wa mʉmʉsalaba palʉng'wɨ nʉ Kilisito, ingɨ ngulu akitʉma mɨlandʉ ɨleke kʉaja hangɨ, ʉsese kʉhege mʉ ʉtʉng'wa nʉwa mɨlandʉ. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />Kʉnsoko mʉntʉ wɨhi nʉkule itɨ, watungʉɨlwa nʉ kʉtula kʉlɨ nɨ mɨlandʉ. <verse eid="ROM 6:7" /><verse number="8" style="v" sid="ROM 6:8" />Itɨ gwa, angaitule aɨkʉkule palʉng'wɨ nʉ Kilisito, kʉhʉɨɨe kɨna kɨkishiɨ palʉng'wɨ nʉyo. <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />Anga kʉlɨnge kɨna Kilisito wiʉkigwe shanga ʉkʉsha hangɨ, ɨnsha shanga ɨkʉmʉlemya hangɨ. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />Kilisito naɨʉkule, aɨʉkule kang'wɨ du, wɨkamɨlemya ɨngulu amʉlandʉ, itungo ɨlɨ wishiɨ mʉpanga nʉ likalo lakwe lɨmʉloeeye Itunda. <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />Itɨ gwa nʉnyenye ga mʉtakɨwe mione kɨna makule mʉ makani a mɨlandʉ, ingɨ mione mɨshiɨ palʉng'wɨ ni Itunda kʉmʉhʉɨɨla ʉ Kilisito Yesʉ.<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />Kʉlʉlo mʉleke kʉgomba mɨlandʉ mʉmɨɨlɨ anyu nɨkuza, hangɨ mʉleke kʉkela kɨlakulaku ka mʉɨlɨ. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />Ang'wɨ mʉleke kʉpumya mɨɨlɨ anyu kʉtula kɨntʉ kakitʉmɨla ʉbɨ nɨ mɨlandʉ, nsuta nɨ itɨ, ipumyi ʉnyenye kʉng'wi Itunda anga antʉ naɨakʉle nʉkiʉkigwa, ipumyi ʉnyenye kʉng'wi Itunda kʉnsoko kitʉma namʉloile Itunda. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />Intɨ gwa, ingɨ mʉlandʉ shanga ʉkʉmʉlemya hangɨ, kʉnsoko malagɨɨlyo magila anga ngulu kʉng'waanyu, ingɨ mʉkolɨ mʉ ʉkende wang'wi Itunda.<verse eid="ROM 6:14" /></para>
  <para style="s">Atʉʉng'wa akitʉma nɨ maza</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />Itɨ gwa, kʉlʉnge ʉli? Itɨɨ, kitʉme mɨlandʉ, kʉnsoko kɨkʉtilɨ mʉ ngulu niya malagɨɨlyo, ingɨ kʉkolɨ mʉ ʉtemi nʉwa ʉkende wang'wi Itunda ne? A, a! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />Mʉlɨngile kɨna anga mipumye ʉnyenye kʉtula mɨatʉʉng'wa nʉ kʉmija mʉntʉ, maina mɨatʉʉng'wa atai kʉ mʉntʉ nʉanso. Hangɨ anga mipumye ʉnyenye kʉtula mɨatʉʉng'wa amɨlandʉ mpelo anyu mʉkʉsha, ingɨ anga mipumya ʉnyenye kʉmija Itunda mpelo anyu mʉkʉgombeka kʉng'wi Itunda. <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />Itungo ɨlɨ nʉmʉlʉmbile Itunda palʉng'wɨ nɨ kɨna ɨkalɨ aɨmɨatʉʉng'wa a mɨlandʉ, mʉkete lwijo kʉng'wi Itunda mʉnkolo yanyu kʉ ʉmanyisi naɨ mʉmanyisigwe. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />Aɨmkomowe mʉ ʉtʉʉng'wa nʉwa mɨlandʉ, maile mɨatʉng'wa akitʉma aya nʉmaloilwe Itunda. <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />Ndigitilye nʉnyenye kʉmpyani a mʉtʉʉng'wa ingɨ mʉhume kʉninga nɨkʉtambʉla. Pakalɨ aɨ miatʉʉng'wa amɨlandʉ naɨmɨpumilye ʉnyenye kʉtula kɨntʉ kakitʉmɨla makani nɨmabɨ, nɨmɨlandʉ anyʉ aɨɨdʉ ikɨlo. Ʉʉgwa nitungo ɨlɨ mʉtakɨwe mɨpumye kʉng'wi Itunda mʉtule mɨatʉʉng'wa kʉnkani yang'wi Itunda, mʉhʉme kitʉma makani nagombekile kʉng'wi Itunda.<verse eid="ROM 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20" />Naɨmʉkɨlɨ mɨatʉʉng'wa amɨlandʉ shanga aɨmɨsɨga kitʉma naamʉloeeye Itunda. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />Itungo ɨlɨ, mapantɨkile ntʉni kʉ makani aya nɨmʉkʉmaone minyala itungo ɨlɨ? Mpelo a makani aya ingɨ ɨnsha. <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />Ingɨ itungo ɨlɨ malekewe mʉʉtʉng'wa nʉwa mʉmɨlandʉ maina mɨitʉmi ang'wi Itunda, itungo ɨlɨ maile mɨitʉmi ang'wi Itunda, kɨpegwa kanyu ingɨ maile mɨantʉ ang'wi Itunda. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />Kʉnsoko, anga witʉme mɨlandʉ ʉlɨnge kɨna ʉkʉsha, anga witʉme namʉloeye Isekʉlʉ Kilisito. Kipegwa kang'wi Itunda ingɨ ʉpanga nʉwa kalɨ na kalɨ.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">Mpyani a witɨni</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />Anyandʉgʉ ane, itungo ɨlɨ nɨmʉgila nkankani mʉkʉlɨnga nɨkʉtambʉla, kʉnsoko kʉtambʉla nɨantʉ nɨalɨngile ɨmalgɨɨlyo. Malagɨɨlyo akete ngulu kʉ mʉntʉ nɨ mʉpanga. <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />Kʉmpyani mʉsʉngʉ nʉtɨnilwe ingɨ wɨza ʉkolɨ mʉkɨtungo ka ʉtɨnwi ka mʉgoha matungo ɨhi nʉ mʉgoha wakɨlɨ mʉpanga, ingɨ anga mʉgoha washe, mʉsʉngʉ nʉwanso wɨtungʉɨlwa nilagɨɨlyo nɨla witɨni. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />Kʉlʉlo gwa mʉsʉngʉ nʉwanso anga watɨnwe nʉ mitʉnja mʉngɨza kʉnʉ mʉgohakwe ɨze mʉpanga, antʉ ɨmitanga mʉgoolyi. Ingɨ anga mʉgoha washe, mʉsʉngʉ nʉwanso wɨtula wagombigwa nilagɨɨlyo nɨla ʉtɨnwi, anga watɨnwe nʉ mitʉnja mʉngɨza antʉ shanga akʉmitanga mʉgoolyi. <verse eid="ROM 7:3" /><verse number="4" style="v" sid="ROM 7:4" />Nʉnyenye ga anyandʉgʉ ane, malekewe kʉpuma mʉ malagɨɨlyo ang'wa Musa kʉkɨɨla mʉ mʉɨli wanyu nʉwa kalɨ naɨmʉkʉle palʉng'wɨ nʉ Kilisito. Itungo ɨlɨ maile mɨantʉ ang'wa Yesʉ kʉkɨɨla mʉwiʉki wakwe, ingɨ kʉhume kitʉma makani nɨmaza namʉloeye Itunda. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />Kʉnsoko, naɨkishiɨ anga antʉ nɨishiɨ, nsʉla akitʉma mɨlandʉ kɨsakigwa nɨ malagɨɨlyo aɨkitʉma mɨlandʉ mʉ mɨɨlɨ itʉ, ʉsese kɨhi aɨkʉzeehiɨla mʉnsha. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />Pakalɨ aɨkʉtungilwe mʉ ngulu a mɨlandʉ, ingɨ itungo ɨlɨ kakʉle palʉng'wɨ nʉ Kilisito, itɨ gwa kalekewe mʉgulu niya malagɨɨlyo. Itungo ɨlɨ shanga kʉmitʉmɨla Itunda kʉkɨɨla malagɨɨlyo akalɨ naandɨkilwe. ingɨ kʉʉmitʉmɨla Itunda anga ʉ Ng'wahʉ Ng'welʉ wang'wi Itunda nʉloilwe.<verse eid="ROM 7:6" /></para>
  <para style="s">Malagɨɨlyo nɨ mɨlandʉ</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />Itɨɨ, itungo ɨlɨ kʉlʉnge ʉlɨ, kʉlʉnge ɨmalagɨɨlyo mʉlandʉ ne? A, a! Ingɨ nɨkʉtilɨ malagɨɨlyo ʉnene shanga kʉlɨnga mʉlandʉ kɨntʉ kɨɨ? Kʉnsoko, shanga aɨnzelɨnga ʉbɨ nʉwa kʉawa kitʉ kɨɨ, anga ize shanga malagɨɨlyo alagɨɨye, “Leka kʉawa” <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />Ingɨ naɨnalɨnga malagɨɨlyo ang'wa Musa, papo ɨkasasha nsʉla mbɨ mʉnkolo ane. Kolwa, malagɨɨlyo ang'wa Musa anga ɨze kʉtilɨ mʉlandʉ wɨtula ʉgila anga ngulu. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />Itungo lɨng'wɨ ʉnene naɨ nkɨlɨ kʉlɨnga malagɨɨlyo ang'wi Itunda aɨnishiɨ mʉndoewe. Ingɨ naɨ nɨngile malagɨɨlyo natakile, nɨkalɨnga kɨna nɨ mʉnyamɨlandʉ, <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />nɨkamanya kɨna malagɨɨlyo aɨaɨkilwe kʉsasha ʉpanga, kʉng'wane asakilye kʉlamʉlwe kʉnsha. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />Kʉlʉlo mʉlandʉ wɨkankongela kʉkɨɨla malagɨɨlyo nanso, nʉkʉsasha namʉlwe kʉnsha. <verse eid="ROM 7:11" /><verse number="12" style="v" sid="ROM 7:12" />Itɨɨ gwa ilɨngɨkile kɨna, malagɨɨlyo apembeeye kʉng'wi Itunda, kʉnsoko apembeeye kʉng'wi Itunda malagɨɨlyo nanso ingɨ maza hangɨ agombekile kʉng'wi Itunda. <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />Itɨɨ gwa, kʉlʉnge itɨ kɨntʉ nɨkɨza kɨsakilyene ʉnene namʉlwe kʉsha? A, a! Ingɨ, mʉlandʉ ʉhume kigeeleka kɨna mʉlandʉ, ʉkɨɨe kʉ nsha kʉheja ɨkɨ nɨkɨza. Kʉlʉlo kʉkɨɨla malagɨɨlyo nanso, mʉlandʉ wigeelekile kɨna ʉbɨ ikɨlo.<verse eid="ROM 7:13" /></para>
  <para style="s">Wikʉngʉmi mʉ mʉntʉ</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />Kʉlɨngile kɨna malagɨɨlyo ingɨ makani a kɨnkolo, ʉnene shanga nɨa kɨnkolo, nagʉigwe ntule mʉtʉʉng'wa mʉmɨlandʉ. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />Shanga nɨngile nɨkitʉma, kʉnsoko ɨkɨ nɨndoilwe kitʉma shanga kitʉma, nɨkɨ nɨ nɨkɨbɨpɨwe kɨko kitʉma. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />Anga ituleʉ, nzitʉma lɨlɨ nɨshanga lɨndoeye mʉnkolo ane, izeze ngombile kɨna ɨmalagɨɨlyo maza. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />Itɨ gwa, shanga nene kitʉma nɨshanga nɨkɨloilwe, ingɨ mʉlandʉ nɨkolɨ mʉ ng'wane wʉwo witʉma aya nɨshanga nɨmaloilwe. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />Kʉnsoko nɨngile kɨna kʉtilɨ ikanɨ lɨhi niza mʉng'wane, mʉ kɨʉntʉ kane. Kʉnsoko, palʉng'wɨ kɨna ndoilwe kitʉma nɨndoilwe, shanga nɨkitʉma. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />Kʉnsoko ɨlɨ niza nɨ ndoilwe, shanga kitʉma, kɨmɨkɨɨli kakwe kitʉma yaya nɨmabɨ nɨshanga nɨndoilwe. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />Itɨ gwa, anga itule ɨlɨ nɨshanga ndoilwe lɨlo kituma, ingɨ itendile kɨna shanga nene nitʉmile, ingɨ mʉlandʉ ʉwo nʉʉkolɨ mʉng'wane. <verse eid="ROM 7:20" /><verse number="21" style="v" sid="ROM 7:21" />Kʉitɨ gwa, nalɨnga anga nihie kitʉma ikani niza, ingɨ nɨhanga kitʉma ʉbɨ. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />Mʉnkolo ane nɨloeeye malagɨɨlyo ang'wi Itunda. <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />Ingɨ nalɨnga kɨna amolɨ malagɨɨlyo mangɨza ɨkikʉngʉma kitʉma mʉng'wane, malagɨɨlyo nɨ nsuta nɨ malagɨɨlyo namolɨ mʉ mahala ane. Itɨ gwa ɨntenda ntule nɨmʉtʉʉng'wa nʉwa mɨlandʉ nʉwitʉma mʉlɨmo mʉ mʉɨlɨ wane. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />Ikani ɨlɨ lɨkʉndetela ʉkɨa, nyenyu ʉkʉnguna nihege mʉ mʉɨlɨ ʉwʉ nʉʉnihongilye mʉnsha? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />Nʉ wakʉligwe Itunda kʉnsoko ang'wa Kilisito Yesʉ Isekʉlʉ wane! Itɨ ingɨʉ nɨlɨ.</para>
  <para style="p" vid="ROM 7:25">Ʉnene nɨ ning'wene mʉ mahala ane kitʉma malagɨɨlyo ang'wi Itunda, ingɨ kɨmʉɨlɨ nɨhanga kitʉma mɨlandʉ.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">Ʉpanga mʉ Ng'wahʉ Ng'welʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />Kʉlʉlo gwa, itungo ɨlɨ kʉtilɨ ʉlamʉlwi kʉ antʉ ɨhi nɨakʉmʉsania ʉ Kilisito Yesʉ, nɨshanga akee maintʉ amʉɨlɨ ʉdu ingɨ nɨanso atyatile maintʉ a Ng'wahʉ. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />Kʉnsoko, malagɨɨlyo a Ng'wahʉ nɨleta ʉpanga mʉʉkamantani nʉ Kilisito Yesʉ akʉtungʉe mʉ malagɨɨlyo a mɨlandʉ nɨsasha nsha. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />Itunda aɨwitʉmile makani aya nɨ malagɨɨlyo shanga ahumile kitʉma, kɨʉntʉ kɨagila ngulu. Itunda wɨkamʉlagɨɨlya ʉ Ng'waakwe wɨkaza kɨ mʉɨlɨ anga ʉsese nɨkɨlɨ, kʉkɨɨla mʉɨlɨ wakwe aɨʉhegilye ʉ mʉlandʉ. <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />Itunda aɨwitʉmile itɨ ingɨ kʉhume kituma aya natakɨwe nɨ malagɨɨlyo, shanga kitʉma makani nɨkʉloilwe ʉsese, ingɨ kitʉma makani nʉloilwe ʉ Ng'wahʉ. <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />Itɨ gwa antʉ nɨishiɨ kʉkela mʉɨlɨ mʉʉloilwe, ɨsɨga anga makani a mʉɨlɨ. Ingɨ antʉ nɨishiɨ kʉtyata nʉloilwe ʉ Ng'wahʉ Ng'welʉ, ɨsɨga misɨgo lɨlo. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />Masɨgo akɨʉntʉ ɨsasha nsha, nɨ masɨgo a Ng'wahʉ ɨsasha ʉpanga nɨ matiliga. <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />Kʉnsoko masɨgo akʉʉkela mʉɨlɨ du siagombilwe ni Itunda, shanga ɨkela malagɨɨlyo ang'wi Itunda, hangɨ shanga ahumile kʉkela. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />Nɨ antʉ nɨɨtyata makani a kɨmʉɨlɨ nʉwa mɨlandʉ, shanga ahumile kitʉma makani nagombekile kʉng'wi Itunda.<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />Ingɨ ʉnyenye shanga mishiɨ anga mʉɨlɨ mʉʉloewe, mishiɨ kʉtyata Ng'wahʉ nʉloewe, anga ɨze ʉdu Ng'wahʉ Ng'welʉ ʉkolɨ mʉng'wanyu. Mʉntʉ wɨhi nɨmʉgila Ng'wahʉ wang'wa Kilisito, nʉwanso shanga mʉntʉ wang'wa Kilisito. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />Ingɨ anga itule ʉ Kilisito ʉkolɨ mʉng'wanyu, palʉng'wɨ nʉkʉtula mɨɨli anyu ɨtuile anga akule kʉnsoko a mɨlandʉ, ingɨ mʉnkolo yanyu mɨapanga kʉnsoko a kitʉma namʉloile Itunda. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />Nʉnyenye anga ɨze Ng'wahʉ Ng'welʉ aʉmiʉkilye ʉ Kilisito wikiɨ mʉng'wanyu, ʉʉgwa nʉwanso naɨ ʉmiʉkilye ʉ Kilisito ʉkʉmɨpangatalya nɨ mɨɨlɨ anyu nɨlemigwe nɨnsha, ʉkʉtenda itɨ kʉkɨɨla a Ng'wahʉ wakwe nʉwishiɨ mʉng'wanyu.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />Kʉlʉlo anyandʉgʉ ane, kʉkete mʉlɨmo, ingɨ ʉsese shanga kʉtakɨwe kishiɨ kʉtyata mʉɨlɨ nʉʉloewe. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />Kʉnsoko anga mishiɨ ɨze mʉtyatile ntendo niya mʉɨlɨ nʉwa mɨlandʉ, shanga mʉkingɨle mʉ ʉpanga nʉwa kalɨ na kalɨ. Ingɨ anga itule kʉkɨɨla Ng'wahʉ mʉkʉibʉlaga intendo yanyu nimbɨ, itɨ gwa, mʉkingɨla mʉ ʉpanga nʉwa kalɨ na kalɨ. <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />Antʉ ɨhi nɨɨtongwa nʉ Ng'wahʉ Ng'welʉ antʉ nɨanso wawo ana ang'wi Itunda. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />Kʉnsoko, shanga mʉpewe nkolo aʉtʉng'wa nɨleta ʉwoa, ingɨ mʉsɨngɨɨye Ng'wahʉ nʉwa kʉmʉpa ʉhumi mʉtule mɨana ang'wi Itunda, nʉ Ngwa'hʉ nʉwanso ʉsese kʉʉmitanga Itunda, “Abba” ʉng'waao “Tata!” <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />Nʉ Ng'wahʉ Ng'welʉ ng'wenso witambʉla mʉnkolo yɨtʉ kɨna ʉsese kɨ ana ang'wi Itunda. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />Itɨ gwa, kʉnsoko ʉsese kɨana ang'wi Itunda, kʉʉsɨngɨɨlya ʉkembetwi wɨhi nʉwang'wi Itunda naʉaɨkɨye antʉ akwe, hangɨ kʉʉsɨngɨɨlya makani nanso palʉng'wɨ nʉ Kilisito, kʉlʉ kʉʉlʉ anga kagigwe palʉng'wɨ nʉ Kilisito, kʉ ʉkʉligwa palʉng'wɨ nʉng'wenso.<verse eid="ROM 8:17" /></para>
  <para style="s">Ikʉlyo nɨlɨpembilye</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />Kʉona ʉlwago litungo ɨlɨ shanga mbaiye anga kɨntʉ, anga nimpyanie nʉkʉlʉ lang'wi Itunda nɨlɨkigeeleka kʉng'witʉ mahikʉ napembilye. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />Kʉlʉlo iʉmbwa yihi yilindɨɨe kʉ nsʉla lʉhikʉ nʉla kʉɨkwa kɨhenga kʉ ana ang'wi Itunda. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />Kʉnsoko, iʉmbwa yɨhi aɨyiɨkilwe mʉ ʉnementalʉ, shanga kʉ ʉlowao, ingɨ anga nʉloilwe Itunda. Nɨitɨ ga ɨkolɨ isʉmbɨɨlyo, <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />ingɨ iʉmbwa nizo yilindɨɨe kʉkomolwa mʉ ʉtʉʉng'wa nʉwa ʉbɨ, yingɨle mʉwidesi mʉʉkʉlʉ palʉng'wɨ nɨ ana ang'wi Itunda. <verse eid="ROM 8:21" /><verse number="22" style="v" sid="ROM 8:22" />Kʉnsoko kʉlɨngile kɨna kʉpikɨɨla itungo ɨlɨ, iʉmbwa yɨhi yikilɨɨla naʉwai anga itungo mʉsʉngʉ nʉkʉtuga. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />Ingɨ shanga iʉmbwa du niimolɨ mʉ lwago, ingɨ nʉsese ga nɨkʉkete Ng'wahʉ, nʉwa ng'wandyo mʉipegwa yang'wi Itunda, nʉsese kʉʉalɨka mʉnkolo yitʉ, kʉlindɨɨe kʉtendwe kɨana ang'wi Itunda, mɨɨlɨ itʉ ɨkʉkomolwa. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />Kʉnsoko kisʉmbɨɨlyo nɨlanso ʉsese kɨna kakomowe. Ingɨ isʉmbɨɨlyo igila anga kɨntʉ anga itule kʉkɨine ɨkɨ nɨkʉkɨsʉmbɨɨye, kʉnsoko nyenyu nʉwɨsʉmbɨɨlya ɨkɨntʉ nʉkɨine? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />Anga ize kʉkɨsʉmbɨɨye ɨkɨ nɨ kɨagila, lʉlogwa, kiʉmɨɨlya kʉkɨlindɨɨla.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />Ʉsese kɨagila anga ngulu, itigwa Ng'wahʉ wɨkʉaɨɨlya kʉlompa, kʉnsoko shanga kʉlɨngile kʉlompe ʉlɨ, nʉ Ng'wahʉ wɨkʉlompeelya kʉng'wi Itunda kʉlʉli nʉla kilɨɨla nɨshanga lʉhumile kʉganʉlwa. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />Itunda nɨwiona namolɨ mʉnkolo yitʉ, ʉlɨngile ɨmasɨgo a Ng'wahʉ, ingɨ Ng'wahʉ nʉwanso wɨalompelya antʉ anga mʉloewe Itunda.<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />Nʉ sese kʉlɨngile kɨna mʉ makani ɨhi Itunda witʉma mʉlɨmo palʉng'wɨ nɨ antʉ ɨhi nɨamʉloilwe, kʉapa makani nʉmasɨgɨɨe, ingɨ awa nʉitangile atule antʉ akwe. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />Antʉ awa naɨʉahoile kʉpuma ʉng'wandyo, wawo aɨʉakomile ahume kimpyana nʉ Ng'waakwe, ingɨ Ng'waakwe watule wang'wandyo mʉndʉgʉ yidʉ. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />Nɨ antʉ naɨʉahoile wawo aʉitangile, nɨ antʉ naɨʉitangile ingɨ wawo aɨʉapee ʉkʉlʉ, nawa naɨʉapee ʉkʉlʉ aɨʉapee ʉkʉlʉ lakwe.<verse eid="ROM 8:30" /></para>
  <para style="s">Ʉlowa wang'wi Itunda kʉng'wa Kilisito Yesʉ</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />Kʉlʉnge ʉlɨ gwa mʉ makani nanso? Itunda anga watule ʉkolɨ kipande litʉ, nyenyu nʉhumile kʉʉkɨngɨla? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />Itunda shanga aɨʉmʉgiɨye ʉ Ng'waakwe nʉwing'wene, wɨkamʉpumya kʉnsoko itʉ kɨhi. Anga ituleʉ aʉtendile, itɨɨ, ʉkʉleng'wa ʉlɨ kʉʉkendepa ʉkende wɨhi palʉng'wɨ nʉng'wenso? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />Itɨɨ, nyenyu gwa nʉhumile kʉasemela antʉ ni Itunda ʉahoile? Ingɨ Itunda ng'wenso wɨahegelya magazo! <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />Nyenyu gwa nʉkʉlamʉla apɨsɨɨligwe? Kʉtilɨ, kʉnsoko Kilisito Yesʉ ng'wenso aʉkule, nʉkiʉka, nʉyo ʉkolɨ ipande nɨla ʉhumi kʉng'wi Itunda, ng'wenso wikʉlompelya ʉsese! <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />Nyenyu nʉhumile kʉʉkoma nʉ ʉlowa wang'wa Kilisito? Itɨɨ, lwagone ang'wɨ ʉhiɨlwa ang'wɨ wagigwi, ang'wɨ nzala, ang'wɨ ʉʉlya matugalo, ang'wɨ ʉlʉgʉ, ang'wɨ nshane? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />Anga Ʉandɨkwa wang'wi Itunda nʉʉandɨkile,</para>
  <para style="p" vid="ROM 8:36">“Kʉnsoko ako ʉsese nɨkaile kɨakʉnsha,</para>
  <para style="p" vid="ROM 8:36">kɨaligwa anga nkolo niyisɨnzwa.” <verse eid="ROM 8:36" /><verse number="37" style="v" sid="ROM 8:37" />Ingɨ, mʉ makani nanso ɨhi, kʉlongolekile kʉhuma kʉnsoko kɨaɨɨligwa nʉ Kilisito naɨʉkʉloilwe. <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />Kʉnsoko nɨngile kʉlʉ kʉʉlʉ kɨna kʉtile kɨntʉ nɨkɨhumile kʉʉkomatʉla nʉʉlowa wang'wi Itunda, shanga nsha ang'wɨ ʉpanga, ang'wɨ amalaɨka ang'wɨ ngulu ningɨza niya kigʉlʉ, ang'wɨ mʉ makani nakʉpumɨla itungo ɨlɨ ang'wɨ napembilye panyambele, ang'wɨ ʉhumi, <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />itule makani namolɨ mʉ ʉnkumbigʉlʉ nʉwa migʉlya, ang'wɨ nʉwa mihɨɨ. Kʉtile kɨʉmbwa kɨhi nɨkɨhumile kʉʉkoma nʉ ʉlowa wang'wi Itunda nʉ ʉmolɨ mʉng'wa Kilisito Yesʉ Isekʉlʉ witʉ.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">Itunda nɨ antʉ akwe Aisilaeli</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />Kʉtambʉla tai ntilɨ mʉng'wa Kilisito, shanga kʉtambʉʉla ʉteele. Ng'wahʉ Ng'welʉ nʉtongilwe nkolo ane ʉlɨngile kɨna kʉtambʉla tai, <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />kʉhiya nʉnge itɨ, nkete ʉkɨa ʉkʉlʉ nʉ ʉwai nʉʉkʉawa mʉnkolo ane, <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />Anga ɨze ikani ɨlɨ lɨkʉaaɨɨlya, azangombile nzung'we nʉ kʉkong'wa nʉ Kilisito, kʉnsoko anyandʉgʉ ane nɨihɨɨ ane! <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />Antʉ awa ingɨ Aisilaeli Itunda naɨahoilwe atule ana akwe, waingɨlya mʉʉkʉlʉ lakwe, wɨkaɨka ilago nɨenso, wɨkaapa nɨ malagɨɨlyo, nʉʉhʉɨɨli nʉwatai nɨ malapo ang'wi Itunda. <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />Aisilaeli ingɨ izʉkʉlʉ a agʉkʉ a akalɨ, nʉ Kilisito kʉ kɨʉntʉ kakwe ʉtugɨwe mʉ Aisilaeli. Nʉyo ʉkolɨ migʉlya amaintʉ ɨhi, nʉwakʉligwe Itunda kalɨ na kalɨ! Yɨyɨ tai.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />Shanga kʉtambʉla kɨna ilago lang'wi Itunda lakaɨlɨka, kʉnsoko ingɨ Isilaeli akeehʉ nɨ Aisilaeli atai. <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />Angwɨ shanga ɨhi nɨatugilwe nʉ Ibulahimu ingɨ ana ang'wi Itunda. Ingɨ, Itunda aɨʉmʉɨɨe ʉ Ibulahimu, kɨna, “Wileli wakwe ʉkʉpuma mʉng'wa Isaki.” <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />Ihanga kʉlʉnga, shanga nɨatugilwe anga antʉ nɨɨtugwa akʉtula ana ang'wi Itunda. Ingɨ ana nɨatugilwe anga Itunda nʉtambʉe wawo akʉaligwa ana ang'wi Itunda. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />Kʉnsoko ɨko nʉtambʉe Itunda ingɨ sɨlɨ, “Kʉtulya hangɨ matungo nɨhanga yaya kʉng'waka, nʉ Sala ʉkʉlija ng'wana mʉgoha.<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />Shanga yayo du, nʉ Lebeka, aɨʉtugile mintʉtɨ ana ihe ʉng'wɨ, ingɨ Isaki gʉkʉ witʉ. <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />Ingɨ, yigeeleke kɨna Itunda ʉkete ʉhumi nʉwa kʉholania, napa ga naɨakɨlɨ kʉtugwa ɨana nɨ itʉtɨ, ang'wɨ naɨ akɨlɨ kʉlɨnga ni ibɨ ang'wɨ niza, <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />Lebeka aɨʉɨɨwe kɨna, “Ng'wana nʉ mʉkʉlʉ ʉkʉmitʉmɨla ʉ mʉniino wakwe.” Kʉlʉlo Itunda aɨʉhoile ng'wenso anga nʉloewe, shanga ntendo a kɨʉntʉ. <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />Anga nɨyandɨkilwe Mʉwandɨkwa wang'wi Itunda, “Aɨnʉmʉloilwe ʉ Yakobo, ingɨ nɨkamʉbɨpɨlwa ʉ Esau.”<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />Itɨgwa, kʉlʉnge ʉlɨ? Itɨɨ, Itunda shanga mʉkendene? Shangaʉ. <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />Kʉnsoko Itunda aɨʉmʉɨɨe ʉ Musa, “Kʉmʉaisɨɨlya mʉntʉ wɨhi nɨnʉmʉoilwe, kʉmʉonela kinyaʉwai mʉntʉ wɨhi nɨnʉmʉloilwe. <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />Kʉlʉlo maintʉ ɨhi shanga asanilye anga ngulu niya antʉ ang'wɨ mʉ mʉntʉ nʉloewe, ingɨ asanilye kɨaisa kang'wi Itunda. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />Kʉnsoko Ʉandɨkwa wang'wi Itunda wandɨkilwe itɨ kʉ mʉtemi Palao, “Aɨnʉkʉɨkile mʉ ʉtemi ingɨ nigeelye ngulu yane kʉng'wako, nɨ lina lane lɨtanantigwe mʉ mahɨɨ ɨhi.” <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />Kʉlʉlo gwa, Itunda wɨmʉaisɨɨlya mʉntʉ wɨhi nʉloilwe kʉmʉaisɨlya, hangɨ anga walowe kʉmʉtenda mʉntʉ watule wɨlʉgoha, wɨmʉtendaʉ.<verse eid="ROM 9:18" /></para>
  <para style="s">Ikʉo lang'wi Itunda nɨ kɨaisa kang'wi Itunda</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />Itɨ gwa mɨkankolya, “Ang'wɨʉ, Itunda ʉkʉhuma ʉlɨ kʉmʉsosha mʉntʉ? Kʉnsoko nyenyu nʉhumile kʉgilya makani ni Itunda ʉmaloilwe?” <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />Ingɨ, ʉewe nʉwing'waa mʉntʉ, wɨnyenyu ʉewe nʉkikʉngʉma ni Itunda? Itɨɨ, ɨkɨntʉ nɨkɨʉmbilwe kɨhumilene kʉkolya, “Nɨkɨ ʉmʉmbile itɨ?” <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />Itɨɨ, mʉkanyi ilongo shanga ʉhumilene kʉtendeela ilongo mʉloewe, ʉhumile kʉʉmba yʉngʉ ibɨɨlɨ kilongo lɨlo lɨɨlo, kɨng'wɨ ʉkʉkɨsania ɨkɨʉya ʉkʉkɨdalaha.<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />Itɨʉ yɨlɨ kʉng'wi Itunda. Aɨʉkʉhiya kʉlagɨɨla ikuo lakwe nʉkʉkʉmʉʉla ʉhumi wakwe. Itɨ gwa, aɨʉalindɨɨe nʉ kiʉmɨɨlya kʉ antʉ naɨatakɨwe kʉhangwa nikʉo lakwe, antʉ naɨatakɨwe kʉlimansɨɨligwa. <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />Yitule ʉlɨgwa, anga itule nʉwanso aɨʉtendile itɨ wahume kʉtanantya ʉkʉlʉ wakwe kʉ antʉ naɨʉahoile asɨngɨɨlye kɨaisa kakwe. Itunda aɨwakondya kʉanoneelya ingɨle mʉʉkʉlʉ wakwe. <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />Ingɨ antʉ nɨanso sese naɨ ʉkitangile, shanga kʉ Ayahudi du ingɨ kʉpuma antʉ nɨshanga Ayahudi. <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />Kʉnsoko anga Itunda nʉtambʉe mʉmbugulu a mʉmanga Hosea kɨna,</para>
  <para style="q" vid="ROM 9:25">“Awa naɨshanga antʉ ane</para>
  <para style="q" vid="ROM 9:25">kʉitanga, antʉ ane.’</para>
  <para style="q" vid="ROM 9:25">Nʉyu, ‘Nɨshanga mʉlowa,</para>
  <para style="q" vid="ROM 9:25">kʉmitanga mʉlowa wane.’<verse eid="ROM 9:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ROM 9:26" />Napoitɨ naɨaɨɨwe, ‘Ʉnyenye shanga mɨana ang'wi Itunda’</para>
  <para style="q" vid="ROM 9:26">akitangwa, ana ang'wi Itunda nɨ mʉpanga.”<verse eid="ROM 9:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27" />Isaya mʉmanga wang'wi Itunda nʉyo, aʉatambʉɨe Aisilaeli, “Palʉng'wɨ nʉkʉtula Aisilaeli ɨdʉ anga ʉmʉhanga hanga nʉwa lʉzɨ, ingɨ nɨakʉkomolwa akeehʉ da, <verse eid="ROM 9:27" /><verse number="28" style="v" sid="ROM 9:28" />kʉnsoko Isekʉlʉ shanga ʉkʉtinia kʉʉpɨsɨɨlya ʉnkumbigʉlʉ kʉ ʉlamʉli nʉ ʉkondanɨɨe.” <verse eid="ROM 9:28" /><verse number="29" style="v" sid="ROM 9:29" />Hangɨ anga Isaya nʉwatongee kʉlʉnga, “Isekʉlʉ Mʉkola Ngulu yɨhi anga aɨwaleke kʉʉsagɨlya ana nɨang'wɨ nɨa Aisilaeli, aɨkʉziimpyana nɨ antʉ akʉ Sodoma, nɨ antʉ akʉ Gomola.”<verse eid="ROM 9:29" /></para>
  <para style="s">Aisilaeli ni Mpola Ninza</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />Kʉlʉlo kʉlʉnge ʉlɨ gwa? Antʉ nɨshanga Ayahudi nɨshanga adumile kʉgombwa ni Itunda, agombilwe ni Itunda kʉʉhʉɨɨli, <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />ingɨ Aisilaeli naɨakagupile kʉduma kʉgombwa ni Itunda kʉtyata malagɨɨlyo shanga ɨkahuma. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />Kʉnsoko kɨɨ? Kʉnsoko aɨasanilye ntendo niyao ɨkaleka kʉsania ʉhʉɨɨli. Ɨkʉmpa migwe nɨlɨsasha antʉ agwe.” <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />Anga niyandɨkilwe Mʉwandɨkwa wang'wi Itunda.</para>
  <para style="q" vid="ROM 9:33">“Kolwi, nɨkaɨka igwe kʉ Sayuni</para>
  <para style="q" vid="ROM 9:33">nɨlakʉsasha antʉ agwe,</para>
  <para style="q" vid="ROM 9:33">kɨntʉ ka kʉatenda antʉ atende mʉlandʉ.</para>
  <para style="q" vid="ROM 9:33">Ingɨ kʉ mʉntʉ nʉkʉ mʉhʉɨɨla shanga ʉkʉhumigwa mɨnyala.”<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />Anyandʉgʉ ane, ndoilwe nʉ kʉsʉmbɨɨlya mʉnkolo ane ɨhi, Aisilaeli akomolwe. Hangɨ mahikʉ ɨhi kʉalompeela kʉng'wi Itunda. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />Kʉnsoko kʉmʉɨla kɨna nɨanso akagupile kʉmʉduma Itunda, ingɨ ʉkagupi wao shanga ɨpembeeye mʉʉmanyi nʉwa tai. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />Shanga aɨalɨngile itɨ Itunda wɨatenda antʉ agombekile kʉng'wakwe. Antʉ agemile kʉtyata ntendoao amɨhitile ɨnzɨla ang'wi Itunda nakʉatenda agombeke kʉng'wakwe. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />Kʉlʉlo kɨza kʉng'wa Kilisito wamatendile malagɨɨlyo ang'wa Musa aleke kʉtula kɨntʉ ka kʉsania kʉ antʉ ɨhi nɨakʉmʉhʉɨɨla Itunda. Ingɨ antʉ ɨgombwa ni Itunda kʉkɨɨla kʉmʉhʉɨɨla ʉ Kilisito.<verse eid="ROM 10:4" /></para>
  <para style="s">Ʉgunwi ingɨ kʉ antʉ ɨhi</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />Kʉ mpola niyakʉgombeka kʉng'wi Itunda kɨze kʉtyatile malagɨɨlyo, Musa aɨʉtambʉe itɨ, “Mʉntʉ wɨhi nʉkʉtimɨlya malagɨɨlyo nalagɨigwe ʉkishiɨ kʉtyata malagɨɨlyo nanso.” <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />Ingɨ kitʉme makani nagombekile kʉng'wi Itunda kʉkɨɨla ʉhʉɨɨli, yandɨkilwe itɨ, “Ʉleke kʉlʉnga mʉ nkolo ako kɨna ‘Nyenyu nʉkʉnankɨla kigʉlʉ?’ Kʉlʉnga itɨ yihanga kʉmʉsimya pihɨ ʉ Kilisito. <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />Hangɨ ʉleke kʉlʉnga, “Nyenyu nʉkʉsima wende kʉʉlʉngʉ?” Kʉlʉnga itɨ yihanga wamʉpumye ʉ Kilisito kʉashi.” <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />Ʉandɨkwa wang'wi Itunda ʉtambʉe itɨ, “Lʉkani nʉlanso nʉlang'wi Itunda lʉkolɨ pakupɨ nʉewe, lʉkolɨ mʉ mʉlomo wako, nʉ mʉnkolo ako.” Nʉwanso wʉwo ʉhʉɨɨli wʉwo nɨkʉʉtanantya. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />Anga ʉtambɨle kʉ mʉlomo wako ʉewe kɨna ʉ Yesʉ ingɨ Isekʉlʉ hangɨ ʉhʉɨɨle mʉnkolo ako kɨna Itunda aɨʉmiʉkilwe, ʉkʉgunɨka. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />Kʉlʉlo mʉntʉ anga wahʉɨɨle mʉnkolo wɨkagombwa ni Itunda, hangɨ anga watambʉle kʉ mʉlomo wakwe, ʉkʉgunwa. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />Anga mʉyandɨkile Mʉwandɨkwa wang'wi Itunda, “Mʉntʉ wɨhi nʉmʉhʉɨɨe Yesʉ shanga ʉkʉhumigwa mɨnyala.” <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />Ikani ɨlɨ ingɨ laantʉ ɨhi, tilɨ kʉtemanʉla Mʉyahudi nʉyʉ nɨshanga Mʉyahudi, Isekʉlʉ waantʉ ɨhi, nʉyo mʉkende ɨtai taai kʉ antʉ ɨhi nɨɨmʉlompa. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />Kʉlʉlo Ʉandɨkwa wang'wi Itunda ʉtambʉe itɨ, “Mʉntʉ wɨhi nʉkʉmitanga Isekʉlʉ waaɨɨligwe, ʉkʉgunwa.”<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />Itɨgwa, akʉmʉlompa ʉlɨ ʉyʉ nɨshangaamʉhʉɨɨe? Hangɨ akʉmʉhʉɨɨla ʉlɨ nɨakɨlɨ kija impola yakwe? Akija ʉlɨ impola yakwe angaize kʉtilɨ mʉtanantyi? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />Hangɨ antu akʉtanatya ʉlɨ angaize shangaatʉmilwe? Anga niyandɨkilwe Mʉwandɨkwa wang'wi Itunda kɨna, “Ingɨ ikani lakʉloeelya kɨza kʉ antʉ nɨakʉtananatya Mpola Nza!” <verse eid="ROM 10:15" /><verse number="16" style="v" sid="ROM 10:16" />Ingɨ shanga antʉ ɨhi nɨaigombile Nkani Nza. Yɨyo nsoko ʉ Isaya aɨʉlʉngile, “Isekʉlʉ, itɨ nyenyu naɨʉhʉɨɨe impola yɨtʉ?” <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />Kʉlʉlo gwa, kʉhʉɨɨla yandɨɨlya kija Mpola Ninza, ni Mpola Ninza niyanso ize ipumile mʉlʉkani lang'wa Kilisito.<verse eid="ROM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18" />Ingɨ kʉkolya. Itɨɨ, nɨanso shanga aɨigulyene impola niyanso? Kʉlʉ kʉʉlʉ aɨigulye, Anga Wandɨkwa wang'wi Itunda nʉʉtambʉe,</para>
  <para style="q" vid="ROM 10:18">“Antʉ atanantilye Mpola niyang'wi Itunda ga yɨhi,</para>
  <para style="q" vid="ROM 10:18">antʉ igulye mpola yang'wi Itunda ga yɨhi mihɨɨ.”<verse eid="ROM 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 10:19" />Kʉkolya hangɨ, Itɨɨ ihumɨkile kɨna Aisilaeli shanga aɨalɨngilene? Kɨna Musa aɨwang'wandyo kʉlʉnga itɨ,</para>
  <para style="q" vid="ROM 10:19">“Kʉatenda mʉaonele wɨlu</para>
  <para style="q" vid="ROM 10:19">antʉ nɨshanga ihɨɨ ane,</para>
  <para style="q" vid="ROM 10:19">hangɨ kʉmʉsasha mʉtule nɨmakuo</para>
  <para style="q" vid="ROM 10:19">antʉ ihɨɨ aapʉngʉ.”<verse eid="ROM 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 10:20" />Hangɨ ʉ Isaya kʉlʉnga kʉ ʉkamatɨku kɨna,</para>
  <para style="q" vid="ROM 10:20">“Antʉ awa nɨshanga aɨɨnduma, ampantɨka,</para>
  <para style="q" vid="ROM 10:20">nigeeleka kʉ antʉ awo nɨshanga ɨduma impola yane.”<verse eid="ROM 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 10:21" />Ingɨ kʉ Aisilaeli Itunda ʉlʉngile itɨ, “Ng'ʉng'wɨ pii aɨnɨapepelya antʉ nɨapɨlʉki hangɨ nɨagila ʉlwijo.”<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">Kɨaisa kang'wi Itunda kʉ Aisilaeli</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />Itɨgwa kʉkolya, itɨɨ, Itunda waahitilene antʉ akwe? Shanga ʉahitile, ʉnene nɨ Mʉisilaeli ntugɨwe miele lang'wa Ibulahimu, mʉndʉgʉ ang'wa Benjameni. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />Itunda shanga ʉahitile antʉ akwe naɨʉhoile kʉpuma ʉng'wandyo. Mʉkɨmbʉkile nɨyitambʉwe Mʉwandɨkwa wang'wi Itunda, nɨyimʉtambʉe ʉ Elia itungo naɨʉmʉlɨɨe Itunda kʉnsoko Aisilaeli. <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />Elia aɨʉlʉngile itɨ, “Isekʉlʉ, aabʉlaga amanga ako akumʉla nitekeelo nɨlako. Nasaga ʉnene du, nawo akʉhiya kʉmbʉlaga.” <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />Itunda aɨʉmʉsʉkɨɨye ʉlɨ? “Aɨʉmʉɨɨe nkete antʉ ane elʉpu mʉpungatɨ nɨshanga amʉkʉiye mʉlʉngʉ Baali.” <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />Itɨ gwa, nɨyɨlɨ nitungo ɨlɨ, kʉnsoko a ʉkende akolɨ akeehʉ nɨahoilwe ni Itunda kʉtula antʉ akwe. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />Ingɨ ahoilwe kʉ ʉkende wang'wi Itunda, shanga kʉnsoko antendo yao. Anga ize ʉholanyi wakwe wazegoza ntendo niya antʉ, ʉkende shanga aɨʉzetula ʉkende hangɨ. <verse eid="ROM 11:6" /><verse number="7" style="v" sid="ROM 11:7" />Kʉlʉnge ʉlɨ gwa? Kɨntʉ ɨkɨ nɨ Aisilaeli aɨɨkɨduma, shanga ɨkakɨlija, ingɨ awo naɨahoilwe ɨkalija. Aisilaeli aʉya nɨasagile ɨkatendwa aleke kʉlɨnga lʉkani lang'wi Itunda. <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />Anga niyandɨkilwe mʉ Mʉwandɨkwa wang'wi Itunda kɨna, “Itunda wkaatenda antʉ awa atule anga alae, hangɨ kʉpikɨɨla itungo ɨlɨ shanga ahumile kʉgoza na mihoao, ang'wɨ kija mʉakʉtyɨao.” <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" />Daudi nʉyo aɨʉlʉngile,</para>
  <para style="q" vid="ROM 11:9">“Maloeelyaao nɨlɨtule itugwɨ lakʉaambisa,</para>
  <para style="q" vid="ROM 11:9">agwe nʉkʉpɨsɨɨligwa.<verse eid="ROM 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ROM 11:10" />Apokule kʉ miho apele kʉona,</para>
  <para style="q" vid="ROM 11:10">igube kʉmɨgongo mʉlwago nʉla mahikʉ ɨhi.”<verse eid="ROM 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />Kʉitɨ kʉkolya hangɨ. Itɨɨ, Ayahudi kigazo lao agwɨe lʉkʉlʉne? Shangaʉ! Kʉkɨɨla igazo lao, antʉ nɨshanga Ayahudi akomowe, ingɨ Ayahudi ahume akʉaonela wɨlu. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />Igazo nɨla Aisilaeli nɨitangwa Ayahudi lasakilye ʉkembetwa wɨdʉ kʉ ʉnkumbigʉlʉ, kʉlimansɨɨlya kʉng'wao kʉnsoko akʉleka makani a kɨnkolo yaletile ʉkembetwa ʉkʉlʉ kʉ antʉ nɨshanga Ayahudi. Itɨ gwa yigeelekile kɨna Ayahudi ɨdʉ anga amʉhʉɨɨle Itunda yɨkaleta ʉkembetwa ʉkʉlʉ kʉ antʉ nɨshanga Ayahudi.<verse eid="ROM 11:12" /></para>
  <para style="s">Kʉgunwa kʉ antʉ nɨshanga Ayahudi</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />Itungo ɨlɨ kʉmʉtambʉlya nyenye nɨshanga mɨ Ayahudi. Kʉnsoko ʉnene naile nɨmitʉmi kʉ antʉ nɨshanga Ayahudi, kiloelya ʉmʉlɨmo wane nʉwa kʉtanantya. <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />Nihume kʉatenda antʉ ihɨɨ ane amʉonele ʉnyenye wɨlu, kʉitɨ antʉ nɨang'wɨ nihume kʉaguna. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />Kʉnsoko anga itule kʉhitwa kʉng'wao yasakilye antʉ amahɨɨ atule ahʉmbaʉya ang'wi Itunda, yɨkatula ʉlɨ antʉ awa anga agombwe ni Itunda? Antʉ nɨakule ɨkiʉka!<verse eid="ROM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16" />Anga itule ntonge amʉkate ɨɨkilwe kʉnsoko ang'wi Itunda, mʉkate wɨhi ʉkʉtula waɨkwa pang'wi Itunda, mɨli amʉtɨ anga ɨtule ɨɨkilwe kʉnsoko ang'wi Itunda, nɨntambɨ ga yɨkʉtula yaɨkwa pang'wi Itunda <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />Ingɨ anga itule ntambɨ ying'wɨ niya mʉzeitʉni yatemilwe, pa ʉtemelwa nʉwanso ibabigwe ntambɨ niya mʉzeitʉni nʉwa mʉwɨɨ. Ʉnyenye nɨshanga mɨ Ayahudi ingɨ nyenye mɨ ntambɨ niya mʉzeitʉni, itungo ɨlɨ nʉnyenye mihanjaa mʉlikalo nʉlʉza nʉla Aisilaeli. <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />Itɨ gwa, mʉleke kʉadalaha antʉ nɨatemilwe anga ntambɨ. Hangɨ, mʉkiloelya ntʉni, kɨmbʉki shanga nyenye mʉambɨɨe itina, ingɨ itina lyenso lɨmʉambɨɨe ʉnyenye.<verse eid="ROM 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19" />Ingɨ mʉhumile kʉlʉnga, “Ntambɨ aɨyitemilwe kʉnsoko ʉnene nihume kʉbabigwa pang'wanso.” <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />Niituleʉ, aɨatemilwe naʉgila ʉhʉɨɨli, ingɨ ʉewe wɨmɨkile mʉhʉɨɨli wako. Leka kilolya, ingɨ imɨke ɨzewikeiye. <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />Kʉnsoko Itunda shanga aɨʉaaisɨɨye Ayahudi nɨimpyanigwe nintambɨ naɨitongee kʉpumɨɨla ʉng'wandyo, itɨɨ, ʉkʉmʉaisɨɨlyane ʉnyenye? <verse eid="ROM 11:21" /><verse number="22" style="v" sid="ROM 11:22" />Kolwi gwa, Itunda mʉkende hangɨ mʉtaki. Nʉwanso mʉtaki kʉ antʉ nɨɨmʉgazɨlya, hangɨ mʉkende kʉng'wako anga itule ʉkʉlongoleka kitʉma makani nʉmaloilwe, ang'wɨ shangaʉ nʉewe ga ʉkʉteng'wa. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />Nɨ Ayahudi ga anga atulye nʉkʉhʉɨɨla hangɨ Itunda, akʉsʉkigwa hangɨ mitina, kʉnsoko Itunda ʉkete ʉhumi nʉwa kʉababya hangɨ. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />Ʉnyenye antʉ nɨshanga mɨ Ayahudi, kʉpuma ɨkalɨ mɨhanga ʉ mʉzeituni nʉwa mʉwɨɨ, ingɨ mhegigwe kʉng'wanso, mababigwe mitina nɨla mʉzeituni nʉwa mʉkɨbʉʉlya ipande nɨshanga aɨlanyu. Ingɨ Ayahudi kʉʉpumo nɨanso wawo mʉzeituni nʉwa mʉkɨbʉʉlya, yikʉtula ipepele nangalʉ nɨanso kʉbabigwa hangɨ mitina nɨla mʉtɨ wao.<verse eid="ROM 11:24" /></para>
  <para style="s">Aisilaeli ɨhi akʉgunɨka</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />Anyandʉgʉ ane ndoilwe mʉlɨnge tai ɨyɨ nipihile mʉleke kiona mʉkete mahala ɨdʉ. Lʉgoha nʉla Ayahudi aɨkitungo iniino ʉdu, kʉpikɨɨla antʉ nɨshanga Ayahudi nɨakʉtula amʉhɨɨla Itunda. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />Papo antʉ akʉ Isilaeli ɨkakomolwa, anga nʉandɨkile Ʉwandɨkwa wang'wi Itunda,</para>
  <para style="q" vid="ROM 11:26">“Mʉkomoli ʉzile kʉpumɨɨla kʉ Sayuni</para>
  <para style="q" vid="ROM 11:26">nʉyo ʉkʉahegelya ʉ mʉlandʉ nɨatugɨwe mʉng'wa Yakobo.<verse eid="ROM 11:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ROM 11:27" />“Ɨlɨ lɨlɨ ilago lane nɨnzɨzaɨka nɨenso</para>
  <para style="q" vid="ROM 11:27">itungo nɨnzeheja mɨlandʉao.”<verse eid="ROM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28" />Kʉnsoko Ayahudi akʉhita Mpola Ninza,Ayahudi aɨle alʉgʉ ang'wi Itunda, ingɨ kʉnsoko kɨpegwa kanyu nɨshanga mɨ Ayahudi. Ingɨ kʉnsoko aɨahoilwe, akɨlɨ ɨkɨhʉmbashuya ni Itunda kʉnsoko agʉkʉao. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />Kʉnsoko Itunda anga wakondye kʉapa ɨantʉ ɨkɨpegwa kakwe nʉahole, shanga wɨkʉa ngali kɨna nɨkɨ ʉtendile itɨ. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />Pakalɨ ʉnyenye nɨshanga Mɨayahudi naɨmamʉpɨlʉkile Itunda, ingɨ itungo ɨlɨ mʉaisɨɨgwe kʉʉkende wakwe ʉdu kʉnsoko aʉpɨlʉki nʉwa Ayahudi. <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />Itɨ gwa, kʉnsoko aʉaisɨɨligwa nɨmʉkembetilwe ʉnyenye, Ayahudi ɨmʉpɨlʉka Itunda, itungo ɨlɨ nawo ga asɨngɨɨlya ʉaisɨɨligwa wang'wi Itunda. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />Kʉnsoko Itunda waatungile antʉ ɨhi kigazo lao nɨlakʉhita kʉmʉkʉlya nʉwanso wahume kʉaaisɨɨlya ɨhi.<verse eid="ROM 11:32" /></para>
  <para style="s">Itunda wakʉligwe</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />Kolwi. Itunda ingɨ mʉgolɨ kʉ nsao yɨdʉ ikɨlo, mahala nʉ ʉlɨngi wakwe ʉgila mpelo! Kʉtilɨ nʉhumile kʉganʉla makani nʉkʉmalamʉla Itunda, Kʉtilɨ nʉhumile kʉganʉla Itunda nʉkʉhiya kitʉma makani akwe! <verse eid="ROM 11:33" /><verse number="34" style="v" sid="ROM 11:34" />Wandɨkwa wang'wi Itunda ʉlʉngile.</para>
  <para style="q" vid="ROM 11:34">“Nyenyu naɨʉlɨngile masɨgo ang'wi Isekʉlʉ?</para>
  <para style="q" vid="ROM 11:34">Ang'wɨ nyenyu nʉhumile kʉmʉsɨja?<verse eid="ROM 11:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="ROM 11:35" />Ang'wɨ nyenyu naʉtongee kʉmʉpa hanza Itunda kɨntʉ kɨhi,</para>
  <para style="q" vid="ROM 11:35">wahume kʉsʉkɨɨligwa kɨntʉ nɨkanso?”<verse eid="ROM 11:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ROM 11:36" />Kʉnsoko intʉ yɨhi ipumile kʉng'wakwe, intʉ yɨhi yimolɨ kʉʉhumi wakwe hangɨ kʉnsoko akwe, ng'wenso nʉwapegwe ʉkʉlʉ wɨhi ɨkalɨ na kalɨ! Tai ituleʉ niituleʉʉ.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">Likalo nʉla kʉmitʉmɨla Itunda</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />Kʉlʉlo gwa anyandʉgʉ ane, kʉnsoko Itunda wakɨaisa kɨkʉlʉ, kʉminena kʉ ʉkende wakwe, pumi ʉnyenye akola kʉmitumɨla Itunda, mʉtule anga ipolyo nipanga, ipolyo nɨlakʉmʉloeelya Itunda. Ɨyɨ yɨyɨ nzɨla anyu natai nakʉmʉkʉlya Itunda. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />Mʉleke kʉsɨga anga antʉ a mʉʉnkʉmbigʉkʉlʉ ʉwʉ, ingɨ Itunda wamʉpiʉɨlye masɨgo anyu atule mapya. Pang'wanso papo mʉkʉhuma kʉlɨnga aya nʉmaloilwe Itunda nʉ kʉlɨnga ʉlʉkani nʉlʉza.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />Kʉ ʉkende nɨmpewe ni Itunda, kʉmʉɨla ʉnyenye mɨhi, leki kʉsɨgi kɨna ʉnyenye mɨaza kʉkɨla nɨmʉtakɨwe kʉtula. Masɨgo anyu mʉ ʉhʉɨɨli akepe anga mʉntʉ wɨhi nʉpewe ni Itunda. Migeme ʉnyenye nɨmɨlɨ kʉ ʉhʉɨɨli Itunda nʉmʉpee. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />Kʉnsoko anga ʉmʉɨlɨ nʉʉkete mapiliga ɨdu, shanga mapiliga ɨhi itʉma mʉlɨmo ʉng'wɨ. <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />Nʉ sese ga palʉng'wɨ nʉkʉtula kɨdʉ, kʉkɨɨla Kilisito kaile kɨmʉɨlɨ ʉng'wɨ, wɨhi mʉng'witʉ ingɨ ipiliga kʉ mʉya. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />Ingɨ kʉkete ipegwa yɨdʉ nɨkʉpewe. Mʉntʉ nʉkete ngulu akɨpegwa ka ʉmanga nʉwatende anga ʉhʉɨɨli wakwe nʉwɨlɨ. <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />Mʉntʉ nʉkete kɨpegwa ka kitʉma mʉlɨmo wang'wi Itunda nʉwitʉme. Mʉntʉ nʉkete kɨpegwa ka kʉmanyisa nʉwamanyise, <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />mʉntʉ nʉpewe ʉhumi wakʉsɨja aʉya, nʉwasije ɨaʉya, mʉntʉ nʉmʉkende kʉapa antʉ maintʉ nʉwa ape, mʉtongeeli nʉwakagupe kʉatonga aʉya, nʉyʉ nʉwa kɨaisa nʉwaaisɨɨlye aʉya kʉ ʉlowa.<verse eid="ROM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />Mʉleke kilowa kʉteele. Mʉbɨpɨlwe makani ɨhi nibɨ, komanɨɨlyi ikani niza. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />Milowe mɨhi kɨnyandʉgʉ, mʉntʉ wɨhi wamʉsɨgɨɨle ʉmʉya nʉkʉmʉkʉlya. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />Leki kʉkatapi kitʉma mʉlɨmo wang'wi Itunda. Ingɨ mitʉme kʉ nkolo ɨng'wɨ. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />Kʉsʉmbɨɨlya kʉng'wanyu itule kʉʉlowa, mʉtule nʉʉlowa mʉlwago lanyu, mʉlongoleke kʉmʉlompa Itunda mahikʉ ɨhi. <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />Aaɨɨlyi ɨantʉ nɨamʉhʉɨɨe itunda anga nyenye, asɨngɨɨlyi ageni kʉ ʉlowa.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />Mʉlompi Itunda waakembete antʉ nɨakʉmaja ʉnyenye, mʉlompi Itunda waakembete hangɨ waleke kʉazumi. <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />Iloi palʉng'wɨ nawa nɨiloile, lɨli palʉng'wɨ nawa nɨakʉlɨla. <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />Mʉlikalo lanyu milɨnge mɨhi. Leki kilolyi, ihanji nɨantʉ ɨhi. Hangɨ leki kilolyi kɨna mʉmanyile intʉ yɨhi.<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />Mʉntʉ anga wamʉtendeele ʉbɨ, mʉleke kʉmalya. Ingɨ mʉkagupe kitʉma makani antʉ nɨɨ kɨna maza. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />Itʉmi lɨhi nɨmʉhumile kitʉma, mʉtule nɨmatiliga nɨantʉ ɨhi. <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />Anyandʉgʉ ane, leki kʉmalyi, ingɨ mʉlekeli Itunda ikani nɨlanso, kʉnsoko yaandɨkilwe Mʉwandɨkwa wang'wi Itunda, Isekʉlʉ ʉlʉngile itɨ, “Ʉmalyi ingɨ mʉlɨmo wane, nene kʉmalya.” <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />Kimɨkɨɨli kakwe, yandɨkilwe kɨna “Mʉlʉgʉ wako anga ize mʉnyanzala, mʉpe indya walye, nʉyʉ nʉhumilwe nyota mʉpe mazɨ, wang'we, anga ʉtende itɨ ʉkʉhung'wa mɨnyala.” <verse eid="ROM 12:20" /><verse number="21" style="v" sid="ROM 12:21" />Leka kʉlemigwa nʉʉbɨ, ʉlemya ʉʉbɨ kʉ ʉkende.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">Kʉtula nʉ lwijo kʉ Atemi</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />Mʉntʉ wɨhi ʉtakɨwe kʉija atemi, kʉnsoko atemi ɨhi ɨpuma kʉng'wi Itunda, akʉlʉ nɨanso nɨatemile aɨkilwe ni Itunda. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />Mʉntʉ wɨhi nʉkʉapɨlʉka akʉlʉ nɨatemile, ʉkʉmʉpɨlʉka Itunda, nawa nɨakʉtenda itɨ akisakɨɨlya ʉlamʉlwi. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />Kʉnsoko mʉkʉlʉ nʉtemile shanga ɨmʉtumba mʉntʉ nʉɨtenda nɨmaza, ingɨ kʉ mʉntʉ nʉɨtenda nɨmabɨ. Apa gwa, ʉtakilene kʉmogopa mʉtemi? Itʉme nɨmaza nʉng'wenso ʉkʉʉlʉmba, <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />kʉnsoko mʉkʉlʉ nʉwanso nʉtemile ingɨ mɨtʉmi wang'wi Itunda ʉkitʉma kʉnsoko akʉʉaɨɨlya wewe. Ingɨ anga witʉme ʉbɨ, ʉʉgwa ʉkʉmogopa, kʉnsoko ʉkete ʉhumi nʉwa kʉʉpɨsɨɨlya. Nʉwanso ingɨ mitʉmi wang'wi Itunda, ʉhumile kʉmalya ʉbɨ kʉ antʉ nɨatendile ʉbɨ. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />Kʉlʉlo itakɨwe kʉija akʉlʉ nɨatemile, shanga kʉnsoko akogopa ʉpɨsɨɨlyi wang'wi Itunda, ingɨ kʉnsoko mʉlɨngile kɨna ikani nɨlanso iza kitʉma.<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />Kʉnsoko yɨyo yɨɨyo ʉnyenye mɨpumya kodi, kʉnsoko akʉlʉ nɨatemile nɨanso akʉmitʉmɨla Itunda nɨakʉtima mʉlɨmo nʉwao. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />Mʉlɨpi mʉntʉ wɨhi anga mʉitakɨwe, pamadaigwa ʉshʉlʉ, lɨpi ʉshʉlʉ, hangɨ pamadaigwa kodi, lɨpi kodi, ʉyʉ nʉwakogopwa, mogopi, nʉyʉ nʉwakʉkʉligwa, mʉkʉlyi.<verse eid="ROM 13:7" /></para>
  <para style="s">Kilowe anga kɨndʉgʉ</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />Leki kʉdaigwi nʉ mʉntʉ wɨhi, isage widayi nʉwa wilowi ʉdu. Mʉntʉ nʉkʉmʉlowa ʉmʉya, wɨtimɨlya malagɨɨlyo ang'wi Itunda. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />Kʉnsoko malagɨɨlyo ang'wi Itunda aya alagɨɨye, “Leka kʉgoolya hangɨ leka kʉbʉlaga hangɨ leka kia hangɨ leka kʉawa,” nɨ malagɨɨlyo maʉya ɨhi, ahangʉɨwe milagɨɨlyo lɨng'wɨ, “Mʉlowe ʉmɨako anga nʉwiloilwe ʉewe.” <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />Mʉntʉ nʉmʉloilwe ʉmʉya shanga ʉkʉmʉtendeela nɨ mabɨ, kʉlʉlo ʉlowi ʉkamɨnkɨɨye malagɨɨlyo ɨhi.<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />Nʉ nyenye tendiʉ, mʉlɨnge kʉmolɨ matungo kɨɨ, lɨlɨ itungo nɨlakʉʉka kʉpuma mʉtʉlo. Kʉnsoko ʉgunwi witʉ wahumbeela nangalʉ kʉkɨla itungo naɨkandilye kʉhʉɨɨla. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />Ʉtikʉ ʉlongelekile kela, nɨlyoa laakatoloka. Itɨ gwa kʉleke makani ɨhi nakiti, kipɨnde yɨgɨ yɨhi niya nzelya. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />Itigwa kishiɨ nʉ lwijo, anga nɨishiɨ antʉ ʉmʉnzelya hangɨ shanga kʉtula nʉ ʉlaku nʉ ʉgala ntʉlɨ ang'wɨ kʉtula nʉ ʉdobu nʉ ʉsambo nʉ wilei nʉ wɨlu. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />Mʉtakɨwe mitʉme anga Isekʉlʉ Kilisito naɨwitʉmile, mʉleke kitʉma makani a mʉɨlɨ nɨsasha mɨlandʉ.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">Leka kʉalamʉla ɨako</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />Mʉsɨngɨɨlyi mʉntʉ wɨhi nʉwa ʉhʉɨɨli ʉniino, ingɨ leki kʉmʉlamʉli mʉmasɨgo akwe. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />Antʉ shanga impyana, mʉntʉ ʉng'wɨ ʉhʉɨɨli wakwe ʉmʉgombilye kʉlya kintʉ kɨhi, nʉ mʉya ʉkete ʉhʉɨɨli ʉniino, wɨlya nyenyi niya mapwa dʉ. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />Mʉntʉ nʉwɨlya intʉ yɨhi waleke kʉmʉdalaha mʉntʉ nɨshanga ʉhumile kʉlya intʉ yɨhi, nʉ mʉtʉ nʉwɨlya nyenyi ya mapwa waleke kʉmʉlamʉla ʉmʉntʉ nʉwɨlya intʉ yɨhi, kʉnsoko Itunda ʉmʉgombile. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />Ʉewe wɨnyenyu nʉkʉmʉlamʉla mitʉmi nʉwamʉngɨza? Anga wimɨke ang'wɨ wagwe ʉkimɨkigwa ni mʉkʉlʉ wakwe, kʉnsoko mʉkʉlʉ ʉkete ʉhumi nʉwa kʉmimɨsha.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />Mʉntʉ ʉng'wɨ ʉhumile kʉsɨnga lʉhikʉ lʉng'wɨ lʉza kʉkila ʉlʉlya, nʉ mʉya ʉine mahikʉ ɨhi impyani. Mʉntʉ wɨhi nʉwatyate anga nʉsɨgɨɨe mʉmahala akwe. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />Mʉntʉ nʉkʉsɨgɨɨla lʉhikʉ lʉng'wɨ lʉza kʉkɨla ʉlʉlya, ʉtendile itɨ kʉnsoko akʉmʉkʉlya Itunda, nʉ mʉntʉ nʉkʉsɨgɨɨla ndya ying'wɨ nza, ʉkʉtenda itɨ kʉmʉkʉlya Isekʉlʉ kʉnsoko akʉmʉsongeelya Itunda. Nʉ mʉntʉ nʉkʉleka kʉlya indya ying'wɨ wɨtenda itɨ kʉnsoko akʉmʉkʉlya Isekʉlʉ, nʉ mʉntʉ ʉyʉ wɨmʉkʉlya Itunda. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />Kʉnsoko mʉng'witʉ kʉtilɨ mʉntʉ nʉwishiɨ kʉnsoko akwe ʉng'wenso, hangɨ kʉtilɨ mʉntʉ nʉwɨkuza kʉnsoko akwe ʉng'wenso. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />Itungo nɨkishiɨ, kishiɨ kʉnsoko ang'wi Isekʉlʉ, matungo anga kʉshe, kʉkule kʉnsoko ang'wi Isekʉlʉ. Itɨ gwa, anga kishiɨ ang'wɨ kʉshe, ʉsese kɨ antʉ ang'wi Isekʉlʉ. <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />Yɨyo nsoko Kilisito aɨʉkule, nʉkiʉka hangɨ watule Isekʉlʉ kʉ antʉ nɨapanga nawa nɨakʉle. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />Itɨ gwa, nɨkɨ ʉewe ʉmʉlamʉle ʉmʉnyandʉgʉ wako? Nʉewe, nɨkɨ ʉmʉdalahe ʉmʉnyandʉgʉ wako? Ʉsese kɨhi kʉzɨɨzimɨka pituntu nɨla ʉlamʉli nɨlang'wi Itunda. <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />Kʉnsoko Mʉʉandɨkwa yandɨkilwe itɨ, Isekʉlʉ ʉlɨɨye,</para>
  <para style="q" vid="ROM 14:11">“Anga nɨnogolekile kishiɨ,</para>
  <para style="q" vid="ROM 14:11">mʉntʉ wɨhi ʉzetugama pang'wane,</para>
  <para style="q" vid="ROM 14:11">hangɨ mʉntʉ wɨhi ʉzɨɨzatambʉla ʉng'weno kɨna ʉnene ni Itunda.”<verse eid="ROM 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 14:12" />Kʉlʉlo, mʉng'witʉ kɨhi kʉzɨɨzatambʉla impola niya likalo lakwe pang'wi Itunda.<verse eid="ROM 14:12" /></para>
  <para style="s">Leka kʉsasha kɨnkwaatya kʉ mɨɨako</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />Kʉlʉlo gwa, kʉleke kʉalamʉla ɨitʉ, ingɨ kʉsɨgɨɨla kʉleka kʉtula kɨnkwaatya kʉ anyandʉgʉ ang'wɨ kʉmʉsasha wagwɨle mʉmɨlandʉ. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />Mʉ mʉhangʉ ni Isekʉlʉ Yesʉ, ningile ɨkʉlʉ kʉʉlʉ kɨna kʉtilɨ kintʉ kɨhi kʉʉpumo wakwe nɨshanga kɨtakɨwe kʉmipoelya Itunda, ingɨ mʉntʉ anga wasɨge kɨna kɨntʉ ka kɨtʉʉnga shanga kɨtakɨwe kʉmipoelya Itunda, ʉʉgwa, kʉng'wakwe kɨtula shanga kɨtakɨwe kʉmipoelya Itunda ɨkʉlʉ kʉʉlʉ. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />Anga ʉmʉsashe mʉnyandʉgʉ wako wasolopaɨlwe indya nʉkʉlya, ʉlɨnge kɨna shanga ʉtogilwe nʉʉlowa. Leka kʉgomba lʉkʉlʉ indya yako kʉtula kinkwaata ka kʉmʉlimansɨɨlya ʉmɨako mʉ mɨladʉ nʉ Kilisito aɨʉkʉle kʉnsoko akwe! <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />Leki kʉgombi kɨntʉ ʉnyenye nɨmʉkɨine kɨza antʉ akɨdalahe. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />Nsoko ingɨ sɨyɨ Ʉtemi wang'wi Itunda shanga kʉlya nʉ kʉng'wa, kʉng'wanso ɨza makani namʉloeeye Itunda nɨ matiliga nʉ wiloi mʉ Ng'wahʉ Ng'welʉ. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />Mʉntʉ nʉkʉmitʉmɨla itɨ ʉ Kilisito wɨmʉloeelya Itunda, nʉkʉgombwa nɨantʉ.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />Kʉlʉlo ang'wɨ ʉyɨlɨ, mahikʉ ɨhi komanɨɨlyi kitʉma nɨmaza nɨleta matiliga, aya nɨkʉaɨɨlya kizenga ʉsese. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />Leka kʉgazanja mʉlɨmo wang'wi Itunda kʉnsoko ankʉngʉmi mʉndya. Ndya yɨhi nza, hangɨ shanga inonee kʉlya ndya niyɨkʉmʉtenda mʉntʉ witʉme mɨlandʉ. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />Ingɨ bahu kʉleka kʉlya nyama, ang'wɨ kʉng'wa dibai ang'wɨ kitʉma kɨntʉ kɨhi nɨkɨhumile kʉmʉsasha mʉnyandʉgʉ wako witʉme mʉlandʉ. <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />Itɨ gwa, ambɨɨla nʉkɨhʉɨɨe ʉewe ni Itunda wako. Ʉkembetilwe mʉntʉ nʉkilamʉɨlya nɨkakitʉma, shanga wikʉngʉma nɨ masɨgo akwe. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />Ingɨ mʉntʉ nʉkisinsɨla kʉlya indya, ʉkʉlamʉlwa anga walye, kʉnsoko shanga ʉkʉlya kʉ ʉhʉɨɨli. Kʉnsoko kɨntʉ kɨhi nʉkitʉma ɨze shanga ʉhʉɨɨe ingɨ mʉlandʉ.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s">Aaɨlyi antʉ nɨangɨza</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />Ʉsese nɨkakomile mʉʉhʉɨɨli kʉtakɨwe kʉaaɨɨlya antʉ nɨaʉhʉɨɨli ʉniino ahume ʉlwagolao. Kʉleke kikela ʉsese du ingɨ kʉakele nɨantʉ angɨza. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />Mʉntʉ wɨhi ʉtakiwe wamʉaɨɨlye mʉnyandʉgʉ wakwe kʉ ʉkende kitʉma makani nɨ maza ingɨ nʉyo wahume kizenga mʉʉhʉɨɨli. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />Kʉnsoko ʉ Kilisito nʉyo shanga aɨwitʉmile makani akʉamʉaɨɨlya ʉng'wenso, ingɨ aɨwitʉmile makani anga nɨyandɨkile, “Ʉkunkwi nɨakʉkunkile ʉewe nʉnene ga aɨnkunkilwe.” <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />Kʉnsoko makani ɨhi naɨandɨkilwe pa kalɨ Mʉwandɨkwa wang'wi Itunda, aɨandɨkilwe kʉʉmanyisa ʉsese. Wandɨkwa nʉwanso akʉʉaɨɨlya kʉgimya mʉ lwago litʉ nʉ kʉʉkomelyaa nkolo, ingɨ kʉlindɨɨle ɨzekʉgimilye. <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />Itunda nʉwɨpoelya nkolo nʉkʉʉtenda kʉgimye. Itungo ɨlɨ kʉlompa kɨna, wamʉkembete mʉtule mɨpalʉng'wɨ, kʉnsoko mʉkitʉma makani ʉ Kilisito Yesʉ naɨwitʉmile. <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />Sʉnga ʉnyenye mɨhi anga mihangʉɨle palʉng'wɨ, kʉ nkolo ɨng'wɨ nʉ kʉ lʉli lʉng'wɨ mʉkʉmʉkulya Itunda, nɨtata wang'wi Isekʉlʉ witʉ Kilisito.<verse eid="ROM 15:6" /></para>
  <para style="s">Mpola Nza kʉ antʉ ɨhi</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />Itɨ gwa, misɨngɨɨlye ʉnyenye, kʉnsoko ikʉlyo lang'wi Itunda anga Kilisito nʉyo naɨʉmʉsɨngɨɨye ʉnyenye. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />Kʉnsoko kʉmʉɨla kɨna ʉ Kilisito aɨmitʉmɨkɨe Ayahudi wahume kʉlagɨɨla ɨtai kɨna Itunda, nilapo Itunda naɨʉatambʉɨe agʉkʉ itʉ lɨkondanɨɨle, <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />nɨ itɨ ga antʉ nɨshanga Ayahudi ahume kʉmʉkʉlya Itunda kʉnsoko aʉʉkende wakwe. Anga niyandɨkile Mʉwandɨkwa wang'wi Itunda,</para>
  <para style="q" vid="ROM 15:9">“Kʉlʉlo kʉʉkʉlya palʉng'wɨ nɨ antʉ nɨshanga Ayahudi,</para>
  <para style="q" vid="ROM 15:9">Kɨmba mɨmbo aʉkʉlʉ nʉwa ʉhumi wako.”<verse eid="ROM 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 15:10" />Hangɨ yandɨkilwe itɨ,</para>
  <para style="q" vid="ROM 15:10">“Iloi, ʉnyenye nɨshanga mɨ Ayahudi, iloi palʉng'wɨ nɨ Antʉ ang'wi Itunda.”<verse eid="ROM 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 15:11" />Nɨ hangɨ,</para>
  <para style="q" vid="ROM 15:11">“Ʉnyenye antʉ mɨhi nɨshanga Mɨayahudi, mʉkʉlyi Itunda,</para>
  <para style="q" vid="ROM 15:11">ʉnyenye antʉ mɨhi, mʉkʉlyi Itunda!”<verse eid="ROM 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 15:12" />Hangɨ Isaya mʉmanga wang'wi Itunda aɨʉlɨɨye itɨ,</para>
  <para style="q" vid="ROM 15:12">“Mʉntʉ ʉng'wɨ kʉpuma miɨele lang'wa Yese ʉzɨɨza,</para>
  <para style="q" vid="ROM 15:12">nʉyo ʉzɨɨza atema antʉ amahɨɨ ɨhi.</para>
  <para style="q" vid="ROM 15:12">nɨantʉ nɨshanga Ayahudi</para>
  <para style="q" vid="ROM 15:12">azemʉsania kɨna ʉkʉaguna.”<verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />Papo Itunda nʉwakʉhʉɨɨlwa, nʉwamʉpe ʉlowa nɨmatiliga kʉpuma mʉ ʉhʉɨɨli wanyu, ʉlindɨɨli wanyu nɨzemʉgimilye ʉhume kongeeleka kʉ ngulu niya Ng'wahu Ng'welʉ.<verse eid="ROM 15:13" /></para>
  <para style="s">Mʉlɨmo wang'wa Paʉlo</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />Anyandʉgʉ ane, ʉnene nihʉɨɨe kɨna nʉ nyenye ga mɨakende, mɨamanyi, hangɨ mʉhumile kimanyisa ʉnyenye. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />Ingɨ nkamatɨkile kʉmʉandɨkɨla makani ɨdʉ mibada ɨlɨ, nihume kʉmʉkɨmbʉsha makani kɨtʉʉnga. Ntendile itɨ kʉnsoko aʉkende wang'wi Itunda nʉmpee <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />kʉʉkende wang'wi Itunda ʉnene kʉtula nɨ mitʉmi wang'wa Kilisito Yesʉ kʉ antʉ nɨshanga Ayahudi. Ingɨ mʉlɨmo wane anga mʉpolyi kʉtanantya Nkani Nza yang'wi Itunda ingɨ antʉ nɨshanga Ayahudi ahume kʉtula ipolyo nɨlɨgombilwe ni Itunda, ipolyo nɨleigwe nʉ Ng'wahʉ Ng'welʉ. <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />Kʉlʉlo gwa, anga itule nɨhʉhangʉ nʉ Kilisito Yesʉ, nkete ʉhumi nʉwakiloelya ʉmʉlɨmo wane kʉnsoko ang'wi Itunda. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />Shanga kʉgema kʉtambʉla kɨntʉ kɨʉya kɨhi kwaala ntambʉle ɨkɨ nʉ Kilisito Yesʉ nʉtendile kʉntʉmɨla ʉnene ingɨ antʉ nɨshanga Ayahudi ahume kʉtula nʉ lwijo kʉng'wi Itunda. Witʉmile itɨ kʉ nkani nɨntambʉe nʉ kʉ ntendo, <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />kʉ ngulu niya mampilʉ nɨ mɨʉkʉɨlwa, nʉ kʉngulu niya Ng'wahʉ Ng'welʉ. Itɨ gwa, kʉ mʉhɨnzo wane nkɨka yɨhi, kandɨɨlya kʉ Yelusalemʉ kʉpikɨɨla kʉ Ililiko, niitanantilye Mpola Ninza niyang'wa Kilisito Yesʉ anga niitakɨwe. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />Isɨgo lane mahikʉ ɨhi laile nkɨka yɨhi nɨantʉ akɨlɨ kʉtanantɨligwa Mpola Ninza niyang'wa Kilisito, kʉtenda itɨ ingɨ ndeke kʉzenga pa mʉntʉ mʉngɨza nazawandya kʉzenga. <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />Ingɨ anga niyiandɨkile Mʉwandɨkwa wang'wi Itunda,</para>
  <para style="q" vid="ROM 15:21">“Antʉ ɨhi nɨakɨlɨ kʉtanantɨligwa mpola yakwe akʉona,</para>
  <para style="q" vid="ROM 15:21">nawaitɨ nɨakɨlɨ kija, akʉlɨnga.”<verse eid="ROM 15:21" /></para>
  <para style="s">Paʉlo ʉkʉsɨga kʉlongola kʉ Lumi</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />Ɨyɨ yɨyɨ nsoko nkʉa yɨdʉ aɨngiigwe kɨza kʉng'wanyu. <verse eid="ROM 15:22" /><verse number="23" style="v" sid="ROM 15:23" />Ingɨ kʉnsoko itungo ɨlɨ nakondya kitʉma ʉmʉlɨmo wane mpande yɨhi izi, nɨ itɨ ga myaka ɨdʉ aɨnkete nsʉla akɨza kʉng'wanyu, <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />nsɨgile nʉmʉone nɨnkolɨ mʉ mʉhɨnzo kenda kʉ Sipania, kikiɨ niloeelye kitungo ɨze kɨpalʉng'wɨ nʉ nyenye, hangɨ mʉnzaɨɨlye kʉntindɨkɨɨlya mpike kʉng'wanso. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />Ingɨ itungo ɨlɨ nkɨlɨ nongoe kitʉma mʉlɨmo wang'wi Itunda kʉnsoko antʉ ang'wi Itunda nɨakoli kʉ Yelusalemʉ. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />Kʉnsoko antʉ nɨamʉhʉɨɨli ʉ Yesʉ ʉko kʉ Makedonia nʉ kʉ Akaya alamʉe kʉhangʉlya nsao yao kʉaɨɨlya antʉ ang'wi Itunda nɨahimbɨ nɨakolɨ kʉ Yelusalemʉ. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />Yialoeeye kʉtenda itɨ, ingɨ kʉ tai, nʉwanso mʉlɨmo wao kʉ antʉ nɨanso nɨakʉ Yelusalemu. Kʉnsoko antʉ nɨshanga Ayahudi asɨngɨɨlya ʉkembetwa nʉwa kɨnkolo nʉwa Ayahudi, nao ga atakɨwe kʉaaɨɨlya Ayahudi makani aʉhiɨlwa nʉwa kɨmʉɨlɨ. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />Anga nkondye kitʉma ʉmʉlɨmo ʉwʉ nʉwa kʉataɨla ʉmʉhangʉ ʉwʉ nʉ ʉpumigwe kʉnsokoao, kʉmʉgendeela nʉnyenye nɨnongoe kʉ Sipania. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />Nɨngile kɨna anga nɨze kʉng'wanyu Kilisito ʉkembetwa nangalʉ.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />Itɨ gwa, anyandʉgʉ ane, kʉ ʉhumi wang'wi Isekʉlʉ witʉ ʉ Kilisito nʉkʉ ʉlowa nʉwiletwa nʉ Ng'wahʉ, kʉminena mihanje nʉnene kʉmʉlompa Itunda. <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />Lompi nihume kʉhega iza mʉ antʉ awo nɨa kʉ Ʉyahudi nɨshanga ahʉɨɨe, nʉ mʉlɨmo wane ʉhume kʉgombwa nɨ antʉ ang'wi Itunda nɨamoli kʉ Yelusalemʉ. <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />Ingɨ Itunda anga walowe nihume kɨza nʉ ʉlowa, niloeelye palʉng'wɨ nʉ nyenye. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />Itunda nʉwɨleta matiliga nʉwatule palʉng'wɨ nʉ nyenye mɨhi! Tai ituleʉ.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s">Paʉlo ʉkʉalamʉsha antʉ angɨza</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />Ndoilwe ʉnyenye mʉmʉlɨnge ʉmʉlʉna witʉ nʉwa kɨsʉngʉ ʉ Poibe nɨɨza mitʉmi nʉwa ahʉɨɨli ang'wa Yesʉ nɨa kʉ Kenkilea. <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />Kʉlompa, mʉsɨngɨɨlyi kʉnsoko ʉmʉhʉɨɨe Isekʉlʉ anga nɨɨsɨngɨɨligwa itʉmi ang'wi Itunda. Mʉaɨɨlyi kɨntʉ kɨhi nʉɨkamʉlompa, kʉnsoko nʉwanso ɨza mʉkende kʉ antʉ ɨdʉ nʉnene ga.<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />Alamʉshi a Pilisika nʉ Akila, itʉmi ɨane mʉ mʉlɨmo wang'wa Kilisito Yesʉ. <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />Antʉ nɨanso aponee ʉneneaʉ kʉsha kʉnsoko ane. Antʉ awa akʉsongeeligwa, shanga kʉng'wane du, ingɨ ga nʉ kʉ antʉ nɨ ahʉɨɨli ang'wa Yesʉ kʉpuma kʉ antʉ nɨshanga Ayahudi. <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />Alamʉshi ahʉɨɨli ang'wa Yesʉ nɨɨtankana kʉ matolao.</para>
  <para style="p" vid="ROM 16:5">Namʉkɨlyi nʉ mʉhʉmbamɨane ʉ Epaineto nɨ mʉntʉ wang'wandyo kʉmʉhʉɨɨla ʉ Kilisito Yesʉ kihɨɨ a Asia. <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />Namʉkɨlyi nʉ Malia, nʉwitʉmile mʉlɨmo kʉngʉlu kʉnsoko anyu. <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />Alamʉshi nɨ a Andiloniko nʉ Yunia antʉ awa ingɨ Aisilseli ɨane aɨkʉtungilwe palʉng'wɨ nʉ nene mʉkadulumʉ, antʉ nɨanso akumʉkile nangalʉ kʉ itʉmi, hangɨ aɨantongee ʉnene kingɨla mʉ ʉ Kilisito.<verse eid="ROM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8" />Mʉlamʉshi nʉ mʉhʉmbamɨane Ampiliato, mʉntʉ nʉwanso ingɨ mʉhangʉ wang'wi Isekʉlʉ. <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />Mʉlamʉshi nʉ Ʉlibano mitʉmi palʉng'wɨ nʉ nene mʉng'wa Kilisito, mʉlamʉshi nʉ mʉhʉmbamɨane ʉ Sitakisi. <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />Mʉlamʉshi nʉ Apele, naɨʉgemilwe nʉ kigeela kɨna ʉhʉɨɨwe nʉ Kilisito. Alamʉshi nɨ antʉ amʉ nyumba ang'wa Alisitobulo. <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />Mʉlamʉshi ʉ Helodiana Mʉyahudi mɨane, nɨ antʉ amikoe lang'wa Nalikisi nɨɨmʉhangʉ mʉng'wi Isekʉlʉ.<verse eid="ROM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12" />Alamʉshi a Tilupena nʉ Tiluposa asʉngʉ nɨakitʉma mʉlɨmo wang'wi Isekʉlʉ, hangɨ mʉlamʉshi nʉ mʉhʉmbamɨane nʉwa kɨsʉngʉ ʉ Pelisisi nʉɨtʉmile makani ɨdʉ kʉnsoko ang'wi Isekʉlʉ. <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />Mʉlamʉshi nʉ Lupo, nɨmankata kʉ mʉlɨmo wang'wi Isekʉlʉ, nʉ nyinya, nɨɨza iya wane ga. <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />Alamʉshi a Asunkilito nʉ Pilegoni nʉ Helime nʉ Patiloba nʉ Helima nɨanyandʉgʉ ɨhi nɨɨpalʉng'wɨ nɨenso. <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />Alamʉshi nɨ a Pilologo nʉ Yulia nʉ Nelea nʉ mʉluna wakwe nʉwa kɨsʉngʉ nʉ Olimpa palʉng'wɨ nɨ antʉ ɨhi nɨeisigwe ni Itunda nɨine nɨenso.<verse eid="ROM 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 16:16" />Ilamʉshi nʉ nyenye ga kʉlagɨɨla kɨna miloilwe. Mʉlamʉkigwe nɨ antʉ ɨhi nɨamʉhʉɨɨe ʉ Kilisito.<verse eid="ROM 16:16" /></para>
  <para style="s">Paʉlo ʉkʉmalɨnkɨɨlya kʉ malagɨɨlyo aya</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />Anyandʉgʉ ane, kʉminena mʉhʉgʉke nʉkʉahʉga antʉ nɨɨsasha wikomi mʉ ahʉɨɨli. Antʉ awa ihiya kʉkanza ʉhʉɨɨli nʉwa antʉ, nʉ kʉhita ʉmanyisi nɨmʉmanyisigwe. Ahʉgi antʉ nɨanso. <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />Kʉnsoko antʉ anga nɨanso shanga ɨmitʉmɨla ʉ Kilisito Isekʉlʉ witʉ, ingɨ iloeelya ɨenso. Kʉ nkani yao niimʉlyo nʉkʉtambʉla nkani niipepeelya yilimɨlya nkolo niya antʉ nɨshanga alɨngile makani nɨmabɨ. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />Kʉnsoko, antʉ ɨhi ija ʉlwijo nʉla ʉhʉɨɨli wanyu mʉ Nkani Ninza, wɨhi kʉ makani nɨ maza nʉnene nɨloaa ikʉlʉ. Ingɨ ndoilwe mʉtule nɨ mahala akitʉma makani nɨmaza, mʉtule mɨagila magazo kʉ makani nɨmabɨ. <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />Itunda nʉɨleta matiliga nʉyo shanga ʉkʉtinia kʉmʉkʉangɨla ʉ Shetani pihɨ amɨgʉlʉ anyu nʉ kʉmʉhuma.</para>
  <para style="p" vid="ROM 16:20">Ʉkende wang'wi Isekʉlʉ witʉ ʉ Kilisito ʉtule palʉng'wɨ nʉ nyenye.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />Nɨ itɨga Timoteo mitʉmi mɨane ʉmʉlamʉkilye, nɨ Ayahudi ɨane a Lukio nʉ Yasoni nʉ Sosipateli nɨenso akʉmʉlamʉsha.<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />Nʉnene ga Telitio, nɨnandɨkile ibada ɨlɨ, nʉmʉlamʉkilye kʉ ʉhumi wang'wi Isekʉlʉ.<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />Gayo nɨmpikɨe mito lakwe, nɨahʉɨɨli ɨhi nɨɨtankanɨla kʉlompa pitolakwe, ʉmʉlamʉkilye. Elasito, mʉɨka mpia mʉ kɨsalɨ ɨkɨ, palʉng'wɨ nʉ heu witʉ Kwalito ɨhi amʉlamʉkilye. <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />Ʉkende wang'wi Isekʉlʉ witʉ Kilisito ʉtule palʉng'wɨ nʉnyenye mɨhi. Tai ituleʉ.<verse eid="ROM 16:24" /></para>
  <para style="s">Malompi akʉmʉkʉlya Itunda</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />Itɨ gwa, itungo ɨlɨ kʉmʉkʉlye Itunda! Ng'wenso nʉhumile kʉmʉpa ingulu mʉ Mpola Ninza niang'wa Kilisito naɨntanantilye kʉng'wanyu. Makani nanso aɨkɨpihilwe kʉ myaka ɨdʉ nakɨile. <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />Ingɨ itungo ɨlɨ yaɨkwa kɨhenga kʉkɨɨla ʉandɨkwa nʉwa amanga nʉ kilagɨɨlyo lang'wi Itunda nʉwa kalɨ na kalɨ. Itungo ɨlɨ ingɨ wigeeleka kʉ antʉ ɨhi nɨshanga Ayahudi ahume kʉhʉɨɨla nʉkʉtula nʉ lwijo.<verse eid="ROM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27" />Itunda wing'wene nʉkete mahala ɨhi, nʉwakʉligwe kʉ ʉhumi wang'wa Kilisito nʉwa kalɨ na kalɨ. Tai ituleʉ.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>