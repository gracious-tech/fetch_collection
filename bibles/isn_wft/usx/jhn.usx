<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Isanzʉ Bible Version</book>
  <para style="h1">YOHANA</para>
  <para style="toc1">Nkani ni Nza anga niyandɨkilwe nʉ Yohana</para>
  <para style="toc2">Yohana</para>
  <para style="toc3">Yoh</para>
  <para style="mt2">Nkani ni Nza anga niyandɨkilwe nʉ</para>
  <para style="mt1">Yohana</para>
  <para style="imt">Wandɨɨlyo</para>
  <para style="iot">Namolɨ</para>
  <para style="ip">TONGEELA a Nkani ni Nza anga niyandɨkilwe nʉ Yohana. Nkani ni Nza anga niyandɨkilwe nʉ Yohana ingɨ mbugulu ɨng’wɨao mʉ mbugulu innɨ nɨ Yilago Nipya niyiganʉe ʉlikalo lang’wa Yesʉ Kilisito. Mʉʉng’wɨao mʉ mbugulu izi itangwa “Injili,” lʉkani ʉlʉ lʉkete ndogoelyo a “nkani ni nza.” Mbugulu izi aɨyandɨkilwe naɨakɨla ɨnsha ang’wa Yesʉ nʉ Matayo nʉ Maliko nʉ Lʉka nʉ Yohana. Nkani ni nza anga nɨyandɨkilwe nʉ Yohana, aɨyandɨkilwe mʉ ʉʉlɨnkɨɨlo nʉwa ng’waka tisini kʉpumɨɨla nʉashɨla ʉ Yesʉ Kilisito. Palʉng’wɨ nʉkʉtula imbugulu ɨyɨ shanga ɨkʉmʉʉe kɨna ʉ Yohana yʉyo aɨʉandɨkile, ʉandɨki nʉʉtʉmɨwe wimpyani nʉʉandɨkwi nʉa mabada ang’wa Yohana nɨla 1 Yohana nɨlɨ nɨla 2 Yohana, nɨlɨ nɨla 3 Yohana. Andɨki ang’wɨ nɨa kalɨ akʉmʉganʉla ʉ kɨna matungo nanso Yohana aɨwishiɨ mʉ kɨsalɨ ka Epeso, kʉlʉlo ihumɨkile ɨmbugulu ɨyɨ ɨandɨkɨwe kʉ Epeso.</para>
  <para style="ip">Yohana ʉkʉganʉla kɨhenga kɨna isɨgo nɨla mbugulu ɨyɨ ingɨ kʉaaɨɨlya antʉ ahume kʉhʉɨɨla ʉ Yesu Kilisito, Ng’wana wang’wi Itunda 20:31. Kʉhʉɨɨla itɨ kɨlija ʉpanga mʉng’wakwe. Mbugulu ɨyɨ ɨandɨkilwe kʉnsoko aasomi a Kiyahudi nawo nɨshanga Ayahudi. Nkani ni nza niyang’wa Yohana kʉnzɨla ngɨɨza yisa ni nkani ni nza nzuya izo niitaatu. Yohana aɨʉkomangɨɨe mɨʉkʉɨlwa Yesʉ naɨʉitumile, hangɨ shanga nɨdʉ mʉnkani ni ntambʉ nimpyani naɨʉipumilye ʉYesu. Makani maʉya nɨmakʉlʉ anga ikani nɨla kʉbadisigwa ʉ Yesʉ nʉ kʉgeng’wa kʉ ng’wakwe mʉwɨɨ nizo ga shanga yandɨkilwe mʉ nkani izi ni nza.</para>
  <para style="iot">Kɨkupɨ kakwe:</para>
  <para style="io">Yohana anaianza ʉkandɨɨlya nkani izi ni nza, mʉlango nʉwa 1:1-18.</para>
  <para style="io">Sʉnga wandɨkile mɨʉkʉɨlwa mɨʉya Yesʉ naɨwitʉmile mʉlango nʉwa 1:19-12-50.</para>
  <para style="io">Naɨakɨla nanso ʉkʉganʉla makani ɨdʉ mʉlikalo lang’wa Yesʉ naɨaletekeeye ɨnsha akwe nʉ wiʉki, mʉlango nʉwa 13:1-20-31.</para>
  <para style="io">Yohana ʉkʉmalɨnkɨɨlya nkani ni nza niyakwe mʉmʉlango nʉwa 21 wazeganʉla itungo lɨng’wi Yesʉ naɨwigeelekile kʉ antʉ naakɨla kʉnsha nʉ kiʉka kʉng’wakwe; sʉnga ʉkʉganʉla nsoko akwe nakʉandɨka ɨmbugulu ɨyɨ.</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">Lʉkani lɨkatendeka mʉɨlɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />Pa ng’wandyo naɨyɨkɨlɨ kʉʉmbwa intʉ yɨhi aɨʉkolɨ Lʉkani nʉ lʉkani nʉwanso aɨwɨpalʉng’wɨ ni Itunda nʉ Lʉkani nʉwanso aɨ Itunda. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />Lʉkani ʉyʉ aɨwɨpalʉng’wɨ ni Itunda kʉpumɨɨla ʉng’wandyo naɨyɨkɨlɨ kʉʉmbwa intʉ yɨhi <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />Kʉkɨɨla Lʉkani nʉwanso intʉ yɨhi aɨyɨʉmbilwe. Anga ɨze shanga Lʉkani nʉwanso kʉtilɨ anga kɨntʉ kɨhi naɨkizeʉmbwa. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />Mʉ Lʉkani nʉwanso aɨʉmolɨ ʉpanga, nʉ ʉpanga nʉwanso aɨnzelya aantʉ. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />Nzelya nanso elyaa mʉkiti, nɨkiti shanga lɨkamɨlemya nzelya nanso.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Aɨʉkolɨ mʉntʉ ʉng’wɨ lina lakwe Yohana ʉlagɨigwe ni Itunda, <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Yohana aɨʉzile waatambʉɨle ɨantʉ nzelya nʉwanso, ingɨ kʉkɨɨla ng’wenso antʉ ahume kʉhʉɨɨla. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Yohana shanga aɨnzelya nʉwanso, nʉwanso aɨʉzile kʉatambʉɨla antʉ mpola niya nzelya nʉwanso. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />Ʉyʉ yʉyʉ nzelya atai, nzelya nʉpembilye mʉʉnkumbigʉlʉ kelya kʉantʉ ɨhi.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />Itɨgwa, Lʉkani aɨʉmolɨ mihɨɨ, kʉkɨɨla ng’wenso intʉ yɨhi aɨyɨʉmbilwe, ingɨ antʉ amihɨɨ shanga ɨkamʉlɨnga. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />Aɨʉzile kʉantʉ akwe, ingɨ antʉ akwe shanga ɨkamʉsɨngɨɨlya. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />Ingɨ antʉ naɨamʉsɨngɨɨye nʉkʉmʉhʉɨɨla, wɨkaapa ʉhumi nʉwakʉtula ana ang’wi Itunda. <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />Awa shanga atugilwe kʉtula ana ang’wi Itunda kʉʉlowa nʉwa aleliao nɨa kɨʉntʉ, ang’wɨ kʉngulu niyamʉɨlɨ, ingɨ kʉʉlowa wang’wi Itunda.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />Lʉkani nʉwanso wɨkatula mʉɨlɨ, wakishiɨ kʉng’witʉ, nʉsese kɨkaʉona ʉkʉlʉ wakwe, ʉkʉlʉ anga nʉwa Ng’wana nɨkinyene kʉpuma kʉng’wi Itunda Tata, nʉyo wizʉe ʉkende nɨtai.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />Yohana wɨkaaɨla ɨantʉ ɨmpola yakwe, aɨwenditʉnta wazelʉnga, “Ʉyʉ yʉyʉ naɨnʉmʉtambʉɨe kɨna ‘Nʉpembilye ingɨ ʉnkɨɨye ʉkʉlʉ, kʉnsoko ʉnene naɨ nkɨlɨ nɨkʉtile, nʉwanso aɨʉkolɨ.”’<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />Mʉʉkondannɨli wakwe, ʉsese kɨhi kapantɨkile ʉkende wang’wi Itunda nʉwisʉkɨɨe. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Kʉnsoko malagɨɨlyo aɨaletilwe kʉkɨɨla kʉng’wa Musa, ingɨ ʉkende nɨtai ang’wi Itunda yiletilwe kʉkɨɨla kʉng’wa Yesʉ Kilisito. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Kʉtilɨ mʉntʉ wɨhi nʉwamʉine Itunda. Ingɨ Ng’wana Kinyene, nɨɨpalʉng’wɨ nʉ Tata, yʉyo ʉmʉkumʉshilye Itunda.<verse eid="JHN 1:18" /></para>
  <para style="s">Lʉkani lang’wa Yohana Mʉbadisi</para>
  <para style="r">
    <ref loc="MAT 3:1-12">Matayo 3:1-12</ref>; <ref loc="MRK 1:1-8">Maliko 1:1-8</ref>; <ref loc="LUK 3:1-18">Lʉka 3:1-18</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Ʉlʉ lʉlʉ lʉkani lang’wa Yohana naɨʉwasʉkɨɨye ɨatongeeli a Ayahudi naɨ atʉmile apolyi palʉng’wɨ nɨ Alawi kʉpuma kʉ Yelusalemu amʉkolye ʉ Yohana, “Ʉewe wɨ nyenyu?”<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />Yohana shanga wɨkaapiha ɨtai, wɨkaasʉkɨɨlya, wɨkaaɨla, “Ʉnene shanga nɨ Kilisito.”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Ɨkamʉkolya hangɨ, “Kʉlʉlo wɨ nyenyu gwa, wɨ mʉmanga Elia ne?”</para>
  <para style="p" vid="JHN 1:21">Yohana wɨkaasʉkɨɨlya, “Shanga nɨ Eliya”</para>
  <para style="p" vid="JHN 1:21">Ɨkamʉkolya, “Itɨ, ʉewe wɨmʉmanga ʉyo nʉkumʉkile kɨna ʉpembelya?”</para>
  <para style="p" vid="JHN 1:21">Yohana wɨkaasʉkɨɨlya, “Shanga nene”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Papo ɨkamʉkolya, “Kʉɨle wɨnyenyu gwa? Ʉewe ʉkikoola anga wɨnyenyu? Kʉtambʉɨle kʉhume kʉataɨla lʉkani awa naza akʉtʉmile.<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Yohana wɨkaasʉkɨɨlya, wazelʉnga, “Ʉnene yʉyo Mʉmanga Isaya naɨʉtambʉe kɨna.</para>
  <para style="q1" vid="JHN 1:23">‘Lʉli nʉla mʉntʉ ʉkitʉnta mʉwɨɨ.</para>
  <para style="q2" vid="JHN 1:23">Noneelyi nzɨla nʉʉkɨɨla Isekʉlʉ.’”<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Antʉ nɨanso aɨatʉmilwe nɨ Apalisayo. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />Ʉʉgwa, ɨkamʉkolya Yohana, anga ize ʉewe ʉkʉlʉnga shanga wɨ Masia ang’wɨ Elia ang’wɨ Mʉmanga “Nɨkɨ ʉkʉbadisa?” <verse eid="JHN 1:25" /><verse number="26" style="v" sid="JHN 1:26" />Yohana wɨkaasʉkɨɨlya, “Ʉnene kʉbadisa antʉ kʉmazɨ, ingɨ mʉng’wanyu ʉkolɨ mʉntʉ nɨshanga mʉmʉmanyile ʉnyenye. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Ʉyo nʉpembilye, ʉnene shanga ngombigwe kʉtolya mɨkoha ailatʉ yakwe ga.” <verse eid="JHN 1:27" /><verse number="28" style="v" sid="JHN 1:28" />Yohana aɨʉtambʉe aya apo naɨʉkʉbadisa antʉ kʉ Betania ipande nɨla kilya amongo nʉa Yolodani.<verse eid="JHN 1:28" /></para>
  <para style="s">Yesʉ Ng’wankolo wang’wi Itunda</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Lʉhikʉ naɨ lʉtyatɨe Yohana wɨkamʉona Yesʉ ʉpembilye kʉng’wakwe, wɨkalʉnga, “Ʉyʉ yʉyʉ Ng’wankolo wang’wi Itunda nʉwɨheja mɨlandʉ aantʉ ɨhi. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Ʉyʉ yʉyʉ naɨnʉmʉɨe kɨna, “Ʉnene anga nakɨla, ‘Ʉpembilye nʉ mʉkʉlʉ kʉkɨla ʉnene, kʉnsoko aɨʉkolɨ ʉnene naɨnkɨlɨ kigela.’ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Ʉnene shanga aɨnʉmʉmanyile, ɨngɨ aɨnzile badisa antʉ namazɨ, Aisilaeli ahume kʉmʉlɨnga.” <verse eid="JHN 1:31" /><verse number="32" style="v" sid="JHN 1:32" />Papo Yohana wɨkaganʉla kɨna, “Namʉona Ng’wahʉ wang’wi Itunda kʉpuma kigʉlʉ ʉkʉmʉsimɨɨla anga nkʉnda, wɨkikiɨ mʉng’wakwe. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Ʉnene shanga aɨnʉmʉɨngile, Itunda ingɨ naɨʉntʉmile mbadise kʉmazɨ aɨwambɨɨe. Mʉntʉ ʉyo, nʉʉkʉona ʉkʉsimɨɨlwa nʉ Ng’wahʉ nʉkʉsiga nʉng’wenso, ingɨ yʉyo ʉkʉbadisa antʉ kʉ Ng’wahʉ Ng’welʉ. <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Papo Yohana wɨkalʉnga, “Ʉnene nɨlɨine ikani ɨlɨ kʉmʉɨla kɨna. Ʉyʉ yʉyʉ Ng’wana wang’wi Itunda.”<verse eid="JHN 1:34" /></para>
  <para style="s">Amanyisigwa ang’wandyo nɨang’wa Yesʉ</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Lʉhikʉ naɨlʉtyatile, Yohana Mʉbadisi aɨʉkolɨ papo palʉng’wɨ nɨamanyigwa akwe abɨɨlɨ. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Naɨwamʉona Yesʉ ʉkɨile, wɨkalʉnga, “Mʉgozi! Ʉyʉ yʉyʉ Ng’waa Nkolo wang’wi Itunda.”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Amanyisigwa awo nɨabɨɨlɨ naɨamija ʉ Yohana ʉkʉtambʉla itɨ, ɨkamʉtyata ʉ Yesʉ. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />Yesʉ wɨkikeya, naɨwaaona amanyisigwa nianso amʉlondooe, wɨkaakolya “Mʉkʉduma ntʉni?” Nɨanso ɨkamʉsʉkɨɨlya, “Mʉmanyisi, itɨɨ, ʉewe wɨshiɨ pɨɨ?<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />Yesʉ wɨkaasʉkɨɨlya, “Kilanyi, nʉnyenye mʉkʉona.” Ʉʉgwa ɨkalongola ɨkaona apo nʉwishiɨ, kʉnsoko naɨʉkʉaɨla itɨ aɨyaina mpɨndɨ matungo a saa ikʉmi. Nɨenso ɨkadʉania koha nʉ Yesʉ lʉhikʉ nʉlanso.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Amanyisigwa awo nɨabɨɨlɨ naɨamigulye ʉ Yohana ʉtambʉe itɨ nʉkʉmʉtyata ʉ Yesʉ, ʉng’wɨao witangwa Endelea mʉluna wang’wa Simon Petelo. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />Kɨkʉlʉ Endelea naɨʉtendile, wɨkamʉhanga mʉluna wakwe ʉ Simon wɨkamʉɨla, “Kamʉona Masia” ndogoelyo akwe nʉhoilwe ni Itunda. <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Sʉnga ʉ Endelea wɨkamʉtwala ʉ Simon kʉng’wa Yesʉ.</para>
  <para style="p" vid="JHN 1:42">Yesʉ wɨkamʉgoza Simon, wɨkalʉnga, “Ʉewe wɨ Simon mʉhʉmba wang’wa Yohana. Itungo ɨlɨ ʉkʉtulitangwa Kepwa” Ndogoelyo ingɨ Petelo ang’wɨ “Italagwe.”<verse eid="JHN 1:42" /></para>
  <para style="s">Yesʉ ʉkʉitanga Pilipo nʉ Natanaeli</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Lʉhikʉ naɨlʉtyatile Yesʉ wɨkalamʉla kʉlongola kʉ Galilaya. Kʉng’wanso, wɨkamʉhanga Pilipo wɨkamʉɨla “Ntyate” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />Pilipo aɨmʉnya kʉ Betisaida kɨsalɨ kʉapumile Endelea nʉ Petelo. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />Pilipo nʉyo wɨkamʉhanga ʉ Natanaeli wɨkamʉɨla, “Kamʉona Yesʉ nʉwa kʉ Nazaleti mʉhʉmba wang’wa Yusupu. Ʉyo nʉ Musa aɨwandɨkile nkani yakwe mʉmbugulu amalagɨɨlyo, nɨamanga andɨkile ɨnkani yakwe.”<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Natanaeli wɨkamʉkolya Pilipo, “Itɨɨ, kɨntʉ nɨ kɨziza kɨhumile kʉpembelya kʉ kɨsalɨ kɨniino nɨka Nazaleti?” Pilipo wɨkamʉɨla</para>
  <para style="p" vid="JHN 1:46">“Nzʉ wiloeele”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Papogwa Yesʉ naɨwamʉona ʉ Natanaeli ʉpembilye kʉng’wakwe wɨkalʉnga, “Kolwi! ʉyʉ ingɨ Mʉisilaeli nʉwa tai, mʉgila ʉteele wɨhi mʉnkolo.” <verse eid="JHN 1:47" /><verse number="48" style="v" sid="JHN 1:48" />Natanaeli wɨkamʉkolya, “Wamanya ʉlɨ?” Yesʉ wɨkamʉsʉkɨɨlya, “Pilipo naza wakɨlɨ kʉitanga ʉewe apo naza wikiɨ pitina nɨla mʉkʉyʉ, aza nʉkʉineʉ.” <verse eid="JHN 1:48" /><verse number="49" style="v" sid="JHN 1:49" />Natanaeli wɨkamʉɨla, “Mʉmanyisi, ʉewe ingɨ wɨ Ng’wana wang’wi Itunda. Ʉewe yʉyo wɨ Mʉtemi nʉwa Aisilaeli!”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />Yesʉ wɨkamʉɨla, “Itɨɨ, wahʉɨɨla kʉnsoko nakʉɨla kɨna aza nʉkʉine wikiɨ pitina nɨla mʉkʉyʉ? Ʉkiloela nɨ makʉlʉ nangalu kʉkɨla aya itɨ.” <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Yesʉ wɨkalongoleka kʉlʉnga, kʉmʉɨla ɨtai kɨna ʉnyenye mʉkʉona igʉlʉ lɨkʉlugʉka nɨa malaɨka ang’wi Itunda akʉtula nankɨla nʉkʉsima kʉnsoko ane ʉnene Ng’waa Mʉntʉ.”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">Wɨnga nʉwa kʉ Kana</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Naɨakɨla mahikʉ abɨɨlɨ aɨʉkolɨ wɨnga kʉ Kana, kɨsalɨ ka Galilaya. Nʉnyinya wang’wa Yesʉ aɨʉkolɨ kʉko, <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />Yesʉ palʉng’wɨ nɨamanyisigwa akwe aɨanilwe kʉwɨnga. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Dibai naɨahila, Yesʉ wɨkaɨlwa nʉnyinya. “Ahiɨlwa dibai.”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Sʉnga Yesʉ wɨkamʉsʉkɨɨlya, “Iya, nɨkɨ ʉkʉmbɨla makani nanso, matungo akitʉma mʉlɨmo wane ʉkɨlɨ kʉpika.”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Papogwa ʉnyinya wang’wa Yesʉ wɨkaaɨla awo naɨ akitʉma, “Kɨhii nʉʉkʉmʉɨla, itʉmi.<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Pang’wanso aɨyɨmolɨ nyʉngʉ mʉtandatʉ nɨya madebe ataano, aɨyiɨkilwe pang’wanso kʉnsoko antendo niya Ayahudi kielya. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />Sunga Yesʉ wɨkaaɨla itʉmi nɨanso, “Izʉlyi mazɨ mʉnyʉngʉ nɨyanso.” Nɨenso ɨkizʉlya. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />Sʉnga Yesʉ wɨkaaɨla, “Tepi mʉmʉtaɨle mʉkʉlʉ nʉwawɨnga. Itʉmi nɨanso ɨkitʉma anga naza aɨwe nʉ Yesʉ. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />Mʉkʉlʉ nʉwawɨnga naɨwalulya mazɨ nanso, mazɨ akaɨlɨka kʉtula dibai. Mʉkʉlʉ nʉwawɨnga shanga aɨʉlɨngile kʉapembeeye, ingɨ itʉmi awo aɨaineʉ. Mʉkʉlʉ nʉwa wɨnga wɨkamitanga mʉtɨzɨɨla nʉwa kigoha, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />wɨkamʉɨla, “Antu ɨhi ɨtongelya hanza dibai nɨɨyeiza, anya wɨnga anga ang’we ikʉte, ʉʉgwa ɨleta ayo napee igaɨ. Ingɨ ʉewe waɨka ɨyɨ nɨkoee igaɨ kʉpikɨɨla ino!” <verse eid="JHN 2:10" /><verse number="11" style="v" sid="JHN 2:11" />Aya ingɨ kɨlɨngasɨɨlyo kang’wandyo naɨʉtendile Yesʉ ʉko kʉ Kana, kɨsalɨ ka Galilaya, wɨkakumʉʉla ʉkʉlʉ wakwe, amanyisigwa akwe nɨenso ɨkamʉhʉɨɨla. <verse eid="JHN 2:11" /><verse number="12" style="v" sid="JHN 2:12" />Naɨyakɨla nanso, Yesʉ palʉng’wɨ nʉ nyinya nɨ aluna akwe nɨ amanyisigwa akwe, ɨkahulumʉka kʉhonga kʉ Kapelinaumu ɨkikiɨ kʉng’wanso mahikʉ makeehʉ.<verse eid="JHN 2:12" /></para>
  <para style="s">Yesʉ ʉlongoe panyʉmba ang’wi Itunda</para>
  <para style="r">
    <ref loc="MAT 21:12-13">Matayo 21:12-13</ref>; <ref loc="MRK 11:15-17">Maliko 11:15-17</ref>; <ref loc="LUK 19:45-46">Lʉka 19:45-46</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Lʉhikʉ nʉla Pasaka kʉ Ayahudi naɨahumbela, Yesʉ wɨkanankɨla kʉlongola kʉ Yelusalemu. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Panyʉmba ang’wi Itunda, wɨkaahanga antʉ akʉgʉlya ng’ombe ni nkolo ni nkʉnda, nɨakaɨla mpia aɨikiɨ mʉmeza yao. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Wɨkanonia mʉsheleti nʉwalʉdigi, wɨkaazunsa ɨhi mʉng’wanso panyʉmba ang’wi Itunda palʉng’wɨ nɨnkolo nɨng’ombe yao, wɨkapɨʉlanga nimeza ya akaɨla mpia nʉkʉhunʉlanga mpia yao. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Yesʉ wɨkaaɨla antʉ naɨakʉgʉlya nkʉnda pang’wanso, “Hejangi apaitɨ maintʉ aya, leki kʉmitendi nyʉmba ang’wa Tata wane ɨtule akʉsʉlʉjɨlya maintʉ. <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />Amanyisigwa akwe ɨkakɨmbʉka kɨna yandɨkilwe, “Ʉlowa wane nʉwa nyʉmba ako ʉkʉmbʉlaga.”<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Ayahudi ang’wɨ ɨkamʉkolya ʉ Yesʉ, “Ʉhumile kʉtenda kɨlɨngasɨɨlyo kɨ kʉlagɨɨla kɨna ʉewe ʉkete ʉhumi nʉwakʉtenda makani aya?” <verse eid="JHN 2:18" /><verse number="19" style="v" sid="JHN 2:19" />Yesʉ wɨkaasʉkɨɨlya, “Mɨhambʉli nyʉmba ang’wi Itunda ɨyɨ, nʉnene kʉmɨzenga mʉmahikʉ ataatʉ.” <verse eid="JHN 2:19" /><verse number="20" style="v" sid="JHN 2:20" />Ayahudi ɨkamʉsʉkɨɨlya, “Nyʉmba ɨyɨ nang’wi Itunda ɨzengilwe kʉ myaka alʉbaini na mʉtandatʉ. Itɨɨ, Ʉewe ʉkʉzenga mahikʉ ataatʉ du?”<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />Nyʉmba ang’wi Itunda Yesʉ naɨʉkʉmɨtambʉla ɨngɨ mʉɨlɨ wakwe. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Naɨ wiʉkigwa, papo amanyisigwa akwe ɨkakɨmbʉka makani ayo Yesʉ naɨ wɨmatambʉla. Kʉlʉlo ɨkahʉɨɨla nɨɨza yandɨkilwe nɨ nkani izo Yesʉ naɨ wɨtambʉla.<verse eid="JHN 2:22" /></para>
  <para style="s">Yesʉ ʉlɨngile nkolo yaantʉ</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Matungo Yesʉ naɨ ʉkolɨ kʉ Yelusalemu kiloeelya nɨla Pasaka, antʉ ɨdʉ ɨkamʉhʉɨɨla naɨaona ilɨngasɨɨlyo naɨ witʉmaa. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Ingɨ Yesʉ shanga aɨʉhʉɨɨe ʉhʉɨɨli wao kʉng’wakwe kʉnsoko aɨʉalɨngile nɨɨlɨ mʉnkolo yao. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Shanga aɨʉloilwe kʉganʉɨlwa makani amʉntʉ wɨhi, kʉnsoko ʉlɨngile yɨhi nɨya mʉnkolo yao.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">Yesʉ nʉ Nikodemo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Aɨʉkolɨ mʉntʉ ʉng’wɨ mʉtongeeli nʉa Ayahudi, kʉpembelya mʉ Apalisayo, lina lakwe Nikodemo aɨ mʉntʉ nʉwianza nɨla Ayahudi. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Lʉhikʉ lʉng’wɨ wɨkamʉhanga ʉ Yesʉ ʉtikʉ, wɨkamʉɨla, “Mʉmanyisi nʉmʉkende, kʉlɨngile kɨna ʉewe wɨmʉmanyisi nʉtʉmilwe ni Itunda, kʉnsoko kʉtilɨ mʉntʉ nʉhumile kʉtenda ilɨngasɨɨlyo nʉkutenda anga ɨze Itunda shanga wɨpalʉng’wɨ nʉng’wenso.”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />Yesʉ wɨkamʉɨla, “Kʉʉɨla ɨtai, ʉmʉntʉ anga wahite kʉtugwa nkʉa akabɨɨlɨ shanga ʉhumile kʉʉona Ʉtemi wang’wi Itunda.”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Nikodemo wɨkamʉkolya, “Yihumɨkile ʉlɨ mʉntʉ anga watule mʉnyampala watugwe hangi? ʉhumile ʉlɨ kingɨla mʉnda ang’wa nyinya watugwe hangɨ?”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Yesʉ wɨkamʉsʉkɨɨlya, “Kʉɨla ɨtai kɨna, ʉmʉntʉ anga wahite kʉtugwa kʉmazɨ nʉ Ng’wahʉ Ng’welʉ, itʉnʉ shanga ʉkingɨla mʉ Ʉtemi wang’wi Itunda. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Mʉntʉ wɨtungwa kɨmʉɨlɨ kʉng’wihe nʉnyinya, ingɨ wɨtugwa kɨnkolo nʉ Ng’wahʉ Ng’welʉ. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Kʉlʉlo leka kʉkʉɨlwa nɨkʉʉtambʉɨla kɨna yɨsingigwe kʉtugwa nkʉa akabɨɨlɨ. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Ng’wega wɨkunka kʉʉloewe, ʉkija nʉʉkʉkunka, ingɨ shanga ʉkʉʉlɨngɨlya ʉpumo nʉʉhongo. Ʉʉgwa ɨza yɨlɨ kʉ mʉntʉ wɨhi nʉtugilwe kʉ Ng’wahʉ.”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Nikodemo wɨkamukolya, “Makani aya ahumɨkile ʉlɨ?<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Yesʉ wɨkamʉɨla, “Itɨɨ! ʉewe wɨmʉmanyisi nʉkumʉkile mʉ Isilaeli, ingɨ ʉkɨlɨ kʉmalɨnga makani aya?” <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Kʉʉtambʉɨla ɨtai taai, ʉsese kɨtambʉla makani nɨkʉkɨlɨngile, nʉkʉganʉla makani nɨkʉmaine, ingɨ ʉnyenye shanga mɨgomba aya nɨkʉʉmʉtambʉɨla. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Itungo ɨlɨ kʉmʉganʉɨla makani amʉʉnkumbigʉlʉ, ʉnyenye shanga mahʉɨɨla, mʉkʉhʉʉɨla ʉlɨ anga nʉmʉganʉɨle makani akigʉlʉ? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Kʉtilɨ anga mʉntʉ wɨhi nʉwahumile kenda kigʉlʉ, ingɨ ʉ Yesʉ du Ng’waa Mʉntʉ naɨ ʉpembeeye kigʉlʉ.<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />“Anga ʉ Musa naɨ ʉmɨtʉmbɨkile ɨnzoka ɨyo mʉmʉtɨ mʉwɨɨ, ʉʉgwa nʉ Ng’waa Mʉmntʉ ʉkʉtʉmbɨkwa mʉmʉtɨ. <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />Kʉitɨ mʉntʉ wɨhi nʉʉkʉmʉhʉɨɨla ʉkʉlija ʉpanga nʉwa kalɨ na kalɨ. <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />Kʉnsoko Itunda aɨʉwaloilwe antʉ ɨhi mʉʉnkumbigʉlʉ sʉnga wɨkamʉpunya Kinyene nʉwakwe, ɨtule mʉntʉ wɨhi nʉʉkʉmʉhʉɨɨla waleke kʉlimɨla, watule nʉʉpanga wa kalɨ na kalɨ. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Kʉnsoko Itunda shanga aɨʉmʉtʉmile Ʉng’wana wakwe kʉʉpɨsɨɨlya antʉ amʉʉnkumbigʉlu, ingɨ kʉkɨɨla Ng’waakwe antʉ ʉhume kʉgunwa.<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />Mʉntʉ wɨhi nʉʉmʉhʉɨɨe ʉ Ng’wana shanga ʉkʉpɨsɨɨligwa, ingɨ mʉntʉ ʉyo nɨshanga ʉmʉhʉɨɨe ʉ Ng’wana wakondya kʉpɨsɨɨligwa, kʉnsoko akʉhita kʉmʉhʉɨɨla Kinyene wang’wi Itunda. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Ʉwʉ wʉwʉ ʉlamʉlwa, nʉyo Ɨnzelya wazaa mʉʉnkumbigʉlu, antʉ ingɨ alowa kiti kʉkɨla kʉlowa Nzelya, kʉnsoko ntendo yao nɨmbɨ. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Mʉntʉ wɨhi nʉwitenda makani nɨmabɨɨ wɨʉmɨbɨpɨlwa nzelya, hangɨ shanga wɨza mʉnzelya, kʉnsoko shanga ʉloilwe makani akwe nɨmabɨ ɨgeeleke. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Ingɨ awo ɨhi nɨɨtʉma makani Itunda nʉmaloilwe ɨpembya mʉnzelya, makaniao ahume kigeeleka kɨna atendekile mʉng’wi Itunda.<verse eid="JHN 3:21" /></para>
  <para style="s">Yohana Mʉbadisi ʉkʉmʉganʉla ʉ Yesʉ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Naɨakɨla aya, Yesʉ nɨamanyisigwa akwe ɨkalongola kihɨɨ a Ayahudi, nʉyo wɨkikiɨ kʉng’wanso nɨamanyisigwa akwe kitungo akaze badisa antʉ. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />Yohana nʉyo aɨʉkʉbadisa antʉ kʉ Ainoni, pakupɨ nɨ Salemu, kʉnsoko kʉng’wanso ɨmazɨ aɨdu. Antʉ ɨdʉ aɨɨenda kʉng’wanso, nʉyo wɨkaabadisa. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />Itungo nɨlanso Yohana aɨwakɨlɨ kʉtungwa mʉkadulumu.<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />Kʉlʉlo wɨkigela wikʉngʉmi kʉamanyisigwa ang’wa Yohana nʉ Mʉyahudi ʉng’wɨ kʉnsoko akielya iza ʉhume kʉgombeka kipolyo. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Kʉlʉlo, amanyisigwa nɨanso ɨkamʉhanga ʉ Yohana nʉkʉmʉɨla, “Mʉmanyisi, mʉntʉ ʉyo naza mine kitʉmbɨ nɨla mongo wakʉ Yolidani, ʉyo naɨ ʉkʉmʉganʉla, nʉyo itungo ɨlɨ wainabadisa, nɨ antʉ ɨdʉ ainamʉtyata.” <verse eid="JHN 3:26" /><verse number="27" style="v" sid="JHN 3:27" />Yohana wɨkaasʉkɨɨlya, mʉntʉ wɨhi shanga ʉhumile kʉtula ni kɨntʉ nɨshanga ʉpewe ni Itunda. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Nyenye mʉlɨngile naɨnʉntambʉe kɨna, ‘Ʉnene shanga nɨ Kilisito nʉhoilwe ni Itunda, ingɨ ndagɨigwe nʉmʉtongeele!’ <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Mʉtɨzɨɨla nʉwa kɨgoha yʉyo wɨmʉtɨna mʉtɨzɨɨla nʉwakɨsʉngʉ. Ingɨ mʉhʉmba mʉya nʉwa mʉtɨzɨɨla nʉwa kɨgoha wimɨka pakupɨ nʉyo wɨmʉtegeelya, wɨlowa nangalu anga wije ʉlʉli lakwe. Ɨyɨ yɨyɨ nsoko aʉlowa wane nʉʉkondannɨe. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Nʉyo ʉ Kilisito nʉhoilwe ni Itunda wakʉligwe ikʉlʉ, nʉnene nongoleke kininompya.<verse eid="JHN 3:30" /></para>
  <para style="s">Nkani ya mʉntʉ nʉpembilye kigʉlʉ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Ʉyo nʉhoilwe ni Itunda kʉpembelya kigʉlʉ ingɨ mʉkʉlʉ kʉkɨla ɨhi, nʉyo nʉpembeeye mʉʉnkumbigʉlu, nʉwanso waʉnkumbigʉlʉ ʉdu, hangɨ wɨligitya makani amʉʉnkumbigʉlu. Ingɨ ʉyo nʉpembeeye kigʉlʉ mʉkʉlʉ kʉkɨla ɨhi <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Nʉwanso wɨkʉɨɨla ayo nʉwɨmaona nʉkʉmija, ingɨ kʉtilɨ anga mʉntʉ nʉwɨhʉɨɨla lʉkani lakwe. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Mʉntʉ wɨhi nʉwɨgomba nkani yakwe wɨona kɨna Itunda ingɨ mʉnyatai. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Ʉyo nʉtʉmilwe nɨ Itunda wɨtambʉla nkani yang’wi Itunda, ndogoelyo Itunda wɨmʉpeza mʉntʉ nʉwanso Ng’wahʉ wakwe. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Tata ʉmʉloilwe ʉ Ng’wana hangɨ wamʉpee intʉ yɨhi. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Mʉntʉ wɨhi nʉmʉhʉɨɨe ʉ Ng’waakwe ʉkete ʉpanga nʉwa kalɨ na kalɨ, nɨshanga ʉmʉkʉmija ʉ Ng’wana nʉwanso ʉkʉtula mʉgila ʉpanga nʉwa kalɨ na kalɨ, ingɨ ikuo lang’wi Itunda lɨkʉtula kʉng’wakwe.<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">Yesʉ ʉkitambʉlya nʉ mʉsʉngu mʉ Samalia</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Apalisayo ɨkija kɨna Yesʉ aɨʉkenda atenda antʉ ɨdʉ kʉtula amanyisigwa nʉkʉabadisa kʉkɨla ʉ Yohana Mʉbadisi. <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />Ingɨ kʉtambʉla ɨtai Yesʉ shanga ng’wenso aɨwɨbadisa ingɨ naɨɨbadisa aɨamanyisigwa akwe. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Ʉʉgwa Yesʉ naɨwija nanso, wɨkahega kʉ kɨsalɨ ka Yʉdea wɨkatulya kihɨɨ a Galilaya, <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />mʉ mʉhɨnzo nʉwanso aʉtakɨwe kʉkɨɨla kʉ Samalia.<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />Wɨkapika kʉ Samalia kɨsalɨ kɨng’wɨ nɨkitangwa Sikali, pakupɨ nʉ mʉgʉnda ʉwo Yakobo naɨ ʉmʉpee ng’waakwe Yusupu. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Pang’wanso aɨkɨmolɨ kɨlʉngʉ kamazɨ nɨkang’wa Yakobo, Yesʉ kʉnsoko aɨwakataligwa nʉmʉhɨnzo, wɨkikiɨ pampelo akɨlʉngʉ nɨkanso. Pang’wanso aɨng’ʉng’wɨ anga saa mʉtandatʉ.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Mʉsʉngʉ ʉng’wɨ Mʉsamalia wɨkaza pang’wanso kʉtepa mazɨ. Yesʉ wɨkamʉɨla, “Mpee mazɨ ng’we.” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />Itungo nɨlanso amanyisigwa akwe aɨenda kʉmatembe kʉgʉla ndya<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Mʉsʉngʉ nʉwanso wɨkamʉɨla, “Ʉewe wɨ Mʉyahudi; nʉnene nɨ Mʉsamalia. Yatula ʉlɨ ʉnompe mazɨ akʉng’wa?” Ayahudi shanga aɨza ɨendilye nɨa Samalia.<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Yesʉ wɨkamʉsʉkɨɨlya, “Anga azaɨtule ʉlɨngile kɨpegwa kang’wi Itunda kɨna nyenyu nʉkʉʉɨla, mpee mazɨ ng’we,’ ʉewe aza ʉzemʉlompa ng’wenso, nʉyo azaʉzekʉpa mazɨ nakʉʉpa ʉhumi ʉewe ʉtule nʉʉpanga nʉwakalɨ na kalɨ.<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />Mʉsʉngʉ nʉwanso wɨkamʉsʉkɨɨlya, “Isekʉlʉ, kɨlʉngu ɨkɨ ingɨ kɨlundu nʉewe wɨmʉgila anga kɨhukɨlyo kakʉhukɨlya mazɨ,ʉkʉpumya pɨ mazɨ naʉpanga nʉwa kalɨ na kalɨ? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Itɨɨ, ʉewe wimʉkʉlʉne kʉkɨla tata witʉ Yakobo? Nʉwanso yʉyo aɨʉkʉpee ʉsese kɨlʉngʉ ɨkɨ, Yakobo nɨana akwe nɨmɨtugo akwe aɨɨtepa maze mʉkɨlʉngʉ ɨkɨ.”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />Yesʉ wɨkamʉsʉkɨɨlya, “Mʉntʉ wɨhi nʉʉkʉng’wa ɨmazɨ akɨlʉlʉngʉ ɨkɨ, ʉkʉhung’wa nyota hangɨ.” <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />Ingɨ mʉntʉ wɨhi anga wang’we mazɨ nɨ kʉmʉpa ʉnene, shanga ʉkʉhung’wa nyota lʉkʉlʉ. mazɨ nɨkʉmʉpa mʉng’wakwe akʉtula ndiɨlyo nɨɨkʉliɨla mazi aʉpanga nʉwa kalɨ na kalɨ.”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Mʉsʉngʉ nʉwanso wɨkamʉɨla, “Isekʉlʉ, Itʉnʉ mpe mazɨ nanso mpele kʉhung’wa nyota lʉkʉlʉ, hangɨ mpele kʉtepeela mazɨ aya”.<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Yesʉ wɨkamʉɨla, longola ʉmitange mʉgohako, mɨzanie apa itɨ.<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Musʉngʉ nʉwanso wɨkamʉsʉkɨɨlya, “Ʉnene nɨmʉgila anga mʉgoha,</para>
  <para style="p" vid="JHN 4:17">Yesʉ wɨkamʉɨla, “Watambʉla ɨtai, kɨna wɨmʉgila anga mʉgoha. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />Kʉnsoko wapisha kʉholwa nɨa agoha ataano, nʉyʉ nʉkʉhoile ɨtungo ɨlɨ shanga mʉgoha wako. Pang’wanso watambʉla ɨtai.”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />Mʉsʉngʉ nʉwanso wɨkamʉɨla, “Isekʉlʉ, kʉona kɨna ʉewe ihumɨkile wɨmʉmanga wang’wi Itunda. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />“Isekʉlʉ itʉ kʉpuma kʉ Samalia aɨɨmʉkʉlya Itunda migʉlya mʉlʉgʉlʉ ʉlʉ, ingɨ ʉnyenye Ayahudi mʉlʉngile kɨna nkɨka akʉmʉkʉlya Itunda ingɨ kʉ Yelusalemu dʉ.”<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />Yesʉ wɨkamʉɨla, ‘Mʉsʉngʉ, ʉewe nihʉɨɨle ʉnene, apembilye matungo nɨ shanga mʉkʉmʉkʉlya ʉ Tata mʉlʉgʉlʉ ʉlʉ ang’wɨ ʉko kʉ Yelusalemu. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Ʉnyenye Asamalia mɨmʉkʉlya ʉyo nɨ shanga mʉmʉlɨngile, Ingɨ ʉsese nɨkɨ Ayahudi kɨmʉkʉlya Itunda nɨkʉmʉlɨngile, kʉnsoko ʉgunwi wɨpumɨɨla kʉ Ayahudi <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Ingɨ matungo apembilye, hangɨ apikɨɨla, antʉ nɨɨmʉkʉlya Tata kʉtai kʉtongeelwa nɨ nkolo nɨ tai. Ndogoelyo Tata ʉaloilwe antʉ anga nɨanso. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Itunda ingɨ Ng’wahʉ, nɨ antʉ nɨɨmʉkʉlya ingɨ atakɨwe amʉkʉlye kʉ nkolo nɨ tai.”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Mʉsʉngʉ nʉwanso wɨkamʉɨla, “Nɨngile kɨna ʉ Masia nʉ witangwa Kilisito, ʉpembilye. Nʉyo anga waze ʉkʉʉlɨngasa makani ɨhi.”<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Yesʉ wɨkamʉɨla, “Ʉyʉ nʉʉkitambʉlya nʉewe, yʉyo.” <verse eid="JHN 4:26" /><verse number="27" style="v" sid="JHN 4:27" />Itungo lɨlo amanyisigwa akwe ɨkatulya, ɨkakʉɨlwa nangalu naɨ amʉine ʉkitambʉlya nʉmʉsʉngʉ. Ingɨ kʉtilɨ naɨ ʉmʉkoiye, “Ʉkʉhiya ntʉni?” ang’wɨ, “Kʉnɨkɨ ʉkitambʉlya nʉmʉsʉngʉ ʉyʉ?”<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Mʉsʉngʉ nʉwanso wɨkaleka ntʉnda akwe na mazɨ papo, wɨkatulya mʉkɨsalɨ wɨkaatambʉɨla antʉ, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“Kɨlanyi mʉmʉone mʉntʉ nʉntambʉɨe nkani yɨhi naɨnɨtenda! Itɨɨ, shanga yɨhumile ʉyʉ watule yʉyo Kilisito ne?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Antu ɨdʉ ɨkakʉnkʉmʉka kʉpumɨɨla mʉkɨsalɨ, ɨkamʉhanga ʉ Yesʉ.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Itungo nɨlanso amanyisigwa akwe aɨ akʉminena Yesʉ, “Mʉmanyisi, lya hanza.”<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />Ingɨ Yesʉ wɨkaaɨla, “Ndya nɨnkete ʉnene ʉnyenye shanga mʉilɨngile.”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Amanyisigwa akwe ɨkatulikolya, “Itɨɨ, ʉkolɨ mʉntʉne nʉwamʉletela ndya?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Yesʉ wikaaɨla, “Ndya yane sizi, kitʉma mʉlɨmo nʉloilwe ʉyo nʉndagɨɨye nʉkʉnɨng’anɨlya mʉlɨmo wakwe. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Ʉnyenye mɨlunga, ‘Ɨkɨlɨ myeli ɨnɨ du, matungo amaogola akʉpika?’ Ingɨ ʉnene kʉmʉɨla, kolwi mɨgʉnda ɨkondile kʉogolwa. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Mʉogoli ʉkʉpegwa kɨnyamʉlɨmo mʉmʉlɨmo wakwe, hangɨ ʉkʉɨka ndya misalanka kʉnsoko aʉpanga wakwe nʉwa kalɨ na kalɨ, ʉʉgwa mʉminzi nʉmʉogoli ɨhi iloeelya palʉng’wɨ. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Kʉndogoelyo nanso ntambʉ ɨyɨ ingɨ, ‘Ʉng’wɨ wɨtemela ʉmʉya wɨogola ingɨ atai.’ <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Ʉnene nʉmʉtwae mende ogola mʉgʉnda nɨ shanga mʉlɨmile kʉngulu yanyu, itʉmile angɨza ingɨ ʉnyenye mapantɨka kʉkɨɨla ngulu yao.”<verse eid="JHN 4:38" /></para>
  <para style="s">Asamalia ɨdʉ akʉhʉɨɨla</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Asamalia ɨdʉ mʉkɨsalɨ nɨkanso ɨkamʉhʉɨɨla ʉ Yesʉ kʉnsoko ankani naɨʉtambʉe mʉsʉngʉ nʉwanso kɨna, “Wantambʉila makani ɨhi nɨnatendile.” <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Kʉitɨ Asamalia nɨanso ɨkamʉhanga ʉ Yesʉ ɨkamʉlompa wikiɨ nɨenso, nʉng’wenso wɨkɨkiɨ pang’wanso nsikʉ ibɨɨlɨ.<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />Antʉ idʉ ikɨlo ɨkahʉɨɨla kʉnsoko ankani yakwe. <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />Ɨkamʉɨla mʉsʉngʉ nʉwanso, “Ʉsese shanga kʉhʉɨɨe kʉnsoko ankani yako du. Kigulye ʉsese, hangɨ kʉlɨngile kɨna tai ʉyʉ yʉyʉ mʉguni nʉwa ʉnkumbigʉlʉ.”<verse eid="JHN 4:42" /></para>
  <para style="s">Yesʉ ʉkʉmʉkomya ng’wana nʉwa mʉtongeeli</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Naɨ yakɨla mahikʉ abɨɨlɨ Yesʉ wɨkahega pang’wanso, wɨkalongola kʉ Galilaya. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />Kʉnsoko Yesʉ ng’wenso aɨwatambʉla kɨhenga kɨna, “Mʉmanga shanga wɨkʉligwa mihɨɨ naakwe.” <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Naɨwapika kʉ Galilaya, Agalilaya ɨkamʉsɨngɨɨlya, kʉnsoko aɨaona makani ɨhi Yesʉ naɨʉtendile kʉng’wanso kʉ Yelusalemu matungo iloelya naɨ la Pasaka, kʉnsoko nɨenso aɨendile miloelya nɨla Pasaka.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Yesʉ aɨʉpikile hangɨ ʉko kʉkɨsalɨ kakʉ Kana, ihɨɨ akʉ Galilaya, apo naɨʉmapɨʉe mazɨ kʉtula dibai. Kung’wanso aɨʉkolɨ mʉkʉlʉ ʉng’wɨ naɨʉlwaɨwe nʉng’wana ʉko kʉ Kapelinaumu. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Mʉtongeeli nʉwanso naɨ wɨgule kɨna Yesʉ aɨwapuma kʉ Ʉyahudi nʉkʉpika kʉ Galilaya, wɨkamʉhanga wamulompe wende mʉkomya ng’wakwe naɨ mʉlwae doo. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />Yesʉ wɨkamʉɨla, “Ʉewe angaʉhite kʉona kilɨngasɨlyo nɨ mampɨlʉ shanga ʉkʉhʉɨɨla.”<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />Mʉkʉlʉ nʉwanso wɨkamʉɨla ʉ Yesʉ, “Isekʉlʉ, itʉnʉ kwɨni ʉ ng’wana wane nʉwakɨlɨ kʉsha.”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />Yesʉ wɨkamʉɨla, “Longola ʉdu ng’wana wako wakomya”</para>
  <para style="p" vid="JHN 4:50">Mʉntʉ nʉwanso wɨkahʉɨɨla nkani yang’wa Yesʉ, nʉyo wɨkalongola <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />Naɨ wakɨlɨ ʉkolɨ mʉnzɨla, wɨkatankana nɨatugwa akwe nɨenso ɨkamʉɨla kɨna ng’waakwe wakomya!”<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />Nʉyo wɨkaakolya, itungo kɨɨ nʉ ng’waane naza ʉkomilye, nɨenso ɨkamʉɨla, aza ʉkomilye igʉlo ng’ʉng’wɨ matungo amʉpungatɨ.” <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />Ihe nʉwa mʉhʉmba nʉwanso wɨkakɨmbʉka kɨna aza itungo lɨlo lɨɨlo naza ʉɨwe nʉ Yesʉ kɨna, “Ng’wana wako ʉkʉkomya.” Ʉʉgwa nʉwanso palʉng’wɨ nao ɨhi nɨikalanya ɨkamʉhʉɨɨla Yesʉ. <verse eid="JHN 4:53" /><verse number="54" style="v" sid="JHN 4:54" />Ɨkɨ aɨkɨlɨngasɨɨlyo kakabɨlɨ naɨwitʉmile ʉ Yesʉ naɨʉpumɨɨe kʉ Yʉdea kʉlongola kʉ Galilaya.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">Yesʉ ʉkʉmʉkomya kɨtele lʉhikʉ nʉla kʉsupya Ayahudi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Naɨyakɨla makani nanso aɨlɨkolɨ iloelya nɨla Ayahudi, Yesʉ nʉyo wɨkalongola kiloeelya nɨlanso kʉ Yelusalemu. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Kʉng’wanso kʉ Yelusalemu pakupɨ nʉ mʉmpita wankolo, aɨlɨmolɨ ilambo, Aebulania ɨlitanga Betizata, aɨlɨpilimɨkɨɨgwe niianda itaano. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Mʉng’wanso mʉianda aɨamolɨ alwae ɨdʉ naɨalambae, Apoku nɨakɨtele nao nɨapoiye. ‘Aɨalindɨɨe mazɨ atɨgɨntʉlwe,’ <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />kʉnsoko lɨkolɨ itungo malaɨka wang’wi Itunda nʉa kigʉlʉ aɨwɨsima mʉmazɨ nʉkʉmatɨgɨntʉla. Mʉntʉ wɨhi nʉkʉtongela kingɨla mʉmazɨ nanso natɨgɨntʉwe, wɨkomya ʉlwae wɨhi nʉʉkete. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Ɨtɨ gwa, pang’wanso aɨʉkolɨ mʉntʉ ʉng’wɨ naɨwalwae kitungo lamyaka salasini namʉnana. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Yesʉ naɨwamʉona mʉntʉ nʉwanso ʉlae pangwanso, kʉnʉ waze ʉlɨngile kɨna wikae pang’wanso kitungo ilɨpu, wikamʉkolya, “Itɨɨ, ʉloilwene ʉkomye?” <verse eid="JHN 5:6" /><verse number="7" style="v" sid="JHN 5:7" />Mʉlwae nʉwanso wɨkasʉkɨɨlya, “Ʉwe Mʉkʉlʉ, ʉnene nɨmʉgila anga mʉntʉ nʉwa kʉningɨlya mʉmazɨ anga atɨgɨtʉlwe. Hangɨ anga ngeme kingɨla mʉmazɨ, mʉntʉ mʉngɨɨza wɨntangʉlya.” <verse eid="JHN 5:7" /><verse number="8" style="v" sid="JHN 5:8" />Yesʉ wɨkamʉɨla, “Ʉka, hola kɨpalatʉ kako ʉgende.”<verse eid="JHN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 5:9" />Papo paapo mʉntʉ nʉwanso wɨkakomya, wɨkahola kɨpalatʉ kakwe wɨkatula genda. Ikani ɨlɨ aɨlɨtendekile lʉhikʉ nʉla kʉsupya. <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />Kʉlʉlo Ayahudi angɨɨza ɨkamʉɨla mʉntʉ ʉyo naɨʉkomigwe, “Lelɨyɨ ingɨ lʉhikʉ nʉla kʉsupya, ilagɨɨlyo lɨgiiye kʉkenka kɨpalatʉ kako.”<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Mʉntʉ nʉwanso wɨkaasʉkɨɨlya, “Ʉyo nʉnkomilye ng’wenso ʉmbɨɨe, ‘Hola kɨpalatʉ kako ʉgende.’”<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />Nɨenso ɨkamʉkolya, “Mʉntʉ kɨɨ nʉwanso naza ʉkʉɨe ʉhole kɨpalatʉ kako, ʉgende?”<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Ingɨ mʉntʉ ʉyʉ naɨʉkomigwe shanga aɨʉmʉlɨngile mʉntʉ naɨ ʉmʉkomilye, kʉnsoko Yesʉ aɨwahega pang’wanso nʉkihanja nʉmilʉndo nʉwa antʉ.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Panyambele mʉntʉ nʉwanso naɨʉkomigwe, Yesʉ wɨkamʉhanga Mʉnyʉmba ang’wi Itunda, wɨkamʉɨla, “Itungo ɨlɨ wakomya, ʉleke kitʉma hangɨ mɨlandʉ, lɨleke kʉʉhanga ikani nibɨ kʉkɨla ɨlɨ.<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />Mʉntʉ nʉwanso wɨkalongola, wɨkaatambʉɨla atongeeli a Ayahudi kɨna Yesʉ yʉyo aɨʉmʉkomilye. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />Kʉlʉlo Ayahudi ɨkandya kʉmʉnyoma Yesʉ, kʉnsoko aɨwitʉmile ikani nɨlanso mʉlʉhikʉ nʉla kʉsupya Ayahudi. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Ingɨ Yesʉ wɨkaaɨla, “Tata nʉwane witʉma mɨlɨmo mahikʉ ɨhi nɨtungo ɨlɨ, nʉnene ga kitʉma mʉlɨmo.”<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />Kʉnsoko nanso atongeeli a Ayahudi ɨkatakigwa nɨ nkani yang’wa Yesʉ, ɨkatuladuma nzɨla akʉmʉbʉlaga, shanga kʉnsoko aɨʉbunangile ilagɨɨlyo nɨla lʉhikʉ nʉla kʉsupya, ingɨ kʉnsoko akʉmitanga Itunda Tata wakwe, kʉlʉlo ʉkimpyania ni Itunda.<verse eid="JHN 5:18" /></para>
  <para style="s">Ʉkʉlʉ nʉwa Ng’wana wang’wi Itunda</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Yesʉ wɨkalongoleka kʉaɨla, “Kʉmʉɨla ɨtai taai, Ng’wana shanga ʉhumile kitʉma ikani lɨhi wing’wene, ʉhumile kitʉma ɨko nʉmʉine Ihe ʉkituma. Kʉnsoko kɨhi nɨkanso nʉkituma Ihe, Ng’wana nʉyo ʉkitʉma kɨko. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Tata ʉmʉloilwe Ng’wana, hangɨ wɨmʉlagɨɨla maintʉ ɨhi nɨwɨtʉmaa, hangɨ ʉkʉmʉlagɨɨla makani makʉlʉ kʉkɨla aya itɨ, nʉnyenye mʉhume kʉkʉɨlwa. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Anga Tata nʉwɨiʉsha ashii nʉkʉapa ʉpanga, ʉʉgwa nʉ Ng’wana wakwe ʉkʉapa ʉpanga awo ɨhi nʉtakile. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Tata shanga wɨmʉpɨsɨɨlya mʉntʉ wɨhi, ingɨ ʉkʉlʉ nʉwa kʉpɨsɨɨlya wamʉlekee Ng’wana, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />ingɨ antʉ ɨhi amʉkʉlye ʉ Ng’wana anga itɨ nɨɨza amʉkʉɨye ʉ Tata. Mʉntʉ wɨhi nɨshanga ʉmʉkʉiye ʉ Ng’wana shanga ʉkʉmʉkʉlya nʉ Tata nʉmʉlagɨɨye.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />“Kʉmʉɨla ɨtai taai, mʉntʉ wɨhi nʉʉkija ʉlʉkani lane, nʉkʉmʉhʉɨɨla ʉyo nʉntʉmile, ʉkete ʉpanga nʉwa kalɨ na kalɨ. Kwe shanga ʉkʉpɨsɨligwa, ingɨ ʉkʉtula wakɨla kʉpuma mʉnsha nʉkingɨla mʉʉpanga. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Kʉmʉɨla ɨtai taai, matungo apembilye, hangɨ apika, nɨashi akija lʉli nʉla Ng’wana wang’wi Itunda, nawo nɨakija, akɨshiɨ. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Anga ʉ Tata nɨng’wandyo nʉwa ʉpanga, ʉʉgwa ʉmʉpee nʉ Ng’wana wakwe kʉtula ng’wandyo nʉwa ʉpanga. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Hangɨ Itunda ʉmʉpee Ng’waakwe ʉhumi nʉwa kʉlamʉla kʉnsoko yʉyo mʉntʉ Itunda nʉmʉtʉmile. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />Leki kʉkʉɨlwa ikani ɨlɨ, kʉnsoko itungo lɨpembilye awo ɨhi nɨamoli mʉibɨɨla akija lʉli lakwe, <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />ɨhi akɨʉkigwa. Awo naɨatendile nɨmaza akʉlija upanga nʉwa kalɨ na kalɨ, nawo naɨatendile ʉʉbɨ akiʉkigwa nʉkʉpɨsɨɨligwa.<verse eid="JHN 5:29" /></para>
  <para style="s">Nɨakʉtanantya nkani yang’wa Yesʉ</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />“Ʉnene shanga nɨhumile kitʉma kɨntʉ kɨhi kʉʉhumi wane. Ʉnene kʉlamʉla anga nɨnigulye kʉpuma kʉng’wa Tata, nʉʉlamʉli wane ingɨ wa tai. Shanga nɨduma kituma anga nɨntakile ʉnene, ingɨ nʉtakile ʉyo nʉndagɨɨye.<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />Anga nitambʉle iza ʉnene, witambʉli wane shanga ʉkʉgombwa kɨna watai. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Ingɨ ʉkolɨ mʉngɨɨza nʉkʉntambʉla, nɨngile kɨna ɨhi nʉkʉntambʉla ingɨ aɨtai. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />Ʉnyenye aɨmʉatʉmile antʉ kʉng’wa Yohana nʉyo wɨkantambʉla ɨtai. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Ʉnene shanga nsanilye antʉ antabule iza, kʉtambula makani aya ingɨ mʉhume kʉgunwa. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Yohana aɨwɨhanga lʉmʉlɨ nʉlakɨɨe nʉkelya, nʉnyenye aɨmiloeeye nzelya akwe kɨtungo ʉdu. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />Ingɨ ʉnene nkete ʉkʉɨɨli nʉʉkʉlʉ kʉkɨla nʉang’wa Yohana. Mɨlɨmo ɨyo nɨkitʉma, ɨkʉnkumʉsha ʉnene, mɨlɨmo ɨyo ʉ Tata nʉmpee nimɨkondannɨlye, ilɨngasɨɨlyo izo nɨkitʉma zizo yɨnkumʉshilye kɨna ʉ Tata yʉyo ʉndagɨɨye. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Tata naɨʉndagɨɨye yʉyo ʉkʉntambʉla. Ʉnyenye ɨzamʉkɨlɨ kija lʉli lakwe, ang’wɨ kʉʉona iɨlɨgano lakwe, <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />nʉnyenye shanga mʉhʉɨɨe aya nʉkʉmʉɨla, kʉnsoko shanga mʉmʉhʉɨɨe ʉyo nʉlagɨigwe. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Ʉnyenye mʉkʉdumɨɨla Mʉandɨkwa mʉsɨgile kɨna mʉkatɨ akwe ʉkolɨ ʉpanga nʉwa kalɨ na kalɨ, ingɨ ʉandɨkwa wʉwo ʉkʉntambʉla ʉnene! <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />Nɨitɨga, ʉnyenye shanga mʉtakile kɨza kʉng’wane mʉhume kʉpantɨka ʉpanga.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />“Ʉnene shanga kʉsɨngɨɨlya ikʉlyo kʉpuma kʉantʉ. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Ingɨ nʉmʉlɨngile kɨna mɨagila ʉʉlowa wang’wi Itunda mʉnkolo yanyu. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Ʉnene nazaa kʉʉhumi wang’wi Tata wane, ʉnyenye shanga mʉnsɨngɨɨye, ingɨ mʉntʉ mʉngɨɨza anga waze kʉʉhumi nʉwakwe, nʉanso mʉkʉmʉsɨngɨɨlya. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Mʉhumile ʉlɨ kʉhʉɨɨla, kʉnʉ mɨlowa kikʉlya ʉnyenye, ikʉlyo kʉpuma kʉng’wi Itunda ʉdu shanga mʉlɨloilwe? <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />Leki kʉsɨgi kɨna ʉnene kʉmʉsemela kʉng’wa Tata. Musa nɨmʉmʉhʉɨɨe ʉnyenye nʉanso yʉyo ʉkʉmʉsemela. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Anga ɨze tai aɨmʉmʉhʉɨɨe ʉ Musa, aɨmʉzenihɨɨla nʉnene, kʉnsoko Musa aɨʉandɨkile mpola yane. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Ingɨ anga ɨze shanga mʉhʉɨɨe ayo Musa naɨ ʉandɨkile, mʉkʉhʉɨɨla ʉlɨ aya nɨkʉtambʉla?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">Yesʉ ʉkʉlɨsa ndya antʉ elupu itaano</para>
  <para style="r">
    <ref loc="MAT 14:13-21">Matayo 14:13-21</ref>; <ref loc="MRK 6:30-44">Maliko 6:30-44</ref>; <ref loc="LUK 9:10-17">Lʉka 9:10-17</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Naɨyakɨla nanso, Yesʉ wɨkaputa itʉmbɨ nɨla lʉzi nʉlʉkʉlʉ nʉla Galilaya ang’wi lʉzɨ nʉlʉkʉlʉ nʉla Tibelia. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Milʉndo ʉkʉlʉ nʉwa antʉ ʉkamʉtyata kʉnsoko antʉ nɨanso aɨaine ilɨngasɨɨlyo naɨʉkendituma niakʉakomya alwae. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Yesʉ wɨkanankɨla mʉlʉgʉlʉ, wɨkɨkiɨ pihɨpalʉng’wɨ nɨamanyisigwa akwe. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Matungo nanso iloeelya nɨla Ayahudi nɨlitangwa Pasaka aɨlahumbeela. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />Yesʉ naɨwagoza nʉkʉona antʉ ɨdʉ apembilye kʉng’wakwe, wɨkamʉɨla ʉ Pilipo, “Kʉgʉɨla pɨɨ mɨkate antʉ awa ahume kʉlya?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Yesʉ aɨʉtambʉe itɨ kʉmʉgema Pilipo, ingɨ ng’wenso aɨʉlɨngile nʉʉkitʉma.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Pilipo wɨkamʉsʉkɨɨlya, “Anga azaitule kʉkete mpia yɨdʉ, antʉ awa ga shanga akenela itule mʉntʉ wɨhi ʉkʉpegwa ʉnino da”<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Ʉng’wɨ mʉamanyisigwa akwe nʉwitangwa Endelea, mʉluna wang’wi Simon Petelo, wɨkamʉɨla, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“Apaitɨ ʉkolɨ mʉhʉmba ʉng’wɨ ʉkete mikatɨ ɨtaano angano nɨ nsamaki ibɨɨlɨ, ingɨ izi yɨkʉkondya ntʉni kʉantʉ awa nɨɨdu itɨ?”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />Pang’wanso ipwa nidabʉ. Yesʉ wɨkalʉnga, “Ikalɨnshi antʉ.” Ʉʉgwa, antʉ akishiɨ, ʉaligwa wao aɨitunja elupu itaano. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Yesʉ wɨkahola mɨkate nanso, wɨkamʉsongelya Itunda, wɨkaagalanya antʉ awo ɨhi naɨikiɨ, wɨkatendaʉʉ ni nsamaki, antʉ ɨhi ɨkalija mʉitakɨwɨ. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />Antʉ naɨikʉta Yesʉ wɨkaaɨla amanyisigwa akwe, “Hoeli ʉsago kɨleke kʉlimɨla anga kɨntʉ kɨhi.” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Ʉʉgwa ɨkahoeela ʉsago nʉwa mɨkate angano ninsamaki naɨasigilye antʉ naɨalɨe, ɨkizʉlya nkapu ikʉmi na ibɨɨlɨ. <verse eid="JHN 6:13" /><verse number="14" style="v" sid="JHN 6:14" />Antʉ naɨaona kɨlɨngasɨɨlyo nɨkanso Yesʉ naɨwitʉmile, ɨkalʉnga, “Ɨtai taai ʉyʉ yʉyʉ mʉmanga nʉang’wi Itunda nʉʉzile mʉʉnkumbigʉlʉ. <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Yesʉ naɨwalɨnga kɨna antʉ aɨalowa amʉtemye Ʉtemi, wɨkikoma nɨenso wɨkalongola winyene mʉlʉgʉlʉ.<verse eid="JHN 6:15" /></para>
  <para style="s">Yesʉ ʉkʉgenda migʉlya amazɨ</para>
  <para style="r">
    <ref loc="MAT 14:22-33">Matayo 14:22-33</ref>; <ref loc="MRK 6:45-52">Maliko 6:45-52</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Mpɨndɨ lyoa naɨlɨkʉhaɨɨla, amanyisigwa akwe ɨkahulumʉka kʉlʉzɨ nʉlʉkʉlʉ. <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />Ɨkanankɨla mibɨnɨ ɨkatula tambʉka kenda kʉ Kapelinaʉmu. Matungo nanso kiti aɨkituma nʉ Yesʉ aɨwakɨlɨ kʉapikɨɨla. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Lʉzi nʉlʉkʉlʉ lɨkakanzɨka nsoko ang’wega ʉkʉlʉ naɨʉkʉkunka. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Amanyisigwa akwe naɨendile lʉgendo nʉla maɨli itaano ang’wɨ mʉtandatʉ, ɨkamʉona Yesʉ ʉkʉgenda migʉlya amazɨ, ʉkʉhumbeela pibɨnɨ, ɨkogopa nangalu. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Sʉnga Yesʉ wɨkaaɨla, “Leki kogopi, ingɨ nene!” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Papo paapo kʉʉlowa ɨkigombya kʉmʉnankɨlya mibɨnɨ, papo ibɨnɨ lɨkapika kitʉmbɨ, kihɨɨ naɨalomee.<verse eid="JHN 6:21" /></para>
  <para style="s">Antʉ akʉmʉduma Yesʉ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Lʉhikʉ naɨlʉtyatɨɨe milʉndo waantʉ naɨasagile kitʉmbɨ lakabɨɨlɨ ɨkakɨmbʉka kɨna pang’wanso aɨlɨkolɨ ibɨnɨ lɨng’wɨ du, nʉ Yesʉ shanga aɨaheganilye nɨamanyisigwa akwe, ingɨ amanyisigwa aɨahegile ɨenso du. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Mabɨnɨ mangɨɨza kʉpumɨɨla kʉ Tibelia ɨkapika pang’wanso antʉ naɨalɨɨe mikatɨ, pa Isekʉlʉ aɨʉmʉsongeeye Itunda. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Itɨgwa, antʉ nɨanso naɨakesa kɨna Yesʉ nɨamanyisigwa akwe aɨɨkʉtilɨ pang’wanso, ɨkanankɨla mʉmabɨnɨ ɨkalongola kʉ Kapelinaʉmu ɨzemʉduma Yesʉ.<verse eid="JHN 6:24" /></para>
  <para style="s">Yesʉ ingɨ mʉkate nʉwɨleta ʉpanga</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Antʉ nɨanso naɨ amʉhanga ʉ Yesʉ kitʉmbɨ lalʉzɨ ɨkamʉkolya, “Mʉmanyisi, wapika nalɨ kʉnʉ itɨ?”<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />Yesʉ wɨkaasʉkɨɨlya, “Kʉmʉɨla ɨtai, mʉkʉnduma shanga kʉnsoko mʉine kɨlɨngasɨɨlyo, ingɨ kʉnsoko aɨmʉlɨe mɨkate mɨkikʉta. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Mʉleke kiaja kʉnsoko andya nɨyɨola, ingɨ iyagɨɨli ɨndya nɨyishiɨ kʉnsoko aʉpanga nʉwa kalɨ na kalɨ. Ng’waa Mʉntʉ ni Ihe ʉmʉɨkile, nʉwanso yʉyo ʉkʉmʉpa ʉlʉdya nʉlanso.”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Sʉnga ɨkamʉkolya, “Kʉtendeʉlɨ gwa kʉhume kitʉma mɨlɨmo ang’wi Itunda?” <verse eid="JHN 6:28" /><verse number="29" style="v" sid="JHN 6:29" />Yesʉ wɨkaasʉkɨɨlya, “Mʉlɨmo wang’wi Itunda ingɨ sʉwʉ, mʉhʉɨɨli ʉyo nʉmʉtʉmile.” <verse eid="JHN 6:29" /><verse number="30" style="v" sid="JHN 6:30" />Ɨkamʉkolya, “Ʉkʉʉtendeela kɨlɨngasɨɨlyo kɨɨ kʉhume kʉona, kʉʉhʉɨɨle? Itɨɨ, ʉkitʉma kɨntʉ kɨɨ? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Atata itʉ aɨʉapee lʉndya nʉlitangwa mana naɨakolɨ mʉwɨɨ, anga nɨyandɨkilwe Mʉʉandɨkwa wang’wi Itunda, ‘Aɨʉapee lʉdya naɨlʉpumɨɨe kigʉlʉ.”’ <verse eid="JHN 6:31" /><verse number="32" style="v" sid="JHN 6:32" />Sʉnga Yesʉ wɨkaaɨla, “Kʉmʉɨla ɨtai, shanga Musa naɨʉmʉpee lʉdya nʉlʉpumɨɨe kigʉlʉ, ingɨ Tata wane nɨwɨmʉpeza ʉnyenye lʉdya nʉlatai kʉpumɨɨla kigʉlʉ. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Kʉnsoko lʉdya lang’wi Itunda ingɨ ʉyo nʉʉkʉsima kʉpumɨɨla kigʉlʉ hangɨ wɨʉpeza ʉnkumbigʉlʉ ʉpanga.”<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />Itɨgwa, ɨkamʉɨla, “Isekʉlʉ, kandɨɨlya ino nɨmahikʉ ɨhi ʉkʉpeze lʉdya nʉlanso.” <verse eid="JHN 6:34" /><verse number="35" style="v" sid="JHN 6:35" />Yesʉ wɨkaaɨɨla, “Yʉnene lʉdya nʉla ʉpanga. Mʉntʉ nʉkʉpembya kʉng’wane shanga ʉkʉhung’wa nzala, nʉʉkʉnihʉɨɨla shanga ʉkʉhung’wa nyota lʉkʉlʉ. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Ingɨ anga naɨ nʉmʉtambʉɨe kɨna mamona mʉkɨlɨ kʉnihʉɨɨla. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Antʉ ɨhi nʉ Tata nʉʉkʉmpa akʉntyata. Nʉ mʉntʉ wɨhi nʉpembilye kʉng’wane shanga kʉmʉhita, <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />kʉnsoko nsimile kʉpuma kigʉlʉ shanga kʉnsoko nitʉme nindoewe, ingɨ nitʉme ɨko nʉtakile ʉyo nʉndagɨigwe. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />Aya yaya uloilwe nitʉme ʉyo nʉntʉmile, ndeke kʉmʉlimɨlya ga nʉyʉ nʉng’wɨ mʉ awo naɨ ʉmpee, ingɨ niiʉshe ɨhi nʉmpee. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Kɨntʉ nɨkɨkʉlʉ nʉloilwe ʉ Tata wane ingɨ sɨkɨ, mʉntʉ wɨhi nʉkʉmʉona ʉ Ng’wana nʉkʉmʉhʉɨɨla watule nʉʉpanga nʉwa kalɨ na kalɨ. Nʉ nene kʉmiʉsha lʉhikʉ nʉla mpelo.”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Itɨ gwa Ayahudi ɨkatula kʉmʉnang’anɨla kʉnsoko aɨʉlɨɨye, “Ʉnene ingɨ nɨ lʉdya nʉlʉsimile kʉpumɨɨla kigʉlʉ.” <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />Ɨkatula lʉnga, “Itɨɨ, ʉyʉ shanga ng’wana wang’wa Yusupu ne? Kʉalɨngile ihe nʉ nyinya. Ʉhumile ʉlɨ kʉlʉnga kɨna ʉsimile kʉpumɨɨla kigʉlʉ?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Yesʉ wɨkaaɨla, “Leki kinang’anɨla nyenye kʉ nyenye. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Kʉtilɨ mʉntʉ nʉhumile kɨza kʉng’wane, anga wahite kʉlutwa nʉ Tata nʉwane nʉntʉmile, nʉ nene kʉmiʉsha mʉntʉ nʉwanso lʉhikʉ nʉla mpelo. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Mʉmbugulu niya amanga yandɨkilwe itɨ, ‘Antʉ ɨhi akʉmanyisigwa nʉ Tata.’ Mʉntʉ wɨhi nʉkija nʉkʉlɨnga aya nʉkʉtambʉla ʉ Tata ʉzile kʉng’wane. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Kʉtilɨ mʉntʉ wɨhi nʉwamʉine ʉ Tata, kʉleka ʉyo nʉpumɨɨe kung’wi Itunda, nʉwanso wing’wene ʉdu yʉyo wamʉine Itunda. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Kʉmʉɨla ɨtai, kɨna ʉyʉ nʉkʉhʉɨɨla ʉkete ʉpanga nʉwa kalɨ na kalɨ. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Ʉnene ingɨ nɨmʉkate nʉwa ʉpanga. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Atata anyu ʉko mʉwɨ aɨalɨe ndya naɨ ipumɨɨla kigʉlʉ, ingɨ ɨkasha. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Ingɨ apa ʉkolɨ mʉkate nʉʉsimile kʉpumɨɨla kigʉlʉ, mʉntʉ wɨhi anga walye, shanga ʉkʉsha. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Ʉnene ingɨ lʉdya nʉlʉpanga nɨnsimile kʉpuma kigʉlʉ. Mʉntʉ wɨhi nʉkʉlya lʉdya ʉlʉ ʉkishiɨ ɨkalɨ na kalɨ. Nʉ lʉdya ʉlʉ nɨkʉpumya ingɨ mʉɨlɨ wane kʉnsoko a ʉpanga nʉwa antʉ amihɨɨ. <verse eid="JHN 6:51" /><verse number="52" style="v" sid="JHN 6:52" />Papo gwa Ayahudi ɨkatulikolya ɨenso, “Mʉntʉ ʉyʉ ʉhumile ʉlɨ kʉʉpeza mʉɨlɨ nʉwakwe, kʉʉlye?” <verse eid="JHN 6:52" /><verse number="53" style="v" sid="JHN 6:53" />Kʉitɨ Yesʉ wɨkaaɨla, “Kʉmʉɨli ɨtai, anga mʉhite kʉlya mʉɨlɨ nʉwa Ng’waa Mʉntʉ nʉkʉng’wa sakami akwe, ʉnyenye mʉkʉtula mɨagila anga ʉpanga. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Mʉntʉ wɨhi nʉkʉlya mʉɨlɨ wane nʉkʉng’wa sakami ane ʉkʉtula nʉʉpanga nʉwa kalɨ na kalɨ, nʉ nene kʉmiʉsha lʉhikʉ nʉla mpelo. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Kʉnsoko mʉɨlɨ wane ingɨ lʉdya nʉla tai, nɨsakami ane ingɨ kɨng’wegwa nɨka tai. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Mʉntʉ wɨhi nʉkʉʉlya mʉɨli wane nʉ kʉng’wa sakami ane, ʉkikiɨ mʉng’wane, nʉ nene kikiɨ mʉng’wakwe. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Anga ʉ Tata nɨmʉpanga nʉntʉmile, kʉkɨɨla Tata ʉnene nɨshiɨ, ʉʉgwa mʉntʉ wɨhi nʉkʉndya ʉnene ʉkishiɨ kʉkɨɨla nene. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Ingɨ, ʉlʉ lʉlʉ lʉdya nʉlʉsimile kʉpuma kigʉlʉ, shanga ihangaanga lʉdya nʉla mana naɨalɨe atata anyu, panyambele ɨkasha. Nʉʉkʉlya lʉdya ʉlʉ ʉkishiɨ kalɨ na kalɨ.” <verse eid="JHN 6:58" /><verse number="59" style="v" sid="JHN 6:59" />Yesʉ aɨʉtambʉe nkani izi naɨ ʉkʉmanyisa mʉnyʉmba akʉtankanɨla Ayahudi ʉko kʉ Kapelinaumu<verse eid="JHN 6:59" /></para>
  <para style="s">Nkani niyɨleta ʉpanga nʉwa kalɨ na kalɨ</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Itɨgwa, ɨdʉ amanyisigwa akwe ɨdʉ naɨija nanso, ɨkalʉnga, “Ʉmanyisigwa ʉwʉitɨ ingɨ ʉkaku! Nyanyu nʉhumile kʉʉgomba?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Yesʉ wɨkalɨnga mʉnkolo akwe, akaze wakɨlɨ kʉɨlwa nʉ mʉntʉ wɨhi kɨna amanyisigwa akwe aɨakʉnang’ana kʉnsoko aʉmanyisi wakwe, wɨkaakolya, “Itɨɨ, nɨkɨ ʉmanyisi ʉwʉ ʉkʉmʉtasha? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Yɨkʉtulaʉlɨ gwa anga nɨmʉzɨɨza mʉona ʉ Ng’waa Mʉntʉ ʉkʉtulya kigʉlʉ ʉko naɨ ʉpembeeye? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />Ng’wahʉ wang’wi Itunda yʉyo wɨmʉpeza ʉmʉntʉ ʉpanga, ʉmʉɨlɨ shanga ʉhumile kʉtenda anga kɨntʉ kɨhi. Nkani izi nɨkʉmʉɨla ingɨ Ng’wahʉ hangɨ ʉpanga. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Nɨ itɨga ingɨ mʉng’wanyu amolɨ nɨshanga ahʉɨɨe.” Yesʉ aɨʉtambʉe nanso kʉnsoko kʉpuma ʉng’wandyo nyenyu nɨshanga ahʉɨɨe, hangɨ nyenyu nʉzɨɨza mʉsuɨpa. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Sʉnga Yesʉ wɨkalʉnga, yɨyo ndogoelyo aɨnʉmʉtambʉɨe kɨna kʉtilɨ mʉntʉ nʉ humile kɨza kʉng’wane anga wahite kʉaɨɨligwa nʉ Tata wane.” <verse eid="JHN 6:65" /><verse number="66" style="v" sid="JHN 6:66" />Kʉpumɨɨla hapo, amanyisigwa akwe ɨdʉ ɨkamʉleka, ɨkaleka kʉkʉɨlania nʉng’wenso. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />Kʉlʉlo, Yesʉ wɨkaakolya amanyisigwa akwe awo ni ikʉmi na abɨɨlɨ, “Itɨɨ, nʉ nyenye ga makalongola ne?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Simoni Petelo wɨkamʉsʉkɨɨlya, “Isekʉlʉ, kʉhege kʉlongole kʉng’wa nyanyu? Ʉewe ʉkete nkani niya ʉpanga wa kalɨ na kalɨ. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Ʉsese kʉhʉɨɨe, hangɨ kalɨnga kɨna ʉewe ingɨ wɨ Ng’wana wang’wi Itunda nʉ mʉpanga.” <verse eid="JHN 6:69" /><verse number="70" style="v" sid="JHN 6:70" />Yesʉ wɨkaaɨla amanyisigwa akwe, “Itɨɨ, shanga aɨnimuhoile ʉnyenye mikʉmi naabɨɨlɨ? Nɨitɨ ga ʉng’wɨ wanyu apaitɨ ingɨ shetani!” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />Yesʉ aɨʉkʉmʉlapa Yʉda, ng’wana wang’wa Simon Isikalioti, ʉng’wɨao mʉamanyisigwa nikʉmi naabɨɨlɨ, panyambele yʉyo nʉzɨɨza mʉsuɨpa.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">Yesʉ shanga ʉhʉɨɨwe nɨaluna akwe</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Naɨyakɨla makani nanso, Yesʉ aɨʉkenditʉma nkɨka yɨdʉ mʉ Galilaya, shanga aɨʉloilwe kʉlongola kʉkɨsalɨ ka Yʉdea kʉnsoko atongeeli a Ayahudi aɨalomeela kʉmʉbʉlaga. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Aɨlahumbeela iloelya la Ayahudi nɨla nkambɨ ingɨ kʉkɨmbʉkɨɨlya likalo nʉla kʉhamanga mijangwa. <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />Ʉʉgwa aluna ang’wa Yesʉ ɨkamʉɨla, “Hega apaitɨ wende kʉ Yʉdea amanyisigwa ako ahume kʉona mʉlɨmo wako nʉwitʉma. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Mʉntʉ anga walowe kʉkumʉka mʉantʉ shanga witʉma makani kɨʉnkunku. Kʉnsoko ʉkitʉma makani aya, igeeleke kʉ antʉ” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Kʉnsoko nɨaluna akwe ga shanga ɨkamʉhʉɨɨla. <verse eid="JHN 7:5" /><verse number="6" style="v" sid="JHN 7:6" />Yesʉ wɨkaasʉkɨɨlya, “Itungo lane nɨlɨgombekile lɨkɨlɨ kʉpika. Ingɨ kʉng’wanyu matungo ɨhi agombekile. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Antu amʉnkumbigʉlʉ shanga ʉhumile kʉmʉbɨpɨlwa ʉnyenye, ingɨ ambɨpɨwe kʉnsoko ʉnene kʉakumʉɨla kɨna ntendo nɨakitʉma ingɨ mbɨ. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Ʉnyenye longoli kiloelya nɨlanso. Ʉnene shanga ninzʉ kʉnsoko itungo lane lɨkɨlɨ kʉpikɨɨla,” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Yesʉ naɨwatambʉla nanso wɨkasiga kʉng’wanso kʉ Galilaya<verse eid="JHN 7:9" /></para>
  <para style="s">Yesʉ kiloelya nɨla nkambɨ</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Ingɨ aluna akwe naɨ alongola kiloelya, Yesʉ nʉng’wenso wɨkalongola, shanga aɨwendile kihenga ingɨ kiembeelya. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Piloelya nɨlanso, atongeeli a Ayahudi aɨakʉmʉduma, ɨkakolya, “Ʉkolɨ pɨ ʉmʉntʉ ʉyʉ?” <verse eid="JHN 7:11" /><verse number="12" style="v" sid="JHN 7:12" />Lɨkigela ing’ung’u mʉmilʉndo nʉwa antʉ, niang’wɨ aɨakʉlʉnga, “Ingɨ mʉntʉ mʉza” Nɨang’wɨ ɨkalʉnga, “Aa! Ʉkʉalimangɨlya antʉ.” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Nɨ itɨga kʉtilɨ anga mʉntʉ wɨhi naɨʉgemile kʉtambʉla kihenga kʉnsoko aɨaogopile atongeeli a Ayahudi. <verse eid="JHN 7:13" /><verse number="14" style="v" sid="JHN 7:14" />Iloelya naɨ lanonela, Yesʉ wɨkalongola kʉnyʉmba ang’wi Itunda, wɨkandya kʉmanyisa. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Ʉʉgwa atongeeli a Ayahudi ɨkakʉɨlwa ɨkalʉnga, “Mʉntʉ ʉyʉ shanga ʉmanyisigwe, wapumya pɨ ʉmanyisi ʉwʉ?”<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Yesʉ wɨkaasʉkɨɨlya, “Ingɨ ʉwʉ shanga ʉmanyisi wane, Itunda naɨ ʉntʉmile ʉnene yʉyo ʉmanyisilye. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Mʉntʉ wɨhi nʉloilwe kitʉma ayo ni Itunda ʉmaloilwe, ʉkʉmanya kɨna ʉmanyisi wane ʉpumɨɨe kʉng’wi Itunda, ang’wɨ kitambʉɨlya ʉnene. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Mʉntʉ nʉwɨtambʉɨlya ʉng’wenso wɨduma wikʉlye ʉng’wenso, nʉyo nʉwɨduma kʉmʉkʉlya ʉyo nʉmʉlagɨɨye, nʉwanso ingɨ mʉkendegeeli, hangɨ mʉgila ʉbɨ wɨhi mʉnkolo akwe. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Itɨɨ, shanga aɨmʉpewe malagɨɨlyo ne nʉ Musa? ingɨ kʉtilɨ mʉntʉ wɨhi nʉambile malagɨɨlyo nanso. Mʉkʉduma kʉmbʉlaga nɨkɨ? <verse eid="JHN 7:19" /><verse number="20" style="v" sid="JHN 7:20" />Milʉndo nʉwa antʉ ʉkamʉsʉkɨɨlya, “Ʉewe ʉkete hɨng’wɨ. Nyenyu ʉkʉduma kʉʉbʉlaga?” <verse eid="JHN 7:20" /><verse number="21" style="v" sid="JHN 7:21" />Yesʉ wɨkaasʉkɨɨlya, “Nitʉmile kɨlɨngasɨɨlyo kɨng’wɨ nʉnyenye makʉɨlwa. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Ingɨ logo naɨmʉpewe nʉ Musa nɨlakitala kiganda, ulogo nʉlanso shanga aɨʉpumɨɨe kʉng’wa Musa, ingɨ aɨʉpumɨɨe kʉisekʉlʉ anyu, ʉnyenye miatala antʉ kiganda mʉlʉhikʉ nʉla kʉsupya ga. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Angaitule mʉlʉhikʉ nʉlakʉsupya mʉntʉ witalwa kiganda ndogoelyo lɨleke kʉbunangwa ilagɨɨlyo, nɨkɨ mʉkʉtaka kʉnsoko namʉkomya mʉntʉ watula mʉpanga lʉkʉlʉ mʉ Lʉhikʉ nʉla kʉsupya? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Leki kʉmʉpɨsɨɨlyi ʉmʉntʉ anga nɨmʉmʉine ʉnyenye, ingɨ mʉpɨsɨɨlyi ʉ mʉntʉ kʉtai.<verse eid="JHN 7:24" /></para>
  <para style="s">Itɨɨ, ʉyʉ yʉyʉ Kilisito ne?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Antʉ angwɨ nɨakʉ Yelusalemu ɨkatulikolya, “Itɨɨ, ingɨ yʉyʉ nɨakʉduma kʉmʉbʉlaga? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Gozigwa, itungo ili ʉkolɨ papa ʉkʉtambʉla kɨhenga mʉantʉ ɨhi, tilɨ anga mʉntʉ nʉʉkʉmʉɨla lʉkani lɨhi. Itɨɨ, yɨhumile atongeeli alɨnga kɨna ʉyʉ yʉyʉ Yesʉ ne? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Ingi ʉsese kʉlɨngile mʉntʉ ʉyʉ kʉʉpumɨɨe. Kulɨngile kɨna ʉ Yesʉ nʉʉzɨzɨza kʉtilɨ angamʉntʉ nʉʉkʉlɨnga kʉʉpumɨe,” <verse eid="JHN 7:27" /><verse number="28" style="v" sid="JHN 7:28" />Ʉʉgwa Yesʉ naɨʉkʉmanyisa Mʉnyʉmba ang’wi Itunda wɨkitʉnta wɨkalʉnga, “Ʉnyenye mʉnɨngile, nʉko ga nɨmpumɨɨe mʉlɨngile. Nɨitega, shanga aɨnzile kʉʉhumi wane, ingɨ ʉyo nʉntʉmile ʉnene ingɨ mʉnya tai nʉnyenye shanga mʉmʉlɨngile. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />Ingɨ ʉnene nʉmʉlɨngile kʉnsoko mpumɨɨe kʉng’wakwe, hangɨ ng’wenso ʉntʉmile.” <verse eid="JHN 7:29" /><verse number="30" style="v" sid="JHN 7:30" />Ʉʉgwa antʉ ang’wɨ ɨkahiya kʉmʉamba, ingɨ kʉtilɨ anga mʉntʉ wɨhi naɨ ʉgemile kʉmʉamba kʉnsoko itungo lakwe aɨlɨkɨlɨ kʉpikɨɨla. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Antʉ ɨdʉ mʉmilʉndo nʉwanso ɨkamʉhʉɨɨla, nawo aɨakʉlʉnga, “Itɨɨ, ʉ Kilisito mʉguni angawaze ʉkʉtenda ne kɨlɨngasɨɨlyo nɨkɨkʉlʉ kʉkɨla nʉʉkʉtenda ʉ mʉntʉ ʉyʉ?”<verse eid="JHN 7:31" /></para>
  <para style="s">Amboi akʉtʉng’wa amʉambe ʉ Yesʉ</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Apalisayo ɨkija antʉ aking’ung’ula makani nʉwitʉmile Yesʉ. Itɨgwa, Apolyi nɨakʉlʉ nɨ Apalisayo ɨkalagɨɨlya amboi amʉambe. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />Kʉlʉlo Yesʉ wɨkaaɨla, Kikiɨ palʉng’wɨ nʉnyenye kʉpikɨɨla nalɨ, sʉnga kʉtulya kʉng’wakwe ʉyo naɨʉntʉmile. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Mʉkʉnduma ingɨ shanga mʉkʉmona, apo nɨnkolɨ ʉnene ʉnyenye mʉkʉleng’wa kʉpika,” <verse eid="JHN 7:34" /><verse number="35" style="v" sid="JHN 7:35" />Atongeeli a Ayahudi ɨkatula kitambʉɨla ɨenso, “Mʉntʉ ʉyʉ ʉlongoe pɨ ni shanga kʉʉhuma kʉpika? Ʉkʉlongola kʉ Ayahudi ao nɨabalansanile mʉ Ayʉnani nʉkʉamanyisa Ayʉnani? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Ʉkete ndogoelyo kɨ, nʉʉkʉlʉnga kɨna ‘Mʉkʉnduma shanga mʉkʉmona napo nɨnkoli ʉnyenye shanga mʉkʉpika?”’<verse eid="JHN 7:36" /></para>
  <para style="s">Ndiɨlyo a mazɨ aʉpanga</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Lʉhikʉ nʉla kʉmalɨnkɨlya iloelya nɨla Ayahudi. Yesʉ wɨkimɨka, wɨkitʉnta, “Nʉhumilwe nyota waze wang’we mazɨ kʉng’wane <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Anga niyandɨkilwe Mʉʉandɨkwa Nʉʉza mʉntʉ wɨhi nʉnihʉɨɨe ʉnene, ‘ndiɨlyo amazɨ aʉpanga ɨkʉtula hʉma kʉpuma mʉnkolo akwe!”’ <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Yesʉ aɨʉtambʉe nanso kʉkɨɨla Ng’wahʉ wang’wi Itunda awo ɨhi niamʉhʉɨɨe akʉmʉsɨngɨɨlya. Itungo nʉlanso Ngwahʉ wang’wi Itunda aɨwakɨlɨ kʉza kʉnsoko Yesʉ aɨ wakɨlɨ kʉkʉligwa.<verse eid="JHN 7:39" /></para>
  <para style="s">Antʉ akʉtemanʉka kʉng’wa Yesʉ</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Antʉ ang’wɨ mʉmilʉndo nʉwanso naɨ igule nkani nɨyanso ɨkalʉnga, “Mʉntʉ ʉyʉ yʉyʉ mʉmanga ɨtai taai” <verse eid="JHN 7:40" /><verse number="41" style="v" sid="JHN 7:41" />Nɨang’wɨ ɨkalʉnga, “Ʉyʉ yʉyʉ Kilisito!” Ingɨ nɨang’wɨ ɨkalʉnga, “Itɨɨ, ʉ Kilisito ʉpumɨe kʉ Galilaya? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Itɨɨ, Ʉandɨkwa nʉʉza shanga alʉngile ne kɨna Kilisito ʉzile kʉpuma mʉndʉgʉ ang’wa Daudi, hangɨ ʉkʉtugwa kʉ Betilehemu kɨsalɨ kang’wa Daudi?” <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Papogwa, mʉmilʉndo nʉwanso antʉ ɨkatemanʉka kʉnsoko ang’wa Yesʉ. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Antʉ ang’wɨ ɨkahiya kʉmʉamba ingɨ kʉtilɨ naɨʉgemile kʉmʉamba.<verse eid="JHN 7:44" /></para>
  <para style="s">Atongeeli a Ayahudi ahitile kʉmʉhʉɨɨla ʉ Yesʉ</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Sʉnga amboi nɨanso ɨkatulya kʉakʉlʉ a Apolyi nɨa Palisayo naɨ atʉmile amʉambe ʉ Yesʉ, nienso ikaakolya, “Nɨkɨ shanga mamʉamba?” <verse eid="JHN 7:45" /><verse number="46" style="v" sid="JHN 7:46" />Amboi nɨanso ɨkaasʉkɨɨlya, “Kutilɨ anga mʉntʉ nʉhumile kʉtambʉla anga mʉntʉ ʉyʉ!” <verse eid="JHN 7:46" /><verse number="47" style="v" sid="JHN 7:47" />Apalisayo ikaakolya, nʉnyenye ga makongelwa ne? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Itɨɨ, mamʉine nyenyu mʉatongeeli aantʉ, ang’wɨ ʉng’wɨ Mʉapalisayo nʉmʉhʉɨɨe? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Ingɨ milʉndo nʉwa antʉ nɨamʉhʉɨɨe shanga alɨngile malagɨɨlyo ang’wa Musa, azumilwe ni Itunda.”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Ʉʉgwa Nikodemo naiza ʉng’wɨao mʉatongeeli nɨanso lʉhikʉ lʉng’wɨ ʉtikʉ aɨʉmendee Yesʉ. Itɨgwa, nʉwanso wɨkaaɨla, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“Itɨɨ, malagɨɨlyo itʉ ɨmʉpɨsɨɨlya ne mʉntʉ nʉwakɨlɨ kʉtegeeligwa hanza waoneligwe igazo nʉtendile?” <verse eid="JHN 7:51" /><verse number="52" style="v" sid="JHN 7:52" />Nɨenso ɨkamʉsʉkɨɨlya, ‘Itɨɨ, nʉwewega ʉpumɨɨe kʉ Galilaya ne? Kendegele kɨsa nʉwewe ʉkʉlɨnga kɨna kʉ Galilaya shanga ʉzɨɨza pumɨɨla mʉmanga wang’wi Itunda!”<verse eid="JHN 7:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53" />Sʉnga antʉ ɨhi ɨkahega ɨkalongola kʉmatolao.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">Mʉsʉngʉ nʉambilwe wilandi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Sʉnga Yesʉ wɨkenda mʉlʉgʉlʉ nʉla Mizeituni. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Mʉdao kidaʉdaʉ Yesʉ wɨkalongola hangɨ mʉ Nyʉmba ang’wi Itunda. Antʉ ɨhi ɨkamʉpilimɨlya, nʉyo wɨkikiɨ wɨkatula amanyisa. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Amanyisi amalagɨɨlyo ang’wa Musa nɨ Apalisayo ikamʉleta mʉsʉngʉ ʉng’wɨ nʉambilwe wilandi. Ɨkamimɨsha pakatɨao. <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />Sʉnga ɨkamʉɨla ʉ Yesʉ “Mʉmanyisi, Mʉsʉngʉ ʉyʉ ʉambilwe wilandi. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Mʉmalagɨɨlyo ang’wa Musa ʉkʉlagɨɨye kɨna mʉsʉngʉ nʉtendile itɨ wakʉwe magwe washe. Ʉʉgwa, ʉewe ʉlɨɨye ulɨ?” <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />Aɨatambʉe itɨ kʉmʉgema ahume kʉpantɨka nsoko akʉmʉsemela. Ingɨ Yesʉ wɨkatuna pihɨ, wɨkatula andɨka nashala kakwe pihɨ. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Naɨ alongoleka kʉmʉkolya, Yesʉ wɨkahʉmbʉka, wɨkaaɨla, “Mʉntʉ wɨhi mʉng’wanyu nʉmʉgila anga mɨlandʉ watongele kʉmʉgʉma mʉsʉngʉ ʉyʉ igwe. <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Yesʉ wɨkatuna hangɨ, wɨkalongoleka kʉandɨka kʉshala kakwe pihɨ. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />Naɨakondya kija itɨ, ɨkatulahega ʉng’wɨ ʉng’wɨ akaze atongeewe nɨanyampala awo. Yesʉ wɨkasiga wɨng’wene, nʉmʉsʉngʉ nʉwanso aɨwɨmɨkile pantongeela akwe. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Yesʉ wɨkahʉmbʉka wɨkamʉkolya mʉsʉngʉ nʉwanso, “Iya, akolɨpɨ asemi ako? Itɨɨ, kʉtilɨ anga nʉʉng’wɨ nʉkʉsemee kɨna ʉgazilye? <verse eid="JHN 8:10" /><verse number="11" style="v" sid="JHN 8:11" />Mʉsʉngʉ nʉwanso wɨkamʉsʉkɨɨlya, “Mʉkʉlʉ wane, kʉtilɨ anga nʉʉng’wɨ.” Yesʉ wɨkamʉɨla “Ingɨ ʉnene shanga kʉʉpɨsɨɨlya. Longola, kandɨɨlya itungo lɨlɨ ʉpele kʉtenda mɨlandʉ.”<verse eid="JHN 8:11" /></para>
  <para style="s">Yesʉ nzelya aantʉ mʉʉnkumbigʉlʉ</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Sʉnga, Yesʉ wɨkaaɨla hangɨ, “Ʉnene ingɨ nzelya aantʉ mʉʉnkumbigʉlʉ. Mʉntʉ wɨhi nʉʉkʉntyata ʉnene shanga ʉkʉgenda mʉkiti, ingɨ ʉkʉtula ʉkete nzelya aʉpanga.”<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />Apalisayo ɨkamʉɨla, “Ʉkitambʉla ʉewe, kʉlʉlo ʉwitambʉli wako shanga ʉgombekile”<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />Yesʉ wɨkaasʉkɨɨlya, “Itende kitambʉla ʉnene, witambʉli wane ingɨ watai kʉnsoko ʉnene nɨngile kʉmpembeeye nʉko kʉnihongile nɨngile. Ingɨ ʉnyenye shanga mʉlɨngile kʉmpembeeye nʉko kʉnihongile. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Ʉnyenye mɨpɨsɨɨlya anga antʉ nɨɨpɨsɨɨlya, ingɨ ʉnene shanga nɨpɨsɨlya anga antʉ. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Anga mpɨsɨɨlye, ʉpɨsɨɨlyi wane ingɨ ɨtai kʉnsoko shanga kʉpɨsɨɨlya ning’wene, ingɨ kʉpɨsɨɨlya palʉng’wɨ nʉ Tata nʉntʉmile. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Mʉmalagɨɨlyo anyu yandɨkilwe kɨna natambʉwe nɨantʉ abɨɨlɨ ingɨ agombekile. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Ʉnene kitambʉla ʉnene, nʉ Tata nʉntʉmile ʉkʉntambʉɨlya.”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />Pang’wanso ɨkamʉkolya, “Ʉkolɨpɨ ʉ Tata nʉwako?” Yesʉ wɨkaasʉkɨɨlya, “Ʉnyenye shanga mʉnɨngile ʉnene nʉ Tata nʉwane ga shanga mʉmʉmanyile.</para>
  <para style="p" vid="JHN 8:19">Angaɨtule mʉnɨngile ʉnene, aza mʉzemʉlɨnga nʉ Tata wane ga.”<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Nkani niyanso Yesʉ aɨ ʉkʉtambʉɨla nanso naɨ ʉkʉmanyisa pa nyʉmba ang’wi Itunda pakupɨ nɨ sandɨko nɨlakʉgʉmɨla masongeelyo. Kʉtilɨ anga mʉntʉ naɨ ʉmʉambile, kʉnsoko matungo akwe nakʉambwa aɨakɨlɨ kʉpika.<verse eid="JHN 8:20" /></para>
  <para style="s">Kʉnihongile ʉnyenye shanga mʉkʉpika</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Yesʉ wɨkaaɨla hangɨ, ‘‘Ʉnene nalongola nʉnyenye mʉkʉtʉla nduma, ingɨ ʉnyenye mʉkʉsha nɨmɨlandʉ anyu. Ʉnyenye shanga mʉkʉpika ʉko kʉnomile ʉnene.”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />Ʉʉgwa, atongeeli a Ayahudi ɨkalʉnga, ‘Itɨɨ, ʉkibʉlaga ne? Kolwa, ʉkʉlʉnga, ‘Kʉnomile ʉnyenye shanga mʉkʉpika’?”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />Yesʉ wɨkaaɨla, “Ʉnyenye mʉpumɨɨe papa pihɨ mihɨɨ, ʉnene mpumɨɨe kigʉlʉ. Ʉnyenye ingɨ mɨa ʉnkumbigʉlʉ wʉwʉ, ʉnene shanga nɨa ʉnkumbigʉlʉ ʉwʉ. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Yɨyɨ ndogoelyo aɨnʉmʉɨɨe kɨna mʉkʉsha nɨmɨlandʉ anyu. Anga mʉhite kʉhʉɨɨla kɨna ‘Ʉnene yʉyʉ,’ mʉkʉsha mʉmɨlandʉ anyu<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />Nɨenso ɨkamʉkolya, “Wɨnyenyu gwa ʉewe?”</para>
  <para style="p" vid="JHN 8:25">Yesʉ wɨkaasʉkɨɨlya, “Unene yʉyo naɨ nʉmʉtambʉɨe kʉpuma ʉng’wandyo. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Nkete makani ɨdʉ nakʉmʉɨla nʉkʉmʉpɨsɨɨlya. Ingɨ ʉyo nʉntʉmile mʉnya tai, nʉnene kʉaɨla antʉ amʉʉnkumbigʉlʉ makani yayo du naɨ nigulye kʉng’wakwe.”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />Nɨanso shanga aɨalɨngile kɨna Yesʉ aɨʉkʉtambʉla makani ang’wi Ihe Itunda. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Sʉnga Yesʉ wɨkaaɨla, “Nɨmʉzɨɨza mʉtʉmbɨka ʉ Ng’waa Mʉntʉ mikota, papogwa mʉzɨɨzalɨnga kɨna ‘Yʉ nene,’ hangɨ kɨna ʉnene ning’wene shanga nɨtenda kɨntʉ kɨhi, ingi nɨtambʉla ayo du ʉtata aɨʉmanyisilye. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Ʉyo nʉntʉmile ʉkolɨ palʉng’wɨ nʉnene, shanga ʉndekile ninyene kʉnsoko mahikʉ ɨhi nitʉma ayo namʉloeeye.”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />Antʉ ɨdʉ naɨija ʉ Yesʉ ʉkʉligitya nanso ɨkahʉɨɨla.<verse eid="JHN 8:30" /></para>
  <para style="s">Ɨtai ɨkʉmʉtenda mʉlekelwe</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Ʉʉgwa, Yesʉ wikaaɨla Ayahudi awo naɨamʉhʉɨɨe, “Anga mʉambe nkani yane mʉkʉtula mɨamanyisigwa ane ɨtai taai. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />Mʉkʉmɨlɨnga ɨtai, nɨtai naanso ɨkʉtenda mʉlekelwe.”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />Nɨanso ɨkamʉsʉkɨɨlya, “Ʉsese kiele lang’wi Ibulahimʉ, hangɨ itʉnʉ kʉkɨlɨ kʉtula kɨatʉʉgwa kʉmʉntʉ wɨhi. Ʉhumile ʉlɨ kʉlʉnga kɨna ‘Mʉkʉtula malekewa’?”<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />Yesʉ wɨkaasʉkɨɨlya, “Kʉmʉɨla ɨtai, mʉntʉ wɨhi nʉwitenda mɨlandʉ nʉwanso ingɨ mʉtʉʉg’wa nʉwa mɨlandʉ. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Mʉtʉʉg’wa mʉgila likalo nʉlʉkʉlʉ kito, ingɨ ng’wana ʉkete likalo nʉlʉkʉlʉ. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Ʉʉgwa Ng’wana anga wamʉsashe mʉlekelwe, mʉkʉlekelwa ɨtai taai. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Ʉnene nɨngile kɨna ʉnyenye miele lang’wi Ibulahimʉ. Nɨitɨ ga mʉkʉhiya kʉmbʉlaga kʉnsoko nkani yane ngila anga lyoma mʉnkolo yanyu. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Ʉnene kʉmʉtambʉɨla ayo naɨnɨmaine naɨkine nʉ Tata, ʉʉgwa nʉnyenye mʉkitʉma ayo naɨmigulye kʉpuma kʉatata anyu.”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />Nɨenso ɨkamʉsʉkɨɨlya, “Ʉsese ʉtata witʉ Ibulahimʉ” Yesʉ wɨkaaɨla,</para>
  <para style="p" vid="JHN 8:39">“Ang’wɨ ʉnyenye mɨana ang’wi Ibilahimʉ, azamʉzitʉma ayo naɨwitʉmile Ibulahimʉ. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Ingɨ itungo ɨlɨ ʉnyenye mainaduma kʉmbʉlaga mʉntʉ nɨnʉmʉtambʉɨe ɨtai naɨ nigule kʉpuma kʉng’wi Itunda. Itɨ Ibulahimʉ shanga aɨwitʉmile itɨ. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Ʉnyenye mʉkitʉma makani ayo nʉwitʉma tata wanyu.” Nawo ɨkamʉɨla.”</para>
  <para style="p" vid="JHN 8:41">“Ʉsese shanga kɨana akɨzumɨ. Tata witʉ ʉng’wɨdu ingɨ Itunda.”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Yesʉ wɨkaaɨla, “Angaɨze Itunda Tata wanyu, azamʉzendowa ʉnene, kunsoko ʉnene aɨmpumile kʉng’wi Itunda nɨtungo ɨlɨ nkolɨ papa. Ʉnene shanga aɨnzile kʉʉhumi wane, ingɨ ng’wenso aɨʉntʉmile. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Nɨkɨ shanga mʉlɨngile aya nɨkʉtambʉla? Ingɨ kʉnsoko shanga mʉkee ʉmanyisi wane. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Ʉnyenye mɨana ang’wa tata wanyu ʉ shetani hangɨ mʉkʉhiya kʉkondanɨlya nsʉla ang’wa tata nʉwanyu. Puma ʉng’wandyo nʉwanso aɨmʉbʉlagani shanga ʉhumile kɨmɨkɨɨla ɨtai, kʉnsoko kʉtilɨ anga tai mʉng’wakwe. Nʉkʉtambʉla ʉteele wɨtambʉla anga nʉwizɨɨe, kʉnsoko nʉwanso mʉteele hangɨ tata nʉwaʉteele. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Ʉnene kʉtambʉla ɨtai, ʉnyenye mahita kʉnɨhʉɨɨla. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Nʉʉlɨ mʉng’wanyu nʉhumile kʉlʉnga kɨna ʉnene nkete mɨlandʉ? Anga ɨtule kʉmʉɨla ɨtai, nɨkɨ shanga mʉnihʉɨɨe? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Mʉntʉ wɨhi nʉpembeeye kʉng’wi Itunda wɨtegeelya nkani yang’wi Itunda. Ingɨ ʉnyenye shanga mʉkee kʉnsoko shanga mʉpumile kʉng’wi Itunda.”<verse eid="JHN 8:47" /></para>
  <para style="s">Yesʉ aɨʉmolɨ Ibulahimʉ naɨwakɨlɨ kʉtugwa</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />Ayahudi ɨkamʉɨla Yesʉ, “Itɨɨ, shanga kʉtambʉe tai kɨna ʉewe wɨ Mʉsamalia, hangɨ ʉkete hɨng’wɨ?”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Yesʉ wɨkasʉkɨɨlya, “Ʉnene nɨmʉgila anga hɨng’wɨ, ingɨ nʉmʉkʉiye ʉ Tata wane nʉnyenye shanga mʉnkee. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Ʉnene shanga kʉduma ɨkʉlyo nɨlane, ʉkolɨ ʉng’wɨ nʉkʉndumɨlya ikʉlyo nɨlanso, nʉwanso yʉyo mʉlamʉli. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Kʉmʉtambʉɨla ɨtai, mʉntʉ wɨhi nʉʉkʉkela ʉmanyisi wane shanga ʉkʉsha ikalɨ na kalɨ.”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Papogwa, Ayahudi ɨkamʉɨla, Itungo ɨlɨ kalɨnga ɨtai kɨna ʉewe ʉkete hɨng’wɨ. Ibulahimʉ aɨʉkule, amanga nawo aɨakule, ʉewe ʉkʉlʉnga age, ‘Mʉntʉ nʉʉkʉkela ʉmanyisi wane shanga ʉkʉsha lʉkʉlʉ?’ <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Itɨɨ, wainikʉlya kʉkɨla tata witʉ Ibulahimʉ naɨʉkule? Nɨamanga aɨakule. Ʉewe ʉkʉsɨga kɨna wɨnyenyu?”<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />Yesʉ wɨkasʉkɨɨlya, “Anga nikʉlye ʉnene, ikʉlyo lane shanga kɨntʉ. Tata wane ng’wenso ʉkʉnkʉlya, yʉyo ʉnyenye nɨmɨmitanga Itunda wanyu. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Ʉnyenye ɨza mʉkɨlɨ kʉmʉlɨnga, ingɨ ʉnene nɨmʉlɨngile. Hangɨ, anganʉnge shanga nʉmʉlɨngile, kʉtula nɨmʉteele anga ʉnyenye. Ingɨ ʉnene nʉmʉlɨngile hangɨ kitʉma nʉtambʉe. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Tata wanyu Ibulahimʉ, aɨwɨloile waone lʉhikʉ lane, nʉng’wenso wɨkaona, wɨkalowa.”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Papogwa Ayahudi ikamʉkolya, ‘Ʉwewe ʉkili kʉpisha myaka makʉmi ataano, nʉwewe ʉkʉlʉnga wamʉine Ibilahimu?”<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />Yesʉ wɨkaaɨla “Kʉmʉɨla ɨtai, Ibulahimʉ naɨwakɨlɨ kigela ʉnene aɨnkolɨ.”<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />Papogwa ɨkatula hoela magwe amʉkʉe, ingɨ Yesʉ wɨkinyeleka, wɨkapuma pa Nyʉmba ang’wi Itunda.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">Yesʉ ʉkʉmʉkomya mʉntʉ nʉtugilwe mʉpoku</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Lʉhikʉ lʉng’wi Yesʉ naɨʉkʉkɨla wɨkamʉona mʉntʉ ʉng’wɨ, naɨmʉpoku kʉpuma nʉwatugɨwe. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Amanyisigwa akwe ɨkamʉkolya, “Mʉmanyisi, nyenyu naʉɨtendile mʉlandʉ, mʉpaku ʉyʉne, ang’wɨ aleli akwe, watugwe mʉpoku?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />Yesʉ wɨkasʉkɨɨlya, “Mʉpoku ʉyʉ shanga aɨwitʉmile anga mʉlandʉ, nɨaleli akwe ga shanga itumɨle anga mʉlandʉ, ingɨ ʉtugilwe mʉpoku kʉnsoko ʉhumi wang’wi Itunda wigeeleke mʉlikalo lakwe. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Niikɨlɨ ng’ʉng’wɨ kʉtakɨwe kitʉma mɨlɨmo wakwe ʉyo nʉntʉmile, kʉnsoko ʉtikʉ ʉpembilye mʉntʉ nɨshanga ʉhumile kitʉma mʉlɨmo. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Itungo nɨnkolɨ mʉʉnkumbigʉlʉ, ʉnene ingɨ nɨnzelya antʉ aʉnkumbigʉlʉ.”<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Naɨwakondya kʉtambʉla nanso, wɨkatya mate pihɨ, wɨkanonia ilolo, wɨkamʉpaka mʉpoku nʉwanso mʉmiho. <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />Wɨkamʉɨla, “Longola ʉkalale milambo la Siloamu.” Lʉkani Siloamu ndogoelyo akwe ingɨ, “Nʉtʉmilwe.” Papo, mʉpoku nʉwanso wɨkalongola, wɨkakalala, sʉnga wɨkatulya wazeona.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Itɨgwa, anyakisalɨ akwe naɨza alɨngile kɨna ng’wandyo mʉntʉ nʉwanso aɨmʉhimbɨ milompisi, ɨkalʉnga, “Itɨɨ, ʉyʉ shanga mʉhimbɨ ʉyone naɨwikiɨ wazilompeelya?”<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />Nɨang’wɨ ɨkalʉnga “Yʉyʉ ng’wenso.” Aʉya ɨkalʉnga, “Shanga ng’wenso,” Impyani ʉdu.”</para>
  <para style="p" vid="JHN 9:9">Ingɨ mʉpoku nʉwanso wɨkalʉnga, “Yʉ nene.”<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Antʉ nɨanso ɨkatula mʉkolya, “Itɨɨ, miho ako ahuma ʉlɨ kʉona?”<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Nʉanso wɨkaasʉkɨɨlya, “Mʉntʉ ʉyo nʉwitangwa Yesʉ azaʉluile ilolo, wampaka mʉmiho nʉkʉmbɨla, ‘Longola ʉkalale milambo la Siloamu.’ Ingɨ nalongola, nakalala, natulaona.”<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />Antʉ nɨanso ɨkamʉkolya, “Yesʉ nʉwanso ʉkolɨ pɨɨ?”</para>
  <para style="p" vid="JHN 9:12">Nʉng’wenso wɨkaasʉkɨɨlya, “Ʉnene shanga mine.”<verse eid="JHN 9:12" /></para>
  <para style="s">Apalisayo akʉkolenkeelya kʉkomigwa kʉ mʉpoku</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Sʉnga antʉ nɨanso ɨkamʉtwala mʉntʉ ʉyʉ naɨmʉpoku kʉ Apalisayo. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Ingɨ lʉhikʉ nʉlanso Yesʉ naɨʉluile ilolo nʉkʉmʉkomya mʉpoku miho aɨlʉhikʉ nʉla kʉsupya Ayahudi. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Papo Apalisayo ɨkaakamʉkolya mʉntʉ nʉwanso naɨʉkomigwe, “Wahuma ʉlɨ kʉona?” Nʉyo wɨkaaɨla, “Azaʉmpakile ilolo mʉmiho, nʉnene nakalala nɨtungo ili nainaona.”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Apalisayo ang’wɨ ɨkalʉnga, “Mʉntʉ ʉyʉ shanga ʉpumɨɨe kung’wi Itunda, kʉnsoko shanga ʉkee mɨko a lʉhikʉ nʉla kʉsupya.”</para>
  <para style="p" vid="JHN 9:16">Ingɨ nɨang’wɨ ɨkalʉnga, “Mʉnya mɨlandʉ ʉkʉhuma ʉlɨ kitʉma ilɨngasɨɨlyo anga izi?” Ɨkatula kilea ɨenso.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Kʉlʉlo ɨkasʉkɨɨla hangɨ kʉmʉkolya ʉmʉntʉ ʉyʉ naɨmʉpoku, “Yʉ ʉewe ʉkomigwe ɨmiho, mʉntʉ nʉanso nyenyu?”</para>
  <para style="p" vid="JHN 9:17">Nʉng’wenso wɨkaaɨla, “Nʉwanso ingɨ mʉmanga.<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Atongeeli a Ayahudi shanga aɨahʉɨɨe kɨna mʉntʉ nʉanso aɨmʉpoku ɨtungo ɨlɨ wainaona, sʉnga ɨkaitanga aleli akwe. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />Ʉʉgwa nɨanso ɨkaakolya aleli akwe, “Itɨɨ, ʉyʉ yʉyʉ ng’wana wanyu naɨʉtugilwe mʉpoku? Itungo ɨlɨ yatulɨka ʉlɨ ʉkʉona?”<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />Aleli akwe ɨkasʉkɨɨlya, “Kʉine kɨna ʉyʉ ng’wana witʉ, nɨkɨna aɨʉtugilwe mʉpoku. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Ingɨ ʉsese shanga kʉlɨngile ʉkomilye ʉlɨ, hangɨ shanga kʉmʉlɨngile mʉntʉ nʉmʉkomilye. Mʉkolyi ng’wenso, nʉanso ingɨ mʉntʉ mʉkʉlʉ, ʉhumile kikoola ʉng’wenso.” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Aleli akwe aɨatambʉe itɨ kʉnsoko aɨaogopile atongeeli a Ayahudi kʉnsoko aɨigombya kɨna mʉntʉ wɨhi nʉkʉlʉnga kɨna ʉ Yesʉ ng’wenso Kilisito ʉkʉgiligwa kʉkʉlya mʉnyʉmba akʉtankanɨla Ayahudi. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Yɨyo ndogoelyo aleli akwe aɨalʉngile, “Mʉkolyi ng’wenso, nʉanso ingɨ mʉntʉ mʉkʉlʉ.”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Itɨgwa ɨkamitanga hangɨ mʉntʉ nʉwanso naɨ mʉpoku, ɨkamʉɨla, “Mʉkʉlye Itunda. Ʉsese kʉlɨngile kɨna mʉntʉ ʉyʉ mʉnyamilandʉ.”<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Nʉwanso wɨkasʉkɨɨlya, “Angaɨze mʉnyamɨlandʉ ʉnene shangamine. Ingɨ nɨngile kɨntʉ kɨng’wɨ du. Aɨnɨmʉpoku ɨtʉngo ɨlɨ nainaona.”<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />Ʉʉgwa, ikamʉkolya, “Aɨʉkʉtendile ʉlɨ?” Miho ako ɨkatulaona?”<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />Mʉntʉ nʉwanso wɨkaasʉkɨɨlya, “Nakondya kʉmʉtambʉɨla, ʉnyenye shanga mʉhʉɨɨe, nɨkɨ mʉkʉntambʉlya? Itɨɨ, nʉnyenye ga mʉkʉhiya mʉtule amanyisigwa akwe ne?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Ingɨ nɨanso ɨkatula mʉtʉkɨla ɨkalʉnga, “Ʉewe wɨmʉmanyisigwa wakwe, ʉsese kɨamanyisigwa ang’wa Musa. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Ʉsese kʉlɨngile kɨna Itunda aɨitambʉʉye nʉ Musa, shanga kʉlɨngile ʉmʉntʉ ʉyʉ ʉpumɨɨe pɨɨ”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Mʉntʉ nʉwanso wɨkaasʉkɨɨlya, “Ilɨ ingɨ ikani laʉkʉɨlwa, Ʉnyenye shanga mʉlingile kʉpumɨɨe, ingɨ ng’wenso ʉnkomilye miho ane. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Mʉntʉ ʉyʉ naɨmʉpoku wɨkalʉnga, kʉlɨngile kɨna Itunda shanga wɨategeelya anyamɨlandu, ingɨ wɨmʉtegeelya mʉntʉ wɨhi nʉɨmʉkʉlya Itunda nʉkʉmʉkela. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Kʉpumɨɨla ʉng’wandyo nʉwakʉtundwa ʉnkumbigʉlʉ kʉkɨlɨ kʉmija ʉkolɨ mʉntʉ nʉmʉponilye mʉntʉ naɨʉtugilwe mʉpoku waone. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Anga ɨze mʉntʉ ʉyʉ shanga ʉpumɨɨe kʉng’wi Itunda, shanga aza ʉzeehuma kitʉma kɨntʉ kɨhi.”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Nɨanso ɨkamʉsʉkɨɨlya, “Ʉewe ʉtugɨigwe nɨmilandʉ, ʉhumile ʉlɨ kʉʉmanyisa ʉsese?” Ʉʉgwa ɨkamʉzunsa mʉnyʉmba akʉtankanɨla Ayahudi.<verse eid="JHN 9:34" /></para>
  <para style="s">Apalisayo aleng’wa kʉlɨnga ɨtai ang’wa Yesʉ</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Yesʉ naɨwikija kɨna mʉntʉ ʉyo naɨ ʉkomigwe mɨho amʉzunsa mʉnyʉmba akʉtankanɨla Ayahudi, wɨkamʉhanga wɨkamʉkolya, “Itɨɨ, ʉmʉhʉɨɨene Ng’waa Mʉntʉ?”<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />Mʉntʉ nʉwanso wɨkamʉsʉkɨɨlya, “Mʉkʉlʉ, nyenyu nʉwanso nɨhume kʉmʉhʉɨɨla.”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />Yesʉ wɨkamʉɨla, “Wamʉona, ingɨ yʉyʉ nʉkitambʉlya nʉewe itungo ɨlɨ.”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Ʉʉgwa, mʉntʉ nʉwanso wɨkalʉnga, “Isekulu, nahʉɨɨla.” Nʉyo wɨkamʉkʉlya.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Yesʉ wɨkalʉnga, Ʉnene naza kʉʉpɨsɨɨlya ʉnkumbigʉlʉ, ndogoelyo apoku ahume kʉona, nao nɨɨona apele kʉona.”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Apalisayo nɨang’wɨ naɨ yine nʉng’wenso aɨigule nkani nɨyanso, ɨkamʉkolya, “Itɨɨ, nʉsese ga kɨapoku ne?<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />Yesʉ wɨkaasʉkɨɨlya, “Angaɨtule tai mɨapoku, azamʉzetula mɨagila anga magazo, ingɨ ɨtungo ɨlɨ ʉnyenye mʉlʉngile, ‘Ʉsese kʉine,’ kʉitɨ mʉkete magazo.”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">Mpyani a mʉdɨmi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />“Yesʉ wɨkaaɨla, “Kʉmʉɨla ɨtai taai, mʉntʉ wɨhi nʉkingɨla mitando nɨla nkolo nɨshanga ʉkɨɨe mʉ mʉmpita, ingɨ waputɨɨla nʉkingɨɨla nzɨla ngɨza, nʉwanso ingɨ mii hangɨ mʉhegelania maintʉ. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />Ingɨ nʉʉkingɨɨla pa mʉmpita, nʉwanso yʉyo mʉdɨmi nʉwa nkolo. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Mʉmboi nʉwa mʉmpita wɨmʉpandʉɨla, nkolo yija lʉli lakwe nʉyo wɨitanga nkolo yɨhi kʉmina nʉkʉikonkola. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Anga waikonkole kʉnzi wɨitongeela, nkolo nɨnyenso yɨmʉtyata, kʉnsoko yilɨngile ʉlʉli lakwe. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Ingɨ nkolo niyanso shanga yɨmʉtyata mʉgeni, yɨhumile kʉpaalʉka, kʉnsoko shanga yilɨngile lʉli lakwe.”<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />Yesʉ aɨʉatambʉɨɨe mpyani nanso, ingɨ nɨanso shanga ɨkalɨnga naɨʉkʉatambʉɨla.<verse eid="JHN 10:6" /></para>
  <para style="s">Yesʉ yʉyo mʉdɨmi nʉmʉza</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Kʉlʉlo, Yesʉ wɨkaaɨla hangɨ, “Kʉmʉɨla ɨtai kɨna, ʉnene nɨmʉmpita witando nɨla nkolo. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Awo ɨhi naɨatongee ii hangɨ ahegelani, ninkolo shanga yʉkʉmʉlɨnga. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Ʉnene nɨmʉmpita, mʉntʉ nʉkingɨla kʉkɨɨla nene ʉkʉgunɨka, ʉkingɨla nʉkʉpuma, nʉyo ʉkʉlija ʉlʉdɨmo. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Ʉmii wɨza ingɨ kia nʉkʉbʉlaga nʉkʉgazanja. Ʉnene aɨnzile mʉhume kʉtula nʉ ʉpanga nʉwa kalɨ na kalɨ, hangɨ ʉpanga nʉʉkondannɨe.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />“Ʉnene ingɨ mʉdɨmi nʉmʉza. Mʉdɨmi nʉmʉza wɨhʉlya ʉpanga wakwe wagunɨlye nkolo yakwe. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Mʉdɨma nkolo nʉwɨlɨpwa kʉnʉ nkolo shanga yakwe, anga wamɨone mbugi ɨpembilye, wɨileka nkolo nʉkʉhemʉla mɨlugu, ɨmbugi yɨibalansanya nkolo nʉkʉiamba. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Mʉntʉ nʉwanso shanga ʉkee inkolo kʉnsoko nʉwanso ingɨ mʉnya mɨlɨmo ʉdu. <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />Yesʉ wɨkaaɨla, ʉnene ingɨ nɨmʉdɨmi nʉmʉza. Niilɨngile inkolo yane, ninkolo yane inɨngile, <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />anga ʉ Tata nʉnɨngile, nʉnene nɨnʉmʉlɨngile ʉ Tata. Ʉnene nihambile kʉsha kʉnsoko ankolo. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Ʉnene nkete nkolo nzʉya nɨshanga yitando ɨlɨ, nizo ntakiwe niilete pankolɨ. Nizo yʉkija ʉlʉli lane, yʉkʉtula nidale lɨng’wɨ nʉmʉdɨmi ʉng’wɨ.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />Yesʉ wɨkalʉnga, “Nʉndoewe ʉ Tata wane, ingɨ kʉnsoko kʉʉpumya ʉpanga wane nɨhume kʉʉhola hangɨ. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Kʉtilɨ anga mʉntʉ nʉʉkʉnihegelya ʉpanga wane, ʉnene nʉʉpumilye nakanda. Nkete ʉhumi nʉwa kʉʉpumya hangɨ nkete nʉʉhumi nʉwakʉʉhola hangɨ. Itɨ ʉʉgwa Tata aʉndagɨɨye nitʉme.”<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Ayahudi naɨija nkani izi niyang’wa Yesʉ ikatulilea ɨenso. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Nɨang’wɨ ɨkalʉnga, “Ʉyʉ ʉkete hɨng’wɨ, hangi wahaile. Nɨkɨ mʉkʉmʉtegeelya?”<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Nɨang’wɨ ɨkalʉnga, “Nkani izi shanga yakʉtambʉla nʉmʉntʉ nʉkete ʉhɨng’wɨ. Itɨgwa, ʉhɨng’wɨ ʉhumilene kʉmʉkomya miho amʉpoku?”<verse eid="JHN 10:21" /></para>
  <para style="s">Ayahudi akʉmʉhita ʉ Yesʉ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Matungo nanso kʉ Yelusalemu aɨlɨkolɨ iloeelya kʉnsoko akelya hangi Nyʉmba ang’wi Itunda kʉnsoko ang’wi Itunda. Itungo nɨlanso aɨmpepo amalila. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />Yesʉ nʉyo aɨʉkʉgenda pa Nyʉmba ang’wi Itunda mʉkɨanda kang’wa Solomoni. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Ayahudi ɨkamʉpilimɨlya, ɨkamʉkolya, “Ʉkʉʉɨka mʉkɨsɨgɨɨla nʉkikolya mʉnkolo yitʉ kʉpikɨɨla nalɨ? Angaɨze ʉewe wɨ Kilisito, kʉtambʉɨle kʉlɨnge.”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Yesʉ wɨkaasʉkɨɨlya, “Nakondya kʉmʉɨla, ingɨ ʉnyenye shanga mʉhʉɨɨe. Mɨlɨmo nɨkitʉma kʉʉhumi wang’wa Tata wane yayo akʉntambʉɨlya. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />Ingɨ ʉnyenye shanga mʉnihʉɨɨe kʉnsoko shanga mɨnkolo yane. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Anga inkolo nɨyija ʉlʉli lamʉdɨmi wao, nɨantʉ ane anɨngile nɨkʉtambʉla. nʉnene anɨngile, nɨenso akʉtula amanyisigwa ane. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Ʉnene nɨipeza ʉpanga nʉwamahikʉ ɨhi nɨmagila mpelo, shanga akʉlimansɨɨla kwee hangɨ kʉtilɨ anga mʉntʉ wɨhi nʉhumile kʉaheja mʉmɨkono ane. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Tata wane nʉmpee ɨantʉ awa ingɨ mʉkʉlʉ kʉkɨla ɨhi, hangɨ kʉtilɨ mʉntʉ nʉhumile kʉaheja mʉmɨkono ane. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Ʉnene nʉ Tata wane kɨpalʉng’wɨ.”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Naɨwatambʉla itɨ, papo Ayahudi ɨkahoeela hangɨ magwe amʉkʉe. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />Ingɨ Yesʉ wɨkaaɨla, “Nʉmʉlagɨɨe ilɨngasɨɨlyo idʉ kʉpuma kʉng’wa Tata. Kɨlɨngasɨɨlyo kɨgwa mʉizi nɨntendile nɨmʉtakile kʉnkʉa magwe?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />Ayahudi ɨkamʉsʉkɨɨlya, “Shanga kʉʉkʉkʉa magwe kʉnsoko amakani nɨmaza nʉwitʉmile, ingɨ kʉnsoko akʉmʉtʉkɨla Itunda, kʉnsoko ʉewe wɨ mʉntʉ ʉdu ʉkitendisa kɨna wɨhangaa Itunda.”<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Yesʉ wɨkaasʉkɨɨlya, “Itɨɨ, shanga yɨandɨkilwene Mʉʉandɨkwa kɨna, ‘Ʉnene ntambʉe, ʉnyenye mɨmpyanigwe ni Itunda?’ <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Anga ɨze awo Itunda naɨapewe ʉlʉkani lakwe aɨʉitangile impyanigwe nʉng’wenso, itɨgwa Ʉandɨkwa wang’wi Itunda watai mahikʉ ɨhi. <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />Itɨɨ, mʉhumileʉlɨ kʉlʉnga kɨna ʉkʉtʉkɨlana, ʉyo Tata nʉmʉpumilye kʉ mʉlɨmo wakwe, nʉkʉmʉtʉma mʉʉnkumbigʉlʉ, kʉnsoko nʉngile, Ʉnene nɨ Ng’wana wang’wi Itunda?” <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Anga ize shanga kitʉma mɨlɨmo ang’wa Tata, leki kʉnihʉɨɨli. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Ingɨ angaitule nitʉmaa mɨlɨmo ang’wa Tata, nɨitɨga shanga mʉnihʉɨɨe, hʉɨɨligwa ɨmɨlɨmo nanso, mʉhume kʉlɨnga nʉkʉmanya kɨna ʉ Tata ʉkolɨ mʉng’wane, nʉnene nkolɨ mʉng’wakwe.”<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />Ɨkagema hangɨ kʉmʉamba, Yesʉ wɨkaatiga mʉmɨkono.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />Yesʉ wɨkalongola hangɨ kitʉmbɨ la mongo nʉwa Yolidani, apo nʉ Yohana aɨʉbadisɨɨye ɨantʉ, wɨkishiɨ kʉko. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Antʉ ɨdʉ ɨkamʉhanga ɨkalʉnga, “Yohana shanga aɨwitʉmile kɨlɨngasɨɨlyo kɨhi, “Ingɨ ayo ɨhi Yohana naɨʉtambʉe kʉ mʉntʉ ʉyʉ ingɨ tai lʉkʉlʉ.” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Antʉ ɨdʉ kʉng’wanso ɨkamʉhʉɨɨla ʉ Yesʉ.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">Nsha ang’wa Lazalo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Aɨʉkolɨ mʉntʉ ʉng’wɨ, witangwaa Lazalo mʉnya kʉ Betania, nʉyo aɨmʉlwae. Aluna akwe a Malia nʉ Malita. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />Malia ʉyʉ, yʉyo naɨʉmʉpakile Isekʉlʉ makuta nɨnyunkɨɨla naʉgʉli ʉkʉlʉ nʉkʉmɨpyagʉla mɨgʉlʉ kʉnsingi yakwe. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Itɨgwa, aluna nɨanso nɨasʉngʉ ɨkalagɨɨlya lʉkani ʉlʉ kʉng’wa Yesʉ, “Isekʉlʉ, mʉhʉmba mɨako nʉmʉloilwe ingɨ mʉlwae.”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Yesʉ naɨwija ɨtɨ, wɨkalʉnga, “Lazalo shanga ʉkʉsha kʉʉlwae ʉwʉ, ʉpumɨe kʉnsoko Itunda wahume kʉkʉligwa. ingɨ Ng’wana wang’wi Itunda wakʉligwe, kʉkɨɨla ʉlwae ʉwʉ.<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />Yesʉ aɨianzile nɨa Malita nʉ Malia nʉ Lazalo. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Ingɨ Yesʉ naɨwija kɨna Lazalo ʉkʉlwala, wɨkikiɨ kʉko naɨʉkolɨ kʉmahikʉ abɨɨlɨ. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />Naɨakɨla mahikʉ nanso, Yesʉ wɨkaaɨla amanyisigwa akwe, “Kwɨndi hangɨ kʉ Yʉdea.”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />Amanyisigwa akwe ɨkamʉɨla, “Mʉmanyisi, Itungo ikupɨ nɨlakɨla Ayahudi aɨakʉhiya kʉʉkʉa magwe ʉshe, nʉewe ʉkʉhiya kʉtulya kʉko hangi?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />Yesʉ wɨkasʉkɨɨlya, “Itɨɨ, ʉng’ʉng’wɨ ingɨ ʉkete saa ikʉmi na abɨɨlɨ kʉ lʉhikʉ lʉng’wɨ? Ingɨ, antʉ anga agende ng’ʉng’wɨ shanga akʉkumpa kʉnsoko aine nzelya aʉnkumbigʉlʉ ʉwʉ. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Ingi antʉ awo nɨɨgenda ʉtikʉ ɨkumpa kʉnsoko agila anga nzelya nɨkʉaaɨlya kʉona.” <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />Yesʉ naɨwakondya kʉtambʉla nkani niyanso, wɨkaaɨla, “Mʉhʉmba mɨitʉ Lazalo ʉlae tʉlo, ingɨ ʉnene ninzʉ mʉʉsha.”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Amanyisigwa akwe ɨkamʉɨla, “Isekʉlʉ, anga ɨtule ʉlae tʉlo ʉkʉʉka ʉdu.”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />Nɨitɨga Yesʉ aɨʉkʉtambʉla ɨnsha angwa Lazalo, amanyisigwa akwe aɨasɨgile kɨna aɨʉkʉligitɨlya kʉlala tʉlo ʉdu. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />Ʉʉgwa, Yesʉ wɨkaakumʉɨla, “Lazalo wakuza, <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />nɨitɨga ndoilwe kʉnsoko azanɨkʉtilɨ kʉng’wanso lazalo naza ʉkʉsha, mʉhume kʉhʉɨɨla. Aligwa kwɨni kʉng’wakwe.”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Tomaso nʉwitangwa Itʉtɨ wɨkaaɨla amanyisigwa aʉya, “Nʉsese ga kwɨni kende kʉshe palʉng’wɨ ni Isekʉlʉ.”<verse eid="JHN 11:16" /></para>
  <para style="s">Yesʉ yʉyo wiʉki nʉ ʉpanga</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Yesʉ naɨwapika kʉng’wanso wɨkahanga mʉimba wang’wa Lazalo wapishaa mahikʉ annɨ mʉkɨbɨɨla kʉpuma mʉwaɨkɨlwa. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Kɨsalɨ nɨka Betania aɨlʉgendo la maɨli ibɨɨlɨ kʉpuma kʉ Yelusalemu. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />Ayahudi ɨdʉ aɨapika kʉahongeelye a Malita nʉ Malia naɨashɨɨwe nʉ mʉluna wao.<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />Itɨgwa, Malita naɨwija kɨna Yesʉ ʉpembilye, wɨkalongola wamʉsɨngɨɨlye. Malia nʉwanso wɨkasiga kito. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />Malita wɨkamʉɨla Yesʉ, “Isekʉlʉ anga azaɨze ʉkolɨ papa, mʉluna wane shanga aza ʉzesha. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Ingɨ nɨngile kɨna nitungo ɨlɨ kɨhi nʉʉkʉmʉlompa Itunda, ʉkʉʉpa.”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Yesʉ wɨkamʉɨla, “Mʉluna wako ʉkiʉka.”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />Malita wɨkamʉsʉkɨɨlya, “Nɨngile kɨna ʉkiʉkigwa ɨtungo nɨla ʉʉkigwi nʉwa antʉ, lʉhikʉ nʉla mpelo.”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Yesʉ wɨkamʉɨla, Yʉ nene nɨwiʉki nʉ ʉpanga. Mʉntʉ wɨhi nʉnihʉɨɨe ʉnene anga washe, ʉkʉtula mʉpanga, <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />nʉ mʉntʉ wɨhi nʉwishiɨ nʉkʉnihʉɨɨla ʉnene shanga ʉkʉsha lʉkʉlʉ. Itɨɨ, ʉlʉhʉɨɨene ʉlʉ?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Malita wɨkamʉɨla, “Ee Isekʉlʉ, ʉnene nihʉɨɨe kɨna yʉ wewe Kilisito, Ng’wana wang’wi Itunda ʉyo nʉpembilye mʉ ʉnkumbigʉlʉ.”<verse eid="JHN 11:27" /></para>
  <para style="s">Yesʉ ʉkʉmʉlɨɨla ʉ Lazalo</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Malita naɨwakondya kʉtambʉla nanso, wɨkenda wɨkamitanga Malia mʉluna wakwe kɨmpelo, wɨkamʉɨla, “Mʉmanyisi ʉkolɨ papa, ʉkʉitanga.” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Malia nʉyo naɨwija itɨ, wɨkakaya kʉʉka, wɨkalongola kʉng’wa Yesʉ. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Yesʉ aɨwakɨlɨ kingɨla mʉkɨsalɨ, aɨʉkoli apo naɨʉsɨngɨigwe nʉ Malita. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />Ayahudi awo naɨakolɨ kito palʉng’wɨ nʉ Malia naɨakʉmʉhongeelya naɨamʉona ʉkaɨye kʉʉka nʉ kʉpuma kʉnzi, ikamʉtyata. Aɨasɨgile kɨna winzʉlɨla pa kɨbɨɨla.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Malia naɨwapika apo naɨʉkolɨ ʉ Yesʉ, wɨkatugama, wɨkamʉɨla, “Isekʉlʉ, anga azaɨze ʉkolɨ papa, mʉluna wane shanga aza ʉzesha.”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Yesʉ naɨwamʉona Malia ʉkʉlɨla, nɨ Ayahudi awo naɨazanilye nʉ Malia nɨenso akʉlɨla, wɨkahʉsha, wɨkaalɨka mʉnkolo akwe. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Sʉnga wɨkamʉkolya, “Mʉmʉɨkile pɨɨ?”</para>
  <para style="p" vid="JHN 11:34">Ɨkamʉɨla, “Isekʉlʉ, nzʉ ʉone.”<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />Yesʉ wɨkalɨla liholi. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />Papogwa Ayahudi ɨkalʉnga, “Kolwi naɨʉmʉloilwe ʉ Lazalo.”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Ingɨ nɨang’wɨ ɨkalʉnga, “Itɨɨ, ʉyʉ naɨʉmʉkomilye miho mʉpoku ʉyo, shanga aza ʉzehumane kʉmʉkomya ʉ Lazalo waleke kʉsha?”<verse eid="JHN 11:37" /></para>
  <para style="s">Yesʉ ʉkʉmiʉsha ʉ Lazalo</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Ɨtɨgwa, Yesʉ wazeʉhʉkilye mʉnkolo akwe, wɨkapika pakibɨɨla. Kɨbɨɨla nɨkanso ingɨ aɨikulungu, hangɨ aɨlikiɨwe igwe. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Yesʉ wɨkalʉnga, “Lɨheji igwe nɨlanso.”</para>
  <para style="p" vid="JHN 11:39">Malita mʉluna wamʉshi, wɨkamʉɨla, “Isekʉlʉ, ingɨ ɨtungo ɨlɨ waina nyunka, nʉwa ɨkɨlwa lelo mahikʉ annɨ.”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Yesʉ wɨkamʉɨla Malita, “Itɨɨ, shanga aɨnʉkʉɨɨene kɨna anga ʉhʉɨɨle ʉkʉona ʉkʉlʉ wang’wi Itunda?” <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />Kʉlʉlo, ɨkalɨheja igwe nɨlanso. Yesʉ wɨkalangamɨla migʉlya kigʉlʉ, wɨkalompa, wɨkalʉnga, “Tata nʉkʉsongeeye kʉnsoko ʉewe wanija. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Nɨngile kɨna mahikʉ ɨhi wɨnija. Ingɨ ntambʉe ayaitɨ kʉnsoko aantʉ awa nɨakolɨ apaitɨ ahume kʉhʉɨɨla kɨna yʉ wewe ʉntʉmile.” <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />Naɨwakondya kʉtambʉla nanso, wɨkitʉnta, wɨkamitanga, “Lazalo! Nzʉʉ kʉnʉ kʉnzi,” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Ʉyʉ naɨʉkule wɨkapuma kʉnzi, kʉnʉ ʉtungilwe shanda mʉmɨgʉlʉ nɨmɨkono, nʉ ʉsʉ wakwe ʉkaze ʉkumbilwe. Yesʉ wɨkaaɨla, “Mʉtungʉɨli mʉleki walongole.”<verse eid="JHN 11:44" /></para>
  <para style="s">Atongeeli Ayahudi akʉsɨga kʉmʉbʉlaga Yesʉ</para>
  <para style="r">
    <ref loc="MAT 26:1-5">Matayo 26:1-5</ref>; <ref loc="MRK 14:1-2">Maliko 14:1-2</ref>; <ref loc="LUK 22:1-2">Lʉka 22:1-2</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Itɨgwa, Ayahudi ɨdʉ naɨazile nʉ Malia naɨaona ikani nɨlanso Yesʉ naɨwitʉmile, ɨkamʉhʉɨɨla. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Ingɨ nɨang’wiɨkalongola kʉ Apalisayo kʉatambʉɨla makani nɨlanso Yesʉ naɨ witʉmile. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Kʉlʉlo Apolyi nɨakʉlʉ nɨ Apalisayo ɨkikiɨ ianza nikʉlʉ, ɨkalʉnga, “Kʉtende ʉlɨgwa? Mʉntʉ ʉyʉ ʉkitʉma ilɨngasɨɨlyo yɨdʉ. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Anga kʉmʉleke walongoleke kitʉma ilɨngasɨɨlyo izi, antʉ ɨhi akʉmʉhʉɨɨla, Atemi a Kɨlumi nawo azile nʉkʉʉhegelya ʉkʉlʉ witʉ Mʉnyʉmba ang’wi Itunda nɨhɨɨ itʉ.”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Mʉpolyi ʉng’wɨao witangwa Kayapa, naɨza mʉpolyi nʉ mʉkʉlʉ nʉwanso, wɨkaaɨla, “Ʉnyenye shanga mʉlɨngile anga kɨntʉ. <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Itɨɨ, shanga mʉine kɨna bahu mʉntʉ ʉng’wɨ washe kʉnsoko aantʉ, kʉkɨla ihɨɨ ɨhi ɨlimansɨɨligwe?” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />Kayapa shanga aɨʉtambʉe itɨ nakanda, ingɨ kʉnsoko ng’waka nʉwanso aɨmʉpolyi nʉ mʉkʉlʉ, aɨʉlotigwe kɨna ʉ Yesʉ ʉkʉsha kʉnsoko Ayahudi. <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />Hangɨ shanga ʉkʉsha kʉnsoko a Ayahudi ʉdu, ingɨ wahume kilingɨɨla ana ang’wi Itunda naɨabalansanɨle.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />Itɨgwa kʉpuma lʉhikʉ lʉlo atongeeli a Ayahudi ɨkandya kʉpenza nzɨla akʉmʉbʉlaga Yesʉ. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />Kʉlʉlo, Yesʉ wɨkapela kʉgenda kɨhenga mʉ Ayahudi, ingɨ wɨkapuma pang’wanso, wɨkenda nkɨka apakupɨ nʉwɨɨ, mʉkɨsalɨ nɨkitangwa Epulaimu. Wakishiɨ kʉko palʉng’wɨ nɨamanyisigwa akwe.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Aɨlahumbeela iloelya kʉ Ayahudi nɨlitangwa Pasaka, antʉ ɨdʉ ɨkapuma mʉisalɨ ɨkalongola kʉ Yelusalemu ahume kielya agombeke kʉmʉkʉlya Itunda. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Itɨgwa antʉ ɨkatula mʉduma Yesʉ. Nienso naɨ ilʉnda palʉng’wɨ pa Nyʉmba ang’wi Itunda, ɨkatulikolya, “Itɨɨ, mʉntʉ ʉyʉ shanga ʉzilene kiloeelya?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Apolyi nɨakʉlʉ nɨa Palisayo aɨalangɨɨye kɨna mʉntʉ wɨhi nʉlɨngile ʉ Yesʉ kʉʉkolɨ waatambʉɨle ahume kʉmʉamba.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">Malia ʉkʉmʉpaka ʉ Yesʉ makuta nɨnyunkɨɨla</para>
  <para style="r">
    <ref loc="MAT 26:6-13">Matayo 26:6-13</ref>; <ref loc="MRK 14:3-9">Maliko 14:3-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Mahikʉ mʉtandatʉ naɨlɨkɨlɨ kʉpika iloeelya nɨla Pasaka, Yesʉ wɨkenda kʉ Besania kʉng’wa Lazalo ʉyo naɨʉmɨʉkilye. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Kʉng’wanso ɨkamʉnonelelya ndya niya mpɨndɨ, Malita nʉyo wakaze anoneelya, Lazalo nʉyo aɨwikalananilye nʉ Yesʉ paʉlyi. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Sʉnga, Malia wɨkahola nsʉpa amakuta nɨɨnyunkɨɨla na nalido nɨmaza nɨgʉlwa ʉgʉli ʉkʉlʉ, wɨkamʉpaka ʉ Yesʉ mʉmɨgʉlʉ nʉkʉpagʉla kʉnsingi yakwe. Nyʉmba ɨhi ɨkanyunkɨɨla ʉza nʉwa manyunkɨɨlo. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />Papogwa ʉ Yʉda Isikalioti, ʉng’wɨ mʉ awo nikʉmi na abɨɨlɨ ʉyo nʉʉzɨɨza mʉsuɨpa ʉ Yesʉ, wɨkalʉnga, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“Nɨkɨ manyunkɨɨlyo nanso ahita kʉgʉligwa kʉmpia milioni ing’wɨ nɨ lakɨ itaano ni sabini, aza apegwe ahimbɨ?” <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Yʉda aɨʉtambʉe itɨ shanga kɨna aɨza ʉakee ahimbɨ, ingɨ kʉnsoko aɨza mii, aɨwɨambɨɨla mbogoshi a kɨʉto, nkʉa yɨdʉ aɨwia mpia nɨɨkolɨ mʉkɨʉto.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Ingɨ Yesʉ wɨkalʉnga, “Leki kʉmʉnyomi mʉsʉngʉ ʉyʉ. Aɨʉgʉile makʉta aya wahume kʉmaɨka kʉnsoko alʉhikʉ lane nɨnzɨɨzaɨkwa. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Ahimbɨ mɨzamine nɨenso mahikʉ ɨhi, ingɨ shanga mʉkʉtula kine nʉnene mahikʉ ɨhi.”<verse eid="JHN 12:8" /></para>
  <para style="s">Ayahudi akʉhiya kʉmʉbʉlaga Lazalo</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Mɨlʉndo ʉkʉlʉ nʉwa Ayahudi naɨija kɨna Yesʉ aɨkoli kʉ Betania, ɨkapika kʉng’wanso shanga kʉmʉona Yesʉ ʉdu, ingɨ ahume kʉmʉona Lazalo nʉ Yesʉ aɨʉmiʉkilye. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Kʉlʉlo apolyi nɨakʉlʉ ɨkigombya isʉɨ nɨla kʉmʉbʉlaga nʉ Lazalo ga. <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />Kʉnsoko Ayahudi ɨdʉ aɨapelaa kʉategeelya ɨkamʉhʉɨɨla ʉ Yesʉ.<verse eid="JHN 12:11" /></para>
  <para style="s">Yesʉ ʉkingɨla kʉ Yelusalemu kʉ ngiligili</para>
  <para style="r">
    <ref loc="MAT 21:1-11">Matayo 21:1-11</ref>; <ref loc="MRK 11:1-11">Maliko 11:1-11</ref>; <ref loc="LUK 19:28-40">Lʉka 19:28-40</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Lʉhikʉ naɨlʉtyatile milʉndo nʉwa antʉ naɨazile miloeelya ɨkija kɨna Yesʉ ʉkolɨ mʉnzɨla ʉpembilye kʉ Yelusalemu. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Itɨgwa, ɨkabuna matambɨ amɨmbɨlɨlɨ, ɨkapuma kʉmʉsɨngɨɨlya, ɨkitʉnta ɨkalʉnga,</para>
  <para style="pi" vid="JHN 12:13">“Kʉmʉkʉlye Isekʉlʉ! Wakembetwe ʉyʉ nʉpembilye kʉlina lang’wi Isekʉlʉ.</para>
  <para style="pi" vid="JHN 12:13">Wakembetwe Mʉtemi nʉwa Aisilaeli.”<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />Yesʉ wɨkamʉlija ng’waa ndogwe ʉng’wɨ, wɨkapakɨla kʉmʉgongo wakwe, anga Ʉandɨkwa nʉʉlɨɨye,<verse eid="JHN 12:14" /></para>
  <para style="pi">
    <verse number="15" style="v" sid="JHN 12:15" />“Ʉnyenye anya kʉ Yelusalemu leki kogopi!</para>
  <para style="q1" vid="JHN 12:15">Kolwi, Mʉtemi wanyu ʉpembilye,</para>
  <para style="q2" vid="JHN 12:15">Ʉpakɨe ng’waa ndogwe.”<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Ʉng’wandyo amanyisigwa akwe shanga aɨalɨngile makani nanso, ingɨ Yesʉ naɨ wakʉligwa, papogwa ɨkakɨmbʉka kɨna makani nanso andɨkilwe kʉnsoko akwe, hangɨ antʉ amʉtendee ng’wenso.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Iumbɨ laantʉ naɨ ɨpalʉng’wɨ nʉ Yesʉ itungo naɨʉmitangile ʉ Lazalo kʉpuma mʉkɨbɨɨla, wɨkamiʉsha, aɨalongolekile kʉganʉla naɨaine. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Kʉlʉlo mɨlʉndo nʉwanso nʉwa antʉ ɨkamʉsɨngɨɨlya, kʉnsoko ɨhi aɨigule kɨna ʉ Yesʉ aɨʉtendile kɨlɨngasɨɨlyo nɨkanso. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Itɨgwa, Apalisayo ɨkitambʉɨla, “Maonagwa? Shanga kʉhumile kʉtenda kɨntʉ kɨhi. Kolwi, antʉ ɨhi mʉʉnkumbigʉlʉ amʉtyata.”<verse eid="JHN 12:19" /></para>
  <para style="s">Yesʉ ʉkʉmɨlota ɨnsha nʉ wiʉki wakwe</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Aɨamolɨ Ayʉnanɨ akeehʉ mʉantʉ naɨapikile pa Yelusalemu kʉmʉkʉlya Itunda matungo iloeelya nɨlanso. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Ayunani nɨanso ɨkalongola kʉng’wa Pilipo, mʉnya kʉ Betisaɨda nakʉ Galilaya, ɨkamʉlompa azelʉnga, “Mʉkʉlʉ, kʉtakile kʉmʉone ʉ Yesʉ.”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />Pilipo wɨkalongola, wɨkamʉtambʉɨla Endelea, nawo ɨhi mʉʉbɨlɨ ɨkamʉɨla ʉ Yesʉ. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />Yesʉ wɨkaasʉkɨlya, “Itungo nɨla kʉkʉligwa ʉ Ng’waa Mʉntʉ lapika. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Kʉmʉɨli ɨtai, ɨnseke ailo anga ɨhite kʉgwa mihalʉ ɨshe nʉkʉhelʉka, ɨsiga kʉtula nseke yɨyo ʉdu. Anga ɨhelʉke nʉkʉkinda ingɨ ɨpaa nseke yɨdʉ. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Antʉ awo nɨalʉloilwe ʉlikalo lao, ʉkʉlʉlimɨlya, nawo nɨɨaʉbɨpɨwe ʉlikalo lao mʉʉnkumbigʉlʉ ʉwʉ, akʉlʉguna kʉpikɨɨla ʉpanga nʉwa kalɨ na kalɨ. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Mʉntʉ wɨhi kʉnintʉmɨla ʉtakɨwe wantyate, nɨkʉtula nkolɨ ʉnene nʉ mitʉmi wane ʉkʉtula ʉkolɨ papo. Hangɨ mʉntʉ wɨhi nʉkʉnintʉmɨla ʉ Tata wane ʉkʉmʉkʉlya.<verse eid="JHN 12:26" /></para>
  <para style="s">Yesʉ ʉkʉlompa kʉnsoko ansha akwe</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />Yesʉ wɨkalongoleka kʉtambʉla, wɨkalʉnga, “Nahʉsha ʉbɨ mʉnkolo ane, nʉnge ʉlɨgwa? Itɨɨ, nʉnge, ‘Tata, ngune mpume mʉlwago ʉlʉ?’ A! a! ingɨ aɨnzile nshe kʉnsoko aantʉ angɨɨza. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Tata, lɨkʉlye ɨlina lako.”</para>
  <para style="p" vid="JHN 12:28">Papo lʉli lɨkatambʉla kʉpuma kigʉlʉ, “Nalɨkʉlya, kʉlikʉlya hangɨ.”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />Milʉndo waantʉ nai ɨmɨkile pang’wanso aɨigule ʉlʉli nʉlanso, nɨang’wɨ ɨkalʉnga, “Ingɨ mʉgugumo wa lʉpɨto ʉdu.” Ingɨ aʉya ɨkalʉnga, ‘Malaɨka ʉligitilye nʉng’wenso.”<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Yesʉ wɨkaaɨla, “Ʉlʉli ʉlʉ ligee kʉnsoko anyu, shanga kʉnsoko ane. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Itungo ɨlɨ antʉ ʉnkumbigʉlʉ kʉpɨsɨɨligwa, nɨitɨga mʉtemi nʉwa ʉnkumbigʉlʉ ʉwʉ ʉkʉhegigwa mʉʉkʉlʉ wakwe. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Ʉnene anga ntʉmbɨkwe mikota, kʉaluta antʉ ɨhi aze kʉng’wane.” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Yesʉ aɨʉtambʉe itɨ kʉlagɨɨla nshɨle nʉzɨzashɨla.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Itɨgwa, milʉndo nʉwa antʉ ɨkamʉsʉkɨɨlya, “Kigulye kʉpuma mʉmalagɨɨlyo ang’wi Musa kina ‘Kilisito nʉhoilwe ni Itunda ʉkishiɨ kalɨ na kalɨ.’ Kʉnɨkɨ ʉewe ʉkʉʉɨla kɨna, “Ng’waa Mʉntʉ ʉtakɨwe kʉtʉmbɨkwa mʉ mʉsalaba? Ng’waa Mʉntʉ ʉyʉ nyenyugwa?”<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Papo ʉ Yesʉ wɨkaaɨla, “Lɨkɨlɨ itungo ɨniino nzelya ikolɨ palʉng’wɨ nʉnyenye. Longoleki kʉgenda mʉnzelya nanso mʉleke kʉhangwa nɨkiti, kʉnsoko nɨɨgenda mʉkiti shanga alɨngile kʉahongile. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Itɨgwa, nɨmʉkɨlɨ mʉkete nzelya nanso mɨhʉɨɨli ɨnzelya nanso mʉtule mɨana anzelya nanso.”</para>
  <para style="s" vid="JHN 12:36">Ayahudi akʉhita kʉmʉhʉɨɨla ʉ Yesʉ</para>
  <para style="p" vid="JHN 12:36">Naɨ wakondya kʉtambʉla itɨ, Yesʉ wɨkahega, wɨkendipiha.<verse eid="JHN 12:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />Palʉng’wɨ nɨkɨna Yesʉ aɨwitʉmile ilɨngasɨɨlyo yɨhi ntongeelao, nɨanso shanga ɨkamʉhʉɨɨla. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Itɨgwa nkani naɨʉtambʉe mʉmanga ʉ Isaya ɨkapikɨɨla.</para>
  <para style="pi" vid="JHN 12:38">“Isekʉlʉ, nyenyu naɨ ʉhʉɨɨe ʉlʉkani litʉ?</para>
  <para style="q2" vid="JHN 12:38">Nʉʉhumi nʉwa kʉguna nʉang’wi Isekʉlʉ wigee kʉng’wa nyenyu?”<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />Kʉlʉlo shanga ɨkahʉɨɨla, kʉnsoko ʉ Isaya aɨʉtambʉe nɨpaʉya.<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“Itunda waapokulya mihoao,</para>
  <para style="q2" vid="JHN 12:40">nʉkʉitenda nkolo yao yɨtule nkaku,</para>
  <para style="q1" vid="JHN 12:40">ingɨ aleng’we kʉona kʉ mihoao,</para>
  <para style="q2" vid="JHN 12:40">nʉkʉlɨnga mʉ nkolo yao,</para>
  <para style="q2" vid="JHN 12:40">aleke kʉnihʉɨɨla,</para>
  <para style="q2" vid="JHN 12:40">nʉnene nɨagune.<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />Isaya aɨʉtambʉe nkani izɨ kʉnsoko aɨwaona ikʉlyo lang’wi Yesʉ, wɨkatambʉla mpola yakwe.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Nɨitɨ ga, atongeeli ɨdʉ nɨa Ayahudi ɨkamʉhʉɨɨla ʉ Yesʉ. Ingɨ kʉnsoko a Apalisayo, shanga ɨkakumʉʉla mʉantʉ aleke kʉkong’wa mʉnyʉmba nɨɨtankanɨla Ayahudi. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />Aɨɨlowa kʉkʉligwa nɨantʉ kʉkɨla kʉkʉligwa ni Itunda.<verse eid="JHN 12:43" /></para>
  <para style="s">Yesʉ aɨʉzile kʉguna antʉ</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Sʉnga Yesʉ wɨkitʉnta wɨkalʉnga, “Mʉntʉ wɨhi nʉnihʉɨɨe shanga ʉnihʉɨɨe ʉnene du, ingɨ ʉmʉhʉɨɨe ʉyo nʉntʉmile. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Mʉntʉ nʉmine ʉnene ʉmʉine ʉyo nʉntʉmile. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Ʉnene nzile antʉ alɨnge nzelya nɨpembeeye mʉtai ang’wi Itunda, ingɨ antʉ ɨhi nɨanihʉɨɨe aleke kishiɨ mʉkiti kʉnsoko akʉhita kʉlɨnga ɨtai ang’wi Itunda. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />Mʉntʉ nʉʉkija inkani yane nʉkʉhita kʉikela, ʉnene shanga kʉmʉpɨsɨɨlya, kʉnsoko shanga aɨnzile kʉapɨsɨɨlya antʉ aʉnkumbigʉlʉ ingɨ kʉaguna. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Mʉntʉ wɨhi nʉɨnihitaa ʉnene nʉkʉhita kʉsɨngɨɨlya nkani yane ʉkete nʉwa kʉmʉpɨsɨɨlya. Lʉkani lane nɨtambʉe lʉlo lʉzɨɨza mʉpɨsɨɨlya lʉhikʉ nʉla mpelo! <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Kʉnsoko ʉnene shanga ntambʉe kʉʉhumi wane, ingɨ Tata naɨʉntʉmile yʉyo ʉndagɨɨye ntambʉla ntʉni hangɨ nʉnge ʉlɨ. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Nʉnene nɨngile kɨna ilagɨɨlyo lakwe ingɨ ʉpanga nʉwa kalɨ na kalɨ. Kʉlʉlo, lɨhi nɨkʉtambʉla kɨko ʉ Tata ʉndagɨɨye nɨkɨtambʉle.<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">Yesʉ ʉkʉakalalya mɨgʉlʉ amanyisigwa akwe</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Naɨlahʉmbeela iloelya nɨla Pasaka. Yesʉ aɨʉlɨngɨle kɨna itungo lakwe nɨlakʉhega mʉʉnkumbigʉlʉ nʉkʉlongola kʉng’wihe lapika. Mtungo ɨhi aɨʉalowa antʉ akwe nɨakolɨ mihɨɨ, hangɨ aɨʉaloilwe ikɨlo.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />Itɨgwa, Yesʉ niamanyisigwa akwe naɨakʉlya ndya niya mpɨndɨ. Shetani aɨwamʉpembeselya ʉ Yʉda Isikalioti ng’wana wang’wa Simoni, wamʉsuɨpa Yesʉ. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Yesʉ wazeʉlɨngile kɨna Ihe ʉmʉpee maintʉ ɨhi, nɨkɨna ʉpembeeye kʉng’wi Itunda hangɨ ʉkʉtulya kʉng’wi Itunda. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />Ʉʉgwa, wɨkahega paɨakʉlya, wɨkaɨka kʉmpelo itugalo lakwe nɨla migʉlya, wɨkipela ileza. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Sʉnga wɨkaɨkɨla mazɨ mʉlukulu, wɨkatula akalalya mɨgʉlʉ amanyisigwa akwe nʉkʉapyagʉla mɨgʉlʉao kileza nɨlanso naɨwɨtungile. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />Sʉnga, wɨkamʉpikɨɨla ʉ Simon Petelo, Petelo wɨkalʉnga, “Isekʉlʉ, itɨɨ, ʉewe ʉkʉnkalalya nʉnene migʉlʉ?” <verse eid="JHN 13:6" /><verse number="7" style="v" sid="JHN 13:7" />Yesʉ wɨkamʉsʉkɨɨlya, “Itungo ili shanga ʉlɨngile nʉʉkitʉma ingɨ ʉkʉlɨnga panyambele.” <verse eid="JHN 13:7" /><verse number="8" style="v" sid="JHN 13:8" />Petelo wɨkamʉɨla, “Itʉnʉ ʉewe shanga ʉkʉnkalalya ʉnene ɨmɨgʉlʉ.” Yesʉ wɨkamʉsʉkɨɨlya, “Anga nihite kʉʉkalalya ʉewe migʉlʉ shanga ʉkʉtula wɨpalʉng’wɨ nʉnene hangɨ.” <verse eid="JHN 13:8" /><verse number="9" style="v" sid="JHN 13:9" />Papo Simon Petelo wɨkamʉɨla, “Isekʉlʉ, leka kʉnkalalya ɨmɨgʉlʉ du, ingɨ nkalalye nɨmɨkono nitwe ga.” <verse eid="JHN 13:9" /><verse number="10" style="v" sid="JHN 13:10" />Yesʉ wɨkamʉɨla, “Mʉntʉ nʉwogile shanga ʉtakɨwe koga hangɨ, ingɨ ʉtakɨwe kʉkalala ɨmigʉlʉ du, kʉnsoko mʉɨlɨ wakwe wɨhi waile welʉ. Ʉnyeye maile mɨelʉ, ingɨ shanga mɨhi.” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Yesʉ aɨʉmʉlɨngile ʉyo nʉʉzemʉsuɨpa, yɨyo ndogoelyo wɨkalʉnga, “Ʉnyenye maile mɨelʉ, ingɨ shanga mɨhi.” <verse eid="JHN 13:11" /><verse number="12" style="v" sid="JHN 13:12" />Naɨwakondya kʉakalalya mɨgʉlʉ, wɨkatugala hangɨ itugalo lakwe, wɨkasʉka apo paʉlyi naɨwikiɨ, wɨkaakolya,“Itɨɨ, malɨngane nɨnɨmʉtendee? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Ʉnyenye mɨnintanga ʉnene ‘Mʉmanyisi’ hangɨ Isekʉlʉ, mɨtambʉla ɨtai kʉnsoko ʉnene ʉʉnɨlɨ. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Kʉlʉlo, angaitule ʉnene nɨni Isekʉlʉ hangɨ Mʉmanyisi wanyu nʉmʉkalaye ʉnyenye migʉlʉ, nʉnyenye ga mʉtakɨwe mikalalye mɨgʉlʉ ʉnyenye. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Ʉnene nʉmʉlagɨɨe ɨmpyani kɨna, mʉtakɨwe nʉnyenye ga mitʉme anga nɨnʉmʉtendee ʉnyenye. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Kʉmʉɨla ɨtai taai, mʉtugwa shanga mʉkʉlʉ kʉkila mʉgolɨ wakwe, nʉ mʉlagɨligwa watule mʉkʉlʉ kʉkila mʉlagɨɨlyi. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Itɨgwa, angaɨtule malɨnga makani aya, Itunda ʉkʉmʉkembeta ʉnyenye anga mitʉme.<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“Ntambʉe aya kʉnsoko anyu mɨhi. Nɨalɨngile ɨhi awo naɨnɨahoile, Ingɨ ʉandɨkwa ʉhume kʉkondanɨɨla, ‘Ʉyo naɨʉlɨe ndya yane wampɨlʉkɨla wankʉange.’ <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />Ʉnene kʉmʉɨla makani aya nakɨlɨ kʉpumɨɨla, ingɨ anga apumɨle mʉhʉɨɨle kɨna ‘Yʉ Nene.’ <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Kʉmʉɨla ɨtai taai, mʉntʉ wɨhi, nʉkʉmʉsɨngɨɨlya ʉyo ninʉmʉlagɨɨye, ʉkʉtula wansɨngɨɨlya ʉnene, nʉyo nʉkʉnsɨngɨlya ʉnene, wamʉsɨngɨɨlya ʉyo nʉndagɨɨye”<verse eid="JHN 13:20" /></para>
  <para style="s">Yesʉ ʉkʉtambʉla nʉʉzɨzasuɨpwa</para>
  <para style="r">
    <ref loc="MAT 26:20-25">Matayo 26:20-25</ref>; <ref loc="MRK 14:17-21">Maliko 14:17-21</ref>; <ref loc="LUK 22:21-23">Lʉka 22:21-23</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Yesʉ naɨwakondya kʉtambʉla nanso, wɨkahʉsha nangulu mʉnkolo akwe, wɨkalʉnga, Kʉmʉɨla ɨtai taai, “Ʉng’wɨanyu ʉkʉnsuɨpa.” <verse eid="JHN 13:21" /><verse number="22" style="v" sid="JHN 13:22" />Amanyisigwa akwe ɨkatula kigoza kʉnsoko shanga aɨalɨngile ʉkʉmʉtambula nyenyu. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Mʉmanyisigwa ʉng’wi, Yesʉ naɨɨza ʉmʉloilwe nangulu, aɨwikiɨ pakupɨ nʉ Yesʉ. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Itɨgwa, Simon Petelo wɨkamʉlagɨɨla namʉkono mʉmanyisigwa nʉwanso, “Mʉkolye nʉɨkamʉsuɨpa nyenyu.” <verse eid="JHN 13:24" /><verse number="25" style="v" sid="JHN 13:25" />Mʉmanyisigwa nʉwanso wazewiegamɨɨye mʉkɨkua kang’wa Yesʉ, wɨkʉmʉkolya, “Isekʉlʉ, kʉɨle nyenyu nʉkʉʉsuɨpa?” <verse eid="JHN 13:25" /><verse number="26" style="v" sid="JHN 13:26" />Yesʉ wɨkasʉkɨɨlya, “Ingɨ ʉyʉ angandɨɨlye mʉnyenyi ntonge amʉkate nʉkʉmʉpa, yʉyogwa” Itɨgwa, wɨkalɨɨlya ɨntonge amʉkate mʉnyenyi, wɨkamʉpa Yʉda Isikoliote, ng’wana wang’wa Simon Isikalioti. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Yʉda naɨwaunzɨla ʉdu ɨntonge nanso, Shetani wɨkamingɨɨla. Yesʉ wɨkamʉɨla Yuda, “Pepala kitʉma ɨkɨ nʉkʉhiya kitʉma.” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Awo ɨhi naɨikiɨ paʉlyi kʉtilɨ naɨʉlɨngile nɨkɨ Yesʉ ʉmʉɨɨe itɨ ʉ Yuda. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Kʉnsoko Yʉda aɨwɨambɨɨla kɨʉto ka mpia, niang’wɨ ɨkasɨga kɨna Yesʉ aɨʉmʉɨɨe Yʉda wende wagʉle maintʉ kʉnsoko iloeelya, ang’wɨ kʉnsoko akʉapa aʉla. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />Papo ʉdu, Yʉda naɨ wakondya kʉunzɨla mʉkate nʉanso, wɨkipatɨɨlya kʉpuma kʉnzi. Itungo nɨlanso aɨyaina ʉtikʉ.<verse eid="JHN 13:30" /></para>
  <para style="s">Ilagɨɨlyo nipya</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Yʉda naɨwahega, Yesʉ wɨkalʉnga, “Itungo ɨlɨ Ng’waa Mʉntʉ wakʉligwa, Itunda nʉng’wenso wakʉligwa mʉng’wakwe. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Angaitule ikʉlyo lang’wi Itunda lakunʉkʉlwa mʉ Ng’wana, itɨgwa, Itunda nʉyo ʉkʉmʉkʉlya ʉ Ng’wana wakwe, hangɨ ʉkʉkaya ʉkʉtenda itɨ. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />Wɨkaaɨla “Ana ane, ʉnene nkɨlɨ nine nʉnyenye itungo ɨninoda. Mʉkʉtula kʉnduma anga naɨnɨatambʉɨe Ayahudi, ʉʉgwa kʉmʉɨla nʉnyenye. kʉnihongile ʉnene ʉnyenye shanga mʉzile. <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />Kʉmʉpa ilagɨɨlyo nipya, Milowe, anga ʉnene naɨ nʉmʉloilwe ʉnyenye, ʉʉgwa nʉnyenye milowe. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Anga milowe, antʉ ɨhi akʉlɨnga kɨna ʉnyenye mɨamanyisigwa ane.”<verse eid="JHN 13:35" /></para>
  <para style="s">Yesʉ ʉkʉpumya mʉloto kɨna Petelo wɨkamʉhita</para>
  <para style="r">
    <ref loc="MAT 26:31-35">Matayo 26:31-35</ref>; <ref loc="MRK 14:27-31">Maliko 14:27-31</ref>; <ref loc="LUK 22:31-34">Lʉka 22:31-34</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Simon Petelo wɨkamʉkolya, “Isekʉlʉ, ʉhongile pɨ?” Yesʉ wɨkamʉsʉkɨɨlya, “Kʉnihongile shanga ʉhumile kʉntyata, ingɨ ʉzɨɨzantyata panyambele.” <verse eid="JHN 13:36" /><verse number="37" style="v" sid="JHN 13:37" />Petelo wɨkamʉkolya hangɨ, “Isekʉlʉ, nɨkɨ neng’we kʉʉtyata itungo ɨlɨ? Nihambile kʉsha kʉnsoko ako.” <verse eid="JHN 13:37" /><verse number="38" style="v" sid="JHN 13:38" />Yesʉ wɨkasʉkɨɨlya, “Itɨɨ, ʉewe wihambilene ɨtai taai kʉsha kʉnsoko ane? Kʉɨla ɨtai taai kɨna nsambalume nɨɨkɨlɨ kʉkʉnkʉla ʉkʉnɨhita kataatu.”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">Yesʉ nzɨla akendela kʉng’wa Tata</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />Yesʉ wɨkaaɨla, “Leki kʉhʉshi mʉnkolo yanyu. Mʉmʉhʉɨɨe Itunda, nihʉɨɨli nʉnene ga. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Mʉnyʉmba ang’wa Tata wane lʉkolɨ likalo lɨdʉ, kang’wɨ shangaʉʉ, ɨze namʉtambʉɨe. Itungo ɨlɨ nongoe nende mʉnoneelya likalo. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Ʉnene anga nende nʉmʉnonelya ʉnyenye ʉlikalo, kʉtulya nʉmʉhole mɨshiɨ palʉng’wɨ nʉnene, ingɨ pa nkolɨ ʉnene, nʉnyenye mʉtule papo. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Ʉnyenye mʉlɨngile nzɨla akʉpikɨla kʉnihongile.” <verse eid="JHN 14:4" /><verse number="5" style="v" sid="JHN 14:5" />Tomaso wɨkamʉɨla, “Isekʉlʉ, ʉsese shanga kʉlɨngile kʉʉhongile, kʉhumile ʉlɨ kʉmɨlɨnga nzɨla?” <verse eid="JHN 14:5" /><verse number="6" style="v" sid="JHN 14:6" />Yesʉ wɨkamʉsʉkɨɨlya, “Ʉnene yɨyo nzila nɨaɨla antʉ itai ang’wi Itunda nʉkʉapa ʉpanga nʉwa kalɨ na kalɨ. Mʉntʉ shanga ʉzile kʉng’wa Tata anga wahite kʉkɨɨla kʉng’wane. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Angaɨtule mʉnɨngile ʉnene, mʉkʉmʉlɨnga nʉ Tata ga. Kʉpuma itungo lɨlɨ, mʉmʉlɨngile ʉ Tata wane, hangɨ mamʉona.” <verse eid="JHN 14:7" /><verse number="8" style="v" sid="JHN 14:8" />Pilipo wɨkamʉɨla, “Isekʉlʉ, kʉlagɨɨle ʉ Tata, kʉng’witʉ ikonde. <verse eid="JHN 14:8" /><verse number="9" style="v" sid="JHN 14:9" />Yesʉ wɨkamʉɨla, “Pilipo, nikae nʉnyenye matungo ɨhi, ʉewe Pilipo ʉkɨlɨne kʉnɨnga? Nʉwakondilye kʉmona ʉnene, wamʉona nʉ Tata. Ʉhumile ʉlɨ gwa, kʉlʉnga kɨna, ‘Kʉlagɨɨle ʉ Tata?’ <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Itɨɨ, shanga ʉhʉɨɨene kɨna ʉnene nkolɨ mʉng’wa Tata, nʉ Tata ʉkolɨ mʉng’wane? Shanga kʉtambʉla nane ʉdu, ingɨ Tata nʉkolɨ mʉng’wane ʉkitʉma mɨlɨmo akwe. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Mʉtakɨwe kʉnihʉɨɨla kɨna ʉnene nkolɨ mʉng’wa Tata nʉ Tata ʉkolɨ mʉng’wane. ize shanga mʉnihʉɨɨe, nihʉɨɨli kʉmɨlɨmo nɨnitʉma. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Kʉmʉɨla ɨtai, mʉntʉ wɨhi nʉnihʉɨɨe ʉnene, ʉkitʉma mɨlɨmo nɨnitʉma ʉnene, ʉkitʉma nɨmɨlɨmo nɨmɨkʉlʉku kʉkɨla ɨyɨ, kʉnsoko ʉnene nongoe kʉng’wa Tata. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Ʉnyenye anga mʉlompe kɨntʉ kɨhi anga nɨndoewe, kʉmʉtendeela, ingɨ ʉ Tata wakʉligwe mʉ Ng’wana. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Anga mʉlompe kɨntʉ kɨhi anga nɨndoewe, kʉmʉtendeela.<verse eid="JHN 14:14" /></para>
  <para style="s">Yesʉ ʉkʉlaga kʉmʉleta Ng’wahʉ ng’welʉ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />Yesʉ wɨkaaɨla, “Anga mʉndowe, mʉkʉkela ɨmalagɨɨlyo ane. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Nʉnene kʉmʉlompa ʉ Tata, nʉyo ʉkʉmʉpa Miaɨɨlyi wanyu mʉngɨɨza, nɨmʉkikalania ɨkalɨ na kalɨ. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />Nʉwanso ingɨ Ng’wahʉ nʉwatai nʉang’wi Itunda. Antʉ aʉnkumbigʉlʉ shanga akʉmʉsɨngɨɨlya kʉnsoko shanga ʉhumile kʉmʉona ang’wɨ kʉmʉlɨnga. Ingɨ ʉnyenye mʉmʉlɨngile kʉnsoko ʉkolɨ palʉng’wɨ nʉnyenye hangi wishiɨ mʉng’wanyu. <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />“Anga nihege, shanga kʉmʉleka mɨalekwa, kʉsʉka hangɨ kishiɨ nʉnyenye. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Lasiga itungo ɨniino antʉ aʉnkumbigʉlʉ shanga akʉmona hangɨ, ingɨ ʉnyenye mʉkʉmona, kʉnsoko ʉnene kʉtula nimʉpanga hangɨ, nʉnyenye mʉkʉtula nʉʉpanga nʉwa tai. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Lʉhikʉ nʉlanso anga lʉpike papo mʉkʉlɨnga kɨna ʉnene nkolɨ mʉng’wa Tata, nʉnyenye mʉkolɨ mʉng’wane, nʉnene nkolɨ mʉng’wanyu.<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />Antʉ nɨasɨngɨɨye malagɨɨlyo ane nʉkʉmakela, nɨanso wawo andoilwe. Nawo nɨandoilwe ʉnene Tata wane ʉkʉalowa, nʉnene kʉalowa nʉkigeeleka kʉng’wao.<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />Yʉda shanga ʉyo naɨʉmʉsuɨpile ʉ Yesʉ wɨkamʉɨla, “Isekʉlʉ, yɨkʉtula ʉlɨ ʉewe wigeeleke kʉng’witʉ shanga kʉ antʉ aʉkʉnkumbigʉlʉ?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Yesʉ wɨkamʉsʉkɨɨlya, “Antʉ awo nɨakʉndowa ʉnene akʉtenda ayo nɨkʉaɨla, nʉ Tata wane ʉkʉalowa, ʉnene nʉ Tata kʉzile kʉng’wao nʉkishiɨ palʉng’wɨ nɨenso. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Antʉ ɨhi nɨshanga andoilwe shanga ɨtenda ayo nɨkʉaɨla. Nkani nɨkʉmʉpa shanga yane, ingɨ yang’wa Tata nʉntʉmile.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />“Nʉmʉmanyisilye makani aya ɨhi nɨnkɨlɨ kʉhega. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Ingɨ Miaɨɨlyi wanyu, Ng’wahʉ Ng’welʉ, nʉ Tata ʉkʉmʉtʉma kʉtula kimɨkɨɨli kane, ʉkʉmʉmanyisa makani ɨhi nʉkʉmʉkɨmbʉsha ɨhi naɨnʉmʉɨɨe.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />“Kʉmʉlekela matiliga, Ee! Kʉmʉpa matiliga ane. Shanga kʉmʉpa ʉnyenye anga antʉ aʉnkumbigʉlʉ nɨɨmʉpa. Leki kʉtulɨ nɨmasɨgo mʉnkolo yanyu, nʉkogopa. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />Migulye nɨtambʉe, ‘Ʉnene nalongola, sʉnga kʉtulya hangɨ kʉng’wanyu.’ Anga azaɨtule mʉndoilwe, aza mʉziiloa kija nongoe kʉng’wa Tata, kʉnsoko nʉwanso ingɨ mʉkʉlʉ kʉkɨla ʉnene. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Nʉtambʉɨe makani ayaitɨ itungo ɨlɨ kʉnsoko akɨlɨ kigeeleka, ingɨ anga ɨze igele mʉhume kʉhʉɨɨla. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Shanga kʉsʉkɨɨla kʉtambʉla nʉnyenye makani aya, kʉnsoko mʉkʉlʉ nʉwa ʉnkumbigʉlʉ ʉwʉ ʉpembilye. Kʉnsoko pang’wane shanga ʉhumile anga kɨntʉ. <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />Ingɨ antʉ aʉnkumbigʉlʉ atakɨwe alɨnge kɨna nʉmʉloilwe ʉ Tata, yɨyo nsoko nitʉma makani ɨhi anga nʉndagɨiye nʉ Tata.</para>
  <para style="p" vid="JHN 14:31">“Ʉki, hegi kweni.<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">Yesʉ mʉzabibʉ nʉwatai</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />Sʉnga Yesʉ wɨkalʉnga, “Ʉnene nɨmʉzabibʉ nʉwa tai, nʉ Tata wane ingɨ mʉlɨmi. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Itambɨ lɨhi nɨlɨkolɨ mʉng’waane nɨshanga lɨpaa nkali, Tata wane wɨlɨtema nʉkʉlɨheja, hangɨ itambɨ lɨhi nɨlɨpaa wɨlɨnoneelya lɨhume kʉpa ikɨlo. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Ʉnyenye maina mɨelʉ mʉnkolo kʉnsoko a ʉlʉkani ʉlo naɨnʉmʉmanyisilye. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Ishii mʉng’wane, anga ʉnene nɨnishiɨ mʉng’wanyu. Anga itambɨ nɨla mʉzabibʉ nɨshanga lɨkʉpa nkalɨ anga lɨhite kʉkamɨnkana nitina, ʉʉgwa nʉnyenye shanga mʉkitʉma ayo Itunda nʉmaloilwe anga ɨze shanga mishiɨ mʉng’wane. <verse eid="JHN 15:4" /><verse number="5" style="v" sid="JHN 15:5" />Ʉnene nɨmuzabibʉ, ʉnyenye mɨntambɨ. Awo nɨishiɨ mʉng’wane, nʉnene mʉng’wao, nɨanso akitʉma makani ɨdʉ nʉmaloilwe Itunda, kʉnsoko ʉnene angantule nɨkʉtile mʉkʉlegwa kitʉma kɨntʉ kɨhi. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Mʉntʉ wɨhi anga wahite kishiɨ mʉng’wane wɨgʉng’wa kʉnzi anga itambɨ nɨlɨgʉng’wa kʉnzi sʉnga lɨkʉma. Antʉ ɨhola itambɨ nɨlaitɨ ɨkalɨgʉmɨla mʉmoto lɨpye. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Ʉnyenye anga mishiɨ mʉng’wane nɨnkani yane yishiɨ mʉng’wanyu, lompi kɨntʉ kɨhi nɨmʉloilwe nʉnyenye mʉkʉpegwa. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Kʉlʉlo Tata wane wɨkʉligwa, anga mitʉme makani ɨdʉ nʉmaloilwe Itunda, nʉnyenye mʉkʉtula mɨamanyisigwa ane. <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />Ʉnene nʉmʉloilwe ʉnyenye anga ʉ Tata nʉndoilwe ʉnene. Ʉʉgwa ishii mʉʉlowa wane. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Anga mʉkele malagɨɨlyo ane mʉkishiɨ mʉʉlowa wane, anga ʉnene nɨɨza nkee ɨmalagɨɨlyo ang’wa Tata wane nʉkishiɨ mʉʉlowa wakwe. <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />Nʉmʉtambʉɨe ɨnkani izi ingɨ mʉlowe anga ʉnene nɨniloile, nʉʉlowa wanyu ʉtule ʉkondanɨɨe. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Ilɨ lɨlɨ ilagɨɨlyo lane kɨna. Ilowi, anga ʉnene nɨnʉmʉloilwe ʉnyenye. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Kʉtilɨ mʉntʉ nʉkete ʉlowa nʉʉkʉlʉ kʉkɨlɨnkɨla ʉlowa nʉwa mʉntʉ kʉpumya ʉpanga wakwe kʉnsoko ahʉmbaʉya. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Ʉnyenye mɨahʉɨmba ɨane anga mitʉme nɨnʉmʉlagɨɨye. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Hangɨ shanga kʉmitanga ʉnyenye mɨitʉmi, ndogoelyo mitʉmi shanga ʉine ɨko mʉgolɨ wakwe nʉkitʉma. Ingɨ ʉnene nɨmitangile ʉnyenye ahʉmba ɨane, kʉnsoko namʉpikɨlya makani ɨhi nɨnigulye kʉpuma kʉng’wa Tata. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Ʉnyenye shanga nyenye aɨmʉnsagʉe ʉnene, ingɨ nene aɨnʉmʉsagʉe nʉkʉmʉlagɨɨlya mitʉme mɨlɨmo nʉmɨloilwe Itunda, mɨlɨmo nanso ikishiɨ mahikʉ ɨhi, ingɨ kɨntʉ kɨhi anga mʉmʉlompe ʉ Tata kʉlina lane, wamʉpe. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Kʉmʉpa ilagɨɨlyo lane. Milowe.<verse eid="JHN 15:17" /></para>
  <para style="s">Antu aʉnkʉmbigʉlʉ akʉmʉbɨpɨlwa</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“Antu aʉnkʉmbigʉlʉ anga amʉbɨpɨlwe ʉnyenye, mʉlɨnge kɨna aɨambɨpɨwe hanza ʉnene. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Anga aza mʉtule mɨantʉ aʉnkumbigʉlʉ, antʉ aʉnkumbigʉlʉ aɨazemʉlowa ʉnyenye anga mɨantʉ akwe. Ingɨ kʉnsoko ʉnyenye shanga mɨaʉnkumbigʉlʉ, ʉnene nʉmʉhoile kʉpumɨɨla mʉʉnkumbigʉlʉ, yɨyɨ nsoko antʉ aʉnkumbigʉlʉ amʉbɨpɨwe. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Kɨmbʉki nkani izo naɨnʉmʉtambʉɨe kɨna, ‘Mitʉmi shanga mʉkʉlʉ kʉkɨla mʉgolɨ wakwe. angaɨze aɨanagilye ʉnene, akʉmaja nʉnyenyega, angaɨze aɨakee lʉkani lane, akʉkela ninkani yanyu ga. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Ingɨ akʉmʉtendeela makani nanso ɨhi kʉnsoko ʉnyenye mɨahemba ane, kʉndogoelyo shanga amʉlɨngile ʉyo nʉntʉmile. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Anga aɨnihite kʉza nʉkʉaɨla nkani yang’wi Itunda izeagila anga mɨlandʉ, ingɨ itungo ɨlɨ agila winegelo kɨna agila anga mɨlandʉ. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Antʉ ɨhi nʉmbɨpɨwe ʉnene ʉmʉbɨpɨwe nʉ Tata wane ga. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Anga ɨze shanga nɨtʉmile makani mʉng’wao niiza kikɨlɨ mʉntʉ mʉngɨɨza wɨhi nʉwitʉme, ɨzeagila anga igazo. Ingɨ itungo ɨlɨ amona ʉnene kitʉma makani aya ambɨpɨlwa ʉnene, nʉ Tata wane. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Yɨyo ndogoelyo ayo ʉkondanɨɨle ʉandɨkwa nʉandɨkilwe mʉ malagɨɨlyoao kɨna. ‘Ambɨpɨwe nakanda.’ <verse eid="JHN 15:25" /><verse number="26" style="v" sid="JHN 15:26" />Ingɨ nʉzɨɨza Miaɨɨlyi ʉyʉ nɨnʉmʉlagɨɨye kʉng’wanyu kʉpuma kʉng’wa Tata, Miaɨɨlyi ʉyʉ nʉwa tai, nʉwanso ʉkʉmʉɨla ɨtai ane ɨhi. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Nʉnyenye ga mʉkʉaɨla antʉ aʉya inkani yane, kʉnsoko kaile kɨpalʉng’wɨ kʉpuma ʉng’wandyo.<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />Yesʉ wɨkalongoleka kʉaɨla kɨna, “Nʉmʉtambʉɨe nanso kʉnsoko nʉmʉkomelye nkolo mʉleke kʉmʉhita Itunda. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Antʉ akʉmʉzunsa ʉnyenye mʉnyʉmba niyakipoelya Ayahudi. Hangɨ, matungo apembilye nʉ mʉntʉ wɨhi anga wamʉbʉlaga ʉnyenye ʉkʉsɨga kɨna ʉkʉmitʉmila Itunda. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Akʉmʉtendeela makani nanso kʉnsoko shanga amʉlɨngile ʉ Tata, hangɨ shanga anɨngile ʉnene. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Itɨgwa, nʉmʉtambʉɨe makani aya ingɨ itungo anga lɨpike mʉkɨmbʉke kɨna aɨnamʉtambʉɨla.</para>
  <para style="s" vid="JHN 16:4">Mʉlɨmo nʉwa Ng’wahʉ Ng’welʉ</para>
  <para style="p" vid="JHN 16:4">“Shanga aɨnʉmʉtambʉɨe makani aya kandɨɨlya ʉng’wandyo kʉnsoko aɨkine nʉnyenye. <verse eid="JHN 16:4" /><verse number="5" style="v" sid="JHN 16:5" />Ingɨ itungo ɨlɨ nalongola kʉng’wakwe naɨʉntʉmile, ingɨ kʉtilɨ mʉntʉ nʉkʉnkolya, ‘Ʉhongile pɨ?’ <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Kʉnsoko namʉtambʉɨla makani naya, mahʉsha mʉnkolo yanyu. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Ingɨ, kʉmʉɨla ɨtai. Itakɨwe ʉnene nihege, kʉnsoko anga nihite kʉhega, Miaɨɨlyi ʉyʉ shanga ʉzile kʉng’wanyu. Ingɨ anga nihege, kʉmʉtʉma kʉng’wanyu. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />Nʉyo anga waze ʉkʉakumʉɨla antʉ aʉnkumbigʉlʉ kʉ mɨlandʉ nʉ kʉgombeka kʉng’wi Itunda nʉ ʉlamʉlwi. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />Atendile mɨlandʉ, kʉnsoko shanga anihʉɨɨe ʉnene, <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />Ng’wahʉ Ng’welʉ ʉkʉmʉlagɨɨla kɨna ʉnene nagombeka kʉng’wi Itunda, kʉnsoko nongoe kʉng’wa Tata, nʉnyenye shanga mʉkʉmona hangɨ. <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />Kʉ makani aʉlamʉlwa, kʉnsoko shetani, mʉkʉlʉ nʉwa ʉnkumbigʉlʉ ʉwʉ wakondilye kʉlamʉlwa.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />“Nkɨlɨ nkete nkani yɨdʉ niyakʉmʉtambʉɨla, ingɨ itungo ɨlɨ shanga mʉhumile kʉgimya. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Ingɨ nʉʉzɨɨza ʉ Ng’wahʉ nʉwanso nʉwa tai ʉkʉmʉtongeela mʉtai ɨhi, nʉwanso shanga ʉkʉtambʉla kʉʉhumi akwe, ingɨ ʉkʉtambʉla ayo ɨhi nʉʉkija kʉpuma kʉng’waane, nʉyo ʉkʉalagɨɨla makani nakʉpumɨla panyambele. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Nʉwanso ʉkʉmpa inkʉlyo, kʉnsoko ʉkʉmʉpikɨlya ayo nɨkʉmʉɨla ʉnene. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Ɨhi nʉkete ʉ Tata wane ingɨ ane, yɨyo ndogoelyo nalʉnga kɨna Ng’wahʉ nʉwa tai ʉkʉmʉpikɨlya ayo nɨkʉmʉɨla ʉnene.<verse eid="JHN 16:15" /></para>
  <para style="s">Kʉhʉsha nʉ kʉlowa</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />“Lɨkɨlɨ itungo iniino nʉ nyenye shanga mʉkʉmona, ingɨ anga lɨkɨle itungo iniino mʉkʉmona hangɨ!”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Papo amanyisigwa akwe nɨangwɨ ɨkɨkolya, “Ʉkete ndogoelyo kɨ nʉkʉlʉnga, ‘Lɨkɨlɨ itungo iniino nʉ nyenye shanga mʉkʉmona, ingɨ anga lɨkɨle itungo iniino mʉkʉmona hangɨ! Kʉnsoko nongoe kʉng’wa Tata?’ <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Itɨgwa, ɨkalongoleka kikolya, “Ʉkete ndogoelyo kɨ Nʉkʉlʉnga, “Itungo iniino?’ Kahita kʉlɨnga ʉkʉtambʉla ntʉni.”<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />Yesʉ wɨkalɨnga kɨna akʉhiya kʉmʉkolya, ʉʉgwa wɨkaaɨla, “Itɨɨ, mainikolya nkete ndogoelyo kɨ nɨntambʉe kɨna, ‘Lɨkɨlɨ itungo iniino nʉ nyenye shanga mʉkʉmona, ingɨ anga lɨkɨle itungo iniino mʉkʉmona hangɨ?’ <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Kʉmʉɨla ɨtai, ʉnyenye mʉkʉlɨla nʉkʉhongeelya, ingɨ antʉ aʉnkumbigʉlʉ akʉlowa, mʉkʉhʉsha ingɨ ʉhʉshi wanyu ʉkʉpɨlʉka kʉtula ʉlowa. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Itungo mʉsʉngʉ nʉkitungʉɨla wɨhʉsha kʉnsoko itungo nɨla ʉwai lapika. Ingɨ anga wakondye kitungʉɨla ng’wana, wɨwaa lʉkʉlʉ ʉwai nʉwanso kʉnsoko aʉlowa nʉwa mʉntʉ watugwa mihɨɨ. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Itungo ɨlɨ ʉnyenye mʉhʉkilye, ingɨ ʉnene kʉmʉzɨɨla hangɨ, nʉnyenye mʉkiloa mʉnkolo yanyu, kʉtile anga mʉntʉ nʉkʉʉheja ʉlowa nʉwanso mʉng’wanyu.<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />Lʉhikʉ nʉlanso shanga mʉkʉnompa ʉnene kintʉ kɨhi. Kʉmʉɨla ɨtai, kɨntʉ kɨhi nɨmʉkʉmʉlompa ʉ Tata anga mʉndoewe, ʉkʉmʉpa. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Kʉpikɨɨla itungo ɨlɨ mʉkɨlɨ kʉlompa kɨntʉ kɨhi kʉʉhumi wane. Lompi nʉnyenye mʉkupegwa, ingɨ ʉlowa wanyu ʉkondanɨɨle.<verse eid="JHN 16:24" /></para>
  <para style="s">Yesʉ ʉkʉʉlemya ngulu nimbɨ mihɨɨ</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“Nʉmʉɨe makani aya kɨʉng’enyeli. Ingi matungo apembilye nɨshanga kitambʉlya nʉ nyenye kɨʉng’enyeli hangɨ, ingɨ kʉtula mʉtambʉɨla nkani yang’wa Tata kɨhenga. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Lʉhikʉ nʉlanso mʉkʉlompa anga nɨmʉnihʉɨɨe, hangɨ shanga kʉmʉɨla kɨna kʉmʉlompa Tata kʉmɨmɨkɨɨla ʉnyenye, <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />kʉndogoelyo Tata ʉng’wenso ʉmʉloilwe ʉnyenye, nʉnyenye mʉndoilwe ʉnene hangɨ mʉhʉɨɨe kɨna mpumɨɨe kʉng’wi Itunda. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Ʉnene aɨmpumɨɨe kʉng’wa Tata, nɨkɨza mʉʉnkumbigʉlʉ nitungo ɨlɨ nakaʉleka ʉnkumbigʉlʉ nʉkʉtulya kʉng’wa Tata.”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Sʉnga, amanyisigwa akwe ɨkamʉɨla, “Ʉʉgwa, Itungo ɨlɨ ʉkʉtambʉla kɨhenga lʉkʉlʉ waleka kɨʉng’enyi. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Itungo ɨlɨ kalɨnga kɨna ʉwewe ʉlɨngile makani ɨhi, wimʉgila anga nsoko akʉkoligwa makolyo nʉmʉntʉ wɨhi, kʉlʉlo kʉhʉɨɨe kɨna ʉpumɨɨe kʉng’wi Itunda.”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />Yesʉ wɨkaasʉkɨɨlya, “Itɨɨ, itungo ɨlɨ mahʉɨɨla ne? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Itungo lɨpembilye, hangɨ lapika, nʉ ʉnyenye mʉkʉbalansana mʉntʉ wɨhi ʉkʉlongola kito lakwe, nʉnene kʉlekwa ning’wene. Ingɨ ʉnene shanga ning’wene kʉnsoko Tata ʉkolɨ palʉng’wi nʉnene. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />Nʉmʉtambʉɨe makani aya mʉhume kʉtula nɨmatiliga nɨmʉmolɨ mʉng’wane. Mʉʉnkumbigʉlʉ mʉkʉtula nʉ lwago, ingɨ komyi ɨnkolo, ndogoelyo ʉnene naʉlemilye ʉnkumbigʉlʉ.”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">Yesʉ ʉkʉalompeela amanyisigwa akwe</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Yesʉ naɨwakondya kʉtambʉla nkani niyanso, wɨkalangamɨla kilunde, wɨkalʉnga, “Tata, itungo lapika. Mʉkʉlye ʉ Ng’waako, nʉng’wenso ng’waako wahume kʉʉkʉlya. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Kʉnsoko ʉmʉpee ng’waako ʉhumi kʉantʉ ɨhi wahume kʉapeza ʉpanga nʉwa kalɨ na kalɨ ɨhi nɨanso naɨ ʉmʉpee. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Nʉʉpanga nʉwakalɨ na kalɨ ingɨ sʉwʉ. Kʉʉmanya ʉwewe Itunda nʉwatai nʉwing’wene, nʉkʉmʉmanya Yesʉ kilisito naɨ ʉmʉlagɨɨye. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Ʉnene nakʉkʉlya mʉnʉ mihɨɨ, nakondaɨɨlya kitʉma mʉlɨmo ʉwo naɨ ʉmpee nitʉme. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Ʉʉgwa Tata, itungo ɨlɨ ʉnkʉlye pa ntongeela ako, kikʉlyo ɨlo naɨnkete kʉpuma naɨ ɨkɨlɨ kʉtundwa ʉnkumbigʉlʉ.<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />“Naatambʉɨla ɨantʉ awo naɨ ʉmpee kʉpuma mʉʉnkumbigʉlʉ akʉlɨnga. Aɨza ako, wɨkampa ʉnene, nɨenso akee nkani yako. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Itungo ɨlɨ alɨnga kɨna intʉ yɨhi naɨʉndagɨɨye yɨpumɨɨe kʉng’wako. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Ʉnene naatambʉɨe makani ayo naɨʉndagɨɨye, nɨenso ansɨngɨɨye hangɨ alɨnga kɨna mpumɨɨe kʉng’wako, hangɨ ahʉɨɨe kɨna wewe aɨʉntʉmile. <verse eid="JHN 17:8" /><verse number="9" style="v" sid="JHN 17:9" />“Kʉalompeela enso, shanga kʉalompeela anga antʉ aʉnkumbigʉlʉ, ingɨ kʉalompeela awo naɨʉmpee, kʉnsoko nɨanso ingɨ ako. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Antʉ ane ɨhi ingɨ ako, nɨantʉ ako ingɨ ane, nikʉlyo lane lakʉligwa mʉng’wao nʉmpee. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Nɨtungo ɨlɨ kʉhega mihɨɨ mpembilye kʉng’wako, ingɨ nɨanso akɨlɨ amolɨ mihɨɨ. Tata nʉwɨng’wene! Itʉnʉ kʉʉlompa asʉnje antʉ awa atule anga ʉewe nʉɨlɨ, hangɨ atule ɨpalʉng’wɨ anga ʉsese nɨkɨpalʉng’wɨ. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Naɨnkolɨ palʉng’wɨ nɨenso, ʉnene aɨnɨasʉnjilye atule anga ʉewe nʉɨlɨ. Kʉtilɨ anga nʉng’wɨ naʉlimɨe, kʉleka ʉyo naɨ ʉtakɨwe kʉlimansɨɨligwa, ingɨ ʉandɨkwa ʉkondanɨɨle. <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />Itɨgwa, itungo ɨlɨ napembya kʉg’wako, ʉnene aɨnɨatambʉɨe makani aya naɨnkɨlɨ nkolɨ mihɨɨ, ingɨ atule nʉʉlowa wane nʉʉkondanɨe mʉng’wao. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Ʉnene naapeza lʉkani lako, antʉ amihɨɨ abɨpɨlwa, kʉnsoko nɨanso shanga antʉ aʉnkumbigʉlʉ, anga ʉnene nɨshanga nɨaʉnkumbigʉlʉ. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Ʉnene shanga kʉlompa kɨna ʉaheje mihɨɨ, ingɨ kʉʉlompa ʉasʉnje ahege mʉ mʉlʉgʉ ʉyʉ. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Nɨanso shanga ihɨɨ ɨyɨ, anga ʉnene nɨshanga nɨamihɨɨ ɨyɨ. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Ʉatende atule ako kʉtai ɨyo, lʉkani lako ingɨ tai. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Anga naɨ ʉntʉmile ʉnene mihɨɨ, nʉnenega nɨatʉmile enso mihɨɨ. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Ʉnene nieilye kʉnsokoao, ingɨ nɨanso ahume kʉlija nsaɨlo kʉkɨɨla tai.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“Shanga kʉalompeela ɨenso ʉdu, ingɨ kʉalompeela nawo ɨhi nɨakʉhʉɨɨla kʉkɨɨla lʉkani lao. <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />Ingɨ kʉlompa ɨhi atule kɨntʉ kɨng’wɨ. Tata! Nompile atule kʉng’witʉ anga ʉewe nʉʉmolɨ mʉng’wane nʉnene mʉng’wako. Nɨenso atule mʉng’witʉ, ʉnkumbigʉlʉ ʉhume kʉhʉɨɨla kɨna wewe aɨʉntʉmile ʉnene. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Ʉkʉlʉ ʉwo naɨʉmpee ʉnene naapeza enso, ahume kʉtula kɨntʉ kɨng’wɨ anga ʉsese nɨkɨpalʉng’wɨ. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Ʉnene kishiɨ mʉng’wao, nʉewe ʉkishiɨ mʉng’wane, ingɨ akondanɨɨligwe kʉtula kɨntʉ kɨng’wɨ, antʉ aʉnkumbigʉlʉ ahume kʉlɨnge kɨna wewe aɨʉntʉmile ʉnene, hangɨ ʉaloilwe nɨanso anga nʉndoilwe ʉnene.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />“Tata! Antʉ ɨhi nʉmpee ndoilwe atule ɨpalʉng’wɨ nʉnene apo nɨnkolɨ, ahume kʉona ʉkʉlʉ wane naɨʉmpee, kʉnsoko aɨʉndoilwe ʉnkumbigʉlʉ naɨʉkɨlɨ kʉtundwa. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />Tata! Matungo ɨhi nʉwituma makani atai! Antʉ aʉnkumbigʉlʉ shanga akʉmanyile, ʉnene nʉkʉmanyile. Awa nɨenso alɨngile kɨna wewe aɨʉntʉmile. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Ʉnene nakʉkumʉsha mʉng’wao hangɨ kʉlongoleka kʉtendaʉʉ, ʉlowa nʉʉkete mʉng’wane ʉtule ʉkolɨ mʉng’wao, nʉnene ntule mʉng’wao.”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">Yesʉ ʉkʉambwa</para>
  <para style="r">
    <ref loc="MAT 26:47-56">Matayo 26:47-56</ref>; <ref loc="MRK 14:43-50">Maliko 14:43-50</ref>; <ref loc="LUK 22:47-53">Lʉka 22:47-53</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Yesʉ naɨwakondya kʉtambʉla nkani niyanso, ɨkahega nɨamanyisigwa akwe ɨkatambʉka ng’wapo nʉwa Kidiloni. Nkɨka akabɨɨlɨ aɨkɨmolɨ kɨbuulya ka mɨtɨ, nʉanso palʉng’wɨ niamsnyisigwa akwe ɨkingɨla mʉmo. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />Itɨgwa Yʉda, naɨ ʉmʉsuɨpile Yesʉ, aɨʉmɨlɨngile nkɨka nanso kʉnsoko Yesʉ aɨɨtankanɨla nɨamanyisigwa akwe kʉko nkʉa yɨdʉ. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Ʉʉgwa, Yʉda wɨkaahola amboi nɨalili kʉpuma kʉ apolyi nɨakʉlʉ nɨa Palisayo, ɨkaza nɨenso mʉkɨbuulya ka mɨtɨ ɨkaze akɨɨye ɨmʉlɨ akenkile nɨyɨgɨ. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />Yesʉ aɨʉlɨngile ɨhi nakʉmʉpantɨka, wɨkaapumɨɨla, wɨkaakolya, “Mʉkʉmʉduma nyenyu?” <verse eid="JHN 18:4" /><verse number="5" style="v" sid="JHN 18:5" />Nɨanso ɨkamʉsʉkɨɨlya, “Yesʉ nʉwakʉ Nazaleti!” Yesʉ wɨkaaɨla, “Yʉ nene.” Yʉda nʉʉkʉmusuɨpa aɨwɨmɨkile papo palʉng’wɨ nɨenso. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Itɨgwa, Yesʉ naɨwaaɨla, “Yʉ nene,” ikasʉkasʉka kɨnyuma, ɨkagwa pihɨ. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />Yesʉ wɨkaakolya hangɨ, “Mʉkʉmʉduma nyenyu?” Ɨkamʉsʉkɨɨlya, “Yesʉ nʉwa kʉ Nazaleti!” <verse eid="JHN 18:7" /><verse number="8" style="v" sid="JHN 18:8" />Yesʉ wɨkaaɨla, “Nakondya kʉmʉtambʉɨla kɨna, yʉ nene. Itɨgwa, kaita mʉkʉnduma nene, aleki antʉ awa alongole.” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />Aɨʉtambʉe itɨ yɨhume kʉpikɨɨla ayo naɨʉtambʉe, “Mʉ awo naɨʉmpee kʉtilɨ ka nʉʉng’wɨ ninɨmʉlimɨɨye.” <verse eid="JHN 18:9" /><verse number="10" style="v" sid="JHN 18:10" />Simoni nʉ Yesʉ aɨwɨmitanga Petelo aɨʉkete nyalahanda, wɨkahopola, wɨkamʉtema kʉtwɨ nuwipande lakɨgoha mitʉmi wang’wa mʉkʉlʉ wi polyo. Ɨlina lakwe mitʉmi nʉwanso witangwa Maliko. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />Itɨgwa, Yesʉ wɨkamʉɨla Petelo, “Sʉkɨɨlya nyalahanda mʉzʉbʉ. Itɨɨ, ndekene kʉkɨɨla mʉlwago nʉ Tata wane ʉloilwe nkɨɨle?”<verse eid="JHN 18:11" /></para>
  <para style="s">Yesʉ pantongeela ang’wa mʉpolyi nʉ mʉkʉlʉ</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Sʉnga amboi nɨanso nɨakʉlʉ nɨatongeeli nɨalili akʉlʉ aa Loma anyumba a Ayahudi, ɨkamʉamba Yesʉ, ɨkamʉtunga ndigi <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />ɨkamʉtala hanza kʉng’wa Anasi, Anasi ai mʉkwɨngwa wang’wa Kayapa itungo nɨlanso yʉyoai Mʉpolyi Nʉmʉkʉlʉ ng’waka nʉwanso. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />Kayapa yʉyo aɨʉasɨgilye Ayahudi kɨna bahu mʉntʉ ʉng’wɨ washe kʉnsoko aantʉ ɨdʉ.<verse eid="JHN 18:14" /></para>
  <para style="s">Petelo ʉkʉmʉhita Yesʉ</para>
  <para style="r">
    <ref loc="MAT 26:69-70">Matayo 26:69-70</ref>; <ref loc="MRK 14:66-68">Maliko 14:66-68</ref>; <ref loc="LUK 22:55-57">Lʉka 22:55-57</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Simoni Petelo palʉng’wɨ nʉmʉmanyisigwa mʉngɨɨza aɨamʉtyatile Yesʉ. Mʉmanyisigwa nʉwanso nʉmʉngɨza aɨʉmanyikile kʉ mʉpolyi nʉmʉkʉlʉ, kʉlʉlo ɨkingɨlania nʉ Yesʉ mitando nɨla mʉpolyi nʉmʉkʉlʉ. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />Ingɨ Petelo aiwɨmɨkile kʉnzi, pakupɨ nʉmʉmpita. Itɨgwa, mʉmanyisigwa nʉwanso naɨʉmanyikile kʉ mʉpolyi nʉmʉkʉlʉ wɨkapuma kʉnzi wɨkaligitya nʉ mitʉmi nʉwa kɨmʉsʉngʉ nʉwa mʉpolyi nʉ mʉkʉlʉ, nʉwɨmɨɨla mʉmpita, wamʉgombye ʉ Petelo wingɨlanie nʉ Yesʉ mʉnyʉmba. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />Mitʉmi nʉwanso nʉwa kɨsʉngʉ nʉwilila pamʉmpita wɨkamʉkolya ʉ Petelo, “Itɨɨ, Nʉewega shanga wɨʉng’wɨao mʉamanyisigwa nʉwa mʉntʉ ʉyʉ?”</para>
  <para style="p" vid="JHN 18:17">Petelo wɨkamʉɨla, “Shanga nene!”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Itʉmi nɨa mboi aɨimɨkile akota ʉmoto nʉwa makala kʉnsoko aɨmpepo, Petelo nʉyo aɨimɨkanilye palʉng’wɨ nɨenso azota ʉmoto.<verse eid="JHN 18:18" /></para>
  <para style="s">Mʉpolyi nʉmʉkʉlʉ ʉkʉmʉkolya Yesʉ</para>
  <para style="r">
    <ref loc="MAT 26:59-66">Matayo 26:59-66</ref>; <ref loc="MRK 14:55-64">Maliko 14:55-64</ref>; <ref loc="LUK 22:66-71">Lʉka 22:66-71</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Itungo nɨlanso Mʉpolyi nʉmʉkʉlʉ wɨkatula mʉkolya ʉ Yesʉ nkani niya amanyisigwa akwe nʉʉmanyisi wakwe. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />Yesʉ wɨkasʉkɨɨlya, “Mahikʉ ɨhi ndigitilye kʉhenga nɨantʉ ɨhi. Nkʉa yɨdʉ manyisilye mʉnyʉmba nɨɨtankanɨla nʉkipoelya Ayahudi nʉ Mʉnyʉmba ang’wi Itunda, Nkɨka nɨɨtankanɨla Ayahudi ɨhi, nkɨlɨ kʉtambʉla ikani lɨhi kʉʉnkunku. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Nɨkɨ ʉkʉnkolya ʉnene? Akolye antʉ awo naɨigulye ayo naɨniatambʉɨe. Enso alɨngile naɨ ntambʉe.”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Naɨwakondya kʉtambʉla nanso mʉmboi ʉng’wɨ nʉwa Nyʉmba ang’wi Itunda naɨwimɨkile pang’wanso wɨkamʉkʉa ʉ Yesʉ ikopi mʉʉsʉ wazekalʉnga, “Itɨɨ, Ʉʉne yakʉmʉsʉkɨɨlya mʉpolyi nʉ mʉkʉlʉ?”<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />Yesʉ wɨkamʉsʉkɨɨlya, “Anga itule ntambʉe ʉbɨ, kumʉʉla ʉbɨ nʉwanso nɨntambʉe, ingɨ angaitule ntambue ɨtai, nɨkɨgwa ʉkʉnkʉa?”<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />Sʉnga, Yesʉ wakaze ʉtungilwe ndigi, ʉ Anasi wɨkamʉtala kʉng’wa Kayapa mʉpolyi nʉ mʉkʉlʉ.<verse eid="JHN 18:24" /></para>
  <para style="s">Petelo ʉkʉmʉhita hangɨ ʉ Yesʉ</para>
  <para style="r">
    <ref loc="MAT 26:71-75">Matayo 26:71-75</ref>; <ref loc="MRK 14:69-72">Maliko 14:69-72</ref>; <ref loc="LUK 22:58-62">Lʉka 22:58-62</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Itungo nɨlanso Simoni Petelo aɨwɨmɨkile wazota ʉmoto. Nɨang’wɨ naɨakolɨ pang’wanso ɨkamʉkolya, “Itɨɨ, nʉewega ingɨ wɨʉng’wɨ mʉamanyisigwa akwe?” Nʉwanso wɨkahita wɨkalʉnga, “Aa ʉnene shanga nɨmʉmanyisigwa wakwe!” <verse eid="JHN 18:25" /><verse number="26" style="v" sid="JHN 18:26" />Mʉtʉng’wa ʉng’wɨ nʉwa Mʉpolyi nʉ mʉkʉlʉ, mʉnyandʉgʉ wang’wa mʉntʉ ʉyo naɨʉtemilwe kʉtwɨ nʉ Petelo, wɨkamʉkolya, “Itɨɨ, ʉnene shanga aɨnʉkʉine ʉwewe kʉkɨbuulya ʉkazemine palʉng’wɨ nʉng’wenso?” <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />Petelo wɨkahita hangɨ, sʉnga nsambaligʉgʉ ɨkakʉnkʉla.<verse eid="JHN 18:27" /></para>
  <para style="s">Yesʉ ʉkʉtalwa kʉng’wa Pilato</para>
  <para style="r">
    <ref loc="MAT 27:1-2">Matayo 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Maliko 15:1-5</ref>; <ref loc="LUK 23:1-5">Lʉka 23:1-5</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Aidaʉ nɨnkɨlʉ, Papo atongeeli a Ayahudi ɨkamʉhola Yesʉ kʉpuma kʉng’wa Kayapa, ɨkamʉtwala kʉnyʉmba a mʉtemi nʉwa Alumi. ipolyo. Atongeeli a Ayahudi shanga ɨkingila mʉnyʉmba nanso, kʉnsoko shanga aɨaloilwe kikanza kʉnsoko ahume kʉlya ndya niya pasaka. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Kʉlʉlo, ʉ Pilato wɨkapuma kʉnzi naɨakolɨ wɨkaakolya, “Mʉkʉmʉsemela kigazo kɨɨ ʉmʉntʉ ʉyʉ?”<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Nɨanso ɨkamʉsʉkɨɨlya, “Mʉntʉ ʉyʉ anga azaize shanga ʉgazilye, shanga aza kɨzemʉleta kʉng’wako.”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />Pilato wɨkaaɨla, “Aligwa, mʉholi, mʉpɨsɨɨlyi nyenye kʉkɨɨla malagɨɨlyo anyu.” Ayahudi ɨkamʉsʉkɨɨlya, “Ʉsese kɨagila anga ʉhumi nʉwa kʉmʉbʉlaga mʉntʉ wɨhi.” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Aɨatambʉ iti ɨhume kʉtimɨla mʉloto ʉ Yesʉ naɨʉmɨlotile ɨnsha nʉzɨɨzashɨla.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />Kʉlʉlo Pilato wɨkingɨla hangɨ mʉnyʉmba akwe nakɨtemi, wɨkalagɨɨlya ʉ Yesʉ waletwe kʉng’wakwe, wɨkʉmʉkolya. “Ʉewe wɨ Mʉtemi nʉwa Ayahudi?”<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />Yesʉ wɨkamʉsʉkɨɨlya “Itɨɨ, Ʉkʉkolya nkani izi kʉmasɨgo akone ang’wi ʉtambʉɨwe nɨantʉ nkani yane?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />Pilato wɨkamʉsʉkɨɨlya, “Ʉsɨgile ʉnene nɨ Muyahudine ang’wɨ shangaʉʉ? Antʉ ako ʉewe nɨ apolyi nɨakʉlʉ winkɨɨligwa kʉng’wane. Igazo kɨ nʉwitʉmile<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />Yesʉ wɨkamʉsʉkɨɨlya, “Utemi wane shanga wamihɨɨ ɨyɨ. Anga ɨza ʉtemi wane wamihɨɨ ɨyɨ, ahemba ane aɨazee ninkʉɨlya ndeke kʉambwa nɨ Ayahudi. ingɨ anga nɨyɨlɨ ʉtemi wane shanga ʉpumile mʉnʉ mihɨɨ.”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Pilato wɨkamʉkolya, “Kʉlʉlo, ʉewe wɨmʉtemine?”</para>
  <para style="p" vid="JHN 18:37">Yesʉ wɨkasʉkɨɨlya, “Ʉewe ʉkʉlʉnga kɨna ʉnene nɨmʉtemi. Kʉndogoelyo ɨyɨ ʉnene aɨntugilwe kʉnsoko yɨyo, nɨze mʉʉnkumbigʉlʉ kʉatambʉɨla antʉ ɨtai. Mʉntʉ wɨhi nʉwatai wija ʉlʉli lane.”<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />Pilato wɨkamʉkolya ʉ Yesu, “Tai lɨntʉnigwa?</para>
  <para style="s" vid="JHN 18:38">Yesʉ ʉkʉpɨsɨligwa kʉsha</para>
  <para style="r" vid="JHN 18:38">
    <ref loc="MAT 27:15-31">Matayo 27:15-31</ref>; <ref loc="MRK 15:6-20">Maliko 15:6-20</ref>; <ref loc="LUK 23:13-25">Lʉka 23:13-25</ref></para>
  <para style="p" vid="JHN 18:38">Sʉnga ʉ Pilato naɨwakondya kʉtambʉla nanso, wɨkapuma hangɨ kʉnzi wɨkaaɨla atongeeli awo nɨa Ayahudi naɨ amʉsemee ʉ Yesʉ, “Shanga namʉonelya igazo lɨhi nʉtendile ʉmʉntʉ ʉyʉ. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />Ingɨ ʉnyenye mʉkete ntendo anyu kɨna itungo liloelya nɨla Pasaka ʉnene nʉmʉtunguɨle mʉtungwa ʉng’wɨ nɨmʉmʉloilwe. Ʉʉgwa, mʉloilwe nʉmʉtungʉɨlye ʉyʉ ‘Mʉtemi nʉwa Ayahudine?’<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />Nɨanso ɨkitʉnta ɨkalʉnga, “A,a! Shanga mʉntʉ ʉyʉ ingɨ mʉlugʉɨle Balaba!” Balaba nʉwanso aɨwɨhegelanya maintʉ.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="s">Yesʉ ʉkʉlamʉlwa kʉkonontelwa mʉ mʉsalaba</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Papogwa ʉ Pilato wɨkalagɨɨlya amʉhole ʉ Yesʉ amʉkʉe mɨsheleti. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Amboi nawo ɨkapotya ngala amija, ɨkamʉtugalya mitwe, ɨkamʉtugalya mʉjʉlʉngʉ nʉwa kɨtemi nʉwa ʉkengo nʉwa zambalaʉ. <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />Ɨkatula kisʉkɨɨla kʉnankɨla apo naɨʉkolɨ mizʉmba nɨla kɨtemi, azelʉnga, “Mɨlamʉ! Mʉtemi nʉwa Ayahudi!” Kʉnʉ azemʉkʉa makopi mʉʉsʉ.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Pilato wɨkapuma hangɨ kʉnzi, wɨkaaɨla, “Kolwi, namʉletela ʉ Yesʉ mʉlɨnge kɨna ʉnene shanga nʉmʉoneeye anga igazo lɨhi.” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Kʉlulo, Yesʉ wɨkapuma kʉnzi wakaze ʉtugae ngala amija nʉ mʉjʉlʉngʉ nʉwa kɨtemi nʉwa ʉkengo nʉwa zambalaʉ. Pilato wɨkaaɨla, “Kolwi! Mʉntʉ wanyu sʉyʉ apa nʉanso.”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Apolyi nɨakʉlʉ nɨ alili a Nyʉmba ang’wi Itunda naɨamʉona ɨkitʉnta, azelʉnga “Mʉmʉtʉmbɨke mʉ mʉsalaba! Mʉmʉtʉmbɨke mʉ mʉsalaba!”</para>
  <para style="p" vid="JHN 19:6">Pilato wɨkaaɨla, Mʉholi nyenye akola, mende mʉmʉtʉmbɨke, ʉ nene shanga nʉmʉoneeye anga igazo lɨhi nɨla kʉlamʉla watʉmbɨkwe.”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />Ayahudi ɨkamʉsʉkɨɨlya, “Ʉsese kʉkete malagɨɨlyo, hangɨ kʉkɨɨla malagɨɨlyo nanso, ʉtakɨwe washe, kʉnsoko ng’wenso ʉkitendisa kɨna Ng’wana wang’wi Itunda.”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Pilato naɨwija itɨ wɨkogopa nangaluu. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />Pilato wɨkamʉhola ʉ Yesʉ wɨkingɨlania mʉnyʉmba, wɨkamʉkolya, “Ʉewe ʉpumɨɨe pɨ?”</para>
  <para style="p" vid="JHN 19:9">Ingɨ Yesʉ shanga wɨkamʉsʉkɨɨlya. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />Pilato wɨkamʉɨla, “Ʉewe ʉkʉhita kʉligitya nʉnene? Shanga ʉlɨngile kɨna nkete ʉhumi nʉwa kʉʉlekela ang’wɨ ʉhumi nʉwa kʉʉtʉmbɨka mʉ mʉsalaba?”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />Papo ʉ Yesʉ wɨkamʉsʉkɨɨlya, “Ʉewe azaʉzetula wɨmʉgila anga ʉhumi wɨhi kʉng’wane anga ɨze shanga ʉpewe kʉpuma kigʉlʉ. Kʉlʉlo, ʉyo nʉmbɨkile ʉnene mʉmɨkono ako ʉkete igazo ikʉlʉ nangalu.”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Puma itungo lɨlo, Pilato wɨkatuladuma nzɨla akʉmʉlekela ʉ Yesʉ, ingɨ Ayahudi ɨkalongoleka kitʉnta azelʉnga, “Anga ʉmʉlekele mʉntʉ ʉyʉ, ʉewe shanga wɨmʉhʉmbamʉya wang’wa Kaisali, mʉntʉ wɨhi nʉkitendisa kɨna Mʉtemi wɨmikʉngʉma nʉ Kaisali!”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Pilato naɨwija nkani izi wɨkamʉpumya Yesʉ kʉnzi hangɨ wɨkikiɨ mituntu lakwe nɨla ʉlamʉli, nkika niitangwa “Igwe nɨlɨʉgɨɨigwe” kʉntambʉ a Kiebulania, itanga Gabata. <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Itɨgwa aɨlʉhikʉ lakʉnɨng’anɨlya iloelya nɨla Pasaka, anga saa mʉtandatʉ itɨ, Pilato wɨkaaɨla Ayahudi, “Mʉtemi wanyu sʉyʉ apa!”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Nɨanso ɨkitʉnta, “Mʉheje! Mʉheje! Mʉtʉmbɨke mʉ mʉsalaba!”</para>
  <para style="p" vid="JHN 19:15">Pilato wɨkaakolya, “Itɨɨ, Nʉmʉtʉmbɨke mʉ mʉsalaba mʉtemi wanyu?”</para>
  <para style="p" vid="JHN 19:15">Apolyi nɨakʉlʉ ɨkasʉkɨɨlya, “Ʉsese kɨagila anga Mʉtemi nʉmʉngɨɨza ingɨ ʉ Kaisali du!”<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />Ʉʉgwa Pilato wɨkainkɨɨlya ʉ Yesʉ enso amʉtʉmbɨke mʉ mʉsalaba.</para>
  <para style="s" vid="JHN 19:16">Yesʉ ʉkʉtʉmbɨkwa mʉ mʉsalaba</para>
  <para style="r" vid="JHN 19:16">
    <ref loc="MAT 27:32-44">Matayo 27:32-44</ref>; <ref loc="MRK 15:21-32">Maliko 15:21-32</ref>; <ref loc="LUK 23:26-43">Lʉka 23:26-43</ref></para>
  <para style="p" vid="JHN 19:16">Ʉʉgwa ɨkamʉhola ʉ Yesʉ. <verse eid="JHN 19:16" /><verse number="17" style="v" sid="JHN 19:17" />Yesʉ wɨkahega waze ʉkenkile mʉsalaba wakwe kʉloma nkɨka nitangwa “Ing’ang’a” kʉntambʉ a Kɨebulania ingɨ Goligota. <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Pang’wanso papo aɨamʉtʉmbɨkile mʉmʉsalaba. Antʉ aʉya abɨɨlɨ aɨatʉmbɨkilwe palʉng’wɨ nʉng’wenso, ʉng’wɨ mʉmʉsalaba wakwe aɨʉkoli ipande la kɨkɨma nʉmʉya mʉsalaba wakwe aɨʉkolɨ ipande la kɨgoha nɨlang’wa Yesʉ. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />Pilato wɨkaandɨka mʉkɨbada, “Yesʉ Mʉnazaleti, Mʉtemi nʉwa Ayahudi.” wɨkaɨka migʉlya amʉsalaba wang’wa Yesu. <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />Ayahudi ɨdʉ aɨasomile ʉandɨkwa ʉwʉ naɨ ʉandɨkilwe mʉkɨbada. Kʉnsoko nkɨka nanso naɨʉtʉmbɨkilwe Yesʉ aɨpakupɨ nɨkɨsalɨ, ʉandɨkwa ʉwʉ andɨkilwe kʉntambʉ a Kɨebulania nɨ Kɨlatini nɨ Kigiliki. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Apolyi nɨakʉlʉ ɨkamʉɨla ʉ Pilato, “Leka kʉandɨka, ‘Mʉtemi nʉwa Ayahudi,’ ingɨ andɨka kɨna, mʉntʉ ʉyʉ aɨʉliiye, ‘Ʉnene nɨ mʉtemi nʉwa Ayahudi.”’<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Pilato wɨkasʉkɨɨlya, Nɨnakɨandɨka, naandɨka!”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Amboi naɨakondya kʉmʉtʉmbɨka mʉmʉsalaba ʉ Yesʉ, ɨkahola matugalo akwe, ɨkatemanʉla maganda annɨ, iganda lɨng’wɨ kʉ mʉmboi ʉng’wɨ. Ingɨ ɨkigombya aleke kʉtamʉla mʉjʉlʉngʉ wakwe kʉnsoko aɨgila anga ʉtumɨlo ingɨ aɨlɨtumilwe kʉpuma kigʉlya kʉpikɨla pihɨ. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Amboi nɨanso ɨkisɨja, “Kʉleke kʉmitamʉla, kʉkʉe bʉnkʉlʉ bʉnkulʉ kʉlamʉla nyenyu nʉʉkalɨhola.” Ikani nɨlanso aɨlitendekile ɨhume kʉpikɨɨla Ʉandɨkwa nʉʉlʉngile,</para>
  <para style="q1" vid="JHN 19:24">Aɨagalanile matugalo ane,</para>
  <para style="q2" vid="JHN 19:24">nʉmʉjʉlʉngʉ wane ɨkakʉɨla bʉnkʉlʉ bʉnkʉlʉ.”</para>
  <para style="m" vid="JHN 19:24">Ʉʉgwa, aɨatendile amboi nɨanso. <verse eid="JHN 19:24" /><verse number="25" style="v" sid="JHN 19:25" />Itungo lɨlo lɨɨlo pakupe nʉmʉsalaba wang’wa Yesʉ aɨɨmɨkile, nyinya ʉ Malia nʉ Malia mʉluna wang’wa nyinya, nɨɨza mʉkɨma wang’wa Kileopa, nʉ Malia msʉngʉ kʉpuma kʉ Magidala. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Yesʉ naɨwamʉona nyinya pang’wanso palʉng’wɨ nʉ mʉmanyisigwa ʉyo naɨ ʉmʉloilwe ɨmɨkile pakupɨ wɨkamʉɨla ʉnyinya, “Iya, Mʉgoze, ng’waako sʉyo papo,”<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />Sʉnga Yesʉ wɨkamʉɨla nʉ mʉmanyisigwa nʉanso, “Nʉewe, Mʉgoze, iyaako sʉyo papo.” Kʉpuma itungo lɨlo mʉmanyisigwa nʉwanso wɨkamʉhola ʉnyinya wang’wa Yesʉ ende ikalanie kitolakwe.<verse eid="JHN 19:27" /></para>
  <para style="s">Yesʉ ʉkʉsha</para>
  <para style="r">
    <ref loc="MAT 27:45-56">Matayo 27:45-56</ref>; <ref loc="MRK 15:33-41">Maliko 15:33-41</ref>; <ref loc="LUK 23:44-49">Lʉka 23:44-49</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Naɨyakɨla nanso, Yesʉ naɨwalɨnga kɨna makani ɨhi aɨakondanɨɨla, ingɨ nʉʉandɨkwa ʉkondanɨɨle, wɨkalʉnga, “Nahung’wa nyota.”<verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />Pang’wanso aɨlʉkolɨ lʉkulu lizʉe kɨlʉʉlwɨ, kʉlʉlo ɨkatoelya siponshi mʉkɨlʉʉlwɨ nɨkanso, ɨkahepya siponshi nanso mʉlʉkito nʉla mʉlʉɨ, ɨkamʉunzɨlya mʉmʉlomo. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Yesʉ naɨnuna ɨkɨlʉʉlwɨ nɨkanso wɨkalʉnga, “Namala ʉ mʉlɨmo,” wɨkinamya itwe, wɨkasekeela.<verse eid="JHN 19:30" /></para>
  <para style="s">Mʉmboi ʉkʉmʉhoma Yesʉ ndilima palʉbalu</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Kʉnsoko aɨlʉhikʉ nʉlakihamba kʉ Lʉhikʉ nʉla kʉsupya, Ayahudi shanga aɨatakile mɨimba ɨsage mʉ mɨsalaba Lʉhikʉ nʉla Kʉsupya nʉ kipolya, kɨkʉlʉ kʉnsoko Lʉhiku nʉlanso aɨlʉgwɨɨe mʉ mɨloeelya nɨla Pasaka. Ayahudi ɨkamʉlompa ʉ Pilato walagɨɨlye mɨgʉlʉ aantʉ ɨhi ibunangwe nɨ mɨimbao ɨhegigwe mʉ mɨsalaba. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Kʉlʉlo amboi ɨkalongola ɨkabunanga mɨgʉlʉ amʉntʉ nʉwa ng’wandyo kʉtʉmbɨkwa mʉ mʉsalaba nʉ Yesʉ palʉng’wɨ nʉ mʉya ga. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Ingɨ naɨapika kʉng’wa Yesʉ ɨkaona kɨna wakuza, kʉlʉlo shanga ɨkamʉbunanga ɨmɨgʉlʉ akwe. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Kimɨkɨɨli kakwe mʉmboi ʉng’wɨ wɨkamʉhoma ndilima mʉlʉbalu, papo paapo ɨkapuma sakami nɨ mazɨ. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />Mʉntʉ naɨwiloee makani nanso nakʉpumɨla yʉyo ʉganʉe ingɨ mʉhume kʉhʉɨɨla, ʉganʉli wakwe ingɨ ɨtai. Ʉlɨngile kɨna ʉkʉtambʉla ɨtai, nʉyo ʉkʉganʉla nʉ nyenye mʉhume kʉhʉɨɨla. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Kʉnsoko makani aya aɨapumɨɨe ingɨ Ʉandikwa ʉhume kʉkondanɨɨla, ayo nalʉngile, “Kʉtilɨ anga ikupa lakwe lɨhi nɨlɨkʉbunangwa.” <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />Ʉandɨkwa ʉʉya alɨɨye hangɨ, “Akʉmʉgoza ʉyo naɨamʉhomile ɨndilima.”<verse eid="JHN 19:37" /></para>
  <para style="s">Yesʉ ʉkʉɨkwa</para>
  <para style="r">
    <ref loc="MAT 27:57-61">Matayo 27:57-61</ref>; <ref loc="MRK 15:42-47">Maliko 15:42-47</ref>; <ref loc="LUK 23:50-56">Lʉka 23:50-56</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Naɨyakɨla nanso, Yusupu, mʉnya kʉ Alimataya, naɨmʉmanyisigwa wang’wa Yesʉ, kʉ kɨnkunku kʉnsoko aɨʉogopile ɨ Ayahudi, wɨkamʉlompa ʉ Pilato wamʉgombye kʉʉhola mʉimba wang’wa Yesʉ, Pilato wɨkamʉgombya. Ʉʉgwa wɨkenda wɨkaʉhola. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Nikodemo ʉyʉ naɨʉmʉtyatile ʉ Yesʉ ʉtikʉ, nʉyo wɨkaza waze ʉhalɨnkanilye manemane nɨmanyunkɨɨlyo, akete ʉlito nʉwa kilo salasini. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Ɨkaʉkenka mʉimba wang’wa Yesʉ, ɨkamʉtunga shanda palʉng’wɨ nʉ kʉmʉpaka manyunkɨɨlyo anga ɨntendo Ayahudi pa akʉɨka. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Itɨgwa aɨkɨmolɨ kɨbuulya pakupɨ napo naɨ ʉtʉmbɨkilwe ʉ Yesʉ, mʉkɨbuulya nɨkanso aɨkɨmolɨ kɨbɨɨla kɨpya naɨkɨkɨlɨ kʉɨkwa mʉntʉ. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Kʉlʉlo, kʉnsoko aɨlʉhikʉ Ayahudi nɨakolɨ mʉʉnɨng’anɨlyi nʉwa Lʉhikʉ nʉla kʉsupya, hangɨ ikɨbɨɨla nɨkanso aɨkɨkolɨ pakupɨ, ɨkamʉɨka mʉmo ʉ Yesʉ.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">Yesʉ ʉkiʉka</para>
  <para style="r">
    <ref loc="MAT 28:1-8">Matayo 28:1-8</ref>; <ref loc="MRK 16:1-8">Maliko 16:1-8</ref>; <ref loc="LUK 24:1-12">Lʉka 24:1-12</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Daʉ nɨnkʉlʉ lʉhikʉ la ng’wandyo nɨla wiki, kiti aɨkɨkɨlɨ kitumile, Malia kʉpuma kʉ Magidala aɨwendile pakɨbɨɨla, wɨkahanga igwe lɨmʉtile pa kɨbɨɨla. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Ʉʉgwa wɨkipatɨɨlya kɨza kʉng’wa Simon Petelo palʉng’wɨ nʉmʉmanyisigwa ʉyo Yesʉ naɨʉmʉloilwe, wakaze ʉmankile nʉkʉlʉnga, “Aʉheja ʉ mʉimba wang’wi Isekʉlʉ mʉkɨbɨɨla, hangɨ shanga kʉlɨngile kʉaɨkile mʉimba wakwe.”<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Petelo nʉmʉmanyisigwa ʉyo nʉmʉngɨza ɨkakaya kʉhega kʉloma kʉkɨbɨɨla. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Ɨhi mʉʉbɨlɨ wao aɨakʉmanka, ingɨ mʉmanyisigwa ʉyo nʉmʉngɨza aɨʉmankile nangulu kʉkɨla Petelo, wɨkatongela kʉpika pakibɨɨla. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Naiwapika wɨkatuna nʉkʉhʉngɨɨla mʉng’wanso mʉkɨbɨɨla, wɨkamɨona ɨshanda du ɨɨkilwe, ingɨ shanga aɨwingɨe. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Ʉʉgwa Simon Petelo wɨkapika, wɨkaze ʉmʉtyatɨe, wɨkatongolomoka mʉkʉbɨɨla wɨkamɨona ɨshanda du pang’wanso pihɨ, <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />Nʉmʉkako Yesʉ naɨ ʉtungilwe mitwe. Mʉkako nʉwanso aɨwipʉnyangie ʉdu kɨtemanʉwe nɨshanda. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Sʉnga mʉmanyisigwa ʉyo naɨʉtongee kʉpika pakɨbɨɨla nʉng’wenso wɨkingɨla mʉkɨbɨɨla, wɨkaona nʉkʉhʉɨɨla. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Kʉnsoko kʉpikɨɨla itungo nɨlanso aɨakɨlɨ kʉlɨnga ʉandɨkwa natanbʉe kina aɨitakɨwe ʉ Yesʉ wiʉke kʉpuma kʉashi. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Sʉnga amanyisigwa nɨanso ɨkatulya kito.<verse eid="JHN 20:10" /></para>
  <para style="s">Yesʉ ʉkigela kʉng’wa Malia nʉakʉ Magidala</para>
  <para style="r">
    <ref loc="MAT 28:9-10">Matayo 28:9-10</ref>; <ref loc="MRK 16:9-11">Maliko 16:9-11</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Ingɨ Malia nʉwakʉ Magidala aɨwɨmɨkile wɨzelɨla pakupɨ nɨkɨbɨɨla. Naɨ ʉkʉlɨla, wɨkatuna wɨkahʉngɨɨla mʉkɨbɨɨla, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />nung’wenso wɨkaaona amalaɨka abɨɨlɨ atugae matugalo melʉ, ɨkie apo nʉmʉɨlɨ wang'wa Yesʉ naɨ ʉlalɨshigwe, ʉng’wi kitwe nʉmʉya kʉmɨgʉlʉ. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />Ɨkamʉkolya, “Mʉsʉngʉ, ʉkʉlɨla ntʉni?”</para>
  <para style="p" vid="JHN 20:13">Wɨkaaɨla, “Kʉlɨla kʉnsoko aʉheja ʉmʉɨlɨ wang’wi Isekʉlʉ wane hangɨ shanga mine nɨamʉɨkile”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />Naɨ watambʉla nanso, wɨkikeya, wɨkamʉona Yesʉ wimɨkile, ingɨ shanga wɨkamʉlɨnga. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />Yesʉ wɨkamʉkolya, “Mʉsʉngʉ, nɨkɨ ʉkʉlɨla? Ʉkʉmʉduma nyenyu?”</para>
  <para style="p" vid="JHN 20:15">Malia, aɨʉsɨgile kɨna naza yɨkitambʉlya ingɨ mʉlindɨɨla kɨbuulya, kʉlʉlo wɨkamʉɨla, mʉkʉlʉ, angaɨtule wewe ʉmʉhegilye, itʉnʉ ndagɨɨle nʉʉmʉɨkile, nʉnene kʉmʉhola.”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />Yesʉ wɨkamʉɨla, “Malia!”</para>
  <para style="p" vid="JHN 20:16">Papogwa ʉ Malia wɨkikeya, wɨkamʉɨla kʉntambʉ a Kiebulania, “Laboni” Ng’waao Mumanyisi.<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />Yesʉ wɨkamʉɨla, “Leka kʉmamba, ndogoelyo nkɨlɨ kʉluma kʉlongola kʉng’wa Tata. Ingɨ longola kʉaluna ane ʉatambʉɨle, ‘nongoe kʉng’wa Tata hangi Tata wanyu, kʉng’wi Itunda wane ni Itunda wanyu.”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />Kʉlʉlo Malia nʉwakʉ Magidala wɨkalongola wɨkaaganʉɨla amanyisigwa ang’wa Yesʉ wazelʉnga “Namʉona Isekʉlʉ!” sʉnga wɨkaaɨla kɨna Yesʉ aɨʉmʉtambʉɨe nanso.<verse eid="JHN 20:18" /></para>
  <para style="s">Yesʉ ʉkigela kʉamanyisigwa akwe</para>
  <para style="r">
    <ref loc="MAT 28:16-20">Matayo 28:16-20</ref>; <ref loc="MRK 16:14-18">Maliko 16:14-18</ref>; <ref loc="LUK 24:36-49">Lʉka 24:36-49</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Yɨkatula mpindi a lʉhikʉ lang’wandyo nʉlipolyo, Amanyisigwa akwe naɨakolɨ palʉng’wɨ, mɨlango aɨilugaɨwe kʉnsoko aɨaogopile atongeeli Ayahudi. Yesʉ wɨkaigeela, wɨkimɨka pakatɨao, wɨkalʉnga, “Mʉtule nɨ Matiliga” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Naiwakondya kʉtambʉla nanso, wɨkaalagɨla mɨkono akwe nʉlʉbalu lakwe. Amanyisigwa akwe ɨkiloa nangalu naɨamʉona Isekʉlʉ. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />Yesʉ wɨkaaɨla hangɨ, “Mʉtule nɨmatiliga! Angaʉʉ Tata naɨʉntʉmile ʉnene, nʉneneʉʉ kʉmʉtʉma ʉnyenye.” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Nʉng’wenso naɨwakondya kʉtambʉla itɨ, wɨkaapembela mɨhupo, wɨkaaɨla, “Sɨngɨɨlyi Ng’wahʉ Ng’welʉ. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Angamʉalekele antʉ ɨhi mɨlandʉ, antʉ nɨanso akʉlekelwa, hangɨ anga mʉhite kʉalekela mɨlandʉ, akʉsaga nɨmɨlandʉao.”<verse eid="JHN 20:23" /></para>
  <para style="s">Yesʉ ʉkigela kʉng’wa Tomaso</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Ingɨ ʉ Tomaso naɨwitangwa Disimasi, ingɨ, itʉtɨ, aɨʉmolɨ mʉao ikʉmi naabɨɨlɨ shanga aɨwɨkʉtile itungo Yesʉ nawaza. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Ʉʉgwa, amanyisigwaao nɨangɨza ɨkamʉɨla, “Kamʉona Isekʉlʉ.” Ingɨ nʉwanso wɨkaaɨla,</para>
  <para style="p" vid="JHN 20:25">“Anga nihite kʉona mʉmɨkono akwe makombo amɨsumali naɨ ʉkonontewe nʉkʉpalapatya mʉmakombo nanso, nʉmʉkono wane mʉlʉbalu lakwe, kwe shanga kʉhʉɨɨla”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Naɨyakɨla mahikʉ mʉnana, amanyisigwa akwe aɨakolɨ palʉng’wɨ hangɨ mʉnyʉmba nanso, Tomaso nʉyo aɨʉmolɨ. Yesʉ wɨkaza mɨlango aɨ ilugaɨwe, wɨkimɨka pakati ao, wɨkalʉnga, “Mʉtule nɨ matiliga” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Sʉnga wɨkamʉɨla ʉ Tomaso, “Leta shala kako apaitɨ hangɨ ʉmɨgoze mɨkono ane, goola mʉkono wako ʉpapatye mʉlʉbalu lane. Ʉleke kikankania, ingɨ hʉɨɨla ʉdu.”<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />Tomaso wɨkamʉɨla, “Isekʉlʉ wane ni Itunda wane!”.<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />Yesʉ wɨkamʉɨla, “Wahʉɨɨla kʉnsoko wamonane? Akʉkembetwa awo nɨakɨlɨ kʉmona, ingɨ ahʉɨɨe”<verse eid="JHN 20:29" /></para>
  <para style="s">Nsoko akandɨkwa mbugulu ɨyɨ</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Yesʉ aɨwitʉmile ilɨngasɨɨlyo iʉya dʉ kʉamanyisigwa akwe, nɨshanga yandɨkilwe mʉmbugulu ɨyɨ. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Ingɨ aya andɨkilwe mʉhume kʉhʉɨɨla kɨna ʉ Yesʉ yʉyʉ Kilisito, Ng’wana wang’wi Itunda hangɨ kʉmʉhʉɨɨla ng’wenso mʉhume kʉlija ʉpanga nʉwa kalɨna kalɨ nʉʉmolɨ mʉng’wakwe.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">Yesʉ ʉkigela kʉamanyisigwa mʉpungatɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Naɨyakɨla nanso, Yesʉ wɨkaigeela hangɨ amanyisigwa akwe kʉmpelo alʉzɨ nʉlʉkʉlʉ nʉla Tibelia. Aɨwigelekilye itɨ. <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Simon Petelo nʉ Tomaso nʉwitangwa Disimasi, ingɨ itʉtɨ, nʉ Natanaeli mʉnya kʉ Kana akʉ Galilaya nɨ ana ang’wa Zebedayo nɨamanyisigwa aʉya abɨɨlɨ, ɨhi aɨakolɨ palʉng’wɨ. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />Simon Petelo wɨkaaɨla aʉya, ʉnene naʉka nendebua nsamaki.”</para>
  <para style="p" vid="JHN 21:3">Nɨenso ɨkamʉɨla, “Kʉʉlongolania nʉewe.” Ɨkapuma ɨkingɨla mibɨnɨ, ingɨ ʉtikʉ nʉwanso shanga ɨkapantɨka kɨntʉ kɨhi. <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />Naɨwakeleela, Yesʉ wɨkimɨka pampelo alʉzɨ, ingɨ amanyisigwa shanga ɨkamʉlɨnga kɨna aɨ Yesʉ. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />Yesʉ wɨkaaila, “Ahʉmba ane, itɨɨ, mʉketene insamaki?</para>
  <para style="p" vid="JHN 21:5">Ɨkamʉsʉkɨɨlya, “A! a! Shanga kʉligilye anga kɨntʉ”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />Yesʉ wɨkaaɨla, “Gʉmɨli nyabu ipande nɨla kigoha nɨlibɨnɨ lanyu nʉnyenye mʉkʉpantɨka nsamaki.” Nawo ɨkagʉmɨla nyabu ipande nɨlanso, ingi kolwa ɨkapantɨka nsamaki yɨdʉ tai ɨkaleng’wa kʉlutɨɨla ɨnyabu mibɨnɨ kʉnsoko aɨyizʉe nsamaki.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Itɨgwa mʉmanyisigwa ʉyo nʉ Yesʉ aɨʉmʉloilwe wɨkamʉɨla Petelo, “Halɨɨ! Ʉyʉ ingɨ Isekʉlʉ!” Simon Petelo naɨwija itɨ, wɨkitunga itugalo lakwe kʉnsoko aɨwɨkɨpwɨ, nʉyo wɨkigʉmila mʉmazɨ. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Ingɨ amanyisigwa awo nɨangɨza naɨ akolɨ pakupɨ kitʉmbɨ, anga mita igana lɨng’wɨ, ɨkɨza pibɨnɨ nɨlanso kʉnʉ ɨkaluta inyabu niizʉe nsamaki, shanga aɨkʉlɨ nʉkʉpuma mʉlʉzɨ. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Naɨ apuma kitʉmbɨ ɨkaona mʉkala wakɨigwe, nɨmigʉlya akwe nsamaki iasilwe nʉ mʉkate. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />Yesʉ wɨkaaɨla, “Leti apaitɨ nsamaki nkeehʉ nɨmʉbuile.”<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />Kʉlʉlo ʉ Simon Petelo wɨkanankɨla mibɨnɨ, wɨkamɨluta nyabu nanso nizʉe nsamaki ninkʉlʉ, wɨkamɨpumya kitʉmbɨ, aɨipikɨɨe nsamaki igana lɨng’wɨ nimakʉmi ataano naitaatʉ. Palʉngwi nɨ kɨna nsamaki aɨyɨdʉ itɨ, nyabu shanga aɨɨtamʉkile. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />Yesʉ wɨkaaɨla, “Pembyi mʉtikole.” Ingɨ kʉtile anga mʉntʉ wɨhi naɨʉgemile kʉmʉkolya, “Winyenyu ʉewe?” kʉnsoko aɨalɨnga kɨna ingɨ Isekʉlʉ. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Yesʉ wɨkalongola wɨkahola mʉkate nʉwanso, wɨkaapa, hangɨ wɨkatendaʉʉ nɨ nsamaki niiasile.<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />Iyɨ aɨnkʉa akataatʉ ʉ Yesʉ kigeeleka kʉamanyisigwa akwe kʉpuma naɨ kʉpuma kʉ wiʉka.<verse eid="JHN 21:14" /></para>
  <para style="s">Yesʉ ʉkʉmʉlekela malagɨɨlyo Petelo</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Naɨ akondya kʉlya, Yesʉ wɨkamʉkolya ʉ Simon Petelo, “Simon ngw’ana wang’wa Yohana, Itɨɨ, ʉndoilwe ʉnene kʉkɨla awa?” Nʉyo wɨkasʉkɨɨlya,</para>
  <para style="p" vid="JHN 21:15">“Ee, Isekʉlʉ, ʉewe ʉlɨngile kɨna nʉkʉloilwe.” Yesʉ wɨkamʉɨla, “Lɨsa ɨanankolo ane.” <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />Yesʉ wɨkamʉɨla hangɨ, “Simon ng’wana wang’wa Yohana, ʉndoilwene?”</para>
  <para style="p" vid="JHN 21:16">Petelo wɨkamʉsʉkɨɨlya, “Ee, Isekʉlʉ, ʉewe ʉlɨngile kɨna nʉkʉloilwe.”</para>
  <para style="p" vid="JHN 21:16">Yesʉ wɨkamʉɨla, “Isʉnje inkolo yane.” <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />Yesʉ wɨkamʉkolya nkʉa a akataatʉ Petelo, “Simon ng’wana wang’wa Yohana, Itɨɨ, ʉndoilwene ʉnene?”</para>
  <para style="p" vid="JHN 21:17">Petelo wɨkahʉsha nangalu kʉnsoko Yesʉ ʉmʉkoiye nkʉa akataatʉ, “Ʉndoilwene?” Wɨkamʉɨla, “Isekʉlʉ, ʉewe ʉlɨngile ɨhi, ʉlɨngile kɨna nʉkʉloilwe.”</para>
  <para style="p" vid="JHN 21:17">Yesʉ wɨkamʉɨla, “Lɨsa inkolo yane. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Kʉʉtambʉɨla ɨtai, naɨʉkɨlɨ wɨmʉhʉmba aɨwitunga ʉewe nʉkʉlongola pɨhi nʉʉloilwe. Ingɨ anga ʉnyampaale ʉkʉgoola mɨkono ako, nʉ mʉntʉ mʉngɨɨza ʉkʉʉtugalya nʉkʉʉtala kʉshanga ʉloilwe kʉlongola.” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />Yesʉ aɨʉtambʉe aya kʉlagɨɨla nsha nʉʉzɨzashɨla ʉ Petelo ingɨ kʉmʉpa Itunda ʉkʉlʉ. Sʉnga Yesʉ wɨkamʉɨla ʉ Petelo, “Ntyate!”<verse eid="JHN 21:19" /></para>
  <para style="s">Yesʉ nʉ mʉmanyisigwa mʉngɨɨza</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Petelo wɨkapɨlʉka, wɨkamʉona mʉmanyisigwa ʉyo Yesʉ naɨ ʉmʉanzile ʉatyatile. Mʉmanyisigwa ʉyʉ, yʉyʉ naɨwiegekeeye mʉkɨkua kang’wa Yesʉ aɨakʉlya indya izo niya mpɨndɨ niya Pasaka, aɨwikiɨ pakupɨ nʉ Yesʉ nʉkʉmʉkolya, “Isekʉlʉ, nyanyu nʉzɨza kʉsuɨpa?” <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Petelo naɨ wamʉona mʉmanyisigwa nʉwanso, wɨkamʉkolya ʉ Yesʉ, “Isekʉlʉ ikani kɨɨ nɨlɨkʉmʉhanga ʉyʉ?<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />Yesʉ wɨkasʉkɨɨlya, “Anga ize ndoilwe mʉntʉ ʉyʉ wasige kʉnzɨzɨɨla, ʉtakile ntʉni? Ʉewe ntyate.”<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />Itɨgwa mpola izi yɨkenela kʉahɨɨli aʉya kɨna mʉmanyisigwa ʉyʉ shanga ʉkʉsha. Ingɨ Yesʉ shanga aɨʉtambʉe kɨna shanga ʉkʉsha. Nʉwanso aɨʉlʉngile ʉdʉ kɨna, “Anga ize ndoilwe wasige kʉnzɨzɨɨla, ʉtakile ntʉni?” Ʉewe ntyate.”<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />Ʉyʉ yʉyʉ mʉmanyisigwa ʉyo naɨwiloee makani aya hangɨ ng’wenso nʉandɨkile nkani izi. Nʉsese kʉlɨngile kɨna nʉtambʉe ingɨ ɨtai.<verse eid="JHN 21:24" /></para>
  <para style="s">Ʉmaɨɨlyo nʉwa nkani yang’wa Yohana</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Ingɨ amolɨ makani maʉya ɨdʉ ʉ Yesʉ naɨ witʉmile. Anga aɨaandɨkwe ɨhi, nsɨgɨɨe ʉnkumbigʉlʉ wɨhi shanga aɨʉzeekondela kʉkenka mbugulu yɨhi niyandɨkwe. Tai.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>