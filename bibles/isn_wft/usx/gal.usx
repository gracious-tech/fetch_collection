<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Isanzu Bible Version</book>
  <para style="h">AGALATIA</para>
  <para style="toc1">Balʉa a Mitʉmi Paʉlo kʉ Agalatia</para>
  <para style="toc2">Agalatia</para>
  <para style="toc3">Gal</para>
  <para style="mt2">BALɄA A MITɄMI PAɄLO KɄ</para>
  <para style="mt1">AGALATIA</para>
  <para style="imt">Ntongeela akwe</para>
  <para style="ip">Mbʉgʉlʉ ɨyɨ na kʉ Agalatia aɨandɨkilwe nʉ Mitʉmi Paʉlo. 1:1. Ɨyɨ ingɨ balʉa nʉ Paʉlo aɨʉandɨkɨe antʉ nɨamʉhʉɨɨe ʉ Kilisito nɨakolɨ kʉ Galatia mʉng'waka makʉmi annɨ na mʉnana nɨ makʉmi ataano na mʉpungatɨ kʉpuma kʉtugwa kʉng'wa Kilisito. Yihumɨkile Agalatia aɨishiɨ mʉkɨsalɨ ka Galatia naɨkɨtemilwe nɨ Alumi. Asomi shanga alɨngile itungo kɨɨ Paʉlo naɨʉkʉandɨka ɨbalʉa ɨyɨ, ɨdʉao mʉasomi nɨanso ahʉɨɨe kɨna ʉ Paʉlo aɨwandɨkɨe kʉ kɨsalɨ ka Epeso ang'wɨ kʉ kɨsalɨ ka Kolinto.</para>
  <para style="ip">Paʉlo aɨwandɨkile ɨbalʉa ɨyɨ ʉ antʉ nɨamʉhʉɨɨe ʉ Kilisito nɨamolɨ nkɨka akʉ Galatia nɨ Ayahudi ang'wɨ shanga Ayahudi. Aɨwandɨkile kʉhita ʉmanyisi nʉwa ʉteele nʉʉtakile antʉ nɨakʉmʉhʉɨɨe ʉ Kilisito atyate malagɨɨlyo a Kɨyahudi namolɨ milago nɨla kalɨ anga kʉtalwa kiganda kʉtyata malagɨɨlyo ang'wa Mʉsa. Aɨlɨmolɨ antʉ nɨamʉhʉɨɨe ʉ Kilisito naɨakiitanga Ayʉda ɨkaze ʉmɨɨlya ɨahʉɨɨli nɨshanga Ayahudi atalwe kiganda kʉtyata malagɨɨlyo ang'wa Musa. Hangɨ, ɨantʉ nɨanso ɨkazesosha kɨna ʉ Paʉlo ʉligɨye pɨ ʉhumi nʉwa kʉtula mitʉmi. Paulo wɨkikoola ʉwitʉmi wakwe wazenononsola mpola yakwe nkeehʉ 1:11-214, hangɨ wɨkakoola ni Nkani Nza wazeganʉla kɨna ʉʉgunwi ʉhumile kigela kʉnzɨla akʉmʉhʉɨɨla ʉ Yesʉ Kilisito 2:16. Ʉmalɨnkɨɨye kʉlʉnga ʉkende wang'wi Itunda nʉ ʉgunwi shanga ʉsanilye ntendo niya antʉ.</para>
  <para style="iot">Namolɨ:</para>
  <para style="io">Paulo wandɨɨlye balʉa akwe kʉalamʉsha antʉ nɨahʉɨɨli nɨa kʉ Galatia 1:1-5.</para>
  <para style="io">Sʉnga Paʉlo ʉnononsoe makani makeehʉ kʉpuma mʉaya naɨʉkɨɨe wahume kikoola ʉgombeki wakwe nʉwa kʉmanyisa wazekamɨnkɨɨlya kɨna aɨʉgemile kishiɨ wɨkaze ʉtyatile malagɨɨlyo ingɨ yɨkamʉlema 1:6-2-21.</para>
  <para style="io">Hangɨ ʉganʉe nangalʉ ɨlyoma nɨla malagɨɨlyo nʉ ʉkende nʉʉkolɨ mʉʉgunwi 3:4:</para>
  <para style="io">Sʉnga ʉganʉe kʉkɨɨla mʉ nkani yɨhi kʉlagɨɨla mʉntʉ nʉmʉhʉɨɨe ʉ Kilisito nʉtakɨwe kishɨ likalo nʉlʉza 5:6-10.</para>
  <para style="io">Paʉlo ʉmaɨɨye ɨbalʉa akwe kʉpumya mɨlamʉ nʉ kʉakɨmbʉsha kɨna kʉpɨʉlwa ni Itunda nʉkʉtula mʉntʉ nʉmʉpya iza nangalu kʉkɨla kʉtyata malagɨɨlyo ni ntendo niakʉnzi, anga kʉtalwa kiganda kutyata malagɨɨlyo ang'wa Musa. 6:11-18.</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Ʉnene Paulo nɨ mitʉmi kʉmʉandɨkɨla ɨbalʉa ɨyɨ, shanga nitangilwe ang'wɨ kʉlagɨɨligwa nɨ antʉ, ingɨ nitangilwe nʉ kʉlagɨɨligwa kʉ ʉhumi wang'wa Kilisito nʉ kʉ ʉhumi wang'wi Itunda Tata naɨʉmiyʉkilye ʉ Yesʉ. <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />Nɨ anyandʉgʉ ɨhi nɨɨpalʉng'wɨ nʉnene kʉʉmʉlamʉsha milʉndo nʉwa antʉ nɨmʉmʉhʉɨɨe ʉ Kilisito nɨmʉkolɨ kʉ Galatia.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />Kʉʉmʉlompa Itunda Tata witʉ nɨ Isekʉlʉ witʉ Yesʉ Kilisito wamʉkembete nʉ kʉmʉpa matiliga ʉnyenye mɨhi.<verse eid="GAL 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4" />Kilisito aɨʉpumilye ʉpanga wakwe kʉnsoko akʉheja mɨladʉ itʉ, ingɨ wahume kʉʉguna ʉsese nɨkishiɨ mʉ ʉnkumbigʉlʉ ʉwʉ, anga mʉloewe Itunda hangɨ Tata. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />Itunda nʉwakʉligwe ɨkalɨ na kalɨ. Ɨtai.<verse eid="GAL 1:5" /></para>
  <para style="s">Kʉtilɨ Nkani Nza niingɨza</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Nakʉɨlwa nangalu kɨna itungo iniino ʉnyenye mamʉleka Itunda naɨ ʉmitangile kʉ ʉkende wang'wa Kilisito, masɨngɨɨlya mpola ngɨɨza antʉ ang'wɨ nɨitanga Nkani Nza. <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />Ingɨ kʉtilɨ, “Nkani Nza ningɨɨza,” Kʉlʉ kʉʉlʉ akolɨ antʉ akʉmʉzuga, hangɨ aloilwe kʉpɨʉla ɨtai a Nkani Nza niyang'wa Kilisito. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Palʉng'wɨ nɨ kɨna anga itule mʉntʉ ang'wɨ malaɨka kʉpuma kigʉlʉ wamʉtanantɨlye mpola ngɨza kʉleka ɨyɨ nɨkʉtanantilye, mʉntʉ nʉwanso Itunda nʉwamʉzume ɨkalɨ na kalɨ. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Anga naɨkakondya kʉtambʉla, kʉsʉkɨɨla hangɨ, mʉntʉ wɨhi anga wamʉtanantɨlye Nkani Nza ngɨza, niyihutanile nɨyi naza mahʉɨɨla, mʉntʉ nʉwanso nʉwazʉng'we ni Itunda.<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />Itɨɨ, itungo ɨlɨ ndoilwe kʉgombeka kʉng'wa nyenyu, ndoilwe kʉgombeka kʉ antʉne ang'wɨ kʉgombeka kʉng'wi Itunda? Anga itule nkɨlɨ ndoilwe kʉaloeelya antʉ, shanga aza nzeetula nɨ mitʉmi wang'wa Kilisito.<verse eid="GAL 1:10" /></para>
  <para style="s">Paʉlo naɨwitangilwe ni Itunda</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Anyandʉgʉ ane, ndoilwe mʉlɨnge kɨna Nkani Nza naɨ nʉmʉtanantɨɨye shanga ipumile kʉ antʉ. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Ʉnene shanga aɨmpewe Nkani Nza nɨ antʉ, ang'wɨ kɨna aɨmanyisigwe nɨ antʉ. Ingɨ Yesʉ Kilisito ng'wenso aɨʉnkunʉkʉɨe.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />Ʉnyenye mʉlɨngile ʉnene naɨnɨlɨ pakalɨ naɨtyatile ntendo niya Kɨyahudi. Hangɨ aɨmigulye naɨnɨaja antʉ nɨamʉhʉɨɨe ʉ Kilisito nʉ kʉgema kʉlimansɨɨlya ʉhʉɨɨli wao. <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />Ʉnene aɨnɨalemilye anyilika ɨane ɨdʉ kʉkʉɨɨla ntendo yitʉ niya Kɨyahudi. Aɨnkomanɨɨye kɨsa kʉtyata ntendo niya atata itʉ.<verse eid="GAL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15" />Ingɨ Itunda kʉ ʉkende wakwe, aɨʉnkomile kandɨɨlya naɨnkɨlɨ kʉtugwa, wɨkanintanga nʉmitʉmɨle, <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />itungo ʉdu naɨʉlamʉe kʉnkʉnʉkʉɨla ʉng'waakwe nʉwɨlɨ nihume kʉitanantya Nkani Nza niyakwe kʉ antʉ nɨshanga Ayahudi. Ʉnene shanga kɨsɨgilye nʉ mʉntʉ wɨhi, <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />ang'wɨ shanga aɨnankɨe kenda kʉ kɨsalɨ ka Yelusalemu kʉaona antʉ naɨantongee ʉnene kʉtula itʉmi, aɨnendile hanza kʉ kɨsalɨ ka Alabia sʉnga nɨkatulya kʉ kɨsalɨ ka Damesiki. <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" />Naɨakɨla myaka ɨtaatʉ papo nɨkalongola kʉ kɨsalɨ ka Yelusalemu kione nʉ Petelo<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="ft" closed="false">Kʉ ntambʉ a Kɨyunani. Kepwa ingɨ lina ingɨza nɨlang'wa Petelo</char></note>. Nɨkishiɨ nʉyo mahikʉ ikʉmi naɨtaano, <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />shanga aɨkiine nɨ itumi nɨangɨza ingɨ Yakobo du nɨɨza mʉniino wang'wi Isekʉlʉ Yesʉ. <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />Nkani nɨnʉmʉandɨkɨe, Itunda ʉlɨngile kɨna shanga kʉtambʉla anga ʉteele, ʉine. <verse eid="GAL 1:20" /><verse number="21" style="v" sid="GAL 1:21" />Panyambele nɨkalongola nkɨka niya isalɨ niya kʉ Shamu nʉkʉ Kilikia. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Matungo nanso ʉnene shanga aɨmanyɨkile kʉ antʉ nɨamʉhʉɨɨe ʉ Kilisito nɨakolɨ kʉ isalɨ niya Ʉyahudi. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />Antʉ nɨanso aɨigulye impola yane kɨna, “Mʉntʉ ʉyo naɨwɨkaja pakalɨ, itungo ɨlɨ wainatanantya mpola niya ʉhʉɨɨli wʉwo wʉʉwo naɨʉgemile kʉʉlimansɨɨlya.” <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Ahʉɨɨli nɨanso ɨkamʉkʉlya Itunda kʉnsoko ane.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">Paʉlo wagombeka kʉ Itʉmi aʉya</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />Sʉnga naɨyakɨla myaka ikʉmi na ɨnnɨ, kɨkanankɨla hangɨ kenda kʉ kɨsalɨ ka Yelusalemu kɨze kɨpalʉng'wɨ nʉ Balinaba kɨkamʉhola nʉ Tito. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Aɨnendile kʉng'wanso kʉnsoko aɨnkunʉkʉɨwe ni Itunda kɨna nende, nɨatambʉɨle kɨmpelo atongeeli impola niya Nkani Nza nɨkʉitantya kʉ antʉ nɨshanga Ayahudi. Aɨntendile itɨ ingɨ mʉlɨmo wane naɨnitumaa nʉ mʉlɨmo ʉwʉ nɨkitʉma itungo ɨlɨ, ɨleke kʉtula kitʉma mʉlɨmo wanakanda. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Ɨkigombya nʉnene kɨna ʉ Tito nɨɨza Mʉyunani shanga aɨamʉsingilye kʉtalwa kiganda, <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />palʉng'wɨ nɨ kɨna anyandʉgʉ angɨza naɨitendisilye kɨna amʉhʉɨɨe ʉ Kilisito naɨhangilye nʉsese kɨwipiho ahume kʉpeela ʉwidesi witʉ nɨkʉkete mʉng'wa Kilisito Yesʉ, ahume kʉ ʉtenda ʉsese kɨatʉng'waa a malagʉʉlyo ang'wa Musa, <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />ʉsese shanga kɨkigombya lʉkʉlʉ nɨenso, ingɨ Nkani Nza yilongoleke kʉtula nʉ nyenye ɨkalɨ na kalɨ.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />Ingɨ atongeeli awa nɨakʉigwe aɨagila ikani ipya nɨlakʉntambʉɨla. kʉng'wane agila kɨntʉ nɨkakʉntambʉɨla, Kʉlʉ kʉʉ nɨkanso kʉng'waane shanga kɨntʉ, kʉnsoko Itunda shanga wɨkʉɨɨla. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />Kɨmɨkɨɨli kakwe antʉ nɨanso ɨkalɨnga kɨna Itunda ʉmpee mʉlɨmo nʉwa kʉtanantya Nkani Nza kʉ antʉ nɨshanga Ayahudi, anga ʉ Petelo nʉpewe mʉlɨmo nʉwa kʉatantɨlya Ayahudi, <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />Itunda naɨʉmʉpee ʉ Petelo ʉhumi nʉwa kʉtula mitʉmi kʉ Ayahudi, yʉyo ʉmpee nʉnene ga ʉhumi nʉwa kʉtula nɨmitʉmi kʉ antʉ nɨshanga Ayahudi. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />Itɨ gwa, Yakobo nʉ Petelo nʉ Yohana, naɨatuile anga atongeeli nɨakʉlʉ, ɨkalɨnga ʉkende naɨnkendepilwe ni Itunda ɨkakʉgombya ʉnene nʉ Balinaba kʉlongole kʉ antʉ nɨshanga Ayahudi, nɨanso alongole kʉ Ayahudi. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />Ɨkakʉlompa kʉlongoleke kʉaalya ɨahimbɨ nɨamolɨ mʉ antʉ nɨamʉhʉɨɨe ʉ Kilisito, ʉnene nongolekile kʉlɨtenda nangalu.<verse eid="GAL 2:10" /></para>
  <para style="s">Paulo ʉkʉmʉkenela ʉ Petelo kʉ Antiokia</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Petelo naɨwapika kʉ kɨsalɨ ka Antiokia, ʉnene nɨkamʉkenela pa antʉ kʉnsoko awalimangɨɨla. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Ng'wandyo ʉ Petelo aɨʉkendalya ndya palʉng'wɨ nɨ antʉ nɨshanga Ayahudi, naɨapika ɨantʉ naɨalagɨigwe nʉ Yakobo, nʉwanso wɨkatuliheja nʉ kikoma nɨ antʉ nɨshanga Ayahudi, kʉnsoko akʉogopa antʉ nɨatawe kiganda. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Nɨ Ayahudi ang'wɨ naɨahʉɨɨli ɨkigombya nʉ Petelo mʉ ʉteele ʉwʉ, Balinaba nʉyo wɨkihanja mʉteele ʉwʉ. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />Naɨnaona kɨna shanga akitʉma anga tai a Nkani Nza, nɨkamʉɨla ʉ Petelo pa antʉ ɨhi, “Ʉewe wɨ Mʉyahudi, ingɨ wishiɨ anga mʉntʉ nɨshanga Mʉyahudi, yatula ʉlɨ mʉʉmɨɨlye antʉ nɨshanga Ayahudi atyate ntendo niya Ayahudi?”<verse eid="GAL 2:14" /></para>
  <para style="s">Ayahudi nɨ antʉ nɨshanga Ayahudi akʉgunwa kʉ ʉhʉɨɨli</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />Ʉsese ingɨ kɨ Ayahudi kʉʉtugwa, shanga anga antʉ amahɨɨ mangɨza Ayahudi nɨɨaɨla, “Anyamɨlandʉ.” <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />Ingɨ kʉlɨngile ɨkʉlʉ kʉʉlʉ kɨna ʉmʉntʉ shanga ʉhumile kʉgombwa ni Itunda kʉtyata malagɨɨlyo, ingɨ kʉnsoko akʉmʉhʉɨɨla Yesʉ Kilisito, nʉsese ga Ayahudi kʉmʉhuɨɨe ʉ Kilisito Yesʉ ingɨ kʉhume kʉgombeka kʉng'wi Itunda kʉkɨɨla nɨkʉhʉɨɨe ʉ Kilisito shanga kʉnsoko akʉtyata malagɨɨlyo ang'wa Musa, kʉnsoko mʉntʉ shanga ʉkʉaɨɨligwa kɨna ʉgombekile kʉng'wi Itunda kʉtyata malagɨɨlyo. <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />Anga kʉlowe kʉgombwa ni Itunda kʉʉkamɨnkani nʉ Kilisito, ʉsese kʉʉtula kɨanyamɨlandʉ, itɨɨ lɨkʉlagɨɨla kɨna ʉ Kilisito wɨsasha kitʉme mɨlandʉ ne? Shangaʉ. <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Ʉnene anga ndeke kʉtyata malagɨɨlyo nihume kʉgombeka pang'wi Itunda, nandye hangɨ kʉsʉkɨla kʉtyata malagɨɨlyo naɨnɨmahitile, pang'wanso kʉtula nɨ mɨlandʉ. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Kʉnsoko ʉnene kʉtyata malagɨɨlyo nanso ʉnene nkule, malagɨɨlyo yayo ambʉlagile nihume kishiɨ kʉnsoko ang'wi Itunda. Ʉnene nkomilwe mʉ mʉsalaba palʉng'wɨ nʉ Kilisito, <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />nitungo ɨlɨ nɨmʉpanga, ingɨ shanga nene, ingɨ Kilisito wishiɨ mʉng'wane. Likalo ʉlʉ nɨnishiɨ itungo ɨlɨ ingɨ kʉʉhʉɨɨli nʉwa Ng'wana wang'wi Itunda, ng'wenso naɨʉndoilwe sʉnga wɨkapumya ʉpanga wakwe kʉnsoko ane. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Shanga kʉʉhita ʉkende wang'wi Itunda. Anga itule ʉmʉntʉ wɨtendwa wagombwe ni Itunda kʉtyata malagɨɨlyo, kʉlʉlo kʉsha kʉng'wa Kilisitoyɨkʉtula nakanda.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">Ʉhʉɨɨli ang'wɨ Malagɨɨlyo</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Ʉnyenye antʉ akʉ Galatia nɨmɨapʉngʉ. Itɨɨ mʉlogilwe nʉ nyenyu? Mpola yang'wa Yesʉ Kilisito niya kʉkong'wa mʉmʉsalaba yiganʉɨwe kɨhenga pang'wanyu. <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Ndoilwe kʉlɨnga kɨntʉ kɨng'wɨ kʉpuma kʉng'wanyu. Itɨɨ, Ng'wahʉ Ng'welʉ aɨmʉligilye kʉnsoko akʉamba malagɨɨlyo ang'wa Musa, ang'wɨ kʉnsoko akija nʉ kʉihʉɨɨla Nkani Nza? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Itɨɨ, ʉnyenye mɨapʉngʉne. Aɨmandilye likalo lanyu nʉlʉpya kʉ ngulu niya Ng'wahʉ Ng'welʉ, itungo ɨlɨ mʉloilwe kʉmaɨɨlya kʉngulu yanyune? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />Itɨɨ, lwago lɨhi naɨmagile latula anakanda ne? Kʉlʉ kʉʉlʉ shanga ihumɨkile. <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Itunda wɨmʉpeza Ng'wahʉ Ng'welʉ wakwe nʉkʉtenda mɨʉkʉɨlwa mʉng'wanyu kʉnsoko mʉtyatile malagɨɨlyo ang'wa Mʉsa ne? Ang'wɨ kʉnsoko akija nʉ kʉhʉɨɨla Nkani Nza ne?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />Wandɨkwa wang'wi Itunda wandɨkilwe, “Ibulahimu naɨʉmʉhʉɨɨe Itunda, nʉ kʉʉhʉɨɨla kʉng'wakwe Itunda wɨkamʉgomba.” <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />Itɨ gwa, lɨngi kɨna antʉ nɨamʉhʉɨɨe Itunda wawo ana ang'wa Ibulahimu. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Wandɨkwa wang'wi Itunda wandɨkilwe kɨna, kʉpuma ɨkalɨ Itunda aɨʉapee ʉhumi antʉ nɨshanga Ayahudi agombeke kʉng'wakwe kʉkɨɨla ʉhʉɨɨlɨ, kʉlʉlo Itunda aɨwandilye hanza kʉmʉɨla ʉ Ibulahimu Nkani Nza wazelʉnga, “Kʉkɨɨla ʉewe antʉ nɨshanga Ayahudi akʉkembetwa.” <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Kʉlʉlo, antʉ ɨhi nɨahʉɨɨe ɨkembetwa palʉng'wɨ nʉ Ibulahimu naɨʉhʉɨɨe.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />Ingɨ antʉ ɨhi nɨasanilye kʉgunwa kʉkɨɨla kʉtenda makani natakɨwe mʉ malagɨɨlyo ang'wa Musa, antʉ nɨanso azʉmilwe ni Itunda. Kʉnsoko Wandɨkwa wang'wi Itunda wandɨkile kɨna, “Mʉntʉ wɨhi nɨshanga ʉkʉtyata nʉkʉtenda makani ɨhi naandɨkilwe mʉmalagɨɨlyo ang'wa Musa, nʉwanso ʉzumilwe.” <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />Itɨ ingi kɨhenga kɨna kʉtyata malagɨɨlyo shanga ihumile kʉmʉsasha mʉntʉ wagombeke kʉng'wi Itunda, kʉnsoko yandɨkilwe itɨ, “Mʉntʉ nʉkʉmʉhʉɨɨla ʉkishiɨ kʉ ʉhʉɨɨli.” <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Ingɨ malagɨɨlyo ang'wa Mʉsa shanga asanilye anga ʉhʉɨɨli, ingɨ Mʉwandɨkwa yandɨkilwe itɨ, “Mʉntʉ wɨhi nʉkʉsania makani natakɨwe mʉ malagɨɨlyo ang'wa Musa ʉkishiɨ kʉtyata malagɨɨlyo nanso.”<verse eid="GAL 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13" />Ingɨ ʉ Kilisito aɨʉkʉkomoe kʉhege mʉkɨzʉmo ka malagɨɨlyo naɨʉhoile kɨzʉmo nɨkanso kʉnsoko itʉ, kʉnsoko wandɨkwa wandɨkilwe kɨna, “Mʉntʉ wɨhi nʉkʉkong'wa mʉ mʉsalaba ʉzʉmilwe.” <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />Aɨʉkʉkomoe ingɨ ʉkembetwa naɨʉpewe ʉ Ibilahimu ʉkʉpikɨɨle antʉ ɨhi mihɨɨ kʉkɨɨla Yesʉ Kilisito, kʉhume kʉmʉsɨngɨɨlya Ng'wahʉ Ng'welʉ, ʉyʉ ni Itunda naɨʉtambʉe ʉkʉʉpa.<verse eid="GAL 3:14" /></para>
  <para style="s">Malagɨɨlyo ni Ilago</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Anyandʉgʉ ane, ndoilwe nʉmʉpe mpyani kʉkɨɨla mʉlikalo nʉla mahikʉ ɨhi, sɨgi ilago nila antʉ abɨɨlɨ, anga ilage kʉtilɨ mʉntʉ nʉhumile kʉkaɨla ang'wɨ kongeelya kɨntʉ kɨhi. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Itɨ gwa, ilago Itunda naɨʉmʉlagile ʉ Ibulahimu, ng'wenso palʉng'wɨ nʉ ng'waakwe. Shanga yandɨkilwe ne kɨna “nɨana akwe,” kɨna ɨdʉ, ingɨ yandɨkilwe, “Nʉ ng'waakwe,” ingɨ ʉng'wɨ ʉdu, nʉyo ingɨ ʉ Kilisito. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Ndoilwe kʉlʉnga itɨ, Itunda aɨʉɨkile ilago lakwe myaka magana annɨ nɨ makʉmi ataatʉ nakɨile nʉkʉkamɨnkɨɨlya ɨze akɨlɨ malagɨɨlyo ang'wa Musa, kʉlʉlo malagɨɨlyo nanso shanga ahumile kʉheja ilago nɨlanso ang'wɨ kʉkaɨla. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Anga ɨze kɨpegwa kang'wi Itunda kɨpata kʉtyata malagɨɨlyo, shanga ihumile kʉsania hangɨ ilago lang'wi Itunda, kɨmbʉki kɨna Itunda aɨʉmʉkembetile ʉ Ibulahimu kʉnsoko ilago.<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />Kʉnɨkɨ gwa ɨmalagɨɨlyo ɨkaɨkwa? Malagɨɨlyo aɨaɨkilwe kʉnsoko akʉlagɨɨla magazo a antʉ kʉpikɨɨla nʉʉzɨɨe Ng'wana wang'wa Ibulahimu naʉtewe milago nɨlanso Itunda naɨʉlɨɨye kɨna ʉzile. Itunda aɨʉmʉpee malagɨɨlyo Mʉsa kʉkɨɨla malaɨka, Musa nʉyo wɨkaapa ɨantʉ. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Ingɨ kʉlʉ kʉʉlʉ mʉntʉ wakɨgwa anga ɨze ʉlʉkani la mʉntʉ ʉng'wɨ du, ingɨ Itunda ʉng'wɨ ng'wenso aɨʉɨkile ilago nʉ Ibulahimu shanga aɨʉlagɨɨye anga mʉntʉ.<verse eid="GAL 3:20" /></para>
  <para style="s">Nsoko akʉɨkwa ɨmalagɨɨlyo</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />Itɨɨ, kʉlʉnge malagɨɨlyo ahutanilene nɨ malago ang'wi Itunda? Anga ɨze malagɨɨlyo napumigwe aɨazehuma kʉapa antʉ ʉpanga, itɨ gwa aɨkʉzegombwa pang'wi Itunda kʉkɨɨla kʉtyata malagɨɨlyo. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Ingɨ wandɨkwa wang'wi Itunda wandɨkile kɨna, mʉlandʉ ʉkete ngulu mʉ intʉ yɨhi, kʉlʉlo antʉ ɨhi nɨamʉhʉɨɨe ʉ Kilisito akʉsɨngɨɨlya kɨntʉ ɨko naɨʉtambʉe Itunda.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />Antʉ naɨakɨlɨ kʉmʉhʉɨɨla ʉ Kilisito, aɨkʉkolɨ mʉkɨtungo ka malagɨɨlyo, aɨza kʉlindɨɨe ʉkʉnʉkʉlwe ʉhʉɨɨli nʉwanso. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Kʉlʉlo, malagɨɨlyo aɨmʉleli witʉ kʉpikɨɨla naɨwaza ʉ Kilisito, kʉhume kʉgombeka kʉng'wi Itunda, kʉkɨɨla kʉmʉhʉɨɨla ʉ Kilisito. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Ingɨ itungo ɨlɨ kʉnsoko ʉhʉɨɨli waza, kʉlʉlo ʉsese kɨkʉtilɨ kʉ mʉleli.<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />Kʉkɨɨla ʉhʉɨɨli wanyu, ʉnyenye mɨhi maina mɨana ang'wi Itunda kʉnsoko akʉkamɨnkana nʉ Kilisito Yesʉ. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />Ʉnyenye mɨhi nɨmʉbadisigwe makamɨnkana nʉ Kilisito, kʉlʉlo mimpyanile nʉ Kilisito. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Kʉlʉlo, shanga kʉikoma hangɨ kɨna ʉyʉ Mʉyahudi ang'wɨ Mʉyunani, mʉtʉʉng'wa ang'wɨ shanga mʉtʉʉng'wa, mitʉnja ang'wɨ mʉsʉngʉ, kʉnsoko ʉnyenye mɨhi maina kɨntʉ kɨng'wi kʉkɨɨla kʉkamɨnkana nʉ Kilisito Yesʉ. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Ʉnyenye mɨantʉ ang'wa Kilisito, kʉlʉlo maina miele lang'wa Ibulahimu, hangɨ mʉkʉpegwa maintʉ Itunda naɨʉmʉtambʉɨe ʉ Ibulahimu kɨna ʉkʉmʉpa.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Itɨ gwa kʉlʉnga kɨna, mʉsali nʉwakɨlɨ mʉng'enya nʉmʉdabʉ, wɨhanga mʉtʉʉng'wa palʉng'wɨ nʉkʉtula insao yɨhi yakwe. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Matungo ɨhi nʉwanso wɨsʉngwa nɨ aleli ang'wɨ ɨmɨɨli kʉpikɨɨla lɨpike itungo nɨlɨɨkilwe nihe. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />Papo nʉ sese ga, naɨkʉkɨlɨ kɨang'enya, aɨkɨatʉʉng'wa a ntendo niya mʉʉnkumbigʉlʉ ʉwʉ. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />Ingɨ matungo naɨapikɨɨla, Itunda wɨkamʉtʉma Ng'waakwe mʉʉnkumbigʉlʉ ʉwʉ. Ng'waakwe nʉwanso wɨkatʉgwa nʉ mʉsʉngʉ waze ʉtongilwe nɨ malagɨɨlyo ang'wa Mʉsa, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />waakomole antʉ naɨatongilwe nɨ malagɨɨlyo ingɨ ʉsese Ayahudi kʉhume kʉtula kɨana ang'wi Itunda.<verse eid="GAL 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6" />Kʉnsoko ʉnyenye mɨana akwe, Itunda ʉmʉtʉmile ʉ Ng'wahʉ nʉwa Ng'waakwe mʉnkolo yanyu, Ng'wahʉ nʉwanso yʉyo wɨkʉsasha ʉsese kʉmitange Itunda, “Aba.” ndogoelyo akwe ingɨ “Tata witʉ.” <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Kʉlʉlo gwa ʉnyenye shanga mɨatʉʉng'wa hangɨ, maina wɨ ng'wana, kʉnsoko ʉnyenye maina mɨana, Itunda ʉkʉpa maintʉ ɨhi nʉaɨkɨɨye ɨana akwe.<verse eid="GAL 4:7" /></para>
  <para style="s">Paʉlo ʉkete woa nɨ Agalatia</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Pakalɨ naɨmʉkɨlɨ mʉmʉmanye Itunda, aɨmɨatʉʉng'wa aalʉngʉ nɨshanga Itunda nʉwa tai. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Ingɨ itungo ɨlɨ kʉnsoko mamʉmanya Itunda nʉwa tai, Itunda nʉyo wamʉmanya ʉnyenye. Mʉhumile ʉlɨ hangɨ kʉtʉmɨkɨla ntendo niya ʉnkumbigʉlʉ nɨshanga yikondanɨɨe hangɨ ningila anga ngulu? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Mʉkɨlɨ mʉkiloeelya lʉhikʉ ne ang'wɨ ng'weli nʉʉpya ang'wɨ matungo ang'wɨ myaka. <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Mampeza woa, kɨna mʉlɨmo naɨnitʉmile kʉnsoko anyu, aɨnitʉmile nakanda.<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Anyandʉgʉ ane kʉminena tuli anga ʉnene mʉleke kʉtongwa nɨ malaɨɨlyo, anga ʉnene naɨnɨlɨ. Naɨkine nʉnyenye shanga mɨkantendeela kɨntʉ kɨhi nikɨbɨɨ. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Ʉnyenye mʉlɨngile kɨna ndwala naɨndwae wenso aɨʉsankilye ʉnene mpantike lyoma lang'wandyo nɨla kʉmʉtanantɨlya Nkani Nza, <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />palʉng'wɨ nʉkʉtula aɨnʉmʉsakɨɨye magemo kʉ ʉlwae wane, ʉnyenye shanga aɨmʉnsuɨpile ang'wɨ kʉnihita, ingɨ aɨmʉnsɨngɨɨye anga nɨ malaɨka wang'wi Itunda ang'wɨ anga ʉ Kilisito Yesʉ. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Ʉlowa naɨmʉkete pang'wandyo wendile pɨɨ? Nihumile kʉlʉnga kɨna, itungo nɨlanso aɨmʉhumile kʉkompola ɨmiho anyu mʉmpee nene. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Itɨɨ, itungo ɨlɨ naina nɨmʉlʉgʉ kʉnsoko namʉtambʉɨla ɨtaine?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />Antʉ nɨanso akete nsʉla akʉmʉlija ʉnyenye, ingɨ masɨgoao shanga maziza, aloilwe amʉɨke kʉlɨ nʉsese mʉagɨle enso. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Kʉtai iza kʉtendela antʉ nɨangɨza makani nɨ maziza, tendiʉ mahikʉ ɨhi palʉng'wɨ nʉkʉtula nkolɨ palʉng'wɨ nʉ nyenye ʉdu. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />Ana ane nɨnʉmʉloilwe, ingɨ kʉsʉkɨɨla hangɨ kʉmʉɨla kʉaalɨka anga mʉsʉngʉ nʉkitungʉɨla, kʉmʉɨla kʉlongoleka kʉaalɨka kʉpikɨɨla mʉtule anga Kilisito, ndoilwe ʉ Kilisito wakaɨle intendo yanyu. <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />Nsʉmbɨɨye nangaluu itʉngo ɨlɨ anga ɨze kɨpalʉng'wɨ, aza kʉziitambʉlya nʉ nyenye kʉʉza nɨzekaɨla ntambʉ. Itungo ɨlɨ nkete woa nʉnyenye!<verse eid="GAL 4:20" /></para>
  <para style="s">Mpyani ang'wa Hajili nʉ Sala</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Ntambʉɨli ʉnyenye nɨmʉloilwe kʉtongwa nɨmalagɨɨlyo, itɨ shanga mʉlɨngile ne ɨmalagɨɨlyo nalʉngile? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Kʉnsoko yandɨkilwe kɨna, Ibulahimu aʉkete ana abɨɨlɨ, ng'wana ʉng'wɨ kʉ mʉsʉngʉ naɨ mʉtugwa, ng'wana ʉmʉya kʉ mʉsʉngʉ nɨshanga mʉtʉngwa. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Ng'wana nʉtugilwe nʉ mʉsʉngʉ naɨ mʉtugwa, aʉtugilwe anga ana antʉ nɨaloilwe. Ingɨ ng'wana nʉwa mʉsʉngʉ nɨ shanga mʉtugwa ʉtugilwe kʉnsoko ilago lang'wi Itunda. <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />Makani aya aile anga mpyani, asʉngʉ nɨanso nɨabɨɨlɨ ingɨ mpyani amalago abɨɨlɨ. Ilago lang'wandyo lɨlɨ naɨlɨɨkilwe palʉgʉlʉ nʉla Sinai, kimɨkɨɨli kakwe ingɨ Hajili nɨana akwe akʉtugɨlwa mʉʉtʉng'wa. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Hajili ingɨ kɨmɨkɨɨli ka lʉgʉlʉ nʉla Sinai nʉlʉkolɨ kʉ Alabia, ingɨ mpyani a Yelusalemu ni itungo ɨlɨ, nɨkolɨ mʉʉtʉng'waa nɨana akwe. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Ingi Yelusalemu na kigʉlʉ kɨsalɨ ka widesi, nɨ Yelusalemu ɨyɨ ingɨ mpyani ang'wa iya witʉ. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Kʉnsoko yandɨkilwe kɨna,</para>
  <para style="q" vid="GAL 4:27">“Lowa, ʉewe nʉ wimʉgʉmba, ʉewe nɨshanga ʉtugile,</para>
  <para style="q" vid="GAL 4:27">itʉnte ʉewe nʉkɨlɨ kʉtuga,</para>
  <para style="q" vid="GAL 4:27">kʉnsoko ana nɨamʉsʉngʉ nʉlekilwe ingɨ ɨdʉ</para>
  <para style="q" vid="GAL 4:27">kʉkɨla ɨana nɨamʉsʉngʉ nʉkete mʉgoha.”<verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />Itungo ɨlɨ anyandʉgʉ ane, ʉnyenye mɨana ang'wi Itunda kʉpumɨɨla milago lakwe anga naɨyɨlɨ kʉng'wa Isaki. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Mahikʉ nanso, ng'wana naɨʉtugilwe kʉʉlowa nʉwa ana antʉ aɨwɨmaja ʉng'wana nʉtugilwe kʉngulu niya Ng'wahʉ Ng'welʉ, yɨlongolekileʉ sambʉnʉyʉ. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Mʉwandɨkwa wang'wi Itunda yandɨkilwe ʉlɨ? Yandɨkilwe itɨ, “Mʉzʉnse ʉmʉsʉngʉ nʉ mʉtugwa palʉng'wɨ nʉ ng'waakwe, kʉnsoko ng'wana nʉwa mʉsʉngʉ nʉamʉtugwa shanga ʉkʉsala palʉng'wɨ nʉ ng'wana nʉwa mʉsʉngʉ nɨshanga mʉtʉgwa. <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Kʉlʉlo gwa anyandʉgʉ ane, ʉsese shanga kɨana amʉsʉngʉ nɨmʉtugwa, ingɨ ʉsese kɨana amʉsʉngʉ nɨshanga mʉtʉgwa.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">Ʉsʉnji ʉwidesi wanyu</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Kilisito wakʉpee widesi, wɨkalowa kʉsage mʉwidesi. Kʉlʉlo imɨki mikomeelye mʉleke kʉgomba hangɨ kʉsʉka mʉlwago nʉla ʉtʉʉng'wa nʉwa malagɨɨlyo. <verse eid="GAL 5:1" /><verse number="2" style="v" sid="GAL 5:2" />Tegeelyi. Ʉnene Paʉlo, kʉmʉɨla anga mʉgombe kʉtalwa kiganda kʉnsoko akʉtyata malagɨɨlyo ang'wa Mʉsa, ʉ Kilisito shanga ʉkʉmʉaɨɨlya anga kɨntʉ kɨhi. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Kʉtambʉla kɨhenga hangɨ, mʉntʉ wɨhi nʉkʉgomba kʉtalwa kiganda kʉnsoko akʉtyata malagɨɨlyo ang'wa Musa, ʉtakɨwe watyate ɨmalagɨɨlyo ɨhi nang'wa Musa. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Ʉnyenye mʉkʉduma kʉgombeka kʉng'wi Itunda kʉkɨɨla kʉamba amalagɨɨlyo ang'wa Mʉsa, kʉnzɨla nanso mɨkoma kʉlɨ nʉ Kilisito, mʉkolɨ kʉlɨ nʉ ʉkende wang'wi Itunda. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />Ʉsese kipande litʉ, kʉlindɨɨe isʉmbɨɨlyo kʉngulu a Ng'wahʉ Ng'welʉ kʉgombeke kʉng'wi Itunda kʉkɨɨla kʉmʉhʉɨɨla ʉ Kilisito. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Ndogoelyo anga ɨze kʉkamɨnkana nʉ Kilisito Yesʉ, kʉtalwa kiganda kʉnsoko akʉtyata malagɨɨlyo ang'wa Mʉsa ang'wɨ kʉlekwa kʉtalwa kiganda shanga kɨntʉ, nɨkɨtakɨwe ingɨ kituma mʉlɨmo kʉʉlowa papo yikʉlagɨɨla ʉhʉɨɨli witʉ.<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />Aɨmʉtongolomokile iza mʉ ʉhʉɨɨli! Nyenyu nʉmʉgɨɨye kʉtyata itai? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Itunda nʉmitangile shanga ʉsakilye makani aya. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Ʉmanyisi ʉwʉ nʉwa ʉteele wɨhanga, amila nkehʉ nɨgasisa utu wɨdʉ. <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Nɨhʉɨɨe mʉʉkamɨnkani wanyu ni Isekʉlʉ, shanga mʉkʉpɨʉlwa mʉtyate ʉmanyisi ʉngɨza. Ingɨ mʉntʉ wɨhi nʉkʉmʉkongela ʉnyenye ʉkʉpɨsɨɨligwa ni Itunda, shanga yʉkʉkelwa nʉanso nyenyu.<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />Anyandʉgʉ ane ingɨ ʉnene anga ɨze nkɨlɨ nongolekile kʉatanantɨlya antʉ atalwe kiganda kʉnsoko akʉtyata malagɨɨlyo ang'wa Mʉsa, nɨkɨ kagigwa? Anga ɨze kʉtanantya itɨ ʉtanantyɨ wane nʉwa nsha ang'wa Kilisito mʉ mʉsalaba shanga ʉkʉatasha Ayahudi. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Bahu antʉ nɨanso nɨakʉmʉnyoma azaitule enso.<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />Ʉnyenye anyandʉgʉ ane, aɨmitangilwe mʉhege mʉʉtʉng'wa, widesi wanyu ʉleke kʉtula nsoko akʉmʉsasha mʉtyate kɨlaku laku ka mʉɨlɨ, ingɨ mɨhi mɨaɨɨlye kʉ ʉlowa. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Kʉnsoko malagɨɨlyo ang'wa Musa ɨhi alamɨigwe kʉtyata ilagɨɨlyo lɨng'wɨ, “Mʉlowe ʉmɨako anga nʉwiloilwe ʉewe.” <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Angamilʉmange nʉkidedʉlanga anga ɨkalɨ, kendegeli mʉleke kilimansɨɨlya.<verse eid="GAL 5:15" /></para>
  <para style="s">Kʉtongwa nʉ Ng'wahʉ Ng'welʉ</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Kʉlʉlo nʉngile itɨ, mʉtongwe nʉ Ng'wahʉ Ng'welʉ, nʉnyenye anga mʉtende itɨ shanga mʉkʉtyata kɨlaku lakʉ ka mʉɨlɨ. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Ndogoelyo, kɨlaku lakʉ ka mʉɨlɨ kikʉngʉma nɨ Ng'welʉ Ng'welʉ, nɨ Ng'welʉ Ng'welʉ nɨ kɨlaku lakʉ nɨmʉkete mʉmɨɨlɨ anyu. Maintʉ aya nabɨɨlɨ shanga ɨzigombilye nʉ kʉnsoko nanso ʉnyenye shanga mʉhumile kitʉma aya nɨmʉloilwe. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Anga mʉtongwa nʉ Ng'wahʉ Ng'welʉ, shanga mʉkʉtongwa nɨ malagɨɨlyo ang'wa Musa. <verse eid="GAL 5:18" /><verse number="19" style="v" sid="GAL 5:19" />Itɨ gwa, intendo niya mʉɨlɨ ingɨ yɨgeeʉ nizo sizi, ʉgoolyi, ʉsambo, ʉdosi, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />kʉkʉlya adʉdʉ, ʉlogi, wiimbɨli, wilei, wɨlu, ikuo, ʉbɨ wankolo, wikʉngʉmi, minyomo, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />wibɨpɨlwi, ʉgala ntʉlɨ, ʉlaku nɨ makani mangɨza nimpyani naya. Kʉmʉhugulya hangɨ anga nazantongee kʉmʉhugulya kɨna, antʉ nɨɨtende ntendo niyanso, shanga akingɨla mʉʉtemi wang'wi Itunda.<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />Mʉntʉ nʉwɨtongwa nʉ Ng'wahʉ Ng'welʉ ʉkʉtula nʉ wilowi nʉ ʉlowa nʉ matiliga nʉ wiʉmɨɨlyi nʉ ʉkende nɨ nkolo nza nʉ kʉhʉɨɨlwa, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />nʉ ʉpolo nʉ kihama. Kʉtilɨ ilagɨɨlyo nɨlɨhumile kʉgilya mʉntʉ waleke kitʉma makani aya. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />Antʉ ɨhi nɨakamɨnkanile nʉ Kilisito Yesʉ akomile mʉmʉsalaba masɨgoao nɨmabɨ ni ilakulaku nimbɨ naɨakete. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />Ng'wahʉ Ng'welʉ wakʉpee ʉpanga, kʉmʉleke wakʉtonge. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Itɨ gwa, kʉleke kiketa nakanda, kʉleke kisokoolya ang'wɨ kionela wɨlu.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">Likalo nʉla kiaɨɨlya</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Anyandʉgʉ ane, anga mʉmʉone mʉntʉ watenda mʉlandʉ, ʉʉgwa ʉnyenye nɨmʉtongilwe nʉ Ng'wahʉ Ng'welʉ mʉhʉgʉlyi kʉ ʉpolo waleke ɨmɨlandʉ. Ingɨ nʉ nyenye ga mʉhʉgʉke mʉleke kingɨla mʉ mɨlandʉ. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Mʉziaɨɨlya ʉnyenye, anga mʉtende itɨ mʉkʉtimɨlyi ilagɨɨlyo lang'wa Kilisito. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Anga mʉntʉ waʉkiona kɨna mʉza kʉkɨla nɨang'wɨ, mʉntʉ nʉwanso ʉkikonga ʉng'wenso. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Ingɨ mʉntʉ wɨhi nʉwikolenkeelye ʉng'wenso. Anga waone kɨna mʉza papo ʉhumile kikʉlya, shanga ʉkimpyania nʉ mʉntʉ nʉmʉngɨza. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Ndogoelyo, mʉntʉ wɨhi ʉkʉlamʉlwa anga mʉtendee.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />Itɨ gwa, mʉntʉ wɨhi nʉkʉmanyisigwa ʉlʉkani lang'wi Itunda wamomoele ʉmʉmanyisi wakwe maintʉ nɨ maza nʉkete.<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />Leki kʉkongwi, Itunda shanga wɨonwa ʉpʉngʉ, kʉnsoko ʉmʉntʉ wɨogola ɨko nʉlɨmile. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Mʉntʉ nʉkʉlɨma maintʉ a mʉʉnkumbigʉlʉ walɨnge kɨna ɨola, ingɨ mʉntʉ nʉkitʉma makani namʉloeeye Ng'wahʉ Ng'welʉ ʉkʉlija ʉpanga nʉwa kalɨ na kalɨ kʉpuma kʉ Ng'wahʉ Ng'welʉ. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Kʉlʉlo kʉleke kʉkatapa kitʉma makani nɨmaza, kʉnsoko anga kʉleke kʉkatapa maogola anga apike kʉʉogola. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Kʉlʉlo, nɨkʉkɨlɨ kʉkete ɨlyoma, kʉzeaaɨɨlya antʉ ɨhi makani nɨ maza, niikʉlʉ nangalʉ antʉ nɨamʉhʉɨɨe ʉ Kilisito.<verse eid="GAL 6:10" /></para>
  <para style="s">Paʉlo ʉkʉmaɨɨlya balua akwe</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />Balʉa ɨyɨ nʉmʉandɨkɨe nene kʉ mʉkono wane, kolwi makanɨ nɨ nɨmabonkoe. <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />Antʉ nɨaloilwe kʉonwa kɨna aza kɨmʉɨlɨ aloilwe amʉsinje kʉtalwa kigada kʉnsoko akʉtyata malagɨɨlyo ang'wa Mʉsa. Akʉtenda itɨ shanga aloilwe kagigwa kʉnsoko akʉtanantya nkani niya ɨnsha ang'wa Kilisito mʉ mʉsalaba. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Antʉ nɨatawe kiganda shanga atyatile ɨmalagɨɨlyo ang'wa Mʉsa, aloilwe ʉnyenye mʉtalwe kiganda kʉnsoko akʉtyata malagɨɨlyo ang'wa Mʉsa, ingɨ nɨanso ikʉlye kʉnsoko akʉtalwa kɨganda mʉ mʉɨlɨ wanyʉ. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />Ingɨ ʉnene gwa, shanga kikʉlya kʉnsoko a kɨntʉ kɨhi, nɨkikʉɨlya ingɨ kʉnsoko nsha ang'wi Isekʉlʉ witʉ Yesʉ Kilisito mʉmʉsalaba, kʉkɨɨla nsha akwe makani ɨhi na mʉnkumbigʉlʉ shanga kɨntʉ kʉng'wane, likalo lane nʉla kalɨ lakule nʉ Kilisito mʉ mʉsalaba. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Kʉnsoko kʉtalwa kiganda nʉ kʉleka kʉtalwa kiganda shanga kɨntʉ kʉng'wane, kɨntʉ nɨkɨza ingɨ kʉʉmbwa ʉpya ni Itunda kʉkɨɨla Kilisito. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Antʉ nɨatyatile malagɨɨlyo aya, nɨatule nɨ matiliga nɨ kɨaisa, matiliga nɨ kɨaisa palʉng'wɨ nɨ Aisiaeli, antʉ ang'wi Itunda. <verse eid="GAL 6:16" /><verse number="17" style="v" sid="GAL 6:17" />Kandɨɨlya ino, mʉntʉ wɨhi nʉwaleke kʉnyoma, kʉnsoko nkete mabasa mʉ mʉɨlɨ wane nakʉmitʉmɨla Yesʉ. <verse eid="GAL 6:17" /><verse number="18" style="v" sid="GAL 6:18" />Anyandʉgʉ ane, kʉlomple ʉkende wang'wi Isekʉlʉ witʉ ʉ Yesʉ Kilisito mʉtule nʉ nyenye. Tai.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>